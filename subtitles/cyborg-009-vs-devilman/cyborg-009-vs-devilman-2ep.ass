Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.29,0:00:06.79,Default,,0,0,0,,（♪）
Dialogue: 0,0:01:41.14,0:01:44.27,Default,,0,0,0,,Мен 0014 (Нөл нөл он төрт) Эдвардпын!
Dialogue: 0,0:01:45.06,0:01:47.64,Default,,0,0,0,,Ол 0016 (Нөл нөл он алты) Қабыл!
Dialogue: 0,0:01:47.77,0:01:50.31,Default,,0,0,0,,Мен 0017 (Нөл нөл он жеті) Абылмын!
Dialogue: 0,0:01:50.81,0:01:52.98,Default,,0,0,0,,Сіз екеуміз ағайындымыз деп айта аламын.
Dialogue: 0,0:01:53.11,0:01:55.15,Default,,0,0,0,,Бұлай емес деп айтуға болады.
Dialogue: 0,0:01:55.32,0:01:57.61,Default,,0,0,0,,Цк, сен соншалықты алғырсың.
Dialogue: 0,0:01:57.90,0:01:59.20,Default,,0,0,0,,0015 (он бес) не болды?
Dialogue: 0,0:01:59.66,0:02:03.49,Default,,0,0,0,,Қара елес әрқашан озық ғылымды іздейді.
Dialogue: 0,0:02:03.62,0:02:08.62,Default,,0,0,0,,Оны қаруға қолдану арқылы біз бизнесте нәтижеге қол жеткіздік.
Dialogue: 0,0:02:08.75,0:02:10.33,Default,,0,0,0,,Айтуға болады.
Dialogue: 0,0:02:10.50,0:02:12.17,Default,,0,0,0,,Өлімнің саудагері болғанымен
Dialogue: 0,0:02:12.54,0:02:14.67,Default,,0,0,0,,Бір өріс ретінде
Dialogue: 0,0:02:14.80,0:02:16.84,Default,,0,0,0,,Киборг жауынгерлерінің дамуы
Dialogue: 0,0:02:17.01,0:02:17.88,Default,,0,0,0,,Тіпті Қара елес
Dialogue: 0,0:02:18.01,0:02:19.63,Default,,0,0,0,,Ең танымал жобалар және
Dialogue: 0,0:02:19.76,0:02:20.72,Default,,0,0,0,,Сіз айта аласыз
Dialogue: 0,0:02:21.59,0:02:25.47,Default,,0,0,0,,Сондықтан киборг бағдарламасы үнемі дамып отырады.
Dialogue: 0,0:02:26.77,0:02:29.64,Default,,0,0,0,,Сіздер, сынақ субъектілері, Protocyborg жобасы
Dialogue: 0,0:02:30.69,0:02:33.73,Default,,0,0,0,,Оның жетілдірілген түрі, Mutos Cyborg жобасы
Dialogue: 0,0:02:34.57,0:02:36.57,Default,,0,0,0,,Ал біз Advanced Custom қызметінде
Dialogue: 0,0:02:36.69,0:02:38.70,Default,,0,0,0,,Жоғары жасөспірімдер санына
Dialogue: 0,0:02:39.24,0:02:41.99,Default,,0,0,0,,Сіз Мифос Киборгты жеңдіңіз, бірақ
Dialogue: 0,0:02:42.28,0:02:46.33,Default,,0,0,0,,Біздің көзқарасымыз бойынша, олар да ескірген, ескірген.
Dialogue: 0,0:02:46.95,0:02:48.96,Default,,0,0,0,,Егер бұл жай ғана техникалық сипаттамалар болса, ол сендерге қарағанда әлдеқайда жақсы.
Dialogue: 0,0:02:49.08,0:02:51.79,Default,,0,0,0,,Мутос Киборг жақсырақ болды
Dialogue: 0,0:02:52.21,0:02:54.25,Default,,0,0,0,,Бірақ олар жеңілді.
Dialogue: 0,0:02:54.71,0:02:56.71,Default,,0,0,0,,Қызықты нәтиже.
Dialogue: 0,0:02:57.59,0:03:00.01,Default,,0,0,0,,Қара елес сізді сатқындар деп санайды.
Dialogue: 0,0:03:00.13,0:03:03.22,Default,,0,0,0,,Міне, қуғыншыларды жіберудің себебі.
Dialogue: 0,0:03:03.89,0:03:06.68,Default,,0,0,0,,Менің көзқарасым бойынша, бұл біраз ыңғайсыздық туғызады.
Dialogue: 0,0:03:07.10,0:03:08.39,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,0:03:08.81,0:03:11.69,Default,,0,0,0,,Неліктен бәрің аман қалдыңдар?
Dialogue: 0,0:03:11.81,0:03:14.44,Default,,0,0,0,,Мен сізге құпияны көрсетейін!
Dialogue: 0,0:03:15.65,0:03:16.90,Default,,0,0,0,,Қара?
Dialogue: 0,0:03:20.74,0:03:21.40,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:38.71,0:03:40.38,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:03:44.68,0:03:45.35,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:03:45.47,0:03:46.10,Default,,0,0,0,,Уф
Dialogue: 0,0:03:55.61,0:03:59.19,Default,,0,0,0,,Қалада болуға қарсы болмасаңыз, бұл жер де!
Dialogue: 0,0:04:01.49,0:04:04.07,Default,,0,0,0,,Цк, бұл миниатюралық мылтық сияқты қаралғандай...
Dialogue: 0,0:04:08.58,0:04:11.41,Default,,0,0,0,,Сен әлі бала емессің бе? (Абыл) Хехе...
Dialogue: 0,0:04:14.29,0:04:15.46,Default,,0,0,0,,Бум!
Dialogue: 0,0:04:16.00,0:04:16.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:22.92,0:04:23.55,Default,,0,0,0,,Не?
Dialogue: 0,0:04:23.80,0:04:25.47,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:04:25.64,0:04:28.18,Default,,0,0,0,,Мен оңай қашып кетуге жеткілікті жылдам болдым.
Dialogue: 0,0:04:28.76,0:04:31.06,Default,,0,0,0,,Тексерудің қажеті жоқ, жасайық.
Dialogue: 0,0:04:31.27,0:04:35.06,Default,,0,0,0,,Бұлай асықпа. Мен сондай-ақ топтық қабілеттілік туралы деректерді алғым келеді.
Dialogue: 0,0:04:49.66,0:04:51.54,Default,,0,0,0,,Tsk, сіз қалжыңдап тұрған жоқсыз.
Dialogue: 0,0:04:56.33,0:04:58.84,Default,,0,0,0,,Мен одан үлкен үміт күттім, бірақ...
Dialogue: 0,0:04:59.63,0:05:03.34,Default,,0,0,0,,Әрі қарай, нөлдік нөлдік сандар аяқталған кезде деректерді аламыз.
Dialogue: 0,0:05:03.67,0:05:06.68,Default,,0,0,0,,Оған дейін өмірлеріңді сенімді қолға тапсырайық.
Dialogue: 0,0:05:08.18,0:05:10.31,Default,,0,0,0,,Цк, бұл не болды?
Dialogue: 0,0:05:10.60,0:05:12.60,Default,,0,0,0,,Менің ойымша, бұл сәлемдесу ретінде айтылған.
Dialogue: 0,0:05:12.85,0:05:15.35,Default,,0,0,0,,Егер мен байыпты болсам, не болатынын білмеймін...
Dialogue: 0,0:05:15.60,0:05:17.35,Default,,0,0,0,,Жоғары жасөспірімдер саны...
Dialogue: 0,0:05:18.27,0:05:20.77,Default,,0,0,0,,Олар да белгілі бір мағынада «шайтандар».
Dialogue: 0,0:05:20.90,0:05:25.15,Default,,0,0,0,,(Жедел жәрдем сигналы)
Dialogue: 0,0:05:37.92,0:05:38.75,Default,,0,0,0,,００９！
Dialogue: 0,0:05:49.30,0:05:52.89,Default,,0,0,0,,Бұл жағдайда қолды ажырату жақсы шешім болды.
Dialogue: 0,0:05:53.43,0:05:55.68,Default,,0,0,0,,Негізгі генераторға дерлік
Dialogue: 0,0:05:55.81,0:05:57.94,Default,,0,0,0,,Жарылыс тудырды
Dialogue: 0,0:05:58.60,0:06:03.57,Default,,0,0,0,,Ол күшейтілген киімге еніп, жасанды тектиттің буын шарларын зақымдады...
Dialogue: 0,0:06:04.07,0:06:06.07,Default,,0,0,0,,Хмм...? Бұл
Dialogue: 0,0:06:13.49,0:06:15.62,Default,,0,0,0,,Жануардың терісіне ұқсайды
Dialogue: 0,0:06:17.33,0:06:21.92,Default,,0,0,0,,Хмм... адам терісінде? Не айтқың келеді?
Dialogue: 0,0:06:27.63,0:06:29.47,Default,,0,0,0,,Сіз шайтанды көрдіңіз бе?
Dialogue: 0,0:06:31.89,0:06:33.89,Default,,0,0,0,,Тіпті менің туған жерімде
Dialogue: 0,0:06:34.01,0:06:38.73,Default,,0,0,0,,Диабол немесе Малмус Уимп сияқты адамдар болды.
Dialogue: 0,0:06:39.19,0:06:41.52,Default,,0,0,0,,Бірақ бұл жындар керек
Dialogue: 0,0:06:41.65,0:06:44.61,Default,,0,0,0,,Жақсылардың жеңілгенін көрді
Dialogue: 0,0:06:45.15,0:06:49.28,Default,,0,0,0,,Адамдар шайтанды өз қолдарымен жеңді.
Dialogue: 0,0:06:53.45,0:06:55.49,Default,,0,0,0,,Ах! (003) Джо!
Dialogue: 0,0:06:58.50,0:06:59.75,Default,,0,0,0,,(жайылған пальто дыбысы)
Dialogue: 0,0:07:04.29,0:07:07.63,Default,,0,0,0,,Адамдарға...?
Dialogue: 0,0:07:09.55,0:07:12.14,Default,,0,0,0,,Сендер қара елес емессіңдер ме?
Dialogue: 0,0:07:12.89,0:07:14.43,Default,,0,0,0,,Қара елес...?
Dialogue: 0,0:07:18.98,0:07:20.98,Default,,0,0,0,,Жын емес пе...
Dialogue: 0,0:07:22.23,0:07:25.19,Default,,0,0,0,,Адамдардың жалғыз жауы емес.
Dialogue: 0,0:07:29.99,0:07:33.95,Default,,0,0,0,,Ол дәл шайтанға ұқсайды, бірақ... түсінбедім...
Dialogue: 0,0:07:38.95,0:07:40.00,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:07:40.71,0:07:41.83,Default,,0,0,0,,Қайырлы таң Ева
Dialogue: 0,0:07:41.96,0:07:42.96,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:07:46.67,0:07:49.01,Default,,0,0,0,,Жарайды, онда хронологияны ашыңыз.
Dialogue: 0,0:07:50.97,0:07:52.01,Default,,0,0,0,,18 ғасырда…
Dialogue: 0,0:07:53.09,0:07:54.30,Default,,0,0,0,,Бірге тамашалайық
Dialogue: 0,0:07:54.43,0:07:55.89,Default,,0,0,0,,Ұстамаңыз Ұстамаңыз
Dialogue: 0,0:07:56.80,0:07:57.89,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:13.95,0:08:15.70,Default,,0,0,0,,Қара елес?
Dialogue: 0,0:08:20.41,0:08:24.29,Default,,0,0,0,,Алдыңғы қатардағы зерттеушілер топ-топ болып жоғалып барады...
Dialogue: 0,0:08:26.13,0:08:29.59,Default,,0,0,0,,Барлық инвесторлар
Dialogue: 0,0:08:29.71,0:08:32.88,Default,,0,0,0,,Бірінші дүниежүзілік соғыстан кейінгі трансұлттық корпорациялар
Dialogue: 0,0:08:33.01,0:08:34.84,Default,,0,0,0,,Сол алдыңғы компания...
Dialogue: 0,0:08:35.64,0:08:38.05,Default,,0,0,0,,Мен қараңғылық әлемі туралы қауесетті естідім, бірақ...
Dialogue: 0,0:08:38.55,0:08:39.76,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:40.31,0:08:43.43,Default,,0,0,0,,Ол өзін шайтанның қызметшісі ретінде сезінбеді.
Dialogue: 0,0:08:45.06,0:08:46.02,Default,,0,0,0,,Бұл болды ма?
Dialogue: 0,0:08:46.73,0:08:47.61,Default,,0,0,0,,О
Dialogue: 0,0:08:48.44,0:08:49.48,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:08:51.57,0:08:54.65,Default,,0,0,0,,Олар да сатқындар ма?
Dialogue: 0,0:08:54.95,0:08:58.37,Default,,0,0,0,,Саған опасыздық жасау ойым жоқ.
Dialogue: 0,0:08:59.37,0:09:02.62,Default,,0,0,0,,Олар бұл Амон деп ойлайды.
Dialogue: 0,0:09:03.20,0:09:05.54,Default,,0,0,0,,Жындар мұндай сылтауларға қызықпайды.
Dialogue: 0,0:09:06.08,0:09:07.50,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:09:12.80,0:09:14.72,Default,,0,0,0,,Уфуфу... (Студент қыз В) Бұл рас...
Dialogue: 0,0:09:19.18,0:09:22.77,Default,,0,0,0,,Акира-кун қайда кетті?
Dialogue: 0,0:09:23.43,0:09:24.02,Default,,0,0,0,,Ах
Dialogue: 0,0:09:26.89,0:09:30.06,Default,,0,0,0,,А, мен саған түскі ас қорапшасын жасаудың қиындығына бардым.
Dialogue: 0,0:09:30.19,0:09:32.44,Default,,0,0,0,,Ол да төбеде емделмейді.
Dialogue: 0,0:09:33.57,0:09:35.57,Default,,0,0,0,,Эй, Ева ше?
Dialogue: 0,0:09:35.70,0:09:38.70,Default,,0,0,0,,Бұл түскі асты босқа кетіру, егер сізге ұнаса,
Dialogue: 0,0:09:38.82,0:09:40.78,Default,,0,0,0,,Сол жерде бәрімен бірге тамақтанғыңыз келе ме?
Dialogue: 0,0:09:41.12,0:09:42.24,Default,,0,0,0,,Хехе…
Dialogue: 0,0:09:43.29,0:09:45.25,Default,,0,0,0,,Эй, Мики, сен қолыңды көтердің.
Dialogue: 0,0:09:45.37,0:09:49.13,Default,,0,0,0,,Дұрыс па? Дұрыс па? Саса Хауа, жеңіз, жеңіз
Dialogue: 0,0:09:51.71,0:09:52.34,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:09:52.80,0:09:53.59,Default,,0,0,0,,Йошикава шынымен де оның жағдайын ойлап жүр…
Dialogue: 0,0:09:53.71,0:09:55.63,Default,,0,0,0,,Хехе, жақсы.
Dialogue: 0,0:10:05.77,0:10:06.93,Default,,0,0,0,,(Рей) Уф~ Нұсқауларды мінсіз орындадым
Dialogue: 0,0:10:07.10,0:10:09.15,Default,,0,0,0,,Хмм, бұл қауіпті болды.
Dialogue: 0,0:10:09.31,0:10:11.31,Default,,0,0,0,,（００３）００９！
Dialogue: 0,0:10:15.82,0:10:17.49,Default,,0,0,0,,Барлығы уайымдады.
Dialogue: 0,0:10:19.16,0:10:21.49,Default,,0,0,0,,Орманда кездескенде осылай деді.
Dialogue: 0,0:10:21.95,0:10:24.66,Default,,0,0,0,,Адамдар жалғыз жау емес...
Dialogue: 0,0:10:25.83,0:10:27.33,Default,,0,0,0,,Бұл адам емес еді.
Dialogue: 0,0:10:27.71,0:10:30.83,Default,,0,0,0,,Аңыздарда кездесетін құбыжық сияқты болды.
Dialogue: 0,0:10:31.83,0:10:34.21,Default,,0,0,0,,Доктор Гилмор, сөйлесейік...
Dialogue: 0,0:10:34.59,0:10:35.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:42.09,0:10:44.10,Default,,0,0,0,,Сіз Фудо-санмен жақсы қарым-қатынастасыз, солай емес пе?
Dialogue: 0,0:10:44.47,0:10:45.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:45.56,0:10:47.43,Default,,0,0,0,,Бала күнгі досы
Dialogue: 0,0:10:47.68,0:10:51.69,Default,,0,0,0,,Ол қазір менің үйімде тұрады, сондықтан біз бір отбасы сияқтымыз.
Dialogue: 0,0:10:51.81,0:10:52.86,Default,,0,0,0,,Сіз қандай адамсыз?
Dialogue: 0,0:10:54.19,0:10:55.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:55.82,0:10:57.40,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:57.69,0:11:00.15,Default,,0,0,0,,Соңғы уақытқа дейін өзімді сенімсіз сезінетінмін.
Dialogue: 0,0:11:00.28,0:11:03.32,Default,,0,0,0,,Ол кішкентай болса да, мен оны інімдей сезіндім.
Dialogue: 0,0:11:03.82,0:11:07.70,Default,,0,0,0,,Мен соңғы алты айда өзгердім. Мен күштірек болдым.
Dialogue: 0,0:11:07.87,0:11:10.21,Default,,0,0,0,,Ол аздап ақаулы болып қалды...
Dialogue: 0,0:11:11.87,0:11:14.38,Default,,0,0,0,,Менің ойымша, бұл мен әртүрлі нәрселердің арқасында өстім дегенді білдіреді...
Dialogue: 0,0:11:17.00,0:11:20.38,Default,,0,0,0,,Акира-кун ата-анасымен бірге тұрды.
Dialogue: 0,0:11:20.55,0:11:22.55,Default,,0,0,0,,Жазатайым оқиға мені жалғыз қалдырды...
Dialogue: 0,0:11:23.18,0:11:26.22,Default,,0,0,0,,Өйткені менің әкем мен Акираның әкесі жақын достар болған.
Dialogue: 0,0:11:26.39,0:11:28.43,Default,,0,0,0,,Мен үйіме келуім керек еді...
Dialogue: 0,0:11:28.72,0:11:31.06,Default,,0,0,0,,Сонда да біраз уақыт күйзелдім
Dialogue: 0,0:11:31.19,0:11:34.11,Default,,0,0,0,,Көп ұзамай сен басқа адам сияқты күшті боласың...
Dialogue: 0,0:11:34.69,0:11:36.36,Default,,0,0,0,,Басқа адам сияқты ма?
Dialogue: 0,0:11:36.65,0:11:38.94,Default,,0,0,0,,Иә? А, мен қызық...
Dialogue: 0,0:11:39.53,0:11:42.07,Default,,0,0,0,,Менің ойымша, басқа адам болу басқаша.
Dialogue: 0,0:11:42.41,0:11:46.24,Default,,0,0,0,,Ол сенімдірек болды, бірақ ішкі жағы мүлде өзгерген жоқ.
Dialogue: 0,0:11:46.41,0:11:47.37,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:11:47.74,0:11:49.70,Default,,0,0,0,,Эй, Хауаның отбасы ше?
Dialogue: 0,0:11:50.00,0:11:52.00,Default,,0,0,0,,Не, менікі?
Dialogue: 0,0:11:54.42,0:11:57.55,Default,,0,0,0,,Менің... егіз ағам бар.
Dialogue: 0,0:11:58.17,0:12:01.67,Default,,0,0,0,,Мейірімді, қамқор бала...
Dialogue: 0,0:12:03.43,0:12:06.43,Default,,0,0,0,,Менің жалғыз отбасым...
Dialogue: 0,0:12:07.10,0:12:08.35,Default,,0,0,0,,Жазатайым оқиғадан кейін...
Dialogue: 0,0:12:10.14,0:12:11.93,Default,,0,0,0,,Әлі ұйықтап жатыр
Dialogue: 0,0:12:12.44,0:12:15.31,Default,,0,0,0,,(Медициналық жабдықтың жұмыс дыбыстары)
Dialogue: 0,0:12:15.81,0:12:18.27,Default,,0,0,0,,Уф... Кешіріңіз...
Dialogue: 0,0:12:18.40,0:12:19.32,Default,,0,0,0,,А...?
Dialogue: 0,0:12:19.61,0:12:22.07,Default,,0,0,0,,Кешіріңіз... Мен білмеймін...
Dialogue: 0,0:12:22.90,0:12:25.11,Default,,0,0,0,,Сіз кейбір ауыртпалықтарды естідіңіз ...
Dialogue: 0,0:12:25.45,0:12:27.53,Default,,0,0,0,,Менің аяғым шынында «сырс» етті!—
Dialogue: 0,0:12:30.37,0:12:31.29,Default,,0,0,0,,Мики…
Dialogue: 0,0:12:32.08,0:12:35.62,Default,,0,0,0,,Кешіріңіз, жақсы жауап бере алмадым...
Dialogue: 0,0:12:41.26,0:12:43.92,Default,,0,0,0,,Не? Не? не?
Dialogue: 0,0:12:44.05,0:12:45.01,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:12:45.63,0:12:48.47,Default,,0,0,0,,Ештеңе емес, мен Хауа ананы...
Dialogue: 0,0:12:48.64,0:12:49.97,Default,,0,0,0,,Мен сені қорғаймын...!
Dialogue: 0,0:12:51.77,0:12:52.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:56.23,0:12:58.48,Default,,0,0,0,,Керемет!
Dialogue: 0,0:12:58.81,0:13:01.86,Default,,0,0,0,,Нана Нана Нана Нана?
Dialogue: 0,0:13:02.78,0:13:03.99,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:13:07.87,0:13:08.99,Default,,0,0,0,,Сіз неге еліктейсіз...?
Dialogue: 0,0:13:10.95,0:13:15.29,Default,,0,0,0,,Ол қызды азғыру үшін жем болады.
Dialogue: 0,0:13:15.83,0:13:16.96,Default,,0,0,0,,Уақыты келгенде
Dialogue: 0,0:13:17.08,0:13:19.50,Default,,0,0,0,,Мен оны апаруым керек еді...
Dialogue: 0,0:13:23.17,0:13:23.96,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:24.26,0:13:25.93,Default,,0,0,0,,(соққы толқыны дыбысы)
Dialogue: 0,0:13:26.97,0:13:30.55,Default,,0,0,0,,Сіз өз жұмысыңызға адал болуды айтасыз ба?
Dialogue: 0,0:13:30.68,0:13:34.60,Default,,0,0,0,,Жақсы. 0015 Сен маған опасыздық жасай алмайсың.
Dialogue: 0,0:13:43.03,0:13:48.70,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:13:53.58,0:13:55.41,Default,,0,0,0,,Ол өзін Эдвард деп атады, солай ма?
Dialogue: 0,0:13:55.83,0:13:56.58,Default,,0,0,0,,Иә
Dialogue: 0,0:13:57.71,0:13:59.33,Default,,0,0,0,,Эдвард Адамс
Dialogue: 0,0:14:00.83,0:14:05.80,Default,,0,0,0,,Ол менің әріптесім доктор Адамс Теуфелдің ұлы.
Dialogue: 0,0:14:06.17,0:14:09.22,Default,,0,0,0,,Эдвардтың өзі тамаша зерттеуші болған.
Dialogue: 0,0:14:09.97,0:14:13.68,Default,,0,0,0,,Тәжірибе кезінде апатқа ұшырап, аман қалғанымен,
Dialogue: 0,0:14:13.81,0:14:17.23,Default,,0,0,0,,Денемнің басым бөлігінің еркіндігінен айырылдым.
Dialogue: 0,0:14:17.89,0:14:20.65,Default,,0,0,0,,Доктор Адамс Эдвардты нөлдік сан деп атайды.
Dialogue: 0,0:14:20.77,0:14:22.73,Default,,0,0,0,,Ұсыну сұралды
Dialogue: 0,0:14:23.57,0:14:24.57,Default,,0,0,0,,Қанша уақыт күтуімді күтесің? Жылдам бол.
Dialogue: 0,0:14:24.69,0:14:26.40,Default,,0,0,0,,Жоғары жасөспірімдер саны...
Dialogue: 0,0:14:26.53,0:14:27.24,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:29.24,0:14:32.78,Default,,0,0,0,,Эдвард 0014 жылға үміткер болды.
Dialogue: 0,0:14:32.91,0:14:35.95,Default,,0,0,0,,Оның өзі киборгқа айналдырылып, қайта тіріледі.
Dialogue: 0,0:14:36.08,0:14:38.75,Default,,0,0,0,,Доктор Адамспен толтырылған
Dialogue: 0,0:14:39.42,0:14:41.88,Default,,0,0,0,,Бұл жасөспірім саны деп аталады.
Dialogue: 0,0:14:42.88,0:14:44.80,Default,,0,0,0,,15 саны жоқ!
Dialogue: 0,0:14:45.00,0:14:47.42,Default,,0,0,0,,18-ден кейінгі сандар да бар...
Dialogue: 0,0:14:47.76,0:14:51.59,Default,,0,0,0,,Бірақ нөлдік нөлдік санды 13-ке қою керек емес пе?
Dialogue: 0,0:14:52.72,0:14:56.43,Default,,0,0,0,,Бұл дұрыс, бірақ доктор Адамс ұсынған жоспар солай
Dialogue: 0,0:14:56.60,0:14:58.60,Default,,0,0,0,,Бұл сәл басқаша.
Dialogue: 0,0:14:58.93,0:15:03.11,Default,,0,0,0,,Егер Скаар қызықтырса... немесе...
Dialogue: 0,0:15:03.23,0:15:05.11,Default,,0,0,0,,Жоспар қандай?
Dialogue: 0,0:15:05.90,0:15:09.78,Default,,0,0,0,,Жасушаларды өзгерту және кез келген нәрсеге түрлендіру мүмкіндігі
Dialogue: 0,0:15:09.90,0:15:12.62,Default,,0,0,0,,Егер бұл 007 мүмкіндігі болса
Dialogue: 0,0:15:13.41,0:15:17.75,Default,,0,0,0,,Жасуша қызметі өзін-өзі қалпына келтіруге және денені нығайтуға мамандандырылған
Dialogue: 0,0:15:17.87,0:15:21.08,Default,,0,0,0,,Жетілдірілген теңшеу – доктор Адамстың көздегені.
Dialogue: 0,0:15:21.21,0:15:23.04,Default,,0,0,0,,Бұл зерттеу тақырыбы болды.
Dialogue: 0,0:15:27.55,0:15:30.34,Default,,0,0,0,,Сонымен зерттеу жалғасты ма?
Dialogue: 0,0:15:31.18,0:15:34.64,Default,,0,0,0,,Қара елесті Ван Богут басқарады.
Dialogue: 0,0:15:34.76,0:15:38.14,Default,,0,0,0,,«Богут бағдарламасы» деп аталатын тәуелсіз зерттеу ұйымы да бар.
Dialogue: 0,0:15:38.56,0:15:39.93,Default,,0,0,0,,Мүмкін сонда...
Dialogue: 0,0:15:40.35,0:15:42.77,Default,,0,0,0,,Сіз екеуміз ағайындымыз деп айта аламын.
Dialogue: 0,0:15:42.90,0:15:44.81,Default,,0,0,0,,Бұлай емес деп айтуға болады.
Dialogue: 0,0:15:45.65,0:15:46.82,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:46.94,0:15:49.23,Default,,0,0,0,,Оның айтқысы келгені осы ма?
Dialogue: 0,0:15:49.36,0:15:52.53,Default,,0,0,0,,Негізі мені мазалайтын тағы бір жайт бар.
Dialogue: 0,0:15:52.82,0:15:54.32,Default,,0,0,0,,Бұл не, доктор?
Dialogue: 0,0:15:54.82,0:15:58.83,Default,,0,0,0,,Доктор Адамстың зерттеулері жаңашыл болғанымен,
Dialogue: 0,0:15:59.45,0:16:03.21,Default,,0,0,0,,Алғашқыда адамда болатын белоктардың өзгеруіне байланысты
Dialogue: 0,0:16:03.33,0:16:06.59,Default,,0,0,0,,Денені шыңдаудың әлі де шегі бар.
Dialogue: 0,0:16:06.71,0:16:09.84,Default,,0,0,0,,Оны зерттеуші әріптестер де көрсеткен.
Dialogue: 0,0:16:09.96,0:16:10.80,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:16:15.22,0:16:17.35,Default,,0,0,0,,Балалар сендер түсінбейсіңдер!
Dialogue: 0,0:16:17.68,0:16:20.10,Default,,0,0,0,,Менің қосымша әдетім
Dialogue: 0,0:16:20.22,0:16:22.81,Default,,0,0,0,,Сіз ең күшті киборг бола аласыз!
Dialogue: 0,0:16:23.52,0:16:26.69,Default,,0,0,0,,Еш нәрсе тек адам жасушаларына ғана үлгіленбейді.
Dialogue: 0,0:16:27.02,0:16:29.90,Default,,0,0,0,,Жеке тұлға ретінде тамаша ұяшықтарды табыңыз!
Dialogue: 0,0:16:30.23,0:16:32.24,Default,,0,0,0,,Ақшақар мен қасқыр!
Dialogue: 0,0:16:32.36,0:16:35.99,Default,,0,0,0,,Аңдар туралы аңыз болса, дүние жүзінде таулар бар.
Dialogue: 0,0:16:36.41,0:16:41.08,Default,,0,0,0,,Шайтан ше! Әрқашан адамнан күшті нәсіл бар!
Dialogue: 0,0:16:41.41,0:16:45.25,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:16:46.00,0:16:48.04,Default,,0,0,0,,Сіз бұған шындап қарайсыз ба?
Dialogue: 0,0:16:48.29,0:16:50.30,Default,,0,0,0,,Ешкім сенбеді
Dialogue: 0,0:16:50.84,0:16:54.72,Default,,0,0,0,,Әрине, мен де осы уақытқа дейін... емеспін.
Dialogue: 0,0:16:54.88,0:16:57.05,Default,,0,0,0,,Не? (006) Сіз нені айтып тұрсыз, Әл?
Dialogue: 0,0:16:57.39,0:17:00.31,Default,,0,0,0,,009-ның тыртығына жапсырылған.
Dialogue: 0,0:17:00.43,0:17:02.89,Default,,0,0,0,,Егер сіз жануар терісінің бір бөлігін зерттеп көрсеңіз,
Dialogue: 0,0:17:03.06,0:17:05.60,Default,,0,0,0,,Мен қарап тұрғанда адам жасушасына айналды.
Dialogue: 0,0:17:05.81,0:17:09.77,Default,,0,0,0,,Бұл биологиялық мүмкін емес құбылыс және оны бағалау мүмкін емес.
Dialogue: 0,0:17:09.90,0:17:14.03,Default,,0,0,0,,Бірақ белгісіз ұяшықтардың болғаны анық.
Dialogue: 0,0:17:15.03,0:17:17.24,Default,,0,0,0,,Осы уақытта Эдвард пайда болады
Dialogue: 0,0:17:17.41,0:17:22.41,Default,,0,0,0,,Екінші жағынан, 009 шайтанның өзі болатын тіршілік формасына тап болды.
Dialogue: 0,0:17:23.00,0:17:25.66,Default,,0,0,0,,Мұны кездейсоқтық деп тануға болмайды...
Dialogue: 0,0:17:26.92,0:17:30.21,Default,,0,0,0,,Ежелден адамдар мен жындар арасында келісім-шарт болған.
Dialogue: 0,0:17:30.54,0:17:34.21,Default,,0,0,0,,Ібілістің айтқаны бірдей орындалды
Dialogue: 0,0:17:34.84,0:17:39.01,Default,,0,0,0,,Бірақ мұның бәрі шайтанның қақпанындай
Dialogue: 0,0:17:39.14,0:17:43.18,Default,,0,0,0,,Иә, үш тілек орындалады дейді.
Dialogue: 0,0:17:43.31,0:17:46.10,Default,,0,0,0,,Жын ертегісіне ұқсас
Dialogue: 0,0:17:46.81,0:17:51.44,Default,,0,0,0,,Хехехе, денесіз жын батыр Атун.
Dialogue: 0,0:17:51.94,0:17:56.70,Default,,0,0,0,,Сенің сыбырың мені құрдымға апарса да
Dialogue: 0,0:17:56.86,0:17:59.45,Default,,0,0,0,,Мен жүруді тоқтатпаймын
Dialogue: 0,0:18:03.37,0:18:05.45,Default,,0,0,0,,Иә! Сіз оны сезінесіз бе?
Dialogue: 0,0:18:05.62,0:18:08.08,Default,,0,0,0,,Оянуға шақыратын жау
Dialogue: 0,0:18:08.21,0:18:10.54,Default,,0,0,0,,Жақында, Жемге алданып.
Dialogue: 0,0:18:10.67,0:18:15.88,Default,,0,0,0,,Фахахаха...
Dialogue: 0,0:18:19.51,0:18:22.97,Default,,0,0,0,,Дайын. Осы мониторда визуализация.
Dialogue: 0,0:18:23.64,0:18:24.85,Default,,0,0,0,,Деректеріңізді жіберіңіз
Dialogue: 0,0:18:26.73,0:18:29.27,Default,,0,0,0,,Осы уақытқа дейін жиналған іздеу нәтижелері және
Dialogue: 0,0:18:29.52,0:18:30.69,Default,,0,0,0,,Спутниктен алынған сурет
Dialogue: 0,0:18:30.81,0:18:33.15,Default,,0,0,0,,003 (Нөл нөл үш) кейінгі сканерлеуді орындады.
Dialogue: 0,0:18:38.28,0:18:39.95,Default,,0,0,0,,Бұл орман кеше... болды ма?
Dialogue: 0,0:18:40.24,0:18:41.12,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:18:41.24,0:18:45.24,Default,,0,0,0,,009 төбелесіп жатқанда, мен аздаған дыбыс естідім.
Dialogue: 0,0:18:45.49,0:18:47.04,Default,,0,0,0,,Тым кішкентай реакция
Dialogue: 0,0:18:47.16,0:18:49.33,Default,,0,0,0,,Мен оны ұрысқан адамдікі деп ойладым...
Dialogue: 0,0:18:50.17,0:18:53.88,Default,,0,0,0,,Мен шайқасқан қарсылас механикалық тіршілік формасы емес еді.
Dialogue: 0,0:18:54.00,0:18:54.84,Default,,0,0,0,,Иә
Dialogue: 0,0:18:55.55,0:18:59.13,Default,,0,0,0,,Камуфляжды болғаны сонша, мен де айта алмадым...
Dialogue: 0,0:18:59.26,0:19:01.68,Default,,0,0,0,,Жау да солай жасайды. (003) Тоқта!
Dialogue: 0,0:19:01.84,0:19:04.81,Default,,0,0,0,,Өте! Дехехе... (003) Хмф!
Dialogue: 0,0:19:05.56,0:19:11.27,Default,,0,0,0,,Ағаштар теңізіне кіре берісте адам тұрмайтын шөл дала мен таулы аймақ алда не күтіп тұр?
Dialogue: 0,0:19:11.69,0:19:14.48,Default,,0,0,0,,Бұл жасырынуға және бірдеңе жасауға тамаша орын.
Dialogue: 0,0:19:16.65,0:19:17.86,Default,,0,0,0,,Оны таптым!
Dialogue: 0,0:19:45.80,0:19:47.89,Default,,0,0,0,,Балласты ағызу аяқталды
Dialogue: 0,0:19:48.43,0:19:50.64,Default,,0,0,0,,Қозғалтқышты тұтандырудағы Стерет режимі
Dialogue: 0,0:20:09.20,0:20:11.08,Default,,0,0,0,,Жақында оқиға орнында боламыз.
Dialogue: 0,0:20:13.25,0:20:15.25,Default,,0,0,0,,Иә? (002) Не?
Dialogue: 0,0:20:15.88,0:20:16.96,Default,,0,0,0,,Радарда ештеңе жоқ...
Dialogue: 0,0:20:17.63,0:20:19.71,Default,,0,0,0,,Мен де білмеймін. Сақ болыңыз!
Dialogue: 0,0:20:20.42,0:20:21.92,Default,,0,0,0,,Шабуылдың жаңа түрі?
Dialogue: 0,0:20:22.63,0:20:24.13,Default,,0,0,0,,Альберто…
Dialogue: 0,0:20:27.43,0:20:29.43,Default,,0,0,0,,Ах! Хилда!
Dialogue: 0,0:20:30.39,0:20:31.56,Default,,0,0,0,,Мен сені сағындым
Dialogue: 0,0:20:31.68,0:20:32.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:34.14,0:20:34.98,Default,,0,0,0,,Ағын
Dialogue: 0,0:20:35.52,0:20:36.94,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:20:37.06,0:20:40.07,Default,,0,0,0,,Иә, тамаша, мен сені сағындым.
Dialogue: 0,0:20:43.24,0:20:46.95,Default,,0,0,0,,О, тамаша сүйкімділік үшін дим сом!
Dialogue: 0,0:20:47.91,0:20:48.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:50.37,0:20:51.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:52.96,0:20:55.00,Default,,0,0,0,,Барлығына не болды?
Dialogue: 0,0:20:56.29,0:20:57.54,Default,,0,0,0,,００９
Dialogue: 0,0:20:58.17,0:20:59.09,Default,,0,0,0,,Жо-жоқ… мүмкін емес… осы сөмкенің ішінде не бар!
Dialogue: 0,0:20:59.63,0:21:01.71,Default,,0,0,0,,Джо, мен сені сағындым.
Dialogue: 0,0:21:02.01,0:21:03.59,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:21:06.01,0:21:07.55,Default,,0,0,0,,Уф! басқа!
Dialogue: 0,0:21:08.35,0:21:10.51,Default,,0,0,0,,Уху... а?
Dialogue: 0,0:21:10.64,0:21:11.81,Default,,0,0,0,,Бұл ақымақтық.
Dialogue: 0,0:21:13.77,0:21:16.94,Default,,0,0,0,,Хилда қайтыс болды, бірақ ол әрқашан менімен бірге.
Dialogue: 0,0:21:17.23,0:21:20.94,Default,,0,0,0,,Қазір арамызда мұндай нәрсеге құмар адам жоқ.
Dialogue: 0,0:21:21.15,0:21:23.82,Default,,0,0,0,,Дехехехе...
Dialogue: 0,0:21:23.99,0:21:24.95,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:25.24,0:21:27.32,Default,,0,0,0,,Мықты болыңыз 007
Dialogue: 0,0:21:27.49,0:21:28.62,Default,,0,0,0,,Жек көру...?
Dialogue: 0,0:21:28.87,0:21:33.00,Default,,0,0,0,,Әйелдің ессіз елесін тек ер адамдарға көрсете ме?
Dialogue: 0,0:21:33.33,0:21:36.67,Default,,0,0,0,,Егер бұл бақсы аңыз болса, бұл суккубус немесе Лилит.
Dialogue: 0,0:21:37.08,0:21:39.50,Default,,0,0,0,,Хмм... хехе...
Dialogue: 0,0:21:41.67,0:21:43.88,Default,,0,0,0,,Не! Апыр-ай!
Dialogue: 0,0:21:44.09,0:21:47.63,Default,,0,0,0,,Адамға ұқсайды! Өздеріңізден хабардар болыңыздар!
Dialogue: 0,0:21:47.76,0:21:49.80,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:21:50.10,0:21:52.56,Default,,0,0,0,,Уф! (006) Бұл не?
Dialogue: 0,0:21:55.02,0:21:57.69,Default,,0,0,0,,Кенет бір топ келіп амандасады...?
Dialogue: 0,0:22:00.44,0:22:04.28,Default,,0,0,0,,Бұл 009-мен шайқасқан адамнан өзгеше.
Dialogue: 0,0:22:04.40,0:22:06.03,Default,,0,0,0,,Иә, мен де солай ойлаймын.
Dialogue: 0,0:22:13.91,0:22:14.79,Default,,0,0,0,,Лизат
Dialogue: 0,0:22:22.09,0:22:24.59,Default,,0,0,0,,Мұны да Қара елес жасады ма?
Dialogue: 0,0:22:24.71,0:22:27.38,Default,,0,0,0,,Мен түсінбеймін...! Мен сонда болғанда
Dialogue: 0,0:22:27.51,0:22:29.68,Default,,0,0,0,,Менде мұндай көп жоспар болған жоқ.
Dialogue: 0,0:22:29.80,0:22:32.43,Default,,0,0,0,,Осы уақытқа дейінгі ақпаратпен біріктірілген,
Dialogue: 0,0:22:32.55,0:22:36.93,Default,,0,0,0,,Сондай-ақ, Қара елестен басқа тұлға араласып жатқан сияқты.
Dialogue: 0,0:22:37.43,0:22:39.06,Default,,0,0,0,,Тағы бір «шайтан»?
Dialogue: 0,0:22:39.44,0:22:41.52,Default,,0,0,0,,Ах, бірақ егер...
Dialogue: 0,0:22:42.06,0:22:46.07,Default,,0,0,0,,«Ібіліс» пен «шайтан» қол ұстасып кете ме... Бұл мені жылатады.
Dialogue: 0,0:22:51.87,0:22:52.78,Default,,0,0,0,,Мен палубаға түстім.
Dialogue: 0,0:22:52.91,0:22:53.45,Default,,0,0,0,,Не?
Dialogue: 0,0:22:53.83,0:22:56.83,Default,,0,0,0,,Егер менде мұндай нәрсе болмаса, мен ұша алмас едім.
Dialogue: 0,0:22:56.95,0:22:59.75,Default,,0,0,0,,Адамдар – ыңғайсыз жаратылыс.
Dialogue: 0,0:23:05.42,0:23:08.26,Default,,0,0,0,,Не... не? (006) Қозғалтқыш шығысы төмендеді.
Dialogue: 0,0:23:08.42,0:23:09.67,Default,,0,0,0,,Ол қабылдау портында тұрып қалды!
Dialogue: 0,0:23:10.05,0:23:10.76,Default,,0,0,0,,Чи…
Dialogue: 0,0:23:10.93,0:23:14.22,Default,,0,0,0,,Шарасыз құс соққысы! Мен шығамын!
Dialogue: 0,0:23:21.23,0:23:23.48,Default,,0,0,0,,Жоқ! Бұлай жалғаса берсе, Дельфин жоқ болады!
Dialogue: 0,0:23:31.40,0:23:33.03,Default,,0,0,0,,Гао...гаа
Dialogue: 0,0:23:33.45,0:23:35.49,Default,,0,0,0,,Қарғыс атсын! Ешқандай шектеу жоқ!
Dialogue: 0,0:23:38.79,0:23:39.75,Default,,0,0,0,,Гао!
Dialogue: 0,0:23:40.87,0:23:43.67,Default,,0,0,0,,Уф... бұл жиіркенішті шабуыл.
Dialogue: 0,0:23:43.79,0:23:46.25,Default,,0,0,0,,Ах... Уау! Ugg…
Dialogue: 0,0:23:49.59,0:23:50.84,Default,,0,0,0,,００９！
Dialogue: 0,0:23:51.01,0:23:53.26,Default,,0,0,0,,002 (Нөл нөл екі) Үдеткішті пайдаланыңыз.
Dialogue: 0,0:23:53.39,0:23:54.26,Default,,0,0,0,,О!
Dialogue: 0,0:23:55.26,0:23:56.56,Default,,0,0,0,,Гао!
Dialogue: 0,0:23:57.56,0:24:00.02,Default,,0,0,0,,жеткілікті жылдам қозғала білу
Dialogue: 0,0:24:01.14,0:24:03.94,Default,,0,0,0,,Сіз Қара елеспен байланыстасыз ба?
Dialogue: 0,0:24:04.06,0:24:06.36,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:24:06.48,0:24:08.73,Default,,0,0,0,,Сен сүйкімдісің
Dialogue: 0,0:24:08.86,0:24:11.15,Default,,0,0,0,,Мен жын нәсілінің Лилитімін
Dialogue: 0,0:24:11.53,0:24:13.03,Default,,0,0,0,,Иә? (003) Жын тайпасы...
Dialogue: 0,0:24:13.16,0:24:14.20,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:24:14.32,0:24:14.95,Default,,0,0,0,,(Жүйенің ескерту дыбысы)
Dialogue: 0,0:24:15.07,0:24:17.03,Default,,0,0,0,,Тік саптамалар жүйесі төмен!
Dialogue: 0,0:24:17.33,0:24:19.12,Default,,0,0,0,,Біз бірдеңе істей алмаймыз ба?
Dialogue: 0,0:24:19.24,0:24:22.33,Default,,0,0,0,,Бізде бәрі жақсы, бірақ дәрігер мен 001 шыдай алмайды!
Dialogue: 0,0:24:22.66,0:24:24.96,Default,,0,0,0,,Ал, сенің кеудеңе қонудан басқа амалың жоқ!
Dialogue: 0,0:24:25.08,0:24:27.92,Default,,0,0,0,,(Зеңбіректің жарылған дыбысы)
Dialogue: 0,0:24:30.84,0:24:33.01,Default,,0,0,0,,Гао (009) Уф...
Dialogue: 0,0:24:33.18,0:24:35.18,Default,,0,0,0,,Қарғыс атсын... Жақсы.
Dialogue: 0,0:24:36.01,0:24:38.81,Default,,0,0,0,,Құсқа айналып, сыртқа шығуым керек пе еді.
Dialogue: 0,0:24:39.06,0:24:40.77,Default,,0,0,0,,Тілімді тістеймін (007) Жаман!
Dialogue: 0,0:24:41.18,0:24:43.23,Default,,0,0,0,,Кіріспе курс Жарайды.
Dialogue: 0,0:24:43.64,0:24:44.81,Default,,0,0,0,,Жақсы! Барайық!
Dialogue: 0,0:24:56.82,0:24:57.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:04.41,0:25:06.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:06.63,0:25:09.42,Default,,0,0,0,,Көл! (006) Баллас шықты.
Dialogue: 0,0:25:09.54,0:25:11.55,Default,,0,0,0,,Құлап қалсаң, бетінен шыға алмайсың, Әл!
Dialogue: 0,0:25:11.67,0:25:12.51,Default,,0,0,0,,Кері инъекция!
Dialogue: 0,0:25:18.26,0:25:20.60,Default,,0,0,0,,Ал... Әл тоқтай алмайды! (008) Зәкірді ұшыру!
Dialogue: 0,0:25:24.14,0:25:27.23,Default,,0,0,0,,Уау! Ах... ой...
Dialogue: 0,0:25:34.57,0:25:35.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:44.66,0:25:45.46,Default,,0,0,0,,тоқтатылды
Dialogue: 0,0:25:45.66,0:25:47.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:25:50.25,0:25:53.17,Default,,0,0,0,,Хехе... Қызық
Dialogue: 0,0:26:01.55,0:26:03.60,Default,,0,0,0,,Мен ақырында жабайы бола аламын.
Dialogue: 0,0:26:03.72,0:26:07.81,Default,,0,0,0,,Жындар? Мені ұратын жындардан қорықпаймын.
Dialogue: 0,0:26:14.07,0:26:15.99,Default,,0,0,0,,Иә? Ахх
Dialogue: 0,0:26:19.11,0:26:19.91,Default,,0,0,0,,​​О?
Dialogue: 0,0:26:21.87,0:26:22.78,Default,,0,0,0,,Мики...!
Dialogue: 0,0:26:30.17,0:26:33.63,Default,,0,0,0,,Эдвард екеуміз жасөспірімдер санының жоғары деңгейін орындадық.
Dialogue: 0,0:26:33.80,0:26:36.97,Default,,0,0,0,,Жетілдірілген теңшелім
Dialogue: 0,0:26:37.13,0:26:40.51,Default,,0,0,0,,Бұл алдыңғы киборг зерттеулерінен әлдеқайда асып түседі.
Dialogue: 0,0:26:40.64,0:26:43.35,Default,,0,0,0,,Менің зерттеуім олай емес.
Dialogue: 0,0:26:55.40,0:26:58.15,Default,,0,0,0,,хехехе ең жоғары мүмкін
Dialogue: 0,0:26:58.32,0:27:00.32,Default,,0,0,0,,Кеңейтілген теңшелім
Dialogue: 0,0:27:00.49,0:27:03.28,Default,,0,0,0,,Міне, мен дамыттым
Dialogue: 0,0:27:03.41,0:27:07.00,Default,,0,0,0,,Киборгтар мен нағыз жындардың одан әрі қосылуы
Dialogue: 0,0:27:07.25,0:27:10.25,Default,,0,0,0,,Тағы да... Сәл күте тұрыңыз.
Dialogue: 0,0:27:10.37,0:27:13.00,Default,,0,0,0,,Мен сені оятуға шақыратын Амонды ұрлап алдым.
Dialogue: 0,0:27:13.17,0:27:17.09,Default,,0,0,0,,Ібіліс келе жатыр. Алыңыз!
Dialogue: 0,0:27:17.26,0:27:20.88,Default,,0,0,0,,Сет денесімен бірігетін тамаша үйлесімді дене.
Dialogue: 0,0:27:21.01,0:27:24.35,Default,,0,0,0,,Ібіліс өзгерткен ең күшті адам бол!
Dialogue: 0,0:27:24.47,0:27:26.60,Default,,0,0,0,,Увахахаха
Dialogue: 0,0:27:26.81,0:27:29.48,Default,,0,0,0,,Вахахахаха...
Dialogue: 0,0:27:29.68,0:27:33.36,Default,,0,0,0,,Хахахахаха…
Dialogue: 0,0:27:35.77,0:27:40.82,Default,,0,0,0,,（♪）
Dialogue: 0,0:27:42.32,0:27:48.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory