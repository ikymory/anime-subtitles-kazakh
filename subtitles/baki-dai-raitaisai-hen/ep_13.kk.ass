Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.34,0:00:17.35,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:34.17,0:01:40.18,Default,,0,0,0,,~♪
Dialogue: 0,0:01:41.43,0:01:45.02,Default,,0,0,0,,(төтенше қоңырау)
Dialogue: 0,0:01:45.14,0:01:46.77,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:01:48.39,0:01:50.27,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:01:52.86,0:01:53.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:58.32,0:01:59.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:59.32,0:02:00.70,Default,,0,0,0,,Не болды, Рюзаки?
Dialogue: 0,0:02:02.08,0:02:03.20,Default,,0,0,0,,Төтенше жағдайға көшу!
Dialogue: 0,0:02:03.87,0:02:05.70,Default,,0,0,0,,Итті шығарыңыз! Ит!
Dialogue: 0,0:02:10.21,0:02:12.17,Default,,0,0,0,,Рюко Янаги
Dialogue: 0,0:02:16.42,0:02:19.26,Default,,0,0,0,,Өлім жазасына кесілген ең нашар тұтқындардың бірі
Dialogue: 0,0:02:20.51,0:02:24.85,Default,,0,0,0,,Бірде, дәл осы жолы түрмеден қашып, Токиоға келді.
Dialogue: 0,0:02:25.06,0:02:26.81,Default,,0,0,0,,Шұғыл! төтенше жағдай!
Dialogue: 0,0:02:27.52,0:02:31.52,Default,,0,0,0,,Кішкентай фигура, биіктігі 160 см-ден аз
Dialogue: 0,0:02:32.19,0:02:36.07,Default,,0,0,0,,Алайда, алақанда бір сәтте пайда болған вакуумға байланысты,
Dialogue: 0,0:02:36.94,0:02:39.03,Default,,0,0,0,,Тіпті шыңдалған шыныны сындырады
Dialogue: 0,0:02:39.40,0:02:42.45,Default,,0,0,0,,Мықты адамды да әп-сәтте есінен танып қалуы мүмкін.
Dialogue: 0,0:02:44.20,0:02:47.00,Default,,0,0,0,,Сондай-ақ, өлімші уы бар улы қолмен.
Dialogue: 0,0:02:47.16,0:02:50.42,Default,,0,0,0,,Қарсыласыңызды өлімге дейін жеткізуге болады.
Dialogue: 0,0:02:53.50,0:02:58.76,Default,,0,0,0,,Көптеген шайқастардан кейін ол Мотобу Изоға қолынан айырылды.
Dialogue: 0,0:03:00.26,0:03:05.22,Default,,0,0,0,,Және ол Юдзиро Ханманың соққысынан құлады.
Dialogue: 0,0:03:08.52,0:03:09.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:10.35,0:03:15.27,Default,,0,0,0,,Ол Янаги қашқаннан кейін аман қалған жалғыз түрме офицері болды.
Dialogue: 0,0:03:15.69,0:03:19.53,Default,,0,0,0,,Ол не болғанын айта алуы керек.
Dialogue: 0,0:03:20.86,0:03:22.36,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:03:23.95,0:03:27.41,Default,,0,0,0,,Тіпті Құдайды да осындай нәрсеге алдауға болады.
Dialogue: 0,0:03:29.62,0:03:31.66,Default,,0,0,0,,Мен мұнда келгелі бері болды.
Dialogue: 0,0:03:33.00,0:03:35.13,Default,,0,0,0,,Жартылай акрил тері…
Dialogue: 0,0:03:36.00,0:03:38.09,Default,,0,0,0,,Бір нүктеге қарап...
Dialogue: 0,0:03:38.21,0:03:40.63,Default,,0,0,0,,Немесе сіз ештеңе көрмеген шығарсыз?
Dialogue: 0,0:03:42.05,0:03:43.93,Default,,0,0,0,,Бір ауыз сөз айтпа
Dialogue: 0,0:03:44.26,0:03:47.01,Default,,0,0,0,,Өсімдіктер де белсендірек, солай емес пе?
Dialogue: 0,0:03:50.93,0:03:54.31,Default,,0,0,0,,Кәдімгі палатаға көшу бірауыздан қабылданды.
Dialogue: 0,0:03:57.07,0:03:58.32,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:59.44,0:04:02.49,Default,,0,0,0,,Сіз қозғала аласыз ба?
Dialogue: 0,0:04:04.07,0:04:06.57,Default,,0,0,0,,Жасушаның сыртындағы сол көрініс
Dialogue: 0,0:04:07.70,0:04:09.58,Default,,0,0,0,,Мен өмір бойы ұмытпаймын
Dialogue: 0,0:04:14.25,0:04:15.83,Default,,0,0,0,,Егер сіз қозғала алсаңыз да
Dialogue: 0,0:04:16.42,0:04:18.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:18.63,0:04:20.55,Default,,0,0,0,,Би парақтары
Dialogue: 0,0:04:21.13,0:04:23.26,Default,,0,0,0,,Қан шашыранды... Айқай!
Dialogue: 0,0:04:25.80,0:04:28.05,Default,,0,0,0,,Парақтар құлаған кезде
Dialogue: 0,0:04:28.51,0:04:31.02,Default,,0,0,0,,Рюко Янаги жоқ еді.
Dialogue: 0,0:04:32.18,0:04:33.85,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:04:34.89,0:04:36.31,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:39.07,0:04:41.36,Default,,0,0,0,,Бас инспектор Сонода кіреді.
Dialogue: 0,0:04:43.86,0:04:45.99,Default,,0,0,0,,Есепті көрдім.
Dialogue: 0,0:04:46.28,0:04:48.37,Default,,0,0,0,,Сонда оған не болды?
Dialogue: 0,0:04:48.53,0:04:49.37,Default,,0,0,0,,Га
Dialogue: 0,0:04:49.58,0:04:53.20,Default,,0,0,0,,Түрмеден қашқаннан бері ол туралы хабар естілмеді.
Dialogue: 0,0:04:53.71,0:04:54.54,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:55.46,0:04:59.00,Default,,0,0,0,,Өлім жазасына кесілгендерге қатысты барлық істер шешілді.
Dialogue: 0,0:04:59.46,0:05:01.50,Default,,0,0,0,,Мен осылай естідім.
Dialogue: 0,0:05:01.84,0:05:03.30,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:05:03.67,0:05:06.01,Default,,0,0,0,,Бұл ... болуы керек еді.
Dialogue: 0,0:05:06.63,0:05:09.51,Default,,0,0,0,,Басқа өлім жазасына кесілгендер ше?
Dialogue: 0,0:05:10.39,0:05:12.27,Default,,0,0,0,,дейсіз бе?
Dialogue: 0,0:05:12.72,0:05:15.14,Default,,0,0,0,,Янаги түрмеден қашып кетті деп есептесек
Dialogue: 0,0:05:15.31,0:05:17.69,Default,,0,0,0,,Өлім жазасына кесілген басқа сотталғандардың тағдыры
Dialogue: 0,0:05:17.85,0:05:20.52,Default,,0,0,0,,Тексеруіміз керек емес пе?
Dialogue: 0,0:05:20.69,0:05:22.23,Default,,0,0,0,,Бұл тағы да «ол қазір басталды» сценарийі ме, кіру емтихандарындағыдай?
Dialogue: 0,0:05:22.40,0:05:23.53,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:05:24.36,0:05:25.78,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:05:26.53,0:05:31.16,Default,,0,0,0,,Ха ха ха ха!
Dialogue: 0,0:05:31.83,0:05:32.66,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:32.99,0:05:36.37,Default,,0,0,0,,Мен Дориан бізге қарыз болады деп ешқашан күткен емеспін.
Dialogue: 0,0:05:36.54,0:05:38.17,Default,,0,0,0,,Хохохохо
Dialogue: 0,0:05:38.67,0:05:42.42,Default,,0,0,0,,Дориан - көптеген адамдарды өлтірген өлім жазасына кесілген тұтқын.
Dialogue: 0,0:05:42.59,0:05:47.43,Default,,0,0,0,,Ол бір кездері Байлин храмында кунг-фуды меңгерген теңіз патшаларының бірі болды.
Dialogue: 0,0:05:48.13,0:05:52.85,Default,,0,0,0,,Осы байланысқа байланысты мен оны өз қамқорлығыма қалдыруды шештім.
Dialogue: 0,0:05:53.77,0:05:54.60,Default,,0,0,0,,Дуриан…
Dialogue: 0,0:05:56.48,0:05:57.85,Default,,0,0,0,,Ол да бір рет
Dialogue: 0,0:05:57.98,0:06:02.73,Default,,0,0,0,,Ол Токиоға келген ең өлім жазасына кесілген тұтқындардың бірі болды.
Dialogue: 0,0:06:05.53,0:06:09.28,Default,,0,0,0,,Денеңізде жасырылған көптеген қару-жарақ пен құралдарды қолданып күресіңіз
Dialogue: 0,0:06:12.37,0:06:13.58,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:06:14.20,0:06:20.12,Default,,0,0,0,,Ол тіпті гипнозды басқаларды манипуляциялау үшін қолдана алады.
Dialogue: 0,0:06:24.30,0:06:25.80,Default,,0,0,0,,Бірақ Дориан
Dialogue: 0,0:06:26.34,0:06:30.51,Default,,0,0,0,,Рецукай патшадан соққы алған соң, мен жеңілгенімді білдім.
Dialogue: 0,0:06:30.68,0:06:31.84,Default,,0,0,0,,Мен байқадым
Dialogue: 0,0:06:32.97,0:06:36.64,Default,,0,0,0,,Бұл өмірді жеңіспен бояу керек еді.
Dialogue: 0,0:06:37.14,0:06:40.44,Default,,0,0,0,,Жемісі қараңғылыққа толы...
Dialogue: 0,0:06:41.15,0:06:43.94,Default,,0,0,0,,Содан бері ол
Dialogue: 0,0:06:44.07,0:06:48.24,Default,,0,0,0,,Ол бала санасына оралуы керек еді.
Dialogue: 0,0:06:49.45,0:06:51.41,Default,,0,0,0,,Кәмпит
Dialogue: 0,0:06:53.53,0:06:55.54,Default,,0,0,0,,Кәмпит
Dialogue: 0,0:06:56.45,0:06:57.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:58.08,0:06:58.96,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:07:01.71,0:07:03.71,Default,,0,0,0,,Кәмпит…
Dialogue: 0,0:07:05.04,0:07:06.75,Default,,0,0,0,,Міне.
Dialogue: 0,0:07:07.59,0:07:09.34,Default,,0,0,0,,Маған осылай аталған «толқындарды» жібергің келе ме?
Dialogue: 0,0:07:16.47,0:07:19.98,Default,,0,0,0,,До... Дориан сурет салып жатыр ма?
Dialogue: 0,0:07:20.14,0:07:23.10,Default,,0,0,0,,Оның үстіне бұл сурет... кәмпит пе?
Dialogue: 0,0:07:23.48,0:07:26.52,Default,,0,0,0,,Қош бол, бұл Кәмпиттің суреті.
Dialogue: 0,0:07:26.69,0:07:29.65,Default,,0,0,0,,Қазірдің өзінде қанша дана бар?
Dialogue: 0,0:07:29.82,0:07:31.61,Default,,0,0,0,,Мен тек кәмпит саламын
Dialogue: 0,0:07:32.28,0:07:35.12,Default,,0,0,0,,Бұл жақсы, ол жақсы сатылады.
Dialogue: 0,0:07:35.70,0:07:38.20,Default,,0,0,0,,Бұл да өте жоғары баға.
Dialogue: 0,0:07:38.41,0:07:40.54,Default,,0,0,0,,Бұл сурет сатыла ма?
Dialogue: 0,0:07:40.71,0:07:42.87,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:07:44.13,0:07:45.63,Default,,0,0,0,,Мәселе мынада...
Dialogue: 0,0:07:46.21,0:07:48.17,Default,,0,0,0,,Бұл пішін.
Dialogue: 0,0:07:48.34,0:07:50.92,Default,,0,0,0,,Бұл жаттығудың бір түрі ме?
Dialogue: 0,0:07:51.09,0:07:52.09,Default,,0,0,0,,Иә
Dialogue: 0,0:07:52.63,0:07:56.39,Default,,0,0,0,,Төменгі денені нығайтуға арналған қытайлық жекпе-жек жаттығулары
Dialogue: 0,0:07:56.85,0:07:59.56,Default,,0,0,0,,Бұл «Камелия станциясы» деп аталады.
Dialogue: 0,0:07:59.77,0:08:01.93,Default,,0,0,0,,Және соншалықты терең
Dialogue: 0,0:08:02.10,0:08:04.85,Default,,0,0,0,,Мұны қалай... қанша уақыт істеп жүрсің?
Dialogue: 0,0:08:05.02,0:08:08.40,Default,,0,0,0,,Ахахаха... Болды.
Dialogue: 0,0:08:08.69,0:08:10.86,Default,,0,0,0,,Хмм... мм.
Dialogue: 0,0:08:11.40,0:08:12.99,Default,,0,0,0,,Кәмпит
Dialogue: 0,0:08:15.41,0:08:17.45,Default,,0,0,0,,Үйілген кәмпит
Dialogue: 0,0:08:19.41,0:08:22.66,Default,,0,0,0,,Мен мұның бәрін жалап болғанша тоқтамаймын.
Dialogue: 0,0:08:23.29,0:08:26.04,Default,,0,0,0,,Нәтиже: Сол төменгі дене.
Dialogue: 0,0:08:26.71,0:08:30.92,Default,,0,0,0,,Менің де салмағым оңалту басталғаннан бері 20 кг-ға артты.
Dialogue: 0,0:08:31.38,0:08:35.18,Default,,0,0,0,,Мұны реабилитация деп атауға бола ма?
Dialogue: 0,0:08:37.60,0:08:38.43,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:40.01,0:08:41.68,Default,,0,0,0,,Дорианның әрекеті...
Dialogue: 0,0:08:42.27,0:08:45.44,Default,,0,0,0,,Бұл оңалту емес.
Dialogue: 0,0:08:46.85,0:08:47.94,Default,,0,0,0,,Дайындық…
Dialogue: 0,0:08:49.32,0:08:51.69,Default,,0,0,0,,Үлкен нәрсеге дайындалу
Dialogue: 0,0:08:52.49,0:08:56.99,Default,,0,0,0,,Бұл маған тіпті мұқият дайындық сияқты көрінді.
Dialogue: 0,0:09:02.29,0:09:05.83,Default,,0,0,0,,Біз сізді тыңдаймыз. Мында басыңыз.
Dialogue: 0,0:09:07.96,0:09:12.00,Default,,0,0,0,,Кез келген уақыттағы бюджеттің қысқаруына байланысты біз осындай жағдайға тап болдық.
Dialogue: 0,0:09:12.17,0:09:15.26,Default,,0,0,0,,Тіпті жарықтандыру кешіктірілді.
Dialogue: 0,0:09:15.72,0:09:17.76,Default,,0,0,0,,Дойл үшін
Dialogue: 0,0:09:17.93,0:09:21.56,Default,,0,0,0,,Жарық және тіпті дыбыстар маңызды емес.
Dialogue: 0,0:09:21.72,0:09:22.60,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:09:22.72,0:09:23.56,Default,,0,0,0,,Иә
Dialogue: 0,0:09:23.68,0:09:27.10,Default,,0,0,0,,Ол өзінің құлақ қалқанын жарып жіберді.
Dialogue: 0,0:09:32.23,0:09:34.24,Default,,0,0,0,,Құлақ жарғағы жарылды ма?
Dialogue: 0,0:09:34.69,0:09:37.61,Default,,0,0,0,,Дойл соқыр болса керек.
Dialogue: 0,0:09:39.16,0:09:39.99,Default,,0,0,0,,Дойл…
Dialogue: 0,0:09:42.12,0:09:45.29,Default,,0,0,0,,Ол сондай-ақ өлім жазасына кесілген ең нашар тұтқындардың бірі.
Dialogue: 0,0:09:45.66,0:09:47.21,Default,,0,0,0,,Шынжырсыз мырза
Dialogue: 0,0:09:48.37,0:09:51.46,Default,,0,0,0,,Оқ-дәрі арқылы бүкіл денеге имплантацияланған қару
Dialogue: 0,0:09:52.09,0:09:53.50,Default,,0,0,0,,Ол өзін қаруға айналдырды.
Dialogue: 0,0:09:55.17,0:09:56.05,Default,,0,0,0,,Келіңіз...
Dialogue: 0,0:09:56.42,0:09:57.93,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:01.97,0:10:02.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:03.06,0:10:05.89,Default,,0,0,0,,Хмф! Апыр-ай!
Dialogue: 0,0:10:06.06,0:10:08.81,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:10:12.69,0:10:16.03,Default,,0,0,0,,Жоқ! жоқ~!
Dialogue: 0,0:10:16.19,0:10:18.36,Default,,0,0,0,,Гах... ха...
Dialogue: 0,0:10:19.45,0:10:20.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:22.53,0:10:23.37,Default,,0,0,0,,Гухаа
Dialogue: 0,0:10:25.54,0:10:26.37,Default,,0,0,0,,Ей! Уау
Dialogue: 0,0:10:26.62,0:10:29.42,Default,,0,0,0,,Шиншинкайлармен күресте
Dialogue: 0,0:10:29.67,0:10:31.83,Default,,0,0,0,,Оның көңіл күйінде өзгеріс болды.
Dialogue: 0,0:10:32.00,0:10:35.46,Default,,0,0,0,,Дойл өзінің жеңілгенін ақыры білді.
Dialogue: 0,0:10:39.34,0:10:44.01,Default,,0,0,0,,Бірақ кейінгі шайқаста оның екі көзі де көрмей қалды.
Dialogue: 0,0:10:44.18,0:10:47.77,Default,,0,0,0,,Және осы медициналық түрмеде қамалды.
Dialogue: 0,0:10:48.60,0:10:49.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:50.69,0:10:51.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:53.06,0:10:57.28,Default,,0,0,0,,Неліктен соқыр Дойлдың құлақ қалқаны жарылып қалды?
Dialogue: 0,0:10:57.53,0:10:59.82,Default,,0,0,0,,Менде ештеңе жоқ
Dialogue: 0,0:11:00.45,0:11:01.28,Default,,0,0,0,,Тек...
Dialogue: 0,0:11:01.66,0:11:02.49,Default,,0,0,0,,Сіз оны қалай тапқаныңызды білсем бола ма?
Dialogue: 0,0:11:02.82,0:11:05.16,Default,,0,0,0,,Дойл осында кірген кезде
Dialogue: 0,0:11:05.28,0:11:07.54,Default,,0,0,0,,Сіз біртүрлі нәрсе айттыңыз.
Dialogue: 0,0:11:11.79,0:11:15.75,Default,,0,0,0,,Біраз қолайсыздық тудыруы мүмкін, бірақ бар күшіңізді салыңыз...
Dialogue: 0,0:11:15.88,0:11:17.17,Default,,0,0,0,,Жоқ! (Бастық) А?
Dialogue: 0,0:11:17.63,0:11:20.17,Default,,0,0,0,,Ыңғайсыз ештеңе жоқ.
Dialogue: 0,0:11:20.34,0:11:21.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:21.55,0:11:23.93,Default,,0,0,0,,Мен қанағаттандым
Dialogue: 0,0:11:24.30,0:11:29.39,Default,,0,0,0,,Жарық деп аталатын керемет үлкен нәрсенің жоғалуына байланысты.
Dialogue: 0,0:11:29.89,0:11:35.48,Default,,0,0,0,,Мен нұрға айналар үлкен қазынаға ие болдым.
Dialogue: 0,0:11:35.82,0:11:36.94,Default,,0,0,0,,Хо
Dialogue: 0,0:11:37.27,0:11:38.94,Default,,0,0,0,,Олай болса, бастық.
Dialogue: 0,0:11:40.57,0:11:41.45,Default,,0,0,0,,«Дыбыс»
Dialogue: 0,0:11:42.11,0:11:45.32,Default,,0,0,0,,Дыбыс деп аталатын тағы бір үлкен сезім
Dialogue: 0,0:11:45.87,0:11:47.83,Default,,0,0,0,,Тыңдау үшін
Dialogue: 0,0:11:49.29,0:11:50.33,Default,,0,0,0,,Бастық…
Dialogue: 0,0:11:51.37,0:11:54.79,Default,,0,0,0,,Нақты не аламыз?
Dialogue: 0,0:11:56.00,0:11:59.55,Default,,0,0,0,,Сонымен Дойл өзінің құлақ қалқанын жарып жіберді.
Dialogue: 0,0:11:59.92,0:12:04.18,Default,,0,0,0,,Сонда ол не алды?
Dialogue: 0,0:12:04.47,0:12:06.51,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:12:06.68,0:12:12.02,Default,,0,0,0,,Дегенмен екі құлағы да естімей қалғанына бір жарым жылдай болды.
Dialogue: 0,0:12:12.18,0:12:15.73,Default,,0,0,0,,Түрме қызметкерінің жақында берген хабары бойынша...
Dialogue: 0,0:12:16.19,0:12:19.23,Default,,0,0,0,,Дойл өз бөлмесінде біртүрлі нәрсе істегенін айтты.
Dialogue: 0,0:12:20.19,0:12:21.99,Default,,0,0,0,,Мен сенің жарқанатты ұстап алғаныңды естідім.
Dialogue: 0,0:12:23.28,0:12:24.49,Default,,0,0,0,,Жарғанат?
Dialogue: 0,0:12:24.86,0:12:29.24,Default,,0,0,0,,Иә, өздеріңіз білетіндей, ұяшықтар лас.
Dialogue: 0,0:12:29.83,0:12:31.50,Default,,0,0,0,,Жәндіктер өте көп.
Dialogue: 0,0:12:31.79,0:12:35.50,Default,,0,0,0,,Жарғанат оны көздеп келе жатыр...
Dialogue: 0,0:12:39.75,0:12:42.63,Default,,0,0,0,,Қараңғыда жарғанат?
Шамасы, ол
Dialogue: 0,0:12:42.80,0:12:43.63,Default,,0,0,0,,Иә
Dialogue: 0,0:12:43.80,0:12:47.51,Default,,0,0,0,,-де тағы біртүрлі нәрсе айтты.
Dialogue: 0,0:12:50.26,0:12:51.10,Default,,0,0,0,,Тері…
Dialogue: 0,0:12:51.97,0:12:53.43,Default,,0,0,0,,Тері?
Dialogue: 0,0:12:54.02,0:12:57.27,Default,,0,0,0,,Бұл нені білдіреді...
Dialogue: 0,0:12:57.94,0:13:01.69,Default,,0,0,0,,Дойл қалған тыңдаудан бас тарту үшін тіпті барын салды.
Dialogue: 0,0:13:01.86,0:13:04.61,Default,,0,0,0,,Бұл сенсорлық сезімге ие болды дегенді білдіре ме?
Dialogue: 0,0:13:06.91,0:13:09.95,Default,,0,0,0,,Бірақ қандай мақсатта?
Dialogue: 0,0:13:16.50,0:13:18.29,Default,,0,0,0,,Сикорский?
Dialogue: 0,0:13:18.58,0:13:21.17,Default,,0,0,0,,Ол тыныш жігіт.
Dialogue: 0,0:13:21.34,0:13:24.55,Default,,0,0,0,,Жоқ, қауіпті ештеңе жоқ.
Dialogue: 0,0:13:24.84,0:13:26.05,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:26.47,0:13:29.55,Default,,0,0,0,,Егер бір ғана нәрсе болса...
Dialogue: 0,0:13:29.89,0:13:30.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:31.76,0:13:33.27,Default,,0,0,0,,Сикорский
Dialogue: 0,0:13:34.60,0:13:36.56,Default,,0,0,0,,Қашу мүмкін емес деп саналатын түрме
Dialogue: 0,0:13:37.27,0:13:40.61,Default,,0,0,0,,Оңай қашып кеткен ең нашар өлім жазасына кесілген тұтқын
Dialogue: 0,0:13:42.32,0:13:46.49,Default,,0,0,0,,Ол өз денесін қару ретінде пайдаланып, көптеген кісі өлтірулер мен жарақаттарға ұшырады.
Dialogue: 0,0:13:46.99,0:13:48.49,Default,,0,0,0,,It's your own fault.
Dialogue: 0,0:13:49.24,0:13:50.07,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:54.33,0:13:55.16,Default,,0,0,0,,Гаха!
Dialogue: 0,0:13:56.79,0:13:58.92,Default,,0,0,0,,Сол жылы тағы бір үрей басталды
Dialogue: 0,0:14:00.00,0:14:02.84,Default,,0,0,0,,Шыу!
Dialogue: 0,0:14:03.34,0:14:04.80,Default,,0,0,0,,Давай!
Dialogue: 0,0:14:13.35,0:14:14.27,Default,,0,0,0,,Жасайық...
Dialogue: 0,0:14:14.89,0:14:15.72,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:17.56,0:14:18.64,Default,,0,0,0,,Урья! Хмм...
Dialogue: 0,0:14:20.02,0:14:21.44,Default,,0,0,0,,Төменгі еріннің астында, иә, Польнарефф?
Dialogue: 0,0:14:22.02,0:14:22.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:24.48,0:14:25.36,Default,,0,0,0,,Хаха
Dialogue: 0,0:14:26.24,0:14:27.44,Default,,0,0,0,,Уау~ Ах~
Dialogue: 0,0:14:27.70,0:14:29.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:32.03,0:14:33.03,Default,,0,0,0,,Фуга~
Dialogue: 0,0:14:33.20,0:14:35.74,Default,,0,0,0,,Соңында Сикорский
Dialogue: 0,0:14:36.37,0:14:39.67,Default,,0,0,0,,Ол жеңілгенін өзі мойындауы керек еді.
Dialogue: 0,0:14:39.96,0:14:42.63,Default,,0,0,0,,Бұл менің шығыным~
Dialogue: 0,0:14:43.50,0:14:47.63,Default,,0,0,0,,Мені кешіріңіз~
Dialogue: 0,0:14:49.05,0:14:51.43,Default,,0,0,0,,Оны шымшу деп атайды, солай ма?
Dialogue: 0,0:14:51.59,0:14:53.05,Default,,0,0,0,,Қысу күші
Dialogue: 0,0:14:53.35,0:14:57.06,Default,,0,0,0,,Қысу күші... Бұл қандай күш?
Dialogue: 0,0:14:57.43,0:14:59.69,Default,,0,0,0,,Бұл шымшу күші.
Dialogue: 0,0:15:00.10,0:15:04.11,Default,,0,0,0,,«Иван шайтанға дұға еткенде»
Dialogue: 0,0:15:04.27,0:15:06.32,Default,,0,0,0,,«Кішкентай шайтан сияқты...»
Dialogue: 0,0:15:06.73,0:15:10.45,Default,,0,0,0,,«Құрғақ жерге сіңген су сияқты».
Dialogue: 0,0:15:10.61,0:15:13.12,Default,,0,0,0,,«Жердің тереңінде...»
Dialogue: 0,0:15:16.99,0:15:20.12,Default,,0,0,0,,шымшу, шымшу, шымшу
Dialogue: 0,0:15:20.29,0:15:22.12,Default,,0,0,0,,Бұл саусақтардың күші.
Dialogue: 0,0:15:22.37,0:15:23.88,Default,,0,0,0,,Ғажайыпқа келгенде
Dialogue: 0,0:15:24.04,0:15:26.88,Default,,0,0,0,,Тиынды саусақпен бүгу деп аталады...
Dialogue: 0,0:15:27.21,0:15:28.13,Default,,0,0,0,,(тиын түскен дыбыс)
Dialogue: 0,0:15:28.26,0:15:29.63,Default,,0,0,0,,А... а...
Dialogue: 0,0:15:33.59,0:15:35.72,Default,,0,0,0,,Ах~ О, менің...
Dialogue: 0,0:15:37.10,0:15:38.39,Default,,0,0,0,,
Dialogue: 0,0:15:39.35,0:15:40.89,Default,,0,0,0,,Чикол мырза
Dialogue: 0,0:15:41.27,0:15:42.90,Default,,0,0,0,,Сіз оны қайтара аласыз ба?
Dialogue: 0,0:15:43.77,0:15:45.81,Default,,0,0,0,,Қызметкерлердің жалақысы нашар.
Dialogue: 0,0:15:46.07,0:15:48.65,Default,,0,0,0,,Бір тиынның өзі бағалы.
Dialogue: 0,0:15:51.07,0:15:51.90,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:52.45,0:15:53.70,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:55.24,0:15:56.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:02.21,0:16:03.17,Default,,0,0,0,,Хмм?
Dialogue: 0,0:16:04.33,0:16:06.13,Default,,0,0,0,,Иілуден алыс
Dialogue: 0,0:16:06.29,0:16:08.92,Default,,0,0,0,,Қағаз тәрізді оралған.
Dialogue: 0,0:16:09.51,0:16:12.17,Default,,0,0,0,,Жоқ, мен таң қалдым.
Dialogue: 0,0:16:15.26,0:16:17.26,Default,,0,0,0,,Қарап көргіңіз келе ме?
Dialogue: 0,0:16:17.89,0:16:19.01,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:22.10,0:16:22.94,Default,,0,0,0,,О!
Dialogue: 0,0:16:23.85,0:16:26.81,Default,,0,0,0,,Саусақтарыңызға никельді орап алыңыз
Dialogue: 0,0:16:27.06,0:16:31.19,Default,,0,0,0,,Егер сіз шымшу күшіңізді жетілдірсеңіз, сіз осындай әрекеттерді жасай аласыз.
Dialogue: 0,0:16:32.36,0:16:33.20,Default,,0,0,0,,Эй?
Dialogue: 0,0:16:35.07,0:16:37.24,Default,,0,0,0,,Қабырғадан ұстаңыз
Dialogue: 0,0:16:37.74,0:16:40.08,Default,,0,0,0,,Бос ұшақ
Dialogue: 0,0:16:41.29,0:16:44.37,Default,,0,0,0,,Сіз ұйықтап жатырсыз ба, әлде ояусыз ба?
Dialogue: 0,0:16:45.50,0:16:47.67,Default,,0,0,0,,Мен мұны таңертеңге дейін істеймін
Dialogue: 0,0:16:47.84,0:16:50.17,Default,,0,0,0,,А... а...
Dialogue: 0,0:16:58.47,0:16:59.60,Default,,0,0,0,,
Dialogue: 0,0:16:59.93,0:17:01.93,Default,,0,0,0,,Бұл суперинтендент Сонода.
Dialogue: 0,0:17:02.93,0:17:04.23,Default,,0,0,0,,Полиция бастығы!
Dialogue: 0,0:17:04.73,0:17:05.69,Default,,0,0,0,,Ум...
Dialogue: 0,0:17:06.27,0:17:08.94,Default,,0,0,0,,Бас суперинтендент шығып кетті.
Dialogue: 0,0:17:09.23,0:17:10.36,Default,,0,0,0,,Қай жолмен?
Dialogue: 0,0:17:11.28,0:17:12.11,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:17:12.57,0:17:13.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:15.45,0:17:17.32,Default,,0,0,0,,Бұл медициналық мекемеде
Dialogue: 0,0:17:17.49,0:17:21.37,Default,,0,0,0,,Өлім жазасына кесілгендердің бірі Спек түрмеде отыр.
Dialogue: 0,0:17:22.08,0:17:26.25,Default,,0,0,0,,5 минут бойы апноэ жаттығуларын орындау мүмкіндігі
Dialogue: 0,0:17:26.67,0:17:28.00,Default,,0,0,0,,Техникалық сипаттамалар…
Dialogue: 0,0:17:28.58,0:17:31.34,Default,,0,0,0,,Өлім жазасына кесілген ең нашар тұтқындардың бірі
Dialogue: 0,0:17:34.47,0:17:37.38,Default,,0,0,0,,Ойға келмейтін физикалық қабілеттерге ие болу
Dialogue: 0,0:17:37.55,0:17:41.18,Default,,0,0,0,,Олар көп адамның өмірін қиып, Жапонияға келді.
Dialogue: 0,0:17:41.68,0:17:44.68,Default,,0,0,0,,Хмм... Уау...
Dialogue: 0,0:18:01.03,0:18:02.08,Default,,0,0,0,,аңғал
Dialogue: 0,0:18:04.24,0:18:05.95,Default,,0,0,0,,Ооо...
Dialogue: 0,0:18:10.04,0:18:14.63,Default,,0,0,0,,Алайда, Спек Каору Ханаямамен болған қанды шайқаста жеңіліп қалды.
Dialogue: 0,0:18:15.51,0:18:17.84,Default,,0,0,0,,Сол жеңілістен кейін,
Dialogue: 0,0:18:18.84,0:18:21.64,Default,,0,0,0,,Ол тез нашарлады.
Dialogue: 0,0:18:22.72,0:18:25.10,Default,,0,0,0,,Нақты жасы 97 жаста
Dialogue: 0,0:18:26.52,0:18:29.81,Default,,0,0,0,,Spec қазір төсек тартып жатыр.
Dialogue: 0,0:18:30.81,0:18:34.82,Default,,0,0,0,,Сондықтан мен оны тергеуді кейінге қалдырдым...
Dialogue: 0,0:18:35.23,0:18:36.78,Default,,0,0,0,,Бас инспектор неліктен мұнда?
Dialogue: 0,0:18:38.61,0:18:39.49,Default,,0,0,0,,Сиқыршы культішілер.
Dialogue: 0,0:18:39.82,0:18:41.62,Default,,0,0,0,,О~ Сонода-кун
Dialogue: 0,0:18:41.78,0:18:44.91,Default,,0,0,0,,Сенің де көргім келетін нәрсе бар сияқты.
Dialogue: 0,0:18:45.12,0:18:46.45,Default,,0,0,0,,Қарап көріңіз
Dialogue: 0,0:18:47.83,0:18:50.00,Default,,0,0,0,,Спектакльдік термография
Dialogue: 0,0:18:50.62,0:18:52.79,Default,,0,0,0,,Бұлшық еттің қолданылатын бөлігі
Dialogue: 0,0:18:52.96,0:18:56.00,Default,,0,0,0,,Дене қызуымен түсте көрінеді
Dialogue: 0,0:18:57.67,0:18:58.51,Default,,0,0,0,,(тінтуірдің жұмыс дыбысы)
Dialogue: 0,0:19:00.26,0:19:05.26,Default,,0,0,0,,Менің иығымнан пайда болған температура екі алақанға бірден таралады.
Dialogue: 0,0:19:05.72,0:19:08.56,Default,,0,0,0,,Температура өзгерді ме?
Dialogue: 0,0:19:08.73,0:19:10.27,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:19:10.89,0:19:13.77,Default,,0,0,0,,Алақаннан, кеудеден, іштен...
Dialogue: 0,0:19:14.27,0:19:17.94,Default,,0,0,0,,Сосын сан мен балтыр.
Dialogue: 0,0:19:18.61,0:19:20.45,Default,,0,0,0,,Аяқтың саусақтарына жету
Dialogue: 0,0:19:22.32,0:19:25.53,Default,,0,0,0,,Бұлшықет қимылдарының сериясы шамамен 1,5 секундты алады
Dialogue: 0,0:19:25.91,0:19:28.04,Default,,0,0,0,,Өте қысқа мерзімде аяқталады
Dialogue: 0,0:19:29.20,0:19:30.04,Default,,0,0,0,,Бас инспектор
Dialogue: 0,0:19:30.91,0:19:33.13,Default,,0,0,0,,Спек мұны ояу кезінде жасайды.
Dialogue: 0,0:19:33.29,0:19:36.59,Default,,0,0,0,,Күні бойы шексіз қайталанады.
Dialogue: 0,0:19:37.67,0:19:40.59,Default,,0,0,0,,Сіз ауруханадасыз. Сіздің ерекшеліктеріңіз қандай?
Dialogue: 0,0:19:40.76,0:19:42.55,Default,,0,0,0,,Иә, төсек тартып жатырмын.
Dialogue: 0,0:19:42.93,0:19:46.81,Default,,0,0,0,,Келесі күні мен Токио Митрополитінің Спорттық физиология және дене шынықтыру ғылыми-зерттеу институтына бардым.
Dialogue: 0,0:19:46.97,0:19:48.93,Default,,0,0,0,,Мен бұл деректерді жібердім
Dialogue: 0,0:19:49.56,0:19:52.10,Default,,0,0,0,,Қызықты есеп келді.
Dialogue: 0,0:19:53.44,0:19:55.06,Default,,0,0,0,,Бұл жүзу.
Dialogue: 0,0:19:55.48,0:19:57.07,Default,,0,0,0,,Жүзу туралы не айтасыз?
Dialogue: 0,0:19:58.32,0:19:59.57,Default,,0,0,0,,Жүзу…
Dialogue: 0,0:20:00.24,0:20:04.99,Default,,0,0,0,,Иә, бұл да ең көп тұтынатын көбелек.
Dialogue: 0,0:20:05.45,0:20:08.08,Default,,0,0,0,,Төсекте көбелек?
Dialogue: 0,0:20:08.99,0:20:10.87,Default,,0,0,0,,Одан да қызық
Dialogue: 0,0:20:11.04,0:20:16.21,Default,,0,0,0,,Термография көрсеткен түстер жүзуге қарағанда көбірек нәтиже көрсетеді.
Dialogue: 0,0:20:17.04,0:20:20.26,Default,,0,0,0,,Спек суда жүзіп жүрген болуы керек.
Dialogue: 0,0:20:21.84,0:20:23.72,Default,,0,0,0,,Сіз қайда жүзіп жүрсіз?
Dialogue: 0,0:20:24.30,0:20:26.18,Default,,0,0,0,,Барған сайын...
Dialogue: 0,0:20:27.39,0:20:30.72,Default,,0,0,0,,Тұтқырлығы жоғары сироп тәрізді сұйықтық
Dialogue: 0,0:20:31.81,0:20:34.94,Default,,0,0,0,,Ол судан әлдеқайда ауыр сұйық мұхит жасады.
Dialogue: 0,0:20:35.06,0:20:36.61,Default,,0,0,0,,Өзін-өзі таңу
Dialogue: 0,0:20:36.86,0:20:38.44,Default,,0,0,0,,Нхахахаха!
Dialogue: 0,0:20:38.61,0:20:40.86,Default,,0,0,0,,Өте ауыр көбелек
Dialogue: 0,0:20:41.53,0:20:44.86,Default,,0,0,0,,Баратын жер жердің қай жерінде?
Dialogue: 0,0:20:45.66,0:20:46.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:47.24,0:20:48.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:54.67,0:20:57.75,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:20:58.59,0:20:59.50,Default,,0,0,0,,Нха
Dialogue: 0,0:21:02.71,0:21:05.34,Default,,0,0,0,,Қалай ойлайсың, Сонода-кун?
Dialogue: 0,0:21:05.55,0:21:09.01,Default,,0,0,0,,Әр адамның іс-әрекетіне қарасақ та, мағынасын түсіне алмаймыз.
Dialogue: 0,0:21:09.18,0:21:11.01,Default,,0,0,0,,Мақсаты мүлдем белгісіз
Dialogue: 0,0:21:11.60,0:21:13.60,Default,,0,0,0,,Бірақ мүмкін
Dialogue: 0,0:21:14.02,0:21:17.52,Default,,0,0,0,,Дәл Жапонияда жиналған кездегідей
Dialogue: 0,0:21:17.69,0:21:21.28,Default,,0,0,0,,Алыс жерлерде заттардың бір уақытта болатын құбылыс...
Dialogue: 0,0:21:22.32,0:21:24.03,Default,,0,0,0,,Синхрондылық
Dialogue: 0,0:21:24.36,0:21:28.03,Default,,0,0,0,,Иә, біз бұл мүмкіндікті жоққа шығара алмаймыз.
Dialogue: 0,0:21:28.78,0:21:29.95,Default,,0,0,0,,Хаа…
Dialogue: 0,0:21:30.78,0:21:34.62,Default,,0,0,0,,Қатты қырағылық пен тергеуді талап етуді жалғастырыңыз.
Dialogue: 0,0:21:34.79,0:21:36.04,Default,,0,0,0,,Бас инспектор Сонода
Dialogue: 0,0:21:36.46,0:21:38.58,Default,,0,0,0,,Ха, түсіндім!
Dialogue: 0,0:21:42.84,0:21:45.26,Default,,0,0,0,,Фуфуфуфуфуфуфу…
Dialogue: 0,0:21:47.93,0:21:50.35,Default,,0,0,0,,Хехехе…
Dialogue: 0,0:21:53.18,0:21:55.60,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:21:58.10,0:22:00.52,Default,,0,0,0,,Бұл мүлде ақау…
Dialogue: 0,0:22:03.44,0:22:05.86,Default,,0,0,0,,Бухахахаха!
Dialogue: 0,0:22:07.11,0:22:12.91,Default,,0,0,0,,(5 адам күледі)
Dialogue: 0,0:22:21.75,0:22:27.76,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:29.26,0:22:35.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory