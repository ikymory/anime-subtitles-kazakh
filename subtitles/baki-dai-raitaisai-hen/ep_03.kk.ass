Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.42,0:00:17.43,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:34.09,0:01:40.09,Default,,0,0,0,,~♪
Dialogue: 0,0:01:46.48,0:01:47.98,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:01:48.56,0:01:49.40,Default,,0,0,0,,Ой!
Dialogue: 0,0:01:50.86,0:01:53.48,Default,,0,0,0,,Мүмкін келер деп ойладым.
Dialogue: 0,0:01:54.36,0:01:55.40,Default,,0,0,0,,Тамақтану
Dialogue: 0,0:01:56.57,0:01:57.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:57.74,0:02:01.41,Default,,0,0,0,,Сіз шынымен мейірімдісіз.
Dialogue: 0,0:02:01.66,0:02:03.41,Default,,0,0,0,,Сол жігіт Юхамонды пайдаланып, қасақана ұрлықтар жасап жүрген
Dialogue: 0,0:02:04.16,0:02:05.66,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:02:13.38,0:02:14.21,Default,,0,0,0,,Құт
Dialogue: 0,0:02:14.92,0:02:16.09,Default,,0,0,0,,Хмм!
Dialogue: 0,0:02:16.63,0:02:20.05,Default,,0,0,0,,Иә! Хаха
Dialogue: 0,0:02:29.23,0:02:31.44,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:02:35.78,0:02:37.28,Default,,0,0,0,,Ах~
Dialogue: 0,0:02:38.90,0:02:41.45,Default,,0,0,0,,Мен жедім!
Dialogue: 0,0:02:43.53,0:02:45.45,Default,,0,0,0,,Бәрі реттелген сияқты.
Dialogue: 0,0:02:46.70,0:02:47.95,Default,,0,0,0,,Бұл десерт.
Dialogue: 0,0:02:49.37,0:02:51.96,Default,,0,0,0,,Мен бәрін жеймін.
Dialogue: 0,0:02:54.09,0:02:55.13,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:02:56.88,0:02:59.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:04.55,0:03:05.72,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:06.26,0:03:07.22,Default,,0,0,0,,Егер бізге шабуыл жасалса, олар да араласып қалады.
Dialogue: 0,0:03:07.35,0:03:08.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:08.68,0:03:09.93,Default,,0,0,0,,10 литр бар
Dialogue: 0,0:03:10.60,0:03:13.69,Default,,0,0,0,,Бұл дәл қазір қажет судың ең аз мөлшері.
Dialogue: 0,0:03:13.90,0:03:16.32,Default,,0,0,0,,Сіз менің 10 литр ішуімді қалайсыз!
Dialogue: 0,0:03:16.65,0:03:18.82,Default,,0,0,0,,Бұл мүмкін емес еді.
Dialogue: 0,0:03:20.32,0:03:21.74,Default,,0,0,0,,Мұны араластырыңыз
Dialogue: 0,0:03:22.57,0:03:23.53,Default,,0,0,0,,«Фруктоза»
Dialogue: 0,0:03:23.91,0:03:26.87,Default,,0,0,0,,Бұл тазартылған жемістерден жасалған таза тәттілендіргіш.
Dialogue: 0,0:03:27.58,0:03:28.79,Default,,0,0,0,,Шамамен 4 км
Dialogue: 0,0:03:30.79,0:03:34.46,Default,,0,0,0,,Мөлшері үлкен болғанымен, сіңіру жылдамдығы теңдесі жоқ.
Dialogue: 0,0:03:36.04,0:03:37.46,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:03:38.25,0:03:41.01,Default,,0,0,0,,Удың іші сыртқа шығып, сауығып кетсе де.
Dialogue: 0,0:03:41.67,0:03:45.26,Default,,0,0,0,,Сіз әлі де мінсіз емессіз.
Dialogue: 0,0:03:46.64,0:03:48.68,Default,,0,0,0,,Ей, былғаңдар
Dialogue: 0,0:03:49.52,0:03:52.73,Default,,0,0,0,,Ақуыз және крахмал бастапқыда қажет, бірақ
Dialogue: 0,0:03:54.10,0:03:55.19,Default,,0,0,0,,Мұнда екеніңе сенбеймін
Dialogue: 0,0:04:03.82,0:04:07.53,Default,,0,0,0,,14 кг... қантты су
Dialogue: 0,0:04:07.99,0:04:09.54,Default,,0,0,0,,Ғажайыптар орын алады
Dialogue: 0,0:04:17.25,0:04:22.01,Default,,0,0,0,,Баланың денесі өлімге әкелетін удың әсерінен әлсіреген.
Dialogue: 0,0:04:23.72,0:04:27.68,Default,,0,0,0,,Бұған күрестің ауыртпалығы қосылды.
Dialogue: 0,0:04:28.89,0:04:31.31,Default,,0,0,0,,Адам ағзасындағы соңғы энергия қоры
Dialogue: 0,0:04:31.43,0:04:34.64,Default,,0,0,0,,Тіпті бауырдағы гликоген таусылды.
Dialogue: 0,0:04:38.11,0:04:41.03,Default,,0,0,0,,Күреске қоса, қиянат артынан қиянат
Dialogue: 0,0:04:41.78,0:04:46.11,Default,,0,0,0,,Баланың бұлшықет жасушалары толығымен жойылған.
Dialogue: 0,0:04:47.66,0:04:51.62,Default,,0,0,0,,Олар кек алуға ант берді.
Dialogue: 0,0:04:53.08,0:04:54.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:55.16,0:04:57.58,Default,,0,0,0,,Одан әрі қиянат жасағаны үшін кек
Dialogue: 0,0:04:58.00,0:04:58.84,Default,,0,0,0,,Е...
Dialogue: 0,0:04:59.46,0:05:00.59,Default,,0,0,0,,Егер болашақта...
Dialogue: 0,0:05:02.21,0:05:05.43,Default,,0,0,0,,Дәл осындай жағдай орын алса...
Dialogue: 0,0:05:05.97,0:05:07.05,Default,,0,0,0,,Керемет
Dialogue: 0,0:05:07.18,0:05:10.10,Default,,0,0,0,,Оны міндетті түрде өз бетіңізше жеңіңіз
Dialogue: 0,0:05:10.43,0:05:11.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:12.89,0:05:16.14,Default,,0,0,0,,Адам емес, Құдай жаратқан дене.
Dialogue: 0,0:05:17.56,0:05:20.94,Default,,0,0,0,,Кек алуда қателік болмайды, Құдайға ант.
Dialogue: 0,0:05:23.44,0:05:25.11,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:05:25.78,0:05:28.16,Default,,0,0,0,,Енді баланың денесінде
Dialogue: 0,0:05:28.28,0:05:31.70,Default,,0,0,0,,Бұрын-соңды болмаған супер-қалпына келтіру орын алмақ болды.
Dialogue: 0,0:05:34.25,0:05:35.29,Default,,0,0,0,,Хо
Dialogue: 0,0:05:35.96,0:05:38.62,Default,,0,0,0,,Сіз әлсізсіз.
Dialogue: 0,0:05:39.54,0:05:43.63,Default,,0,0,0,,Аштық, шөлдеу, сағыныш...
Dialogue: 0,0:05:44.51,0:05:47.63,Default,,0,0,0,,Жетіспейтін нәрселерге толы
Dialogue: 0,0:05:50.30,0:05:53.01,Default,,0,0,0,,Бақыланбайтын Жоқ...
Dialogue: 0,0:05:53.14,0:05:55.14,Default,,0,0,0,,Тіпті оны басуға тырыспаңыз
Dialogue: 0,0:05:55.52,0:05:57.10,Default,,0,0,0,,Көтерілген жеріміз – құлайтын жеріміз.
Dialogue: 0,0:05:59.48,0:06:03.15,Default,,0,0,0,,Секіруге деген құлшынысты басқаруға күші жетпеуі
Dialogue: 0,0:06:04.65,0:06:06.65,Default,,0,0,0,,Бақылау жоқ
Dialogue: 0,0:06:07.82,0:06:10.41,Default,,0,0,0,,Адамның күші қандай?
Dialogue: 0,0:06:11.12,0:06:12.62,Default,,0,0,0,,Күрес және жекпе-жек өнерінің тарихы
Dialogue: 0,0:06:12.74,0:06:18.62,Default,,0,0,0,,Басқаша айтқанда, импульс пен инстинкт арасындағы қақтығыстың тарихы әлі де қайнап жатыр.
Dialogue: 0,0:06:18.75,0:06:20.58,Default,,0,0,0,,ауыстырылды
Dialogue: 0,0:06:22.34,0:06:24.67,Default,,0,0,0,,Маған көрсетейін
Dialogue: 0,0:06:25.25,0:06:28.72,Default,,0,0,0,,Адам болудың шынайы күші
Dialogue: 0,0:06:30.26,0:06:32.93,Default,,0,0,0,,Бұл көздің жауын алатын көрініс
Dialogue: 0,0:06:33.05,0:06:37.48,Default,,0,0,0,,Ұлттық қол... Ел намысын қорғаған шебер Го Хайхуан,
Dialogue: 0,0:06:37.60,0:06:40.35,Default,,0,0,0,,Дәл алдымызда тұр!
Dialogue: 0,0:06:41.35,0:06:43.94,Default,,0,0,0,,Қатысудың өзі қазірдің өзінде ғажайып
Dialogue: 0,0:06:44.61,0:06:46.94,Default,,0,0,0,,Менің әлі тұрғаным ғажап
Dialogue: 0,0:06:47.53,0:06:49.45,Default,,0,0,0,,Күресу мүмкін емес!
Dialogue: 0,0:06:52.91,0:06:54.45,Default,,0,0,0,,Бастау! (барабан дыбысы)
Dialogue: 0,0:06:54.78,0:06:57.45,Default,,0,0,0,,
Dialogue: 0,0:06:58.00,0:07:01.79,Default,,0,0,0,,Бұл басталды! Кайу мен Кайу
Dialogue: 0,0:07:02.38,0:07:04.46,Default,,0,0,0,,Бастапқыда бұл ойын
Dialogue: 0,0:07:04.96,0:07:09.42,Default,,0,0,0,,Оны жоғары дәрежелі деп саналатын Го Хайхуанға тиесілі деп қарау орынды болар еді.
Dialogue: 0,0:07:09.59,0:07:11.01,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:07:11.13,0:07:13.97,Default,,0,0,0,,Жас айырмашылығы: 100 және 21 жас!
Dialogue: 0,0:07:15.43,0:07:19.98,Default,,0,0,0,,Самван Кайо, 25 жаста, жетілген жаста.
Dialogue: 0,0:07:21.35,0:07:23.40,Default,,0,0,0,,Біреудің мұғалімі Су Лю Шэн
Dialogue: 0,0:07:23.52,0:07:27.32,Default,,0,0,0,,18 жыл бұрын Тайландқа көшіп келгеніңізді естідім.
Dialogue: 0,0:07:28.28,0:07:31.61,Default,,0,0,0,,Муай-таймен жүлделі матчтар арқылы күн сайын ақша табу
Dialogue: 0,0:07:35.24,0:07:39.12,Default,,0,0,0,,Мен біреудің кобрамен ойнап жатқанын көрдім.
Dialogue: 0,0:07:39.95,0:07:41.66,Default,,0,0,0,,Қытай Кемпо және Муай Тай…
Dialogue: 0,0:07:41.79,0:07:44.71,Default,,0,0,0,,Бұл тарихи кездесу сәті болды.
Dialogue: 0,0:07:46.17,0:07:48.71,Default,,0,0,0,,Содан бері 10 жылдан астам жеке жұмыс
Dialogue: 0,0:07:50.17,0:07:52.13,Default,,0,0,0,,Екеуі Гонконгқа кетті.
Dialogue: 0,0:07:54.68,0:07:56.76,Default,,0,0,0,,Тегістеу үстелдерінің барлық түрлері
Dialogue: 0,0:07:56.93,0:07:59.64,Default,,0,0,0,,Өткен жылы Қытайдың Ушу Министрлігі
Dialogue: 0,0:07:59.77,0:08:04.60,Default,,0,0,0,,Теңіз патшасы атағы Тайланд азаматы Самванға берілді.
Dialogue: 0,0:08:07.06,0:08:08.36,Default,,0,0,0,,Ой!
Dialogue: 0,0:08:08.48,0:08:10.23,Default,,0,0,0,,Білмей тұрып, уақыт таяп қалды!
Dialogue: 0,0:08:10.86,0:08:13.74,Default,,0,0,0,,Го Хайхуан әлі көзілдірік киіп жүр.
Dialogue: 0,0:08:15.45,0:08:16.74,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:08:19.58,0:08:22.62,Default,,0,0,0,,Qi Тыныс алу күші
Dialogue: 0,0:08:23.87,0:08:25.63,Default,,0,0,0,,Мұның бәрі өтірік!
Dialogue: 0,0:08:26.92,0:08:30.76,Default,,0,0,0,,Бұл жекпе-жек өнері болса да, сайып келгенде, бұл спорттық қабілеттердің жарысы.
Dialogue: 0,0:08:31.84,0:08:35.26,Default,,0,0,0,,Денені ұтымды пайдалану әлемі
Dialogue: 0,0:08:35.97,0:08:38.76,Default,,0,0,0,,Онда ешқандай сиқыр жоқ
Dialogue: 0,0:08:39.47,0:08:43.64,Default,,0,0,0,,Жылдамырақ Жылдамырақ!
Dialogue: 0,0:08:44.39,0:08:47.65,Default,,0,0,0,,Және тезірек!
Dialogue: 0,0:08:48.40,0:08:49.77,Default,,0,0,0,,Ой, оны құлатып тастады
Dialogue: 0,0:08:52.65,0:08:54.20,Default,,0,0,0,,А? Уф
Dialogue: 0,0:08:56.53,0:08:57.37,Default,,0,0,0,,Ах
Dialogue: 0,0:09:00.54,0:09:01.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:02.25,0:09:03.96,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:09:08.46,0:09:09.29,Default,,0,0,0,,Pin!
Dialogue: 0,0:09:09.42,0:09:10.29,Default,,0,0,0,,Ахх...
Dialogue: 0,0:09:10.42,0:09:12.38,Default,,0,0,0,,
Dialogue: 0,0:09:15.13,0:09:15.97,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:16.09,0:09:20.26,Default,,0,0,0,,Кеке Кеке... Орнықты!
Dialogue: 0,0:09:26.02,0:09:27.44,Default,,0,0,0,,Е, кірпіш?
Dialogue: 0,0:09:28.10,0:09:30.65,Default,,0,0,0,,Осындай нәрсені бұзуға бола ма?
Dialogue: 0,0:09:33.86,0:09:35.44,Default,,0,0,0,,Бұл деко түйреуіш!
Dialogue: 0,0:09:35.57,0:09:36.40,Default,,0,0,0,,Уау
Dialogue: 0,0:09:37.15,0:09:37.99,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:38.66,0:09:39.70,Default,,0,0,0,,Күрсін
Dialogue: 0,0:09:40.20,0:09:41.87,Default,,0,0,0,,Эй?
Dialogue: 0,0:09:43.20,0:09:45.41,Default,,0,0,0,,Күш қолданудың қажеті жоқ
Dialogue: 0,0:09:46.41,0:09:47.46,Default,,0,0,0,,Эй
Dialogue: 0,0:09:51.09,0:09:53.63,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:09:54.46,0:09:57.76,Default,,0,0,0,,Сізге күш қажет емес...?
Dialogue: 0,0:09:57.88,0:09:58.72,Default,,0,0,0,,Иә
Dialogue: 0,0:09:59.39,0:10:04.47,Default,,0,0,0,,Әйелдер, балалар, қарттар сияқты дене күші бата алмаған адамдар.
Dialogue: 0,0:10:04.60,0:10:08.35,Default,,0,0,0,,Бұл техниканы қажет ететіндер.
Dialogue: 0,0:10:11.11,0:10:13.90,Default,,0,0,0,,Әлсіздер қолдана алмайтын жекпе-жек түрлері
Dialogue: 0,0:10:14.03,0:10:17.24,Default,,0,0,0,,Мұның мәні неде?
Dialogue: 0,0:10:18.82,0:10:22.28,Default,,0,0,0,,Қажет кезде қажетті техника
Dialogue: 0,0:10:22.41,0:10:25.08,Default,,0,0,0,,Қажетті жылдамдықпен жеткізу
Dialogue: 0,0:10:26.00,0:10:31.25,Default,,0,0,0,,Өз эмоцияларыңызды бақылаңыз және уақытты біліңіз
Dialogue: 0,0:10:32.38,0:10:36.51,Default,,0,0,0,,Егер сіздің қолыңызда тамаша уақыт болса
Dialogue: 0,0:10:36.84,0:10:40.80,Default,,0,0,0,,Біркелкі жылдамдық енді қажет емес.
Dialogue: 0,0:10:41.68,0:10:42.51,Default,,0,0,0,,Құт
Dialogue: 0,0:10:43.14,0:10:46.06,Default,,0,0,0,,Анау қарт... қарғыс атсын...
Dialogue: 0,0:10:46.89,0:10:48.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:48.52,0:10:51.31,Default,,0,0,0,,Мен мұндай нәрсе болады деп күткен емеспін!
Dialogue: 0,0:10:54.32,0:10:56.28,Default,,0,0,0,,Ng…
Dialogue: 0,0:10:57.19,0:10:58.28,Default,,0,0,0,,Каа!
Dialogue: 0,0:11:03.45,0:11:05.28,Default,,0,0,0,,Ертеңнен бастап
Dialogue: 0,0:11:05.45,0:11:06.29,Default,,0,0,0,,Хмм!
Dialogue: 0,0:11:06.66,0:11:10.29,Default,,0,0,0,,Гонконгта қаншалықты төмен жүруім керек?
Бұл
Dialogue: 0,0:11:11.12,0:11:12.54,Default,,0,0,0,,ма?
Dialogue: 0,0:11:13.13,0:11:14.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:16.21,0:11:17.30,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:11:18.59,0:11:22.30,Default,,0,0,0,,Бірақ жақсы...
Dialogue: 0,0:11:23.68,0:11:28.72,Default,,0,0,0,,Егер сіз жапон болсаңыз, онда Харакириді орнында жасайтын едіңіз, солай ма?
Dialogue: 0,0:11:29.14,0:11:31.94,Default,,0,0,0,,Хм... Эй!
Dialogue: 0,0:11:32.44,0:11:33.31,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:11:34.02,0:11:38.44,Default,,0,0,0,,Бірдей жеңілсең де, жеңілген жолың басқа...
Dialogue: 0,0:11:39.74,0:11:42.61,Default,,0,0,0,,Сіз аман қаласыз ба? Ертеңнен бастап
Dialogue: 0,0:11:43.24,0:11:44.07,Default,,0,0,0,,Хе хехе...
Dialogue: 0,0:11:44.70,0:11:46.58,Default,,0,0,0,,Мен өте, өте...
Dialogue: 0,0:11:46.70,0:11:47.54,Default,,0,0,0,,Урья~!
Dialogue: 0,0:11:50.58,0:11:51.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:52.33,0:11:53.17,Default,,0,0,0,,Ах
Dialogue: 0,0:11:56.54,0:11:58.25,Default,,0,0,0,,Жетілмеген болса да
Dialogue: 0,0:12:00.59,0:12:02.59,Default,,0,0,0,,Біреу, Біреу! (Су) Біреу!
Dialogue: 0,0:12:02.72,0:12:06.43,Default,,0,0,0,,Бірақ сіз қателеспейсіз.
Dialogue: 0,0:12:12.31,0:12:14.44,Default,,0,0,0,,Әй, бірдеңе...
Dialogue: 0,0:12:14.90,0:12:16.94,Default,,0,0,0,,Ылғалды емес пе? Мұнда
Dialogue: 0,0:12:17.06,0:12:18.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:20.40,0:12:21.24,Default,,0,0,0,,О
Dialogue: 0,0:12:25.24,0:12:26.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:29.66,0:12:30.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:36.08,0:12:37.42,Default,,0,0,0,,Рецу Роши…
Dialogue: 0,0:12:42.26,0:12:44.72,Default,,0,0,0,,Мастер Рецу Бұл... (Ретсу) Тыныш!
Dialogue: 0,0:12:46.09,0:12:46.97,Default,,0,0,0,,Ояну
Dialogue: 0,0:12:48.80,0:12:50.60,Default,,0,0,0,,Мен... Акула?
Dialogue: 0,0:12:53.43,0:12:56.06,Default,,0,0,0,,14 кг-ға дейінгі қантты су
Dialogue: 0,0:12:57.44,0:13:02.44,Default,,0,0,0,,Қант суы ғана өліп бара жатқан адам ағзасын қалпына келтіреді
Dialogue: 0,0:13:03.36,0:13:06.11,Default,,0,0,0,,Әсіресе осы уланған кезеңде.
Dialogue: 0,0:13:06.74,0:13:09.41,Default,,0,0,0,,Мен өз денемді сонша қорлық көрдім.
Dialogue: 0,0:13:10.70,0:13:12.58,Default,,0,0,0,,Бәлкім, Бақидың денесі бұрынғыдан жақсырақ шығар...
Dialogue: 0,0:13:12.70,0:13:13.75,Default,,0,0,0,,Рецу-сан!
Dialogue: 0,0:13:14.21,0:13:15.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:19.38,0:13:20.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:28.89,0:13:30.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:32.56,0:13:33.39,Default,,0,0,0,,Иә
Dialogue: 0,0:13:34.68,0:13:35.60,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:13:40.98,0:13:41.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:43.98,0:13:45.69,Default,,0,0,0,,Ағай! (Козуэ) А...
Dialogue: 0,0:13:46.74,0:13:47.86,Default,,0,0,0,,Баки!
Dialogue: 0,0:13:48.32,0:13:49.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:10.76,0:14:11.85,Default,,0,0,0,,Рецу-сан
Dialogue: 0,0:14:12.76,0:14:14.89,Default,,0,0,0,,Жаңғыру!
Dialogue: 0,0:14:15.22,0:14:17.39,Default,,0,0,0,,Баки Ханма оралды! Хаха
Dialogue: 0,0:14:17.64,0:14:19.65,Default,,0,0,0,,Баки Ханма оралды! (Козуэ) Ой
Dialogue: 0,0:14:20.27,0:14:21.90,Default,,0,0,0,,Баки Ханма оралды!
Dialogue: 0,0:14:22.15,0:14:24.11,Default,,0,0,0,,Баки Ханма оралды! (2 адам) А...
Dialogue: 0,0:14:24.36,0:14:26.40,Default,,0,0,0,,Баки Ханма оралды!
Dialogue: 0,0:14:26.69,0:14:29.82,Default,,0,0,0,,Баки Ханма оралды! Жасаңыз...
Dialogue: 0,0:14:29.95,0:14:32.12,Default,,0,0,0,,Сәйкес келейік~
Dialogue: 0,0:14:32.28,0:14:34.58,Default,,0,0,0,,
Dialogue: 0,0:14:40.21,0:14:42.92,Default,,0,0,0,,Ммм...
Dialogue: 0,0:14:43.42,0:14:46.09,Default,,0,0,0,,Дориан теңізінің королі пайда болды!
Dialogue: 0,0:14:46.21,0:14:47.42,Default,,0,0,0,,
Dialogue: 0,0:14:47.88,0:14:50.13,Default,,0,0,0,,Сол дуриан...
Dialogue: 0,0:14:50.26,0:14:51.51,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:51.84,0:14:54.10,Default,,0,0,0,,Бұл қалыпты емес...
Dialogue: 0,0:14:54.22,0:14:55.31,Default,,0,0,0,,(Рюи) Неге сен өртеніп жатқан жоқсың?
Dialogue: 0,0:14:55.60,0:14:59.44,Default,,0,0,0,,Қарапайым, стадионда кәмпит жеме
Dialogue: 0,0:15:03.77,0:15:06.78,Default,,0,0,0,,Патша Ян Кай пайда болды!
Dialogue: 0,0:15:11.36,0:15:13.95,Default,,0,0,0,,Енді жеңейік!
Dialogue: 0,0:15:20.33,0:15:21.46,Default,,0,0,0,,(Танжиро) Бұған дейін кірген жебелер мені бұрын-соңды болмағандай күшпен тартып жатыр.
Dialogue: 0,0:15:22.25,0:15:23.08,Default,,0,0,0,,Бастау! (барабан дыбысы)
Dialogue: 0,0:15:23.21,0:15:24.04,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:29.59,0:15:30.80,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:31.38,0:15:33.39,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,0:15:33.93,0:15:34.80,Default,,0,0,0,,Ах! мм...
Dialogue: 0,0:15:44.52,0:15:46.52,Default,,0,0,0,,Мүмкін... Ди...
Dialogue: 0,0:15:47.73,0:15:49.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:49.82,0:15:51.70,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:15:54.66,0:15:56.24,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:57.03,0:15:58.29,Default,,0,0,0,,Гуааа…
Dialogue: 0,0:16:05.96,0:16:07.71,Default,,0,0,0,,(Танжиро) Бұған дейін кірген жебелер мені бұрын-соңды болмағандай күшпен тартып жатыр.
Dialogue: 0,0:16:08.21,0:16:09.05,Default,,0,0,0,,Ах
Dialogue: 0,0:16:11.51,0:16:12.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:16.01,0:16:17.14,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,0:16:24.69,0:16:25.52,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:26.15,0:16:27.40,Default,,0,0,0,,
Dialogue: 0,0:16:31.24,0:16:32.24,Default,,0,0,0,,Ойын бар!
Dialogue: 0,0:16:32.36,0:16:34.91,Default,,0,0,0,,
Dialogue: 0,0:16:35.28,0:16:36.74,Default,,0,0,0,,Иә? (Көрермендер) Қазірдің өзінде?
Dialogue: 0,0:16:36.87,0:16:38.08,Default,,0,0,0,,Есеп айырысу?
Dialogue: 0,0:16:38.62,0:16:40.91,Default,,0,0,0,,Қорқыныштысы – Ұлы Гатордай!
Dialogue: 0,0:16:41.50,0:16:43.00,Default,,0,0,0,,Біржақты!
Dialogue: 0,0:16:43.37,0:16:46.92,Default,,0,0,0,,Бір жақты, тіпті бір қарсы шабуылға да жол бермей!
Dialogue: 0,0:16:47.58,0:16:50.88,Default,,0,0,0,,Біржақты болғаны сонша, олардың екі теңіз патшасы екеніне сену қиын!
Dialogue: 0,0:16:51.17,0:16:54.30,Default,,0,0,0,,Бұл бір жақты даму болды!
Dialogue: 0,0:16:56.34,0:17:00.10,Default,,0,0,0,,Бастапқыда, бұл Дориан теңізінің патшасы
Dialogue: 0,0:17:00.22,0:17:04.02,Default,,0,0,0,,Мен бұл платформаға көтерілу үшін жағдайым жақсы деп ойламаймын.
Dialogue: 0,0:17:04.73,0:17:07.44,Default,,0,0,0,,Бірақ бұл тамаша платформа!
Dialogue: 0,0:17:10.07,0:17:12.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:13.44,0:17:15.45,Default,,0,0,0,,Бұл жекпе-жек өнері!
Dialogue: 0,0:17:15.90,0:17:17.45,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:17.57,0:17:18.41,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:17:18.53,0:17:22.87,Default,,0,0,0,,Ой~ Мен тұрдым!
Dialogue: 0,0:17:24.08,0:17:26.21,Default,,0,0,0,,Осыншама шығын алып жатқанда
Dialogue: 0,0:17:26.58,0:17:29.46,Default,,0,0,0,,Мен өз аяғыммен кетемін!
Dialogue: 0,0:17:29.59,0:17:30.59,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:17:30.71,0:17:33.09,Default,,0,0,0,,Бұл да осы.
Dialogue: 0,0:17:33.21,0:17:36.01,Default,,0,0,0,,Әдемі жекпе-жек шеберінің бейнесі деуге болады.
Dialogue: 0,0:17:36.13,0:17:39.47,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:17:44.64,0:17:45.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:50.06,0:17:51.48,Default,,0,0,0,,Мен оны қабылдай алмаймын!
Dialogue: 0,0:17:52.44,0:17:53.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:54.11,0:17:55.07,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:17:55.86,0:17:58.99,Default,,0,0,0,,Бұл ақ адамның өзін Теңіз патшасы деп атауға құқығы жоқ!
Dialogue: 0,0:17:59.87,0:18:04.50,Default,,0,0,0,,Сонымен... не істеуді жоспарлап отырсың, Ян?
Dialogue: 0,0:18:05.33,0:18:06.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:07.25,0:18:09.25,Default,,0,0,0,,Тағы кездесейік!
Dialogue: 0,0:18:09.50,0:18:13.25,Default,,0,0,0,,Ей, Ян, бұлай дөрекі болма.
Dialogue: 0,0:18:13.63,0:18:14.51,Default,,0,0,0,,Рұқсат етілмейді!
Dialogue: 0,0:18:14.92,0:18:16.26,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:18:16.88,0:18:19.26,Default,,0,0,0,,Бұл менің қабілетім екенін ешқашан мойындамаймын!
Dialogue: 0,0:18:19.97,0:18:21.26,Default,,0,0,0,,Фуфу~н
Dialogue: 0,0:18:21.55,0:18:24.89,Default,,0,0,0,,Мен басқа адам болсам жақсы емес пе? Ян мырза
Dialogue: 0,0:18:26.27,0:18:27.27,Default,,0,0,0,,Сіз?
Dialogue: 0,0:18:27.77,0:18:32.23,Default,,0,0,0,,Сіз ойлағандай, Дориан ауырып жатыр.
Dialogue: 0,0:18:32.73,0:18:33.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:39.28,0:18:41.78,Default,,0,0,0,,Хмф, сен ақымақ күшіңмен мақтанасың ба?
Dialogue: 0,0:18:41.99,0:18:45.29,Default,,0,0,0,,Дұрыс, мен өзімнің ақымақ күшіммен ғана мақтанамын~
Dialogue: 0,0:18:45.66,0:18:46.50,Default,,0,0,0,,Әй
Dialogue: 0,0:18:50.42,0:18:51.25,Default,,0,0,0,,А, аа!
Dialogue: 0,0:18:53.34,0:18:55.80,Default,,0,0,0,,Жұдырығым... Аша алмаймын!
Dialogue: 0,0:18:56.51,0:18:57.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:58.13,0:18:58.97,Default,,0,0,0,,О...
Dialogue: 0,0:18:59.42,0:19:00.93,Default,,0,0,0,,Хмм, тәа!
Dialogue: 0,0:19:04.39,0:19:07.89,Default,,0,0,0,,Өтінемін? Көзілдірікке жарайды ма деп ойлаймын
Dialogue: 0,0:19:09.52,0:19:11.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:12.86,0:19:15.07,Default,,0,0,0,,Тез арада мұнараға оралыңыз!
Dialogue: 0,0:19:15.69,0:19:19.82,Default,,0,0,0,,Мырза, мырза, мен данамын.
Dialogue: 0,0:19:19.95,0:19:22.61,Default,,0,0,0,,Си Си Кинг Ян Кай
Dialogue: 0,0:19:23.20,0:19:25.24,Default,,0,0,0,,(петардалардың дыбысы)
Dialogue: 0,0:19:26.37,0:19:28.08,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:39.01,0:19:40.47,Default,,0,0,0,,(айдаһар дыбысы)
Dialogue: 0,0:19:40.80,0:19:44.51,Default,,0,0,0,,Қазір Қытайдың Ушу Министрлігінің демеушісі
Dialogue: 0,0:19:44.64,0:19:47.18,Default,,0,0,0,,Барлығына хабарландыру жасалды.
Dialogue: 0,0:19:47.93,0:19:48.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:48.89,0:19:51.60,Default,,0,0,0,,Бұрын жеңілген Дорианның қызметшісі
Dialogue: 0,0:19:52.06,0:19:55.61,Default,,0,0,0,,Бисквит Олива мырза матч нәтижесіне шағымданады
Dialogue: 0,0:19:55.81,0:19:58.90,Default,,0,0,0,,Мен Ян Кайванмен кездесуді асыға күтемін.
Dialogue: 0,0:19:59.03,0:20:00.61,Default,,0,0,0,,
Dialogue: 0,0:20:01.28,0:20:04.62,Default,,0,0,0,,Ян бұл өтінішті оңай қабылдады.
Dialogue: 0,0:20:05.03,0:20:06.62,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:06.83,0:20:09.66,Default,,0,0,0,,Мұнда Важра Фист Ян Кайоу қарсы.
Dialogue: 0,0:20:09.79,0:20:12.29,Default,,0,0,0,,Күшті печенье Олива
Dialogue: 0,0:20:12.41,0:20:16.13,Default,,0,0,0,,Арнайы сәйкестік оны жүзеге асырды.
Dialogue: 0,0:20:16.34,0:20:19.13,Default,,0,0,0,,Көңілді болыңыз! Бұл тамаша, қызметші!
Dialogue: 0,0:20:19.71,0:20:21.63,Default,,0,0,0,,Олива мырза... солай ма?
Dialogue: 0,0:20:22.67,0:20:24.72,Default,,0,0,0,,Сіз бірінші мені ұра аласыз ба?
Dialogue: 0,0:20:25.47,0:20:26.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:26.80,0:20:30.39,Default,,0,0,0,,Ол өзін «әлемдегі ең мықты күш» деп атағанымен
Dialogue: 0,0:20:31.14,0:20:32.64,Default,,0,0,0,,Шынымды айтайын.
Dialogue: 0,0:20:33.73,0:20:37.65,Default,,0,0,0,,Сіз бен біздің арамызда әскери күште тым көп айырмашылық бар.
Dialogue: 0,0:20:39.27,0:20:40.15,Default,,0,0,0,,(Фушигуро) Ол іссапарда. (Итадори) Ә?
Dialogue: 0,0:20:43.78,0:20:49.41,Default,,0,0,0,,Менің Важра жұдырығымның нақты күйі - бес денені гауһар тасқа айналдыру.
Dialogue: 0,0:20:51.62,0:20:53.79,Default,,0,0,0,,Уке жаттығуы ағаш қылыштан басталады
Dialogue: 0,0:20:54.83,0:20:57.29,Default,,0,0,0,,Ақыры шынжырмен ұруға өзгерді.
Dialogue: 0,0:20:58.25,0:21:01.30,Default,,0,0,0,,Ірі көлікпен құрсақ қуысынан өткеннен кейін
Dialogue: 0,0:21:02.26,0:21:07.80,Default,,0,0,0,,Соңында біз ескі зеңбіректің жарылған снарядтарын сеземіз.
Dialogue: 0,0:21:09.68,0:21:11.97,Default,,0,0,0,,Ал қорытынды дайындық
Dialogue: 0,0:21:12.52,0:21:17.81,Default,,0,0,0,,Түн ортасында тайфун соққанда, 30 метр құлаған сарқырамада өткізіледі.
Dialogue: 0,0:21:18.40,0:21:22.57,Default,,0,0,0,,Таң атқанша сарқырамаға шомылумен аяқтаңыз!
Dialogue: 0,0:21:23.82,0:21:25.20,Default,,0,0,0,,Ешқандай ескертулер жоқ
Dialogue: 0,0:21:25.61,0:21:28.45,Default,,0,0,0,,Көңіліңізден шыққанша соққы беріңіз!
Dialogue: 0,0:21:28.82,0:21:30.20,Default,,0,0,0,,Хмм, әйтеуір...
Dialogue: 0,0:21:32.41,0:21:36.62,Default,,0,0,0,,Сіз менің көңілімді мүлдем басқарып жібердіңіз.
Dialogue: 0,0:21:37.92,0:21:44.13,Default,,0,0,0,,Менің соққым жұмыс істей алмайды.
Dialogue: 0,0:21:45.34,0:21:50.35,Default,,0,0,0,,Бұл тамаша мүмкіндік. Мен бұл үшін сіздің сөзіңізді аламын.
Dialogue: 0,0:21:54.10,0:21:54.93,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:56.64,0:21:59.27,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:21:59.48,0:22:01.23,Default,,0,0,0,,А... хмм?
Dialogue: 0,0:22:03.44,0:22:04.69,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:22:06.78,0:22:10.12,Default,,0,0,0,,Хахахахаха!
Dialogue: 0,0:22:10.74,0:22:13.62,Default,,0,0,0,,күлгенімді тыя алмаймын хехехехе...
Dialogue: 0,0:22:14.87,0:22:18.21,Default,,0,0,0,,Алмаз иілген
Dialogue: 0,0:22:21.79,0:22:27.80,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:29.30,0:22:35.30,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory