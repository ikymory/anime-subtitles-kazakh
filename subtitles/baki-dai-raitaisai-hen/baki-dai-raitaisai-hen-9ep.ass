Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.42,0:00:17.43,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:34.01,0:01:40.01,Default,,0,0,0,,~♪
Dialogue: 0,0:01:41.60,0:01:42.47,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:01:42.60,0:01:45.31,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:01:55.90,0:01:56.90,Default,,0,0,0,,Иә...
Dialogue: 0,0:02:02.70,0:02:03.54,Default,,0,0,0,,Ах
Dialogue: 0,0:02:08.16,0:02:09.54,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:02:10.54,0:02:11.67,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:02:15.67,0:02:16.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:17.55,0:02:19.22,Default,,0,0,0,,Жігітіңізбен...
Dialogue: 0,0:02:20.68,0:02:21.80,Default,,0,0,0,,Ұрыс
Dialogue: 0,0:02:22.89,0:02:24.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:38.44,0:02:42.95,Default,,0,0,0,,Неге... оны маған бердіңіз бе?
Dialogue: 0,0:02:44.33,0:02:45.33,Default,,0,0,0,,Бірі
Dialogue: 0,0:02:46.04,0:02:47.83,Default,,0,0,0,,Баки-сан сізге арналған...
Dialogue: 0,0:02:47.91,0:02:50.33,Default,,0,0,0,,Өйткені ол алмастырылмайтын және маңызды адам
Dialogue: 0,0:02:51.33,0:02:53.08,Default,,0,0,0,,Тағы бір нәрсе...
Dialogue: 0,0:02:53.96,0:02:58.09,Default,,0,0,0,,Өйткені сен мен үшін маңыздысың
Dialogue: 0,0:02:58.63,0:02:59.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:04.47,0:03:06.97,Default,,0,0,0,,Мм... Мен оны ішпей тастап кеттім.
Dialogue: 0,0:03:07.10,0:03:08.10,Default,,0,0,0,,Козуэ ханым
Dialogue: 0,0:03:08.22,0:03:09.06,Default,,0,0,0,,Ах
Dialogue: 0,0:03:09.73,0:03:12.69,Default,,0,0,0,,Мен сенің маған тұрмысқа шыққаныңды қалаймын
Dialogue: 0,0:03:13.81,0:03:15.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:16.32,0:03:18.99,Default,,0,0,0,,Мм, мм... менімен бе?
Dialogue: 0,0:03:19.11,0:03:20.19,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:20.49,0:03:25.37,Default,,0,0,0,,Өйткені сен мен білетін ең әдемі әйелсің
Dialogue: 0,0:03:25.62,0:03:27.37,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ
Dialogue: 0,0:03:27.49,0:03:29.12,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:03:29.25,0:03:31.37,Default,,0,0,0,,Ең жақсы емес
Dialogue: 0,0:03:31.87,0:03:37.13,Default,,0,0,0,,Сіз ең жақсысыз ба, жоқ па, бұл сізге байланысты емес.
Dialogue: 0,0:03:38.50,0:03:39.76,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:03:40.09,0:03:41.13,Default,,0,0,0,,О
Dialogue: 0,0:03:44.47,0:03:47.64,Default,,0,0,0,,Өтінемін, менімен бірге тұрыңыз
Dialogue: 0,0:03:52.89,0:03:53.90,Default,,0,0,0,,Хаа
Dialogue: 0,0:04:00.03,0:04:01.15,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:02.53,0:04:03.82,Default,,0,0,0,,Мен қиындыққа тап болдым
Dialogue: 0,0:04:04.78,0:04:06.66,Default,,0,0,0,,Өйткені ол осында...
Dialogue: 0,0:04:07.66,0:04:10.79,Default,,0,0,0,,Бұл Құдайдың шешімі емес
Dialogue: 0,0:04:11.41,0:04:12.41,Default,,0,0,0,,Ах
Dialogue: 0,0:04:12.79,0:04:14.67,Default,,0,0,0,,Сіздің негізгі жұмысыңыз қандай?
Dialogue: 0,0:04:17.04,0:04:18.17,Default,,0,0,0,,Студент пе?
Dialogue: 0,0:04:18.42,0:04:20.67,Default,,0,0,0,,Жоқ! Студент емес
Dialogue: 0,0:04:21.05,0:04:23.68,Default,,0,0,0,,Сіздің жұмысыңыз – әйел болу.
Dialogue: 0,0:04:24.13,0:04:26.93,Default,,0,0,0,,Ал оның мақсаты
Dialogue: 0,0:04:27.68,0:04:30.43,Default,,0,0,0,,Бірінші нөмірлі адаммен кездесу
Dialogue: 0,0:04:30.56,0:04:31.39,Default,,0,0,0,,Ах
Dialogue: 0,0:04:31.89,0:04:35.19,Default,,0,0,0,,Мен бірінші нөмірлі әйелді кездестірдім
Dialogue: 0,0:04:36.27,0:04:38.02,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:04:39.57,0:04:42.94,Default,,0,0,0,,Сіз біріншісіз бе?
Dialogue: 0,0:04:43.32,0:04:46.70,Default,,0,0,0,,Шешім менің қолымда емес
Dialogue: 0,0:04:47.45,0:04:49.45,Default,,0,0,0,,Дәлелдеңіз
Dialogue: 0,0:04:50.08,0:04:51.70,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:52.08,0:04:53.41,Default,,0,0,0,,Сізге...
Dialogue: 0,0:04:54.96,0:04:55.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:56.08,0:04:56.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:57.63,0:04:58.46,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:04:59.84,0:05:02.21,Default,,0,0,0,,Мені ұрмаңыз
Dialogue: 0,0:05:02.96,0:05:04.34,Default,,0,0,0,,Қайта кездескенше
Dialogue: 0,0:05:04.47,0:05:05.76,Default,,0,0,0,,Ах
Dialogue: 0,0:05:15.18,0:05:17.06,Default,,0,0,0,,Хаа…
Dialogue: 0,0:05:22.57,0:05:23.74,Default,,0,0,0,,Баки Хамма
Dialogue: 0,0:05:24.36,0:05:27.03,Default,,0,0,0,,Мен сізді құрметтеймін деп естідім.
Dialogue: 0,0:05:28.36,0:05:30.49,Default,,0,0,0,,Менімен шайқас
Dialogue: 0,0:05:31.58,0:05:34.00,Default,,0,0,0,,Бұл жақсы нәрсе.
Dialogue: 0,0:05:35.37,0:05:37.50,Default,,0,0,0,,Жас болу деген сөз
Dialogue: 0,0:05:38.12,0:05:39.92,Default,,0,0,0,,Бастаймыз ба?
Dialogue: 0,0:05:47.09,0:05:49.76,Default,,0,0,0,,Қалай болды? жастар
Dialogue: 0,0:05:50.14,0:05:53.14,Default,,0,0,0,,Ол қазірдің өзінде басталды
Dialogue: 0,0:05:54.64,0:05:55.98,Default,,0,0,0,,Сондықтан мен бақылауға тырысуды тоқтаттым — бұл жүз пайыздық бар күшімді салған шабуыл.
Dialogue: 0,0:05:57.14,0:05:59.65,Default,,0,0,0,,Жапон жекпе-жек өнері
Dialogue: 0,0:06:00.19,0:06:03.27,Default,,0,0,0,,Бұл қарт, кішкентай баладай...
Dialogue: 0,0:06:03.61,0:06:05.78,Default,,0,0,0,,(Арыстанның ақыруы)
Dialogue: 0,0:06:08.61,0:06:09.70,Default,,0,0,0,,Дәл…
Dialogue: 0,0:06:12.62,0:06:13.45,Default,,0,0,0,,Уау
Dialogue: 0,0:06:15.54,0:06:17.29,Default,,0,0,0,,Хаха, эй!
Dialogue: 0,0:06:19.33,0:06:20.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:21.71,0:06:22.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:30.38,0:06:31.22,Default,,0,0,0,,Уф
Dialogue: 0,0:06:35.31,0:06:38.23,Default,,0,0,0,,Қандай жұмбақ техника!
Dialogue: 0,0:06:39.27,0:06:40.94,Default,,0,0,0,,Еуропада пайда болғанын білемін.
Dialogue: 0,0:06:41.06,0:06:44.23,Default,,0,0,0,,Бағыну түрінен айырмашылығы
Dialogue: 0,0:06:44.86,0:06:47.11,Default,,0,0,0,,Буынның құрылымына қарағанда
Dialogue: 0,0:06:47.24,0:06:50.24,Default,,0,0,0,,Адам ағзасының рефлекстерін пайдалану сияқты...
Dialogue: 0,0:06:57.41,0:06:58.25,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:07:01.50,0:07:03.25,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:07:04.54,0:07:08.26,Default,,0,0,0,,Мен бұл ойында жеңілгім келмейді!
Dialogue: 0,0:07:08.76,0:07:10.13,Default,,0,0,0,,Хо
Dialogue: 0,0:07:10.42,0:07:11.26,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:07:14.10,0:07:14.93,Default,,0,0,0,,Ах
Dialogue: 0,0:07:15.81,0:07:19.77,Default,,0,0,0,,Жұдырықтасқандардың тарихы, ең көбі 100 жыл
Dialogue: 0,0:07:20.23,0:07:22.27,Default,,0,0,0,,Қысқарақ Қысқарақ
Dialogue: 0,0:07:22.56,0:07:23.40,Default,,0,0,0,,Иә
Dialogue: 0,0:07:26.61,0:07:28.73,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:07:31.11,0:07:34.03,Default,,0,0,0,,Бір кездері Лондонда өткен қорғаныс шайқасы
Dialogue: 0,0:07:34.41,0:07:36.33,Default,,0,0,0,,Үшінші айналымға дейін
Dialogue: 0,0:07:36.45,0:07:39.87,Default,,0,0,0,,Кейіпкер Брайан Лондонның барлық соққыларын жіберіп ал.
Dialogue: 0,0:07:40.00,0:07:41.66,Default,,0,0,0,,Бұрышқа айдалды
Dialogue: 0,0:07:42.96,0:07:45.96,Default,,0,0,0,,Қайғылы оқиға небәрі екі секундта аяқталды.
Dialogue: 0,0:07:46.63,0:07:48.71,Default,,0,0,0,,2 секундта берілген соққы
Dialogue: 0,0:07:48.84,0:07:51.63,Default,,0,0,0,,Бұл сан шын мәнінде 17 ату болды.
Dialogue: 0,0:07:52.05,0:07:53.55,Default,,0,0,0,,Жеңіл соққылар жоқ
Dialogue: 0,0:07:54.14,0:07:57.56,Default,,0,0,0,,Соққы жылдамдығын ерекше атап өтуге болады.
Dialogue: 0,0:07:58.76,0:08:02.56,Default,,0,0,0,,Пленканың кадрлар санынан өлшенетін жылдамдық тең
Dialogue: 0,0:08:03.10,0:08:05.31,Default,,0,0,0,,Қозғалыстан соққыға...
Dialogue: 0,0:08:06.61,0:08:08.90,Default,,0,0,0,,Іс жүзінде 0,11 секунд
Dialogue: 0,0:08:09.86,0:08:13.70,Default,,0,0,0,,Бұл осы уақытқа дейін тарихтағы ең жоғары қол жылдамдығы болды.
Dialogue: 0,0:08:13.82,0:08:16.74,Default,,0,0,0,,Орта салмақтағы чемпион Шугар Рэй Робинсон
Dialogue: 0,0:08:16.87,0:08:18.83,Default,,0,0,0,,айтарлықтай асып түседі
Dialogue: 0,0:08:19.12,0:08:21.00,Default,,0,0,0,,Мидың берген командаларына
Dialogue: 0,0:08:21.12,0:08:24.21,Default,,0,0,0,,Бұлшықеттердің әрекет ету жылдамдығынан асатын заттар
Dialogue: 0,0:08:24.54,0:08:28.46,Default,,0,0,0,,Басқаша айтқанда, бұл сөзсіз шындық.
Dialogue: 0,0:08:29.59,0:08:31.42,Default,,0,0,0,,Сіз зейнетке шыққаннан бері
Dialogue: 0,0:08:31.59,0:08:33.59,Default,,0,0,0,,Сенен артық боксшыны былай қойғанда
Dialogue: 0,0:08:33.72,0:08:36.26,Default,,0,0,0,,Тіпті спортшы да көрінбейді
Dialogue: 0,0:08:37.14,0:08:40.10,Default,,0,0,0,,Біз кездесе аламыз ба?
Dialogue: 0,0:08:40.22,0:08:42.10,Default,,0,0,0,,Сізден озатын спортшыларға
Dialogue: 0,0:08:43.23,0:08:46.10,Default,,0,0,0,,Жарық астында емес...
Dialogue: 0,0:08:46.48,0:08:48.36,Default,,0,0,0,,Иә, Хикари?
Dialogue: 0,0:08:48.61,0:08:50.36,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,0:08:51.03,0:08:55.11,Default,,0,0,0,,Рингке шықпайтын боксшы
Dialogue: 0,0:08:55.49,0:08:59.03,Default,,0,0,0,,Боксшы болсаң да рингке шыға алмайсың ба?
Dialogue: 0,0:08:59.74,0:09:01.12,Default,,0,0,0,,Не болды саған, жексұрын? Неге күліп тұрсың!
Dialogue: 0,0:09:02.04,0:09:04.12,Default,,0,0,0,,Менен жылдам
Dialogue: 0,0:09:09.38,0:09:10.25,Default,,0,0,0,,Бұл…
Dialogue: 0,0:09:10.67,0:09:13.76,Default,,0,0,0,,Осы Шибукаваға жанашырлық танытуым керек пе?
Dialogue: 0,0:09:14.38,0:09:17.51,Default,,0,0,0,,Мен қажетсіз зиян келтіретін ақымақтықтан аулақ болғым келді.
Dialogue: 0,0:09:17.64,0:09:21.26,Default,,0,0,0,,Сен ғана ұлы жекпе-жек шеберісің
Dialogue: 0,0:09:21.76,0:09:24.39,Default,,0,0,0,,Жанашырлық танытудағы дөрекілікке жол берілмейді
Dialogue: 0,0:09:27.69,0:09:29.52,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:30.27,0:09:33.78,Default,,0,0,0,,Бұл жақсы жыл болды, мен дағдарысты сезінбеймін.
Dialogue: 0,0:09:34.32,0:09:36.90,Default,,0,0,0,,Біз бір-бірімізбен кездесуіміз керек.
Dialogue: 0,0:09:37.61,0:09:39.78,Default,,0,0,0,,Өйткені, бұл бала...
Dialogue: 0,0:09:43.45,0:09:48.29,Default,,0,0,0,,Мені сонша мейірімділікпен қалай жеңе аласың?
Dialogue: 0,0:09:51.79,0:09:52.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:53.80,0:09:54.63,Default,,0,0,0,,Кімге?
Dialogue: 0,0:09:58.18,0:09:59.43,Default,,0,0,0,,Оны айтпа
Dialogue: 0,0:10:03.85,0:10:05.81,Default,,0,0,0,,Сіз қалай ойлайсыз? Ханма Баки
Dialogue: 0,0:10:06.43,0:10:08.52,Default,,0,0,0,,Мен үйленемін
Dialogue: 0,0:10:13.65,0:10:14.48,Default,,0,0,0,,Изуку Мидория…
Dialogue: 0,0:10:15.28,0:10:17.82,Default,,0,0,0,,Егер бұл рас болса
Dialogue: 0,0:10:20.20,0:10:21.41,Default,,0,0,0,,Сізді күттіріп қойдым ба?
Dialogue: 0,0:10:21.82,0:10:22.83,Default,,0,0,0,,Мен ренжідім
Dialogue: 0,0:10:24.95,0:10:26.33,Default,,0,0,0,,Хаа~
Dialogue: 0,0:10:26.95,0:10:29.08,Default,,0,0,0,,«Қою»?
Dialogue: 0,0:10:29.46,0:10:30.33,Default,,0,0,0,,Ммм
Dialogue: 0,0:10:31.08,0:10:33.09,Default,,0,0,0,,Бұл не? «Хмм»?
Dialogue: 0,0:10:33.71,0:10:37.38,Default,,0,0,0,,Қызық, ренжігеннен кейін не істеймін?
Dialogue: 0,0:10:37.55,0:10:38.59,Default,,0,0,0,,Козуэ
Dialogue: 0,0:10:39.59,0:10:41.34,Default,,0,0,0,,Бірдеңе жасау өз қолыңда.
Dialogue: 0,0:10:41.47,0:10:42.43,Default,,0,0,0,,Ах
Dialogue: 0,0:10:43.85,0:10:44.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:45.72,0:10:47.89,Default,,0,0,0,,Бұл менің шаруам емес.
Dialogue: 0,0:10:48.73,0:10:50.10,Default,,0,0,0,,Шешім менің қолымда емес
Dialogue: 0,0:10:51.27,0:10:52.10,Default,,0,0,0,,Иә
Dialogue: 0,0:10:53.86,0:10:54.94,Default,,0,0,0,,Қызық па?
Dialogue: 0,0:10:56.36,0:10:59.57,Default,,0,0,0,,Шешім менің қолымда емес
Dialogue: 0,0:11:01.99,0:11:03.28,Default,,0,0,0,,Ұқсас болуы мүмкін
Dialogue: 0,0:11:11.17,0:11:13.21,Default,,0,0,0,,Мен сенбеймін...
Dialogue: 0,0:11:13.83,0:11:16.13,Default,,0,0,0,,Бұл нағыз фотосурет
Dialogue: 0,0:11:17.30,0:11:21.59,Default,,0,0,0,,Магомед Алайдың жекпе-жегін көрген сайын осылай ойлайтынмын.
Dialogue: 0,0:11:24.43,0:11:30.39,Default,,0,0,0,,Бұл жігітпен бір рет ұрысып көріңіз.
Dialogue: 0,0:11:35.98,0:11:37.82,Default,,0,0,0,,Соққылар жоқ па?
Dialogue: 0,0:11:38.53,0:11:42.41,Default,,0,0,0,,Жарайды, балақай, саған гонг керек емес.
Dialogue: 0,0:11:46.16,0:11:47.54,Default,,0,0,0,,Мен қайықты тексеріп бітірдім.
Dialogue: 0,0:11:47.66,0:11:51.66,Default,,0,0,0,,Бұл стильдің тамаша көшірмесі емес пе?
Dialogue: 0,0:11:52.46,0:11:56.25,Default,,0,0,0,,Махомед Алай – менің әкем
Dialogue: 0,0:11:57.71,0:11:59.92,Default,,0,0,0,,Мен әкемнің стилін мұра еттім.
Dialogue: 0,0:12:00.42,0:12:03.93,Default,,0,0,0,,Толық жекпе-жек өнеріне айналды
Dialogue: 0,0:12:04.18,0:12:05.26,Default,,0,0,0,,(буындардың жарылған дыбысы)
Dialogue: 0,0:12:05.39,0:12:07.93,Default,,0,0,0,,Олар өте ұқсас...
Dialogue: 0,0:12:08.81,0:12:11.18,Default,,0,0,0,,Жоқ, маған бәрібір.
Dialogue: 0,0:12:12.14,0:12:14.73,Default,,0,0,0,,Кеттік, байсалды!
Dialogue: 0,0:12:19.94,0:12:20.78,Default,,0,0,0,,Уф
Dialogue: 0,0:12:21.28,0:12:22.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:24.61,0:12:25.45,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:12:26.45,0:12:28.87,Default,,0,0,0,,Жақсы оқы!
Dialogue: 0,0:12:30.29,0:12:34.50,Default,,0,0,0,,Магомед Арай кіші VS (Қарсы) Доппо Орочи
Dialogue: 0,0:12:35.33,0:12:38.59,Default,,0,0,0,,Бұл қылмыс.
Dialogue: 0,0:12:40.09,0:12:45.22,Default,,0,0,0,,Жапониядағы кез келген жерде оны қай жерде соқсаңыз да, ол әрқашан сатылып кетеді.
Dialogue: 0,0:12:45.72,0:12:49.22,Default,,0,0,0,,Мұны түнде саябақта ешкім білмей осылай жасау...
Dialogue: 0,0:12:50.85,0:12:53.23,Default,,0,0,0,,Бірде-бір көрермен жоқ
Dialogue: 0,0:12:53.85,0:12:56.23,Default,,0,0,0,,Бұл тұрарлық емес.
Dialogue: 0,0:12:57.23,0:12:58.06,Default,,0,0,0,,Уф
Dialogue: 0,0:12:59.40,0:13:00.73,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:13:01.65,0:13:05.49,Default,,0,0,0,,Уке техникасы: Қолданайын десем де, дер кезінде әрекет ете алмаймын.
Dialogue: 0,0:13:06.24,0:13:07.07,Default,,0,0,0,,Ах
Dialogue: 0,0:13:10.33,0:13:11.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:13.58,0:13:14.46,Default,,0,0,0,,Ах
Dialogue: 0,0:13:15.66,0:13:17.88,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:13:18.21,0:13:21.92,Default,,0,0,0,,Хаа~ Хаа...
Dialogue: 0,0:13:23.76,0:13:26.18,Default,,0,0,0,,Ой... тоқта, тоқта.
Dialogue: 0,0:13:26.93,0:13:32.35,Default,,0,0,0,,Өйткені, спортта жеңіске жету мүмкін емес.
Dialogue: 0,0:13:37.06,0:13:40.98,Default,,0,0,0,,Жеңіске жете алмасаңыз не істейсіз?
Dialogue: 0,0:13:45.07,0:13:46.45,Default,,0,0,0,,Жалғастырыңыз!
Dialogue: 0,0:13:46.90,0:13:47.74,Default,,0,0,0,,О...
Dialogue: 0,0:13:48.70,0:13:49.95,Default,,0,0,0,,Қол қалтасы…
Dialogue: 0,0:13:50.82,0:13:53.20,Default,,0,0,0,,Тек оны енгізіңіз.
Dialogue: 0,0:13:53.74,0:13:54.91,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:55.54,0:13:57.46,Default,,0,0,0,,Айтудың қажеті жоқ
Dialogue: 0,0:14:01.67,0:14:05.05,Default,,0,0,0,,О? Мен соға алмаймын
Dialogue: 0,0:14:05.71,0:14:06.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:10.89,0:14:12.01,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:14:13.43,0:14:14.77,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:14:15.68,0:14:19.48,Default,,0,0,0,,Сіз қалай ойлайсыз? Кішкене қарап жібере аласыз ба?
Dialogue: 0,0:14:20.56,0:14:21.52,Default,,0,0,0,,Спидвагон керемет шығып кетті.
Dialogue: 0,0:14:22.27,0:14:23.19,Default,,0,0,0,,Гуах
Dialogue: 0,0:14:23.90,0:14:24.82,Default,,0,0,0,,Хехе...
Dialogue: 0,0:14:25.53,0:14:27.19,Default,,0,0,0,,Гуаа аа...
Dialogue: 0,0:14:29.70,0:14:30.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:34.16,0:14:36.08,Default,,0,0,0,,Неліктен ол жұмыс істемейді?
Dialogue: 0,0:14:36.20,0:14:39.96,Default,,0,0,0,,Мақсат менің қолымнан келетіні анық.
Dialogue: 0,0:14:40.42,0:14:43.04,Default,,0,0,0,,Бұл да анық
Dialogue: 0,0:14:44.17,0:14:46.55,Default,,0,0,0,,Ол бір дюйм де қозғалған жоқ!
Dialogue: 0,0:14:47.59,0:14:49.55,Default,,0,0,0,,Сіз оны шешіп тастадыңыз.
Dialogue: 0,0:14:49.72,0:14:50.55,Default,,0,0,0,,Ах
Dialogue: 0,0:14:51.18,0:14:53.80,Default,,0,0,0,,Оны шешкен мен емес едім.
Dialogue: 0,0:14:54.43,0:14:56.06,Default,,0,0,0,,Баланың өзі
Dialogue: 0,0:14:59.44,0:15:02.31,Default,,0,0,0,,Мен ережелерді өзгерттім.
Dialogue: 0,0:15:02.65,0:15:03.48,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:05.19,0:15:07.32,Default,,0,0,0,,Бұрын Кендо
Dialogue: 0,0:15:08.49,0:15:09.82,Default,,0,0,0,,Кендо?
Dialogue: 0,0:15:10.20,0:15:12.82,Default,,0,0,0,,Менің қазір істеп жатқан ісім маңызды.
Dialogue: 0,0:15:13.28,0:15:15.08,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:15:15.78,0:15:17.33,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,0:15:17.83,0:15:21.12,Default,,0,0,0,,Осы уақытқа дейін біз бамбук қылыштарын қолдандық.
Dialogue: 0,0:15:21.25,0:15:24.21,Default,,0,0,0,,Ол қазір негізгі корпусты алып жатқанын айтты.
Dialogue: 0,0:15:24.50,0:15:28.84,Default,,0,0,0,,Шынай мен негізгі дененің арасында табиғи түрде болатын қашықтықтың өзгеруі
Dialogue: 0,0:15:29.84,0:15:31.55,Default,,0,0,0,,Адам бұл туралы білмесе де
Dialogue: 0,0:15:31.68,0:15:36.31,Default,,0,0,0,,Менің түйсігім жағдайды сезіп, тайыз қадам бастым.
Dialogue: 0,0:15:40.98,0:15:43.35,Default,,0,0,0,,Сонда бұл...
Dialogue: 0,0:15:44.23,0:15:46.86,Default,,0,0,0,,Бір-бірімізді өлтірейік.
Dialogue: 0,0:15:51.40,0:15:52.61,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:15:54.70,0:15:56.24,Default,,0,0,0,,Өзгертілді
Dialogue: 0,0:15:57.16,0:16:01.12,Default,,0,0,0,,Бұл адам кішкентай көрінді, үлкендігі бастай.
Dialogue: 0,0:16:01.66,0:16:02.87,Default,,0,0,0,,(Иида) Турбо Герой Ингениумды білесің бе?
Dialogue: 0,0:16:05.04,0:16:07.00,Default,,0,0,0,,Қандай үлкен!
Dialogue: 0,0:16:08.46,0:16:12.26,Default,,0,0,0,,Менің қолым кісі өлтіргенін білді
Dialogue: 0,0:16:12.80,0:16:14.13,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:14.80,0:16:16.10,Default,,0,0,0,,(Официант) Ж… Жоқ, мырза. Бұл «Неро» деп аталады➡
Dialogue: 0,0:16:18.10,0:16:20.39,Default,,0,0,0,,Қашықтықты қателесуге болмайды!
Dialogue: 0,0:16:22.60,0:16:27.23,Default,,0,0,0,,Жұдырық өзін допқа айналдырып, қорғанысын жетілдіреді.
Dialogue: 0,0:16:28.40,0:16:29.23,Default,,0,0,0,,Не~!? (Официант) Бұл – «Ой-Пи», көріп тұрсыз ба.
Dialogue: 0,0:16:31.94,0:16:32.99,Default,,0,0,0,,Іріктеу кезеңінде бірінші орын алған Изуку Мидория
Dialogue: 0,0:16:33.74,0:16:39.08,Default,,0,0,0,,Мен осы қашықтықта және осы уақытта қашып үлгердім.
Dialogue: 0,0:16:39.62,0:16:40.74,Default,,0,0,0,,Сонымен қатар
Dialogue: 0,0:16:41.41,0:16:46.50,Default,,0,0,0,,Осы қашықтықта, осы уақытта, есептегішке...
Dialogue: 0,0:16:48.34,0:16:49.75,Default,,0,0,0,,Алли мырза
Dialogue: 0,0:16:50.13,0:16:55.26,Default,,0,0,0,,Бұл жай ғана қызығушылық, бірақ маған хабарлаңыз.
Dialogue: 0,0:16:55.55,0:16:59.18,Default,,0,0,0,,Мысалы, Джордж Форман, Джо Фрейзер, т.б.
Dialogue: 0,0:16:59.30,0:17:02.27,Default,,0,0,0,,Тарихта қалатын нағыз ауыр салмақтағылар
Dialogue: 0,0:17:03.02,0:17:06.52,Default,,0,0,0,,Егер олардың ең жақсы соққысы таза соққы болса
Dialogue: 0,0:17:06.85,0:17:09.02,Default,,0,0,0,,Не болады?
Dialogue: 0,0:17:11.90,0:17:14.53,Default,,0,0,0,,Хмм... Мен сені ашуландырдым ба?
Dialogue: 0,0:17:18.91,0:17:19.99,Default,,0,0,0,,Ум...
Dialogue: 0,0:17:20.78,0:17:22.49,Default,,0,0,0,,Өте нашар
Dialogue: 0,0:17:22.62,0:17:25.37,Default,,0,0,0,,Сұрамауым керек еді ғой!
Dialogue: 0,0:17:27.50,0:17:28.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:28.46,0:17:29.33,Default,,0,0,0,,Тағы 500 рет!
Dialogue: 0,0:17:29.46,0:17:31.09,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:17:31.21,0:17:32.05,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:17:32.96,0:17:35.63,Default,,0,0,0,,Не, темір құбыр?
Dialogue: 0,0:17:37.43,0:17:39.18,Default,,0,0,0,,Эй, сәл күте тұрыңыз!
Dialogue: 0,0:17:39.30,0:17:42.43,Default,,0,0,0,,Мен бас тартамын! Енді сұрақтар жоқ!
Dialogue: 0,0:17:43.77,0:17:47.81,Default,,0,0,0,,Мына темір шыбықпен жерді барынша қатты соғыңыз.
Dialogue: 0,0:17:48.19,0:17:49.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:52.02,0:17:56.74,Default,,0,0,0,,Бұл еден...?
Dialogue: 0,0:17:57.20,0:17:59.45,Default,,0,0,0,,Бар күшіңізбен ұрыңыз
Dialogue: 0,0:17:59.57,0:18:03.58,Default,,0,0,0,,Әйтпесе менің соққымды аласыз.
Dialogue: 0,0:18:03.95,0:18:05.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:18:05.29,0:18:07.33,Default,,0,0,0,,Арх, аа... уф!
Dialogue: 0,0:18:08.46,0:18:10.58,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:18:12.96,0:18:14.09,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:18:14.46,0:18:18.47,Default,,0,0,0,,А... Мен соншалықты ессізмін...
Dialogue: 0,0:18:19.09,0:18:20.97,Default,,0,0,0,,Осыған ұқсас
Dialogue: 0,0:18:21.93,0:18:25.35,Default,,0,0,0,,Нағыз ауыр салмаққа барғанда
Dialogue: 0,0:18:26.35,0:18:29.23,Default,,0,0,0,,Бұл сезім бүкіл денеңе таралады.
Dialogue: 0,0:18:29.85,0:18:32.73,Default,,0,0,0,,Әй, мынау... бүкіл денеңде ме?
Dialogue: 0,0:18:33.40,0:18:35.15,Default,,0,0,0,,Мысалы,
Dialogue: 0,0:18:35.32,0:18:39.20,Default,,0,0,0,,Аяғымның астынан миллион құмырсқа жорғалайды.
Dialogue: 0,0:18:39.78,0:18:41.24,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:18:42.62,0:18:46.58,Default,,0,0,0,,А... бұл өте жақсы болжам.
Dialogue: 0,0:18:47.83,0:18:49.62,Default,,0,0,0,,Мен мұны істегенде де
Dialogue: 0,0:18:50.37,0:18:52.50,Default,,0,0,0,,Мен мұны істегенде де
Dialogue: 0,0:18:52.63,0:18:57.01,Default,,0,0,0,,Бұл әрқашан мидың зақымдануынан зардап шеккенде болады.
Dialogue: 0,0:18:59.17,0:19:02.59,Default,,0,0,0,,Мына жігіттер жорғалап шықты.
Dialogue: 0,0:19:03.80,0:19:06.52,Default,,0,0,0,,Жер жоғалады
Dialogue: 0,0:19:25.78,0:19:26.66,Default,,0,0,0,,Баки-кун...
Dialogue: 0,0:19:27.49,0:19:30.66,Default,,0,0,0,,Сен енді маған қарамайтын сияқтысың.
Dialogue: 0,0:19:33.92,0:19:34.92,Default,,0,0,0,,Мен мұқият қараймын.
Dialogue: 0,0:19:36.92,0:19:38.92,Default,,0,0,0,,Менің ойымша?
Dialogue: 0,0:19:41.30,0:19:42.22,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:43.80,0:19:47.18,Default,,0,0,0,,Көргеннен гөрі мен Козуэ сезінемін.
Dialogue: 0,0:19:48.81,0:19:49.93,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:19:50.60,0:19:51.44,Default,,0,0,0,,No
Dialogue: 0,0:19:52.94,0:19:54.35,Default,,0,0,0,,Көру керек
Dialogue: 0,0:20:04.32,0:20:05.20,Default,,0,0,0,,Ум...
Dialogue: 0,0:20:05.95,0:20:07.58,Default,,0,0,0,,(Балалардың шуы)
Dialogue: 0,0:20:10.58,0:20:12.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:13.08,0:20:14.33,Default,,0,0,0,,Кіші
Dialogue: 0,0:20:14.83,0:20:15.96,Default,,0,0,0,,Баки-сан
Dialogue: 0,0:20:16.54,0:20:20.05,Default,,0,0,0,,Мен Козуэге үйленемін.
Dialogue: 0,0:20:20.71,0:20:23.34,Default,,0,0,0,,Пуф Ахахахха!
Dialogue: 0,0:20:23.47,0:20:25.97,Default,,0,0,0,,Мен оны осындай жерде айтамын деп ойлаймын!
Dialogue: 0,0:20:26.85,0:20:28.22,Default,,0,0,0,,Маған қатты әсер етті.
Dialogue: 0,0:20:28.76,0:20:31.27,Default,,0,0,0,,Эй... Аа~
Dialogue: 0,0:20:32.89,0:20:33.73,Default,,0,0,0,,Сіз...
Dialogue: 0,0:20:35.23,0:20:36.40,Default,,0,0,0,,Басқа мақсат үшін...
Dialogue: 0,0:20:36.48,0:20:37.98,Default,,0,0,0,,Сіз мұны айтып тұрған жоқсыз, солай ма?
Dialogue: 0,0:20:39.23,0:20:42.03,Default,,0,0,0,,Мысалы, мені ашуландыру үшін.
Dialogue: 0,0:20:42.86,0:20:47.66,Default,,0,0,0,,Бұл ақымақ сұраққа шынымен жауап беру керек пе?
Dialogue: 0,0:20:49.87,0:20:51.70,Default,,0,0,0,,Тағы да айтайын
Dialogue: 0,0:20:52.45,0:20:55.50,Default,,0,0,0,,Козуэ мырзаға жақындаңыз
Dialogue: 0,0:20:57.88,0:21:00.38,Default,,0,0,0,,Бұл маған әр кезде айтатын нәрсе емес.
Dialogue: 0,0:21:00.88,0:21:02.76,Default,,0,0,0,,Қозуе ешкімдікі емес.
Dialogue: 0,0:21:03.13,0:21:04.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:05.63,0:21:10.26,Default,,0,0,0,,Жаңа ғана естідім, ол сенікі емес.
Dialogue: 0,0:21:11.39,0:21:14.02,Default,,0,0,0,,Мен Бакидің құрбысымын...
Dialogue: 0,0:21:14.52,0:21:15.81,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:21:16.40,0:21:20.73,Default,,0,0,0,,Бірақ бұл тек екі адамның арасындағы уәде болды.
Dialogue: 0,0:21:21.02,0:21:23.03,Default,,0,0,0,,Қарама-қарсы жыныстың басқа өкілдері қатыспайды.
Dialogue: 0,0:21:23.74,0:21:26.07,Default,,0,0,0,,Кез келген адам Қозуэге ғашық болуы мүмкін
Dialogue: 0,0:21:26.20,0:21:28.53,Default,,0,0,0,,Менің сүйіктім болғың келсе, өтініш жаз.
Dialogue: 0,0:21:28.87,0:21:31.99,Default,,0,0,0,,Кімнің үздік екенін Козуэ шешуі керек.
Dialogue: 0,0:21:33.66,0:21:35.83,Default,,0,0,0,,Егер сіз мені жақсы емес деп ойласаңыз
Dialogue: 0,0:21:36.67,0:21:39.50,Default,,0,0,0,,Козуэ...басқа жаққа баруға болады.
Dialogue: 0,0:21:41.17,0:21:42.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:43.67,0:21:46.05,Default,,0,0,0,,Жарайды ма? Сонымен
Dialogue: 0,0:21:49.14,0:21:53.06,Default,,0,0,0,,Мұндай бәсекеде ерлер де, әйелдер де бар.
Dialogue: 0,0:21:55.18,0:21:56.81,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:21:57.31,0:21:58.35,Default,,0,0,0,,Okay!
Dialogue: 0,0:22:00.06,0:22:01.65,Default,,0,0,0,,Өте әділ
Dialogue: 0,0:22:02.94,0:22:06.15,Default,,0,0,0,,Козуэ-сан, тағы кездескенше.
Dialogue: 0,0:22:07.15,0:22:09.07,Default,,0,0,0,,көремін. (Козуэ) А.
Dialogue: 0,0:22:10.45,0:22:11.83,Default,,0,0,0,,Ол болды ма?
Dialogue: 0,0:22:13.66,0:22:14.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:21.79,0:22:27.80,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:44.08,0:23:50.09,Default,,0,0,0,,~♪
