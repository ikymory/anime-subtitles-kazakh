Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:21.86,0:00:24.16,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:00:27.53,0:00:30.87,Default,,0,0,0,,Енді сен екеуміз ғана қалдық па?
Dialogue: 0,0:00:30.87,0:00:32.87,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:00:35.87,0:00:39.21,Default,,0,0,0,,Бұл ақырында болуы керек еді.
Dialogue: 0,0:00:39.21,0:00:42.38,Default,,0,0,0,,Мына көрші дүние менікі.
Dialogue: 0,0:00:42.38,0:00:46.22,Default,,0,0,0,,Оны сенікі болғанша жоюға рұқсат ете ме?
Dialogue: 0,0:00:46.22,0:00:48.22,Default,,0,0,0,,Жақсы... өйткені➡
Dialogue: 0,0:00:48.22,0:00:51.06,Default,,0,0,0,,Сізде соншалықты дұрыс, солай ма?
Dialogue: 0,0:00:51.06,0:00:54.89,Default,,0,0,0,,Бұл қоқыс. Бәрі қоқыс.
Dialogue: 0,0:00:54.89,0:00:58.73,Default,,0,0,0,,Сондықтан сіз әлемді жоюды жоспарлап отырсыз ба?
Dialogue: 0,0:00:58.73,0:01:01.07,Default,,0,0,0,,Қызықсыз десең➡
Dialogue: 0,0:01:01.07,0:01:04.24,Default,,0,0,0,,Біздің өміріміз түкке тұрғысыз
Dialogue: 0,0:01:04.24,0:01:06.91,Default,,0,0,0,,Содан кейін келіссөздер үзіледі.
Dialogue: 0,0:01:06.91,0:01:09.74,Default,,0,0,0,,Мен бұл келіссөздер екеніне таң қалдым.
Dialogue: 0,0:01:09.74,0:01:12.01,Default,,0,0,0,,Сіз. Сіз
Dialogue: 0,0:01:12.01,0:01:14.18,Default,,0,0,0,,Бұл зиянкес. Бұл құрбандық.
Dialogue: 0,0:01:14.18,0:01:16.18,Default,,0,0,0,,Зафукиел
Dialogue: 0,0:01:18.18,0:01:20.18,Default,,0,0,0,,Люсибугтар
Dialogue: 0,0:01:23.69,0:01:25.69,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:28.53,0:01:31.36,Default,,0,0,0,,Хехехе... Кух!
Dialogue: 0,0:01:31.36,0:01:33.36,Default,,0,0,0,,Алеф! (мылтық)
Dialogue: 0,0:01:36.37,0:01:38.37,Default,,0,0,0,,үдеу?
Dialogue: 0,0:01:38.37,0:01:41.04,Default,,0,0,0,,Мосниме. (мылтық)
Dialogue: 0,0:01:41.04,0:01:43.04,Default,,0,0,0,,Ауыстыру!?
Dialogue: 0,0:01:47.21,0:01:49.41,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:52.88,0:01:56.05,Default,,0,0,0,,《Кюзо: Адам өлсе жұмаққа немесе тозаққа түседі.
Dialogue: 0,0:01:56.05,0:01:59.89,Default,,0,0,0,,Сонда рух ретінде мен➡мін
Dialogue: 0,0:01:59.89,0:02:02.39,Default,,0,0,0,,Біз қайда барамыз? 》
Dialogue: 0,0:03:41.53,0:03:43.53,Default,,0,0,0,,(Сувенир дүкенінің иесі) Хмм… (Турист 1) Ә?
Dialogue: 0,0:03:51.37,0:03:55.21,Default,,0,0,0,,Tiktak Tiktak Tiktak
Dialogue: 0,0:03:55.21,0:03:57.54,Default,,0,0,0,,42 іріктеуші қатысатын ат үстіндегі шайқас
Dialogue: 0,0:03:57.54,0:04:01.44,Default,,0,0,0,,Соңғысы келді
Dialogue: 0,0:04:06.88,0:04:11.39,Default,,0,0,0,,《Куризо: Кешіріңіз... Кешіріңіз.
Dialogue: 0,0:04:11.39,0:04:14.49,Default,,0,0,0,,Мен сені арқама көтеріп апардым.
Dialogue: 0,0:04:14.49,0:04:19.66,Default,,0,0,0,,Менің махаббатым, менің өлімім
Dialogue: 0,0:04:19.66,0:04:22.50,Default,,0,0,0,,Ах... бірақ...
Dialogue: 0,0:04:22.50,0:04:26.50,Default,,0,0,0,,Бір күні тағы сенімен》
Dialogue: 0,0:04:26.50,0:04:42.02,Default,,0,0,0,,♪~
Dialogue: 0,0:04:42.02,0:04:45.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:48.19,0:04:52.19,Default,,0,0,0,,Сен сүйкімдісің, солай ма? Ниа...
Dialogue: 0,0:04:54.20,0:04:57.04,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:04:57.04,0:05:02.21,Default,,0,0,0,,[Спикер] Соңғы қатысушы Куруми Токисаки кірді.
Dialogue: 0,0:05:02.21,0:05:05.54,Default,,0,0,0,,[Спикер] Ойынның басталуына 30 секунд қалды
Dialogue: 0,0:05:05.54,0:05:09.55,Default,,0,0,0,,[Сөйлеуші] Барлығыңыз, қалған өміріңізді жан тыныштығымен өткізіңіз.
Dialogue: 0,0:05:09.55,0:05:13.48,Default,,0,0,0,,Не? [Спикер] Ойынның басталуына 20 секунд қалды
Dialogue: 0,0:05:13.48,0:05:16.99,Default,,0,0,0,,[Сөйлеуші] Қалған өміріңізді жан тыныштығымен өткізіңіз
Dialogue: 0,0:05:16.99,0:05:18.99,Default,,0,0,0,,[Сөйлеуші] Біреуі ғана аман қалды
Dialogue: 0,0:05:18.99,0:05:21.99,Default,,0,0,0,,[Сөйлеуші] Бір-біріңді қанағат тұтқанша өлтіріңдер.
Dialogue: 0,0:05:21.99,0:05:26.33,Default,,0,0,0,,Сіз нені айтасыз? Мен неге?
Dialogue: 0,0:05:26.33,0:05:29.00,Default,,0,0,0,,Бұл жердің не жері...
Dialogue: 0,0:05:29.00,0:05:31.00,Default,,0,0,0,,Ал... бірін-бірі өлтіру ме?
Dialogue: 0,0:05:31.00,0:05:35.34,Default,,0,0,0,,Боу?
Dialogue: 0,0:05:35.34,0:05:38.01,Default,,0,0,0,,[Спикер] Ойын басталады. (Қоңырау дыбысы)
Dialogue: 0,0:05:38.01,0:05:40.68,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:40.68,0:05:44.52,Default,,0,0,0,,Ха! Қарғыс атқыр... Мазалама, Ао!
Dialogue: 0,0:05:44.52,0:05:47.02,Default,,0,0,0,,Battle Royale ойынына ешқандай кедергілер жоқ.
Dialogue: 0,0:05:47.02,0:05:50.52,Default,,0,0,0,,Мен Сайғанмен мәселені шешуім керек!
Dialogue: 0,0:05:50.52,0:05:54.03,Default,,0,0,0,,Долмастер Такешита Сайганмен соғысқысы келді.
Dialogue: 0,0:05:54.03,0:05:57.53,Default,,0,0,0,,Не? Ол Долмастерді жеңе алмайды
Dialogue: 0,0:05:57.53,0:06:00.87,Default,,0,0,0,,Сіздің шешіміңіз ешқашан шешілмейді.
Dialogue: 0,0:06:00.87,0:06:05.04,Default,,0,0,0,,Ондай жағдайда мен сені жеңемін, Қуыршақ шеберін де жеңемін!
Dialogue: 0,0:06:05.04,0:06:07.54,Default,,0,0,0,,Иә, бұл ең қысқа жол.
Dialogue: 0,0:06:07.54,0:06:10.37,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:10.37,0:06:13.48,Default,,0,0,0,,Өкінішке орай, бұл мүмкін емес деп мәлімдеймін.
Dialogue: 0,0:06:13.48,0:06:15.98,Default,,0,0,0,,Сіз тырыспасаңыз, білмейсіз
Dialogue: 0,0:06:15.98,0:06:17.98,Default,,0,0,0,,Бискет сындырғыш!
Dialogue: 0,0:06:17.98,0:06:20.38,Default,,0,0,0,,Демек, бұл… Парадис аралының Шайтаны!!
Dialogue: 0,0:06:22.49,0:06:26.16,Default,,0,0,0,,Бірін-бірі өлтіру? Шынымен бе?
Dialogue: 0,0:06:26.16,0:06:28.16,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:28.16,0:06:30.16,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:06:32.16,0:06:34.16,Default,,0,0,0,,Рейю Сага
Dialogue: 0,0:06:37.00,0:06:42.01,Default,,0,0,0,,Енді барыңыз. Ня...
Dialogue: 0,0:06:42.01,0:06:46.84,Default,,0,0,0,,Сіз бір-біріңізді өлтіргіңіз келді.
Dialogue: 0,0:06:46.84,0:06:52.02,Default,,0,0,0,,Мен неге мұндамын? Мен неге тірімін?
Dialogue: 0,0:06:52.02,0:06:57.02,Default,,0,0,0,,Сіз кімсіз? Мысықтар неге сонша сүйкімді➡
Dialogue: 0,0:06:57.02,0:06:59.52,Default,,0,0,0,,Мен ештеңе түсінбеймін
Dialogue: 0,0:06:59.52,0:07:03.19,Default,,0,0,0,,Жолыма бөгет болсаң➡
Dialogue: 0,0:07:03.19,0:07:05.53,Default,,0,0,0,,Мен сені ұрамын, жарай ма?
Dialogue: 0,0:07:05.53,0:07:07.53,Default,,0,0,0,,Күлкілі!
Dialogue: 0,0:07:07.53,0:07:09.87,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:07:09.87,0:07:11.80,Default,,0,0,0,,Кихи
Dialogue: 0,0:07:11.80,0:07:14.14,Default,,0,0,0,,Хмм, өзіңізді жақсы сезінбейтін сияқтысыз.
Dialogue: 0,0:07:14.14,0:07:17.81,Default,,0,0,0,,Ах. (мылтық)
Dialogue: 0,0:07:17.81,0:07:21.81,Default,,0,0,0,,О? Түсінемін, сен ниндзясың.
Dialogue: 0,0:07:21.81,0:07:23.98,Default,,0,0,0,,Ниа. О.
Dialogue: 0,0:07:23.98,0:07:26.88,Default,,0,0,0,,Сіз қашып кетпедіңіз бе?
Dialogue: 0,0:07:30.99,0:07:33.16,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:33.16,0:07:38.83,Default,,0,0,0,,1 адам 2 адам 3 адам қалды
Dialogue: 0,0:07:38.83,0:07:43.17,Default,,0,0,0,,Мен олардың бір-бірін тез өлтірулерін қалаймын.
Dialogue: 0,0:07:43.17,0:07:47.67,Default,,0,0,0,,Әзірше мен оны кішкентай қуыршақ кейіпкер болса да жеңуім керек пе?
Dialogue: 0,0:07:47.67,0:07:49.67,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:07:49.67,0:07:53.18,Default,,0,0,0,,Хахахахахахахахахаха...
Dialogue: 0,0:07:53.18,0:07:57.18,Default,,0,0,0,,Өтінемін... көмектесіңізші! иә?
Dialogue: 0,0:07:57.18,0:08:00.18,Default,,0,0,0,,А... көмек...
Dialogue: 0,0:08:00.18,0:08:03.02,Default,,0,0,0,,Уф... Уау! Өтінемін жат
Dialogue: 0,0:08:03.02,0:08:05.02,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:08:08.03,0:08:10.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:10.03,0:08:14.63,Default,,0,0,0,,Мен саған көмектесуге тырыстым, бірақ сен де менің жауымсың ба?
Dialogue: 0,0:08:14.63,0:08:18.47,Default,,0,0,0,,Одан тезірек құтылған дұрыс сияқты.
Dialogue: 0,0:08:18.47,0:08:22.14,Default,,0,0,0,,Уа! Жақсы емес, мүлде жақсы емес!
Dialogue: 0,0:08:22.14,0:08:25.98,Default,,0,0,0,,Өтінемін, қарусыз! Міне, мәміле.
Dialogue: 0,0:08:25.98,0:08:29.81,Default,,0,0,0,,Білетіндеріңді айтыңдаршы.
Dialogue: 0,0:08:29.81,0:08:35.15,Default,,0,0,0,,Мен мұнда жаңа келдім, оңды-солды білмеймін.
Dialogue: 0,0:08:35.15,0:08:37.15,Default,,0,0,0,,Ха...
Dialogue: 0,0:08:45.50,0:08:47.50,Default,,0,0,0,,Енді...
Dialogue: 0,0:08:47.50,0:08:50.33,Default,,0,0,0,,Мұнда қалай келгеніңіз есіңізде ме?
Dialogue: 0,0:08:50.33,0:08:53.50,Default,,0,0,0,,Жоқ, мүлде емес. Сонымен сенің атың кім?
Dialogue: 0,0:08:53.50,0:08:55.84,Default,,0,0,0,,Мен...
Dialogue: 0,0:08:55.84,0:08:59.51,Default,,0,0,0,,Куруми Токисаки Бұл рух.
Dialogue: 0,0:08:59.51,0:09:04.35,Default,,0,0,0,,А? Бұл рух емес, бұл квази рух, солай ма?
Dialogue: 0,0:09:04.35,0:09:06.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:06.35,0:09:10.69,Default,,0,0,0,,Рухтар - бұл дүниеде бұрыннан болған апаттар.
Dialogue: 0,0:09:10.69,0:09:14.79,Default,,0,0,0,,Дүниені бұзатын құдіреті бар құдайдай қыз
Dialogue: 0,0:09:14.79,0:09:17.80,Default,,0,0,0,,Бірақ қазір ол жоқ
Dialogue: 0,0:09:17.80,0:09:21.30,Default,,0,0,0,,Олай болса, біздің мұнда тұрғанымыз - рухтан кейінгі келесі болмыс ➡
Dialogue: 0,0:09:21.30,0:09:26.47,Default,,0,0,0,,Бұл квази-рух. Рухтан кейінгі келесі тіршілік...
Dialogue: 0,0:09:26.47,0:09:30.64,Default,,0,0,0,,тым кеш, бірақ менің атым Хибики Хибики.
Dialogue: 0,0:09:30.64,0:09:33.81,Default,,0,0,0,,Танысқаныма қуаныштымын! Күрсін...
Dialogue: 0,0:09:33.81,0:09:36.48,Default,,0,0,0,,Сонымен не білгің келеді?
Dialogue: 0,0:09:36.48,0:09:38.48,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:09:38.48,0:09:41.49,Default,,0,0,0,,Неліктен біз бір-бірімізді өлтіруіміз керек?
Dialogue: 0,0:09:41.49,0:09:45.32,Default,,0,0,0,,Тілегінің орындалуы үшін. Тілек?
Dialogue: 0,0:09:45.32,0:09:48.99,Default,,0,0,0,,10-шы патшалық Малқұтты басқаратын квази рух –➡
Dialogue: 0,0:09:48.99,0:09:51.50,Default,,0,0,0,,Тілектерді орындауға күші бар
Dialogue: 0,0:09:51.50,0:09:54.50,Default,,0,0,0,,Маркт? А, түсіндім
Dialogue: 0,0:09:54.50,0:09:58.84,Default,,0,0,0,,Алғышарт басқа, иә...
Dialogue: 0,0:09:58.84,0:10:02.84,Default,,0,0,0,,Бұл сіз бұрын болған әлем емес.
Dialogue: 0,0:10:02.84,0:10:04.84,Default,,0,0,0,,Бұл келесі әлем
Dialogue: 0,0:10:04.84,0:10:08.01,Default,,0,0,0,,Бұл енді адам емес қыздар өмір сүретін дүние.
Dialogue: 0,0:10:08.01,0:10:13.85,Default,,0,0,0,,Хмм, жердегі жұмақ? Жоқ. Бұл тозақ па?
Dialogue: 0,0:10:13.85,0:10:16.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:16.02,0:10:18.86,Default,,0,0,0,,Куруми мырза, осында бір сәтке келе аласыз ба?
Dialogue: 0,0:10:18.86,0:10:21.46,Default,,0,0,0,,Бұл не? О, күт!
Dialogue: 0,0:10:25.86,0:10:29.53,Default,,0,0,0,,Эй, сен бұған сене аласың, солай ма?
Dialogue: 0,0:10:29.53,0:10:31.70,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:10:31.70,0:10:35.54,Default,,0,0,0,,Менің бұған сенуден басқа амалым жоқ.
Dialogue: 0,0:10:35.54,0:10:37.54,Default,,0,0,0,,Уф, тым қызықсыз екен.
Dialogue: 0,0:10:37.54,0:10:39.71,Default,,0,0,0,,Құлағанша білмеймін десең➡
Dialogue: 0,0:10:39.71,0:10:41.71,Default,,0,0,0,,Мен не істерімді ойладым.
Dialogue: 0,0:10:41.71,0:10:45.22,Default,,0,0,0,,Ондай жағдайда мен сені тастап, тәжірибе жасаймын.
Dialogue: 0,0:10:45.22,0:10:47.89,Default,,0,0,0,,Қайтып келіп, құлап көрдің делік.
Dialogue: 0,0:10:47.89,0:10:50.55,Default,,0,0,0,,Қайтып келмесең не істейсің!?
Dialogue: 0,0:10:50.55,0:10:53.89,Default,,0,0,0,,Әрине, мен сенің асыл құрбандығыңды жоқтаймын.
Dialogue: 0,0:10:53.89,0:10:56.89,Default,,0,0,0,,Мен жоқтау сезімін мүлде сезе алмаймын.
Dialogue: 0,0:10:56.89,0:11:00.56,Default,,0,0,0,,Жоғарыда айтқаныңыздай➡
Dialogue: 0,0:11:00.56,0:11:04.40,Default,,0,0,0,,Тілегіңіз орындалды деген нені білдіреді...? иә
Dialogue: 0,0:11:04.40,0:11:08.57,Default,,0,0,0,,Бұл қандай тілек? иә!
Dialogue: 0,0:11:08.57,0:11:12.18,Default,,0,0,0,,Өлгендерді тірілтуге де болады. Содан кейін➡
Dialogue: 0,0:11:12.18,0:11:15.01,Default,,0,0,0,,Сондай-ақ шынайы әлемге оралуға болады.
Dialogue: 0,0:11:15.01,0:11:18.02,Default,,0,0,0,,Мен... үйге бара аламын ба?
Dialogue: 0,0:11:18.02,0:11:21.52,Default,,0,0,0,,Егер біз осы қырғынға төтеп бере алсақ➡
Dialogue: 0,0:11:21.52,0:11:23.92,Default,,0,0,0,,Тілегіңіз міндетті түрде орындалады.
Dialogue: 0,0:11:29.36,0:11:33.03,Default,,0,0,0,,Адамдарды бірін-бірі өлтіруге кім мәжбүрлеп отыр?
Dialogue: 0,0:11:33.03,0:11:35.53,Default,,0,0,0,,Мен атын білмеймін
Dialogue: 0,0:11:35.53,0:11:39.37,Default,,0,0,0,,Ақ патшайым... Королева деп аталатын болмыс
Dialogue: 0,0:11:39.37,0:11:42.37,Default,,0,0,0,,Бірақ мен оны ешқашан көрген емеспін.
Dialogue: 0,0:11:42.37,0:11:45.54,Default,,0,0,0,,Патшайым...｡ Мм...
Dialogue: 0,0:11:45.54,0:11:47.88,Default,,0,0,0,,Қарсы болмасаңыз, ынтымақтастық жасағыңыз келе ме?
Dialogue: 0,0:11:47.88,0:11:51.22,Default,,0,0,0,,Ынтымақтастық...? иә
Dialogue: 0,0:11:51.22,0:11:56.22,Default,,0,0,0,,Менің де орындағым келетін тілегім бар, сол мақсатта аман қалғым келеді.
Dialogue: 0,0:11:56.22,0:11:59.89,Default,,0,0,0,,Менде әлсіздің орнына ақпарат бар
Dialogue: 0,0:11:59.89,0:12:02.89,Default,,0,0,0,,Куруми-сан ешқандай ақпарат болмаса да күшті.
Dialogue: 0,0:12:02.89,0:12:05.40,Default,,0,0,0,,Олай болса топтасып күресейік!
Dialogue: 0,0:12:05.40,0:12:07.40,Default,,0,0,0,,Хмм…
Dialogue: 0,0:12:07.40,0:12:10.90,Default,,0,0,0,,Әрине, бұл біз.
Dialogue: 0,0:12:10.90,0:12:14.67,Default,,0,0,0,,Ондай жағдайда әділ күрес.
Dialogue: 0,0:12:14.67,0:12:19.18,Default,,0,0,0,,Маған 3 секунд ойлануға рұқсат етіңізші. Иә, уақытыңызды алыңыз!
Dialogue: 0,0:12:19.18,0:12:22.51,Default,,0,0,0,,Үш секунд? 1 2 3
Dialogue: 0,0:12:22.51,0:12:24.52,Default,,0,0,0,,Мен мұны істеймін. Асығыңыз!
Dialogue: 0,0:12:24.52,0:12:27.52,Default,,0,0,0,,Бірақ егер сен маған опасыздық жасасаң, мен сені кешірмеймін.
Dialogue: 0,0:12:27.52,0:12:29.52,Default,,0,0,0,,Иә
Dialogue: 0,0:12:29.52,0:12:32.19,Default,,0,0,0,,Айтыңызшы.
Dialogue: 0,0:12:32.19,0:12:35.53,Default,,0,0,0,,Кімді өлтіруім керек? Иә.
Dialogue: 0,0:12:35.53,0:12:39.03,Default,,0,0,0,,Бұл жолғы қатысушылар арасында мен және Куруми-сан➡ бар
Dialogue: 0,0:12:39.03,0:12:41.53,Default,,0,0,0,,8 адам
Dialogue: 0,0:12:48.87,0:12:53.88,Default,,0,0,0,,Ао Бұл жолы қатысушылардың ішінде физикалық жағынан ең күшті сынып
Dialogue: 0,0:12:53.88,0:12:56.71,Default,,0,0,0,,Ол Бискетт Смашер деген атпен де белгілі.
Dialogue: 0,0:12:56.71,0:12:59.55,Default,,0,0,0,,Бискет... Бұл не?
Dialogue: 0,0:12:59.55,0:13:01.55,Default,,0,0,0,,Бискет сынғыш
Dialogue: 0,0:13:01.55,0:13:04.22,Default,,0,0,0,,Жауды печенье сияқты езетіндіктен болса керек.
Dialogue: 0,0:13:04.22,0:13:06.22,Default,,0,0,0,,Бұл шашырау.
Dialogue: 0,0:13:06.22,0:13:09.56,Default,,0,0,0,,Мен Кунойчи Сага Реймін
Dialogue: 0,0:13:09.56,0:13:13.50,Default,,0,0,0,,Түрі бір кісі көп сияқты.
Dialogue: 0,0:13:13.50,0:13:15.67,Default,,0,0,0,,Клондау әдісіне ұқсайды.
Dialogue: 0,0:13:15.67,0:13:18.67,Default,,0,0,0,,Аа, бұрынғысы.
Dialogue: 0,0:13:18.67,0:13:22.17,Default,,0,0,0,,Әзірге Уцусеми техникасын қолдануға болатын сияқты.
Dialogue: 0,0:13:22.17,0:13:24.68,Default,,0,0,0,,Хиджиката Исами
Dialogue: 0,0:13:24.68,0:13:29.51,Default,,0,0,0,,Ол шынында да үлкен қылыш ұстайтын сабаса-саба типті қыз.
Dialogue: 0,0:13:29.51,0:13:31.52,Default,,0,0,0,,Сабасабаса?
Dialogue: 0,0:13:31.52,0:13:35.19,Default,,0,0,0,,Кешіріңіз! Мен жай ғана суретке қарап айттым!
Dialogue: 0,0:13:35.19,0:13:40.02,Default,,0,0,0,,Сосын Такешита Сайган...
Dialogue: 0,0:13:40.02,0:13:43.42,Default,,0,0,0,,Бұл адам әлдеқашан өлген. (Куразо) Жарайды.
Dialogue: 0,0:13:46.20,0:13:49.70,Default,,0,0,0,,Ибусуки Пани қуыршақ шебері ретінде де белгілі
Dialogue: 0,0:13:49.70,0:13:53.04,Default,,0,0,0,,Сізге бұрын бір қуыршақ шабуыл жасаған, солай ма?
Dialogue: 0,0:13:53.04,0:13:55.54,Default,,0,0,0,,Оны басқаратын квазирух.
Dialogue: 0,0:13:55.54,0:13:58.71,Default,,0,0,0,,Сонда енді қорқудың қажеті жоқ.
Dialogue: 0,0:13:58.71,0:14:00.88,Default,,0,0,0,,Қуыршақ жойылды.
Dialogue: 0,0:14:00.88,0:14:05.38,Default,,0,0,0,,Өкінішке орай, басқарылатын қуыршақтардың саны 100-ден асады.
Dialogue: 0,0:14:05.38,0:14:09.18,Default,,0,0,0,,Бұл Вангар армиясы. (Куризо) Дұрыс.
Dialogue: 0,0:14:11.56,0:14:15.16,Default,,0,0,0,,Және соңғы, бірақ кем дегенде... Королева.
Dialogue: 0,0:14:15.16,0:14:19.00,Default,,0,0,0,,Сіз де сол патшайыммен бірге өлтіруге қатысасыз ба?
Dialogue: 0,0:14:19.00,0:14:22.33,Default,,0,0,0,,Кейде болады, кейде болмайды.
Dialogue: 0,0:14:22.33,0:14:24.33,Default,,0,0,0,,Бұл жолы мен әлі білмеймін.
Dialogue: 0,0:14:26.50,0:14:29.51,Default,,0,0,0,,Мен дерлік түсіндім.
Dialogue: 0,0:14:29.51,0:14:33.01,Default,,0,0,0,,Сізге соңғы сұрақ қойсам болады ма?
Dialogue: 0,0:14:33.01,0:14:35.01,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,0:14:35.01,0:14:37.91,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:14:39.85,0:14:44.02,Default,,0,0,0,,Досымды өмірге қайтару – менің қалағаным.
Dialogue: 0,0:14:44.02,0:14:49.53,Default,,0,0,0,,Дос...｡ Иә, ол өте маңызды дос болды.
Dialogue: 0,0:14:49.53,0:14:53.03,Default,,0,0,0,,Қайтыс болған досымды тірілтіп алсам➡
Dialogue: 0,0:14:53.03,0:14:56.37,Default,,0,0,0,,Сіздің ойыңызша, ол үшін өміріңізді қатерге тіккен жөн емес пе?
Dialogue: 0,0:14:56.37,0:15:00.87,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:15:00.87,0:15:03.37,Default,,0,0,0,,Барымызды салайық! Куруми мырза!
Dialogue: 0,0:15:03.37,0:15:06.54,Default,,0,0,0,,Олар бір-бірін өлтіреді, солай ма?
Dialogue: 0,0:15:06.54,0:15:08.88,Default,,0,0,0,,Ал... бұл туралы.
Dialogue: 0,0:15:08.88,0:15:12.48,Default,,0,0,0,,Иә? А?
Dialogue: 0,0:15:12.48,0:15:15.65,Default,,0,0,0,,Сіз жаңадан келген квази-рухсыз ба?
Dialogue: 0,0:15:15.65,0:15:19.49,Default,,0,0,0,,Жаңадан келгендерге иә, квази-рухтарға жоқ.
Dialogue: 0,0:15:19.49,0:15:21.49,Default,,0,0,0,,А...?
Dialogue: 0,0:15:21.49,0:15:26.00,Default,,0,0,0,,Мен таза және кіршіксіз рухпын.
Dialogue: 0,0:15:26.00,0:15:29.50,Default,,0,0,0,,Бұл... қызық.
Dialogue: 0,0:15:29.50,0:15:31.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:33.84,0:15:37.84,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:15:40.34,0:15:43.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:43.18,0:15:45.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:50.85,0:15:52.86,Default,,0,0,0,,Ха...
Dialogue: 0,0:15:52.86,0:15:54.86,Default,,0,0,0,,Аруақ десең де➡
Dialogue: 0,0:15:54.86,0:16:01.03,Default,,0,0,0,,Менің ойымша, бұл дәл қазір мен үшін шек...
Dialogue: 0,0:16:01.03,0:16:03.03,Default,,0,0,0,,(шу)
Dialogue: 0,0:16:03.03,0:16:05.20,Default,,0,0,0,,Құрметпен айтсам, Басшының орынбасары,
Dialogue: 0,0:16:05.20,0:16:08.54,Default,,0,0,0,,Сіз жаңасыз, солай ма?
Dialogue: 0,0:16:08.54,0:16:11.04,Default,,0,0,0,,Ой, атпа, атпа!
Dialogue: 0,0:16:11.04,0:16:15.48,Default,,0,0,0,,Мені атсаң, Хибики Хибики өледі!
Dialogue: 0,0:16:15.48,0:16:20.48,Default,,0,0,0,,Кепілге алынғандар... айтасыз ба? Иә иә
Dialogue: 0,0:16:20.48,0:16:22.65,Default,,0,0,0,,Эй, сен менімен бірге болғың келе ме?
Dialogue: 0,0:16:22.65,0:16:25.32,Default,,0,0,0,,Мен сол кішкентай шабақтан пайдалырақ па?
Dialogue: 0,0:16:25.32,0:16:27.32,Default,,0,0,0,,Раббым!
Dialogue: 0,0:16:27.32,0:16:29.49,Default,,0,0,0,,Сіз мықты болуыңыз керек
Dialogue: 0,0:16:29.49,0:16:33.66,Default,,0,0,0,,Бірақ Хибики Хибики деген қыз мені ұстап тұр.
Dialogue: 0,0:16:33.66,0:16:38.17,Default,,0,0,0,,Хибики-санның пайдалы емес екені рас.
Dialogue: 0,0:16:38.17,0:16:41.34,Default,,0,0,0,,Дұрыс па? Бұл жағдайда…｡ Айтпақшы, сіз➡
Dialogue: 0,0:16:41.34,0:16:43.84,Default,,0,0,0,,Сіз қандай тілегіңізді орындағыңыз келеді?
Dialogue: 0,0:16:43.84,0:16:48.18,Default,,0,0,0,,Ууу, мен үлкен, үлкен кәмпит үйін аламын.
Dialogue: 0,0:16:48.18,0:16:52.02,Default,,0,0,0,,Қуыршаққа айналдырғандардың бәрімен ойнап көңілді болыңыз.
Dialogue: 0,0:16:52.02,0:16:55.69,Default,,0,0,0,,Бұл көңілді сияқты, солай ма?
Dialogue: 0,0:16:55.69,0:16:57.69,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:57.69,0:17:01.36,Default,,0,0,0,,Бір кезде берген уәдемді бұзған сайын➡
Dialogue: 0,0:17:01.36,0:17:04.03,Default,,0,0,0,,Мен жанымды шіруге жол бермеймін.
Dialogue: 0,0:17:04.03,0:17:06.20,Default,,0,0,0,,Желдеткіш…
Dialogue: 0,0:17:06.20,0:17:09.03,Default,,0,0,0,,Солай ма? Содан кейін➡
Dialogue: 0,0:17:09.03,0:17:11.03,Default,,0,0,0,,Сен өлесің!
Dialogue: 0,0:17:11.03,0:17:13.30,Default,,0,0,0,,Ах... (мылтық атылды)
Dialogue: 0,0:17:13.30,0:17:16.14,Default,,0,0,0,,О, бұл дөрекі.
Dialogue: 0,0:17:16.14,0:17:20.31,Default,,0,0,0,,Жарайды, бұл бала тілегіне сай келетін әдіс.
Dialogue: 0,0:17:20.31,0:17:22.31,Default,,0,0,0,,Не?
Dialogue: 0,0:17:22.31,0:17:26.15,Default,,0,0,0,,Сонда сіз не істеуге тырысасыз?
Dialogue: 0,0:17:26.15,0:17:30.82,Default,,0,0,0,,《Мен... бір рет өлдім.
Dialogue: 0,0:17:30.82,0:17:34.99,Default,,0,0,0,,Мен өлдім, бұл дүниеге құладым.
Dialogue: 0,0:17:34.99,0:17:39.66,Default,,0,0,0,,Берілген уәде мен оған себеп болған тілекті орындау үшін.
Dialogue: 0,0:17:39.66,0:17:43.00,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:17:43.00,0:17:47.34,Default,,0,0,0,,Иә... Мен...
Dialogue: 0,0:17:47.34,0:17:52.18,Default,,0,0,0,,Бір өлсең де, екі рет өл
Dialogue: 0,0:17:52.18,0:17:56.35,Default,,0,0,0,,Мен... қайта-қайта➡
Dialogue: 0,0:17:56.35,0:18:01.02,Default,,0,0,0,,Сол адамға ғашық болу
Dialogue: 0,0:18:01.02,0:18:05.52,Default,,0,0,0,,Мен берілмеймін.
Dialogue: 0,0:18:05.52,0:18:10.02,Default,,0,0,0,,Мен ол кісіні қайта көремін.
Dialogue: 0,0:18:18.14,0:18:20.14,Default,,0,0,0,,Атмосфера өзгерді...
Dialogue: 0,0:18:20.14,0:18:22.34,Default,,0,0,0,,Зафукиел
Dialogue: 0,0:18:25.14,0:18:27.14,Default,,0,0,0,,Үлкен сағат
Dialogue: 0,0:18:27.14,0:18:29.65,Default,,0,0,0,,Осы... мүмкін емес
Dialogue: 0,0:18:29.65,0:18:33.15,Default,,0,0,0,,Кихихихихи! Хмм...
Dialogue: 0,0:18:33.15,0:18:35.15,Default,,0,0,0,,Нодока Тойохама, дұрыс…
Dialogue: 0,0:18:35.15,0:18:39.99,Default,,0,0,0,,Өзіңізді тағы да таныстырыңыз. Менің атым Куруми Токисаки.
Dialogue: 0,0:18:39.99,0:18:42.99,Default,,0,0,0,,Шынайы рух болыңыз.
Dialogue: 0,0:18:42.99,0:18:49.33,Default,,0,0,0,,Ах, осы Зафукиелдің арқасында мен өз есімімді әділ айта аламын.
Dialogue: 0,0:18:49.33,0:18:51.34,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:51.34,0:18:56.17,Default,,0,0,0,,Әйтеуір... Әйтеуір, бұл құдірет шынымен де шынайы ➡
Dialogue: 0,0:18:56.17,0:19:01.68,Default,,0,0,0,,Тынымсыз пәлекет: Уақыт пен көлеңкені басқаратын үшінші рух!?
Dialogue: 0,0:19:01.68,0:19:05.35,Default,,0,0,0,,Өте жақсы. Олай болса, Долмастер-сан.
Dialogue: 0,0:19:05.35,0:19:08.52,Default,,0,0,0,,Мен сенімен ойнаймын.
Dialogue: 0,0:19:08.52,0:19:11.19,Default,,0,0,0,,Қарғыс атқыр... Жасай бер! Жаса!
Dialogue: 0,0:19:11.19,0:19:15.46,Default,,0,0,0,,Рухтар сөзсіз жоқ-жоқ. Мен дәлелдеймін!
Dialogue: 0,0:19:15.46,0:19:17.46,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:19:17.46,0:19:19.46,Default,,0,0,0,,Алеф
Dialogue: 0,0:19:23.13,0:19:25.97,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:19:25.97,0:19:30.81,Default,,0,0,0,,Бұл! бұл! Бұл сізге қандай рух?
Dialogue: 0,0:19:30.81,0:19:32.81,Default,,0,0,0,,Ах. (мылтық)
Dialogue: 0,0:19:35.98,0:19:38.15,Default,,0,0,0,,Белгі. Ах...
Dialogue: 0,0:19:38.15,0:19:41.49,Default,,0,0,0,,Жоғалып кетті!?
Dialogue: 0,0:19:41.49,0:19:44.49,Default,,0,0,0,,А... Не... Сонда?
Dialogue: 0,0:19:44.49,0:19:46.82,Default,,0,0,0,,О, байқамадың ба?
Dialogue: 0,0:19:46.82,0:19:52.00,Default,,0,0,0,,Мен жай ғана қалыпты жүріп, артыңыздан бұрылдым.
Dialogue: 0,0:19:52.00,0:19:54.00,Default,,0,0,0,,Дәл осы уақытта➡
Dialogue: 0,0:19:54.00,0:19:57.50,Default,,0,0,0,,Мен сіздің уақытыңызды тоқтаттым.
Dialogue: 0,0:19:57.50,0:19:59.84,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:19:59.84,0:20:05.18,Default,,0,0,0,,Сонда бұл патшайыммен бірдей... рух?
Dialogue: 0,0:20:05.18,0:20:07.18,Default,,0,0,0,,Королева сияқты ма?
Dialogue: 0,0:20:07.18,0:20:09.38,Default,,0,0,0,,Мен осында болдым.
Dialogue: 0,0:20:11.35,0:20:14.35,Default,,0,0,0,,Жалғасы Мен мұны істегім келеді
Dialogue: 0,0:20:14.35,0:20:18.02,Default,,0,0,0,,Хмм...Күтіңіз!
Dialogue: 0,0:20:18.02,0:20:21.53,Default,,0,0,0,,Мен де солай ете аламын ба?
Dialogue: 0,0:20:21.53,0:20:23.53,Default,,0,0,0,,Қуыршақ шебері қайда!
Dialogue: 0,0:20:28.20,0:20:31.20,Default,,0,0,0,,О, мынау мынау.
Dialogue: 0,0:20:31.20,0:20:35.00,Default,,0,0,0,,Бұл мені оларды бір-бірлеп өлтіру қиындығынан құтқарды.
Dialogue: 0,0:20:37.54,0:20:40.04,Default,,0,0,0,,Хахахаха...
Dialogue: 0,0:20:40.04,0:20:42.71,Default,,0,0,0,,《Не істеу керек, не істеу керек, не істеу керек!?
Dialogue: 0,0:20:42.71,0:20:44.72,Default,,0,0,0,,Бұл жоспарланбаған!
Dialogue: 0,0:20:44.72,0:20:48.39,Default,,0,0,0,,Hibiki Hibiki көмегімен өзіңізді құтқару жолын табыңыз!
Dialogue: 0,0:20:48.39,0:20:51.56,Default,,0,0,0,,Бірақ неге ол кенеттен күшті болды? 》
Dialogue: 0,0:20:51.56,0:20:54.22,Default,,0,0,0,,А, бұл оңай.
Dialogue: 0,0:20:54.22,0:20:57.73,Default,,0,0,0,,Шындыққа қарағанда, көрші дүние рухани күшке бай.
Dialogue: 0,0:20:57.73,0:21:02.90,Default,,0,0,0,,Егер ол оны тани алса, Зафукиелді босатады.
Dialogue: 0,0:21:02.90,0:21:04.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:11.24,0:21:13.18,Default,,0,0,0,,Мүмкін бе...? Меніңше, бұл — жыныстық жетілу синдромы.
Dialogue: 0,0:21:13.18,0:21:16.18,Default,,0,0,0,,Парыздың аздап төзгісіз сезімі
Dialogue: 0,0:21:16.18,0:21:20.52,Default,,0,0,0,,Бірнеше минут бұрын кездестірген адаммен ауызша уәде➡
Dialogue: 0,0:21:20.52,0:21:23.19,Default,,0,0,0,,Өзінің болашақ өмірін мұқият қорғау деген нені білдіреді?
Dialogue: 0,0:21:23.19,0:21:25.19,Default,,0,0,0,,Қый!
Dialogue: 0,0:21:25.19,0:21:29.89,Default,,0,0,0,,Бірақ бұл Куруми-санға өте тән, солай емес пе?
Dialogue: 0,0:21:32.86,0:21:35.37,Default,,0,0,0,,Патшайым... неге?
Dialogue: 0,0:21:35.37,0:21:37.37,Default,,0,0,0,,Ол бұл жолы көрінбейді...
Dialogue: 0,0:21:37.37,0:21:42.54,Default,,0,0,0,,Рахмет, Долмастер, мен қалағандай билегеніңіз үшін.
Dialogue: 0,0:21:42.54,0:21:47.38,Default,,0,0,0,,Сіздің ақымақтығыңыздың арқасында оның Safuquiel белсендірілді.
Dialogue: 0,0:21:47.38,0:21:49.55,Default,,0,0,0,,Бұл маңызды➡
Dialogue: 0,0:21:49.55,0:21:51.88,Default,,0,0,0,,Тіпті мен үшін. Бұл...!
Dialogue: 0,0:21:51.88,0:21:53.88,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:21:53.88,0:21:56.48,Default,,0,0,0,,Қый!
Dialogue: 0,0:22:09.90,0:22:11.84,Default,,0,0,0,,Хехе
Dialogue: 0,0:22:11.84,0:22:17.94,Default,,0,0,0,,Куруми мырза, сіз бұрынғыдай талғампаз, керемет және ақылсызсыз.
Dialogue: 0,0:22:22.18,0:22:35.03,Default,,0,0,0,,♪~
Dialogue: 0,0:22:36.53,0:22:42.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory