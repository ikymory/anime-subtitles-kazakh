Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.45,0:00:10.17,Default,,0,0,0,,Мен толқып тұрмын
Dialogue: 0,0:00:10.26,0:00:13.30,Default,,0,0,0,,Имари-санның бөксесі тамаша.
Dialogue: 0,0:00:15.01,0:00:16.85,Default,,0,0,0,,Жақсы Жақсы
Dialogue: 0,0:00:16.85,0:00:18.58,Default,,0,0,0,,Түтік тесігі
Dialogue: 0,0:00:18.72,0:00:20.85,Default,,0,0,0,,Мен оны бөксесімнен сеземін.
Dialogue: 0,0:00:27.77,0:00:29.02,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:00:30.80,0:00:33.20,Default,,0,0,0,,Неліктен бұл жақсы?
Dialogue: 0,0:00:35.45,0:00:36.43,Default,,0,0,0,,Имари
Dialogue: 0,0:00:38.20,0:00:42.12,Default,,0,0,0,,Минасе-кун, Имари-санды әкелгенің үшін рахмет.
Dialogue: 0,0:00:47.10,0:00:49.03,Default,,0,0,0,,Денсаулықтың өзі
Dialogue: 0,0:00:49.78,0:00:51.67,Default,,0,0,0,,Бұл ең жақсы дене
Dialogue: 0,0:00:52.45,0:00:54.26,Default,,0,0,0,,О, тоқтама
Dialogue: 0,0:00:54.26,0:00:55.51,Default,,0,0,0,,Көбірек соғу
Dialogue: 0,0:00:55.51,0:00:57.76,Default,,0,0,0,,Қазір тоқтасам, мен жынды боламын.
Dialogue: 0,0:00:58.70,0:01:00.43,Default,,0,0,0,,Қолыңнан келмейді, балам.
Dialogue: 0,0:01:13.00,0:01:14.44,Default,,0,0,0,,Мен барамын.
Dialogue: 0,0:01:14.44,0:01:15.78,Default,,0,0,0,,Кеттік
Dialogue: 0,0:01:16.29,0:01:17.88,Default,,0,0,0,,Жақсы, Имари-сан.
Dialogue: 0,0:01:17.88,0:01:19.49,Default,,0,0,0,,Барлығына шығыңыз
Dialogue: 0,0:01:19.49,0:01:22.41,Default,,0,0,0,,Минасе-кунның алдында пәк болып қала беремін.
Dialogue: 0,0:01:36.51,0:01:39.47,Default,,0,0,0,,Енді Минасэ-кун да бір қарап алсын.
Dialogue: 0,0:01:39.47,0:01:42.81,Default,,0,0,0,,Сіз өміріңізде бірінші рет қайда барасыз
Dialogue: 0,0:01:42.81,0:01:45.31,Default,,0,0,0,,Минас Минасқа қарап тұр
Dialogue: 0,0:01:46.04,0:01:47.19,Default,,0,0,0,,Имари
Dialogue: 0,0:01:48.42,0:01:49.56,Default,,0,0,0,,Минас
Dialogue: 0,0:01:49.56,0:01:51.36,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:01:51.36,0:01:53.03,Default,,0,0,0,,Кеттік
Dialogue: 0,0:01:53.12,0:01:54.34,Default,,0,0,0,,Имари
Dialogue: 0,0:01:57.91,0:02:00.44,Default,,0,0,0,,Минасэ-кун, менімен бірге жүрші.
Dialogue: 0,0:02:07.25,0:02:08.85,Default,,0,0,0,,Мен саған беремін, Имари-сан.
Dialogue: 0,0:02:10.96,0:02:12.80,Default,,0,0,0,,жүріңіз
Dialogue: 0,0:02:12.80,0:02:14.80,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:02:17.72,0:02:18.84,Default,,0,0,0,,Китами
Dialogue: 0,0:02:20.79,0:02:23.47,Default,,0,0,0,,Китами Имаридің денесін басып алды
Dialogue: 0,0:02:23.71,0:02:25.56,Default,,0,0,0,,Мен шайтанды алдамақшымын
Dialogue: 0,0:02:33.16,0:02:35.32,Default,,0,0,0,,Идиот! Мұндай нәрсе
Dialogue: 0,0:02:35.32,0:02:37.68,Default,,0,0,0,,Ол біледі
Dialogue: 0,0:02:43.93,0:02:45.70,Default,,0,0,0,,Се, Сенсей
Dialogue: 0,0:02:46.14,0:02:48.21,Default,,0,0,0,,Не болды? Такаги мырза
Dialogue: 0,0:02:49.11,0:02:50.46,Default,,0,0,0,,Оны кесу мүмкін емес
Dialogue: 0,0:02:51.11,0:02:54.11,Default,,0,0,0,,Есірткі заттарды көп мөлшерде қабылдауға мәжбүрлеу
Dialogue: 0,0:02:54.61,0:02:57.30,Default,,0,0,0,,Мен есірткіге үйреніп қалуым керек еді.
Dialogue: 0,0:02:59.86,0:03:01.85,Default,,0,0,0,,Иә, тіпті ыстық душ.
Dialogue: 0,0:03:02.22,0:03:02.99,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:03:02.99,0:03:04.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:05.51,0:03:06.89,Default,,0,0,0,,Мені құшақтап ал
Dialogue: 0,0:03:07.33,0:03:09.02,Default,,0,0,0,,Се, Сенсей
Dialogue: 0,0:03:11.14,0:03:13.98,Default,,0,0,0,,Жоқ, егер солай жасасаңыз, бірден
Dialogue: 0,0:03:14.68,0:03:15.98,Default,,0,0,0,,Кеттік
Dialogue: 0,0:03:16.10,0:03:17.09,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:03:21.88,0:03:24.03,Default,,0,0,0,,Минасэ-кун мен оны сезіп тұрмын
Dialogue: 0,0:03:24.09,0:03:25.24,Default,,0,0,0,,Керемет
Dialogue: 0,0:03:25.95,0:03:27.37,Default,,0,0,0,,Мен тағы барамын деп ойлаймын
Dialogue: 0,0:03:31.44,0:03:32.43,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:03:42.50,0:03:45.97,Default,,0,0,0,,Минасэ-кун, мен тағы барамын.
Dialogue: 0,0:03:48.47,0:03:50.54,Default,,0,0,0,,Менің де уақытым келді
Dialogue: 0,0:03:52.65,0:03:54.49,Default,,0,0,0,,Бірге барайық
Dialogue: 0,0:03:54.64,0:03:57.52,Default,,0,0,0,,Оны қалаған жеріңізге қойыңыз
Dialogue: 0,0:04:02.69,0:04:03.70,Default,,0,0,0,,Шығу
Dialogue: 0,0:04:19.32,0:04:21.67,Default,,0,0,0,,Рейка Китами
Dialogue: 0,0:04:28.67,0:04:31.21,Default,,0,0,0,,12 жыл бұрынғыдай Вальпургис
Dialogue: 0,0:04:31.21,0:04:33.04,Default,,0,0,0,,Мен рәсім жасауды жоспарлап отырмын.
Dialogue: 0,0:04:53.69,0:04:56.00,Default,,0,0,0,,Ұстаз, ұйықтай алмайсыз ба?
Dialogue: 0,0:05:02.79,0:05:04.80,Default,,0,0,0,,Се, сэр.
Dialogue: 0,0:05:06.18,0:05:07.55,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:05:12.12,0:05:14.68,Default,,0,0,0,,Минасэ-кунның кереметі
Dialogue: 0,0:05:15.12,0:05:16.39,Default,,0,0,0,,Мықты
Dialogue: 0,0:05:27.64,0:05:29.12,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:05:38.75,0:05:39.90,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:05:39.90,0:05:41.89,Default,,0,0,0,,Өтінемін, Минасе-кун
Dialogue: 0,0:05:43.03,0:05:44.59,Default,,0,0,0,,Медицина
Dialogue: 0,0:05:44.59,0:05:46.05,Default,,0,0,0,,Бұл кесілген жоқ, солай ма?
Dialogue: 0,0:06:19.94,0:06:21.29,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:06:21.60,0:06:22.63,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:06:57.43,0:06:59.41,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:07:09.80,0:07:11.09,Default,,0,0,0,,жүріңіз
Dialogue: 0,0:07:52.12,0:07:52.97,Default,,0,0,0,,Имари
Dialogue: 0,0:08:30.40,0:08:31.44,Default,,0,0,0,,Имари
Dialogue: 0,0:08:40.16,0:08:41.11,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:08:42.12,0:08:43.94,Default,,0,0,0,,Шираки
Dialogue: 0,0:08:48.70,0:08:50.07,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:09:00.52,0:09:01.90,Default,,0,0,0,,Шираки
Dialogue: 0,0:09:02.30,0:09:04.12,Default,,0,0,0,,Минасе-кун, бұл қорқынышты.
Dialogue: 0,0:09:04.56,0:09:07.50,Default,,0,0,0,,Маған тек Минасэ-кун ұнаса да
Dialogue: 0,0:09:09.47,0:09:13.17,Default,,0,0,0,,Мен оны жақсы көрсем де
Dialogue: 0,0:09:15.64,0:09:19.93,Default,,0,0,0,,Минасе-кун, мені басқа біреу құшақтап алса, қарсы емеспін.
Dialogue: 0,0:09:20.21,0:09:23.27,Default,,0,0,0,,Сен маған кеше де бірден көмектеспедің.
Dialogue: 0,0:09:23.76,0:09:26.58,Default,,0,0,0,,Оның үстіне мен жаңа ғана үйге қайттым.
Dialogue: 0,0:09:26.58,0:09:28.73,Default,,0,0,0,,Минасе-кунның төсегінде
Dialogue: 0,0:09:33.60,0:09:36.32,Default,,0,0,0,,Такаджо мырза ше?
Dialogue: 0,0:09:37.43,0:09:39.12,Default,,0,0,0,,Өйткені
Dialogue: 0,0:09:43.88,0:09:45.50,Default,,0,0,0,,Минасэ-кун өтінемін
Dialogue: 0,0:09:45.72,0:09:46.98,Default,,0,0,0,,Шығып бара жатырсың ба?
Dialogue: 0,0:09:46.98,0:09:49.11,Default,,0,0,0,,Мені тағы бір рет ұстаңыз
Dialogue: 0,0:10:35.21,0:10:36.88,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:10:44.49,0:10:46.25,Default,,0,0,0,,Минасе-кундікі
Dialogue: 0,0:10:46.41,0:10:49.02,Default,,0,0,0,,Әдеттегіден үлкенірек және ыстық
Dialogue: 0,0:11:10.39,0:11:11.71,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:11:36.34,0:11:37.82,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:11:37.82,0:11:39.89,Default,,0,0,0,,Бар, бар, бар
Dialogue: 0,0:11:39.89,0:11:41.65,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:11:46.79,0:11:47.79,Default,,0,0,0,,Шығу\NМен
Dialogue: 0,0:11:47.79,0:11:50.91,Default,,0,0,0,,Көптеген ыстық заттар келеді.
Dialogue: 0,0:11:52.27,0:11:54.00,Default,,0,0,0,,Барлығы
Dialogue: 0,0:11:54.00,0:11:55.84,Default,,0,0,0,,Маған бәрін беріңіз
Dialogue: 0,0:12:02.68,0:12:04.47,Default,,0,0,0,,Рахмет, Минасэ-кун
Dialogue: 0,0:12:05.68,0:12:07.14,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:12:07.75,0:12:09.14,Default,,0,0,0,,Тоқта, Шираки-сан.
Dialogue: 0,0:12:16.58,0:12:18.69,Default,,0,0,0,,...
Dialogue: 0,0:12:20.40,0:12:22.20,Default,,0,0,0,,тетораграмматон садай
Dialogue: 0,0:12:34.61,0:12:35.83,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:12:35.98,0:12:38.38,Default,,0,0,0,,Такаги мырза
Dialogue: 0,0:12:40.38,0:12:41.51,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:12:45.76,0:12:48.81,Default,,0,0,0,,...
Dialogue: 0,0:12:52.01,0:12:53.85,Default,,0,0,0,,Сә, сэр.
Dialogue: 0,0:12:54.57,0:12:57.76,Default,,0,0,0,,Өткен жолы мені таң қалдырды, сондықтан ештеңе істей алмадым.
Dialogue: 0,0:14:07.76,0:14:10.51,Default,,0,0,0,,Құрбандық үстелі мен құрбандықтарды тазалаңыз
Dialogue: 0,0:14:10.51,0:14:12.26,Default,,0,0,0,,Тостағанды толтыр
Dialogue: 0,0:14:55.12,0:14:58.10,Default,,0,0,0,,*Қандағы Әкеміз
Dialogue: 0,0:15:03.17,0:15:05.98,Default,,0,0,0,,Кел, Ием!
Dialogue: 0,0:15:07.72,0:15:10.15,Default,,0,0,0,,Сен менің Құдайымсың
Dialogue: 0,0:15:14.64,0:15:15.95,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:15:15.95,0:15:17.95,Default,,0,0,0,,Минасе-кун, сабыр ет.
Dialogue: 0,0:15:18.12,0:15:19.75,Default,,0,0,0,,Бәріне мен кінәлімін
Dialogue: 0,0:15:19.75,0:15:20.92,Default,,0,0,0,,Менің
Dialogue: 0,0:15:21.48,0:15:24.59,Default,,0,0,0,,Мен осындай нәрседен жаңылдым.
Dialogue: 0,0:15:25.19,0:15:27.92,Default,,0,0,0,,Мен қарапайым ағашты шатастырдым.
Dialogue: 0,0:15:28.45,0:15:29.46,Default,,0,0,0,,Имари
Dialogue: 0,0:15:29.99,0:15:31.76,Default,,0,0,0,,Мен Имариді жақсы көремін
Dialogue: 0,0:15:44.96,0:15:47.23,Default,,0,0,0,,Қайдасың, Имари?
Dialogue: 0,0:15:47.55,0:15:50.24,Default,,0,0,0,,Мектеп жертөлесі шығар
Dialogue: 0,0:15:52.49,0:15:55.15,Default,,0,0,0,,Күте тұрыңыз! Мен кешегідей жағдайға тап боламын
Dialogue: 0,0:15:57.03,0:15:59.91,Default,,0,0,0,,Иә! Ұстаз, маған күш беріңізші
Dialogue: 0,0:16:00.31,0:16:02.33,Default,,0,0,0,,Мұғалімнің сиқырымен Китами
Dialogue: 0,0:16:02.33,0:16:04.29,Default,,0,0,0,,Менің білуімше
Dialogue: 0,0:16:04.29,0:16:06.92,Default,,0,0,0,,Китами нағыз жынның күшін алады.
Dialogue: 0,0:16:07.28,0:16:08.59,Default,,0,0,0,,Бұл мүлдем жарамсыз.
Dialogue: 0,0:16:10.47,0:16:12.80,Default,,0,0,0,,Рәсім түн ортасында өтуі керек.
Dialogue: 0,0:16:13.41,0:16:16.95,Default,,0,0,0,,Ең болмаса оған дейін Имаридің өміріне қауіп төнбейді.
Dialogue: 0,0:16:19.94,0:16:21.02,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:16:21.33,0:16:22.69,Default,,0,0,0,,Маған сенің көмегің керек.
Dialogue: 0,0:16:24.89,0:16:28.57,Default,,0,0,0,,Шығу жолын ашудың кілті бар.
Dialogue: 0,0:16:32.47,0:16:34.53,Default,,0,0,0,,Мұнда не жазылған
Dialogue: 0,0:16:35.72,0:16:37.16,Default,,0,0,0,,Тыйым салынған заклинание
Dialogue: 0,0:16:37.31,0:16:39.45,Default,,0,0,0,,Тыйым салынған заклинание?
Dialogue: 0,0:16:39.69,0:16:43.16,Default,,0,0,0,,Баяғыда көргенімде, ондай қан жоқ екен.
Dialogue: 0,0:16:43.69,0:16:47.21,Default,,0,0,0,,Менің ойымша, бұл 12 жыл бұрын салтанатты рәсімде киілген болуы мүмкін.
Dialogue: 0,0:16:48.36,0:16:52.05,Default,,0,0,0,,Оны оқу өте қиын, бірақ бақытыма орай мен емлені әрең оқимын.
Dialogue: 0,0:16:52.53,0:16:55.26,Default,,0,0,0,,Әріптер әлсіз көрінетін басқа да жерлер бар.
Dialogue: 0,0:16:55.79,0:16:57.43,Default,,0,0,0,,Бірақ бәрі осы
Dialogue: 0,0:16:57.43,0:16:59.89,Default,,0,0,0,,Осыны есте сақтау қабілетіммен біріктіру
Dialogue: 0,0:17:00.79,0:17:02.77,Default,,0,0,0,,Мұғалімнің есте сақтау қабілеті?
Dialogue: 0,0:17:03.38,0:17:05.85,Default,,0,0,0,,Иә, бұл жалғыз шайтан
Dialogue: 0,0:17:06.13,0:17:08.61,Default,,0,0,0,,Рейка Китамимен қалай бәсекелесуге болады
Dialogue: 0,0:17:09.31,0:17:11.01,Default,,0,0,0,,Китамиді жеңудің қажеті жоқ.
Dialogue: 0,0:17:11.22,0:17:14.53,Default,,0,0,0,,Рәсімге тосқауыл қойса, уақыты таусылып, өзін құртады.
Dialogue: 0,0:17:15.10,0:17:16.66,Default,,0,0,0,,Мұғалім Мошимо
Dialogue: 0,0:17:16.66,0:17:18.24,Default,,0,0,0,,Егер оны тоқтату мүмкін болмаса ше?
Dialogue: 0,0:17:19.31,0:17:21.70,Default,,0,0,0,,Китами Имаридің денесін алады
Dialogue: 0,0:17:22.35,0:17:25.00,Default,,0,0,0,,Имари-сан Китамидің орнына келеді.
Dialogue: 0,0:17:25.27,0:17:28.79,Default,,0,0,0,,Китамидің күнәсін көтеріп тозаққа түсу
Dialogue: 0,0:17:37.07,0:17:39.85,Default,,0,0,0,,Бүгін түнде Вальпурги түні
Dialogue: 0,0:17:40.33,0:17:44.43,Default,,0,0,0,,Мен бұл қарғыс атқан денені тастап, қайта туамын.
Dialogue: 0,0:17:45.17,0:17:47.65,Default,,0,0,0,,Ритуал аяқталғанда,
Dialogue: 0,0:17:47.65,0:17:51.23,Default,,0,0,0,,*Табиғи сұрыпталу жоқ бұл іріңдеген дүние
Dialogue: 0,0:17:51.23,0:17:53.28,Default,,0,0,0,,Мен тазартамын
Dialogue: 0,0:17:53.28,0:17:54.65,Default,,0,0,0,,Кейін
Dialogue: 0,0:17:54.86,0:17:59.42,Default,,0,0,0,,Мен Аянның Мыңжылдық Патшасы ретінде жер бетінде билік жүргіземін.
Dialogue: 0,0:17:59.66,0:18:02.41,Default,,0,0,0,,Таңдаулы халық боласыңдар
Dialogue: 0,0:18:03.20,0:18:05.58,Default,,0,0,0,,Осы жоғары мақсат үшін
Dialogue: 0,0:18:05.58,0:18:08.33,Default,,0,0,0,,Мен жаңа денені аламын
Dialogue: 0,0:18:08.77,0:18:10.42,Default,,0,0,0,,Рәсімді бастайық
Dialogue: 0,0:18:22.64,0:18:24.81,Default,,0,0,0,,Мұғалімнің уақыты
Dialogue: 0,0:18:25.00,0:18:27.98,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе және берілме, Минасэ-кун
Dialogue: 0,0:18:34.09,0:18:38.40,Default,,0,0,0,,eiehay eiheyaja eiehay ado түн
Dialogue: 0,0:18:39.66,0:18:44.16,Default,,0,0,0,,...
Dialogue: 0,0:18:46.12,0:18:47.46,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:18:49.66,0:18:51.33,Default,,0,0,0,,ағура аумин
Dialogue: 0,0:18:53.46,0:18:55.21,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:56.74,0:18:57.88,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:18:57.88,0:19:00.26,Default,,0,0,0,,Тағы біраз күтіңіз
Dialogue: 0,0:19:02.07,0:19:03.10,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:03.43,0:19:06.02,Default,,0,0,0,,Китами мырза, тоқтатыңыз.
Dialogue: 0,0:19:09.00,0:19:10.48,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:16.97,0:19:19.78,Default,,0,0,0,,Бұл дене менікі болады.
Dialogue: 0,0:19:33.06,0:19:35.38,Default,,0,0,0,,Сен әдемісің, Имари-сан.
Dialogue: 0,0:19:41.70,0:19:43.68,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:48.74,0:19:49.89,Default,,0,0,0,,Имари
Dialogue: 0,0:19:55.36,0:19:59.16,Default,,0,0,0,,Енді, асыл тазалығың
Dialogue: 0,0:19:59.16,0:20:01.36,Default,,0,0,0,,Мен оны сізге аламын.
Dialogue: 0,0:20:01.36,0:20:02.91,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:20:02.91,0:20:05.16,Default,,0,0,0,,Мен енді қорықпаймын
Dialogue: 0,0:20:05.16,0:20:07.16,Default,,0,0,0,,Бір сәтке ғана ауырады
Dialogue: 0,0:20:08.41,0:20:10.25,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:20:10.25,0:20:11.96,Default,,0,0,0,,Мені өлтірме
Dialogue: 0,0:20:11.96,0:20:13.58,Default,,0,0,0,,Соңында
Dialogue: 0,0:20:14.15,0:20:16.20,Default,,0,0,0,,Бұл денемен қоштасу
Dialogue: 0,0:20:16.20,0:20:18.92,Default,,0,0,0,,Өтінемін, тоқтаңыз.
Dialogue: 0,0:20:20.32,0:20:22.01,Default,,0,0,0,,Өкінішке орай, мен көмектесе алмаймын. Кешіріңіз.
Dialogue: 0,0:20:22.01,0:20:23.38,Default,,0,0,0,,Толық қараңғылықта
Dialogue: 0,0:20:23.93,0:20:25.51,Default,,0,0,0,,Мен тосқауыл қойып жатырмын.
Dialogue: 0,0:20:26.16,0:20:27.18,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:20:32.83,0:20:35.31,Default,,0,0,0,,...
Dialogue: 0,0:20:37.52,0:20:38.79,Default,,0,0,0,,Енді менің L екенім әлі ашылмағандықтан, егер Нагаре өлсе,
Dialogue: 0,0:21:21.75,0:21:26.20,Default,,0,0,0,,*Аа, досымнан гөрі жігітім артық.
Dialogue: 0,0:21:27.23,0:21:30.16,Default,,0,0,0,,Мен де жақын арада жігіт тапқым келеді.
Dialogue: 0,0:21:36.31,0:21:37.53,Default,,0,0,0,,Кім?
Dialogue: 0,0:21:50.71,0:21:52.43,Default,,0,0,0,,Сіз бәрібір келдіңіз.
Dialogue: 0,0:21:57.75,0:21:59.15,Default,,0,0,0,,Саэки
Dialogue: 0,0:21:59.34,0:22:02.07,Default,,0,0,0,,Әпкең ескертсе де.
Dialogue: 0,0:22:02.43,0:22:03.86,Default,,0,0,0,,Ақымақ адамдар
Dialogue: 0,0:22:03.86,0:22:06.53,Default,,0,0,0,,Саэки-сан, біз асығып жатырмыз.
Dialogue: 0,0:22:07.01,0:22:08.28,Default,,0,0,0,,Маған рұқсат бере аласыз ба?
Dialogue: 0,0:22:08.28,0:22:10.62,Default,,0,0,0,,Мен мұны істеуге рұқсат етемін деп ойлайсыз ба?
Dialogue: 0,0:22:11.84,0:22:14.29,Default,,0,0,0,,juisrhufshe jepolkdonom
Dialogue: 0,0:22:14.73,0:22:16.37,Default,,0,0,0,,Минасэ-кун, артқа тұр.
Dialogue: 0,0:22:17.75,0:22:20.92,Default,,0,0,0,,...
Dialogue: 0,0:23:13.25,0:23:15.97,Default,,0,0,0,,Астарот, Асмодей
Dialogue: 0,0:23:15.97,0:23:17.98,Default,,0,0,0,,*Менің ханзадаларым
Dialogue: 0,0:23:18.51,0:23:20.98,Default,,0,0,0,,Және менің мырзам Люцифер
Dialogue: 0,0:23:21.46,0:23:23.77,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:23:23.77,0:23:25.15,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:23:25.15,0:23:26.94,Default,,0,0,0,,Бұл қалыпты емес.
Dialogue: 0,0:23:26.94,0:23:31.11,Default,,0,0,0,,*Мен сізді осы құрбандық баланы қабылдауға шақырамын.
Dialogue: 0,0:23:31.81,0:23:35.33,Default,,0,0,0,,Бұл қанды қалауымның құны ретінде ұсынамын.
Dialogue: 0,0:23:37.49,0:23:41.33,Default,,0,0,0,,...
Dialogue: 0,0:23:42.23,0:23:44.79,Default,,0,0,0,,...
Dialogue: 0,0:23:45.91,0:23:46.80,Default,,0,0,0,,Минас
Dialogue: 0,0:23:48.41,0:23:52.05,Default,,0,0,0,,Басыңызды көтеріңіз. Мәңгілік есік, көтеріл (Забур 24:7)
Dialogue: 0,0:23:52.09,0:23:54.30,Default,,0,0,0,,Даңқ патшасы кіреді
Dialogue: 0,0:23:54.30,0:23:57.60,Default,,0,0,0,,Сабат патшасы Бафомет, қабыл алыңыз.
Dialogue: 0,0:23:58.08,0:24:03.02,Default,,0,0,0,,*Мен сұрағанымдай, тән түрмесінің мәңгілік азабынан құтыл.
Dialogue: 0,0:24:03.02,0:24:05.15,Default,,0,0,0,,Минас
Dialogue: 0,0:24:08.95,0:24:11.40,Default,,0,0,0,,Құдайға мойынсұнбаған жиіркенішті шайтан.
Dialogue: 0,0:24:11.47,0:24:14.91,Default,,0,0,0,,Бұл жерді тастап кетуіңе тілектеспін
Dialogue: 0,0:24:15.18,0:24:16.99,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:24:20.00,0:24:21.12,Default,,0,0,0,,Минас
Dialogue: 0,0:24:21.12,0:24:23.58,Default,,0,0,0,,Ақымақ, кеш болып қалды.
Dialogue: 0,0:24:23.58,0:24:26.13,Default,,0,0,0,,Менің онда не істеп жатқанымды қараңыз.
Dialogue: 0,0:24:26.49,0:24:29.02,Default,,0,0,0,,Мен сені ырым біткен бойда өлтіремін.
Dialogue: 0,0:24:29.02,0:24:30.30,Default,,0,0,0,,Ол әлі оралмады ма?
Dialogue: 0,0:24:31.62,0:24:35.55,Default,,0,0,0,,Аматсу патшалығының қақпасының күзетшісі, қақпасының күзетшісі.
Dialogue: 0,0:24:35.95,0:24:38.26,Default,,0,0,0,,Мен Үшбірліктің періштесімін
Dialogue: 0,0:24:38.26,0:24:40.56,Default,,0,0,0,,Және көптеген құпиялардың атымен
Dialogue: 0,0:24:40.56,0:24:42.35,Default,,0,0,0,,Оркустың қақпасын жабыңыз
Dialogue: 0,0:24:43.17,0:24:44.85,Default,,0,0,0,,Әлі де сенімді емессіз бе?
Dialogue: 0,0:24:45.17,0:24:48.11,Default,,0,0,0,,Сенің сиқырың маған әсер етпейді.
Dialogue: 0,0:24:49.02,0:24:50.02,Default,,0,0,0,,Минас
Dialogue: 0,0:24:50.34,0:24:52.57,Default,,0,0,0,,Мен Үшбірліктің періштесімін
Dialogue: 0,0:24:52.57,0:24:55.03,Default,,0,0,0,,Және көптеген құпиялардың атымен
Dialogue: 0,0:24:59.22,0:25:00.45,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:25:07.60,0:25:09.20,Default,,0,0,0,,Жоқ, қазір не болды?
Dialogue: 0,0:25:09.31,0:25:12.51,Default,,0,0,0,,Көңілді болған соң, мені өлтіруді бұйырдым.
Dialogue: 0,0:25:13.42,0:25:15.58,Default,,0,0,0,,Мен көмекке баруым керек пе?
Dialogue: 0,0:25:15.99,0:25:17.30,Default,,0,0,0,,Өзіңізді ақымақ етпеңіз
Dialogue: 0,0:25:18.13,0:25:19.67,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:25:19.67,0:25:23.48,Default,,0,0,0,,Менде дәл қазір иллюзия көрсету сәні жоқ.
Dialogue: 0,0:25:41.07,0:25:42.16,Default,,0,0,0,,Жоқ
Dialogue: 0,0:25:42.46,0:25:43.50,Default,,0,0,0,,Жоқ
Dialogue: 0,0:25:44.25,0:25:47.04,Default,,0,0,0,,Жоқ, мені кешіріңіз
Dialogue: 0,0:25:56.43,0:25:58.72,Default,,0,0,0,,Мен де шарасызмын
Dialogue: 0,0:26:01.92,0:26:04.78,Default,,0,0,0,,Үйге қайт.
Dialogue: 0,0:26:07.17,0:26:09.82,Default,,0,0,0,,Мен сізге ешқашан кедергі жасамаймын
Dialogue: 0,0:26:13.79,0:26:14.91,Default,,0,0,0,,Минас
Dialogue: 0,0:26:15.26,0:26:16.49,Default,,0,0,0,,Минас
