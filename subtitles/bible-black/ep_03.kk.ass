Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.38,0:00:12.84,Default,,0,0,0,,Мен сенің жүзіңді көргенде
Dialogue: 0,0:00:13.76,0:00:15.95,Default,,0,0,0,,Егер мен сенің даусыңды естісем, мен болар едім
Dialogue: 0,0:00:16.01,0:00:18.01,Default,,0,0,0,,Мен кері бұрылатындай сезінемін.
Dialogue: 0,0:00:33.91,0:00:34.95,Default,,0,0,0,,Имари
Dialogue: 0,0:01:04.48,0:01:05.95,Default,,0,0,0,,Кеш болды, солай емес пе?
Dialogue: 0,0:01:06.55,0:01:07.69,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:25.02,0:01:26.96,Default,,0,0,0,,Иә, Минасэ-кун.
Dialogue: 0,0:01:27.44,0:01:29.17,Default,,0,0,0,,Су шабуылы?
Dialogue: 0,0:01:29.17,0:01:31.30,Default,,0,0,0,,Ортағасырлық бақсы аңы сияқты естіледі.
Dialogue: 0,0:01:33.21,0:01:34.46,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:01:35.28,0:01:36.72,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:01:36.72,0:01:38.14,Default,,0,0,0,,Такаджо мырза
Dialogue: 0,0:02:03.40,0:02:04.58,Default,,0,0,0,,Тоқта
Dialogue: 0,0:02:05.59,0:02:07.40,Default,,0,0,0,,Мұғалім керемет.
Dialogue: 0,0:02:07.40,0:02:09.04,Default,,0,0,0,,Көбірек келеді.
Dialogue: 0,0:02:10.65,0:02:12.75,Default,,0,0,0,,Өтінемін, Минасе-кун
Dialogue: 0,0:02:13.03,0:02:14.42,Default,,0,0,0,,Оны тоқтатыңыз.
Dialogue: 0,0:02:27.06,0:02:28.60,Default,,0,0,0,,Менің асқазаным
Dialogue: 0,0:02:28.88,0:02:30.65,Default,,0,0,0,,Асқазанның бөлінуі
Dialogue: 0,0:02:32.05,0:02:33.52,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:02:34.76,0:02:36.57,Default,,0,0,0,,Маған көбірек беріңіз.
Dialogue: 0,0:02:37.66,0:02:41.11,Default,,0,0,0,,Адам ағзасы оңайлықпен бұзылмайды.
Dialogue: 0,0:02:42.32,0:02:44.03,Default,,0,0,0,,*Адам рухы да.
Dialogue: 0,0:02:44.90,0:02:47.37,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:02:48.94,0:02:51.12,Default,,0,0,0,,Бұл қызық, солай ма?
Dialogue: 0,0:02:59.03,0:03:03.18,Default,,0,0,0,,Адамдардың қараңғылыққа түскенін қанша көрсем де, одан жалықпаймын.
Dialogue: 0,0:03:03.50,0:03:07.13,Default,,0,0,0,,Ауырғаннан бұрмаланған жүз, ләззатқа батып бара жатқан біреудің беті.
Dialogue: 0,0:03:07.37,0:03:11.14,Default,,0,0,0,,Басқа өнер туындыларына қарағанда жүрегімді баурап алады.
Dialogue: 0,0:03:13.28,0:03:15.11,Default,,0,0,0,,Артық емес.
Dialogue: 0,0:03:15.11,0:03:16.40,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:03:17.18,0:03:18.62,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:03:18.62,0:03:20.11,Default,,0,0,0,,Оны қосыңыз.
Dialogue: 0,0:03:20.24,0:03:21.45,Default,,0,0,0,,Иә, сэр.
Dialogue: 0,0:03:32.66,0:03:34.49,Default,,0,0,0,,Минасэ-кун, тоқтат!
Dialogue: 0,0:03:35.15,0:03:36.24,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:03:36.31,0:03:38.21,Default,,0,0,0,,Мен сізді ішке кіргіземін, Такаджо мырза.
Dialogue: 0,0:03:38.91,0:03:40.17,Default,,0,0,0,,No
Dialogue: 0,0:03:51.10,0:03:52.60,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:03:53.50,0:03:54.60,Default,,0,0,0,,Тоқта
Dialogue: 0,0:03:55.09,0:03:56.09,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:04:12.70,0:04:13.58,Default,,0,0,0,,Тығыз
Dialogue: 0,0:04:13.58,0:04:15.46,Default,,0,0,0,,*? ? ) Мен мұғаліммін.
Dialogue: 0,0:04:20.29,0:04:25.05,Default,,0,0,0,,Әй, мен оны оқушымның есегіне салып жіберейін деп жатырмын.
Dialogue: 0,0:04:25.49,0:04:27.97,Default,,0,0,0,,Сіз ең нашар мұғалімсіз.
Dialogue: 0,0:04:29.84,0:04:31.35,Default,,0,0,0,,Жынды
Dialogue: 0,0:04:32.68,0:04:35.15,Default,,0,0,0,,Иә, сен жындысың.
Dialogue: 0,0:04:35.50,0:04:37.98,Default,,0,0,0,,Бұл дүние қазір ессіз.
Dialogue: 0,0:04:37.98,0:04:41.49,Default,,0,0,0,,Адам кейпіндегі жын-перілер жер-жерде жүр.
Dialogue: 0,0:04:41.49,0:04:44.28,Default,,0,0,0,,Адамдар мұны мойындағысы келмейді
Dialogue: 0,0:04:44.28,0:04:47.16,Default,,0,0,0,,Бұл дүниені Құдай тастап кетті.
Dialogue: 0,0:04:47.16,0:04:50.91,Default,,0,0,0,,*Әрбір адам бұзатын (??) және өлім күнәларын жасай беретін екіжүзді.
Dialogue: 0,0:04:51.55,0:04:55.58,Default,,0,0,0,,Мен сияқтылар мұндай дүниеге жарасады.
Dialogue: 0,0:04:56.15,0:04:59.42,Default,,0,0,0,,Бұл әлемге қазір нағыз шайтан керек
Dialogue: 0,0:04:59.84,0:05:02.01,Default,,0,0,0,,О, сен кімсің?
Dialogue: 0,0:05:02.34,0:05:06.38,Default,,0,0,0,,Мен шайтанмен 12 жыл бұрын қосылдым.
Dialogue: 0,0:05:06.88,0:05:09.17,Default,,0,0,0,,Ендеше, бұл бекер емес.
Dialogue: 0,0:05:09.60,0:05:11.25,Default,,0,0,0,,Неге олай дейсің?
Dialogue: 0,0:05:12.93,0:05:14.14,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:05:14.14,0:05:16.44,Default,,0,0,0,,Сіз сол сиқырлы шеңберден аман қалдыңыз ба?
Dialogue: 0,0:05:20.49,0:05:22.46,Default,,0,0,0,,Минасэ-кун, жылжытыңыз.
Dialogue: 0,0:05:24.03,0:05:25.03,Default,,0,0,0,,Иә
Dialogue: 0,0:05:27.17,0:05:28.48,Default,,0,0,0,,Жоқ, тоқтатыңыз.
Dialogue: 0,0:05:28.48,0:05:30.58,Default,,0,0,0,,Минасе Минасе-кун
Dialogue: 0,0:05:31.62,0:05:34.08,Default,,0,0,0,,Солай емес пе? жауап
Dialogue: 0,0:05:34.98,0:05:36.54,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:36.86,0:05:39.13,Default,,0,0,0,,Мен сол шеңбердің мүшесі болдым.
Dialogue: 0,0:05:39.56,0:05:40.76,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:05:40.76,0:05:42.67,Default,,0,0,0,,Мен сізді танымаймын
Dialogue: 0,0:05:43.15,0:05:44.55,Default,,0,0,0,,Әрине
Dialogue: 0,0:05:44.55,0:05:47.50,Default,,0,0,0,,Менің ол шеңберге қатысым жоқ.
Dialogue: 0,0:05:47.50,0:05:49.97,Default,,0,0,0,,Менде сиқырға қызығушылық болған жоқ.
Dialogue: 0,0:05:50.50,0:05:51.89,Default,,0,0,0,,Сонда неге?
Dialogue: 0,0:05:53.99,0:05:55.23,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:58.58,0:06:00.44,Default,,0,0,0,,Мен барамын, мұғалім!
Dialogue: 0,0:06:01.53,0:06:03.15,Default,,0,0,0,,Минасе-кун, мені сыртқа шығармашы.
Dialogue: 0,0:06:03.15,0:06:05.53,Default,,0,0,0,,Ішіне басқа ештеңе салмаңыз.
Dialogue: 0,0:06:05.53,0:06:06.99,Default,,0,0,0,,Мен темекі шегуді тастадым
Dialogue: 0,0:06:22.76,0:06:25.17,Default,,0,0,0,,Маған жуынатын бөлмеге баруға рұқсат етіңізші.
Dialogue: 0,0:06:26.03,0:06:27.13,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:06:27.13,0:06:29.26,Default,,0,0,0,,Дәлізден шыққан бойда оң жақтағы есік.
Dialogue: 0,0:06:35.34,0:06:36.59,Default,,0,0,0,,Қандай ұят.
Dialogue: 0,0:06:36.59,0:06:38.56,Default,,0,0,0,,Өліп бара жатқан бақа сияқты
Dialogue: 0,0:06:38.56,0:06:41.02,Default,,0,0,0,,Мен бәріңді бірден талқандағым келеді.
Dialogue: 0,0:06:44.01,0:06:45.98,Default,,0,0,0,,Тоқта, мен кетемін.
Dialogue: 0,0:07:01.30,0:07:02.96,Default,,0,0,0,,*? ? Бұл жақсы тесік
Dialogue: 0,0:07:03.04,0:07:04.75,Default,,0,0,0,,*Сіз бірден әрекет етесіз.
Dialogue: 0,0:07:05.61,0:07:07.13,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:08.38,0:07:12.39,Default,,0,0,0,,Бөкселеріңізде тығын жоқ, сондықтан оны өзіңіз қатайтыңыз.
Dialogue: 0,0:07:12.58,0:07:13.93,Default,,0,0,0,,Оның қуыршаққа айналдырған рухтары да керемет екенін естідім.
Dialogue: 0,0:07:13.93,0:07:16.06,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:07:16.06,0:07:18.06,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:07:26.86,0:07:27.98,Default,,0,0,0,,Бұл орын алатын сияқты
Dialogue: 0,0:07:27.98,0:07:29.32,Default,,0,0,0,,Көп берейік
Dialogue: 0,0:07:31.70,0:07:33.07,Default,,0,0,0,,Саған іші ұнамай ма?
Dialogue: 0,0:07:34.85,0:07:36.95,Default,,0,0,0,,Олай болса, мен сенің ішіңе кіруге рұқсат ет.
Dialogue: 0,0:07:57.12,0:08:00.23,Default,,0,0,0,,...
Dialogue: 0,0:08:00.67,0:08:02.73,Default,,0,0,0,,...
Dialogue: 0,0:08:03.30,0:08:05.61,Default,,0,0,0,,Құрбандыққа шалынатын қой
Dialogue: 0,0:08:05.61,0:08:09.15,Default,,0,0,0,,Сен зұлым рухтарға қарсы күштің тірегісің
Dialogue: 0,0:08:12.32,0:08:14.36,Default,,0,0,0,,Еу өлтірілді
Dialogue: 0,0:08:14.56,0:08:18.66,Default,,0,0,0,,Маған қараңғылық құдайларына билік бер.
Dialogue: 0,0:08:19.69,0:08:21.62,Default,,0,0,0,,Құрбандыққа шалынатын қой
Dialogue: 0,0:08:21.94,0:08:26.79,Default,,0,0,0,,Маған бүлікші жындарды тежеу үшін күш бер.
Dialogue: 0,0:08:32.20,0:08:37.30,Default,,0,0,0,,Ах, құтқарушы жанның құрбандығы, Аматсу патшалығының қақпасын ашқан адам.
Dialogue: 0,0:08:37.63,0:08:40.10,Default,,0,0,0,,Қақпаларыңызды ашыңыз
Dialogue: 0,0:08:40.10,0:08:41.93,Default,,0,0,0,,Сіздің ханзадаларыңыз
Dialogue: 0,0:08:41.93,0:08:44.19,Default,,0,0,0,,Мәңгілік есігін аш
Dialogue: 0,0:08:44.46,0:08:47.19,Default,,0,0,0,,Даңқ патшасы кіреді
Dialogue: 0,0:08:48.17,0:08:51.03,Default,,0,0,0,,Мәңгілік Патша – Құдіретті Патша
Dialogue: 0,0:08:51.13,0:08:53.61,Default,,0,0,0,,Жаратқан Ие – Даңқ Патшасы
Dialogue: 0,0:08:54.23,0:08:56.95,Default,,0,0,0,,Әкеге, Ұлға және Киелі Рухқа даңқ
Dialogue: 0,0:08:58.24,0:09:01.83,Default,,0,0,0,,...
Dialogue: 0,0:09:02.70,0:09:06.25,Default,,0,0,0,,...
Dialogue: 0,0:09:06.25,0:09:09.47,Default,,0,0,0,,...
Dialogue: 0,0:09:09.75,0:09:12.84,Default,,0,0,0,,...
Dialogue: 0,0:09:13.11,0:09:16.09,Default,,0,0,0,,...
Dialogue: 0,0:09:15.58,0:09:17.84,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:20.78,0:09:21.72,Default,,0,0,0,,Күлкілі
Dialogue: 0,0:09:21.72,0:09:24.06,Default,,0,0,0,,Оркустың қақпасы толық ашылмайды.
Dialogue: 0,0:09:24.24,0:09:26.02,Default,,0,0,0,,Мен бірдеңені дұрыс істемедім бе?
Dialogue: 0,0:09:26.21,0:09:27.44,Default,,0,0,0,,(Бұрынғы патша) Мұндай даналыққа ие адам міндетті түрде бар.
Dialogue: 0,0:09:27.44,0:09:29.86,Default,,0,0,0,,Кітап бойынша дәл орындадым, қателескен жоқпын.
Dialogue: 0,0:09:30.12,0:09:31.24,Default,,0,0,0,,Сонда неге?
Dialogue: 0,0:09:31.24,0:09:32.98,Default,,0,0,0,,Сәтсіздік? Не істеу керек?
Dialogue: 0,0:09:32.98,0:09:35.03,Default,,0,0,0,,Олар бізді, адамдарды құрбан етті.
Dialogue: 0,0:09:39.31,0:09:40.45,Default,,0,0,0,,Жетпейді
Dialogue: 0,0:09:41.15,0:09:42.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:42.69,0:09:44.00,Default,,0,0,0,,Бұл жеткіліксіз
Dialogue: 0,0:09:46.96,0:09:48.79,Default,,0,0,0,,Менің қаным жетпейді.
Dialogue: 0,0:09:49.21,0:09:50.14,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:09:50.14,0:09:51.77,Default,,0,0,0,,Мен мұны қазір істей алмаймын.
Dialogue: 0,0:09:52.99,0:09:54.51,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:09:55.73,0:09:56.75,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:14.72,0:10:16.49,Default,,0,0,0,,Нами! Сен жындысың ба?
Dialogue: 0,0:10:16.49,0:10:18.24,Default,,0,0,0,,Бәрін тек қана жап-жасырып қойдың ба?
Dialogue: 0,0:10:18.24,0:10:20.87,Default,,0,0,0,,Мұндағылардың бәрі жынды.
Dialogue: 0,0:10:21.56,0:10:24.08,Default,,0,0,0,,Мен бұл кітапты оқығаннан бері.
Dialogue: 0,0:10:26.93,0:10:28.33,Default,,0,0,0,,Саки!
Dialogue: 0,0:10:30.65,0:10:32.96,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:44.47,0:10:45.64,Default,,0,0,0,,Міне болды! Мынау
Dialogue: 0,0:10:45.64,0:10:47.10,Default,,0,0,0,,Сіз не істеп жатырсыз? Ри
Dialogue: 0,0:10:51.02,0:10:52.24,Default,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:10:52.55,0:10:54.82,Default,,0,0,0,,Жақында қақпа ашылады
Dialogue: 0,0:10:55.18,0:10:58.40,Default,,0,0,0,,*Мен тозақтың гүрілін естимін
Dialogue: 0,0:11:12.66,0:11:15.46,Default,,0,0,0,,*Алға шық, шайтан Белзебибут.
Dialogue: 0,0:11:15.46,0:11:18.05,Default,,0,0,0,,Менің бұйрығыма жауап бер.
Dialogue: 0,0:11:45.03,0:11:46.28,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:01.40,0:12:03.89,Default,,0,0,0,,Ауырды.
Dialogue: 0,0:12:04.48,0:12:07.01,Default,,0,0,0,,Қызым, өмір сүргің келе ме?
Dialogue: 0,0:12:08.39,0:12:11.10,Default,,0,0,0,,Менімен келісім-шарт жасағыңыз келе ме?
Dialogue: 0,0:12:11.84,0:12:15.36,Default,,0,0,0,,Соғыс алаңындағы сарбаздар—
Dialogue: 0,0:12:16.52,0:12:18.39,Default,,0,0,0,,Менің өлгім келмейді
Dialogue: 0,0:12:39.82,0:12:41.09,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:12:41.09,0:12:43.26,Default,,0,0,0,,Сіздің сүйіктіңіз келеді.
Dialogue: 0,0:12:43.26,0:12:44.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:47.95,0:12:49.14,Default,,0,0,0,,Ақ ағаш
Dialogue: 0,0:12:49.14,0:12:50.85,Default,,0,0,0,,Сіз менің артымнан жүрдіңіз бе?
Dialogue: 0,0:12:56.71,0:12:59.15,Default,,0,0,0,,Қош келдіңіз, Шираки-сан
Dialogue: 0,0:13:09.27,0:13:10.33,Default,,0,0,0,,Шираки!
Dialogue: 0,0:13:11.66,0:13:13.47,Default,,0,0,0,,Қайырлы таң Минасе-кун
Dialogue: 0,0:13:13.47,0:13:15.50,Default,,0,0,0,,Б-неге келдің?
Dialogue: 0,0:13:15.50,0:13:18.75,Default,,0,0,0,,Минасэ-кун сені кешке оятуыңды сұрамады ма?
Dialogue: 0,0:13:19.11,0:13:20.96,Default,,0,0,0,,О, шынымен бе?
Dialogue: 0,0:13:20.96,0:13:22.92,Default,,0,0,0,,Мен мұны қазірден бастап күнде таңертең жасаймын.
Dialogue: 0,0:13:43.13,0:13:45.64,Default,,0,0,0,,Минасэ-кун, сен көп кітап оқисың.
Dialogue: 0,0:13:46.55,0:13:49.66,Default,,0,0,0,,Ол кітап сені есінен шығарды.
Dialogue: 0,0:13:51.21,0:13:52.91,Default,,0,0,0,,Жоқ, бұл не?
Dialogue: 0,0:13:53.14,0:13:54.27,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:56.73,0:13:57.89,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:14:10.04,0:14:11.30,Default,,0,0,0,,Имари
Dialogue: 0,0:14:11.30,0:14:14.72,Default,,0,0,0,,Егер мен сіздің жүзіңізді көріп, дауысыңызды естісем, ол мен болар едім
Dialogue: 0,0:14:14.72,0:14:16.52,Default,,0,0,0,,Мен кері бұрылатындай сезінемін.
Dialogue: 0,0:14:17.13,0:14:18.31,Default,,0,0,0,,Минас
Dialogue: 0,0:14:28.59,0:14:30.62,Default,,0,0,0,,О, Имари-сан, қайырлы таң.
Dialogue: 0,0:14:33.45,0:14:34.45,Default,,0,0,0,,Имари
Dialogue: 0,0:14:36.11,0:14:37.76,Default,,0,0,0,,Кеттік, Минасэ-кун.
Dialogue: 0,0:14:38.73,0:14:39.75,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:14:40.02,0:14:41.08,Default,,0,0,0,,О
Dialogue: 0,0:15:13.93,0:15:15.12,Default,,0,0,0,,Минас
Dialogue: 0,0:15:16.60,0:15:17.54,Default,,0,0,0,,Имари
Dialogue: 0,0:15:18.23,0:15:20.21,Default,,0,0,0,,О, сіз білесіз бе, бұл.
Dialogue: 0,0:15:21.14,0:15:22.98,Default,,0,0,0,,Кері бұрылу деген нені білдіреді?
Dialogue: 0,0:15:23.99,0:15:26.13,Default,,0,0,0,,Дәл қазір Минасеге не болып жатыр?
Dialogue: 0,0:15:27.95,0:15:30.26,Default,,0,0,0,,Жақында болған Минас оқиғасы.
Dialogue: 0,0:15:30.26,0:15:31.72,Default,,0,0,0,,Адам өзгерген сияқты.
Dialogue: 0,0:15:32.36,0:15:33.89,Default,,0,0,0,,Эй, не болды?
Dialogue: 0,0:15:34.79,0:15:35.81,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:15:36.25,0:15:37.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:37.58,0:15:38.98,Default,,0,0,0,,Жеткілікті
Dialogue: 0,0:15:39.13,0:15:40.18,Default,,0,0,0,,Мені жалғыз қалдырыңыз
Dialogue: 0,0:15:40.71,0:15:41.98,Default,,0,0,0,,Минас
Dialogue: 0,0:15:42.17,0:15:43.10,Default,,0,0,0,,Имари
Dialogue: 0,0:15:43.10,0:15:44.36,Default,,0,0,0,,Не?
Dialogue: 0,0:15:44.76,0:15:47.61,Default,,0,0,0,,Бүгін үйірме жұмыстарына келмеу керек.
Dialogue: 0,0:15:48.01,0:15:49.57,Default,,0,0,0,,Иә?Неліктен?
Dialogue: 0,0:16:05.04,0:16:06.34,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:16:07.15,0:16:08.92,Default,,0,0,0,,Такаджо мырза
Dialogue: 0,0:16:10.36,0:16:11.70,Default,,0,0,0,,Қашпа! Тікелей айтшы!
Dialogue: 0,0:16:11.37,0:16:12.72,Default,,0,0,0,,Мен шыдай алмаймын
Dialogue: 0,0:16:12.72,0:16:14.03,Default,,0,0,0,,*? ? Тек сен
Dialogue: 0,0:16:15.36,0:16:16.43,Default,,0,0,0,,Мен барамын.
Dialogue: 0,0:16:16.43,0:16:18.64,Default,,0,0,0,,Мені дұрыстап ішке кіргізуіңізді өтінемін.
Dialogue: 0,0:16:18.64,0:16:20.52,Default,,0,0,0,,Мен-жақсы ма?
Dialogue: 0,0:16:21.00,0:16:22.10,Default,,0,0,0,,No
Dialogue: 0,0:16:22.29,0:16:23.56,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:24.00,0:16:25.01,Default,,0,0,0,,Әрине.
Dialogue: 0,0:16:25.01,0:16:28.61,Default,,0,0,0,,Егер біз оларды сыртқа шығарсақ, бұл физикалық жыныстық тәрбие болмас еді, солай ма?
Dialogue: 0,0:16:29.30,0:16:30.69,Default,,0,0,0,,Олай болса
Dialogue: 0,0:16:30.69,0:16:32.20,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:16:33.81,0:16:35.20,Default,,0,0,0,,Тоқта
Dialogue: 0,0:16:35.45,0:16:37.16,Default,,0,0,0,,Сонымен, шықты.
Dialogue: 0,0:16:37.16,0:16:39.49,Default,,0,0,0,,ішкі және сыртқы
Dialogue: 0,0:16:40.55,0:16:41.91,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:16:41.91,0:16:45.50,Default,,0,0,0,,Ұстаз, сенің ұстазың болу менің арманым еді.
Dialogue: 0,0:16:46.83,0:16:48.25,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:49.32,0:16:50.76,Default,,0,0,0,,Такаджо мырза
Dialogue: 0,0:16:50.76,0:16:52.41,Default,,0,0,0,,Мен оны ауызша жек көрсем де
Dialogue: 0,0:16:52.41,0:16:55.39,Default,,0,0,0,,Сіздің денеңіз өте бақытты сияқты.
Dialogue: 0,0:16:55.79,0:16:58.10,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:16:59.22,0:17:00.81,Default,,0,0,0,,Уау, бұл таңқаларлық, сенси.
Dialogue: 0,0:17:00.81,0:17:03.94,Default,,0,0,0,,Мұғалімнің іші ыстық, жұмсақ.
Dialogue: 0,0:17:04.77,0:17:09.23,Default,,0,0,0,,Егер қарсы тұра алмасаңыз, жиналған соманы сүйікті жеріңізге құйыңыз.
Dialogue: 0,0:17:19.24,0:17:21.24,Default,,0,0,0,,Көп қысыңыз.
Dialogue: 0,0:17:22.15,0:17:23.91,Default,,0,0,0,,Се, Сенсей
Dialogue: 0,0:17:23.91,0:17:26.54,Default,,0,0,0,,Мұғалім, кеттік, мұғалім.
Dialogue: 0,0:17:35.84,0:17:38.05,Default,,0,0,0,,Бұл нағыз эякуляция кеші
Dialogue: 0,0:17:45.87,0:17:49.56,Default,,0,0,0,,Міне, мен таңданатын студенттер кеңесінің төрағасы.
Dialogue: 0,0:17:50.13,0:17:51.73,Default,,0,0,0,,Сіз Шираки-санмен де жұмыс істей аласыз ба?
Dialogue: 0,0:17:52.59,0:17:54.19,Default,,0,0,0,,Бұл жолы мен бірінші барамын
Dialogue: 0,0:17:54.19,0:17:55.53,Default,,0,0,0,,Күте тұрыңыз, бұл менмін
Dialogue: 0,0:17:55.80,0:17:57.62,Default,,0,0,0,,Жоқ, тоқтатыңыз.
Dialogue: 0,0:17:57.62,0:17:59.20,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:18:00.04,0:18:01.27,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:07.69,0:18:09.79,Default,,0,0,0,,Минасэ-кун, маған көмектес
Dialogue: 0,0:18:09.79,0:18:12.00,Default,,0,0,0,,Мынау Шираки-санның кеудесі ме?
Dialogue: 0,0:18:12.00,0:18:14.63,Default,,0,0,0,,Шираки-сан ол жақта осылай көрінеді.
Dialogue: 0,0:18:18.16,0:18:20.35,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:18:20.91,0:18:22.20,Default,,0,0,0,,О, Имари-сан
Dialogue: 0,0:18:22.61,0:18:25.08,Default,,0,0,0,,Китами мырза, тоқтатыңызшы.
Dialogue: 0,0:18:25.32,0:18:28.69,Default,,0,0,0,,Минасе, Саэки мырза, екеуіңе не болды?
Dialogue: 0,0:18:29.59,0:18:32.27,Default,,0,0,0,,үшінңыз тоқтаңыздар.
Dialogue: 0,0:18:38.17,0:18:39.86,Default,,0,0,0,,Такаджо мырза
Dialogue: 0,0:18:39.86,0:18:41.16,Default,,0,0,0,,Шираки мырза
Dialogue: 0,0:18:41.30,0:18:42.41,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:18:42.77,0:18:44.20,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:48.87,0:18:51.17,Default,,0,0,0,,Минасе, неге тоқтамайсың?
Dialogue: 0,0:18:51.17,0:18:52.43,Default,,0,0,0,,Шираки мырза Минас қаласынан.
Dialogue: 0,0:18:52.43,0:18:55.59,Default,,0,0,0,,Имари-сан, бізге де қосыл.
Dialogue: 0,0:18:56.25,0:18:57.67,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:18:58.12,0:18:59.34,Default,,0,0,0,,Саэки мырза
Dialogue: 0,0:19:00.54,0:19:02.89,Default,,0,0,0,,Эй Минасе, бірдеңе айтшы.
Dialogue: 0,0:19:02.89,0:19:04.81,Default,,0,0,0,,Оян!
Dialogue: 0,0:19:14.91,0:19:17.15,Default,,0,0,0,,Ми Минасе
Dialogue: 0,0:19:35.75,0:19:37.84,Default,,0,0,0,,Минасэ-кун, мен сені сонда апарамын.
Dialogue: 0,0:19:38.24,0:19:39.72,Default,,0,0,0,,О, ой
Dialogue: 0,0:19:40.76,0:19:42.55,Default,,0,0,0,,Жоқ, жоқ, Минасе-кун.
Dialogue: 0,0:19:44.14,0:19:47.14,Default,,0,0,0,,Имари-санды өзіңізбен бірге алып кетпеңіз.
Dialogue: 0,0:19:49.95,0:19:51.77,Default,,0,0,0,,Жүр, Минасэ-кун, тезірек.
Dialogue: 0,0:20:38.25,0:20:41.32,Default,,0,0,0,,Шынайы тазалық
Dialogue: 0,0:20:43.95,0:20:46.53,Default,,0,0,0,,Енді бізге қолайлы уақытты күту керек
Dialogue: 0,0:20:48.31,0:20:49.58,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:20:49.58,0:20:52.58,Default,,0,0,0,,Имари-санды бірінші рет жалаңаш көріп тұрсың, солай ма?
Dialogue: 0,0:20:53.90,0:20:54.83,Default,,0,0,0,,Иә
Dialogue: 0,0:20:56.11,0:20:59.59,Default,,0,0,0,,Өкінішке орай, мен бұл баланың пәктігін бере алмаймын.
Dialogue: 0,0:21:00.98,0:21:03.01,Default,,0,0,0,,Егер рәсім сәтті өтсе
Dialogue: 0,0:21:03.24,0:21:06.97,Default,,0,0,0,,Мен саған бұл денемен көп қызық беремін.
Dialogue: 0,0:21:06.97,0:21:08.80,Default,,0,0,0,,Рәсім дегеніміз не?
Dialogue: 0,0:21:10.87,0:21:12.52,Default,,0,0,0,,Сіз байқаған сияқтысыз.
Dialogue: 0,0:21:14.63,0:21:16.35,Default,,0,0,0,,Китами мырза
Dialogue: 0,0:21:17.00,0:21:19.11,Default,,0,0,0,,Ал, бұрын не болды?
Dialogue: 0,0:21:19.11,0:21:20.57,Default,,0,0,0,,Бұл арман емес
Dialogue: 0,0:21:21.22,0:21:23.94,Default,,0,0,0,,Жоқ! менің киімім
Dialogue: 0,0:21:25.91,0:21:27.93,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:27.93,0:21:30.08,Default,,0,0,0,,Мұғалім, сен неге бұлай істеп жатырсың?
Dialogue: 0,0:21:30.08,0:21:31.41,Default,,0,0,0,,Өтінемін, алып тастаңыз
Dialogue: 0,0:21:31.41,0:21:33.33,Default,,0,0,0,,Бұл опция емес.
Dialogue: 0,0:21:35.41,0:21:36.78,Default,,0,0,0,,Китами мырза
Dialogue: 0,0:21:38.20,0:21:39.38,Default,,0,0,0,,Минас
Dialogue: 0,0:21:40.28,0:21:42.42,Default,,0,0,0,,Ритуал дегенді қалай түсінесіңдер?
Dialogue: 0,0:21:42.91,0:21:44.67,Default,,0,0,0,,Имаримен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:21:45.44,0:21:48.34,Default,,0,0,0,,Ренжіткенім үшін кешіріңіз, бірақ менің уақытым жоқ.
Dialogue: 0,0:21:49.20,0:21:51.81,Default,,0,0,0,,Маған Имари-санның жазықсыз денесі керек.
Dialogue: 0,0:21:53.64,0:21:57.27,Default,,0,0,0,,Сіз мұны басқа белгі қойған адам Шираки мырза үшін жасадыңыз.
Dialogue: 0,0:21:58.29,0:22:00.08,Default,,0,0,0,,Минас Неге?
Dialogue: 0,0:22:00.08,0:22:01.61,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:22:03.71,0:22:04.82,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:22:05.89,0:22:08.70,Default,,0,0,0,,Сіз бізді сүйреп кірдіңіз.
Dialogue: 0,0:22:09.11,0:22:12.08,Default,,0,0,0,,Мен бұл жақта әлі толық адам болған жоқпын.
Dialogue: 0,0:22:18.73,0:22:22.71,Default,,0,0,0,,Сен үшін қаншама достар жинадық.
Dialogue: 0,0:22:23.04,0:22:24.38,Default,,0,0,0,,Саэки
Dialogue: 0,0:22:24.38,0:22:25.63,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:22:26.95,0:22:29.43,Default,,0,0,0,,Мен мұнда өте кеш келдім.
Dialogue: 0,0:22:29.87,0:22:34.50,Default,,0,0,0,,Имари-санды менің көлігіме мінгізгеннен бері қайда болдың? Минасе-кун
Dialogue: 0,0:22:57.87,0:22:59.92,Default,,0,0,0,,Минасэ-кун бұл кітапты алды.
Dialogue: 0,0:23:02.06,0:23:04.04,Default,,0,0,0,,Мүмкін бұл?
Dialogue: 0,0:23:06.57,0:23:08.30,Default,,0,0,0,,Не?
Dialogue: 0,0:23:08.55,0:23:10.32,Default,,0,0,0,,Бұл пәктік белбеуі
Dialogue: 0,0:23:10.32,0:23:11.97,Default,,0,0,0,,Сіз не істемексіз? ол
Dialogue: 0,0:23:12.28,0:23:14.70,Default,,0,0,0,,Әрине мен саған кигіземін.
Dialogue: 0,0:23:15.29,0:23:18.23,Default,,0,0,0,,Мен сенің қыздығыңды алғанша
Dialogue: 0,0:23:18.23,0:23:20.64,Default,,0,0,0,,Б-сен не айтып тұрсың?
Dialogue: 0,0:23:20.64,0:23:23.52,Default,,0,0,0,,Басында сәл оғаш көрінуі мүмкін, бірақ
Dialogue: 0,0:23:23.52,0:23:25.11,Default,,0,0,0,,Оған тез үйреніп кетесің.
Dialogue: 0,0:23:25.31,0:23:26.57,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:23:26.57,0:23:28.24,Default,,0,0,0,,Сіз мұндай нәрсені киюге қалай батылыңыз бар?
Dialogue: 0,0:23:29.85,0:23:34.41,Default,,0,0,0,,Бірақ бұған дейін сіз бұларды кисеңіз, еркін мастурбация жасай алмайсыз.
Dialogue: 0,0:23:35.31,0:23:37.95,Default,,0,0,0,,Мен саған көп ләззат беремін.
Dialogue: 0,0:23:37.95,0:23:39.91,Default,,0,0,0,,Жоқ, бұл маған керек емес.
Dialogue: 0,0:23:40.98,0:23:43.25,Default,,0,0,0,,Мен мұны қанша уақытқа дейін айта аламын?
Dialogue: 0,0:23:44.15,0:23:46.13,Default,,0,0,0,,Саэки мырза, маған беріңізші.
Dialogue: 0,0:23:46.44,0:23:47.98,Default,,0,0,0,,Иә, әпке.
Dialogue: 0,0:23:50.57,0:23:52.17,Default,,0,0,0,,Не, бұл не?
Dialogue: 0,0:23:53.42,0:23:56.01,Default,,0,0,0,,Мен сізге бірдеңе беремін.
Dialogue: 0,0:24:04.80,0:24:06.57,Default,,0,0,0,,Ол бірден жұмыс істей бастайды.
Dialogue: 0,0:24:07.63,0:24:10.86,Default,,0,0,0,,Адам баласы түрлі нәпсіге әлсірейді.
Dialogue: 0,0:24:11.57,0:24:14.37,Default,,0,0,0,,Әсіресе сіз сияқты жастар.
Dialogue: 0,0:24:15.43,0:24:18.54,Default,,0,0,0,,Жақында сен де сол сүйкімді ауыздан шығасың.
Dialogue: 0,0:24:18.54,0:24:21.50,Default,,0,0,0,,Аңқылдап, қайыр сұрай бастайсың.
Dialogue: 0,0:24:21.84,0:24:23.96,Default,,0,0,0,,Жоқ, мен мұны істемеймін.
Dialogue: 0,0:24:24.36,0:24:26.46,Default,,0,0,0,,Сіз тек қазір ғана күшті бола аласыз
Dialogue: 0,0:24:27.38,0:24:29.80,Default,,0,0,0,,Сіз әрқашан үйде мастурбация жасайсыз, солай ма?
Dialogue: 0,0:24:29.80,0:24:31.42,Default,,0,0,0,,Иә және жоқ
Dialogue: 0,0:24:31.42,0:24:33.01,Default,,0,0,0,,Өтірік айту
Dialogue: 0,0:24:33.01,0:24:35.26,Default,,0,0,0,,Мен мұны істемеймін.
Dialogue: 0,0:24:44.60,0:24:46.27,Default,,0,0,0,,Ол жұмыс істеп тұрған сияқты.
Dialogue: 0,0:24:46.27,0:24:48.52,Default,,0,0,0,,Жақында тағы да таңғажайып заттар шығады
Dialogue: 0,0:24:48.52,0:24:50.40,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:24:52.01,0:24:54.26,Default,,0,0,0,,біртүрлі нәрсе
Dialogue: 0,0:24:55.89,0:24:56.74,Default,,0,0,0,,Жоқ
Dialogue: 0,0:24:57.41,0:24:58.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:24:59.06,0:25:00.23,Default,,0,0,0,,Имари
Dialogue: 0,0:25:00.81,0:25:03.27,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз қалайсыз, солай ма?
Dialogue: 0,0:25:03.77,0:25:05.75,Default,,0,0,0,,Сіз мұны істеу үшін өліп жатырсыз, солай емес пе?
Dialogue: 0,0:25:05.75,0:25:08.17,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:25:12.88,0:25:14.69,Default,,0,0,0,,Қандай қыңыр бала.
Dialogue: 0,0:25:22.80,0:25:24.44,Default,,0,0,0,,Сіз қалай ойлайсыз? Имари-сан
Dialogue: 0,0:25:25.81,0:25:28.11,Default,,0,0,0,,Маған көмектес
Dialogue: 0,0:25:29.98,0:25:32.15,Default,,0,0,0,,Адал болу керек болса ше?
Dialogue: 0,0:25:32.15,0:25:34.07,Default,,0,0,0,,Ұстаудың пайдасы жоқ
Dialogue: 0,0:25:34.07,0:25:37.49,Default,,0,0,0,,Неғұрлым шыдасаңыз, соғұрлым толқу күшейе түседі
Dialogue: 0,0:25:37.49,0:25:41.12,Default,,0,0,0,,Маған көмектесші, көмектесші, Минасе
Dialogue: 0,0:25:41.64,0:25:42.70,Default,,0,0,0,,Имари
Dialogue: 0,0:25:44.20,0:25:45.60,Default,,0,0,0,,Минасе-кунтара
Dialogue: 0,0:25:46.00,0:25:48.25,Default,,0,0,0,,Сіз оны өте үлкен етіп жасадыңыз
Dialogue: 0,0:25:48.48,0:25:49.96,Default,,0,0,0,,Ұялмайсың ба?
Dialogue: 0,0:25:51.32,0:25:54.42,Default,,0,0,0,,Жоқ! Мен енді шыдай алмаймын
Dialogue: 0,0:25:55.56,0:25:58.10,Default,,0,0,0,,Имари мырза, мен сізден тағы сұрайын.
Dialogue: 0,0:25:59.37,0:26:01.43,Default,,0,0,0,,Мастурбация жасамайтыныңызға сенімдісіз бе?
Dialogue: 0,0:26:02.44,0:26:04.10,Default,,0,0,0,,Жаса және істе
Dialogue: 0,0:26:04.10,0:26:05.47,Default,,0,0,0,,Мастурбация
Dialogue: 0,0:26:05.47,0:26:06.44,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:26:07.00,0:26:09.40,Default,,0,0,0,,Аптасына неше рет?
Dialogue: 0,0:26:11.68,0:26:15.28,Default,,0,0,0,,Аптасына шамамен 3 рет
Dialogue: 0,0:26:15.51,0:26:17.11,Default,,0,0,0,,Сіз мұны үш рет жасадыңыз ба?
Dialogue: 0,0:26:17.47,0:26:20.57,Default,,0,0,0,,Сондықтан мен жақсы емес екенімді сенімді түрде айта аламын.
Dialogue: 0,0:26:20.57,0:26:22.58,Default,,0,0,0,,Жоқ, олай айтпа.
Dialogue: 0,0:26:22.58,0:26:24.58,Default,,0,0,0,,Тіпті Минасаның алдында
Dialogue: 0,0:26:25.87,0:26:27.85,Default,,0,0,0,,Адал жауап бергені үшін сыйақы
Dialogue: 0,0:26:27.85,0:26:30.94,Default,,0,0,0,,Мен саған Минасэ-кунның алдында көп көңіл көтеруге мүмкіндік беремін.
Dialogue: 0,0:26:31.51,0:26:33.93,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:26:40.25,0:26:42.68,Default,,0,0,0,,Минас
Dialogue: 0,0:26:44.18,0:26:50.18,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
