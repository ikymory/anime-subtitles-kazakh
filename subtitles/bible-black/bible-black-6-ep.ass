Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.33,0:01:07.06,Default,,0,0,0,,...
Dialogue: 0,0:01:10.86,0:01:12.22,Default,,0,0,0,,Жоқ
Dialogue: 0,0:01:13.94,0:01:15.70,Default,,0,0,0,,ағура аумин
Dialogue: 0,0:01:17.47,0:01:19.78,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:01:20.92,0:01:22.32,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:01:30.18,0:01:32.89,Default,,0,0,0,,Бұл дене менікі болады.
Dialogue: 0,0:01:36.17,0:01:37.68,Default,,0,0,0,,Минасе-кун
Dialogue: 0,0:01:51.90,0:01:55.78,Default,,0,0,0,,Минасэ-кун әдеттегіден үлкенірек және ыстық
Dialogue: 0,0:02:33.05,0:02:35.95,Default,,0,0,0,,Минасэ-кун бар, бар
Dialogue: 0,0:02:35.95,0:02:37.49,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:02:42.85,0:02:45.37,Default,,0,0,0,,Ыстық нәрсе шығып жатыр
Dialogue: 0,0:02:45.37,0:02:47.91,Default,,0,0,0,,Көп нәрсе келеді
Dialogue: 0,0:02:48.35,0:02:49.62,Default,,0,0,0,,Барлығы
Dialogue: 0,0:02:49.99,0:02:51.83,Default,,0,0,0,,Маған бәрін беріңіз
Dialogue: 0,0:02:57.80,0:03:00.80,Default,,0,0,0,,Әдемі екен, Имари-сан.
Dialogue: 0,0:03:02.36,0:03:05.10,Default,,0,0,0,,Минасэ-кун, маған көмектесуіңді қалаймын.
Dialogue: 0,0:03:07.17,0:03:08.65,Default,,0,0,0,,Оларға ілеспе — мына жаққа оралыңдар!
Dialogue: 0,0:03:08.65,0:03:11.14,Default,,0,0,0,,Мұнда шығудың кілті бар.
Dialogue: 0,0:03:13.11,0:03:15.02,Default,,0,0,0,,Минас
Dialogue: 0,0:03:15.86,0:03:18.11,Default,,0,0,0,,Құдайға мойынсұнбаған жиіркенішті шайтан.
Dialogue: 0,0:03:18.34,0:03:21.86,Default,,0,0,0,,Бұл жерді тастап кетуіңе тілектеспін
Dialogue: 0,0:03:22.06,0:03:23.41,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:03:26.66,0:03:27.79,Default,,0,0,0,,Минас
Dialogue: 0,0:03:28.15,0:03:30.41,Default,,0,0,0,,Ақымақ, кеш болып қалды.
Dialogue: 0,0:03:30.41,0:03:33.33,Default,,0,0,0,,Менің онда не істеп жатқанымды қараңыз.
Dialogue: 0,0:03:33.33,0:03:35.71,Default,,0,0,0,,Мен сені ырым біткен бойда өлтіремін.
Dialogue: 0,0:03:35.71,0:03:36.88,Default,,0,0,0,,Ол әлі оралмады ма?
Dialogue: 0,0:03:38.06,0:03:39.38,Default,,0,0,0,,Қақпаның күзетшісі
Dialogue: 0,0:03:39.62,0:03:42.72,Default,,0,0,0,,Аматсу патшалығының қақпасын қорғайтын адам.
Dialogue: 0,0:03:42.87,0:03:45.22,Default,,0,0,0,,Мен Үшбірліктің періштесімін
Dialogue: 0,0:03:45.22,0:03:47.51,Default,,0,0,0,,Және көптеген құпиялардың атымен
Dialogue: 0,0:03:47.51,0:03:49.22,Default,,0,0,0,,Оркустың қақпасын жабыңыз
Dialogue: 0,0:03:49.67,0:03:51.18,Default,,0,0,0,,Әлі де сенімді емессіз бе?
Dialogue: 0,0:03:51.66,0:03:54.75,Default,,0,0,0,,Сенің сиқырың маған әсер етпейді.
Dialogue: 0,0:03:55.67,0:03:56.98,Default,,0,0,0,,Минас
Dialogue: 0,0:03:57.16,0:03:59.29,Default,,0,0,0,,Мен Үшбірліктің періштесімін
Dialogue: 0,0:03:59.64,0:04:01.82,Default,,0,0,0,,Және көптеген құпиялардың атымен
Dialogue: 0,0:04:06.14,0:04:07.87,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:04:14.05,0:04:15.54,Default,,0,0,0,,Иә, қазір.
Dialogue: 0,0:04:15.94,0:04:18.46,Default,,0,0,0,,Көңілді болған соң, мені өлтіруді бұйырдым.
Dialogue: 0,0:04:20.14,0:04:22.09,Default,,0,0,0,,Көмекке баруым керек пе?
Dialogue: 0,0:04:22.09,0:04:23.72,Default,,0,0,0,,Өзіңізді ақымақ етпеңіз
Dialogue: 0,0:04:24.31,0:04:26.10,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:04:26.10,0:04:30.34,Default,,0,0,0,,Менде дәл қазір иллюзия көрсету салтанаты жоқ.
Dialogue: 0,0:04:50.25,0:04:51.41,Default,,0,0,0,,No
Dialogue: 0,0:04:51.90,0:04:53.33,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:04:54.39,0:04:56.29,Default,,0,0,0,,Жоқ, мен қалаймын
Dialogue: 0,0:04:57.50,0:04:58.59,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:05:10.31,0:05:11.46,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:05:23.66,0:05:26.06,Default,,0,0,0,,Мен де шарасызмын
Dialogue: 0,0:05:29.30,0:05:31.66,Default,,0,0,0,,Үйге қайт.
Dialogue: 0,0:05:34.23,0:05:36.86,Default,,0,0,0,,Мен сізге ешқашан кедергі келтірмеймін.
Dialogue: 0,0:05:40.55,0:05:41.72,Default,,0,0,0,,Минас
Dialogue: 0,0:05:42.40,0:05:43.67,Default,,0,0,0,,Минас
Dialogue: 0,0:05:43.67,0:05:49.09,Default,,0,0,0,,...
Dialogue: 0,0:05:49.94,0:05:54.85,Default,,0,0,0,,...
Dialogue: 0,0:05:54.96,0:05:59.52,Default,,0,0,0,,...
Dialogue: 0,0:06:00.08,0:06:04.86,Default,,0,0,0,,...
Dialogue: 0,0:06:05.05,0:06:09.86,Default,,0,0,0,,...
Dialogue: 0,0:06:10.18,0:06:14.79,Default,,0,0,0,,...
Dialogue: 0,0:06:13.55,0:06:17.96,Default,,0,0,0,,...
Dialogue: 0,0:06:17.96,0:06:22.54,Default,,0,0,0,,...
Dialogue: 0,0:07:55.72,0:07:57.14,Default,,0,0,0,,Минас
Dialogue: 0,0:08:05.23,0:08:06.27,Default,,0,0,0,,Имари
Dialogue: 0,0:08:06.27,0:08:08.02,Default,,0,0,0,,Минасэ-кун, сен не істеп жатырсың?
Dialogue: 0,0:08:11.35,0:08:12.70,Default,,0,0,0,,Такаджо мырза
Dialogue: 0,0:08:13.43,0:08:16.66,Default,,0,0,0,,Тез, тез тыйым салынған сиқырды, тез айт
Dialogue: 0,0:08:17.16,0:08:22.25,Default,,0,0,0,,Китамиді жеңсек, сенің әпкең мен Шираки-сан да құтқарылады.
Dialogue: 0,0:08:25.17,0:08:26.71,Default,,0,0,0,,Китамиді жеңу.
Dialogue: 0,0:08:26.71,0:08:28.00,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:08:28.53,0:08:30.80,Default,,0,0,0,,Минасэ-кун, тез Китамиге бар.
Dialogue: 0,0:08:38.62,0:08:39.81,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:08:48.43,0:08:50.23,Default,,0,0,0,,Менің денемде күш жоқ
Dialogue: 0,0:08:50.86,0:08:53.49,Default,,0,0,0,,Китамиді жеңсек, бәрі бітеді.
Dialogue: 0,0:08:53.49,0:08:55.57,Default,,0,0,0,,Кеш болмай тұрғанда асығыңыз
Dialogue: 0,0:08:57.64,0:08:59.41,Default,,0,0,0,,Китамиге тез барыңыз
Dialogue: 0,0:09:01.61,0:09:02.91,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:09:43.21,0:09:44.70,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:22.76,0:10:27.12,Default,,0,0,0,,...
Dialogue: 0,0:10:28.94,0:10:33.59,Default,,0,0,0,,...
Dialogue: 0,0:10:37.42,0:10:41.68,Default,,0,0,0,,Аматсу патшалығының қақпасының күзетшісі, қақпасының күзетшісі.
Dialogue: 0,0:10:43.04,0:10:45.39,Default,,0,0,0,,Мен Үшбірліктің періштесімін
Dialogue: 0,0:10:45.64,0:10:48.39,Default,,0,0,0,,Және көптеген құпиялардың атымен
Dialogue: 0,0:10:48.39,0:10:50.52,Default,,0,0,0,,Оркустың қақпаларын жабыңыз
Dialogue: 0,0:10:51.22,0:10:56.44,Default,,0,0,0,,Иегова яр тетораграмматон садай
Dialogue: 0,0:10:56.84,0:11:03.83,Default,,0,0,0,,mesias agios ishuros emanuel agura α және ω
Dialogue: 0,0:11:07.10,0:11:09.25,Default,,0,0,0,,Иса, бірінші және соңғы
Dialogue: 0,0:11:09.25,0:11:12.67,Default,,0,0,0,,Ең асқақ құдайлардың атынан бұйырамын.
Dialogue: 0,0:11:12.87,0:11:15.41,Default,,0,0,0,,Бұл жерде қалуға күш-қуатыңыз жоғалады
Dialogue: 0,0:11:15.46,0:11:18.22,Default,,0,0,0,,Тозақ отында қамалып қалмасын
Dialogue: 0,0:11:18.22,0:11:22.30,Default,,0,0,0,,Және осы құдай есімінің құдіретімен И
Dialogue: 0,0:11:22.30,0:11:24.72,Default,,0,0,0,,*Әке мен Ұлдың барлық Киелі Рухында
Dialogue: 0,0:11:25.18,0:11:29.85,Default,,0,0,0,,Әулие Майкл сізді тозақтың тереңіне апарсын.
Dialogue: 0,0:11:29.85,0:11:31.73,Default,,0,0,0,,Сіз қалаған нәрсе
Dialogue: 0,0:11:52.60,0:11:53.83,Default,,0,0,0,,Аумин
Dialogue: 0,0:12:27.99,0:12:30.08,Default,,0,0,0,,*? Эй? Қаш
Dialogue: 0,0:12:37.59,0:12:39.80,Default,,0,0,0,,Бұл сиқыршының үстіне жазылған.
Dialogue: 0,0:12:39.99,0:12:43.55,Default,,0,0,0,,*Бұл зұлым күштерді тозаққа шақыратын (теңдесі жоқ?) заклинание.
Dialogue: 0,0:12:50.55,0:12:51.77,Default,,0,0,0,,Китами мырза
Dialogue: 0,0:12:52.08,0:12:54.31,Default,,0,0,0,,Сіздің жоспарыңыз сәтсіз болды
Dialogue: 0,0:13:01.73,0:13:02.90,Default,,0,0,0,,Китами мырза
Dialogue: 0,0:13:56.73,0:14:00.00,Default,,0,0,0,,Полиция тергеуі кеше аяқталды.
Dialogue: 0,0:14:00.46,0:14:01.85,Default,,0,0,0,,Өйткені
Dialogue: 0,0:14:01.85,0:14:04.72,Default,,0,0,0,,Китами мырза өз-өзіне қол жұмсаған сияқты.
Dialogue: 0,0:14:05.21,0:14:06.42,Default,,0,0,0,,Иә
Dialogue: 0,0:14:06.82,0:14:10.30,Default,,0,0,0,,Жұмбақ көп, бірақ оны шешудің жолы жоқ.
Dialogue: 0,0:14:11.68,0:14:12.48,Default,,0,0,0,,Имари
Dialogue: 0,0:14:12.48,0:14:13.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:13.80,0:14:14.97,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:15.29,0:14:18.48,Default,,0,0,0,,Мен Имаридің бұл жағдайды бастан өткеруіне жауаптымын.
Dialogue: 0,0:14:18.94,0:14:20.27,Default,,0,0,0,,Минас
Dialogue: 0,0:14:21.51,0:14:22.69,Default,,0,0,0,,Хм, солай ма?
Dialogue: 0,0:14:32.54,0:14:33.62,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:14:34.43,0:14:37.50,Default,,0,0,0,,Менің ойымша, шайтан әр адамның жүрегінде өмір сүреді.
Dialogue: 0,0:14:38.19,0:14:41.21,Default,,0,0,0,,Минасе сол жынды жеңді.
Dialogue: 0,0:14:42.98,0:14:45.92,Default,,0,0,0,,Эй Минасе, сен не салып жатырсың?
Dialogue: 0,0:14:48.06,0:14:51.16,Default,,0,0,0,,Сен мені қорғадың.
Dialogue: 0,0:14:52.00,0:14:52.97,Default,,0,0,0,,Имари
Dialogue: 0,0:15:07.61,0:15:09.32,Default,,0,0,0,,Жарай ма? шынымен
Dialogue: 0,0:15:09.85,0:15:11.11,Default,,0,0,0,,Иә
Dialogue: 0,0:15:11.11,0:15:12.87,Default,,0,0,0,,Минаспен бірге болған дұрыс па?
Dialogue: 0,0:15:33.85,0:15:35.05,Default,,0,0,0,,Минас
Dialogue: 0,0:15:35.25,0:15:36.52,Default,,0,0,0,,Қорқынышты ма?
Dialogue: 0,0:15:36.52,0:15:37.68,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:38.35,0:15:39.70,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:45.42,0:15:46.30,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,0:15:46.30,0:15:48.65,Default,,0,0,0,,Жоқ, оған көп қарамаңыз.
Dialogue: 0,0:15:50.70,0:15:52.49,Default,,0,0,0,,Minase №
Dialogue: 0,0:15:54.84,0:15:56.06,Default,,0,0,0,,(Серо) Тіпті бастауыш сынып оқушысы кенеттен «Қорықпа!» деп айқайлады.
Dialogue: 0,0:16:03.19,0:16:05.28,Default,,0,0,0,,Мен кірдім, Имари.
Dialogue: 0,0:16:05.28,0:16:08.67,Default,,0,0,0,,Иә, мен ішімде Минасаны сезінемін.
Dialogue: 0,0:16:09.20,0:16:10.42,Default,,0,0,0,,Мен қозғала аламын ба?
Dialogue: 0,0:16:11.22,0:16:13.34,Default,,0,0,0,,Иә, менің ойымша, бәрі жақсы.
Dialogue: 0,0:16:49.15,0:16:50.38,Default,,0,0,0,,Имари
Dialogue: 0,0:16:50.38,0:16:51.84,Default,,0,0,0,,Минас
Dialogue: 0,0:16:54.14,0:16:55.47,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:16:55.47,0:16:56.97,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:17:05.01,0:17:06.77,Default,,0,0,0,,Бұл орын алатын сияқты
Dialogue: 0,0:17:22.85,0:17:25.54,Default,,0,0,0,,Сол жертөле жоқ болады, солай ма?
Dialogue: 0,0:17:26.61,0:17:27.76,Default,,0,0,0,,О
Dialogue: 0,0:17:27.76,0:17:30.25,Default,,0,0,0,,Олар келесі аптада оны бетонмен толтыратын сияқты.
Dialogue: 0,0:17:30.95,0:17:34.97,Default,,0,0,0,,Мектеп екі оқиға болған бөлмеден енді шыға алмайтын сияқты.
Dialogue: 0,0:17:36.16,0:17:37.59,Default,,0,0,0,,Сиқырлы кітап ше?
Dialogue: 0,0:17:38.77,0:17:40.64,Default,,0,0,0,,Мен оны бүгін тапқан жеріме әкелдім.
Dialogue: 0,0:17:41.75,0:17:43.60,Default,,0,0,0,,Сол жертөледе ме?
Dialogue: 0,0:17:43.79,0:17:44.68,Default,,0,0,0,,Иә
Dialogue: 0,0:17:44.68,0:17:47.19,Default,,0,0,0,,Енді мені енді ешкім ешқашан көрмейді.
Dialogue: 0,0:17:48.21,0:17:50.48,Default,,0,0,0,,Күрделі заклинаниемен қоштас.
Dialogue: 0,0:17:52.34,0:17:55.03,Default,,0,0,0,,Мен бұдан былай ән айтуды жалғастырамын.
Dialogue: 0,0:17:55.73,0:17:57.61,Default,,0,0,0,,Не? не?
Dialogue: 0,0:17:58.64,0:18:01.37,Default,,0,0,0,,Көптен бері жүрегімде шырқап жүрген сиқыр
Dialogue: 0,0:18:02.31,0:18:03.79,Default,,0,0,0,,Өйткені тиімді болып көрінеді.
Dialogue: 0,0:18:09.96,0:18:11.04,Default,,0,0,0,,Сәлем Минасе
Dialogue: 0,0:18:11.98,0:18:13.34,Default,,0,0,0,,Иә? не?
Dialogue: 0,0:18:15.45,0:18:16.67,Default,,0,0,0,,Пыс, пыс… Э?
Dialogue: 0,0:18:17.12,0:18:18.18,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:18.62,0:18:19.76,Default,,0,0,0,,Пыс, пыс… Э?
Dialogue: 0,0:18:19.76,0:18:21.43,Default,,0,0,0,,Жақсы, себебі бұл ұят
Dialogue: 0,0:18:22.71,0:18:23.89,Default,,0,0,0,,Кез келген нәрсені айтыңыз
Dialogue: 0,0:18:25.65,0:18:27.43,Default,,0,0,0,,Мм, бөксе
Dialogue: 0,0:18:28.00,0:18:29.44,Default,,0,0,0,,Мен мұны сенің бөксеңмен жасағым келеді.
Dialogue: 0,0:18:30.09,0:18:30.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:31.71,0:18:33.61,Default,,0,0,0,,Мен сенің бөксесім болғаныңды қалаймын.
Dialogue: 0,0:18:41.22,0:18:42.99,Default,,0,0,0,,Өте көп
Dialogue: 0,0:18:42.99,0:18:45.41,Default,,0,0,0,,Минасаны жұмсартып, босатыңыз
Dialogue: 0,0:18:53.02,0:18:54.32,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:19:12.27,0:19:13.59,Default,,0,0,0,,Имари
Dialogue: 0,0:19:13.59,0:19:15.23,Default,,0,0,0,,Минас
Dialogue: 0,0:19:17.47,0:19:18.61,Default,,0,0,0,,Имари
Dialogue: 0,0:19:24.33,0:19:25.56,Default,,0,0,0,,Имари
Dialogue: 0,0:19:25.76,0:19:28.08,Default,,0,0,0,,Миназ Минас
Dialogue: 0,0:19:43.96,0:19:45.72,Default,,0,0,0,,Минас
Dialogue: 0,0:19:51.60,0:19:54.11,Default,,0,0,0,,Minase Керемет Керемет
Dialogue: 0,0:19:57.03,0:19:58.11,Default,,0,0,0,,Имари
Dialogue: 0,0:20:02.27,0:20:03.45,Default,,0,0,0,,Имари
Dialogue: 0,0:20:03.45,0:20:06.03,Default,,0,0,0,,Бөкселеріңіз керемет
Dialogue: 0,0:20:10.90,0:20:12.29,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:20:12.29,0:20:13.79,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:20:14.43,0:20:16.33,Default,,0,0,0,,Ику Ику!
Dialogue: 0,0:20:38.86,0:20:40.15,Default,,0,0,0,,Минас
Dialogue: 0,0:20:40.15,0:20:43.24,Default,,0,0,0,,Мен Китами мырзаның өткенін көрдім.
Dialogue: 0,0:20:43.24,0:20:44.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:45.60,0:20:47.20,Default,,0,0,0,,12 жыл бұрын
Dialogue: 0,0:20:47.20,0:20:49.83,Default,,0,0,0,,Китами мырза мектепке ауысты.
Dialogue: 0,0:20:50.06,0:20:52.41,Default,,0,0,0,,Ол кез келген жерден табуға болатын қарапайым қыз еді.
Dialogue: 0,0:20:54.61,0:20:57.71,Default,,0,0,0,,Бұрын тұрған қалада оған ұнайтын бір бала болған көрінеді.
Dialogue: 0,0:20:58.49,0:21:00.76,Default,,0,0,0,,Бірақ әлі күнге дейін мойындай алмады
Dialogue: 0,0:21:01.82,0:21:03.01,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:21:03.62,0:21:06.05,Default,,0,0,0,,Ол адам да құрбан болған.
Dialogue: 0,0:21:52.09,0:21:53.56,Default,,0,0,0,,Имари мырза?
Dialogue: 0,0:21:53.56,0:21:54.81,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:56.67,0:21:59.69,Default,,0,0,0,,Оны сол жерде қалдыру қауіпті.
Dialogue: 0,0:22:18.65,0:22:20.67,Default,,0,0,0,,Эй, Имари-сан.
Dialogue: 0,0:23:03.14,0:23:07.13,Default,,0,0,0,,Маған жаңа физикалық жағдайды сынап көрейін.
Dialogue: 0,0:23:08.71,0:23:10.64,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:23:50.96,0:23:52.30,Default,,0,0,0,,Жоқ
Dialogue: 0,0:23:53.11,0:23:55.39,Default,,0,0,0,,Не? Саэки мырза
Dialogue: 0,0:23:55.39,0:23:57.10,Default,,0,0,0,,Мен оны сезбеймін.
Dialogue: 0,0:24:02.73,0:24:04.48,Default,,0,0,0,,Күте тұрыңыз, Саэки-сан
Dialogue: 0,0:24:18.95,0:24:20.05,Default,,0,0,0,,(Отокоцудың дауысы)
Dialogue: 0,0:24:20.05,0:24:21.62,Default,,0,0,0,,Керемет
Dialogue: 0,0:24:24.18,0:24:26.88,Default,,0,0,0,,Бұл Имари Курумидің денесі
Dialogue: 0,0:24:27.98,0:24:31.30,Default,,0,0,0,,Бұл менің жаңа денем
Dialogue: 0,0:24:34.91,0:24:36.39,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:24:49.76,0:24:50.86,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:24:50.86,0:24:52.19,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:24:52.19,0:24:53.90,Default,,0,0,0,,*(???Ай шығады???)
Dialogue: 0,0:25:39.51,0:25:40.58,Default,,0,0,0,,Минас
Dialogue: 0,0:25:42.08,0:25:48.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
