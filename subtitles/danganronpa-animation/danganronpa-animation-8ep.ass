Dialogue: 0,0:00:51.35,0:00:53.10,OP-EN,,0000,0000,0000,,Шындық алысқа сырғып барады
Dialogue: 0,0:00:53.10,0:00:55.06,OP-EN,,0000,0000,0000,,Көркем әдебиет жанды, біз оны ойнай бастаймыз
Dialogue: 0,0:00:55.06,0:00:56.73,OP-EN,,0000,0000,0000,,Үміт енді жоқ, жабық есік артында
Dialogue: 0,0:00:56.73,0:00:58.61,OP-EN,,0000,0000,0000,,Біз бұрын болған жерден алыстап бара жатқанда
Dialogue: 0,0:00:58.92,0:01:00.57,OP-EN,,0000,0000,0000,,Үміт пен үмітсіздік біртұтас болады
Dialogue: 0,0:01:00.57,0:01:02.57,OP-EN,,0000,0000,0000,,Мұның бәрі мағынасыз, біз қазірдің өзінде бастадық
Dialogue: 0,0:01:02.65,0:01:04.41,OP-EN,,0000,0000,0000,,Иә, біз бәріміз бірміз және бірміз
Dialogue: 0,0:01:04.49,0:01:06.41,OP-EN,,0000,0000,0000,,Ешқашан қарама-қарсы емес, біз бір ойынды ойнаймыз
Dialogue: 0,0:01:06.45,0:01:08.28,OP-EN,,0000,0000,0000,,Үміт пен үмітсіздік арасындағы жіңішке сызықтан өтіңіз
Dialogue: 0,0:01:08.28,0:01:10.12,OP-EN,,0000,0000,0000,,Шындықтан қашу, бірақ ол қазірдің өзінде бар
Dialogue: 0,0:01:10.12,0:01:12.04,OP-EN,,0000,0000,0000,,Қанша өтірік айтты, Мені таба алар ма білмеймін
Dialogue: 0,0:01:12.04,0:01:13.92,OP-EN,,0000,0000,0000,,Өмір сүру үшін бір ғана өмір, сондықтан ақылмен таңда
Dialogue: 0,0:01:14.08,0:01:15.79,OP-EN,,0000,0000,0000,,Бастар немесе құйрықтар, сіз өз жағыңызды білесіз бе?
Dialogue: 0,0:01:15.79,0:01:17.67,OP-EN,,0000,0000,0000,,Оның бір тиында болғаны маңызды емес
Dialogue: 0,0:01:17.88,0:01:19.46,OP-EN,,0000,0000,0000,,Егер сіз қол жеткізгіңіз келсе, сенуіңіз керек
Dialogue: 0,0:01:19.46,0:01:21.13,OP-EN,,0000,0000,0000,,Дәл қазір қосулы, есік міне кілт
Dialogue: 0,0:01:21.21,0:01:25.05,OP-EN,,0000,0000,0000,,Ізденіс өте ұзақ, біз оны жоғалтып жібердік
Dialogue: 0,0:01:25.22,0:01:28.56,OP-EN,,0000,0000,0000,,Үміттен асқан үміт сәулесі бар
Dialogue: 0,0:01:28.89,0:01:30.31,OP-EN,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:01:30.56,0:01:33.48,OP-EN,,0000,0000,0000,,Шындықты іздеңіз
Dialogue: 0,0:01:33.60,0:01:34.64,OP-EN,,0000,0000,0000,,Бұл дүниеде
Dialogue: 0,0:01:34.64,0:01:36.40,OP-EN,,0000,0000,0000,,Мұндай арнау бір-ақ рет келеді
Dialogue: 0,0:01:36.40,0:01:39.82,OP-EN,,0000,0000,0000,,Шатасудан өтіп, шешуін табыңыз
Dialogue: 0,0:01:40.15,0:01:43.74,OP-EN,,0000,0000,0000,,Бұралған зұлымдықты жеңу
Dialogue: 0,0:01:43.90,0:01:45.70,OP-EN,,0000,0000,0000,,Тек орындаңыз
Dialogue: 0,0:01:45.78,0:01:47.37,OP-EN,,0000,0000,0000,,Оған барыңыз
Dialogue: 0,0:01:47.57,0:01:49.66,OP-EN,,0000,0000,0000,,Ешқашан
Dialogue: 0,0:01:49.66,0:01:51.54,OP-EN,,0000,0000,0000,,Уақытты өлтіретініне сену керек
Dialogue: 0,0:23:12.67,0:23:15.34,ED-JP(R&W),,0000,0000,0000,,Сізге не керек?
Dialogue: 0,0:23:15.34,0:23:17.88,ED-JP(R&W),,0000,0000,0000,,Құлақ шуы 0 Өтірік естіледі
Dialogue: 0,0:23:18.01,0:23:21.97,ED-JP(R&W),,0000,0000,0000,,Менің әлемім қателескен сияқты.
Dialogue: 0,0:23:22.05,0:23:27.06,ED-JP(R&W),,0000,0000,0000,,Дүниелік нәпсіге тосқауыл қою 0 Ол балама айырбас дейді.
Dialogue: 0,0:23:27.22,0:23:31.39,ED-JP(R&W),,0000,0000,0000,,Азғыруға еріп, бос сөзге батып кеттім.
Dialogue: 0,0:23:31.52,0:23:33.88,ED-JP(R&W),,0000,0000,0000,,Патша ойынына міндетті түрде қатысу
Dialogue: 0,0:23:33.88,0:23:36.19,ED-JP(R&W),,0000,0000,0000,,Олар менің вето құқығымды тыңдамайды.
Dialogue: 0,0:23:36.19,0:23:40.03,ED-JP(R&W),,0000,0000,0000,,Тағайындалған тапсырма: «Ол адамды өлтір».
Dialogue: 0,0:23:40.03,0:23:43.03,ED-JP(R&W),,0000,0000,0000,,Үмітсізмін 0 Шаршадым 0 Бала сияқтымын
Dialogue: 0,0:23:43.03,0:23:45.24,ED-JP(R&W),,0000,0000,0000,,Мен кездескен шындық нөлге тең болды.
Dialogue: 0,0:23:45.24,0:23:50.45,ED-JP(R&W),,0000,0000,0000,,Өзіңнің қалауларың жоқ болып көріну немесе екіжүзділік танытудан пайда жоқ.
Dialogue: 0,0:23:50.45,0:23:53.71,ED-JP(R&W),,0000,0000,0000,,Бұл сіздің аңсаған арманыңыз ба? 0 Мен батыр болғым келеді
Dialogue: 0,0:23:53.71,0:23:54.54,ED-JP(R&W),,0000,0000,0000,,Уппупу
Dialogue: 0,0:23:54.54,0:23:57.55,ED-JP(R&W),,0000,0000,0000,,0 болашақта өкінемін
Dialogue: 0,0:23:57.55,0:24:00.97,ED-JP(R&W),,0000,0000,0000,,Ақымақтыққа дәрі жоқ
Dialogue: 0,0:02:13.31,0:02:17.73,STAFF,,0000,0000,0000,,Осы субтитр көзімен жасалған, God Subtitles Group (kamigami.org), жеткізу алмасу оқыту, коммерциялық мақсатта пайдалануға тыйым салынған
Dialogue: 0,0:02:17.98,0:02:23.99,STAFF,,0000,0000,0000,,Құдайдың субтитр жұбы
Dialogue: 0,0:02:17.98,0:02:20.79,STAFF,,0000,0000,0000,,Жапония: Акацуки және Казуто Иари Аудармасы: Казуто Иари және Ариса Аудармасы: Акацуки және Кадзуо Иари
Dialogue: 0,0:02:20.78,0:02:23.99,STAFF,,0000,0000,0000,,Уақыт: Фрейм және Ваджиюки Арнайы әсерлер: Ваджиюки Кейінгі кезең: Наксия
Dialogue: 0,0:00:13.07,0:00:14.73,TEXT JP (L),,0000,0000,0000,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:00:14.87,0:00:16.88,TEXT JP (L),,0000,0000,0000,,Маған бағынбауға тырыспа
Dialogue: 0,0:00:17.26,0:00:19.25,TEXT JP (L),,0000,0000,0000,,Уәде басқа.
Dialogue: 0,0:00:19.84,0:00:21.57,TEXT JP (L),,0000,0000,0000,,Мен шештім
Dialogue: 0,0:00:22.12,0:00:29.06,TEXT JP (L),,0000,0000,0000,,Мен енді шегінбеймін, саған бұдан былай жағымпаздық етпеймін, сенімен ұрысқан кезде маған бәрібір
Dialogue: 0,0:00:30.10,0:00:34.81,TEXT JP (L),,0000,0000,0000,,Иә, бірақ мен ұмытқан сияқты емеспін.
Dialogue: 0,0:00:34.81,0:00:36.17,TEXT JP (L),,0000,0000,0000,,Кепілге алынған зат
Dialogue: 0,0:00:37.75,0:00:39.87,TEXT JP (L),,0000,0000,0000,,Барымта дегеніміз не?
Dialogue: 0,0:00:40.43,0:00:45.27,TEXT JP (L),,0000,0000,0000,,Сонда бәлкім, Огами мырза ысқырушы шығар...?
Dialogue: 0,0:02:08.42,0:02:10.75,TEXT JP (L),,0000,0000,0000,,Үшінші сыныптағы сот процесі аяқталды.
Dialogue: 0,0:02:11.17,0:02:15.91,TEXT JP (L),,0000,0000,0000,,Біз мектеп ғимаратының жаңадан ашылған 4-қабатын зерттеуді бастадық.
Dialogue: 0,0:02:16.65,0:02:21.06,TEXT JP (L),,0000,0000,0000,,Осындай уақытта Тогами мен Фукава-чан бізбен бірге келсе екен.
Dialogue: 0,0:02:21.06,0:02:21.73,TEXT JP (L),,0000,0000,0000,,Хмм…
Dialogue: 0,0:02:22.68,0:02:25.01,TEXT JP (L),,0000,0000,0000,,Иә? Не болды, Неги?
Dialogue: 0,0:02:25.01,0:02:27.83,TEXT JP (L),,0000,0000,0000,,А... жоқ, бұл ештеңе емес.
Dialogue: 0,0:02:32.44,0:02:36.52,TEXT JP (L),,0000,0000,0000,,Қызметкерлер бөлмесі мен химия кабинеті 4-қабатта болды.
Dialogue: 0,0:02:37.65,0:02:38.63,TEXT JP (L),,0000,0000,0000,,Қараңыз және қараңыз
Dialogue: 0,0:02:39.02,0:02:42.01,TEXT JP (L),,0000,0000,0000,,Супер жоғары сапалы протеин Prodolmen X
Dialogue: 0,0:02:42.17,0:02:46.55,TEXT JP (L),,0000,0000,0000,,Абайлаңыз, Асахина, бұл улы дәрі.
Dialogue: 0,0:02:47.41,0:02:52.34,TEXT JP (L),,0000,0000,0000,,Музыка бөлмесіндегі ақпаратты өңдеу кабинеті
Dialogue: 0,0:02:54.15,0:02:55.76,TEXT JP (L),,0000,0000,0000,,Құлыпталған
Dialogue: 0,0:02:56.67,0:02:58.22,TEXT JP (L),,0000,0000,0000,,Соңында, директордың кабинеті
Dialogue: 0,0:02:59.08,0:03:00.36,TEXT JP (L),,0000,0000,0000,,Бұл да
Dialogue: 0,0:03:00.72,0:03:01.69,TEXT JP (L),,0000,0000,0000,,Наэги-кун
Dialogue: 0,0:03:02.95,0:03:03.93,TEXT JP (L),,0000,0000,0000,,Киригири мырза
Dialogue: 0,0:03:04.07,0:03:05.35,TEXT JP (L),,0000,0000,0000,,Қарсы боласыз ба?
Dialogue: 0,0:03:05.87,0:03:08.52,TEXT JP (L),,0000,0000,0000,,Жасырын бөлме қалай болды?
Dialogue: 0,0:03:09.74,0:03:15.29,TEXT JP (L),,0000,0000,0000,,Болды... Тергеуге тырысқанымда, біреу маған шабуыл жасады.
Dialogue: 0,0:03:16.46,0:03:19.26,TEXT JP (L),,0000,0000,0000,,Мен білмей тұрып, материалдар жоғалып кетті.
Dialogue: 0,0:03:19.43,0:03:20.33,TEXT JP (L),,0000,0000,0000,,Сонымен...
Dialogue: 0,0:03:20.84,0:03:21.76,TEXT JP (L),,0000,0000,0000,,Осымен
Dialogue: 0,0:03:23.23,0:03:26.30,TEXT JP (L),,0000,0000,0000,,Сонымен қатар, бұл бөлмеде біртүрлі жазба бар.
Dialogue: 0,0:03:26.77,0:03:29.34,TEXT JP (L),,0000,0000,0000,,Бұл туралы қазір айтпаған дұрыс.
Dialogue: 0,0:03:34.36,0:03:35.77,TEXT JP (L),,0000,0000,0000,,Айтпақшы, Наэги-кун
Dialogue: 0,0:03:36.78,0:03:40.19,TEXT JP (L),,0000,0000,0000,,Сіз бірдеңені жасырып тұрсыз ба?
Dialogue: 0,0:03:40.96,0:03:42.11,TEXT JP (L),,0000,0000,0000,,Жасырын нәрсе...?
Dialogue: 0,0:03:43.42,0:03:45.97,TEXT JP (L),,0000,0000,0000,,Огами мырза хабар таратушы болуы мүмкін
Dialogue: 0,0:03:46.90,0:03:49.97,TEXT JP (L),,0000,0000,0000,,Бірақ дәлелсіз күдіктер туралы айтатын болсақ...
Dialogue: 0,0:03:52.08,0:03:54.63,TEXT JP (L),,0000,0000,0000,,Жарайды, бұл жолы сот-медициналық сараптама міндетті болары анық.
Dialogue: 0,0:03:54.63,0:03:57.06,TEXT JP (L),,0000,0000,0000,,Сіз маған бұрын айттыңыз.
Dialogue: 0,0:03:57.06,0:03:59.43,TEXT JP (L),,0000,0000,0000,,Біз доспыз, сондықтан сенімді сөйлеңіз.
Dialogue: 0,0:04:01.69,0:04:02.74,TEXT JP (L),,0000,0000,0000,,Жетеді
Dialogue: 0,0:04:05.64,0:04:06.56,TEXT JP (L),,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:04:14.27,0:04:16.98,TEXT JP (L),,0000,0000,0000,,Соңында ештеңе таба алмадым.
Dialogue: 0,0:04:17.25,0:04:22.62,TEXT JP (L),,0000,0000,0000,,Бірақ ақпаратты өңдеу бөлмесінде және директордың кеңсесінде кейбір анықтамалар болуы мүмкін.
Dialogue: 0,0:04:23.44,0:04:25.25,TEXT JP (L),,0000,0000,0000,,Құлыпты ашқанша
Dialogue: 0,0:04:26.00,0:04:31.38,TEXT JP (L),,0000,0000,0000,,Огр, ең күшті примат гоминид, есікті оңай бұзады.
Dialogue: 0,0:04:32.95,0:04:34.37,TEXT JP (L),,0000,0000,0000,,Балалар
Dialogue: 0,0:04:35.02,0:04:41.72,TEXT JP (L),,0000,0000,0000,,Мектеп директорының кабинетінің есігін сындыру қаншама мектеп соғысы?
Dialogue: 0,0:04:43.48,0:04:46.92,TEXT JP (L),,0000,0000,0000,,Мен ережелерге байланғым келмеді, бірақ
Dialogue: 0,0:04:50.96,0:04:53.63,TEXT JP (L),,0000,0000,0000,,Мектеп ережелері қосылды...?
Dialogue: 0,0:04:55.07,0:04:57.81,TEXT JP (L),,0000,0000,0000,,Енді сіз сенімді бола аласыз.
Dialogue: 0,0:04:59.02,0:05:01.26,TEXT JP (L),,0000,0000,0000,,Осы уақытқа дейін бару нені білдіреді?
Dialogue: 0,0:05:01.90,0:05:06.86,TEXT JP (L),,0000,0000,0000,,Ақыр соңында, директордың кабинетінде және ақпаратты өңдеу бөлмесінде бірдеңе болып жатыр, солай емес пе?
Dialogue: 0,0:05:09.41,0:05:11.11,TEXT JP (L),,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:05:11.11,0:05:13.45,TEXT JP (L),,0000,0000,0000,,Бұл бізде әлі де бар.
Dialogue: 0,0:05:13.49,0:05:14.44,TEXT JP (L),,0000,0000,0000,,Иә?
Dialogue: 0,0:05:14.83,0:05:16.91,TEXT JP (L),,0000,0000,0000,,Бұл Alter Ego.
Dialogue: 0,0:05:19.76,0:05:22.09,TEXT JP (L),,0000,0000,0000,,Барлығы келді.
Dialogue: 0,0:05:22.33,0:05:25.06,TEXT JP (L),,0000,0000,0000,,Мен файлдың құлпын аштым.
Dialogue: 0,0:05:25.75,0:05:27.16,TEXT JP (L),,0000,0000,0000,,Ятбе
Dialogue: 0,0:05:30.51,0:05:36.75,TEXT JP (L),,0000,0000,0000,,Иә, бұл мектепте жоспар болған сияқты.
Dialogue: 0,0:05:37.67,0:05:40.98,TEXT JP (L),,0000,0000,0000,,Жоғары сынып оқушылары Кибогамин академиясында оқшауланады.
Dialogue: 0,0:05:41.22,0:05:44.50,TEXT JP (L),,0000,0000,0000,,Жоспар - бірге өмір сүру.
Dialogue: 0,0:05:45.78,0:05:48.86,TEXT JP (L),,0000,0000,0000,,Сонымен қатар, карантинге жатқызылған жоғары сынып оқушылары
Dialogue: 0,0:05:48.86,0:05:52.72,TEXT JP (L),,0000,0000,0000,,Кейбір жағдайларда бүкіл өміріңізді мектепте өткізуге тура келуі мүмкін.
Dialogue: 0,0:05:52.72,0:05:54.52,TEXT JP (L),,0000,0000,0000,,Мен...
Dialogue: 0,0:05:54.87,0:05:57.79,TEXT JP (L),,0000,0000,0000,,Біздің қазіргі жағдайымызбен бірдей.
Dialogue: 0,0:05:58.02,0:06:03.66,TEXT JP (L),,0000,0000,0000,,Және бұл жоспарды жасаған адам Кибогамин академиясының өзі болған сияқты.
Dialogue: 0,0:06:03.66,0:06:05.09,TEXT JP (L),,0000,0000,0000,,Мектеп...?
Dialogue: 0,0:06:05.37,0:06:07.58,TEXT JP (L),,0000,0000,0000,,Жоспардың жасалуына не себеп болды?
Dialogue: 0,0:06:07.58,0:06:13.76,TEXT JP (L),,0000,0000,0000,,Бір жыл бұрын болған «Адамзат тарихындағы ең үлкен және ең ауыр үмітсіз оқиға».
Dialogue: 0,0:06:14.47,0:06:18.62,TEXT JP (L),,0000,0000,0000,,«Адамзат тарихындағы ең үлкен және ең қорқынышты үмітсіз оқиға»…
Dialogue: 0,0:06:18.96,0:06:23.57,TEXT JP (L),,0000,0000,0000,,Осы оқиғаға байланысты Hope's Peak академиясы жабылуға мәжбүр болды.
Dialogue: 0,0:06:23.77,0:06:26.33,TEXT JP (L),,0000,0000,0000,,Карантиндік жоспар қозғалыста.
Dialogue: 0,0:06:26.77,0:06:31.15,TEXT JP (L),,0000,0000,0000,,Жоспарға жауапты адам - ​​Кибогамин академиясының директоры.
Dialogue: 0,0:06:32.99,0:06:39.17,TEXT JP (L),,0000,0000,0000,,Ол жасы 30-дан асқан адам, әлі мектепте оқитын сияқты.
Dialogue: 0,0:06:39.63,0:06:43.25,TEXT JP (L),,0000,0000,0000,,Содан кейін мектеп директоры Монокуманы басқарады.
Dialogue: 0,0:06:43.37,0:06:47.28,TEXT JP (L),,0000,0000,0000,,Мен мектеп директорын іздеймін.
Dialogue: 0,0:06:48.38,0:06:53.21,TEXT JP (L),,0000,0000,0000,,Мен оны міндетті түрде табамын.
Dialogue: 0,0:06:54.14,0:06:55.76,TEXT JP (L),,0000,0000,0000,,Киригири мырза...?
Dialogue: 0,0:06:56.35,0:07:01.11,TEXT JP (L),,0000,0000,0000,,О, мен мұны деректерден таптым.
Dialogue: 0,0:07:04.20,0:07:05.97,TEXT JP (L),,0000,0000,0000,,Тағы бір жұмбақ бейне?
Dialogue: 0,0:07:05.97,0:07:08.19,TEXT JP (L),,0000,0000,0000,,Бұл ненің фотосы...
Dialogue: 0,0:07:10.26,0:07:13.04,TEXT JP (L),,0000,0000,0000,,Мектеп туралы хабарландыру Мектеп туралы хабарландыру
Dialogue: 0,0:07:13.04,0:07:15.97,TEXT JP (L),,0000,0000,0000,,Тез арада гимназияға келіңіз.
Dialogue: 0,0:07:15.97,0:07:17.46,TEXT JP (L),,0000,0000,0000,,Бірге жинал
Dialogue: 0,0:07:17.69,0:07:20.71,TEXT JP (L),,0000,0000,0000,,Жақсы, мен кеткенім жөн.
Dialogue: 0,0:07:17.92,0:07:22.38,TEXT JP (L),,0000,0000,0000,,Срочно Срочно Срочно Срочно
Dialogue: 0,0:07:40.17,0:07:41.64,TEXT JP (L),,0000,0000,0000,,А, мен оны тастадым.
Dialogue: 0,0:07:41.97,0:07:44.47,TEXT JP (L),,0000,0000,0000,,Бізде қайғылы жаңалық бар.
Dialogue: 0,0:07:44.47,0:07:48.59,TEXT JP (L),,0000,0000,0000,,Кейбіреулеріңіз инсайдерсіздер.
Dialogue: 0,0:07:48.76,0:07:50.83,TEXT JP (L),,0000,0000,0000,,Ішінде...Информатор?
Dialogue: 0,0:07:51.07,0:07:55.31,TEXT JP (L),,0000,0000,0000,,Мен күткендей болды.
Dialogue: 0,0:07:55.44,0:07:58.53,TEXT JP (L),,0000,0000,0000,,Сонымен... инсайдер кім?
Dialogue: 0,0:07:59.80,0:08:02.92,TEXT JP (L),,0000,0000,0000,,Дүрбелең болма, мен саған айтамын.
Dialogue: 0,0:08:03.50,0:08:05.75,TEXT JP (L),,0000,0000,0000,,Ақпарат берушінің жеке басы...
Dialogue: 0,0:08:07.77,0:08:10.20,TEXT JP (L),,0000,0000,0000,,Бұл Сакура Огами.
Dialogue: 0,0:08:10.38,0:08:12.00,TEXT JP (L),,0000,0000,0000,,О... жалмауыз?
Dialogue: 0,0:08:12.00,0:08:13.50,TEXT JP (L),,0000,0000,0000,,Инсайдер…
Dialogue: 0,0:08:13.50,0:08:16.66,TEXT JP (L),,0000,0000,0000,,Не...не туралы айтып тұрсың? Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:08:16.76,0:08:18.35,TEXT JP (L),,0000,0000,0000,,Сәлем? Сакура-чан
Dialogue: 0,0:08:23.32,0:08:25.73,TEXT JP (L),,0000,0000,0000,,Осыдан кейін өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:08:25.73,0:08:30.02,TEXT JP (L),,0000,0000,0000,,Қайнатыңыз немесе қуырыңыз, өлтіріңіз немесе өлтіріңіз.
Dialogue: 0,0:08:36.90,0:08:39.20,TEXT JP (L),,0000,0000,0000,,Сакура...чан?
Dialogue: 0,0:08:40.57,0:08:43.90,TEXT JP (L),,0000,0000,0000,,Үндемегенім үшін кешіріңіз.
Dialogue: 0,0:08:43.90,0:08:47.91,TEXT JP (L),,0000,0000,0000,,Хмм...ол шынымен де қылмыскердің агенті болды ма?
Dialogue: 0,0:08:47.91,0:08:49.87,TEXT JP (L),,0000,0000,0000,,Мен сені осы уақытқа дейін алдап келдім.
Dialogue: 0,0:08:49.87,0:08:51.71,TEXT JP (L),,0000,0000,0000,,Жоқ... бұл дұрыс емес.
Dialogue: 0,0:08:51.71,0:08:54.96,TEXT JP (L),,0000,0000,0000,,Сакура-чанды жаңа ғана айла-шарғы жасап жатқанына сенімдімін.
Dialogue: 0,0:08:54.96,0:08:55.92,TEXT JP (L),,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:08:55.92,0:09:01.22,TEXT JP (L),,0000,0000,0000,,Себебі мен Огами-сан мен Монокуманың төбелескенін көрдім.
Dialogue: 0,0:09:01.93,0:09:05.82,TEXT JP (L),,0000,0000,0000,,Сол кезде Монокума кепілге алынғандарды не істеу керектігін айтты.
Dialogue: 0,0:09:06.61,0:09:08.16,TEXT JP (L),,0000,0000,0000,,Сіз мұны естідіңіз бе?
Dialogue: 0,0:09:08.89,0:09:12.18,TEXT JP (L),,0000,0000,0000,,Огами-сан кепілге алынғандықтан бағынуға мәжбүр болды.
Dialogue: 0,0:09:12.56,0:09:14.19,TEXT JP (L),,0000,0000,0000,,Енді, ұйымдастырушыға опасыздық жаса...
Dialogue: 0,0:09:14.19,0:09:19.01,TEXT JP (L),,0000,0000,0000,,Бұл күлкілі. Сіз ертегі әлемінде өмір сүріп жатырсыз ба?
Dialogue: 0,0:09:19.45,0:09:23.85,TEXT JP (L),,0000,0000,0000,,Әй, егер сен шынымен де басшыға опасыздық жасасаң, маған жауап бер.
Dialogue: 0,0:09:24.39,0:09:26.16,TEXT JP (L),,0000,0000,0000,,Ұйымдастырушы кім?
Dialogue: 0,0:09:26.91,0:09:30.26,TEXT JP (L),,0000,0000,0000,,Кешіріңіз, мен бұл туралы білмеймін.
Dialogue: 0,0:09:31.20,0:09:33.02,TEXT JP (L),,0000,0000,0000,,Барған сайын күдікті болып барады.
Dialogue: 0,0:09:33.45,0:09:37.39,TEXT JP (L),,0000,0000,0000,,Сонымен, басшы сізге не істеуді бұйырды?
Dialogue: 0,0:09:39.82,0:09:48.07,TEXT JP (L),,0000,0000,0000,,Мектеп өмірінде кісі өлтіру болмаса, тығырыққа тірелсе, бұл біреуді өлтіру.
Dialogue: 0,0:09:48.95,0:09:53.94,TEXT JP (L),,0000,0000,0000,,Мен көремін. Сонда олар әлі де біздің өмірімізді мақсат етіп отыр ма?
Dialogue: 0,0:09:53.94,0:09:55.56,TEXT JP (L),,0000,0000,0000,,Сондықтан басқаша.
Dialogue: 0,0:09:55.56,0:10:01.11,TEXT JP (L),,0000,0000,0000,,Күте тұрыңыз, енді мен үшін ұрысудың қажеті жоқ.
Dialogue: 0,0:10:02.09,0:10:04.84,TEXT JP (L),,0000,0000,0000,,Барлығы менің жауапкершілігімде
Dialogue: 0,0:10:05.32,0:10:08.58,TEXT JP (L),,0000,0000,0000,,Асахина, кешіріңіз.
Dialogue: 0,0:10:09.33,0:10:11.43,TEXT JP (L),,0000,0000,0000,,Сакура-чан...
Dialogue: 0,0:10:11.43,0:10:15.14,TEXT JP (L),,0000,0000,0000,,Саған сырымды айтудан талай рет тартындым.
Dialogue: 0,0:10:15.60,0:10:18.03,TEXT JP (L),,0000,0000,0000,,Бірақ мен қорықтым
Dialogue: 0,0:10:18.17,0:10:21.12,TEXT JP (L),,0000,0000,0000,,Мені жек көресің бе деп қорықтым.
Dialogue: 0,0:10:21.12,0:10:22.30,TEXT JP (L),,0000,0000,0000,,Бұл дұрыс емес...!
Dialogue: 0,0:10:23.94,0:10:29.30,TEXT JP (L),,0000,0000,0000,,Кешіріңіз, бұл қате болса да, мен жауапты боламын.
Dialogue: 0,0:10:30.26,0:10:32.16,TEXT JP (L),,0000,0000,0000,,Оны дұрыс емес жерге пышақтап салыңыз.
Dialogue: 0,0:10:32.16,0:10:35.59,TEXT JP (L),,0000,0000,0000,,Бұдан былай Окамиге абай болған жөн сияқты.
Dialogue: 0,0:10:35.90,0:10:37.71,TEXT JP (L),,0000,0000,0000,,Мен не істерімді білмеймін
Dialogue: 0,0:10:38.02,0:10:39.96,TEXT JP (L),,0000,0000,0000,,Тоғами-кун, солай айтасың...
Dialogue: 0,0:10:39.96,0:10:42.69,TEXT JP (L),,0000,0000,0000,,Жоқ, Тогами-цчи дұрыс айтады.
Dialogue: 0,0:10:42.69,0:10:45.53,TEXT JP (L),,0000,0000,0000,,Ку...ұйымдастырушының агенті.
Dialogue: 0,0:10:45.86,0:10:50.34,TEXT JP (L),,0000,0000,0000,,Сакура-чанды неге түсінбейсің?
Dialogue: 0,0:10:50.34,0:10:53.50,TEXT JP (L),,0000,0000,0000,,Оның не істеп жатқанын тек сен ғана білесің.
Dialogue: 0,0:10:54.04,0:10:56.83,TEXT JP (L),,0000,0000,0000,,Оның кім екенін де білмедің.
Dialogue: 0,0:10:57.75,0:10:59.51,TEXT JP (L),,0000,0000,0000,,Бұл...
Dialogue: 0,0:10:59.71,0:11:03.40,TEXT JP (L),,0000,0000,0000,,Огре шеберді жеңсе, сенуге болатын еді.
Dialogue: 0,0:11:03.40,0:11:04.19,TEXT JP (L),,0000,0000,0000,,Иә…♡
Dialogue: 0,0:11:04.51,0:11:06.75,TEXT JP (L),,0000,0000,0000,,Бірдеңе болса не істеуім керек?
Dialogue: 0,0:11:07.84,0:11:12.43,TEXT JP (L),,0000,0000,0000,,Оками өлсе де, ұйымдастырушы жағында бір адам кем болады.
Dialogue: 0,0:11:12.71,0:11:13.87,TEXT JP (L),,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:11:17.71,0:11:21.76,TEXT JP (L),,0000,0000,0000,,Бұл... адам емес.
Dialogue: 0,0:11:22.71,0:11:27.02,TEXT JP (L),,0000,0000,0000,,Сіз өлетін адам болуыңыз керек.
Dialogue: 0,0:11:28.43,0:11:31.47,TEXT JP (L),,0000,0000,0000,,Бұл қызық. Мен оны өлтіріп көруім керек пе?
Dialogue: 0,0:11:31.81,0:11:35.12,TEXT JP (L),,0000,0000,0000,,Тек орындаңыз. Бұл жерде ереже солай.
Dialogue: 0,0:11:36.06,0:11:39.36,TEXT JP (L),,0000,0000,0000,,Сіз мұны істей алмаймын деп ойлайсыз ба?
Dialogue: 0,0:11:39.65,0:11:43.36,TEXT JP (L),,0000,0000,0000,,Мынау... мынау, бякуя-сама.
Dialogue: 0,0:11:43.36,0:11:46.06,TEXT JP (L),,0000,0000,0000,,Бұл миллион өлімге ғана емес, миллиардтаған өлімге де тең.
Dialogue: 0,0:11:46.26,0:11:47.17,TEXT JP (L),,0000,0000,0000,,Тоқта
Dialogue: 0,0:11:48.26,0:11:51.72,TEXT JP (L),,0000,0000,0000,,Егер біз осылай ұрысатын болсақ, оған ұйымдастырушы кінәлі.
Dialogue: 0,0:11:54.51,0:11:56.76,TEXT JP (L),,0000,0000,0000,,Бөлмеге оралу
Dialogue: 0,0:12:00.81,0:12:01.75,TEXT JP (L),,0000,0000,0000,,Тогами-кун
Dialogue: 0,0:12:01.98,0:12:05.47,TEXT JP (L),,0000,0000,0000,,Сіз басқалардың сезіміне соншалықты төмен қарайсыз.
Dialogue: 0,0:12:05.47,0:12:06.94,TEXT JP (L),,0000,0000,0000,,Бұған не болды?
Dialogue: 0,0:12:07.20,0:12:08.36,TEXT JP (L),,0000,0000,0000,,Кеңес!
Dialogue: 0,0:12:08.70,0:12:12.66,TEXT JP (L),,0000,0000,0000,,Олай етсең, ерте ме, кеш пе аяғыңнан сыпырылып кетесің.
Dialogue: 0,0:12:13.04,0:12:15.63,TEXT JP (L),,0000,0000,0000,,Мен сізге ризамын.
Dialogue: 0,0:12:17.00,0:12:20.99,TEXT JP (L),,0000,0000,0000,,Бұл мектептегі хабар. Сағат 10.00.
Dialogue: 0,0:12:20.99,0:12:24.76,TEXT JP (L),,0000,0000,0000,,Қазір түн.
Dialogue: 0,0:12:59.41,0:13:00.91,TEXT JP (L),,0000,0000,0000,,Не болды?
Dialogue: 0,0:13:01.04,0:13:05.38,TEXT JP (L),,0000,0000,0000,,Ху, Фукаваччи және Асахи Накчи төбелесіп қалды.
Dialogue: 0,0:13:06.98,0:13:12.10,TEXT JP (L),,0000,0000,0000,,Әлгі тәбетсіз ерлер мен балалар, асығыңыздар, әлгі әйелді өзіңізбен бірге алыңыз.
Dialogue: 0,0:13:12.63,0:13:13.87,TEXT JP (L),,0000,0000,0000,,бетін таныған адамның атын жазсаң, сол адам өліп қалады деген дәптер екенін айтты
Dialogue: 0,0:13:13.99,0:13:16.58,TEXT JP (L),,0000,0000,0000,,Кесу, кесу, кесу
Dialogue: 0,0:13:16.58,0:13:19.16,TEXT JP (L),,0000,0000,0000,,Мен ләззат уақытының дәмін татамын
Dialogue: 0,0:13:19.34,0:13:20.51,TEXT JP (L),,0000,0000,0000,,Асахина-сан
Dialogue: 0,0:13:21.56,0:13:23.49,TEXT JP (L),,0000,0000,0000,,Әзірге емханаға барыңыз.
Dialogue: 0,0:13:23.56,0:13:25.57,TEXT JP (L),,0000,0000,0000,,Хагакуре-кун, маған көмектес
Dialogue: 0,0:13:34.66,0:13:37.10,TEXT JP (L),,0000,0000,0000,,Сызылған жерлерге жақсы.
Dialogue: 0,0:13:37.10,0:13:39.17,TEXT JP (L),,0000,0000,0000,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:13:40.55,0:13:43.87,TEXT JP (L),,0000,0000,0000,,Егер мен айқайламасам, олар мені өлтіретін еді.
Dialogue: 0,0:13:43.87,0:13:45.27,TEXT JP (L),,0000,0000,0000,,Маған рахмет
Dialogue: 0,0:13:45.63,0:13:49.29,TEXT JP (L),,0000,0000,0000,,Сізге көп рахмет және жақсы екеніңізге сенемін.
Dialogue: 0,0:13:49.96,0:13:52.06,TEXT JP (L),,0000,0000,0000,,Керісінше, дұшпандық сезіну керек.
Dialogue: 0,0:13:49.66,0:13:50.90,TEXT JP (L),,0000,0000,0000,,Асахина-сан
Dialogue: 0,0:13:52.54,0:13:55.20,TEXT JP (L),,0000,0000,0000,,Фукава мырзамен не болды?
Dialogue: 0,0:13:56.98,0:14:01.07,TEXT JP (L),,0000,0000,0000,,Сакура-чан туралы аздап дауласып қалдық.
Dialogue: 0,0:14:02.57,0:14:03.42,TEXT JP (L),,0000,0000,0000,,Өйткені...
Dialogue: 0,0:14:04.58,0:14:08.62,TEXT JP (L),,0000,0000,0000,,Өйткені менің қымбатты досым туралы жаман сөздер айтылып жатыр.
Dialogue: 0,0:14:09.59,0:14:10.71,TEXT JP (L),,0000,0000,0000,,Асахина
Dialogue: 0,0:14:10.85,0:14:12.16,TEXT JP (L),,0000,0000,0000,,Не болды?
Dialogue: 0,0:14:14.23,0:14:17.28,TEXT JP (L),,0000,0000,0000,,Бұл жараға не болды?
Dialogue: 0,0:14:17.28,0:14:20.87,TEXT JP (L),,0000,0000,0000,,А, жоқ, бұл маңызды емес.
Dialogue: 0,0:14:21.87,0:14:24.38,TEXT JP (L),,0000,0000,0000,,Ой, ау, мен емеспін.
Dialogue: 0,0:14:24.38,0:14:28.22,TEXT JP (L),,0000,0000,0000,,Бұл геноцид. Бұл әлгі азғын кісі өлтірушінің ісі.
Dialogue: 0,0:14:29.97,0:14:35.33,TEXT JP (L),,0000,0000,0000,,Мен емес, Асахинаның ренжігенін қаламаймын.
Dialogue: 0,0:14:35.63,0:14:40.77,TEXT JP (L),,0000,0000,0000,,О, Құдайым
Dialogue: 0,0:14:41.20,0:14:43.96,TEXT JP (L),,0000,0000,0000,,Маған көмектесіңізші
Dialogue: 0,0:14:46.08,0:14:50.13,TEXT JP (L),,0000,0000,0000,,Мен сені кешірмеймін мен сені кешірмеймін
Dialogue: 0,0:14:50.13,0:14:52.07,TEXT JP (L),,0000,0000,0000,,Огами-сан, сабыр ет.
Dialogue: 0,0:14:52.07,0:14:53.20,TEXT JP (L),,0000,0000,0000,,Сакура-чан
Dialogue: 0,0:14:53.56,0:14:54.91,TEXT JP (L),,0000,0000,0000,,Не шу?
Dialogue: 0,0:14:56.38,0:14:59.09,TEXT JP (L),,0000,0000,0000,,Киригири мырза да Огами мырзаны тоқтатты.
Dialogue: 0,0:15:01.83,0:15:03.78,TEXT JP (L),,0000,0000,0000,,Тоқтаудың қажеті жоқ
Dialogue: 0,0:15:04.38,0:15:06.20,TEXT JP (L),,0000,0000,0000,,Мен ештеңе істемеймін
Dialogue: 0,0:15:07.03,0:15:10.24,TEXT JP (L),,0000,0000,0000,,Бұл жай ғана тәртіп мәселесі.
Dialogue: 0,0:15:10.24,0:15:11.57,TEXT JP (L),,0000,0000,0000,,Күтіңіз, күтіңіз.
Dialogue: 0,0:15:19.74,0:15:20.85,TEXT JP (L),,0000,0000,0000,,Осымен
Dialogue: 0,0:15:21.42,0:15:22.89,TEXT JP (L),,0000,0000,0000,,Сіз әлі де ашулысыз ба?
Dialogue: 0,0:15:25.27,0:15:28.67,TEXT JP (L),,0000,0000,0000,,Сіз ашулысыз... солай ма? Бұл дұрыс.
Dialogue: 0,0:15:29.77,0:15:30.87,TEXT JP (L),,0000,0000,0000,,Жоқ
Dialogue: 0,0:15:32.40,0:15:36.58,TEXT JP (L),,0000,0000,0000,,Наэги-кунның жасырған нәрсесі Огами-сан туралы болса керек.
Dialogue: 0,0:15:37.16,0:15:41.62,TEXT JP (L),,0000,0000,0000,,Нақты емес ақпаратпен жұртты шатастырмау үшін үндемедің.
Dialogue: 0,0:15:43.57,0:15:47.45,TEXT JP (L),,0000,0000,0000,,Мұндай көзқарас, Наэги-кун, сен сондай тәкаппарсың.
Dialogue: 0,0:15:47.45,0:15:48.14,TEXT JP (L),,0000,0000,0000,,Иә?
Dialogue: 0,0:15:48.35,0:15:52.96,TEXT JP (L),,0000,0000,0000,,Міне, бұл сен маған сенбейсің деген сөз.
Dialogue: 0,0:15:53.90,0:15:56.76,TEXT JP (L),,0000,0000,0000,,Дұрыс, кешіріңіз.
Dialogue: 0,0:15:56.76,0:15:59.55,TEXT JP (L),,0000,0000,0000,,Жақсы, мен оны ұмытамын.
Dialogue: 0,0:15:59.98,0:16:05.36,TEXT JP (L),,0000,0000,0000,,Мен де аздап ашуландым.
Dialogue: 0,0:16:05.57,0:16:06.18,TEXT JP (L),,0000,0000,0000,,Иә?
Dialogue: 0,0:16:06.71,0:16:08.34,TEXT JP (L),,0000,0000,0000,,Бұл мәселе енді аяқталды.
Dialogue: 0,0:16:08.74,0:16:13.52,TEXT JP (L),,0000,0000,0000,,Альтер Эгоның тағы да айтары бар сияқты.
Dialogue: 0,0:16:14.48,0:16:15.99,TEXT JP (L),,0000,0000,0000,,Сен келдің.
Dialogue: 0,0:16:16.24,0:16:19.52,TEXT JP (L),,0000,0000,0000,,Альтер Эгоның маған қоңырау шалуында не болды?
Dialogue: 0,0:16:22.68,0:16:28.12,TEXT JP (L),,0000,0000,0000,,Иә, мені желі байланысы бар жерге апарғаныңызды қалаймын.
Dialogue: 0,0:16:30.46,0:16:34.08,TEXT JP (L),,0000,0000,0000,,Мен де барлығымен бірге қолымнан келгеннің бәрін жасағым келеді.
Dialogue: 0,0:16:35.03,0:16:37.48,TEXT JP (L),,0000,0000,0000,,Бұл мектептен қашып құтылу
Dialogue: 0,0:16:38.76,0:16:42.38,TEXT JP (L),,0000,0000,0000,,Сондықтан мен бәріне пайдалы болуым үшін,
Dialogue: 0,0:16:42.38,0:16:45.17,TEXT JP (L),,0000,0000,0000,,Желіге қосылудан басқа амал жоқ.
Dialogue: 0,0:16:45.38,0:16:46.86,TEXT JP (L),,0000,0000,0000,,Бірақ
Dialogue: 0,0:16:50.52,0:16:52.62,TEXT JP (L),,0000,0000,0000,,Мен оның қауіпті екенін білемін.
Dialogue: 0,0:16:53.21,0:16:55.87,TEXT JP (L),,0000,0000,0000,,Сонда да мен мұны істеуім керек.
Dialogue: 0,0:16:56.81,0:17:01.55,TEXT JP (L),,0000,0000,0000,,Жарайды, әркім туралы ойлау маған батылдық береді.
Dialogue: 0,0:17:02.37,0:17:07.64,TEXT JP (L),,0000,0000,0000,,Жасанды интеллект не дейді деп таң қалуыңыз мүмкін, бірақ бұл шындық.
Dialogue: 0,0:17:09.28,0:17:12.98,TEXT JP (L),,0000,0000,0000,,Наэги-кун, оны желіге қосайық.
Dialogue: 0,0:17:12.98,0:17:14.41,TEXT JP (L),,0000,0000,0000,,Иә, бірақ...
Dialogue: 0,0:17:14.88,0:17:17.09,TEXT JP (L),,0000,0000,0000,,Мен оның сезімін қондырғым келеді.
Dialogue: 0,0:17:18.14,0:17:19.40,TEXT JP (L),,0000,0000,0000,,Киригири мырза...
Dialogue: 0,0:17:20.01,0:17:25.17,TEXT JP (L),,0000,0000,0000,,Мүмкін, бұл жерде ұйымдастырушы байқамауы мүмкін.
Dialogue: 0,0:17:25.71,0:17:30.25,TEXT JP (L),,0000,0000,0000,,Екінші қабаттағы жасырын бөлме Ол бөлмеде де бақылау камерасы болған жоқ.
Dialogue: 0,0:17:30.47,0:17:33.60,TEXT JP (L),,0000,0000,0000,,Сондай-ақ желілік орта да болуы керек.
Dialogue: 0,0:17:33.94,0:17:38.75,TEXT JP (L),,0000,0000,0000,,Дегенмен, бұл міндетті түрде ұйымдастырушы желіні бақылап отырған жоқ дегенді білдірмейді.
Dialogue: 0,0:17:39.86,0:17:42.95,TEXT JP (L),,0000,0000,0000,,Бірақ байқап көруге тұрарлық.
Dialogue: 0,0:17:43.45,0:17:44.50,TEXT JP (L),,0000,0000,0000,,Түсіндім
Dialogue: 0,0:17:44.57,0:17:47.79,TEXT JP (L),,0000,0000,0000,,Содан кейін мен Альтер Эгоды алып кетемін.
Dialogue: 0,0:17:53.89,0:17:55.17,TEXT JP (L),,0000,0000,0000,,Ол қытықтайды
Dialogue: 0,0:17:58.13,0:17:59.53,TEXT JP (L),,0000,0000,0000,,Бір минут күтіңіз
Dialogue: 0,0:18:09.17,0:18:10.96,TEXT JP (L),,0000,0000,0000,,Иә, мен бара аламын деп ойлаймын.
Dialogue: 0,0:18:12.45,0:18:14.16,TEXT JP (L),,0000,0000,0000,,Қалғанын маған қалдырыңыз
Dialogue: 0,0:18:14.48,0:18:16.87,TEXT JP (L),,0000,0000,0000,,Мен міндетті түрде анықтама табамын
Dialogue: 0,0:18:17.19,0:18:19.31,TEXT JP (L),,0000,0000,0000,,Маған сеніп, мені күт
Dialogue: 0,0:18:19.71,0:18:20.38,TEXT JP (L),,0000,0000,0000,,Иә
Dialogue: 1,0:18:25.90,0:18:28.40,TEXT JP (L),,0000,0000,0000,,Мен де сенің дос бола аламын ба?
Dialogue: 1,0:18:28.67,0:18:30.84,TEXT JP (L),,0000,0000,0000,,Рахмет, Наэги-кун.
Dialogue: 0,0:18:31.10,0:18:31.81,TEXT JP (L),,0000,0000,0000,,Иә
Dialogue: 0,0:18:36.25,0:18:39.92,TEXT JP (L),,0000,0000,0000,,Жоғары мектеп деңгейіндегі жекпе-жек суретшісі (lol)
Dialogue: 0,0:18:40.01,0:18:42.05,TEXT JP (L),,0000,0000,0000,,Құпия бөлмені өлтіру (lol)
Dialogue: 0,0:18:43.58,0:18:47.74,TEXT JP (L),,0000,0000,0000,,Жақшаның ұлылығын түсіндім.
Dialogue: 0,0:18:48.03,0:18:50.13,TEXT JP (L),,0000,0000,0000,,Кез келген жағымсыз сөздер
Жай ғана
Dialogue: 0,0:18:50.13,0:18:54.79,TEXT JP (L),,0000,0000,0000,,қосыңыз және ол бірден оң болады.
Dialogue: 0,0:18:55.57,0:18:56.69,TEXT JP (L),,0000,0000,0000,,Ал енді
Dialogue: 0,0:18:56.69,0:18:59.92,TEXT JP (L),,0000,0000,0000,,Қазіргі уақытта жеті студент аман қалды.
Dialogue: 0,0:19:00.33,0:19:02.55,TEXT JP (L),,0000,0000,0000,,Ол қайтадан төмендей ме?
Dialogue: 0,0:19:02.97,0:19:04.37,TEXT JP (L),,0000,0000,0000,,Ей! Польнареф!
Dialogue: 0,0:19:08.14,0:19:10.15,TEXT JP (L),,0000,0000,0000,,Мен қазір не істей аламын
Dialogue: 0,0:19:13.68,0:19:17.50,TEXT JP (L),,0000,0000,0000,,Менің қазір қолымнан келетіні – достарыма сену.
Dialogue: 0,0:19:17.94,0:19:18.82,TEXT JP (L),,0000,0000,0000,,Наэги-кун
Dialogue: 0,0:19:26.22,0:19:27.25,TEXT JP (L),,0000,0000,0000,,Капитан, 3D маневрге көшейік
Dialogue: 0,0:19:27.87,0:19:29.78,TEXT JP (L),,0000,0000,0000,,Енді, Сакура-чан...
Dialogue: 0,0:19:33.15,0:19:34.25,TEXT JP (L),,0000,0000,0000,,Огами мырза?
Dialogue: 0,0:19:35.36,0:19:36.48,TEXT JP (L),,0000,0000,0000,,Есік ашылмайды
Dialogue: 0,0:19:37.62,0:19:39.51,TEXT JP (L),,0000,0000,0000,,Огами-сан, мына жерді аш.
Dialogue: 0,0:19:39.90,0:19:42.59,TEXT JP (L),,0000,0000,0000,,Біраз уақыттан бері жауап алған жоқпын...
Dialogue: 0,0:19:42.59,0:19:43.53,TEXT JP (L),,0000,0000,0000,,Бұл...
Dialogue: 0,0:19:43.92,0:19:46.24,TEXT JP (L),,0000,0000,0000,,Есік құлыптаулы ма?
Dialogue: 0,0:19:46.64,0:19:50.17,TEXT JP (L),,0000,0000,0000,,Бөлменің ішінде бірдеңе соғып жатыр ма деп ойлаймын.
Dialogue: 0,0:19:50.40,0:19:52.62,TEXT JP (L),,0000,0000,0000,,Мен не істеуім керек? Не істеуім керек?
Dialogue: 0,0:20:04.79,0:20:05.76,TEXT JP (L),,0000,0000,0000,,Огами мырза
Dialogue: 0,0:20:20.85,0:20:23.19,TEXT JP (L),,0000,0000,0000,,Мәйіт табылды
Dialogue: 0,0:20:23.19,0:20:28.08,TEXT JP (L),,0000,0000,0000,,Белгілі бір бос уақыттан кейін сыныптық сынақ өткізіледі.
Dialogue: 0,0:20:28.51,0:20:29.70,TEXT JP (L),,0000,0000,0000,,Бұл...
Dialogue: 0,0:20:29.70,0:20:32.35,TEXT JP (L),,0000,0000,0000,,Бұл тағы да болды.
Dialogue: 0,0:20:32.35,0:20:33.10,TEXT JP (L),,0000,0000,0000,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:20:33.61,0:20:36.73,TEXT JP (L),,0000,0000,0000,,Сакура-чан қайтыс болды.
Dialogue: 0,0:20:37.04,0:20:40.50,TEXT JP (L),,0000,0000,0000,,Мен барлығына телефон соғуым керек.
Dialogue: 0,0:20:41.32,0:20:42.49,TEXT JP (L),,0000,0000,0000,,Асахина-сан
Dialogue: 0,0:20:42.72,0:20:45.62,TEXT JP (L),,0000,0000,0000,,Жарайды, жарайды.
Dialogue: 0,0:20:56.04,0:20:58.79,TEXT JP (L),,0000,0000,0000,,Мәйіттің басындағы екі соққы ізі.
Dialogue: 0,0:21:01.71,0:21:03.51,TEXT JP (L),,0000,0000,0000,,Ауыздан қан құсу
Dialogue: 0,0:21:06.19,0:21:08.56,TEXT JP (L),,0000,0000,0000,,Аяқтың үстіңгі жағындағы ұнтақ
Dialogue: 0,0:21:10.64,0:21:13.38,TEXT JP (L),,0000,0000,0000,,Киригири-сан керемет.
Dialogue: 0,0:21:13.91,0:21:16.50,TEXT JP (L),,0000,0000,0000,,Қанша көрсем де үйренбеймін.
Dialogue: 0,0:21:16.66,0:21:20.78,TEXT JP (L),,0000,0000,0000,,Мен бұған дейін мәйіттермен араласуға мүмкіндік алғаныма сенімдімін.
Dialogue: 0,0:21:20.78,0:21:21.43,TEXT JP (L),,0000,0000,0000,,Иә?
Dialogue: 0,0:21:21.43,0:21:23.83,TEXT JP (L),,0000,0000,0000,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:21:23.83,0:21:28.10,TEXT JP (L),,0000,0000,0000,,Оқиға орнындағы есік ішінен пломбаланған.
Dialogue: 0,0:21:28.86,0:21:31.09,TEXT JP (L),,0000,0000,0000,,Бұл жабық бөлмедегі кісі өлтіру.
Dialogue: 0,0:21:33.47,0:21:35.99,TEXT JP (L),,0000,0000,0000,,Жабық бөлме... кісі өлтіру
Dialogue: 0,0:21:36.17,0:21:36.90,TEXT JP (L),,0000,0000,0000,,Иә
Dialogue: 0,0:21:39.33,0:21:41.75,TEXT JP (L),,0000,0000,0000,,Есік де құлыптаулы болды.
Dialogue: 0,0:21:42.34,0:21:46.00,TEXT JP (L),,0000,0000,0000,,Қылмыскер Огами-санды қалай өлтіре алды?
Dialogue: 0,0:21:51.13,0:21:52.74,TEXT JP (L),,0000,0000,0000,,О, дәу! ?
Dialogue: 0,0:21:52.74,0:21:55.66,TEXT JP (L),,0000,0000,0000,,О, бұл өлді.
Dialogue: 0,0:21:56.27,0:21:58.67,TEXT JP (L),,0000,0000,0000,,Мен мәйіт табылды деген хабарды естідім.
Dialogue: 0,0:21:58.98,0:21:59.59,TEXT JP (L),,0000,0000,0000,,Хун
Dialogue: 0,0:21:59.89,0:22:00.71,TEXT JP (L),,0000,0000,0000,,Он құдай
Dialogue: 0,0:22:01.31,0:22:02.22,TEXT JP (L),,0000,0000,0000,,Хагакуре
Dialogue: 0,0:22:02.66,0:22:03.43,TEXT JP (L),,0000,0000,0000,,Фукава
Dialogue: 0,0:22:03.67,0:22:08.51,TEXT JP (L),,0000,0000,0000,,Сакура-чанды өлтірген үш адамның ішінде кім?
Dialogue: 0,0:22:08.68,0:22:09.37,TEXT JP (L),,0000,0000,0000,,​​О?
Dialogue: 0,0:22:08.68,0:22:09.37,TEXT JP (L),,0000,0000,0000,,Иә?
Dialogue: 0,0:22:10.15,0:22:12.84,TEXT JP (L),,0000,0000,0000,,Неліктен олай ойлайсың?
Dialogue: 0,0:22:12.84,0:22:17.57,TEXT JP (L),,0000,0000,0000,,Сакура-чан үшеуін ойын-сауық бөлмесіне шақырды.
Dialogue: 0,0:22:19.42,0:22:20.75,TEXT JP (L),,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:22:21.17,0:22:28.08,TEXT JP (L),,0000,0000,0000,,Кінәлі Сакура-чанмен соңғы рет кездескен үшеуіңіздің арасында болуы керек.
Dialogue: 0,0:02:02.59,0:02:05.93,TITLE (Yellow),,0000,0000,0000,,AllAllApologies
