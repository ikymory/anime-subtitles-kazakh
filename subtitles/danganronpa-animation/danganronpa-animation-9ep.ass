Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:52.42,0:00:54.17,OP-EN,,0,0,0,,Шындық алысқа сырғып барады
Dialogue: 0,0:00:54.17,0:00:56.13,OP-EN,,0,0,0,,Көркем әдебиет жанды, біз оны ойнай бастаймыз
Dialogue: 0,0:00:56.13,0:00:57.80,OP-EN,,0,0,0,,Үміт енді жоқ, жабық есік артында
Dialogue: 0,0:00:57.80,0:00:59.68,OP-EN,,0,0,0,,Біз бұрын болған жерден алыстап бара жатқанда
Dialogue: 0,0:00:59.99,0:01:01.64,OP-EN,,0,0,0,,Үміт пен үмітсіздік біртұтас болады
Dialogue: 0,0:01:01.64,0:01:03.64,OP-EN,,0,0,0,,Мұның бәрі мағынасыз, біз қазірдің өзінде бастадық
Dialogue: 0,0:01:03.72,0:01:05.48,OP-EN,,0,0,0,,Иә, біз бәріміз бірміз және бірміз
Dialogue: 0,0:01:05.56,0:01:07.48,OP-EN,,0,0,0,,Ешқашан қарама-қарсы емес, біз бір ойынды ойнаймыз
Dialogue: 0,0:01:07.52,0:01:09.35,OP-EN,,0,0,0,,Үміт пен үмітсіздік арасындағы жіңішке сызықтан өтіңіз
Dialogue: 0,0:01:09.35,0:01:11.19,OP-EN,,0,0,0,,Шындықтан қашу, бірақ ол қазірдің өзінде бар
Dialogue: 0,0:01:11.19,0:01:13.11,OP-EN,,0,0,0,,Қанша өтірік айтты, Мені таба алар ма білмеймін
Dialogue: 0,0:01:13.11,0:01:14.99,OP-EN,,0,0,0,,Өмір сүру үшін бір ғана өмір, сондықтан ақылмен таңда
Dialogue: 0,0:01:15.15,0:01:16.86,OP-EN,,0,0,0,,Бастар немесе құйрықтар, сіз өз жағыңызды білесіз бе?
Dialogue: 0,0:01:16.86,0:01:18.74,OP-EN,,0,0,0,,Оның бір тиында болғаны маңызды емес
Dialogue: 0,0:01:18.95,0:01:20.53,OP-EN,,0,0,0,,Егер сіз қол жеткізгіңіз келсе, сенуіңіз керек
Dialogue: 0,0:01:20.53,0:01:22.20,OP-EN,,0,0,0,,Дәл қазір қосулы, есік міне кілт
Dialogue: 0,0:01:22.28,0:01:26.12,OP-EN,,0,0,0,,Ізденіс өте ұзақ, біз оны жоғалтып жібердік
Dialogue: 0,0:01:26.29,0:01:29.63,OP-EN,,0,0,0,,Үміттен асқан үміт сәулесі бар
Dialogue: 0,0:01:29.96,0:01:31.38,OP-EN,,0,0,0,,Жалғастыру
Dialogue: 0,0:01:31.63,0:01:34.55,OP-EN,,0,0,0,,Шындықты іздеңіз
Dialogue: 0,0:01:34.67,0:01:35.71,OP-EN,,0,0,0,,Бұл дүниеде
Dialogue: 0,0:01:35.71,0:01:37.47,OP-EN,,0,0,0,,Мұндай арнау бір-ақ рет келеді
Dialogue: 0,0:01:37.47,0:01:40.89,OP-EN,,0,0,0,,Шатасудан өтіп, шешуін табыңыз
Dialogue: 0,0:01:41.22,0:01:44.81,OP-EN,,0,0,0,,Бұралған зұлымдықты жеңу
Dialogue: 0,0:01:44.97,0:01:46.77,OP-EN,,0,0,0,,Тек орындаңыз
Dialogue: 0,0:01:46.85,0:01:48.44,OP-EN,,0,0,0,,Оған барыңыз
Dialogue: 0,0:01:48.64,0:01:50.73,OP-EN,,0,0,0,,Ешқашан
Dialogue: 0,0:01:50.73,0:01:52.61,OP-EN,,0,0,0,,Уақытты өлтіретініне сену керек
Dialogue: 0,0:21:16.24,0:21:18.91,ED-JP(B&W),,0,0,0,,Сізге не керек?
Dialogue: 0,0:21:18.91,0:21:21.45,ED-JP(B&W),,0,0,0,,Құлақ шуы 0 Өтірік естіледі
Dialogue: 0,0:21:21.58,0:21:25.54,ED-JP(B&W),,0,0,0,,Менің әлемім қателескен сияқты.
Dialogue: 0,0:21:25.62,0:21:30.63,ED-JP(B&W),,0,0,0,,Дүниелік нәпсіге тосқауыл қою 0 Ол балама айырбас дейді.
Dialogue: 0,0:21:30.79,0:21:34.96,ED-JP(B&W),,0,0,0,,Азғыруларға ілесіп, мен бос сөзге беріле бастадым.
Dialogue: 0,0:21:34.96,0:21:37.32,ED-JP(R&W),,0,0,0,,Патша ойынына міндетті түрде қатысу
Dialogue: 0,0:21:37.32,0:21:39.63,ED-JP(R&W),,0,0,0,,Олар менің вето құқығымды тыңдамайды.
Dialogue: 0,0:21:39.63,0:21:43.47,ED-JP(R&W),,0,0,0,,Тағайындалған тапсырма: «Ол адамды өлтір».
Dialogue: 0,0:21:43.47,0:21:46.47,ED-JP(R&W),,0,0,0,,Үмітсізмін 0 Шаршадым 0 Бала сияқтымын
Dialogue: 0,0:21:46.47,0:21:48.68,ED-JP(R&W),,0,0,0,,Мен кездескен шындық нөлге тең болды.
Dialogue: 0,0:21:48.68,0:21:53.89,ED-JP(R&W),,0,0,0,,Өзіңнің қалауларың жоқ болып көріну немесе екіжүзділік танытудан пайда жоқ.
Dialogue: 0,0:21:53.89,0:21:57.15,ED-JP(R&W),,0,0,0,,Бұл сіздің аңсаған арманыңыз ба? 0 Мен батыр болғым келеді
Dialogue: 0,0:21:57.15,0:21:57.98,ED-JP(R&W),,0,0,0,,Уппупу
Dialogue: 0,0:21:57.98,0:22:00.99,ED-JP(R&W),,0,0,0,,0 болашақта өкінемін
Dialogue: 0,0:22:00.99,0:22:04.41,ED-JP(R&W),,0,0,0,,Ақымақтыққа дәрі жоқ
Dialogue: 0,0:00:06.22,0:00:08.83,TEXT JP (L),,0,0,0,,Бұл тағы да болды.
Dialogue: 0,0:00:09.41,0:00:15.20,TEXT JP (L),,0,0,0,,Жабық ойын-сауық бөлмесінде хабар таратушы деп күдіктенген Огами мырзаның мәйіті табылды.
Dialogue: 0,0:00:15.75,0:00:19.75,TEXT JP (L),,0,0,0,,Біз төртінші кісі өлтіруді тергеуді бастадық.
Dialogue: 0,0:00:26.25,0:00:28.26,TEXT JP (L),,0,0,0,,Наэги-кун, бір сәт осында кел.
Dialogue: 0,0:00:29.55,0:00:32.33,TEXT JP (L),,0,0,0,,Сары ұнтақ және іздер...
Dialogue: 0,0:00:37.47,0:00:42.13,TEXT JP (L),,0,0,0,,Осылайша төртінші сыныптағы сот процесі басталғалы қалды.
Dialogue: 0,0:02:05.42,0:02:09.36,TEXT JP (L),,0,0,0,,Енді адам саны қайтадан азая ма?
Dialogue: 0,0:02:09.64,0:02:14.81,TEXT JP (L),,0,0,0,,Әлде мектеп өмірінің өзі аяқтала ма?
Dialogue: 0,0:02:15.40,0:02:18.30,TEXT JP (L),,0,0,0,,Ал, енді бірден бастайық.
Dialogue: 0,0:02:18.88,0:02:22.48,TEXT JP (L),,0,0,0,,Көптен күткен сыныптық сот процесі
Dialogue: 0,0:02:28.54,0:02:31.97,TEXT JP (L),,0,0,0,,Кінәлі Тогами, Фукава немесе Хагакуре.
Dialogue: 0,0:02:32.26,0:02:37.10,TEXT JP (L),,0,0,0,,Балалар сендерді ойын-сауық бөлмесіне Сакура-чан шақырды.
Dialogue: 0,0:02:37.89,0:02:42.77,TEXT JP (L),,0,0,0,,Жадынамамен шақырғаны рас, бірақ баруға амалым жоқ.
Dialogue: 0,0:02:42.77,0:02:45.16,TEXT JP (L),,0,0,0,,Әй, мен де бармадым.
Dialogue: 0,0:02:46.37,0:02:48.02,TEXT JP (L),,0,0,0,,Мен көрдім.
Dialogue: 0,0:02:48.02,0:02:50.16,TEXT JP (L),,0,0,0,,Кінәлі - Ясухиро Хагакуре.
Dialogue: 0,0:02:50.16,0:02:52.28,TEXT JP (L),,0,0,0,,Иә, хмм... көрдің бе?
Dialogue: 0,0:02:52.28,0:02:53.25,TEXT JP (L),,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:02:53.55,0:02:54.65,TEXT JP (L),,0,0,0,,Оны өз бетінше қалдыр
Dialogue: 0,0:02:54.65,0:02:57.90,TEXT JP (L),,0,0,0,,Мені Сакура Огами шақырды
Dialogue: 0,0:02:58.16,0:03:03.02,TEXT JP (L),,0,0,0,,Мм...бірақ мен қорқып кеттім де, шкафқа тығылдым.
Dialogue: 0,0:03:04.04,0:03:05.34,TEXT JP (L),,0,0,0,,Содан кейін
Dialogue: 0,0:03:07.70,0:03:10.26,TEXT JP (L),,0,0,0,,Кешіріңіз, сәл күтіңіз.
Dialogue: 0,0:03:10.40,0:03:11.75,TEXT JP (L),,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,0:03:12.37,0:03:15.22,TEXT JP (L),,0,0,0,,Бітті, бәрі бітті.
Dialogue: 0,0:03:21.89,0:03:23.86,TEXT JP (L),,0,0,0,,Нене Нене құрастыру.
Dialogue: 0,0:03:23.86,0:03:26.60,TEXT JP (L),,0,0,0,,Иә? Сіз болдыңыз ба?
Dialogue: 0,0:03:26.60,0:03:27.79,TEXT JP (L),,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:03:27.79,0:03:31.15,TEXT JP (L),,0,0,0,,Бұл өлім жазасы, сен өлім жазасына кесу.
Dialogue: 0,0:03:31.32,0:03:33.17,TEXT JP (L),,0,0,0,,Олай болса, дауыс беру уақыты келді.
Dialogue: 0,0:03:33.33,0:03:38.87,TEXT JP (L),,0,0,0,,Дұрыс, ол адам Сакура Огамиді тосын соққымен өлтірді.
Dialogue: 0,0:03:39.18,0:03:40.56,TEXT JP (L),,0,0,0,,Мен саған бірнеше қосымша киім мен бір күрте дайындап қоямын.
Dialogue: 0,0:03:43.52,0:03:45.38,TEXT JP (L),,0,0,0,,Бір соқса біртүрлі.
Dialogue: 0,0:03:45.70,0:03:50.08,TEXT JP (L),,0,0,0,,Өйткені Огами мырзаның басында екі соққы ізі бар еді.
Dialogue: 0,0:03:50.25,0:03:52.10,TEXT JP (L),,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:03:52.41,0:03:55.65,TEXT JP (L),,0,0,0,,Жоқ. Бұл адам мені екі рет ұрды деп ойлаймын...
Dialogue: 0,0:03:55.65,0:03:58.13,TEXT JP (L),,0,0,0,,Жоқ, мен оны тек бір рет ұрдым.
Dialogue: 0,0:03:58.47,0:04:00.12,TEXT JP (L),,0,0,0,,Сіз мені ұрғаныңызды мойындайсыз.
Dialogue: 0,0:04:00.88,0:04:05.06,TEXT JP (L),,0,0,0,,Олай болса, дәу мені өлтіреді деп ойладым.
Dialogue: 0,0:04:05.58,0:04:06.95,TEXT JP (L),,0,0,0,,Қорқынышты
Dialogue: 0,0:04:06.95,0:04:07.70,TEXT JP (L),,0,0,0,,Фукава
Dialogue: 0,0:04:07.70,0:04:08.80,TEXT JP (L),,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,0:04:08.80,0:04:13.01,TEXT JP (L),,0,0,0,,Хагакуре демалыс бөлмесінен шыққан соң не істедің?
Dialogue: 0,0:04:14.31,0:04:15.57,TEXT JP (L),,0,0,0,,Адал болыңыз
Dialogue: 0,0:04:15.57,0:04:19.22,TEXT JP (L),,0,0,0,,Аа, есімде жоқ.
Dialogue: 0,0:04:19.79,0:04:24.24,TEXT JP (L),,0,0,0,,Хагакуре демалыс бөлмесінен қашып кеткен соң, мен шкафтан шықтым.
Dialogue: 0,0:04:29.26,0:04:34.34,TEXT JP (L),,0,0,0,,Ой... Сакура Огамидің қанын көріп, журнал сөресінің алдында ес-түссіз қалдым.
Dialogue: 0,0:04:34.97,0:04:38.75,TEXT JP (L),,0,0,0,,Одан әрі қарай не болғанын сұраңыз.
Dialogue: 0,0:04:41.32,0:04:44.68,TEXT JP (L),,0,0,0,,Хаха, мен шықтым.
Dialogue: 0,0:04:44.68,0:04:47.04,TEXT JP (L),,0,0,0,,Тек сұралғанға жауап беріңіз.
Dialogue: 0,0:04:47.33,0:04:49.83,TEXT JP (L),,0,0,0,,Сакура Огамиді өлтірдің бе?
Dialogue: 0,0:04:49.83,0:04:55.10,TEXT JP (L),,0,0,0,,Негізі Неан екеуміз естеліктермен бөліспейміз.
Dialogue: 0,0:04:55.10,0:04:57.86,TEXT JP (L),,0,0,0,,Сондықтан мен егжей-тегжейлерін білмеймін.
Dialogue: 0,0:04:57.86,0:05:02.30,TEXT JP (L),,0,0,0,,Мен тыныш ұйықтасам, біреу мені қатты сілкіп тастайды.
Dialogue: 0,0:05:02.30,0:05:05.63,TEXT JP (L),,0,0,0,,Мен ханзада екен деп көзімді ашсам,
Dialogue: 0,0:05:06.33,0:05:07.85,TEXT JP (L),,0,0,0,,Қандай шашыраңқы
Dialogue: 0,0:05:07.85,0:05:09.85,TEXT JP (L),,0,0,0,,Мен қатты таң қалдым
Dialogue: 0,0:05:12.23,0:05:14.92,TEXT JP (L),,0,0,0,,Мен оны жақын маңдағы бөтелкемен ұрдым.
Dialogue: 0,0:05:14.92,0:05:16.93,TEXT JP (L),,0,0,0,,Себебі мен қорықтым.
Dialogue: 0,0:05:17.18,0:05:19.02,TEXT JP (L),,0,0,0,,Огр сені жеңбейді
Dialogue: 0,0:05:21.20,0:05:22.74,TEXT JP (L),,0,0,0,,Сізге жақсы
Dialogue: 0,0:05:22.74,0:05:25.57,TEXT JP (L),,0,0,0,,Мен жалмауызды өлтірген жоқпын.
Dialogue: 0,0:05:26.19,0:05:27.67,TEXT JP (L),,0,0,0,,Хагакуре-кун, сен солай айтасың...
Dialogue: 0,0:05:27.67,0:05:30.47,TEXT JP (L),,0,0,0,,Шешілді. Қазір дауыс беруді бастайық.
Dialogue: 0,0:05:31.40,0:05:33.77,TEXT JP (L),,0,0,0,,Қане, тез дауыс берейік.
Dialogue: 0,0:05:34.22,0:05:37.46,TEXT JP (L),,0,0,0,,Асахина мырза, бірдеңе әдеттегіден өзгеше.
Dialogue: 0,0:05:39.21,0:05:41.08,TEXT JP (L),,0,0,0,,Монокума дауысы
Dialogue: 0,0:05:41.08,0:05:41.75,TEXT JP (L),,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:05:43.22,0:05:44.05,TEXT JP (L),,0,0,0,,Көшеттер
Dialogue: 0,0:05:44.56,0:05:46.36,TEXT JP (L),,0,0,0,,Бұрынғы оқиға мені қызықтырды.
Dialogue: 0,0:05:47.03,0:05:50.37,TEXT JP (L),,0,0,0,,Фукава мырза Огами мырзаны қайда ұрды?
Dialogue: 0,0:05:50.44,0:05:52.61,TEXT JP (L),,0,0,0,,Мен оянған жерім.
Dialogue: 0,0:05:52.87,0:05:55.22,TEXT JP (L),,0,0,0,,Мен журнал сөресінің алдында өзімді өлтірдім.
Dialogue: 0,0:05:55.64,0:05:56.92,TEXT JP (L),,0,0,0,,Мен саған бірнеше қосымша киім мен бір күрте дайындап қоямын.
Dialogue: 0,0:05:59.43,0:06:03.37,TEXT JP (L),,0,0,0,,Огами мырза орындықта отырып қайтыс болды.
Dialogue: 0,0:06:03.63,0:06:06.76,TEXT JP (L),,0,0,0,,Өлім себебін журнал сөресінің алдында ұрып-соғып жатқан болса.
Dialogue: 0,0:06:06.89,0:06:09.52,TEXT JP (L),,0,0,0,,Мен оның орындықта неліктен өлгенін түсіндіре алмаймын.
Dialogue: 0,0:06:10.51,0:06:12.19,TEXT JP (L),,0,0,0,,Дұрыс, Неги.
Dialogue: 0,0:06:13.01,0:06:17.32,TEXT JP (L),,0,0,0,,Ал журнал сөресінің жанында еденде қан дақтары болды.
Dialogue: 0,0:06:17.44,0:06:23.92,TEXT JP (L),,0,0,0,,Басқаша айтқанда, Огамиді журнал сөресінің алдында ұрып-соққаны даусыз.
Dialogue: 0,0:06:23.92,0:06:26.88,TEXT JP (L),,0,0,0,,Сонда Геноцид Шо кінәлі.
Dialogue: 0,0:06:26.88,0:06:28.10,TEXT JP (L),,0,0,0,,Чигет
Dialogue: 0,0:06:28.10,0:06:32.13,TEXT JP (L),,0,0,0,,Мен сені соққан жерім мен Ога-чан өлген жерім бір болса керек.
Dialogue: 0,0:06:32.13,0:06:35.92,TEXT JP (L),,0,0,0,,Түсіндім, сонда нағыз кінәлі кім?
Dialogue: 0,0:06:35.92,0:06:38.45,TEXT JP (L),,0,0,0,,Окамиді қалай өлтірдің?
Dialogue: 0,0:06:38.99,0:06:40.41,TEXT JP (L),,0,0,0,,Түсіндірейін.
Dialogue: 0,0:06:40.65,0:06:41.75,TEXT JP (L),,0,0,0,,Шабуыл
Dialogue: 0,0:06:41.75,0:06:45.05,TEXT JP (L),,0,0,0,,Бұл химия кабинетінен әкелінген улы зат.
Dialogue: 0,0:06:45.73,0:06:51.93,TEXT JP (L),,0,0,0,,Химия кабинетіндегі дәрі-дәрмек шкафы қоректік заттар, реактивтер және улар сақтайтын сөрелерге бөлінген.
Dialogue: 0,0:06:52.30,0:06:57.13,TEXT JP (L),,0,0,0,,Бұл улы бөтелке қандай да бір себептермен тамақтану сөресіне түсіп қалды.
Dialogue: 0,0:06:57.87,0:07:02.74,TEXT JP (L),,0,0,0,,Қызық, неліктен тағамдық сөреде у болды?
Dialogue: 0,0:07:13.71,0:07:14.82,TEXT JP (L),,0,0,0,,Тогами-кун
Dialogue: 0,0:07:15.03,0:07:19.52,TEXT JP (L),,0,0,0,,Бякуя-сама, тез құсып жіберші, өтінемін, маған құс.
Dialogue: 0,0:07:19.52,0:07:20.32,TEXT JP (L),,0,0,0,,Үндетпе
Dialogue: 0,0:07:20.22,0:07:23.93,TEXT JP (L),,0,0,0,,Суды тез ішпесең, ұнтақты ғана ішсең тамағың ауырады.
Dialogue: 0,0:07:20.58,0:07:24.44,TEXT JP (L),,0,0,0,,Тогами-кун, сен маған бөтелкені қарызға бере аласың ба?
Dialogue: 0,0:07:24.44,0:07:26.44,TEXT JP (L),,0,0,0,,А, маңызды емес.
Dialogue: 0,0:07:37.39,0:07:39.23,TEXT JP (L),,0,0,0,,Бұл ақуыз.
Dialogue: 0,0:07:39.23,0:07:39.88,TEXT JP (L),,0,0,0,,Иә?
Dialogue: 0,0:07:40.08,0:07:45.10,TEXT JP (L),,0,0,0,,Иә, бұл бөтелкедегі зат улы емес, ақуыз болды.
Dialogue: 0,0:07:45.84,0:07:50.25,TEXT JP (L),,0,0,0,,Ал демалыс бөлмесінде ақуызға арналған бос ыдыстар болады.
Dialogue: 0,0:07:51.48,0:07:54.74,TEXT JP (L),,0,0,0,,Бұл екі факт нені білдіреді?
Dialogue: 0,0:07:55.76,0:07:56.67,TEXT JP (L),,0,0,0,,Мүмкін емес
Dialogue: 0,0:07:59.62,0:08:03.82,TEXT JP (L),,0,0,0,,Улы флакон мен ақуыз сауытының ішіндегісі ауыстырылды.
Dialogue: 0,0:08:06.88,0:08:11.18,TEXT JP (L),,0,0,0,,Огами мырза ақуыз сауытындағы улы дәріні ішті.
Dialogue: 0,0:08:23.86,0:08:25.32,TEXT JP (L),,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:08:25.63,0:08:28.47,TEXT JP (L),,0,0,0,,Мен мынадай қорытындыға келдім.
Dialogue: 0,0:08:28.72,0:08:30.50,TEXT JP (L),,0,0,0,,Бұл жерде ештеңе жоқ
Dialogue: 0,0:08:30.50,0:08:31.73,TEXT JP (L),,0,0,0,,Бұл жақсы
Dialogue: 0,0:08:31.73,0:08:35.83,TEXT JP (L),,0,0,0,,Бөтелкеде бұрынғыдан аз да болса улану қалса, не істеуіміз керек?
Dialogue: 0,0:08:36.83,0:08:38.50,TEXT JP (L),,0,0,0,,Уақыт – уақыт.
Dialogue: 0,0:08:39.20,0:08:41.42,TEXT JP (L),,0,0,0,,Ал химия кабинетінің іздері.
Dialogue: 0,0:08:41.70,0:08:44.44,TEXT JP (L),,0,0,0,,У мен белокты алмастырғанда
Dialogue: 0,0:08:44.44,0:08:48.95,TEXT JP (L),,0,0,0,,Кінәлі абайсызда қандай да бір ұнтақты жайып жіберген болуы керек.
Dialogue: 0,0:08:49.61,0:08:53.71,TEXT JP (L),,0,0,0,,Бұл аяқ іздері кроссовка болса керек.
Dialogue: 0,0:08:54.03,0:08:55.90,TEXT JP (L),,0,0,0,,Мен қазір химия кабинетіне барамын.
Dialogue: 0,0:08:56.15,0:09:00.22,TEXT JP (L),,0,0,0,,Әр адамның ізін салыстыру арқылы кінәлі кім екені анықталады.
Dialogue: 0,0:09:06.58,0:09:07.62,TEXT JP (L),,0,0,0,,Бұл менмін
Dialogue: 0,0:09:09.34,0:09:12.14,TEXT JP (L),,0,0,0,,Бұл менмін, сол іздер
Dialogue: 0,0:09:12.78,0:09:17.81,TEXT JP (L),,0,0,0,,Мен Сакура-чанды өлтірдім.
Dialogue: 0,0:09:23.82,0:09:28.79,TEXT JP (L),,0,0,0,,Мен Сакура-чанды өлтірдім.
Dialogue: 0,0:09:29.30,0:09:32.68,TEXT JP (L),,0,0,0,,А, Асахинакки, дүлей?
Dialogue: 0,0:09:32.85,0:09:37.14,TEXT JP (L),,0,0,0,,Бұл екеуі ең жақсы дос болды, солай ма?
Dialogue: 0,0:09:37.14,0:09:40.82,TEXT JP (L),,0,0,0,,Ең жақын досым, мен сол қарым-қатынасты пайдаландым.
Dialogue: 0,0:09:41.32,0:09:46.37,TEXT JP (L),,0,0,0,,Асахина берген белок болса, Огами күдіктенбей жеп қояр еді.
Dialogue: 0,0:09:46.61,0:09:48.52,TEXT JP (L),,0,0,0,,Дұрыс...
Dialogue: 0,0:09:49.86,0:09:57.19,TEXT JP (L),,0,0,0,,Демалыс бөлмесінде Сакура-чан маған ақуыз әкелуімді өтінді.
Dialogue: 0,0:09:57.45,0:09:59.70,TEXT JP (L),,0,0,0,,Мен бұл туралы ойладым.
Dialogue: 0,0:09:59.70,0:10:01.97,TEXT JP (L),,0,0,0,,Мен сені қазір өлтіре аламын...
Dialogue: 0,0:10:02.46,0:10:08.67,TEXT JP (L),,0,0,0,,Содан кейін ол дәріні ауыстырып, құрамында уы бар ақуыз ыдысын Огамиге берді.
Dialogue: 0,0:10:06.30,0:10:09.10,TEXT JP (L),,0,0,0,,Шынымен солай ма?
Dialogue: 0,0:10:09.41,0:10:13.82,TEXT JP (L),,0,0,0,,Сосын Сакура-чан барлығын бір демде ішіп алды.
Dialogue: 0,0:10:10.87,0:10:16.11,TEXT JP (L),,0,0,0,,Өйткені Асахина-сан Огами-санға қатты қамқор болды, солай емес пе?
Dialogue: 0,0:10:17.38,0:10:21.83,TEXT JP (L),,0,0,0,,Сакура-чанды неге түсінбейсің?
Dialogue: 0,0:10:22.38,0:10:28.11,TEXT JP (L),,0,0,0,,Өйткені, менің қымбатты досым туралы жаман сөздер айтылып жатыр.
Dialogue: 0,0:10:29.03,0:10:32.91,TEXT JP (L),,0,0,0,,Ол Огамиді өлтіре ме?
Dialogue: 0,0:10:33.14,0:10:36.72,TEXT JP (L),,0,0,0,,Сакура уды ішкен соң
Dialogue: 0,0:10:36.90,0:10:38.86,TEXT JP (L),,0,0,0,,Мен ойын-сауық бөлмесінен шықтым
Dialogue: 0,0:10:39.92,0:10:41.23,TEXT JP (L),,0,0,0,,Мен саған бірнеше қосымша киім мен бір күрте дайындап қоямын.
Dialogue: 0,0:10:44.29,0:10:48.62,TEXT JP (L),,0,0,0,,Асахина-сан, жабық бөлменің артындағы жұмбақ қазір шешілмейді.
Dialogue: 0,0:10:49.04,0:10:50.17,TEXT JP (L),,0,0,0,,Жабық бөлме?
Dialogue: 0,0:10:51.39,0:10:56.02,TEXT JP (L),,0,0,0,,Мәйіт табылмас бұрын демалыс бөлмесінің есігі құлыпталған.
Dialogue: 0,0:10:56.76,0:11:02.01,TEXT JP (L),,0,0,0,,Асахина ойын-сауық бөлмесінен шыққан соң есікті ішінен қалай құлыптады?
Dialogue: 0,0:11:03.20,0:11:07.35,TEXT JP (L),,0,0,0,,Егер мұны түсіндіру мүмкін болмаса, Асахина кінәлі емес.
Dialogue: 0,0:11:07.96,0:11:09.15,TEXT JP (L),,0,0,0,,Бұл...
Dialogue: 0,0:11:11.95,0:11:17.36,TEXT JP (L),,0,0,0,,Мүмкін емес. Дәрі-дәрмек ауыстырылғандықтан, кінәлі – сөзсіз Асахина.
Dialogue: 0,0:11:17.36,0:11:21.02,TEXT JP (L),,0,0,0,,Содан кейін мен жаңа дәлелдерді ұсынамын.
Dialogue: 0,0:11:21.83,0:11:24.86,TEXT JP (L),,0,0,0,,Тоғами-кун, бұл сенің маған берген анықтамаң.
Dialogue: 0,0:11:25.09,0:11:26.04,TEXT JP (L),,0,0,0,,Мен?
Dialogue: 0,0:11:27.82,0:11:30.31,TEXT JP (L),,0,0,0,,Бұл қандай фрагмент?
Dialogue: 0,0:11:30.31,0:11:31.21,TEXT JP (L),,0,0,0,,Бұл...
Dialogue: 0,0:11:32.19,0:11:35.07,TEXT JP (L),,0,0,0,,Мен сындырған есіктің сынықтары?
Dialogue: 0,0:11:35.34,0:11:41.02,TEXT JP (L),,0,0,0,,Иә, бұл фрагмент әйтеуір химия кабинетіндегі улы құтыға түсіп қалды.
Dialogue: 0,0:11:41.43,0:11:46.27,TEXT JP (L),,0,0,0,,Сынған әйнек туралы тағы бір қызық нәрсе бар.
Dialogue: 0,0:11:46.69,0:11:51.48,TEXT JP (L),,0,0,0,,Белгілі бір себептермен шыны сынықтар демалыс бөлмесіндегі протеин сауытында болмаған.
Dialogue: 0,0:11:51.48,0:11:52.62,TEXT JP (L),,0,0,0,,Бұл астында болар еді
Dialogue: 0,0:11:53.89,0:11:57.57,TEXT JP (L),,0,0,0,,У флаконында және белок сауытында не болды?
Dialogue: 0,0:11:58.85,0:12:00.83,TEXT JP (L),,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:12:00.91,0:12:01.72,TEXT JP (L),,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:12:02.84,0:12:06.83,TEXT JP (L),,0,0,0,,Улы бөтелке бастапқыда демалыс бөлмесінде болған.
Dialogue: 0,0:12:09.71,0:12:10.80,TEXT JP (L),,0,0,0,,Огами мырза
Dialogue: 0,0:12:11.50,0:12:15.16,TEXT JP (L),,0,0,0,,Ал біз мәйітке назар аударған кезде
Dialogue: 0,0:12:15.51,0:12:18.08,TEXT JP (L),,0,0,0,,Адам улану құтысын алды.
Dialogue: 0,0:12:18.91,0:12:21.82,TEXT JP (L),,0,0,0,,Осыдан кейін мен бәрімен бірге ойын-сауық бөлмесіне қайтып келгенімде.
Dialogue: 0,0:12:22.04,0:12:26.07,TEXT JP (L),,0,0,0,,Адам мүмкіндікті пайдаланып, өзімен бірге алып келген ақуыз ыдысын тастап кетті.
Dialogue: 0,0:12:26.73,0:12:29.60,TEXT JP (L),,0,0,0,,Огами мырзаның өлімін қолдан жасау
Dialogue: 0,0:12:31.63,0:12:37.93,TEXT JP (L),,0,0,0,,Огами мырзаның аяғын химия кабинетінде болған сары ұнтақ басып алған.
Dialogue: 0,0:12:38.46,0:12:43.87,TEXT JP (L),,0,0,0,,Химия кабинетінде ұнтақ жайылған кезде ол сонда болды.
Dialogue: 0,0:12:44.58,0:12:51.38,TEXT JP (L),,0,0,0,,Сөредегі уды алмақ болып, қателесіп ұнтақты төгіп алған болуы керек.
Dialogue: 0,0:12:52.75,0:12:56.71,TEXT JP (L),,0,0,0,,Егер солай болса, уды Огами мырза өзі әкелді.
Dialogue: 0,0:12:57.38,0:13:00.53,TEXT JP (L),,0,0,0,,Бұл суицид болды.
Dialogue: 0,0:13:03.73,0:13:07.27,TEXT JP (L),,0,0,0,,Осылай ойласаң, жабық бөлменің артындағы жұмбақты шешуге болады.
Dialogue: 0,0:13:10.55,0:13:16.90,TEXT JP (L),,0,0,0,,Ойын-сауық бөлмесіндегі жабық бөлме бөлмеде болған Огами мырза өз-өзіне қол жұмсаған кезде мазасызданбауы үшін жасалған.
Dialogue: 0,0:13:26.50,0:13:28.29,TEXT JP (L),,0,0,0,,Оқиға қалай басталды
Dialogue: 0,0:13:28.84,0:13:34.61,TEXT JP (L),,0,0,0,,Огами-сан Тогами-кун, Хагакуре-кун және Фукава-санды демалыс бөлмесіне шақырды.
Dialogue: 0,0:13:35.76,0:13:37.74,TEXT JP (L),,0,0,0,,Сіз сол үш адамды шақырдыңыз ба?
Dialogue: 0,0:13:38.10,0:13:39.84,TEXT JP (L),,0,0,0,,Тоқтау керек.
Dialogue: 0,0:13:39.84,0:13:41.80,TEXT JP (L),,0,0,0,,Өте қауіпті
Dialogue: 0,0:13:41.80,0:13:43.63,TEXT JP (L),,0,0,0,,Жай сөйлес
Dialogue: 0,0:13:44.11,0:13:47.23,TEXT JP (L),,0,0,0,,Асахина, ол адамдар бізге жау емес.
Dialogue: 0,0:13:47.57,0:13:48.90,TEXT JP (L),,0,0,0,,Біз доспыз.
Dialogue: 0,0:13:49.68,0:13:54.37,TEXT JP (L),,0,0,0,,Бірақ Огами-санды Хагакуре-кун мен Фукава-сан ұрды.
Dialogue: 0,0:13:55.34,0:13:58.62,TEXT JP (L),,0,0,0,,Сакура-чан, біз сені дереу емдеуіміз керек.
Dialogue: 0,0:13:59.12,0:14:00.43,TEXT JP (L),,0,0,0,,Асахина?
Dialogue: 0,0:14:01.04,0:14:04.39,TEXT JP (L),,0,0,0,,Кешіріңіз, сіз маған ақуыз бере аласыз ба?
Dialogue: 0,0:14:04.56,0:14:06.07,TEXT JP (L),,0,0,0,,Ақуыз?
Dialogue: 0,0:14:06.07,0:14:07.08,TEXT JP (L),,0,0,0,,Неліктен?
Dialogue: 0,0:14:07.46,0:14:08.33,TEXT JP (L),,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:14:08.86,0:14:09.75,TEXT JP (L),,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:14:09.75,0:14:11.93,TEXT JP (L),,0,0,0,,Күте тұрыңыз, мен оны бірден әкелемін.
Dialogue: 0,0:14:16.39,0:14:21.59,TEXT JP (L),,0,0,0,,Алайда Асахина улы дәрі сөресі алдында шашылып жатқан ұнтақты көрді.
Dialogue: 0,0:14:22.25,0:14:25.43,TEXT JP (L),,0,0,0,,Мен Огами мырзаның уды өзімен бірге алып кеткенін түсіндім.
Dialogue: 0,0:14:30.24,0:14:33.45,TEXT JP (L),,0,0,0,,Сакура-чан, аш, аш.
Dialogue: 0,0:14:33.80,0:14:37.43,TEXT JP (L),,0,0,0,,Неліктен? Неліктен?
Dialogue: 0,0:14:38.75,0:14:42.70,TEXT JP (L),,0,0,0,,Сакура-чан неге өлуге мәжбүр болды?
Dialogue: 0,0:14:48.04,0:14:49.53,TEXT JP (L),,0,0,0,,Жоқ.
Dialogue: 0,0:14:49.53,0:14:51.77,TEXT JP (L),,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:14:52.07,0:14:54.02,TEXT JP (L),,0,0,0,,Мен оны өлтірдім.
Dialogue: 0,0:14:55.14,0:14:57.69,TEXT JP (L),,0,0,0,,Мен оны өлтірдім.
Dialogue: 0,0:14:59.14,0:15:02.99,TEXT JP (L),,0,0,0,,Асахина-сан, жетеді.
Dialogue: 0,0:15:03.43,0:15:05.52,TEXT JP (L),,0,0,0,,Бәрі бітті.
Dialogue: 0,0:15:05.71,0:15:07.52,TEXT JP (L),,0,0,0,,Біткен жоқ
Dialogue: 0,0:15:08.53,0:15:09.94,TEXT JP (L),,0,0,0,,Бітті.
Dialogue: 0,0:15:10.47,0:15:13.90,TEXT JP (L),,0,0,0,,Жоқ, мен оны қазір аяқтауым керек.
Dialogue: 0,0:15:33.02,0:15:36.95,TEXT JP (L),,0,0,0,,Бұл шындық...
Dialogue: 0,0:15:36.95,0:15:37.82,TEXT JP (L),,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:15:38.04,0:15:39.17,TEXT JP (L),,0,0,0,,Мен айттым
Dialogue: 0,0:15:39.36,0:15:44.17,TEXT JP (L),,0,0,0,,Адамның сезімін менсінбесең, бір күні аяғыңның астына түсерсің.
Dialogue: 0,0:15:45.49,0:15:48.65,TEXT JP (L),,0,0,0,,Адамдар тек қана есеп айырысулар мен пайда мен залал негізінде әрекет етпейді.
Dialogue: 0,0:15:49.19,0:15:51.58,TEXT JP (L),,0,0,0,,Сіз оны түсінбедіңіз
Dialogue: 0,0:15:52.26,0:15:54.62,TEXT JP (L),,0,0,0,,Сондықтан шындыққа жете алмадым
Dialogue: 0,0:15:54.93,0:15:57.29,TEXT JP (L),,0,0,0,,Есеп те, пайда мен шығын да емес пе?
Dialogue: 0,0:15:57.29,0:16:02.64,TEXT JP (L),,0,0,0,,Олай болса, бұл әйел Огамидің өлімін неге жасырды?
Dialogue: 0,0:16:03.75,0:16:05.90,TEXT JP (L),,0,0,0,,Мен сізге айтайын.
Dialogue: 0,0:16:07.94,0:16:08.87,TEXT JP (L),,0,0,0,,Шабуыл
Dialogue: 0,0:16:09.12,0:16:11.84,TEXT JP (L),,0,0,0,,Бұл Сакура-чанның еркі.
Dialogue: 0,0:16:13.25,0:16:16.91,TEXT JP (L),,0,0,0,,Шіркін даудан үмітім үзілді.
Dialogue: 0,0:16:16.91,0:16:19.89,TEXT JP (L),,0,0,0,,Мен өлтірілгенше күткенім жөн.
Dialogue: 0,0:16:20.09,0:16:22.15,TEXT JP (L),,0,0,0,,Өзіміз аяқтайық
Dialogue: 0,0:16:23.52,0:16:27.32,TEXT JP (L),,0,0,0,,Сакура-чан информатор үшін жауапкершілікті сезінді.
Dialogue: 0,0:16:27.89,0:16:32.15,TEXT JP (L),,0,0,0,,Сондықтан мен барлығын мені қандай да бір жолмен кешіруге тырыстым.
Dialogue: 0,0:16:36.15,0:16:39.48,TEXT JP (L),,0,0,0,,Сезімімді сендер таптадыңдар.
Dialogue: 0,0:16:40.34,0:16:43.06,TEXT JP (L),,0,0,0,,Үмітсіз өз-өзіне қол жұмсады.
Dialogue: 0,0:16:43.43,0:16:49.62,TEXT JP (L),,0,0,0,,Сакура-чан да кейбір әлсіз жақтары бар қарапайым қыз.
Dialogue: 0,0:16:51.46,0:16:54.11,TEXT JP (L),,0,0,0,,Біз оларды өлтіргеніміздей.
Dialogue: 0,0:16:54.29,0:16:58.54,TEXT JP (L),,0,0,0,,Біз бұлай өмір сүре алмаймыз.
Dialogue: 0,0:16:59.41,0:17:04.03,TEXT JP (L),,0,0,0,,Олай болса, бізді өзіңмен бірге алып кету үшін өз-өзіңе қол жұмса.
Dialogue: 0,0:17:08.31,0:17:11.63,TEXT JP (L),,0,0,0,,Көз жасы төгілген оқиға үшін кешірім сұраймын.
Dialogue: 0,0:17:12.76,0:17:17.21,TEXT JP (L),,0,0,0,,Бұл Огами мырзаның нағыз еркі.
Dialogue: 0,0:17:23.42,0:17:25.40,TEXT JP (L),,0,0,0,,Сонда бұл
Dialogue: 0,0:17:25.70,0:17:26.58,TEXT JP (L),,0,0,0,,Бұл?
Dialogue: 0,0:17:26.83,0:17:28.86,TEXT JP (L),,0,0,0,,Мен жазған граффити
Dialogue: 0,0:17:33.67,0:17:40.10,TEXT JP (L),,0,0,0,,Олай болса, әдемі дауысты мен нағыз суицид жазбасын оқимын.
Dialogue: 0,0:17:41.00,0:17:43.49,TEXT JP (L),,0,0,0,,Асахина, менің ең жақын досым
Dialogue: 0,0:17:43.85,0:17:47.33,TEXT JP (L),,0,0,0,,Менің отбасымның догжосы кепілге алынды.
Dialogue: 0,0:17:47.59,0:17:49.65,TEXT JP (L),,0,0,0,,Ұстаздың соңынан еруге мәжбүр болды
Dialogue: 0,0:17:50.17,0:17:52.65,TEXT JP (L),,0,0,0,,Бірақ менімен бірге келген серіктермен
Dialogue: 0,0:17:52.93,0:17:59.03,TEXT JP (L),,0,0,0,,Мен енді мені ең жақын досым деп атайтын Жаратқан Иеге опасыздық жасай алмаймын.
Dialogue: 0,0:17:59.54,0:18:03.26,TEXT JP (L),,0,0,0,,Мен өлсем, дау-дамай оты сөнеді.
Dialogue: 0,0:18:03.61,0:18:05.96,TEXT JP (L),,0,0,0,,Бір-бірін өлтіру енді болмайды.
Dialogue: 0,0:18:06.41,0:18:10.37,TEXT JP (L),,0,0,0,,Ол үшін өмірімді қатерге тігемін
Dialogue: 0,0:18:10.77,0:18:15.47,TEXT JP (L),,0,0,0,,Сен менің асыл серігімсің.
Dialogue: 0,0:18:15.95,0:18:18.81,TEXT JP (L),,0,0,0,,Асахина, мені кешіріңіз.
Dialogue: 0,0:18:19.28,0:18:21.46,TEXT JP (L),,0,0,0,,Достарыңызбен бірге аман қалыңыз
Dialogue: 0,0:18:21.86,0:18:23.77,TEXT JP (L),,0,0,0,,Сіз аман қалуыңыз керек
Dialogue: 0,0:18:24.45,0:18:25.75,TEXT JP (L),,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:18:28.99,0:18:34.62,TEXT JP (L),,0,0,0,,Сакура барлығының төбелесуін тоқтату үшін өз-өзіне қол жұмсады ма?
Dialogue: 0,0:18:35.25,0:18:36.24,TEXT JP (L),,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:18:37.03,0:18:41.36,TEXT JP (L),,0,0,0,,Бірақ ақыры сен мені бір-біріңді өлтіргім келді.
Dialogue: 0,0:18:41.36,0:18:42.30,TEXT JP (L),,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:43.01,0:18:45.59,TEXT JP (L),,0,0,0,,Огами-сан бекер өлді.
Dialogue: 0,0:18:45.98,0:18:47.81,TEXT JP (L),,0,0,0,,Мен бекер өлген жоқпын.
Dialogue: 0,0:18:47.81,0:18:48.67,TEXT JP (L),,0,0,0,,Әй?
Dialogue: 0,0:18:48.99,0:18:52.38,TEXT JP (L),,0,0,0,,Огами-сан есімізге түсірді
Dialogue: 0,0:18:53.51,0:18:56.38,TEXT JP (L),,0,0,0,,Біз ынтымақтасу керек достармыз.
Dialogue: 0,0:18:56.99,0:18:58.96,TEXT JP (L),,0,0,0,,Неги-ччи дұрыс айтады.
Dialogue: 0,0:18:59.20,0:19:00.30,TEXT JP (L),,0,0,0,,Жоқ?
Dialogue: 0,0:19:01.43,0:19:05.87,TEXT JP (L),,0,0,0,,Монокума Мен бұл ойыннан шығуды шештім.
Dialogue: 0,0:19:06.03,0:19:07.03,TEXT JP (L),,0,0,0,,Иә?
Dialogue: 0,0:19:07.03,0:19:12.47,TEXT JP (L),,0,0,0,,Жалғыз әрекет жасаушыны әшкерелеп, оған қатаң жаза беру ғана қалды.
Dialogue: 0,0:19:13.05,0:19:15.35,TEXT JP (L),,0,0,0,,Бұл қызықтырақ көрінеді.
Dialogue: 0,0:19:15.35,0:19:17.43,TEXT JP (L),,0,0,0,,Бұл не?
Dialogue: 0,0:19:17.43,0:19:21.07,TEXT JP (L),,0,0,0,,Мен де Бякуя-саманың соңынан еремін.
Dialogue: 0,0:19:22.41,0:19:26.64,TEXT JP (L),,0,0,0,,Сіз қалай ойлайсыз? Огами-санның өлімі бекер болды деп әлі айта аласыз ба?
Dialogue: 0,0:19:27.79,0:19:28.80,TEXT JP (L),,0,0,0,,Жақсы нәрсе
Dialogue: 0,0:19:29.25,0:19:34.07,TEXT JP (L),,0,0,0,,Менің әлі де қызықты жазалау уақытым бар.
Dialogue: 0,0:19:34.75,0:19:38.08,TEXT JP (L),,0,0,0,,Бұл жолы бізге арнайы қонақ келді.
Dialogue: 0,0:20:46.49,0:20:47.98,TEXT JP (L),,0,0,0,,Өзгеріс...
Dialogue: 0,0:20:50.27,0:20:52.62,TEXT JP (L),,0,0,0,,Бұл көзге ауыр тиді, солай емес пе?
Dialogue: 0,0:20:52.87,0:20:56.47,TEXT JP (L),,0,0,0,,Сіз Альтер Эгоның не істеп жатқанын түсіндіңіз.
Dialogue: 0,0:20:56.75,0:21:00.61,TEXT JP (L),,0,0,0,,Сіз бәрін басынан бастап көре аласыз.
Dialogue: 0,0:21:00.85,0:21:05.65,TEXT JP (L),,0,0,0,,Олай болса, Огами-санның хатының қалған бөлігін оқығың келе ме?
Dialogue: 0,0:21:06.50,0:21:10.79,TEXT JP (L),,0,0,0,,Сайып келгенде, ұйымдастырушы біздің денемізде...
Dialogue: 0,0:21:11.91,0:21:15.18,TEXT JP (L),,0,0,0,,Ой, бұл спойлер болды.
Dialogue: 0,0:21:15.55,0:21:19.39,TEXT JP (L),,0,0,0,,Иә? Кек алу бар ма?
Dialogue: 0,0:21:20.53,0:21:21.97,TEXT JP (L),,0,0,0,,Жоқ.
Dialogue: 0,0:22:13.14,0:22:17.02,TEXT JP (L),,0,0,0,,Мен барлығын өлтірмек болдым...
Dialogue: 0,0:22:17.32,0:22:18.13,TEXT JP (L),,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:19.19,0:22:21.10,TEXT JP (L),,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:21.65,0:22:24.29,TEXT JP (L),,0,0,0,,Асахина-сан жауапкершілікті сезінбейді.
Dialogue: 0,0:22:24.29,0:22:25.38,TEXT JP (L),,0,0,0,,Содабе
Dialogue: 0,0:22:25.60,0:22:26.92,TEXT JP (L),,0,0,0,,Дебют
Dialogue: 0,0:22:27.99,0:22:29.05,TEXT JP (L),,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:29.22,0:22:30.96,TEXT JP (L),,0,0,0,,Осымен аяқталды
Dialogue: 0,0:22:31.44,0:22:35.17,TEXT JP (L),,0,0,0,,Мен сенен кешірім сұрайтындай күйзелдім.
Dialogue: 0,0:22:36.35,0:22:38.11,TEXT JP (L),,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:22:39.84,0:22:42.37,TEXT JP (L),,0,0,0,,Қазіргі махаббат туы сияқты емес.
Dialogue: 0,0:22:42.37,0:22:44.82,TEXT JP (L),,0,0,0,,А, бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:22:44.82,0:22:46.54,TEXT JP (L),,0,0,0,,Осындай көзілдірік
Dialogue: 0,0:22:46.89,0:22:48.82,TEXT JP (L),,0,0,0,,Егер сізде көзілдірік болса
Dialogue: 0,0:22:48.92,0:22:50.80,TEXT JP (L),,0,0,0,,Егер сізде көзілдірік болса
Dialogue: 0,0:22:50.36,0:22:51.62,TEXT JP (L),,0,0,0,,Бұл көзілдірік.
Dialogue: 0,0:22:51.62,0:22:55.78,TEXT JP (L),,0,0,0,,Балалар, Камасе Меган, Камасе Меган деп қайта-қайта қоңырау шалмаңдар, бұл әдейі.
Dialogue: 0,0:22:50.98,0:22:54.11,TEXT JP (L),,0,0,0,,Осылайша сыныптық сот аяқталды.
Dialogue: 0,0:22:56.06,0:22:58.93,TEXT JP (L),,0,0,0,,Бірақ әңгіме әлі біткен жоқ.
Dialogue: 0,0:23:00.15,0:23:02.97,TEXT JP (L),,0,0,0,,Ояныңыз Ояныңыз
Dialogue: 0,0:23:05.70,0:23:07.22,TEXT JP (L),,0,0,0,,Киригири мырза...?
Dialogue: 0,0:23:07.57,0:23:10.35,TEXT JP (L),,0,0,0,,Мен 4-қабаттағы ақпаратты өңдеу бөлмесінде күтемін.
Dialogue: 0,0:23:17.43,0:23:20.90,TEXT JP (L),,0,0,0,,Мен келуге тырыстым, бірақ Киригири-сан да болмады.
Dialogue: 0,0:23:20.90,0:23:22.73,TEXT JP (L),,0,0,0,,Ол әлі құлыптаулы
Dialogue: 0,0:23:22.90,0:23:25.39,TEXT JP (L),,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:23:25.72,0:23:27.84,TEXT JP (L),,0,0,0,,Сағат 3 болып қалды.
Dialogue: 0,0:23:28.09,0:23:28.98,TEXT JP (L),,0,0,0,,Ұйқыда
Dialogue: 0,0:23:28.98,0:23:30.69,TEXT JP (L),,0,0,0,,Қызық, бұл не туралы?
Dialogue: 0,0:23:32.01,0:23:33.16,TEXT JP (L),,0,0,0,,Киригири мырза
Dialogue: 0,0:23:33.16,0:23:34.38,TEXT JP (L),,0,0,0,,Абдол мырза
Dialogue: 0,0:23:34.38,0:23:36.26,TEXT JP (L),,0,0,0,,Екеуің ұйықтайсыңдар.
Dialogue: 0,0:23:36.43,0:23:37.22,TEXT JP (L),,0,0,0,,Иә.
Dialogue: 0,0:23:37.52,0:23:39.47,TEXT JP (L),,0,0,0,,Наэги-кун, үйге қайтайық?
Dialogue: 0,0:23:39.57,0:23:41.67,TEXT JP (L),,0,0,0,,Иә, иә
Dialogue: 0,0:23:43.92,0:23:46.62,TEXT JP (L),,0,0,0,,Ум, Киригири мырза
Dialogue: 0,0:23:49.96,0:23:51.44,TEXT JP (L),,0,0,0,,Сенблейд Мукуро
Dialogue: 0,0:23:52.17,0:23:55.67,TEXT JP (L),,0,0,0,,Осы мектепте жасырынып жатқан 16-шы орта мектеп оқушысы
Dialogue: 0,0:23:56.49,0:23:58.82,TEXT JP (L),,0,0,0,,Жоғары мектеп деңгейіндегі үмітсіздік
Dialogue: 0,0:23:59.32,0:24:01.17,TEXT JP (L),,0,0,0,,Сенба Мукуродан абай бол
Dialogue: 0,0:24:02.00,0:24:05.32,TEXT JP (L),,0,0,0,,16... жоғары сынып оқушысы
Dialogue: 0,0:02:15.99,0:02:21.99,STAFF,,0,0,0,,Осы субтитр көзімен жасалған, God Subtitles Group (kamigami.org), жеткізу алмасу оқыту, коммерциялық мақсатта пайдалануға тыйым салынған
Dialogue: 0,0:02:15.99,0:02:21.99,STAFF,,0,0,0,,Құдайдың субтитр жұбы
Dialogue: 0,0:02:15.99,0:02:18.78,STAFF,,0,0,0,,Жапония: Акацуки аудармасы: Арис және Шуэн аудармасы: Аспан азуы және жамбас мысық
