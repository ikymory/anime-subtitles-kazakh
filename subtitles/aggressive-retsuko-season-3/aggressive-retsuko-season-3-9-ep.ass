Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.16,0:00:15.70,Default,,0,0,0,,‎(Инуи) Мен сізге ұнайсыз ба?
Dialogue: 0,0:00:18.41,0:00:22.25,Default,,0,0,0,,‎(Хайда) Уф, мм...
Dialogue: 0,0:00:23.58,0:00:25.66,Default,,0,0,0,,Маған Хайда-сан ұнайды
Dialogue: 0,0:00:34.87,0:00:35.91,Default,,0,0,0,,А...
Dialogue: 0,0:00:37.50,0:00:38.75,Default,,0,0,0,,♪～
Dialogue: 0,0:00:38.75,0:00:39.83,Default,,0,0,0,,♪～
Dialogue: 0,0:00:38.75,0:00:39.83,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:00:39.83,0:00:42.00,Default,,0,0,0,,♪～
Dialogue: 0,0:01:19.45,0:01:24.45,Default,,0,0,0,,～♪
Dialogue: 0,0:01:38.50,0:01:40.75,Default,,0,0,0,,‎Йо...Йо
Dialogue: 0,0:01:48.16,0:01:51.91,Default,,0,0,0,,‎ (Фенеко) Соңында мен оны ұнаттым деп айта алмадым.
Dialogue: 0,0:01:52.45,0:01:53.58,Default,,0,0,0,,Иә
Dialogue: 0,0:01:55.41,0:01:57.58,Default,,0,0,0,,мырза. Инуи жуынатын бөлмеде қалған шығар.
Dialogue: 0,0:01:57.70,0:02:00.16,Default,,0,0,0,,‎Мен бұл орамалды көргенде, мен Рецуконың бар екеніне көзім жетті.
Dialogue: 0,0:02:00.50,0:02:02.83,Default,,0,0,0,,‎Мен қатты ренжідім.
Dialogue: 0,0:02:04.16,0:02:06.29,Default,,0,0,0,,Бұл бір оқ қызыл.
Dialogue: 0,0:02:06.83,0:02:08.37,Default,,0,0,0,,Мен Рецукоға деген сезімімнен арыла алмадым.
Dialogue: 0,0:02:08.50,0:02:10.79,Default,,0,0,0,,Бұл сіздің шешімсіздігіңіздің нәтижесі!
Dialogue: 0,0:02:10.91,0:02:12.87,Default,,0,0,0,,Менің айтар сөзім жоқ.
Dialogue: 0,0:02:13.12,0:02:15.75,Default,,0,0,0,,(Какуда) Қызыл қағаз тым қатал емес пе?
Dialogue: 0,0:02:16.41,0:02:18.29,Default,,0,0,0,,А? сен қандайсың
Dialogue: 0,0:02:18.95,0:02:20.95,Default,,0,0,0,,‎Махаббат полициясы
Dialogue: 0,0:02:22.29,0:02:24.83,Default,,0,0,0,,Менің ойымша, бұл іс дерлік қауіпсіз.
Dialogue: 0,0:02:24.95,0:02:26.66,Default,,0,0,0,,‎Сары түсті болса да.
Dialogue: 0,0:02:27.29,0:02:30.20,Default,,0,0,0,,‎Аа, дұрыс, Инуи мырза да солай деді.
Dialogue: 0,0:02:30.58,0:02:32.79,Default,,0,0,0,,Дәл қазір қауіпсіз.
Dialogue: 0,0:02:33.08,0:02:34.41,Default,,0,0,0,,мырза. Инуи?
Dialogue: 0,0:02:35.29,0:02:36.50,Default,,0,0,0,,Сіз нені айтып тұрсыз?
Dialogue: 0,0:02:36.87,0:02:38.16,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:02:38.58,0:02:41.12,Default,,0,0,0,,‎Екеуің бір-біріңді ұнататыныңды растамадыңдар.
Dialogue: 0,0:02:41.25,0:02:43.00,Default,,0,0,0,,‎Бұл нәзік қарым-қатынас, солай емес пе?
Dialogue: 0,0:02:43.12,0:02:45.62,Default,,0,0,0,,‎Бұл осы келісімшартқа қол қойылғанға дейінгі жағдай.
Dialogue: 0,0:02:46.29,0:02:48.41,Default,,0,0,0,,Алайда, бұл уақытша шарт мәртебесі
Dialogue: 0,0:02:48.75,0:02:51.25,Default,,0,0,0,,Болашаққа деген үміт пен махаббат дәміне толы.
Dialogue: 0,0:02:51.50,0:02:54.16,Default,,0,0,0,,‎Бұл жылдың ең қызықты мезгілі.
Dialogue: 0,0:02:54.58,0:02:55.75,Default,,0,0,0,,‎(Какуда) Түсінесіз бе? (Фенеко) Мен білмеймін.
Dialogue: 0,0:02:55.87,0:02:56.95,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:02:57.45,0:02:59.54,Default,,0,0,0,,‎Осындай тәтті уақыттан ләззат ала отырып...
Dialogue: 0,0:02:59.66,0:03:01.62,Default,,0,0,0,,‎Келесі кезеңге өту үшін -
Dialogue: 0,0:03:01.75,0:03:05.08,Default,,0,0,0,,Инуи мырза белсенді түрде жетекшілік етті.
Dialogue: 0,0:03:05.79,0:03:08.08,Default,,0,0,0,,(Хайда) Не, мені жетелеп жүрді ме?
Dialogue: 0,0:03:08.62,0:03:10.08,Default,,0,0,0,,‎Сіз өзіңізді жетекшімін деп ойладыңыз ба?
Dialogue: 0,0:03:10.20,0:03:12.12,Default,,0,0,0,,‎(Хайда) Иә, (Какуда)
Dialogue: 0,0:03:12.66,0:03:14.70,Default,,0,0,0,,Ал Хайда мырзаның табанды көзқарасы
Dialogue: 0,0:03:14.83,0:03:16.12,Default,,0,0,0,,мырза. Инуи ойлайды
Dialogue: 0,0:03:16.25,0:03:18.25,Default,,0,0,0,,«Бұл жігіт оятуға тым жалқау».
Dialogue: 0,0:03:18.54,0:03:21.75,Default,,0,0,0,,‎Мен осында келіп, саясатымды өзгерттім. Ол жылдам допты лақтырды!
Dialogue: 0,0:03:22.16,0:03:24.25,Default,,0,0,0,,«Мені ұнатасың ба?»
Dialogue: 0,0:03:24.37,0:03:27.29,Default,,0,0,0,,Иә, осында және қазір! Менің не айтқым келгенін білесің бе?
Dialogue: 0,0:03:27.41,0:03:28.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:28.95,0:03:30.58,Default,,0,0,0,,‎Бұл Хайдадан көңілің қалғандықтан емес пе?
Dialogue: 0,0:03:30.70,0:03:32.25,Default,,0,0,0,,№.
Dialogue: 0,0:03:32.54,0:03:33.54,Default,,0,0,0,,Ол көмектесе алмайды
Dialogue: 0,0:03:33.66,0:03:34.70,Default,,0,0,0,,Мен Хайда мырзаны қалаймын.
Dialogue: 0,0:03:37.00,0:03:39.33,Default,,0,0,0,,‎Оу, Инуи-сан сондай сүйкімді!
Dialogue: 0,0:03:39.75,0:03:40.91,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:03:41.04,0:03:42.45,Default,,0,0,0,,‎Маған неге айтып тұрсың!
Dialogue: 0,0:03:51.83,0:03:55.58,Default,,0,0,0,,‎(Тонның қызы) Боо
Dialogue: 0,0:03:57.25,0:03:58.79,Default,,0,0,0,,‎(Тонның қызы) Қалай ойлайсың? (Тонның қызы) Йокиоки
Dialogue: 0,0:03:58.91,0:04:02.54,Default,,0,0,0,,‎boo
Dialogue: 0,0:04:02.66,0:04:04.29,Default,,0,0,0,,‎(Тонның қызы) Қалай ойлайсың? (Тонның қызы) Йокиоки
Dialogue: 0,0:04:04.41,0:04:07.25,Default,,0,0,0,,‎(2 адам) Боо!
Dialogue: 0,0:04:07.37,0:04:10.50,Default,,0,0,0,,‎(иіскеу дыбысы) ‎Бұл өте қатты!
Dialogue: 0,0:04:10.70,0:04:13.66,Default,,0,0,0,,‎Сіз маңайға кедергісіз. Өтінемін, тыныш болыңыз.
Dialogue: 0,0:04:14.20,0:04:17.45,Default,,0,0,0,,‎Эх~ Мен кәдімгі өлімге қарсы шайқаста болдым.
Dialogue: 0,0:04:17.58,0:04:19.00,Default,,0,0,0,,үшін осы.
Dialogue: 0,0:04:19.29,0:04:21.41,Default,,0,0,0,,‎Өлім... Бұл не?
Dialogue: 0,0:04:21.75,0:04:23.91,Default,,0,0,0,,(Тонның қызы) ше? Сіз білмейсіз бе? (Тонның қызы) Дассе
Dialogue: 0,0:04:24.29,0:04:27.79,Default,,0,0,0,,Мен Өлім дауысы туралы айтып отырмын. Білесіз бе, мұндай нәрсе.
Dialogue: 0,0:04:28.04,0:04:29.83,Default,,0,0,0,,‎Сондай сүйкімді емес пе?
Dialogue: 0,0:04:30.41,0:04:35.25,Default,,0,0,0,,‎Оны қалай жасау керектігін осы бейнеден үйреніп, тәжірибе жасадық.
Dialogue: 0,0:04:35.66,0:04:37.91,Default,,0,0,0,,‎Бұл бала ашықтан-ашық істемейді, бірақ...
Dialogue: 0,0:04:38.04,0:04:40.33,Default,,0,0,0,,‎Ол сөзсіз OTM қызы.
Dialogue: 0,0:04:40.54,0:04:44.08,Default,,0,0,0,,Сайтамада біз ғана байқадық.
Dialogue: 0,0:04:44.70,0:04:46.70,Default,,0,0,0,,‎Бұл OTM деген не?
Dialogue: 0,0:04:47.12,0:04:49.12,Default,,0,0,0,,(Тонның қызы) ше? Сіз білмейсіз бе? (Тонның қызы) Дассе
Dialogue: 0,0:04:49.87,0:04:53.83,Default,,0,0,0,,‎(2 адам) Бұл дәл қазір ең қауіпті пұт бірлігі!
Dialogue: 0,0:04:54.33,0:04:58.75,Default,,0,0,0,,‎(OTM Қыздардың ән айту дауысы)
Dialogue: 0,0:05:23.62,0:05:27.04,Default,,0,0,0,,(иіскеу дыбысы) Сен білесің бе?
Dialogue: 0,0:05:36.91,0:05:41.29,Default,,0,0,0,,Менің екі қызымның да сәл эксцентрик хоббиі бар.
Dialogue: 0,0:05:41.41,0:05:44.33,Default,,0,0,0,,‎Жақында мен жер асты пұттары сияқты нәрселерге құмар болдым.
Dialogue: 0,0:05:45.33,0:05:46.16,Default,,0,0,0,,Хе
Dialogue: 0,0:05:47.58,0:05:50.58,Default,,0,0,0,,Екеуі де сіздің жанкүйерлеріңіз сияқты.
Dialogue: 0,0:05:50.83,0:05:52.79,Default,,0,0,0,,‎Hehehehe…
Dialogue: 0,0:05:55.62,0:06:01.00,Default,,0,0,0,,‎158 иен 1 ұпай 125 иен 1 ұпай 490 иен 1 ұпай
Dialogue: 0,0:06:01.75,0:06:04.37,Default,,0,0,0,,‎1,139 иенден астам
Dialogue: 0,0:06:06.75,0:06:09.54,Default,,0,0,0,,‎(Клерк) Манака-чан Иә
Dialogue: 0,0:06:10.12,0:06:12.41,Default,,0,0,0,,‎(Клерк) Бүгін OTM ресми тіркелгісі-
Dialogue: 0,0:06:12.54,0:06:15.16,Default,,0,0,0,,Мен оны қарастырмағаныма біраз болды...
Dialogue: 0,0:06:15.54,0:06:17.54,Default,,0,0,0,,‎Жазушылар айтарлықтай өсті.
Dialogue: 0,0:06:17.91,0:06:19.16,Default,,0,0,0,,‎Аздап сатылып жатқан жоқ па?
Dialogue: 0,0:06:19.29,0:06:22.45,Default,,0,0,0,,‎Ах хаха рахмет сізге
Dialogue: 0,0:06:23.91,0:06:25.54,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:06:26.16,0:06:29.87,Default,,0,0,0,,‎Егер сіз сонда тамақ іше алсаңыз, бұл жұмыстан шығасыз ба?
Dialogue: 0,0:06:30.08,0:06:33.45,Default,,0,0,0,,‎Жоқ~ Шынымды айтсам, әлі алда көп жолым бар.
Dialogue: 0,0:06:33.70,0:06:36.50,Default,,0,0,0,,О, түсіндім. Содан кейін мен толық емес жұмыс күнін жалғастырамын.
Dialogue: 0,0:06:36.91,0:06:38.04,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:39.50,0:06:42.83,Default,,0,0,0,,‎Бірақ бір күні сіз бір жерді таңдауыңыз керек, солай емес пе?
Dialogue: 0,0:06:43.20,0:06:44.66,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:45.79,0:06:48.41,Default,,0,0,0,,‎(Клерк) А, сіз қазір тамақ ішуге болады.
Dialogue: 0,0:06:48.54,0:06:50.08,Default,,0,0,0,,Менің тапсырысым бар.
Dialogue: 0,0:06:50.20,0:06:51.25,Default,,0,0,0,,Иә
Dialogue: 0,0:06:51.62,0:06:53.41,Default,,0,0,0,,Мен оны бірінші аламын.
Dialogue: 0,0:06:55.75,0:06:58.62,Default,,0,0,0,,Әй? қарыз?
Dialogue: 0,0:06:59.33,0:07:00.33,Default,,0,0,0,,Иә
Dialogue: 0,0:07:02.20,0:07:03.54,Default,,0,0,0,,‎Қанша бар?
Dialogue: 0,0:07:04.33,0:07:06.75,Default,,0,0,0,,‎Сіз ұрған адамға шамамен 200 000 иен
Dialogue: 0,0:07:07.83,0:07:10.25,Default,,0,0,0,,‎Аа, ол қазір айтарлықтай төмендеді.
Dialogue: 0,0:07:14.00,0:07:16.66,Default,,0,0,0,,‎Осындай мәселелер бойынша мүмкіндігінше тезірек бізбен кеңесіңіз.
Dialogue: 0,0:07:18.37,0:07:19.75,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:21.54,0:07:24.25,Default,,0,0,0,,Мен оны төлеймін. Қанша қалды?
Dialogue: 0,0:07:24.50,0:07:26.79,Default,,0,0,0,,Ех! Ал...
Dialogue: 0,0:07:26.91,0:07:29.75,Default,,0,0,0,,Сіз қарызыңыз бар болғандықтан шыға алмаймын деп жатырсыз, солай ма?
Dialogue: 0,0:07:30.12,0:07:33.12,Default,,0,0,0,,‎Міндеттеріңізді орындап, дереу жұмыстан кеткеніңіз дұрыс емес пе?
Dialogue: 0,0:07:33.45,0:07:34.58,Default,,0,0,0,,Қанша?
Dialogue: 0,0:07:35.33,0:07:36.62,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:07:37.20,0:07:41.70,Default,,0,0,0,,‎Енді ақша мәселесі шешілді, бұл маңызды емес.
Dialogue: 0,0:07:42.00,0:07:42.95,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:43.41,0:07:47.62,Default,,0,0,0,,Менің достарым бар, барлығы өз армандары үшін аянбай еңбек етуде.
Dialogue: 0,0:07:49.29,0:07:52.66,Default,,0,0,0,,‎Хе, хахаха...
Dialogue: 0,0:07:53.37,0:07:56.20,Default,,0,0,0,,Эй, мені қате түсінбе.
Dialogue: 0,0:07:56.70,0:07:58.41,Default,,0,0,0,,‎Бұл компания.
Dialogue: 0,0:07:58.58,0:08:02.54,Default,,0,0,0,,‎Мен сіздің досыңызды білмеймін немесе оны қызықтырмаймын.
Dialogue: 0,0:08:03.08,0:08:04.75,Default,,0,0,0,,Сіздің негізгі жұмысыңыз қайсысы?
Dialogue: 0,0:08:05.75,0:08:10.29,Default,,0,0,0,,‎Бұл... Мен осы компанияда есепші болып жұмыс істеймін.
Dialogue: 0,0:08:10.70,0:08:15.33,Default,,0,0,0,,‎Сонымен, жұмыс кезінде ұйықтап қалу сіздің негізгі жұмысыңыздың бір бөлігі ме? Ха
Dialogue: 0,0:08:15.91,0:08:17.58,Default,,0,0,0,,Бұзбаңыз
Dialogue: 0,0:08:23.45,0:08:25.66,Default,,0,0,0,,‎Қазір өмір қызық, солай емес пе?
Dialogue: 0,0:08:27.62,0:08:29.70,Default,,0,0,0,,Жаңа орын табу-
Dialogue: 0,0:08:29.83,0:08:32.66,Default,,0,0,0,,Менің ойымша, сіз өзіңізді қайта туылғандай сезінесіз...
Dialogue: 0,0:08:33.20,0:08:34.95,Default,,0,0,0,,‎Қашып кететін жер жоқ.
Dialogue: 0,0:08:37.25,0:08:39.58,Default,,0,0,0,,‎Көзге көрінбейтін жерде қарыздар көбейеді.
Dialogue: 0,0:08:39.70,0:08:42.41,Default,,0,0,0,,‎Жақында өндіріп алушы ақша жинауға келеді.
Dialogue: 0,0:08:43.04,0:08:45.29,Default,,0,0,0,,Сонда шыдай алмайсың ба?
Dialogue: 0,0:08:46.66,0:08:49.45,Default,,0,0,0,,‎Таңдау жасауға мәжбүр болған кезде...
Dialogue: 0,0:08:49.91,0:08:51.83,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:08:53.20,0:08:54.50,Default,,0,0,0,,Мен...
Dialogue: 0,0:08:56.33,0:08:59.83,Default,,0,0,0,,‎Уақыты келгенде мен...
Dialogue: 0,0:09:00.25,0:09:02.50,Default,,0,0,0,,‎(Ұялы телефонның дірілдеген дыбысы) ‎(Ретсуко) Ах!
Dialogue: 0,0:09:08.41,0:09:10.29,Default,,0,0,0,,‎Эй, сен не істеп жатырсың?
Dialogue: 0,0:09:10.95,0:09:12.83,Default,,0,0,0,,Әңгіме әлі аяқталған жоқ!
Dialogue: 0,0:09:13.50,0:09:15.00,Default,,0,0,0,,Уақыты келгенде-
Dialogue: 0,0:09:15.37,0:09:16.79,Default,,0,0,0,,Мен компаниядан кетемін
Dialogue: 0,0:09:18.75,0:09:21.29,Default,,0,0,0,,‎Эй, сәл күте тұрыңыз.
Dialogue: 0,0:09:21.41,0:09:22.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:23.25,0:09:24.75,Default,,0,0,0,,‎Ол қазірден бастап жеке.
Dialogue: 0,0:09:25.79,0:09:27.29,Default,,0,0,0,,‎Ааа...
Dialogue: 0,0:09:38.12,0:09:39.20,Default,,0,0,0,,А, менеджер?
Dialogue: 0,0:09:39.45,0:09:41.91,Default,,0,0,0,,Сіз OTM есептік жазбасын көрдіңіз бе?
Dialogue: 0,0:09:42.83,0:09:45.50,Default,,0,0,0,,‎Сіз ресми аккаунтты айтасыз ба? Мен оны бүгін таңертең көрдім
Dialogue: 0,0:09:45.62,0:09:48.08,Default,,0,0,0,,‎Дәлірек айтсақ, тікелей эфирдегі ақпаратты жаңартқан мен болдым.
Dialogue: 0,0:09:48.33,0:09:51.91,Default,,0,0,0,,Бұл емес! Бұл ресми емес, жалған
Dialogue: 0,0:09:52.20,0:09:54.75,Default,,0,0,0,,‎Елдік тіркелгі Есіңізде ме?
Dialogue: 0,0:09:55.20,0:09:57.45,Default,,0,0,0,,О, бұл болды.
Dialogue: 0,0:09:57.91,0:09:59.70,Default,,0,0,0,,‎Тезірек қараңызшы ‎(Келуші қоңырауы)
Dialogue: 0,0:09:59.83,0:10:02.12,Default,,0,0,0,,‎Кешіріңіз, менің тұтынушым бар, сондықтан телефонды қоямын.
Dialogue: 0,0:10:44.83,0:10:45.79,Default,,0,0,0,,Йо
Dialogue: 0,0:10:48.66,0:10:49.66,Default,,0,0,0,,Йо
Dialogue: 0,0:10:50.54,0:10:53.16,Default,,0,0,0,,Өткен күнгі карри дәмді болды.
Dialogue: 0,0:10:54.66,0:10:57.29,Default,,0,0,0,,‎Тоңазытқышқа қоймас бұрын оны дұрыс суыттың ба?
Dialogue: 0,0:10:57.95,0:10:59.45,Default,,0,0,0,,Иә, мен енгіздім.
Dialogue: 0,0:11:01.12,0:11:02.20,Default,,0,0,0,,тамаша
Dialogue: 0,0:11:03.95,0:11:07.25,Default,,0,0,0,,‎Бүгінгі күні... Кешіріңіз.
Dialogue: 0,0:11:12.20,0:11:15.29,Default,,0,0,0,,Менің ойымша, бұл жай ғана уақыт мәселесі.
Dialogue: 0,0:11:15.70,0:11:18.70,Default,,0,0,0,,‎Бұл қалыпты жағдай және бұл туралы ештеңе істей алмайсыз.
Dialogue: 0,0:11:18.83,0:11:20.58,Default,,0,0,0,,Түсінбегеніме мен кінәлімін.
Dialogue: 0,0:11:22.50,0:11:26.29,Default,,0,0,0,,Бөлмеге келген адам бухгалтериядан екен, солай ма?
Dialogue: 0,0:11:26.70,0:11:27.95,Default,,0,0,0,,‎(мүйіз)
Dialogue: 0,0:11:28.08,0:11:30.62,Default,,0,0,0,,Бала болғаныма өкінемін.
Dialogue: 0,0:11:31.62,0:11:33.66,Default,,0,0,0,,Мұқият ойлан
Dialogue: 0,0:11:39.91,0:11:41.70,Default,,0,0,0,,Мұқият ойланыңыз
Dialogue: 0,0:11:44.58,0:11:45.91,Default,,0,0,0,,‎Нарухаяде
Dialogue: 0,0:12:02.91,0:12:05.50,Default,,0,0,0,,‎(Hyodo) Мен жою туралы өтініш жібердім.
Dialogue: 0,0:12:06.16,0:12:08.87,Default,,0,0,0,,Алайда, егер бұл анық суретке түсірілген болса ...
Dialogue: 0,0:12:09.00,0:12:11.08,Default,,0,0,0,,Сіздің мекен-жайыңыздың бөлінетінін есте ұстаған жөн.
Dialogue: 0,0:12:11.20,0:12:12.83,Default,,0,0,0,,‎(Ретсуко) Сіз нені айтып тұрсыз?
Dialogue: 0,0:12:13.00,0:12:15.20,Default,,0,0,0,,‎Бір жалқау сіздің мекенжайыңызды талдапты...
Dialogue: 0,0:12:15.33,0:12:17.29,Default,,0,0,0,,Интернеттегі ақпаратты ашу
Dialogue: 0,0:12:17.75,0:12:21.33,Default,,0,0,0,,‎Ал кем дегенде суретке түсірген адам сіздің мекен-жайыңызды біледі.
Dialogue: 0,0:12:21.45,0:12:22.50,Default,,0,0,0,,Иә
Dialogue: 0,0:12:23.29,0:12:27.12,Default,,0,0,0,,‎Бірақ біздің үйде автоматты құлыптау жүйесі бар, сондықтан абай болсаңыз, бәрі жақсы болады.
Dialogue: 0,0:12:27.37,0:12:31.25,Default,,0,0,0,,‎Бұл адам жай ғана жанкүйер, сондықтан ол мұны жаман ниетпен істемеген сияқты.
Dialogue: 0,0:12:31.45,0:12:33.62,Default,,0,0,0,,‎Жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ, жоқ!
Dialogue: 0,0:12:33.75,0:12:35.45,Default,,0,0,0,,‎(Hidarin Migi) Манака тілі
Dialogue: 0,0:12:36.41,0:12:39.00,Default,,0,0,0,,Қудалау
Dialogue: 0,0:12:39.29,0:12:42.25,Default,,0,0,0,,‎Егер сен пұт болсаң, ақылға сыймайтын нәрселер болады.
Dialogue: 0,0:12:42.79,0:12:44.33,Default,,0,0,0,,Сіз бұл туралы жаман сезінуіңіз мүмкін, бірақ...
Dialogue: 0,0:12:44.45,0:12:45.50,Default,,0,0,0,,‎(Ретсуко) Жарайды!
Dialogue: 0,0:12:45.95,0:12:47.00,Default,,0,0,0,,А?
Dialogue: 0,0:12:48.70,0:12:51.33,Default,,0,0,0,,‎(Ретсуко) Мұндай нәрсе мүлдем маңызды емес.
Dialogue: 0,0:12:52.04,0:12:55.33,Default,,0,0,0,,Өйткені бұл мен тиесілі жер.
Dialogue: 0,0:12:56.62,0:13:01.54,Default,,0,0,0,,‎(OTM Girls ән айтатын дауысы)
Dialogue: 0,0:13:01.70,0:13:03.41,Default,,0,0,0,,‎ Иә, әрі қарай артқа оралыңыз.
Dialogue: 0,0:13:03.54,0:13:06.79,Default,,0,0,0,,Дүрбелеңге түспеңіз және біздің нұсқауларымызды орындаңыз Хэхе
Dialogue: 0,0:13:07.00,0:13:09.91,Default,,0,0,0,,‎(Танака-сан) Ережелерді орындаңыз және тәртіппен пайдаланыңыз.
Dialogue: 0,0:13:11.54,0:13:13.54,Default,,0,0,0,,Мен Рецу-чаннан өмір сүруге күш алдым
Dialogue: 0,0:13:13.87,0:13:15.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:15.12,0:13:18.20,Default,,0,0,0,,‎Мен сені қатты жақсы көремін, не істеуім керек?
Dialogue: 0,0:13:18.33,0:13:20.25,Default,,0,0,0,,‎Қолдауыңыз үшін рахмет
Dialogue: 0,0:13:20.95,0:13:22.66,Default,,0,0,0,,‎(Ретсуко) Мұнда келетін адамдар...
Dialogue: 0,0:13:22.79,0:13:26.25,Default,,0,0,0,,‎Ол менің қолымды алғанына шын жүректен қуанды.
Dialogue: 0,0:13:26.66,0:13:29.25,Default,,0,0,0,,‎Сен маған жарқыраған көздеріңмен қарадың.
Dialogue: 0,0:13:30.00,0:13:32.79,Default,,0,0,0,,‎Олардың барлығы шын мәнінде жылы және жақсы адамдар еді...
Dialogue: 0,0:13:39.83,0:13:42.08,Default,,0,0,0,,‎(Patch Man) 100 дана (Ретсуко) 100 дана! ?
Dialogue: 0,0:13:43.66,0:13:46.95,Default,,0,0,0,,‎Ал, бір қол алысу билеті 3 секундты алады...
Dialogue: 0,0:13:48.37,0:13:50.66,Default,,0,0,0,,100 дана үшін 300 секунд
Dialogue: 0,0:13:51.37,0:13:52.70,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:13:53.91,0:13:55.45,Default,,0,0,0,,‎(Patch Man) Мен үлкен жанкүйермін.
Dialogue: 0,0:13:58.45,0:14:01.33,Default,,0,0,0,,‎Аа... Рахмет
Dialogue: 0,0:14:02.37,0:14:04.83,Default,,0,0,0,,‎(Жамау адам) Агрессивті Рецуко
Dialogue: 0,0:14:05.25,0:14:06.20,Default,,0,0,0,,Иә
Dialogue: 0,0:14:07.20,0:14:10.00,Default,,0,0,0,,‎(Жамау адам) Бұл сіз айтқандай агрессивті емес.
Dialogue: 0,0:14:12.16,0:14:13.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:14.62,0:14:16.20,Default,,0,0,0,,‎(Жамау адам) Е...
Dialogue: 0,0:14:17.66,0:14:22.20,Default,,0,0,0,,Музыкалық жағынан жаңалық табылмады, әннің сөзі тыңдалмады.
Dialogue: 0,0:14:22.33,0:14:25.04,Default,,0,0,0,,‎Сіз қателесіп ойлаған нәрсеңіз өрнек...
Dialogue: 0,0:14:25.16,0:14:27.58,Default,,0,0,0,,‎Ешбір ерекше әсерге ие бола алмау...
Dialogue: 0,0:14:27.70,0:14:29.41,Default,,0,0,0,,Шынымды айтсам...
Dialogue: 0,0:14:29.91,0:14:32.16,Default,,0,0,0,,‎Егер мен өз ойымды айтсам...
Dialogue: 0,0:14:32.37,0:14:35.12,Default,,0,0,0,,‎Қарама-қарсы, ақымақ иық су белгісі
Dialogue: 0,0:14:35.25,0:14:37.41,Default,,0,0,0,,‎Өте төмен шикі қоқыс
Dialogue: 0,0:14:38.75,0:14:41.95,Default,,0,0,0,,Автоматты жинау машинасында желдеткіштен ақша бопсалау.
Dialogue: 0,0:14:42.08,0:14:46.25,Default,,0,0,0,,‎Өзін басқаларға армандауға және өмір сүруге күш бергендей сезінетін, өзін-өзі сезінетін ұсқынсыз адам.
Dialogue: 0,0:14:47.08,0:14:51.50,Default,,0,0,0,,Жанкүйер ретінде мен де аямаймын.
Dialogue: 0,0:14:56.95,0:14:58.45,Default,,0,0,0,,30 секунд?
Dialogue: 0,0:14:59.70,0:15:01.41,Default,,0,0,0,,‎5 минут – көп уақыт.
Dialogue: 0,0:15:04.91,0:15:09.91,Default,,0,0,0,,‎♪～
Dialogue: 0,0:15:34.66,0:15:39.66,Default,,0,0,0,,‎～♪
