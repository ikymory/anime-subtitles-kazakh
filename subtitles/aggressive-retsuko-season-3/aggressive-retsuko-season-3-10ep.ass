Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.45,0:00:16.66,Default,,0,0,0,,‎(Ретсуко) OTM қанша сатады.
Dialogue: 0,0:00:16.91,0:00:18.91,Default,,0,0,0,,Бұл атақтылар салығы деп аталады.
Dialogue: 0,0:00:19.29,0:00:21.12,Default,,0,0,0,,‎Олар адамдардың аз ғана бөлігі қарсы екенін айтады.
Dialogue: 0,0:00:21.25,0:00:24.25,Default,,0,0,0,,‎Бізді одан жүз есе көп қолдайтын жанкүйерлер бар.
Dialogue: 0,0:00:24.79,0:00:26.62,Default,,0,0,0,,‎Біз сол адамдар үшін барымызды салуымыз керек!
Dialogue: 0,0:00:31.25,0:00:32.79,Default,,0,0,0,,Мен дәретханаға барамын.
Dialogue: 0,0:00:35.08,0:00:36.83,Default,,0,0,0,,‎(Миги) Директор: Сіз таңқаларлықтай жақсы сияқтысыз.
Dialogue: 0,0:00:36.95,0:00:38.33,Default,,0,0,0,,‎Ақыл-ой күші
Dialogue: 0,0:00:40.29,0:00:42.12,Default,,0,0,0,,Менің қолымды 5 минут ұстады...
Dialogue: 0,0:00:42.25,0:00:44.41,Default,,0,0,0,,Мені күлімсіреп ренжітті.
Dialogue: 0,0:00:45.83,0:00:46.87,Default,,0,0,0,,Ешқандай жағдай жоқ.
Dialogue: 0,0:00:50.50,0:00:53.54,Default,,0,0,0,,Қарыз жинаушылар ақшаны жинауға келеді.
Dialogue: 0,0:00:53.87,0:00:56.62,Default,,0,0,0,,Ақырында қашатын жер жоқ.
Dialogue: 0,0:00:56.75,0:01:01.00,Default,,0,0,0,,‎♪～
Dialogue: 0,0:01:01.50,0:01:02.33,Default,,0,0,0,,Уф
Dialogue: 0,0:01:36.87,0:01:41.87,Default,,0,0,0,,‎～♪
Dialogue: 0,0:01:46.04,0:01:47.79,Default,,0,0,0,,‎(Хайда) Егер ол көтерілсе, Рецуко
Dialogue: 0,0:01:48.37,0:01:49.54,Default,,0,0,0,,‎Егер құйрықтар шықса...
Dialogue: 0,0:01:54.12,0:01:55.29,Default,,0,0,0,,мырза. Инуи
Dialogue: 0,0:01:59.41,0:02:00.54,Default,,0,0,0,,мырза. Инуи
Dialogue: 0,0:02:00.79,0:02:03.83,Default,,0,0,0,,‎Ретсуко Инуи-сан Рецуко Инуи-сан Рецуко Инуи-сан―
Dialogue: 0,0:02:03.95,0:02:05.91,Default,,0,0,0,,‎Ретсуко Инуи-сан Рецуко…
Dialogue: 0,0:02:07.58,0:02:08.58,Default,,0,0,0,,‎(Хайда) Инуи мырза
Dialogue: 0,0:02:09.41,0:02:11.70,Default,,0,0,0,,‎(Фенеко) Эй, гүлдерді рұқсатсыз жұлма.
Dialogue: 0,0:02:13.29,0:02:15.04,Default,,0,0,0,,‎Сізді әлі не мазалайсыз?
Dialogue: 0,0:02:15.54,0:02:16.79,Default,,0,0,0,,Барлығы сіз сияқты
Dialogue: 0,0:02:16.91,0:02:19.50,Default,,0,0,0,,Мен заттарды сабырмен бөлетін адам емеспін.
Dialogue: 0,0:02:20.75,0:02:22.16,Default,,0,0,0,,‎Бірақ сіз таңдай алмайсыз
Dialogue: 0,0:02:22.66,0:02:24.12,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:02:25.00,0:02:28.12,Default,,0,0,0,,‎(Фенеко) Менің сабырлы пікірімді тыңдап көріңіз.
Dialogue: 0,0:02:29.95,0:02:31.62,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:02:32.33,0:02:35.66,Default,,0,0,0,,‎Мен жай ғана бақытты болғым келсе, жақсы ма?
Dialogue: 0,0:02:36.29,0:02:37.33,Default,,0,0,0,,‎Оу
Dialogue: 0,0:02:38.16,0:02:40.12,Default,,0,0,0,,‎(Фенеко), содан кейін Инуи мырза
Dialogue: 0,0:02:41.54,0:02:42.66,Default,,0,0,0,,күрсіну…
Dialogue: 0,0:02:45.62,0:02:47.58,Default,,0,0,0,,‎Күтілгендей.
Dialogue: 0,0:02:48.00,0:02:51.29,Default,,0,0,0,,‎Ер адамның иығына тіккен жүрек тәрізді жамау
Dialogue: 0,0:02:51.75,0:02:55.83,Default,,0,0,0,,‎Бұл 2018 жылдың ақпан айында өте қысқа мерзімге тікелей эфирлерде сатылды.
Dialogue: 0,0:02:55.95,0:02:58.62,Default,,0,0,0,,‎Баспадан тез шығып кететін сирек зат.
Dialogue: 0,0:02:58.75,0:03:00.33,Default,,0,0,0,,‎(Хёдо) Мен осындай нәрсе жасадым ба?
Dialogue: 0,0:03:00.45,0:03:01.29,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:01.66,0:03:04.50,Default,,0,0,0,,Өнімге біраз ой салыңыз.
Dialogue: 0,0:03:04.62,0:03:07.58,Default,,0,0,0,,‎Хиодо-сан өз жанкүйерлерін тек ақша табу деп санайды.
Dialogue: 0,0:03:08.54,0:03:10.91,Default,,0,0,0,,‎Қысқасы, патч жігіттері басынан бері...
Dialogue: 0,0:03:11.04,0:03:13.91,Default,,0,0,0,,‎Бұл сіздің жанкүйер болу мүмкіндігіңіз жоғары дегенді білдіре ме?
Dialogue: 0,0:03:14.04,0:03:18.12,Default,,0,0,0,,‎Ардагер ойыншылардың арасында Десбо бағытымен келіспейтін көптеген дауыстар бар.
Dialogue: 0,0:03:18.33,0:03:22.12,Default,,0,0,0,,‎Ол директор Рецукоға өшпенділіктен әрекет етті деп есептесеңіз, мағынасы бар.
Dialogue: 0,0:03:46.12,0:03:48.50,Default,,0,0,0,,‎(Ретсуко) Жамалы бар адам және спуфинг сайтының әкімшісі...
Dialogue: 0,0:03:48.62,0:03:49.54,Default,,0,0,0,,Бір адам?
Dialogue: 0,0:03:50.54,0:03:52.00,Default,,0,0,0,,Сіз оны қарадыңыз ба?
Dialogue: 0,0:03:52.12,0:03:54.20,Default,,0,0,0,,‎Жоқ, бұл жай ғана болжам.
Dialogue: 0,0:03:54.95,0:03:58.20,Default,,0,0,0,,Ең нашар жағдайды елестетіп көріңіз.
Dialogue: 0,0:03:58.79,0:04:02.37,Default,,0,0,0,,‎Егер ол белгіше сіздің үйіңіздің қайда екенін білсе ше?
Dialogue: 0,0:04:02.75,0:04:03.95,Default,,0,0,0,,А...
Dialogue: 0,0:04:05.95,0:04:06.83,Default,,0,0,0,,Уф
Dialogue: 0,0:04:07.20,0:04:10.58,Default,,0,0,0,,Жарайды! сенімді болыңыз
Dialogue: 0,0:04:10.79,0:04:13.12,Default,,0,0,0,,‎Себебі біз сені қорғаймыз
Dialogue: 0,0:04:16.45,0:04:18.54,Default,,0,0,0,,‎Сен ертең үйге нешеде жетесің?
Dialogue: 0,0:04:18.70,0:04:22.16,Default,,0,0,0,,Мен жұмыстан кешкі сағат 18:00-де шығамын, ал басқа ештеңе болмаса, сағат 19:00 шамасында.
Dialogue: 0,0:04:22.54,0:04:25.12,Default,,0,0,0,,‎Жарайды, мен сені компанияға апарамын.
Dialogue: 0,0:04:25.45,0:04:28.25,Default,,0,0,0,,Иә? Бұл жақсы, бірақ қиын.
Dialogue: 0,0:04:28.37,0:04:29.75,Default,,0,0,0,,Ұстамаңыз
Dialogue: 0,0:04:29.87,0:04:33.16,Default,,0,0,0,,‎Хёдо-сан, ол әдетте бас менеджердің жұмыс орнына жақын жерде жұмыс істейтін сияқты.
Dialogue: 0,0:04:33.29,0:04:34.70,Default,,0,0,0,,‎Ей, қажетсіз сөздер айтпа!
Dialogue: 0,0:04:34.83,0:04:36.50,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:04:36.91,0:04:38.83,Default,,0,0,0,,‎(Ретсуко) Күтпеген (Хёдо) Уф
Dialogue: 0,0:04:39.08,0:04:42.37,Default,,0,0,0,,Сіз қай компанияда жұмыс істейсіз? Хёудо мырза
Dialogue: 0,0:04:42.75,0:04:45.25,Default,,0,0,0,,‎Мен бұл тақырыпты қозғасам, адамдар үнсіз қалады.
Dialogue: 0,0:04:45.37,0:04:46.91,Default,,0,0,0,,‎(Ретсуко) Хёудо-сан
Dialogue: 0,0:04:48.70,0:04:49.83,Default,,0,0,0,,‎(ысырма дыбысы)
Dialogue: 0,0:04:50.75,0:04:54.41,Default,,0,0,0,,‎(ысырма дыбысы)
Dialogue: 0,0:05:13.08,0:05:14.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:15.54,0:05:16.87,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:05:18.66,0:05:19.50,Default,,0,0,0,,‎Бұл не?
Dialogue: 0,0:05:26.91,0:05:29.54,Default,,0,0,0,,‎(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:05:30.87,0:05:33.62,Default,,0,0,0,,‎Манака-чан? Не болды?
Dialogue: 0,0:05:33.95,0:05:36.41,Default,,0,0,0,,‎Директор, қазір қайдасыз? компания?
Dialogue: 0,0:05:36.54,0:05:39.54,Default,,0,0,0,,Иә, мен жұмыстан үйге келе жатырмын.
Dialogue: 0,0:05:39.83,0:05:41.54,Default,,0,0,0,,‎Онда әлі кеңседен шықпаңыз.
Dialogue: 0,0:05:41.66,0:05:43.12,Default,,0,0,0,,Ішінде күтіңіз.
Dialogue: 0,0:05:43.25,0:05:44.75,Default,,0,0,0,,Иә? Неліктен?
Dialogue: 0,0:05:44.87,0:05:47.75,Default,,0,0,0,,Себебі мен бүгін Хёуду-санмен кездесіп тұрмын.
Dialogue: 0,0:05:47.87,0:05:49.58,Default,,0,0,0,,‎Дұрыс!
Dialogue: 0,0:05:49.87,0:05:52.62,Default,,0,0,0,,Жағдай өзгерді. Интернеттен қараңыз.
Dialogue: 0,0:05:52.83,0:05:55.45,Default,,0,0,0,,Сіздің компанияңыз әлдеқашан анықталған.
Dialogue: 0,0:05:56.08,0:05:58.50,Default,,0,0,0,,‎Бұл жай ғана қудалау емес шығар.
Dialogue: 0,0:05:59.00,0:06:00.37,Default,,0,0,0,,Ескерту!
Dialogue: 0,0:06:00.87,0:06:01.75,Default,,0,0,0,,Ескерту?
Dialogue: 0,0:06:02.37,0:06:03.66,Default,,0,0,0,,Ескерту дегеніміз не?
Dialogue: 0,0:06:03.79,0:06:05.70,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:06:05.83,0:06:08.75,Default,,0,0,0,,Амансың ба? Айналада күдікті адамдар бар ма?
Dialogue: 0,0:06:09.00,0:06:10.95,Default,,0,0,0,,Тек сақ болыңыз, сонда бәрі жақсы болады.
Dialogue: 0,0:06:11.25,0:06:14.70,Default,,0,0,0,,Менің айтайын дегенім, бұл айнала іскерлік аудан, сондықтан адамдар өте көп.
Dialogue: 0,0:06:14.87,0:06:17.20,Default,,0,0,0,,‎Айналада ондай күдікті адамдар жоқ...
Dialogue: 0,0:06:24.79,0:06:26.62,Default,,0,0,0,,‎(құлап жатқан дыбыс)
Dialogue: 0,0:06:26.75,0:06:29.79,Default,,0,0,0,,‎(Жауынгерлік адамның ауыр тыныс алуы)
Dialogue: 0,0:06:30.00,0:06:32.66,Default,,0,0,0,,‎Рецуко? не болды? Рецуко!
Dialogue: 0,0:06:32.83,0:06:34.66,Default,,0,0,0,,‎(Жамау адам) Ха ха ха
Dialogue: 0,0:06:35.16,0:06:39.54,Default,,0,0,0,,‎Ха ха ха…
Dialogue: 0,0:06:40.29,0:06:42.04,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:42.75,0:06:44.16,Default,,0,0,0,,Сіз не істеп жатырсыз? Эй!
Dialogue: 0,0:06:44.29,0:06:47.29,Default,,0,0,0,,‎(Жамау адам) Бұл маңызды емес. Жіберу!
Dialogue: 0,0:06:47.41,0:06:48.45,Default,,0,0,0,,Менің жолыма кедергі болма, мені жібер!
Dialogue: 0,0:06:48.45,0:06:51.08,Default,,0,0,0,,Менің жолыма кедергі болма, мені жібер!
Dialogue: 0,0:06:48.45,0:06:51.08,Default,,0,0,0,,Ей, қарама! Біреу маған көмектес!
Dialogue: 0,0:06:57.33,0:06:58.37,Default,,0,0,0,,Рецуко
Dialogue: 0,0:06:59.83,0:07:00.95,Default,,0,0,0,,Рецуко
Dialogue: 0,0:07:01.45,0:07:02.66,Default,,0,0,0,,‎(Хайда) Рецуко! (Жамау адам) Хахаха
Dialogue: 0,0:07:02.79,0:07:06.70,Default,,0,0,0,,‎Түрлі әйел! Алаңдама, Барса.
Dialogue: 0,0:07:06.83,0:07:09.20,Default,,0,0,0,,‎(Өтіп бара жатқан адам) Әй, біреу тездетіп полиция шақыр.
Dialogue: 0,0:07:12.20,0:07:13.37,Default,,0,0,0,,‎Рецуко…
Dialogue: 0,0:07:15.12,0:07:16.25,Default,,0,0,0,,Рецуко
Dialogue: 0,0:07:17.12,0:07:18.37,Default,,0,0,0,,Рецуко!
Dialogue: 0,0:07:19.25,0:07:21.37,Default,,0,0,0,,(Инуи) Қозғалма (Хайда) Ах.
Dialogue: 0,0:07:22.12,0:07:24.33,Default,,0,0,0,,(Инуи) Мен құлаған кезде басымды соқтым.
Dialogue: 0,0:07:25.29,0:07:27.70,Default,,0,0,0,,Қан ағып жатыр.
Dialogue: 0,0:07:28.20,0:07:31.54,Default,,0,0,0,,Сабыр ет, Хайданың қаны шығар.
Dialogue: 0,0:07:32.37,0:07:34.25,Default,,0,0,0,,Мен қазір жедел жәрдем шақырамын.
Dialogue: 0,0:07:37.12,0:07:39.04,Default,,0,0,0,,‎Сәлеметсіз бе, бұл төтенше жағдай ма?
Dialogue: 0,0:07:39.16,0:07:40.83,Default,,0,0,0,,Мен сенің бірден келгеніңді қалаймын.
Dialogue: 0,0:07:41.50,0:07:43.83,Default,,0,0,0,,(Инуи) Жарайды, бұл жер... (Хайда) Әй...
Dialogue: 0,0:07:46.16,0:07:48.08,Default,,0,0,0,,Жақында жедел жәрдем келеді.
Dialogue: 0,0:07:49.70,0:07:50.75,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:53.50,0:07:56.25,Default,,0,0,0,,‎Төтенше жағдайда ғана шұғыл әрекет ету
Dialogue: 0,0:07:57.41,0:08:01.33,Default,,0,0,0,,‎Мен өзіме сәйкес келетін интерпретацияны таба аламын.
Dialogue: 0,0:08:02.62,0:08:05.12,Default,,0,0,0,,Менің ойымша, бұл бәрі емес.
Dialogue: 0,0:08:07.75,0:08:09.54,Default,,0,0,0,,Осындай уақытта кешірім сұраймын
Dialogue: 0,0:08:13.04,0:08:14.12,Default,,0,0,0,,№
Dialogue: 0,0:08:16.04,0:08:17.33,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:19.33,0:08:22.16,Default,,0,0,0,,‎Бұл мұқият қараудың нәтижесі.
Dialogue: 0,0:08:24.70,0:08:27.20,Default,,0,0,0,,‎Ойлау... Болмады.
Dialogue: 0,0:08:30.66,0:08:31.87,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:34.16,0:08:36.08,Default,,0,0,0,,‎Егер мен бұл туралы дұрыс ойласам ...
Dialogue: 0,0:08:36.50,0:08:39.62,Default,,0,0,0,,‎Мен Инуи мырзаны таңдадым деп ойлаймын.
Dialogue: 0,0:08:43.33,0:08:44.37,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:44.87,0:08:49.75,Default,,0,0,0,,‎
Dialogue: 0,0:09:01.91,0:09:02.91,Default,,0,0,0,,А
Dialogue: 0,0:09:09.79,0:09:10.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:18.37,0:09:19.75,Default,,0,0,0,,А...
Dialogue: 0,0:09:22.50,0:09:23.95,Default,,0,0,0,,‎(Аудитория) Оны тоқтатыңыз. (Көрермендер) Бұл көздің жауын алады.
Dialogue: 0,0:09:24.08,0:09:26.41,Default,,0,0,0,,‎(Көрермендер) Сіз қаншалықты қате түсіндіңіз? (Көрермендер) Қарау жағымсыз.
Dialogue: 0,0:09:26.54,0:09:27.50,Default,,0,0,0,,‎(Көрермендер) Қызық, ол тез жоғалып кете ме?
Dialogue: 0,0:09:27.62,0:09:28.58,Default,,0,0,0,,‎(Көрермендер) Еленші әйел
Dialogue: 0,0:09:28.70,0:09:33.37,Default,,0,0,0,,‎(аудитория дауыстары)
Dialogue: 0,0:09:35.83,0:09:37.12,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:09:37.25,0:09:38.50,Default,,0,0,0,,‎(Миги) Сізге көп рахмет
Dialogue: 0,0:09:38.62,0:09:40.50,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:09:50.04,0:09:51.12,Default,,0,0,0,,Рахмет?
Dialogue: 0,0:09:52.62,0:09:53.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:54.12,0:09:57.33,Default,,0,0,0,,‎(Жамау адам) Ол бізден ақша алу арқылы өмір сүреді, солай ма?
Dialogue: 0,0:09:58.91,0:10:00.16,Default,,0,0,0,,Рахмет?
Dialogue: 0,0:10:00.70,0:10:01.79,Default,,0,0,0,,‎(Ретсуко) Мүмкін емес
Dialogue: 0,0:10:08.41,0:10:09.37,Default,,0,0,0,,‎Мүмкін емес
Dialogue: 0,0:10:12.75,0:10:14.45,Default,,0,0,0,,Қашып құтылу мүмкін емес
Dialogue: 0,0:10:16.00,0:10:17.91,Default,,0,0,0,,‎Мен үшін орын жоқ
Dialogue: 0,0:10:19.83,0:10:21.25,Default,,0,0,0,,‎Осындай әлем...
Dialogue: 0,0:10:23.12,0:10:23.95,Default,,0,0,0,,‎Мүмкін емес
Dialogue: 0,0:10:30.58,0:10:31.87,Default,,0,0,0,,‎(Ретсуконың анасы) Рецуко
Dialogue: 0,0:10:33.12,0:10:34.45,Default,,0,0,0,,Рецуко
Dialogue: 0,0:10:35.58,0:10:37.33,Default,,0,0,0,,Рецуко
Dialogue: 0,0:10:38.58,0:10:41.62,Default,,0,0,0,,‎(Ретсуконың анасы) Рецуко өте жақсы қыз.
Dialogue: 0,0:10:41.75,0:10:43.33,Default,,0,0,0,,‎(Екі адам күледі)
Dialogue: 0,0:10:43.95,0:10:47.41,Default,,0,0,0,,‎(Мұғалім) Рецуко – жауапкершілікті сезінетін өте салмақты бала.
Dialogue: 0,0:10:47.79,0:10:49.62,Default,,0,0,0,,‎(Мұғалім) Байыпты және ынтымақтаса да,
Dialogue: 0,0:10:49.75,0:10:52.70,Default,,0,0,0,,Сіз заттарға енжар сияқтысыз...
Dialogue: 0,0:10:52.87,0:10:54.12,Default,,0,0,0,,‎(Пуко) Сіз өмірден ләззат аласыз ба?
Dialogue: 0,0:10:54.66,0:10:56.12,Default,,0,0,0,,‎Сен байсалды баласың, солай ма?
Dialogue: 0,0:10:56.25,0:10:58.83,Default,,0,0,0,,Сізге бұйырылған жұмысты байыппен аяқтаңыз.
Dialogue: 0,0:10:58.95,0:11:00.58,Default,,0,0,0,,Бұл ақымақ.
Dialogue: 0,0:11:01.33,0:11:04.33,Default,,0,0,0,,(Тадано) Рецу-чан болмаса да, жарайды...
Dialogue: 0,0:11:04.95,0:11:06.62,Default,,0,0,0,,‎Компания айналуда
Dialogue: 0,0:11:32.58,0:11:33.66,Default,,0,0,0,,‎(2 адам) үй! ?
Dialogue: 0,0:11:33.79,0:11:36.37,Default,,0,0,0,,‎（）
Dialogue: 0,0:11:36.79,0:11:39.66,Default,,0,0,0,,‎Мүмкін мен бұл пәтерден көшіп кетермін.
Dialogue: 0,0:11:40.12,0:11:41.50,Default,,0,0,0,,‎Кінәлі ұсталды, бірақ...
Dialogue: 0,0:11:41.62,0:11:44.29,Default,,0,0,0,,Сіздің мекен-жайыңыз бен жұмыс орныңыз интернетте таратылды.
Dialogue: 0,0:11:45.20,0:11:49.50,Default,,0,0,0,,Рецуко бұл әлемде өзін қауіпсіз сезінетін жер жоқ деп ойлайды.
Dialogue: 0,0:11:51.54,0:11:53.62,Default,,0,0,0,,Мен қазір әкімшілік демалыстамын...
Dialogue: 0,0:11:53.75,0:11:55.91,Default,,0,0,0,,‎Осылай жалғаса беру жақсы емес.
Dialogue: 0,0:11:56.50,0:11:58.87,Default,,0,0,0,,Сіз отставкаға кетуіңіз немесе жұмыстан босатылуыңыз мүмкін.
Dialogue: 0,0:11:59.04,0:12:00.83,Default,,0,0,0,,‎Одан басқа амал жоқ
Dialogue: 0,0:12:07.08,0:12:08.25,Default,,0,0,0,,Хайда-кун?
Dialogue: 0,0:12:12.25,0:12:14.04,Default,,0,0,0,,Өтірік! Сіз Рецуконы таңдадыңыз ба?
Dialogue: 0,0:12:14.87,0:12:15.62,Default,,0,0,0,,Иә
Dialogue: 0,0:12:15.83,0:12:17.08,Default,,0,0,0,,‎Инуи мырза дегенді қалай түсінесіз?
Dialogue: 0,0:12:18.00,0:12:18.91,Default,,0,0,0,,Иә
Dialogue: 0,0:12:19.50,0:12:20.58,Default,,0,0,0,,‎Хайда-кун ақымақ па?
Dialogue: 0,0:12:20.70,0:12:22.20,Default,,0,0,0,,‎Аа, бұл жігіт негізі ақымақ.
Dialogue: 0,0:12:22.33,0:12:25.20,Default,,0,0,0,,‎Хмм~ Мен көп айттым.
Dialogue: 0,0:12:25.45,0:12:26.58,Default,,0,0,0,,‎(Вашими) Түсінемін.
Dialogue: 0,0:12:27.29,0:12:29.33,Default,,0,0,0,,‎Ол жай ғана ауада ілулі тұр.
Dialogue: 0,0:12:30.04,0:12:31.16,Default,,0,0,0,,Хайда-кун
Dialogue: 0,0:12:31.79,0:12:35.83,Default,,0,0,0,,‎Рецуконың қайтып оралғанын қалайтын болсақ, бәріміз бірдей сезінеміз.
Dialogue: 0,0:12:36.41,0:12:37.83,Default,,0,0,0,,‎Бірақ бұл мүмкін емес.
Dialogue: 0,0:12:38.45,0:12:40.54,Default,,0,0,0,,‎Қазір біз ештеңе істей алмаймыз
Dialogue: 0,0:12:40.66,0:12:43.79,Default,,0,0,0,,‎Рецукоға эмоционалды жараларды емдеуге уақыт керек.
Dialogue: 0,0:12:45.29,0:12:48.75,Default,,0,0,0,,Рецуко соншалықты әлсіз деп ойламаймын.
Dialogue: 0,0:12:49.00,0:12:52.58,Default,,0,0,0,,Жауапсыз нәрсе айтпа! Хайда-кун не біледі?
Dialogue: 0,0:12:53.33,0:12:56.91,Default,,0,0,0,,‎Рецуконың үйіне тыныштықпен келуі үшін орын жасау...
Dialogue: 0,0:12:57.04,0:12:59.16,Default,,0,0,0,,‎Хайда-кун енді мұны істей ала ма?
Dialogue: 0,0:13:00.12,0:13:01.41,Default,,0,0,0,,Бұл мүмкін емес, солай ма?
Dialogue: 0,0:13:02.37,0:13:04.20,Default,,0,0,0,,‎Сонымен~
Dialogue: 0,0:13:07.58,0:13:09.37,Default,,0,0,0,,‎Жаңа махаббат Сагасо
Dialogue: 0,0:13:09.50,0:13:11.79,Default,,0,0,0,,Ал (Вашими) ше? Бір минут күте тұрыңыз, бұл қазір ме?
Dialogue: 0,0:13:11.91,0:13:14.29,Default,,0,0,0,,‎Қолданба аяқталды!
Dialogue: 0,0:13:14.41,0:13:16.08,Default,,0,0,0,,‎Хайда-кун, маған смартфоныңды қарызға бер.
Dialogue: 0,0:13:16.20,0:13:17.16,Default,,0,0,0,,‎(ысырма дыбысы)
Dialogue: 0,0:13:17.58,0:13:19.29,Default,,0,0,0,,‎Жақындаған сайын алыстайсың
Dialogue: 0,0:13:19.41,0:13:22.08,Default,,0,0,0,,‎Хайда-кун үшін Рецуко — шөлдегі сағым
Dialogue: 0,0:13:22.41,0:13:24.83,Default,,0,0,0,,Бұл біздің енді қарым-қатынасымыз жоқ дегенді білдіре ме?
Dialogue: 0,0:13:24.95,0:13:28.75,Default,,0,0,0,,Сіз үлкен үміт күте аласыз. Бұл басқа қолданбалардан ерекшеленеді.
Dialogue: 0,0:13:28.91,0:13:32.95,Default,,0,0,0,,‎Бұл сіздің жаныңыз резонанс тудыратын адамды табуға көмектесетін супер қолданба.
Dialogue: 0,0:13:33.08,0:13:37.41,Default,,0,0,0,,Енді Хайда-кунның тағдырлас серігі кім?
Dialogue: 0,0:13:39.91,0:13:41.16,Default,,0,0,0,,Уау
Dialogue: 0,0:13:41.37,0:13:42.66,Default,,0,0,0,,‎(Вашими) Хайда-кун...
Dialogue: 0,0:13:43.12,0:13:44.45,Default,,0,0,0,,‎(Фенеко) Рецуконың...
Dialogue: 0,0:13:45.58,0:13:47.95,Default,,0,0,0,,‎(Фенеко, Вашими, Гори) Тағайындалған серіктестер?
Dialogue: 0,0:14:01.50,0:14:03.66,Default,,0,0,0,,‎
Dialogue: 0,0:14:04.04,0:14:05.04,Default,,0,0,0,,‎(Рецуконың анасы) Иә.
Dialogue: 0,0:14:05.37,0:14:06.58,Default,,0,0,0,,Иә иә
Dialogue: 0,0:14:09.04,0:14:11.54,Default,,0,0,0,,‎Ха! не? Сіз қайсысысыз?
Dialogue: 0,0:14:12.75,0:14:14.50,Default,,0,0,0,,Мұндай адам
Dialogue: 0,0:14:16.00,0:14:17.20,Default,,0,0,0,,О...
Dialogue: 0,0:14:26.16,0:14:27.29,Default,,0,0,0,,‎Хайда-кун?
Dialogue: 0,0:14:44.20,0:14:45.54,Default,,0,0,0,,Сіз нені айтып тұрсыз?
Dialogue: 0,0:14:48.37,0:14:51.83,Default,,0,0,0,,Менеджер Гори мен Вашими мырза бірдеңе деді ме?
Dialogue: 0,0:14:53.25,0:14:55.33,Default,,0,0,0,,‎Маған мұны сізге қалдыратынымды айтты.
Dialogue: 0,0:14:57.83,0:14:59.62,Default,,0,0,0,,‎Оны сізге қалдыру нені білдіреді?
Dialogue: 0,0:14:59.75,0:15:02.00,Default,,0,0,0,,Рецуконы компанияға қайтару
Dialogue: 0,0:15:02.25,0:15:04.12,Default,,0,0,0,,Неліктен караоке керек?
Dialogue: 0,0:15:04.54,0:15:05.37,Default,,0,0,0,,‎(Вашими) Мұнда...
Dialogue: 0,0:15:05.91,0:15:10.00,Default,,0,0,0,,Бұл сіздің ойыңыздағы нәрсені қалауыңызша сыртқа шығаруға болатын орын.
Dialogue: 0,0:15:12.87,0:15:14.00,Default,,0,0,0,,Қайтып келіңіз.
Dialogue: 0,0:15:14.41,0:15:16.12,Default,,0,0,0,,Кешіріңіз, мүмкін емес
Dialogue: 0,0:15:16.45,0:15:17.54,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:15:17.75,0:15:19.08,Default,,0,0,0,,Мен әлі қорқамын
Dialogue: 0,0:15:19.20,0:15:20.91,Default,,0,0,0,,Оны полиция қамауға алды.
Dialogue: 0,0:15:21.04,0:15:23.08,Default,,0,0,0,,Бұл тек сол адамға қатысты емес.
Dialogue: 0,0:15:23.79,0:15:25.95,Default,,0,0,0,,‎Мен енді істей алмайтын нәрселер өте көп.
Dialogue: 0,0:15:26.91,0:15:28.58,Default,,0,0,0,,‎Аа... хаа
Dialogue: 0,0:15:28.70,0:15:31.66,Default,,0,0,0,,(Хайда) Рецуко күшті, сондықтан бәрібір... (Ретсуко) Ол күшті емес!
Dialogue: 0,0:15:33.08,0:15:35.83,Default,,0,0,0,,‎Хайда-кун дәл осылай ойлайды.
Dialogue: 0,0:15:39.08,0:15:40.16,Default,,0,0,0,,‎
Dialogue: 0,0:15:40.83,0:15:42.54,Default,,0,0,0,,Өтінемін, өзімшіл ештеңе айтпаңыз.
Dialogue: 0,0:15:42.83,0:15:45.04,Default,,0,0,0,,Бұл зорлық, солай ма?
Dialogue: 0,0:15:46.08,0:15:48.50,Default,,0,0,0,,Мен туралы ештеңе білмесең де...
Dialogue: 0,0:15:48.62,0:15:50.25,Default,,0,0,0,,Мен түсіндім деп ойладым...
Dialogue: 0,0:15:50.41,0:15:52.62,Default,,0,0,0,,‎Сен маған сезіміңді күштеп алсаң да...
Dialogue: 0,0:15:52.95,0:15:55.20,Default,,0,0,0,,Шынымды айтсам, алаңдаулы
Dialogue: 0,0:16:00.79,0:16:01.87,Default,,0,0,0,,Сезімдер...
Dialogue: 0,0:16:02.37,0:16:05.87,Default,,0,0,0,,‎Мен оны басқаларға мәжбүрлеуден басқа қалай пайдалана аламын?
Dialogue: 0,0:16:07.00,0:16:08.41,Default,,0,0,0,,‎♪～
Dialogue: 0,0:16:08.54,0:16:09.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:10.45,0:16:13.37,Default,,0,0,0,,‎(Хайда) Сіз оны мәңгілікке қалдырасыз ба?
Dialogue: 0,0:16:14.54,0:16:19.16,Default,,0,0,0,,‎Ууууууууууууууууу!
Dialogue: 0,0:16:45.25,0:16:47.20,Default,,0,0,0,,Сіз кім болғыңыз келеді?
Dialogue: 0,0:16:47.33,0:16:50.33,Default,,0,0,0,,Оны анықтап, шық!
Dialogue: 0,0:16:50.45,0:16:52.12,Default,,0,0,0,,‎Анагурадан
Dialogue: 0,0:16:52.70,0:16:54.70,Default,,0,0,0,,Мен кім болғым келетінін білмеймін
Dialogue: 0,0:16:55.04,0:16:57.00,Default,,0,0,0,,‎Барлығы бірдей түсінбейді
Dialogue: 0,0:16:57.12,0:16:59.33,Default,,0,0,0,,Сонда Хайда-кун ше?
Dialogue: 0,0:16:59.54,0:17:01.20,Default,,0,0,0,,‎Сен қандай болғың келеді?
Dialogue: 0,0:17:05.95,0:17:07.20,Default,,0,0,0,,Мен-
Dialogue: 0,0:17:08.45,0:17:11.54,Default,,0,0,0,,‎Рецуконың орнына айналу ‎(жаңғырық)
Dialogue: 0,0:17:19.00,0:17:21.83,Default,,0,0,0,,Бұл әлемге сену мүмкін емес еді.
Dialogue: 0,0:17:22.41,0:17:25.83,Default,,0,0,0,,Әзірше маған сеніңіз.
Dialogue: 0,0:17:27.08,0:17:28.29,Default,,0,0,0,,‎Қайда?
Dialogue: 0,0:17:29.20,0:17:30.45,Default,,0,0,0,,Сенесіз бе?
Dialogue: 0,0:17:31.12,0:17:36.00,Default,,0,0,0,,‎Аа... Қолданбаның нәтижелерін көргеннен кейін сізге ұнады ма?
Dialogue: 0,0:17:37.16,0:17:39.00,Default,,0,0,0,,‎Хайда-кун өзін қалай сезінді?
Dialogue: 0,0:17:39.12,0:17:40.75,Default,,0,0,0,,‎Бұл мен үшін маңызды емес
Dialogue: 0,0:17:41.37,0:17:44.37,Default,,0,0,0,,Үйіңізге кенеттен біреу кірді ше? Ол сияқты
Dialogue: 0,0:17:44.83,0:17:48.50,Default,,0,0,0,,‎Өмір жолын таңдауға үлкен көмек, тітіркендіреді.
Dialogue: 0,0:17:48.87,0:17:53.70,Default,,0,0,0,,‎Не таңдасаңыз да, сіз бір жерге түсесіз.
Dialogue: 0,0:17:57.58,0:18:03.20,Default,,0,0,0,,‎(Десу Рецуконың айқайы)
Dialogue: 0,0:18:39.87,0:18:41.91,Default,,0,0,0,,Мен қайтып ораламын да, сені қайтарамын.
Dialogue: 0,0:18:43.79,0:18:48.20,Default,,0,0,0,,‎(OTM Қыздардың ән айту дауысы)
Dialogue: 0,0:19:13.04,0:19:15.16,Default,,0,0,0,,‎(Тонның қызы) OTM ең жақсы!
Dialogue: 0,0:19:15.29,0:19:17.79,Default,,0,0,0,,‎(Тонның қызы) Рецу-чан ең жақсы!
Dialogue: 0,0:19:18.12,0:19:22.25,Default,,0,0,0,,‎(Комияның айқайы)
Dialogue: 0,0:19:22.37,0:19:26.33,Default,,0,0,0,,(Комия) Мен бірінші фестивалім зейнеткерлікке шыққан спектаклім болатынына сене алмаймын.
Dialogue: 0,0:19:26.45,0:19:28.62,Default,,0,0,0,,Неліктен Рецуко өзінің кумирінен бас тартты?
Dialogue: 0,0:19:28.83,0:19:31.95,Default,,0,0,0,,Сіз жұмысқа қайта оралуды таңдадыңыз ба?
Dialogue: 0,0:19:32.58,0:19:33.50,Default,,0,0,0,,Саана
Dialogue: 0,0:19:34.33,0:19:39.33,Default,,0,0,0,,Бәлкім, тамағың кеуіп қалғанда жақсы сезінетін шығар.
Dialogue: 0,0:19:41.00,0:19:42.70,Default,,0,0,0,,(Комия) ше? Бұл ештеңе емес
Dialogue: 0,0:19:45.58,0:19:48.04,Default,,0,0,0,,‎(Ретсуко) Олай болса, мен оны Хёуду мырзаға қайтарып беремін.
Dialogue: 0,0:19:48.66,0:19:51.66,Default,,0,0,0,,‎Зейнеткерлік қызметтен түскен ақша қарызды төледі...
Dialogue: 0,0:19:51.79,0:19:52.75,Default,,0,0,0,,Бұл тым көп.
Dialogue: 0,0:19:53.12,0:19:54.70,Default,,0,0,0,,(Миги) Менеджер, сіз шынымен жұмыстан шығасыз ба?
Dialogue: 0,0:19:54.83,0:19:56.25,Default,,0,0,0,,Жалғыз көрінеді
Dialogue: 0,0:19:57.25,0:20:00.75,Default,,0,0,0,,Ақырында, пұттар контейнер емес, солай ма?
Dialogue: 0,0:20:01.29,0:20:04.37,Default,,0,0,0,,‎Бұранда Бұл дүние толығымен бұзылмайынша өмір сүре алмайтын дүние.
Dialogue: 0,0:20:05.12,0:20:06.54,Default,,0,0,0,,‎ (гитара дыбысы)
Dialogue: 0,0:20:07.62,0:20:10.79,Default,,0,0,0,,‎Сенсіз маған біраз уақыт толық емес жұмыс істеуге тура келетін шығар.
Dialogue: 0,0:20:12.00,0:20:13.91,Default,,0,0,0,,Мен қайта тұрамын
Dialogue: 0,0:20:14.70,0:20:16.45,Default,,0,0,0,,Маған қарашы, Рецуко.
Dialogue: 0,0:20:17.04,0:20:20.54,Default,,0,0,0,,Иә, сәттілік Манака
Dialogue: 0,0:20:23.25,0:20:25.16,Default,,0,0,0,,‎(Тадано) Мен оны тікелей эфирде көрдім.
Dialogue: 0,0:20:25.83,0:20:28.70,Default,,0,0,0,,‎Ретсу-чан, сен шынымен гитарада ойнайсың ба?
Dialogue: 0,0:20:28.83,0:20:30.62,Default,,0,0,0,,Сіз бұл коммерциялық құпия деп айттыңыз.
Dialogue: 0,0:20:30.75,0:20:32.95,Default,,0,0,0,,(Тадано мен Горидің күлкілері)
Dialogue: 0,0:20:34.12,0:20:35.50,Default,,0,0,0,,Сәлем Тадано-кун
Dialogue: 0,0:20:36.08,0:20:38.25,Default,,0,0,0,,Мен сізден осыны сұрайын деп едім...
Dialogue: 0,0:20:38.62,0:20:40.75,Default,,0,0,0,,‎Сіз қолданбаға бірдеңе жасадыңыз ба?
Dialogue: 0,0:20:41.29,0:20:44.50,Default,,0,0,0,,‎Әй, сен не туралы айтып тұрсың?
Dialogue: 0,0:20:44.83,0:20:46.70,Default,,0,0,0,,Бұл Рецуко мен Хайда-кун туралы әңгіме.
Dialogue: 0,0:20:46.83,0:20:48.37,Default,,0,0,0,,‎(Тадано) Мен білмеймін.
Dialogue: 0,0:20:50.37,0:20:54.75,Default,,0,0,0,,Қалай болғанда да, мен болашақты болжау іс жүзінде мүмкін емес деп есептеймін.
Dialogue: 0,0:20:55.41,0:20:59.41,Default,,0,0,0,,‎Маңыздысы, сіз таңдаған жолға сенесіз бе, жоқ па.
Dialogue: 0,0:20:59.87,0:21:00.91,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:21:04.75,0:21:08.83,Default,,0,0,0,,(Ретсуко) 10-ға дейін санағанда мен байсалды қыз едім.
Dialogue: 0,0:21:09.25,0:21:13.12,Default,,0,0,0,,‎10-ға дейін санағанда мен қоғамның байсалды мүшесі болдым.
Dialogue: 0,0:21:13.54,0:21:17.04,Default,,0,0,0,,‎10-ға дейін санасаң, мен барлығының кумирімін
Dialogue: 0,0:21:19.83,0:21:21.00,Default,,0,0,0,,10-ға дейін санағаннан кейін...
Dialogue: 0,0:21:24.29,0:21:26.54,Default,,0,0,0,,‎Жұмбақ астыртын пұт өндірушісі
Dialogue: 0,0:21:28.54,0:21:30.00,Default,,0,0,0,,10-ға дейін санағаннан кейін
Dialogue: 0,0:21:30.70,0:21:33.00,Default,,0,0,0,,Біз кез келген нәрсе бола аламыз
Dialogue: 0,0:21:34.33,0:21:37.20,Default,,0,0,0,,‎10-ды санағанда, мен...
Dialogue: 0,0:21:39.50,0:21:42.62,Default,,0,0,0,,‎(аяқ дыбысы)
Dialogue: 0,0:21:43.04,0:21:44.16,Default,,0,0,0,,‎Усу
Dialogue: 0,0:21:46.66,0:21:48.79,Default,,0,0,0,,‎(Хайда) Эй, Рецуко (Рецуко) Иә?
Dialogue: 0,0:21:48.91,0:21:51.45,Default,,0,0,0,,‎(Хайда) Сіз әлі тамақ жедіңіз бе? (Рецуко) Жоқ.
Dialogue: 0,0:21:52.58,0:21:53.66,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:21:54.25,0:21:59.25,Default,,0,0,0,,‎♪～
Dialogue: 0,0:23:20.95,0:23:25.95,Default,,0,0,0,,‎～♪
