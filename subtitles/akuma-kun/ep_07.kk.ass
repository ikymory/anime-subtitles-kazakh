Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.47,0:00:15.26,Default,,0,0,0,,Өкіл Изумура
Dialogue: 0,0:00:15.34,0:00:18.56,Default,,0,0,0,,Сізге Премьер-Министрдің кабинетке кіруге шақырғанын естідім.
Dialogue: 0,0:00:19.06,0:00:21.81,Default,,0,0,0,,Мен мұндайды естіген жоқпын.
Dialogue: 0,0:00:21.89,0:00:22.81,Default,,0,0,0,,Бұрынғыдан
Dialogue: 0,0:00:22.89,0:00:26.15,Default,,0,0,0,,Сіздің мақсатыңыз – балалар кедейлігін жою, солай емес пе?
Dialogue: 0,0:00:26.23,0:00:27.11,Default,,0,0,0,,Егер сіз кабинетке кіре алсаңыз
Dialogue: 0,0:00:27.19,0:00:28.90,Default,,0,0,0,,Бұл оны жүзеге асыруға мүмкіндік емес пе?
Dialogue: 0,0:00:28.98,0:00:30.03,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:00:30.61,0:00:32.53,Default,,0,0,0,,Мүмкіндік болса
Dialogue: 0,0:00:32.61,0:00:36.07,Default,,0,0,0,,Мен сүйек ұсатқыш болып жұмыс істеуге дайынмын.
Dialogue: 0,0:00:36.16,0:00:36.99,Default,,0,0,0,,Дегенмен, бетіңіз көрсетілгеніне қарамастан, осындай бағдарламаға шығу үлкен батылдықты талап етеді деп ойлаймын.
Dialogue: 0,0:00:37.07,0:00:38.49,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:00:38.99,0:00:39.99,Default,,0,0,0,,О
Dialogue: 0,0:00:40.62,0:00:42.20,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:00:42.29,0:00:43.54,Default,,0,0,0,,Иә
Dialogue: 0,0:00:46.37,0:00:48.63,Default,,0,0,0,,Диет мүшесі болғанына 20 жыл
Dialogue: 0,0:00:48.71,0:00:52.05,Default,,0,0,0,,Мен әкеме берген уәдемді орындай аламын.
Dialogue: 0,0:00:52.55,0:00:56.43,Default,,0,0,0,,Мұның бәрі маған көмектескендерің үшін рахмет.
Dialogue: 0,0:00:56.93,0:00:59.47,Default,,0,0,0,,Моттайнай сөздер, мырза.
Dialogue: 0,0:00:59.55,0:01:00.51,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,0:01:01.26,0:01:02.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:05.31,0:01:06.39,Default,,0,0,0,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:01:07.10,0:01:08.77,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:01:21.87,0:01:23.58,Default,,0,0,0,,(есік сигналы)
Dialogue: 0,0:01:24.58,0:01:25.54,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:01:25.62,0:01:26.66,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:01:27.87,0:01:30.59,Default,,0,0,0,,Өтінемін, Демура мырза.
Dialogue: 0,0:01:31.17,0:01:34.30,Default,,0,0,0,,Сізді Министрлер кабинетіне қабылдануыңызбен құттықтаймыз.
Dialogue: 0,0:01:35.01,0:01:37.01,Default,,0,0,0,,♪～
Dialogue: 0,0:01:49.15,0:01:51.15,Default,,0,0,0,,～♪
Dialogue: 0,0:01:51.23,0:01:56.07,Default,,0,0,0,,(Тамақтану кезіндегі дыбыстар)
Dialogue: 0,0:01:56.15,0:01:58.40,Default,,0,0,0,,Олай болса оқиға қандай?
Dialogue: 0,0:01:58.91,0:02:00.16,Default,,0,0,0,,Аа...
Dialogue: 0,0:02:00.24,0:02:02.58,Default,,0,0,0,,Ол әлі шыдамсыз адам.
Dialogue: 0,0:02:03.20,0:02:04.83,Default,,0,0,0,,Ал сіз ше, мұғалім?
Dialogue: 0,0:02:04.91,0:02:07.12,Default,,0,0,0,,Сіз аш болуыңыз керек.
Dialogue: 0,0:02:07.21,0:02:09.08,Default,,0,0,0,,Мен тәттілерді ұнатпаймын.
Dialogue: 0,0:02:09.58,0:02:11.84,Default,,0,0,0,,Өзіңізді ұстаудың қажеті жоқ.
Dialogue: 0,0:02:11.92,0:02:13.84,Default,,0,0,0,,Бұл бөлменің бағасы да
Dialogue: 0,0:02:13.92,0:02:16.30,Default,,0,0,0,,Нөмірге қызмет көрсетудің тамақтану ақысы
Dialogue: 0,0:02:16.38,0:02:19.26,Default,,0,0,0,,Бұл сіздің ақшаңыз.
Dialogue: 0,0:02:19.34,0:02:21.01,Default,,0,0,0,,Ісіңді тез айт.
Dialogue: 0,0:02:21.09,0:02:21.89,Default,,0,0,0,,Мен бос емеспін...
Dialogue: 0,0:02:21.97,0:02:22.85,Default,,0,0,0,,Жақында
Dialogue: 0,0:02:23.51,0:02:25.72,Default,,0,0,0,,Бұны қайтадан заттармен жасамаңыз.
Dialogue: 0,0:02:26.22,0:02:28.73,Default,,0,0,0,,Сіз маған ақшамен көмектесе аласыз ба деп ойладым.
Dialogue: 0,0:02:28.81,0:02:30.27,Default,,0,0,0,,Сен!
Dialogue: 0,0:02:30.35,0:02:33.31,Default,,0,0,0,,Менен тағы ақша алмақшысың ба?
Dialogue: 0,0:02:33.40,0:02:35.15,Default,,0,0,0,,Нашар тыңдаушы
Dialogue: 0,0:02:35.23,0:02:38.86,Default,,0,0,0,,Бұл сіздің жеке хатшыңыз ретінде менің әділ өтемім.
Dialogue: 0,0:02:38.95,0:02:41.07,Default,,0,0,0,,Мен сені міндетті түрде қорғаймын.
Dialogue: 0,0:02:42.20,0:02:45.41,Default,,0,0,0,,Мұндай фотосуреттердің көпшілікке таралуына жол бермеңіз.
Dialogue: 0,0:02:45.49,0:02:46.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:48.12,0:02:50.42,Default,,0,0,0,,Мен өз шегімдемін
Dialogue: 0,0:02:50.50,0:02:54.17,Default,,0,0,0,,Мен өз күшіммен басқара алатын ақша жоқ!
Dialogue: 0,0:02:54.25,0:02:56.05,Default,,0,0,0,,Дәл қазір... дұрыс па?
Dialogue: 0,0:02:56.13,0:02:56.84,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:02:56.92,0:02:58.51,Default,,0,0,0,,Министр болсаң
Dialogue: 0,0:02:58.59,0:03:01.89,Default,,0,0,0,,Үкіметтен қаржы алу оңай емес пе?
Dialogue: 0,0:03:01.97,0:03:03.43,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:03:03.51,0:03:05.85,Default,,0,0,0,,Бұл ақша балаларды қорғауға арналған.
Dialogue: 0,0:03:05.93,0:03:08.52,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:03:08.60,0:03:09.85,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:03:09.93,0:03:11.94,Default,,0,0,0,,Жақсы адам сияқты әрекет ету...
Dialogue: 0,0:03:13.19,0:03:15.82,Default,,0,0,0,,Сақ болыңыз.
Dialogue: 0,0:03:15.90,0:03:19.19,Default,,0,0,0,,Бұл жағынан ол әкесіне ұқсайды.
Dialogue: 0,0:03:19.28,0:03:21.36,Default,,0,0,0,,Әй, мені өсірген әкем еді.
Dialogue: 0,0:03:21.45,0:03:23.62,Default,,0,0,0,,Бұл әдемі әңгіме.
Dialogue: 0,0:03:23.70,0:03:26.24,Default,,0,0,0,,Өмірімді қарапайым мұғалім ретінде өткізген кезде
Dialogue: 0,0:03:26.33,0:03:28.58,Default,,0,0,0,,Балалардың жеке мүлкін беру
Dialogue: 0,0:03:28.66,0:03:32.37,Default,,0,0,0,,Кедей балаларды тамақтандыру және оқыту
Dialogue: 0,0:03:32.46,0:03:36.59,Default,,0,0,0,,Әйтеуір, мен сені тастап кеткенде қабылдап, өсірдім.
Dialogue: 0,0:03:37.21,0:03:39.09,Default,,0,0,0,,Сенің арқаңда мен жоқшылықта өмір сүремін.
Dialogue: 0,0:03:39.17,0:03:41.34,Default,,0,0,0,,Ақырында денемді сындырып, томпайып қаламын.
Dialogue: 0,0:03:41.42,0:03:42.26,Default,,0,0,0,,Хаха
Dialogue: 0,0:03:42.34,0:03:43.59,Default,,0,0,0,,«Екіжүзді» дегеніміз не?
Dialogue: 0,0:03:43.68,0:03:46.89,Default,,0,0,0,,Дәл сіз ата-ана мен балаға арналған сөзсіз.
Dialogue: 0,0:03:46.97,0:03:48.89,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:03:49.39,0:03:51.56,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:03:53.73,0:03:55.06,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:03:55.90,0:03:57.32,Default,,0,0,0,,Менің әкем...
Dialogue: 0,0:03:58.98,0:04:02.61,Default,,0,0,0,,Менің әкеме тіл тигізбе!
Dialogue: 0,0:04:02.70,0:04:03.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:05.32,0:04:05.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:05.99,0:04:10.12,Default,,0,0,0,,(Демураның ырылдауы)
Dialogue: 0,0:04:10.20,0:04:11.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:13.71,0:04:14.71,Default,,0,0,0,,Техникалық колледжде күтіп тұрған сиқыршыларды мүмкіндігінше үнсіз жойып жібергім келеді.
Dialogue: 0,0:04:19.21,0:04:19.96,Default,,0,0,0,,Сол кезде мен өзімді жеңілген адам ретінде өмір сүруді бастадым.
Dialogue: 0,0:04:22.63,0:04:26.47,Default,,0,0,0,,(Изумураның ауыр тыныс алуы)
Dialogue: 0,0:04:33.39,0:04:38.86,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:04:48.07,0:04:48.99,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:04:49.08,0:04:50.24,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:04:52.45,0:04:53.58,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:05:21.23,0:05:22.32,Default,,0,0,0,,Ах
Dialogue: 0,0:05:22.40,0:05:25.32,Default,,0,0,0,,Өкіл Изумураның тағы бір постері.
Dialogue: 0,0:05:25.40,0:05:27.91,Default,,0,0,0,,Әлі де сол алдамшы күлкі
Dialogue: 0,0:05:27.99,0:05:29.07,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:05:29.66,0:05:31.74,Default,,0,0,0,,Бұл адамның не айтып, не істеп жатқаны
Dialogue: 0,0:05:31.83,0:05:33.20,Default,,0,0,0,,Менің ойымша, бұл тамаша.
Dialogue: 0,0:05:33.29,0:05:34.95,Default,,0,0,0,,Сіз оны қолдайсыз ба?
Dialogue: 0,0:05:35.04,0:05:37.29,Default,,0,0,0,,Менің ата-анам...
Dialogue: 0,0:05:37.37,0:05:39.96,Default,,0,0,0,,Адамдар негізінен сенімсіз.
Dialogue: 0,0:05:40.59,0:05:43.34,Default,,0,0,0,,Саясаткерлер – олардың ішіндегі ең жақсысы.
Dialogue: 0,0:05:43.84,0:05:45.13,Default,,0,0,0,,Олармен салыстырғанда
Dialogue: 0,0:05:45.21,0:05:49.01,Default,,0,0,0,,Ібіліс жақсырақ, өйткені ол өз мақсатына шынайырақ.
Dialogue: 0,0:05:49.09,0:05:51.72,Default,,0,0,0,,Адам болсаң да, шайтанға сенесің бе?
Dialogue: 0,0:05:51.80,0:05:55.06,Default,,0,0,0,,Мен сен сияқты шешімсіз емеспін.
Dialogue: 0,0:05:55.14,0:05:55.98,Default,,0,0,0,,Мефисто III
Dialogue: 0,0:05:56.77,0:05:58.48,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:05:59.19,0:06:00.19,Default,,0,0,0,,Эй
Dialogue: 0,0:06:07.74,0:06:08.82,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:08.91,0:06:10.16,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:06:11.32,0:06:14.24,Default,,0,0,0,,Иино-санға келсеңіз жақсы болар еді...
Dialogue: 0,0:06:14.83,0:06:16.08,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:06:16.58,0:06:18.75,Default,,0,0,0,,Маған бәрібір, өтсін.
Dialogue: 0,0:06:20.33,0:06:22.54,Default,,0,0,0,,Менде бір кесе шай жоқ.
Dialogue: 0,0:06:22.63,0:06:23.21,Default,,0,0,0,,Мұнда
Dialogue: 0,0:06:23.29,0:06:24.50,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:06:24.59,0:06:27.47,Default,,0,0,0,,«Мыңжылдық институты»
Dialogue: 0,0:06:27.55,0:06:29.26,Default,,0,0,0,,Бұл детектив сияқты.
Dialogue: 0,0:06:29.84,0:06:31.68,Default,,0,0,0,,Мен Мефисто IIIмын
Dialogue: 0,0:06:31.76,0:06:33.26,Default,,0,0,0,,Бұл шайтан
Dialogue: 0,0:06:33.35,0:06:34.43,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:06:34.51,0:06:36.77,Default,,0,0,0,,Сізге хатшыңыздан бірдеңе керек пе, Иино?
Dialogue: 0,0:06:36.85,0:06:39.02,Default,,0,0,0,,Шынында да...
Dialogue: 0,0:06:39.10,0:06:41.23,Default,,0,0,0,,Иино мырзаның тергеу сұрауына жауап ретінде.
Dialogue: 0,0:06:41.31,0:06:43.27,Default,,0,0,0,,Мен бұл туралы хабарлауға уәде бердім.
Dialogue: 0,0:06:43.94,0:06:45.65,Default,,0,0,0,,Байланыс мүмкін емес
Dialogue: 0,0:06:45.73,0:06:46.78,Default,,0,0,0,,Сұраныс?
Dialogue: 0,0:06:46.86,0:06:50.32,Default,,0,0,0,,Құпиялылық міндеттемелеріне байланысты мен егжей-тегжейлерді талқылай алмаймын.
Dialogue: 0,0:06:50.41,0:06:54.24,Default,,0,0,0,,Мен бұрын болған ұйымды зерттегеніңізді қалаймын.
Dialogue: 0,0:06:54.83,0:06:55.54,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:06:55.62,0:06:58.75,Default,,0,0,0,,Біз де хабарласа алмаймыз.
Dialogue: 0,0:06:58.83,0:06:59.96,Default,,0,0,0,,Мен уайымдап тұрмын...
Dialogue: 0,0:07:00.04,0:07:01.92,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:07:02.00,0:07:02.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:03.50,0:07:06.05,Default,,0,0,0,,Иино-сан өлі табылды.
Dialogue: 0,0:07:09.92,0:07:12.80,Default,,0,0,0,,Уақытыңызды бөліп келгеніңізге рахмет.
Dialogue: 0,0:07:12.89,0:07:14.80,Default,,0,0,0,,Мен де енді көбірек тырысуым керек сияқты!
Dialogue: 0,0:07:14.89,0:07:16.97,Default,,0,0,0,,Менің атым Фукабаяши, қалалық полиция департаментінен...
Dialogue: 0,0:07:17.06,0:07:17.81,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:07:17.89,0:07:19.85,Default,,0,0,0,,Мефисто-кун мен Ібіліс-кун емес пе?
Dialogue: 0,0:07:19.93,0:07:21.02,Default,,0,0,0,,Неге балалар?
Dialogue: 0,0:07:21.10,0:07:21.98,Default,,0,0,0,,№.
Dialogue: 0,0:07:22.06,0:07:26.02,Default,,0,0,0,,Осы жолы өмірден өткен Иино мырза біздің клиентіміз еді...
Dialogue: 0,0:07:26.11,0:07:29.03,Default,,0,0,0,,Солай ма? Бұл сендіреді.
Dialogue: 0,0:07:29.11,0:07:32.28,Default,,0,0,0,,Бұл оқиға тез арада шешіледі деп үміттенемін.
Dialogue: 0,0:07:32.36,0:07:33.03,Default,,0,0,0,,Дахахаха!
Dialogue: 0,0:07:33.11,0:07:34.95,Default,,0,0,0,,Мұндай міндеттеме жоқ.
Dialogue: 0,0:07:35.03,0:07:36.53,Default,,0,0,0,,(Сейко Ясуура) Арима мырзаға не болғанын білсем екен? Көрінгендей, ол кеше де жоқ болды.
Dialogue: 0,0:07:36.62,0:07:38.54,Default,,0,0,0,,Бұрын белгілі бір оқиғада...
Dialogue: 0,0:07:38.62,0:07:41.16,Default,,0,0,0,,Бұл жігіт шайтаннан да қиын.
Dialogue: 0,0:07:41.25,0:07:43.54,Default,,0,0,0,,«Нотарикон»... Бұл солай ма?
Dialogue: 0,0:07:43.62,0:07:46.17,Default,,0,0,0,,Мұндай кодты ешкім бұза алмайды.
Dialogue: 0,0:07:46.25,0:07:47.67,Default,,0,0,0,,Сізге рахмет, кінәлі...
Dialogue: 0,0:07:47.75,0:07:49.30,Default,,0,0,0,,Мефисто фотосы (Фукабаяши) Иә?
Dialogue: 0,0:07:49.38,0:07:50.51,Default,,0,0,0,,О
Dialogue: 0,0:07:50.59,0:07:51.51,Default,,0,0,0,,Фото?
Dialogue: 0,0:07:51.59,0:07:52.80,Default,,0,0,0,,Шындығында, қараңыз,
Dialogue: 0,0:07:52.88,0:07:56.01,Default,,0,0,0,,Фотосуретте көрсетілген татуировка эмблемасына қатысты
Dialogue: 0,0:07:56.10,0:07:57.93,Default,,0,0,0,,Тергеуіңізді қалаймын.
Dialogue: 0,0:07:58.51,0:07:59.68,Default,,0,0,0,,Иино мырзаның өтініші бойынша
Dialogue: 0,0:07:59.77,0:08:00.93,Default,,0,0,0,,О...
Dialogue: 0,0:08:01.43,0:08:04.31,Default,,0,0,0,,Мұның оқиғаға қатысы бар ма?
Dialogue: 0,0:08:04.40,0:08:05.31,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:08:05.40,0:08:09.07,Default,,0,0,0,,Одан гөрі бұл құрбан, Иино мырза.
Dialogue: 0,0:08:09.86,0:08:13.07,Default,,0,0,0,,Өлімнің болжамды уақыты анық емес.
Dialogue: 0,0:08:13.65,0:08:16.32,Default,,0,0,0,,Өйткені, бөлме өте суық болды.
Dialogue: 0,0:08:16.41,0:08:18.08,Default,,0,0,0,,Бақылау камералары туралы не деуге болады?
Dialogue: 0,0:08:18.16,0:08:19.58,Default,,0,0,0,,Дәлізде емес
Dialogue: 0,0:08:19.66,0:08:22.29,Default,,0,0,0,,Біреуі лифт залында, сонымен қатар фойеде.
Dialogue: 0,0:08:22.87,0:08:24.54,Default,,0,0,0,,Бұл қазір расталуда.
Dialogue: 0,0:08:25.04,0:08:26.33,Default,,0,0,0,,Жетекші Фукабаяши
Dialogue: 0,0:08:26.42,0:08:28.59,Default,,0,0,0,,Бақылау камерасын растау аяқталды
Dialogue: 0,0:08:28.67,0:08:29.75,Default,,0,0,0,,О!
Dialogue: 0,0:08:29.84,0:08:31.13,Default,,0,0,0,,Уа, не болды?
Dialogue: 0,0:08:31.21,0:08:32.05,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:08:33.13,0:08:35.64,Default,,0,0,0,,Иә? Бөлме қызметі?
Dialogue: 0,0:08:37.64,0:08:38.76,Default,,0,0,0,,(тінтуірді басу дыбысы)
Dialogue: 0,0:08:38.85,0:08:41.39,Default,,0,0,0,,Бұл 4 күн бұрынғы түсірілім.
Dialogue: 0,0:08:41.89,0:08:44.35,Default,,0,0,0,,Демура мырза оқиға болған жерден.
Dialogue: 0,0:08:44.44,0:08:47.06,Default,,0,0,0,,Сізді лифтте кетіп бара жатқанын көруге болады.
Dialogue: 0,0:08:47.15,0:08:49.07,Default,,0,0,0,,15 минуттан кейін
Dialogue: 0,0:08:49.65,0:08:53.57,Default,,0,0,0,,Қонақ үй қызметкерлері нөмірлерге қызмет көрсететін нөмірлерді түсіру үшін бөлмеге барды.
Dialogue: 0,0:08:54.15,0:08:55.70,Default,,0,0,0,,Сіз сол кезде не істедіңіз?
Dialogue: 0,0:08:55.78,0:08:57.49,Default,,0,0,0,,Бұл Иино-сама болды.
Dialogue: 0,0:08:57.57,0:08:59.41,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:08:59.49,0:09:01.83,Default,,0,0,0,,Иә, сіз көптен келген қонақсыз.
Dialogue: 0,0:09:02.75,0:09:03.62,Default,,0,0,0,,Сол бөлмеде
Dialogue: 0,0:09:03.70,0:09:06.33,Default,,0,0,0,,Мен бірнеше рет бөлмеге қызмет көрсеттім.
Dialogue: 0,0:09:07.08,0:09:09.59,Default,,0,0,0,,Сол күні де 20 минуттан кейін келіп, ыдыс-аяқты қоюын өтіндім.
Dialogue: 0,0:09:09.67,0:09:10.84,Default,,0,0,0,,Маған хабарласты
Dialogue: 0,0:09:10.92,0:09:11.71,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:09:11.80,0:09:15.22,Default,,0,0,0,,Басқаша айтқанда, Изумура-сенсей кеткеннен кейін де...
Dialogue: 0,0:09:15.30,0:09:17.55,Default,,0,0,0,,Иино мырза тірі еді
Dialogue: 0,0:09:17.64,0:09:19.76,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:09:19.85,0:09:21.10,Default,,0,0,0,,А... иә
Dialogue: 0,0:09:21.18,0:09:22.97,Default,,0,0,0,,Жағдайға қарап
Dialogue: 0,0:09:23.06,0:09:25.10,Default,,0,0,0,,Сіз ең күдіктісіз.
Dialogue: 0,0:09:25.18,0:09:28.31,Default,,0,0,0,,Мүмкін, бірақ мен кінәсізмін.
Dialogue: 0,0:09:28.40,0:09:31.23,Default,,0,0,0,,Басшы Шын мәнінде, осыдан кейін...
Dialogue: 0,0:09:33.19,0:09:34.11,Default,,0,0,0,,Келесі күні...
Dialogue: 0,0:09:34.86,0:09:35.99,Default,,0,0,0,,Үш күн бұрын түс болды.
Dialogue: 0,0:09:36.49,0:09:38.24,Default,,0,0,0,,Сіз қайда барасыз?
Dialogue: 0,0:09:38.74,0:09:41.20,Default,,0,0,0,,Қонақ үйдегі «Пойнте» кафесі
Dialogue: 0,0:09:41.70,0:09:42.83,Default,,0,0,0,,Пуэнт?
Dialogue: 0,0:09:42.91,0:09:46.08,Default,,0,0,0,,А, Теннанттың кофеханасы.
Dialogue: 0,0:09:46.71,0:09:49.25,Default,,0,0,0,,Сіз мұнда да крептерге тапсырыс бересіз бе?
Dialogue: 0,0:09:49.33,0:09:51.34,Default,,0,0,0,,Сізге қаншалықты ұнайды?
Dialogue: 0,0:09:51.42,0:09:54.42,Default,,0,0,0,,Иино-кунның тәттіге көзі жоқ.
Dialogue: 0,0:09:55.26,0:09:57.43,Default,,0,0,0,,Бұл соңғы көрініс
Dialogue: 0,0:09:58.18,0:09:59.26,Default,,0,0,0,,Марқұм
Dialogue: 0,0:09:59.34,0:10:01.72,Default,,0,0,0,,Үш күн бұрын крепе жегеннен кейін
Dialogue: 0,0:10:01.80,0:10:03.43,Default,,0,0,0,,Бүгінге дейін...
Dialogue: 0,0:10:03.51,0:10:05.81,Default,,0,0,0,,Сонымен, I
Dialogue: 0,0:10:05.89,0:10:07.98,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:10:08.48,0:10:11.44,Default,,0,0,0,,Кінәлі қамауға алынды. Рақмет сізге.
Dialogue: 0,0:10:11.52,0:10:13.11,Default,,0,0,0,,Әрине!
Dialogue: 0,0:10:18.99,0:10:19.86,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:19.95,0:10:21.91,Default,,0,0,0,,Енді бірінші шаршыға оралдық...
Dialogue: 0,0:10:22.41,0:10:24.95,Default,,0,0,0,,Иино бөлмесінің тікелей көрінісі қандай?
Dialogue: 0,0:10:25.04,0:10:26.50,Default,,0,0,0,,Оны көргіңіз келе ме?
Dialogue: 0,0:10:26.58,0:10:28.41,Default,,0,0,0,,Әзірше бітті, сондықтан...
Dialogue: 0,0:10:28.50,0:10:29.54,Default,,0,0,0,,Маған көрсетші.
Dialogue: 0,0:10:31.63,0:10:32.63,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:34.59,0:10:37.05,Default,,0,0,0,,Бұл үстелде не бар?
Dialogue: 0,0:10:37.13,0:10:38.34,Default,,0,0,0,,Ииноның заттары
Dialogue: 0,0:10:38.42,0:10:40.26,Default,,0,0,0,,Саусақ іздері тексерілді
Dialogue: 0,0:10:40.34,0:10:41.64,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:41.72,0:10:43.05,Default,,0,0,0,,EpiPen
Dialogue: 0,0:10:43.14,0:10:44.01,Default,,0,0,0,,Эпи…
Dialogue: 0,0:10:44.10,0:10:45.31,Default,,0,0,0,,Ах~аа~
Dialogue: 0,0:10:45.39,0:10:47.77,Default,,0,0,0,,Аллергиясы бар адамдарда болатын нәрсе
Dialogue: 0,0:10:47.85,0:10:50.85,Default,,0,0,0,,Шамасы, Ииноның теңіз өнімдері мен қарақұмық өнімдеріне аллергиясы болған.
Dialogue: 0,0:10:54.48,0:10:56.11,Default,,0,0,0,,Аллергия
Dialogue: 0,0:10:56.19,0:10:58.94,Default,,0,0,0,,Эй, қарным ашты, бірдеңе жейміз.
Dialogue: 0,0:10:59.45,0:11:00.70,Default,,0,0,0,,Құймақ
Dialogue: 0,0:11:00.78,0:11:03.07,Default,,0,0,0,,Бүгін де таңғы ас іштің.
Dialogue: 0,0:11:03.16,0:11:04.78,Default,,0,0,0,,Міне, Cafe Pointe
Dialogue: 0,0:11:04.87,0:11:08.12,Default,,0,0,0,,Жапония құймақ ұйымы және дүниежүзілік құймақ жөніндегі нұсқаулық
Dialogue: 0,0:11:08.20,0:11:11.04,Default,,0,0,0,,Екеуінде бір жұлдыз алды.
Dialogue: 0,0:11:11.12,0:11:12.46,Default,,0,0,0,,Не? Ұйым - бұл
Dialogue: 0,0:11:12.54,0:11:15.80,Default,,0,0,0,,Құймаққа тамсанатындар сіз ойлағаннан да көп.
Dialogue: 0,0:11:16.55,0:11:19.09,Default,,0,0,0,,Жанкүйер... ей
Dialogue: 0,0:11:19.17,0:11:21.18,Default,,0,0,0,,Дәлірек айтқанда, неге Iino?
Dialogue: 0,0:11:21.26,0:11:23.39,Default,,0,0,0,,Шайтанға табынатын ұйым туралы бірдеңе?
Dialogue: 0,0:11:23.47,0:11:25.01,Default,,0,0,0,,Менің ойымша, сіз білгіңіз келді.
Dialogue: 0,0:11:25.10,0:11:25.89,Default,,0,0,0,,Сол фото...
Dialogue: 0,0:11:25.97,0:11:28.64,Default,,0,0,0,,Бірден шығар (Мефисто III) Иә?
Dialogue: 0,0:11:29.23,0:11:30.98,Default,,0,0,0,,Мұны қалай айтуға болады?
Dialogue: 0,0:11:31.06,0:11:33.73,Default,,0,0,0,,Мефисто фойеде фотосуретті көрсеткенде
Dialogue: 0,0:11:33.81,0:11:36.15,Default,,0,0,0,,Сол жақ иық сәл қозғалды
Dialogue: 0,0:11:36.23,0:11:39.65,Default,,0,0,0,,Мен бірден жасыруға тырысқан реакциямды басып жібергендей болдым.
Dialogue: 0,0:11:40.24,0:11:43.16,Default,,0,0,0,,Доктор Демура шайтанға табынатын ұйыммен байланысы бар ма?
Dialogue: 0,0:11:43.66,0:11:44.16,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:11:45.07,0:11:48.16,Default,,0,0,0,,Ол Тобаяма сияқты жындарды шақырды деп ойлайсың ба?
Dialogue: 0,0:11:48.24,0:11:49.29,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:49.37,0:11:52.46,Default,,0,0,0,,Олар жын жасамақ болған сияқты.
Dialogue: 0,0:11:52.54,0:11:53.67,Default,,0,0,0,,Өз қолымызбен
Dialogue: 0,0:11:53.75,0:11:54.25,Default,,0,0,0,,Сол сияқты
Dialogue: 0,0:11:54.33,0:11:55.79,Default,,0,0,0,,Франкенштейн
Dialogue: 0,0:11:55.88,0:11:56.38,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:11:56.46,0:11:59.09,Default,,0,0,0,,Франкенштейн құбыжықтың аты емес.
Dialogue: 0,0:11:59.17,0:12:01.42,Default,,0,0,0,,Оны жасаған ғалымның аты.
Dialogue: 0,0:12:01.51,0:12:02.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:02.22,0:12:04.22,Default,,0,0,0,,шайтанды жасау
Dialogue: 0,0:12:04.30,0:12:05.22,Default,,0,0,0,,Сәтті болды ма?
Dialogue: 0,0:12:05.30,0:12:06.43,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:12:06.51,0:12:09.97,Default,,0,0,0,,Сайып келгенде, ұйым ішінде билік үшін күрес туындайды.
Dialogue: 0,0:12:10.06,0:12:13.94,Default,,0,0,0,,Олардың кейбіреулері шектен шыққан әрекеттерден кейін жоғалып кетті.
Dialogue: 0,0:12:14.02,0:12:15.94,Default,,0,0,0,,Сіз тапсырыс беруге дайынсыз ба?
Dialogue: 0,0:12:16.02,0:12:17.36,Default,,0,0,0,,Құймақ
Dialogue: 0,0:12:17.44,0:12:21.78,Default,,0,0,0,,А, онда мен крептерге тапсырыс берермін...
Dialogue: 0,0:12:22.28,0:12:23.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:23.24,0:12:25.16,Default,,0,0,0,,Крептер жоқ.
Dialogue: 0,0:12:25.24,0:12:26.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:26.24,0:12:28.41,Default,,0,0,0,,А, менде әлі тапсырыс бар...
Dialogue: 0,0:12:30.45,0:12:31.16,Default,,0,0,0,,Ууух!
Dialogue: 0,0:12:31.25,0:12:34.37,Default,,0,0,0,,Әй, ой... Әй, рұқсатсыз тапсырыс берме.
Dialogue: 0,0:12:34.46,0:12:35.71,Default,,0,0,0,,Мефисто
Dialogue: 0,0:12:36.21,0:12:39.88,Default,,0,0,0,,Адамның зұлымдығы мен шайтанның жақсылығы бір-бірімен соғысса,
Dialogue: 0,0:12:40.67,0:12:42.42,Default,,0,0,0,,Кім жеңеді деп ойлайсың?
Dialogue: 0,0:12:42.51,0:12:44.63,Default,,0,0,0,,Иә? Кенеттен не болды?
Dialogue: 0,0:12:45.43,0:12:47.85,Default,,0,0,0,,Идемура жауабын біледі.
Dialogue: 0,0:12:50.97,0:12:53.56,Default,,0,0,0,,Иә… Иә…
Dialogue: 0,0:12:54.19,0:12:57.02,Default,,0,0,0,,Ал, мен ертең ресми резиденцияға барамын.
Dialogue: 0,0:12:57.52,0:12:58.52,Default,,0,0,0,,(қосу дыбысы)
Dialogue: 0,0:12:58.61,0:12:59.82,Default,,0,0,0,,Аа...
Dialogue: 0,0:13:01.03,0:13:02.40,Default,,0,0,0,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,0:13:03.24,0:13:05.28,Default,,0,0,0,,Уақыт келді, әке.
Dialogue: 0,0:13:06.49,0:13:09.07,Default,,0,0,0,,Көптен күткен тілегің ақыры орындалады.
Dialogue: 0,0:13:11.70,0:13:14.37,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:13:14.46,0:13:15.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:15.75,0:13:16.46,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:13:16.54,0:13:19.13,Default,,0,0,0,,Дәл осылай...
Dialogue: 0,0:13:19.21,0:13:19.71,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:13:20.42,0:13:22.13,Default,,0,0,0,,Демура мырза~
Dialogue: 0,0:13:22.21,0:13:23.21,Default,,0,0,0,,Ммм...
Dialogue: 0,0:13:23.30,0:13:25.47,Default,,0,0,0,,Танысқаныма қуаныштымын~
Dialogue: 0,0:13:26.09,0:13:27.72,Default,,0,0,0,,Эй, полиция шақыр...
Dialogue: 0,0:13:27.80,0:13:31.85,Default,,0,0,0,,Мен, мен Ииномен кездесіп жүрдім.
Dialogue: 0,0:13:31.93,0:13:33.85,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:13:33.93,0:13:38.15,Default,,0,0,0,,Мен сен туралы көп естідім...
Dialogue: 0,0:13:38.94,0:13:41.44,Default,,0,0,0,,«Әртүрлі» нені білдіреді?
Dialogue: 0,0:13:41.94,0:13:43.03,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:13:43.11,0:13:46.24,Default,,0,0,0,,Сіз шайтанға табынатын ұйыммен байланыссыз ба?
Dialogue: 0,0:13:46.32,0:13:47.86,Default,,0,0,0,,ше? (Гремори) Жарайды.
Dialogue: 0,0:13:47.95,0:13:50.41,Default,,0,0,0,,Уайымдамаңыз, біз оны ажыратпаймыз.
Dialogue: 0,0:13:50.49,0:13:53.99,Default,,0,0,0,,Мен жаңа ғана өтінішпен келдім.
Dialogue: 0,0:13:54.08,0:13:54.91,Default,,0,0,0,,Өтінемін?
Dialogue: 0,0:13:55.54,0:13:56.75,Default,,0,0,0,,Иино өледі
Dialogue: 0,0:13:56.83,0:13:58.83,Default,,0,0,0,,Қызметкерлерде бос орын бар, солай ма?
Dialogue: 0,0:13:59.83,0:14:04.71,Default,,0,0,0,,Мен оның орнына мені жұмысқа аласың ба деп ойладым.
Dialogue: 0,0:14:08.34,0:14:09.43,Default,,0,0,0,,Мың йен бе?
Dialogue: 0,0:14:10.39,0:14:11.35,Default,,0,0,0,,Мың йен бе?
Dialogue: 0,0:14:12.51,0:14:14.27,Default,,0,0,0,,Неге...
Dialogue: 0,0:14:15.47,0:14:17.23,Default,,0,0,0,,Келесі...
Dialogue: 0,0:14:17.73,0:14:21.02,Default,,0,0,0,,Келесі ооооо!
Dialogue: 0,0:14:23.11,0:14:25.78,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:14:26.82,0:14:28.28,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:14:28.36,0:14:30.28,Default,,0,0,0,,Бір рет...
Dialogue: 0,0:14:30.36,0:14:33.45,Default,,0,0,0,,Қолым қанға боялған
Dialogue: 0,0:14:34.12,0:14:37.25,Default,,0,0,0,,Осы уақытқа дейін нені қорғадың?
Dialogue: 0,0:14:37.75,0:14:40.25,Default,,0,0,0,,Мен нені алдым
Dialogue: 0,0:14:40.33,0:14:45.67,Default,,0,0,0,,Мен сендерден құрдымға кетуге шыдай алмаймын!
Dialogue: 0,0:14:45.75,0:14:47.01,Default,,0,0,0,,(Греморидің мазасыз дауысы)
Dialogue: 0,0:14:47.09,0:14:48.80,Default,,0,0,0,,(Демураның ырылдауы)
Dialogue: 0,0:14:48.88,0:14:49.97,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:14:50.63,0:14:51.72,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:14:53.97,0:14:55.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:55.97,0:14:57.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:59.06,0:14:59.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:00.98,0:15:03.31,Default,,0,0,0,,Мен де...
Dialogue: 0,0:15:04.48,0:15:05.48,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:05.57,0:15:07.90,Default,,0,0,0,,Тағы да алдау
Dialogue: 0,0:15:08.40,0:15:09.95,Default,,0,0,0,,Мен мұны бір рет жасай алдым.
Dialogue: 0,0:15:10.99,0:15:13.41,Default,,0,0,0,,Бұл жолы да солай болады.
Dialogue: 0,0:15:19.50,0:15:20.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:20.29,0:15:21.71,Default,,0,0,0,,Мысықты көшіру?
Dialogue: 0,0:15:21.79,0:15:25.21,Default,,0,0,0,,Ұйым жасаған жартылай күйдірілген жасанды жын
Dialogue: 0,0:15:26.00,0:15:27.71,Default,,0,0,0,,Бұл сенсің, солай ма? Демура
Dialogue: 0,0:15:28.34,0:15:30.55,Default,,0,0,0,,Бұл сіздің сыртқы түріңізге еліктеу ғана емес.
Dialogue: 0,0:15:30.63,0:15:31.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:31.34,0:15:34.72,Default,,0,0,0,,Күш те керемет.
Dialogue: 0,0:15:34.80,0:15:37.51,Default,,0,0,0,,Мен қарсы тұра алмадым.
Dialogue: 0,0:15:37.60,0:15:38.22,Default,,0,0,0,,Аа, менің мойным ауырып тұр...
Dialogue: 0,0:15:38.72,0:15:40.48,Default,,0,0,0,,Менің атым Дарио Брандо.
Dialogue: 0,0:15:40.56,0:15:42.35,Default,,0,0,0,,Менің атым Гремори
Dialogue: 0,0:15:42.44,0:15:45.48,Default,,0,0,0,,Сіз сияқты сәтсіздікке ұшыраған адамға ұқсамайды.
Dialogue: 0,0:15:45.56,0:15:46.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:46.57,0:15:48.48,Default,,0,0,0,,Нағыз шайтан
Dialogue: 0,0:15:48.57,0:15:50.69,Default,,0,0,0,,Демура мырза...
Dialogue: 0,0:15:50.78,0:15:52.74,Default,,0,0,0,,Сіз төрт түн бұрын болдыңыз
Dialogue: 0,0:15:52.82,0:15:56.78,Default,,0,0,0,,Енді Гремориді өлтірмек болғандай Ииноны өлтіргеннен кейін.
Dialogue: 0,0:15:56.87,0:15:58.24,Default,,0,0,0,,Ноутбуктен, компьютерден, т.б.
Dialogue: 0,0:15:58.33,0:16:01.58,Default,,0,0,0,,Құпияларыңызға қатысты дәлелдемелерді жоюға тырысу
Dialogue: 0,0:16:02.16,0:16:05.96,Default,,0,0,0,,Бөлмеге қызмет көрсету уақытын көрсетіңіз және оларға ыдыстарды жинауды айтыңыз.
Dialogue: 0,0:16:06.04,0:16:08.88,Default,,0,0,0,,Бөлмедегі кондиционердің температурасын шекті деңгейге дейін төмендетіңіз.
Dialogue: 0,0:16:08.96,0:16:10.34,Default,,0,0,0,,Бірде мен сыртқа шықтым
Dialogue: 0,0:16:10.97,0:16:14.30,Default,,0,0,0,,Кейінірек, мүлдем қатысы жоқ үшінші тараптың көмегімен,
Dialogue: 0,0:16:14.39,0:16:15.89,Default,,0,0,0,,Бірден қонақүйге оралу
Dialogue: 0,0:16:15.97,0:16:18.85,Default,,0,0,0,,Көрсетілген уақытта қайтадан Iino-ға түрлендіру
Dialogue: 0,0:16:18.93,0:16:20.81,Default,,0,0,0,,Қызметкерлерге жауап берді
Dialogue: 0,0:16:20.89,0:16:22.64,Default,,0,0,0,,Әзірше жақсы
Dialogue: 0,0:16:22.73,0:16:26.11,Default,,0,0,0,,Бірақ сіз қажетсіз нәрсе жасадыңыз.
Dialogue: 0,0:16:26.19,0:16:27.69,Default,,0,0,0,,Бұл қажет емес пе?
Dialogue: 0,0:16:28.27,0:16:29.69,Default,,0,0,0,,Ииноның тірі болғаны
Dialogue: 0,0:16:29.78,0:16:31.69,Default,,0,0,0,,Көбірек әсер қалдыру
Dialogue: 0,0:16:31.78,0:16:34.36,Default,,0,0,0,,Келесі күні мен бөлмеден шығуға тырыстым.
Dialogue: 0,0:16:34.45,0:16:36.70,Default,,0,0,0,,Көптеген адамдарға әсер етеді
Dialogue: 0,0:16:37.41,0:16:39.70,Default,,0,0,0,,Сосын мен Пуэнт кафесіне бардым.
Dialogue: 0,0:16:39.79,0:16:43.91,Default,,0,0,0,,Сіз жігіт сияқты әрекет етуге тырысып, крепеге тапсырыс бердіңіз.
Dialogue: 0,0:16:44.42,0:16:47.08,Default,,0,0,0,,Бірақ бұл дүкенде крептер жоқ.
Dialogue: 0,0:16:47.17,0:16:49.84,Default,,0,0,0,,Қызметкерлер сізге қиындыққа тап болғаныңызды айтуы керек еді.
Dialogue: 0,0:16:49.92,0:16:51.76,Default,,0,0,0,,Крептер жоқ.
Dialogue: 0,0:16:51.84,0:16:53.84,Default,,0,0,0,,Оның орнына галетка туралы не айтуға болады?
Dialogue: 0,0:16:53.92,0:16:57.09,Default,,0,0,0,,Галеттердің крептерге өте ұқсас екені рас.
Dialogue: 0,0:16:57.18,0:16:59.85,Default,,0,0,0,,Бірақ галетта ұн емес.
Dialogue: 0,0:16:59.93,0:17:01.39,Default,,0,0,0,,Қарақұмық ұнынан жасалған
Dialogue: 0,0:17:01.89,0:17:03.73,Default,,0,0,0,,Иинода қарақұмық аллергиясы бар.
Dialogue: 0,0:17:03.81,0:17:05.31,Default,,0,0,0,,Неліктен галетка тапсырыс беру керек?
Dialogue: 0,0:17:05.39,0:17:07.27,Default,,0,0,0,,Көбірек жеуге ешқандай себеп жоқ
Dialogue: 0,0:17:07.77,0:17:11.07,Default,,0,0,0,,Бірақ тәттіге қызықпайтын сен мұны байқамадың.
Dialogue: 0,0:17:12.15,0:17:14.07,Default,,0,0,0,,Тірі Иино шығаруға тырысу
Dialogue: 0,0:17:14.15,0:17:16.32,Default,,0,0,0,,Менің қателігім шектен шығып кетті.
Dialogue: 0,0:17:18.07,0:17:19.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:25.79,0:17:28.17,Default,,0,0,0,,Менің әкем...
Dialogue: 0,0:17:29.84,0:17:31.17,Default,,0,0,0,,Ұйым тастап кеткен
Dialogue: 0,0:17:31.25,0:17:35.47,Default,,0,0,0,,Мені көтеріп алған шіркін, сәтсіз жын болды.
Dialogue: 0,0:17:35.55,0:17:37.38,Default,,0,0,0,,Ұлы алып кетті
Dialogue: 0,0:17:37.47,0:17:41.26,Default,,0,0,0,,Маған өмір сүруге және білім алуға жол берді
Dialogue: 0,0:17:42.22,0:17:44.73,Default,,0,0,0,,Ақырында мен нәрселерден хабардар болдым.
Dialogue: 0,0:17:44.81,0:17:48.69,Default,,0,0,0,,«Мен шайтандарды ұнатпаймын, мен адам болғым келеді» деп жылағанда.
Dialogue: 0,0:17:48.77,0:17:49.86,Default,,0,0,0,,Әкем айтты
Dialogue: 0,0:17:50.52,0:17:54.36,Default,,0,0,0,,«Тіпті кейбір адамдарда шайтанның жүрегі бар».
Dialogue: 0,0:17:54.44,0:17:57.99,Default,,0,0,0,,«Олай болса, жүрегі дұрыс болса».
Dialogue: 0,0:17:58.07,0:18:00.37,Default,,0,0,0,,«Тіпті шайтан да адам бола алады»
Dialogue: 0,0:18:00.95,0:18:04.16,Default,,0,0,0,,«Сондықтан сіз дұрыс өмір сүруіңіз керек».
Dialogue: 0,0:18:05.62,0:18:08.21,Default,,0,0,0,,Сөздерді басшылыққа алады
Dialogue: 0,0:18:08.29,0:18:12.25,Default,,0,0,0,,Бүгінге дейін мен әрқашан... мәңгілік... болдым.
Dialogue: 0,0:18:13.17,0:18:14.84,Default,,0,0,0,,Адамдардан да көп...
Dialogue: 0,0:18:15.34,0:18:17.51,Default,,0,0,0,,Адам болу...
Dialogue: 0,0:18:20.01,0:18:20.55,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:20.64,0:18:22.55,Default,,0,0,0,,Сен шайтансың ғой.
Dialogue: 0,0:18:22.64,0:18:24.39,Default,,0,0,0,,Жоқ! мен...
Dialogue: 0,0:18:24.47,0:18:25.89,Default,,0,0,0,,Таңдау
Dialogue: 0,0:18:26.52,0:18:28.89,Default,,0,0,0,,Жынның орнына адаммын десең
Dialogue: 0,0:18:28.98,0:18:31.61,Default,,0,0,0,,Адам құқығы бойынша бағалануы керек
Dialogue: 0,0:18:31.69,0:18:32.40,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:32.48,0:18:35.07,Default,,0,0,0,,Әйтеуір шайтан десең
Dialogue: 0,0:18:35.15,0:18:37.49,Default,,0,0,0,,Бізді осы жерде және қазір өлтіріңіз.
Dialogue: 0,0:18:38.07,0:18:39.74,Default,,0,0,0,,Мүмкін болса... бірақ
Dialogue: 0,0:18:42.83,0:18:45.08,Default,,0,0,0,,Сіз адамсыз ба?
Dialogue: 0,0:18:45.58,0:18:47.04,Default,,0,0,0,,Бұл шайтан ма?
Dialogue: 0,0:18:56.59,0:18:59.26,Default,,0,0,0,,Әкемнің маған берген махаббаты
Dialogue: 0,0:18:59.97,0:19:02.26,Default,,0,0,0,,Мен саған опасыздық жасадым
Dialogue: 0,0:19:02.85,0:19:05.06,Default,,0,0,0,,Мен енді саған опасыздық жасай алмаймын
Dialogue: 0,0:19:07.27,0:19:08.77,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:09.77,0:19:11.31,Default,,0,0,0,,Адам
Dialogue: 0,0:19:12.60,0:19:13.81,Default,,0,0,0,,Сіз...
Dialogue: 0,0:19:15.48,0:19:18.07,Default,,0,0,0,,Оны әкесі жақсы көрсе керек.
Dialogue: 0,0:19:21.91,0:19:22.91,Default,,0,0,0,,Ібіліс-кун...
Dialogue: 0,0:19:22.99,0:19:24.28,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:19:24.37,0:19:25.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:26.12,0:19:29.50,Default,,0,0,0,,Мазасыз жағдай болды.
Dialogue: 0,0:19:30.00,0:19:31.04,Default,,0,0,0,,А...
Dialogue: 0,0:19:31.12,0:19:32.88,Default,,0,0,0,,Әй... Ібіліс!
Dialogue: 0,0:19:32.96,0:19:35.46,Default,,0,0,0,,Осы жолы маған мөр қойыңыз! Эй!
Dialogue: 0,0:19:36.04,0:19:37.96,Default,,0,0,0,,Шайтанның тегін жұмыс істеуіне мүмкіндік беру
Dialogue: 0,0:19:38.05,0:19:39.97,Default,,0,0,0,,Мені кешіріңіз...
Dialogue: 0,0:19:40.05,0:19:42.47,Default,,0,0,0,,Сонымен... Уау!
Dialogue: 0,0:19:47.26,0:19:50.68,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:19:50.77,0:19:52.44,Default,,0,0,0,,Демура мырза...
Dialogue: 0,0:19:52.94,0:19:54.23,Default,,0,0,0,,бірақ қанға бөккен қол дәл алдына ұсынылғанда да,
Dialogue: 0,0:19:54.31,0:19:55.44,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:19:55.52,0:19:57.02,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:19:57.11,0:19:59.94,Default,,0,0,0,,Біз сізге сенеміз, ұстаз.
Dialogue: 0,0:20:00.03,0:20:02.40,Default,,0,0,0,,Сондықтан уайымдамаңыз.
Dialogue: 0,0:20:02.91,0:20:04.70,Default,,0,0,0,,Мұғалім мен мұғалімнің әкесінің өсиеті қандай?
Dialogue: 0,0:20:04.78,0:20:08.95,Default,,0,0,0,,Біз мұны мұра етіп аламыз және оны жүзеге асырамыз!
Dialogue: 0,0:20:09.87,0:20:11.21,Default,,0,0,0,,Бірақ бұл менің ойлай алған жалғыз нәрсем еді
Dialogue: 0,0:20:12.29,0:20:13.96,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:14.46,0:20:17.25,Default,,0,0,0,,Қалғаны өз еркіңізде.
Dialogue: 0,0:20:17.34,0:20:18.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:22.88,0:20:26.09,Default,,0,0,0,,Менің ойымша, сіз мені бетперделеудің шебері деп айта аласыз.
Dialogue: 0,0:20:26.18,0:20:28.31,Default,,0,0,0,,Бұл сиқырлы.
Dialogue: 0,0:20:28.39,0:20:30.72,Default,,0,0,0,,Дахахаха!
Dialogue: 0,0:20:31.43,0:20:33.73,Default,,0,0,0,,Жұмбақ шешу Еңбектеріңіз үшін рахмет!
Dialogue: 0,0:20:41.32,0:20:44.03,Default,,0,0,0,,Шайтанның жақсылығы жеңді.
Dialogue: 0,0:20:44.11,0:20:45.57,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:20:45.66,0:20:47.74,Default,,0,0,0,,Сіз мұны өзіңіз сұраған шығарсыз.
Dialogue: 0,0:20:47.82,0:20:50.29,Default,,0,0,0,,Көңіліңізді түсіреді деп алдамаңыз.
Dialogue: 0,0:20:51.58,0:20:54.58,Default,,0,0,0,,Жаман адамдар да, жақсы шайтандар да бар.
Dialogue: 0,0:20:55.08,0:20:56.92,Default,,0,0,0,,Осыны меңзеп тұрсыз, солай ма?
Dialogue: 0,0:20:57.00,0:20:58.50,Default,,0,0,0,,Шапшаңдап қорытындылауға болмайды
Dialogue: 0,0:20:58.59,0:21:00.38,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:21:00.46,0:21:02.38,Default,,0,0,0,,Тіпті алдыңғы он екі елші
Dialogue: 0,0:21:02.46,0:21:04.42,Default,,0,0,0,,Мыңжылдық Патшалықты мақсат еткен әрбір адам
Dialogue: 0,0:21:04.51,0:21:06.51,Default,,0,0,0,,Әкеммен бірге соғысқан.
Dialogue: 0,0:21:06.59,0:21:08.97,Default,,0,0,0,,Бұл жақсы ниет емес.
Dialogue: 0,0:21:09.05,0:21:12.27,Default,,0,0,0,,Өйткені мыңжылдық өз мүдделеріне қызмет етеді.
Dialogue: 0,0:21:12.85,0:21:16.23,Default,,0,0,0,,Пайда? Жоқ, өйткені сенім болды.
Dialogue: 0,0:21:16.31,0:21:18.06,Default,,0,0,0,,Бұл жақсылық пен достық.
Dialogue: 0,0:21:18.65,0:21:19.82,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:21:20.40,0:21:21.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:21.11,0:21:22.40,Default,,0,0,0,,Жетеді
Dialogue: 0,0:21:23.40,0:21:28.07,Default,,0,0,0,,Сіздің жарты шайтан болу туралы әңгімеңізді тыңдау уақытты босқа кетіру болды.
Dialogue: 0,0:21:29.62,0:21:30.66,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:32.41,0:21:33.91,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:21:34.00,0:21:35.91,Default,,0,0,0,,Менен артық, жарымжан шайтан
Dialogue: 0,0:21:36.00,0:21:38.67,Default,,0,0,0,,Ібіліс өсіріп, кейін тастап кеткен
Dialogue: 0,0:21:38.75,0:21:42.34,Default,,0,0,0,,Сіз шайтанды шынымен түсіне алатын сияқтысыз!
Dialogue: 0,0:21:49.01,0:21:51.01,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:22:06.65,0:22:09.24,Default,,0,0,0,,Көздерің әлі ашылмаған ба?
Dialogue: 0,0:22:11.70,0:22:13.41,Default,,0,0,0,,Жалықтырғыш
Dialogue: 0,0:22:16.00,0:22:18.00,Default,,0,0,0,,♪～
Dialogue: 0,0:22:32.18,0:22:33.43,Default,,0,0,0,,Барлығы
Dialogue: 0,0:22:33.51,0:22:38.44,Default,,0,0,0,,Шайтанның жалпы сайлауында мен жарғанат мысыққа таза дауыс беремін.
Dialogue: 0,0:22:38.52,0:22:40.56,Default,,0,0,0,,Демонның жалпы сайлауы немесе дүйсенбі ме?
Dialogue: 0,0:22:40.65,0:22:44.65,Default,,0,0,0,,Жарқанат мысық үміткер...
Dialogue: 0,0:22:44.73,0:22:46.99,Default,,0,0,0,,Иә, шайтанның жалпы сайлауы
Dialogue: 0,0:22:47.07,0:22:51.20,Default,,0,0,0,,«Көрінбейтін мектептің» төрағасы да солай істеді. Оған дауыс беріңіздерші.
Dialogue: 0,0:22:51.28,0:22:53.70,Default,,0,0,0,,Төраға? Солай ма, Мон?
Dialogue: 0,0:22:53.78,0:22:57.75,Default,,0,0,0,,Мен сенімдімін...Тазалық комитетінің төрағасы
Dialogue: 0,0:22:57.83,0:23:00.08,Default,,0,0,0,,Барлығы ынтымақтасады және жоғарғы түйінді киеді
Dialogue: 0,0:23:00.17,0:23:01.88,Default,,0,0,0,,Осы сайлауда бірінші шықсаңыз
Dialogue: 0,0:23:01.96,0:23:04.59,Default,,0,0,0,,Жындар әлеміндегі орталық орынға кепілдік беріледі.
Dialogue: 0,0:23:04.67,0:23:05.59,Default,,0,0,0,,Орталық?
Dialogue: 0,0:23:05.67,0:23:07.84,Default,,0,0,0,,Иә, арманымның орталығы
Dialogue: 0,0:23:07.92,0:23:09.38,Default,,0,0,0,,Барлығы мені таңдайды.
Dialogue: 0,0:23:09.47,0:23:12.80,Default,,0,0,0,,Концертте ән айтсам да, мен ерекшеленемін.
Dialogue: 0,0:23:12.89,0:23:15.10,Default,,0,0,0,,А... сен ән айтасың ба?
Dialogue: 0,0:23:15.18,0:23:16.97,Default,,0,0,0,,Мочимочи жоқ Ронронё
Dialogue: 0,0:23:17.06,0:23:19.23,Default,,0,0,0,,Әрқашан ән айт, ән шырқа, ән айт
Dialogue: 0,0:23:19.31,0:23:21.81,Default,,0,0,0,,Сіз не айтып жатырсыз?
Dialogue: 0,0:23:21.90,0:23:24.69,Default,,0,0,0,,«Супер шайтан жарғанат мысықпен күрес»
Dialogue: 0,0:23:24.77,0:23:26.57,Default,,0,0,0,,Бұл қандай ән?
Dialogue: 0,0:23:26.65,0:23:29.44,Default,,0,0,0,,♪    ～
Dialogue: 0,0:23:29.53,0:23:31.78,Default,,0,0,0,,♪    ～
Dialogue: 0,0:23:31.86,0:23:35.03,Default,,0,0,0,,♪  ～  ～  ～
Dialogue: 0,0:23:35.12,0:23:38.37,Default,,0,0,0,,♪ Жоғалтпа, жарғанат мысық~
Dialogue: 0,0:23:38.45,0:23:41.29,Default,,0,0,0,,Осындай ән... Атакамон?
Dialogue: 0,0:23:41.37,0:23:42.29,Default,,0,0,0,,және үшінші (Three) фильмде алғашқы болып өлген адамның немересі, және т.б.—
Dialogue: 0,0:23:42.37,0:23:44.13,Default,,0,0,0,,Бұлай етпе, әнім
Dialogue: 0,0:23:44.63,0:23:47.67,Default,,0,0,0,,...
Dialogue: 0,0:23:47.75,0:23:48.96,Default,,0,0,0,,Сәлем? Юко
Dialogue: 0,0:23:49.05,0:23:50.01,Default,,0,0,0,,Ах~
Dialogue: 0,0:23:50.09,0:23:54.80,Default,,0,0,0,,Мен... Мамегючанның және басқалардың әндері...
Dialogue: 0,0:23:54.89,0:23:57.97,Default,,0,0,0,,♪ Жоғалтпа, жарғанат мысық~
Dialogue: 0,0:24:13.91,0:24:15.91,Default,,0,0,0,,～♪
Dialogue: 0,0:24:17.41,0:24:23.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory