Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:19.56,0:00:20.89,Default,,0,0,0,,Тоқтат. Жетті. Іздерме оны.
Dialogue: 0,0:00:20.97,0:00:22.68,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:00:22.77,0:00:24.19,Default,,0,0,0,,Бұл қалай, дүйсенбі?
Dialogue: 0,0:00:24.27,0:00:27.19,Default,,0,0,0,,Маған бұл қандай сезім екені таң қалдырады.
Dialogue: 0,0:00:27.27,0:00:28.86,Default,,0,0,0,,Менің де көргім келеді!
Dialogue: 0,0:00:28.94,0:00:29.69,Default,,0,0,0,,Жолдан кет! Эй!
Dialogue: 0,0:00:29.77,0:00:30.69,Default,,0,0,0,,баспаңыз
Dialogue: 0,0:00:30.78,0:00:32.15,Default,,0,0,0,,Сіз ақымақсыз!
Dialogue: 0,0:00:32.24,0:00:34.15,Default,,0,0,0,,Барлық жарғанаттар мен мысықтар, айлакер құбыжықтар!
Dialogue: 0,0:00:34.24,0:00:36.07,Default,,0,0,0,,Мен жасырын емес едім.
Dialogue: 0,0:00:36.16,0:00:38.20,Default,,0,0,0,,Бұл бір рет болса да болды ма?
Dialogue: 0,0:00:39.33,0:00:40.95,Default,,0,0,0,,Менен сұрасаң, түк те жоқ
Dialogue: 0,0:00:41.04,0:00:42.70,Default,,0,0,0,,Жоқ, бір-екі рет болды.
Dialogue: 0,0:00:43.83,0:00:46.33,Default,,0,0,0,,Ештеңе басталмайды...
Dialogue: 0,0:00:46.83,0:00:47.96,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:00:52.80,0:00:54.09,Default,,0,0,0,,Аа...
Dialogue: 0,0:00:57.43,0:00:58.55,Default,,0,0,0,,Соңғы кездері қалай болдыңыз?
Dialogue: 0,0:00:59.05,0:01:00.60,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:01:01.10,0:01:04.31,Default,,0,0,0,,Сонымен, мысалы... денсаулық.
Dialogue: 0,0:01:04.81,0:01:06.06,Default,,0,0,0,,Қалыпты
Dialogue: 0,0:01:06.14,0:01:09.15,Default,,0,0,0,,Мефисто III-мен жақсы араласасыз ба?
Dialogue: 0,0:01:09.23,0:01:10.07,Default,,0,0,0,,Қалыпты
Dialogue: 0,0:01:10.69,0:01:12.07,Default,,0,0,0,,Кейде... (Шайтан-кун) Қалыпты
Dialogue: 0,0:01:13.74,0:01:15.07,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:01:15.15,0:01:17.07,Default,,0,0,0,,Қарсылас – Sparking Killing Boy!
Dialogue: 0,0:01:17.57,0:01:19.32,Default,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:01:19.99,0:01:24.00,Default,,0,0,0,,Сізді алып кету үшін мысық пен жүз көзді әкелмедіңіз бе?
Dialogue: 0,0:01:24.83,0:01:27.17,Default,,0,0,0,,Оны пайдасыз деп айтуға бола ма?
Dialogue: 0,0:01:27.67,0:01:30.63,Default,,0,0,0,,Ата-ана, балалар, кейде су ішпейді...
Dialogue: 0,0:01:30.71,0:01:31.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:31.63,0:01:34.80,Default,,0,0,0,,«Мыңжылдық жоспары қалай орындалуда?»
Dialogue: 0,0:01:34.88,0:01:37.30,Default,,0,0,0,,Солай ма? Менің естігім келетіні
Dialogue: 0,0:01:41.18,0:01:42.81,Default,,0,0,0,,Ібіліс-кунның миссиясы
Dialogue: 0,0:01:42.89,0:01:48.14,Default,,0,0,0,,«Адам әлемінде бақытты жұмақ, мыңжылдық құру»
Dialogue: 0,0:01:49.94,0:01:52.73,Default,,0,0,0,,«Бақытты жұмақ» эй...
Dialogue: 0,0:01:52.82,0:01:53.90,Default,,0,0,0,,(Кітапты жабу дыбысы)
Dialogue: 0,0:01:54.40,0:01:57.82,Default,,0,0,0,,Барлық адамдарға бақыт...
Dialogue: 0,0:01:57.90,0:01:58.82,Default,,0,0,0,,Не?
Dialogue: 0,0:01:58.91,0:02:02.28,Default,,0,0,0,,Азық-түлік, киім-кешек, баспана жеткілікті болса, бақыттысың ба?
Dialogue: 0,0:02:02.37,0:02:04.08,Default,,0,0,0,,Өзін-өзі танытуға қол жеткізу?
Dialogue: 0,0:02:04.16,0:02:05.62,Default,,0,0,0,,Басқалардың мақұлдауын ма?
Dialogue: 0,0:02:06.12,0:02:07.08,Default,,0,0,0,,Мысалы, психолог...
Dialogue: 0,0:02:07.16,0:02:08.33,Default,,0,0,0,,Ято-сама!
Dialogue: 0,0:02:09.75,0:02:11.46,Default,,0,0,0,,Сәлем Ичиро
Dialogue: 0,0:02:13.67,0:02:16.84,Default,,0,0,0,,Сіздің «бақытыңыз» қандай?
Dialogue: 0,0:02:19.84,0:02:20.80,Default,,0,0,0,,Демек, сен болған болашаққа қайта орала алмаймын дегің келе ме?
Dialogue: 0,0:02:21.30,0:02:23.30,Default,,0,0,0,,♪～
Dialogue: 0,0:02:35.53,0:02:37.53,Default,,0,0,0,,～♪
Dialogue: 0,0:02:37.61,0:02:42.66,Default,,0,0,0,,Менің бұйрығым бойынша келесің.
Dialogue: 0,0:02:43.16,0:02:45.70,Default,,0,0,0,,Агрон Тетаграм Войкеон
Dialogue: 0,0:02:45.79,0:02:48.66,Default,,0,0,0,,Стимматон Элохарес
Dialogue: 0,0:02:48.75,0:02:51.67,Default,,0,0,0,,Ретрагус қой еті Криолан
Dialogue: 0,0:02:51.75,0:02:54.25,Default,,0,0,0,,Ичион Эститион Экзистион
Dialogue: 0,0:02:54.34,0:02:59.38,Default,,0,0,0,,Элиона Неора Эласин Моин Мефисуа Сотель
Dialogue: 0,0:02:59.88,0:03:02.64,Default,,0,0,0,,Эммануэль Сабаот Адмаи
Dialogue: 0,0:03:02.72,0:03:05.51,Default,,0,0,0,,Агрон Тетаграм Войкеон
Dialogue: 0,0:03:05.60,0:03:08.35,Default,,0,0,0,,Стимматон Элохарес
Dialogue: 0,0:03:08.85,0:03:11.69,Default,,0,0,0,,Ретрагус қой еті креолансы
Dialogue: 0,0:03:11.77,0:03:15.65,Default,,0,0,0,,Ичион Эститион Экститион
Dialogue: 0,0:03:15.73,0:03:18.23,Default,,0,0,0,,Элиона Неора Эласин
Dialogue: 0,0:03:18.32,0:03:21.57,Default,,0,0,0,,Мойн меффисуа сотел
Dialogue: 0,0:03:21.65,0:03:25.49,Default,,0,0,0,,Эммануэль Сабаот Адмаи
Dialogue: 0,0:03:26.08,0:03:30.91,Default,,0,0,0,,(Заклинание айтқан дауыс)
Dialogue: 0,0:03:31.00,0:03:32.21,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:03:41.26,0:03:43.72,Default,,0,0,0,,Адам отқа ие болады
Dialogue: 0,0:03:43.80,0:03:47.18,Default,,0,0,0,,Енді көбірек тамақ жеуге болады
Dialogue: 0,0:03:47.26,0:03:50.18,Default,,0,0,0,,Бай диета миды үлкейтеді
Dialogue: 0,0:03:50.27,0:03:52.14,Default,,0,0,0,,Ал ұлғайған ми
Dialogue: 0,0:03:52.23,0:03:56.65,Default,,0,0,0,,Біз адамдарды барлық тіршілік иелерінің шыңына шығардық.
Dialogue: 0,0:03:56.73,0:03:59.15,Default,,0,0,0,,Демек, бұл мағынаны білдіреді.
Dialogue: 0,0:03:59.23,0:04:01.03,Default,,0,0,0,,Адамдар мен тамақ арасындағы
Dialogue: 0,0:04:01.11,0:04:03.28,Default,,0,0,0,,Бөлінбейтін байланыс бар...
Dialogue: 0,0:04:03.36,0:04:07.37,Default,,0,0,0,,Жоқ... бұл тағдыр деп айтуға болады.
Dialogue: 0,0:04:07.87,0:04:10.54,Default,,0,0,0,,Мұндай байланыс бар.
Dialogue: 0,0:04:11.37,0:04:13.04,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:04:13.12,0:04:15.75,Default,,0,0,0,,Ұлы Ібіліс Шайтан
Dialogue: 0,0:04:16.58,0:04:20.26,Default,,0,0,0,,Мен сол етті жегім келеді.
Dialogue: 0,0:04:20.34,0:04:22.05,Default,,0,0,0,,(ет грильдегі дыбыс)
Dialogue: 0,0:04:25.93,0:04:29.14,Default,,0,0,0,,Миочан, тамақ дайын.
Dialogue: 0,0:04:29.64,0:04:30.81,Default,,0,0,0,,Иә
Dialogue: 0,0:04:32.10,0:04:34.39,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:04:34.48,0:04:38.15,Default,,0,0,0,,(Мионың жігерлендіретін дауысы)
Dialogue: 0,0:04:40.57,0:04:45.03,Default,,0,0,0,,Девил-кун мен Мефисто-сан, сіз кешкі асты жедіңіз бе?
Dialogue: 0,0:04:45.53,0:04:48.66,Default,,0,0,0,,Бүгінгі клиент бай.
Dialogue: 0,0:04:48.74,0:04:51.74,Default,,0,0,0,,Мен қазір тонтекінің орнына бифштекс жейтініне сенімдімін...
Dialogue: 0,0:04:51.83,0:04:52.91,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:04:53.00,0:04:54.37,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:04:54.46,0:04:55.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:58.50,0:05:01.67,Default,,0,0,0,,Өйткені, арзан ет жақсы емес.
Dialogue: 0,0:05:01.75,0:05:03.59,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:05:03.67,0:05:05.59,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:05:06.76,0:05:08.09,Default,,0,0,0,,Тобаяма мырза
Dialogue: 0,0:05:08.18,0:05:11.60,Default,,0,0,0,,Бұл шайтанның еті емес пе?
Dialogue: 0,0:05:11.68,0:05:13.14,Default,,0,0,0,,Хехе...
Dialogue: 0,0:05:13.22,0:05:14.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:14.73,0:05:17.35,Default,,0,0,0,,«Шайтанның етін жегің келе ме?
Dialogue: 0,0:05:17.44,0:05:19.36,Default,,0,0,0,,Ол осы мамандық атауын беруге тікелей шабыт болған —
Dialogue: 0,0:05:22.36,0:05:23.36,Default,,0,0,0,,Мақсаты?
Dialogue: 0,0:05:25.15,0:05:27.45,Default,,0,0,0,,Бұл жай ғана тәбет.
Dialogue: 0,0:05:27.95,0:05:31.95,Default,,0,0,0,,Мен неше түрлі жедім.
Dialogue: 0,0:05:33.08,0:05:36.58,Default,,0,0,0,,Патшалар мен тектілер де дәм татпайтын сирек заттар
Dialogue: 0,0:05:36.66,0:05:40.34,Default,,0,0,0,,Крепостнойлар да жемейтін дөрекі заттар
Dialogue: 0,0:05:41.75,0:05:42.59,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:05:42.67,0:05:44.05,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:44.13,0:05:44.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:44.80,0:05:46.63,Default,,0,0,0,,Осындай қарапайым нәрселер
Dialogue: 0,0:05:46.72,0:05:49.97,Default,,0,0,0,,Ол енді менің жанымды толтырмайды!
Dialogue: 0,0:05:51.47,0:05:54.89,Default,,0,0,0,,Мұны бұрын ешкім айтқан емес...
Dialogue: 0,0:05:54.97,0:05:58.10,Default,,0,0,0,,Жұмбақ пен мүмкіндікке толы ингредиенттер
Dialogue: 0,0:05:58.19,0:06:00.40,Default,,0,0,0,,Бұл шайтанның еті
Dialogue: 0,0:06:00.48,0:06:03.61,Default,,0,0,0,,Бұл ұлы шайтан Шайтанның еті.
Dialogue: 0,0:06:04.48,0:06:06.40,Default,,0,0,0,,Әй, Шайтан...
Dialogue: 0,0:06:06.49,0:06:09.41,Default,,0,0,0,,Сізге қандай дәм ұнайды?
Dialogue: 0,0:06:09.49,0:06:12.37,Default,,0,0,0,,Бұл аңдардың жабайы дәмі ме?
Dialogue: 0,0:06:12.45,0:06:14.91,Default,,0,0,0,,Бұл жамандықтың тәтті дәмі ме?
Dialogue: 0,0:06:14.99,0:06:18.04,Default,,0,0,0,,Мен сенің етіңді татқан кезде
Dialogue: 0,0:06:18.54,0:06:22.92,Default,,0,0,0,,Мен бақыттан ләззат алатыныма сенімдімін
Dialogue: 0,0:06:24.50,0:06:27.30,Default,,0,0,0,,«Бақытты»... (Мефисто III) Иә?
Dialogue: 0,0:06:27.38,0:06:32.05,Default,,0,0,0,,«Шайтанды шақыр» Бұл өтініш пе?
Dialogue: 0,0:06:32.14,0:06:34.39,Default,,0,0,0,,Мен сізге кез келген ақшаны төлеймін
Dialogue: 0,0:06:34.89,0:06:36.06,Default,,0,0,0,,Әй, бұл!
Dialogue: 0,0:06:36.14,0:06:38.14,Default,,0,0,0,,Шайтан үлкен мәселе ме?
Dialogue: 0,0:06:38.64,0:06:41.52,Default,,0,0,0,,Сол кішкентай шабақтарды «чочо» деп атау нені білдіреді?
Dialogue: 0,0:06:41.60,0:06:43.02,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:06:43.52,0:06:45.86,Default,,0,0,0,,Шақыру сәтті болса да
Dialogue: 0,0:06:45.94,0:06:47.94,Default,,0,0,0,,Ол жайбарақат табаққа отырады...
Dialogue: 0,0:06:48.03,0:06:51.36,Default,,0,0,0,,Жоқ, бұл Шайтанмен келіссөздерге байланысты болады.
Dialogue: 0,0:06:51.45,0:06:52.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:52.62,0:06:54.28,Default,,0,0,0,,Сіз оны қабылдауды жоспарлап отырсыз ба?
Dialogue: 0,0:06:54.37,0:06:55.49,Default,,0,0,0,,Мен мұны айтқан жоқпын.
Dialogue: 0,0:06:55.58,0:06:58.16,Default,,0,0,0,,Ханакара келіссөз жүргізу мүмкін емес деп шешті.
Dialogue: 0,0:06:58.25,0:07:00.12,Default,,0,0,0,,Мен бұл көзқарасты сынаймын.
Dialogue: 0,0:07:00.21,0:07:01.17,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:07:01.25,0:07:03.75,Default,,0,0,0,,Сондықтан сенің достарың жоқ.
Dialogue: 0,0:07:03.84,0:07:07.96,Default,,0,0,0,,Түсіндім, ақшаның Шайтанға пайдасы жоқ па?
Dialogue: 0,0:07:08.05,0:07:09.30,Default,,0,0,0,,Мен оны жоққа шығармаймын
Dialogue: 0,0:07:09.38,0:07:10.55,Default,,0,0,0,,Ийда…
Dialogue: 0,0:07:10.63,0:07:12.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:12.47,0:07:13.93,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:07:15.30,0:07:16.56,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:16.64,0:07:17.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:17.89,0:07:20.06,Default,,0,0,0,,(Тобаяманың күлкісі)
Dialogue: 0,0:07:20.14,0:07:22.06,Default,,0,0,0,,Қалай ойлайсың, Шайтан?
Dialogue: 0,0:07:22.15,0:07:26.27,Default,,0,0,0,,Адамның жаны жараса, мен саған не қаласаң да беремін.
Dialogue: 0,0:07:26.36,0:07:27.19,Default,,0,0,0,,(орындықтан тұру дыбысы)
Dialogue: 0,0:07:27.28,0:07:29.74,Default,,0,0,0,,Үйге қайтайық, шайтан-күн.
Dialogue: 0,0:07:29.82,0:07:30.74,Default,,0,0,0,,Бұл жігіт жақсы...
Dialogue: 0,0:07:30.82,0:07:31.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:32.20,0:07:32.74,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:34.82,0:07:38.33,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:44.13,0:07:45.08,Default,,0,0,0,,Хаа…
Dialogue: 0,0:07:45.59,0:07:47.25,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:07:47.34,0:07:48.96,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:07:50.84,0:07:52.51,Default,,0,0,0,,Гяаа!
Dialogue: 0,0:07:53.89,0:07:54.51,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:07:55.30,0:07:56.68,Default,,0,0,0,,Һм? Бұл не?
Dialogue: 0,0:07:56.76,0:07:59.22,Default,,0,0,0,,Куу ~ Бару ~
Dialogue: 0,0:08:00.39,0:08:02.94,Default,,0,0,0,,Әй, шайтан!
Dialogue: 0,0:08:03.02,0:08:06.31,Default,,0,0,0,,Маған қайта қоңырау шалу үшін сиқырлы шеңберді пайдаланыңыз!
Dialogue: 0,0:08:07.48,0:08:08.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:08.32,0:08:11.90,Default,,0,0,0,,(Құбыжық айқайлауы)
Dialogue: 0,0:08:11.99,0:08:12.78,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:13.40,0:08:15.82,Default,,0,0,0,,Сіз қайсысысыз?
Dialogue: 0,0:08:17.16,0:08:20.91,Default,,0,0,0,,Екі аптадан бері ештеңе жеген жоқ.
Dialogue: 0,0:08:21.00,0:08:23.92,Default,,0,0,0,,Сіз аш болуыңыз керек.
Dialogue: 0,0:08:24.50,0:08:26.17,Default,,0,0,0,,Сізде тіпті аю бар ма?
Dialogue: 0,0:08:26.79,0:08:28.54,Default,,0,0,0,,Кешіріңіз—
Dialogue: 0,0:08:29.30,0:08:31.92,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:08:32.01,0:08:35.55,Default,,0,0,0,,Жоқ, бұрынғы адам деп айту керек пе?
Dialogue: 0,0:08:35.64,0:08:37.26,Default,,0,0,0,,2 апта бұрын
Dialogue: 0,0:08:37.35,0:08:42.48,Default,,0,0,0,,Шайтанды шақырмақ болып, сәтсіздікке ұшыраған төрт сиқыршы.
Dialogue: 0,0:08:42.56,0:08:44.31,Default,,0,0,0,,Бұл әңгіменің соңы
Dialogue: 0,0:08:44.39,0:08:46.48,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:08:46.56,0:08:47.98,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:49.11,0:08:50.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:50.61,0:08:51.69,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:51.78,0:08:54.53,Default,,0,0,0,,Сиқырлы күш Найзағай!
Dialogue: 0,0:08:57.37,0:08:59.78,Default,,0,0,0,,Менің қарным ашты!
Dialogue: 0,0:09:00.74,0:09:01.29,Default,,0,0,0,,Сиқырлы күш…
Dialogue: 0,0:09:01.37,0:09:02.79,Default,,0,0,0,,Абсолюттік нөл!
Dialogue: 0,0:09:04.75,0:09:07.88,Default,,0,0,0,,Хи хи хи, енді байсың~
Dialogue: 0,0:09:08.38,0:09:09.92,Default,,0,0,0,,Боқ, шайтансыз.
Dialogue: 0,0:09:10.00,0:09:11.59,Default,,0,0,0,,Бұл шектеу ме?
Dialogue: 0,0:09:11.67,0:09:13.80,Default,,0,0,0,,(Құбыжық айқайлаған заклинаниенің дауысы)
Dialogue: 0,0:09:13.88,0:09:15.22,Default,,0,0,0,,Олай болса қаш!
Dialogue: 0,0:09:15.30,0:09:17.22,Default,,0,0,0,,Мені өлтір~
Dialogue: 0,0:09:17.30,0:09:19.05,Default,,0,0,0,,Әй, шайтан!
Dialogue: 0,0:09:19.55,0:09:21.47,Default,,0,0,0,,Маған тезірек көмектесіңізші!
Dialogue: 0,0:09:22.60,0:09:24.93,Default,,0,0,0,,Сіз досыңызға көмектескіңіз келеді, солай ма?
Dialogue: 0,0:09:25.02,0:09:28.35,Default,,0,0,0,,Достар? Мен іскер серіктеспін.
Dialogue: 0,0:09:28.85,0:09:31.48,Default,,0,0,0,,Оның үстіне ата-ана өз бетінше шешім қабылдады.
Dialogue: 0,0:09:31.57,0:09:32.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:33.07,0:09:35.19,Default,,0,0,0,,Мен сізге өткен күні қарызға берген Рамен ақшасы
Dialogue: 0,0:09:35.28,0:09:37.78,Default,,0,0,0,,Мен оны мазақ етемін!
Dialogue: 0,0:09:38.32,0:09:38.99,Default,,0,0,0,,Мұның бәрі тек менің алаңдаған жүрегімді жылдамдатты
Dialogue: 0,0:09:39.07,0:09:41.49,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:09:42.08,0:09:45.54,Default,,0,0,0,,Мен ұлы шайтан Шайтанды шақырамын.
Dialogue: 0,0:09:48.75,0:09:50.13,Default,,0,0,0,,Шайтан
Dialogue: 0,0:09:50.21,0:09:53.67,Default,,0,0,0,,Жүздеген жындарды басқаратын тозақ әскерінің қолбасшысы.
Dialogue: 0,0:09:53.75,0:09:56.09,Default,,0,0,0,,Шайтандардың шайтаны
Dialogue: 0,0:09:56.88,0:10:00.01,Default,,0,0,0,,Магилер 3000 жыл бұрын табысқа жеткендіктен
Dialogue: 0,0:10:00.51,0:10:03.51,Default,,0,0,0,,Шайтанды шақыруға ешкім ешқашан қол жеткізе алмады.
Dialogue: 0,0:10:09.02,0:10:10.52,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:10:11.40,0:10:12.90,Default,,0,0,0,,Қандай сиқырлы шеңбер салу керек?
Dialogue: 0,0:10:12.98,0:10:14.78,Default,,0,0,0,,Шайтанды шақыруға бола ма?
Dialogue: 0,0:10:15.44,0:10:18.49,Default,,0,0,0,,Дұрыс жауабы бар гримуар жоқ.
Dialogue: 0,0:10:18.57,0:10:23.74,Default,,0,0,0,,Дегенмен, сиқырлы шеңберлерді салудың белгілі бір ережелері бар.
Dialogue: 0,0:10:24.95,0:10:26.45,Default,,0,0,0,,Жақсы мүмкіндік, сондықтан мәселені түпкілікті анықтап алайық.
Dialogue: 0,0:10:27.25,0:10:29.46,Default,,0,0,0,,«Балық» астындағы «Су»
Dialogue: 0,0:10:29.96,0:10:31.63,Default,,0,0,0,,Бұл бастаушының қателігі.
Dialogue: 0,0:10:32.29,0:10:34.59,Default,,0,0,0,,Суда тіршілік ететін балықтар
Dialogue: 0,0:10:34.67,0:10:37.47,Default,,0,0,0,,Терең психологияда бейсаналық белгілер
Dialogue: 0,0:10:38.26,0:10:41.80,Default,,0,0,0,,Басқаша айтқанда, тұлғаның тереңінде жатқан «ана әлемі» дегенді білдіреді.
Dialogue: 0,0:10:42.89,0:10:45.56,Default,,0,0,0,,Егер... болса, онда жұптың орнын сызу керек...
Dialogue: 0,0:10:46.35,0:10:48.39,Default,,0,0,0,,Мен бәрін бақылап отырмын.
Dialogue: 0,0:10:48.89,0:10:51.31,Default,,0,0,0,,Біртүрлі нәрсе жасап көріңіз.
Dialogue: 0,0:10:51.40,0:10:54.48,Default,,0,0,0,,Мен жер астындағы бөлмені түгел өртеп жіберемін.
Dialogue: 0,0:10:55.27,0:10:58.44,Default,,0,0,0,,Сирек пісіріледі ме? Жақсы жасалған ба?
Dialogue: 0,0:10:58.53,0:11:01.11,Default,,0,0,0,,Тек рамен жейтін жігіт.
Dialogue: 0,0:11:01.20,0:11:03.91,Default,,0,0,0,,Менің ойымша, оның дәмі арзан және тұрпайы.
Dialogue: 0,0:11:09.79,0:11:12.21,Default,,0,0,0,,Шайтанның шақырылуы – мәңгілік құпия
Dialogue: 0,0:11:12.79,0:11:16.05,Default,,0,0,0,,Бірақ шайтанды шақыру – даналық пен білім туралы ғылым.
Dialogue: 0,0:11:16.63,0:11:18.30,Default,,0,0,0,,болса, оны шешуге болады
Dialogue: 0,0:11:22.89,0:11:24.89,Default,,0,0,0,,(құбыжық айқайлау)
Dialogue: 0,0:11:24.97,0:11:25.68,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:26.22,0:11:27.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:27.60,0:11:28.47,Default,,0,0,0,,Сіз байсыз!
Dialogue: 0,0:11:28.56,0:11:29.73,Default,,0,0,0,,Чикишо
Dialogue: 0,0:11:29.81,0:11:33.27,Default,,0,0,0,,Мен Девил-кунсыз ештеңе істей алмаймын.
Dialogue: 0,0:11:33.85,0:11:35.06,Default,,0,0,0,,Өкінішті...
Dialogue: 0,0:11:35.56,0:11:36.69,Default,,0,0,0,,Хи хи
Dialogue: 0,0:11:37.19,0:11:39.28,Default,,0,0,0,,Сіз бұлай айта алмайсыз.
Dialogue: 0,0:11:39.36,0:11:41.53,Default,,0,0,0,,Сиқырлы абсолютті нөл!
Dialogue: 0,0:11:42.61,0:11:43.66,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:45.53,0:11:46.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:46.37,0:11:47.62,Default,,0,0,0,,Қандай шу, жын-перілер.
Dialogue: 0,0:11:47.70,0:11:49.45,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:11:50.62,0:11:51.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:52.92,0:11:54.08,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:11:59.59,0:12:00.72,Default,,0,0,0,,(қону дыбысы)
Dialogue: 0,0:12:00.80,0:12:02.88,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:12:03.38,0:12:05.59,Default,,0,0,0,,Мен Мефисто IIIмын
Dialogue: 0,0:12:05.68,0:12:07.18,Default,,0,0,0,,Шатаспаңыз!
Dialogue: 0,0:12:08.89,0:12:11.35,Default,,0,0,0,,Ол тәртіпсіз бала.
Dialogue: 0,0:12:11.43,0:12:12.52,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:12.60,0:12:13.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:15.19,0:12:16.61,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:12:16.69,0:12:18.02,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:12:18.69,0:12:20.99,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,0:12:23.99,0:12:25.07,Default,,0,0,0,,Хаа…
Dialogue: 0,0:12:25.99,0:12:27.24,Default,,0,0,0,,Қазір...
Dialogue: 0,0:12:28.12,0:12:29.54,Default,,0,0,0,,Не қалды...
Dialogue: 0,0:12:31.83,0:12:35.25,Default,,0,0,0,,Шеңбердің ортасына келетін әріптер ғана
Dialogue: 0,0:12:35.33,0:12:38.25,Default,,0,0,0,,«Тұз» немесе «маска»…
Dialogue: 0,0:12:49.05,0:12:50.60,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,0:12:51.10,0:12:52.06,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:52.14,0:12:54.39,Default,,0,0,0,,Мен өзім шықтым.
Dialogue: 0,0:12:54.89,0:12:55.98,Default,,0,0,0,,Енді бәрі жақсы
Dialogue: 0,0:12:56.48,0:12:58.40,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:58.48,0:13:00.90,Default,,0,0,0,,Жетер, шайтан-күн.
Dialogue: 0,0:13:00.98,0:13:05.49,Default,,0,0,0,,Оның дұрыстығын дәлелдеу ғана қалады.
Dialogue: 0,0:13:06.24,0:13:08.70,Default,,0,0,0,,Эй, тыңдап тұрсың ба?
Dialogue: 0,0:13:09.37,0:13:12.70,Default,,0,0,0,,Косей шынымен бұған қол жеткізе ала ма екен?
Dialogue: 0,0:13:13.20,0:13:15.29,Default,,0,0,0,,Мен талап етемін және сотқа беремін.
Dialogue: 0,0:13:15.79,0:13:16.96,Default,,0,0,0,,Не... Уау!
Dialogue: 0,0:13:20.04,0:13:22.71,Default,,0,0,0,,Шіріген атмосфераның рухы
Dialogue: 0,0:13:23.21,0:13:24.72,Default,,0,0,0,,Ұйқыдан ояныңыз
Dialogue: 0,0:13:24.80,0:13:27.43,Default,,0,0,0,,Бах... сен ақымақ.
Dialogue: 0,0:13:27.51,0:13:30.85,Default,,0,0,0,,Мұны бәрінің Әкесінің атынан жаса!
Dialogue: 0,0:13:31.51,0:13:33.39,Default,,0,0,0,,Хе, жақсы.
Dialogue: 0,0:13:33.89,0:13:35.06,Default,,0,0,0,,Көбірек жасаңыз
Dialogue: 0,0:13:35.14,0:13:36.69,Default,,0,0,0,,Кукикикикики!
Dialogue: 0,0:13:36.77,0:13:37.44,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:13:37.52,0:13:39.19,Default,,0,0,0,,Шайтан
Dialogue: 0,0:13:39.27,0:13:40.65,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:13:40.73,0:13:42.48,Default,,0,0,0,,Дұрыс немесе бұрыс
Dialogue: 0,0:13:42.57,0:13:45.49,Default,,0,0,0,,Бұл енді маңызды емес!
Dialogue: 0,0:13:45.57,0:13:48.24,Default,,0,0,0,,Менің өтінішіме жауап беріңіз!
Dialogue: 0,0:13:53.49,0:13:54.37,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:14:00.79,0:14:04.09,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:14:05.38,0:14:06.05,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:14:06.76,0:14:09.05,Default,,0,0,0,,Бұл «маска» болды ма?
Dialogue: 0,0:14:10.89,0:14:12.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:12.39,0:14:13.81,Default,,0,0,0,,Біз де құбыжықпыз!
Dialogue: 0,0:14:15.14,0:14:19.10,Default,,0,0,0,,Енді... Санаэ-сан!
Dialogue: 0,0:14:21.90,0:14:24.82,Default,,0,0,0,,(Шайтанның дауысы)
Dialogue: 0,0:14:24.90,0:14:26.07,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:26.15,0:14:27.15,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:14:35.20,0:14:39.33,Default,,0,0,0,,(Масато) Денең болмауы біраз қиын ғой, иә?
Dialogue: 0,0:14:41.13,0:14:44.59,Default,,0,0,0,,Иә? Әдемі адам болып қала бересіз бе? Сіз тіпті армандағансыз ба?
Dialogue: 0,0:14:44.67,0:14:45.50,Default,,0,0,0,,Хаа…
Dialogue: 0,0:14:46.01,0:14:47.09,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:14:47.17,0:14:47.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:48.42,0:14:52.51,Default,,0,0,0,,Шақыру сәтсіз аяқталды және сиқырлы шеңбер құлады.
Dialogue: 0,0:14:53.01,0:14:53.85,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:14:55.93,0:14:57.35,Default,,0,0,0,,Бұл дүниеде...
Dialogue: 0,0:14:57.43,0:14:59.94,Default,,0,0,0,,Мүмкін емес ештеңе жоқ
Dialogue: 0,0:15:00.44,0:15:02.35,Default,,0,0,0,,Кез келген нәрсе болуы мүмкін
Dialogue: 0,0:15:02.44,0:15:04.94,Default,,0,0,0,,Не? Қайтыс болуы керек еді қызметші?
Dialogue: 0,0:15:05.82,0:15:08.86,Default,,0,0,0,,А, мен не болып жатқанын білмеймін...
Dialogue: 0,0:15:08.94,0:15:12.41,Default,,0,0,0,,Айтпақшы, сіз жасаған сиқырлы шеңбер.
Dialogue: 0,0:15:12.91,0:15:15.20,Default,,0,0,0,,Бұл қорқынышты нәрсе.
Dialogue: 0,0:15:15.95,0:15:19.62,Default,,0,0,0,,«Тұз» немесе «маска» - ескі сұрақ.
Dialogue: 0,0:15:19.71,0:15:20.71,Default,,0,0,0,,Не?
Dialogue: 0,0:15:20.79,0:15:22.12,Default,,0,0,0,,Иә! Ах...
Dialogue: 0,0:15:24.00,0:15:25.46,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:15:25.96,0:15:27.13,Default,,0,0,0,,Бұл жүрек.
Dialogue: 0,0:15:27.21,0:15:28.51,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:28.59,0:15:29.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:29.97,0:15:33.39,Default,,0,0,0,,(Тобаяманың ыңырануы)
Dialogue: 0,0:15:33.47,0:15:35.39,Default,,0,0,0,,Ах, жылап жібергім келеді!! Егер білгенімде➡
Dialogue: 0,0:15:35.47,0:15:38.35,Default,,0,0,0,,Сіз... Шайтансыз ба?
Dialogue: 0,0:15:38.43,0:15:39.48,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:15:39.56,0:15:40.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:41.19,0:15:43.27,Default,,0,0,0,,Сонымен... сізді кім шақырды?
Dialogue: 0,0:15:43.77,0:15:44.90,Default,,0,0,0,,Шақыру керек пе?
Dialogue: 0,0:15:45.52,0:15:48.48,Default,,0,0,0,,Мен сенің етіңді татқанда
Dialogue: 0,0:15:48.57,0:15:52.91,Default,,0,0,0,,Мен бақыттан ләззат алатыныма сенімдімін
Dialogue: 0,0:15:54.53,0:15:57.91,Default,,0,0,0,,«Бақыт» «ашкөздік» дегенді білдіреді
Dialogue: 0,0:15:58.79,0:16:01.41,Default,,0,0,0,,Оны шайтан иіскейді
Dialogue: 0,0:16:01.50,0:16:04.42,Default,,0,0,0,,және бәрін қараңыз
Dialogue: 0,0:16:04.50,0:16:09.13,Default,,0,0,0,,Ешкім шақырмаса да, дәл қасыңда.
Dialogue: 0,0:16:10.26,0:16:13.43,Default,,0,0,0,,Қаншама сараңдық жинап
Dialogue: 0,0:16:13.51,0:16:16.55,Default,,0,0,0,,Дәл сіз адамдар сияқты тамақты ұнатасыз.
Dialogue: 0,0:16:16.64,0:16:19.47,Default,,0,0,0,,Мына ыдысқа ұқсамай ма?
Dialogue: 0,0:16:20.06,0:16:22.43,Default,,0,0,0,,Сіздің атыңыз кім еді?
Dialogue: 0,0:16:22.52,0:16:25.94,Default,,0,0,0,,А, дұрыс, фуа гра.
Dialogue: 0,0:16:26.81,0:16:27.94,Default,,0,0,0,,Перори
Dialogue: 0,0:16:31.53,0:16:34.07,Default,,0,0,0,,Косей шынымен бұған қол жеткізе ала ма екен?
Dialogue: 0,0:16:34.15,0:16:36.12,Default,,0,0,0,,Мен талап етемін және сотқа беремін.
Dialogue: 0,0:16:37.78,0:16:38.95,Default,,0,0,0,,Хо хо...
Dialogue: 0,0:16:39.03,0:16:41.91,Default,,0,0,0,,Мен сізге Потестат Диаболиді беремін
Dialogue: 0,0:16:45.04,0:16:47.04,Default,,0,0,0,,Сиқырлы абсолютті нөл!
Dialogue: 0,0:16:50.38,0:16:52.46,Default,,0,0,0,,Бұл бонус. Алыңыз.
Dialogue: 0,0:16:54.55,0:16:56.34,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:02.81,0:17:03.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:09.90,0:17:10.57,Default,,0,0,0,,Қазір...
Dialogue: 0,0:17:11.28,0:17:13.86,Default,,0,0,0,,Сіздің емделуіңізге келсек...
Dialogue: 0,0:17:14.65,0:17:16.07,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:17:16.16,0:17:19.07,Default,,0,0,0,,(Жындардың ауыр тыныс алуы)
Dialogue: 0,0:17:20.66,0:17:24.62,Default,,0,0,0,,Бүгін менің көңіл күйім жақсы.
Dialogue: 0,0:17:27.79,0:17:31.59,Default,,0,0,0,,Мен келесі егін жинайтын жүрек таптым.
Dialogue: 0,0:17:31.67,0:17:34.13,Default,,0,0,0,,Дәл сол ашкөз сияқты
Dialogue: 0,0:17:34.21,0:17:38.84,Default,,0,0,0,,Сен де сараңдыққа салыну керек... Қайта, білімге құмар бол.
Dialogue: 0,0:17:39.97,0:17:44.64,Default,,0,0,0,,Жүрекке құмарлық жиналып, семіз, майланғанда
Dialogue: 0,0:17:44.73,0:17:46.35,Default,,0,0,0,,Тағы кездесейік
Dialogue: 0,0:17:47.23,0:17:48.85,Default,,0,0,0,,Оған дейін өмір сүр
Dialogue: 0,0:17:52.19,0:17:55.57,Default,,0,0,0,,Не болса да, бұл дәліз тым ұзын емес пе?
Dialogue: 0,0:17:55.65,0:17:57.11,Default,,0,0,0,,Менімен ойнап жатыр.
Dialogue: 0,0:17:57.20,0:17:58.78,Default,,0,0,0,,Чикишо
Dialogue: 0,0:17:58.86,0:18:00.03,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:18:05.29,0:18:06.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:13.67,0:18:15.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:16.34,0:18:18.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:19.01,0:18:20.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:20.93,0:18:22.47,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:18:23.43,0:18:24.97,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:18:25.06,0:18:26.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:28.94,0:18:30.10,Default,,0,0,0,,Міне кеттік
Dialogue: 0,0:18:31.36,0:18:32.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:32.69,0:18:34.27,Default,,0,0,0,,Жоқ... күте тұрыңыз...
Dialogue: 0,0:18:35.44,0:18:36.86,Default,,0,0,0,,Акселераторға да қолым жетпейді – орындық тым үлкен.
Dialogue: 0,0:18:38.61,0:18:42.62,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:18:47.96,0:18:50.12,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:18:54.21,0:18:55.67,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:55.75,0:18:58.63,Default,,0,0,0,,Бұл екінші шайтан ма?
Dialogue: 0,0:18:59.13,0:19:02.97,Default,,0,0,0,,Адамдар тастап, шайтан тастап кеткен бала.
Dialogue: 0,0:19:03.47,0:19:04.56,Default,,0,0,0,,Қызықты
Dialogue: 0,0:19:05.06,0:19:06.14,Default,,0,0,0,,Әлі көк
Dialogue: 0,0:19:06.22,0:19:09.69,Default,,0,0,0,,Бұл Холос қақпасын ашудың кілті болуы мүмкін
Dialogue: 0,0:19:10.19,0:19:12.10,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:19:14.98,0:19:20.65,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:19:26.83,0:19:28.08,Default,,0,0,0,,Эй
Dialogue: 0,0:19:29.20,0:19:30.37,Default,,0,0,0,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,0:19:31.25,0:19:32.08,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:33.46,0:19:35.88,Default,,0,0,0,,Неліктен соққы алғаныңызды білесіз бе?
Dialogue: 0,0:19:36.92,0:19:39.38,Default,,0,0,0,,Мен сенің өміріңді тәуекел еттім.
Dialogue: 0,0:19:39.46,0:19:40.38,Default,,0,0,0,,Өмір…
Dialogue: 0,0:19:40.47,0:19:42.30,Default,,0,0,0,,Оны атамаңыз
Dialogue: 0,0:19:43.22,0:19:47.01,Default,,0,0,0,,Бұл менің өмірімді ғана емес, тәуекелге де қойдыңыз.
Dialogue: 0,0:19:47.10,0:19:48.64,Default,,0,0,0,,Сіздің де өміріңіз.
Dialogue: 0,0:19:49.35,0:19:51.77,Default,,0,0,0,,Біз бір себеппен дүниеге келдік.
Dialogue: 0,0:19:51.85,0:19:53.15,Default,,0,0,0,,Мен осылай өмір сүремін
Dialogue: 0,0:19:53.81,0:19:56.23,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:19:59.23,0:20:01.65,Default,,0,0,0,,Біраз уақытқа мен күнде рамен жеймін.
Dialogue: 0,0:20:01.74,0:20:02.53,Default,,0,0,0,,Бар болғаны
Dialogue: 0,0:20:03.03,0:20:04.11,Default,,0,0,0,,Кумия Нурезо — біз сол жігітті артта қалдыра саламыз.
Dialogue: 0,0:20:24.97,0:20:27.14,Default,,0,0,0,,(қайнаған судың дыбысы)
Dialogue: 0,0:20:31.73,0:20:33.89,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:20:33.98,0:20:36.69,Default,,0,0,0,,Тіпті бізге дастархан жайылды.
Dialogue: 0,0:20:36.77,0:20:38.94,Default,,0,0,0,,Бұл өте нашар~
Dialogue: 0,0:20:39.02,0:20:40.48,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:40.57,0:20:44.49,Default,,0,0,0,,Ізгі қасиет жинамасаң, тозаққа барасың.
Dialogue: 0,0:20:44.99,0:20:46.70,Default,,0,0,0,,Дәмді~
Dialogue: 0,0:20:46.78,0:20:48.95,Default,,0,0,0,,Бақыт~
Dialogue: 0,0:20:49.03,0:20:50.45,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:20:50.54,0:20:51.75,Default,,0,0,0,,Эххе
Dialogue: 0,0:20:53.66,0:20:56.96,Default,,0,0,0,,Сіздің «бақытыңыз» қандай?
Dialogue: 0,0:20:58.04,0:20:59.21,Default,,0,0,0,,Демек, сен болған болашаққа қайта орала алмаймын дегің келе ме?
Dialogue: 0,0:21:00.63,0:21:01.88,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:21:03.17,0:21:06.47,Default,,0,0,0,,Сол жерден іздеуге қалай болады?
Dialogue: 0,0:21:13.18,0:21:17.73,Default,,0,0,0,,(Санаенің гуілдеуі)
Dialogue: 0,0:21:19.44,0:21:23.86,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:21:38.96,0:21:40.00,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:41.00,0:21:43.01,Default,,0,0,0,,♪～
Dialogue: 0,0:21:52.01,0:21:54.31,Default,,0,0,0,,Сәлем, Жүз көз, сен жарғанат мысықты көрдің бе?
Dialogue: 0,0:21:54.39,0:21:55.31,Default,,0,0,0,,Ібіліс-кун
Dialogue: 0,0:21:55.39,0:21:58.48,Default,,0,0,0,,Екінші шайтанмен тіл табыса алмай жүрсіз бе?
Dialogue: 0,0:21:58.56,0:21:59.81,Default,,0,0,0,,Жындар көп
Dialogue: 0,0:21:59.90,0:22:02.73,Default,,0,0,0,,Мені өзгерткен қожайынның өзі де қиналады.
Dialogue: 0,0:22:02.82,0:22:05.86,Default,,0,0,0,,Екінші ұрпақ – өте үлкен адам.
Dialogue: 0,0:22:05.94,0:22:07.78,Default,,0,0,0,,Ол шын мәнінде жақсы қыз.
Dialogue: 0,0:22:07.86,0:22:10.41,Default,,0,0,0,,Бірақ мен әлі жүрегімді аша алмаймын деп ойлаймын.
Dialogue: 0,0:22:10.49,0:22:13.58,Default,,0,0,0,,Мен болсам, әкемнің айтқанын тыңдар едім.
Dialogue: 0,0:22:13.66,0:22:14.95,Default,,0,0,0,,Сенің әкең...
Dialogue: 0,0:22:15.04,0:22:16.96,Default,,0,0,0,,Жүз көздің Зецуме екеніне сенімдімін... Ой...
Dialogue: 0,0:22:17.46,0:22:20.67,Default,,0,0,0,,Жүз көздің жойылды дегені рас.
Dialogue: 0,0:22:21.17,0:22:22.29,Default,,0,0,0,,Бірақ жүз көз қазір
Dialogue: 0,0:22:22.38,0:22:25.30,Default,,0,0,0,,Сіз Жүз көзді тірілту үшін сиқыр іздейсіз, солай ма?
Dialogue: 0,0:22:25.38,0:22:25.92,Default,,0,0,0,,Иә
Dialogue: 0,0:22:26.01,0:22:29.26,Default,,0,0,0,,Бұл менің тағы бір үлкен арманым.
Dialogue: 0,0:22:29.34,0:22:31.43,Default,,0,0,0,,Бірақ мен оны әлі мүлде түсінбеймін.
Dialogue: 0,0:22:31.51,0:22:34.47,Default,,0,0,0,,Екі арман, сараң жігіт
Dialogue: 0,0:22:34.56,0:22:36.10,Default,,0,0,0,,Бірақ берілме
Dialogue: 0,0:22:36.18,0:22:38.56,Default,,0,0,0,,Дұрыс, қолымыздан келгенше тайсалмай, анашым.
Dialogue: 0,0:22:38.64,0:22:40.98,Default,,0,0,0,,Иә, шайтан да барын салады.
Dialogue: 0,0:22:41.06,0:22:42.23,Default,,0,0,0,,...
Dialogue: 0,0:22:42.31,0:22:45.48,Default,,0,0,0,,Басқалар да бүкіл әлемде қолынан келгеннің бәрін жасап жатқан сияқты.
Dialogue: 0,0:22:45.57,0:22:46.36,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:22:46.44,0:22:47.82,Default,,0,0,0,,Туған жері бойынша
Dialogue: 0,0:22:47.90,0:22:50.66,Default,,0,0,0,,Әр адам өз арманын орындау үшін аянбай еңбек етеді.
Dialogue: 0,0:22:50.74,0:22:54.03,Default,,0,0,0,,Көптен бері бәрімен кездескім келіп жүр.
Dialogue: 0,0:22:54.12,0:22:54.70,Default,,0,0,0,,Екеуін біз қараймыз.
Dialogue: 0,0:22:54.79,0:22:57.00,Default,,0,0,0,,Неліктен жарқанат мысық Жапонияда?
Dialogue: 0,0:22:57.08,0:22:59.21,Default,,0,0,0,,Каникулға шығайық. Демалыс.
Dialogue: 0,0:22:59.29,0:23:01.63,Default,,0,0,0,,Демалыс – менің маңызды арманым.
Dialogue: 0,0:23:01.71,0:23:02.63,Default,,0,0,0,,Уау
Dialogue: 0,0:23:02.71,0:23:04.71,Default,,0,0,0,,Тіпті жарқанаттар мен мысықтар да екі түс көреді.
Dialogue: 0,0:23:04.80,0:23:07.59,Default,,0,0,0,,Жоқ, жоқ, бұл жай ғана арман болса, әлі де көп.
Dialogue: 0,0:23:07.67,0:23:08.84,Default,,0,0,0,,Дәл қазір менің ең үлкен арманым
Dialogue: 0,0:23:08.92,0:23:11.97,Default,,0,0,0,,Cat брендінің Бат қолшатырын сату және оны үлкен хитке айналдыру
Dialogue: 0,0:23:12.05,0:23:14.81,Default,,0,0,0,,Дүниежүзілік қолшатырлар нарығының 99%
Dialogue: 0,0:23:14.89,0:23:17.39,Default,,0,0,0,,Мен монополияға ие болуды армандаймын...
Dialogue: 0,0:23:17.47,0:23:19.14,Default,,0,0,0,,Ондай адам жоқ.
Dialogue: 0,0:23:38.12,0:23:40.12,Default,,0,0,0,,～♪
Dialogue: 0,0:23:41.62,0:23:47.62,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory