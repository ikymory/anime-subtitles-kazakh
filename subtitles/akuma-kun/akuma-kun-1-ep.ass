Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.92,0:00:16.93,Default,,0,0,0,,(Радио кассеталық ойнатқыштан ойналатын музыка)
Dialogue: 0,0:00:17.01,0:00:22.93,Default,,0,0,0,,(дәретхана жөндеу дыбысы)
Dialogue: 0,0:00:34.45,0:00:38.45,Default,,0,0,0,,(Дәретхананың ағу дыбысы)
Dialogue: 0,0:00:41.04,0:00:43.33,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:43.41,0:00:44.87,Default,,0,0,0,,А... аяқталды.
Dialogue: 0,0:00:46.04,0:00:47.63,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:00:47.71,0:00:50.88,Default,,0,0,0,,Дәретхана бітеліп қалса, маған хабарласпа.
Dialogue: 0,0:00:51.38,0:00:52.92,Default,,0,0,0,,О, менің раменім!
Dialogue: 0,0:00:53.55,0:00:54.38,Default,,0,0,0,,жеді
Dialogue: 0,0:00:54.88,0:00:56.84,Default,,0,0,0,,Тамақ... Неге?
Dialogue: 0,0:00:57.72,0:00:59.35,Default,,0,0,0,,Тамақ ішпесең, өсерсің.
Dialogue: 0,0:00:59.85,0:01:01.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:01.18,0:01:03.18,Default,,0,0,0,,Соңғы рет ағып кеткен жерді жөндегенде
Dialogue: 0,0:01:03.27,0:01:06.10,Default,,0,0,0,,Адамдар рамен кеспесі тым ұзын деп шағымданды.
Dialogue: 0,0:01:06.19,0:01:08.73,Default,,0,0,0,,Оны жай ғана жемеңіз.
Dialogue: 0,0:01:08.81,0:01:10.48,Default,,0,0,0,,Өссе де жейсің бе?
Dialogue: 0,0:01:10.57,0:01:11.86,Default,,0,0,0,,Тамақтану
Dialogue: 0,0:01:11.94,0:01:14.15,Default,,0,0,0,,Соңғы шағым қандай болды?
Dialogue: 0,0:01:14.65,0:01:15.78,Default,,0,0,0,,Бұл...
Dialogue: 0,0:01:16.57,0:01:18.66,Default,,0,0,0,,Бұл жай ғана сылтау болды.
Dialogue: 0,0:01:18.74,0:01:20.03,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:20.12,0:01:22.16,Default,,0,0,0,,Жарайды, мен оны бір түйір тұзбен алайын.
Dialogue: 0,0:01:22.95,0:01:24.29,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:01:24.37,0:01:25.16,Default,,0,0,0,,(дыбысты өшіру)
Dialogue: 0,0:01:25.25,0:01:27.21,Default,,0,0,0,,Жалпы, сіз оны шақырсаңыз да
Dialogue: 0,0:01:27.29,0:01:30.46,Default,,0,0,0,,Қоңырау шалу сияқты басқа да жолдар бар.
Dialogue: 0,0:01:30.54,0:01:34.38,Default,,0,0,0,,Бұл уақытты алады және сіз бірден келмеуіңіз мүмкін.
Dialogue: 0,0:01:34.46,0:01:38.18,Default,,0,0,0,,Сіз маған осындай нәрсе үшін сиқырлы шеңберді шақырмауды айтасыз ба?
Dialogue: 0,0:01:38.26,0:01:39.76,Default,,0,0,0,,Мен мұны талай рет айттым.
Dialogue: 0,0:01:40.26,0:01:44.18,Default,,0,0,0,,Мен жартылай адаммын, сондықтан дұрыс шыға алмаймын.
Dialogue: 0,0:01:44.27,0:01:47.56,Default,,0,0,0,,Себебі сіз, адам, бас тартасыз.
Dialogue: 0,0:01:47.64,0:01:49.19,Default,,0,0,0,,Тек адал болыңыз.
Dialogue: 0,0:01:49.27,0:01:52.19,Default,,0,0,0,,Қарғыс атқыр... сенің айтқың келгені ол емес.
Dialogue: 0,0:01:52.27,0:01:54.28,Default,,0,0,0,,♪～
Dialogue: 0,0:02:06.20,0:02:08.21,Default,,0,0,0,,～♪
Dialogue: 0,0:02:09.62,0:02:14.63,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:21.18,0:02:23.60,Default,,0,0,0,,(шу)
Dialogue: 0,0:02:23.68,0:02:24.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:25.52,0:02:26.31,Default,,0,0,0,,(шу)
Dialogue: 0,0:02:26.39,0:02:27.43,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:28.69,0:02:33.19,Default,,0,0,0,,(шу)
Dialogue: 0,0:02:35.19,0:02:36.86,Default,,0,0,0,,Не?
Dialogue: 0,0:02:38.95,0:02:41.66,Default,,0,0,0,,Цк... Бұл қорқынышты.
Dialogue: 0,0:02:45.95,0:02:47.79,Default,,0,0,0,,Сіз шаршаған болуыңыз керек.
Dialogue: 0,0:02:47.87,0:02:50.42,Default,,0,0,0,,Мен ертең сабақты жіберемін.
Dialogue: 0,0:02:53.42,0:02:54.25,Default,,0,0,0,,А...
Dialogue: 0,0:02:57.96,0:02:58.80,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:01.80,0:03:03.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:03.43,0:03:05.47,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:03:05.56,0:03:07.10,Default,,0,0,0,,Сәлем! Не?
Dialogue: 0,0:03:07.18,0:03:08.35,Default,,0,0,0,,Жоқ… жоқ…
Dialogue: 0,0:03:08.43,0:03:10.98,Default,,0,0,0,,Жоооу!
Dialogue: 0,0:03:54.85,0:03:57.52,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:58.36,0:04:01.53,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:04:04.74,0:04:06.53,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:06.62,0:04:10.16,Default,,0,0,0,,(ыдыстарды сүрту дыбысы)
Dialogue: 0,0:04:10.25,0:04:12.54,Default,,0,0,0,,(Ыдыс-аяқтың бір-біріне соғылу дыбысы)
Dialogue: 0,0:04:12.62,0:04:13.79,Default,,0,0,0,,Ум...
Dialogue: 0,0:04:15.04,0:04:15.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:15.92,0:04:18.09,Default,,0,0,0,,А, мүмкін клиент?
Dialogue: 0,0:04:18.59,0:04:20.46,Default,,0,0,0,,Иә! Бұл клиент.
Dialogue: 0,0:04:20.55,0:04:22.09,Default,,0,0,0,,Жалдау ақысын төлеуге қабілетті
Dialogue: 0,0:04:23.63,0:04:25.34,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:04:26.09,0:04:28.14,Default,,0,0,0,,Сіз шайтансыз ба...?
Dialogue: 0,0:04:28.64,0:04:34.06,Default,,0,0,0,,Менің атым Мефистофель III
Dialogue: 0,0:04:34.73,0:04:35.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:38.48,0:04:40.11,Default,,0,0,0,,Ал, отыр, отыр.
Dialogue: 0,0:04:40.61,0:04:41.82,Default,,0,0,0,,Ертегіні тыңдау.
Dialogue: 0,0:04:42.94,0:04:43.78,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:04:44.28,0:04:45.57,Default,,0,0,0,,Бұл Хина Асанаги.
Dialogue: 0,0:04:46.07,0:04:47.32,Default,,0,0,0,,Қандай сұраныс?
Dialogue: 0,0:04:47.82,0:04:48.49,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:04:48.57,0:04:49.62,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:04:49.70,0:04:50.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:50.66,0:04:53.04,Default,,0,0,0,,Бұл Мыңжылдық институты.
Dialogue: 0,0:04:53.12,0:04:54.71,Default,,0,0,0,,Оккульттік детективтік агенттік емес
Dialogue: 0,0:04:54.79,0:04:56.92,Default,,0,0,0,,Олар: «Арқаңды асқазанмен алмастыра алмайсың» дейді.
Dialogue: 0,0:04:57.00,0:04:58.38,Default,,0,0,0,,Бұл сіздің асқазаныңызды қорғау үшін.
Dialogue: 0,0:04:58.46,0:05:01.34,Default,,0,0,0,,Арқаны құрбандыққа шалған дұрыс шығар.
Dialogue: 0,0:05:01.92,0:05:03.97,Default,,0,0,0,,Бірақ бұған қарсылық бар. Біріншіден...
Dialogue: 0,0:05:04.05,0:05:05.59,Default,,0,0,0,,Мен бұл туралы айтқан жоқпын.
Dialogue: 0,0:05:05.68,0:05:08.51,Default,,0,0,0,,Мен жинақталған рента туралы айтып отырмын.
Dialogue: 0,0:05:08.59,0:05:11.31,Default,,0,0,0,,Мм... сен шайтансың ба?
Dialogue: 0,0:05:11.39,0:05:12.81,Default,,0,0,0,,Шамасы, екінші ұрпақ
Dialogue: 0,0:05:12.89,0:05:15.31,Default,,0,0,0,,10 000 жылда бір данышпан болады дейді.
Dialogue: 0,0:05:16.94,0:05:18.52,Default,,0,0,0,,Кофе алғыңыз келе ме?
Dialogue: 0,0:05:18.60,0:05:19.31,Default,,0,0,0,,Иә
Dialogue: 0,0:05:19.98,0:05:21.07,Default,,0,0,0,,Килиманджаро
Dialogue: 0,0:05:21.15,0:05:23.48,Default,,0,0,0,,Қышқылдығы кеткенше қуырдым.
Dialogue: 0,0:05:24.11,0:05:25.99,Default,,0,0,0,,Олай болса сөйле, сөйлес
Dialogue: 0,0:05:26.07,0:05:27.16,Default,,0,0,0,,Иә
Dialogue: 0,0:05:27.74,0:05:31.28,Default,,0,0,0,,Менің колледждегі екі досым жазатайым оқиғадан қайтыс болды.
Dialogue: 0,0:05:31.78,0:05:34.50,Default,,0,0,0,,Жазатайым оқиғалар 20 жастан асқан адамдар өлімінің екінші негізгі себебі болып табылады
Dialogue: 0,0:05:34.58,0:05:36.04,Default,,0,0,0,,Сирек емес
Dialogue: 0,0:05:36.12,0:05:38.00,Default,,0,0,0,,Айтпақшы, бірінші нөмір - суицид.
Dialogue: 0,0:05:38.08,0:05:41.25,Default,,0,0,0,,Бірақ бұл бір күн және бір уақыт.
Dialogue: 0,0:05:42.17,0:05:44.55,Default,,0,0,0,,Біз мүлдем басқа жерде тұрсақ та.
Dialogue: 0,0:05:45.05,0:05:46.63,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:05:47.13,0:05:50.14,Default,,0,0,0,,Камичофуда бір уақытта тағы үш адам болды...
Dialogue: 0,0:05:50.64,0:05:52.10,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:05:52.18,0:05:53.60,Default,,0,0,0,,Бұл жосықсыз.
Dialogue: 0,0:05:53.68,0:05:55.43,Default,,0,0,0,,Өте қызық (Мефисто III) Тыныштық.
Dialogue: 0,0:05:55.52,0:05:59.65,Default,,0,0,0,,Бұл мен мен шайтанның арасындағы оқиғаның басы болды.
Dialogue: 0,0:06:00.81,0:06:04.65,Default,,0,0,0,,Сол күннен бастап мен күнде қорқынышты түс көремін.
Dialogue: 0,0:06:04.73,0:06:07.99,Default,,0,0,0,,Бұл сіздің досыңыздың өліміне қатысты болуы мүмкін деп ойлайсыз ба?
Dialogue: 0,0:06:08.49,0:06:09.53,Default,,0,0,0,,Иә
Dialogue: 0,0:06:11.28,0:06:12.41,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:12.49,0:06:15.33,Default,,0,0,0,,О, Хина-сан, сен ерекше тұтынушысың ба?
Dialogue: 0,0:06:15.41,0:06:16.50,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:06:16.58,0:06:18.29,Default,,0,0,0,,Иә, міне...
Dialogue: 0,0:06:18.37,0:06:20.17,Default,,0,0,0,,Сіздің бөлмеңіз екінші қабатта, солай ма?
Dialogue: 0,0:06:20.25,0:06:21.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:21.58,0:06:22.67,Default,,0,0,0,,Жоқ... у... күте тұрыңыз!
Dialogue: 0,0:06:22.75,0:06:23.38,Default,,0,0,0,,Эй...
Dialogue: 0,0:06:23.46,0:06:24.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:24.21,0:06:25.63,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:06:25.71,0:06:28.26,Default,,0,0,0,,Бұл үйдің құрылымынан көрініп тұр.
Dialogue: 0,0:06:28.34,0:06:29.84,Default,,0,0,0,,О... күте тұрыңыз.
Dialogue: 0,0:06:29.93,0:06:32.01,Default,,0,0,0,,Бұл клиентке дөрекі.
Dialogue: 0,0:06:36.85,0:06:38.02,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:38.10,0:06:40.81,Default,,0,0,0,,Сіз ханымның бөлмесіне рұқсатсыз кіруге қалай батылы барасыз?
Dialogue: 0,0:06:42.36,0:06:43.65,Default,,0,0,0,,Сіз тым қатал болып жатырсыз.
Dialogue: 0,0:06:43.73,0:06:45.90,Default,,0,0,0,,Тым көп қарамаңыз
Dialogue: 0,0:06:45.98,0:06:46.90,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:06:46.98,0:06:49.40,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:06:50.95,0:06:54.41,Default,,0,0,0,,Бұл адам үнемі осылай бола ма?
Dialogue: 0,0:06:54.49,0:06:57.04,Default,,0,0,0,,Мен араласуды жақсы көретін адам емеспін.
Dialogue: 0,0:06:57.54,0:07:00.92,Default,,0,0,0,,Кейде мен клиенттің бөлмесін көргім келеді.
Dialogue: 0,0:07:04.46,0:07:06.38,Default,,0,0,0,,Шай ішесіз бе?
Dialogue: 0,0:07:06.46,0:07:07.59,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:08.09,0:07:09.34,Default,,0,0,0,,Қайғырма.
Dialogue: 0,0:07:09.42,0:07:11.13,Default,,0,0,0,,Маған құймақ ұнайды.
Dialogue: 0,0:07:11.22,0:07:12.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:12.72,0:07:14.80,Default,,0,0,0,,Құймақ шайға жақсы
Dialogue: 0,0:07:14.89,0:07:16.64,Default,,0,0,0,,Ей, сен сондай ақжарқынсың.
Dialogue: 0,0:07:16.72,0:07:19.85,Default,,0,0,0,,Неліктен? Қалағаныңды айтудың несі жаман?
Dialogue: 0,0:07:19.93,0:07:20.73,Default,,0,0,0,,Біреудің үйіне кел
Dialogue: 0,0:07:20.81,0:07:23.56,Default,,0,0,0,,Кенеттен «құймақ жеуге рұқсат етіңіз» деген сөз жоқ.
Dialogue: 0,0:07:23.65,0:07:26.23,Default,,0,0,0,,Хехехе, жақсы.
Dialogue: 0,0:07:26.32,0:07:28.07,Default,,0,0,0,,Құймақтарды тез пісіруге болады.
Dialogue: 0,0:07:28.15,0:07:30.95,Default,,0,0,0,,Құймақ орнына құймақ
Dialogue: 0,0:07:31.03,0:07:32.41,Default,,0,0,0,,Сары май, маргарин емес
Dialogue: 0,0:07:32.99,0:07:34.87,Default,,0,0,0,,Және үйеңкі сиропы
Dialogue: 0,0:07:35.66,0:07:37.70,Default,,0,0,0,,О, сен білмейсің.
Dialogue: 0,0:07:37.79,0:07:40.62,Default,,0,0,0,,Құймақ - құймақ тұқымдасының мүшесі және бір нәрсе.
Dialogue: 0,0:07:40.71,0:07:42.58,Default,,0,0,0,,Сонда сіз, маймыл, гоминид,
Dialogue: 0,0:07:42.67,0:07:44.83,Default,,0,0,0,,Сізді «маймыл» деп атауға бола ма?
Dialogue: 0,0:07:44.92,0:07:45.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:46.00,0:07:47.71,Default,,0,0,0,,Бұл құймақ.
Dialogue: 0,0:07:49.71,0:07:51.09,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:07:51.17,0:07:52.76,Default,,0,0,0,,(құймақ кесу дыбысы)
Dialogue: 0,0:07:54.55,0:07:58.60,Default,,0,0,0,,Дәмді Мен жеген ең жақсы 18-ші нәрсе
Dialogue: 0,0:07:58.68,0:08:00.60,Default,,0,0,0,,Сізді мақтап жатыр ма?
Dialogue: 0,0:08:00.68,0:08:02.10,Default,,0,0,0,,Мен сені мақтаймын Мен сені мақтаймын
Dialogue: 0,0:08:02.19,0:08:05.10,Default,,0,0,0,,Сонымен қатар, бұл керемет 4 деңгейлі стек.
Dialogue: 0,0:08:05.19,0:08:08.27,Default,,0,0,0,,Хина-сан, ол көп жейтіндіктен, осылай көрінеді.
Dialogue: 0,0:08:08.77,0:08:09.73,Default,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:08:09.82,0:08:10.86,Default,,0,0,0,,(Балапанның анасының күлкісі)
Dialogue: 0,0:08:11.44,0:08:13.49,Default,,0,0,0,,Мен сенің атыңды сұрамадым.
Dialogue: 0,0:08:13.57,0:08:16.53,Default,,0,0,0,,Ах... бұл Ичиро Умаки.
Dialogue: 0,0:08:16.62,0:08:18.37,Default,,0,0,0,,Оны «Ібіліс-кун» деп атайды.
Dialogue: 0,0:08:18.87,0:08:20.16,Default,,0,0,0,,Ал бұл...
Dialogue: 0,0:08:22.87,0:08:24.37,Default,,0,0,0,,Менің атым...
Dialogue: 0,0:08:24.46,0:08:31.21,Default,,0,0,0,,Мефистофель III...
Dialogue: 0,0:08:31.71,0:08:33.84,Default,,0,0,0,,Сіз Юко Асанагисіз бе?
Dialogue: 0,0:08:34.34,0:08:37.89,Default,,0,0,0,,Батыс тарихы профессоры Қонақ бөлмеде кітап болды.
Dialogue: 0,0:08:37.97,0:08:40.14,Default,,0,0,0,,Ал, сен білесің бе?
Dialogue: 0,0:08:40.22,0:08:43.27,Default,,0,0,0,,«Патшаның өмірі мен күнәлары» Бұл қызықсыз кітап.
Dialogue: 0,0:08:43.35,0:08:44.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:44.23,0:08:45.81,Default,,0,0,0,,Сіз оны оқыдыңыз ба?
Dialogue: 0,0:08:45.90,0:08:48.23,Default,,0,0,0,,Менің ойымша, түсіну қиын болды.
Dialogue: 0,0:08:48.73,0:08:51.73,Default,,0,0,0,,Ортағасырлық патшалық ұғымы тым жалпақ
Dialogue: 0,0:08:52.24,0:08:55.53,Default,,0,0,0,,Тегіс табақ... Бұл нені білдіреді?
Dialogue: 0,0:08:55.61,0:08:57.87,Default,,0,0,0,,Мысал ретінде Дана Фредерикті алайық.
Dialogue: 0,0:08:58.37,0:09:01.74,Default,,0,0,0,,Кітапта оның реликті жинағы туралы айтасыз...
Dialogue: 0,0:09:01.83,0:09:03.75,Default,,0,0,0,,Анашым, кетіңізші.
Dialogue: 0,0:09:03.83,0:09:05.83,Default,,0,0,0,,Түсіндіруім керек пе?
Dialogue: 0,0:09:05.92,0:09:08.25,Default,,0,0,0,,Мен сізді шақырғаным үшін емес.
Dialogue: 0,0:09:08.33,0:09:12.34,Default,,0,0,0,,Иә, мен балалар арасында онша танымал емес едім.
Dialogue: 0,0:09:12.84,0:09:14.17,Default,,0,0,0,,Екеуің де асықпаңдар.
Dialogue: 0,0:09:14.26,0:09:16.30,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:09:17.72,0:09:19.93,Default,,0,0,0,,Миға қажет қантты ішіп алдым.
Dialogue: 0,0:09:20.43,0:09:22.10,Default,,0,0,0,,Тыңдаймыз ба?
Dialogue: 0,0:09:22.18,0:09:23.22,Default,,0,0,0,,(Хинаның күрсінуі)
Dialogue: 0,0:09:24.10,0:09:26.98,Default,,0,0,0,,Мен досымның жаназасына барған соң білдім.
Dialogue: 0,0:09:27.77,0:09:31.61,Default,,0,0,0,,Қайтыс болған бес адам 14:23-те болған. үш күн бұрын.
Dialogue: 0,0:09:32.78,0:09:36.57,Default,,0,0,0,,Жазатайым оқиғалар, өтіп бара жатқандар, суицид... Өлім себептері әртүрлі
Dialogue: 0,0:09:36.65,0:09:39.62,Default,,0,0,0,,Екеуінен басқасы әртүрлі университеттерде оқыды, ал біреуі жұмыс істейтін ересек адам.
Dialogue: 0,0:09:40.74,0:09:43.49,Default,,0,0,0,,Заттардың бір уақытта кездейсоқ болуы мүмкін бе?
Dialogue: 0,0:09:44.00,0:09:45.20,Default,,0,0,0,,Сөзсіз күдікті
Dialogue: 0,0:09:45.71,0:09:48.33,Default,,0,0,0,,Қалай болғанда да, мен мұқият қарауым керек...
Dialogue: 0,0:09:48.42,0:09:51.13,Default,,0,0,0,,Сонымен, өтемақыға қатысты...
Dialogue: 0,0:10:04.18,0:10:05.52,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:07.60,0:10:08.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:09.94,0:10:10.77,Default,,0,0,0,,Ум...
Dialogue: 0,0:10:11.27,0:10:12.02,Default,,0,0,0,,Жолдан шығыңыз
Dialogue: 0,0:10:12.11,0:10:13.11,Default,,0,0,0,,А... иә
Dialogue: 0,0:10:27.29,0:10:28.46,Default,,0,0,0,,Бар ма?
Dialogue: 0,0:10:28.96,0:10:30.21,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:30.29,0:10:31.38,Default,,0,0,0,,Не?
Dialogue: 0,0:10:31.46,0:10:32.92,Default,,0,0,0,,Онда ештеңе жоқ.
Dialogue: 0,0:10:33.00,0:10:36.09,Default,,0,0,0,,Бұл өте тәтті оқиға.
Dialogue: 0,0:10:39.68,0:10:42.14,Default,,0,0,0,,Мүмкін болса, мұны өзіңізбен бірге алыңыз.
Dialogue: 0,0:10:42.64,0:10:43.47,Default,,0,0,0,,Иә
Dialogue: 0,0:10:43.97,0:10:46.02,Default,,0,0,0,,Осы оқиғаны зерттеп көрейік.
Dialogue: 0,0:10:46.52,0:10:49.35,Default,,0,0,0,,Эй, мен сыйлықты әлі шешкен жоқпын...
Dialogue: 0,0:10:49.44,0:10:50.39,Default,,0,0,0,,Кумия Нурезо — біз сол жігітті артта қалдыра саламыз.
Dialogue: 0,0:10:50.48,0:10:52.36,Default,,0,0,0,,Көріскенше, Хина Чан
Dialogue: 0,0:10:59.11,0:11:03.66,Default,,0,0,0,,(Хинаның ұйықтап жатқан тынысы)
Dialogue: 0,0:11:04.70,0:11:06.16,Default,,0,0,0,,(шу)
Dialogue: 0,0:11:07.37,0:11:08.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:08.66,0:11:11.67,Default,,0,0,0,,(шу)
Dialogue: 0,0:11:16.50,0:11:18.42,Default,,0,0,0,,2 сағат... Ниджу...
Dialogue: 0,0:11:18.51,0:11:20.26,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:21.51,0:11:22.30,Default,,0,0,0,,Ах
Dialogue: 0,0:11:22.39,0:11:25.05,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:11:25.14,0:11:26.43,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:11:27.31,0:11:28.22,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:28.77,0:11:29.48,Default,,0,0,0,,Сен оған көп қиындық көрсеттің ғой, иә?
Dialogue: 0,0:11:29.56,0:11:30.73,Default,,0,0,0,,Мистер Йошитоки
Dialogue: 0,0:11:30.81,0:11:31.85,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:11:31.94,0:11:32.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:32.94,0:11:34.86,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:11:34.94,0:11:36.11,Default,,0,0,0,,Бұл жаңа топ па әлде бірдеңе ме?
Dialogue: 0,0:11:36.19,0:11:38.86,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:11:38.94,0:11:40.86,Default,,0,0,0,,(балапанның қатты тыныс алуы)
Dialogue: 0,0:11:51.96,0:11:54.21,Default,,0,0,0,,Мм... тыңдап тұрсың ба?
Dialogue: 0,0:11:54.71,0:11:56.13,Default,,0,0,0,,Алғашқыда-ақ дұрыс жауап бергенім үшін ашуланып тұрсың ба?
Dialogue: 0,0:11:56.21,0:11:58.75,Default,,0,0,0,,Ал, егер бұл жай ғана арман болса, жақсы емес пе еді?
Dialogue: 0,0:11:58.84,0:12:00.67,Default,,0,0,0,,Бұл арман ғой, солай ма? шынымен
Dialogue: 0,0:12:00.76,0:12:02.43,Default,,0,0,0,,Мен қатты қорқамын
Dialogue: 0,0:12:02.51,0:12:07.85,Default,,0,0,0,,Ал 2:23 оқиға болған кезде...
Dialogue: 0,0:12:09.47,0:12:11.89,Default,,0,0,0,,Сонда ол ақиқат болуы керек.
Dialogue: 0,0:12:13.48,0:12:14.85,Default,,0,0,0,,Егер бұл рас болса
Dialogue: 0,0:12:14.94,0:12:18.61,Default,,0,0,0,,Мүмкін біреу бұл сұрауды тоқтатуға тырысып жатқан шығар.
Dialogue: 0,0:12:19.48,0:12:20.86,Default,,0,0,0,,Мефисто картасы
Dialogue: 0,0:12:22.78,0:12:25.07,Default,,0,0,0,,Біріншіден, бұл Тацуки Ширайши.
Dialogue: 0,0:12:25.16,0:12:28.91,Default,,0,0,0,,Ал, Тацуки Ширайши қай жерде қайтыс болды?
Dialogue: 0,0:12:29.54,0:12:31.66,Default,,0,0,0,,Камичофу 1-чоме...
Dialogue: 0,0:12:31.75,0:12:33.16,Default,,0,0,0,,2/12
Dialogue: 0,0:12:33.25,0:12:34.25,Default,,0,0,0,,Сәлем, үстел!
Dialogue: 0,0:12:34.75,0:12:36.42,Default,,0,0,0,,Хитоми Сагиура
Dialogue: 0,0:12:36.50,0:12:38.17,Default,,0,0,0,,Хюуга Нишино
Dialogue: 0,0:12:38.25,0:12:39.92,Default,,0,0,0,,Сакура Йосикава
Dialogue: 0,0:12:40.00,0:12:41.67,Default,,0,0,0,,Шота Ямамото
Dialogue: 0,0:12:42.30,0:12:44.93,Default,,0,0,0,,Осылай қарасаң, сақинаға ұқсайды.
Dialogue: 0,0:12:45.01,0:12:48.01,Default,,0,0,0,,Мен де алғашында солай ойладым.
Dialogue: 0,0:12:48.10,0:12:49.05,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:50.51,0:12:51.72,Default,,0,0,0,,Пентаграмма
Dialogue: 0,0:12:51.81,0:12:52.93,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:53.02,0:12:57.48,Default,,0,0,0,,Пентаграмма әдетте бойтұмар ретінде қолданылады.
Dialogue: 0,0:12:57.56,0:12:58.73,Default,,0,0,0,,Тұмар?
Dialogue: 0,0:12:58.81,0:12:59.94,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:13:01.28,0:13:02.74,Default,,0,0,0,,Орталықта бір нәрсе
Dialogue: 0,0:13:02.82,0:13:04.99,Default,,0,0,0,,Қорғау ниеті бар
Dialogue: 0,0:13:05.07,0:13:06.99,Default,,0,0,0,,А, міне...
Dialogue: 0,0:13:07.07,0:13:09.07,Default,,0,0,0,,Сізде қандай да бір ой бар ма?
Dialogue: 0,0:13:09.91,0:13:10.99,Default,,0,0,0,,Иә
Dialogue: 0,0:13:11.08,0:13:15.12,Default,,0,0,0,,Бұл менің сол семинардағы досым Ичика Цучияның үйі.
Dialogue: 0,0:13:18.33,0:13:20.42,Default,,0,0,0,,Мефисто Сіз бірдеңе сезінесіз бе?
Dialogue: 0,0:13:20.50,0:13:22.00,Default,,0,0,0,,Десең де…
Dialogue: 0,0:13:22.09,0:13:25.22,Default,,0,0,0,,Аруақты сезгенде шаш тік тұрады дейді.
Dialogue: 0,0:13:25.30,0:13:27.51,Default,,0,0,0,,Мұндай пайдалы қабілет жоқ.
Dialogue: 0,0:13:28.43,0:13:31.14,Default,,0,0,0,,Ичика Цучия мен жәбірленушінің қарым-қатынасы қандай?
Dialogue: 0,0:13:31.22,0:13:34.18,Default,,0,0,0,,Мен Йосикава мырзамен бір бөлімде болсам да.
Dialogue: 0,0:13:34.27,0:13:36.73,Default,,0,0,0,,Менің ойымша, біз мектеп асханасында кездесуге жеткілікті жақынбыз.
Dialogue: 0,0:13:37.23,0:13:40.44,Default,,0,0,0,,Ширайши-кун екеуміз бір шеңбердеміз, бірақ...
Dialogue: 0,0:13:40.52,0:13:41.48,Default,,0,0,0,,Сіз оны қалай тапқаныңызды білсем бола ма?
Dialogue: 0,0:13:41.98,0:13:44.53,Default,,0,0,0,,Бұл шеңберде кейбір жаман өсектер бар.
Dialogue: 0,0:13:45.03,0:13:48.95,Default,,0,0,0,,Ичика Мен соңғы бірнеше күнде міндетті сабақтардың ешқайсысына қатыспадым...
Dialogue: 0,0:13:50.53,0:13:54.16,Default,,0,0,0,,Мүмкін сол шеңбердің кесірінен шығар...
Dialogue: 0,0:13:55.62,0:13:56.41,Default,,0,0,0,,Хмм…
Dialogue: 0,0:13:57.12,0:13:58.96,Default,,0,0,0,,Сондықтан мен тоқтадым...
Dialogue: 0,0:14:00.08,0:14:03.92,Default,,0,0,0,,Ичика деген баланы қорғау үшін бес адам өлтірілді делік.
Dialogue: 0,0:14:04.42,0:14:06.55,Default,,0,0,0,,Күтілгендей, шайтан араласты.
Dialogue: 0,0:14:07.05,0:14:08.51,Default,,0,0,0,,Тергеуге болады
Dialogue: 0,0:14:08.59,0:14:09.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:09.76,0:14:12.30,Default,,0,0,0,,Ертең кешке зертханаға келіңіз.
Dialogue: 0,0:14:12.81,0:14:15.27,Default,,0,0,0,,Ей, күт, шайтан-күн.
Dialogue: 0,0:14:15.35,0:14:17.69,Default,,0,0,0,,А-а... менің арманым ше?
Dialogue: 0,0:14:17.77,0:14:21.23,Default,,0,0,0,,Мен жасаған тұмарды маңдайыңа сал.
Dialogue: 0,0:14:23.69,0:14:26.19,Default,,0,0,0,,Бұл арман ма? Хина Чан не айтты
Dialogue: 0,0:14:26.28,0:14:28.45,Default,,0,0,0,,Жоқ, бұл шындық.
Dialogue: 0,0:14:28.95,0:14:32.28,Default,,0,0,0,,Бұл белгі ме, әлде басқа мағынасы бар ма?
Dialogue: 0,0:14:32.78,0:14:34.87,Default,,0,0,0,,Тұмар пайдалы деп үміттенемін.
Dialogue: 0,0:14:34.95,0:14:38.58,Default,,0,0,0,,Бұл жақсы нәрсе ме, әлде жаман нәрсе ме...
Dialogue: 0,0:14:42.13,0:14:44.25,Default,,0,0,0,,(Хинаның ұйықтап жатқан тынысы)
Dialogue: 0,0:14:44.34,0:14:47.21,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:14:47.92,0:14:51.22,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:14:51.97,0:14:54.97,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:14:59.39,0:15:01.98,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:15:04.73,0:15:06.69,Default,,0,0,0,,Мен армандаған жоқпын
Dialogue: 0,0:15:10.82,0:15:12.99,Default,,0,0,0,,Келесі Хитоми Сагиура
Dialogue: 0,0:15:13.07,0:15:15.78,Default,,0,0,0,,Барлық жерде қалыпты отбасы.
Dialogue: 0,0:15:16.29,0:15:18.29,Default,,0,0,0,,Ешқандай проблема жоқ сияқты.
Dialogue: 0,0:15:18.37,0:15:20.21,Default,,0,0,0,,Қалыпты отбасы дегеніміз не?
Dialogue: 0,0:15:20.29,0:15:23.25,Default,,0,0,0,,Иә? Қалыпты отбасы
Dialogue: 0,0:15:23.83,0:15:28.30,Default,,0,0,0,,Менің әкем мен шешем бар, балаларыммен жақсы араласамын...
Dialogue: 0,0:15:28.38,0:15:30.13,Default,,0,0,0,,Сол анықтамаға сәйкес
Dialogue: 0,0:15:30.22,0:15:32.22,Default,,0,0,0,,Жалғызбасты аналар және баласыз отбасылар
Dialogue: 0,0:15:32.30,0:15:33.68,Default,,0,0,0,,Бұл қалыпты емес дегенді білдіре ме?
Dialogue: 0,0:15:33.76,0:15:34.26,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:34.35,0:15:37.72,Default,,0,0,0,,Сіз өзіңізді қалыпты адаммын деп ойлайсыз ба?
Dialogue: 0,0:15:37.81,0:15:39.48,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:15:41.98,0:15:44.23,Default,,0,0,0,,Әкеңізбен жақында кездестіңіз бе?
Dialogue: 0,0:15:44.90,0:15:47.40,Default,,0,0,0,,Соңғы рет алты ай бұрын кездестік.
Dialogue: 0,0:15:47.48,0:15:49.99,Default,,0,0,0,,Көрмегенімізге жарты жыл болды ма?
Dialogue: 0,0:15:50.49,0:15:51.24,Default,,0,0,0,,Хаа…
Dialogue: 0,0:15:51.32,0:15:54.24,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:15:55.12,0:15:56.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:56.58,0:15:58.66,Default,,0,0,0,,Ах... м...
Dialogue: 0,0:15:58.74,0:16:00.25,Default,,0,0,0,,Шайтан-күн жоқ.
Dialogue: 0,0:16:00.75,0:16:02.50,Default,,0,0,0,,Мефистомен бірге шығу
Dialogue: 0,0:16:03.21,0:16:04.50,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:16:04.58,0:16:07.21,Default,,0,0,0,,Мио Бұл бала Чусуке
Dialogue: 0,0:16:07.29,0:16:08.50,Default,,0,0,0,,(Чусукенің айқайы)
Dialogue: 0,0:16:08.59,0:16:09.88,Default,,0,0,0,,Мысық па?
Dialogue: 0,0:16:11.17,0:16:13.51,Default,,0,0,0,,Мио-чан Ібіліс-кун үшін нені білдіреді?
Dialogue: 0,0:16:13.59,0:16:14.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:14.26,0:16:17.01,Default,,0,0,0,,Ол өте жас кішкентай асқабақ!
Dialogue: 0,0:16:17.51,0:16:18.47,Default,,0,0,0,,«Хиорокудама» дегеніміз не?
Dialogue: 0,0:16:18.56,0:16:22.18,Default,,0,0,0,,Бұл қорлау шығар, бірақ қызық сөз.
Dialogue: 0,0:16:22.27,0:16:23.39,Default,,0,0,0,,Ібіліс-кун
Dialogue: 0,0:16:23.94,0:16:26.73,Default,,0,0,0,,Мені бір кездері «бұзақ» деп атаған.
Dialogue: 0,0:16:26.81,0:16:28.27,Default,,0,0,0,,Бұл «Року» басқа «Року» болып саналады…
Dialogue: 0,0:16:28.36,0:16:29.57,Default,,0,0,0,,Өте тітіркендіргіш!
Dialogue: 0,0:16:29.65,0:16:31.15,Default,,0,0,0,,Жалға алу...
Dialogue: 0,0:16:31.24,0:16:32.53,Default,,0,0,0,,Мен төлеймін мен төлеймін
Dialogue: 0,0:16:32.61,0:16:34.32,Default,,0,0,0,,Мефистоға міндетті түрде төлеңіз
Dialogue: 0,0:16:34.41,0:16:34.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:34.99,0:16:36.66,Default,,0,0,0,,Төлеңіз!
Dialogue: 0,0:16:36.74,0:16:37.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:37.32,0:16:39.49,Default,,0,0,0,,А, сондықтан мен өтінішті қабылдадым.
Dialogue: 0,0:16:39.58,0:16:41.54,Default,,0,0,0,,Бұл жұмыс аяқталғаннан кейін мен сенімдімін...
Dialogue: 0,0:16:41.62,0:16:45.46,Default,,0,0,0,,Мыңжылдық зерттеу институтына не үшін барғыңыз келеді?
Dialogue: 0,0:16:46.79,0:16:48.96,Default,,0,0,0,,Джон До күтіп тұр
Dialogue: 0,0:16:51.05,0:16:51.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:52.84,0:16:54.26,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:16:54.34,0:16:57.89,Default,,0,0,0,,Не, ұстанудың қажеті жоқ па?
Dialogue: 0,0:16:58.39,0:16:58.89,Default,,0,0,0,,Уф
Dialogue: 0,0:16:58.97,0:16:59.64,Default,,0,0,0,,Хмм (Ібіліс-кун)
Dialogue: 0,0:16:59.72,0:17:00.35,Default,,0,0,0,,Хмм (Ібіліс-кун)
Dialogue: 0,0:17:00.43,0:17:01.14,Default,,0,0,0,,Хмм (Ібіліс-кун)
Dialogue: 0,0:17:02.22,0:17:05.73,Default,,0,0,0,,Мефисто: Саған да қиын. Сізді барлық нәрсеге итермелейді.
Dialogue: 0,0:17:06.23,0:17:07.56,Default,,0,0,0,,Миочан
Dialogue: 0,0:17:07.65,0:17:08.15,Default,,0,0,0,,Ах
Dialogue: 0,0:17:08.23,0:17:09.73,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:17:09.82,0:17:10.90,Default,,0,0,0,,Санае-сан
Dialogue: 0,0:17:10.98,0:17:12.28,Default,,0,0,0,,Мио-чан
Dialogue: 0,0:17:12.36,0:17:14.78,Default,,0,0,0,,Шайтан-күнге кедергі жасама.
Dialogue: 0,0:17:14.86,0:17:15.82,Default,,0,0,0,,Ах, Феррис-чан…
Dialogue: 0,0:17:15.90,0:17:18.66,Default,,0,0,0,,Ядорокуға кедергі жасамаңыз.
Dialogue: 0,0:17:18.74,0:17:19.87,Default,,0,0,0,,Ядороку?
Dialogue: 0,0:17:20.37,0:17:22.70,Default,,0,0,0,,Жаңа «Roku» пайда болды
Dialogue: 0,0:17:22.79,0:17:24.41,Default,,0,0,0,,Кездесу аяқталғаннан кейін де, үйге келген соң қылмыскерлерді үкім шығарумен қайта айналысамын.
Dialogue: 0,0:17:24.50,0:17:27.42,Default,,0,0,0,,Мен білмеймін. Бұл фильмде айтылды.
Dialogue: 0,0:17:27.50,0:17:31.13,Default,,0,0,0,,Мио Чан керемет. Ол бәрін біледі.
Dialogue: 0,0:17:31.63,0:17:33.05,Default,,0,0,0,,Енді үйге қайтайық.
Dialogue: 0,0:17:33.13,0:17:35.42,Default,,0,0,0,,Иә...Анашым, сіз тым тәттісіз.
Dialogue: 0,0:17:35.51,0:17:36.72,Default,,0,0,0,,Біз қатал болуымыз керек
Dialogue: 0,0:17:36.80,0:17:39.68,Default,,0,0,0,,Ол жүрегі жылы адам сияқты.
Dialogue: 0,0:17:39.76,0:17:40.68,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:17:40.76,0:17:43.77,Default,,0,0,0,,Санае Одеон театрын қолдайды
Dialogue: 0,0:17:43.85,0:17:47.19,Default,,0,0,0,,Ол сол баланы тәрбиелеу үшін аянбай еңбек етіп жүрген тамаша адам.
Dialogue: 0,0:17:49.02,0:17:50.06,Default,,0,0,0,,Ичика-чан сонда болды.
Dialogue: 0,0:17:50.15,0:17:52.52,Default,,0,0,0,,Тацуки Ширайши шеңбері
Dialogue: 0,0:17:52.61,0:17:54.69,Default,,0,0,0,,Жаман қауесет шын болды.
Dialogue: 0,0:17:54.78,0:17:56.40,Default,,0,0,0,,Солай болса, солай болсын.
Dialogue: 0,0:17:56.49,0:17:59.28,Default,,0,0,0,,Бұл кәдімгі сұмдықтың айласы. Бірінші...
Dialogue: 0,0:17:59.36,0:18:01.03,Default,,0,0,0,,Ей, мәліметтер жақсы.
Dialogue: 0,0:18:01.12,0:18:01.99,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:18:02.08,0:18:04.95,Default,,0,0,0,,Шынымды айтсам, қаншалықты егжей-тегжейлі болса да, қоқыс - қоқыс.
Dialogue: 0,0:18:05.62,0:18:08.54,Default,,0,0,0,,Мен қаттырақ тоқтасам ғой...
Dialogue: 0,0:18:09.04,0:18:11.84,Default,,0,0,0,,Тергеу нәтижесінде біз анықтадық
Dialogue: 0,0:18:11.92,0:18:15.80,Default,,0,0,0,,Хюуга Нишино басқа университетте, бірақ бір шеңберде.
Dialogue: 0,0:18:15.88,0:18:18.38,Default,,0,0,0,,Шота Ямамото оның досы.
Dialogue: 0,0:18:18.47,0:18:22.18,Default,,0,0,0,,Хитоми Сагиураның рөлі – нысананы абайсызда ұстау.
Dialogue: 0,0:18:23.26,0:18:25.93,Default,,0,0,0,,Егер осындай адамдар қалағанын істесе ше?
Dialogue: 0,0:18:26.02,0:18:27.64,Default,,0,0,0,,Барлығын өлтіргіңіз келе ме?
Dialogue: 0,0:18:27.73,0:18:29.77,Default,,0,0,0,,Өлгің келетіні табиғи нәрсе...
Dialogue: 0,0:18:29.85,0:18:32.86,Default,,0,0,0,,Ібіліс-кун, бүгінге осы.
Dialogue: 0,0:18:32.94,0:18:34.48,Default,,0,0,0,,Иә? Неліктен?
Dialogue: 0,0:18:34.98,0:18:36.19,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:18:36.28,0:18:38.11,Default,,0,0,0,,Жарайды, Мефисто-сан.
Dialogue: 0,0:18:38.61,0:18:42.37,Default,,0,0,0,,Цучия мырза Йосикава мырзамен де таныс.
Dialogue: 0,0:18:42.45,0:18:46.54,Default,,0,0,0,,Бұл оның қайтыс болған бес адаммен де байланыста болғанын білдіре ме?
Dialogue: 0,0:18:47.37,0:18:50.54,Default,,0,0,0,,Ичика көптен бері бөлмесінен шықпады.
Dialogue: 0,0:18:50.62,0:18:51.67,Default,,0,0,0,,Біз кездесе аламыз ба?
Dialogue: 0,0:18:52.17,0:18:54.96,Default,,0,0,0,,Иә, егер Хина Чан болса...
Dialogue: 0,0:18:55.46,0:18:57.88,Default,,0,0,0,,Бірақ... сақ болыңыз.
Dialogue: 0,0:18:57.97,0:18:58.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:59.34,0:19:00.59,Default,,0,0,0,,Егер сіз осындай нәрсені айтсаңыз
Dialogue: 0,0:19:00.68,0:19:02.93,Default,,0,0,0,,Мені жарамсыз ана деп атайды ма деп қорқамын.
Dialogue: 0,0:19:03.43,0:19:06.35,Default,,0,0,0,,Соңғы кездері ол қыздан қорқатын болдым...
Dialogue: 0,0:19:07.77,0:19:10.85,Default,,0,0,0,,Ичика Мен осындамын, солай ма?
Dialogue: 0,0:19:13.61,0:19:14.86,Default,,0,0,0,,Ах
Dialogue: 0,0:19:14.94,0:19:16.11,Default,,0,0,0,,Сол дауыс…
Dialogue: 0,0:19:16.19,0:19:17.61,Default,,0,0,0,,Біртүрлі сезіледі.
Dialogue: 0,0:19:17.69,0:19:20.11,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:19:22.28,0:19:24.87,Default,,0,0,0,,Ичика? Жауап бер, Ичика!
Dialogue: 0,0:19:24.95,0:19:26.33,Default,,0,0,0,,Сәлем... жоқ
Dialogue: 0,0:19:26.41,0:19:27.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:27.83,0:19:29.75,Default,,0,0,0,,Ичика, мен оны ашамын.
Dialogue: 0,0:19:30.37,0:19:31.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:32.58,0:19:34.13,Default,,0,0,0,,Хина-чан, абай бол
Dialogue: 0,0:19:36.17,0:19:37.17,Default,,0,0,0,,Артқа тұрыңыз!
Dialogue: 0,0:19:37.67,0:19:39.42,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:19:39.51,0:19:40.38,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:19:40.47,0:19:42.38,Default,,0,0,0,,Не істеу керек? Шайтан-күн
Dialogue: 0,0:19:43.59,0:19:45.14,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:20:19.76,0:20:21.05,Default,,0,0,0,,Сен…
Dialogue: 0,0:20:22.26,0:20:23.84,Default,,0,0,0,,Сіз Ичика-чансыз ба?
Dialogue: 0,0:20:26.51,0:20:27.39,Default,,0,0,0,,Ичика?
Dialogue: 0,0:20:27.47,0:20:28.22,Default,,0,0,0,,Келме!
Dialogue: 0,0:20:28.31,0:20:29.43,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:20:29.51,0:20:30.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:30.77,0:20:34.35,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:20:36.27,0:20:37.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:38.23,0:20:39.15,Default,,0,0,0,,Қаш, қаш!
Dialogue: 0,0:20:39.23,0:20:41.28,Default,,0,0,0,,Қарғыс атсын... бұл қауіпті, шайтан-күн!
Dialogue: 0,0:20:42.28,0:20:44.53,Default,,0,0,0,,(құбыжықтың дауысы)
Dialogue: 0,0:20:46.82,0:20:48.62,Default,,0,0,0,,Сиқырлы күш найзағай...
Dialogue: 0,0:20:48.70,0:20:49.49,Default,,0,0,0,,Кя!
Dialogue: 0,0:20:49.58,0:20:52.29,Default,,0,0,0,,Косей шынымен бұған қол жеткізе ала ма екен?
Dialogue: 0,0:20:52.79,0:20:54.37,Default,,0,0,0,,Мен іздеймін және сотқа беремін.
Dialogue: 0,0:20:55.29,0:20:58.46,Default,,0,0,0,,Мен сізге Потестат Диаболиді беремін
Dialogue: 0,0:21:00.50,0:21:02.51,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:21:10.76,0:21:12.85,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:21:12.93,0:21:13.64,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:21:14.14,0:21:16.02,Default,,0,0,0,,Бұл заклинание тиімді.
Dialogue: 0,0:21:16.10,0:21:17.81,Default,,0,0,0,,Сиқырлы абсолютті нөл!
Dialogue: 0,0:21:17.90,0:21:22.57,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:21:24.15,0:21:24.99,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:21:25.49,0:21:26.70,Default,,0,0,0,,Біреуін ала аламын ба?
Dialogue: 0,0:21:26.78,0:21:28.95,Default,,0,0,0,,Абсолюттік нөл – асыра сілтеу
Dialogue: 0,0:21:29.45,0:21:30.66,Default,,0,0,0,,Шу!
Dialogue: 0,0:21:31.79,0:21:33.00,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:21:33.08,0:21:35.21,Default,,0,0,0,,Бұл абсолютті нөл емес.
Dialogue: 0,0:21:35.29,0:21:36.08,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:21:37.08,0:21:37.79,Default,,0,0,0,,Не? Эй!
Dialogue: 0,0:21:38.38,0:21:39.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:41.13,0:21:41.63,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:21:41.71,0:21:43.09,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:21:54.56,0:21:55.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:04.03,0:22:06.03,Default,,0,0,0,,♪～
Dialogue: 0,0:24:01.89,0:24:03.90,Default,,0,0,0,,～♪
Dialogue: 0,0:24:05.40,0:24:11.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory