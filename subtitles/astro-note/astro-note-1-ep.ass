Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:23:49.99,0:23:54.87,Default,,0,0,0,,Бұл субтитр көзі сатып алу, оқу және алмасу үшін субтитрлерді қамтамасыз ету үшін пайдаланылады және коммерциялық пайдалануға тыйым салынады.
Dialogue: 0,0:23:49.99,0:23:54.87,Default,,0,0,0,,...
Dialogue: 0,0:23:54.87,0:24:00.00,Default,,0,0,0,,B @
Dialogue: 0,0:23:54.87,0:24:00.00,Default,,0,0,0,,Сценарий: Асо Аудармасы: Йоа Нагиса Уақыты: Фойзи жүйесі: Юки Юки
Dialogue: 0,0:01:18.64,0:01:20.98,Default,,0,0,0,,«Астро»
Dialogue: 0,0:01:22.15,0:01:23.83,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:01:32.70,0:01:33.58,Default,,0,0,0,,Жарайды
Dialogue: 0,0:01:42.65,0:01:43.88,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:01:45.96,0:01:47.31,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:02:02.32,0:02:04.45,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:02:10.78,0:02:11.69,Default,,0,0,0,,Иә
Dialogue: 0,0:02:19.66,0:02:21.25,Default,,0,0,0,,тармақ
Dialogue: 0,0:02:21.25,0:02:23.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:23.04,0:02:24.04,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:24.04,0:02:26.44,Default,,0,0,0,,Мен шатырды тазалап жатқанда
Dialogue: 0,0:02:26.44,0:02:30.34,Default,,0,0,0,,Баспалдақпен жануарға ұқсайтын бір нәрсе соғылды.
Dialogue: 0,0:02:30.34,0:02:31.73,Default,,0,0,0,,Сіз оны көрмедіңіз бе?
Dialogue: 0,0:02:31.73,0:02:33.08,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:34.08,0:02:35.38,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:02:42.98,0:02:46.15,Default,,0,0,0,,Бұл мейрамхана емес пе?
Dialogue: 0,0:02:46.15,0:02:47.11,Default,,0,0,0,,Мейрамхана?
Dialogue: 0,0:02:48.36,0:02:50.98,Default,,0,0,0,,Бұл сұхбат алуға келген Такуми Миясака.
Dialogue: 0,0:02:52.65,0:02:55.02,Default,,0,0,0,,Біз бас аспазшы іздейміз.
Dialogue: 0,0:02:56.73,0:02:59.74,Default,,0,0,0,,Парк Гранд қонақүйінде аспаз болып жұмыс істедіңіз бе?
Dialogue: 0,0:03:00.73,0:03:02.91,Default,,0,0,0,,Бас аспазды жұмысқа қабылдау
Dialogue: 0,0:03:02.91,0:03:05.49,Default,,0,0,0,,Сіз қандай жұмыс туралы хабарландыру жібердіңіз?
Dialogue: 0,0:03:06.30,0:03:07.16,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:03:10.54,0:03:12.88,Default,,0,0,0,,...
Dialogue: 0,0:03:12.88,0:03:15.11,Default,,0,0,0,,«Бас аспазды жұмысқа алу»
Dialogue: 0,0:03:15.11,0:03:17.96,Default,,0,0,0,,«Таңғы ас швед үстелі де бар».
Dialogue: 0,0:03:18.90,0:03:21.61,Default,,0,0,0,,«Тапсырма мазмұны Пісіру мәзірін әзірлеу»
Dialogue: 0,0:03:21.61,0:03:24.23,Default,,0,0,0,,«Тамақ өнімдерінің қауіпсіздігі мен гигиенасын мұқият басқару»
Dialogue: 0,0:03:24.23,0:03:26.02,Default,,0,0,0,,«Шығындар мен P&L басқару»
Dialogue: 0,0:03:26.02,0:03:27.93,Default,,0,0,0,,«Жылдық бюджетті құру және т.б.»
Dialogue: 0,0:03:27.93,0:03:30.15,Default,,0,0,0,,Ол қашан акционерлік қоғам болды?
Dialogue: 0,0:03:30.15,0:03:32.15,Default,,0,0,0,,Фото Бұл ғимарат осы жер емес пе?
Dialogue: 0,0:03:32.15,0:03:34.40,Default,,0,0,0,,Сіз жиі өтірік айтасыз.
Dialogue: 0,0:03:34.94,0:03:36.82,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:03:37.62,0:03:41.66,Default,,0,0,0,,Мен не жазарымды білмедім, сондықтан
Dialogue: 0,0:03:41.66,0:03:45.67,Default,,0,0,0,,Аспаз іздейтін басқа адамдарға хабарласыңыз.
Dialogue: 0,0:03:45.67,0:03:46.94,Default,,0,0,0,,Маған көрсет
Dialogue: 0,0:03:46.94,0:03:48.29,Default,,0,0,0,,Бұл толық плагиат.
Dialogue: 0,0:03:48.29,0:03:49.62,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:03:49.62,0:03:52.48,Default,,0,0,0,,Бұл жақсы емес. Бұл сізді JARO сотқа алатындай деңгейде.
Dialogue: 0,0:03:52.48,0:03:55.51,Default,,0,0,0,,Ум...бұл нені білдіреді?
Dialogue: 0,0:03:57.27,0:03:59.55,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:02.39,0:04:07.01,Default,,0,0,0,,Бұл таңғы ас қосылған Astoroso пәтері
Dialogue: 0,0:04:07.01,0:04:08.59,Default,,0,0,0,,Таңғы ас кіреді…
Dialogue: 0,0:04:09.81,0:04:14.57,Default,,0,0,0,,Маған таңғы ас әзірлеп беретін бұрынғы үй иесі дүниеден өтті.
Dialogue: 0,0:04:14.57,0:04:19.22,Default,,0,0,0,,Сосын жаңа үй иесі болып мына Мира-сан кірді.
Dialogue: 0,0:04:19.22,0:04:22.58,Default,,0,0,0,,Менің жасаған тағамым өте нашар.
Dialogue: 0,0:04:22.58,0:04:23.58,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:04:24.34,0:04:25.32,Default,,0,0,0,,үшін
Dialogue: 0,0:04:25.32,0:04:26.51,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:04:26.51,0:04:27.61,Default,,0,0,0,,жасалды
Dialogue: 0,0:04:27.61,0:04:29.16,Default,,0,0,0,,Таңғы ас
Dialogue: 0,0:04:29.16,0:04:30.58,Default,,0,0,0,,Мен мұның не екенін білемін.
Dialogue: 0,0:04:31.28,0:04:34.48,Default,,0,0,0,,Судзико күріш шарлары
Dialogue: 0,0:04:35.39,0:04:39.33,Default,,0,0,0,,Егер мен лосось болсам, баламның жасаған ісі үшін кек алуға келер едім.
Dialogue: 0,0:04:39.33,0:04:41.38,Default,,0,0,0,,Айтайын дегенім, басыңызды көтеріңіз.
Dialogue: 0,0:04:41.38,0:04:43.43,Default,,0,0,0,,Біз өте өкінеміз.
Dialogue: 0,0:04:43.86,0:04:47.81,Default,,0,0,0,,Парк Гранд туралы айтатын болсақ, бұл жақында банкротқа ұшыраған орын.
Dialogue: 0,0:04:47.81,0:04:51.77,Default,,0,0,0,,Сіз 25 жаста жұмыссызсыз ба? Жұмыссыз болу бос уақытыңыз бар дегенді білдіреді.
Dialogue: 0,0:04:51.77,0:04:55.09,Default,,0,0,0,,Рен Жұмыссыз адамдарға «жұмыссыз, жұмыссыз» демеңіз.
Dialogue: 0,0:04:55.09,0:04:55.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:55.77,0:04:58.78,Default,,0,0,0,,Жұмыссыз адамдар сезімтал, сондықтан оларға мейірімді болыңыз.
Dialogue: 0,0:04:59.67,0:05:02.25,Default,,0,0,0,,Бұл тамаша ортақ үй.
Dialogue: 0,0:05:02.25,0:05:03.56,Default,,0,0,0,,Бұл да байланыстың бір түрі.
Dialogue: 0,0:05:03.56,0:05:07.29,Default,,0,0,0,,Менің ойымша, сіз осындай жерде жұмыс істейтін өміріңіз жақсы болар еді.
Dialogue: 0,0:05:08.54,0:05:10.81,Default,,0,0,0,,Тез жұмыс істемесең солай болады
Dialogue: 0,0:05:10.81,0:05:13.50,Default,,0,0,0,,Менің әкем қатал жұмыссыз адам.
Dialogue: 0,0:05:14.67,0:05:16.93,Default,,0,0,0,,үшін дөрекі емес пе?
Dialogue: 0,0:05:16.93,0:05:20.20,Default,,0,0,0,,Жоқ, жоқ, бұл жұмысты ұсынғаныңыз дөрекі.
Dialogue: 0,0:05:20.20,0:05:23.51,Default,,0,0,0,,Мм...бұл адамдар ше?
Dialogue: 0,0:05:24.38,0:05:26.50,Default,,0,0,0,,Асторо манорының тұрғындары...
Dialogue: 0,0:05:26.50,0:05:30.02,Default,,0,0,0,,Мира ұйымдастырған таңғы ас құрбандары тобы
Dialogue: 0,0:05:30.02,0:05:33.99,Default,,0,0,0,,Мен мұнда тұру үшін таңғы ас қосылған жағдайда жалдау ақысын төлеймін.
Dialogue: 0,0:05:33.99,0:05:35.90,Default,,0,0,0,,Тиісті таңғы ас жоқ
Dialogue: 0,0:05:36.20,0:05:41.57,Default,,0,0,0,,Сондықтан біз аспазшы жалдауды талап етеміз.
Dialogue: 0,0:05:41.57,0:05:44.12,Default,,0,0,0,,Таңғы асты жақсылап ішсін.
Dialogue: 0,0:05:44.12,0:05:45.83,Default,,0,0,0,,Мені тамақтандыр
Dialogue: 0,0:05:45.83,0:05:47.74,Default,,0,0,0,,Өскенім үшін айып етпе.
Dialogue: 0,0:05:47.74,0:05:48.97,Default,,0,0,0,,Аты жоқ.
Dialogue: 0,0:05:48.97,0:05:50.76,Default,,0,0,0,,Қуырылған гарнир Қарама-қарсы
Dialogue: 0,0:05:50.76,0:05:52.06,Default,,0,0,0,,Қарсы болды
Dialogue: 0,0:05:49.51,0:05:52.03,Default,,0,0,0,,Уайымдауды доғарыңыз.
Dialogue: 0,0:05:52.03,0:05:54.03,Default,,0,0,0,,Миясака мырза таңғалады.
Dialogue: 0,0:05:55.35,0:05:58.98,Default,,0,0,0,,Мұның бәрі менің қателігім. Мен шынымен кешірім сұраймын.
Dialogue: 0,0:05:59.59,0:06:00.53,Default,,0,0,0,,Ум...
Dialogue: 0,0:06:00.53,0:06:01.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:03.04,0:06:04.17,Default,,0,0,0,,Скумбрия…
Dialogue: 0,0:06:04.97,0:06:09.47,Default,,0,0,0,,Мен осыған қызығатынмын, бұл скумбрия емес пе?
Dialogue: 0,0:06:09.85,0:06:11.08,Default,,0,0,0,,Міне, не болғаны
Dialogue: 0,0:06:11.08,0:06:11.97,Default,,0,0,0,,Иә
Dialogue: 0,0:06:15.39,0:06:16.77,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:06:17.44,0:06:20.78,Default,,0,0,0,,Көршім балық аулауға кеткендіктен алдым.
Dialogue: 0,0:06:20.78,0:06:23.61,Default,,0,0,0,,Оны осылай қалдырсаңыз, ол тез бұзылады.
Dialogue: 0,0:06:23.61,0:06:25.01,Default,,0,0,0,,Тамақты дайындаймыз ба?
Dialogue: 0,0:06:25.01,0:06:26.54,Default,,0,0,0,,Қуырылған скумбрия жегім келеді
Dialogue: 0,0:06:26.54,0:06:27.40,Default,,0,0,0,,Біз мұны жасаймыз ба?
Dialogue: 0,0:06:27.40,0:06:28.34,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:06:28.34,0:06:29.66,Default,,0,0,0,,Бұл жаман
Dialogue: 0,0:06:29.66,0:06:33.04,Default,,0,0,0,,Жаман емес Жаман емес Мүлдем жаман емес
Dialogue: 0,0:06:33.04,0:06:37.25,Default,,0,0,0,,«Материалды өлтіруші» деген лақап аты бар Мира-санға тапсыра алмаймын.
Dialogue: 0,0:07:09.53,0:07:11.69,Default,,0,0,0,,Келіңіздер, рахат алыңыз!
Dialogue: 0,0:07:11.69,0:07:13.75,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:07:16.48,0:07:17.63,Default,,0,0,0,,Құдай
Dialogue: 0,0:07:20.04,0:07:21.59,Default,,0,0,0,,Дәмді
Dialogue: 0,0:07:36.34,0:07:40.42,Default,,0,0,0,,үшін маған «тамақ жасай алатын адамды ал» деді.
Dialogue: 0,0:07:40.42,0:07:42.66,Default,,0,0,0,,Мен оны қатты ұнатпадым.
Dialogue: 0,0:07:42.66,0:07:45.00,Default,,0,0,0,,Осындай дәмді таңғы асты жей алсам ғой
Dialogue: 0,0:07:45.00,0:07:46.65,Default,,0,0,0,,Мен күнде бақыттымын
Dialogue: 0,0:07:53.15,0:07:55.63,Default,,0,0,0,,Мира-сан, сенің жігітің жоқ сияқты.
Dialogue: 0,0:07:55.63,0:07:58.61,Default,,0,0,0,,Мен тамақ жасай алатын адамды жалдасам, олардың көңілдері қалатынына сенімдімін.
Dialogue: 0,0:07:58.61,0:07:59.51,Default,,0,0,0,,Бұл қызықсыз.
Dialogue: 0,0:07:59.51,0:08:01.51,Default,,0,0,0,,Сіз оны міндетті түрде аласыз
Dialogue: 0,0:08:01.51,0:08:06.26,Default,,0,0,0,,Тесік, тесігі, тесігі, тесігі, тесігі, тесігі...
Dialogue: 0,0:08:08.77,0:08:12.16,Default,,0,0,0,,Мені көру үшін келгеніңіз үшін кешіріңіз.
Dialogue: 0,0:08:12.16,0:08:13.76,Default,,0,0,0,,Оң қолымен теңдеулерді шешіп отыр
Dialogue: 0,0:08:13.76,0:08:16.02,Default,,0,0,0,,Қуырылған скумбрия Ас үшін рахмет
Dialogue: 0,0:08:16.02,0:08:19.67,Default,,0,0,0,,Мен Миясака мырзаның жақын арада жұмыс табатынына сенімдімін.\NМен бұл
Dialogue: 0,0:08:20.65,0:08:22.77,Default,,0,0,0,,деп үміттенемін ...
Dialogue: 0,0:08:22.77,0:08:25.78,Default,,0,0,0,,Бүгінгі күн үшін рахмет.
Dialogue: 0,0:08:26.09,0:08:27.40,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:42.15,0:08:43.75,Default,,0,0,0,,Сіз бір нәрсені ұмыттыңыз ба?
Dialogue: 0,0:08:43.75,0:08:45.05,Default,,0,0,0,,(Стефани) Ха! (Сора) Алданып қалдың.
Dialogue: 0,0:08:46.67,0:08:49.47,Default,,0,0,0,,Мен сенің таңғы асыңды дайындаймын.
Dialogue: 0,0:09:03.64,0:09:06.11,Default,,0,0,0,,Жүк үшін осы.
Dialogue: 0,0:09:06.11,0:09:08.18,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:09:08.18,0:09:09.85,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:09:11.15,0:09:13.99,Default,,0,0,0,,Миясака мырза, сіз қозғалуды аяқтадыңыз ба?
Dialogue: 0,0:09:14.84,0:09:15.91,Default,,0,0,0,,енді ғана
Dialogue: 0,0:09:16.70,0:09:18.79,Default,,0,0,0,,Бас жақсысың ба?
Dialogue: 0,0:09:19.43,0:09:22.29,Default,,0,0,0,,Иә, мен қазір толықтай жақсымын.
Dialogue: 0,0:09:22.29,0:09:24.88,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:09:24.88,0:09:28.05,Default,,0,0,0,,Наосуке соншалықты қатыгез емес.
Dialogue: 0,0:09:28.05,0:09:30.88,Default,,0,0,0,,Мүмкін менің көңіл-күйім жайсыз болған шығар.
Dialogue: 0,0:09:30.88,0:09:32.57,Default,,0,0,0,,Құрметпен, Наосуке
Dialogue: 0,0:09:34.74,0:09:36.75,Default,,0,0,0,,Осы жерде болды. Осы жерде болды
Dialogue: 0,0:09:36.75,0:09:37.92,Default,,0,0,0,,Наосуке
Dialogue: 0,0:09:39.17,0:09:41.31,Default,,0,0,0,,Серуенге шығайық.
Dialogue: 0,0:09:41.31,0:09:42.79,Default,,0,0,0,,Мен әрқашан кешірім сұраймын
Dialogue: 0,0:09:42.79,0:09:44.85,Default,,0,0,0,,(Косей) Сен балалармен тез тіл табысасың ғой, иә?
Dialogue: 0,0:09:44.85,0:09:47.39,Default,,0,0,0,,Менің серуендеуден кейін.
Dialogue: 0,0:09:48.51,0:09:49.91,Default,,0,0,0,,Бүгіннен бастап?
Dialogue: 0,0:09:49.91,0:09:52.73,Default,,0,0,0,,Иә, 5-бөлмеге барыңыз...
Dialogue: 0,0:09:52.73,0:09:56.95,Default,,0,0,0,,Мен сіздің түйіндемеңізді қарап шықтым, сондықтан мен сіз туралы көп нәрсені білемін.
Dialogue: 0,0:09:57.89,0:10:00.29,Default,,0,0,0,,Мира-сан, бүгін кешке сәлемдесу кеші бар.
Dialogue: 0,0:10:00.29,0:10:02.06,Default,,0,0,0,,Сәлемдесу кеші?
Dialogue: 0,0:10:02.06,0:10:05.25,Default,,0,0,0,,Жаңа келгендерді қарсы алуға арналған жиналыс
Dialogue: 0,0:10:05.25,0:10:07.48,Default,,0,0,0,,Мен де Мирамен жасаған шығармын.
Dialogue: 0,0:10:07.48,0:10:08.50,Default,,0,0,0,,(Қыңқыл) Бірақ қазір менде қорқыныштың бір ұшқыны да жоқ
Dialogue: 0,0:10:08.50,0:10:12.01,Default,,0,0,0,,Олай болса, Наосуке, серуендеуге барайық.
Dialogue: 0,0:10:12.01,0:10:13.54,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:10:15.39,0:10:18.19,Default,,0,0,0,,2-бөлмеде тұратын Масакичи Ямашита мырза
Dialogue: 0,0:10:18.19,0:10:21.13,Default,,0,0,0,,Мен бұл пәтерде ең ұзақ тұрдым.
Dialogue: 0,0:10:21.13,0:10:23.69,Default,,0,0,0,,Мен оның романшы екеніне сенімдімін.
Dialogue: 0,0:10:24.22,0:10:27.35,Default,,0,0,0,,Ой, қандай шығарма жазып жатырсың?
Dialogue: 0,0:10:28.29,0:10:30.49,Default,,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:10:32.18,0:10:35.82,Default,,0,0,0,,«Ямата Шокичи романы»
Dialogue: 0,0:10:38.26,0:10:40.81,Default,,0,0,0,,Ешқандай ақпарат шықпайды.
Dialogue: 0,0:10:40.81,0:10:42.72,Default,,0,0,0,,Шын есіміңізді жазбаған шығарсыз.
Dialogue: 0,0:10:43.63,0:10:45.61,Default,,0,0,0,,Бұл сізге ақпарат бере ме?
Dialogue: 0,0:10:45.61,0:10:47.61,Default,,0,0,0,,үшіннда бар, солай ма?
Dialogue: 0,0:10:47.61,0:10:49.61,Default,,0,0,0,,Сізде смартфон жоқ па?
Dialogue: 0,0:10:49.61,0:10:50.81,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:10:50.81,0:10:52.81,Default,,0,0,0,,Оны смартфон деп атайды.
Dialogue: 0,0:10:56.92,0:10:58.22,Default,,0,0,0,,Қайтадан кездескеніме қуаныштымын
Dialogue: 0,0:10:58.78,0:11:03.84,Default,,0,0,0,,Менің атым Мира Готокуджи, мен үй иесі болғаныма үш ай ғана болды.
Dialogue: 0,0:11:03.84,0:11:06.98,Default,,0,0,0,,Бұл сізге тудыруы мүмкін кез келген қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:11:06.98,0:11:08.98,Default,,0,0,0,,Бес бос дәптер парағы
Dialogue: 0,0:11:11.77,0:11:14.04,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:11:23.73,0:11:27.87,Default,,0,0,0,,Бұл жер бастапқыда ``Асунаросо'' деп аталса керек.
Dialogue: 0,0:11:28.28,0:11:31.54,Default,,0,0,0,,Мен білмей тұрып, «на» таңбасы «t» болды.
Dialogue: 0,0:11:31.54,0:11:34.18,Default,,0,0,0,,үшін оны «Астро-со» деп атай бастады.
Dialogue: 0,0:11:34.18,0:11:36.73,Default,,0,0,0,,«Асу Торо-сода» құрылды.
Dialogue: 0,0:11:36.73,0:11:37.97,Default,,0,0,0,,Иә
Dialogue: 0,0:11:37.97,0:11:40.97,Default,,0,0,0,,Мен Масакичи мырзадан да естідім.
Dialogue: 0,0:11:42.51,0:11:44.63,Default,,0,0,0,,Ауа райы жақсы.
Dialogue: 0,0:11:44.63,0:11:47.23,Default,,0,0,0,,Кірді кептіргенде, осы жерде кептіріңіз.
Dialogue: 0,0:11:47.23,0:11:50.77,Default,,0,0,0,,Бірінші қабатта бір, екінші қабатта бір дәретхана бар.
Dialogue: 0,0:11:51.24,0:11:52.84,Default,,0,0,0,,Екі кір жуғыш машина
Dialogue: 0,0:11:52.84,0:11:57.74,Default,,0,0,0,,Машинаны пайдаланған кезде оның ішінде кір қалдырмаңыз.
Dialogue: 0,0:11:58.19,0:11:59.74,Default,,0,0,0,,Бұл жуынатын бөлме.
Dialogue: 0,0:12:00.17,0:12:04.64,Default,,0,0,0,,Алайда тұрғындардың көбі жақын маңдағы қоғамдық моншаға баратын көрінеді.
Dialogue: 0,0:12:05.75,0:12:10.69,Default,,0,0,0,,Ваннаға түскенде мына бір белгіні міндетті түрде осында іліп қойыңыз.
Dialogue: 0,0:12:11.34,0:12:13.24,Default,,0,0,0,,Бұл жертөле ме?
Dialogue: 0,0:12:13.24,0:12:14.09,Default,,0,0,0,,Иә
Dialogue: 0,0:12:22.31,0:12:23.81,Default,,0,0,0,,Бұл қойма.
Dialogue: 0,0:12:23.81,0:12:27.43,Default,,0,0,0,,Мұның бәрі үйде жасалған ба? Бұл керемет.
Dialogue: 0,0:12:27.43,0:12:30.92,Default,,0,0,0,,Оны бұрынғы үй иесі сақтаған.
Dialogue: 0,0:12:30.92,0:12:35.07,Default,,0,0,0,,Бұл таңғажайып винтажды қара өрік шарабы ма?
Dialogue: 0,0:12:35.07,0:12:37.47,Default,,0,0,0,,Бұл жеуге болатын нәрсе ме?
Dialogue: 0,0:12:38.15,0:12:40.24,Default,,0,0,0,,Сіз қара өрік шарабы қолданып көрдіңіз бе?
Dialogue: 0,0:12:40.24,0:12:41.66,Default,,0,0,0,,Бұл сусын ба?
Dialogue: 0,0:12:44.61,0:12:46.44,Default,,0,0,0,,Ал мынау ас үй
Dialogue: 0,0:12:46.44,0:12:48.67,Default,,0,0,0,,Сіз мұны бұрыннан білесіз бе?
Dialogue: 0,0:12:51.04,0:12:54.59,Default,,0,0,0,,Оларға жазылған бөлме нөмірлері тұрғындарға тиесілі.
Dialogue: 0,0:12:55.11,0:12:58.59,Default,,0,0,0,,Таңғы ас дүйсенбіден жұмаға дейін беріледі, сенбі және жексенбі күндері жабық.
Dialogue: 0,0:12:59.23,0:13:02.89,Default,,0,0,0,,Егер сіз оны 7:30 мен 8:30 арасында жасай алсаңыз, өтінемін
Dialogue: 0,0:13:02.89,0:13:05.10,Default,,0,0,0,,Әркім өз қалауынша жейді.
Dialogue: 0,0:13:05.65,0:13:08.69,Default,,0,0,0,,Материалдық құны бір адамға шамамен 250 иенді құрайды.
Dialogue: 0,0:13:08.69,0:13:11.10,Default,,0,0,0,,Әзірге мұнда 2 апталық баға енгізілген.
Dialogue: 0,0:13:13.82,0:13:15.61,Default,,0,0,0,,Бұл шкафтың кілті
Dialogue: 0,0:13:18.19,0:13:21.70,Default,,0,0,0,,Тек менде және Миясака мырзада ғана бар.
Dialogue: 0,0:13:22.37,0:13:25.10,Default,,0,0,0,,Менің ойымша, бұл дұрыс.
Dialogue: 0,0:13:25.81,0:13:29.58,Default,,0,0,0,,Егер сіз бірдеңе түсінбесеңіз, маған кез келген нәрсені сұрауға болады.
Dialogue: 0,0:13:30.86,0:13:32.61,Default,,0,0,0,,7×8 ше?
Dialogue: 0,0:13:32.61,0:13:33.93,Default,,0,0,0,,５６？
Dialogue: 0,0:13:37.07,0:13:38.46,Default,,0,0,0,,Жоқ, бірақ Йор-чан менің байқамай тұрғанымда үйленіп кеткеніне сенбеймін.
Dialogue: 0,0:13:38.46,0:13:39.82,Default,,0,0,0,,Математикадан үйге тапсырма
Dialogue: 0,0:13:39.82,0:13:41.14,Default,,0,0,0,,Осындай жерде?
Dialogue: 0,0:13:41.14,0:13:45.47,Default,,0,0,0,,Қонақ бөлмеде оқу сізді ақылды етеді деп ата-аналар кітабында жазылған.
Dialogue: 0,0:13:49.15,0:13:50.18,Default,,0,0,0,,Не?
Dialogue: 0,0:13:51.72,0:13:53.81,Default,,0,0,0,,Сәлем, у... бүгіннен бастап...
Dialogue: 0,0:13:55.94,0:13:59.26,Default,,0,0,0,,Бұл тағы бір сәтсіз тыңдау.
Dialogue: 0,0:14:02.75,0:14:04.26,Default,,0,0,0,,Тыңдау?
Dialogue: 0,0:14:05.81,0:14:07.83,Default,,0,0,0,,Ол Террун.
Dialogue: 0,0:14:07.83,0:14:09.19,Default,,0,0,0,,Террун?
Dialogue: 0,0:14:09.19,0:14:10.53,Default,,0,0,0,,Эй
Dialogue: 0,0:14:15.57,0:14:18.49,Default,,0,0,0,,Жоқ...жоқ Мм...бұл...
Dialogue: 0,0:14:20.15,0:14:21.13,Default,,0,0,0,,Бұл
Dialogue: 0,0:14:21.13,0:14:23.18,Default,,0,0,0,,Мынау, сол адам...
Dialogue: 0,0:14:23.18,0:14:25.46,Default,,0,0,0,,Ұрланған уыты төмен сыра
Dialogue: 0,0:14:25.46,0:14:27.97,Default,,0,0,0,,Мен оны бір бөтелке сырамен қайтарамын.
Dialogue: 0,0:14:27.97,0:14:30.50,Default,,0,0,0,,...
Dialogue: 0,0:14:30.50,0:14:31.73,Default,,0,0,0,,Терурурурун
Dialogue: 0,0:14:31.73,0:14:33.08,Default,,0,0,0,,Террунруна
Dialogue: 0,0:14:33.08,0:14:34.40,Default,,0,0,0,,Терурунрунун
Dialogue: 0,0:14:34.40,0:14:36.28,Default,,0,0,0,,Теккен тістеп алды
Dialogue: 0,0:14:36.28,0:14:39.58,Default,,0,0,0,,...
Dialogue: 0,0:14:39.58,0:14:42.03,Default,,0,0,0,,Таза таза сүйкімді оң жақ ілмек
Dialogue: 0,0:14:42.42,0:14:47.28,Default,,0,0,0,,Қыз баланың жүрегі күрделі.
Dialogue: 0,0:14:47.28,0:14:49.96,Default,,0,0,0,,Таза таза сүйкімді оң жақ ілмек
Dialogue: 0,0:14:49.96,0:14:52.76,Default,,0,0,0,,Таза таза сүйкімді оң жақ ілмек
Dialogue: 0,0:14:52.76,0:14:57.94,Default,,0,0,0,,Менің сезімімді қабылдаңыз
Dialogue: 0,0:14:57.94,0:15:00.23,Default,,0,0,0,,Оң жақ ілмек Оң жақ ілмек
Dialogue: 0,0:15:00.23,0:15:02.89,Default,,0,0,0,,Оң жақ оң оң оң жақ ілмек
Dialogue: 0,0:14:48.43,0:14:53.24,Default,,0,0,0,,6-бөлмедегі Мацубара-чан – Террун есімді жер асты пұт.
Dialogue: 0,0:14:53.24,0:14:54.66,Default,,0,0,0,,Жер астындағы пұт?
Dialogue: 0,0:14:54.66,0:14:56.66,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,0:14:56.66,0:14:57.91,Default,,0,0,0,,Жоқ, бұл жаман.
Dialogue: 0,0:14:57.91,0:15:01.60,Default,,0,0,0,,Бұл Мияшита-кунның қарсы алу кеші еді, бірақ ол маған сусын сатып алды.
Dialogue: 0,0:15:01.60,0:15:06.01,Default,,0,0,0,,Мен Миясакамын... дәлірек айтсам, сенің кесіріңнен бірдеңе сатып алуға тура келді.
Dialogue: 0,0:15:08.28,0:15:09.14,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:15:09.14,0:15:13.35,Default,,0,0,0,,Алдымен айтайын, егер сіз мен туралы SNS сайтында пост жазсаңыз, мен сізді сотқа беремін.
Dialogue: 0,0:15:13.35,0:15:17.70,Default,,0,0,0,,Мен Эгосаның жынымын, сондықтан кез келген постты таба аламын. Түсінесіз бе?
Dialogue: 0,0:15:17.70,0:15:18.40,Default,,0,0,0,,Иә
Dialogue: 0,0:15:18.93,0:15:20.42,Default,,0,0,0,,Жаңа ән қалай болды?
Dialogue: 0,0:15:20.42,0:15:21.71,Default,,0,0,0,,онда Цуки-кунге қатысты күдік мүлде сейіледі.
Dialogue: 0,0:15:21.71,0:15:23.49,Default,,0,0,0,,Мацубара-сан шынымен де керемет
Dialogue: 0,0:15:23.49,0:15:26.78,Default,,0,0,0,,Мен ешқашан мұндай нәрсені көпшілік алдында жасай алмас едім, өйткені мен ұятқа қалатын едім.
Dialogue: 0,0:15:26.78,0:15:27.86,Default,,0,0,0,,Сіз жекпе-жекті сатасыз ба?
Dialogue: 0,0:15:27.86,0:15:29.25,Default,,0,0,0,,Мен сені мақтаймын.
Dialogue: 0,0:15:30.11,0:15:31.91,Default,,0,0,0,,Ханымдар мен мырзалар
Dialogue: 0,0:15:32.36,0:15:36.17,Default,,0,0,0,,Бүгін бізде Асторо-сода жаңа аспазшы бар.
Dialogue: 0,0:15:36.78,0:15:41.42,Default,,0,0,0,,Енді біз бұл азаптау сияқты таңғы астан құтыла аламыз.
Dialogue: 0,0:15:41.83,0:15:45.83,Default,,0,0,0,,Енді алда болатын нәрседен қорқудың қажеті жоқ.
Dialogue: 0,0:15:46.59,0:15:49.30,Default,,0,0,0,,Бүгін көп ішейік.
Dialogue: 0,0:15:49.30,0:15:52.35,Default,,0,0,0,,Бұл аздап асыра сілтеу емес пе?
Dialogue: 0,0:15:52.35,0:15:54.68,Default,,0,0,0,,Бас аспаз Миямото-санның сөзі
Dialogue: 0,0:15:54.68,0:15:56.09,Default,,0,0,0,,Бұл Миясака.
Dialogue: 0,0:15:56.78,0:15:58.14,Default,,0,0,0,,аспаз
Dialogue: 0,0:15:58.60,0:16:04.19,Default,,0,0,0,,Жарайды, мен Такуми Миясакамын, мен сонда тұрып, саған таңғы ас әзірлеймін.
Dialogue: 0,0:16:04.19,0:16:06.80,Default,,0,0,0,,Мен жұмыс іздеуді жалғастырамын.
Dialogue: 0,0:16:06.80,0:16:09.70,Default,,0,0,0,,Бұл сізге тудыруы мүмкін кез келген қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:16:09.70,0:16:11.20,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:16:14.47,0:16:17.25,Default,,0,0,0,,Жарайды, мен де ән айтатын шығармын.
Dialogue: 0,0:16:17.25,0:16:18.90,Default,,0,0,0,,Жоқ, ол ескі.
Dialogue: 0,0:16:31.83,0:16:33.18,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:16:33.40,0:16:35.02,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:16:44.73,0:16:47.28,Default,,0,0,0,,Керемет, бұл дұрыс таңғы ас.
Dialogue: 0,0:16:47.28,0:16:48.67,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:16:48.67,0:16:50.47,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:16:50.47,0:16:51.66,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:16:51.66,0:16:54.76,Default,,0,0,0,,О, Мацубара-сан, бүгін ерте.
Dialogue: 0,0:16:54.76,0:16:57.00,Default,,0,0,0,,Бүгін уақытша жұмыс күні...
Dialogue: 0,0:16:57.00,0:16:59.79,Default,,0,0,0,,Бас аспазшы күткендей.
Dialogue: 0,0:16:59.79,0:17:01.79,Default,,0,0,0,,Итадакима~
Dialogue: 0,0:17:05.74,0:17:07.05,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:17:12.86,0:17:14.19,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:17:16.56,0:17:18.15,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:17:24.89,0:17:26.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:17:27.49,0:17:29.45,Default,,0,0,0,,Мен де күріш сатып алуым керек пе?
Dialogue: 0,0:17:35.93,0:17:37.39,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:17:37.39,0:17:38.12,Default,,0,0,0,,Бұл жұмбақ емес пе?
Dialogue: 0,0:17:39.24,0:17:41.96,Default,,0,0,0,,Жұмбақ әйел Мира Готокуджи
Dialogue: 0,0:17:41.96,0:17:43.06,Default,,0,0,0,,Жұмбақ?
Dialogue: 0,0:17:43.06,0:17:47.47,Default,,0,0,0,,Бұл күндері менде компьютер ғана емес, тіпті смартфоным да жоқ.
Dialogue: 0,0:17:48.96,0:17:53.73,Default,,0,0,0,,Басында мен алдыңғы жағында ''WIFI қолжетімді'' деген жазуды көрдім.
Dialogue: 0,0:17:53.73,0:17:55.85,Default,,0,0,0,,«Куйхуай толық жабдықталған»
Dialogue: 0,0:17:55.85,0:17:57.81,Default,,0,0,0,,...Мен оны оқыдым.
Dialogue: 0,0:17:57.81,0:18:01.64,Default,,0,0,0,,... туралы білмейтін жасы үлкен балалар бар ма?
Dialogue: 0,0:18:01.64,0:18:03.98,Default,,0,0,0,,Мен атақты адамдар туралы ештеңе білмеймін.
Dialogue: 0,0:18:04.60,0:18:08.36,Default,,0,0,0,,Мен алғаш келгенде теледидардың пульті жанымда болды.
Dialogue: 0,0:18:08.36,0:18:10.11,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:10.11,0:18:12.11,Default,,0,0,0,,Мен естідім...
Dialogue: 0,0:18:12.11,0:18:16.24,Default,,0,0,0,,Мира-чан, сенің ешкімге айта алмайтын өткен өмірің бар шығар деп ойлаймын.
Dialogue: 0,0:18:16.24,0:18:21.55,Default,,0,0,0,,Түрмеде ұзақ отырған болуы мүмкін деген қауесет бар.
Dialogue: 0,0:18:21.55,0:18:25.03,Default,,0,0,0,,Дұрысы, Вакабаяши мырза, сіз жұмысқа бармайсыз ба?
Dialogue: 0,0:18:26.50,0:18:29.00,Default,,0,0,0,,Өйткені мен қатал жұмыссыз адаммын.
Dialogue: 0,0:18:29.66,0:18:33.55,Default,,0,0,0,,Жұмыссыз болудың ең жақсы жағы екі рет ұйықтау шығар.
Dialogue: 0,0:18:33.55,0:18:37.01,Default,,0,0,0,,Сіз қалай өмір сүресіз? Бұл жұмбақ.
Dialogue: 0,0:18:44.42,0:18:47.36,Default,,0,0,0,,Ол қазірдің өзінде қайда?
Dialogue: 0,0:18:47.36,0:18:49.02,Default,,0,0,0,,Сіз бірдеңе іздеп жүрсіз бе?
Dialogue: 0,0:18:50.77,0:18:54.70,Default,,0,0,0,,Сіз бірдеңені жоғалттыңыз ба? Оны бірге іздейміз бе?
Dialogue: 0,0:18:55.28,0:18:57.95,Default,,0,0,0,,Жоқ, жарайды, не болды?
Dialogue: 0,0:18:59.01,0:19:01.76,Default,,0,0,0,,Мен материал сатып алғым келеді.
Dialogue: 0,0:19:01.76,0:19:05.46,Default,,0,0,0,,Мен осы дүкеннен сатып алатын нәрсе бар ма деп ойладым.
Dialogue: 0,0:19:05.77,0:19:07.35,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:19:08.29,0:19:10.49,Default,,0,0,0,,Мен сізге сауда аймағын да көрсетемін.
Dialogue: 0,0:19:10.92,0:19:12.61,Default,,0,0,0,,Басты жүргізуші Кадзухико Хиби дәл сағат 18:00-де жүрек талмасынан өліп қалады.
Dialogue: 0,0:19:13.34,0:19:15.82,Default,,0,0,0,,Жоқ, Наосуке үйде.
Dialogue: 0,0:19:15.82,0:19:16.90,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:19:17.89,0:19:18.76,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:19:18.76,0:19:19.72,Default,,0,0,0,,Иә
Dialogue: 0,0:19:28.94,0:19:31.83,Default,,0,0,0,,Бұл фильм қызық болды, солай емес пе?
Dialogue: 0,0:19:31.83,0:19:33.49,Default,,0,0,0,,Фильмдер…
Dialogue: 0,0:19:33.49,0:19:35.49,Default,,0,0,0,,Бүкіл ғаламды жауға айналдыру
Dialogue: 0,0:19:35.49,0:19:40.55,Default,,0,0,0,,Махаббат үшін бір жұдырықпен күресетін ханшайым - ең керемет.
Dialogue: 0,0:19:41.23,0:19:42.87,Default,,0,0,0,,Қызықты көрінеді
Dialogue: 0,0:19:42.87,0:19:44.97,Default,,0,0,0,,Мен оны көргім келеді
Dialogue: 0,0:19:44.97,0:19:47.44,Default,,0,0,0,,Мира-сан, саған қандай фильмдер ұнайды?
Dialogue: 0,0:19:48.47,0:19:51.05,Default,,0,0,0,,Мен көп фильмдерді немесе басқаларды көрген емеспін.
Dialogue: 0,0:19:51.05,0:19:53.86,Default,,0,0,0,,Мүмкін сіз шетелде тұрған шығарсыз?
Dialogue: 0,0:19:54.83,0:19:57.84,Default,,0,0,0,,Қараңдаршы, мен қара өрік шарабы немесе соған ұқсас нәрсені білмедім.
Dialogue: 0,0:19:57.84,0:20:01.60,Default,,0,0,0,,Шетелде тұратын шығар деп ойладым.
Dialogue: 0,0:20:03.22,0:20:05.93,Default,,0,0,0,,Дораяки ұнай ма?
Dialogue: 0,0:20:05.93,0:20:07.31,Default,,0,0,0,,Тамақ ішейік
Dialogue: 0,0:20:31.63,0:20:33.38,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:33.38,0:20:34.63,Default,,0,0,0,,болды
Dialogue: 0,0:20:39.18,0:20:41.28,Default,,0,0,0,,Әлі де жақсы.
Dialogue: 0,0:21:00.04,0:21:00.96,Default,,0,0,0,,Жарайды
Dialogue: 0,0:21:02.28,0:21:04.06,Default,,0,0,0,,Мәңгі осылай қалуы мүмкін бе?
Dialogue: 0,0:21:04.06,0:21:04.88,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:21:04.88,0:21:06.29,Default,,0,0,0,,Жақсылық жақсы емес
Dialogue: 0,0:21:06.29,0:21:08.03,Default,,0,0,0,,Неліктен жоқ?
Dialogue: 0,0:21:08.03,0:21:10.63,Default,,0,0,0,,Мен Мибо болғандықтан ба?
Dialogue: 0,0:21:19.82,0:21:23.08,Default,,0,0,0,,Мира-сан, сен жесірсің бе?
Dialogue: 0,0:21:23.08,0:21:27.56,Default,,0,0,0,,Бұл мен смартфонға келісім-шартқа қол қоя алмайтынымды білдіре ме, себебі мен Mibo адамымын?
Dialogue: 0,0:21:27.56,0:21:30.89,Default,,0,0,0,,Мира, мен жерге ойнауға келмеймін.
Dialogue: 0,0:21:30.89,0:21:34.61,Default,,0,0,0,,Мибо планетасының тағының келесі мұрагері ретіндегі рөліңізден хабардар болыңыз.
Dialogue: 0,0:21:34.61,0:21:38.27,Default,,0,0,0,,Смартфондар сізге Жер туралы барлық ақпаратты бере алады.
Dialogue: 0,0:21:38.27,0:21:40.19,Default,,0,0,0,,Сіз кілттің қайда екенін де білуіңіз мүмкін.
Dialogue: 0,0:21:40.84,0:21:43.22,Default,,0,0,0,,Бұл жүздеген жылдар бұрынғы технология.
Dialogue: 0,0:21:43.22,0:21:46.74,Default,,0,0,0,,Мен қарапайым адамдар жасаған ештеңеге сене алмаймын.
Dialogue: 0,0:21:47.10,0:21:50.29,Default,,0,0,0,,Кілт ғимараттың бір жерінде болуы керек.
Dialogue: 0,0:21:53.62,0:21:55.78,Default,,0,0,0,,Эй, сен фильмді көрдіңіз бе?
Dialogue: 0,0:21:55.78,0:21:58.47,Default,,0,0,0,,``Ғарыш қызы'' шынымен қызықты болып көрінді.
Dialogue: 0,0:21:58.47,0:22:01.72,Default,,0,0,0,,Мира, сен біздің тапсырмамызды ұмыттың ба?
Dialogue: 0,0:22:02.08,0:22:06.10,Default,,0,0,0,,Кілтті тезірек тауып, оны Мибо планетасына әкеліңіз.
Dialogue: 0,0:22:06.39,0:22:10.39,Default,,0,0,0,,Ал Мира тағына мұрагер болады және Мибо планетасын қорғайды.
Dialogue: 0,0:22:11.31,0:22:13.85,Default,,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,0:19:26.77,0:19:30.28,Default,,0,0,0,,Мен жұлдызға тілек айттым, бірақ
Dialogue: 0,0:19:30.28,0:19:33.71,Default,,0,0,0,,Бұл біртүрлі. Енді түсіндім.
Dialogue: 0,0:19:33.71,0:19:37.14,Default,,0,0,0,,Сансыз қалқымалы ғаламдардың ішінде
Dialogue: 0,0:19:37.14,0:19:40.46,Default,,0,0,0,,Біз осы жер бетінде кездесе алдық
Dialogue: 0,0:19:43.72,0:19:50.57,Default,,0,0,0,,Қайда және кім екенің маңызды емес.
Dialogue: 0,0:19:50.57,0:19:52.38,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:19:52.38,0:19:54.01,Default,,0,0,0,,Өйткені иә.
Dialogue: 0,0:19:54.01,0:19:57.39,Default,,0,0,0,,Мен кеткім келмейді
Dialogue: 0,0:19:57.39,0:20:00.93,Default,,0,0,0,,Менің жүрегім - менің бәрім
Dialogue: 0,0:20:00.93,0:20:04.74,Default,,0,0,0,,Сіз менің түрімді өзгерттіңіз
Dialogue: 0,0:20:05.05,0:20:11.06,Default,,0,0,0,,Махаббатты жасыру
Dialogue: 0,0:20:11.06,0:20:14.58,Default,,0,0,0,,Сезімдеріңмен не істеуім керек?
Dialogue: 0,0:20:14.58,0:20:18.70,Default,,0,0,0,,Мен сенің жүрегіңді білемін
Dialogue: 0,0:20:21.49,0:20:24.96,Default,,0,0,0,,Тағы да күту керек
Dialogue: 0,0:20:24.96,0:20:28.74,Default,,0,0,0,,Көзге дейінгі қашықтықты сақтаңыз
Dialogue: 0,0:22:22.75,0:22:25.96,Default,,0,0,0,,Токимеки, ұшқын, теңселу
Dialogue: 0,0:22:25.96,0:22:29.16,Default,,0,0,0,,Жарқырау
Dialogue: 0,0:22:29.16,0:22:32.32,Default,,0,0,0,,сыбдырлау
Dialogue: 0,0:22:32.32,0:22:34.56,Default,,0,0,0,,Таңқаларлық
Dialogue: 0,0:22:35.73,0:22:38.93,Default,,0,0,0,,Сұрағым келеді, білгім келеді
Dialogue: 0,0:22:38.93,0:22:41.18,Default,,0,0,0,,Айтпа
Dialogue: 0,0:22:41.18,0:22:47.37,Default,,0,0,0,,Өзіме не деген түсініксіз күлкі
Dialogue: 0,0:22:47.37,0:22:54.38,Default,,0,0,0,,Болашақтың есігін ашатын кілтті іздедім.
Dialogue: 0,0:22:54.38,0:23:01.17,Default,,0,0,0,,Бірақ мен тапқаным ғашық болдым
Dialogue: 0,0:23:01.17,0:23:07.08,Default,,0,0,0,,Мен сені жақсы көремін, бірақ жүрегім шықса қорқамын
Dialogue: 0,0:23:07.55,0:23:13.62,Default,,0,0,0,,Ақаңа бұлт сен жоғары қарасаң, көлеңкеңе кіріп кетеді.
Dialogue: 0,0:23:13.62,0:23:20.42,Default,,0,0,0,,Көзіміз түйіссе, Айтқанымыз күлкі
Dialogue: 0,0:23:20.42,0:23:25.94,Default,,0,0,0,,Мен толқуды, жарқырауды және теңселуді естимін.
Dialogue: 0,0:23:25.94,0:23:35.18,Default,,0,0,0,,Оқиға жұмбақ таңда жалғасады
Dialogue: 0,0:23:35.18,0:23:40.92,Default,,0,0,0,,Мен күлген дыбысты естимін
Dialogue: 0,0:23:41.52,0:23:45.85,Default,,0,0,0,,Бір-бірімізге қараған сайын
Dialogue: 0,0:23:33.21,0:23:36.00,Default,,0,0,0,,Токимеки, ұшқын, теңселу
Dialogue: 0,0:23:36.39,0:23:39.23,Default,,0,0,0,,Жарқырау
Dialogue: 0,0:23:39.60,0:23:42.41,Default,,0,0,0,,сыбдырлау
Dialogue: 0,0:23:42.82,0:23:45.01,Default,,0,0,0,,Таңқаларлық
Dialogue: 0,0:24:01.50,0:24:07.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
