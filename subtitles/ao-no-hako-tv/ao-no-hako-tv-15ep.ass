Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.58,0:00:06.33,Default,,0,0,0,,Interhigh аяқталды
Dialogue: 0,0:00:06.42,0:00:07.79,Default,,0,0,0,,Жазғы демалысқа санаулы күндер қалды
Dialogue: 0,0:00:08.92,0:00:11.59,Default,,0,0,0,,Қалған үй тапсырмасын уайымдағанда
Dialogue: 0,0:00:13.63,0:00:16.93,Default,,0,0,0,,Бүгін 26 тамыз
Dialogue: 0,0:00:17.01,0:00:17.93,Default,,0,0,0,,(крекердің жарылған дыбысы)
Dialogue: 0,0:00:18.01,0:00:18.85,Default,,0,0,0,,О!
Dialogue: 0,0:00:18.93,0:00:20.18,Default,,0,0,0,,Чинацу
Dialogue: 0,0:00:20.27,0:00:22.43,Default,,0,0,0,,Туған күнің құтты болсын!
Dialogue: 0,0:00:23.64,0:00:24.69,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:00:25.44,0:00:27.02,Default,,0,0,0,,Иә, иә өтінемін~
Dialogue: 0,0:00:27.52,0:00:29.19,Default,,0,0,0,,Мынаны киіңіз
Dialogue: 0,0:00:29.27,0:00:30.86,Default,,0,0,0,,Бұл сыйлық
Dialogue: 0,0:00:30.94,0:00:32.28,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:00:34.78,0:00:38.87,Default,,0,0,0,,Суретші Чинацудың бұғы жейдесі Оны жаттығу үшін киіңіз.
Dialogue: 0,0:00:38.95,0:00:39.70,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:00:41.04,0:00:42.66,Default,,0,0,0,,Иә Сыр
Dialogue: 0,0:00:42.75,0:00:44.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:47.54,0:00:49.54,Default,,0,0,0,,♪~
Dialogue: 0,0:02:14.50,0:02:16.51,Default,,0,0,0,,~♪
Dialogue: 0,0:02:18.22,0:02:19.63,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:02:19.72,0:02:20.76,Default,,0,0,0,,Қыздар қандай?
Dialogue: 0,0:02:20.84,0:02:21.93,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:02:22.01,0:02:23.64,Default,,0,0,0,,Керемет
Dialogue: 0,0:02:25.47,0:02:26.64,Default,,0,0,0,,Бүгін менің туған күнім
Dialogue: 0,0:02:26.72,0:02:27.68,Default,,0,0,0,,Мені сүюге тиіс еді! Мені сүюге тиіс!
Dialogue: 0,0:02:28.39,0:02:30.02,Default,,0,0,0,,Бірнеше апта бұрын
Dialogue: 0,0:02:30.10,0:02:33.27,Default,,0,0,0,,Мен ақпарат жинап, сыйлықтарды зерттедім.
Dialogue: 0,0:02:33.77,0:02:37.07,Default,,0,0,0,,Бәрі жабатын сияқты, ауыр болар ма екен...
Dialogue: 0,0:02:37.15,0:02:40.57,Default,,0,0,0,,Жарайды, бұл қиын емес пе?
Dialogue: 0,0:02:41.87,0:02:43.32,Default,,0,0,0,,Сонымен қатар,
Dialogue: 0,0:02:43.91,0:02:48.96,Default,,0,0,0,,Интер-Хих аяқталғаннан кейін Чинацу-сенпай өзін жақсы сезінбегендей болды.
Dialogue: 0,0:02:49.75,0:02:52.67,Default,,0,0,0,,Менің ойымша, бұл мерекеге мүлдем ұқсамайды.
Dialogue: 0,0:02:53.17,0:02:54.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:55.04,0:02:55.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:56.55,0:02:58.59,Default,,0,0,0,,Бірақ түнде бірдеңе болады...
Dialogue: 0,0:02:58.67,0:02:59.59,Default,,0,0,0,,Міне!
Dialogue: 0,0:03:00.17,0:03:01.18,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:03:01.26,0:03:02.09,Default,,0,0,0,,- (балапан) А - (қуанышты) А?
Dialogue: 0,0:03:02.18,0:03:03.68,Default,,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:03:04.18,0:03:06.97,Default,,0,0,0,,Сен мені әдейі ұрдың, солай ма?
Dialogue: 0,0:03:07.06,0:03:08.10,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:03:08.73,0:03:11.44,Default,,0,0,0,,Әңгімелесу мүмкіндігін жасау туралы емес.
Dialogue: 0,0:03:11.94,0:03:12.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:15.19,0:03:16.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:17.19,0:03:18.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:20.70,0:03:24.16,Default,,0,0,0,,Хина, менің сөйлесетін бірдеңе бар, жарай ма?
Dialogue: 0,0:03:24.66,0:03:25.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:26.95,0:03:28.12,Default,,0,0,0,,Не?
Dialogue: 0,0:03:30.62,0:03:31.96,Default,,0,0,0,,Мүмкін біртүрлі нәрсе бар шығар?
Dialogue: 0,0:03:32.04,0:03:34.17,Default,,0,0,0,,Цуккоми қиын болатындай ақымақ болма!
Dialogue: 0,0:03:34.25,0:03:35.75,Default,,0,0,0,,Көңіл-күйді көтеруге тырысу...
Dialogue: 0,0:03:36.79,0:03:37.92,Default,,0,0,0,,Хинаса
Dialogue: 0,0:03:38.00,0:03:40.76,Default,,0,0,0,,Сіз әлі жауап қажет емес деп айттыңыз.
Dialogue: 0,0:03:41.34,0:03:42.22,Default,,0,0,0,,Иә
Dialogue: 0,0:03:42.72,0:03:46.76,Default,,0,0,0,,Бірақ маған Чинацу-сенпай ұнайды.
Dialogue: 0,0:03:47.68,0:03:51.77,Default,,0,0,0,,Мен бар күшімді саламын деп ойлаймын, бірақ бұл дұрыс па?
Dialogue: 0,0:03:52.85,0:03:54.52,Default,,0,0,0,,Не? Жарайды
Dialogue: 0,0:03:54.60,0:03:55.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:57.11,0:03:58.23,Default,,0,0,0,,Мен айттым ғой.
Dialogue: 0,0:03:58.32,0:04:01.03,Default,,0,0,0,,Мен сенің сенпайыңды жақсы көретініңді білемін.
Dialogue: 0,0:04:04.07,0:04:06.53,Default,,0,0,0,,Біртүрлі ескертпелер жасау қиынырақ.
Dialogue: 0,0:04:17.92,0:04:19.38,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:04:21.88,0:04:22.80,Default,,0,0,0,,Чинацу!
Dialogue: 0,0:04:23.88,0:04:24.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:26.64,0:04:29.68,Default,,0,0,0,,Не істеп жатырсың! Мен қорғаныста қалдым
Dialogue: 0,0:04:29.76,0:04:31.56,Default,,0,0,0,,Оны да екінші жаққа бұраңыз!
Dialogue: 0,0:04:31.64,0:04:32.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:34.27,0:04:36.56,Default,,0,0,0,,Директор: Сіз Чинацуға қатал болып жатырсыз.
Dialogue: 0,0:04:36.65,0:04:37.81,Default,,0,0,0,,Мен бұған көмектесе алмаймын
Dialogue: 0,0:04:38.40,0:04:40.32,Default,,0,0,0,,Негізгі аға буын өкілдері де кетіп қалды.
Dialogue: 0,0:04:40.82,0:04:42.57,Default,,0,0,0,,Бұл Чинацуға деген қатыгездік.
Dialogue: 0,0:04:42.65,0:04:47.24,Default,,0,0,0,,Өйткені, мен оның соңғы шешімді қабылдай алатын ойыншы болғанын қалаймын.
Dialogue: 0,0:04:52.91,0:04:54.83,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:05:00.29,0:05:02.21,Default,,0,0,0,,Директор Не?
Dialogue: 0,0:05:03.05,0:05:07.55,Default,,0,0,0,,Йошитани-сенпай зейнеткерлікке шыққандықтан, мен оған вице-капитан ретінде барын салуды тапсырдым.
Dialogue: 0,0:05:07.64,0:05:08.47,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:05:09.05,0:05:10.97,Default,,0,0,0,,Келесі капитан Чинацу болады, солай ма?
Dialogue: 0,0:05:11.06,0:05:13.47,Default,,0,0,0,,Оның қабілеті де кемел.
Dialogue: 0,0:05:13.56,0:05:15.60,Default,,0,0,0,,Жасөспірімдердің үлкен сенімі
Dialogue: 0,0:05:16.48,0:05:18.23,Default,,0,0,0,,Бірақ жақсы ма?
Dialogue: 0,0:05:19.06,0:05:20.98,Default,,0,0,0,,Чинацу: Сен ондай нәрсеге шебер емессің, солай ма?
Dialogue: 0,0:05:21.07,0:05:23.53,Default,,0,0,0,,Бұл бірінші тоқсандағы әлі де тап өкілі.
Dialogue: 0,0:05:23.61,0:05:24.94,Default,,0,0,0,,Тас, қағаз, қайшы, сіз жоғалдыңыз, солай ма?
Dialogue: 0,0:05:26.45,0:05:28.74,Default,,0,0,0,,Әрине қысым бар
Dialogue: 0,0:05:29.32,0:05:31.49,Default,,0,0,0,,Мен бұл топты жақсы көремін.
Dialogue: 0,0:05:31.58,0:05:32.83,Default,,0,0,0,,Жақсы айттыңыз!
Dialogue: 0,0:05:32.91,0:05:34.37,Default,,0,0,0,,Мен сізге еремін, вице-капитан!
Dialogue: 0,0:05:34.45,0:05:35.50,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:05:35.58,0:05:38.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:39.08,0:05:40.63,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:05:41.59,0:05:43.96,Default,,0,0,0,,(Допты соғу дыбысы)
Dialogue: 0,0:05:58.69,0:05:59.81,Default,,0,0,0,,Аа...
Dialogue: 0,0:06:00.69,0:06:01.98,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:02.61,0:06:03.98,Default,,0,0,0,,Мен оны жақында жабамын.
Dialogue: 0,0:06:04.07,0:06:05.23,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:13.37,0:06:19.87,Default,,0,0,0,,(Смартфонның діріл дыбысы)
Dialogue: 0,0:06:23.13,0:06:23.88,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:06:23.96,0:06:26.88,Default,,0,0,0,,Чинацу! туылған күніңмен!
Dialogue: 0,0:06:27.76,0:06:30.30,Default,,0,0,0,,Мама таң қалды.
Dialogue: 0,0:06:30.39,0:06:33.89,Default,,0,0,0,,Біз оны Жапонияға жеткізуіміз керек.
Dialogue: 0,0:06:34.76,0:06:37.23,Default,,0,0,0,,Сіз қалай ойлайсыз? Бірдеңе өзгерді ме?
Dialogue: 0,0:06:37.73,0:06:38.89,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:06:38.98,0:06:43.06,Default,,0,0,0,,Иә? Мен өзімді жақсы сезінбейтін сияқтымын.
Dialogue: 0,0:06:43.56,0:06:46.57,Default,,0,0,0,,Мен радиоға келгенде, мен кернеудің төмендегенін естимін.
Dialogue: 0,0:06:46.65,0:06:48.40,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:06:51.95,0:06:54.20,Default,,0,0,0,,Бұл ештеңе болмаған сияқты.
Dialogue: 0,0:06:54.28,0:06:55.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:55.74,0:06:58.08,Default,,0,0,0,,Клуб іс-шараларында вице-капитан болып сайланды
Dialogue: 0,0:06:58.16,0:06:59.29,Default,,0,0,0,,Бұл керемет емес пе!
Dialogue: 0,0:07:00.58,0:07:03.67,Default,,0,0,0,,Мен сайланғандықтан, мен бар күшімді салғым келеді...
Dialogue: 0,0:07:04.25,0:07:05.67,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:07:06.30,0:07:07.92,Default,,0,0,0,,Менің ойымша, бұл туралы өткен күні айттым.
Dialogue: 0,0:07:09.26,0:07:12.30,Default,,0,0,0,,Мен маңызды сәтте соққыны өткізіп алдым.
Dialogue: 0,0:07:13.22,0:07:15.30,Default,,0,0,0,,Мен өзімше жаттығу жасадым.
Dialogue: 0,0:07:16.22,0:07:18.14,Default,,0,0,0,,Сонда да мен оны шешіп алдым.
Dialogue: 0,0:07:21.39,0:07:22.48,Default,,0,0,0,,Баскетбол туралы
Dialogue: 0,0:07:22.56,0:07:25.23,Default,,0,0,0,,Мен өсетін нәрселер бар.
Dialogue: 0,0:07:25.73,0:07:28.57,Default,,0,0,0,,Мен команда туралы ойлай аламын ба?
Dialogue: 0,0:07:29.78,0:07:32.32,Default,,0,0,0,,Маған жақсы ма деп ойлаймын...
Dialogue: 0,0:07:35.74,0:07:36.58,Default,,0,0,0,,Чинацу
Dialogue: 0,0:07:37.24,0:07:40.12,Default,,0,0,0,,Сіз оны қолданып көргенде және ол жұмыс істемегенде солай болады.
Dialogue: 0,0:07:40.20,0:07:42.33,Default,,0,0,0,,Бұл туралы ойлануға әлі де кеш емес.
Dialogue: 0,0:07:43.50,0:07:44.92,Default,,0,0,0,,Сосын—
Dialogue: 0,0:07:45.00,0:07:47.92,Default,,0,0,0,,«Мен мұны жақсы істей алмадым, өйткені бұл мен болдым» дегеннің орнына.
Dialogue: 0,0:07:48.00,0:07:50.72,Default,,0,0,0,,Мұны қалай жақсы орындауға болатынын ойлаңыз.
Dialogue: 0,0:07:51.38,0:07:55.09,Default,,0,0,0,,Егер Чинацу қазірден бастап абай болу керек нәрсе болса,
Dialogue: 0,0:07:55.18,0:07:56.60,Default,,0,0,0,,Осындай қиын кезеңде
Dialogue: 0,0:07:57.47,0:07:59.39,Default,,0,0,0,,Біреуге арқа сүйеу
Dialogue: 0,0:07:59.47,0:08:00.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:01.06,0:08:04.73,Default,,0,0,0,,Басқалардың сеніміне ие болу өте жақсы.
Dialogue: 0,0:08:05.52,0:08:07.27,Default,,0,0,0,,Ал, оны кесетін кез келді.
Dialogue: 0,0:08:07.77,0:08:09.78,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:08:10.82,0:08:11.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:21.58,0:08:22.33,Default,,0,0,0,,(беру дыбысы)
Dialogue: 0,0:08:22.83,0:08:24.08,Default,,0,0,0,,А…?
Dialogue: 0,0:08:24.17,0:08:24.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:25.79,0:08:26.63,Default,,0,0,0,,Не!
Dialogue: 0,0:08:26.71,0:08:27.88,Default,,0,0,0,,Хмм!
Dialogue: 0,0:08:29.17,0:08:30.84,Default,,0,0,0,,Мен оны киген сияқты емеспін!
Dialogue: 0,0:08:30.92,0:08:31.76,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:32.92,0:08:34.26,Default,,0,0,0,,Кездейсоқ...
Dialogue: 0,0:08:35.84,0:08:38.01,Default,,0,0,0,,Дәлірек айтсақ, бұл...
Dialogue: 0,0:08:39.10,0:08:41.64,Default,,0,0,0,,Енді жібермейді деп ойладым.
Dialogue: 0,0:08:49.77,0:08:51.28,Default,,0,0,0,,Мен бір жерге барғым келеді
Dialogue: 0,0:08:54.65,0:08:57.49,Default,,0,0,0,,Пойызға мінуге бола ма?
Dialogue: 0,0:09:06.67,0:09:08.21,Default,,0,0,0,,Біз жақында келеміз.
Dialogue: 0,0:09:08.75,0:09:09.38,Default,,0,0,0,,Иә
Dialogue: 0,0:09:16.68,0:09:17.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:23.56,0:09:25.39,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:09:26.73,0:09:28.44,Default,,0,0,0,,Теңіз!
Dialogue: 0,0:09:29.98,0:09:33.36,Default,,0,0,0,,Бастауыш сыныпта оқып жүргенімде жиі келетінмін.
Dialogue: 0,0:09:33.86,0:09:35.86,Default,,0,0,0,,Кеш болды, мен жүзе алмаймын.
Dialogue: 0,0:09:39.07,0:09:40.24,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:09:41.45,0:09:43.83,Default,,0,0,0,,(Чинацудың күлкісі)
Dialogue: 0,0:09:43.95,0:09:46.37,Default,,0,0,0,,Өйткені, балалық жағы бар.
Dialogue: 0,0:09:47.08,0:09:48.12,Default,,0,0,0,,Хехе
Dialogue: 0,0:09:50.50,0:09:51.50,Default,,0,0,0,,Уау...
Dialogue: 0,0:09:52.00,0:09:53.38,Default,,0,0,0,,Хехехе
Dialogue: 0,0:09:57.63,0:09:58.63,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:59.64,0:10:01.85,Default,,0,0,0,,Өзіңізді сәл жақсы сезінген сияқтысыз
Dialogue: 0,0:10:02.35,0:10:03.89,Default,,0,0,0,,Дайки-кун, сен де кел!
Dialogue: 0,0:10:03.97,0:10:05.77,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:10:12.23,0:10:13.73,Default,,0,0,0,,Тез, тез
Dialogue: 0,0:10:14.23,0:10:15.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:15.23,0:10:18.15,Default,,0,0,0,,Сенпай Мисанга...
Dialogue: 0,0:10:18.24,0:10:21.41,Default,,0,0,0,,О, дұрыс, бұзылған.
Dialogue: 0,0:10:22.91,0:10:25.79,Default,,0,0,0,,Мен өзімнің тілегіме тым көп қостым деп ойлаймын.
Dialogue: 0,0:10:25.87,0:10:27.41,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:31.96,0:10:33.17,Default,,0,0,0,,Мен...
Dialogue: 0,0:10:34.13,0:10:36.17,Default,,0,0,0,,Ол енді сәйкес емес.
Dialogue: 0,0:10:43.97,0:10:44.76,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:45.26,0:10:46.97,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:10:47.48,0:10:49.31,Default,,0,0,0,,Өйткені мен біртүрлі ойсыз едім.
Dialogue: 0,0:10:49.81,0:10:50.69,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:10:51.90,0:10:53.27,Default,,0,0,0,,Не~!
Dialogue: 0,0:10:54.69,0:10:56.28,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:10:57.40,0:10:58.90,Default,,0,0,0,,Тоқта, күт!
Dialogue: 0,0:10:59.86,0:11:01.70,Default,,0,0,0,,- (Чинацу) Кеттік! - (қуанып) Уау, суық екен!
Dialogue: 0,0:11:01.78,0:11:05.87,Default,,0,0,0,,Қазіргі таңда жас балалар бар.
Dialogue: 0,0:11:06.37,0:11:09.04,Default,,0,0,0,,Жаздың күніндей жарқыраған.
Dialogue: 0,0:11:09.54,0:11:14.29,Default,,0,0,0,,Бірақ қазірден бастап ауа райы нашарлайтын сияқты.
Dialogue: 0,0:11:14.79,0:11:17.96,Default,,0,0,0,,Чинацу Сенпай Тамма Тамма!
Dialogue: 0,0:11:18.55,0:11:20.47,Default,,0,0,0,,Бұл жерде құм батады
Dialogue: 0,0:11:20.55,0:11:21.93,Default,,0,0,0,,Ондай нәрсе бар ма?
Dialogue: 0,0:11:22.01,0:11:24.64,Default,,0,0,0,,Бұл рас, бірақ абай болу керек...
Dialogue: 0,0:11:24.72,0:11:25.47,Default,,0,0,0,,Ах
Dialogue: 0,0:11:39.07,0:11:40.03,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:40.53,0:11:41.45,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:43.57,0:11:44.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:46.08,0:11:48.58,Default,,0,0,0,,Құлап кетсең суланып қалсаң, Бәлеге қаласың.
Dialogue: 0,0:11:49.08,0:11:51.00,Default,,0,0,0,,А... иә
Dialogue: 0,0:11:51.08,0:11:52.00,Default,,0,0,0,,Тек бір минут қалды!
Dialogue: 0,0:11:52.08,0:11:54.21,Default,,0,0,0,,Бұл... өте ыстық!
Dialogue: 0,0:11:54.29,0:11:55.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:56.29,0:11:57.50,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:11:58.00,0:11:59.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:04.84,0:12:07.93,Default,,0,0,0,,Жақсы болды, сіз өз футболкаңызды алып келдіңіз.
Dialogue: 0,0:12:08.01,0:12:08.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:09.35,0:12:11.27,Default,,0,0,0,,Сіз жергілікті тұрғынсыз ба?
Dialogue: 0,0:12:11.85,0:12:13.69,Default,,0,0,0,,Сіз қазір пойызға отырасыз ба?
Dialogue: 0,0:12:13.77,0:12:16.27,Default,,0,0,0,,Ол күткендей кептірілмейді.
Dialogue: 0,0:12:18.19,0:12:20.78,Default,,0,0,0,,Күн батқанда үйге барамыз ба?
Dialogue: 0,0:12:24.70,0:12:27.28,Default,,0,0,0,,Мені осында әкелгеніңіз үшін рахмет.
Dialogue: 0,0:12:30.54,0:12:34.25,Default,,0,0,0,,Чинацу-сенпай, бүгін сенің туған күнің емес пе?
Dialogue: 0,0:12:34.33,0:12:35.29,Default,,0,0,0,,Иә
Dialogue: 0,0:12:35.88,0:12:38.29,Default,,0,0,0,,Негізі оны сыйлық деп атауға болады...
Dialogue: 0,0:12:38.79,0:12:40.63,Default,,0,0,0,,Бұл кішкентай болса да.
Dialogue: 0,0:12:44.59,0:12:45.68,Default,,0,0,0,,Торт!
Dialogue: 0,0:12:46.26,0:12:48.26,Default,,0,0,0,,Сіз... әкелдіңіз бе?
Dialogue: 0,0:12:48.76,0:12:51.14,Default,,0,0,0,,Менде мұз пакеттері көп болды.
Dialogue: 0,0:12:52.02,0:12:53.85,Default,,0,0,0,,Мен шамдарды да дайындадым.
Dialogue: 0,0:12:55.02,0:12:57.56,Default,,0,0,0,,Сіз қазірдің өзінде 17 жастасыз ба?
Dialogue: 0,0:12:59.15,0:13:01.53,Default,,0,0,0,,Туған күн маңызды емес пе?
Dialogue: 0,0:13:01.61,0:13:04.28,Default,,0,0,0,,Мен ересек өмірге жақындағанымды сезінемін.
Dialogue: 0,0:13:05.32,0:13:07.32,Default,,0,0,0,,Дайки-кун, қаңтар ма?
Dialogue: 0,0:13:07.41,0:13:10.12,Default,,0,0,0,,Иә, 15 қаңтар.
Dialogue: 0,0:13:10.83,0:13:15.46,Default,,0,0,0,,Қазір Дайки-кун 15 жаста, сондықтан екі жыл айырмашылық бар.
Dialogue: 0,0:13:15.54,0:13:18.75,Default,,0,0,0,,Екеуінің арасындағы айырмашылық соншалықты үлкен мәміле емес.
Dialogue: 0,0:13:19.75,0:13:20.88,Default,,0,0,0,,Әрине
Dialogue: 0,0:13:25.55,0:13:27.80,Default,,0,0,0,,Ересек болғанша әлі баласың!
Dialogue: 0,0:13:28.55,0:13:30.68,Default,,0,0,0,,Иә, ән айтыңыз.
Dialogue: 0,0:13:31.64,0:13:33.22,Default,,0,0,0,,- (қуанып кетті) ♪ Туған күніңмен - (Чинацу) Ән айтасың ба?
Dialogue: 0,0:13:33.31,0:13:34.89,Default,,0,0,0,,♪ Сізге
Dialogue: 0,0:13:34.98,0:13:38.81,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:13:38.90,0:13:42.27,Default,,0,0,0,,♪ Туған күніңмен қымбаттым…
Dialogue: 0,0:13:42.36,0:13:45.40,Default,,0,0,0,,♪ Чинацу-сенпай
Dialogue: 0,0:13:46.32,0:13:50.41,Default,,0,0,0,,♪ Туған күнің құтты болсын
Dialogue: 0,0:13:53.79,0:13:55.54,Default,,0,0,0,,Желмен жоғалып кетті
Dialogue: 0,0:13:56.04,0:13:57.46,Default,,0,0,0,,Қайталап көргіңіз келе ме?
Dialogue: 0,0:13:57.54,0:13:58.33,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:02.59,0:14:03.59,Default,,0,0,0,,Біз тамақ ішеміз бе?
Dialogue: 0,0:14:12.72,0:14:13.72,Default,,0,0,0,,Ммм
Dialogue: 0,0:14:14.27,0:14:16.73,Default,,0,0,0,,Сосын Мисанга бар.
Dialogue: 0,0:14:17.35,0:14:19.27,Default,,0,0,0,,Біз қайтадан сәйкестендіреміз.
Dialogue: 0,0:14:21.98,0:14:24.73,Default,,0,0,0,,Келесі жылы шахта тоқтатылады.
Dialogue: 0,0:14:25.32,0:14:25.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:26.36,0:14:27.40,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:14:28.07,0:14:29.45,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:14:29.95,0:14:31.53,Default,,0,0,0,,Жоқ, ештеңе.
Dialogue: 0,0:14:31.62,0:14:33.62,Default,,0,0,0,,Уау, бұл бір нәрсе.
Dialogue: 0,0:14:33.70,0:14:38.00,Default,,0,0,0,,Жоқ, Дайки-кун таң қаларлықтай қатал.
Dialogue: 0,0:14:38.08,0:14:38.83,Default,,0,0,0,,Не!
Dialogue: 0,0:14:42.67,0:14:43.59,Default,,0,0,0,,Мен – Соғысшылар корпусының капитаны Тео Магатпын.
Dialogue: 0,0:14:44.30,0:14:47.34,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:14:49.43,0:14:51.64,Default,,0,0,0,,Ол кенет құлады.
Dialogue: 0,0:14:51.72,0:14:53.60,Default,,0,0,0,,Мен суланып қалдым.
Dialogue: 0,0:14:54.26,0:14:56.60,Default,,0,0,0,,Үйге келгенде анам ұрсып қалды.
Dialogue: 0,0:14:59.39,0:15:00.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:03.27,0:15:04.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:04.90,0:15:05.86,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:07.03,0:15:07.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:08.40,0:15:09.03,Default,,0,0,0,,Ах
Dialogue: 0,0:15:13.20,0:15:15.87,Default,,0,0,0,,Иә, сондықтан кешірім сұраймын.
Dialogue: 0,0:15:16.79,0:15:19.08,Default,,0,0,0,,Теңізде ойнап жүргенімде көшкін болды.
Dialogue: 0,0:15:19.58,0:15:22.37,Default,,0,0,0,,Иә, бір ғана бөлме бос болды.
Dialogue: 0,0:15:23.54,0:15:25.38,Default,,0,0,0,,Жарайды, бәрі де осында.
Dialogue: 0,0:15:26.00,0:15:29.05,Default,,0,0,0,,Иә, түсіндім. Сонда кездескенше.
Dialogue: 0,0:15:31.43,0:15:32.72,Default,,0,0,0,,Хаа…
Dialogue: 0,0:15:33.22,0:15:35.64,Default,,0,0,0,,Ештеңе жоқ!
Dialogue: 0,0:15:36.31,0:15:38.06,Default,,0,0,0,,Көшкінге байланысты үйге бара алмадым.
Dialogue: 0,0:15:38.14,0:15:40.48,Default,,0,0,0,,Мен кірген қонақ үйде бір ғана бөлме бар еді.
Dialogue: 0,0:15:40.56,0:15:43.69,Default,,0,0,0,,Мен ата-анама өтірік айтып, бәріміз бірге тұрамыз дедім.
Dialogue: 0,0:15:44.98,0:15:48.44,Default,,0,0,0,,Чинацу-сенпаймен бір бөлмеде бір түн.
Dialogue: 0,0:15:50.15,0:15:52.24,Default,,0,0,0,,Мен оғаш ештеңе істемеймін.
Dialogue: 0,0:15:53.24,0:15:55.45,Default,,0,0,0,,Бұл менің туған күнім.
Dialogue: 0,0:15:55.53,0:15:59.37,Default,,0,0,0,,Осындай жағдай болғанына таң қалмадың ба?
Dialogue: 0,0:16:02.50,0:16:04.67,Default,,0,0,0,,Телефон қоңырауы аяқталды ма?
Dialogue: 0,0:16:04.75,0:16:05.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:06.13,0:16:07.00,Default,,0,0,0,,(жылжымалы есікті жабу дыбысы)
Dialogue: 0,0:16:07.09,0:16:09.00,Default,,0,0,0,,Юкико ше?
Dialogue: 0,0:16:09.09,0:16:11.42,Default,,0,0,0,,Иә! Аа...
Dialogue: 0,0:16:12.17,0:16:13.51,Default,,0,0,0,,Ки… Абайлаңыз.
Dialogue: 0,0:16:14.01,0:16:15.43,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:16.05,0:16:17.43,Default,,0,0,0,,Бұл әлі де жаман!
Dialogue: 0,0:16:18.01,0:16:20.72,Default,,0,0,0,,Мен бұл жағдайда ұйықтай алмаймын!
Dialogue: 0,0:16:20.81,0:16:21.77,Default,,0,0,0,,Дайки-кун
Dialogue: 0,0:16:24.77,0:16:26.81,Default,,0,0,0,,Ол фойеде қалдырылды.
Dialogue: 0,0:16:27.31,0:16:28.19,Default,,0,0,0,,Бірге орындайық
Dialogue: 0,0:16:28.77,0:16:32.70,Default,,0,0,0,,Біз түнегендіктен, түні бойы үстел ойыны турнирін өткіздік.
Dialogue: 0,0:16:32.78,0:16:33.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:34.32,0:16:36.07,Default,,0,0,0,,Сіз нені қалайсыз?
Dialogue: 0,0:16:38.20,0:16:40.29,Default,,0,0,0,,Бұл Чинацу-сенпайдың туған күні, солай ма?
Dialogue: 0,0:16:40.79,0:16:43.29,Default,,0,0,0,,Иә, менің туған күнім.
Dialogue: 0,0:16:46.58,0:16:47.58,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:16:48.34,0:16:48.96,Default,,0,0,0,,Мен оны беремін.
Dialogue: 0,0:16:49.04,0:16:50.13,Default,,0,0,0,,Ах
Dialogue: 0,0:16:50.92,0:16:53.59,Default,,0,0,0,,А, маған Нағиса телефон соқты.
Dialogue: 0,0:16:54.17,0:16:56.22,Default,,0,0,0,,Кешіріңіз, мен шыға аламын ба?
Dialogue: 0,0:16:56.30,0:16:58.51,Default,,0,0,0,,Иә, сыртқа шығайық.
Dialogue: 0,0:16:58.60,0:16:59.68,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:00.18,0:17:00.93,Default,,0,0,0,,О
Dialogue: 0,0:17:01.43,0:17:03.64,Default,,0,0,0,,Иә? Бейне қоңырау ма?
Dialogue: 0,0:17:03.73,0:17:04.35,Default,,0,0,0,,Не!
Dialogue: 0,0:17:04.44,0:17:08.36,Default,,0,0,0,,Туған күніңмен 2-бөлім
Dialogue: 0,0:17:08.98,0:17:10.44,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:17:11.61,0:17:14.90,Default,,0,0,0,,Иә? Сізге жасыру керек болды ма?
Dialogue: 0,0:17:14.99,0:17:16.95,Default,,0,0,0,,Тойлауға шақыру керек пе?
Dialogue: 0,0:17:17.03,0:17:18.41,Default,,0,0,0,,Және тағы да
Dialogue: 0,0:17:18.49,0:17:20.62,Default,,0,0,0,,Мен Чинацуға бірдеңе айтқым келеді.
Dialogue: 0,0:17:20.70,0:17:21.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:22.12,0:17:24.62,Default,,0,0,0,,Бүгін, дәлірек айтқанда, жақында.
Dialogue: 0,0:17:24.71,0:17:27.12,Default,,0,0,0,,Әйтеуір, ол өзін жақсы сезінбеген сияқты.
Dialogue: 0,0:17:29.63,0:17:34.05,Default,,0,0,0,,Менің ойымша, қысым бар, бірақ мен Чинацуды қолдаймын.
Dialogue: 0,0:17:34.13,0:17:36.88,Default,,0,0,0,,Біз қазірден бастап міндетті түрде жақсарамыз.
Dialogue: 0,0:17:37.84,0:17:39.39,Default,,0,0,0,,Ұжым ретінде күштірек болыңыз
Dialogue: 0,0:17:40.55,0:17:41.14,Default,,0,0,0,,Иә
Dialogue: 0,0:17:41.85,0:17:43.02,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:44.22,0:17:47.19,Default,,0,0,0,,Мен мұны айтқым келді
Dialogue: 0,0:17:47.69,0:17:49.69,Default,,0,0,0,,Сіз жаңарған сияқтысыз.
Dialogue: 0,0:17:49.77,0:17:50.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:50.48,0:17:53.90,Default,,0,0,0,,Үйірме жұмыстарында жүргенде мен мұңды сезіндім.
Dialogue: 0,0:17:53.98,0:17:56.45,Default,,0,0,0,,Мен мәңгілік күйзелісте қала алмаймын.
Dialogue: 0,0:17:56.53,0:17:57.65,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:17:58.53,0:18:01.41,Default,,0,0,0,,Не? Сіз юката киіп жүрсіз!
Dialogue: 0,0:18:02.12,0:18:03.62,Default,,0,0,0,,Қонақ үй сияқты нәрсе бар ма?
Dialogue: 0,0:18:03.70,0:18:07.41,Default,,0,0,0,,Иә, мен қазір отбасыммен бірге тұрамын.
Dialogue: 0,0:18:07.50,0:18:10.50,Default,,0,0,0,,Сонда сіз жақсы көрінесіз бе?
Dialogue: 0,0:18:10.58,0:18:15.05,Default,,0,0,0,,Фейерверк фестивалінде юката кие алмағаныма көңілім қалды.
Dialogue: 0,0:18:15.13,0:18:16.80,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:18:17.42,0:18:20.76,Default,,0,0,0,,Мен саған тағы да қызғанышпен қарасам да.
Dialogue: 0,0:18:20.84,0:18:22.47,Default,,0,0,0,,Тіпті Нағиса да қарап тұрды.
Dialogue: 0,0:18:22.97,0:18:26.60,Default,,0,0,0,,Мен де Чинацу-сенпайды юкатасында көргеніме қуандым.
Dialogue: 0,0:18:26.68,0:18:28.44,Default,,0,0,0,,Содан кейін оны кесу уақыты келді.
Dialogue: 0,0:18:28.52,0:18:29.27,Default,,0,0,0,,Иә
Dialogue: 0,0:18:30.02,0:18:30.69,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:18:31.27,0:18:32.82,Default,,0,0,0,,Сонда сен қорқынышты тү көріпсің ғой.
Dialogue: 0,0:18:33.90,0:18:34.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:37.61,0:18:38.78,Default,,0,0,0,,(Оқушы) 15 минут па? (Изуку) Мен үшін ұпайлар аса маңызды емес.
Dialogue: 0,0:18:38.86,0:18:40.36,Default,,0,0,0,,Ағымдағы дауыс…
Dialogue: 0,0:18:40.45,0:18:43.08,Default,,0,0,0,,Жарайды, кесіп тастау керек еді.
Dialogue: 0,0:18:46.20,0:18:48.83,Default,,0,0,0,,Сіз жаңа ғана адамның дауысын естідіңіз бе?
Dialogue: 0,0:18:49.41,0:18:50.58,Default,,0,0,0,,Бұл ағай ма?
Dialogue: 0,0:18:51.67,0:18:53.17,Default,,0,0,0,,жақсы болар еді
Dialogue: 0,0:18:54.25,0:18:56.26,Default,,0,0,0,,Сіз шынымен жақсы доссыз.
Dialogue: 0,0:18:56.34,0:18:57.09,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:18:57.17,0:19:00.72,Default,,0,0,0,,Менің айналамда тек жақсы адамдар бар.
Dialogue: 0,0:19:04.81,0:19:07.72,Default,,0,0,0,,Негізі мен отшашу фестивалі туралы айтып едім.
Dialogue: 0,0:19:07.81,0:19:10.56,Default,,0,0,0,,Менің Чинацу-сенпайдан кешірім сұрайтыным бар.
Dialogue: 0,0:19:10.64,0:19:11.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:11.56,0:19:13.69,Default,,0,0,0,,Үйде әңгімелесіп отырған кезіміз
Dialogue: 0,0:19:13.77,0:19:16.98,Default,,0,0,0,,Мен бәріміз бірге барамыз дедім деп ойлаймын.
Dialogue: 0,0:19:17.07,0:19:19.70,Default,,0,0,0,,Бірақ соңында адамдар жинала алмады.
Dialogue: 0,0:19:20.20,0:19:22.32,Default,,0,0,0,,Сол күні Тадашидің де қызуы көтерілді.
Dialogue: 0,0:19:23.03,0:19:24.58,Default,,0,0,0,,Өйткені бұл бәрі емес.
Dialogue: 0,0:19:25.99,0:19:28.58,Default,,0,0,0,,Өйткені мен өтірік айтқан сияқтымын.
Dialogue: 0,0:19:29.33,0:19:32.25,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:19:36.34,0:19:39.76,Default,,0,0,0,,Көп кешірім сұраудың қажеті жоқ.
Dialogue: 0,0:19:39.84,0:19:42.13,Default,,0,0,0,,Жоқ, солай болуы мүмкін.
Dialogue: 0,0:19:43.22,0:19:46.51,Default,,0,0,0,,Бірақ мен кешірім сұрағым келді, сондықтан
Dialogue: 0,0:19:49.39,0:19:53.27,Default,,0,0,0,,Бір нәрсе үшін де мені кешіргеніңізді қалаймын.
Dialogue: 0,0:19:53.35,0:19:54.52,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:54.61,0:19:57.27,Default,,0,0,0,,Мен «бұл жақсы емес» дедім
Dialogue: 0,0:19:58.11,0:19:59.78,Default,,0,0,0,,Мен оны алып тастағым келеді.
Dialogue: 0,0:20:02.11,0:20:06.53,Default,,0,0,0,,Мен бір жақты сызық сызып, алаңдаттым.
Dialogue: 0,0:20:07.62,0:20:10.29,Default,,0,0,0,,Мен Дайки-кунға дөрекі болдым деп ойлаймын.
Dialogue: 0,0:20:10.37,0:20:12.04,Default,,0,0,0,,Жоқ, бұл дұрыс емес...
Dialogue: 0,0:20:13.17,0:20:15.75,Default,,0,0,0,,Мен Чинацу-сенпайдың сезімін түсінемін.
Dialogue: 0,0:20:16.42,0:20:18.46,Default,,0,0,0,,Және... аа...
Dialogue: 0,0:20:19.88,0:20:21.59,Default,,0,0,0,,Мен де солай
Dialogue: 0,0:20:22.09,0:20:23.30,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:23.38,0:20:25.72,Default,,0,0,0,,Кешірім сұрау үшін жолдан шығудың қажеті жоқ.
Dialogue: 0,0:20:25.80,0:20:26.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:30.18,0:20:32.06,Default,,0,0,0,,Енді біз өзара.
Dialogue: 0,0:20:32.14,0:20:33.35,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:35.65,0:20:38.07,Default,,0,0,0,,Енді карта ойнаймыз.
Dialogue: 0,0:20:38.57,0:20:40.32,Default,,0,0,0,,Екі адам болса, бірінші бет пе?
Dialogue: 0,0:20:40.40,0:20:41.94,Default,,0,0,0,,Мен мұны ешқашан жасаған емеспін ...
Dialogue: 0,0:20:42.03,0:20:43.32,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:56.75,0:20:57.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:02.76,0:21:03.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:05.43,0:21:06.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:14.94,0:21:17.77,Default,,0,0,0,,Неге футонда ұйықтамадың?
Dialogue: 0,0:21:17.85,0:21:19.77,Default,,0,0,0,,Сіздің денеңіз ауырады.
Dialogue: 0,0:21:36.46,0:21:37.46,Default,,0,0,0,,Ммм
Dialogue: 0,0:21:41.21,0:21:43.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:44.21,0:21:45.26,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:46.09,0:21:47.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:48.26,0:21:49.68,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:22:00.15,0:22:01.40,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:22:03.15,0:22:05.19,Default,,0,0,0,,Мен 17 жастамын
Dialogue: 0,0:22:06.49,0:22:08.49,Default,,0,0,0,,♪~
Dialogue: 0,0:23:33.49,0:23:35.49,Default,,0,0,0,,~♪
