Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:03.50,Default,,0,0,0,,♪~
Dialogue: 0,0:01:28.50,0:01:30.50,Default,,0,0,0,,~♪
Dialogue: 0,0:01:33.59,0:01:34.67,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:01:34.76,0:01:36.13,Default,,0,0,0,,Жарайды
Dialogue: 0,0:01:36.63,0:01:39.01,Default,,0,0,0,,Сіз келесі аптада қайтасыз, солай ма?
Dialogue: 0,0:01:39.09,0:01:40.18,Default,,0,0,0,,Аман қалсаң
Dialogue: 0,0:01:40.85,0:01:43.43,Default,,0,0,0,,Сәттілік тілеп, ренжімеңіз
Dialogue: 0,0:01:44.02,0:01:44.77,Default,,0,0,0,,Иә
Dialogue: 0,0:01:46.81,0:01:47.77,Default,,0,0,0,,I'm going
Dialogue: 0,0:01:49.73,0:01:50.69,Default,,0,0,0,,(алдыңғы есік жабылған дыбыс)
Dialogue: 0,0:01:58.86,0:01:59.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:00.95,0:02:03.83,Default,,0,0,0,,Мен әлі күнге дейін жұлдыздарды көріп тұрмын
Dialogue: 0,0:02:04.33,0:02:05.25,Default,,0,0,0,,Чинацу-сенпай!
Dialogue: 0,0:02:06.08,0:02:07.12,Default,,0,0,0,,Дайки-кун
Dialogue: 0,0:02:07.21,0:02:08.46,Default,,0,0,0,,Мен бір нәрсені ұмытып қалдым
Dialogue: 0,0:02:08.54,0:02:10.58,Default,,0,0,0,,Е... аа, рахмет
Dialogue: 0,0:02:10.67,0:02:11.25,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:02:14.67,0:02:16.38,Default,,0,0,0,,Маған бірдеңе айту керек
Dialogue: 0,0:02:16.88,0:02:20.80,Default,,0,0,0,,«Қолыңнан келгеннің бәрін жаса» деуге сөз жетпейтін сияқты.
Dialogue: 0,0:02:20.89,0:02:23.18,Default,,0,0,0,,«Басқа адам да жоғары сынып оқушысы»
Dialogue: 0,0:02:23.26,0:02:25.81,Default,,0,0,0,,Ол аю сияқты көрінеді.
Dialogue: 0,0:02:27.64,0:02:30.77,Default,,0,0,0,,Чинацу-сенпай Мисанга Бұл сынған жоқ, солай ма?
Dialogue: 0,0:02:30.85,0:02:32.69,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:02:32.77,0:02:36.15,Default,,0,0,0,,Мен орта мектепке барамын деп үміттендім.
Dialogue: 0,0:02:37.07,0:02:38.95,Default,,0,0,0,,Содан кейін тағы да қосыңыз.
Dialogue: 0,0:02:39.03,0:02:39.78,Default,,0,0,0,,Қосылды ма?
Dialogue: 0,0:02:40.36,0:02:42.91,Default,,0,0,0,,Ол сынған жоқ, сондықтан мүмкін болуы керек...
Dialogue: 0,0:02:44.20,0:02:47.29,Default,,0,0,0,,Чинацу-сенпай мүлде жарақат алған жоқ.
Dialogue: 0,0:02:47.37,0:02:50.46,Default,,0,0,0,,Алдыңғы жаттығуларыңыздың нәтижелерін толық пайдаланыңыз.
Dialogue: 0,0:02:50.54,0:02:53.46,Default,,0,0,0,,Сәнімен жеңе берсін
Dialogue: 0,0:02:53.54,0:02:54.54,Default,,0,0,0,,Нунуну...
Dialogue: 0,0:02:55.84,0:02:57.05,Default,,0,0,0,,Бұл тым көп емес пе?
Dialogue: 0,0:02:57.96,0:03:01.18,Default,,0,0,0,,Мен қысқартусыз Inter-High-ге қатыса алдым.
Dialogue: 0,0:03:01.26,0:03:02.30,Default,,0,0,0,,Мен ұзақ жүре аламын.
Dialogue: 0,0:03:03.34,0:03:05.14,Default,,0,0,0,,Қуат Мен оны сізге жіберемін!
Dialogue: 0,0:03:07.35,0:03:08.85,Default,,0,0,0,,Мен күшті сезбеймін...
Dialogue: 0,0:03:08.93,0:03:09.81,Default,,0,0,0,,Не!
Dialogue: 0,0:03:09.89,0:03:11.27,Default,,0,0,0,,Маған тікелей беріңіз
Dialogue: 0,0:03:12.73,0:03:13.56,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:17.61,0:03:18.44,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:03:19.53,0:03:20.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:22.78,0:03:25.78,Default,,0,0,0,,Электр қуаты таусылып қалса, мен оны сізге жіберемін.
Dialogue: 0,0:03:27.74,0:03:29.45,Default,,0,0,0,,Дайки-кун...
Dialogue: 0,0:03:29.54,0:03:31.62,Default,,0,0,0,,Ол өте жақсы адам, солай емес пе?
Dialogue: 0,0:03:32.29,0:03:33.29,Default,,0,0,0,,Не!
Dialogue: 0,0:03:33.37,0:03:34.63,Default,,0,0,0,,Әй, сәлем айт
Dialogue: 0,0:03:35.79,0:03:36.96,Default,,0,0,0,,Қош келдіңіз...
Dialogue: 0,0:03:38.09,0:03:40.47,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймын, бірақ...
Dialogue: 0,0:03:41.05,0:03:42.97,Default,,0,0,0,,Сіз мұны айттыңыз!
Dialogue: 0,0:03:45.55,0:03:48.43,Default,,0,0,0,,Менің көзқарасым бойынша, екеуі де бірдей.
Dialogue: 0,0:03:48.51,0:03:51.35,Default,,0,0,0,,Жоғары бесті сұрау адамгершілігі молырақ.
Dialogue: 0,0:03:51.85,0:03:54.65,Default,,0,0,0,,Сіздің істеп жатқан ісіңіз де таңқаларлық.
Dialogue: 0,0:03:55.15,0:04:00.23,Default,,0,0,0,,Ойланып қарасам, оның Чинацу-сенпайдың пікіріне қатысы бар ма, білмеймін.
Dialogue: 0,0:04:00.74,0:04:02.36,Default,,0,0,0,,Әйелдер автобусынан Имада ханым
Dialogue: 0,0:04:02.45,0:04:06.03,Default,,0,0,0,,Дайки мен Чоно-санның отшашу фестиваліне бірге барғанын білесіз бе?
Dialogue: 0,0:04:06.53,0:04:08.70,Default,,0,0,0,,Меніңше, Чинацу-сенпай да білетін шығар.
Dialogue: 0,0:04:08.79,0:04:09.49,Default,,0,0,0,,Не!
Dialogue: 0,0:04:10.08,0:04:13.50,Default,,0,0,0,,Дәлірек айтқанда, олар бірге кеткен сияқты, сондықтан бұл анық.
Dialogue: 0,0:04:14.58,0:04:15.83,Default,,0,0,0,,Нану!
Dialogue: 0,0:04:17.21,0:04:19.25,Default,,0,0,0,,Иә? Бір минут күте тұрыңыз
Dialogue: 0,0:04:19.92,0:04:21.51,Default,,0,0,0,,Мен де барлығымен бірге барамын.
Dialogue: 0,0:04:22.13,0:04:24.63,Default,,0,0,0,,Мен өтірік айтуым керек пе?
Dialogue: 0,0:04:25.34,0:04:26.72,Default,,0,0,0,,Сосын, Чинацу-сенпайдың ішінде
Dialogue: 0,0:04:26.80,0:04:30.68,Default,,0,0,0,,Ер адам өтірік айтуға дейін баратын қызбен отшашу фестиваліне барады...
Dialogue: 0,0:04:32.35,0:04:37.06,Default,,0,0,0,,Жоқ, екеуміз бірге барғанымыз рас.
Dialogue: 0,0:04:38.19,0:04:39.02,Default,,0,0,0,,шыңдалған
Dialogue: 0,0:04:40.40,0:04:41.40,Default,,0,0,0,,Жаттығу
Dialogue: 0,0:04:41.48,0:04:44.03,Default,,0,0,0,,Уа, ауысу мен күткеннен жылдамырақ.
Dialogue: 0,0:04:44.11,0:04:47.32,Default,,0,0,0,,Мүмкін адамдар оны кездесу деп ойлаған шығар.
Dialogue: 0,0:04:47.82,0:04:50.12,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:04:50.62,0:04:53.04,Default,,0,0,0,,Мен тек соңында өтірік айтқаным үшін кешірім сұраймын.
Dialogue: 0,0:04:54.00,0:04:56.04,Default,,0,0,0,,Енді көп нәрсе істеу керек.
Dialogue: 0,0:04:58.13,0:05:01.84,Default,,0,0,0,,Чинацу-сенпай да ондай емес, сондықтан оған бәрібір.
Dialogue: 0,0:05:02.34,0:05:04.05,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:05:06.13,0:05:07.64,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:05:08.14,0:05:10.05,Default,,0,0,0,,Олай болса, осылайша...
Dialogue: 0,0:05:10.64,0:05:12.81,Default,,0,0,0,,Хина да зейін қойып отыр.
Dialogue: 0,0:05:12.89,0:05:15.06,Default,,0,0,0,,Өйткені, бұл Inter-High.
Dialogue: 0,0:05:15.89,0:05:17.94,Default,,0,0,0,,Бұл да әбден дірілдейді.
Dialogue: 0,0:05:18.02,0:05:20.44,Default,,0,0,0,,Эй, бұл біртүрлі емес пе?
Dialogue: 0,0:05:20.52,0:05:22.94,Default,,0,0,0,,Жоғары оқу орны аралық
Dialogue: 0,0:05:23.53,0:05:26.11,Default,,0,0,0,,Баскетбол – Кюсюда, волейбол – Тохокуде
Dialogue: 0,0:05:26.20,0:05:28.20,Default,,0,0,0,,Көркем гимнастика Қансайда
Dialogue: 0,0:05:28.28,0:05:30.70,Default,,0,0,0,,Бадо — көрші префектура.
Dialogue: 0,0:05:30.78,0:05:31.70,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:05:32.49,0:05:35.96,Default,,0,0,0,,Жоқ, бірақ сіздің арқаңызда біз де барып, сізді қолдаймыз.
Dialogue: 0,0:05:36.04,0:05:38.00,Default,,0,0,0,,Сіз бұл туралы айтқан жоқсыз.
Dialogue: 0,0:05:38.08,0:05:39.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:39.13,0:05:41.71,Default,,0,0,0,,Дәмді тамақ жеп, ыстық суға барғым келеді.
Dialogue: 0,0:05:41.79,0:05:44.42,Default,,0,0,0,,Өте қиын, Харю, мен саяхаттағанды ​​жақсы көремін.
Dialogue: 0,0:05:44.51,0:05:46.84,Default,,0,0,0,,Жоқ, Интерхайға дейін 3 күн қалды.
Dialogue: 0,0:05:46.92,0:05:49.47,Default,,0,0,0,,Сонда да оның сабырлы ойыны таң қалдырады.
Dialogue: 0,0:05:49.55,0:05:51.97,Default,,0,0,0,,Келесі кім?
Dialogue: 0,0:05:52.68,0:05:54.47,Default,,0,0,0,,Сәлем! Уф...
Dialogue: 0,0:05:55.06,0:05:56.10,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:05:56.18,0:05:57.52,Default,,0,0,0,,Өзіңізге жеңіл жүрмеңіз
Dialogue: 0,0:05:57.60,0:05:58.94,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:06:02.94,0:06:04.86,Default,,0,0,0,,Адамдар көп.
Dialogue: 0,0:06:05.74,0:06:08.86,Default,,0,0,0,,Барлығы аман қалып, елдің түкпір-түкпірінен жиналды.
Dialogue: 0,0:06:10.87,0:06:12.99,Default,,0,0,0,,Сачи өзенінің Юса-кун
Dialogue: 0,0:06:13.74,0:06:16.00,Default,,0,0,0,,Келесі жылғы орта мектептің 2 ұясы
Dialogue: 0,0:06:16.58,0:06:18.58,Default,,0,0,0,,Менің ойымша, бұл Харю мен Юса болуды шешті.
Dialogue: 0,0:06:23.54,0:06:25.76,Default,,0,0,0,,Daiki Inomata?
Dialogue: 0,0:06:26.92,0:06:27.76,Default,,0,0,0,,Хана Кой-сан
Dialogue: 0,0:06:28.47,0:06:31.26,Default,,0,0,0,,Түсіндім, сен Харю-сенпайды қолдауға келдің бе?
Dialogue: 0,0:06:31.34,0:06:33.26,Default,,0,0,0,,Бұл дұрыс болды
Dialogue: 0,0:06:33.35,0:06:34.93,Default,,0,0,0,,Бүгін ойын бар.
Dialogue: 0,0:06:35.01,0:06:37.52,Default,,0,0,0,,Дәл қазір мен Чимен телефон арқылы сөйлестім.
Dialogue: 0,0:06:38.10,0:06:39.02,Default,,0,0,0,,Ауыстыру керек пе?
Dialogue: 0,0:06:40.19,0:06:42.52,Default,,0,0,0,,Менің сөйлескім келеді.
Dialogue: 0,0:06:43.90,0:06:44.77,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:06:44.86,0:06:48.78,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,0:06:48.86,0:06:50.99,Default,,0,0,0,,Аа, кешіріңіз, ол кесілді ме?
Dialogue: 0,0:06:51.07,0:06:53.20,Default,,0,0,0,,Сөзсіз сенімді қылмыскер!
Dialogue: 0,0:06:53.28,0:06:55.62,Default,,0,0,0,,Күткендей, Харю-сенпайдың құрбысы
Dialogue: 0,0:06:55.70,0:06:59.29,Default,,0,0,0,,Кешіріңіз, кешіріңіз, мен өзіме ұнайтын адаммен сөйлескім келді.
Dialogue: 0,0:06:59.37,0:07:00.87,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:07:00.96,0:07:01.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:01.62,0:07:03.50,Default,,0,0,0,,Неліктен сізге ұнайды?
Dialogue: 0,0:07:03.58,0:07:05.55,Default,,0,0,0,,Мен дәл қазір реакциядан түсіндім.
Dialogue: 0,0:07:06.42,0:07:10.80,Default,,0,0,0,,Мені қашаннан бері ұнатасың? Сіз бірге көшкенге дейін бе? Кейін?
Dialogue: 0,0:07:10.88,0:07:13.14,Default,,0,0,0,,Сіз тіпті бірге тұру туралы білесіз бе?
Dialogue: 0,0:07:13.22,0:07:15.43,Default,,0,0,0,,Мен Чинацудан сол аймақ туралы сұрадым.
Dialogue: 0,0:07:15.51,0:07:19.06,Default,,0,0,0,,Бұл қиын. Сізге ұнайтын адаммен өмір сүру.
Dialogue: 0,0:07:19.14,0:07:21.19,Default,,0,0,0,,Бұл қиын...
Dialogue: 0,0:07:22.19,0:07:25.61,Default,,0,0,0,,Бір мектептегі адамдармен сөйлесу қиын болатынын түсінемін.
Dialogue: 0,0:07:25.69,0:07:27.19,Default,,0,0,0,,Мен Хана Коймен сөйлесе аламын.
Dialogue: 0,0:07:27.78,0:07:31.24,Default,,0,0,0,,Амансың ба? Эй, жақсысың ба?
Dialogue: 0,0:07:31.32,0:07:33.32,Default,,0,0,0,,Ки Мен оны көп қолданбаймын деп ойлаймын.
Dialogue: 0,0:07:33.82,0:07:35.99,Default,,0,0,0,,Үйдегі заттарды да ұқыпты пайдаланады.
Dialogue: 0,0:07:36.49,0:07:38.83,Default,,0,0,0,,Жууға белсенді түрде көмектесу т.б.
Dialogue: 0,0:07:38.91,0:07:41.83,Default,,0,0,0,,Сіз кейде жоққа қарап отырмайсыз ба?
Dialogue: 0,0:07:41.91,0:07:43.33,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:43.92,0:07:44.79,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:07:44.88,0:07:48.13,Default,,0,0,0,,Мен тәтті жей бастағанда, ол маған қадала бастады.
Dialogue: 0,0:07:48.63,0:07:50.59,Default,,0,0,0,,Біз өз көзімізбен шағымдануға бейімбіз.
Dialogue: 0,0:07:51.59,0:07:56.01,Default,,0,0,0,,Тек Чинацу-сенпайдың төңірегінде уақыт баяу өтіп бара жатқандай сезіледі.
Dialogue: 0,0:07:56.51,0:07:57.85,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:08:00.43,0:08:03.02,Default,,0,0,0,,Біз бірге өмір сүретін сияқтымыз.
Dialogue: 0,0:08:03.10,0:08:03.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:06.19,0:08:08.11,Default,,0,0,0,,Сіз шынымен келдіңіз бе?
Dialogue: 0,0:08:08.19,0:08:10.40,Default,,0,0,0,,Не? Қалай айту керек
Dialogue: 0,0:08:10.48,0:08:12.24,Default,,0,0,0,,Тіпті Хана Кой да бос емес пе?
Dialogue: 0,0:08:12.32,0:08:14.11,Default,,0,0,0,,Дұрыс реттелген
Dialogue: 0,0:08:14.70,0:08:17.87,Default,,0,0,0,,Сүйкімді дос қызыңыздың қолдауына ие болсаңыз, мотивация аласыз.
Dialogue: 0,0:08:17.95,0:08:19.49,Default,,0,0,0,,Өзіңіз айтпаңыз
Dialogue: 0,0:08:19.58,0:08:21.04,Default,,0,0,0,,Сіздің қарсыласыңыз мықты ма?
Dialogue: 0,0:08:21.12,0:08:22.33,Default,,0,0,0,,Шамамен солай шығар
Dialogue: 0,0:08:22.41,0:08:24.50,Default,,0,0,0,,- (Ханакой) Сіз жүктеп салдыңыз ба? -(Харю) Бұдан былай
Dialogue: 0,0:08:24.58,0:08:26.50,Default,,0,0,0,,Жеңіске жеткеніңізге көз жеткізіңіз
Dialogue: 0,0:08:27.17,0:08:28.38,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:08:31.71,0:08:32.38,Default,,0,0,0,,Мелло
Dialogue: 0,0:08:32.47,0:08:34.22,Default,,0,0,0,,Иә, №5 сот.
Dialogue: 0,0:08:34.30,0:08:35.26,Default,,0,0,0,,(Смартфонның діріл дыбысы)
Dialogue: 0,0:08:38.26,0:08:41.47,Default,,0,0,0,,Кешіріңіз, мен сізге жұмыс туралы біраз уақыттан кейін хабарласамын.
Dialogue: 0,0:08:41.97,0:08:42.64,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:42.73,0:08:46.40,Default,,0,0,0,,Бұл керемет, Харю-сенпай мен Хана Кой-сан.
Dialogue: 0,0:08:46.48,0:08:49.65,Default,,0,0,0,,Үйірме әрекеттерін, жұмысты және махаббат өмірін теңестіру
Dialogue: 0,0:08:50.23,0:08:50.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:51.48,0:08:56.03,Default,,0,0,0,,Сіз Чимен кездесетін сияқтысыз ба, бірақ екеуін теңестіру мәселе болып табылады ма?
Dialogue: 0,0:08:56.11,0:08:58.28,Default,,0,0,0,,Мен өзім туралы айтып тұрған жоқпын.
Dialogue: 0,0:08:58.37,0:09:00.54,Default,,0,0,0,,Өте жақсы емес.
Dialogue: 0,0:09:00.62,0:09:01.87,Default,,0,0,0,,Алдымен біз де
Dialogue: 0,0:09:01.95,0:09:04.83,Default,,0,0,0,,Менің ойымша, бір нәрсеге назар аударған дұрыс.
Dialogue: 0,0:09:04.91,0:09:06.25,Default,,0,0,0,,Мен абдырап қалдым.
Dialogue: 0,0:09:07.54,0:09:10.29,Default,,0,0,0,,Мен Кенгоны 5-сыныптан бері білемін.
Dialogue: 0,0:09:10.38,0:09:13.21,Default,,0,0,0,,Тіпті кіші мектеп оқушысы болып, соны түсіне бастаған кезде де
Dialogue: 0,0:09:13.30,0:09:16.59,Default,,0,0,0,,Мүмкін екеуміз де бірдеңе жасағымыз келеді деп ойлаған шығармыз.
Dialogue: 0,0:09:16.68,0:09:18.93,Default,,0,0,0,,Мен басқа адамның да солай ойлайтынын сеземін.
Dialogue: 0,0:09:19.72,0:09:23.31,Default,,0,0,0,,Бірақ кейде біз бірге ойнағанда немесе телефонмен сөйлескенде,
Dialogue: 0,0:09:23.39,0:09:26.69,Default,,0,0,0,,Бұл қандай қатынас? ...Мен қиналдым.
Dialogue: 0,0:09:27.19,0:09:28.06,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:28.65,0:09:33.19,Default,,0,0,0,,Бірақ бір күні екеуінің қарым-қатынасы кенеттен өзгереді.
Dialogue: 0,0:09:33.28,0:09:35.07,Default,,0,0,0,,Кенеттен сөйлеу реңі?
Dialogue: 0,0:09:35.15,0:09:38.57,Default,,0,0,0,,Сол күні мен жұмыста қатты күйзелдім.
Dialogue: 0,0:09:39.28,0:09:42.12,Default,,0,0,0,,Мен Кенгодан телефонмен сөйлесуін өтіндім.
Dialogue: 0,0:09:42.20,0:09:45.58,Default,,0,0,0,,Қоңырау аяқталғаннан кейін біраз уақыттан кейін маған хабарлама келді.
Dialogue: 0,0:09:45.66,0:09:47.33,Default,,0,0,0,,(Смартфонның діріл дыбысы)
Dialogue: 0,0:09:50.33,0:09:52.09,Default,,0,0,0,,- (Хана Кой) Кенго - (Харюу) Ах!
Dialogue: 0,0:09:52.17,0:09:53.67,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:54.17,0:09:56.84,Default,,0,0,0,,Мен жүгіріп келе жатқанда мынаны саған беремін деп ойладым.
Dialogue: 0,0:09:56.92,0:09:58.34,Default,,0,0,0,,Мен оны әлдеқашан салып қойғанмын
Dialogue: 0,0:09:58.43,0:10:02.51,Default,,0,0,0,,2-сыныпта оқып жүрген кездегі күнделігім алғаш рет жарық көрді.
Dialogue: 0,0:10:02.60,0:10:03.85,Default,,0,0,0,,Күнделік?
Dialogue: 0,0:10:04.81,0:10:07.60,Default,,0,0,0,,Бұл оқу материалы ретінде жақсы. Бұл қызықсыз.
Dialogue: 0,0:10:08.19,0:10:09.90,Default,,0,0,0,,Ұйықтар алдында осыны оқы
Dialogue: 0,0:10:09.98,0:10:12.36,Default,,0,0,0,,Ақымақ жігіт болса да, көңіліңді көтер.
Dialogue: 0,0:10:12.44,0:10:14.15,Default,,0,0,0,,Өйткені бұл гүлге деген махаббат туралы.
Dialogue: 0,0:10:14.65,0:10:17.36,Default,,0,0,0,,Шындап ойласаң, тыным таппайсың.
Dialogue: 0,0:10:18.99,0:10:22.62,Default,,0,0,0,,Шешім болса, оянғаннан кейін сенімен бірге ойланып көремін.
Dialogue: 0,0:10:25.62,0:10:26.33,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:10:26.83,0:10:28.12,Default,,0,0,0,,Сен шынымен ақымақсың.
Dialogue: 0,0:10:28.21,0:10:30.96,Default,,0,0,0,,Дұрыс? Әсіресе ұсынылады...
Dialogue: 0,0:10:37.88,0:10:39.63,Default,,0,0,0,,Егер осындай жағдай орын алса...
Dialogue: 0,0:10:40.13,0:10:42.47,Default,,0,0,0,,Сіз Кенго туралы ойлап отырсыз.
Dialogue: 0,0:10:45.22,0:10:47.60,Default,,0,0,0,,Мойындау ағымында
Dialogue: 0,0:10:48.10,0:10:51.02,Default,,0,0,0,,Мен енді шыдай алмадым.
Dialogue: 0,0:10:51.10,0:10:53.36,Default,,0,0,0,,Бұл адам да олимпиадалық деңгейде.
Dialogue: 0,0:10:53.44,0:10:54.65,Default,,0,0,0,,Алтын медаль иегері!
Dialogue: 0,0:10:54.73,0:10:59.65,Default,,0,0,0,,Сол жерден сөйлесе бастадық, Кенго да басында қобалжыды.
Dialogue: 0,0:10:59.74,0:11:02.32,Default,,0,0,0,,Біреуіміз үйірме жұмыстарына және жұмысына немқұрайлы қарасақ ше?
Dialogue: 0,0:11:02.41,0:11:04.99,Default,,0,0,0,,Сонымен біз ажырасуды шештік, сондықтан біз кездесе бастадық.
Dialogue: 0,0:11:05.49,0:11:09.50,Default,,0,0,0,,Екеуіміздің де бір-бірімізге деген сезімі бар екенін түсінген соң, бұрынғыдай қарым-қатынас жасай алмадық.
Dialogue: 0,0:11:10.67,0:11:13.88,Default,,0,0,0,,Сіз мұны жасамаған болсаңыз да, қиялыңызға сүйене отырып, оны жоққа шығармаңыз.
Dialogue: 0,0:11:13.96,0:11:16.34,Default,,0,0,0,,Себебі мен сенбедім
Dialogue: 0,0:11:17.63,0:11:21.72,Default,,0,0,0,,Сонымен, біз әлі де тәжірибе жасап жатырмыз.
Dialogue: 0,0:11:23.34,0:11:24.43,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:11:24.51,0:11:25.89,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:11:25.97,0:11:27.93,Default,,0,0,0,,Әйтеуір, Харю ағалары
Dialogue: 0,0:11:28.02,0:11:30.68,Default,,0,0,0,,Мен сізді «қабілетті адам» деп ойладым
Dialogue: 0,0:11:34.77,0:11:36.44,Default,,0,0,0,,Керемет! Мен бара аламын!
Dialogue: 0,0:11:36.52,0:11:37.44,Default,,0,0,0,,Ине балығы!
Dialogue: 0,0:11:41.03,0:11:42.53,Default,,0,0,0,,Бірінші ойын бір-ақ
Dialogue: 0,0:11:46.37,0:11:46.95,Default,,0,0,0,,Керемет!
Dialogue: 0,0:11:49.33,0:11:52.33,Default,,0,0,0,,Мен: Чинацу-сенпай не ойлап отыр.
Dialogue: 0,0:11:52.42,0:11:53.87,Default,,0,0,0,,Мен оны мүлдем түсінбеймін
Dialogue: 0,0:11:54.75,0:11:58.46,Default,,0,0,0,,Мен не ойлайтынымды айтпадым.
Dialogue: 0,0:12:00.38,0:12:03.13,Default,,0,0,0,,Осы уақытқа дейін қалғаныңа қуаныштымын, Харю.
Dialogue: 0,0:12:03.22,0:12:05.97,Default,,0,0,0,,Мен сенімен соғыспайынша жеңіле алмаймын
Dialogue: 0,0:12:06.47,0:12:10.06,Default,,0,0,0,,Финал емес, үшінші раунд болғаны ұят.
Dialogue: 0,0:12:10.81,0:12:12.98,Default,,0,0,0,,Енді ойлап қарасам, өткен күні менің бірінші курсым
Dialogue: 0,0:12:13.06,0:12:15.40,Default,,0,0,0,,Сізде қызықты оқиға болған сияқты.
Dialogue: 0,0:12:16.19,0:12:19.28,Default,,0,0,0,,Келесі жылы осында болатын екі адам кім?
Dialogue: 0,0:12:21.24,0:12:23.90,Default,,0,0,0,,Дайки екеумізге көңіліңіз толмай ма?
Dialogue: 0,0:12:25.03,0:12:27.12,Default,,0,0,0,,Өткізу орны келесі жылы бұл жерде болмайды.
Dialogue: 0,0:12:27.20,0:12:28.91,Default,,0,0,0,,Мен оны жеткізе алмаймын.
Dialogue: 0,0:12:29.49,0:12:31.66,Default,,0,0,0,,Шағымданатын ештеңе жоқ.
Dialogue: 0,0:12:32.16,0:12:34.29,Default,,0,0,0,,Жеңімпаз шығады.
Dialogue: 0,0:12:34.79,0:12:36.83,Default,,0,0,0,,Жай ғана Харю
Dialogue: 0,0:12:36.92,0:12:40.46,Default,,0,0,0,,Сен бүгін менен бір ойын алуың керек.
Dialogue: 0,0:12:40.96,0:12:42.67,Default,,0,0,0,,Келесі жылы келе алмауым мүмкін.
Dialogue: 0,0:12:43.26,0:12:47.18,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Біз жеңіске жеттік.
Dialogue: 0,0:12:47.76,0:12:50.93,Default,,0,0,0,,Сачигава орта мектебінен Хиодо мырзаға қоңырау шалу
Dialogue: 0,0:12:51.02,0:12:53.60,Default,,0,0,0,,Эймей орта мектебі Харю-кун
Dialogue: 0,0:12:53.68,0:12:55.69,Default,,0,0,0,,9-сотқа жиналыңыз.
Dialogue: 0,0:13:04.15,0:13:06.70,Default,,0,0,0,,Бұл мәселе, Харю.
Dialogue: 0,0:13:07.24,0:13:10.66,Default,,0,0,0,,Шабуылға бір қадам жылдамырақ өтсек, ұпай жинауымыз керек.
Dialogue: 0,0:13:10.74,0:13:14.21,Default,,0,0,0,,Мен тым сақ болып, қорғаныста ойнаймын.
Dialogue: 0,0:13:14.91,0:13:18.08,Default,,0,0,0,,Осы уақытқа дейін сен маған осылай ұпай жоғалтып келдің.
Dialogue: 0,0:13:19.13,0:13:21.17,Default,,0,0,0,,Жеңілу бейнесі бойыңа сіңген
Dialogue: 0,0:13:22.21,0:13:24.30,Default,,0,0,0,,Бір ойын алынды.
Dialogue: 0,0:13:24.88,0:13:26.59,Default,,0,0,0,,Сіз әлі де жеңе аласыз, солай ма?
Dialogue: 0,0:13:26.68,0:13:30.35,Default,,0,0,0,,21 ұпайлық матч, екі ойында бірінші болып жеңіске жеткен
Dialogue: 0,0:13:31.18,0:13:34.10,Default,,0,0,0,,Бұл жаман, Хиодо мырзаның қарқыны.
Dialogue: 0,0:13:34.60,0:13:36.69,Default,,0,0,0,,Префектуралық іріктеу кезеңінің қайталауы дерлік.
Dialogue: 0,0:13:38.19,0:13:40.36,Default,,0,0,0,,Сіз қобалжыған сияқтысыз.
Dialogue: 0,0:13:41.77,0:13:44.11,Default,,0,0,0,,Сол гүлге деген махаббат сирек
Dialogue: 0,0:13:45.65,0:13:48.95,Default,,0,0,0,,Мен Хана Коймен алғаш рет 5-сыныпта оқып жүрген кезімде кездестім.
Dialogue: 0,0:13:49.45,0:13:52.62,Default,,0,0,0,,- (Әйел) Харю-кун - (Әйел) Сабақтан кейін маған математиканы үйретші
Dialogue: 0,0:13:52.70,0:13:55.87,Default,,0,0,0,,Нашар, мен сәрсенбіде суға барамын.
Dialogue: 0,0:13:55.96,0:13:59.29,Default,,0,0,0,,Ата-анамның қалауы бойынша түрлі сабақтар алдым.
Dialogue: 0,0:13:59.38,0:14:02.84,Default,,0,0,0,,Дүйсенбі Фортепиано Сәрсенбі Жүзу Сенбі Крам мектебі
Dialogue: 0,0:14:02.92,0:14:04.38,Default,,0,0,0,,Бір кезде мен де каллиграфиямен айналыстым.
Dialogue: 0,0:14:05.21,0:14:08.51,Default,,0,0,0,,Осы кезде әкем мені ермек үшін ертіп барды.
Dialogue: 0,0:14:08.59,0:14:09.89,Default,,0,0,0,,Бадминтон шеңберінде
Dialogue: 0,0:14:09.97,0:14:13.39,Default,,0,0,0,,Мен Будқа тәуелдімін, бірақ бұл басқа әңгіме.
Dialogue: 0,0:14:14.35,0:14:16.56,Default,,0,0,0,,Мен көп нәрседе жақсымын.
Dialogue: 0,0:14:16.64,0:14:19.94,Default,,0,0,0,,Менің ептілігім менің күшім деп ойлаған кезде
Dialogue: 0,0:14:20.02,0:14:21.40,Default,,0,0,0,,Мен Хана Коймен таныстым
Dialogue: 0,0:14:22.19,0:14:24.40,Default,,0,0,0,,Бүгіннен бастап сіз жаңа дос боласыз.
Dialogue: 0,0:14:24.48,0:14:26.78,Default,,0,0,0,,Бұл Мория Хана Кой-чан.
Dialogue: 0,0:14:26.86,0:14:28.20,Default,,0,0,0,,Бес бос дәптер парағы
Dialogue: 0,0:14:28.28,0:14:29.61,Default,,0,0,0,,-(Оқушы) Сүйкімді -(Оқушы) Жетілген тәрізді
Dialogue: 0,0:14:29.70,0:14:31.28,Default,,0,0,0,,Ұзын аяқты әдемі әйел
Dialogue: 0,0:14:31.91,0:14:34.03,Default,,0,0,0,,-(Жаттықтырушы) Ал, жүзіп көрейік. -(Хана Кой) Иә!
Dialogue: 0,0:14:34.12,0:14:35.83,Default,,0,0,0,,Кім қараса да сұлу
Dialogue: 0,0:14:35.91,0:14:40.25,Default,,0,0,0,,Ондағылардың бәрі ғашық болды...бірақ ғашық болмаса да.
Dialogue: 0,0:14:40.83,0:14:42.75,Default,,0,0,0,,Мория-сан, тұра тұр!
Dialogue: 0,0:14:42.84,0:14:44.04,Default,,0,0,0,,Бұл қол!
Dialogue: 0,0:14:44.80,0:14:45.96,Default,,0,0,0,,Бухаха
Dialogue: 0,0:14:46.46,0:14:48.72,Default,,0,0,0,,Уау, оттегі өте дәмді.
Dialogue: 0,0:14:48.80,0:14:50.05,Default,,0,0,0,,-(Харю) Эй -(Ханакой) Иә?
Dialogue: 0,0:14:50.63,0:14:53.30,Default,,0,0,0,,Неліктен жүзу мектебіне бару қиынға соғады?
Dialogue: 0,0:14:53.39,0:14:54.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:54.64,0:14:56.31,Default,,0,0,0,,Менің қолымнан келмейтін нәрселер, оларды орындаудың не қажеті бар?
Dialogue: 0,0:14:57.02,0:14:59.81,Default,,0,0,0,,Ұялғаныңыздың саны артады.
Dialogue: 0,0:15:02.31,0:15:03.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:05.90,0:15:07.32,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:15:07.40,0:15:09.32,Default,,0,0,0,,Онда маған айт.
Dialogue: 0,0:15:10.15,0:15:12.62,Default,,0,0,0,,Маған ұялып, аясаң
Dialogue: 0,0:15:12.70,0:15:14.33,Default,,0,0,0,,Маған айта алатын адам
Dialogue: 0,0:15:14.83,0:15:16.83,Default,,0,0,0,,Сондықтан мен мұнда келдім.
Dialogue: 0,0:15:18.08,0:15:19.08,Default,,0,0,0,,Мен сондаймын...
Dialogue: 0,0:15:19.66,0:15:21.50,Default,,0,0,0,,Егер сіз жүзе алмасаңыз, бұл мәселе, солай емес пе?
Dialogue: 0,0:15:21.58,0:15:24.34,Default,,0,0,0,,Мен дельфиндермен жүзуді армандадым.
Dialogue: 0,0:15:24.42,0:15:26.09,Default,,0,0,0,,Сондықтан ма?
Dialogue: 0,0:15:26.17,0:15:29.92,Default,,0,0,0,,Сондай-ақ, мен мұны істедім деп ойламайынша орындаған жоқпын.
Dialogue: 0,0:15:30.01,0:15:32.59,Default,,0,0,0,,Маған жақсы емес деп айтқанды ұнатпаймын.
Dialogue: 0,0:15:33.51,0:15:36.10,Default,,0,0,0,,Мен осы уақытқа дейін немен айналыспадым
Dialogue: 0,0:15:36.18,0:15:38.85,Default,,0,0,0,,Болашақ мен де бұл міндетті түрде жаман болмайды.
Dialogue: 0,0:15:39.43,0:15:40.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:42.44,0:15:45.15,Default,,0,0,0,,Соңында мен Ханакойды тастадым.
Dialogue: 0,0:15:45.23,0:15:48.11,Default,,0,0,0,,Енді жорғалап жүріп 50 метрге жүзе аласыз.
Dialogue: 0,0:15:48.19,0:15:49.82,Default,,0,0,0,,Мен жаттықтырушыны жылаттым
Dialogue: 0,0:15:51.20,0:15:55.12,Default,,0,0,0,,Әртүрлі мектепте оқысақ та, бір-бірімізге жақын тұрдық.
Dialogue: 0,0:15:55.82,0:15:57.62,Default,,0,0,0,,Әйтеуір ойнай бастадым
Dialogue: 0,0:15:57.70,0:15:58.45,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:15:58.95,0:16:00.54,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:16:00.62,0:16:03.17,Default,,0,0,0,,Ол Буд турнирінде жеңіске жеткенін айтты.
Dialogue: 0,0:16:03.25,0:16:04.96,Default,,0,0,0,,Мен тамақ ішуге шығуды ойладым.
Dialogue: 0,0:16:05.46,0:16:09.25,Default,,0,0,0,,Бірдеңе болып қалса, бір-бірін біліп, жігерлендіріңіз.
Dialogue: 0,0:16:09.76,0:16:12.01,Default,,0,0,0,,Қарым-қатынасты алға жылжытқыңыз келсе де
Dialogue: 0,0:16:12.09,0:16:16.10,Default,,0,0,0,,Сүйіспеншілікке кедергі жасамау керек сияқты сылтаулар ойлап табамын.
Dialogue: 0,0:16:18.06,0:16:18.72,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:16:19.72,0:16:22.14,Default,,0,0,0,,Кенго Мен сені жақсы көремін
Dialogue: 0,0:16:23.44,0:16:25.06,Default,,0,0,0,,Менің кеудем ауырды
Dialogue: 0,0:16:25.73,0:16:28.36,Default,,0,0,0,,Сусабынның иісін сезгенде
Dialogue: 0,0:16:28.44,0:16:32.03,Default,,0,0,0,,Мен ұялып төмен қарап тұрған Хана Койды жақсы көретін сияқтымын.
Dialogue: 0,0:16:32.11,0:16:34.66,Default,,0,0,0,,Мен өз сезімімді білдірмедім.
Dialogue: 0,0:16:36.20,0:16:37.91,Default,,0,0,0,,Мені аяғандықтан
Dialogue: 0,0:16:39.99,0:16:42.66,Default,,0,0,0,,Ханакой әрқашан ең керемет.
Dialogue: 0,0:16:42.75,0:16:45.46,Default,,0,0,0,,Мен жақсы болмаған жүзуді жеңу
Dialogue: 0,0:16:45.96,0:16:48.17,Default,,0,0,0,,Қорқынышты, ұят т.б.
Dialogue: 0,0:16:48.25,0:16:51.92,Default,,0,0,0,,Менің осындай қызым болса да, мен қиындықты шешуді таңдаймын.
Dialogue: 0,0:16:52.63,0:16:55.93,Default,,0,0,0,,Маған бұл жерде не жақсы екенін көрсетпе, сен не істейсің?
Dialogue: 0,0:16:57.55,0:16:58.68,Default,,0,0,0,,Біз жетіп жатырмыз
Dialogue: 0,0:16:59.76,0:17:00.93,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:17:02.52,0:17:04.44,Default,,0,0,0,,Харю-сенпай шайқасы!
Dialogue: 0,0:17:04.52,0:17:05.69,Default,,0,0,0,,Аяғыңызды қолданыңыз!
Dialogue: 0,0:17:05.77,0:17:06.77,Default,,0,0,0,,(Сирена қосылады)
Dialogue: 0,0:17:08.27,0:17:09.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:14.03,0:17:15.57,Default,,0,0,0,,Мен бір ойынды қайтардым!
Dialogue: 0,0:17:18.07,0:17:18.99,Default,,0,0,0,,бірақ соғыс бишісі Вараби-химе маған берген бұл белдемше
Dialogue: 0,0:17:19.78,0:17:20.74,Default,,0,0,0,,Сіз әлі де бара аласыз!
Dialogue: 0,0:17:21.83,0:17:22.75,Default,,0,0,0,,Бұл жер қай жер?
Dialogue: 0,0:17:23.45,0:17:25.00,Default,,0,0,0,,Дене қызуының жоғарылауын сезіну
Dialogue: 0,0:17:26.08,0:17:27.75,Default,,0,0,0,,Аяқтар әлі де қозғалады
Dialogue: 0,0:17:28.75,0:17:30.75,Default,,0,0,0,,Мен алыстан қолдау дауыстарын естимін.
Dialogue: 0,0:17:30.84,0:17:32.25,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:17:32.84,0:17:34.26,Default,,0,0,0,,Мен сабырлы ойнай аламын.
Dialogue: 0,0:17:36.84,0:17:37.76,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:17:38.64,0:17:41.26,Default,,0,0,0,,Бұл үш нүктелік айырмашылық ешқашан азаймайды.
Dialogue: 0,0:17:41.93,0:17:43.56,Default,,0,0,0,,...
Dialogue: 0,0:17:43.64,0:17:45.02,Default,,0,0,0,,Басқа адамға дұрыс қараңыз
Dialogue: 0,0:17:45.60,0:17:47.14,Default,,0,0,0,,Мен бір ойында жеңіске жеттім.
Dialogue: 0,0:17:47.23,0:17:48.90,Default,,0,0,0,,Қабілет айырмашылығы онша үлкен емес.
Dialogue: 0,0:17:50.06,0:17:52.40,Default,,0,0,0,,Тоқтамаңыз, әрекет етіңіз
Dialogue: 0,0:17:52.98,0:17:54.15,Default,,0,0,0,,Содан кейін ол келеді
Dialogue: 0,0:17:54.99,0:17:56.24,Default,,0,0,0,,келді!
Dialogue: 0,0:17:56.74,0:17:57.65,Default,,0,0,0,,келді!
Dialogue: 0,0:18:02.24,0:18:03.20,Default,,0,0,0,,(Шаттлдың құлаған дыбысы)
Dialogue: 0,0:18:03.29,0:18:04.16,Default,,0,0,0,,Бұл дәл сен күткендей.
Dialogue: 0,0:18:04.87,0:18:06.75,Default,,0,0,0,,Сачигава орта мектебі Хиодо-кун
Dialogue: 0,0:18:12.17,0:18:13.00,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:18:14.55,0:18:16.88,Default,,0,0,0,,Сіз әлі де осылай соққы жасай аласыз ба?
Dialogue: 0,0:18:16.97,0:18:18.43,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:18:19.26,0:18:22.93,Default,,0,0,0,,Екі жыл сенімен күресу қызық болды.
Dialogue: 0,0:18:28.94,0:18:30.60,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:18:33.65,0:18:38.03,Default,,0,0,0,,Мен оны ойнасам да, жаман ойын бір сәт деп ойлаймын.
Dialogue: 0,0:18:38.53,0:18:40.45,Default,,0,0,0,,А, мен білмей тұрып, бітті.
Dialogue: 0,0:18:42.03,0:18:43.70,Default,,0,0,0,,Мен жүгіруге барамын.
Dialogue: 0,0:18:43.78,0:18:45.79,Default,,0,0,0,,Осылай қозғалса да?
Dialogue: 0,0:18:45.87,0:18:48.21,Default,,0,0,0,,Жүр, мен мұны сұраймын.
Dialogue: 0,0:18:49.33,0:18:51.71,Default,,0,0,0,,Бұл туралы ондаған мың рет айтылған.
Dialogue: 0,0:18:52.38,0:18:56.21,Default,,0,0,0,,Мен көп жұмыс істейтін адамдарды көргенде, мен де бар күшімді салуым керек деп ойлаймын.
Dialogue: 0,0:19:02.47,0:19:03.72,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:04.22,0:19:05.97,Default,,0,0,0,,Иномата-кун да сәттілік.
Dialogue: 0,0:19:06.06,0:19:06.93,Default,,0,0,0,,Иә
Dialogue: 0,0:19:07.02,0:19:08.64,Default,,0,0,0,,Клуб қызметі және махаббат
Dialogue: 0,0:19:08.73,0:19:09.73,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:09.81,0:19:11.69,Default,,0,0,0,,Сіз мойындамайсыз ба?
Dialogue: 0,0:19:12.19,0:19:13.11,Default,,0,0,0,,Бірге тұру керек пе?
Dialogue: 0,0:19:13.19,0:19:15.73,Default,,0,0,0,,Сіз қарапайым ғашық емес болсаңыз да.
Dialogue: 0,0:19:15.82,0:19:18.69,Default,,0,0,0,,Бірге тұратындықтан айту қиын.
Dialogue: 0,0:19:18.78,0:19:19.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:19.49,0:19:20.99,Default,,0,0,0,,Егер сізді тастап кетсе
Dialogue: 0,0:19:21.49,0:19:24.62,Default,,0,0,0,,Чинацу-сенпай ыңғайсызданып қала ма деп қорқамын.
Dialogue: 0,0:19:25.12,0:19:29.12,Default,,0,0,0,,Чинацу-сенпай қазірдің өзінде қамқорлықпен өмір сүріп жатыр.
Dialogue: 0,0:19:31.08,0:19:33.67,Default,,0,0,0,,Бірақ сізге Чи ұнайды, солай емес пе?
Dialogue: 0,0:19:33.75,0:19:34.63,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:34.71,0:19:37.75,Default,,0,0,0,,Бұл сіздің кездескіңіз келетінін білдіре ме?
Dialogue: 0,0:19:39.05,0:19:40.01,Default,,0,0,0,,Иә
Dialogue: 0,0:19:40.09,0:19:44.18,Default,,0,0,0,,Олай болса, арам пиғылыңды жасырып, бірге өмір сүргенің дұрыс болар еді.
Dialogue: 0,0:19:44.26,0:19:45.14,Default,,0,0,0,,Бұл қорқынышты емес пе?
Dialogue: 0,0:19:45.22,0:19:45.97,Default,,0,0,0,,Не!
Dialogue: 0,0:19:47.51,0:19:48.43,Default,,0,0,0,,(Рюкю) Барлығының өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:19:48.97,0:19:50.73,Default,,0,0,0,,Ааах…
Dialogue: 0,0:19:51.98,0:19:54.98,Default,,0,0,0,,Менде мұндай ой болған емес!
Dialogue: 0,0:19:55.48,0:19:57.73,Default,,0,0,0,,Мен оны көп көрдім.
Dialogue: 0,0:19:57.82,0:20:01.07,Default,,0,0,0,,Бір-біріңізден өткенде иіс сезетін адаммен тұру
Dialogue: 0,0:20:01.15,0:20:03.16,Default,,0,0,0,,Жиренішті болуы мүмкін
Dialogue: 0,0:20:03.24,0:20:06.58,Default,,0,0,0,,Хаха... бәрі тым көп ойланып жатыр.
Dialogue: 0,0:20:07.08,0:20:10.66,Default,,0,0,0,,Менің ойымша, басқа адамның не ойлайтыны туралы ойлану жақсы.
Dialogue: 0,0:20:11.25,0:20:13.12,Default,,0,0,0,,Өйткені,
Dialogue: 0,0:20:13.21,0:20:16.42,Default,,0,0,0,,Иномата-кунның идеясы - Чидің идеясы.
Dialogue: 0,0:20:17.00,0:20:21.17,Default,,0,0,0,,Кейде мүлдем ештеңе туралы ойламау маңызды.
Dialogue: 0,0:20:21.92,0:20:23.18,Default,,0,0,0,,Оны сол күйінде қалдырыңыз.
Dialogue: 0,0:20:23.26,0:20:25.68,Default,,0,0,0,,Өмір бойы қабырғаға соғылған сенсің.
Dialogue: 0,0:20:28.76,0:20:30.39,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:20:32.39,0:20:34.10,Default,,0,0,0,,Мен жиналғым келеді...
Dialogue: 0,0:20:34.60,0:20:36.61,Default,,0,0,0,,Ұрыс
Dialogue: 0,0:20:41.36,0:20:42.32,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:20:42.40,0:20:45.07,Default,,0,0,0,,Не? Сіз әлі оралдыңыз ба?
Dialogue: 0,0:20:45.57,0:20:47.28,Default,,0,0,0,,Пойызға да уақыт бар.
Dialogue: 0,0:20:47.37,0:20:48.91,Default,,0,0,0,,Келгендеріңізге рахмет.
Dialogue: 0,0:20:48.99,0:20:51.33,Default,,0,0,0,,Жоқ, қызық болды, көп нәрсе.
Dialogue: 0,0:20:53.21,0:20:56.54,Default,,0,0,0,,Эй, бұл жаман сұрақ болуы мүмкін, бірақ
Dialogue: 0,0:20:57.04,0:21:00.88,Default,,0,0,0,,Өйткені, екінші курс студенті болғандықтан, одан артық жеңіске жету қиын ба?
Dialogue: 0,0:21:00.96,0:21:02.76,Default,,0,0,0,,Қандай башаламандық
Dialogue: 0,0:21:03.30,0:21:06.13,Default,,0,0,0,,Менің айналамдағы адамдар небәрі 3 жаста, сондықтан жақсы жұмыс жасады деп ойлаймын.
Dialogue: 0,0:21:06.64,0:21:07.55,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:13.14,0:21:14.73,Default,,0,0,0,,Олай болса, кететін уақыт келді.
Dialogue: 0,0:21:17.73,0:21:18.44,Default,,0,0,0,,Гүл махаббаты
Dialogue: 0,0:21:20.19,0:21:23.07,Default,,0,0,0,,Келесі жолы көбірек ұтыңыз
Dialogue: 0,0:21:25.57,0:21:26.24,Default,,0,0,0,,Иә
Dialogue: 0,0:21:29.28,0:21:30.33,Default,,0,0,0,,Терлеу
Dialogue: 0,0:21:30.41,0:21:31.49,Default,,0,0,0,,Эй...
Dialogue: 0,0:21:32.08,0:21:35.04,Default,,0,0,0,,Ал, басқа ойындарды көріп, сабақ оқы.
Dialogue: 0,0:21:35.12,0:21:36.75,Default,,0,0,0,,О, абай бол.
Dialogue: 0,0:21:36.83,0:21:40.17,Default,,0,0,0,,Өтірік айтсам, кездесуге азырақ барамын.
Dialogue: 0,0:21:40.25,0:21:41.71,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:21:41.80,0:21:43.76,Default,,0,0,0,,Бұл гүлге деген сүйіспеншіліктің мәселесі.
Dialogue: 0,0:21:52.93,0:21:55.27,Default,,0,0,0,,Хошино орта мектебі қандай алаңда ойнайды?
Dialogue: 0,0:21:55.85,0:21:57.31,Default,,0,0,0,,жұп сот № 11
Dialogue: 0,0:21:57.81,0:21:59.15,Default,,0,0,0,,Дайкиге де барайық.
Dialogue: 0,0:21:59.23,0:22:00.40,Default,,0,0,0,,Иә
Dialogue: 0,0:22:03.53,0:22:05.11,Default,,0,0,0,,Жағымды иіс
Dialogue: 0,0:22:06.49,0:22:08.49,Default,,0,0,0,,♪~
Dialogue: 0,0:23:33.32,0:23:35.33,Default,,0,0,0,,~♪
Dialogue: 0,0:23:36.83,0:23:42.83,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory