Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.25,0:00:04.25,Default,,0,0,0,,Сіз от жағу туралы білесіз бе?
Dialogue: 0,0:00:04.75,0:00:07.00,Default,,0,0,0,,Махаббатымды мойындасам, ғашық болама?
Dialogue: 0,0:00:07.09,0:00:09.21,Default,,0,0,0,,Дұрыс, балықшы.
Dialogue: 0,0:00:09.71,0:00:11.01,Default,,0,0,0,,Күдікті...
Dialogue: 0,0:00:12.05,0:00:14.26,Default,,0,0,0,,Бірақ неге жай айтпайсың?
Dialogue: 0,0:00:15.34,0:00:17.68,Default,,0,0,0,,Мойындауға жауап: Маған бер
Dialogue: 0,0:00:30.78,0:00:31.90,Default,,0,0,0,,Оны айтпа
Dialogue: 0,0:00:39.41,0:00:42.33,Default,,0,0,0,,Дайки маған ғашық болғанша
Dialogue: 0,0:00:42.83,0:00:44.37,Default,,0,0,0,,Маған жауап қажет емес
Dialogue: 0,0:00:50.30,0:00:51.67,Default,,0,0,0,,Мен оны әкелдім.
Dialogue: 0,0:00:51.76,0:00:52.71,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:00:55.59,0:00:56.22,Default,,0,0,0,,Ах
Dialogue: 0,0:01:15.78,0:01:17.78,Default,,0,0,0,,♪~
Dialogue: 0,0:02:42.53,0:02:44.53,Default,,0,0,0,,~♪
Dialogue: 0,0:02:50.96,0:02:52.38,Default,,0,0,0,,Өткен түн...
Dialogue: 0,0:02:57.76,0:03:00.22,Default,,0,0,0,,Әже, аман-есен болғаныңызға қуаныштымын.
Dialogue: 0,0:03:00.30,0:03:01.80,Default,,0,0,0,,Иә, шынымен
Dialogue: 0,0:03:02.30,0:03:03.68,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:03:06.01,0:03:08.14,Default,,0,0,0,,Өйткені мен оны әу бастан білгенмін
Dialogue: 0,0:03:12.40,0:03:15.77,Default,,0,0,0,,Дайки Чинацу-сенпайды жақсы көретінін білемін.
Dialogue: 0,0:03:15.86,0:03:17.28,Default,,0,0,0,,Мен мойындадым.
Dialogue: 0,0:03:18.28,0:03:19.19,Default,,0,0,0,,Балапандар!
Dialogue: 0,0:03:21.74,0:03:23.57,Default,,0,0,0,,Бұндай ештеңе жоқ.
Dialogue: 0,0:03:25.41,0:03:26.78,Default,,0,0,0,,Мұны өзіңізбен бірге алыңыз.
Dialogue: 0,0:03:27.29,0:03:28.49,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:30.29,0:03:33.83,Default,,0,0,0,,Өйткені бұл жай ғана қиын нәрселер емес.
Dialogue: 0,0:03:38.42,0:03:40.13,Default,,0,0,0,,Мойындау кезінде
Dialogue: 0,0:03:40.21,0:03:43.76,Default,,0,0,0,,Бұршақ мылтық тигендей көрінетін оның жүзі өте күлкілі болды.
Dialogue: 0,0:03:44.68,0:03:48.77,Default,,0,0,0,,Мен барлығын айналдыру үшін үлкен стратегияда бірдеңе айтамын.
Dialogue: 0,0:03:49.43,0:03:52.02,Default,,0,0,0,,Daiki қызылға айналғанда
Dialogue: 0,0:03:53.27,0:03:55.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:55.86,0:03:58.61,Default,,0,0,0,,Жүрегімде кішкентай балапан билеп тұр
Dialogue: 0,0:04:03.99,0:04:06.28,Default,,0,0,0,,Мектеп мерекесінде «Ақшақар».
Dialogue: 0,0:04:14.00,0:04:18.42,Default,,0,0,0,,Мен тіпті Дайки ханзада рөлін ойнайды деп қиялдадым.
Dialogue: 0,0:04:18.96,0:04:19.88,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:04:20.96,0:04:22.88,Default,,0,0,0,,Бұл шынымен болған кезде
Dialogue: 0,0:04:22.97,0:04:25.39,Default,,0,0,0,,Мен қобалжығандай болдым, бірақ
Dialogue: 0,0:04:31.43,0:04:33.39,Default,,0,0,0,,Мен сол көріністі көрдім
Dialogue: 0,0:04:34.02,0:04:35.69,Default,,0,0,0,,Мен ешқашан ұмытпаймын
Dialogue: 0,0:04:44.15,0:04:45.91,Default,,0,0,0,,Дайки білмейтін шығар.
Dialogue: 0,0:04:48.57,0:04:49.41,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:04:53.08,0:04:58.42,Default,,0,0,0,,Қуанғаным сонша, мен оны елестетіп отырмын.
Dialogue: 0,0:04:59.00,0:05:00.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:03.51,0:05:08.05,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:05:09.60,0:05:11.01,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:05:17.65,0:05:20.65,Default,,0,0,0,,Сенің маған солай істегеніңді қалаймын.
Dialogue: 0,0:05:21.32,0:05:22.44,Default,,0,0,0,,Мен не ойладым
Dialogue: 0,0:05:23.74,0:05:27.95,Default,,0,0,0,,Сол тыныш сыныпта денем қызып кетті.
Dialogue: 0,0:05:31.45,0:05:35.41,Default,,0,0,0,,Жүрегім қатты соғып, ауырды.
Dialogue: 0,0:05:36.54,0:05:37.46,Default,,0,0,0,,Хина қаупі!
Dialogue: 0,0:05:37.54,0:05:38.58,Default,,0,0,0,,Не!
Dialogue: 0,0:05:45.67,0:05:46.47,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:05:47.59,0:05:51.30,Default,,0,0,0,,Сахнада алғаш рет сүйгім келмегеніме қуаныштымын.
Dialogue: 0,0:05:53.35,0:05:56.77,Default,,0,0,0,,Осыдан кейін айналамдағы адамдар маған көп нәрсені айтты.
Dialogue: 0,0:05:59.81,0:06:03.23,Default,,0,0,0,,Дайки маған қамқор болған сияқты.
Dialogue: 0,0:06:04.44,0:06:08.95,Default,,0,0,0,,Мен оны 100% жек көрмедім.
Dialogue: 0,0:06:10.03,0:06:11.16,Default,,0,0,0,,Ал егер...
Dialogue: 0,0:06:13.41,0:06:16.20,Default,,0,0,0,,Ол шынымен менімен бірге шыға ма деп ойлаймын.
Dialogue: 0,0:06:16.29,0:06:17.25,Default,,0,0,0,,Күту
Dialogue: 0,0:06:18.54,0:06:20.83,Default,,0,0,0,,Егер біз шынымен кездескен болсақ
Dialogue: 0,0:06:21.42,0:06:23.25,Default,,0,0,0,,Бұл қандай сезімде?
Dialogue: 0,0:06:24.09,0:06:27.26,Default,,0,0,0,,Үйге бірге барып, караокеге бардық.
Dialogue: 0,0:06:27.34,0:06:29.34,Default,,0,0,0,,Көптеген фотосуреттер де түсіріңіз
Dialogue: 0,0:06:34.43,0:06:36.18,Default,,0,0,0,,Тіпті қолымыз байланған
Dialogue: 0,0:06:38.35,0:06:39.35,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:39.85,0:06:42.11,Default,,0,0,0,,Ммм!
Dialogue: 0,0:06:45.32,0:06:46.36,Default,,0,0,0,,Хаа…
Dialogue: 0,0:06:50.49,0:06:51.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:51.86,0:06:55.79,Default,,0,0,0,,(Балалар шуы)
Dialogue: 0,0:06:56.54,0:06:59.33,Default,,0,0,0,,Эмоциялар - бұл ролик
Dialogue: 0,0:06:59.41,0:07:01.29,Default,,0,0,0,,Мұның мағынасы осы.
Dialogue: 0,0:07:07.26,0:07:10.47,Default,,0,0,0,,Тек танысып көрсек екен деп тілеймін.
Dialogue: 0,0:07:10.55,0:07:12.30,Default,,0,0,0,,Мен онымен ойнағым келеді.
Dialogue: 0,0:07:13.59,0:07:15.81,Default,,0,0,0,,Кейде мен солай ойлаймын
Dialogue: 0,0:07:18.14,0:07:20.81,Default,,0,0,0,,Маған осындай шынайылық ұнайды.
Dialogue: 0,0:07:21.52,0:07:23.60,Default,,0,0,0,,Өйткені мен сондай адаммын.
Dialogue: 0,0:07:23.69,0:07:28.90,Default,,0,0,0,,Олай десеңіз, мені, ең жақын досыңызды оңай ренжітпейсіз.
Dialogue: 0,0:07:31.70,0:07:33.24,Default,,0,0,0,,Ет үшін әлі жоқ.
Dialogue: 0,0:07:33.32,0:07:35.32,Default,,0,0,0,,Мен ондай ашкөз емеспін.
Dialogue: 0,0:07:36.49,0:07:37.33,Default,,0,0,0,,Ах
Dialogue: 0,0:07:38.24,0:07:39.87,Default,,0,0,0,,Менің шашымда жапырақтар бар
Dialogue: 0,0:07:40.54,0:07:42.33,Default,,0,0,0,,Е, қайда?
Dialogue: 0,0:07:43.42,0:07:44.33,Default,,0,0,0,,Қосымша
Dialogue: 0,0:07:44.83,0:07:45.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:46.25,0:07:47.34,Default,,0,0,0,,Ары қарай
Dialogue: 0,0:07:47.92,0:07:49.09,Default,,0,0,0,,Артында?
Dialogue: 0,0:07:51.22,0:07:52.84,Default,,0,0,0,,Кешіріңіз, жай ғана түртіңіз.
Dialogue: 0,0:07:57.22,0:07:58.85,Default,,0,0,0,,Артқы жағында кетіп қалды.
Dialogue: 0,0:08:00.89,0:08:01.85,Default,,0,0,0,,Ұнады
Dialogue: 0,0:08:03.35,0:08:07.82,Default,,0,0,0,,Қатты айтсаң, пәле болады.
Dialogue: 0,0:08:08.32,0:08:08.86,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:09.69,0:08:11.03,Default,,0,0,0,,Хехе, түсіндім.
Dialogue: 0,0:08:11.53,0:08:15.36,Default,,0,0,0,,Шабуыл жасамасаңыз, жеңе алмайсыз, сондықтан осы қатынасты да пайдаланыңыз.
Dialogue: 0,0:08:17.03,0:08:18.37,Default,,0,0,0,,Мұнда қараңыз
Dialogue: 0,0:08:20.87,0:08:22.87,Default,,0,0,0,,Ең жақын достан дамыды
Dialogue: 0,0:08:23.87,0:08:27.46,Default,,0,0,0,,Ертең, келесі аптада, келесі айда?
Dialogue: 0,0:08:28.13,0:08:30.42,Default,,0,0,0,,Мен мәңгі күтемін
Dialogue: 0,0:08:32.26,0:08:33.67,Default,,0,0,0,,Өлтірді… Қылыш Қасиеттісін?
Dialogue: 0,0:08:34.30,0:08:35.80,Default,,0,0,0,,Ол сондай-ақ Daiki-мен бірге келеді.
Dialogue: 0,0:08:35.89,0:08:37.89,Default,,0,0,0,,Сіз жаңасын қосуға тырысып жатырсыз, солай ма?
Dialogue: 0,0:08:37.97,0:08:39.60,Default,,0,0,0,,Хехе, бұл дұрыс емес.
Dialogue: 0,0:08:39.68,0:08:41.39,Default,,0,0,0,,Қараңдаршы, мұнда үлкен жәндік бар.
Dialogue: 0,0:08:41.47,0:08:43.89,Default,,0,0,0,,- (қуанып) Е! қайда! -(Балапан) Хахаха Усо~!
Dialogue: 0,0:08:44.85,0:08:47.90,Default,,0,0,0,,О, о, біз жақсы қарым-қатынастамыз.
Dialogue: 0,0:08:49.02,0:08:52.53,Default,,0,0,0,,Мен осындай дос сияқты жұптарға тәнтімін.
Dialogue: 0,0:08:53.03,0:08:55.99,Default,,0,0,0,,Мория мырза, екінші тарап айналаны айналып бара жатқан сияқты.
Dialogue: 0,0:08:56.49,0:08:58.91,Default,,0,0,0,,Ах, ол тек телефон арқылы сөйлескенін айтты.
Dialogue: 0,0:08:58.99,0:09:00.16,Default,,0,0,0,,Тіпті солай
Dialogue: 0,0:09:00.24,0:09:02.41,Default,,0,0,0,,Өйткені, мен оған жарайтын адаммен кездесіп жүрмін.
Dialogue: 0,0:09:03.04,0:09:04.37,Default,,0,0,0,,Міне, сондықтан махаббат
Dialogue: 0,0:09:04.46,0:09:07.63,Default,,0,0,0,,Егер маған қатты ұнаса, мен бақытты болар едім.
Dialogue: 0,0:09:10.63,0:09:13.92,Default,,0,0,0,,Сонда ғашық адам қалай бақытты болады?
Dialogue: 0,0:09:14.42,0:09:15.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:16.01,0:09:17.34,Default,,0,0,0,,Мория-сан дегеніміз не?
Dialogue: 0,0:09:17.43,0:09:20.51,Default,,0,0,0,,Сіз мойындасаңыз да, бұл ұзаққа созылмайды.
Dialogue: 0,0:09:20.60,0:09:21.43,Default,,0,0,0,,Кешіріңіз, бірақ...
Dialogue: 0,0:09:23.06,0:09:24.43,Default,,0,0,0,,Өте сенімді емес.
Dialogue: 0,0:09:24.52,0:09:26.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:27.52,0:09:29.90,Default,,0,0,0,,Не? Көзілдірік бүйірден шығып тұр!
Dialogue: 0,0:09:29.98,0:09:32.23,Default,,0,0,0,,Сенің қызың да жоқ!
Dialogue: 0,0:09:36.53,0:09:38.16,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,0:09:40.49,0:09:42.08,Default,,0,0,0,,Бұл тітіркендіргіш!
Dialogue: 0,0:09:45.79,0:09:48.96,Default,,0,0,0,,Оқу-жаттығу жиынында жақсы жұмыс!
Dialogue: 0,0:09:50.08,0:09:50.96,Default,,0,0,0,,Тұтану!
Dialogue: 0,0:09:51.92,0:09:53.96,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:03.68,0:10:04.31,Default,,0,0,0,,Ах
Dialogue: 0,0:10:06.68,0:10:07.64,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:10.73,0:10:11.44,Default,,0,0,0,,Пә!
Dialogue: 0,0:10:17.36,0:10:19.07,Default,,0,0,0,,Өте сенімді емес.
Dialogue: 0,0:10:19.78,0:10:24.16,Default,,0,0,0,,Мен ұзақ уақыт бойы қарым-қатынаста болмағаным рас.
Dialogue: 0,0:10:24.66,0:10:29.12,Default,,0,0,0,,Одан да менде ешқашан лайықты махаббат болмаған шығар.
Dialogue: 0,0:10:32.34,0:10:33.59,Default,,0,0,0,,Тек!
Dialogue: 0,0:10:34.34,0:10:37.34,Default,,0,0,0,,Өйткені мен үлкен қуаныш ұнағанды ​​ұнатамын.
Dialogue: 0,0:10:38.22,0:10:39.80,Default,,0,0,0,,Ол сонда бетінде ақымақтай күлкімен тұрып тұр, бір дюймге де қозғалмайды! Бұл Шинсоның Қвиркі ме?
Dialogue: 0,0:10:44.18,0:10:48.35,Default,,0,0,0,,Соншалықты терең ұққан адам
Dialogue: 0,0:10:50.85,0:10:53.23,Default,,0,0,0,,Мен сізді қолдағым келеді!
Dialogue: 0,0:10:55.11,0:10:55.98,Default,,0,0,0,,Ах
Dialogue: 0,0:10:56.82,0:10:58.24,Default,,0,0,0,,Суық...
Dialogue: 0,0:10:58.32,0:10:59.20,Default,,0,0,0,,Сіздің курткаңыз ше?
Dialogue: 0,0:10:59.28,0:11:02.32,Default,,0,0,0,,А, мен оны спортзалға қалдырдым.
Dialogue: 0,0:11:02.41,0:11:03.49,Default,,0,0,0,,Мен барып аламын.
Dialogue: 0,0:11:06.08,0:11:06.99,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:08.83,0:11:10.37,Default,,0,0,0,,Хиначи Хиначи
Dialogue: 0,0:11:11.21,0:11:13.75,Default,,0,0,0,,Аудио жабдықта ақау бар сияқты.
Dialogue: 0,0:11:14.42,0:11:18.26,Default,,0,0,0,,Гимназияда қосалқысы бар сияқты, оны маған ала аласыз ба?
Dialogue: 0,0:11:18.34,0:11:19.72,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:19.80,0:11:22.51,Default,,0,0,0,,Шынымен бе? Рақмет.
Dialogue: 0,0:11:22.59,0:11:24.22,Default,,0,0,0,,Айтпақшы...
Dialogue: 0,0:11:24.76,0:11:27.01,Default,,0,0,0,,Қанша кеш болғаны маңызды емес!
Dialogue: 0,0:11:28.10,0:11:28.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:40.15,0:11:40.95,Default,,0,0,0,,Ах
Dialogue: 0,0:11:41.03,0:11:43.11,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:44.49,0:11:45.91,Default,,0,0,0,,Жабдықты алу
Dialogue: 0,0:11:46.45,0:11:48.70,Default,,0,0,0,,Менен Аяме-чан сұрады.
Dialogue: 0,0:11:49.20,0:11:51.66,Default,,0,0,0,,Бұл басқарушы тез қолданылады
Dialogue: 0,0:11:52.42,0:11:53.08,Default,,0,0,0,,Ах
Dialogue: 0,0:11:54.13,0:11:55.42,Default,,0,0,0,,Ынтымақтастық!
Dialogue: 0,0:11:56.46,0:11:57.92,Default,,0,0,0,,Кешігіп қалғаныңыз дұрыс!
Dialogue: 0,0:11:59.13,0:12:00.42,Default,,0,0,0,,Бұл әдейі.
Dialogue: 0,0:12:01.26,0:12:02.38,Default,,0,0,0,,Қандай жабдық?
Dialogue: 0,0:12:04.34,0:12:05.43,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:12:19.36,0:12:20.48,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:12:21.03,0:12:22.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:23.95,0:12:27.41,Default,,0,0,0,,Аяме-чан кездейсоқ бірдеңе айтқан болуы мүмкін.
Dialogue: 0,0:12:28.53,0:12:29.45,Default,,0,0,0,,Ах
Dialogue: 0,0:12:32.54,0:12:35.92,Default,,0,0,0,,(жеңіл музыка)
Dialogue: 0,0:12:38.13,0:12:42.30,Default,,0,0,0,,Лагерді осы жерден де көруге болады.
Dialogue: 0,0:12:42.92,0:12:44.05,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:12:44.55,0:12:46.43,Default,,0,0,0,,Керісінше, бұл керемет.
Dialogue: 0,0:12:54.14,0:12:56.73,Default,,0,0,0,,А, Нишида-сенпай билеп тұр.
Dialogue: 0,0:12:59.57,0:13:01.48,Default,,0,0,0,,Осы жерден қарап көрейік.
Dialogue: 0,0:13:10.49,0:13:12.24,Default,,0,0,0,,Шыны керек, мен аздап шаршадым.
Dialogue: 0,0:13:13.16,0:13:14.62,Default,,0,0,0,,Мен оны баяу қабылдауым керек пе?
Dialogue: 0,0:13:24.26,0:13:25.47,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:25.55,0:13:30.51,Default,,0,0,0,,Жыл бойы жүгіріп жүргенге қуансаң да, шаршайсың.
Dialogue: 0,0:13:30.60,0:13:31.76,Default,,0,0,0,,Мені мазақ етпе
Dialogue: 0,0:13:32.64,0:13:36.81,Default,,0,0,0,,Энергияны тұтыну автобуспен жүретін жас келіншектікінен өзгеше.
Dialogue: 0,0:13:36.89,0:13:39.02,Default,,0,0,0,,Таңертең біз де жүгірдік.
Dialogue: 0,0:13:39.94,0:13:41.02,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:13:41.77,0:13:43.48,Default,,0,0,0,,Дайки, толық емес орта мектептің үшінші курсы
Dialogue: 0,0:13:43.57,0:13:45.99,Default,,0,0,0,,Мектепке саяхатта болсам да қонақ үйден тайып кеттім.
Dialogue: 0,0:13:46.07,0:13:47.78,Default,,0,0,0,,Таңертең жүгіруге барыңыз
Dialogue: 0,0:13:48.49,0:13:49.95,Default,,0,0,0,,Бұл күнделікті жұмыс.
Dialogue: 0,0:13:50.57,0:13:52.24,Default,,0,0,0,,Бірақ сіз ашулы болдыңыз, солай ма?
Dialogue: 0,0:13:52.74,0:13:55.79,Default,,0,0,0,,Мұғалім мұның барлығын әбігерге салғандықтан білген болуы керек.
Dialogue: 0,0:13:56.58,0:14:00.79,Default,,0,0,0,,Кейінірек, біз орта мектептің екінші курсында лагерьде болғанда, бәріміз Кейдоро ойнадық.
Dialogue: 0,0:14:01.50,0:14:04.55,Default,,0,0,0,,Әй, мен ғана қашып құтылдым.
Dialogue: 0,0:14:04.63,0:14:08.05,Default,,0,0,0,,Үлкен қуаныш, тамаша қадамдарыңды көрсет
Dialogue: 0,0:14:08.13,0:14:09.59,Default,,0,0,0,,Бұл мені күлдірді
Dialogue: 0,0:14:09.68,0:14:10.80,Default,,0,0,0,,Мен сені мақтап тұрғаным жоқ.
Dialogue: 0,0:14:11.64,0:14:13.31,Default,,0,0,0,,Сосын мен де көрдім.
Dialogue: 0,0:14:13.81,0:14:17.23,Default,,0,0,0,,Балапан бірінші болып ұсталып, іші пысты.
Dialogue: 0,0:14:17.31,0:14:18.81,Default,,0,0,0,,Сол кезде аяқ киім баулары...
Dialogue: 0,0:14:19.48,0:14:21.90,Default,,0,0,0,,Иә Кешіріңіз
Dialogue: 0,0:14:21.98,0:14:24.82,Default,,0,0,0,,Алғыр сұңқар тырнағын жасырады дейді.
Dialogue: 0,0:14:24.90,0:14:26.90,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:27.61,0:14:30.41,Default,,0,0,0,,Екінші рет де ерте ұсталды.
Dialogue: 0,0:14:33.91,0:14:37.20,Default,,0,0,0,,Оның үстіне ол өзін жіберіп жатқанын түсінбеді.
Dialogue: 0,0:14:38.96,0:14:39.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:44.80,0:14:46.59,Default,,0,0,0,,Сәлем Дайки
Dialogue: 0,0:14:46.67,0:14:47.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:50.18,0:14:52.30,Default,,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:14:52.80,0:14:53.72,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:55.43,0:14:57.35,Default,,0,0,0,,Патша ойыны болғанда
Dialogue: 0,0:14:58.52,0:14:59.27,Default,,0,0,0,,Иә
Dialogue: 0,0:15:02.02,0:15:04.61,Default,,0,0,0,,Сіз шынымен не деп жауап бермек едіңіз?
Dialogue: 0,0:15:08.36,0:15:09.78,Default,,0,0,0,,Мен бір сәтке
Dialogue: 0,0:15:09.86,0:15:12.62,Default,,0,0,0,,Мен сені Чинацу-сенпайды ұнататынын айтайын деп ойладым.
Dialogue: 0,0:15:14.37,0:15:17.62,Default,,0,0,0,,Бірақ Дайки бұл жағынан таңқаларлық.
Dialogue: 0,0:15:19.29,0:15:23.46,Default,,0,0,0,,Ол ойын кезінде өз сезімін мойындайтын кездейсоқ жігіт емес.
Dialogue: 0,0:15:26.34,0:15:29.38,Default,,0,0,0,,Аа, ештеңені мойындаудың қажеті жоқ.
Dialogue: 0,0:15:29.47,0:15:31.88,Default,,0,0,0,,Бұл әу бастан уәде болатын.
Dialogue: 0,0:15:33.64,0:15:36.43,Default,,0,0,0,,Өйткені менде бәрі жақсы.
Dialogue: 0,0:15:36.93,0:15:39.48,Default,,0,0,0,,Бақытты болудан гөрі көбірек тырысу керек.
Dialogue: 0,0:15:40.10,0:15:44.48,Default,,0,0,0,,Шынымды айтсам... кейде дірілдеп кетеді.
Dialogue: 0,0:15:45.40,0:15:47.90,Default,,0,0,0,,Мұндай нәрсе мені мазаламайды
Dialogue: 0,0:15:49.19,0:15:52.49,Default,,0,0,0,,Себебі мен Дайкиді жақсы көремін.
Dialogue: 0,0:16:16.05,0:16:18.06,Default,,0,0,0,,Тезірек қайтеміз?
Dialogue: 0,0:16:18.14,0:16:20.81,Default,,0,0,0,,Мен Аяме-чанға оның да болмағанын айтуым керек.
Dialogue: 0,0:16:22.14,0:16:26.69,Default,,0,0,0,,А, қазірдің өзінде... Мен сені бұл жерде ұнатамын дегім келмеді.
Dialogue: 0,0:16:30.65,0:16:31.49,Default,,0,0,0,,Балапандар
Dialogue: 0,0:16:44.12,0:16:44.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:47.79,0:16:48.71,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:48.79,0:16:52.21,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:16:57.39,0:17:00.72,Default,,0,0,0,,Кешіріңіз дегенді қалай түсінесіз?
Dialogue: 0,0:17:05.81,0:17:08.73,Default,,0,0,0,,Мен балапандармен араласа алмаймын.
Dialogue: 0,0:17:23.04,0:17:23.83,Default,,0,0,0,,Мен осындамын ғой?
Dialogue: 0,0:17:25.79,0:17:28.04,Default,,0,0,0,,Мен жауапқа иә дедім.
Dialogue: 0,0:17:28.13,0:17:29.88,Default,,0,0,0,,Бұлай уайымдамаңыз
Dialogue: 0,0:17:31.88,0:17:34.76,Default,,0,0,0,,Чинацу-сенпаймен кездесіп жүрген сияқты емессің, солай ма?
Dialogue: 0,0:17:35.63,0:17:38.59,Default,,0,0,0,,Бұл... бұл дұрыс емес.
Dialogue: 0,0:17:39.89,0:17:42.26,Default,,0,0,0,,Жарайды, әлі жауап берудің қажеті жоқ.
Dialogue: 0,0:17:43.22,0:17:46.48,Default,,0,0,0,,Қанша кеш болса да мен шағымданбаймын.
Dialogue: 0,0:17:46.98,0:17:48.23,Default,,0,0,0,,Егер мен оны қазір шайқасам
Dialogue: 0,0:17:48.31,0:17:51.86,Default,,0,0,0,,Маған кейін ғашық болғаныңыз үшін өкініп қалуыңыз мүмкін.
Dialogue: 0,0:17:53.73,0:17:54.74,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:17:55.82,0:17:58.70,Default,,0,0,0,,Қазіргі қарым-қатынасымыз жақсы деп ойламаймын.
Dialogue: 0,0:18:00.07,0:18:02.91,Default,,0,0,0,,Хина Чинацу-сенпайға жақындай алатынын айтты.
Dialogue: 0,0:18:02.99,0:18:04.33,Default,,0,0,0,,Сіз мұны маған айтып отырсыз.
Dialogue: 0,0:18:05.04,0:18:09.58,Default,,0,0,0,,Өйткені, қазіргі жағдайға адалдықпен қараған дұрыс.
Dialogue: 0,0:18:09.67,0:18:11.29,Default,,0,0,0,,Мен мұны істей алмадым
Dialogue: 0,0:18:12.21,0:18:14.05,Default,,0,0,0,,Мен ағамды жақсы көрсем де
Dialogue: 0,0:18:14.55,0:18:18.13,Default,,0,0,0,,Балапандарынан тербеліп кейде өзімді аяймын.
Dialogue: 0,0:18:18.68,0:18:23.68,Default,,0,0,0,,Менің ойымша, мұндай жарымжан көзқарас Хинаға ауыр тиеді.
Dialogue: 0,0:18:24.89,0:18:27.81,Default,,0,0,0,,Ендеше, қазір түсінікті болсын.
Dialogue: 0,0:18:27.89,0:18:29.06,Default,,0,0,0,,Бір-бірін...
Dialogue: 0,0:18:34.48,0:18:36.57,Default,,0,0,0,,Жарайды дедім!
Dialogue: 0,0:18:37.49,0:18:40.74,Default,,0,0,0,,Мен ұнататынымды білетін адамға сезімімді айттым.
Dialogue: 0,0:18:41.24,0:18:43.37,Default,,0,0,0,,Дайки ағасын ұнатса да,
Dialogue: 0,0:18:43.87,0:18:46.16,Default,,0,0,0,,Дегенмен маған Дайки ұнайды!
Dialogue: 0,0:18:48.00,0:18:50.08,Default,,0,0,0,,Бұл жағдай табиғи емес.
Dialogue: 0,0:18:50.67,0:18:52.29,Default,,0,0,0,,Бұл табиғи, солай ма?
Dialogue: 0,0:18:52.38,0:18:55.59,Default,,0,0,0,,Мен үлкен қуанышымды айналдырсам, бәрі толығымен реттеледі.
Dialogue: 0,0:18:56.59,0:18:59.59,Default,,0,0,0,,Сондықтан мен бұл сезімге жауап бере алмаймын...
Dialogue: 0,0:18:59.68,0:19:01.18,Default,,0,0,0,,Неге!
Dialogue: 0,0:19:02.18,0:19:03.80,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:19:03.89,0:19:06.18,Default,,0,0,0,,Қуаныштар мен естеліктер көп
Dialogue: 0,0:19:07.68,0:19:09.27,Default,,0,0,0,,Біз бірге тұрмайтындықтан ба?
Dialogue: 0,0:19:09.77,0:19:11.19,Default,,0,0,0,,Содан кейін тіпті қазірден бастап...
Dialogue: 0,0:19:13.56,0:19:17.61,Default,,0,0,0,,Мен Чинацу-сенпайдың Дайки туралы не ойлайтынын білмеймін.
Dialogue: 0,0:19:18.19,0:19:19.82,Default,,0,0,0,,- (балапан) Мен... - (қуаныштан) Сонда да
Dialogue: 0,0:19:22.24,0:19:24.24,Default,,0,0,0,,Мен жақсы көретін адам өзгермейді
Dialogue: 0,0:19:34.84,0:19:35.63,Default,,0,0,0,,Балапандар…
Dialogue: 0,0:19:46.01,0:19:47.76,Default,,0,0,0,,(Ирис гуілдейді)
Dialogue: 0,0:19:48.89,0:19:52.23,Default,,0,0,0,,Хехехе, жақсы өтті деп ойлаймын.
Dialogue: 0,0:19:52.73,0:19:56.77,Default,,0,0,0,,Жалғыз-ақ гимназияда от жағады
Dialogue: 0,0:19:57.65,0:20:00.15,Default,,0,0,0,,Джинкс де бар сияқты.
Dialogue: 0,0:20:00.65,0:20:03.28,Default,,0,0,0,,Бұл жақсы атмосфераны құру емес пе?
Dialogue: 0,0:20:05.20,0:20:05.82,Default,,0,0,0,,Ах
Dialogue: 0,0:20:06.37,0:20:07.28,Default,,0,0,0,,Не!
Dialogue: 0,0:20:08.24,0:20:09.33,Default,,0,0,0,,Хиначи!
Dialogue: 0,0:20:22.13,0:20:22.80,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:20:24.38,0:20:26.05,Default,,0,0,0,,Бір нәрсе... Ах!
Dialogue: 0,0:20:28.93,0:20:29.89,Default,,0,0,0,,Жылау
Dialogue: 0,0:20:32.14,0:20:34.31,Default,,0,0,0,,Сіз менімен кездесе алмайсыз
Dialogue: 0,0:20:38.77,0:20:41.28,Default,,0,0,0,,Маған ұнайтын басқа біреу болғандықтан
Dialogue: 0,0:20:44.57,0:20:46.87,Default,,0,0,0,,Екеуміздің бір-бірімізге деген сезіміміз жоқ
Dialogue: 0,0:20:48.28,0:20:50.91,Default,,0,0,0,,Өйткені сен жақсы көретін адам өзгермейді
Dialogue: 0,0:20:53.00,0:20:58.00,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:21:02.80,0:21:04.63,Default,,0,0,0,,Егер бұл көркем гимнастика болса
Dialogue: 0,0:21:05.13,0:21:09.35,Default,,0,0,0,,Еңбектің жемісі деген рас па?
Dialogue: 0,0:21:10.76,0:21:12.77,Default,,0,0,0,,Әртүрлі сөздерді айтатын адамдар бар.
Dialogue: 0,0:21:16.85,0:21:19.56,Default,,0,0,0,,Ерінбей еңбек етсең нәтиже шығады.
Dialogue: 0,0:21:21.44,0:21:25.20,Default,,0,0,0,,Қатты тырысқаным үшін өзіме ғашық болдым.
Dialogue: 0,0:21:26.86,0:21:27.78,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:21:29.49,0:21:31.37,Default,,0,0,0,,Ғашық
Dialogue: 0,0:21:34.33,0:21:34.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:54.47,0:21:58.40,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:22:02.40,0:22:05.49,Default,,0,0,0,,Неліктен ол соншалықты ұсқынсыз болып кетті?
Dialogue: 0,0:22:06.49,0:22:08.49,Default,,0,0,0,,♪~
Dialogue: 0,0:23:33.45,0:23:35.45,Default,,0,0,0,,~♪
