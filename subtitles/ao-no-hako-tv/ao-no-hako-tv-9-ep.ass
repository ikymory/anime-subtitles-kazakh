Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.62,0:00:04.42,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:07.42,0:00:10.30,Default,,0,0,0,,Ей, сен қатты тырысып жатырсың.
Dialogue: 0,0:00:10.38,0:00:11.42,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:00:12.01,0:00:14.34,Default,,0,0,0,,Мен де бақыттымын
Dialogue: 0,0:00:14.84,0:00:17.43,Default,,0,0,0,,Хаа... Мен сені қатты жақсы көремін
Dialogue: 0,0:00:17.51,0:00:19.81,Default,,0,0,0,,Мен Интер-Хайға дейін күшейуім керек.
Dialogue: 0,0:00:19.89,0:00:21.27,Default,,0,0,0,,Бүгін бізде мереке бар.
Dialogue: 0,0:00:21.35,0:00:23.06,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:24.10,0:00:25.44,Default,,0,0,0,,Жақсы
Dialogue: 0,0:00:27.23,0:00:29.77,Default,,0,0,0,,Чинацу-сенпай, мен Интер-Хайға баруды шештім.
Dialogue: 0,0:00:30.28,0:00:31.57,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:00:32.07,0:00:33.70,Default,,0,0,0,,Жақсы
Dialogue: 0,0:00:34.28,0:00:37.45,Default,,0,0,0,,Керемет, ғажап
Dialogue: 0,0:00:37.53,0:00:39.62,Default,,0,0,0,,Мен сенің айтқаныңды орындаймын.
Dialogue: 0,0:00:40.12,0:00:41.75,Default,,0,0,0,,Тым салқын
Dialogue: 0,0:00:47.13,0:00:48.25,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:00:50.59,0:00:51.17,Default,,0,0,0,,В
Dialogue: 0,0:00:51.67,0:00:55.59,Default,,0,0,0,,21-11 21-13 ойындар
Dialogue: 0,0:00:56.76,0:00:59.26,Default,,0,0,0,,Сачигава орта мектебі Юса-кун
Dialogue: 0,0:01:04.48,0:01:05.60,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:01:06.48,0:01:08.44,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:01:08.52,0:01:09.56,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:01:13.49,0:01:14.53,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:01:24.25,0:01:25.79,Default,,0,0,0,,Мен жеңілдім
Dialogue: 0,0:01:30.50,0:01:32.50,Default,,0,0,0,,♪~
Dialogue: 0,0:02:57.71,0:02:59.72,Default,,0,0,0,,~♪
Dialogue: 0,0:03:08.73,0:03:10.02,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:03:10.10,0:03:10.98,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:03:11.06,0:03:12.90,Default,,0,0,0,,Сіз кешіктіңіз!
Dialogue: 0,0:03:23.11,0:03:27.37,Default,,0,0,0,,Сенпай, тоқта!
Dialogue: 0,0:03:35.84,0:03:37.00,Default,,0,0,0,,Мен енді мұны істей алмаймын.
Dialogue: 0,0:03:38.84,0:03:40.47,Default,,0,0,0,,Шектер бар.
Dialogue: 0,0:03:41.34,0:03:43.38,Default,,0,0,0,,Менің бас тартудан басқа амалым жоқ.
Dialogue: 0,0:03:45.60,0:03:48.01,Default,,0,0,0,,Қорытынды емтихан...
Dialogue: 0,0:03:49.43,0:03:52.52,Default,,0,0,0,,Турнирден кейін бірден сынақ неге өткізіледі?
Dialogue: 0,0:03:53.19,0:03:55.69,Default,,0,0,0,,Сондықтан мен саған ұқыптылықпен істе дедім...
Dialogue: 0,0:03:56.19,0:03:57.40,Default,,0,0,0,,Үйірме жұмыстары Кеттік
Dialogue: 0,0:03:58.07,0:04:01.69,Default,,0,0,0,,Ең қиыны – оны ыждағаттылықпен орындау.
Dialogue: 0,0:04:01.78,0:04:04.07,Default,,0,0,0,,Қарапайым тілмен айтқанда, сіз!
Dialogue: 0,0:04:04.57,0:04:06.53,Default,,0,0,0,,Ке... түсінбейсің.
Dialogue: 0,0:04:07.03,0:04:08.41,Default,,0,0,0,,Бұл өте оңай!
Dialogue: 0,0:04:15.29,0:04:16.21,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:04:16.29,0:04:17.50,Default,,0,0,0,,Иә, жақсы жұмыс.
Dialogue: 0,0:04:18.59,0:04:20.67,Default,,0,0,0,,Байқау Сіз қай санатқа қатысасыз?
Dialogue: 0,0:04:20.76,0:04:22.97,Default,,0,0,0,,Мен дауыстап оқитын шығармын.
Dialogue: 0,0:04:28.72,0:04:30.93,Default,,0,0,0,,Тестілеу кезеңінде де үйірме жұмыстары бар.
Dialogue: 0,0:04:31.52,0:04:34.77,Default,,0,0,0,,Үйге келген соң сабақ оқығым келмейді.
Dialogue: 0,0:04:35.27,0:04:37.11,Default,,0,0,0,,Бұлшық ет жаттығуларын жасай алсам да
Dialogue: 0,0:04:37.19,0:04:37.81,Default,,0,0,0,,Ах
Dialogue: 0,0:04:38.40,0:04:39.65,Default,,0,0,0,,- (үлкен қуаныш) Хина! -(балапан) Әй!
Dialogue: 0,0:04:42.65,0:04:45.57,Default,,0,0,0,,Менімен сөйлеспей аласыз ба?
Dialogue: 0,0:04:47.03,0:04:50.62,Default,,0,0,0,,Дәл қазір менің миымды ағылшын сөздерінен басқа ештеңеге жұмсайтын уақытым жоқ.
Dialogue: 0,0:04:51.12,0:04:53.50,Default,,0,0,0,,Сенің достарың барына қуаныштымын.
Dialogue: 0,0:04:53.58,0:04:54.58,Default,,0,0,0,,Хмм!
Dialogue: 0,0:04:54.66,0:04:57.25,Default,,0,0,0,,Сіз маған қосылмай аласыз ба?
Dialogue: 0,0:04:57.33,0:04:59.29,Default,,0,0,0,,Мен ешқашан қызыл ұпай алған емеспін.
Dialogue: 0,0:04:59.38,0:05:01.71,Default,,0,0,0,,- (Үлкен қуаныш) Мен де қызыл нүкте алдым... - (Хина) Кіші мектептің 2 курсының бірінші жартысы
Dialogue: 0,0:05:01.80,0:05:02.88,Default,,0,0,0,,Бұл іштің ауыруы...
Dialogue: 0,0:05:02.96,0:05:05.84,Default,,0,0,0,,А, иә, түсіндім.
Dialogue: 0,0:05:08.89,0:05:10.85,Default,,0,0,0,,Соғыс!
Dialogue: 0,0:05:10.93,0:05:12.27,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:05:12.35,0:05:13.52,Default,,0,0,0,,- (Автобустың әйел мүшесі) Мына жерде! - (Автобустың әйел мүшесі) Иә!
Dialogue: 0,0:05:14.02,0:05:16.35,Default,,0,0,0,,Әйелдер автобусы жаттығуға кірісіп кетті
Dialogue: 0,0:05:17.15,0:05:17.98,Default,,0,0,0,,(Каори) Қорқатын ештеңе жоқ, бәрі жақсы болады! Ақыры біз ең мықтымыз ғой.
Dialogue: 0,0:05:18.06,0:05:20.36,Default,,0,0,0,,- (Автобустың әйел мүшесі) Қорға, қорға! -(Автобустың әйел мүшесі) Енді кеттік!
Dialogue: 0,0:05:21.90,0:05:24.32,Default,,0,0,0,,Интер-Хайға дейін екі ай ғана қалды.
Dialogue: 0,0:05:24.82,0:05:26.86,Default,,0,0,0,,Мен түнде де жаттығамын.
Dialogue: 0,0:05:34.70,0:05:36.66,Default,,0,0,0,,Біз де ұтыла алмаймыз!
Dialogue: 0,0:05:36.75,0:05:40.46,Default,,0,0,0,,Енді оқуды ұмытып, үйірме жұмыстарын жасаңыз!
Dialogue: 0,0:05:42.96,0:05:45.09,Default,,0,0,0,,Түптеп келгенде, сен көңілсізсің.
Dialogue: 0,0:05:48.43,0:05:50.85,Default,,0,0,0,,Алдыңғы префектуралық іріктеу турында жеңілген.
Dialogue: 0,0:05:50.93,0:05:54.64,Default,,0,0,0,,Ол өзі елестеткендей бірдеңені айтты.
Dialogue: 0,0:05:56.02,0:05:58.73,Default,,0,0,0,,Чинацу-сенпай орта мектепке қатысуға шешім қабылдады.
Dialogue: 0,0:05:59.23,0:06:01.19,Default,,0,0,0,,Мен өзімді үйде де ыңғайсыз сезінемін
Dialogue: 0,0:06:01.90,0:06:05.57,Default,,0,0,0,,Сіз үлкендермен көп сөйлеспеген сияқтысыз.
Dialogue: 0,0:06:06.15,0:06:08.15,Default,,0,0,0,,Тесттер мен үйірме жұмыстарының айырмашылығына байланысты
Dialogue: 0,0:06:10.07,0:06:11.16,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:12.83,0:06:15.95,Default,,0,0,0,,Ол мұнда бақытты болатындай жігіт емес.
Dialogue: 0,0:06:18.25,0:06:20.38,Default,,0,0,0,,Жарайды, қуансаң, жарайды.
Dialogue: 0,0:06:20.88,0:06:24.30,Default,,0,0,0,,Қандай жағдай болмасын, оның күш-қуаты – тез қалпына келуінде.
Dialogue: 0,0:06:27.72,0:06:29.09,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:06:31.09,0:06:32.80,Default,,0,0,0,,Содан кейін қайтадан
Dialogue: 0,0:06:33.85,0:06:37.43,Default,,0,0,0,,Кенго Харионы Inter-High-ке қатысқаны үшін құттықтаймыз
Dialogue: 0,0:06:37.52,0:06:39.81,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:06:39.89,0:06:41.85,Default,,0,0,0,,Әлсіреп қалма — жолды бөгеп тұрсың.
Dialogue: 0,0:06:41.94,0:06:44.69,Default,,0,0,0,,Сачигаваның барлық слоттарды алғаны ұят болды.
Dialogue: 0,0:06:45.78,0:06:46.82,Default,,0,0,0,,Онда?
Dialogue: 0,0:06:47.82,0:06:50.32,Default,,0,0,0,,Барлығына шынымен де рахмет.
Dialogue: 0,0:06:51.28,0:06:54.83,Default,,0,0,0,,Мен қазірден бастап Интер-Хайға дейін қиындық тудыруы мүмкін.
Dialogue: 0,0:06:55.70,0:06:58.33,Default,,0,0,0,,Ұйымдар арасында қандай да бір дау-дамай болғанын растадық.
Dialogue: 0,0:06:58.41,0:07:03.33,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:07:03.42,0:07:04.34,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:04.42,0:07:06.63,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:07:06.71,0:07:07.88,Default,,0,0,0,,Нишида жақсы.
Dialogue: 0,0:07:07.96,0:07:10.34,Default,,0,0,0,,Е! Кәне!
Dialogue: 0,0:07:11.84,0:07:14.01,Default,,0,0,0,,Дубльдер біраз уақытқа үзіліс жасайды.
Dialogue: 0,0:07:14.51,0:07:15.35,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:07:16.14,0:07:17.35,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:18.47,0:07:19.98,Default,,0,0,0,,Енді жағдай тынышталды
Dialogue: 0,0:07:20.06,0:07:22.85,Default,,0,0,0,,Мақсаттарыңызды жазып, осы жерге қойыңыз.
Dialogue: 0,0:07:25.06,0:07:28.40,Default,,0,0,0,,Мақсат? Не істеуім керек?
Dialogue: 0,0:07:28.48,0:07:30.86,Default,,0,0,0,,Мен үлкен нәрсе жазғым келеді.
Dialogue: 0,0:07:33.20,0:07:35.37,Default,,0,0,0,,Хм, сен не оқисың?
Dialogue: 0,0:07:36.99,0:07:38.12,Default,,0,0,0,,«Гокикадан»
Dialogue: 0,0:07:38.20,0:07:40.37,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:07:40.46,0:07:41.79,Default,,0,0,0,,- (мүше) Иә? -(Нишида) Хехехехе
Dialogue: 0,0:07:41.87,0:07:43.62,Default,,0,0,0,,Сәлем Нишида
Dialogue: 0,0:07:44.54,0:07:47.13,Default,,0,0,0,,Егер сіз канжиде қате жіберсеңіз, оны қайта жазыңыз.
Dialogue: 0,0:07:47.88,0:07:50.13,Default,,0,0,0,,Өзіңізді жақсы сезінсеңіз, бәрі жақсы.
Dialogue: 0,0:07:50.21,0:07:51.30,Default,,0,0,0,,Хаа…
Dialogue: 0,0:07:51.38,0:07:52.26,Default,,0,0,0,,Ах
Dialogue: 0,0:07:53.01,0:07:54.39,Default,,0,0,0,,Харию...
Dialogue: 0,0:07:58.10,0:08:00.64,Default,,0,0,0,,Сіз оны маған қоюды тоқтата аласыз ба?
Dialogue: 0,0:08:01.98,0:08:04.06,Default,,0,0,0,,Оны тігілген төбеге салайық.
Dialogue: 0,0:08:04.15,0:08:07.06,Default,,0,0,0,,О, сен Тенжо Тенка Юига Доконсонды айтып тұрсың ба?
Dialogue: 0,0:08:07.15,0:08:09.40,Default,,0,0,0,,(Нишиданың күлкісі)
Dialogue: 0,0:08:10.07,0:08:10.94,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:17.95,0:08:19.87,Default,,0,0,0,,Дайки Маған таспаны беріңіз!
Dialogue: 0,0:08:20.49,0:08:21.75,Default,,0,0,0,,О
Dialogue: 0,0:08:23.21,0:08:27.21,Default,,0,0,0,,А, сендер де қызыл ұпай алмайсыңдар деп жазыңдар.
Dialogue: 0,0:08:27.29,0:08:31.51,Default,,0,0,0,,Директор: Қолымнан келмейтін нәрсені жаза алмаймын.
Dialogue: 0,0:08:31.59,0:08:33.67,Default,,0,0,0,,Нишида, сен...
Dialogue: 0,0:08:36.01,0:08:36.89,Default,,0,0,0,,Хой
Dialogue: 0,0:08:36.97,0:08:38.26,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:08:43.56,0:08:44.69,Default,,0,0,0,,Эммануэль
Dialogue: 0,0:08:44.77,0:08:49.65,Default,,0,0,0,,Ең жақын досы Кевинмен әңгімелесу.
Dialogue: 0,0:08:49.73,0:08:53.69,Default,,0,0,0,,Эй Кевин, сен білесің бе, мен жақында...
Dialogue: 0,0:08:55.28,0:08:56.66,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:08:56.74,0:08:57.99,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:08:58.53,0:08:59.62,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:08:59.70,0:09:01.20,Default,,0,0,0,,Бұл туған жердің жігіті кім?
Dialogue: 0,0:09:07.67,0:09:09.21,Default,,0,0,0,,Соғыс!
Dialogue: 0,0:09:20.72,0:09:21.47,Default,,0,0,0,,
Dialogue: 0,0:09:24.02,0:09:25.48,Default,,0,0,0,,Жазғы салқын?
Dialogue: 0,0:09:26.81,0:09:28.73,Default,,0,0,0,,Үзіліс жасауым керек пе?
Dialogue: 0,0:09:33.44,0:09:34.40,Default,,0,0,0,,(алдыңғы есіктің ашылған дыбысы)
Dialogue: 0,0:09:34.53,0:09:37.24,Default,,0,0,0,,Ах Чинацу-чан, қош келдіңіз
Dialogue: 0,0:09:38.20,0:09:40.12,Default,,0,0,0,,Кеш қалғаныңыз үшін рахмет.
Dialogue: 0,0:09:40.20,0:09:42.16,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым
Dialogue: 0,0:09:42.24,0:09:44.83,Default,,0,0,0,,Жоқ, жақсы, жақсы.
Dialogue: 0,0:09:44.91,0:09:46.50,Default,,0,0,0,,Мен үшін алаңдама
Dialogue: 0,0:09:46.58,0:09:48.83,Default,,0,0,0,,Бұл Inter-High үшін.
Dialogue: 0,0:09:50.04,0:09:51.63,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:16.86,0:10:20.28,Default,,0,0,0,,Бұл аяқталды!
Dialogue: 0,0:10:21.12,0:10:23.83,Default,,0,0,0,,Біз қолдан келгеннің бәрін жасадық! Мен қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:10:23.91,0:10:24.70,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:10:24.79,0:10:27.79,Default,,0,0,0,,Тестілеуден кейін мен үйірме жұмыстарына көп жұмыс жасадым.
Dialogue: 0,0:10:28.54,0:10:31.79,Default,,0,0,0,,Нәтижеге қарамастан, бір нәрсені орындаудың мәні бар.
Dialogue: 0,0:10:31.88,0:10:33.29,Default,,0,0,0,,Бұл дұрыс, дұрыс.
Dialogue: 0,0:10:34.30,0:10:36.05,Default,,0,0,0,,Іске қосу үшін отбасылық мейрамханаға барайық.
Dialogue: 0,0:10:36.55,0:10:37.47,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:10:37.55,0:10:39.30,Default,,0,0,0,,Нишиданың сыйы!
Dialogue: 0,0:10:39.38,0:10:41.30,Default,,0,0,0,,- (Нишида) Ғайза! -(Г мүшесі) Кеттік!
Dialogue: 0,0:10:42.35,0:10:44.31,Default,,0,0,0,,Жоқ. Неліктен бұлай болды?
Dialogue: 0,0:10:44.81,0:10:46.18,Default,,0,0,0,,Үлкен қуаныш, не істеуіміз керек?
Dialogue: 0,0:10:46.27,0:10:47.06,Default,,0,0,0,,Ах~
Dialogue: 0,0:10:48.23,0:10:50.06,Default,,0,0,0,,Мен өтемін
Dialogue: 0,0:10:50.69,0:10:52.02,Default,,0,0,0,,Яғни, қарапайым есептеу бойынша да ол тек екі минуттан кейін ғана пайда болуы тиіс еді.
Dialogue: 0,0:10:52.52,0:10:54.48,Default,,0,0,0,,Ұйқы аз
Dialogue: 0,0:10:54.57,0:10:56.15,Default,,0,0,0,,Үйге барып ұйықтасаң, жақсы болады.
Dialogue: 0,0:10:58.32,0:11:01.57,Default,,0,0,0,,Мен ертеңнен бастап тағы да қатты жаттығуым керек.
Dialogue: 0,0:11:02.74,0:11:04.08,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:11:04.16,0:11:05.87,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:11:06.87,0:11:07.91,Default,,0,0,0,,Олай болса, біз де барамыз ба?
Dialogue: 0,0:11:08.00,0:11:08.83,Default,,0,0,0,,That's right.
Dialogue: 0,0:11:17.38,0:11:21.93,Default,,0,0,0,,(баспалдақпен көтерілу дыбысы)
Dialogue: 0,0:11:24.93,0:11:26.10,Default,,0,0,0,,Хаа…
Dialogue: 0,0:11:27.64,0:11:29.35,Default,,0,0,0,,Бас ауруы...
Dialogue: 0,0:11:30.60,0:11:32.44,Default,,0,0,0,,Мынаның қызуы көтеріліп тұр.
Dialogue: 0,0:11:34.19,0:11:35.86,Default,,0,0,0,,Мен покари ішкім келеді
Dialogue: 0,0:11:36.69,0:11:38.48,Default,,0,0,0,,Бірақ үйде ешкім жоқ.
Dialogue: 0,0:11:39.65,0:11:44.03,Default,,0,0,0,,Мен Чинацу-сенпайды жұқтырып алмауым керек.
Dialogue: 0,0:11:45.24,0:11:46.99,Default,,0,0,0,,Ах~
Dialogue: 0,0:11:47.08,0:11:50.79,Default,,0,0,0,,Бұл қауіпті...
Dialogue: 0,0:11:52.92,0:11:54.58,Default,,0,0,0,,Осындай кезде...
Dialogue: 0,0:11:59.51,0:12:01.55,Default,,0,0,0,,Жағымсыз нәрсені еске түсіру
Dialogue: 0,0:12:03.43,0:12:06.85,Default,,0,0,0,,Тест кезінде ойымнан өшіріп тастасам да.
Dialogue: 0,0:12:08.76,0:12:13.10,Default,,0,0,0,,Егер өзімді жақсы сезінсем, жүгіріп, басымды босататын едім.
Dialogue: 0,0:12:15.27,0:12:16.27,Default,,0,0,0,,
Dialogue: 0,0:12:22.61,0:12:24.66,Default,,0,0,0,,Жоғары аралық өтінемін!
Dialogue: 0,0:12:26.24,0:12:29.08,Default,,0,0,0,,Рахмет, Тайки-кун Иномата
Dialogue: 0,0:12:31.75,0:12:33.41,Default,,0,0,0,,Оны тым байыппен қабылдамаңыз
Dialogue: 0,0:12:34.25,0:12:35.21,Default,,0,0,0,,Келесі жолы мен жеңемін
Dialogue: 0,0:12:36.21,0:12:37.33,Default,,0,0,0,,Міне!
Dialogue: 0,0:12:37.42,0:12:40.76,Default,,0,0,0,,Бірақ Дайки күшейе түседі деп ойлаймын.
Dialogue: 0,0:12:41.34,0:12:42.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:42.09,0:12:43.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:43.59,0:12:47.26,Default,,0,0,0,,Көп ойланба, қолыңнан келгенін істе.
Dialogue: 0,0:12:49.10,0:12:50.31,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:12:51.60,0:12:55.81,Default,,0,0,0,,Өтінемін, мен Чинацу-сенпай екеуміз Интер-Хайға бара аламыз деп үміттенемін.
Dialogue: 0,0:12:57.35,0:12:59.23,Default,,0,0,0,,Үлкен қуаныш!
Dialogue: 0,0:13:14.62,0:13:15.37,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:17.63,0:13:19.59,Default,,0,0,0,,Мен жайсызмын
Dialogue: 0,0:13:21.38,0:13:23.01,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:13:23.88,0:13:25.38,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:28.30,0:13:29.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:34.56,0:13:35.77,Default,,0,0,0,,Олардың мен адамзаттың күш арасындағы алшақтық аса үлкен еді,
Dialogue: 0,0:13:37.81,0:13:39.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:42.40,0:13:43.78,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:13:51.49,0:13:52.54,Default,,0,0,0,,(секіру дыбысы)
Dialogue: 0,0:13:53.37,0:13:54.95,Default,,0,0,0,,Чинацу-сенпай!
Dialogue: 0,0:13:55.04,0:13:56.12,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:56.21,0:13:59.54,Default,,0,0,0,,Мен қазір өзімді жақсы сезінбеймін, егер жұқтырып алсам, қиналып қаламын, сондықтан кетемін...
Dialogue: 0,0:13:59.63,0:14:00.79,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:14:01.84,0:14:03.80,Default,,0,0,0,,Науқастың тыныштығын сақтаңыз
Dialogue: 0,0:14:06.42,0:14:07.68,Default,,0,0,0,,Иә...
Dialogue: 0,0:14:18.94,0:14:19.94,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:43.79,0:14:45.09,Default,,0,0,0,,
Dialogue: 0,0:14:45.84,0:14:46.38,Default,,0,0,0,,Иә
Dialogue: 0,0:14:49.80,0:14:51.39,Default,,0,0,0,,Өйткені удон болды
Dialogue: 0,0:14:51.47,0:14:53.76,Default,,0,0,0,,Әзірше ішімізге бірдеңе салып көрейік.
Dialogue: 0,0:14:54.85,0:14:55.68,Default,,0,0,0,,Удон...
Dialogue: 0,0:14:55.76,0:14:58.52,Default,,0,0,0,,Чинацу-сенпайдың үйдегі тағамы!
Dialogue: 0,0:14:59.39,0:15:00.35,Default,,0,0,0,,Иә
Dialogue: 0,0:15:02.98,0:15:06.03,Default,,0,0,0,,Юкико-сан, сен үйге кеш бара жатқан сияқтысың.
Dialogue: 0,0:15:06.73,0:15:09.40,Default,,0,0,0,,Қарапайым болғаным үшін кешіріңіз.
Dialogue: 0,0:15:11.20,0:15:13.03,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:14.99,0:15:17.24,Default,,0,0,0,,Ағаның ас әзірлеуі...
Dialogue: 0,0:15:21.04,0:15:22.37,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:15:23.46,0:15:26.25,Default,,0,0,0,,Өте ұзақ уақыттан бері көрмеппін.
Dialogue: 0,0:15:31.38,0:15:34.80,Default,,0,0,0,,Мұрным бітеліп, тамақтың дәмін татпаймын.
Dialogue: 0,0:15:35.80,0:15:38.06,Default,,0,0,0,,Тағы бірдеңе алғыңыз келсе, маған хабарлаңыз.
Dialogue: 0,0:15:39.39,0:15:41.10,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:43.40,0:15:44.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:46.86,0:15:47.90,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:51.65,0:15:54.37,Default,,0,0,0,,Екеуміздің жақын болғанымызға біраз болды.
Dialogue: 0,0:15:54.45,0:15:56.58,Default,,0,0,0,,2 таблетка қабылдауға болады ма?
Dialogue: 0,0:15:57.95,0:15:58.58,Default,,0,0,0,,Ум...
Dialogue: 0,0:16:00.62,0:16:04.58,Default,,0,0,0,,Шынымен де, қазір бәрі жақсы, бөлмеңе қайтуға болады.
Dialogue: 0,0:16:05.50,0:16:07.80,Default,,0,0,0,,Мен Дайки-кун төсекке кеткенше тұрамын.
Dialogue: 0,0:16:07.88,0:16:10.09,Default,,0,0,0,,Сіздің физикалық жағдайыңыз нашарлауы мүмкін.
Dialogue: 0,0:16:11.13,0:16:13.09,Default,,0,0,0,,Бірақ мен ұйықтамаймын...
Dialogue: 0,0:16:15.89,0:16:18.35,Default,,0,0,0,,Олай болса, мен сенімен бір сәт сөйлесе аламын ба?
Dialogue: 0,0:16:19.14,0:16:23.35,Default,,0,0,0,,Қараңызшы, соңғы кездері жарыстар мен сынақтардың кесірінен сөйлей алмай қалдым.
Dialogue: 0,0:16:23.85,0:16:26.36,Default,,0,0,0,,Оның үстіне Дайки-кун солай айтты, солай ма?
Dialogue: 0,0:16:26.94,0:16:30.78,Default,,0,0,0,,Ол турнир аяқталған соң маған қояр сұрағы бар екенін айтты.
Dialogue: 0,0:16:32.70,0:16:34.70,Default,,0,0,0,,Ым... Чинацу-сенпай
Dialogue: 0,0:16:34.78,0:16:37.62,Default,,0,0,0,,Ертеңнен кейін бір сұрақ қойсам болады ма?
Dialogue: 0,0:16:38.37,0:16:40.99,Default,,0,0,0,,Сіз мұны айттыңыз ба?
Dialogue: 0,0:16:41.08,0:16:43.37,Default,,0,0,0,,А, мен саған берейін деп жатырмын.
Dialogue: 0,0:16:43.46,0:16:46.46,Default,,0,0,0,,Хаха... Бұл дұрыс емес.
Dialogue: 0,0:16:48.21,0:16:49.63,Default,,0,0,0,,Бірақ сол кезде
Dialogue: 0,0:16:51.21,0:16:54.97,Default,,0,0,0,,Себебі мен оны естуге сенімді болдым.
Dialogue: 0,0:16:55.97,0:16:59.43,Default,,0,0,0,,Чоно мырзаны көргенде мен қызғандым.
Dialogue: 0,0:17:10.36,0:17:12.90,Default,,0,0,0,,Сонымен, мен сізге сұрақ қоя аламын ба?
Dialogue: 0,0:17:14.32,0:17:14.95,Default,,0,0,0,,Иә
Dialogue: 0,0:17:15.45,0:17:18.16,Default,,0,0,0,,Бүгін Буд клубының мақсаттары жазылды.
Dialogue: 0,0:17:18.24,0:17:19.91,Default,,0,0,0,,Мен стикерді көрдім.
Dialogue: 0,0:17:19.99,0:17:20.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:21.83,0:17:26.33,Default,,0,0,0,,Мен Дайки-кун «интер-жоғары қатысу» деп жазады деп ойладым.
Dialogue: 0,0:17:28.50,0:17:32.17,Default,,0,0,0,,Сондықтан мен бұл туралы жазбадым.
Dialogue: 0,0:17:33.80,0:17:35.17,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:36.13,0:17:39.76,Default,,0,0,0,,Матчта жекпе-жек болғанын қалаймын.
Dialogue: 0,0:17:39.85,0:17:41.18,Default,,0,0,0,,Бірнеше болды
Dialogue: 0,0:17:42.31,0:17:46.52,Default,,0,0,0,,Мен Inter-High мен үшін тым алыс болуы мүмкін деп ойладым.
Dialogue: 0,0:17:48.02,0:17:53.15,Default,,0,0,0,,Турнирге барғанымда менен мықтылар ғана болды.
Dialogue: 0,0:17:55.28,0:17:59.41,Default,,0,0,0,,Чинацу-сенпай бірінші курсында Интер-Хайдың қыр-сырын үйренді.
Dialogue: 0,0:17:59.49,0:18:02.70,Default,,0,0,0,,Сонда да мен сынаққа дайын болдым.
Dialogue: 0,0:18:03.87,0:18:08.37,Default,,0,0,0,,Мен жай ғана барып, жеңгім келеді.
Dialogue: 0,0:18:08.87,0:18:11.38,Default,,0,0,0,,Мүмкін мен не істеп жатқанымды білмеген шығармын
Dialogue: 0,0:18:13.75,0:18:14.76,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:17.05,0:18:20.22,Default,,0,0,0,,А... күліп тұрсың ба?
Dialogue: 0,0:18:20.30,0:18:21.72,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:18:22.68,0:18:25.97,Default,,0,0,0,,Тіпті Дайки-кун да солай ойлайды.
Dialogue: 0,0:18:27.64,0:18:29.48,Default,,0,0,0,,А... Тамақ бергеніңізге рахмет.
Dialogue: 0,0:18:29.56,0:18:30.98,Default,,0,0,0,,Осоматсусама
Dialogue: 0,0:18:31.61,0:18:34.86,Default,,0,0,0,,Жоқ, мен бұл туралы ойланамын деп ойладым...
Dialogue: 0,0:18:35.36,0:18:37.49,Default,,0,0,0,,Өйткені ол көпшілікке көрсетілмеген сурет болатын
Dialogue: 0,0:18:38.32,0:18:39.57,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:18:41.07,0:18:43.74,Default,,0,0,0,,Жақсы, Жаңа Дайки-кун
Dialogue: 0,0:18:45.54,0:18:49.58,Default,,0,0,0,,Егер сіздің мақсатыңыз алыс болса және өзіңізге де жақыннан қараңыз
Dialogue: 0,0:18:51.12,0:18:55.00,Default,,0,0,0,,Бірақ қазір мен үшін алыстағы мақсатым...
Dialogue: 0,0:18:56.09,0:18:58.51,Default,,0,0,0,,Дайки-кун дайындалды деді.
Dialogue: 0,0:19:00.47,0:19:02.51,Default,,0,0,0,,Мүмкін сіз не істеп жатқаныңызды білмейсіз бе?
Dialogue: 0,0:19:03.80,0:19:05.51,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:19:06.35,0:19:09.77,Default,,0,0,0,,Мен де осыны үнемі ойымда қалдым.
Dialogue: 0,0:19:10.85,0:19:13.02,Default,,0,0,0,,Анықтау қысымға айналады
Dialogue: 0,0:19:18.90,0:19:21.36,Default,,0,0,0,,Егер біз ымыраға келсек, қаншалықты оңай болар еді
Dialogue: 0,0:19:23.70,0:19:26.79,Default,,0,0,0,,Мен осылай ойлағаны үшін өзімді жек көремін.
Dialogue: 0,0:19:28.70,0:19:33.25,Default,,0,0,0,,Бірақ мен орта мектепке барғым келді.
Dialogue: 0,0:19:33.75,0:19:35.29,Default,,0,0,0,,Таңертең бірінші болып ояндым
Dialogue: 0,0:19:36.50,0:19:40.38,Default,,0,0,0,,Егер мен «осындай болғым келсе» немесе «мұны істегім келсе»
Dialogue: 0,0:19:40.47,0:19:42.38,Default,,0,0,0,,Мен мұны бағалағаныңызды қалаймын.
Dialogue: 0,0:19:43.59,0:19:47.31,Default,,0,0,0,,Алыс мақсаттар қоюдан қорықпа
Dialogue: 0,0:19:48.27,0:19:53.27,Default,,0,0,0,,Қанша білімсіз болсаң да, егер бұл сіздің күш-жігеріңізге қозғаушы күшке айналса.
Dialogue: 0,0:19:53.35,0:19:55.31,Default,,0,0,0,,Менің ойымша, бұл жеткілікті.
Dialogue: 0,0:19:56.27,0:19:59.40,Default,,0,0,0,,Мен осындай адамдарды қолдаймын.
Dialogue: 0,0:20:01.03,0:20:01.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:03.16,0:20:05.53,Default,,0,0,0,,
Dialogue: 0,0:20:06.37,0:20:08.58,Default,,0,0,0,,- (Чинацу) Жақсысың ба? - (қуанып) Иә.
Dialogue: 0,0:20:08.66,0:20:09.33,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:10.08,0:20:11.58,Default,,0,0,0,,Қазір ұйықтаңыз
Dialogue: 0,0:20:12.71,0:20:15.08,Default,,0,0,0,,О, мен...
Dialogue: 0,0:20:16.88,0:20:19.76,Default,,0,0,0,,Маған бұл адам ұнайды.
Dialogue: 0,0:20:20.42,0:20:23.34,Default,,0,0,0,,Оны өзіңіз сезініп, алаңдаңыз
Dialogue: 0,0:20:23.43,0:20:26.18,Default,,0,0,0,,Өйткені менің актерлік тәжірибем бар
Dialogue: 0,0:20:27.51,0:20:29.60,Default,,0,0,0,,Сіз басқа адамның сезімін де қарастыра аласыз.
Dialogue: 0,0:20:31.64,0:20:33.48,Default,,0,0,0,,Мейірімді бола алатын адам
Dialogue: 0,0:20:35.85,0:20:39.40,Default,,0,0,0,,Ескертпе қосыңыз
Dialogue: 0,0:20:43.20,0:20:44.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:45.45,0:20:46.62,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:20:53.16,0:20:56.08,Default,,0,0,0,,Онда мен оны тазалаймын.
Dialogue: 0,0:20:56.58,0:20:57.79,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:20:57.88,0:20:59.38,Default,,0,0,0,,Жай ғана ұйықта.
Dialogue: 0,0:21:00.05,0:21:00.88,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:08.64,0:21:09.97,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:21:10.97,0:21:11.97,Default,,0,0,0,,Ах
Dialogue: 0,0:21:24.57,0:21:25.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:27.74,0:21:29.70,Default,,0,0,0,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:21:33.33,0:21:35.41,Default,,0,0,0,,Менің басым айналып кетті.
Dialogue: 0,0:21:39.29,0:21:39.92,Default,,0,0,0,,Е...
Dialogue: 0,0:22:06.61,0:22:08.61,Default,,0,0,0,,♪~
Dialogue: 0,0:23:33.91,0:23:35.91,Default,,0,0,0,,~♪
