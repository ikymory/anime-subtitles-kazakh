Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.54,0:00:03.54,Default,,0,0,0,,♪~
Dialogue: 0,0:01:28.50,0:01:30.50,Default,,0,0,0,,~♪
Dialogue: 0,0:01:31.67,0:01:33.00,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:01:49.73,0:01:50.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:50.52,0:01:51.69,Default,,0,0,0,,Пиллинг
Dialogue: 0,0:01:51.77,0:01:52.69,Default,,0,0,0,,А...
Dialogue: 0,0:01:54.90,0:01:56.74,Default,,0,0,0,,Тек ұйықтап қал.
Dialogue: 0,0:02:01.83,0:02:03.03,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:02:03.12,0:02:03.95,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:02:04.87,0:02:05.54,Default,,0,0,0,,2-раунд, 1-жекпе-жек
Dialogue: 0,0:02:06.54,0:02:10.21,Default,,0,0,0,,Сен осылай ұйықтай аласың ба?!
Dialogue: 0,0:02:13.80,0:02:14.80,Default,,0,0,0,,(термометр дабылы)
Dialogue: 0,0:02:15.55,0:02:19.34,Default,,0,0,0,,36,5 градус Толық қалпына келтіру.
Dialogue: 0,0:02:19.93,0:02:21.18,Default,,0,0,0,,Ал...
Dialogue: 0,0:02:21.68,0:02:24.31,Default,,0,0,0,,Сіз шаршаған сияқтысыз.
Dialogue: 0,0:02:24.81,0:02:25.97,Default,,0,0,0,,Сіз үйірмеге барасыз ба?
Dialogue: 0,0:02:26.47,0:02:27.60,Default,,0,0,0,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:02:27.68,0:02:30.48,Default,,0,0,0,,Мен бүгін демалсам екен.
Dialogue: 0,0:02:30.56,0:02:33.82,Default,,0,0,0,,Чинацу-чан екеуміз бар күшімізді саламыз.
Dialogue: 0,0:02:34.90,0:02:36.11,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:02:38.28,0:02:41.61,Default,,0,0,0,,Бұл нәрсе біраз уақытқа созылады.
Dialogue: 0,0:02:43.28,0:02:45.99,Default,,0,0,0,,Мен үйірме жұмыстарына көңіл бөлуім керек
Dialogue: 0,0:02:47.79,0:02:49.66,Default,,0,0,0,,Жеңіл салмақ және
Dialogue: 0,0:02:50.67,0:02:53.00,Default,,0,0,0,,Сусабынның иісі
Dialogue: 0,0:02:53.08,0:02:54.63,Default,,0,0,0,,Сен бақыттысың, Гриша…
Dialogue: 0,0:02:55.50,0:02:57.51,Default,,0,0,0,,Кең ашық алаңда шын мәнінде өзін көрсетеді, иә?
Dialogue: 0,0:02:58.21,0:03:00.47,Default,,0,0,0,,Бұл дөрекі...
Dialogue: 0,0:03:00.55,0:03:01.38,Default,,0,0,0,,Үлкен қуаныш
Dialogue: 0,0:03:01.97,0:03:03.39,Default,,0,0,0,,Ол әзілдеген болатын, сондықтан сен оның үшін жасап бердің ғой?
Dialogue: 0,0:03:03.47,0:03:04.55,Default,,0,0,0,,Асқазаныңыз ауырады ма?
Dialogue: 0,0:03:04.64,0:03:05.68,Default,,0,0,0,,Ах
Dialogue: 0,0:03:05.76,0:03:08.73,Default,,0,0,0,,Егер сіз біртүрлі дыбыстар шығаратындай ауырып жатсаңыз, үзіліс жасаңыз.
Dialogue: 0,0:03:09.23,0:03:10.77,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:11.27,0:03:13.40,Default,,0,0,0,,Сіздің үлкендеріңіз не істеп жатыр?
Dialogue: 0,0:03:14.27,0:03:15.65,Default,,0,0,0,,Бассейнді тазалау.
Dialogue: 0,0:03:17.03,0:03:18.61,Default,,0,0,0,,Менің сынып жетекшім маған тапсырма берді
Dialogue: 0,0:03:19.11,0:03:22.45,Default,,0,0,0,,Гимназияны қазіргі уақытта волейбол үйірмесі жаттығу ойындары үшін пайдаланады.
Dialogue: 0,0:03:22.53,0:03:24.49,Default,,0,0,0,,Уақытты соңына дейін өлтіру
Dialogue: 0,0:03:24.99,0:03:27.70,Default,,0,0,0,,Мен қызыл нүктені елемейтініңді айттым.
Dialogue: 0,0:03:28.20,0:03:30.71,Default,,0,0,0,,Маған да көмектесіңізші.
Dialogue: 0,0:03:31.21,0:03:33.75,Default,,0,0,0,,Бірақ мен бұлшықет жаттығуларын жасауды шештім...
Dialogue: 0,0:03:48.35,0:03:49.77,Default,,0,0,0,,Мен мұны істеймін...
Dialogue: 0,0:03:51.94,0:03:54.44,Default,,0,0,0,,- (Харю) Аяғың суланбасын - (Үлкен қуаныш) Иә.
Dialogue: 0,0:03:55.02,0:03:57.98,Default,,0,0,0,,Мен Чинацу-сенпайдың қасында болғым келмейді.
Dialogue: 0,0:03:58.07,0:04:01.11,Default,,0,0,0,,Ондай қара ниет жоқ.
Dialogue: 0,0:04:01.19,0:04:02.45,Default,,0,0,0,,Маған көмектесіңізші...
Dialogue: 0,0:04:05.91,0:04:06.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:11.54,0:04:14.46,Default,,0,0,0,,Haryuu Inter-High шешілген сияқты.
Dialogue: 0,0:04:15.29,0:04:18.00,Default,,0,0,0,,Осындай жерде тазалауға бола ма?
Dialogue: 0,0:04:18.09,0:04:19.63,Default,,0,0,0,,It's okay.
Dialogue: 0,0:04:19.71,0:04:22.51,Default,,0,0,0,,Олар көмектессем, бассейнді пайдалануға рұқсат ететіндерін айтты.
Dialogue: 0,0:04:22.59,0:04:24.51,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:04:24.59,0:04:28.43,Default,,0,0,0,,Ах, Харьюдің 25 метрлік мәңгілік жүзуі.
Dialogue: 0,0:04:28.51,0:04:31.56,Default,,0,0,0,,Ол жігіттің дене күші түбі жоқ.
Dialogue: 0,0:04:31.64,0:04:33.89,Default,,0,0,0,,Балалар мен сендерге де маған еріп жүрулерін сұраймын.
Dialogue: 0,0:04:33.98,0:04:34.94,Default,,0,0,0,,Не!
Dialogue: 0,0:04:35.02,0:04:37.94,Default,,0,0,0,,Жүзу жақсы, бұл бүкіл денені шынықтыру
Dialogue: 0,0:04:38.02,0:04:40.32,Default,,0,0,0,,- (Нишида) Мен қашып барамын! - (қуанып) Не! Эй...
Dialogue: 0,0:04:40.40,0:04:41.19,Default,,0,0,0,,Үлкен қуаныш
Dialogue: 0,0:04:42.65,0:04:46.36,Default,,0,0,0,,Сізге айтайын, сіздің әлсіздігіңіз жай ғана соққы емес.
Dialogue: 0,0:04:46.95,0:04:47.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:48.95,0:04:51.20,Default,,0,0,0,,Неліктен барлығы стикерге қарап тұр...
Dialogue: 0,0:04:51.70,0:04:53.37,Default,,0,0,0,,Ол жарияланды.
Dialogue: 0,0:04:53.96,0:04:57.42,Default,,0,0,0,,Юса есімді жігітке қарсы өткен префектуралық іріктеу матчы
Dialogue: 0,0:04:57.92,0:04:59.75,Default,,0,0,0,,Сіз тұруға тым баяусыз.
Dialogue: 0,0:04:59.84,0:05:02.96,Default,,0,0,0,,Сіз аяқтарыңызды мүлде қозғалта алмадыңыз.
Dialogue: 0,0:05:04.92,0:05:08.26,Default,,0,0,0,,Сол бір жыл келесі жылға дейін деңгейді қайтадан көтереді.
Dialogue: 0,0:05:09.76,0:05:12.60,Default,,0,0,0,,Депрессияға түсіп уақытыңызды босқа өткізбеңіз.
Dialogue: 0,0:05:16.85,0:05:19.65,Default,,0,0,0,,Біз оларды қашып құтылуға ешқашан жол бермейміз
Dialogue: 0,0:05:19.73,0:05:21.23,Default,,0,0,0,,Жарайды, маңызды емес.
Dialogue: 0,0:05:21.73,0:05:24.82,Default,,0,0,0,,Жекелей сында жеңілсең де, маған бәрібір.
Dialogue: 0,0:05:24.90,0:05:25.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:26.07,0:05:29.45,Default,,0,0,0,,Бірақ егер сіз тым аю болып кетсеңіз
Dialogue: 0,0:05:29.53,0:05:31.78,Default,,0,0,0,,Начи-сенпай
Dialogue: 0,0:05:31.87,0:05:34.37,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың?
Dialogue: 0,0:05:34.87,0:05:37.04,Default,,0,0,0,,Жақсы ауа-райы туралы әңгімелеу
Dialogue: 0,0:05:37.12,0:05:39.67,Default,,0,0,0,,Мм... Иә, солай.
Dialogue: 0,0:05:40.17,0:05:41.04,Default,,0,0,0,,Шынымен
Dialogue: 0,0:05:41.13,0:05:42.88,Default,,0,0,0,,Бұл үшін кешіріңіз.
Dialogue: 0,0:05:42.96,0:05:44.63,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:05:44.71,0:05:45.72,Default,,0,0,0,,Хаа…
Dialogue: 0,0:05:48.34,0:05:51.76,Default,,0,0,0,,Чинацумен қандай да бір ілгерілеушілік бар ма?
Dialogue: 0,0:05:52.26,0:05:54.39,Default,,0,0,0,,Иә, иә... а...
Dialogue: 0,0:05:55.02,0:05:56.56,Default,,0,0,0,,Қандай реакция түрі?
Dialogue: 0,0:05:58.10,0:06:00.35,Default,,0,0,0,,Жарайды, сөйлескің келмесе, мен сұрамаймын.
Dialogue: 0,0:06:04.57,0:06:06.24,Default,,0,0,0,,Ум...
Dialogue: 0,0:06:06.74,0:06:09.03,Default,,0,0,0,,Импульстің болуы туралы ой қайдан шыққан?
Dialogue: 0,0:06:09.53,0:06:10.32,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:10.41,0:06:13.03,Default,,0,0,0,,Білемін, мен танымал емеспін!
Dialogue: 0,0:06:13.12,0:06:17.75,Default,,0,0,0,,Дегенмен, мен әдетте стандарттар жоқ па деп ойлаймын.
Dialogue: 0,0:06:18.25,0:06:20.71,Default,,0,0,0,,Бұл жігіт шынымен Чиге бара ма?
Dialogue: 0,0:06:20.79,0:06:23.09,Default,,0,0,0,,Сіздің атыңыз аталды ма?
Dialogue: 0,0:06:23.59,0:06:26.46,Default,,0,0,0,,Бір бөлмеде жалғыз болсақ ше?
Dialogue: 0,0:06:26.55,0:06:27.72,Default,,0,0,0,,Бұл адамға байланысты.
Dialogue: 0,0:06:28.30,0:06:29.30,Default,,0,0,0,,Мұндай емес қой. (Миямура) Шынымен бе?
Dialogue: 0,0:06:29.38,0:06:32.14,Default,,0,0,0,,Мұны түсіну оңай емес, солай емес пе?
Dialogue: 0,0:06:32.22,0:06:33.93,Default,,0,0,0,,Мен мұны білдім, бірақ
Dialogue: 0,0:06:34.01,0:06:35.77,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:06:35.85,0:06:38.73,Default,,0,0,0,,Жоқ, бірақ сіздің жағдайыңызда солай ма?
Dialogue: 0,0:06:40.52,0:06:42.90,Default,,0,0,0,,Мен де ұлдармен қалыпты сөйлесемін.
Dialogue: 0,0:06:42.98,0:06:45.73,Default,,0,0,0,,Біз жынысына қарамастан жақсы араласамыз.
Dialogue: 0,0:06:45.82,0:06:47.07,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:06:47.15,0:06:49.28,Default,,0,0,0,,Бірақ күткендей, импульс жоқ.
Dialogue: 0,0:06:49.36,0:06:52.45,Default,,0,0,0,,Мен оған өзім тиіспеймін деп ойлаймын.
Dialogue: 0,0:06:53.24,0:06:56.24,Default,,0,0,0,,Менің ойымша, мен бұл жерде қашықтықты сезінемін.
Dialogue: 0,0:06:59.62,0:07:02.29,Default,,0,0,0,,Жоқ, жоқ, тынышталыңыз.
Dialogue: 0,0:07:02.38,0:07:04.50,Default,,0,0,0,,Бұл жай ғана қабығы аршылған.
Dialogue: 0,0:07:04.59,0:07:06.63,Default,,0,0,0,,Терең мағына жоқ.
Dialogue: 0,0:07:07.13,0:07:09.80,Default,,0,0,0,,Біртүрлі болжам жасаудың қажеті жоқ.
Dialogue: 0,0:07:15.76,0:07:17.39,Default,,0,0,0,,Үміт үзбе
Dialogue: 0,0:07:23.52,0:07:25.11,Default,,0,0,0,,- (Нишида) Yaho! -(Ине) Уау!
Dialogue: 0,0:07:25.73,0:07:26.82,Default,,0,0,0,,Buha!
Dialogue: 0,0:07:27.32,0:07:28.44,Default,,0,0,0,,Секірме, ақымақ!
Dialogue: 0,0:07:28.53,0:07:31.57,Default,,0,0,0,,Өте жақсы сезіледі, келіңіздер!
Dialogue: 0,0:07:31.65,0:07:35.66,Default,,0,0,0,,Мен бұл әрекеттен аулақ боламын, өйткені мен аурудан айығып жатырмын.
Dialogue: 0,0:07:36.16,0:07:38.37,Default,,0,0,0,,Жарайды, онда жасайық, Нишида.
Dialogue: 0,0:07:38.45,0:07:40.04,Default,,0,0,0,,Иә! Амал жоқ...
Dialogue: 0,0:07:40.54,0:07:43.46,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:07:47.00,0:07:48.71,Default,,0,0,0,,Еңбегіңізге рахмет, Дайки-кун.
Dialogue: 0,0:07:50.01,0:07:51.30,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:07:52.30,0:07:54.80,Default,,0,0,0,,Тазалау Бұл сізге мәжбүр болды ма?
Dialogue: 0,0:07:54.89,0:07:55.72,Default,,0,0,0,,Иә
Dialogue: 0,0:07:55.80,0:07:57.47,Default,,0,0,0,,Мені санама!
Dialogue: 0,0:07:57.56,0:08:00.22,Default,,0,0,0,,Ойыңызды табиғи түрде тыныштандырыңыз
Dialogue: 0,0:08:00.93,0:08:03.23,Default,,0,0,0,,Хе-е, қолыңнан келмейді, сенпай.
Dialogue: 0,0:08:06.81,0:08:08.40,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:08:08.48,0:08:11.82,Default,,0,0,0,,Чинацу-сенпайға мән бермейтін сияқты.
Dialogue: 0,0:08:12.82,0:08:15.24,Default,,0,0,0,,Мұндай жерде жалғыз болсақ та
Dialogue: 0,0:08:15.82,0:08:16.82,Default,,0,0,0,,Хаа…
Dialogue: 0,0:08:17.53,0:08:18.45,Default,,0,0,0,,Алға қарай жүрейік
Dialogue: 0,0:08:18.53,0:08:21.08,Default,,0,0,0,,Әй, анау Чинацу-сенпай.
Dialogue: 0,0:08:21.79,0:08:23.33,Default,,0,0,0,,Кешегі күн үшін көп рахмет.
Dialogue: 0,0:08:23.83,0:08:24.96,Default,,0,0,0,,Кеше...
Dialogue: 0,0:08:25.46,0:08:27.04,Default,,0,0,0,,Сіздің арқаңызда қызуым түсіп кетті.
Dialogue: 0,0:08:27.13,0:08:29.96,Default,,0,0,0,,А, иә... кеше.
Dialogue: 0,0:08:30.80,0:08:32.26,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:08:35.34,0:08:36.26,Default,,0,0,0,,Олай болса
Dialogue: 0,0:08:37.76,0:08:39.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:42.39,0:08:43.60,Default,,0,0,0,,Дайки-кун?
Dialogue: 0,0:08:46.90,0:08:48.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:48.11,0:08:49.44,Default,,0,0,0,,Аа, кешіріңіз!
Dialogue: 0,0:08:49.52,0:08:51.78,Default,,0,0,0,,Мм... қазір...
Dialogue: 0,0:08:51.86,0:08:56.11,Default,,0,0,0,,Ба... Мен шелекті қайда қоюым керек?
Dialogue: 0,0:08:56.20,0:08:57.95,Default,,0,0,0,,Менің ойымша, бұл жерде.
Dialogue: 0,0:08:58.03,0:09:00.28,Default,,0,0,0,,Әй, бұл рас, байқамадым.
Dialogue: 0,0:09:00.37,0:09:02.04,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:02.12,0:09:04.71,Default,,0,0,0,,Хехе, ендеше жүрейік.
Dialogue: 0,0:09:05.21,0:09:06.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:10.34,0:09:11.84,Default,,0,0,0,,Қызық па? Әй, жақсы ма өзі?
Dialogue: 0,0:09:13.88,0:09:18.22,Default,,0,0,0,,Мен сенің абай болу керектігін білемін.
Dialogue: 0,0:09:26.35,0:09:27.81,Default,,0,0,0,,Жақсы жұмыс Чинацу
Dialogue: 0,0:09:28.65,0:09:29.52,Default,,0,0,0,,Еңбек тәжірибесі бағдарламасына оралды
Dialogue: 0,0:09:29.61,0:09:32.28,Default,,0,0,0,,Спорт комитетінің мүшесі ретінде жұмысыма көмектескеніңіз үшін рахмет.
Dialogue: 0,0:09:32.36,0:09:34.19,Default,,0,0,0,,Бұл қызық болды.
Dialogue: 0,0:09:34.28,0:09:34.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:35.78,0:09:38.82,Default,,0,0,0,,Ямагучи Сато жұп емес пе?
Dialogue: 0,0:09:38.91,0:09:40.24,Default,,0,0,0,,Мені мазақ етпе
Dialogue: 0,0:09:40.32,0:09:42.29,Default,,0,0,0,,Хаха, сен сондай ұялшақсың.
Dialogue: 0,0:09:42.41,0:09:44.37,Default,,0,0,0,,Жақсы қарым-қатынаста болу жақсы.
Dialogue: 0,0:09:44.45,0:09:45.83,Default,,0,0,0,,О, Құдай-ай…
Dialogue: 0,0:09:45.91,0:09:47.25,Default,,0,0,0,,Танысудан кейін
Dialogue: 0,0:09:47.33,0:09:50.29,Default,,0,0,0,,Ямагучи-чан күннен күнге сүйкімді болып барады.
Dialogue: 0,0:09:50.38,0:09:52.84,Default,,0,0,0,,Жоқ, бұл жастық шақ емес пе?
Dialogue: 0,0:09:56.47,0:10:00.39,Default,,0,0,0,,Нағиса ғашық тапқысы келсе, бірден қолынан келмей ме?
Dialogue: 0,0:10:00.47,0:10:04.85,Default,,0,0,0,,Хмм, егер сіз бұлай десеңіз, мені онша қызықтырмайтын сияқтымын.
Dialogue: 0,0:10:05.47,0:10:07.23,Default,,0,0,0,,Қазір менің үйірме жұмыстарым бар.
Dialogue: 0,0:10:07.73,0:10:09.19,Default,,0,0,0,,Дәл солай Чинацуға да қатысты, солай ма?
Dialogue: 0,0:10:09.81,0:10:10.86,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:13.94,0:10:15.07,Default,,0,0,0,,(Волейбол клубы мүшелерінің жылауы)
Dialogue: 0,0:10:15.15,0:10:16.86,Default,,0,0,0,,Волейбол үйірмесіне не болды?
Dialogue: 0,0:10:16.94,0:10:20.36,Default,,0,0,0,,О, ол мектептерді ауыстырып жатыр.
Dialogue: 0,0:10:21.12,0:10:23.58,Default,,0,0,0,,Менің әжем ауырып қалды.
Dialogue: 0,0:10:23.66,0:10:26.37,Default,,0,0,0,,Волейбол клубы Интер-Хайдан да құр қалды.
Dialogue: 0,0:10:26.95,0:10:28.71,Default,,0,0,0,,Менің айтайын дегенім осы.
Dialogue: 0,0:10:28.79,0:10:31.17,Default,,0,0,0,,Мен Чинацудың бізбен қалғанына қуаныштымын.
Dialogue: 0,0:10:31.67,0:10:33.84,Default,,0,0,0,,Сізге рахмет, мен Интер-Хайге бара аламын.
Dialogue: 0,0:10:33.92,0:10:35.71,Default,,0,0,0,,Маған рахмет...
Dialogue: 0,0:10:35.80,0:10:38.38,Default,,0,0,0,,Қамқорлық көрсеткен туыстарыма рахмет.
Dialogue: 0,0:10:39.88,0:10:40.72,Default,,0,0,0,,Иә
Dialogue: 0,0:10:40.80,0:10:41.89,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:10:41.97,0:10:45.06,Default,,0,0,0,,Туыстың үйінде сымбатты жігіт болса.
Dialogue: 0,0:10:45.14,0:10:48.10,Default,,0,0,0,,Махаббат туы Чинацуда да көтерілген болуы мүмкін.
Dialogue: 0,0:10:48.18,0:10:49.35,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:10:49.44,0:10:51.56,Default,,0,0,0,,Бұлай ренжіме...
Dialogue: 0,0:10:51.65,0:10:54.15,Default,,0,0,0,,Өйткені Нағиса біртүрлі сөздер айтады
Dialogue: 0,0:10:54.23,0:10:56.40,Default,,0,0,0,,Өйткені, сіз білесіз, бұл бір үй.
Dialogue: 0,0:10:56.48,0:10:58.90,Default,,0,0,0,,Үйірме жұмыстарына байланысты кездесуге бара алмасаңыз да, кездесуге болады.
Dialogue: 0,0:10:59.65,0:11:03.16,Default,,0,0,0,,Менің ойымша, олар жақын болмаса, Чинацу ғашық болады деп ойламаймын.
Dialogue: 0,0:11:03.24,0:11:06.91,Default,,0,0,0,,Бір шаңырақтың астында болсаңыз, ұнамаса да байқайтын шығарсыз.
Dialogue: 0,0:11:08.79,0:11:10.92,Default,,0,0,0,,Бұл оңай емес.
Dialogue: 0,0:11:11.50,0:11:13.38,Default,,0,0,0,,Иә? Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:11:13.88,0:11:15.92,Default,,0,0,0,,Жоқ, ештеңе.
Dialogue: 0,0:11:22.51,0:11:24.39,Default,,0,0,0,,Мен саған сусын әкелдім.
Dialogue: 0,0:11:24.47,0:11:26.26,Default,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:11:27.01,0:11:28.18,Default,,0,0,0,,Бұл ет itadaki
Dialogue: 0,0:11:29.35,0:11:31.19,Default,,0,0,0,,Көкөністеріңді де жеңдер!
Dialogue: 0,0:11:33.40,0:11:34.81,Default,,0,0,0,,Пуха Уми
Dialogue: 0,0:11:34.90,0:11:36.57,Default,,0,0,0,,Иә Чинацу-чан
Dialogue: 0,0:11:37.07,0:11:38.73,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:38.82,0:11:42.20,Default,,0,0,0,,Бақшада барбекю болғаны жақсы.
Dialogue: 0,0:11:42.28,0:11:44.32,Default,,0,0,0,,Менің анам барбекю шебері.
Dialogue: 0,0:11:44.41,0:11:46.62,Default,,0,0,0,,Қара, Чинацу-чан, сен де же.
Dialogue: 0,0:11:46.70,0:11:47.83,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:50.91,0:11:52.08,Default,,0,0,0,,Миллионың костюмі сол жігіттің шашынан алынған арнайы талшықтан жасалған.
Dialogue: 0,0:11:52.92,0:11:54.83,Default,,0,0,0,,Көп тамақтаныңыз.
Dialogue: 0,0:11:54.92,0:11:56.25,Default,,0,0,0,,Дәмді
Dialogue: 0,0:11:56.34,0:11:58.42,Default,,0,0,0,,Мен тамақ ішкенді ұнатамын деп ойлаймын.
Dialogue: 0,0:11:58.92,0:12:00.84,Default,,0,0,0,,Әке, көкөністерді қосыңыз.
Dialogue: 0,0:12:00.92,0:12:02.30,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:12:07.85,0:12:08.64,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:12:08.72,0:12:10.72,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:12:10.81,0:12:12.60,Default,,0,0,0,,Ет жеуден қорықпа.
Dialogue: 0,0:12:13.35,0:12:15.69,Default,,0,0,0,,Сіз оны өз үйіңіз деп есептейсіз деп үміттенемін.
Dialogue: 0,0:12:16.19,0:12:19.61,Default,,0,0,0,,Бұл сіздің жеке үйіңіз болғандықтан, сіз тұтынушы ретінде әрекет ете алмайсыз.
Dialogue: 0,0:12:19.69,0:12:20.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:21.49,0:12:23.20,Default,,0,0,0,,Бұл қатты.
Dialogue: 0,0:12:23.28,0:12:26.95,Default,,0,0,0,,Кешіріңіз, мен ұстандым деп ойлаймын.
Dialogue: 0,0:12:27.45,0:12:29.12,Default,,0,0,0,,А... жоқ
Dialogue: 0,0:12:29.74,0:12:32.37,Default,,0,0,0,,Мен де жұмысыма байланысты үйден алыста болдым.
Dialogue: 0,0:12:32.46,0:12:34.87,Default,,0,0,0,,Көп байланыс болмады.
Dialogue: 0,0:12:34.96,0:12:36.83,Default,,0,0,0,,Сізде қиындықтар болды ма?
Dialogue: 0,0:12:37.33,0:12:40.25,Default,,0,0,0,,Анаңыздың диеталық тауарлары шкафтан орын алып жатыр.
Dialogue: 0,0:12:40.34,0:12:43.55,Default,,0,0,0,,Атам ұсынатын тәттілердің дәмі белгісіз.
Dialogue: 0,0:12:44.05,0:12:45.38,Default,,0,0,0,,Атап айтқанда...
Dialogue: 0,0:12:45.47,0:12:47.09,Default,,0,0,0,,ал қылышың қазірдің өзінде сынық түскен.
Dialogue: 0,0:12:47.93,0:12:49.01,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:12:49.10,0:12:51.39,Default,,0,0,0,,Маған қамқор болмасаң, жарайды.
Dialogue: 0,0:12:51.47,0:12:53.93,Default,,0,0,0,,Ал, олай емес.
Dialogue: 0,0:12:54.44,0:12:57.48,Default,,0,0,0,,Себебі мен біреудің асыл қызына жауаптымын.
Dialogue: 0,0:12:58.94,0:13:01.94,Default,,0,0,0,,Мен сізге қолайсыздықсыз өмір сүруге міндеттімін.
Dialogue: 0,0:13:04.49,0:13:06.45,Default,,0,0,0,,Қандай керемет көрініс
Dialogue: 0,0:13:06.53,0:13:10.66,Default,,0,0,0,,Алғашында оған қамқорлық жасаудан тартындым.
Dialogue: 0,0:13:11.20,0:13:14.66,Default,,0,0,0,,Бірақ талқылау барысында Юкико
Dialogue: 0,0:13:15.87,0:13:18.17,Default,,0,0,0,,Жауапкершілік болса, мен оны өзіңізбен бірге алып кетемін.
Dialogue: 0,0:13:18.75,0:13:21.88,Default,,0,0,0,,Бұл екі жыл Чинацу-чан үшін өте маңызды.
Dialogue: 0,0:13:21.96,0:13:25.38,Default,,0,0,0,,Екі жыл, оның салмағы қазіргіден басқа.
Dialogue: 0,0:13:25.47,0:13:28.39,Default,,0,0,0,,Сол уақытты қорғаудың жолы болса
Dialogue: 0,0:13:28.47,0:13:31.51,Default,,0,0,0,,Көмек беру ересек адамның міндеті, солай ма?
Dialogue: 0,0:13:32.26,0:13:33.43,Default,,0,0,0,,Жарайды, екеу болсын.
Dialogue: 0,0:13:34.14,0:13:38.06,Default,,0,0,0,,Біріншіден, Юкико бұл үй туралы шешім қабылдауға құқылы.
Dialogue: 0,0:13:38.56,0:13:40.19,Default,,0,0,0,,Кейде мен мұңаямын...
Dialogue: 0,0:13:41.69,0:13:44.78,Default,,0,0,0,,Бірақ мен мұны естігенде қатты риза болдым.
Dialogue: 0,0:13:44.86,0:13:46.70,Default,,0,0,0,,Егер адам қаласа
Dialogue: 0,0:13:46.78,0:13:49.28,Default,,0,0,0,,Мен сені қолдауым керек деп ойладым.
Dialogue: 0,0:13:50.53,0:13:53.70,Default,,0,0,0,,Осылайша Чинацу-чан шын мәнінде Inter-High-ге қатысуға шешім қабылдады.
Dialogue: 0,0:13:53.79,0:13:55.79,Default,,0,0,0,,Мен өзімді мақтаныш сезіндім.
Dialogue: 0,0:13:57.25,0:13:59.58,Default,,0,0,0,,Интер-Хайда жеңіске жетуді жалғастырайық.
Dialogue: 0,0:14:03.75,0:14:04.51,Default,,0,0,0,,Иә
Dialogue: 0,0:14:05.01,0:14:05.71,Default,,0,0,0,,Әке.
Dialogue: 0,0:14:06.63,0:14:08.72,Default,,0,0,0,,Анам якисоба кеспесін айтты.
Dialogue: 0,0:14:08.80,0:14:09.97,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:14:10.80,0:14:12.72,Default,,0,0,0,,Сіз не туралы айттыңыз?
Dialogue: 0,0:14:13.22,0:14:14.47,Default,,0,0,0,,Иә? Жоқ
Dialogue: 0,0:14:14.56,0:14:17.48,Default,,0,0,0,,Уа! Не істеуім керек?
Dialogue: 0,0:14:17.56,0:14:20.02,Default,,0,0,0,,Сатып алу сіздің әкеңіздің міндеті, солай ма?
Dialogue: 0,0:14:20.10,0:14:21.94,Default,,0,0,0,,Мен оны сатып алдым деп ойладым.
Dialogue: 0,0:14:22.02,0:14:25.15,Default,,0,0,0,,Анам біліп қалса, маған бір ай қоңыр күріш жасайды.
Dialogue: 0,0:14:25.65,0:14:27.49,Default,,0,0,0,,Мен оны сатып аламын.
Dialogue: 0,0:14:28.07,0:14:29.78,Default,,0,0,0,,Менде сатып алғым келетін нәрсе болды.
Dialogue: 0,0:14:29.86,0:14:33.53,Default,,0,0,0,,Иә, онда мен сенен бір жақсылық сұраймын.
Dialogue: 0,0:14:33.62,0:14:34.24,Default,,0,0,0,,Иә
Dialogue: 0,0:14:34.33,0:14:36.12,Default,,0,0,0,,Біз достасамыз
Dialogue: 0,0:14:36.62,0:14:38.79,Default,,0,0,0,,Сонда Дайки сізге еру керек.
Dialogue: 0,0:14:38.87,0:14:39.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:39.83,0:14:44.67,Default,,0,0,0,,Қарашы, түнде қызды жалғыз қыдыруға болмайды.
Dialogue: 0,0:14:44.75,0:14:46.51,Default,,0,0,0,,Мен мұны түсінемін, бірақ...
Dialogue: 0,0:14:47.42,0:14:52.01,Default,,0,0,0,,Бірақ мен қандай қашықтыққа бару керектігін білмеймін.
Dialogue: 0,0:14:54.26,0:14:56.68,Default,,0,0,0,,Ондай жағдайда мен жалғыз барамын.
Dialogue: 0,0:14:57.18,0:14:59.64,Default,,0,0,0,,Мәселе бұл емес.
Dialogue: 0,0:15:00.23,0:15:01.02,Default,,0,0,0,,Дайки-кун
Dialogue: 0,0:15:01.60,0:15:02.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:05.27,0:15:06.36,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:15:07.11,0:15:10.03,Default,,0,0,0,,О? Дайки мен Чинацу ше?
Dialogue: 0,0:15:10.11,0:15:11.36,Default,,0,0,0,,Мен дүкен аралауға шықтым.
Dialogue: 0,0:15:11.45,0:15:13.03,Default,,0,0,0,,Неге әуре?
Dialogue: 0,0:15:13.82,0:15:16.62,Default,,0,0,0,,Чинацу екеуміздің бірге сөйлесетініміз сирек.
Dialogue: 0,0:15:17.12,0:15:20.83,Default,,0,0,0,,Дайкиден бір жас үлкен болса да, оның ересек адам екеніне таң қалдым.
Dialogue: 0,0:15:21.33,0:15:23.04,Default,,0,0,0,,Өйткені Чинацу-чан байыпты
Dialogue: 0,0:15:23.75,0:15:25.59,Default,,0,0,0,,Yes, that's right.
Dialogue: 0,0:15:26.09,0:15:28.13,Default,,0,0,0,,Сәл тым байсалды
Dialogue: 0,0:15:31.63,0:15:33.55,Default,,0,0,0,,Бірдеңе сатып алуды ұмытпаңыз?
Dialogue: 0,0:15:34.05,0:15:35.55,Default,,0,0,0,,Менің ойымша, бұл дұрыс.
Dialogue: 0,0:15:35.64,0:15:37.93,Default,,0,0,0,,Соңында, бұрылыс нүктесі!
Dialogue: 0,0:15:38.56,0:15:39.56,Default,,0,0,0,,Үйге қайтайық?
Dialogue: 0,0:15:40.27,0:15:41.14,Default,,0,0,0,,Қандай да бір жолмен жүру
Dialogue: 0,0:15:41.23,0:15:44.10,Default,,0,0,0,,Кездейсоқ әңгімелесу арқылы өттім.
Dialogue: 0,0:15:44.19,0:15:46.57,Default,,0,0,0,,Шынымды айтсам, бұл қазірдің өзінде қызу тақырып...
Dialogue: 0,0:15:47.15,0:15:51.15,Default,,0,0,0,,Қолыңнан ұстап алғаным үшін тағы да кешірім сұраймын, бірақ...
Dialogue: 0,0:15:51.24,0:15:52.36,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:15:53.32,0:15:55.74,Default,,0,0,0,,Қазір балмұздақ жеу жақсы емес пе?
Dialogue: 0,0:15:55.82,0:15:57.20,Default,,0,0,0,,Балмұздақ?
Dialogue: 0,0:15:57.28,0:16:00.25,Default,,0,0,0,,Мен оны жегім келеді, бірақ якисоба туралы ойласам...
Dialogue: 0,0:16:00.33,0:16:02.79,Default,,0,0,0,,Сіз бұл туралы ойладыңыз ба?
Dialogue: 0,0:16:02.87,0:16:06.59,Default,,0,0,0,,Барлығына балмұздақ бар, сондықтан оны бірге жеген дұрыс.
Dialogue: 0,0:16:07.34,0:16:08.59,Default,,0,0,0,,Хехе
Dialogue: 0,0:16:09.34,0:16:13.68,Default,,0,0,0,,Чинацу-сенпай кейде осындай балалық нәрселер туралы ойлайды.
Dialogue: 0,0:16:14.84,0:16:15.68,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:16:17.64,0:16:19.43,Default,,0,0,0,,Үйде барбекю болған кезде
Dialogue: 0,0:16:19.52,0:16:22.10,Default,,0,0,0,,Ереже - қалағаныңды жеу.
Dialogue: 0,0:16:23.35,0:16:24.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:25.69,0:16:27.31,Default,,0,0,0,,Керемет ережелер
Dialogue: 0,0:16:29.86,0:16:32.70,Default,,0,0,0,,Бұл менің анамның саясаты. Мен де жеуім керек.
Dialogue: 0,0:16:34.07,0:16:36.20,Default,,0,0,0,,Дайки-кун сіздің анаңызға ұқсайды.
Dialogue: 0,0:16:36.28,0:16:37.32,Default,,0,0,0,,Не!
Dialogue: 0,0:16:37.41,0:16:39.74,Default,,0,0,0,,Осындай жиіркенішті бет жасамасаң да
Dialogue: 0,0:16:39.83,0:16:42.41,Default,,0,0,0,,Жарайды, мені анама ұқсайды дейді.
Dialogue: 0,0:16:42.50,0:16:44.04,Default,,0,0,0,,Әйтеуір маған ұнамайды.
Dialogue: 0,0:16:44.12,0:16:47.92,Default,,0,0,0,,Иә? Жарқын, күшті және түзу жер.
Dialogue: 0,0:16:48.00,0:16:49.88,Default,,0,0,0,,Менің ойымша, бұл ұқсас.
Dialogue: 0,0:16:52.97,0:16:55.63,Default,,0,0,0,,Чинацу-сенпай әкесіне ұқсайды, солай емес пе?
Dialogue: 0,0:16:57.39,0:16:59.22,Default,,0,0,0,,Анам қатты қуанды
Dialogue: 0,0:16:59.72,0:17:02.14,Default,,0,0,0,,Хмм, сіз қалай ойлайсыз?
Dialogue: 0,0:17:02.22,0:17:05.64,Default,,0,0,0,,Әке, сіз оның не ойлағанын білмейсіз.
Dialogue: 0,0:17:05.73,0:17:07.69,Default,,0,0,0,,Сіз әкеңізге ұқсайсыз.
Dialogue: 0,0:17:08.19,0:17:11.65,Default,,0,0,0,,Мен Дайки-куннан оның үйінде қарағым келетінін сұрағанымда да.
Dialogue: 0,0:17:13.07,0:17:15.99,Default,,0,0,0,,Мен міндетті түрде қарсы боламын деп ойладым, бірақ айттым.
Dialogue: 0,0:17:16.99,0:17:19.49,Default,,0,0,0,,Мен тек «көремін» дедім.
Dialogue: 0,0:17:19.99,0:17:23.54,Default,,0,0,0,,Меніңше, анам менімен алдын ала сөйлескен.
Dialogue: 0,0:17:23.62,0:17:25.91,Default,,0,0,0,,Өйткені ештеңе айтылмады
Dialogue: 0,0:17:26.62,0:17:28.83,Default,,0,0,0,,Бұл сіздің шешіміңіз, сондықтан оны жақсы орындаңыз.\NМен оны
Dialogue: 0,0:17:28.92,0:17:31.21,Default,,0,0,0,,деп түсіндірдім.
Dialogue: 0,0:17:32.25,0:17:34.05,Default,,0,0,0,,Сіз сөйлей алмайсыз.
Dialogue: 0,0:17:40.10,0:17:41.72,Default,,0,0,0,,♬ Бос соңғы бетте
Dialogue: 0,0:17:47.10,0:17:48.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:49.10,0:17:50.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:53.28,0:17:55.19,Default,,0,0,0,,Аа, кешіріңіз!
Dialogue: 0,0:17:55.28,0:17:58.20,Default,,0,0,0,,Бұл жаман. Мен оны тағы да абайсызда ұстадым.
Dialogue: 0,0:18:00.32,0:18:03.24,Default,,0,0,0,,Мен жол жиегімен жүруім керек.
Dialogue: 0,0:18:03.33,0:18:04.20,Default,,0,0,0,,Дайки-кун
Dialogue: 0,0:18:04.95,0:18:07.12,Default,,0,0,0,,Біраз бұрын болды.
Dialogue: 0,0:18:08.04,0:18:09.21,Default,,0,0,0,,Өткен күні...
Dialogue: 0,0:18:10.04,0:18:12.29,Default,,0,0,0,,Оки-кунның қызуы көтерілген күні
Dialogue: 0,0:18:13.63,0:18:14.84,Default,,0,0,0,,Ұмытайық
Dialogue: 0,0:18:21.76,0:18:26.18,Default,,0,0,0,,Мен де ұлмен тұру туралы.
Dialogue: 0,0:18:26.27,0:18:27.85,Default,,0,0,0,,Жеткілікті түрде ескерілмеді
Dialogue: 0,0:18:28.77,0:18:32.40,Default,,0,0,0,,Осы жерде тұрып жатқан адам ретінде мен мұны жақсы емес деп ойлаймын.
Dialogue: 0,0:18:37.44,0:18:40.61,Default,,0,0,0,,Мұндай жағдай қайталанбауы үшін
Dialogue: 0,0:18:40.70,0:18:41.95,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:18:44.54,0:18:45.66,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:18:56.09,0:18:56.71,Default,,0,0,0,,Е...
Dialogue: 0,0:18:58.38,0:19:02.01,Default,,0,0,0,,Енді сипатталған
Dialogue: 0,0:19:03.72,0:19:05.72,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:19:06.72,0:19:10.23,Default,,0,0,0,,Оның үстіне сен менің сезімдерімді сезіп тұрған сияқтысың.
Dialogue: 0,0:19:11.69,0:19:13.65,Default,,0,0,0,,Zurii
Dialogue: 0,0:19:14.86,0:19:17.99,Default,,0,0,0,,Маған алыстағы нысанаға қарай алатыныңызды айтыңыз
Dialogue: 0,0:19:18.53,0:19:20.99,Default,,0,0,0,,Мен ол жерде қашықтықты сақтаймын.
Dialogue: 0,0:19:26.24,0:19:31.67,Default,,0,0,0,,Жазғы демалыс ертең басталады, бірақ оны тым байыппен қабылдамаңыз.
Dialogue: 0,0:19:32.25,0:19:34.21,Default,,0,0,0,,Қалыпты әрекет ету
Dialogue: 0,0:19:34.29,0:19:35.17,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:19:35.25,0:19:36.38,Default,,0,0,0,,Мен түсіндім~
Dialogue: 0,0:19:36.46,0:19:37.92,Default,,0,0,0,,Қош болыңыз, ұстаз
Dialogue: 0,0:19:38.01,0:19:39.38,Default,,0,0,0,,А, міне!
Dialogue: 0,0:19:42.26,0:19:45.85,Default,,0,0,0,,Жазғы демалыс болса да, көңіл-күй өте төмен.
Dialogue: 0,0:19:45.93,0:19:46.81,Default,,0,0,0,,Мен берілмеймін. Бір адамның да өлуіне жол бермеймін
Dialogue: 0,0:19:46.89,0:19:49.18,Default,,0,0,0,,Үй тапсырмасын жек көресің, түсіндім.
Dialogue: 0,0:19:49.27,0:19:50.18,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:19:50.27,0:19:53.31,Default,,0,0,0,,Сонымен, үй тапсырмасын жау деп ойлайсың ба?
Dialogue: 0,0:19:53.40,0:19:55.31,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:19:55.40,0:19:56.65,Default,,0,0,0,,Сайо
Dialogue: 0,0:19:57.15,0:19:58.44,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:19:59.11,0:20:00.82,Default,,0,0,0,,Үйірме жұмыстарынан кейінгі сенбі
Dialogue: 0,0:20:00.90,0:20:03.49,Default,,0,0,0,,Бәріміз кітапханаға қамалып, бірге орындайық.
Dialogue: 0,0:20:03.57,0:20:05.45,Default,,0,0,0,,Хухун тамаша идея~
Dialogue: 0,0:20:05.53,0:20:08.24,Default,,0,0,0,,Жауапты көшіруді жоспарлап отырсыз ба...
Dialogue: 0,0:20:08.33,0:20:10.16,Default,,0,0,0,,Ум...
Dialogue: 0,0:20:10.25,0:20:10.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:11.75,0:20:13.96,Default,,0,0,0,,Мұны бізге де араластыра аласыз ба?
Dialogue: 0,0:20:14.46,0:20:15.21,Default,,0,0,0,,Мен де!
Dialogue: 0,0:20:15.83,0:20:17.46,Default,,0,0,0,,Жарайды, бәріміз орындайық!
Dialogue: 0,0:20:18.21,0:20:19.05,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:19.80,0:20:22.47,Default,,0,0,0,,Эххе, жақсы, жақсы
Dialogue: 0,0:20:24.76,0:20:27.47,Default,,0,0,0,,Енді үй тапсырмасын уайымдаудың қажеті жоқ.
Dialogue: 0,0:20:27.55,0:20:29.18,Default,,0,0,0,,Мен мұны әлі жасаған жоқпын.
Dialogue: 0,0:20:29.68,0:20:33.85,Default,,0,0,0,,Мен жазғы демалысты асыға күтіп жүрмін, не істегім келетіні өте көп!
Dialogue: 0,0:20:33.94,0:20:36.19,Default,,0,0,0,,Сіз орта мектеппен айналысуыңыз керек.
Dialogue: 0,0:20:36.27,0:20:38.19,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:20:38.27,0:20:41.03,Default,,0,0,0,,Буд клубында күн сайын дерлік клубтық іс-шаралар бар, солай емес пе?
Dialogue: 0,0:20:41.11,0:20:41.74,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:20:42.32,0:20:43.57,Default,,0,0,0,,Тек осы екі қарапайым белгіні есте сақта.
Dialogue: 0,0:20:46.24,0:20:48.45,Default,,0,0,0,,Ах Чинацу-сенпай
Dialogue: 0,0:20:50.58,0:20:51.50,Default,,0,0,0,,Байқалған
Dialogue: 0,0:20:56.33,0:20:58.04,Default,,0,0,0,,-（） -（）
Dialogue: 0,0:20:59.34,0:21:00.71,Default,,0,0,0,,Не жасырып тұрсың?
Dialogue: 0,0:21:00.80,0:21:01.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:01.84,0:21:05.72,Default,,0,0,0,,Бұл жасырын емес, өйткені ығысу өзегі түсіп кетті.
Dialogue: 0,0:21:05.80,0:21:07.80,Default,,0,0,0,,Сіз алдауға нашарсыз ба?
Dialogue: 0,0:21:08.80,0:21:10.26,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:21:11.35,0:21:13.89,Default,,0,0,0,,Мен кеше отбасыммен барбекю жасадым.
Dialogue: 0,0:21:13.98,0:21:15.98,Default,,0,0,0,,Барлығы жақсы араласады.
Dialogue: 0,0:21:16.52,0:21:17.52,Default,,0,0,0,,Тек...
Dialogue: 0,0:21:18.48,0:21:22.78,Default,,0,0,0,,Маған жақындағаныңыз жақсы емес сияқты.
Dialogue: 0,0:21:23.86,0:21:25.57,Default,,0,0,0,,Егер солай десеңіз
Dialogue: 0,0:21:25.65,0:21:27.86,Default,,0,0,0,,Мен не істерімді білмеймін
Dialogue: 0,0:21:34.41,0:21:36.83,Default,,0,0,0,,Кәне, үйірме жұмыстарына барайық.
Dialogue: 0,0:22:06.49,0:22:08.49,Default,,0,0,0,,♪~
Dialogue: 0,0:23:33.57,0:23:35.58,Default,,0,0,0,,~♪
Dialogue: 0,0:23:37.08,0:23:43.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory