Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.13,0:00:09.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:12.30,0:00:14.84,Default,,0,0,0,,Сәлеметсіз бе, жас ханым, иә?
Dialogue: 0,0:00:14.84,0:00:17.30,Default,,0,0,0,,Сіз дәмді нәрсе жеп жатырсыз.
Dialogue: 0,0:00:17.30,0:00:20.68,Default,,0,0,0,,Мен бұрын көрмеген тағамдарға қызығамын.
Dialogue: 0,0:00:20.68,0:00:22.85,Default,,0,0,0,,Тістеп жібере аласыз ба?
Dialogue: 0,0:00:22.85,0:00:24.85,Default,,0,0,0,,Әрине!
Dialogue: 0,0:00:24.85,0:00:29.15,Default,,0,0,0,,Алға, қалағаныңды ал.
Dialogue: 0,0:00:30.15,0:00:33.03,Default,,0,0,0,,Енді мынаны алайық.
Dialogue: 0,0:00:35.70,0:00:41.04,Default,,0,0,0,,Бұл дәмді! Тұздың тамаша мөлшері дәмдеуіш реңктерін қалдырады.
Dialogue: 0,0:00:41.04,0:00:43.16,Default,,0,0,0,,Қалағаныңызша бара аласыз!
Dialogue: 0,0:00:43.16,0:00:46.33,Default,,0,0,0,,Бірақ бұл еттің дәмі керемет.
Dialogue: 0,0:00:46.33,0:00:48.71,Default,,0,0,0,,Бұл қандай ет?
Dialogue: 0,0:00:48.71,0:00:51.05,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:00:53.72,0:00:56.05,Default,,0,0,0,,Бұрғақ еті
Dialogue: 0,0:00:57.05,0:00:59.72,Default,,0,0,0,,Букхорн дегеніміз не?
Dialogue: 0,0:00:59.72,0:01:02.73,Default,,0,0,0,,Әлгі жын жануар?
Dialogue: 0,0:01:02.73,0:01:04.73,Default,,0,0,0,,Иә
Dialogue: 0,0:01:05.73,0:01:09.57,Default,,0,0,0,,Ой... О...
Dialogue: 0,0:01:09.57,0:01:12.74,Default,,0,0,0,,Мен қорқынышты нәрсе жедім.
Dialogue: 0,0:01:12.74,0:01:17.20,Default,,0,0,0,,Қарақұйрық туралы айтатын болсақ, ол күшті уы бар деп айтылатын сиқырлы аң емес пе?
Dialogue: 0,0:01:17.20,0:01:21.37,Default,,0,0,0,,Менің нағашы әпкемнің қызы неге олай жасайды...
Dialogue: 0,0:01:21.37,0:01:25.21,Default,,0,0,0,,Мүмкін ол туралы қауесет шығар...
Dialogue: 0,0:01:25.21,0:01:29.59,Default,,0,0,0,,Сенің бақытты болғаныңа қуаныштымын.
Dialogue: 0,0:01:30.59,0:01:32.92,Default,,0,0,0,,Хехе…
Dialogue: 0,0:01:35.09,0:01:37.59,Default,,0,0,0,,<Ол жеткілікті түрде дайындалғанша>
Dialogue: 0,0:01:37.59,0:01:41.22,Default,,0,0,0,,<Кез келген құбыжық дәмді болады>
Dialogue: 0,0:01:44.39,0:01:47.77,Default,,0,0,0,,<Мені енді ешкім түсінбейді>
Dialogue: 0,0:01:48.77,0:01:51.23,Default,,0,0,0,,<Бір күні, мен сенімдімін...>
Dialogue: 0,0:01:54.11,0:01:56.11,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:33.88,0:03:35.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:35.88,0:03:39.34,Default,,0,0,0,,Хмм, эй!
Dialogue: 0,0:03:42.34,0:03:45.51,Default,,0,0,0,,<Күтілгендей, Мәртебелі Король ұйымдастырған банкет>
Dialogue: 0,0:03:45.51,0:03:48.22,Default,,0,0,0,,<Барлық ұсынылатын тағамдар талғампаз>
Dialogue: 0,0:03:48.22,0:03:51.06,Default,,0,0,0,,<Ол талғампаз көрінеді және дәмі>
Dialogue: 0,0:03:51.06,0:03:54.73,Default,,0,0,0,,Келесі қайсысын алайын, жас ханым?
Dialogue: 0,0:03:56.23,0:03:58.23,Default,,0,0,0,,Талбот ханым!
Dialogue: 0,0:03:58.23,0:04:02.24,Default,,0,0,0,,Сіз мұнда не үшін келдіңіз, жас ханым?
Dialogue: 0,0:04:02.24,0:04:04.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:04.37,0:04:07.74,Default,,0,0,0,,<Иә, ашық күзгі аспан астында>
Dialogue: 0,0:04:07.74,0:04:12.54,Default,,0,0,0,,<Күзгі егін жинау науқанын тойлау үшін Лангдиас Корольдігі ұйымдастырған банкет>
Dialogue: 0,0:04:12.54,0:04:14.92,Default,,0,0,0,,<Дворяндарды анықтау>
Dialogue: 0,0:04:14.92,0:04:19.09,Default,,0,0,0,,<Басқаша айтқанда, бұл кездесулер іздейтін орын>
Dialogue: 0,0:04:19.09,0:04:23.55,Default,,0,0,0,,<Мен де, граф Маршалл Ридтің қызы Мельфиерамын>
Dialogue: 0,0:04:23.55,0:04:25.55,Default,,0,0,0,,<Олардың бірі>
Dialogue: 0,0:04:25.55,0:04:28.76,Default,,0,0,0,,<Мен мұнда жұбай іздеуге келдім>
Dialogue: 0,0:04:28.76,0:04:31.77,Default,,0,0,0,,Күрсін... <Негізі бұл>
Dialogue: 0,0:04:31.77,0:04:34.56,Default,,0,0,0,,<Менің достарым жоқ, сондықтан маған ұнамайды.>
Dialogue: 0,0:04:34.56,0:04:36.56,Default,,0,0,0,,<Менің енемнен...>
Dialogue: 0,0:04:36.56,0:04:39.78,Default,,0,0,0,,《Егер тағы бір жыл ішінде күйеу жігіт таппасам》
Dialogue: 0,0:04:39.78,0:04:42.78,Default,,0,0,0,,《Мен сенің монастырға барғаныңды қалаймын! 》
Dialogue: 0,0:04:42.78,0:04:45.28,Default,,0,0,0,,<Әкеңнен де...>
Dialogue: 0,0:04:45.28,0:04:47.28,Default,,0,0,0,,《Тыңда, Мелфи》
Dialogue: 0,0:04:47.28,0:04:50.41,Default,,0,0,0,,《Бұл жерде қарапайым рыцарь жақсы болады》
Dialogue: 0,0:04:50.41,0:04:54.58,Default,,0,0,0,,《Егер ол әдепті адам болса, мен оны қабылдаймын》
Dialogue: 0,0:04:54.58,0:04:58.13,Default,,0,0,0,,<Егер сен айтсаң мен қатысар едім.>
Dialogue: 0,0:04:59.42,0:05:02.30,Default,,0,0,0,,(Дворяндар сыбырлайды)
Dialogue: 0,0:05:02.30,0:05:05.80,Default,,0,0,0,,Бұл қауесет пе? Жақындау қиын
Dialogue: 0,0:05:05.80,0:05:08.97,Default,,0,0,0,,Менің жүзім әдемі, бірақ бұл босқа
Dialogue: 0,0:05:09.97,0:05:13.60,Default,,0,0,0,,<Кешіріңіз, әке>
Dialogue: 0,0:05:13.60,0:05:18.15,Default,,0,0,0,,<Мені барлық асылдар аулақ ұстайды>
Dialogue: 0,0:05:24.82,0:05:29.49,Default,,0,0,0,,<Сыртқа шыққанда дворяндардан рыцарлар көп.>
Dialogue: 0,0:05:29.49,0:05:32.49,Default,,0,0,0,,<Мүмкін мен осы жерден серіктес іздеу керек шығар>
Dialogue: 0,0:05:32.49,0:05:34.83,Default,,0,0,0,,<Мені танымайтын адамдар...>
Dialogue: 0,0:05:34.83,0:05:39.13,Default,,0,0,0,,Кя~! Құбыжық! Құбыжық пайда болды!
Dialogue: 0,0:05:45.67,0:05:47.84,Default,,0,0,0,,Жолдан кет! Уф...
Dialogue: 0,0:05:48.84,0:05:50.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:52.35,0:05:54.98,Default,,0,0,0,,Амансың ба!? Иә.
Dialogue: 0,0:05:54.98,0:05:58.52,Default,,0,0,0,,Таяғым сынып, енді жүре алмаймын.
Dialogue: 0,0:05:58.52,0:06:00.52,Default,,0,0,0,,Менімен бірге қаш
Dialogue: 0,0:06:00.52,0:06:03.86,Default,,0,0,0,,Жарайды, қандай мейірімді жас ханым.
Dialogue: 0,0:06:03.86,0:06:05.99,Default,,0,0,0,,Рахмет... Ха!
Dialogue: 0,0:06:05.99,0:06:08.16,Default,,0,0,0,,(Аңның ырылдауы)
Dialogue: 0,0:06:10.99,0:06:14.16,Default,,0,0,0,,Сіз екеуіңіз бұрынғы достар едіңіздер деп естідім…
Dialogue: 0,0:06:14.16,0:06:18.37,Default,,0,0,0,,<Бухорн есінен танып қалды!? Неге сонша жалғыз жерде!? ＞
Dialogue: 0,0:06:18.37,0:06:21.17,Default,,0,0,0,,<Мен қашуым керек! Бірақ...＞
Dialogue: 0,0:06:24.71,0:06:27.88,Default,,0,0,0,,Эй, мені көзде!
Dialogue: 0,0:06:29.18,0:06:31.18,Default,,0,0,0,,<Жоқ, мен>
Dialogue: 0,0:06:31.18,0:06:33.89,Default,,0,0,0,,＜Мен серіктес таба алмадым, бұл менің басымнан өтті＞
Dialogue: 0,0:06:33.89,0:06:35.89,Default,,0,0,0,,Сіз екеуіңіз бұрынғы достар едіңіздер деп естідім…
Dialogue: 0,0:06:35.89,0:06:38.89,Default,,0,0,0,,<Осындай жерде...>
Dialogue: 0,0:06:46.90,0:06:48.90,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:52.20,0:06:55.04,Default,,0,0,0,,＜Тек бір сәттік оқиға...＞
Dialogue: 0,0:07:11.93,0:07:13.93,Default,,0,0,0,,(Дворяндар сыбырлайды)
Dialogue: 0,0:07:13.93,0:07:17.43,Default,,0,0,0,,Әй, қара! Бұл Ақылсыз қанды герцог.
Dialogue: 0,0:07:17.43,0:07:21.23,Default,,0,0,0,,Сол құбыжық бір соққыда? Қандай қорқынышты
Dialogue: 0,0:07:23.44,0:07:27.61,Default,,0,0,0,,Ақылсыз қанды герцог?
Dialogue: 0,0:07:27.61,0:07:29.78,Default,,0,0,0,,Не?
Dialogue: 0,0:07:29.78,0:07:32.07,Default,,0,0,0,,Менен қорқасың ба?
Dialogue: 0,0:07:33.24,0:07:35.24,Default,,0,0,0,,<Қорқасың ба? ＞
Dialogue: 0,0:07:36.24,0:07:38.25,Default,,0,0,0,,(тұз)
Dialogue: 0,0:07:38.25,0:07:43.79,Default,,0,0,0,,<Ол үнемі қанның иісін аңдып, жын-шайтан аңдарын өлтіретін эксцентрик деген қауесет бар>
Dialogue: 0,0:07:43.79,0:07:46.63,Default,,0,0,0,,<Қатыгез және қатыгез жынды қанды герцог>
Dialogue: 0,0:07:47.80,0:07:49.80,Default,,0,0,0,,<Бірақ...>
Dialogue: 0,0:07:50.97,0:07:53.97,Default,,0,0,0,,<Қандай әдемі адам...>
Dialogue: 0,0:07:53.97,0:07:56.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:56.47,0:08:01.81,Default,,0,0,0,,Құрметті герцог Гэлбрейт, сіздің жақсы жұмыс істеп жатқаныңызға қуаныштымын.
Dialogue: 0,0:08:01.81,0:08:05.27,Default,,0,0,0,,Жағдайды түсінбедіңіз бе?
Dialogue: 0,0:08:05.27,0:08:09.48,Default,,0,0,0,,Сіз жарақат алдыңыз ба? Иә, жарайды
Dialogue: 0,0:08:09.48,0:08:11.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:13.82,0:08:17.49,Default,,0,0,0,,Әй, әлгі герцог! Не?
Dialogue: 0,0:08:17.49,0:08:20.50,Default,,0,0,0,,Аузыңызды шайып жібере аласыз ба?
Dialogue: 0,0:08:20.50,0:08:22.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:22.50,0:08:25.29,Default,,0,0,0,,Жарайды...Бакхорнның есінен тануға бейімі бар.
Dialogue: 0,0:08:25.29,0:08:28.50,Default,,0,0,0,,Қанның жын-шайтанның уымен толық жұқтыру мүмкіндігі бар.
Dialogue: 0,0:08:28.50,0:08:31.01,Default,,0,0,0,,Тірі қан балғын, бірақ жынның уын жұтқанда
Dialogue: 0,0:08:31.01,0:08:34.30,Default,,0,0,0,,Дене қызуы көтеріліп, ішім қатты ауырады.
Dialogue: 0,0:08:34.30,0:08:38.14,Default,,0,0,0,,Егер ол жындыға айналмаса, қанға батып кетуі мүмкін еді.
Dialogue: 0,0:08:38.14,0:08:42.14,Default,,0,0,0,,Жоқ, бірақ дайындық жасасаңыз...
Dialogue: 0,0:08:42.14,0:08:46.02,Default,,0,0,0,,Оның үстіне герцогтың өзі қанға боялған.
Dialogue: 0,0:08:46.02,0:08:49.69,Default,,0,0,0,,Қызық, жын уы бар қан тері арқылы сіңеді ме?
Dialogue: 0,0:08:49.69,0:08:51.69,Default,,0,0,0,,Олай болса, тез арада киіміңізді ауыстырыңыз...
Dialogue: 0,0:08:51.69,0:08:53.70,Default,,0,0,0,,Сіз...
Dialogue: 0,0:08:53.70,0:08:58.03,Default,,0,0,0,,Сіз жын-шайтан аңдар туралы көп білесіз, иә?
Dialogue: 0,0:08:58.03,0:09:00.70,Default,,0,0,0,,<Сен көп сөйлейсің, Мельфиера! ＞
Dialogue: 0,0:09:00.70,0:09:04.87,Default,,0,0,0,,А... Қымбат уақытыңызды алғаным үшін кешіріңіз...
Dialogue: 0,0:09:04.87,0:09:08.04,Default,,0,0,0,,Ішіңіз, бұл тазартылған су. иә?
Dialogue: 0,0:09:08.04,0:09:10.17,Default,,0,0,0,,Жынның уы қиын емес пе?
Dialogue: 0,0:09:10.17,0:09:13.55,Default,,0,0,0,,Сіз оны ішпейтін шығарсыз, бірақ оны да ішу керек.
Dialogue: 0,0:09:14.55,0:09:19.05,Default,,0,0,0,,Ах... Рахмет, мм.
Dialogue: 0,0:09:22.35,0:09:26.19,Default,,0,0,0,,Мен бұл қанды күйде үйге бара алмаймын деп ойлаймын.
Dialogue: 0,0:09:27.35,0:09:30.36,Default,,0,0,0,,Менімен жүр, мен саған киім ауыстырып беремін.
Dialogue: 0,0:09:30.36,0:09:32.90,Default,,0,0,0,,А... Жоқ, солай!
Dialogue: 0,0:09:32.90,0:09:36.74,Default,,0,0,0,,Егер ол кір болса, суда біраз уақыт қалдырсаңыз, шығып кетеді.
Dialogue: 0,0:09:36.74,0:09:38.74,Default,,0,0,0,,Мәселе осы ма?
Dialogue: 0,0:09:38.74,0:09:42.58,Default,,0,0,0,,Бұл жын жыртқыштың қаны. Сіз оны жек көрмейсіз бе?
Dialogue: 0,0:09:42.58,0:09:45.37,Default,,0,0,0,,Әй, егер бәрі осы болса.
Dialogue: 0,0:09:45.37,0:09:48.92,Default,,0,0,0,,Бір апта бұрын бағалағанымнан еш айырмашылығы жоқ.
Dialogue: 0,0:09:48.92,0:09:51.21,Default,,0,0,0,,Маған бәрібір болды.
Dialogue: 0,0:09:51.21,0:09:53.21,Default,,0,0,0,,Жын-шайтанды соттау!?
Dialogue: 0,0:09:53.21,0:09:56.38,Default,,0,0,0,,А... жоқ, мм...
Dialogue: 0,0:09:57.38,0:09:59.93,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:09:59.93,0:10:02.60,Default,,0,0,0,,Мен... Қолайсыздық үшін кешірім сұраймын!
Dialogue: 0,0:10:02.60,0:10:07.39,Default,,0,0,0,,Мен граф Маршалл Ридтің қызы Мельфиерадамын.
Dialogue: 0,0:10:07.39,0:10:11.23,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:10:11.23,0:10:13.23,Default,,0,0,0,,Поо... Иә?
Dialogue: 0,0:10:13.23,0:10:17.78,Default,,0,0,0,,Фухахаха! Жоқ, мен кенеттен кешірім сұраймын.
Dialogue: 0,0:10:17.78,0:10:21.95,Default,,0,0,0,,Түсіндім, сенің жын-шайтан аңдар туралы көп білетінің таңқаларлық емес.
Dialogue: 0,0:10:21.95,0:10:26.12,Default,,0,0,0,,Иә? сіз қауесетсіз
Dialogue: 0,0:10:26.12,0:10:28.12,Default,,0,0,0,,Құбыжықтарды жеу
Dialogue: 0,0:10:29.42,0:10:31.42,Default,,0,0,0,,Жаман жегіштің қызы ма?
Dialogue: 0,0:10:33.30,0:10:37.47,Default,,0,0,0,,<Бұл әлемде сиқырлы күші бар құбыжықтар және біртүрлі өсімдіктер бар.>
Dialogue: 0,0:10:37.47,0:10:42.30,Default,,0,0,0,,<Құбыжықтар деп аталатын ерекше тіршілік иелері бар.>
Dialogue: 0,0:10:42.80,0:10:46.27,Default,,0,0,0,,<Оларды жегенде, олардың құрамындағы сиқырлы күштің арқасында>
Dialogue: 0,0:10:46.27,0:10:50.81,Default,,0,0,0,,<Себебі сізде құсу, іштің ауыруы және қызба сияқты белгілер болуы мүмкін>
Dialogue: 0,0:10:50.81,0:10:55.82,Default,,0,0,0,,<Бағындырылғаннан кейін ол негізінен тасталады>
Dialogue: 0,0:10:55.82,0:11:01.66,Default,,0,0,0,,<Дұрыс, мен жұрт айтып жүрген жаман жегіштердің қызымын>
Dialogue: 0,0:11:02.99,0:11:05.99,Default,,0,0,0,,<Оны қазір жасыру біртүрлі, солай емес пе?>
Dialogue: 0,0:11:05.99,0:11:10.67,Default,,0,0,0,,Мен құбыжықтардан гөрі тамаққа көбірек қызығамын.
Dialogue: 0,0:11:10.67,0:11:13.84,Default,,0,0,0,,Тамақ?
Dialogue: 0,0:11:13.84,0:11:18.30,Default,,0,0,0,,Қалай ойлайсыңдар, сиқырлы аң сізге тамақ сияқты көрінеді ме?
Dialogue: 0,0:11:19.84,0:11:22.47,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:11:22.47,0:11:24.68,Default,,0,0,0,,Тамақтың дәмді болуы үшін оны қалай дайындау керек, т.б.
Dialogue: 0,0:11:24.68,0:11:26.68,Default,,0,0,0,,Мен бұл туралы ойланбай тұра алмаймын!
Dialogue: 0,0:11:26.68,0:11:30.02,Default,,0,0,0,,Өйткені мен бірдеңені жесем, оның дәмді болғанын қалаймын.
Dialogue: 0,0:11:30.02,0:11:32.85,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:11:34.19,0:11:36.48,Default,,0,0,0,,<Мен мұны қайтадан жасадым! ＞
Dialogue: 0,0:11:37.48,0:11:39.86,Default,,0,0,0,,<Қазір>
Dialogue: 0,0:11:39.86,0:11:42.03,Default,,0,0,0,,<Күлейік>
Dialogue: 0,0:11:44.32,0:11:46.87,Default,,0,0,0,,<Күлу керісінше әсер етеді!?>
Dialogue: 0,0:11:46.87,0:11:48.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:48.87,0:11:53.21,Default,,0,0,0,,Мен туралы бірдеңе бар...
Dialogue: 0,0:11:53.21,0:11:55.21,Default,,0,0,0,,Уф... <Толығырақ!?>
Dialogue: 0,0:11:55.21,0:11:59.05,Default,,0,0,0,,Аузыңда қан болса ше!? Қазір су ішіңіз...
Dialogue: 0,0:11:59.05,0:12:01.88,Default,,0,0,0,,Жоқ, проблема жоқ.
Dialogue: 0,0:12:01.88,0:12:04.05,Default,,0,0,0,,Мен кенеттен кешірім сұраймын.
Dialogue: 0,0:12:05.22,0:12:07.51,Default,,0,0,0,,<Қолды қайтадан...>
Dialogue: 0,0:12:11.52,0:12:14.06,Default,,0,0,0,,<Бұл адам>
Dialogue: 0,0:12:14.06,0:12:17.23,Default,,0,0,0,,<Мен қорқынышты емеспін бе? ＞
Dialogue: 0,0:12:23.07,0:12:26.37,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:12:26.37,0:12:29.08,Default,,0,0,0,,Не? Сондықтан
Dialogue: 0,0:12:29.08,0:12:31.37,Default,,0,0,0,,Бұл құбыжық. Жақсы ма?
Dialogue: 0,0:12:31.37,0:12:34.54,Default,,0,0,0,,Сіз бұл шырғанақты жеп көрдіңіз бе?
Dialogue: 0,0:12:34.54,0:12:38.38,Default,,0,0,0,,Е, а, жоқ, бұл...
Dialogue: 0,0:12:38.38,0:12:40.38,Default,,0,0,0,,Иә
Dialogue: 0,0:12:40.38,0:12:42.38,Default,,0,0,0,,Сонымен оның дәмі қалай?
Dialogue: 0,0:12:44.38,0:12:51.10,Default,,0,0,0,,<Мұндай сұрақ кейде қойылады, бірақ ол әрқашан қорқынышты болып аяқталады>
Dialogue: 0,0:12:51.10,0:12:55.40,Default,,0,0,0,,Бұрғанның еті сиыр етіне ұқсас және өте дәмді болды.
Dialogue: 0,0:12:55.40,0:12:58.57,Default,,0,0,0,,Бұл жабайы жануар болғандықтан, етті мұқият ұру керек.
Dialogue: 0,0:12:58.57,0:13:02.94,Default,,0,0,0,,Аздап қуыру немесе бұқтыру ғана қалды...
Dialogue: 0,0:13:02.94,0:13:06.11,Default,,0,0,0,,Бұл сиырға ұқсайды ма?
Dialogue: 0,0:13:06.11,0:13:12.29,Default,,0,0,0,,Ендеше, жындыға айналмасаң, сиқырлы ет ренжімейсің бе?
Dialogue: 0,0:13:12.29,0:13:14.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:14.29,0:13:17.96,Default,,0,0,0,,《Жоқ, жоқ, сиырлар мен сиқырлы аңдар бірдей бола алмайды.》
Dialogue: 0,0:13:17.96,0:13:20.30,Default,,0,0,0,,《Оны ойлаудың өзі жүрегім айныды...》
Dialogue: 0,0:13:20.30,0:13:24.80,Default,,0,0,0,,《Сіз ешқашан нағыз ет жеген емессіз бе? 》
Dialogue: 0,0:13:25.97,0:13:29.43,Default,,0,0,0,,<Бұрынғыдан мүлде басқа реакция>
Dialogue: 0,0:13:30.43,0:13:33.60,Default,,0,0,0,,<Мені тыңдайсың ба? ＞
Dialogue: 0,0:13:36.14,0:13:38.61,Default,,0,0,0,,<Бақыттымын>
Dialogue: 0,0:13:40.15,0:13:45.15,Default,,0,0,0,,Оны қауіпсіз жеу үшін біз аңның сиқырлы күшін төгуіміз керек.
Dialogue: 0,0:13:45.15,0:13:47.16,Default,,0,0,0,,Мұны қалай жасайсыз?
Dialogue: 0,0:13:47.16,0:13:52.16,Default,,0,0,0,,Қанды алу кезінде бірге алып тастасаңыз, оны алу таңқаларлық оңай.
Dialogue: 0,0:13:52.16,0:13:56.16,Default,,0,0,0,,Арнайы құралдар мен сиқырды қажет етеді, бірақ дәлелденген
Dialogue: 0,0:13:57.62,0:14:00.46,Default,,0,0,0,,Мельфиера бұл... иә
Dialogue: 0,0:14:00.46,0:14:02.84,Default,,0,0,0,,<Жоқ... аты...>
Dialogue: 0,0:14:02.84,0:14:07.63,Default,,0,0,0,,Маған осы жолы да тамақ ішуге рұқсат бере аласыз ба?
Dialogue: 0,0:14:07.63,0:14:11.35,Default,,0,0,0,,Құбыжық еті
Dialogue: 0,0:14:11.35,0:14:13.35,Default,,0,0,0,,<Осындай адам...>
Dialogue: 0,0:14:14.64,0:14:16.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:16.64,0:14:19.35,Default,,0,0,0,,<Біз өмірімде бірінші рет кездестік>
Dialogue: 0,0:14:21.65,0:14:25.86,Default,,0,0,0,,Ах... Мм, кешіріңіз.
Dialogue: 0,0:14:25.86,0:14:29.66,Default,,0,0,0,,Герцогтың асқазаны күшті ме?
Dialogue: 0,0:14:29.66,0:14:33.03,Default,,0,0,0,,Әсіресе әдеттен тыс ештеңе жоқ, бірақ неге?
Dialogue: 0,0:14:33.03,0:14:38.87,Default,,0,0,0,,Менің ойымша, оларда жын-шайтанның уы бар, өйткені бұл Қарақұйрық сияқты жынданып кеткен құбыжықтармен күресу қиын болар еді.
Dialogue: 0,0:14:38.87,0:14:42.04,Default,,0,0,0,,Сонымен, егер бұл ақылсыз болмаса?
Dialogue: 0,0:14:42.04,0:14:47.05,Default,,0,0,0,,Кәдімгі ет сияқты, жаңа піскен филеден бастап шишке, фарш ішек т.б.
Dialogue: 0,0:14:47.05,0:14:49.38,Default,,0,0,0,,Сіз оны әртүрлі жолдармен пайдалана аласыз
Dialogue: 0,0:14:50.39,0:14:54.06,Default,,0,0,0,,Хмм, бұл қызық.
Dialogue: 0,0:14:56.22,0:15:00.06,Default,,0,0,0,,＜Осындай жүзбен кейде күлесің! ＞
Dialogue: 0,0:15:00.06,0:15:02.23,Default,,0,0,0,,<дәлірек айтсақ>
Dialogue: 0,0:15:02.23,0:15:05.90,Default,,0,0,0,,<Ол қандай да бір себептермен шынымен бақытты көрінеді>
Dialogue: 0,0:15:10.41,0:15:12.41,Default,,0,0,0,,Біз келдік
Dialogue: 0,0:15:12.41,0:15:14.41,Default,,0,0,0,,Керемет шатыр
Dialogue: 0,0:15:14.41,0:15:18.71,Default,,0,0,0,,Бұл әдемі жер емес шығар, бірақ асықпаңыз.
Dialogue: 0,0:15:18.71,0:15:21.92,Default,,0,0,0,,Қош келдіңіз, Мәртебелі.
Dialogue: 0,0:15:21.92,0:15:26.09,Default,,0,0,0,,Әй, менімен бірге келгеніңді естідім.
Dialogue: 0,0:15:26.09,0:15:28.42,Default,,0,0,0,,Эрл Маршалл Ридтің қызы.
Dialogue: 0,0:15:28.42,0:15:32.26,Default,,0,0,0,,Танысқаныма қуаныштымын, менің атым Мельфиера.
Dialogue: 0,0:15:32.26,0:15:34.55,Default,,0,0,0,,Менің атым Хаос.
Dialogue: 0,0:15:34.55,0:15:38.43,Default,,0,0,0,,Хаос Оның киімін ауыстыр
Dialogue: 0,0:15:38.43,0:15:41.44,Default,,0,0,0,,Мен қиындыққа тап болдым
Dialogue: 0,0:15:43.27,0:15:45.27,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:48.28,0:15:50.57,Default,,0,0,0,,А... осылай.
Dialogue: 0,0:15:51.95,0:15:55.28,Default,,0,0,0,,Киім алмас бұрын бет пен қолды жуған дұрыс.
Dialogue: 0,0:15:55.28,0:15:59.58,Default,,0,0,0,,Бұл... Герцог, соншалықты алысқа бармасаңыз да.
Dialogue: 0,0:15:59.58,0:16:02.29,Default,,0,0,0,,Уайымдама, мен аламын!
Dialogue: 0,0:16:02.29,0:16:04.58,Default,,0,0,0,,Мен онша лас емеспін
Dialogue: 0,0:16:04.58,0:16:07.75,Default,,0,0,0,,Герцог бірінші барады... Ха!
Dialogue: 0,0:16:09.76,0:16:12.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:12.13,0:16:15.30,Default,,0,0,0,,<га... жалаңаш~! ＞
Dialogue: 0,0:16:15.30,0:16:17.31,Default,,0,0,0,,<Naked! ＞
Dialogue: 0,0:16:17.31,0:16:22.60,Default,,0,0,0,,<Мен аумақта рыцарьлар мен аңшыларды сыртта тазарып жатқанын көрдім.>
Dialogue: 0,0:16:22.60,0:16:25.48,Default,,0,0,0,,<Менде қарсылық жоқ! ＞
Dialogue: 0,0:16:26.77,0:16:29.98,Default,,0,0,0,,<Бірақ мен одан көзімді ала алмаймын>
Dialogue: 0,0:16:29.98,0:16:32.61,Default,,0,0,0,,Болмады? Мелфиера Ха!
Dialogue: 0,0:16:32.61,0:16:34.61,Default,,0,0,0,,Бұл... Герцог
Dialogue: 0,0:16:34.61,0:16:37.99,Default,,0,0,0,,Сізде өте жақсы бұлшықеттер бар.
Dialogue: 0,0:16:37.99,0:16:41.79,Default,,0,0,0,,А... А, мен біраз жаттығып жатырмын.
Dialogue: 0,0:16:41.79,0:16:45.79,Default,,0,0,0,,Жарқыраған кесу қыры сол қолдан келеді, солай ма?
Dialogue: 0,0:16:45.79,0:16:50.00,Default,,0,0,0,,Cutting point? О, сіз бас кесу туралы айтып отырсыз ба?
Dialogue: 0,0:16:50.00,0:16:53.01,Default,,0,0,0,,<Бұл тамаша жарқыл болды>
Dialogue: 0,0:16:53.01,0:16:55.18,Default,,0,0,0,,күрсіну... Ах.
Dialogue: 0,0:16:59.31,0:17:01.31,Default,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:17:02.31,0:17:06.31,Default,,0,0,0,,Мм... мен де істей аламын ба?
Dialogue: 0,0:17:06.31,0:17:08.86,Default,,0,0,0,,Басты кесу
Dialogue: 0,0:17:08.86,0:17:11.69,Default,,0,0,0,,Жақсы, бір рет үйреніп алсаң.
Dialogue: 0,0:17:11.69,0:17:15.86,Default,,0,0,0,,Бірақ сол жіңішке қолдармен мен маңызды қылышты сермеу мүмкін емес.
Dialogue: 0,0:17:15.86,0:17:18.32,Default,,0,0,0,,Қиындықты маған қалдыр.
Dialogue: 0,0:17:18.32,0:17:22.04,Default,,0,0,0,,Жоқ? Герцогқа ма? О
Dialogue: 0,0:17:22.04,0:17:24.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:24.04,0:17:27.04,Default,,0,0,0,,Ал... Мен құбыжықтарды бағындыруға үйреніп қалғанмын!
Dialogue: 0,0:17:27.04,0:17:29.71,Default,,0,0,0,,Түсінемін, бұл сенімді!
Dialogue: 0,0:17:29.71,0:17:32.05,Default,,0,0,0,,Мен оның сенімді екенін білмеймін.
Dialogue: 0,0:17:34.05,0:17:38.34,Default,,0,0,0,,Сіз жегіңіз келетін нәрсе бар ма? Жақында мен құбыжықтарды аулайтын боламын.
Dialogue: 0,0:17:38.34,0:17:40.35,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:40.35,0:17:44.56,Default,,0,0,0,,Құбыжықтар үшін қасиетті орын деп айтуға болатын Гэлбрейт герцогтігінің үлкен орманында!
Dialogue: 0,0:17:44.56,0:17:47.90,Default,,0,0,0,,Маршалл Рейд территориясында кездеспейтін көптеген сирек түрлер!
Dialogue: 0,0:17:47.90,0:17:51.19,Default,,0,0,0,,Қандай сән-салтанат! Ха
Dialogue: 0,0:17:52.36,0:17:54.36,Default,,0,0,0,,Мелфиера?
Dialogue: 0,0:17:54.36,0:17:56.36,Default,,0,0,0,,Оның үстінде әлі қан бар
Dialogue: 0,0:17:56.36,0:17:58.91,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:17:59.91,0:18:02.20,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:18:02.20,0:18:05.58,Default,,0,0,0,,Ал, герцог те.
Dialogue: 0,0:18:09.08,0:18:11.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:17.38,0:18:19.76,Default,,0,0,0,,Жоғары мәртебелі, сәлем!
Dialogue: 0,0:18:19.76,0:18:23.93,Default,,0,0,0,,Сен неге әйелдің алдында жалаңашсың?
Dialogue: 0,0:18:23.93,0:18:27.39,Default,,0,0,0,,Ол толығымен жалаңаш емес, тек үстіңгі денесі.
Dialogue: 0,0:18:27.39,0:18:30.23,Default,,0,0,0,,Бұл толықтай жалаңаш па, әлде жоғарғы дене ме
Dialogue: 0,0:18:30.23,0:18:34.11,Default,,0,0,0,,Бұл графтың үйленбеген қызына көрсететін нәрсе емес!
Dialogue: 0,0:18:34.11,0:18:36.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:41.41,0:18:43.79,Default,,0,0,0,,Керемет көйлек
Dialogue: 0,0:18:43.79,0:18:46.62,Default,,0,0,0,,Мен Мәртебелі Королевадан алған көйлек.
Dialogue: 0,0:18:46.62,0:18:48.62,Default,,0,0,0,,Бұл сізге жарасады.
Dialogue: 0,0:18:49.79,0:18:53.42,Default,,0,0,0,,<О, менің... қандай керемет! ＞
Dialogue: 0,0:18:53.42,0:18:58.42,Default,,0,0,0,,<Мен де осындай құбыжықтарды ауласам, қандай тамаша болар еді! ＞
Dialogue: 0,0:18:58.42,0:19:01.64,Default,,0,0,0,,Иә, әдетте ханымның алдында.
Dialogue: 0,0:19:01.64,0:19:04.14,Default,,0,0,0,,Жынның кесілген басын әкелсем ше?
Dialogue: 0,0:19:04.14,0:19:08.64,Default,,0,0,0,,Сіз есінен танып қалуыңыз мүмкін.
Dialogue: 0,0:19:11.44,0:19:15.15,Default,,0,0,0,,Мәртебелі көктемнің кеші ме?
Dialogue: 0,0:19:16.44,0:19:20.15,Default,,0,0,0,,Кешіріңіз, мен сізді шығарып салуға қиналдым.
Dialogue: 0,0:19:20.15,0:19:25.99,Default,,0,0,0,,Құрметті герцог, менің өмірімді сақтап қалғаныңыз үшін көп рахмет.
Dialogue: 0,0:19:30.00,0:19:33.00,Default,,0,0,0,,Тағы да рахмет.
Dialogue: 0,0:19:33.00,0:19:35.00,Default,,0,0,0,,<Қазір қош бол>
Dialogue: 0,0:19:35.00,0:19:38.67,Default,,0,0,0,,Олай болса, кәдесыйлар алып келейік.
Dialogue: 0,0:19:38.67,0:19:41.18,Default,,0,0,0,,Егер мүмкіндігіңіз болса, өтінемін
Dialogue: 0,0:19:41.18,0:19:45.31,Default,,0,0,0,,Жарақат алудан сақ болыңыз.
Dialogue: 0,0:19:45.31,0:19:47.85,Default,,0,0,0,,Аа, оны асыға күтіңіз.
Dialogue: 0,0:19:47.85,0:19:51.48,Default,,0,0,0,,Мен майлы король мудрасын өлтіремін.
Dialogue: 0,0:19:51.48,0:19:55.02,Default,,0,0,0,,<Король мудра!?> (қарлығаштар)
Dialogue: 0,0:19:55.02,0:19:59.86,Default,,0,0,0,,<Жоқ, жоқ, Мельфиера! Мен герцогтың мейіріміне еріндім! ＞
Dialogue: 0,0:19:59.86,0:20:01.86,Default,,0,0,0,,<Бірақ...бірақ>
Dialogue: 0,0:20:01.86,0:20:07.33,Default,,0,0,0,,Мм... Құбыжықтардың дәмін татып көру үшін оларды тірідей ұстаған дұрыс деп ойлаймын.
Dialogue: 0,0:20:07.33,0:20:09.87,Default,,0,0,0,,Әй, сен тірі ұсталды ма?
Dialogue: 0,0:20:09.87,0:20:13.71,Default,,0,0,0,,Қиындықтың көтерілетіні рас, бірақ қолдарым шырылдамайды.
Dialogue: 0,0:20:13.71,0:20:19.51,Default,,0,0,0,,<Жынды қанды герцог - қанды жақсы көретін қатыгез және қатыгез жын>
Dialogue: 0,0:20:19.51,0:20:22.34,Default,,0,0,0,,<Өсек деген тек қана қауесет>
Dialogue: 0,0:20:22.34,0:20:26.22,Default,,0,0,0,,＜Шынында сондай мейірімді адам＞
Dialogue: 0,0:20:29.52,0:20:32.52,Default,,0,0,0,,Сол герцог...
Dialogue: 0,0:20:32.52,0:20:35.90,Default,,0,0,0,,Бұл не? Маршалл рейд аймағының сиқырлы аңы
Dialogue: 0,0:20:35.90,0:20:38.52,Default,,0,0,0,,Кептірілген скатбит еті
Dialogue: 0,0:20:38.52,0:20:40.74,Default,,0,0,0,,Біз мұқият дайындадық
Dialogue: 0,0:20:40.74,0:20:44.74,Default,,0,0,0,,Жесең ренжімейсің, солай ма?
Dialogue: 0,0:20:44.74,0:20:48.74,Default,,0,0,0,,Сізге үлкен рахмет, Мәртебелі!
Dialogue: 0,0:20:48.74,0:20:54.25,Default,,0,0,0,,Сіз... бастапқыда удың дәмін татуымыз керек күйдесіз.
Dialogue: 0,0:20:54.25,0:20:56.25,Default,,0,0,0,,Пек! Пек!
Dialogue: 0,0:20:56.25,0:20:59.92,Default,,0,0,0,,Мынау... бұл дәм! Қараңыз, мен ештеңе айтпаймын! Аузыңды аш
Dialogue: 0,0:20:59.92,0:21:02.76,Default,,0,0,0,,Шулы, сен де же!
Dialogue: 0,0:21:02.76,0:21:06.76,Default,,0,0,0,,Аузыңның арғы жағына тарайтын бұл ащылық, умами...
Dialogue: 0,0:21:06.76,0:21:09.39,Default,,0,0,0,,Мүмкін! Алкогольді қалаймын!
Dialogue: 0,0:21:10.56,0:21:15.77,Default,,0,0,0,,Бұл дәмді. Бұл дәм мені басқа құбыжық тағамдарын да татып көргім келеді.
Dialogue: 0,0:21:16.77,0:21:21.40,Default,,0,0,0,,<Үйрету немесе зиянды қауесет тарату>
Dialogue: 0,0:21:21.40,0:21:24.40,Default,,0,0,0,,<Жоққа шығарылған нәрселер көп болды>
Dialogue: 0,0:21:24.40,0:21:28.95,Default,,0,0,0,,<Бірақ мен жаман ештеңе істеп жатқан жоқпын>
Dialogue: 0,0:21:28.95,0:21:31.29,Default,,0,0,0,,<Сондықтан маған бәрібір>
Dialogue: 0,0:21:31.29,0:21:33.41,Default,,0,0,0,,<Уайымдамаңыз>
Dialogue: 0,0:21:35.12,0:21:38.13,Default,,0,0,0,,Сәлем, Мельфиера? <Мен солай ойлауым керек еді>
Dialogue: 0,0:21:39.42,0:21:41.96,Default,,0,0,0,,<Герцог...>
Dialogue: 0,0:21:41.96,0:21:46.97,Default,,0,0,0,,<Герцог тым мейірімді>
Dialogue: 0,0:21:46.97,0:21:49.60,Default,,0,0,0,,Не болды? Жоқ
Dialogue: 0,0:21:49.60,0:21:52.14,Default,,0,0,0,,Мен оны тастап кету ұят екенін сезіндім.
Dialogue: 0,0:21:52.14,0:21:56.98,Default,,0,0,0,,Жарайды, мен де сенімен сөйлескім келді.
Dialogue: 0,0:21:58.44,0:22:01.44,Default,,0,0,0,,Матана Мельфиера
Dialogue: 0,0:22:01.44,0:22:04.44,Default,,0,0,0,,Иә, герцог.
Dialogue: 0,0:22:07.61,0:22:10.16,Default,,0,0,0,,Бұл уәде!
Dialogue: 0,0:22:10.16,0:22:13.33,Default,,0,0,0,,<Герцогпен кездескеніме қуаныштымын>
Dialogue: 0,0:22:13.33,0:22:17.83,Default,,0,0,0,,<Мен кешке барғым келмесе де, бұл өз алдына қызық болды.>
Dialogue: 0,0:22:17.83,0:22:23.34,Default,,0,0,0,,<Герцогтың айтқаны әлеуметтік қимыл екеніне сенімдімін.>
Dialogue: 0,0:22:23.34,0:22:26.84,Default,,0,0,0,,<Құбыжықтарды жейтін қыз бар екен> деген өсек
Dialogue: 0,0:22:26.84,0:22:30.64,Default,,0,0,0,,<Мүмкін мен оның қандай қыз екенін білгім келген шығар>
Dialogue: 0,0:22:31.64,0:22:34.18,Default,,0,0,0,,<Бірақ мүмкін...>
Dialogue: 0,0:22:35.48,0:22:38.85,Default,,0,0,0,,<Кішкене ғана үмітпен>
Dialogue: 0,0:22:41.19,0:22:53.87,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:55.37,0:23:01.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
