Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.13,0:00:08.13,Default,,0,0,0,,Сіз оны жоймайсыз ба? (Аристид) О
Dialogue: 0,0:00:08.13,0:00:10.67,Default,,0,0,0,,Оқиға орнында «Жалын бүркіті» бөлімшесі кетіп қалды
Dialogue: 0,0:00:10.67,0:00:12.84,Default,,0,0,0,,Мүмкін бірдеңе тауып аларсың.
Dialogue: 0,0:00:12.84,0:00:15.51,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:00:15.51,0:00:18.85,Default,,0,0,0,,Иә? ше? моллан
Dialogue: 0,0:00:18.85,0:00:20.85,Default,,0,0,0,,Жоқ, өйткені
Dialogue: 0,0:00:20.85,0:00:24.15,Default,,0,0,0,,Осы құйрық пен Мельфиера-саманың Сиэлі арасында
Dialogue: 0,0:00:24.15,0:00:27.15,Default,,0,0,0,,Олар ішкі есік арқылы қосылған, солай ма?
Dialogue: 0,0:00:27.15,0:00:30.86,Default,,0,0,0,,Сіз қобалжыдыңыз ба?
Dialogue: 0,0:00:30.86,0:00:33.03,Default,,0,0,0,,Менің басқа ниетім жоқ.
Dialogue: 0,0:00:33.03,0:00:35.16,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:00:35.16,0:00:39.03,Default,,0,0,0,,Мулан Құстарды жетелеген басты көрдің бе?
Dialogue: 0,0:00:40.87,0:00:43.87,Default,,0,0,0,,Үйірмен аң аулайтын жын құс болса да.
Dialogue: 0,0:00:43.87,0:00:46.88,Default,,0,0,0,,Мен бірінші рет осынша құмар болып тұрмын.
Dialogue: 0,0:00:46.88,0:00:50.17,Default,,0,0,0,,Ең үлкен Бергенион басы болса керек.
Dialogue: 0,0:00:50.17,0:00:55.34,Default,,0,0,0,,Үйірге жүгіріп кірсем, жалғыз ол мені айналып өтпеді.
Dialogue: 0,0:00:55.34,0:00:58.89,Default,,0,0,0,,Грешель айдаһарларынан қорықпайтын жеке тұлға?
Dialogue: 0,0:00:58.89,0:01:02.56,Default,,0,0,0,,Сіз қалай ойлайсыз? Қалай ойлайсыз, бұл нәрсе ақылсыз болды ма?
Dialogue: 0,0:01:02.56,0:01:04.56,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:01:06.56,0:01:10.57,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:01:14.07,0:01:16.07,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:47.29,0:02:50.00,Default,,0,0,0,,<Егер Мулан солай айтса>
Dialogue: 0,0:02:50.00,0:02:53.17,Default,,0,0,0,,<Ол жынды болып кеткен болуы керек>
Dialogue: 0,0:02:53.17,0:02:56.46,Default,,0,0,0,,<Осындай күшті сиқырлы күші бар бұлтты кристал>
Dialogue: 0,0:02:56.46,0:03:00.18,Default,,0,0,0,,<Ескертусіз жұтып қойған ең үлкен жын құс>
Dialogue: 0,0:03:01.18,0:03:03.85,Default,,0,0,0,,<Жынның уының жиналуынан есінен танып қалды>
Dialogue: 0,0:03:03.85,0:03:06.68,Default,,0,0,0,,<Отарды жетектеп қашып кетті>
Dialogue: 0,0:03:06.68,0:03:09.48,Default,,0,0,0,,<Осылай ойласаң, жақсы балл аламын деп ойлайсың ба?>
Dialogue: 0,0:03:11.85,0:03:14.32,Default,,0,0,0,,Солай болса да, Мәртебелі.
Dialogue: 0,0:03:14.32,0:03:18.19,Default,,0,0,0,,Сенде мұндай сұмдық сиқыр қашан пайда болды?
Dialogue: 0,0:03:18.19,0:03:21.03,Default,,0,0,0,,Сізге рахмет, мен өлемін деп ойладым.
Dialogue: 0,0:03:22.49,0:03:25.70,Default,,0,0,0,,<Мен бұл сиқырлы шеңберді жаңа ғана іске қостым>
Dialogue: 0,0:03:25.70,0:03:28.20,Default,,0,0,0,,<Оны ойлаған Мельфиера болды>
Dialogue: 0,0:03:29.50,0:03:32.21,Default,,0,0,0,,<Мен қатты ойлаған сиқыр>
Dialogue: 0,0:03:32.21,0:03:34.88,Default,,0,0,0,,<Не азғындық?>
Dialogue: 0,0:03:34.88,0:03:37.05,Default,,0,0,0,,<Мельфиера зерттеулерінің жанама өнімі>
Dialogue: 0,0:03:37.05,0:03:40.22,Default,,0,0,0,,<Елді дүр сілкіндіре алатын қару болары сөзсіз>
Dialogue: 0,0:03:40.22,0:03:44.05,Default,,0,0,0,,<Оны қалай пайдаланатыныңызға байланысты, ол жаман емес>
Dialogue: 0,0:03:45.05,0:03:50.23,Default,,0,0,0,,<Алайда, сол сиқырлы шеңберді белсендіруге білімі мен дағдысы бар адам>
Dialogue: 0,0:03:50.23,0:03:52.23,Default,,0,0,0,,<Бұл елде қанша адам бар? ＞
Dialogue: 0,0:03:53.23,0:03:56.23,Default,,0,0,0,,<Және Мельфиераны қорғау үшін>
Dialogue: 0,0:03:56.23,0:03:59.90,Default,,0,0,0,,<Сенімді адаммен ынтымақтастық қажет>
Dialogue: 0,0:03:59.90,0:04:02.91,Default,,0,0,0,,<Мысалы, мына Мулан сияқты>
Dialogue: 0,0:04:03.91,0:04:05.91,Default,,0,0,0,,(Жан) Хе-хе-хе, балалар қаншалықты кінәсіз ғой, иә?
Dialogue: 0,0:04:05.91,0:04:08.91,Default,,0,0,0,,Ух... иә?
Dialogue: 0,0:04:08.91,0:04:11.25,Default,,0,0,0,,Хмм... шын мәнінде
Dialogue: 0,0:04:11.25,0:04:15.92,Default,,0,0,0,,Мен сізге сол жағымсыз сиқыр туралы бірдеңе айтқым келеді.
Dialogue: 0,0:04:15.92,0:04:17.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:24.09,0:04:28.10,Default,,0,0,0,,Бұл мен де білгім келетін нәрсе.
Dialogue: 0,0:04:28.10,0:04:31.10,Default,,0,0,0,,Хаос!? Хаос көмекшісі!
Dialogue: 0,0:04:31.10,0:04:33.77,Default,,0,0,0,,Ха ха ха... Не? Бұл қылыш
Dialogue: 0,0:04:33.77,0:04:36.27,Default,,0,0,0,,Жоқ, сен... кенеттен!
Dialogue: 0,0:04:36.27,0:04:38.27,Default,,0,0,0,,Таң қалмаңыз!
Dialogue: 0,0:04:38.27,0:04:42.11,Default,,0,0,0,,Бұл нақты төтенше жағдайларда ғана қолданылатын жасырын есік болса керек!
Dialogue: 0,0:04:42.11,0:04:45.41,Default,,0,0,0,,Күрсіну... мүлде емес.
Dialogue: 0,0:04:45.41,0:04:49.41,Default,,0,0,0,,Уга! Мәртебелі басы төтенше жағдайда!
Dialogue: 0,0:04:49.41,0:04:54.42,Default,,0,0,0,,Неліктен Сиел Room-ға Мелфиера-саманы көрсетіп жатырсыз?
Dialogue: 0,0:04:54.42,0:05:00.13,Default,,0,0,0,,Мен артқа қайтып, үлкен есіктің алдында күту үшін жеделдету әдісін қолдандым!
Dialogue: 0,0:05:00.13,0:05:02.30,Default,,0,0,0,,Кешіріңіз... Кешіріңіз.
Dialogue: 0,0:05:02.30,0:05:06.59,Default,,0,0,0,,Мен алдымен Мельфиераны дайындауым керек деп ойладым.
Dialogue: 0,0:05:06.59,0:05:08.60,Default,,0,0,0,,Әрине!
Dialogue: 0,0:05:08.60,0:05:12.98,Default,,0,0,0,,Ол үшін маған шұғыл түрде қызметші қыз керек.
Dialogue: 0,0:05:12.98,0:05:15.60,Default,,0,0,0,,Мен де дайындалдым.
Dialogue: 0,0:05:15.60,0:05:18.98,Default,,0,0,0,,Уухоу Уууу
Dialogue: 0,0:05:18.98,0:05:21.15,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:21.15,0:05:23.61,Default,,0,0,0,,Эй... Әпке!?
Dialogue: 0,0:05:23.61,0:05:29.99,Default,,0,0,0,,-да? Біз Мельфиера-саманы Сиэлдің бөлмесінде жалғыз қалдыратын сияқты емеспіз, солай ма?
Dialogue: 0,0:05:29.99,0:05:31.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:31.99,0:05:35.16,Default,,0,0,0,,Шайқасқа келгенде ұшқырсың.
Dialogue: 0,0:05:35.16,0:05:39.17,Default,,0,0,0,,Бұл нәрселер туралы шынымен ештеңе білмейтініңізді түсініңіз.
Dialogue: 0,0:05:39.17,0:05:42.34,Default,,0,0,0,,Қалқыңыз, Мәртебелі! Уф...
Dialogue: 0,0:05:45.63,0:05:48.47,Default,,0,0,0,,Сіз Мельфиераны жалғыз қалдырасыз ба?
Dialogue: 0,0:05:48.47,0:05:51.01,Default,,0,0,0,,Бланш тобы дұрыс бекітілген.
Dialogue: 0,0:05:51.01,0:05:53.02,Default,,0,0,0,,Бланш командасы?
Dialogue: 0,0:05:53.02,0:05:56.35,Default,,0,0,0,,Бұл жігіттер бәрібір Мельфиераның эскорт серілері.
Dialogue: 0,0:05:56.35,0:06:00.36,Default,,0,0,0,,Ерте кездессек жаман болмайды.
Dialogue: 0,0:06:00.36,0:06:04.03,Default,,0,0,0,,Бұл жоғары мәртебелі баға.
Dialogue: 0,0:06:05.03,0:06:07.65,Default,,0,0,0,,Сізге қоңырау шалғаным үшін кешірім сұраймын.
Dialogue: 0,0:06:07.65,0:06:11.37,Default,,0,0,0,,Мадам Лафорг Мадам Джурден Мадам Теру
Dialogue: 0,0:06:11.37,0:06:16.04,Default,,0,0,0,,Мельфиера-сама Бланштың командасымен кездесіп жатқан сияқты.
Dialogue: 0,0:06:16.04,0:06:20.21,Default,,0,0,0,,Біраз күтіп, көйлекті алып жүре аласыз ба?
Dialogue: 0,0:06:20.21,0:06:24.67,Default,,0,0,0,,О, хаос, анаңнан кешірім сұраудың қажеті жоқ.
Dialogue: 0,0:06:24.67,0:06:29.05,Default,,0,0,0,,Иә, Мәртебелі сәл ғана толқып тұр.
Dialogue: 0,0:06:29.05,0:06:32.51,Default,,0,0,0,,Бірақ мен Сіздің Мәртебеліңіз ерекше ілтипатпен қарайтын жас ханыммын.
Dialogue: 0,0:06:32.51,0:06:35.22,Default,,0,0,0,,Біз де сізді жақын арада көреміз деп үміттенеміз.
Dialogue: 0,0:06:35.22,0:06:38.89,Default,,0,0,0,,Иә? Мюран Ух... иә
Dialogue: 0,0:06:38.89,0:06:42.52,Default,,0,0,0,,Олай болса шәй ішейік. Оларда жақсы шай жапырақтары бар.
Dialogue: 0,0:06:42.52,0:06:44.90,Default,,0,0,0,,Олай болса менің нанымнан дәм татыңыз.
Dialogue: 0,0:06:44.90,0:06:48.70,Default,,0,0,0,,О, бұл жақсы. Менің шайға көзім бар...
Dialogue: 0,0:06:51.03,0:06:55.74,Default,,0,0,0,,Сіз әдетте биологиялық анаңызды қызметші етіп таңдайсыз ба?
Dialogue: 0,0:06:55.74,0:06:59.58,Default,,0,0,0,,Ол ең сенімді адам.
Dialogue: 0,0:06:59.58,0:07:03.21,Default,,0,0,0,,Менің де бала кезіңде сені бағып-қаққан тәжірибем бар.
Dialogue: 0,0:07:03.21,0:07:06.59,Default,,0,0,0,,Мельфиера-саманы қорғауға өте ыңғайлы.
Dialogue: 0,0:07:06.59,0:07:09.76,Default,,0,0,0,,Ал... бұл рас болуы мүмкін.
Dialogue: 0,0:07:09.76,0:07:13.43,Default,,0,0,0,,Ах... Мм... Көмекші Хаос
Dialogue: 0,0:07:13.43,0:07:16.43,Default,,0,0,0,,Менің әпкем неге осында?
Dialogue: 0,0:07:16.43,0:07:19.06,Default,,0,0,0,,Менің әпкем жай наубайшы ғой, солай ма?
Dialogue: 0,0:07:19.06,0:07:24.06,Default,,0,0,0,,Теру ханымның кіші інісі рыцарь болды және отбасылық үйді мұраға алатын ешкім болмады.
Dialogue: 0,0:07:24.06,0:07:27.78,Default,,0,0,0,,Күйеу баласын алып, дүкенді басқарған тамаша әйел.
Dialogue: 0,0:07:27.78,0:07:30.78,Default,,0,0,0,,Әй, сен үлкен әпкесің.
Dialogue: 0,0:07:30.78,0:07:35.08,Default,,0,0,0,,Жоқ, иә, кешіріңіз.
Dialogue: 0,0:07:35.08,0:07:38.95,Default,,0,0,0,,Джордан ханым да Гэлбрейт рыцарының әйелі.
Dialogue: 0,0:07:38.95,0:07:43.79,Default,,0,0,0,,Бұл жай ғана ауысым, сондықтан біз қызметшілерді кейінірек қайта таңдаймыз.
Dialogue: 0,0:07:45.46,0:07:49.26,Default,,0,0,0,,<Хаостың кадр таңдауына ешқандай шағымым жоқ>
Dialogue: 0,0:07:49.26,0:07:53.80,Default,,0,0,0,,<Әдеттегідей, оның жақсы дайындалғаны сонша, қорқынышты.>
Dialogue: 0,0:07:54.97,0:07:56.97,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:08:01.10,0:08:03.65,Default,,0,0,0,,Бұрынғыдан жалғастыру
Dialogue: 0,0:08:03.65,0:08:07.48,Default,,0,0,0,,Сол сиқырдың бәрін айтып берейін.
Dialogue: 0,0:08:08.98,0:08:13.99,Default,,0,0,0,,Мен сенің түпсіз сиқырлы күшің бар деп ойладым.
Dialogue: 0,0:08:13.99,0:08:15.99,Default,,0,0,0,,Бұл не!? Міне бітті!
Dialogue: 0,0:08:15.99,0:08:20.12,Default,,0,0,0,,Сізге Эльсений орманы ұнағаны сонша, оның бір бөлігі болдыңыз ба?
Dialogue: 0,0:08:20.12,0:08:24.83,Default,,0,0,0,,Түзетілген атауы: Mad Blood Duke Сіз оны жаяу жанартау немесе сиқырлы қуат өндіру машинасы деп атайсыз ба?
Dialogue: 0,0:08:24.83,0:08:28.00,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:08:28.00,0:08:33.84,Default,,0,0,0,,Күлсін... Сізден басқа байқаған адам бар деп ойлайсыз ба?
Dialogue: 0,0:08:33.84,0:08:37.51,Default,,0,0,0,,Ал, Мулан, сен ше?
Dialogue: 0,0:08:37.51,0:08:40.02,Default,,0,0,0,,Не? А, бұл...
Dialogue: 0,0:08:40.02,0:08:43.31,Default,,0,0,0,,Мен сіздің әңгімеңіздің мағынасын түсінбеймін.
Dialogue: 0,0:08:43.31,0:08:45.52,Default,,0,0,0,,Бірақ сол кезде...
Dialogue: 0,0:08:46.86,0:08:49.02,Default,,0,0,0,,《(Жарылыс дыбысы)》
Dialogue: 0,0:08:50.15,0:08:53.86,Default,,0,0,0,,Бергенион үйірін бөлшектеп тастаған сиқыр.
Dialogue: 0,0:08:53.86,0:08:57.32,Default,,0,0,0,,Оны Мельфиера салған.
Dialogue: 0,0:08:57.32,0:09:00.54,Default,,0,0,0,,Иә? Мельфиера-сама!?
Dialogue: 0,0:09:00.54,0:09:04.16,Default,,0,0,0,,Анау тентек... А-а-а-а...
Dialogue: 0,0:09:04.16,0:09:07.17,Default,,0,0,0,,Сол қорқынышты жарылыс!?
Dialogue: 0,0:09:07.17,0:09:11.55,Default,,0,0,0,,Мельфиера маған көмектесуге тырысты.
Dialogue: 0,0:09:11.55,0:09:16.18,Default,,0,0,0,,Иә? Оның үстіне, бұл зат Ханастың сиқырлы күшін пайдаланды.
Dialogue: 0,0:09:16.18,0:09:19.35,Default,,0,0,0,,Таңертеңгі асқа Ханас ішкен бе?
Dialogue: 0,0:09:20.35,0:09:24.35,Default,,0,0,0,,Ах, бұлтты кристалда сақталған сиқырлы күштің массасы.
Dialogue: 0,0:09:24.35,0:09:28.90,Default,,0,0,0,,Мельфиера ойына келген барлық сиқырлы шеңберді сызып, маған берді.
Dialogue: 0,0:09:28.90,0:09:32.57,Default,,0,0,0,,Мен оны жаңа ғана іске қостым.
Dialogue: 0,0:09:32.57,0:09:35.57,Default,,0,0,0,,Жоқ, жоқ, жоқ, солай!
Dialogue: 0,0:09:35.57,0:09:38.20,Default,,0,0,0,,Мельфиера-сама данышпан ма?
Dialogue: 0,0:09:38.20,0:09:41.20,Default,,0,0,0,,Дұрыс, данышпан. А?
Dialogue: 0,0:09:41.20,0:09:44.75,Default,,0,0,0,,<Мюранның абдырап қалғаны таңқаларлық емес>
Dialogue: 0,0:09:44.75,0:09:47.37,Default,,0,0,0,,<Қазіргі заманда сиқыр дегеніміз не?>
Dialogue: 0,0:09:47.37,0:09:52.59,Default,,0,0,0,,<Негізгі ағым жеңілдетілген және жеңілдетілген емлені айту.>
Dialogue: 0,0:09:52.59,0:09:58.39,Default,,0,0,0,,<Екінші жағынан, ежелгі сиқыр - бұл құдайлардың ежелгі дәуірінде рухтардың адамдарға берген даналығы.>
Dialogue: 0,0:09:58.39,0:10:00.39,Default,,0,0,0,,<Маған солай айтылған>
Dialogue: 0,0:10:00.39,0:10:04.93,Default,,0,0,0,,<Қазір аз адамдар зерттейтін ескірген сиқыр>
Dialogue: 0,0:10:04.93,0:10:09.40,Default,,0,0,0,,<Оның мұндай сиқырлы шеңберді өзі дерлік сыза алғанына сенбеймін>
Dialogue: 0,0:10:09.40,0:10:12.77,Default,,0,0,0,,<Мулан айтқандай, ол данышпан болса керек>
Dialogue: 0,0:10:13.94,0:10:18.24,Default,,0,0,0,,Сіз Chaos Melfiera зерттеу материалдарын дұрыс сақтадыңыз ба?
Dialogue: 0,0:10:18.24,0:10:20.24,Default,,0,0,0,,Иә, қатаң
Dialogue: 0,0:10:20.24,0:10:26.62,Default,,0,0,0,,Корольдік Мудраның сиқырымен толтырылған бұлтты кристалл ерекше күтіммен жабылған.
Dialogue: 0,0:10:26.62,0:10:31.25,Default,,0,0,0,,Бұл қазір жақсы, оны пайдаланудың көптеген бейбіт жолдары бар.
Dialogue: 0,0:10:31.25,0:10:36.26,Default,,0,0,0,,Қоршаған орта орнына келгенше естігенім туралы ештеңе айтудың қажеті жоқ, Мюран.
Dialogue: 0,0:10:36.26,0:10:38.26,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:10:38.26,0:10:41.14,Default,,0,0,0,,Бірақ... Бірақ неге мен?
Dialogue: 0,0:10:41.14,0:10:43.14,Default,,0,0,0,,Бұл.
Dialogue: 0,0:10:43.14,0:10:47.64,Default,,0,0,0,,Мельфиераны қорғау үшін Бланштың отрядына еріп баруыңызды қалаймын.
Dialogue: 0,0:10:47.64,0:10:49.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:49.64,0:10:52.81,Default,,0,0,0,,Атты әскерлер отрядының бастығы ретіндегі міндеттерім өзгеріссіз қалады.
Dialogue: 0,0:10:52.81,0:10:55.15,Default,,0,0,0,,Қажет болса, бір уақытта қызмет етіңіз.
Dialogue: 0,0:10:55.15,0:10:58.99,Default,,0,0,0,,Мидрейгте қалсақ, қауіпсіз болмай ма?
Dialogue: 0,0:10:58.99,0:11:01.82,Default,,0,0,0,,Мұнда адамдар аздап көп.
Dialogue: 0,0:11:01.82,0:11:05.99,Default,,0,0,0,,Мен зертхана ретінде пайдаланып жатқан оқшаулау бөлмесін дайындадым.
Dialogue: 0,0:11:05.99,0:11:08.66,Default,,0,0,0,,Ештеңе болмауы керек
Dialogue: 0,0:11:10.00,0:11:13.84,Default,,0,0,0,,Мен Мельфиераның зерттеулерін тоқтатпаймын.
Dialogue: 0,0:11:13.84,0:11:18.47,Default,,0,0,0,,Егер оның зерттеуі құбыжықтарды қауіпсіз жеуге мүмкіндік берсе
Dialogue: 0,0:11:18.47,0:11:21.84,Default,,0,0,0,,Гэлбрейт те жақсы жаққа өзгереді.
Dialogue: 0,0:11:21.84,0:11:24.30,Default,,0,0,0,,Мен сұрадым, Мюран.
Dialogue: 0,0:11:24.30,0:11:26.47,Default,,0,0,0,,Маған қалдыр!
Dialogue: 0,0:11:30.69,0:11:34.02,Default,,0,0,0,,<Мен мұны Мелфимен талқылауым керек>
Dialogue: 0,0:11:35.02,0:11:38.03,Default,,0,0,0,,<Ол жақсы адам>
Dialogue: 0,0:11:38.03,0:11:41.49,Default,,0,0,0,,<Менің зерттеуімді теріс пайдаланғысы келетін адамдар бар екенін білемін>
Dialogue: 0,0:11:41.49,0:11:43.87,Default,,0,0,0,,<Сіз түсінбеуіңіз мүмкін>
Dialogue: 0,0:11:46.20,0:11:50.21,Default,,0,0,0,,<Жарайды, мен сені сөзсіз қорғаймын>
Dialogue: 0,0:11:54.21,0:11:56.21,Default,,0,0,0,,Менің саған айтатын әңгімем бар.
Dialogue: 0,0:11:56.21,0:11:59.88,Default,,0,0,0,,А, Кей... Еркек пе?
Dialogue: 0,0:12:04.39,0:12:09.06,Default,,0,0,0,,Менсіз не істеп жүрсің?
Dialogue: 0,0:12:09.06,0:12:11.52,Default,,0,0,0,,Сіз оны жедіңіз бе?
Dialogue: 0,0:12:11.52,0:12:14.06,Default,,0,0,0,,Мына жігіттің көзі күлмейді!
Dialogue: 0,0:12:15.36,0:12:17.73,Default,,0,0,0,,Ой, нені айтып тұрсың?
Dialogue: 0,0:12:17.73,0:12:20.74,Default,,0,0,0,,Сонымен... нені айтып тұрсың!?
Dialogue: 0,0:12:20.74,0:12:24.74,Default,,0,0,0,,Мельфиера-сама пісірген дәмді Кана...
Dialogue: 0,0:12:24.74,0:12:27.74,Default,,0,0,0,,А... Мұран да сонда.
Dialogue: 0,0:12:27.74,0:12:29.74,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:12:29.74,0:12:33.54,Default,,0,0,0,,Солай ма? Ханас қазір маусымда.
Dialogue: 0,0:12:33.54,0:12:36.08,Default,,0,0,0,,Менсіз таңғы ас!
Dialogue: 0,0:12:36.08,0:12:38.38,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:38.38,0:12:40.76,Default,,0,0,0,,Жоғары мәртебелі, дайын болыңыз! Кешіріңіз мырза
Dialogue: 0,0:12:40.76,0:12:42.76,Default,,0,0,0,,Тоқта, тыныштал! Мен сені ұрмаймын.
Dialogue: 0,0:12:42.76,0:12:48.26,Default,,0,0,0,,Ах, хаос көмекшісі, капитан Мулан да осында болды ма?
Dialogue: 0,0:12:48.26,0:12:50.39,Default,,0,0,0,,Не?
Dialogue: 0,0:12:50.39,0:12:52.39,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:52.39,0:12:58.40,Default,,0,0,0,,Бізге қалдырылған әскерлерден Бергенионның біразы есінен танып қалғаны туралы хабар алдық.
Dialogue: 0,0:12:58.40,0:13:03.57,Default,,0,0,0,,Жағдай соншалық, герцог бағыну миссиясын орындауға мәжбүр болды ма?
Dialogue: 0,0:13:03.57,0:13:07.28,Default,,0,0,0,,Бұл Гэлбрейттің күнделікті өмірі.
Dialogue: 0,0:13:09.78,0:13:12.95,Default,,0,0,0,,Мен сенің бетіңді ашуды жоспарлап едім.
Dialogue: 0,0:13:12.95,0:13:16.12,Default,,0,0,0,,Тез келгенім үшін кешірім сұраймын.
Dialogue: 0,0:13:16.12,0:13:18.79,Default,,0,0,0,,Пампака-пан!
Dialogue: 0,0:13:18.79,0:13:23.13,Default,,0,0,0,,Менің қолымнан келетін нәрсе бар ма?
Dialogue: 0,0:13:23.13,0:13:25.43,Default,,0,0,0,,Иә
Dialogue: 0,0:13:25.43,0:13:28.30,Default,,0,0,0,,Мен сенімен бірге болғым келеді, бірақ
Dialogue: 0,0:13:28.30,0:13:32.81,Default,,0,0,0,,Жынданып кеткен жын құстар қалалар мен ауылдарға шабуыл жасауы мүмкін.
Dialogue: 0,0:13:32.81,0:13:35.14,Default,,0,0,0,,Осы жерде күтіңіз.
Dialogue: 0,0:13:37.44,0:13:40.82,Default,,0,0,0,,Мен оны тез шешемін. Уайымдама.
Dialogue: 0,0:13:40.82,0:13:43.15,Default,,0,0,0,,Иә, герцог.
Dialogue: 0,0:13:44.15,0:13:46.61,Default,,0,0,0,,Бұл дұрыс емес, Мелфи.
Dialogue: 0,0:13:47.61,0:13:49.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:49.62,0:13:51.99,Default,,0,0,0,,Сіз мені қалай атайсыз?
Dialogue: 0,0:13:54.62,0:13:57.00,Default,,0,0,0,,Қазірдің өзінде! А... Аристид-сама.
Dialogue: 0,0:13:57.00,0:14:00.46,Default,,0,0,0,,Неліктен мені ұятқа қалдырғанды ​​ұнатасың?
Dialogue: 0,0:14:00.46,0:14:03.63,Default,,0,0,0,,... Өтінемін, оларды тез жеңіп, қайт!
Dialogue: 0,0:14:03.63,0:14:05.84,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:14:05.84,0:14:08.64,Default,,0,0,0,,Мен сені мазалағым келмейді.
Dialogue: 0,0:14:08.64,0:14:11.64,Default,,0,0,0,,А... тосын шабуылдар жақсы емес!
Dialogue: 0,0:14:11.64,0:14:16.18,Default,,0,0,0,,Мелфи Герцогиня ретіндегі міндеттеріңіз есіңізде ме?
Dialogue: 0,0:14:16.18,0:14:21.02,Default,,0,0,0,,Герцогты құрметтеу және емдеу.
Dialogue: 0,0:14:21.02,0:14:23.36,Default,,0,0,0,,Дұрыс, ісінбе.
Dialogue: 0,0:14:23.36,0:14:27.03,Default,,0,0,0,,Сүйкімділігіңе жұбаттым.
Dialogue: 0,0:14:27.03,0:14:29.20,Default,,0,0,0,,Мені сәл кешіріңіз
Dialogue: 0,0:14:31.37,0:14:34.49,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:14:35.66,0:14:38.50,Default,,0,0,0,,Бұл шын болса да
Dialogue: 0,0:14:38.50,0:14:41.50,Default,,0,0,0,,Қайтып келгенде мені дәмді тамақпен сыйла.
Dialogue: 0,0:14:41.50,0:14:43.50,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:43.50,0:14:46.05,Default,,0,0,0,,Мен Роя Мудраның қалдығы қосылған бұқтырылған бұқтырманы жегім келеді.
Dialogue: 0,0:14:46.05,0:14:48.05,Default,,0,0,0,,Жоқ, мен саған кеше айтқан жоқпын ба? Лукако – нағыз жігіт.
Dialogue: 0,0:14:48.05,0:14:50.05,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:50.05,0:14:53.22,Default,,0,0,0,,Менің ойымша, қалыпты тағам жақсы болар еді.
Dialogue: 0,0:14:53.22,0:14:57.68,Default,,0,0,0,,Шынымен бе? Мен Бергенионмен барар едім, егер жақсы болса.
Dialogue: 0,0:14:57.68,0:15:01.23,Default,,0,0,0,,Мен ингредиенттерді іздеуге баруды ойласам, кенеттен мотивация пайда болады.
Dialogue: 0,0:15:01.23,0:15:04.52,Default,,0,0,0,,Ах... <Герцог қазір>
Dialogue: 0,0:15:04.52,0:15:09.24,Default,,0,0,0,,<Ол құбыжықтарды жегісі келетінін баса айтады>
Dialogue: 0,0:15:09.24,0:15:14.24,Default,,0,0,0,,<Егер сіз Бланштың отряды мен басқа рыцарьлардың алдында құбыжықтарды жегеніңізді мойындауға батыл болсаңыз>
Dialogue: 0,0:15:14.24,0:15:17.41,Default,,0,0,0,,<Олар да менің зерттеуімді қабылдауға бейім болады>
Dialogue: 0,0:15:17.41,0:15:19.91,Default,,0,0,0,,<Осылай ойлайсың...>
Dialogue: 0,0:15:22.92,0:15:26.09,Default,,0,0,0,,Сізді қызықтыратын құбыжықтар бар ма?
Dialogue: 0,0:15:26.09,0:15:28.42,Default,,0,0,0,,Мен оны саған алып келейін.
Dialogue: 0,0:15:29.22,0:15:33.43,Default,,0,0,0,,<Бірақ...бірақ үлкен жігіттер соншалықты ұятсыз, солай емес пе?>
Dialogue: 0,0:15:33.43,0:15:37.93,Default,,0,0,0,,＜Өйткені мен қазір есінен танып қалған Бергенионды бағындырамын＞
Dialogue: 0,0:15:37.93,0:15:42.23,Default,,0,0,0,,＜Бірақ... бірақ менің сөзімді қабыл алыңыз＞
Dialogue: 0,0:15:42.23,0:15:44.61,Default,,0,0,0,,Ал... содан кейін бұл
Dialogue: 0,0:15:44.61,0:15:47.07,Default,,0,0,0,,Скримвуд жемісі
Dialogue: 0,0:15:47.07,0:15:49.24,Default,,0,0,0,,Ах... (Хаос Мюран) Иә!?
Dialogue: 0,0:15:49.24,0:15:51.45,Default,,0,0,0,,А... мен жасадым!
Dialogue: 0,0:15:51.45,0:15:55.95,Default,,0,0,0,,Мен бұған дейін жеп, өкінген құбыжықтарымның бірі екеніне сенімдімін.
Dialogue: 0,0:15:55.95,0:15:59.62,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:15:59.62,0:16:01.79,Default,,0,0,0,,Бұл өте иіс болды.
Dialogue: 0,0:16:01.79,0:16:06.46,Default,,0,0,0,,Бірақ Муллан мырза бұл бал шырындарынан жақсырақ деп ойлаған сияқты.
Dialogue: 0,0:16:06.46,0:16:08.46,Default,,0,0,0,,, солай ма? Аа!?
Dialogue: 0,0:16:10.47,0:16:13.26,Default,,0,0,0,,Құрметті Мельфиера, мұны қайдан істедіңіз...
Dialogue: 0,0:16:13.26,0:16:15.97,Default,,0,0,0,,Бұл қыздың құпиясы
Dialogue: 0,0:16:15.97,0:16:20.48,Default,,0,0,0,,Муллан мырза, оның Скримвуд жемісі екеніне сенімдісіз бе?
Dialogue: 0,0:16:20.48,0:16:25.65,Default,,0,0,0,,Иә, тым піскен шығар, бірақ қара түсті.
Dialogue: 0,0:16:25.65,0:16:30.11,Default,,0,0,0,,Өте хош иісті, тәтті, балқыған бақыт.
Dialogue: 0,0:16:30.11,0:16:32.99,Default,,0,0,0,,Аузыңа тарады.
Dialogue: 0,0:16:34.66,0:16:38.12,Default,,0,0,0,,Мен көп жедім, тазартылған су да жұмыс істемеді.
Dialogue: 0,0:16:38.12,0:16:42.00,Default,,0,0,0,,Кейін мен қайғылы оқиғаға тап болдым.
Dialogue: 0,0:16:42.00,0:16:47.84,Default,,0,0,0,,<Неліктен бір жеміс болғанымен, әр түрлі адамдар жеміс туралы әртүрлі әсерде болады?>
Dialogue: 0,0:16:47.84,0:16:50.30,Default,,0,0,0,,<Бұл мені қызықтыратын нәрсе.>
Dialogue: 0,0:16:51.84,0:16:55.01,Default,,0,0,0,,Бұл шынымен де маңызды емес.
Dialogue: 0,0:16:55.01,0:16:59.68,Default,,0,0,0,,Ең бастысы, герцог пен оның достары аман-есен оралсын.
Dialogue: 0,0:16:59.68,0:17:02.85,Default,,0,0,0,,Хехе, түсіндім.
Dialogue: 0,0:17:02.85,0:17:05.31,Default,,0,0,0,,Тапсаңыз, қайтарыңыз.
Dialogue: 0,0:17:06.31,0:17:10.02,Default,,0,0,0,,Жарайды, күн батқанша қамалға барыңыз.
Dialogue: 0,0:17:14.70,0:17:18.53,Default,,0,0,0,,Бұл алдын ала төленеді.
Dialogue: 0,0:17:19.70,0:17:24.04,Default,,0,0,0,,Сіздің зерттеу материалдарыңыз мен пайдаланатын бөлмеге жеткізілді.
Dialogue: 0,0:17:24.04,0:17:27.88,Default,,0,0,0,,А... Бланш, маған кейінірек көрсет.
Dialogue: 0,0:17:27.88,0:17:29.88,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:35.72,0:17:37.72,Default,,0,0,0,,<Герцог...>
Dialogue: 0,0:17:37.72,0:17:41.35,Default,,0,0,0,,<Мырза. Аристид, аман болыңыз>
Dialogue: 0,0:17:46.19,0:17:49.90,Default,,0,0,0,,Қайырлы таң, Мельфиера-сама.
Dialogue: 0,0:17:49.90,0:17:52.57,Default,,0,0,0,,Сіз ұйықтай алмаған сияқтысыз.
Dialogue: 0,0:17:52.57,0:17:56.74,Default,,0,0,0,,Бұл кеше бізге табанды түрде шабуыл жасаған жын құс.
Dialogue: 0,0:17:56.74,0:18:00.74,Default,,0,0,0,,Оның үстіне бұл топ есінен танып қалған.
Dialogue: 0,0:18:00.74,0:18:05.91,Default,,0,0,0,,<Мен оны қайтадан бұлтты кристалмен жару туралы ойламаймын.>
Dialogue: 0,0:18:05.91,0:18:11.21,Default,,0,0,0,,<Роя Мудраның сиқырлы күші бар күші ғана қалды.>
Dialogue: 0,0:18:11.21,0:18:14.21,Default,,0,0,0,,<Сол сиқырлы күш күшті және көп мөлшерде>
Dialogue: 0,0:18:14.21,0:18:18.76,Default,,0,0,0,,<Егер ол жарылып кетсе, онда герцог пен басқалардың қатысы болуы мүмкін.>
Dialogue: 0,0:18:18.76,0:18:23.10,Default,,0,0,0,,<Ах, күту қандай мұң екен! ＞
Dialogue: 0,0:18:23.10,0:18:27.10,Default,,0,0,0,,Жарайды, жақын арада қайтасың.
Dialogue: 0,0:18:28.39,0:18:31.61,Default,,0,0,0,,Енді таңғы ас ішейік.
Dialogue: 0,0:18:31.61,0:18:36.24,Default,,0,0,0,,Ханшайым жоғары мәртебелі мырзаны көңілді күлімсіреп қарсы алуы керек.
Dialogue: 0,0:18:37.61,0:18:39.61,Default,,0,0,0,,Иә
Dialogue: 0,0:18:40.95,0:18:45.25,Default,,0,0,0,,Міне, Мәртебелі мырза кеше сізді аралап көрсетуімді өтінді.
Dialogue: 0,0:18:46.41,0:18:50.25,Default,,0,0,0,,Бұл ханшайымның бұдан былай пайдаланатын зерттеу бөлмесі.
Dialogue: 0,0:18:57.63,0:19:01.80,Default,,0,0,0,,<Оу, менің материалдарым ғана емес>
Dialogue: 0,0:19:01.80,0:19:05.97,Default,,0,0,0,,<Қызықты сиқырлы кітаптар мен әдебиеттер де бар>
Dialogue: 0,0:19:05.97,0:19:08.64,Default,,0,0,0,,<Бірақ неге екеніне таңғаламын>
Dialogue: 0,0:19:08.64,0:19:12.44,Default,,0,0,0,,<Мені қазір мүлде қызықтырмайды>
Dialogue: 0,0:19:14.82,0:19:20.15,Default,,0,0,0,,<Ақырында герцог сол күні қайтып оралмады.>
Dialogue: 0,0:19:38.84,0:19:42.18,Default,,0,0,0,,А... Мәртебелі қайтып келді!
Dialogue: 0,0:19:42.18,0:19:44.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:44.18,0:19:46.47,Default,,0,0,0,,Герцог!
Dialogue: 0,0:19:49.48,0:19:52.69,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:19:52.69,0:19:54.69,Default,,0,0,0,,Хаха
Dialogue: 0,0:19:59.49,0:20:01.49,Default,,0,0,0,,Аман болыңыз
Dialogue: 0,0:20:02.49,0:20:06.33,Default,,0,0,0,,Кәсібі: тыңшы
Dialogue: 0,0:20:06.33,0:20:08.33,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:20:09.33,0:20:11.50,Default,,0,0,0,,Мен кәдесый әкелдім.
Dialogue: 0,0:20:11.50,0:20:15.71,Default,,0,0,0,,Орманнан қызықты нәрсе табыңыз.
Dialogue: 0,0:20:15.71,0:20:18.21,Default,,0,0,0,,Скримвуд жемісі де бар.
Dialogue: 0,0:20:18.21,0:20:20.88,Default,,0,0,0,,Шынымен!? Ах!
Dialogue: 0,0:20:20.88,0:20:23.34,Default,,0,0,0,,Оны кейінірек бөлмеге апарыңыз
Dialogue: 0,0:20:23.34,0:20:26.51,Default,,0,0,0,,Бірақ бұған дейін
Dialogue: 0,0:20:26.51,0:20:28.51,Default,,0,0,0,,Аз ұйықта
Dialogue: 0,0:20:28.51,0:20:30.52,Default,,0,0,0,,Герцог?
Dialogue: 0,0:20:32.73,0:20:34.90,Default,,0,0,0,,Герцог?
Dialogue: 0,0:20:34.90,0:20:37.52,Default,,0,0,0,,(Ұйқыда)
Dialogue: 0,0:20:41.53,0:20:43.74,Default,,0,0,0,,Сонымен
Dialogue: 0,0:20:43.74,0:20:49.24,Default,,0,0,0,,Бұл герцог маған кәдесый ретінде сыйлаған Скримвуд туралы қауесет.
Dialogue: 0,0:20:49.24,0:20:53.75,Default,,0,0,0,,<Бұл герцогтың жегені шығар>
Dialogue: 0,0:20:53.75,0:20:57.75,Default,,0,0,0,,<Шынында да, сурет кітабында Скримвуд жемісі қызыл>
Dialogue: 0,0:20:57.75,0:21:02.76,Default,,0,0,0,,<Оның иісі өте жағымсыз, дәмі ащы болды>
Dialogue: 0,0:21:02.76,0:21:06.55,Default,,0,0,0,,Әзірше мына қызылды сыртта қалдырайық.
Dialogue: 0,0:21:06.55,0:21:08.76,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:21:17.44,0:21:19.61,Default,,0,0,0,,Уау...
Dialogue: 0,0:21:19.61,0:21:24.78,Default,,0,0,0,,Ханшайым, бұл жарқыраған сұйықтық сиқырлы ма?
Dialogue: 0,0:21:26.61,0:21:30.79,Default,,0,0,0,,<Бұл олжадан сиқырлы күш алу қиын>
Dialogue: 0,0:21:30.79,0:21:33.79,Default,,0,0,0,,<Жауап беруге уақытым жоқ>
Dialogue: 0,0:21:33.79,0:21:38.08,Default,,0,0,0,,<Жын ағашы толығымен қурап немесе күлге айналуы керек>
Dialogue: 0,0:21:38.08,0:21:40.46,Default,,0,0,0,,<Белгілі бір өлім келмейді>
Dialogue: 0,0:21:40.46,0:21:44.30,Default,,0,0,0,,<Бірақ, жеміс қурап қалса, оны жеуге болмайды.>
Dialogue: 0,0:21:44.30,0:21:48.30,Default,,0,0,0,,<Тірі кезінде сиқырлы күшті сору өте қиын>
Dialogue: 0,0:21:54.10,0:21:56.10,Default,,0,0,0,,О! (қол шапалақтау)
Dialogue: 0,0:21:58.94,0:22:04.32,Default,,0,0,0,,Сөйтсе де, сиқырды алып тастағаннан кейін оның мұндай жақсы иіс шығады деп күтпедім.
Dialogue: 0,0:22:04.32,0:22:07.49,Default,,0,0,0,,Капитандар жеген кезде басқаша болды ма?
Dialogue: 0,0:22:07.49,0:22:09.49,Default,,0,0,0,,Өте жағымсыз иіс шықты.
Dialogue: 0,0:22:09.49,0:22:13.12,Default,,0,0,0,,Иістің күшті болғаны сонша, сөз жетпейді.
Dialogue: 0,0:22:13.12,0:22:16.96,Default,,0,0,0,,Оның үстіне бәрі қара емес еді.
Dialogue: 0,0:22:16.96,0:22:20.13,Default,,0,0,0,,Сыртқа алып шыққаныммен бірдей болды.
Dialogue: 0,0:22:20.13,0:22:22.96,Default,,0,0,0,,Мені сырт келбетке алданған шығар...
Dialogue: 0,0:22:22.96,0:22:24.96,Default,,0,0,0,,Я~
Dialogue: 0,0:22:24.96,0:22:27.34,Default,,0,0,0,,<Сыртқы түрі тым қараңғы>
Dialogue: 0,0:22:27.34,0:22:29.84,Default,,0,0,0,,<Бұл өте тәбетті емес>
Dialogue: 0,0:22:29.84,0:22:31.97,Default,,0,0,0,,<Бірақ...>
Dialogue: 0,0:22:33.85,0:22:37.14,Default,,0,0,0,,<Иісі қатты, тістеп алғың келеді...>
Dialogue: 0,0:22:37.14,0:22:39.15,Default,,0,0,0,,<(үшін) Тәтті! ＞
Dialogue: 0,0:22:40.52,0:22:57.87,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:59.37,0:23:05.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
