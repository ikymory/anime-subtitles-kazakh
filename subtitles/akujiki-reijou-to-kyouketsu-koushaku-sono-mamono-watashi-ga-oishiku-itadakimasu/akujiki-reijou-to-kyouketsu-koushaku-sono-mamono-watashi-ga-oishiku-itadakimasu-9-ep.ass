Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.13,0:00:07.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:13.68,0:00:16.14,Default,,0,0,0,,Қамал қабырғаларының ішінде өріс бар...
Dialogue: 0,0:00:16.14,0:00:19.01,Default,,0,0,0,,Мал өсіретін фермалар да бар.
Dialogue: 0,0:00:20.31,0:00:26.02,Default,,0,0,0,,<Алыстан қарағанда бір үлкен қамал сияқты көрінетін>
Dialogue: 0,0:00:26.02,0:00:29.69,Default,,0,0,0,,<Мұқият қарасаң, ұқыпты қала>
Dialogue: 0,0:00:34.70,0:00:36.87,Default,,0,0,0,,<О? ＞
Dialogue: 0,0:00:36.87,0:00:41.33,Default,,0,0,0,,Герцог, Гэлбрейтте...
Dialogue: 0,0:00:41.33,0:00:44.71,Default,,0,0,0,,Анимистік ғимараттар жоқ па?
Dialogue: 0,0:00:44.71,0:00:49.04,Default,,0,0,0,,Анимизмнің өзі Гэлбрейтте дерлік ескірген.
Dialogue: 0,0:00:49.04,0:00:51.55,Default,,0,0,0,,Не? Тек
Dialogue: 0,0:00:51.55,0:00:54.34,Default,,0,0,0,,Монстр тағамы сенімге қарамастан
Dialogue: 0,0:00:54.34,0:00:58.35,Default,,0,0,0,,Ұзақ уақыт бойы аулақ болғанымен.
Dialogue: 0,0:00:58.35,0:01:03.18,Default,,0,0,0,,Құбыжықтарды жеуге қарсылық бар ғой, солай ма?
Dialogue: 0,0:01:03.18,0:01:06.73,Default,,0,0,0,,Не, рыцарьлар хабар таратуға кіріссін.
Dialogue: 0,0:01:09.36,0:01:14.90,Default,,0,0,0,,Гэлбрейт рыцарларының көпшілігі құбыжықтарды жеген.
Dialogue: 0,0:01:14.90,0:01:19.74,Default,,0,0,0,,Менің басымнан өткен қорқынышты оқиғалар туралы естеліктер тым жарқын болды.
Dialogue: 0,0:01:19.74,0:01:23.75,Default,,0,0,0,,Кейбір адамдар басында қарсылық көрсетуі мүмкін, бірақ
Dialogue: 0,0:01:23.75,0:01:25.75,Default,,0,0,0,,Уау
Dialogue: 0,0:01:25.75,0:01:28.08,Default,,0,0,0,,<Мен әлі кездескен жоқпын>
Dialogue: 0,0:01:28.08,0:01:31.09,Default,,0,0,0,,<Герцогты дірілдететін құбыжық>
Dialogue: 0,0:01:31.09,0:01:33.21,Default,,0,0,0,,<Мұнда адам көп>
Dialogue: 0,0:01:34.22,0:01:36.59,Default,,0,0,0,,<Мен оны тезірек жегім келеді! ＞
Dialogue: 0,0:01:38.09,0:01:40.10,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:09.85,0:03:13.31,Default,,0,0,0,,Хехехе
Dialogue: 0,0:03:13.31,0:03:15.69,Default,,0,0,0,,Мелфи Иә?
Dialogue: 0,0:03:15.69,0:03:18.86,Default,,0,0,0,,Менің багажымды тексеріңіз Иә.
Dialogue: 0,0:03:21.32,0:03:23.70,Default,,0,0,0,,<Ах, қарашы? ＞
Dialogue: 0,0:03:30.04,0:03:34.04,Default,,0,0,0,,<Мені айдаһар бақылап тұр ма? ＞
Dialogue: 0,0:03:36.50,0:03:39.05,Default,,0,0,0,,<Бұл басқаша көрінеді>
Dialogue: 0,0:03:40.51,0:03:43.05,Default,,0,0,0,,<Көріп тұрған нәрсе...>
Dialogue: 0,0:03:45.89,0:03:49.06,Default,,0,0,0,,<Корольдік мудраның тұздалған еті!?>
Dialogue: 0,0:03:49.06,0:03:54.06,Default,,0,0,0,,Иә, сен мұны жегің келеді (Гресшель айдаһар жылайды)
Dialogue: 0,0:03:54.06,0:03:58.53,Default,,0,0,0,,Герцог, сізден бір өтінішім бар. Не болды?
Dialogue: 0,0:03:58.53,0:04:03.36,Default,,0,0,0,,Герцогтың айдаһары Король мудрасын қалайтын сияқты.
Dialogue: 0,0:04:03.36,0:04:05.37,Default,,0,0,0,,Оны беруге бола ма?
Dialogue: 0,0:04:05.37,0:04:09.37,Default,,0,0,0,,Хмм... сыйлық па?
Dialogue: 0,0:04:09.37,0:04:13.75,Default,,0,0,0,,＜Алайда бұл өте жақсы Роя Мудра＞
Dialogue: 0,0:04:13.75,0:04:15.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:15.92,0:04:18.75,Default,,0,0,0,,(Гресшель айдаһар жылайды)
Dialogue: 0,0:04:18.75,0:04:20.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:20.76,0:04:25.26,Default,,0,0,0,,(Гресшель айдаһар жылайды)
Dialogue: 0,0:04:25.26,0:04:28.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:28.39,0:04:30.39,Default,,0,0,0,,Түсіндім, ахаха
Dialogue: 0,0:04:30.39,0:04:34.27,Default,,0,0,0,,Сол рыцарь айдаһар да Мәртебелі сияқты тойымпаз.
Dialogue: 0,0:04:34.27,0:04:37.77,Default,,0,0,0,,Асыл Роя мудра...
Dialogue: 0,0:04:40.57,0:04:44.28,Default,,0,0,0,,Қош келдіңіз, Мелфи, бұл менің сарайым.
Dialogue: 0,0:04:50.79,0:04:53.58,Default,,0,0,0,,Иә, бәлкім…
Dialogue: 0,0:04:54.58,0:04:58.79,Default,,0,0,0,,<Бұл тамақ қалдықтарын тастауға арналған бактерия.>
Dialogue: 0,0:04:59.80,0:05:02.97,Default,,0,0,0,,<Қанас сияқты жын балық болмаса да>
Dialogue: 0,0:05:02.97,0:05:05.59,Default,,0,0,0,,<Бұл балық дәмді ме? ＞
Dialogue: 0,0:05:06.59,0:05:09.30,Default,,0,0,0,,<Иә? ＞
Dialogue: 0,0:05:09.30,0:05:13.43,Default,,0,0,0,,<Су беті қызыл>
Dialogue: 0,0:05:15.14,0:05:17.31,Default,,0,0,0,,<Жоқ, олай емес>
Dialogue: 0,0:05:17.31,0:05:20.32,Default,,0,0,0,,<Тек менің айналам түсті>
Dialogue: 0,0:05:24.32,0:05:26.99,Default,,0,0,0,,<Не болды~!?>
Dialogue: 0,0:05:26.99,0:05:29.16,Default,,0,0,0,,<Себебі ол шашын дұрыс байлаған>
Dialogue: 0,0:05:29.16,0:05:33.33,Default,,0,0,0,,<Жылдатуды пайдаланған кезде таспа босап қалды>
Dialogue: 0,0:05:36.33,0:05:40.63,Default,,0,0,0,,<Мен әлі де осылай киінгеніме сене алар емеспін...>
Dialogue: 0,0:05:40.63,0:05:44.01,Default,,0,0,0,,<Бұл дұрыс емес...>
Dialogue: 0,0:05:44.01,0:05:46.84,Default,,0,0,0,,《Таныстыруға рұқсат етіңіз》 《Танысқаныма қуаныштымын》
Dialogue: 0,0:05:46.84,0:05:49.47,Default,,0,0,0,,...
Dialogue: 0,0:05:49.47,0:05:53.02,Default,,0,0,0,,《Аа~! 》 《Бұл арамдық үшін жаза! 》
Dialogue: 0,0:05:53.02,0:05:56.19,Default,,0,0,0,,<Жоқ, Мельфиера! ＞
Dialogue: 0,0:05:56.19,0:05:58.19,Default,,0,0,0,,<Бірақ мен не істеуім керек>
Dialogue: 0,0:05:58.19,0:06:02.19,Default,,0,0,0,,<Бұл сіздің қолыңызбен жасай алатын нәрсе емес.>
Dialogue: 0,0:06:02.19,0:06:05.49,Default,,0,0,0,,А... анау герцог.
Dialogue: 0,0:06:05.49,0:06:08.03,Default,,0,0,0,,Һм? Не болды?
Dialogue: 0,0:06:08.03,0:06:11.20,Default,,0,0,0,,Мен сізге бірнеше сұрақтар қойғым келеді.
Dialogue: 0,0:06:11.20,0:06:13.66,Default,,0,0,0,,Сізді мазалайтын нәрсе болды ма?
Dialogue: 0,0:06:13.66,0:06:16.50,Default,,0,0,0,,<Не? Герцог болса ше?
Dialogue: 0,0:06:16.50,0:06:19.50,Default,,0,0,0,,<Осы дөрекі шашқа алаңдамайсың ба? ＞
Dialogue: 0,0:06:19.50,0:06:22.88,Default,,0,0,0,,<Олай болса, оны сол күйінде қалдыру дұрыс па деп ойлаймын>
Dialogue: 0,0:06:22.88,0:06:25.88,Default,,0,0,0,,<Жоқ, жоқ, жоқ, Мельфиера! ＞
Dialogue: 0,0:06:25.88,0:06:30.05,Default,,0,0,0,,<Иә, герцогтың келіншегі болғандықтан басы маңызды>
Dialogue: 0,0:06:30.05,0:06:33.06,Default,,0,0,0,,<Батыл бол! ＞Иә?
Dialogue: 0,0:06:33.06,0:06:36.39,Default,,0,0,0,,О, сіз Bacta дейсіз бе?
Dialogue: 0,0:06:36.39,0:06:38.89,Default,,0,0,0,,Бұқтырғанда дәмді болады.
Dialogue: 0,0:06:38.89,0:06:42.90,Default,,0,0,0,,Жақсы! Ол сонымен қатар Маршалл Рейдінде өсірілді.
Dialogue: 0,0:06:42.90,0:06:44.90,Default,,0,0,0,,Мен оны бұрын ешқашан жеген емеспін.
Dialogue: 0,0:06:44.90,0:06:47.69,Default,,0,0,0,,Жедел тағам ретінде бағаланады.
Dialogue: 0,0:06:47.69,0:06:50.53,Default,,0,0,0,,Сіз оны қолданып көргіңіз келе ме? өтінемін!
Dialogue: 0,0:06:51.57,0:06:54.74,Default,,0,0,0,,＜Бұл дұрыс емес! ＞
Dialogue: 0,0:06:54.74,0:06:59.92,Default,,0,0,0,,Мен Bacta туралы айтып тұрған жоқпын, бірақ...
Dialogue: 0,0:06:59.92,0:07:02.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:02.04,0:07:07.05,Default,,0,0,0,,Баршаңызға сәлем бермес бұрын, өзімді қолға алғым келеді.
Dialogue: 0,0:07:07.05,0:07:11.05,Default,,0,0,0,,Мен дөрекі болады деп ойладым, бірақ ах!
Dialogue: 0,0:07:11.05,0:07:15.43,Default,,0,0,0,,Өзгеретін жер болса, оны қарызға алсам болады ма?
Dialogue: 0,0:07:15.43,0:07:19.23,Default,,0,0,0,,А... бұл герцог?
Dialogue: 0,0:07:19.23,0:07:21.94,Default,,0,0,0,,Мен... Кешіріңіз, Мелфи!
Dialogue: 0,0:07:21.94,0:07:24.94,Default,,0,0,0,,Не? Жоқ, бұл герцогтың кінәсі емес...
Dialogue: 0,0:07:24.94,0:07:28.44,Default,,0,0,0,,Сенің маған істегенің еш ойланбастан болды.
Dialogue: 0,0:07:28.44,0:07:32.24,Default,,0,0,0,,Хаос маған көп нәрсені айтқанымен.
Dialogue: 0,0:07:32.24,0:07:36.95,Default,,0,0,0,,Мулан Бұл төтенше жағдай! Ха!
Dialogue: 0,0:07:36.95,0:07:38.95,Default,,0,0,0,,Не істеді?
Dialogue: 0,0:07:38.95,0:07:41.96,Default,,0,0,0,,...
Dialogue: 0,0:07:41.96,0:07:46.63,Default,,0,0,0,,Call Blanche's team immediately! Сіз Бланш командасысыз ба?
Dialogue: 0,0:07:46.63,0:07:51.09,Default,,0,0,0,,Лиллиан, Сабрина, Натали, қазір кім болса да, асығыңыз!
Dialogue: 0,0:07:51.09,0:07:53.47,Default,,0,0,0,,Мен... түсіндім!
Dialogue: 0,0:07:57.97,0:08:01.48,Default,,0,0,0,,Мелфи Ол немқұрайлы адам еді және бұл менің кінәм еді.
Dialogue: 0,0:08:01.48,0:08:04.48,Default,,0,0,0,,Ал... бұл дұрыс емес.
Dialogue: 0,0:08:04.48,0:08:09.48,Default,,0,0,0,,Негізі мұнда саған қарайтын қызметшілер жоқ.
Dialogue: 0,0:08:09.48,0:08:12.65,Default,,0,0,0,,Ұзақ уақыт ерлердің шаруашылығы болды.
Dialogue: 0,0:08:12.65,0:08:19.29,Default,,0,0,0,,＜Сонымен, бұрынғы герцог Гэлбрейттің әйелі де мұнда жоқ деп ойлаймын＞
Dialogue: 0,0:08:20.29,0:08:24.12,Default,,0,0,0,,...
Dialogue: 0,0:08:24.12,0:08:30.30,Default,,0,0,0,,<Құбыжыққа қарағанда мұқият тыңдауым керек еді.>
Dialogue: 0,0:08:30.30,0:08:33.84,Default,,0,0,0,,Ха! Мелфи, кешіріңіз!
Dialogue: 0,0:08:33.84,0:08:36.85,Default,,0,0,0,,Мен саған төмен қарап тұрғаным жоқ! иә?
Dialogue: 0,0:08:36.85,0:08:40.52,Default,,0,0,0,,Гэлбрейт отбасында ресми герцогиня болғанына біраз уақыт болды.
Dialogue: 0,0:08:40.52,0:08:44.52,Default,,0,0,0,,А... Төрт ұрпақ қалмаған шығар.
Dialogue: 0,0:08:44.52,0:08:47.31,Default,,0,0,0,,...
Dialogue: 0,0:08:48.69,0:08:53.03,Default,,0,0,0,,<Жоқ, бұл менің күлетін кезім емес>
Dialogue: 0,0:08:53.03,0:08:55.03,Default,,0,0,0,,Хехехе
Dialogue: 0,0:09:02.16,0:09:04.33,Default,,0,0,0,,(Екеуі бірге күледі)
Dialogue: 0,0:09:08.71,0:09:11.88,Default,,0,0,0,,Бұл мен бұрын айтқан Бланш отряды.
Dialogue: 0,0:09:12.88,0:09:15.88,Default,,0,0,0,,Мельфиераның сөзі де менің сөзім.
Dialogue: 0,0:09:15.88,0:09:18.55,Default,,0,0,0,,Барлығы, сақ болыңдар, ха!
Dialogue: 0,0:09:20.72,0:09:23.35,Default,,0,0,0,,Менің атым Бланш Лезэбль.
Dialogue: 0,0:09:23.35,0:09:26.56,Default,,0,0,0,,...
Dialogue: 0,0:09:26.56,0:09:28.56,Default,,0,0,0,,Ол... мен?
Dialogue: 0,0:09:28.56,0:09:31.07,Default,,0,0,0,,<Әй... Мен таң қалдым>
Dialogue: 0,0:09:31.07,0:09:35.36,Default,,0,0,0,,<Мен біреудің әйел рыцарь екеніне сене алмаймын>
Dialogue: 0,0:09:35.36,0:09:39.07,Default,,0,0,0,,Аа, енді олай емес. Капитан: Иә?
Dialogue: 0,0:09:39.07,0:09:43.91,Default,,0,0,0,,Сіз Мельфиера-сама ханымға қоңырау шалуды шешкен жоқсыз ба?
Dialogue: 0,0:09:43.91,0:09:45.91,Default,,0,0,0,,Айтыңыз.
Dialogue: 0,0:09:45.91,0:09:50.92,Default,,0,0,0,,Мұндай жас әрі әдемі жас аруды әйелім деп айту ескілік емес пе?
Dialogue: 0,0:09:50.92,0:09:53.21,Default,,0,0,0,,Мен капитанмен келісемін!
Dialogue: 0,0:09:53.21,0:09:56.22,Default,,0,0,0,,Ханшайым жақсырақ!
Dialogue: 0,0:09:57.76,0:09:59.76,Default,,0,0,0,,Кохон
Dialogue: 0,0:09:59.76,0:10:01.93,Default,,0,0,0,,Маған Мелфиера деп қоңырау шалыңыз.
Dialogue: 0,0:10:01.93,0:10:07.23,Default,,0,0,0,,Мұндағы әдет-ғұрып пен тұрмысты түсінгеніңіз үшін көп рахмет.
Dialogue: 0,0:10:09.40,0:10:13.11,Default,,0,0,0,,Түсіндім, Мелфиера ханшайым.
Dialogue: 0,0:10:14.11,0:10:18.61,Default,,0,0,0,,Сәлеметсіз бе, бұл капитанның орынбасары Натали Шаал.
Dialogue: 0,0:10:19.61,0:10:22.78,Default,,0,0,0,,Бұл Лилиан, Баронета де Сентьенің қызы.
Dialogue: 0,0:10:22.78,0:10:26.12,Default,,0,0,0,,Ханшайым, маған не қалайтыныңды айтшы.
Dialogue: 0,0:10:26.12,0:10:28.12,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:10:28.12,0:10:30.42,Default,,0,0,0,,Blanche Yeah?
Dialogue: 0,0:10:30.42,0:10:33.96,Default,,0,0,0,,Мельфиера бейтаныс рейсті аяқтады.
Dialogue: 0,0:10:33.96,0:10:36.26,Default,,0,0,0,,Біріншіден, мен сіздің шаршағаныңызды емдеуіңізді қалаймын.
Dialogue: 0,0:10:36.26,0:10:38.80,Default,,0,0,0,,Түсіндім, Мәртебелі.
Dialogue: 0,0:10:38.80,0:10:41.26,Default,,0,0,0,,Ал, герцог.
Dialogue: 0,0:10:41.26,0:10:45.81,Default,,0,0,0,,Басқалармен қашан сәлемдесуім керек?
Dialogue: 0,0:10:45.81,0:10:50.15,Default,,0,0,0,,Кешкі ас жақсы емес пе?
Dialogue: 0,0:10:50.15,0:10:53.82,Default,,0,0,0,,Түсіндім, кешіріңіз.
Dialogue: 0,0:10:53.82,0:10:57.44,Default,,0,0,0,,Ах, мен Хаосты біраз уақыттан кейін жіберемін.
Dialogue: 0,0:11:04.16,0:11:06.16,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:11:06.16,0:11:09.00,Default,,0,0,0,,Герцог, бәрінің көзінше!
Dialogue: 0,0:11:09.00,0:11:11.67,Default,,0,0,0,,Хаха, ұялма
Dialogue: 0,0:11:11.67,0:11:15.67,Default,,0,0,0,,Менің бөлмем көрші, сондықтан сізді алаңдататын мәселелер болса, маған кез келген уақытта келуге болады.
Dialogue: 0,0:11:15.67,0:11:17.67,Default,,0,0,0,,(есік ашылады)
Dialogue: 0,0:11:17.67,0:11:21.68,Default,,0,0,0,,Мельфиера-сама, уақыт келді Ах, иә!
Dialogue: 0,0:11:22.68,0:11:27.02,Default,,0,0,0,,Жоғары мәртебелі, мен Chaos көмекшісінің жоқтығына қуаныштымын.
Dialogue: 0,0:11:27.02,0:11:30.02,Default,,0,0,0,,Не!? Сіз де хаос минионысыз ба?
Dialogue: 0,0:11:30.02,0:11:32.31,Default,,0,0,0,,Мұны хаос көмекшісіне айтыңыз.
Dialogue: 0,0:11:32.31,0:11:36.69,Default,,0,0,0,,Әй... тоқта, Мюран! Мен тәттілер жасаймын!
Dialogue: 0,0:11:36.69,0:11:38.69,Default,,0,0,0,,<Уф~>
Dialogue: 0,0:11:38.69,0:11:43.32,Default,,0,0,0,,<Герцог менің әрекетімнен ләззат алады, солай емес пе?>
Dialogue: 0,0:11:45.03,0:11:47.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:49.50,0:11:52.50,Default,,0,0,0,,<Қандай сүйкімді бөлме>
Dialogue: 0,0:11:57.50,0:11:59.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:59.71,0:12:03.89,Default,,0,0,0,,Қалай болды? Ах... мм...
Dialogue: 0,0:12:03.89,0:12:07.89,Default,,0,0,0,,Капитан Бланш, менің аяқ киімім лас.
Dialogue: 0,0:12:07.89,0:12:11.52,Default,,0,0,0,,Мен мына үлпілдек кілемге дақ түсіретін сияқтымын.
Dialogue: 0,0:12:11.52,0:12:15.90,Default,,0,0,0,,Түсіндім. Енді кешіріңіз.
Dialogue: 0,0:12:17.73,0:12:19.73,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:27.24,0:12:30.08,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:12:30.08,0:12:33.25,Default,,0,0,0,,Бұл не? Бұл жай ғана таңғы ас.
Dialogue: 0,0:12:34.25,0:12:38.25,Default,,0,0,0,,Ханшайым мысықтай жеңіл.
Dialogue: 0,0:12:38.25,0:12:40.26,Default,,0,0,0,,Пия!
Dialogue: 0,0:12:40.26,0:12:45.26,Default,,0,0,0,,<Бұл түс пе!? Юйю... Арман болса да, жүрегіме ауыр тиді! ＞
Dialogue: 0,0:12:45.26,0:12:47.93,Default,,0,0,0,,Жүр, ханшайым, аяғыңды мында қой.
Dialogue: 0,0:12:47.93,0:12:51.56,Default,,0,0,0,,Жарайды! Мен оны өзім шеше аламын
Dialogue: 0,0:12:51.56,0:12:56.27,Default,,0,0,0,,<Осы үшін адамдар керемет>
Dialogue: 0,0:12:56.27,0:12:59.40,Default,,0,0,0,,<Керемет адамдар! ＞
Dialogue: 0,0:12:59.40,0:13:05.28,Default,,0,0,0,,Ханшайым, сіздің сүйікті тәттілеріңіз бар ма? иә?
Dialogue: 0,0:13:05.28,0:13:07.57,Default,,0,0,0,,Ум...
Dialogue: 0,0:13:07.57,0:13:11.41,Default,,0,0,0,,Мен бұл сезімге өте қуаныштымын.
Dialogue: 0,0:13:11.41,0:13:16.29,Default,,0,0,0,,Қымбат уақытыңызды алғаным үшін кешіріңіз, қалғанын өзім істеймін...
Dialogue: 0,0:13:16.29,0:13:18.79,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:13:18.79,0:13:24.97,Default,,0,0,0,,Біздің команда, Бланш, ханшайымның серуендейтін серілері болу құрметіне ие болды.
Dialogue: 0,0:13:24.97,0:13:29.14,Default,,0,0,0,,Біз ханшайымның қылышы мен қалқанымыз.
Dialogue: 0,0:13:32.97,0:13:36.44,Default,,0,0,0,,Осылай ойланыңыз.
Dialogue: 0,0:13:41.61,0:13:43.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:43.61,0:13:46.99,Default,,0,0,0,,Бізге рыцарь құрметін бер.
Dialogue: 0,0:13:46.99,0:13:48.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:56.16,0:13:58.63,Default,,0,0,0,,<Қандай әдемі>
Dialogue: 0,0:13:59.83,0:14:01.84,Default,,0,0,0,,<Бұл мөр...>
Dialogue: 0,0:14:10.47,0:14:15.02,Default,,0,0,0,,Сіз герцог таңдаған рыцарьларсыз.
Dialogue: 0,0:14:15.02,0:14:19.48,Default,,0,0,0,,Жалғыз ғана сенімге лайық деп есептеймін.
Dialogue: 0,0:14:19.48,0:14:24.86,Default,,0,0,0,,Бірақ мен сіз туралы әлі ештеңе білмеймін.
Dialogue: 0,0:14:24.86,0:14:28.86,Default,,0,0,0,,Сіз де нағыз мені танымайтын шығарсыз.
Dialogue: 0,0:14:30.49,0:14:32.49,Default,,0,0,0,,А... ештеңе білмейтін адамға
Dialogue: 0,0:14:32.49,0:14:36.50,Default,,0,0,0,,Рыцарьдың өмірі болған қылышты берме.
Dialogue: 0,0:14:36.50,0:14:38.67,Default,,0,0,0,,Мен мұны саған қайтарамын.
Dialogue: 0,0:14:43.50,0:14:46.38,Default,,0,0,0,,Сіз қауесеттер туралы білесіз бе?
Dialogue: 0,0:14:48.22,0:14:53.05,Default,,0,0,0,,Менің герцогпен уәдем бар.
Dialogue: 0,0:14:53.05,0:14:55.06,Default,,0,0,0,,Мен мұнда келгенше
Dialogue: 0,0:14:55.06,0:14:59.69,Default,,0,0,0,,Мен Гэлбрейтте не істеуім керек екенін түсіндім.
Dialogue: 0,0:14:59.69,0:15:03.69,Default,,0,0,0,,Сонымен капитан Бланш, бұл әлі емес...
Dialogue: 0,0:15:05.23,0:15:10.07,Default,,0,0,0,,Рыцарьдың абыройы мені қожайын деп таниды.
Dialogue: 0,0:15:10.07,0:15:13.53,Default,,0,0,0,,Қылышымды ұсынамын деп көрсем
Dialogue: 0,0:15:23.08,0:15:26.25,Default,,0,0,0,,Түсіндім, Мельфиера-сама.
Dialogue: 0,0:15:26.25,0:15:30.55,Default,,0,0,0,,Біз де сізге қолайлы рыцарь бола алуымыз үшін.
Dialogue: 0,0:15:30.55,0:15:32.93,Default,,0,0,0,,Біз бар күшімізді саламыз
Dialogue: 0,0:15:32.93,0:15:36.26,Default,,0,0,0,,Рахмет, капитан Бланш.
Dialogue: 0,0:15:39.93,0:15:42.73,Default,,0,0,0,,Мм... Капитан Бланш
Dialogue: 0,0:15:42.73,0:15:48.44,Default,,0,0,0,,Ол қылышты герцогтың қылышын жасаған адам жасады ма?
Dialogue: 0,0:15:48.44,0:15:50.74,Default,,0,0,0,,Не? А... иә
Dialogue: 0,0:15:50.74,0:15:54.95,Default,,0,0,0,,Ол Мидрейгтегі темір ұстасының шеберханасында соғылған.
Dialogue: 0,0:15:54.95,0:15:57.29,Default,,0,0,0,,Мен де...
Dialogue: 0,0:15:57.29,0:16:01.58,Default,,0,0,0,,Мен өз пышағымды алғым келеді. иә?
Dialogue: 0,0:16:01.58,0:16:03.58,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:16:03.58,0:16:08.13,Default,,0,0,0,,Сізді капитан Бланшпен таныстыра алмайсыз ба?
Dialogue: 0,0:16:08.13,0:16:10.13,Default,,0,0,0,,Қ-қараңыз… ол…
Dialogue: 0,0:16:10.13,0:16:12.30,Default,,0,0,0,,Өтінемін! Уф...
Dialogue: 0,0:16:14.14,0:16:16.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:17.47,0:16:21.14,Default,,0,0,0,,Ал, шебердің аты ғана!
Dialogue: 0,0:16:25.77,0:16:28.48,Default,,0,0,0,,Шашыңызды тарауды маған қалдырыңыз.
Dialogue: 0,0:16:28.48,0:16:31.15,Default,,0,0,0,,Жоқ, тіпті қазір де, егер рұқсат етсеңіз…
Dialogue: 0,0:16:32.78,0:16:34.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:36.99,0:16:39.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:39.33,0:16:42.16,Default,,0,0,0,,Сол ханшайым
Dialogue: 0,0:16:42.16,0:16:45.79,Default,,0,0,0,,Осы қарқынмен тарақпен өте алмаймын деп ойлаймын.
Dialogue: 0,0:16:45.79,0:16:49.17,Default,,0,0,0,,Азғында ұят жоқ.
Dialogue: 0,0:16:49.17,0:16:51.34,Default,,0,0,0,,Міне, солай...
Dialogue: 0,0:16:53.01,0:16:58.35,Default,,0,0,0,,Ханшайым? Ах... ммм...
Dialogue: 0,0:16:58.35,0:17:03.18,Default,,0,0,0,,Мүмкін болса, мен оны үлпілдек еткім келеді. Үлпілдек пе?
Dialogue: 0,0:17:03.18,0:17:10.19,Default,,0,0,0,,Мм... менің үлпілдеген шашым герцогке ұнаған сияқты.
Dialogue: 0,0:17:10.19,0:17:13.82,Default,,0,0,0,,Жоғары мәртебелі мұндай әрекетке қалай қол жеткізді?
Dialogue: 0,0:17:14.86,0:17:18.32,Default,,0,0,0,,Түсінемін, бұл маңызды миссия!
Dialogue: 0,0:17:18.32,0:17:21.16,Default,,0,0,0,,Ju… маңызды миссия
Dialogue: 0,0:17:21.16,0:17:23.71,Default,,0,0,0,,Орындалатын маңызды элементтер
Dialogue: 0,0:17:23.71,0:17:28.54,Default,,0,0,0,,Бальзаммен босаңсыған соң, жұмсақ болу үшін жақсылап шайыңыз!
Dialogue: 0,0:17:30.88,0:17:35.05,Default,,0,0,0,,Рыцарьға бұл жағдайды жібергенім үшін кешірім сұраймын.
Dialogue: 0,0:17:35.05,0:17:37.72,Default,,0,0,0,,Уайымдайтын ештеңе жоқ
Dialogue: 0,0:17:37.72,0:17:41.72,Default,,0,0,0,,Қызым кішкентай кезінде шашын тарайтынмын.
Dialogue: 0,0:17:41.72,0:17:44.73,Default,,0,0,0,,Дұрыс, иә.
Dialogue: 0,0:17:46.19,0:17:48.35,Default,,0,0,0,,<Қызым? ＞
Dialogue: 0,0:17:48.35,0:17:51.19,Default,,0,0,0,,<Капитан Бланш үйленді ме!?>
Dialogue: 0,0:17:51.19,0:17:53.19,Default,,0,0,0,,Иә? мм...
Dialogue: 0,0:17:53.19,0:17:55.36,Default,,0,0,0,,О... балаларыңыз бар ма?
Dialogue: 0,0:17:55.36,0:17:58.20,Default,,0,0,0,,Иә, менің екі қызым, бір ұлым бар.
Dialogue: 0,0:17:58.20,0:18:00.20,Default,,0,0,0,,<Екеуің де!?>
Dialogue: 0,0:18:05.08,0:18:07.58,Default,,0,0,0,,Менің қызым маған ұқсайды
Dialogue: 0,0:18:07.58,0:18:11.92,Default,,0,0,0,,Рыцарь боламын дейді, әкесін мұңайып.
Dialogue: 0,0:18:11.92,0:18:16.76,Default,,0,0,0,,Хехе, менің ойымша, әйел рыцарьлар керемет.
Dialogue: 0,0:18:16.76,0:18:18.76,Default,,0,0,0,,Әрине мен
Dialogue: 0,0:18:18.76,0:18:21.93,Default,,0,0,0,,Мен Гэлбрейт рыцары болғанымды мақтан тұтамын.
Dialogue: 0,0:18:21.93,0:18:27.60,Default,,0,0,0,,Сонымен қатар мен мұнда рыцарь болу қаншалықты қиын екенін білемін.
Dialogue: 0,0:18:27.60,0:18:33.78,Default,,0,0,0,,Сонда да ханшайым семсер... ас құралдарын алып жүре ала ма?
Dialogue: 0,0:18:33.78,0:18:37.40,Default,,0,0,0,,Иә, құбыжықтарды соттауымыз керек.
Dialogue: 0,0:18:37.40,0:18:41.62,Default,,0,0,0,,Бұл не... жеуге арналған?
Dialogue: 0,0:18:41.62,0:18:44.62,Default,,0,0,0,,Тамақтану, әрине.
Dialogue: 0,0:18:45.79,0:18:49.62,Default,,0,0,0,,Бұл қарым-қатынас герцогтың құбыжықтарды жегісі келгендіктен.
Dialogue: 0,0:18:49.62,0:18:52.63,Default,,0,0,0,,Сіздің айтқаныңыздан басталды.
Dialogue: 0,0:18:55.63,0:18:57.97,Default,,0,0,0,,Натали-сан...
Dialogue: 0,0:18:57.97,0:19:01.80,Default,,0,0,0,,Менің жұмыс құралдарым менің багажымда.
Dialogue: 0,0:19:01.80,0:19:05.27,Default,,0,0,0,,Пломба сынған, мен оны саған ашып бере аламын ба?
Dialogue: 0,0:19:05.27,0:19:07.43,Default,,0,0,0,,Иә
Dialogue: 0,0:19:08.64,0:19:10.65,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:10.65,0:19:13.65,Default,,0,0,0,,Ол көп қолданылған.
Dialogue: 0,0:19:13.65,0:19:18.44,Default,,0,0,0,,Қырылған пышақ бастапқы жүзден бір өлшемге кішірек емес пе?
Dialogue: 0,0:19:18.44,0:19:22.66,Default,,0,0,0,,Бұл сүйектерді кесуге және етті қыруға арналған.
Dialogue: 0,0:19:22.66,0:19:25.16,Default,,0,0,0,,Мм... Ханшайым...
Dialogue: 0,0:19:25.16,0:19:29.29,Default,,0,0,0,,Сіз шынымен құбыжықтарды жей аласыз ба? Ах...
Dialogue: 0,0:19:29.29,0:19:32.67,Default,,0,0,0,,Идиот! Бұлай сұрау дөрекі болар еді!
Dialogue: 0,0:19:32.67,0:19:35.46,Default,,0,0,0,,А, жоқ, мен мүлде жоқпын.
Dialogue: 0,0:19:35.46,0:19:40.17,Default,,0,0,0,,Құбыжықтарды жеу, әрине, өте алаңдатады, солай емес пе?
Dialogue: 0,0:19:40.17,0:19:42.47,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:19:51.31,0:19:56.86,Default,,0,0,0,,Міне, мен құбыжықтарды жеуге келдім.
Dialogue: 0,0:19:56.86,0:19:59.49,Default,,0,0,0,,Керемет! Бұл солай болды!
Dialogue: 0,0:19:59.49,0:20:03.87,Default,,0,0,0,,Адамдар маған тамақ ішуге рұқсат бермейді, өйткені олар қорқынышты нәрсе жасайды.
Dialogue: 0,0:20:03.87,0:20:08.70,Default,,0,0,0,,Әлі ерте. Мен әрқашан экспедицияларда боламын, Лилиан!
Dialogue: 0,0:20:08.70,0:20:10.87,Default,,0,0,0,,Герцог рұқсат берсе
Dialogue: 0,0:20:10.87,0:20:15.21,Default,,0,0,0,,Мен Роя Мудра мен Ханасқа да қызмет ете аламын.
Dialogue: 0,0:20:16.21,0:20:20.21,Default,,0,0,0,,Ханшайым құбыжықтар шынымен дәмді!
Dialogue: 0,0:20:20.21,0:20:23.72,Default,,0,0,0,,А... да... Кешіріңіз!
Dialogue: 0,0:20:23.72,0:20:26.51,Default,,0,0,0,,Лиллиан, артқа тұр! Бірақ...
Dialogue: 0,0:20:26.51,0:20:30.89,Default,,0,0,0,,Лиллиан! Ах... ммм...
Dialogue: 0,0:20:30.89,0:20:33.06,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:20:35.06,0:20:37.90,Default,,0,0,0,,Күте тұрыңыз, Лилиан.
Dialogue: 0,0:20:37.90,0:20:40.07,Default,,0,0,0,,Жасың нешеде?
Dialogue: 0,0:20:40.07,0:20:42.53,Default,,0,0,0,,Биыл 15 жасқа толды.
Dialogue: 0,0:20:42.53,0:20:46.37,Default,,0,0,0,,Гэлбрейт 15 жасында ересек адамға айналады ма?
Dialogue: 0,0:20:46.37,0:20:49.37,Default,,0,0,0,,Жоқ, мен 17 жаста ересекпін.
Dialogue: 0,0:20:49.37,0:20:55.08,Default,,0,0,0,,Бірақ ол рыцарь ретінде танылды, сондықтан ол қазірдің өзінде жақсы ересек!
Dialogue: 0,0:20:55.08,0:20:57.92,Default,,0,0,0,,<Бұл қиын жас.>
Dialogue: 0,0:21:00.25,0:21:03.38,Default,,0,0,0,,＜Бірақ мен оны өте жақсы түсінемін＞
Dialogue: 0,0:21:05.09,0:21:07.93,Default,,0,0,0,,Лилиан Иә.
Dialogue: 0,0:21:07.93,0:21:12.27,Default,,0,0,0,,Құбыжықтар дәмді ме, жоқ па, менімен бірге көргің келе ме?
Dialogue: 0,0:21:12.27,0:21:14.77,Default,,0,0,0,,Ах... е...
Dialogue: 0,0:21:14.77,0:21:16.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:16.77,0:21:18.77,Default,,0,0,0,,Капитан Бланш пен Натали де
Dialogue: 0,0:21:18.77,0:21:20.94,Default,,0,0,0,,Сіз бізге қосылғыңыз келе ме? Аа!?
Dialogue: 0,0:21:20.94,0:21:25.57,Default,,0,0,0,,Сіз жегіңіз келетін құбыжық бар ма? Мейлі ол жын хайуан болсын, жын балығы болсын, жын ағашы болсын.
Dialogue: 0,0:21:25.57,0:21:28.95,Default,,0,0,0,,Әй, жын жәндіктердің біртүрлі түрі жақсы!
Dialogue: 0,0:21:28.95,0:21:31.29,Default,,0,0,0,,Енді не істейміз?
Dialogue: 0,0:21:31.29,0:21:34.79,Default,,0,0,0,,Иә, ханшайым! Иә, Лилиан!
Dialogue: 0,0:21:34.79,0:21:38.42,Default,,0,0,0,,Мен Скримвуд жемісін жегім келеді.
Dialogue: 0,0:21:38.42,0:21:40.59,Default,,0,0,0,,Скрим Ву Вуд!?
Dialogue: 0,0:21:40.59,0:21:44.97,Default,,0,0,0,,Сіз мәртебелі мәртебелі құлықсыз деп айттыңыз, бірақ капитан Мулан...
Dialogue: 0,0:21:44.97,0:21:48.59,Default,,0,0,0,,《Өте хош иісті, тәтті және шырынды болды》
Dialogue: 0,0:21:48.59,0:21:52.97,Default,,0,0,0,,``Мен ешқашан мұндай дәмді жемістің дәмін татқан емеспін!''
Dialogue: 0,0:21:52.97,0:21:59.44,Default,,0,0,0,,А, бірақ содан кейін капитан Мулан іші ауырып, ыстығы көтеріліп ұйықтап қалды...
Dialogue: 0,0:22:00.44,0:22:04.82,Default,,0,0,0,,Бұл жақсы жемістің балшырындарынан да дәмді екенін айтты.
Dialogue: 0,0:22:04.82,0:22:06.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:06.99,0:22:09.99,Default,,0,0,0,,Тіркелмеген Арнайы Сынып па?
Dialogue: 0,0:22:09.99,0:22:13.33,Default,,0,0,0,,Хош иісті, тәтті және шырынды?
Dialogue: 0,0:22:13.33,0:22:17.62,Default,,0,0,0,,Нектардан дәмді ме, сол жоғары сапалы жеміс?
Dialogue: 0,0:22:18.62,0:22:21.84,Default,,0,0,0,,Көрінбейтін Скримвуд
Dialogue: 0,0:22:21.84,0:22:25.47,Default,,0,0,0,,Егер мен де осындай нәрсені естісем, мен де естір едім.
Dialogue: 0,0:22:25.47,0:22:28.84,Default,,0,0,0,,Мен де жасап көргім келеді!
Dialogue: 0,0:22:28.84,0:22:31.64,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:22:31.64,0:22:34.64,Default,,0,0,0,,Ааа, мен оны көргім келеді!
Dialogue: 0,0:22:34.64,0:22:37.64,Default,,0,0,0,,Тамақ ішейік! Кеттік, ханшайым!
Dialogue: 0,0:22:37.64,0:22:40.19,Default,,0,0,0,,Бұл мүлде ақау…
Dialogue: 0,0:22:41.19,0:22:53.87,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:55.37,0:23:01.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
