Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.07,0:00:14.90,Default,,0,0,0,,Мәртебелі
Dialogue: 0,0:00:15.53,0:00:16.98,Default,,0,0,0,,Сөздеріңізге келсек,
Dialogue: 0,0:00:17.49,0:00:19.36,Default,,0,0,0,,Тіпті Алланың өзі саған бет бұрмаса да
Dialogue: 0,0:00:19.86,0:00:24.20,Default,,0,0,0,,Ұлттың өмір сүруіне... немесе тіпті әлемге әсер ететін үлкен оқиға.
Dialogue: 0,0:00:24.87,0:00:26.79,Default,,0,0,0,,Есепті күтіп отыруға болатыны сонша.
Dialogue: 0,0:00:27.12,0:00:29.46,Default,,0,0,0,,Мен де кәрі емеспін.
Dialogue: 0,0:00:29.91,0:00:30.92,Default,,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 0,0:00:31.67,0:00:33.33,Default,,0,0,0,,Ауырсын
Dialogue: 0,0:00:33.71,0:00:36.92,Default,,0,0,0,,Жоқ, бұл біздің мырзамыз.
Dialogue: 0,0:00:55.31,0:00:57.02,Default,,0,0,0,,Бұдан былай, біз
Dialogue: 0,0:00:57.15,0:01:01.24,Default,,0,0,0,,Көтеріліс үш батыл шіркеу Рим Папасы Bisca T. Balmas және
Dialogue: 0,0:01:01.36,0:01:03.32,Default,,0,0,0,,Банды бағындырыңыз
Dialogue: 0,0:01:03.66,0:01:04.62,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:05.16,0:01:06.37,Default,,0,0,0,,Кету
Dialogue: 0,0:01:06.70,0:01:08.04,Default,,0,0,0,,Ат тарту
Dialogue: 0,0:01:08.33,0:01:10.50,Default,,0,0,0,,Ооо
Dialogue: 0,0:01:11.96,0:01:15.88,Default,,0,0,0,,Күте тұрыңыз, Қалқан батыры.
Dialogue: 0,0:01:16.63,0:01:17.67,Default,,0,0,0,,Балқытылған
Dialogue: 0,0:01:36.19,0:01:39.11,Default,,0,0,0,,Жетілдірілген топтық қорғаныс сиқыры
Dialogue: 0,0:01:39.78,0:01:41.44,Default,,0,0,0,,Собор
Dialogue: 0,0:01:41.57,0:01:46.07,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:02:13.85,0:02:15.10,Default,,0,0,0,,Найзағай қылыш
Dialogue: 0,0:02:15.35,0:02:16.56,Default,,0,0,0,,Найзағай түсіру
Dialogue: 0,0:02:22.03,0:02:23.49,Default,,0,0,0,,Фиро Рафталия
Dialogue: 0,0:02:23.65,0:02:24.82,Default,,0,0,0,,Иә
Dialogue: 0,0:02:29.33,0:02:30.99,Default,,0,0,0,,Кеттік
Dialogue: 0,0:02:33.75,0:02:35.62,Default,,0,0,0,,Жырт!
Dialogue: 0,0:02:38.08,0:02:39.29,Default,,0,0,0,,Гуааа…
Dialogue: 0,0:02:41.92,0:02:43.59,Default,,0,0,0,,Сол адамды емде
Dialogue: 0,0:02:43.97,0:02:45.55,Default,,0,0,0,,Цвейт өкшесі
Dialogue: 0,0:02:52.26,0:02:54.02,Default,,0,0,0,,Фиро тағы да
Dialogue: 0,0:02:54.18,0:02:55.23,Default,,0,0,0,,Yes
Dialogue: 0,0:02:55.35,0:02:56.27,Default,,0,0,0,,Мотоясу да
Dialogue: 0,0:02:56.85,0:02:58.48,Default,,0,0,0,,Иә? Уау...
Dialogue: 0,0:02:58.81,0:02:59.90,Default,,0,0,0,,Мотоясу мырза
Dialogue: 0,0:03:00.52,0:03:02.11,Default,,0,0,0,,Zweit Aqua Shell
Dialogue: 0,0:03:02.82,0:03:03.99,Default,,0,0,0,,Кя!
Dialogue: 0,0:03:04.86,0:03:06.03,Default,,0,0,0,,(Менің айқайларым)
Dialogue: 0,0:03:06.15,0:03:07.95,Default,,0,0,0,,Әпке, қарамаңыз
Dialogue: 0,0:03:08.95,0:03:12.08,Default,,0,0,0,,(Наофуми) Мотоясу Папаға жақындасаңыз, маған шабуыл жасаңыз.
Dialogue: 0,0:03:12.24,0:03:14.29,Default,,0,0,0,,(Мотоясу) Иә? Не дейсіз... (Наофуми) Жүрейік.
Dialogue: 0,0:03:15.29,0:03:16.79,Default,,0,0,0,,Уау
Dialogue: 0,0:03:17.79,0:03:19.75,Default,,0,0,0,,(Наофуми) Енді (Мотоясу) түсіндім.
Dialogue: 0,0:03:19.88,0:03:20.75,Default,,0,0,0,,Тааа!
Dialogue: 0,0:03:23.00,0:03:25.09,Default,,0,0,0,,Субару, бірдеңе дұрыс емес пе?
Dialogue: 0,0:03:35.43,0:03:36.35,Default,,0,0,0,,Фу…
Dialogue: 0,0:03:37.14,0:03:39.02,Default,,0,0,0,,Сол қарғыс әп-сәтте
Dialogue: 0,0:03:39.23,0:03:42.73,Default,,0,0,0,,(Рим Папасы) Бұл собордың ішінде қарғыс айтудың мағынасы жоқ.
Dialogue: 0,0:03:42.86,0:03:47.90,Default,,0,0,0,,Бұл Құдай жарылқаған қасиетті орын.
Dialogue: 0,0:03:52.03,0:03:53.87,Default,,0,0,0,,(Наофуми) Уау... (Мотоясу) Уау!
Dialogue: 0,0:03:54.33,0:03:55.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:56.91,0:03:58.33,Default,,0,0,0,,Қандай күш!
Dialogue: 0,0:03:59.62,0:04:01.54,Default,,0,0,0,,Сіз мені ести аласыз ба? епископ
Dialogue: 0,0:04:02.38,0:04:06.96,Default,,0,0,0,,Бізге Алланың ұлылығын көрсету үшін барлығынан көбірек дұға керек.
Dialogue: 0,0:04:07.63,0:04:10.38,Default,,0,0,0,,(Дін қызметкері) Қазірдің өзінде халықтың 30% -на жақын ...
Dialogue: 0,0:04:10.51,0:04:12.55,Default,,0,0,0,,Мен сиқырлы күшімнің шегіне жеттім.
Dialogue: 0,0:04:13.30,0:04:16.35,Default,,0,0,0,,Егер мен оны бұдан былай қолдансам, өміріме қауіп төнуі мүмкін.
Dialogue: 0,0:04:16.60,0:04:18.60,Default,,0,0,0,,Мәселе бар ма?
Dialogue: 0,0:04:19.64,0:04:22.73,Default,,0,0,0,,Бұл Құдай мен шайтан арасындағы шайқас
Dialogue: 0,0:04:22.86,0:04:24.48,Default,,0,0,0,,Мұнда шейіт болу...
Dialogue: 0,0:04:24.61,0:04:30.15,Default,,0,0,0,,Бұл саньюу сектасының сенушілері үшін ең үлкен құрмет емес пе?
Dialogue: 0,0:04:30.45,0:04:31.91,Default,,0,0,0,,Сендер не істеп жатырсыңдар?!
Dialogue: 0,0:04:33.66,0:04:37.66,Default,,0,0,0,,Барлығы, Рим Папасына дұға тілейміз
Dialogue: 0,0:04:39.21,0:04:41.92,Default,,0,0,0,,Маған иман келтіріп, маған ергендерге
Dialogue: 0,0:04:42.04,0:04:43.75,Default,,0,0,0,,Қалайша бұлай айта алар едің?
Dialogue: 0,0:04:43.96,0:04:47.13,Default,,0,0,0,,Бірақ олардың сенің соңынан еретініне сенімдімін.
Dialogue: 0,0:04:47.34,0:04:51.05,Default,,0,0,0,,​​(Рим Папасы) Иә, олар мен мен бір рухтамыз.
Dialogue: 0,0:04:51.51,0:04:53.14,Default,,0,0,0,,Олардың дұғаларының күші...
Dialogue: 0,0:04:53.26,0:04:56.06,Default,,0,0,0,,Қасиетті қарудың ең күшті техникасымен...
Dialogue: 0,0:04:56.18,0:05:00.06,Default,,0,0,0,,Мен сені толық тазартуға жетелеймін.
Dialogue: 0,0:05:00.73,0:05:04.90,Default,,0,0,0,,Бұл – Алланың шексіз рақымы.
Dialogue: 0,0:05:06.07,0:05:08.19,Default,,0,0,0,,Мен өзімді нашар сезінемін.
Dialogue: 0,0:05:08.73,0:05:10.32,Default,,0,0,0,,Ол сиқырлы қуатты сақтайды.
Dialogue: 0,0:05:10.95,0:05:14.57,Default,,0,0,0,,Егер нұр сол аспанға таралса...
Dialogue: 0,0:05:14.95,0:05:17.70,Default,,0,0,0,,Бұл керемет техника келе жатыр дегенді білдіре ме?
Dialogue: 0,0:05:17.95,0:05:21.41,Default,,0,0,0,,Эй, біз бірдеңе істей алмаймыз ба? сенің қалқаның
Dialogue: 0,0:05:21.66,0:05:22.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:22.62,0:05:25.67,Default,,0,0,0,,(Мотоясу) Өйткені қалқаныңыз алдамшыға ұқсайды.
Dialogue: 0,0:05:25.88,0:05:27.92,Default,,0,0,0,,(Наофуми) Жарайды, (Цуки) Бұл рас.
Dialogue: 0,0:05:29.26,0:05:32.72,Default,,0,0,0,,Олар бізден төмен деңгейде болса да, олар әдеттегідей шайқаса алады...
Dialogue: 0,0:05:32.84,0:05:34.47,Default,,0,0,0,,Сол қалқанның арқасында, солай емес пе?
Dialogue: 0,0:05:34.59,0:05:37.81,Default,,0,0,0,,(Наофуми) Жігіттер, қаруларыңызды барынша пайдаланбайсыз.
Dialogue: 0,0:05:38.60,0:05:40.64,Default,,0,0,0,,Арнайы дағдылар бар ма?
Dialogue: 0,0:05:40.77,0:05:42.23,Default,,0,0,0,,Ондай нәрсе бар...
Dialogue: 0,0:05:43.52,0:05:44.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:46.15,0:05:47.19,Default,,0,0,0,,Не?
Dialogue: 0,0:05:49.53,0:05:50.48,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:51.03,0:05:53.53,Default,,0,0,0,,Қарғыс сериясының қалқаны - қарғыстың күші.
Dialogue: 0,0:05:54.41,0:05:56.12,Default,,0,0,0,,Оны енді қолданбаңыз
Dialogue: 0,0:05:57.49,0:05:58.58,Default,,0,0,0,,Наофуми?
Dialogue: 0,0:06:04.79,0:06:08.13,Default,,0,0,0,,Бұл өте ақымақтық, бірақ бұл жігіт болса, немесе...
Dialogue: 0,0:06:08.50,0:06:09.88,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:06:11.42,0:06:13.51,Default,,0,0,0,,Бұл тағы да күш?
Dialogue: 0,0:06:14.26,0:06:15.09,Default,,0,0,0,,Иә
Dialogue: 0,0:06:15.80,0:06:19.31,Default,,0,0,0,,Бұрын бәрі жақсы еді, бұл жолы да оралуға болады.
Dialogue: 0,0:06:20.18,0:06:22.60,Default,,0,0,0,,Иә мен сенемін
Dialogue: 0,0:06:22.93,0:06:24.89,Default,,0,0,0,,(Фило) Иә, Фило да.
Dialogue: 0,0:06:37.70,0:06:42.12,Default,,0,0,0,,(Шірік Айдаһар) Мені қамытымнан босатқаныңыз үшін рахмет.
Dialogue: 0,0:06:42.24,0:06:43.29,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:44.25,0:06:47.46,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:06:47.75,0:06:50.50,Default,,0,0,0,,Уау
Dialogue: 0,0:06:50.84,0:06:54.76,Default,,0,0,0,,(Шірік айдаһар) Ашуға берілсең, қиналмайсың.
Dialogue: 0,0:06:55.93,0:06:58.18,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:06:59.76,0:07:01.51,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:07:04.64,0:07:08.85,Default,,0,0,0,,Саған... ашуыңа...
Dialogue: 0,0:07:09.10,0:07:12.27,Default,,0,0,0,,Бояу скучно ма?
Dialogue: 0,0:07:12.40,0:07:17.15,Default,,0,0,0,,(Шірік айдаһар) Ол ашу менікі... Бұл тек айдаһардың ашуы емес.
Dialogue: 0,0:07:17.28,0:07:20.24,Default,,0,0,0,,Ішіңізден шыққан нәрсе
Dialogue: 0,0:07:20.87,0:07:21.74,Default,,0,0,0,,(Присцилла) Сол тәрбиесіз шлюхаға—
Dialogue: 0,0:07:28.00,0:07:29.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:30.21,0:07:32.17,Default,,0,0,0,,Тыныштық ашуы
Dialogue: 0,0:07:32.46,0:07:33.55,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:34.00,0:07:37.42,Default,,0,0,0,,Ашу ұят пен қорлыққа толы
Dialogue: 0,0:07:38.47,0:07:39.55,Default,,0,0,0,,Уау
Dialogue: 0,0:07:39.68,0:07:41.80,Default,,0,0,0,,(Фурю) Маған өзімді түсіндіруге де мүмкіндік болмады...
Dialogue: 0,0:07:41.93,0:07:45.56,Default,,0,0,0,,Біржақты басылған ашу
Dialogue: 0,0:07:46.23,0:07:49.27,Default,,0,0,0,,Мұның бәрі сіздің ашуыңыз
Dialogue: 0,0:07:50.10,0:07:51.61,Default,,0,0,0,,Сіз сонша жау жинап алатыныңыз шын мәнінде ауыртпалық.
Dialogue: 0,0:07:51.90,0:07:54.44,Default,,0,0,0,,Бұрынғы ашу мен жек көрушілік
Dialogue: 0,0:07:54.57,0:07:56.53,Default,,0,0,0,,Барлығын түкіріп тастаңыз
Dialogue: 0,0:07:57.24,0:07:58.49,Default,,0,0,0,,Барлығы
Dialogue: 0,0:08:00.82,0:08:04.70,Default,,0,0,0,,(Шірік айдаһар) Болған ашу-ызаңызды шығарыңыз
Dialogue: 0,0:08:04.83,0:08:08.00,Default,,0,0,0,,Мен саған сол билікті беремін.
Dialogue: 0,0:08:08.16,0:08:09.67,Default,,0,0,0,,Қуат…
Dialogue: 0,0:08:09.96,0:08:10.92,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:11.21,0:08:14.21,Default,,0,0,0,,Бұл жігіттің сөзіне алданып қалмаңыз.
Dialogue: 0,0:08:14.46,0:08:15.63,Default,,0,0,0,,(Каибуки) Егер Эрезерхед қарсылық білдірмесе—
Dialogue: 0,0:08:15.75,0:08:17.88,Default,,0,0,0,,Бұл тәтті емес пе?
Dialogue: 0,0:08:19.97,0:08:22.05,Default,,0,0,0,,От пен қарғыстың күші
Dialogue: 0,0:08:22.22,0:08:26.47,Default,,0,0,0,,Қарсы жақты бағындыру және бағындыру.
Dialogue: 0,0:08:27.43,0:08:29.69,Default,,0,0,0,,Ыңғайлы емес пе?
Dialogue: 0,0:08:29.81,0:08:31.90,Default,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:08:33.06,0:08:34.32,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:35.48,0:08:38.24,Default,,0,0,0,,Ашуланыңыз және күш іздеңіз
Dialogue: 0,0:08:38.36,0:08:41.82,Default,,0,0,0,,Оның бәрін өртеп жібер.
Dialogue: 0,0:08:42.74,0:08:44.16,Default,,0,0,0,,Өрт...
Dialogue: 0,0:08:45.87,0:08:47.54,Default,,0,0,0,,Барлығы
Dialogue: 0,0:08:49.41,0:08:52.25,Default,,0,0,0,,Жақсы, жақсы, адам.
Dialogue: 0,0:08:52.46,0:08:56.38,Default,,0,0,0,,Жек көрушілік сонша, тіпті мен де таң қалдым.
Dialogue: 0,0:08:56.50,0:08:57.80,Default,,0,0,0,,Кукукукук…
Dialogue: 0,0:08:57.92,0:09:01.59,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:09:06.22,0:09:07.72,Default,,0,0,0,,Сәлем Наофуми
Dialogue: 0,0:09:08.85,0:09:12.23,Default,,0,0,0,,(Мотоясу) Ол шынымен де қалқан шайтанға айналды деп ойламаймын.
Dialogue: 0,0:09:14.77,0:09:16.02,Default,,0,0,0,,Наофуми-сама
Dialogue: 0,0:09:23.95,0:09:24.95,Default,,0,0,0,,Өртеп жіберейік
Dialogue: 0,0:09:26.74,0:09:29.08,Default,,0,0,0,,Бәрін өртеп жібер, сонда бәрі бітеді
Dialogue: 0,0:09:29.20,0:09:30.33,Default,,0,0,0,,Наофуми-сама
Dialogue: 0,0:09:30.79,0:09:35.13,Default,,0,0,0,,Тек ашуыңыз бәрін жоюға мүмкіндік беріңіз
Dialogue: 0,0:09:35.25,0:09:36.79,Default,,0,0,0,,Мастер
Dialogue: 0,0:09:37.13,0:09:39.51,Default,,0,0,0,,Қазір менде бұл күш бар.
Dialogue: 0,0:09:40.05,0:09:41.67,Default,,0,0,0,,Осы күшпен мен...
Dialogue: 0,0:09:41.97,0:09:43.38,Default,,0,0,0,,Наофуми
Dialogue: 0,0:09:43.72,0:09:47.01,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:09:50.56,0:09:52.14,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:09:52.27,0:09:54.27,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:09:54.65,0:09:57.31,Default,,0,0,0,,(Фило) Сіз шынымен бәрін жек көресіз бе, ұстаз?
Dialogue: 0,0:09:57.86,0:09:58.90,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:59.19,0:10:01.15,Default,,0,0,0,,Не? Бұл дауыс
Dialogue: 0,0:10:02.11,0:10:05.74,Default,,0,0,0,,Біздің саяхатымыз мағынасыз болды ма?
Dialogue: 0,0:10:06.07,0:10:07.07,Default,,0,0,0,,Саяхаттау?
Dialogue: 0,0:10:09.16,0:10:11.54,Default,,0,0,0,,Басында мен қатты қорықтым.
Dialogue: 0,0:10:11.79,0:10:15.25,Default,,0,0,0,,Мен бұл адам да маған зат сияқты қарады деп ойладым.
Dialogue: 0,0:10:16.21,0:10:19.25,Default,,0,0,0,,Бірақ сен мені бағаладың, маған қамқор болдың.
Dialogue: 0,0:10:19.84,0:10:22.30,Default,,0,0,0,,Ол маған қатты ұрысып, мені қорғады.
Dialogue: 0,0:10:22.46,0:10:24.93,Default,,0,0,0,,Сондықтан мен бұл кісінің жанында болуға ант бердім.
Dialogue: 0,0:10:25.47,0:10:26.76,Default,,0,0,0,,Фиро Хане
Dialogue: 0,0:10:26.89,0:10:30.60,Default,,0,0,0,,Күйеуім мені туылғаннан бері тәрбиелеп келеді.
Dialogue: 0,0:10:31.27,0:10:33.81,Default,,0,0,0,,Көңілді, қызықты және арбалар...
Dialogue: 0,0:10:33.93,0:10:36.06,Default,,0,0,0,,Маған барлығын қожайыным берді.
Dialogue: 0,0:10:36.19,0:10:39.40,Default,,0,0,0,,Фиро маған жақсы көретіннің бәрін берді.
Dialogue: 0,0:10:42.28,0:10:44.53,Default,,0,0,0,,Қыңыр және басқалардың айтқанын тыңдамайды...
Dialogue: 0,0:10:44.65,0:10:46.20,Default,,0,0,0,,Жай әзіл
Dialogue: 0,0:10:46.66,0:10:49.62,Default,,0,0,0,,Бірақ сен уәде еткендей сөзіңді орындадың...
Dialogue: 0,0:10:49.99,0:10:54.37,Default,,0,0,0,,Маған ханшайым емес, адам сияқты қарағаны үшін.
Dialogue: 0,0:10:54.71,0:10:55.91,Default,,0,0,0,,Мен бақытты болдым
Dialogue: 0,0:10:58.83,0:10:59.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:01.25,0:11:04.42,Default,,0,0,0,,Дұрыс, мен саяхаттап жүрмін
Dialogue: 0,0:11:05.34,0:11:06.63,Default,,0,0,0,,Маңызды
Dialogue: 0,0:11:07.30,0:11:10.01,Default,,0,0,0,,Достарыммен қандай жағдайда да қорғауға ант бердім
Dialogue: 0,0:11:11.47,0:11:13.06,Default,,0,0,0,,Наофуми көңілсіз...
Dialogue: 0,0:11:13.18,0:11:16.44,Default,,0,0,0,,Мен сіздің не ойлайтыныңызды жиі білмеймін
Dialogue: 0,0:11:16.60,0:11:19.35,Default,,0,0,0,,Бізге көңіл бөлетініңді.
Dialogue: 0,0:11:19.77,0:11:21.27,Default,,0,0,0,,Ол анық жеткізілген.
Dialogue: 0,0:11:22.07,0:11:24.44,Default,,0,0,0,,Мен сізді жақсы көремін, ұстаз.
Dialogue: 0,0:11:24.78,0:11:27.28,Default,,0,0,0,,Сондықтан шебердің жағымсыз сезімдері
Dialogue: 0,0:11:27.40,0:11:29.11,Default,,0,0,0,,Фиро оны жейді.
Dialogue: 0,0:11:30.41,0:11:33.91,Default,,0,0,0,,Мен Наофумидің азабын өз мүмкіндігімше қабылдаймын.
Dialogue: 0,0:11:34.79,0:11:38.58,Default,,0,0,0,,Мен Наофуми-саманың қайғысын аяқтаймын.
Dialogue: 0,0:11:38.71,0:11:41.13,Default,,0,0,0,,Мен Наофуми-саманың қылышымын.
Dialogue: 0,0:11:48.38,0:11:49.64,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:51.18,0:11:53.01,Default,,0,0,0,,Наофуми-сама (Наофуми) Ах...
Dialogue: 0,0:11:56.23,0:11:57.52,Default,,0,0,0,,Мен оны қажетсіз өлуіне жол бермеймін!
Dialogue: 0,0:11:58.10,0:12:01.44,Default,,0,0,0,,Қайта оралғаныңызға қуаныштымын.
Dialogue: 0,0:12:01.56,0:12:03.15,Default,,0,0,0,,Мастер
Dialogue: 0,0:12:03.61,0:12:06.86,Default,,0,0,0,,Тым көп күш жұмсамаңыз, жарай ма?
Dialogue: 0,0:12:07.40,0:12:09.82,Default,,0,0,0,,Кешіріңіз, мен сізбен тағы да сөйлесуім керек ...
Dialogue: 0,0:12:09.95,0:12:11.49,Default,,0,0,0,,Қате емес
Dialogue: 0,0:12:13.08,0:12:15.12,Default,,0,0,0,,Наофуми-сама таңдаған жол...
Dialogue: 0,0:12:15.45,0:12:18.79,Default,,0,0,0,,Біздің саяхатымыз қате емес
Dialogue: 0,0:12:22.96,0:12:24.21,Default,,0,0,0,,Рафталия
Dialogue: 0,0:12:24.96,0:12:27.09,Default,,0,0,0,,Ұстаздың жағымсыз сезімдері
Dialogue: 0,0:12:27.21,0:12:29.42,Default,,0,0,0,,Фиро оны қайта-қайта жейді.
Dialogue: 0,0:12:30.09,0:12:31.13,Default,,0,0,0,,Фиро
Dialogue: 0,0:12:31.26,0:12:34.05,Default,,0,0,0,,Білгеннен кейін жоспар құрыңыз.
Dialogue: 0,0:12:34.30,0:12:36.56,Default,,0,0,0,,Біз әлі шайқастың ортасындамыз.
Dialogue: 0,0:12:36.72,0:12:38.60,Default,,0,0,0,,Түсіндім, Мелти.
Dialogue: 0,0:12:38.77,0:12:39.64,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:40.94,0:12:43.90,Default,,0,0,0,,(Цуки) Алдыңғы толқын сияқты қашып кеткен жағдай...
Dialogue: 0,0:12:44.06,0:12:45.98,Default,,0,0,0,,Бұлай емес сияқты.
Dialogue: 0,0:12:46.69,0:12:48.11,Default,,0,0,0,,Бұл бала қазірге дейін қоғамнан оқшауланған ғой, иә?
Dialogue: 0,0:12:48.28,0:12:49.49,Default,,0,0,0,,Ынтымақтастық?
Dialogue: 0,0:12:49.95,0:12:51.66,Default,,0,0,0,,(Наофуми) Өтінемін (3 адам) Ах...
Dialogue: 0,0:12:52.41,0:12:55.99,Default,,0,0,0,,Наофуми-саннан мұндай сөздерді естігенде таң қалдым.
Dialogue: 0,0:12:56.83,0:12:58.00,Default,,0,0,0,,Біз жеңе аламыз ба?
Dialogue: 0,0:12:58.20,0:12:59.37,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:12:59.79,0:13:01.00,Default,,0,0,0,,Бірақ бұл тұрарлық
Dialogue: 0,0:13:01.46,0:13:02.29,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:02.42,0:13:05.75,Default,,0,0,0,,Мен әу бастан бірге күресу керектігін айттым.
Dialogue: 0,0:13:06.21,0:13:07.17,Default,,0,0,0,,Мотоясу
Dialogue: 0,0:13:07.30,0:13:09.05,Default,,0,0,0,,Уф... мен...
Dialogue: 0,0:13:11.22,0:13:13.59,Default,,0,0,0,,Жарайды, мен мұны істеймін.
Dialogue: 0,0:13:13.97,0:13:17.43,Default,,0,0,0,,Біз достық пен байланыстың жеңетінін дәлелдеуіміз керек.
Dialogue: 0,0:13:18.10,0:13:20.56,Default,,0,0,0,,Хехехе... Ах...
Dialogue: 0,0:13:23.40,0:13:26.27,Default,,0,0,0,,(Папа) Бұл жерде қандай да бір қулық бар сияқты...
Dialogue: 0,0:13:26.40,0:13:27.98,Default,,0,0,0,,Дайын
Dialogue: 0,0:13:28.40,0:13:31.45,Default,,0,0,0,,Осымен мен сенімен қоштасамын, Қалқан Ібіліс.
Dialogue: 0,0:13:37.08,0:13:39.16,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,0:13:39.66,0:13:41.91,Default,,0,0,0,,Қалқан шайтан қанша болса да
Dialogue: 0,0:13:42.04,0:13:45.71,Default,,0,0,0,,Соборға толық шабуылды тоқтата алу.
Dialogue: 0,0:13:45.92,0:13:48.50,Default,,0,0,0,,Күшті билік бағаны талап етеді.
Dialogue: 0,0:13:49.80,0:13:54.38,Default,,0,0,0,,Егер сенің илаһи құдіретіңнің бағасы мүміндер болса...
Dialogue: 0,0:13:54.97,0:13:57.35,Default,,0,0,0,,Сіздің жалғыз өміріңіз арзан.
Dialogue: 0,0:13:57.97,0:13:58.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:59.47,0:14:01.22,Default,,0,0,0,,Бұл қалқан!
Dialogue: 0,0:14:01.89,0:14:02.73,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:14:03.06,0:14:03.94,Default,,0,0,0,,Иә
Dialogue: 0,0:14:04.35,0:14:05.27,Default,,0,0,0,,О
Dialogue: 0,0:14:06.48,0:14:07.98,Default,,0,0,0,,Найзағай түсіру
Dialogue: 0,0:14:12.90,0:14:14.20,Default,,0,0,0,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,0:14:14.36,0:14:15.70,Default,,0,0,0,,Жел көрсеткі
Dialogue: 0,0:14:18.33,0:14:20.04,Default,,0,0,0,,Цвейт Аквашот
Dialogue: 0,0:14:20.16,0:14:21.87,Default,,0,0,0,,Zweit Air Shot
Dialogue: 0,0:14:22.33,0:14:23.66,Default,,0,0,0,,Жауға мүмкіндік берме
Dialogue: 0,0:14:25.37,0:14:26.21,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:26.33,0:14:27.96,Default,,0,0,0,,Кеттік
Dialogue: 0,0:14:29.04,0:14:29.96,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:14:30.96,0:14:32.42,Default,,0,0,0,,Дәл сол трюк жұмыс істемейді
Dialogue: 0,0:14:33.47,0:14:34.72,Default,,0,0,0,,Біз азғынбыз.
Dialogue: 0,0:14:35.09,0:14:35.93,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,0:14:37.14,0:14:38.51,Default,,0,0,0,,Метеорлы қылыш
Dialogue: 0,0:14:41.72,0:14:42.56,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:42.68,0:14:45.85,Default,,0,0,0,,(Наофуми) Рен мен Рафталия жақын шайқаста жаудың көзқарасын бөгеу керек.
Dialogue: 0,0:14:46.02,0:14:47.35,Default,,0,0,0,,Осы арада…
Dialogue: 0,0:14:47.69,0:14:49.31,Default,,0,0,0,,Zweit Power
Dialogue: 0,0:14:51.57,0:14:53.82,Default,,0,0,0,,Наофумидің өтініші бойынша.
Dialogue: 0,0:14:54.49,0:14:55.65,Default,,0,0,0,,Қияметсіз...
Dialogue: 0,0:14:56.28,0:14:58.62,Default,,0,0,0,,Бұл ашуды жеуді доғар
Dialogue: 0,0:14:58.74,0:15:00.37,Default,,0,0,0,,Әуе найзасы
Dialogue: 0,0:15:06.75,0:15:08.29,Default,,0,0,0,,(Рим Папасы) Уа! (Мотоясу) Ах!
Dialogue: 0,0:15:08.42,0:15:11.42,Default,,0,0,0,,(Наофуми) «Достық пен байланыс жеңеді»?
Dialogue: 0,0:15:12.17,0:15:14.92,Default,,0,0,0,,Уайымдама, ашуланайық.
Dialogue: 0,0:15:17.01,0:15:20.68,Default,,0,0,0,,Әр жерді қасиетті отпен тазарт
Dialogue: 0,0:15:21.30,0:15:23.22,Default,,0,0,0,,Феникс жүзі
Dialogue: 0,0:15:29.65,0:15:33.07,Default,,0,0,0,,Фиро қалқанның қаһарманына, қуат көзін бұйырады.
Dialogue: 0,0:15:33.28,0:15:37.53,Default,,0,0,0,,Ақиқатты тағы бір рет түсіндіріп, жалын жеп, оны күшке айналдыр.
Dialogue: 0,0:15:38.49,0:15:40.78,Default,,0,0,0,,Қаһарлы өрт
Dialogue: 0,0:15:51.88,0:15:53.09,Default,,0,0,0,,Гуа!
Dialogue: 0,0:15:53.84,0:15:55.01,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:15:55.13,0:15:57.05,Default,,0,0,0,,(Цуки) Бірден осылай (Рен) Ах
Dialogue: 0,0:16:00.47,0:16:02.93,Default,,0,0,0,,Эй, күте тұр, бірдеңе...
Dialogue: 0,0:16:03.10,0:16:04.68,Default,,0,0,0,,Кездейсоқ күш
Dialogue: 0,0:16:05.27,0:16:07.23,Default,,0,0,0,,Жанқиярлық
Dialogue: 0,0:16:08.89,0:16:09.77,Default,,0,0,0,,Не!?
Dialogue: 0,0:16:12.90,0:16:14.44,Default,,0,0,0,,Уау
Dialogue: 0,0:16:14.69,0:16:15.53,Default,,0,0,0,,Мотоясу
Dialogue: 0,0:16:15.73,0:16:16.99,Default,,0,0,0,,Шынында да, бұл жігіт жақсы адам болуы мүмкін, білесің бе?
Dialogue: 0,0:16:19.91,0:16:21.49,Default,,0,0,0,,Grrrr... (қабылдау дыбысы)
Dialogue: 0,0:16:21.62,0:16:24.37,Default,,0,0,0,,Ах... бұл найзамен ойнау шеберлігі.
Dialogue: 0,0:16:24.49,0:16:25.66,Default,,0,0,0,,​​Бұл қарсы әдіс.
Dialogue: 0,0:16:26.79,0:16:31.17,Default,,0,0,0,,(Рен) Мен бұл қарумен тіпті озық дағдыларды қолдана аламын ба?
Dialogue: 0,0:16:31.88,0:16:34.96,Default,,0,0,0,,Құдайға қарсы шығу – өлімге әкелетін күнә
Dialogue: 0,0:16:35.21,0:16:37.13,Default,,0,0,0,,Тазартуда жылы
Dialogue: 0,0:16:47.10,0:16:48.35,Default,,0,0,0,,Уау
Dialogue: 0,0:16:53.11,0:16:54.19,Default,,0,0,0,,Не?
Dialogue: 0,0:17:06.28,0:17:07.41,Default,,0,0,0,,Гррр…
Dialogue: 0,0:17:08.58,0:17:10.12,Default,,0,0,0,,(Папаның күлкісі)
Dialogue: 0,0:17:10.25,0:17:11.79,Default,,0,0,0,,(Экхарт) Кторигалга басып кірген бейбітшілікке қарсы күштер—
Dialogue: 0,0:17:12.12,0:17:13.75,Default,,0,0,0,,Келме
Dialogue: 0,0:17:14.25,0:17:16.34,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,0:17:16.46,0:17:17.96,Default,,0,0,0,,Эй!
Dialogue: 0,0:17:18.09,0:17:21.42,Default,,0,0,0,,Жоқ, тоқтат, тоқта.
Dialogue: 0,0:17:23.14,0:17:25.64,Default,,0,0,0,,Тәтті... бұл не деген сұмдық?
Dialogue: 0,0:17:26.39,0:17:28.31,Default,,0,0,0,,(Наофуми) Бұл... елес.
Dialogue: 0,0:17:29.02,0:17:31.89,Default,,0,0,0,,Маған қандай да бір шеберлік елесін көрсетіп жатыр.
Dialogue: 0,0:17:34.06,0:17:37.77,Default,,0,0,0,,(Рим Папасы) Құдайдың мейірімінен ізі қалмаған ең үлкен үмітсіздік
Dialogue: 0,0:17:38.19,0:17:40.65,Default,,0,0,0,,Бұл иллюзияға ұшыраңыз
Dialogue: 0,0:17:41.15,0:17:42.95,Default,,0,0,0,,Бәрің, мықты болыңдар... Уф...
Dialogue: 0,0:17:43.41,0:17:45.07,Default,,0,0,0,,Наофуми-сама, аа...
Dialogue: 0,0:17:45.82,0:17:46.99,Default,,0,0,0,,Рафталия
Dialogue: 0,0:17:54.67,0:17:57.84,Default,,0,0,0,,Күлін қалдырмай, толық жою
Dialogue: 0,0:17:58.00,0:18:01.21,Default,,0,0,0,,Мен сізге оның бар екеніне ешқандай дәлел қалдыруға рұқсат бермеймін.
Dialogue: 0,0:18:07.10,0:18:10.10,Default,,0,0,0,,Биліктің көзі патшайымның бұйрығымен
Dialogue: 0,0:18:10.35,0:18:12.39,Default,,0,0,0,,Ақиқатты тағы бір рет түсіну
Dialogue: 0,0:18:12.56,0:18:15.98,Default,,0,0,0,,Бұл адамды мұздатылған торда ұстаңыз және оны ұстаңыз.
Dialogue: 0,0:18:16.23,0:18:19.32,Default,,0,0,0,,Al Dreyfa Icicle түрмесі
Dialogue: 0,0:18:21.74,0:18:22.78,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:18:23.53,0:18:24.49,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:24.86,0:18:26.03,Default,,0,0,0,,О...
Dialogue: 0,0:18:30.29,0:18:31.41,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:18:32.75,0:18:33.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:34.50,0:18:38.17,Default,,0,0,0,,Собор арқылы сиқырлы күш өте ала ма?
Dialogue: 0,0:18:38.59,0:18:40.13,Default,,0,0,0,,Тезірек ол адамды көр.
Dialogue: 0,0:18:46.64,0:18:49.30,Default,,0,0,0,,(Наофуми/Фурю) Ақылсыз күнәкарларға берілетін жазаның аты-
Dialogue: 0,0:18:49.43,0:18:51.68,Default,,0,0,0,,Құдайдың құрбандық айқайы
Dialogue: 0,0:18:52.39,0:18:54.48,Default,,0,0,0,,Менің етім мен қанымнан жаралған...
Dialogue: 0,0:18:54.60,0:18:56.39,Default,,0,0,0,,Айдаһар Агито
Dialogue: 0,0:18:56.65,0:18:59.90,Default,,0,0,0,,Қатты ауырсынуда айқайлағанда жаңа болыңыз
Dialogue: 0,0:19:00.15,0:19:03.07,Default,,0,0,0,,Қан құрбандығы
Dialogue: 0,0:19:09.49,0:19:11.37,Default,,0,0,0,,(Мелти Фило) Ах... Ха...
Dialogue: 0,0:19:18.00,0:19:19.96,Default,,0,0,0,,Неге...
Dialogue: 0,0:19:20.42,0:19:22.25,Default,,0,0,0,,Шайтаннан күткендей
Dialogue: 0,0:19:22.38,0:19:25.97,Default,,0,0,0,,Ақырында өз күшіңмен өлтірілдің бе?
Dialogue: 0,0:19:28.89,0:19:31.35,Default,,0,0,0,,(мұздың жарылған дыбысы)
Dialogue: 0,0:19:32.39,0:19:34.93,Default,,0,0,0,,Мен арам шайтан болсам да...
Dialogue: 0,0:19:35.06,0:19:38.81,Default,,0,0,0,,Тазалану үшін Алланың мейіріміне шүкіршілік ет.
Dialogue: 0,0:19:47.86,0:19:49.70,Default,,0,0,0,,Уау... ааа
Dialogue: 0,0:19:49.82,0:19:52.20,Default,,0,0,0,,Неліктен? Мен неге мұндаймын...
Dialogue: 0,0:19:52.33,0:19:54.49,Default,,0,0,0,,Мен Құдайдың өкілімін
Dialogue: 0,0:19:54.79,0:19:56.33,Default,,0,0,0,,Рим Папасы...
Dialogue: 0,0:19:57.25,0:19:59.96,Default,,0,0,0,,Осылай!
Dialogue: 0,0:20:00.42,0:20:01.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:03.42,0:20:05.71,Default,,0,0,0,,Уау
Dialogue: 0,0:20:23.82,0:20:26.11,Default,,0,0,0,,Сіз жеңдіңіз бе?
Dialogue: 0,0:20:39.75,0:20:42.29,Default,,0,0,0,,Сонымен... собор...
Dialogue: 0,0:20:42.58,0:20:44.25,Default,,0,0,0,,Рим Папасы...
Dialogue: 0,0:20:44.54,0:20:46.84,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:20:47.59,0:20:49.76,Default,,0,0,0,,Жеңімпаз анықталады.
Dialogue: 0,0:20:50.09,0:20:51.72,Default,,0,0,0,,Момындықпен беріл
Dialogue: 0,0:20:52.34,0:20:54.76,Default,,0,0,0,,Бұл Мәртебелі бағынышты әскері.
Dialogue: 0,0:20:54.89,0:20:55.89,Default,,0,0,0,,О
Dialogue: 0,0:20:56.10,0:20:57.31,Default,,0,0,0,,Наофуми-сама
Dialogue: 0,0:20:58.27,0:20:59.89,Default,,0,0,0,,Өзіңді қолыңа ал.
Dialogue: 0,0:21:01.10,0:21:02.85,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:21:02.98,0:21:03.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:03.98,0:21:07.32,Default,,0,0,0,,Осыншама қан ағып қана қоймай, бұрынғы техника...
Dialogue: 0,0:21:08.03,0:21:11.78,Default,,0,0,0,,Мүмкін Наофуми өз өмірін құрбан етеді...
Dialogue: 0,0:21:12.57,0:21:14.99,Default,,0,0,0,,Міне... Наофуми-сама
Dialogue: 0,0:21:16.41,0:21:18.04,Default,,0,0,0,,Наофуми-сама!
Dialogue: 0,0:21:18.24,0:21:21.00,Default,,0,0,0,,(Фило) Ұстаз, жауап беріңізші.
Dialogue: 0,0:21:21.12,0:21:23.42,Default,,0,0,0,,Қатты Наофуми
Dialogue: 0,0:21:23.83,0:21:27.00,Default,,0,0,0,,Мен Қалқан батырдың өлуіне ешқашан жол бермеймін.
Dialogue: 0,0:21:27.13,0:21:28.17,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:28.67,0:21:29.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:37.10,0:21:38.31,Default,,0,0,0,,Екінші бомба!
Dialogue: 0,0:21:43.35,0:21:46.02,Default,,0,0,0,,Сізге көмек көрсетудің кешігуі үшін кешірім сұраймыз.
Dialogue: 0,0:21:46.27,0:21:49.23,Default,,0,0,0,,Қалқан батыры Наофуми Иватани-сама
Dialogue: 0,0:21:49.73,0:21:53.36,Default,,0,0,0,,Уф... сен...
Dialogue: 0,0:21:54.32,0:21:57.37,Default,,0,0,0,,Мен Мелромарк ханшайымымын.
Dialogue: 0,0:21:57.87,0:22:00.58,Default,,0,0,0,,Мирерия = Q = Мелромарк.
Dialogue: 0,0:22:05.42,0:22:10.67,Default,,0,0,0,,♪~
Dialogue: 0,0:23:30.96,0:23:34.96,Default,,0,0,0,,~♪
