Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.42,0:00:17.55,Default,,0,0,0,,Менің атым - Glass
Dialogue: 0,0:00:17.84,0:00:21.59,Default,,0,0,0,,Мен сенімен, батырмен дұшпандық қатынастамын.
Dialogue: 0,0:00:21.76,0:00:24.09,Default,,0,0,0,,Мұны түсіну жеткілікті
Dialogue: 0,0:00:24.34,0:00:28.10,Default,,0,0,0,,(Мотоясу) Ол бір соққыда Жан жегішті өлтірді.
Dialogue: 0,0:00:28.31,0:00:30.14,Default,,0,0,0,,Алдаудың да шегі бар.
Dialogue: 0,0:00:30.85,0:00:33.14,Default,,0,0,0,,Мен шайқауды тоқтата алмаймын
Dialogue: 0,0:00:34.40,0:00:35.65,Default,,0,0,0,,Бұл Наофуми.
Dialogue: 0,0:00:36.15,0:00:38.86,Default,,0,0,0,,Сіз Наофумисіз бе?
Dialogue: 0,0:00:40.90,0:00:43.70,Default,,0,0,0,,Бастайық.
Dialogue: 0,0:00:44.45,0:00:47.12,Default,,0,0,0,,Нағыз толқын шайқасы
Dialogue: 0,0:00:53.04,0:00:57.92,Default,,0,0,0,,♪~
Dialogue: 0,0:02:17.96,0:02:22.92,Default,,0,0,0,,~♪
Dialogue: 0,0:02:30.09,0:02:32.05,Default,,0,0,0,,Сіз қоңырау шалмайсыз ба?
Dialogue: 0,0:02:32.18,0:02:33.93,Default,,0,0,0,,Батыл Наофуми
Dialogue: 0,0:02:34.06,0:02:36.98,Default,,0,0,0,,Ол жерде қызметшіңіз болса да, оны сонда жібере аласыз.
Dialogue: 0,0:02:37.23,0:02:39.27,Default,,0,0,0,,Қызметші ме?
Dialogue: 0,0:02:39.40,0:02:40.44,Default,,0,0,0,,Біз?
Dialogue: 0,0:02:40.69,0:02:41.61,Default,,0,0,0,,Наофуми?
Dialogue: 0,0:02:42.02,0:02:43.44,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:02:58.75,0:02:59.83,Default,,0,0,0,,Метеорлы қылыш
Dialogue: 0,0:02:59.96,0:03:01.17,Default,,0,0,0,,Метеор найзасы
Dialogue: 0,0:03:01.29,0:03:02.33,Default,,0,0,0,,Метеорлық садақ
Dialogue: 0,0:03:02.84,0:03:03.96,Default,,0,0,0,,Шынында да, бұл жігіт жақсы адам болуы мүмкін, білесің бе?
Dialogue: 0,0:03:04.92,0:03:06.63,Default,,0,0,0,,Тым
Dialogue: 0,0:03:07.17,0:03:08.26,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:03:16.93,0:03:18.98,Default,,0,0,0,,Бұл қандай дәреже?
Dialogue: 0,0:03:22.02,0:03:25.32,Default,,0,0,0,,Rondo Zero түрі/Гьяку стилі Сецугекка
Dialogue: 0,0:03:27.99,0:03:29.78,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:03:36.49,0:03:39.00,Default,,0,0,0,,Шосен әлі де қызметші ме?
Dialogue: 0,0:03:40.37,0:03:41.83,Default,,0,0,0,,Ата…
Dialogue: 0,0:03:47.13,0:03:49.55,Default,,0,0,0,,Біраз көңіл көтеруіңізді өтінемін
Dialogue: 0,0:03:51.18,0:03:53.76,Default,,0,0,0,,Кешіріңіз, бірақ мен көңіл көтеруді қаламаймын.
Dialogue: 0,0:03:53.89,0:03:55.01,Default,,0,0,0,,Қалқан түрмесі
Dialogue: 0,0:04:00.10,0:04:00.94,Default,,0,0,0,,Рафталия
Dialogue: 0,0:04:01.19,0:04:03.56,Default,,0,0,0,,Яаааа... (Фило) Тааааааа...
Dialogue: 0,0:04:13.78,0:04:16.28,Default,,0,0,0,,Сен мені осы дәрежедегі умен жеңе аласың ба?
Dialogue: 0,0:04:17.33,0:04:19.16,Default,,0,0,0,,(Наофуми) Фиро (Фиро) барлық жолмен жүреді
Dialogue: 0,0:04:21.12,0:04:24.00,Default,,0,0,0,,Бір сәтте 8 соққы керемет
Dialogue: 0,0:04:24.38,0:04:26.17,Default,,0,0,0,,Бірақ ол келмейді
Dialogue: 0,0:04:26.79,0:04:27.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:29.00,0:04:29.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:30.92,0:04:32.76,Default,,0,0,0,,Бұл тақырыптан тыс.
Dialogue: 0,0:04:39.68,0:04:42.10,Default,,0,0,0,,Ха... Екеуі де менің жаныма келеді.
Dialogue: 0,0:04:43.60,0:04:45.10,Default,,0,0,0,,Қалқан түрмесі
Dialogue: 0,0:04:47.06,0:04:48.40,Default,,0,0,0,,Кері стиль Setsugekka
Dialogue: 0,0:04:58.62,0:05:01.66,Default,,0,0,0,,Менің техникамды алғаннан кейін тұру деген нені білдіреді?
Dialogue: 0,0:05:02.16,0:05:05.29,Default,,0,0,0,,Енді, бұрынғы отты қалқан
Dialogue: 0,0:05:05.42,0:05:07.33,Default,,0,0,0,,Сіз оны қашан пайдаланасыз?
Dialogue: 0,0:05:08.54,0:05:09.84,Default,,0,0,0,,Наофуми-сама
Dialogue: 0,0:05:15.38,0:05:16.39,Default,,0,0,0,,Иә
Dialogue: 0,0:05:20.56,0:05:23.02,Default,,0,0,0,,Кел, Қаһар қалқаны
Dialogue: 0,0:05:26.94,0:05:29.44,Default,,0,0,0,,Бұл тым қауіпті! Біз Сантананы өлтіруіміз керек.
Dialogue: 0,0:05:32.48,0:05:34.90,Default,,0,0,0,,Ә… Әйтеуір, әкем қазір үйде жоқ сияқты.
Dialogue: 0,0:05:40.33,0:05:43.12,Default,,0,0,0,,Мен саған айттым, мен саған жетуім керек.
Dialogue: 0,0:05:44.33,0:05:45.50,Default,,0,0,0,,(Филоның айқайы)
Dialogue: 0,0:05:47.25,0:05:48.33,Default,,0,0,0,,Фиро
Dialogue: 0,0:05:48.71,0:05:50.54,Default,,0,0,0,,Рафталия Фиродан сұраңыз
Dialogue: 0,0:05:53.84,0:05:55.05,Default,,0,0,0,,Уф
Dialogue: 0,0:06:06.56,0:06:09.69,Default,,0,0,0,,Мені пісіру тым керемет
Dialogue: 0,0:06:15.11,0:06:18.16,Default,,0,0,0,,Ронбу-ха-но-ката/тасбақа қабығы
Dialogue: 0,0:06:23.95,0:06:24.83,Default,,0,0,0,,Наофуми-сама
Dialogue: 0,0:06:25.29,0:06:28.21,Default,,0,0,0,,Бұл шабуылмен де құлап кетпей ме?
Dialogue: 0,0:06:28.50,0:06:31.88,Default,,0,0,0,,Батыр атына қорған ғана лайық.
Dialogue: 0,0:06:32.13,0:06:34.38,Default,,0,0,0,,Мен сенің мақтауыңды алуды мақтан тұтамын.
Dialogue: 0,0:06:34.76,0:06:39.22,Default,,0,0,0,,Дегенмен, жақын арадағы шабуылдарды пайдаланған кезде қара жалын қосылады.
Dialogue: 0,0:06:39.43,0:06:42.05,Default,,0,0,0,,Алыстан шабуыл жасағанда қосылмайды.
Dialogue: 0,0:06:42.81,0:06:44.64,Default,,0,0,0,,​​Козыр бар, солай ма?
Dialogue: 0,0:06:45.31,0:06:47.73,Default,,0,0,0,,Маған еш ойланбастан көрсетіңіз.
Dialogue: 0,0:06:48.39,0:06:51.61,Default,,0,0,0,,Осыншама көп айтсаң, мен сенің қалағаныңды істеймін.
Dialogue: 0,0:06:51.90,0:06:53.11,Default,,0,0,0,,Қалқан түрмесі
Dialogue: 0,0:06:55.82,0:06:57.07,Default,,0,0,0,,Қалқанды өзгерту
Dialogue: 0,0:06:57.61,0:06:59.20,Default,,0,0,0,,Темір қыз
Dialogue: 0,0:07:16.42,0:07:19.47,Default,,0,0,0,,Бұл мен ойлағандай күшті емес.
Dialogue: 0,0:07:21.68,0:07:22.51,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:07:23.01,0:07:24.85,Default,,0,0,0,,Бұл көңілсіз болды.
Dialogue: 0,0:07:25.60,0:07:28.27,Default,,0,0,0,,(Наофуми) Бірдеңе... Не істеуім керек...
Dialogue: 0,0:07:28.73,0:07:29.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:32.77,0:07:34.06,Default,,0,0,0,,Уақыт келді ме?
Dialogue: 0,0:07:34.61,0:07:36.48,Default,,0,0,0,,Мен бұндай жылдам болады деп күткен жоқпын.
Dialogue: 0,0:07:37.82,0:07:40.70,Default,,0,0,0,,Мен сигнал бергенде, жеңіл сиқырды қолданыңыз.
Dialogue: 0,0:07:43.49,0:07:47.62,Default,,0,0,0,,Толқындар шайқасы біздің жеңіспен аяқталды делік.
Dialogue: 0,0:07:47.74,0:07:50.00,Default,,0,0,0,,Саған еш кек сақтамаймын.
Dialogue: 0,0:07:50.37,0:07:51.25,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:07:51.54,0:07:52.62,Default,,0,0,0,,Жылдам жарық
Dialogue: 0,0:07:54.92,0:07:55.88,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:56.38,0:07:57.50,Default,,0,0,0,,Жылдам өкшелі
Dialogue: 0,0:07:59.84,0:08:00.67,Default,,0,0,0,,Гунта-сан
Dialogue: 0,0:08:01.26,0:08:02.63,Default,,0,0,0,,Бақыт Құдайы деп танылған адамның адасқан заттарды жинаушы болуы – әрі сиқыршы!
Dialogue: 0,0:08:20.07,0:08:21.86,Default,,0,0,0,,Наофуми-сама шабуылы
Dialogue: 0,0:08:27.12,0:08:28.54,Default,,0,0,0,,Әуе шабуылына қарсы қорғаныс
Dialogue: 0,0:08:40.01,0:08:43.51,Default,,0,0,0,,Мен ЖоЖомен шайқасуға оралдым!
Dialogue: 0,0:08:49.64,0:08:52.52,Default,,0,0,0,,Осы қашықтықта оны жеңе алмайсың ба?
Dialogue: 0,0:08:52.81,0:08:54.65,Default,,0,0,0,,Осы жолы зейнеткерлікке шыққым келеді, бірақ...
Dialogue: 0,0:08:54.77,0:08:57.90,Default,,0,0,0,,Мұндай күш деңгейімен келесі жолы болмайды.
Dialogue: 0,0:08:59.94,0:09:04.53,Default,,0,0,0,,Толқындап жеңетін өзіміз екенімізді ұмытпайық.
Dialogue: 0,0:09:14.04,0:09:14.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:20.84,0:09:22.13,Default,,0,0,0,,Бітірдің бе?
Dialogue: 0,0:09:22.34,0:09:24.30,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:09:28.01,0:09:29.60,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:09:29.89,0:09:33.81,Default,,0,0,0,,Сіз қалай да қашып үлгердіңіз бе?
Dialogue: 0,0:09:40.44,0:09:42.82,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:09:48.62,0:09:50.83,Default,,0,0,0,,(Наофуми) Кері санақ кенеттен пайда болды.
Dialogue: 0,0:09:51.33,0:09:54.25,Default,,0,0,0,,Толқынның біткен кезі болса керек.
Dialogue: 0,0:09:55.29,0:09:57.87,Default,,0,0,0,,Бірақ толқындар дегеніміз не?
Dialogue: 0,0:09:58.54,0:10:01.00,Default,,0,0,0,,Бұл дүниені жойып жіберетін апат емес пе еді?
Dialogue: 0,0:10:01.75,0:10:06.30,Default,,0,0,0,,Гласс есімді әйел мені, батырды жеңуге құмар болды.
Dialogue: 0,0:10:07.09,0:10:09.93,Default,,0,0,0,,Нағыз толқын шайқасы
Dialogue: 0,0:10:14.60,0:10:16.48,Default,,0,0,0,,Мен түсінбейтін нәрселер өте көп.
Dialogue: 0,0:10:17.56,0:10:19.86,Default,,0,0,0,,Бірақ келесі толқынмен...
Dialogue: 0,0:10:19.98,0:10:22.15,Default,,0,0,0,,Біз күштірек болуымыз керек
Dialogue: 0,0:10:22.57,0:10:25.32,Default,,0,0,0,,Олай етпесең, бұл жолы өлесің.
Dialogue: 0,0:10:25.69,0:10:27.78,Default,,0,0,0,,Егер қалқан құбыжық фрагменттерін сіңірсе
Dialogue: 0,0:10:27.90,0:10:29.99,Default,,0,0,0,,Жаңа дағдыларды алуға болады, бірақ
Dialogue: 0,0:10:30.66,0:10:32.53,Default,,0,0,0,,Негізгі нығайту үшін -
Dialogue: 0,0:10:32.66,0:10:33.91,Default,,0,0,0,,Күтілгендей, Рафталия мен Фиро...
Dialogue: 0,0:10:34.04,0:10:35.75,Default,,0,0,0,,Сабақ қажет пе?
Dialogue: 0,0:10:37.16,0:10:39.54,Default,,0,0,0,,А... у... Батыр-сама
Dialogue: 0,0:10:41.84,0:10:44.76,Default,,0,0,0,,Тездетіп, оларды қамалға хабарлау үшін келсін.
Dialogue: 0,0:10:46.05,0:10:47.05,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:48.84,0:10:50.43,Default,,0,0,0,,Қалқан түрмесі
Dialogue: 0,0:10:52.68,0:10:53.97,Default,,0,0,0,,Қалқанды өзгерту
Dialogue: 0,0:11:00.06,0:11:02.19,Default,,0,0,0,,Темір қыз
Dialogue: 0,0:11:18.33,0:11:19.54,Default,,0,0,0,,Хмм…
Dialogue: 0,0:11:19.83,0:11:22.42,Default,,0,0,0,,Маған оны кристалды шарда көруге рұқсат етілді.
Dialogue: 0,0:11:22.67,0:11:25.46,Default,,0,0,0,,Толқындарды тыныштандыратын жақсы жұмыс.
Dialogue: 0,0:11:25.59,0:11:27.42,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,0:11:27.96,0:11:30.38,Default,,0,0,0,,Бұл басқаларға құрмет көрсету көзқарасы ма?
Dialogue: 0,0:11:31.43,0:11:33.51,Default,,0,0,0,,Өтінемін, Батыр-сама
Dialogue: 0,0:11:33.64,0:11:37.81,Default,,0,0,0,,Сенің көңіл-күйіңді түсінемін, бірақ рыцарьлар командирімен бірге жүр.
Dialogue: 0,0:11:39.73,0:11:40.81,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:11:41.52,0:11:43.86,Default,,0,0,0,,Сізден сұрайын дегенім бар.
Dialogue: 0,0:11:43.98,0:11:47.19,Default,,0,0,0,,Бұл күшті қалай алдыңыз?
Dialogue: 0,0:11:47.90,0:11:51.61,Default,,0,0,0,,Сізде Қалқан Батырының күшімен бәсекелесетін күш бар.
Dialogue: 0,0:11:51.78,0:11:54.28,Default,,0,0,0,,​​Мен сізге бұл құпияны айтуға міндеттімін.
Dialogue: 0,0:11:55.53,0:11:59.70,Default,,0,0,0,,Жүр, маған тек шындықты айт, өтірік айтпа.
Dialogue: 0,0:12:01.16,0:12:02.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:02.83,0:12:05.21,Default,,0,0,0,,Егер сіз білгіңіз келсе, жай ғана догеза.
Dialogue: 0,0:12:07.34,0:12:09.17,Default,,0,0,0,,Мен болған әлемде
Dialogue: 0,0:12:09.51,0:12:13.39,Default,,0,0,0,,Біреуден бірдеңе сұрасаң, басыңды жерге үйке
Dialogue: 0,0:12:13.84,0:12:18.97,Default,,0,0,0,,«Өтінемін, мен сияқты біреу үшін мені ағартыңыз».
Dialogue: 0,0:12:19.10,0:12:20.10,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:12:20.89,0:12:22.44,Default,,0,0,0,,Егер мен қазір болсам...
Dialogue: 0,0:12:22.56,0:12:25.73,Default,,0,0,0,,Мен сені осы жерде өлтіріп, майданнан қашып кетуім мүмкін еді.
Dialogue: 0,0:12:26.44,0:12:27.69,Default,,0,0,0,,Блефке қоңырау шалыңыз
Dialogue: 0,0:12:31.07,0:12:35.41,Default,,0,0,0,,Толқынды құбыжықты жеңген менімен соғысқысы келетін адам бар ма?
Dialogue: 0,0:12:41.37,0:12:42.29,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:44.08,0:12:46.88,Default,,0,0,0,,Толқын біткенше және мен бастапқы әлеміме орала аламын
Dialogue: 0,0:12:47.00,0:12:48.92,Default,,0,0,0,,Кем дегенде, мен ынтымақтасамын.
Dialogue: 0,0:12:49.55,0:12:51.80,Default,,0,0,0,,Ендеше мені енді мазаламаңыз
Dialogue: 0,0:12:53.01,0:12:55.64,Default,,0,0,0,,О... патшаға құрметсіздік.
Dialogue: 0,0:12:55.76,0:12:57.89,Default,,0,0,0,,Мен сені ешқашан кешірмеймін, қалқан!
Dialogue: 0,0:12:59.72,0:13:01.14,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:01.27,0:13:05.85,Default,,0,0,0,,Қарғыс атқан құлдарың күнәларын өтесін...
Dialogue: 0,0:13:07.65,0:13:08.61,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:09.65,0:13:12.82,Default,,0,0,0,,Қолың қаншалықты кір болса да,
Dialogue: 0,0:13:13.36,0:13:15.99,Default,,0,0,0,,Мен әрқашан достарымды қорғаймын
Dialogue: 0,0:13:16.66,0:13:18.91,Default,,0,0,0,,Менің қолымнан бірдеңені қайтадан тартып алуына жол берме
Dialogue: 0,0:13:19.78,0:13:22.20,Default,,0,0,0,,Оларды бір саусақпен түртіңіз.
Dialogue: 0,0:13:22.58,0:13:27.38,Default,,0,0,0,,Мен сені жердің шетіне дейін қуамын және туылғаныңа өкінемін.
Dialogue: 0,0:13:27.50,0:13:28.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:33.17,0:13:37.72,Default,,0,0,0,,Қалқан!
Dialogue: 0,0:13:46.14,0:13:49.27,Default,,0,0,0,,(Көлеңке) Қотабидің орындауы ерекше болды.
Dialogue: 0,0:13:49.73,0:13:50.65,Default,,0,0,0,,Дегожару
Dialogue: 0,0:13:51.11,0:13:51.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:52.07,0:13:53.78,Default,,0,0,0,,Батырдың іс-әрекетімен
Dialogue: 0,0:13:53.90,0:13:57.74,Default,,0,0,0,,Барлығы бұл үшін несие алуға мәжбүр болды.
Dialogue: 0,0:13:58.11,0:14:00.49,Default,,0,0,0,,Олардың арасында Қалқан батыры да бар.
Dialogue: 0,0:14:00.62,0:14:03.66,Default,,0,0,0,,Бұған риза емес күштер де бар.
Dialogue: 0,0:14:04.96,0:14:06.92,Default,,0,0,0,,Жақсылық – көпшілікке арналған бет
Dialogue: 0,0:14:07.04,0:14:09.50,Default,,0,0,0,,Сахна артында жасырын маневрлер мен интригалар бар
Dialogue: 0,0:14:10.09,0:14:14.26,Default,,0,0,0,,Менің ойымша, сіз болашақта мұқият әрекет етуіңіз керек.
Dialogue: 0,0:14:14.84,0:14:15.97,Default,,0,0,0,,Дегожару
Dialogue: 0,0:14:22.01,0:14:23.10,Default,,0,0,0,,Годжару?
Dialogue: 0,0:14:25.35,0:14:28.27,Default,,0,0,0,,О, Мелти, бұл не үшін?
Dialogue: 0,0:14:30.15,0:14:34.65,Default,,0,0,0,,Бұрын Қалқан Батырмен сөйлескеніңді естідім.
Dialogue: 0,0:14:36.28,0:14:40.28,Default,,0,0,0,,Бұл талқылау өте нашар жағдайда аяқталды.
Dialogue: 0,0:14:41.41,0:14:42.91,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:14:43.37,0:14:44.45,Default,,0,0,0,,Әке
Dialogue: 0,0:14:44.58,0:14:47.58,Default,,0,0,0,,Егер мен Қалқан батырдан бөлек қалсам...
Dialogue: 0,0:14:47.71,0:14:52.34,Default,,0,0,0,,Толқындарға төтеп бере алмаса, бұл елдің тыныштығын бұзуы мүмкін.
Dialogue: 0,0:14:52.71,0:14:54.00,Default,,0,0,0,,Өтінемін, осында бітімге келіңіз...
Dialogue: 0,0:14:55.26,0:14:56.80,Default,,0,0,0,,Мұнымен татуласу дейсіз бе?
Dialogue: 0,0:14:57.01,0:14:57.84,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:58.34,0:15:00.84,Default,,0,0,0,,О, мен саған ренжіген жоқпын.
Dialogue: 0,0:15:01.89,0:15:06.06,Default,,0,0,0,,Менің әкем Қалқан батырды неге сонша жек көреді?
Dialogue: 0,0:15:06.73,0:15:08.18,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:09.14,0:15:13.57,Default,,0,0,0,,Егер мен оған және деми-адамдарға аман қалуға мүмкіндік берсем, менің қайтадан отбасым болады...
Dialogue: 0,0:15:14.11,0:15:16.11,Default,,0,0,0,,Әке? (есіктің ашылған дыбысы)
Dialogue: 0,0:15:16.23,0:15:18.45,Default,,0,0,0,,Жауап айту құрметсіздік болып табылады.
Dialogue: 0,0:15:19.65,0:15:23.49,Default,,0,0,0,,Енді патшайым жоқ болғандықтан, патшаның пікірі абсолютті.
Dialogue: 0,0:15:23.66,0:15:27.25,Default,,0,0,0,,Тіпті біз ханшайымдар да ерекшелік емес.
Dialogue: 0,0:15:27.58,0:15:28.83,Default,,0,0,0,,Әпке
Dialogue: 0,0:15:29.29,0:15:31.29,Default,,0,0,0,,Әке — патша.
Dialogue: 0,0:15:32.42,0:15:34.96,Default,,0,0,0,,Сіз түсіне алмайтын барлық сөздер мен әрекеттер
Dialogue: 0,0:15:35.09,0:15:37.26,Default,,0,0,0,,Ел болашағына алаңдаған
Dialogue: 0,0:15:37.76,0:15:42.68,Default,,0,0,0,,Түсінгенім, сен әлі әкеңнің мейіріміне бөленгің келетін жастасың.
Dialogue: 0,0:15:42.89,0:15:46.77,Default,,0,0,0,,Кішкене ұстанған дұрыс, Мелти.
Dialogue: 0,0:15:47.85,0:15:49.77,Default,,0,0,0,,Әпкемнің кеңесі
Dialogue: 0,0:15:50.48,0:15:52.77,Default,,0,0,0,,Кеңесіңізге рахмет.
Dialogue: 0,0:15:52.90,0:15:55.65,Default,,0,0,0,,Бірақ мұның менің апама еш қатысы жоқ.
Dialogue: 0,0:15:56.02,0:15:56.86,Default,,0,0,0,,Гррр…
Dialogue: 0,0:15:57.19,0:15:59.95,Default,,0,0,0,,Мен сенің әкең мен шешең сияқтымын.
Dialogue: 0,0:16:00.07,0:16:02.41,Default,,0,0,0,,Мені ел тағдыры алаңдатады.
Dialogue: 0,0:16:02.53,0:16:07.33,Default,,0,0,0,,Бұл тақ мұрагері ретінде менің жауапкершілігім.
Dialogue: 0,0:16:08.50,0:16:10.54,Default,,0,0,0,,Сізді балқытады...
Dialogue: 0,0:16:12.42,0:16:14.29,Default,,0,0,0,,Кешіріңіз, әке.
Dialogue: 0,0:16:16.21,0:16:18.51,Default,,0,0,0,,Ах... Мелти.
Dialogue: 0,0:16:18.63,0:16:19.67,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:16:24.51,0:16:25.64,Default,,0,0,0,,Чи…
Dialogue: 0,0:16:42.20,0:16:45.78,Default,,0,0,0,,Мен оның патшамен шайқасады деп ешқашан ойламадым.
Dialogue: 0,0:16:46.12,0:16:48.99,Default,,0,0,0,,Оны сатқаным есімде жоқ. Маған сатылды.
Dialogue: 0,0:16:49.20,0:16:52.50,Default,,0,0,0,,Сатып алуды өзіңізге қалдырыңыз.
Dialogue: 0,0:16:53.42,0:16:56.00,Default,,0,0,0,,Бірақ сынып туралы не деуге болады?
Dialogue: 0,0:16:56.58,0:17:01.46,Default,,0,0,0,,Мұндай жағдайда сіз Айдаһар құм сағатын пайдалана алмайсыз.
Dialogue: 0,0:17:01.76,0:17:02.88,Default,,0,0,0,,Балшық?
Dialogue: 0,0:17:03.01,0:17:05.09,Default,,0,0,0,,Мен Шилдфриденге баруды ойлап жүрмін.
Dialogue: 0,0:17:05.64,0:17:07.14,Default,,0,0,0,,Егер сіз Ан-Чан болсаңыз...
Dialogue: 0,0:17:07.26,0:17:09.47,Default,,0,0,0,,Мен ол жерге бір күні баратынымды білдім.
Dialogue: 0,0:17:09.85,0:17:12.06,Default,,0,0,0,,Мен Шилдфриденді ұсынамын.
Dialogue: 0,0:17:12.68,0:17:15.65,Default,,0,0,0,,Шилдфриден де құл саудагерлеріне ұсынылды.
Dialogue: 0,0:17:15.98,0:17:18.98,Default,,0,0,0,,Ол жарты адам болғанымен, адамдарға төзімді.
Dialogue: 0,0:17:19.15,0:17:22.24,Default,,0,0,0,,А, басқа Силтвелд...
Dialogue: 0,0:17:22.36,0:17:25.45,Default,,0,0,0,,Бұл демиадамдық абсолютизмі бар экстремалды ел.
Dialogue: 0,0:17:25.86,0:17:27.24,Default,,0,0,0,,Бірақ егер Қалқан батыры...
Dialogue: 0,0:17:27.37,0:17:30.33,Default,,0,0,0,,Ұстаз, сіз қайтадан шығасыз ба?
Dialogue: 0,0:17:30.45,0:17:31.29,Default,,0,0,0,,Иә
Dialogue: 0,0:17:31.83,0:17:33.62,Default,,0,0,0,,Ой! Ол бұрыштан айналып кетті!
Dialogue: 0,0:17:33.75,0:17:35.83,Default,,0,0,0,,Егер бұл ат арба болса, оған бір ай керек еді.
Dialogue: 0,0:17:36.04,0:17:38.25,Default,,0,0,0,,Егер бұл құс ханым болса, ол жылдамырақ болар еді.
Dialogue: 0,0:17:38.63,0:17:42.84,Default,,0,0,0,,Барлық қажетті заттарды қарастырып, оларды вагонға тиеп алайық.
Dialogue: 0,0:17:43.21,0:17:45.47,Default,,0,0,0,,Рафталияға орнына қылыш беріңіз...
Dialogue: 0,0:17:45.59,0:17:47.34,Default,,0,0,0,,Менің қосалқы қылышым бар.
Dialogue: 0,0:17:47.55,0:17:48.60,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:48.72,0:17:51.77,Default,,0,0,0,,Бұл тағы да ұзақ сапар. Мен ақша үнемдеуім керек пе?
Dialogue: 0,0:17:56.14,0:17:58.48,Default,,0,0,0,,Мен сонша ерте кете алатыныма сене алар емеспін.
Dialogue: 0,0:17:58.86,0:18:01.86,Default,,0,0,0,,Эрхард мырза, сіз әдеттегідей өте шеберсіз.
Dialogue: 0,0:18:02.73,0:18:03.74,Default,,0,0,0,,О
Dialogue: 0,0:18:08.78,0:18:10.41,Default,,0,0,0,,Ан-чанға
Dialogue: 0,0:18:10.58,0:18:13.62,Default,,0,0,0,,Бөлімшенің орнына кішкене құрал дайындадым.
Dialogue: 0,0:18:13.95,0:18:15.79,Default,,0,0,0,,Егер сізге ұнаса, оны пайдаланыңыз.
Dialogue: 0,0:18:16.46,0:18:19.33,Default,,0,0,0,,Ан-чанның қалқанына бекітетін керек-жарағы бар.
Dialogue: 0,0:18:19.92,0:18:24.42,Default,,0,0,0,,Ол қалқанды егжей-тегжейлі зерттеу сияқты көп нәрсені жасай алады.
Dialogue: 0,0:18:25.01,0:18:26.80,Default,,0,0,0,,Бұл мисс үшін қылыш
Dialogue: 0,0:18:27.63,0:18:30.14,Default,,0,0,0,,Мен сынған затты дайындадым.
Dialogue: 0,0:18:30.51,0:18:32.43,Default,,0,0,0,,Қолыңызға сыйған нәрсе болғаны абзал.
Dialogue: 0,0:18:33.14,0:18:35.06,Default,,0,0,0,,Мисс үшін тағы бір бөтелке
Dialogue: 0,0:18:35.56,0:18:36.85,Default,,0,0,0,,Сиқырлы қылыш
Dialogue: 0,0:18:38.02,0:18:39.94,Default,,0,0,0,,Маңызды жауларға қарсы тиімді.
Dialogue: 0,0:18:43.44,0:18:46.15,Default,,0,0,0,,Құс ханым...
Dialogue: 0,0:18:46.28,0:18:49.36,Default,,0,0,0,,Каретканы тарта алмаған кезде қолданылатын пайдалы элемент.
Dialogue: 0,0:18:50.62,0:18:52.74,Default,,0,0,0,,Егер сіз мұны кисеңіз, сізде 100 күш болады.
Dialogue: 0,0:18:52.99,0:18:55.08,Default,,0,0,0,,Тіпті сіз күйме тарта аласыз
Dialogue: 0,0:18:57.46,0:18:59.54,Default,,0,0,0,,О~ Хахаха...
Dialogue: 0,0:19:09.18,0:19:10.39,Default,,0,0,0,,Кухи…
Dialogue: 0,0:19:11.59,0:19:14.35,Default,,0,0,0,,Ыстық
Dialogue: 0,0:19:16.60,0:19:17.98,Default,,0,0,0,,Саяхаттау жақсы
Dialogue: 0,0:19:18.48,0:19:20.73,Default,,0,0,0,,Еркін және ешкімге байланысты емес
Dialogue: 0,0:19:21.35,0:19:24.32,Default,,0,0,0,,Корольдік немесе кейіпкерлермен араласудың қажеті жоқ.
Dialogue: 0,0:19:26.36,0:19:28.44,Default,,0,0,0,,Мен оны таптым (Наофуми) Уф...
Dialogue: 0,0:19:35.20,0:19:36.87,Default,,0,0,0,,Ах... Мел-чан
Dialogue: 0,0:19:37.33,0:19:38.71,Default,,0,0,0,,Эй
Dialogue: 0,0:19:38.83,0:19:40.12,Default,,0,0,0,,(Наофуми) Фило (Фило) Көптен бері көрмеген
Dialogue: 0,0:19:40.25,0:19:41.67,Default,,0,0,0,,Наофуми-сама
Dialogue: 0,0:19:41.88,0:19:46.13,Default,,0,0,0,,Аз ғана уақыт болса да, біз бірге саяхаттадық, солай емес пе?
Dialogue: 0,0:19:46.71,0:19:49.76,Default,,0,0,0,,Мастер Мел-чан, сен жақсы қызсың.
Dialogue: 0,0:20:01.02,0:20:02.52,Default,,0,0,0,,Қалқан батыры
Dialogue: 0,0:20:03.44,0:20:07.48,Default,,0,0,0,,Мен сенің астанаға оралып, Король Орткреймен қайта кездесуіңді қалаймын.
Dialogue: 0,0:20:07.69,0:20:08.57,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:20:12.61,0:20:15.78,Default,,0,0,0,,Патшаға деген құрметсіздігіңіз үшін кешірім сұрап, татуласуыңызды қалаймын.
Dialogue: 0,0:20:15.91,0:20:16.87,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:20:19.25,0:20:23.37,Default,,0,0,0,,Толқындарды тоқтату үшін батырдың күші керек.
Dialogue: 0,0:20:23.79,0:20:27.84,Default,,0,0,0,,Сонымен бірге патшаның, тіпті батырдың да қолдауынсыз...
Dialogue: 0,0:20:28.46,0:20:29.88,Default,,0,0,0,,Көмек?
Dialogue: 0,0:20:30.13,0:20:32.68,Default,,0,0,0,,Біз бірге жұмыс істейтін адамдармыз.
Dialogue: 0,0:20:33.09,0:20:34.97,Default,,0,0,0,,Толқындар басылғанша
Dialogue: 0,0:20:38.14,0:20:39.56,Default,,0,0,0,,Наофуми-сама
Dialogue: 0,0:20:40.73,0:20:42.35,Default,,0,0,0,,Бұл жігіт те роялти.
Dialogue: 0,0:21:17.28,0:21:18.62,Default,,0,0,0,,Неге...
Dialogue: 0,0:21:19.79,0:21:22.96,Default,,0,0,0,,Неге олайсың, әкең екеуің?
Dialogue: 0,0:21:24.46,0:21:27.00,Default,,0,0,0,,Батыр мен патша бір-бірімен соғысады.
Dialogue: 0,0:21:27.13,0:21:28.75,Default,,0,0,0,,Мүлдем жоқ.
Dialogue: 0,0:21:28.88,0:21:30.26,Default,,0,0,0,,Мел-чан?
Dialogue: 0,0:21:30.38,0:21:31.88,Default,,0,0,0,,Фиро-чан да солай ойлайды, солай ма?
Dialogue: 0,0:21:32.01,0:21:32.97,Default,,0,0,0,,Ал...
Dialogue: 0,0:21:33.09,0:21:34.80,Default,,0,0,0,,Рафталия-сан да солай ойлайды, солай ма?
Dialogue: 0,0:21:35.26,0:21:39.01,Default,,0,0,0,,Мен... Мен Наофуми-саманың қылышымын.
Dialogue: 0,0:21:39.31,0:21:41.85,Default,,0,0,0,,Қараңызшы, бәрі де солай айтады.
Dialogue: 0,0:21:42.02,0:21:43.19,Default,,0,0,0,,Сіз бұлай айтқан жоқсыз.
Dialogue: 0,0:21:43.31,0:21:46.11,Default,,0,0,0,,Жарайды, әкеңнен дұрыстап кешірім сұра.
Dialogue: 0,0:21:46.31,0:21:49.32,Default,,0,0,0,,Әйтпесе әке шешеден ұрысады.
Dialogue: 0,0:21:50.61,0:21:53.24,Default,,0,0,0,,(Наофуми) Сенің ашулануың әкеңе ұқсайды.
Dialogue: 0,0:21:53.95,0:21:57.07,Default,,0,0,0,,Иә? Әкемді шешем ұрса ма?
Dialogue: 0,0:21:57.66,0:21:59.70,Default,,0,0,0,,Адамдардың айтқанын мұқият тыңдаңыз.
Dialogue: 0,0:22:01.00,0:22:02.25,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:22:10.80,0:22:12.80,Default,,0,0,0,,Ха... бұл сезім
Dialogue: 0,0:22:13.76,0:22:15.47,Default,,0,0,0,,Дәл сол кезде мен де сезіндім.
Dialogue: 0,0:22:16.43,0:22:19.05,Default,,0,0,0,,Біреуді тұзаққа түсіретін атмосфера
Dialogue: 0,0:22:24.89,0:22:25.85,Default,,0,0,0,,Ха…
Dialogue: 0,0:22:30.52,0:22:31.53,Default,,0,0,0,,Сөйтіп мен астанаға оралдым...
Dialogue: 0,0:22:34.07,0:22:35.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:36.03,0:22:37.28,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:22:38.99,0:22:44.00,Default,,0,0,0,,♪~
Dialogue: 0,0:24:05.62,0:24:08.91,Default,,0,0,0,,~♪
