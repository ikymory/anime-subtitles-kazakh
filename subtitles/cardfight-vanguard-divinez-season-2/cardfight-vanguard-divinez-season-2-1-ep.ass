Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:49.78,0:00:51.75,Default,,0,0,0,,Техника...Бастаңыз!
Dialogue: 0,0:00:59.32,0:01:03.79,Default,,0,0,0,,Тағдыр соғысы кезінде жиналған жобалық күш.
Dialogue: 0,0:01:04.79,0:01:07.76,Default,,0,0,0,,Менің күшім осында, сырттан!
Dialogue: 0,0:01:10.33,0:01:14.77,Default,,0,0,0,,Рахмет, тағдыр картасының иелері.
Dialogue: 0,0:01:14.77,0:01:17.24,Default,,0,0,0,,Көптен күткен тілегім ақыры орындалды.
Dialogue: 0,0:01:18.77,0:01:20.78,Default,,0,0,0,,Хмм...?
Dialogue: 0,0:01:22.78,0:01:25.25,Default,,0,0,0,,Ха...не болып жатыр?
Dialogue: 0,0:01:29.79,0:01:32.75,Default,,0,0,0,,Не? Бұл эмблема...
Dialogue: 0,0:01:39.76,0:01:41.76,Default,,0,0,0,,Жобалық күш….
Dialogue: 0,0:01:42.76,0:01:45.77,Default,,0,0,0,,Хирургиялық формула қайта жазылуда!
Dialogue: 0,0:01:58.78,0:02:00.75,Default,,0,0,0,,Жаңа карталар?
Dialogue: 0,0:02:07.76,0:02:09.76,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:02:10.79,0:02:12.76,Default,,0,0,0,,Азаматтық!
Dialogue: 0,0:03:47.33,0:03:49.26,Default,,0,0,0,,📺Келесі жаңалықтар➡
Dialogue: 0,0:03:49.26,0:03:52.27,Default,,0,0,0,,17 жасар данышпан орта мектеп оқушысы➡
Dialogue: 0,0:03:52.27,0:03:54.77,Default,,0,0,0,,Куон Айкава жариялаған қағаз➡
Dialogue: 0,0:03:54.77,0:03:58.77,Default,,0,0,0,,Халықаралық кванттық физика қоғамында арнайы марапатқа ие болды➡
Dialogue: 0,0:03:58.77,0:04:01.24,Default,,0,0,0,,Бұл қағаз жоғары өлшемдерді қалай байқауға болатыны туралы➡
Dialogue: 0,0:04:01.24,0:04:03.28,Default,,0,0,0,,Ұсынылады...
Dialogue: 0,0:04:03.28,0:04:05.75,Default,,0,0,0,,~Әлемде➡
Dialogue: 0,0:04:05.75,0:04:08.78,Default,,0,0,0,,Бұл жерде таңғажайып адамдар бар.
Dialogue: 0,0:04:08.78,0:04:11.25,Default,,0,0,0,,Я... тағы бір бұқтырылған!
Dialogue: 0,0:04:11.25,0:04:13.72,Default,,0,0,0,,Хикари...сенде қанша стақан бар?
Dialogue: 0,0:04:13.72,0:04:15.72,Default,,0,0,0,,3…немесе 4?
Dialogue: 0,0:04:15.72,0:04:17.72,Default,,0,0,0,,Мен күткендей, тым көп жедім!
Dialogue: 0,0:04:17.72,0:04:20.23,Default,,0,0,0,,Өсіп келе жатқан кезең болғандықтан кінәлі емес!
Dialogue: 0,0:04:21.29,0:04:23.30,Default,,0,0,0,,｟Хикари әрқашан әлсіз ➡ болды
Dialogue: 0,0:04:23.30,0:04:25.30,Default,,0,0,0,,Қайтадан күш жинадым. ｠
Dialogue: 0,0:04:26.30,0:04:28.24,Default,,0,0,0,,｟картаға таңдалған 6 адам➡
Dialogue: 0,0:04:28.24,0:04:30.27,Default,,0,0,0,,Тағдырыңды өзгерту күші➡
Dialogue: 0,0:04:30.27,0:04:33.31,Default,,0,0,0,,Авангардтық шайқаста жеңіс немесе жеңіліс үшін шайқас➡
Dialogue: 0,0:04:33.31,0:04:35.28,Default,,0,0,0,,Тағдыр соғысы. ｠
Dialogue: 0,0:04:36.31,0:04:39.25,Default,,0,0,0,,｟Ғажайып тағдыр картасының иесі ретінде➡
Dialogue: 0,0:04:39.25,0:04:41.78,Default,,0,0,0,,Тағдыр соғысына қарсы шықтым➡
Dialogue: 0,0:04:41.78,0:04:44.82,Default,,0,0,0,,Күшті қарсыластармен күресте жеңіңіз➡
Dialogue: 0,0:04:44.82,0:04:46.79,Default,,0,0,0,,Мен өз тағдырымды өзгертуге мүмкіндік алдым. ｠
Dialogue: 0,0:04:48.79,0:04:51.73,Default,,0,0,0,,｟Менің әпкем...
Dialogue: 0,0:04:51.73,0:04:53.79,Default,,0,0,0,,Хикариге...
Dialogue: 0,0:04:53.79,0:04:55.80,Default,,0,0,0,,Сау боласыз деп үміттенемін! ｠
Dialogue: 0,0:04:56.86,0:04:59.87,Default,,0,0,0,,｟Сосын бір керемет болды! ｠
Dialogue: 0,0:05:04.37,0:05:08.38,Default,,0,0,0,,｟Дәл қазір біз бейбіт өмір сүріп жатырмыз. ｠
Dialogue: 0,0:05:09.38,0:05:12.25,Default,,0,0,0,,｟Бұл барлығына бірдей болуы керек. ｠
Dialogue: 0,0:05:12.25,0:05:39.37,Default,,0,0,0,,♬～
Dialogue: 0,0:05:39.37,0:05:41.37,Default,,0,0,0,,｟Бүгін де жақсы күн болатын сияқты. ｠
Dialogue: 0,0:05:54.22,0:05:56.26,Default,,0,0,0,,Суо Қайырлы таң!
Dialogue: 0,0:05:56.26,0:05:58.26,Default,,0,0,0,,Акина….
Dialogue: 0,0:05:58.26,0:06:00.23,Default,,0,0,0,,Енді күресейік.
Dialogue: 0,0:06:00.23,0:06:02.23,Default,,0,0,0,,Алдымен ашу Бұл солай ма?
Dialogue: 0,0:06:02.23,0:06:04.23,Default,,0,0,0,,Мектептен кейін.
Dialogue: 0,0:06:05.73,0:06:07.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:08.90,0:06:10.87,Default,,0,0,0,,｟Бұл жігіт те өзгерген. ｠
Dialogue: 0,0:06:11.77,0:06:14.24,Default,,0,0,0,,Ойлап қарасам, сынып қатты шулы➡
Dialogue: 0,0:06:14.24,0:06:16.24,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:06:16.24,0:06:18.75,Default,,0,0,0,,Мен білмеймін. Маған бұл қызықты емес
Dialogue: 0,0:06:18.75,0:06:21.28,Default,,0,0,0,,Бұл шектен шыққан.
Dialogue: 0,0:06:21.28,0:06:24.72,Default,,0,0,0,,Бұл ауыспалы студент! Кент...
Dialogue: 0,0:06:24.72,0:06:26.75,Default,,0,0,0,,Менің сыныбымда ауысатын оқушы бар ма?
Dialogue: 0,0:06:26.75,0:06:30.76,Default,,0,0,0,,Ах! Біз таңертеңнен бері кәдесыйлар туралы сөйлесеміз.
Dialogue: 0,0:06:30.76,0:06:32.73,Default,,0,0,0,,Қандай адамдар келеді деп ойлаймын.
Dialogue: 0,0:06:32.73,0:06:34.73,Default,,0,0,0,,Қыз~!
Dialogue: 0,0:06:34.73,0:06:37.23,Default,,0,0,0,,Ол да Микото сияқты өте әдемі қыз!
Dialogue: 0,0:06:37.23,0:06:39.27,Default,,0,0,0,,Ақпараттың қайнар көзі?
Dialogue: 0,0:06:39.27,0:06:41.74,Default,,0,0,0,,Менің қалауым ~ Жаман ба!
Dialogue: 0,0:06:43.27,0:06:46.24,Default,,0,0,0,,Олай болса, мен енді ауыспалы студентті таныстырамын.
Dialogue: 0,0:06:49.41,0:06:52.75,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Куон Айкавамын.
Dialogue: 0,0:06:52.75,0:06:56.25,Default,,0,0,0,,Әдемі жігіт...! Мен өзімді ханзада сияқты сезінемін.
Dialogue: 0,0:06:56.25,0:06:58.25,Default,,0,0,0,,Не, адам?
Dialogue: 0,0:06:59.22,0:07:01.22,Default,,0,0,0,,Ол….
Dialogue: 0,0:07:02.22,0:07:04.72,Default,,0,0,0,,Бұл керемет жігіт!
Dialogue: 0,0:07:06.29,0:07:08.73,Default,,0,0,0,,Айкава-кун, сіз академиялық конференцияда жүлде алдыңыз, солай ма? ➡
Dialogue: 0,0:07:08.73,0:07:11.23,Default,,0,0,0,,Мен оны жаңалықтардан көрдім. Мен де көрдім! ➡
Dialogue: 0,0:07:11.23,0:07:14.73,Default,,0,0,0,,Кванттық механика... дұрыс па?
Dialogue: 0,0:07:14.73,0:07:16.77,Default,,0,0,0,,Сен ақылдысың!
Dialogue: 0,0:07:16.77,0:07:20.27,Default,,0,0,0,,Марапатқа келетін болсақ, менің жолым болды➡
Dialogue: 0,0:07:20.27,0:07:22.74,Default,,0,0,0,,Ұлттық зертханалармен бірлескен зерттеулерде➡
Dialogue: 0,0:07:22.74,0:07:24.71,Default,,0,0,0,,Біз көбірек нәтиже шығаруымыз керек.
Dialogue: 0,0:07:26.78,0:07:28.75,Default,,0,0,0,,Мен ол данышпан мектеп оқушысы ма, әлде бір нәрсе ме, білмеймін, бірақ➡
Dialogue: 0,0:07:28.75,0:07:30.75,Default,,0,0,0,,Мен бұған жақсы емеспін.
Dialogue: 0,0:07:30.75,0:07:33.25,Default,,0,0,0,,Неліктен? Біз әлі сөйлескен жоқпыз.
Dialogue: 0,0:07:33.25,0:07:35.26,Default,,0,0,0,,Ха~….
Dialogue: 0,0:07:35.26,0:07:38.73,Default,,0,0,0,,Сұлу, ақылды жігіттің мінезі жақсы болмайды!
Dialogue: 0,0:07:38.73,0:07:41.23,Default,,0,0,0,,Ол қара адам, мен айта аламын!
Dialogue: 0,0:07:41.23,0:07:43.73,Default,,0,0,0,,Алаңдау керемет...
Dialogue: 0,0:07:43.73,0:07:46.73,Default,,0,0,0,,A~Егер сіз бәрібір аударып жатсаңыз➡
Dialogue: 0,0:07:46.73,0:07:48.77,Default,,0,0,0,,Кемеңгер орта мектеп оқушысынан➡
Dialogue: 0,0:07:48.77,0:07:50.74,Default,,0,0,0,,Сұлу қыздың кумирі болғаны жақсы болды.
Dialogue: 0,0:07:52.24,0:07:54.74,Default,,0,0,0,,Олай айтпай, тіл табысасың деп үміттенемін.
Dialogue: 0,0:07:54.74,0:07:57.74,Default,,0,0,0,,Хмм...?
Dialogue: 0,0:07:57.74,0:07:59.78,Default,,0,0,0,,Жоқ...!
Dialogue: 0,0:07:59.78,0:08:03.25,Default,,0,0,0,,Кешіріңіз, Кент мұны да қасақана айтқан жоқ.
Dialogue: 0,0:08:03.25,0:08:05.22,Default,,0,0,0,,Ренжімеңіз.
Dialogue: 0,0:08:05.22,0:08:08.72,Default,,0,0,0,,Сіз өте мейірімдісіз, Акина Мейдо.
Dialogue: 0,0:08:08.72,0:08:11.76,Default,,0,0,0,,Е...неге менің атым?
Dialogue: 0,0:08:11.76,0:08:15.23,Default,,0,0,0,,Бір-біріңді білесіңдер ме? Жоқ... бірінші кездесу.
Dialogue: 0,0:08:15.23,0:08:17.73,Default,,0,0,0,,Мен де сені білемін➡
Dialogue: 0,0:08:17.73,0:08:19.73,Default,,0,0,0,,Суу-кун.
Dialogue: 0,0:08:19.73,0:08:21.74,Default,,0,0,0,,Хмм...?
Dialogue: 0,0:08:23.74,0:08:26.74,Default,,0,0,0,,Не...неге сен ауысатын студентсің?
Dialogue: 0,0:08:26.74,0:08:29.78,Default,,0,0,0,,Мен Акина мен басқалардың есімдерін білемін!
Dialogue: 0,0:08:29.78,0:08:32.25,Default,,0,0,0,,Мен жаңа ғана қызметкерлер бөлмесінде сыныптар тізімін көрдім➡
Dialogue: 0,0:08:32.25,0:08:34.25,Default,,0,0,0,,Барлығына жаттап алдым.
Dialogue: 0,0:08:34.25,0:08:36.25,Default,,0,0,0,,Кент Такематсу.
Dialogue: 0,0:08:36.25,0:08:38.75,Default,,0,0,0,,О... тіпті менің атым ба?
Dialogue: 0,0:08:39.75,0:08:42.72,Default,,0,0,0,,Йоцуги екеуің жақсы доссыңдар, солай емес пе?
Dialogue: 0,0:08:42.72,0:08:45.76,Default,,0,0,0,,E... жақсы, иә.
Dialogue: 0,0:08:45.76,0:08:47.76,Default,,0,0,0,,Мен қызғанамын.
Dialogue: 0,0:08:47.76,0:08:51.26,Default,,0,0,0,,Байланыс ақпараты Алмасайық.
Dialogue: 0,0:08:54.23,0:08:56.24,Default,,0,0,0,,Мм….
Dialogue: 0,0:08:57.24,0:08:59.24,Default,,0,0,0,,Куон Айкава...?
Dialogue: 0,0:09:00.24,0:09:02.24,Default,,0,0,0,,Ол жақсы жігіт, меніңше!
Dialogue: 0,0:09:02.24,0:09:04.24,Default,,0,0,0,,Жоқ, бұл қорқынышты.
Dialogue: 0,0:09:05.75,0:09:07.75,Default,,0,0,0,,Керемет келді!
Dialogue: 0,0:09:07.75,0:09:09.72,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:09:10.78,0:09:13.22,Default,,0,0,0,,Барлық түсірілген маңызды триггерлерді палубаға қайтарыңыз➡
Dialogue: 0,0:09:13.22,0:09:16.22,Default,,0,0,0,,Rezael's Drive Plus 1.
Dialogue: 0,0:09:16.22,0:09:18.73,Default,,0,0,0,,Авангардқа Novia-мен шабуыл жасаңыз!
Dialogue: 0,0:09:18.73,0:09:20.73,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:09:20.73,0:09:22.73,Default,,0,0,0,,Садимен шабуыл!
Dialogue: 0,0:09:22.73,0:09:24.83,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:09:24.83,0:09:27.73,Default,,0,0,0,,Мен тағы бір ұпай жинаймын!
Dialogue: 0,0:09:27.73,0:09:29.74,Default,,0,0,0,,Резаэльмен шабуыл!
Dialogue: 0,0:09:29.74,0:09:31.74,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:09:31.74,0:09:33.74,Default,,0,0,0,,Тамшыны Nilberis және Gigantech деп атаңыз!
Dialogue: 0,0:09:33.74,0:09:35.74,Default,,0,0,0,,Мен саған рұқсат бермеймін...
Dialogue: 0,0:09:35.74,0:09:37.74,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:09:37.74,0:09:39.78,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:09:39.78,0:09:43.25,Default,,0,0,0,,Емдеу триггері! Nilberis қуаты плюс 10000➡
Dialogue: 0,0:09:43.25,0:09:45.22,Default,,0,0,0,,Зиянды қалпына келтіру!
Dialogue: 0,0:09:45.22,0:09:48.22,Default,,0,0,0,,Екінші тексеру... триггер жоқ.
Dialogue: 0,0:09:48.22,0:09:50.22,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:09:50.22,0:09:52.23,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:09:52.23,0:09:54.73,Default,,0,0,0,,Gigantech қуаты плюс 10000➡
Dialogue: 0,0:09:54.73,0:09:56.76,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:09:56.76,0:09:59.73,Default,,0,0,0,,Gigantech-пен шабуыл! күзетші.
Dialogue: 0,0:09:59.73,0:10:01.73,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:10:01.73,0:10:03.74,Default,,0,0,0,,Нилбериспен шабуыл!
Dialogue: 0,0:10:03.74,0:10:05.77,Default,,0,0,0,,Күзетшілерді ұстау.
Dialogue: 0,0:10:05.77,0:10:09.74,Default,,0,0,0,,Ku~! Нилберис шеберлігі: 1 картаны сал.
Dialogue: 0,0:10:11.28,0:10:14.25,Default,,0,0,0,,Бұрылыстың соңы. Мен шеше алмадым➡
Dialogue: 0,0:10:14.25,0:10:16.25,Default,,0,0,0,,Келесі - біздің шабуыл.
Dialogue: 0,0:10:16.25,0:10:19.22,Default,,0,0,0,,Мақсат қою үшін тағы екі ұпай жеткілікті.
Dialogue: 0,0:10:19.22,0:10:21.75,Default,,0,0,0,,Бірақ сіз, сіздің қолыңыз және сіздің шабуылдаушыңыз➡
Dialogue: 0,0:10:21.75,0:10:23.72,Default,,0,0,0,,Сіз оны қазіргі күзетшіңізбен пайдаландыңыз, солай ма?
Dialogue: 0,0:10:23.72,0:10:25.76,Default,,0,0,0,,Тәңірлік өнер болса да➡
Dialogue: 0,0:10:25.76,0:10:29.26,Default,,0,0,0,,Жартылай шабуыл болса, мен бұғаттаймын.
Dialogue: 0,0:10:29.26,0:10:32.23,Default,,0,0,0,,Егер күшің жетпесе, шегінуге болады.
Dialogue: 0,0:10:32.23,0:10:34.23,Default,,0,0,0,,Кері.
Dialogue: 0,0:10:34.23,0:10:36.24,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:10:36.24,0:10:38.24,Default,,0,0,0,,Сурет салу.
Dialogue: 0,0:10:38.24,0:10:40.24,Default,,0,0,0,,Бұл келді….
Dialogue: 0,0:10:40.24,0:10:42.24,Default,,0,0,0,,Ведрок Айдаһарға қоңырау шалыңыз.
Dialogue: 0,0:10:42.24,0:10:44.24,Default,,0,0,0,,Дағдыны белсендіру.
Dialogue: 0,0:10:44.24,0:10:46.25,Default,,0,0,0,,Жан заряды➡
Dialogue: 0,0:10:46.25,0:10:48.28,Default,,0,0,0,,Жаннан Замугқа қоңырау шалыңыз.
Dialogue: 0,0:10:48.28,0:10:50.78,Default,,0,0,0,,Сонымен қатар, палубаның жоғарғы үш картасынан таңдау үшін осы дағдыны пайдаланыңыз➡
Dialogue: 0,0:10:50.78,0:10:53.25,Default,,0,0,0,,Жаныңызға 1 картаны салып, 1 картаны салыңыз.
Dialogue: 0,0:10:54.72,0:10:56.72,Default,,0,0,0,,Артқы күзетіңіз бар ма?
Dialogue: 0,0:10:56.72,0:10:58.76,Default,,0,0,0,,Міне.
Dialogue: 0,0:10:58.76,0:11:00.73,Default,,0,0,0,,Zamoog көмегімен шабуыл.
Dialogue: 0,0:11:00.73,0:11:02.73,Default,,0,0,0,,Қуат +5000 шеберлікпен➡
Dialogue: 0,0:11:02.73,0:11:04.76,Default,,0,0,0,,Сыни плюс 1.
Dialogue: 0,0:11:04.76,0:11:06.77,Default,,0,0,0,,...
Dialogue: 0,0:11:06.77,0:11:09.27,Default,,0,0,0,,Благдомермен бірге авангардқа шабуыл жасаңыз.
Dialogue: 0,0:11:09.27,0:11:13.24,Default,,0,0,0,,Шеберлікпен қарсылас екі артқы қорғаушыны төмен қаратып байлайды.
Dialogue: 0,0:11:13.24,0:11:16.74,Default,,0,0,0,,Благдомердің күші плюс 20 000.
Dialogue: 0,0:11:16.74,0:11:19.25,Default,,0,0,0,,Ал химиктің шеберлігімен➡
Dialogue: 0,0:11:19.25,0:11:21.75,Default,,0,0,0,,Замуг стенді.
Dialogue: 0,0:11:21.75,0:11:23.75,Default,,0,0,0,,Нөлге➡ қайтару
Dialogue: 0,0:11:23.75,0:11:25.72,Default,,0,0,0,,Құдайдың шеберлігі ашылды!
Dialogue: 0,0:11:25.72,0:11:28.25,Default,,0,0,0,,Благдомейердің сыни плюс 1➡
Dialogue: 0,0:11:28.25,0:11:30.39,Default,,0,0,0,,Қарсыласыңыздың келесі айналымының соңына дейін➡
Dialogue: 0,0:11:30.39,0:11:33.76,Default,,0,0,0,,Қарсыластың авангарды барлық қабілеттерін жоғалтады➡
Dialogue: 0,0:11:33.76,0:11:36.26,Default,,0,0,0,,Сіз толық қорғанысты пайдалана алмайсыз.
Dialogue: 0,0:11:37.23,0:11:39.77,Default,,0,0,0,,А... білесің бе?
Dialogue: 0,0:11:39.77,0:11:43.24,Default,,0,0,0,,Брегедмейердің құдайлық шеберлігімен толық күзет ала алмау себебі➡
Dialogue: 0,0:11:43.24,0:11:45.24,Default,,0,0,0,,Тек сіздің қолыңыздан!
Dialogue: 0,0:11:45.24,0:11:47.24,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:11:47.24,0:11:49.74,Default,,0,0,0,,Міне, бұл!
Dialogue: 0,0:11:49.74,0:11:52.71,Default,,0,0,0,,Блиц ордені Аспан жарығы!
Dialogue: 0,0:11:53.75,0:11:55.75,Default,,0,0,0,,Палубаның жоғарғы картасына қараңыз➡
Dialogue: 0,0:11:55.75,0:11:57.78,Default,,0,0,0,,Сіз оны күзетшіге жібере аласыз.
Dialogue: 0,0:11:57.78,0:12:01.25,Default,,0,0,0,,Бұл палубадан тамаша қорғаушы алуға болатынын білдіреді.
Dialogue: 0,0:12:01.25,0:12:04.72,Default,,0,0,0,,Палубада сіз көре алатын бір ғана карта бар.
Dialogue: 0,0:12:04.72,0:12:06.73,Default,,0,0,0,,Ықтималдық бойынша, бұл жағдай...
Dialogue: 0,0:12:08.23,0:12:10.73,Default,,0,0,0,,Қол созбай жете алмайсың.
Dialogue: 0,0:12:11.80,0:12:14.27,Default,,0,0,0,,Мен керемет жасаймын!
Dialogue: 0,0:12:16.24,0:12:18.24,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:12:18.24,0:12:20.21,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:12:22.74,0:12:24.78,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:12:24.78,0:12:28.75,Default,,0,0,0,,Шындық оңай емес. Міне бітті!
Dialogue: 0,0:12:31.72,0:12:34.22,Default,,0,0,0,,Ғажайып па?
Dialogue: 0,0:12:40.73,0:12:42.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:42.73,0:12:44.76,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:12:44.76,0:12:47.73,Default,,0,0,0,,Сол кезде артқа тартсам ғой.
Dialogue: 0,0:12:52.74,0:12:55.24,Default,,0,0,0,,Хикари...кеш болды.
Dialogue: 0,0:12:57.74,0:12:59.71,Default,,0,0,0,,Уау...
Dialogue: 0,0:13:00.75,0:13:02.78,Default,,0,0,0,,Мен сізге кедергі келтіремін!
Dialogue: 0,0:13:02.78,0:13:05.72,Default,,0,0,0,,Ғабу...сен, рұқсатсыз кіруді доғар➡
Dialogue: 0,0:13:05.72,0:13:08.25,Default,,0,0,0,,Сіз таң қаласыз!
Dialogue: 0,0:13:08.25,0:13:11.72,Default,,0,0,0,,Сізге қауіп төнуі мүмкін.
Dialogue: 0,0:13:11.72,0:13:13.73,Default,,0,0,0,,Е...?
Dialogue: 0,0:13:13.73,0:13:16.26,Default,,0,0,0,,Менімен бірге жүр.
Dialogue: 0,0:13:16.26,0:13:19.23,Default,,0,0,0,,Бұл Тағдыр соғысына байланысты оқиға!
Dialogue: 0,0:13:25.74,0:13:29.21,Default,,0,0,0,,Сонымен... бұл қандай жағдай?
Dialogue: 0,0:13:29.21,0:13:32.25,Default,,0,0,0,,Мені Габукчи шақырды.
Dialogue: 0,0:13:32.25,0:13:35.25,Default,,0,0,0,,Бұл адам неге мұнда?
Dialogue: 0,0:13:35.25,0:13:38.72,Default,,0,0,0,,Мұндай жиіркенішті бет жасама➡
Dialogue: 0,0:13:38.72,0:13:41.22,Default,,0,0,0,,Ми-тан!
Dialogue: 0,0:13:41.22,0:13:44.72,Default,,0,0,0,,Жоқ! Хмм...
Dialogue: 0,0:13:44.72,0:13:46.73,Default,,0,0,0,,Алты адамды түгел шақырған адам➡ болды
Dialogue: 0,0:13:46.73,0:13:49.23,Default,,0,0,0,,Өйткені қажет➡
Dialogue: 0,0:13:49.23,0:13:53.27,Default,,0,0,0,,Бұл маған жүктелген міндет, жоқ...жауапкершілік.
Dialogue: 0,0:13:53.27,0:13:55.74,Default,,0,0,0,,Бұл күрделі оқиға болатын сияқты...
Dialogue: 0,0:13:56.70,0:13:58.71,Default,,0,0,0,,Тағдыр картасының иелері➡
Dialogue: 0,0:13:58.71,0:14:00.71,Default,,0,0,0,,Енді сөйлесейік➡
Dialogue: 0,0:14:00.71,0:14:03.21,Default,,0,0,0,,Тағдыр соғысы туралы шындық.
Dialogue: 0,0:14:03.21,0:14:05.24,Default,,0,0,0,,Ал мына мен➡
Dialogue: 0,0:14:05.24,0:14:07.21,Default,,0,0,0,,Габриэлиустың шынайы тұлғасы.
Dialogue: 0,0:14:10.72,0:14:12.72,Default,,0,0,0,,Бұл тұлып, солай ма?
Dialogue: 0,0:14:12.72,0:14:15.22,Default,,0,0,0,,Хмм...о, құрметті➡
Dialogue: 0,0:14:15.22,0:14:17.22,Default,,0,0,0,,Ең алдымен...
Dialogue: 0,0:14:17.22,0:14:20.23,Default,,0,0,0,,Авангардта бейнеленген әлем➡
Dialogue: 0,0:14:20.23,0:14:23.20,Default,,0,0,0,,Крей планетасы шынайы.
Dialogue: 0,0:14:23.20,0:14:27.20,Default,,0,0,0,,Шынайы ма? Мен осы жерден келдім.
Dialogue: 0,0:14:27.20,0:14:31.20,Default,,0,0,0,,Габу Крей планетасының бірлігі ме?
Dialogue: 0,0:14:31.20,0:14:33.24,Default,,0,0,0,,Иә...дегенмен➡
Dialogue: 0,0:14:33.24,0:14:35.71,Default,,0,0,0,,Мұнда тек рухтар бар➡
Dialogue: 0,0:14:35.71,0:14:38.21,Default,,0,0,0,,Негізгі дене Крей планетасында орналасқан.
Dialogue: 0,0:14:38.21,0:14:40.75,Default,,0,0,0,,Рухани дене? Бірінші орында➡
Dialogue: 0,0:14:40.75,0:14:43.75,Default,,0,0,0,,Жер мен Крейдің арасында алға-артқа жүру мүмкін емес➡
Dialogue: 0,0:14:43.75,0:14:47.22,Default,,0,0,0,,Әртүрлі жағдайлар мен жағдайларда➡
Dialogue: 0,0:14:47.22,0:14:49.26,Default,,0,0,0,,Денені бөліңіз➡
Dialogue: 0,0:14:49.26,0:14:52.73,Default,,0,0,0,,Бұл тек рухани денені жіберу арқылы мүмкін болады➡
Dialogue: 0,0:14:52.73,0:14:54.69,Default,,0,0,0,,Былайша айтқанда қулық.
Dialogue: 0,0:14:55.70,0:14:58.73,Default,,0,0,0,,Жерге осылай келу...
Dialogue: 0,0:14:58.73,0:15:01.23,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:15:04.70,0:15:07.24,Default,,0,0,0,,Азаматты жеңу.
Dialogue: 0,0:15:07.24,0:15:09.21,Default,,0,0,0,,Азаматтық?
Dialogue: 0,0:15:11.24,0:15:14.71,Default,,0,0,0,,Азаматтың физикалық денесі жоқ, тек рухани дене➡
Dialogue: 0,0:15:14.71,0:15:17.25,Default,,0,0,0,,Бөтеннің денесіне ие болу➡
Dialogue: 0,0:15:17.25,0:15:20.72,Default,,0,0,0,,Айналадағы тіршілік формаларының рухын бұзатын қасиеті бар➡
Dialogue: 0,0:15:20.72,0:15:22.72,Default,,0,0,0,,Менің отбасым➡
Dialogue: 0,0:15:22.72,0:15:24.72,Default,,0,0,0,,Менің санамды Азаматтық➡ ластады
Dialogue: 0,0:15:24.72,0:15:26.73,Default,,0,0,0,,Ашуланып қалды➡
Dialogue: 0,0:15:26.73,0:15:29.20,Default,,0,0,0,,Өзара шайқаста жойылды.
Dialogue: 0,0:15:34.20,0:15:36.24,Default,,0,0,0,,Отбасы үшін кек алу➡
Dialogue: 0,0:15:36.24,0:15:39.24,Default,,0,0,0,,Және басқа құрбандардың алдын алу үшін➡
Dialogue: 0,0:15:39.24,0:15:42.24,Default,,0,0,0,,Мен Клейден➡ білімнің барлық түрін үйрендім
Dialogue: 0,0:15:42.24,0:15:46.21,Default,,0,0,0,,Денесіз Азаматты жеңу әдістемесін орындады.
Dialogue: 0,0:15:46.21,0:15:48.21,Default,,0,0,0,,Мен азаматтықпын➡
Dialogue: 0,0:15:48.21,0:15:50.22,Default,,0,0,0,,Мен бір қадам ғана қалдым, бірақ➡
Dialogue: 0,0:15:50.22,0:15:52.22,Default,,0,0,0,,Мен қашып құтылдым.
Dialogue: 0,0:15:53.25,0:15:57.22,Default,,0,0,0,,Түсіндім~ Ол адамның қашатын жері – Жер➡
Dialogue: 0,0:15:57.22,0:16:00.23,Default,,0,0,0,,Габу-чан сенің соңынан ерді ме?
Dialogue: 0,0:16:00.23,0:16:02.73,Default,,0,0,0,,Дұрыс. (Нао/Микото) E!
Dialogue: 0,0:16:02.73,0:16:05.23,Default,,0,0,0,,Мұндай қауіпті жігіт жер бетінде...
Dialogue: 0,0:16:05.23,0:16:08.70,Default,,0,0,0,,Бұл қалайша Тағдыр соғысына әкеледі?
Dialogue: 0,0:16:08.70,0:16:11.20,Default,,0,0,0,,Жобалау күші қажет болды.
Dialogue: 0,0:16:13.21,0:16:15.21,Default,,0,0,0,,Жобалық күш дегеніміз не➡
Dialogue: 0,0:16:15.21,0:16:18.71,Default,,0,0,0,,Бұл барлық принциптерді өзгерте алатын күш➡
Dialogue: 0,0:16:18.71,0:16:21.71,Default,,0,0,0,,Баяғыда үлкен шайқас басталды➡
Dialogue: 0,0:16:21.71,0:16:24.22,Default,,0,0,0,,Ерекшелік ретінде Таудың ұрыс алаңы➡
Dialogue: 0,0:16:24.22,0:16:27.72,Default,,0,0,0,,Екі дүние шексіз жақын болды➡
Dialogue: 0,0:16:27.72,0:16:30.22,Default,,0,0,0,,Сол әсердің нәтижесінде, ➡
Dialogue: 0,0:16:30.22,0:16:32.73,Default,,0,0,0,,Құрамында үлкен көлемдегі жобалық күш бар➡
Dialogue: 0,0:16:32.73,0:16:34.73,Default,,0,0,0,,Бұл тағдырдың картасы➡
Dialogue: 0,0:16:34.73,0:16:37.73,Default,,0,0,0,,Тағдырларды бір-бірімен соғыстыру арқылы➡
Dialogue: 0,0:16:37.73,0:16:40.70,Default,,0,0,0,,Бұл жобалық күшті бір ➡-ге жинау техникасы
Dialogue: 0,0:16:40.70,0:16:42.70,Default,,0,0,0,,Мен ойладым.
Dialogue: 0,0:16:43.70,0:16:46.21,Default,,0,0,0,,Неліктен бұл карта төбелесі?
Dialogue: 0,0:16:47.21,0:16:49.71,Default,,0,0,0,,Авангард бұл...Саз және Жер➡
Dialogue: 0,0:16:49.71,0:16:52.75,Default,,0,0,0,,Өйткені ол бөлімшелер мен жауынгерлерді байланыстырады.
Dialogue: 0,0:16:52.75,0:16:55.72,Default,,0,0,0,,Сонымен, біз жай ғана пайдамызға түсті.
Dialogue: 0,0:16:55.72,0:16:57.72,Default,,0,0,0,,Мен оны жоққа шығармаймын➡
Dialogue: 0,0:16:57.72,0:17:00.75,Default,,0,0,0,,Бірақ сені алдайын деген ойым болған жоқ➡
Dialogue: 0,0:17:00.75,0:17:03.76,Default,,0,0,0,,Тағдыр соғысы – жобалық күштердің жиыны➡
Dialogue: 0,0:17:03.76,0:17:07.76,Default,,0,0,0,,Бұл жер мен саздың арасынан қақпа жасау әдісі➡
Dialogue: 0,0:17:07.76,0:17:10.20,Default,,0,0,0,,Жеңімпаз Тағдырдың құдіреті күшейді➡
Dialogue: 0,0:17:10.20,0:17:12.20,Default,,0,0,0,,Екі әлемді кесіп өту➡
Dialogue: 0,0:17:12.20,0:17:14.70,Default,,0,0,0,,Осыдан кейін жол көлік қозғалысына ашылды➡
Dialogue: 0,0:17:14.70,0:17:17.74,Default,,0,0,0,,Хирургиялық әдіс тұрақтандырады және қақпаны жасайды➡
Dialogue: 0,0:17:17.74,0:17:22.21,Default,,0,0,0,,Бұл менің мақсатыма жетуі керек еді...
Dialogue: 0,0:17:22.21,0:17:24.21,Default,,0,0,0,,Бұл ... болуы керек еді.
Dialogue: 0,0:17:24.21,0:17:27.21,Default,,0,0,0,,Сіз бұл формада Civilt-ті жеңе алмайсыз➡
Dialogue: 0,0:17:27.21,0:17:29.25,Default,,0,0,0,,Қақпа арқылы➡
Dialogue: 0,0:17:29.25,0:17:32.75,Default,,0,0,0,,Денемді жіберу керек болды➡
Dialogue: 0,0:17:32.75,0:17:36.26,Default,,0,0,0,,Содан кейін Жердің бір жерінде жасырынып жатқан Азаматты табыңыз➡
Dialogue: 0,0:17:36.26,0:17:39.73,Default,,0,0,0,,Төңкеру...бұл менің жоспарым еді.
Dialogue: 0,0:17:40.76,0:17:44.23,Default,,0,0,0,,Соңғы кезеңде күтпеген жағдай орын алды➡
Dialogue: 0,0:17:44.23,0:17:47.23,Default,,0,0,0,,Хирургиялық формула қайта жазылды➡
Dialogue: 0,0:17:47.23,0:17:50.70,Default,,0,0,0,,Қақпа жабылып, орнына басқа бірдеңе болды➡
Dialogue: 0,0:17:50.70,0:17:53.21,Default,,0,0,0,,Бұл карта болды.
Dialogue: 0,0:17:55.24,0:17:57.74,Default,,0,0,0,,Не ойлап тұрғаныңызды білмеймін➡
Dialogue: 0,0:17:57.74,0:18:00.71,Default,,0,0,0,,Азамат - Тағдыр картасының иесі➡
Dialogue: 0,0:18:00.71,0:18:02.68,Default,,0,0,0,,Ол сізбен байланыса алады.
Dialogue: 0,0:18:04.22,0:18:06.29,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:06.29,0:18:08.22,Default,,0,0,0,,（📱）
Dialogue: 0,0:18:08.22,0:18:10.19,Default,,0,0,0,,Кешіріңіз, бұл менмін.
Dialogue: 0,0:18:12.73,0:18:15.70,Default,,0,0,0,,E! Не болды, Акина?
Dialogue: 0,0:18:18.73,0:18:21.73,Default,,0,0,0,,Бұл таудағы ұрыс алаңы емес пе?
Dialogue: 0,0:18:23.70,0:18:25.71,Default,,0,0,0,,Ол қозғала бастады ма?
Dialogue: 0,0:18:36.72,0:18:38.72,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:18:38.72,0:18:40.72,Default,,0,0,0,,Сізді осында көргеніме қуаныштымын.
Dialogue: 0,0:18:43.22,0:18:45.26,Default,,0,0,0,,Айкава?
Dialogue: 0,0:18:45.26,0:18:49.23,Default,,0,0,0,,Сіз... Тағдыр соғысы туралы қайдан білесіз!
Dialogue: 0,0:18:49.23,0:18:51.20,Default,,0,0,0,,Және сол хабарлама➡
Dialogue: 0,0:18:51.20,0:18:53.70,Default,,0,0,0,,Жер бетінде не болып жатыр?
Dialogue: 0,0:18:53.70,0:18:57.24,Default,,0,0,0,,Мен сізге түсіндіре аламын➡
Dialogue: 0,0:18:57.24,0:19:00.74,Default,,0,0,0,,Бұл рөлді лайықтырақ біреуге қалдыруым керек пе?
Dialogue: 0,0:19:04.21,0:19:06.21,Default,,0,0,0,,Біраз уақыт өтті➡
Dialogue: 0,0:19:06.21,0:19:08.18,Default,,0,0,0,,Габуэлий.
Dialogue: 0,0:19:09.22,0:19:12.22,Default,,0,0,0,,Азаматтық! Әлгі тұлып?
Dialogue: 0,0:19:12.22,0:19:15.22,Default,,0,0,0,,Бұл сіздің әрекетіңіз болды ма?
Dialogue: 0,0:19:15.22,0:19:17.22,Default,,0,0,0,,Сіз не жоспарлап отырсыз?
Dialogue: 0,0:19:17.22,0:19:20.23,Default,,0,0,0,,Жоспарлау - жаман идея➡
Dialogue: 0,0:19:20.23,0:19:22.70,Default,,0,0,0,,Сіз сияқты.
Dialogue: 0,0:19:22.70,0:19:24.70,Default,,0,0,0,,Не?
Dialogue: 0,0:19:26.73,0:19:30.24,Default,,0,0,0,,Тағдыр соғысын бастайық!
Dialogue: 0,0:19:31.24,0:19:33.24,Default,,0,0,0,,Тағдыр соғысы…➡
Dialogue: 0,0:19:33.24,0:19:36.21,Default,,0,0,0,,Тілегін орындайтын қармақпен тірі жанды аулау➡
Dialogue: 0,0:19:36.21,0:19:38.74,Default,,0,0,0,,Қақтығысты пайдалану➡
Dialogue: 0,0:19:38.74,0:19:42.72,Default,,0,0,0,,Бұл шынымен тиімді жүйе, солай емес пе? сен!
Dialogue: 0,0:19:43.72,0:19:45.72,Default,,0,0,0,,Тірі затқа ұқсайды➡
Dialogue: 0,0:19:45.72,0:19:47.69,Default,,0,0,0,,Өте жақсы...
Dialogue: 0,0:19:48.75,0:19:51.72,Default,,0,0,0,,Тірі заттар өзімшіл болуы керек➡
Dialogue: 0,0:19:51.72,0:19:53.73,Default,,0,0,0,,Менің қалауым➡
Dialogue: 0,0:19:53.73,0:19:56.73,Default,,0,0,0,,Тілек үшін басқаларды жеу➡
Dialogue: 0,0:19:56.73,0:20:00.70,Default,,0,0,0,,Бұл дүние анықтаған дұрыс бейне.
Dialogue: 0,0:20:00.70,0:20:02.74,Default,,0,0,0,,Шындықты бұрмалау➡
Dialogue: 0,0:20:02.74,0:20:05.71,Default,,0,0,0,,Жанқиярлықты бағалайтын ақымақ адамдар көбейіп кетті➡
Dialogue: 0,0:20:05.71,0:20:07.71,Default,,0,0,0,,Бүгінгі әлем –➡
Dialogue: 0,0:20:07.71,0:20:11.21,Default,,0,0,0,,Бұл шынымен жиіркенішті.
Dialogue: 0,0:20:12.78,0:20:14.78,Default,,0,0,0,,｟Бұл не жігіт➡
Dialogue: 0,0:20:14.78,0:20:17.22,Default,,0,0,0,,Бұл шынымен жағымсыз сезім. ｠
Dialogue: 0,0:20:17.22,0:20:19.22,Default,,0,0,0,,Габуэлий➡
Dialogue: 0,0:20:19.22,0:20:21.75,Default,,0,0,0,,Өз техникаңызды қолдану➡
Dialogue: 0,0:20:21.75,0:20:24.76,Default,,0,0,0,,Мен алты картаны көрсеттім.
Dialogue: 0,0:20:25.73,0:20:29.73,Default,,0,0,0,,Аты - Тағдыр картасы➡
Dialogue: 0,0:20:29.73,0:20:32.73,Default,,0,0,0,,Тағдыры мен тағдыры соқтығысса ➡
Dialogue: 0,0:20:32.73,0:20:36.20,Default,,0,0,0,,Неғұрлым күшті дизайн күштері жиналады.
Dialogue: 0,0:20:36.20,0:20:38.77,Default,,0,0,0,,Рұқсатсыз әрекет етпеңіз!
Dialogue: 0,0:20:38.77,0:20:42.21,Default,,0,0,0,,Мен «Тағдыр» картасын жинаймын.
Dialogue: 0,0:20:42.21,0:20:44.71,Default,,0,0,0,,Мен саған қалағаныңды істеуге рұқсат бермеймін!
Dialogue: 0,0:20:45.75,0:20:47.71,Default,,0,0,0,,Ал сендер ше?
Dialogue: 0,0:20:47.71,0:20:50.72,Default,,0,0,0,,Тағдыр картасының иелері.
Dialogue: 0,0:20:50.72,0:20:52.75,Default,,0,0,0,,Тағдыр соғысында➡
Dialogue: 0,0:20:52.75,0:20:55.72,Default,,0,0,0,,Бір ғана адам өз тілегін орындай алды.
Dialogue: 0,0:20:55.72,0:20:58.72,Default,,0,0,0,,Егер менің тағы бір мүмкіндігім болса➡
Dialogue: 0,0:20:58.72,0:21:02.19,Default,,0,0,0,,Келесі жолы тілегімді орындағым келеді➡
Dialogue: 0,0:21:02.19,0:21:04.20,Default,,0,0,0,,Сіз солай ойлайсыз ба? ауызыңды жап!
Dialogue: 0,0:21:05.20,0:21:08.20,Default,,0,0,0,,Тірі заттардың қалауының түбі жоқ➡
Dialogue: 0,0:21:08.20,0:21:10.20,Default,,0,0,0,,Жүрек тепе-теңдігі ұсақ-түйек нәрселермен реттеледі➡
Dialogue: 0,0:21:10.20,0:21:13.21,Default,,0,0,0,,Еңкейту оңай➡
Dialogue: 0,0:21:13.21,0:21:15.21,Default,,0,0,0,,Мысалы ➡
Dialogue: 0,0:21:15.21,0:21:17.21,Default,,0,0,0,,Осы сияқты...
Dialogue: 0,0:21:18.71,0:21:20.68,Default,,0,0,0,,Е...!
Dialogue: 0,0:21:21.75,0:21:24.75,Default,,0,0,0,,«Тағдыр» картасының иесін таныстырып өтейін.
Dialogue: 0,0:21:26.72,0:21:28.72,Default,,0,0,0,,Шексіз білімге ұмтылу➡
Dialogue: 0,0:21:28.72,0:21:31.72,Default,,0,0,0,,Олардан асып түсу үшін тістеріңізді қайрап алыңыз➡
Dialogue: 0,0:21:31.72,0:21:34.23,Default,,0,0,0,,Таразыға не қойғанын алу➡
Dialogue: 0,0:21:34.23,0:21:36.70,Default,,0,0,0,,Жоғарғы болу➡
Dialogue: 0,0:21:36.70,0:21:39.70,Default,,0,0,0,,Қорғауға дайын болыңыз ➡
Dialogue: 0,0:21:39.70,0:21:43.20,Default,,0,0,0,,Тіпті уақыттың ақыры да бұралған.
Dialogue: 0,0:21:43.20,0:21:45.70,Default,,0,0,0,,Бұл өтірік... солай ма?
Dialogue: 0,0:21:46.77,0:21:50.21,Default,,0,0,0,,Таңдалған адам - сіздің тағдырлас серіктесіңіз➡
Dialogue: 0,0:21:50.21,0:21:52.24,Default,,0,0,0,,Келіңіздер! ➡
Dialogue: 0,0:21:52.24,0:21:55.25,Default,,0,0,0,,Тағдырдан асқан шайқас бастайық!
Dialogue: 0,0:21:56.22,0:21:58.18,Default,,0,0,0,,Тағдырлы шайқас басталады!
Dialogue: 0,0:21:59.68,0:22:05.68,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory