Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.80,0:00:06.77,Default,,0,0,0,,Хикари….
Dialogue: 0,0:00:08.27,0:00:10.77,Default,,0,0,0,,Киома, сен мұнда не үшін келдің?
Dialogue: 0,0:00:10.77,0:00:12.77,Default,,0,0,0,,Түсінбейсіз бе? Тайзо➡
Dialogue: 0,0:00:12.77,0:00:15.28,Default,,0,0,0,,Мен саған бағыт-бағдар беруге келдім.
Dialogue: 0,0:00:15.28,0:00:17.28,Default,,0,0,0,,A…. (Динг Сенка) Ой! Нао➡
Dialogue: 0,0:00:17.28,0:00:20.28,Default,,0,0,0,,Мен мұнда сізбен бір мәселені шешу үшін келдім, солай ма?
Dialogue: 0,0:00:20.28,0:00:22.28,Default,,0,0,0,,Сенька….
Dialogue: 0,0:00:22.28,0:00:24.25,Default,,0,0,0,,Көптен бері көрмегелі, Масанори.
Dialogue: 0,0:00:36.27,0:00:38.27,Default,,0,0,0,,Йоцуги-кун➡
Dialogue: 0,0:00:38.27,0:00:40.27,Default,,0,0,0,,Сіздің қарсыласыңыз – мен.
Dialogue: 0,0:00:41.80,0:00:45.31,Default,,0,0,0,,Енді барлығың карточкаларыңа қараңдар.
Dialogue: 0,0:00:48.28,0:00:50.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:51.28,0:00:53.28,Default,,0,0,0,,Елтаңба!
Dialogue: 0,0:00:53.28,0:00:55.25,Default,,0,0,0,,Мен қайтып келдім.
Dialogue: 0,0:00:58.79,0:01:01.79,Default,,0,0,0,,Азаматтық...сіз!
Dialogue: 0,0:01:01.79,0:01:04.26,Default,,0,0,0,,Карта әлдеқашан жауап беріп жатыр➡
Dialogue: 0,0:01:04.26,0:01:06.76,Default,,0,0,0,,Көңілді болайық.
Dialogue: 0,0:01:06.76,0:01:08.76,Default,,0,0,0,,Тағдырлы шайқас!
Dialogue: 0,0:02:41.22,0:02:43.26,Default,,0,0,0,,Тағдырлы шайқас➡
Dialogue: 0,0:02:43.26,0:02:46.76,Default,,0,0,0,,Бұл «Тағдыр командасы» және «Тағдыр командасы» болып бөлінген командалық шайқас.
Dialogue: 0,0:02:46.76,0:02:49.26,Default,,0,0,0,,Команда…. (Азаматтық) Жеңіске жеткен команда ➡
Dialogue: 0,0:02:49.26,0:02:51.77,Default,,0,0,0,,Барлық жобалық күштерді қабылдаңыз➡
Dialogue: 0,0:02:51.77,0:02:55.24,Default,,0,0,0,,Сіз бүкіл команданың тілектерін орындай аласыз.
Dialogue: 0,0:02:55.24,0:02:57.24,Default,,0,0,0,,Барлығына?
Dialogue: 0,0:02:57.24,0:02:59.27,Default,,0,0,0,,Бірақ 3-ке 3 болғанда не істейсіз?
Dialogue: 0,0:02:59.27,0:03:02.78,Default,,0,0,0,,Бұл жағдайда матчты өкілдік матч шешеді.
Dialogue: 0,0:03:02.78,0:03:04.78,Default,,0,0,0,,Сондықтан ұтыс мүмкін емес.
Dialogue: 0,0:03:06.82,0:03:09.22,Default,,0,0,0,,📱
Dialogue: 0,0:03:09.22,0:03:12.22,Default,,0,0,0,,Бұл сіздің тағдырыңызды оятатын белгі! ➡
Dialogue: 0,0:03:12.22,0:03:14.72,Default,,0,0,0,,Есте қалатын бірінші шешуші шайқас➡
Dialogue: 0,0:03:14.72,0:03:17.73,Default,,0,0,0,,Кім және кім?
Dialogue: 0,0:03:17.73,0:03:19.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:19.76,0:03:23.77,Default,,0,0,0,,Нөлдік тағдырға қарсы шексіз тағдыр...
Dialogue: 0,0:03:24.73,0:03:27.24,Default,,0,0,0,,Бұл Суо...
Dialogue: 0,0:03:29.74,0:03:31.71,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:03:34.74,0:03:36.71,Default,,0,0,0,,Сіз алға барасыз.
Dialogue: 0,0:03:43.22,0:03:45.22,Default,,0,0,0,,Хикари!
Dialogue: 0,0:03:45.22,0:03:47.22,Default,,0,0,0,,Үлкен аға➡
Dialogue: 0,0:03:47.22,0:03:50.23,Default,,0,0,0,,Мен байсалдымын.
Dialogue: 0,0:03:50.23,0:03:52.76,Default,,0,0,0,,Хоу! Мотивацияға толы.
Dialogue: 0,0:03:52.76,0:03:54.73,Default,,0,0,0,,Хикари!
Dialogue: 0,0:03:54.73,0:03:56.77,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:03:56.77,0:03:58.77,Default,,0,0,0,,Акина Акина. а...!
Dialogue: 0,0:03:58.77,0:04:02.24,Default,,0,0,0,,Сіз онымен күресуіңіз керек➡
Dialogue: 0,0:04:02.24,0:04:04.74,Default,,0,0,0,,Тағдыр – себеп-салдар тізбегі➡
Dialogue: 0,0:04:04.74,0:04:07.24,Default,,0,0,0,,Сіз қашып құтыла алмайсыз.
Dialogue: 0,0:04:07.24,0:04:09.78,Default,,0,0,0,,Мұны кім шешті!
Dialogue: 0,0:04:09.78,0:04:12.75,Default,,0,0,0,,Менің әпкем сол қалпында қалғаны дұрыс па? не?
Dialogue: 0,0:04:12.75,0:04:15.28,Default,,0,0,0,,Маған да айтыңызшы, Габриэлиус.
Dialogue: 0,0:04:15.28,0:04:19.25,Default,,0,0,0,,Азаматтың тірі жандардың қалауын ұлғайту қабілеті бар➡
Dialogue: 0,0:04:19.25,0:04:22.26,Default,,0,0,0,,Ақырында құтыруға итермелейтін қасиеті бар➡
Dialogue: 0,0:04:22.26,0:04:25.23,Default,,0,0,0,,Оны жайына қалдырсаң, менің отбасыммен бірдей боласың➡
Dialogue: 0,0:04:25.23,0:04:27.26,Default,,0,0,0,,Келесі орындалады.
Dialogue: 0,0:04:27.26,0:04:29.76,Default,,0,0,0,,Не...! Оған түсу? ➡
Dialogue: 0,0:04:29.76,0:04:33.24,Default,,0,0,0,,Мен жай ғана мені ұстап тұрған нәрседен құтыламын➡
Dialogue: 0,0:04:33.24,0:04:35.27,Default,,0,0,0,,Бұл сіздің ойыңызды босату туралы.
Dialogue: 0,0:04:35.27,0:04:38.24,Default,,0,0,0,,Сіз...! дегенмен! Бір ғана➡
Dialogue: 0,0:04:38.24,0:04:40.24,Default,,0,0,0,,Оны қалпына келтірудің жолы бар➡
Dialogue: 0,0:04:40.24,0:04:42.78,Default,,0,0,0,,Тек төбелесте оларды жеңіңіз.
Dialogue: 0,0:04:42.78,0:04:45.25,Default,,0,0,0,,A…. (Азаматтық) Психикалық ластану – ➡
Dialogue: 0,0:04:45.25,0:04:48.25,Default,,0,0,0,,Жекпе-жекте жеңіліп қалсаңыз, оны шешуге болады.
Dialogue: 0,0:04:48.25,0:04:50.72,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз күрескіңіз келуі керек.
Dialogue: 0,0:04:52.75,0:04:55.22,Default,,0,0,0,,Бір-бірі барын берген ұрыс ➡
Dialogue: 0,0:04:55.22,0:04:57.23,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:04:59.23,0:05:01.26,Default,,0,0,0,,Хмм...екінші жағынан➡
Dialogue: 0,0:05:01.26,0:05:04.23,Default,,0,0,0,,Егер сіз ол адамға қарсы жеңбесеңіз, сіз қалыпты жағдайға оралмайсыз.
Dialogue: 0,0:05:04.23,0:05:06.74,Default,,0,0,0,,Ол не ойласа да➡
Dialogue: 0,0:05:06.74,0:05:08.74,Default,,0,0,0,,Енді жалғыз амал – күресу.
Dialogue: 0,0:05:08.74,0:05:10.71,Default,,0,0,0,,Міне!
Dialogue: 0,0:05:11.77,0:05:14.24,Default,,0,0,0,,Сізді не уайымдады? а….
Dialogue: 0,0:05:14.24,0:05:16.21,Default,,0,0,0,,Тек жекпе-жекте жеңіңіз, солай ма?
Dialogue: 0,0:05:18.25,0:05:20.75,Default,,0,0,0,,Сен істесең, мен де істеймін.
Dialogue: 0,0:05:22.72,0:05:25.79,Default,,0,0,0,,Хмм... орындаймыз! Міндетті түрде жеңіңіз➡
Dialogue: 0,0:05:25.79,0:05:28.26,Default,,0,0,0,,Мен Хикариді қайтарамын!
Dialogue: 0,0:05:28.26,0:05:31.26,Default,,0,0,0,,Дұрыс...жеңгенше жақсы.
Dialogue: 0,0:05:31.26,0:05:33.73,Default,,0,0,0,,Бұл өте қарапайым.
Dialogue: 0,0:05:33.73,0:05:35.83,Default,,0,0,0,,Мен сізге бір рет ат салайын!
Dialogue: 0,0:05:35.83,0:05:37.73,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:05:37.73,0:05:40.74,Default,,0,0,0,,О...! Қызық болып барады.
Dialogue: 0,0:05:42.74,0:05:45.24,Default,,0,0,0,,Суо, жеңеміз!
Dialogue: 0,0:05:45.24,0:05:47.21,Default,,0,0,0,,Мен барамын.
Dialogue: 0,0:05:52.25,0:05:54.75,Default,,0,0,0,,Шынында➡
Dialogue: 0,0:05:54.75,0:05:57.22,Default,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:06:10.27,0:06:12.23,Default,,0,0,0,,Куон Айкава➡
Dialogue: 0,0:06:12.23,0:06:14.24,Default,,0,0,0,,Суу Суо➡
Dialogue: 0,0:06:14.24,0:06:16.74,Default,,0,0,0,,Карточкаңызды көтеріп, айқайлаңыз! ➡
Dialogue: 0,0:06:16.74,0:06:18.71,Default,,0,0,0,,Соғыс белгісі!
Dialogue: 0,0:06:20.28,0:06:22.78,Default,,0,0,0,,Тағдырға... Шешіңіз.
Dialogue: 0,0:06:23.75,0:06:25.71,Default,,0,0,0,,Құдай!
Dialogue: 0,0:06:27.25,0:06:30.29,Default,,0,0,0,,Уақыт аяқталды➡
Dialogue: 0,0:06:30.29,0:06:33.26,Default,,0,0,0,,Тағдырдың алғашқы шайқасын бастайық.
Dialogue: 0,0:06:34.26,0:06:37.76,Default,,0,0,0,,Шексіз тағдыр Ол қандай шеберлік?
Dialogue: 0,0:06:38.73,0:06:41.23,Default,,0,0,0,,Оларда да бар ма? Құдайдың шеберлігі...
Dialogue: 0,0:06:41.23,0:06:44.23,Default,,0,0,0,,Йоцуги-сенпай... жақсысың ба?
Dialogue: 0,0:06:44.23,0:06:46.23,Default,,0,0,0,,Жарайды. а….
Dialogue: 0,0:06:46.23,0:06:48.24,Default,,0,0,0,,Ол...
Dialogue: 0,0:06:48.24,0:06:50.24,Default,,0,0,0,,Өйткені ол күшті.
Dialogue: 0,0:06:51.77,0:06:55.24,Default,,0,0,0,,Менің есте сақтау қабілетім сол апаттан кейін қайта оралмаған сияқты.
Dialogue: 0,0:06:55.24,0:06:57.21,Default,,0,0,0,,Ым? а….
Dialogue: 0,0:06:58.75,0:07:01.25,Default,,0,0,0,,Сізде қызығушылық болды ма?
Dialogue: 0,0:07:01.25,0:07:04.75,Default,,0,0,0,,Сенің кім екенің маңызды емес➡
Dialogue: 0,0:07:04.75,0:07:08.76,Default,,0,0,0,,Егер сен менің алдымда тұрсаң, мен сені жоққа ғана түсіремін.
Dialogue: 0,0:07:08.76,0:07:10.73,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:07:16.23,0:07:18.20,Default,,0,0,0,,Тегіс айдаһар.
Dialogue: 0,0:07:18.20,0:07:20.20,Default,,0,0,0,,Қуыстың мализиясы.
Dialogue: 0,0:07:20.20,0:07:22.20,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:07:22.20,0:07:25.74,Default,,0,0,0,,Шаян айдаһарға міну Бұрылыстың соңы.
Dialogue: 0,0:07:25.74,0:07:28.24,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:07:28.24,0:07:31.71,Default,,0,0,0,,Ride Hollow Raptor Call Mind Hacker➡
Dialogue: 0,0:07:31.71,0:07:33.72,Default,,0,0,0,,Раптормен шабуыл.
Dialogue: 0,0:07:33.72,0:07:36.72,Default,,0,0,0,,Күзетші жоқ. Хакермен шабуыл.
Dialogue: 0,0:07:36.72,0:07:39.22,Default,,0,0,0,,Күзетші. Соңына бұрылу.
Dialogue: 0,0:07:39.22,0:07:41.22,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:07:41.22,0:07:43.22,Default,,0,0,0,,Мантициз айдаһарына мініңіз➡
Dialogue: 0,0:07:43.22,0:07:46.23,Default,,0,0,0,,Морфо Кларенс Фоксил➡ қоңырау шалыңыз
Dialogue: 0,0:07:46.23,0:07:48.20,Default,,0,0,0,,Кларенспен шабуыл.
Dialogue: 0,0:07:48.20,0:07:50.73,Default,,0,0,0,,Күзетші. Манти Орақпен шабуыл.
Dialogue: 0,0:07:50.73,0:07:54.24,Default,,0,0,0,,Күзетші жоқ. Морфомен шабуыл.
Dialogue: 0,0:07:54.24,0:07:56.20,Default,,0,0,0,,Дағды +10000 қуат.
Dialogue: 0,0:07:56.20,0:07:58.21,Default,,0,0,0,,...
Dialogue: 0,0:07:58.21,0:08:00.24,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:08:00.24,0:08:03.21,Default,,0,0,0,,Сіз маған кенет шабуыл жасадыңыз. Тіпті Йоцуги-сенпай➡
Dialogue: 0,0:08:03.21,0:08:05.21,Default,,0,0,0,,Бұдан былай.
Dialogue: 0,0:08:05.21,0:08:07.22,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:08:07.22,0:08:09.25,Default,,0,0,0,,Бос азуға міну➡
Dialogue: 0,0:08:09.25,0:08:11.22,Default,,0,0,0,,Палубаның жоғарғы 3 картасын жанға салу үшін шеберлікті қолданыңыз➡
Dialogue: 0,0:08:11.22,0:08:13.22,Default,,0,0,0,,1 картаны сал.
Dialogue: 0,0:08:13.22,0:08:15.22,Default,,0,0,0,,Ведрокқа қоңырау шалыңыз➡
Dialogue: 0,0:08:15.22,0:08:17.73,Default,,0,0,0,,Барлаушыны жаннан шеберлікпен шақырыңыз➡
Dialogue: 0,0:08:17.73,0:08:21.70,Default,,0,0,0,,Call Explorer көмегімен алхимикке шабуыл жасаңыз.
Dialogue: 0,0:08:21.70,0:08:23.73,Default,,0,0,0,,Кесу.
Dialogue: 0,0:08:23.73,0:08:25.70,Default,,0,0,0,,Азумен шабуыл. Күзетші жоқ.
Dialogue: 0,0:08:25.70,0:08:27.74,Default,,0,0,0,,Драйверді тексеру➡
Dialogue: 0,0:08:27.74,0:08:29.74,Default,,0,0,0,,Критикалық триггер.
Dialogue: 0,0:08:29.74,0:08:33.24,Default,,0,0,0,,Ведроктың күші +10000 Фангтың критикалық күші +1.
Dialogue: 0,0:08:34.71,0:08:36.78,Default,,0,0,0,,Ведрокпен шабуыл.
Dialogue: 0,0:08:36.78,0:08:38.71,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:08:38.71,0:08:41.25,Default,,0,0,0,,Explorer-ді жанға салып, бұрылысты аяқтаңыз.
Dialogue: 0,0:08:41.25,0:08:45.72,Default,,0,0,0,,Неге ұрысасың? Сіздің орындағыңыз келетін тілегіңіз бар ма?
Dialogue: 0,0:08:45.72,0:08:48.22,Default,,0,0,0,,Жоқ...бірақ мен күресемін➡
Dialogue: 0,0:08:48.22,0:08:51.23,Default,,0,0,0,,Мен мұнымен айналысқым келеді.
Dialogue: 0,0:08:51.23,0:08:54.73,Default,,0,0,0,,А... түсіндім. Менде біреуі бар.
Dialogue: 0,0:08:54.73,0:08:56.70,Default,,0,0,0,,Орындағым келетін тілегім.
Dialogue: 0,0:09:00.20,0:09:02.27,Default,,0,0,0,,Мен Крей планетасына барғым келеді.
Dialogue: 0,0:09:02.27,0:09:04.71,Default,,0,0,0,,E? Бірақ Крей планетасы➡
Dialogue: 0,0:09:04.71,0:09:07.74,Default,,0,0,0,,Алды-артына кете алмайсың... Мм....
Dialogue: 0,0:09:07.74,0:09:10.25,Default,,0,0,0,,Мен байыптымын, сондықтан➡
Dialogue: 0,0:09:10.25,0:09:12.71,Default,,0,0,0,,Барлық күш-жігер мен зерттеулер жасалды.
Dialogue: 0,0:09:12.71,0:09:14.75,Default,,0,0,0,,Бірақ нәтиже➡
Dialogue: 0,0:09:14.75,0:09:18.25,Default,,0,0,0,,Қазіргі технологиямен мүмкін емес болып шықты.
Dialogue: 0,0:09:18.25,0:09:20.76,Default,,0,0,0,,Сол себепті тағдырлы шайқасқа қатыстым➡
Dialogue: 0,0:09:20.76,0:09:23.73,Default,,0,0,0,,Технологияның шегінен өту.
Dialogue: 0,0:09:24.76,0:09:27.20,Default,,0,0,0,,Мен Крей планетасының жеріне қондым.
Dialogue: 0,0:09:27.20,0:09:29.70,Default,,0,0,0,,Бұл тілек міндетті түрде орындалады➡
Dialogue: 0,0:09:29.70,0:09:31.70,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:09:31.70,0:09:33.70,Default,,0,0,0,,Біз жеңілуге шыдай алмаймыз!
Dialogue: 0,0:09:33.70,0:09:36.20,Default,,0,0,0,,Менің кезегім! ➡
Dialogue: 0,0:09:36.20,0:09:38.24,Default,,0,0,0,,Атмосфераны басқаратын жұлдыздардың даналығы➡
Dialogue: 0,0:09:38.24,0:09:40.71,Default,,0,0,0,,Әлемді барлық жерде көріңіз!
Dialogue: 0,0:09:40.71,0:09:42.71,Default,,0,0,0,,Жүр!
Dialogue: 0,0:09:46.71,0:09:50.22,Default,,0,0,0,,Шексіз тағдыр➡
Dialogue: 0,0:09:50.22,0:09:52.19,Default,,0,0,0,,Левидрас!
Dialogue: 0,0:09:56.72,0:09:58.73,Default,,0,0,0,,Мантика шеберлігін белсендіру➡
Dialogue: 0,0:09:58.73,0:10:02.23,Default,,0,0,0,,Қолыңызға палубаның жоғарғы бес картасынан Морфо қосыңыз.
Dialogue: 0,0:10:03.73,0:10:06.20,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
