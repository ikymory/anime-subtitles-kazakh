Dialogue: 0,0:12:06.72,0:12:09.72,Default,,0,0,0,,Ведрок стенді.
Dialogue: 0,0:12:09.72,0:12:11.69,Default,,0,0,0,,Жоғалу.
Dialogue: 0,0:12:19.70,0:12:21.70,Default,,0,0,0,,Толық күзет.
Dialogue: 0,0:12:24.24,0:12:26.21,Default,,0,0,0,,Бірінші тексеру.
Dialogue: 0,0:12:28.21,0:12:30.28,Default,,0,0,0,,Екінші тексеру.
Dialogue: 0,0:12:30.28,0:12:33.21,Default,,0,0,0,,Алдыңғы триггер Алдыңғы қатардың қуаты плюс 10 000.
Dialogue: 0,0:12:33.21,0:12:35.22,Default,,0,0,0,,Ведрокпен шабуыл.
Dialogue: 0,0:12:35.22,0:12:37.25,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:12:37.25,0:12:40.22,Default,,0,0,0,,Хакердің Ведрокпен күшейтетін шабуылы.
Dialogue: 0,0:12:42.26,0:12:45.26,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін! Левидрастың шеберлігі белсендіріледі! ➡
Dialogue: 0,0:12:45.26,0:12:49.76,Default,,0,0,0,,Infinite Eyes жүйесіндегі бірлік үшін қуат минус 10000.
Dialogue: 0,0:12:49.76,0:12:52.20,Default,,0,0,0,,Осыдан кейін маркерді алып тастап, бір картаны сызыңыз.
Dialogue: 0,0:12:52.20,0:12:54.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:54.24,0:12:56.74,Default,,0,0,0,,Қуат Минус 10000 ғана емес, ұтыс та.
Dialogue: 0,0:12:56.74,0:13:00.24,Default,,0,0,0,,Шексіз көз... Шабуылда да, қорғаныста да мықты!
Dialogue: 0,0:13:01.24,0:13:04.71,Default,,0,0,0,,Сондай-ақ Blitz Order Sweet Honey Garden➡ пайдаланыңыз
Dialogue: 0,0:13:04.71,0:13:06.71,Default,,0,0,0,,Левидрастың күші➡
Dialogue: 0,0:13:06.71,0:13:08.72,Default,,0,0,0,,25 000 плюс!
Dialogue: 0,0:13:11.22,0:13:13.25,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:13:13.25,0:13:15.72,Default,,0,0,0,,Шексіз көздер арқылы шабуылды тежеу➡
Dialogue: 0,0:13:15.72,0:13:17.76,Default,,0,0,0,,Өте күшті, солай емес пе?
Dialogue: 0,0:13:17.76,0:13:21.73,Default,,0,0,0,,Бірақ Blagdomyer Құдайдың шеберлігін белсендіргенде➡
Dialogue: 0,0:13:21.73,0:13:23.73,Default,,0,0,0,,Бұл да ештеңе болмайды.
Dialogue: 0,0:13:23.73,0:13:25.70,Default,,0,0,0,,Сондықтан бұл ұят...
Dialogue: 0,0:13:28.20,0:13:30.20,Default,,0,0,0,,Бұл жекпе-жек осында аяқталады.
Dialogue: 0,0:13:31.74,0:13:33.71,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:13:33.71,0:13:36.21,Default,,0,0,0,,Тұлға...Мін!
Dialogue: 0,0:13:36.21,0:13:38.75,Default,,0,0,0,,Левидрас!
Dialogue: 0,0:13:38.75,0:13:42.25,Default,,0,0,0,,Левидрастың шеберлігін пайдаланып, Шексіз көздерді бір-бірден орналастыр.
Dialogue: 0,0:13:48.79,0:13:51.26,Default,,0,0,0,,Тағы да... Әрине бұл жалғыз емес➡
Dialogue: 0,0:13:51.26,0:13:55.23,Default,,0,0,0,,Мен оның жұлдыздарды орап, галактикаға қалай тарайтынын көрсетемін➡
Dialogue: 0,0:13:55.23,0:13:57.20,Default,,0,0,0,,Даналықпен жарқырай бер!
Dialogue: 0,0:13:57.20,0:13:59.70,Default,,0,0,0,,Шексіз ояну!
Dialogue: 0,0:13:59.70,0:14:01.70,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:14:04.74,0:14:08.21,Default,,0,0,0,,Ол сонда болды! Тағдырдың құдайлық шеберлігі.
Dialogue: 0,0:14:08.21,0:14:10.28,Default,,0,0,0,,Суу….
Dialogue: 0,0:14:10.28,0:14:13.71,Default,,0,0,0,,Тағы бір Шексіз Көз➡ қойыңыз
Dialogue: 0,0:14:13.71,0:14:16.72,Default,,0,0,0,,Levidras қуаты плюс 10000➡
Dialogue: 0,0:14:16.72,0:14:18.69,Default,,0,0,0,,Сыни плюс 1.
Dialogue: 0,0:14:22.22,0:14:24.22,Default,,0,0,0,,Фулиге➡ қоңырау шалыңыз
Dialogue: 0,0:14:24.22,0:14:26.76,Default,,0,0,0,,Тамшыдан Фоксилды шеберлікпен шақырыңыз➡
Dialogue: 0,0:14:26.76,0:14:29.23,Default,,0,0,0,,Сонымен қатар, егер 3 немесе одан да көп Шексіз көздер болса➡
Dialogue: 0,0:14:29.23,0:14:31.23,Default,,0,0,0,,Меншікті қуат плюс 10000.
Dialogue: 0,0:14:31.23,0:14:35.24,Default,,0,0,0,,Тапсырыс картасы Менің іздеуім шексіз білімді пайдаланады.
Dialogue: 0,0:14:35.24,0:14:37.74,Default,,0,0,0,,Анотгастерге қоңырау шалыңыз➡
Dialogue: 0,0:14:37.74,0:14:41.74,Default,,0,0,0,,Бір бағандағы әрбір Infinite Eye үшін қуат плюс 5000!
Dialogue: 0,0:14:41.74,0:14:45.75,Default,,0,0,0,,Сонымен қатар, егер Анотгастерде 3 немесе одан да көп Шексіз Көздер болса➡
Dialogue: 0,0:14:45.75,0:14:49.25,Default,,0,0,0,,Қуатты 5000-ға арттырады және артқы қатардан шабуыл жасауға мүмкіндік береді.
Dialogue: 0,0:14:50.22,0:14:53.25,Default,,0,0,0,,Кларенстің кастодиалына қоңырау шалыңыз➡
Dialogue: 0,0:14:53.25,0:14:56.26,Default,,0,0,0,,Бес шабуыл тізбегі енді аяқталды.
Dialogue: 0,0:14:56.26,0:14:59.76,Default,,0,0,0,,Қуат Persona Ride және Infinite Eyes көмегімен де артады.
Dialogue: 0,0:15:03.26,0:15:07.74,Default,,0,0,0,,Адамзаттың даңқты прогрессі де үздіксіз ізденіс рухының нәтижесі.
Dialogue: 0,0:15:07.74,0:15:10.74,Default,,0,0,0,,Жүруді тоқтатып, нөлде қалатындар➡
Dialogue: 0,0:15:10.74,0:15:12.71,Default,,0,0,0,,Мен құрдымға кетемін!
Dialogue: 0,0:15:13.71,0:15:15.74,Default,,0,0,0,,Левидраспен бірге авангардқа шабуыл жасаңыз!
Dialogue: 0,0:15:15.74,0:15:17.75,Default,,0,0,0,,Фоксил дағдылары➡
Dialogue: 0,0:15:17.75,0:15:20.25,Default,,0,0,0,,Фулиге артқы қатардан шабуыл жасауға мүмкіндік береді!
Dialogue: 0,0:15:24.59,0:15:26.55,Default,,0,0,0,,｜Мен оны қазіргі қолыммен қорғай алмаймын. ｠
Dialogue: 0,0:15:29.86,0:15:33.36,Default,,0,0,0,,｟Осы кезде сізде 2 ұпай алудан және зақымдану триггерін шығарудан басқа амалыңыз жоқ. ｠
Dialogue: 0,0:15:34.73,0:15:36.73,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:15:36.73,0:15:39.23,Default,,0,0,0,,Сіз зақым триггерін мақсат етіп жатырсыз ба? ➡
Dialogue: 0,0:15:39.23,0:15:42.74,Default,,0,0,0,,Бірақ егер мен сыни триггерді тартсам, болды.
Dialogue: 0,0:15:45.71,0:15:47.71,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:15:51.21,0:15:53.25,Default,,0,0,0,,Корпус мүшелеріне бір-біріне негізсіз қылыш кезенуге мүлде болмайды!
Dialogue: 0,0:15:53.25,0:15:56.22,Default,,0,0,0,,А...дәл солай! Бірге жасайық.
Dialogue: 0,0:15:57.22,0:15:59.72,Default,,0,0,0,,Қос жетек!
Dialogue: 0,0:15:59.72,0:16:01.72,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:16:01.72,0:16:03.69,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:16:09.73,0:16:11.73,Default,,0,0,0,,Екінші тексеру….
Dialogue: 0,0:16:12.70,0:16:14.70,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:16:18.71,0:16:20.71,Default,,0,0,0,,Левидрастың сыни ➡
Dialogue: 0,0:16:20.71,0:16:22.71,Default,,0,0,0,,1 плюс!
Dialogue: 0,0:16:31.22,0:16:33.22,Default,,0,0,0,,Зақымдануды тексеру➡
Dialogue: 0,0:16:33.22,0:16:35.72,Default,,0,0,0,,Бірінші тармақ….
Dialogue: 0,0:16:35.72,0:16:37.69,Default,,0,0,0,,Екінші тармақ.
Dialogue: 0,0:16:43.23,0:16:45.23,Default,,0,0,0,,Үшінші тармақ….
Dialogue: 0,0:16:49.70,0:16:51.74,Default,,0,0,0,,Ах...!
Dialogue: 0,0:16:51.74,0:16:53.71,Default,,0,0,0,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,0:16:55.71,0:16:57.71,Default,,0,0,0,,Жеңімпаз➡
Dialogue: 0,0:16:57.71,0:16:59.71,Default,,0,0,0,,Шексіз тағдыр.
Dialogue: 0,0:17:01.22,0:17:03.72,Default,,0,0,0,,Күшті!
Dialogue: 0,0:17:03.72,0:17:05.69,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:17:06.72,0:17:09.72,Default,,0,0,0,,Көңілді болды, Суо.
Dialogue: 0,0:17:09.72,0:17:11.69,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:17:22.77,0:17:25.24,Default,,0,0,0,,Бүгін болған оқиғаны міндетті түрде есімде сақтаймын.
Dialogue: 0,0:17:32.78,0:17:36.75,Default,,0,0,0,,Келесі тағдырлы шайқаста кездескенше.
Dialogue: 0,0:17:46.26,0:17:48.26,Default,,0,0,0,,Мен жеңе алмадым... а….
Dialogue: 0,0:17:49.23,0:17:51.23,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:51.23,0:17:54.70,Default,,0,0,0,,Неге кешірім сұрайсыз? Керемет жекпе-жек болды!
Dialogue: 0,0:17:54.70,0:17:58.21,Default,,0,0,0,,Ол... күшті болды.
Dialogue: 0,0:18:03.21,0:18:05.21,Default,,0,0,0,,Бұл ➡
Dialogue: 0,0:18:05.21,0:18:08.22,Default,,0,0,0,,Қиын шайқас болатын сияқты.
Dialogue: 0,0:18:09.72,0:18:13.72,Default,,0,0,0,,Басқа адамдар да сондай күшті ме?
Dialogue: 0,0:18:13.72,0:18:15.69,Default,,0,0,0,,Иә...дұрыс.
Dialogue: 0,0:18:22.26,0:18:26.70,Default,,0,0,0,,Ей, мен жеңілсем, қарсыласымның психикалық ластануы қалады ма?
Dialogue: 0,0:18:26.70,0:18:28.74,Default,,0,0,0,,Un? Жоқ...Айкава➡
Dialogue: 0,0:18:28.74,0:18:31.74,Default,,0,0,0,,Мен оны қайтарудың жолы бар ма деп ойлаймын...
Dialogue: 0,0:18:31.74,0:18:33.74,Default,,0,0,0,,Ха~! ➡
Dialogue: 0,0:18:33.74,0:18:35.71,Default,,0,0,0,,Қазір жеңіске назар аударыңыз➡
Dialogue: 0,0:18:35.71,0:18:37.71,Default,,0,0,0,,Басқа ештеңе туралы ойламаңыз.
Dialogue: 0,0:18:41.72,0:18:43.72,Default,,0,0,0,,Мен білемін...
Dialogue: 0,0:18:48.22,0:18:50.19,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:18:58.70,0:19:00.70,Default,,0,0,0,,Хикари.
Dialogue: 0,0:19:00.70,0:19:02.74,Default,,0,0,0,,Не?
Dialogue: 0,0:19:02.74,0:19:05.71,Default,,0,0,0,,Мм... қалайсың? жұмысшы?
Dialogue: 0,0:19:05.71,0:19:07.71,Default,,0,0,0,,Жоқ...бұл не?➡
Dialogue: 0,0:19:07.71,0:19:10.21,Default,,0,0,0,,Бір жері ауырады ма деп ойлаймын.
Dialogue: 0,0:19:10.21,0:19:12.71,Default,,0,0,0,,Бұл не? Мен жақсымын.
Dialogue: 0,0:19:12.71,0:19:14.75,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:14.75,0:19:18.22,Default,,0,0,0,,Хикари, сіздің орындағыңыз келетін тілегіңіз қандай?
Dialogue: 0,0:19:18.22,0:19:20.52,Default,,0,0,0,,Тыңда, сен не істейсің?
Dialogue: 0,0:19:20.52,0:19:22.22,Default,,0,0,0,,Сіз ұтыласыз ба?
Dialogue: 0,0:19:22.22,0:19:24.22,Default,,0,0,0,,Одан да көп➡
Dialogue: 0,0:19:24.22,0:19:26.76,Default,,0,0,0,,Ағаңның тілегі бар ма?
Dialogue: 0,0:19:26.76,0:19:29.23,Default,,0,0,0,,Хикари дені сау болғанша, болды...
Dialogue: 0,0:19:29.23,0:19:31.23,Default,,0,0,0,,Мен үшін емес!
Dialogue: 0,0:19:31.23,0:19:34.20,Default,,0,0,0,,A…. Бұл ағамның тілегі.
Dialogue: 0,0:19:34.20,0:19:36.70,Default,,0,0,0,,Менің жеке...
Dialogue: 0,0:19:38.21,0:19:40.21,Default,,0,0,0,,Мен қазір ұйықтаймын.
Dialogue: 0,0:19:51.22,0:19:53.19,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:19:55.29,0:19:58.23,Default,,0,0,0,,Не болды? вице-президент.
Dialogue: 0,0:19:58.23,0:20:01.23,Default,,0,0,0,,Мен тағы да соғыс жариялауға келдім.
Dialogue: 0,0:20:01.23,0:20:03.73,Default,,0,0,0,,А...дәл➡
Dialogue: 0,0:20:03.73,0:20:06.73,Default,,0,0,0,,Сен менің тағдырласымсың ба?
Dialogue: 0,0:20:06.73,0:20:09.20,Default,,0,0,0,,Бірақ ойланып қарасаңыз ➡
Dialogue: 0,0:20:09.20,0:20:11.20,Default,,0,0,0,,Сен жалғызсың.
Dialogue: 0,0:20:13.27,0:20:15.78,Default,,0,0,0,,📱
Dialogue: 0,0:20:17.21,0:20:20.71,Default,,0,0,0,,Тайзо Сейзо Сіздің арманыңыз➡
Dialogue: 0,0:20:20.71,0:20:23.72,Default,,0,0,0,,Бұл Киома Куросаки оны аяқтайды.
Dialogue: 0,0:20:25.22,0:20:31.22,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory