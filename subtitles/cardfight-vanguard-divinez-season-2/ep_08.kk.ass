Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.26,0:00:03.27,Default,,0,0,0,,Тағдырлы шайқаста не болады➡
Dialogue: 0,0:00:03.27,0:00:06.77,Default,,0,0,0,,Ұлттық құрама матчына өтті.
Dialogue: 0,0:00:06.77,0:00:10.27,Default,,0,0,0,,Енді бұл өкіл...
Dialogue: 0,0:00:11.31,0:00:13.28,Default,,0,0,0,,Мен тағы барамын.
Dialogue: 0,0:00:26.82,0:00:30.79,Default,,0,0,0,,Өйткені мен де «Уақыт тағдыры» картасының иесімін.
Dialogue: 0,0:00:35.76,0:00:37.73,Default,,0,0,0,,Сіз...
Dialogue: 0,0:00:38.80,0:00:42.77,Default,,0,0,0,,Бұл... Болашақтан келген Хикари-чан, солай ма?
Dialogue: 0,0:00:42.77,0:00:44.74,Default,,0,0,0,,Un.
Dialogue: 0,0:00:48.28,0:00:50.25,Default,,0,0,0,,О, менің...
Dialogue: 0,0:00:52.25,0:00:54.28,Default,,0,0,0,,Хикари!
Dialogue: 0,0:00:54.28,0:00:57.75,Default,,0,0,0,,Неге... тек болашаққа оралмадың?
Dialogue: 0,0:00:57.75,0:00:59.76,Default,,0,0,0,,Кешіріңіз, аға➡
Dialogue: 0,0:00:59.76,0:01:02.26,Default,,0,0,0,,Бұл өтірік болды.
Dialogue: 0,0:01:03.29,0:01:06.30,Default,,0,0,0,,Тағдыр соғысында тілек бір-ақ рет орындалады.
Dialogue: 0,0:01:06.30,0:01:08.30,Default,,0,0,0,,Бастапқыда➡
Dialogue: 0,0:01:08.30,0:01:10.77,Default,,0,0,0,,Барсам да, қайтып бара алмас едім.
Dialogue: 0,0:01:12.30,0:01:14.80,Default,,0,0,0,,Бастапқыда мен бұл дүниеде болмауым керек➡
Dialogue: 0,0:01:14.80,0:01:18.31,Default,,0,0,0,,Уақыт Тағдырының құдіреті жойыла салысымен➡
Dialogue: 0,0:01:18.31,0:01:21.28,Default,,0,0,0,,Әрбір болмыс дүниеден жойылып кетуі керек еді.
Dialogue: 0,0:01:22.78,0:01:25.25,Default,,0,0,0,,Бірақ сен осындасың!
Dialogue: 0,0:01:25.25,0:01:28.25,Default,,0,0,0,,Иә... бұл біртүрлі.
Dialogue: 0,0:01:29.25,0:01:31.75,Default,,0,0,0,,Мен жоғалып кетуім керек еді➡
Dialogue: 0,0:01:31.75,0:01:33.76,Default,,0,0,0,,Әлі де бар➡
Dialogue: 0,0:01:33.76,0:01:35.76,Default,,0,0,0,,Себеп екеніне сенімдімін...
Dialogue: 0,0:01:38.76,0:01:40.76,Default,,0,0,0,,Бұл тағдыршешті шайқаста болуы керек!
Dialogue: 0,0:03:23.30,0:03:25.80,Default,,0,0,0,,((Um...un.
Dialogue: 0,0:03:27.24,0:03:29.74,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:03:29.74,0:03:31.74,Default,,0,0,0,,Бұл да Зигтің ісі ме?
Dialogue: 0,0:03:34.71,0:03:37.21,Default,,0,0,0,,Мен неге?
Dialogue: 0,0:03:37.21,0:03:39.21,Default,,0,0,0,,Менің естігім келетіні осы.
Dialogue: 0,0:03:40.72,0:03:42.72,Default,,0,0,0,,Менің компаниямның жанындағы артқы аллеяда➡
Dialogue: 0,0:03:42.72,0:03:44.72,Default,,0,0,0,,Ол құлап қалды.
Dialogue: 0,0:03:45.72,0:03:47.72,Default,,0,0,0,,Есіңде жоқ па?
Dialogue: 0,0:03:49.22,0:03:52.23,Default,,0,0,0,,Мен... мені➡ көремін
Dialogue: 0,0:03:52.23,0:03:54.73,Default,,0,0,0,,Жоғалып кеткен жоқ па?
Dialogue: 0,0:03:54.73,0:03:57.70,Default,,0,0,0,,Ха, не болды?
Dialogue: 0,0:03:59.73,0:04:01.74,Default,,0,0,0,,Мен көріп тұрмын~➡
Dialogue: 0,0:04:01.74,0:04:04.24,Default,,0,0,0,,Ол ешкімге білмей жоғалып кетуді жоспарлап отырғанын айтты➡
Dialogue: 0,0:04:04.24,0:04:06.21,Default,,0,0,0,,Барлық ағайындылар бірге➡
Dialogue: 0,0:04:06.21,0:04:08.74,Default,,0,0,0,,Бауырды ұстаудың біртүрлі әдісі бар.
Dialogue: 0,0:04:08.74,0:04:11.71,Default,,0,0,0,,Мен ағам сияқты бейқам емеспін.
Dialogue: 0,0:04:11.71,0:04:13.72,Default,,0,0,0,,Өзін-өзі есепке алмай➡
Dialogue: 0,0:04:13.72,0:04:15.78,Default,,0,0,0,,Мен бауырларыма көмектесуге тырыстым➡
Dialogue: 0,0:04:15.78,0:04:18.75,Default,,0,0,0,,Акина мен Хикари бірдей емес пе?
Dialogue: 0,0:04:20.72,0:04:24.26,Default,,0,0,0,,Бірақ, егер сіз қандай да бір себептермен тірі болсаңыз➡
Dialogue: 0,0:04:24.26,0:04:27.23,Default,,0,0,0,,Менің ойымша, мұның қандай да бір мағынасы болуы керек.
Dialogue: 0,0:04:28.73,0:04:30.73,Default,,0,0,0,,Мағынасы? …Аа!
Dialogue: 0,0:04:34.24,0:04:36.74,Default,,0,0,0,,Бұл!
Dialogue: 0,0:04:36.74,0:04:38.71,Default,,0,0,0,,Төбе әлі сол жерде!
Dialogue: 0,0:04:40.24,0:04:43.75,Default,,0,0,0,,Уақыт Тағдырының күші жойылған жоқ➡
Dialogue: 0,0:04:43.75,0:04:47.75,Default,,0,0,0,,Мүмкін менің тілегім әлі орындалмаған шығар?
Dialogue: 0,0:04:49.22,0:04:51.29,Default,,0,0,0,,Ағамның өлетін тағдыры➡
Dialogue: 0,0:04:51.29,0:04:53.79,Default,,0,0,0,,Бұл оның өзгермегенін білдіре ме? ))
Dialogue: 0,0:04:56.22,0:04:58.26,Default,,0,0,0,,Сәл кейінірек➡
Dialogue: 0,0:04:58.26,0:05:01.26,Default,,0,0,0,,Тағдырдың шешуші шайқасы деп аталатын шайқас басталды.
Dialogue: 0,0:05:02.23,0:05:04.23,Default,,0,0,0,,Мен және бұл дүниедегі ағам➡
Dialogue: 0,0:05:04.23,0:05:06.23,Default,,0,0,0,,Менің оған ілесіп кеткенім➡
Dialogue: 0,0:05:06.23,0:05:08.74,Default,,0,0,0,,Маған Тайзо Сейзо хабарлады.
Dialogue: 0,0:05:11.24,0:05:13.24,Default,,0,0,0,,Тағдырлы шайқас туралы бірінші рет естуім.
Dialogue: 0,0:05:14.24,0:05:18.25,Default,,0,0,0,,Басқаша айтқанда, бұл мен өмір сүрген әлемде болмауы керек еді.
Dialogue: 0,0:05:19.25,0:05:21.25,Default,,0,0,0,,Егер сіздің ағаңыздың ➡
Dialogue: 0,0:05:21.25,0:05:23.72,Default,,0,0,0,,Өлім тағдыры жалғаса берсе➡
Dialogue: 0,0:05:23.72,0:05:26.22,Default,,0,0,0,,Байланысты болуы керек.
Dialogue: 0,0:05:28.22,0:05:30.76,Default,,0,0,0,,Мен жасырынып, жағдайды бақылап отырдым➡
Dialogue: 0,0:05:30.76,0:05:33.73,Default,,0,0,0,,Мен бірдеңе істей аламын ба деп ойладым.
Dialogue: 0,0:05:34.73,0:05:37.73,Default,,0,0,0,,Қайталанатын алға-артқа шайқастар➡
Dialogue: 0,0:05:37.73,0:05:39.73,Default,,0,0,0,,Және соңында➡
Dialogue: 0,0:05:39.73,0:05:41.74,Default,,0,0,0,,Тағдырлы шайқаста не болады➡
Dialogue: 0,0:05:41.74,0:05:44.21,Default,,0,0,0,,Ұлттық құрама матчына әкелді.
Dialogue: 0,0:05:53.25,0:05:55.72,Default,,0,0,0,,Менде де 7-ші Тағдыр картасы➡ бар
Dialogue: 0,0:05:55.72,0:05:57.72,Default,,0,0,0,,Күресуге құқығы болуы керек.
Dialogue: 0,0:05:58.75,0:06:01.22,Default,,0,0,0,,Маған осы жерде ұрысуға рұқсат беруіңізді қалаймын➡
Dialogue: 0,0:06:01.22,0:06:03.23,Default,,0,0,0,,Ең бастысы, мен➡
Dialogue: 0,0:06:03.23,0:06:05.69,Default,,0,0,0,,Менің өзіммен сөйлесетін нәрсем бар.
Dialogue: 0,0:06:06.73,0:06:08.76,Default,,0,0,0,,Бұл жақсы емес пе? Мен келісемін.
Dialogue: 0,0:06:08.76,0:06:12.27,Default,,0,0,0,,Иә, мен де келісемін. проблема жоқ.
Dialogue: 0,0:06:12.27,0:06:16.24,Default,,0,0,0,,Сол сияқты. Бұл әлдеқайда қызық сияқты.
Dialogue: 0,0:06:17.24,0:06:19.24,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:19.24,0:06:21.24,Default,,0,0,0,,Түсіндім➡
Dialogue: 0,0:06:21.24,0:06:24.75,Default,,0,0,0,,Мен сұрағым келетін нәрселер көп, бірақ бұл кейінірек➡
Dialogue: 0,0:06:24.75,0:06:28.28,Default,,0,0,0,,Хикариді сұраңыз. мм.
Dialogue: 0,0:06:28.28,0:06:31.29,Default,,0,0,0,,📱
Dialogue: 0,0:06:32.25,0:06:34.76,Default,,0,0,0,,Сіздің қатысуыңыз сөзсіз ➡
Dialogue: 0,0:06:34.76,0:06:37.23,Default,,0,0,0,,Тағдырлы шайқасқа қабылданды.
Dialogue: 0,0:06:41.23,0:06:44.23,Default,,0,0,0,,Сонымен, рахмет➡
Dialogue: 0,0:06:44.23,0:06:47.24,Default,,0,0,0,,Осы дүниенің I.
Dialogue: 0,0:06:47.24,0:06:50.27,Default,,0,0,0,,Мен Азаматтан➡ естідім
Dialogue: 0,0:06:50.27,0:06:53.74,Default,,0,0,0,,Бұл шынымен менің болашақ өзім, солай ма? әрине.
Dialogue: 0,0:06:53.74,0:06:57.75,Default,,0,0,0,,Ұқсас деп аталу әлдеқайда шынайырақ.
Dialogue: 0,0:06:57.75,0:07:00.22,Default,,0,0,0,,Мен саған сену үшін не айтуым керек?
Dialogue: 0,0:07:01.25,0:07:04.29,Default,,0,0,0,,Ағылшын және әлеуметтік пәндер бойынша алған бағаларыңыз сізді алаңдатады ма?
Dialogue: 0,0:07:04.29,0:07:07.22,Default,,0,0,0,,Мен кейде бұқтырылған балдыркөкті ұнатпаймын➡
Dialogue: 0,0:07:07.22,0:07:09.22,Default,,0,0,0,,Сіз айта алмайтын нәрселер➡
Dialogue: 0,0:07:09.22,0:07:11.23,Default,,0,0,0,,Мен ағамның мені көргенін қаламаймын➡
Dialogue: 0,0:07:11.23,0:07:13.23,Default,,0,0,0,,Мынаны-мынаны жасыратын жер бар ма?
Dialogue: 0,0:07:13.23,0:07:15.73,Default,,0,0,0,,Ең нашар! Маған солай көрінеді.
Dialogue: 0,0:07:15.73,0:07:17.77,Default,,0,0,0,,Менмін десең➡
Dialogue: 0,0:07:17.77,0:07:20.74,Default,,0,0,0,,Менің мұнда неге ұрысып жатқанымды түсінуің керек!
Dialogue: 0,0:07:20.74,0:07:23.24,Default,,0,0,0,,Бірақ сен неге менің алдымда тұрсың?
Dialogue: 0,0:07:23.24,0:07:25.24,Default,,0,0,0,,Себебі мен түсінемін.
Dialogue: 0,0:07:25.24,0:07:27.71,Default,,0,0,0,,Ең жаманы шынымен де ең жаманы.
Dialogue: 0,0:07:27.71,0:07:29.78,Default,,0,0,0,,Бұл өзара.
Dialogue: 0,0:07:29.78,0:07:33.72,Default,,0,0,0,,Осындай жағдайларда өзін жек көру сөзін қолдануға бола ма?
Dialogue: 0,0:07:33.72,0:07:35.82,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:07:35.82,0:07:37.79,Default,,0,0,0,,Бұл біздің арамызда.
Dialogue: 0,0:07:38.75,0:07:40.72,Default,,0,0,0,,Екі Мейдо Хикари➡
Dialogue: 0,0:07:40.72,0:07:44.23,Default,,0,0,0,,Карточкаңызды көтеріп, айқайлаңыз➡
Dialogue: 0,0:07:44.23,0:07:46.76,Default,,0,0,0,,Соғыс белгілері!
Dialogue: 0,0:07:46.76,0:07:48.73,Default,,0,0,0,,Тағдырға. Оны шешіңіз!
Dialogue: 0,0:07:50.23,0:07:52.20,Default,,0,0,0,,Құдай!
Dialogue: 0,0:07:53.74,0:07:57.24,Default,,0,0,0,,Шешуші шайқастың уақыты келді➡
Dialogue: 0,0:07:57.24,0:07:59.21,Default,,0,0,0,,Соңғы шайқас басталсын!
Dialogue: 0,0:07:59.21,0:08:01.28,Default,,0,0,0,,Акикун, жақсысың ба?
Dialogue: 0,0:08:01.28,0:08:05.25,Default,,0,0,0,,Иә, дәл қазір бұл күресті көру маңызды.
Dialogue: 0,0:08:06.72,0:08:08.72,Default,,0,0,0,,Себебі мен болашақпын➡
Dialogue: 0,0:08:08.72,0:08:10.75,Default,,0,0,0,,Жеңіске жетемін деп ойламаңыз.
Dialogue: 0,0:08:10.75,0:08:13.25,Default,,0,0,0,,Мен сенің мықты екеніңді білемін➡
Dialogue: 0,0:08:13.25,0:08:16.22,Default,,0,0,0,,Бірақ мен оны бар күшіммен талқандаймын.
Dialogue: 0,0:08:18.73,0:08:21.20,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:08:22.23,0:08:24.73,Default,,0,0,0,,Сыбызғышы Бирниста.
Dialogue: 0,0:08:24.73,0:08:27.24,Default,,0,0,0,,Ванли Пэн қанатының Гуя Кецаль.
Dialogue: 0,0:08:27.24,0:08:30.24,Default,,0,0,0,,Менің кезегім Адольф➡
Dialogue: 0,0:08:30.24,0:08:32.21,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:08:32.21,0:08:35.24,Default,,0,0,0,,Менің кезегім Тигратпен жүр➡
Dialogue: 0,0:08:35.24,0:08:38.75,Default,,0,0,0,,Дағдыны белсендіру Джишинги/Тағдыр қанаттарын орнатыңыз!
Dialogue: 0,0:08:42.75,0:08:45.25,Default,,0,0,0,,Тигратпен шабуыл! Күзетші жоқ.
Dialogue: 0,0:08:48.26,0:08:50.73,Default,,0,0,0,,Джишинги/Тағдыр қанаттары➡
Dialogue: 0,0:08:50.73,0:08:53.73,Default,,0,0,0,,Өткенді жою күші...
Dialogue: 0,0:08:53.73,0:08:55.73,Default,,0,0,0,,Бұл дәл біз қалайтын нәрсе.
Dialogue: 0,0:08:55.73,0:08:57.73,Default,,0,0,0,,Дұрыс➡
Dialogue: 0,0:08:57.73,0:09:00.24,Default,,0,0,0,,Онда мен сені тоқтатуым керек.
Dialogue: 0,0:09:01.24,0:09:04.24,Default,,0,0,0,,Менің кезегім Эльгенияға міну➡
Dialogue: 0,0:09:04.24,0:09:07.21,Default,,0,0,0,,Дағды бойынша 2 картаны салыңыз➡
Dialogue: 0,0:09:07.21,0:09:09.24,Default,,0,0,0,,1 картаны тастаңыз.
Dialogue: 0,0:09:09.24,0:09:11.25,Default,,0,0,0,,2 ауырсынуды басатын дәрі шақырыңыз ➡
Dialogue: 0,0:09:11.25,0:09:14.22,Default,,0,0,0,,Эльгениямен шабуыл! Күзетші жоқ.
Dialogue: 0,0:09:15.22,0:09:18.22,Default,,0,0,0,,Ауырсынуды басатын дәрімен шабуыл! күзетші.
Dialogue: 0,0:09:18.22,0:09:20.26,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:09:20.26,0:09:24.26,Default,,0,0,0,,Менің кезегім: Өмір сызығы үзілген кеңістік-уақыт алыбына мініңіз➡
Dialogue: 0,0:09:24.26,0:09:28.73,Default,,0,0,0,,Шеберлікпен қолыңыздағы бір картаны регресс өлшегішке айналдырып, екі картаны салыңыз.
Dialogue: 0,0:09:29.73,0:09:32.77,Default,,0,0,0,,Мен өткенді міндетті түрде өзгертемін.
Dialogue: 0,0:09:32.77,0:09:35.74,Default,,0,0,0,,Өткенді өзгерту бақытты болуды білдірмейді.
Dialogue: 0,0:09:35.74,0:09:38.71,Default,,0,0,0,,Шулы, сіз дәл солай істесеңіз де!
Dialogue: 0,0:09:38.71,0:09:40.71,Default,,0,0,0,,Амми Дитанаға➡ қоңырау шалыңыз
Dialogue: 0,0:09:40.71,0:09:42.71,Default,,0,0,0,,Кеңістік-уақыт алыбының қуаты +5000➡
Dialogue: 0,0:09:42.71,0:09:44.75,Default,,0,0,0,,Сондай-ақ Battle Face➡ басында
Dialogue: 0,0:09:44.75,0:09:47.75,Default,,0,0,0,,Регресс өлшегішінің Анахроносын шақырыңыз➡
Dialogue: 0,0:09:47.75,0:09:50.75,Default,,0,0,0,,Амми Дитанамен шабуыл! күзетші.
Dialogue: 0,0:09:50.75,0:09:53.25,Default,,0,0,0,,Кеңістіктегі алып сарбаздармен шабуыл! Күзетші жоқ.
Dialogue: 0,0:09:54.22,0:09:57.73,Default,,0,0,0,,Анахроноспен шабуыл! күзетші.
Dialogue: 0,0:09:57.73,0:09:59.73,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:09:59.73,0:10:01.76,Default,,0,0,0,,Дұрыс айтасыз➡
Dialogue: 0,0:10:01.76,0:10:05.77,Default,,0,0,0,,Тағдыр соғысында мен де жеңдім, өткенді өзгертуге тырыстым➡
Dialogue: 0,0:10:05.77,0:10:09.24,Default,,0,0,0,,Онда сенің мені сынауға хақың жоқ, солай ма?
Dialogue: 0,0:10:09.24,0:10:12.71,Default,,0,0,0,,Жоқ, сондықтан айтуым керек➡
Dialogue: 0,0:10:12.71,0:10:14.71,Default,,0,0,0,,Өткенге өту, бізді не күтіп тұр➡
Dialogue: 0,0:10:14.71,0:10:17.21,Default,,0,0,0,,Ол сенің ағаң емес.
Dialogue: 0,0:10:17.21,0:10:19.25,Default,,0,0,0,,E?
Dialogue: 0,0:10:19.25,0:10:23.28,Default,,0,0,0,,Мен ағам қайтыс болған өткенді өзгерткім келеді➡
Dialogue: 0,0:10:23.28,0:10:26.25,Default,,0,0,0,,Заманның тағдырына тілек айтып, осында келдім.
Dialogue: 0,0:10:27.22,0:10:29.72,Default,,0,0,0,,Бірақ... менің ағам мұнда➡
Dialogue: 0,0:10:29.72,0:10:31.73,Default,,0,0,0,,Менің ағам емес➡
Dialogue: 0,0:10:31.73,0:10:33.73,Default,,0,0,0,,Ол сенің ағаң!
Dialogue: 0,0:10:35.23,0:10:37.77,Default,,0,0,0,,Өткенге барып, болашақты өзгертсең де➡
Dialogue: 0,0:10:37.77,0:10:40.24,Default,,0,0,0,,Менің ағам қайтып келмейді.
Dialogue: 0,0:10:41.87,0:10:45.27,Default,,0,0,0,,Тағы бір Мейду Акина бар!
Dialogue: 0,0:10:45.27,0:10:48.71,Default,,0,0,0,,Солай бола тұра, мен өзім қалаған болашақты көргім келеді! ➡
Dialogue: 0,0:10:48.71,0:10:50.71,Default,,0,0,0,,Сізде де солай емес пе?
Dialogue: 0,0:10:50.71,0:10:52.78,Default,,0,0,0,,Дұрыс➡
Dialogue: 0,0:10:52.78,0:10:56.25,Default,,0,0,0,,Бірақ сол үшін менің ағам дәл қазір бұл дүниеде➡
Dialogue: 0,0:10:56.25,0:10:59.25,Default,,0,0,0,,Сіз барлық маңызды нәрселеріңізді қалдырасыз ба?
Dialogue: 0,0:11:00.22,0:11:02.22,Default,,0,0,0,,Соңында мен сияқты ➡
Dialogue: 0,0:11:02.22,0:11:04.23,Default,,0,0,0,,Сіз де жоғалып кетуіңіз мүмкін!
Dialogue: 0,0:11:05.26,0:11:08.73,Default,,0,0,0,,Кейін өкінсең де, кеш!
Dialogue: 0,0:11:09.73,0:11:11.73,Default,,0,0,0,,Оған көмектесу мүмкін емес➡
Dialogue: 0,0:11:11.73,0:11:13.77,Default,,0,0,0,,Егер заттар қазіргідей қалса➡
Dialogue: 0,0:11:13.77,0:11:15.77,Default,,0,0,0,,Сіз жоғалтқан нәрсе өзгермейді.
Dialogue: 0,0:11:17.24,0:11:20.28,Default,,0,0,0,,Бұл шынымен де дәл солай➡
Dialogue: 0,0:11:20.28,0:11:24.21,Default,,0,0,0,,Содан кейін мен бұл идеяны қайта қарастырамын!
Dialogue: 0,0:11:24.21,0:11:26.21,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:11:26.21,0:11:28.72,Default,,0,0,0,,Ерекшелік қанаттары Міне, болашақтан!
Dialogue: 0,0:11:28.72,0:11:30.75,Default,,0,0,0,,Уақыт тағдыры➡
Dialogue: 0,0:11:30.75,0:11:33.22,Default,,0,0,0,,Amorta барабанына мініңіз!
Dialogue: 0,0:11:43.77,0:11:47.27,Default,,0,0,0,,Дағдыны белсендіру 3 қалыпты бірлікті түсіру ➡
Dialogue: 0,0:11:47.27,0:11:50.24,Default,,0,0,0,,Палубаның төменгі жағына қайтару арқылы 1 картаны салыңыз➡
Dialogue: 0,0:11:50.24,0:11:52.71,Default,,0,0,0,,Айдилас пен Салварға ➡ қоңырау шалыңыз
Dialogue: 0,0:11:52.71,0:11:55.71,Default,,0,0,0,,Идилуспен шабуыл! күзетші.
Dialogue: 0,0:11:55.71,0:11:59.71,Default,,0,0,0,,Reel Amorta➡ көмегімен шабуыл дағдыларын белсендіру
Dialogue: 0,0:11:59.71,0:12:01.88,Default,,0,0,0,,Идилусты байлау➡
Dialogue: 0,0:12:01.88,0:12:04.72,Default,,0,0,0,,Палубадан басқа Идилусқа қоңырау шалыңыз➡
Dialogue: 0,0:12:04.72,0:12:07.72,Default,,0,0,0,,Сонымен қатар, Ыдыластың шеберлігінің арқасында➡
Dialogue: 0,0:12:07.72,0:12:09.72,Default,,0,0,0,,1 картаны салыңыз➡
Dialogue: 0,0:12:09.72,0:12:12.73,Default,,0,0,0,,Ролдың қуаты плюс 5000. Қорғау жоқ.
Dialogue: 0,0:12:12.73,0:12:14.70,Default,,0,0,0,,Бірінші тексеру….
Dialogue: 0,0:12:16.23,0:12:18.23,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:12:18.23,0:12:21.74,Default,,0,0,0,,Триггер Айдыластың қуатын сызыңыз және 10 000 қосыңыз!
Dialogue: 0,0:12:23.24,0:12:25.71,Default,,0,0,0,,Сальвармен шабуыл! күзетші!
Dialogue: 0,0:12:25.71,0:12:28.71,Default,,0,0,0,,Идилуспен шабуыл! Күзетші жоқ.
Dialogue: 0,0:12:29.71,0:12:31.71,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:12:31.71,0:12:33.75,Default,,0,0,0,,Зақым 3?➡
Dialogue: 0,0:12:33.75,0:12:36.72,Default,,0,0,0,,Негізі мен тағы бір нәрсені қалаймын, бірақ...
Dialogue: 0,0:12:36.72,0:12:38.75,Default,,0,0,0,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:12:38.75,0:12:41.26,Default,,0,0,0,,Reel Odium Құдайдың шеберлігін қалай пайдаланады➡
Dialogue: 0,0:12:41.26,0:12:44.69,Default,,0,0,0,,Ең жылдам жылдамдықта болса да, дайындалу үшін тағы бір айналым қажет.
Dialogue: 0,0:12:44.69,0:12:47.26,Default,,0,0,0,,Оған дейін шешіп алғыңыз келсе➡
Dialogue: 0,0:12:47.26,0:12:50.73,Default,,0,0,0,,Хикари-чанға тағы бір солға бұрылыс бар.
Dialogue: 0,0:12:50.73,0:12:52.73,Default,,0,0,0,,Кем дегенде, сол кезде➡
Dialogue: 0,0:12:52.73,0:12:55.20,Default,,0,0,0,,Мен шығынды толтырғым келді...
Dialogue: 0,0:12:56.24,0:12:58.21,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:58.21,0:13:01.28,Default,,0,0,0,,Менің орнымда болсаңыз түсінер едіңіз➡
Dialogue: 0,0:13:01.28,0:13:05.21,Default,,0,0,0,,Мен ауруханаға түскен сайын ағам маған бірдеңе жасаған сайын➡
Dialogue: 0,0:13:05.21,0:13:08.22,Default,,0,0,0,,Қайта-қайта ойландым!
Dialogue: 0,0:13:11.22,0:13:13.22,Default,,0,0,0,,Менің денем үшін➡
Dialogue: 0,0:13:13.22,0:13:15.22,Default,,0,0,0,,Сен ағаңның уақытын ұрлап жатырсың.
Dialogue: 0,0:13:16.22,0:13:18.73,Default,,0,0,0,,Сол апат болмаса➡
Dialogue: 0,0:13:18.73,0:13:21.23,Default,,0,0,0,,Қираған жерлерге бармасам➡
Dialogue: 0,0:13:21.23,0:13:23.73,Default,,0,0,0,,Лагерьге қатыспасаңыз➡
Dialogue: 0,0:13:23.73,0:13:27.24,Default,,0,0,0,,Дұрыс, мен әрқашан өкінетінмін➡
Dialogue: 0,0:13:27.24,0:13:29.27,Default,,0,0,0,,Бірақ қанша өкінсем де➡
Dialogue: 0,0:13:29.27,0:13:32.74,Default,,0,0,0,,Мен ештеңе істей алмадым!
Dialogue: 0,0:13:32.74,0:13:36.74,Default,,0,0,0,,Бірақ егер бұл тағдырлы шайқас болса, сіз мұны істей аласыз!
Dialogue: 0,0:13:36.74,0:13:40.28,Default,,0,0,0,,Сол апат ағамның өмірін құртты.
Dialogue: 0,0:13:40.28,0:13:43.75,Default,,0,0,0,,Сол кезде жасаған қателіктеріңізді түзеткіңіз келгеннің несі жаман?
Dialogue: 0,0:13:43.75,0:13:47.22,Default,,0,0,0,,Бұлай тілеуде немесе ойлауда ешнәрсе жоқ.
Dialogue: 0,0:13:47.22,0:13:49.76,Default,,0,0,0,,Ал егер! бірақ!
Dialogue: 0,0:13:49.76,0:13:52.73,Default,,0,0,0,,Дәл қазір сіз тек өзіңіз туралы ойлайсыз.
Dialogue: 0,0:13:57.23,0:13:59.23,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:14:11.21,0:14:13.21,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:14.22,0:14:17.22,Default,,0,0,0,,Менің ойымша, сізде де өкініш бар.
Dialogue: 0,0:14:19.25,0:14:23.26,Default,,0,0,0,,Сонда біз ұқсаспыз.
Dialogue: 0,0:14:37.74,0:14:40.21,Default,,0,0,0,,Бұл бала мені растады➡
Dialogue: 0,0:14:40.21,0:14:43.75,Default,,0,0,0,,Сондықтан біз бірге күресеміз!
Dialogue: 0,0:14:43.75,0:14:46.75,Default,,0,0,0,,Өткен қателіктерді реттеу үшін!
Dialogue: 0,0:14:48.22,0:14:50.22,Default,,0,0,0,,Айыптау қанаттары➡
Dialogue: 0,0:14:50.22,0:14:52.25,Default,,0,0,0,,Мұнда өткеннен!
Dialogue: 0,0:14:52.25,0:14:54.26,Default,,0,0,0,,Уақыт тағдыры➡
Dialogue: 0,0:14:54.26,0:14:56.72,Default,,0,0,0,,Одиумға барыңыз!
Dialogue: 0,0:15:14.28,0:15:17.75,Default,,0,0,0,,Энергия генераторы дағдысы бар 1 картаны салыңыз➡
Dialogue: 0,0:15:17.75,0:15:19.75,Default,,0,0,0,,Ablaze Chimera➡ қоңырау шалыңыз
Dialogue: 0,0:15:19.75,0:15:22.88,Default,,0,0,0,,Бәтимді сол дағдымен шақырыңыз➡
Dialogue: 0,0:15:22.88,0:15:25.22,Default,,0,0,0,,Және себепті бұрмалау мен айыптауды қолдану➡
Dialogue: 0,0:15:25.22,0:15:27.26,Default,,0,0,0,,Жан заряды➡
Dialogue: 0,0:15:27.26,0:15:29.26,Default,,0,0,0,,Бұл картаны регресс көрсеткіші ретінде пайдаланыңыз➡
Dialogue: 0,0:15:29.26,0:15:32.79,Default,,0,0,0,,Және бір картаны тартыңыз, катушканың күші плюс 10000!
Dialogue: 0,0:15:32.79,0:15:35.30,Default,,0,0,0,,Сонымен қатар, Reel шеберлігімен➡
Dialogue: 0,0:15:35.30,0:15:37.77,Default,,0,0,0,,Алдыңғы қатардағы артқы қорғаныс қуаты плюс 5000!
Dialogue: 0,0:15:38.77,0:15:41.74,Default,,0,0,0,,Амми Дитанамен шабуыл! күзетші.
Dialogue: 0,0:15:41.74,0:15:44.77,Default,,0,0,0,,Авангардқа Reel Odium арқылы шабуыл жасаңыз!
Dialogue: 0,0:15:44.77,0:15:48.74,Default,,0,0,0,,Дағдыны белсендіру: Амми Детананы регресс көрсеткішіне айналдыру арқылы➡
Dialogue: 0,0:15:48.74,0:15:51.75,Default,,0,0,0,,Роль үш еселік жетекке ие болады!
Dialogue: 0,0:15:51.75,0:15:53.75,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:15:53.75,0:15:55.72,Default,,0,0,0,,Бірінші тексеру….
Dialogue: 0,0:15:56.72,0:15:58.72,Default,,0,0,0,,Екінші тексеру….
Dialogue: 0,0:15:59.72,0:16:01.76,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:16:01.76,0:16:05.23,Default,,0,0,0,,Critical Trigger Anachronos Пауэр Plus 10000➡
Dialogue: 0,0:16:05.23,0:16:07.73,Default,,0,0,0,,Реелдің сыни плюс 1!
Dialogue: 0,0:16:09.26,0:16:12.23,Default,,0,0,0,,Зақымдануды тексеру 1-тармақ➡
Dialogue: 0,0:16:12.23,0:16:14.27,Default,,0,0,0,,Екінші тармақ➡
Dialogue: 0,0:16:14.27,0:16:17.27,Default,,0,0,0,,Алдыңғы триггер Алдыңғы қатардың қуаты плюс 10 000.
Dialogue: 0,0:16:18.24,0:16:20.24,Default,,0,0,0,,Анахроноспен шабуыл!
Dialogue: 0,0:16:20.24,0:16:22.81,Default,,0,0,0,,Қуат +5000 шеберлікке байланысты➡
Dialogue: 0,0:16:22.81,0:16:25.75,Default,,0,0,0,,Идилдің шегінуі. күзетші!
Dialogue: 0,0:16:25.75,0:16:27.72,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:16:28.75,0:16:30.75,Default,,0,0,0,,Енді сізде 3 регресс өлшегіш бар.
Dialogue: 0,0:16:32.25,0:16:35.26,Default,,0,0,0,,Себептік бұрмалау/Үкімдеу➡ тағы бір данасы болса
Dialogue: 0,0:16:35.26,0:16:38.29,Default,,0,0,0,,Құдайдың шеберлігі келесі айналымда іске қосылады.
Dialogue: 0,0:16:38.29,0:16:42.26,Default,,0,0,0,,Егер бұл орын алса, мен әр айналымда жеңемін!
Dialogue: 0,0:16:42.26,0:16:44.27,Default,,0,0,0,,Бірақ сіз ұмытқан жоқсыз ба? Не?
Dialogue: 0,0:16:44.27,0:16:46.23,Default,,0,0,0,,Тәңірлік өнер кімде бар➡
Dialogue: 0,0:16:46.23,0:16:49.27,Default,,0,0,0,,Мұнда және ➡ бірдей
Dialogue: 0,0:16:49.27,0:16:52.74,Default,,0,0,0,,Оны бірінші реттей алатын менмін!
Dialogue: 0,0:16:53.74,0:16:56.74,Default,,0,0,0,,Менің кезегім Persona Ride!
Dialogue: 0,0:16:56.74,0:16:59.25,Default,,0,0,0,,Reel Amorta!
Dialogue: 0,0:16:59.25,0:17:02.25,Default,,0,0,0,,Энергия генераторы дағдысы бар 1 картаны салыңыз➡
Dialogue: 0,0:17:02.25,0:17:04.25,Default,,0,0,0,,Қоңыраулар реті шебері➡
Dialogue: 0,0:17:04.25,0:17:07.72,Default,,0,0,0,,Палубаның жоғарғы 5 картасынан бастау үшін осы дағдыны пайдаланыңыз➡
Dialogue: 0,0:17:07.72,0:17:10.73,Default,,0,0,0,,Эгретке, сосын Истияға➡ қоңырау шалыңыз
Dialogue: 0,0:17:10.73,0:17:12.73,Default,,0,0,0,,Истияның күшеюі➡
Dialogue: 0,0:17:12.73,0:17:15.23,Default,,0,0,0,,Сальвармен шабуыл! Күзетші жоқ.
Dialogue: 0,0:17:16.23,0:17:19.23,Default,,0,0,0,,Reel Amorta көмегімен авангардқа шабуыл жасаңыз!
Dialogue: 0,0:17:19.23,0:17:22.24,Default,,0,0,0,,Сальварды шеберлікпен байлаңыз➡
Dialogue: 0,0:17:22.24,0:17:24.77,Default,,0,0,0,,Басқа Salvar ➡ қоңырау шалыңыз
Dialogue: 0,0:17:24.77,0:17:28.24,Default,,0,0,0,,Осы уақытта Истия және Секвенция дағдылары іске қосылады➡
Dialogue: 0,0:17:28.24,0:17:30.24,Default,,0,0,0,,Истия - стенд➡
Dialogue: 0,0:17:30.24,0:17:32.25,Default,,0,0,0,,Тізбек - қуат плюс 5000➡
Dialogue: 0,0:17:32.25,0:17:34.22,Default,,0,0,0,,Көбірек жан заряды!
Dialogue: 0,0:17:35.75,0:17:37.72,Default,,0,0,0,,Триггер….
Dialogue: 0,0:17:37.72,0:17:39.72,Default,,0,0,0,,Мен твиттер жазып отырмын деп ойламаймын.
Dialogue: 0,0:17:39.72,0:17:42.72,Default,,0,0,0,,Сізде еркін әрекет етуге уақыт жоқ, солай ма?
Dialogue: 0,0:17:42.72,0:17:45.73,Default,,0,0,0,,Реелдің шабуылы әлі қалды!
Dialogue: 0,0:17:47.26,0:17:49.23,Default,,0,0,0,,Өтпейтін күзетші!
Dialogue: 0,0:17:50.73,0:17:53.23,Default,,0,0,0,,Қос жетекті бірінші тексеру….
Dialogue: 0,0:17:55.24,0:17:57.24,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:17:57.24,0:18:00.24,Default,,0,0,0,,Емдеу триггері Сальвардың күші +10000!
Dialogue: 0,0:18:01.78,0:18:05.25,Default,,0,0,0,,Ұрыс соңында Паинкиллерді шығарып, 1 картаны салыңыз.
Dialogue: 0,0:18:06.75,0:18:08.75,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:18:08.75,0:18:10.75,Default,,0,0,0,,Сіз әлі де айтасыз ба? Мен айтамын➡
Dialogue: 0,0:18:10.75,0:18:14.72,Default,,0,0,0,,Біздің сезінген кінәміз де солай болды...
Dialogue: 0,0:18:14.72,0:18:17.73,Default,,0,0,0,,Бірақ бұл туралы ағаңмен сөйлестің бе?
Dialogue: 0,0:18:17.73,0:18:20.73,Default,,0,0,0,,Бұл... Сіз айтпадыңыз➡
Dialogue: 0,0:18:20.73,0:18:22.73,Default,,0,0,0,,Жоқ, айта алмадым➡
Dialogue: 0,0:18:22.73,0:18:26.23,Default,,0,0,0,,Ағамнан, иә, Хикаридің арқасы➡
Dialogue: 0,0:18:26.23,0:18:28.74,Default,,0,0,0,,Мен растаудан қорқамын➡
Dialogue: 0,0:18:28.74,0:18:30.74,Default,,0,0,0,,Олай болмайды деп ойласаңыз да➡
Dialogue: 0,0:18:30.74,0:18:32.71,Default,,0,0,0,,Мен бұл қорқынышты жеңе алмадым!
Dialogue: 0,0:18:33.74,0:18:36.74,Default,,0,0,0,,Бірақ мен сізге дұрыс айтуым керек еді➡
Dialogue: 0,0:18:36.74,0:18:39.75,Default,,0,0,0,,Уайымдасаң, ауырсаң➡
Dialogue: 0,0:18:39.75,0:18:42.75,Default,,0,0,0,,Төбелес болса да айтуым керек еді!
Dialogue: 0,0:18:42.75,0:18:45.25,Default,,0,0,0,,Қазірдің өзінде кеш! Әлі де кеш емес!
Dialogue: 0,0:18:46.25,0:18:48.26,Default,,0,0,0,,Әлі де кеш емес, себебі➡
Dialogue: 0,0:18:48.26,0:18:51.26,Default,,0,0,0,,Сенің ағаң осында, тірі.
Dialogue: 0,0:18:54.76,0:18:58.27,Default,,0,0,0,,Мен сені және ағаңды қорғаймын!
Dialogue: 0,0:18:59.27,0:19:03.27,Default,,0,0,0,,Уақыт өзгереді, Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:19:04.77,0:19:07.74,Default,,0,0,0,,Ұрыс соңында жоғалған сол атау картасы➡
Dialogue: 0,0:19:07.74,0:19:11.25,Default,,0,0,0,,Reel Amorta -1 жолымен жүріңіз!
Dialogue: 0,0:19:11.25,0:19:13.25,Default,,0,0,0,,Истияның күшеюі➡
Dialogue: 0,0:19:13.25,0:19:16.22,Default,,0,0,0,,Сальвармен шабуыл! Күзетші жоқ.
Dialogue: 0,0:19:17.25,0:19:21.22,Default,,0,0,0,,Reel Amorta көмегімен Авангардқа тағы бір рет шабуыл жасаңыз!
Dialogue: 0,0:19:21.22,0:19:24.73,Default,,0,0,0,,Дағдыны белсендіру Байланыс Салвар ➡
Dialogue: 0,0:19:24.73,0:19:26.73,Default,,0,0,0,,Басқа Салварға қоңырау шалыңыз!
Dialogue: 0,0:19:30.23,0:19:32.23,Default,,0,0,0,,Басыңызды суытыңыз➡
Dialogue: 0,0:19:32.23,0:19:34.24,Default,,0,0,0,,Рефлексия!
Dialogue: 0,0:19:34.24,0:19:37.20,Default,,0,0,0,,Осы жерде аяқтай аламыз ба? Күзетші!
Dialogue: 0,0:19:38.74,0:19:41.74,Default,,0,0,0,,Драйверді тексерудің алдыңғы триггері➡
Dialogue: 0,0:19:41.74,0:19:43.71,Default,,0,0,0,,Алдыңғы қатардағы қуат плюс 10 000!
Dialogue: 0,0:19:47.25,0:19:50.25,Default,,0,0,0,,Хаа~!
Dialogue: 0,0:19:51.22,0:19:53.85,Default,,0,0,0,,Осының өзі сізді сонда жете алмайды!
Dialogue: 0,0:19:53.85,0:19:57.26,Default,,0,0,0,,Күштері артқан тыл сақшысының шабуылы ше!
Dialogue: 0,0:19:57.26,0:19:59.26,Default,,0,0,0,,Egret Boost➡
Dialogue: 0,0:19:59.26,0:20:03.23,Default,,0,0,0,,Кезекті түрде шабуыл жасаңыз! Толық күзетші!
Dialogue: 0,0:20:03.23,0:20:06.23,Default,,0,0,0,,Истияның күшейтетін сальварымен шабуыл!
Dialogue: 0,0:20:07.23,0:20:09.70,Default,,0,0,0,,Тағы да толық күзет!
Dialogue: 0,0:20:13.24,0:20:16.24,Default,,0,0,0,,Қосу... Уф.
Dialogue: 0,0:20:16.24,0:20:18.75,Default,,0,0,0,,Хикари! Эй... күте тұрыңыз!
Dialogue: 0,0:20:19.75,0:20:21.72,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:20:24.25,0:20:27.22,Default,,0,0,0,,Сіз емделмегенсіз.
Dialogue: 0,0:20:28.72,0:20:31.23,Default,,0,0,0,,Бұл дүниенің адамы емес маған➡
Dialogue: 0,0:20:31.23,0:20:33.76,Default,,0,0,0,,Резаэльдің кереметі болмады➡
Dialogue: 0,0:20:33.76,0:20:36.73,Default,,0,0,0,,Бірақ бұл маңызды емес!
Dialogue: 0,0:20:36.73,0:20:39.23,Default,,0,0,0,,Менің денем қандай болса да➡
Dialogue: 0,0:20:39.23,0:20:41.24,Default,,0,0,0,,Билік сізге жүктелді!
Dialogue: 0,0:20:42.24,0:20:44.24,Default,,0,0,0,,Мен өзімді ұстамаймын.
Dialogue: 0,0:20:44.24,0:20:46.21,Default,,0,0,0,,Байқап көріңіз.
Dialogue: 0,0:20:47.74,0:20:50.24,Default,,0,0,0,,Мен тағы бір ұпай ала алмадым.
Dialogue: 0,0:20:50.24,0:20:52.28,Default,,0,0,0,,Жеңіске жету үшін келесі шабуыл➡
Dialogue: 0,0:20:52.28,0:20:54.75,Default,,0,0,0,,Енді мен өзімді қорғауым керек.
Dialogue: 0,0:20:54.75,0:20:56.75,Default,,0,0,0,,Соңына дейін авангард➡
Dialogue: 0,0:20:56.75,0:20:59.22,Default,,0,0,0,,Мен не болатынын білмеймін.
Dialogue: 0,0:20:59.22,0:21:01.22,Default,,0,0,0,,Heal Trigger арқылы қалпына келтірілген сома➡
Dialogue: 0,0:21:01.22,0:21:03.22,Default,,0,0,0,,Оны қорғау оңайырақ болды, бірақ...
Dialogue: 0,0:21:03.22,0:21:05.23,Default,,0,0,0,,Қарсы жақтың құдайлық өнері келсе ➡
Dialogue: 0,0:21:05.23,0:21:08.73,Default,,0,0,0,,2 рет қатарынан бір жақты соғу➡
Dialogue: 0,0:21:08.73,0:21:10.73,Default,,0,0,0,,Бұл үлкен дағдарыс болды.
Dialogue: 0,0:21:17.24,0:21:19.24,Default,,0,0,0,,Қызық болып барады, солай емес пе?
Dialogue: 0,0:21:19.24,0:21:22.24,Default,,0,0,0,,Матч шешілді ме?
Dialogue: 0,0:21:22.24,0:21:24.21,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:21:25.28,0:21:29.28,Default,,0,0,0,,Бұл жақта Хикари Мейдудың қолында бір ғана карта қалды.
Dialogue: 0,0:21:29.28,0:21:32.75,Default,,0,0,0,,Бұл қол себеп-салдарлық бұрмалау/соттау болмаса➡
Dialogue: 0,0:21:32.75,0:21:35.76,Default,,0,0,0,,Құдайдың шеберлігін белсендіру шарттарын орындау мүмкін емес.
Dialogue: 0,0:21:35.76,0:21:39.26,Default,,0,0,0,,Жарайды. Оның сезімдері шынайы.
Dialogue: 0,0:21:40.76,0:21:44.27,Default,,0,0,0,,Уақыт тағдыры оған міндетті түрде жауап береді!
Dialogue: 0,0:21:45.73,0:21:48.24,Default,,0,0,0,,Уақытты қайталаймын➡
Dialogue: 0,0:21:48.24,0:21:50.77,Default,,0,0,0,,Менің күнәларымды өшіремін➡
Dialogue: 0,0:21:50.77,0:21:53.24,Default,,0,0,0,,Бізде болуы керек уақытты қайтару үшін!
Dialogue: 0,0:21:55.24,0:21:58.21,Default,,0,0,0,,Енді сіздің кезегіңіз емес.
Dialogue: 0,0:21:59.71,0:22:05.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory