Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:03.42,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:00:08.55,0:00:11.55,Default,,0,0,0,,Бұл пойыз біртүрлі болып көрінбейді ме?
Dialogue: 0,0:00:12.13,0:00:13.93,Default,,0,0,0,,Менің айтайын дегенім, бұл кісі өлтіру...
Dialogue: 0,0:00:14.01,0:00:17.55,Default,,0,0,0,,Сіз Кристидің тым көп романдарын оқисыз.
Dialogue: 0,0:00:19.47,0:00:23.06,Default,,0,0,0,,Оның белгісі бар, бірақ бұл бір-екі адам емес.
Dialogue: 0,0:00:24.35,0:00:27.81,Default,,0,0,0,,Не, сіз оны Мори детектив агенттігіне жібердіңіз бе?
Dialogue: 0,0:00:27.90,0:00:30.82,Default,,0,0,0,,Өткен аптадағы кемпинг сапарынан бейне бар ма?
Dialogue: 0,0:00:31.48,0:00:32.94,Default,,0,0,0,,Сонымен…
Dialogue: 0,0:00:33.03,0:00:35.11,Default,,0,0,0,,Сізге таныс адам көмекке келгенше
Dialogue: 0,0:00:35.20,0:00:36.74,Default,,0,0,0,,Демімді басып, тығылып жатырмын.
Dialogue: 0,0:00:38.24,0:00:39.62,Default,,0,0,0,,Интернетке салсаңыз
Dialogue: 0,0:00:39.70,0:00:41.66,Default,,0,0,0,,Сіз біреуді білуіңіз мүмкін дедіңіз.
Dialogue: 0,0:00:42.41,0:00:43.79,Default,,0,0,0,,Бұл әйел кім?
Dialogue: 0,0:00:43.87,0:00:46.08,Default,,0,0,0,,Себебі мен жұмбақ пойыздың өту сақинасын ойнадым.
Dialogue: 0,0:00:46.17,0:00:47.88,Default,,0,0,0,,Мүмкін біз осында кездесерміз.
Dialogue: 0,0:00:47.96,0:00:50.00,Default,,0,0,0,,Мен оны әлі көрген жоқпын.
Dialogue: 0,0:00:51.50,0:00:52.34,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:00:53.55,0:00:56.34,Default,,0,0,0,,Менің кеудемдегі бұл сыбдырдың себебі неде?
Dialogue: 0,0:00:57.18,0:01:00.89,Default,,0,0,0,,Жоқ... болмайды олар...
Dialogue: 0,0:01:03.64,0:01:06.81,Default,,0,0,0,,Шери, егер сені жылан жұтып жатса
Dialogue: 0,0:01:06.90,0:01:09.73,Default,,0,0,0,,Бұл Нагоя сіздің соңғы аялдамаңыз.
Dialogue: 0,0:01:09.81,0:01:13.74,Default,,0,0,0,,«Дайынсың ба? Вермут».
Dialogue: 0,0:01:13.82,0:01:15.20,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:15.28,0:01:18.91,Default,,0,0,0,,Және ол бұрышта қалды
Dialogue: 0,0:01:21.08,0:01:26.08,Default,,0,0,0,,♪～
Dialogue: 0,0:01:40.64,0:01:43.31,Default,,0,0,0,,Мен Шихо Мияно, ғалыммын.
Dialogue: 0,0:01:43.39,0:01:46.77,Default,,0,0,0,,Мен жас кезімде ұйымға мүше болған ата-анамнан айырылдым.
Dialogue: 0,0:01:46.85,0:01:48.44,Default,,0,0,0,,Америкада шетелде оқу
Dialogue: 0,0:01:49.48,0:01:51.31,Default,,0,0,0,,Ата-аналардың зерттеулерін өз қолдарына алу
Dialogue: 0,0:01:51.40,0:01:55.61,Default,,0,0,0,,Код аты Шелли, ол ұйымда есірткіге зерттеу жүргізді.
Dialogue: 0,0:01:56.44,0:01:59.36,Default,,0,0,0,,Ұйымның өзімшіл мінез-құлқына қанықтым.
Dialogue: 0,0:02:00.53,0:02:05.29,Default,,0,0,0,,Оның жалғыз жақын жанұясы болған әпкесі Акеми Мияно өлтіріліп, ол ұйымға қарсы шықты.
Dialogue: 0,0:02:07.41,0:02:10.75,Default,,0,0,0,,Ол өз өмірін аяқтау үшін дәрі қабылдады.
Dialogue: 0,0:02:11.79,0:02:12.75,Default,,0,0,0,,Мен оянғанда...
Dialogue: 0,0:02:14.34,0:02:15.92,Default,,0,0,0,,Менің денем кішірейіп кетті.
Dialogue: 0,0:02:17.13,0:02:19.72,Default,,0,0,0,,Егер олар Шихо Мияноның тірі екенін білсе ше?
Dialogue: 0,0:02:19.80,0:02:21.26,Default,,0,0,0,,Бұл жолы сізді өлтіреді
Dialogue: 0,0:02:22.60,0:02:25.01,Default,,0,0,0,,Мен ұйымнан қашуға бел будым.
Dialogue: 0,0:02:25.10,0:02:27.06,Default,,0,0,0,,Сабаннан ұстау ниетімен
Dialogue: 0,0:02:27.14,0:02:31.81,Default,,0,0,0,,Балаға айналған уланған адамның үйіне барыңыз.
Dialogue: 0,0:02:31.90,0:02:35.32,Default,,0,0,0,,Хайбара өзін Ай деп атады және өзінің шынайы тұлғасын жасыруды шешті.
Dialogue: 0,0:02:37.49,0:02:41.91,Default,,0,0,0,,Оның аты Конан Эдогава, бастауыш сыныптың зерделі оқушысы.
Dialogue: 0,0:02:41.99,0:02:46.29,Default,,0,0,0,,Оның шынайы тұлғасы – Шиничи Кудо, орта мектептің детективі.
Dialogue: 0,0:02:47.16,0:02:51.33,Default,,0,0,0,,Иә, мен белгілі бір мәмілені қарауға берілгенмін.
Dialogue: 0,0:02:51.42,0:02:52.83,Default,,0,0,0,,Джин тапқан
Dialogue: 0,0:02:53.33,0:02:57.55,Default,,0,0,0,,Мен әзірлеген APTX4869 препаратын қабылдауға мәжбүр болдым.
Dialogue: 0,0:02:57.63,0:02:59.80,Default,,0,0,0,,Денеңіз кішірейіп кеткен сияқты.
Dialogue: 0,0:03:01.09,0:03:03.09,Default,,0,0,0,,Енді олардың мәліметтерін жинау
Dialogue: 0,0:03:03.18,0:03:06.39,Default,,0,0,0,,Ол детектив Моридің үйінде тұратын сияқты.
Dialogue: 0,0:03:07.60,0:03:09.39,Default,,0,0,0,,Сенімді болыңыз.
Dialogue: 0,0:03:09.48,0:03:13.40,Default,,0,0,0,,Өлімді растау үшін деректеріңіз өзгертілді.
Dialogue: 0,0:03:13.48,0:03:15.98,Default,,0,0,0,,Сіз өзіңіз туралы көп айтасыз.
Dialogue: 0,0:03:17.48,0:03:19.57,Default,,0,0,0,,Кішірейсең де, миың сол күйінде қалады
Dialogue: 0,0:03:19.65,0:03:21.70,Default,,0,0,0,,Ғажайып сүйкімді ғалым
Dialogue: 0,0:03:22.49,0:03:23.70,Default,,0,0,0,,Керемет сүйкімді?
Dialogue: 0,0:03:23.78,0:03:24.95,Default,,0,0,0,,Бұл
Dialogue: 0,0:03:27.45,0:03:31.46,Default,,0,0,0,,Әрқашан бір ақиқат бар!
Dialogue: 0,0:03:31.54,0:03:36.71,Default,,0,0,0,,～♪
Dialogue: 0,0:03:40.47,0:03:42.30,Default,,0,0,0,,Эй, естідің бе?
Dialogue: 0,0:03:42.38,0:03:45.22,Default,,0,0,0,,Бүгін осы сыныпқа ауысатын студент қосылады.
Dialogue: 0,0:03:45.30,0:03:46.85,Default,,0,0,0,,Иә, шынымен бе?
Dialogue: 0,0:03:46.93,0:03:50.68,Default,,0,0,0,,Хмм, менде Конан-куннан бері ауысатын студент болған жоқ.
Dialogue: 0,0:03:53.35,0:03:56.02,Default,,0,0,0,,Ол алдымызға шыққанда...
Dialogue: 0,0:03:56.11,0:03:57.69,Default,,0,0,0,,- (Гента) О! -(Аюми) Міне, осында.
Dialogue: 0,0:03:57.77,0:04:00.03,Default,,0,0,0,,Уау
Dialogue: 0,0:04:00.94,0:04:03.99,Default,,0,0,0,,Иә, бұл көрсеткіш қазірдің өзінде...
Dialogue: 0,0:04:04.07,0:04:07.70,Default,,0,0,0,,Сонымен... өте сүйкімді~
Dialogue: 0,0:04:13.25,0:04:16.58,Default,,0,0,0,,Иә, мен бүгіннен бастап барлығымен бірге оқимын.
Dialogue: 0,0:04:16.67,0:04:18.09,Default,,0,0,0,,Бұл Ай Хайбара.
Dialogue: 0,0:04:18.67,0:04:20.71,Default,,0,0,0,,Барлығыңыз жақсы араласыңыз.
Dialogue: 0,0:04:20.80,0:04:22.55,Default,,0,0,0,,Иә
Dialogue: 0,0:04:26.26,0:04:27.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:27.18,0:04:28.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:32.27,0:04:33.27,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:04:33.35,0:04:34.19,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:04:42.11,0:04:43.90,Default,,0,0,0,,Хайбара мырза
Dialogue: 0,0:04:45.24,0:04:49.37,Default,,0,0,0,,Хайбара-сан, менімен үйге бар.
Dialogue: 0,0:04:49.99,0:04:51.29,Default,,0,0,0,,Эй
Dialogue: 0,0:04:53.79,0:04:54.83,Default,,0,0,0,,А...
Dialogue: 0,0:04:54.91,0:04:57.79,Default,,0,0,0,,Қойшы мені, сондай тікенді әйел.
Dialogue: 0,0:04:57.88,0:04:59.17,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:01.46,0:05:02.51,Default,,0,0,0,,Иә
Dialogue: 0,0:05:03.05,0:05:04.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:06.22,0:05:08.93,Default,,0,0,0,,Содан кейін ол өзінің шынайы болмысын ашты.
Dialogue: 0,0:05:09.01,0:05:12.35,Default,,0,0,0,,ＡＰＴＸ４８６９
Dialogue: 0,0:05:12.43,0:05:13.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:13.56,0:05:15.31,Default,,0,0,0,,Сіз бұл не екенін білесіз бе?
Dialogue: 0,0:05:16.27,0:05:18.77,Default,,0,0,0,,Сізге берілген дәрінің атауы
Dialogue: 0,0:05:19.61,0:05:23.15,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Маған мұндай оғаш дәрі керек емес...
Dialogue: 0,0:05:23.23,0:05:25.99,Default,,0,0,0,,О, дәрінің аты дұрыс болуы керек.
Dialogue: 0,0:05:26.86,0:05:28.32,Default,,0,0,0,,Ұйымның тапсырысы бойынша
Dialogue: 0,0:05:30.49,0:05:32.41,Default,,0,0,0,,Мен жасаған дәрі
Dialogue: 0,0:05:36.16,0:05:37.12,Default,,0,0,0,,Шерри
Dialogue: 0,0:05:38.37,0:05:40.13,Default,,0,0,0,,Бұл менің код атым
Dialogue: 0,0:05:43.67,0:05:47.22,Default,,0,0,0,,Көрдім, ол әлі жоқ.
Dialogue: 0,0:05:47.30,0:05:52.10,Default,,0,0,0,,Кешіріңіз, аға, мен қолымнан келгеннің бәрін істеп жатырмын.
Dialogue: 0,0:05:53.77,0:05:55.93,Default,,0,0,0,,Оны мүмкіндігінше тезірек табыңыз
Dialogue: 0,0:05:56.02,0:05:58.10,Default,,0,0,0,,Мені алдыңа сүйреп апар.
Dialogue: 0,0:05:59.69,0:06:03.57,Default,,0,0,0,,Біз туралы білсе жаман болар еді.
Dialogue: 0,0:06:05.61,0:06:10.07,Default,,0,0,0,,Тірі ме, өлі ме, әрине маған бәрібір, иә...
Dialogue: 0,0:06:11.16,0:06:12.16,Default,,0,0,0,,Ол өлтірілді.
Dialogue: 0,0:06:12.24,0:06:13.66,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:15.08,0:06:17.46,Default,,0,0,0,,Ұйымдағы әріптестеріңіздің қолында.
Dialogue: 0,0:06:23.25,0:06:26.30,Default,,0,0,0,,Әпкем менің ұйымнан кеткенімді қалады.
Dialogue: 0,0:06:26.38,0:06:28.55,Default,,0,0,0,,Ұйымдастыру жұмыстарында бағымды сынап көрдім.
Dialogue: 0,0:06:28.63,0:06:30.64,Default,,0,0,0,,Конан Эдогава?
Dialogue: 0,0:06:30.72,0:06:34.22,Default,,0,0,0,,Қараңызшы, мен өткен күні сөйлескен көзілдірік киген бала.
Dialogue: 0,0:06:34.76,0:06:37.52,Default,,0,0,0,,Қараңдар, сенің де шаруаң бар.
Dialogue: 0,0:06:37.60,0:06:40.90,Default,,0,0,0,,Бейка-чодағы біреудің үйіне барамын дедіңіз.
Dialogue: 0,0:06:40.98,0:06:43.44,Default,,0,0,0,,Ах, Шиничи Кудо
Dialogue: 0,0:06:43.52,0:06:46.90,Default,,0,0,0,,Дұрыс, жергілікті детектив мекемесінің баласы.
Dialogue: 0,0:06:47.49,0:06:49.70,Default,,0,0,0,,Бір нәрсе өзгерді, солай емес пе?
Dialogue: 0,0:06:49.78,0:06:52.03,Default,,0,0,0,,Бала болсаң да, сабырлысың.
Dialogue: 0,0:06:52.12,0:06:53.62,Default,,0,0,0,,Мен ересектерге көбірек ұқсайды дер едім.
Dialogue: 0,0:06:53.70,0:06:56.54,Default,,0,0,0,,Керісінше, апа, жақсысыз ба?
Dialogue: 0,0:06:56.62,0:06:59.33,Default,,0,0,0,,Мен қорқынышты нәрсе болып жатқанын естідім.
Dialogue: 0,0:06:59.41,0:07:01.83,Default,,0,0,0,,Уайымдама, істер жақсы жүріп жатыр.
Dialogue: 0,0:07:02.42,0:07:05.34,Default,,0,0,0,,Мен сені уайымдаймын, Шихо.
Dialogue: 0,0:07:05.42,0:07:07.30,Default,,0,0,0,,Ешқандай дәрі жасамаңыз.
Dialogue: 0,0:07:07.88,0:07:09.88,Default,,0,0,0,,Өзіңіздің ғашықтарыңыздың кем дегенде біреуін жасаңыз.
Dialogue: 0,0:07:11.13,0:07:13.22,Default,,0,0,0,,Әпкең жақсы болады.
Dialogue: 0,0:07:16.06,0:07:17.60,Default,,0,0,0,,Не ойнап жүрсің осылайша кішкентай баланы таптап!
Dialogue: 0,0:07:18.89,0:07:20.39,Default,,0,0,0,,Не ойнап жүрсің осылайша кішкентай баланы таптап!
Dialogue: 0,0:07:30.74,0:07:32.03,Default,,0,0,0,,Неге...
Dialogue: 0,0:07:34.12,0:07:38.29,Default,,0,0,0,,Неге апаңа көмектеспедің?
Dialogue: 0,0:07:39.62,0:07:42.00,Default,,0,0,0,,Әй... әпке?
Dialogue: 0,0:07:42.58,0:07:44.08,Default,,0,0,0,,Әлі де сенімді емессіз бе?
Dialogue: 0,0:07:44.17,0:07:46.21,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:07:48.50,0:07:50.21,Default,,0,0,0,,Акеми Мияно
Dialogue: 0,0:07:52.43,0:07:56.39,Default,,0,0,0,,Мен оны сұрадым, кішкентай детектив.
Dialogue: 0,0:07:58.39,0:08:01.02,Default,,0,0,0,,Бұл адам сіздің әпкеңіз болды ма?
Dialogue: 0,0:08:01.10,0:08:03.06,Default,,0,0,0,,Егер менде де сіз сияқты ойлау қабілеті болса
Dialogue: 0,0:08:03.14,0:08:06.48,Default,,0,0,0,,Сіздің әпкеңізді көру оңай болмауы керек еді.
Dialogue: 0,0:08:06.56,0:08:09.44,Default,,0,0,0,,Тіпті...
Dialogue: 0,0:08:09.53,0:08:11.32,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:11.40,0:08:12.40,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:08:12.49,0:08:14.86,Default,,0,0,0,,Ащы да қайғылы оқиғаның соңында
Dialogue: 0,0:08:14.95,0:08:19.79,Default,,0,0,0,,Қара ұйым өлтірген оның әпкесі Акеми Мияно
Dialogue: 0,0:08:21.41,0:08:23.29,Default,,0,0,0,,Дірілдеген көз жасы
Dialogue: 0,0:08:24.79,0:08:28.88,Default,,0,0,0,,Ол маған бірінші рет көрсетті.
Dialogue: 0,0:08:28.96,0:08:31.26,Default,,0,0,0,,Мүмкін бұл оның шынайы бет-бейнесі шығар.
Dialogue: 0,0:08:31.34,0:08:34.97,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:36.26,0:08:38.35,Default,,0,0,0,,Мен жаңа ғана компанияға келдім.
Dialogue: 0,0:08:38.43,0:08:42.02,Default,,0,0,0,,Олар менің жүзімді кішкентай кезімнен біледі.
Dialogue: 0,0:08:42.10,0:08:43.35,Default,,0,0,0,,Әй, сәл күте тұрыңыз.
Dialogue: 0,0:08:48.19,0:08:49.90,Default,,0,0,0,,Оларды қазір ұмытыңыз.
Dialogue: 0,0:08:49.98,0:08:51.48,Default,,0,0,0,,сәйкестік
Dialogue: 0,0:08:51.57,0:08:56.11,Default,,0,0,0,,Мен шын мәнінде 18 жастағы жігітпін, ол сізге жақсы сәйкес келеді.
Dialogue: 0,0:08:56.20,0:08:57.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:58.62,0:09:00.24,Default,,0,0,0,,Мен аштан өліп бара жатырмын! Жұт, тез!
Dialogue: 0,0:09:02.91,0:09:04.96,Default,,0,0,0,,Эй, Изуна.
Dialogue: 0,0:09:07.75,0:09:08.83,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,0:09:08.92,0:09:10.09,Default,,0,0,0,,Және…
Dialogue: 0,0:09:10.80,0:09:12.51,Default,,0,0,0,,Конан-кун!
Dialogue: 0,0:09:12.59,0:09:13.92,Default,,0,0,0,,- (Хайбара) Жарайды - (Аюми) А?
Dialogue: 0,0:09:14.84,0:09:17.47,Default,,0,0,0,,Эдогава-кун - сізді уайымдайтын адам.
Dialogue: 0,0:09:17.55,0:09:18.89,Default,,0,0,0,,Мен қауіпті адам емеспін.
Dialogue: 0,0:09:20.35,0:09:22.31,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:09:23.47,0:09:27.90,Default,,0,0,0,,Бірте-бірте арамыздағы қашықтық жақындай түсті.
Dialogue: 0,0:09:28.40,0:09:30.11,Default,,0,0,0,,- (Аюми) Хайбара мырза - (Хайбара) Мықты болыңыз.
Dialogue: 0,0:09:30.73,0:09:34.07,Default,,0,0,0,,Сіз бұл нанды Эдогава-кунға жеткізесіз, солай ма?
Dialogue: 0,0:09:36.53,0:09:37.53,Default,,0,0,0,,Иә
Dialogue: 0,0:09:47.29,0:09:51.00,Default,,0,0,0,,Бірақ тағдырдың көлеңкесі де...
Dialogue: 0,0:09:51.09,0:09:53.71,Default,,0,0,0,,Ол міндетті түрде оған жақындады.
Dialogue: 0,0:10:03.14,0:10:04.81,Default,,0,0,0,,Жұмбақ пойыз?
Dialogue: 0,0:10:05.60,0:10:07.06,Default,,0,0,0,,Beltree Express?
Dialogue: 0,0:10:07.73,0:10:11.90,Default,,0,0,0,,Мен Шерридің мұндай күлкілі пойызға отырғанын елестете алмаймын.
Dialogue: 0,0:10:11.98,0:10:15.57,Default,,0,0,0,,Әй, сондықтан бұл батыл таңдау, солай емес пе?
Dialogue: 0,0:10:16.15,0:10:18.32,Default,,0,0,0,,Бұл пойыз толығымен жеке.
Dialogue: 0,0:10:18.40,0:10:21.70,Default,,0,0,0,,Біздің көзімізді ұрлап, Кантодан қалай құтыламыз
Dialogue: 0,0:10:21.78,0:10:24.49,Default,,0,0,0,,Менің ойымша, бұл тамаша көлік құралы.
Dialogue: 0,0:10:24.58,0:10:27.04,Default,,0,0,0,,Бірақ мен оған сене алар емеспін.
Dialogue: 0,0:10:27.12,0:10:28.66,Default,,0,0,0,,Шерри сол пойызға отырса
Dialogue: 0,0:10:29.42,0:10:32.04,Default,,0,0,0,,Сіз бұл тамаша аң аулайтын жер деп ойламайсыз ба?
Dialogue: 0,0:10:32.13,0:10:33.13,Default,,0,0,0,,О
Dialogue: 0,0:10:33.21,0:10:36.92,Default,,0,0,0,,Менің жолдан түсуімді тоқтатсаң, бұл жұмыс істеп тұрған темір түрме.
Dialogue: 0,0:10:37.51,0:10:40.68,Default,,0,0,0,,Бұғыларды аулағандай, қорқып айдасаң
Dialogue: 0,0:10:40.76,0:10:44.22,Default,,0,0,0,,Мылтықтың аузына ілінетін.
Dialogue: 0,0:10:44.31,0:10:47.73,Default,,0,0,0,,Неліктен мен сізге бұл ақпаратты әдейі жарияладым?
Dialogue: 0,0:10:47.81,0:10:49.02,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:10:49.10,0:10:53.44,Default,,0,0,0,,Темір жылан ініне оралмайынша, оны ұстама, солай ма?
Dialogue: 0,0:10:54.11,0:10:59.20,Default,,0,0,0,,Көптен кейін Шерридің атын сенің аузыңнан естігеніме қуаныштымын.
Dialogue: 0,0:10:59.28,0:11:02.78,Default,,0,0,0,,Менің ойымша, әйелдер арасында біртүрлі буддалық сезімдер болуы мүмкін.
Dialogue: 0,0:11:02.87,0:11:04.12,Default,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:11:04.20,0:11:09.12,Default,,0,0,0,,Хахаха, ақымақ, мені кім деп ойлайсың?
Dialogue: 0,0:11:10.41,0:11:14.54,Default,,0,0,0,,Әйтеуір, аңшылық біткен соң мен сізге қайтамын.
Dialogue: 0,0:11:14.63,0:11:15.71,Default,,0,0,0,,О
Dialogue: 0,0:11:17.67,0:11:21.55,Default,,0,0,0,,Тек ол бұл дүниеде болмауы керек.
Dialogue: 0,0:11:26.93,0:11:28.72,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:11:28.81,0:11:30.94,Default,,0,0,0,,Паровозды бірінші рет көру
Dialogue: 0,0:11:31.02,0:11:32.48,Default,,0,0,0,,Жоспар
Dialogue: 0,0:11:32.56,0:11:34.52,Default,,0,0,0,,Бұл өте әсерлі
Dialogue: 0,0:11:34.61,0:11:37.15,Default,,0,0,0,,Ал, SL тек сыртқы көріністе.
Dialogue: 0,0:11:37.23,0:11:40.49,Default,,0,0,0,,Ішінде заманауи тепловоз болса керек.
Dialogue: 0,0:11:40.57,0:11:42.57,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:11:42.66,0:11:45.07,Default,,0,0,0,,Ай-чан, сен суықтан айықпадың ба?
Dialogue: 0,0:11:45.16,0:11:48.95,Default,,0,0,0,,Иә, біреудің микробтары тұрақты.
Dialogue: 0,0:11:49.04,0:11:50.87,Default,,0,0,0,,Бұл жағдайда үйде ұйықтаңыз.
Dialogue: 0,0:11:50.96,0:11:53.79,Default,,0,0,0,,Әй, бауырлар
Dialogue: 0,0:11:53.87,0:11:58.59,Default,,0,0,0,,Bell Tree Express иесі Suzuki Zaibatsu-ға ризашылық білдіріңіз.
Dialogue: 0,0:11:58.67,0:12:00.88,Default,,0,0,0,,Себебі мен сендерге арнайы орын алып қойғанмын.
Dialogue: 0,0:12:00.97,0:12:02.13,Default,,0,0,0,,Иә
Dialogue: 0,0:12:02.84,0:12:06.18,Default,,0,0,0,,Жарайды, біздің орындар сенікінен бөлек.
Dialogue: 0,0:12:06.26,0:12:08.81,Default,,0,0,0,,Бұл бірінші класстағы жылтыр көлік.
Dialogue: 0,0:12:08.89,0:12:12.23,Default,,0,0,0,,Ойлап қарасам, бұл бірінші класты көлік екен.
Dialogue: 0,0:12:12.31,0:12:14.52,Default,,0,0,0,,Мен сізге Бала келесі жолы мені нысанаға алатынын ескерттім.
Dialogue: 0,0:12:14.60,0:12:16.36,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:12:16.44,0:12:20.28,Default,,0,0,0,,Бұл пойыз әдетте жылына бір рет жүреді.
Dialogue: 0,0:12:20.36,0:12:23.24,Default,,0,0,0,,Джирокичи ағай маған ерекше жүгірді.
Dialogue: 0,0:12:23.32,0:12:26.49,Default,,0,0,0,,Егер сіз зергерлік бұйымдарды көрмеге қоятыныңызды хабарласаңыз...
Dialogue: 0,0:12:26.57,0:12:28.45,Default,,0,0,0,,Кид мырза, мініңіз.
Dialogue: 0,0:12:28.99,0:12:31.16,Default,,0,0,0,,Бұл жолы мен бір қадам алда боламын.
Dialogue: 0,0:12:31.25,0:12:33.00,Default,,0,0,0,,Оған махаббат хаты —
Dialogue: 0,0:12:33.08,0:12:36.42,Default,,0,0,0,,Мен оны көлікке тығып қоюды ойлап жүрмін, бірақ не істерімді білмеймін.
Dialogue: 0,0:12:36.50,0:12:38.67,Default,,0,0,0,,Мен таң қалдым ...
Dialogue: 0,0:12:38.75,0:12:41.76,Default,,0,0,0,,Менің мұндай хатқа уақытым жоқ деп ойлаймын, Бала.
Dialogue: 0,0:12:42.34,0:12:45.76,Default,,0,0,0,,Айтайын дегенім, Кёгоку-сан, мен қатты ашуландым.
Dialogue: 0,0:12:45.84,0:12:48.51,Default,,0,0,0,,Менің Кид-самаға деген махаббатым бөлек.
Dialogue: 0,0:12:48.60,0:12:51.14,Default,,0,0,0,,Мен анау ұрыдан жақсымын
Dialogue: 0,0:12:51.22,0:12:53.14,Default,,0,0,0,,Ол мұны әр уақытта көлікте жасайтынын айтады.
Dialogue: 0,0:12:53.23,0:12:55.77,Default,,0,0,0,,Мені дәлелдеу викторинасы көбірек қызықтырады.
Dialogue: 0,0:12:55.85,0:12:57.65,Default,,0,0,0,,Сера-сан, неге?
Dialogue: 0,0:12:57.73,0:12:58.65,Default,,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:12:58.73,0:13:01.78,Default,,0,0,0,,Мен детективпін, сондықтан мінгенім табиғи нәрсе.
Dialogue: 0,0:13:01.86,0:13:04.40,Default,,0,0,0,,...Әкең де сондай емес пе?
Dialogue: 0,0:13:04.49,0:13:07.24,Default,,0,0,0,,Иә? Мен бір сәт бұрын сонда болдым
Dialogue: 0,0:13:08.45,0:13:10.16,Default,,0,0,0,,Бұл Андо-сама
Dialogue: 0,0:13:10.24,0:13:12.37,Default,,0,0,0,,Бұл не өзі…?>
Dialogue: 0,0:13:12.45,0:13:14.12,Default,,0,0,0,,Мен сіздің жүгіңізді әкелейін бе?
Dialogue: 0,0:13:14.21,0:13:16.29,Default,,0,0,0,,Жоқ, маңызды емес.
Dialogue: 0,0:13:16.37,0:13:20.42,Default,,0,0,0,,Бұл өте ауыр, себебі бұл клиент маған сеніп тапсырған маңызды зат.
Dialogue: 0,0:13:21.17,0:13:24.01,Default,,0,0,0,,Ендеше, ауыр нәрсе – саф алтын жақтау.
Dialogue: 0,0:13:24.09,0:13:26.18,Default,,0,0,0,,Сурет жалған болғанымен.
Dialogue: 0,0:13:26.26,0:13:27.84,Default,,0,0,0,,Енді бағалау аяқталды
Dialogue: 0,0:13:27.93,0:13:30.76,Default,,0,0,0,,Мен оны Нагоядағы клиентіме қайтарамын.
Dialogue: 0,0:13:30.85,0:13:35.14,Default,,0,0,0,,Әй, бұл пойыз баратын жері белгісіз жұмбақ пойыз.
Dialogue: 0,0:13:35.23,0:13:36.98,Default,,0,0,0,,Нагояға не үшін бару керек?
Dialogue: 0,0:13:37.06,0:13:40.15,Default,,0,0,0,,Сәлем, дирижер
Dialogue: 0,0:13:40.23,0:13:43.15,Default,,0,0,0,,Бізбен бетпе-бет келгеніңізге қанша жыл болды?
Dialogue: 0,0:13:43.23,0:13:45.24,Default,,0,0,0,,Бүгін қандай пойыздасың?
Dialogue: 0,0:13:45.32,0:13:47.91,Default,,0,0,0,,Жүргізу уақытының өзгергенін тексеріңіз.
Dialogue: 0,0:13:47.99,0:13:49.87,Default,,0,0,0,,Болжау оңай емес пе?
Dialogue: 0,0:13:49.95,0:13:51.28,Default,,0,0,0,,Міне, дәл осылай мүлдем әлсіз болу дегенді айтады, иә, Польнарефф?
Dialogue: 0,0:13:51.37,0:13:54.83,Default,,0,0,0,,Біздің интеллектуалдық толқудың мақсаты қандай?
Dialogue: 0,0:13:54.91,0:13:57.96,Default,,0,0,0,,Тек машинада кездесетін жұмбақтар
Dialogue: 0,0:13:58.04,0:14:00.79,Default,,0,0,0,,Дұрыс, Сумитомо мырза.
Dialogue: 0,0:14:00.88,0:14:02.63,Default,,0,0,0,,Иә, ханым
Dialogue: 0,0:14:02.71,0:14:07.17,Default,,0,0,0,,Барлық жұмбақ білушілер күткендей, мен сізді көргеніме өкінемін.
Dialogue: 0,0:14:07.26,0:14:08.55,Default,,0,0,0,,Кәсібі: тыңшы
Dialogue: 0,0:14:08.63,0:14:10.93,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:14:11.01,0:14:13.89,Default,,0,0,0,,Мен, әрине, осы №8 вагонның бірінші класс көлігіндемін.
Dialogue: 0,0:14:13.97,0:14:15.98,Default,,0,0,0,,Мен әдеттегі бөлмені брондасам да.
Dialogue: 0,0:14:16.06,0:14:18.39,Default,,0,0,0,,Неліктен ол No7 вагонға ауыстырылды?
Dialogue: 0,0:14:19.02,0:14:20.69,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:20.77,0:14:24.15,Default,,0,0,0,,Мен сізге өткен күні хабарлағанымдай,
Dialogue: 0,0:14:24.23,0:14:27.70,Default,,0,0,0,,Менің ебедейсіздігіме байланысты ескертпелер қайталанды.
Dialogue: 0,0:14:27.78,0:14:30.66,Default,,0,0,0,,Бізде Мурохаши мырзаның бөлмесін ауыстырудан басқа амал қалмады.
Dialogue: 0,0:14:30.74,0:14:32.53,Default,,0,0,0,,Бұл бөлме менің сүйікті бөлмем.
Dialogue: 0,0:14:32.62,0:14:35.49,Default,,0,0,0,,Мен оны шығарғаннан кейін жыл сайын ескертпелер жасасам да.
Dialogue: 0,0:14:35.58,0:14:38.04,Default,,0,0,0,,Кім кірді?
Dialogue: 0,0:14:38.12,0:14:40.42,Default,,0,0,0,,Мына жігіт.
Dialogue: 0,0:14:41.21,0:14:43.13,Default,,0,0,0,,Эй, кешіріңіз.
Dialogue: 0,0:14:43.75,0:14:47.63,Default,,0,0,0,,Менің қызым осы пойыз иесінің досы.
Dialogue: 0,0:14:48.22,0:14:51.68,Default,,0,0,0,,Жарайды, уайымдама, мен мінемін.
Dialogue: 0,0:14:51.76,0:14:54.93,Default,,0,0,0,,Бұл пойызда не болғанына қарамастан,
Dialogue: 0,0:14:56.85,0:15:00.19,Default,,0,0,0,,Бұл ұлы детектив, Пуиро Моури, бірден
Dialogue: 0,0:15:00.27,0:15:02.35,Default,,0,0,0,,Мен саған түсіндіремін.
Dialogue: 0,0:15:04.77,0:15:05.69,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:05.77,0:15:09.11,Default,,0,0,0,,Әй, әке, не істеп жатырсың?
Dialogue: 0,0:15:09.19,0:15:13.24,Default,,0,0,0,,Ей, №8 вагонда бізге қосылатын барлық адамдарға сәлем берейік.
Dialogue: 0,0:15:13.32,0:15:17.41,Default,,0,0,0,,...Бұл жерде темекі шегуге болмайды, сонда бұл не, Пуаро?
Dialogue: 0,0:15:17.49,0:15:19.46,Default,,0,0,0,,Сіздің әкеңіз Когоро Моури, солай ма?
Dialogue: 0,0:15:19.54,0:15:20.71,Default,,0,0,0,,О, сен мұны естідің бе?
Dialogue: 0,0:15:20.79,0:15:24.21,Default,,0,0,0,,Қараңдаршы, барлығы No6 вагонның алдында күтіп тұр.
Dialogue: 0,0:15:24.29,0:15:26.88,Default,,0,0,0,,Кетер алдында бәріміз суретке түсейік
Dialogue: 0,0:15:26.96,0:15:28.13,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:15:28.76,0:15:31.93,Default,,0,0,0,,Бұл не? Бұл дірілдеген ауа
Dialogue: 0,0:15:32.64,0:15:36.10,Default,,0,0,0,,Қарттың тергеуші екенін білгендіктен бе? Немесе...
Dialogue: 0,0:15:36.64,0:15:39.06,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:15:55.03,0:15:56.37,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:16:10.01,0:16:11.76,Default,,0,0,0,,Ғажайып таңғажайып
Dialogue: 0,0:16:11.84,0:16:13.97,Default,,0,0,0,,Барлығы вокзалдан өтіп жатыр.
Dialogue: 0,0:16:14.05,0:16:17.85,Default,,0,0,0,,Соңғы станцияға дейін тоқтаусыз дерлік.
Dialogue: 0,0:16:17.93,0:16:19.52,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:16:19.60,0:16:22.64,Default,,0,0,0,,Ақырғы нүкте қайда екені жұмбақ.
Dialogue: 0,0:16:22.73,0:16:24.35,Default,,0,0,0,,- Бұл Нагоя - (Агаса) Иә?
Dialogue: 0,0:16:24.94,0:16:27.77,Default,,0,0,0,,Қызмет күйін желіде тексерсеңіз
Dialogue: 0,0:16:27.86,0:16:29.86,Default,,0,0,0,,Сіз бұл пойыздағы сызықтарды көре аласыз.
Dialogue: 0,0:16:29.94,0:16:31.94,Default,,0,0,0,,Жұмбақ пойызда
Dialogue: 0,0:16:32.03,0:16:34.11,Default,,0,0,0,,Атқа мінсем де, арманым жоқ...
Dialogue: 0,0:16:34.66,0:16:36.74,Default,,0,0,0,,Мені көбірек алаңдататын нәрсе
Dialogue: 0,0:16:36.82,0:16:40.41,Default,,0,0,0,,Бұл пойыз жүріп жатқанда берілген шегерімге арналған тест.
Dialogue: 0,0:16:40.49,0:16:42.91,Default,,0,0,0,,Кейбір жолаушылар бұл өсек екенін айтты.
Dialogue: 0,0:16:43.00,0:16:45.87,Default,,0,0,0,,Кінәлінің рөлі мен жәбірленушінің рөлі кездейсоқ таңдалады.
Dialogue: 0,0:16:45.96,0:16:49.71,Default,,0,0,0,,Оқиға орын алып, қалған жолаушылар детектив болады.
Dialogue: 0,0:16:49.80,0:16:53.72,Default,,0,0,0,,Терминал станциясына жеткенше кінәліні анықтау идеясы сияқты.
Dialogue: 0,0:16:55.63,0:16:57.09,Default,,0,0,0,,Иә, бұл не?
Dialogue: 0,0:16:58.51,0:16:59.35,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:00.26,0:17:01.85,Default,,0,0,0,,Мұнда ешкім жоқ
Dialogue: 0,0:17:01.93,0:17:03.81,Default,,0,0,0,,Иә? хат?
Dialogue: 0,0:17:07.23,0:17:08.23,Default,,0,0,0,,«Құттықтаймыз»
Dialogue: 0,0:17:08.31,0:17:11.23,Default,,0,0,0,,«Сіз детектив рөлін ойнауға таңдалдыңыз».
Dialogue: 0,0:17:11.82,0:17:16.86,Default,,0,0,0,,«No7 вагонның В бөлмесінде 10 минуттан кейін оқиға орын алып, тергелетін болады».
Dialogue: 0,0:17:17.78,0:17:20.62,Default,,0,0,0,,Барлық жолаушылар детективтер емес пе?
Dialogue: 0,0:17:20.70,0:17:25.12,Default,,0,0,0,,№ 7 В автокөлігінің В
Dialogue: 0,0:17:25.21,0:17:26.87,Default,,0,0,0,,Міне болды! Бұл бөлме.
Dialogue: 0,0:17:28.29,0:17:30.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:17:30.09,0:17:31.21,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:31.30,0:17:32.96,Default,,0,0,0,,Ой, ақымақ, кірме!
Dialogue: 0,0:17:35.97,0:17:39.68,Default,,0,0,0,,Уау, бұл ғажап, шынайы көрінеді
Dialogue: 0,0:17:39.76,0:17:41.72,Default,,0,0,0,,- (Мицухико) Қуып алайық - (Гента) Жүр!
Dialogue: 0,0:17:41.81,0:17:44.73,Default,,0,0,0,,Қараңдаршы, Конан-кун мен Ай-чан да.
Dialogue: 0,0:17:45.64,0:17:48.48,Default,,0,0,0,,Бұл жұмбақ емес...
Dialogue: 0,0:17:48.56,0:17:50.31,Default,,0,0,0,,Бұл жай ғана тег ойыны.
Dialogue: 0,0:18:01.62,0:18:03.83,Default,,0,0,0,,Мен оның ізін жоғалттым.
Dialogue: 0,0:18:03.91,0:18:07.75,Default,,0,0,0,,Тек жеке бөлмелер бар, сондықтан бөлмеге кіргеніңізді білмейсіз.
Dialogue: 0,0:18:07.83,0:18:08.71,Default,,0,0,0,,(Саяма) Ой! (Джунпей) Уф...
Dialogue: 0,0:18:08.79,0:18:09.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:09.71,0:18:12.54,Default,,0,0,0,,Бұл пойызға бірінші рет мініп отырсыз ба?
Dialogue: 0,0:18:12.63,0:18:13.55,Default,,0,0,0,,Иә
Dialogue: 0,0:18:13.63,0:18:15.42,Default,,0,0,0,,Онда сіз өз бөлмеңізде қалуыңыз керек.
Dialogue: 0,0:18:16.17,0:18:20.14,Default,,0,0,0,,Ағымдағы дәлелдеу викторинасы бөлмедегі спикерлерден хабарланады.
Dialogue: 0,0:18:20.22,0:18:22.85,Default,,0,0,0,,Не, әлі ештеңе болған жоқ па?
Dialogue: 0,0:18:22.93,0:18:26.73,Default,,0,0,0,,А, бұл жолы бір сағаттан кейін болған шығар.
Dialogue: 0,0:18:27.85,0:18:29.39,Default,,0,0,0,,Сонда не болды?
Dialogue: 0,0:18:30.19,0:18:31.73,Default,,0,0,0,,Сәлем, Конан!
Dialogue: 0,0:18:31.81,0:18:32.90,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:18:32.98,0:18:34.48,Default,,0,0,0,,Ай Чан, кеттік
Dialogue: 0,0:18:34.57,0:18:35.82,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:18:36.61,0:18:37.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:40.74,0:18:41.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:46.33,0:18:47.87,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:48.54,0:18:49.83,Default,,0,0,0,,Ай-чан
Dialogue: 0,0:18:53.17,0:18:55.59,Default,,0,0,0,,Эй, Ай Чан, кеттік.
Dialogue: 0,0:18:56.09,0:18:57.26,Default,,0,0,0,,Иә
Dialogue: 0,0:19:03.47,0:19:05.47,Default,,0,0,0,,Жоқ... мүмкін емес
Dialogue: 0,0:19:12.27,0:19:14.57,Default,,0,0,0,,Эй, Конан, не болды?
Dialogue: 0,0:19:14.65,0:19:18.57,Default,,0,0,0,,Әйелдің бөлмесіне кіргенде, тым болмаса қағып кетіңіз.
Dialogue: 0,0:19:18.65,0:19:20.53,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:19:20.61,0:19:22.45,Default,,0,0,0,,Бұл №7 көлік, солай ма?
Dialogue: 0,0:19:22.53,0:19:23.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:23.74,0:19:26.33,Default,,0,0,0,,Сіз не айттыңыз? Бұл №8 көлік
Dialogue: 0,0:19:26.41,0:19:29.33,Default,,0,0,0,,Мен қонаққа келдім.
Dialogue: 0,0:19:35.17,0:19:36.46,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:19:37.09,0:19:39.80,Default,,0,0,0,,Мен көліктерді қате санадым деп ойламадым.
Dialogue: 0,0:19:39.88,0:19:41.22,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:19:41.30,0:19:44.30,Default,,0,0,0,,Көлік нөмірі тек көліктің шанағында болады.
Dialogue: 0,0:19:44.39,0:19:45.72,Default,,0,0,0,,Бөлменің есігінде
Dialogue: 0,0:19:45.80,0:19:49.06,Default,,0,0,0,,Алфавиттің тек бір әрпі көрсетіледі.
Dialogue: 0,0:19:49.14,0:19:50.89,Default,,0,0,0,,- (Агаса) О - (Мицухико/Конан) Иә?
Dialogue: 0,0:19:50.98,0:19:53.77,Default,,0,0,0,,Қалай болды? Дәлелдеу викторинасына келетін болсақ
Dialogue: 0,0:19:53.85,0:19:57.82,Default,,0,0,0,,Дәрігер, бұл 6-көліктегі біздің бөлме ме?
Dialogue: 0,0:19:57.90,0:20:00.19,Default,,0,0,0,,Не? О қара
Dialogue: 0,0:20:00.28,0:20:03.70,Default,,0,0,0,,Балалар, қазір жеп отырған тәттілеріңіз бұрынғыдай.
Dialogue: 0,0:20:03.78,0:20:05.62,Default,,0,0,0,,Сәлем Конан
Dialogue: 0,0:20:05.70,0:20:06.91,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:20:06.99,0:20:10.66,Default,,0,0,0,,№8 вагоннан бір орынға ғана көшсек те.
Dialogue: 0,0:20:11.25,0:20:12.71,Default,,0,0,0,,№7 вагон...
Dialogue: 0,0:20:13.33,0:20:17.17,Default,,0,0,0,,Сонымен No7 көлік жүріп бара жатып жоғалып кетті ме?
Dialogue: 0,0:20:20.96,0:20:22.93,Default,,0,0,0,,№7 автокөлік жоғалып кетті ме?
Dialogue: 0,0:20:23.01,0:20:24.47,Default,,0,0,0,,Соған қарамастан, бұл түтін неге осынша көп?
Dialogue: 0,0:20:24.55,0:20:27.93,Default,,0,0,0,,Дәл осыдан бұрын №7 вагонда қол мылтығымен оқ атқан қарт адам болған.
Dialogue: 0,0:20:28.01,0:20:29.81,Default,,0,0,0,,Әлгі қарияның бөлмесінен
Dialogue: 0,0:20:29.89,0:20:32.81,Default,,0,0,0,,Атқыш секіріп кетті, мен оны қудым.
Dialogue: 0,0:20:32.89,0:20:34.73,Default,,0,0,0,,Оны жоғалтты.
Dialogue: 0,0:20:34.81,0:20:39.32,Default,,0,0,0,,Оққа ұшқан жолаушы отырған №7 вагонға қайтып келгенімде, №8 вагонда екенімді білдім.
Dialogue: 0,0:20:39.40,0:20:41.74,Default,,0,0,0,,Ке... тапанша...
Dialogue: 0,0:20:41.82,0:20:45.86,Default,,0,0,0,,Онда неге бұл туралы кондукторға бірден айтпадың?
Dialogue: 0,0:20:45.95,0:20:49.12,Default,,0,0,0,,Ол кезде мен бұл шегерімге арналған викторина деп ойладым.
Dialogue: 0,0:20:49.20,0:20:51.62,Default,,0,0,0,,Бәрібір тексеріңіз.
Dialogue: 0,0:20:51.70,0:20:55.25,Default,,0,0,0,,Оққа ұшқан жолаушымен бірге №7 автокөлік жоғалып кетті.
Dialogue: 0,0:20:55.83,0:20:59.88,Default,,0,0,0,,Бұл жағдайда әр вагондағы кондуктордан сұрау керек.
Dialogue: 0,0:20:59.96,0:21:04.34,Default,,0,0,0,,Ол мен сияқты вагон дәлізінің артқы жағындағы орындықта отыр.
Dialogue: 0,0:21:04.42,0:21:06.22,Default,,0,0,0,,(есік қоңырауының дыбысы)
Dialogue: 0,0:21:06.30,0:21:08.64,Default,,0,0,0,,Жарайсыңдар, балалар қателестіңдер.
Dialogue: 0,0:21:08.72,0:21:13.23,Default,,0,0,0,,Пойыздың ішінде көлік нөмірі иесінің қалауына байланысты көрсетілмейді.
Dialogue: 0,0:21:13.81,0:21:15.10,Default,,0,0,0,,Меншік иесінің ниеті?
Dialogue: 0,0:21:17.69,0:21:21.78,Default,,0,0,0,,Осының арқасында көптеген тұтынушылар өз бөлмелерінің орнын бақылай алмайды.
Dialogue: 0,0:21:21.86,0:21:24.61,Default,,0,0,0,,Біз кондукторлар үшін бұл қиын.
Dialogue: 0,0:21:25.95,0:21:28.91,Default,,0,0,0,,Тұтынушы, сізге бірдеңе керек пе?
Dialogue: 0,0:21:28.99,0:21:32.62,Default,,0,0,0,,Есік қоңырауы осылай соғылып, бөлмедегі шам жанған кезде
Dialogue: 0,0:21:32.70,0:21:34.45,Default,,0,0,0,,Кондуктор келе жатыр.
Dialogue: 0,0:21:34.54,0:21:37.46,Default,,0,0,0,,Керемет, мен оны кейінірек көремін.
Dialogue: 0,0:21:37.54,0:21:40.71,Default,,0,0,0,,Оның орнына қазір жоғалып кеткен №7 көлік. Барып тексерейік.
Dialogue: 0,0:21:40.79,0:21:42.42,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:21:46.38,0:21:49.26,Default,,0,0,0,,Ай Чан, суық тиіп ауырып қалдың ба?
Dialogue: 0,0:21:49.34,0:21:52.64,Default,,0,0,0,,Жоқ, жарайды, мен дәрі ішіп жатырмын.
Dialogue: 0,0:21:52.72,0:21:54.39,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:21:57.14,0:22:00.61,Default,,0,0,0,,Бұрынғы адам, мен оған ұқсайтынмын.
Dialogue: 0,0:22:01.61,0:22:04.86,Default,,0,0,0,,Бірақ сол күйік дегеніңіз не?
Dialogue: 0,0:22:06.86,0:22:08.11,Default,,0,0,0,,Не... Көлік 7?
Dialogue: 0,0:22:08.86,0:22:10.66,Default,,0,0,0,,Бұл шынымен №7 көлік пе?
Dialogue: 0,0:22:10.74,0:22:11.62,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:22:12.20,0:22:15.20,Default,,0,0,0,,Сіз білмей тұрып, No7 вагон қайта жанданды.
Dialogue: 0,0:22:15.29,0:22:16.46,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:22:16.54,0:22:19.83,Default,,0,0,0,,Олай болса, тағы да В бөлмесіне барайық.
Dialogue: 0,0:22:19.92,0:22:20.88,Default,,0,0,0,,О
Dialogue: 0,0:22:26.47,0:22:27.30,Default,,0,0,0,,Мен оны ашамын.
Dialogue: 0,0:22:27.38,0:22:28.26,Default,,0,0,0,,О
Dialogue: 0,0:22:30.05,0:22:31.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:32.22,0:22:35.22,Default,,0,0,0,,Білесіз бе, бұл жер шынымен...
Dialogue: 0,0:22:35.31,0:22:37.14,Default,,0,0,0,,Сіз №8 көлік дедіңіз ғой, солай ма?
Dialogue: 0,0:22:37.23,0:22:41.15,Default,,0,0,0,,Мен балаға өз бөлмесіне қайтып, үндемеуді айттым.
Dialogue: 0,0:22:41.23,0:22:43.11,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:22:43.19,0:22:45.86,Default,,0,0,0,,Мүмкін сол кондукторда түсінбеушілік бар шығар.
Dialogue: 0,0:22:45.94,0:22:49.15,Default,,0,0,0,,Мүмкін, мен ұйықтап жатқан сияқтымын.
Dialogue: 0,0:22:49.86,0:22:53.12,Default,,0,0,0,,Тоқта, күте тұр, менің ойымша, бұл бірінші рет...
Dialogue: 0,0:23:00.46,0:23:02.08,Default,,0,0,0,,Ха... міне солай!
Dialogue: 0,0:23:04.09,0:23:05.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:06.00,0:23:07.17,Default,,0,0,0,,Эй, бұл сенсің.
Dialogue: 0,0:23:07.26,0:23:08.84,Default,,0,0,0,,Бұл бөлме
Dialogue: 0,0:23:08.92,0:23:14.85,Default,,0,0,0,,Рас, бұл №7 вагондағы В бөлмесі.
Dialogue: 0,0:23:14.93,0:23:17.02,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:23:17.10,0:23:19.94,Default,,0,0,0,,Соноко-ничан және басқалары да алды, солай ма?
Dialogue: 0,0:23:20.02,0:23:22.52,Default,,0,0,0,,Осыған ұқсас карталар
Dialogue: 0,0:23:22.60,0:23:25.44,Default,,0,0,0,,...және сіз онда жазылған нұсқауларды орындадыңыз, солай ма?
Dialogue: 0,0:23:26.02,0:23:30.36,Default,,0,0,0,,Осы бөлмедегі жәбірленушінің рөлін ойнайтын адаммен бөлмелерді уақытша ауыстырыңыз.
Dialogue: 0,0:23:30.45,0:23:33.70,Default,,0,0,0,,Келген детективтерді адастырыңыз.
Dialogue: 0,0:23:33.78,0:23:35.16,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:23:36.08,0:23:38.50,Default,,0,0,0,,Керемет! Конан-кун күткендей
Dialogue: 0,0:23:38.58,0:23:39.58,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:23:39.66,0:23:42.00,Default,,0,0,0,,Біреу мені құлатты
Dialogue: 0,0:23:42.08,0:23:44.79,Default,,0,0,0,,Есікті ашсам, ішінен конверт түсіп қалыпты.
Dialogue: 0,0:23:44.88,0:23:47.75,Default,,0,0,0,,Ішіндегі карточкада осылай жазылған.
Dialogue: 0,0:23:47.84,0:23:51.59,Default,,0,0,0,,«Құттықтаймыз, сіз сыбайлас ретінде таңдадыңыз».
Dialogue: 0,0:23:51.68,0:23:54.14,Default,,0,0,0,,Қалғаны Конан-кун айтқандай.
Dialogue: 0,0:23:54.22,0:23:55.85,Default,,0,0,0,,№7 вагонның В бөлмесінде
Dialogue: 0,0:23:55.93,0:23:58.22,Default,,0,0,0,,Жәбірленушінің рөлін ойнайтын тұтынушы күтіп тұр.
Dialogue: 0,0:23:58.31,0:24:01.10,Default,,0,0,0,,Кезектесіп, жұмбақ викторинаны одан да қызықты етіңіз.
Dialogue: 0,0:24:01.18,0:24:03.69,Default,,0,0,0,,Сізді болжаған кезде ренжідіңіз бе?
Dialogue: 0,0:24:03.77,0:24:08.53,Default,,0,0,0,,...Содан кейін жәбірленушінің рөлін сомдаған тапсырыс беруші мен Ранкун және басқалары ауыстырылды.
Dialogue: 0,0:24:08.61,0:24:12.45,Default,,0,0,0,,Мен де қасынан өтіп, топқа қосылдым.
Dialogue: 0,0:24:12.53,0:24:15.24,Default,,0,0,0,,Сонымен, жәбірленушінің рөлін ойнаған адам.
Dialogue: 0,0:24:15.32,0:24:17.78,Default,,0,0,0,,Менің ойымша, ол №8 вагонда демалып жатыр.
Dialogue: 0,0:24:17.87,0:24:19.70,Default,,0,0,0,,Сонда Когораның ағасы кім?
Dialogue: 0,0:24:19.79,0:24:24.17,Default,,0,0,0,,Жәбірленушіні ойнап жүрген адам мені асханаға баруымды өтінді.
Dialogue: 0,0:24:24.25,0:24:25.46,Default,,0,0,0,,Асханада?
Dialogue: 0,0:24:26.04,0:24:28.38,Default,,0,0,0,,Соңында, мен бұл дәлелдеу викторинасын түсіндіремін.
Dialogue: 0,0:24:28.46,0:24:30.71,Default,,0,0,0,,Себебі мен сенің детектив рөлін ойнағаныңды қалаймын.
Dialogue: 0,0:24:30.80,0:24:33.13,Default,,0,0,0,,Асхана вагонында күтіңіз.
Dialogue: 0,0:24:33.22,0:24:34.43,Default,,0,0,0,,Иә
Dialogue: 0,0:24:34.51,0:24:37.47,Default,,0,0,0,,Ал, танысқаныма қуаныштымын.
Dialogue: 0,0:24:37.55,0:24:38.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:39.10,0:24:41.18,Default,,0,0,0,,Бұл сенсің, Хайбара.
Dialogue: 0,0:24:41.27,0:24:42.31,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:24:42.89,0:24:45.90,Default,,0,0,0,,Мен сенімен бір рет сөйлескім келді, солай ма?
Dialogue: 0,0:24:47.06,0:24:50.48,Default,,0,0,0,,Бұл... бұл адам...
Dialogue: 0,0:24:51.82,0:24:52.90,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:24:52.99,0:24:53.90,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:24:53.99,0:24:55.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:57.78,0:24:58.91,Default,,0,0,0,,Не?
Dialogue: 0,0:24:58.99,0:25:02.75,Default,,0,0,0,,Мен дәл қазір есіктен біреу қарап тұр деп ойладым.
Dialogue: 0,0:25:02.83,0:25:04.25,Default,,0,0,0,,Бұл тек менің қиялым ба?
Dialogue: 0,0:25:12.59,0:25:17.51,Default,,0,0,0,,Ал, тамақ пен шарап керемет, хахахаха...
Dialogue: 0,0:25:19.85,0:25:20.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:21.81,0:25:23.10,Default,,0,0,0,,Жанып тұр ма?
Dialogue: 0,0:25:39.82,0:25:42.45,Default,,0,0,0,,Денелердің жоғалуының айласын шештің бе?
Dialogue: 0,0:25:42.54,0:25:47.62,Default,,0,0,0,,Ахахаха Бұл жолғы ойлау викторинасы әлі сұралған жоқ.
Dialogue: 0,0:25:47.71,0:25:50.34,Default,,0,0,0,,Бірақ мен осындай карта алдым.
Dialogue: 0,0:25:50.42,0:25:51.92,Default,,0,0,0,,Бізде де солай.
Dialogue: 0,0:25:52.00,0:25:53.21,Default,,0,0,0,,(Ходжинс) Бүгіннен бастап мен Автоматты жазу қуыршағының шәкірті болып жұмыс істеймін.
Dialogue: 0,0:25:53.80,0:25:59.55,Default,,0,0,0,,Хмм... Бұл кәдімгі нұсқау картасына ұқсайды...
Dialogue: 0,0:25:59.64,0:26:03.72,Default,,0,0,0,,Бұл жолы мен естіген қулық бұл емес еді.
Dialogue: 0,0:26:03.81,0:26:06.48,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:26:06.56,0:26:08.77,Default,,0,0,0,,Егер бұл орын алса, №8 вагонға барыңыз.
Dialogue: 0,0:26:08.85,0:26:11.73,Default,,0,0,0,,Мен жәбірленушіні ойнайтын тұтынушыдан сұрауым керек деп ойлаймын.
Dialogue: 0,0:26:11.82,0:26:13.82,Default,,0,0,0,,Оған дейін мен дәретханаға барамын.
Dialogue: 0,0:26:13.90,0:26:15.78,Default,,0,0,0,,Мен де барамын.
Dialogue: 0,0:26:17.07,0:26:17.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:18.49,0:26:20.20,Default,,0,0,0,,Не болды? Хайбара
Dialogue: 0,0:26:20.28,0:26:23.16,Default,,0,0,0,,Бұл пойыз біртүрлі болып көрінбейді ме?
Dialogue: 0,0:26:23.74,0:26:25.58,Default,,0,0,0,,Менің айтайын дегенім, бұл кісі өлтіру...
Dialogue: 0,0:26:25.66,0:26:29.17,Default,,0,0,0,,Сіз Кристидің тым көп романдарын оқыдыңыз.
Dialogue: 0,0:26:29.79,0:26:33.50,Default,,0,0,0,,Оның белгісі бар, бірақ бұл бір-екі адам емес.
Dialogue: 0,0:26:39.68,0:26:42.47,Default,,0,0,0,,Ното мырза, сізге қажет нәрсе бар ма?
Dialogue: 0,0:26:43.14,0:26:45.31,Default,,0,0,0,,Ното мырза Ното мырза
Dialogue: 0,0:26:45.39,0:26:46.43,Default,,0,0,0,,Ах
Dialogue: 0,0:26:46.52,0:26:49.39,Default,,0,0,0,,Не? Мен саған қоңырау шалған жоқпын.
Dialogue: 0,0:26:49.48,0:26:53.19,Default,,0,0,0,,Не? А... бірақ қазір Белл...
Dialogue: 0,0:26:53.27,0:26:55.78,Default,,0,0,0,,Мен мүлде білмеймін
Dialogue: 0,0:26:55.86,0:26:58.53,Default,,0,0,0,,Мен шақырғанда келмесең де, қажетсіз кезде келесің.
Dialogue: 0,0:26:59.20,0:27:00.91,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:27:00.99,0:27:03.20,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:27:03.28,0:27:07.12,Default,,0,0,0,,Көрші үйде біраз қиындық болды, бірақ бұл кондуктор тарапынан түсініспеушілік болған сияқты.
Dialogue: 0,0:27:08.96,0:27:09.79,Default,,0,0,0,,Фу…
Dialogue: 0,0:27:09.87,0:27:12.04,Default,,0,0,0,,Сатору мен жоғары лауазымды тұлғалар арасындағы қақтығыс осыны ұйымдастырды деген сыбыс бар, солай емес пе?
Dialogue: 0,0:27:18.67,0:27:19.80,Default,,0,0,0,,Деха мырза
Dialogue: 0,0:27:20.51,0:27:22.89,Default,,0,0,0,,Сәлем! Бұл туралы бірдеңе істей аласыз ба?
Dialogue: 0,0:27:22.97,0:27:24.80,Default,,0,0,0,,Қалай... әйтеуір...
Dialogue: 0,0:27:24.89,0:27:28.89,Default,,0,0,0,,Дыбыс, дыбыс Бөлмеде біртүрлі дыбыс естіледі!
Dialogue: 0,0:27:28.98,0:27:30.19,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:27:30.98,0:27:33.90,Default,,0,0,0,,Мен... Мен ештеңе естімеймін.
Dialogue: 0,0:27:33.98,0:27:35.86,Default,,0,0,0,,Мен мұны бұрын істеп жүргенмін.
Dialogue: 0,0:27:35.94,0:27:38.44,Default,,0,0,0,,Сіз мені өтірік айтып жатыр деп ойлайсыз, солай ма?
Dialogue: 0,0:27:38.53,0:27:40.74,Default,,0,0,0,,Жоқ, бұл шектен шыққан.
Dialogue: 0,0:27:42.36,0:27:43.41,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:27:43.49,0:27:45.83,Default,,0,0,0,,Қараңызшы, сіз бұл дыбысты естисіз.
Dialogue: 0,0:27:45.91,0:27:51.50,Default,,0,0,0,,Иә, менің ойымша, бұл біреудің ұмытып кеткен ұялы телефоны немесе басқалары шығар.
Dialogue: 0,0:27:51.58,0:27:54.50,Default,,0,0,0,,Бір сәт кірме, өзім іздеймін.
Dialogue: 0,0:27:54.58,0:27:56.29,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:27:56.38,0:27:57.92,Default,,0,0,0,,Одан гөрі менің айтқым келгені
Dialogue: 0,0:27:58.00,0:28:02.01,Default,,0,0,0,,Неге кеткенше сол ұялы телефонды таппадың?
Dialogue: 0,0:28:02.09,0:28:04.26,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:28:04.34,0:28:07.64,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:28:07.72,0:28:09.89,Default,,0,0,0,,Міне, бұл біздің бөлме.
Dialogue: 0,0:28:10.68,0:28:14.81,Default,,0,0,0,,Әй, аға, мен айла тауып алдым.
Dialogue: 0,0:28:14.90,0:28:17.36,Default,,0,0,0,,Шығып, түсіндіріңіз.
Dialogue: 0,0:28:17.94,0:28:22.03,Default,,0,0,0,,...Оның біздің бөлмеде ұйықтап жатқанына сене алар емеспін.
Dialogue: 0,0:28:22.70,0:28:23.95,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:28:24.95,0:28:28.20,Default,,0,0,0,,Ағай, ұйықтамаңыз, шынжыр құлпын алыңыз!
Dialogue: 0,0:28:28.79,0:28:30.08,Default,,0,0,0,,Әй, аға!
Dialogue: 0,0:28:30.16,0:28:31.29,Default,,0,0,0,,Не болды?
Dialogue: 0,0:28:31.37,0:28:33.42,Default,,0,0,0,,Сіз диванда ұйықтап жатырсыз ба?
Dialogue: 0,0:28:33.50,0:28:37.67,Default,,0,0,0,,Ол өлгендей, самайларынан қан кетіп жатты.
Dialogue: 0,0:28:38.67,0:28:41.63,Default,,0,0,0,,Бұл бәрібір басқа шегерім викторинасының тақырыбы болуы мүмкін.
Dialogue: 0,0:28:41.72,0:28:43.05,Default,,0,0,0,,Сәл артқа шегініңіз.
Dialogue: 0,0:28:46.64,0:28:48.68,Default,,0,0,0,,-Түтіннің иісі... -(Сера)
Dialogue: 0,0:28:48.76,0:28:49.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:49.85,0:28:52.06,Default,,0,0,0,,Бәрібір есікті сындырайық
Dialogue: 0,0:28:52.14,0:28:54.85,Default,,0,0,0,,Иссей мұрын!
Dialogue: 0,0:29:02.53,0:29:04.24,Default,,0,0,0,,Керемет!
Dialogue: 0,0:29:04.32,0:29:06.66,Default,,0,0,0,,Басқа шегерімге арналған тест?
Dialogue: 0,0:29:06.74,0:29:09.83,Default,,0,0,0,,Жоқ, ол шынымен өлді.
Dialogue: 0,0:29:09.91,0:29:11.12,Default,,0,0,0,,Не!
Dialogue: 0,0:29:16.33,0:29:17.71,Default,,0,0,0,,Ал бұл...
Dialogue: 0,0:29:19.50,0:29:21.38,Default,,0,0,0,,Бұл жабық бөлмедегі кісі өлтіру.
Dialogue: 0,0:29:23.34,0:29:25.09,Default,,0,0,0,,Ал... кісі өлтіру?
Dialogue: 0,0:29:25.18,0:29:28.18,Default,,0,0,0,,Бұл шынымен де кісі өлтіру ісі ме?
Dialogue: 0,0:29:28.26,0:29:32.85,Default,,0,0,0,,Иә, біреу бұл жігітті ғибадатханада тапаншамен атып тастады.
Dialogue: 0,0:29:32.93,0:29:36.27,Default,,0,0,0,,Бірақ... бұл бөлмеде шынжырлы құлып болды.
Dialogue: 0,0:29:36.35,0:29:38.52,Default,,0,0,0,,Сіз шынжырды күшпен үзіп, кірдіңіз.
Dialogue: 0,0:29:39.11,0:29:41.11,Default,,0,0,0,,Сонда бұл суицид емес пе?
Dialogue: 0,0:29:41.19,0:29:44.49,Default,,0,0,0,,Оны құлыптау әдісі әлі жұмбақ.
Dialogue: 0,0:29:44.99,0:29:48.20,Default,,0,0,0,,Ғибадатханадағы оқ жарақатының айналасында күйік іздері жоқ.
Dialogue: 0,0:29:48.28,0:29:50.45,Default,,0,0,0,,Оның алыстан оқ атылғанының дәлелі.
Dialogue: 0,0:29:51.28,0:29:53.62,Default,,0,0,0,,Мылтықпен басына оқ ату
Dialogue: 0,0:29:53.70,0:29:56.46,Default,,0,0,0,,Сіз мұрынды басыңызға жақын ұстауыңыз керек.
Dialogue: 0,0:29:56.54,0:30:02.13,Default,,0,0,0,,Бірақ егер сіз түсіру алдында қорқып, абайсызда жіберіп алсаңыз ше?
Dialogue: 0,0:30:02.21,0:30:04.17,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:30:04.26,0:30:06.67,Default,,0,0,0,,Пистолеттің ұшында дыбыс өшіргіш бар, солай ма?
Dialogue: 0,0:30:06.76,0:30:08.30,Default,,0,0,0,,Бұл ұзақ нәрсе
Dialogue: 0,0:30:08.38,0:30:11.43,Default,,0,0,0,,Басынан оқ ату мүмкін емес пе?
Dialogue: 0,0:30:12.60,0:30:14.85,Default,,0,0,0,,Қараңдаршы, диванда.
Dialogue: 0,0:30:14.93,0:30:16.94,Default,,0,0,0,,Қол мылтығымен атылғанға ұқсайтын іздер бар.
Dialogue: 0,0:30:17.02,0:30:17.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:17.94,0:30:22.32,Default,,0,0,0,,Жәбірленушінің қолында немесе манжетінде оқ қалдықтары болуы мүмкін.
Dialogue: 0,0:30:22.40,0:30:25.90,Default,,0,0,0,,Мәйітті өзін-өзі өлтіру сияқты етіп көрсету үшін мылтық ұстау
Dialogue: 0,0:30:25.99,0:30:27.45,Default,,0,0,0,,Мен қосымша бір оқ аттым.
Dialogue: 0,0:30:27.53,0:30:31.16,Default,,0,0,0,,Әрине, оқ қалдықтары қылмыскерде де болады.
Dialogue: 0,0:30:31.24,0:30:33.03,Default,,0,0,0,,Оны қолды жуу арқылы оңай алып тастауға болады.
Dialogue: 0,0:30:33.12,0:30:36.04,Default,,0,0,0,,Киіміңді бөлмеңнің терезесінен лақтырып жіберген болуың керек.
Dialogue: 0,0:30:36.54,0:30:41.33,Default,,0,0,0,,Бірақ, кінәлі әлі де осы пойызда екені сөзсіз.
Dialogue: 0,0:30:41.42,0:30:42.88,Default,,0,0,0,,Мен сені жібермеймін
Dialogue: 0,0:30:45.51,0:30:46.34,Default,,0,0,0,,Әзірге
Dialogue: 0,0:30:46.42,0:30:49.18,Default,,0,0,0,,Балалар, Ранни Чан және басқаларымен бөлмелеріңе қайтыңдар.
Dialogue: 0,0:30:49.26,0:30:50.80,Default,,0,0,0,,- (Гента) Иә? -(Мицухико) Иә?
Dialogue: 0,0:30:50.89,0:30:52.97,Default,,0,0,0,,Біз де сізге көмектесеміз.
Dialogue: 0,0:30:53.05,0:30:55.39,Default,,0,0,0,,- (Аюми) Аюми де - Керек емес істермен айналыспа!
Dialogue: 0,0:30:55.47,0:30:57.93,Default,,0,0,0,,Мен қайтып келгенше бөлмеңді құлыпта.
Dialogue: 0,0:30:58.02,0:31:00.40,Default,,0,0,0,,Кім қонаққа келсе де, ашпа.
Dialogue: 0,0:31:01.10,0:31:03.11,Default,,0,0,0,,Не, кенеттен?
Dialogue: 0,0:31:03.19,0:31:04.94,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:31:05.02,0:31:07.69,Default,,0,0,0,,Не? А, сондықтан
Dialogue: 0,0:31:07.78,0:31:10.74,Default,,0,0,0,,Кісі өлтіруші әлі кезіп жүр, сондықтан қауіпті.
Dialogue: 0,0:31:10.82,0:31:13.91,Default,,0,0,0,,Олай болса, балаларға қамқор бол.
Dialogue: 0,0:31:13.99,0:31:15.24,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:31:15.33,0:31:18.45,Default,,0,0,0,,Әйтеуір әкеңе телефон соғып, келуін өтінемін.
Dialogue: 0,0:31:18.54,0:31:22.00,Default,,0,0,0,,Бұл не? Бұл дүрбелең
Dialogue: 0,0:31:22.08,0:31:25.25,Default,,0,0,0,,Кез келген жағдайда, бұл шегерімге арналған викторина басталды ма?
Dialogue: 0,0:31:25.84,0:31:29.67,Default,,0,0,0,,Жоқ, бұл викторина емес, нағыз кісі өлтіру болғандай болды...
Dialogue: 0,0:31:29.76,0:31:30.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:30.68,0:31:32.18,Default,,0,0,0,,Бұл өмірде кісі өлтіру ме?
Dialogue: 0,0:31:32.26,0:31:33.68,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:31:33.76,0:31:36.93,Default,,0,0,0,,Менде нағыз зат жоқ, қанның иісі бар.
Dialogue: 0,0:31:37.02,0:31:40.52,Default,,0,0,0,,Қалай болғанда да, кондуктор мырза, осы пойызды дереу тоқтатыңыз.
Dialogue: 0,0:31:40.60,0:31:43.44,Default,,0,0,0,,Қонақтарға полиция келгенше бөлмеден шықпауын айтыңыз.
Dialogue: 0,0:31:43.52,0:31:44.36,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:31:45.73,0:31:47.69,Default,,0,0,0,,Біз сізге хабарласамыз
Dialogue: 0,0:31:47.78,0:31:50.65,Default,,0,0,0,,Бұрын көлікте апат болған.
Dialogue: 0,0:31:50.74,0:31:52.41,Default,,0,0,0,,Бұл пойыз кестесін өзгертті.
Dialogue: 0,0:31:52.49,0:31:55.70,Default,,0,0,0,,Біз жақын маңдағы станцияға тоқтауды қарастырамыз.
Dialogue: 0,0:31:55.78,0:31:58.37,Default,,0,0,0,,Тұтынушыларымызға келтірген қолайсыздықтар үшін кешірім сұраймыз.
Dialogue: 0,0:31:58.45,0:32:01.83,Default,,0,0,0,,Нұсқау берілгенше бөлмеңізде күтіңіз.
Dialogue: 0,0:32:01.92,0:32:03.67,Default,,0,0,0,,Мүмкіндігінше көшеге шықпауға тырысыңыз...
Dialogue: 0,0:32:03.75,0:32:07.38,Default,,0,0,0,,Бұл жағымсыз сезім содан бері жалғасып келеді.
Dialogue: 0,0:32:08.13,0:32:10.88,Default,,0,0,0,,Ал оның бұрынғы көзқарасы...
Dialogue: 0,0:32:11.67,0:32:13.51,Default,,0,0,0,,Не деген...
Dialogue: 0,0:32:13.59,0:32:14.43,Default,,0,0,0,,Ha
Dialogue: 0,0:32:26.69,0:32:27.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:27.90,0:32:31.03,Default,,0,0,0,,Сіз де бортта болдыңыз, Амуро-сан.
Dialogue: 0,0:32:31.11,0:32:33.82,Default,,0,0,0,,Иә, билет алу бақытына ие болдым.
Dialogue: 0,0:32:34.41,0:32:38.20,Default,,0,0,0,,Мен жаңа ғана Мори мырзаны асханада кездестірдім.
Dialogue: 0,0:32:40.24,0:32:43.12,Default,,0,0,0,,Эй Ран, мына әдемі жігіт кім?
Dialogue: 0,0:32:43.21,0:32:46.88,Default,,0,0,0,,Мен айтқан детектив әкеңнің шәкірті болғысы келеді.
Dialogue: 0,0:32:46.96,0:32:49.30,Default,,0,0,0,,Әй, бұл адам
Dialogue: 0,0:32:49.38,0:32:52.01,Default,,0,0,0,,Сәлеметсіз бе, бұл Соноко Сузуки.
Dialogue: 0,0:32:52.09,0:32:53.13,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:32:53.22,0:32:56.14,Default,,0,0,0,,Көліктің ішінде апат болған сияқты.
Dialogue: 0,0:32:56.22,0:32:57.26,Default,,0,0,0,,Сіз бірдеңе тыңдап жатырсыз ба?
Dialogue: 0,0:32:57.85,0:33:00.31,Default,,0,0,0,,Бұл кісі өлтіру ісі сияқты.
Dialogue: 0,0:33:00.39,0:33:03.94,Default,,0,0,0,,Дәл қазір Сера-сан мен Конан-кун оқиға орнында қалды.
Dialogue: 0,0:33:04.02,0:33:08.86,Default,,0,0,0,,Олай болса, оны доктор Мориге қалдырған дұрыс деп ойлаймын.
Dialogue: 0,0:33:09.48,0:33:13.15,Default,,0,0,0,,Аспан біз жақта сияқты.
Dialogue: 0,0:33:17.41,0:33:20.16,Default,,0,0,0,,Не! Нагояға дейін тоқтамаса ше?
Dialogue: 0,0:33:20.24,0:33:22.75,Default,,0,0,0,,Мен сізге жақын жердегі станцияға тоқтаңыз дедім.
Dialogue: 0,0:33:22.83,0:33:24.00,Default,,0,0,0,,Міне... болды.
Dialogue: 0,0:33:24.08,0:33:28.54,Default,,0,0,0,,Осы пойыздың иесі, кеңесші Джирокичи Сузуки бір дауыспен айтты...
Dialogue: 0,0:33:28.63,0:33:32.17,Default,,0,0,0,,Менің пойызымда біреуді өлтірген құжатсыз адам
Dialogue: 0,0:33:32.26,0:33:34.30,Default,,0,0,0,,Менің алдымда арқан байлаңыз!
Dialogue: 0,0:33:34.38,0:33:37.09,Default,,0,0,0,,...Олар мені Нагояда күтіп отырғандарын айтты.
Dialogue: 0,0:33:37.18,0:33:39.85,Default,,0,0,0,,Бұл қарт қаншалықты күшті?
Dialogue: 0,0:33:39.93,0:33:42.47,Default,,0,0,0,,Ал, уайымдама!
Dialogue: 0,0:33:42.56,0:33:47.35,Default,,0,0,0,,Нагоя вокзалына келмес бұрын мен, ұлы детектив Поиро Моури,
Dialogue: 0,0:33:47.98,0:33:51.32,Default,,0,0,0,,Bell Tree Express кісі өлтіру ісінің артындағы шындық
Dialogue: 0,0:33:51.40,0:33:54.07,Default,,0,0,0,,Ендеше, оны қарап шығып, қарап көрейік.
Dialogue: 0,0:33:54.15,0:33:56.45,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:33:56.53,0:33:58.28,Default,,0,0,0,,На~хахахахаха
Dialogue: 0,0:33:58.91,0:34:00.53,Default,,0,0,0,,Сонымен, дирижер?
Dialogue: 0,0:34:00.62,0:34:03.91,Default,,0,0,0,,Сіз жәбірленушіні соңғы рет қашан көрдіңіз, Мурохаши мырза?
Dialogue: 0,0:34:04.00,0:34:07.29,Default,,0,0,0,,Сол кезде мен Ното мырзаның А бөлмесінің алдында болдым.
Dialogue: 0,0:34:07.87,0:34:10.71,Default,,0,0,0,,Есік қоңырауы соғылды, мен А бөлмесіне бардым да...
Dialogue: 0,0:34:12.00,0:34:15.72,Default,,0,0,0,,Ното мырза: «Мен сені шақырған жоқпын» деп ұрысқанда.
Dialogue: 0,0:34:15.80,0:34:18.30,Default,,0,0,0,,Келесі В бөлмесінің есігін ашыңыз.
Dialogue: 0,0:34:18.38,0:34:21.39,Default,,0,0,0,,Мурохаши мырза маған жалт қарады...
Dialogue: 0,0:34:21.47,0:34:24.31,Default,,0,0,0,,Бұл шынымен де Мурохаши мырза болды ма?
Dialogue: 0,0:34:24.39,0:34:27.69,Default,,0,0,0,,А... А, мен біреумен телефонда сөйлескен сияқтымын.
Dialogue: 0,0:34:28.31,0:34:33.07,Default,,0,0,0,,Ендеше, алдымен Ното мырзаның әңгімесін тыңдайық, Пойро-сан.
Dialogue: 0,0:34:33.73,0:34:35.49,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:34:38.82,0:34:40.62,Default,,0,0,0,,А, мен де солай.
Dialogue: 0,0:34:40.70,0:34:43.33,Default,,0,0,0,,Мен есіктен Мурохаши мырзаның даусын естідім.
Dialogue: 0,0:34:43.41,0:34:48.12,Default,,0,0,0,,Мен оны келесі бөлмеде болады деп күтпегендіктен таң қалдым.
Dialogue: 0,0:34:48.21,0:34:51.13,Default,,0,0,0,,Бірақ сен неге есік қоңырауын басты?
Dialogue: 0,0:34:51.21,0:34:52.67,Default,,0,0,0,,Маған қоңырау шалмадың деп өтірік айт
Dialogue: 0,0:34:52.75,0:34:54.96,Default,,0,0,0,,Сондықтан мен сені шақырмадым.
Dialogue: 0,0:34:55.05,0:34:56.71,Default,,0,0,0,,Кондуктор рұқсатсыз келді.
Dialogue: 0,0:34:56.80,0:35:01.51,Default,,0,0,0,,Бірақ егер сіз қоңырауды бассаңыз, есік үстіндегі шам жанады.
Dialogue: 0,0:35:01.59,0:35:03.43,Default,,0,0,0,,Сіз қателесе алмайсыз деп ойлаймын.
Dialogue: 0,0:35:03.51,0:35:07.73,Default,,0,0,0,,Шын мәнінде, А бөлмесіндегі жалғыз шам сөнген.
Dialogue: 0,0:35:07.81,0:35:09.98,Default,,0,0,0,,Сондықтан есік қоңырауы соғылады.
Dialogue: 0,0:35:10.06,0:35:12.73,Default,,0,0,0,,Бірде-бір бөлмеде шам жанған жоқ.
Dialogue: 0,0:35:12.81,0:35:15.98,Default,,0,0,0,,Мен бұл жерді Ното мырзаның бөлмесі деп ойлап, есікті қағамын.
Dialogue: 0,0:35:16.07,0:35:18.28,Default,,0,0,0,,...және одан кейін не болады?
Dialogue: 0,0:35:18.36,0:35:21.24,Default,,0,0,0,,А және В бөлмелерінің есіктері жабылғаннан кейін бірден.
Dialogue: 0,0:35:21.32,0:35:22.82,Default,,0,0,0,,Есік қоңырауы соғылады
Dialogue: 0,0:35:22.91,0:35:25.66,Default,,0,0,0,,Изами-саманың Е бөлмесіндегі шам жанып тұрды.
Dialogue: 0,0:35:25.74,0:35:27.08,Default,,0,0,0,,Мен сонда бардым, бірақ...
Dialogue: 0,0:35:29.00,0:35:33.00,Default,,0,0,0,,Иә, мен есік қоңырауындағы кондукторды шақырдым.
Dialogue: 0,0:35:33.08,0:35:35.46,Default,,0,0,0,,Менің бөлмемде біртүрлі шу естілді.
Dialogue: 0,0:35:35.55,0:35:38.88,Default,,0,0,0,,Дыбыстың себебі - осы сағаттағы дабыл.
Dialogue: 0,0:35:38.97,0:35:41.93,Default,,0,0,0,,Мен оны дивандар арасындағы саңылауда тұрып көрдім.
Dialogue: 0,0:35:42.01,0:35:45.35,Default,,0,0,0,,Оны тазалаушы немесе біреу қалдырған болуы керек.
Dialogue: 0,0:35:45.43,0:35:47.14,Default,,0,0,0,,Қ-қараңыз… ол…
Dialogue: 0,0:35:47.22,0:35:50.69,Default,,0,0,0,,Егер сіз кондукторды бөлмені тексеруге шақырсаңыз.
Dialogue: 0,0:35:50.77,0:35:54.65,Default,,0,0,0,,Қылмыскер жәбірленушінің бөлмесіне дәл сол уақытта кірген болуы мүмкін.
Dialogue: 0,0:35:54.73,0:35:57.61,Default,,0,0,0,,Дәлізді бақылайтын кондуктор жоқ болады.
Dialogue: 0,0:35:57.69,0:36:01.15,Default,,0,0,0,,Тергеу... Мен сізді шағымдануға шақырдым.
Dialogue: 0,0:36:01.24,0:36:03.66,Default,,0,0,0,,Мен мұны жаңа ғана таптым.
Dialogue: 0,0:36:03.74,0:36:07.91,Default,,0,0,0,,Менің аумағыма басқалардың басып кіруіне шыдай алмаймын.
Dialogue: 0,0:36:07.99,0:36:12.17,Default,,0,0,0,,Сонда кондуктор барлық уақытта дәлізде болды.
Dialogue: 0,0:36:12.25,0:36:16.17,Default,,0,0,0,,Сіз жәбірленушінің В бөлмесіне күдікті адамдарды кіргенін көрмедіңіз бе?
Dialogue: 0,0:36:16.25,0:36:17.67,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:36:18.25,0:36:22.76,Default,,0,0,0,,Мен Деба мырзаның шағымын тыңдап отырғанымда, ең алыс есік ашық екенін көрдім.
Dialogue: 0,0:36:22.84,0:36:26.93,Default,,0,0,0,,Есіктен біреу маған қарап тұрғандай болды...
Dialogue: 0,0:36:27.56,0:36:31.06,Default,,0,0,0,,Күрсін... Ең алысы болса, А бөлмесі.
Dialogue: 0,0:36:31.14,0:36:33.39,Default,,0,0,0,,Мен сол күдікті адамды көрмей тұрып
Dialogue: 0,0:36:34.40,0:36:36.52,Default,,0,0,0,,Комино-сама Д бөлмесінен шықты.
Dialogue: 0,0:36:36.61,0:36:40.74,Default,,0,0,0,,Қызметші арбамды сол жаққа қарай итеріп жіберді.
Dialogue: 0,0:36:40.82,0:36:43.20,Default,,0,0,0,,Бұл екеуі қарап отырған шығар...
Dialogue: 0,0:36:43.28,0:36:45.70,Default,,0,0,0,,Сәлем Комино-сан
Dialogue: 0,0:36:46.78,0:36:48.20,Default,,0,0,0,,А бөлмесінің есігі?
Dialogue: 0,0:36:48.83,0:36:53.21,Default,,0,0,0,,Біз өткенде бұл есік ашық емес еді.
Dialogue: 0,0:36:53.29,0:36:56.42,Default,,0,0,0,,Әрине, ол есік алдында...
Dialogue: 0,0:36:56.50,0:36:59.13,Default,,0,0,0,,Мен күдікті ешкімді көрмедім.
Dialogue: 0,0:36:59.21,0:37:01.13,Default,,0,0,0,,, солай ма? Сумитомо мырза
Dialogue: 0,0:37:01.21,0:37:02.21,Default,,0,0,0,,Иә, ханым
Dialogue: 0,0:37:02.84,0:37:06.47,Default,,0,0,0,,Ашық болды, мен лорд Изумидің айқайлаған дауысын естідім.
Dialogue: 0,0:37:06.55,0:37:08.85,Default,,0,0,0,,Бұл жай ғана Е бөлмесінің есігі.
Dialogue: 0,0:37:08.93,0:37:10.01,Default,,0,0,0,,Хмм…
Dialogue: 0,0:37:10.10,0:37:13.48,Default,,0,0,0,,Сосын Комино-сама өткен соң ашылған шығар.
Dialogue: 0,0:37:13.56,0:37:17.15,Default,,0,0,0,,Бірақ біз В бөлмесіне бара жатырмыз.
Dialogue: 0,0:37:17.23,0:37:21.78,Default,,0,0,0,,№8 вагонға кіру үшін есік алдындағы кемпірлердің жанынан өттім.
Dialogue: 0,0:37:21.86,0:37:25.24,Default,,0,0,0,,А бөлмесінің есігін ешқайсысы ашық көрмедік.
Dialogue: 0,0:37:25.32,0:37:27.32,Default,,0,0,0,,Ол шынымен ашық болды ма?
Dialogue: 0,0:37:27.41,0:37:31.08,Default,,0,0,0,,Аа, солай... Енді ойлап отырсам, жігіттер келер алдында...
Dialogue: 0,0:37:31.16,0:37:34.00,Default,,0,0,0,,Мені тексеруге С бөлмесінен Андо мырза келді.
Dialogue: 0,0:37:34.08,0:37:36.00,Default,,0,0,0,,Қазірге дейінгі тәжірибелердің нәтижелеріне сүйене отырып,
Dialogue: 0,0:37:37.88,0:37:40.21,Default,,0,0,0,,Әй, Иземи мырзаның айқайы.
Dialogue: 0,0:37:40.29,0:37:42.55,Default,,0,0,0,,Бұл менің бөлмеме дейін жаңғырық болды.
Dialogue: 0,0:37:42.63,0:37:45.34,Default,,0,0,0,,Мен бөлмеден шығып, не болып жатқанын көру үшін бардым.
Dialogue: 0,0:37:45.42,0:37:46.88,Default,,0,0,0,,Мен не болып жатыр деп ойладым.
Dialogue: 0,0:37:47.47,0:37:48.64,Default,,0,0,0,,Бірақ содан кейін
Dialogue: 0,0:37:48.72,0:37:52.47,Default,,0,0,0,,А бөлмесінің есігі ашық па, жоқ па білмейміз.
Dialogue: 0,0:37:52.56,0:37:54.52,Default,,0,0,0,,Өйткені ол Е бөлмесіне қарама-қарсы бағытта.
Dialogue: 0,0:37:55.10,0:37:58.23,Default,,0,0,0,,Оның үстіне бұл уақытта пойыз туннельге кіріп жатқан.
Dialogue: 0,0:37:58.31,0:38:02.32,Default,,0,0,0,,Терезеден жарық түспегендіктен, дәліз қараңғы болды.
Dialogue: 0,0:38:02.40,0:38:04.19,Default,,0,0,0,,Ойланып қарасаңыз, дұрыс.
Dialogue: 0,0:38:04.90,0:38:07.03,Default,,0,0,0,,Балалар, көрмедіңдер ме?
Dialogue: 0,0:38:07.11,0:38:10.03,Default,,0,0,0,,Сіз мен бөлмеден шыққан соң келдіңіз.
Dialogue: 0,0:38:10.12,0:38:11.70,Default,,0,0,0,,Жоқ, мен көрген жоқпын.
Dialogue: 0,0:38:12.58,0:38:15.79,Default,,0,0,0,,Айтпақшы, №8 вагондағы жолаушылар
Dialogue: 0,0:38:15.87,0:38:19.29,Default,,0,0,0,,Бір-бірінің атын, бөлмелерін біртүрлі білетін сияқты.
Dialogue: 0,0:38:19.38,0:38:20.50,Default,,0,0,0,,Сіз таныссыз ба?
Dialogue: 0,0:38:20.58,0:38:22.38,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:38:22.46,0:38:25.51,Default,,0,0,0,,Мен жыл сайын осы жұмбақ пойызға қосыламын.
Dialogue: 0,0:38:25.59,0:38:26.97,Default,,0,0,0,,Бұл адамдар
Dialogue: 0,0:38:27.05,0:38:30.97,Default,,0,0,0,,Мен жыл сайын бірінші класты автокөлікке тапсырыс беретін тұрақты тұтынушымын.
Dialogue: 0,0:38:31.05,0:38:33.97,Default,,0,0,0,,Оның үстіне барлығы бір бөлмеде тұрады.
Dialogue: 0,0:38:34.06,0:38:35.31,Default,,0,0,0,,Хо
Dialogue: 0,0:38:38.56,0:38:39.69,Default,,0,0,0,,…Бұл дегеніміз
Dialogue: 0,0:38:39.77,0:38:43.65,Default,,0,0,0,,Кондуктор мырза, бұл сіздің тарапыңыздан түсінбеушілік болды.
Dialogue: 0,0:38:43.73,0:38:47.45,Default,,0,0,0,,Жоқ... Мен оны міндетті түрде көрдім деп ойлаймын.
Dialogue: 0,0:38:47.53,0:38:49.82,Default,,0,0,0,,Иә, түсіндім!
Dialogue: 0,0:38:49.91,0:38:51.12,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:38:51.20,0:38:53.28,Default,,0,0,0,,Кінәлінің В бөлмесіне жасырын кіруіне кім жол берді?
Dialogue: 0,0:38:53.37,0:38:54.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:38:54.29,0:38:56.54,Default,,0,0,0,,Сіз бұл жабық бөлмеде болды дейсіз.
Dialogue: 0,0:38:56.62,0:39:00.79,Default,,0,0,0,,Шынымен көрші бөлмеге апаратын жасырын есік бар емес пе?
Dialogue: 0,0:39:00.88,0:39:03.71,Default,,0,0,0,,Мынау... бұл пойыздың ондай есігі жоқ.
Dialogue: 0,0:39:03.79,0:39:08.72,Default,,0,0,0,,Содан кейін А, С және Е бөлмелеріндегі қонақтарды В бөлмесіне жинаңыз.
Dialogue: 0,0:39:08.80,0:39:12.60,Default,,0,0,0,,Олар әрбір жәбірленушінің денесіне бір оқ атты.
Dialogue: 0,0:39:12.68,0:39:13.89,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:39:13.97,0:39:15.35,Default,,0,0,0,,Не туралы айтып тұрсың...
Dialogue: 0,0:39:15.43,0:39:17.81,Default,,0,0,0,,Менің оқиғам осылай өрбиді.
Dialogue: 0,0:39:17.89,0:39:19.27,Default,,0,0,0,,Соған қарамастан, бұл түтін неге осынша көп?
Dialogue: 0,0:39:19.35,0:39:22.69,Default,,0,0,0,,«Шығыс экспрессінің» сюжеті осындай.
Dialogue: 0,0:39:23.23,0:39:26.40,Default,,0,0,0,,Жәбірленуші тек бір рет оқ тиген...
Dialogue: 0,0:39:27.65,0:39:31.16,Default,,0,0,0,,Сіз оны Мори детектив агенттігіне жібердіңіз бе?
Dialogue: 0,0:39:31.24,0:39:34.16,Default,,0,0,0,,Өткен аптадағы кемпинг сапарынан бейне бар ма?
Dialogue: 0,0:39:34.24,0:39:35.28,Default,,0,0,0,,Иә
Dialogue: 0,0:39:35.37,0:39:39.46,Default,,0,0,0,,Маған көмектескен әйелге лайықты алғыс айтқым келді.
Dialogue: 0,0:39:39.54,0:39:42.83,Default,,0,0,0,,Мен керемет детектив кез келген жерде біреуді тексере ала ма деп ойладым.
Dialogue: 0,0:39:42.92,0:39:44.09,Default,,0,0,0,,Иә...
Dialogue: 0,0:39:44.17,0:39:47.00,Default,,0,0,0,,Мен де, әкем де сол фильмді көрдік.
Dialogue: 0,0:39:47.09,0:39:49.63,Default,,0,0,0,,Бұл сіздің бетіңіз бен дауысыңызбен мүмкін емес
Dialogue: 0,0:39:49.72,0:39:50.80,Default,,0,0,0,,Интернетке салсаңыз
Dialogue: 0,0:39:50.88,0:39:53.01,Default,,0,0,0,,Сіз біреуді білуіңіз мүмкін дедіңіз.
Dialogue: 0,0:39:53.09,0:39:54.97,Default,,0,0,0,,Бұл әйел кім?
Dialogue: 0,0:39:55.05,0:39:57.43,Default,,0,0,0,,Өйткені мен жұмбақ пойыздың өту сақинасын ойнадым.
Dialogue: 0,0:39:57.52,0:40:00.02,Default,,0,0,0,,Біз сенімен осы жерде кездесерміз деп сөйлескен едік.
Dialogue: 0,0:40:00.10,0:40:02.35,Default,,0,0,0,,Мен оны әлі көрген жоқпын.
Dialogue: 0,0:40:03.69,0:40:04.52,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:40:05.73,0:40:08.53,Default,,0,0,0,,Менің кеудемдегі бұл сыбдырдың себебі неде?
Dialogue: 0,0:40:08.61,0:40:10.49,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:40:10.57,0:40:11.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:15.74,0:40:18.79,Default,,0,0,0,,Мен сені сағындым, Шерри.
Dialogue: 0,0:40:25.25,0:40:27.09,Default,,0,0,0,,Оны сізге жіберейін бе?
Dialogue: 0,0:40:28.09,0:40:31.84,Default,,0,0,0,,Әпкеге мен бірінші өлуге рұқсат етемін
Dialogue: 0,0:40:34.68,0:40:39.14,Default,,0,0,0,,Жоқ... болмайды олар...
Dialogue: 0,0:40:40.60,0:40:42.39,Default,,0,0,0,,Жарайсыңдар, адамдар.
Dialogue: 0,0:40:42.48,0:40:45.48,Default,,0,0,0,,Пойыз келе салысымен пойызға кіріңіз
Dialogue: 0,0:40:45.56,0:40:48.23,Default,,0,0,0,,Қанішерді найзағайдай байладым.
Dialogue: 0,0:40:48.32,0:40:50.99,Default,,0,0,0,,Менің көз алдымда түзет!
Dialogue: 0,0:40:51.07,0:40:53.11,Default,,0,0,0,,Сіз қандай жауап бердіңіз? Сіздің жауабыңыз қандай болды?
Dialogue: 0,0:40:53.20,0:40:56.24,Default,,0,0,0,,Арзан өлтіру болған сияқты.
Dialogue: 0,0:40:56.32,0:40:59.83,Default,,0,0,0,,Сәттілік осы жаққа қарай бет алған сияқты, аға.
Dialogue: 0,0:40:59.91,0:41:03.04,Default,,0,0,0,,Әй, әлгі темір жылан тоқтаусыз.
Dialogue: 0,0:41:03.12,0:41:06.13,Default,,0,0,0,,Олар оны бізге әкеледі.
Dialogue: 0,0:41:06.71,0:41:10.09,Default,,0,0,0,,Мен Вермуттан жаңалық алдым.
Dialogue: 0,0:41:10.17,0:41:13.13,Default,,0,0,0,,«Шелли пойызда расталды».
Dialogue: 0,0:41:13.22,0:41:17.14,Default,,0,0,0,,Енді вермут пен бурбон ол әйелді өлтіреді...
Dialogue: 0,0:41:17.22,0:41:21.39,Default,,0,0,0,,Хмф, олар әлгі әйелді өлтіреді ме, ұстай ма, маған бәрібір.
Dialogue: 0,0:41:21.47,0:41:25.90,Default,,0,0,0,,Мәселе мынада, әлгі әйел жыланның ішінде ме?
Dialogue: 0,0:41:25.98,0:41:29.15,Default,,0,0,0,,Егер сені жылан жұтып жатса, Шери
Dialogue: 0,0:41:29.23,0:41:32.40,Default,,0,0,0,,Бұл Нагоя сіздің соңғы аялдамаңыз.
Dialogue: 0,0:41:35.07,0:41:36.86,Default,,0,0,0,,Қалай болғанда да.
Dialogue: 0,0:41:37.70,0:41:41.58,Default,,0,0,0,,Марқұм Мурохашидің В бөлмесі шынжырмен бекітілді.
Dialogue: 0,0:41:41.66,0:41:44.96,Default,,0,0,0,,Оқиға болған кезде, бұл кондуктор үнемі дәлізде болатын
Dialogue: 0,0:41:45.04,0:41:48.75,Default,,0,0,0,,Б бөлмесіне кіріп-шығатын күдікті адамды ешкім көрмесе.
Dialogue: 0,0:41:49.34,0:41:52.42,Default,,0,0,0,,Мурохаши мырза тапаншамен өзін-өзі өлтірді деген шешім қабылданған жоқ па?
Dialogue: 0,0:41:52.51,0:41:56.68,Default,,0,0,0,,Бірақ ғибадатханадағы оқ жарақатының айналасында ешқандай күйік іздері болған жоқ...
Dialogue: 0,0:41:56.76,0:42:01.18,Default,,0,0,0,,Дененің қарсы жағындағы диванда оқтың іздері болды.
Dialogue: 0,0:42:01.76,0:42:05.68,Default,,0,0,0,,Бұл жұмбақ пойыздың барлық жолаушылары жұмбақ жанкүйерлер.
Dialogue: 0,0:42:05.77,0:42:09.23,Default,,0,0,0,,Егер мен бәрібір өлетін болсам, мен оны кісі өлтіру сияқты көрсететін дәлелдерді әдейі қалдырар едім.
Dialogue: 0,0:42:09.31,0:42:11.82,Default,,0,0,0,,Өлімімнің жұмбақ болғанын қаладым.
Dialogue: 0,0:42:11.90,0:42:15.28,Default,,0,0,0,,Мен көремін. Когоро ұйқысында күткендей.
Dialogue: 0,0:42:15.36,0:42:18.66,Default,,0,0,0,,Хаха, бүгін мені Пуаро деп атаңыз.
Dialogue: 0,0:42:18.74,0:42:23.70,Default,,0,0,0,,Бірақ сол Мурохаши жігіт Ранкунмен және басқалармен бөлмелерін ауыстырды.
Dialogue: 0,0:42:23.79,0:42:26.37,Default,,0,0,0,,Мен шегерімге арналған викторинаға ынтамен көмектестім.
Dialogue: 0,0:42:27.08,0:42:29.38,Default,,0,0,0,,Мұндай адам өз-өзіне қол жұмсай ма?
Dialogue: 0,0:42:29.46,0:42:32.00,Default,,0,0,0,,Тіпті сол дәлелдеу викторинасының нұсқау картасы.
Dialogue: 0,0:42:32.09,0:42:33.38,Default,,0,0,0,,Жалғанға ұқсайды
Dialogue: 0,0:42:36.97,0:42:40.93,Default,,0,0,0,,Ол кәдімгі нұсқау картасына ұқсайды.
Dialogue: 0,0:42:41.01,0:42:44.27,Default,,0,0,0,,Мазмұны біз естіген қулықтардан өзгеше.
Dialogue: 0,0:42:44.85,0:42:48.10,Default,,0,0,0,,Өйткені, әлдебір мақсат үшін біреу
Dialogue: 0,0:42:48.19,0:42:50.77,Default,,0,0,0,,Мен Мурохаши мырзаны осы бірінші класты көлікке ауыстырдым.
Dialogue: 0,0:42:51.48,0:42:55.73,Default,,0,0,0,,Мүмкін, Мурохаши мырза үнемі брондайтын бірінші класты көліктің В бөлмесінде.
Dialogue: 0,0:42:55.82,0:42:57.78,Default,,0,0,0,,Өйткені қариялар сөзімді бөлді.
Dialogue: 0,0:42:57.86,0:43:02.28,Default,,0,0,0,,Бұл тек осы көлік жасай алатын қулық па?
Dialogue: 0,0:43:02.37,0:43:05.66,Default,,0,0,0,,Эй, осы бірінші класты көлік бар ма?
Dialogue: 0,0:43:05.74,0:43:07.71,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:43:07.79,0:43:10.62,Default,,0,0,0,,Қараңызшы, бұл көліктің А-дан Е-ге дейінгі бөлмелері
Dialogue: 0,0:43:10.71,0:43:13.09,Default,,0,0,0,,Бір тұтынушы жыл сайын брондау жасады, солай ма?
Dialogue: 0,0:43:13.17,0:43:14.67,Default,,0,0,0,,О
Dialogue: 0,0:43:14.75,0:43:18.67,Default,,0,0,0,,Бұл қоңырау ағашының экспрессі бес жыл бұрын аяқталды.
Dialogue: 0,0:43:18.76,0:43:21.55,Default,,0,0,0,,Бұл бірінші класты көлікті кеңесші Джирокичи Сузуки көтерді.
Dialogue: 0,0:43:21.64,0:43:25.10,Default,,0,0,0,,Менің бір бай досымның өтініші бойынша салынғанын естідім.
Dialogue: 0,0:43:25.18,0:43:29.44,Default,,0,0,0,,Бай адам Шығыс экспрессінің үлкен жанкүйері.
Dialogue: 0,0:43:29.52,0:43:31.85,Default,,0,0,0,,Бүкіл отбасы ыңғайлы жүруі үшін—
Dialogue: 0,0:43:31.94,0:43:34.48,Default,,0,0,0,,Тек осы көлікте үлкенірек бөлме бар.
Dialogue: 0,0:43:34.57,0:43:38.44,Default,,0,0,0,,Сонымен, ол қонақтар ауқатты отбасынан шыққандар ма?
Dialogue: 0,0:43:38.53,0:43:42.57,Default,,0,0,0,,Жоқ, бұл отбасы бірінші рейске бір ай қалғанда үлкен өрттен қайтыс болды.
Dialogue: 0,0:43:42.66,0:43:44.24,Default,,0,0,0,,Өліп қала жаздады...
Dialogue: 0,0:43:44.33,0:43:46.74,Default,,0,0,0,,Жолаушылар арасында тек бір отбасы мүшесі
Dialogue: 0,0:43:46.83,0:43:48.75,Default,,0,0,0,,Иә? Бұл кім?
Dialogue: 0,0:43:48.83,0:43:51.96,Default,,0,0,0,,Бұл Д бөлмесіндегі Комино-сама.
Dialogue: 0,0:43:52.04,0:43:55.67,Default,,0,0,0,,Есімде болса, ол қайтыс болған байдың нағашы апасы.
Dialogue: 0,0:43:55.75,0:43:58.09,Default,,0,0,0,,Оқиға интернетте.
Dialogue: 0,0:43:58.17,0:43:59.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:59.21,0:44:03.01,Default,,0,0,0,,Өрт байдың туған күнін тойлау кезінде тұтанған.
Dialogue: 0,0:44:03.09,0:44:07.51,Default,,0,0,0,,Қайтыс болғандар – ауқатты отбасы және кешке келген 12 қонақ.
Dialogue: 0,0:44:08.31,0:44:11.94,Default,,0,0,0,,Құтқарылған адам жаңа айтқан Комино мырза болатын.
Dialogue: 0,0:44:12.02,0:44:15.81,Default,,0,0,0,,Онда қызметші Сумитомо мырза және төрт қонақ бар делінген.
Dialogue: 0,0:44:15.90,0:44:20.03,Default,,0,0,0,,Бұл төрт адам бұрынғы жолаушылар болуы мүмкін бе?
Dialogue: 0,0:44:20.11,0:44:23.91,Default,,0,0,0,,Өрттің шығуына электр жүйесіндегі ақау себеп болған көрінеді.
Dialogue: 0,0:44:23.99,0:44:26.03,Default,,0,0,0,,Мен оны анық түсінбейтін сияқтымын.
Dialogue: 0,0:44:26.12,0:44:31.50,Default,,0,0,0,,Хмм... Егер бұл кісі өлтіру сол өртке байланысты кек алу жоспары болса.
Dialogue: 0,0:44:31.58,0:44:35.25,Default,,0,0,0,,Бұл ақыры Шығыс экспрессіндегі кісі өлтіру сияқты сезіле бастады, солай емес пе?
Dialogue: 0,0:44:35.33,0:44:38.96,Default,,0,0,0,,Ал, бұрынғы тұтынушылармен тағы сөйлесейік.
Dialogue: 0,0:44:39.05,0:44:41.88,Default,,0,0,0,,Эй, электр тогы туралы айтамын.
Dialogue: 0,0:44:41.97,0:44:45.59,Default,,0,0,0,,Неліктен А бөлмесіндегі шам сөнген кезде оны ауыстырмадың?
Dialogue: 0,0:44:46.18,0:44:48.64,Default,,0,0,0,,Осы бірінші класты вагонның артында жүк вагоны тұр.
Dialogue: 0,0:44:48.72,0:44:51.39,Default,,0,0,0,,Әрқашанда қосалқы шам болуы керек.
Dialogue: 0,0:44:51.48,0:44:52.89,Default,,0,0,0,,Мен оны таба алмадым.
Dialogue: 0,0:44:52.98,0:44:56.11,Default,,0,0,0,,Олай болса, жөнелтпес бұрын, тексеру керек әртүрлі нәрселер бар.
Dialogue: 0,0:44:56.19,0:44:57.40,Default,,0,0,0,,Сіз дирижерсыз ба?
Dialogue: 0,0:44:57.48,0:45:02.11,Default,,0,0,0,,Әй, бөлмедегі су дұрыс шығады ма екен. Екі-үш адам.
Dialogue: 0,0:45:02.19,0:45:06.57,Default,,0,0,0,,Ойлап қарасам, кондуктордың бір киімі жоқ деп айттыңыз.
Dialogue: 0,0:45:06.66,0:45:10.66,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:45:10.74,0:45:13.66,Default,,0,0,0,,Иә? Сізді алаңдататын нәрсе бар ма?
Dialogue: 0,0:45:13.75,0:45:16.17,Default,,0,0,0,,А... аа... иә
Dialogue: 0,0:45:16.25,0:45:20.17,Default,,0,0,0,,Мен де өрт туралы мақаланы оқыдым, бірақ әлі ештеңе түсінбеймін.
Dialogue: 0,0:45:20.25,0:45:22.46,Default,,0,0,0,,Ал, жеңіл жүрейік.
Dialogue: 0,0:45:22.55,0:45:24.47,Default,,0,0,0,,Өйткені басқа адам асығыс болуы керек.
Dialogue: 0,0:45:25.13,0:45:30.10,Default,,0,0,0,,Сағатына 80 шақырым жылдамдықпен келе жатқан пойызда қашатын жер жоқ.
Dialogue: 0,0:45:30.18,0:45:31.47,Default,,0,0,0,,Жақсы... бұл дұрыс.
Dialogue: 0,0:45:37.94,0:45:38.98,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:45:39.65,0:45:43.69,Default,,0,0,0,,Ал егер... Ұйым шынымен мені нысанаға алса ше?
Dialogue: 0,0:45:43.78,0:45:46.49,Default,,0,0,0,,Егер сіз осы пойызда болсаңыз
Dialogue: 0,0:45:47.41,0:45:51.99,Default,,0,0,0,,Мен енді бұл жерде емеспін...
Dialogue: 0,0:45:55.58,0:45:58.96,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:45:59.04,0:46:00.09,Default,,0,0,0,,Электрондық пошта?
Dialogue: 0,0:46:01.63,0:46:04.47,Default,,0,0,0,,Белгісіз мекенжай Кімнен?
Dialogue: 0,0:46:05.42,0:46:06.68,Default,,0,0,0,,Ха!
Dialogue: 0,0:46:08.26,0:46:12.18,Default,,0,0,0,,«Дайынсың ба? Вермут».
Dialogue: 0,0:46:20.31,0:46:23.23,Default,,0,0,0,,Хайбара мырза, бұл электрондық пошта ма?
Dialogue: 0,0:46:23.32,0:46:24.28,Default,,0,0,0,,Кімнен?
Dialogue: 0,0:46:24.36,0:46:26.32,Default,,0,0,0,,Конаннан емес пе?
Dialogue: 0,0:46:26.40,0:46:29.07,Default,,0,0,0,,Жоқ, бұл жай ғана жарнамалық электрондық пошта.
Dialogue: 0,0:46:29.16,0:46:30.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:30.66,0:46:31.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:31.66,0:46:33.87,Default,,0,0,0,,А... Ай-кун, қайда бара жатырсың?
Dialogue: 0,0:46:34.70,0:46:35.66,Default,,0,0,0,,Дәретхана
Dialogue: 0,0:46:35.75,0:46:38.37,Default,,0,0,0,,Мен суыққа қарсы дәрі де ішемін, сондықтан біраз уақыт кетуі мүмкін.
Dialogue: 0,0:46:38.96,0:46:40.88,Default,,0,0,0,,Олай болса мен сені ертіп барамын.
Dialogue: 0,0:46:43.13,0:46:46.01,Default,,0,0,0,,Мені жалғыз қалдырмаңыз, мен сізді ренжітіп жатырмын.
Dialogue: 0,0:46:46.59,0:46:49.55,Default,,0,0,0,,Бірақ ол осы бөлмеге бара жатыр еді.
Dialogue: 0,0:46:49.64,0:46:52.64,Default,,0,0,0,,Ол менің күртешенің етегінен үнемі ұстап тұрды.
Dialogue: 0,0:46:52.72,0:46:54.77,Default,,0,0,0,,Сізде алаңдайтын нәрсе бар сияқты.
Dialogue: 0,0:46:54.85,0:46:56.93,Default,,0,0,0,,Маған сенің қасымда қалуың керек.
Dialogue: 0,0:46:58.56,0:47:00.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:00.77,0:47:03.27,Default,,0,0,0,,Ай Чан қайда?
Dialogue: 0,0:47:18.96,0:47:23.46,Default,,0,0,0,,Алдағы 19 жасқа толған туған күніңізбен қош болыңыз.
Dialogue: 0,0:47:23.54,0:47:28.76,Default,,0,0,0,,О, мен сізге айтқан кез келді.
Dialogue: 0,0:47:28.84,0:47:33.55,Default,,0,0,0,,Негізі, анаңыз қазір өте қорқынышты дәрі жасап жатыр.
Dialogue: 0,0:47:33.64,0:47:37.68,Default,,0,0,0,,Менің зертханалық әріптестерім бұл арман сияқты дәріге қатты қуанады.
Dialogue: 0,0:47:37.77,0:47:41.10,Default,,0,0,0,,Әкем мен шешем өз тілектерін айтып, мені осылай атайды.
Dialogue: 0,0:47:41.19,0:47:45.57,Default,,0,0,0,,Күміс оқ Күміс оқ дегеніміз не?
Dialogue: 0,0:47:46.73,0:47:49.11,Default,,0,0,0,,Бірақ дәріні аяқтау үшін
Dialogue: 0,0:47:49.19,0:47:53.07,Default,,0,0,0,,Әке мен ана сендермен қоштасулары керек.
Dialogue: 0,0:47:53.62,0:47:56.83,Default,,0,0,0,,Түсініңізші, Шихо.
Dialogue: 0,0:47:58.16,0:48:02.58,Default,,0,0,0,,Кешіріңіз анашым, мен түсінбедім.
Dialogue: 0,0:48:03.67,0:48:06.59,Default,,0,0,0,,Мен мұндай дәрі жасамауым керек еді.
Dialogue: 0,0:48:08.13,0:48:12.05,Default,,0,0,0,,Бірақ барлық қатысушыларды қалдырмау үшін
Dialogue: 0,0:48:12.13,0:48:14.60,Default,,0,0,0,,Енді бұл дәріге сенуден басқа амалым жоқ.
Dialogue: 0,0:48:30.40,0:48:33.45,Default,,0,0,0,,Әпкелерден күткендей.
Dialogue: 0,0:48:33.53,0:48:35.91,Default,,0,0,0,,Іс-әрекеттерді анық түсінуге болады
Dialogue: 0,0:48:37.83,0:48:40.12,Default,,0,0,0,,Жүріңдер, маған келуге рұқсат етіңдер.
Dialogue: 0,0:48:41.00,0:48:42.62,Default,,0,0,0,,Осы салада
Dialogue: 0,0:48:48.42,0:48:50.92,Default,,0,0,0,,Жоқ, қазір емес.
Dialogue: 0,0:48:51.72,0:48:52.92,Default,,0,0,0,,Фу…
Dialogue: 0,0:48:53.01,0:48:56.01,Default,,0,0,0,,Мені бұл формада өлтіруге болмайды.
Dialogue: 0,0:48:56.09,0:49:01.64,Default,,0,0,0,,Мені қорғау үшін өзін әрқашан құрбан ететін адам үшін
Dialogue: 0,0:49:03.48,0:49:05.44,Default,,0,0,0,,Мен білсем де...
Dialogue: 0,0:49:07.19,0:49:09.40,Default,,0,0,0,,Ұйымнан кеткен кезімнен
Dialogue: 0,0:49:09.48,0:49:12.28,Default,,0,0,0,,Мен үшін орын жоқ
Dialogue: 0,0:49:12.36,0:49:14.03,Default,,0,0,0,,Мен оны білдім
Dialogue: 0,0:49:15.45,0:49:17.20,Default,,0,0,0,,Мен ақымақпын.
Dialogue: 0,0:49:17.99,0:49:20.87,Default,,0,0,0,,Сіз ақымақсыз, әпке.
Dialogue: 0,0:49:24.33,0:49:25.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:33.67,0:49:35.43,Default,,0,0,0,,Қашпа, Хайбара
Dialogue: 0,0:49:36.34,0:49:38.39,Default,,0,0,0,,Өз тағдырымнан
Dialogue: 0,0:49:39.60,0:49:41.10,Default,,0,0,0,,Қашпа
Dialogue: 0,0:49:43.23,0:49:44.85,Default,,0,0,0,,5 жыл бұрынғы өрт?
Dialogue: 0,0:49:45.52,0:49:48.56,Default,,0,0,0,,Мұның маған қандай қатысы бар?
Dialogue: 0,0:49:48.65,0:49:50.98,Default,,0,0,0,,Менен сұрасаң да пайдасы жоқ.
Dialogue: 0,0:49:51.07,0:49:55.61,Default,,0,0,0,,Мен оқиға болған жерде Сизуока префектуралық полициясына хабарластым.
Dialogue: 0,0:49:55.70,0:49:58.57,Default,,0,0,0,,Құтқарушылар арасынан сенің есіміңді көріп тұрмын.
Dialogue: 0,0:49:59.37,0:50:02.04,Default,,0,0,0,,Дұрыс, өзін-өзі қорғау күштерінің бұрынғы офицері.
Dialogue: 0,0:50:02.12,0:50:05.66,Default,,0,0,0,,Тайсаку Ното отта өлген баймен семсерші болған.
Dialogue: 0,0:50:05.75,0:50:06.96,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:50:07.75,0:50:10.59,Default,,0,0,0,,Менің бетімдегі бұл тыртық та сол кезде түскен.
Dialogue: 0,0:50:10.67,0:50:12.63,Default,,0,0,0,,Мен оны жасырғандай емес едім...
Dialogue: 0,0:50:12.71,0:50:13.71,Default,,0,0,0,,Ойланып қарашы, сен
Dialogue: 0,0:50:14.30,0:50:17.84,Default,,0,0,0,,Біз алғаш кездескен кезде сенің иығыңда бірдеңе болды.
Dialogue: 0,0:50:18.51,0:50:22.68,Default,,0,0,0,,Онда бөлменің құпия айласы бар емес пе?
Dialogue: 0,0:50:22.76,0:50:25.23,Default,,0,0,0,,А... бұл жай ғана бамбук қылыш.
Dialogue: 0,0:50:25.31,0:50:27.14,Default,,0,0,0,,Шинай?
Dialogue: 0,0:50:29.44,0:50:31.65,Default,,0,0,0,,Қараңызшы, онда тек бамбук қылыш бар.
Dialogue: 0,0:50:31.73,0:50:33.65,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:50:33.73,0:50:35.40,Default,,0,0,0,,Осыдан кейін Нагоядағы досымен
Dialogue: 0,0:50:35.49,0:50:37.65,Default,,0,0,0,,Біз келісім жасауға уәде бердік.
Dialogue: 0,0:50:38.24,0:50:40.12,Default,,0,0,0,,Әйтеуір, басқа пайдасы жоқ болса...
Dialogue: 0,0:50:40.20,0:50:41.66,Default,,0,0,0,,- Ал, ағай - (Ното) А?
Dialogue: 0,0:50:42.33,0:50:44.49,Default,,0,0,0,,Бір сәт дәлізбен жүгіре аласыз ба?
Dialogue: 0,0:50:44.58,0:50:45.91,Default,,0,0,0,,Жүгіру?
Dialogue: 0,0:50:46.00,0:50:46.83,Default,,0,0,0,,Иә
Dialogue: 0,0:50:46.91,0:50:49.25,Default,,0,0,0,,Қылмыскер қашып бара жатқанда оның артына қараймыз.
Dialogue: 0,0:50:49.33,0:50:50.50,Default,,0,0,0,,Себебі сіз оны көрген боларсыз.
Dialogue: 0,0:50:50.58,0:50:54.30,Default,,0,0,0,,Маған қарияның жүгіріп бара жатқан фильмін түсіруге рұқсат бересіз бе?
Dialogue: 0,0:50:57.34,0:50:59.05,Default,,0,0,0,,Шамасы, И
Dialogue: 0,0:50:59.13,0:51:02.85,Default,,0,0,0,,Андо сол өрт кезінде Мурохаши мырзамен бірге құтқарылды.
Dialogue: 0,0:51:02.93,0:51:06.27,Default,,0,0,0,,Мен мұны сенен сұраған жоқпын, сондықтан айтпадым...
Dialogue: 0,0:51:06.35,0:51:10.60,Default,,0,0,0,,Бөлмедегі мына үлкен сөмке не?
Dialogue: 0,0:51:10.69,0:51:14.73,Default,,0,0,0,,А, бұл суретті маған бағалауды сұрады.
Dialogue: 0,0:51:14.82,0:51:16.99,Default,,0,0,0,,Өкінішке орай, бұл қолдан жасалған.
Dialogue: 0,0:51:17.07,0:51:19.32,Default,,0,0,0,,Мен қарап шыға аламын ба?
Dialogue: 0,0:51:19.40,0:51:20.66,Default,,0,0,0,,Не? Иә
Dialogue: 0,0:51:21.91,0:51:23.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:51:23.78,0:51:25.08,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:51:26.29,0:51:28.08,Default,,0,0,0,,Бұл өте ауыр.
Dialogue: 0,0:51:28.16,0:51:30.37,Default,,0,0,0,,Себебі сурет жақтауы таза алтыннан жасалған.
Dialogue: 0,0:51:30.46,0:51:33.00,Default,,0,0,0,,Қарасам, ол саф алтыннан жасалған.
Dialogue: 0,0:51:33.75,0:51:37.84,Default,,0,0,0,,Айтпақшы, өртте қаза тапқан баймен қарым-қатынасыңыз қандай?
Dialogue: 0,0:51:37.92,0:51:40.34,Default,,0,0,0,,Ол кісі шедеврлерді жинаушы болған.
Dialogue: 0,0:51:40.43,0:51:43.26,Default,,0,0,0,,Мен көптеген суреттермен таныстырдым.
Dialogue: 0,0:51:43.35,0:51:47.27,Default,,0,0,0,,Бірақ оның көп бөлігі өртте жойылды.
Dialogue: 0,0:51:47.35,0:51:48.48,Default,,0,0,0,,Хмм…
Dialogue: 0,0:51:48.56,0:51:51.10,Default,,0,0,0,,Бірақ бұл өте ауыр...
Dialogue: 0,0:51:51.19,0:51:54.73,Default,,0,0,0,,Оны өзіңіз алып жүруге шыдамыңыз болуы керек.
Dialogue: 0,0:51:54.82,0:51:56.73,Default,,0,0,0,,Эх... жақсы.
Dialogue: 0,0:51:56.82,0:52:00.40,Default,,0,0,0,,Олай болса, ағай, дәлізбен жүгіріңіз.
Dialogue: 0,0:52:00.49,0:52:01.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:02.03,0:52:06.45,Default,,0,0,0,,Иә, мен бұл отты ешқашан ұмытпаймын.
Dialogue: 0,0:52:07.12,0:52:09.87,Default,,0,0,0,,Өйткені, сол өрттің кесірінен болды.
Dialogue: 0,0:52:09.96,0:52:12.54,Default,,0,0,0,,Мына мүгедектер арбасы маған қамқорлық жасайды.
Dialogue: 0,0:52:12.62,0:52:16.00,Default,,0,0,0,,Әй... Сонда сіздің аяғыңыз өрттен жарақат алды ма?
Dialogue: 0,0:52:16.09,0:52:19.13,Default,,0,0,0,,Иә, басқалар сияқты.
Dialogue: 0,0:52:19.21,0:52:22.18,Default,,0,0,0,,Дәлізде жүгіру мен үшін тым ауыр...
Dialogue: 0,0:52:22.26,0:52:25.18,Default,,0,0,0,,Бірақ қызметші Сумитомо ханым жүгіре алады, солай ма?
Dialogue: 0,0:52:25.26,0:52:26.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:26.51,0:52:27.60,Default,,0,0,0,,Хехе
Dialogue: 0,0:52:29.31,0:52:31.43,Default,,0,0,0,,Мен жай ғана жүгіруім керек пе?
Dialogue: 0,0:52:31.52,0:52:33.98,Default,,0,0,0,,Аа, әдеттегідей.
Dialogue: 0,0:52:37.52,0:52:41.28,Default,,0,0,0,,Менің ойымша, бұлай кінәліні анықтау мүмкін емес.
Dialogue: 0,0:52:42.53,0:52:43.86,Default,,0,0,0,,Сәлем, әже
Dialogue: 0,0:52:43.95,0:52:49.33,Default,,0,0,0,,Мэйд-сан, сен өте жылдам жүгіресің, бірақ спортпен шұғылдандың ба?
Dialogue: 0,0:52:50.62,0:52:53.04,Default,,0,0,0,,Әй, маған жауап бер.
Dialogue: 0,0:52:53.12,0:52:55.00,Default,,0,0,0,,Әже
Dialogue: 0,0:53:01.34,0:53:02.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:02.97,0:53:07.18,Default,,0,0,0,,Сол отта өлген байдың немересіне келін болғаным рас.
Dialogue: 0,0:53:07.26,0:53:10.43,Default,,0,0,0,,Сол тозақ отынан құтқарылғаным рас.
Dialogue: 0,0:53:10.52,0:53:14.48,Default,,0,0,0,,Неліктен мен дәлізбен жүгіруім керек?
Dialogue: 0,0:53:14.56,0:53:17.48,Default,,0,0,0,,Ах...қалай болса да
Dialogue: 0,0:53:17.56,0:53:20.78,Default,,0,0,0,,Қалай болғанда да, құлыпты алып, бөлмеге кіріңіз.
Dialogue: 0,0:53:20.86,0:53:21.86,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:53:21.94,0:53:25.16,Default,,0,0,0,,Хмф, егер сіз шынымен кіргіңіз келсе, іздеу туралы ордер әкеліңіз.
Dialogue: 0,0:53:25.24,0:53:26.82,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:53:26.91,0:53:31.08,Default,,0,0,0,,Олай болса, бөлмеңнен тауып алған сағатың.
Dialogue: 0,0:53:31.16,0:53:32.50,Default,,0,0,0,,Содан бері шырылдады ма?
Dialogue: 0,0:53:32.58,0:53:35.00,Default,,0,0,0,,Қарау? Ах...
Dialogue: 0,0:53:36.00,0:53:38.04,Default,,0,0,0,,Көріп тұрғаныңыздай, мен оны сонда қалдырдым.
Dialogue: 0,0:53:38.13,0:53:39.67,Default,,0,0,0,,- (Изуми) Шыңғырып тұрған жоқ - (Когоро) Иә?
Dialogue: 0,0:53:39.75,0:53:41.59,Default,,0,0,0,,Е, ол қайда?
Dialogue: 0,0:53:41.67,0:53:45.18,Default,,0,0,0,,Қараңдар, диванда жатыр.
Dialogue: 0,0:53:45.26,0:53:47.55,Default,,0,0,0,,Мен оны бұл аралықтан көре алмаймын.
Dialogue: 0,0:53:47.64,0:53:50.01,Default,,0,0,0,,Иә? Күте тұрыңыз
Dialogue: 0,0:53:50.68,0:53:54.39,Default,,0,0,0,,Мен Мурохаши мырзаның денесін тапқанда, мен...
Dialogue: 0,0:53:55.19,0:53:56.65,Default,,0,0,0,,Есік саңылауы арқылы
Dialogue: 0,0:53:56.73,0:53:59.77,Default,,0,0,0,,Диванда дененің қарсысында оқ тесілген.
Dialogue: 0,0:54:07.16,0:54:09.57,Default,,0,0,0,,А... Мен оны әйтеуір тыныштандыруға тырыстым.
Dialogue: 0,0:54:10.20,0:54:12.87,Default,,0,0,0,,Мен Деба мырзадан да дәлізбен жүгіріп өтуін өтіндім.
Dialogue: 0,0:54:12.95,0:54:15.37,Default,,0,0,0,,Менің ойымша, бұл шын мәнінде мағынасы бар.
Dialogue: 0,0:54:15.46,0:54:19.08,Default,,0,0,0,,Әзірше мен түсірген фильмімді балаларға көрсетемін.
Dialogue: 0,0:54:19.17,0:54:20.34,Default,,0,0,0,,О
Dialogue: 0,0:54:22.00,0:54:22.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:23.46,0:54:25.55,Default,,0,0,0,,Эй, тыңдап тұрсың ба, монах?
Dialogue: 0,0:54:26.22,0:54:27.18,Default,,0,0,0,,Эй
Dialogue: 0,0:54:30.22,0:54:31.26,Default,,0,0,0,,Фу…
Dialogue: 0,0:55:12.18,0:55:13.85,Default,,0,0,0,,Бұл кім? Сіз
Dialogue: 0,0:55:17.31,0:55:19.06,Default,,0,0,0,,Мұны бәрі естіді.
Dialogue: 0,0:55:19.98,0:55:22.48,Default,,0,0,0,,Иә, әдеттегідей.
Dialogue: 0,0:55:25.48,0:55:26.78,Default,,0,0,0,,Масуми
Dialogue: 0,0:55:31.45,0:55:33.62,Default,,0,0,0,,Шу... Хиде-нии?
Dialogue: 0,0:55:34.20,0:55:36.12,Default,,0,0,0,,Бұл шынымен де Хиде-нии ме?
Dialogue: 0,0:55:36.20,0:55:38.79,Default,,0,0,0,,Бірақ неге? Жасырын аға өлді...
Dialogue: 0,0:55:42.88,0:55:44.88,Default,,0,0,0,,Жауабын естігім келді.
Dialogue: 0,0:55:44.96,0:55:47.17,Default,,0,0,0,,Не... бірдеңе болды ма?
Dialogue: 0,0:55:47.26,0:55:48.30,Default,,0,0,0,,(Идзуми) Уау! Бұл өте қызықты естіледі.
Dialogue: 0,0:55:48.88,0:55:50.80,Default,,0,0,0,,Менің әпкем қан аз.
Dialogue: 0,0:55:50.88,0:55:52.39,Default,,0,0,0,,(Ллойд) Бүгінгі серуен — немесе дұрысы, «Үккі» операциясы
Dialogue: 0,0:56:03.69,0:56:05.48,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:56:10.86,0:56:11.99,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:56:12.86,0:56:15.24,Default,,0,0,0,,Бізді дәлізге шақырыңыз
Dialogue: 0,0:56:15.33,0:56:17.45,Default,,0,0,0,,Сіз бірдеңені түсінген сияқтысыз.
Dialogue: 0,0:56:17.54,0:56:20.37,Default,,0,0,0,,А, жоқ, бұл әлі тергеуде...
Dialogue: 0,0:56:20.46,0:56:23.63,Default,,0,0,0,,Бірақ бала қоңырау шалды.
Dialogue: 0,0:56:23.71,0:56:27.21,Default,,0,0,0,,Мен Sleeping Kogoro жұмбақ шоуын бастағанда.
Dialogue: 0,0:56:27.30,0:56:28.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:28.30,0:56:31.22,Default,,0,0,0,,Өйткені Когораның ағасы солай айтты, солай ма?
Dialogue: 0,0:56:31.30,0:56:33.72,Default,,0,0,0,,«Сюжет менің басымда шешілді»
Dialogue: 0,0:56:33.80,0:56:34.64,Default,,0,0,0,,Идиот!
Dialogue: 0,0:56:34.72,0:56:37.64,Default,,0,0,0,,Менің ойымша, сіз оны бір нәрсенің мысалы деп атай аласыз хахаха ...
Dialogue: 0,0:56:38.14,0:56:39.39,Default,,0,0,0,,Айқай
Dialogue: 0,0:56:39.47,0:56:41.85,Default,,0,0,0,,Хомия~
Dialogue: 0,0:56:42.85,0:56:44.23,Default,,0,0,0,,Бірдеңе тапсырыс берші
Dialogue: 0,0:56:46.19,0:56:48.82,Default,,0,0,0,,Сонымен... ұйықтап жатқан Когоро пайда болды!
Dialogue: 0,0:56:49.65,0:56:52.53,Default,,0,0,0,,Моури мырзаның бұл позаны алғаны осыны білдіреді
Dialogue: 0,0:56:53.28,0:56:54.91,Default,,0,0,0,,Сіз оны шештіңіз.
Dialogue: 0,0:56:55.99,0:57:00.25,Default,,0,0,0,,Осы бірінші класты пойыздың В кабинасында жабық бөлмедегі кісі өлтіру оқиғасының шындығы
Dialogue: 0,0:57:00.83,0:57:01.91,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:57:02.50,0:57:04.54,Default,,0,0,0,,Бұл мүлде мүмкін болар еді
Dialogue: 0,0:57:04.62,0:57:07.59,Default,,0,0,0,,Мен Амуро, Мори Сенсейдің бірінші шәкіртімін.
Dialogue: 0,0:57:08.25,0:57:11.09,Default,,0,0,0,,Не? Айкун мұнда емес пе?
Dialogue: 0,0:57:11.17,0:57:15.01,Default,,0,0,0,,Иә, мен де жақын маңдағы көліктердің әжетханасын ақтардым.
Dialogue: 0,0:57:15.09,0:57:16.09,Default,,0,0,0,,Тору~!
Dialogue: 0,0:57:18.64,0:57:20.60,Default,,0,0,0,,Аа, Ай Чаннан электрондық пошта
Dialogue: 0,0:57:21.31,0:57:26.15,Default,,0,0,0,,«Уайымдама, менде бәрі жақсы»...
Dialogue: 0,0:57:26.23,0:57:28.90,Default,,0,0,0,,Айкунның электрондық пошта мекенжайы осында екені рас.
Dialogue: 0,0:57:29.61,0:57:32.11,Default,,0,0,0,,Конанның орны емес пе?
Dialogue: 0,0:57:32.19,0:57:33.57,Default,,0,0,0,,Мен сенімдімін.
Dialogue: 0,0:57:33.65,0:57:35.61,Default,,0,0,0,,Біздің де барғымыз келді.
Dialogue: 0,0:57:35.70,0:57:39.62,Default,,0,0,0,,Бұл жағдайда «жоқ» деңіз.
Dialogue: 0,0:57:43.50,0:57:47.13,Default,,0,0,0,,Иә, жабық бөлмедегі кісі өлтірудің құпиясы
Dialogue: 0,0:57:47.75,0:57:51.50,Default,,0,0,0,,Мен оны Деба мырзаның Е бөлмесіне екінші рет барғанымда шештім.
Dialogue: 0,0:57:51.59,0:57:55.18,Default,,0,0,0,,Тоқта... күт, не? Мен кінәлімін дейсіз бе?
Dialogue: 0,0:57:55.80,0:57:58.09,Default,,0,0,0,,Тізбекпен бекітілген есік арқылы
Dialogue: 0,0:57:58.18,0:58:01.18,Default,,0,0,0,,Мен мұны сіздің бөлмеңізге қараған кезде байқадым.
Dialogue: 0,0:58:01.89,0:58:05.89,Default,,0,0,0,,Шынжырлы құлып қосулы болса, оған қанша қарасаңыз да,
Dialogue: 0,0:58:05.98,0:58:08.69,Default,,0,0,0,,Бір жақтағы диван әрең көрінеді.
Dialogue: 0,0:58:08.77,0:58:13.53,Default,,0,0,0,,Алайда Конан Мурохаши мырзаның денесін В бөлмесінен тапқан кезде.
Dialogue: 0,0:58:13.61,0:58:16.49,Default,,0,0,0,,Шынжыр құлпы қосылған болса да
Dialogue: 0,0:58:16.57,0:58:19.45,Default,,0,0,0,,Оң жақтағы диванды көргенін айтады.
Dialogue: 0,0:58:20.03,0:58:22.74,Default,,0,0,0,,Әлгі бала қателеспеді ме?
Dialogue: 0,0:58:22.83,0:58:24.08,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:58:25.12,0:58:27.04,Default,,0,0,0,,Тізбекті құлыптағы шынжырлар саны
Dialogue: 0,0:58:27.12,0:58:30.63,Default,,0,0,0,,Басқа бөлмелерге қарағанда бір бөлме көп болғандықтан деп ойлаймын.
Dialogue: 0,0:58:30.71,0:58:33.09,Default,,0,0,0,,The gap between the door widens accordingly.
Dialogue: 0,0:58:33.17,0:58:35.84,Default,,0,0,0,,The range that can be seen from the outside has also expanded.
Dialogue: 0,0:58:35.92,0:58:39.18,Default,,0,0,0,,Бұған қатысты мәселе бар ма?
Dialogue: 0,0:58:39.26,0:58:40.72,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:58:40.80,0:58:42.64,Default,,0,0,0,,Тізбекті құлыптар әдетте
Dialogue: 0,0:58:42.72,0:58:45.89,Default,,0,0,0,,Сырттан есіктің саңылауына қолымды салсам да, оны алып тастай алмаймын.
Dialogue: 0,0:58:45.98,0:58:48.85,Default,,0,0,0,,Ұзындық шекке қойылғанымен
Dialogue: 0,0:58:48.94,0:58:51.94,Default,,0,0,0,,Егер ол бір тізбек ұзын болса
Dialogue: 0,0:58:52.02,0:58:55.36,Default,,0,0,0,,Сіз оны бөлмеден шыққаннан кейін де құлыптай аласыз.
Dialogue: 0,0:59:01.95,0:59:02.83,Default,,0,0,0,,О, күте тұрыңыз.
Dialogue: 0,0:59:02.91,0:59:05.79,Default,,0,0,0,,Жоқ, рұқсатсыз тізімге қарамаңыз.
Dialogue: 0,0:59:05.87,0:59:07.25,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:59:07.33,0:59:10.50,Default,,0,0,0,,I felt like I saw someone I knew in the car.
Dialogue: 0,0:59:10.58,0:59:14.09,Default,,0,0,0,,Мұндай жағдайда маған қоңырау шалыңыз.
Dialogue: 0,0:59:14.17,0:59:15.21,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:59:25.22,0:59:27.02,Default,,0,0,0,,Алтауы бар.
Dialogue: 0,0:59:27.64,0:59:31.52,Default,,0,0,0,,The other rooms have 5 chains, but this room B only has 6.
Dialogue: 0,0:59:31.60,0:59:34.65,Default,,0,0,0,,Құпия бөлме енді бұзылды.
Dialogue: 0,0:59:34.73,0:59:37.57,Default,,0,0,0,,But what if someone was whispering at the door?
Dialogue: 0,0:59:37.65,0:59:39.65,Default,,0,0,0,,Кондуктор байқамай ма?
Dialogue: 0,0:59:39.74,0:59:43.53,Default,,0,0,0,,Well, it seems like you've been in the hallway the whole time.
Dialogue: 0,0:59:43.62,0:59:47.25,Default,,0,0,0,,The person who was peeking at me through the door saw it...
Dialogue: 0,0:59:47.33,0:59:49.75,Default,,0,0,0,,Эй, бұл кім?
Dialogue: 0,0:59:49.83,0:59:52.46,Default,,0,0,0,,Мен оны жақсы көре алмаймын.
Dialogue: 0,0:59:52.54,0:59:54.71,Default,,0,0,0,,Туннель іші қараңғы болды.
Dialogue: 0,0:59:54.79,0:59:59.22,Default,,0,0,0,,Сонымен, кінәлі сол адам болып, басқа көлікке отырып қашып кеткен.
Dialogue: 0,0:59:59.88,1:00:02.18,Default,,0,0,0,,It could certainly be an external culprit.
Dialogue: 0,1:00:02.26,1:00:05.51,Default,,0,0,0,,There was a conductor in the hallway who was familiar to us.
Dialogue: 0,1:00:05.60,1:00:09.60,Default,,0,0,0,,There's probably no one in this first class car who would commit such a crime.
Dialogue: 0,1:00:09.68,1:00:11.23,Default,,0,0,0,,Бірақ тәуекелдер
Dialogue: 0,1:00:11.31,1:00:14.02,Default,,0,0,0,,Бұл дыбыс сіздің мәселеңізді шешсе ше?
Dialogue: 0,1:00:14.11,1:00:14.98,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:15.06,1:00:17.19,Default,,0,0,0,,(есік қоңырауының дыбысы)
Dialogue: 0,1:00:17.28,1:00:19.44,Default,,0,0,0,,This… this is the sound of the doorbell.
Dialogue: 0,1:00:19.53,1:00:21.20,Default,,0,0,0,,Сонымен... бірақ нақты кім?
Dialogue: 0,1:00:21.28,1:00:22.66,Default,,0,0,0,,Бұл менмін
Dialogue: 0,1:00:23.32,1:00:24.74,Default,,0,0,0,,(есік қоңырауының дыбысы)
Dialogue: 0,1:00:24.82,1:00:29.25,Default,,0,0,0,,I just rang the bell in room B and played back the sound I recorded on my phone.
Dialogue: 0,1:00:29.95,1:00:32.12,Default,,0,0,0,,Бұл дыбысты дирижер естіді.
Dialogue: 0,1:00:32.21,1:00:35.63,Default,,0,0,0,,No lamps were on in any of the rooms, so I went to room A.
Dialogue: 0,1:00:35.71,1:00:39.13,Default,,0,0,0,,А, А бөлмесіндегі шамның шамы сөніп қалды.
Dialogue: 0,1:00:39.21,1:00:42.01,Default,,0,0,0,,Қоңырау шалған Ното мырза шығар деп ойладым.
Dialogue: 0,1:00:42.09,1:00:46.93,Default,,0,0,0,,So I saw Mr. Noto and the conductor arguing at the doorway of Room A.
Dialogue: 0,1:00:47.01,1:00:50.48,Default,,0,0,0,,Mr. Murohashi in Room B opened the door and looked in.
Dialogue: 0,1:00:50.56,1:00:54.19,Default,,0,0,0,,Ah... ah, while on the phone with someone.
Dialogue: 0,1:00:54.27,1:00:55.44,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:00:56.02,1:00:59.69,Default,,0,0,0,,Сол кезде қылмыскер В бөлмесіне кірді.
Dialogue: 0,1:00:59.78,1:01:01.15,Default,,0,0,0,,Бұл пойыз дәлізі
Dialogue: 0,1:01:01.24,1:01:04.49,Default,,0,0,0,,Бөлменің есігін ашқанда, оның кішкентай болғаны сонша, ол жабылып қала жаздады.
Dialogue: 0,1:01:04.99,1:01:06.95,Default,,0,0,0,,В бөлмесінің есігі ашық болса
Dialogue: 0,1:01:07.03,1:01:10.45,Default,,0,0,0,,The figure of the criminal coming from the other side of that door is
Dialogue: 0,1:01:10.54,1:01:13.46,Default,,0,0,0,,The conductor in front of room A can't see you.
Dialogue: 0,1:01:13.54,1:01:17.25,Default,,0,0,0,,Yes, the criminal called Mr. Murohashi on the phone.
Dialogue: 0,1:01:17.34,1:01:20.71,Default,,0,0,0,,«Бөлме сыртында шу, бірдеңе болды ма?»
Dialogue: 0,1:01:20.80,1:01:22.13,Default,,0,0,0,,Мен саған айттым
Dialogue: 0,1:01:22.22,1:01:24.72,Default,,0,0,0,,Бұл туннель ішінде болды.
Dialogue: 0,1:01:24.80,1:01:29.43,Default,,0,0,0,,If the criminal called Mr. Murohashi just before entering the tunnel.
Dialogue: 0,1:01:29.51,1:01:32.02,Default,,0,0,0,,Even if the criminal on the other end of the phone comes to room B.
Dialogue: 0,1:01:32.10,1:01:35.85,Default,,0,0,0,,“The call got cut off in the tunnel, so let's talk inside the room.”
Dialogue: 0,1:01:35.94,1:01:37.73,Default,,0,0,0,,.
Dialogue: 0,1:01:38.31,1:01:41.61,Default,,0,0,0,,Бірақ кінәлі Мурохаши мырзамен не туралы сөйлесті?
Dialogue: 0,1:01:41.69,1:01:42.86,Default,,0,0,0,,Жұмбақ пойыздың ішінде
Dialogue: 0,1:01:42.94,1:01:46.11,Default,,0,0,0,,Бұл өткізіліп жатқан шегерім туралы викторина туралы кеңес.
Dialogue: 0,1:01:46.20,1:01:47.03,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:47.70,1:01:49.83,Default,,0,0,0,,Кінәлі жалған нұсқау картасын пайдаланған
Dialogue: 0,1:01:49.91,1:01:53.66,Default,,0,0,0,,Mr. Murohashi plays the role of the victim, the culprit plays the role of the culprit
Dialogue: 0,1:01:53.75,1:01:58.33,Default,,0,0,0,,Менің қыздарымды сыбайлас ойнауға таңдап алды деп өтірік айтты.
Dialogue: 0,1:01:58.42,1:02:01.80,Default,,0,0,0,,It's because it's a corpse-disappearance trick.
Dialogue: 0,1:02:01.88,1:02:05.51,Default,,0,0,0,,Мурохаши мырза мен қыздарым бөлме алмасып жатыр.
Dialogue: 0,1:02:06.09,1:02:09.05,Default,,0,0,0,,Of course, originally, the B cabin of the first class car was
Dialogue: 0,1:02:09.14,1:02:11.85,Default,,0,0,0,,Mr. Murohashi must have made a reservation.
Dialogue: 0,1:02:11.93,1:02:15.98,Default,,0,0,0,,Нұсқаулық карта күтпеген жағдайларда дайындалды.
Dialogue: 0,1:02:16.06,1:02:19.27,Default,,0,0,0,,Қауіпсіздік үшін біз балаларды детектив ойнауға таңдадық.
Dialogue: 0,1:02:20.11,1:02:24.44,Default,,0,0,0,,If someone comes to the B room of car No. 7 as a detective.
Dialogue: 0,1:02:24.53,1:02:26.65,Default,,0,0,0,,Қыздары сыбайлас ретінде
Dialogue: 0,1:02:26.74,1:02:30.03,Default,,0,0,0,,You'll have to stay in that room for a while.
Dialogue: 0,1:02:30.78,1:02:34.08,Default,,0,0,0,,However, my daughters and children soon found out.
Dialogue: 0,1:02:34.16,1:02:38.29,Default,,0,0,0,,Сіз қылмыс болған бірінші класты көліктің В бөлмесіне оралған сияқтысыз.
Dialogue: 0,1:02:38.37,1:02:39.79,Default,,0,0,0,,Сонымен?
Dialogue: 0,1:02:39.88,1:02:44.30,Default,,0,0,0,,It was clear that the culprit entered Room B where Mr. Murohashi was moved.
Dialogue: 0,1:02:44.38,1:02:45.67,Default,,0,0,0,,Қашан шықты?
Dialogue: 0,1:02:45.76,1:02:46.63,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,1:02:46.72,1:02:50.39,Default,,0,0,0,,Егер сіз оны В бөлмесіне кіргеннен кейін бірден өлтіріп, бөлмеден бірден шығып кетсеңіз ше?
Dialogue: 0,1:02:50.47,1:02:52.81,Default,,0,0,0,,А бөлмесінің алдындағы кондуктор қарап тұруы керек.
Dialogue: 0,1:02:53.43,1:02:54.77,Default,,0,0,0,,Бірақ мен оны көрген жоқпын.
Dialogue: 0,1:02:54.85,1:02:58.10,Default,,0,0,0,,What is suspicious is that the conductor saw...
Dialogue: 0,1:02:58.19,1:03:00.90,Default,,0,0,0,,Есіктен үңіліп тұрған адам.
Dialogue: 0,1:03:00.98,1:03:02.65,Default,,0,0,0,,Бұл қай есік?
Dialogue: 0,1:03:02.73,1:03:05.74,Default,,0,0,0,,L... Бұл дәліздің арғы жағындағы есік еді.
Dialogue: 0,1:03:05.82,1:03:10.49,Default,,0,0,0,,Мен оны Е бөлмесінің алдында тұрғанда көрдім, сондықтан бұл Ното мырзаның А бөлмесі деп ойлаймын.
Dialogue: 0,1:03:10.57,1:03:13.74,Default,,0,0,0,,Жүр, жаман болма.
Dialogue: 0,1:03:13.83,1:03:16.50,Default,,0,0,0,,Сіз бұл адамның кім екенін айта аласыз.
Dialogue: 0,1:03:16.58,1:03:17.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:17.79,1:03:19.50,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,1:03:19.58,1:03:21.00,Default,,0,0,0,,Өткізгіш
Dialogue: 0,1:03:21.08,1:03:21.92,Default,,0,0,0,,Иә
Dialogue: 0,1:03:23.96,1:03:26.17,Default,,0,0,0,,Мен... мен күдікті адаммын ба?
Dialogue: 0,1:03:26.26,1:03:27.76,Default,,0,0,0,,Сіз кінәлісіз бе?
Dialogue: 0,1:03:27.84,1:03:28.67,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:03:28.76,1:03:31.89,Default,,0,0,0,,Кондуктордың көргені Е бөлмесінің есігі болды.
Dialogue: 0,1:03:31.97,1:03:34.64,Default,,0,0,0,,Оның алдындағы өз бейнем
Dialogue: 0,1:03:35.39,1:03:37.48,Default,,0,0,0,,Бұл айна.
Dialogue: 0,1:03:38.68,1:03:40.23,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,1:03:40.94,1:03:45.44,Default,,0,0,0,,Қылмыскер өз бөлмесінің есігінің ішкі жағына айна жапқан.
Dialogue: 0,1:03:45.53,1:03:49.78,Default,,0,0,0,,Кондукторды Деба мырза шақырып, Е бөлмесінің алдында болғанда.
Dialogue: 0,1:03:49.86,1:03:51.20,Default,,0,0,0,,Сол есікті ашыңыз
Dialogue: 0,1:03:51.28,1:03:54.70,Default,,0,0,0,,Мен В бөлмесінен шығып бара жатқанымды көрмеу үшін жасадым.
Dialogue: 0,1:03:54.78,1:03:58.29,Default,,0,0,0,,Бірақ...бірақ егер кінәлі сол кезде В бөлмесінде болса.
Dialogue: 0,1:03:58.37,1:04:00.71,Default,,0,0,0,,Бөлмеңіздің есігін қалай аштыңыз?
Dialogue: 0,1:04:00.79,1:04:03.29,Default,,0,0,0,,Есіктің тұтқасына балық аулау жіпін байлаңыз
Dialogue: 0,1:04:03.38,1:04:05.71,Default,,0,0,0,,Дәліздегі терезе қоршауынан өту.
Dialogue: 0,1:04:05.80,1:04:08.01,Default,,0,0,0,,Оны В бөлмесіне тартыңыз
Dialogue: 0,1:04:08.09,1:04:11.30,Default,,0,0,0,,Мен дұрыс сәтті көріп, оны аштым.
Dialogue: 0,1:04:12.30,1:04:13.47,Default,,0,0,0,,Иә
Dialogue: 0,1:04:13.55,1:04:17.97,Default,,0,0,0,,Бұл трюк айна алыс немесе жақын орналасқанын көрсетеді.
Dialogue: 0,1:04:18.06,1:04:22.44,Default,,0,0,0,,Содан кейін белгілі бір бөлмеде A B C D E.
Dialogue: 0,1:04:22.52,1:04:25.94,Default,,0,0,0,,С кабинасындағы жолаушы, дәл ортасында.
Dialogue: 0,1:04:26.02,1:04:29.57,Default,,0,0,0,,Андо мырза, мұны тек сіз жасай аласыз.
Dialogue: 0,1:04:29.65,1:04:31.11,Default,,0,0,0,,Уф...
Dialogue: 0,1:04:33.78,1:04:35.37,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,1:04:35.45,1:04:38.29,Default,,0,0,0,,Ай-чан, Конан-кун және әкесі
Dialogue: 0,1:04:38.37,1:04:40.75,Default,,0,0,0,,Сера мырзамен телефон арқылы байланыса алмаймын.
Dialogue: 0,1:04:41.37,1:04:42.58,Default,,0,0,0,,Не болды?
Dialogue: 0,1:04:42.67,1:04:44.25,Default,,0,0,0,,Хмм...
Dialogue: 0,1:04:44.83,1:04:46.96,Default,,0,0,0,,Мен күткендей, мен бірінші класты пойызға отырамын.
Dialogue: 0,1:04:47.04,1:04:48.88,Default,,0,0,0,,О, мынау... мынау
Dialogue: 0,1:04:48.96,1:04:52.38,Default,,0,0,0,,Олар дәл қазір жұмбақ шоудың ортасында жүрген сияқты.
Dialogue: 0,1:04:52.47,1:04:55.30,Default,,0,0,0,,Мен араласпаған дұрыс деп ойлаймын.
Dialogue: 0,1:04:55.97,1:04:57.93,Default,,0,0,0,,(деңгейден өту туралы ескерту дыбысы)
Dialogue: 0,1:05:00.39,1:05:02.27,Default,,0,0,0,,Әлде... айна ма?
Dialogue: 0,1:05:02.35,1:05:04.98,Default,,0,0,0,,Есікті жабуға жеткілікті үлкен айна
Dialogue: 0,1:05:05.06,1:05:08.19,Default,,0,0,0,,Мен оны бұл көлікке қалай отырғыздым?
Dialogue: 0,1:05:09.03,1:05:12.49,Default,,0,0,0,,Сол суретті бағалау сұралған.
Dialogue: 0,1:05:12.57,1:05:17.28,Default,,0,0,0,,Сол картинаның кенептерінің арасына үш айна ғана қойылса.
Dialogue: 0,1:05:17.37,1:05:19.70,Default,,0,0,0,,Бұл жерде есікті жапсақ болған сияқты.
Dialogue: 0,1:05:20.37,1:05:22.71,Default,,0,0,0,,Бұл сурет өте ауыр болды.
Dialogue: 0,1:05:22.79,1:05:25.46,Default,,0,0,0,,А... анау маңдай саф алтыннан...
Dialogue: 0,1:05:25.54,1:05:28.34,Default,,0,0,0,,No Рамка ағаштан жасалып, алтын жалатылған.
Dialogue: 0,1:05:28.42,1:05:29.25,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:30.25,1:05:31.71,Default,,0,0,0,,Сурет ауыррақ
Dialogue: 0,1:05:31.80,1:05:34.47,Default,,0,0,0,,Суреттің мазмұны мұғалім айтқандай...
Dialogue: 0,1:05:37.51,1:05:39.31,Default,,0,0,0,,Үш айна
Dialogue: 0,1:05:40.01,1:05:43.81,Default,,0,0,0,,Олардың біреуі есіктің түсімен бірдей боялғанын көргенде,
Dialogue: 0,1:05:44.52,1:05:47.81,Default,,0,0,0,,Сіз адамдарға оның айна екенін түсінбеудің жолын ойлап тапқан сияқтысыз.
Dialogue: 0,1:05:48.40,1:05:51.86,Default,,0,0,0,,Егер сіз оны сол күйінде қалдырсаңыз, Е бөлмесінің есігіндегі белгі болады
Dialogue: 0,1:05:51.94,1:05:53.82,Default,,0,0,0,,Ол айнадан көрінеді.
Dialogue: 0,1:05:55.11,1:05:57.03,Default,,0,0,0,,Кел, Андо-сан.
Dialogue: 0,1:05:57.11,1:06:00.83,Default,,0,0,0,,Осы үш айнаны қалай түсіндірер едің?
Dialogue: 0,1:06:03.41,1:06:07.04,Default,,0,0,0,,Мен оны бағалауға дейін отырғызылған нәрсе деп күткен жоқпын.
Dialogue: 0,1:06:07.12,1:06:09.46,Default,,0,0,0,,«Мен суреттің біртүрлі салмағын байқамадым.»
Dialogue: 0,1:06:09.54,1:06:11.34,Default,,0,0,0,,Өтінемін, олай айтпаңыз.
Dialogue: 0,1:06:11.42,1:06:12.84,Default,,0,0,0,,Кез келген нәрсе
Dialogue: 0,1:06:12.92,1:06:16.22,Default,,0,0,0,,Сізден суретті бағалауды сұраған клиенттен сұрауға болады.
Dialogue: 0,1:06:16.30,1:06:17.72,Default,,0,0,0,,Уф...
Dialogue: 0,1:06:17.80,1:06:21.72,Default,,0,0,0,,Сондай адам шынымен бар болса.
Dialogue: 0,1:06:38.61,1:06:41.08,Default,,0,0,0,,О, бұл көп емес пе?
Dialogue: 0,1:06:43.58,1:06:45.16,Default,,0,0,0,,Бұл менің сүйіктім болды.
Dialogue: 0,1:06:48.50,1:06:50.67,Default,,0,0,0,,Сол сандықта сақтаған көйлегім
Dialogue: 0,1:06:53.55,1:06:57.47,Default,,0,0,0,,Әй, сен неге мұны істемейсің?
Dialogue: 0,1:06:59.55,1:07:00.80,Default,,0,0,0,,Күтуім керек екен ғой?
Dialogue: 0,1:07:08.52,1:07:09.73,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,1:07:09.81,1:07:15.90,Default,,0,0,0,,Ол бала сізді, анасын бізбен ұрысқа тартатын.
Dialogue: 0,1:07:15.99,1:07:17.74,Default,,0,0,0,,Мен оны өзім сатып алдым.
Dialogue: 0,1:07:17.82,1:07:20.24,Default,,0,0,0,,Егер басқа адам күміс экранның жұлдызы болса
Dialogue: 0,1:07:20.32,1:07:24.33,Default,,0,0,0,,Олар мені, аты аңызға айналған жапон актрисасы ретінде қабылдауымды өтінді.
Dialogue: 0,1:07:24.99,1:07:26.91,Default,,0,0,0,,Бірақ бұл ұят.
Dialogue: 0,1:07:27.00,1:07:29.79,Default,,0,0,0,,Қартайған кезде де жарқырап тұратын макияжды қалай қолдануға болады
Dialogue: 0,1:07:29.87,1:07:32.54,Default,,0,0,0,,Мен оны бір күні үйренемін деп ойладым.
Dialogue: 0,1:07:32.63,1:07:36.84,Default,,0,0,0,,Ұлы актриса Шарон Винейард жасы үлкен болып көріну үшін жасанды.
Dialogue: 0,1:07:36.92,1:07:40.22,Default,,0,0,0,,О, бұл өте ауыр.
Dialogue: 0,1:07:40.30,1:07:43.10,Default,,0,0,0,,Сіз әдетте өзіңізді қартайғандай етіп көрсетесіз бе?
Dialogue: 0,1:07:43.18,1:07:47.10,Default,,0,0,0,,Одан да дәлізде бір-бірімізден өткенде айтқан сөздеріңіз
Dialogue: 0,1:07:47.89,1:07:50.39,Default,,0,0,0,,Егер біз сізден алдасақ
Dialogue: 0,1:07:50.48,1:07:53.61,Default,,0,0,0,,Сіз бұл жолы одан бас тартасыз, солай ма?
Dialogue: 0,1:07:54.19,1:07:56.11,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:07:56.19,1:07:58.11,Default,,0,0,0,,Бұл дәл айтқандарын білдіреді.
Dialogue: 0,1:07:58.69,1:08:02.45,Default,,0,0,0,,Арата-чан Ай Чанның бұл жақтан екенін айтады.
Dialogue: 0,1:08:02.53,1:08:05.08,Default,,0,0,0,,Хе, ақымақ.
Dialogue: 0,1:08:06.29,1:08:08.70,Default,,0,0,0,,Сіз одан құтыла аламын деп ойлайсыз ба?
Dialogue: 0,1:08:08.79,1:08:10.04,Default,,0,0,0,,Сен мақтаншақ жігітсің, Тодороки.
Dialogue: 0,1:08:10.12,1:08:12.75,Default,,0,0,0,,Қазіргі уақытта Шин Чанның командасы бір қадам алда.
Dialogue: 0,1:08:13.63,1:08:14.67,Default,,0,0,0,,Қорғасын?
Dialogue: 0,1:08:15.34,1:08:19.30,Default,,0,0,0,,Сенің бөлмеңде Сера есімді қыз есінен танып қалды.
Dialogue: 0,1:08:19.38,1:08:22.18,Default,,0,0,0,,Мен оны бұрынғы қызымның бөлмесіне апарып тастадым.
Dialogue: 0,1:08:22.26,1:08:25.72,Default,,0,0,0,,О, сен тез жұмыс істейсің.
Dialogue: 0,1:08:25.81,1:08:29.93,Default,,0,0,0,,Бірақ бұл біртүрлі. Бала қазір жұмбақ шоуда.
Dialogue: 0,1:08:30.02,1:08:32.06,Default,,0,0,0,,Қызық, басқа біреу көмектесе алады ма?
Dialogue: 0,1:08:32.65,1:08:35.11,Default,,0,0,0,,Келіңіздер ме? Мен білмеймін
Dialogue: 0,1:08:35.19,1:08:38.57,Default,,0,0,0,,Мұнда бізге арнайы қонақ келуі мүмкін.
Dialogue: 0,1:08:38.65,1:08:39.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:59.59,1:09:00.51,Default,,0,0,0,,Жасыру…
Dialogue: 0,1:09:02.51,1:09:04.93,Default,,0,0,0,,Жасыру…
Dialogue: 0,1:09:10.81,1:09:14.44,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:09:17.94,1:09:19.28,Default,,0,0,0,,Бірақ детектив
Dialogue: 0,1:09:19.36,1:09:22.11,Default,,0,0,0,,Сіздің пікіріңіз негізсіз деп ойлаймын.
Dialogue: 0,1:09:22.74,1:09:26.28,Default,,0,0,0,,Тізбекті құлыпқа тағы бір тізбек қосу оңай емес.
Dialogue: 0,1:09:27.03,1:09:29.79,Default,,0,0,0,,Менің бөлмемдегі шамның шамы жанып кеткен болуы керек.
Dialogue: 0,1:09:29.87,1:09:31.95,Default,,0,0,0,,Кондукторды бөлмеме шақыра алмаймын.
Dialogue: 0,1:09:32.54,1:09:34.58,Default,,0,0,0,,Мен кондукторды шақырдым
Dialogue: 0,1:09:34.67,1:09:38.88,Default,,0,0,0,,Кездейсоқ бөлмемде қалдырған сағатымның дабылы сөнді.
Dialogue: 0,1:09:38.96,1:09:42.51,Default,,0,0,0,,Кондуктор осылай деді.
Dialogue: 0,1:09:42.59,1:09:45.22,Default,,0,0,0,,Бір кондуктордың формасы жоқ.
Dialogue: 0,1:09:45.30,1:09:47.01,Default,,0,0,0,,Иә... иә
Dialogue: 0,1:09:47.60,1:09:50.60,Default,,0,0,0,,Қателік жіберген Андо мырза шығар.
Dialogue: 0,1:09:50.68,1:09:51.85,Default,,0,0,0,,А...
Dialogue: 0,1:09:51.93,1:09:52.85,Default,,0,0,0,,Сол форманы кию
Dialogue: 0,1:09:52.93,1:09:55.10,Default,,0,0,0,,Егер сіз отырғызу алдындағы инспекцияға жасырын кірсеңіз
Dialogue: 0,1:09:55.85,1:09:58.27,Default,,0,0,0,,Қылмыс орнындағы тізбекті құлыптау немесе
Dialogue: 0,1:09:58.36,1:10:02.11,Default,,0,0,0,,Ното мырзаның бөлмесіндегі шамның шамын да ауыстырдым.
Dialogue: 0,1:10:02.19,1:10:05.78,Default,,0,0,0,,Сондай-ақ сағатты Иземи мырзаның бөлмесіне тығып қоюға болады.
Dialogue: 0,1:10:06.53,1:10:10.58,Default,,0,0,0,,Сонымен қатар, Деба мырза дирижермен сөз таластырған кезде,
Dialogue: 0,1:10:10.66,1:10:12.49,Default,,0,0,0,,Қашықтан басқару пульті арқылы дабылды қайталаңыз
Dialogue: 0,1:10:12.58,1:10:14.54,Default,,0,0,0,,Егер сіз алаңдасаңыз
Dialogue: 0,1:10:14.62,1:10:16.96,Default,,0,0,0,,Андо мырза В бөлмесінде жасырынған.
Dialogue: 0,1:10:17.04,1:10:20.88,Default,,0,0,0,,С бөлмесінің айналы есігін қармақ жіппен ашсаңыз да.
Dialogue: 0,1:10:20.96,1:10:22.30,Default,,0,0,0,,Ол байқалмай қалады
Dialogue: 0,1:10:23.01,1:10:25.13,Default,,0,0,0,,Айнасы бар есіктің артында
Dialogue: 0,1:10:25.22,1:10:27.72,Default,,0,0,0,,В бөлмесінде тізбекті бекіткеннен кейін
Dialogue: 0,1:10:27.80,1:10:29.80,Default,,0,0,0,,Мен өз бөлмемнен жаңа шыққандай.
Dialogue: 0,1:10:29.89,1:10:31.60,Default,,0,0,0,,Есікті бірден жабыңыз
Dialogue: 0,1:10:31.68,1:10:34.18,Default,,0,0,0,,Деба-санға және басқаларға жақындасаңыз
Dialogue: 0,1:10:34.27,1:10:38.19,Default,,0,0,0,,Кондуктор барлық уақытта дәлізде болса да
Dialogue: 0,1:10:38.27,1:10:42.23,Default,,0,0,0,,Қылмыс орнына ешкімнің кіріп-шығуы байқалмаған жағдайлар бар.
Dialogue: 0,1:10:42.32,1:10:43.44,Default,,0,0,0,,Бұл мүмкін.
Dialogue: 0,1:10:44.36,1:10:48.16,Default,,0,0,0,,Өкінішке орай, мен айна есікті ашпас бұрын.
Dialogue: 0,1:10:48.24,1:10:50.57,Default,,0,0,0,,Комино-сан мен қызметші қыз дәлізден өтеді.
Dialogue: 0,1:10:50.66,1:10:53.62,Default,,0,0,0,,Балық аулау желісі байқалып қалу қаупі болды.
Dialogue: 0,1:10:53.70,1:10:57.00,Default,,0,0,0,,Туннельдің іші қараңғы болды, сондықтан олар оны өткізіп алған шығар.
Dialogue: 0,1:10:57.58,1:10:59.96,Default,,0,0,0,,Жоқ, мен оқиғаға араласқым келмейді.
Dialogue: 0,1:11:00.04,1:11:02.92,Default,,0,0,0,,Әдейі айтпаған сияқтымын.
Dialogue: 0,1:11:03.00,1:11:06.09,Default,,0,0,0,,Бірақ неге Андо мырза Мурохаши мырзаны таңдады...
Dialogue: 0,1:11:06.80,1:11:10.72,Default,,0,0,0,,Екеуіңіз бес жыл бұрын үлкен өрттен құтқарылған достар болдыңыз ба?
Dialogue: 0,1:11:10.80,1:11:14.72,Default,,0,0,0,,Иә, мен екі жыл бұрын осылай ойладым.
Dialogue: 0,1:11:15.22,1:11:16.68,Default,,0,0,0,,Кескіндеме аукционы
Dialogue: 0,1:11:16.77,1:11:20.56,Default,,0,0,0,,Сол өртте жойылды деген картина аукционға қойылғанға дейін.
Dialogue: 0,1:11:20.65,1:11:21.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:22.02,1:11:25.65,Default,,0,0,0,,Мен картинаның иесін іздегенімде,
Dialogue: 0,1:11:25.73,1:11:29.45,Default,,0,0,0,,Ақыры Мурохаши деген атқа жеттік.
Dialogue: 0,1:11:29.53,1:11:33.78,Default,,0,0,0,,Мен көремін. Мурохаши мырза суретті сарайдан ұрлап кеткен.
Dialogue: 0,1:11:33.87,1:11:37.25,Default,,0,0,0,,Осылайша сіз бұл фактіні жасыру үшін сарайды өртеп жібердіңіз.
Dialogue: 0,1:11:37.83,1:11:40.21,Default,,0,0,0,,Көптеген жәбірленушілерді тарту
Dialogue: 0,1:11:40.29,1:11:44.88,Default,,0,0,0,,Иә, егер ол кісі біз сияқты болса.
Dialogue: 0,1:11:44.96,1:11:49.13,Default,,0,0,0,,Өртте қаза болғандарға... Сол отбасын жоқтау үшін.
Dialogue: 0,1:11:49.22,1:11:53.43,Default,,0,0,0,,Егер сіз жыл сайын атқа мінетін болсаңыз, мен сізден өзіңізді тапсыруыңызды сұрар едім.
Dialogue: 0,1:11:53.51,1:11:58.02,Default,,0,0,0,,Бірақ жалған шегерім викторинасының құрбаны ретінде
Dialogue: 0,1:11:58.10,1:11:59.98,Default,,0,0,0,,Мен қылмыскердің рөлін ойнадым
Dialogue: 0,1:12:00.06,1:12:03.19,Default,,0,0,0,,Балалардың детектив ойнауын күту кезінде
Dialogue: 0,1:12:03.90,1:12:06.32,Default,,0,0,0,,Әлгі адам айтты
Dialogue: 0,1:12:07.07,1:12:09.70,Default,,0,0,0,,Мұндай нәрсе мені қатты толғандырады.
Dialogue: 0,1:12:09.78,1:12:12.24,Default,,0,0,0,,Сіз өзіңіздің тірі екеніңізді шынымен сезіне аласыз ба?
Dialogue: 0,1:12:12.32,1:12:15.58,Default,,0,0,0,,Мені түтіннен аздап құтқарған сол өрт.
Dialogue: 0,1:12:15.66,1:12:17.41,Default,,0,0,0,,Есіңде жоқ па?
Dialogue: 0,1:12:20.00,1:12:25.46,Default,,0,0,0,,Ер адамның екі беті қызарып, қуана айтты.
Dialogue: 0,1:12:25.54,1:12:30.30,Default,,0,0,0,,Менің әйелім сол өрттің түтінінде қайтыс болды.
Dialogue: 0,1:12:30.38,1:12:34.14,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,1:12:34.22,1:12:35.18,Default,,0,0,0,,Юкико
Dialogue: 0,1:12:35.80,1:12:38.60,Default,,0,0,0,,Сіз бізді түтінге сүйреп жібергіңіз келетін сияқты.
Dialogue: 0,1:12:38.68,1:12:40.18,Default,,0,0,0,,Балалар, сізде жеңіске жету мүмкіндігі бар...
Dialogue: 0,1:12:40.27,1:12:41.19,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:12:41.27,1:12:44.52,Default,,0,0,0,,Шин-чан болғандықтан, мен Шаронның әлсіз тұсын ұстадым.
Dialogue: 0,1:12:45.23,1:12:47.86,Default,,0,0,0,,Мүмкін сен менің досымсың
Dialogue: 0,1:12:47.94,1:12:49.36,Default,,0,0,0,,Сіз оны көтере алмайсыз дейсіз бе?
Dialogue: 0,1:12:49.44,1:12:52.03,Default,,0,0,0,,Шаронның серігі Сіз білмейсіз бе?
Dialogue: 0,1:12:52.86,1:12:56.16,Default,,0,0,0,,Арата-чан, бұл баланы есірткілер сәбиге айналдырып жатыр.
Dialogue: 0,1:12:57.74,1:13:03.17,Default,,0,0,0,,Егер сіз іздеуді бастауыш сынып оқушыларына тарылтсаңыз, оларды табу уақыт мәселесі.
Dialogue: 0,1:13:03.92,1:13:05.67,Default,,0,0,0,,Шин Чан осылай деді.
Dialogue: 0,1:13:06.38,1:13:09.59,Default,,0,0,0,,Медицина оны сәбиге айналдырғанын жасыруға негіз бар.
Dialogue: 0,1:13:09.67,1:13:12.30,Default,,0,0,0,,Мүмкін сізге бірдеңе бар шығар.
Dialogue: 0,1:13:14.59,1:13:16.97,Default,,0,0,0,,Юкико, солай.
Dialogue: 0,1:13:19.26,1:13:20.89,Default,,0,0,0,,Қолыңызды тартыңыз
Dialogue: 0,1:13:20.97,1:13:23.77,Default,,0,0,0,,Мен сіздің ақымақ стратегияңызды оқып шықтым.
Dialogue: 0,1:13:24.39,1:13:26.27,Default,,0,0,0,,Сонымен... стратегия? Не айтқың келеді?
Dialogue: 0,1:13:27.52,1:13:30.98,Default,,0,0,0,,Егер ол бізді пойызда байқаса
Dialogue: 0,1:13:31.07,1:13:33.82,Default,,0,0,0,,Оның бір ғана әрекеті бар.
Dialogue: 0,1:13:34.32,1:13:37.95,Default,,0,0,0,,Сол дәріге қарсы дәріні ішіп, бастапқы күйіңізге оралыңыз.
Dialogue: 0,1:13:38.78,1:13:41.87,Default,,0,0,0,,Мен нәрестелік күйімде өлтірілсем ше?
Dialogue: 0,1:13:41.95,1:13:44.71,Default,,0,0,0,,Көліктің ішінен мәйіт табылса
Dialogue: 0,1:13:44.79,1:13:47.71,Default,,0,0,0,,Анау балалар жылап, шу шығарып жатыр.
Dialogue: 0,1:13:47.79,1:13:50.59,Default,,0,0,0,,Осы кезде, егер ол өзінің бастапқы түріне оралса,
Dialogue: 0,1:13:51.38,1:13:53.72,Default,,0,0,0,,Мәйіт табылса да
Dialogue: 0,1:13:53.80,1:13:58.35,Default,,0,0,0,,Балалар бір-ақ рет кездескен әйелдің денесі.
Dialogue: 0,1:13:58.43,1:14:02.64,Default,,0,0,0,,Ол жоғалып кеткеннен бері мен оны көбірек уайымдадым, енді ол үшін алаңдамаймын.
Dialogue: 0,1:14:02.72,1:14:05.85,Default,,0,0,0,,Ұйымның назарынан тыс қалуы мүмкін
Dialogue: 0,1:14:05.94,1:14:09.11,Default,,0,0,0,,Жарайды, балаң, анау доктор Агаса.
Dialogue: 0,1:14:09.19,1:14:11.11,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,1:14:11.19,1:14:13.36,Default,,0,0,0,,Мен әйелдің денесі екеніне сене алмадым
Dialogue: 0,1:14:13.44,1:14:17.49,Default,,0,0,0,,Сәбиге айналғанға дейін ол сондай болды деп айта алмайсың.
Dialogue: 0,1:14:18.62,1:14:23.37,Default,,0,0,0,,Иә, сіз оның осылай жасайды деп күткен шығарсыз.
Dialogue: 0,1:14:23.45,1:14:25.62,Default,,0,0,0,,Дәрі қабылдамас бұрын оны қорғаңыз
Dialogue: 0,1:14:25.71,1:14:31.13,Default,,0,0,0,,Сіз өзіңіздің бұрынғы қызыңыздың кейпін киіп, біз өлтіргендей кейіптедіңіз.
Dialogue: 0,1:14:31.21,1:14:35.05,Default,,0,0,0,,Мүмкін бұл ұйымды алдау жоспары болған шығар.
Dialogue: 0,1:14:35.13,1:14:38.64,Default,,0,0,0,,Бұл оның сіздің бөлмеңізде жасырын емес екенін білдіре ме?
Dialogue: 0,1:14:38.72,1:14:42.56,Default,,0,0,0,,Біз оны әлі қорғай алмаған сияқтымыз.
Dialogue: 0,1:14:42.64,1:14:44.77,Default,,0,0,0,,Не... не айтып тұрсың?
Dialogue: 0,1:14:44.85,1:14:47.60,Default,,0,0,0,,Шарон бұрын терезеден лақтырып жіберген менің сандығым.
Dialogue: 0,1:14:47.69,1:14:48.98,Default,,0,0,0,,Эй... ішінде не бар екенін көрдіңіз бе?
Dialogue: 0,1:14:49.06,1:14:52.11,Default,,0,0,0,,Онда сізде бетперделеу құралдары болды ма?
Dialogue: 0,1:14:52.19,1:14:53.28,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,1:14:53.94,1:14:56.78,Default,,0,0,0,,Мен оларды жүксалғыштың алдында кәдеге жараттым.
Dialogue: 0,1:14:57.61,1:14:58.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:59.20,1:15:02.70,Default,,0,0,0,,Сондай-ақ, бұл раковинаның ішінде жасырылған маска бар.
Dialogue: 0,1:15:02.78,1:15:06.50,Default,,0,0,0,,Сондай-ақ қан трюкі бар оқ өтпейтін күртеше.
Dialogue: 0,1:15:06.58,1:15:09.63,Default,,0,0,0,,Бірақ... Бірақ егер Шарон оны да таппаса.
Dialogue: 0,1:15:09.71,1:15:11.04,Default,,0,0,0,,Бұл әлі 50/50 емес.
Dialogue: 0,1:15:11.13,1:15:14.46,Default,,0,0,0,,Мәселе жоқ Уайымдамаңыз
Dialogue: 0,1:15:14.55,1:15:18.47,Default,,0,0,0,,Мен оны әшкерелеуге дайынмын.
Dialogue: 0,1:15:20.80,1:15:22.30,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:15:29.31,1:15:31.31,Default,,0,0,0,,Андо мырза, қалғандары полиция.
Dialogue: 0,1:15:32.36,1:15:35.07,Default,,0,0,0,,Тоқта... күт, бұл не түтін?
Dialogue: 0,1:15:35.15,1:15:37.03,Default,,0,0,0,,- (Дирижер) А... - (Ното) Әй... Әй, болмайды.
Dialogue: 0,1:15:37.11,1:15:38.45,Default,,0,0,0,,Мен қарап көрейін.
Dialogue: 0,1:15:40.57,1:15:43.49,Default,,0,0,0,,Уа, өрт шықты... Өрт шықты.
Dialogue: 0,1:15:44.41,1:15:45.45,Default,,0,0,0,,Не!
Dialogue: 0,1:15:45.54,1:15:47.41,Default,,0,0,0,,Барлығыңыз, тез арада алдыңғы көлікке көшіңіздер!
Dialogue: 0,1:15:47.50,1:15:49.62,Default,,0,0,0,,(Барлығы дүрбелең)
Dialogue: 0,1:15:49.71,1:15:51.88,Default,,0,0,0,,- Ағай, ояныңыз! - (Когоро) А?
Dialogue: 0,1:15:51.96,1:15:53.59,Default,,0,0,0,,Әжелер де асығады
Dialogue: 0,1:15:53.67,1:15:54.67,Default,,0,0,0,,Иә... иә
Dialogue: 0,1:15:54.75,1:15:56.09,Default,,0,0,0,,Төтенше жағдайдағы байланыс
Dialogue: 0,1:15:56.17,1:15:59.80,Default,,0,0,0,,Жаңа ғана біздің пойыздың №8 вагонында өрт шықты.
Dialogue: 0,1:15:59.88,1:16:00.26,Default,,0,0,0,,Сақтық шарасы ретінде No7 және No6 вагондардағы тұтынушылар
Dialogue: 0,1:16:00.26,1:16:01.76,Default,,0,0,0,,Сақтық шарасы ретінде No7 және No6 вагондардағы тұтынушылар
Dialogue: 0,1:16:00.26,1:16:01.76,Default,,0,0,0,,- (Жүгіріп) Аа... - (Соноко) Өтірік
Dialogue: 0,1:16:01.76,1:16:01.84,Default,,0,0,0,,As a precaution, customers in cars No. 7 and No. 6
Dialogue: 0,1:16:01.84,1:16:02.30,Default,,0,0,0,,As a precaution, customers in cars No. 7 and No. 6
Dialogue: 0,1:16:01.84,1:16:02.30,Default,,0,0,0,,Немесе... өрт шықты!
Dialogue: 0,1:16:02.30,1:16:02.39,Default,,0,0,0,,Немесе... өрт шықты!
Dialogue: 0,1:16:02.39,1:16:03.26,Default,,0,0,0,,Немесе... өрт шықты!
Dialogue: 0,1:16:02.39,1:16:03.26,Default,,0,0,0,,Алдыңыздағы көлікке эвакуациялаңыз.
Dialogue: 0,1:16:03.26,1:16:04.26,Default,,0,0,0,,Please evacuate to the vehicle in front of you.
Dialogue: 0,1:16:04.35,1:16:04.76,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:16:04.76,1:16:05.35,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:16:04.76,1:16:05.35,Default,,0,0,0,,Бұл №6 көлік еді, солай ма?
Dialogue: 0,1:16:05.35,1:16:05.43,Default,,0,0,0,,Бұл №6 көлік еді, солай ма?
Dialogue: 0,1:16:05.43,1:16:06.31,Default,,0,0,0,,This was car No. 6, right?
Dialogue: 0,1:16:05.43,1:16:06.31,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,1:16:06.31,1:16:06.39,Default,,0,0,0,,Бұл №6 көлік еді, солай ма?
Dialogue: 0,1:16:06.39,1:16:07.35,Default,,0,0,0,,Бұл №6 көлік еді, солай ма?
Dialogue: 0,1:16:06.39,1:16:07.35,Default,,0,0,0,,Right now, in car No. 8 of our train.
Dialogue: 0,1:16:07.35,1:16:07.43,Default,,0,0,0,,Дәл қазір біздің пойыздың №8 вагонында.
Dialogue: 0,1:16:07.43,1:16:08.10,Default,,0,0,0,,Дәл қазір біздің пойыздың №8 вагонында.
Dialogue: 0,1:16:07.43,1:16:08.10,Default,,0,0,0,,- (Ayumi) Yeah - (Genta) Then we have to run away.
Dialogue: 0,1:16:08.10,1:16:08.18,Default,,0,0,0,,- (Ayumi) Yeah - (Genta) Then we have to run away.
Dialogue: 0,1:16:08.18,1:16:09.56,Default,,0,0,0,,- (Ayumi) Yeah - (Genta) Then we have to run away.
Dialogue: 0,1:16:08.18,1:16:09.56,Default,,0,0,0,,Өрт шықты
Dialogue: 0,1:16:09.64,1:16:13.11,Default,,0,0,0,,Mi... everyone, calm down, don't panic, it's okay.
Dialogue: 0,1:16:13.19,1:16:14.40,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:16:15.52,1:16:17.69,Default,,0,0,0,,Иә? Уау
Dialogue: 0,1:16:17.78,1:16:21.49,Default,,0,0,0,,(Voices of passengers running away)
Dialogue: 0,1:16:22.61,1:16:24.37,Default,,0,0,0,,Я, мен ойлағандай.
Dialogue: 0,1:16:24.45,1:16:27.95,Default,,0,0,0,,All passengers in car No. 8 have a fear of fire.
Dialogue: 0,1:16:28.04,1:16:30.96,Default,,0,0,0,,They're urging me on, and I'm in a big panic.
Dialogue: 0,1:16:31.04,1:16:31.87,Default,,0,0,0,,ұқсайды
Dialogue: 0,1:16:32.54,1:16:34.38,Default,,0,0,0,,Сұрақ осында
Dialogue: 0,1:16:34.46,1:16:37.38,Default,,0,0,0,,Where do you think she would go in this situation?
Dialogue: 0,1:16:37.46,1:16:39.97,Default,,0,0,0,,Well, you should run to the vehicle in front...
Dialogue: 0,1:16:40.05,1:16:41.05,Default,,0,0,0,,Иә
Dialogue: 0,1:16:41.68,1:16:46.22,Default,,0,0,0,,No, on the contrary, she probably...
Dialogue: 0,1:16:52.69,1:16:54.15,Default,,0,0,0,,(Шихоның ауыр тыныс алуы)
Dialogue: 0,1:16:54.23,1:16:57.86,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:17:02.99,1:17:05.16,Default,,0,0,0,,Хаха...
Dialogue: 0,1:17:05.24,1:17:09.08,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:17:09.16,1:17:11.37,Default,,0,0,0,,As expected of a Hell Angel's daughter.
Dialogue: 0,1:17:11.46,1:17:12.50,Default,,0,0,0,,Ha
Dialogue: 0,1:17:12.58,1:17:14.46,Default,,0,0,0,,They look very similar.
Dialogue: 0,1:17:18.88,1:17:20.42,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,1:17:22.67,1:17:26.72,Default,,0,0,0,,Bourbon This is my code name.
Dialogue: 0,1:17:29.81,1:17:32.31,Default,,0,0,0,,(Когороның жөтелі)
Dialogue: 0,1:17:32.39,1:17:34.39,Default,,0,0,0,,Иә? О, Моури-кун
Dialogue: 0,1:17:34.48,1:17:36.77,Default,,0,0,0,,Әке, Конан-кун мен Сера-сан ше?
Dialogue: 0,1:17:36.86,1:17:40.07,Default,,0,0,0,,А? I was with the boy with glasses until just now.
Dialogue: 0,1:17:40.15,1:17:44.24,Default,,0,0,0,,Ол қыз саған баяғыда келер еді.
Dialogue: 0,1:17:44.32,1:17:46.70,Default,,0,0,0,,- (Жүгіріп) Е! -(Sonoko) He hasn't come.
Dialogue: 0,1:17:46.78,1:17:49.45,Default,,0,0,0,,In that case, I got the wrong vehicle and wandered around somewhere...
Dialogue: 0,1:17:49.53,1:17:51.79,Default,,0,0,0,,Hey uncle, how about Ai-chan?
Dialogue: 0,1:17:51.87,1:17:53.50,Default,,0,0,0,,You went there, right?
Dialogue: 0,1:17:53.58,1:17:55.29,Default,,0,0,0,,Сіз Конанмен бірге емессіз бе?
Dialogue: 0,1:17:55.87,1:17:57.75,Default,,0,0,0,,Менімен бірге болмадыңыз ба?
Dialogue: 0,1:17:57.83,1:18:00.84,Default,,0,0,0,,Сондықтан мен ваннаға бардым, қайтып оралмадым.
Dialogue: 0,1:18:00.92,1:18:04.09,Default,,0,0,0,,Сонда оның алдындағы көлікке қашып кетуі керек емес пе еді?
Dialogue: 0,1:18:04.17,1:18:06.84,Default,,0,0,0,,Мен солай ойлап, іздедім, бірақ таба алмадым.
Dialogue: 0,1:18:06.93,1:18:10.35,Default,,0,0,0,,...Не деген ұятсыз бала.
Dialogue: 0,1:18:11.89,1:18:12.85,Default,,0,0,0,,Иә
Dialogue: 0,1:18:12.93,1:18:16.94,Default,,0,0,0,,Ол болса, ол өрт шыққан №8 вагонға қарай бет алды.
Dialogue: 0,1:18:17.02,1:18:21.48,Default,,0,0,0,,Осы отты дауылды біз оны әшкерелеу үшін тұзақ ретінде оқыңыз.
Dialogue: 0,1:18:21.57,1:18:24.28,Default,,0,0,0,,Алдыңыздағы көлікке жүгірсеңіз, түсіндім.
Dialogue: 0,1:18:24.36,1:18:28.12,Default,,0,0,0,,Балалар, сендер мені күтіп тұрдыңдар, сондықтан мен сендерден алдадым.
Dialogue: 0,1:18:28.20,1:18:29.62,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,1:18:30.41,1:18:34.75,Default,,0,0,0,,Оның достары да алдыңғы көлікті паналайды.
Dialogue: 0,1:18:34.83,1:18:38.04,Default,,0,0,0,,Менің өмірім нысанаға алынған осындай жерге барсам ше?
Dialogue: 0,1:18:38.13,1:18:40.13,Default,,0,0,0,,Ол тек кепіл зиянға айналуы мүмкін.
Dialogue: 0,1:18:40.21,1:18:44.17,Default,,0,0,0,,Сондықтан ол отқа қарай бет алуы керек.
Dialogue: 0,1:18:44.26,1:18:47.30,Default,,0,0,0,,Тіпті біз күтіп отырсақ та
Dialogue: 0,1:18:48.89,1:18:52.06,Default,,0,0,0,,Жалғыз өлтірілген жақсы деп ойла.
Dialogue: 0,1:18:55.14,1:18:56.94,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:18:57.02,1:18:57.85,Default,,0,0,0,,Телефон…
Dialogue: 0,1:19:00.36,1:19:03.48,Default,,0,0,0,,Ах... Шин-чан
Dialogue: 0,1:19:03.57,1:19:05.49,Default,,0,0,0,,Ах!Уф...
Dialogue: 0,1:19:05.57,1:19:07.86,Default,,0,0,0,,Эй Шин Чан, не болды?
Dialogue: 0,1:19:07.95,1:19:09.16,Default,,0,0,0,,Мама, сен жындысың.
Dialogue: 0,1:19:09.24,1:19:11.62,Default,,0,0,0,,Хайбара еш жерде жоқ.
Dialogue: 0,1:19:11.70,1:19:13.41,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:19:13.49,1:19:15.16,Default,,0,0,0,,Неге анаңа бармайсың?
Dialogue: 0,1:19:15.25,1:19:17.83,Default,,0,0,0,,Ол да мұнда келген жоқ.
Dialogue: 0,1:19:17.91,1:19:20.04,Default,,0,0,0,,Алдыңыздағы көлікті паналаған жоқсыз ба?
Dialogue: 0,1:19:20.63,1:19:23.92,Default,,0,0,0,,Көпшілікпен аралассаңыз, жасыру оңайырақ.
Dialogue: 0,1:19:24.00,1:19:26.38,Default,,0,0,0,,Ал, алдыңдағы көлікке барайық.
Dialogue: 0,1:19:26.47,1:19:28.59,Default,,0,0,0,,Ана, жоспарды орындап, жақсы орындаңыз.
Dialogue: 0,1:19:28.68,1:19:29.84,Default,,0,0,0,,Жарайды
Dialogue: 0,1:19:31.09,1:19:34.06,Default,,0,0,0,,Енді сіздің ұлыңыз алдыңғы көлікте.
Dialogue: 0,1:19:36.56,1:19:38.02,Default,,0,0,0,,Тору~!
Dialogue: 0,1:19:38.10,1:19:41.40,Default,,0,0,0,,Әріптесімнің электрондық хаты
Dialogue: 0,1:19:41.48,1:19:45.69,Default,,0,0,0,,Ой, кешіріңіз, мен оны №8 көліктен тауып алғанын естідім.
Dialogue: 0,1:19:48.11,1:19:50.78,Default,,0,0,0,,Біз жеңген сияқтымыз.
Dialogue: 0,1:19:52.24,1:19:53.58,Default,,0,0,0,,Бурбон
Dialogue: 0,1:19:53.66,1:19:56.79,Default,,0,0,0,,Бұл кодтық атау таныс естіледі ме?
Dialogue: 0,1:19:57.50,1:20:00.67,Default,,0,0,0,,Мен сіздің отбасыңызбен бұрын кездескенмін.
Dialogue: 0,1:20:00.75,1:20:02.75,Default,,0,0,0,,Иә, білемін.
Dialogue: 0,1:20:03.46,1:20:08.67,Default,,0,0,0,,Менің әпкемнің жігіті Дай Моробошимен бақталастықта болған ұйымның мүшесі.
Dialogue: 0,1:20:09.17,1:20:13.09,Default,,0,0,0,,Әпкеңнің айтуы бойынша олар бір-бірін жек көретін.
Dialogue: 0,1:20:13.18,1:20:18.10,Default,,0,0,0,,Иә, мен көргенімдей, бұл адам ФБР иті.
Dialogue: 0,1:20:18.85,1:20:20.23,Default,,0,0,0,,Ұйымға опасыздық жасағаннан кейін
Dialogue: 0,1:20:20.31,1:20:23.61,Default,,0,0,0,,Оның жойылғанына сену қиын.
Dialogue: 0,1:20:24.11,1:20:25.52,Default,,0,0,0,,Өзіңізді сол адам ретінде жасырыңыз
Dialogue: 0,1:20:26.11,1:20:27.78,Default,,0,0,0,,Қатысқан адамдардың айналасында біраз уақыт серуендеу
Dialogue: 0,1:20:27.86,1:20:30.03,Default,,0,0,0,,Мен реакцияны бақылап отырдым.
Dialogue: 0,1:20:30.86,1:20:32.57,Default,,0,0,0,,Сол кісіге рахмет
Dialogue: 0,1:20:32.66,1:20:35.49,Default,,0,0,0,,Мен оның шынымен өлгенін білдім.
Dialogue: 0,1:20:36.33,1:20:38.41,Default,,0,0,0,,Маған бетперде берген адам болды
Dialogue: 0,1:20:38.50,1:20:42.54,Default,,0,0,0,,Бұл жолы менің орныма құрбым әлгі адамның кейпін киіп алды.
Dialogue: 0,1:20:43.12,1:20:45.46,Default,,0,0,0,,Сіздің осында пайда болғаныңыз дегенді білдіреді
Dialogue: 0,1:20:46.21,1:20:49.46,Default,,0,0,0,,Бұл сізді қорқытуда өте тиімді болған сияқты.
Dialogue: 0,1:20:51.80,1:20:52.80,Default,,0,0,0,,Иә
Dialogue: 0,1:20:53.39,1:20:56.39,Default,,0,0,0,,Енді қолымызды жоғары көтеріп, қозғалайық.
Dialogue: 0,1:20:57.01,1:21:00.23,Default,,0,0,0,,No8 вагонның артындағы жүк вагонында
Dialogue: 0,1:21:05.56,1:21:09.44,Default,,0,0,0,,Белтри экспрессінің келуіне бір сағат қана қалды.
Dialogue: 0,1:21:09.53,1:21:12.65,Default,,0,0,0,,Барлығыңыз сақ болыңыздар.
Dialogue: 0,1:21:12.74,1:21:14.16,Default,,0,0,0,,Олар ақымақ.
Dialogue: 0,1:21:14.24,1:21:16.45,Default,,0,0,0,,Пойыз келе салысымен
Dialogue: 0,1:21:16.53,1:21:20.45,Default,,0,0,0,,Мен платформаға қойған бомбаның оны жарып жіберетінін білмедім.
Dialogue: 0,1:21:21.08,1:21:23.83,Default,,0,0,0,,Вермут және Бурбон
Dialogue: 0,1:21:23.92,1:21:26.13,Default,,0,0,0,,Пойыздан қалай құтыласыз?
Dialogue: 0,1:21:26.21,1:21:28.88,Default,,0,0,0,,Сіз жарылыс туралы білесіз бе?
Dialogue: 0,1:21:28.96,1:21:31.72,Default,,0,0,0,,Әй, мен не білдім?
Dialogue: 0,1:21:31.80,1:21:35.09,Default,,0,0,0,,Иә, бірақ Вермут бұл туралы сұрады.
Dialogue: 0,1:21:35.18,1:21:37.55,Default,,0,0,0,,Егер сізде қалған бомбалар болса, менімен бөлісіңіз.
Dialogue: 0,1:21:37.64,1:21:39.01,Default,,0,0,0,,Не?
Dialogue: 0,1:21:39.10,1:21:43.48,Default,,0,0,0,,Мен не үшін қолданылатынын сұрадым, бірақ мен абдырап қалдым.
Dialogue: 0,1:21:45.73,1:21:48.15,Default,,0,0,0,,Әлгі әйел...
Dialogue: 0,1:21:49.52,1:21:51.65,Default,,0,0,0,,Енді сол есікті ашыңыз да, ішке кіріңіз.
Dialogue: 0,1:21:54.99,1:21:56.95,Default,,0,0,0,,(Идзуми) Уау! Бұл өте қызықты естіледі.
Dialogue: 0,1:21:57.03,1:22:00.58,Default,,0,0,0,,Мен сізді ұйымға тірідей қайтарғым келеді.
Dialogue: 0,1:22:01.24,1:22:03.91,Default,,0,0,0,,Қосылатын бөлікті жою үшін осы бомбаны пайдаланыңыз.
Dialogue: 0,1:22:04.00,1:22:07.33,Default,,0,0,0,,Жүк вагонын және ол тоқтаған бойда бөліңіз
Dialogue: 0,1:22:07.42,1:22:11.34,Default,,0,0,0,,Менің достарым сені алып кетпекші.
Dialogue: 0,1:22:11.42,1:22:15.97,Default,,0,0,0,,Осы арада мен сенен аздап есіңді түсіруіңді өтінемін.
Dialogue: 0,1:22:17.80,1:22:20.01,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:22:20.10,1:22:22.72,Default,,0,0,0,,Мен сенен есіктен алыс жатуыңды сұраймын.
Dialogue: 0,1:22:22.81,1:22:24.85,Default,,0,0,0,,Жарылысқа ұшырадым деп уайымдамаңыз...
Dialogue: 0,1:22:24.93,1:22:27.19,Default,,0,0,0,,- (Шихо) Жақсы емес сияқты - (Амуро) А?
Dialogue: 0,1:22:27.27,1:22:31.15,Default,,0,0,0,,Мына жүк вагонының ішінде бомба бар сияқты.
Dialogue: 0,1:22:31.23,1:22:32.19,Default,,0,0,0,,Ах
Dialogue: 0,1:22:32.28,1:22:35.45,Default,,0,0,0,,Аранжировкада қате болған сияқты.
Dialogue: 0,1:22:36.53,1:22:37.91,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:22:37.99,1:22:39.32,Default,,0,0,0,,Вермут - міндетті түрде
Dialogue: 0,1:22:39.41,1:22:42.29,Default,,0,0,0,,Сіз оның өмірін аяқтауды жоспарлап отырсыз ба?
Dialogue: 0,1:22:43.04,1:22:44.08,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,1:22:44.70,1:22:46.83,Default,,0,0,0,,Менімен бірге келгің келе ме?
Dialogue: 0,1:22:46.92,1:22:48.83,Default,,0,0,0,,Кешіріңіз, бірақ мен бас тартамын.
Dialogue: 0,1:22:49.33,1:22:53.21,Default,,0,0,0,,Әй, өсек айтатындай қиналған қыз екен.
Dialogue: 0,1:22:53.30,1:22:56.26,Default,,0,0,0,,Мен саған сәл дөрекі боламын.
Dialogue: 0,1:22:56.34,1:22:57.22,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:22:59.64,1:23:00.80,Default,,0,0,0,,Вермут?
Dialogue: 0,1:23:00.89,1:23:01.89,Default,,0,0,0,,Кешіріңіз, бірақ мен оны алдым...
Dialogue: 0,1:23:01.89,1:23:02.72,Default,,0,0,0,,Кешіріңіз, бірақ мен оны алдым...
Dialogue: 0,1:23:01.89,1:23:02.72,Default,,0,0,0,,(шу)
Dialogue: 0,1:23:02.81,1:23:03.64,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:23:03.72,1:23:06.14,Default,,0,0,0,,(шу)
Dialogue: 0,1:23:06.23,1:23:08.35,Default,,0,0,0,,Ха... граната!
Dialogue: 0,1:23:08.44,1:23:09.27,Default,,0,0,0,,Бұл кім?
Dialogue: 0,1:23:09.85,1:23:10.94,Default,,0,0,0,,Сіз кімсіз!
Dialogue: 0,1:23:16.90,1:23:18.11,Default,,0,0,0,,Ку… шіркін.
Dialogue: 0,1:23:31.50,1:23:32.79,Default,,0,0,0,,Иә
Dialogue: 0,1:23:32.88,1:23:34.34,Default,,0,0,0,,Бұл соңы
Dialogue: 0,1:23:34.42,1:23:36.55,Default,,0,0,0,,Өтірік! Бұл өтірік, солай ма?
Dialogue: 0,1:23:36.63,1:23:37.63,Default,,0,0,0,,Қорықпа.
Dialogue: 0,1:23:38.17,1:23:41.43,Default,,0,0,0,,Мен жолдастарымның байланысты бұзған дыбысын естігеннен кейін.
Dialogue: 0,1:23:41.51,1:23:42.55,Default,,0,0,0,,Өйткені ол жарылды
Dialogue: 0,1:23:42.64,1:23:45.47,Default,,0,0,0,,Бұл пойыз ешқашан рельстен шығып кетпейді.
Dialogue: 0,1:23:45.56,1:23:46.56,Default,,0,0,0,,Ай-чан
Dialogue: 0,1:23:50.35,1:23:53.77,Default,,0,0,0,,Ай-чан!
Dialogue: 0,1:23:57.90,1:23:59.78,Default,,0,0,0,,Сіз Шерриді ойнадыңыз ба?
Dialogue: 0,1:23:59.86,1:24:02.45,Default,,0,0,0,,Мен Вермут екеніне сенімдімін
Dialogue: 0,1:24:02.53,1:24:05.12,Default,,0,0,0,,Иә, бүкіл жүк вагоны ұшып кетті.
Dialogue: 0,1:24:05.20,1:24:07.08,Default,,0,0,0,,Бурбон қарап тұрған сияқты.
Dialogue: 0,1:24:07.66,1:24:10.67,Default,,0,0,0,,Сіздің арқаңызда пойыз жақын маңдағы станцияға тоқтады.
Dialogue: 0,1:24:10.75,1:24:13.54,Default,,0,0,0,,Барлық жолаушылар сұралатын сияқты.
Dialogue: 0,1:24:14.13,1:24:15.38,Default,,0,0,0,,Минерва біз үшін осындай қауіпсіз орын дайындап қойған еді
Dialogue: 0,1:24:15.46,1:24:18.01,Default,,0,0,0,,Мен Нагояда күтемін, себебі мен сені көре алмаймын
Dialogue: 0,1:24:18.09,1:24:21.55,Default,,0,0,0,,Хмф, егер көлік ішінде жарылыс болса.
Dialogue: 0,1:24:21.63,1:24:23.76,Default,,0,0,0,,Пойызды тоқтатудан басқа амалымыз жоқ.
Dialogue: 0,1:24:23.85,1:24:24.68,Default,,0,0,0,,Иә
Dialogue: 0,1:24:25.43,1:24:28.93,Default,,0,0,0,,Шеридің жарылуы жеткілікті.
Dialogue: 0,1:24:29.02,1:24:30.81,Default,,0,0,0,,Ах, көңілім қалды.
Dialogue: 0,1:24:30.89,1:24:34.27,Default,,0,0,0,,Енді Кид мырза келе алмайды.
Dialogue: 0,1:24:34.36,1:24:37.57,Default,,0,0,0,,Бұл пойызды әзірге жергілікті жерде тексеруге байланысты пайдалану мүмкін емес.
Dialogue: 0,1:24:38.15,1:24:39.11,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:24:39.19,1:24:42.70,Default,,0,0,0,,Нашар жаман Бірдеңе болған сияқты.
Dialogue: 0,1:24:43.49,1:24:46.12,Default,,0,0,0,,Мен оны серіктес деп ешқашан ойламаппын...
Dialogue: 0,1:24:48.12,1:24:49.58,Default,,0,0,0,,Мені тыңдама
Dialogue: 0,1:24:49.66,1:24:51.79,Default,,0,0,0,,Бұл қауіпті адамдар қандай?
Dialogue: 0,1:24:52.37,1:24:54.88,Default,,0,0,0,,Мен дельтапланды жүк көлігіне тығып қоймасам ше?
Dialogue: 0,1:24:54.96,1:24:56.84,Default,,0,0,0,,Ол қазір жанып кетті.
Dialogue: 0,1:24:56.92,1:24:59.71,Default,,0,0,0,,Бұл сіз туралы болғандықтан, сіз осындай нәрсе дайындағансыз деп үміттенемін.
Dialogue: 0,1:24:59.80,1:25:02.80,Default,,0,0,0,,Сонымен, несие беру және қарыз алу тегін.
Dialogue: 0,1:25:02.88,1:25:04.30,Default,,0,0,0,,Бұл болжам.
Dialogue: 0,1:25:04.39,1:25:06.05,Default,,0,0,0,,Әй, ұялы телефон.
Dialogue: 0,1:25:06.14,1:25:08.56,Default,,0,0,0,,Мені детективтік агенттікке қайтаруыңызды өтінемін.
Dialogue: 0,1:25:08.64,1:25:09.93,Default,,0,0,0,,На... (Қоңыраудың дыбысы ажыратылады)
Dialogue: 0,1:25:10.02,1:25:11.35,Default,,0,0,0,,Эй!
Dialogue: 0,1:25:12.14,1:25:14.48,Default,,0,0,0,,Әлгі қарғыс атқыр бала...
Dialogue: 0,1:25:14.56,1:25:18.19,Default,,0,0,0,,Кемпірлер - «Қиял ұры бала» және оның нөкерлері.
Dialogue: 0,1:25:19.03,1:25:20.69,Default,,0,0,0,,Қандай әзіл айтып тұрсың?
Dialogue: 0,1:25:20.78,1:25:24.57,Default,,0,0,0,,Қызметші Сумитомо мырза – бала, ал кемпір – бағынышты.
Dialogue: 0,1:25:24.66,1:25:27.99,Default,,0,0,0,,Күткендей, Комино-санның дауысын бағыныштылар естімейтін сияқты.
Dialogue: 0,1:25:28.08,1:25:32.41,Default,,0,0,0,,Баланың вентрилогист дауысына ерін синхрондау
Dialogue: 0,1:25:32.50,1:25:36.00,Default,,0,0,0,,Қалпақтың жамылғысы көруді қиындатқан сияқты.
Dialogue: 0,1:25:36.08,1:25:37.84,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:25:37.92,1:25:40.38,Default,,0,0,0,,Сондықтан сен мені дәлізге жүгіріп жібердің.
Dialogue: 0,1:25:40.46,1:25:41.88,Default,,0,0,0,,О
Dialogue: 0,1:25:41.97,1:25:43.84,Default,,0,0,0,,Кемпірді жалғыз қалдырсаң
Dialogue: 0,1:25:43.93,1:25:45.89,Default,,0,0,0,,Мен сөйлей алмаймын деп ойладым.
Dialogue: 0,1:25:45.97,1:25:49.31,Default,,0,0,0,,Сондай-ақ мысалдағы өрттен құтқарылған адамдар
Dialogue: 0,1:25:49.39,1:25:51.27,Default,,0,0,0,,Барлығы оттан қорқады
Dialogue: 0,1:25:51.35,1:25:52.39,Default,,0,0,0,,Сол кезде әже
Dialogue: 0,1:25:52.48,1:25:55.02,Default,,0,0,0,,Кісеруді еш ойланбастан отқа жағып жіберді.
Dialogue: 0,1:25:55.69,1:25:57.77,Default,,0,0,0,,Ал, рахмет.
Dialogue: 0,1:25:57.86,1:25:59.48,Default,,0,0,0,,Мен оқиғаға араласқым келмейді.
Dialogue: 0,1:25:59.57,1:26:01.44,Default,,0,0,0,,Сіз ештеңе көрмедім дейсіз.
Dialogue: 0,1:26:01.53,1:26:02.99,Default,,0,0,0,,Мен оны сағындым.
Dialogue: 0,1:26:03.07,1:26:06.41,Default,,0,0,0,,Сонда маған жақсылығыңызды сатып, не істемексіз?
Dialogue: 0,1:26:07.20,1:26:08.83,Default,,0,0,0,,Өзіңізді осы қыз ретінде жасырыңыз.
Dialogue: 0,1:26:08.91,1:26:11.70,Default,,0,0,0,,Мен сенің зұлымдардың қууынан сәтті құтылғаныңды қалаймын.
Dialogue: 0,1:26:11.79,1:26:12.87,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:12.95,1:26:14.75,Default,,0,0,0,,Олармен не туралы сөйлесесің?
Dialogue: 0,1:26:14.83,1:26:18.17,Default,,0,0,0,,Ол сізге басқа бөлмеден құлаққап арқылы айтып береді.
Dialogue: 0,1:26:18.25,1:26:20.92,Default,,0,0,0,,Мұның мәні неде?
Dialogue: 0,1:26:21.00,1:26:24.42,Default,,0,0,0,,Мен саған мынаны беремін, детектив.
Dialogue: 0,1:26:27.93,1:26:29.80,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:26:29.89,1:26:33.35,Default,,0,0,0,,Бұл ең жақсы кастинг болды.
Dialogue: 0,1:26:33.98,1:26:35.18,Default,,0,0,0,,Юкико...
Dialogue: 0,1:26:35.27,1:26:36.98,Default,,0,0,0,,Бірақ мен шынымен таң қалдым.
Dialogue: 0,1:26:37.06,1:26:40.73,Default,,0,0,0,,Хайбара мырза №7 вагонның В бөлмесінде болған.
Dialogue: 0,1:26:40.82,1:26:44.99,Default,,0,0,0,,Қазір ол қорқып, дірілдеп тұр
Dialogue: 0,1:26:46.03,1:26:48.41,Default,,0,0,0,,Мен сене бастадым
Dialogue: 0,1:26:48.49,1:26:52.62,Default,,0,0,0,,Тыныш, сіз шаршағандықтан ұйықтап жатқан сияқтысыз.
Dialogue: 0,1:26:53.12,1:26:55.25,Default,,0,0,0,,Маңызды нәрсе
Dialogue: 0,1:26:58.17,1:26:59.75,Default,,0,0,0,,Достар
Dialogue: 0,1:27:03.71,1:27:08.72,Default,,0,0,0,,♪～
Dialogue: 0,1:28:29.22,1:28:34.22,Default,,0,0,0,,～♪
Dialogue: 0,1:28:35.93,1:28:38.47,Default,,0,0,0,,(Агасаның гуілдеуі)
Dialogue: 0,1:28:40.35,1:28:42.23,Default,,0,0,0,,Жоқ, доктор.
Dialogue: 0,1:28:42.31,1:28:44.31,Default,,0,0,0,,- (Ағаса) жұлқа - (Хайбара) қазірдің өзінде
Dialogue: 0,1:28:44.40,1:28:46.52,Default,,0,0,0,,Бұл метаболикалық синдром, сондықтан бір ғана нәрсе бар.
Dialogue: 0,1:28:46.61,1:28:51.40,Default,,0,0,0,,Гёе~ Айкун қатал.
Dialogue: 0,1:28:56.24,1:29:00.58,Default,,0,0,0,,Мен сенің жүзіңді қайта көремін деп ойламаппын.
Dialogue: 0,1:29:02.08,1:29:03.46,Default,,0,0,0,,Шерри
Dialogue: 0,1:29:04.96,1:29:10.96,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory