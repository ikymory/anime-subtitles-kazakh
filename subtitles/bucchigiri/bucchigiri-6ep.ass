Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.79,0:00:07.04,Default,,0,0,0,,Уаааааааааааааааааааа!
Dialogue: 0,0:00:07.13,0:00:08.71,Default,,0,0,0,,Не! Буу!
Dialogue: 0,0:00:09.34,0:00:10.17,Default,,0,0,0,,Эй!
Dialogue: 0,0:00:12.13,0:00:13.17,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:00:19.01,0:00:21.18,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:00:24.52,0:00:27.77,Default,,0,0,0,,Ууууууууууууууууууу!
Dialogue: 0,0:00:27.86,0:00:30.53,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:00:30.61,0:00:34.53,Default,,0,0,0,,Чиаааааа! (Кеничиро) Охххх!
Dialogue: 0,0:00:35.36,0:00:36.28,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:00:36.36,0:00:39.03,Default,,0,0,0,,(Ұжымдық ұрыс айқайы)
Dialogue: 0,0:00:43.37,0:00:46.00,Default,,0,0,0,,(Ұрыс дауыстары)
Dialogue: 0,0:00:47.04,0:00:48.08,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:48.17,0:00:51.46,Default,,0,0,0,,басталды...!
Dialogue: 0,0:00:51.55,0:00:53.55,Default,,0,0,0,,Уолла Уолла Васшои
Dialogue: 0,0:00:53.63,0:00:57.97,Default,,0,0,0,,Сенсор сүйкімді! Бучигири~!
Dialogue: 0,0:00:58.05,0:01:01.56,Default,,0,0,0,,♪～
Dialogue: 0,0:02:20.76,0:02:25.68,Default,,0,0,0,,～♪
Dialogue: 0,0:02:28.64,0:02:30.44,Default,,0,0,0,,Уау! (Кеничиро) Нуууу~!
Dialogue: 0,0:02:30.52,0:02:31.94,Default,,0,0,0,,Қарғыс атсын! (Кенитиро) Ха!
Dialogue: 0,0:02:32.02,0:02:34.69,Default,,0,0,0,,Ааа...! (Кенитиро) Арх...!
Dialogue: 0,0:02:37.78,0:02:39.20,Default,,0,0,0,,Тейя (Кеничиро) Хамф
Dialogue: 0,0:02:39.28,0:02:40.53,Default,,0,0,0,,Ха, гаа (Кеничиро) Гуаааа
Dialogue: 0,0:02:40.61,0:02:41.45,Default,,0,0,0,,Сәлем! (Кенитиро) Ха!
Dialogue: 0,0:02:45.49,0:02:49.29,Default,,0,0,0,,Ойланып қарасаңыз, бәрі сол кезде басталған...
Dialogue: 0,0:02:51.96,0:02:54.13,Default,,0,0,0,,Эй, мына жігіттер...
Dialogue: 0,0:02:54.21,0:02:57.38,Default,,0,0,0,,Бұл Хонки Таундағы барлық орта мектептерді жаулап алған Құдай Патшалары!
Dialogue: 0,0:02:57.46,0:02:59.72,Default,,0,0,0,,Эй, мен қайда баруым керек?
Dialogue: 0,0:02:59.80,0:03:01.43,Default,,0,0,0,,Не?
Dialogue: 0,0:03:01.51,0:03:04.64,Default,,0,0,0,,Менің ойымша, бұл Минатокай немесе Икки Ренго болуды шешті.
Dialogue: 0,0:03:05.39,0:03:07.64,Default,,0,0,0,,Бәрібір қызықсыз.
Dialogue: 0,0:03:10.64,0:03:11.85,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:03:13.35,0:03:15.69,Default,,0,0,0,,Гор!
Dialogue: 0,0:03:16.44,0:03:17.32,Default,,0,0,0,,Oh?
Dialogue: 0,0:03:18.07,0:03:19.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:19.28,0:03:21.36,Default,,0,0,0,,Сіз Құдай Патшаларысыз ба?
Dialogue: 0,0:03:21.45,0:03:24.20,Default,,0,0,0,,Мм, орта мектепте атақты болған сияқты.
Dialogue: 0,0:03:24.28,0:03:24.95,Default,,0,0,0,,Бұл жерде болмайды...
Dialogue: 0,0:03:24.95,0:03:26.33,Default,,0,0,0,,Бұл жерде жұмыс істемейді...
Dialogue: 0,0:03:24.95,0:03:26.33,Default,,0,0,0,,Эй, тоқта...
Dialogue: 0,0:03:26.33,0:03:28.04,Default,,0,0,0,,Бұл жерде болмайды...
Dialogue: 0,0:03:29.08,0:03:30.33,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:03:30.41,0:03:32.79,Default,,0,0,0,,(Маритоның есінеу)
Dialogue: 0,0:03:32.87,0:03:34.00,Default,,0,0,0,,Аһ!
Dialogue: 0,0:03:36.67,0:03:37.84,Default,,0,0,0,,Марито жігіті
Dialogue: 0,0:03:37.92,0:03:42.80,Default,,0,0,0,,Кіші орта мектепте шыңды бағындырғалы бері мен ойымды жоғалттым.
Dialogue: 0,0:03:43.38,0:03:48.51,Default,,0,0,0,,Бірақ бұл жерде сізді қыздыра алатын біреу болуы керек.
Dialogue: 0,0:03:48.60,0:03:49.43,Default,,0,0,0,,(Иықтың ұсталған дыбысы)
Dialogue: 0,0:03:50.10,0:03:50.93,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:54.77,0:03:57.07,Default,,0,0,0,,Ичики одағына қосылыңыз!
Dialogue: 0,0:03:57.98,0:03:58.82,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:03:58.90,0:04:01.57,Default,,0,0,0,,Ота Меши~
Dialogue: 0,0:04:02.57,0:04:03.70,Default,,0,0,0,,Асығыңыз!тез!
Dialogue: 0,0:04:03.78,0:04:05.70,Default,,0,0,0,,Қайда бара жатырсың? (Марито) Хмм...
Dialogue: 0,0:04:05.78,0:04:08.33,Default,,0,0,0,,Менің президентім мен Минатоның басы байланған...
Dialogue: 0,0:04:08.33,0:04:08.87,Default,,0,0,0,,Менің президентім мен Минатоның басы байланған...
Dialogue: 0,0:04:08.33,0:04:08.87,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:08.87,0:04:08.95,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:08.95,0:04:11.70,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:08.95,0:04:11.70,Default,,0,0,0,,Ах! Шүкір, басталды!
Dialogue: 0,0:04:12.79,0:04:15.96,Default,,0,0,0,,Ичики одағының президенті Арашио Шиба
Dialogue: 0,0:04:16.54,0:04:20.34,Default,,0,0,0,,Кеничиро Доман Мен сені бүгін жеңемін!
Dialogue: 0,0:04:20.42,0:04:22.34,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:22.42,0:04:24.34,Default,,0,0,0,,Керемет!
Dialogue: 0,0:04:25.39,0:04:27.85,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:04:27.93,0:04:29.35,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:04:29.43,0:04:30.64,Default,,0,0,0,,Буха!
Dialogue: 0,0:04:31.18,0:04:32.60,Default,,0,0,0,,Ооо~
Dialogue: 0,0:04:42.15,0:04:44.57,Default,,0,0,0,,Бұл Минатоның әлемі!
Dialogue: 0,0:04:44.65,0:04:45.78,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:45.86,0:04:46.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:46.78,0:04:47.95,Default,,0,0,0,,Марито?
Dialogue: 0,0:04:54.33,0:04:55.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:55.29,0:04:56.37,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:57.96,0:04:59.13,Default,,0,0,0,,Менің атым Джоэстар. Өмірімді сақтап қалғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,0:04:59.21,0:05:00.38,Default,,0,0,0,,Фуууууу...!
Dialogue: 0,0:05:01.92,0:05:02.84,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:05:02.92,0:05:03.76,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:05:05.17,0:05:06.01,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:05:10.05,0:05:14.02,Default,,0,0,0,,Бұл жақсы, бұл жақсы! Жасай бер, қария!
Dialogue: 0,0:05:15.14,0:05:17.85,Default,,0,0,0,,Біз Отоишиден ақпарат алу үстіндеміз.
Dialogue: 0,0:05:19.06,0:05:23.99,Default,,0,0,0,,А? Иә, ол жігіт~
Dialogue: 0,0:05:26.61,0:05:29.78,Default,,0,0,0,,Мен жеңілдім, Шиба-сан да бітіреді...
Dialogue: 0,0:05:29.87,0:05:33.29,Default,,0,0,0,,Біз Доманмен бәсекелесе алмаймыз!
Dialogue: 0,0:05:33.37,0:05:34.50,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:05:35.04,0:05:37.29,Default,,0,0,0,,Ичики президенті бол!
Dialogue: 0,0:05:37.37,0:05:41.04,Default,,0,0,0,,Анау қарт, таймерді неге ала алмайды?
Dialogue: 0,0:05:41.13,0:05:44.84,Default,,0,0,0,,Доман адамдармен тек сенімді күреседі.
Dialogue: 0,0:05:44.92,0:05:47.05,Default,,0,0,0,,Тәкаппарлық, достары үшін т.б.
Dialogue: 0,0:05:47.13,0:05:49.43,Default,,0,0,0,,Мен Ичики президенті болсам, міндетті түрде қабылдаймын!
Dialogue: 0,0:05:49.51,0:05:50.89,Default,,0,0,0,,Сонымен! Не!
Dialogue: 0,0:05:50.97,0:05:54.47,Default,,0,0,0,,Е, қандай қиыншылық.
Dialogue: 0,0:05:54.56,0:05:56.06,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:00.15,0:06:01.77,Default,,0,0,0,,Не болды! (Минатокай) Сен кімсің!
Dialogue: 0,0:06:01.86,0:06:03.07,Default,,0,0,0,,Аһ!
Dialogue: 0,0:06:05.53,0:06:07.61,Default,,0,0,0,,Мен Даи патшамын
Dialogue: 0,0:06:07.70,0:06:10.70,Default,,0,0,0,,Бүгіннен бастап мен Ичики президенті қызметін атқарамын.
Dialogue: 0,0:06:11.53,0:06:14.20,Default,,0,0,0,,Мен сізбен байланысқа түсуге өтініш білдіремін!
Dialogue: 0,0:06:14.95,0:06:16.20,Default,,0,0,0,,Нуу…
Dialogue: 0,0:06:20.92,0:06:22.54,Default,,0,0,0,,Доман - көшбасшы!
Dialogue: 0,0:06:22.63,0:06:25.59,Default,,0,0,0,,Қарсылас Құдай Патшаларының жартысы!
Dialogue: 0,0:06:26.88,0:06:28.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:28.17,0:06:30.09,Default,,0,0,0,,Хаха...
Dialogue: 0,0:06:31.22,0:06:32.85,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:06:34.68,0:06:35.85,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:38.56,0:06:40.31,Default,,0,0,0,,Уф! Гах...
Dialogue: 0,0:06:43.86,0:06:45.98,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:06:50.07,0:06:51.07,Default,,0,0,0,,Тай патша!
Dialogue: 0,0:06:54.16,0:06:57.79,Default,,0,0,0,,Өтінемін, Марито...!
Dialogue: 0,0:06:59.37,0:07:01.37,Default,,0,0,0,,Қарғыс атсын, Ота.
Dialogue: 0,0:07:01.46,0:07:04.79,Default,,0,0,0,,Анау қарт, сен оған мотивация бересің ғой, солай ма?
Dialogue: 0,0:07:04.88,0:07:06.67,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:07:07.67,0:07:10.93,Default,,0,0,0,,Сенім маңызды емес.
Dialogue: 0,0:07:11.01,0:07:13.85,Default,,0,0,0,,Менің қалағаным...
Dialogue: 0,0:07:15.35,0:07:17.18,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:07:19.02,0:07:20.69,Default,,0,0,0,,Куееееееееей!
Dialogue: 0,0:07:20.77,0:07:22.94,Default,,0,0,0,,Нууууууу!
Dialogue: 0,0:07:25.02,0:07:26.32,Default,,0,0,0,,Ой! (Марито) Хмф!
Dialogue: 0,0:07:26.40,0:07:27.23,Default,,0,0,0,,Аһ!
Dialogue: 0,0:07:27.90,0:07:31.03,Default,,0,0,0,,Уау! (Минатокай) Жұдырық мырзаны ұрдым!
Dialogue: 0,0:07:33.03,0:07:33.87,Default,,0,0,0,,Иә
Dialogue: 0,0:07:33.95,0:07:35.28,Default,,0,0,0,,Жұдырық мырза...
Dialogue: 0,0:07:35.78,0:07:36.99,Default,,0,0,0,,Мен күлдім!
Dialogue: 0,0:07:37.08,0:07:38.33,Default,,0,0,0,,Куу! (Марито) Әй!
Dialogue: 0,0:07:38.83,0:07:40.50,Default,,0,0,0,,Сәлем! (Кенитиро) Нуо!
Dialogue: 0,0:07:41.29,0:07:42.87,Default,,0,0,0,,Хехехе!
Dialogue: 0,0:07:44.21,0:07:46.96,Default,,0,0,0,,Сіз қайтып келдіңіз!
Dialogue: 0,0:07:48.63,0:07:51.51,Default,,0,0,0,,Осыдан кейін екеуі күресті жалғастырды.
Dialogue: 0,0:07:52.34,0:07:54.89,Default,,0,0,0,,Бірақ бітімге келмеді.
Dialogue: 0,0:07:55.85,0:07:56.80,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:07:56.89,0:07:59.47,Default,,0,0,0,,Сәлем! Доманның дубликат болғаны рас...
Dialogue: 0,0:07:59.56,0:08:00.68,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:08:08.15,0:08:10.78,Default,,0,0,0,,Доман күтіп тұр.
Dialogue: 0,0:08:12.74,0:08:14.99,Default,,0,0,0,,Маритоның өзінен асып түсетін күні
Dialogue: 0,0:08:14.99,0:08:16.91,Default,,0,0,0,,Маритоның өзінен асып түсетін күні
Dialogue: 0,0:08:14.99,0:08:16.91,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:16.99,0:08:18.28,Default,,0,0,0,,Аһ!
Dialogue: 0,0:08:18.99,0:08:21.54,Default,,0,0,0,,Ха ха! Алақай!
Dialogue: 0,0:08:21.62,0:08:23.54,Default,,0,0,0,,Гоха!
Dialogue: 0,0:08:23.62,0:08:25.12,Default,,0,0,0,,Иә! (Кеничиро) Иә!
Dialogue: 0,0:08:25.21,0:08:26.79,Default,,0,0,0,,Ха! Ха! (Кенитиро) Нуу!
Dialogue: 0,0:08:27.59,0:08:29.92,Default,,0,0,0,,Үлкен аға, тоқтатыңыз!
Dialogue: 0,0:08:30.00,0:08:31.84,Default,,0,0,0,,Махоро-чан, бұл қауіпті!
Dialogue: 0,0:08:31.92,0:08:33.34,Default,,0,0,0,,Олай болса тез тоқтатыңыз!
Dialogue: 0,0:08:33.42,0:08:34.43,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің.
Dialogue: 0,0:08:35.26,0:08:39.14,Default,,0,0,0,,Мм, NG осы жерге келіп қалды...
Dialogue: 0,0:08:39.22,0:08:41.68,Default,,0,0,0,,Уау! Бугья!
Dialogue: 0,0:08:42.27,0:08:44.60,Default,,0,0,0,,Хаха...
Dialogue: 0,0:08:44.69,0:08:48.44,Default,,0,0,0,,Бұл қызық, Кеничиро...
Dialogue: 0,0:08:49.82,0:08:52.19,Default,,0,0,0,,Енді шешейік!
Dialogue: 0,0:08:53.07,0:08:54.45,Default,,0,0,0,,Нууууууу!
Dialogue: 0,0:08:54.53,0:08:56.16,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:08:57.49,0:09:00.12,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:09:01.49,0:09:04.54,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:09:04.62,0:09:08.25,Default,,0,0,0,,Ууууууууууууууууууууууууууу!
Dialogue: 0,0:09:27.48,0:09:30.19,Default,,0,0,0,,Сағат тілі бағыты бойынша айналу.
Dialogue: 0,0:09:31.86,0:09:34.28,Default,,0,0,0,,Мықты болыңыз! Эй!
Dialogue: 0,0:09:34.36,0:09:36.78,Default,,0,0,0,,Жұдырық мырза! (Минатокай) Жұдырық-сан!
Dialogue: 0,0:09:37.91,0:09:40.58,Default,,0,0,0,,Мм... Махоро-чан...
Dialogue: 0,0:09:40.66,0:09:42.83,Default,,0,0,0,,Жедел жәрдем шақыруым керек пе?
Dialogue: 0,0:09:42.91,0:09:43.74,Default,,0,0,0,,О!
Dialogue: 0,0:09:43.83,0:09:46.50,Default,,0,0,0,,Сен маған енді керек емессің
Dialogue: 0,0:09:46.58,0:09:48.75,Default,,0,0,0,,Ах... ааа...
Dialogue: 0,0:09:52.30,0:09:54.55,Default,,0,0,0,,Жүр, мені өлтір.
Dialogue: 0,0:09:55.05,0:09:59.51,Default,,0,0,0,,Шылжығандар түрмеге түседі.
Dialogue: 0,0:10:00.01,0:10:02.93,Default,,0,0,0,,Соғыс зары)
Dialogue: 0,0:10:03.93,0:10:06.60,Default,,0,0,0,,NG жігіттері осында!
Dialogue: 0,0:10:06.68,0:10:09.27,Default,,0,0,0,,...
Dialogue: 0,0:10:09.35,0:10:11.11,Default,,0,0,0,,Зафудың жауы!
Dialogue: 0,0:10:11.19,0:10:12.73,Default,,0,0,0,,Мен өлген жоқпын!
Dialogue: 0,0:10:13.52,0:10:16.99,Default,,0,0,0,,Егер сіз мұнда жабайы болып, синтез жылдамдығын арттырсаңыз, сіз ол жігітті кездестіресіз ...
Dialogue: 0,0:10:17.07,0:10:18.95,Default,,0,0,0,,Бір түн...!
Dialogue: 0,0:10:19.53,0:10:21.66,Default,,0,0,0,,Жүр, кеттік...
Dialogue: 0,0:10:21.74,0:10:24.12,Default,,0,0,0,,Сәлем! Қайда бара жатырсың?
Dialogue: 0,0:10:24.20,0:10:26.37,Default,,0,0,0,,Сіз не үшін жаттығыңыз?
Dialogue: 0,0:10:26.45,0:10:29.67,Default,,0,0,0,,Осындай үлкен төбелес болса да!
Dialogue: 0,0:10:32.50,0:10:35.55,Default,,0,0,0,,Енді жаттығудың немесе төбелесудің қажеті жоқ...
Dialogue: 0,0:10:35.63,0:10:40.13,Default,,0,0,0,,Сен... соңында ол қыздың өзіңе ұнағанын қаладың!
Dialogue: 0,0:10:40.22,0:10:42.68,Default,,0,0,0,,Тағы не болып жатыр?
Dialogue: 0,0:10:42.76,0:10:44.06,Default,,0,0,0,,Не болса да!
Dialogue: 0,0:10:45.43,0:10:50.10,Default,,0,0,0,,Сіздің достарыңыз қатты соғысып жатқан болуы керек!
Dialogue: 0,0:10:50.77,0:10:53.15,Default,,0,0,0,,Мені тастап қашасың ба?
Dialogue: 0,0:10:54.19,0:10:55.94,Default,,0,0,0,,(іштің түсу дыбысы)
Dialogue: 0,0:10:56.03,0:10:59.45,Default,,0,0,0,,Ол жігіттер тіпті дос емес!
Dialogue: 0,0:11:00.49,0:11:04.20,Default,,0,0,0,,Соңында бәрі осыған байланысты болды...
Dialogue: 0,0:11:10.62,0:11:12.96,Default,,0,0,0,,Мен сені іздедім АДЖ (Арани) Ах...
Dialogue: 0,0:11:14.25,0:11:15.21,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:15.29,0:11:18.96,Default,,0,0,0,,Сіз сондасыз, солай ма? Чия
Dialogue: 0,0:11:19.05,0:11:21.47,Default,,0,0,0,,Иә? Сіз қалай білесіз?
Dialogue: 0,0:11:22.22,0:11:25.97,Default,,0,0,0,,Мына жігіт... нағыз дос емес пе еді?
Dialogue: 0,0:11:27.26,0:11:29.14,Default,,0,0,0,,Гах! Гах!
Dialogue: 0,0:11:29.23,0:11:31.35,Default,,0,0,0,,Gugggggggg...!
Dialogue: 0,0:11:31.44,0:11:32.73,Default,,0,0,0,,Ара-чан!
Dialogue: 0,0:11:32.81,0:11:33.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:33.94,0:11:36.23,Default,,0,0,0,,Қараңдар, біз біріктіруіміз керек.
Dialogue: 0,0:11:33.94,0:11:36.23,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:11:36.23,0:11:36.32,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:11:36.32,0:11:37.73,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:11:36.32,0:11:37.73,Default,,0,0,0,,Сен өлесің бе?
Dialogue: 0,0:11:37.82,0:11:40.40,Default,,0,0,0,,Шинайо Чиямен бірге
Dialogue: 0,0:11:40.49,0:11:41.82,Default,,0,0,0,,Қараңдар, қараңдар!
Dialogue: 0,0:11:43.16,0:11:43.99,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:44.07,0:11:45.12,Default,,0,0,0,,Гааааааа!
Dialogue: 0,0:11:45.20,0:11:48.58,Default,,0,0,0,,Ей, біріктірейік! Сіз шынымен өлтірілмейсіз!
Dialogue: 0,0:11:49.91,0:11:50.87,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:50.96,0:11:54.13,Default,,0,0,0,,Енді жоқ... тірі болудың мәні неде...
Dialogue: 0,0:11:54.21,0:11:55.29,Default,,0,0,0,,Гах...
Dialogue: 0,0:11:55.38,0:11:56.25,Default,,0,0,0,,Ара-чан!
Dialogue: 0,0:11:56.34,0:11:59.13,Default,,0,0,0,,Иә! (Махо) Гуаа! Қарғыс атқыр...
Dialogue: 0,0:11:59.21,0:12:00.30,Default,,0,0,0,,Иә! (NG BOYS) Жақсы...
Dialogue: 0,0:12:00.38,0:12:01.22,Default,,0,0,0,,Гррр…
Dialogue: 0,0:12:05.30,0:12:08.22,Default,,0,0,0,,Колосса Колосза Колосса
Dialogue: 0,0:12:08.31,0:12:09.60,Default,,0,0,0,,Колосса!
Dialogue: 0,0:12:09.68,0:12:12.85,Default,,0,0,0,,Иә! Уф...
Dialogue: 0,0:12:12.94,0:12:15.44,Default,,0,0,0,,Бұл мүлдем әлсіз емес.
Dialogue: 0,0:12:15.52,0:12:17.86,Default,,0,0,0,,Бұл түсінбеушілік емес пе?
Dialogue: 0,0:12:21.61,0:12:23.74,Default,,0,0,0,,Арх! Каха...
Dialogue: 0,0:12:24.32,0:12:27.74,Default,,0,0,0,,Нақты не алып жатырсыз?
Dialogue: 0,0:12:27.83,0:12:29.99,Default,,0,0,0,,Уф... Уф! (Акутаро) Шынымен, менсіз...
Dialogue: 0,0:12:30.08,0:12:31.95,Default,,0,0,0,,Себебі мен ештеңе істей алмаймын
Dialogue: 0,0:12:32.58,0:12:37.96,Default,,0,0,0,,Мені мазақ еткендерді жазалайтын кез келді.
Dialogue: 0,0:12:38.04,0:12:39.59,Default,,0,0,0,,Ол сәл қорқынышты емес пе?
Dialogue: 0,0:12:39.67,0:12:41.92,Default,,0,0,0,,Мұның бәрі сіздің әрекетіңіз бе...
Dialogue: 0,0:12:42.01,0:12:45.18,Default,,0,0,0,,Иә! Мұның бәрі мен
Dialogue: 0,0:12:45.80,0:12:48.68,Default,,0,0,0,,Бірін-бірі ақымақтардай езгені үшін
Dialogue: 0,0:12:48.76,0:12:52.68,Default,,0,0,0,,Сізге көп рахмет...
Dialogue: 0,0:12:53.52,0:12:55.60,Default,,0,0,0,,Куку...! (Джабаши) Эй!
Dialogue: 0,0:12:55.69,0:12:59.15,Default,,0,0,0,,Сен бейбақ!
Dialogue: 0,0:12:59.23,0:13:00.90,Default,,0,0,0,,Хмф (Комао) Га!
Dialogue: 0,0:13:01.61,0:13:03.03,Default,,0,0,0,,Хмф! (Комао) Уф! Уф...
Dialogue: 0,0:13:03.11,0:13:03.94,Default,,0,0,0,,Комао!
Dialogue: 0,0:13:04.61,0:13:07.57,Default,,0,0,0,,Мен сені ешқашан кешірмеймін
Dialogue: 0,0:13:08.24,0:13:10.58,Default,,0,0,0,,Сәлем Забу-кун
Dialogue: 0,0:13:10.66,0:13:12.04,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:13.29,0:13:14.25,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:13:15.33,0:13:16.21,Default,,0,0,0,,Гохат
Dialogue: 0,0:13:17.33,0:13:20.46,Default,,0,0,0,,Бұл қиыншылық, сондықтан мен бәріңізбен бірден айналысамын.
Dialogue: 0,0:13:22.21,0:13:23.30,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:13:23.38,0:13:27.38,Default,,0,0,0,,Жалқау болмаңыз! Ууууууу!
Dialogue: 0,0:13:28.39,0:13:29.26,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:13:31.68,0:13:32.52,Default,,0,0,0,,Әзірге үш минут
Dialogue: 0,0:13:34.89,0:13:36.02,Default,,0,0,0,,Аһ!
Dialogue: 0,0:13:36.10,0:13:37.31,Default,,0,0,0,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,0:13:37.81,0:13:39.19,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:13:39.27,0:13:40.52,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:13:40.61,0:13:41.98,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:13:42.07,0:13:43.48,Default,,0,0,0,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,0:13:43.98,0:13:45.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:45.57,0:13:47.11,Default,,0,0,0,,Ха! (Минатокай) Ха!
Dialogue: 0,0:13:47.20,0:13:49.37,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:13:49.45,0:13:52.58,Default,,0,0,0,,Heartland~!
Dialogue: 0,0:13:57.29,0:13:59.21,Default,,0,0,0,,Қарғыс атсын... Ах!
Dialogue: 0,0:13:59.29,0:14:02.92,Default,,0,0,0,,Хмм... бұл ауырады.
Dialogue: 0,0:14:03.96,0:14:05.92,Default,,0,0,0,,Қазірдің өзінде! (Махо) Гуаа! Қарғыс атқыр...
Dialogue: 0,0:14:06.01,0:14:06.84,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:06.92,0:14:09.05,Default,,0,0,0,,Бұл тістерімді қақыратады, ақымақ! Ал, ал да кет.
Dialogue: 0,0:14:12.18,0:14:15.18,Default,,0,0,0,,Сен оған көп қиындық көрсеттің ғой, иә?
Dialogue: 0,0:14:16.98,0:14:17.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:18.52,0:14:20.40,Default,,0,0,0,,Сол сөзге шебер, жалған мейірімді жігіт➡
Dialogue: 0,0:14:21.02,0:14:21.94,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:25.61,0:14:28.11,Default,,0,0,0,,Сәлем! Оны осылай қалдыру дұрыс па?
Dialogue: 0,0:14:28.20,0:14:30.66,Default,,0,0,0,,Достар, мені тастап бара жатырсыңдар ма?
Dialogue: 0,0:14:31.32,0:14:32.53,Default,,0,0,0,,Уф...!
Dialogue: 0,0:14:35.49,0:14:39.12,Default,,0,0,0,,Тағы бір қадам...
Dialogue: 0,0:14:39.21,0:14:42.00,Default,,0,0,0,,Мен ол жігітке жетсем де...!
Dialogue: 0,0:14:44.13,0:14:45.25,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:45.34,0:14:48.84,Default,,0,0,0,,Ах... Ха ха...
Dialogue: 0,0:14:48.92,0:14:50.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:51.51,0:14:52.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:56.52,0:14:57.39,Default,,0,0,0,,Қат!
Dialogue: 0,0:14:57.47,0:14:59.64,Default,,0,0,0,,Сіздің аяқ киіміңіз лас.
Dialogue: 0,0:15:03.94,0:15:05.48,Default,,0,0,0,,ал біз батырлармыз.
Dialogue: 0,0:15:06.73,0:15:09.15,Default,,0,0,0,,Қайта соғыса алмайтын дене
Dialogue: 0,0:15:09.24,0:15:12.24,Default,,0,0,0,,Мен мұны сен үшін жасаймын...
Dialogue: 0,0:15:13.74,0:15:14.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:19.12,0:15:21.08,Default,,0,0,0,,Сені күйрететін бұл қайғы
Dialogue: 0,0:15:21.17,0:15:22.58,Default,,0,0,0,,Сіз жоғалып кеттіңіз
Dialogue: 0,0:15:22.67,0:15:24.13,Default,,0,0,0,,Сендер жақсысыңдар ма?
Dialogue: 0,0:15:33.84,0:15:36.10,Default,,0,0,0,,Махоро...чан?
Dialogue: 0,0:15:36.85,0:15:38.77,Default,,0,0,0,,Артқа қалыңыз.
Dialogue: 0,0:15:38.85,0:15:43.02,Default,,0,0,0,,Сіз ештеңе істей алмайсыз.
Dialogue: 0,0:15:43.10,0:15:44.36,Default,,0,0,0,,Я...
Dialogue: 0,0:15:45.31,0:15:46.86,Default,,0,0,0,,Я...
Dialogue: 0,0:15:47.82,0:15:49.11,Default,,0,0,0,,Жоқ, Махоро-чан...
Dialogue: 0,0:15:50.03,0:15:51.20,Default,,0,0,0,,Қаш...
Dialogue: 0,0:15:51.70,0:15:55.12,Default,,0,0,0,,Қаш!
Dialogue: 0,0:15:56.45,0:16:00.37,Default,,0,0,0,,Қашу? Неге қашпайсың?
Dialogue: 0,0:16:01.71,0:16:05.88,Default,,0,0,0,,Мен сенен қорықпаймын, сен жай ғана тобырсың.
Dialogue: 0,0:16:07.21,0:16:11.72,Default,,0,0,0,,Адамдар сізді мойындамайынша, сіз өзіңіздің кім екеніңізді білмейсіз.
Dialogue: 0,0:16:12.26,0:16:13.63,Default,,0,0,0,,Тек бос
Dialogue: 0,0:16:19.56,0:16:21.23,Default,,0,0,0,,Көрінбейді
Dialogue: 0,0:16:21.73,0:16:23.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:25.27,0:16:26.52,Default,,0,0,0,,өлтіру
Dialogue: 0,0:16:26.61,0:16:28.52,Default,,0,0,0,,Бұл мені өлтірмейді, бірақ біраз уақыт дұрыс жүре алмайтын шығармын.
Dialogue: 0,0:16:38.95,0:16:39.79,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:44.12,0:16:45.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:48.67,0:16:49.84,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:49.92,0:16:52.21,Default,,0,0,0,,Пайдасыз істермен айналысуды доғар!
Dialogue: 0,0:16:56.97,0:16:57.80,Default,,0,0,0,,Гррр…
Dialogue: 0,0:17:00.10,0:17:00.93,Default,,0,0,0,,Гррр…
Dialogue: 0,0:17:01.89,0:17:03.43,Default,,0,0,0,,Біріктіру жылдамдығы...
Dialogue: 0,0:17:04.06,0:17:05.56,Default,,0,0,0,,Жоғары көтерілу керек пе?
Dialogue: 0,0:17:05.64,0:17:06.69,Default,,0,0,0,,Өте тітіркендіргіш!
Dialogue: 0,0:17:06.77,0:17:07.90,Default,,0,0,0,,Құдай…
Dialogue: 0,0:17:08.48,0:17:09.36,Default,,0,0,0,,Ара-чан…
Dialogue: 0,0:17:12.03,0:17:12.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:12.94,0:17:16.20,Default,,0,0,0,,Алаңдамаңыз!
Dialogue: 0,0:17:22.95,0:17:26.12,Default,,0,0,0,,Ол қанша биіктікке көтеріледі?
Dialogue: 0,0:17:27.67,0:17:28.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:31.38,0:17:32.21,Default,,0,0,0,,Хамф!
Dialogue: 0,0:17:33.92,0:17:37.13,Default,,0,0,0,,Арх! Ақымақ болма!
Dialogue: 0,0:17:37.22,0:17:38.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:41.39,0:17:42.31,Default,,0,0,0,,Бар...!
Dialogue: 0,0:17:42.39,0:17:43.56,Default,,0,0,0,,Хамф!
Dialogue: 0,0:17:44.18,0:17:46.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:46.85,0:17:47.77,Default,,0,0,0,,Бар...!
Dialogue: 0,0:17:48.56,0:17:50.61,Default,,0,0,0,,Иә! (Акутаро) Уф!
Dialogue: 0,0:17:51.69,0:17:52.73,Default,,0,0,0,,Жоқ...!
Dialogue: 0,0:17:54.07,0:17:56.95,Default,,0,0,0,,Иә! (Акутаро) Ах! Апыр-ай!
Dialogue: 0,0:17:57.03,0:17:59.45,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:17:59.53,0:18:05.45,Default,,0,0,0,,Дот, лақтыр!
Dialogue: 0,0:18:25.81,0:18:26.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:30.15,0:18:34.73,Default,,0,0,0,,Хмм... Аа...
Dialogue: 0,0:18:36.57,0:18:39.70,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:18:40.57,0:18:43.24,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:18:46.08,0:18:48.25,Default,,0,0,0,,Казуя ие болған адамға...
Dialogue: 0,0:18:48.96,0:18:50.42,Default,,0,0,0,,Мен жеңген жоқпын!
Dialogue: 0,0:18:50.50,0:18:51.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:52.63,0:18:53.50,Default,,0,0,0,,Махоро-чан!
Dialogue: 0,0:18:54.29,0:18:55.13,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:18:59.55,0:19:01.34,Default,,0,0,0,,Арапён! (Бакуре және т.б.) Араджин!
Dialogue: 0,0:19:02.05,0:19:05.18,Default,,0,0,0,,Керемет, Арапён! (Бәкіре) Мен қатты әсерлендім!
Dialogue: 0,0:19:05.26,0:19:07.06,Default,,0,0,0,,Келесі мен және Тайман! Жоқ, бұл менмін!
Dialogue: 0,0:19:07.06,0:19:07.89,Default,,0,0,0,,Келесі мен және Тайман! Жоқ, бұл менмін!
Dialogue: 0,0:19:07.06,0:19:07.89,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:19:07.98,0:19:09.31,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:19:12.06,0:19:14.44,Default,,0,0,0,,Сондықтан келмейсің.
Dialogue: 0,0:19:14.52,0:19:15.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:15.69,0:19:17.23,Default,,0,0,0,,Жұдырық мырза!
Dialogue: 0,0:19:17.32,0:19:18.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:21.99,0:19:23.12,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:24.07,0:19:25.45,Default,,0,0,0,,(Махороның айқайы)
Dialogue: 0,0:19:25.53,0:19:27.74,Default,,0,0,0,,Ара-чан (Арани) А?
Dialogue: 0,0:19:31.17,0:19:33.83,Default,,0,0,0,,Мен сендім
Dialogue: 0,0:19:34.54,0:19:37.09,Default,,0,0,0,,Ара-чанның мұны істейтініне сенімдімін.
Dialogue: 0,0:19:40.26,0:19:42.76,Default,,0,0,0,,Бермеген сенсің
Dialogue: 0,0:19:42.84,0:19:44.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:44.22,0:19:46.01,Default,,0,0,0,,Өтінемін, менен сөйлеспеңіз.
Dialogue: 0,0:19:48.06,0:19:49.73,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:19:51.81,0:19:52.77,Default,,0,0,0,,Ах
Dialogue: 0,0:19:52.85,0:19:54.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:55.52,0:19:56.69,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,0:19:59.11,0:20:00.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:06.91,0:20:07.83,Default,,0,0,0,,Рамен асшаянының чилиі
Dialogue: 0,0:20:07.91,0:20:09.33,Default,,0,0,0,,Чиньяолоза леванильі
Dialogue: 0,0:20:09.41,0:20:11.58,Default,,0,0,0,,Чучу Гиоза Омачу!
Dialogue: 0,0:20:11.66,0:20:14.33,Default,,0,0,0,,Уау! (Нашар) Бұл қайтадан дәмді көрінеді!
Dialogue: 0,0:20:14.42,0:20:16.84,Default,,0,0,0,,Көп жеп, көп өс!
Dialogue: 0,0:20:16.92,0:20:19.09,Default,,0,0,0,,Тадема…
Dialogue: 0,0:20:20.13,0:20:21.34,Default,,0,0,0,,Аранин?
Dialogue: 0,0:20:21.42,0:20:25.01,Default,,0,0,0,,Не? Ұрыс? Мүмкін емес! Сейшун!
Dialogue: 0,0:20:25.09,0:20:26.35,Default,,0,0,0,,Кемпір…
Dialogue: 0,0:20:27.43,0:20:30.81,Default,,0,0,0,,Өтееее~! Бұл шағады!
Dialogue: 0,0:20:30.89,0:20:32.60,Default,,0,0,0,,Аранин (Аранин) А?
Dialogue: 0,0:20:33.27,0:20:35.73,Default,,0,0,0,,Сізде өте жақсы жұдырық бар, солай емес пе?
Dialogue: 0,0:20:36.31,0:20:37.90,Default,,0,0,0,,Мен оны қарап шықтым.
Dialogue: 0,0:20:37.98,0:20:40.36,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:20:40.94,0:20:43.78,Default,,0,0,0,,Менде тіпті Махоро-чанның жүрегі жоқ
Dialogue: 0,0:20:43.86,0:20:44.99,Default,,0,0,0,,Егер сіз оны ала алсаңыз...
Dialogue: 0,0:20:45.86,0:20:48.24,Default,,0,0,0,,Қолшатыр, елден келген
Dialogue: 0,0:20:48.33,0:20:50.66,Default,,0,0,0,,Мен сен туралы қайдан білдім?
Dialogue: 0,0:20:50.74,0:20:52.50,Default,,0,0,0,,Сааааааааааааааааааааааа
Dialogue: 0,0:20:52.58,0:20:55.21,Default,,0,0,0,,Менің қоңырау шалғанымды естімедің бе?
Dialogue: 0,0:20:55.29,0:20:56.54,Default,,0,0,0,,Хмм…
Dialogue: 0,0:20:57.04,0:20:59.88,Default,,0,0,0,,Бұл өте жақсы!
Dialogue: 0,0:21:00.50,0:21:01.63,Default,,0,0,0,,Соңында...
Dialogue: 0,0:21:02.38,0:21:04.17,Default,,0,0,0,,Уақыттың толықтығы!
Dialogue: 0,0:21:07.01,0:21:11.01,Default,,0,0,0,,♪～
Dialogue: 0,0:22:33.14,0:22:36.98,Default,,0,0,0,,～♪
Dialogue: 0,0:22:37.06,0:22:38.60,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,0:22:40.81,0:22:44.98,Default,,0,0,0,,Қарғыс атсын, келесі жолы шешемін!
Dialogue: 0,0:22:45.07,0:22:48.36,Default,,0,0,0,,Сонымен, Ичики президенті, мені қабылдайсыз ба?
Dialogue: 0,0:22:48.45,0:22:49.49,Default,,0,0,0,,Ичики?
Dialogue: 0,0:22:49.57,0:22:51.49,Default,,0,0,0,,Жоқ, себебі бұл жақсы емес
Dialogue: 0,0:22:51.57,0:22:52.99,Default,,0,0,0,,Міне!
Dialogue: 0,0:22:54.03,0:22:55.24,Default,,0,0,0,,Сигма…
Dialogue: 0,0:22:55.33,0:22:57.08,Default,,0,0,0,,О? Бұл не? (Икки Ренго) Иә?
Dialogue: 0,0:22:57.16,0:22:58.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:59.00,0:23:01.29,Default,,0,0,0,,Жалғыз… Ақыл…
Dialogue: 0,0:23:01.38,0:23:02.25,Default,,0,0,0,,Қысқартылған...
Dialogue: 0,0:23:02.33,0:23:03.54,Default,,0,0,0,,Сигма!
Dialogue: 0,0:23:03.63,0:23:05.55,Default,,0,0,0,,О! (Икки Ренго) О, керемет!
Dialogue: 0,0:23:06.30,0:23:08.05,Default,,0,0,0,,Жоқ, осылай.
Dialogue: 0,0:23:11.97,0:23:12.80,Default,,0,0,0,,Таку
Dialogue: 0,0:23:12.89,0:23:14.68,Default,,0,0,0,,Жоғалтпа
Dialogue: 0,0:23:14.76,0:23:16.14,Default,,0,0,0,,Мен жеңілмеймін
Dialogue: 0,0:23:16.22,0:23:17.06,Default,,0,0,0,,Хи хи
Dialogue: 0,0:23:23.36,0:23:25.07,Default,,0,0,0,,Ота (Ота) Иә?
Dialogue: 0,0:23:25.86,0:23:28.65,Default,,0,0,0,,Келесі сөзсіз...
Dialogue: 0,0:23:33.16,0:23:34.74,Default,,0,0,0,,Құдай-ай! «Енді бұдан әрі бәрі дәл болжағандай қалай болатынына таңғаламын!»
Dialogue: 0,0:23:35.91,0:23:37.83,Default,,0,0,0,,Үлкен етіп жасайық
Dialogue: 0,0:23:37.91,0:23:40.33,Default,,0,0,0,,А... аа
Dialogue: 0,0:23:45.75,0:23:48.09,Default,,0,0,0,,Келесі аптада да... (Комао) Мен үрлеймін!
Dialogue: 0,0:23:49.59,0:23:55.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
