Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.04,0:00:09.96,Default,,0,0,0,,Соғыс аяқталып, бейбітшілік әлеміне енді
Dialogue: 0,0:00:10.05,0:00:12.97,Default,,0,0,0,,Тәңірім, біз байсалды адам болуды мақсат тұтатындармыз.
Dialogue: 0,0:00:13.05,0:00:15.01,Default,,0,0,0,,Қысылған
Dialogue: 0,0:00:16.05,0:00:19.72,Default,,0,0,0,,Уолла Уолла Уолла Уолла Уолла Уолла!
Dialogue: 0,0:00:20.93,0:00:23.35,Default,,0,0,0,,Уолла Уолла Уолла Уолла...!
Dialogue: 0,0:00:23.44,0:00:24.73,Default,,0,0,0,,Хамф (Чия)
Dialogue: 0,0:00:25.77,0:00:28.19,Default,,0,0,0,,Хмф! (Чия) Уау! Апыр-ай!
Dialogue: 0,0:00:29.11,0:00:30.19,Default,,0,0,0,,Гррр…
Dialogue: 0,0:00:31.19,0:00:34.45,Default,,0,0,0,,Менің ойымша, бұл бір түнде болуы мүмкін емес
Dialogue: 0,0:00:35.61,0:00:38.45,Default,,0,0,0,,Сен мені қаншалықты мазақтамақсың?
Dialogue: 0,0:00:39.12,0:00:39.95,Default,,0,0,0,,Е...
Dialogue: 0,0:00:44.66,0:00:46.25,Default,,0,0,0,,Сенің есі дұрыс па? Бір түн!
Dialogue: 0,0:00:46.33,0:00:49.46,Default,,0,0,0,,Шынайы жұдырықтассаң, біреуің өлесің!
Dialogue: 0,0:00:50.17,0:00:52.71,Default,,0,0,0,,Әрине, табандылықпен
Dialogue: 0,0:00:52.80,0:00:55.68,Default,,0,0,0,,Істейтін ештеңе қалмады
Dialogue: 0,0:00:55.76,0:00:58.97,Default,,0,0,0,,Сіз нені айтасыз? Тым болмаса аудармасын берші...
Dialogue: 0,0:00:59.05,0:01:01.85,Default,,0,0,0,,Сұрақтар қойылмаған!
Dialogue: 0,0:01:01.93,0:01:03.31,Default,,0,0,0,,Ой! (Чия) Ах!
Dialogue: 0,0:01:03.39,0:01:05.02,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:05.10,0:01:07.48,Default,,0,0,0,,Иә! Арх!
Dialogue: 0,0:01:08.81,0:01:10.40,Default,,0,0,0,,Ал аааааааааа!
Dialogue: 0,0:01:10.48,0:01:11.90,Default,,0,0,0,,Гррр…
Dialogue: 0,0:01:16.28,0:01:17.36,Default,,0,0,0,,Ахх!
Dialogue: 0,0:01:22.33,0:01:25.83,Default,,0,0,0,,Кел... Чия!
Dialogue: 0,0:01:25.91,0:01:28.25,Default,,0,0,0,,Хаха...
Dialogue: 0,0:01:28.33,0:01:29.29,Default,,0,0,0,,Уолла!
Dialogue: 0,0:01:29.38,0:01:31.80,Default,,0,0,0,,Киееееее!
Dialogue: 0,0:01:37.30,0:01:39.01,Default,,0,0,0,,Сіз...
Dialogue: 0,0:01:39.84,0:01:43.72,Default,,0,0,0,,Осы кезеңнен кейін де мені мазақ етесің бе?
Dialogue: 0,0:01:44.52,0:01:46.77,Default,,0,0,0,,Бір... түн...?
Dialogue: 0,0:01:46.85,0:01:47.98,Default,,0,0,0,,Тұрған…
Dialogue: 0,0:01:48.06,0:01:50.65,Default,,0,0,0,,Чия тұр!
Dialogue: 0,0:01:50.73,0:01:51.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:52.15,0:01:53.27,Default,,0,0,0,,Гах... Гах!
Dialogue: 0,0:01:55.03,0:01:56.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:01.07,0:02:04.49,Default,,0,0,0,,Мен кек сақтаймын... Чия...!
Dialogue: 0,0:02:04.58,0:02:06.08,Default,,0,0,0,,Ха! Бір түн!
Dialogue: 0,0:02:06.08,0:02:06.91,Default,,0,0,0,,Ха! Бір түн!
Dialogue: 0,0:02:06.08,0:02:06.91,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:02:13.46,0:02:16.38,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:02:17.59,0:02:20.84,Default,,0,0,0,,Бір… түн…
Dialogue: 0,0:02:30.23,0:02:33.94,Default,,0,0,0,,Мен... Ичиямен келісуім керек.
Dialogue: 0,0:02:34.94,0:02:39.20,Default,,0,0,0,,Мен оның өз өмірін не үшін қатерге тіккенін білуім керек.
Dialogue: 0,0:02:40.57,0:02:43.78,Default,,0,0,0,,Сол үшін мені алдап өлтіруді жоспарладың ба?
Dialogue: 0,0:02:43.87,0:02:45.45,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:02:45.95,0:02:48.33,Default,,0,0,0,,Мен мәйітті кейін қайтаруды жоспарлап едім...
Dialogue: 0,0:02:48.41,0:02:51.00,Default,,0,0,0,,Мен ешқандай сылтау естігім келмейді!
Dialogue: 0,0:02:51.79,0:02:53.46,Default,,0,0,0,,Менен кет
Dialogue: 0,0:02:55.34,0:02:57.76,Default,,0,0,0,,Үндемегенім үшін кешіріңіз...
Dialogue: 0,0:02:58.26,0:03:02.84,Default,,0,0,0,,Сізбен уақыт өткізу қызықты болды...
Dialogue: 0,0:03:12.98,0:03:16.48,Default,,0,0,0,,♪～
Dialogue: 0,0:04:35.69,0:04:40.61,Default,,0,0,0,,～♪
Dialogue: 0,0:04:45.20,0:04:46.32,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:04:49.53,0:04:50.45,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:51.04,0:04:52.04,Default,,0,0,0,,Ай…
Dialogue: 0,0:04:53.37,0:04:56.08,Default,,0,0,0,,Та... маған көмектес!
Dialogue: 0,0:04:56.71,0:04:58.63,Default,,0,0,0,,Ах! Гах...
Dialogue: 0,0:05:03.97,0:05:04.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:07.39,0:05:09.30,Default,,0,0,0,,Нағыз қазына
Dialogue: 0,0:05:09.39,0:05:13.27,Default,,0,0,0,,Саған ие болған түн денеңді жаулап алады.
Dialogue: 0,0:05:13.35,0:05:14.56,Default,,0,0,0,,Менен дереу құтыл
Dialogue: 0,0:05:15.52,0:05:17.10,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:05:17.65,0:05:21.82,Default,,0,0,0,,Түсіндім... Мен күшейгенді ұнатпаймын.
Dialogue: 0,0:05:22.86,0:05:25.82,Default,,0,0,0,,Егер сіздің денеңізді басып алса, сіз өлуіңіз мүмкін!
Dialogue: 0,0:05:25.90,0:05:27.53,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:28.49,0:05:30.32,Default,,0,0,0,,Ара-чанды жеңе алсам
Dialogue: 0,0:05:30.41,0:05:31.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:39.13,0:05:41.42,Default,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,0:05:42.09,0:05:45.51,Default,,0,0,0,,Неліктен Аранинмен жұмыс істемеске? Егер сіз қазір...
Dialogue: 0,0:05:45.59,0:05:46.92,Default,,0,0,0,,Шулы (түнде) Ах...
Dialogue: 0,0:05:47.97,0:05:50.26,Default,,0,0,0,,Оған дейін менің бір ісім бар.
Dialogue: 0,0:05:52.26,0:05:55.22,Default,,0,0,0,,Енді бізге не болады?
Dialogue: 0,0:05:55.31,0:05:57.31,Default,,0,0,0,,Марито-кун, сен жеңілдің.
Dialogue: 0,0:05:57.39,0:05:59.02,Default,,0,0,0,,Сигма таратылуы мүмкін...
Dialogue: 0,0:05:59.10,0:05:59.94,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:06:00.86,0:06:04.44,Default,,0,0,0,,Ақымақ болма! Бұған шынымен де жарайсың ба?
Dialogue: 0,0:06:04.53,0:06:06.86,Default,,0,0,0,,Бұл жақсы емес!
Dialogue: 0,0:06:06.94,0:06:08.15,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:06:09.16,0:06:10.28,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:06:24.67,0:06:26.17,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:06:26.26,0:06:28.76,Default,,0,0,0,,Бүгін де күткендей ме?
Dialogue: 0,0:06:29.26,0:06:30.38,Default,,0,0,0,,Жасмин-чанмен
Dialogue: 0,0:06:30.47,0:06:33.18,Default,,0,0,0,,Иә! Жасмин-чанның ерекше рахаты бар!
Dialogue: 0,0:06:34.56,0:06:36.97,Default,,0,0,0,,Мен енді шыдай алмаймын...
Dialogue: 0,0:06:37.06,0:06:39.52,Default,,0,0,0,,Тек сіздің басқа біреумен қарым-қатынасыңыз туралы ойлау
Dialogue: 0,0:06:39.60,0:06:41.90,Default,,0,0,0,,Мен жынды болып бара жатырмын деп ойлаймын.
Dialogue: 0,0:06:41.98,0:06:43.82,Default,,0,0,0,,Мен бәріңді өзіме алғым келеді
Dialogue: 0,0:06:44.57,0:06:47.69,Default,,0,0,0,,Біз әрқашан бірге болдық, солай ма?
Dialogue: 0,0:06:49.78,0:06:51.57,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:53.91,0:06:57.45,Default,,0,0,0,,Мм... бұдан былай бізге не болады?
Dialogue: 0,0:07:00.12,0:07:01.46,Default,,0,0,0,,Мүмкін Сигма...
Dialogue: 0,0:07:02.63,0:07:03.79,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:07:05.13,0:07:07.51,Default,,0,0,0,,Сигма ешқашан бітпейді!
Dialogue: 0,0:07:08.92,0:07:12.14,Default,,0,0,0,,Нағыз қазыналы жігітке не болды...
Dialogue: 0,0:07:12.22,0:07:14.43,Default,,0,0,0,,Бұл Минатоның әдісі емес.
Dialogue: 0,0:07:15.10,0:07:18.18,Default,,0,0,0,,Жұдырық мырза, сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:07:18.27,0:07:19.89,Default,,0,0,0,,Білмеймін.
Dialogue: 0,0:07:20.69,0:07:22.69,Default,,0,0,0,,Ах... Сәлем!
Dialogue: 0,0:07:28.03,0:07:28.94,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:29.03,0:07:30.95,Default,,0,0,0,,Уау! Уау...
Dialogue: 0,0:07:31.03,0:07:32.45,Default,,0,0,0,,Нағыз қазына!
Dialogue: 0,0:07:32.53,0:07:34.32,Default,,0,0,0,,(басшы ыңырсыды)
Dialogue: 0,0:07:34.41,0:07:36.45,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:36.53,0:07:39.66,Default,,0,0,0,,Фист-сан, маған қосыл.
Dialogue: 0,0:07:39.75,0:07:42.92,Default,,0,0,0,,Ах! Есіңіз дұрыс па?
Dialogue: 0,0:07:43.00,0:07:44.54,Default,,0,0,0,,Сәлем, Шинпо! (зафу) А.
Dialogue: 0,0:07:45.17,0:07:46.54,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:46.63,0:07:49.46,Default,,0,0,0,,Гах... гах! (зафу) Ха! Қарғыс атқыр...
Dialogue: 0,0:07:49.55,0:07:51.05,Default,,0,0,0,,Қарғыс атсын...!
Dialogue: 0,0:07:51.13,0:07:52.63,Default,,0,0,0,,Ах
Dialogue: 0,0:07:54.43,0:07:55.64,Default,,0,0,0,,Жұдырық мырза...
Dialogue: 0,0:07:56.30,0:07:59.85,Default,,0,0,0,,Ертең, Тори-но Токи, Икецуто жағажайында
Dialogue: 0,0:08:01.85,0:08:02.85,Default,,0,0,0,,Хун
Dialogue: 0,0:08:07.23,0:08:08.77,Default,,0,0,0,,Нағыз қазына...
Dialogue: 0,0:08:10.19,0:08:11.57,Default,,0,0,0,,Эй, сен мұны естідің бе?
Dialogue: 0,0:08:11.65,0:08:14.07,Default,,0,0,0,,Ертең Доман галстук қояды!
Dialogue: 0,0:08:14.16,0:08:18.62,Default,,0,0,0,,А, мен қарсыласым сол Минатоның нағыз қазынасы екеніне сене алмаймын~
Dialogue: 0,0:08:18.70,0:08:19.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:20.45,0:08:21.70,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:22.62,0:08:24.46,Default,,0,0,0,,Ара-чанды жеңе алсаң
Dialogue: 0,0:08:25.29,0:08:28.63,Default,,0,0,0,,Қуырылған күрішті күту (Құқық бұзушылар) Ах! о...?
Dialogue: 0,0:08:28.71,0:08:31.38,Default,,0,0,0,,Мм, бұл менің сұрағаным емес, бірақ...
Dialogue: 0,0:08:31.46,0:08:32.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:35.22,0:08:36.22,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:37.30,0:08:39.60,Default,,0,0,0,,Қош келдіңіз! Ол қайтадан үлкейді ме?
Dialogue: 0,0:08:40.35,0:08:43.10,Default,,0,0,0,,Жіптің өсу кезеңі
Dialogue: 0,0:08:43.89,0:08:44.89,Default,,0,0,0,,Е...
Dialogue: 0,0:08:49.94,0:08:51.11,Default,,0,0,0,,Ум...
Dialogue: 0,0:08:51.98,0:08:54.11,Default,,0,0,0,,Менен не керек?
Dialogue: 0,0:09:00.87,0:09:03.12,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:09:04.96,0:09:06.17,Default,,0,0,0,,Сана туралы не деуге болады?
Dialogue: 0,0:09:10.63,0:09:13.59,Default,,0,0,0,,Мен қарап тұрамын, қазір үйге қайт.
Dialogue: 0,0:09:13.67,0:09:15.55,Default,,0,0,0,,Сен де құлайсың.
Dialogue: 0,0:09:17.55,0:09:18.39,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:09:19.26,0:09:20.55,Default,,0,0,0,,Қайта кел
Dialogue: 0,0:09:21.97,0:09:23.60,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:09:23.68,0:09:25.02,Default,,0,0,0,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,0:09:25.56,0:09:27.90,Default,,0,0,0,,Оян...
Dialogue: 0,0:09:27.98,0:09:31.65,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:09:33.69,0:09:34.74,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:34.82,0:09:35.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:41.33,0:09:44.04,Default,,0,0,0,,Таймерге бір сағаттан аз уақыт қалды...
Dialogue: 0,0:09:44.12,0:09:46.79,Default,,0,0,0,,А, енді не істеуім керек?
Dialogue: 0,0:09:46.87,0:09:49.83,Default,,0,0,0,,Неліктен бұлай болды...
Dialogue: 0,0:09:49.92,0:09:52.13,Default,,0,0,0,,Сол кездегідей...
Dialogue: 0,0:09:54.46,0:09:56.13,Default,,0,0,0,,Кеничиро Доман…
Dialogue: 0,0:09:57.26,0:10:02.64,Default,,0,0,0,,Бұл адам соншалықты құмар болатын Минатоға қосылу арманым орындалады!
Dialogue: 0,0:10:02.72,0:10:07.14,Default,,0,0,0,,Дайо на даё! Жеңілмей 300 шайқас - бұл ақылсыз!
Dialogue: 0,0:10:07.85,0:10:08.73,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:10:08.81,0:10:10.40,Default,,0,0,0,,Не? мен?
Dialogue: 0,0:10:10.48,0:10:12.77,Default,,0,0,0,,Комао! Сізбен танысқаныма қуаныштымын!
Dialogue: 0,0:10:12.86,0:10:13.94,Default,,0,0,0,,Не деген сұмдық! (Забу/Комао) Ой?
Dialogue: 0,0:10:14.03,0:10:15.15,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:10:15.23,0:10:17.40,Default,,0,0,0,,Ха ха ха... (басшылар) Ух...
Dialogue: 0,0:10:17.49,0:10:18.45,Default,,0,0,0,,О?
Dialogue: 0,0:10:18.53,0:10:19.91,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:19.99,0:10:22.33,Default,,0,0,0,,А... ха
Dialogue: 0,0:10:22.41,0:10:26.16,Default,,0,0,0,,Кеничиро Доман! Өтінемін, маған галстук киіп қосылыңыз!
Dialogue: 0,0:10:26.25,0:10:27.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:31.75,0:10:34.42,Default,,0,0,0,,Эй, оны өлтірме...
Dialogue: 0,0:10:34.50,0:10:37.51,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:10:41.55,0:10:42.39,Default,,0,0,0,,Хмм…
Dialogue: 0,0:10:42.47,0:10:43.85,Default,,0,0,0,,Жоқ! Қарғыс атсын!
Dialogue: 0,0:10:44.81,0:10:47.43,Default,,0,0,0,,Иә! Ха! Ха!
Dialogue: 0,0:10:47.52,0:10:48.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:49.85,0:10:51.77,Default,,0,0,0,,Тістеріңізді қысыңыз
Dialogue: 0,0:10:53.56,0:10:54.48,Default,,0,0,0,,Хамф!
Dialogue: 0,0:10:54.57,0:10:55.44,Default,,0,0,0,,Ga!
Dialogue: 0,0:10:55.52,0:10:56.53,Default,,0,0,0,,Аһ!
Dialogue: 0,0:10:57.99,0:10:59.61,Default,,0,0,0,,Гаха!
Dialogue: 0,0:11:00.82,0:11:03.16,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:11:03.66,0:11:04.62,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:11.92,0:11:13.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:13.29,0:11:14.13,Default,,0,0,0,,Жасаңыз
Dialogue: 0,0:11:15.34,0:11:17.13,Default,,0,0,0,,Себебі мен оны қателесіп сатып алдым.
Dialogue: 0,0:11:17.21,0:11:19.30,Default,,0,0,0,,Мына жігіт мені мақтап жатты!
Dialogue: 0,0:11:19.38,0:11:22.89,Default,,0,0,0,,Кен-санмен төбелескеніңіз қандай ғажап!
Dialogue: 0,0:11:22.97,0:11:25.85,Default,,0,0,0,,Иә? Ондай нәрселерді айтпа!
Dialogue: 0,0:11:25.93,0:11:28.60,Default,,0,0,0,,Не? Таппа бар деп қызғанбайсың ба?
Dialogue: 0,0:11:28.68,0:11:29.98,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:30.06,0:11:31.06,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:31.14,0:11:32.52,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:11:34.65,0:11:35.65,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:11:38.07,0:11:39.74,Default,,0,0,0,,Фуфуфуфу (зафу) фуфу
Dialogue: 0,0:11:46.74,0:11:47.62,Default,,0,0,0,,Кома (адам) иә?
Dialogue: 0,0:11:47.70,0:11:49.29,Default,,0,0,0,,Аранин, мені әкел.
Dialogue: 0,0:11:49.37,0:11:52.16,Default,,0,0,0,,Арапён, сенің бүгін демалысың бар, солай ма?
Dialogue: 0,0:11:52.25,0:11:56.09,Default,,0,0,0,,Сондықтан жарыс басталмай тұрып, оны өзіңмен бірге ала кел деп айтып отырмын.
Dialogue: 0,0:11:56.17,0:11:57.42,Default,,0,0,0,,Олар…
Dialogue: 0,0:11:59.00,0:12:01.67,Default,,0,0,0,,Ол да нағыз қазына, солай ма?
Dialogue: 0,0:12:03.05,0:12:05.93,Default,,0,0,0,,Ха! Дұрыс!
Dialogue: 0,0:12:06.01,0:12:09.93,Default,,0,0,0,,Сукетаро мұның бәрін біледі!
Dialogue: 0,0:12:15.10,0:12:16.90,Default,,0,0,0,,Марито-кун өзін қалай сезінеді?
Dialogue: 0,0:12:16.98,0:12:19.40,Default,,0,0,0,,Әлі оянба
Dialogue: 0,0:12:20.23,0:12:23.15,Default,,0,0,0,,Үш күн болды...
Dialogue: 0,0:12:24.36,0:12:25.61,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:12:25.70,0:12:27.87,Default,,0,0,0,,Ах, Рю-чан, қайда бара жатырсың?
Dialogue: 0,0:12:27.95,0:12:29.83,Default,,0,0,0,,Мұны Моккай Шинхомен жасаңыз
Dialogue: 0,0:12:29.91,0:12:32.33,Default,,0,0,0,,Иә? Не... не айтып тұрсың!
Dialogue: 0,0:12:32.41,0:12:34.29,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:12:34.37,0:12:36.75,Default,,0,0,0,,Сіз осындай жерде қозғала алмайсыз ба?
Dialogue: 0,0:12:36.83,0:12:39.21,Default,,0,0,0,,Мен Марито-куннан кек аламын...!
Dialogue: 0,0:12:39.30,0:12:40.42,Default,,0,0,0,,Идиот!
Dialogue: 0,0:12:42.13,0:12:44.63,Default,,0,0,0,,Сіз мұндай денемен не ойлайсыз?
Dialogue: 0,0:12:44.72,0:12:49.05,Default,,0,0,0,,Бәріміздің көңіліміз қалды! Жалғыз асықпа!
Dialogue: 0,0:12:49.14,0:12:51.64,Default,,0,0,0,,Сигма дәл қазір қиындыққа тап болса да...
Dialogue: 0,0:12:51.72,0:12:53.64,Default,,0,0,0,,Рю Чанның...
Dialogue: 0,0:12:53.73,0:12:57.02,Default,,0,0,0,,Ақымақ тас бас~! Ууууу...
Dialogue: 0,0:12:57.10,0:12:58.61,Default,,0,0,0,,А... міне, солай!
Dialogue: 0,0:12:58.69,0:12:59.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:01.11,0:13:04.65,Default,,0,0,0,,Рахмет, Жасаши Бакуре.
Dialogue: 0,0:13:05.45,0:13:09.41,Default,,0,0,0,,Марито қайтып келгенше, біз Сигманы қорғаймыз!
Dialogue: 0,0:13:10.99,0:13:12.41,Default,,0,0,0,,Usu! (Бәкір) Иә!
Dialogue: 0,0:13:38.35,0:13:40.36,Default,,0,0,0,,Бұл жерден өтуге жол бермеңіз
Dialogue: 0,0:13:43.28,0:13:44.53,Default,,0,0,0,,Чи…
Dialogue: 0,0:13:44.61,0:13:47.07,Default,,0,0,0,,Неліктен сол күндерге оралдыңыз?
Dialogue: 0,0:13:49.62,0:13:50.78,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:50.87,0:13:55.16,Default,,0,0,0,,Мен Кен-санмен осылай күресе берсем, қайтып орала алмаймын!
Dialogue: 0,0:13:55.83,0:13:57.92,Default,,0,0,0,,Мен сені міндетті түрде тоқтатамын!
Dialogue: 0,0:13:58.54,0:14:00.92,Default,,0,0,0,,Ууууууууууууу!
Dialogue: 0,0:14:01.75,0:14:02.63,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:04.13,0:14:05.21,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:06.92,0:14:11.35,Default,,0,0,0,,Қарғыс атсын, неге! Жауап!
Dialogue: 0,0:14:11.43,0:14:12.68,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:14:12.76,0:14:13.93,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:14.81,0:14:16.14,Default,,0,0,0,,Гаха!
Dialogue: 0,0:14:16.73,0:14:21.15,Default,,0,0,0,,Ах... ка... каа...
Dialogue: 0,0:14:23.90,0:14:24.90,Default,,0,0,0,,Я...
Dialogue: 0,0:14:25.61,0:14:29.70,Default,,0,0,0,,Ұмыт... Ұмыттың ба...?
Dialogue: 0,0:14:29.78,0:14:30.91,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:14:33.28,0:14:34.41,Default,,0,0,0,,Бұлхо!
Dialogue: 0,0:14:36.12,0:14:39.79,Default,,0,0,0,,Есте сақта... маған бер...
Dialogue: 0,0:14:40.33,0:14:43.71,Default,,0,0,0,,Қайтып кел... маған бер...
Dialogue: 0,0:14:44.34,0:14:45.30,Default,,0,0,0,,Нағыз қазына...!
Dialogue: 0,0:14:45.38,0:14:46.21,Default,,0,0,0,,Гаха!
Dialogue: 0,0:14:52.55,0:14:54.60,Default,,0,0,0,,Мені жіберме...
Dialogue: 0,0:14:55.60,0:14:57.73,Default,,0,0,0,,Мүлдем...
Dialogue: 0,0:14:58.31,0:15:00.39,Default,,0,0,0,,Мені жіберме...!
Dialogue: 0,0:15:07.28,0:15:08.11,Default,,0,0,0,,(Түртіп алу дыбысы)
Dialogue: 0,0:15:14.49,0:15:15.62,Default,,0,0,0,,(аяқтың тарсылу дыбысы)
Dialogue: 0,0:15:21.17,0:15:24.25,Default,,0,0,0,,Сен... менікісің...
Dialogue: 0,0:15:25.17,0:15:27.13,Default,,0,0,0,,Нигга...
Dialogue: 0,0:15:30.88,0:15:31.72,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:32.68,0:15:34.93,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:15:35.01,0:15:38.56,Default,,0,0,0,,Ммммммммммммммммммммммммммм
Dialogue: 0,0:15:38.64,0:15:40.85,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:15:46.02,0:15:48.65,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:16:02.50,0:16:03.29,Default,,0,0,0,,Араджин! Сен менің досымсың!
Dialogue: 0,0:16:03.29,0:16:04.12,Default,,0,0,0,,Араджин! Сен менің досымсың!
Dialogue: 0,0:16:03.29,0:16:04.12,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:04.12,0:16:04.21,Default,,0,0,0,,Араджин! Сен менің досымсың!
Dialogue: 0,0:16:04.21,0:16:05.00,Default,,0,0,0,,Араджин! Сен менің досымсың!
Dialogue: 0,0:16:04.21,0:16:05.00,Default,,0,0,0,,(Баспалдақпен жүгіру дыбысы)
Dialogue: 0,0:16:05.00,0:16:05.08,Default,,0,0,0,,(Баспалдақпен жүгіру дыбысы)
Dialogue: 0,0:16:05.08,0:16:06.09,Default,,0,0,0,,(Баспалдақпен жүгіру дыбысы)
Dialogue: 0,0:16:05.08,0:16:06.09,Default,,0,0,0,,Сау бол, Джоджо!
Dialogue: 0,0:16:06.17,0:16:07.84,Default,,0,0,0,,Арапён!
Dialogue: 0,0:16:08.42,0:16:09.63,Default,,0,0,0,,Комао...
Dialogue: 0,0:16:09.71,0:16:10.92,Default,,0,0,0,,Жүр, кеттік!
Dialogue: 0,0:16:11.01,0:16:11.84,Default,,0,0,0,,Қайда?
Dialogue: 0,0:16:11.92,0:16:15.09,Default,,0,0,0,,Менің ойымша, Кен-сан мен Шинпоны біріктіреді деп шешті!
Dialogue: 0,0:16:15.18,0:16:18.18,Default,,0,0,0,,Асығыңыз, асығыңыз! Бұл басталғалы жатыр!
Dialogue: 0,0:16:18.26,0:16:21.27,Default,,0,0,0,,Барма. Мен неге...
Dialogue: 0,0:16:21.35,0:16:22.60,Default,,0,0,0,,Бару себебі...
Dialogue: 0,0:16:23.23,0:16:25.31,Default,,0,0,0,,Өйткені ол нағыз қазына жігіті.
Dialogue: 0,0:16:38.53,0:16:40.45,Default,,0,0,0,,Егер жеңілсең мен сені кешірмеймін
Dialogue: 0,0:16:40.54,0:16:43.33,Default,,0,0,0,,Себебі сені жеңетін менмін...!
Dialogue: 0,0:16:51.09,0:16:54.84,Default,,0,0,0,,Сені жеңу арқылы мен күшейемін!
Dialogue: 0,0:16:57.43,0:16:59.47,Default,,0,0,0,,Ха... Мен оны уақытында жасадым.
Dialogue: 0,0:16:59.56,0:17:01.35,Default,,0,0,0,,Иә? Жастық ше?
Dialogue: 0,0:17:10.36,0:17:13.36,Default,,0,0,0,,Оны ата-анасы тастап кеткен.
Dialogue: 0,0:17:14.61,0:17:20.12,Default,,0,0,0,,Шинпоны тәрбиелеген оның ағасы Манкоу болды.
Dialogue: 0,0:17:21.95,0:17:27.29,Default,,0,0,0,,Бірақ бір күні Манкоу достарына көмектесті.
Dialogue: 0,0:17:27.37,0:17:30.46,Default,,0,0,0,,Кіші санатқа кіруге шешім қабылдады
Dialogue: 0,0:17:30.96,0:17:34.38,Default,,0,0,0,,Махо өзін қолдаған ағасынан айырылды.
Dialogue: 0,0:17:35.63,0:17:38.64,Default,,0,0,0,,Өзімді жоғалттым
Dialogue: 0,0:17:38.72,0:17:40.14,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:44.85,0:17:47.94,Default,,0,0,0,,А... неге мүлде ештеңе істемейсің!
Dialogue: 0,0:17:48.02,0:17:52.23,Default,,0,0,0,,Аузыңды жап, қара! Фист-санның жеңіліп қалуы мүмкін емес.
Dialogue: 0,0:17:52.32,0:17:53.32,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:54.07,0:17:55.49,Default,,0,0,0,,Гухо...
Dialogue: 0,0:17:55.57,0:17:56.99,Default,,0,0,0,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,0:18:01.58,0:18:02.41,Default,,0,0,0,,Хмм.
Dialogue: 0,0:18:02.49,0:18:03.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:04.41,0:18:07.08,Default,,0,0,0,,Қарғыс атсын... Уау!
Dialogue: 0,0:18:09.96,0:18:12.67,Default,,0,0,0,,Арх! Ха! Тааа!
Dialogue: 0,0:18:12.75,0:18:14.05,Default,,0,0,0,,Ш...
Dialogue: 0,0:18:14.13,0:18:15.71,Default,,0,0,0,,Хамф!
Dialogue: 0,0:18:16.22,0:18:17.09,Default,,0,0,0,,Гаха!
Dialogue: 0,0:18:18.22,0:18:19.38,Default,,0,0,0,,Гррр…
Dialogue: 0,0:18:20.18,0:18:21.55,Default,,0,0,0,,О!
Dialogue: 0,0:18:22.05,0:18:23.97,Default,,0,0,0,,А... а...
Dialogue: 0,0:18:24.06,0:18:25.72,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:18:25.81,0:18:27.73,Default,,0,0,0,,Нууууууу...!
Dialogue: 0,0:18:28.31,0:18:29.39,Default,,0,0,0,,2-раунд, 1-жекпе-жек
Dialogue: 0,0:18:30.48,0:18:32.69,Default,,0,0,0,,Тістеріңізді қысыңыз!
Dialogue: 0,0:18:32.77,0:18:34.57,Default,,0,0,0,,Нуаааааааааааааааааааааааааааааааааааааааа...!
Dialogue: 0,0:18:34.65,0:18:37.15,Default,,0,0,0,,Мен бұрыннан…
Dialogue: 0,0:18:37.24,0:18:40.53,Default,,0,0,0,,Ол кездегіден басқаша!
Dialogue: 0,0:18:41.87,0:18:45.79,Default,,0,0,0,,Мен сені жеңіп, күшейемін...!
Dialogue: 0,0:18:49.33,0:18:53.75,Default,,0,0,0,,Маған күш беріңіз...
Dialogue: 0,0:18:56.21,0:18:58.05,Default,,0,0,0,,Бутчигири
Dialogue: 0,0:18:59.22,0:19:02.51,Default,,0,0,0,,Ууууууууу! (Бір түн) Киеееееее!
Dialogue: 0,0:19:02.59,0:19:04.01,Default,,0,0,0,,О!
Dialogue: 0,0:19:06.10,0:19:07.93,Default,,0,0,0,,Гррр...
Dialogue: 0,0:19:08.02,0:19:09.18,Default,,0,0,0,,Хехехе… Біраз мақтанып қояйын
Dialogue: 0,0:19:09.27,0:19:10.44,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:10.52,0:19:13.52,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:13.61,0:19:14.61,Default,,0,0,0,,Хун
Dialogue: 0,0:19:14.69,0:19:15.52,Default,,0,0,0,,Иә! (Кенитиро) Арх!
Dialogue: 0,0:19:21.53,0:19:22.66,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:34.54,0:19:36.21,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:19:36.30,0:19:38.46,Default,,0,0,0,,Қарғыс атсын! Апыр-ай!
Dialogue: 0,0:19:38.55,0:19:40.13,Default,,0,0,0,,Құла!
Dialogue: 0,0:19:40.97,0:19:43.34,Default,,0,0,0,,Жығыл, құла, құла, құла
Dialogue: 0,0:19:43.43,0:19:45.51,Default,,0,0,0,,Құлау Құлау Құлау
Dialogue: 0,0:19:45.60,0:19:47.68,Default,,0,0,0,,Құла, құла!
Dialogue: 0,0:19:47.76,0:19:50.98,Default,,0,0,0,,Құла!
Dialogue: 0,0:19:51.56,0:19:53.06,Default,,0,0,0,,Кеничиро
Dialogue: 0,0:19:53.15,0:19:56.73,Default,,0,0,0,,Маған бірдеңе болса, шын қазынаны сұраймын.
Dialogue: 0,0:19:56.82,0:19:57.82,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:00.03,0:20:01.03,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:14.67,0:20:17.29,Default,,0,0,0,,Хаха...
Dialogue: 0,0:20:48.62,0:20:50.49,Default,,0,0,0,,Бірдеңе болған жағдайда...
Dialogue: 0,0:20:50.99,0:20:53.41,Default,,0,0,0,,Сіз нағыз қазынаны тоқтатасыз.
Dialogue: 0,0:20:54.75,0:20:56.54,Default,,0,0,0,,Маған солай істе...
Dialogue: 0,0:20:56.63,0:20:58.25,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:20:58.34,0:20:59.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:00.80,0:21:02.42,Default,,0,0,0,,Б-бірақ егер бұл орын түсіп қалса…
Dialogue: 0,0:21:03.42,0:21:05.59,Default,,0,0,0,,Осы жұдырықпен
Dialogue: 0,0:21:15.19,0:21:16.44,Default,,0,0,0,,Қазір...
Dialogue: 0,0:21:17.10,0:21:19.44,Default,,0,0,0,,Мен сенімен күресе аламын...!
Dialogue: 0,0:21:24.07,0:21:26.07,Default,,0,0,0,,Уақыт келді...
Dialogue: 0,0:21:26.57,0:21:29.45,Default,,0,0,0,,Чиямен кездесейік!
Dialogue: 0,0:21:42.55,0:21:44.17,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:21:58.48,0:22:01.61,Default,,0,0,0,,Мен Маджин Чиямын
Dialogue: 0,0:22:01.69,0:22:04.65,Default,,0,0,0,,Жүр, қалағаныңды айт.
Dialogue: 0,0:22:05.44,0:22:06.45,Default,,0,0,0,,О!
Dialogue: 0,0:22:08.95,0:22:10.16,Default,,0,0,0,,Чия
Dialogue: 0,0:22:12.37,0:22:14.12,Default,,0,0,0,,Бірлейік
Dialogue: 0,0:22:16.00,0:22:20.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:42.12,0:23:45.92,Default,,0,0,0,,～♪
Dialogue: 0,0:23:46.00,0:23:49.05,Default,,0,0,0,,Оны да келесі аптада жарып жібереміз!
Dialogue: 0,0:23:50.55,0:23:56.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
