Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.30,0:00:06.80,Default,,0,0,0,,Эрика. Un?
Dialogue: 0,0:00:06.80,0:00:09.30,Default,,0,0,0,,Бірінші турдан өткеніңізбен құттықтаймыз.
Dialogue: 0,0:00:09.30,0:00:11.27,Default,,0,0,0,,Рахмет➡
Dialogue: 0,0:00:11.27,0:00:13.31,Default,,0,0,0,,Сіз қобалжымайтын сияқтысыз.
Dialogue: 0,0:00:13.31,0:00:16.28,Default,,0,0,0,,Шаршағаным сонша, қобалжуға уақытым жоқ.
Dialogue: 0,0:00:28.32,0:00:30.29,Default,,0,0,0,,Мен...басқа екі адаммен ауруханадамын➡
Dialogue: 0,0:00:30.29,0:00:32.29,Default,,0,0,0,,Мен люкс финалды көргенде➡
Dialogue: 0,0:00:32.29,0:00:34.80,Default,,0,0,0,,Мен сені Авангардты ойнағың келеді деп ойладым.
Dialogue: 0,0:00:34.80,0:00:37.33,Default,,0,0,0,,Түсіндім, сен осыны айтып тұрсың.
Dialogue: 0,0:00:37.33,0:00:40.30,Default,,0,0,0,,Сонымен, мен ауруханадан шыққан бойда карталарды жинай бастадым.
Dialogue: 0,0:00:40.30,0:00:42.27,Default,,0,0,0,,Un.
Dialogue: 0,0:00:43.31,0:00:46.81,Default,,0,0,0,,Мен үшін люкс кезеңі ерекше.
Dialogue: 0,0:00:48.81,0:00:52.85,Default,,0,0,0,,Ендеше Ақина, жеңіп, финалда күресейік.
Dialogue: 0,0:00:52.85,0:00:54.78,Default,,0,0,0,,Қорытынды….
Dialogue: 0,0:00:54.78,0:00:56.79,Default,,0,0,0,,Мен қазір не істеп жатқанымды білмеймін➡
Dialogue: 0,0:00:56.79,0:00:59.29,Default,,0,0,0,,Мүмкін екеуің де қарап отырған шығарсыңдар.
Dialogue: 0,0:00:59.29,0:01:01.79,Default,,0,0,0,,Сондықтан мен ең жақсы жекпе-жек өткізгім келеді➡
Dialogue: 0,0:01:01.79,0:01:05.33,Default,,0,0,0,,Акина сол кездегі ең жақсы қарсылас!
Dialogue: 0,0:01:05.33,0:01:08.30,Default,,0,0,0,,Бұл тамаша. Финалда өнер көрсетейік!
Dialogue: 0,0:01:09.33,0:01:12.30,Default,,0,0,0,,Әрине? Маған қалдырыңыз!
Dialogue: 0,0:02:50.27,0:02:52.27,Default,,0,0,0,,Қага Есіңде ме?
Dialogue: 0,0:02:52.27,0:02:54.74,Default,,0,0,0,,Кейбір нәрселер мен оларға қарамай тұрып өзгерді➡
Dialogue: 0,0:02:54.74,0:02:56.77,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:02:56.77,0:03:00.24,Default,,0,0,0,,Бірақ Blackout-тағылардың бәрі мүлде өзгерген жоқ➡
Dialogue: 0,0:03:00.24,0:03:02.74,Default,,0,0,0,,Мегуми де.
Dialogue: 0,0:03:02.74,0:03:05.25,Default,,0,0,0,,Прогресс жоқ па? Жоқ, жоқ! ➡
Dialogue: 0,0:03:05.25,0:03:08.25,Default,,0,0,0,,Бұл тыныштандырады, дәлірек айтсақ жылы...
Dialogue: 0,0:03:08.25,0:03:10.22,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:03:11.25,0:03:13.26,Default,,0,0,0,,Мен өзім жақсымын➡
Dialogue: 0,0:03:13.26,0:03:15.79,Default,,0,0,0,,Менің ойымша, бәрі өзгерді. жұмысшы?
Dialogue: 0,0:03:15.79,0:03:19.26,Default,,0,0,0,,Бұл нүктеге жету оңай болған жоқ.
Dialogue: 0,0:03:20.76,0:03:24.23,Default,,0,0,0,,Мен ешқашан жеңіле алмайтын шайқастарда талай рет жеңілдім.
Dialogue: 0,0:03:24.23,0:03:27.74,Default,,0,0,0,,Қанша уайымдасаңыз да, қанша тырыссаңыз да➡
Dialogue: 0,0:03:27.74,0:03:29.74,Default,,0,0,0,,Міндетті түрде марапаттау қажет емес.
Dialogue: 0,0:03:31.24,0:03:34.28,Default,,0,0,0,,Мен өзімді көңілсіз және аянышты сезінемін...
Dialogue: 0,0:03:34.28,0:03:36.75,Default,,0,0,0,,Мен түні бойы жыладым ба деп ойлаймын.
Dialogue: 0,0:03:38.75,0:03:42.28,Default,,0,0,0,,Бірақ мен Wonder Hill-ге келіп, барлығымен кездескен кезде➡
Dialogue: 0,0:03:42.28,0:03:45.75,Default,,0,0,0,,Мен келесі жолы, бұл жолы жеңілмеймін! Мен осылай сезінемін.
Dialogue: 0,0:03:46.76,0:03:49.76,Default,,0,0,0,,Құлап қалсаң да, тегін тұрмайсың.
Dialogue: 0,0:03:49.76,0:03:52.76,Default,,0,0,0,,Бұл Аники, Томари Туя➡
Dialogue: 0,0:03:52.76,0:03:55.30,Default,,0,0,0,,Ал мен Ююден үйренгенім.
Dialogue: 0,0:03:55.30,0:03:58.73,Default,,0,0,0,,Бұл жолы мен Deluxe чемпионатын ұтып аламын!
Dialogue: 0,0:03:58.73,0:04:00.84,Default,,0,0,0,,Сәлем, мен сені қолдаймын!
Dialogue: 0,0:04:00.84,0:04:03.74,Default,,0,0,0,,Мегуми-сан Юйю-сан!
Dialogue: 0,0:04:03.74,0:04:05.91,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:04:05.91,0:04:08.24,Default,,0,0,0,,Сіз жақсы көрінесіз. Сіз шоғырланып жатырсыз.
Dialogue: 0,0:04:08.24,0:04:11.25,Default,,0,0,0,,Керемет екен, әпке!
Dialogue: 0,0:04:11.25,0:04:13.75,Default,,0,0,0,,Біз қызу тартысты көретін сияқтымыз.
Dialogue: 0,0:04:13.75,0:04:15.75,Default,,0,0,0,,Ал, оны асыға күтуге болады!
Dialogue: 0,0:04:15.75,0:04:18.75,Default,,0,0,0,,Көшбасшы сенімді! ➡
Dialogue: 0,0:04:18.75,0:04:20.79,Default,,0,0,0,,Жарайды, егер бұл орын алса, сіз жеңесіз!
Dialogue: 0,0:04:20.79,0:04:24.26,Default,,0,0,0,,Блэкут осында екенін әлемге білдірейік!
Dialogue: 0,0:04:24.26,0:04:27.26,Default,,0,0,0,,Хехе...Барлықтарыңызға рахмет➡
Dialogue: 0,0:04:27.26,0:04:30.23,Default,,0,0,0,,Бұл қуану менің күшіме айналады! ➡
Dialogue: 0,0:04:30.23,0:04:32.27,Default,,0,0,0,,Бірге күресейік➡
Dialogue: 0,0:04:32.27,0:04:34.74,Default,,0,0,0,,Team Blackout, міне кеттік!
Dialogue: 0,0:04:34.74,0:04:37.74,Default,,0,0,0,,Кету!
Dialogue: 0,0:04:39.24,0:04:41.78,Default,,0,0,0,,Бұл жақсы команда.
Dialogue: 0,0:04:41.78,0:04:45.25,Default,,0,0,0,,Шығу тегі мен тәрбиесі әртүрлі түстер жиынтығы.
Dialogue: 0,0:04:45.25,0:04:47.75,Default,,0,0,0,,Ондай адамдардың араласып кетуінің ақырғы нәтижесі➡
Dialogue: 0,0:04:47.75,0:04:50.82,Default,,0,0,0,,Қарадан қара Ол қою қара түнекке айналады.
Dialogue: 0,0:04:50.82,0:04:53.26,Default,,0,0,0,,Сондықтан өшіп қалды.
Dialogue: 0,0:04:53.26,0:04:55.76,Default,,0,0,0,,Миёко-сан тағы да жақсы есім.
Dialogue: 0,0:04:55.76,0:04:58.26,Default,,0,0,0,,Керемет!
Dialogue: 0,0:04:58.26,0:05:00.26,Default,,0,0,0,,Иә! Аннего➡
Dialogue: 0,0:05:00.26,0:05:02.76,Default,,0,0,0,,Құдай, Будда, Миёко-сама!
Dialogue: 0,0:05:02.76,0:05:06.74,Default,,0,0,0,,Хаха! Бұл бұрынғыдай емес➡
Dialogue: 0,0:05:06.74,0:05:09.74,Default,,0,0,0,,Атмосфера өзгерген сияқты.
Dialogue: 0,0:05:09.74,0:05:11.74,Default,,0,0,0,,Содан бері көп нәрсе болды.
Dialogue: 0,0:05:13.24,0:05:15.24,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:15.24,0:05:17.25,Default,,0,0,0,,Барлығына! ➡
Dialogue: 0,0:05:17.25,0:05:19.25,Default,,0,0,0,,Көптен бері көрмеген.
Dialogue: 0,0:05:19.25,0:05:21.25,Default,,0,0,0,,Таками!
Dialogue: 0,0:05:21.25,0:05:23.25,Default,,0,0,0,,Мен ақыры жұмыс таптым.
Dialogue: 0,0:05:23.25,0:05:25.75,Default,,0,0,0,,Такамин! Мүшелер арасында➡
Dialogue: 0,0:05:25.75,0:05:28.89,Default,,0,0,0,,Қоғамның лайықты мүшесі болған сирек кейіпкер!
Dialogue: 0,0:05:28.89,0:05:31.76,Default,,0,0,0,,Мен үшін сендер сирек кездесетін кейіпкерсіңдер.
Dialogue: 0,0:05:31.76,0:05:35.26,Default,,0,0,0,,Хэхе! Бір минут күтіңіз! ➡
Dialogue: 0,0:05:35.26,0:05:37.77,Default,,0,0,0,,Мұнда да қоғамның лайықты мүшелері бар!
Dialogue: 0,0:05:37.77,0:05:41.24,Default,,0,0,0,,Томари! Бастапқы мүшелер енді аяқталды!
Dialogue: 0,0:05:42.24,0:05:45.24,Default,,0,0,0,,Blackout...Сол кезде құрылған команда➡
Dialogue: 0,0:05:45.24,0:05:47.74,Default,,0,0,0,,Мен бұл ұзаққа созылады деп күтпедім.
Dialogue: 0,0:05:47.74,0:05:50.75,Default,,0,0,0,,Сенің қарындасың көп жұмыс істейді.
Dialogue: 0,0:05:50.75,0:05:52.75,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:05:54.75,0:05:57.25,Default,,0,0,0,,Айтайын дегенім, Томари, кетейін бе?
Dialogue: 0,0:05:57.25,0:05:59.75,Default,,0,0,0,,Жарайды...!
Dialogue: 0,0:06:01.79,0:06:04.79,Default,,0,0,0,,Ым? Іскерлік байланыс➡
Dialogue: 0,0:06:04.79,0:06:07.26,Default,,0,0,0,,Томари Сето, тез арада штабқа келіңіз.
Dialogue: 0,0:06:07.26,0:06:09.73,Default,,0,0,0,,Цк. Бұл жақсы емес ...
Dialogue: 0,0:06:11.33,0:06:13.27,Default,,0,0,0,,Мегуми Окура➡
Dialogue: 0,0:06:13.27,0:06:15.24,Default,,0,0,0,,Ең күшті Blackout командасының көшбасшысы болыңыз➡
Dialogue: 0,0:06:15.24,0:06:17.77,Default,,0,0,0,,Өнерпаздарды да ұятқа қалдыратын дарынды адам.
Dialogue: 0,0:06:17.77,0:06:19.74,Default,,0,0,0,,Елеулі Біз мұқият болуымыз керек.
Dialogue: 0,0:06:19.74,0:06:21.74,Default,,0,0,0,,Дұрыс! о! ➡
Dialogue: 0,0:06:21.74,0:06:23.75,Default,,0,0,0,,Сіз уайымдаудың қажеті жоқ сияқты сезінесіз бе?
Dialogue: 0,0:06:23.75,0:06:26.75,Default,,0,0,0,,Жарайды... онда мәселе осында.
Dialogue: 0,0:06:26.75,0:06:28.72,Default,,0,0,0,,Бір нәрсе басталды!
Dialogue: 0,0:06:38.76,0:06:40.73,Default,,0,0,0,,Мұнда ше?
Dialogue: 0,0:06:43.30,0:06:46.74,Default,,0,0,0,,Сіз өте сабырлысыз. Енді түсіндің бе?
Dialogue: 0,0:06:46.74,0:06:50.24,Default,,0,0,0,,Мен түсінемін, әзірге алаңдайтын ештеңе жоқ.
Dialogue: 0,0:06:50.24,0:06:52.24,Default,,0,0,0,,Олай болса, Аки-кун➡
Dialogue: 0,0:06:52.24,0:06:54.24,Default,,0,0,0,,Маған бар күшіңмен шабуыл жаса!
Dialogue: 0,0:06:55.74,0:06:57.71,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:58.75,0:07:01.75,Default,,0,0,0,,Енді келесі жекпе-жек...!
Dialogue: 0,0:07:02.75,0:07:05.75,Default,,0,0,0,,Команданың көшбасшысы Blackout! ➡
Dialogue: 0,0:07:05.75,0:07:07.76,Default,,0,0,0,,Дөрекі ұлдарды бағындырыңыз➡
Dialogue: 0,0:07:07.76,0:07:10.26,Default,,0,0,0,,Қойой да жауды тістейді➡
Dialogue: 0,0:07:10.26,0:07:14.26,Default,,0,0,0,,Қараңғылық аңы Мегуми Окура!
Dialogue: 0,0:07:14.26,0:07:16.23,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:07:16.23,0:07:18.23,Default,,0,0,0,,Мегуми~!
Dialogue: 0,0:07:18.23,0:07:20.74,Default,,0,0,0,,Сәлем Сейно...!
Dialogue: 0,0:07:20.74,0:07:24.74,Default,,0,0,0,,Мегуми~Төбелес~!
Dialogue: 0,0:07:25.74,0:07:28.74,Default,,0,0,0,,Мен үйреніп қалдым. Хехе...
Dialogue: 0,0:07:29.74,0:07:32.25,Default,,0,0,0,,Сәлеметсіз бе! ➡
Dialogue: 0,0:07:32.25,0:07:34.25,Default,,0,0,0,,Ең танымал өрескел тас –➡
Dialogue: 0,0:07:34.25,0:07:36.79,Default,,0,0,0,,Ол алмаз болды ма? ➡
Dialogue: 0,0:07:36.79,0:07:39.75,Default,,0,0,0,,Бүгін де маған 10 караттық ғажайыпты көрсет! ➡
Dialogue: 0,0:07:39.75,0:07:41.76,Default,,0,0,0,,Акина Мейдо!
Dialogue: 0,0:07:41.76,0:07:43.76,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:43.76,0:07:46.80,Default,,0,0,0,,Акина~Мен сенімен біргемін~!
Dialogue: 0,0:07:46.80,0:07:49.26,Default,,0,0,0,,Үлкен аға! (Юна/Микото) Сәттілік!
Dialogue: 0,0:08:02.24,0:08:04.75,Default,,0,0,0,,Сол кезде палубаны көтерген сенімен➡
Dialogue: 0,0:08:04.75,0:08:07.25,Default,,0,0,0,,Мен мұнда ұрысатынымызға сене алар емеспін.
Dialogue: 0,0:08:07.25,0:08:09.75,Default,,0,0,0,,Сәлем! Сол кезден➡
Dialogue: 0,0:08:09.75,0:08:11.72,Default,,0,0,0,,Менің авангардым басталды.
Dialogue: 0,0:08:13.29,0:08:16.73,Default,,0,0,0,,Мегуми-сан да маған жол көрсеткен адамдардың бірі.
Dialogue: 0,0:08:16.73,0:08:19.73,Default,,0,0,0,,Мұны естігеніме қуаныштымын.
Dialogue: 0,0:08:22.76,0:08:25.23,Default,,0,0,0,,Өкінбей күресейік!
Dialogue: 0,0:08:25.23,0:08:27.27,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:08:27.27,0:08:30.24,Default,,0,0,0,,Финалдық турнир 4-ші матч➡
Dialogue: 0,0:08:30.24,0:08:32.24,Default,,0,0,0,,Келейік...фай!
Dialogue: 0,0:08:37.25,0:08:40.25,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:08:40.25,0:08:42.25,Default,,0,0,0,,Ағаш мүйізді аң Роте.
Dialogue: 0,0:08:42.25,0:08:44.25,Default,,0,0,0,,Амбиция қанаттары Соел.
Dialogue: 0,0:08:44.25,0:08:47.26,Default,,0,0,0,,Менің кезегім Шалиске міну➡
Dialogue: 0,0:08:47.26,0:08:50.26,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім➡
Dialogue: 0,0:08:50.26,0:08:52.23,Default,,0,0,0,,Вентестамен жүру➡
Dialogue: 0,0:08:52.23,0:08:55.26,Default,,0,0,0,,Бентестамен шабуыл! Күзетші жоқ.
Dialogue: 0,0:08:55.26,0:08:57.23,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:08:57.23,0:09:00.24,Default,,0,0,0,,Мотивация Менде жеткілікті сияқты.
Dialogue: 0,0:09:00.24,0:09:03.24,Default,,0,0,0,,Менің бұрылысымдағы торға мініңіз➡
Dialogue: 0,0:09:03.24,0:09:05.24,Default,,0,0,0,,Фраппойға шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:09:05.24,0:09:08.24,Default,,0,0,0,,Гюносураға сол шеберлікпен қоңырау шалыңыз.
Dialogue: 0,0:09:08.24,0:09:10.25,Default,,0,0,0,,Флаппоимен шабуыл!
Dialogue: 0,0:09:10.25,0:09:12.25,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:09:12.25,0:09:15.25,Default,,0,0,0,,Тормен шабуыл. күзетші.
Dialogue: 0,0:09:15.25,0:09:18.32,Default,,0,0,0,,Гюносурамен шабуыл. күзетші!
Dialogue: 0,0:09:18.32,0:09:20.26,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:09:20.26,0:09:22.26,Default,,0,0,0,,Ыстық болғаны сонша, жанып кете жаздады➡
Dialogue: 0,0:09:22.26,0:09:25.26,Default,,0,0,0,,Сізге тартылу сезімі➡
Dialogue: 0,0:09:25.26,0:09:27.73,Default,,0,0,0,,Бұл Мегумидің қазіргі жекпе-жегі!
Dialogue: 0,0:09:31.37,0:09:35.24,Default,,0,0,0,,)
Dialogue: 0,0:09:35.24,0:09:37.74,Default,,0,0,0,,Одан да қызып алайық.
Dialogue: 0,0:09:37.74,0:09:41.24,Default,,0,0,0,,Әрине, алда әлі талай жол бар!
Dialogue: 0,0:09:41.24,0:09:43.31,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:09:43.31,0:09:45.25,Default,,0,0,0,,Азенсиорға барыңыз!
Dialogue: 0,0:09:45.25,0:09:47.75,Default,,0,0,0,,Жанның Вентестасына қоңырау шалыңыз.
Dialogue: 0,0:09:47.75,0:09:49.75,Default,,0,0,0,,Impervious➡ қоңырау шалыңыз
Dialogue: 0,0:09:49.75,0:09:52.25,Default,,0,0,0,,Дағдылар арқылы өз күшіңізді 5000-ға арттырыңыз!
Dialogue: 0,0:09:52.25,0:09:54.26,Default,,0,0,0,,Азеншиормен шабуыл!
Dialogue: 0,0:09:54.26,0:09:56.26,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:09:56.26,0:09:58.26,Default,,0,0,0,,Өткізбейтін шабуыл!
Dialogue: 0,0:09:58.26,0:10:00.73,Default,,0,0,0,,Флаппои шеберлігін белсендіру➡
Dialogue: 0,0:10:00.73,0:10:04.73,Default,,0,0,0,,Тордың қуаты плюс 10 000! Ол сізге жетпейді.
Dialogue: 0,0:10:04.73,0:10:07.74,Default,,0,0,0,,U...кезеңнің соңы.
Dialogue: 0,0:10:09.74,0:10:11.74,Default,,0,0,0,,Ах...!
Dialogue: 0,0:10:11.74,0:10:14.74,Default,,0,0,0,,Кәне, дайындалайық!
Dialogue: 0,0:10:14.74,0:10:16.78,Default,,0,0,0,,Менің кезегім! ➡
Dialogue: 0,0:10:16.78,0:10:20.25,Default,,0,0,0,,Гүрілдеген, тербеткен ағаштар теңізі➡
Dialogue: 0,0:10:20.25,0:10:22.25,Default,,0,0,0,,Көк күркіре!
Dialogue: 0,0:10:24.75,0:10:27.26,Default,,0,0,0,,Ағаш мүйізді аң Император Магнолия Патриархы➡
Dialogue: 0,0:10:27.26,0:10:29.22,Default,,0,0,0,,Жүр!
Dialogue: 0,0:10:37.27,0:10:39.77,Default,,0,0,0,,Каралкейлге шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:10:39.77,0:10:42.27,Default,,0,0,0,,Палубаның ең жақсы 7 картасынан бастау үшін осы дағдыны пайдаланыңыз➡
Dialogue: 0,0:10:42.27,0:10:44.77,Default,,0,0,0,,Қолыңызға магнолия қосыңыз.
Dialogue: 0,0:10:44.77,0:10:48.24,Default,,0,0,0,,Dark Night➡ тапсырыс картасын пайдаланыңыз
Dialogue: 0,0:10:48.24,0:10:50.25,Default,,0,0,0,,Тамшыдан Фраппойға қоңырау шалыңыз➡
Dialogue: 0,0:10:50.25,0:10:52.75,Default,,0,0,0,,Сонымен қатар, Альпинді сол шеберлікпен шақырыңыз.
Dialogue: 0,0:10:52.75,0:10:54.75,Default,,0,0,0,,Аң патшасы➡ пәрмен береді
Dialogue: 0,0:10:54.75,0:10:57.75,Default,,0,0,0,,Жауды жою үшін бір кісідей әрекет ет!
Dialogue: 0,0:10:57.75,0:10:59.75,Default,,0,0,0,,Магнолия шеберлігін белсендіру.
Dialogue: 0,0:10:59.75,0:11:03.26,Default,,0,0,0,,Екі артқы қорғаушы артқы қатардан шабуыл жасай алады!
Dialogue: 0,0:11:03.26,0:11:05.26,Default,,0,0,0,,Магнолиямен шабуыл!
Dialogue: 0,0:11:05.26,0:11:07.26,Default,,0,0,0,,Өткізбейтін кесу➡
Dialogue: 0,0:11:07.26,0:11:09.26,Default,,0,0,0,,Шеберлікпен +10000 қалқан!
Dialogue: 0,0:11:09.26,0:11:11.27,Default,,0,0,0,,Қос жетек➡
Dialogue: 0,0:11:11.27,0:11:13.77,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:11:13.77,0:11:16.27,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:11:16.27,0:11:19.77,Default,,0,0,0,,Триггер Гюносураның қуатын сызыңыз және 10000 қосыңыз!
Dialogue: 0,0:11:19.77,0:11:22.74,Default,,0,0,0,,Флаппоимен шабуыл! күзетші!
Dialogue: 0,0:11:22.74,0:11:24.75,Default,,0,0,0,,Гюносурамен шабуыл! ➡
Dialogue: 0,0:11:24.75,0:11:26.75,Default,,0,0,0,,Каралкейлдің күші +20 000 шеберлікпен!
Dialogue: 0,0:11:26.75,0:11:28.75,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:11:28.75,0:11:31.25,Default,,0,0,0,,Альпімен шабуыл! күзетші!
Dialogue: 0,0:11:31.25,0:11:33.25,Default,,0,0,0,,Каралкейлмен шабуыл!
Dialogue: 0,0:11:33.25,0:11:35.26,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:11:35.26,0:11:37.26,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:11:38.79,0:11:42.26,Default,,0,0,0,,А... Мен бұл аздап зиян келтіреді деп ойладым.
Dialogue: 0,0:11:42.26,0:11:45.27,Default,,0,0,0,,Басқа адамға да оңай болмайды.
Dialogue: 0,0:11:45.27,0:11:47.74,Default,,0,0,0,,Әй, ұрыс осы жерден басталады!
Dialogue: 0,0:11:48.80,0:11:51.74,Default,,0,0,0,,Оны қанша күзетсең де, қолыңдағы көп картаны жоғалтып алдың.
Dialogue: 0,0:11:51.74,0:11:54.74,Default,,0,0,0,,Иә, бірақ бұл Акина болса...
Dialogue: 0,0:11:57.81,0:12:00.75,Default,,0,0,0,,Мен мұны істеймін. Бұл жұмыс істеді.
Dialogue: 0,0:12:00.75,0:12:03.75,Default,,0,0,0,,Хехе... Менімен бірге боласың ба? ➡
Dialogue: 0,0:12:03.75,0:12:07.26,Default,,0,0,0,,Жазалаңдар! Енді сіздің кезегіңіз➡
Dialogue: 0,0:12:07.26,0:12:09.76,Default,,0,0,0,,Маған қолыңнан келгенше ұр!
Dialogue: 0,0:12:09.76,0:12:12.26,Default,,0,0,0,,Кеттік, менің кезегім➡
Dialogue: 0,0:12:12.26,0:12:15.30,Default,,0,0,0,,Құтқару қанаттары Міне, көктен!
Dialogue: 0,0:12:15.30,0:12:17.77,Default,,0,0,0,,Резаелдің ғажайып тағдырына мініңіз!
Dialogue: 0,0:12:22.77,0:12:25.27,Default,,0,0,0,,Azensior шеберлігін белсендіру➡
Dialogue: 0,0:12:25.27,0:12:27.28,Default,,0,0,0,,Құтқарылу қанаттарымен ұшыңдар➡
Dialogue: 0,0:12:27.28,0:12:29.78,Default,,0,0,0,,Айдан келген нағыз аң➡
Dialogue: 0,0:12:29.78,0:12:32.78,Default,,0,0,0,,Аспанда жарқырап тұрған тағы бір керемет!
Dialogue: 0,0:12:34.75,0:12:36.78,Default,,0,0,0,,Қоңырау➡
Dialogue: 0,0:12:36.78,0:12:39.29,Default,,0,0,0,,Ғажайып иллюзиондық аң Рифистор!
Dialogue: 0,0:12:42.79,0:12:44.76,Default,,0,0,0,,Сол дағдымен➡
Dialogue: 0,0:12:44.76,0:12:47.26,Default,,0,0,0,,Резаэль Витаны қолыңызға қосыңыз!
Dialogue: 0,0:12:47.26,0:12:49.26,Default,,0,0,0,,Импервиозға қоңырау шалыңыз.
Dialogue: 0,0:12:49.26,0:12:52.77,Default,,0,0,0,,Rifistor көмегімен шабуыл! күзетші.
Dialogue: 0,0:12:52.77,0:12:55.77,Default,,0,0,0,,Резаэльмен шабуыл! Дағдыларды белсендіру➡
Dialogue: 0,0:12:55.77,0:12:58.31,Default,,0,0,0,,Impervious және Catellus деп атаңыз.
Dialogue: 0,0:12:58.31,0:13:01.24,Default,,0,0,0,,Резаэльдің шеберлігі арқылы Өтпейтінді шақырғанда➡
Dialogue: 0,0:13:01.24,0:13:03.28,Default,,0,0,0,,Қуат плюс 10000!
Dialogue: 0,0:13:03.28,0:13:05.75,Default,,0,0,0,,Сонымен қатар, Резаэльдің күші Кателлустың шеберлігімен ➡
Dialogue: 0,0:13:05.75,0:13:07.75,Default,,0,0,0,,Плюс 10 000!\NЕгер бұл
Dialogue: 0,0:13:07.75,0:13:10.25,Default,,0,0,0,,болса, ол да қосылған!
Dialogue: 0,0:13:10.25,0:13:13.76,Default,,0,0,0,,Flappoy шеберлігі Магнолия қуаты +10000➡
Dialogue: 0,0:13:13.76,0:13:15.76,Default,,0,0,0,,Көбірек күзет!
Dialogue: 0,0:13:16.76,0:13:18.73,Default,,0,0,0,,Қос жетек! ➡
Dialogue: 0,0:13:18.73,0:13:21.26,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:13:21.26,0:13:23.80,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:13:23.80,0:13:26.77,Default,,0,0,0,,Критикалық триггер! Өткізбейтін қуат плюс 10000➡
Dialogue: 0,0:13:26.77,0:13:28.80,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:13:28.80,0:13:31.77,Default,,0,0,0,,Өткізбейтін шабуыл! Күзет жоқ!
Dialogue: 0,0:13:32.77,0:13:36.24,Default,,0,0,0,,Бұл сүйікті! Catellus күшейту➡
Dialogue: 0,0:13:36.24,0:13:38.25,Default,,0,0,0,,Өткізбейтін шабуыл!
Dialogue: 0,0:13:38.25,0:13:40.25,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:13:41.75,0:13:43.75,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:13:43.75,0:13:46.25,Default,,0,0,0,,Лайк... бұл қызық!
Dialogue: 0,0:13:47.26,0:13:49.29,Default,,0,0,0,,Берілмейтін➡
Dialogue: 0,0:13:49.29,0:13:52.26,Default,,0,0,0,,Бүгінге дейін қанша рет сәтсіздіктер мен үмітсіздіктерді бастан өткердім➡
Dialogue: 0,0:13:52.26,0:13:54.80,Default,,0,0,0,,Сіз орныңыздан тұрып көрдіңіз бе?
Dialogue: 0,0:13:54.80,0:13:57.30,Default,,0,0,0,,Сәтсіздіктерге қарсы тұра алатындар мықты➡
Dialogue: 0,0:13:57.30,0:14:00.77,Default,,0,0,0,,Сәтсіздіктерден қорықпайтындар күштірек.
Dialogue: 0,0:14:00.77,0:14:03.24,Default,,0,0,0,,Сәлем Мегуми-сан күшті!
Dialogue: 0,0:14:05.27,0:14:07.28,Default,,0,0,0,,Мен таңдамаған жол➡
Dialogue: 0,0:14:07.28,0:14:10.24,Default,,0,0,0,,Ол алға қарай жылжи берді.
Dialogue: 0,0:14:10.24,0:14:14.25,Default,,0,0,0,,Аа, Мегуми шынымен күшті болып кетті.
Dialogue: 0,0:14:14.25,0:14:16.28,Default,,0,0,0,,Мегумин Өте керемет!
Dialogue: 0,0:14:16.28,0:14:19.79,Default,,0,0,0,,Жасай бер! Мегуми жүр!
Dialogue: 0,0:14:20.82,0:14:23.76,Default,,0,0,0,,Мені қолдайтын достарым бар➡
Dialogue: 0,0:14:23.76,0:14:27.26,Default,,0,0,0,,Алға күтіңіз! Менің кезегім ➡
Dialogue: 0,0:14:27.26,0:14:30.77,Default,,0,0,0,,Магнолия патриархының тұлғасы!
Dialogue: 0,0:14:30.77,0:14:32.77,Default,,0,0,0,,Радикаға шеберлікпен қоңырау шалыңыз.
Dialogue: 0,0:14:32.77,0:14:34.77,Default,,0,0,0,,Екі Волжарды шақырыңыз.
Dialogue: 0,0:14:34.77,0:14:36.74,Default,,0,0,0,,Магнолия дағдылары➡
Dialogue: 0,0:14:36.74,0:14:40.24,Default,,0,0,0,,Артқы қатардан үш артқы қорғаушы шабуыл жасай алады.
Dialogue: 0,0:14:40.24,0:14:42.78,Default,,0,0,0,,Сонымен қатар, Каралкейлдің шеберлігіне байланысты➡
Dialogue: 0,0:14:42.78,0:14:45.78,Default,,0,0,0,,Персона Райдтың қуатын артқы қатарға да арттырады.
Dialogue: 0,0:14:46.75,0:14:49.75,Default,,0,0,0,,Айуан императорының айқайы!
Dialogue: 0,0:14:49.75,0:14:52.25,Default,,0,0,0,,Магнолия патриархымен шабуыл!
Dialogue: 0,0:14:52.25,0:14:54.26,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:14:54.26,0:14:56.26,Default,,0,0,0,,Үш жетек➡
Dialogue: 0,0:14:56.26,0:14:58.76,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:14:58.76,0:15:01.26,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:15:01.26,0:15:04.77,Default,,0,0,0,,Алдыңғы триггер Алдыңғы қатардағы қуат плюс 10 000! ➡
Dialogue: 0,0:15:04.77,0:15:07.27,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:15:07.27,0:15:09.77,Default,,0,0,0,,Критикалық триггер! Ах...!
Dialogue: 0,0:15:09.77,0:15:11.77,Default,,0,0,0,,Гюносураның күші плюс 10000➡
Dialogue: 0,0:15:11.77,0:15:14.28,Default,,0,0,0,,Магнолия сыни плюс 1!
Dialogue: 0,0:15:14.28,0:15:16.24,Default,,0,0,0,,Қабыл ал!
Dialogue: 0,0:15:26.75,0:15:30.26,Default,,0,0,0,,Зақымдануды тексеру 1-тармақ➡
Dialogue: 0,0:15:30.26,0:15:32.79,Default,,0,0,0,,Екінші тармақ➡
Dialogue: 0,0:15:32.79,0:15:35.76,Default,,0,0,0,,Триггер Резаэлдің күшін және 10 000-ды тартыңыз!
Dialogue: 0,0:15:38.77,0:15:40.77,Default,,0,0,0,,Гюносурамен шабуыл➡
Dialogue: 0,0:15:40.77,0:15:43.81,Default,,0,0,0,,Дағды Каралкейлге 35 000 қуат қосады!
Dialogue: 0,0:15:43.81,0:15:46.27,Default,,0,0,0,,Қалқан +10000 ұстап алу шеберлігімен!
Dialogue: 0,0:15:47.74,0:15:49.74,Default,,0,0,0,,Радикамен шабуыл.
Dialogue: 0,0:15:49.74,0:15:51.75,Default,,0,0,0,,Кесу!
Dialogue: 0,0:15:51.75,0:15:53.75,Default,,0,0,0,,Волжармен шабуыл.
Dialogue: 0,0:15:53.75,0:15:55.75,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:15:55.75,0:15:58.75,Default,,0,0,0,,Басқа Волжармен шабуыл!
Dialogue: 0,0:15:58.75,0:16:00.76,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:16:00.76,0:16:03.76,Default,,0,0,0,,Каралкейлмен шабуыл!
Dialogue: 0,0:16:03.76,0:16:05.76,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:16:06.76,0:16:10.77,Default,,0,0,0,,Жаныңызға 2 Волжар салып, 2 картаны салыңыз➡
Dialogue: 0,0:16:10.77,0:16:12.77,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:16:12.77,0:16:15.30,Default,,0,0,0,,Хаа….
Dialogue: 0,0:16:15.30,0:16:18.84,Default,,0,0,0,,Мегуми~Келесі жолы шешемін~! Мен бара аламын...!
Dialogue: 0,0:16:18.84,0:16:20.81,Default,,0,0,0,,Оны әдеттегідей жең!
Dialogue: 0,0:16:23.24,0:16:27.28,Default,,0,0,0,,Акина~! Ол керемет қарсылас➡
Dialogue: 0,0:16:27.28,0:16:30.75,Default,,0,0,0,,Мен сіздің керемет екеніңізге сенемін!
Dialogue: 0,0:16:30.75,0:16:33.79,Default,,0,0,0,,Бұл кезек ұрыс, ағайын!
Dialogue: 0,0:16:33.79,0:16:36.76,Default,,0,0,0,,Сенпай, сен төбелесесің! жоғары!
Dialogue: 0,0:16:37.76,0:16:39.73,Default,,0,0,0,,Аки-кун... жүр!
Dialogue: 0,0:16:43.26,0:16:45.23,Default,,0,0,0,,Бір-бірімізден ұтыла алмаймыз.
Dialogue: 0,0:16:46.77,0:16:49.27,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:49.27,0:16:51.27,Default,,0,0,0,,Менің кезегім! ➡
Dialogue: 0,0:16:51.27,0:16:54.24,Default,,0,0,0,,Тағдыр тілегі, байлау патшасы➡
Dialogue: 0,0:16:54.24,0:16:57.25,Default,,0,0,0,,Өміріңді ақ қанатпен басқар!
Dialogue: 0,0:16:57.25,0:16:59.25,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:17:02.78,0:17:05.79,Default,,0,0,0,,Керемет тағдыр патшасы Резаэль Вита!
Dialogue: 0,0:17:07.76,0:17:09.76,Default,,0,0,0,,Осы дағдымен Novia-ға қоңырау шалыңыз➡
Dialogue: 0,0:17:09.76,0:17:11.76,Default,,0,0,0,,Саблдарды шақыру.
Dialogue: 0,0:17:11.76,0:17:13.79,Default,,0,0,0,,Нилбериске қоңырау шалыңыз.
Dialogue: 0,0:17:13.79,0:17:16.73,Default,,0,0,0,,Бұл ойын...Бір ғажайып келді!
Dialogue: 0,0:17:16.73,0:17:18.80,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:17:18.80,0:17:21.77,Default,,0,0,0,,Барлық түсірілген маңызды триггерлерді палубаға қайтарыңыз➡
Dialogue: 0,0:17:21.77,0:17:24.27,Default,,0,0,0,,Rezael's Drive Plus 1!
Dialogue: 0,0:17:24.27,0:17:26.77,Default,,0,0,0,,Нилбериспен шабуыл!
Dialogue: 0,0:17:26.77,0:17:29.74,Default,,0,0,0,,Күзетші жоқ! Зақымдануды тексеру➡
Dialogue: 0,0:17:29.74,0:17:33.75,Default,,0,0,0,,Критикалық триггер Магнолия қуаты плюс 10 000!
Dialogue: 0,0:17:33.75,0:17:36.78,Default,,0,0,0,,Novia-мен шабуыл! күзетші!
Dialogue: 0,0:17:36.78,0:17:39.29,Default,,0,0,0,,Резаэль Витамен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:17:42.86,0:17:45.76,Default,,0,0,0,,((Зақымдану триггері Авангардтың қуатын арттырады➡
Dialogue: 0,0:17:45.76,0:17:48.33,Default,,0,0,0,,Маған тағы 2 элемент қажет➡
Dialogue: 0,0:17:48.33,0:17:50.30,Default,,0,0,0,,Олай болса...! ))
Dialogue: 0,0:17:50.30,0:17:53.77,Default,,0,0,0,,Дағды іске қосылды! Резаелді қолыңыздан жаныңызға салыңыз➡
Dialogue: 0,0:17:53.77,0:17:56.77,Default,,0,0,0,,Rifistor Sables Catellus➡ телефонына қоңырау шалыңыз
Dialogue: 0,0:17:56.77,0:17:59.27,Default,,0,0,0,,Олардың қуаты плюс 5000!
Dialogue: 0,0:17:59.27,0:18:01.24,Default,,0,0,0,,Жоқ...! Саврус дағдылары➡
Dialogue: 0,0:18:01.24,0:18:03.24,Default,,0,0,0,,Алдыңғы қатардағы қуат плюс 5000.
Dialogue: 0,0:18:03.24,0:18:05.25,Default,,0,0,0,,Қосымша Catels дағдылары➡
Dialogue: 0,0:18:05.25,0:18:07.75,Default,,0,0,0,,Рифистордың қуаты плюс 10 000!
Dialogue: 0,0:18:08.82,0:18:12.32,Default,,0,0,0,,((Мен өз күшімді Refistor➡-ге шоғырландырдым
Dialogue: 0,0:18:12.32,0:18:15.26,Default,,0,0,0,,Сіз толық күзет бақылауымен бір ұпайлық серпілісті мақсат етіп отырсыз ба? ))
Dialogue: 0,0:18:15.26,0:18:17.26,Default,,0,0,0,,содан кейін мұнда➡
Dialogue: 0,0:18:17.26,0:18:19.23,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:18:20.26,0:18:22.26,Default,,0,0,0,,Үш жетек! ➡
Dialogue: 0,0:18:22.26,0:18:24.40,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:18:24.40,0:18:28.27,Default,,0,0,0,,Триггер рефисторының қуатын сызыңыз, плюс 10 000!
Dialogue: 0,0:18:28.27,0:18:30.77,Default,,0,0,0,,Қуатты қанша арттырсаңыз да➡
Dialogue: 0,0:18:30.77,0:18:33.77,Default,,0,0,0,,Егер сыни балл 1 болып қалса, сіз оны ала аласыз!
Dialogue: 0,0:18:33.77,0:18:36.74,Default,,0,0,0,,Мен білемін, екінші тексеру!
Dialogue: 0,0:18:41.75,0:18:44.25,Default,,0,0,0,,Үшінші…тексеру➡
Dialogue: 0,0:18:44.25,0:18:47.25,Default,,0,0,0,,Критикалық триггерді алыңыз!
Dialogue: 0,0:18:47.25,0:18:49.79,Default,,0,0,0,,Рифистордың қуаты плюс 10000➡
Dialogue: 0,0:18:49.79,0:18:52.79,Default,,0,0,0,,Критикалық плюс 1! Қарғыс атқыр...
Dialogue: 0,0:18:53.83,0:18:57.26,Default,,0,0,0,,((Мен өзімнен күшті қарсыласқа қарсы тұрудан тартынбаймын.
Dialogue: 0,0:18:57.26,0:18:59.30,Default,,0,0,0,,Артыңызда қабырға жоқ➡
Dialogue: 0,0:18:59.30,0:19:02.27,Default,,0,0,0,,Ойланбай-ақ ұшып өтетін қанаттары бар.
Dialogue: 0,0:19:02.27,0:19:04.34,Default,,0,0,0,,Аки-кун➡
Dialogue: 0,0:19:04.34,0:19:07.31,Default,,0,0,0,,Сіз кәсіби болуға шынымен лайық болуыңыз мүмкін. ))
Dialogue: 0,0:19:09.31,0:19:11.78,Default,,0,0,0,,Кателлуспен шабуыл! Күзет жоқ!
Dialogue: 0,0:19:13.28,0:19:16.78,Default,,0,0,0,,Рефистормен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:19:16.78,0:19:20.39,Default,,0,0,0,,Дағды іске қосылды! Меншікті қуат плюс 10 000➡
Dialogue: 0,0:19:20.39,0:19:22.89,Default,,0,0,0,,Қарсылас толық күзет шақыра алмайды!
Dialogue: 0,0:19:24.26,0:19:26.76,Default,,0,0,0,,Уф... күзетші жоқ!
Dialogue: 0,0:19:26.76,0:19:29.73,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:43.74,0:19:45.75,Default,,0,0,0,,Триггер жоқ….
Dialogue: 0,0:19:47.75,0:19:51.75,Default,,0,0,0,,Жеңімпаз Акина Мейду!
Dialogue: 0,0:19:51.75,0:19:54.26,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:54.26,0:19:57.76,Default,,0,0,0,,Бұл жақсы жекпе-жек болды. Акина күткендей!
Dialogue: 0,0:19:57.76,0:20:00.26,Default,,0,0,0,,Ол шынымен де керемет.
Dialogue: 0,0:20:00.26,0:20:02.76,Default,,0,0,0,,Хэхе! Солай емес пе?
Dialogue: 0,0:20:02.76,0:20:04.73,Default,,0,0,0,,Жарайсың... Акина!
Dialogue: 0,0:20:09.27,0:20:12.31,Default,,0,0,0,,Көңілді болды. Ал сен ше, Акина?
Dialogue: 0,0:20:12.31,0:20:15.74,Default,,0,0,0,,Бар күш-жігеріңізбен күресіп, бар қолдауыңызды алыңыз➡
Dialogue: 0,0:20:15.74,0:20:18.75,Default,,0,0,0,,Бұл өте қызықты жекпе-жек болды!
Dialogue: 0,0:20:18.75,0:20:20.75,Default,,0,0,0,,Ум!
Dialogue: 0,0:20:20.75,0:20:23.78,Default,,0,0,0,,Мегуми-сан, керемет болды!
Dialogue: 0,0:20:23.78,0:20:27.29,Default,,0,0,0,,Бұл жақсы матч болды! (Көрермендер) Керемет!
Dialogue: 0,0:20:32.76,0:20:35.76,Default,,0,0,0,,Жеңсең де, жеңілсең де күлесің➡
Dialogue: 0,0:20:35.76,0:20:39.27,Default,,0,0,0,,Өйткені, Cardfight тамаша!
Dialogue: 0,0:20:39.27,0:20:41.24,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:20:48.24,0:20:51.25,Default,,0,0,0,,Күшті болдың➡
Dialogue: 0,0:20:51.25,0:20:53.25,Default,,0,0,0,,Және….
Dialogue: 0,0:20:59.25,0:21:01.26,Default,,0,0,0,,Йо.
Dialogue: 0,0:21:01.26,0:21:03.26,Default,,0,0,0,,Аники!
Dialogue: 0,0:21:04.26,0:21:06.26,Default,,0,0,0,,Бұл қызық болды!
Dialogue: 0,0:21:08.73,0:21:11.27,Default,,0,0,0,,О! Бұл ең жақсы нәрсе.
Dialogue: 0,0:21:11.27,0:21:13.27,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:21:13.27,0:21:15.27,Default,,0,0,0,,Мегуми. Un?
Dialogue: 0,0:21:15.27,0:21:18.27,Default,,0,0,0,,Келесі жолы шат-шадыман төбелесейік➡
Dialogue: 0,0:21:18.27,0:21:20.78,Default,,0,0,0,,Мен қарсыласпын.
Dialogue: 0,0:21:20.78,0:21:23.24,Default,,0,0,0,,Қараңғылық келе жатыр, оны жоққа шығармаңыз➡
Dialogue: 0,0:21:23.24,0:21:25.75,Default,,0,0,0,,Дауыс қабылданды!
Dialogue: 0,0:21:27.75,0:21:30.25,Default,,0,0,0,,Барлық бірінші раундтар аяқталды➡
Dialogue: 0,0:21:30.25,0:21:33.25,Default,,0,0,0,,Осы төртеуі аман қалған!
Dialogue: 0,0:21:33.25,0:21:35.29,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:35.29,0:21:37.76,Default,,0,0,0,,Жартылай финал мен финал ертең➡
Dialogue: 0,0:21:37.76,0:21:41.26,Default,,0,0,0,,Енді кім жеңеді!
Dialogue: 0,0:21:41.26,0:21:44.77,Default,,0,0,0,,Балалар! Әрине ертең де➡
Dialogue: 0,0:21:44.77,0:21:46.77,Default,,0,0,0,,Осында кездесейік!
Dialogue: 0,0:21:46.77,0:21:48.74,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:50.24,0:21:52.34,Default,,0,0,0,,Ғажайып түсе ме?➡
Dialogue: 0,0:21:52.34,0:21:54.31,Default,,0,0,0,,Төрт жалын тұтанар ма?
Dialogue: 0,0:21:55.74,0:21:58.25,Default,,0,0,0,,Болашақ сонда.
Dialogue: 0,0:21:59.75,0:22:05.75,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory