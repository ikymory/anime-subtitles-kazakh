Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.30,0:00:03.87,Default,,0,0,0,,Олай болса, бәрі алға!
Dialogue: 0,0:00:03.87,0:00:05.87,Default,,0,0,0,,Ертең кездескенше...
Dialogue: 0,0:00:08.84,0:00:11.31,Default,,0,0,0,,Жарайды, мен де барамын.
Dialogue: 0,0:00:12.31,0:00:14.31,Default,,0,0,0,,Сен өте тәртіпсізсің.
Dialogue: 0,0:00:14.31,0:00:16.78,Default,,0,0,0,,Митан, жұмысыңа барыңды сал!
Dialogue: 0,0:00:16.78,0:00:18.78,Default,,0,0,0,,Ертең кездескенше.
Dialogue: 0,0:00:21.82,0:00:25.29,Default,,0,0,0,,Әрі қарай не істейміз? Юнаның ерекше жоспары жоқ➡
Dialogue: 0,0:00:25.29,0:00:27.79,Default,,0,0,0,,Мен үй тапсырмасын орындадым. Уф...
Dialogue: 0,0:00:27.79,0:00:30.83,Default,,0,0,0,,Мен қалдым...
Dialogue: 0,0:00:30.83,0:00:34.80,Default,,0,0,0,,Юна-чан, сенің бағаң бір таңбалы санда, солай ма? Бұл керемет.
Dialogue: 0,0:00:34.80,0:00:36.77,Default,,0,0,0,,Бұл ерекше таңқаларлық емес, бірақ...
Dialogue: 0,0:00:38.37,0:00:41.84,Default,,0,0,0,,((Таңғажайып! Сіз қиын университетті мақсат етіп отырсыз ба?
Dialogue: 0,0:00:41.84,0:00:45.37,Default,,0,0,0,,Мен студенттік кеңестің мүшесімін, сондықтан ұсыныс ала аламын деп ойлаймын, солай ма?
Dialogue: 0,0:00:45.37,0:00:47.84,Default,,0,0,0,,Әлде сізде арман бар ма? ))
Dialogue: 0,0:00:49.28,0:00:51.28,Default,,0,0,0,,Юна-чан!
Dialogue: 0,0:01:03.36,0:01:07.80,Default,,0,0,0,,Сирек кездесетін Fate картасы барлардың барлығы осында!
Dialogue: 0,0:01:07.80,0:01:11.80,Default,,0,0,0,,Бұл ән айту үшін орын қажет➡
Dialogue: 0,0:01:11.80,0:01:14.80,Default,,0,0,0,,Келіңіздер... тойлайық!
Dialogue: 0,0:01:16.31,0:01:18.31,Default,,0,0,0,,Е...?
Dialogue: 0,0:02:51.30,0:02:54.27,Default,,0,0,0,,Әрі қарай мен Мичиру Маваримамен төбелесемін.
Dialogue: 0,0:02:54.27,0:02:57.27,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:02:57.27,0:02:59.24,Default,,0,0,0,,Бұл... дегенді білдіре ме?
Dialogue: 0,0:03:00.78,0:03:02.78,Default,,0,0,0,,Жүр, тәтті нәрсе жейік!
Dialogue: 0,0:03:02.78,0:03:04.78,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:04.78,0:03:07.28,Default,,0,0,0,,Дұрыс демалу да маңызды.
Dialogue: 0,0:03:07.28,0:03:09.79,Default,,0,0,0,,Жаңарту...!
Dialogue: 0,0:03:14.82,0:03:17.76,Default,,0,0,0,,Сондықтан Авангард күмбезінің төбесі ашылып жабылмайды➡
Dialogue: 0,0:03:17.76,0:03:19.76,Default,,0,0,0,,Тікұшақ алаңы жоқ ➡
Dialogue: 0,0:03:19.76,0:03:22.26,Default,,0,0,0,,Сіз қандай ашылу салтанатын өткізуді жоспарладыңыз?
Dialogue: 0,0:03:22.26,0:03:24.30,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:03:24.30,0:03:27.77,Default,,0,0,0,,Менің ойымша, ол өзгеретін сияқты, құпия негіз сияқты...
Dialogue: 0,0:03:27.77,0:03:30.24,Default,,0,0,0,,Ақылсыз болмаңыз...!
Dialogue: 0,0:03:31.27,0:03:34.28,Default,,0,0,0,,Уме~!
Dialogue: 0,0:03:34.28,0:03:36.31,Default,,0,0,0,,Басқаша айтқанда➡
Dialogue: 0,0:03:36.31,0:03:39.78,Default,,0,0,0,,Крей планетасына бару үшін уақыт пен кеңістікті басып өту керек➡
Dialogue: 0,0:03:39.78,0:03:41.78,Default,,0,0,0,,Өлшемде бұрмалау жасайды➡
Dialogue: 0,0:03:41.78,0:03:44.29,Default,,0,0,0,,Тесік жасау➡
Dialogue: 0,0:03:44.29,0:03:48.29,Default,,0,0,0,,Ол басқа галактикамен өлшемді тесік арқылы қосылған.
Dialogue: 0,0:03:49.26,0:03:51.26,Default,,0,0,0,,Керемет! Мен шынымен түсінбеймін➡
Dialogue: 0,0:03:51.26,0:03:53.30,Default,,0,0,0,,Сазға баруға болады!
Dialogue: 0,0:03:53.30,0:03:55.26,Default,,0,0,0,,Теорияда➡
Dialogue: 0,0:03:55.26,0:03:57.27,Default,,0,0,0,,Бір күні орындалатынына сенімдімін.
Dialogue: 0,0:03:57.27,0:04:00.84,Default,,0,0,0,,Куон мырза данышпан ғой!
Dialogue: 0,0:04:00.84,0:04:03.34,Default,,0,0,0,,((Толық оқшауланған!➡
Dialogue: 0,0:04:03.34,0:04:05.41,Default,,0,0,0,,Бұл қандай жалғыздық сезімі? ))
Dialogue: 0,0:04:05.41,0:04:08.41,Default,,0,0,0,,)
Dialogue: 0,0:04:08.41,0:04:12.28,Default,,0,0,0,,)
Dialogue: 0,0:04:12.28,0:04:15.28,Default,,0,0,0,,Юна-чан!
Dialogue: 0,0:04:15.28,0:04:17.62,Default,,0,0,0,,Сәлем...!
Dialogue: 0,0:04:17.62,0:04:19.25,Default,,0,0,0,,)
Dialogue: 0,0:04:19.25,0:04:21.76,Default,,0,0,0,,М-теориясы туралы білесіз бе?
Dialogue: 0,0:04:21.76,0:04:24.26,Default,,0,0,0,,Мияу….
Dialogue: 0,0:04:24.26,0:04:26.76,Default,,0,0,0,,E...не? ➡
Dialogue: 0,0:04:26.76,0:04:29.80,Default,,0,0,0,,Мен бұл туралы ешқашан естімеген шығармын...
Dialogue: 0,0:04:29.80,0:04:33.30,Default,,0,0,0,,Қараңыз~ Бұл мүлдем ақылға сыймайды!
Dialogue: 0,0:04:33.30,0:04:35.27,Default,,0,0,0,,Кешіріңіз...дұрыс➡
Dialogue: 0,0:04:35.27,0:04:38.41,Default,,0,0,0,,Оны аздап бөліп, түсіндірейін...
Dialogue: 0,0:04:38.41,0:04:40.91,Default,,0,0,0,,)
Dialogue: 0,0:04:40.91,0:04:44.28,Default,,0,0,0,,)
Dialogue: 0,0:04:44.28,0:04:47.35,Default,,0,0,0,,Пуха ~ Мен оны жедім...!
Dialogue: 0,0:04:47.35,0:04:49.28,Default,,0,0,0,,((Бір нәрсе туралы сөйлесу мүмкіндігі! ➡
Dialogue: 0,0:04:49.28,0:04:51.32,Default,,0,0,0,,Бірақ Сенка-сан ше?
Dialogue: 0,0:04:51.32,0:04:53.32,Default,,0,0,0,,Көп сөйлескен жоқпыз... ))
Dialogue: 0,0:04:54.32,0:04:57.33,Default,,0,0,0,,Шағын әңгімеден бастасақ қалай болады? ➡
Dialogue: 0,0:04:57.33,0:05:01.26,Default,,0,0,0,,Біз де бір-біріміздің статусымызды жаңартып, Авангард туралы сөйлесеміз.➡
Dialogue: 0,0:05:01.26,0:05:03.30,Default,,0,0,0,,Сәттілік тілеймін!
Dialogue: 0,0:05:03.30,0:05:05.27,Default,,0,0,0,,Митан! Дұрыс, Юнадан...
Dialogue: 0,0:05:05.27,0:05:07.30,Default,,0,0,0,,Е! ➡
Dialogue: 0,0:05:07.30,0:05:10.31,Default,,0,0,0,,Дару Исшо! Енді үйге барғанымыз дұрыс емес пе? ➡
Dialogue: 0,0:05:10.31,0:05:14.78,Default,,0,0,0,,Сыныптың ыңғайсыз кездесуі - бұл жай ғана азаптау, солай емес пе?
Dialogue: 0,0:05:14.78,0:05:16.78,Default,,0,0,0,,Умм... әрине.
Dialogue: 0,0:05:16.78,0:05:19.75,Default,,0,0,0,,Қайту...!
Dialogue: 0,0:05:20.82,0:05:24.29,Default,,0,0,0,,Бірақ...Мен де барлығымен кездескеніме қуаныштымын.
Dialogue: 0,0:05:25.25,0:05:27.76,Default,,0,0,0,,Юна-чан...дұрыс➡
Dialogue: 0,0:05:27.76,0:05:30.79,Default,,0,0,0,,Олай болса... батылдық танытайық! Эй?
Dialogue: 0,0:05:30.79,0:05:32.76,Default,,0,0,0,,Мм...!
Dialogue: 0,0:05:32.76,0:05:35.30,Default,,0,0,0,,Ах... бұл!
Dialogue: 0,0:05:35.30,0:05:37.80,Default,,0,0,0,,Жарайды... Аа...
Dialogue: 0,0:05:37.80,0:05:40.77,Default,,0,0,0,,Бір кезде осылай жиналу жаман емес➡
Dialogue: 0,0:05:40.77,0:05:43.27,Default,,0,0,0,,Дұрыс па? Юна.
Dialogue: 0,0:05:43.27,0:05:45.34,Default,,0,0,0,,Ах...сәлем!
Dialogue: 0,0:05:45.34,0:05:47.78,Default,,0,0,0,,Хехе... Дұрыс.
Dialogue: 0,0:05:47.78,0:05:51.31,Default,,0,0,0,,Бұл тамаша. Барлығымыз жинала аламыз➡
Dialogue: 0,0:05:51.31,0:05:54.78,Default,,0,0,0,,Тағдырдың шешуші шайқасына қатысып, көп қиындық көрдім➡
Dialogue: 0,0:05:54.78,0:05:58.25,Default,,0,0,0,,Мен бүгін кіммін, баршаңызға рахмет➡
Dialogue: 0,0:05:58.25,0:06:00.76,Default,,0,0,0,,Сол кезде барлығы мені артқа тартты➡
Dialogue: 0,0:06:00.76,0:06:02.79,Default,,0,0,0,,Мен қайталап көремін...
Dialogue: 0,0:06:02.79,0:06:05.29,Default,,0,0,0,,Дөрекі болмаңыз➡
Dialogue: 0,0:06:05.29,0:06:09.30,Default,,0,0,0,,Жаңа кездессек те, бізге бірінші сенген сен едің.
Dialogue: 0,0:06:10.30,0:06:15.27,Default,,0,0,0,,Екеуміз бөлек тұрсақ та, сен бізді шақырдың.
Dialogue: 0,0:06:15.27,0:06:17.31,Default,,0,0,0,,Барлығы….
Dialogue: 0,0:06:17.31,0:06:21.78,Default,,0,0,0,,Хехе... Азаматтық➡ ашқан тілекпен бетпе-бет келу
Dialogue: 0,0:06:21.78,0:06:24.28,Default,,0,0,0,,Тағдырлы шайқасты жеңдім...
Dialogue: 0,0:06:24.28,0:06:26.75,Default,,0,0,0,,Біз қазір осындамыз, өйткені бәріміз оны жеңдік.
Dialogue: 0,0:06:28.28,0:06:30.75,Default,,0,0,0,,Бұл мереке болды➡
Dialogue: 0,0:06:30.75,0:06:32.75,Default,,0,0,0,,Өзімді ақтайтын кез келді.
Dialogue: 0,0:06:32.75,0:06:35.32,Default,,0,0,0,,Ой...осы жүздермен жиналайық➡
Dialogue: 0,0:06:35.32,0:06:39.79,Default,,0,0,0,,Үйге ұрыспай бара жатырсың ба? Ұрыс па? Мен де қалаймын!
Dialogue: 0,0:06:39.79,0:06:41.76,Default,,0,0,0,,Ұнады!
Dialogue: 0,0:06:43.77,0:06:45.80,Default,,0,0,0,,Мм...Киома-сан➡
Dialogue: 0,0:06:45.80,0:06:48.77,Default,,0,0,0,,Қарсы болмасаңыз, маған кеңес бере аласыз ба?
Dialogue: 0,0:06:48.77,0:06:51.74,Default,,0,0,0,,Е...мен? жоғары.
Dialogue: 0,0:06:53.28,0:06:55.78,Default,,0,0,0,,Менің дұрыс айтқаныма сенімдісіз бе?
Dialogue: 0,0:06:56.78,0:06:59.81,Default,,0,0,0,,Хмм, дәмді болды.
Dialogue: 0,0:06:59.81,0:07:02.28,Default,,0,0,0,,Аки-кун, менімен ұзағырақ араласа аласың ба?
Dialogue: 0,0:07:02.28,0:07:04.25,Default,,0,0,0,,Әрине, кеттік!
Dialogue: 0,0:07:05.29,0:07:07.26,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:07:07.26,0:07:09.76,Default,,0,0,0,,(Кашива қолы)
Dialogue: 0,0:07:20.27,0:07:22.30,Default,,0,0,0,,Масанори сізді тапса➡
Dialogue: 0,0:07:22.30,0:07:25.81,Default,,0,0,0,,Құдайдан тағы сұрау? Шатасып кететін сияқты.
Dialogue: 0,0:07:25.81,0:07:30.28,Default,,0,0,0,,Сіз мұны айттыңыз ба? Масанори қудалау! Масахара!
Dialogue: 0,0:07:30.28,0:07:32.31,Default,,0,0,0,,Аха….
Dialogue: 0,0:07:32.31,0:07:35.28,Default,,0,0,0,,Нао-сенпай не сұрады?
Dialogue: 0,0:07:35.28,0:07:37.29,Default,,0,0,0,,Әрине, Аки жеңеді!
Dialogue: 0,0:07:40.26,0:07:42.26,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:07:43.26,0:07:45.76,Default,,0,0,0,,Мен мұны Акиге беремін.
Dialogue: 0,0:07:45.76,0:07:48.30,Default,,0,0,0,,Е... мен үшін? Un!
Dialogue: 0,0:07:48.30,0:07:52.33,Default,,0,0,0,,Міндетті түрде тұрғандықтан берекелі дейді.
Dialogue: 0,0:07:52.33,0:07:55.90,Default,,0,0,0,,Әрқашан берілмей қол созыңыз.
Dialogue: 0,0:07:55.90,0:07:58.91,Default,,0,0,0,,Бұл сен үшін керемет сүйкімділік емес пе, Аки?
Dialogue: 0,0:08:00.34,0:08:02.28,Default,,0,0,0,,Мен қуаныштымын.
Dialogue: 0,0:08:02.28,0:08:04.31,Default,,0,0,0,,Сосын менден де.
Dialogue: 0,0:08:04.31,0:08:08.28,Default,,0,0,0,,Мен? Кәсіби әлемде күтіңіз.
Dialogue: 0,0:08:09.35,0:08:11.25,Default,,0,0,0,,Аки-кун….
Dialogue: 0,0:08:11.25,0:08:13.25,Default,,0,0,0,,О! Маған қалдырыңыз.
Dialogue: 0,0:08:15.76,0:08:18.26,Default,,0,0,0,,Мен көремін...қорытындылау үшін➡
Dialogue: 0,0:08:18.26,0:08:20.26,Default,,0,0,0,,Мен болашаққа алаңдаймын➡
Dialogue: 0,0:08:20.26,0:08:23.26,Default,,0,0,0,,Бұл жоғары сынып оқушыларына тән мәселе.
Dialogue: 0,0:08:23.26,0:08:25.27,Default,,0,0,0,,Мен орта мектеп оқушысымын.
Dialogue: 0,0:08:25.27,0:08:27.30,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:08:27.30,0:08:30.27,Default,,0,0,0,,Алдымен ата-анаңызбен және мұғалімдеріңізбен сөйлескеніңіз дұрыс.
Dialogue: 0,0:08:30.27,0:08:32.77,Default,,0,0,0,,Қалай айта аламын...Киома-сан➡
Dialogue: 0,0:08:32.77,0:08:35.28,Default,,0,0,0,,Университетке түсіп, компания қызметкері болыңыз➡
Dialogue: 0,0:08:35.28,0:08:37.81,Default,,0,0,0,,Сонымен қатар, мұнымен айналысатын мамандар да бар➡
Dialogue: 0,0:08:37.81,0:08:40.82,Default,,0,0,0,,Мен әртүрлі пікірлерді естігендей болдым.
Dialogue: 0,0:08:42.28,0:08:45.25,Default,,0,0,0,,Егер солай болса... досыңызбен кеңесіңіз➡
Dialogue: 0,0:08:45.25,0:08:47.29,Default,,0,0,0,,Мен бірден бас тарта алмаймын.
Dialogue: 0,0:08:47.29,0:08:49.26,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:08:49.26,0:08:51.26,Default,,0,0,0,,Бұл ұрыс!
Dialogue: 0,0:08:51.26,0:08:53.29,Default,,0,0,0,,Күресуден басқа ештеңе қалмады!
Dialogue: 0,0:08:53.29,0:08:55.83,Default,,0,0,0,,Неліктен бұлай? Мен көремін➡
Dialogue: 0,0:08:55.83,0:08:58.77,Default,,0,0,0,,Ұрыс кезінде сөйлесу оңайырақ болуы мүмкін.
Dialogue: 0,0:08:58.77,0:09:00.77,Default,,0,0,0,,Сенімді болмаңыз!
Dialogue: 0,0:09:01.77,0:09:04.27,Default,,0,0,0,,Тіпті жекпе-жек үстелі бар ма?
Dialogue: 0,0:09:04.27,0:09:08.28,Default,,0,0,0,,Хаа... Басқа амалым жоқ. Егер мен мұны істеймін десем, бар күшімді саламын.
Dialogue: 0,0:09:08.28,0:09:11.28,Default,,0,0,0,,Сәлем Сонымен… бастайық!
Dialogue: 0,0:09:11.28,0:09:15.28,Default,,0,0,0,,Олай болса, ханым...фай!
Dialogue: 0,0:09:16.79,0:09:18.75,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:09:19.79,0:09:21.79,Default,,0,0,0,,Джеваль айдаһары.
Dialogue: 0,0:09:21.79,0:09:23.76,Default,,0,0,0,,Lucent Sweet Milis.
Dialogue: 0,0:09:23.76,0:09:26.29,Default,,0,0,0,,Менің кезегім Ракетенверфке бару.
Dialogue: 0,0:09:26.29,0:09:28.26,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:09:28.26,0:09:30.30,Default,,0,0,0,,Менің кезегім Виреяға бару➡
Dialogue: 0,0:09:30.30,0:09:32.27,Default,,0,0,0,,Баратиалға➡ қоңырау шалыңыз
Dialogue: 0,0:09:32.27,0:09:34.27,Default,,0,0,0,,Виреамен шабуыл!
Dialogue: 0,0:09:34.27,0:09:36.27,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:09:36.27,0:09:38.27,Default,,0,0,0,,Шабуыл! Бұл күзетші.
Dialogue: 0,0:09:38.27,0:09:40.31,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:09:40.31,0:09:44.28,Default,,0,0,0,,Болашаққа деген қобалжу...ол жастың табиғи уайымы➡
Dialogue: 0,0:09:44.28,0:09:46.78,Default,,0,0,0,,Неге сонша уайымдайсыз?
Dialogue: 0,0:09:46.78,0:09:49.28,Default,,0,0,0,,Юна...не істей аламын?➡
Dialogue: 0,0:09:49.28,0:09:51.75,Default,,0,0,0,,Мен оның не үшін қолайлы екенін білмеймін.
Dialogue: 0,0:09:51.75,0:09:54.26,Default,,0,0,0,,Тек орташадан жоғары оқи білу➡
Dialogue: 0,0:09:54.26,0:09:56.26,Default,,0,0,0,,Ерекше ештеңе жоқ➡
Dialogue: 0,0:09:56.26,0:09:59.79,Default,,0,0,0,,Мен тіпті не істегім келетінін де білмеймін➡
Dialogue: 0,0:09:59.79,0:10:03.26,Default,,0,0,0,,Ештеңесіз бұлай өмір сүргім келмейді.
Dialogue: 0,0:10:03.26,0:10:05.27,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:10:05.27,0:10:09.30,Default,,0,0,0,,Сонда сізде ештеңеге секіруден басқа амал жоқ.
Dialogue: 0,0:10:09.30,0:10:12.77,Default,,0,0,0,,Өзіңізді аздап қызықтыратын нәрсені табуға тырысыңыз➡
Dialogue: 0,0:10:12.77,0:10:14.78,Default,,0,0,0,,Сәтсіздікке жол берілмейді➡
Dialogue: 0,0:10:14.78,0:10:16.81,Default,,0,0,0,,Сәтсіздіктерді қайталау кезінде➡
Dialogue: 0,0:10:16.81,0:10:19.28,Default,,0,0,0,,Менің әлемім кеңейіп келеді.
Dialogue: 0,0:10:19.28,0:10:21.35,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:10:21.35,0:10:23.28,Default,,0,0,0,,Gatling Canone-де жүру➡
Dialogue: 0,0:10:23.28,0:10:25.79,Default,,0,0,0,,Ракетенверфке шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:10:25.79,0:10:27.76,Default,,0,0,0,,Gatling Canone-мен шабуыл!
Dialogue: 0,0:10:27.76,0:10:29.79,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:10:29.79,0:10:31.76,Default,,0,0,0,,Шабуыл! Бұл күзетші!
Dialogue: 0,0:10:31.76,0:10:33.80,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:10:33.80,0:10:35.80,Default,,0,0,0,,Мен сіздің не айтқыңыз келетінін түсіндім➡
Dialogue: 0,0:10:35.80,0:10:38.77,Default,,0,0,0,,Бірақ сәтсіздікке ұшырау қорқынышты емес пе?
Dialogue: 0,0:10:38.77,0:10:41.27,Default,,0,0,0,,Сіз тек бір рет өмір сүресіз.
Dialogue: 0,0:10:41.27,0:10:43.27,Default,,0,0,0,,Ешбір өмір мінсіз емес сияқты➡
Dialogue: 0,0:10:43.27,0:10:46.27,Default,,0,0,0,,Сәтсіздіксіз өмір жоқ.
Dialogue: 0,0:10:46.27,0:10:48.28,Default,,0,0,0,,Қорқынышты нәрселер қорқынышты.
Dialogue: 0,0:10:48.28,0:10:50.78,Default,,0,0,0,,Қайталау жұмыс істемеуі мүмкін➡
Dialogue: 0,0:10:50.78,0:10:53.31,Default,,0,0,0,,Сізге біреу күлуі мүмкін➡
Dialogue: 0,0:10:53.31,0:10:56.28,Default,,0,0,0,,Ешкім сәтсіздікке ұшырағысы келмейді, солай ма?
Dialogue: 0,0:10:56.28,0:10:58.29,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:10:58.29,0:11:00.26,Default,,0,0,0,,Лутикаға барыңыз!
Dialogue: 0,0:11:00.26,0:11:02.76,Default,,0,0,0,,Рутиканы шақыру арқылы Эльберинаға шабуыл жасаңыз!
Dialogue: 0,0:11:02.76,0:11:04.76,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:11:04.76,0:11:06.79,Default,,0,0,0,,Драйверді тексеру➡
Dialogue: 0,0:11:06.79,0:11:09.26,Default,,0,0,0,,Триггер Эльберинаның қуатын +10000 сызыңыз!
Dialogue: 0,0:11:10.77,0:11:12.77,Default,,0,0,0,,Эльберинамен шабуыл!
Dialogue: 0,0:11:12.77,0:11:15.27,Default,,0,0,0,,Күзетші! Соңына бұрылу.
Dialogue: 0,0:11:15.27,0:11:17.77,Default,,0,0,0,,Маған біреу күледі...?➡
Dialogue: 0,0:11:17.77,0:11:19.81,Default,,0,0,0,,Бұл қорқынышты➡
Dialogue: 0,0:11:19.81,0:11:23.78,Default,,0,0,0,,Дегенмен, біздің президент сәтсіздіктер мен жеңілістерді бастан кешіруде➡
Dialogue: 0,0:11:23.78,0:11:26.28,Default,,0,0,0,,Сонда да біз алға жылжып келеміз.
Dialogue: 0,0:11:26.28,0:11:28.78,Default,,0,0,0,,Оның арқасы менің➡
Dialogue: 0,0:11:28.78,0:11:32.25,Default,,0,0,0,,Мен ешқашан бұл жайсыз деп ойлаған емеспін.
Dialogue: 0,0:11:32.25,0:11:35.26,Default,,0,0,0,,Әрине кейбіреулер оған күлді➡
Dialogue: 0,0:11:35.26,0:11:37.29,Default,,0,0,0,,Бірақ ол бәрібір➡
Dialogue: 0,0:11:37.29,0:11:41.30,Default,,0,0,0,,Мен бұл туралы уайымдау уақытты босқа кетіру деп күлдім.
Dialogue: 0,0:11:41.30,0:11:44.77,Default,,0,0,0,,Мен өз басым тәуекелді ғана ойлайтын адаммын.
Dialogue: 0,0:11:44.77,0:11:46.77,Default,,0,0,0,,Бірақ мен оны кездестірген кезде➡
Dialogue: 0,0:11:46.77,0:11:48.80,Default,,0,0,0,,Сәтсіздіктен жақсы➡
Dialogue: 0,0:11:48.80,0:11:52.27,Default,,0,0,0,,Сәтсіздіктен қорқу жағымсыз деп ойлай бастадым➡
Dialogue: 0,0:11:52.27,0:11:55.28,Default,,0,0,0,,Мен оған жеңілгім келмейді➡
Dialogue: 0,0:11:55.28,0:11:58.28,Default,,0,0,0,,Қалай болғанда да, мен бәрін қолданып көрдім➡
Dialogue: 0,0:11:58.28,0:12:02.25,Default,,0,0,0,,Толық емес жұмыс, оқу және Авангард.
Dialogue: 0,0:12:04.79,0:12:07.76,Default,,0,0,0,,Әртүрлі нәрселерді бастан өткере отырып, маған не қолайлы?➡
Dialogue: 0,0:12:07.76,0:12:10.29,Default,,0,0,0,,Мен не істегім келеді, не істегім келмейді➡
Dialogue: 0,0:12:10.29,0:12:12.26,Default,,0,0,0,,Мен мұны түсіндім.
Dialogue: 0,0:12:12.26,0:12:14.76,Default,,0,0,0,,Өзіңізді танисыз ба...?
Dialogue: 0,0:12:14.76,0:12:17.37,Default,,0,0,0,,Аа, бірінші рет сонда➡
Dialogue: 0,0:12:17.37,0:12:19.30,Default,,0,0,0,,Таңдау уақыты келді.
Dialogue: 0,0:12:19.30,0:12:21.30,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:12:21.30,0:12:24.31,Default,,0,0,0,,Менің сенімім: идеалды жолыңызды таңдаңыз➡
Dialogue: 0,0:12:24.31,0:12:28.81,Default,,0,0,0,,Таразы тағдыры Альгрейврада жүр!
Dialogue: 0,0:12:37.75,0:12:39.79,Default,,0,0,0,,Бадияға➡ қоңырау шалыңыз
Dialogue: 0,0:12:39.79,0:12:42.76,Default,,0,0,0,,Шархубты шеберлікпен қолыңызға қосыңыз➡
Dialogue: 0,0:12:42.76,0:12:44.76,Default,,0,0,0,,Панцершлег➡ қоңырау шалыңыз
Dialogue: 0,0:12:44.76,0:12:46.79,Default,,0,0,0,,Жұмыс уақыты келді➡
Dialogue: 0,0:12:46.79,0:12:49.33,Default,,0,0,0,,Algrivra шеберлігі іске қосылды!
Dialogue: 0,0:12:49.33,0:12:53.77,Default,,0,0,0,,Бадиа Панцершлег Ракетенверфтің қуаты +5000➡
Dialogue: 0,0:12:53.77,0:12:56.27,Default,,0,0,0,,Сонымен қатар, Algrivra қуаты +10000➡
Dialogue: 0,0:12:56.27,0:12:59.27,Default,,0,0,0,,Algrivra-мен шабуыл! күзетші!
Dialogue: 0,0:12:59.27,0:13:01.31,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:13:01.31,0:13:04.78,Default,,0,0,0,,Heal Trigger Panzerschleg қуаты плюс 10 000!
Dialogue: 0,0:13:05.78,0:13:07.78,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:13:07.78,0:13:10.75,Default,,0,0,0,,Панцершлег триггерсіз шабуыл➡
Dialogue: 0,0:13:10.75,0:13:13.25,Default,,0,0,0,,Артық зарядтау 15 000 қуат қосады!
Dialogue: 0,0:13:13.25,0:13:15.79,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:13:15.79,0:13:17.76,Default,,0,0,0,,Бадиямен шабуыл!
Dialogue: 0,0:13:17.76,0:13:19.76,Default,,0,0,0,,Күзетші жоқ! Соңына бұрылу.
Dialogue: 0,0:13:20.83,0:13:24.30,Default,,0,0,0,,Юна Сайонжи...сен әлі дамып жатырсың➡
Dialogue: 0,0:13:24.30,0:13:28.27,Default,,0,0,0,,Барлығын байқап көріңіз, сәттілік пен сәтсіздікті қайталаңыз➡
Dialogue: 0,0:13:28.27,0:13:30.77,Default,,0,0,0,,Соңында бірдеңе болатынына сенімдімін➡
Dialogue: 0,0:13:30.77,0:13:32.77,Default,,0,0,0,,Бұл сіз үшін шынайы.
Dialogue: 0,0:13:32.77,0:13:35.78,Default,,0,0,0,,Нақты ма? Ах➡
Dialogue: 0,0:13:35.78,0:13:37.78,Default,,0,0,0,,Дәл солай, мен де➡
Dialogue: 0,0:13:37.78,0:13:40.78,Default,,0,0,0,,Мен өзімді таптым➡
Dialogue: 0,0:13:40.78,0:13:43.79,Default,,0,0,0,,Шындықты тапқан адам күшті➡
Dialogue: 0,0:13:43.79,0:13:48.26,Default,,0,0,0,,Сіз сондасыз ба? Сіздің айналаңызда да осындай адамдар бар.
Dialogue: 0,0:13:48.26,0:13:50.26,Default,,0,0,0,,Иә➡
Dialogue: 0,0:13:50.26,0:13:52.33,Default,,0,0,0,,Юнаның ұсынысы ➡
Dialogue: 0,0:13:52.33,0:13:56.80,Default,,0,0,0,,Мен әрқашан бәрін түзу және байыппен орындауға тырысамын.
Dialogue: 0,0:13:57.80,0:14:01.80,Default,,0,0,0,,Юнаның сағынышы... Юна ең жоғарғы болмыс болуды мақсат етеді!
Dialogue: 0,0:14:02.77,0:14:04.77,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:14:04.77,0:14:06.77,Default,,0,0,0,,Түпкі және жалғызға ұмтылу➡
Dialogue: 0,0:14:06.77,0:14:08.78,Default,,0,0,0,,Жоғарғы тағдыр➡
Dialogue: 0,0:14:08.78,0:14:11.25,Default,,0,0,0,,Лизиафеллге барыңыз!
Dialogue: 0,0:14:20.22,0:14:22.26,Default,,0,0,0,,Амфиге қоңырау шалыңыз➡
Dialogue: 0,0:14:22.26,0:14:24.26,Default,,0,0,0,,Шабуыл! күзетші!
Dialogue: 0,0:14:24.26,0:14:26.33,Default,,0,0,0,,Эльберинамен шабуыл!
Dialogue: 0,0:14:26.33,0:14:28.26,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:14:28.26,0:14:31.23,Default,,0,0,0,,Лизиафеллмен шабуыл! Дағдыларды белсендіру➡
Dialogue: 0,0:14:31.23,0:14:33.23,Default,,0,0,0,,Жаныңызға 2 артқы сақшыны салыңыз➡
Dialogue: 0,0:14:33.23,0:14:35.24,Default,,0,0,0,,Меншікті қуат плюс 10000➡
Dialogue: 0,0:14:35.24,0:14:37.27,Default,,0,0,0,,Жүргізу плюс 1!
Dialogue: 0,0:14:37.27,0:14:39.24,Default,,0,0,0,,Баккюн!
Dialogue: 0,0:14:39.24,0:14:41.78,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:14:41.78,0:14:43.78,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:14:43.78,0:14:47.25,Default,,0,0,0,,Жарайды, маңызды триггер! Лизиафеллдің күші плюс 10000➡
Dialogue: 0,0:14:47.25,0:14:49.25,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:14:49.25,0:14:51.75,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:14:51.75,0:14:53.79,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:14:53.79,0:14:57.26,Default,,0,0,0,,Триггер Эльберинаның күші мен 10 000 сызу!
Dialogue: 0,0:14:59.29,0:15:02.73,Default,,0,0,0,,Жоғарғы Тәңір жарқырап тұр➡
Dialogue: 0,0:15:02.73,0:15:04.73,Default,,0,0,0,,Жоғарғы жетістік➡
Dialogue: 0,0:15:04.73,0:15:06.73,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:15:07.74,0:15:10.27,Default,,0,0,0,,Лизиафеллге тұрып, минус 2➡ жүріңіз
Dialogue: 0,0:15:10.27,0:15:13.27,Default,,0,0,0,,Ал бұл шайқас кезінде қуат тұрақты +5000➡ болады
Dialogue: 0,0:15:13.27,0:15:15.24,Default,,0,0,0,,Critical Plus 1➡
Dialogue: 0,0:15:15.24,0:15:17.25,Default,,0,0,0,,Тағы да шабуыл!
Dialogue: 0,0:15:17.25,0:15:19.25,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:15:19.25,0:15:21.25,Default,,0,0,0,,Драйверді тексеру➡
Dialogue: 0,0:15:21.25,0:15:23.75,Default,,0,0,0,,Триггерсіз шабуыл Эльберина!
Dialogue: 0,0:15:23.75,0:15:25.75,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:15:25.75,0:15:29.26,Default,,0,0,0,,Бұрылыстың соңы. Ең жоғарғы құдайлық шеберлік➡
Dialogue: 0,0:15:29.26,0:15:31.29,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:15:31.29,0:15:35.26,Default,,0,0,0,,Дұрыс... Бірақ одан кейін таразының құдайлық шеберлігі келеді!
Dialogue: 0,0:15:36.23,0:15:38.30,Default,,0,0,0,,Сергіту шабуылы.
Dialogue: 0,0:15:38.30,0:15:41.24,Default,,0,0,0,,Итеруді ойласам, қайратым шықты!
Dialogue: 0,0:15:41.24,0:15:43.27,Default,,0,0,0,,А...осы батылдық болса➡
Dialogue: 0,0:15:43.27,0:15:45.24,Default,,0,0,0,,Сіз кез келген нәрсені көре аласыз.
Dialogue: 0,0:15:45.24,0:15:47.24,Default,,0,0,0,,Менің де есіме түсіп кетті➡
Dialogue: 0,0:15:47.24,0:15:50.75,Default,,0,0,0,,Қыңыр болған кезде өзіңді ойла!
Dialogue: 0,0:15:50.75,0:15:52.75,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:15:52.75,0:15:54.75,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:15:54.75,0:15:56.75,Default,,0,0,0,,Algrivra! ➡
Dialogue: 0,0:15:56.75,0:15:58.75,Default,,0,0,0,,Шалхуб Ардилге➡ қоңырау шалыңыз
Dialogue: 0,0:15:58.75,0:16:00.76,Default,,0,0,0,,Таразы балансын қолданыңдар➡
Dialogue: 0,0:16:00.76,0:16:03.76,Default,,0,0,0,,Шалхуб пен Фаризаны тамшыдан шақырыңыз➡
Dialogue: 0,0:16:03.76,0:16:05.79,Default,,0,0,0,,Algrivra дағдылары➡
Dialogue: 0,0:16:05.79,0:16:09.76,Default,,0,0,0,,Raketenwerf Fariza Adil's Пауэр Plus 5000➡
Dialogue: 0,0:16:09.76,0:16:11.73,Default,,0,0,0,,Таразылар...Орындалу!
Dialogue: 0,0:16:11.73,0:16:13.73,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:16:15.24,0:16:17.74,Default,,0,0,0,,2 Шалхубу қуаты +5000➡
Dialogue: 0,0:16:17.74,0:16:21.28,Default,,0,0,0,,Қарсыласыңызға 1 зиян келтіріңіз!
Dialogue: 0,0:16:21.28,0:16:23.74,Default,,0,0,0,,Қабыл ал... карманы бұзатын соққы➡
Dialogue: 0,0:16:23.74,0:16:27.75,Default,,0,0,0,,Тағдырды өзгертетін блиц зеңбірегі!
Dialogue: 0,0:16:30.25,0:16:32.75,Default,,0,0,0,,Агия~!
Dialogue: 0,0:16:32.75,0:16:34.76,Default,,0,0,0,,Зақымдануды тексеру➡
Dialogue: 0,0:16:34.76,0:16:36.79,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:16:36.79,0:16:40.26,Default,,0,0,0,,Осы зақымнан туындаған триггердің қуатын арттыруды -10000 азайтыңыз.
Dialogue: 0,0:16:40.26,0:16:42.26,Default,,0,0,0,,Тыныш отырыңыз!
Dialogue: 0,0:16:43.23,0:16:45.73,Default,,0,0,0,,Чархубпен шабуыл! күзетші!
Dialogue: 0,0:16:45.73,0:16:48.74,Default,,0,0,0,,Чархубпен шабуыл! күзетші!
Dialogue: 0,0:16:48.74,0:16:51.74,Default,,0,0,0,,Авангардқа Algrivra-мен шабуыл жасаңыз!
Dialogue: 0,0:16:51.74,0:16:55.74,Default,,0,0,0,,Шалхуб 2 шеберлікпен тұр. Күзетші жоқ.
Dialogue: 0,0:16:55.74,0:16:58.25,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:16:58.25,0:17:00.25,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:17:00.25,0:17:02.28,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:17:02.28,0:17:05.79,Default,,0,0,0,,Шархубтың қуаты плюс 10000, Алгривраның сыни плюс 1!
Dialogue: 0,0:17:08.26,0:17:10.26,Default,,0,0,0,,Чархубпен шабуыл!
Dialogue: 0,0:17:10.26,0:17:12.76,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:17:12.76,0:17:15.73,Default,,0,0,0,,Басқа Чархубпен шабуыл!
Dialogue: 0,0:17:15.73,0:17:17.77,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:17:17.77,0:17:19.77,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:17:19.77,0:17:23.77,Default,,0,0,0,,Юна-чан, мен шыдай алдым! Ерте сақшы өз жемісін берді.
Dialogue: 0,0:17:24.74,0:17:26.77,Default,,0,0,0,,Қазір бәрі жақсы сияқты.
Dialogue: 0,0:17:26.77,0:17:30.75,Default,,0,0,0,,Мен әрқашан қолынан келгеннің бәрін жасайтын Юнаны жақсы көремін.
Dialogue: 0,0:17:30.75,0:17:32.75,Default,,0,0,0,,Итергіш қатты жұмыс істейді➡
Dialogue: 0,0:17:32.75,0:17:34.75,Default,,0,0,0,,Тіпті Юна қолынан келгеннің бәрін жасай алады.
Dialogue: 0,0:17:34.75,0:17:36.75,Default,,0,0,0,,Батыс мұнарасы Микотого деген сезімің қандай➡
Dialogue: 0,0:17:36.75,0:17:38.75,Default,,0,0,0,,Бұл нақты.
Dialogue: 0,0:17:38.75,0:17:40.79,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:17:40.79,0:17:43.76,Default,,0,0,0,,Юнаның Митанға деген махаббаты ең күшті, ең жақсы➡
Dialogue: 0,0:17:43.76,0:17:45.76,Default,,0,0,0,,Өте керемет!
Dialogue: 0,0:17:45.76,0:17:47.73,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:17:47.73,0:17:49.76,Default,,0,0,0,,Персона Лизиафеллге мініңіз!
Dialogue: 0,0:17:49.76,0:17:53.23,Default,,0,0,0,,Армерияға қоңырау шалыңыз және құлаған Эльберинаны жанға орналастыру шеберлігін пайдаланыңыз➡
Dialogue: 0,0:17:53.23,0:17:56.24,Default,,0,0,0,,Меншікті қуат плюс 5000!
Dialogue: 0,0:17:56.24,0:17:58.27,Default,,0,0,0,,Неринеяға қоңырау шалыңыз!
Dialogue: 0,0:17:58.27,0:18:01.24,Default,,0,0,0,,Жан Эльберинаны шеберлікпен қолыңызға қосыңыз➡
Dialogue: 0,0:18:01.24,0:18:03.24,Default,,0,0,0,,Эльберинаға қоңырау шалыңыз!
Dialogue: 0,0:18:11.75,0:18:13.79,Default,,0,0,0,,Баратиалға➡ қоңырау шалыңыз
Dialogue: 0,0:18:13.79,0:18:17.76,Default,,0,0,0,,Қиын болсаң да, тақтаны айналдырып, заттарды айналдыр!
Dialogue: 0,0:18:17.76,0:18:20.80,Default,,0,0,0,,Өлімде өмір бар...олай етпе!
Dialogue: 0,0:18:20.80,0:18:23.26,Default,,0,0,0,,Кері қайтару – жекпе-жектің нағыз дәмі!
Dialogue: 0,0:18:24.33,0:18:26.23,Default,,0,0,0,,((Тіпті Юнада нақты нәрсе бар➡
Dialogue: 0,0:18:26.23,0:18:29.34,Default,,0,0,0,,Толығырақ... жай ғана көбірек табыңыз➡
Dialogue: 0,0:18:29.34,0:18:33.24,Default,,0,0,0,,Менің ішімдегі шынайы нәрсе, тек мен үшін! ))
Dialogue: 0,0:18:33.24,0:18:35.28,Default,,0,0,0,,Юна мұны жасайды!
Dialogue: 0,0:18:35.28,0:18:37.24,Default,,0,0,0,,Жүр... ал да, тұр!
Dialogue: 0,0:18:37.24,0:18:39.75,Default,,0,0,0,,Альмериядағы шабуыл! күзетші!
Dialogue: 0,0:18:39.75,0:18:41.75,Default,,0,0,0,,Эльберинамен шабуыл!
Dialogue: 0,0:18:41.75,0:18:43.75,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:18:43.75,0:18:46.75,Default,,0,0,0,,Лизиафеллмен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:46.75,0:18:49.79,Default,,0,0,0,,Альмерия мен Баратиалды жанға орналастыру дағдыларын қолданыңыз➡
Dialogue: 0,0:18:49.79,0:18:53.26,Default,,0,0,0,,Меншікті қуат плюс 10000, диск плюс 1!
Dialogue: 0,0:18:54.26,0:18:56.23,Default,,0,0,0,,Эльберина шеберлікпен тұр➡
Dialogue: 0,0:18:56.23,0:18:58.23,Default,,0,0,0,,Альмерияның дағдыларымен көбірек ➡
Dialogue: 0,0:18:58.23,0:19:00.23,Default,,0,0,0,,Неринея тұр!
Dialogue: 0,0:19:00.23,0:19:02.24,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:19:02.24,0:19:05.34,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:19:05.34,0:19:07.78,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:19:07.78,0:19:09.78,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:19:09.78,0:19:13.25,Default,,0,0,0,,Триггерді емдеу Эльберинаның күші +10000!
Dialogue: 0,0:19:14.25,0:19:16.75,Default,,0,0,0,,Эльберинамен шабуыл! Күзет жоқ!
Dialogue: 0,0:19:16.75,0:19:18.79,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:19:18.79,0:19:22.76,Default,,0,0,0,,Бұл қауіпті болды. Мұндай қабілетпен тіпті кәсіпқой да өтуі мүмкін.
Dialogue: 0,0:19:23.76,0:19:26.26,Default,,0,0,0,,Шынымен бе? Ах➡
Dialogue: 0,0:19:26.26,0:19:28.30,Default,,0,0,0,,Бірақ жеңісті беруге болмайды➡
Dialogue: 0,0:19:28.30,0:19:31.27,Default,,0,0,0,,Менің шындығым... менің авангардымды қара!
Dialogue: 0,0:19:32.23,0:19:34.24,Default,,0,0,0,,Менің жеребе кезегім!
Dialogue: 0,0:19:37.74,0:19:39.77,Default,,0,0,0,,Leidenshaft Dragon➡ қоңырау шалыңыз
Dialogue: 0,0:19:39.77,0:19:42.31,Default,,0,0,0,,Algrivra дағдылары➡
Dialogue: 0,0:19:42.31,0:19:46.25,Default,,0,0,0,,Leidenschaft Raketenwerf Adil's Пауэр Plus 5000➡
Dialogue: 0,0:19:46.25,0:19:48.82,Default,,0,0,0,,Лейденшафтпен шабуыл!
Dialogue: 0,0:19:48.82,0:19:50.79,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:19:50.79,0:19:54.26,Default,,0,0,0,,Ұрыс соңында Лейденшафттан шегініңіз➡
Dialogue: 0,0:19:54.26,0:19:57.79,Default,,0,0,0,,Алгривраға жаңа дағды береді.
Dialogue: 0,0:19:57.79,0:20:01.26,Default,,0,0,0,,Өзіңіздің күшті жақтарын біліңіз, біліңіз және тәжірибеңізді орындаңыз➡
Dialogue: 0,0:20:01.26,0:20:04.27,Default,,0,0,0,,Міне, мен жүріп өткен жол➡
Dialogue: 0,0:20:04.27,0:20:06.23,Default,,0,0,0,,Фаризаның күшеюі➡
Dialogue: 0,0:20:06.23,0:20:08.74,Default,,0,0,0,,Авангардқа Алгриврамен шабуыл жасаңыз!
Dialogue: 0,0:20:08.74,0:20:11.24,Default,,0,0,0,,Лейденшафтқа берілген дағдының арқасында➡
Dialogue: 0,0:20:11.24,0:20:13.31,Default,,0,0,0,,Фаризаның күші плюс 5000!
Dialogue: 0,0:20:13.31,0:20:17.78,Default,,0,0,0,,Ал Фариза артық зарядтау арқылы қосымша 10 000 қуат алады!
Dialogue: 0,0:20:19.25,0:20:22.25,Default,,0,0,0,,Толық ауқымды артық зарядтау...алдын алу мүмкін емес!
Dialogue: 0,0:20:34.73,0:20:38.23,Default,,0,0,0,,Жарылғыш жалын түрлендіру Жалын зеңбірегі!
Dialogue: 0,0:20:38.23,0:20:40.23,Default,,0,0,0,,Күзетші жоқ...!
Dialogue: 0,0:20:43.74,0:20:46.24,Default,,0,0,0,,Гапи~!
Dialogue: 0,0:20:50.24,0:20:53.25,Default,,0,0,0,,Жоқ, мен жеңілдім!
Dialogue: 0,0:20:53.25,0:20:55.75,Default,,0,0,0,,Мен әлі Хиёккодан жеңіле алмаймын.
Dialogue: 0,0:20:55.75,0:20:57.75,Default,,0,0,0,,Ой...
Dialogue: 0,0:20:57.75,0:21:00.25,Default,,0,0,0,,Киома-сан➡
Dialogue: 0,0:21:00.25,0:21:02.76,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:21:02.76,0:21:06.26,Default,,0,0,0,,Мен Юнаның шынымен не істегісі келетінін іздеймін.
Dialogue: 0,0:21:06.26,0:21:08.90,Default,,0,0,0,,Түсіндім... Сонымен➡
Dialogue: 0,0:21:08.90,0:21:11.73,Default,,0,0,0,,Біріншіден, мен Seizo Anchor Bolt-қа қосылғым келеді!
Dialogue: 0,0:21:11.73,0:21:14.24,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:14.24,0:21:17.24,Default,,0,0,0,,Юнаны Авангард баяғыда құтқарып қалды.
Dialogue: 0,0:21:17.24,0:21:20.24,Default,,0,0,0,,Сондықтан мен алдымен Vanguard қолданбасын сынап көргім келеді!
Dialogue: 0,0:21:20.24,0:21:22.24,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:21:22.24,0:21:24.25,Default,,0,0,0,,Енді не болады...
Dialogue: 0,0:21:24.25,0:21:26.28,Default,,0,0,0,,Біз!
Dialogue: 0,0:21:26.28,0:21:29.78,Default,,0,0,0,,Ой, мен бірінші барамын. Мен барлығын ұрып-соғамын!
Dialogue: 0,0:21:29.78,0:21:33.75,Default,,0,0,0,,Хахахаха... Мені ұмытып қалсаң, қиналып қалар едім.
Dialogue: 0,0:21:35.29,0:21:38.76,Default,,0,0,0,,Ойланып қарашы, Акикун, енді не сұрадың?
Dialogue: 0,0:21:38.76,0:21:41.26,Default,,0,0,0,,Бұл... құпия.
Dialogue: 0,0:21:41.26,0:21:44.30,Default,,0,0,0,,Алдау! Мен солай айттым.
Dialogue: 0,0:21:44.30,0:21:46.27,Default,,0,0,0,,Егер ол орындалса, мен саған айтамын.
Dialogue: 0,0:21:48.74,0:21:51.27,Default,,0,0,0,,А... Акина-сенпай мен Нао-сан! ➡
Dialogue: 0,0:21:51.27,0:21:53.24,Default,,0,0,0,,Және….
Dialogue: 0,0:21:53.24,0:21:55.74,Default,,0,0,0,,Эрика?
Dialogue: 0,0:21:55.74,0:21:58.25,Default,,0,0,0,,Бұл қандай... қандай жағдай?
Dialogue: 0,0:21:59.75,0:22:05.75,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory