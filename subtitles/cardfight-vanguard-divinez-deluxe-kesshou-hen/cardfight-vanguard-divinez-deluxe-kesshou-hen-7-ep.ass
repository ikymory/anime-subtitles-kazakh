Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.80,0:00:05.80,Default,,0,0,0,,((A….
Dialogue: 0,0:00:07.24,0:00:09.24,Default,,0,0,0,,Әдемі….
Dialogue: 0,0:00:10.74,0:00:14.24,Default,,0,0,0,,Мені осында әкелдің, солай ма?➡
Dialogue: 0,0:00:14.24,0:00:16.25,Default,,0,0,0,,Крис Лейн.
Dialogue: 0,0:00:19.25,0:00:21.25,Default,,0,0,0,,Ертегіні тыңдай аласыз ба?
Dialogue: 0,0:00:23.79,0:00:26.76,Default,,0,0,0,,Тағдыр соғысы мен Тағдыр шайқасы аяқталды➡
Dialogue: 0,0:00:26.76,0:00:30.83,Default,,0,0,0,,Әркім өз жолымен жүреді.
Dialogue: 0,0:00:30.83,0:00:33.30,Default,,0,0,0,,Ақина-сенпай кәсіби маман болуды мақсат етеді! ))
Dialogue: 0,0:00:47.91,0:00:50.38,Default,,0,0,0,,)
Dialogue: 0,0:02:23.27,0:02:25.27,Default,,0,0,0,,Кестені өзгерту? ➡
Dialogue: 0,0:02:25.27,0:02:27.24,Default,,0,0,0,,Жоқ...! Мен оны түсіндім.
Dialogue: 0,0:02:27.24,0:02:29.78,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:02:29.78,0:02:32.78,Default,,0,0,0,,Менің түнге дейін уақытым бар.
Dialogue: 0,0:02:32.78,0:02:34.78,Default,,0,0,0,,Біз не істейміз?
Dialogue: 0,0:02:34.78,0:02:36.75,Default,,0,0,0,,Ым? а!
Dialogue: 0,0:02:36.75,0:02:39.25,Default,,0,0,0,,Акина-сенпай мен Нао-сан!
Dialogue: 0,0:02:39.25,0:02:42.29,Default,,0,0,0,,Ал...Эрика?
Dialogue: 0,0:02:42.29,0:02:44.26,Default,,0,0,0,,Бұл не? ➡
Dialogue: 0,0:02:44.26,0:02:46.23,Default,,0,0,0,,О, Ассистент, кеше жақсы демалдын ба?
Dialogue: 0,0:02:47.80,0:02:50.27,Default,,0,0,0,,Тым болмаса бір қолымды қыссам ше?
Dialogue: 0,0:02:50.27,0:02:53.27,Default,,0,0,0,,Мен қатты ашуландым. мм...
Dialogue: 0,0:02:53.27,0:02:55.24,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:02:56.77,0:02:59.78,Default,,0,0,0,,Ха... сіз мұны айтып тұрсыз ба? ➡
Dialogue: 0,0:02:59.78,0:03:04.81,Default,,0,0,0,,Өйткені мен Ақина-сенпай мен басқалардың бірге шығайын деп жатқанын көрдім➡
Dialogue: 0,0:03:04.81,0:03:07.78,Default,,0,0,0,,Уайымдағаным сонша, мен оның соңынан ердім...
Dialogue: 0,0:03:09.28,0:03:11.25,Default,,0,0,0,,Бұл аңдыушы...
Dialogue: 0,0:03:11.25,0:03:13.79,Default,,0,0,0,,Басқалар туралы жаман сөз айтпа! ➡
Dialogue: 0,0:03:13.79,0:03:15.79,Default,,0,0,0,,Бұл қадағалау жауапкершілігі➡
Dialogue: 0,0:03:15.79,0:03:18.79,Default,,0,0,0,,Қарындасы інісінің бақытын көруі керек...!
Dialogue: 0,0:03:19.76,0:03:21.76,Default,,0,0,0,,Ол қозғала бастады! ➡
Dialogue: 0,0:03:21.76,0:03:24.27,Default,,0,0,0,,Мен сені қуамын! Микото мырза. иә? ➡
Dialogue: 0,0:03:24.27,0:03:26.74,Default,,0,0,0,,Мен де...? E~!
Dialogue: 0,0:03:28.77,0:03:30.77,Default,,0,0,0,,Мен….
Dialogue: 0,0:03:30.77,0:03:33.28,Default,,0,0,0,,Хэхе... орталық….
Dialogue: 0,0:03:33.28,0:03:35.78,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:03:37.28,0:03:40.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:40.28,0:03:42.25,Default,,0,0,0,,Сіз мұны бұрыннан істеп жүрсіз бе?
Dialogue: 0,0:03:42.25,0:03:44.29,Default,,0,0,0,,Ах! а….
Dialogue: 0,0:03:44.29,0:03:47.26,Default,,0,0,0,,Ханеяма мырза! Бұл кездейсоқтық.
Dialogue: 0,0:03:47.26,0:03:49.76,Default,,0,0,0,,Екеуің...
Dialogue: 0,0:03:49.76,0:03:52.26,Default,,0,0,0,,Бұл кездейсоқ кездесу ме?
Dialogue: 0,0:03:52.26,0:03:54.26,Default,,0,0,0,,E? Мен оны ұнатпаймын…!
Dialogue: 0,0:03:54.26,0:03:56.26,Default,,0,0,0,,Керемет! Ханеяма мырза.
Dialogue: 0,0:03:56.26,0:03:58.27,Default,,0,0,0,,Ханеяма Урара➡
Dialogue: 0,0:03:58.27,0:04:00.77,Default,,0,0,0,,Сіз қателесесіз.
Dialogue: 0,0:04:00.77,0:04:02.77,Default,,0,0,0,,Суо?
Dialogue: 0,0:04:02.77,0:04:04.77,Default,,0,0,0,,Екеуі не істемекші болды➡
Dialogue: 0,0:04:04.77,0:04:06.74,Default,,0,0,0,,Мұндай заттар бекітілген.
Dialogue: 0,0:04:06.74,0:04:08.74,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:04:08.74,0:04:10.78,Default,,0,0,0,,Ұрыс?
Dialogue: 0,0:04:10.78,0:04:13.75,Default,,0,0,0,,Екі адам қосылса, басқа ештеңе болмайды.
Dialogue: 0,0:04:13.75,0:04:15.75,Default,,0,0,0,,Арара~.
Dialogue: 0,0:04:15.75,0:04:18.75,Default,,0,0,0,,Суо~! ➡
Dialogue: 0,0:04:18.75,0:04:21.29,Default,,0,0,0,,Өйткені, ол құбыжық! ➡
Dialogue: 0,0:04:21.29,0:04:24.26,Default,,0,0,0,,Мен сенің бақытыңды қорғаймын!
Dialogue: 0,0:04:24.26,0:04:26.76,Default,,0,0,0,,Қалыңыз...! Митан, жібер! ➡
Dialogue: 0,0:04:26.76,0:04:28.80,Default,,0,0,0,,Оны жаншуға болмайды!
Dialogue: 0,0:04:28.80,0:04:30.77,Default,,0,0,0,,Уау! жұмысшы?
Dialogue: 0,0:04:30.77,0:04:32.77,Default,,0,0,0,,Бұл Митан! Эрика!
Dialogue: 0,0:04:32.77,0:04:34.77,Default,,0,0,0,,Микото-чан? Шынайы ма?
Dialogue: 0,0:04:34.77,0:04:36.81,Default,,0,0,0,,Көңілді сияқты.
Dialogue: 0,0:04:36.81,0:04:39.31,Default,,0,0,0,,Оны да менімен араластырыңыз. Тіпті Кагецу-сан.
Dialogue: 0,0:04:40.28,0:04:42.24,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:04:43.78,0:04:47.25,Default,,0,0,0,,Міне! Қаңғыбас мысық.
Dialogue: 0,0:04:47.25,0:04:49.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:49.25,0:04:51.25,Default,,0,0,0,,Гуруруру….
Dialogue: 0,0:04:57.26,0:04:59.76,Default,,0,0,0,,Мм... Ұн?
Dialogue: 0,0:04:59.76,0:05:03.27,Default,,0,0,0,,Митан қашаннан бері Авангардты ойнайды?
Dialogue: 0,0:05:03.27,0:05:05.30,Default,,0,0,0,,Мүмкін орта мектептен бері.
Dialogue: 0,0:05:05.30,0:05:08.77,Default,,0,0,0,,Менің жағдайда ол Net Vanguard-тан басталды...
Dialogue: 0,0:05:08.77,0:05:11.27,Default,,0,0,0,,Мен нақты карталарды қозғай бастадым➡
Dialogue: 0,0:05:11.27,0:05:14.24,Default,,0,0,0,,Өткен жыл туралы. Солай ма!
Dialogue: 0,0:05:14.24,0:05:16.75,Default,,0,0,0,,Жақсы, екеуі де!
Dialogue: 0,0:05:16.75,0:05:18.78,Default,,0,0,0,,Урара-чан қашан келді?
Dialogue: 0,0:05:18.78,0:05:20.75,Default,,0,0,0,,Мен мұнда орта мектептің бірінші курсынан бері келемін.
Dialogue: 0,0:05:20.75,0:05:22.78,Default,,0,0,0,,Қараңғылыққа тап болу➡
Dialogue: 0,0:05:22.78,0:05:25.25,Default,,0,0,0,,Содан бері көп нәрсе болды...
Dialogue: 0,0:05:25.25,0:05:28.26,Default,,0,0,0,,Енді Blackout➡-пен еркін күресіңіз
Dialogue: 0,0:05:28.26,0:05:31.26,Default,,0,0,0,,Кәсіби Тирунаногу жастары болуды мақсат ету➡
Dialogue: 0,0:05:31.26,0:05:33.26,Default,,0,0,0,,Мен екеуіне де тиесілімін!
Dialogue: 0,0:05:33.26,0:05:35.30,Default,,0,0,0,,Екеуі де? Керемет!
Dialogue: 0,0:05:35.30,0:05:38.83,Default,,0,0,0,,Мен де үрмелі аспаптар клубының мүшесімін!
Dialogue: 0,0:05:38.83,0:05:40.77,Default,,0,0,0,,Өйткені мен сараңмын!
Dialogue: 0,0:05:40.77,0:05:42.77,Default,,0,0,0,,О!
Dialogue: 0,0:05:42.77,0:05:46.27,Default,,0,0,0,,Бірақ соңғы уақытта біраз қиналып жүрмін.
Dialogue: 0,0:05:46.27,0:05:49.28,Default,,0,0,0,,...Бұл туралы Митанмен сөйлесу керек емес!
Dialogue: 0,0:05:49.28,0:05:51.25,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:05:52.75,0:05:55.25,Default,,0,0,0,,Мен және Blackout ➡ тобының барлығы
Dialogue: 0,0:05:55.25,0:05:57.25,Default,,0,0,0,,Мен төбелеске барамын➡
Dialogue: 0,0:05:57.25,0:05:59.29,Default,,0,0,0,,Сіз де келгіңіз келе ме? ➡
Dialogue: 0,0:05:59.29,0:06:01.26,Default,,0,0,0,,Бұл қызық болатыны сөзсіз!
Dialogue: 0,0:06:01.26,0:06:03.29,Default,,0,0,0,,Менің барғым келеді!
Dialogue: 0,0:06:03.29,0:06:06.26,Default,,0,0,0,,Мен де! Біз көп ұрысатын сияқтымыз.
Dialogue: 0,0:06:06.26,0:06:08.26,Default,,0,0,0,,Сосын мен де.
Dialogue: 0,0:06:08.26,0:06:10.27,Default,,0,0,0,,Митан да келеді, солай ма?
Dialogue: 0,0:06:10.27,0:06:12.33,Default,,0,0,0,,Әрине! ➡
Dialogue: 0,0:06:12.33,0:06:14.27,Default,,0,0,0,,Мен мынаны айтқым келеді➡
Dialogue: 0,0:06:14.27,0:06:16.27,Default,,0,0,0,,Мен түнде жұмыс істеуім керек.
Dialogue: 0,0:06:16.27,0:06:18.27,Default,,0,0,0,,Иә? ➡
Dialogue: 0,0:06:18.27,0:06:21.28,Default,,0,0,0,,Мен Митанмен күресе аламын деп ойладым.
Dialogue: 0,0:06:22.28,0:06:24.25,Default,,0,0,0,,Кешіріңіз! үй! ➡
Dialogue: 0,0:06:24.25,0:06:26.75,Default,,0,0,0,,Жұмыс маңызды.
Dialogue: 0,0:06:27.78,0:06:29.75,Default,,0,0,0,,Әрине, Каге-кун келеді, солай ма?
Dialogue: 0,0:06:29.75,0:06:31.75,Default,,0,0,0,,Мен өтемін.
Dialogue: 0,0:06:31.75,0:06:33.82,Default,,0,0,0,,Е! неге?
Dialogue: 0,0:06:33.82,0:06:35.76,Default,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:06:35.76,0:06:37.76,Default,,0,0,0,,Урара-чан➡
Dialogue: 0,0:06:37.76,0:06:40.26,Default,,0,0,0,,Ауыстыру дегенді қалай түсінесіз?
Dialogue: 0,0:06:40.26,0:06:42.23,Default,,0,0,0,,Енді күресейік!
Dialogue: 0,0:06:43.77,0:06:45.73,Default,,0,0,0,,Аха!
Dialogue: 0,0:06:52.77,0:06:55.74,Default,,0,0,0,,Митанмен төбелесу үлкен мәртебе!
Dialogue: 0,0:06:55.74,0:06:58.25,Default,,0,0,0,,Бар күшімізбен күресейік!
Dialogue: 0,0:06:58.25,0:07:01.25,Default,,0,0,0,,Әрине! Мен жеңемін.
Dialogue: 0,0:07:05.25,0:07:07.26,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:07:07.26,0:07:09.76,Default,,0,0,0,,Корфи арқылы соғатын жел.
Dialogue: 0,0:07:09.76,0:07:11.76,Default,,0,0,0,,Ғажайып лаванда Уршур.
Dialogue: 0,0:07:11.76,0:07:13.76,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:07:13.76,0:07:16.26,Default,,0,0,0,,Толқындап жатқан Грецияға➡ барыңыз
Dialogue: 0,0:07:16.26,0:07:19.27,Default,,0,0,0,,Өсімдік жетонын шеберлікпен шақырыңыз➡
Dialogue: 0,0:07:19.27,0:07:21.77,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім ➡
Dialogue: 0,0:07:21.77,0:07:24.77,Default,,0,0,0,,Тиффинге бару Юикаға қоңырау шалыңыз➡
Dialogue: 0,0:07:24.77,0:07:26.78,Default,,0,0,0,,Тиффинмен шабуыл.
Dialogue: 0,0:07:26.78,0:07:29.24,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:07:29.24,0:07:31.25,Default,,0,0,0,,Юикамен шабуыл. күзетші.
Dialogue: 0,0:07:31.25,0:07:33.28,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:07:33.28,0:07:36.25,Default,,0,0,0,,Ұнады! Кәсіби маман болуды мақсат етіп отырмын➡
Dialogue: 0,0:07:36.25,0:07:38.75,Default,,0,0,0,,Мен ойнауда еш қиналмайтындай сезінемін!
Dialogue: 0,0:07:38.75,0:07:42.26,Default,,0,0,0,,Шынымен бе? Мен бақыттымын!
Dialogue: 0,0:07:42.26,0:07:44.83,Default,,0,0,0,,Ми Танға да Vanguard ➡ ұнайды
Dialogue: 0,0:07:44.83,0:07:46.76,Default,,0,0,0,,Дыбыс арқылы беріледі.
Dialogue: 0,0:07:46.76,0:07:48.83,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:07:48.83,0:07:50.83,Default,,0,0,0,,Мен картамның дыбысын естимін.
Dialogue: 0,0:07:51.77,0:07:55.27,Default,,0,0,0,,Дыбысты естігенде, оны қалай да түсінуге болады➡
Dialogue: 0,0:07:55.27,0:07:57.77,Default,,0,0,0,,Сол адамның авангард.
Dialogue: 0,0:07:57.77,0:08:01.24,Default,,0,0,0,,Митанның дыбысы өте көңілді естіледі➡
Dialogue: 0,0:08:01.24,0:08:04.78,Default,,0,0,0,,Сонда да мен жеңу үшін бар күшімді салып жатырмын...
Dialogue: 0,0:08:04.78,0:08:08.28,Default,,0,0,0,,Сіз кәсіби маман болуды мақсат етпейсіз бе?
Dialogue: 0,0:08:09.25,0:08:11.25,Default,,0,0,0,,Жақсы….
Dialogue: 0,0:08:11.25,0:08:13.29,Default,,0,0,0,,Ха! Бұл➡
Dialogue: 0,0:08:13.29,0:08:16.76,Default,,0,0,0,,Бұл өте нәзік тақырып, солай емес пе? Мен оны жаңа ғана естідім!
Dialogue: 0,0:08:16.76,0:08:18.76,Default,,0,0,0,,Жарайды➡
Dialogue: 0,0:08:18.76,0:08:20.76,Default,,0,0,0,,Мен де осыны ойладым.
Dialogue: 0,0:08:20.76,0:08:22.73,Default,,0,0,0,,Уау...
Dialogue: 0,0:08:24.30,0:08:27.77,Default,,0,0,0,,Бұл жақсы мүмкіндік болғандықтан, мен барлығынан сұрайын деп ойладым.
Dialogue: 0,0:08:27.77,0:08:29.77,Default,,0,0,0,,Ым?
Dialogue: 0,0:08:29.77,0:08:31.74,Default,,0,0,0,,Мен және Авангард туралы.
Dialogue: 0,0:08:34.28,0:08:37.28,Default,,0,0,0,,Айтыңызшы! Митан туралы➡
Dialogue: 0,0:08:37.28,0:08:39.28,Default,,0,0,0,,Ұрыс! ➡
Dialogue: 0,0:08:39.28,0:08:41.28,Default,,0,0,0,,Менің кезегім! ➡
Dialogue: 0,0:08:41.28,0:08:44.29,Default,,0,0,0,,Үміттің әуеніне мініңіз➡
Dialogue: 0,0:08:44.29,0:08:46.25,Default,,0,0,0,,Альвинаға➡ қоңырау шалыңыз
Dialogue: 0,0:08:46.25,0:08:48.29,Default,,0,0,0,,Элентиске шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:08:48.29,0:08:50.26,Default,,0,0,0,,Кеттік! ➡
Dialogue: 0,0:08:50.26,0:08:52.26,Default,,0,0,0,,Элентиспен шабуыл!
Dialogue: 0,0:08:52.26,0:08:54.76,Default,,0,0,0,,Күзетші. Ректинамен шабуыл жасаңыз!
Dialogue: 0,0:08:54.76,0:08:56.80,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:08:56.80,0:08:58.80,Default,,0,0,0,,Альвинамен шабуыл!
Dialogue: 0,0:08:58.80,0:09:01.27,Default,,0,0,0,,Күзетші! Соңына бұрылу.
Dialogue: 0,0:09:01.27,0:09:03.27,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:09:03.27,0:09:06.27,Default,,0,0,0,,Армельге Мюзеттаның жүру шеберлігімен қоңырау шалыңыз➡
Dialogue: 0,0:09:06.27,0:09:09.78,Default,,0,0,0,,Soul Charge Musette көмегімен шабуыл!
Dialogue: 0,0:09:09.78,0:09:12.78,Default,,0,0,0,,Күзетші. Армельмен шабуыл!
Dialogue: 0,0:09:12.78,0:09:14.78,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:09:14.78,0:09:17.75,Default,,0,0,0,,Юиканың Армел шеберлігін қолына қайтарыңыз➡
Dialogue: 0,0:09:17.75,0:09:19.75,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:09:21.32,0:09:25.29,Default,,0,0,0,,Кумир болудан үзіліс алған кезім болды.
Dialogue: 0,0:09:25.29,0:09:27.26,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:28.80,0:09:31.80,Default,,0,0,0,,Ал...көп нәрсе болды➡
Dialogue: 0,0:09:31.80,0:09:34.27,Default,,0,0,0,,Менің де психикалық денсаулығым нашарлады.
Dialogue: 0,0:09:34.27,0:09:36.27,Default,,0,0,0,,Бұл кезде➡
Dialogue: 0,0:09:36.27,0:09:38.77,Default,,0,0,0,,Авангард менің құтқарушым болды.
Dialogue: 0,0:09:42.31,0:09:44.78,Default,,0,0,0,,Vanguard сіздің күнделікті өміріңізге түс қосады➡
Dialogue: 0,0:09:44.78,0:09:48.28,Default,,0,0,0,,Мен үшін маңызды нәрселер.
Dialogue: 0,0:09:48.28,0:09:50.25,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:09:51.79,0:09:53.76,Default,,0,0,0,,Кәсіби маман болуды мақсат етпеңіз!
Dialogue: 0,0:09:53.76,0:09:55.76,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:09:57.29,0:09:59.76,Default,,0,0,0,,Мен Vanguard➡ жарысында жарысқым келеді
Dialogue: 0,0:09:59.76,0:10:01.76,Default,,0,0,0,,Мен оның жұмыс болғанын қаламаймын.
Dialogue: 0,0:10:01.76,0:10:04.80,Default,,0,0,0,,Әрине мен кәсіпқойларды сынамаймын, солай ма?
Dialogue: 0,0:10:04.80,0:10:06.80,Default,,0,0,0,,Мен ғана ➡
Dialogue: 0,0:10:06.80,0:10:10.27,Default,,0,0,0,,Net Vanguard➡ көмегімен рейтингтер үшін оңай бәсекелесіңіз
Dialogue: 0,0:10:10.27,0:10:12.74,Default,,0,0,0,,Ақымақ боп көңіл көтеріп, күліңіз...
Dialogue: 0,0:10:13.78,0:10:16.78,Default,,0,0,0,,Мен сол авангардтарды жақсы көремін!
Dialogue: 0,0:10:16.78,0:10:19.81,Default,,0,0,0,,Микото-сан! Ум...! ➡
Dialogue: 0,0:10:19.81,0:10:22.78,Default,,0,0,0,,Сіз ұстанғыңыз келетін жол адамнан адамға өзгереді.
Dialogue: 0,0:10:23.79,0:10:25.75,Default,,0,0,0,,Әдемі дыбыс➡
Dialogue: 0,0:10:25.75,0:10:29.26,Default,,0,0,0,,Бұл Митанның жекпе-жегі!
Dialogue: 0,0:10:29.26,0:10:31.76,Default,,0,0,0,,Мен де Vanguard ойынын шындап ойнаймын➡
Dialogue: 0,0:10:31.76,0:10:34.26,Default,,0,0,0,,Авангард да көңілді...
Dialogue: 0,0:10:34.26,0:10:37.27,Default,,0,0,0,,Авангардтар кейде ұрысады.
Dialogue: 0,0:10:37.27,0:10:39.27,Default,,0,0,0,,Маған бәрі ұнайды.
Dialogue: 0,0:10:39.27,0:10:41.30,Default,,0,0,0,,Барлық дыбыстар әртүрлі➡
Dialogue: 0,0:10:41.30,0:10:43.81,Default,,0,0,0,,Ол сол кезде ғана естілетін музыкаға айналады!
Dialogue: 0,0:10:44.77,0:10:47.81,Default,,0,0,0,,Мен әртүрлі адамдармен төбелестім➡
Dialogue: 0,0:10:47.81,0:10:50.81,Default,,0,0,0,,Мен сол адам ғана жасай алатын авангардты ойнағым келеді.
Dialogue: 0,0:10:51.78,0:10:54.78,Default,,0,0,0,,Дыбыстарды қабаттап, бір дыбысқа айналдыру➡
Dialogue: 0,0:10:54.78,0:10:58.25,Default,,0,0,0,,Бұл менің күресім!
Dialogue: 0,0:10:58.25,0:11:01.26,Default,,0,0,0,,Жаңғырту! Барлығының үні➡
Dialogue: 0,0:11:01.26,0:11:04.76,Default,,0,0,0,,Бандмейстер гүлде➡
Dialogue: 0,0:11:04.76,0:11:07.26,Default,,0,0,0,,Рианорн Тройментке➡
Dialogue: 0,0:11:07.26,0:11:09.26,Default,,0,0,0,,Юнисон көйлек!
Dialogue: 0,0:11:10.77,0:11:12.80,Default,,0,0,0,,Ректина дағдылары➡
Dialogue: 0,0:11:12.80,0:11:15.77,Default,,0,0,0,,Осы айналымда Рианорн қолданған қарсы жарылысты 1-ге азайтыңыз.
Dialogue: 0,0:11:15.77,0:11:17.77,Default,,0,0,0,,Морварға қоңырау шалыңыз➡
Dialogue: 0,0:11:17.77,0:11:20.98,Default,,0,0,0,,Шеберлікпен 1 картаны салыңыз және Лаграс➡ шақырыңыз
Dialogue: 0,0:11:20.98,0:11:23.78,Default,,0,0,0,,Рианорнды қолыңызға шеберлікпен қосыңыз➡
Dialogue: 0,0:11:23.78,0:11:26.28,Default,,0,0,0,,Енді ойнайық! ➡
Dialogue: 0,0:11:26.28,0:11:28.28,Default,,0,0,0,,Рианорнмен шабуыл!
Dialogue: 0,0:11:28.28,0:11:31.25,Default,,0,0,0,,Дағды бойынша 3 артқы қатардағы карталармен күшейтіңіз➡
Dialogue: 0,0:11:31.25,0:11:33.25,Default,,0,0,0,,Жүргізу плюс 1!
Dialogue: 0,0:11:33.25,0:11:36.26,Default,,0,0,0,,Күзетші жоқ. Бірінші тексеру➡
Dialogue: 0,0:11:36.26,0:11:38.26,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:11:38.26,0:11:40.26,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:11:40.26,0:11:43.77,Default,,0,0,0,,Триггер Морвардың қуатын +10000 сызыңыз!
Dialogue: 0,0:11:45.80,0:11:48.77,Default,,0,0,0,,Ұрыс соңында 2 картаны артқы қатарға қойыңыз➡
Dialogue: 0,0:11:48.77,0:11:50.77,Default,,0,0,0,,Жалғасы бар! ➡
Dialogue: 0,0:11:50.77,0:11:52.77,Default,,0,0,0,,Лаграспен шабуыл!
Dialogue: 0,0:11:52.77,0:11:55.28,Default,,0,0,0,,Күзетші жоқ. Морвармен шабуыл.
Dialogue: 0,0:11:55.28,0:11:57.28,Default,,0,0,0,,Өтпеңіз! ➡
Dialogue: 0,0:11:57.28,0:11:59.28,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:11:59.28,0:12:01.25,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:12:04.25,0:12:06.29,Default,,0,0,0,,Мм... Ын?
Dialogue: 0,0:12:06.29,0:12:08.26,Default,,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:12:08.26,0:12:10.26,Default,,0,0,0,,Митан сізге жауап береді➡
Dialogue: 0,0:12:10.26,0:12:12.79,Default,,0,0,0,,Қорықпадың ба?
Dialogue: 0,0:12:12.79,0:12:14.76,Default,,0,0,0,,Хмм, сіз қалай ойлайсыз?
Dialogue: 0,0:12:14.76,0:12:16.76,Default,,0,0,0,,Бірақ➡
Dialogue: 0,0:12:16.76,0:12:18.77,Default,,0,0,0,,Өйткені бұл бала сонда болды.
Dialogue: 0,0:12:20.84,0:12:24.27,Default,,0,0,0,,((Білесіз бе, мен...
Dialogue: 0,0:12:24.27,0:12:27.28,Default,,0,0,0,,Мен өзіме ұнайтын нәрсені ұстанамын деп ойлаймын.
Dialogue: 0,0:12:27.28,0:12:30.85,Default,,0,0,0,,Сенің де сол жолда болғаныңды қалаймын.
Dialogue: 0,0:12:30.85,0:12:32.81,Default,,0,0,0,,Менімен қаласың ба? ))
Dialogue: 0,0:12:35.78,0:12:38.25,Default,,0,0,0,,Маған сеніңіз және мені бақылаңыз➡
Dialogue: 0,0:12:38.25,0:12:40.29,Default,,0,0,0,,Басқа мен.
Dialogue: 0,0:12:40.29,0:12:43.26,Default,,0,0,0,,Ол менің үнемі өзгеретін өзімді растайды➡
Dialogue: 0,0:12:43.26,0:12:45.33,Default,,0,0,0,,Ең жақсы альтер-эго!
Dialogue: 0,0:12:45.33,0:12:48.80,Default,,0,0,0,,Жарқырау Барлық сезімдер біріктірген толқындардың калейдоскопы!
Dialogue: 0,0:12:50.26,0:12:52.30,Default,,0,0,0,,Барлық заттардың тағдыры➡
Dialogue: 0,0:12:52.30,0:12:54.77,Default,,0,0,0,,Крис Лейн Каденцаға мініңіз!
Dialogue: 0,0:12:55.77,0:12:58.77,Default,,0,0,0,,Уау! Керемет және әдемі дыбыс...
Dialogue: 0,0:12:58.77,0:13:01.38,Default,,0,0,0,,Франсетаны шеберлікпен шақырыңыз➡
Dialogue: 0,0:13:01.38,0:13:03.28,Default,,0,0,0,,Армельге➡ қоңырау шалыңыз
Dialogue: 0,0:13:03.28,0:13:05.28,Default,,0,0,0,,Дағды бойынша 1 картаны салыңыз➡
Dialogue: 0,0:13:05.28,0:13:07.78,Default,,0,0,0,,Крис Рейн мен Армельдің күші плюс 5000➡
Dialogue: 0,0:13:07.78,0:13:09.78,Default,,0,0,0,,Рошельге➡ қоңырау шалыңыз
Dialogue: 0,0:13:09.78,0:13:12.25,Default,,0,0,0,,Кеттік, барлық нәрсенің құдіреті! ➡
Dialogue: 0,0:13:12.25,0:13:14.26,Default,,0,0,0,,Крис Рейннің шеберлігі іске қосылды! ➡
Dialogue: 0,0:13:14.26,0:13:16.26,Default,,0,0,0,,Менің өлшем бірліктерім 5 түрлі➡
Dialogue: 0,0:13:16.26,0:13:19.29,Default,,0,0,0,,Сондықтан төрт әсер іске қосылады➡
Dialogue: 0,0:13:19.29,0:13:22.80,Default,,0,0,0,,1 1 картаны салып, 3 картаны энергиямен зарядтаңыз.
Dialogue: 0,0:13:23.77,0:13:27.30,Default,,0,0,0,,Екі Франсетаның күші плюс 15 000!
Dialogue: 0,0:13:27.30,0:13:30.81,Default,,0,0,0,,3 Крис Рейннің сыни плюс 1!
Dialogue: 0,0:13:30.81,0:13:34.78,Default,,0,0,0,,4 Бұрылыс соңында Юиканы қолыңызға қайтарыңыз!
Dialogue: 0,0:13:34.78,0:13:37.28,Default,,0,0,0,,Ол көп белсендірілді!
Dialogue: 0,0:13:37.28,0:13:39.28,Default,,0,0,0,,Қосымша Франсетт дағдылары➡
Dialogue: 0,0:13:39.28,0:13:41.78,Default,,0,0,0,,Крис Рейннің күші плюс 10 000! ➡
Dialogue: 0,0:13:41.78,0:13:43.79,Default,,0,0,0,,Лисиусқа➡ қоңырау шалыңыз
Dialogue: 0,0:13:43.79,0:13:45.79,Default,,0,0,0,,Крис Рейннің күші плюс 10 000!
Dialogue: 0,0:13:45.79,0:13:48.26,Default,,0,0,0,,Армельмен шабуыл! Қарғыс атсын...! ➡
Dialogue: 0,0:13:48.26,0:13:50.26,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:13:50.26,0:13:52.26,Default,,0,0,0,,Франсеттпен шабуыл!
Dialogue: 0,0:13:52.26,0:13:54.30,Default,,0,0,0,,Күзетсіз➡
Dialogue: 0,0:13:54.30,0:13:56.26,Default,,0,0,0,,Зақымдануды тексеру➡
Dialogue: 0,0:13:56.26,0:13:58.27,Default,,0,0,0,,Мен естідім...
Dialogue: 0,0:14:02.27,0:14:04.27,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:14:08.78,0:14:12.28,Default,,0,0,0,,Триггер Рианорн қуатын сызыңыз, плюс 10000.
Dialogue: 0,0:14:13.28,0:14:15.28,Default,,0,0,0,,Біз әлі де осындамыз! ➡
Dialogue: 0,0:14:15.28,0:14:18.25,Default,,0,0,0,,Крис Рейнмен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:14:18.25,0:14:20.76,Default,,0,0,0,,Рошельдің шеберлігі Франсетт тұр!
Dialogue: 0,0:14:20.76,0:14:22.86,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:14:22.86,0:14:25.29,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:14:25.29,0:14:27.30,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:14:27.30,0:14:30.77,Default,,0,0,0,,Критикалық триггер! Франсетт қуаты плюс 10000➡
Dialogue: 0,0:14:30.77,0:14:32.80,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:14:32.80,0:14:34.77,Default,,0,0,0,,Франсеттпен шабуыл!
Dialogue: 0,0:14:34.77,0:14:36.77,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:14:36.77,0:14:39.27,Default,,0,0,0,,Ku~! Орындайық, Урара-чан.
Dialogue: 0,0:14:39.27,0:14:41.28,Default,,0,0,0,,Ішім!
Dialogue: 0,0:14:41.28,0:14:43.31,Default,,0,0,0,,Уфуфу...!
Dialogue: 0,0:14:43.31,0:14:45.78,Default,,0,0,0,,Бұрылыстың соңында Юиканы қолыңызға қайтарыңыз.
Dialogue: 0,0:14:48.42,0:14:52.25,Default,,0,0,0,,Мен саған сараңмын деп айтпадым ба?
Dialogue: 0,0:14:52.25,0:14:55.76,Default,,0,0,0,,Мен жұмсақ әрі көңілді төбелесемін➡
Dialogue: 0,0:14:55.76,0:14:58.26,Default,,0,0,0,,Күшті және батыл күрес➡
Dialogue: 0,0:14:58.26,0:15:01.26,Default,,0,0,0,,Мен екеуіне де тәнтімін.
Dialogue: 0,0:15:01.26,0:15:03.26,Default,,0,0,0,,Бұрын біз оны қауіпсіз ойнайтынбыз➡
Dialogue: 0,0:15:03.26,0:15:06.80,Default,,0,0,0,,Мен бәрін істеп жатқандай болдым.
Dialogue: 0,0:15:06.80,0:15:09.27,Default,,0,0,0,,Музыка және өшіру➡
Dialogue: 0,0:15:09.27,0:15:11.84,Default,,0,0,0,,Тирнаног жастары да...
Dialogue: 0,0:15:11.84,0:15:14.78,Default,,0,0,0,,Қазір де ол сезім өзгерген жоқ.➡
Dialogue: 0,0:15:14.78,0:15:17.78,Default,,0,0,0,,Мен бұл туралы кейде ойлаймын.
Dialogue: 0,0:15:17.78,0:15:20.28,Default,,0,0,0,,Біреуін таңдау керек болатын күн келгенде➡
Dialogue: 0,0:15:20.28,0:15:22.25,Default,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,0:15:23.28,0:15:26.25,Default,,0,0,0,,Хмм….
Dialogue: 0,0:15:26.25,0:15:28.29,Default,,0,0,0,,А...қайсысы маңызды емес деп ойлаймын.
Dialogue: 0,0:15:28.29,0:15:30.26,Default,,0,0,0,,Бұл орынды!
Dialogue: 0,0:15:30.26,0:15:32.26,Default,,0,0,0,,Жоқ...!
Dialogue: 0,0:15:32.26,0:15:34.76,Default,,0,0,0,,Менің ойымша, бұл жай ғана ойлау тәсілі.
Dialogue: 0,0:15:34.76,0:15:36.76,Default,,0,0,0,,E?
Dialogue: 0,0:15:36.76,0:15:39.30,Default,,0,0,0,,Тіпті кәсіпқойлар да жұмсақ әрі көңілді жекпе-жек өткізе алады➡
Dialogue: 0,0:15:39.30,0:15:42.80,Default,,0,0,0,,Тіпті әуесқойлар да байыпты бәсекеге түсе алады.
Dialogue: 0,0:15:42.80,0:15:46.77,Default,,0,0,0,,Егер сіз музыкалық мансаппен айналыссаңыз да, дәл осылай Авангард жасай алады.
Dialogue: 0,0:15:46.77,0:15:49.78,Default,,0,0,0,,Мен про➡ болмауды таңдадым
Dialogue: 0,0:15:49.78,0:15:52.78,Default,,0,0,0,,Ең бастысы, сіз сол жолмен жүресіз➡
Dialogue: 0,0:15:52.78,0:15:55.78,Default,,0,0,0,,Менің ойымша, бұл сіздің қалай болғыңыз келетініне байланысты.
Dialogue: 0,0:15:55.78,0:15:58.75,Default,,0,0,0,,Сіз қалай болғыңыз келеді?
Dialogue: 0,0:15:58.75,0:16:00.79,Default,,0,0,0,,Қандай жолмен жүрсеңіз де➡
Dialogue: 0,0:16:00.79,0:16:03.36,Default,,0,0,0,,Мен сіздің тәжірибеңізге сенімдімін➡
Dialogue: 0,0:16:03.36,0:16:05.79,Default,,0,0,0,,Бұл Урара-чанның тамағы болады, жоғалмайды!
Dialogue: 0,0:16:05.79,0:16:09.80,Default,,0,0,0,,Ендеше, сіз өзіңіз сияқты өзіңізге көбірек сенуіңіз керек емес пе?
Dialogue: 0,0:16:09.80,0:16:12.77,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:16:12.77,0:16:15.27,Default,,0,0,0,,Аха...сәлем!
Dialogue: 0,0:16:15.27,0:16:17.77,Default,,0,0,0,,Мен барған сайын жігерлі сезінемін!
Dialogue: 0,0:16:17.77,0:16:19.77,Default,,0,0,0,,Хмм... бұл рух!
Dialogue: 0,0:16:19.77,0:16:21.78,Default,,0,0,0,,Жарайды! ➡
Dialogue: 0,0:16:21.78,0:16:23.78,Default,,0,0,0,,Урара Ханеяма толық қуатта! ➡
Dialogue: 0,0:16:23.78,0:16:25.78,Default,,0,0,0,,Кеттік! ➡
Dialogue: 0,0:16:25.78,0:16:27.78,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:16:27.78,0:16:30.75,Default,,0,0,0,,Persona Ride Rhianorn Troument!
Dialogue: 0,0:16:30.75,0:16:33.29,Default,,0,0,0,,Элентис пен Лаграсқа қоңырау шалыңыз➡
Dialogue: 0,0:16:33.29,0:16:36.26,Default,,0,0,0,,Рианорн Вивасты шеберлікпен қолыңызға қосыңыз.
Dialogue: 0,0:16:36.26,0:16:38.29,Default,,0,0,0,,Лаграспен шабуыл!
Dialogue: 0,0:16:38.29,0:16:40.29,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:16:40.29,0:16:42.30,Default,,0,0,0,,Морвардағы шабуыл шеберлігі бойынша➡
Dialogue: 0,0:16:42.30,0:16:44.80,Default,,0,0,0,,Артқы қатардағы Элентистің күші➡
Dialogue: 0,0:16:44.80,0:16:47.30,Default,,0,0,0,,Өз күшіңізді арттырыңыз!
Dialogue: 0,0:16:47.30,0:16:49.27,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:16:49.27,0:16:51.27,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін!
Dialogue: 0,0:16:51.27,0:16:54.28,Default,,0,0,0,,Рианорнмен бірге Авангардқа шабуыл жасаңыз! ➡
Dialogue: 0,0:16:54.28,0:16:56.28,Default,,0,0,0,,Барлық артқы қатарларда тұру дағдысын қолданыңыз➡
Dialogue: 0,0:16:56.28,0:16:58.28,Default,,0,0,0,,Артқы қатардағы 3 картамен күшейтіңіз➡
Dialogue: 0,0:16:58.28,0:17:00.28,Default,,0,0,0,,Жүргізу плюс 1!
Dialogue: 0,0:17:03.78,0:17:05.79,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:17:08.26,0:17:10.29,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:17:10.29,0:17:12.33,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:17:12.33,0:17:14.30,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:17:14.30,0:17:17.33,Default,,0,0,0,,Критикалық триггер! Рианорнның қуаты плюс 10000➡
Dialogue: 0,0:17:17.33,0:17:19.80,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:17:19.80,0:17:23.27,Default,,0,0,0,,Ұрыс соңында Рианорн мен Морвар➡ тұрыңыз
Dialogue: 0,0:17:23.27,0:17:26.31,Default,,0,0,0,,Қуат плюс 10000 Drive минус 3.
Dialogue: 0,0:17:26.31,0:17:29.78,Default,,0,0,0,,Сонымен қатар, Рианорнды қолыңыздан жаныңызға қою арқылы➡
Dialogue: 0,0:17:29.78,0:17:31.78,Default,,0,0,0,,Жүргізу плюс 1!
Dialogue: 0,0:17:31.78,0:17:33.75,Default,,0,0,0,,Рианорнмен тағы да шабуыл жасаңыз!
Dialogue: 0,0:17:34.78,0:17:36.78,Default,,0,0,0,,Әрине! Өлім сақшысы➡
Dialogue: 0,0:17:36.78,0:17:39.75,Default,,0,0,0,,Күзетші! Көлікті тексеру➡
Dialogue: 0,0:17:39.75,0:17:42.26,Default,,0,0,0,,Иә! Критикалық триггер! ➡
Dialogue: 0,0:17:42.26,0:17:44.26,Default,,0,0,0,,Морвар қуаты плюс 10000➡
Dialogue: 0,0:17:44.26,0:17:46.26,Default,,0,0,0,,Сыни плюс 1.
Dialogue: 0,0:17:46.26,0:17:48.80,Default,,0,0,0,,Бұл аяқталды➡
Dialogue: 0,0:17:48.80,0:17:51.77,Default,,0,0,0,,Морвармен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:17:51.77,0:17:53.77,Default,,0,0,0,,Маған рұқсат етіңіз! ➡
Dialogue: 0,0:17:53.77,0:17:56.27,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:17:56.27,0:17:59.27,Default,,0,0,0,,Енді алдын аласың ба?
Dialogue: 0,0:17:59.27,0:18:01.28,Default,,0,0,0,,Керемет жігер!
Dialogue: 0,0:18:01.28,0:18:03.78,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:18:03.78,0:18:06.78,Default,,0,0,0,,Финал жарқырай ма?
Dialogue: 0,0:18:06.78,0:18:09.28,Default,,0,0,0,,Урара-чан...менімен бара аласың ба?
Dialogue: 0,0:18:09.28,0:18:12.75,Default,,0,0,0,,Әрине! Мен мәңгілікке жүремін.
Dialogue: 0,0:18:12.75,0:18:14.76,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:18:14.76,0:18:16.76,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:18:16.76,0:18:18.76,Default,,0,0,0,,Крис Лейн Каденца!
Dialogue: 0,0:18:22.76,0:18:25.30,Default,,0,0,0,,Армелге қоңырау шалыңыз Торманаға ➡
Dialogue: 0,0:18:25.30,0:18:27.77,Default,,0,0,0,,Рошельге шеберлікпен қоңырау шалыңыз➡
Dialogue: 0,0:18:27.77,0:18:31.37,Default,,0,0,0,,Уоллиске қоңырау шалу Крис Рейннің шеберлігін белсендіріңіз➡
Dialogue: 0,0:18:31.37,0:18:35.31,Default,,0,0,0,,Меншікті қуат плюс 15000 критикалық плюс 1.
Dialogue: 0,0:18:35.31,0:18:38.78,Default,,0,0,0,,Бұрылыстың соңында Уоллисті қолыңызға қайтарыңыз.
Dialogue: 0,0:18:38.78,0:18:40.78,Default,,0,0,0,,Кристинге➡ қоңырау шалыңыз
Dialogue: 0,0:18:40.78,0:18:42.78,Default,,0,0,0,,Торманамен шабуыл!
Dialogue: 0,0:18:42.78,0:18:45.79,Default,,0,0,0,,Күзетші жоқ! Зақымдануды тексеру...
Dialogue: 0,0:18:46.79,0:18:49.79,Default,,0,0,0,,Критикалық триггер Рианорнның қуаты плюс 10 000!
Dialogue: 0,0:18:52.29,0:18:55.26,Default,,0,0,0,,Жасайық! Бірақ сіз мұны қабылдай аласыз ба? ➡
Dialogue: 0,0:18:55.26,0:18:57.30,Default,,0,0,0,,Армельмен шабуыл!
Dialogue: 0,0:18:57.30,0:18:59.27,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:18:59.27,0:19:02.77,Default,,0,0,0,,Крис Рейнмен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:19:02.77,0:19:04.77,Default,,0,0,0,,Күзетші! Кесу.
Dialogue: 0,0:19:06.77,0:19:09.28,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:19:09.28,0:19:11.28,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:19:11.28,0:19:14.28,Default,,0,0,0,,Критикалық триггер! Армельдің күші плюс 10000➡
Dialogue: 0,0:19:14.28,0:19:16.28,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:19:16.28,0:19:19.25,Default,,0,0,0,,Мен сізге... Крис Рейннің кереметін көрсетемін!
Dialogue: 0,0:19:19.25,0:19:21.26,Default,,0,0,0,,Керемет ➡
Dialogue: 0,0:19:21.26,0:19:23.26,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:19:26.33,0:19:28.80,Default,,0,0,0,,Артқы қорғаушылардың кез келген санын қолыңызға қайтарыңыз...
Dialogue: 0,0:19:30.87,0:19:32.87,Default,,0,0,0,,Жеңіске жету мүмкіндігі➡
Dialogue: 0,0:19:32.87,0:19:35.27,Default,,0,0,0,,Сол тамшыны алыңыз.
Dialogue: 0,0:19:35.27,0:19:37.27,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:19:37.27,0:19:39.31,Default,,0,0,0,,Тормананы өз қолыңнан шақыр! ➡
Dialogue: 0,0:19:39.31,0:19:43.28,Default,,0,0,0,,Оның күші мен сыни соққысын Крис Рейндікіне тең етіңіз.
Dialogue: 0,0:19:43.28,0:19:45.78,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:45.78,0:19:48.28,Default,,0,0,0,,Тормана дағдылары деп аталады➡
Dialogue: 0,0:19:48.28,0:19:50.28,Default,,0,0,0,,Авелла Дженнаға қоңырау шалыңыз!
Dialogue: 0,0:19:51.29,0:19:54.29,Default,,0,0,0,,Мен бәрін сол қалпында бекіткім келеді.
Dialogue: 0,0:19:56.26,0:19:58.26,Default,,0,0,0,,Мен сені қолдаймын! ➡
Dialogue: 0,0:19:58.26,0:20:00.76,Default,,0,0,0,,Урара-чанның үнемі өзгеріп отыратын трансформациясы!
Dialogue: 0,0:20:00.76,0:20:03.76,Default,,0,0,0,,А... Митан!
Dialogue: 0,0:20:04.77,0:20:06.77,Default,,0,0,0,,Торманамен бірге Авангардқа...
Dialogue: 0,0:20:08.27,0:20:10.24,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:20:20.28,0:20:22.25,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:20:25.25,0:20:27.25,Default,,0,0,0,,Йоша~!
Dialogue: 0,0:20:27.25,0:20:29.29,Default,,0,0,0,,Менің жеңісім!
Dialogue: 0,0:20:29.29,0:20:32.26,Default,,0,0,0,,Угья~!
Dialogue: 0,0:20:32.26,0:20:35.30,Default,,0,0,0,,Аха...! Урара-чан➡
Dialogue: 0,0:20:35.30,0:20:38.27,Default,,0,0,0,,Бұл өте күшті болды!
Dialogue: 0,0:20:38.27,0:20:40.30,Default,,0,0,0,,Митанко!
Dialogue: 0,0:20:40.30,0:20:42.87,Default,,0,0,0,,Бұл өте қызықты болды.
Dialogue: 0,0:20:42.87,0:20:45.27,Default,,0,0,0,,Жекпе-жек... Сізге көп рахмет.
Dialogue: 0,0:20:45.27,0:20:47.24,Default,,0,0,0,,Ум!
Dialogue: 0,0:20:54.78,0:20:56.78,Default,,0,0,0,,Біз жақсы жекпе-жек өткіздік.
Dialogue: 0,0:20:56.78,0:20:58.75,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:20:58.75,0:21:01.76,Default,,0,0,0,,Эй...сәл уақыт болса➡
Dialogue: 0,0:21:01.76,0:21:03.79,Default,,0,0,0,,Сен де менімен төбелескің келе ме?
Dialogue: 0,0:21:03.79,0:21:07.29,Default,,0,0,0,,E? Менің екінші өзім ауырады.
Dialogue: 0,0:21:08.33,0:21:10.80,Default,,0,0,0,,Банхуа дивасын қолданып көріңіз.
Dialogue: 0,0:21:16.27,0:21:18.77,Default,,0,0,0,,Жол... дұрыс па?
Dialogue: 0,0:21:18.77,0:21:20.78,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:26.78,0:21:29.28,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:21:29.28,0:21:32.29,Default,,0,0,0,,Ғажайып төбе….
Dialogue: 0,0:21:32.29,0:21:35.26,Default,,0,0,0,,Қараңғы... Ол жерде ешкім жоқ...
Dialogue: 0,0:21:35.26,0:21:37.26,Default,,0,0,0,,Фуфуфуфу….
Dialogue: 0,0:21:37.26,0:21:39.26,Default,,0,0,0,,E?
Dialogue: 0,0:21:40.26,0:21:42.30,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:21:42.30,0:21:45.27,Default,,0,0,0,,Ым? Бұл қарадан да қараңғы қараңғы➡
Dialogue: 0,0:21:45.27,0:21:47.27,Default,,0,0,0,,Қараңғылық.
Dialogue: 0,0:21:50.77,0:21:52.77,Default,,0,0,0,,Уау….
Dialogue: 0,0:21:54.28,0:21:56.28,Default,,0,0,0,,Қош келдіңіз! ➡
Dialogue: 0,0:21:56.28,0:21:58.75,Default,,0,0,0,,Dream Plaza...Wonder Hill!
Dialogue: 0,0:22:00.25,0:22:06.25,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory