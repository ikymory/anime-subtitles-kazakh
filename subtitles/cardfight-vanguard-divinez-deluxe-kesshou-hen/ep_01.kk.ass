Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.27,0:00:06.30,Default,,0,0,0,,Авангардқа шабуыл жасаңыз.
Dialogue: 0,0:00:06.30,0:00:28.79,Default,,0,0,0,,♬～
Dialogue: 0,0:00:33.30,0:00:35.76,Default,,0,0,0,,Бұл керемет➡
Dialogue: 0,0:00:35.76,0:00:38.37,Default,,0,0,0,,Мен мұның соншалықты ұзаққа баратынын күткен жоқпын...
Dialogue: 0,0:00:38.37,0:00:42.30,Default,,0,0,0,,Сіз оған шынымен қол жеткізе алатын шығарсыз➡
Dialogue: 0,0:00:42.30,0:00:45.77,Default,,0,0,0,,Біз мақсат еткен соңғы шайқас!
Dialogue: 0,0:00:45.77,0:00:48.91,Default,,0,0,0,,Әлі көп жол бар.
Dialogue: 0,0:00:48.91,0:00:51.38,Default,,0,0,0,,Бұл ғажайып болуы керек еді.
Dialogue: 0,0:01:03.29,0:01:06.30,Default,,0,0,0,,Ол қызық күрескер.
Dialogue: 0,0:01:06.30,0:01:08.76,Default,,0,0,0,,Ол Кагецу Якумоны жеңді.
Dialogue: 0,0:01:10.30,0:01:12.27,Default,,0,0,0,,Ғажайып бала.
Dialogue: 0,0:02:47.30,0:02:50.77,Default,,0,0,0,,Мансап сауалнамасы формасын келесі аптаға дейін жіберіңіз➡
Dialogue: 0,0:02:50.77,0:02:53.24,Default,,0,0,0,,Әрқайсысы туралы мұқият ойланыңыз.
Dialogue: 0,0:02:55.80,0:02:57.84,Default,,0,0,0,,《(Акина Мейдо) Авангард кәсіпқойы болды...
Dialogue: 0,0:02:57.84,0:03:00.31,Default,,0,0,0,,Мен Нао-сенпаймен бір жерге барғым келеді. 》
Dialogue: 0,0:03:13.26,0:03:15.26,Default,,0,0,0,,A~Kina~! ➡
Dialogue: 0,0:03:15.26,0:03:17.26,Default,,0,0,0,,Осыдан кейін, қаңғыбас мысыққа барайық.
Dialogue: 0,0:03:17.26,0:03:19.26,Default,,0,0,0,,Нашар Менің бүгін толық емес жұмыс күнім бар.
Dialogue: 0,0:03:19.26,0:03:22.26,Default,,0,0,0,,Мен әдеттегідей жұмыс істеймін.
Dialogue: 0,0:03:22.26,0:03:25.77,Default,,0,0,0,,Бірақ бір аптадан кейін бұл қайтадан люкс, солай ма?
Dialogue: 0,0:03:25.77,0:03:28.24,Default,,0,0,0,,Хмм...білемін.
Dialogue: 0,0:03:30.37,0:03:32.77,Default,,0,0,0,,《(Сето Томари) Бұл лотерея бойынша соңғы турнир➡
Dialogue: 0,0:03:32.77,0:03:36.75,Default,,0,0,0,,Жауынгерлік комбинация да шешілді!
Dialogue: 0,0:03:40.75,0:03:43.39,Default,,0,0,0,,Оны асыға күтемін.
Dialogue: 0,0:03:43.39,0:03:45.89,Default,,0,0,0,,《(Якумо Кагецу) Мияко Рука…. 》
Dialogue: 0,0:03:45.89,0:03:48.36,Default,,0,0,0,,《Осы тағдырыма ризамын. 》
Dialogue: 0,0:03:54.40,0:03:56.90,Default,,0,0,0,,《(Айоджо Эрика) Суу Суу…. 》
Dialogue: 0,0:03:56.90,0:03:59.37,Default,,0,0,0,,《(Суоу жалғасы) Мейду Хикари…. 》
Dialogue: 0,0:04:06.27,0:04:08.24,Default,,0,0,0,,Хмм... жақсы.
Dialogue: 0,0:04:13.38,0:04:15.38,Default,,0,0,0,,《(Мегуми Окура) Келесі менің қарсыласым Акина-кун ба? 》
Dialogue: 0,0:04:16.38,0:04:19.89,Default,,0,0,0,,《Blackout көшбасшысы... сол Мегуми-санмен! 》
Dialogue: 0,0:04:20.76,0:04:23.79,Default,,0,0,0,,Мен осылай жасаудан шаршадым➡
Dialogue: 0,0:04:23.79,0:04:27.26,Default,,0,0,0,,Мен жекпе-жек ретін сәл өзгертемін! ➡
Dialogue: 0,0:04:27.26,0:04:29.30,Default,,0,0,0,,Қандай да бір себептермен финалдық турнир➡
Dialogue: 0,0:04:29.30,0:04:33.34,Default,,0,0,0,,Шайқас бір аптадан кейін басталады➡
Dialogue: 0,0:04:33.34,0:04:37.84,Default,,0,0,0,,Балалар, келіңдер, бізді көріңдер! 》
Dialogue: 0,0:04:44.41,0:04:46.92,Default,,0,0,0,,《Бұл бар болғаны бір апта. 》
Dialogue: 0,0:04:46.92,0:04:49.89,Default,,0,0,0,,《Мен не істеуім керек? 》
Dialogue: 0,0:04:51.25,0:04:53.32,Default,,0,0,0,,Дұрыс емес.
Dialogue: 0,0:04:53.32,0:04:56.26,Default,,0,0,0,,Кенеттен күшейіп кету үшін арнайы дайындық жоқ.
Dialogue: 0,0:04:56.26,0:04:58.29,Default,,0,0,0,,, солай ма?
Dialogue: 0,0:04:58.29,0:05:00.30,Default,,0,0,0,,Қарсыласыңызды көбірек зерттеңіз➡
Dialogue: 0,0:05:00.30,0:05:03.80,Default,,0,0,0,,Ықтимал жағдайларға қарсы шараларды қарастырыңыз...
Dialogue: 0,0:05:03.80,0:05:07.30,Default,,0,0,0,,Қарсыласыңыздың назарын аударып алмаңыз.
Dialogue: 0,0:05:07.30,0:05:10.27,Default,,0,0,0,,Басқа адамды білмес бұрын, алдымен өзіңізді жақсылап біліңіз.
Dialogue: 0,0:05:10.27,0:05:12.24,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:05:12.24,0:05:14.28,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:14.28,0:05:17.25,Default,,0,0,0,,Аки тез үйренеді, батылдығы бар.
Dialogue: 0,0:05:17.25,0:05:19.28,Default,,0,0,0,,Содан кейін мұқият дайындалыңыз➡
Dialogue: 0,0:05:19.28,0:05:23.25,Default,,0,0,0,,Соңында... жарайды, бәлкім, сәттілік.
Dialogue: 0,0:05:23.25,0:05:25.29,Default,,0,0,0,,Мен арнайы дайындық туралы білмеймін➡
Dialogue: 0,0:05:25.29,0:05:28.79,Default,,0,0,0,,Егер бұл кәдімгі жаттығу болса, мен сенімен бірге барамын. рақмет сізге!
Dialogue: 0,0:05:28.79,0:05:31.76,Default,,0,0,0,,Жақсы ұстазың бар бақытты адамсың.
Dialogue: 0,0:05:31.76,0:05:34.73,Default,,0,0,0,,Бұл... шынымен де рас.
Dialogue: 0,0:05:36.80,0:05:39.30,Default,,0,0,0,,Осы аптада мен сізге уақыт бөле аламын.
Dialogue: 0,0:05:39.30,0:05:43.27,Default,,0,0,0,,Біраз уақыттан кейін бір-бірімізді кездестіруге көп уақыт болмай қалады.
Dialogue: 0,0:05:44.74,0:05:48.28,Default,,0,0,0,,Е…м, кешіріңіз➡
Dialogue: 0,0:05:48.28,0:05:50.25,Default,,0,0,0,,оны басқаратын ұйымға қосылып, біртіндеп жоғары өрлеуің керек.
Dialogue: 0,0:05:50.25,0:05:52.28,Default,,0,0,0,,Әй... сен олай айтпадың ба?
Dialogue: 0,0:05:52.28,0:05:55.25,Default,,0,0,0,,Мен келесі айдың соңында толық емес жұмыс күнімнен шығамын.
Dialogue: 0,0:05:55.25,0:05:57.75,Default,,0,0,0,,Е! Сондай-ақ университет бар➡
Dialogue: 0,0:05:57.75,0:06:00.26,Default,,0,0,0,,Мен де кәсіби жағына назар аударғым келеді.
Dialogue: 0,0:06:00.26,0:06:03.76,Default,,0,0,0,,Сонымен...Менің ойымша, мен өзімнің шегіме жетемін деп ойлаймын.
Dialogue: 0,0:06:04.76,0:06:07.76,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:06:07.76,0:06:10.77,Default,,0,0,0,,Эй...ол бетіңді жасама➡
Dialogue: 0,0:06:10.77,0:06:13.80,Default,,0,0,0,,Бұл өмірмен қоштасу емес.
Dialogue: 0,0:06:13.80,0:06:16.27,Default,,0,0,0,,Ұстаз бен шәкірт арасындағы байланыс мәңгілік емес пе?
Dialogue: 0,0:06:17.27,0:06:19.27,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:19.27,0:06:21.81,Default,,0,0,0,,Бірақ мен ұстаз және шәкіртпін➡
Dialogue: 0,0:06:21.81,0:06:24.28,Default,,0,0,0,,Мен мұнымен аяқтағым келмейді!
Dialogue: 0,0:06:25.35,0:06:28.28,Default,,0,0,0,,Аки-кун кәсіби маман болуды мақсат етеді.
Dialogue: 0,0:06:28.28,0:06:32.25,Default,,0,0,0,,Ол кезде олар ұстаз бен шәкірт емес, бақталас болған.
Dialogue: 0,0:06:32.25,0:06:35.26,Default,,0,0,0,,Ол үшін ең алдымен Deluxe ұтып алыңыз!
Dialogue: 0,0:06:35.26,0:06:37.26,Default,,0,0,0,,Иә, дұрыс!
Dialogue: 0,0:06:37.26,0:06:40.26,Default,,0,0,0,,Мен міндетті түрде орындаймын, бұл менің уәдем!
Dialogue: 0,0:06:40.26,0:06:42.80,Default,,0,0,0,,Уәде~?
Dialogue: 0,0:06:42.80,0:06:46.27,Default,,0,0,0,,Егер бұл уәде болса, сіз оны ешқашан бұзбайсыз, солай ма?
Dialogue: 0,0:06:46.27,0:06:48.27,Default,,0,0,0,,Бұл….
Dialogue: 0,0:06:49.74,0:06:52.74,Default,,0,0,0,,Сіз мұны істейсіз бе? уәде.
Dialogue: 0,0:06:55.74,0:06:57.75,Default,,0,0,0,,Біз міндетті түрде жеңеміз!
Dialogue: 0,0:06:57.75,0:07:00.25,Default,,0,0,0,,Un Мен сенемін.
Dialogue: 0,0:07:05.39,0:07:08.39,Default,,0,0,0,,《Нао-сенпай... отставкаға кетеді. 》
Dialogue: 0,0:07:11.39,0:07:13.36,Default,,0,0,0,,《Мен білуім керек еді. 》
Dialogue: 0,0:07:14.83,0:07:18.83,Default,,0,0,0,,《Кәдімгі күнделікті өмір әдеттегідей жалғасады➡
Dialogue: 0,0:07:18.83,0:07:20.80,Default,,0,0,0,,Бұл дұрыс емес. 》
Dialogue: 0,0:07:23.77,0:07:26.74,Default,,0,0,0,,Мен уәде бердім...
Dialogue: 0,0:07:31.28,0:07:33.28,Default,,0,0,0,,А... Джинки-сан?
Dialogue: 0,0:07:33.28,0:07:35.75,Default,,0,0,0,,Сәлем Акина Мейдо.
Dialogue: 0,0:07:35.75,0:07:37.75,Default,,0,0,0,,Қандай таңғаларлық сәйкестік.
Dialogue: 0,0:07:37.75,0:07:39.75,Default,,0,0,0,,Бұл кездейсоқтық па?
Dialogue: 0,0:07:39.75,0:07:43.76,Default,,0,0,0,,Мұны ғажайып деп атауға болады. а….
Dialogue: 0,0:07:43.76,0:07:46.29,Default,,0,0,0,,Қарсы болмасаң, менімен барғың келе ме?
Dialogue: 0,0:07:46.29,0:07:50.80,Default,,0,0,0,,Күшті деген жерге қайтайын деп жатырмын.
Dialogue: 0,0:07:56.24,0:07:58.24,Default,,0,0,0,,Сіз... Кагецу мырзасыз ба?
Dialogue: 0,0:07:58.24,0:08:00.24,Default,,0,0,0,,Акина-кун!
Dialogue: 0,0:08:00.24,0:08:02.31,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:08:02.31,0:08:06.28,Default,,0,0,0,,Ол маған ең күшті адамдар болатын жерге жетелейтінімді айтты...
Dialogue: 0,0:08:06.28,0:08:08.35,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:08:08.35,0:08:10.89,Default,,0,0,0,,Мені де Джинки-сан шақырды...
Dialogue: 0,0:08:10.89,0:08:13.89,Default,,0,0,0,,Ең күшті деген сізді білдіреді, солай ма? Кагецу.
Dialogue: 0,0:08:14.79,0:08:16.76,Default,,0,0,0,,Мичиру Маварима….
Dialogue: 0,0:08:16.76,0:08:18.79,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:08:18.79,0:08:22.23,Default,,0,0,0,,Мичиру! Өйткені, сен ең мықтысың.
Dialogue: 0,0:08:22.23,0:08:24.27,Default,,0,0,0,,Хмм... сен емес пе?
Dialogue: 0,0:08:24.27,0:08:26.27,Default,,0,0,0,,Бұл сенсің!
Dialogue: 0,0:08:26.27,0:08:28.24,Default,,0,0,0,,E…Қайсысы?
Dialogue: 0,0:08:28.24,0:08:30.27,Default,,0,0,0,,Хмм...?
Dialogue: 0,0:08:30.27,0:08:32.24,Default,,0,0,0,,Хэхехе...
Dialogue: 0,0:08:33.27,0:08:35.84,Default,,0,0,0,,Мм... Мен ағамнан естідім➡
Dialogue: 0,0:08:35.84,0:08:37.81,Default,,0,0,0,,Кәсіби маман болғысы келеді.
Dialogue: 0,0:08:37.81,0:08:40.35,Default,,0,0,0,,Үйде барлығын айтамыз➡
Dialogue: 0,0:08:40.35,0:08:43.79,Default,,0,0,0,,Мен өзім болғым келетін нәрсені таптым➡
Dialogue: 0,0:08:43.79,0:08:47.26,Default,,0,0,0,,Мен әкеме де айту үшін үйге келгенше сергек болдым.
Dialogue: 0,0:08:47.26,0:08:49.29,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:49.29,0:08:53.26,Default,,0,0,0,,Сол үлкен аға өз арманын тапты➡
Dialogue: 0,0:08:53.26,0:08:56.77,Default,,0,0,0,,Мен өзім үшін бар күшімді салуды шештім.
Dialogue: 0,0:08:56.77,0:09:00.77,Default,,0,0,0,,Сонымен... соны айту үшін маған телефон содыңыз ба?
Dialogue: 0,0:09:00.77,0:09:05.27,Default,,0,0,0,,Әсіресе? Мен жай ғана бір нәрсе туралы сөйлескім келді.
Dialogue: 0,0:09:06.34,0:09:09.24,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:09:09.24,0:09:11.28,Default,,0,0,0,,Мен де кәсіби маман болуды жоспарлап отырмын➡
Dialogue: 0,0:09:11.28,0:09:15.75,Default,,0,0,0,,Бұл дүниеде өз күшіммен өмір сүру.
Dialogue: 0,0:09:15.75,0:09:18.75,Default,,0,0,0,,Түсіндім... менде солай болды.
Dialogue: 0,0:09:19.75,0:09:21.76,Default,,0,0,0,,Сондықтан Win Deluxe.
Dialogue: 0,0:09:21.76,0:09:25.23,Default,,0,0,0,,Ағаммен төбелесу керек болса да➡
Dialogue: 0,0:09:25.23,0:09:28.26,Default,,0,0,0,,Жеңіліс...! Жақсы емес пе?
Dialogue: 0,0:09:28.26,0:09:31.30,Default,,0,0,0,,Ал егер мен Deluxe➡-де жеңетін болсам
Dialogue: 0,0:09:31.30,0:09:35.27,Default,,0,0,0,,Бұл мен үшін ең ерекше нәрсе.
Dialogue: 0,0:09:35.27,0:09:37.24,Default,,0,0,0,,Хмм...дұрыс.
Dialogue: 0,0:09:38.31,0:09:42.28,Default,,0,0,0,,Мен ауруханада жатқанда, Куруми-сан жанымдағы бөлмеде➡
Dialogue: 0,0:09:42.28,0:09:45.28,Default,,0,0,0,,Мен 1-ші Deluxe трансляциясын қарап отырдым...
Dialogue: 0,0:09:46.25,0:09:48.75,Default,,0,0,0,,Финал...Сол жекпе-жекті қараңыз➡
Dialogue: 0,0:09:48.75,0:09:51.79,Default,,0,0,0,,Мен шын жүректен толқып кеттім➡
Dialogue: 0,0:09:51.79,0:09:55.29,Default,,0,0,0,,Авангардты қалай бастадық.
Dialogue: 0,0:09:56.76,0:09:58.73,Default,,0,0,0,,Ностальгиялық...
Dialogue: 0,0:09:58.73,0:10:00.76,Default,,0,0,0,,Енді мен көптен күткен сахнаға шықтым➡
Dialogue: 0,0:10:00.76,0:10:03.26,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:10:03.26,0:10:06.27,Default,,0,0,0,,Сәттілік ~ Мақсатыңыз қайда➡
Dialogue: 0,0:10:06.27,0:10:09.27,Default,,0,0,0,,Бұл мен үшін де ерекше.
Dialogue: 0,0:10:09.27,0:10:11.24,Default,,0,0,0,,Маған қалдырыңыз.
Dialogue: 0,0:10:13.27,0:10:15.78,Default,,0,0,0,,Мен уақытында үлгердім.
Dialogue: 0,0:10:15.78,0:10:18.75,Default,,0,0,0,,Мен көп нәрсені істеуге мәжбүр болдым.
Dialogue: 0,0:10:18.75,0:10:21.75,Default,,0,0,0,,Бір арман орындалды.
Dialogue: 0,0:10:21.75,0:10:24.72,Default,,0,0,0,,Менің...біздің арманымыз➡
Dialogue: 0,0:10:24.72,0:10:26.79,Default,,0,0,0,,Авангард күмбезі➡
Dialogue: 0,0:10:26.79,0:10:31.26,Default,,0,0,0,,Бұл 3-ші Deluxe финалдық турнирінің кезеңі!
Dialogue: 0,0:10:34.26,0:10:38.23,Default,,0,0,0,,Мен сізді ресми турнирде қайта көргеніме қуаныштымын.
Dialogue: 0,0:10:38.23,0:10:40.24,Default,,0,0,0,,Авангард, Менің ойымша, сіз жұмыстан кеткен жоқсыз.
Dialogue: 0,0:10:40.24,0:10:43.24,Default,,0,0,0,,Мен бас тарта алмадым.
Dialogue: 0,0:10:43.24,0:10:46.24,Default,,0,0,0,,Бірақ... мен тастамағаныма қуаныштымын.
Dialogue: 0,0:10:46.24,0:10:48.28,Default,,0,0,0,,Сен мықтысың.
Dialogue: 0,0:10:48.28,0:10:51.25,Default,,0,0,0,,Мен сені жеңе алмадым.
Dialogue: 0,0:10:51.25,0:10:53.25,Default,,0,0,0,,Сіз бұл туралы қашан айтасыз?
Dialogue: 0,0:10:53.25,0:10:56.28,Default,,0,0,0,,Мен жарты жолда тастап кеткен жарымжан адаммын.
Dialogue: 0,0:10:56.28,0:11:00.72,Default,,0,0,0,,Бірақ сіз биік белестерді көздедіңіз.
Dialogue: 0,0:11:00.72,0:11:03.26,Default,,0,0,0,,Аспан мен жердей айырмашылық бар.
Dialogue: 0,0:11:03.26,0:11:05.29,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:05.29,0:11:08.26,Default,,0,0,0,,Сенің жаның олай көрмейді.
Dialogue: 0,0:11:09.23,0:11:11.30,Default,,0,0,0,,Күресейік.
Dialogue: 0,0:11:11.30,0:11:14.74,Default,,0,0,0,,Бұл жағынан ешқандай айырмашылық жоқ.
Dialogue: 0,0:11:14.74,0:11:18.24,Default,,0,0,0,,Әй, бір күні. Хмм...?
Dialogue: 0,0:11:18.24,0:11:20.28,Default,,0,0,0,,Сізбен жекпе-жек алдында➡
Dialogue: 0,0:11:20.28,0:11:22.74,Default,,0,0,0,,Мен мұны өз ішімде шешуім керек➡
Dialogue: 0,0:11:22.74,0:11:24.71,Default,,0,0,0,,Ұрыс болып жатыр.
Dialogue: 0,0:11:32.75,0:11:35.76,Default,,0,0,0,,Бұл әлі қалды.
Dialogue: 0,0:11:35.76,0:11:38.23,Default,,0,0,0,,Бұл анық!
Dialogue: 0,0:11:38.23,0:11:40.26,Default,,0,0,0,,Ұзын қысқаша.
Dialogue: 0,0:11:40.26,0:11:42.23,Default,,0,0,0,,Томарин! Бұл Томалин➡
Dialogue: 0,0:11:42.23,0:11:44.23,Default,,0,0,0,,Мен сені сағындым!
Dialogue: 0,0:11:44.23,0:11:46.23,Default,,0,0,0,,Ой...! ➡
Dialogue: 0,0:11:46.23,0:11:48.24,Default,,0,0,0,,Жай ғана шығып, қалағаныңды істедің➡
Dialogue: 0,0:11:48.24,0:11:50.24,Default,,0,0,0,,Таң қалдыруға тырыспаңыз!
Dialogue: 0,0:11:50.24,0:11:52.27,Default,,0,0,0,,Уф... кеудем дірілдеп тұр.
Dialogue: 0,0:11:52.27,0:11:56.24,Default,,0,0,0,,Сен кеткеннен бері көп қиындық болды.
Dialogue: 0,0:11:56.24,0:11:58.75,Default,,0,0,0,,Дұрыс~ Сізге көп рахмет.
Dialogue: 0,0:11:58.75,0:12:02.22,Default,,0,0,0,,Томари-саманың арқасында Блэкаут бүгін жақсы жұмыс істеп жатыр!
Dialogue: 0,0:12:02.22,0:12:04.72,Default,,0,0,0,,Мен жақсымын.
Dialogue: 0,0:12:04.72,0:12:07.26,Default,,0,0,0,,Бірақ бұл өте жақсы команда.
Dialogue: 0,0:12:07.26,0:12:09.26,Default,,0,0,0,,Мүшелер біршама өзгерді➡
Dialogue: 0,0:12:09.26,0:12:12.76,Default,,0,0,0,,Ортадағы нәрсе сол кездегідей➡
Dialogue: 0,0:12:12.76,0:12:15.76,Default,,0,0,0,,Сіз жасаған Blackout туралы күткендей.
Dialogue: 0,0:12:15.76,0:12:19.77,Default,,0,0,0,,Оны мен емес, біз жасадық, солай ма?
Dialogue: 0,0:12:21.74,0:12:25.24,Default,,0,0,0,,Кешіріңіз~ Мен қыдырып жүргендіктен➡
Dialogue: 0,0:12:25.24,0:12:27.24,Default,,0,0,0,,Бұл жай ғана Томариге жүк.
Dialogue: 0,0:12:27.24,0:12:29.24,Default,,0,0,0,,Міне! ➡
Dialogue: 0,0:12:29.24,0:12:31.71,Default,,0,0,0,,Бірақ... бұл Лука➡ үшін жақсы
Dialogue: 0,0:12:31.71,0:12:34.22,Default,,0,0,0,,Әрқашан тек алдыңғы жағына қаратыңыз.
Dialogue: 0,0:12:34.22,0:12:37.22,Default,,0,0,0,,Міне, сондықтан сіз өте кереметсіз.
Dialogue: 0,0:12:37.22,0:12:40.26,Default,,0,0,0,,Томари керемет.
Dialogue: 0,0:12:40.26,0:12:42.22,Default,,0,0,0,,Томари қасымда, артымда➡
Dialogue: 0,0:12:42.22,0:12:44.26,Default,,0,0,0,,Ешкімді қалдырмаңыз.
Dialogue: 0,0:12:44.26,0:12:46.79,Default,,0,0,0,,Ол әрқашан қамқорлық жасайды.
Dialogue: 0,0:12:46.79,0:12:49.70,Default,,0,0,0,,Сондықтан Томаримен Blackout әрқашан ең жақсы!
Dialogue: 0,0:12:49.70,0:12:51.73,Default,,0,0,0,,Уф...! ➡
Dialogue: 0,0:12:51.73,0:12:54.20,Default,,0,0,0,,Уау, өте жасырын! Осындай бірдеңе айтсаң➡
Dialogue: 0,0:12:54.20,0:12:57.27,Default,,0,0,0,,Ештеңе айта алмайсың... Не деген сұмдық?!
Dialogue: 0,0:12:57.27,0:13:00.24,Default,,0,0,0,,Томари түннің қамқоршысы дедім➡
Dialogue: 0,0:13:00.24,0:13:02.24,Default,,0,0,0,,Қараңғылықтың қамқоршысы!
Dialogue: 0,0:13:02.24,0:13:04.25,Default,,0,0,0,,Ой...!
Dialogue: 0,0:13:05.78,0:13:09.25,Default,,0,0,0,,Бүгін кешке де жиналамыз деп ойлаймын. Мен оны асыға күтемін!
Dialogue: 0,0:13:10.79,0:13:13.22,Default,,0,0,0,,Финалда кездесеміз➡
Dialogue: 0,0:13:13.22,0:13:15.26,Default,,0,0,0,,Deluxe режимінде жекпе-жек.
Dialogue: 0,0:13:15.26,0:13:17.26,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:13:17.26,0:13:19.23,Default,,0,0,0,,Сіз мені осы үшін шақырдыңыз ба?
Dialogue: 0,0:13:19.23,0:13:22.23,Default,,0,0,0,,Мен сізбен біраз уақыттан кейін бірінші рет сөйлескім келеді деп ойладым.
Dialogue: 0,0:13:23.23,0:13:25.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:25.20,0:13:28.24,Default,,0,0,0,,Танысқаныма қуаныштымын. Сонда кездескенше.
Dialogue: 0,0:13:28.24,0:13:30.20,Default,,0,0,0,,Жақында кездескенше.
Dialogue: 0,0:13:31.24,0:13:33.24,Default,,0,0,0,,Мен кеттім.
Dialogue: 0,0:13:33.24,0:13:35.31,Default,,0,0,0,,А...ғажайып бала.
Dialogue: 0,0:13:35.31,0:13:37.31,Default,,0,0,0,,E…Мен бе?
Dialogue: 0,0:13:37.31,0:13:39.28,Default,,0,0,0,,- деді Тайзо.
Dialogue: 0,0:13:39.28,0:13:41.25,Default,,0,0,0,,Алдын ала өткен жекпе-жекті де көрдім.
Dialogue: 0,0:13:42.25,0:13:44.72,Default,,0,0,0,,Енді менімен төбелескіңіз келе ме?
Dialogue: 0,0:13:45.75,0:13:47.72,Default,,0,0,0,,Ех!
Dialogue: 0,0:13:48.72,0:13:50.76,Default,,0,0,0,,Благдомермен шабуыл.
Dialogue: 0,0:13:50.76,0:13:53.23,Default,,0,0,0,,Гёе~! ➡
Dialogue: 0,0:13:53.23,0:13:55.73,Default,,0,0,0,,Уау~ мен жеңіліп қалдым...
Dialogue: 0,0:13:55.73,0:13:57.73,Default,,0,0,0,,Менің жағдайым жақсы, Суо.
Dialogue: 0,0:13:57.73,0:13:59.73,Default,,0,0,0,,Бұл жақсы жекпе-жек болды.
Dialogue: 0,0:13:59.73,0:14:01.74,Default,,0,0,0,,Бұл жақсы жекпе-жек болды.
Dialogue: 0,0:14:01.74,0:14:04.74,Default,,0,0,0,,Сузунэ-чан мұнда тұрмайды➡
Dialogue: 0,0:14:04.74,0:14:06.71,Default,,0,0,0,,Сен неге Кагадасың?
Dialogue: 0,0:14:06.71,0:14:08.74,Default,,0,0,0,,Финалдық турнирге қатысу ниетімен➡
Dialogue: 0,0:14:08.74,0:14:11.25,Default,,0,0,0,,Мен жоспар құрып қойғанмын...
Dialogue: 0,0:14:11.25,0:14:14.72,Default,,0,0,0,,Оның үстіне... біз доспыз.
Dialogue: 0,0:14:14.72,0:14:17.25,Default,,0,0,0,,Мен де... Мен де доспын ба?
Dialogue: 0,0:14:17.25,0:14:20.22,Default,,0,0,0,,Балалар сендер көңіл көтеріп жатқан сияқтысыңдар.
Dialogue: 0,0:14:20.22,0:14:23.76,Default,,0,0,0,,Бұл сіз тапсырыс берген миллион пудинг!
Dialogue: 0,0:14:23.76,0:14:27.76,Default,,0,0,0,,Рахмет. Акина сонда ма?
Dialogue: 0,0:14:27.76,0:14:31.77,Default,,0,0,0,,Болды... Дүкен меңгерушісі де Deluxe➡-ге қарап тұрған сияқты
Dialogue: 0,0:14:31.77,0:14:34.74,Default,,0,0,0,,Бұл толық емес жұмыс уақыты емес! ➡
Dialogue: 0,0:14:34.74,0:14:36.74,Default,,0,0,0,,Аки-кун, мен сені ерте тұруға мәжбүр еттім.
Dialogue: 0,0:14:36.74,0:14:39.27,Default,,0,0,0,,Сүйіктісің, Ақина.
Dialogue: 0,0:14:39.27,0:14:43.24,Default,,0,0,0,,Мен де секіріп кеткім келді.
Dialogue: 0,0:14:43.24,0:14:45.71,Default,,0,0,0,,Жақсы пудинг. Хмм...
Dialogue: 0,0:14:45.71,0:14:48.22,Default,,0,0,0,,Тамақ ішер алдында ішетін барға барайық!
Dialogue: 0,0:14:48.22,0:14:50.22,Default,,0,0,0,,Мен сенімен бірге боламын.
Dialogue: 0,0:14:51.25,0:14:53.22,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:14:55.39,0:14:58.23,Default,,0,0,0,,Су Кунның жаттығуы Біз бірге шығамыз, солай емес пе?
Dialogue: 0,0:14:58.23,0:15:01.23,Default,,0,0,0,,Иә, мен сенің жеңісіңді қалаймын.
Dialogue: 0,0:15:01.23,0:15:04.77,Default,,0,0,0,,Мен бұл сезімді түсінемін.
Dialogue: 0,0:15:04.77,0:15:07.27,Default,,0,0,0,,Бұл ең жақсы ерекше сусынды кім жасай алатынын байқау!
Dialogue: 0,0:15:07.27,0:15:09.74,Default,,0,0,0,,Қабылдау және тұру. Жер бетіндегі ең жақсы➡
Dialogue: 0,0:15:09.74,0:15:11.77,Default,,0,0,0,,Мен саған сусын дайындаймын.
Dialogue: 0,0:15:11.77,0:15:15.74,Default,,0,0,0,,Ей, балалар, егер мұны істегіңіз келсе, бәрін ішіңіз!
Dialogue: 0,0:15:27.26,0:15:30.73,Default,,0,0,0,,Үздіксіз Суоу….
Dialogue: 0,0:15:30.73,0:15:32.73,Default,,0,0,0,,Мен өмір бойы жек көретін жігітті...
Dialogue: 0,0:15:33.76,0:15:36.26,Default,,0,0,0,,Маварима мырзамен шайқас...
Dialogue: 0,0:15:36.26,0:15:39.23,Default,,0,0,0,,Әрине... Бір минут күте тұрыңыз!
Dialogue: 0,0:15:39.23,0:15:43.24,Default,,0,0,0,,Сіз көңіл көтеруіңізді Deluxe үшін сақтайсыз деп үміттенемін.
Dialogue: 0,0:15:43.24,0:15:45.77,Default,,0,0,0,,Жауынгерлер арасындағы химиялық реакция➡
Dialogue: 0,0:15:45.77,0:15:50.24,Default,,0,0,0,,Мен бұл сәттің дәл Deluxe-де болғанын қалаймын.
Dialogue: 0,0:15:50.24,0:15:53.21,Default,,0,0,0,,Акина-кун, сенің мақсатың жеңу, солай ма?
Dialogue: 0,0:15:53.21,0:15:55.22,Default,,0,0,0,,Әрине!
Dialogue: 0,0:15:55.22,0:15:57.25,Default,,0,0,0,,Иә….
Dialogue: 0,0:15:57.25,0:16:01.26,Default,,0,0,0,,Яғни... сен де мені жеңдің.
Dialogue: 0,0:16:02.22,0:16:04.73,Default,,0,0,0,,Маған кереметіңді көрсет.
Dialogue: 0,0:16:06.23,0:16:09.26,Default,,0,0,0,,Мен Акина Мейдомын!
Dialogue: 0,0:16:09.26,0:16:12.27,Default,,0,0,0,,Хмм...? Мичиру Маварима ➡
Dialogue: 0,0:16:12.27,0:16:15.27,Default,,0,0,0,,Мен сені жеңемін және жеңемін!
Dialogue: 0,0:16:18.21,0:16:20.24,Default,,0,0,0,,Мм...люксте кездескенше➡
Dialogue: 0,0:16:20.24,0:16:22.21,Default,,0,0,0,,Акина Акина.
Dialogue: 0,0:16:23.24,0:16:25.21,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:29.82,0:16:33.82,Default,,0,0,0,,《Маварима-сан Кагецу-сан Мегуми-сан➡
Dialogue: 0,0:16:33.82,0:16:38.33,Default,,0,0,0,,Финалдық турнир Тек керемет күшті жауынгерлер. 》
Dialogue: 0,0:16:39.29,0:16:41.30,Default,,0,0,0,,《Жеңіске жету үшін соңына жету➡
Dialogue: 0,0:16:41.30,0:16:44.37,Default,,0,0,0,,Біз аман қалуымыз керек. 》
Dialogue: 0,0:16:44.37,0:16:47.84,Default,,0,0,0,,《Жеңіс деген осы... 》
Dialogue: 0,0:16:49.24,0:16:52.77,Default,,0,0,0,,Хмм...сен мықтысың.
Dialogue: 0,0:16:52.77,0:16:56.28,Default,,0,0,0,,Түрі осылай болса да, бұрынғы басшы.
Dialogue: 0,0:16:56.28,0:16:59.75,Default,,0,0,0,,Мен сізді өте бұзық деп естідім, солай ма?
Dialogue: 0,0:16:59.75,0:17:02.75,Default,,0,0,0,,Уф...жауап ретінде айтар сөзім жоқ.
Dialogue: 0,0:17:02.75,0:17:05.72,Default,,0,0,0,,Бірақ бәрі мені кешірді, солай ма?
Dialogue: 0,0:17:07.26,0:17:09.72,Default,,0,0,0,,Бұл жақсы команда, Блэкаут.
Dialogue: 0,0:17:09.72,0:17:11.76,Default,,0,0,0,,Жоғары Өте көп.
Dialogue: 0,0:17:11.76,0:17:15.23,Default,,0,0,0,,Олай болса, бір-бірімізбен төбелесіп, көңіл көтерейік!
Dialogue: 0,0:17:15.23,0:17:17.20,Default,,0,0,0,,Бұл келе жатыр!
Dialogue: 0,0:17:18.20,0:17:20.77,Default,,0,0,0,,Хмф...
Dialogue: 0,0:17:20.77,0:17:22.74,Default,,0,0,0,,Құрметті Милэй, көңіл-күйіңіз жақсы.
Dialogue: 0,0:17:22.74,0:17:25.27,Default,,0,0,0,,Жақсы нәрсе болды ма?
Dialogue: 0,0:17:25.27,0:17:29.74,Default,,0,0,0,,Эхехе...Мен өзім үшін маңызды адаммен біраз уақыттан кейін бірінші рет кездесіп тұрмын.
Dialogue: 0,0:17:29.74,0:17:31.75,Default,,0,0,0,,Сіз доссыз ба?
Dialogue: 0,0:17:31.75,0:17:34.22,Default,,0,0,0,,Хмм... сен мені өзгерттің ➡
Dialogue: 0,0:17:34.22,0:17:36.72,Default,,0,0,0,,Өте маңызды дос!
Dialogue: 0,0:17:38.32,0:17:40.25,Default,,0,0,0,,Иә➡
Dialogue: 0,0:17:40.25,0:17:42.22,Default,,0,0,0,,Мен күтемін.
Dialogue: 0,0:17:44.23,0:17:46.23,Default,,0,0,0,,Жеңімпаз➡
Dialogue: 0,0:17:46.23,0:17:48.73,Default,,0,0,0,,Лука Мияко!
Dialogue: 0,0:17:48.73,0:17:51.23,Default,,0,0,0,,Өте қызық болды, рахмет! ➡
Dialogue: 0,0:17:51.23,0:17:54.74,Default,,0,0,0,,Бастион екеуің жарқырап тұрдыңдар.
Dialogue: 0,0:17:54.74,0:17:57.24,Default,,0,0,0,,Бұл қызық болды!
Dialogue: 0,0:17:59.37,0:18:02.24,Default,,0,0,0,,Лука мырза шет елде не істеді?
Dialogue: 0,0:18:02.24,0:18:05.25,Default,,0,0,0,,Саяхатта әр түрлі адамдармен төбелестім.
Dialogue: 0,0:18:05.25,0:18:07.25,Default,,0,0,0,,Жауынгерлік жаттығулардың саяхаты!
Dialogue: 0,0:18:07.25,0:18:09.22,Default,,0,0,0,,Жоқ...! ➡
Dialogue: 0,0:18:09.22,0:18:11.25,Default,,0,0,0,,Мен үшін Авангард – ➡
Dialogue: 0,0:18:11.25,0:18:14.76,Default,,0,0,0,,Біреумен байланысуға мүмкіндік беретін сиқырлы зат!
Dialogue: 0,0:18:14.76,0:18:16.76,Default,,0,0,0,,Cardfight арқылы➡
Dialogue: 0,0:18:16.76,0:18:19.29,Default,,0,0,0,,Менің арманым – дүние жүзіндегі адамдармен байланысу.
Dialogue: 0,0:18:19.29,0:18:22.26,Default,,0,0,0,,Төбелесте... Блэкаутпен бірдей!
Dialogue: 0,0:18:23.30,0:18:25.73,Default,,0,0,0,,Мен тек әңгімені естідім➡
Dialogue: 0,0:18:25.73,0:18:29.24,Default,,0,0,0,,Лука-сан Не айтайын... сен біртүрлі адамсың.
Dialogue: 0,0:18:29.24,0:18:32.24,Default,,0,0,0,,Сол бала, мен білмей тұрып, ➡
Dialogue: 0,0:18:32.24,0:18:34.74,Default,,0,0,0,,Адамдар шеңберінің ортасында тұратын тип.
Dialogue: 0,0:18:34.74,0:18:38.25,Default,,0,0,0,,Менің ойымша, сіз оны табиғи адам деп атай аласыз.
Dialogue: 0,0:18:38.25,0:18:41.25,Default,,0,0,0,,Мен олай бола алмаймын.
Dialogue: 0,0:18:42.75,0:18:46.22,Default,,0,0,0,,Мег-чан туралы бір жаман сөз айтайын ба?
Dialogue: 0,0:18:46.22,0:18:48.26,Default,,0,0,0,,Е...?
Dialogue: 0,0:18:48.26,0:18:51.73,Default,,0,0,0,,Егер сіздің өзін-өзі бағалауыңыз мәңгілік төмен болса.
Dialogue: 0,0:18:51.73,0:18:54.73,Default,,0,0,0,,Мег-чанға барлығы сенеді.
Dialogue: 0,0:18:54.73,0:18:58.77,Default,,0,0,0,,Өзіңізге сенімді болатын кез келді емес пе?
Dialogue: 0,0:18:58.77,0:19:02.74,Default,,0,0,0,,Мен...бәлкім, өзімді бір жағынан төмен сезінген шығармын➡
Dialogue: 0,0:19:02.74,0:19:05.74,Default,,0,0,0,,Аники, Туя және Юю➡ сияқты
Dialogue: 0,0:19:05.74,0:19:08.74,Default,,0,0,0,,Менде ерекше ештеңе жоқ➡
Dialogue: 0,0:19:08.74,0:19:12.75,Default,,0,0,0,,Менің ойымша, ол жай ғана құрметті студент.
Dialogue: 0,0:19:12.75,0:19:14.72,Default,,0,0,0,,Бірақ... қазір басқаша.
Dialogue: 0,0:19:14.72,0:19:16.72,Default,,0,0,0,,Мен күштімін!
Dialogue: 0,0:19:16.72,0:19:19.72,Default,,0,0,0,,Жоқ, сіз түсінбейсіз.
Dialogue: 0,0:19:21.76,0:19:23.76,Default,,0,0,0,,Цуйоши Наорё….
Dialogue: 0,0:19:24.76,0:19:29.23,Default,,0,0,0,,Саяхаттау? Мақсат басқа, бірақ менімен бірдей.
Dialogue: 0,0:19:29.23,0:19:32.23,Default,,0,0,0,,Хахахаха...Blackout's Charanporan дуэті.
Dialogue: 0,0:19:32.23,0:19:34.24,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:19:34.24,0:19:36.27,Default,,0,0,0,,Ойланып қарашы, Туя да➡
Dialogue: 0,0:19:36.27,0:19:39.24,Default,,0,0,0,,Демек, сіз бұл жолы Deluxe-ге қатыспайсыз.
Dialogue: 0,0:19:39.24,0:19:41.24,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:19:44.31,0:19:47.21,Default,,0,0,0,,《(Серіктес) Антарктидаға келгенде карта төбелесу керек пе?
Dialogue: 0,0:19:47.21,0:19:50.22,Default,,0,0,0,,Сәлем! Өйткені мен күрескермін.
Dialogue: 0,0:19:51.72,0:19:54.79,Default,,0,0,0,,О... ақыры қуат қосылды.
Dialogue: 0,0:19:54.79,0:19:56.79,Default,,0,0,0,,📱 Иә?
Dialogue: 0,0:19:58.23,0:20:01.76,Default,,0,0,0,,3-ші люкс?
Dialogue: 0,0:20:01.76,0:20:04.30,Default,,0,0,0,,Бұл уақыт әлдеқашан ба?
Dialogue: 0,0:20:04.30,0:20:06.27,Default,,0,0,0,,》
Dialogue: 0,0:20:08.77,0:20:12.24,Default,,0,0,0,,...Ал мен оны түсінген кезде турнир басталып та үлгерді.
Dialogue: 0,0:20:12.24,0:20:14.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:14.24,0:20:16.24,Default,,0,0,0,,Түсіндім, байқаусызда осындай жағдайлар болады.
Dialogue: 0,0:20:16.24,0:20:18.25,Default,,0,0,0,,Жоқ, эй!
Dialogue: 0,0:20:18.25,0:20:20.21,Default,,0,0,0,,Себебі менде ұялы телефон жоқ.
Dialogue: 0,0:20:20.21,0:20:22.18,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:20:23.72,0:20:26.22,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:20:26.22,0:20:28.76,Default,,0,0,0,,Қош келдіңіз, аға. мм.
Dialogue: 0,0:20:28.76,0:20:31.76,Default,,0,0,0,,Бүгін мен тағы бір мені кездестірдім. Хмм...
Dialogue: 0,0:20:31.76,0:20:33.83,Default,,0,0,0,,А?
Dialogue: 0,0:20:33.83,0:20:35.76,Default,,0,0,0,,Не? Сол реакция.
Dialogue: 0,0:20:35.76,0:20:39.23,Default,,0,0,0,,А... жоқ, менде бәріміз соншалықты тату болғандай әсер болмады.
Dialogue: 0,0:20:39.23,0:20:42.20,Default,,0,0,0,,Бұл рас...
Dialogue: 0,0:20:43.24,0:20:46.24,Default,,0,0,0,,Сонымен маған сол адамнан хабарлама келді➡
Dialogue: 0,0:20:46.24,0:20:48.24,Default,,0,0,0,,Мен жеңдім➡
Dialogue: 0,0:20:48.24,0:20:51.81,Default,,0,0,0,,Себебі мен бірінші профессионал боламын...!
Dialogue: 0,0:20:51.81,0:20:54.72,Default,,0,0,0,,Маған айтпа ~ Менмін ➡
Dialogue: 0,0:20:54.72,0:20:56.72,Default,,0,0,0,,Мен жеңіске жетуді жоспарлап отырмын!
Dialogue: 0,0:20:57.72,0:21:21.88,Default,,0,0,0,,♬～
Dialogue: 0,0:21:21.88,0:21:25.35,Default,,0,0,0,,《Ал апта көзді ашып жұмғанша өте шықты. 》
Dialogue: 0,0:21:26.25,0:21:28.72,Default,,0,0,0,,Ертең осында...!
Dialogue: 0,0:21:30.82,0:21:34.76,Default,,0,0,0,,《(Масанори Исэки) Уау~ Мен оны таба алмай қиналдым➡
Dialogue: 0,0:21:34.76,0:21:38.76,Default,,0,0,0,,Блэкуттың көшбасшысы болу үшін сізге құмарлық болуы керек пе?
Dialogue: 0,0:21:38.76,0:21:40.73,Default,,0,0,0,,Қараңғылық Сіз білесіз бе?
Dialogue: 0,0:21:40.73,0:21:42.76,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:21:42.76,0:21:44.73,Default,,0,0,0,,Бірақ мені ол команда жек көреді.
Dialogue: 0,0:21:46.73,0:21:50.24,Default,,0,0,0,,Түсіндім~ Сіз жамандықты жоспарлайтын адамсыз, солай емес пе?
Dialogue: 0,0:21:50.24,0:21:52.74,Default,,0,0,0,,Түсіндің бе? Қорқынышты!
Dialogue: 0,0:21:52.74,0:21:55.24,Default,,0,0,0,,Deluxe.
Dialogue: 0,0:21:55.24,0:21:58.71,Default,,0,0,0,,Хмм…. Арара... қызықпайсың ба? ➡
Dialogue: 0,0:21:58.71,0:22:01.28,Default,,0,0,0,,Бұл ең мықтылар жиналатын турнир.
Dialogue: 0,0:22:01.28,0:22:05.72,Default,,0,0,0,,Шынымды айтсам, күшті ме, жоқ па бәрібір.
Dialogue: 0,0:22:05.72,0:22:07.72,Default,,0,0,0,,Бірақ...қызықты жауынгерлер➡
Dialogue: 0,0:22:07.72,0:22:09.72,Default,,0,0,0,,Адамдар көп болатын сияқты.
Dialogue: 0,0:22:09.72,0:22:12.33,Default,,0,0,0,,Ондай жағдайда мен кепілдік беремін.
Dialogue: 0,0:22:12.33,0:22:14.30,Default,,0,0,0,,Иә! 》
Dialogue: 0,0:22:16.23,0:22:19.23,Default,,0,0,0,,Мен қандай шайқас жасай аламын?
Dialogue: 0,0:22:22.74,0:22:24.74,Default,,0,0,0,,А, мен білемін➡
Dialogue: 0,0:22:24.74,0:22:27.24,Default,,0,0,0,,Мен мұны да назардан тыс қалдырмаймын.
Dialogue: 0,0:22:27.24,0:22:29.21,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:22:30.78,0:22:34.25,Default,,0,0,0,,Әзірше осыған тоқталайық.
Dialogue: 0,0:22:37.72,0:22:41.22,Default,,0,0,0,,Мичиру Ішке кіру уақыты келді.
Dialogue: 0,0:22:41.22,0:22:43.72,Default,,0,0,0,,Акина Мейдо….
Dialogue: 0,0:22:43.72,0:22:46.73,Default,,0,0,0,,Кагецу Якумоны жеңген ол, солай ма?
Dialogue: 0,0:22:46.73,0:22:49.73,Default,,0,0,0,,Хмм... бұл өте қызық.
Dialogue: 0,0:22:50.80,0:22:52.80,Default,,0,0,0,,《Мичиру Маварима➡
Dialogue: 0,0:22:52.80,0:22:55.30,Default,,0,0,0,,Мен сені жеңемін және жеңемін! 》
Dialogue: 0,0:22:58.74,0:23:02.24,Default,,0,0,0,,Оның жан дүниесі тамсанды...
Dialogue: 0,0:23:15.76,0:23:19.23,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:23:19.23,0:23:21.73,Default,,0,0,0,,Юйю-сан! ➡
Dialogue: 0,0:23:21.73,0:23:24.23,Default,,0,0,0,,Осы жолмен! Кеттік, Юю!
Dialogue: 0,0:23:25.20,0:23:27.20,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:23:28.24,0:23:30.74,Default,,0,0,0,,Сәлем, балалар! ➡
Dialogue: 0,0:23:30.74,0:23:32.74,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз➡
Dialogue: 0,0:23:32.74,0:23:36.24,Default,,0,0,0,,Ақтық турнир басталды!
Dialogue: 0,0:23:36.24,0:23:38.21,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:23:38.21,0:23:40.25,Default,,0,0,0,,Осы шайқастың нәтижесін көргенше➡
Dialogue: 0,0:23:40.25,0:23:43.22,Default,,0,0,0,,Өлулерің керек!
Dialogue: 0,0:23:43.22,0:23:52.86,Default,,0,0,0,,♬～
Dialogue: 0,0:23:52.86,0:23:55.86,Default,,0,0,0,,《Міндетті түрде...жеңіңіз. 》
Dialogue: 0,0:23:55.86,0:23:58.33,Default,,0,0,0,,《Соңында... ол басталады! 》
Dialogue: 0,0:23:59.83,0:24:05.83,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory