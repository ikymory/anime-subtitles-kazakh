Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.48,0:00:26.76,Default,,0,0,0,,Эй, сен мұнда неге ашуланып тұрсың?
Dialogue: 0,0:00:28.16,0:00:32.16,Default,,0,0,0,,Айтпақшы, сіз адам құрылғыларын дұрыс пайдалануды үйрендіңіз.
Dialogue: 0,0:00:32.16,0:00:34.16,Default,,0,0,0,,Жасайық! Tsk!
Dialogue: 0,0:00:34.16,0:00:36.63,Default,,0,0,0,,Енді сіз де Grease пайдалана аласыз!
Dialogue: 0,0:00:37.67,0:00:40.17,Default,,0,0,0,,Май зақымдалған.
Dialogue: 0,0:00:40.17,0:00:42.50,Default,,0,0,0,,Сіздің бетіңіз қандай?
Dialogue: 0,0:00:42.50,0:00:46.17,Default,,0,0,0,,Жоғарыда маған көмектескен адамға көмектесе алмадым.
Dialogue: 0,0:00:46.17,0:00:48.18,Default,,0,0,0,,Мұнда да.
Dialogue: 0,0:00:48.18,0:00:50.85,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:00:50.85,0:00:53.18,Default,,0,0,0,,Бір нәрсе өзгерді
Dialogue: 0,0:00:53.18,0:00:57.85,Default,,0,0,0,,Сіз ілгерілеушілікке жеттім деп ойласаңыз да, бұл қайта-қайта бірдей нәрсе.
Dialogue: 0,0:00:57.85,0:01:01.32,Default,,0,0,0,,Мен ешқашан осылай өзгермеймін бе?
Dialogue: 0,0:01:02.29,0:01:04.26,Default,,0,0,0,,Қап!
Dialogue: 0,0:01:05.29,0:01:08.30,Default,,0,0,0,,Грис дайындалды.
Dialogue: 0,0:01:08.30,0:01:12.13,Default,,0,0,0,,Достарым үшін өмірімді қатерге тігемін.
Dialogue: 0,0:01:12.13,0:01:15.47,Default,,0,0,0,,Бұл сені қорғаған аспан жаратылысы болғандықтан емес.
Dialogue: 0,0:01:15.47,0:01:20.31,Default,,0,0,0,,Өйткені мен заттар мен адамдарға дос ретінде қамқорлық жасай алатынымды түсіндім.
Dialogue: 0,0:01:20.31,0:01:24.65,Default,,0,0,0,,Әзірше ішке кіріп Гриске жүзіңді көрсетейік.
Dialogue: 0,0:01:24.65,0:01:27.12,Default,,0,0,0,,(Адам ізі басылады)
Dialogue: 0,0:01:33.72,0:01:35.72,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:01:35.72,0:01:39.16,Default,,0,0,0,,Құдіретіңді оятуыңмен құттықтаймын, Людо➡
Dialogue: 0,0:01:39.16,0:01:41.16,Default,,0,0,0,,Сіздің жақсы көрінгеніңізге қуаныштымын.
Dialogue: 0,0:01:41.16,0:01:44.13,Default,,0,0,0,,Ах... иә...
Dialogue: 0,0:01:45.23,0:01:47.50,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:01:47.50,0:01:49.84,Default,,0,0,0,,Тірі...
Dialogue: 0,0:01:49.84,0:01:51.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:51.91,0:01:56.91,Default,,0,0,0,,Хехе... Түсіндім, мен Грейз өлді деп ойладым.
Dialogue: 0,0:01:56.91,0:01:59.18,Default,,0,0,0,,Сіз соншалықты депрессиясыз ба? Жарайды, жарайды.
Dialogue: 0,0:01:59.18,0:02:01.95,Default,,0,0,0,,Дұрыс, дұрыс, хмм, хехехе
Dialogue: 0,0:02:01.95,0:02:05.29,Default,,0,0,0,,Өлтірме мені, мен әлі қадалып жатырмын.
Dialogue: 0,0:02:05.29,0:02:07.29,Default,,0,0,0,,Бұл түсініксіз!
Dialogue: 0,0:02:07.29,0:02:10.63,Default,,0,0,0,,Егер менде осыншама тәртіпсіздік болса, мен өлген болар едім деп ойлайсың!
Dialogue: 0,0:02:10.63,0:02:12.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:12.63,0:02:15.30,Default,,0,0,0,,Мұның бәрі тазалаушының медициналық тобының арқасында➡
Dialogue: 0,0:02:15.30,0:02:18.30,Default,,0,0,0,,Солардың ішінде осы жолы белсенді рөл атқарған –➡
Dialogue: 0,0:02:18.30,0:02:20.64,Default,,0,0,0,,Бұл бала...
Dialogue: 0,0:02:20.64,0:02:22.97,Default,,0,0,0,,Бұл бала Азия Стилза➡
Dialogue: 0,0:02:22.97,0:02:25.44,Default,,0,0,0,,Тазалаушының жалғыз емшісі
Dialogue: 0,0:02:26.81,0:02:29.31,Default,,0,0,0,,Бұл жолы кездейсоқ
Dialogue: 0,0:02:29.31,0:02:32.15,Default,,0,0,0,,Бұл жай ғана пайдалы болды.
Dialogue: 0,0:02:32.15,0:02:34.12,Default,,0,0,0,,Мен...
Dialogue: 0,0:02:35.15,0:02:38.22,Default,,0,0,0,,Азия өте ұялшақ.
Dialogue: 0,0:02:38.22,0:02:42.22,Default,,0,0,0,,Азия Ха! Уф
Dialogue: 0,0:02:42.22,0:02:45.49,Default,,0,0,0,,Сен мені өлімнен құтқардың.
Dialogue: 0,0:02:45.49,0:02:48.16,Default,,0,0,0,,А... көп рахмет
Dialogue: 0,0:02:48.16,0:02:51.17,Default,,0,0,0,,Хмм, сонымен бірге орындаңыз.
Dialogue: 0,0:02:51.17,0:02:53.67,Default,,0,0,0,,Жарайды, ренжімеңіз.
Dialogue: 0,0:02:53.67,0:02:55.67,Default,,0,0,0,,Өйткені сен менің жанымда болдың
Dialogue: 0,0:02:55.67,0:02:59.17,Default,,0,0,0,,Мен сол тролльдердің шабуылына ілінбедім.
Dialogue: 0,0:02:59.17,0:03:01.11,Default,,0,0,0,,Бірақ
Dialogue: 0,0:03:01.11,0:03:03.61,Default,,0,0,0,,Асықсаң да беруші бола алмайсың...
Dialogue: 0,0:03:03.61,0:03:05.68,Default,,0,0,0,,Сіз өз қарқыныңызбен жүре аласыз.
Dialogue: 0,0:03:06.68,0:03:08.68,Default,,0,0,0,,Аники~ Уф!
Dialogue: 0,0:03:08.68,0:03:10.69,Default,,0,0,0,,( дауыстап жылау)
Dialogue: 0,0:03:10.69,0:03:14.12,Default,,0,0,0,,Ал Людо, сен өте жақсы орындадың.
Dialogue: 0,0:03:14.12,0:03:18.19,Default,,0,0,0,,Мен Занкамен бірге осындай мықты жігітті бұрышқа түсіру үшін жұмыс істедім.
Dialogue: 0,0:03:18.19,0:03:20.20,Default,,0,0,0,,Бұл керемет➡
Dialogue: 0,0:03:20.20,0:03:22.96,Default,,0,0,0,,Тұмар туралы қатты уайымдамаңыз➡
Dialogue: 0,0:03:22.96,0:03:27.30,Default,,0,0,0,,Маңызды нәрсе біреуге пайдалы болса, мен үшін жақсы➡
Dialogue: 0,0:03:27.30,0:03:30.14,Default,,0,0,0,,Мен заттарды осылай бағалаймын.
Dialogue: 0,0:03:30.14,0:03:32.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:36.48,0:03:39.55,Default,,0,0,0,,Ә, қысқа үзіліс жасайық па?
Dialogue: 0,0:03:39.55,0:03:44.15,Default,,0,0,0,,Майлау Мен тірі болғаныма өте қуаныштымын.
Dialogue: 0,0:03:44.15,0:03:46.15,Default,,0,0,0,,Деда
Dialogue: 0,0:03:46.15,0:03:50.16,Default,,0,0,0,,Бандалдар тазалаушылармен қатты ұрысты.
Dialogue: 0,0:03:50.16,0:03:52.16,Default,,0,0,0,,Болашақта не болады?
Dialogue: 0,0:03:52.16,0:03:55.66,Default,,0,0,0,,Сізге тек ала аңдармен ғана емес, бұзақылармен де күресуге тура келеді.
Dialogue: 0,0:03:55.66,0:03:59.73,Default,,0,0,0,,Және де жаңа ақпарат бар.
Dialogue: 0,0:03:59.73,0:04:02.44,Default,,0,0,0,,⚟Вандал айтқан шекара➡
Dialogue: 0,0:04:02.44,0:04:07.28,Default,,0,0,0,,Олар да аспан туралы бірдеңе зерттеп жатқан сияқты.
Dialogue: 0,0:04:07.28,0:04:09.61,Default,,0,0,0,,А... кім?
Dialogue: 0,0:04:09.61,0:04:11.95,Default,,0,0,0,,Босс Иә!
Dialogue: 0,0:04:11.95,0:04:15.62,Default,,0,0,0,,<Бастық! ? Бастық дедіңіз бе? ＞
Dialogue: 0,0:04:19.69,0:04:22.62,Default,,0,0,0,,<Тазалық бастық? ＞
Dialogue: 0,0:04:22.62,0:04:25.69,Default,,0,0,0,,Танысқаныма қуаныштымын, Людо-кун.
Dialogue: 0,0:04:25.69,0:04:28.30,Default,,0,0,0,,Өкініштісі, ол бірінші күні ол жерде болмады.
Dialogue: 0,0:04:28.30,0:04:30.30,Default,,0,0,0,,Мен Корвуспын
Dialogue: 0,0:04:30.30,0:04:32.30,Default,,0,0,0,,Арча Корвус
Dialogue: 0,0:04:32.30,0:04:35.97,Default,,0,0,0,,Бұл жай тазалаушы Кашира.
Dialogue: 0,0:04:35.97,0:04:39.31,Default,,0,0,0,,А-а-а… иә
Dialogue: 0,0:04:39.31,0:04:42.31,Default,,0,0,0,,Мен жай ғана сіздердің ақпараттарыңыз үшін
Dialogue: 0,0:04:42.31,0:04:46.15,Default,,0,0,0,,Мен ол жерде отыр деп ойладым.
Dialogue: 0,0:04:46.15,0:04:49.65,Default,,0,0,0,,Ондай адамдар мұнда жатпайды.
Dialogue: 0,0:04:49.65,0:04:54.66,Default,,0,0,0,,Дегенмен, аз уақыттың ішінде халқымыздың жақсы қасиеттерін аштыңыз.
Dialogue: 0,0:04:54.66,0:04:57.49,Default,,0,0,0,,Мен оны өміріммен қорғауға тырыстым➡
Dialogue: 0,0:04:57.49,0:05:01.26,Default,,0,0,0,,Ал тазалаушыларға үлкен үлес қоса алатындай күш➡
Dialogue: 0,0:05:01.26,0:05:03.23,Default,,0,0,0,,Алынған
Dialogue: 0,0:05:04.27,0:05:06.77,Default,,0,0,0,,Менің шағымданатын ештеңем жоқ.
Dialogue: 0,0:05:06.77,0:05:11.44,Default,,0,0,0,,Біз сізді тазалықшыларға қарсы алатынымызды ресми түрде мәлімдейміз.
Dialogue: 0,0:05:11.44,0:05:13.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:15.94,0:05:18.61,Default,,0,0,0,,Менің бөлмеме кел
Dialogue: 0,0:05:18.61,0:05:22.08,Default,,0,0,0,,Киім мен ақпарат дайын.
Dialogue: 0,0:05:24.45,0:05:26.96,Default,,0,0,0,,Шекара дегеніміз не? Аты айтып тұрғандай➡
Dialogue: 0,0:05:26.96,0:05:30.29,Default,,0,0,0,,Аспан мен төмендегі дүниенің арасында не бар➡
Dialogue: 0,0:05:30.29,0:05:32.36,Default,,0,0,0,,Аспанға өтпек болғандар➡
Dialogue: 0,0:05:32.36,0:05:36.03,Default,,0,0,0,,Шамасы, сол шекарадан өтсең өлесің.
Dialogue: 0,0:05:38.80,0:05:41.87,Default,,0,0,0,,Бір қызық оқиға бар➡
Dialogue: 0,0:05:41.87,0:05:45.31,Default,,0,0,0,,Шекараға жақын орналасқан тыйым салынған аймақта➡
Dialogue: 0,0:05:45.31,0:05:48.18,Default,,0,0,0,,Бір әйел болған көрінеді
Dialogue: 0,0:05:49.14,0:05:53.48,Default,,0,0,0,,Саяхатшы тыйым салынған аймаққа кіріп кеткенде➡
Dialogue: 0,0:05:53.48,0:05:56.82,Default,,0,0,0,,Маған сол әйел көмектескен сияқты➡
Dialogue: 0,0:05:56.82,0:05:59.49,Default,,0,0,0,,Сонда саяхатшы естіді➡
Dialogue: 0,0:05:59.49,0:06:02.46,Default,,0,0,0,,«Неге мұндасың?»
Dialogue: 0,0:06:03.43,0:06:05.76,Default,,0,0,0,,Сонда әйел➡ деді
Dialogue: 0,0:06:05.76,0:06:09.63,Default,,0,0,0,,«Мен жоғарыдан құлаған адамдарды көріп тұрмын».
Dialogue: 0,0:06:10.60,0:06:12.93,Default,,0,0,0,,Әйел сонда қоныстанды
Dialogue: 0,0:06:12.93,0:06:14.90,Default,,0,0,0,,Көп жылдар бойы
Dialogue: 0,0:06:16.00,0:06:18.44,Default,,0,0,0,,деді
Dialogue: 0,0:06:18.44,0:06:24.45,Default,,0,0,0,,《Жоғары мен астыңғы арасын алды-артына жіберсе де өлмейтін адамдар бар.》
Dialogue: 0,0:06:24.45,0:06:29.95,Default,,0,0,0,,Әйел біреудің шекарадан өтіп бара жатқанын көрген болуы мүмкін.
Dialogue: 0,0:06:29.95,0:06:34.02,Default,,0,0,0,,Егер сіз әйел көрген адамға жетсеңіз дегенді білдіреді
Dialogue: 0,0:06:34.02,0:06:37.29,Default,,0,0,0,,Сонымен, сіз қалай көтерілу керектігін білесіз бе?
Dialogue: 0,0:06:37.29,0:06:41.96,Default,,0,0,0,,Сондай-ақ Людо-кунның төменгі әлемге келгенде өлмеген себебі.
Dialogue: 0,0:06:41.96,0:06:46.30,Default,,0,0,0,,Әрине, ол жерге бару қауіпті болар еді.
Dialogue: 0,0:06:46.30,0:06:49.30,Default,,0,0,0,,Бару немесе тарту?
Dialogue: 0,0:06:49.30,0:06:51.81,Default,,0,0,0,,Не істегің келеді?
Dialogue: 0,0:06:51.81,0:06:54.18,Default,,0,0,0,,Сіз баруға шешім қабылдадыңыз, солай емес пе?
Dialogue: 0,0:06:58.21,0:07:00.15,Default,,0,0,0,,О
Dialogue: 0,0:07:00.15,0:07:04.02,Default,,0,0,0,,Окутака тазалаушының формасы
Dialogue: 0,0:07:05.32,0:07:08.49,Default,,0,0,0,,Сізге жақсы көрінеді, солай емес пе?
Dialogue: 0,0:07:10.16,0:08:38.35,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:08:51.86,0:08:58.27,Default,,0,0,0,,(Занканың жүрек соғысы)
Dialogue: 0,0:09:00.57,0:09:02.57,Default,,0,0,0,,(демілеу)
Dialogue: 0,0:09:02.57,0:09:06.04,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:09:07.41,0:09:11.08,Default,,0,0,0,,⚟Бақыт, мен шыға алмаймын, Google…
Dialogue: 0,0:09:11.08,0:09:13.05,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:09:15.75,0:09:18.75,Default,,0,0,0,,Тоқта...тоқта, тоқта➡
Dialogue: 0,0:09:18.75,0:09:22.26,Default,,0,0,0,,Бүгін тыйым салынған жерге әйелді көруге баратын күн емес.
Dialogue: 0,0:09:22.26,0:09:24.26,Default,,0,0,0,,Күшті
Dialogue: 0,0:09:24.26,0:09:26.93,Default,,0,0,0,,Аспанға оралу туралы нұсқау
Dialogue: 0,0:09:26.93,0:09:29.43,Default,,0,0,0,,Мүмкін бар шығар.
Dialogue: 0,0:09:29.43,0:09:33.27,Default,,0,0,0,,Жоқ, олай деп ойламаймын, бірақ қазір оны тоқтата алмаймын!
Dialogue: 0,0:09:33.27,0:09:35.27,Default,,0,0,0,,Сабыр ет, брат.
Dialogue: 0,0:09:35.27,0:09:37.77,Default,,0,0,0,,Эй, бұл сенсің.
Dialogue: 0,0:09:37.77,0:09:41.84,Default,,0,0,0,,Қауіпті жерге баратын болсаңыз, сізге біраз дайындық қажет болуы мүмкін.
Dialogue: 0,0:09:41.84,0:09:44.85,Default,,0,0,0,,Баратын жер тыйым салынған аймақтың ортасында.
Dialogue: 0,0:09:44.85,0:09:46.85,Default,,0,0,0,,Мұндай жерде
Dialogue: 0,0:09:46.85,0:09:51.12,Default,,0,0,0,,Мәлімет жинамай, күшіңізді растамай жүресіз бе?
Dialogue: 0,0:09:51.12,0:09:54.46,Default,,0,0,0,,Неге өлмейсің?
Dialogue: 0,0:09:54.46,0:09:56.79,Default,,0,0,0,,Менің күшімді растау?
Dialogue: 0,0:09:56.79,0:09:59.63,Default,,0,0,0,,Мен енді өз күштерімді дұрыс пайдалана алғаным жақсы.
Dialogue: 0,0:09:59.63,0:10:02.06,Default,,0,0,0,,Оны қолдану шегі Әлсіз жақтары
Dialogue: 0,0:10:02.06,0:10:04.13,Default,,0,0,0,,Сіз бәрін білуіңіз керек.
Dialogue: 0,0:10:04.13,0:10:07.14,Default,,0,0,0,,Сіз де, біз де
Dialogue: 0,0:10:07.14,0:10:09.74,Default,,0,0,0,,Сіз маған еретініңізге сенімдісіз бе?
Dialogue: 0,0:10:09.74,0:10:15.08,Default,,0,0,0,,...Дұрыс айтасыз. Тыйым салынған жерге жалғыз бару - суицид.
Dialogue: 0,0:10:17.41,0:10:19.48,Default,,0,0,0,,Ал тазартқыштар ше?
Dialogue: 0,0:10:19.48,0:10:24.25,Default,,0,0,0,,Ала аңдарды жою барысында мен ала аңдар туралы да мәліметтер жинаймын.
Dialogue: 0,0:10:24.25,0:10:27.09,Default,,0,0,0,,Тыйым салынған жерге барудың бізге пайдасы бар ма?
Dialogue: 0,0:10:27.09,0:10:30.93,Default,,0,0,0,,Сонымен бірге біз бұзақылардан да сақ болуымыз керек.
Dialogue: 0,0:10:30.93,0:10:32.99,Default,,0,0,0,,Бандалдар…
Dialogue: 0,0:10:32.99,0:10:37.77,Default,,0,0,0,,Ойланып көрейікші, неге тролльдер сияқты адамдар берушілер бола алады?
Dialogue: 0,0:10:37.77,0:10:41.27,Default,,0,0,0,,Адамдардың бәрі жақсы адамдар емес
Dialogue: 0,0:10:41.27,0:10:46.34,Default,,0,0,0,,Адамдардың барлығы бірдей нәрселерді күте алмайды.
Dialogue: 0,0:10:46.34,0:10:50.28,Default,,0,0,0,,Жақсы адамдар да заттарға жаман қарайды.
Dialogue: 0,0:10:50.28,0:10:54.12,Default,,0,0,0,,Жаман жігіттердің де маңызды нәрселері бар.
Dialogue: 0,0:10:54.12,0:10:59.45,Default,,0,0,0,,Беруші болу адам ретінде жақсы немесе жаман болуы маңызды емес.
Dialogue: 0,0:10:59.45,0:11:03.39,Default,,0,0,0,,Бірақ, бергенді ұнатпайтындар...
Dialogue: 0,0:11:03.39,0:11:07.73,Default,,0,0,0,,Адамдар бізді нашақор деп атайды.
Dialogue: 0,0:11:07.73,0:11:12.40,Default,,0,0,0,,Жалпы жұртшылықтың көзқарасы бойынша бір нәрсеге жабысып қалу қиын екені рас.
Dialogue: 0,0:11:12.40,0:11:14.90,Default,,0,0,0,,Бұл қорқынышты көрінуі мүмкін.
Dialogue: 0,0:11:14.90,0:11:16.91,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:11:28.92,0:11:31.92,Default,,0,0,0,,Әзірше бүгін демалу керек.
Dialogue: 0,0:11:31.92,0:11:35.59,Default,,0,0,0,,Аа, менің ойымша, ол көп қозғалды.
Dialogue: 0,0:11:41.76,0:11:46.03,Default,,0,0,0,,＜Таусылып қалсам да, мен қалай демаламын?＞
Dialogue: 0,0:11:55.28,0:11:57.28,Default,,0,0,0,,Не!
Dialogue: 0,0:11:57.28,0:11:59.28,Default,,0,0,0,,Хейлд!
Dialogue: 0,0:11:59.28,0:12:01.85,Default,,0,0,0,,Тазалық дүкенінің ішінде мен саған айналаны көрсетемін.
Dialogue: 0,0:12:03.22,0:12:05.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:08.06,0:12:10.73,Default,,0,0,0,,Оқу бөлмесі➡
Dialogue: 0,0:12:10.73,0:12:13.06,Default,,0,0,0,,Асхана➡
Dialogue: 0,0:12:13.06,0:12:15.40,Default,,0,0,0,,Дәретханаға?
Dialogue: 0,0:12:15.40,0:12:19.40,Default,,0,0,0,,Бұл аздап тозған, бірақ бұл өте қанағаттандырарлық.
Dialogue: 0,0:12:19.40,0:12:22.47,Default,,0,0,0,,Менің көкте болған кезімнен неше түрлі нәрсе бар.
Dialogue: 0,0:12:22.47,0:12:25.24,Default,,0,0,0,,Ол жақта өмір қандай болды?
Dialogue: 0,0:12:25.24,0:12:27.91,Default,,0,0,0,,Мен Регтпен бірге табиғат көрінісін көруге бардым.
Dialogue: 0,0:12:27.91,0:12:31.41,Default,,0,0,0,,Қоқыс жинау және қарғыс айту
Dialogue: 0,0:12:31.41,0:12:34.42,Default,,0,0,0,,Үстінде де қарғыс айтатын біреу бар➡
Dialogue: 0,0:12:34.42,0:12:37.09,Default,,0,0,0,,Жарайды, олар да төменде.
Dialogue: 0,0:12:37.09,0:12:39.15,Default,,0,0,0,,Қандай тағам жедің?
Dialogue: 0,0:12:39.15,0:12:42.59,Default,,0,0,0,,Нан, сорпа, т.б.
Dialogue: 0,0:12:42.59,0:12:44.56,Default,,0,0,0,,Кәмпиттер ше?
Dialogue: 0,0:12:45.59,0:12:48.36,Default,,0,0,0,,Тәттілер? тәттілер
Dialogue: 0,0:12:50.43,0:12:54.77,Default,,0,0,0,,Тәттілерді тек байлар жей алады.
Dialogue: 0,0:12:54.77,0:12:56.84,Default,,0,0,0,,Иә, бар.
Dialogue: 0,0:12:57.84,0:13:00.01,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:00.94,0:13:03.71,Default,,0,0,0,,Иә
Dialogue: 0,0:13:03.71,0:13:05.78,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:13:05.78,0:13:09.22,Default,,0,0,0,,Төменгі әлемде азық-түлік сатушы деп аталатын адамдар бар➡
Dialogue: 0,0:13:09.22,0:13:12.29,Default,,0,0,0,,Тазалаушылар да сол жерден үнемі сатып алады.
Dialogue: 0,0:13:12.29,0:13:15.29,Default,,0,0,0,,Не? Сіз тәтті жеуге келдіңіз бе?
Dialogue: 0,0:13:15.29,0:13:18.06,Default,,0,0,0,,Иә, мен оны ешқашан жеген емеспін.
Dialogue: 0,0:13:18.06,0:13:20.13,Default,,0,0,0,,Мен жоғарыда білмеймін
Dialogue: 0,0:13:20.13,0:13:23.73,Default,,0,0,0,,Тәттілер есірткіге қарағанда әлдеқайда танымал.
Dialogue: 0,0:13:23.73,0:13:25.73,Default,,0,0,0,,Тәуелділік танытса, қорқынышты.
Dialogue: 0,0:13:25.73,0:13:28.40,Default,,0,0,0,,Осындай үлкен сома Уфуфу
Dialogue: 0,0:13:28.40,0:13:30.74,Default,,0,0,0,,Байлар не жейді
Dialogue: 0,0:13:30.74,0:13:33.57,Default,,0,0,0,,Ластану төменгі әлемде кең таралған.
Dialogue: 0,0:13:33.57,0:13:36.08,Default,,0,0,0,,Өсімдіктердің өсуі үшін қоршаған орта қиын.
Dialogue: 0,0:13:36.08,0:13:40.75,Default,,0,0,0,,Азық-түлік дүкендері тамақ дайындауға маманданған жеткізушілерге толы.
Dialogue: 0,0:13:40.75,0:13:42.82,Default,,0,0,0,,Мүмкін солардың арқасында
Dialogue: 0,0:13:42.82,0:13:45.99,Default,,0,0,0,,Төменгі әлемде тәттілер көбірек шығар.
Dialogue: 0,0:13:47.09,0:13:49.56,Default,,0,0,0,,Жеңдер (қарлығаш)
Dialogue: 0,0:13:56.93,0:13:59.60,Default,,0,0,0,,Ноаааааааа...
Dialogue: 0,0:14:04.54,0:14:07.04,Default,,0,0,0,,Гуо
Dialogue: 0,0:14:07.04,0:14:10.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:10.04,0:14:12.11,Default,,0,0,0,,Бұл мен күткеннен де қатты әсер етті.
Dialogue: 0,0:14:12.11,0:14:14.08,Default,,0,0,0,,Мен оған сондай құмармын.
Dialogue: 0,0:14:17.55,0:14:19.55,Default,,0,0,0,,<Тоқтамаңыз! ＞
Dialogue: 0,0:14:19.55,0:14:22.62,Default,,0,0,0,,Ей, көп жесең семіресің.
Dialogue: 0,0:14:22.62,0:14:24.89,Default,,0,0,0,,​​О?
Dialogue: 0,0:14:41.24,0:14:43.51,Default,,0,0,0,,<Сіз тәттілерді мақсат етіп отырсыз ба? ＞
Dialogue: 0,0:14:44.75,0:14:48.72,Default,,0,0,0,,＜Бірақ менің де көбірек жегім келеді＞
Dialogue: 0,0:14:51.82,0:14:54.59,Default,,0,0,0,,Міне кеттік.
Dialogue: 0,0:14:54.59,0:14:56.56,Default,,0,0,0,,Ах
Dialogue: 0,0:15:00.76,0:15:03.36,Default,,0,0,0,,Гах…
Dialogue: 0,0:15:03.36,0:15:05.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:05.37,0:15:07.87,Default,,0,0,0,,Hmph...
Dialogue: 0,0:15:07.87,0:15:10.87,Default,,0,0,0,,Сен неменесің, қатынның баласы?
Dialogue: 0,0:15:10.87,0:15:14.34,Default,,0,0,0,,Әй, қымбаттым, кешіріңіз.
Dialogue: 0,0:15:15.88,0:15:19.21,Default,,0,0,0,,Эй, Рию, бұл Людо туралы не істеуіміз керек?
Dialogue: 0,0:15:19.21,0:15:22.22,Default,,0,0,0,,Бұлай болады деп ойламаппын➡
Dialogue: 0,0:15:22.22,0:15:25.55,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені тапқаныңызға қуаныштымын.
Dialogue: 0,0:15:25.55,0:15:27.56,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:27.56,0:15:30.63,Default,,0,0,0,,Сонда да кондитерлік қойманы босатып жатырсыз ба?
Dialogue: 0,0:15:30.63,0:15:33.39,Default,,0,0,0,,Кук хахахаха... Хмф
Dialogue: 0,0:15:33.39,0:15:37.40,Default,,0,0,0,,Ол тағы бірдеңе жасады ма? (шу)
Dialogue: 0,0:15:37.40,0:15:39.37,Default,,0,0,0,,Ha
Dialogue: 0,0:15:42.40,0:15:44.41,Default,,0,0,0,,Ей, ей!
Dialogue: 0,0:15:44.41,0:15:48.08,Default,,0,0,0,,Бұл бейтаныс адамда біртүрлі нәрсе бар!
Dialogue: 0,0:15:48.08,0:15:50.34,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:16:02.42,0:16:06.26,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:16:06.26,0:16:08.26,Default,,0,0,0,,Хмм, google...
Dialogue: 0,0:16:08.26,0:16:10.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:10.26,0:16:12.60,Default,,0,0,0,,Адам қаруын қайтадан пайдалана алмайсыз ба?
Dialogue: 0,0:16:12.60,0:16:14.94,Default,,0,0,0,,А? Сіз...
Dialogue: 0,0:16:14.94,0:16:18.44,Default,,0,0,0,,Тәттіге қатты әуестеніп, ұмытып кеттің бе?
Dialogue: 0,0:16:18.44,0:16:20.94,Default,,0,0,0,,Бух хахахахахаха... олай болуы мүмкін емес.
Dialogue: 0,0:16:20.94,0:16:22.94,Default,,0,0,0,,Бұл Людоның қабілетін растау керек еді.
Dialogue: 0,0:16:22.94,0:16:25.45,Default,,0,0,0,,Диетаның сәттілігі расталды.
Dialogue: 0,0:16:25.45,0:16:27.95,Default,,0,0,0,,Қозғалу оңайырақ болғанына қуаныштымын.
Dialogue: 0,0:16:27.95,0:16:31.29,Default,,0,0,0,,Гах ха ха ха ха ха ха ха ха ха ха...
Dialogue: 0,0:16:38.79,0:16:41.06,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:16:42.86,0:16:47.13,Default,,0,0,0,,Бастапқыда лақтырылған нәрсені Людо түзетпеді ме?
Dialogue: 0,0:16:47.13,0:16:51.21,Default,,0,0,0,,Иә? Егер бұл Людо қабілетінің негізіне айналса.
Dialogue: 0,0:16:51.21,0:16:54.14,Default,,0,0,0,,Қоқыс
Dialogue: 0,0:16:54.14,0:16:58.21,Default,,0,0,0,,Әлде сіз тек сынған заттарға әрекет етесіз бе?
Dialogue: 0,0:16:58.21,0:17:00.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:03.58,0:17:06.09,Default,,0,0,0,,Осылардың ішінен сүйіктісін таңдаңыз
Dialogue: 0,0:17:06.09,0:17:10.06,Default,,0,0,0,,Хаа ой
Dialogue: 0,0:17:31.78,0:17:33.85,Default,,0,0,0,,Ах (қозғалтқыш) О
Dialogue: 0,0:17:33.85,0:17:35.85,Default,,0,0,0,,Дайын
Dialogue: 0,0:17:35.85,0:17:38.45,Default,,0,0,0,,Занканың оқуы дұрыс болды.
Dialogue: 0,0:17:38.45,0:17:41.96,Default,,0,0,0,,Сіз мұны білім беру қызметкерлері күткендей жасайсыз.
Dialogue: 0,0:17:41.96,0:17:43.96,Default,,0,0,0,,Ах~ Ах
Dialogue: 0,0:17:43.96,0:17:45.96,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:17:45.96,0:17:49.80,Default,,0,0,0,,Қарапайым адамдарға қарағанда данышпандардың өздерін объективті түрде көру қабілеті төмен.
Dialogue: 0,0:17:49.80,0:17:52.47,Default,,0,0,0,,Қарапайым халықтың басына араласпа.
Dialogue: 0,0:17:52.47,0:17:54.47,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,0:17:54.47,0:17:56.54,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:56.54,0:17:58.81,Default,,0,0,0,,Сен қатты ашуландың, хи хи
Dialogue: 0,0:17:58.81,0:18:00.81,Default,,0,0,0,,Хехе, оны үздіксіз қаруландыруға болады ма?
Dialogue: 0,0:18:00.81,0:18:03.38,Default,,0,0,0,,Менің ойымша, оны қолданып көрген дұрыс.
Dialogue: 0,0:18:09.32,0:18:11.29,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:18:12.32,0:18:15.32,Default,,0,0,0,,Сіз әлі де сондасыз ба? Ах.
Dialogue: 0,0:18:15.32,0:18:17.39,Default,,0,0,0,,Сіз шынымен алдап жатырсыз
Dialogue: 0,0:18:17.39,0:18:19.36,Default,,0,0,0,,Гах…
Dialogue: 0,0:18:21.83,0:18:24.90,Default,,0,0,0,,Иә? Күткендей?
Dialogue: 0,0:18:24.90,0:18:28.17,Default,,0,0,0,,Бұл жігіт бұрын адам құрылғыларын үздіксіз пайдаланған.
Dialogue: 0,0:18:28.17,0:18:31.24,Default,,0,0,0,,Мұрнымнан қан кетті, жігіт.
Dialogue: 0,0:18:31.24,0:18:35.68,Default,,0,0,0,,Қолғаптың сапасы жақсы емес, сондықтан ол менің денеме сәйкес келмейді деп ойлаймын.
Dialogue: 0,0:18:35.68,0:18:38.18,Default,,0,0,0,,Сұрақ?
Dialogue: 0,0:18:38.18,0:18:42.25,Default,,0,0,0,,Неғұрлым көп нәрсеге қамқорлық жасасаңыз, соғұрлым көп
Dialogue: 0,0:18:42.25,0:18:45.22,Default,,0,0,0,,Ол жақсы қария.
Dialogue: 0,0:18:46.85,0:18:51.36,Default,,0,0,0,,Сапаны жақсарту дегенді түсінеміз.
Dialogue: 0,0:18:51.36,0:18:54.86,Default,,0,0,0,,Сапа неғұрлым жақсы болса, соғұрлым көп қуат өндіруге болады.
Dialogue: 0,0:18:54.86,0:18:59.20,Default,,0,0,0,,Бірақ шайқастағы күш тек сапамен ғана шектелмейді.
Dialogue: 0,0:18:59.20,0:19:01.97,Default,,0,0,0,,Пайдаланушының тәжірибесі Ойға байланысты
Dialogue: 0,0:19:01.97,0:19:05.31,Default,,0,0,0,,Бұл сондай-ақ бейнеленген қабілеттілікке байланысты
Dialogue: 0,0:19:05.31,0:19:08.98,Default,,0,0,0,,Екеуі де маңызды.
Dialogue: 0,0:19:15.15,0:19:18.15,Default,,0,0,0,,<Ол денеге соншалықты әсер ете ме? ＞
Dialogue: 0,0:19:18.15,0:19:22.92,Default,,0,0,0,,<Әлде оның серияға қатысы бар ма? ＞
Dialogue: 0,0:19:23.99,0:19:26.49,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:19:26.49,0:19:31.67,Default,,0,0,0,,Қару-жараққа айналдырған заттың ақырында құлауына не себеп болды?
Dialogue: 0,0:19:32.57,0:19:36.00,Default,,0,0,0,,Қазір қаруға айналған нәрсе ыдырамайды.
Dialogue: 0,0:19:36.00,0:19:39.51,Default,,0,0,0,,Ауыстыру себебінен ол құлап қалмайды.
Dialogue: 0,0:19:39.51,0:19:42.68,Default,,0,0,0,,Уақыт шегі бар ма?
Dialogue: 0,0:19:44.51,0:19:48.02,Default,,0,0,0,,Мүмкін?
Dialogue: 0,0:19:48.02,0:19:51.85,Default,,0,0,0,,Бұл енді өкінбейсің деген сөз емес пе?
Dialogue: 0,0:19:51.85,0:19:54.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:54.19,0:19:57.02,Default,,0,0,0,,Өйткені заттарды адамдар лақтырып жіберген.
Dialogue: 0,0:19:57.02,0:19:59.53,Default,,0,0,0,,Сынған және жарамсыз заттардың құны
Dialogue: 0,0:19:59.53,0:20:01.96,Default,,0,0,0,,Бұл максималды шығару қабілеті, солай ма? ➡
Dialogue: 0,0:20:01.96,0:20:04.63,Default,,0,0,0,,Рудодан оны қайта пайдалануды сұраңыз➡
Dialogue: 0,0:20:04.63,0:20:07.70,Default,,0,0,0,,Бұл сіздің рөліңізді орындағаныңызды білдірсе ➡
Dialogue: 0,0:20:07.70,0:20:10.30,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:20:10.30,0:20:12.31,Default,,0,0,0,,Рөл
Dialogue: 0,0:20:12.31,0:20:17.81,Default,,0,0,0,,Шынында да, шайқас аяқталып, Людо жеңілдеп қалғанда, ол құлады.
Dialogue: 0,0:20:17.81,0:20:22.65,Default,,0,0,0,,Бұл да Людо қабілетінің бір бөлігі болуы мүмкін.
Dialogue: 0,0:20:22.65,0:20:25.32,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:20:25.32,0:20:29.39,Default,,0,0,0,,Қоқыс Сынған заттардың құнын барынша арттырыңыз
Dialogue: 0,0:20:29.39,0:20:33.16,Default,,0,0,0,,Өз рөліңізді орындаңыз және тұтыныңыз
Dialogue: 0,0:20:33.16,0:20:35.50,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:20:35.50,0:20:38.00,Default,,0,0,0,,Менің ойымша, Рию дұрыс.
Dialogue: 0,0:20:38.00,0:20:40.33,Default,,0,0,0,,Сіз Грейздің бойтұмарысыз.
Dialogue: 0,0:20:40.33,0:20:43.34,Default,,0,0,0,,Қаруға айналдырғанымды жоймадым.
Dialogue: 0,0:20:43.34,0:20:47.11,Default,,0,0,0,,Толық күйіп кеткенін түгел бітірдім.
Dialogue: 0,0:20:48.68,0:20:50.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:58.35,0:21:00.35,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:21:00.35,0:21:04.53,Default,,0,0,0,,Бұл қолғап сериясы деп айтылды.
Dialogue: 0,0:21:04.53,0:21:07.36,Default,,0,0,0,,Мұның бәрі не туралы болды? Ах
Dialogue: 0,0:21:07.36,0:21:10.13,Default,,0,0,0,,Серия
Dialogue: 0,0:21:10.13,0:21:13.80,Default,,0,0,0,,Бұл бірнеше басқалар бар дегенді білдіре ме?
Dialogue: 0,0:21:14.80,0:21:17.14,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:21:17.14,0:21:19.14,Default,,0,0,0,,Сенің атың кім?
Dialogue: 0,0:21:19.14,0:21:21.64,Default,,0,0,0,,Аты?
Dialogue: 0,0:21:21.64,0:21:23.64,Default,,0,0,0,,Иә➡
Dialogue: 0,0:21:23.64,0:21:25.98,Default,,0,0,0,,Оны маңызды нәрселерге қою керек➡
Dialogue: 0,0:21:25.98,0:21:27.95,Default,,0,0,0,,Өтінемін, есікті ашыңдар
Dialogue: 0,0:21:29.32,0:21:32.65,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,0:21:32.65,0:21:37.32,Default,,0,0,0,,Аа, мен оған лайықты атау беруім керек.
Dialogue: 0,0:21:39.66,0:21:43.93,Default,,0,0,0,,(аяқпен ырғақты дыбыс)
Dialogue: 0,0:21:50.67,0:21:56.01,Default,,0,0,0,,(есік ашылады)
Dialogue: 0,0:21:56.01,0:21:58.51,Default,,0,0,0,,Мен қайтып келдім, бастық.
Dialogue: 0,0:21:58.51,0:22:00.48,Default,,0,0,0,,(есік жабылады)
Dialogue: 0,0:22:04.29,0:22:06.62,Default,,0,0,0,,Тазартқыш
Dialogue: 0,0:22:06.62,0:22:08.69,Default,,0,0,0,,Өнер қаласы
Dialogue: 0,0:22:08.69,0:22:11.46,Default,,0,0,0,,Шөл құрбандық орны
Dialogue: 0,0:22:11.46,0:22:13.53,Default,,0,0,0,,Адам ағзалары
Dialogue: 0,0:22:13.53,0:22:15.70,Default,,0,0,0,,Серия
Dialogue: 0,0:22:17.80,0:22:20.87,Default,,0,0,0,,⚟Кейпер сериясы
Dialogue: 0,0:22:23.30,0:22:25.31,Default,,0,0,0,,⚟Рудо
Dialogue: 0,0:22:25.31,0:23:53.59,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:55.09,0:24:00.09,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
