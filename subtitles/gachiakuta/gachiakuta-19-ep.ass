Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.97,0:00:18.75,Default,,0,0,0,,《(Қарғаның айқайы)》
Dialogue: 0,0:00:47.68,0:00:51.75,Default,,0,0,0,,Аспанға деген жоспарларыңыз туралы сұраудың қажеті жоқ.
Dialogue: 0,0:00:53.18,0:00:56.02,Default,,0,0,0,,Онда мен саған көрсетемін
Dialogue: 0,0:00:56.02,0:00:58.19,Default,,0,0,0,,Ах
Dialogue: 0,0:01:12.80,0:01:16.14,Default,,0,0,0,,Сақтаушылардың қатары
Dialogue: 0,0:01:16.14,0:01:18.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:19.14,0:01:22.14,Default,,0,0,0,,Людоның қолғаптары➡
Dialogue: 0,0:01:22.14,0:01:24.98,Default,,0,0,0,,Менің пальтоым➡
Dialogue: 0,0:01:24.98,0:01:27.75,Default,,0,0,0,,Ал мына аяқ киім
Dialogue: 0,0:01:42.50,0:01:45.00,Default,,0,0,0,,Адамның басқа мүшелерімен салыстырғанда➡
Dialogue: 0,0:01:45.00,0:01:49.00,Default,,0,0,0,,Бұл қамқоршы сериясының маусымдары тым әртүрлі➡
Dialogue: 0,0:01:49.00,0:01:53.08,Default,,0,0,0,,Оның құрамындағы энергия өлшеусіз➡
Dialogue: 0,0:01:53.08,0:01:58.68,Default,,0,0,0,,Бұның иесінің ойлары өте күшті болса керек.
Dialogue: 0,0:01:58.68,0:02:00.85,Default,,0,0,0,,Мен не істесем де
Dialogue: 0,0:02:00.85,0:02:05.62,Default,,0,0,0,,Келесі Guardian сериясын жасау мүмкін болмады.
Dialogue: 0,0:02:05.62,0:02:08.62,Default,,0,0,0,,Бірақ эксперимент барысында
Dialogue: 0,0:02:08.62,0:02:12.39,Default,,0,0,0,,Мен мүлде басқа нәрсе жасадым.
Dialogue: 0,0:02:34.72,0:02:40.39,Default,,0,0,0,,《(Қарғаның айқайы)》
Dialogue: 0,0:02:54.00,0:02:57.07,Default,,0,0,0,,Жабайы заттарға ұқсас және айырмашылығы➡
Dialogue: 0,0:02:57.07,0:03:01.01,Default,,0,0,0,,Төменгі дүниенің адам органдарынан қуат алатын аңдары➡
Dialogue: 0,0:03:01.01,0:03:05.01,Default,,0,0,0,,Сіз оны кем дегенде бір рет көрген боларсыз.
Dialogue: 0,0:03:05.01,0:03:06.98,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:03:11.45,0:03:15.12,Default,,0,0,0,,《(Гүрілдеу)》
Dialogue: 0,0:03:15.12,0:03:17.09,Default,,0,0,0,,Уф
Dialogue: 0,0:03:18.96,0:03:21.03,Default,,0,0,0,,Ұшайық➡
Dialogue: 0,0:03:21.03,0:03:23.00,Default,,0,0,0,,Мына ала аңмен
Dialogue: 0,0:03:33.04,0:04:27.83,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:14.84,0:05:23.72,Default,,0,0,0,,《(сөйлейтін адамдардың дыбыстары)》
Dialogue: 0,0:05:23.72,0:05:27.22,Default,,0,0,0,,《⚟Мынаны қарашы, бұл қорқынышты》
Dialogue: 0,0:05:27.22,0:05:29.72,Default,,0,0,0,,《⚟Бұл ол кісі өлтірушінің баласы》
Dialogue: 0,0:05:29.72,0:05:33.23,Default,,0,0,0,,《⚟Ойбай-ау, әкем көп адамды өлтірді.》
Dialogue: 0,0:05:33.23,0:05:35.73,Default,,0,0,0,,《⚟ Баланы бір жерге қамап қойыңыз》
Dialogue: 0,0:05:35.73,0:05:38.07,Default,,0,0,0,,《⚟Ол қорқынышты бала》
Dialogue: 0,0:05:38.07,0:05:41.74,Default,,0,0,0,,《⚟Сен оны тұңғиыққа тастайсың.》 《⚟Шынымен.》
Dialogue: 0,0:05:41.74,0:05:46.01,Default,,0,0,0,,《⚟Тез қылмыс жасап, шыңырауға құлау》
Dialogue: 0,0:05:48.58,0:05:50.65,Default,,0,0,0,,《Ол үшін уайымдама》
Dialogue: 0,0:05:50.65,0:05:54.42,Default,,0,0,0,,《Сенің шындығыңды бәрі біле бермейді➡》
Dialogue: 0,0:05:54.42,0:05:59.25,Default,,0,0,0,,《Адамдар білмегеннен қорқады және оны жоюға тырысады➡》
Dialogue: 0,0:05:59.25,0:06:03.83,Default,,0,0,0,,《Бір-бірімізді білсек, бір күні түсінеміз》
Dialogue: 0,0:06:06.03,0:06:08.70,Default,,0,0,0,,《Кісі өлтірушінің баласы》
Dialogue: 0,0:06:08.70,0:06:11.37,Default,,0,0,0,,《Уф ха ха...》
Dialogue: 0,0:06:11.37,0:06:17.87,Default,,0,0,0,,《(Тауластар келекелейді)》
Dialogue: 0,0:06:17.87,0:06:20.54,Default,,0,0,0,,《⚟Мына жезөкше де кісі өлтіруші》 《Қарғыс атсын》
Dialogue: 0,0:06:20.54,0:06:25.71,Default,,0,0,0,,《⚟Кісі өлтіру》 《⚟Кісі өлтіру》
Dialogue: 0,0:06:25.71,0:06:28.38,Default,,0,0,0,,《⚟Кісі өлтіру》 《Көкек》
Dialogue: 0,0:06:28.38,0:06:30.35,Default,,0,0,0,,《⚟Кісі өлтіру》 《Аа...》
Dialogue: 0,0:06:38.89,0:06:42.23,Default,,0,0,0,,《Аа》
Dialogue: 0,0:06:42.23,0:06:50.31,Default,,0,0,0,,《(Іңілу)》
Dialogue: 0,0:06:50.31,0:06:54.48,Default,,0,0,0,,《О, Людо! 》 《(енеді)》
Dialogue: 0,0:06:57.75,0:07:01.18,Default,,0,0,0,,《Хаа хаа уф уф...》
Dialogue: 0,0:07:01.18,0:07:03.25,Default,,0,0,0,,《Уф...》 《Жарайды, Людо》
Dialogue: 0,0:07:03.25,0:07:06.52,Default,,0,0,0,,《Міндетті түрде жақсарады》
Dialogue: 0,0:07:06.52,0:07:10.69,Default,,0,0,0,,《Уфф...》 《Жарайды.》
Dialogue: 0,0:07:22.60,0:07:26.88,Default,,0,0,0,,《(Тыныс алу)》
Dialogue: 0,0:07:34.55,0:07:36.55,Default,,0,0,0,,《》
Dialogue: 0,0:07:36.55,0:07:40.62,Default,,0,0,0,,《》 《Баяу ал, Людо, баяу ал》
Dialogue: 0,0:07:40.62,0:07:43.89,Default,,0,0,0,,《》
Dialogue: 0,0:07:43.89,0:07:48.56,Default,,0,0,0,,《(Аяқ)》
Dialogue: 0,0:07:59.24,0:08:01.21,Default,,0,0,0,,《Аа》
Dialogue: 0,0:08:02.18,0:08:04.85,Default,,0,0,0,,《(Людоның ыңырсыуы)》
Dialogue: 0,0:08:04.85,0:08:18.03,Default,,0,0,0,,《(ыңылдады)》
Dialogue: 0,0:08:29.87,0:08:35.04,Default,,0,0,0,,《(есіктің ашылу және жабылу дыбысы)》
Dialogue: 0,0:08:39.71,0:08:41.72,Default,,0,0,0,,《Луд➡》
Dialogue: 0,0:08:41.72,0:08:45.55,Default,,0,0,0,,《Бұл қаншалықты пайдалы болатынын білмеймін➡》
Dialogue: 0,0:08:45.55,0:08:50.83,Default,,0,0,0,,《Ең болмағанда қолыңды қорғайды》
Dialogue: 0,0:09:32.27,0:09:34.74,Default,,0,0,0,,Серия
Dialogue: 0,0:09:36.60,0:09:39.87,Default,,0,0,0,,Keeper… сериясы?
Dialogue: 0,0:09:45.11,0:09:47.95,Default,,0,0,0,,Күшті энергия➡
Dialogue: 0,0:09:47.95,0:09:51.29,Default,,0,0,0,,Күтілгендей, Сеннин сериясының сапасы әртүрлі➡
Dialogue: 0,0:09:51.29,0:09:55.76,Default,,0,0,0,,Бірақ бұл әлі де жеткіліксіз сияқты.
Dialogue: 0,0:09:58.36,0:10:00.73,Default,,0,0,0,,Бұл қолғап
Dialogue: 0,0:10:00.73,0:10:02.73,Default,,0,0,0,,Сіздің пальто
Dialogue: 0,0:10:02.73,0:10:05.23,Default,,0,0,0,,Сондай-ақ оқ-дәріден жасалған аяқ киім
Dialogue: 0,0:10:05.23,0:10:07.74,Default,,0,0,0,,Серия?
Dialogue: 0,0:10:07.74,0:10:09.74,Default,,0,0,0,,Қатар дегеніміз не?
Dialogue: 0,0:10:09.74,0:10:14.81,Default,,0,0,0,,Е, сонда тағы қанша зат бар? Ах...
Dialogue: 0,0:10:14.81,0:10:16.81,Default,,0,0,0,,《Бірақ мен ойнауым керек》→
Dialogue: 0,0:10:20.42,0:10:23.38,Default,,0,0,0,,<Регто болды ма? ＞
Dialogue: 0,0:10:26.49,0:10:28.76,Default,,0,0,0,,Ludo you
Dialogue: 0,0:10:28.76,0:10:30.83,Default,,0,0,0,,Дүкендегі әңгіме негізінде
Dialogue: 0,0:10:30.83,0:10:35.43,Default,,0,0,0,,Менің ойымша, сіз төменгі әлемге келгенше адам ағзалары туралы білмеген боларсыз➡
Dialogue: 0,0:10:35.43,0:10:37.77,Default,,0,0,0,,Бұл біртүрлі➡
Dialogue: 0,0:10:37.77,0:10:40.27,Default,,0,0,0,,Адам мүшелерін білмейтін аспан иелері➡
Dialogue: 0,0:10:40.27,0:10:44.61,Default,,0,0,0,,Бізде адам мүшелерінің арасында жоғары класс болып табылатын қамқоршы сериясы бар ➡
Dialogue: 0,0:10:44.61,0:10:47.61,Default,,0,0,0,,Егер сіз оны берушіге айналсаңыз да➡
Dialogue: 0,0:10:47.61,0:10:50.38,Default,,0,0,0,,Ақыл-есі дұрыс болуға қалай дәтің бар?
Dialogue: 0,0:10:51.68,0:10:53.65,Default,,0,0,0,,Иә
Dialogue: 0,0:10:57.95,0:11:01.12,Default,,0,0,0,,Хмм, бұл не?
Dialogue: 0,0:11:01.12,0:11:03.96,Default,,0,0,0,,Бұл не? ?
Dialogue: 0,0:11:03.96,0:11:06.13,Default,,0,0,0,,Guardian сериясы➡
Dialogue: 0,0:11:06.13,0:11:11.13,Default,,0,0,0,,Бұлардың барлығын бір адам киген➡
Dialogue: 0,0:11:11.13,0:11:13.97,Default,,0,0,0,,Егер сіз де қолдансаңыз, түсінесіз➡
Dialogue: 0,0:11:13.97,0:11:17.74,Default,,0,0,0,,Бұл орасан зор, түбі жоқ энергия
Dialogue: 0,0:11:19.14,0:11:24.15,Default,,0,0,0,,Мен жалғызбын. Мен мұның бәрін өзім жасадым.
Dialogue: 0,0:11:24.15,0:11:28.98,Default,,0,0,0,,Сіз өз өміріңізде қалай күшті бола аласыз➡
Dialogue: 0,0:11:28.98,0:11:33.15,Default,,0,0,0,,Адамға керегі бар адамда болса➡
Dialogue: 0,0:11:33.15,0:11:36.16,Default,,0,0,0,,Сізді жынды ететіндей күшті ой➡
Dialogue: 0,0:11:36.16,0:11:39.93,Default,,0,0,0,,Ол әрбір затқа сіңген.
Dialogue: 0,0:11:44.93,0:11:48.40,Default,,0,0,0,,Менде бұрыннан бар... бірақ
Dialogue: 0,0:11:49.44,0:11:51.81,Default,,0,0,0,,Жынды болма
Dialogue: 0,0:11:53.11,0:11:55.11,Default,,0,0,0,,That's right.
Dialogue: 0,0:11:55.11,0:11:59.38,Default,,0,0,0,,Біз Keeper сериясымен қалыпты түрде айналысамыз.
Dialogue: 0,0:12:00.28,0:12:03.12,Default,,0,0,0,,Адамның маңызды бөліктері➡
Dialogue: 0,0:12:03.12,0:12:05.89,Default,,0,0,0,,Мен оны бір жерге тастап кеткен сияқтымын.
Dialogue: 0,0:12:07.29,0:12:09.66,Default,,0,0,0,,Ах
Dialogue: 0,0:12:16.13,0:12:18.10,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:19.13,0:12:21.74,Default,,0,0,0,,Неге сонша пессимистік?
Dialogue: 0,0:12:21.74,0:12:23.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:23.74,0:12:28.31,Default,,0,0,0,,Соның арқасында мен басым күшті пайдалана аламын.
Dialogue: 0,0:12:32.25,0:12:34.32,Default,,0,0,0,,Қарғыс атқыр, сен қызықсың➡
Dialogue: 0,0:12:34.32,0:12:38.25,Default,,0,0,0,,Guardian сериясын еш қиындықсыз пайдалана алатындар
Dialogue: 0,0:12:38.25,0:12:43.59,Default,,0,0,0,,Егер сіз барлық қамқоршылар сериясын кисеңіз не болады?
Dialogue: 0,0:12:43.59,0:12:47.66,Default,,0,0,0,,Мақсаты бойынша білу керек➡
Dialogue: 0,0:12:47.66,0:12:50.93,Default,,0,0,0,,Тәжірибе жасау керек
Dialogue: 0,0:12:52.67,0:12:58.11,Default,,0,0,0,,Мен сақтандыру мақсатында жасауға тырысқан Guardian сериясына ұқсас эксперимент➡
Dialogue: 0,0:12:58.11,0:13:00.58,Default,,0,0,0,,Бұл сәтсіздік
Dialogue: 0,0:13:01.88,0:13:06.35,Default,,0,0,0,,Бірақ сәтсіздік қалдықтарды тудырмайды.
Dialogue: 0,0:13:14.89,0:13:18.56,Default,,0,0,0,,Сеннин сериясының сәтсіз шығармалары негізінде➡
Dialogue: 0,0:13:18.56,0:13:22.40,Default,,0,0,0,,Сонымен қатар, ол адам артефактілерін ұсыну арқылы дамиды➡
Dialogue: 0,0:13:22.40,0:13:25.40,Default,,0,0,0,,Скарлет Бест Модоки
Dialogue: 0,0:13:25.40,0:13:28.40,Default,,0,0,0,,Мұның бәрі эксперимент.
Dialogue: 0,0:13:28.40,0:13:31.47,Default,,0,0,0,,Мен сіздермен достарыммен болған кезде хабарластым.
Dialogue: 0,0:13:31.47,0:13:35.44,Default,,0,0,0,,Аспанды түсіру үшін барлық құнды тәжірибелер
Dialogue: 0,0:13:36.48,0:13:38.48,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:13:38.48,0:13:40.95,Default,,0,0,0,,Ұшу туралы не айттыңыз?
Dialogue: 0,0:13:51.76,0:13:55.10,Default,,0,0,0,,Біз мінетін мына ала аңда
Dialogue: 0,0:13:55.10,0:13:57.60,Default,,0,0,0,,Біз шекарадан өтпекпіз
Dialogue: 0,0:13:57.60,0:13:59.57,Default,,0,0,0,,Ha
Dialogue: 0,0:14:00.77,0:14:03.54,Default,,0,0,0,,Бұл оны түсіндіруі керек➡
Dialogue: 0,0:14:03.54,0:14:07.88,Default,,0,0,0,,Кім аман қалады, кім өледі?
Dialogue: 0,0:14:07.88,0:14:11.55,Default,,0,0,0,,Ауа райы болжамы бекер емес, солай ма? ➡
Dialogue: 0,0:14:11.55,0:14:15.22,Default,,0,0,0,,Жағымды жел соғып тұр
Dialogue: 0,0:14:22.86,0:14:25.86,Default,,0,0,0,,Біз мініп жүрген мына ала аңда➡
Dialogue: 0,0:14:25.86,0:14:28.86,Default,,0,0,0,,Біз шекараны кесіп өтпекпіз
Dialogue: 0,0:14:28.86,0:14:31.13,Default,,0,0,0,,«Бұл ала жануар»
Dialogue: 0,0:14:31.13,0:14:33.90,Default,,0,0,0,,«Нақ жануар»
Dialogue: 0,0:14:39.21,0:14:41.48,Default,,0,0,0,,Ахх! ? Ах!
Dialogue: 0,0:14:44.48,0:14:47.15,Default,,0,0,0,,Ала аңның ішінде! ?
Dialogue: 0,0:14:47.15,0:14:49.92,Default,,0,0,0,,Мааажи
Dialogue: 0,0:14:51.49,0:14:55.49,Default,,0,0,0,,Аа, сіз мұнда қанша уақыт болдыңыз? Алақай!
Dialogue: 0,0:14:55.49,0:14:59.16,Default,,0,0,0,,Құбыжық шайқасы!
Dialogue: 0,0:14:59.16,0:15:01.10,Default,,0,0,0,,(айқай)
Dialogue: 0,0:15:01.10,0:15:03.16,Default,,0,0,0,,Ой, жер сілкінісі! ?
Dialogue: 0,0:15:03.16,0:15:06.43,Default,,0,0,0,,Ой, бұл қауіпті, мынау қауіпті➡
Dialogue: 0,0:15:06.43,0:15:08.77,Default,,0,0,0,,Сәл күте тұрыңыз, Зодил мырза.
Dialogue: 0,0:15:08.77,0:15:11.74,Default,,0,0,0,,Мен әлі ұрысқан жоқпын.
Dialogue: 0,0:15:12.77,0:15:16.78,Default,,0,0,0,,Не? Бұл сіздің бастығыңыздың жұмысын шайқалтады ма?
Dialogue: 0,0:15:16.78,0:15:20.28,Default,,0,0,0,,Иә, сен мені итеріп жатқан шығарсың.
Dialogue: 0,0:15:20.28,0:15:24.55,Default,,0,0,0,,Му~ Сондықтан мен сенің сол жерден күрескеніңді қаладым!
Dialogue: 0,0:15:28.29,0:15:31.79,Default,,0,0,0,,А, ол басылды.
Dialogue: 0,0:15:31.79,0:15:33.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:35.13,0:15:37.80,Default,,0,0,0,,Иә, иә, иә
Dialogue: 0,0:15:37.80,0:15:40.64,Default,,0,0,0,,Не... неге жүре бастадыңыз?
Dialogue: 0,0:15:40.64,0:15:42.97,Default,,0,0,0,,Осы жерде қалсам да
Dialogue: 0,0:15:42.97,0:15:45.64,Default,,0,0,0,,Тіпті басталмайтын сияқты.
Dialogue: 0,0:15:45.64,0:15:48.14,Default,,0,0,0,,Мен басқа серік тауып алайын.
Dialogue: 0,0:15:48.14,0:15:51.21,Default,,0,0,0,,Уау-а-а-а
Dialogue: 0,0:15:51.21,0:15:55.65,Default,,0,0,0,,Жоқ, бұл біраз мәселе, дегенмен~➡
Dialogue: 0,0:15:55.65,0:15:59.72,Default,,0,0,0,,Уф, уф, уф, сәл күте тұрсаңызшы...➡
Dialogue: 0,0:15:59.72,0:16:01.82,Default,,0,0,0,,...
Dialogue: 0,0:16:01.82,0:16:05.59,Default,,0,0,0,,Ой... орындайық! Мен мұны жалғыз жасай аламын.
Dialogue: 0,0:16:05.59,0:16:08.26,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:16:08.26,0:16:10.77,Default,,0,0,0,,Ммм, мохохо!
Dialogue: 0,0:16:10.77,0:16:13.77,Default,,0,0,0,,Сәл күте тұрыңыз~ Гугу...
Dialogue: 0,0:16:13.77,0:16:17.27,Default,,0,0,0,,Біреу маған не істеу керектігін айтпаса, мен әрекет ете алмаймын.➡
Dialogue: 0,0:16:17.27,0:16:19.27,Default,,0,0,0,,Өйткені бұл кемшілік➡
Dialogue: 0,0:16:19.27,0:16:22.61,Default,,0,0,0,,Зодил мырза оны түзетемін деп жатыр.
Dialogue: 0,0:16:22.61,0:16:24.95,Default,,0,0,0,,Сондықтан мен оны өте жоғары бағалаймын.
Dialogue: 0,0:16:24.95,0:16:28.95,Default,,0,0,0,,Менің артымнан жүре аласыз ба? Ха!
Dialogue: 0,0:16:28.95,0:16:30.95,Default,,0,0,0,,ЖОҚ
Dialogue: 0,0:16:30.95,0:16:34.02,Default,,0,0,0,,Бұл жерден қалай қашуға болады...
Dialogue: 0,0:16:34.02,0:16:36.62,Default,,0,0,0,,Достарыңыздың қайда екенін білмесеңіз
Dialogue: 0,0:16:36.62,0:16:40.29,Default,,0,0,0,,Менің төбелесуге мүлде құмар емеспін.
Dialogue: 0,0:16:40.29,0:16:44.13,Default,,0,0,0,,Егер сіз қатты тырыссаңыз және қабырғаны бұзу үшін адам қаруын қолдансаңыз, сіз шығуыңыз мүмкін.
Dialogue: 0,0:16:44.13,0:16:48.30,Default,,0,0,0,,Өйткені бұл жер ала аңның ішінде~!
Dialogue: 0,0:16:51.14,0:16:54.98,Default,,0,0,0,,Ахх! ? Дақты аңның ішінде! ?
Dialogue: 0,0:16:54.98,0:16:57.48,Default,,0,0,0,,Мааажи
Dialogue: 0,0:16:57.48,0:16:59.81,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:16:59.81,0:17:02.75,Default,,0,0,0,,Мен достарымның қайда екенін білмеймін, бірақ
Dialogue: 0,0:17:02.75,0:17:04.75,Default,,0,0,0,,Бұл менің ұрысқым келеді...
Dialogue: 0,0:17:04.75,0:17:06.75,Default,,0,0,0,,...
Dialogue: 0,0:17:06.75,0:17:10.26,Default,,0,0,0,,(айқай)
Dialogue: 0,0:17:10.26,0:17:12.26,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:17:12.26,0:17:14.76,Default,,0,0,0,,Бұл мен күткеннен де жылдам болды, Зодил.
Dialogue: 0,0:17:14.76,0:17:17.83,Default,,0,0,0,,Мен әлі де сұрағым келетін нәрселер өте көп.
Dialogue: 0,0:17:17.83,0:17:20.84,Default,,0,0,0,,Бұл не дірілдеп тұр?
Dialogue: 0,0:17:20.84,0:17:23.10,Default,,0,0,0,,Ха, мүмкін емес!
Dialogue: 0,0:17:23.10,0:17:25.94,Default,,0,0,0,,(Кедейлік бопсалау)
Dialogue: 0,0:17:25.94,0:17:29.78,Default,,0,0,0,,Қымбаттым, кедейлікті тағы бопсалап жатырсың➡
Dialogue: 0,0:17:29.78,0:17:33.61,Default,,0,0,0,,Ұйқыңыз келе ме? Қараңғы болғандықтан ұйықтайсыз ба?
Dialogue: 0,0:17:33.61,0:17:37.29,Default,,0,0,0,,Бірақ мен саған кедейлікті қорлауды доғар дедім.
Dialogue: 0,0:17:37.29,0:17:40.79,Default,,0,0,0,,Ол сондай катаклизмдік деңгейге жетті➡
Dialogue: 0,0:17:40.79,0:17:43.56,Default,,0,0,0,,Қазірдің өзінде! Сіз байсалды емессіз, солай ма?
Dialogue: 0,0:17:44.79,0:17:47.30,Default,,0,0,0,,Жоқ, кетті➡
Dialogue: 0,0:17:47.30,0:17:50.36,Default,,0,0,0,,Осылай аспанға көтерілсек, бәрі➡
Dialogue: 0,0:17:50.36,0:17:52.97,Default,,0,0,0,,Мен шекарадан өтемін
Dialogue: 0,0:17:52.97,0:17:58.44,Default,,0,0,0,,Жоқ, сіз шекарадан өту сезімін сезінуіңіз мүмкін...
Dialogue: 0,0:17:59.47,0:18:02.31,Default,,0,0,0,,Иә? Аспанда?
Dialogue: 0,0:18:02.31,0:18:06.65,Default,,0,0,0,,Иә? Біз мініп келе жатқан мына ала аң
Dialogue: 0,0:18:06.65,0:18:09.32,Default,,0,0,0,,Аспанға апаратын көлік➡
Dialogue: 0,0:18:09.32,0:18:12.09,Default,,0,0,0,,Сіз тазалаушысыз, бірақ байқамайсыз ба?
Dialogue: 0,0:18:14.32,0:18:17.39,Default,,0,0,0,,Ахх! ? Ханжу…
Dialogue: 0,0:18:18.66,0:18:21.63,Default,,0,0,0,,Гунуу...
Dialogue: 0,0:18:23.73,0:18:27.50,Default,,0,0,0,,(қозғалтқыш күледі)
Dialogue: 0,0:18:27.50,0:18:29.50,Default,,0,0,0,,Уф... бұл өте жаман, Фу.
Dialogue: 0,0:18:29.50,0:18:33.01,Default,,0,0,0,,Адамдар біздің мамандығымыз емес.
Dialogue: 0,0:18:33.01,0:18:35.08,Default,,0,0,0,,Сұрақтар көп, бірақ
Dialogue: 0,0:18:35.08,0:18:40.01,Default,,0,0,0,,Бұл ала аң деп естісем, өзімді ауыртпалықсыз сезінемін.
Dialogue: 0,0:18:40.01,0:18:44.09,Default,,0,0,0,,Балалар, біз кімбіз?
Dialogue: 0,0:18:44.09,0:18:47.36,Default,,0,0,0,,Сіз ұмытып қалдыңыз ба?
Dialogue: 0,0:18:47.36,0:18:49.36,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:18:49.36,0:18:51.63,Default,,0,0,0,,Сіз тазалап жатырсыз ба? Сіз тазалап жатырсыз ба?
Dialogue: 0,0:19:06.81,0:19:12.08,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:19:13.31,0:19:16.65,Default,,0,0,0,,О? Эй, ол не?
Dialogue: 0,0:19:16.65,0:19:19.62,Default,,0,0,0,,Мен кенеттен мотивацияны сезіндім.
Dialogue: 0,0:19:22.99,0:19:25.06,Default,,0,0,0,,Адам ағзалары
Dialogue: 0,0:19:25.06,0:19:28.33,Default,,0,0,0,,Орталық крест
Dialogue: 0,0:19:28.33,0:19:31.33,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:31.33,0:19:34.34,Default,,0,0,0,,Алаңды аңмен бетпе-бет келгенде мотивация аласыз ба?➡
Dialogue: 0,0:19:34.34,0:19:37.41,Default,,0,0,0,,Мен солай ойлаймын!
Dialogue: 0,0:19:37.41,0:19:40.84,Default,,0,0,0,,Бұл өте ыңғайлы.
Dialogue: 0,0:19:40.84,0:19:43.18,Default,,0,0,0,,Мен мүлдем алданып қалдым➡
Dialogue: 0,0:19:43.18,0:19:46.25,Default,,0,0,0,,Мен оның жер астында екенін толық түсіндім➡
Dialogue: 0,0:19:46.25,0:19:49.68,Default,,0,0,0,,Мен мұндай үлкен ала аң болады деп ойламаппын.
Dialogue: 0,0:19:49.68,0:19:52.35,Default,,0,0,0,,Иә? Ойланып көрейікші
Dialogue: 0,0:19:52.35,0:19:54.69,Default,,0,0,0,,Біз бетперде киген емеспіз.
Dialogue: 0,0:19:54.69,0:19:56.69,Default,,0,0,0,,Неліктен қауіпсізсіз?
Dialogue: 0,0:19:56.69,0:19:58.69,Default,,0,0,0,,Ала аң сияқты үлкен
Dialogue: 0,0:19:58.69,0:20:01.86,Default,,0,0,0,,Ол көптеген зиянды заттарды шығаруы керек болса да
Dialogue: 0,0:20:01.86,0:20:03.86,Default,,0,0,0,,Оған бар күшімді салуым керек.
Dialogue: 0,0:20:03.86,0:20:07.74,Default,,0,0,0,,Жарайды, бұл ерекше дара болғандықтан ғана айта аламын.
Dialogue: 0,0:20:12.14,0:20:14.98,Default,,0,0,0,,Олай болса, аздап тезірек алайық.
Dialogue: 0,0:20:14.98,0:20:18.31,Default,,0,0,0,,Біз бәріміз көкке ұшамыз.
Dialogue: 0,0:20:18.31,0:20:22.32,Default,,0,0,0,,Нені білгіңіз келеді, кейін не істегіңіз келеді
Dialogue: 0,0:20:22.32,0:20:25.79,Default,,0,0,0,,Аға, жұмыс ауыр...
Dialogue: 0,0:20:27.32,0:20:29.32,Default,,0,0,0,,(терең тыныс алу)
Dialogue: 0,0:20:29.32,0:20:33.59,Default,,0,0,0,,Хун
Dialogue: 0,0:20:34.83,0:20:37.83,Default,,0,0,0,,Онда менің одан тез құтылудан басқа амалым жоқ.
Dialogue: 0,0:20:37.83,0:20:39.90,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:20:39.90,0:20:42.34,Default,,0,0,0,,Иә? Оны неге байлайсың?
Dialogue: 0,0:20:42.34,0:20:44.84,Default,,0,0,0,,Уряаа~!
Dialogue: 0,0:20:44.84,0:20:47.81,Default,,0,0,0,,Не, мен лақтырдым! ? Гуну
Dialogue: 0,0:20:51.91,0:20:54.18,Default,,0,0,0,,Сол монах
Dialogue: 0,0:20:54.18,0:20:57.52,Default,,0,0,0,,Сіз шынымен қабырғаны бұзып өтуге тырысып жатырсыз ба? ?
Dialogue: 0,0:20:57.52,0:20:59.69,Default,,0,0,0,,Хмм!
Dialogue: 0,0:21:14.14,0:21:16.80,Default,,0,0,0,,Брат Сәлем Брат.
Dialogue: 0,0:21:16.80,0:21:19.31,Default,,0,0,0,,Тез тоқтатыңыз!
Dialogue: 0,0:21:19.31,0:21:23.64,Default,,0,0,0,,Бала сүйкімді болса да, оған шындықты үйретпе.
Dialogue: 0,0:21:23.64,0:21:26.15,Default,,0,0,0,,Артық қорғану балаларға улы.
Dialogue: 0,0:21:26.15,0:21:28.82,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:28.82,0:21:31.89,Default,,0,0,0,,Бала жалғастыруға жақын болған кезде
Dialogue: 0,0:21:31.89,0:21:35.82,Default,,0,0,0,,Тоқта, менің ойымша, үлкендер улырақ.
Dialogue: 0,0:21:35.82,0:21:40.33,Default,,0,0,0,,Және өсу дыбыстарын тыңдау.
Dialogue: 0,0:21:40.33,0:21:43.00,Default,,0,0,0,,Бұл өте жақсы, солай емес пе?
Dialogue: 0,0:21:43.00,0:21:45.83,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:45.83,0:21:48.17,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:21:48.17,0:21:50.17,Default,,0,0,0,,Уф
Dialogue: 0,0:21:50.17,0:21:56.84,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:21:56.84,0:22:00.92,Default,,0,0,0,,(емізік сору)
Dialogue: 0,0:22:02.28,0:22:04.95,Default,,0,0,0,,Қарсыласыңызға соғұрлым көп соққы берсеңіз
Dialogue: 0,0:22:04.95,0:22:08.29,Default,,0,0,0,,Қарсыласыңыздан күшті жұтып, күштірек болыңыз
Dialogue: 0,0:22:08.29,0:22:10.26,Default,,0,0,0,,Ағызу
Dialogue: 0,0:22:12.79,0:22:14.86,Default,,0,0,0,,Бұл Диа➡
Dialogue: 0,0:22:14.86,0:22:18.13,Default,,0,0,0,,Орталықтанушылық қабілеті
Dialogue: 0,0:22:18.13,0:22:20.13,Default,,0,0,0,,Мм!
Dialogue: 0,0:22:20.13,0:22:22.14,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:22:22.14,0:22:24.10,Default,,0,0,0,,(Қабырғаның құлаған дыбысы)
Dialogue: 0,0:22:25.21,0:22:37.69,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:39.19,0:22:44.19,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
