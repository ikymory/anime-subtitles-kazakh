Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Ха ха ха ха ха…
Dialogue: 0,0:00:05.97,0:00:30.49,Default,,0,0,0,,(Джаббар Занка күледі)
Dialogue: 0,0:00:32.33,0:00:36.33,Default,,0,0,0,,Қызық аяқталуға жақын➡
Dialogue: 0,0:00:36.33,0:00:39.33,Default,,0,0,0,,Занка-кун ха ха ха ха ха
Dialogue: 0,0:00:43.34,0:00:45.34,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:00:45.34,0:00:49.04,Default,,0,0,0,,Мен ала аңға құрбандыққа барайын ба?
Dialogue: 0,0:00:50.35,0:00:53.68,Default,,0,0,0,,Хаха хехе...
Dialogue: 0,0:00:53.68,0:00:56.18,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:59.35,0:01:04.86,Default,,0,0,0,,Жаббар-кун, сен тапсырмаңды жақсы орындадың.
Dialogue: 0,0:01:09.63,0:01:11.97,Default,,0,0,0,,Төрт!
Dialogue: 0,0:01:11.97,0:01:16.07,Default,,0,0,0,,Мен бастықтың сыйлығын асыға күтемін.
Dialogue: 0,0:01:17.14,0:01:19.34,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:21.31,0:01:23.51,Default,,0,0,0,,Польнареффтің қылышынан да жылдам болды. Құдай-ай!》
Dialogue: 0,0:01:27.48,0:01:29.48,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:01:29.48,0:01:31.99,Default,,0,0,0,,Ома не! ?
Dialogue: 0,0:01:31.99,0:02:26.01,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:13.62,0:03:17.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:21.46,0:03:23.63,Default,,0,0,0,,Қауіпті➡
Dialogue: 0,0:03:23.63,0:03:27.47,Default,,0,0,0,,Қауіпті Қауіпті Қауіпті ➡
Dialogue: 0,0:03:27.47,0:03:30.64,Default,,0,0,0,,Бұл қауіпті. Бұл қауіпті. Иә?
Dialogue: 0,0:03:30.64,0:03:34.81,Default,,0,0,0,,Мүмкін есеп айырысу басталып кеткен шығар.
Dialogue: 0,0:03:34.81,0:03:37.65,Default,,0,0,0,,Мен... мен... асығуым керек.
Dialogue: 0,0:03:37.65,0:03:40.98,Default,,0,0,0,,Дикке айналайын
Dialogue: 0,0:03:40.98,0:03:44.65,Default,,0,0,0,,Бірақ, бірақ менен?
Dialogue: 0,0:03:44.65,0:03:48.66,Default,,0,0,0,,Мен ұрысты қалай бастарымды білмеймін.
Dialogue: 0,0:03:48.66,0:03:50.99,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:03:50.99,0:03:52.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:52.99,0:03:55.16,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:03:55.16,0:03:58.50,Default,,0,0,0,,Ух, уһ, онии-сан... оныи-сан
Dialogue: 0,0:03:58.50,0:04:00.44,Default,,0,0,0,,Onionii-san?
Dialogue: 0,0:04:00.44,0:04:02.77,Default,,0,0,0,,Менің атым, мм.
Dialogue: 0,0:04:02.77,0:04:04.77,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:04.77,0:04:08.11,Default,,0,0,0,,О, бұл Фу Оростор деп аталады.
Dialogue: 0,0:04:08.11,0:04:10.61,Default,,0,0,0,,Тор?
Dialogue: 0,0:04:10.61,0:04:13.45,Default,,0,0,0,,Жүр, мен қозғалтқышпын.
Dialogue: 0,0:04:13.45,0:04:16.12,Default,,0,0,0,,Иә! Фуфуфуу
Dialogue: 0,0:04:16.12,0:04:18.62,Default,,0,0,0,,Фуууууу...
Dialogue: 0,0:04:18.62,0:04:21.62,Default,,0,0,0,,Мен... Мен Зодилмін.
Dialogue: 0,0:04:21.62,0:04:24.29,Default,,0,0,0,,Бастық маған бірдеңе айтты.
Dialogue: 0,0:04:24.29,0:04:28.13,Default,,0,0,0,,Мен өзіммен бірге келген тазалаушыға ұсыныс жасауым керек...
Dialogue: 0,0:04:28.13,0:04:30.47,Default,,0,0,0,,Бірақ
Dialogue: 0,0:04:30.47,0:04:32.47,Default,,0,0,0,,<Ұсыну? ＞
Dialogue: 0,0:04:32.47,0:04:34.64,Default,,0,0,0,,Мен мұны істей аламын➡
Dialogue: 0,0:04:34.64,0:04:38.97,Default,,0,0,0,,Маған оны басқа тролльдерге қарағанда тезірек аяқтау керектігін айтты.
Dialogue: 0,0:04:38.97,0:04:42.58,Default,,0,0,0,,Шаршасаңыз...
Dialogue: 0,0:04:46.48,0:04:49.15,Default,,0,0,0,,Hiii…➡
Dialogue: 0,0:04:49.15,0:04:51.82,Default,,0,0,0,,Аа, сондықтан~➡
Dialogue: 0,0:04:51.82,0:04:54.49,Default,,0,0,0,,Тезірек төбелесіңіз~➡
Dialogue: 0,0:04:54.49,0:04:57.16,Default,,0,0,0,,Ммммммм~ Нги~➡
Dialogue: 0,0:04:57.16,0:05:01.06,Default,,0,0,0,,Ммм... Бұл... Нги~
Dialogue: 0,0:05:01.93,0:05:06.54,Default,,0,0,0,,Әзірге неге бірінші мені ұрмайсың?
Dialogue: 0,0:05:10.94,0:05:14.44,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:14.44,0:05:18.55,Default,,0,0,0,,Хмм?
Dialogue: 0,0:05:20.12,0:05:22.12,Default,,0,0,0,,Нихи!
Dialogue: 0,0:05:22.12,0:05:25.62,Default,,0,0,0,,Хехе... ЖОҚ.
Dialogue: 0,0:05:25.62,0:05:27.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:29.79,0:05:41.50,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:06:07.60,0:06:10.50,Default,,0,0,0,,Ммм...
Dialogue: 0,0:06:24.28,0:06:28.45,Default,,0,0,0,,Шашыңды жел ұшырмасын
Dialogue: 0,0:06:28.45,0:06:32.25,Default,,0,0,0,,Ол қанша уақытқа дейін жарамды болады?
Dialogue: 0,0:06:48.30,0:06:50.81,Default,,0,0,0,,Ах Теми
Dialogue: 0,0:06:50.81,0:06:54.01,Default,,0,0,0,,Сіз Ассиге бет бұрып жатырсыз ба?
Dialogue: 0,0:07:00.75,0:07:02.92,Default,,0,0,0,,Гунуну➡
Dialogue: 0,0:07:02.92,0:07:04.92,Default,,0,0,0,,Ашулы әйел➡
Dialogue: 0,0:07:04.92,0:07:07.42,Default,,0,0,0,,Жасырын жасырыну
Dialogue: 0,0:07:09.76,0:07:13.93,Default,,0,0,0,,Сіз тосын шабуылды көздеп отырсыз ба?
Dialogue: 0,0:07:13.93,0:07:16.43,Default,,0,0,0,,Иә
Dialogue: 0,0:07:16.43,0:07:20.27,Default,,0,0,0,,Жылтыр және тітіркендіргіш
Dialogue: 0,0:07:20.27,0:07:23.94,Default,,0,0,0,,Мен сен сияқты әйелдерді жек көремін!
Dialogue: 0,0:07:23.94,0:07:26.11,Default,,0,0,0,,Қазір шық.
Dialogue: 0,0:07:26.11,0:07:28.44,Default,,0,0,0,,Сіз де күресуді таңдадыңыз.
Dialogue: 0,0:07:28.44,0:07:30.45,Default,,0,0,0,,Ол жауынгер болуы керек!
Dialogue: 0,0:07:30.45,0:07:35.45,Default,,0,0,0,,Жауынгер болсаң, бетпе-бет соғыс!
Dialogue: 0,0:07:35.45,0:07:38.95,Default,,0,0,0,,Әй, жарасады.
Dialogue: 0,0:07:38.95,0:07:42.62,Default,,0,0,0,,Сіздің уақытыңыз!
Dialogue: 0,0:07:42.62,0:07:45.79,Default,,0,0,0,,Уақыт шегі бар, солай ма?
Dialogue: 0,0:07:45.79,0:07:47.80,Default,,0,0,0,,На
Dialogue: 0,0:07:51.30,0:07:53.30,Default,,0,0,0,,<Жалтырылды ма? ＞
Dialogue: 0,0:07:53.30,0:07:55.30,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:07:56.64,0:07:59.04,Default,,0,0,0,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,0:08:08.25,0:08:11.59,Default,,0,0,0,,(қан құсу)
Dialogue: 0,0:08:11.59,0:08:15.42,Default,,0,0,0,,Шашымды екі рет қиюға рұқсат етемін деп ойлама.
Dialogue: 0,0:08:15.42,0:08:21.10,Default,,0,0,0,,Сіз өкшелі аяқ киім киюге үйренгеннен кейін, қарқынды латын билерін орындауға болады.
Dialogue: 0,0:08:21.10,0:08:26.94,Default,,0,0,0,,Асси бұл шашты жүйке сияқты еркін қозғалта алады.
Dialogue: 0,0:08:26.94,0:08:29.94,Default,,0,0,0,,Ұзын шаш киіп жүргеніңізге неше жыл болды?
Dialogue: 0,0:08:29.94,0:08:32.27,Default,,0,0,0,,Оны жалама
Dialogue: 0,0:08:34.44,0:08:36.78,Default,,0,0,0,,Бұл ақылсыз
Dialogue: 0,0:08:36.78,0:08:39.61,Default,,0,0,0,,Шашы ұзын, мақтаншақ жігіт.
Dialogue: 0,0:08:39.61,0:08:41.62,Default,,0,0,0,,Бұл менің бірінші рет.
Dialogue: 0,0:08:41.62,0:08:44.45,Default,,0,0,0,,Бірақ сіз оқып жатқанда➡
Dialogue: 0,0:08:44.45,0:08:49.62,Default,,0,0,0,,Осы Мирай өндіретін статикалық электр қуатының уақыт шегі бар.
Dialogue: 0,0:08:49.62,0:08:52.29,Default,,0,0,0,,Өз еркімен жоюға болады
Dialogue: 0,0:08:52.29,0:08:56.80,Default,,0,0,0,,Қанша уақыт ұстасаңыз да, ол бар болғаны 1-2 минутты алады.
Dialogue: 0,0:08:56.80,0:08:59.80,Default,,0,0,0,,Бұл бір өлшемді емес.
Dialogue: 0,0:08:59.80,0:09:03.24,Default,,0,0,0,,Түсіндім, бұл жақсы~
Dialogue: 0,0:09:03.24,0:09:07.41,Default,,0,0,0,,Мен де желдің әлсіздігі болуы мүмкін екенін қарастырдым.
Dialogue: 0,0:09:07.41,0:09:12.21,Default,,0,0,0,,Мен жел диірменін жылжытуым керек шығар деп біраз уайымдадым.
Dialogue: 0,0:09:13.42,0:09:16.58,Default,,0,0,0,,Уақыт шектеуі - бұл әлсіздік және көмектеседі
Dialogue: 0,0:09:16.58,0:09:18.75,Default,,0,0,0,,Шынымен бе…
Dialogue: 0,0:09:18.75,0:09:21.76,Default,,0,0,0,,Сен өте позитивтісің, Риу.
Dialogue: 0,0:09:21.76,0:09:24.93,Default,,0,0,0,,Тек әлсіз жақтарын жабу арқылы
Dialogue: 0,0:09:24.93,0:09:27.43,Default,,0,0,0,,Мен жауынгер болсам да
Dialogue: 0,0:09:37.77,0:09:40.98,Default,,0,0,0,,Nerde Anta Сіздің бұрынғы жұмысыңыз қандай еді?
Dialogue: 0,0:09:43.61,0:09:46.95,Default,,0,0,0,,Оңтүстіктегі әйелдер ауылы
Dialogue: 0,0:09:46.95,0:09:50.12,Default,,0,0,0,,Соғысушы тайпалар
Dialogue: 0,0:09:50.12,0:09:53.29,Default,,0,0,0,,Силея
Dialogue: 0,0:09:53.29,0:09:55.96,Default,,0,0,0,,Кешіріңіз, мен білмеймін.
Dialogue: 0,0:09:55.96,0:09:59.13,Default,,0,0,0,,Сіз білмегеніңіз таңқаларлық емес.
Dialogue: 0,0:09:59.13,0:10:03.03,Default,,0,0,0,,Ол баяғыда өлді!
Dialogue: 0,0:10:08.80,0:10:13.98,Default,,0,0,0,,Сіз де, бұл сіздің үлкен табыстарыңызға сәйкес келмейтін қадам.
Dialogue: 0,0:10:13.98,0:10:17.65,Default,,0,0,0,,Хмм? Хаха
Dialogue: 0,0:10:17.65,0:10:21.48,Default,,0,0,0,,Пропорционалды емес.
Dialogue: 0,0:10:21.48,0:10:25.09,Default,,0,0,0,,Бірақ шын мәнінде мен де
Dialogue: 0,0:10:26.15,0:10:28.49,Default,,0,0,0,,Жалғыз күрескен жақсы
Dialogue: 0,0:10:28.49,0:10:30.99,Default,,0,0,0,,Мен мұны жақсы білемін
Dialogue: 0,0:10:33.33,0:10:36.16,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:10:36.16,0:10:38.67,Default,,0,0,0,,Бұл Риу
Dialogue: 0,0:10:51.18,0:10:53.18,Default,,0,0,0,,Хмф!
Dialogue: 0,0:10:59.52,0:11:03.32,Default,,0,0,0,,«Сиркемен өзін-өзі өлтіру оқиғасы»
Dialogue: 0,0:11:43.33,0:11:45.33,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:46.67,0:11:49.00,Default,,0,0,0,,Уф
Dialogue: 0,0:11:49.00,0:11:51.01,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:00.62,0:12:02.62,Default,,0,0,0,,Хмф! Уф
Dialogue: 0,0:12:04.95,0:12:07.06,Default,,0,0,0,,Гуну
Dialogue: 0,0:12:08.12,0:12:10.12,Default,,0,0,0,,Иә
Dialogue: 0,0:12:21.30,0:12:23.30,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:33.48,0:12:52.00,Default,,0,0,0,,«Сиркемен өзін-өзі өлтіру оқиғасы»
Dialogue: 0,0:12:58.67,0:13:12.29,Default,,0,0,0,,Сәлем, сәлем, танысқаныма қуаныштымын
Dialogue: 0,0:13:12.29,0:13:15.29,Default,,0,0,0,,Бұл котенка емес еді хаха хаа
Dialogue: 0,0:13:15.29,0:13:19.63,Default,,0,0,0,,(қан құсу)
Dialogue: 0,0:13:19.63,0:13:21.63,Default,,0,0,0,,Бірақ
Dialogue: 0,0:13:21.63,0:13:24.80,Default,,0,0,0,,Бұл мысықтың ауқымында.
Dialogue: 0,0:13:24.80,0:13:30.30,Default,,0,0,0,,Сәлем, сәлем, танысқаныма қуаныштымын
Dialogue: 0,0:13:30.30,0:13:32.31,Default,,0,0,0,,Эй
Dialogue: 0,0:13:32.31,0:13:36.14,Default,,0,0,0,,Көмекке қанша шақырсам да естімейсің бе?
Dialogue: 0,0:13:36.14,0:13:38.15,Default,,0,0,0,,А, пайдасы жоқ.
Dialogue: 0,0:13:38.15,0:13:40.82,Default,,0,0,0,,Енді қаша алмайсың.
Dialogue: 0,0:13:40.82,0:13:43.48,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:43.48,0:13:46.82,Default,,0,0,0,,Сіз естімейсіз бе...
Dialogue: 0,0:13:46.82,0:13:50.33,Default,,0,0,0,,Уайымдамаңыз, бұл біткенде➡
Dialogue: 0,0:13:50.33,0:13:53.16,Default,,0,0,0,,Мен достарыммен құрбандыққа барамын.
Dialogue: 0,0:13:53.16,0:13:56.00,Default,,0,0,0,,(Рию дайын тұрады)
Dialogue: 0,0:13:56.00,0:13:58.00,Default,,0,0,0,,Эй
Dialogue: 0,0:13:58.00,0:14:00.80,Default,,0,0,0,,(Екі мылтық ату)
Dialogue: 0,0:14:18.62,0:14:28.96,Default,,0,0,0,,Сәлем, сәлем, танысқаныма қуаныштымын
Dialogue: 0,0:14:28.96,0:14:30.97,Default,,0,0,0,,Уф
Dialogue: 0,0:14:30.97,0:14:38.81,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:14:38.81,0:14:41.01,Default,,0,0,0,,Ах
Dialogue: 0,0:14:42.98,0:14:44.98,Default,,0,0,0,,(Риёу мылтық ұстайды)
Dialogue: 0,0:14:44.98,0:14:46.98,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:14:46.98,0:14:50.15,Default,,0,0,0,,Неліктен олай істедің?
Dialogue: 0,0:14:50.15,0:14:53.15,Default,,0,0,0,,Қозғалтқыш бұған тыйым сала ма?
Dialogue: 0,0:14:53.15,0:14:55.49,Default,,0,0,0,,Кісі өлтіру Уф
Dialogue: 0,0:14:55.49,0:14:59.49,Default,,0,0,0,,Сондықтан да сен өліп қалмау үшін қатты күрестің ғой, солай ма?
Dialogue: 0,0:14:59.49,0:15:03.60,Default,,0,0,0,,Бірақ сен мықтысың, сондықтан мен осыны қолдандым.
Dialogue: 0,0:15:04.60,0:15:07.60,Default,,0,0,0,,Бақытымызға орай, мен дыбысты естімей тұрған сияқтымын➡
Dialogue: 0,0:15:07.60,0:15:11.77,Default,,0,0,0,,Мен оны тез бітіргім келеді.
Dialogue: 0,0:15:11.77,0:15:15.44,Default,,0,0,0,,Достар жаулардан қорғалуы керек
Dialogue: 0,0:15:15.44,0:15:17.61,Default,,0,0,0,,Негізгі дене қайда өзі?
Dialogue: 0,0:15:17.61,0:15:21.95,Default,,0,0,0,,Уайымдама, ол қайшы сенің жалғыз адамдық қаруың➡
Dialogue: 0,0:15:21.95,0:15:25.95,Default,,0,0,0,,Ол қайшы енді ешқашан қанға боялмайды➡
Dialogue: 0,0:15:25.95,0:15:28.79,Default,,0,0,0,,Баяғыда осылай ант еткенмін➡
Dialogue: 0,0:15:28.79,0:15:32.79,Default,,0,0,0,,Бұл бұрынғы жұмысымдағы бастығым маған берген мылтық➡
Dialogue: 0,0:15:32.79,0:15:35.46,Default,,0,0,0,,Бұл қоштасу сыйы.
Dialogue: 0,0:15:35.46,0:15:38.47,Default,,0,0,0,,Бұл сіз емессіз➡
Dialogue: 0,0:15:38.47,0:15:40.47,Default,,0,0,0,,Ассасин
Dialogue: 0,0:15:48.31,0:15:53.01,Default,,0,0,0,,Бұл біз үшін ғана құпия.
Dialogue: 0,0:15:53.98,0:15:58.32,Default,,0,0,0,,Бір жақсысы, менің үстімде мотор жағасы бар➡
Dialogue: 0,0:15:58.32,0:16:00.76,Default,,0,0,0,,Сіз аман қаласыз, солай ма? ➡
Dialogue: 0,0:16:00.76,0:16:04.26,Default,,0,0,0,,Сіз қозғала алмайсыз, бірақ маңызды бөліктер жойылды➡
Dialogue: 0,0:16:04.26,0:16:07.46,Default,,0,0,0,,Сол кәріз баласынан сізге көмектесуін сұраңыз.
Dialogue: 0,0:16:09.26,0:16:13.47,Default,,0,0,0,,Мен басқа достарымды іздеймін.
Dialogue: 0,0:16:14.44,0:16:16.44,Default,,0,0,0,,Уф
Dialogue: 0,0:16:17.44,0:16:20.27,Default,,0,0,0,,Менің қайда екенімді білесің бе?
Dialogue: 0,0:16:20.27,0:16:23.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:30.28,0:16:32.49,Default,,0,0,0,,Иә
Dialogue: 0,0:16:39.79,0:16:42.80,Default,,0,0,0,,Орналасқан жері: Құдықтағы бала➡
Dialogue: 0,0:16:42.80,0:16:46.10,Default,,0,0,0,,Тек қана вандалдық бастық біледі...
Dialogue: 0,0:16:47.13,0:16:51.14,Default,,0,0,0,,Бұл құбырлар қан тамырлары сияқты жалғанған сияқты➡
Dialogue: 0,0:16:51.14,0:16:54.54,Default,,0,0,0,,Іздеу өте қиын
Dialogue: 0,0:17:12.59,0:17:16.93,Default,,0,0,0,,《Мен Людо туралы көбірек білгім келеді... солай ма? 》
Dialogue: 0,0:17:16.93,0:17:18.93,Default,,0,0,0,,《А, а...》
Dialogue: 0,0:17:20.10,0:17:23.50,Default,,0,0,0,,Людо жағдайдың қалай болатынын әлі білмейді.
Dialogue: 0,0:17:33.78,0:17:36.78,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:43.96,0:17:45.96,Default,,0,0,0,,《Қозғалтқыш》
Dialogue: 0,0:17:45.96,0:17:50.80,Default,,0,0,0,,《Олай болса, мен барып оның айтқанын тыңдауым керек пе? 》
Dialogue: 0,0:17:50.80,0:17:54.30,Default,,0,0,0,,《Қол созуды үйренейік》
Dialogue: 0,0:17:55.30,0:17:57.61,Default,,0,0,0,,《Бірге》
Dialogue: 0,0:18:01.24,0:18:03.24,Default,,0,0,0,,Хух➡
Dialogue: 0,0:18:03.24,0:18:06.75,Default,,0,0,0,,Ол қызды жалғыз қалдыруым керек еді.
Dialogue: 0,0:18:10.75,0:18:13.42,Default,,0,0,0,,Ома не! ?
Dialogue: 0,0:18:13.42,0:18:16.92,Default,,0,0,0,,Гуаааааааааааа
Dialogue: 0,0:18:19.09,0:18:21.50,Default,,0,0,0,,(Джаббар құлады)
Dialogue: 0,0:18:26.10,0:18:30.94,Default,,0,0,0,,Аа... аа аа аа аа аа га ха
Dialogue: 0,0:18:30.94,0:18:34.44,Default,,0,0,0,,Қыңырсың, өлмейсің.
Dialogue: 0,0:18:34.44,0:18:36.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:39.78,0:18:43.48,Default,,0,0,0,,Занка, жақсысың ба?
Dialogue: 0,0:18:44.79,0:18:47.29,Default,,0,0,0,,Сәлем➡
Dialogue: 0,0:18:47.29,0:18:51.63,Default,,0,0,0,,Ааа, сенің тірі болғаныңа қуаныштымын~➡
Dialogue: 0,0:18:51.63,0:18:55.63,Default,,0,0,0,,Сіз қандай да бір қауіпті уланудан уландыңыз ба? ➡
Dialogue: 0,0:18:55.63,0:18:59.13,Default,,0,0,0,,Торамакокодан шығайық➡
Dialogue: 0,0:18:59.13,0:19:01.34,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:19:02.40,0:19:04.57,Default,,0,0,0,,Хи хи➡
Dialogue: 0,0:19:04.57,0:19:08.58,Default,,0,0,0,,Үйге ертерек барып, жөндеп алайық.
Dialogue: 0,0:19:14.75,0:19:17.75,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:19:25.26,0:19:27.60,Default,,0,0,0,,Джаббар жеңді➡
Dialogue: 0,0:19:27.60,0:19:29.76,Default,,0,0,0,,Нелде жоғалды➡
Dialogue: 0,0:19:29.76,0:19:33.10,Default,,0,0,0,,Себебі тазалаушының қолшатыр пайдаланушысы алдымен Фуға шабуыл жасамайды➡
Dialogue: 0,0:19:33.10,0:19:35.77,Default,,0,0,0,,Әлі ұрысқан жоқпын➡
Dialogue: 0,0:19:35.77,0:19:38.44,Default,,0,0,0,,Бундус ата-ана мен бала сияқты адаммен сөйлеседі➡
Dialogue: 0,0:19:38.44,0:19:43.28,Default,,0,0,0,,Мен тазалаушының бастығы туралы ақпарат алуға тырысамын.
Dialogue: 0,0:19:43.28,0:19:45.95,Default,,0,0,0,,Людо Уф
Dialogue: 0,0:19:45.95,0:19:49.28,Default,,0,0,0,,Тазартқыштар мен ойлағаннан да қатал.
Dialogue: 0,0:19:49.28,0:19:52.62,Default,,0,0,0,,Сіз нені айтасыз? Басқаларына не болды?
Dialogue: 0,0:19:52.62,0:19:55.52,Default,,0,0,0,,Қозғалу уақыты келді ме?
Dialogue: 0,0:19:58.79,0:20:01.13,Default,,0,0,0,,Уф
Dialogue: 0,0:20:01.13,0:20:03.80,Default,,0,0,0,,Уф.
Dialogue: 0,0:20:03.80,0:20:05.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:05.97,0:20:07.97,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:20:15.31,0:20:19.48,Default,,0,0,0,,Жақсы... Kusso Temee және т.б.
Dialogue: 0,0:20:19.48,0:20:22.32,Default,,0,0,0,,Оны мұнда және мұнда тастау
Dialogue: 0,0:20:22.32,0:20:25.99,Default,,0,0,0,,Бұл қай жер? Мұнда келу себебі мен мақсаты
Dialogue: 0,0:20:25.99,0:20:28.82,Default,,0,0,0,,Барлығы түсініксіз.
Dialogue: 0,0:20:28.82,0:20:31.66,Default,,0,0,0,,Цк, әлгі боқ сені ұшырып жібереді!
Dialogue: 0,0:20:31.66,0:20:34.16,Default,,0,0,0,,Жақсы, әбігерге түспесең➡
Dialogue: 0,0:20:34.16,0:20:37.00,Default,,0,0,0,,Сіз тыныштала алмайсыз ба?
Dialogue: 0,0:20:37.00,0:20:39.50,Default,,0,0,0,,Мен оны бір рет ұсындым.
Dialogue: 0,0:20:39.50,0:20:43.84,Default,,0,0,0,,Аспанды бірге түсіреміз бе? және
Dialogue: 0,0:20:43.84,0:20:48.01,Default,,0,0,0,,Қазір істеу керек нәрсе - бос әңгіме емес.
Dialogue: 0,0:20:48.01,0:20:52.51,Default,,0,0,0,,Бұған қалай жауап беру керектігін ойлайтын ми.
Dialogue: 0,0:20:53.85,0:20:59.35,Default,,0,0,0,,Сіз бәрін нөлден бастап түсіндірмейінше әрекет ете алмайтындардың бірісіз бе?
Dialogue: 0,0:20:59.35,0:21:02.79,Default,,0,0,0,,Суретті кітап дайындау керек пе?
Dialogue: 0,0:21:02.79,0:21:04.79,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:21:04.79,0:21:08.13,Default,,0,0,0,,Менің түсінгенім осы ғана.
Dialogue: 0,0:21:08.13,0:21:10.80,Default,,0,0,0,,Сен мен жек көретін түріңсің!
Dialogue: 0,0:21:10.80,0:21:13.97,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:21:13.97,0:21:18.64,Default,,0,0,0,,Ол салқынырақ аспандық адамға түсіп кетсе екен.
Dialogue: 0,0:21:18.64,0:21:22.64,Default,,0,0,0,,Хауа хауауава
Dialogue: 0,0:21:22.64,0:21:24.81,Default,,0,0,0,,Джиджи Джижи
Dialogue: 0,0:21:24.81,0:21:28.62,Default,,0,0,0,,Аспанға деген жоспарларыңыз туралы сұраудың қажеті жоқ.
Dialogue: 0,0:21:29.82,0:21:33.15,Default,,0,0,0,,Онда мен саған көрсетемін
Dialogue: 0,0:21:33.15,0:21:35.36,Default,,0,0,0,,Ах
Dialogue: 0,0:21:45.33,0:21:48.14,Default,,0,0,0,,Ки-иииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииииии
Dialogue: 0,0:21:51.01,0:21:54.34,Default,,0,0,0,,Сақтаушылардың қатары
Dialogue: 0,0:21:54.34,0:21:56.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:57.51,0:22:00.45,Default,,0,0,0,,Людоның қолғаптары➡
Dialogue: 0,0:22:00.45,0:22:03.28,Default,,0,0,0,,Менің пальтоым➡
Dialogue: 0,0:22:03.28,0:22:06.09,Default,,0,0,0,,Ал мына аяқ киім
Dialogue: 0,0:22:07.45,0:22:13.96,Default,,0,0,0,,Мен Keeper сериясын жасауға тырыстым.
Dialogue: 0,0:22:13.96,0:22:18.57,Default,,0,0,0,,(Алып ала аңның дауысы)
Dialogue: 0,0:22:19.97,0:23:47.99,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:49.49,0:23:54.49,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
