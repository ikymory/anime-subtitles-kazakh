Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.84,0:00:10.67,Default,,0,0,0,,Соққы пайдалы➡
Dialogue: 0,0:00:10.67,0:00:14.74,Default,,0,0,0,,Адамның ішкі жан дүниесін зорлықпен сыртқа шығарады
Dialogue: 0,0:00:14.74,0:00:20.02,Default,,0,0,0,,Маған көрсет! Ішінде жасырылған қатыгездік
Dialogue: 0,0:00:20.02,0:00:22.02,Default,,0,0,0,,(Польнарефф) Ә? Бұл не? Бұл жабысқақ не?
Dialogue: 0,0:00:22.02,0:00:25.02,Default,,0,0,0,,Немесе есеңгіреу➡
Dialogue: 0,0:00:25.02,0:00:27.86,Default,,0,0,0,,Рафт ұсақталған
Dialogue: 0,0:00:35.20,0:00:37.47,Default,,0,0,0,,Өлме!
Dialogue: 0,0:00:46.28,0:00:49.04,Default,,0,0,0,,Қатты➡
Dialogue: 0,0:00:49.04,0:00:51.01,Default,,0,0,0,,Тұтастық
Dialogue: 0,0:00:52.05,0:00:54.55,Default,,0,0,0,,Біздің Нижику руы
Dialogue: 0,0:00:54.55,0:00:58.22,Default,,0,0,0,,Ұрпақтан ұрпаққа жалғасып келе жатқан асқақ қан
Dialogue: 0,0:00:58.22,0:01:02.39,Default,,0,0,0,,Әпкең, ағаң, мен де.
Dialogue: 0,0:01:02.39,0:01:04.39,Default,,0,0,0,,Түрме түлегі болды➡
Dialogue: 0,0:01:04.39,0:01:08.16,Default,,0,0,0,,Осы төменгі әлемді басқару рөлін алыңыз➡
Dialogue: 0,0:01:08.16,0:01:11.67,Default,,0,0,0,,Менің не айтқым келгенін білесің бе? ➡
Dialogue: 0,0:01:11.67,0:01:13.64,Default,,0,0,0,,Занка
Dialogue: 0,0:01:16.74,0:01:18.71,Default,,0,0,0,,Иә
Dialogue: 0,0:01:34.69,0:01:38.19,Default,,0,0,0,,⚟Төменгі әлемде қауіп төндіретін заттар➡
Dialogue: 0,0:01:38.19,0:01:41.86,Default,,0,0,0,,Бұл қоқыс жаңбыры➡
Dialogue: 0,0:01:41.86,0:01:45.20,Default,,0,0,0,,Зиянды заттардың әсерінен болатын ауру➡
Dialogue: 0,0:01:45.20,0:01:48.70,Default,,0,0,0,,Бірақ біз ұмытпауымыз керек➡
Dialogue: 0,0:01:48.70,0:01:53.38,Default,,0,0,0,,Ең үлкен қауіп – адам.
Dialogue: 0,0:01:53.38,0:01:57.38,Default,,0,0,0,,Түрме күзетшісі – адамдарды бақылайтын маңызды лауазым➡
Dialogue: 0,0:01:57.38,0:02:02.32,Default,,0,0,0,,Осы орталық түрмеге оқуға түскен сізді не күтіп тұр?
Dialogue: 0,0:02:02.32,0:02:05.39,Default,,0,0,0,,Ауыр сынақтар мен қарсыластар➡
Dialogue: 0,0:02:05.39,0:02:08.39,Default,,0,0,0,,Күшті түрме күзетшісі болу үшін➡
Dialogue: 0,0:02:08.39,0:02:10.99,Default,,0,0,0,,Жарыс үйрен!
Dialogue: 0,0:02:10.99,0:02:14.06,Default,,0,0,0,,⚟Соңында аяқталды. Кәдімгі сөз тіркесі.
Dialogue: 0,0:02:14.06,0:02:17.83,Default,,0,0,0,,Жаңа тыңдаушылардың уақыты келді ме?
Dialogue: 0,0:02:17.83,0:02:21.50,Default,,0,0,0,,Компанияға өте дарынды адам келді деген қауесет бар.
Dialogue: 0,0:02:21.50,0:02:23.51,Default,,0,0,0,,Адам? әйел?
Dialogue: 0,0:02:23.51,0:02:27.34,Default,,0,0,0,,Әйел иә, ол қандай қыз?
Dialogue: 0,0:02:27.34,0:02:29.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:29.68,0:02:34.18,Default,,0,0,0,,Әдеттегідей басқаларға ұқсамайсың, Занка-кун.
Dialogue: 0,0:02:34.18,0:02:36.52,Default,,0,0,0,,Мен жергілікті жер иесінің ұлымын.
Dialogue: 0,0:02:36.52,0:02:38.85,Default,,0,0,0,,Әр түрлі жағдай
Dialogue: 0,0:02:38.85,0:02:40.86,Default,,0,0,0,,⚟Тамаша қан➡
Dialogue: 0,0:02:40.86,0:02:44.36,Default,,0,0,0,,Ниджику отбасы – элиталық отбасы, олардың барлығы түрмеден шыққан.
Dialogue: 0,0:02:44.36,0:02:47.36,Default,,0,0,0,,Мен бұл қысымға көнуге тиіспін.
Dialogue: 0,0:02:47.36,0:02:50.83,Default,,0,0,0,,Үнемі жоғары баға алатын – Занка-кун.
Dialogue: 0,0:02:51.87,0:02:53.87,Default,,0,0,0,,Уф ➡
Dialogue: 0,0:02:53.87,0:02:56.37,Default,,0,0,0,,Қыздар арасында танымал екеніңізге сенімдімін.
Dialogue: 0,0:02:56.37,0:03:01.14,Default,,0,0,0,,⚟Ха, бәрібір сыныпты үздік бітіріп, алтын орындыққа отыратын шығарсың.
Dialogue: 0,0:03:01.14,0:03:05.48,Default,,0,0,0,,⚟Жарайды, біз көмектесе алмаймыз, біз қарапайым адамдармыз➡
Dialogue: 0,0:03:05.48,0:03:08.75,Default,,0,0,0,,Не істесең де, данышпан болсаң жеңе алмайсың.
Dialogue: 0,0:03:12.55,0:03:15.82,Default,,0,0,0,,< Міне! ＞
Dialogue: 0,0:03:25.17,0:03:28.00,Default,,0,0,0,,《Уау! 》
Dialogue: 0,0:03:28.00,0:03:31.07,Default,,0,0,0,,《(Жылдам тыныс алу)》
Dialogue: 0,0:03:37.01,0:03:40.52,Default,,0,0,0,,Ху (аяқ дыбысы)
Dialogue: 0,0:03:40.52,0:03:42.98,Default,,0,0,0,,Тұру
Dialogue: 0,0:03:45.19,0:03:47.46,Default,,0,0,0,,Шешімі
Dialogue: 0,0:03:48.69,0:03:52.76,Default,,0,0,0,,Берушілер жасаған қылмыстар бұл күндері өсуде.
Dialogue: 0,0:03:52.76,0:03:58.53,Default,,0,0,0,,Бұл сіз бергендерге бағынбайтын күшті тұтқынға айналуыңыз керек дегенді білдіреді.
Dialogue: 0,0:03:58.53,0:04:01.14,Default,,0,0,0,,Мұндағылар үш жыл болады➡
Dialogue: 0,0:04:01.14,0:04:03.64,Default,,0,0,0,,Мен қатаң дайындықтан өттім➡
Dialogue: 0,0:04:03.64,0:04:07.64,Default,,0,0,0,,Біз талантты адамдарды қарсы аламыз➡
Dialogue: 0,0:04:07.64,0:04:09.71,Default,,0,0,0,,Ол дерлік сатылып кеткен екен.
Dialogue: 0,0:04:12.31,0:04:14.65,Default,,0,0,0,,⚟Биыл ерекше жағдай ретінде
Dialogue: 0,0:04:14.65,0:04:18.99,Default,,0,0,0,,Біз бұл топқа талантты адамды қосуды шештік➡
Dialogue: 0,0:04:18.99,0:04:23.16,Default,,0,0,0,,Қарашықта өссе де, қабілеті анық.
Dialogue: 0,0:04:36.17,0:05:30.96,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:43.27,0:06:45.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:48.77,0:06:51.24,Default,,0,0,0,,Ах ха...
Dialogue: 0,0:07:03.79,0:07:06.79,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:07:06.79,0:07:09.22,Default,,0,0,0,,Wonderful
Dialogue: 0,0:07:09.22,0:07:13.56,Default,,0,0,0,,Мен сізді бұл топтағылардың бәрінен өтірік шайқаста кенеттен асып түседі деп күтпедім.
Dialogue: 0,0:07:13.56,0:07:16.40,Default,,0,0,0,,Өйткені, оның қабілеті белгілі➡
Dialogue: 0,0:07:16.40,0:07:20.74,Default,,0,0,0,,Алтын орындық арман емес, барыс.
Dialogue: 0,0:07:20.74,0:07:23.51,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:07:32.08,0:07:34.08,Default,,0,0,0,,⚟Бұл не?
Dialogue: 0,0:07:34.08,0:07:38.09,Default,,0,0,0,,⚟Қалада өскеніңді білмеймін, бірақ өкінгендей әрекет ет.
Dialogue: 0,0:07:38.09,0:07:41.92,Default,,0,0,0,,⚟Ұстазым мені бұлай мақтаған емес.
Dialogue: 0,0:07:41.92,0:07:44.99,Default,,0,0,0,,⚟Төмен қарап, бізден бір рет жеңдім деп айтпа.
Dialogue: 0,0:07:44.99,0:07:48.00,Default,,0,0,0,,⚟Ондай дөрекі жекпе-жек стилімен бұлай негізгі жұмыстарды жасай алмайсың➡
Dialogue: 0,0:07:48.00,0:07:50.60,Default,,0,0,0,,Сіз түрмеден шыға аламын деп ойлайсыз ба?
Dialogue: 0,0:07:50.60,0:07:54.44,Default,,0,0,0,,Сондықтан мен ырғағымды жоғалтып, бұл жолы жоғалттым.
Dialogue: 0,0:07:54.44,0:07:56.77,Default,,0,0,0,,⚟Осы стильге үйреніп кетсем ғой➡
Dialogue: 0,0:07:56.77,0:07:59.44,Default,,0,0,0,,Мен соншалықты епті болуға мүмкіндігім бар еді.
Dialogue: 0,0:07:59.44,0:08:04.38,Default,,0,0,0,,Ахахха Негізі бүгін өзімді жақсы сезінбедім.
Dialogue: 0,0:08:04.38,0:08:08.38,Default,,0,0,0,,Бірақ сол Занка да жеңілді, солай ма?
Dialogue: 0,0:08:08.38,0:08:10.89,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:08:10.89,0:08:12.85,Default,,0,0,0,,Занка
Dialogue: 0,0:08:15.22,0:08:18.56,Default,,0,0,0,,Уау, бұл өте күшті болды.
Dialogue: 0,0:08:18.56,0:08:21.06,Default,,0,0,0,,Мен жеңе алмадым
Dialogue: 0,0:08:21.06,0:08:24.13,Default,,0,0,0,,Мен бұрын-соңды көрмеген жекпе-жек стилін көргеніме қуаныштымын.
Dialogue: 0,0:08:24.13,0:08:28.57,Default,,0,0,0,,Менің әлі де дайындығым жоқ.
Dialogue: 0,0:08:28.57,0:08:31.24,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:45.09,0:08:49.76,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:08:52.16,0:08:57.93,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:09:06.61,0:09:09.11,Default,,0,0,0,,《Ggggggghh...》
Dialogue: 0,0:09:09.11,0:09:11.18,Default,,0,0,0,,《Уф》
Dialogue: 0,0:09:11.18,0:09:13.18,Default,,0,0,0,,《Ғұн》
Dialogue: 0,0:09:13.18,0:09:19.19,Default,,0,0,0,,《(Жауынгерлік дыбыс)》
Dialogue: 0,0:09:19.19,0:09:21.19,Default,,0,0,0,,《Кух》
Dialogue: 0,0:09:21.19,0:09:23.19,Default,,0,0,0,,《А... аа! 》
Dialogue: 0,0:09:23.19,0:09:25.16,Default,,0,0,0,,《Уау》
Dialogue: 0,0:09:28.80,0:09:30.80,Default,,0,0,0,,《Пісіру》
Dialogue: 0,0:09:30.80,0:09:32.77,Default,,0,0,0,,《Уф》
Dialogue: 0,0:09:37.31,0:09:39.27,Default,,0,0,0,,《А...》
Dialogue: 0,0:09:41.38,0:09:43.34,Default,,0,0,0,,《Ха》
Dialogue: 0,0:09:47.32,0:09:49.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:49.32,0:09:55.66,Default,,0,0,0,,Сәлем, сәлем, танысқаныма қуаныштымын
Dialogue: 0,0:09:55.66,0:10:00.33,Default,,0,0,0,,Мен жеткілікті тырыспадым.
Dialogue: 0,0:10:00.33,0:10:02.33,Default,,0,0,0,,Мен біріншімін
Dialogue: 0,0:10:02.33,0:10:05.33,Default,,0,0,0,,Мен әлі жеңіле алмаймын
Dialogue: 0,0:10:05.33,0:10:07.77,Default,,0,0,0,,Тамшылап тұр! ?
Dialogue: 0,0:10:07.77,0:10:09.77,Default,,0,0,0,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:10:09.77,0:10:11.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:14.78,0:10:18.78,Default,,0,0,0,,А... мұндай жерде не болып жатыр?
Dialogue: 0,0:10:18.78,0:10:21.28,Default,,0,0,0,,Мен сені қайтадан сыныпқа келдім деп ойладым.
Dialogue: 0,0:10:21.28,0:10:25.05,Default,,0,0,0,,Мен су ішетін жер іздедім.
Dialogue: 0,0:10:28.36,0:10:31.13,Default,,0,0,0,,＜Сабыр сақта＞
Dialogue: 0,0:10:31.13,0:10:34.46,Default,,0,0,0,,Солай бола тұра, мен мұны шынымен жасаймын.
Dialogue: 0,0:10:34.46,0:10:37.43,Default,,0,0,0,,Мен қосыла сала «Алтын орындыққа» үміткер екенімді айтты.
Dialogue: 0,0:10:39.53,0:10:41.97,Default,,0,0,0,,Егер сіз алтын орындыққа немесе басқа нәрсеге отырсаңыз
Dialogue: 0,0:10:41.97,0:10:44.81,Default,,0,0,0,,Бұл не болады? иә?
Dialogue: 0,0:10:44.81,0:10:49.48,Default,,0,0,0,,Ал, түрме түлектерінің аңыздары дейтін адамдар бар.
Dialogue: 0,0:10:49.48,0:10:51.55,Default,,0,0,0,,Ортадағы үлкен адам
Dialogue: 0,0:10:51.55,0:10:55.15,Default,,0,0,0,,Отыруға аты-жөні белгілі адам келді. Бұл орындық емес.
Dialogue: 0,0:10:55.15,0:10:57.82,Default,,0,0,0,,Барлығы мені таң қалдырады
Dialogue: 0,0:10:57.82,0:11:01.99,Default,,0,0,0,,Әпкем бір себептермен отырмаған сияқты.
Dialogue: 0,0:11:01.99,0:11:03.99,Default,,0,0,0,,бірақ манга суретшісінің үйіне алты минут ерте бару—
Dialogue: 0,0:11:03.99,0:11:06.59,Default,,0,0,0,,Орындыққа жай ғана отыру
Dialogue: 0,0:11:06.59,0:11:08.93,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:08.93,0:11:11.93,Default,,0,0,0,,Маған менің керемет адам екенімді айтқым келеді.
Dialogue: 0,0:11:11.93,0:11:14.80,Default,,0,0,0,,Мұның мәні неде?
Dialogue: 0,0:11:25.78,0:11:28.25,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:11:44.63,0:11:47.47,Default,,0,0,0,,Менің ойымша, сіз шашыңызды қиып алғансыз.
Dialogue: 0,0:11:47.47,0:11:50.81,Default,,0,0,0,,Мен жай ғана сергіп қалғым келді
Dialogue: 0,0:11:50.81,0:11:53.81,Default,,0,0,0,,Әй, өткен күні бұл қулықты қалай жасайсың?
Dialogue: 0,0:11:53.81,0:11:57.15,Default,,0,0,0,,Айтыңызшы, тыңдайсыз ба?
Dialogue: 0,0:11:57.15,0:12:01.08,Default,,0,0,0,,Данышпан болу өте оңай!
Dialogue: 0,0:12:01.08,0:12:03.42,Default,,0,0,0,,⚟Бұл жиіркенішті болуы керек. ＜Қорқынышты＞
Dialogue: 0,0:12:03.42,0:12:05.42,Default,,0,0,0,,⚟Мен де данышпан болып туылғым келді.
Dialogue: 0,0:12:07.76,0:12:10.43,Default,,0,0,0,,⚟Бүгінгі сабағымыз ерекше.
Dialogue: 0,0:12:10.43,0:12:13.93,Default,,0,0,0,,Мұнда бізде қарудың барлық түрі бар.
Dialogue: 0,0:12:13.93,0:12:18.00,Default,,0,0,0,,Осылардың ішінен интуитивті түрде сауданы таңдаңыз.
Dialogue: 0,0:12:18.00,0:12:22.00,Default,,0,0,0,,Түрмеде әртүрлі қаруларды қолдана алсаңыз ғана түрме күзетшісі бола аласыз➡
Dialogue: 0,0:12:22.00,0:12:27.78,Default,,0,0,0,,Сізге сәйкес келетін тамаша қаруды таңдау мүмкіндігі де маңызды➡
Dialogue: 0,0:12:27.78,0:12:31.61,Default,,0,0,0,,Ақылыңды көрсет, ха!
Dialogue: 0,0:12:49.63,0:12:53.64,Default,,0,0,0,,⚟Ух~ Анау оқу мектебі➡
Dialogue: 0,0:12:53.64,0:12:56.97,Default,,0,0,0,,Сіз қаруды таңдау бойынша сабақтарды ұсынасыз ба? Монахтың
Dialogue: 0,0:12:56.97,0:13:02.41,Default,,0,0,0,,-де таңдағаны осы.
Dialogue: 0,0:13:02.41,0:13:04.48,Default,,0,0,0,,Бірақ ➡
Dialogue: 0,0:13:04.48,0:13:07.45,Default,,0,0,0,,Сонымен, оның мәні неде?
Dialogue: 0,0:13:13.09,0:13:15.42,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:13:15.42,0:13:18.76,Default,,0,0,0,,Сіз сабақтың 3 күн бұрын болғанын айттыңыз.
Dialogue: 0,0:13:18.76,0:13:23.83,Default,,0,0,0,,Бұл менің ұзақ уақыт тамақ ішпегенімді білдіреді, ал бұл құдық толығымен ағып кетті! ? ➡
Dialogue: 0,0:13:23.83,0:13:26.27,Default,,0,0,0,,Біз өтіп кетпесек➡
Dialogue: 0,0:13:26.27,0:13:28.24,Default,,0,0,0,,Сен өлдің, солай емес пе?
Dialogue: 0,0:13:29.34,0:13:33.27,Default,,0,0,0,,Тесік ішіне сыйып кетуге жеткілікті жылы болды.
Dialogue: 0,0:13:33.27,0:13:36.24,Default,,0,0,0,,Мен енді шыға алмаймын...
Dialogue: 0,0:13:37.78,0:13:39.85,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:13:39.85,0:13:42.78,Default,,0,0,0,,Шынында да, біз мұнда мамандықпыз.
Dialogue: 0,0:13:42.78,0:13:46.05,Default,,0,0,0,,Жапырақ тәрізді манжу алғыңыз келе ме?
Dialogue: 0,0:13:47.29,0:13:49.79,Default,,0,0,0,,Аму➡
Dialogue: 0,0:13:49.79,0:13:52.36,Default,,0,0,0,,Хмм иә иә
Dialogue: 0,0:13:54.63,0:13:56.63,Default,,0,0,0,,Барлығы
Dialogue: 0,0:13:56.63,0:14:00.57,Default,,0,0,0,,Әр адам мықты деп есептеген қаруды таңдады.
Dialogue: 0,0:14:00.57,0:14:04.91,Default,,0,0,0,,Барыс да солай істейді деп ойладым.
Dialogue: 0,0:14:04.91,0:14:09.24,Default,,0,0,0,,Сондықтан мен біртүрлі болып қалдым
Dialogue: 0,0:14:09.24,0:14:14.25,Default,,0,0,0,,Мен қару ретінде қолдануға жарамсыз тозығы жеткен біреуін таңдадым.
Dialogue: 0,0:14:14.25,0:14:16.25,Default,,0,0,0,,Бұл жиі болады.
Dialogue: 0,0:14:16.25,0:14:19.72,Default,,0,0,0,,Шындығында, бұл керемет қару еді.
Dialogue: 0,0:14:21.59,0:14:24.56,Default,,0,0,0,,Бұл қарапайым қару болды ма?
Dialogue: 0,0:14:27.43,0:14:29.50,Default,,0,0,0,,Бұл тіпті қару да емес еді.
Dialogue: 0,0:14:29.50,0:14:32.77,Default,,0,0,0,,Мектептің қаруды орналастырудағы қателігінен.
Dialogue: 0,0:14:32.77,0:14:36.44,Default,,0,0,0,,Домалау түйреуіш жоғалған сияқты.
Dialogue: 0,0:14:36.44,0:14:39.11,Default,,0,0,0,,Хаха
Dialogue: 0,0:14:39.11,0:14:43.61,Default,,0,0,0,,Маған бұлай қарайды деп ешқашан ойламаппын.
Dialogue: 0,0:14:43.61,0:14:46.68,Default,,0,0,0,,Барлығы нені күтіп отыр?
Dialogue: 0,0:14:46.68,0:14:49.15,Default,,0,0,0,,Нағыз таңдау қаруы
Dialogue: 0,0:14:51.45,0:14:53.79,Default,,0,0,0,,Ерекше ештеңе жоқ
Dialogue: 0,0:14:53.79,0:14:57.56,Default,,0,0,0,,Бұл қарапайым қылыш болды.
Dialogue: 0,0:15:02.40,0:15:09.07,Default,,0,0,0,,(Занка күледі)
Dialogue: 0,0:15:09.07,0:15:11.57,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:15:11.57,0:15:15.41,Default,,0,0,0,,Дасай Дасай Дасаива Хонма
Dialogue: 0,0:15:15.41,0:15:18.91,Default,,0,0,0,,Ахахаха!
Dialogue: 0,0:15:18.91,0:15:22.98,Default,,0,0,0,,Мен жай ғана данышпан деп атағысы келген маскүнем едім.
Dialogue: 0,0:15:22.98,0:15:24.99,Default,,0,0,0,,Мен де оны байқадым
Dialogue: 0,0:15:24.99,0:15:28.66,Default,,0,0,0,,Сайып келгенде, қарапайым адам не істесе де данышпан бола алмайды.
Dialogue: 0,0:15:30.26,0:15:32.26,Default,,0,0,0,,Өл
Dialogue: 0,0:15:32.26,0:15:35.60,Default,,0,0,0,,Менің өлуім керек...
Dialogue: 0,0:15:35.60,0:15:39.57,Default,,0,0,0,,Мен және мына таяқ - жай ғана жалған.
Dialogue: 0,0:15:40.67,0:15:42.67,Default,,0,0,0,,Тым кедей
Dialogue: 0,0:15:42.67,0:15:44.67,Default,,0,0,0,,(қарлығаш)
Dialogue: 0,0:15:44.67,0:15:46.67,Default,,0,0,0,,Не? ➡
Dialogue: 0,0:15:46.67,0:15:50.75,Default,,0,0,0,,Сізге, қарапайым адам, тек гений деңгейінен асып кету керек, солай ма?
Dialogue: 0,0:15:53.11,0:15:55.45,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:15:55.45,0:16:00.12,Default,,0,0,0,,⚟Мен біреуді гений ететін не екенін түсінбеймін➡
Dialogue: 0,0:16:00.12,0:16:04.89,Default,,0,0,0,,Данышпан болу үшін сізге не қажет?
Dialogue: 0,0:16:04.89,0:16:07.23,Default,,0,0,0,,Сәлем саған
Dialogue: 0,0:16:07.23,0:16:11.30,Default,,0,0,0,,Сізде әлі де мотивация бар емес пе? ➡
Dialogue: 0,0:16:11.30,0:16:15.30,Default,,0,0,0,,Бұл жай ғана таяқ, сен оны әлі ұстайсың.
Dialogue: 0,0:16:15.30,0:16:19.07,Default,,0,0,0,,Ха ⚟Әдетте, лақтырылатын қоқыс➡
Dialogue: 0,0:16:19.07,0:16:21.74,Default,,0,0,0,,Оны қатты ұстаңыз
Dialogue: 0,0:16:23.74,0:16:28.52,Default,,0,0,0,,Жанынан өтіп бара жатқан біреудің: ''Ой, солай ғой'' деп айтуы дұрыс.
Dialogue: 0,0:16:31.09,0:16:34.36,Default,,0,0,0,,Сіз өзіңіздің әлсіздігіңізді түсінгеннен кейін күшті бола аласыз.
Dialogue: 0,0:16:35.76,0:16:38.09,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:16:38.09,0:16:42.16,Default,,0,0,0,,Біз бұл қалаға қайтадан буға пісірілген тоқаш жеуге келеміз.
Dialogue: 0,0:16:42.16,0:16:44.93,Default,,0,0,0,,Бір күні дәлелде
Dialogue: 0,0:16:44.93,0:16:48.30,Default,,0,0,0,,Қарапайымның аспаннан асып түсетін жері
Dialogue: 0,0:17:12.96,0:17:14.93,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:17:31.41,0:17:33.58,Default,,0,0,0,,Нфффф
Dialogue: 0,0:17:34.75,0:17:36.72,Default,,0,0,0,,Махаббат таяқшасы
Dialogue: 0,0:17:45.09,0:17:47.76,Default,,0,0,0,,Мен айтқанымдай,
Dialogue: 0,0:17:47.76,0:17:51.10,Default,,0,0,0,,Дәлелдемейінше мен өлмеймін.
Dialogue: 0,0:17:51.10,0:17:53.60,Default,,0,0,0,,Қарапайым адамдардың жасырын күші
Dialogue: 0,0:17:53.60,0:17:56.87,Default,,0,0,0,,Мен саған көрсетемін!
Dialogue: 0,0:18:00.27,0:18:03.54,Default,,0,0,0,,Занка-кун
Dialogue: 0,0:18:05.28,0:18:08.12,Default,,0,0,0,,Төменгі… Қуат…
Dialogue: 0,0:18:08.12,0:18:11.95,Default,,0,0,0,,Қарапайым… адамдар…
Dialogue: 0,0:18:11.95,0:18:16.62,Default,,0,0,0,,Сіз көңілді галлюцинацияны көріп тұрсыз, солай ма?
Dialogue: 0,0:18:18.63,0:18:23.30,Default,,0,0,0,,♬～Зунзун Зунзун Чи
Dialogue: 0,0:18:23.30,0:18:28.14,Default,,0,0,0,,♬～Зунзун Зунзун Ча
Dialogue: 0,0:18:28.14,0:18:30.14,Default,,0,0,0,,♬～Гопогуцу уы～
Dialogue: 0,0:18:30.14,0:18:32.21,Default,,0,0,0,,♬～Нейротоксин～
Dialogue: 0,0:18:32.21,0:18:37.14,Default,,0,0,0,,♬～Зунзун Зунзун Ча
Dialogue: 0,0:18:37.14,0:18:39.21,Default,,0,0,0,,♬～Ойраның сүйіктісі
Dialogue: 0,0:18:39.21,0:18:41.82,Default,,0,0,0,,♬ ~Галлюцинациялық улан~
Dialogue: 0,0:18:41.82,0:18:45.49,Default,,0,0,0,,♬ ~ Зунзузун Зунзузун Фуууу!
Dialogue: 0,0:18:45.49,0:18:47.56,Default,,0,0,0,,Жасау-істеу?
Dialogue: 0,0:18:47.56,0:18:49.99,Default,,0,0,0,,Мен де сені пышақтап көрдім.
Dialogue: 0,0:18:49.99,0:18:52.06,Default,,0,0,0,,Бұл қауіпті➡
Dialogue: 0,0:18:52.06,0:18:55.50,Default,,0,0,0,,Кешіріңіз, жоқ, мен қателесіппін➡
Dialogue: 0,0:18:55.50,0:18:57.50,Default,,0,0,0,,Кешіріңіз➡
Dialogue: 0,0:18:57.50,0:19:01.94,Default,,0,0,0,,Бұл мені өлтіру үшін доза берген жігіттен алған уым➡
Dialogue: 0,0:19:01.94,0:19:05.77,Default,,0,0,0,,Галлюцинациялар соншалықты айқын, олар шындықпен қателесуі мүмкін
Dialogue: 0,0:19:05.77,0:19:08.84,Default,,0,0,0,,Содан қатты жүрек айну пайда болды.
Dialogue: 0,0:19:08.84,0:19:10.85,Default,,0,0,0,,Бұл тәуелділік
Dialogue: 0,0:19:10.85,0:19:13.78,Default,,0,0,0,,А? Бұл ~
Dialogue: 0,0:19:13.78,0:19:17.62,Default,,0,0,0,,Қабырғалар ~ Ммм~
Dialogue: 0,0:19:17.62,0:19:20.62,Default,,0,0,0,,Эй, сен білесің бе?
Dialogue: 0,0:19:20.62,0:19:23.46,Default,,0,0,0,,Қабырғаңызды сындырсаңыз ше?
Dialogue: 0,0:19:23.46,0:19:26.96,Default,,0,0,0,,Күлу де қиын.
Dialogue: 0,0:19:26.96,0:19:29.03,Default,,0,0,0,,О, сен білесің бе?
Dialogue: 0,0:19:29.03,0:19:33.50,Default,,0,0,0,,Сіз білесіз бе? Әдетте lol
Dialogue: 0,0:19:36.30,0:19:40.37,Default,,0,0,0,,Мен сенімен бұдан да тартысты шайқас болады деп ойладым.
Dialogue: 0,0:19:40.37,0:19:44.38,Default,,0,0,0,,Оның оңай біткеніне сене алар емеспін
Dialogue: 0,0:19:44.38,0:19:48.25,Default,,0,0,0,,Басқа тазалаушылар көбірек көңілді болды ма деп ойлаймын.
Dialogue: 0,0:19:53.39,0:19:58.16,Default,,0,0,0,,Кук кук кук кук... Иә?
Dialogue: 0,0:19:58.16,0:20:00.33,Default,,0,0,0,,(Занка күледі)
Dialogue: 0,0:20:00.33,0:20:03.76,Default,,0,0,0,,иә?
Dialogue: 0,0:20:03.76,0:20:06.27,Default,,0,0,0,,Сіз көп көңілді болып жатырсыз деп үміттенемін
Dialogue: 0,0:20:06.27,0:20:08.77,Default,,0,0,0,,Бір секунд күте тұрыңыз, сіз жасырынсыз!
Dialogue: 0,0:20:08.77,0:20:12.11,Default,,0,0,0,,Оны да араластыруға болады.
Dialogue: 0,0:20:12.11,0:20:41.10,Default,,0,0,0,,(Джаббар Занка күледі)
Dialogue: 0,0:20:43.14,0:20:45.81,Default,,0,0,0,,(шу)
Dialogue: 0,0:20:45.81,0:20:50.81,Default,,0,0,0,,Ммм~ Ня~ Нё~➡
Dialogue: 0,0:20:50.81,0:20:53.31,Default,,0,0,0,,Гихи шықты!
Dialogue: 0,0:20:53.31,0:20:57.28,Default,,0,0,0,,Көкек... Бұл солай ма?
Dialogue: 0,0:20:58.82,0:21:00.75,Default,,0,0,0,,Оу, ә?
Dialogue: 0,0:21:00.75,0:21:05.26,Default,,0,0,0,,Уау~ Мұнда да ешкім жоқ.
Dialogue: 0,0:21:05.26,0:21:08.10,Default,,0,0,0,,Бұл да не?
Dialogue: 0,0:21:08.10,0:21:10.77,Default,,0,0,0,,Мен бұл қай жерде екенін білмеймін.
Dialogue: 0,0:21:10.77,0:21:13.27,Default,,0,0,0,,Әрқашан жалғыз
Dialogue: 0,0:21:13.27,0:21:15.77,Default,,0,0,0,,Сен менің жалғыз одақтасымсың➡
Dialogue: 0,0:21:15.77,0:21:17.77,Default,,0,0,0,,Гоки!
Dialogue: 0,0:21:17.77,0:21:19.77,Default,,0,0,0,,Ах
Dialogue: 0,0:21:19.77,0:21:22.11,Default,,0,0,0,,Күтіңіз, күтіңіз!
Dialogue: 0,0:21:22.11,0:21:24.95,Default,,0,0,0,,(Хане)
Dialogue: 0,0:21:24.95,0:21:27.78,Default,,0,0,0,,Мені күт~➡
Dialogue: 0,0:21:27.78,0:21:30.25,Default,,0,0,0,,Гоки
Dialogue: 0,0:21:31.62,0:21:33.59,Default,,0,0,0,,Ах
Dialogue: 0,0:21:38.13,0:21:40.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:42.96,0:21:45.83,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,0:21:56.48,0:21:58.48,Default,,0,0,0,,А...
Dialogue: 0,0:21:58.48,0:22:03.35,Default,,0,0,0,,Қызық бітуге жақын, Занка-кун.
Dialogue: 0,0:22:04.92,0:22:07.25,Default,,0,0,0,,Оны айтудың пайдасы жоқ қой?
Dialogue: 0,0:22:07.25,0:22:10.72,Default,,0,0,0,,Ала аңға құрбандыққа барайын ба?
Dialogue: 0,0:22:12.93,0:22:17.80,Default,,0,0,0,,Жаббар-кун, сен тапсырмаңды жақсы орындадың.
Dialogue: 0,0:22:26.37,0:23:54.66,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:56.16,0:24:01.16,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
