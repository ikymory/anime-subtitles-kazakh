Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:45.21,0:00:52.05,Default,,0,0,0,,Мұнда➡
Dialogue: 0,0:00:52.05,0:00:54.65,Default,,0,0,0,,Не болса да, енді ешкімді ешқашан тастап кетпеймін.
Dialogue: 0,0:00:57.22,0:00:59.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:59.55,0:01:02.06,Default,,0,0,0,,Осы мектепті бітіру – шеберліктің дәлелі.
Dialogue: 0,0:01:13.67,0:01:15.67,Default,,0,0,0,,Хааа~
Dialogue: 0,0:01:15.67,0:01:19.01,Default,,0,0,0,,Уау, бұл сарай.
Dialogue: 0,0:01:19.01,0:01:22.18,Default,,0,0,0,,Мен қыдырып жүргенде бұл жерді көрдім.
Dialogue: 0,0:01:22.18,0:01:25.35,Default,,0,0,0,,Шынымды айтсам, бұл үй деп ойламадым.
Dialogue: 0,0:01:25.35,0:01:30.19,Default,,0,0,0,,Тыйым салынған Пентаның қойнауында осындай ғимарат бар еді➡
Dialogue: 0,0:01:30.19,0:01:32.35,Default,,0,0,0,,Жазбалар
Dialogue: 0,0:01:34.36,0:01:36.66,Default,,0,0,0,,<Аспан, біз бара аламыз деп ойлаймын, солай ма? ＞
Dialogue: 0,0:01:40.36,0:01:43.20,Default,,0,0,0,,Келіңіздер, тұтынушылар.
Dialogue: 0,0:01:43.20,0:01:46.20,Default,,0,0,0,,Кіріңіз.
Dialogue: 0,0:01:58.21,0:02:01.92,Default,,0,0,0,,Мұның бәрі тым күдікті.
Dialogue: 0,0:02:03.15,0:02:07.32,Default,,0,0,0,,Қонақ бөлме біраз ретсіз➡
Dialogue: 0,0:02:07.32,0:02:10.83,Default,,0,0,0,,Мен сені Амоның бөлмесінде қарсы аламын.
Dialogue: 0,0:02:22.17,0:02:24.34,Default,,0,0,0,,Менің айтқым келгені➡
Dialogue: 0,0:02:24.34,0:02:27.68,Default,,0,0,0,,Енді масканы шешейік➡
Dialogue: 0,0:02:27.68,0:02:31.01,Default,,0,0,0,,Өйткені оған иіс кірмейді➡
Dialogue: 0,0:02:31.01,0:02:33.52,Default,,0,0,0,,Масканы шешкен дұрыс па?
Dialogue: 0,0:02:34.52,0:02:39.52,Default,,0,0,0,,Сондай-ақ, мен Амомен сөйлескім келеді, бірақ бәрі маған жүздерін көрсетпейді.
Dialogue: 0,0:02:40.52,0:02:43.19,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:02:43.19,0:02:45.53,Default,,0,0,0,,(қозғалтқыштың күрсінуі)
Dialogue: 0,0:02:45.53,0:02:53.04,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:54.04,0:02:57.21,Default,,0,0,0,,Уау~
Dialogue: 0,0:02:57.21,0:02:59.71,Default,,0,0,0,,Уау~ хахахаха
Dialogue: 0,0:03:02.31,0:03:05.81,Default,,0,0,0,,Керемет және сүйкімді➡
Dialogue: 0,0:03:05.81,0:03:07.82,Default,,0,0,0,,Шибуи
Dialogue: 0,0:03:07.82,0:03:11.52,Default,,0,0,0,,Барлығының жүзін көргеніме қуаныштымын.
Dialogue: 0,0:03:12.49,0:03:14.49,Default,,0,0,0,,Жақсы…➡
Dialogue: 0,0:03:14.49,0:03:16.49,Default,,0,0,0,,Жоғарғы қабаттағы менің бөлмем➡
Dialogue: 0,0:03:16.49,0:03:20.33,Default,,0,0,0,,Оны күтпеген сәнді интерьер ретінде жазып алған дұрыс.
Dialogue: 0,0:03:20.33,0:03:23.17,Default,,0,0,0,,＜Неліктен көп заттар бар?＞
Dialogue: 0,0:03:26.17,0:03:31.17,Default,,0,0,0,,Келіңіздер! ...Сонымен не дейсіз?
Dialogue: 0,0:03:31.17,0:03:33.68,Default,,0,0,0,,Хмм иә
Dialogue: 0,0:03:35.34,0:03:39.35,Default,,0,0,0,,Аспан мен жер асты әлемін аралай алатын адам туралы естідім.
Dialogue: 0,0:03:39.35,0:03:41.85,Default,,0,0,0,,Мен оны көргеніңізді естідім.
Dialogue: 0,0:03:41.85,0:03:44.85,Default,,0,0,0,,Сол үшін сені көруге келдім... А, кездескенше.
Dialogue: 0,0:03:44.85,0:03:48.69,Default,,0,0,0,,Сүйікті түрің туралы айтып бер.
Dialogue: 0,0:03:48.69,0:03:51.53,Default,,0,0,0,,Не? Жыланбалығы жоқ➡
Dialogue: 0,0:03:51.53,0:03:54.53,Default,,0,0,0,,Маған иісі күшті адамдар ұнайды➡
Dialogue: 0,0:03:54.53,0:03:57.70,Default,,0,0,0,,Бетке қарағанда иіс маңыздырақ
Dialogue: 0,0:03:57.70,0:04:01.30,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:04:01.30,0:04:05.01,Default,,0,0,0,,Осылардың ішінде мен үлкен ағаны жақсы көремін!
Dialogue: 0,0:04:05.97,0:04:09.14,Default,,0,0,0,,Хе хехе
Dialogue: 0,0:04:09.14,0:04:13.48,Default,,0,0,0,,Ах... у... Иә? Сен не туралы айтып тұрсың?
Dialogue: 0,0:04:13.48,0:04:16.15,Default,,0,0,0,,Жас ханым, аа~
Dialogue: 0,0:04:16.15,0:04:18.99,Default,,0,0,0,,Бұл Қойбана ақпарат алымы екенін білдіре ме?
Dialogue: 0,0:04:18.99,0:04:21.66,Default,,0,0,0,,Ақпарат... Төлем?
Dialogue: 0,0:04:21.66,0:04:25.66,Default,,0,0,0,,Біз жәннатқа қалай бару керектігі туралы ақпарат сұрауға келдік.
Dialogue: 0,0:04:25.66,0:04:29.16,Default,,0,0,0,,Ақпараттық алым - бұл махаббат баннері, бірақ ол аздап солай.
Dialogue: 0,0:04:29.16,0:04:31.17,Default,,0,0,0,,мен сендер, «жеуге жарамды балалар», құрбан болып жатқандарыңды түсіндім,
Dialogue: 0,0:04:32.50,0:04:34.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:36.84,0:04:39.34,Default,,0,0,0,,Бұл не?➡
Dialogue: 0,0:04:39.34,0:04:49.68,Default,,0,0,0,,Бұл не? Бұл не? Бұл не?➡
Dialogue: 0,0:04:49.68,0:04:52.35,Default,,0,0,0,,Бұл не? Бұл не? ➡
Dialogue: 0,0:04:52.35,0:04:55.02,Default,,0,0,0,,Амомен сөйлескіңіз келмейді ме? ➡
Dialogue: 0,0:04:55.02,0:04:57.03,Default,,0,0,0,,Бірақ➡
Dialogue: 0,0:04:57.03,0:05:01.30,Default,,0,0,0,,Сіз мұны қалай айтасыз, сіз Амо мүмкіндігін пайдаланып жатқан сияқтысыз➡
Dialogue: 0,0:05:01.30,0:05:03.80,Default,,0,0,0,,Бұл не? Бұл не? Уф...
Dialogue: 0,0:05:03.80,0:05:07.14,Default,,0,0,0,,Сырттан тұтынушы келгенде қатты қуандым➡
Dialogue: 0,0:05:07.14,0:05:09.30,Default,,0,0,0,,Өйткені, ол пайдалану үшін! ?
Dialogue: 0,0:05:09.30,0:05:11.31,Default,,0,0,0,,А, бұл қауіпті.
Dialogue: 0,0:05:11.31,0:05:13.64,Default,,0,0,0,,Мақсатым болмаса, кездескім келмейді➡
Dialogue: 0,0:05:13.64,0:05:15.81,Default,,0,0,0,,Бұл солай ма? ➡
Dialogue: 0,0:05:15.81,0:05:18.31,Default,,0,0,0,,Ақымақ болма! ➡
Dialogue: 0,0:05:18.31,0:05:21.48,Default,,0,0,0,,Өтірік айту дұрыс емес, жай ғана кездескім келді ➡
Dialogue: 0,0:05:21.48,0:05:24.65,Default,,0,0,0,,Мені бақытты ет! Аа кешір
Dialogue: 0,0:05:24.65,0:05:26.99,Default,,0,0,0,,Бұл жаман сөз болды.
Dialogue: 0,0:05:26.99,0:05:29.32,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:29.32,0:05:32.16,Default,,0,0,0,,Мен де саған қызығамын.
Dialogue: 0,0:05:32.16,0:05:34.16,Default,,0,0,0,,Уф аа
Dialogue: 0,0:05:36.50,0:05:39.50,Default,,0,0,0,,Өтірік айтпа!
Dialogue: 0,0:05:40.50,0:05:42.50,Default,,0,0,0,,Сен енді менің түрім емессің
Dialogue: 0,0:05:42.50,0:05:44.51,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:05:44.51,0:05:47.18,Default,,0,0,0,,Жоқ... мм.
Dialogue: 0,0:05:47.18,0:05:50.68,Default,,0,0,0,,Сонымен, мен де өз ойымды айта аламын ба?
Dialogue: 0,0:05:50.68,0:05:54.35,Default,,0,0,0,,Киім киіңіз, себебі көзіңізді шоғырландыру қиын болады.
Dialogue: 0,0:05:54.35,0:05:57.02,Default,,0,0,0,,Күрсіну…➡
Dialogue: 0,0:05:57.02,0:06:01.52,Default,,0,0,0,,Әйел сәніне араласатын ер адам
Dialogue: 0,0:06:03.12,0:06:07.13,Default,,0,0,0,,Сіз ең нашар адамсыз.
Dialogue: 0,0:06:08.46,0:06:10.57,Default,,0,0,0,,Жыныстық қатынас жоқ
Dialogue: 0,0:06:13.80,0:06:17.64,Default,,0,0,0,,Мен достарыма да бұлай жасамаймын.
Dialogue: 0,0:06:17.64,0:06:20.98,Default,,0,0,0,,Цк, бұл əйел ақша беретін адам ба?
Dialogue: 0,0:06:20.98,0:06:22.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:26.48,0:06:28.98,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:06:28.98,0:06:32.29,Default,,0,0,0,,Бұл... белгісі
Dialogue: 0,0:06:39.66,0:06:42.16,Default,,0,0,0,,Қалғаныңыз үшін рахмет➡
Dialogue: 0,0:06:42.16,0:06:44.17,Default,,0,0,0,,Ағай
Dialogue: 0,0:06:44.17,0:06:46.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:53.17,0:08:21.10,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:08:36.14,0:08:38.15,Default,,0,0,0,,Иә? Ах... ааа...
Dialogue: 0,0:08:38.15,0:08:40.65,Default,,0,0,0,,Хмм... аааа...
Dialogue: 0,0:08:40.65,0:08:43.65,Default,,0,0,0,,Сіз қазір
Dialogue: 0,0:08:43.65,0:08:45.65,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:08:45.65,0:08:49.32,Default,,0,0,0,,Қозғалтқышқа не істедің?
Dialogue: 0,0:08:49.32,0:08:52.03,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:08:52.99,0:08:56.00,Default,,0,0,0,,Сәлем! бірдеңе істедің бе
Dialogue: 0,0:08:56.00,0:08:58.00,Default,,0,0,0,,Сіз беретін адамсыз, солай ма?
Dialogue: 0,0:08:58.00,0:09:01.94,Default,,0,0,0,,Ал бұл аяқ киімде менің 3R маркасымен бірдей мөр бар.
Dialogue: 0,0:09:01.94,0:09:05.54,Default,,0,0,0,,Сен несің?
Dialogue: 0,0:09:07.11,0:09:11.11,Default,,0,0,0,,! Сіздің типіңіз қандай адам?
Dialogue: 0,0:09:12.11,0:09:14.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:14.12,0:09:17.12,Default,,0,0,0,,Иә? Неге үндемейсің?
Dialogue: 0,0:09:17.12,0:09:20.46,Default,,0,0,0,,Кәдімгі әңгіме – қарым-қатынастың негізі, солай ма? ➡
Dialogue: 0,0:09:20.46,0:09:25.63,Default,,0,0,0,,Аузын қимылдатқан жалғыз Амо болса да, қашықтық жақындамайды➡
Dialogue: 0,0:09:25.63,0:09:29.30,Default,,0,0,0,,Адамдар өз-өзімен сөйлескенді жақсы көреді➡
Dialogue: 0,0:09:29.30,0:09:33.30,Default,,0,0,0,,Сондықтан әркім өзі туралы әңгімелеп, көңіл көтере алады➡
Dialogue: 0,0:09:33.30,0:09:36.14,Default,,0,0,0,,Сіз құнды тұтынушысыз➡
Dialogue: 0,0:09:36.14,0:09:38.84,Default,,0,0,0,,Мен сіздің де әңгімеңізден ләззат алғаныңызды қалаймын.
Dialogue: 0,0:09:39.97,0:09:44.15,Default,,0,0,0,,Жарайды, оны түсіретіндерден басқа.
Dialogue: 0,0:09:44.15,0:09:46.15,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:09:46.15,0:09:49.35,Default,,0,0,0,,Мен сөйлесе алмайтын сияқтымын.
Dialogue: 0,0:09:51.65,0:09:53.82,Default,,0,0,0,,Иә
Dialogue: 0,0:09:53.82,0:09:56.32,Default,,0,0,0,,Эй, мен түсіндім.
Dialogue: 0,0:09:56.32,0:09:59.99,Default,,0,0,0,,Сіз жасаған тақырыптарға сәйкес келетін адамның дауысы
Dialogue: 0,0:09:59.99,0:10:04.00,Default,,0,0,0,,Көңіліңді көтеретін адамның дауысы ғана естіледі.
Dialogue: 0,0:10:04.00,0:10:08.17,Default,,0,0,0,,Егер бұл рас болса, менің даусым өте жақсы естіледі.
Dialogue: 0,0:10:08.17,0:10:10.17,Default,,0,0,0,,Ұсқынсыз
Dialogue: 0,0:10:10.17,0:10:12.84,Default,,0,0,0,,Қорқынышты оқиғалар енді аяқталды.
Dialogue: 0,0:10:12.84,0:10:15.18,Default,,0,0,0,,Мен қандай әдісті қолдану керектігін білмеймін.
Dialogue: 0,0:10:15.18,0:10:19.01,Default,,0,0,0,,Жарайсың қозғалтқыш, сен мұны мен үшін жасадың.
Dialogue: 0,0:10:19.01,0:10:22.68,Default,,0,0,0,,Мен аспан сияқты нәрселерге мән бермеймін.
Dialogue: 0,0:10:22.68,0:10:25.85,Default,,0,0,0,,Егер қандай да бір дұшпандық болса, оны жай ғана басып тастаңыз.
Dialogue: 0,0:10:25.85,0:10:29.02,Default,,0,0,0,,Занка Неге...?
Dialogue: 0,0:10:29.02,0:10:32.53,Default,,0,0,0,,(Амо жылай бастайды)
Dialogue: 0,0:10:32.53,0:10:35.86,Default,,0,0,0,,Неге мұндай қорқынышты сөздер айтасың?
Dialogue: 0,0:10:35.86,0:10:40.70,Default,,0,0,0,,Амо мен ештеңе істеген жоқпын➡
Dialogue: 0,0:10:40.70,0:10:44.87,Default,,0,0,0,,Қорқынышты Бұл сұмдық➡
Dialogue: 0,0:10:44.87,0:10:49.08,Default,,0,0,0,,Оқ өте көп
Dialogue: 0,0:10:50.88,0:10:53.21,Default,,0,0,0,,Мен ауырдым
Dialogue: 0,0:10:53.21,0:10:55.22,Default,,0,0,0,,А? Уф!
Dialogue: 0,0:10:55.22,0:10:57.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:58.55,0:11:00.49,Default,,0,0,0,,Уф, не болды?
Dialogue: 0,0:11:00.49,0:11:02.49,Default,,0,0,0,,Біз сенің жағындамыз, Дельмон.
Dialogue: 0,0:11:02.49,0:11:04.66,Default,,0,0,0,,Өйткені, бұл қабілет арқылы басқарылатын тип.
Dialogue: 0,0:11:04.66,0:11:08.83,Default,,0,0,0,,Оны ренжітуге қалай дәтің бар!
Dialogue: 0,0:11:08.83,0:11:11.33,Default,,0,0,0,,Қарғыс атсын балалар➡
Dialogue: 0,0:11:11.33,0:11:14.00,Default,,0,0,0,,Енді оны ренжітуге болмайды➡
Dialogue: 0,0:11:14.00,0:11:16.84,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:11:16.84,0:11:20.68,Default,,0,0,0,,Ол менің ұрысуыма себепші➡
Dialogue: 0,0:11:20.68,0:11:24.68,Default,,0,0,0,,Оны қорғаңыз, бұл дұрыс әрекет
Dialogue: 0,0:11:24.68,0:11:26.68,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:26.68,0:11:29.68,Default,,0,0,0,,Мені манипуляциялаған жоқпын, шынымды айтсам.
Dialogue: 0,0:11:29.68,0:11:32.19,Default,,0,0,0,,Білемін, өйткені мен осы уақыт бойы сенің жаныңда болдым.
Dialogue: 0,0:11:32.19,0:11:34.36,Default,,0,0,0,,Не? Бір минут күтіңіз➡
Dialogue: 0,0:11:34.36,0:11:37.03,Default,,0,0,0,,Аударма түсініксіз бола бастады.
Dialogue: 0,0:11:37.03,0:11:39.69,Default,,0,0,0,,Иә? Бұл нені білдіреді?
Dialogue: 0,0:11:39.69,0:11:41.70,Default,,0,0,0,,Фуфу
Dialogue: 0,0:11:41.70,0:11:46.60,Default,,0,0,0,,Не, бәрі байқамады ма?
Dialogue: 0,0:11:49.04,0:11:51.37,Default,,0,0,0,,Аға әрқашан болған
Dialogue: 0,0:11:51.37,0:11:53.71,Default,,0,0,0,,Хмм, мен Амоның жанкүйері болдым.
Dialogue: 0,0:11:53.71,0:11:55.71,Default,,0,0,0,,Делмон? Қашаннан бері! ?
Dialogue: 0,0:11:55.71,0:11:57.71,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:57.71,0:12:01.65,Default,,0,0,0,,Дельмон - достарымен оны ұнатқаны үшін араласатын адам түрі...
Dialogue: 0,0:12:01.65,0:12:03.99,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:12:03.99,0:12:08.66,Default,,0,0,0,,Амо үшін сен маған опасыздық жасай аласың.
Dialogue: 0,0:12:08.66,0:12:10.83,Default,,0,0,0,,Бірақ мен оған көмектесе алмаймын.
Dialogue: 0,0:12:10.83,0:12:14.13,Default,,0,0,0,,Амо мен қателескен жоқпын.
Dialogue: 0,0:12:15.33,0:12:18.50,Default,,0,0,0,,Мен жай ғана сөйлескім келді➡
Dialogue: 0,0:12:18.50,0:12:20.60,Default,,0,0,0,,Барлығы осы болды.
Dialogue: 0,0:12:22.84,0:12:24.84,Default,,0,0,0,,Адам ағзалары
Dialogue: 0,0:12:24.84,0:12:28.64,Default,,0,0,0,,Оони Куна Рей
Dialogue: 0,0:12:29.68,0:12:31.68,Default,,0,0,0,,Кук уф
Dialogue: 0,0:12:31.68,0:12:34.52,Default,,0,0,0,,Ақпарат Жаңа ғана сұрауға келдім ➡
Dialogue: 0,0:12:34.52,0:12:37.82,Default,,0,0,0,,Енді бұл одан да қиын.
Dialogue: 0,0:12:46.53,0:12:49.20,Default,,0,0,0,,⚟Бұл сен кінәлі.
Dialogue: 0,0:12:49.20,0:12:51.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:52.70,0:12:56.87,Default,,0,0,0,,⚟Қылмыстық қаны бар бала ⚟Кір
Dialogue: 0,0:12:56.87,0:13:00.31,Default,,0,0,0,,⚟Кір болғандықтан, басқаларды ластайды.
Dialogue: 0,0:13:00.31,0:13:03.65,Default,,0,0,0,,⚟ Кір тұңғиыққа барады ⚟ Лас шыңырауға кетеді.
Dialogue: 0,0:13:03.65,0:13:05.98,Default,,0,0,0,,⚟ Лас тұңғиыққа барады ⚟ Лас шыңырауға кетеді
Dialogue: 0,0:13:05.98,0:13:09.15,Default,,0,0,0,,⚟ Кір тұңғиыққа барады ⚟ Лас шыңырауға кетеді.
Dialogue: 0,0:13:09.15,0:13:12.82,Default,,0,0,0,,Иә, шын мәнінде➡
Dialogue: 0,0:13:12.82,0:13:14.99,Default,,0,0,0,,Амо жанкүйерлері➡
Dialogue: 0,0:13:14.99,0:13:18.49,Default,,0,0,0,,Мұнда тағы бір адам бар➡
Dialogue: 0,0:13:18.49,0:13:20.50,Default,,0,0,0,,Амо не қалайды➡
Dialogue: 0,0:13:20.50,0:13:24.33,Default,,0,0,0,,Барлығымыз осы жерде үнемі көңіл көтеріп, сөйлесейік➡
Dialogue: 0,0:13:24.33,0:13:26.33,Default,,0,0,0,,Бірақ
Dialogue: 0,0:13:26.33,0:13:30.84,Default,,0,0,0,,Егер біреу мені ыңғайсыздандыратын бірдеңені қайта айтса ше?
Dialogue: 0,0:13:32.17,0:13:35.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:35.01,0:13:39.18,Default,,0,0,0,,Бала сізді жазалауы мүмкін.
Dialogue: 0,0:13:39.18,0:13:41.58,Default,,0,0,0,,Гррр...
Dialogue: 0,0:13:44.52,0:13:49.86,Default,,0,0,0,,Хаа ха ха ха ха
Dialogue: 0,0:13:49.86,0:13:54.53,Default,,0,0,0,,Ха ха ха ха ха
Dialogue: 0,0:13:54.53,0:13:56.86,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:13:56.86,0:13:59.87,Default,,0,0,0,,Елшілер!
Dialogue: 0,0:14:01.30,0:14:03.64,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:14:03.64,0:14:06.97,Default,,0,0,0,,(Людоның жүрек соғысы)
Dialogue: 0,0:14:06.97,0:14:09.28,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:17.49,0:14:21.49,Default,,0,0,0,,Менің суаруымнан жалтарма.
Dialogue: 0,0:14:22.49,0:14:25.49,Default,,0,0,0,,Адамның бұл мүшесі Дельмонның өткені.
Dialogue: 0,0:14:25.49,0:14:30.50,Default,,0,0,0,,Өсімдіктердің үлкеюіне көмектесу ниетінен туған.
Dialogue: 0,0:14:30.50,0:14:33.67,Default,,0,0,0,,Аты айтып тұрғандай, одан шыққан суға соқсаңыз.
Dialogue: 0,0:14:33.67,0:14:36.17,Default,,0,0,0,,Ол үлкейе ме?
Dialogue: 0,0:14:36.17,0:14:40.17,Default,,0,0,0,,Иә, нысанның ылғалдылығын өңдеуге болады➡
Dialogue: 0,0:14:40.17,0:14:42.68,Default,,0,0,0,,Губка сияқты сіңіріңіз➡
Dialogue: 0,0:14:42.68,0:14:46.01,Default,,0,0,0,,Оны шар сияқты үрлегендей.
Dialogue: 0,0:14:46.01,0:14:50.18,Default,,0,0,0,,Бірақ тым көп су толтырылған шарлармен не болады?
Dialogue: 0,0:14:50.18,0:14:53.09,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:54.02,0:14:56.02,Default,,0,0,0,,Жарылу
Dialogue: 0,0:14:56.02,0:14:58.19,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:58.19,0:15:02.63,Default,,0,0,0,,Қозғалтқышқа арт жағынан су құйылған болуы керек.
Dialogue: 0,0:15:02.63,0:15:05.13,Default,,0,0,0,,Осындай жарқыраған түрімен
Dialogue: 0,0:15:05.13,0:15:08.97,Default,,0,0,0,,Мұны қозғалтқыш байқамай қалай жасауға болады?
Dialogue: 0,0:15:08.97,0:15:13.07,Default,,0,0,0,,Саптама пайдалануға байланысты өзгереді.
Dialogue: 0,0:15:14.31,0:15:18.15,Default,,0,0,0,,Олар бұл жолы үнсіз саптаманы пайдаланған сияқты.
Dialogue: 0,0:15:18.15,0:15:22.98,Default,,0,0,0,,Мен оны ешкімге қолданбасам да➡
Dialogue: 0,0:15:22.98,0:15:25.59,Default,,0,0,0,,Өйткені, әлгі әйел
Dialogue: 0,0:15:26.99,0:15:29.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:29.66,0:15:32.16,Default,,0,0,0,,Мен көп нәрсені түсінбеймін, бірақ әзірге
Dialogue: 0,0:15:32.16,0:15:34.83,Default,,0,0,0,,Делмон сізді тыныштандырады➡
Dialogue: 0,0:15:34.83,0:15:37.33,Default,,0,0,0,,Мазасыздық факторы қызықсыз болуы керек.
Dialogue: 0,0:15:37.33,0:15:39.33,Default,,0,0,0,,Жалғыз барма, Риёу!
Dialogue: 0,0:15:39.33,0:15:41.34,Default,,0,0,0,,Дельмонмен жұмыс істеу қиын.
Dialogue: 0,0:15:41.34,0:15:43.34,Default,,0,0,0,,Егер ол тым алыс болса, ынтымақтастық жасамаңыз.
Dialogue: 0,0:15:43.34,0:15:45.34,Default,,0,0,0,,Біреудің сізге қайталануына жол бермеңіз!
Dialogue: 0,0:15:45.34,0:15:49.18,Default,,0,0,0,,《Шынында мен Амоның фанатымын➡》
Dialogue: 0,0:15:49.18,0:15:52.51,Default,,0,0,0,,《Мұнда тағы бір адам бар》 Алға қара, Риёу.
Dialogue: 0,0:15:52.51,0:15:55.52,Default,,0,0,0,,Сәлем! Қазір ешкім
Dialogue: 0,0:15:55.52,0:15:58.02,Default,,0,0,0,,Мен сенің арқаңа сене алмаймын.
Dialogue: 0,0:15:58.02,0:15:59.95,Default,,0,0,0,,Рию, алға қара!
Dialogue: 0,0:15:59.95,0:16:02.62,Default,,0,0,0,,Су қысымын реттеу күшті
Dialogue: 0,0:16:02.62,0:16:06.63,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:16:06.63,0:16:11.13,Default,,0,0,0,,Уау~ Керемет екен, ағайдың қаруы➡
Dialogue: 0,0:16:11.13,0:16:14.47,Default,,0,0,0,,Бірақ Амоның үйін қиратпаңыз➡
Dialogue: 0,0:16:14.47,0:16:17.81,Default,,0,0,0,,Егер бұл орын алса, мен жөндеуге көмек сұрауым керек, жарай ма?
Dialogue: 0,0:16:17.81,0:16:20.14,Default,,0,0,0,,Концентрат, Рию.
Dialogue: 0,0:16:20.14,0:16:23.14,Default,,0,0,0,,фуфуфуфуфуфуфуфуфуфу... А?
Dialogue: 0,0:16:23.14,0:16:25.15,Default,,0,0,0,,Қараңыз~
Dialogue: 0,0:16:25.15,0:16:28.32,Default,,0,0,0,,Сіз кімнің жағында екенін білмейсіз.
Dialogue: 0,0:16:28.32,0:16:30.65,Default,,0,0,0,,Бұл қорқынышты~➡
Dialogue: 0,0:16:30.65,0:16:32.82,Default,,0,0,0,,Сол үшін айттым ғой, солай ма? ➡
Dialogue: 0,0:16:32.82,0:16:37.49,Default,,0,0,0,,Амомен сөйлессең, бәрі жақсы уақыт өткізеді➡
Dialogue: 0,0:16:37.49,0:16:41.33,Default,,0,0,0,,Махаббат бана - бейбітшілікке алғашқы қадам.
Dialogue: 0,0:16:41.33,0:16:43.50,Default,,0,0,0,,Сен жындысың
Dialogue: 0,0:16:43.50,0:16:47.17,Default,,0,0,0,,Людо, оянатын уақыт болды... Бәле, қарғыс атсын.
Dialogue: 0,0:16:47.17,0:16:50.51,Default,,0,0,0,,Рудо? Бұл не?
Dialogue: 0,0:16:50.51,0:16:54.68,Default,,0,0,0,,Бұл төменгі әлем болуы керек, солай ма?
Dialogue: 0,0:16:54.68,0:16:57.85,Default,,0,0,0,,Не болып жатыр? Мен төменгі әлемдемін
Dialogue: 0,0:16:57.85,0:17:00.78,Default,,0,0,0,,Мен төменгі әлемге барамын.
Dialogue: 0,0:17:00.78,0:17:03.12,Default,,0,0,0,,Мен...
Dialogue: 0,0:17:03.12,0:17:06.95,Default,,0,0,0,,Сіз көкке оралдыңыз ба?
Dialogue: 0,0:17:06.95,0:17:09.29,Default,,0,0,0,,Не айту керек
Dialogue: 0,0:17:09.29,0:17:11.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:13.46,0:17:15.80,Default,,0,0,0,,Бұл ненің иісі?
Dialogue: 0,0:17:15.80,0:17:19.13,Default,,0,0,0,,Бір нәрсе
Dialogue: 0,0:17:19.13,0:17:21.64,Default,,0,0,0,,Сағыныш иісі
Dialogue: 0,0:17:23.47,0:17:26.64,Default,,0,0,0,,Естеліктер қалай жасалады деп ойлайсыңдар?
Dialogue: 0,0:17:26.64,0:17:28.64,Default,,0,0,0,,Ах
Dialogue: 0,0:17:28.64,0:17:31.31,Default,,0,0,0,,Көргенім, естігенім➡
Dialogue: 0,0:17:31.31,0:17:33.48,Default,,0,0,0,,Мен бірге уақыт өткізген адамдар➡
Dialogue: 0,0:17:33.48,0:17:36.48,Default,,0,0,0,,Әртүрлі оқиғалар естелікке айналады
Dialogue: 0,0:17:38.99,0:17:42.66,Default,,0,0,0,,Бірақ жыланбалықтың иісі бар деп ойлаймын➡
Dialogue: 0,0:17:42.66,0:17:44.66,Default,,0,0,0,,Эй
Dialogue: 0,0:17:44.66,0:17:47.16,Default,,0,0,0,,Махаббат хикаясы соншалықты құлықсыз болса➡
Dialogue: 0,0:17:47.16,0:17:50.16,Default,,0,0,0,,Сағыныш иісін сезіңіз
Dialogue: 0,0:17:50.16,0:17:53.37,Default,,0,0,0,,Өзіңізді ғашық ретінде сезінгіңіз келе ме?
Dialogue: 0,0:18:15.62,0:18:17.63,Default,,0,0,0,,Чиуауа
Dialogue: 0,0:18:21.13,0:18:24.13,Default,,0,0,0,,Ha
Dialogue: 0,0:18:24.13,0:18:28.14,Default,,0,0,0,,Мен оны әрқашан бағалайтыныма қуаныштымын
Dialogue: 0,0:18:28.14,0:18:31.97,Default,,0,0,0,,Жоқ, басқаша.
Dialogue: 0,0:18:31.97,0:18:34.48,Default,,0,0,0,,Сіз мұны істейсіз
Dialogue: 0,0:18:34.48,0:18:36.58,Default,,0,0,0,,Мен оны лақтырып жібердім
Dialogue: 0,0:18:38.31,0:18:41.82,Default,,0,0,0,,Сен оны менің алдымда лақтырып жібердің.
Dialogue: 0,0:18:43.82,0:18:46.32,Default,,0,0,0,,Келесіде Людо бар ма?
Dialogue: 0,0:18:46.32,0:18:48.32,Default,,0,0,0,,Делмон да➡
Dialogue: 0,0:18:48.32,0:18:50.99,Default,,0,0,0,,Бұл сезім сатқындық емес➡
Dialogue: 0,0:18:50.99,0:18:53.66,Default,,0,0,0,,Маған бірдеңе көрсетіп жатыр
Dialogue: 0,0:18:53.66,0:18:56.66,Default,,0,0,0,,Сол әйелдің қабілетімен
Dialogue: 0,0:18:58.17,0:19:01.94,Default,,0,0,0,,Сізге көрсетіліп жатыр ма? ➡
Dialogue: 0,0:19:01.94,0:19:03.94,Default,,0,0,0,,Сіз не туралы айтып отырсыз? ➡
Dialogue: 0,0:19:03.94,0:19:07.04,Default,,0,0,0,,Амо ештеңе көрсетпейді.
Dialogue: 0,0:19:09.28,0:19:12.28,Default,,0,0,0,,Ол жай ғана иіс шығарады.
Dialogue: 0,0:19:13.61,0:19:16.78,Default,,0,0,0,,Сүйікті адамыңызбен бақытты уақыт➡
Dialogue: 0,0:19:16.78,0:19:19.79,Default,,0,0,0,,Тақырып сол кездегі иіс➡
Dialogue: 0,0:19:19.79,0:19:22.96,Default,,0,0,0,,Иісі адамнан адамға өзгеретін сияқты➡
Dialogue: 0,0:19:22.96,0:19:26.76,Default,,0,0,0,,Қалақшадан кейін барлығы жыланбалықты қорғайды.
Dialogue: 0,0:19:27.80,0:19:31.80,Default,,0,0,0,,Аа, мен тым көп сөйледім.
Dialogue: 0,0:19:31.80,0:19:34.80,Default,,0,0,0,,Қысқасы, түсіндім.
Dialogue: 0,0:19:34.80,0:19:37.47,Default,,0,0,0,,Бұл иіс
Dialogue: 0,0:19:37.47,0:19:41.64,Default,,0,0,0,,Өзіңізді жақсы көретін адаммен қателескеніңізге сенімдісіз бе?
Dialogue: 0,0:19:41.64,0:19:44.81,Default,,0,0,0,,Бұл тек маска кию мәселесі.
Dialogue: 0,0:19:44.81,0:19:47.98,Default,,0,0,0,,Маған қиналмай айтып бергеніңіз үшін рахмет.
Dialogue: 0,0:19:47.98,0:19:50.65,Default,,0,0,0,,Біріншіден, сүйікті адамыңызбен естеліктер➡
Dialogue: 0,0:19:50.65,0:19:53.49,Default,,0,0,0,,Бұл әрқашан бақыт туралы емес, солай ма?
Dialogue: 0,0:19:53.49,0:19:57.99,Default,,0,0,0,,Егер адам сол адамға өшпенділік танытса, не болар еді?
Dialogue: 0,0:19:57.99,0:20:02.50,Default,,0,0,0,,Ха, керісінше, өлтірілуі мүмкін.
Dialogue: 0,0:20:02.50,0:20:06.00,Default,,0,0,0,,Олай болмай тұрып мен оны бейтараптаймын.
Dialogue: 0,0:20:06.00,0:20:09.84,Default,,0,0,0,,Ақымақ, ақымақ!
Dialogue: 0,0:20:09.84,0:20:14.01,Default,,0,0,0,,Менің басым тітіркендіргіш
Dialogue: 0,0:20:14.01,0:20:17.01,Default,,0,0,0,,Сіз Амо➡ дедіңіз
Dialogue: 0,0:20:17.01,0:20:20.82,Default,,0,0,0,,Тақырыбы - бақытты кездер.
Dialogue: 0,0:20:22.02,0:20:25.35,Default,,0,0,0,,Боқтық
Dialogue: 0,0:20:25.35,0:20:28.52,Default,,0,0,0,,Сен мені тастап кетсең де
Dialogue: 0,0:20:28.52,0:20:33.33,Default,,0,0,0,,Мен сені кешіре алмаймын, неге...
Dialogue: 0,0:20:40.03,0:20:42.54,Default,,0,0,0,,Неге қазір?
Dialogue: 0,0:20:42.54,0:20:46.34,Default,,0,0,0,,Бақытты болу сезімі көбірек.
Dialogue: 0,0:20:50.21,0:20:52.55,Default,,0,0,0,,Эй, не? Ядда
Dialogue: 0,0:20:52.55,0:20:55.38,Default,,0,0,0,,Уф, тоқтат.
Dialogue: 0,0:20:55.38,0:20:57.38,Default,,0,0,0,,Жібер
Dialogue: 0,0:20:59.39,0:21:01.89,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:03.66,0:21:06.16,Default,,0,0,0,,Рудо➡
Dialogue: 0,0:21:06.16,0:21:08.16,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:21:11.33,0:21:13.33,Default,,0,0,0,,Гага
Dialogue: 0,0:21:13.33,0:21:16.00,Default,,0,0,0,,Уф
Dialogue: 0,0:21:16.00,0:21:20.34,Default,,0,0,0,,Ауырды, қатты ұрдың.
Dialogue: 0,0:21:20.34,0:21:23.01,Default,,0,0,0,,Людо! елші
Dialogue: 0,0:21:23.01,0:21:26.35,Default,,0,0,0,,Мен енді сол кездегі адам емеспін.
Dialogue: 0,0:21:26.35,0:21:28.85,Default,,0,0,0,,Мен қуат алдым
Dialogue: 0,0:21:28.85,0:21:32.19,Default,,0,0,0,,Біреуді енді ешқашан жоғалтпау
Dialogue: 0,0:21:32.19,0:21:34.19,Default,,0,0,0,,Сосын келесі жолы Кён
Dialogue: 0,0:21:34.19,0:21:36.86,Default,,0,0,0,,Бұл сізді жаншып тастайтын күш.
Dialogue: 0,0:21:36.86,0:21:39.86,Default,,0,0,0,,Жарайды
Dialogue: 0,0:21:42.36,0:21:46.87,Default,,0,0,0,,Мен сені қорғаймын, уайымдама.
Dialogue: 0,0:21:48.37,0:21:51.87,Default,,0,0,0,,Сіз үшін оларға жазылыңыз! ?
Dialogue: 0,0:21:51.87,0:21:54.18,Default,,0,0,0,,Хмф, оны ұсақтаңыз!
Dialogue: 0,0:21:59.21,0:22:02.42,Default,,0,0,0,,Бұл үлкен қателік.
Dialogue: 0,0:22:03.65,0:22:07.32,Default,,0,0,0,,Барлығы кеш болды ма?
Dialogue: 0,0:22:07.32,0:22:12.16,Default,,0,0,0,,Күрсініп... Достарыма адам қаруын қолданғым келмеді.
Dialogue: 0,0:22:12.16,0:22:14.16,Default,,0,0,0,,Ха…
Dialogue: 0,0:22:17.16,0:22:20.00,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:22:20.00,0:23:48.02,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:49.52,0:23:54.52,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
