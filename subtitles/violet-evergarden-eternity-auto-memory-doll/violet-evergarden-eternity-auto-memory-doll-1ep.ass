Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.97,0:00:18.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:00:18.99,0:00:21.82,Default,,0000,0000,0000,,Хмм... не болды?
Dialogue: 0,0:00:21.82,0:00:24.82,Default,,0000,0000,0000,,Майордың көзі бар.
Dialogue: 0,0:00:26.83,0:00:30.16,Default,,0000,0000,0000,,Бұл майордың көзінің түсімен бірдей.
Dialogue: 0,0:00:30.16,0:00:32.17,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:00:34.17,0:00:36.50,Default,,0000,0000,0000,,Мен мұны көргенде...
Dialogue: 0,0:00:36.50,0:00:39.31,Default,,0000,0000,0000,,Мынадай нәрсе...
Dialogue: 0,0:00:42.84,0:00:45.51,Default,,0000,0000,0000,,Мен не айта аламын...?
Dialogue: 0,0:00:45.51,0:01:04.80,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:01:04.80,0:01:07.97,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:01:07.97,0:01:18.65,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:01:18.65,0:01:20.65,Default,,0000,0000,0000,,《Күлгін: «Майор Гилберт.
Dialogue: 0,0:01:20.65,0:01:24.15,Default,,0000,0000,0000,,Бүгін ауруханада жатқанына 120 күн.
Dialogue: 0,0:01:24.15,0:01:26.65,Default,,0000,0000,0000,,Дене күші дерлік қалпына келді.
Dialogue: 0,0:01:26.65,0:01:31.32,Default,,0000,0000,0000,,Пайдалануда біршама қиындықтар бар.
Dialogue: 0,0:01:26.65,0:01:31.32,Default,,0000,0000,0000,,Миссияларды орындауға болады.
Dialogue: 0,0:01:31.32,0:01:34.03,Default,,0000,0000,0000,,Жұмысқа тез оралыңыз...»》
Dialogue: 0,0:01:39.83,0:02:25.55,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:35.82,0:02:40.49,Default,,0000,0000,0000,,《Ходгинс: Ол қыздың бар болуы
Dialogue: 0,0:02:35.82,0:02:40.49,Default,,0000,0000,0000,,Құпия.
Dialogue: 0,0:02:40.49,0:02:45.83,Default,,0000,0000,0000,,Бірақ қызды кім таниды?
Dialogue: 0,0:02:40.49,0:02:45.83,Default,,0000,0000,0000,,Ол оны қару деп атады.
Dialogue: 0,0:02:45.83,0:02:50.67,Default,,0000,0000,0000,,Бұйыртса, соғысамын.
Dialogue: 0,0:02:45.83,0:02:50.67,Default,,0000,0000,0000,,Тек адам кейпіне еліктеу➡
Dialogue: 0,0:02:50.67,0:02:54.57,Default,,0000,0000,0000,,Оның жүрегі жоқ, ол тек құрал.
Dialogue: 0,0:02:57.01,0:02:59.18,Default,,0000,0000,0000,,Подполковник Ходжинс?
Dialogue: 0,0:02:59.18,0:03:02.18,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:02:59.18,0:03:02.18,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:05.62,0:03:07.62,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:03:07.62,0:03:10.29,Default,,0000,0000,0000,,(қатты шу)
Dialogue: 0,0:03:10.29,0:03:12.96,Default,,0000,0000,0000,,Виолет-чан!
Dialogue: 0,0:03:12.96,0:03:15.96,Default,,0000,0000,0000,,Амансың ба? Сіз жарақат алдыңыз ба?
Dialogue: 0,0:03:19.80,0:03:21.80,Default,,0000,0000,0000,,Майор...
Dialogue: 0,0:03:21.80,0:03:26.64,Default,,0000,0000,0000,,Майор Гилберт ше?
Dialogue: 0,0:03:21.80,0:03:26.64,Default,,0000,0000,0000,,Ол... келмеді.
Dialogue: 0,0:03:26.64,0:03:29.31,Default,,0000,0000,0000,,Қайдасың?
Dialogue: 0,0:03:29.31,0:03:32.15,Default,,0000,0000,0000,,Ата-анаңның үйінде
Dialogue: 0,0:03:29.31,0:03:32.15,Default,,0000,0000,0000,,Ол қайтарылды ма?
Dialogue: 0,0:03:32.15,0:03:35.15,Default,,0000,0000,0000,,Майордың жарақаты қалай?
Dialogue: 0,0:03:35.15,0:03:37.82,Default,,0000,0000,0000,,Майор да ауыр жарақат алған болуы керек.
Dialogue: 0,0:03:37.82,0:03:43.32,Default,,0000,0000,0000,,Тікелей...
Dialogue: 0,0:03:37.82,0:03:43.32,Default,,0000,0000,0000,,Сіз сондасыз ба? майор.
Dialogue: 0,0:03:45.33,0:03:49.33,Default,,0000,0000,0000,,Ол...
Dialogue: 0,0:03:45.33,0:03:49.33,Default,,0000,0000,0000,,Сізге ауруханадан шығуға рұқсат берілді.
Dialogue: 0,0:03:49.33,0:03:54.33,Default,,0000,0000,0000,,Подполковник Ходжинс өз жолынан шығып кетті
Dialogue: 0,0:03:49.33,0:03:54.33,Default,,0000,0000,0000,,Ол мені алып кетуге келді.
Dialogue: 0,0:03:54.33,0:03:57.50,Default,,0000,0000,0000,,Ал... міне, солай.
Dialogue: 0,0:03:57.50,0:04:00.44,Default,,0000,0000,0000,,Кешірім сұраймын, командир Ходгинс.
Dialogue: 0,0:04:00.44,0:04:03.78,Default,,0000,0000,0000,,Виолет-чан, сабыр ет.
Dialogue: 0,0:04:03.78,0:04:08.11,Default,,0000,0000,0000,,Мен подполковникті ұмытып кетіппін.
Dialogue: 0,0:04:03.78,0:04:08.11,Default,,0000,0000,0000,,Кешірім сұраймыз.
Dialogue: 0,0:04:08.11,0:04:11.02,Default,,0000,0000,0000,,Жарайды. Қазір отырыңыз.
Dialogue: 0,0:04:12.95,0:04:16.46,Default,,0000,0000,0000,,Һмпф
Dialogue: 0,0:04:12.95,0:04:16.46,Default,,0000,0000,0000,,Сонымен сен мені есіңе түсірдің.
Dialogue: 0,0:04:16.46,0:04:21.46,Default,,0000,0000,0000,,Екі рет: оқу орнында және шешуші шайқас алдындағы түнде.
Dialogue: 0,0:04:16.46,0:04:21.46,Default,,0000,0000,0000,,Біз кездестік.
Dialogue: 0,0:04:21.46,0:04:23.76,Default,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:04:25.80,0:04:27.97,Default,,0000,0000,0000,,Сіз не істеп жүрсіз?
Dialogue: 0,0:04:27.97,0:04:31.47,Default,,0000,0000,0000,,Майор Гилбертке
Dialogue: 0,0:04:27.97,0:04:31.47,Default,,0000,0000,0000,,Мен есеп жазып отырдым.
Dialogue: 0,0:04:31.47,0:04:33.47,Default,,0000,0000,0000,,Жазу – ➡
Dialogue: 0,0:04:33.47,0:04:36.14,Default,,0000,0000,0000,,Қалпына келтіру үшін де жақсы.
Dialogue: 0,0:04:33.47,0:04:36.14,Default,,0000,0000,0000,,Өйткені маған айтты.
Dialogue: 0,0:04:36.14,0:04:38.14,Default,,0000,0000,0000,,Ал майор ше?
Dialogue: 0,0:04:45.99,0:04:48.99,Default,,0000,0000,0000,,Уайымдама, Виолет-чан.
Dialogue: 0,0:04:48.99,0:04:52.16,Default,,0000,0000,0000,,Ол менен бірдеңе істеуімді өтінді.
Dialogue: 0,0:04:52.16,0:04:55.33,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:04:55.33,0:04:59.13,Default,,0000,0000,0000,,Жарайды, сен жақсысың деп үміттенемін.
Dialogue: 0,0:05:01.10,0:05:04.60,Default,,0000,0000,0000,,Дәрігер маған соғыстың жеңіске жеткенін айтты.
Dialogue: 0,0:05:01.10,0:05:04.60,Default,,0000,0000,0000,,Маған бұл туралы айтылды.
Dialogue: 0,0:05:04.60,0:05:06.77,Default,,0000,0000,0000,,Қазір майордың қандай миссиясы бар?
Dialogue: 0,0:05:06.77,0:05:09.94,Default,,0000,0000,0000,,Біз қашан кездесуіміз керек?
Dialogue: 0,0:05:06.77,0:05:09.94,Default,,0000,0000,0000,,(Норияки Какёин) 500 сингапур доллары.
Dialogue: 0,0:05:09.94,0:05:12.78,Default,,0000,0000,0000,,Киіміңді ауыстыр.
Dialogue: 0,0:05:12.78,0:05:15.08,Default,,0000,0000,0000,,Мен көлікті әзірше шығарып саламын.
Dialogue: 0,0:05:17.12,0:05:20.62,Default,,0000,0000,0000,,Бұл ақыры келді
Dialogue: 0,0:05:17.12,0:05:20.62,Default,,0000,0000,0000,,Сіздің багажыңыз.
Dialogue: 0,0:05:22.79,0:05:28.13,Default,,0000,0000,0000,,Өте алыстағы әскер базасында
Dialogue: 0,0:05:22.79,0:05:28.13,Default,,0000,0000,0000,,Қателікпен алып кеткен сияқты.
Dialogue: 0,0:05:28.13,0:05:30.30,Default,,0000,0000,0000,,Брошь….
Dialogue: 0,0:05:30.30,0:05:32.63,Default,,0000,0000,0000,,Изумруд брошь!
Dialogue: 0,0:05:32.63,0:05:35.64,Default,,0000,0000,0000,,Мен сені таптым.
Dialogue: 0,0:05:32.63,0:05:35.64,Default,,0000,0000,0000,,Сайтта және ➡
Dialogue: 0,0:05:35.64,0:05:38.64,Default,,0000,0000,0000,,Гарнизондағы багаж
Dialogue: 0,0:05:35.64,0:05:38.64,Default,,0000,0000,0000,,Егер мұның бәрі...
Dialogue: 0,0:05:38.64,0:05:41.64,Default,,0000,0000,0000,,Егер ол жоқ болса, мен оны іздеуге баруым керек.
Dialogue: 0,0:05:38.64,0:05:41.64,Default,,0000,0000,0000,,Виолет-чан!
Dialogue: 0,0:05:41.64,0:05:44.31,Default,,0000,0000,0000,,Мынаны алдым!
Dialogue: 0,0:05:44.31,0:05:46.61,Default,,0000,0000,0000,,Оны маған майор берді!
Dialogue: 0,0:05:51.48,0:05:54.99,Default,,0000,0000,0000,,Жарайды... Мен іздеймін.
Dialogue: 0,0:05:54.99,0:05:56.99,Default,,0000,0000,0000,,Мен мұны міндетті түрде орындаймын.
Dialogue: 0,0:05:56.99,0:05:58.99,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:05:56.99,0:05:58.99,Default,,0000,0000,0000,,Сонымен қатар, лифчиктің ішкі толтырғышы бар, сондықтан шын мәнінде…
Dialogue: 0,0:05:58.99,0:06:03.80,Default,,0000,0000,0000,,Сіз менімен бірге келесіз.
Dialogue: 0,0:05:58.99,0:06:03.80,Default,,0000,0000,0000,,Бұл оның бұйрығы.
Dialogue: 0,0:06:05.77,0:06:08.27,Default,,0000,0000,0000,,Тапсырыс….
Dialogue: 0,0:06:08.27,0:06:10.27,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:06:14.77,0:06:16.78,Default,,0000,0000,0000,,Мамандыққа….
Dialogue: 0,0:06:16.78,0:06:20.61,Default,,0000,0000,0000,,Сіз келесі тапсырыстарды ала аласыз:
Dialogue: 0,0:06:16.78,0:06:20.61,Default,,0000,0000,0000,,Қашан?
Dialogue: 0,0:06:20.61,0:06:22.62,Default,,0000,0000,0000,,Мұндай күйде➡
Dialogue: 0,0:06:22.62,0:06:25.79,Default,,0000,0000,0000,,Орындауға болатын тапсырмалар үшін
Dialogue: 0,0:06:22.62,0:06:25.79,Default,,0000,0000,0000,,Менің ойымша, шектеулер бар...
Dialogue: 0,0:06:25.79,0:06:28.96,Default,,0000,0000,0000,,Виолет-чан. Сізді ауруханадан шығуыңызбен құттықтаймыз.
Dialogue: 0,0:06:28.96,0:06:31.79,Default,,0000,0000,0000,,Маған не ұнайтынын білмеймін
Dialogue: 0,0:06:28.96,0:06:31.79,Default,,0000,0000,0000,,Мен үшеуін сатып алдым➡
Dialogue: 0,0:06:31.79,0:06:33.79,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:06:33.79,0:06:35.96,Default,,0000,0000,0000,,Міндетті емес.
Dialogue: 0,0:06:33.79,0:06:35.96,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:35.96,0:06:39.63,Default,,0000,0000,0000,,Жоқ, біреуін таңдауым керек.
Dialogue: 0,0:06:35.96,0:06:39.63,Default,,0000,0000,0000,,Дүние бітті деп есептейік!
Dialogue: 0,0:06:39.63,0:06:41.63,Default,,0000,0000,0000,,Иә! 3! 2!
Dialogue: 0,0:06:41.63,0:06:44.34,Default,,0000,0000,0000,,Енді күшіктер үшін.
Dialogue: 0,0:06:41.63,0:06:44.34,Default,,0000,0000,0000,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:06:55.31,0:06:59.15,Default,,0000,0000,0000,,Неліктен күшік таңдадыңыз?
Dialogue: 0,0:06:59.15,0:07:02.09,Default,,0000,0000,0000,,Бұрын Майордың ағасына➡
Dialogue: 0,0:07:02.09,0:07:05.76,Default,,0000,0000,0000,,«Сен Гилберттің итісің».
Dialogue: 0,0:07:02.09,0:07:05.76,Default,,0000,0000,0000,,Өйткені маған айтты.
Dialogue: 0,0:07:05.76,0:07:09.60,Default,,0000,0000,0000,,Мм...! Бұл біраз ұзақ сапар болады.
Dialogue: 0,0:07:09.60,0:07:14.93,Default,,0000,0000,0000,,Темір жолдар осы жерде
Dialogue: 0,0:07:09.60,0:07:14.93,Default,,0000,0000,0000,,Өйткені ол бомбалау кезінде жойылған және оны пайдалану мүмкін емес.
Dialogue: 0,0:07:14.93,0:07:17.27,Default,,0000,0000,0000,,Сіз Лейденде болдыңыз ба?
Dialogue: 0,0:07:17.27,0:07:19.27,Default,,0000,0000,0000,,№.
Dialogue: 0,0:07:21.27,0:07:23.78,Default,,0000,0000,0000,,Гилберт
Dialogue: 0,0:07:21.27,0:07:23.78,Default,,0000,0000,0000,,Соғыстан кейін ➡
Dialogue: 0,0:07:23.78,0:07:27.11,Default,,0000,0000,0000,,Сіз өзіңізді қалай алып жүресіз
Dialogue: 0,0:07:23.78,0:07:27.11,Default,,0000,0000,0000,,Мен сені уайымдадым.
Dialogue: 0,0:07:27.11,0:07:29.45,Default,,0000,0000,0000,,Сонымен менің туыстарым➡
Dialogue: 0,0:07:29.45,0:07:31.78,Default,,0000,0000,0000,,Ең сенімді
Dialogue: 0,0:07:29.45,0:07:31.78,Default,,0000,0000,0000,,Эвергарден отбасына➡
Dialogue: 0,0:07:31.78,0:07:34.09,Default,,0000,0000,0000,,Ол сені өз қамқорлығына қалдырғысы келетінін айтты.
Dialogue: 0,0:07:37.96,0:07:40.79,Default,,0000,0000,0000,,Күйеуіңіз бен әйеліңізбен хабарласқаннан кейін➡
Dialogue: 0,0:07:40.79,0:07:43.63,Default,,0000,0000,0000,,Мен сіздің агент болғаныма қуаныштымын.
Dialogue: 0,0:07:40.79,0:07:43.63,Default,,0000,0000,0000,,➡ болу
Dialogue: 0,0:07:43.63,0:07:45.63,Default,,0000,0000,0000,,Сіз келістіңіз.
Dialogue: 0,0:07:48.80,0:07:50.80,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:52.81,0:07:54.97,Default,,0000,0000,0000,,Сізді осында көргеніме қуаныштымын.
Dialogue: 0,0:07:54.97,0:07:58.14,Default,,0000,0000,0000,,Кел, Виолет-чан.
Dialogue: 0,0:07:58.14,0:08:03.35,Default,,0000,0000,0000,,Бұл Эвергарден отбасының әйелі.
Dialogue: 0,0:07:58.14,0:08:03.35,Default,,0000,0000,0000,,Сәлемдесу.
Dialogue: 0,0:08:05.25,0:08:07.42,Default,,0000,0000,0000,,Жоқ, садақ жақсы болар еді.
Dialogue: 0,0:08:07.42,0:08:11.26,Default,,0000,0000,0000,,Енді Энченеден
Dialogue: 0,0:08:07.42,0:08:11.26,Default,,0000,0000,0000,,Үш күн қажет пе?
Dialogue: 0,0:08:11.26,0:08:14.59,Default,,0000,0000,0000,,Иә. Бастапқыда
Dialogue: 0,0:08:11.26,0:08:14.59,Default,,0000,0000,0000,,Бір күнде қайтуға мүмкіндік болды➡
Dialogue: 0,0:08:14.59,0:08:17.60,Default,,0000,0000,0000,,Соғыс төрт жылға созылды.
Dialogue: 0,0:08:17.60,0:08:21.60,Default,,0000,0000,0000,,Қалпына келтіру үшін
Dialogue: 0,0:08:17.60,0:08:21.60,Default,,0000,0000,0000,,Оған әлі біраз уақыт керек сияқты.
Dialogue: 0,0:08:21.60,0:08:25.81,Default,,0000,0000,0000,,Кел, Күлгін.
Dialogue: 0,0:08:21.60,0:08:25.81,Default,,0000,0000,0000,,Сіз де ішіңіз.
Dialogue: 0,0:08:29.11,0:08:31.44,Default,,0000,0000,0000,,А... Кешіріңіз!
Dialogue: 0,0:08:31.44,0:08:33.45,Default,,0000,0000,0000,,Өзіңізді мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:08:33.45,0:08:35.95,Default,,0000,0000,0000,,Қатты! Мен күйіп қаламын!
Dialogue: 0,0:08:35.95,0:08:37.95,Default,,0000,0000,0000,,Мәселе жоқ.
Dialogue: 0,0:08:37.95,0:08:39.95,Default,,0000,0000,0000,,Мен жылуды сезбеймін.
Dialogue: 0,0:08:39.95,0:08:42.46,Default,,0000,0000,0000,,Бірақ таңғыштар! Мен оны тез салқындатуым керек.
Dialogue: 0,0:08:42.46,0:08:45.26,Default,,0000,0000,0000,,Оливер, маған мұз әкел.
Dialogue: 0,0:08:42.46,0:08:45.26,Default,,0000,0000,0000,,Түсінді.
Dialogue: 0,0:08:47.29,0:08:50.63,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:08:47.29,0:08:50.63,Default,,0000,0000,0000,,Адаман күмісінен жасалған қол.
Dialogue: 0,0:08:50.63,0:08:53.30,Default,,0000,0000,0000,,Ол берік, бірақ берік.
Dialogue: 0,0:08:53.30,0:08:55.64,Default,,0000,0000,0000,,Мен оны әлі жаңадан білемін➡
Dialogue: 0,0:08:55.64,0:08:58.04,Default,,0000,0000,0000,,Менің ойымша, бұл ақырында проблемаға айналады.
Dialogue: 0,0:09:00.41,0:09:02.58,Default,,0000,0000,0000,,Хмм...хехе.
Dialogue: 0,0:09:02.58,0:09:05.75,Default,,0000,0000,0000,,Дәл осылай
Dialogue: 0,0:09:02.58,0:09:05.75,Default,,0000,0000,0000,,Келе аласыз ба?
Dialogue: 0,0:09:05.75,0:09:09.75,Default,,0000,0000,0000,,Жас кезімде
Dialogue: 0,0:09:05.75,0:09:09.75,Default,,0000,0000,0000,,Мен осылай пайдаландым.
Dialogue: 0,0:09:09.75,0:09:13.05,Default,,0000,0000,0000,,Бұл жақсы. Байқап көріңіз.
Dialogue: 0,0:09:16.42,0:09:20.23,Default,,0000,0000,0000,,Иә, бұл сізге сәйкес келеді.
Dialogue: 0,0:09:16.42,0:09:20.23,Default,,0000,0000,0000,,Рас.
Dialogue: 0,0:09:22.76,0:09:24.76,Default,,0000,0000,0000,,Бұл мен үшін.
Dialogue: 0,0:09:24.76,0:09:28.60,Default,,0000,0000,0000,,Себебі мен компанияға оралуым керек.
Dialogue: 0,0:09:24.76,0:09:28.60,Default,,0000,0000,0000,,О...
Dialogue: 0,0:09:28.60,0:09:30.60,Default,,0000,0000,0000,,Виолет-чан.
Dialogue: 0,0:09:30.60,0:09:33.44,Default,,0000,0000,0000,,Тиффани не айтты
Dialogue: 0,0:09:30.60,0:09:33.44,Default,,0000,0000,0000,,Мұқият тыңдаңыз.
Dialogue: 0,0:09:33.44,0:09:36.94,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:09:33.44,0:09:36.94,Default,,0000,0000,0000,,Көп уайымдамаңыз.
Dialogue: 0,0:09:36.94,0:09:39.28,Default,,0000,0000,0000,,Оларды сіздің нағыз ата-анаңыз деп ойлау➡
Dialogue: 0,0:09:39.28,0:09:42.08,Default,,0000,0000,0000,,Маған бірдеңе айтыңызшы.
Dialogue: 0,0:09:44.12,0:09:46.12,Default,,0000,0000,0000,,Маған...
Dialogue: 0,0:09:46.12,0:09:50.12,Default,,0000,0000,0000,,Менің ата-анам болмағандықтан,
Dialogue: 0,0:09:46.12,0:09:50.12,Default,,0000,0000,0000,,Ауыстыру қажет емес.
Dialogue: 0,0:09:50.12,0:09:53.46,Default,,0000,0000,0000,,Ха... олай айтпа.
Dialogue: 0,0:09:53.46,0:09:59.47,Default,,0000,0000,0000,,Ұлымыз болды.
Dialogue: 0,0:09:53.46,0:09:59.47,Default,,0000,0000,0000,,Соғыста қаза тапты.
Dialogue: 0,0:09:59.47,0:10:02.97,Default,,0000,0000,0000,,Мен қайтыс болған баламын
Dialogue: 0,0:09:59.47,0:10:02.97,Default,,0000,0000,0000,,алмастырғыш емес.
Dialogue: 0,0:10:02.97,0:10:05.97,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:10:02.97,0:10:05.97,Default,,0000,0000,0000,,Виолет-чан.
Dialogue: 0,0:10:05.97,0:10:10.48,Default,,0000,0000,0000,,Мұнда бақытты өмір сүру
Dialogue: 0,0:10:05.97,0:10:10.48,Default,,0000,0000,0000,,Бұл Гилберттің тілегі.
Dialogue: 0,0:10:10.48,0:10:14.48,Default,,0000,0000,0000,,Сонымен... түсіндім.
Dialogue: 0,0:10:14.48,0:10:27.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:10:27.99,0:10:30.00,Default,,0000,0000,0000,,Майор...!
Dialogue: 0,0:10:30.00,0:10:33.67,Default,,0000,0000,0000,,Неліктен майор Гилберт мені таңдады?
Dialogue: 0,0:10:30.00,0:10:33.67,Default,,0000,0000,0000,,Сіз оны осында қоясыз ба? ?
Dialogue: 0,0:10:33.67,0:10:35.67,Default,,0000,0000,0000,,Қолымнан айырылдым➡
Dialogue: 0,0:10:35.67,0:10:38.00,Default,,0000,0000,0000,,Құндылық қару ретінде
Dialogue: 0,0:10:35.67,0:10:38.00,Default,,0000,0000,0000,,Ол кеткендіктен бе? ?
Dialogue: 0,0:10:38.00,0:10:42.01,Default,,0000,0000,0000,,Сіз жаттыққаныңызша
Dialogue: 0,0:10:38.00,0:10:42.01,Default,,0000,0000,0000,,Мен тағы да күресе аламын!
Dialogue: 0,0:10:42.01,0:10:47.11,Default,,0000,0000,0000,,Виолет-чан
Dialogue: 0,0:10:42.01,0:10:47.11,Default,,0000,0000,0000,,Соғыс аяқталды.
Dialogue: 0,0:10:49.18,0:10:53.52,Default,,0000,0000,0000,,Мен майордың құралымын.
Dialogue: 0,0:10:49.18,0:10:53.52,Default,,0000,0000,0000,,Бірақ қажет болмаса➡
Dialogue: 0,0:10:53.52,0:10:55.86,Default,,0000,0000,0000,,Жою керек.
Dialogue: 0,0:10:55.86,0:10:58.69,Default,,0000,0000,0000,,Оны лақтырыңыз.
Dialogue: 0,0:10:58.69,0:11:01.89,Default,,0000,0000,0000,,Оны бір жерге лақтырыңыз.
Dialogue: 0,0:11:06.63,0:11:08.63,Default,,0000,0000,0000,,Подполковник Ходгинс.
Dialogue: 0,0:11:08.63,0:11:12.64,Default,,0000,0000,0000,,О, мен оны айтуды ұмытып кетіппін.
Dialogue: 0,0:11:08.63,0:11:12.64,Default,,0000,0000,0000,,Мен әскерден шықтым.
Dialogue: 0,0:11:12.64,0:11:14.97,Default,,0000,0000,0000,,Мен енді подполковник емеспін.
Dialogue: 0,0:11:14.97,0:11:16.98,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:11:14.97,0:11:16.98,Default,,0000,0000,0000,,Мен сені қалай атасам екен...
Dialogue: 0,0:11:16.98,0:11:19.08,Default,,0000,0000,0000,,Президент... Менің ойымша.
Dialogue: 0,0:11:21.15,0:11:23.65,Default,,0000,0000,0000,,Бұл менің компаниям.
Dialogue: 0,0:11:23.65,0:11:27.99,Default,,0000,0000,0000,,Ескі үй сатып алу
Dialogue: 0,0:11:23.65,0:11:27.99,Default,,0000,0000,0000,,Мен кейбір өзгерістер енгіздім.
Dialogue: 0,0:11:27.99,0:11:31.66,Default,,0000,0000,0000,,Бірінші қабат – қабылдау бөлмесі.
Dialogue: 0,0:11:31.66,0:11:35.16,Default,,0000,0000,0000,,Тұтынушы
Dialogue: 0,0:11:31.66,0:11:35.16,Default,,0000,0000,0000,,Осы слипте жеткізу мекенжайын және ➡ көрсетіңіз.
Dialogue: 0,0:11:35.16,0:11:37.83,Default,,0000,0000,0000,,Жіберушінің мекенжайы
Dialogue: 0,0:11:35.16,0:11:37.83,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:11:37.83,0:11:41.67,Default,,0000,0000,0000,,Жеткізу 3 күннен сәл артық уақытты алады
Dialogue: 0,0:11:37.83,0:11:41.67,Default,,0000,0000,0000,,Уақытыңызды бөлгеніңізге рахмет.
Dialogue: 0,0:11:41.67,0:11:44.34,Default,,0000,0000,0000,,Екінші қабат - кеңсе және елестер бөлімі.
Dialogue: 0,0:11:44.34,0:11:46.67,Default,,0000,0000,0000,,Ghostwriting?
Dialogue: 0,0:11:44.34,0:11:46.67,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:11:46.67,0:11:51.34,Default,,0000,0000,0000,,Клиенттің өтініші бойынша хаттар және т.б
Dialogue: 0,0:11:46.67,0:11:51.34,Default,,0000,0000,0000,,Оның орнына бұл жазу бөлімі.
Dialogue: 0,0:11:51.34,0:11:54.18,Default,,0000,0000,0000,,Әлі күнге дейін жаза алмайтындар көп.
Dialogue: 0,0:11:54.18,0:11:56.85,Default,,0000,0000,0000,,Мен де жаза алмадым.
Dialogue: 0,0:11:56.85,0:12:02.96,Default,,0000,0000,0000,,Майор маған сабақ бергенге дейін.
Dialogue: 0,0:11:56.85,0:12:02.96,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:12:02.96,0:12:05.29,Default,,0000,0000,0000,,Соғыс аяқталғанда➡
Dialogue: 0,0:12:05.29,0:12:07.79,Default,,0000,0000,0000,,Бір іс бастауға тырысу
Dialogue: 0,0:12:05.29,0:12:07.79,Default,,0000,0000,0000,,Ойлан.
Dialogue: 0,0:12:07.79,0:12:09.80,Default,,0000,0000,0000,,Мемлекеттік пошта қызметтері➡
Dialogue: 0,0:12:09.80,0:12:11.80,Default,,0000,0000,0000,,Тіпті жеке секторға
Dialogue: 0,0:12:09.80,0:12:11.80,Default,,0000,0000,0000,,Өйткені менің қолым жұмыс істемейді➡
Dialogue: 0,0:12:11.80,0:12:14.30,Default,,0000,0000,0000,,Мен бұл жұмыс істеуі мүмкін деп ойладым.
Dialogue: 0,0:12:14.30,0:12:16.30,Default,,0000,0000,0000,,Сонымен... бұл бұйрық.
Dialogue: 0,0:12:16.30,0:12:18.47,Default,,0000,0000,0000,,Күлгін Эвергарден.
Dialogue: 0,0:12:18.47,0:12:24.48,Default,,0000,0000,0000,,Гилберт сені маған сеніп тапсырды.
Dialogue: 0,0:12:18.47,0:12:24.48,Default,,0000,0000,0000,,Сондықтан оның орнына бұйрық беріңіз.
Dialogue: 0,0:12:24.48,0:12:28.48,Default,,0000,0000,0000,,Сіз әлі де пайдалысыз. Мен жұмыс істей аламын.
Dialogue: 0,0:12:28.48,0:12:30.78,Default,,0000,0000,0000,,Мұнда.
Dialogue: 0,0:12:32.82,0:12:36.16,Default,,0000,0000,0000,,Бенедикт.
Dialogue: 0,0:12:32.82,0:12:36.16,Default,,0000,0000,0000,,Бұл не, президент?
Dialogue: 0,0:12:36.16,0:12:38.99,Default,,0000,0000,0000,,«Бұл не, президент мырза?»
Dialogue: 0,0:12:38.99,0:12:41.16,Default,,0000,0000,0000,,Сонымен... бұл не?
Dialogue: 0,0:12:41.16,0:12:43.83,Default,,0000,0000,0000,,Бұл не?! ?
Dialogue: 0,0:12:41.16,0:12:43.83,Default,,0000,0000,0000,,Сен, енді әдейі!
Dialogue: 0,0:12:43.83,0:12:49.50,Default,,0000,0000,0000,,Бұл жігіт Пошташы Бенедикт.
Dialogue: 0,0:12:43.83,0:12:49.50,Default,,0000,0000,0000,,Біз компанияны ашпай тұрып та жақын қарым-қатынаста болдық.
Dialogue: 0,0:12:49.50,0:12:52.81,Default,,0000,0000,0000,,Бенедикт Ол Виолет.
Dialogue: 0,0:12:55.67,0:12:59.95,Default,,0000,0000,0000,,Бүгіннен бастап пошташы болып жұмыс істеймін.
Dialogue: 0,0:12:55.67,0:12:59.95,Default,,0000,0000,0000,,Осындай бала ма?
Dialogue: 0,0:12:59.95,0:13:05.45,Default,,0000,0000,0000,,Оның миссиясын орындау қабілеті ерекше.
Dialogue: 0,0:12:59.95,0:13:05.45,Default,,0000,0000,0000,,Мен банкке барамын➡
Dialogue: 0,0:13:05.45,0:13:08.05,Default,,0000,0000,0000,,Сен маған әртүрлі нәрселерді үйретші.
Dialogue: 0,0:13:10.12,0:13:12.63,Default,,0000,0000,0000,,Міне сіздің жүгіңіз.
Dialogue: 0,0:13:10.12,0:13:12.63,Default,,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:13:12.63,0:13:16.46,Default,,0000,0000,0000,,Біркелкі киім. Киіміңді ауыстыр.
Dialogue: 0,0:13:12.63,0:13:16.46,Default,,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:13:16.46,0:13:20.80,Default,,0000,0000,0000,,Мұнда жазылғандай
Dialogue: 0,0:13:16.46,0:13:20.80,Default,,0000,0000,0000,,Оны сол жақтағы сөреге қойыңыз.
Dialogue: 0,0:13:20.80,0:13:25.14,Default,,0000,0000,0000,,Менде көп пошта бар.
Dialogue: 0,0:13:20.80,0:13:25.14,Default,,0000,0000,0000,,Асықпаудың қажеті жоқ.
Dialogue: 0,0:13:25.14,0:13:30.14,Default,,0000,0000,0000,,Екінші қабатта демалыс бөлмесі де бар.
Dialogue: 0,0:13:25.14,0:13:30.14,Default,,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:13:32.14,0:13:34.15,Default,,0000,0000,0000,,Сонда кездескенше.
Dialogue: 0,0:13:34.15,0:13:51.50,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:51.50,0:13:54.17,Default,,0000,0000,0000,,Миссия жақында аяқталады.
Dialogue: 0,0:13:54.17,0:13:57.00,Default,,0000,0000,0000,,Сіз мұны бұрыннан істеп жүрсіз бе?
Dialogue: 0,0:13:54.17,0:13:57.00,Default,,0000,0000,0000,,Тіпті үзіліссіз бе?
Dialogue: 0,0:13:57.00,0:14:02.11,Default,,0000,0000,0000,,Біз ұзақ операцияларға үйреніп қалдық.
Dialogue: 0,0:13:57.00,0:14:02.11,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:14:02.11,0:14:05.11,Default,,0000,0000,0000,,Ал... келесі жолы...
Dialogue: 0,0:14:05.11,0:14:07.78,Default,,0000,0000,0000,,Жеткізу Мен оны қолданып көруім керек пе?
Dialogue: 0,0:14:05.11,0:14:07.78,Default,,0000,0000,0000,,Жеткізу….
Dialogue: 0,0:14:07.78,0:14:11.48,Default,,0000,0000,0000,,Жазбаша мекенжай ретінде
Dialogue: 0,0:14:07.78,0:14:11.48,Default,,0000,0000,0000,,Хатты жеткізу.
Dialogue: 0,0:14:15.12,0:14:18.52,Default,,0000,0000,0000,,Онда мен үйге барамын.
Dialogue: 0,0:14:21.13,0:14:23.13,Default,,0000,0000,0000,,Ертең кездескенше.
Dialogue: 0,0:14:25.13,0:14:27.13,Default,,0000,0000,0000,,Виолет-чан!
Dialogue: 0,0:14:27.13,0:14:29.47,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:14:29.47,0:14:33.14,Default,,0000,0000,0000,,Ха... Не істеп жатырсың! ?
Dialogue: 0,0:14:29.47,0:14:33.14,Default,,0000,0000,0000,,Жеткізу.
Dialogue: 0,0:14:33.14,0:14:35.14,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:14:35.14,0:14:38.48,Default,,0000,0000,0000,,Жоқ... Мен жеткізушімін.
Dialogue: 0,0:14:35.14,0:14:38.48,Default,,0000,0000,0000,,Мен мұны ертең жасауды жоспарлап едім!
Dialogue: 0,0:14:38.48,0:14:42.48,Default,,0000,0000,0000,,Және жұмыс ортасында
Dialogue: 0,0:14:38.48,0:14:42.48,Default,,0000,0000,0000,,Дұрыс үзіліс жасаңыз.
Dialogue: 0,0:14:42.48,0:14:44.48,Default,,0000,0000,0000,,Мен ауруханадан жаңа шықтым.
Dialogue: 0,0:14:44.48,0:14:47.99,Default,,0000,0000,0000,,Мәселе жоқ.
Dialogue: 0,0:14:44.48,0:14:47.99,Default,,0000,0000,0000,,Бұл сіз...
Dialogue: 0,0:14:47.99,0:14:51.66,Default,,0000,0000,0000,,Мәселе бар!
Dialogue: 0,0:14:47.99,0:14:51.66,Default,,0000,0000,0000,,Виолет-чан.
Dialogue: 0,0:14:51.66,0:14:53.66,Default,,0000,0000,0000,,Оны жеуге болады.
Dialogue: 0,0:14:55.66,0:14:57.66,Default,,0000,0000,0000,,Тамақтану.
Dialogue: 0,0:14:59.67,0:15:01.60,Default,,0000,0000,0000,,Тамақтанып болған соң, мен сені жұмысқа апарамын.
Dialogue: 0,0:15:01.60,0:15:04.10,Default,,0000,0000,0000,,Тек шатыр бар➡
Dialogue: 0,0:15:04.10,0:15:06.61,Default,,0000,0000,0000,,Ұйықтау үшін
Dialogue: 0,0:15:04.10,0:15:06.61,Default,,0000,0000,0000,,Өйткені мен мұны істедім.
Dialogue: 0,0:15:06.61,0:15:08.94,Default,,0000,0000,0000,,Ах... Эвергарден отбасы➡
Dialogue: 0,0:15:08.94,0:15:12.61,Default,,0000,0000,0000,,Андеррайтер үшін
Dialogue: 0,0:15:08.94,0:15:12.61,Default,,0000,0000,0000,,Бұл орындалатын сияқты.
Dialogue: 0,0:15:12.61,0:15:15.11,Default,,0000,0000,0000,,Ересек болғанша...
Dialogue: 0,0:15:15.11,0:15:18.78,Default,,0000,0000,0000,,Бірақ оны сарайға қою...
Dialogue: 0,0:15:18.78,0:15:20.79,Default,,0000,0000,0000,,Ақаулық болған болуы керек.
Dialogue: 0,0:15:20.79,0:15:22.79,Default,,0000,0000,0000,,Бұл….
Dialogue: 0,0:15:20.79,0:15:22.79,Default,,0000,0000,0000,,Сіз! Мен жұмсақпын➡
Dialogue: 0,0:15:22.79,0:15:25.12,Default,,0000,0000,0000,,Мен айттым ғой!
Dialogue: 0,0:15:22.79,0:15:25.12,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:15:25.12,0:15:27.53,Default,,0000,0000,0000,,Ертең кездескенше.
Dialogue: 0,0:15:30.13,0:15:32.13,Default,,0000,0000,0000,,Мен жіберемін.
Dialogue: 0,0:15:34.13,0:15:38.14,Default,,0000,0000,0000,,Сіз Гилберттенсіз.
Dialogue: 0,0:15:34.13,0:15:38.14,Default,,0000,0000,0000,,Соңында қандай тапсырыстар алдыңыз?
Dialogue: 0,0:15:38.14,0:15:41.64,Default,,0000,0000,0000,,Қаш...
Dialogue: 0,0:15:38.14,0:15:41.64,Default,,0000,0000,0000,,Еркін өмір сүру.
Dialogue: 0,0:15:41.64,0:15:45.84,Default,,0000,0000,0000,,Сосын... Ах.
Dialogue: 0,0:15:48.81,0:15:52.65,Default,,0000,0000,0000,,Кішкентай кезіңнен
Dialogue: 0,0:15:48.81,0:15:52.65,Default,,0000,0000,0000,,Ұзақ уақыт әскери қызметте болдым➡
Dialogue: 0,0:15:52.65,0:15:56.16,Default,,0000,0000,0000,,Тек тапсырманы орындау үшін
Dialogue: 0,0:15:52.65,0:15:56.16,Default,,0000,0000,0000,,Мен күнде өмір сүрдім.
Dialogue: 0,0:15:56.16,0:15:59.86,Default,,0000,0000,0000,,Бірақ... бұдан былай сен
Dialogue: 0,0:15:56.16,0:15:59.86,Default,,0000,0000,0000,,Сіз көп нәрсені үйренесіз.
Dialogue: 0,0:16:01.76,0:16:04.26,Default,,0000,0000,0000,,Бірақ үйренбегеніңіз жақсы...
Dialogue: 0,0:16:04.26,0:16:08.77,Default,,0000,0000,0000,,Білмеу жақсы...
Dialogue: 0,0:16:04.26,0:16:08.77,Default,,0000,0000,0000,,Сіз жайлы өмір сүре аласыз.
Dialogue: 0,0:16:08.77,0:16:12.27,Default,,0000,0000,0000,,Сіз... істеген істеріңіз үшін➡
Dialogue: 0,0:16:12.27,0:16:15.61,Default,,0000,0000,0000,,Денем өртеніп барады
Dialogue: 0,0:16:12.27,0:16:15.61,Default,,0000,0000,0000,,Өртте болу➡
Dialogue: 0,0:16:15.61,0:16:17.61,Default,,0000,0000,0000,,Мен әлі білмеймін.
Dialogue: 0,0:16:19.61,0:16:22.45,Default,,0000,0000,0000,,Жанбайды.
Dialogue: 0,0:16:19.61,0:16:22.45,Default,,0000,0000,0000,,Ол жанып тұр.
Dialogue: 0,0:16:22.45,0:16:26.29,Default,,0000,0000,0000,,Жанбайды. Бұл біртүрлі.
Dialogue: 0,0:16:22.45,0:16:26.29,Default,,0000,0000,0000,,Жоқ….
Dialogue: 0,0:16:26.29,0:16:28.59,Default,,0000,0000,0000,,Ол жанып жатыр...
Dialogue: 0,0:16:30.62,0:16:33.79,Default,,0000,0000,0000,,Мен саған осылай қарап тұрдым
Dialogue: 0,0:16:30.62,0:16:33.79,Default,,0000,0000,0000,,Жалғыз қалды.
Dialogue: 0,0:16:33.79,0:16:40.13,Default,,0000,0000,0000,,Сол себепті Гилберт сені маған сеніп тапсырған кезде
Dialogue: 0,0:16:33.79,0:16:40.13,Default,,0000,0000,0000,,Мен бұл менің мүмкіндігім деп ойладым.
Dialogue: 0,0:16:40.13,0:16:43.64,Default,,0000,0000,0000,,Бір күні менің айтқаным
Dialogue: 0,0:16:40.13,0:16:43.64,Default,,0000,0000,0000,,Түсінетін уақыт келеді.
Dialogue: 0,0:16:43.64,0:16:45.80,Default,,0000,0000,0000,,Және бірінші рет➡
Dialogue: 0,0:16:45.80,0:16:48.81,Default,,0000,0000,0000,,Өзімнен көп
Dialogue: 0,0:16:45.80,0:16:48.81,Default,,0000,0000,0000,,Сіз күйіп жатқаныңызды түсінесіз.
Dialogue: 0,0:16:48.81,0:17:11.10,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:11.10,0:17:13.10,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:17:13.10,0:17:16.60,Default,,0000,0000,0000,,Қуыршақ...?
Dialogue: 0,0:17:13.10,0:17:16.60,Default,,0000,0000,0000,,Жоқ, мен Виолетпін.
Dialogue: 0,0:17:16.60,0:17:19.44,Default,,0000,0000,0000,,Мм... Виолет ханым.
Dialogue: 0,0:17:19.44,0:17:23.44,Default,,0000,0000,0000,,Маған жазуыңызды өтінемін.
Dialogue: 0,0:17:19.44,0:17:23.44,Default,,0000,0000,0000,,Ауыстыру….
Dialogue: 0,0:17:26.45,0:17:29.78,Default,,0000,0000,0000,,Мен үшін бірінші рет
Dialogue: 0,0:17:26.45,0:17:29.78,Default,,0000,0000,0000,,Маған мейірімді болған адам...
Dialogue: 0,0:17:29.78,0:17:31.78,Default,,0000,0000,0000,,«Бұл сен едің».
Dialogue: 0,0:17:33.95,0:17:36.26,Default,,0000,0000,0000,,«Сіз
Dialogue: 0,0:17:33.95,0:17:36.26,Default,,0000,0000,0000,,Бұл бүкіл әлем болды».
Dialogue: 0,0:17:39.29,0:17:42.63,Default,,0000,0000,0000,,«Сіз үшін
Dialogue: 0,0:17:39.29,0:17:42.63,Default,,0000,0000,0000,,Менің қолымнан бәрі келеді».
Dialogue: 0,0:17:42.63,0:17:44.80,Default,,0000,0000,0000,,｟ngh... жүр! ｠
Dialogue: 0,0:17:44.80,0:17:48.63,Default,,0000,0000,0000,,(оқтар мен жарылыс дыбыстары)
Dialogue: 0,0:17:48.63,0:17:50.84,Default,,0000,0000,0000,,«Мен сенің сезіміңді білгім келеді».
Dialogue: 0,0:17:53.47,0:17:55.97,Default,,0000,0000,0000,,«Мен сенің жүрегіңді түсінгім келеді».
Dialogue: 0,0:17:57.98,0:18:03.08,Default,,0000,0000,0000,,«Біз қазір алыс болсақ та...
Dialogue: 0,0:18:03.08,0:18:05.48,Default,,0000,0000,0000,,Сіз туралы».
Dialogue: 0,0:18:08.75,0:18:12.42,Default,,0000,0000,0000,,«Мен сені сүйемін»
Dialogue: 0,0:18:08.75,0:18:12.42,Default,,0000,0000,0000,,(Норияки Какёин) 500 сингапур доллары.
Dialogue: 0,0:18:12.42,0:18:14.43,Default,,0000,0000,0000,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:18:16.43,0:18:18.43,Default,,0000,0000,0000,,«Мен сені сүйемін».
Dialogue: 0,0:18:20.43,0:18:25.10,Default,,0000,0000,0000,,сәйкес жөнелту процедурасы
Dialogue: 0,0:18:20.43,0:18:25.10,Default,,0000,0000,0000,,1-қабаттағы қабылдау бөлмесіне келіңіз.
Dialogue: 0,0:18:25.10,0:18:27.94,Default,,0000,0000,0000,,Мырза.
Dialogue: 0,0:18:27.94,0:18:33.95,Default,,0000,0000,0000,,Автоматты жады қуыршақ қызметін пайдалану
Dialogue: 0,0:18:27.94,0:18:33.95,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:18:41.45,0:18:44.26,Default,,0000,0000,0000,,Сонымен... сіз кімсіз?
Dialogue: 0,0:18:48.29,0:18:51.80,Default,,0000,0000,0000,,Сіз қайдан білесіз?
Dialogue: 0,0:18:48.29,0:18:51.80,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:51.80,0:18:55.80,Default,,0000,0000,0000,,Бұрынғы адам... «Мен сені сүйемін»➡
Dialogue: 0,0:18:55.80,0:18:58.10,Default,,0000,0000,0000,,Сіз қайдан білесіз?
Dialogue: 0,0:19:00.41,0:19:03.24,Default,,0000,0000,0000,,Автоматты жад қуыршағы
Dialogue: 0,0:19:00.41,0:19:03.24,Default,,0000,0000,0000,,Менің жұмыс істегім келеді! ?
Dialogue: 0,0:19:03.24,0:19:07.08,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:19:03.24,0:19:07.08,Default,,0000,0000,0000,,Қаламды ұстау әлі қиын➡
Dialogue: 0,0:19:07.08,0:19:09.92,Default,,0000,0000,0000,,Жазу машинкасын басқаруға болады.
Dialogue: 0,0:19:09.92,0:19:12.92,Default,,0000,0000,0000,,​​Жоқ, олай емес.
Dialogue: 0,0:19:09.92,0:19:12.92,Default,,0000,0000,0000,,Менің сұрайын дегенім➡
Dialogue: 0,0:19:12.92,0:19:15.02,Default,,0000,0000,0000,,Неліктен бұл жұмыс...?
Dialogue: 0,0:19:12.92,0:19:15.02,Default,,0000,0000,0000,,Мен білгім келеді!
Dialogue: 0,0:19:18.59,0:19:23.00,Default,,0000,0000,0000,,«Мен сені сүйемін» дегенді білгім келеді...
Dialogue: 0,0:19:25.10,0:19:27.77,Default,,0000,0000,0000,,Майордың соңғы бұйрығынан кейін➡
Dialogue: 0,0:19:27.77,0:19:31.10,Default,,0000,0000,0000,,Ол маған бұл сөздерді айтты.
Dialogue: 0,0:19:31.10,0:19:36.11,Default,,0000,0000,0000,,Бұл сөздер майордан шыққан.
Dialogue: 0,0:19:31.10,0:19:36.11,Default,,0000,0000,0000,,Бұл менің бірінші рет болды.
Dialogue: 0,0:19:36.11,0:19:40.28,Default,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:19:36.11,0:19:40.28,Default,,0000,0000,0000,,Ол қандай шартты білдіреді?➡
Dialogue: 0,0:19:40.28,0:19:44.45,Default,,0000,0000,0000,,Мен... түсінбеймін.
Dialogue: 0,0:19:44.45,0:19:47.45,Default,,0000,0000,0000,,Әдетте...
Dialogue: 0,0:19:47.45,0:19:51.79,Default,,0000,0000,0000,,Себебі мен мұны түсінемін
Dialogue: 0,0:19:47.45,0:19:51.79,Default,,0000,0000,0000,,Ол автоматты жад қуыршағына айналады.
Dialogue: 0,0:19:51.79,0:19:55.59,Default,,0000,0000,0000,,Бірақ... бұл жақсы.
Dialogue: 0,0:20:01.13,0:20:04.97,Default,,0000,0000,0000,,《Ходгинс: Гилберттің бұйрығымен
Dialogue: 0,0:20:01.13,0:20:04.97,Default,,0000,0000,0000,,Ол жай ғана соңынан ерді➡
Dialogue: 0,0:20:04.97,0:20:07.97,Default,,0000,0000,0000,,Ол бірінші рет өз еркін білдірді.
Dialogue: 0,0:20:07.97,0:20:12.31,Default,,0000,0000,0000,,Жүрек жоқ
Dialogue: 0,0:20:07.97,0:20:12.31,Default,,0000,0000,0000,,Оны құрал➡ деп атады
Dialogue: 0,0:20:12.31,0:20:14.81,Default,,0000,0000,0000,,«Мен сені сүйемін» деп білгім келетінін айттым》
Dialogue: 0,0:20:16.98,0:20:19.15,Default,,0000,0000,0000,,｟Ха… га….
Dialogue: 0,0:20:19.15,0:20:21.15,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:20:21.15,0:20:25.16,Default,,0000,0000,0000,,Мүлдем...
Dialogue: 0,0:20:21.15,0:20:25.16,Default,,0000,0000,0000,,Мен майордың өлуіне ешқашан жол бермеймін!
Dialogue: 0,0:20:25.16,0:20:28.33,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:20:25.16,0:20:28.33,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:20:28.33,0:20:30.33,Default,,0000,0000,0000,,Тоқта...
Dialogue: 0,0:20:32.83,0:20:34.83,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:20:34.83,0:20:37.67,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:20:37.67,0:20:41.17,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:20:37.67,0:20:41.17,Default,,0000,0000,0000,,Тікелей эфир.
Dialogue: 0,0:20:41.17,0:20:45.01,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:20:45.01,0:20:47.35,Default,,0000,0000,0000,,Күлгін….
Dialogue: 0,0:20:47.35,0:20:51.02,Default,,0000,0000,0000,,Сіз... тірісіз...
Dialogue: 0,0:20:51.02,0:20:53.62,Default,,0000,0000,0000,,Еркін бол.
Dialogue: 0,0:20:59.02,0:21:01.03,Default,,0000,0000,0000,,Құрметпен...
Dialogue: 0,0:21:06.47,0:21:08.47,Default,,0000,0000,0000,,Мен сені сүйемін｠
Dialogue: 0,0:21:17.64,0:21:19.81,Default,,0000,0000,0000,,｟Диетфрид: Эй, оян.
Dialogue: 0,0:21:19.81,0:21:28.65,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:28.65,0:21:30.66,Default,,0000,0000,0000,,Солтүстік-шығыс театрынан алынды.
Dialogue: 0,0:21:33.33,0:21:35.33,Default,,0000,0000,0000,,Аты...｠
Dialogue: 0,0:21:35.33,0:21:37.33,Default,,0000,0000,0000,,Бұл Виолет Эвергарден.
Dialogue: 0,0:21:37.33,0:21:41.67,Default,,0000,0000,0000,,Бүгіннен бастап Авто жад қуыршағы
Dialogue: 0,0:21:37.33,0:21:41.67,Default,,0000,0000,0000,,Ол шәкірт болып жұмыс істеуі керек еді.
Dialogue: 0,0:21:41.67,0:21:45.67,Default,,0000,0000,0000,,Жұмыс туралы және т.б.
Dialogue: 0,0:21:41.67,0:21:45.67,Default,,0000,0000,0000,,Маған көп нәрсені айтып беріңізші.
Dialogue: 0,0:21:45.67,0:21:47.67,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:47.67,0:21:50.18,Default,,0000,0000,0000,,Ең алдымен, иә...
Dialogue: 0,0:21:50.18,0:21:54.01,Default,,0000,0000,0000,,Автоматты жады қуыршақ жұмысына қатысты
Dialogue: 0,0:21:50.18,0:21:54.01,Default,,0000,0000,0000,,Сіз қаншалықты білесіз?
Dialogue: 0,0:21:54.01,0:21:58.18,Default,,0000,0000,0000,,Клиенттің өтініші бойынша
Dialogue: 0,0:21:54.01,0:21:58.18,Default,,0000,0000,0000,,Әріптер елес жазылатын бөлімде➡
Dialogue: 0,0:21:58.18,0:22:02.45,Default,,0000,0000,0000,,Подполковник Ходгинс… жоқ,
Dialogue: 0,0:21:58.18,0:22:02.45,Default,,0000,0000,0000,,Мен президенттен сұрадым.
Dialogue: 0,0:22:02.45,0:22:04.46,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:22:04.46,0:22:06.79,Default,,0000,0000,0000,,Толық түсіну деген нені білдіреді?
Dialogue: 0,0:22:04.46,0:22:06.79,Default,,0000,0000,0000,,Мен айта алмаймын➡
Dialogue: 0,0:22:06.79,0:22:09.96,Default,,0000,0000,0000,,Миссияны орындауға болатын сияқты.
Dialogue: 0,0:22:09.96,0:22:12.46,Default,,0000,0000,0000,,Бұл оңай
Dialogue: 0,0:22:09.96,0:22:12.46,Default,,0000,0000,0000,,Бұл жұмыс емес!
Dialogue: 0,0:22:12.46,0:22:18.30,Default,,0000,0000,0000,,Дәлірек айтқанда, миссиясы қандай? ?
Dialogue: 0,0:22:12.46,0:22:18.30,Default,,0000,0000,0000,,Айрис Тек жұмыс істей беріңіз.
Dialogue: 0,0:22:18.30,0:22:20.31,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:22:20.31,0:22:25.31,Default,,0000,0000,0000,,Ойланып қарашы, әлі емес.
Dialogue: 0,0:22:20.31,0:22:25.31,Default,,0000,0000,0000,,Сіз басқа қуыршақтарды таныстырған жоқсыз.
Dialogue: 0,0:22:25.31,0:22:28.81,Default,,0000,0000,0000,,Ал, қуыршақ дегенді қалай түсінесіңдер?
Dialogue: 0,0:22:25.31,0:22:28.81,Default,,0000,0000,0000,,Автоматты есте сақтайтын қуыршақ➡ аббревиатурасы
Dialogue: 0,0:22:28.81,0:22:32.15,Default,,0000,0000,0000,,Мен мұны өткен күні түсіндім.
Dialogue: 0,0:22:28.81,0:22:32.15,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:22:32.15,0:22:34.99,Default,,0000,0000,0000,,Бұрынғы бала Ол бала Айрис.
Dialogue: 0,0:22:34.99,0:22:37.82,Default,,0000,0000,0000,,Оқу курсын жаңадан бітіргендер
Dialogue: 0,0:22:34.99,0:22:37.82,Default,,0000,0000,0000,,Жаңадан келген.
Dialogue: 0,0:22:37.82,0:22:40.33,Default,,0000,0000,0000,,Содан кейін ол Эрика болатын.
Dialogue: 0,0:22:40.33,0:22:44.00,Default,,0000,0000,0000,,Ол және мен
Dialogue: 0,0:22:40.33,0:22:44.00,Default,,0000,0000,0000,,Мен қуыршақ ойнағаныма біраз болды➡
Dialogue: 0,0:22:44.00,0:22:46.67,Default,,0000,0000,0000,,Біздің компанияның өзі
Dialogue: 0,0:22:44.00,0:22:46.67,Default,,0000,0000,0000,,Әлі ерте күндер➡
Dialogue: 0,0:22:46.67,0:22:48.67,Default,,0000,0000,0000,,Барлығы жаңадан келген бала сияқты.
Dialogue: 0,0:22:48.67,0:22:52.50,Default,,0000,0000,0000,,Күлгін сені
Dialogue: 0,0:22:48.67,0:22:52.50,Default,,0000,0000,0000,,Жазу машинкасын пайдалануға бола ма?
Dialogue: 0,0:22:52.50,0:22:55.01,Default,,0000,0000,0000,,Ешқашан пайдаланылмаған.
Dialogue: 0,0:22:55.01,0:22:58.51,Default,,0000,0000,0000,,Ең алдымен
Dialogue: 0,0:22:55.01,0:22:58.51,Default,,0000,0000,0000,,Теруге жаттығудан бастайық па?
Dialogue: 0,0:22:58.51,0:23:00.78,Default,,0000,0000,0000,,Бұл оны қуыршақ етеді ме?
Dialogue: 0,0:23:00.78,0:23:05.28,Default,,0000,0000,0000,,Айрис, сен маған оқулығыңды бере аласың ба?
Dialogue: 0,0:23:00.78,0:23:05.28,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:23:08.29,0:23:10.96,Default,,0000,0000,0000,,Мм... отырыңыз.
Dialogue: 0,0:23:10.96,0:23:14.13,Default,,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:23:10.96,0:23:14.13,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:23:14.13,0:23:16.13,Default,,0000,0000,0000,,Ухуху.
Dialogue: 0,0:23:19.13,0:23:21.63,Default,,0000,0000,0000,,Әй, қолғаптар.
Dialogue: 0,0:23:19.13,0:23:21.63,Default,,0000,0000,0000,,Сіз оны алуыңыз керек.
Dialogue: 0,0:23:21.63,0:23:23.64,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:23:25.97,0:23:27.97,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:23:25.97,0:23:27.97,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:23:29.98,0:23:33.81,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:23:29.98,0:23:33.81,Default,,0000,0000,0000,,Мәселе жоқ.
Dialogue: 0,0:23:33.81,0:23:38.15,Default,,0000,0000,0000,,Иә... сонда
Dialogue: 0,0:23:33.81,0:23:38.15,Default,,0000,0000,0000,,Алдымен жасап көрейік.
Dialogue: 0,0:23:38.15,0:23:40.99,Default,,0000,0000,0000,,Қағазды осылай орнатыңыз.
Dialogue: 0,0:23:40.99,0:23:43.49,Default,,0000,0000,0000,,Оны айналдыру үшін тұтқаны бұраңыз.
Dialogue: 0,0:23:43.49,0:23:45.49,Default,,0000,0000,0000,,F және J➡
Dialogue: 0,0:23:45.49,0:23:48.99,Default,,0000,0000,0000,,Әрқайсысы сұқ саусағымен
Dialogue: 0,0:23:45.49,0:23:48.99,Default,,0000,0000,0000,,Байқап көріңіз.
Dialogue: 0,0:23:45.49,0:23:48.99,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:23:55.67,0:23:59.17,Default,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:23:59.17,0:24:03.11,Default,,0000,0000,0000,,Қалғаны таңбаларға сәйкес келеді
Dialogue: 0,0:23:59.17,0:24:03.11,Default,,0000,0000,0000,,Саусақтарыңыздың орнын есте сақтаңыз.
Dialogue: 0,0:24:03.11,0:24:06.61,Default,,0000,0000,0000,,Осы нұсқаулыққа сәйкес
Dialogue: 0,0:24:03.11,0:24:06.61,Default,,0000,0000,0000,,Теріп көріңіз... А?
Dialogue: 0,0:24:06.61,0:24:26.80,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:26.80,0:24:33.31,Default,,0000,0000,0000,,(дыбыс түрі)
Dialogue: 0,0:24:33.31,0:24:36.47,Default,,0000,0000,0000,,Ой... күте тұр... Күлгін?
Dialogue: 0,0:24:36.47,0:24:41.48,Default,,0000,0000,0000,,(дыбыс түрі)
Dialogue: 0,0:24:41.48,0:24:43.48,Default,,0000,0000,0000,,Күлгін! Тоқта!
Dialogue: 0,0:24:48.82,0:24:51.82,Default,,0000,0000,0000,,Тағы біраз...
Dialogue: 0,0:24:51.82,0:24:54.33,Default,,0000,0000,0000,,Тыныш... Эй.
Dialogue: 0,0:24:56.33,0:24:58.33,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:24:58.33,0:25:02.10,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:25:02.10,0:25:05.10,Default,,0000,0000,0000,,Иә, Виолет-чан
Dialogue: 0,0:25:02.10,0:25:05.10,Default,,0000,0000,0000,,Тұр.
Dialogue: 0,0:25:05.10,0:25:07.11,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:25:13.11,0:25:15.95,Default,,0000,0000,0000,,Иә, бұл сізге жарасады.
Dialogue: 0,0:25:15.95,0:25:19.95,Default,,0000,0000,0000,,Өйткені, бұл менің түрім
Dialogue: 0,0:25:15.95,0:25:19.95,Default,,0000,0000,0000,,Ешқандай қате болған жоқ.
Dialogue: 0,0:25:19.95,0:25:23.29,Default,,0000,0000,0000,,Ах, ақырында бұл...
Dialogue: 0,0:25:23.29,0:25:26.46,Default,,0000,0000,0000,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:25:26.46,0:25:28.46,Default,,0000,0000,0000,,Оны ашыңыз.
Dialogue: 0,0:25:30.46,0:25:32.46,Default,,0000,0000,0000,,Ашық.
Dialogue: 0,0:25:34.47,0:25:38.80,Default,,0000,0000,0000,,Міне...
Dialogue: 0,0:25:34.47,0:25:38.80,Default,,0000,0000,0000,,Ол осы мамандық атауын беруге тікелей шабыт болған —
Dialogue: 0,0:25:38.80,0:25:43.31,Default,,0000,0000,0000,,Қара базарда болды.
Dialogue: 0,0:25:38.80,0:25:43.31,Default,,0000,0000,0000,,Біреу сіздің жүгіңізді алып кетті➡
Dialogue: 0,0:25:43.31,0:25:45.31,Default,,0000,0000,0000,,Менің ойымша, бұл ұрланған.
Dialogue: 0,0:25:47.31,0:25:49.31,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:25:51.65,0:25:54.32,Default,,0000,0000,0000,,Иә! Күлгін➡
Dialogue: 0,0:25:54.32,0:25:56.99,Default,,0000,0000,0000,,Сіз қуыршақ дайындау курсына барасыз
Dialogue: 0,0:25:54.32,0:25:56.99,Default,,0000,0000,0000,,Барғыңыз келе ме?
Dialogue: 0,0:25:56.99,0:26:01.09,Default,,0000,0000,0000,,Подполковник Ходгинс… жоқ,
Dialogue: 0,0:25:56.99,0:26:01.09,Default,,0000,0000,0000,,Айрис те сонда барды.
Dialogue: 0,0:26:01.09,0:26:06.00,Default,,0000,0000,0000,,Мұғалім: Бұл өте қиын.
Dialogue: 0,0:26:01.09,0:26:06.00,Default,,0000,0000,0000,,Бұл пайдалы болады деп ойлаймын.
Dialogue: 0,0:26:10.44,0:26:16.78,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:26:16.78,0:26:27.45,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:26:27.45,0:26:29.62,Default,,0000,0000,0000,,Лейден - үлкен қала!
Dialogue: 0,0:26:29.62,0:26:34.96,Default,,0000,0000,0000,,Рас. Мен тұратын жерден айырмашылығы
Dialogue: 0,0:26:29.62,0:26:34.96,Default,,0000,0000,0000,,Жол көп болғандықтан адасып қалдым.
Dialogue: 0,0:26:34.96,0:26:38.80,Default,,0000,0000,0000,,Осы брошьмен
Dialogue: 0,0:26:34.96,0:26:38.80,Default,,0000,0000,0000,,Жұмыс табу үшін тиімді деп айтылады.
Dialogue: 0,0:26:38.80,0:26:41.30,Default,,0000,0000,0000,,Оқуымды бітіріп, үйге ерте барғым келеді.
Dialogue: 0,0:26:41.30,0:26:43.97,Default,,0000,0000,0000,,брошь
Dialogue: 0,0:26:41.30,0:26:43.97,Default,,0000,0000,0000,,Сіз мұны қаламайсыз ба?
Dialogue: 0,0:26:43.97,0:26:47.47,Default,,0000,0000,0000,,Ухуху, жоқ, хехуху….
Dialogue: 0,0:26:47.47,0:26:49.47,Default,,0000,0000,0000,,Тыныш!
Dialogue: 0,0:26:47.47,0:26:49.47,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:26:47.47,0:26:49.47,Default,,0000,0000,0000,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:27:00.42,0:27:05.09,Default,,0000,0000,0000,,Барлығы... Автоматты жад қуыршағы
Dialogue: 0,0:27:00.42,0:27:05.09,Default,,0000,0000,0000,,Оқу мектебіне қош келдіңіздер.
Dialogue: 0,0:27:05.09,0:27:07.09,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:27:07.09,0:27:09.09,Default,,0000,0000,0000,,Кешіріңіз!
Dialogue: 0,0:27:09.09,0:27:12.80,Default,,0000,0000,0000,,Егер сіз екі рет кешігіп қалсаңыз, ол сабаққа келмеген болып есептеледі.
Dialogue: 0,0:27:09.09,0:27:12.80,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:27:14.77,0:27:18.94,Default,,0000,0000,0000,,Ұлы Отан соғысы аяқталды
Dialogue: 0,0:27:14.77,0:27:18.94,Default,,0000,0000,0000,,Қуыршақтарға сұраныс өсуде.
Dialogue: 0,0:27:18.94,0:27:23.44,Default,,0000,0000,0000,,Әрине, біздің мектепке барудың қажеті жоқ.
Dialogue: 0,0:27:18.94,0:27:23.44,Default,,0000,0000,0000,,Қуыршаққа айналуға болады➡
Dialogue: 0,0:27:23.44,0:27:26.95,Default,,0000,0000,0000,,Біздің мақсатымыз
Dialogue: 0,0:27:23.44,0:27:26.95,Default,,0000,0000,0000,,Жай қуыршақ➡ емес
Dialogue: 0,0:27:26.95,0:27:30.28,Default,,0000,0000,0000,,Жақсы қуыршақтарды тәрбиелеу.
Dialogue: 0,0:27:30.28,0:27:34.45,Default,,0000,0000,0000,,Біздің мектепті бітіргендігінің дәлелі бірінші дәрежелі дәлел болып табылады.
Dialogue: 0,0:27:34.45,0:27:37.62,Default,,0000,0000,0000,,Бірақ мен
Dialogue: 0,0:27:34.45,0:27:37.62,Default,,0000,0000,0000,,Егер сіз оны жақсы қуыршақ деп танымасаңыз➡
Dialogue: 0,0:27:37.62,0:27:40.13,Default,,0000,0000,0000,,Бұл айғақ ешқашан берілмейді.
Dialogue: 0,0:27:42.13,0:27:44.46,Default,,0000,0000,0000,,Дайынсың ба?
Dialogue: 0,0:27:44.46,0:27:46.80,Default,,0000,0000,0000,,Түсінікті!
Dialogue: 0,0:27:46.80,0:27:48.80,Default,,0000,0000,0000,,Жақсы қуыршақ үшін➡
Dialogue: 0,0:27:48.80,0:27:52.30,Default,,0000,0000,0000,,Тек ауызша сөздерді транскрипциялай білу
Dialogue: 0,0:27:48.80,0:27:52.30,Default,,0000,0000,0000,,Теру жылдамдығы қажет.
Dialogue: 0,0:27:52.30,0:27:54.81,Default,,0000,0000,0000,,бастайық.
Dialogue: 0,0:27:57.31,0:27:59.81,Default,,0000,0000,0000,,(дыбыс түрі)
Dialogue: 0,0:27:59.81,0:28:02.25,Default,,0000,0000,0000,,Мистер Эвергарден
Dialogue: 0,0:27:59.81,0:28:02.25,Default,,0000,0000,0000,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:28:02.25,0:28:04.95,Default,,0000,0000,0000,,Жылдамдықты анықтау
Dialogue: 0,0:28:02.25,0:28:04.95,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:28:02.25,0:28:04.95,Default,,0000,0000,0000,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:28:06.92,0:28:10.92,Default,,0000,0000,0000,,Төзе бер, шыдай бер!
Dialogue: 0,0:28:06.92,0:28:10.92,Default,,0000,0000,0000,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,0:28:10.92,0:28:15.43,Default,,0000,0000,0000,,минутына 200 таңба.
Dialogue: 0,0:28:10.92,0:28:15.43,Default,,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:28:20.93,0:28:23.44,Default,,0000,0000,0000,,Ереуіл.
Dialogue: 0,0:28:20.93,0:28:23.44,Default,,0000,0000,0000,,Өтінемін.
Dialogue: 0,0:28:26.27,0:28:32.28,Default,,0000,0000,0000,,(дыбыс түрі)
Dialogue: 0,0:28:32.28,0:28:35.95,Default,,0000,0000,0000,,Қандай жақсы қуыршақ кию керек
Dialogue: 0,0:28:32.28,0:28:35.95,Default,,0000,0000,0000,,Хат қалай жазылады ➡
Dialogue: 0,0:28:35.95,0:28:38.45,Default,,0000,0000,0000,,Грамматика және лексика және ➡
Dialogue: 0,0:28:38.45,0:28:43.29,Default,,0000,0000,0000,,Әріп пішімдерінің алуан түрлілігі
Dialogue: 0,0:28:38.45,0:28:43.29,Default,,0000,0000,0000,,енгізілген.
Dialogue: 0,0:28:43.29,0:28:46.12,Default,,0000,0000,0000,,Барлығы осы.
Dialogue: 0,0:28:43.29,0:28:46.12,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:28:46.12,0:28:48.96,Default,,0000,0000,0000,,-де біз бүгінгі нәтижелерді жариялаймыз.
Dialogue: 0,0:28:48.96,0:28:50.96,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:28:48.96,0:28:50.96,Default,,0000,0000,0000,,Грамматикалық бағалар.
Dialogue: 0,0:28:50.96,0:28:53.80,Default,,0000,0000,0000,,Толық ұпай Виолет Эвергарден.
Dialogue: 0,0:28:53.80,0:28:55.80,Default,,0000,0000,0000,,Келесі сөздік жұмысын орындау.
Dialogue: 0,0:28:55.80,0:28:58.50,Default,,0000,0000,0000,,Толық ұпай Виолет Эвергарден.
Dialogue: 0,0:29:00.41,0:29:05.58,Default,,0000,0000,0000,,Бүгінгі сабақ шын мәнінде
Dialogue: 0,0:29:00.41,0:29:05.58,Default,,0000,0000,0000,,Сіздің атыңыздан хат жазуға машықтандыру.
Dialogue: 0,0:29:05.58,0:29:09.08,Default,,0000,0000,0000,,Танысқаныма қуаныштымын.
Dialogue: 0,0:29:05.58,0:29:09.08,Default,,0000,0000,0000,,Өтінемін, Лукулия мырза.
Dialogue: 0,0:29:09.08,0:29:12.08,Default,,0000,0000,0000,,(Студенттердің шуы)
Dialogue: 0,0:29:12.08,0:29:14.09,Default,,0000,0000,0000,,А...?
Dialogue: 0,0:29:14.09,0:29:16.99,Default,,0000,0000,0000,,Кімге хат жазғым келеді?
Dialogue: 0,0:29:18.92,0:29:22.59,Default,,0000,0000,0000,,Сезіміңізді жеткізгіңіз келеді
Dialogue: 0,0:29:18.92,0:29:22.59,Default,,0000,0000,0000,,Оны өзіңізге жақын адам етіңіз.
Dialogue: 0,0:29:22.59,0:29:26.26,Default,,0000,0000,0000,,Жақын адамдар...
Dialogue: 0,0:29:26.26,0:29:29.93,Default,,0000,0000,0000,,Мекен-жайы: Клаудия Ходгинс.
Dialogue: 0,0:29:29.93,0:29:34.27,Default,,0000,0000,0000,,Клаудия... Сіз доссыз ба? Сіздің отбасыңыз?
Dialogue: 0,0:29:29.93,0:29:34.27,Default,,0000,0000,0000,,Бұл президент.
Dialogue: 0,0:29:34.27,0:29:37.28,Default,,0000,0000,0000,,(дыбыс түрі)
Dialogue: 0,0:29:37.28,0:29:42.11,Default,,0000,0000,0000,,Есептің соңы.
Dialogue: 0,0:29:37.28,0:29:42.11,Default,,0000,0000,0000,,Күлгін Эвергарден.
Dialogue: 0,0:29:42.11,0:29:44.52,Default,,0000,0000,0000,,Ах... бұл соңы ма?
Dialogue: 0,0:29:46.45,0:29:48.45,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:29:48.45,0:29:52.29,Default,,0000,0000,0000,,«Майордан жаңа бұйрықтар
Dialogue: 0,0:29:48.45,0:29:52.29,Default,,0000,0000,0000,,Сіз оны әлі алған жоқсыз ба? ».
Dialogue: 0,0:29:52.29,0:29:54.29,Default,,0000,0000,0000,,қосыңыз.
Dialogue: 0,0:29:54.29,0:29:57.63,Default,,0000,0000,0000,,Қандай да бір себепті,
Dialogue: 0,0:29:54.29,0:29:57.63,Default,,0000,0000,0000,,Ол хаттан гөрі баяндамаға көбірек ұқсайды.
Dialogue: 0,0:29:57.63,0:30:01.80,Default,,0000,0000,0000,,Енді Лукулия мырзаның хатын оқыңыз.
Dialogue: 0,0:29:57.63,0:30:01.80,Default,,0000,0000,0000,,Бұл мен науқас болғанымнан ба!? Мен ондай емеспін! Мен қозғалған жоқпын!
Dialogue: 0,0:30:01.80,0:30:06.47,Default,,0000,0000,0000,,Мм... ағайын... жоқ.
Dialogue: 0,0:30:01.80,0:30:06.47,Default,,0000,0000,0000,,Мен оны ата-анама арнаймын.
Dialogue: 0,0:30:06.47,0:30:08.97,Default,,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:30:06.47,0:30:08.97,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:30:08.97,0:30:10.98,Default,,0000,0000,0000,,Ана мен әкеге➡
Dialogue: 0,0:30:10.98,0:30:14.65,Default,,0000,0000,0000,,Осы уақытқа дейін жасаған барлық істеріңіз үшін рахмет.
Dialogue: 0,0:30:10.98,0:30:14.65,Default,,0000,0000,0000,,Дұрыс айта алмаймын.
Dialogue: 0,0:30:14.65,0:30:17.82,Default,,0000,0000,0000,,Хмм, хат жазуға келгенде➡
Dialogue: 0,0:30:17.82,0:30:20.82,Default,,0000,0000,0000,,Менің айтарым бар.
Dialogue: 0,0:30:17.82,0:30:20.82,Default,,0000,0000,0000,,Жақсы шықпайды.
Dialogue: 0,0:30:20.82,0:30:25.16,Default,,0000,0000,0000,,О, біз бірге барған жер туралы.
Dialogue: 0,0:30:20.82,0:30:25.16,Default,,0000,0000,0000,,Барғыңыз келетін жер.
Dialogue: 0,0:30:25.16,0:30:27.66,Default,,0000,0000,0000,,Тым көп
Dialogue: 0,0:30:25.16,0:30:27.66,Default,,0000,0000,0000,,Мен сізге айтып жеткізе алмаймын.
Dialogue: 0,0:30:29.66,0:30:33.57,Default,,0000,0000,0000,,Сонда кездескенше.
Dialogue: 0,0:30:29.66,0:30:33.57,Default,,0000,0000,0000,,Уайымдамаңыз. Лукриядан.
Dialogue: 0,0:30:40.34,0:30:43.34,Default,,0000,0000,0000,,Күлгін Оны оқы.
Dialogue: 0,0:30:43.34,0:30:45.84,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:30:45.84,0:30:49.18,Default,,0000,0000,0000,,«Құрметті әке, ана.
Dialogue: 0,0:30:49.18,0:30:52.35,Default,,0000,0000,0000,,Соңғы рет хат жазғаныма біраз болды.
Dialogue: 0,0:30:49.18,0:30:52.35,Default,,0000,0000,0000,,Байланыс жоқ».
Dialogue: 0,0:30:52.35,0:30:54.35,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:30:52.35,0:30:54.35,Default,,0000,0000,0000,,«Бұрынғы мәселеге қатысты➡
Dialogue: 0,0:30:54.35,0:30:56.86,Default,,0000,0000,0000,,Алғыс білдірмеу
Dialogue: 0,0:30:54.35,0:30:56.86,Default,,0000,0000,0000,,Біз алаңдаймыз.
Dialogue: 0,0:30:56.86,0:31:00.46,Default,,0000,0000,0000,,Біз бірге барған жерлер
Dialogue: 0,0:30:56.86,0:31:00.46,Default,,0000,0000,0000,,Барғым келген жер туралы➡
Dialogue: 0,0:31:00.46,0:31:02.96,Default,,0000,0000,0000,,Тасымалдайтын ақпарат жоқ.
Dialogue: 0,0:31:02.96,0:31:05.46,Default,,0000,0000,0000,,Біз қазір қызу жұмыс істеп жатырмыз.
Dialogue: 0,0:31:05.46,0:31:09.80,Default,,0000,0000,0000,,Жағдай сау және қауіпсіз.
Dialogue: 0,0:31:05.46,0:31:09.80,Default,,0000,0000,0000,,Ешқандай ақаулық орын алған жоқ.
Dialogue: 0,0:31:09.80,0:31:13.30,Default,,0000,0000,0000,,Уайымдамаңыз.
Dialogue: 0,0:31:09.80,0:31:13.30,Default,,0000,0000,0000,,Лукулия».
Dialogue: 0,0:31:13.30,0:31:17.81,Default,,0000,0000,0000,,Сондықтан бұл әріп.
Dialogue: 0,0:31:13.30,0:31:17.81,Default,,0000,0000,0000,,Сіз айтасыз ба?
Dialogue: 0,0:31:17.81,0:31:22.65,Default,,0000,0000,0000,,А, у... мүмкін
Dialogue: 0,0:31:17.81,0:31:22.65,Default,,0000,0000,0000,,Мүмкін менің әңгімем тым дерексіз болған шығар.
Dialogue: 0,0:31:22.65,0:31:24.65,Default,,0000,0000,0000,,Мәселе бұл емес.
Dialogue: 0,0:31:24.65,0:31:28.32,Default,,0000,0000,0000,,Әріп дегеніміз не?
Dialogue: 0,0:31:24.65,0:31:28.32,Default,,0000,0000,0000,,Ең алдымен адамның жүрегін жеткізетін нәрсе.
Dialogue: 0,0:31:28.32,0:31:31.66,Default,,0000,0000,0000,,Жақсы қуыршақ дегеніміз не?
Dialogue: 0,0:31:28.32,0:31:31.66,Default,,0000,0000,0000,,Адамдардың айтқан сөздерінен➡
Dialogue: 0,0:31:31.66,0:31:34.66,Default,,0000,0000,0000,,Сіз жеткізгіңіз келетін шынайы сезімдер
Dialogue: 0,0:31:31.66,0:31:34.66,Default,,0000,0000,0000,,Бірдеңе алу керек.
Dialogue: 0,0:31:34.66,0:31:38.50,Default,,0000,0000,0000,,Күлгін
Dialogue: 0,0:31:34.66,0:31:38.50,Default,,0000,0000,0000,,Сіз оқуда жақсы оқыдыңыз➡
Dialogue: 0,0:31:38.50,0:31:41.00,Default,,0000,0000,0000,,Теру де өте жылдам және дәл.
Dialogue: 0,0:31:41.00,0:31:45.34,Default,,0000,0000,0000,,Бірақ мен үшін жазғаныңыз
Dialogue: 0,0:31:41.00,0:31:45.34,Default,,0000,0000,0000,,Оны әріп деп атауға болмайды.
Dialogue: 0,0:31:45.34,0:31:48.84,Default,,0000,0000,0000,,Мен оны хат деп айта алмаймын...
Dialogue: 0,0:31:48.84,0:31:52.14,Default,,0000,0000,0000,,Тағы бір рет...
Dialogue: 0,0:31:48.84,0:31:52.14,Default,,0000,0000,0000,,Бүгінгі күннің бәрі осы.
Dialogue: 0,0:31:54.18,0:31:56.68,Default,,0000,0000,0000,,Бүгін өзімді жақсы сезінбедім.
Dialogue: 0,0:31:56.68,0:32:00.62,Default,,0000,0000,0000,,Дәл осындай жағдай бұрын да болған
Dialogue: 0,0:31:56.68,0:32:00.62,Default,,0000,0000,0000,,Маған бұл туралы айтылды.
Dialogue: 0,0:32:00.62,0:32:02.62,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:32:06.46,0:32:09.46,Default,,0000,0000,0000,,Эй, осы қалада
Dialogue: 0,0:32:06.46,0:32:09.46,Default,,0000,0000,0000,,Ең керемет пейзаж➡
Dialogue: 0,0:32:09.46,0:32:11.46,Default,,0000,0000,0000,,Мен сізге айтамын.
Dialogue: 0,0:32:14.63,0:32:16.63,Default,,0000,0000,0000,,Мұнда.
Dialogue: 0,0:32:19.64,0:32:21.64,Default,,0000,0000,0000,,Бұл кенеттен, абай болыңыз.
Dialogue: 0,0:32:21.64,0:32:40.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:32:40.99,0:32:43.33,Default,,0000,0000,0000,,Керемет емес пе?
Dialogue: 0,0:32:43.33,0:32:48.03,Default,,0000,0000,0000,,Бала кезімнен,
Dialogue: 0,0:32:43.33,0:32:48.03,Default,,0000,0000,0000,,Маған бұл көрініс ұнайды.
Dialogue: 0,0:32:50.00,0:32:53.00,Default,,0000,0000,0000,,｟Гилберт: Күлгін.
Dialogue: 0,0:32:53.00,0:32:55.34,Default,,0000,0000,0000,,Бір күні саған➡
Dialogue: 0,0:32:55.34,0:33:00.35,Default,,0000,0000,0000,,Лейденнен көрінеді
Dialogue: 0,0:32:55.34,0:33:00.35,Default,,0000,0000,0000,,Мен сіздің сол әдемі көріністі көргеніңізді қалаймын｠
Dialogue: 0,0:33:05.45,0:33:07.62,Default,,0000,0000,0000,,Онда менмін.
Dialogue: 0,0:33:07.62,0:33:10.29,Default,,0000,0000,0000,,Жақында кездескенше.
Dialogue: 0,0:33:10.29,0:33:13.12,Default,,0000,0000,0000,,Лукулия мырза.
Dialogue: 0,0:33:10.29,0:33:13.12,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:33:13.12,0:33:16.46,Default,,0000,0000,0000,,Тек оны тазала, Күлгін.
Dialogue: 0,0:33:16.46,0:33:18.46,Default,,0000,0000,0000,,⚟Үйге қайт.
Dialogue: 0,0:33:18.46,0:33:21.63,Default,,0000,0000,0000,,Ал, олай айтпа.
Dialogue: 0,0:33:18.46,0:33:21.63,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:33:18.46,0:33:21.63,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:33:21.63,0:33:24.64,Default,,0000,0000,0000,,Үлкен аға! Мен тағы іштім! ?
Dialogue: 0,0:33:24.64,0:33:28.14,Default,,0000,0000,0000,,Не, ішпе!
Dialogue: 0,0:33:24.64,0:33:28.14,Default,,0000,0000,0000,,Қайтадан қош келдіңіз.
Dialogue: 0,0:33:28.14,0:33:30.64,Default,,0000,0000,0000,,Бұл жігіт маған ішуге рұқсат бермейді, сондықтан ішіңізші...
Dialogue: 0,0:33:30.64,0:33:32.81,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:33:30.64,0:33:32.81,Default,,0000,0000,0000,,Үлкен аға!
Dialogue: 0,0:33:32.81,0:33:37.15,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:33:32.81,0:33:37.15,Default,,0000,0000,0000,,Қарғыс атсын... Қап!
Dialogue: 0,0:33:37.15,0:33:39.15,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:33:43.99,0:33:46.16,Default,,0000,0000,0000,,Лукрия.
Dialogue: 0,0:33:46.16,0:33:49.16,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:33:49.16,0:33:51.16,Default,,0000,0000,0000,,Виолет-чан.
Dialogue: 0,0:33:51.16,0:33:53.16,Default,,0000,0000,0000,,Сізге кім хат жазады?
Dialogue: 0,0:33:51.16,0:33:53.16,Default,,0000,0000,0000,,Мен қуаныштымын➡
Dialogue: 0,0:33:53.16,0:33:55.67,Default,,0000,0000,0000,,Бұл баяндамаға ұқсайды.
Dialogue: 0,0:33:55.67,0:34:00.94,Default,,0000,0000,0000,,Менің де нұсқаушыға жазғаным
Dialogue: 0,0:33:55.67,0:34:00.94,Default,,0000,0000,0000,,Оны әріп деп атауға болмайды➡
Dialogue: 0,0:34:00.94,0:34:02.94,Default,,0000,0000,0000,,Оған назар аударылды.
Dialogue: 0,0:34:02.94,0:34:07.45,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:34:02.94,0:34:07.45,Default,,0000,0000,0000,,Ол жақсы қуыршақ бола ала ма?
Dialogue: 0,0:34:11.12,0:34:13.95,Default,,0000,0000,0000,,Bluebell Unoa.
Dialogue: 0,0:34:11.12,0:34:13.95,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:34:13.95,0:34:16.95,Default,,0000,0000,0000,,Иберис Конуэ.
Dialogue: 0,0:34:13.95,0:34:16.95,Default,,0000,0000,0000,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:34:16.95,0:34:19.79,Default,,0000,0000,0000,,Лукрия Моулборо.
Dialogue: 0,0:34:19.79,0:34:23.96,Default,,0000,0000,0000,,Лукрия Моулборо!
Dialogue: 0,0:34:19.79,0:34:23.96,Default,,0000,0000,0000,,Ах... Иә!
Dialogue: 0,0:34:23.96,0:34:27.30,Default,,0000,0000,0000,,Сонымен жоғарыдағы тоғыз адам
Dialogue: 0,0:34:23.96,0:34:27.30,Default,,0000,0000,0000,,Қазіргі түлегі ретінде.
Dialogue: 0,0:34:27.30,0:34:30.80,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:34:27.30,0:34:30.80,Default,,0000,0000,0000,,Сен жақсы қуыршақ болады деп сенемін.
Dialogue: 0,0:34:30.80,0:34:33.64,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:34:30.80,0:34:33.64,Default,,0000,0000,0000,,Қай жерде қуыршақ боласың?
Dialogue: 0,0:34:33.64,0:34:35.64,Default,,0000,0000,0000,,Мен жергілікті пошта бөлімшесімін.
Dialogue: 0,0:34:35.64,0:34:38.14,Default,,0000,0000,0000,,Мен оны Лейденнен іздейтін шығармын.
Dialogue: 0,0:34:38.14,0:34:40.81,Default,,0000,0000,0000,,Лукрия туралы не деуге болады?
Dialogue: 0,0:34:38.14,0:34:40.81,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:34:40.81,0:34:44.65,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:34:40.81,0:34:44.65,Default,,0000,0000,0000,,Мен әлі ештеңе шешкен жоқпын.
Dialogue: 0,0:34:44.65,0:34:47.82,Default,,0000,0000,0000,,Е-е, сіз өз бағаларыңыздың жоғарғы жағында болсаңыз да.
Dialogue: 0,0:34:47.82,0:34:50.82,Default,,0000,0000,0000,,Түсіндім... бұл ұят болды.
Dialogue: 0,0:34:50.82,0:34:54.83,Default,,0000,0000,0000,,Кешірім сұраймыз.
Dialogue: 0,0:34:50.82,0:34:54.83,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:34:54.83,0:34:58.50,Default,,0000,0000,0000,,Оқуды бітіре алмасаң да
Dialogue: 0,0:34:54.83,0:34:58.50,Default,,0000,0000,0000,,Қуыршақ бола алмайтын сияқты.
Dialogue: 0,0:34:58.50,0:35:00.43,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:35:00.43,0:35:03.43,Default,,0000,0000,0000,,Сонда не үшін?
Dialogue: 0,0:35:00.43,0:35:03.43,Default,,0000,0000,0000,,Сен мектепке бардың ба?
Dialogue: 0,0:35:05.44,0:35:09.11,Default,,0000,0000,0000,,Шынында да…
Dialogue: 0,0:35:05.44,0:35:09.11,Default,,0000,0000,0000,,Бітіру бәрі емес➡
Dialogue: 0,0:35:09.11,0:35:11.44,Default,,0000,0000,0000,,Адамдардың айтқан сөздерінен➡
Dialogue: 0,0:35:11.44,0:35:15.28,Default,,0000,0000,0000,,Сіз жеткізгіңіз келетін жүрек
Dialogue: 0,0:35:11.44,0:35:15.28,Default,,0000,0000,0000,,Ол алынбауы мүмкін➡
Dialogue: 0,0:35:15.28,0:35:17.78,Default,,0000,0000,0000,,Қуыршақтың мағынасы жоқ.
Dialogue: 0,0:35:17.78,0:35:28.79,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:35:28.79,0:35:30.80,Default,,0000,0000,0000,,Күтілгендей
Dialogue: 0,0:35:28.79,0:35:30.80,Default,,0000,0000,0000,,Мен сені осында келеді деп ойладым.
Dialogue: 0,0:35:30.80,0:35:33.13,Default,,0000,0000,0000,,Лукрия….
Dialogue: 0,0:35:33.13,0:35:36.47,Default,,0000,0000,0000,,Мектеп бітсе де
Dialogue: 0,0:35:33.13,0:35:36.47,Default,,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,0:35:36.47,0:35:38.97,Default,,0000,0000,0000,,Хмм... Келсеңіздер➡
Dialogue: 0,0:35:38.97,0:35:41.81,Default,,0000,0000,0000,,Тағы да сізге
Dialogue: 0,0:35:38.97,0:35:41.81,Default,,0000,0000,0000,,Мен сені кездестіре аламын ба деп ойладым.
Dialogue: 0,0:35:41.81,0:35:44.31,Default,,0000,0000,0000,,Сәлем Күлгін.
Dialogue: 0,0:35:44.31,0:35:47.31,Default,,0000,0000,0000,,Лейден – айтарлықтай үлкен қала ғой?
Dialogue: 0,0:35:47.31,0:35:50.48,Default,,0000,0000,0000,,Сіз әр уақытта хаттың соңында➡
Dialogue: 0,0:35:50.48,0:35:53.82,Default,,0000,0000,0000,,«Сіз майордан хат алдыңыз ба?»
Онда
Dialogue: 0,0:35:50.48,0:35:53.82,Default,,0000,0000,0000,,делінген.
Dialogue: 0,0:35:53.82,0:35:58.49,Default,,0000,0000,0000,,Сіз шынымен кімге хат жазғыңыз келеді?
Dialogue: 0,0:35:53.82,0:35:58.49,Default,,0000,0000,0000,,Бұл адам емес пе?
Dialogue: 0,0:35:58.49,0:36:01.43,Default,,0000,0000,0000,,Бүгін сол адамға
Dialogue: 0,0:35:58.49,0:36:01.43,Default,,0000,0000,0000,,Хат жазғыңыз келе ме?
Dialogue: 0,0:36:01.43,0:36:03.93,Default,,0000,0000,0000,,Әдеттегі
Dialogue: 0,0:36:01.43,0:36:03.93,Default,,0000,0000,0000,,Бұл есеп сияқты емес➡
Dialogue: 0,0:36:03.93,0:36:06.93,Default,,0000,0000,0000,,Сіздің шынайы сезімдеріңіз
Dialogue: 0,0:36:03.93,0:36:06.93,Default,,0000,0000,0000,,Құрамында хат.
Dialogue: 0,0:36:08.93,0:36:11.54,Default,,0000,0000,0000,,Мен сенімен соңына дейін бірге боламын.
Dialogue: 0,0:36:16.27,0:36:18.28,Default,,0000,0000,0000,,Майор….
Dialogue: 0,0:36:18.28,0:36:20.28,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:36:20.28,0:36:22.28,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:36:22.28,0:36:24.45,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:36:24.45,0:36:29.29,Default,,0000,0000,0000,,Мен... сол адамға
Dialogue: 0,0:36:24.45,0:36:29.29,Default,,0000,0000,0000,,Нені жеткізгіңіз келеді➡
Dialogue: 0,0:36:29.29,0:36:32.46,Default,,0000,0000,0000,,Мен тіпті білмеймін.
Dialogue: 0,0:36:32.46,0:36:34.46,Default,,0000,0000,0000,,Мен әлі➡
Dialogue: 0,0:36:34.46,0:36:36.79,Default,,0000,0000,0000,,Ол кісі маған айтты
Dialogue: 0,0:36:34.46,0:36:36.79,Default,,0000,0000,0000,,Тіпті сөздердің мағынасы➡
Dialogue: 0,0:36:36.79,0:36:39.30,Default,,0000,0000,0000,,Себебі сіз түсінбейсіз.
Dialogue: 0,0:36:41.30,0:36:45.10,Default,,0000,0000,0000,,Неліктен Күлгін?
Dialogue: 0,0:36:41.30,0:36:45.10,Default,,0000,0000,0000,,Қуыршақ болғың келді ме?
Dialogue: 0,0:36:48.81,0:36:51.98,Default,,0000,0000,0000,,Мен... "Мен сені сүйемін"
Dialogue: 0,0:36:48.81,0:36:51.98,Default,,0000,0000,0000,,Мен білгім келеді.
Dialogue: 0,0:36:51.98,0:36:56.08,Default,,0000,0000,0000,,А... «Мен сені сүйемін» деп білгім келеді...
Dialogue: 0,0:36:58.15,0:37:01.05,Default,,0000,0000,0000,,Жүрегіңді жеткізу қиын.
Dialogue: 0,0:37:03.25,0:37:08.09,Default,,0000,0000,0000,,Негізі менің ата-анам қайтыс болды.
Dialogue: 0,0:37:08.09,0:37:12.10,Default,,0000,0000,0000,,Қалған жалғыз отбасы – менің ағам.
Dialogue: 0,0:37:12.10,0:37:17.60,Default,,0000,0000,0000,,Мен... ағама.
Dialogue: 0,0:37:12.10,0:37:17.60,Default,,0000,0000,0000,,Мен не айтарымды білмеймін.
Dialogue: 0,0:37:17.60,0:37:23.61,Default,,0000,0000,0000,,Соғыс басталғанда, інім
Dialogue: 0,0:37:17.60,0:37:23.61,Default,,0000,0000,0000,,Мен жауынгер ретінде ұрысқа шықтым.
Dialogue: 0,0:37:23.61,0:37:29.11,Default,,0000,0000,0000,,Бірақ ол орналастырылған Батыс майданы
Dialogue: 0,0:37:23.61,0:37:29.11,Default,,0000,0000,0000,,Ұрыс болған жоқ дерлік.
Dialogue: 0,0:37:29.11,0:37:33.12,Default,,0000,0000,0000,,Әрқашан ұрыс болады
Dialogue: 0,0:37:29.11,0:37:33.12,Default,,0000,0000,0000,,Алыс жерде болып жатқан оқиға➡
Dialogue: 0,0:37:33.12,0:37:39.46,Default,,0000,0000,0000,,Біз әрқашан әңгіме сияқты болдық
Dialogue: 0,0:37:33.12,0:37:39.46,Default,,0000,0000,0000,,Бұл соғыс сияқты болды.
Dialogue: 0,0:37:39.46,0:37:41.63,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:37:41.63,0:37:45.46,Default,,0000,0000,0000,,Әке мен ана
Dialogue: 0,0:37:41.63,0:37:45.46,Default,,0000,0000,0000,,Мен Хернеге сауда ісімен барғанымда...
Dialogue: 0,0:37:45.46,0:37:48.57,Default,,0000,0000,0000,,Батыс майданы
Dialogue: 0,0:37:45.46,0:37:48.57,Default,,0000,0000,0000,,Осылайша сіз бұзып шықтыңыз.
Dialogue: 0,0:37:50.64,0:37:54.84,Default,,0000,0000,0000,,Әкесі де, анасы да
Dialogue: 0,0:37:50.64,0:37:54.84,Default,,0000,0000,0000,,Тіпті заттар да табылмады.
Dialogue: 0,0:37:57.64,0:37:59.64,Default,,0000,0000,0000,,Соғыс аяқталды.
Dialogue: 0,0:38:01.58,0:38:03.75,Default,,0000,0000,0000,,Ағам аман-есен оралды.
Dialogue: 0,0:38:03.75,0:38:08.92,Default,,0000,0000,0000,,Тіпті менің ағам да
Dialogue: 0,0:38:03.75,0:38:08.92,Default,,0000,0000,0000,,Оның тірі екеніне қуанғым келді.
Dialogue: 0,0:38:08.92,0:38:10.92,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:38:10.92,0:38:13.92,Default,,0000,0000,0000,,Менің ағамда Херне бар
Dialogue: 0,0:38:10.92,0:38:13.92,Default,,0000,0000,0000,,Мен сені қорғай алмағаныма өкінемін...
Dialogue: 0,0:38:13.92,0:38:19.10,Default,,0000,0000,0000,,Әкесі мен анасы қайтыс болды
Dialogue: 0,0:38:13.92,0:38:19.10,Default,,0000,0000,0000,,Бұл менің кінәм деп ойлаймын.
Dialogue: 0,0:38:19.10,0:38:21.10,Default,,0000,0000,0000,,Кейін қалсаң, капитан мені сөгіп тастайды.
Dialogue: 0,0:38:21.10,0:38:23.77,Default,,0000,0000,0000,,Гах!
Dialogue: 0,0:38:23.77,0:38:26.77,Default,,0000,0000,0000,,Қайта бетіңді көрсетпе.
Dialogue: 0,0:38:23.77,0:38:26.77,Default,,0000,0000,0000,,Хехе….
Dialogue: 0,0:38:26.77,0:38:30.94,Default,,0000,0000,0000,,Гуах! Апыр-ай! Апыр-ай!
Dialogue: 0,0:38:30.94,0:38:36.78,Default,,0000,0000,0000,,Шындық – бұл... Шындық – әділ➡
Dialogue: 0,0:38:36.78,0:38:38.98,Default,,0000,0000,0000,,Тек мені тірі қалдырғаны үшін
Dialogue: 0,0:38:36.78,0:38:38.98,Default,,0000,0000,0000,,Мен бақыттымын.
Dialogue: 0,0:38:40.95,0:38:44.79,Default,,0000,0000,0000,,Ух... у...
Dialogue: 0,0:38:44.79,0:38:48.63,Default,,0000,0000,0000,,Рахмет...
Dialogue: 0,0:38:44.79,0:38:48.63,Default,,0000,0000,0000,,Мен жай ғана айтқым келеді.
Dialogue: 0,0:38:48.63,0:38:51.46,Default,,0000,0000,0000,,(қағу дыбысы)
Dialogue: 0,0:38:51.46,0:38:56.07,Default,,0000,0000,0000,,Көпке дейін... Айта алмаймын...
Dialogue: 0,0:38:59.30,0:39:02.74,Default,,0000,0000,0000,,Лукулия Хат жазайық.
Dialogue: 0,0:39:02.74,0:39:04.91,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:39:04.91,0:39:08.71,Default,,0000,0000,0000,,Өзіңіз жеткізгіңіз келетін сезімдер
Dialogue: 0,0:39:04.91,0:39:08.71,Default,,0000,0000,0000,,Оны әріп түрінде жазайық.
Dialogue: 0,0:39:12.75,0:39:16.09,Default,,0000,0000,0000,,Бірақ... ағама.
Dialogue: 0,0:39:12.75,0:39:16.09,Default,,0000,0000,0000,,Мен сізге айтамын деп ойлаған кезде➡
Dialogue: 0,0:39:16.09,0:39:18.09,Default,,0000,0000,0000,,№.
Dialogue: 0,0:39:18.09,0:39:21.93,Default,,0000,0000,0000,,Осы уақытқа дейін, қайта-қайта
Dialogue: 0,0:39:18.09,0:39:21.93,Default,,0000,0000,0000,,Мен сізге айтуға тырыстым➡
Dialogue: 0,0:39:21.93,0:39:24.26,Default,,0000,0000,0000,,Бірақ бұл жақсы емес...
Dialogue: 0,0:39:24.26,0:39:26.60,Default,,0000,0000,0000,,Мен қазірден бастап сенімдімін.
Dialogue: 0,0:39:26.60,0:39:29.43,Default,,0000,0000,0000,,Рахмет, Виолет.
Dialogue: 0,0:39:29.43,0:39:32.24,Default,,0000,0000,0000,,Майорға басқа уақытта жазамын.
Dialogue: 0,0:39:34.27,0:39:36.97,Default,,0000,0000,0000,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:39:38.94,0:39:41.11,Default,,0000,0000,0000,,«Жақсы қуыршақ дегеніміз не?
Dialogue: 0,0:39:41.11,0:39:43.28,Default,,0000,0000,0000,,сөздерден➡
Dialogue: 0,0:39:43.28,0:39:47.28,Default,,0000,0000,0000,,Сіз жеткізгіңіз келетін шынайы сезімдер
Dialogue: 0,0:39:43.28,0:39:47.28,Default,,0000,0000,0000,,Бірдеңе жинап алу керек».
Dialogue: 0,0:39:56.79,0:39:58.80,Default,,0000,0000,0000,,｟Луклия: Үлкен аға.
Dialogue: 0,0:40:00.80,0:40:02.80,Default,,0000,0000,0000,,Ағай, күте тұрыңыз.
Dialogue: 0,0:40:02.80,0:40:05.30,Default,,0000,0000,0000,,Қараңыз... мм.
Dialogue: 0,0:40:05.30,0:40:07.64,Default,,0000,0000,0000,,Хэхе...
Dialogue: 0,0:40:07.64,0:40:10.47,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:40:10.47,0:40:12.64,Default,,0000,0000,0000,,Осылай жылдам.
Dialogue: 0,0:40:12.64,0:40:15.65,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:40:15.65,0:40:18.48,Default,,0000,0000,0000,,Өте әдемі.
Dialogue: 0,0:40:18.48,0:40:20.48,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:40:18.48,0:40:20.48,Default,,0000,0000,0000,,Уау｠
Dialogue: 0,0:40:20.48,0:40:40.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:40:40.00,0:40:42.84,Default,,0000,0000,0000,,Мм...!
Dialogue: 0,0:40:42.84,0:40:44.84,Default,,0000,0000,0000,,қуыршақтай киімінен мүлде алшақ еді—
Dialogue: 0,0:40:44.84,0:40:46.84,Default,,0000,0000,0000,,Анталькурия….
Dialogue: 0,0:40:48.85,0:40:54.02,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:40:48.85,0:40:54.02,Default,,0000,0000,0000,,Миссия... жоқ, бұл тапсырма.
Dialogue: 0,0:40:54.02,0:40:56.19,Default,,0000,0000,0000,,Жоқ... бұл хат.
Dialogue: 0,0:40:56.19,0:40:59.02,Default,,0000,0000,0000,,Лукулиядан сізге.
Dialogue: 0,0:40:59.02,0:41:01.63,Default,,0000,0000,0000,,Жылдамдық көрсетілмеген.
Dialogue: 0,0:41:01.63,0:41:13.80,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:41:13.80,0:41:16.14,Default,,0000,0000,0000,,«Үлкен аға.
Dialogue: 0,0:41:16.14,0:41:19.31,Default,,0000,0000,0000,,Тірі болғаныңызға рахмет...
Dialogue: 0,0:41:19.31,0:41:21.31,Default,,0000,0000,0000,,Мен бақыттымын.''
Dialogue: 0,0:41:21.31,0:41:23.81,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:41:23.81,0:41:25.82,Default,,0000,0000,0000,,«Рахмет.»
Dialogue: 0,0:41:25.82,0:41:35.33,Default,,0000,0000,0000,,(жылайды)
Dialogue: 0,0:41:35.33,0:41:45.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:41:45.00,0:41:47.84,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:41:47.84,0:41:51.34,Default,,0000,0000,0000,,Күлгін! Ха… ха….
Dialogue: 0,0:41:51.34,0:41:54.01,Default,,0000,0000,0000,,Лукрия... Не болды?
Dialogue: 0,0:41:51.34,0:41:54.01,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:41:54.01,0:41:56.01,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:41:58.02,0:42:00.28,Default,,0000,0000,0000,,Қайырлы таң Күлгін.
Dialogue: 0,0:42:00.28,0:42:03.79,Default,,0000,0000,0000,,Инструкторлық мектеп аяқталуы керек...
Dialogue: 0,0:42:03.79,0:42:07.46,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:42:03.79,0:42:07.46,Default,,0000,0000,0000,,Мен рұқсатсыз сұрадым.
Dialogue: 0,0:42:07.46,0:42:10.46,Default,,0000,0000,0000,,Бұл хат
Dialogue: 0,0:42:07.46,0:42:10.46,Default,,0000,0000,0000,,Мен оны Лукулияға көрсеттім.
Dialogue: 0,0:42:10.46,0:42:14.47,Default,,0000,0000,0000,,Сіз жаздыңыз
Dialogue: 0,0:42:10.46,0:42:14.47,Default,,0000,0000,0000,,Лукулияның ағаңызға жазған хаты.
Dialogue: 0,0:42:16.47,0:42:19.64,Default,,0000,0000,0000,,Көпке дейін айта алмадым
Dialogue: 0,0:42:16.47,0:42:19.64,Default,,0000,0000,0000,,Ініме деген сезім.
Dialogue: 0,0:42:19.64,0:42:24.34,Default,,0000,0000,0000,,Ирис! Қайтып келгеніңе қуаныштымын.
Dialogue: 0,0:42:19.64,0:42:24.34,Default,,0000,0000,0000,,Сіз оны жеткіздіңіз.
Dialogue: 0,0:42:26.98,0:42:29.15,Default,,0000,0000,0000,,Жақсы қуыршақ дегеніміз не?➡
Dialogue: 0,0:42:29.15,0:42:31.65,Default,,0000,0000,0000,,Адамдардың айтқан сөздерінен➡
Dialogue: 0,0:42:31.65,0:42:35.65,Default,,0000,0000,0000,,Сіз жеткізгіңіз келетін шынайы сезімдер
Dialogue: 0,0:42:31.65,0:42:35.65,Default,,0000,0000,0000,,Бірдеңе алу керек.
Dialogue: 0,0:42:35.65,0:42:39.66,Default,,0000,0000,0000,,Сіз қазірсіз
Dialogue: 0,0:42:35.65,0:42:39.66,Default,,0000,0000,0000,,Біз бұл қадамды жасадық.
Dialogue: 0,0:42:39.66,0:42:42.16,Default,,0000,0000,0000,,Күлгін.
Dialogue: 0,0:42:44.50,0:42:49.00,Default,,0000,0000,0000,,Фалко, мен саған бір өтінішпен жүгінер едім…
Dialogue: 0,0:42:44.50,0:42:49.00,Default,,0000,0000,0000,,Сен жақсы қуыршақ болады деп сенемін.
Dialogue: 0,0:42:49.00,0:42:52.84,Default,,0000,0000,0000,,Кешегі ойын
Dialogue: 0,0:42:49.00,0:42:52.84,Default,,0000,0000,0000,,Бұл өте жақсы болды.
Dialogue: 0,0:42:52.84,0:42:56.01,Default,,0000,0000,0000,,Күлгін
Dialogue: 0,0:42:52.84,0:42:56.01,Default,,0000,0000,0000,,Мен оны көруге баруым керек еді.
Dialogue: 0,0:42:56.01,0:42:59.34,Default,,0000,0000,0000,,Егер бұл «Қызыл шайтан» болса
Dialogue: 0,0:42:56.01,0:42:59.34,Default,,0000,0000,0000,,Мен қазір пьеса оқып жатырмын.
Dialogue: 0,0:42:59.34,0:43:01.78,Default,,0000,0000,0000,,Аа, жақсы.
Dialogue: 0,0:43:01.78,0:43:05.12,Default,,0000,0000,0000,,Оскар Вебстердің елес сценарийі?
Dialogue: 0,0:43:01.78,0:43:05.12,Default,,0000,0000,0000,,Мен қызғаншақпын.
Dialogue: 0,0:43:05.12,0:43:08.95,Default,,0000,0000,0000,,Өйткені оның жаңа жұмысы бірінші орында тұрды.
Dialogue: 0,0:43:05.12,0:43:08.95,Default,,0000,0000,0000,,Бұл сіз оны оқи аласыз дегенді білдіре ме?
Dialogue: 0,0:43:08.95,0:43:12.56,Default,,0000,0000,0000,,Аяқтағаннан кейін
Dialogue: 0,0:43:08.95,0:43:12.56,Default,,0000,0000,0000,,Бұл менің біраз уақыттан кейінгі алғашқы жаңа жұмысым.
Dialogue: 0,0:43:14.96,0:43:19.30,Default,,0000,0000,0000,,«А, мен бұл күнәға кінәлімін.
Dialogue: 0,0:43:14.96,0:43:19.30,Default,,0000,0000,0000,,Менің арқамда осы жүкпен өмір сүруден басқа амалым жоқ.
Dialogue: 0,0:43:19.30,0:43:22.30,Default,,0000,0000,0000,,Өмірімнің соңына дейін».
Dialogue: 0,0:43:22.30,0:43:46.16,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:43:46.16,0:43:49.83,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:43:46.16,0:43:49.83,Default,,0000,0000,0000,,Автоматты жад қуыршақ қызметі.
Dialogue: 0,0:43:49.83,0:43:53.00,Default,,0000,0000,0000,,Бұл не...?
Dialogue: 0,0:43:53.00,0:43:55.50,Default,,0000,0000,0000,,Мен сені бірінші рет көремін.
Dialogue: 0,0:43:55.50,0:43:59.84,Default,,0000,0000,0000,,Тұтынушы қаласа
Dialogue: 0,0:43:55.50,0:43:59.84,Default,,0000,0000,0000,,Мен кез келген жерге асығамын.
Dialogue: 0,0:43:59.84,0:44:02.11,Default,,0000,0000,0000,,Автоматты жад қуыршақ қызметі➡
Dialogue: 0,0:44:02.11,0:44:05.28,Default,,0000,0000,0000,,Бұл Виолет Эвергарден.
Dialogue: 0,0:44:05.28,0:44:07.44,Default,,0000,0000,0000,,Бірақ мен таң қалдым.
Dialogue: 0,0:44:07.44,0:44:10.61,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:44:07.44,0:44:10.61,Default,,0000,0000,0000,,Мен мұндай бала келеді деп күтпедім.
Dialogue: 0,0:44:10.61,0:44:12.62,Default,,0000,0000,0000,,Егер сұрауыңызды қанағаттандыра алмасақ➡
Dialogue: 0,0:44:12.62,0:44:15.62,Default,,0000,0000,0000,,Тағы бір қуыршақ
Dialogue: 0,0:44:12.62,0:44:15.62,Default,,0000,0000,0000,,Біз келісімдер жасаймыз.
Dialogue: 0,0:44:15.62,0:44:19.12,Default,,0000,0000,0000,,Жоқ. Теріп алсам болды.
Dialogue: 0,0:44:19.12,0:44:22.96,Default,,0000,0000,0000,,Мен қазір өзімді жақсы сезінбеймін...
Dialogue: 0,0:44:22.96,0:44:24.96,Default,,0000,0000,0000,,Кешіріңіз➡
Dialogue: 0,0:44:24.96,0:44:27.46,Default,,0000,0000,0000,,Жұмыс кезінде
Dialogue: 0,0:44:24.96,0:44:27.46,Default,,0000,0000,0000,,Алкогольді ішуден бас тартыңыз➡
Dialogue: 0,0:44:27.46,0:44:29.47,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:44:31.47,0:44:33.47,Default,,0000,0000,0000,,Ішпейінше жаза алмаймын.
Dialogue: 0,0:44:33.47,0:44:38.08,Default,,0000,0000,0000,,Мен жазамын.
Dialogue: 0,0:44:33.47,0:44:38.08,Default,,0000,0000,0000,,Ал, ертең жазуды бастайық.
Dialogue: 0,0:44:41.48,0:44:44.15,Default,,0000,0000,0000,,Сіз қиналған адамсыз.
Dialogue: 0,0:44:44.15,0:44:49.65,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:44:49.65,0:44:55.49,Default,,0000,0000,0000,,Күйеу, сенің жазғаныңа қарсы емеспін.
Dialogue: 0,0:44:49.65,0:44:55.49,Default,,0000,0000,0000,,Мен оны тазаладым.
Dialogue: 0,0:44:55.49,0:45:00.43,Default,,0000,0000,0000,,Мен өзімнің жазу машинкамды әкелемін.
Dialogue: 0,0:44:55.49,0:45:00.43,Default,,0000,0000,0000,,Сізде формалар бар ма?
Dialogue: 0,0:45:00.43,0:45:05.27,Default,,0000,0000,0000,,Жоқ. Ол порттағы дүкенде сатылады.
Dialogue: 0,0:45:00.43,0:45:05.27,Default,,0000,0000,0000,,Маған сатып алуыңызды өтінемін.
Dialogue: 0,0:45:05.27,0:45:10.11,Default,,0000,0000,0000,,Ал кешкі асқа... Маған карбонара ұнайды.
Dialogue: 0,0:45:10.11,0:45:13.78,Default,,0000,0000,0000,,Мырза, мен елес жазушымын.
Dialogue: 0,0:45:10.11,0:45:13.78,Default,,0000,0000,0000,,Қызметшіде….
Dialogue: 0,0:45:13.78,0:45:17.11,Default,,0000,0000,0000,,
Dialogue: 0,0:45:17.11,0:45:19.32,Default,,0000,0000,0000,,Сіз қиындыққа тап болдыңыз.
Dialogue: 0,0:45:21.45,0:45:24.79,Default,,0000,0000,0000,,Менде сіз сұраған мәзірге арналған ингредиенттер бар.
Dialogue: 0,0:45:24.79,0:45:27.79,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:45:27.79,0:45:30.63,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:45:27.79,0:45:30.63,Default,,0000,0000,0000,,Сізде не бар?
Dialogue: 0,0:45:30.63,0:45:34.80,Default,,0000,0000,0000,,Жоқ, сен мұны қалай істедің?
Dialogue: 0,0:45:30.63,0:45:34.80,Default,,0000,0000,0000,,Мүмкін мен оны жай ғана пісіруім керек.
Dialogue: 0,0:45:34.80,0:45:38.30,Default,,0000,0000,0000,,Иә? қабықты жару
Dialogue: 0,0:45:34.80,0:45:38.30,Default,,0000,0000,0000,,Тек сарысын ғана бөліңіз.
Dialogue: 0,0:45:38.30,0:45:40.30,Default,,0000,0000,0000,,Сіз?
Dialogue: 0,0:45:40.30,0:45:48.81,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:45:48.81,0:45:50.98,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:45:50.98,0:45:53.32,Default,,0000,0000,0000,,Мен тамақ дайындауда өз күшімді сынап жатырмын.
Dialogue: 0,0:45:53.32,0:46:03.43,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:46:03.43,0:46:07.76,Default,,0000,0000,0000,,Ал... бірінші рет.
Dialogue: 0,0:46:03.43,0:46:07.76,Default,,0000,0000,0000,,Керемет емес пе?
Dialogue: 0,0:46:07.76,0:46:09.77,Default,,0000,0000,0000,,Егер біз сіздің үмітіңізді ақтамаған болсақ
Dialogue: 0,0:46:09.77,0:46:13.27,Default,,0000,0000,0000,,Мен оны кейінірек аламын.
Dialogue: 0,0:46:09.77,0:46:13.27,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:46:21.95,0:46:26.78,Default,,0000,0000,0000,,Келесі Зәйтүн жолдары.
Dialogue: 0,0:46:21.95,0:46:26.78,Default,,0000,0000,0000,,«Мен мына от алқабынан өтуім керек➡
Dialogue: 0,0:46:26.78,0:46:30.45,Default,,0000,0000,0000,,Құбыжықты өлтіру үшін мен қылыш ала алмаймын.''
Dialogue: 0,0:46:30.45,0:46:33.79,Default,,0000,0000,0000,,Су рухы пайда болады.
Dialogue: 0,0:46:33.79,0:46:35.79,Default,,0000,0000,0000,,Рух диалогы.
Dialogue: 0,0:46:35.79,0:46:38.30,Default,,0000,0000,0000,,«Мен бұл өртті сөндіремін.
Dialogue: 0,0:46:38.30,0:46:41.30,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:46:38.30,0:46:41.30,Default,,0000,0000,0000,,Мен бұл аңғардан өте аламын.''
Dialogue: 0,0:46:41.30,0:46:44.64,Default,,0000,0000,0000,,Сіз оны жеңе аласыз.
Dialogue: 0,0:46:41.30,0:46:44.64,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:46:44.64,0:46:49.14,Default,,0000,0000,0000,,Жанып тұрған от сөнеді.
Dialogue: 0,0:46:49.14,0:46:51.31,Default,,0000,0000,0000,,Жарайды, міне, гострайтингі тапсырысы формасы.
Dialogue: 0,0:46:51.31,0:46:54.81,Default,,0000,0000,0000,,Сахнада желбіреп тұрған қызыл мата
Dialogue: 0,0:46:51.31,0:46:54.81,Default,,0000,0000,0000,,Қайтарылған кезде➡
Dialogue: 0,0:46:54.81,0:46:57.15,Default,,0000,0000,0000,,Жоғалған сияқты, солай ма?
Dialogue: 0,0:46:57.15,0:47:01.08,Default,,0000,0000,0000,,Мен көрдім. Мен оны түсіндім.
Dialogue: 0,0:47:01.08,0:47:06.26,Default,,0000,0000,0000,,Эй, сен қалай ойлайсың? Қызық па?
Dialogue: 0,0:47:06.26,0:47:08.26,Default,,0000,0000,0000,,Мұны қалай айта аламын...
Dialogue: 0,0:47:08.26,0:47:10.26,Default,,0000,0000,0000,,Оны қалай айтасыз?
Dialogue: 0,0:47:10.26,0:47:16.10,Default,,0000,0000,0000,,Бұл шынайы оқиға емес
Dialogue: 0,0:47:10.26,0:47:16.10,Default,,0000,0000,0000,,Мен мұны өз басымнан өткізіп жатқан сияқтымын.
Dialogue: 0,0:47:16.10,0:47:20.10,Default,,0000,0000,0000,,Мен олив есімді қызбен бірге болдым.
Dialogue: 0,0:47:16.10,0:47:20.10,Default,,0000,0000,0000,,Сол сияқты➡
Dialogue: 0,0:47:20.10,0:47:22.77,Default,,0000,0000,0000,,Қуанышты немесе қайғылы➡
Dialogue: 0,0:47:22.77,0:47:25.11,Default,,0000,0000,0000,,Сізді не алаңдатады?
Dialogue: 0,0:47:25.11,0:47:28.11,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:47:28.11,0:47:32.78,Default,,0000,0000,0000,,Бұл сіз және басты кейіпкер... және Олив➡
Dialogue: 0,0:47:32.78,0:47:35.79,Default,,0000,0000,0000,,Сіз де солай сезінесіз деп үміттенемін.
Dialogue: 0,0:47:32.78,0:47:35.79,Default,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:47:35.79,0:47:40.12,Default,,0000,0000,0000,,Зәйтүнге жаны ашиды.
Dialogue: 0,0:47:40.12,0:47:44.29,Default,,0000,0000,0000,,Сенің солай сезінгенің үшін мен жеңілдеп қалдым.
Dialogue: 0,0:47:44.29,0:47:48.47,Default,,0000,0000,0000,,Балаларға арналған пьесалар жазу
Dialogue: 0,0:47:44.29,0:47:48.47,Default,,0000,0000,0000,,Бұл менің бірінші рет.
Dialogue: 0,0:47:48.47,0:47:52.80,Default,,0000,0000,0000,,Осыдан кейін Зәйтүн отты алқапты кесіп өтеді➡
Dialogue: 0,0:47:52.80,0:47:56.81,Default,,0000,0000,0000,,Қылышты қауіпсіз алыңыз
Dialogue: 0,0:47:52.80,0:47:56.81,Default,,0000,0000,0000,,Сіз құбыжықтарды өлтіріп жатырсыз, солай ма?
Dialogue: 0,0:47:56.81,0:48:03.25,Default,,0000,0000,0000,,Ах. Бірақ орнына
Dialogue: 0,0:47:56.81,0:48:03.25,Default,,0000,0000,0000,,Сіз рухты пайдаланушының күшін жоғалтасыз.
Dialogue: 0,0:48:03.25,0:48:07.42,Default,,0000,0000,0000,,Міне. Сонда қалай?
Dialogue: 0,0:48:03.25,0:48:07.42,Default,,0000,0000,0000,,Сіз туған қалаңызға қайтасыз ба?
Dialogue: 0,0:48:07.42,0:48:11.59,Default,,0000,0000,0000,,Кеме де зақымдалған...
Dialogue: 0,0:48:11.59,0:48:13.59,Default,,0000,0000,0000,,Мен бұл туралы әлі ойлаған жоқпын.
Dialogue: 0,0:48:13.59,0:48:15.93,Default,,0000,0000,0000,,Мен бұл туралы ойлануым керек.
Dialogue: 0,0:48:15.93,0:48:20.23,Default,,0000,0000,0000,,Егер сіз бұл туралы ойланбасаңыз
Dialogue: 0,0:48:15.93,0:48:20.23,Default,,0000,0000,0000,,Мен әкем күтіп тұрған үйге бара алмаймын.
Dialogue: 0,0:48:23.43,0:48:26.54,Default,,0000,0000,0000,,(Эрика) Кешегі қойылым керемет болды.
Dialogue: 0,0:48:30.27,0:48:33.28,Default,,0000,0000,0000,,Ауа райы жақсы.
Dialogue: 0,0:48:33.28,0:48:36.78,Default,,0000,0000,0000,,Жоқ. Тым жақсы.
Dialogue: 0,0:48:36.78,0:48:39.45,Default,,0000,0000,0000,,Мырза.
Dialogue: 0,0:48:39.45,0:48:41.45,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:48:41.45,0:48:44.29,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:48:44.29,0:48:47.79,Default,,0000,0000,0000,,Бұл жай ғана қолшатыр. Неліктен?
Dialogue: 0,0:48:47.79,0:48:51.60,Default,,0000,0000,0000,,Өте
Dialogue: 0,0:48:47.79,0:48:51.60,Default,,0000,0000,0000,,Мен бұл әдемі қолшатыр деп ойладым.
Dialogue: 0,0:48:55.97,0:49:00.57,Default,,0000,0000,0000,,Маған біраз демалуға рұқсат етіңіз.
Dialogue: 0,0:49:00.57,0:49:02.57,Default,,0000,0000,0000,,(есік жабылған дыбыс)
Dialogue: 0,0:49:02.57,0:49:15.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:49:15.09,0:49:20.92,Default,,0000,0000,0000,,｟Оливия: Бір күні...
Dialogue: 0,0:49:15.09,0:49:20.92,Default,,0000,0000,0000,,Мен оны саған бір күні міндетті түрде көрсетемін｠
Dialogue: 0,0:49:20.92,0:49:22.93,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:49:25.43,0:49:27.43,Default,,0000,0000,0000,,Тоқта.
Dialogue: 0,0:49:27.43,0:49:31.60,Default,,0000,0000,0000,,Кешірім сұраймыз.
Dialogue: 0,0:49:27.43,0:49:31.60,Default,,0000,0000,0000,,Рұқсатсыз қолшатыр...
Dialogue: 0,0:49:27.43,0:49:31.60,Default,,0000,0000,0000,,Қоғамдық махаббат хатынан бері —
Dialogue: 0,0:49:31.60,0:49:34.10,Default,,0000,0000,0000,,Жетеді...
Dialogue: 0,0:49:34.10,0:49:36.31,Default,,0000,0000,0000,,Артқа оралу.
Dialogue: 0,0:49:38.28,0:49:41.45,Default,,0000,0000,0000,,Сонда пьеса толық болмайды!
Dialogue: 0,0:49:41.45,0:49:44.61,Default,,0000,0000,0000,,Оливтің әңгімесі толық емес!
Dialogue: 0,0:49:44.61,0:49:46.62,Default,,0000,0000,0000,,Сіздің күйеуіңіз➡
Dialogue: 0,0:49:46.62,0:49:51.62,Default,,0000,0000,0000,,Сіз жүрегіңізде бір нәрсені жасырып отырсыз.
Dialogue: 0,0:49:46.62,0:49:51.62,Default,,0000,0000,0000,,емес пе? ?
Dialogue: 0,0:49:51.62,0:49:56.13,Default,,0000,0000,0000,,Маған
Dialogue: 0,0:49:51.62,0:49:56.13,Default,,0000,0000,0000,,Оны түсінуге мүмкіндігім жоқ➡
Dialogue: 0,0:49:56.13,0:50:00.03,Default,,0000,0000,0000,,Мен шынымен... кешіріңіз.
Dialogue: 0,0:50:02.47,0:50:05.97,Default,,0000,0000,0000,,Мен... Мен енді ештеңе жаза алмаймын.
Dialogue: 0,0:50:05.97,0:50:08.64,Default,,0000,0000,0000,,Бірақ біз бұлай жалғастыра алмаймыз.
Dialogue: 0,0:50:08.64,0:50:11.14,Default,,0000,0000,0000,,Мен сол қыз туралы солай ойладым...
Dialogue: 0,0:50:11.14,0:50:15.65,Default,,0000,0000,0000,,Мен Оливияға айтқан оқиғам
Dialogue: 0,0:50:11.14,0:50:15.65,Default,,0000,0000,0000,,Мен оны аяқтауды ойладым...
Dialogue: 0,0:50:15.65,0:50:17.98,Default,,0000,0000,0000,,Оливия….
Dialogue: 0,0:50:17.98,0:50:21.82,Default,,0000,0000,0000,,Әй, қызым.
Dialogue: 0,0:50:21.82,0:50:24.99,Default,,0000,0000,0000,,Әйелім сырқаттан қайтыс болды➡
Dialogue: 0,0:50:24.99,0:50:30.79,Default,,0000,0000,0000,,Саяжай болған мына сарайға
Dialogue: 0,0:50:24.99,0:50:30.79,Default,,0000,0000,0000,,Мен қызымның үйіне көшіп келдім.
Dialogue: 0,0:50:32.83,0:50:35.50,Default,,0000,0000,0000,,Мен анамды сағындым деп ойлаймын.
Dialogue: 0,0:50:35.50,0:50:40.17,Default,,0000,0000,0000,,Бірақ... бірақ олай емес.
Dialogue: 0,0:50:35.50,0:50:40.17,Default,,0000,0000,0000,,Маған кішкене болса да көрсетпе.
Dialogue: 0,0:50:40.17,0:50:44.17,Default,,0000,0000,0000,,штамп картаңды қатты үнемдеп жинап, дәл қолданар сәтте оның мерзімі өтіп кеткенін байқағандай жүз жаса,
Dialogue: 0,0:50:40.17,0:50:44.17,Default,,0000,0000,0000,,Жұмыста қолымнан келгеннің барлығын жасай алуым үшін➡
Dialogue: 0,0:50:44.17,0:50:47.84,Default,,0000,0000,0000,,Әрқашан, әртүрлі заттар
Dialogue: 0,0:50:44.17,0:50:47.84,Default,,0000,0000,0000,,Ол маған көмектесті.
Dialogue: 0,0:50:47.84,0:50:54.65,Default,,0000,0000,0000,,Бұл қызға не ұнайды?
Dialogue: 0,0:50:47.84,0:50:54.65,Default,,0000,0000,0000,,Бұрмалы қолшатырлармен және суда жүзетін құстармен.
Dialogue: 0,0:50:56.69,0:50:58.69,Default,,0000,0000,0000,,｟Уау.
Dialogue: 0,0:50:58.69,0:51:03.29,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:50:58.69,0:51:03.29,Default,,0000,0000,0000,,Менің де осы көлден өткім келеді.
Dialogue: 0,0:51:03.29,0:51:07.13,Default,,0000,0000,0000,,Сол түскен жапырақтарда
Dialogue: 0,0:51:03.29,0:51:07.13,Default,,0000,0000,0000,,Мен жүре аламын ба деп ойлаймын.
Dialogue: 0,0:51:07.13,0:51:11.97,Default,,0000,0000,0000,,Мм... Қолшатыр қойып, желді пайдалансаң
Dialogue: 0,0:51:07.13,0:51:11.97,Default,,0000,0000,0000,,Мүмкін болуы мүмкін.
Dialogue: 0,0:51:11.97,0:51:13.97,Default,,0000,0000,0000,,Хаха.
Dialogue: 0,0:51:15.97,0:51:17.97,Default,,0000,0000,0000,,Кяах!
Dialogue: 0,0:51:15.97,0:51:17.97,Default,,0000,0000,0000,,Оливия!
Dialogue: 0,0:51:17.97,0:51:21.81,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:51:21.81,0:51:25.48,Default,,0000,0000,0000,,Көлде жүрген жерім➡
Dialogue: 0,0:51:25.48,0:51:27.98,Default,,0000,0000,0000,,Бір күні саған көрсететініме сенімдімін.
Dialogue: 0,0:51:27.98,0:51:30.79,Default,,0000,0000,0000,,Әке｠
Dialogue: 0,0:51:32.82,0:51:34.83,Default,,0000,0000,0000,,Және….
Dialogue: 0,0:51:36.83,0:51:40.00,Default,,0000,0000,0000,,Дәрігермен
Dialogue: 0,0:51:36.83,0:51:40.00,Default,,0000,0000,0000,,Қайталанған нәтижесіз сұрақтар мен жауаптар...
Dialogue: 0,0:51:40.00,0:51:45.67,Default,,0000,0000,0000,,Қалған уақытты өткізу
Dialogue: 0,0:51:40.00,0:51:45.67,Default,,0000,0000,0000,,Мен қызыммен оралуды шештім.
Dialogue: 0,0:51:45.67,0:51:50.17,Default,,0000,0000,0000,,Қызымның күлгеніне біраз болды.
Dialogue: 0,0:51:50.17,0:51:53.01,Default,,0000,0000,0000,,Тыныш және жұмсақ күндер.
Dialogue: 0,0:51:53.01,0:51:55.85,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:51:55.85,0:51:58.68,Default,,0000,0000,0000,,Бір ғана үміт...
Dialogue: 0,0:51:58.68,0:52:04.29,Default,,0000,0000,0000,,Құдай
Dialogue: 0,0:51:58.68,0:52:04.29,Default,,0000,0000,0000,,Мен үшін қаншалықты маңызды...
Dialogue: 0,0:52:04.29,0:52:08.13,Default,,0000,0000,0000,,Өзіңізге ұнайтын адаммен ажырасу➡
Dialogue: 0,0:52:08.13,0:52:11.96,Default,,0000,0000,0000,,Бұл енді ешқашан кездесе алмайтынымызды білдіреді➡
Dialogue: 0,0:52:11.96,0:52:16.47,Default,,0000,0000,0000,,Мен өзімді жалғыз сезінемін...
Dialogue: 0,0:52:16.47,0:52:20.97,Default,,0000,0000,0000,,Өте көп
Dialogue: 0,0:52:16.47,0:52:20.97,Default,,0000,0000,0000,,Бұл өте қиын нәрсе, солай емес пе?
Dialogue: 0,0:52:27.14,0:52:29.35,Default,,0000,0000,0000,,
Dialogue: 0,0:52:32.15,0:52:35.15,Default,,0000,0000,0000,,Бұрын... Кешіріңіз.
Dialogue: 0,0:52:35.15,0:52:38.32,Default,,0000,0000,0000,,Жоқ, қиын бөлігі
Dialogue: 0,0:52:35.15,0:52:38.32,Default,,0000,0000,0000,,Бұл сіздің күйеуіңіз болса да➡
Dialogue: 0,0:52:38.32,0:52:42.49,Default,,0000,0000,0000,,Абыржыған мен болдым.
Dialogue: 0,0:52:38.32,0:52:42.49,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:52:42.49,0:52:45.00,Default,,0000,0000,0000,,Мен оны аяқтаймын.
Dialogue: 0,0:52:45.00,0:52:47.50,Default,,0000,0000,0000,,Зәйтүн әңгімесі.
Dialogue: 0,0:52:47.50,0:52:51.00,Default,,0000,0000,0000,,Қыз қайтып келіп, әкесімен қауышады.
Dialogue: 0,0:52:51.00,0:52:53.50,Default,,0000,0000,0000,,Қандай азапты шытырман оқиға
Dialogue: 0,0:52:51.00,0:52:53.50,Default,,0000,0000,0000,,Тіпті жасасаңыз да➡
Dialogue: 0,0:52:53.50,0:52:56.01,Default,,0000,0000,0000,,Бақытты соңы бар.
Dialogue: 0,0:52:56.01,0:52:59.51,Default,,0000,0000,0000,,Кейіпкер де, көрермен де риза.
Dialogue: 0,0:52:59.51,0:53:02.61,Default,,0000,0000,0000,,Жоқ, мен жасап көремін.
Dialogue: 0,0:53:05.28,0:53:07.78,Default,,0000,0000,0000,,Ал құбыжық құлады.
Dialogue: 0,0:53:07.78,0:53:11.45,Default,,0000,0000,0000,,Зәйтүн «Мен құбыжықты жеңдім».
Dialogue: 0,0:53:11.45,0:53:14.46,Default,,0000,0000,0000,,Су рухы «Жарайсыңдар».
Dialogue: 0,0:53:14.46,0:53:20.46,Default,,0000,0000,0000,,Жел рухы «Біз қайтуымыз керек.
Dialogue: 0,0:53:14.46,0:53:20.46,Default,,0000,0000,0000,,Рухтар әлеміне».
Dialogue: 0,0:53:20.46,0:53:23.80,Default,,0000,0000,0000,,От рухы «Осында қоштасу».
Dialogue: 0,0:53:23.80,0:53:27.30,Default,,0000,0000,0000,,Зәйтүн бір орында тұр. Уф….
Dialogue: 0,0:53:27.30,0:53:32.14,Default,,0000,0000,0000,,Енді осы жерден қалай шығамыз?
Dialogue: 0,0:53:27.30,0:53:32.14,Default,,0000,0000,0000,,Оливаны үйге жіберуім керек пе?
Dialogue: 0,0:53:32.14,0:53:35.48,Default,,0000,0000,0000,,Өйткені кеме бұзылды
Dialogue: 0,0:53:32.14,0:53:35.48,Default,,0000,0000,0000,,Бұл ұшақ па?
Dialogue: 0,0:53:35.48,0:53:40.65,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:53:35.48,0:53:40.65,Default,,0000,0000,0000,,Арманшыл түрде.
Dialogue: 0,0:53:40.65,0:53:43.55,Default,,0000,0000,0000,,Егер құс болсаң, үйге ұшып бара алар едің.
Dialogue: 0,0:53:45.66,0:53:48.49,Default,,0000,0000,0000,,Қолшатырмен ұшсақ ше?
Dialogue: 0,0:53:45.66,0:53:48.49,Default,,0000,0000,0000,,Қолшатырмен ұша алмайсың.
Dialogue: 0,0:53:48.49,0:53:53.00,Default,,0000,0000,0000,,Мен ұша аламын. желдің рухы
Dialogue: 0,0:53:48.49,0:53:53.00,Default,,0000,0000,0000,,Тағы бір рет пайда болып, айтыңыз:
Dialogue: 0,0:53:53.00,0:53:57.00,Default,,0000,0000,0000,,«Зәйтүн, қолшатырыңды жай!»
Dialogue: 0,0:53:57.00,0:54:00.00,Default,,0000,0000,0000,,Қымбаттым, қолшатырыңды маған аша аласың ба?
Dialogue: 0,0:54:02.11,0:54:04.44,Default,,0000,0000,0000,,«Мына қолшатырлар сенің қанатың.
Dialogue: 0,0:54:04.44,0:54:06.78,Default,,0000,0000,0000,,Биіктен ұшсаң, сені жел алып кетеді➡
Dialogue: 0,0:54:06.78,0:54:09.45,Default,,0000,0000,0000,,Теңізде толқын, өзенде тас➡
Dialogue: 0,0:54:09.45,0:54:13.12,Default,,0000,0000,0000,,Көлге түскен жапырақтар
Dialogue: 0,0:54:09.45,0:54:13.12,Default,,0000,0000,0000,,Басыңыз.”
Dialogue: 0,0:54:13.12,0:54:15.12,Default,,0000,0000,0000,,Бұл жақсы идея.
Dialogue: 0,0:54:15.12,0:54:19.46,Default,,0000,0000,0000,,Дұрыс? Олив қайтып келді
Dialogue: 0,0:54:15.12,0:54:19.46,Default,,0000,0000,0000,,Әкемен қайта қауышу.
Dialogue: 0,0:54:19.46,0:54:25.13,Default,,0000,0000,0000,,Мен оны қайтадан көргім келді.
Dialogue: 0,0:54:19.46,0:54:25.13,Default,,0000,0000,0000,,Қайта кездесуден кейінгі сөз.
Dialogue: 0,0:54:25.13,0:54:27.13,Default,,0000,0000,0000,,Мен не айтуым керек?
Dialogue: 0,0:54:27.13,0:54:30.80,Default,,0000,0000,0000,,«Мен үйдемін»... жоқ, «әке»?
Dialogue: 0,0:54:30.80,0:54:34.30,Default,,0000,0000,0000,,Сіз тағы да кептеліп қалдыңыз ба?
Dialogue: 0,0:54:34.30,0:54:37.64,Default,,0000,0000,0000,,Сіз, дәл осы жерде.
Dialogue: 0,0:54:34.30,0:54:37.64,Default,,0000,0000,0000,,Сіз өтіп бара аласыз ба?
Dialogue: 0,0:54:37.64,0:54:39.64,Default,,0000,0000,0000,,Мен суретті түсінгім келеді.
Dialogue: 0,0:54:39.64,0:54:41.98,Default,,0000,0000,0000,,Мен тек ондай ақымақтық жасағандармен ғана айналыстым.
Dialogue: 0,0:54:41.98,0:54:45.32,Default,,0000,0000,0000,,Мүмкін болса
Dialogue: 0,0:54:41.98,0:54:45.32,Default,,0000,0000,0000,,Көлде қалқып жүрген жапырақтарда.
Dialogue: 0,0:54:45.32,0:54:48.49,Default,,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:54:48.49,0:54:51.59,Default,,0000,0000,0000,,Не? Жоқ, дәл қазір...
Dialogue: 0,0:54:54.32,0:55:10.77,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:55:10.77,0:55:17.78,Default,,0000,0000,0000,,｟Оливия: Бұл жақсы.
Dialogue: 0,0:55:10.77,0:55:17.78,Default,,0000,0000,0000,,Менің де осы көлден өткім келеді.
Dialogue: 0,0:55:17.78,0:55:23.29,Default,,0000,0000,0000,,Сол құлаған жапырақтарда
Dialogue: 0,0:55:17.78,0:55:23.29,Default,,0000,0000,0000,,Мен жүре аламын ба деп ойлаймын.
Dialogue: 0,0:55:23.29,0:55:28.29,Default,,0000,0000,0000,,Бұл — бір сәт бұрынғы Итадори ешқашан жасамайтын қимыл
Dialogue: 0,0:55:23.29,0:55:28.29,Default,,0000,0000,0000,,Бір күні саған көрсететініме сенімдімін.
Dialogue: 0,0:55:28.29,0:55:30.59,Default,,0000,0000,0000,,Әке｠
Dialogue: 0,0:55:34.30,0:55:39.80,Default,,0000,0000,0000,,《Оскар: Тағы мың рет.
Dialogue: 0,0:55:34.30,0:55:39.80,Default,,0000,0000,0000,,Мені осылай атағысы келді...
Dialogue: 0,0:55:39.80,0:55:44.31,Default,,0000,0000,0000,,Өлме... тілеймін...
Dialogue: 0,0:55:44.31,0:55:51.15,Default,,0000,0000,0000,,Тікелей... Әй, тыңда... Өс...》
Dialogue: 0,0:55:51.15,0:55:55.15,Default,,0000,0000,0000,,(Оскардың жылаған дауысы)
Dialogue: 0,0:55:55.15,0:55:59.49,Default,,0000,0000,0000,,《Мен мұны қаладым...》
Dialogue: 0,0:55:59.49,0:56:15.44,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:56:15.44,0:56:18.94,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:56:18.94,0:56:23.45,Default,,0000,0000,0000,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:56:23.45,0:56:25.62,Default,,0000,0000,0000,,Мен үш қадам жүрдім деп ойлаймын.
Dialogue: 0,0:56:25.62,0:56:28.45,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,0:56:28.45,0:56:31.96,Default,,0000,0000,0000,,(Виолет) "Ах… Мен осы күнәмен өмір сүруден басқа амалым жоқ."
Dialogue: 0,0:56:28.45,0:56:31.96,Default,,0000,0000,0000,,Ода….
Dialogue: 0,0:56:31.96,0:56:35.06,Default,,0000,0000,0000,,Тіпті сіздің физикалық жағдайыңыз болса да
Dialogue: 0,0:56:31.96,0:56:35.06,Default,,0000,0000,0000,,Жаман ба?
Dialogue: 0,0:56:37.29,0:56:41.63,Default,,0000,0000,0000,,Мына қолшатырды қабыл алыңыз.
Dialogue: 0,0:56:37.29,0:56:41.63,Default,,0000,0000,0000,,Сіз сенімдісіз бе?
Dialogue: 0,0:56:41.63,0:56:45.64,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:56:41.63,0:56:45.64,Default,,0000,0000,0000,,Егер мен ары қарай ұша алсам
Dialogue: 0,0:56:41.63,0:56:45.64,Default,,0000,0000,0000,,Мен қызық болдым.
Dialogue: 0,0:56:45.64,0:56:47.80,Default,,0000,0000,0000,,Бұл жеткілікті.
Dialogue: 0,0:56:47.80,0:56:52.31,Default,,0000,0000,0000,,Қайтыс болған қызыңыздың ''бір күні'' есіне аласыз
Dialogue: 0,0:56:47.80,0:56:52.31,Default,,0000,0000,0000,,Бұл орындалды.
Dialogue: 0,0:56:54.31,0:56:56.65,Default,,0000,0000,0000,,Мен бір күні сенімдімін...
Dialogue: 0,0:56:56.65,0:56:59.82,Default,,0000,0000,0000,,(Пойыз ысқырығы)
Dialogue: 0,0:56:59.82,0:57:01.92,Default,,0000,0000,0000,,Олай болса.
Dialogue: 0,0:57:01.92,0:57:04.75,Default,,0000,0000,0000,,Auto Memory Doll қызметін пайдалану➡
Dialogue: 0,0:57:04.75,0:57:07.42,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:57:07.42,0:57:09.93,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:57:09.93,0:57:14.03,Default,,0000,0000,0000,,Күлгін Эвергарден.
Dialogue: 0,0:57:21.94,0:57:26.94,Default,,0000,0000,0000,,｟Сіздің істегеніңіз үшін
Dialogue: 0,0:57:21.94,0:57:26.94,Default,,0000,0000,0000,,Менің денем өртеніп жатыр➡
Dialogue: 0,0:57:26.94,0:57:30.45,Default,,0000,0000,0000,,Оның жанып жатқаны
Dialogue: 0,0:57:26.94,0:57:30.45,Default,,0000,0000,0000,,Мен әлі білмеймін.
Dialogue: 0,0:57:30.45,0:57:33.12,Default,,0000,0000,0000,,Тек… бала сенің жаныңнан алыстап бара жатқанда…
Dialogue: 0,0:57:30.45,0:57:33.12,Default,,0000,0000,0000,,Ол жанып тұр.
Dialogue: 0,0:57:33.12,0:57:36.79,Default,,0000,0000,0000,,Бір күні айтқан сөзім
Dialogue: 0,0:57:33.12,0:57:36.79,Default,,0000,0000,0000,,Түсінетін уақыт келеді.
Dialogue: 0,0:57:36.79,0:57:39.12,Default,,0000,0000,0000,,Ал мен бірінші рет өзімді көп алдым➡
Dialogue: 0,0:57:39.12,0:57:42.53,Default,,0000,0000,0000,,Өртену
Dialogue: 0,0:57:39.12,0:57:42.53,Default,,0000,0000,0000,,Ескерту｠
Dialogue: 0,0:57:44.96,0:57:46.96,Default,,0000,0000,0000,,(тұру дыбысы)
Dialogue: 0,0:57:49.13,0:57:51.13,Default,,0000,0000,0000,,Майор….
Dialogue: 0,0:57:51.13,0:57:54.47,Default,,0000,0000,0000,,｟Тікелей эфир...｠
Dialogue: 0,0:57:51.13,0:57:54.47,Default,,0000,0000,0000,,Сол қыздың шаш түсіне ұқсас шашы бар қыз…
Dialogue: 0,0:57:54.47,0:57:57.31,Default,,0000,0000,0000,,｟Гилберт: Еркін бол...｠
Dialogue: 0,0:57:57.31,0:58:02.91,Default,,0000,0000,0000,,Мен адамдарды қару ретінде пайдаландым.
Dialogue: 0,0:57:57.31,0:58:02.91,Default,,0000,0000,0000,,Мұндай баланың шығатынын ешқашан ойламаған едім
Dialogue: 0,0:58:02.91,0:58:09.42,Default,,0000,0000,0000,,Мен біреудің «бір күнін» қалаймын
Dialogue: 0,0:58:02.91,0:58:09.42,Default,,0000,0000,0000,,Сендіруге орын жоқ!
Dialogue: 0,0:58:09.42,0:58:11.92,Default,,0000,0000,0000,,Сол адамдарға да➡
Dialogue: 0,0:58:11.92,0:58:15.26,Default,,0000,0000,0000,,Сіз жақсы көретін адам
Dialogue: 0,0:58:11.92,0:58:15.26,Default,,0000,0000,0000,,Болмады ма?
Dialogue: 0,0:58:15.26,0:58:18.26,Default,,0000,0000,0000,,｟Жанбайды｠
Dialogue: 0,0:58:15.26,0:58:18.26,Default,,0000,0000,0000,,Олармен айналысқандар да мен сияқты.
Dialogue: 0,0:58:18.26,0:58:21.26,Default,,0000,0000,0000,,｟Жанбайды｠
Dialogue: 0,0:58:18.26,0:58:21.26,Default,,0000,0000,0000,,Олармен айналысқандар да мен сияқты.
Dialogue: 0,0:58:21.26,0:58:25.27,Default,,0000,0000,0000,,Менің істеген істерім үшін
Dialogue: 0,0:58:21.26,0:58:25.27,Default,,0000,0000,0000,,Менің денем өртеніп жатыр➡
Dialogue: 0,0:58:25.27,0:58:28.47,Default,,0000,0000,0000,,Ах… Менде осы күнәмен өмір сүруден басқа амал жоқ!
Dialogue: 0,0:58:40.12,0:58:44.45,Default,,0000,0000,0000,,Эй, Күлгін.
Dialogue: 0,0:58:44.45,0:58:49.46,Default,,0000,0000,0000,,ханым. Қашан?
Dialogue: 0,0:58:44.45,0:58:49.46,Default,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:58:49.46,0:58:55.13,Default,,0000,0000,0000,,Әйелімнің жүрегін жараладым.
Dialogue: 0,0:58:49.46,0:58:55.13,Default,,0000,0000,0000,,Шын жүректен кешірім сұраймыз.
Dialogue: 0,0:58:55.13,0:58:58.64,Default,,0000,0000,0000,,Күлгін... Жақсы.
Dialogue: 0,0:58:58.64,0:59:01.14,Default,,0000,0000,0000,,Басыңызды көтеріңіз.
Dialogue: 0,0:59:03.41,0:59:06.74,Default,,0000,0000,0000,,Сіздің керемет болғаныңызға қуаныштымын.
Dialogue: 0,0:59:06.74,0:59:10.45,Default,,0000,0000,0000,,Бұл мені жүзуге мәжбүр етеді.
Dialogue: 0,0:59:06.74,0:59:10.45,Default,,0000,0000,0000,,Сондай-ақ қайтыс болған Гилберт.
Dialogue: 0,0:59:13.58,0:59:16.42,Default,,0000,0000,0000,,Қайтыс болды...?
Dialogue: 0,0:59:16.42,0:59:18.42,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:59:18.42,0:59:20.92,Default,,0000,0000,0000,,Тірі кезде
Dialogue: 0,0:59:18.42,0:59:20.92,Default,,0000,0000,0000,,Сіз айттыңыз!
Dialogue: 0,0:59:20.92,0:59:23.76,Default,,0000,0000,0000,,Майор аман деп үміттенемін!
Dialogue: 0,0:59:23.76,0:59:25.93,Default,,0000,0000,0000,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,0:59:25.93,0:59:29.03,Default,,0000,0000,0000,,Ол әлі тірі, солай ма?
Dialogue: 0,0:59:32.60,0:59:34.77,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:59:34.77,0:59:38.27,Default,,0000,0000,0000,,Мен сізге айта алмадым.
Dialogue: 0,0:59:38.27,0:59:41.78,Default,,0000,0000,0000,,Intense➡ соңғы шайқасынан кейін
Dialogue: 0,0:59:41.78,0:59:46.45,Default,,0000,0000,0000,,Сен собордың астында жалғыз жаттың.
Dialogue: 0,0:59:46.45,0:59:48.45,Default,,0000,0000,0000,,Бомбыланудың аз-ақ алдында шығар➡
Dialogue: 0,0:59:48.45,0:59:51.96,Default,,0000,0000,0000,,Ол сені итеріп жіберді.
Dialogue: 0,0:59:51.96,0:59:57.63,Default,,0000,0000,0000,,Ол растай алмады, бірақ
Dialogue: 0,0:59:51.96,0:59:57.63,Default,,0000,0000,0000,,Үйінділердің астында сәйкестендіру белгісі болған.
Dialogue: 0,0:59:57.63,1:00:00.30,Default,,0000,0000,0000,,Нәтижесінде маған оралмаған адам ретінде қаралды.
Dialogue: 0,1:00:00.30,1:00:02.30,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,1:00:02.30,1:00:04.63,Default,,0000,0000,0000,,Бірақ бұл жағдайда.
Dialogue: 0,1:00:04.63,1:00:06.80,Default,,0000,0000,0000,,Майордың қауіпсіз екеніне сенімдімін.
Dialogue: 0,1:00:06.80,1:00:09.64,Default,,0000,0000,0000,,Виолет-чан.
Dialogue: 0,1:00:06.80,1:00:09.64,Default,,0000,0000,0000,,Тіпті оның атын сыбырлауға да тым қайғылы
Dialogue: 0,1:00:09.64,1:00:12.64,Default,,0000,0000,0000,,Виолет-чан, түсініңізші.
Dialogue: 0,1:00:12.64,1:00:16.31,Default,,0000,0000,0000,,Ол қазірдің өзінде...
Dialogue: 0,1:00:12.64,1:00:16.31,Default,,0000,0000,0000,,Мен білмеймін. Мен түсінбедім.
Dialogue: 0,1:00:16.31,1:00:20.98,Default,,0000,0000,0000,,Неге... неге тек мен?
Dialogue: 0,1:00:16.31,1:00:20.98,Default,,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,1:00:20.98,1:00:23.65,Default,,0000,0000,0000,,Майор қасымда болды.
Dialogue: 0,1:00:23.65,1:00:27.32,Default,,0000,0000,0000,,Ал маған….
Dialogue: 0,1:00:23.65,1:00:27.32,Default,,0000,0000,0000,,Виолет-чан.
Dialogue: 0,1:00:27.32,1:00:30.99,Default,,0000,0000,0000,,Қиын болса да, қабылда.
Dialogue: 0,1:00:30.99,1:00:33.00,Default,,0000,0000,0000,,Виолет-чан!
Dialogue: 0,1:00:36.50,1:00:39.67,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,1:00:39.67,1:00:46.08,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:00:48.01,1:00:50.61,Default,,0000,0000,0000,,｟Гилберт: Сенің атың кім?
Dialogue: 0,1:00:53.85,1:00:56.02,Default,,0000,0000,0000,,Мен...
Dialogue: 0,1:00:56.02,1:00:59.52,Default,,0000,0000,0000,,Олай болса, мен саған ат бере аламын ба?
Dialogue: 0,1:01:03.29,1:01:05.29,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,1:01:17.14,1:01:19.31,Default,,0000,0000,0000,,Күлгін….
Dialogue: 0,1:01:19.31,1:01:21.31,Default,,0000,0000,0000,,Бұл күлгін.
Dialogue: 0,1:01:21.31,1:01:26.48,Default,,0000,0000,0000,,Өссең, міндетті түрде боласың
Dialogue: 0,1:01:21.31,1:01:26.48,Default,,0000,0000,0000,,Сол атқа лайық әйел бол.
Dialogue: 0,1:01:26.48,1:01:31.99,Default,,0000,0000,0000,,Сіз құрал емессіз
Dialogue: 0,1:01:26.48,1:01:31.99,Default,,0000,0000,0000,,Сізге есімі лайық адам болыңыз｠
Dialogue: 0,1:01:42.33,1:01:46.00,Default,,0000,0000,0000,,(есік қоңырауы)
Dialogue: 0,1:01:46.00,1:01:51.34,Default,,0000,0000,0000,,Иә. Ха! сен….
Dialogue: 0,1:01:51.34,1:01:55.85,Default,,0000,0000,0000,,Майор...
Dialogue: 0,1:01:51.34,1:01:55.85,Default,,0000,0000,0000,,Майор осында ма?
Dialogue: 0,1:01:58.01,1:02:04.45,Default,,0000,0000,0000,,Мұнда майор...
Dialogue: 0,1:01:58.01,1:02:04.45,Default,,0000,0000,0000,,Сіз сондасыз, солай емес пе?
Dialogue: 0,1:02:04.45,1:02:07.29,Default,,0000,0000,0000,,Бочама….
Dialogue: 0,1:02:07.29,1:02:23.31,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:02:23.31,1:02:28.31,Default,,0000,0000,0000,,Гилберт… бугенвилла….
Dialogue: 0,1:02:28.31,1:02:32.52,Default,,0000,0000,0000,,Майордың аты кім?
Dialogue: 0,1:02:37.65,1:02:41.06,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,1:02:56.84,1:03:00.11,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,1:03:00.11,1:03:02.45,Default,,0000,0000,0000,,Майор….
Dialogue: 0,1:03:02.45,1:03:06.62,Default,,0000,0000,0000,,(жылайды)
Dialogue: 0,1:03:06.62,1:03:09.62,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,1:03:14.62,1:03:17.03,Default,,0000,0000,0000,,Күлгін.
Dialogue: 0,1:03:20.30,1:03:25.80,Default,,0000,0000,0000,,Майор... Майор...!
Dialogue: 0,1:03:25.80,1:03:28.64,Default,,0000,0000,0000,,Сен амансың деп үміттенемін...
Dialogue: 0,1:03:28.64,1:03:31.14,Default,,0000,0000,0000,,Киім.
Dialogue: 0,1:03:31.14,1:03:37.15,Default,,0000,0000,0000,,Қазір мен автоматты жад қуыршақпын
Dialogue: 0,1:03:31.14,1:03:37.15,Default,,0000,0000,0000,,Жұмыс.
Dialogue: 0,1:03:37.15,1:03:39.82,Default,,0000,0000,0000,,Жол жабық.
Dialogue: 0,1:03:37.15,1:03:39.82,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:03:39.82,1:03:42.12,Default,,0000,0000,0000,,Мен сізге хат жазып отырмын.
Dialogue: 0,1:03:44.15,1:03:48.16,Default,,0000,0000,0000,,Мен өзімнен гөрі сенің болашағыңды көбірек уайымдаймын.
Dialogue: 0,1:03:48.16,1:03:52.06,Default,,0000,0000,0000,,Өз қолымен талай адамның өмірін қиды.
Dialogue: 0,1:03:58.00,1:04:00.60,Default,,0000,0000,0000,,Ха! Майор...!
Dialogue: 0,1:04:00.60,1:04:04.01,Default,,0000,0000,0000,,Өтінемін, сәл күте тұрыңыз
Dialogue: 0,1:04:10.61,1:04:12.62,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:04:14.62,1:04:16.79,Default,,0000,0000,0000,,Майор….
Dialogue: 0,1:04:16.79,1:04:48.15,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:04:48.15,1:04:52.49,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:04:52.49,1:04:56.99,Default,,0000,0000,0000,,Польнарефф?
Dialogue: 0,1:04:56.99,1:05:18.28,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:05:18.28,1:05:32.46,Default,,0000,0000,0000,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:05:32.46,1:05:39.97,Default,,0000,0000,0000,,(жылайды)
Dialogue: 0,1:05:39.97,1:05:41.97,Default,,0000,0000,0000,,Майор….
Dialogue: 0,1:05:41.97,1:05:44.14,Default,,0000,0000,0000,,Майор...!
Dialogue: 0,1:05:44.14,1:05:48.48,Default,,0000,0000,0000,,Мен не істеуім керек...!
Dialogue: 0,1:05:48.48,1:05:50.48,Default,,0000,0000,0000,,Тапсырыс….
Dialogue: 0,1:05:50.48,1:05:53.82,Default,,0000,0000,0000,,Маған тапсырыс беріңіз!
Dialogue: 0,1:05:53.82,1:05:59.12,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:06:02.26,1:06:04.26,Default,,0000,0000,0000,,
Dialogue: 0,1:06:04.26,1:06:07.10,Default,,0000,0000,0000,,Бұл хат.
Dialogue: 0,1:06:07.10,1:06:09.80,Default,,0000,0000,0000,,Виолет Эвергарден.
Dialogue: 0,1:06:12.94,1:06:15.24,Default,,0000,0000,0000,,(Күлгіннің ізі)
Dialogue: 0,1:06:17.27,1:06:20.78,Default,,0000,0000,0000,,Ол сізге арналған.
Dialogue: 0,1:06:24.95,1:06:27.75,Default,,0000,0000,0000,,Эрика мен Айрис маған мұны істеуді өтінді.
Dialogue: 0,1:06:30.12,1:06:32.62,Default,,0000,0000,0000,,Жарайды, мен жеткіздім.
Dialogue: 0,1:06:36.46,1:06:39.80,Default,,0000,0000,0000,,«Егер маған бірдеңе болса—»
Dialogue: 0,1:06:39.80,1:06:41.80,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:06:41.80,1:06:44.80,Default,,0000,0000,0000,,Содан кейін I
Dialogue: 0,1:06:41.80,1:06:44.80,Default,,0000,0000,0000,,Мен қолөнер көшесін айналайын➡
Dialogue: 0,1:06:44.80,1:06:48.10,Default,,0000,0000,0000,,Мен сізден қимыл жасауыңызды сұраймын.
Dialogue: 0,1:06:51.97,1:06:57.98,Default,,0000,0000,0000,,Қайсысын алсаң да
Dialogue: 0,1:06:51.97,1:06:57.98,Default,,0000,0000,0000,,Өйткені бұл біреудің маңызды сезімі.
Dialogue: 0,1:06:57.98,1:07:02.59,Default,,0000,0000,0000,,Келу қажет емес хаттар жоқ.
Dialogue: 0,1:06:57.98,1:07:02.59,Default,,0000,0000,0000,,№.
Dialogue: 0,1:07:02.59,1:07:11.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:07:11.09,1:07:13.76,Default,,0000,0000,0000,,⚟Бұл хат!
Dialogue: 0,1:07:13.76,1:07:17.10,Default,,0000,0000,0000,,Мама, бұл әкеден!
Dialogue: 0,1:07:17.10,1:07:29.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:07:29.11,1:07:33.28,Default,,0000,0000,0000,,Сіз жеткізуді аяқтадыңыз ба?
Dialogue: 0,1:07:33.28,1:07:36.12,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,1:07:36.12,1:07:39.96,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,1:07:36.12,1:07:39.96,Default,,0000,0000,0000,,Барлығы, дұрыс келді деп үміттенемін.
Dialogue: 0,1:07:39.96,1:07:55.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:07:55.97,1:07:59.91,Default,,0000,0000,0000,,«Күлгін, жақсысың ба?
Dialogue: 0,1:07:59.91,1:08:02.41,Default,,0000,0000,0000,,Мен сені көргім келді➡
Dialogue: 0,1:08:02.41,1:08:06.42,Default,,0000,0000,0000,,Ириспен кеңесіңіз
Dialogue: 0,1:08:02.41,1:08:06.42,Default,,0000,0000,0000,,Мен хат жазуды шештім.
Dialogue: 0,1:08:06.42,1:08:11.42,Default,,0000,0000,0000,,Қуыршақтар қуыршақтарға хат жазады ма?
Dialogue: 0,1:08:06.42,1:08:11.42,Default,,0000,0000,0000,,Біртүрлі болуы мүмкін.
Dialogue: 0,1:08:11.42,1:08:16.26,Default,,0000,0000,0000,,Бірақ мен сізге айтқым келді.
Dialogue: 0,1:08:11.42,1:08:16.26,Default,,0000,0000,0000,,Мен уайымдап тұрмын.
Dialogue: 0,1:08:16.26,1:08:20.60,Default,,0000,0000,0000,,Ал сіз туралы...
Dialogue: 0,1:08:20.60,1:08:23.60,Default,,0000,0000,0000,,Мен күтемін...''
Dialogue: 0,1:08:23.60,1:08:26.77,Default,,0000,0000,0000,,《Эрика: «Мен өзімді қазір өте нашар сезінемін.
Dialogue: 0,1:08:23.60,1:08:26.77,Default,,0000,0000,0000,,Жұмысқа қайта оралуға қалай қарайсыз?
Dialogue: 0,1:08:26.77,1:08:30.94,Default,,0000,0000,0000,,Себебі мен бір бола алмауым мүмкін.
Dialogue: 0,1:08:26.77,1:08:30.94,Default,,0000,0000,0000,,Біраз демалыңыз.
Dialogue: 0,1:08:30.94,1:08:35.28,Default,,0000,0000,0000,,Бірақ бірдеңе болса
Dialogue: 0,1:08:30.94,1:08:35.28,Default,,0000,0000,0000,,Бізге қоңырау шалыңыз.
Dialogue: 0,1:08:35.28,1:08:39.78,Default,,0000,0000,0000,,Мен және Айрис, сен
Dialogue: 0,1:08:35.28,1:08:39.78,Default,,0000,0000,0000,,Мен сенің қайтып келетініңе сенемін.''
Dialogue: 0,1:08:43.95,1:08:47.46,Default,,0000,0000,0000,,《Ирис: «Онда
Dialogue: 0,1:08:43.95,1:08:47.46,Default,,0000,0000,0000,,Бүгін Спенсер➡ деген адам бар
Dialogue: 0,1:08:47.46,1:08:50.63,Default,,0000,0000,0000,,Сізге
Dialogue: 0,1:08:47.46,1:08:50.63,Default,,0000,0000,0000,,Мен сенен маған жазуыңды өтінуге келдім.
Dialogue: 0,1:08:50.63,1:08:56.30,Default,,0000,0000,0000,,Әпкеңе алғыс хат жазып, кешірім сұрау
Dialogue: 0,1:08:50.63,1:08:56.30,Default,,0000,0000,0000,,Ол жазғысы келетінін айтты.
Dialogue: 0,1:08:56.30,1:08:59.90,Default,,0000,0000,0000,,Олар сенің жазғаныңды қалайды.
Dialogue: 0,1:08:59.90,1:09:03.91,Default,,0000,0000,0000,,Бұл сіз болуыңыз керек
Dialogue: 0,1:08:59.90,1:09:03.91,Default,,0000,0000,0000,,Бұл жақсы емес.''
Dialogue: 0,1:09:10.58,1:09:13.08,Default,,0000,0000,0000,,Бұл жақсы ма?
Dialogue: 0,1:09:13.08,1:09:15.08,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:09:15.08,1:09:19.92,Default,,0000,0000,0000,,Әпкеме хат жазу
Dialogue: 0,1:09:15.08,1:09:19.92,Default,,0000,0000,0000,,Бұл тітіркендіргіш...
Dialogue: 0,1:09:19.92,1:09:25.76,Default,,0000,0000,0000,,Бірақ оған рахмет
Dialogue: 0,1:09:19.92,1:09:25.76,Default,,0000,0000,0000,,Мен де жұмысқа орналастым.
Dialogue: 0,1:09:25.76,1:09:28.96,Default,,0000,0000,0000,,Шығып бара жатырсың ба?
Dialogue: 0,1:09:25.76,1:09:28.96,Default,,0000,0000,0000,,Қайтадан бастағым келді.
Dialogue: 0,1:09:31.93,1:09:35.60,Default,,0000,0000,0000,,Ято-сама!
Dialogue: 0,1:09:31.93,1:09:35.60,Default,,0000,0000,0000,,Өтінемін, барыңыз.
Dialogue: 0,1:09:35.60,1:09:38.44,Default,,0000,0000,0000,,Біраз уақыт үзіліс жасайсың деп естідім.
Dialogue: 0,1:09:38.44,1:09:41.78,Default,,0000,0000,0000,,Маған бір әріптесім хабарлады.
Dialogue: 0,1:09:41.78,1:09:44.11,Default,,0000,0000,0000,,Хат арқылы.
Dialogue: 0,1:09:44.11,1:09:48.95,Default,,0000,0000,0000,,Бұл менің өмірімде бірінші рет
Dialogue: 0,1:09:44.11,1:09:48.95,Default,,0000,0000,0000,,Бұл мен алған хат.
Dialogue: 0,1:09:48.95,1:09:52.45,Default,,0000,0000,0000,,Хат алу дегеніміз...
Dialogue: 0,1:09:52.45,1:09:56.76,Default,,0000,0000,0000,,Бұл өте қуанышты нәрсе.
Dialogue: 0,1:09:52.45,1:09:56.76,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:09:59.13,1:10:03.13,Default,,0000,0000,0000,,Менің ойымша, Люлия да бақытты болады.
Dialogue: 0,1:10:03.13,1:10:05.97,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,1:10:05.97,1:10:32.33,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:10:32.33,1:10:34.33,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:10:34.33,1:11:14.14,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:11:14.14,1:11:17.84,Default,,0000,0000,0000,,Өз атына сай...
Dialogue: 0,1:11:22.81,1:11:27.52,Default,,0000,0000,0000,,Бұл есім маған жарасады...
Dialogue: 0,1:11:38.16,1:11:47.67,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:11:47.67,1:11:50.17,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:11:54.18,1:11:56.85,Default,,0000,0000,0000,,Президент айтқандай, мен➡
Dialogue: 0,1:11:56.85,1:12:01.28,Default,,0000,0000,0000,,Көп күйік алған.
Dialogue: 0,1:12:01.28,1:12:04.95,Default,,0000,0000,0000,,Жақсы ма?
Dialogue: 0,1:12:04.95,1:12:11.13,Default,,0000,0000,0000,,Мен автоматты жад қуыршақпын
Dialogue: 0,1:12:04.95,1:12:11.13,Default,,0000,0000,0000,,Жақсы ма?
Dialogue: 0,1:12:11.13,1:12:13.80,Default,,0000,0000,0000,,Тікелей….
Dialogue: 0,1:12:13.80,1:12:17.80,Default,,0000,0000,0000,,Тірі болған дұрыс па?
Dialogue: 0,1:12:27.31,1:12:30.01,Default,,0000,0000,0000,,Жасалған нәрсені өшіру мүмкін емес.
Dialogue: 0,1:12:34.82,1:12:36.82,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,1:12:36.82,1:13:08.45,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:13:08.45,1:13:10.55,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,1:13:12.96,1:13:18.46,Default,,0000,0000,0000,,Сіз Автоматты жад қуыршағы ретіндесіз
Dialogue: 0,1:13:12.96,1:13:18.46,Default,,0000,0000,0000,,Мен не істедім...
Dialogue: 0,1:13:18.46,1:13:20.63,Default,,0000,0000,0000,,Ол жоғалып кетпейді.
Dialogue: 0,1:13:20.63,1:13:23.97,Default,,0000,0000,0000,,Күлгін Эвергарден.
Dialogue: 0,1:13:23.97,1:13:26.80,Default,,0000,0000,0000,,Бүгін не ойнайық?
Dialogue: 0,1:13:26.80,1:13:28.80,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,1:13:28.80,1:13:31.81,Default,,0000,0000,0000,,Үйде ойнаудан шаршадым.
Dialogue: 0,1:13:31.81,1:13:33.81,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,1:13:33.81,1:13:38.81,Default,,0000,0000,0000,,Әлі де ана болып табылатын тұтынушылар
Dialogue: 0,1:13:33.81,1:13:38.81,Default,,0000,0000,0000,,Мен үйге бармаймын деп ойлаймын.
Dialogue: 0,1:13:38.81,1:13:41.65,Default,,0000,0000,0000,,Үйге тезірек барсам екен.
Dialogue: 0,1:13:41.65,1:13:44.82,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,1:13:44.82,1:13:47.82,Default,,0000,0000,0000,,Рақмет. Кешіріңіз.
Dialogue: 0,1:13:50.99,1:13:53.60,Default,,0000,0000,0000,,Не? Бұл.
Dialogue: 0,1:13:57.67,1:14:02.27,Default,,0000,0000,0000,,《Анна: Маған қарай бір қуыршақ келді.
Dialogue: 0,1:14:02.27,1:14:06.44,Default,,0000,0000,0000,,Өте үлкен қуыршақ.
Dialogue: 0,1:14:06.44,1:14:08.61,Default,,0000,0000,0000,,Осындай нәрсе➡
Dialogue: 0,1:14:08.61,1:14:12.95,Default,,0000,0000,0000,,Жаман нәрсе сияқты
Dialogue: 0,1:14:08.61,1:14:12.95,Default,,0000,0000,0000,,Мен мұны сезіндім》
Dialogue: 0,1:14:12.95,1:14:15.12,Default,,0000,0000,0000,,Олар тек өз клиенттері үшін ғана әдемі сөздер жазады.
Dialogue: 0,1:14:15.12,1:14:17.12,Default,,0000,0000,0000,,Әй, жас ханым!
Dialogue: 0,1:14:17.12,1:14:19.96,Default,,0000,0000,0000,,Мен осылай айтамын.
Dialogue: 0,1:14:17.12,1:14:19.96,Default,,0000,0000,0000,,Бұл маңызды.
Dialogue: 0,1:14:19.96,1:14:22.62,Default,,0000,0000,0000,,Иә, бірақ...
Dialogue: 0,1:14:19.96,1:14:22.62,Default,,0000,0000,0000,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,1:14:22.62,1:14:27.13,Default,,0000,0000,0000,,Энн бөлмеге кірген кезде
Dialogue: 0,1:14:22.62,1:14:27.13,Default,,0000,0000,0000,,Мен саған қағуды айттым!
Dialogue: 0,1:14:27.13,1:14:29.13,Default,,0000,0000,0000,,Уху.
Dialogue: 0,1:14:29.13,1:14:31.83,Default,,0000,0000,0000,,Сәлемдесу.
Dialogue: 0,1:14:35.14,1:14:37.14,Default,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,1:14:37.14,1:14:39.98,Default,,0000,0000,0000,,Кешіріңіз, анашым.
Dialogue: 0,1:14:37.14,1:14:39.98,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,1:14:39.98,1:14:45.81,Default,,0000,0000,0000,,Жарайды. Сонда не?
Dialogue: 0,1:14:45.81,1:14:48.82,Default,,0000,0000,0000,,Тағы бір жұмбақ жәндік таптыңыз ба?
Dialogue: 0,1:14:48.82,1:14:52.32,Default,,0000,0000,0000,,Бірақ оны анаңа көрсетпе.
Dialogue: 0,1:14:48.82,1:14:52.32,Default,,0000,0000,0000,,Бұл қате емес!
Dialogue: 0,1:14:52.32,1:14:55.99,Default,,0000,0000,0000,,Саған қарай қуыршақ келе жатыр!
Dialogue: 0,1:14:52.32,1:14:55.99,Default,,0000,0000,0000,,Сен дәл қазір не үшін кешірім сұрап тұрсың?
Dialogue: 0,1:14:55.99,1:15:00.60,Default,,0000,0000,0000,,Ханым, сіз келдіңіз.
Dialogue: 0,1:15:00.60,1:15:03.77,Default,,0000,0000,0000,,Әй, қуыршақ!
Dialogue: 0,1:15:03.77,1:15:07.44,Default,,0000,0000,0000,,Қазір ойлап қарасам, бүгін болды.
Dialogue: 0,1:15:03.77,1:15:07.44,Default,,0000,0000,0000,,Мені қонақ бөлмеге апарыңызшы.
Dialogue: 0,1:15:07.44,1:15:09.44,Default,,0000,0000,0000,,Бақытымызға орай, осы жаманның атыс құралдары баяу
Dialogue: 0,1:15:07.44,1:15:09.44,Default,,0000,0000,0000,,Ей!
Dialogue: 0,1:15:09.44,1:15:12.94,Default,,0000,0000,0000,,Кешіріңіз, бірақ
Dialogue: 0,1:15:09.44,1:15:12.94,Default,,0000,0000,0000,,Қайтадан оқуды жалғастырыңыз.
Dialogue: 0,1:15:12.94,1:15:16.11,Default,,0000,0000,0000,,Бұл сарайды тағы не істейсің? ?
Dialogue: 0,1:15:16.11,1:15:19.95,Default,,0000,0000,0000,,Сол баланың жалғыз тұруы үшін...
Dialogue: 0,1:15:16.11,1:15:19.95,Default,,0000,0000,0000,,Сондықтан біз...
Dialogue: 0,1:15:19.95,1:15:23.95,Default,,0000,0000,0000,,Бүгінгі күн үшін
Dialogue: 0,1:15:19.95,1:15:23.95,Default,,0000,0000,0000,,Затыңызды алыңыз.
Dialogue: 0,1:15:19.95,1:15:23.95,Default,,0000,0000,0000,,Эй...
Dialogue: 0,1:15:23.95,1:15:25.95,Default,,0000,0000,0000,,(есік жабылған дыбыс)
Dialogue: 0,1:15:33.80,1:15:38.60,Default,,0000,0000,0000,,Энн жақсы қыз бол.
Dialogue: 0,1:15:41.30,1:15:43.81,Default,,0000,0000,0000,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,1:15:43.81,1:15:46.81,Default,,0000,0000,0000,,Осы уақытқа дейін келгеніңіз үшін рахмет.
Dialogue: 0,1:15:46.81,1:15:48.81,Default,,0000,0000,0000,,Мәселе жоқ.
Dialogue: 0,1:15:48.81,1:15:51.81,Default,,0000,0000,0000,,Сөйлесті.
Dialogue: 0,1:15:51.81,1:15:54.82,Default,,0000,0000,0000,,Тұтынушы қаласа
Dialogue: 0,1:15:51.81,1:15:54.82,Default,,0000,0000,0000,,Мен кез келген жерге асығамын.
Dialogue: 0,1:15:54.82,1:15:56.82,Default,,0000,0000,0000,,Автоматты жад қуыршақ қызметі.
Dialogue: 0,1:15:56.82,1:15:58.82,Default,,0000,0000,0000,,Күтілгендей! Қуыршақ!
Dialogue: 0,1:15:58.82,1:16:03.09,Default,,0000,0000,0000,,Энн! кешіріңіз.
Dialogue: 0,1:15:58.82,1:16:03.09,Default,,0000,0000,0000,,№.
Dialogue: 0,1:16:03.09,1:16:07.76,Default,,0000,0000,0000,,Бұл Виолет Эвергарден.
Dialogue: 0,1:16:07.76,1:16:10.10,Default,,0000,0000,0000,,Келіңіздер
Dialogue: 0,1:16:07.76,1:16:10.10,Default,,0000,0000,0000,,Мен қазір шай дайындаймын➡
Dialogue: 0,1:16:10.10,1:16:12.10,Default,,0000,0000,0000,,Маған қоңырау шалыңыз.
Dialogue: 0,1:16:17.11,1:16:20.61,Default,,0000,0000,0000,,Сіздің талғамыңызға сай келеді деп үміттенемін.
Dialogue: 0,1:16:20.61,1:16:23.11,Default,,0000,0000,0000,,Мен оны аламын.
Dialogue: 0,1:16:25.61,1:16:27.62,Default,,0000,0000,0000,,Мен оны іштім!
Dialogue: 0,1:16:27.62,1:16:29.79,Default,,0000,0000,0000,,Сіз ішкен шай не болады? ?
Dialogue: 0,1:16:27.62,1:16:29.79,Default,,0000,0000,0000,,Анн.
Dialogue: 0,1:16:29.79,1:16:34.12,Default,,0000,0000,0000,,Ақыр соңында ағзадан шығарылады
Dialogue: 0,1:16:29.79,1:16:34.12,Default,,0000,0000,0000,,Жерге оралу.
Dialogue: 0,1:16:34.12,1:16:37.46,Default,,0000,0000,0000,,Маған жауап бер.
Dialogue: 0,1:16:34.12,1:16:37.46,Default,,0000,0000,0000,,Энн, кешіріңіз!
Dialogue: 0,1:16:37.46,1:16:40.80,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,1:16:37.46,1:16:40.80,Default,,0000,0000,0000,,Бөлмеге кірер алдында қақ деп айтқанмын ғой, иә?
Dialogue: 0,1:16:40.80,1:16:44.63,Default,,0000,0000,0000,,Менің несие мерзімім
Dialogue: 0,1:16:40.80,1:16:44.63,Default,,0000,0000,0000,,Біз 7 күн қабылдаймыз.
Dialogue: 0,1:16:44.63,1:16:49.30,Default,,0000,0000,0000,,Иә, мен бірден бастағым келеді.
Dialogue: 0,1:16:44.63,1:16:49.30,Default,,0000,0000,0000,,Бақытымызға орай, осы жаманның атыс құралдары баяу
Dialogue: 0,1:16:49.30,1:16:51.47,Default,,0000,0000,0000,,Жұмысты қай жерде жасайсың?
Dialogue: 0,1:16:51.47,1:16:55.48,Default,,0000,0000,0000,,Олай болса, жарық күн бөлмесінде.
Dialogue: 0,1:16:51.47,1:16:55.48,Default,,0000,0000,0000,,Мен сізге жақсылық сұрауым керек пе?
Dialogue: 0,1:16:55.48,1:16:57.48,Default,,0000,0000,0000,,Бірақ оны қазір анаға көрсетпе.
Dialogue: 0,1:16:57.48,1:17:00.42,Default,,0000,0000,0000,,Хат жазу
Dialogue: 0,1:16:57.48,1:17:00.42,Default,,0000,0000,0000,,Көмек алыңыз.
Dialogue: 0,1:17:00.42,1:17:03.59,Default,,0000,0000,0000,,Әріптер үшін
Dialogue: 0,1:17:00.42,1:17:03.59,Default,,0000,0000,0000,,Мен оны сізге жаза аламын.
Dialogue: 0,1:17:03.59,1:17:06.42,Default,,0000,0000,0000,,Анна әлі де бар
Dialogue: 0,1:17:03.59,1:17:06.42,Default,,0000,0000,0000,,Күрделі сөздерді қолдану мүмкін болмас еді.
Dialogue: 0,1:17:06.42,1:17:08.42,Default,,0000,0000,0000,,Бұл мүмкін емес!
Dialogue: 0,1:17:08.42,1:17:10.43,Default,,0000,0000,0000,,Және Виолет-сан➡
Dialogue: 0,1:17:10.43,1:17:14.93,Default,,0000,0000,0000,,Хат жазу
Dialogue: 0,1:17:10.43,1:17:14.93,Default,,0000,0000,0000,,Ол өте жақсы және әйгілі.
Dialogue: 0,1:17:14.93,1:17:17.10,Default,,0000,0000,0000,,Біртүрлі, ол...
Dialogue: 0,1:17:17.10,1:17:21.77,Default,,0000,0000,0000,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,1:17:17.10,1:17:21.77,Default,,0000,0000,0000,,Өте алыста жүрген адам.
Dialogue: 0,1:17:21.77,1:17:24.44,Default,,0000,0000,0000,,Алыста ма?
Dialogue: 0,1:17:21.77,1:17:24.44,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:17:24.44,1:17:28.94,Default,,0000,0000,0000,,Бұл маңызды хат.
Dialogue: 0,1:17:24.44,1:17:28.94,Default,,0000,0000,0000,,Солярийге кірмеңіз.
Dialogue: 0,1:17:28.94,1:17:32.75,Default,,0000,0000,0000,,Олай болса, Виолет-сан.
Dialogue: 0,1:17:28.94,1:17:32.75,Default,,0000,0000,0000,,Бақытымызға орай, осы жаманның атыс құралдары баяу
Dialogue: 0,1:17:37.12,1:17:40.62,Default,,0000,0000,0000,,Мұнда
Dialogue: 0,1:17:37.12,1:17:40.62,Default,,0000,0000,0000,,Бұл сіз өзіңізбен бірге алып келген жазу машинкасы болады.
Dialogue: 0,1:17:40.62,1:17:42.62,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:17:42.62,1:17:44.96,Default,,0000,0000,0000,,Бақытымызға орай, осы жаманның атыс құралдары баяу
Dialogue: 0,1:17:44.96,1:17:48.56,Default,,0000,0000,0000,,Күтілгендей, жақсы болмады.
Dialogue: 0,1:17:51.80,1:17:54.80,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:17:54.80,1:17:57.47,Default,,0000,0000,0000,,Ой, бұл қуыршақ!
Dialogue: 0,1:17:57.47,1:18:00.58,Default,,0000,0000,0000,,(шу)
Dialogue: 0,1:18:00.58,1:18:03.28,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:18:00.58,1:18:03.28,Default,,0000,0000,0000,,Ханым...!
Dialogue: 0,1:18:09.42,1:18:14.42,Default,,0000,0000,0000,,Олар енді үйлеріне кетсе екен.
Dialogue: 0,1:18:09.42,1:18:14.42,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:18:14.42,1:18:17.43,Default,,0000,0000,0000,,Жақында сауығып кетесіз.
Dialogue: 0,1:18:17.43,1:18:20.93,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,1:18:20.93,1:18:22.93,Default,,0000,0000,0000,,Шынымен.
Dialogue: 0,1:18:22.93,1:18:27.27,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:18:22.93,1:18:27.27,Default,,0000,0000,0000,,Мен саған бесік жырын айтамын!
Dialogue: 0,1:18:27.27,1:18:29.44,Default,,0000,0000,0000,,Хехе... Рахмет.
Dialogue: 0,1:18:29.44,1:18:32.74,Default,,0000,0000,0000,,Бірақ сенің анаң
Dialogue: 0,1:18:29.44,1:18:32.74,Default,,0000,0000,0000,,Жарайды, өйткені сен ересексің.
Dialogue: 0,1:18:34.78,1:18:38.45,Default,,0000,0000,0000,,Біртүрлі, ол...
Dialogue: 0,1:18:34.78,1:18:38.45,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,1:18:38.45,1:18:40.95,Default,,0000,0000,0000,,Сіз ұйықтауды аяқтадыңыз, солай ма?
Dialogue: 0,1:18:40.95,1:18:43.62,Default,,0000,0000,0000,,Бүгін тамаша!
Dialogue: 0,1:18:43.62,1:18:48.12,Default,,0000,0000,0000,,Ах, жас ханым.
Dialogue: 0,1:18:43.62,1:18:48.12,Default,,0000,0000,0000,,Маған серік болуға рұқсат етіңіз.
Dialogue: 0,1:18:48.12,1:18:50.29,Default,,0000,0000,0000,,Мен тұтынушыларды жек көремін.
Dialogue: 0,1:18:50.29,1:18:53.60,Default,,0000,0000,0000,,Сен анамды менен алып кеттің.
Dialogue: 0,1:18:55.96,1:18:59.63,Default,,0000,0000,0000,,Кешіріңіз, Энн.
Dialogue: 0,1:18:59.63,1:19:02.57,Default,,0000,0000,0000,,Бірақ өтінемін, бар болғаны 7 күнге.
Dialogue: 0,1:19:02.57,1:19:04.97,Default,,0000,0000,0000,,Анаңды ұятқа қалдырма.
Dialogue: 0,1:19:11.25,1:19:15.25,Default,,0000,0000,0000,,Сенің анаң
Dialogue: 0,1:19:11.25,1:19:15.25,Default,,0000,0000,0000,,Сіз аздап үзіліс жасайсыз деп естідім.
Dialogue: 0,1:19:15.25,1:19:18.25,Default,,0000,0000,0000,,Қош бол?
Dialogue: 0,1:19:18.25,1:19:20.92,Default,,0000,0000,0000,,Ол аздап ұйықтап қалғанын айтты.
Dialogue: 0,1:19:20.92,1:19:26.03,Default,,0000,0000,0000,,Арасында
Dialogue: 0,1:19:20.92,1:19:26.03,Default,,0000,0000,0000,,Мен сенің серігің боламын.
Dialogue: 0,1:19:28.10,1:19:31.10,Default,,0000,0000,0000,,Мен тұтынушыларды жек көремін ➡
Dialogue: 0,1:19:31.10,1:19:33.77,Default,,0000,0000,0000,,Өйткені сен қуыршақсың.
Dialogue: 0,1:19:33.77,1:19:36.77,Default,,0000,0000,0000,,Ойласам, бүгін еді ғой, иә?
Dialogue: 0,1:19:36.77,1:19:42.44,Default,,0000,0000,0000,,Мм... иә, сөйлесейік.
Dialogue: 0,1:19:36.77,1:19:42.44,Default,,0000,0000,0000,,Ойнайтын нәрсе.
Dialogue: 0,1:19:42.44,1:19:46.28,Default,,0000,0000,0000,,Бұл менің жауапкершілігімнен тыс тапсырма.
Dialogue: 0,1:19:46.28,1:19:50.49,Default,,0000,0000,0000,,Бірақ аз ғана болса...
Dialogue: 0,1:19:52.45,1:19:55.96,Default,,0000,0000,0000,,Ал, қуыршақтармен ойнайық.
Dialogue: 0,1:19:52.45,1:19:55.96,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:19:59.29,1:20:01.96,Default,,0000,0000,0000,,Хехехе... хехехе.
Dialogue: 0,1:20:01.96,1:20:07.47,Default,,0000,0000,0000,,Қуыршақтар қуыршақтармен ойнайды
Dialogue: 0,1:20:01.96,1:20:07.47,Default,,0000,0000,0000,,Қызық, иә?
Dialogue: 0,1:20:07.47,1:20:09.47,Default,,0000,0000,0000,,Мұнымен не істеуіміз керек?
Dialogue: 0,1:20:09.47,1:20:12.97,Default,,0000,0000,0000,,Сөйлесу немесе сізге қамқорлық жасау
Dialogue: 0,1:20:09.47,1:20:12.97,Default,,0000,0000,0000,,Ол қазірдің өзінде шешілді.
Dialogue: 0,1:20:12.97,1:20:15.81,Default,,0000,0000,0000,,Алдымен сәлем айтыңыз.
Dialogue: 0,1:20:15.81,1:20:18.31,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,1:20:18.31,1:20:21.15,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,1:20:21.15,1:20:24.15,Default,,0000,0000,0000,,О, сәлем.
Dialogue: 0,1:20:26.82,1:20:29.66,Default,,0000,0000,0000,,Қуыршақ осылай деді!
Dialogue: 0,1:20:29.66,1:20:31.66,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:20:31.66,1:20:33.66,Default,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,1:20:33.66,1:20:36.33,Default,,0000,0000,0000,,Түсіндім! Өйткені сен қуыршақсың➡
Dialogue: 0,1:20:36.33,1:20:39.50,Default,,0000,0000,0000,,Сіз ойнаған болсаңыз да
Dialogue: 0,1:20:36.33,1:20:39.50,Default,,0000,0000,0000,,Сіз онымен ешқашан ойнаған емессіз.
Dialogue: 0,1:20:39.50,1:20:42.50,Default,,0000,0000,0000,,Жоқ, мен...
Dialogue: 0,1:20:39.50,1:20:42.50,Default,,0000,0000,0000,,Мен саған айтамын!
Dialogue: 0,1:20:42.50,1:20:45.34,Default,,0000,0000,0000,,Олай болса
Dialogue: 0,1:20:42.50,1:20:45.34,Default,,0000,0000,0000,,Енді үй ойынын ойнайық.
Dialogue: 0,1:20:45.34,1:20:48.34,Default,,0000,0000,0000,,Бақшада үстел де бар.
Dialogue: 0,1:20:45.34,1:20:48.34,Default,,0000,0000,0000,,Бұл➡
Dialogue: 0,1:20:48.34,1:20:51.85,Default,,0000,0000,0000,,Сіздің бөлмеңіз дайын.
Dialogue: 0,1:20:48.34,1:20:51.85,Default,,0000,0000,0000,,Біз сізге хабарлаймыз.
Dialogue: 0,1:20:51.85,1:20:54.02,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:20:54.02,1:20:56.32,Default,,0000,0000,0000,,Олай болса, жас ханым.
Dialogue: 0,1:20:58.35,1:21:00.66,Default,,0000,0000,0000,,Бөлме екінші қабатта болады.
Dialogue: 0,1:21:02.79,1:21:04.79,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,1:21:09.63,1:21:12.97,Default,,0000,0000,0000,,Маған қызық, сіз не туралы айтып отырсыз...
Dialogue: 0,1:21:12.97,1:21:15.14,Default,,0000,0000,0000,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:21:15.14,1:21:18.31,Default,,0000,0000,0000,,Ах! Эллис!
Dialogue: 0,1:21:18.31,1:21:20.81,Default,,0000,0000,0000,,Мен әкелемін.
Dialogue: 0,1:21:18.31,1:21:20.81,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:21:20.81,1:21:23.81,Default,,0000,0000,0000,,Бұл менің жұмысым➡
Dialogue: 0,1:21:23.81,1:21:27.15,Default,,0000,0000,0000,,Өтінемін, қабылдамаңыз.
Dialogue: 0,1:21:27.15,1:21:29.32,Default,,0000,0000,0000,,Қазірдің өзінде!
Dialogue: 0,1:21:29.32,1:21:31.99,Default,,0000,0000,0000,,Өмір дегеніміз не?
Dialogue: 0,1:21:29.32,1:21:31.99,Default,,0000,0000,0000,,Неліктен бұлай болды деп ойлаймын.
Dialogue: 0,1:21:31.99,1:21:33.99,Default,,0000,0000,0000,,Мм.
Dialogue: 0,1:21:51.51,1:21:54.01,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:21:54.01,1:21:58.51,Default,,0000,0000,0000,,«Ал ұры
Dialogue: 0,1:21:54.01,1:21:58.51,Default,,0000,0000,0000,,«Уау! ” деп айқайлаңыз➡
Dialogue: 0,1:21:58.51,1:22:00.95,Default,,0000,0000,0000,,Ол қорқып, қашып кетті».
Dialogue: 0,1:22:00.95,1:22:05.29,Default,,0000,0000,0000,,Сіз жақсысыз
Dialogue: 0,1:22:00.95,1:22:05.29,Default,,0000,0000,0000,,Мен кітап оқуда жақсы емеспін.
Dialogue: 0,1:22:05.29,1:22:08.79,Default,,0000,0000,0000,,Күлгін~!
Dialogue: 0,1:22:08.79,1:22:13.96,Default,,0000,0000,0000,,Нан - бұл нан, бірақ бұл өте қиын.
Dialogue: 0,1:22:08.79,1:22:13.96,Default,,0000,0000,0000,,Қандай нан жеуге жарамсыз?
Dialogue: 0,1:22:13.96,1:22:17.30,Default,,0000,0000,0000,,Оны жұмсарту үшін сорпаға қосыңыз.
Dialogue: 0,1:22:17.30,1:22:20.64,Default,,0000,0000,0000,,Күлгін~! Күлгін~!
Dialogue: 0,1:22:20.64,1:22:24.81,Default,,0000,0000,0000,,Анасы келгенше
Dialogue: 0,1:22:20.64,1:22:24.81,Default,,0000,0000,0000,,Жұмбақ айтып, бірге билеңіз➡
Dialogue: 0,1:22:24.81,1:22:27.31,Default,,0000,0000,0000,,Үйде ойнап, жәндіктерді аула.
Dialogue: 0,1:22:27.31,1:22:31.11,Default,,0000,0000,0000,,Ол келді.
Dialogue: 0,1:22:27.31,1:22:31.11,Default,,0000,0000,0000,,Сіздің басымдықтарыңыз қандай?
Dialogue: 0,1:22:35.48,1:22:38.99,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,1:22:35.48,1:22:38.99,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:22:38.99,1:22:43.66,Default,,0000,0000,0000,,Өте жақсы.
Dialogue: 0,1:22:38.99,1:22:43.66,Default,,0000,0000,0000,,Сонымен, бұл әсермен.
Dialogue: 0,1:22:43.66,1:22:45.83,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,1:22:45.83,1:22:50.17,Default,,0000,0000,0000,,Ха ха ха...
Dialogue: 0,1:22:50.17,1:22:52.17,Default,,0000,0000,0000,,Энн!
Dialogue: 0,1:22:52.17,1:22:54.67,Default,,0000,0000,0000,,Жоқ... жоқ! Ва...фиолетке➡
Dialogue: 0,1:22:54.67,1:22:57.67,Default,,0000,0000,0000,,Мен лента тақсам ба деп ойладым.
Dialogue: 0,1:22:57.67,1:23:00.61,Default,,0000,0000,0000,,Мен түсіндім. Бірақ кейінірек.
Dialogue: 0,1:23:00.61,1:23:04.61,Default,,0000,0000,0000,,Ханым, азғана үзіліс жасасаңыз да,
Dialogue: 0,1:23:00.61,1:23:04.61,Default,,0000,0000,0000,,(Норияки Какёин) 500 сингапур доллары.
Dialogue: 0,1:23:04.61,1:23:08.82,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,1:23:04.61,1:23:08.82,Default,,0000,0000,0000,,Менің ойымша, қазір уақыт келді, жас ханым.
Dialogue: 0,1:23:10.95,1:23:14.79,Default,,0000,0000,0000,,Орындалды, жас ханым.
Dialogue: 0,1:23:14.79,1:23:19.13,Default,,0000,0000,0000,,Шын мәнінде, Виолетке арналған лента
Dialogue: 0,1:23:14.79,1:23:19.13,Default,,0000,0000,0000,,Менің оны кигенімді қалайсыз...
Dialogue: 0,1:23:19.13,1:23:23.47,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:23:19.13,1:23:23.47,Default,,0000,0000,0000,,Сенің анам болғаныңды қалаймын.
Dialogue: 0,1:23:23.47,1:23:26.97,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:23:23.47,1:23:26.97,Default,,0000,0000,0000,,Кітаптарды бірге оқу➡
Dialogue: 0,1:23:26.97,1:23:29.64,Default,,0000,0000,0000,,Жұмбақтар мен үй ойындары.
Dialogue: 0,1:23:29.64,1:23:32.47,Default,,0000,0000,0000,,Жәндіктер... анам оларды ұнатпайды.
Dialogue: 0,1:23:32.47,1:23:36.31,Default,,0000,0000,0000,,Анаммен уақытымды алма
Dialogue: 0,1:23:32.47,1:23:36.31,Default,,0000,0000,0000,,Жылдамдық көрсетілмеген.
Dialogue: 0,1:23:36.31,1:23:38.31,Default,,0000,0000,0000,,Санаулы күндер қалды.
Dialogue: 0,1:23:38.31,1:23:43.32,Default,,0000,0000,0000,,Сосын хат жазып жатқанда.
Dialogue: 0,1:23:38.31,1:23:43.32,Default,,0000,0000,0000,,Айтшы, мен де сенің жаныңда қала аламын!
Dialogue: 0,1:23:43.32,1:23:45.32,Default,,0000,0000,0000,,Мен сенің қасыңда болғым келеді!
Dialogue: 0,1:23:45.32,1:23:49.32,Default,,0000,0000,0000,,Оны қонақ бөлмеге кіргіз.
Dialogue: 0,1:23:45.32,1:23:49.32,Default,,0000,0000,0000,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,1:23:49.32,1:23:53.16,Default,,0000,0000,0000,,Кешіріңіз. Біз бұл сұрауды қабылдай алмаймыз.
Dialogue: 0,1:23:53.16,1:23:56.33,Default,,0000,0000,0000,,Неге!
Dialogue: 0,1:23:53.16,1:23:56.33,Default,,0000,0000,0000,,Кешіріңіз, жас ханым.
Dialogue: 0,1:23:56.33,1:23:59.63,Default,,0000,0000,0000,,Мен тезірек оралуым керек.
Dialogue: 0,1:24:06.78,1:24:11.45,Default,,0000,0000,0000,,Бүгін бара аламын ба деп ойлаймын.
Dialogue: 0,1:24:06.78,1:24:11.45,Default,,0000,0000,0000,,Иә, егер бұлай болса.
Dialogue: 0,1:24:11.45,1:24:13.78,Default,,0000,0000,0000,,Ханым, өтінемін.
Dialogue: 0,1:24:13.78,1:24:16.12,Default,,0000,0000,0000,,Уф….
Dialogue: 0,1:24:13.78,1:24:16.12,Default,,0000,0000,0000,,ханым.
Dialogue: 0,1:24:16.12,1:24:20.12,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:24:20.12,1:24:24.13,Default,,0000,0000,0000,,Уф!
Dialogue: 0,1:24:20.12,1:24:24.13,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:24:24.13,1:24:26.96,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:24:24.13,1:24:26.96,Default,,0000,0000,0000,,Бірақ….
Dialogue: 0,1:24:26.96,1:24:29.63,Default,,0000,0000,0000,,Жалғастырыңыз.
Dialogue: 0,1:24:26.96,1:24:29.63,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,1:24:29.63,1:24:32.63,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,1:24:29.63,1:24:32.63,Default,,0000,0000,0000,,Ханым.
Dialogue: 0,1:24:29.63,1:24:32.63,Default,,0000,0000,0000,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,1:24:32.63,1:24:35.47,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,1:24:32.63,1:24:35.47,Default,,0000,0000,0000,,Анн.
Dialogue: 0,1:24:35.47,1:24:39.07,Default,,0000,0000,0000,,Не ойнап жүрсің осылайша кішкентай баланы таптап!
Dialogue: 0,1:24:35.47,1:24:39.07,Default,,0000,0000,0000,,Сол жаққа барыңыз.
Dialogue: 0,1:24:41.31,1:24:44.65,Default,,0000,0000,0000,,Неге!
Dialogue: 0,1:24:41.31,1:24:44.65,Default,,0000,0000,0000,,Неге хат жазу керек!
Dialogue: 0,1:24:44.65,1:24:48.65,Default,,0000,0000,0000,,Біртүрлі, ол...
Dialogue: 0,1:24:44.65,1:24:48.65,Default,,0000,0000,0000,,Менің әкем енді жоқ!
Dialogue: 0,1:24:48.65,1:24:50.65,Default,,0000,0000,0000,,Бұл маңызды хат.
Мен танымайтын біреудің
Dialogue: 0,1:24:50.65,1:24:53.32,Default,,0000,0000,0000,,...
Dialogue: 0,1:24:50.65,1:24:53.32,Default,,0000,0000,0000,,Бұл хат!
Dialogue: 0,1:24:53.32,1:24:57.16,Default,,0000,0000,0000,,Саған да келмейтін адам!
Dialogue: 0,1:24:53.32,1:24:57.16,Default,,0000,0000,0000,,Анаңыз туралы➡
Dialogue: 0,1:24:57.16,1:25:01.16,Default,,0000,0000,0000,,Кімді шынымен уайымдайды?
Dialogue: 0,1:24:57.16,1:25:01.16,Default,,0000,0000,0000,,Ол жоқ!
Dialogue: 0,1:25:06.43,1:25:09.54,Default,,0000,0000,0000,,Бөлмеге кірер алдында қақ деп айтқанмын ғой, иә?
Dialogue: 0,1:25:12.27,1:25:16.11,Default,,0000,0000,0000,,Ештеңе Аннадан маңызды емес.
Dialogue: 0,1:25:16.11,1:25:20.95,Default,,0000,0000,0000,,Анам өтірікке толы.
Dialogue: 0,1:25:16.11,1:25:20.95,Default,,0000,0000,0000,,Бұл өтірік емес.
Dialogue: 0,1:25:20.95,1:25:24.62,Default,,0000,0000,0000,,Өйткені анам
Dialogue: 0,1:25:20.95,1:25:24.62,Default,,0000,0000,0000,,Одан да жақсы болмайды.
Dialogue: 0,1:25:24.62,1:25:26.96,Default,,0000,0000,0000,,Жақында өзіңізді жақсы сезінесіз.
Dialogue: 0,1:25:24.62,1:25:26.96,Default,,0000,0000,0000,,Мен айтқанмен!
Dialogue: 0,1:25:26.96,1:25:30.29,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:25:26.96,1:25:30.29,Default,,0000,0000,0000,,Мен білемін!
Dialogue: 0,1:25:30.29,1:25:35.60,Default,,0000,0000,0000,,Менің анам... Анашым...
Dialogue: 0,1:25:30.29,1:25:35.60,Default,,0000,0000,0000,,Мен кеткенде, жалғыз қаламын!
Dialogue: 0,1:25:37.97,1:25:41.47,Default,,0000,0000,0000,,Мен анаммен қанша уақыт боламын?
Dialogue: 0,1:25:37.97,1:25:41.47,Default,,0000,0000,0000,,Біз бірге бола аламыз! ?
Dialogue: 0,1:25:43.81,1:25:45.97,Default,,0000,0000,0000,,Бұдан былай мәңгі жалғыз қалғыңыз келсе➡
Dialogue: 0,1:25:45.97,1:25:49.64,Default,,0000,0000,0000,,Маған хат жазба
Dialogue: 0,1:25:45.97,1:25:49.64,Default,,0000,0000,0000,,Қазір менімен бірге бол!
Dialogue: 0,1:25:49.64,1:25:51.65,Default,,0000,0000,0000,,Менімен бірге бол!
Dialogue: 0,1:25:51.65,1:25:54.48,Default,,0000,0000,0000,,Олар тек өз клиенттері үшін ғана әдемі сөздер жазады.
Dialogue: 0,1:25:54.48,1:25:57.65,Default,,0000,0000,0000,,Ханым.
Dialogue: 0,1:25:54.48,1:25:57.65,Default,,0000,0000,0000,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,1:25:57.65,1:26:01.92,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:26:01.92,1:26:04.76,Default,,0000,0000,0000,,Мен атама тіл тигізуіңе, тіпті маған тіл тигізуіңе де жол бере алмаймын.
Dialogue: 0,1:26:04.76,1:26:22.44,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:26:22.44,1:26:25.95,Default,,0000,0000,0000,,Ха ха ха...
Dialogue: 0,1:26:25.95,1:26:34.62,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:26:34.62,1:26:36.96,Default,,0000,0000,0000,,Ханым.
Dialogue: 0,1:26:36.96,1:26:41.96,Default,,0000,0000,0000,,Мен жас ханымның уақытын жұтып жатырмын.
Dialogue: 0,1:26:36.96,1:26:41.96,Default,,0000,0000,0000,,Бұл мағынасы бар.
Dialogue: 0,1:26:41.96,1:26:46.47,Default,,0000,0000,0000,,Өтінемін, анаңа.
Dialogue: 0,1:26:41.96,1:26:46.47,Default,,0000,0000,0000,,Өтінемін, ашуланбаңыз.
Dialogue: 0,1:26:46.47,1:26:49.80,Default,,0000,0000,0000,,Өйткені... Өйткені...
Dialogue: 0,1:26:49.80,1:26:52.47,Default,,0000,0000,0000,,Жас келіншекке не қиын?
Dialogue: 0,1:26:49.80,1:26:52.47,Default,,0000,0000,0000,,Әрине.
Dialogue: 0,1:26:52.47,1:26:57.65,Default,,0000,0000,0000,,Сол кішкентай денеңмен сен анаң сияқтысың.
Dialogue: 0,1:26:52.47,1:26:57.65,Default,,0000,0000,0000,,Сіз өзіңіздің ауруыңызды қабылдайсыз.
Dialogue: 0,1:26:57.65,1:27:02.92,Default,,0000,0000,0000,,Сіз өте таңданарлықсыз.
Dialogue: 0,1:26:57.65,1:27:02.92,Default,,0000,0000,0000,,Не ол? Сол жақта.
Dialogue: 0,1:27:02.92,1:27:05.09,Default,,0000,0000,0000,,Керемет емес.
Dialogue: 0,1:27:05.09,1:27:10.09,Default,,0000,0000,0000,,Мен... Мен анамды жылаттым.
Dialogue: 0,1:27:10.09,1:27:13.60,Default,,0000,0000,0000,,Жоқ Жас келіншек мейірімді адам.
Dialogue: 0,1:27:13.60,1:27:15.76,Default,,0000,0000,0000,,Жоқ….
Dialogue: 0,1:27:13.60,1:27:15.76,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,1:27:15.76,1:27:17.93,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:27:17.93,1:27:20.77,Default,,0000,0000,0000,,《Дұрыс… Мен Хинацукиді құтқардым.》
Dialogue: 0,1:27:20.77,1:27:24.61,Default,,0000,0000,0000,,Себебі мен жиіркенішті баламын
Dialogue: 0,1:27:20.77,1:27:24.61,Default,,0000,0000,0000,,Анам ауырып қалды...
Dialogue: 0,1:27:24.61,1:27:29.11,Default,,0000,0000,0000,,Сәйкес емес.
Dialogue: 0,1:27:24.61,1:27:29.11,Default,,0000,0000,0000,,(Туған туыс) Олай деуге болады, бірақ (Туған туыс) бұл маңызды мәселе.
Dialogue: 0,1:27:29.11,1:27:33.45,Default,,0000,0000,0000,,Ешкім...
Dialogue: 0,1:27:29.11,1:27:33.45,Default,,0000,0000,0000,,Бұл сіздің бақылауыңыздан тыс.
Dialogue: 0,1:27:33.45,1:27:38.29,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:27:33.45,1:27:38.29,Default,,0000,0000,0000,,Менің қолым сенікі сияқты➡
Dialogue: 0,1:27:38.29,1:27:41.99,Default,,0000,0000,0000,,Ол сізге жұмсақ тері бермейді.
Dialogue: 0,1:27:38.29,1:27:41.99,Default,,0000,0000,0000,,сонша.
Dialogue: 0,1:27:44.63,1:27:47.53,Default,,0000,0000,0000,,Бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,1:27:53.30,1:27:57.81,Default,,0000,0000,0000,,Ана. ана….
Dialogue: 0,1:28:00.24,1:28:03.41,Default,,0000,0000,0000,,Неге... хат жазу...?
Dialogue: 0,1:28:03.41,1:28:06.58,Default,,0000,0000,0000,,Адамдар үшін
Dialogue: 0,1:28:03.41,1:28:06.58,Default,,0000,0000,0000,,Менің айтқым келетін сезімдерім бар.
Dialogue: 0,1:28:06.58,1:28:12.09,Default,,0000,0000,0000,,Мұндай нәрсе... сізге жетудің қажеті жоқ.
Dialogue: 0,1:28:12.09,1:28:15.42,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:28:15.42,1:28:21.43,Default,,0000,0000,0000,,Жеткізу қажет емес хаттар жоқ.
Dialogue: 0,1:28:15.42,1:28:21.43,Default,,0000,0000,0000,,Жоқ, ханым.
Dialogue: 0,1:28:21.43,1:28:29.94,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:28:32.44,1:28:37.11,Default,,0000,0000,0000,,《Анна: Ал мен.
Dialogue: 0,1:28:32.44,1:28:37.11,Default,,0000,0000,0000,,Мені құшақтап алған қуыршақ➡
Dialogue: 0,1:28:37.11,1:28:41.45,Default,,0000,0000,0000,,Хат жазғаннан кейін
Dialogue: 0,1:28:37.11,1:28:41.45,Default,,0000,0000,0000,,Қоштасатын күн келді》
Dialogue: 0,1:28:41.45,1:28:51.63,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:28:51.63,1:28:54.03,Default,,0000,0000,0000,,Күлгін.
Dialogue: 0,1:29:02.24,1:29:05.04,Default,,0000,0000,0000,,Ханым.
Dialogue: 0,1:29:02.24,1:29:05.04,Default,,0000,0000,0000,,Бұл.
Dialogue: 0,1:29:07.24,1:29:10.04,Default,,0000,0000,0000,,Жылы ма?
Dialogue: 0,1:29:12.41,1:29:15.92,Default,,0000,0000,0000,,Мүмкін...
Dialogue: 0,1:29:15.92,1:29:18.09,Default,,0000,0000,0000,,Олай болса, ішкен шай ше? ?
Dialogue: 0,1:29:18.09,1:29:23.49,Default,,0000,0000,0000,,Демек, ол ақыр соңында денеден шығарылады.
Dialogue: 0,1:29:18.09,1:29:23.49,Default,,0000,0000,0000,,Жерге оралу.
Dialogue: 0,1:29:30.60,1:29:33.43,Default,,0000,0000,0000,,《Анн: Яғни
Dialogue: 0,1:29:30.60,1:29:33.43,Default,,0000,0000,0000,,Бұл қуыршақ емес еді.
Dialogue: 0,1:29:33.43,1:29:37.11,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,1:29:33.43,1:29:37.11,Default,,0000,0000,0000,,Бұл да жаман болған жоқ.
Dialogue: 0,1:29:37.11,1:29:41.28,Default,,0000,0000,0000,,Сіз өте мейірімдісіз...
Dialogue: 0,1:29:41.28,1:29:46.78,Default,,0000,0000,0000,,I Ол кісі жазған хат
Dialogue: 0,1:29:41.28,1:29:46.78,Default,,0000,0000,0000,,Мен оны оқығым келді.
Dialogue: 0,1:29:46.78,1:29:50.28,Default,,0000,0000,0000,,Матсуда мырза өледі.
Dialogue: 0,1:29:46.78,1:29:50.28,Default,,0000,0000,0000,,Хат кімге жазылған?
Dialogue: 0,1:29:50.28,1:29:55.29,Default,,0000,0000,0000,,Энн! Енді шай ішейік.
Dialogue: 0,1:29:55.29,1:29:58.29,Default,,0000,0000,0000,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,1:29:55.29,1:29:58.29,Default,,0000,0000,0000,,Қуыршақтармен ойнайық.
Dialogue: 0,1:29:58.29,1:30:01.30,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:29:58.29,1:30:01.30,Default,,0000,0000,0000,,Олай болса кітапты оқыңыз➡
Dialogue: 0,1:30:01.30,1:30:03.63,Default,,0000,0000,0000,,Ойын үйі.
Dialogue: 0,1:30:01.30,1:30:03.63,Default,,0000,0000,0000,,Жақсы, жақсы.
Dialogue: 0,1:30:03.63,1:30:14.48,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:30:14.48,1:30:17.28,Default,,0000,0000,0000,,Анн.
Dialogue: 0,1:30:20.82,1:30:23.12,Default,,0000,0000,0000,,Анн.
Dialogue: 0,1:30:26.99,1:30:29.99,Default,,0000,0000,0000,,Менің Аннам.
Dialogue: 0,1:30:29.99,1:30:49.18,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:30:49.18,1:30:51.58,Default,,0000,0000,0000,,Анн.
Dialogue: 0,1:30:55.02,1:30:59.69,Default,,0000,0000,0000,,[Аннаның анасы: «Анна.
Dialogue: 0,1:30:55.02,1:30:59.69,Default,,0000,0000,0000,,8-жасың құтты болсын.
Dialogue: 0,1:30:59.69,1:31:02.79,Default,,0000,0000,0000,,Өкінішті
Dialogue: 0,1:30:59.69,1:31:02.79,Default,,0000,0000,0000,,Көп болуы мүмкін.
Dialogue: 0,1:31:02.79,1:31:05.79,Default,,0000,0000,0000,,Мен көп жұмыс істеуім керек.
Dialogue: 0,1:31:02.79,1:31:05.79,Default,,0000,0000,0000,,Бәлкім, көңіліңіз түсіп кеткен шығар.
Dialogue: 0,1:31:05.79,1:31:07.80,Default,,0000,0000,0000,,Бірақ берілме.
Dialogue: 0,1:31:07.80,1:31:11.13,Default,,0000,0000,0000,,Кейде өзімді жалғыз сезініп, жылаймын
Dialogue: 0,1:31:07.80,1:31:11.13,Default,,0000,0000,0000,,Мүмкін, бірақ➡
Dialogue: 0,1:31:11.13,1:31:13.13,Default,,0000,0000,0000,,Ұмытпа.
Dialogue: 0,1:31:13.13,1:31:17.84,Default,,0000,0000,0000,,Ана әрқашан
Dialogue: 0,1:31:13.13,1:31:17.84,Default,,0000,0000,0000,,Мен сені жақсы көремін Анна».
Dialogue: 0,1:31:20.81,1:31:24.31,Default,,0000,0000,0000,,``Анна. 10 жасыңыз құтты болсын.
Dialogue: 0,1:31:24.31,1:31:28.65,Default,,0000,0000,0000,,Менің бойым әлдеқайда өсті.
Dialogue: 0,1:31:24.31,1:31:28.65,Default,,0000,0000,0000,,Менің ойымша, ол үлкенірек болды.
Dialogue: 0,1:31:28.65,1:31:30.82,Default,,0000,0000,0000,,Бірақ мен әлі де кітап оқимын➡
Dialogue: 0,1:31:30.82,1:31:33.32,Default,,0000,0000,0000,,Би - бұл
Dialogue: 0,1:31:30.82,1:31:33.32,Default,,0000,0000,0000,,Сізге ұнайды.
Dialogue: 0,1:31:33.32,1:31:36.32,Default,,0000,0000,0000,,Жұмбақтар мен жәндіктердің тұзағы
Dialogue: 0,1:31:33.32,1:31:36.32,Default,,0000,0000,0000,,Сіз оқуды бітірдіңіз бе?''
Dialogue: 0,1:31:38.99,1:31:42.66,Default,,0000,0000,0000,,《18 жасыңыз құтты болсын.
Dialogue: 0,1:31:42.66,1:31:44.83,Default,,0000,0000,0000,,Сіз жақсы ханымсыз.
Dialogue: 0,1:31:44.83,1:31:47.84,Default,,0000,0000,0000,,Мен өзіме ұнайтын адамды таптым ба деп ойлаймын.
Dialogue: 0,1:31:47.84,1:31:50.51,Default,,0000,0000,0000,,Мен сенен махаббат туралы кеңес сұрай алмаймын, бірақ➡
Dialogue: 0,1:31:50.51,1:31:53.51,Default,,0000,0000,0000,,Сіз таңдаған адам екеніне сенімдімін➡
Dialogue: 0,1:31:53.51,1:31:56.61,Default,,0000,0000,0000,,Сіз өте жақсы адамсыз.''
Dialogue: 0,1:32:01.28,1:32:04.45,Default,,0000,0000,0000,,《Туған күніңмен Анна.
Dialogue: 0,1:32:04.45,1:32:08.12,Default,,0000,0000,0000,,Сіз 20 жыл өмір сүрдіңіз. Бұл керемет.
Dialogue: 0,1:32:08.12,1:32:12.63,Default,,0000,0000,0000,,Тіпті ересек адам болса да, кейде
Dialogue: 0,1:32:08.12,1:32:12.63,Default,,0000,0000,0000,,Қыңсылаудың жөні жоқ.
Dialogue: 0,1:32:12.63,1:32:18.80,Default,,0000,0000,0000,,Мазасыздық сезінсеңіз де
Dialogue: 0,1:32:12.63,1:32:18.80,Default,,0000,0000,0000,,Мен осындамын.
Dialogue: 0,1:32:18.80,1:32:22.47,Default,,0000,0000,0000,,Анн.
Dialogue: 0,1:32:22.47,1:32:28.14,Default,,0000,0000,0000,,Мен сені үнемі бақылап отырамын.''
Dialogue: 0,1:32:28.14,1:32:48.16,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:32:48.16,1:32:50.16,Default,,0000,0000,0000,,Еңбектеріңіз үшін рахмет.
Dialogue: 0,1:32:50.16,1:32:52.17,Default,,0000,0000,0000,,Үлкен сома!
Dialogue: 0,1:32:52.17,1:32:56.50,Default,,0000,0000,0000,,Келесі 50 жыл ішінде
Dialogue: 0,1:32:52.17,1:32:56.50,Default,,0000,0000,0000,,Бұл Анна Магнолияға жеткізуге арналған хат.
Dialogue: 0,1:32:56.50,1:32:58.67,Default,,0000,0000,0000,,Мен 50 хат жаздым!
Dialogue: 0,1:32:58.67,1:33:02.94,Default,,0000,0000,0000,,Менің іссапарда жүргеніме көп болды.
Dialogue: 0,1:32:58.67,1:33:02.94,Default,,0000,0000,0000,,Жақсы болды ма?
Dialogue: 0,1:33:02.94,1:33:04.95,Default,,0000,0000,0000,,Мәселе жоқ.
Dialogue: 0,1:33:04.95,1:33:06.95,Default,,0000,0000,0000,,Бірақ бұл жақсы.
Dialogue: 0,1:33:06.95,1:33:09.62,Default,,0000,0000,0000,,Мен оны бұдан былай жыл сайын алуды асыға күтемін.
Dialogue: 0,1:33:09.62,1:33:14.12,Default,,0000,0000,0000,,Иә, бірақ...
Dialogue: 0,1:33:09.62,1:33:14.12,Default,,0000,0000,0000,,Е...
Dialogue: 0,1:33:14.12,1:33:18.13,Default,,0000,0000,0000,,Анаң келгенше...
Dialogue: 0,1:33:18.13,1:33:21.96,Default,,0000,0000,0000,,Әлі де кішкентай...
Dialogue: 0,1:33:21.96,1:33:24.47,Default,,0000,0000,0000,,Мен өзімді жалғыз сезінемін...
Dialogue: 0,1:33:24.47,1:33:30.64,Default,,0000,0000,0000,,Сенің анаң
Dialogue: 0,1:33:24.47,1:33:30.64,Default,,0000,0000,0000,,Сүйікті жас ханымды артта қалдырып...
Dialogue: 0,1:33:30.64,1:33:34.31,Default,,0000,0000,0000,,Мен сол сарайда жалғыз қалдым...
Dialogue: 0,1:33:34.31,1:33:36.81,Default,,0000,0000,0000,,Мен….
Dialogue: 0,1:33:39.81,1:33:43.48,Default,,0000,0000,0000,,Мен… Мен әрқашан сарайда болдым….
Dialogue: 0,1:33:43.48,1:33:46.15,Default,,0000,0000,0000,,Мен жылаудан ұстап тұрдым.
Dialogue: 0,1:33:46.15,1:33:50.16,Default,,0000,0000,0000,,Иә. Бірақ Күлгін➡
Dialogue: 0,1:33:50.16,1:33:55.16,Default,,0000,0000,0000,,Ол келеді. Сіз жазған хат.
Dialogue: 0,1:33:55.16,1:33:59.17,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,1:33:59.17,1:34:03.37,Default,,0000,0000,0000,,Алыста болсаң да...
Dialogue: 0,1:34:04.87,1:34:10.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory