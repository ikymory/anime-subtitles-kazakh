Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:16.32,0:01:17.45,Default,,0,0,0,,Біз оны сізге дайындаймыз.
Dialogue: 0,0:01:17.53,0:01:18.95,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:01:19.82,0:01:22.45,Default,,0,0,0,,Сізге Кашикомаримасу дайындалады.
Dialogue: 0,0:01:23.79,0:01:26.08,Default,,0,0,0,,О, сен бұл
Dialogue: 0,0:01:26.16,0:01:26.83,Default,,0,0,0,,Хмм... мм?
Dialogue: 0,0:01:26.83,0:01:28.71,Default,,0,0,0,,Хмм... мм?
Dialogue: 0,0:01:26.83,0:01:28.71,Default,,0,0,0,,Неге менімен бірге келуге тура келді?
Dialogue: 0,0:01:29.29,0:01:29.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:29.75,0:01:30.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:29.75,0:01:30.34,Default,,0,0,0,,Сәл күтіңіз.
Dialogue: 0,0:01:30.34,0:01:31.13,Default,,0,0,0,,Сәл күтіңіз.
Dialogue: 0,0:01:31.63,0:01:32.71,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:01:37.13,0:01:39.18,Default,,0,0,0,,Бұл жерде қызық ештеңе жоқ.
Dialogue: 0,0:01:39.26,0:01:40.64,Default,,0,0,0,,Иә
Dialogue: 0,0:01:42.68,0:01:44.89,Default,,0,0,0,,Бірдеңе ішуді қалайсыз ба?
Dialogue: 0,0:01:45.48,0:01:47.94,Default,,0,0,0,,А... сонда да солай.
Dialogue: 0,0:01:47.94,0:01:48.14,Default,,0,0,0,,Аа... сонда да солай.
Dialogue: 0,0:01:47.94,0:01:48.14,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:01:48.14,0:01:49.31,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:01:49.98,0:01:53.23,Default,,0,0,0,,Наурыздан бері бәрін жеген жалғыз адамсың.
Dialogue: 0,0:01:53.32,0:01:55.19,Default,,0,0,0,,Бұл Хаунсен.
Dialogue: 0,0:01:55.28,0:01:57.24,Default,,0,0,0,,Себебі мен мүфти Еріннен құтылуым керек еді.
Dialogue: 0,0:01:57.32,0:01:59.57,Default,,0,0,0,,Сен жерге түсесің бе?
Dialogue: 0,0:02:02.70,0:02:05.41,Default,,0,0,0,,Сіз кем дегенде полковниксіз бе?
Dialogue: 0,0:02:05.50,0:02:09.58,Default,,0,0,0,,Сіз қалай ойлайсыз? Мүфти Нәбию Ерин
Dialogue: 0,0:02:09.67,0:02:11.54,Default,,0,0,0,,Не!? Аа, неге?
Dialogue: 0,0:02:11.63,0:02:12.96,Default,,0,0,0,,Бұл гаусен
Dialogue: 0,0:02:13.04,0:02:17.01,Default,,0,0,0,,Бұл арнайы рейс, егер сізде жақсы байланыс болмаса, сізге отыруға рұқсат етілмейді.
Dialogue: 0,0:02:17.09,0:02:19.18,Default,,0,0,0,,Сонымен қатар, бүгінгі тұтынушылардың көпшілігі
Dialogue: 0,0:02:19.26,0:02:24.64,Default,,0,0,0,,Аделаида конференциясына бара жатқан федералды үкімет министрлері, бюрократтар және олардың отбасылары
Dialogue: 0,0:02:24.72,0:02:28.43,Default,,0,0,0,,Жақсы тігілген костюм сияқты, бірақ иісін кетірмейді.
Dialogue: 0,0:02:28.52,0:02:30.56,Default,,0,0,0,,Сен де ол сияқты істеуің керек.
Dialogue: 0,0:02:30.65,0:02:31.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:32.27,0:02:34.48,Default,,0,0,0,,Мүмкін сіз бір саладасыз.
Dialogue: 0,0:02:35.36,0:02:37.57,Default,,0,0,0,,Сізді басқалар қызықтырмайды ма?
Dialogue: 0,0:02:37.65,0:02:40.78,Default,,0,0,0,,Сол қолындағы сақинаны шешіп алуды жөн көрген шығар.
Dialogue: 0,0:02:40.86,0:02:41.87,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,0:02:43.37,0:02:44.28,Default,,0,0,0,,Сіз!
Dialogue: 0,0:02:44.37,0:02:46.79,Default,,0,0,0,,I Джиджи Андалусия
Dialogue: 0,0:02:46.87,0:02:48.58,Default,,0,0,0,,«Сіз» сәл
Dialogue: 0,0:02:48.66,0:02:51.71,Default,,0,0,0,,Ах... кешіріңіз.
Dialogue: 0,0:02:52.29,0:02:55.55,Default,,0,0,0,,Джиги мырзаның мені қалай шығарғанын сұрамаңыз.
Dialogue: 0,0:02:55.63,0:02:56.92,Default,,0,0,0,,Хехехе
Dialogue: 0,0:02:57.01,0:02:59.72,Default,,0,0,0,,А... күлме.
Dialogue: 0,0:03:00.22,0:03:03.30,Default,,0,0,0,,Мен эмоциясы тым көп адаммын.
Dialogue: 0,0:03:03.39,0:03:05.18,Default,,0,0,0,,Мен мұны білемін деп ойлаймын.
Dialogue: 0,0:03:05.26,0:03:07.18,Default,,0,0,0,,А... а...
Dialogue: 0,0:03:08.22,0:03:09.68,Default,,0,0,0,,Мүфти...
Dialogue: 0,0:03:09.77,0:03:11.60,Default,,0,0,0,,Ол қауіпті адам
Dialogue: 0,0:03:11.69,0:03:15.48,Default,,0,0,0,,Жер Федерациясы үкіметінің тәртібін бұзатын адам.
Dialogue: 0,0:03:15.57,0:03:18.28,Default,,0,0,0,,Мүфтиді бәрі жақсы көретін сияқты.
Dialogue: 0,0:03:19.11,0:03:21.03,Default,,0,0,0,,«Чар Азнабль қайта тіріледі»
Dialogue: 0,0:03:21.11,0:03:23.49,Default,,0,0,0,,«Басқалардың қалағанын жасау»
Dialogue: 0,0:03:23.57,0:03:26.74,Default,,0,0,0,,Хмм... Бұл тым шектен шыққан.
Dialogue: 0,0:03:26.83,0:03:28.83,Default,,0,0,0,,Мүфти жариялады
Dialogue: 0,0:03:28.91,0:03:32.00,Default,,0,0,0,,«Федералдық министрлерді өлтіргеннен кейін»
Dialogue: 0,0:03:32.08,0:03:36.71,Default,,0,0,0,,«Жаһандық қоршаған орта үшін барлық адамдар жерді тастап кетуі керек».
Dialogue: 0,0:03:37.50,0:03:39.59,Default,,0,0,0,,«Ерекшеліктерсіз»
Dialogue: 0,0:03:39.67,0:03:40.76,Default,,0,0,0,,Иә
Dialogue: 0,0:03:40.84,0:03:43.26,Default,,0,0,0,,«Бүкіл адамзат ерекшеліксіз»
Dialogue: 0,0:03:43.34,0:03:44.76,Default,,0,0,0,,Бұл балалық.
Dialogue: 0,0:03:44.84,0:03:48.43,Default,,0,0,0,,Балалардың логикасы кейде дұрыс болады.
Dialogue: 0,0:03:48.51,0:03:52.23,Default,,0,0,0,,Әй... Дүние оңай қозғалмайды.
Dialogue: 0,0:03:52.31,0:03:53.35,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:53.44,0:03:56.31,Default,,0,0,0,,Сіз таза және кінәсіз бола алмайсыз.
Dialogue: 0,0:03:56.40,0:03:58.65,Default,,0,0,0,,Бұл туралы не ойлайсыз?
Dialogue: 0,0:03:59.61,0:04:01.74,Default,,0,0,0,,Менің ойымша, бұл қоғамның майлаушысы.
Dialogue: 0,0:04:02.86,0:04:05.49,Default,,0,0,0,,Сіз тек үлгілерді айтасыз.
Dialogue: 0,0:04:06.24,0:04:08.08,Default,,0,0,0,,(Шинсоның дем алған дыбысы)
Dialogue: 0,0:04:09.16,0:04:11.37,Default,,0,0,0,,Енді менің кезегім.
Dialogue: 0,0:04:28.47,0:04:30.56,Default,,0,0,0,,Бақылау спутнигіне ұқсайды.
Dialogue: 0,0:04:30.64,0:04:32.35,Default,,0,0,0,,Мүфтидің ісі болса керек.
Dialogue: 0,0:04:32.43,0:04:35.48,Default,,0,0,0,,Океанияның әуе кеңістігінде тесік ашылды.
Dialogue: 0,0:04:35.56,0:04:37.90,Default,,0,0,0,,Олардың не ойлайтыны маған қызық.
Dialogue: 0,0:04:37.98,0:04:39.07,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:04:39.15,0:04:43.15,Default,,0,0,0,,Әйтпесе, біз Жерде жиналыс өткізе алмас едік.
Dialogue: 0,0:04:48.91,0:04:50.91,Default,,0,0,0,,(ағылшынша хабарландыру)
Dialogue: 0,0:05:28.87,0:05:33.62,Default,,0,0,0,,Бұл менің сол министрлермен бірдей екенімді білдіре ме?
Dialogue: 0,0:05:33.70,0:05:36.75,Default,,0,0,0,,Мүфти өлтірсе де шағым айта алмаймын.
Dialogue: 0,0:05:39.17,0:05:40.84,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:05:41.29,0:05:42.13,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:42.21,0:05:46.97,Default,,0,0,0,,Мен сен сияқты адамдарды жақсы көретінімді түсіндім.
Dialogue: 0,0:05:47.05,0:05:48.38,Default,,0,0,0,,Гүл аруы
Dialogue: 0,0:05:49.51,0:05:51.80,Default,,0,0,0,,Бұл аванстық сөз тіркесі ме?
Dialogue: 0,0:05:51.89,0:05:55.27,Default,,0,0,0,,Қартаю қиын, солай емес пе?
Dialogue: 0,0:05:55.35,0:05:56.43,Default,,0,0,0,,Шынында да.
Dialogue: 0,0:05:57.23,0:06:00.56,Default,,0,0,0,,Мысалы, мен сен сияқты сұлу адаммен сөйлессем де.
Dialogue: 0,0:06:00.65,0:06:03.40,Default,,0,0,0,,Енді пайда болмайды.
Dialogue: 0,0:06:03.48,0:06:05.53,Default,,0,0,0,,Бұл өте қызық
Dialogue: 0,0:06:10.16,0:06:14.29,Default,,0,0,0,,Жасөспірім кезімде жүрегім дүрсілдеп, ауыратын.
Dialogue: 0,0:06:14.37,0:06:15.20,Default,,0,0,0,,Бұдан жақсырақ
Dialogue: 0,0:06:15.29,0:06:17.79,Default,,0,0,0,,Жүрегіңнің дүрсілдегені жақсырақ емес пе?
Dialogue: 0,0:06:17.87,0:06:22.50,Default,,0,0,0,,Себебі, сіздің алғашқы махаббатыңызды білген кездегі идеалдарыңыз сақталады.
Dialogue: 0,0:06:22.59,0:06:26.17,Default,,0,0,0,,Сіз шындықтың басқа екенін білесіз.
Dialogue: 0,0:06:26.84,0:06:29.72,Default,,0,0,0,,Хехехе, маған солай айтты.
Dialogue: 0,0:06:38.73,0:06:39.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:41.02,0:06:42.19,Default,,0,0,0,,Бұл тек Шигараки Томира басқаратын Зұлымдар Альянсы ғана емес.
Dialogue: 0,0:06:42.77,0:06:43.61,Default,,0,0,0,,Ой, жаңбыр жауып тұр—
Dialogue: 0,0:06:45.02,0:06:46.23,Default,,0,0,0,,Ах... Қарғыс атсын...
Dialogue: 0,0:06:46.32,0:06:47.78,Default,,0,0,0,,Кяаааа...
Dialogue: 0,0:06:58.20,0:06:59.37,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:58.20,0:06:59.37,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:59.37,0:06:59.46,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:59.46,0:07:00.67,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:59.46,0:07:00.67,Default,,0,0,0,,Бұл сенің кінәң емес.
Dialogue: 0,0:07:02.63,0:07:04.00,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,0:07:04.09,0:07:05.04,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:07:05.13,0:07:05.96,Default,,0,0,0,,Ах... иә
Dialogue: 0,0:07:06.05,0:07:07.42,Default,,0,0,0,,Қауіпсіздік белдігін бекітіңіз
Dialogue: 0,0:07:07.51,0:07:09.26,Default,,0,0,0,,Полковник Кеннет!
Dialogue: 0,0:07:12.34,0:07:13.80,Default,,0,0,0,,Иә!? (Байланысшы) Не!?
Dialogue: 0,0:07:13.89,0:07:15.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:19.73,0:07:21.19,Default,,0,0,0,,Күте тұрыңыз, полковник.
Dialogue: 0,0:07:21.27,0:07:23.06,Default,,0,0,0,,Министр Эйнштейн
Dialogue: 0,0:07:23.15,0:07:25.69,Default,,0,0,0,,Сіз бізге кепілдік залал жасауды жоспарлап отырсыз ба?
Dialogue: 0,0:07:25.77,0:07:27.23,Default,,0,0,0,,Олар мүфти болса
Dialogue: 0,0:07:27.32,0:07:30.24,Default,,0,0,0,,Мақсат – министрлердің өмірі.
Dialogue: 0,0:07:30.32,0:07:31.53,Default,,0,0,0,,мүфти?
Dialogue: 0,0:07:31.61,0:07:34.20,Default,,0,0,0,,(Джиорно) Э-э… (Турист әйел 1) А…
Dialogue: 0,0:07:37.12,0:07:38.12,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:07:38.20,0:07:39.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:39.50,0:07:41.54,Default,,0,0,0,,Yahoo! Хехехе
Dialogue: 0,0:07:43.96,0:07:45.50,Default,,0,0,0,,Жақсы шешім.
Dialogue: 0,0:07:46.34,0:07:50.42,Default,,0,0,0,,Мылтықты еденге қоя аласыз ба, полковник Кеннет?
Dialogue: 0,0:07:52.47,0:07:54.18,Default,,0,0,0,,Уф... (Д1 ұрлаушы) Хехехе
Dialogue: 0,0:07:54.26,0:07:55.34,Default,,0,0,0,,Жолтайым Құдай
Dialogue: 0,0:07:56.10,0:07:57.60,Default,,0,0,0,,Көз тигізбеу жақсы
Dialogue: 0,0:07:57.68,0:07:58.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:12.61,0:08:13.53,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:15.53,0:08:19.04,Default,,0,0,0,,Федералдық үкімет министрлеріне:
Dialogue: 0,0:08:19.12,0:08:21.29,Default,,0,0,0,,Мен мүфти Эринмін.
Dialogue: 0,0:08:21.37,0:08:22.66,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:08:23.41,0:08:28.04,Default,,0,0,0,,Бірақ бұл операция тазарту емес.
Dialogue: 0,0:08:28.13,0:08:29.13,Default,,0,0,0,,Е...
Dialogue: 0,0:08:29.21,0:08:31.80,Default,,0,0,0,,Өз өміріңнің орнына
Dialogue: 0,0:08:31.88,0:08:36.55,Default,,0,0,0,,Жер Федерациясы үкіметінен әскери қаражат жинау
Dialogue: 0,0:08:36.64,0:08:40.22,Default,,0,0,0,,Аяқтағаннан кейін сіз босатыласыз.
Dialogue: 0,0:08:40.93,0:08:43.81,Default,,0,0,0,,Әрине, өкінішке орай, мен атқа міндім...
Dialogue: 0,0:08:43.89,0:08:46.73,Default,,0,0,0,,Жоғары сыныптағылардың барлығына да солай.
Dialogue: 0,0:08:47.65,0:08:49.11,Default,,0,0,0,,Ууууууууу... тыныштал
Dialogue: 0,0:08:49.19,0:08:51.90,Default,,0,0,0,,Сондықтан мен Жерге барғым келмейтінін айттым!
Dialogue: 0,0:08:51.98,0:08:53.24,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:53.32,0:08:54.15,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:09:00.20,0:09:05.00,Default,,0,0,0,,Айқайламаңыз, жүйкеңізді тітіркендіреді.
Dialogue: 0,0:09:06.21,0:09:06.50,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:09:06.50,0:09:07.54,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:09:06.50,0:09:07.54,Default,,0,0,0,,Талдаушы! Жолаушылар тізімін беріңізші
Dialogue: 0,0:09:07.54,0:09:09.42,Default,,0,0,0,,Талдаушы! Жолаушылар тізімін беріңізші
Dialogue: 0,0:09:10.75,0:09:13.71,Default,,0,0,0,,Келесі Байланыс министрі Саули Столбергпен
Dialogue: 0,0:09:13.80,0:09:15.42,Default,,0,0,0,,Оның әйелі Ира
Dialogue: 0,0:09:15.51,0:09:17.76,Default,,0,0,0,,Мен оны анық көруім үшін оны көтеріңіз!
Dialogue: 0,0:09:18.43,0:09:21.43,Default,,0,0,0,,Дуглас Хиггинс Юпитерді дамыту агенттігінің директоры
Dialogue: 0,0:09:21.51,0:09:23.18,Default,,0,0,0,,Оның әйелі Фианна
Dialogue: 0,0:09:23.27,0:09:24.14,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:24.77,0:09:26.73,Default,,0,0,0,,Иә? О, тәңірім
Dialogue: 0,0:09:27.44,0:09:31.48,Default,,0,0,0,,Ішкі ғарыштық бақылау министрі жас қызды көруге іссапарда жүр ме?
Dialogue: 0,0:09:31.57,0:09:32.65,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:34.32,0:09:36.24,Default,,0,0,0,,Хехехе
Dialogue: 0,0:09:36.32,0:09:38.95,Default,,0,0,0,,Иә? сен не қарап тұрсың? әйел!
Dialogue: 0,0:09:39.03,0:09:40.03,Default,,0,0,0,,Маған көрсет
Dialogue: 0,0:09:42.16,0:09:43.37,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:45.45,0:09:48.21,Default,,0,0,0,,Бұл сүйкімді. (Ұрлаушы А) Иә?
Dialogue: 0,0:09:48.29,0:09:52.34,Default,,0,0,0,,Судандық араб көне ирланд композициясы
Dialogue: 0,0:09:52.42,0:09:54.34,Default,,0,0,0,,Дәлірек айтсақ, қорқынышты араласу.
Dialogue: 0,0:09:54.42,0:09:56.09,Default,,0,0,0,,Бұл атау емес.
Dialogue: 0,0:09:56.72,0:09:59.51,Default,,0,0,0,,Мүфти Нәбию Ерин
Dialogue: 0,0:09:59.59,0:10:01.64,Default,,0,0,0,,(Итадори) Медуза шикигами! Ішке кірсе, соққылар әсер етпейді ме?
Dialogue: 0,0:10:01.72,0:10:02.89,Default,,0,0,0,,Эй!
Dialogue: 0,0:10:02.97,0:10:05.06,Default,,0,0,0,,Джиджи Андалусия…
Dialogue: 0,0:10:05.14,0:10:07.48,Default,,0,0,0,,Сіздің жаныңыздағы орын да сақталған, солай ма?
Dialogue: 0,0:10:07.56,0:10:08.56,Default,,0,0,0,,Неге!
Dialogue: 0,0:10:08.64,0:10:12.02,Default,,0,0,0,,Жаман жәндіктерден аулақ болу
Dialogue: 0,0:10:12.11,0:10:12.94,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:13.02,0:10:14.98,Default,,0,0,0,,Менің меценат бар.
Dialogue: 0,0:10:15.07,0:10:16.61,Default,,0,0,0,,Қожа, құмар
Dialogue: 0,0:10:16.69,0:10:17.53,Default,,0,0,0,,Сіз оны тоқтатыңыз.
Dialogue: 0,0:10:17.61,0:10:19.66,Default,,0,0,0,,Ол әлі жиырмаға толмаған шығар.
Dialogue: 0,0:10:19.74,0:10:21.03,Default,,0,0,0,,Жарайсыңдар (Ұрлаушы А) Шулы!
Dialogue: 0,0:10:21.12,0:10:21.95,Default,,0,0,0,,Эй
Dialogue: 0,0:10:22.03,0:10:26.41,Default,,0,0,0,,Балалар сендер бұл кеме туралы ақпаратты қалай алдыңдар?
Dialogue: 0,0:10:26.50,0:10:28.91,Default,,0,0,0,,Мен саған сөйлеспе деп айтып тұрмын!
Dialogue: 0,0:10:29.00,0:10:31.75,Default,,0,0,0,,Дегенмен, біз үшін
Dialogue: 0,0:10:31.83,0:10:34.46,Default,,0,0,0,,Мен сіздің ұйымыңызды зерттей аламын...
Dialogue: 0,0:10:34.55,0:10:35.80,Default,,0,0,0,,Көп сөйле!
Dialogue: 0,0:10:35.88,0:10:36.84,Default,,0,0,0,,Бұл тек Шигараки Томира басқаратын Зұлымдар Альянсы ғана емес.
Dialogue: 0,0:10:38.84,0:10:40.97,Default,,0,0,0,,Ааааааааааааааааааааааааа...
Dialogue: 0,0:10:41.05,0:10:42.55,Default,,0,0,0,,(Китамура) Жарайды, Сатору, енді уақыты келген сияқты.
Dialogue: 0,0:10:43.55,0:10:44.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:45.01,0:10:46.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:46.81,0:10:49.69,Default,,0,0,0,,Денсаулық сақтау және гигиена министрі қайтыс болды.
Dialogue: 0,0:10:50.19,0:10:54.65,Default,,0,0,0,,Ей, сен достарыңның денесін тазала.
Dialogue: 0,0:10:56.23,0:10:57.19,Default,,0,0,0,,Цк
Dialogue: 0,0:10:57.28,0:11:00.20,Default,,0,0,0,,Мұны кез келген адам жасай алады!
Dialogue: 0,0:11:00.86,0:11:02.32,Default,,0,0,0,,I
Dialogue: 0,0:11:02.41,0:11:05.83,Default,,0,0,0,,Мен ескі соғыстың жан түршігерлік мәйітін көріп тұрмын деп ойладым.
Dialogue: 0,0:11:06.70,0:11:07.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:09.41,0:11:10.62,Default,,0,0,0,,Сіз...
Dialogue: 0,0:11:10.71,0:11:12.92,Default,,0,0,0,,Менің ойымша, бұл дәл сіз елестеткендей.
Dialogue: 0,0:11:18.30,0:11:20.88,Default,,0,0,0,,Жарайды, көмектесіңізші.
Dialogue: 0,0:11:22.30,0:11:24.01,Default,,0,0,0,,Көрпелерді жинаңыз.
Dialogue: 0,0:11:24.10,0:11:25.60,Default,,0,0,0,,Ах... ха... ха
Dialogue: 0,0:11:25.68,0:11:26.97,Default,,0,0,0,,Жүгірме!
Dialogue: 0,0:11:27.06,0:11:28.02,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:11:28.10,0:11:29.77,Default,,0,0,0,,Мүфти Ерін осылай істейді.
Dialogue: 0,0:11:29.77,0:11:30.39,Default,,0,0,0,,Мүфти Ерін осылай істейді.
Dialogue: 0,0:11:29.77,0:11:30.39,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:11:30.39,0:11:30.48,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:11:30.48,0:11:31.14,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:11:30.48,0:11:31.14,Default,,0,0,0,,Соны ұмытпа дедім ғой!
Dialogue: 0,0:11:31.14,0:11:31.23,Default,,0,0,0,,Соны ұмытпа дедім ғой!
Dialogue: 0,0:11:31.23,0:11:32.77,Default,,0,0,0,,Соны ұмытпа дедім ғой!
Dialogue: 0,0:11:31.23,0:11:32.77,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:32.77,0:11:34.11,Default,,0,0,0,,Соны ұмытпа дедім ғой!
Dialogue: 0,0:11:36.48,0:11:38.40,Default,,0,0,0,,Мені аздап тартыңызшы.
Dialogue: 0,0:11:38.48,0:11:39.94,Default,,0,0,0,,Енді? Бұл жақсы
Dialogue: 0,0:11:48.08,0:11:50.41,Default,,0,0,0,,Ааааааааааа...
Dialogue: 0,0:11:50.50,0:11:51.33,Default,,0,0,0,,Ооо...
Dialogue: 0,0:11:51.41,0:11:53.71,Default,,0,0,0,,Ханым, дауысыңызды төмендетіңіз, өлтіресіз.
Dialogue: 0,0:11:53.79,0:11:55.58,Default,,0,0,0,,Мені өлтір!
Dialogue: 0,0:11:56.75,0:11:57.59,Default,,0,0,0,,Ахх...
Dialogue: 0,0:12:09.22,0:12:11.18,Default,,0,0,0,,А... а...
Dialogue: 0,0:12:12.18,0:12:13.02,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:14.77,0:12:15.86,Default,,0,0,0,,Не!
Dialogue: 0,0:12:17.77,0:12:18.44,Default,,0,0,0,,Мұны істеме!
Dialogue: 0,0:12:18.44,0:12:19.82,Default,,0,0,0,,Мұны істеме!
Dialogue: 0,0:12:18.44,0:12:19.82,Default,,0,0,0,,Олай етпе, сен сондай жасандысың.
Dialogue: 0,0:12:19.82,0:12:21.07,Default,,0,0,0,,Бұлай істеме, сен сондай жасандысың.
Dialogue: 0,0:12:21.15,0:12:24.03,Default,,0,0,0,,Олай етпе, сен сондай жасандысың.
Dialogue: 0,0:12:33.33,0:12:34.67,Default,,0,0,0,,Гуах
Dialogue: 0,0:12:35.25,0:12:37.21,Default,,0,0,0,,Уф
Dialogue: 0,0:12:38.25,0:12:39.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:39.88,0:12:42.26,Default,,0,0,0,,Гуаа, аа, а...
Dialogue: 0,0:12:43.34,0:12:44.51,Default,,0,0,0,,Эй!
Dialogue: 0,0:12:45.80,0:12:47.14,Default,,0,0,0,,Уф (Д2 ұрлаушы) Иә!?
Dialogue: 0,0:12:47.68,0:12:48.76,Default,,0,0,0,,Ух tsk
Dialogue: 0,0:12:49.64,0:12:51.43,Default,,0,0,0,,Уау... Уау...
Dialogue: 0,0:12:51.52,0:12:52.52,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:53.35,0:12:55.10,Default,,0,0,0,,Гвааааааааааааааааааааааааааааааа...
Dialogue: 0,0:12:56.65,0:12:58.48,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:13:04.40,0:13:05.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:05.36,0:13:07.16,Default,,0,0,0,,Радиобасқарылатын модель ұшақ! Ха!
Dialogue: 0,0:13:07.24,0:13:07.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:07.57,0:13:08.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:07.57,0:13:08.07,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:08.07,0:13:08.57,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:08.57,0:13:09.41,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:08.57,0:13:09.41,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:13:09.49,0:13:10.58,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:10.66,0:13:11.83,Default,,0,0,0,,Ол нашар оралған.
Dialogue: 0,0:13:11.91,0:13:14.83,Default,,0,0,0,,Егер сәтсіздікке ұшырасаңыз, не істер едіңіз?
Dialogue: 0,0:13:16.00,0:13:18.83,Default,,0,0,0,,Мен білмеймін. Мен оны байқаған кезде жүгірдім.
Dialogue: 0,0:13:18.92,0:13:20.38,Default,,0,0,0,,Е...
Dialogue: 0,0:13:20.46,0:13:22.67,Default,,0,0,0,,Мен мұны әзіл деп білгім келеді.
Dialogue: 0,0:13:33.14,0:13:34.52,Default,,0,0,0,,Біздің басымдықтарымыз
Dialogue: 0,0:13:34.60,0:13:36.56,Default,,0,0,0,,Қарулы топтарды қорғау үшін!
Dialogue: 0,0:13:36.64,0:13:40.11,Default,,0,0,0,,Жолаушылар қауіпсіздігін қамтамасыз етуді екінші бригадаға тапсырыңыз!
Dialogue: 0,0:13:41.15,0:13:43.57,Default,,0,0,0,,О! Ой...
Dialogue: 0,0:13:48.66,0:13:49.70,Default,,0,0,0,,Давао? Неліктен? Гонконгтан алыс болса да
Dialogue: 0,0:13:49.70,0:13:51.28,Default,,0,0,0,,Давао? Неліктен? Гонконгтан алыс болса да
Dialogue: 0,0:13:49.70,0:13:51.28,Default,,0,0,0,,Сақ бол
Dialogue: 0,0:13:51.28,0:13:51.37,Default,,0,0,0,,Давао? Неліктен? Гонконгтан алыс болса да
Dialogue: 0,0:13:51.37,0:13:52.41,Default,,0,0,0,,Давао? Неліктен? Гонконгтан алыс болса да
Dialogue: 0,0:13:51.37,0:13:52.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:52.49,0:13:53.54,Default,,0,0,0,,Мүфти
Dialogue: 0,0:13:53.62,0:13:56.16,Default,,0,0,0,,Олар Австралияға бара жатқан сияқты.
Dialogue: 0,0:13:57.87,0:13:58.21,Default,,0,0,0,,Хич…
Dialogue: 0,0:13:58.21,0:13:59.04,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:13:58.21,0:13:59.04,Default,,0,0,0,,Бірақ егер сізді осындай жерге түсіріп алсаңыз...
Dialogue: 0,0:13:59.04,0:14:00.04,Default,,0,0,0,,Бірақ егер сізді осындай жерге түсіріп алсаңыз...
Dialogue: 0,0:14:00.13,0:14:02.00,Default,,0,0,0,,Сіздің келесі қадамыңыз қандай?
Dialogue: 0,0:14:06.01,0:14:07.05,Default,,0,0,0,,Я...
Dialogue: 0,0:14:11.22,0:14:12.22,Default,,0,0,0,,(Night Eye) Не істесең де, олар бізді сол жақта байқамай қалсын.
Dialogue: 0,0:14:13.26,0:14:14.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:17.39,0:14:18.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:28.82,0:14:30.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:30.95,0:14:31.95,Default,,0,0,0,,Иә
Dialogue: 0,0:14:32.74,0:14:34.16,Default,,0,0,0,,Оны ұмытып қалдың ба?
Dialogue: 0,0:14:35.62,0:14:36.91,Default,,0,0,0,,(ДжоДжо) Х… Ол менің киімімді жыртып, тікелей теріме еніп барады.
Dialogue: 0,0:14:37.00,0:14:39.54,Default,,0,0,0,,Мен бұл ылғалдылыққа шыдай алмаймын.
Dialogue: 0,0:14:40.17,0:14:42.96,Default,,0,0,0,,Джиги есімді бала айтқандай.
Dialogue: 0,0:14:43.04,0:14:44.50,Default,,0,0,0,,Мүфти емес шығар.
Dialogue: 0,0:14:45.55,0:14:47.51,Default,,0,0,0,,Маған бағынатын адамдар келе жатыр.
Dialogue: 0,0:14:47.59,0:14:48.92,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:14:50.18,0:14:52.09,Default,,0,0,0,,Сіз мұны сезбедіңіз.
Dialogue: 0,0:14:52.18,0:14:55.56,Default,,0,0,0,,Мүфтидің мінсіздігі... Сіз оны осылай атасаңыз болады.
Dialogue: 0,0:14:55.64,0:14:58.85,Default,,0,0,0,,Мүфтиді бекітіп жатқан сияқтысыз ба?
Dialogue: 0,0:14:58.93,0:15:00.14,Default,,0,0,0,,Я...
Dialogue: 0,0:15:00.23,0:15:03.52,Default,,0,0,0,,Бұл жігіттер Оенберидің екінші жартысы болуы мүмкін.
Dialogue: 0,0:15:03.61,0:15:04.82,Default,,0,0,0,,Оэнберри деген кім?
Dialogue: 0,0:15:04.90,0:15:06.94,Default,,0,0,0,,Австралияның солтүстігіндегі қала.
Dialogue: 0,0:15:07.03,0:15:10.03,Default,,0,0,0,,Мұнда ондаған мың алаңдататын элементтер жиналды.
Dialogue: 0,0:15:10.78,0:15:13.20,Default,,0,0,0,,Өзін мүфтидің әскері деп атайды.
Dialogue: 0,0:15:13.28,0:15:14.28,Default,,0,0,0,,Полковник Кеннет!
Dialogue: 0,0:15:15.28,0:15:18.33,Default,,0,0,0,,Лейтенант, мына жігіттерді әскери мекемеге апарыңыз.
Dialogue: 0,0:15:18.41,0:15:20.71,Default,,0,0,0,,Балалар, Тергеу бюросына жеткізіңіздер.
Dialogue: 0,0:15:20.79,0:15:21.62,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:25.50,0:15:28.30,Default,,0,0,0,,Оенбелидегі мүфти әскері?
Dialogue: 0,0:15:28.38,0:15:29.63,Default,,0,0,0,,Фойеде күтіңіз.
Dialogue: 0,0:15:30.38,0:15:32.72,Default,,0,0,0,,Жазбалар да алынуы керек.
Dialogue: 0,0:15:32.80,0:15:34.80,Default,,0,0,0,,Сондай-ақ қосылатын рейстерге арналған шаралар болады, солай ма?
Dialogue: 0,0:15:37.81,0:15:38.72,Default,,0,0,0,,Сіз!
Dialogue: 0,0:15:40.64,0:15:42.10,Default,,0,0,0,,Мен сенің атыңды естімедім.
Dialogue: 0,0:15:44.19,0:15:48.07,Default,,0,0,0,,Мен Кеннет Слегмін, Даваоның жаңа командирі.
Dialogue: 0,0:15:49.32,0:15:50.40,Default,,0,0,0,,Мен Нұхпын
Dialogue: 0,0:15:51.45,0:15:52.99,Default,,0,0,0,,Хэтэуэй Ноа
Dialogue: 0,0:15:54.41,0:15:59.41,Default,,0,0,0,,♪~
Dialogue: 0,0:17:18.87,0:17:23.75,Default,,0,0,0,,~♪
Dialogue: 0,0:17:24.75,0:17:26.08,Default,,0,0,0,,Зімбір але
Dialogue: 0,0:17:31.75,0:17:32.25,Default,,0,0,0,,Қараңызшы, бұл сол адам.
Dialogue: 0,0:17:32.25,0:17:33.59,Default,,0,0,0,,Қараңызшы, бұл сол адам.
Dialogue: 0,0:17:32.25,0:17:33.59,Default,,0,0,0,,Директор Йоксан ше?
Dialogue: 0,0:17:34.09,0:17:35.26,Default,,0,0,0,,Иә? О...
Dialogue: 0,0:17:42.10,0:17:43.89,Default,,0,0,0,,Хэтэуэй Ноа!
Dialogue: 0,0:17:43.97,0:17:46.35,Default,,0,0,0,,Қолыңызды қысуға рұқсат етіңіз.
Dialogue: 0,0:17:47.02,0:17:47.64,Default,,0,0,0,,Жас кезіңізде солдат болдыңыз ба?
Dialogue: 0,0:17:47.64,0:17:48.56,Default,,0,0,0,,Сонда жас кезіңізде солдат болдыңыз ба?
Dialogue: 0,0:17:47.64,0:17:48.56,Default,,0,0,0,,А...
Dialogue: 0,0:17:48.56,0:17:50.15,Default,,0,0,0,,Жас кезіңізде солдат болғаныңызды естідім?
Dialogue: 0,0:17:50.23,0:17:52.82,Default,,0,0,0,,Егер біз соғыс тұтқыны болсақ
Dialogue: 0,0:17:52.90,0:17:56.20,Default,,0,0,0,,Федералды үкімет ауыр соққыға ұшырады.
Dialogue: 0,0:17:56.28,0:17:57.20,Default,,0,0,0,,Не? (Макговерн ханым) Хехе.
Dialogue: 0,0:17:57.28,0:17:59.87,Default,,0,0,0,,Енді мен сендерді барлығымен таныстыруға рұқсат етіңіздер.
Dialogue: 0,0:17:59.95,0:18:01.87,Default,,0,0,0,,Эй... (Макговерн ханым) Хехехехе.
Dialogue: 0,0:18:09.25,0:18:10.29,Default,,0,0,0,,Я...
Dialogue: 0,0:18:12.21,0:18:15.51,Default,,0,0,0,,Менің есімде, Хэтэуэй Ноа.
Dialogue: 0,0:18:16.47,0:18:21.18,Default,,0,0,0,,Сіздің әкеңіз ғарыш күштерінің 13 тәуелсіз бөлімшесінің капитаны Ра Қайрам.
Dialogue: 0,0:18:21.26,0:18:23.39,Default,,0,0,0,,Полковник Брайт Нұх
Dialogue: 0,0:18:23.97,0:18:26.35,Default,,0,0,0,,Чар көтерілісі кезінде
Dialogue: 0,0:18:26.43,0:18:30.10,Default,,0,0,0,,Сіз әскери мобильді костюмді басқару арқылы шайқасты, солай ма?
Dialogue: 0,0:18:30.69,0:18:32.69,Default,,0,0,0,,Ұрлап, айдап әкетті деген.
Dialogue: 0,0:18:32.77,0:18:33.94,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:18:34.02,0:18:37.40,Default,,0,0,0,,Соғыста жеңіске жеткенімнің арқасында мен елеусіз қалдым.
Dialogue: 0,0:18:37.49,0:18:40.41,Default,,0,0,0,,Жоқ, жоқ, сізде ерекше талант бар.
Dialogue: 0,0:18:40.49,0:18:44.99,Default,,0,0,0,,Мен Криминалдық полиция агенттігінің Хендли Йок-санмын.
Dialogue: 0,0:18:45.08,0:18:49.54,Default,,0,0,0,,Сіз оларды тергеу бюросының сұхбатына ертіп баруыңыз керек.
Dialogue: 0,0:18:49.62,0:18:52.50,Default,,0,0,0,,Мен полковник Кеннетпен біраз ұрысып қалдым.
Dialogue: 0,0:18:52.58,0:18:56.76,Default,,0,0,0,,Сенің де ертеңге дейін Даваода қалуыңды қалаймын.
Dialogue: 0,0:18:56.84,0:18:58.13,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:18:58.22,0:19:00.59,Default,,0,0,0,,Маенадқа ертең оралу маңызды емес.
Dialogue: 0,0:19:00.68,0:19:03.60,Default,,0,0,0,,Маенадтар Сулавесиден келген бе?
Dialogue: 0,0:19:03.68,0:19:07.43,Default,,0,0,0,,Мен Минахаса түбегінде зауыт инспекторы болуға дайындалып жатырмын.
Dialogue: 0,0:19:07.52,0:19:08.35,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:08.43,0:19:11.15,Default,,0,0,0,,Әлгі профессор... Амада Мансан?
Dialogue: 0,0:19:11.23,0:19:12.06,Default,,0,0,0,,Иә
Dialogue: 0,0:19:12.15,0:19:13.15,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:13.23,0:19:14.69,Default,,0,0,0,,Маған қонақ үй ұйымдастырыңыз.
Dialogue: 0,0:19:14.77,0:19:18.53,Default,,0,0,0,,Егер мен оны әскерге тапсырсам, олар мені осында қалуымды сұрауы мүмкін.
Dialogue: 0,0:19:18.61,0:19:19.61,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:19:19.70,0:19:22.95,Default,,0,0,0,,Бірақ егер бұл сұхбат болса, оны қазір жасай аласыз.
Dialogue: 0,0:19:23.03,0:19:24.53,Default,,0,0,0,,Бүгінгі уақыт
Dialogue: 0,0:19:25.41,0:19:28.37,Default,,0,0,0,,«Тазартусыз қайта туылу жоқ»?
Dialogue: 0,0:19:28.45,0:19:29.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:33.00,0:19:37.05,Default,,0,0,0,,Профессордың ілімінде біздің ұйымның рухымен ортақ нәрсе бар.
Dialogue: 0,0:19:37.13,0:19:38.34,Default,,0,0,0,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:19:38.42,0:19:39.59,Default,,0,0,0,,Хахахахахахаха...
Dialogue: 0,0:19:39.67,0:19:41.55,Default,,0,0,0,,Ха... Хатшы
Dialogue: 0,0:19:42.51,0:19:46.85,Default,,0,0,0,,Криминалдық полиция ұйымы... Бұл Manhunter жетекшісі ме?
Dialogue: 0,0:19:47.47,0:19:49.14,Default,,0,0,0,,Директор иә деді.
Dialogue: 0,0:19:49.22,0:19:49.81,Default,,0,0,0,,Жағдай туралы аздап айтып бере аласыз ба?
Dialogue: 0,0:19:49.81,0:19:50.85,Default,,0,0,0,,Жағдай туралы аздап айтып бере аласыз ба?
Dialogue: 0,0:19:49.81,0:19:50.85,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:19:50.85,0:19:50.93,Default,,0,0,0,,Жағдай туралы аздап айтып бере аласыз ба?
Dialogue: 0,0:19:50.93,0:19:52.06,Default,,0,0,0,,Жағдай туралы аздап айтып бере аласыз ба?
Dialogue: 0,0:19:50.93,0:19:52.06,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:19:52.06,0:19:52.39,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:19:52.56,0:19:52.90,Default,,0,0,0,,Үлкен кісілер жеңіл қабылдаса жақсы.
Dialogue: 0,0:19:52.90,0:19:53.85,Default,,0,0,0,,Үлкен кісілер жеңіл қабылдаса жақсы.
Dialogue: 0,0:19:52.90,0:19:53.85,Default,,0,0,0,,Кеттік
Dialogue: 0,0:19:53.85,0:19:53.94,Default,,0,0,0,,Үлкен кісілер жеңіл жүрсе жақсы.
Dialogue: 0,0:19:53.94,0:19:54.98,Default,,0,0,0,,Үлкен кісілер жеңіл қабылдаса жақсы.
Dialogue: 0,0:19:53.94,0:19:54.98,Default,,0,0,0,,О
Dialogue: 0,0:19:55.06,0:19:56.44,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:20:16.29,0:20:18.92,Default,,0,0,0,,Неге ертерек күлдіңіз?
Dialogue: 0,0:20:21.59,0:20:22.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:23.05,0:20:24.22,Default,,0,0,0,,Сіз күлдіңіз бе?
Dialogue: 0,0:20:24.30,0:20:25.43,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:20:26.43,0:20:27.43,Default,,0,0,0,,Мен?
Dialogue: 0,0:20:27.51,0:20:28.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:32.23,0:20:36.19,Default,,0,0,0,,Олардың мүфтимін деп жүргендер екенін қайдан білдің?
Dialogue: 0,0:20:36.27,0:20:38.61,Default,,0,0,0,,Адамның сыртқы келбеті
Dialogue: 0,0:20:39.19,0:20:40.23,Default,,0,0,0,,А... дұрыс!
Dialogue: 0,0:20:40.32,0:20:41.65,Default,,0,0,0,,Маған бір ой келді.
Dialogue: 0,0:20:41.74,0:20:42.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:42.65,0:20:44.36,Default,,0,0,0,,Бұрын күлген жоқсың ба?
Dialogue: 0,0:20:44.45,0:20:46.03,Default,,0,0,0,,Мүфти Нәбию Ерин
Dialogue: 0,0:20:46.11,0:20:49.49,Default,,0,0,0,,Яғни, өзін пайғамбарлардың заңды патшасы деп атаған.
Dialogue: 0,0:20:49.58,0:20:53.29,Default,,0,0,0,,Мен сенің Хэтэуэй Ноа екеніңді білемін.
Dialogue: 0,0:20:54.12,0:20:55.50,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:20:55.58,0:20:59.29,Default,,0,0,0,,Көріп тұрғаныңыздай, мен қарапайым жаспын.
Dialogue: 0,0:21:02.46,0:21:05.63,Default,,0,0,0,,Шынымды айтсам, маған мұндай нәрсе ұнайды.
Dialogue: 0,0:21:09.39,0:21:12.56,Default,,0,0,0,,Бұл бала өтірік айта алады.
Dialogue: 0,0:21:14.85,0:21:17.06,Default,,0,0,0,,Бұлай айту сізге де ұнамайтын шығар.
Dialogue: 0,0:21:17.15,0:21:18.15,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:21:19.06,0:21:22.23,Default,,0,0,0,,Неліктен олай ойладың?
Dialogue: 0,0:21:22.32,0:21:23.69,Default,,0,0,0,,Мен Хаунсенге міне алдым.
Dialogue: 0,0:21:23.78,0:21:25.74,Default,,0,0,0,,Бұл үшін тым жас
Dialogue: 0,0:21:25.82,0:21:28.03,Default,,0,0,0,,Неліктен бұлай күресе алдың?
Dialogue: 0,0:21:28.12,0:21:28.95,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:21:29.03,0:21:30.45,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:30.53,0:21:32.66,Default,,0,0,0,,Өзіңе келгенде, адамдар
Dialogue: 0,0:21:32.74,0:21:34.58,Default,,0,0,0,,Ақымақ болып кететінің рас.
Dialogue: 0,0:21:34.66,0:21:35.62,Default,,0,0,0,,Бізге жақсылап сөйлесу керек!
Dialogue: 0,0:21:35.71,0:21:37.00,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:21:37.08,0:21:39.96,Default,,0,0,0,,Мүфти атын пайдаланған адамдарды кездестірдім.
Dialogue: 0,0:21:40.04,0:21:41.46,Default,,0,0,0,,Мен мұны ашудан жасадым.
Dialogue: 0,0:21:43.88,0:21:45.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:45.38,0:21:46.76,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:46.84,0:21:48.80,Default,,0,0,0,,Қазір мен...
Dialogue: 0,0:21:48.89,0:21:50.26,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:21:50.35,0:21:53.27,Default,,0,0,0,,Мен бұл туралы басқа адамдарға айтпаймын.
Dialogue: 0,0:21:54.02,0:21:55.73,Default,,0,0,0,,Мен жек көргенді жек көремін.
Dialogue: 0,0:21:56.35,0:21:57.73,Default,,0,0,0,,Бұл адамның өзі болса жақсы.
Dialogue: 0,0:21:57.81,0:22:00.52,Default,,0,0,0,,Бұл өте қызықты және қызықты
Dialogue: 0,0:22:01.52,0:22:03.61,Default,,0,0,0,,«Көңілді»?
Dialogue: 0,0:22:03.69,0:22:06.86,Default,,0,0,0,,Бірақ сөз адамды өлтіруі мүмкін.
Dialogue: 0,0:22:06.86,0:22:07.32,Default,,0,0,0,,Бірақ сөз адамды өлтіруі мүмкін.
Dialogue: 0,0:22:06.86,0:22:07.32,Default,,0,0,0,,Ха…
Dialogue: 0,0:22:07.32,0:22:07.40,Default,,0,0,0,,Ха…
Dialogue: 0,0:22:07.40,0:22:08.03,Default,,0,0,0,,Ха…
Dialogue: 0,0:22:07.40,0:22:08.03,Default,,0,0,0,,Сіз мұны есте сақтайсыз деп үміттенемін
Dialogue: 0,0:22:08.03,0:22:09.11,Default,,0,0,0,,Сіз мұны есте сақтайсыз деп үміттенемін
Dialogue: 0,0:22:09.20,0:22:10.87,Default,,0,0,0,,Бұл метафора емес
Dialogue: 0,0:22:10.95,0:22:11.99,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:12.08,0:22:14.29,Default,,0,0,0,,Мен мұны мүлдем жек көремін.
Dialogue: 0,0:22:14.37,0:22:15.62,Default,,0,0,0,,Мен...
Dialogue: 0,0:22:20.79,0:22:22.88,Default,,0,0,0,,Джиджи Андалусия…
Dialogue: 0,0:22:22.96,0:22:25.55,Default,,0,0,0,,Мен ондай емеспін.
Dialogue: 0,0:22:25.63,0:22:26.80,Default,,0,0,0,,(Фушигиро) Неге мұнда жүрсің, Зэн'ин-сенпай?
Dialogue: 0,0:22:26.88,0:22:27.88,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:22:27.97,0:22:32.85,Default,,0,0,0,,Бірақ фактілер баяу және мұқият қозғалады.
Dialogue: 0,0:22:32.93,0:22:33.93,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:22:35.02,0:22:36.93,Default,,0,0,0,,Мен мұны жақында түсіндім.
Dialogue: 0,0:22:37.73,0:22:38.98,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:39.06,0:22:40.23,Default,,0,0,0,,Бұл қиын ба?
Dialogue: 0,0:22:40.31,0:22:41.52,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:22:49.03,0:22:50.70,Default,,0,0,0,,Осы әңгімені ұмытайық.
Dialogue: 0,0:22:50.78,0:22:52.57,Default,,0,0,0,,Мен ұмытпаймын
Dialogue: 0,0:22:54.28,0:22:56.16,Default,,0,0,0,,Сізде де солай емес пе?
Dialogue: 0,0:22:58.58,0:22:59.50,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:23:01.08,0:23:03.67,Default,,0,0,0,,Гиги Андалусия мырза осы жерді басыңыз
Dialogue: 0,0:23:03.75,0:23:04.63,Default,,0,0,0,,Иә
Dialogue: 0,0:23:12.26,0:23:13.60,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:23:15.10,0:23:16.77,Default,,0,0,0,,Мен мұндай нәрсе болғанына сене алар емеспін.
Dialogue: 0,0:23:16.85,0:23:18.02,Default,,0,0,0,,Сен өзіңсің
Dialogue: 0,0:23:16.85,0:23:18.02,Default,,0,0,0,,Иә
Dialogue: 0,0:23:18.10,0:23:20.35,Default,,0,0,0,,Сіз осы орындыққа отырдыңыз, солай ма?
Dialogue: 0,0:23:20.44,0:23:21.52,Default,,0,0,0,,Иә
Dialogue: 0,0:23:21.60,0:23:23.65,Default,,0,0,0,,Көрші үйдегі полковник Кеннет Слеггтің орнында.
Dialogue: 0,0:23:23.73,0:23:26.27,Default,,0,0,0,,Зақымданған стюардесса отыру
Dialogue: 0,0:23:26.36,0:23:29.99,Default,,0,0,0,,Полковник сіздің артыңыздағы бос орындыққа отырды.
Dialogue: 0,0:23:36.49,0:23:37.74,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:23:38.37,0:23:40.83,Default,,0,0,0,,Жоқ, рахмет, Нұх.
Dialogue: 0,0:23:41.54,0:23:43.63,Default,,0,0,0,,Бұл бүгінгі күн үшін жақсы.
Dialogue: 0,0:23:46.96,0:23:47.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:53.14,0:23:55.26,Default,,0,0,0,,Бұл сіздің қонақүй картаңыз
Dialogue: 0,0:23:55.35,0:23:57.56,Default,,0,0,0,,Қолдануыңызды өтінеміз.
Dialogue: 0,0:23:57.64,0:23:59.52,Default,,0,0,0,,Мен саған ертең сағат 9-да хабарласамын.
Dialogue: 0,0:24:00.27,0:24:02.48,Default,,0,0,0,,Содан кейін кестеңізді шешіңіз.
Dialogue: 0,0:24:02.56,0:24:03.90,Default,,0,0,0,,Егер сізге ұнаса
Dialogue: 0,0:24:03.98,0:24:06.40,Default,,0,0,0,,Қонақ үйде тұруға болады.
Dialogue: 0,0:24:06.48,0:24:07.48,Default,,0,0,0,,Шексіз?
Dialogue: 0,0:24:07.57,0:24:08.98,Default,,0,0,0,,Ол мені осы күйімде көрмесін деп, батыл болып көрінуге барынша тырысып жүрмін
Dialogue: 0,0:24:09.07,0:24:13.24,Default,,0,0,0,,Сіз Давао аймағында болсаңыз, карта төлемдеріңіз үкіметте болады.
Dialogue: 0,0:24:13.32,0:24:15.74,Default,,0,0,0,,О... бұл керемет
Dialogue: 0,0:24:15.82,0:24:17.33,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:24:17.41,0:24:18.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:18.33,0:24:21.45,Default,,0,0,0,,Мен мұндай қызды жеңе алмаймын деп ойлаймын.
Dialogue: 0,0:24:21.54,0:24:23.04,Default,,0,0,0,,Иә!?
Dialogue: 0,0:24:26.33,0:24:28.50,Default,,0,0,0,,Барлығы осы ма? багаж
Dialogue: 0,0:24:28.59,0:24:30.05,Default,,0,0,0,,Ал...
Dialogue: 0,0:24:30.13,0:24:32.26,Default,,0,0,0,,Екеуміз бір қонақүйде тұрған сияқтымыз, кеттік.
Dialogue: 0,0:24:32.34,0:24:33.63,Default,,0,0,0,,Иә
Dialogue: 0,0:24:47.65,0:24:49.90,Default,,0,0,0,,Сізді не алаңдатады?
Dialogue: 0,0:24:49.98,0:24:50.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:24:51.94,0:24:54.86,Default,,0,0,0,,Мен қауіп төнгенді одан сайын жек көремін.
Dialogue: 0,0:24:54.95,0:24:56.41,Default,,0,0,0,,Сөйлеме
Dialogue: 0,0:24:56.49,0:24:58.20,Default,,0,0,0,,…
Dialogue: 0,0:24:59.74,0:25:01.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:25:22.93,0:25:26.81,Default,,0,0,0,,43
Dialogue: 0,0:25:26.90,0:25:28.94,Default,,0,0,0,,...
Dialogue: 0,0:25:29.02,0:25:30.98,Default,,0,0,0,,Бұл жерде де би алаңы бар.
Dialogue: 0,0:25:31.07,0:25:32.53,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:25:32.61,0:25:34.24,Default,,0,0,0,,...
Dialogue: 0,0:25:34.32,0:25:36.15,Default,,0,0,0,,...
Dialogue: 0,0:25:36.24,0:25:37.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:25:40.41,0:25:41.95,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:25:42.04,0:25:43.37,Default,,0,0,0,,...
Dialogue: 0,0:25:43.45,0:25:46.87,Default,,0,0,0,,Бізде екі төсектік люкс бөлмелері бар.
Dialogue: 0,0:25:47.92,0:25:49.54,Default,,0,0,0,,...
Dialogue: 0,0:26:03.47,0:26:04.85,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:26:05.77,0:26:06.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:06.69,0:26:09.06,Default,,0,0,0,,Хэтэуэйдің чемоданын да осы бөлмеде сақтауға болады.
Dialogue: 0,0:26:09.15,0:26:10.52,Default,,0,0,0,,Иә... иә?
Dialogue: 0,0:26:11.48,0:26:12.90,Default,,0,0,0,,Джиги! Бұл жаман
Dialogue: 0,0:26:12.98,0:26:13.98,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:26:14.07,0:26:15.94,Default,,0,0,0,,...
Dialogue: 0,0:26:16.03,0:26:17.11,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:26:17.20,0:26:19.70,Default,,0,0,0,,Мен осындай кең жерде қалай жалғыз қаламын?
Dialogue: 0,0:26:19.78,0:26:22.33,Default,,0,0,0,,Хэтэуэй, мына төсекті пайдалан.
Dialogue: 0,0:26:24.66,0:26:25.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:26:29.04,0:26:30.83,Default,,0,0,0,,Олай болса, өтінемін.
Dialogue: 0,0:26:39.55,0:26:42.97,Default,,0,0,0,,Сенің жақсарып келе жатқаныңа қуаныштымын.
Dialogue: 0,0:26:43.05,0:26:44.97,Default,,0,0,0,,Жарайды
Dialogue: 0,0:26:45.06,0:26:48.39,Default,,0,0,0,,Мен сауығып кету үшін жерге түстім.
Dialogue: 0,0:26:48.48,0:26:49.81,Default,,0,0,0,,Сіз Гонконгта тұрасыз ба?
Dialogue: 0,0:26:49.89,0:26:50.90,Default,,0,0,0,,Жоқ
Dialogue: 0,0:26:50.98,0:26:54.02,Default,,0,0,0,,Менің ойымша, Жапонияның тауларында тұру жақсы болар еді.
Dialogue: 0,0:26:54.11,0:26:57.74,Default,,0,0,0,,Жапония? Сіз сонда кіргіңіз келе ме?
Dialogue: 0,0:26:57.82,0:26:59.36,Default,,0,0,0,,Мен оны саламын.
Dialogue: 0,0:26:59.45,0:27:01.91,Default,,0,0,0,,Бұл жерде менің ата-бабам дүниеге келген.
Dialogue: 0,0:27:01.99,0:27:02.82,Default,,0,0,0,,Хмм...
Dialogue: 0,0:27:02.91,0:27:05.91,Default,,0,0,0,,Сол себепті сен осылай көрінесің.
Dialogue: 0,0:27:05.99,0:27:07.50,Default,,0,0,0,,Жарайды
Dialogue: 0,0:27:08.00,0:27:11.08,Default,,0,0,0,,Мүфтидің әдісі Бұл дұрыс емес.
Dialogue: 0,0:27:16.13,0:27:18.26,Default,,0,0,0,,Басқа жол болса
Dialogue: 0,0:27:18.34,0:27:20.63,Default,,0,0,0,,Маған айтуыңызды мүфти сұрайды.
Dialogue: 0,0:27:20.72,0:27:21.63,Default,,0,0,0,,Иә
Dialogue: 0,0:27:21.72,0:27:22.55,Default,,0,0,0,,Не?
Dialogue: 0,0:27:22.64,0:27:26.43,Default,,0,0,0,,Ешқашан қателеспейтін диктаторлық режим орнату.
Dialogue: 0,0:27:26.51,0:27:28.64,Default,,0,0,0,,Хаха хахахаха
Dialogue: 0,0:27:28.73,0:27:29.60,Default,,0,0,0,,Қызық па?
Dialogue: 0,0:27:29.68,0:27:30.77,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:27:31.44,0:27:34.77,Default,,0,0,0,,Бірақ мұны істей алатын адамдар болса
Dialogue: 0,0:27:34.86,0:27:36.73,Default,,0,0,0,,Бұл Құдай
Dialogue: 0,0:27:36.82,0:27:40.20,Default,,0,0,0,,Сонда сіз құдай бола аласыз.
Dialogue: 0,0:27:40.82,0:27:45.49,Default,,0,0,0,,Мұндай адамдар пайда болған кезде барлық адамдар құдайға айналады.
Dialogue: 0,0:27:45.58,0:27:48.08,Default,,0,0,0,,Бұл оның жаңа түрі екенін білдіре ме?
Dialogue: 0,0:27:48.16,0:27:49.50,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:27:50.21,0:27:52.08,Default,,0,0,0,,Мектепте оқытылды.
Dialogue: 0,0:27:52.17,0:27:54.67,Default,,0,0,0,,Иә, табандылыққа дейін.
Dialogue: 0,0:27:54.75,0:27:55.84,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:27:58.42,0:28:00.55,Default,,0,0,0,,Мен душты пайдалана аламын ба?
Dialogue: 0,0:28:00.63,0:28:01.51,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:28:01.59,0:28:03.34,Default,,0,0,0,,Мен екінші жағындамын
Dialogue: 0,0:28:03.43,0:28:04.89,Default,,0,0,0,,Мен оңай болғанын қалаймын.
Dialogue: 0,0:28:06.18,0:28:09.18,Default,,0,0,0,,Сен осындасың деп уайымдағым келмейді.
Dialogue: 0,0:28:10.43,0:28:11.56,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:28:22.70,0:28:24.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:28:27.12,0:28:29.87,Default,,0,0,0,,Жау байқаған белгі жоқ.
Dialogue: 0,0:28:31.62,0:28:33.25,Default,,0,0,0,,Джиги есімді қыз...
Dialogue: 0,0:28:35.25,0:28:38.09,Default,,0,0,0,,Бұл жағдайды қалай ойлауымыз керек?
Dialogue: 0,0:28:49.01,0:28:50.01,Default,,0,0,0,,«Оңтүстік Тынық мұхиты»
Dialogue: 0,0:28:51.81,0:28:52.77,Default,,0,0,0,,«Оенберг»
Dialogue: 0,0:28:55.69,0:28:56.40,Default,,0,0,0,,«Оенберг»
Dialogue: 0,0:28:56.40,0:28:56.90,Default,,0,0,0,,...
Dialogue: 0,0:28:56.40,0:28:56.90,Default,,0,0,0,,Неліктен мұндай жерде?
Dialogue: 0,0:28:56.90,0:28:58.61,Default,,0,0,0,,Неліктен мұндай жерде?
Dialogue: 0,0:28:59.36,0:29:01.28,Default,,0,0,0,,(Джиги ызылдаған)
Dialogue: 0,0:29:02.61,0:29:03.78,Default,,0,0,0,,Джиджи
Dialogue: 0,0:29:03.86,0:29:06.28,Default,,0,0,0,,Мен сыртқа қарағым келеді...
Dialogue: 0,0:29:06.87,0:29:07.95,Default,,0,0,0,,Қақпақ
Dialogue: 0,0:29:08.03,0:29:08.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:09.03,0:29:10.95,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:29:11.04,0:29:12.45,Default,,0,0,0,,Мен мұны жиі айта аламын.
Dialogue: 0,0:29:13.12,0:29:13.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:15.33,0:29:16.58,Default,,0,0,0,,Біз жұп емеспіз.
Dialogue: 0,0:29:16.67,0:29:18.79,Default,,0,0,0,,Мен бірге тұруды құптамадым.
Dialogue: 0,0:29:18.88,0:29:23.30,Default,,0,0,0,,Соған қарамастан мен еш жерде жалаңаш әйелдерді ұнатпаймын.
Dialogue: 0,0:29:27.09,0:29:28.43,Default,,0,0,0,,Бұл карта жұлдызы ма?
Dialogue: 0,0:29:29.18,0:29:31.64,Default,,0,0,0,,Хмм... сен мені алдап жатырсың ба?
Dialogue: 0,0:29:33.77,0:29:35.27,Default,,0,0,0,,Сіз серуендеуге барасыз ба?
Dialogue: 0,0:29:36.35,0:29:37.44,Default,,0,0,0,,Джиги!
Dialogue: 0,0:29:37.52,0:29:39.23,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:29:39.31,0:29:41.32,Default,,0,0,0,,Ол сондай әйел ме?
Dialogue: 0,0:29:41.40,0:29:42.23,Default,,0,0,0,,(Келу дыбысы)
Dialogue: 0,0:29:46.78,0:29:48.24,Default,,0,0,0,,Бұл ойланбастан болды ма?
Dialogue: 0,0:29:49.07,0:29:50.74,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:29:50.83,0:29:53.75,Default,,0,0,0,,Бұл Ques Paraya сияқты ма?
Dialogue: 0,0:29:59.38,0:30:00.54,Default,,0,0,0,,Қалдық қоймасы туралы не деуге болады?
Dialogue: 0,0:30:00.63,0:30:03.38,Default,,0,0,0,,Иә, мен бұрын және кейін мұқият зерттедім.
Dialogue: 0,0:30:04.17,0:30:05.51,Default,,0,0,0,,Уақыт бекітілген
Dialogue: 0,0:30:05.59,0:30:06.26,Default,,0,0,0,,«Күн сайын таңғы 8-ден кеш батқанға дейін ашық Давао экологиялық ботаникалық баққа қош келдіңіз»
Dialogue: 0,0:30:06.26,0:30:08.01,Default,,0,0,0,,«Күн сайын таңғы 8-ден кеш батқанға дейін ашық Давао экологиялық ботаникалық баққа қош келдіңіздер»
Dialogue: 0,0:30:06.26,0:30:08.01,Default,,0,0,0,,Мұны өзгерту мүмкін емес
Dialogue: 0,0:30:08.09,0:30:08.68,Default,,0,0,0,,«Әуе ортасындағы өсімдіктер: Жер экологиясы және қоршаған орта»
Dialogue: 0,0:30:08.68,0:30:09.68,Default,,0,0,0,,«Әуе ортасындағы өсімдіктер: Жер экологиясы және қоршаған орта»
Dialogue: 0,0:30:08.68,0:30:09.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:09.68,0:30:10.18,Default,,0,0,0,,«Әуе ортасындағы өсімдіктер: Жер экологиясы және қоршаған орта»
Dialogue: 0,0:30:10.26,0:30:11.43,Default,,0,0,0,,«Амада Мансан»
Dialogue: 0,0:30:10.26,0:30:11.43,Default,,0,0,0,,А... Мен оны Ирамға беруім керек сияқты.
Dialogue: 0,0:30:11.43,0:30:13.14,Default,,0,0,0,,А... Мен оны Ирамға беруім керек сияқты.
Dialogue: 0,0:30:14.06,0:30:15.27,Default,,0,0,0,,Оенберг туралы не деуге болады?
Dialogue: 0,0:30:15.35,0:30:17.48,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:30:17.56,0:30:20.44,Default,,0,0,0,,Мүфтидің базасы Австралия континентінде деген қауесет бар.
Dialogue: 0,0:30:20.52,0:30:22.77,Default,,0,0,0,,Сенетін адамдар жиналды.
Dialogue: 0,0:30:23.36,0:30:24.36,Default,,0,0,0,,Құтқару құралы
Dialogue: 0,0:30:24.44,0:30:25.78,Default,,0,0,0,,Сіз осылай істеп жатырсыз ба?
Dialogue: 0,0:30:25.86,0:30:26.95,Default,,0,0,0,,Жоқ
Dialogue: 0,0:30:27.03,0:30:30.28,Default,,0,0,0,,Генерал риза, бірақ байланысымыз жоқ.
Dialogue: 0,0:30:30.37,0:30:31.49,Default,,0,0,0,,Қанша?
Dialogue: 0,0:30:31.57,0:30:33.79,Default,,0,0,0,,Бұл шамамен 30 000 деп айтылады.
Dialogue: 0,0:30:33.87,0:30:37.37,Default,,0,0,0,,Бұл таңқаларлық. Бұл біздің қозғалыстың нәтижесі деп айтуға болады.
Dialogue: 0,0:30:37.46,0:30:38.29,Default,,0,0,0,,Фу…
Dialogue: 0,0:30:38.37,0:30:41.04,Default,,0,0,0,,Сонымен? Кимберли пайда болды ма?
Dialogue: 0,0:30:41.13,0:30:42.42,Default,,0,0,0,,Кеше
Dialogue: 0,0:30:43.34,0:30:45.80,Default,,0,0,0,,Негізгі күш кетті.
Dialogue: 0,0:30:45.88,0:30:48.26,Default,,0,0,0,,Бұл жылжытуды жеңілдетеді.
Dialogue: 0,0:30:48.34,0:30:49.18,Default,,0,0,0,,О
Dialogue: 0,0:30:49.26,0:30:52.26,Default,,0,0,0,,Бірақ бұл жолы келген командирдің өзі қиын.
Dialogue: 0,0:30:52.35,0:30:53.47,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:30:53.56,0:30:57.31,Default,,0,0,0,,Жаңа жылжымалы костюм де жаңа командирдің күші болады.
Dialogue: 0,0:30:57.39,0:30:58.39,Default,,0,0,0,,Жаңа үлгі?
Dialogue: 0,0:30:58.48,0:31:00.23,Default,,0,0,0,,Олар оны сынап жатқан сияқты.
Dialogue: 0,0:31:00.31,0:31:01.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:31:10.78,0:31:13.28,Default,,0,0,0,,Бақылау функциясы жоқ сияқты
Dialogue: 0,0:31:13.37,0:31:15.20,Default,,0,0,0,,Мен сенімді емеспін.
Dialogue: 0,0:31:15.29,0:31:18.41,Default,,0,0,0,,Төлем тарихы да көрсетілмеген сияқты.
Dialogue: 0,0:31:18.50,0:31:22.75,Default,,0,0,0,,Мемлекеттік қызметкерлердің қалтасын ауыртпайтын әмияндары бар дейді.
Dialogue: 0,0:31:22.83,0:31:24.29,Default,,0,0,0,,Менің ойымша, бұл солай.
Dialogue: 0,0:31:24.38,0:31:28.26,Default,,0,0,0,,Бұл билік дәліздері арқылы құрылған жүйе.
Dialogue: 0,0:31:28.34,0:31:29.97,Default,,0,0,0,,Михеша – зерделі адам.
Dialogue: 0,0:31:30.05,0:31:31.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:31.13,0:31:34.01,Default,,0,0,0,,Мен өмір бойы сән-салтанатпен өмір сүре аламын...
Dialogue: 0,0:31:34.10,0:31:35.35,Default,,0,0,0,,Хмм!
Dialogue: 0,0:31:35.93,0:31:38.31,Default,,0,0,0,,Оның алдында оғаш сөздер айтпа!
Dialogue: 0,0:31:38.39,0:31:39.93,Default,,0,0,0,,әзіл әзіл
Dialogue: 0,0:31:40.98,0:31:42.10,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:31:45.94,0:31:47.65,Default,,0,0,0,,Сонымен Хэтэуэй ше?
Dialogue: 0,0:31:47.73,0:31:49.44,Default,,0,0,0,,Ертең таңертең
Dialogue: 0,0:31:49.53,0:31:52.95,Default,,0,0,0,,Сіз бізді Үкіметтің тергеу бюросы мен әскерилердің бақылауында деп болжауға болады.
Dialogue: 0,0:31:53.20,0:31:54.20,Default,,0,0,0,,Диверсия туралы не деуге болады?
Dialogue: 0,0:31:54.28,0:31:58.45,Default,,0,0,0,,Мүмкін болса, мен Хэтэуэй Ноаның мұқабасын қалдырғым келеді.
Dialogue: 0,0:31:58.54,0:32:00.41,Default,,0,0,0,,Әйел серігі...
Dialogue: 0,0:32:01.25,0:32:03.42,Default,,0,0,0,,Мен үшін муляж боласың ба?
Dialogue: 0,0:32:03.50,0:32:06.88,Default,,0,0,0,,Мен Федерацияның тыңшысы боламын ба, жоқ па білмеймін.
Dialogue: 0,0:32:06.96,0:32:08.55,Default,,0,0,0,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,0:32:08.63,0:32:11.42,Default,,0,0,0,,Менің айтарым, оның жауы болатын қауіпті қыз.
Dialogue: 0,0:32:12.13,0:32:16.35,Default,,0,0,0,,Иә... Соқыр шабуыл жасасаңыз жақсы болар еді деп ойлаймын.
Dialogue: 0,0:32:16.43,0:32:17.43,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:32:17.51,0:32:21.10,Default,,0,0,0,,Менің бөлмем 32-қабатта. Биік болса екен деймін.
Dialogue: 0,0:32:21.18,0:32:22.27,Default,,0,0,0,,Нашар! Бұл аңшы
Dialogue: 0,0:32:29.53,0:32:32.40,Default,,0,0,0,,Сіздің тұруға рұқсатыңызды көрмейінше қозғалмаңыз.
Dialogue: 0,0:32:32.49,0:32:33.61,Default,,0,0,0,,Михеша, сен бір кездері жер аударылды.
Dialogue: 0,0:32:33.61,0:32:34.45,Default,,0,0,0,,Михеша, сен бір рет жер аударылды.
Dialogue: 0,0:32:33.61,0:32:34.45,Default,,0,0,0,,Дәл сол жерде.
Dialogue: 0,0:32:34.45,0:32:34.53,Default,,0,0,0,,Михеша, сен бір рет жер аударылдың.
Dialogue: 0,0:32:34.53,0:32:35.91,Default,,0,0,0,,Михеша, сен бір рет жер аударылдың.
Dialogue: 0,0:32:34.53,0:32:35.91,Default,,0,0,0,,Жалқау болмаңыз
Dialogue: 0,0:32:35.99,0:32:37.41,Default,,0,0,0,,Иә, осы жерді басыңыз
Dialogue: 0,0:32:35.99,0:32:37.41,Default,,0,0,0,,Сен де сапқа тұр.
Dialogue: 0,0:32:37.49,0:32:38.41,Default,,0,0,0,,Орындаңыз!
Dialogue: 0,0:32:37.49,0:32:38.41,Default,,0,0,0,,Сізді басқа біреу алып кетеді...
Dialogue: 0,0:32:38.41,0:32:39.29,Default,,0,0,0,,Сізді басқа біреу алып кетеді...
Dialogue: 0,0:32:39.37,0:32:40.33,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:32:40.41,0:32:41.79,Default,,0,0,0,,Мен қатарға тұр дедім.
Dialogue: 0,0:32:42.50,0:32:43.41,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:32:45.17,0:32:47.04,Default,,0,0,0,,Эй, күте тұрыңыз! бұл бейбақ
Dialogue: 0,0:32:48.17,0:32:49.55,Default,,0,0,0,,Сәлем! Оны қу! Оны қу!
Dialogue: 0,0:32:49.63,0:32:51.26,Default,,0,0,0,,Эй, мына жерде.
Dialogue: 0,0:32:51.34,0:32:54.88,Default,,0,0,0,,Сізге тергеу жүргізілді ме? тұруға рұқсат
Dialogue: 0,0:32:54.97,0:32:57.80,Default,,0,0,0,,Әрине. Мұнда көп пе?
Dialogue: 0,0:32:57.89,0:33:01.77,Default,,0,0,0,,Федералдық армия күшейтілгеннен бері мұнда жағдай нашарлай түсті.
Dialogue: 0,0:33:01.85,0:33:05.98,Default,,0,0,0,,Мүфти неге аңшыны ұрмайды?
Dialogue: 0,0:33:07.23,0:33:08.36,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:33:12.28,0:33:13.11,Default,,0,0,0,,Ха…
Dialogue: 0,0:33:20.24,0:33:21.54,Default,,0,0,0,,Әскер болып көріну
Dialogue: 0,0:33:29.09,0:33:31.30,Default,,0,0,0,,Бұл қорқынышты емес пе? мұнда аңшы
Dialogue: 0,0:33:31.38,0:33:33.59,Default,,0,0,0,,Бұл барлық уақытта болады.
Dialogue: 0,0:33:33.67,0:33:36.68,Default,,0,0,0,,Мүфти неге аңшыны ұрмайды?
Dialogue: 0,0:33:36.76,0:33:38.64,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:33:38.72,0:33:41.93,Default,,0,0,0,,Олар тазалау керек, солай ма?
Dialogue: 0,0:33:42.02,0:33:43.56,Default,,0,0,0,,Ғылым тым көп.
Dialogue: 0,0:33:44.48,0:33:46.94,Default,,0,0,0,,Соңында бәріміз ғарышқа ұшамыз, солай ма?
Dialogue: 0,0:33:47.02,0:33:50.02,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,0:33:50.11,0:33:52.90,Default,,0,0,0,,Давао ластанған емес пе?
Dialogue: 0,0:33:52.98,0:33:57.66,Default,,0,0,0,,Бірақ жасыл желек аз, ал сіз тіпті балық аулай алмайсыз, солай ма?
Dialogue: 0,0:33:57.74,0:34:00.87,Default,,0,0,0,,Мен аралдағы барлық адамдар сияқты жей аламын.
Dialogue: 0,0:34:00.95,0:34:03.91,Default,,0,0,0,,Мүфти болашақта 1000 жыл айтып жатқан сияқты?
Dialogue: 0,0:34:04.00,0:34:05.50,Default,,0,0,0,,Хехехехехехе
Dialogue: 0,0:34:05.58,0:34:07.71,Default,,0,0,0,,Бұл адам жалықтырады.
Dialogue: 0,0:34:08.54,0:34:12.21,Default,,0,0,0,,Өмірде мұндай нәрселер туралы ойлауға уақыт жоқ.
Dialogue: 0,0:34:13.59,0:34:14.42,Default,,0,0,0,,Бос уақыт?
Dialogue: 0,0:34:14.51,0:34:15.72,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:34:15.80,0:34:18.55,Default,,0,0,0,,Жерде тұруға рұқсат алу.
Dialogue: 0,0:34:18.63,0:34:21.72,Default,,0,0,0,,Ұлы адамдарға жұмсайтын ақшаңызды ойласаңыз
Dialogue: 0,0:34:21.80,0:34:24.81,Default,,0,0,0,,Ертеңгі күнді ойлай да алмаймын.
Dialogue: 0,0:34:26.02,0:34:28.39,Default,,0,0,0,,Ертең ше?
Dialogue: 0,0:34:37.45,0:34:38.36,Default,,0,0,0,,Джиги!
Dialogue: 0,0:34:41.62,0:34:42.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:43.74,0:34:47.37,Default,,0,0,0,,Бұл Тергеу бюросының ең үлкен нұсқасы, Хэтэуэй Ноа мырза.
Dialogue: 0,0:34:47.91,0:34:52.63,Default,,0,0,0,,Көлігіңізді ертең таңғы сағат 10-да дайындаймыз. Ынтымақтастық үшін рахмет.
Dialogue: 0,0:34:57.34,0:35:00.97,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:35:03.68,0:35:07.18,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:35:07.27,0:35:08.52,Default,,0,0,0,,Бұл алғаш рет.
Dialogue: 0,0:35:08.60,0:35:11.90,Default,,0,0,0,,Не болды, Хидео-сан, осындай жерде тамақтанғың келе ме?
Dialogue: 0,0:35:11.98,0:35:13.11,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:35:14.15,0:35:15.44,Default,,0,0,0,,Айтшы маған!
Dialogue: 0,0:35:16.07,0:35:20.66,Default,,0,0,0,,Сіз мені жалғыз қалдырып, серуендеуге кеттіңіз, сондықтан кешкі асқа біреу келді.
Dialogue: 0,0:35:20.74,0:35:22.66,Default,,0,0,0,,Мен кетейін деп жатырмын
Dialogue: 0,0:35:22.74,0:35:26.54,Default,,0,0,0,,Полковник, сіз бос емес болсаңыз да мейірімдісіз.
Dialogue: 0,0:35:28.50,0:35:31.17,Default,,0,0,0,,Бір бөлмеде болу деген нені білдіреді?
Dialogue: 0,0:35:31.25,0:35:32.71,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:35:34.04,0:35:35.04,Default,,0,0,0,,Мен сізге айтпаймын.
Dialogue: 0,0:35:35.13,0:35:35.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:36.05,0:35:38.30,Default,,0,0,0,,Бүгін кешке сен менімен біргесің бе?
Dialogue: 0,0:35:40.17,0:35:42.64,Default,,0,0,0,,Оған дейін мен саған беремін.
Dialogue: 0,0:35:42.72,0:35:45.05,Default,,0,0,0,,Алға, маңызды емес.
Dialogue: 0,0:35:45.14,0:35:46.60,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:35:46.68,0:35:48.60,Default,,0,0,0,,Бұл менің ниетім емес.
Dialogue: 0,0:35:48.68,0:35:51.06,Default,,0,0,0,,Бұл тыңдау туралы көбірек.
Dialogue: 0,0:35:51.69,0:35:54.77,Default,,0,0,0,,Мен министрлердің базаға келуін шештім.
Dialogue: 0,0:35:55.36,0:35:57.69,Default,,0,0,0,,Тергеу бюросымен жұмысты аяқтаған кезде
Dialogue: 0,0:35:57.78,0:36:01.74,Default,,0,0,0,,Мен жасаған жазбаға қол қою керек.
Dialogue: 0,0:36:02.95,0:36:04.91,Default,,0,0,0,,Мен саған қарадым.
Dialogue: 0,0:36:06.24,0:36:10.75,Default,,0,0,0,,Чар көтерілісі кезінде ол бала болса да бір ұшақты атып түсірді.
Dialogue: 0,0:36:12.08,0:36:13.50,Default,,0,0,0,,Бұл әскери ережелерді бұзу.
Dialogue: 0,0:36:15.00,0:36:16.79,Default,,0,0,0,,Әкемге қиындық туғызды
Dialogue: 0,0:36:20.05,0:36:21.42,Default,,0,0,0,,Тренинг болмаса да...
Dialogue: 0,0:36:21.51,0:36:24.51,Default,,0,0,0,,Орындалды деу үлкен мәселе.
Dialogue: 0,0:36:24.59,0:36:28.85,Default,,0,0,0,,Әскери немқұрайлы орын болғандықтан, бұл мүмкін болды деп ойлаймын.
Dialogue: 0,0:36:28.93,0:36:31.31,Default,,0,0,0,,Хехе, дұрыс.
Dialogue: 0,0:36:31.39,0:36:34.90,Default,,0,0,0,,Мен бұрынғы Кимберлиден көңілім қалды.
Dialogue: 0,0:36:35.44,0:36:38.82,Default,,0,0,0,,Сіз Oenberry бір жерге жіберілді дейсіз бе?
Dialogue: 0,0:36:38.90,0:36:41.32,Default,,0,0,0,,Сіз мені болжап отырсыз
Dialogue: 0,0:36:41.40,0:36:44.82,Default,,0,0,0,,Бастапқыда менің кездесуім үш күннен кейін болды.
Dialogue: 0,0:36:45.49,0:36:49.58,Default,,0,0,0,,Осы уақытқа дейін жеңіске жетіп, ғарышқа оралуды жоспарлайды.
Dialogue: 0,0:36:49.66,0:36:51.20,Default,,0,0,0,,Хмм.
Dialogue: 0,0:36:52.33,0:36:53.46,Default,,0,0,0,,Көп нәрсе бар.
Dialogue: 0,0:36:53.54,0:36:57.84,Default,,0,0,0,,Қарапайым халық ретінде осылай шықтым. Мен жақсы әке болғанын қалаймын.
Dialogue: 0,0:36:58.46,0:37:01.67,Default,,0,0,0,,Әке қысымның көзі бола алады.
Dialogue: 0,0:37:01.76,0:37:03.01,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:37:06.18,0:37:08.10,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:37:08.18,0:37:10.68,Default,,0,0,0,,Полковник, мынаны ала аласыз ба?
Dialogue: 0,0:37:13.23,0:37:14.39,Default,,0,0,0,,Фу…
Dialogue: 0,0:37:14.48,0:37:15.94,Default,,0,0,0,,Иә
Dialogue: 0,0:37:16.81,0:37:18.23,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:37:36.12,0:37:38.29,Default,,0,0,0,,Ғылым тым көп.
Dialogue: 0,0:37:38.38,0:37:42.26,Default,,0,0,0,,Олар тамаша ойнап, үлкендерді жеңсе жақсы болар еді.
Dialogue: 0,0:37:42.34,0:37:45.22,Default,,0,0,0,,Мүфтидің әдісі Бұл дұрыс емес.
Dialogue: 0,0:37:46.72,0:37:50.55,Default,,0,0,0,,Мен білемін, мұны істеу жолы ...
Dialogue: 0,0:37:54.81,0:37:56.60,Default,,0,0,0,,Онда маған айтыңыз.
Dialogue: 0,0:37:57.14,0:38:00.48,Default,,0,0,0,,Бұл механизмнің тереңдігін қалай жоюға болады
Dialogue: 0,0:38:02.23,0:38:06.57,Default,,0,0,0,,Жер бетінде барлық адамдар өмір сүре алмайды.
Dialogue: 0,0:38:11.70,0:38:12.58,Default,,0,0,0,,болмаса
Dialogue: 0,0:38:13.20,0:38:15.66,Default,,0,0,0,,Чар тудырған көтеріліс
Dialogue: 0,0:38:15.75,0:38:18.42,Default,,0,0,0,,Сол кезде қайтыс болғандарды да жұбату мүмкін емес.
Dialogue: 0,0:38:20.00,0:38:24.42,Default,,0,0,0,,Ерекшеліктер болғанша, адамдар алдайды.
Dialogue: 0,0:38:52.03,0:38:56.70,Default,,0,0,0,,Менің галамның алдында ешқандай кедергі жоқ
Dialogue: 0,0:38:56.79,0:39:00.08,Default,,0,0,0,,Көру аймағына 100 секундта жету
Dialogue: 0,0:39:00.17,0:39:03.13,Default,,0,0,0,,Мен кедергі бірден пайда болады деп ойлаймын.
Dialogue: 0,0:39:03.21,0:39:05.88,Default,,0,0,0,,Түсіндім Түсіндім.
Dialogue: 0,0:39:05.96,0:39:08.34,Default,,0,0,0,,Бұл Кимберлидегі ақымақтар туралы.
Dialogue: 0,0:39:08.42,0:39:11.64,Default,,0,0,0,,Оның шығуына 15 минут қажет емес пе?
Dialogue: 0,0:39:11.72,0:39:14.35,Default,,0,0,0,,Жаңа командир тағайындалды.
Dialogue: 0,0:39:14.43,0:39:17.06,Default,,0,0,0,,Сондай-ақ жаңа үлгі бар.
Dialogue: 0,0:39:17.14,0:39:18.77,Default,,0,0,0,,Гауманды төмендетпеңіз
Dialogue: 0,0:39:18.85,0:39:21.48,Default,,0,0,0,,Сіз мұны кеше және бүгін таңертең жасай аласыз ба?
Dialogue: 0,0:39:21.56,0:39:23.40,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:39:23.90,0:39:26.90,Default,,0,0,0,,Даваода жеті министр ұйықтап жатыр дейді.
Dialogue: 0,0:39:26.98,0:39:28.28,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:39:28.36,0:39:30.82,Default,,0,0,0,,Тыңдаңыз, кетуге ең көбі 10 минутыңыз бар.
Dialogue: 0,0:39:30.91,0:39:33.41,Default,,0,0,0,,Әй, Цивет мырза.
Dialogue: 0,0:39:40.79,0:39:41.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:39:43.29,0:39:45.42,Default,,0,0,0,,Гольф ойыны болады
Dialogue: 0,0:39:49.76,0:39:50.93,Default,,0,0,0,,Шық, Фенсер!
Dialogue: 0,0:39:56.26,0:39:59.31,Default,,0,0,0,,Тыңдаңыз! Гауман аралығы 180 секунд
Dialogue: 0,0:39:59.39,0:40:00.68,Default,,0,0,0,,Хасауе…
Dialogue: 0,0:39:59.39,0:40:00.68,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,0:40:00.77,0:40:02.77,Default,,0,0,0,,Мм... Уф.
Dialogue: 0,0:40:11.11,0:40:12.86,Default,,0,0,0,,Кимберли тез әрекет ете ме?
Dialogue: 0,0:40:14.82,0:40:17.62,Default,,0,0,0,,Жақсы істе Гольф семсері
Dialogue: 0,0:40:20.04,0:40:24.46,Default,,0,0,0,,Қатысқандардың рухына көңіл айтамыз.
Dialogue: 0,0:40:24.54,0:40:25.63,Default,,0,0,0,,Маған үзіліс беріңізші.
Dialogue: 0,0:40:31.72,0:40:33.09,Default,,0,0,0,,Ха!
Dialogue: 0,0:40:39.43,0:40:40.43,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:40:47.23,0:40:48.73,Default,,0,0,0,,
Dialogue: 0,0:40:48.82,0:40:50.73,Default,,0,0,0,,Джиджи! Әуе шабуылы бар! Оян!
Dialogue: 0,0:40:50.82,0:40:51.65,Default,,0,0,0,,Не?
Dialogue: 0,0:40:51.74,0:40:53.95,Default,,0,0,0,,Аяқ киіміңізді киіңіз, сонда сіз де осында боласыз.
Dialogue: 0,0:40:54.03,0:40:55.11,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:40:55.20,0:40:57.66,Default,,0,0,0,,Федералдық үкіметтегі кейбір маңызды адамдар сонда қалады.
Dialogue: 0,0:40:58.24,0:40:59.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:01.87,0:41:03.46,Default,,0,0,0,,Мүфти!?
Dialogue: 0,0:41:03.54,0:41:04.54,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:41:04.62,0:41:06.54,Default,,0,0,0,,Қала аймағындағы әуе шабуылы...
Dialogue: 0,0:41:06.63,0:41:09.25,Default,,0,0,0,,Мүфти Ерін сіз болуыңыз керек!
Dialogue: 0,0:41:09.80,0:41:11.34,Default,,0,0,0,,Мүфти – ұйым.
Dialogue: 0,0:41:11.42,0:41:12.76,Default,,0,0,0,,Жалғыз болу мүмкін емес.
Dialogue: 0,0:41:12.84,0:41:13.76,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:41:25.23,0:41:27.15,Default,,0,0,0,,Бір жарым минут қалды ма?
Dialogue: 0,0:41:28.90,0:41:30.69,Default,,0,0,0,,Мен шыдай алмаймын
Dialogue: 0,0:41:34.24,0:41:35.82,Default,,0,0,0,,Уф! А... аа
Dialogue: 0,0:41:35.91,0:41:37.62,Default,,0,0,0,,Алдымен тұтынушылар!
Dialogue: 0,0:41:37.70,0:41:38.78,Default,,0,0,0,,Хэтэуэй…
Dialogue: 0,0:41:39.37,0:41:40.41,Default,,0,0,0,,Ал сендер ше?
Dialogue: 0,0:41:40.49,0:41:41.99,Default,,0,0,0,,Мен мұнда тұтынушымын.
Dialogue: 0,0:41:42.08,0:41:42.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:43.00,0:41:44.04,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:41:44.12,0:41:45.29,Default,,0,0,0,,(Келу дыбысы)
Dialogue: 0,0:41:48.71,0:41:49.42,Default,,0,0,0,,(алыстағы жарылыс дыбысы)
Dialogue: 0,0:41:49.42,0:41:50.29,Default,,0,0,0,,(алыстағы жарылыс дыбысы)
Dialogue: 0,0:41:49.42,0:41:50.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:50.29,0:41:52.30,Default,,0,0,0,,(алыстағы жарылыс дыбысы)
Dialogue: 0,0:41:54.63,0:41:55.59,Default,,0,0,0,,Жарайды
Dialogue: 0,0:41:55.67,0:41:57.09,Default,,0,0,0,,Жүрейік!
Dialogue: 0,0:42:03.72,0:42:06.60,Default,,0,0,0,,Бұл тоқтайды ма?
Dialogue: 0,0:42:06.69,0:42:07.69,Default,,0,0,0,,А...
Dialogue: 0,0:42:07.77,0:42:09.02,Default,,0,0,0,,Егер ол бомбаланса, ол тоқтайды.
Dialogue: 0,0:42:09.02,0:42:09.61,Default,,0,0,0,,Егер ол бомбаланса, ол тоқтайды.
Dialogue: 0,0:42:09.02,0:42:09.61,Default,,0,0,0,,А...
Dialogue: 0,0:42:09.61,0:42:10.19,Default,,0,0,0,,А...
Dialogue: 0,0:42:11.77,0:42:12.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:14.03,0:42:15.61,Default,,0,0,0,,Қызық, олар бұл туралы біле ме?
Dialogue: 0,0:42:20.45,0:42:22.66,Default,,0,0,0,,Менен не үшін сұрадың?
Dialogue: 0,0:42:27.04,0:42:29.00,Default,,0,0,0,,Мен сіздің интуицияңызға сенемін
Dialogue: 0,0:42:29.08,0:42:32.63,Default,,0,0,0,,Олай болса, бұрынғы былғары оқиға туралы.
Dialogue: 0,0:42:32.71,0:42:34.38,Default,,0,0,0,,Мені сергек сезіндіру
Dialogue: 0,0:42:44.10,0:42:45.89,Default,,0,0,0,,Ол қайта құрылуда.
Dialogue: 0,0:42:45.98,0:42:48.14,Default,,0,0,0,,Иә? Семсерлесу?
Dialogue: 0,0:42:48.89,0:42:51.52,Default,,0,0,0,,Иә! Хэтэуэй!
Dialogue: 0,0:42:53.69,0:42:55.11,Default,,0,0,0,,Қаш!
Dialogue: 0,0:42:55.73,0:42:56.57,Default,,0,0,0,,Бала
Dialogue: 0,0:43:01.99,0:43:05.41,Default,,0,0,0,,Сіз қорқынышты нәрселер жасайсыз.
Dialogue: 0,0:43:05.49,0:43:09.16,Default,,0,0,0,,Дыбыс Сіз естіген жоқсыз ба? бомбалау дыбысы
Dialogue: 0,0:43:09.25,0:43:11.13,Default,,0,0,0,,Тыңдалған болуы мүмкін
Dialogue: 0,0:43:11.54,0:43:12.38,Default,,0,0,0,,(бомба дыбысы)
Dialogue: 0,0:43:12.38,0:43:13.42,Default,,0,0,0,,(бомба дыбысы)
Dialogue: 0,0:43:12.38,0:43:13.42,Default,,0,0,0,,Уау
Dialogue: 0,0:43:13.84,0:43:14.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:43:14.75,0:43:16.71,Default,,0,0,0,,Мен жеңілдім!
Dialogue: 0,0:43:17.55,0:43:18.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:20.30,0:43:22.14,Default,,0,0,0,,Енді жоқ... (Әйел) Мұғалім!
Dialogue: 0,0:43:23.18,0:43:24.14,Default,,0,0,0,,Джиджи
Dialogue: 0,0:43:26.93,0:43:29.06,Default,,0,0,0,,Жарайды, сен әлі тірісің.
Dialogue: 0,0:43:32.06,0:43:33.27,Default,,0,0,0,,Бұрынғы бұл діріл қандай болды!? (Қонақ А) Бұл мүфтидің әуе шабуылы еді.
Dialogue: 0,0:43:33.27,0:43:34.15,Default,,0,0,0,,Бұрынғы бұл діріл қандай болды!? (Қонақ А) Бұл мүфтидің әуе шабуылы еді.
Dialogue: 0,0:43:33.27,0:43:34.15,Default,,0,0,0,,Бұл мақсат болды ма?
Dialogue: 0,0:43:34.23,0:43:35.73,Default,,0,0,0,,Реджент қонақ үйі де өртеніп жатыр.
Dialogue: 0,0:43:36.23,0:43:38.53,Default,,0,0,0,,Меніңше, министрлер сонда қалды! мұнда да
Dialogue: 0,0:43:36.23,0:43:38.53,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:43:38.61,0:43:39.99,Default,,0,0,0,,(Ер адам) Қатты кісі келе жатыр! (Әйел) Көмектесіңіз! Мені өлтірмекші!
Dialogue: 0,0:43:41.16,0:43:42.32,Default,,0,0,0,,Хэтэуэй
Dialogue: 0,0:43:42.41,0:43:43.57,Default,,0,0,0,,Осы жолмен! Уф, аа...
Dialogue: 0,0:43:43.66,0:43:46.04,Default,,0,0,0,,Тұрақты ұстаз!
Dialogue: 0,0:43:52.17,0:43:56.13,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:44:08.02,0:44:08.93,Default,,0,0,0,,Сіз оны артта қалдырасыз ба?
Dialogue: 0,0:44:09.02,0:44:10.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:10.60,0:44:12.19,Default,,0,0,0,,Мен бұған сене алмаймын.
Dialogue: 0,0:44:12.27,0:44:13.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:44:16.40,0:44:17.78,Default,,0,0,0,,Ха!
Dialogue: 0,0:44:21.07,0:44:21.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:21.99,0:44:23.95,Default,,0,0,0,,Кеттік! иә?
Dialogue: 0,0:44:26.03,0:44:29.16,Default,,0,0,0,,Tsk! Онда неге қашып жүрсің?
Dialogue: 0,0:44:29.24,0:44:30.75,Default,,0,0,0,,Эй, уайымдама.
Dialogue: 0,0:44:31.37,0:44:32.37,Default,,0,0,0,,…Таку!
Dialogue: 0,0:44:37.29,0:44:38.30,Default,,0,0,0,,Ха... не!?
Dialogue: 0,0:44:39.59,0:44:41.30,Default,,0,0,0,,Бұл жылжымалы костюм.
Dialogue: 0,0:44:41.38,0:44:44.05,Default,,0,0,0,,Егер бұл жаңа үлгі болса.
Dialogue: 0,0:44:44.13,0:44:46.26,Default,,0,0,0,,Анахайм мұны жасады.
Dialogue: 0,0:44:54.02,0:44:56.40,Default,,0,0,0,,Командир осылай өзгерте ме?
Dialogue: 0,0:45:05.24,0:45:06.66,Default,,0,0,0,,Не болды?
Dialogue: 0,0:45:06.74,0:45:07.24,Default,,0,0,0,,Тек ату...
Dialogue: 0,0:45:07.24,0:45:08.16,Default,,0,0,0,,Тек ату...
Dialogue: 0,0:45:07.24,0:45:08.16,Default,,0,0,0,,(Ескерту)
Dialogue: 0,0:45:11.79,0:45:13.00,Default,,0,0,0,,Ол «Рух толқынын» қолдануда — қалағанынша жоғалып, қайта пайда бола алады.
Dialogue: 0,0:45:19.17,0:45:22.01,Default,,0,0,0,,Балалар! Есіңіз дұрыс па?
Dialogue: 0,0:45:22.09,0:45:23.09,Default,,0,0,0,,Уф... Уф!?
Dialogue: 0,0:45:24.93,0:45:26.59,Default,,0,0,0,,Уау...
Dialogue: 0,0:45:30.18,0:45:31.39,Default,,0,0,0,,Ха!
Dialogue: 0,0:45:34.10,0:45:35.31,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:45:43.11,0:45:44.11,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:45:44.19,0:45:45.53,Default,,0,0,0,,Уау...
Dialogue: 0,0:45:45.61,0:45:47.53,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:45:47.61,0:45:50.53,Default,,0,0,0,,
Dialogue: 0,0:45:47.61,0:45:50.53,Default,,0,0,0,,(Автомобильді ескерту дабылы)
Dialogue: 0,0:45:50.62,0:45:52.70,Default,,0,0,0,,А... Асығыңыз!
Dialogue: 0,0:45:52.79,0:45:54.04,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:45:55.46,0:45:58.13,Default,,0,0,0,,Күтіңіз, күтіңіз
Dialogue: 0,0:45:58.21,0:45:59.54,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:45:59.63,0:46:03.38,Default,,0,0,0,,Сіздің әлсіздігіңіз шыққан сияқты.
Dialogue: 0,0:46:03.46,0:46:04.51,Default,,0,0,0,,Осы шу-шудың бәрімен—
Dialogue: 0,0:46:32.33,0:46:34.87,Default,,0,0,0,,Цк... сен табандысың.
Dialogue: 0,0:46:32.33,0:46:34.87,Default,,0,0,0,,(Биіктік туралы ескерту)
Dialogue: 0,0:46:50.26,0:46:53.26,Default,,0,0,0,,(Қасірет дыбыстары)
Dialogue: 0,0:46:55.10,0:46:57.60,Default,,0,0,0,,Боқ... Осындай кезде мен...
Dialogue: 0,0:46:59.10,0:47:01.27,Default,,0,0,0,,А... эй... жоғары! Тұру!
Dialogue: 0,0:47:01.36,0:47:02.40,Default,,0,0,0,,Құлап жатыр!
Dialogue: 0,0:47:13.66,0:47:16.08,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:47:17.33,0:47:18.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:18.79,0:47:20.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:21.50,0:47:22.50,Default,,0,0,0,,Ха…
Dialogue: 0,0:47:24.04,0:47:25.80,Default,,0,0,0,,Саябақ бар, сонда бар!
Dialogue: 0,0:47:29.93,0:47:31.34,Default,,0,0,0,,Мұнда кел
Dialogue: 0,0:47:38.10,0:47:38.93,Default,,0,0,0,,Джиги Жақсысың ба?
Dialogue: 0,0:47:39.02,0:47:40.44,Default,,0,0,0,,Құлайды!
Dialogue: 0,0:47:41.40,0:47:43.06,Default,,0,0,0,,Сіз жауды паналап жатырсыз.
Dialogue: 0,0:47:43.73,0:47:45.07,Default,,0,0,0,,Көп нәрсе!
Dialogue: 0,0:47:56.03,0:47:57.08,Default,,0,0,0,,Гауман?
Dialogue: 0,0:47:58.41,0:47:59.58,Default,,0,0,0,,Ах... жоғары!
Dialogue: 0,0:48:01.92,0:48:02.83,Default,,0,0,0,,Ха…
Dialogue: 0,0:48:05.92,0:48:07.38,Default,,0,0,0,,Уф!
Dialogue: 0,0:48:07.46,0:48:08.71,Default,,0,0,0,,Джиги осылай!
Dialogue: 0,0:48:08.80,0:48:09.92,Default,,0,0,0,,Ааааааааааа!
Dialogue: 0,0:48:09.92,0:48:10.76,Default,,0,0,0,,Ааааааааааа!
Dialogue: 0,0:48:09.92,0:48:10.76,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:48:10.84,0:48:13.47,Default,,0,0,0,,(Джиджидің айқайы)
Dialogue: 0,0:48:25.44,0:48:26.27,Default,,0,0,0,,Уф!
Dialogue: 0,0:48:26.36,0:48:29.11,Default,,0,0,0,,Гауман... Қарғыс атсын.
Dialogue: 0,0:48:32.45,0:48:34.87,Default,,0,0,0,,«Сиркемен өзін-өзі өлтіру оқиғасы»
Dialogue: 0,0:48:37.62,0:48:39.54,Default,,0,0,0,,Ха... у...
Dialogue: 0,0:48:41.37,0:48:42.54,Default,,0,0,0,,Бұл әйелдің кінәсі!
Dialogue: 0,0:48:43.46,0:48:46.63,Default,,0,0,0,,Мен қайтадан бәрін бүлдіремін бе?
Dialogue: 0,0:48:48.30,0:48:49.21,Default,,0,0,0,,Изумруд…
Dialogue: 0,0:48:50.13,0:48:53.09,Default,,0,0,0,,Мынаны лақтырып, ана жаққа жүгір!
Dialogue: 0,0:48:53.93,0:48:55.22,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:48:55.30,0:48:56.35,Default,,0,0,0,,Бұл қорқынышты...
Dialogue: 0,0:48:57.39,0:49:01.14,Default,,0,0,0,,Бұл қорқынышты... бұл қорқынышты
Dialogue: 0,0:49:04.10,0:49:06.36,Default,,0,0,0,,Иә, бұл өте нашар.
Dialogue: 0,0:49:20.04,0:49:22.37,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:49:24.37,0:49:25.46,Default,,0,0,0,,Ах! Қарғыс атсын
Dialogue: 0,0:49:28.50,0:49:30.00,Default,,0,0,0,,Уф, аа...
Dialogue: 0,0:49:43.89,0:49:45.35,Default,,0,0,0,,Ах, ах… Ах!
Dialogue: 0,0:49:45.85,0:49:47.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:47.85,0:49:50.23,Default,,0,0,0,,Жақсы! Ах!
Dialogue: 0,0:49:50.32,0:49:51.78,Default,,0,0,0,,Жүгіру!
Dialogue: 0,0:49:51.86,0:49:52.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:49:55.57,0:49:57.03,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:49:58.99,0:49:59.95,Default,,0,0,0,,Гаума…
Dialogue: 0,0:50:05.79,0:50:07.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:14.90,0:51:16.32,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:51:21.11,0:51:23.20,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл тезірек болар еді
Dialogue: 0,0:51:23.91,0:51:27.16,Default,,0,0,0,,Көліктегі жігіттер кептеліп қалды.
Dialogue: 0,0:51:28.37,0:51:29.66,Default,,0,0,0,,Бұл жерде ме?
Dialogue: 0,0:51:29.75,0:51:31.42,Default,,0,0,0,,Ха... Полковник!
Dialogue: 0,0:51:31.50,0:51:32.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:32.75,0:51:33.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:51:33.71,0:51:35.25,Default,,0,0,0,,Себебі мен мұны істей алмаймын...
Dialogue: 0,0:51:39.09,0:51:40.47,Default,,0,0,0,,Хаха...
Dialogue: 0,0:51:42.80,0:51:44.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:44.10,0:51:46.10,Default,,0,0,0,,Джиги! Хэтэуэй де
Dialogue: 0,0:51:51.48,0:51:53.10,Default,,0,0,0,,Полковник! Бұл қорқынышты болды
Dialogue: 0,0:51:53.10,0:51:55.48,Default,,0,0,0,,Полковник! Бұл қорқынышты болды
Dialogue: 0,0:51:53.10,0:51:55.48,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:51:55.48,0:51:55.98,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:51:56.07,0:51:57.86,Default,,0,0,0,,кабинаға кіріңіз
Dialogue: 0,0:51:57.94,0:51:58.78,Default,,0,0,0,,Жылы.
Dialogue: 0,0:51:58.86,0:51:59.69,Default,,0,0,0,,Иә
Dialogue: 0,0:52:01.11,0:52:02.70,Default,,0,0,0,,Мына баланы маған беріңізші.
Dialogue: 0,0:52:03.53,0:52:04.66,Default,,0,0,0,,Сендер не істеп жатырсыңдар?!
Dialogue: 0,0:52:07.24,0:52:08.16,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:52:08.95,0:52:11.33,Default,,0,0,0,,Мүфти сияқты мобильді костюмдер
Dialogue: 0,0:52:11.41,0:52:14.33,Default,,0,0,0,,Аа, мен де шынайы нәрсені бірінші рет көріп тұрмын.
Dialogue: 0,0:52:18.80,0:52:20.17,Default,,0,0,0,,Бұл Пенелопа.
Dialogue: 0,0:52:20.26,0:52:23.05,Default,,0,0,0,,Бұл мен басшылыққа алмас бұрын жіберген Гундам.
Dialogue: 0,0:52:23.84,0:52:25.01,Default,,0,0,0,,Гундам?
Dialogue: 0,0:52:26.05,0:52:27.64,Default,,0,0,0,,Бұл эйс машинасы.
Dialogue: 0,0:52:27.72,0:52:31.23,Default,,0,0,0,,Жоқ, жоқ, мен әлі ең жақсы спектакльді шығарған жоқпын.
Dialogue: 0,0:52:32.19,0:52:35.73,Default,,0,0,0,,Мен Lane Aim-ді асыра бағаладым деп ойлаймын.
Dialogue: 0,0:52:36.48,0:52:38.73,Default,,0,0,0,,Жолақ мақсаты?
Dialogue: 0,0:52:41.19,0:52:42.28,Default,,0,0,0,,Гундам...
Dialogue: 0,0:52:44.24,0:52:45.74,Default,,0,0,0,,Тұтқындарды ренжітпеңіз!
Dialogue: 0,0:52:46.74,0:52:48.45,Default,,0,0,0,,Бұл менің мүфтияттағы бірінші тұтқыным!
Dialogue: 0,0:52:51.04,0:52:54.83,Default,,0,0,0,,Мен сені жайлап жауап аламын, сондықтан оны асыға күт!
Dialogue: 0,0:52:54.92,0:52:56.67,Default,,0,0,0,,Жарайды, мені ал!
Dialogue: 0,0:53:02.97,0:53:04.72,Default,,0,0,0,,Олар қатал топ.
Dialogue: 0,0:53:05.30,0:53:08.47,Default,,0,0,0,,Мүфтидің мәлімдемесі видеосы жақын арада интернетте таралады.
Dialogue: 0,0:53:09.89,0:53:11.81,Default,,0,0,0,,Жолды мақсат етіңіз! Бұл осылай
Dialogue: 0,0:53:14.19,0:53:16.98,Default,,0,0,0,,Сіз біреуін өлтіру үшін 3 ұшақты жоғалттыңыз!
Dialogue: 0,0:53:17.06,0:53:18.94,Default,,0,0,0,,Егер басқа адам нақты адам болса, бұл!
Dialogue: 0,0:53:19.02,0:53:20.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:53:20.28,0:53:21.74,Default,,0,0,0,,Бұл жолы да қайталанса
Dialogue: 0,0:53:22.24,0:53:24.61,Default,,0,0,0,,Мен Пенелопаны Хэтэуэй Ноаға қалдырамын!
Dialogue: 0,0:53:24.70,0:53:25.78,Default,,0,0,0,,Эй!
Dialogue: 0,0:53:27.07,0:53:28.07,Default,,0,0,0,,Жүр!
Dialogue: 0,0:53:28.16,0:53:29.91,Default,,0,0,0,,Үй жануарлары Пенелопа!
Dialogue: 0,0:53:30.74,0:53:31.58,Default,,0,0,0,,Ха!
Dialogue: 0,0:53:35.08,0:53:36.58,Default,,0,0,0,,Сынақ ұшқышы ретінде
Dialogue: 0,0:53:36.67,0:53:40.21,Default,,0,0,0,,Мен ерекше дарынды адамды пайдалана алмаймын.
Dialogue: 0,0:53:40.88,0:53:42.92,Default,,0,0,0,,Бірақ сен әдемісің.
Dialogue: 0,0:53:44.13,0:53:46.43,Default,,0,0,0,,Бұл ескі мен.
Dialogue: 0,0:53:46.51,0:53:48.01,Default,,0,0,0,,Әй?
Dialogue: 0,0:53:46.51,0:53:48.01,Default,,0,0,0,,Мүфтидің жылжымалы костюмі
Dialogue: 0,0:53:48.09,0:53:50.06,Default,,0,0,0,,Келесі Кессалияның келуін күту
Dialogue: 0,0:53:48.09,0:53:50.06,Default,,0,0,0,,Жоқ, мен әскери жылжымалы костюм ұрлағанда.
Dialogue: 0,0:53:50.06,0:53:50.14,Default,,0,0,0,,Жоқ, мен әскери жылжымалы костюм ұрлағанда.
Dialogue: 0,0:53:50.14,0:53:51.51,Default,,0,0,0,,Жоқ, мен әскери мобильді костюм ұрлағанда.
Dialogue: 0,0:53:50.14,0:53:51.51,Default,,0,0,0,,N18 палатадағы докқа тасымалдау
Dialogue: 0,0:53:51.51,0:53:51.60,Default,,0,0,0,,N18 ауданындағы докқа дейін тасымалдау
Dialogue: 0,0:53:51.60,0:53:52.52,Default,,0,0,0,,N18 ауданындағы докқа дейін тасымалдау
Dialogue: 0,0:53:51.60,0:53:52.52,Default,,0,0,0,,Тіпті өзіме тым сенімді болдым.
Dialogue: 0,0:53:52.52,0:53:52.60,Default,,0,0,0,,Тіпті өзіме тым сенімді болдым.
Dialogue: 0,0:53:52.60,0:53:54.02,Default,,0,0,0,,Тіпті өзіме тым сенімді болдым.
Dialogue: 0,0:53:52.60,0:53:54.02,Default,,0,0,0,,Осы түсіру туралы
Dialogue: 0,0:53:54.10,0:53:55.39,Default,,0,0,0,,Полковник Кеннет басқарғанға дейін.
Dialogue: 0,0:53:54.10,0:53:55.39,Default,,0,0,0,,есіме түсті
Dialogue: 0,0:53:55.39,0:53:55.48,Default,,0,0,0,,есіме түсті
Dialogue: 0,0:53:55.48,0:53:55.64,Default,,0,0,0,,есіме түсті
Dialogue: 0,0:53:55.48,0:53:55.64,Default,,0,0,0,,Мен тыйым салу туралы бұйрық шығарамын.
Dialogue: 0,0:53:55.64,0:53:56.31,Default,,0,0,0,,Мен тыйым салу туралы бұйрық шығарамын.
Dialogue: 0,0:53:56.31,0:53:57.15,Default,,0,0,0,,Мен тыйым салу туралы бұйрық шығарамын.
Dialogue: 0,0:53:56.31,0:53:57.15,Default,,0,0,0,,Иә
Dialogue: 0,0:53:57.23,0:53:58.65,Default,,0,0,0,,Фу…
Dialogue: 0,0:53:57.23,0:53:58.65,Default,,0,0,0,,Шашыраңқы ішкі бөліктер
Dialogue: 0,0:53:58.73,0:54:00.94,Default,,0,0,0,,Оларды мұқият жинауды тапсырыңыз.
Dialogue: 0,0:53:58.73,0:54:00.94,Default,,0,0,0,,Хаха, суық, солай емес пе? Тұрыңыз!
Dialogue: 0,0:54:00.94,0:54:03.15,Default,,0,0,0,,Хаха, суық, солай емес пе? Тұрыңыз!
Dialogue: 0,0:54:05.95,0:54:07.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:15.04,0:54:16.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:54:16.83,0:54:17.83,Default,,0,0,0,,Ішемін бе?
Dialogue: 0,0:54:17.92,0:54:20.00,Default,,0,0,0,,Не? А... аа
Dialogue: 0,0:54:20.09,0:54:20.92,Default,,0,0,0,,Хмм
Dialogue: 0,0:54:27.30,0:54:29.18,Default,,0,0,0,,Мен бұл басқа кесе деп ойладым.
Dialogue: 0,0:54:32.26,0:54:34.27,Default,,0,0,0,,Хуа~аа
Dialogue: 0,0:54:39.48,0:54:41.06,Default,,0,0,0,,Сізге әуе шабуылы болды ма?
Dialogue: 0,0:54:42.11,0:54:44.19,Default,,0,0,0,,Өйткені мен Тасадай қонақүйінде болдым
Dialogue: 0,0:54:44.28,0:54:46.49,Default,,0,0,0,,Бұл қиын болса керек.
Dialogue: 0,0:54:47.65,0:54:49.11,Default,,0,0,0,,Бұл қорқынышты болды.
Dialogue: 0,0:54:53.16,0:54:55.50,Default,,0,0,0,,Эй, ол жерде әлі біраз қалды (Солдат С) Ха!
Dialogue: 0,0:54:55.58,0:54:57.00,Default,,0,0,0,,Көлік құралын орналастыру Асығыңыз!
Dialogue: 0,0:55:08.13,0:55:10.09,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:55:10.18,0:55:11.43,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:55:13.43,0:55:14.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:15.18,0:55:18.64,Default,,0,0,0,,Әскери дүкеннен сатып алғаныңызды ескерсек, жаман киім емес.
Dialogue: 0,0:55:18.73,0:55:20.60,Default,,0,0,0,,Қиын айтыңыз
Dialogue: 0,0:55:20.69,0:55:21.69,Default,,0,0,0,,Бұл
Dialogue: 0,0:55:21.77,0:55:25.69,Default,,0,0,0,,Полковник кешігіп қалған сияқты, бірақ ол сенімен бірге болғысы келетінін айтты.
Dialogue: 0,0:55:25.78,0:55:26.61,Default,,0,0,0,,Иә
Dialogue: 0,0:55:26.69,0:55:28.57,Default,,0,0,0,,Мен не жеуім керек?
Dialogue: 0,0:55:28.65,0:55:29.70,Default,,0,0,0,,Сондай-ақ Тергеу бюросынан
Dialogue: 0,0:55:29.78,0:55:32.99,Default,,0,0,0,,Мен сағат 10-да осында болып, сені көргім келеді.
Dialogue: 0,0:55:33.78,0:55:35.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:55:36.45,0:55:37.50,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:55:46.30,0:55:49.13,Default,,0,0,0,,Мен жаңа есімді шештім.
Dialogue: 0,0:55:49.72,0:55:51.30,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:55:51.38,0:55:55.06,Default,,0,0,0,,Кимберли бірлігінің атауы біртүрлі, солай емес пе?
Dialogue: 0,0:55:55.14,0:55:56.97,Default,,0,0,0,,Басқаруға ешқандай себеп жоқ.
Dialogue: 0,0:55:57.06,0:56:02.02,Default,,0,0,0,,Екінші жағынан, Кеннеттің бөлімшесі де өзін көрсеткісі келетін бір топ адамдар сияқты көрінеді.
Dialogue: 0,0:56:02.10,0:56:03.31,Default,,0,0,0,,олар бізбен бір үстелге отыратын күн келеді.
Dialogue: 0,0:56:04.40,0:56:05.73,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:56:06.69,0:56:08.74,Default,,0,0,0,,Оңтүстік Тынық мұхиты күштері?
Dialogue: 0,0:56:08.82,0:56:09.86,Default,,0,0,0,,Баркер
Dialogue: 0,0:56:10.49,0:56:13.41,Default,,0,0,0,,Цирк әскерлері. Бұл жақсы есім емес пе?
Dialogue: 0,0:56:13.49,0:56:16.58,Default,,0,0,0,,Не қызық... Мықты емес сияқты.
Dialogue: 0,0:56:16.66,0:56:19.37,Default,,0,0,0,,Мен Кирс туралы естідім.
Dialogue: 0,0:56:19.45,0:56:21.71,Default,,0,0,0,,Мен ... бұл Кирсті көремін бе?
Dialogue: 0,0:56:21.79,0:56:26.04,Default,,0,0,0,,Цирктің жабайы жануарларды қолға үйрету сиқыры
Dialogue: 0,0:56:26.67,0:56:29.42,Default,,0,0,0,,Күн құдайы Гелиостың қызы
Dialogue: 0,0:56:29.51,0:56:32.18,Default,,0,0,0,,Иә, бұл құдайдың аты.
Dialogue: 0,0:56:32.26,0:56:35.01,Default,,0,0,0,,Джиги, мен саған қатыгез адамды беремін.
Dialogue: 0,0:56:35.10,0:56:37.85,Default,,0,0,0,,Оның сізді мойынсұнатын күші бар сияқты.
Dialogue: 0,0:56:37.93,0:56:39.64,Default,,0,0,0,,Не? Сол құдай...
Dialogue: 0,0:56:39.72,0:56:42.77,Default,,0,0,0,,Иә, сен ерекшесің.
Dialogue: 0,0:56:43.48,0:56:46.27,Default,,0,0,0,,Джиги, сен бүгін кешке менімен бірге шыға аласың, солай ма?
Dialogue: 0,0:56:46.36,0:56:48.44,Default,,0,0,0,,Осы төтенше жағдайда?
Dialogue: 0,0:56:48.53,0:56:52.82,Default,,0,0,0,,Демек, Джиджи – сәттілік құдайы.
Dialogue: 0,0:56:52.90,0:56:55.03,Default,,0,0,0,,Жарайды, егер менімен жатсаңыз.
Dialogue: 0,0:56:55.12,0:56:58.79,Default,,0,0,0,,Цирктің әскерлері нағыз Киркеге айналады.
Dialogue: 0,0:56:58.87,0:56:59.87,Default,,0,0,0,,Полковник
Dialogue: 0,0:56:59.95,0:57:01.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:01.12,0:57:02.96,Default,,0,0,0,,Мен бұлай айтқанды жек көремін.
Dialogue: 0,0:57:03.54,0:57:07.50,Default,,0,0,0,,Ой, бұл жерде Джигиді де қызықтырғысы келетін бір адам бар сияқты.
Dialogue: 0,0:57:07.59,0:57:09.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:57:10.46,0:57:11.80,Default,,0,0,0,,Бұйрық!
Dialogue: 0,0:57:11.88,0:57:14.59,Default,,0,0,0,,Іздеу тобы 4-ші эскадрильяға дейін іске қосылды, бірақ
Dialogue: 0,0:57:14.68,0:57:16.89,Default,,0,0,0,,Одан кейін не істейсің?
Dialogue: 0,0:57:16.97,0:57:19.14,Default,,0,0,0,,Бәрін, бәрін бер!
Dialogue: 0,0:57:19.22,0:57:21.06,Default,,0,0,0,,Ха! Барлығы ма?
Dialogue: 0,0:57:21.14,0:57:22.73,Default,,0,0,0,,Қазір реттеңіз!
Dialogue: 0,0:57:22.81,0:57:24.48,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:57:27.06,0:57:31.15,Default,,0,0,0,,Қарашы, сен әлі баласың.
Dialogue: 0,0:57:31.23,0:57:32.99,Default,,0,0,0,,Сол себепті...
Dialogue: 0,0:57:33.70,0:57:37.49,Default,,0,0,0,,Мен де полковник сияқты үлкендердің айтқанын ұнатпаймын.
Dialogue: 0,0:57:41.12,0:57:42.20,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:57:42.29,0:57:45.08,Default,,0,0,0,,Бұл сенің оған тоймайсың.
Dialogue: 0,0:57:45.17,0:57:47.75,Default,,0,0,0,,Полковниктің айтуы да тым анық.
Dialogue: 0,0:57:47.83,0:57:51.71,Default,,0,0,0,,Бірақ сіз кейбір оғаш жолмен қисық сызықтың артында тұрсыз.
Dialogue: 0,0:57:51.80,0:57:55.01,Default,,0,0,0,,Бұрын қатты ажырасып кеттіңіз бе?
Dialogue: 0,0:57:55.09,0:57:55.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:57:56.01,0:57:59.68,Default,,0,0,0,,Жарайды, тергеу бюросы келгенше ұйықтаймын.
Dialogue: 0,0:57:59.76,0:58:01.43,Default,,0,0,0,,Мұны істеген жақсы.
Dialogue: 0,0:58:01.51,0:58:05.69,Default,,0,0,0,,Мүфтиге рахмет, әзірше ұйықтай алмаймын.
Dialogue: 0,0:58:05.77,0:58:09.44,Default,,0,0,0,,Осы уақытқа дейін 18 министр өлтірілді.
Dialogue: 0,0:58:10.40,0:58:11.40,Default,,0,0,0,,Не болды?
Dialogue: 0,0:58:11.48,0:58:16.49,Default,,0,0,0,,Жоқ, идеалдарың қаншалықты биік болса да, осыншама адамды өлтірсең.
Dialogue: 0,0:58:17.32,0:58:20.12,Default,,0,0,0,,Бір күні мүфти құрбандыққа шалынады.
Dialogue: 0,0:58:20.20,0:58:21.33,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:58:21.41,0:58:24.04,Default,,0,0,0,,Мен оның басын кесіп аламын.
Dialogue: 0,0:58:34.17,0:58:35.17,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:58:35.26,0:58:37.13,Default,,0,0,0,,Рахмет
Dialogue: 0,0:58:37.93,0:58:40.80,Default,,0,0,0,,Енді мен сізге қайта қоңырау шалмаймын.
Dialogue: 0,0:58:40.89,0:58:44.31,Default,,0,0,0,,Бірақ мүфти тұрған осы әуе кеңістігіне кіру.
Dialogue: 0,0:58:44.39,0:58:47.19,Default,,0,0,0,,Неліктен бортта министрлер көп болды?
Dialogue: 0,0:58:47.27,0:58:48.98,Default,,0,0,0,,Тіпті Жапонияның өзінде осындай көрнекті қонақүй...
Dialogue: 0,0:58:49.06,0:58:50.36,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:58:50.44,0:58:54.19,Default,,0,0,0,,Мен де сондай шалғай жерде жұмыс істеймін, сондықтан ғарыш туралы ештеңе білмеймін.
Dialogue: 0,0:58:54.78,0:58:56.57,Default,,0,0,0,,Мен бір нәрсені айта аламын
Dialogue: 0,0:58:56.65,0:58:58.74,Default,,0,0,0,,Өздерін мүфти деп атайтындар
Dialogue: 0,0:58:58.82,0:59:01.32,Default,,0,0,0,,Бұл оның барлық жерде пайда болатынын білдіреді.
Dialogue: 0,0:59:01.41,0:59:05.66,Default,,0,0,0,,Оның шын немесе жалған екені маңызды емес.
Dialogue: 0,0:59:05.75,0:59:06.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:59:07.29,0:59:09.87,Default,,0,0,0,,Оның тактикасы терроризм.
Dialogue: 0,0:59:09.96,0:59:12.71,Default,,0,0,0,,Сайып келгенде, қолдау көрсетілмейді.
Dialogue: 0,0:59:28.35,0:59:29.27,Default,,0,0,0,,Сіз оны сол жерде қалдыра аласыз.
Dialogue: 0,0:59:29.35,0:59:30.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:30.77,0:59:32.11,Default,,0,0,0,,Кәдесый ретінде жақсы болмас еді
Dialogue: 0,0:59:36.44,0:59:37.36,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:59:39.45,0:59:41.16,Default,,0,0,0,,Бос емес болғаным үшін кешіріңіз
Dialogue: 0,0:59:41.24,0:59:43.66,Default,,0,0,0,,Мен де осында жаңа ғана ауыстым.
Dialogue: 0,0:59:43.74,0:59:45.95,Default,,0,0,0,,Бірақ бұл ұят.
Dialogue: 0,0:59:46.04,0:59:48.04,Default,,0,0,0,,Егер сіз осы бөлімшеге келсеңіз
Dialogue: 0,0:59:48.12,0:59:50.96,Default,,0,0,0,,Маған сол Пенелопа сеніп тапсырылған болуы мүмкін.
Dialogue: 0,0:59:51.04,0:59:52.04,Default,,0,0,0,,Мен саған айттым
Dialogue: 0,0:59:52.13,0:59:54.13,Default,,0,0,0,,Жеңіс - бұл кездейсоқтық
Dialogue: 0,0:59:54.21,0:59:55.84,Default,,0,0,0,,Әкемге қиындық туғызғаны үшін.
Dialogue: 0,0:59:55.92,0:59:59.88,Default,,0,0,0,,Атақты әкенің ұлы болу қиын.
Dialogue: 0,0:59:59.97,1:00:01.55,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,1:00:01.63,1:00:05.51,Default,,0,0,0,,Қыздар маған әкем туралы жиі айтатын.
Dialogue: 0,1:00:05.60,1:00:06.97,Default,,0,0,0,,Енді мен үйге бара жатырмын.
Dialogue: 0,1:00:07.06,1:00:08.35,Default,,0,0,0,,Джиджиге қалай сәлем айтасың?
Dialogue: 0,1:00:08.85,1:00:10.85,Default,,0,0,0,,Кездескен кезде мен өкінемін
Dialogue: 0,1:00:10.94,1:00:12.56,Default,,0,0,0,,Сәлемдесуіңізді өтінемін
Dialogue: 0,1:00:13.61,1:00:16.57,Default,,0,0,0,,Ол бала қайда орналасады екен...
Dialogue: 0,1:00:18.57,1:00:20.03,Default,,0,0,0,,Түсінбейсің бе?
Dialogue: 0,1:00:20.11,1:00:20.99,Default,,0,0,0,,Бұл күдікті.
Dialogue: 0,1:00:21.61,1:00:24.99,Default,,0,0,0,,Баланың мекенжайы иесіз пәтер.
Dialogue: 0,1:00:31.21,1:00:33.50,Default,,0,0,0,,Сіз таңқаларлықтай қысылғансыз ба?
Dialogue: 0,1:00:34.33,1:00:37.09,Default,,0,0,0,,Жоқ, осы сағатта.
Dialogue: 0,1:00:37.17,1:00:40.42,Default,,0,0,0,,Ол Кеннетке бәрін айтып беруі мүмкін.
Dialogue: 0,1:00:40.51,1:00:43.93,Default,,0,0,0,,Нұх, паромға отыратын уақыт таяп қалды.
Dialogue: 0,1:00:44.01,1:00:46.43,Default,,0,0,0,,А, жақсы.
Dialogue: 0,1:00:51.06,1:00:54.69,Default,,0,0,0,,Қазіргі уақытта отырғызу алдында қауіпсіздік тексеруінде.
Dialogue: 0,1:00:54.77,1:00:55.77,Default,,0,0,0,,Уақытыңызды бөлгеніңізге рахмет.
Dialogue: 0,1:00:55.77,1:00:56.86,Default,,0,0,0,,Уақытыңызды бөлгеніңізге рахмет.
Dialogue: 0,1:00:55.77,1:00:56.86,Default,,0,0,0,,Эхехехех Рахмет ата ата
Dialogue: 0,1:00:56.86,1:00:59.65,Default,,0,0,0,,Эхехехе-рахмет атаға
Dialogue: 0,1:00:59.73,1:01:01.19,Default,,0,0,0,,Мен қайта ораламын.
Dialogue: 0,1:01:03.53,1:01:05.78,Default,,0,0,0,,Сулавесиге ересектерге арналған 1 билет
Dialogue: 0,1:01:05.87,1:01:07.12,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,1:01:08.91,1:01:11.04,Default,,0,0,0,,Кешкі рейске баруым керек пе?
Dialogue: 0,1:01:13.08,1:01:15.71,Default,,0,0,0,,Алайда адамның жер бетінде өмір сүруі мүмкін емес.
Dialogue: 0,1:01:15.79,1:01:18.42,Default,,0,0,0,,Біз оны күнә деп санайтын дәуірде өмір сүріп жатырмыз.
Dialogue: 0,1:01:18.50,1:01:21.92,Default,,0,0,0,,Түсінулеріңізді шын жүректен қалаймын.
Dialogue: 0,1:01:22.01,1:01:24.43,Default,,0,0,0,,Біз ғарыштық иммиграцияның мағынасын ұмыттық.
Dialogue: 0,1:01:24.51,1:01:27.01,Default,,0,0,0,,Қазіргі Жер Федерациясының үкіметін ойлануға шақыру.
Dialogue: 0,1:01:27.01,1:01:28.14,Default,,0,0,0,,Қазіргі Жер Федерациясының үкіметін ойлануға шақыру.
Dialogue: 0,1:01:27.01,1:01:28.14,Default,,0,0,0,,Қазір мен ваннада шомылып жатырмын, шамамен 30 минуттан кейін бар.
Dialogue: 0,1:01:28.14,1:01:28.22,Default,,0,0,0,,Қазіргі Жер Федерациясы үкіметін ойлануға шақыру.
Dialogue: 0,1:01:28.22,1:01:29.18,Default,,0,0,0,,Қазіргі Жер Федерациясының үкіметін ойлануға шақыру.
Dialogue: 0,1:01:28.22,1:01:29.18,Default,,0,0,0,,Мүфти желіні жұлып жатыр.
Dialogue: 0,1:01:29.18,1:01:29.26,Default,,0,0,0,,Мүфти желіні тартып жатыр.
Dialogue: 0,1:01:29.26,1:01:30.43,Default,,0,0,0,,Мүфти желіні тартып жатыр.
Dialogue: 0,1:01:29.26,1:01:30.43,Default,,0,0,0,,Қажеттіліктен шабуыл жасалды
Dialogue: 0,1:01:30.43,1:01:30.52,Default,,0,0,0,,Қажеттіліктен шабуыл жасалды
Dialogue: 0,1:01:30.52,1:01:31.31,Default,,0,0,0,,Қажеттіліктен шабуыл жасалды
Dialogue: 0,1:01:30.52,1:01:31.31,Default,,0,0,0,,Қалжыңдамаңыз! ерікті түрде
Dialogue: 0,1:01:31.31,1:01:31.39,Default,,0,0,0,,Қалжыңдамаңыз! ерікті түрде
Dialogue: 0,1:01:31.39,1:01:31.68,Default,,0,0,0,,Қалжыңдамаңыз! ерікті түрде
Dialogue: 0,1:01:31.39,1:01:31.68,Default,,0,0,0,,Соғыс жарияланғанына қарамастан...
Dialogue: 0,1:01:31.68,1:01:31.77,Default,,0,0,0,,Осындай соғыс жарияланғанына қарамастан...
Dialogue: 0,1:01:31.77,1:01:32.81,Default,,0,0,0,,Осындай соғыс жарияланғанына қарамастан...
Dialogue: 0,1:01:31.77,1:01:32.81,Default,,0,0,0,,Бум, бум, орында!
Dialogue: 0,1:01:32.81,1:01:32.89,Default,,0,0,0,,Осындай соғыс жарияланғанына қарамастан...
Dialogue: 0,1:01:32.89,1:01:34.64,Default,,0,0,0,,Соғыс жарияланғанына қарамастан...
Dialogue: 0,1:01:32.89,1:01:34.64,Default,,0,0,0,,Лаңкестер
Dialogue: 0,1:01:34.64,1:01:35.94,Default,,0,0,0,,Осындай соғыс жарияланғанына қарамастан...
Dialogue: 0,1:01:36.02,1:01:39.94,Default,,0,0,0,,Әй, кел, кел.
Dialogue: 0,1:01:40.02,1:01:42.94,Default,,0,0,0,,Бұл тәтті және дәмді банан.
Dialogue: 0,1:01:40.02,1:01:42.94,Default,,0,0,0,,Сіз жеткізіңіз.
Dialogue: 0,1:01:43.03,1:01:45.95,Default,,0,0,0,,О, әр кезде қош келдіңіз.
Dialogue: 0,1:01:54.00,1:01:54.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:01.38,1:02:03.34,Default,,0,0,0,,Мына жерде (Б бала) Эй, эй Ахаха
Dialogue: 0,1:02:03.42,1:02:05.30,Default,,0,0,0,,Күтіңіз, күтіңіз~ (Бала С) Бір минут күтіңіз.
Dialogue: 0,1:02:19.11,1:02:20.27,Default,,0,0,0,,Я...
Dialogue: 0,1:02:32.83,1:02:34.91,Default,,0,0,0,,Сіз Недженді білесіз, солай ма?
Dialogue: 0,1:02:37.50,1:02:40.04,Default,,0,0,0,,Келіңіздер! Мен жалақы алып жатырмын
Dialogue: 0,1:02:40.13,1:02:41.50,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:46.84,1:02:48.55,Default,,0,0,0,,Декорацияны түсіндіріп берейін бе?
Dialogue: 0,1:02:48.63,1:02:50.14,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,1:02:51.97,1:02:55.64,Default,,0,0,0,,Сіз теңізде шынымен жақсы емессіз, солай ма?
Dialogue: 0,1:02:55.73,1:02:57.77,Default,,0,0,0,,Әлгі әйел айтты
Dialogue: 0,1:02:57.85,1:02:59.15,Default,,0,0,0,,Ууух!
Dialogue: 0,1:02:59.23,1:03:02.23,Default,,0,0,0,,Үлкен әйелдер жақсы дейді.
Dialogue: 0,1:03:02.32,1:03:05.03,Default,,0,0,0,,Керемет, мен де тапқым келеді.
Dialogue: 0,1:03:22.17,1:03:23.17,Default,,0,0,0,,Я...
Dialogue: 0,1:03:24.17,1:03:26.05,Default,,0,0,0,,(Крейсердің жақындап келе жатқан дыбысы)
Dialogue: 0,1:03:26.05,1:03:26.88,Default,,0,0,0,,(Крейсердің жақындап келе жатқан дыбысы)
Dialogue: 0,1:03:26.05,1:03:26.88,Default,,0,0,0,,Әй!
Dialogue: 0,1:03:39.19,1:03:40.48,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,1:03:40.56,1:03:42.48,Default,,0,0,0,,Тиын салғышта чемодан бар.
Dialogue: 0,1:03:42.56,1:03:43.40,Default,,0,0,0,,Кілт дегеніміз не?
Dialogue: 0,1:03:43.48,1:03:44.86,Default,,0,0,0,,Бұл күртешенің қалтасы.
Dialogue: 0,1:03:45.40,1:03:46.44,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:03:46.53,1:03:47.53,Default,,0,0,0,,Әй!
Dialogue: 0,1:03:48.69,1:03:49.86,Default,,0,0,0,,Тағы кел!
Dialogue: 0,1:03:49.95,1:03:51.03,Default,,0,0,0,,Ах!
Dialogue: 0,1:04:02.75,1:04:04.25,Default,,0,0,0,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,1:04:04.34,1:04:07.96,Default,,0,0,0,,Хаунсенде қалыптасқан оғаш қарым-қатынастардан
Dialogue: 0,1:04:08.05,1:04:09.63,Default,,0,0,0,,Бұл сіздің қашып кеткеніңізді білдіреді.
Dialogue: 0,1:04:09.72,1:04:11.30,Default,,0,0,0,,Хехе
Dialogue: 0,1:04:11.38,1:04:14.68,Default,,0,0,0,,Ол кісілер мүфтидің өзімен бірге болған.
Dialogue: 0,1:04:14.76,1:04:16.81,Default,,0,0,0,,Мұны ешкім елестетпеген болар еді, солай ма?
Dialogue: 0,1:04:16.89,1:04:19.56,Default,,0,0,0,,Жоқ, мен Кеннет байқайтынына сенімдімін.
Dialogue: 0,1:04:19.64,1:04:20.64,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:20.73,1:04:24.48,Default,,0,0,0,,Тіпті Джиги ештеңе айтпаса да.
Dialogue: 0,1:04:53.09,1:04:57.56,Default,,0,0,0,,Хэтэуэй, маған сәлем айтпай кетіп қалдың ба?
Dialogue: 0,1:04:58.39,1:05:01.06,Default,,0,0,0,,Екеуміз кездескенде біраз өкінетін боламын, сондықтан маған қамқор болыңыз.
Dialogue: 0,1:05:01.14,1:05:03.52,Default,,0,0,0,,Бұл дөрекі емес пе?
Dialogue: 0,1:05:03.60,1:05:05.48,Default,,0,0,0,,Мен ер адам ретінде түсінемін.
Dialogue: 0,1:05:05.56,1:05:06.52,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,1:05:06.61,1:05:10.32,Default,,0,0,0,,Операция аяқталғаннан кейін мен сізді Гонконгқа жіберемін.
Dialogue: 0,1:05:10.40,1:05:12.74,Default,,0,0,0,,Мен бұрынғы коттеджімді қорғадым.
Dialogue: 0,1:05:12.82,1:05:14.16,Default,,0,0,0,,Хякурен
Dialogue: 0,1:05:14.24,1:05:17.37,Default,,0,0,0,,Немесе сіз оны өз бақылауыңызда ұстауыңыз керек.
Dialogue: 0,1:05:17.45,1:05:19.20,Default,,0,0,0,,Мазасызсыз ба?
Dialogue: 0,1:05:19.29,1:05:22.04,Default,,0,0,0,,Мм... Мен оны қарап шықтым.
Dialogue: 0,1:05:22.12,1:05:24.37,Default,,0,0,0,,Хаунсенге Баунден Вуден енгізген
Dialogue: 0,1:05:24.46,1:05:25.96,Default,,0,0,0,,Сіздің өтініш бергеніңізді естідім.
Dialogue: 0,1:05:26.96,1:05:28.42,Default,,0,0,0,,Сіз сол отбасынансыз ба?
Dialogue: 0,1:05:28.50,1:05:30.17,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:05:30.76,1:05:33.55,Default,,0,0,0,,Сонда сіз Хаунсенге қалай жеттіңіз?
Dialogue: 0,1:05:33.63,1:05:36.97,Default,,0,0,0,,Өйткені ол Баунденвуден графымен тығыз қарым-қатынаста.
Dialogue: 0,1:05:37.05,1:05:37.89,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:37.97,1:05:41.18,Default,,0,0,0,,Мұны естісең, бәрінің мәні болады.
Dialogue: 0,1:05:41.27,1:05:44.10,Default,,0,0,0,,Сіз маған коттедж сатып алдыңыз.
Dialogue: 0,1:05:44.19,1:05:46.06,Default,,0,0,0,,Күлкілі болу
Dialogue: 0,1:05:46.15,1:05:47.56,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,1:05:47.65,1:05:50.98,Default,,0,0,0,,Граф 80 жастан асқан болуы керек...
Dialogue: 0,1:05:51.07,1:05:52.82,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,1:05:52.90,1:05:55.82,Default,,0,0,0,,Денсаулығыңыз жақсы деп үміттенемін.
Dialogue: 0,1:05:55.91,1:05:58.07,Default,,0,0,0,,Кейбіреулеріңіз өзіңізді жалғыз сезінуіңіз мүмкін.
Dialogue: 0,1:05:58.70,1:06:01.87,Default,,0,0,0,,Гонконгтағы пәтеріңіз қаңырап бос қалды.
Dialogue: 0,1:06:01.95,1:06:05.58,Default,,0,0,0,,Оны мен үшін Граф сатып алды, мен оны бірінші рет көргелі отырмын.
Dialogue: 0,1:06:05.67,1:06:08.08,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,1:06:08.17,1:06:11.63,Default,,0,0,0,,Менің шын түрім лас, солай емес пе?
Dialogue: 0,1:06:11.71,1:06:13.26,Default,,0,0,0,,Мен жақында кетемін.
Dialogue: 0,1:06:22.72,1:06:23.81,Default,,0,0,0,,Мұнда қандай фотосессия өткізіп жатырсыз?
Dialogue: 0,1:06:24.64,1:06:26.60,Default,,0,0,0,,Сенің осында болғаныңа қуаныштымын
Dialogue: 0,1:06:26.69,1:06:29.56,Default,,0,0,0,,Менің болжамым бар, сен жеңістің құдайысың.
Dialogue: 0,1:06:29.65,1:06:31.69,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,1:06:31.77,1:06:34.86,Default,,0,0,0,,Ұрыс даласындағы адамдар генералды алып жүреді.
Dialogue: 0,1:06:34.94,1:06:36.32,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,1:06:36.40,1:06:39.62,Default,,0,0,0,,Бірақ Хэтэуэй меннен қашып жүрді.
Dialogue: 0,1:06:40.20,1:06:43.95,Default,,0,0,0,,Солдат бола алмағандықтан.
Dialogue: 0,1:06:44.04,1:06:44.95,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:06:45.04,1:06:46.91,Default,,0,0,0,,Джиги Жаңа ғана не айттыңыз?
Dialogue: 0,1:06:47.00,1:06:47.96,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:48.04,1:06:50.38,Default,,0,0,0,,Хэтэуэйден бірдеңе естідіңіз бе?
Dialogue: 0,1:06:50.46,1:06:53.17,Default,,0,0,0,,Жоқ. Хэтэуэйге қатысты қандай сезімде болдыңыз?
Dialogue: 0,1:07:29.79,1:07:31.42,Default,,0,0,0,,О? (Механик В) А...
Dialogue: 0,1:07:35.00,1:07:36.01,Default,,0,0,0,,Эме
Dialogue: 0,1:07:49.10,1:07:50.60,Default,,0,0,0,,Раймонд!
Dialogue: 0,1:07:50.69,1:07:54.40,Default,,0,0,0,,Сәлем, Ирам! Бұл әуедегі қабылдау!
Dialogue: 0,1:07:55.02,1:07:56.94,Default,,0,0,0,,Сіз де дайындалыңыз!
Dialogue: 0,1:07:57.03,1:07:58.40,Default,,0,0,0,,Неге!
Dialogue: 0,1:07:59.36,1:08:02.28,Default,,0,0,0,,Кешіріңіз, Максимилианға көмектесіңізші.
Dialogue: 0,1:08:03.03,1:08:04.03,Default,,0,0,0,,Хэтэуэй!
Dialogue: 0,1:08:04.12,1:08:05.08,Default,,0,0,0,,О, Хэтэуэй!
Dialogue: 0,1:08:05.16,1:08:05.99,Default,,0,0,0,,Мүфти!
Dialogue: 0,1:08:06.08,1:08:07.37,Default,,0,0,0,,Фу…
Dialogue: 0,1:08:07.45,1:08:08.87,Default,,0,0,0,,Цивет
Dialogue: 0,1:08:09.50,1:08:11.29,Default,,0,0,0,,Гауман үшін кешірім сұраймын.
Dialogue: 0,1:08:11.37,1:08:12.29,Default,,0,0,0,,Жоқ
Dialogue: 0,1:08:12.37,1:08:14.29,Default,,0,0,0,,Біз де құтқару операциясы туралы ойлануымыз керек.
Dialogue: 0,1:08:14.38,1:08:15.54,Default,,0,0,0,,Хмм...
Dialogue: 0,1:08:15.63,1:08:17.00,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:08:21.09,1:08:22.30,Default,,0,0,0,,Valiant туралы не деуге болады?
Dialogue: 0,1:08:22.38,1:08:24.85,Default,,0,0,0,,Ол жоспарланған теңіз аймағына жетуі керек еді.
Dialogue: 0,1:08:25.47,1:08:27.47,Default,,0,0,0,,Авиациялық түбіртек?
Dialogue: 0,1:08:27.56,1:08:28.81,Default,,0,0,0,,Михешадан сұраңыз
Dialogue: 0,1:08:28.89,1:08:31.02,Default,,0,0,0,,Мен тым абай болдым ба?
Dialogue: 0,1:08:31.10,1:08:33.19,Default,,0,0,0,,Мүмкін
Dialogue: 0,1:08:39.69,1:08:40.57,Default,,0,0,0,,Кеше және бүгін
Dialogue: 0,1:08:40.65,1:08:43.61,Default,,0,0,0,,Мүфтидің бірінші әскері боламын деген бөлімшеден.
Dialogue: 0,1:08:43.70,1:08:46.62,Default,,0,0,0,,Қарапайым мәтінде мұқабаға сұраныс бар.
Dialogue: 0,1:08:46.70,1:08:47.91,Default,,0,0,0,,Оенберри?
Dialogue: 0,1:08:47.99,1:08:50.87,Default,,0,0,0,,Густав Карл Кимберли, оннан астам ұшақ.
Dialogue: 0,1:08:50.96,1:08:52.96,Default,,0,0,0,,Қалаға шабуыл жасалды.
Dialogue: 0,1:08:53.04,1:08:54.46,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,1:08:55.13,1:08:57.09,Default,,0,0,0,,Мені не мазалағанын білмеймін
Dialogue: 0,1:08:57.17,1:08:59.13,Default,,0,0,0,,Бұл бір ғана мүмкіндік.
Dialogue: 0,1:08:59.84,1:09:02.59,Default,,0,0,0,,Мен оның Федерацияның қолына түсуіне жол бермегім келеді.
Dialogue: 0,1:09:02.68,1:09:03.88,Default,,0,0,0,,Бұл арқанмен серуендеу.
Dialogue: 0,1:09:05.34,1:09:07.85,Default,,0,0,0,,Бұдан былай әрқашан осылай болады
Dialogue: 0,1:09:07.93,1:09:08.85,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:09.10,1:09:09.85,Default,,0,0,0,,(Ескерту ескертуі)
Dialogue: 0,1:09:09.85,1:09:10.93,Default,,0,0,0,,(Ескерту ескертуі)
Dialogue: 0,1:09:09.85,1:09:10.93,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:10.93,1:09:11.02,Default,,0,0,0,,(Ескерту ескертуі)
Dialogue: 0,1:09:11.02,1:09:12.52,Default,,0,0,0,,(Ескерту ескертуі)
Dialogue: 0,1:09:11.02,1:09:12.52,Default,,0,0,0,,Не?
Dialogue: 0,1:09:12.60,1:09:16.11,Default,,0,0,0,,Олар сүңгуір қайық болып көрінетін жақын маңдағы жаудың радиотолқындарын ұстап алған сияқты.
Dialogue: 0,1:09:16.52,1:09:17.36,Default,,0,0,0,,Әй!
Dialogue: 0,1:09:18.57,1:09:20.90,Default,,0,0,0,,№ 3 Фенсер Жарайды.
Dialogue: 0,1:09:20.99,1:09:22.24,Default,,0,0,0,,Түсінікті! өтінемін
Dialogue: 0,1:09:22.99,1:09:24.66,Default,,0,0,0,,Келесі, гольф Жарайды!
Dialogue: 0,1:09:24.74,1:09:25.57,Default,,0,0,0,,Цивет
Dialogue: 0,1:09:25.66,1:09:27.70,Default,,0,0,0,,2 Гал Сайсон келе жатыр!
Dialogue: 0,1:09:28.83,1:09:30.58,Default,,0,0,0,,Дерек көзі деп есептелетін сүңгуір қайық
Dialogue: 0,1:09:30.66,1:09:32.96,Default,,0,0,0,,Көлеңкеде Тиддл аралымен оңтүстікке қарай бет алды
Dialogue: 0,1:09:33.04,1:09:35.33,Default,,0,0,0,,Макиан аралы Батыс теңізде орналасқан
Dialogue: 0,1:09:36.79,1:09:38.63,Default,,0,0,0,,Мен саған сенемін, Цивет.
Dialogue: 0,1:09:38.71,1:09:41.80,Default,,0,0,0,,Менің оны атып тастауға рұқсатым бар. Міндетті түрде атып түсіріңіз!
Dialogue: 0,1:09:41.88,1:09:43.76,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,1:09:43.84,1:09:46.09,Default,,0,0,0,,Сүңгуір қайық не дейді?
Dialogue: 0,1:09:46.18,1:09:49.51,Default,,0,0,0,,Мен сізден суға қонған кезде мінген реактивті ұшақ туралы не ойлайтыныңызды сұраймын.
Dialogue: 0,1:09:50.18,1:09:51.72,Default,,0,0,0,,Осы Миновский бөлшегі астында
Dialogue: 0,1:09:51.81,1:09:52.98,Default,,0,0,0,,Кемелсіз болмаса да
Dialogue: 0,1:09:53.06,1:09:57.35,Default,,0,0,0,,Оның Даваоға жақын маңдағы кемелер арқылы берілуі мүмкін.
Dialogue: 0,1:09:57.44,1:10:00.27,Default,,0,0,0,,Мен Даваодағы сүңгуір қайық туралы естіген емеспін.
Dialogue: 0,1:10:00.36,1:10:01.53,Default,,0,0,0,,Хмм…
Dialogue: 0,1:10:01.61,1:10:05.40,Default,,0,0,0,,Жаңа қызметке кіріспес бұрын, сіз көп нәрсеге араласасыз, солай емес пе?
Dialogue: 0,1:10:05.49,1:10:07.24,Default,,0,0,0,,Әй, сақтығыңды түсірме.
Dialogue: 0,1:10:07.32,1:10:10.08,Default,,0,0,0,,Кеннет Слегг есімді адам
Dialogue: 0,1:10:13.41,1:10:14.62,Default,,0,0,0,,Полковник Кеннет!
Dialogue: 0,1:10:17.92,1:10:19.00,Default,,0,0,0,,Бұл солай шығар.
Dialogue: 0,1:10:19.08,1:10:22.30,Default,,0,0,0,,Крейсер бір рет шығанаққа қайтып оралды да, кері бұрылды.
Dialogue: 0,1:10:22.38,1:10:24.97,Default,,0,0,0,,Порт әкімшілігі мен Әскери-теңіз күштерін шақырыңыз!
Dialogue: 0,1:10:25.05,1:10:27.30,Default,,0,0,0,,Тіпті ең кішкентай қозғалыстарды да хабарлауын сұраңыз.
Dialogue: 0,1:10:27.38,1:10:31.89,Default,,0,0,0,,Бізде жұмыс күші жетіспейді, сондықтан бізге аздап көмектесіңізші!
Dialogue: 0,1:10:31.97,1:10:34.77,Default,,0,0,0,,Давао полициясының бастығы шықты ма?
Dialogue: 0,1:10:35.98,1:10:38.90,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:10:39.48,1:10:40.94,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,1:10:41.94,1:10:43.11,Default,,0,0,0,,Сіз мұны жасадыңыз ба!?
Dialogue: 0,1:10:43.19,1:10:44.19,Default,,0,0,0,,Белгісіз
Dialogue: 0,1:10:44.28,1:10:45.65,Default,,0,0,0,,Жоғарыда айтылғандардан ажырата алмайсыз ба?
Dialogue: 0,1:10:46.74,1:10:48.03,Default,,0,0,0,,Тағы біраз күтіңіз
Dialogue: 0,1:10:49.07,1:10:49.91,Default,,0,0,0,,Илам
Dialogue: 0,1:10:49.99,1:10:51.20,Default,,0,0,0,,Фу…
Dialogue: 0,1:10:52.83,1:10:54.29,Default,,0,0,0,,Менің ойымша, оған көмектесу мүмкін емес
Dialogue: 0,1:11:07.38,1:11:10.22,Default,,0,0,0,,Біз мұнда қанша уақыт күтеміз?
Dialogue: 0,1:11:10.30,1:11:11.72,Default,,0,0,0,,Капитан Лейн~
Dialogue: 0,1:11:11.80,1:11:13.01,Default,,0,0,0,,Гяхахаха…
Dialogue: 0,1:11:36.33,1:11:37.29,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,1:11:37.37,1:11:38.87,Default,,0,0,0,,Ешқандай проблема болмауы керек.
Dialogue: 0,1:11:38.96,1:11:41.67,Default,,0,0,0,,Мен сіздің қайтып келетініңізге кепілдік бере алмаймын.
Dialogue: 0,1:11:41.75,1:11:42.58,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:42.67,1:11:44.04,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:48.13,1:11:50.01,Default,,0,0,0,,Менің мұны істейтініме сенімдісіз бе?
Dialogue: 0,1:11:51.84,1:11:53.60,Default,,0,0,0,,Мен білемін.
Dialogue: 0,1:11:53.68,1:11:56.85,Default,,0,0,0,,Кәдімгі ұшқыштарға орын жоқ.
Dialogue: 0,1:12:02.27,1:12:04.65,Default,,0,0,0,,Ем! Жалқау болмаңыз!
Dialogue: 0,1:12:04.73,1:12:07.11,Default,,0,0,0,,Деректерді Messer-ке жылдам жіберіңіз!
Dialogue: 0,1:12:07.82,1:12:09.32,Default,,0,0,0,,Мен білемін.
Dialogue: 0,1:12:12.78,1:12:15.83,Default,,0,0,0,,Бұл ақымақ стратегия, Хэтэуэй.
Dialogue: 0,1:12:16.62,1:12:18.62,Default,,0,0,0,,Кешіріңіз, Раймонд.
Dialogue: 0,1:12:18.70,1:12:22.37,Default,,0,0,0,,Жарайды, мен сені жеткізіп беремін.
Dialogue: 0,1:12:22.46,1:12:23.92,Default,,0,0,0,,Өтінемін!
Dialogue: 0,1:12:24.00,1:12:27.76,Default,,0,0,0,,Бұл Раймондқа қатысуға рұқсат етпеу керек стратегия.
Dialogue: 0,1:12:28.92,1:12:29.88,Default,,0,0,0,,Хмм...
Dialogue: 0,1:12:30.76,1:12:34.22,Default,,0,0,0,,Сонда оны аямайсың ба?
Dialogue: 0,1:12:38.27,1:12:39.52,Default,,0,0,0,,Крейсердің иесі
Dialogue: 0,1:12:39.60,1:12:41.35,Default,,0,0,0,,3-ші жақтың парламенттік хатшысы (үш)
Dialogue: 0,1:12:41.44,1:12:43.73,Default,,0,0,0,,Қазіргі уақытта Аделаида конференциясында
Dialogue: 0,1:12:43.81,1:12:46.69,Default,,0,0,0,,Ол Гонконгқа бара жатқан ұшақта болған дейді.
Dialogue: 0,1:12:46.77,1:12:47.78,Default,,0,0,0,,Әскери-теңіз күштерінен!
Dialogue: 0,1:12:47.86,1:12:49.86,Default,,0,0,0,,Белгісіз тиістіліктің бірлігі болып көрінетін нәрсе.
Dialogue: 0,1:12:50.57,1:12:53.70,Default,,0,0,0,,Оны Халмахера аралының орталық-батыс жағалауында ұстаған дейді.
Dialogue: 0,1:12:56.45,1:12:57.95,Default,,0,0,0,,Қайта-қайта айтамын
Dialogue: 0,1:12:58.54,1:13:01.71,Default,,0,0,0,,Егер мен бәрін білсем, қауіпті болар еді.
Dialogue: 0,1:13:01.79,1:13:04.04,Default,,0,0,0,,Мен шынымен де білмеймін
Dialogue: 0,1:13:04.58,1:13:06.59,Default,,0,0,0,,Гауман Нобил мырза.
Dialogue: 0,1:13:06.67,1:13:07.88,Default,,0,0,0,,Әй?
Dialogue: 0,1:13:07.96,1:13:10.17,Default,,0,0,0,,Ақыры есіме түсті
Dialogue: 0,1:13:10.26,1:13:12.51,Default,,0,0,0,,Хэтэуэй Ноамен кездескен кезіңіз туралы айтып беріңізші.
Dialogue: 0,1:13:12.59,1:13:15.84,Default,,0,0,0,,Ол әйгілі. Ол Жарқын Нұхтың ұлы.
Dialogue: 0,1:13:16.51,1:13:20.47,Default,,0,0,0,,Хэтэуэй мүфтимен тығыз қарым-қатынаста. Сіз қалай ойлайсыз?
Dialogue: 0,1:13:20.56,1:13:21.43,Default,,0,0,0,,Хаха
Dialogue: 0,1:13:22.02,1:13:23.52,Default,,0,0,0,,Мүфтилік
Dialogue: 0,1:13:23.60,1:13:26.40,Default,,0,0,0,,Мен мүфти Еріннің өзін ойнаймын.
Dialogue: 0,1:13:26.48,1:13:28.52,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:13:28.61,1:13:31.03,Default,,0,0,0,,Олай болса, ұйымдастырушы болуы керек!
Dialogue: 0,1:13:31.11,1:13:32.49,Default,,0,0,0,,Бұл кім!
Dialogue: 0,1:13:32.57,1:13:36.03,Default,,0,0,0,,Айтқың келмесе, сені мүфти етемін.
Dialogue: 0,1:13:36.12,1:13:38.66,Default,,0,0,0,,Мен сізді орындау орнына жібере аламын ба?
Dialogue: 0,1:13:38.74,1:13:40.79,Default,,0,0,0,,Мен шынымен де білмеймін.
Dialogue: 0,1:13:40.87,1:13:44.71,Default,,0,0,0,,Дегенмен, өсек болса, естідім.
Dialogue: 0,1:13:44.79,1:13:48.92,Default,,0,0,0,,Менің ойымша, мүфти Чар Азнабельдің аруағы.
Dialogue: 0,1:13:49.00,1:13:50.34,Default,,0,0,0,,Әй!
Dialogue: 0,1:13:53.67,1:13:54.93,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:13:55.01,1:13:56.72,Default,,0,0,0,,Сөйлемесең
Dialogue: 0,1:13:56.80,1:14:00.64,Default,,0,0,0,,Менің ләззатым сәйкесінше артады.
Dialogue: 0,1:14:02.81,1:14:04.48,Default,,0,0,0,,Хмф! Арх!
Dialogue: 0,1:14:04.56,1:14:05.98,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,1:14:06.06,1:14:07.52,Default,,0,0,0,,Уф...
Dialogue: 0,1:14:18.49,1:14:19.32,Default,,0,0,0,,Хмм...
Dialogue: 0,1:14:19.87,1:14:21.58,Default,,0,0,0,,Жылжымалы костюм?
Dialogue: 0,1:14:22.83,1:14:23.75,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:25.54,1:14:26.87,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:14:26.96,1:14:28.38,Default,,0,0,0,,Бұл Пенелопа.
Dialogue: 0,1:14:29.00,1:14:31.00,Default,,0,0,0,,Лейтенант Лейн Мақсат.
Dialogue: 0,1:14:31.67,1:14:35.38,Default,,0,0,0,,Полковник Кеннет маған сізді кепілге алуды айтты.
Dialogue: 0,1:14:35.47,1:14:36.55,Default,,0,0,0,,Нана... (Лейн) Басқаша айтқанда
Dialogue: 0,1:14:36.63,1:14:38.80,Default,,0,0,0,,Егер сіз жеңілетін болсаңыз, оны қалқан ретінде пайдаланыңыз.
Dialogue: 0,1:14:38.89,1:14:40.39,Default,,0,0,0,,Сіз лассыз!
Dialogue: 0,1:14:40.47,1:14:42.06,Default,,0,0,0,,Мен олай ойламаймын!
Dialogue: 0,1:14:42.14,1:14:45.43,Default,,0,0,0,,Мүфтидің бей-берекет терактілерімен салыстырғанда.
Dialogue: 0,1:14:45.52,1:14:49.56,Default,,0,0,0,,Өйткені адам өміріне келтірілген зиян бір адамның өмірі ғана.
Dialogue: 0,1:14:49.65,1:14:50.98,Default,,0,0,0,,Цк
Dialogue: 0,1:14:51.06,1:14:53.65,Default,,0,0,0,,Бірақ мен мұны істемес едім.
Dialogue: 0,1:14:53.73,1:14:54.57,Default,,0,0,0,,Әй?
Dialogue: 0,1:14:55.69,1:14:58.03,Default,,0,0,0,,Мен осы Пенелопамен соғысқанша
Dialogue: 0,1:14:58.11,1:15:00.78,Default,,0,0,0,,Мен сенің өміріңе кепілдік беремін
Dialogue: 0,1:15:00.87,1:15:02.37,Default,,0,0,0,,Фу…
Dialogue: 0,1:15:04.45,1:15:05.79,Default,,0,0,0,,Асығыңыз! Сіз оны әлі де жинақтай аласыз
Dialogue: 0,1:15:05.87,1:15:08.58,Default,,0,0,0,,Бұл таңғажайып антиквариат болды!? О?
Dialogue: 0,1:15:08.67,1:15:10.58,Default,,0,0,0,,Сіз оны алып жүре аласыз.
Dialogue: 0,1:15:11.67,1:15:12.96,Default,,0,0,0,,Жүгір!
Dialogue: 0,1:15:13.05,1:15:14.05,Default,,0,0,0,,Егер Хигучи екінші Кира сияқты тек қарап-ақ адам өлтіре алса, онда Кираның шын кім екені бағдарлама соңында ашылады!
Dialogue: 0,1:15:14.13,1:15:15.96,Default,,0,0,0,,Даваодан 3 Кесария ұшағына дейін
Dialogue: 0,1:15:16.05,1:15:17.88,Default,,0,0,0,,Жаңа үлгі көтерілген сияқты.
Dialogue: 0,1:15:17.97,1:15:19.30,Default,,0,0,0,,Осы бағытта
Dialogue: 0,1:15:19.38,1:15:22.30,Default,,0,0,0,,Ескі сүңгуір қайық батып кетті!
Dialogue: 0,1:15:22.39,1:15:23.64,Default,,0,0,0,,Сәлем, Ирам!
Dialogue: 0,1:15:24.97,1:15:27.85,Default,,0,0,0,,Мына ағаштан бас тарт. Valiant және Searac қосылыңыз.
Dialogue: 0,1:15:27.94,1:15:30.56,Default,,0,0,0,,Не... шынымен?
Dialogue: 0,1:15:58.47,1:15:59.93,Default,,0,0,0,,Хмм...
Dialogue: 0,1:16:00.47,1:16:03.39,Default,,0,0,0,,Ууууууууууууууууу...
Dialogue: 0,1:16:03.47,1:16:06.52,Default,,0,0,0,,Екінші күшейткіш бөлу
Dialogue: 0,1:16:08.18,1:16:09.89,Default,,0,0,0,,Жүк Пизасы құлау жағдайында
Dialogue: 0,1:16:09.98,1:16:11.52,Default,,0,0,0,,Аудару үшін азимут бұрышын алыңыз
Dialogue: 0,1:16:11.60,1:16:14.27,Default,,0,0,0,,Күте тұрыңыз, дерекқордың айнымалылары...
Dialogue: 0,1:16:14.86,1:16:15.94,Default,,0,0,0,,Мүмкін
Dialogue: 0,1:16:16.02,1:16:18.03,Default,,0,0,0,,Көтергішті алып тастаймыз
Dialogue: 0,1:16:18.11,1:16:20.95,Default,,0,0,0,,3 2 1…
Dialogue: 0,1:16:21.74,1:16:24.28,Default,,0,0,0,,Көтергіш төсек бөлек
Dialogue: 0,1:16:24.37,1:16:25.53,Default,,0,0,0,,Сіз тұтқынға түсесіз бе?
Dialogue: 0,1:16:25.62,1:16:26.58,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,1:16:26.66,1:16:29.29,Default,,0,0,0,,Ешкім ешқашан мұндай ақымақтық жасамас еді.
Dialogue: 0,1:16:30.12,1:16:31.00,Default,,0,0,0,,Эме ше?
Dialogue: 0,1:16:31.08,1:16:33.71,Default,,0,0,0,,Раймонд қателеспесе!
Dialogue: 0,1:16:33.79,1:16:34.50,Default,,0,0,0,,Ол сізге айтып береді.
Dialogue: 0,1:16:34.50,1:16:34.92,Default,,0,0,0,,Ол сізге айтып береді.
Dialogue: 0,1:16:34.50,1:16:34.92,Default,,0,0,0,,(Ескерту)
Dialogue: 0,1:16:34.92,1:16:35.00,Default,,0,0,0,,(Ескерту)
Dialogue: 0,1:16:35.00,1:16:36.04,Default,,0,0,0,,(Ескерту)
Dialogue: 0,1:16:35.00,1:16:36.04,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:36.13,1:16:38.05,Default,,0,0,0,,Жүкті оң жақта ұстап алды!
Dialogue: 0,1:16:38.63,1:16:40.05,Default,,0,0,0,,30 градус!
Dialogue: 0,1:16:42.43,1:16:44.39,Default,,0,0,0,,О, мен оны көріп тұрмын.
Dialogue: 0,1:16:44.93,1:16:46.51,Default,,0,0,0,,Қалқанды тазалаңыз
Dialogue: 0,1:16:46.60,1:16:48.27,Default,,0,0,0,,Іске асыру дисплейі басталады
Dialogue: 0,1:16:56.65,1:16:59.32,Default,,0,0,0,,Изумруд! Айналадағы жауды соңғы іздеуді орындаңыз.
Dialogue: 0,1:16:59.40,1:17:00.40,Default,,0,0,0,,Польнарефф?
Dialogue: 0,1:17:03.61,1:17:04.62,Default,,0,0,0,,Жоғарғы сол жақта!
Dialogue: 0,1:17:05.41,1:17:07.12,Default,,0,0,0,,Не ұшады?
Dialogue: 0,1:17:07.20,1:17:08.24,Default,,0,0,0,,Мысал?
Dialogue: 0,1:17:08.33,1:17:09.83,Default,,0,0,0,,Мүмкін
Dialogue: 0,1:17:09.91,1:17:11.75,Default,,0,0,0,,Раймонд! Жау келе жатыр!
Dialogue: 0,1:17:12.33,1:17:13.25,Default,,0,0,0,,Бар, Эме!
Dialogue: 0,1:17:17.92,1:17:18.75,Default,,0,0,0,,Фу…
Dialogue: 0,1:17:21.84,1:17:23.01,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:28.64,1:17:30.02,Default,,0,0,0,,Ха!
Dialogue: 0,1:17:30.52,1:17:31.35,Default,,0,0,0,,Ха…
Dialogue: 0,1:17:36.69,1:17:37.98,Default,,0,0,0,,Мен мұны қайталай алмаймын!
Dialogue: 0,1:17:38.57,1:17:40.61,Default,,0,0,0,,Мен қандай да бір зақым келтіруге қарсы емеспін. Соқтығыс!
Dialogue: 0,1:17:40.69,1:17:42.61,Default,,0,0,0,,Менің айтқым келгені осы!
Dialogue: 0,1:17:46.70,1:17:49.53,Default,,0,0,0,,Бұл келе жатыр! Оны машиналарға қалдырмаңыз
Dialogue: 0,1:17:50.16,1:17:51.54,Default,,0,0,0,,Жасап жатырмыз!
Dialogue: 0,1:17:54.62,1:17:59.04,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:18:00.84,1:18:02.13,Default,,0,0,0,,Ха! Ах...
Dialogue: 0,1:18:13.73,1:18:14.56,Default,,0,0,0,,Уф...
Dialogue: 0,1:18:14.64,1:18:16.60,Default,,0,0,0,,Жарайсың Изумруд
Dialogue: 0,1:18:16.69,1:18:18.36,Default,,0,0,0,,Кешіріңіз, ha...
Dialogue: 0,1:18:28.07,1:18:30.41,Default,,0,0,0,,Бұл жағдайға не себеп болды?
Dialogue: 0,1:18:30.49,1:18:32.08,Default,,0,0,0,,Бұл менің тәттілігім
Dialogue: 0,1:18:32.95,1:18:35.12,Default,,0,0,0,,Анахаймнан оралу
Dialogue: 0,1:18:35.21,1:18:37.87,Default,,0,0,0,,･
Dialogue: 0,1:18:38.96,1:18:42.38,Default,,0,0,0,,...
Dialogue: 0,1:18:42.46,1:18:45.05,Default,,0,0,0,,Өйткені мен бас тарта алмадым
Dialogue: 0,1:18:45.97,1:18:49.93,Default,,0,0,0,,Бұл енді барлығына қауіп төндіреді.
Dialogue: 0,1:18:54.43,1:18:56.48,Default,,0,0,0,,Дұрыс, Quess.
Dialogue: 0,1:18:57.48,1:19:01.77,Default,,0,0,0,,...
Dialogue: 0,1:19:02.52,1:19:03.90,Default,,0,0,0,,Мен оны өзгертемін
Dialogue: 0,1:19:04.78,1:19:07.40,Default,,0,0,0,,･･
Dialogue: 0,1:19:11.49,1:19:13.12,Default,,0,0,0,,Көбіне жалғыз
Dialogue: 0,1:19:13.20,1:19:14.87,Default,,0,0,0,,ΞG
Dialogue: 0,1:19:19.46,1:19:22.54,Default,,0,0,0,,150
Dialogue: 0,1:19:22.63,1:19:23.55,Default,,0,0,0,,Жолақ тобы туралы не деуге болады?
Dialogue: 0,1:19:23.63,1:19:25.71,Default,,0,0,0,,Халмахерадан солтүстікке қарай 200 км
Dialogue: 0,1:19:25.80,1:19:28.80,Default,,0,0,0,,Байланысқа түсу ықтималдығы аз.
Dialogue: 0,1:19:29.47,1:19:31.97,Default,,0,0,0,,...
Dialogue: 0,1:19:32.05,1:19:34.26,Default,,0,0,0,,Lane Squad-пен байланысуды жалғастырыңыз!
Dialogue: 0,1:19:34.35,1:19:35.52,Default,,0,0,0,,Бұл ол...
Dialogue: 0,1:19:37.02,1:19:38.56,Default,,0,0,0,,...
Dialogue: 0,1:19:40.06,1:19:42.02,Default,,0,0,0,,Егер солай болса
Dialogue: 0,1:19:42.11,1:19:45.32,Default,,0,0,0,,･･
Dialogue: 0,1:19:47.24,1:19:48.86,Default,,0,0,0,,Бұл да мүфтидің ісі ме?
Dialogue: 0,1:19:48.95,1:19:50.24,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,1:19:50.82,1:19:53.58,Default,,0,0,0,,...
Dialogue: 0,1:20:01.50,1:20:03.17,Default,,0,0,0,,Мен оны кесіп тастаймын
Dialogue: 0,1:20:03.67,1:20:05.75,Default,,0,0,0,,Адамдардың біртүрлі қарым-қатынастары да
Dialogue: 0,1:20:05.84,1:20:07.05,Default,,0,0,0,,Гиги Андалусия да!
Dialogue: 0,1:20:13.01,1:20:14.01,Default,,0,0,0,,Фу…
Dialogue: 0,1:20:20.10,1:20:22.10,Default,,0,0,0,,…
Dialogue: 0,1:20:24.19,1:20:25.19,Default,,0,0,0,,Уф...
Dialogue: 0,1:20:27.11,1:20:28.19,Default,,0,0,0,,Мен жеңілдім!
Dialogue: 0,1:20:42.58,1:20:46.29,Default,,0,0,0,,Сіз дайын болған кезде, Қасқыр қырғыш келмейді.
Dialogue: 0,1:20:46.38,1:20:47.59,Default,,0,0,0,,...
Dialogue: 0,1:20:47.67,1:20:48.63,Default,,0,0,0,,Ха!
Dialogue: 0,1:20:49.67,1:20:51.05,Default,,0,0,0,,Тіпті айтпай-ақ!
Dialogue: 0,1:20:58.72,1:20:59.64,Default,,0,0,0,,Бұл екпінді!
Dialogue: 0,1:21:00.39,1:21:01.89,Default,,0,0,0,,Бұл Джиджи үшін бе?
Dialogue: 0,1:21:03.27,1:21:04.27,Default,,0,0,0,,Теңіз!
Dialogue: 0,1:21:04.90,1:21:05.73,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:17.24,1:21:19.24,Default,,0,0,0,,Қазір кетпесек, Ерлік те қатысады.
Dialogue: 0,1:21:22.04,1:21:23.67,Default,,0,0,0,,Кез келген нәрсе болуы мүмкін.
Dialogue: 0,1:21:32.17,1:21:33.01,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:21:42.43,1:21:43.52,Default,,0,0,0,,Не!
Dialogue: 0,1:21:45.15,1:21:46.06,Default,,0,0,0,,Әй!
Dialogue: 0,1:21:48.82,1:21:49.82,Default,,0,0,0,,…
Dialogue: 0,1:21:49.90,1:21:50.82,Default,,0,0,0,,!?
Dialogue: 0,1:21:50.90,1:21:54.07,Default,,0,0,0,,...
Dialogue: 0,1:21:54.15,1:21:55.03,Default,,0,0,0,,Бұл Гундам!
Dialogue: 0,1:21:57.37,1:21:59.45,Default,,0,0,0,,Миновский рейсі!?
Dialogue: 0,1:21:59.53,1:22:01.41,Default,,0,0,0,,Мені қума! мақсатты болу
Dialogue: 0,1:22:01.49,1:22:02.79,Default,,0,0,0,,Мені мазақ ет!
Dialogue: 0,1:22:08.29,1:22:09.38,Default,,0,0,0,,Осыншама!
Dialogue: 0,1:22:09.46,1:22:10.30,Default,,0,0,0,,Гах...
Dialogue: 0,1:22:12.80,1:22:13.80,Default,,0,0,0,,Мұқият қараңыз!
Dialogue: 0,1:22:13.88,1:22:14.51,Default,,0,0,0,,…
Dialogue: 0,1:22:14.51,1:22:15.26,Default,,0,0,0,,…
Dialogue: 0,1:22:14.51,1:22:15.26,Default,,0,0,0,,(Ескерту)
Dialogue: 0,1:22:15.26,1:22:15.34,Default,,0,0,0,,(Ескерту)
Dialogue: 0,1:22:15.34,1:22:16.18,Default,,0,0,0,,(Ескерту)
Dialogue: 0,1:22:15.34,1:22:16.18,Default,,0,0,0,,(Танжиро) Уф… (Барабан соғу дыбысы)
Dialogue: 0,1:22:16.76,1:22:18.18,Default,,0,0,0,,...
Dialogue: 0,1:22:18.26,1:22:19.60,Default,,0,0,0,,Енді бұлайша оңай болмайды.
Dialogue: 0,1:23:05.23,1:23:06.06,Default,,0,0,0,,Хмм!
Dialogue: 0,1:23:13.02,1:23:15.57,Default,,0,0,0,,Аяғымнан айырылдым Порт жағындағы шағын аралға түсіңіз
Dialogue: 0,1:23:16.86,1:23:17.82,Default,,0,0,0,,Әрі қарай не болады?
Dialogue: 0,1:23:17.90,1:23:18.70,Default,,0,0,0,,(Ескерту)
Dialogue: 0,1:23:18.70,1:23:20.32,Default,,0,0,0,,(Ескерту)
Dialogue: 0,1:23:18.70,1:23:20.32,Default,,0,0,0,,Ха... Лайн?!
Dialogue: 0,1:23:35.76,1:23:38.38,Default,,0,0,0,,Мүфти тіпті Гундамның көшірмесін өзімен бірге ала ма?
Dialogue: 0,1:23:38.47,1:23:39.47,Default,,0,0,0,,...
Dialogue: 0,1:23:39.55,1:23:40.76,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,1:23:40.84,1:23:42.26,Default,,0,0,0,,Гауман!?
Dialogue: 0,1:23:45.39,1:23:47.93,Default,,0,0,0,,...
Dialogue: 0,1:23:48.02,1:23:49.10,Default,,0,0,0,,Жауап беріңіз!
Dialogue: 0,1:23:49.19,1:23:52.11,Default,,0,0,0,,Бұл қалқан! Жоқ, мен...
Dialogue: 0,1:23:52.19,1:23:54.02,Default,,0,0,0,,...
Dialogue: 0,1:23:54.11,1:23:54.94,Default,,0,0,0,,Ха…
Dialogue: 0,1:23:55.03,1:23:55.98,Default,,0,0,0,,Мәселе жоқ!
Dialogue: 0,1:23:56.07,1:23:58.99,Default,,0,0,0,,Осы жаңа үлгіні тоқтатыңыз!
Dialogue: 0,1:23:59.07,1:24:00.49,Default,,0,0,0,,...
Dialogue: 0,1:24:00.57,1:24:02.53,Default,,0,0,0,,Жолды мақсат етіңіз!
Dialogue: 0,1:24:02.62,1:24:04.45,Default,,0,0,0,,...
Dialogue: 0,1:24:05.04,1:24:06.66,Default,,0,0,0,,...
Dialogue: 0,1:24:06.75,1:24:08.71,Default,,0,0,0,,!?
Dialogue: 0,1:24:08.79,1:24:10.04,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,1:24:10.12,1:24:12.17,Default,,0,0,0,,...
Dialogue: 0,1:24:20.59,1:24:23.01,Default,,0,0,0,,Шақыру... немесе
Dialogue: 0,1:24:28.35,1:24:29.35,Default,,0,0,0,,Әй!
Dialogue: 0,1:24:29.43,1:24:30.27,Default,,0,0,0,,Жолақ мақсаты
Dialogue: 0,1:24:31.23,1:24:32.77,Default,,0,0,0,,Таза адам
Dialogue: 0,1:24:33.56,1:24:34.56,Default,,0,0,0,,Гауман!
Dialogue: 0,1:24:56.17,1:24:57.00,Default,,0,0,0,,Айқын ғой, иә! Ақымақ!
Dialogue: 0,1:24:57.50,1:24:59.92,Default,,0,0,0,,Тозақ басталғалы тұр.
Dialogue: 0,1:25:00.01,1:25:01.67,Default,,0,0,0,,Олардың тәрбиесіне байланысты
Dialogue: 0,1:25:03.64,1:25:05.89,Default,,0,0,0,,Күткенім өкінішті емес!
Dialogue: 0,1:25:05.97,1:25:07.60,Default,,0,0,0,,Гундамға еліктеу
Dialogue: 0,1:25:24.36,1:25:27.03,Default,,0,0,0,,Мен барлығын бірден шешкім келеді. Бұл мүмкін бе?
Dialogue: 0,1:25:27.12,1:25:29.66,Default,,0,0,0,,Жасай бер, мүфти!
Dialogue: 0,1:25:31.16,1:25:32.21,Default,,0,0,0,,Неге ешкім қабырғаға өрмелеп шығуға тырыспайды?
Dialogue: 0,1:25:45.05,1:25:46.22,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:25:51.14,1:25:52.35,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,1:25:53.52,1:25:54.77,Default,,0,0,0,,Теня да батыр ма?
Dialogue: 0,1:26:00.02,1:26:01.15,Default,,0,0,0,,Фу…
Dialogue: 0,1:26:06.91,1:26:07.74,Default,,0,0,0,,Уф...
Dialogue: 0,1:26:12.66,1:26:13.50,Default,,0,0,0,,Уф...
Dialogue: 0,1:26:40.52,1:26:41.77,Default,,0,0,0,,Уф...
Dialogue: 0,1:26:45.28,1:26:47.53,Default,,0,0,0,,Тірі!
Dialogue: 0,1:26:47.61,1:26:48.78,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:26:53.16,1:26:54.25,Default,,0,0,0,,Хмм...
Dialogue: 0,1:26:55.50,1:26:57.71,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,1:26:57.79,1:26:59.46,Default,,0,0,0,,Ол да құлаған болуы керек.
Dialogue: 0,1:27:30.28,1:27:32.74,Default,,0,0,0,,Ол соңғы соққыны беруі керек еді.
Dialogue: 0,1:27:50.97,1:27:53.30,Default,,0,0,0,,Лейн қауіпсіз болды ма?
Dialogue: 0,1:27:54.14,1:27:57.81,Default,,0,0,0,,Ұшақтың қаншалықты зақымданғанын ескерсек, оның аман қалуы ғажап.
Dialogue: 0,1:27:59.14,1:28:01.73,Default,,0,0,0,,Ақыр соңында, сіз сәттілік құдайысыз.
Dialogue: 0,1:28:02.73,1:28:05.15,Default,,0,0,0,,Иә? Мен оны білмеймін, бірақ
Dialogue: 0,1:28:06.86,1:28:11.36,Default,,0,0,0,,Сіздің жалғыз өмір сүре алғаныңыз сіздің сәттілікке ие екендігіңіздің дәлелі.
Dialogue: 0,1:28:11.45,1:28:13.78,Default,,0,0,0,,Бірақ менің де жоспарым бар.
Dialogue: 0,1:28:14.99,1:28:17.79,Default,,0,0,0,,Мен графты аяймын.
Dialogue: 0,1:28:17.87,1:28:21.12,Default,,0,0,0,,Иә? Гонконг? Ах...
Dialogue: 0,1:28:23.21,1:28:26.17,Default,,0,0,0,,Адамдардың әрқашан міндеттері болады.
Dialogue: 0,1:28:27.17,1:28:29.34,Default,,0,0,0,,Иә, бұл міндетті.
Dialogue: 0,1:28:29.42,1:28:33.09,Default,,0,0,0,,Өмір сүру қиын нәрсе.
Dialogue: 0,1:28:35.68,1:28:39.10,Default,,0,0,0,,Мен өмірге онша үйір емеспін.
Dialogue: 0,1:28:40.44,1:28:41.98,Default,,0,0,0,,Мен
Dialogue: 0,1:29:13.72,1:29:15.97,Default,,0,0,0,,О! Жарайсың Хэтэуэй!
Dialogue: 0,1:29:16.05,1:29:19.14,Default,,0,0,0,,Юлия! Мен алдымен керек-жарақтарымды ретке келтіруім керек.
Dialogue: 0,1:29:20.56,1:29:22.14,Default,,0,0,0,,…Көп
Dialogue: 0,1:29:24.10,1:29:25.90,Default,,0,0,0,,Менде винтовка жоқ.
Dialogue: 0,1:29:25.98,1:29:28.07,Default,,0,0,0,,Мен оны муляж ретінде қолдандым.
Dialogue: 0,1:29:28.15,1:29:30.53,Default,,0,0,0,,Мен Пенелопа мені атып тастады.
Dialogue: 0,1:29:30.61,1:29:32.03,Default,,0,0,0,,Қалай?
Dialogue: 0,1:29:32.11,1:29:35.24,Default,,0,0,0,,Мен винтовкадан оқ атып, ұшып жібердім.
Dialogue: 0,1:29:35.32,1:29:38.03,Default,,0,0,0,,Бағыт өзгерді, соғып кете жаздадым.
Dialogue: 0,1:29:38.12,1:29:41.50,Default,,0,0,0,,Егер сен оны ұрып-соғып істемегенде, мен өлетін едім.
Dialogue: 0,1:29:41.58,1:29:42.87,Default,,0,0,0,,Сәлем Хэтэуэй
Dialogue: 0,1:29:42.96,1:29:44.17,Default,,0,0,0,,Ол қозғалмайды!
Dialogue: 0,1:29:44.25,1:29:46.58,Default,,0,0,0,,Қандай керемет!
Dialogue: 0,1:29:46.67,1:29:49.75,Default,,0,0,0,,...Қосалқы теңіз түбінде шығар.
Dialogue: 0,1:29:50.25,1:29:51.51,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:29:51.59,1:29:53.84,Default,,0,0,0,,Бірінші болып капитанның ұшағы көзделеді.
Dialogue: 0,1:29:53.93,1:29:56.26,Default,,0,0,0,,Жоқ! Мен оны Хэтэуэй-ден алдым.
Dialogue: 0,1:29:58.10,1:30:01.56,Default,,0,0,0,,Егер менде бәрі жақсы болса, мен бірден Оенберриге барамын.
Dialogue: 0,1:30:01.64,1:30:02.89,Default,,0,0,0,,Мен білемін.
Dialogue: 0,1:30:03.68,1:30:04.56,Default,,0,0,0,,Бұл...
Dialogue: 0,1:30:04.64,1:30:07.77,Default,,0,0,0,,Әрине! Капитан да осылай ойлап отыр.
Dialogue: 0,1:30:08.27,1:30:10.48,Default,,0,0,0,,Мен Максимилианнан барын салуын өтінемін.
Dialogue: 0,1:30:10.57,1:30:11.90,Default,,0,0,0,,Әй... Әй!
Dialogue: 0,1:30:11.98,1:30:15.53,Default,,0,0,0,,Максимилианның жұмысында мәселе бар, солай емес пе?
Dialogue: 0,1:30:15.61,1:30:17.20,Default,,0,0,0,,Ξ үшін ауыстыру бөлшектері
Dialogue: 0,1:30:17.28,1:30:19.87,Default,,0,0,0,,Оның жартысы ғана табылып, батып кетті.
Dialogue: 0,1:30:19.95,1:30:21.79,Default,,0,0,0,,Ах... Керия
Dialogue: 0,1:30:22.70,1:30:24.16,Default,,0,0,0,,Сіз қосылдыңыз ба?
Dialogue: 0,1:30:24.25,1:30:25.79,Default,,0,0,0,,Гонконгтан ораласыз ба?
Dialogue: 0,1:30:25.87,1:30:28.75,Default,,0,0,0,,Ғарыштан оралғаннан гөрі оңайырақ.
Dialogue: 0,1:30:29.79,1:30:31.25,Default,,0,0,0,,Фу…
Dialogue: 0,1:30:32.84,1:30:34.26,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,1:30:35.34,1:30:38.89,Default,,0,0,0,,Хэтэуэйдің әкесі әлі де әскери қызметте, солай ма?
Dialogue: 0,1:30:38.97,1:30:41.43,Default,,0,0,0,,Ата-ана мен бала бірдей бола алмайды
Dialogue: 0,1:30:41.51,1:30:42.97,Default,,0,0,0,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,1:30:43.60,1:30:47.10,Default,,0,0,0,,Жолым болса көремін дейді полковник.
Dialogue: 0,1:30:47.69,1:30:49.73,Default,,0,0,0,,Мен осында 2-3 күн боламын.
Dialogue: 0,1:30:49.81,1:30:50.94,Default,,0,0,0,,Мұны орындаңыз.
Dialogue: 0,1:30:52.32,1:30:54.78,Default,,0,0,0,,Бұл қызықтырақ болуы мүмкін
Dialogue: 0,1:30:56.90,1:30:58.41,Default,,0,0,0,,Талап етілмеген елу миллиардты қайтарып алу үшін.
Dialogue: 0,1:31:00.87,1:31:05.87,Default,,0,0,0,,♪~
Dialogue: 0,1:35:09.37,1:35:14.37,Default,,0,0,0,,~♪
Dialogue: 0,1:35:20.71,1:35:23.00,Default,,0,0,0,,Австралия материгінің солтүстік аймағы
Dialogue: 0,1:35:23.09,1:35:24.59,Default,,0,0,0,,Оенберг Екі күн бұрын...
Dialogue: 0,1:35:26.09,1:35:32.09,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory