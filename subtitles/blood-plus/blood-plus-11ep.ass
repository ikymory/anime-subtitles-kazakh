Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.03,0:00:21.62,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:00:34.88,0:00:36.59,Default,,0,0,0,,Фантом…
Dialogue: 0,0:00:37.10,0:00:38.47,Default,,0,0,0,,Әй, Сая!
Dialogue: 0,0:00:38.97,0:00:41.06,Default,,0,0,0,,Қайсысы жақсы?
Dialogue: 0,0:00:41.14,0:00:43.18,Default,,0,0,0,,Мен мұны жақсы көремін.
Dialogue: 0,0:00:43.27,0:00:46.27,Default,,0,0,0,,Анда-санда батыл болған жақсы
Dialogue: 0,0:00:46.35,0:00:48.69,Default,,0,0,0,,А, мен абдырап қалдым.
Dialogue: 0,0:00:49.11,0:00:50.40,Default,,0,0,0,,Не болды? ол
Dialogue: 0,0:00:50.48,0:00:52.40,Default,,0,0,0,,Не? Жоқ Сайо
Dialogue: 0,0:00:52.49,0:00:54.07,Default,,0,0,0,,Бүгін би кешінің күні болса да
Dialogue: 0,0:00:55.03,0:00:56.24,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:00:56.32,0:00:58.41,Default,,0,0,0,,Сая қандай көйлек киеді?
Dialogue: 0,0:00:59.20,0:01:01.04,Default,,0,0,0,,Менде жоқ
Dialogue: 0,0:01:02.25,0:01:04.66,Default,,0,0,0,,Олай болса мен саған қарызға беремін.
Dialogue: 0,0:01:06.00,0:01:06.83,Default,,0,0,0,,Қайсысы жақсы?
Dialogue: 0,0:01:07.08,0:01:07.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:08.63,0:01:10.25,Default,,0,0,0,,Жоқ... жарайды.
Dialogue: 0,0:01:10.75,0:01:12.34,Default,,0,0,0,,Ластанса жаман.
Dialogue: 0,0:01:13.97,0:01:14.88,Default,,0,0,0,,Сәлем Сая
Dialogue: 0,0:01:19.01,0:01:22.27,Default,,0,0,0,,Ханойда не болғанын білмеймін.
Dialogue: 0,0:01:22.47,0:01:23.68,Default,,0,0,0,,Көңіліңізді көтеріңіз
Dialogue: 0,0:01:23.77,0:01:24.60,Default,,0,0,0,,Мин…
Dialogue: 0,0:01:25.14,0:01:28.90,Default,,0,0,0,,Сайо күлгенде сүйкімдірек.
Dialogue: 0,0:01:29.36,0:01:30.23,Default,,0,0,0,,Эй!
Dialogue: 0,0:01:31.15,0:01:33.03,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:01:34.61,0:01:37.61,Default,,0,0,0,,Ендеше бүгін көңілді өткізейік.
Dialogue: 0,0:01:37.70,0:01:38.53,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:01:40.12,0:01:41.62,Default,,0,0,0,,Бұл кеш!
Dialogue: 0,0:01:42.41,0:01:48.42,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:09.83,0:03:15.84,Default,,0,0,0,,~♪
Dialogue: 0,0:03:35.82,0:03:38.28,Default,,0,0,0,,Қызық, фантом бүгін кешке шығады ма?
Dialogue: 0,0:03:38.61,0:03:41.74,Default,,0,0,0,,Мүмкін ол әлі де бір жерден қарап тұрған шығар.
Dialogue: 0,0:03:42.16,0:03:45.20,Default,,0,0,0,,Би кешінде кенеттен фантом пайда болады!
Dialogue: 0,0:03:45.45,0:03:48.87,Default,,0,0,0,,Әй, соны ойласам жүрегім лүпілдеп барады!
Dialogue: 0,0:03:48.95,0:03:50.25,Default,,0,0,0,,Эй, Сая ше?
Dialogue: 0,0:03:50.33,0:03:52.58,Default,,0,0,0,,Киімді ауыстыру көп уақытты алады.
Dialogue: 0,0:03:52.67,0:03:54.75,Default,,0,0,0,,Менің ойымша, бұл жақында келеді.
Dialogue: 0,0:03:54.96,0:03:56.92,Default,,0,0,0,,Ах! Сая
Dialogue: 0,0:03:57.21,0:03:58.55,Default,,0,0,0,,Мұнда!
Dialogue: 0,0:04:01.55,0:04:02.43,Default,,0,0,0,,Сая?
Dialogue: 0,0:04:02.51,0:04:05.30,Default,,0,0,0,,Қараңдаршы, сол елес маған көк раушан гүлін сыйлады...
Dialogue: 0,0:04:05.51,0:04:07.81,Default,,0,0,0,,Иә, бұл бала?
Dialogue: 0,0:04:10.89,0:04:12.73,Default,,0,0,0,,Сая! Кеш болды, солай емес пе?
Dialogue: 0,0:04:12.98,0:04:14.98,Default,,0,0,0,,Бұл біраз ұят болуы мүмкін.
Dialogue: 0,0:04:15.06,0:04:18.32,Default,,0,0,0,,Иә? Неліктен? Саған өте жарасады
Dialogue: 0,0:04:18.65,0:04:21.19,Default,,0,0,0,,Мен өзімді дұрыс киінгендей сезінемін.
Dialogue: 0,0:04:21.28,0:04:22.61,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:04:22.78,0:04:25.20,Default,,0,0,0,,Бәріңе сәлем.
Dialogue: 0,0:04:25.74,0:04:27.70,Default,,0,0,0,,Жақсы! Құрметті Аннамари!
Dialogue: 0,0:04:27.78,0:04:30.08,Default,,0,0,0,,Әдемі ғой.
Dialogue: 0,0:04:32.08,0:04:34.62,Default,,0,0,0,,Фантом маған көк раушан гүлін сыйлады
Dialogue: 0,0:04:34.71,0:04:37.75,Default,,0,0,0,,Мектептегі ең әдемі Сайо-сама
Dialogue: 0,0:04:37.84,0:04:40.17,Default,,0,0,0,,Көйлек сәл қарапайым емес пе?
Dialogue: 0,0:04:40.30,0:04:44.34,Default,,0,0,0,,Бұл не? Қарызға берген көйлегіме сараң боласың ба?
Dialogue: 0,0:04:44.59,0:04:46.97,Default,,0,0,0,,Бұл менің ниетім емес.
Dialogue: 0,0:04:47.47,0:04:49.56,Default,,0,0,0,,Ренжіткен болсам кешіріңіз.
Dialogue: 0,0:04:50.60,0:04:52.18,Default,,0,0,0,,Sa! кеттік
Dialogue: 0,0:04:54.60,0:04:57.23,Default,,0,0,0,,Аннамари
Dialogue: 0,0:04:57.31,0:04:59.27,Default,,0,0,0,,Бірақ әдемі
Dialogue: 0,0:04:59.36,0:05:00.94,Default,,0,0,0,,Эй Сая, қарашы!
Dialogue: 0,0:05:01.32,0:05:03.74,Default,,0,0,0,,Уау! Бұл керемет!
Dialogue: 0,0:05:04.28,0:05:06.49,Default,,0,0,0,,Бұл жыныстық тартымдылықтан гөрі тәбет туралы.
Dialogue: 0,0:05:07.66,0:05:09.08,Default,,0,0,0,,А... жоқ.
Dialogue: 0,0:05:09.53,0:05:11.58,Default,,0,0,0,,Менің көйлегім лас болуы мүмкін
Dialogue: 0,0:05:11.66,0:05:13.71,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:05:13.91,0:05:17.46,Default,,0,0,0,,Бүгін кешке той, сондықтан көңіл көтерейік!
Dialogue: 0,0:05:18.71,0:05:20.42,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:05:27.30,0:05:31.22,Default,,0,0,0,,Кешіріңіз, бірақ мен сіздің шақыруыңызды көргім келеді.
Dialogue: 0,0:05:31.31,0:05:32.97,Default,,0,0,0,,Шақыру?
Dialogue: 0,0:05:33.14,0:05:36.94,Default,,0,0,0,,Мм... Иә? Мен оны жоғалтып алдым ба?
Dialogue: 0,0:05:37.02,0:05:38.69,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:38.77,0:05:42.78,Default,,0,0,0,,Шақырусыз кез келген адамға кіруден бас тартылады.
Dialogue: 0,0:05:42.86,0:05:44.65,Default,,0,0,0,,А... жоқ, бірақ...
Dialogue: 0,0:05:45.32,0:05:47.16,Default,,0,0,0,,Арнайы сынып!
Dialogue: 0,0:05:51.70,0:05:54.66,Default,,0,0,0,,Хмм, мен не істеуім керек?
Dialogue: 0,0:05:54.75,0:05:56.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:01.09,0:06:02.34,Default,,0,0,0,,Сәлем
Dialogue: 0,0:06:03.00,0:06:07.30,Default,,0,0,0,,Cincoufleche лицейіне қош келдіңіз.
Dialogue: 0,0:06:12.81,0:06:15.56,Default,,0,0,0,,Шақыру деген сөз жоқ, солай ма?
Dialogue: 0,0:06:15.64,0:06:18.60,Default,,0,0,0,,Шикушо~ Сен адамдарға менсінбей қарайсың.
Dialogue: 0,0:06:18.69,0:06:20.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:30.32,0:06:37.33,Default,,0,0,0,,
Dialogue: 0,0:06:46.05,0:06:46.88,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:06:46.96,0:06:48.55,Default,,0,0,0,,Сәлеметсіз бе, қайырлы кеш.
Dialogue: 0,0:06:53.55,0:06:54.47,Default,,0,0,0,,Сая
Dialogue: 0,0:06:55.47,0:06:56.85,Default,,0,0,0,,Дэвид мырза
Dialogue: 0,0:06:57.14,0:06:58.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:04.07,0:07:05.02,Default,,0,0,0,,Фантом
Dialogue: 0,0:07:05.11,0:07:07.19,Default,,0,0,0,,Жоқ. Төраға Карл ше?
Dialogue: 0,0:07:07.32,0:07:09.45,Default,,0,0,0,,Мен оны бүгін әлі көрген жоқпын.
Dialogue: 0,0:07:09.57,0:07:13.87,Default,,0,0,0,,Қажы да мені бақылап тұр, бірақ әлі көрмеді.
Dialogue: 0,0:07:14.16,0:07:15.37,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:15.45,0:07:19.54,Default,,0,0,0,,Сая Ханойда сіздің бетіңізді көргендіктен келмей қалдыңыз ба?
Dialogue: 0,0:07:19.62,0:07:21.87,Default,,0,0,0,,Ах! Юлия? (Дэвид) Жоқ...
Dialogue: 0,0:07:21.96,0:07:22.88,Default,,0,0,0,,Ха...
Dialogue: 0,0:07:22.96,0:07:24.29,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:07:24.38,0:07:27.34,Default,,0,0,0,,Маған ұнамайды, өйткені ол маған мүлдем сәйкес келмейді.
Dialogue: 0,0:07:27.67,0:07:30.01,Default,,0,0,0,,Басқарма төрағасы Карл есімді адам.
Dialogue: 0,0:07:31.01,0:07:34.10,Default,,0,0,0,,Осы лицей арқылы дамытқан байланыстарыңызды барынша пайдаланыңыз
Dialogue: 0,0:07:34.18,0:07:36.81,Default,,0,0,0,,Вьетнамдағы орныққан орны
Dialogue: 0,0:07:37.43,0:07:40.35,Default,,0,0,0,,Оның мұнда көрінбеуі мүмкін емес.
Dialogue: 0,0:07:41.10,0:07:43.98,Default,,0,0,0,,Сая: Мен Карлды жоспарлағандай тапқанда.
Dialogue: 0,0:07:44.06,0:07:45.11,Default,,0,0,0,,Белгіні алып тастамаңыз
Dialogue: 0,0:07:45.90,0:07:48.15,Default,,0,0,0,,Бұл жолы мен оны міндетті түрде аяқтаймын.
Dialogue: 0,0:07:48.73,0:07:49.57,Default,,0,0,0,,Иә
Dialogue: 0,0:07:49.82,0:07:52.28,Default,,0,0,0,,Мен лицейдің жертөлесіне жасырын кіріп кеттім.
Dialogue: 0,0:07:52.36,0:07:55.12,Default,,0,0,0,,Хабарланған контейнерді тексеріңіз
Dialogue: 0,0:07:55.20,0:07:56.83,Default,,0,0,0,,Юлия, сен...
Dialogue: 0,0:07:57.58,0:07:58.95,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:02.83,0:08:04.00,Default,,0,0,0,,Қалғаны өзіңізге байланысты.
Dialogue: 0,0:08:09.88,0:08:13.30,Default,,0,0,0,,Егер бұл соншалықты қиын болса, сіз ештеңе істей алмайсыз.
Dialogue: 0,0:08:13.38,0:08:15.80,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:08:15.89,0:08:18.43,Default,,0,0,0,,Сіз өзіңізді табиғи ұстайсыз
Dialogue: 0,0:08:18.51,0:08:21.10,Default,,0,0,0,,Мен де ішін қараймын.
Dialogue: 0,0:08:21.27,0:08:23.52,Default,,0,0,0,,Бір орында тұрғанда байқалады.
Dialogue: 0,0:08:23.60,0:08:24.56,Default,,0,0,0,,Ах
Dialogue: 0,0:08:24.85,0:08:26.23,Default,,0,0,0,,Юлия...
Dialogue: 0,0:08:32.99,0:08:34.91,Default,,0,0,0,,Уау! керемет~!
Dialogue: 0,0:08:34.99,0:08:36.70,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:08:39.24,0:08:40.41,Default,,0,0,0,,Ах! Көк раушан!
Dialogue: 0,0:08:40.95,0:08:43.00,Default,,0,0,0,,Сонда ол адам елес пе?
Dialogue: 0,0:08:43.08,0:08:44.04,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:08:44.12,0:08:46.71,Default,,0,0,0,,Өйткені бұл өте керемет!
Dialogue: 0,0:08:46.79,0:08:47.63,Default,,0,0,0,,Уау
Dialogue: 0,0:08:48.09,0:08:50.09,Default,,0,0,0,,Кя~!
Dialogue: 0,0:08:50.21,0:08:51.13,Default,,0,0,0,,Сіз мені жаңа ғана көрдіңіз!
Dialogue: 0,0:08:51.21,0:08:54.01,Default,,0,0,0,,Бұл менмін! Мен де!
Dialogue: 0,0:08:56.97,0:08:58.05,Default,,0,0,0,,Фантом емес
Dialogue: 0,0:09:04.60,0:09:05.44,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:05.85,0:09:07.81,Default,,0,0,0,,Ал, Аннамариге!
Dialogue: 0,0:09:08.11,0:09:10.86,Default,,0,0,0,,Мен Аннамари-сама туралы ештеңе істей алмаймын.
Dialogue: 0,0:09:15.03,0:09:16.61,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:09:17.32,0:09:18.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:22.25,0:09:24.96,Default,,0,0,0,,Менімен билей аласыз ба?
Dialogue: 0,0:09:25.16,0:09:27.50,Default,,0,0,0,,Не? Ерм...
Dialogue: 0,0:09:27.88,0:09:29.04,Default,,0,0,0,,Оң қолыңызды шығарыңыз
Dialogue: 0,0:09:29.13,0:09:29.96,Default,,0,0,0,,А... иә
Dialogue: 0,0:09:30.29,0:09:31.92,Default,,0,0,0,,Рахмет (Сая) Уау
Dialogue: 0,0:09:33.05,0:09:34.59,Default,,0,0,0,,Эй... жай ғана.
Dialogue: 0,0:09:40.35,0:09:41.31,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:09:46.98,0:09:50.23,Default,,0,0,0,,Уау... бұл менің бірінші рет...
Dialogue: 0,0:09:50.48,0:09:52.02,Default,,0,0,0,,Мен жетекшілік етемін
Dialogue: 0,0:09:52.11,0:09:54.94,Default,,0,0,0,,Ағам да мен жақсы билейтінмін дейді.
Dialogue: 0,0:10:09.92,0:10:13.84,Default,,0,0,0,,(құлыпты ашу дыбысы)
Dialogue: 0,0:10:15.21,0:10:16.05,Default,,0,0,0,,(құлыпты ашу дыбысы)
Dialogue: 0,0:10:19.51,0:10:21.30,Default,,0,0,0,,(Кранның жұмыс дыбысы)
Dialogue: 0,0:10:30.10,0:10:31.36,Default,,0,0,0,,Сен жақсысың.
Dialogue: 0,0:10:31.86,0:10:33.65,Default,,0,0,0,,Мен бұл менің бірінші рет екеніне сене алар емеспін.
Dialogue: 0,0:10:33.94,0:10:35.94,Default,,0,0,0,,Мм... бұл рас.
Dialogue: 0,0:10:36.86,0:10:40.36,Default,,0,0,0,,Вальс ойнаған кезде серіктесіңіздің бетіне қарамаңыз
Dialogue: 0,0:10:40.66,0:10:41.70,Default,,0,0,0,,Ха...
Dialogue: 0,0:10:42.99,0:10:45.16,Default,,0,0,0,,Жетекші мініп алу дегенді білдіреді
Dialogue: 0,0:10:45.24,0:10:46.87,Default,,0,0,0,,Сен екеуміз жарасамыз.
Dialogue: 0,0:10:46.95,0:10:47.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:06.97,0:11:09.19,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:11:10.56,0:11:12.56,Default,,0,0,0,,Кешіріңіз (Сая) А?
Dialogue: 0,0:11:12.81,0:11:16.40,Default,,0,0,0,,Алғашында қыздардың қарағанына шыдай алмадым.
Dialogue: 0,0:11:16.48,0:11:19.49,Default,,0,0,0,,Өйткені сен басқа балалардан ерекшелендің.
Dialogue: 0,0:11:19.57,0:11:22.07,Default,,0,0,0,,Мен сені қиындықтан құтылу үшін шақырдым.
Dialogue: 0,0:11:22.16,0:11:23.62,Default,,0,0,0,,Бұл үшін кешірім сұраймын.
Dialogue: 0,0:11:23.70,0:11:24.53,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:11:24.78,0:11:29.21,Default,,0,0,0,,Бірақ қазір сізді шақырғаныма өте қуаныштымын.
Dialogue: 0,0:11:32.92,0:11:34.79,Default,,0,0,0,,Сіз осында болдыңыз ба?
Dialogue: 0,0:11:36.67,0:11:37.84,Default,,0,0,0,,Мен оны іздедім.
Dialogue: 0,0:11:37.92,0:11:39.09,Default,,0,0,0,,Сәлем Ван
Dialogue: 0,0:11:39.17,0:11:42.43,Default,,0,0,0,,Тағы бір ән сұрағым келеді.
Dialogue: 0,0:11:42.51,0:11:44.01,Default,,0,0,0,,Біреу мені алып кетуге келді.
Dialogue: 0,0:11:44.55,0:11:45.93,Default,,0,0,0,,Өкінішке орай...
Dialogue: 0,0:11:49.02,0:11:51.85,Default,,0,0,0,,Доптан ләззат алыңыз
Dialogue: 0,0:11:53.19,0:11:54.19,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:11:55.94,0:11:59.03,Default,,0,0,0,,Сүлеймен, сенің уақытың жоқ.
Dialogue: 0,0:11:59.11,0:12:01.53,Default,,0,0,0,,Лицейге еріксіз тоқтап үлгерсеңіз
Dialogue: 0,0:12:01.61,0:12:04.41,Default,,0,0,0,,Біздің тәжірибелеріміздің нәтижелерін де көрулеріңізді қалаймын.
Dialogue: 0,0:12:04.66,0:12:06.12,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:12:06.20,0:12:09.79,Default,,0,0,0,,Енді мен Карлмен танысқаннан кейін мұндағы жұмысым аяқталды.
Dialogue: 0,0:12:10.04,0:12:12.12,Default,,0,0,0,,Менде жақсы кездесулер болды.
Dialogue: 0,0:12:12.79,0:12:13.62,Default,,0,0,0,,Сая!
Dialogue: 0,0:12:14.92,0:12:15.92,Default,,0,0,0,,Уау
Dialogue: 0,0:12:16.63,0:12:17.71,Default,,0,0,0,,Сая?
Dialogue: 0,0:12:19.13,0:12:20.05,Default,,0,0,0,,Иә
Dialogue: 0,0:12:20.13,0:12:23.97,Default,,0,0,0,,Карл шынымен де дәрменсіз адам.
Dialogue: 0,0:12:38.65,0:12:39.98,Default,,0,0,0,,Дива
Dialogue: 0,0:12:40.78,0:12:41.99,Default,,0,0,0,,Рақмет. Кешіріңіз.
Dialogue: 0,0:12:42.74,0:12:44.36,Default,,0,0,0,,Ол жаққа көшпе!
Dialogue: 0,0:12:44.45,0:12:47.45,Default,,0,0,0,,Сенің тығылып жүргеніңді білемін, шық!
Dialogue: 0,0:12:49.03,0:12:51.04,Default,,0,0,0,,Бұл адам Фантом болды ма?
Dialogue: 0,0:12:51.12,0:12:53.83,Default,,0,0,0,,А... Мен олай ойламаймын.
Dialogue: 0,0:12:54.00,0:12:58.59,Default,,0,0,0,,Мен сені жақсы сәйкестік деп ойладым, сондықтан мен де солай ойладым.
Dialogue: 0,0:12:58.67,0:13:00.21,Default,,0,0,0,,Кешіріңіз, иә?
Dialogue: 0,0:13:00.30,0:13:02.21,Default,,0,0,0,,Аздап терлеп тұрған сияқтысың.
Dialogue: 0,0:13:02.30,0:13:04.26,Default,,0,0,0,,Көйлек дегенді қалай түсінесіңдер?
Dialogue: 0,0:13:04.34,0:13:06.89,Default,,0,0,0,,Оны тек тазалауға жібермеңіз
Dialogue: 0,0:13:06.97,0:13:08.18,Default,,0,0,0,,Ах! Бұл дұрыс!
Dialogue: 0,0:13:08.26,0:13:11.56,Default,,0,0,0,,Ақыры маған бір салқын адам келді.
Dialogue: 0,0:13:11.64,0:13:12.68,Default,,0,0,0,,Сіздерді таныстыруға рұқсат етіңіздер!
Dialogue: 0,0:13:12.77,0:13:14.27,Default,,0,0,0,,Ах Мин!
Dialogue: 0,0:13:23.74,0:13:24.86,Default,,0,0,0,,Фантом
Dialogue: 0,0:13:25.03,0:13:26.41,Default,,0,0,0,,Сая~!
Dialogue: 0,0:13:26.91,0:13:28.91,Default,,0,0,0,,Бұл кісі жай ғана...
Dialogue: 0,0:13:29.16,0:13:30.91,Default,,0,0,0,,Мин! кешіріңіз! сурет?
Dialogue: 0,0:13:31.66,0:13:33.75,Default,,0,0,0,,Сәлем! Сая?
Dialogue: 0,0:13:37.46,0:13:38.88,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:13:46.85,0:13:47.68,Default,,0,0,0,,Сая!
Dialogue: 0,0:13:48.31,0:13:49.43,Default,,0,0,0,,Юлия
Dialogue: 0,0:13:49.52,0:13:50.48,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:50.56,0:13:52.60,Default,,0,0,0,,Фантом... Фантом?
Dialogue: 0,0:13:52.69,0:13:53.65,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:57.98,0:13:58.82,Default,,0,0,0,,Қажы!
Dialogue: 0,0:14:01.24,0:14:02.28,Default,,0,0,0,,Фантом пайда болды
Dialogue: 0,0:14:02.65,0:14:03.74,Default,,0,0,0,,Менімен бірге жүр!
Dialogue: 0,0:14:11.00,0:14:11.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:12.83,0:14:14.75,Default,,0,0,0,,Мына жерде жертөлеге кіретін есік бар.
Dialogue: 0,0:14:15.04,0:14:16.08,Default,,0,0,0,,Дэвид әлі де ішінде болуы керек.
Dialogue: 0,0:14:16.17,0:14:17.00,Default,,0,0,0,,Бізге асығу керек!
Dialogue: 0,0:14:22.42,0:14:24.84,Default,,0,0,0,,Келіңіздер! Тыныш шығыңыз!
Dialogue: 0,0:14:27.47,0:14:28.64,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:14:29.22,0:14:31.60,Default,,0,0,0,,Жарайды, атуды тоқтатыңыз.
Dialogue: 0,0:14:31.85,0:14:34.14,Default,,0,0,0,,Бұл аса күдікті емес.
Dialogue: 0,0:14:34.23,0:14:37.48,Default,,0,0,0,,Тіпті жапондық Рюкю Майничи Шимбунның тілшісі
Dialogue: 0,0:14:37.56,0:14:40.07,Default,,0,0,0,,Мен лицей кешін көрсетуге келдім.
Dialogue: 0,0:14:47.20,0:14:48.91,Default,,0,0,0,,Ах! Бір минут күтіңіз!
Dialogue: 0,0:14:49.41,0:14:51.04,Default,,0,0,0,,Мен жаңа ғана адасып қалдым!
Dialogue: 0,0:14:51.12,0:14:52.87,Default,,0,0,0,,
Dialogue: 0,0:14:53.16,0:14:55.33,Default,,0,0,0,,Әй, әуре болма.
Dialogue: 0,0:14:55.79,0:14:58.29,Default,,0,0,0,,Бізде уақыт жоқ. Біз бірден кетеміз!
Dialogue: 0,0:14:59.25,0:15:00.63,Default,,0,0,0,,Хаа…
Dialogue: 0,0:15:01.96,0:15:02.80,Default,,0,0,0,,Гах...
Dialogue: 0,0:15:11.26,0:15:12.47,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:12.56,0:15:13.64,Default,,0,0,0,,Дэвид!
Dialogue: 0,0:15:14.18,0:15:15.06,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:15:15.69,0:15:16.73,Default,,0,0,0,,What... what?
Dialogue: 0,0:15:24.15,0:15:24.99,Default,,0,0,0,,(Найзағайдың гүрсілі)
Dialogue: 0,0:15:26.86,0:15:27.86,Default,,0,0,0,,Уау
Dialogue: 0,0:15:30.53,0:15:32.29,Default,,0,0,0,,Жүк көлігін шығарыңыз
Dialogue: 0,0:15:32.37,0:15:33.62,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:15:37.12,0:15:38.12,Default,,0,0,0,,Дэвид!
Dialogue: 0,0:15:39.25,0:15:40.09,Default,,0,0,0,,Дива!
Dialogue: 0,0:15:40.59,0:15:42.30,Default,,0,0,0,,Бұл диваны тасымалдайтын контейнер!
Dialogue: 0,0:15:42.38,0:15:44.05,Default,,0,0,0,,Льюиспен дереу хабарласыңыз!
Dialogue: 0,0:15:46.80,0:15:47.63,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:51.14,0:15:51.97,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:15:53.18,0:15:54.18,Default,,0,0,0,,Юлия!
Dialogue: 0,0:15:54.39,0:15:55.98,Default,,0,0,0,,Сая, қайтып кел! Льюиске...
Dialogue: 0,0:15:58.60,0:15:59.44,Default,,0,0,0,,Иә
Dialogue: 0,0:16:04.57,0:16:06.32,Default,,0,0,0,,Мынау
Dialogue: 0,0:16:06.49,0:16:07.32,Default,,0,0,0,,Сая
Dialogue: 0,0:16:07.45,0:16:10.62,Default,,0,0,0,,Жарайды, Юлия, артқа тұр.
Dialogue: 0,0:16:10.70,0:16:11.83,Default,,0,0,0,,Қажы да бар.
Dialogue: 0,0:16:15.75,0:16:16.58,Default,,0,0,0,,Иә
Dialogue: 0,0:16:33.30,0:16:37.23,Default,,0,0,0,,Мен жасамау керектігін білсем де, мен мұны істемеймін
Dialogue: 0,0:16:37.31,0:16:40.60,Default,,0,0,0,,Тыйым салынған жемістің тәттілігі осы ма?
Dialogue: 0,0:16:47.40,0:16:49.32,Default,,0,0,0,,Мен күнәларымды өтеуді қалаймын.
Dialogue: 0,0:16:52.70,0:16:54.87,Default,,0,0,0,,Ах... мен...
Dialogue: 0,0:16:54.95,0:16:55.79,Default,,0,0,0,,Не?
Dialogue: 0,0:16:56.24,0:16:57.16,Default,,0,0,0,,Қажы!
Dialogue: 0,0:17:07.05,0:17:08.80,Default,,0,0,0,,Сіз де жақсы жұмыс істеп жатырсыз.
Dialogue: 0,0:17:08.88,0:17:11.22,Default,,0,0,0,,Саяның Шевальесінен күткендей.
Dialogue: 0,0:17:11.30,0:17:12.14,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:17:17.72,0:17:18.56,Default,,0,0,0,,Қажы!
Dialogue: 0,0:17:19.48,0:17:20.31,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:20.77,0:17:21.60,Default,,0,0,0,,Сая
Dialogue: 0,0:17:25.82,0:17:26.65,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:17:29.49,0:17:30.32,Default,,0,0,0,,Хааах!
Dialogue: 0,0:17:34.49,0:17:36.74,Default,,0,0,0,,Би! Би!
Dialogue: 0,0:17:37.16,0:17:39.12,Default,,0,0,0,,Мен үшін!
Dialogue: 0,0:17:39.25,0:17:42.67,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:17:43.33,0:17:44.38,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:48.25,0:17:50.42,Default,,0,0,0,,Сол жылы тағы бір үрей басталды
Dialogue: 0,0:17:51.63,0:17:52.76,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:53.76,0:17:54.84,Default,,0,0,0,,Сайо, сен...
Dialogue: 0,0:17:57.10,0:18:00.68,Default,,0,0,0,,Сіз әлі оянған жоқсыз ба?
Dialogue: 0,0:18:00.77,0:18:01.89,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:04.40,0:18:06.02,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:09.57,0:18:10.90,Default,,0,0,0,,Дэвид
Dialogue: 0,0:18:11.24,0:18:13.11,Default,,0,0,0,,Бұл ұят, Сая.
Dialogue: 0,0:18:13.36,0:18:16.28,Default,,0,0,0,,Сіз әлі мінсіз емессіз
Dialogue: 0,0:18:16.37,0:18:17.66,Default,,0,0,0,,Сіз сол кезде
Dialogue: 0,0:18:17.74,0:18:20.33,Default,,0,0,0,,Ашу мен қайғыға толы
Dialogue: 0,0:18:20.87,0:18:23.54,Default,,0,0,0,,Ал енді сен ше?
Dialogue: 0,0:18:23.67,0:18:26.13,Default,,0,0,0,,Жай қыз
Dialogue: 0,0:18:27.09,0:18:27.96,Default,,0,0,0,,Ха...
Dialogue: 0,0:18:32.34,0:18:34.05,Default,,0,0,0,,Не?
Dialogue: 0,0:18:36.55,0:18:37.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:40.27,0:18:41.85,Default,,0,0,0,,Оны мына қараңғылықта көрсетуге бола ма?
Dialogue: 0,0:18:45.94,0:18:48.06,Default,,0,0,0,,Ха! Ооо!
Dialogue: 0,0:18:48.36,0:18:50.53,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:18:51.19,0:18:52.28,Default,,0,0,0,,Керемет
Dialogue: 0,0:18:52.65,0:18:56.41,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:18:59.12,0:19:01.49,Default,,0,0,0,,Керемет! Керемет!
Dialogue: 0,0:19:01.66,0:19:03.62,Default,,0,0,0,,Ах... Фильм фильм
Dialogue: 0,0:19:03.71,0:19:04.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:06.58,0:19:08.54,Default,,0,0,0,,Айта...
Dialogue: 0,0:19:08.96,0:19:11.17,Default,,0,0,0,,Қауіпті бола жаздады... Иә?
Dialogue: 0,0:19:18.26,0:19:20.56,Default,,0,0,0,,67 жастағы бөтелке?
Dialogue: 0,0:19:23.14,0:19:23.98,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:27.23,0:19:29.90,Default,,0,0,0,,Бұл жақсы қылышшы, Сая.
Dialogue: 0,0:19:30.19,0:19:33.74,Default,,0,0,0,,Бірақ сен әлі оянған жоқсың.
Dialogue: 0,0:19:34.36,0:19:36.11,Default,,0,0,0,,Бүгін кеш кеш
Dialogue: 0,0:19:36.20,0:19:38.95,Default,,0,0,0,,Мен сенімен билей алмағаныма өкінемін.
Dialogue: 0,0:19:39.03,0:19:42.74,Default,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:19:43.12,0:19:45.50,Default,,0,0,0,,Жақында кездескенше.
Dialogue: 0,0:19:45.58,0:19:49.33,Default,,0,0,0,,Сол кезде міндетті түрде бір ән айтып, биге серік болсын.
Dialogue: 0,0:19:50.50,0:19:54.17,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:19:54.71,0:19:56.67,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:19:58.43,0:19:59.76,Default,,0,0,0,,Фантом…
Dialogue: 0,0:20:00.55,0:20:06.39,Default,,0,0,0,,(Музыка алыста ойналады)
Dialogue: 0,0:20:06.77,0:20:07.69,Default,,0,0,0,,Тамақтану керек пе?
Dialogue: 0,0:20:08.31,0:20:09.23,Default,,0,0,0,,Иә
Dialogue: 0,0:20:11.19,0:20:14.78,Default,,0,0,0,,Дұрыс, тезірек көлікті собордың алдына апарыңыз.
Dialogue: 0,0:20:14.86,0:20:16.90,Default,,0,0,0,,Бірінші шыққан жүк көлігінің соңынан жүріңіз
Dialogue: 0,0:20:16.99,0:20:18.36,Default,,0,0,0,,Асығыңыз! (операция дыбысы)
Dialogue: 0,0:20:19.41,0:20:20.24,Default,,0,0,0,,Сая!
Dialogue: 0,0:20:22.62,0:20:25.58,Default,,0,0,0,,Қазірдің өзінде! Сая, қайда болдың?
Dialogue: 0,0:20:26.62,0:20:27.62,Default,,0,0,0,,А...
Dialogue: 0,0:20:35.13,0:20:36.21,Default,,0,0,0,,Мин…
Dialogue: 0,0:20:38.88,0:20:41.22,Default,,0,0,0,,Не істеп жатырсың, Сая! Асығыңыз!
Dialogue: 0,0:20:44.68,0:20:45.81,Default,,0,0,0,,Сая
Dialogue: 0,0:20:49.89,0:20:51.23,Default,,0,0,0,,Сая...
Dialogue: 0,0:20:51.35,0:20:52.48,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:21:05.83,0:21:08.58,Default,,0,0,0,,Мысалдағы контейнерді тасымалдайтын жүк көлігі.
Dialogue: 0,0:21:08.87,0:21:10.62,Default,,0,0,0,,Байланыс қызметкерінің айтуы бойынша
Dialogue: 0,0:21:10.71,0:21:14.04,Default,,0,0,0,,Олар Лаосқа апаратын өзенге көтеріліп бара жатқан қайыққа отырса керек.
Dialogue: 0,0:21:14.13,0:21:14.96,Default,,0,0,0,,Өзен?
Dialogue: 0,0:21:15.25,0:21:17.76,Default,,0,0,0,,Thanks Fresh дәріханасының жоғарғы жағы
Dialogue: 0,0:21:17.84,0:21:19.88,Default,,0,0,0,,Тәжірибелік шаруашылық бар көрінеді.
Dialogue: 0,0:21:19.97,0:21:23.72,Default,,0,0,0,,Француз отаршылдық дәуіріндегі плантацияның қалдығы.
Dialogue: 0,0:21:24.22,0:21:25.39,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:25.47,0:21:26.76,Default,,0,0,0,,Сол контейнер
Dialogue: 0,0:21:26.85,0:21:30.44,Default,,0,0,0,,«Джоэлдің күнделігінде» жазылғанға сәйкес келеді
Dialogue: 0,0:21:31.14,0:21:32.69,Default,,0,0,0,,Штабтан қолдау сұрау
Dialogue: 0,0:21:33.19,0:21:35.90,Default,,0,0,0,,Тірекпен кездескенде өзенге көтерілеміз.
Dialogue: 0,0:21:36.27,0:21:37.94,Default,,0,0,0,,Джунгли круизі? (операция дыбысы)
Dialogue: 0,0:21:38.03,0:21:39.86,Default,,0,0,0,,Мен шыдай алмаймын.
Dialogue: 0,0:21:39.94,0:21:41.32,Default,,0,0,0,,Міне, Давид
Dialogue: 0,0:21:41.40,0:21:43.45,Default,,0,0,0,,Диваның контейнері расталды.
Dialogue: 0,0:21:43.57,0:21:45.33,Default,,0,0,0,,Орындаушы топқа қолдау көрсету
Dialogue: 0,0:21:46.62,0:21:47.91,Default,,0,0,0,,Шұғыл сұрау
Dialogue: 0,0:21:50.46,0:21:51.79,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:52.54,0:21:53.62,Default,,0,0,0,,Мин…
Dialogue: 0,0:21:56.42,0:22:02.43,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:19.04,0:23:25.05,Default,,0,0,0,,~♪
Dialogue: 0,0:23:28.68,0:23:30.05,Default,,0,0,0,,Дельта 67
Dialogue: 0,0:23:30.97,0:23:33.18,Default,,0,0,0,,Бұл өнім мен сатуға тырысамын
Dialogue: 0,0:23:34.06,0:23:36.48,Default,,0,0,0,,Сіз келесі қадамға келе жатсаңыз да
Dialogue: 0,0:23:36.56,0:23:39.19,Default,,0,0,0,,Сүлейменді мүлде қызықтырмайтын сияқты.
Dialogue: 0,0:23:39.90,0:23:41.15,Default,,0,0,0,,Ол шынымен де қиналған адам.
Dialogue: 0,0:23:42.23,0:23:46.78,Default,,0,0,0,,Менің ойымша, сіз мені тағы біраз бақылап отырсаңыз жақсы болар еді.
Dialogue: 0,0:23:47.53,0:23:49.57,Default,,0,0,0,,Next time “Blood Plus”
Dialogue: 0,0:23:49.66,0:23:51.83,Default,,0,0,0,,«Ақ тұман тиді»
Dialogue: 0,0:23:52.24,0:23:53.33,Default,,0,0,0,,Өрік хош иісі
Dialogue: 0,0:23:53.41,0:23:55.04,Default,,0,0,0,,Сен де мұны қалайсың ба?
Dialogue: 0,0:23:56.54,0:24:02.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory