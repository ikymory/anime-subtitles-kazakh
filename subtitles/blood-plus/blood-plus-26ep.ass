Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.47,0:00:15.36,Default,,0,0,0,,Эй, Сайо-ни-чан ше?
Dialogue: 0,0:00:15.81,0:00:17.86,Default,,0,0,0,,Ол өз бөлмесінде демалып жатқан жоқ па?
Dialogue: 0,0:00:19.07,0:00:21.66,Default,,0,0,0,,Мен Сайо-ничанмен танысқым келеді.
Dialogue: 0,0:00:21.74,0:00:23.75,Default,,0,0,0,,Жоқ, менде әлі сынақтар қалды.
Dialogue: 0,0:00:24.16,0:00:25.67,Default,,0,0,0,,Бірақ! (есіктің автоматты ашылған дыбысы)
Dialogue: 0,0:00:25.79,0:00:26.79,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:26.88,0:00:27.71,Default,,0,0,0,,Йо
Dialogue: 0,0:00:28.76,0:00:31.10,Default,,0,0,0,,Не... Кай-нии-чан
Dialogue: 0,0:00:31.64,0:00:33.27,Default,,0,0,0,,«Нан» жоқ, солай ма?
Dialogue: 0,0:00:33.35,0:00:34.18,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:00:34.85,0:00:37.27,Default,,0,0,0,,Сая болса, жақын арада кездесеміз, солай ма?
Dialogue: 0,0:00:37.36,0:00:39.53,Default,,0,0,0,,Оның орнына, оны дұрыс тексеріп алыңыз.
Dialogue: 0,0:00:39.61,0:00:41.70,Default,,0,0,0,,Сіз бүкіл уақыт бойы ұйықтадыңыз.
Dialogue: 0,0:00:41.95,0:00:44.12,Default,,0,0,0,,Мені жалғыз қалдырыңыз.
Dialogue: 0,0:00:45.62,0:00:46.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:49.80,0:00:56.44,Default,,0,0,0,,(тұлыптың жыртылған дыбысы)
Dialogue: 0,0:01:04.24,0:01:05.92,Default,,0,0,0,,Сәлем Джеймс
Dialogue: 0,0:01:06.00,0:01:08.59,Default,,0,0,0,,Әншел-нии-сан туралы.
Dialogue: 0,0:01:09.00,0:01:13.51,Default,,0,0,0,,Сіз бізден бірдеңе жасырып тұрғандай сезінбейсіз бе?
Dialogue: 0,0:01:15.06,0:01:18.44,Default,,0,0,0,,Сіз кездескен белгісіз жауды айтасыз ба?
Dialogue: 0,0:01:19.07,0:01:19.90,Default,,0,0,0,,Иә
Dialogue: 0,0:01:24.12,0:01:27.08,Default,,0,0,0,,Бұл сөзсіз қанатты адам.
Dialogue: 0,0:01:27.50,0:01:30.17,Default,,0,0,0,,Бұл да бізге Шевальерлерге ұқсайды.
Dialogue: 0,0:01:30.59,0:01:32.01,Default,,0,0,0,,Сүлеймен
Dialogue: 0,0:01:32.09,0:01:35.43,Default,,0,0,0,,Арамызда шығарылған шешімге бағынбадың.
Dialogue: 0,0:01:35.52,0:01:38.31,Default,,0,0,0,,Саяны көндіруге барғаныңызды естідім.
Dialogue: 0,0:01:39.31,0:01:40.73,Default,,0,0,0,,Сізге
Dialogue: 0,0:01:40.99,0:01:43.78,Default,,0,0,0,,Сіз бізге опасыздық жасап жатқан жоқсыз ба?
Dialogue: 0,0:01:45.20,0:01:47.25,Default,,0,0,0,,Мен саған опасыздық жасаған жоқпын.
Dialogue: 0,0:01:48.33,0:01:49.42,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:01:49.79,0:01:54.22,Default,,0,0,0,,Ағаңның не ойлағаны маған қызық болды.
Dialogue: 0,0:01:54.68,0:01:57.10,Default,,0,0,0,,Аншель нені жоспарласа да
Dialogue: 0,0:01:57.18,0:02:00.94,Default,,0,0,0,,Мұның бәрі алдымен Диваны ескере отырып.
Dialogue: 0,0:02:01.03,0:02:03.20,Default,,0,0,0,,Мен бұған сенемін
Dialogue: 0,0:02:03.57,0:02:06.33,Default,,0,0,0,,Шевалье диваларға арналған
Dialogue: 0,0:02:06.41,0:02:07.25,Default,,0,0,0,,Бұл?
Dialogue: 0,0:02:08.54,0:02:09.67,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:12.46,0:02:15.64,Default,,0,0,0,,Мен сол қызбен танысқым келеді.
Dialogue: 0,0:02:15.93,0:02:21.94,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:39.93,0:03:45.94,Default,,0,0,0,,~♪
Dialogue: 0,0:04:11.24,0:04:12.79,Default,,0,0,0,,Үлкен Үштікті айтпағанда, олар одан да мықты—
Dialogue: 0,0:04:13.54,0:04:16.34,Default,,0,0,0,,Иә, мен аш емеспін.
Dialogue: 0,0:04:17.59,0:04:19.55,Default,,0,0,0,,Қария осылай деді.
Dialogue: 0,0:04:19.72,0:04:23.94,Default,,0,0,0,,Тамақ жемейтін адамдардың іші кішкентай болады.
Dialogue: 0,0:04:24.02,0:04:27.19,Default,,0,0,0,,Мен енді мұндағыдай дәмді тамақ жей алмаймын.
Dialogue: 0,0:04:27.28,0:04:29.24,Default,,0,0,0,,Мен өкінемін
Dialogue: 0,0:04:29.49,0:04:30.57,Default,,0,0,0,,неғұрлым көп жесең, соғұрлым күшті болып, бойға биіктейсің.
Dialogue: 0,0:04:30.66,0:04:33.29,Default,,0,0,0,,Бұл не? Сіз әкеңізге еліктейсіз бе?
Dialogue: 0,0:04:33.37,0:04:34.58,Default,,0,0,0,,Олар бір-біріне ұқсайды!
Dialogue: 0,0:04:34.66,0:04:36.46,Default,,0,0,0,,Хухахаха! Бұлай күлме
Dialogue: 0,0:04:36.54,0:04:38.55,Default,,0,0,0,,Бұл өте жанды.
Dialogue: 0,0:04:38.63,0:04:39.72,Default,,0,0,0,,Қайырлы таң Льюис
Dialogue: 0,0:04:39.97,0:04:42.60,Default,,0,0,0,,Қайырлы таң, мен тамақ ішіп отырғаныма өкінемін.
Dialogue: 0,0:04:43.14,0:04:45.56,Default,,0,0,0,,Джулия сынақты бастайтынын айтты.
Dialogue: 0,0:04:45.65,0:04:47.77,Default,,0,0,0,,Иә? Тағы?
Dialogue: 0,0:04:47.86,0:04:50.07,Default,,0,0,0,,Ал, олай айтпа.
Dialogue: 0,0:04:50.15,0:04:51.45,Default,,0,0,0,,Иә
Dialogue: 0,0:04:59.42,0:05:01.76,Default,,0,0,0,,Рикудың жігіті тамақ ішпейді.
Dialogue: 0,0:05:04.85,0:05:06.98,Default,,0,0,0,,Кай Рику...
Dialogue: 0,0:05:07.06,0:05:08.57,Default,,0,0,0,,Иә! Сол сорпа!
Dialogue: 0,0:05:08.65,0:05:11.70,Default,,0,0,0,,Льюис! Мұны Рику үшін жасаңыз!
Dialogue: 0,0:05:11.99,0:05:14.04,Default,,0,0,0,,Сіз Окинавадан шыққанда үлгердіңіз бе?
Dialogue: 0,0:05:14.37,0:05:16.00,Default,,0,0,0,,Ах! Өтінемін
Dialogue: 0,0:05:16.08,0:05:17.88,Default,,0,0,0,,Тәбеті жоқ дейді.
Dialogue: 0,0:05:18.34,0:05:20.13,Default,,0,0,0,,Оны жеуге болатынына сенімдімін!
Dialogue: 0,0:05:21.55,0:05:22.93,Default,,0,0,0,,Кай... сен білесің...
Dialogue: 0,0:05:23.01,0:05:24.76,Default,,0,0,0,,(Ыдыстардың сынған дыбысы)
Dialogue: 0,0:05:25.35,0:05:27.23,Default,,0,0,0,,Ах! Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:05:27.48,0:05:29.57,Default,,0,0,0,,Бір минут күтіңіз! Рику
Dialogue: 0,0:05:33.03,0:05:36.75,Default,,0,0,0,,Түсіндім, Кай солай істеді.
Dialogue: 0,0:05:37.29,0:05:38.50,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:05:38.58,0:05:40.80,Default,,0,0,0,,Кайдың жігіті, дәл солай...
Dialogue: 0,0:05:40.88,0:05:43.64,Default,,0,0,0,,Мен «Джоэлдің күнделігін» оқып жатырмын
Dialogue: 0,0:05:43.72,0:05:48.40,Default,,0,0,0,,Рику дәл қазір қандай жағдайда екенін түсінуіңіз керек.
Dialogue: 0,0:05:49.23,0:05:53.11,Default,,0,0,0,,Рику енді тамақ пен ұйқыны қажет етпейді.
Dialogue: 0,0:05:53.74,0:05:56.20,Default,,0,0,0,,Бұл біздің алдымызда.
Dialogue: 0,0:05:56.62,0:05:58.17,Default,,0,0,0,,Мен Кайға айтамын
Dialogue: 0,0:05:59.67,0:06:00.67,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:06:01.42,0:06:04.89,Default,,0,0,0,,Дененің өз құрамында өзгеріс жоқ.
Dialogue: 0,0:06:05.30,0:06:09.48,Default,,0,0,0,,Бұл физикалық қабілетте жақсару жоқ дегенді білдіре ме?
Dialogue: 0,0:06:11.27,0:06:13.61,Default,,0,0,0,,Қорытынды жасауға әлі ерте.
Dialogue: 0,0:06:13.70,0:06:17.62,Default,,0,0,0,,Ол баланың Қажы сияқты қабілеті болуы мүмкін бе?
Dialogue: 0,0:06:17.70,0:06:18.83,Default,,0,0,0,,Даусыз
Dialogue: 0,0:06:18.92,0:06:20.63,Default,,0,0,0,,Қажыға балама?
Dialogue: 0,0:06:20.71,0:06:22.51,Default,,0,0,0,,Сол арық денемен?
Dialogue: 0,0:06:23.51,0:06:26.56,Default,,0,0,0,,Бұл жағдайда бұлшықеттің абсолютті мөлшері маңызды емес.
Dialogue: 0,0:06:27.14,0:06:32.11,Default,,0,0,0,,Бірлікке шаққандағы жұмыс көлемі артады деп айтуға бола ма?
Dialogue: 0,0:06:32.28,0:06:36.53,Default,,0,0,0,,Оларды кәдімгі тірі заттардың масштабында ойламаңыз.
Dialogue: 0,0:06:37.66,0:06:38.71,Default,,0,0,0,,Юлия
Dialogue: 0,0:06:38.79,0:06:42.88,Default,,0,0,0,,Олар сияқты тамақ ішіп, ұйықтау керек емес пе?
Dialogue: 0,0:06:44.17,0:06:45.22,Default,,0,0,0,,Хаа…
Dialogue: 0,0:06:46.93,0:06:48.22,Default,,0,0,0,,Менің бұған уақытым жоқ.
Dialogue: 0,0:06:49.31,0:06:53.61,Default,,0,0,0,,Мен адамның адам болудан қалған сәтіне куә болып отырмын.
Dialogue: 0,0:06:56.37,0:07:00.58,Default,,0,0,0,,Ал мен Коллинз мырзаның сеніміне опасыздық жасағым келмейді.
Dialogue: 0,0:07:05.47,0:07:07.47,Default,,0,0,0,,Өкінбейсіз бе?
Dialogue: 0,0:07:07.72,0:07:09.52,Default,,0,0,0,,Жоқ, жай...
Dialogue: 0,0:07:09.77,0:07:14.11,Default,,0,0,0,,Рику алдында қандай бет жасауым керек?
Dialogue: 0,0:07:14.78,0:07:18.33,Default,,0,0,0,,Мен не айтарымды білмеймін
Dialogue: 0,0:07:22.33,0:07:24.38,Default,,0,0,0,,Сен де сол кезде
Dialogue: 0,0:07:24.46,0:07:27.47,Default,,0,0,0,,Оның жүзі қазір сенікіндей еді.
Dialogue: 0,0:07:29.77,0:07:31.06,Default,,0,0,0,,Қажы…
Dialogue: 0,0:07:32.14,0:07:35.49,Default,,0,0,0,,Өзің бол
Dialogue: 0,0:07:35.78,0:07:38.66,Default,,0,0,0,,Бұл сіз қалағандай болуы мүмкін.
Dialogue: 0,0:07:39.20,0:07:43.67,Default,,0,0,0,,Мен сені қайда барсаң да ертіп барамын.
Dialogue: 0,0:07:44.21,0:07:47.30,Default,,0,0,0,,Және ол да дәл осылай қалар еді.
Dialogue: 0,0:07:48.64,0:07:49.89,Default,,0,0,0,,Рику да?
Dialogue: 0,0:07:50.06,0:07:51.10,Default,,0,0,0,,Иә
Dialogue: 0,0:07:52.85,0:07:53.69,Default,,0,0,0,,Секір!!
Dialogue: 0,0:07:54.98,0:07:57.11,Default,,0,0,0,,Кай не істеу керек?
Dialogue: 0,0:08:00.03,0:08:02.41,Default,,0,0,0,,Дэвид, сен не туралы айтып тұрсың?
Dialogue: 0,0:08:02.79,0:08:04.54,Default,,0,0,0,,Және, әрине…
Dialogue: 0,0:08:06.38,0:08:07.63,Default,,0,0,0,,Хаа…
Dialogue: 0,0:08:08.80,0:08:10.81,Default,,0,0,0,,Әй, аға, а?
Dialogue: 0,0:08:11.18,0:08:15.69,Default,,0,0,0,,Мен қазірдің өзінде жүре аламын, сондықтан мүгедектер арбасы артық.
Dialogue: 0,0:08:15.77,0:08:16.73,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:08:16.82,0:08:18.03,Default,,0,0,0,,Қазірдің өзінде~
Dialogue: 0,0:08:18.28,0:08:20.16,Default,,0,0,0,,Өйткені ол шектен тыс қорғаныс.
Dialogue: 0,0:08:21.79,0:08:22.75,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:08:22.83,0:08:24.29,Default,,0,0,0,,Сіз жоқ дейсіз.
Dialogue: 0,0:08:25.08,0:08:28.13,Default,,0,0,0,,Мен неге құладым?
Dialogue: 0,0:08:29.05,0:08:32.39,Default,,0,0,0,,Сайо-ничанның соңынан Бордоға дейін
Dialogue: 0,0:08:33.23,0:08:36.40,Default,,0,0,0,,Сол ойранда ағаларымнан ажырадым.
Dialogue: 0,0:08:44.54,0:08:46.71,Default,,0,0,0,,Бұдан кейін не болды?
Dialogue: 0,0:08:47.80,0:08:50.13,Default,,0,0,0,,Мен жақсы есімде жоқ.
Dialogue: 0,0:08:55.31,0:08:56.65,Default,,0,0,0,,Сайо-ничан!
Dialogue: 0,0:09:00.32,0:09:02.45,Default,,0,0,0,,Сайо-ничан! Ақыры сені кездестірдім!
Dialogue: 0,0:09:02.53,0:09:05.37,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:05.83,0:09:08.17,Default,,0,0,0,,Эй, мені тыңда, Сайо-ничан.
Dialogue: 0,0:09:08.25,0:09:10.63,Default,,0,0,0,,Менің ағам асыра айтып отыр.
Dialogue: 0,0:09:10.72,0:09:13.31,Default,,0,0,0,,Сіз мүгедектер арбасының қажеті жоқ дейсіз.
Dialogue: 0,0:09:13.39,0:09:15.81,Default,,0,0,0,,Себебі мен Рику үшін уайымдадым...
Dialogue: 0,0:09:16.19,0:09:17.27,Default,,0,0,0,,ЖоЖо, бұл сәл оғаш сұрақ болуы мүмкін, бірақ менде бір өтініш бар
Dialogue: 0,0:09:17.35,0:09:20.36,Default,,0,0,0,,Мен інімді тастап кете алмаймын. Ол бұзылған үлкен аға.
Dialogue: 0,0:09:20.45,0:09:23.28,Default,,0,0,0,,Иә! Сайо-ничан! Мына кемені зерттеп көрейік!
Dialogue: 0,0:09:23.45,0:09:24.91,Default,,0,0,0,,А... барлау?
Dialogue: 0,0:09:25.00,0:09:26.25,Default,,0,0,0,,Иә! Бұл кемеде
Dialogue: 0,0:09:26.33,0:09:29.00,Default,,0,0,0,,Мейрамхана, кітапхана, тіпті бассейн де бар!
Dialogue: 0,0:09:29.13,0:09:30.05,Default,,0,0,0,,Ей, кеттік!
Dialogue: 0,0:09:30.13,0:09:31.34,Default,,0,0,0,,(Арбаны итеру дыбысы)
Dialogue: 0,0:09:31.43,0:09:32.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:33.30,0:09:35.02,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:09:36.44,0:09:37.98,Default,,0,0,0,,Олай болса, кеттік.
Dialogue: 0,0:09:38.06,0:09:39.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:39.36,0:09:40.94,Default,,0,0,0,,Алдымен палубаға шығайық!
Dialogue: 0,0:09:41.03,0:09:43.07,Default,,0,0,0,,Кеменің алдыңғы жағынан бастаңыз
Dialogue: 0,0:09:43.16,0:09:45.29,Default,,0,0,0,,Не? Сіз оны шыңға шығардыңыз ба?
Dialogue: 0,0:09:45.37,0:09:46.91,Default,,0,0,0,,Оны Саяға қалдырыңыз.
Dialogue: 0,0:09:47.16,0:09:49.00,Default,,0,0,0,,Ах... Хэхе! көңілді~!
Dialogue: 0,0:09:50.63,0:09:52.30,Default,,0,0,0,,Рику - адам!
Dialogue: 0,0:09:52.84,0:09:57.27,Default,,0,0,0,,Рику Саяның қанын алып, оның ізбасары болды.
Dialogue: 0,0:09:58.23,0:10:01.65,Default,,0,0,0,,Рику бұрынғыдай емес.
Dialogue: 0,0:10:04.41,0:10:06.62,Default,,0,0,0,,Рикуға дәл қазір Сая керек.
Dialogue: 0,0:10:06.70,0:10:07.54,Default,,0,0,0,,Ал адамдар...
Dialogue: 0,0:10:08.04,0:10:09.33,Default,,0,0,0,,Айтпа!
Dialogue: 0,0:10:12.05,0:10:15.18,Default,,0,0,0,,Сонда да ол менің ағам.
Dialogue: 0,0:10:15.64,0:10:19.19,Default,,0,0,0,,Бірақ... оның уақыты әлдеқашан тоқтап қалды.
Dialogue: 0,0:10:19.27,0:10:20.19,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:10:20.27,0:10:22.99,Default,,0,0,0,,Сіздің рөліңіз оны қабылдау.
Dialogue: 0,0:10:27.45,0:10:29.96,Default,,0,0,0,,Джордж енді жоқ.
Dialogue: 0,0:10:31.38,0:10:34.47,Default,,0,0,0,,Сіздің рөліңіз оны қабылдау.
Dialogue: 0,0:10:34.55,0:10:35.64,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:10:50.12,0:10:51.46,Default,,0,0,0,,Сонымен қатар, сыртта Реммен сөйлескенде,
Dialogue: 0,0:10:52.63,0:10:54.68,Default,,0,0,0,,Менің қызым бар.
Dialogue: 0,0:10:56.22,0:10:59.06,Default,,0,0,0,,Сая, бүгін түн
Dialogue: 0,0:11:43.74,0:11:45.33,Default,,0,0,0,,Қайда бара жатырсың? а!
Dialogue: 0,0:11:46.66,0:11:50.21,Default,,0,0,0,,Мен шөлдеп тұрмын, сондықтан су алайын деп ойладым.
Dialogue: 0,0:11:50.29,0:11:52.13,Default,,0,0,0,,Су? Күте тұрыңыз, мен...
Dialogue: 0,0:11:52.21,0:11:54.97,Default,,0,0,0,,Жақсы, мен мұны өзім жасаймын.
Dialogue: 0,0:11:55.18,0:11:56.56,Default,,0,0,0,,Жарайды, ұйықтай бер.
Dialogue: 0,0:11:57.68,0:11:59.15,Default,,0,0,0,,Ағамнан алыста!
Dialogue: 0,0:11:59.23,0:12:00.06,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:12:01.73,0:12:04.16,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:07.54,0:12:08.66,Default,,0,0,0,,Хаа…
Dialogue: 0,0:12:10.75,0:12:13.63,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:12:24.03,0:12:24.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:27.66,0:12:29.12,Default,,0,0,0,,Сайо-ничан ше?
Dialogue: 0,0:12:29.71,0:12:31.54,Default,,0,0,0,,Мен қазірдің өзінде демалып жатырмын
Dialogue: 0,0:12:32.04,0:12:33.30,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:34.51,0:12:37.81,Default,,0,0,0,,Білесің бе... Мен біртүрлімін.
Dialogue: 0,0:12:37.89,0:12:42.94,Default,,0,0,0,,Ұйқым мүлде кетпейді, ішім мүлде түспейді.
Dialogue: 0,0:12:44.03,0:12:46.78,Default,,0,0,0,,Ни-чан да, Сайо-ничан да біртүрлі.
Dialogue: 0,0:12:47.87,0:12:52.50,Default,,0,0,0,,Ол мейірімді, бірақ ол бірдеңені жасырады.
Dialogue: 0,0:12:55.01,0:12:56.47,Default,,0,0,0,,Хайуанаттар бағы…
Dialogue: 0,0:12:57.01,0:12:58.89,Default,,0,0,0,,Сол жерде болған адам
Dialogue: 0,0:12:59.06,0:13:02.31,Default,,0,0,0,,Мен оны Сайо-ничан деп ойладым.
Dialogue: 0,0:13:04.15,0:13:07.20,Default,,0,0,0,,Әй, Қажы, айтшы! Бұл кім?
Dialogue: 0,0:13:08.70,0:13:09.95,Default,,0,0,0,,Дива
Dialogue: 0,0:13:10.20,0:13:11.37,Default,,0,0,0,,Дива?
Dialogue: 0,0:13:12.21,0:13:14.55,Default,,0,0,0,,Жауды жеңуіміз керек
Dialogue: 0,0:13:15.67,0:13:16.51,Default,,0,0,0,,Жау?
Dialogue: 0,0:13:17.13,0:13:20.35,Default,,0,0,0,,Түсінетін уақыт келеді
Dialogue: 0,0:13:23.73,0:13:24.61,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:26.53,0:13:27.40,Default,,0,0,0,,Бұл сезім...
Dialogue: 0,0:13:35.55,0:13:36.38,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:36.67,0:13:37.55,Default,,0,0,0,,Қажы!
Dialogue: 0,0:13:40.85,0:13:42.98,Default,,0,0,0,,Рику! Рику жасырынып жүр!
Dialogue: 0,0:13:43.06,0:13:45.02,Default,,0,0,0,,Өйткені Шиффтің нысанасы мен.
Dialogue: 0,0:13:45.11,0:13:45.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:46.99,0:13:48.57,Default,,0,0,0,,Сайо-ничан
Dialogue: 0,0:13:56.75,0:13:57.80,Default,,0,0,0,,Рику!
Dialogue: 0,0:14:01.06,0:14:01.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:02.02,0:14:03.56,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:04.48,0:14:05.65,Default,,0,0,0,,неғұрлым көп жесең, соғұрлым күшті болып, бойға биіктейсің.
Dialogue: 0,0:14:09.45,0:14:11.16,Default,,0,0,0,,Сая қайда?
Dialogue: 0,0:14:23.98,0:14:26.15,Default,,0,0,0,,Директор кім? (Қара киім 2) Эвакуацияланды
Dialogue: 0,0:14:29.11,0:14:30.53,Default,,0,0,0,,Сіз әлі түсінбедіңіз бе?
Dialogue: 0,0:14:30.61,0:14:32.41,Default,,0,0,0,,Қарман, сабыр ет.
Dialogue: 0,0:14:32.49,0:14:36.21,Default,,0,0,0,,Сая мен Шевалье ғана жеңіледі.
Dialogue: 0,0:14:36.38,0:14:38.09,Default,,0,0,0,,Дүрбелеңге түспеңіз
Dialogue: 0,0:14:38.76,0:14:41.47,Default,,0,0,0,,Шевалерлермен салыстырғанда Даеваны қорғау
Dialogue: 0,0:14:41.55,0:14:44.56,Default,,0,0,0,,Жоспар жасауға тырыспасаңыз, оны жеңе алуыңыз керек.
Dialogue: 0,0:14:44.85,0:14:47.44,Default,,0,0,0,,Мен білемін, бірақ қашып құтылсам...
Dialogue: 0,0:14:47.52,0:14:48.57,Default,,0,0,0,,Мен көрдім.
Dialogue: 0,0:14:49.82,0:14:51.86,Default,,0,0,0,,Сая жоғарыда
Dialogue: 0,0:14:52.16,0:14:53.16,Default,,0,0,0,,Түсінікті! Рақмет!
Dialogue: 0,0:14:54.83,0:14:56.62,Default,,0,0,0,,Жоғарыда
Dialogue: 0,0:14:56.71,0:14:59.13,Default,,0,0,0,,Мен бұл кеменің басындамын.
Dialogue: 0,0:15:00.88,0:15:02.80,Default,,0,0,0,,Әлгі Шевалье де сенімен бірге ме?
Dialogue: 0,0:15:03.56,0:15:04.39,Default,,0,0,0,,Иә
Dialogue: 0,0:15:05.23,0:15:07.35,Default,,0,0,0,,Бірақ бірдеңе...
Dialogue: 0,0:15:08.06,0:15:11.11,Default,,0,0,0,,Адамдарға пайдасы жоқ. Барайық.
Dialogue: 0,0:15:39.34,0:15:40.80,Default,,0,0,0,,Ха ха ха... ха!
Dialogue: 0,0:15:45.64,0:15:46.93,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:15:48.81,0:15:49.81,Default,,0,0,0,,Эй!
Dialogue: 0,0:16:02.67,0:16:04.34,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:16:07.31,0:16:08.14,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:11.65,0:16:12.82,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:18.20,0:16:19.04,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:20.08,0:16:21.71,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:24.88,0:16:26.85,Default,,0,0,0,,Қат! Не болып жатыр!
Dialogue: 0,0:16:26.93,0:16:27.76,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:34.11,0:16:34.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:35.32,0:16:37.33,Default,,0,0,0,,Идиот! Сен не істеп жатырсың!
Dialogue: 0,0:16:39.79,0:16:40.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:41.96,0:16:43.55,Default,,0,0,0,,Уау! (Гуча!)
Dialogue: 0,0:16:45.09,0:16:46.22,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:55.78,0:16:57.62,Default,,0,0,0,,Не? Бұл...
Dialogue: 0,0:16:57.74,0:16:59.41,Default,,0,0,0,,Бұл сезім...
Dialogue: 0,0:17:01.54,0:17:03.54,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:04.67,0:17:05.51,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:08.22,0:17:09.14,Default,,0,0,0,,Рику!
Dialogue: 0,0:17:09.93,0:17:10.77,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:17:11.19,0:17:12.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:19.58,0:17:20.45,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:17:22.83,0:17:23.67,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:17:25.34,0:17:26.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:27.63,0:17:28.47,Default,,0,0,0,,Сая!
Dialogue: 0,0:17:28.68,0:17:31.31,Default,,0,0,0,,Өтінемін, тез қашып, маған Рикуды беріңіз.
Dialogue: 0,0:17:31.98,0:17:33.15,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:17:33.98,0:17:35.69,Default,,0,0,0,,Кеттік, Рику! Ах...
Dialogue: 0,0:17:43.25,0:17:44.08,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:46.09,0:17:46.92,Default,,0,0,0,,Рику!
Dialogue: 0,0:17:47.30,0:17:48.13,Default,,0,0,0,,Уф
Dialogue: 0,0:17:48.34,0:17:49.60,Default,,0,0,0,,Рику!
Dialogue: 0,0:17:51.18,0:17:52.94,Default,,0,0,0,,Цк, маған кедергі жасама!
Dialogue: 0,0:17:53.31,0:17:54.23,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:17:54.90,0:17:56.11,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:17:56.23,0:17:58.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:58.36,0:18:00.08,Default,,0,0,0,,Уф! (Дэвид) Ха!
Dialogue: 0,0:18:03.25,0:18:05.09,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,0:18:08.76,0:18:09.72,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:10.89,0:18:11.89,Default,,0,0,0,,Рику!
Dialogue: 0,0:18:12.27,0:18:13.10,Default,,0,0,0,,Рику!
Dialogue: 0,0:18:14.52,0:18:16.61,Default,,0,0,0,,Неге бұлай істедің...
Dialogue: 0,0:18:16.94,0:18:18.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:19.70,0:18:20.53,Default,,0,0,0,,Рику…
Dialogue: 0,0:18:24.96,0:18:26.00,Default,,0,0,0,,Шевалье?
Dialogue: 0,0:18:37.69,0:18:39.15,Default,,0,0,0,,Мен түсіндім! (Мұса) Күте тұрыңыз!
Dialogue: 0,0:18:42.12,0:18:42.95,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:43.33,0:18:45.37,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,0:18:54.43,0:18:56.60,Default,,0,0,0,,Незуко, жақсысың ба?
Dialogue: 0,0:18:56.69,0:18:57.61,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:19:03.78,0:19:05.08,Default,,0,0,0,,Ненің суретін салайық?
Dialogue: 0,0:19:05.50,0:19:08.42,Default,,0,0,0,,Саяның сыртқы түрі бұрынғыдан өзгеше.
Dialogue: 0,0:19:09.13,0:19:11.68,Default,,0,0,0,,Және екі шевальер
Dialogue: 0,0:19:13.18,0:19:14.31,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:19:15.27,0:19:16.23,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:23.82,0:19:24.74,Default,,0,0,0,,Рику! (Сая) Ах!
Dialogue: 0,0:19:24.83,0:19:26.08,Default,,0,0,0,,Рику! Эй!
Dialogue: 0,0:19:29.84,0:19:31.26,Default,,0,0,0,,…
Dialogue: 0,0:19:33.64,0:19:38.31,Default,,0,0,0,,Мен... Мен бұрынғыдай емеспін.
Dialogue: 0,0:19:39.73,0:19:41.53,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:19:42.07,0:19:43.24,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:19:43.53,0:19:46.16,Default,,0,0,0,,Бұрынғы жарақат...
Dialogue: 0,0:19:46.41,0:19:48.33,Default,,0,0,0,,Рику - бұл Рику!
Dialogue: 0,0:19:49.38,0:19:52.42,Default,,0,0,0,,Мен Қажымен бірдеймін.
Dialogue: 0,0:19:53.88,0:19:55.05,Default,,0,0,0,,Рику…
Dialogue: 0,0:19:56.56,0:19:57.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:57.48,0:19:58.73,Default,,0,0,0,,Кай…
Dialogue: 0,0:20:02.11,0:20:02.95,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:20:03.36,0:20:04.24,Default,,0,0,0,,Не болды!
Dialogue: 0,0:20:05.58,0:20:07.25,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:20:07.96,0:20:11.59,Default,,0,0,0,,Бауырым, жүрегім ыстық...
Dialogue: 0,0:20:11.84,0:20:12.67,Default,,0,0,0,,Әйтеуір...
Dialogue: 0,0:20:14.05,0:20:15.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:16.18,0:20:18.10,Default,,0,0,0,,Фуфуфу…
Dialogue: 0,0:20:18.64,0:20:20.44,Default,,0,0,0,,Рику Рику!
Dialogue: 0,0:20:20.98,0:20:22.44,Default,,0,0,0,,Мен шөлдедім
Dialogue: 0,0:20:23.95,0:20:25.11,Default,,0,0,0,,Рику!
Dialogue: 0,0:20:25.20,0:20:26.16,Default,,0,0,0,,Шевалье
Dialogue: 0,0:20:26.58,0:20:30.63,Default,,0,0,0,,Жараларды қалпына келтіру үшін көп мөлшерде қан қажет
Dialogue: 0,0:20:30.75,0:20:31.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:31.88,0:20:34.51,Default,,0,0,0,,Льюис! Джулияға хабарласыңыз!
Dialogue: 0,0:20:34.63,0:20:35.55,Default,,0,0,0,,Фуфуфу…
Dialogue: 0,0:20:35.64,0:20:36.47,Default,,0,0,0,,Эх!
Dialogue: 0,0:20:36.64,0:20:37.47,Default,,0,0,0,,Даа!
Dialogue: 0,0:20:37.60,0:20:38.43,Default,,0,0,0,,Кай!
Dialogue: 0,0:20:39.60,0:20:40.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:40.65,0:20:42.98,Default,,0,0,0,,Рику менің інім!
Dialogue: 0,0:20:43.15,0:20:44.24,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:46.91,0:20:47.91,Default,,0,0,0,,…
Dialogue: 0,0:20:48.66,0:20:51.92,Default,,0,0,0,,Мен саған қамқор боламын
Dialogue: 0,0:20:53.05,0:20:53.96,Default,,0,0,0,,Ха...
Dialogue: 0,0:20:56.93,0:20:58.22,Default,,0,0,0,,(шағу дыбысы)
Dialogue: 0,0:21:01.15,0:21:02.27,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:06.07,0:21:12.08,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:21:42.02,0:21:45.69,Default,,0,0,0,,Кай-нии-чан сондай жылы.
Dialogue: 0,0:21:52.66,0:21:58.68,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:19.17,0:23:25.18,Default,,0,0,0,,~♪
Dialogue: 0,0:23:28.86,0:23:31.99,Default,,0,0,0,,Күн сәулесі Кирбедке жетпейтін жер
Dialogue: 0,0:23:32.91,0:23:35.37,Default,,0,0,0,,Мен қанша уақыт болғанын білмеймін.
Dialogue: 0,0:23:35.58,0:23:38.67,Default,,0,0,0,,Менің есімде қалғаны - шектеулер мен сезім
Dialogue: 0,0:23:38.75,0:23:40.55,Default,,0,0,0,,Бұл дүниені білу және
Dialogue: 0,0:23:41.05,0:23:43.05,Default,,0,0,0,,Қанатшылармен күресу әдістері ғана
Dialogue: 0,0:23:43.72,0:23:46.81,Default,,0,0,0,,Ал біз тұрдық
Dialogue: 0,0:23:47.02,0:23:48.60,Default,,0,0,0,,Ертеңгі күнді іздеу
Dialogue: 0,0:23:49.27,0:23:51.15,Default,,0,0,0,,Келесі жолы «Blood Plus»
Dialogue: 0,0:23:51.23,0:23:52.24,Default,,0,0,0,,«Париж же t'aime»
Dialogue: 0,0:23:53.07,0:23:55.24,Default,,0,0,0,,Рахмет Кай
Dialogue: 0,0:23:56.74,0:24:02.74,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory