Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.75,0:00:15.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:25.97,0:00:26.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:28.73,0:00:29.69,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:33.94,0:00:34.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:37.53,0:00:38.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:43.91,0:00:44.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:52.04,0:00:52.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:59.34,0:01:00.38,Default,,0,0,0,,Кел, Айрин.
Dialogue: 0,0:01:08.73,0:01:09.64,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:01:24.91,0:01:25.83,Default,,0,0,0,,Кеттік
Dialogue: 0,0:01:26.41,0:01:28.24,Default,,0,0,0,,Бүгін Саяны табатын күн.
Dialogue: 0,0:01:33.04,0:01:39.05,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:59.67,0:03:05.68,Default,,0,0,0,,~♪
Dialogue: 0,0:03:16.19,0:03:18.06,Default,,0,0,0,,Дэвид мырза, сіз осында емессіз бе?
Dialogue: 0,0:03:18.52,0:03:19.48,Default,,0,0,0,,«Тедпен кездесу»
Dialogue: 0,0:03:19.56,0:03:22.57,Default,,0,0,0,,«Свердловскіге бару»
Dialogue: 0,0:03:24.90,0:03:26.95,Default,,0,0,0,,Қалай болғанда да, қазір душ қабылда.
Dialogue: 0,0:03:27.20,0:03:28.53,Default,,0,0,0,,Тамақтанып алайық
Dialogue: 0,0:03:28.95,0:03:29.78,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:03:32.54,0:03:33.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:42.13,0:03:45.84,Default,,0,0,0,,Рику-кун, сен әпкеңмен шомылғың келе ме?
Dialogue: 0,0:03:47.84,0:03:50.30,Default,,0,0,0,,Мен... Мен өзім кіремін!
Dialogue: 0,0:03:50.39,0:03:52.31,Default,,0,0,0,,Сен енді бала емессің!
Dialogue: 0,0:03:52.76,0:03:54.18,Default,,0,0,0,,Бетіңіз қызарған ба?
Dialogue: 0,0:03:54.27,0:03:55.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:57.23,0:04:00.19,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:04:08.99,0:04:12.53,Default,,0,0,0,,Бұл арман емес сияқты.
Dialogue: 0,0:04:14.24,0:04:15.87,Default,,0,0,0,,Сол жағымсыз сезім...
Dialogue: 0,0:04:16.08,0:04:17.21,Default,,0,0,0,,Қандай арман?
Dialogue: 0,0:04:18.83,0:04:20.04,Default,,0,0,0,,Элизабет?
Dialogue: 0,0:04:20.21,0:04:21.21,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:21.71,0:04:24.05,Default,,0,0,0,,Бұл менің шашымды тарайтын жалғыз айна.
Dialogue: 0,0:04:24.71,0:04:25.55,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:04:25.67,0:04:26.51,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:29.97,0:04:32.18,Default,,0,0,0,,Сіз көрген түс туралы
Dialogue: 0,0:04:32.39,0:04:33.68,Default,,0,0,0,,Маған айта аласыз ба?
Dialogue: 0,0:04:35.64,0:04:36.52,Default,,0,0,0,,Ал...
Dialogue: 0,0:04:36.98,0:04:40.73,Default,,0,0,0,,Бұл Қажы екеуміздің Ресейде жалғыз қалған түсіміз еді.
Dialogue: 0,0:04:41.60,0:04:44.73,Default,,0,0,0,,Қажы қазіргіден сәл басқаша болды.
Dialogue: 0,0:04:45.40,0:04:47.94,Default,,0,0,0,,Мен де бұл мен емес сияқтымын...
Dialogue: 0,0:04:48.90,0:04:51.36,Default,,0,0,0,,Бұл шынымен болған нәрсе сияқты болды ма?
Dialogue: 0,0:04:52.28,0:04:53.12,Default,,0,0,0,,Иә
Dialogue: 0,0:04:53.57,0:04:54.45,Default,,0,0,0,,Иә
Dialogue: 0,0:04:55.03,0:04:56.79,Default,,0,0,0,,Тағы қандай ұқсастық бар?
Dialogue: 0,0:04:58.16,0:05:01.33,Default,,0,0,0,,Мен Вьетнамда жиіркенішті нәрсе көрдім.
Dialogue: 0,0:05:02.08,0:05:06.46,Default,,0,0,0,,Қанаттар мен адамдарды өлтіретін менмін.
Dialogue: 0,0:05:07.09,0:05:09.05,Default,,0,0,0,,Сондай-ақ Вьетнам соғысы кезінде.
Dialogue: 0,0:05:09.84,0:05:12.09,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,0:05:13.22,0:05:14.26,Default,,0,0,0,,Сіз дірілдеп тұрсыз ба?
Dialogue: 0,0:05:16.39,0:05:17.85,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:05:17.93,0:05:18.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:20.60,0:05:22.15,Default,,0,0,0,,(Кранның қосылып жатқан дыбысы)
Dialogue: 0,0:05:24.15,0:05:27.32,Default,,0,0,0,,Ум, Лиза?
Dialogue: 0,0:05:28.28,0:05:29.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:29.61,0:05:31.24,Default,,0,0,0,,Сіздің қарныңыз ашты ма?
Dialogue: 0,0:05:32.16,0:05:33.95,Default,,0,0,0,,Киім ауыстырып болған соң тамақ ішейік.
Dialogue: 0,0:05:34.53,0:05:35.37,Default,,0,0,0,,Иә
Dialogue: 0,0:05:38.16,0:05:40.04,Default,,0,0,0,,Сен жақсы қыз емессің бе? Кай
Dialogue: 0,0:05:40.41,0:05:43.67,Default,,0,0,0,,Майданда жақсылар ерте өледі.
Dialogue: 0,0:05:44.67,0:05:46.50,Default,,0,0,0,,Мен оны көргенді ұнатпаймын.
Dialogue: 0,0:05:47.17,0:05:48.63,Default,,0,0,0,,Сен өзгердің, солай емес пе?
Dialogue: 0,0:05:49.30,0:05:50.21,Default,,0,0,0,,Ол өзгерді ме?
Dialogue: 0,0:05:50.80,0:05:55.18,Default,,0,0,0,,Жақында сен темірден жасалған робот болдың.
Dialogue: 0,0:05:55.85,0:05:56.93,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:05:58.01,0:06:00.52,Default,,0,0,0,,Қазір өзімді андроид немесе киборг сияқты сезінемін.
Dialogue: 0,0:06:01.89,0:06:03.64,Default,,0,0,0,,Барған сайын әлсіреп барады
Dialogue: 0,0:06:04.35,0:06:05.31,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:06:05.61,0:06:07.77,Default,,0,0,0,,Менің ойымша, бұл жақсырақ.
Dialogue: 0,0:06:08.11,0:06:10.15,Default,,0,0,0,,Бұл жұмыс әлсіздікті қажет етпейді.
Dialogue: 0,0:06:10.86,0:06:13.28,Default,,0,0,0,,Адамдар жалғыз күшпен өмір сүре алмайды.
Dialogue: 0,0:06:14.03,0:06:15.78,Default,,0,0,0,,Дәрігер ретінде диагноз қою?
Dialogue: 0,0:06:16.07,0:06:17.95,Default,,0,0,0,,Әйел ретіндегі кеңес
Dialogue: 0,0:06:19.54,0:06:20.45,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:06:20.95,0:06:21.91,Default,,0,0,0,,Қыңыр!
Dialogue: 0,0:06:30.42,0:06:32.30,Default,,0,0,0,,Әдемі және еркін
Dialogue: 0,0:06:33.17,0:06:37.68,Default,,0,0,0,,Бірақ адамзат үшін ең қауіпті қыз.
Dialogue: 0,0:06:38.64,0:06:41.97,Default,,0,0,0,,Оны Дива деп атады
Dialogue: 0,0:06:42.68,0:06:48.69,Default,,0,0,0,,Бірақ мұның бәрі 1972 жылы Солтүстікті бомбалаумен жоғалып кетті.
Dialogue: 0,0:06:52.94,0:06:54.36,Default,,0,0,0,,А... бұл өтірік, солай ма?
Dialogue: 0,0:06:54.45,0:06:55.86,Default,,0,0,0,,Бәрін жалғыз жедің бе?
Dialogue: 0,0:06:56.24,0:06:58.57,Default,,0,0,0,,Өйткені семіз кейіпкерлер көп жеуі керек.
Dialogue: 0,0:06:58.66,0:07:00.08,Default,,0,0,0,,Менің күшім жоқ.
Dialogue: 0,0:07:00.28,0:07:01.99,Default,,0,0,0,,Сондай семіз мінез бар ма?
Dialogue: 0,0:07:02.08,0:07:04.12,Default,,0,0,0,,Тіпті Сая аздап кідіреді!
Dialogue: 0,0:07:04.37,0:07:05.33,Default,,0,0,0,,(Танжиро) Бұған дейін кірген жебелер мені бұрын-соңды болмағандай күшпен тартып жатыр.
Dialogue: 0,0:07:15.43,0:07:19.35,Default,,0,0,0,,Әпке, тағы да тісбасардан бастайсыз ба?
Dialogue: 0,0:07:19.47,0:07:21.81,Default,,0,0,0,,Жоқ, бұл жолы тiске басар ғана.
Dialogue: 0,0:07:22.14,0:07:23.60,Default,,0,0,0,,Лосось елігі Саған ұнайды, солай емес пе?
Dialogue: 0,0:07:23.68,0:07:24.73,Default,,0,0,0,,Пісірілген жұмыртқа
Dialogue: 0,0:07:25.85,0:07:29.44,Default,,0,0,0,,Ол менің түскі қорапшама жиі пісірілген жұмыртқа әкелетін.
Dialogue: 0,0:07:29.86,0:07:30.69,Default,,0,0,0,,Әкем
Dialogue: 0,0:07:31.82,0:07:32.94,Default,,0,0,0,,Әке?
Dialogue: 0,0:07:33.82,0:07:35.61,Default,,0,0,0,,Бұл Окинава...
Dialogue: 0,0:07:35.86,0:07:36.70,Default,,0,0,0,,Иә
Dialogue: 0,0:07:39.41,0:07:41.16,Default,,0,0,0,,Лиза тамақ ішпей ме?
Dialogue: 0,0:07:41.45,0:07:43.29,Default,,0,0,0,,Бұл маған жеткілікті
Dialogue: 0,0:07:43.87,0:07:46.12,Default,,0,0,0,,Мен қажет болғаннан артық жемеймін.
Dialogue: 0,0:07:46.54,0:07:48.33,Default,,0,0,0,,Мен тамақты ермек болғым келмейді.
Dialogue: 0,0:07:50.59,0:07:51.75,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:52.25,0:07:54.30,Default,,0,0,0,,О, менде кешірім сұрайтын ештеңе жоқ.
Dialogue: 0,0:07:54.67,0:07:56.80,Default,,0,0,0,,Өйткені бұл сізге керек
Dialogue: 0,0:07:57.51,0:07:59.26,Default,,0,0,0,,Одан гөрі мен қашып бара жатырмын.
Dialogue: 0,0:07:59.59,0:08:00.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:01.51,0:08:02.68,Default,,0,0,0,,Төгілу
Dialogue: 0,0:08:02.89,0:08:03.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:04.02,0:08:05.64,Default,,0,0,0,,А... Мен білмей тұрып
Dialogue: 0,0:08:06.52,0:08:07.69,Default,,0,0,0,,Тірі заттар
Dialogue: 0,0:08:07.98,0:08:11.02,Default,,0,0,0,,Біз жейміз, өйткені ол бізге өмір сүру үшін қажет.
Dialogue: 0,0:08:11.23,0:08:13.94,Default,,0,0,0,,Тірі тіршілік иелері болып табылатын хироптерандарға да қатысты.
Dialogue: 0,0:08:14.36,0:08:16.94,Default,,0,0,0,,Тірі қалу үшін адамның қанын жеу
Dialogue: 0,0:08:22.28,0:08:23.91,Default,,0,0,0,,Уайымдамай тамақтаныңыз
Dialogue: 0,0:08:24.29,0:08:26.75,Default,,0,0,0,,Жеуге жарамды лосось елігі ұрықтанбаған жұмыртқадан жасалады.
Dialogue: 0,0:08:26.95,0:08:28.92,Default,,0,0,0,,Ол бәрібір балыққа айналмайды.
Dialogue: 0,0:08:30.25,0:08:32.50,Default,,0,0,0,,Сіз бұл туралы бір кездері ойланып көрдіңіз бе?
Dialogue: 0,0:08:33.00,0:08:35.34,Default,,0,0,0,,Қанатшы дегеніміз не?
Dialogue: 0,0:08:36.34,0:08:37.30,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:08:39.01,0:08:41.09,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,0:08:41.18,0:08:43.64,Default,,0,0,0,,Сіз ұрысқан адам, солай ма?
Dialogue: 0,0:08:43.89,0:08:47.39,Default,,0,0,0,,Хироптерандар - адамның қанын соратын құбыжықтар.
Dialogue: 0,0:08:47.48,0:08:49.14,Default,,0,0,0,,деді Дэвид
Dialogue: 0,0:08:49.39,0:08:52.15,Default,,0,0,0,,Шынымен ұрыстан кейін не ойладың?
Dialogue: 0,0:08:53.02,0:08:54.11,Default,,0,0,0,,Қалай...
Dialogue: 0,0:08:54.86,0:08:56.69,Default,,0,0,0,,Сіз осылай ойладыңыз ба?
Dialogue: 0,0:08:57.15,0:09:00.20,Default,,0,0,0,,Маған қызық, хироптералар не үшін бар?
Dialogue: 0,0:09:01.16,0:09:03.45,Default,,0,0,0,,Сіз бұл нені білдіретіні туралы ойландыңыз ба?
Dialogue: 0,0:09:03.70,0:09:05.45,Default,,0,0,0,,Мағынасы...?
Dialogue: 0,0:09:06.04,0:09:08.75,Default,,0,0,0,,Хиротерандардың болуы да, адамдардың болуы да.
Dialogue: 0,0:09:08.83,0:09:11.00,Default,,0,0,0,,Ол не үшін рұқсат етілген?
Dialogue: 0,0:09:11.58,0:09:15.04,Default,,0,0,0,,Біз қайдан келдік, қайда барамыз?
Dialogue: 0,0:09:15.59,0:09:16.67,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:09:17.34,0:09:21.68,Default,,0,0,0,,Мм... Мен қанаттар туралы ештеңе білмеймін.
Dialogue: 0,0:09:23.76,0:09:25.18,Default,,0,0,0,,Бірақ менің ойымша
Dialogue: 0,0:09:25.39,0:09:28.14,Default,,0,0,0,,Қанатшы біреуді ренжітіп, бақытсыз етсе
Dialogue: 0,0:09:28.39,0:09:31.52,Default,,0,0,0,,Мен бәрімен күресіп, қорғаймын.
Dialogue: 0,0:09:32.02,0:09:34.44,Default,,0,0,0,,Өйткені мұны істей алатын жалғыз адаммын.
Dialogue: 0,0:09:34.52,0:09:37.07,Default,,0,0,0,,Мен мұны істеуім керек.
Dialogue: 0,0:09:38.48,0:09:41.24,Default,,0,0,0,,Бұл таңқаларлық әдемі жауап.
Dialogue: 0,0:09:41.74,0:09:44.07,Default,,0,0,0,,Бір нәрсені қоспағанда...
Dialogue: 0,0:09:44.37,0:09:45.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:45.58,0:09:47.03,Default,,0,0,0,,Вингменді жеңу
Dialogue: 0,0:09:47.33,0:09:50.08,Default,,0,0,0,,Мүмкін бұл сіздің міндетіңіз шығар.
Dialogue: 0,0:09:50.25,0:09:53.75,Default,,0,0,0,,Бірақ сіз шынымен де осыны қалайсыз ба?
Dialogue: 0,0:09:55.38,0:09:57.09,Default,,0,0,0,,Үміт?
Dialogue: 0,0:09:57.71,0:10:01.01,Default,,0,0,0,,Сая: Не істеу керек
Dialogue: 0,0:10:01.51,0:10:03.76,Default,,0,0,0,,Біз бірге істегіміз келетін нәрсені істеп жатқан жоқпыз ба?
Dialogue: 0,0:10:04.64,0:10:07.93,Default,,0,0,0,,Сіз шынымен істеу керек тағы бір нәрсе болуы керек.
Dialogue: 0,0:10:10.98,0:10:11.93,Default,,0,0,0,,(Әйнектің құлаған дыбысы)
Dialogue: 0,0:10:13.98,0:10:15.52,Default,,0,0,0,,Рику? (Лиза) А...
Dialogue: 0,0:10:18.23,0:10:19.40,Default,,0,0,0,,Қатты қызба
Dialogue: 0,0:10:24.03,0:10:26.91,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:10:27.20,0:10:29.45,Default,,0,0,0,,(мұздың жарылған дыбысы)
Dialogue: 0,0:10:36.46,0:10:37.29,Default,,0,0,0,,Біртүрлі екен, солай емес пе?
Dialogue: 0,0:10:38.33,0:10:41.34,Default,,0,0,0,,Сен сияқты адам қанатты аңшы.
Dialogue: 0,0:10:41.46,0:10:42.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:42.38,0:10:44.13,Default,,0,0,0,,Мен төбелес дегенді де білмеймін
Dialogue: 0,0:10:44.59,0:10:47.09,Default,,0,0,0,,Мен қарсыласып жатқан адамды түсінбеймін.
Dialogue: 0,0:10:47.72,0:10:50.72,Default,,0,0,0,,Сіз төбелесуге мәжбүрлеп жатқаныңызды сезбейсіз де
Dialogue: 0,0:10:52.60,0:10:56.06,Default,,0,0,0,,Барлық қанатты жеңгеннен кейін не істеуді жоспарлайсыз?
Dialogue: 0,0:10:56.23,0:10:59.85,Default,,0,0,0,,Мен Кай және Рикумен қайтадан Окинавада өмір сүргім келеді.
Dialogue: 0,0:11:00.90,0:11:01.73,Default,,0,0,0,,Оны алу үшін
Dialogue: 0,0:11:01.82,0:11:05.24,Default,,0,0,0,,Сіз қанша адамды құрбан етесіз?
Dialogue: 0,0:11:10.53,0:11:12.53,Default,,0,0,0,,Қанатты жеңу арқылы
Dialogue: 0,0:11:12.66,0:11:14.20,Default,,0,0,0,,Жаныңыздағы адам
Dialogue: 0,0:11:14.29,0:11:18.00,Default,,0,0,0,,Сол шайқасқа еріксіз тартыласың.
Dialogue: 0,0:11:18.46,0:11:22.63,Default,,0,0,0,,Ал ол адам бір нәрсесін жоғалтады.
Dialogue: 0,0:11:23.80,0:11:25.59,Default,,0,0,0,,Бұл қайғылы шындық.
Dialogue: 0,0:11:50.61,0:11:51.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:52.62,0:11:55.41,Default,,0,0,0,,Лиза-сан, бұл біртүрлі.
Dialogue: 0,0:11:55.54,0:11:57.20,Default,,0,0,0,,Бұл бұрыннан қандай?
Dialogue: 0,0:11:57.29,0:11:58.12,Default,,0,0,0,,Бөлек
Dialogue: 0,0:12:00.42,0:12:02.42,Default,,0,0,0,,Мен тек сені қызықтырамын
Dialogue: 0,0:12:02.92,0:12:05.46,Default,,0,0,0,,Сізге адамнан тыс нәсілді аулау
Dialogue: 0,0:12:05.88,0:12:08.72,Default,,0,0,0,,Маған айтар сөзің болса, анық айт!
Dialogue: 0,0:12:10.05,0:12:14.22,Default,,0,0,0,,Біз сіздің өткеніңіз туралы айтпайтынымызды білесіз.
Dialogue: 0,0:12:14.30,0:12:15.76,Default,,0,0,0,,Сіздің күмәніңіз болды ма?
Dialogue: 0,0:12:19.31,0:12:20.98,Default,,0,0,0,,Біз жасырынбыз.
Dialogue: 0,0:12:22.06,0:12:24.36,Default,,0,0,0,,Мен көп нәрсені білсем де
Dialogue: 0,0:12:24.44,0:12:28.07,Default,,0,0,0,,Мен сізге оның аз ғана бөлігін айттым.
Dialogue: 0,0:12:28.57,0:12:29.78,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,0:12:29.86,0:12:32.74,Default,,0,0,0,,Өйткені мен өзімді еске түсіруім керек...
Dialogue: 0,0:12:33.66,0:12:36.20,Default,,0,0,0,,Ал сіздің есіңізде не қалды?
Dialogue: 0,0:12:40.50,0:12:41.92,Default,,0,0,0,,Шайқас туралы естеліктер
Dialogue: 0,0:12:46.79,0:12:49.26,Default,,0,0,0,,Вьетнам қызыл жалынға оранған
Dialogue: 0,0:12:49.88,0:12:54.59,Default,,0,0,0,,Аппақ қарда Сібір жерінде біртүрлі құбыжықтармен соғыстық
Dialogue: 0,0:12:55.01,0:12:56.01,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:12:57.22,0:12:58.35,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:12:59.31,0:13:01.31,Default,,0,0,0,,Сіз білуіңіз керек
Dialogue: 0,0:13:01.68,0:13:04.23,Default,,0,0,0,,Қолым қанға боялған күндер туралы
Dialogue: 0,0:13:08.44,0:13:09.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:10.07,0:13:12.03,Default,,0,0,0,,Ха! мм...
Dialogue: 0,0:13:15.66,0:13:16.57,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:13:17.24,0:13:18.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:19.62,0:13:20.70,Default,,0,0,0,,Не көрдіңіз?
Dialogue: 0,0:13:20.95,0:13:22.25,Default,,0,0,0,,Менімен сөйлесіңізші.
Dialogue: 0,0:13:22.91,0:13:26.13,Default,,0,0,0,,А... анау... мынау
Dialogue: 0,0:13:28.50,0:13:31.21,Default,,0,0,0,,Ол өлді, солай ма? адамдар
Dialogue: 0,0:13:32.09,0:13:35.84,Default,,0,0,0,,Ағып тұрды, солай ма? ашық қызыл қан
Dialogue: 0,0:13:36.14,0:13:39.89,Default,,0,0,0,,Ал сен онда не істеп жүрсің?
Dialogue: 0,0:13:40.60,0:13:42.56,Default,,0,0,0,,… …
Dialogue: 0,0:13:43.89,0:13:46.90,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:13:50.82,0:13:53.53,Default,,0,0,0,,А... бұл мен емес.
Dialogue: 0,0:13:56.70,0:13:58.53,Default,,0,0,0,,болғанын қалаймын
Dialogue: 0,0:14:01.45,0:14:04.91,Default,,0,0,0,,Менің армандарымды қайдан білесің?
Dialogue: 0,0:14:06.12,0:14:06.96,Default,,0,0,0,,Иә
Dialogue: 0,0:14:07.29,0:14:08.13,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:14:08.54,0:14:11.00,Default,,0,0,0,,Сіз Элизабетсіз бе?
Dialogue: 0,0:14:11.55,0:14:12.84,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:14:12.92,0:14:13.88,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:14:14.51,0:14:16.47,Default,,0,0,0,,Өте әдемі болды.
Dialogue: 0,0:14:16.63,0:14:18.51,Default,,0,0,0,,Элизабетаның соңғы сәттері
Dialogue: 0,0:14:19.47,0:14:21.51,Default,,0,0,0,,Мен де саған көрсеткім келді.
Dialogue: 0,0:14:21.89,0:14:23.60,Default,,0,0,0,,Оның беті қорқыныштан бұрмаланды
Dialogue: 0,0:14:25.39,0:14:27.52,Default,,0,0,0,,Бұл өте дәмді болды.
Dialogue: 0,0:14:28.31,0:14:29.65,Default,,0,0,0,,Оның қаны
Dialogue: 0,0:14:30.48,0:14:32.73,Default,,0,0,0,,Сондықтан мен бәрін ішіп алдым.
Dialogue: 0,0:14:36.36,0:14:38.07,Default,,0,0,0,,Адасып кеткен Шевалье
Dialogue: 0,0:14:38.16,0:14:40.28,Default,,0,0,0,,Маған азу тістеріңді көрсетпексің бе?
Dialogue: 0,0:14:45.33,0:14:46.16,Default,,0,0,0,,Қажы?
Dialogue: 0,0:14:46.25,0:14:47.12,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:47.21,0:14:48.42,Default,,0,0,0,,Соңғы сұрақ
Dialogue: 0,0:14:49.71,0:14:52.00,Default,,0,0,0,,Сіз кім үшін өмір сүріп жатырсыз?
Dialogue: 0,0:14:52.84,0:14:54.80,Default,,0,0,0,,Сіз өзіңізге не қалайсыз?
Dialogue: 0,0:14:55.72,0:14:58.47,Default,,0,0,0,,Мені қажет ететіндер үшін
Dialogue: 0,0:14:58.55,0:14:59.80,Default,,0,0,0,,Хиротенді жеңіңіз!
Dialogue: 0,0:15:00.72,0:15:05.56,Default,,0,0,0,,Иә, бұл өте өкінішті.
Dialogue: 0,0:15:11.11,0:15:11.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:15.53,0:15:16.65,Default,,0,0,0,,О!
Dialogue: 0,0:15:19.16,0:15:20.03,Default,,0,0,0,,Қажы!
Dialogue: 0,0:15:33.04,0:15:34.13,Default,,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:15:36.34,0:15:37.51,Default,,0,0,0,,Рұқсат емес пе?
Dialogue: 0,0:15:38.42,0:15:39.26,Default,,0,0,0,,Егер сізге ұнаса
Dialogue: 0,0:15:39.34,0:15:42.80,Default,,0,0,0,,Мен сенің өміріңді кез келген уақытта алар едім.
Dialogue: 0,0:15:42.89,0:15:43.72,Default,,0,0,0,,Сіз?
Dialogue: 0,0:15:45.85,0:15:48.64,Default,,0,0,0,,Сен байқаған боларсың, Сая.
Dialogue: 0,0:15:49.23,0:15:51.94,Default,,0,0,0,,Мен адам емес екенімді түсінемін.
Dialogue: 0,0:15:52.44,0:15:54.27,Default,,0,0,0,,Сіз ондай адам емессіз.
Dialogue: 0,0:15:54.36,0:15:56.61,Default,,0,0,0,,Сіз адам болып ойнайсыз.
Dialogue: 0,0:15:56.73,0:15:58.49,Default,,0,0,0,,Бұл күлкілі әзіл.
Dialogue: 0,0:15:58.99,0:16:02.12,Default,,0,0,0,,Жалған отбасы мен достарының қоршауында
Dialogue: 0,0:16:02.20,0:16:04.58,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:16:07.91,0:16:09.58,Default,,0,0,0,,Басқалар үшін күресу керек пе?
Dialogue: 0,0:16:09.66,0:16:11.37,Default,,0,0,0,,Мен сені мазақ етіп тұрған жоқпын!
Dialogue: 0,0:16:12.13,0:16:15.71,Default,,0,0,0,,Өйткені сіз біздің бірімізсіз.
Dialogue: 0,0:16:18.80,0:16:20.55,Default,,0,0,0,,Мен мұны бұрыннан білуім керек еді.
Dialogue: 0,0:16:20.76,0:16:21.84,Default,,0,0,0,,Сіз де
Dialogue: 0,0:16:21.93,0:16:25.43,Default,,0,0,0,,Сіз аң аулауға тырысып жатқан қанаттыңыз.
Dialogue: 0,0:16:28.98,0:16:32.06,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:16:32.85,0:16:35.27,Default,,0,0,0,,Сіз де қанатты адамсыз.
Dialogue: 0,0:16:36.69,0:16:38.78,Default,,0,0,0,,барлығына өзімді дәлелдеуім керек сияқты.
Dialogue: 0,0:16:44.99,0:16:46.53,Default,,0,0,0,,Ой... Сая...
Dialogue: 0,0:16:46.62,0:16:48.45,Default,,0,0,0,,Сіз бәрін білсеңіз де
Dialogue: 0,0:16:48.54,0:16:51.33,Default,,0,0,0,,Саяға айтпайсың, Қажы.
Dialogue: 0,0:16:51.71,0:16:53.12,Default,,0,0,0,,Бұл шыбын аулағыш па?
Dialogue: 0,0:16:53.71,0:16:56.71,Default,,0,0,0,,Сен шынымен де Саяның қасында болғың келе ме?
Dialogue: 0,0:16:57.25,0:17:00.47,Default,,0,0,0,,Шевалье болу ережелеріне қайшы келсе де.
Dialogue: 0,0:17:00.76,0:17:01.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:08.35,0:17:09.18,Default,,0,0,0,,Гухаа
Dialogue: 0,0:17:09.77,0:17:10.64,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:12.27,0:17:13.10,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:17:13.23,0:17:14.06,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:18.65,0:17:19.57,Default,,0,0,0,,Қажы!
Dialogue: 0,0:17:21.19,0:17:22.95,Default,,0,0,0,,Шевалье сияқты емес
Dialogue: 0,0:17:23.61,0:17:25.11,Default,,0,0,0,,Түсінбейтін адамдар.
Dialogue: 0,0:17:26.62,0:17:28.49,Default,,0,0,0,,Сіз де солай ойлайсыз, солай ма?
Dialogue: 0,0:17:40.63,0:17:41.84,Default,,0,0,0,,Не істеймін… не істеймін!
Dialogue: 0,0:17:43.22,0:17:44.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:55.69,0:17:57.31,Default,,0,0,0,,Уф, неге?
Dialogue: 0,0:17:58.52,0:17:59.86,Default,,0,0,0,,Ойын аяқталды
Dialogue: 0,0:18:00.90,0:18:02.03,Default,,0,0,0,,Күрсін
Dialogue: 0,0:18:07.78,0:18:08.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:18.21,0:18:19.04,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:22.76,0:18:24.38,Default,,0,0,0,,Мен саған жақсы нәрсе айтайын
Dialogue: 0,0:18:27.76,0:18:29.80,Default,,0,0,0,,Сіздің отбасыңыз бар.
Dialogue: 0,0:18:29.89,0:18:31.56,Default,,0,0,0,,Нағыз отбасы
Dialogue: 0,0:18:32.39,0:18:34.98,Default,,0,0,0,,Сөзбе-сөз айтсам, қанымды бөліскен апам.
Dialogue: 0,0:18:36.23,0:18:38.15,Default,,0,0,0,,Біздің дивалар
Dialogue: 0,0:18:43.40,0:18:44.49,Default,,0,0,0,,Дива
Dialogue: 0,0:18:45.36,0:18:47.78,Default,,0,0,0,,Наги…
Dialogue: 0,0:18:49.28,0:18:50.41,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:18:50.66,0:18:55.37,Default,,0,0,0,,Сізге Қызыл қалқан әпкеңізді өлтіруді бұйырды.
Dialogue: 0,0:18:55.54,0:18:56.87,Default,,0,0,0,,Бірақ Дэвид...
Dialogue: 0,0:18:56.96,0:18:58.79,Default,,0,0,0,,Әрине, мен білдім.
Dialogue: 0,0:18:59.04,0:19:01.46,Default,,0,0,0,,Дива сенің қарындасың.
Dialogue: 0,0:19:09.09,0:19:11.10,Default,,0,0,0,,Барлығы білетін.
Dialogue: 0,0:19:12.22,0:19:14.06,Default,,0,0,0,,Әрине ол
Dialogue: 0,0:19:16.98,0:19:17.81,Default,,0,0,0,,Қажы
Dialogue: 0,0:19:18.64,0:19:19.65,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:19:19.73,0:19:23.27,Default,,0,0,0,,Достарыңыз деп ойлаған адамдар сізді сатқындықпен сезінесіз бе?
Dialogue: 0,0:19:25.40,0:19:28.07,Default,,0,0,0,,Өзіңіз туралы көбірек білгіңіз келсе
Dialogue: 0,0:19:28.15,0:19:30.03,Default,,0,0,0,,Хайуанаттар бағына барыңыз
Dialogue: 0,0:19:30.36,0:19:32.74,Default,,0,0,0,,(Юки) Менікі де. (Кёко) Ә?
Dialogue: 0,0:19:33.28,0:19:34.87,Default,,0,0,0,,Басталу орны
Dialogue: 0,0:19:36.33,0:19:38.50,Default,,0,0,0,,Ол да біледі
Dialogue: 0,0:19:53.18,0:19:54.26,Default,,0,0,0,,Бармайсың ба?
Dialogue: 0,0:19:54.97,0:19:55.89,Default,,0,0,0,,Осы жерден тартыңыз
Dialogue: 0,0:19:56.35,0:19:58.94,Default,,0,0,0,,Сіз іздеген нәрсе дәл сіздің алдыңызда, солай емес пе?
Dialogue: 0,0:20:00.23,0:20:01.65,Default,,0,0,0,,Мынау Шевалье.
Dialogue: 0,0:20:01.81,0:20:02.73,Default,,0,0,0,,Шекара Regalia-ның қалқаны әрі жалғыз қаруы болып табылады.
Dialogue: 0,0:20:03.36,0:20:04.19,Default,,0,0,0,,Мен қайтамын.
Dialogue: 0,0:20:04.32,0:20:05.19,Default,,0,0,0,,Tsk
Dialogue: 0,0:20:12.16,0:20:15.16,Default,,0,0,0,,Бұл күлкілі ме?
Dialogue: 0,0:20:15.74,0:20:18.70,Default,,0,0,0,,Дүние осылайша қанға боялған ба?
Dialogue: 0,0:20:23.00,0:20:25.25,Default,,0,0,0,,Дасвиданья Сая
Dialogue: 0,0:20:25.67,0:20:27.92,Default,,0,0,0,,Сізбен кездесу қызықты болды.
Dialogue: 0,0:21:08.46,0:21:09.55,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:21:10.26,0:21:12.01,Default,,0,0,0,,Қызуы түсіп бара жатқан сияқты.
Dialogue: 0,0:21:12.13,0:21:13.13,Default,,0,0,0,,Мен...
Dialogue: 0,0:21:14.76,0:21:15.76,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:21:17.85,0:21:18.81,Default,,0,0,0,,Сая ше?
Dialogue: 0,0:21:20.43,0:21:21.77,Default,,0,0,0,,Не? ол
Dialogue: 0,0:21:23.39,0:21:25.23,Default,,0,0,0,,Ауладан табылды.
Dialogue: 0,0:21:25.81,0:21:28.36,Default,,0,0,0,,Бұл көрші бөлмеде болды.
Dialogue: 0,0:21:32.70,0:21:34.03,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:21:34.78,0:21:35.99,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:21:55.01,0:22:01.02,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:23.64,0:23:29.65,Default,,0,0,0,,~♪
Dialogue: 0,0:23:33.69,0:23:36.99,Default,,0,0,0,,Ағай, мен Саямен вальс биледім.
Dialogue: 0,0:23:37.53,0:23:40.61,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ мен оған тартылдым.
Dialogue: 0,0:23:41.41,0:23:45.12,Default,,0,0,0,,Бірақ аға, сіз оны өлтіруді шештіңіз, солай ма?
Dialogue: 0,0:23:45.79,0:23:49.96,Default,,0,0,0,,Бір қанды бес денеге бөлеміз
Dialogue: 0,0:23:50.04,0:23:51.58,Default,,0,0,0,,Өйткені ол Диваның шевалері.
Dialogue: 0,0:23:52.54,0:23:54.34,Default,,0,0,0,,Келесі жолы «Blood Plus»
Dialogue: 0,0:23:54.67,0:23:55.88,Default,,0,0,0,,«Шевалер»
Dialogue: 0,0:23:56.42,0:23:58.92,Default,,0,0,0,,Барлығы Diva үшін
Dialogue: 0,0:24:00.42,0:24:06.42,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory