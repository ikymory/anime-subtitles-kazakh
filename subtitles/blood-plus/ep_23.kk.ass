Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.98,0:00:03.35,Default,,0,0,0,,Сол ән...
Dialogue: 0,0:00:04.48,0:00:08.19,Default,,0,0,0,,Бұл қыз дива
Dialogue: 0,0:00:09.11,0:00:12.65,Default,,0,0,0,,Менің әпкем...
Dialogue: 0,0:00:12.95,0:00:14.07,Default,,0,0,0,,Иә
Dialogue: 0,0:00:14.49,0:00:17.28,Default,,0,0,0,,Дива екеуің қандассыңдар.
Dialogue: 0,0:00:19.37,0:00:23.33,Default,,0,0,0,,Сонымен қатар біздің анамыз бен сүйіктіміз.
Dialogue: 0,0:00:24.79,0:00:25.63,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:00:28.55,0:00:29.71,Default,,0,0,0,,Сая! (Сая) Ха!
Dialogue: 0,0:00:30.38,0:00:31.34,Default,,0,0,0,,Қажы
Dialogue: 0,0:00:32.26,0:00:33.84,Default,,0,0,0,,Сіз және Дива
Dialogue: 0,0:00:34.63,0:00:35.80,Default,,0,0,0,,Осы жерде туған
Dialogue: 0,0:00:35.89,0:00:37.68,Default,,0,0,0,,және өсті
Dialogue: 0,0:00:38.68,0:00:40.02,Default,,0,0,0,,қанмен байланысты
Dialogue: 0,0:00:41.14,0:00:43.73,Default,,0,0,0,,Нағыз отбасы ретінде
Dialogue: 0,0:00:48.73,0:00:50.48,Default,,0,0,0,,Қажы! (соққы дыбысы)
Dialogue: 0,0:00:58.08,0:01:04.08,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:24.87,0:02:30.88,Default,,0,0,0,,~♪
Dialogue: 0,0:02:40.09,0:02:42.97,Default,,0,0,0,,Штабтан алынған соңғы ақпарат қандай?
Dialogue: 0,0:02:43.05,0:02:45.47,Default,,0,0,0,,4 сағат бұрын түсірілген соңғы спутниктік фотосурет
Dialogue: 0,0:02:46.52,0:02:50.48,Default,,0,0,0,,Осы суретке және жақын жерде көру ақпаратына сүйене отырып,
Dialogue: 0,0:02:50.56,0:02:53.23,Default,,0,0,0,,Сая мен Қажы осында келгеніне сенімдімін.
Dialogue: 0,0:02:53.61,0:02:56.61,Default,,0,0,0,,Хайуанаттар бағының ішінде 100 акр бар.
Dialogue: 0,0:02:56.78,0:02:57.90,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:02:57.99,0:03:00.70,Default,,0,0,0,,Бізге бөлініп, іздеу керек.
Dialogue: 0,0:03:00.78,0:03:02.37,Default,,0,0,0,,Қолды бөл...
Dialogue: 0,0:03:02.78,0:03:04.12,Default,,0,0,0,,Бұл жігіттер де?
Dialogue: 0,0:03:04.66,0:03:05.74,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:05.83,0:03:08.58,Default,,0,0,0,,Саяны қайтару үшін осы екі адам керек.
Dialogue: 0,0:03:08.79,0:03:10.87,Default,,0,0,0,,Рику! Кай! кеттік
Dialogue: 0,0:03:11.46,0:03:12.67,Default,,0,0,0,,Кай-ни-чан?
Dialogue: 0,0:03:12.75,0:03:14.96,Default,,0,0,0,,О? О
Dialogue: 0,0:03:15.55,0:03:16.80,Default,,0,0,0,,Енді барыңыз
Dialogue: 0,0:03:17.92,0:03:18.92,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:03:19.80,0:03:22.72,Default,,0,0,0,,Сізде Давид пен басқалар жалғыз әрекет етті ме?
Dialogue: 0,0:03:22.80,0:03:23.72,Default,,0,0,0,,Иә
Dialogue: 0,0:03:23.89,0:03:25.76,Default,,0,0,0,,Қан анализінің нәтижелерінен
Dialogue: 0,0:03:25.85,0:03:28.22,Default,,0,0,0,,Олар қанаттылар емес екен.
Dialogue: 0,0:03:28.77,0:03:33.15,Default,,0,0,0,,Бірақ оның Хироманға еш қатысы жоқ деп нақты айта алмаймын.
Dialogue: 0,0:03:33.48,0:03:35.19,Default,,0,0,0,,Коллинз Иә
Dialogue: 0,0:03:35.61,0:03:38.03,Default,,0,0,0,,Сіз қызыл қалқанға кірдіңіз
Dialogue: 0,0:03:38.11,0:03:40.95,Default,,0,0,0,,Бұл әкемнің ұсынысы бойынша болды, солай ма?
Dialogue: 0,0:03:41.03,0:03:45.45,Default,,0,0,0,,Иә, мен бұрынғы Джоэлге алғысым шексіз.
Dialogue: 0,0:03:46.87,0:03:49.54,Default,,0,0,0,,Осыдан үш жыл бұрын әкем қайтыс болды.
Dialogue: 0,0:03:50.25,0:03:53.12,Default,,0,0,0,,Мен бұл күнделікті мұраға қалдырамын деп шештім.
Dialogue: 0,0:03:53.42,0:03:56.92,Default,,0,0,0,,Бұл дүниеде жоқ 100 жылдан астам тарих.
Dialogue: 0,0:03:58.13,0:04:00.01,Default,,0,0,0,,Сенсіз және Давидсіз
Dialogue: 0,0:04:00.09,0:04:03.59,Default,,0,0,0,,Мен сол салмақтың астында жаншылдым.
Dialogue: 0,0:04:03.80,0:04:08.10,Default,,0,0,0,,Мен сізді мені қолдайтын маңызды отбасы деп санаймын.
Dialogue: 0,0:04:08.18,0:04:09.60,Default,,0,0,0,,Бұл құрмет.
Dialogue: 0,0:04:09.68,0:04:13.40,Default,,0,0,0,,Голдшмидт отбасының басшысына отбасы деп атай алу.
Dialogue: 0,0:04:14.31,0:04:17.40,Default,,0,0,0,,Жоғалған отбасы.
Dialogue: 0,0:04:18.82,0:04:22.03,Default,,0,0,0,,Қызыл қалқанның ресми мүшелері, соның ішінде мен,
Dialogue: 0,0:04:22.11,0:04:23.61,Default,,0,0,0,,100 адамнан аз
Dialogue: 0,0:04:23.78,0:04:29.20,Default,,0,0,0,,Бірақ олардың барлығы өз қанаттары үшін маңызды нәрсені жоғалтты.
Dialogue: 0,0:04:29.29,0:04:32.62,Default,,0,0,0,,Сондықтан да бізді берік байланыс байланыстырады.
Dialogue: 0,0:04:33.00,0:04:35.42,Default,,0,0,0,,Мен де оны жоғалтып алдым.
Dialogue: 0,0:04:35.50,0:04:38.00,Default,,0,0,0,,Хироптераны зерттеу арқылы не алуға болатын еді
Dialogue: 0,0:04:38.09,0:04:40.76,Default,,0,0,0,,Құрмет пен мақтау... бірақ
Dialogue: 0,0:04:40.84,0:04:41.92,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:42.01,0:04:43.05,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:43.51,0:04:46.01,Default,,0,0,0,,Демек, бұл менмін
Dialogue: 0,0:04:46.18,0:04:48.18,Default,,0,0,0,,Лондонға қайтып барасыз ба?
Dialogue: 0,0:04:48.39,0:04:53.02,Default,,0,0,0,,Жоқ, Рику Мияги туралы хабар болды.
Dialogue: 0,0:04:53.10,0:04:56.35,Default,,0,0,0,,Саяны хайуанаттар бағынан аман-есен алып шығады деп үміттенемін.
Dialogue: 0,0:04:56.44,0:04:58.36,Default,,0,0,0,,Мен штабта күтемін.
Dialogue: 0,0:04:58.57,0:05:00.23,Default,,0,0,0,,Енді кешіріңіз.
Dialogue: 0,0:05:01.69,0:05:04.36,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:05:06.45,0:05:07.87,Default,,0,0,0,,Хайуанаттар бағы…
Dialogue: 0,0:05:08.03,0:05:10.70,Default,,0,0,0,,Бәрінің басталатын жері осы ма?
Dialogue: 0,0:05:14.33,0:05:15.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:34.64,0:05:37.10,Default,,0,0,0,,Менің еркіне қарамастан
Dialogue: 0,0:05:37.85,0:05:40.61,Default,,0,0,0,,Бұл дене сауығып жатыр
Dialogue: 0,0:05:42.19,0:05:43.49,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:05:43.82,0:05:47.53,Default,,0,0,0,,Дива менің анам да, сүйіктім де.
Dialogue: 0,0:05:48.03,0:05:50.58,Default,,0,0,0,,Сіз түсіне аласыз ба?
Dialogue: 0,0:05:52.20,0:05:53.33,Default,,0,0,0,,Шевалье
Dialogue: 0,0:05:53.79,0:05:57.17,Default,,0,0,0,,Иә, Даеваны қорғап, соңынан еретін адам.
Dialogue: 0,0:05:58.46,0:06:00.92,Default,,0,0,0,,Мені Сүлеймен деп атаңыз
Dialogue: 0,0:06:02.21,0:06:03.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:03.96,0:06:05.17,Default,,0,0,0,,Қажы…
Dialogue: 0,0:06:05.51,0:06:06.76,Default,,0,0,0,,Фуфу
Dialogue: 0,0:06:07.09,0:06:08.93,Default,,0,0,0,,Кішкене сөйлескіңіз келе ме?
Dialogue: 0,0:06:09.93,0:06:11.26,Default,,0,0,0,,Мен сенімен біргемін
Dialogue: 0,0:06:11.39,0:06:13.18,Default,,0,0,0,,Мен мұнда ұрысуға келген жоқпын.
Dialogue: 0,0:06:13.43,0:06:14.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:17.39,0:06:19.65,Default,,0,0,0,,Маған сенесіз бе?
Dialogue: 0,0:06:20.73,0:06:22.19,Default,,0,0,0,,Мен туралы
Dialogue: 0,0:06:25.65,0:06:26.49,Default,,0,0,0,,Қажы
Dialogue: 0,0:06:26.57,0:06:27.90,Default,,0,0,0,,Онымен жалғыз
Dialogue: 0,0:06:27.99,0:06:28.82,Default,,0,0,0,,Сая
Dialogue: 0,0:06:29.03,0:06:30.28,Default,,0,0,0,,Не ойнап жүрсің осылайша кішкентай баланы таптап!
Dialogue: 0,0:06:31.78,0:06:32.62,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:06:35.79,0:06:38.58,Default,,0,0,0,,Егер сіз қаласаңыз
Dialogue: 0,0:06:42.84,0:06:44.92,Default,,0,0,0,,Ах... хехе
Dialogue: 0,0:06:45.26,0:06:47.01,Default,,0,0,0,,Сосын сол жерде.
Dialogue: 0,0:07:01.44,0:07:02.94,Default,,0,0,0,,Ah~ah
Dialogue: 0,0:07:03.90,0:07:05.82,Default,,0,0,0,,Қорқынышты нәрсе жасаңыз
Dialogue: 0,0:07:06.40,0:07:07.61,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:07:11.82,0:07:15.03,Default,,0,0,0,,Біздің осында екенімізді қайдан білдің?
Dialogue: 0,0:07:15.12,0:07:16.91,Default,,0,0,0,,Мен ағамнан сұрадым
Dialogue: 0,0:07:17.20,0:07:18.37,Default,,0,0,0,,Брат?
Dialogue: 0,0:07:18.62,0:07:21.83,Default,,0,0,0,,Мен Ресейде кездестік деп ойлаймын.
Dialogue: 0,0:07:23.04,0:07:25.71,Default,,0,0,0,,Өзіңіз туралы көбірек білгіңіз келсе
Dialogue: 0,0:07:25.80,0:07:27.63,Default,,0,0,0,,Хайуанаттар бағына барыңыз
Dialogue: 0,0:07:30.55,0:07:34.10,Default,,0,0,0,,Менің осында екенімді білу үшін жол бойы келдіңіз бе?
Dialogue: 0,0:07:34.43,0:07:35.56,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:35.72,0:07:38.68,Default,,0,0,0,,Мен бұл бос шайқасты аяқтауға келдім.
Dialogue: 0,0:07:40.06,0:07:42.27,Default,,0,0,0,,Сәтсіз шайқас?
Dialogue: 0,0:07:42.90,0:07:44.15,Default,,0,0,0,,Сіз осындасыз
Dialogue: 0,0:07:44.23,0:07:47.98,Default,,0,0,0,,Даеваға қарсы күресті бастағанымызға 100 жылдан астам уақыт өтті.
Dialogue: 0,0:07:48.11,0:07:52.45,Default,,0,0,0,,Біз қанаттар үшін бұл шайқастан ұтатын ештеңе жоқ.
Dialogue: 0,0:07:53.41,0:07:54.74,Default,,0,0,0,,Одан кім пайда көреді?
Dialogue: 0,0:07:56.91,0:07:58.37,Default,,0,0,0,,Тек адамдар
Dialogue: 0,0:08:01.00,0:08:03.79,Default,,0,0,0,,Неліктен бұл жер хайуанаттар бағы деп аталды?
Dialogue: 0,0:08:03.88,0:08:05.25,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:08:05.46,0:08:06.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:07.17,0:08:09.42,Default,,0,0,0,,Мен мұны ағамнан естідім.
Dialogue: 0,0:08:09.51,0:08:12.43,Default,,0,0,0,,Дүние жүзінен сирек кездесетін флора мен фаунаны жинау
Dialogue: 0,0:08:12.51,0:08:16.60,Default,,0,0,0,,Бұл жаңа организмдер жасауға тырысқан ғылыми-зерттеу институты болды.
Dialogue: 0,0:08:17.47,0:08:19.22,Default,,0,0,0,,Сіз де, Дива да
Dialogue: 0,0:08:19.85,0:08:22.60,Default,,0,0,0,,Бұдан ерекшелік жоқ...
Dialogue: 0,0:08:22.94,0:08:23.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:24.69,0:08:27.65,Default,,0,0,0,,Сіз эксперименттің субъектісі болдыңыз.
Dialogue: 0,0:08:28.07,0:08:31.03,Default,,0,0,0,,Менің ақшам тым көп, бос уақытым тым көп болды.
Dialogue: 0,0:08:31.11,0:08:33.86,Default,,0,0,0,,Джоэль Голдшмидт есімді адамның білуге құмарлығы
Dialogue: 0,0:08:33.95,0:08:35.16,Default,,0,0,0,,Тек қана қанағаттандыру үшін
Dialogue: 0,0:08:35.24,0:08:36.07,Default,,0,0,0,,Өтірікші...
Dialogue: 0,0:08:36.45,0:08:38.54,Default,,0,0,0,,Оны қалай жоққа шығаруға болады?
Dialogue: 0,0:08:38.95,0:08:40.12,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:08:40.58,0:08:44.04,Default,,0,0,0,,Өйткені Джоэл маған мейірімді болды.
Dialogue: 0,0:08:44.46,0:08:46.75,Default,,0,0,0,,Ол менен бірдеңе сұрады.
Dialogue: 0,0:08:47.17,0:08:48.50,Default,,0,0,0,,Онда есеп бар.
Dialogue: 0,0:08:48.59,0:08:50.55,Default,,0,0,0,,Сіз бұл туралы ойлаған жоқсыз ба?
Dialogue: 0,0:08:53.30,0:08:56.30,Default,,0,0,0,,Бірақ... сенгім келеді
Dialogue: 0,0:08:56.39,0:08:58.47,Default,,0,0,0,,Ха... Шамасы, сен
Dialogue: 0,0:08:58.56,0:09:01.43,Default,,0,0,0,,Сіз адамдардың арасында тым ұзақ болған сияқтысыз.
Dialogue: 0,0:09:02.10,0:09:04.06,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:09:06.90,0:09:08.86,Default,,0,0,0,,Мен бұл туралы ешқашан айтқан емеспін.
Dialogue: 0,0:09:08.94,0:09:10.73,Default,,0,0,0,,Мен туралы қайдан білесің!
Dialogue: 0,0:09:10.82,0:09:11.65,Default,,0,0,0,,О, демек, сен бұл туралы ашық айтып отырсың ғой.
Dialogue: 0,0:09:11.90,0:09:13.19,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:09:13.49,0:09:14.65,Default,,0,0,0,,О, демек, сен бұл туралы ашық айтып отырсың ғой.
Dialogue: 0,0:09:16.36,0:09:17.53,Default,,0,0,0,,О, демек, сен бұл туралы ашық айтып отырсың ғой.
Dialogue: 0,0:09:17.62,0:09:21.37,Default,,0,0,0,,Мен сенің нағыз қандас отбасыңмын.
Dialogue: 0,0:09:24.83,0:09:25.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:26.58,0:09:30.34,Default,,0,0,0,,Сен мұнда білу үшін келдің ғой, солай емес пе?
Dialogue: 0,0:09:30.84,0:09:33.26,Default,,0,0,0,,Нағыз отбасыңызды біліңіз
Dialogue: 0,0:09:33.34,0:09:36.55,Default,,0,0,0,,Жалған отбасымен қарым-қатынасымды тоқтату
Dialogue: 0,0:09:37.68,0:09:39.05,Default,,0,0,0,,Бұл өтірік емес
Dialogue: 0,0:09:40.14,0:09:41.26,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:09:41.68,0:09:44.60,Default,,0,0,0,,Кай да, Рику да мені қабылдайды!
Dialogue: 0,0:09:44.68,0:09:46.39,Default,,0,0,0,,Олар мені отбасы деп атайды!
Dialogue: 0,0:09:46.89,0:09:50.82,Default,,0,0,0,,Қандас болмасақ та, біз бәрібір отбасымыз.
Dialogue: 0,0:09:50.98,0:09:53.48,Default,,0,0,0,,Мен әкемнің қызымын!
Dialogue: 0,0:09:54.36,0:09:58.95,Default,,0,0,0,,Мен сіз ұзақ жылдар бойы сол қалпында қаласыз деп үміттенемін.
Dialogue: 0,0:09:59.03,0:10:00.20,Default,,0,0,0,,Олар біледі ме?
Dialogue: 0,0:10:01.33,0:10:02.33,Default,,0,0,0,,Мен мұндай боларын ойламаппын.
Dialogue: 0,0:10:03.37,0:10:04.45,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:04.83,0:10:09.13,Default,,0,0,0,,Олар қансыз өмір сүре алмайтынын біледі ме?
Dialogue: 0,0:10:09.46,0:10:11.04,Default,,0,0,0,,Қарап тұрсаңыз да
Dialogue: 0,0:10:12.21,0:10:15.97,Default,,0,0,0,,Олар сізді отбасы ретінде қабылдай ала ма?
Dialogue: 0,0:10:17.88,0:10:20.68,Default,,0,0,0,,Мен сенімен ондаған жылдар бойы ұйықтаймын
Dialogue: 0,0:10:20.76,0:10:23.35,Default,,0,0,0,,Демалмай қарауды жалғастыру
Dialogue: 0,0:10:24.60,0:10:26.60,Default,,0,0,0,,Қалай ойлайсыңдар, адамдар мұны істей алады ма?
Dialogue: 0,0:10:27.77,0:10:29.10,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:10:31.86,0:10:36.11,Default,,0,0,0,,Сіз әлі де жадыңыздың көп бөлігін қалпына келтірген жоқсыз.
Dialogue: 0,0:10:39.61,0:10:41.24,Default,,0,0,0,,Сіз және Дива
Dialogue: 0,0:10:41.32,0:10:44.41,Default,,0,0,0,,Бірнеше жыл қысқа мерзімнен кейін,
Dialogue: 0,0:10:44.58,0:10:47.16,Default,,0,0,0,,30 жылға жуық ұйықтау
Dialogue: 0,0:10:48.58,0:10:50.33,Default,,0,0,0,,Коконда
Dialogue: 0,0:10:52.17,0:10:53.00,Default,,0,0,0,,Кокон?
Dialogue: 0,0:11:01.30,0:11:04.14,Default,,0,0,0,,( тербелген ағаштардың дыбысы)
Dialogue: 0,0:11:05.10,0:11:06.56,Default,,0,0,0,,Мен?
Dialogue: 0,0:11:11.31,0:11:12.23,Default,,0,0,0,,Сая!
Dialogue: 0,0:11:18.44,0:11:19.61,Default,,0,0,0,,Сая!
Dialogue: 0,0:11:23.99,0:11:25.99,Default,,0,0,0,,Сая осы жылы дүниеге келген!
Dialogue: 0,0:11:26.08,0:11:27.16,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:28.62,0:11:30.16,Default,,0,0,0,,Амал жоқ
Dialogue: 0,0:11:30.25,0:11:31.46,Default,,0,0,0,,Бұлай болуы мүмкін емес!
Dialogue: 0,0:11:34.84,0:11:37.21,Default,,0,0,0,,Ал бұл не нәрсе?
Dialogue: 0,0:11:37.30,0:11:39.84,Default,,0,0,0,,Егер бұл Сайоның анасы болса.
Dialogue: 0,0:11:40.30,0:11:41.13,Default,,0,0,0,,Сайо...
Dialogue: 0,0:11:41.22,0:11:43.47,Default,,0,0,0,,Сая байқап қалуы керек еді.
Dialogue: 0,0:11:44.30,0:11:46.85,Default,,0,0,0,,Мен адам емеспін
Dialogue: 0,0:11:51.06,0:11:52.85,Default,,0,0,0,,Мен қандаспын.
Dialogue: 0,0:11:53.69,0:11:55.44,Default,,0,0,0,,Өз халқымен соғысу
Dialogue: 0,0:11:59.69,0:12:00.99,Default,,0,0,0,,Уг!?
Dialogue: 0,0:12:07.37,0:12:10.08,Default,,0,0,0,,Сіз байқадыңыз, солай емес пе?
Dialogue: 0,0:12:13.79,0:12:15.38,Default,,0,0,0,,Сіз адам емессіз
Dialogue: 0,0:12:16.42,0:12:18.34,Default,,0,0,0,,Біз сияқты қанаттылар
Dialogue: 0,0:12:18.42,0:12:20.47,Default,,0,0,0,,Түрлер ханшайымының қанына ие болу
Dialogue: 0,0:12:20.55,0:12:24.72,Default,,0,0,0,,Ол біздің анамыз және сүйіктіміз.
Dialogue: 0,0:12:25.22,0:12:28.68,Default,,0,0,0,,Менің... қаным
Dialogue: 0,0:12:31.98,0:12:33.56,Default,,0,0,0,,Дивамен
Dialogue: 0,0:12:35.86,0:12:37.23,Default,,0,0,0,,Бұл да…
Dialogue: 0,0:12:41.11,0:12:42.49,Default,,0,0,0,,Сая...
Dialogue: 0,0:13:00.87,0:13:05.21,Default,,0,0,0,,Сайо-ничан, ол әлдеқашан бір жерге кетті ме деп ойлаймын.
Dialogue: 0,0:13:11.22,0:13:12.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:18.64,0:13:22.23,Default,,0,0,0,,Кешіріңіз, мен сізді қорқытқым келмеді.
Dialogue: 0,0:13:28.49,0:13:29.86,Default,,0,0,0,,Алайда, осы жағдайда біз әлі де кісі өлтірулердің қалай жасалып жатқанын білмейміз.
Dialogue: 0,0:13:29.95,0:13:31.95,Default,,0,0,0,,Лицейдегі кеш
Dialogue: 0,0:13:32.78,0:13:35.24,Default,,0,0,0,,Сіз оны сол кезде байқадыңыз ба?
Dialogue: 0,0:13:35.53,0:13:39.16,Default,,0,0,0,,Мен Диваның шевалерімін
Dialogue: 0,0:13:41.08,0:13:43.50,Default,,0,0,0,,Мен оны мүлде байқамадым
Dialogue: 0,0:13:45.09,0:13:47.00,Default,,0,0,0,,Мен сенің Сая екеніңді білмедім.
Dialogue: 0,0:13:47.88,0:13:52.59,Default,,0,0,0,,Ағам екеуміз жау болдық деп көп айтты.
Dialogue: 0,0:13:53.51,0:13:54.97,Default,,0,0,0,,Бұл түн қандай болды?
Dialogue: 0,0:13:56.72,0:14:00.18,Default,,0,0,0,,Сіз де мен сияқты сезімде болғаныңызға сенімдімін.
Dialogue: 0,0:14:04.15,0:14:06.11,Default,,0,0,0,,Кем дегенде сол уақытта
Dialogue: 0,0:14:06.19,0:14:08.69,Default,,0,0,0,,Мені ешқашан жау санамадың.
Dialogue: 0,0:14:11.19,0:14:12.03,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:14:13.78,0:14:18.79,Default,,0,0,0,,Біз бір-бірімізді ренжітуге арналмағанбыз.
Dialogue: 0,0:14:19.33,0:14:20.83,Default,,0,0,0,,Барлық трагедиялар
Dialogue: 0,0:14:20.91,0:14:24.54,Default,,0,0,0,,Өйткені сіз мұнда адам қолымен өскенсіз.
Dialogue: 0,0:14:24.92,0:14:25.75,Default,,0,0,0,,Бұл басталды.
Dialogue: 0,0:14:26.67,0:14:29.88,Default,,0,0,0,,Сол себепті сен жалған отбасындасың
Dialogue: 0,0:14:29.96,0:14:32.22,Default,,0,0,0,,Махаббатты табуға тырысу
Dialogue: 0,0:14:32.80,0:14:33.76,Default,,0,0,0,,Бұл өтірік емес!
Dialogue: 0,0:14:36.22,0:14:38.51,Default,,0,0,0,,Өтірік емес Өтірік емес!
Dialogue: 0,0:14:39.01,0:14:40.43,Default,,0,0,0,,Бұл өтірік емес!
Dialogue: 0,0:14:40.85,0:14:43.19,Default,,0,0,0,,Мен әрқашан бақытты болдым!
Dialogue: 0,0:14:43.27,0:14:46.10,Default,,0,0,0,,Мен осында болған кезде және Окинавада болған кезде
Dialogue: 0,0:14:46.19,0:14:47.36,Default,,0,0,0,,Мен әрқашан...
Dialogue: 0,0:14:47.52,0:14:49.48,Default,,0,0,0,,Бұл шынымен де солай ма?
Dialogue: 0,0:14:51.40,0:14:53.20,Default,,0,0,0,,Сіздің бақытыңыз
Dialogue: 0,0:14:53.28,0:14:56.24,Default,,0,0,0,,Егер ол біздің өмірімізде адамдармен бірге болса.
Dialogue: 0,0:14:56.32,0:14:58.24,Default,,0,0,0,,Неліктен адамдар сізді таңдайды?
Dialogue: 0,0:14:58.33,0:15:01.95,Default,,0,0,0,,Бізді қандастармен шайқасқа шақырасың ба?
Dialogue: 0,0:15:02.91,0:15:05.04,Default,,0,0,0,,Сізді адамдар пайдаланып жатыр.
Dialogue: 0,0:15:05.67,0:15:07.13,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:15:07.21,0:15:08.96,Default,,0,0,0,,Бұл қате болды.
Dialogue: 0,0:15:09.25,0:15:10.80,Default,,0,0,0,,Сіз қанатты адамсыз
Dialogue: 0,0:15:10.88,0:15:13.84,Default,,0,0,0,,Адамдармен бірге өмір сүрудің өзі
Dialogue: 0,0:15:13.92,0:15:15.63,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:15:16.72,0:15:20.35,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:15:22.31,0:15:24.18,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:15:25.39,0:15:27.02,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:15:27.10,0:15:28.86,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:15:29.02,0:15:31.48,Default,,0,0,0,,Окабе?
Dialogue: 0,0:15:32.65,0:15:34.44,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:15:37.86,0:15:38.99,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:46.29,0:15:48.17,Default,,0,0,0,,Кай, не болды?
Dialogue: 0,0:15:50.00,0:15:50.84,Default,,0,0,0,,Сай...
Dialogue: 0,0:15:52.34,0:15:55.22,Default,,0,0,0,,Сая әлі біз жақта ма?
Dialogue: 0,0:15:57.38,0:15:58.84,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:15:58.93,0:16:03.89,Default,,0,0,0,,Саяның бізбен тұрғаны шынымен бақытты ма?
Dialogue: 0,0:16:04.10,0:16:06.73,Default,,0,0,0,,Саяның өткенін білгеннен кейін қорқып қалдыңыз ба?
Dialogue: 0,0:16:06.81,0:16:07.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:10.98,0:16:14.94,Default,,0,0,0,,Егер сізде осындай шешімділік болса, сіз бұл жерден дереу кетуіңіз керек.
Dialogue: 0,0:16:15.19,0:16:18.78,Default,,0,0,0,,Бұл сізге және Саяға.
Dialogue: 0,0:16:20.74,0:16:21.83,Default,,0,0,0,,Мен бірінші барамын
Dialogue: 0,0:16:26.04,0:16:29.46,Default,,0,0,0,,Джордж бәрін біліп, оны қабылдады.
Dialogue: 0,0:16:29.71,0:16:30.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:32.25,0:16:33.80,Default,,0,0,0,,Барлығы
Dialogue: 0,0:16:36.38,0:16:37.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:43.18,0:16:44.01,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:44.68,0:16:46.10,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:16:47.64,0:16:49.98,Default,,0,0,0,,Ағаң сені өлтірмекші.
Dialogue: 0,0:16:50.19,0:16:51.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:51.52,0:16:52.86,Default,,0,0,0,,Басқа ағайындар да
Dialogue: 0,0:16:53.90,0:16:54.73,Default,,0,0,0,,Ол жай ғана біреудің оны кешіруін қалады ғой, иә?
Dialogue: 0,0:16:56.36,0:16:57.19,Default,,0,0,0,,Бірақ
Dialogue: 0,0:16:57.44,0:16:59.74,Default,,0,0,0,,Мен сенің өлгеніңді қаламаймын
Dialogue: 0,0:16:59.95,0:17:00.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:01.66,0:17:04.70,Default,,0,0,0,,Егер сіз бізбен бірге жүргіңіз келсе
Dialogue: 0,0:17:04.78,0:17:07.41,Default,,0,0,0,,Ағаңның түсінетініне сенімдімін.
Dialogue: 0,0:17:07.75,0:17:11.42,Default,,0,0,0,,Сізде қиналатын ештеңе жоқ.
Dialogue: 0,0:17:12.88,0:17:14.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:18.88,0:17:19.72,Default,,0,0,0,,Сонымен
Dialogue: 0,0:17:24.55,0:17:25.97,Default,,0,0,0,,Менімен бірге
Dialogue: 0,0:17:40.07,0:17:41.36,Default,,0,0,0,,Сая! (Сая) Ха!
Dialogue: 0,0:17:45.12,0:17:46.20,Default,,0,0,0,,18-ші эпизод: Венецияға!
Dialogue: 0,0:17:46.95,0:17:48.41,Default,,0,0,0,,Қажы... иә
Dialogue: 0,0:17:49.54,0:17:52.08,Default,,0,0,0,,Екеуі де Шевальер болса да
Dialogue: 0,0:17:52.17,0:17:54.58,Default,,0,0,0,,Мен сізді түсінбеймін.
Dialogue: 0,0:17:54.96,0:17:57.00,Default,,0,0,0,,Мен сол күні ант бердім
Dialogue: 0,0:17:57.25,0:17:58.76,Default,,0,0,0,,Саяның тілегі орындалса
Dialogue: 0,0:17:59.84,0:18:02.01,Default,,0,0,0,,Менің... тілегім?
Dialogue: 0,0:18:02.76,0:18:04.47,Default,,0,0,0,,Мен Саяны тастамаймын.
Dialogue: 0,0:18:06.64,0:18:08.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:14.48,0:18:16.15,Default,,0,0,0,,Мен онымен сөйлесемін.
Dialogue: 0,0:18:16.94,0:18:18.53,Default,,0,0,0,,Қысқаша қоштасу
Dialogue: 0,0:18:19.69,0:18:20.99,Default,,0,0,0,,Тоқта! Екеуміз де!
Dialogue: 0,0:18:21.40,0:18:22.24,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:18:23.66,0:18:24.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:31.04,0:18:32.33,Default,,0,0,0,,Бұл ән.
Dialogue: 0,0:18:32.66,0:18:33.62,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:55.56,0:18:58.48,Default,,0,0,0,,Егер сіз Түннің Шевалері болсаңыз
Dialogue: 0,0:18:58.57,0:19:01.44,Default,,0,0,0,,Қожайынның бақытын тілеу керек емес пе?
Dialogue: 0,0:19:02.19,0:19:03.90,Default,,0,0,0,,Саяның тілегі
Dialogue: 0,0:19:04.07,0:19:05.28,Default,,0,0,0,,Бұл менің тілегім!
Dialogue: 0,0:19:06.16,0:19:07.57,Default,,0,0,0,,Төзгісіз
Dialogue: 0,0:19:15.29,0:19:16.12,Default,,0,0,0,,Иә
Dialogue: 0,0:19:18.00,0:19:18.84,Default,,0,0,0,,Сая ше?
Dialogue: 0,0:19:20.00,0:19:21.09,Default,,0,0,0,,Мұнда емес
Dialogue: 0,0:19:22.05,0:19:23.42,Default,,0,0,0,,Кай мен Рику ше?
Dialogue: 0,0:19:23.51,0:19:25.05,Default,,0,0,0,,Оның таратқышы болады.
Dialogue: 0,0:19:25.47,0:19:28.93,Default,,0,0,0,,Ха... Мен ауқымдамын деп үміттенемін.
Dialogue: 0,0:19:30.60,0:19:35.10,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:19:37.27,0:19:38.94,Default,,0,0,0,,Сайо-ничан
Dialogue: 0,0:19:39.48,0:19:40.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:47.28,0:19:50.41,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:19:53.54,0:19:55.00,Default,,0,0,0,,Сондықтан сен өлесің.
Dialogue: 0,0:20:04.51,0:20:06.13,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:14.52,0:20:16.10,Default,,0,0,0,,Сонымен қатар, сыртта Реммен сөйлескенде,
Dialogue: 0,0:20:25.19,0:20:28.24,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:20:52.05,0:20:53.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:54.06,0:20:55.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:57.10,0:20:58.35,Default,,0,0,0,,Сайо-ничан!
Dialogue: 0,0:20:58.56,0:20:59.35,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:01.73,0:21:03.23,Default,,0,0,0,,Ән...
Dialogue: 0,0:21:07.15,0:21:10.03,Default,,0,0,0,,(Баспалдақпен жүгіру дыбысы)
Dialogue: 0,0:21:27.26,0:21:28.09,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:38.48,0:21:39.81,Default,,0,0,0,,Рику…
Dialogue: 0,0:21:54.99,0:22:01.00,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:23.83,0:23:29.84,Default,,0,0,0,,~♪
Dialogue: 0,0:23:30.75,0:23:32.26,Default,,0,0,0,,Өткенді жаңғырту
Dialogue: 0,0:23:32.34,0:23:34.22,Default,,0,0,0,,Естеліктер қайта жаңғырды
Dialogue: 0,0:23:34.34,0:23:35.97,Default,,0,0,0,,Жаңғырған ән дауысымен
Dialogue: 0,0:23:36.05,0:23:37.80,Default,,0,0,0,,Жаңғыртылған айқай
Dialogue: 0,0:23:38.18,0:23:40.97,Default,,0,0,0,,Құлаған раушан гүлдер мен гүлдеген жалындар
Dialogue: 0,0:23:41.47,0:23:44.85,Default,,0,0,0,,Қайталанатын трагедиялар жүрегімді де, санамды да сілкіндіреді.
Dialogue: 0,0:23:45.73,0:23:48.23,Default,,0,0,0,,Ал менің алдымда тұрған фигура
Dialogue: 0,0:23:48.44,0:23:49.81,Default,,0,0,0,,Бұл Дива
Dialogue: 0,0:23:50.19,0:23:51.98,Default,,0,0,0,,менің әпкем
Dialogue: 0,0:23:52.57,0:23:54.65,Default,,0,0,0,,Келесі жолы «Blood Plus»
Dialogue: 0,0:23:54.78,0:23:55.82,Default,,0,0,0,,«Жеңіл ән айтатын дауыс»
Dialogue: 0,0:23:56.57,0:23:58.24,Default,,0,0,0,,Қош келдіңіз, апа.
Dialogue: 0,0:23:58.32,0:23:59.82,Default,,0,0,0,,Кристалда жарық жүздеген миллион рет шағылады—
Dialogue: 0,0:24:01.32,0:24:07.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory