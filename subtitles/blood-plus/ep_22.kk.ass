Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:18.36,0:00:20.45,Default,,0,0,0,,Бұл хайуанаттар бағы...
Dialogue: 0,0:00:37.99,0:00:38.91,Default,,0,0,0,,Қажы…
Dialogue: 0,0:00:48.88,0:00:54.90,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:15.52,0:02:21.53,Default,,0,0,0,,~♪
Dialogue: 0,0:02:32.42,0:02:34.43,Default,,0,0,0,,Барлығы теріс
Dialogue: 0,0:02:34.72,0:02:35.81,Default,,0,0,0,,Жақсы~
Dialogue: 0,0:02:36.43,0:02:38.35,Default,,0,0,0,,Енді сіздің күмәніңіз жойылды.
Dialogue: 0,0:02:38.98,0:02:41.07,Default,,0,0,0,,Мен Саяны таба аламын.
Dialogue: 0,0:02:41.65,0:02:43.82,Default,,0,0,0,,Саяның ізденіс жағдайы қандай?
Dialogue: 0,0:02:44.62,0:02:48.87,Default,,0,0,0,,Іздеу тобы алған көру ақпараты бойынша анықталған мақсат
Dialogue: 0,0:02:49.04,0:02:50.08,Default,,0,0,0,,Point Origin сияқты көрінеді.
Dialogue: 0,0:02:53.38,0:02:54.55,Default,,0,0,0,,Бұл тек қана достық теннис матчы.
Dialogue: 0,0:02:55.05,0:02:56.81,Default,,0,0,0,,Бастауыш неден тұрады?
Dialogue: 0,0:02:56.89,0:03:00.56,Default,,0,0,0,,«Джоэлдің күнделігіндегі» хайуанаттар бағы туралы
Dialogue: 0,0:03:01.07,0:03:01.98,Default,,0,0,0,,(Юки) Менікі де. (Кёко) Ә?
Dialogue: 0,0:03:02.61,0:03:03.65,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:03:03.82,0:03:04.66,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:06.58,0:03:08.79,Default,,0,0,0,,Саяның туған жері.
Dialogue: 0,0:04:01.52,0:04:04.07,Default,,0,0,0,,Джоэл Бұл бала кім?
Dialogue: 0,0:04:04.82,0:04:05.65,Default,,0,0,0,,Қажы
Dialogue: 0,0:04:08.95,0:04:10.83,Default,,0,0,0,,Мен сенің досыңмын
Dialogue: 0,0:04:12.12,0:04:13.38,Default,,0,0,0,,Сау бол, Джоджо!
Dialogue: 0,0:04:13.84,0:04:15.46,Default,,0,0,0,,Бүгіннен бастап мен осында тұрамын.
Dialogue: 0,0:04:16.59,0:04:18.64,Default,,0,0,0,,Маған әртүрлі нәрселерді үйретіңіз.
Dialogue: 0,0:04:18.97,0:04:20.77,Default,,0,0,0,,Тату болайық
Dialogue: 0,0:04:20.98,0:04:21.94,Default,,0,0,0,,Иә
Dialogue: 0,0:04:26.86,0:04:27.65,Default,,0,0,0,,қоғамдық бейбітшілік хатын алмастыру үшін, иә?
Dialogue: 0,0:04:27.82,0:04:30.03,Default,,0,0,0,,Қажымен алғаш рет кездескенім туралы
Dialogue: 0,0:04:32.41,0:04:34.29,Default,,0,0,0,,Бұл субұрқақтың алдында болды.
Dialogue: 0,0:04:36.97,0:04:39.89,Default,,0,0,0,,Мен... Мен аздап өзімшіл болдым, солай емес пе?
Dialogue: 0,0:04:41.68,0:04:42.94,Default,,0,0,0,,Маған мұндай түсті раушан гүлдер ұнамайды!
Dialogue: 0,0:04:43.94,0:04:45.36,Default,,0,0,0,,Қызыл түсті таңдаңыз
Dialogue: 0,0:04:48.24,0:04:49.36,Default,,0,0,0,,Тез жүріңіз
Dialogue: 0,0:04:51.79,0:04:53.25,Default,,0,0,0,,Өзіңіз жүріңіз
Dialogue: 0,0:04:55.34,0:04:57.51,Default,,0,0,0,,Сіз қандай ақылдысыз!
Dialogue: 0,0:04:59.34,0:05:01.81,Default,,0,0,0,,Мені ұнатпайынша сөйлеспе
Dialogue: 0,0:05:03.27,0:05:04.73,Default,,0,0,0,,Мен ол қызды жек көремін
Dialogue: 0,0:05:05.02,0:05:05.90,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:05:06.40,0:05:08.49,Default,,0,0,0,,Менің айтқанымды тыңдамайсың
Dialogue: 0,0:05:09.28,0:05:11.95,Default,,0,0,0,,Аяқ киіміңді жылтырат десем де, жылтыратпайды.
Dialogue: 0,0:05:12.58,0:05:14.75,Default,,0,0,0,,Киім ауыстыруға көмектесші десем де.
Dialogue: 0,0:05:14.92,0:05:17.13,Default,,0,0,0,,Бөлмеден ашық қызыл бетпен шығыңыз.
Dialogue: 0,0:05:18.30,0:05:22.51,Default,,0,0,0,,Түсіндім, сонда біз дос бола алмаймыз.
Dialogue: 0,0:05:22.97,0:05:24.14,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:24.56,0:05:27.32,Default,,0,0,0,,Баланың сезіміне көбірек көңіл бөліңіз.
Dialogue: 0,0:05:27.40,0:05:29.11,Default,,0,0,0,,Басқаларға мейірімді бол
Dialogue: 0,0:05:29.19,0:05:32.28,Default,,0,0,0,,Иә, балалар, ақырында...
Dialogue: 0,0:05:33.12,0:05:34.04,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:34.87,0:05:36.84,Default,,0,0,0,,Сізбен бірге болған адам
Dialogue: 0,0:05:37.13,0:05:39.63,Default,,0,0,0,,Сезімдерің өзгерді ме?
Dialogue: 0,0:05:40.72,0:05:41.55,Default,,0,0,0,,Иә
Dialogue: 0,0:05:47.56,0:05:48.57,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:49.03,0:05:50.70,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:05:53.74,0:05:56.17,Default,,0,0,0,,Емдеуге аз қалды.
Dialogue: 0,0:06:03.10,0:06:04.56,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:06:05.68,0:06:07.31,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:06:07.98,0:06:10.57,Default,,0,0,0,,Хм, басың айналып тұрған жоқ па?
Dialogue: 0,0:06:10.94,0:06:11.78,Default,,0,0,0,,Иә
Dialogue: 0,0:06:12.36,0:06:16.12,Default,,0,0,0,,Әй, мен Қажыға виолончельде ойнауды үйретейін бе?
Dialogue: 0,0:06:16.58,0:06:20.30,Default,,0,0,0,,Егер біз осылай жасасақ, біз дос бола аламыз, солай ма? Әрине
Dialogue: 0,0:06:21.55,0:06:23.18,Default,,0,0,0,,Мүмкін солай.
Dialogue: 0,0:06:23.72,0:06:26.52,Default,,0,0,0,,Сая не қаласа соны істе.
Dialogue: 0,0:06:27.31,0:06:29.94,Default,,0,0,0,,(виолончельде нашар орындау)
Dialogue: 0,0:06:32.70,0:06:34.99,Default,,0,0,0,,Егер жоқ болса! қазірдің өзінде!
Dialogue: 0,0:06:35.70,0:06:36.75,Default,,0,0,0,,Оны жібермеуім керек еді....
Dialogue: 0,0:06:36.83,0:06:39.50,Default,,0,0,0,,Садақ жіппен түзу болуы керек.
Dialogue: 0,0:06:40.00,0:06:41.42,Default,,0,0,0,,Мен мұны бұрын айтқан жоқпын ба?
Dialogue: 0,0:06:43.01,0:06:44.43,Default,,0,0,0,,Басынан қайтадан
Dialogue: 0,0:06:47.18,0:06:48.90,Default,,0,0,0,,Не? Ойна
Dialogue: 0,0:06:52.74,0:06:55.16,Default,,0,0,0,,Ах! Сен не істеп жатырсың?
Dialogue: 0,0:06:55.37,0:06:57.96,Default,,0,0,0,,Джоэл менің саған көп нәрсені үйреткенімді қалайды.
Dialogue: 0,0:06:58.04,0:06:58.96,Default,,0,0,0,,Неге әуре...
Dialogue: 0,0:06:59.08,0:07:00.54,Default,,0,0,0,,Бұл қажетсіз көмек.
Dialogue: 0,0:07:01.63,0:07:03.38,Default,,0,0,0,,Менің досым болғың келсе
Dialogue: 0,0:07:03.46,0:07:05.13,Default,,0,0,0,,Виолончельде ойнай білу
Dialogue: 0,0:07:06.13,0:07:08.60,Default,,0,0,0,,Ән айтып, би билеп жақсы дайындалған.
Dialogue: 0,0:07:09.43,0:07:11.10,Default,,0,0,0,,Онда маған көрсет.
Dialogue: 0,0:07:12.10,0:07:13.98,Default,,0,0,0,,Мен сенімен бірге боламын.
Dialogue: 0,0:07:16.20,0:07:17.45,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:07:17.53,0:07:18.83,Default,,0,0,0,,Мен оны сізге сәйкестендіремін.
Dialogue: 0,0:07:20.87,0:07:21.87,Default,,0,0,0,,Сіз алмайсыз ба?
Dialogue: 0,0:07:22.88,0:07:24.96,Default,,0,0,0,,Егер мені тыңдамасаң
Dialogue: 0,0:07:25.17,0:07:27.47,Default,,0,0,0,,Осы жерден кетіп, бұрынғы жеріңізге қайтыңыз!
Dialogue: 0,0:07:29.72,0:07:30.68,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:07:31.48,0:07:32.77,Default,,0,0,0,,Мен бәрін істеймін
Dialogue: 0,0:07:33.36,0:07:35.03,Default,,0,0,0,,Түнгі серіктес немесе кез келген нәрсе
Dialogue: 0,0:07:35.53,0:07:38.66,Default,,0,0,0,,Балалар, бәрібір мені сатып алдыңдар!
Dialogue: 0,0:07:52.14,0:07:55.53,Default,,0,0,0,,Маған олай қарама. Уф...
Dialogue: 0,0:08:00.83,0:08:01.79,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:08:01.87,0:08:02.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:08.97,0:08:11.26,Default,,0,0,0,,Бұл жағдайда не істеуім керек?
Dialogue: 0,0:08:13.23,0:08:15.11,Default,,0,0,0,,Джоэл мен жылағанда айтады
Dialogue: 0,0:08:15.52,0:08:17.99,Default,,0,0,0,,Сен мені құшақтап, бәрі жақсы деп айтасың ба?
Dialogue: 0,0:08:18.24,0:08:21.41,Default,,0,0,0,,Сонда мен аздап жеңілдеп қаламын.
Dialogue: 0,0:08:22.24,0:08:24.08,Default,,0,0,0,,Қажы қандай көрінеді?
Dialogue: 0,0:08:37.44,0:08:41.20,Default,,0,0,0,,Ол кезде мен кешірім сұрауды да білмедім.
Dialogue: 0,0:08:47.96,0:08:49.93,Default,,0,0,0,,Сол гүлді не істеуіміз керек?
Dialogue: 0,0:08:50.59,0:08:52.05,Default,,0,0,0,,Бұл Джоэлдің сүйікті гүлі.
Dialogue: 0,0:08:55.23,0:08:56.27,Default,,0,0,0,,Иә
Dialogue: 0,0:08:58.11,0:08:58.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:59.36,0:09:00.57,Default,,0,0,0,,(Ешкі жылау)
Dialogue: 0,0:09:02.28,0:09:03.24,Default,,0,0,0,,Сәлем Сая!
Dialogue: 0,0:09:04.04,0:09:05.37,Default,,0,0,0,,Мұнда кел!
Dialogue: 0,0:09:13.26,0:09:14.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:16.44,0:09:17.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:21.99,0:09:24.45,Default,,0,0,0,,Мұнда жануарлар өте көп.
Dialogue: 0,0:09:25.12,0:09:27.54,Default,,0,0,0,,Бірақ ол менің досым емес.
Dialogue: 0,0:09:42.95,0:09:45.66,Default,,0,0,0,,Амансың ба? Суық емес пе?
Dialogue: 0,0:09:46.20,0:09:47.04,Default,,0,0,0,,Иә
Dialogue: 0,0:09:51.26,0:09:52.51,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:52.68,0:09:55.97,Default,,0,0,0,,Қажы менің жанымда болады, солай ма?
Dialogue: 0,0:10:05.74,0:10:08.41,Default,,0,0,0,,Джоэлден басқа тірі ештеңе жоқ
Dialogue: 0,0:10:08.58,0:10:11.51,Default,,0,0,0,,Барлығы маған жақындамайды деп ойладым.
Dialogue: 0,0:10:11.67,0:10:14.84,Default,,0,0,0,,Себебі Сайо өзімшіл, солай ма?
Dialogue: 0,0:10:16.06,0:10:16.89,Default,,0,0,0,,Біз әдетте соншалықты алдын ала брондамаймыз, сондықтан асығыс емесбіз
Dialogue: 0,0:10:17.81,0:10:18.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:19.69,0:10:23.07,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:10:23.70,0:10:26.08,Default,,0,0,0,,Өйткені Қажы қара сөздер айтады.
Dialogue: 0,0:10:26.95,0:10:29.29,Default,,0,0,0,,Уфуфуфуфуфуфуфуфуфу…
Dialogue: 0,0:10:33.47,0:10:37.06,Default,,0,0,0,,Содан бері Қажымен біргесің.
Dialogue: 0,0:10:44.82,0:10:45.70,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:10:45.87,0:10:46.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:54.30,0:10:56.64,Default,,0,0,0,,Мұғалім енді менің серіктесім емес.
Dialogue: 0,0:10:58.06,0:11:02.36,Default,,0,0,0,,Бір күні қолыма қылыш алып әлемді шарлаймын
Dialogue: 0,0:11:02.98,0:11:04.90,Default,,0,0,0,,Сонымен, сіз жаттығуға құмарсыз ба?
Dialogue: 0,0:11:05.78,0:11:06.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:11.12,0:11:12.13,Default,,0,0,0,,Сәлем Қажы
Dialogue: 0,0:11:12.25,0:11:13.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:13.50,0:11:17.05,Default,,0,0,0,,Мен өскенде осы жерден кетемін.
Dialogue: 0,0:11:17.26,0:11:19.97,Default,,0,0,0,,Менің арманым кеңірек әлемді көру.
Dialogue: 0,0:11:20.52,0:11:22.86,Default,,0,0,0,,Қажы ол кезде қасыңда болады.
Dialogue: 0,0:11:34.34,0:11:38.68,Default,,0,0,0,,Қажы келгендіктен көңілді болдым.
Dialogue: 0,0:11:40.56,0:11:43.23,Default,,0,0,0,,Бірақ бұл қашан болды?
Dialogue: 0,0:11:47.44,0:11:50.57,Default,,0,0,0,,(виолончель орындауы)
Dialogue: 0,0:12:02.01,0:12:03.14,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:12:03.80,0:12:05.27,Default,,0,0,0,,Бұл қызық емес
Dialogue: 0,0:12:05.56,0:12:08.40,Default,,0,0,0,,Қажы меннен қалай жақсы ойнай алады?
Dialogue: 0,0:12:13.07,0:12:14.53,Default,,0,0,0,,Мен сізге кірісейін бе?
Dialogue: 0,0:12:15.33,0:12:16.21,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:12:16.46,0:12:20.13,Default,,0,0,0,,Не керек, сенің бойың менен үлкен екенсің.
Dialogue: 0,0:12:27.39,0:12:28.23,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:12:29.11,0:12:29.94,Default,,0,0,0,,Сая
Dialogue: 0,0:12:31.03,0:12:31.86,Default,,0,0,0,,Оларды колоданың басынан бастап ретімен оқып шығамын
Dialogue: 0,0:12:32.28,0:12:34.41,Default,,0,0,0,,Уайымдама, бұл ештеңе емес.
Dialogue: 0,0:12:40.92,0:12:42.67,Default,,0,0,0,,Мен мұнда келгеннен бері
Dialogue: 0,0:12:42.84,0:12:44.80,Default,,0,0,0,,Саяның түрі өзгерген жоқ.
Dialogue: 0,0:12:45.26,0:12:47.85,Default,,0,0,0,,Ал жара пайда болса да, дереу...
Dialogue: 0,0:12:48.77,0:12:49.69,Default,,0,0,0,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:12:51.78,0:12:53.53,Default,,0,0,0,,Қызметшілердің қанын ағызу
Dialogue: 0,0:12:53.61,0:12:55.45,Default,,0,0,0,,Саяға арналған деп естідім.
Dialogue: 0,0:12:56.08,0:12:57.41,Default,,0,0,0,,Бұл жай ғана қан құю.
Dialogue: 0,0:12:58.46,0:13:01.67,Default,,0,0,0,,Сая өмір сүру үшін қан керек.
Dialogue: 0,0:13:02.26,0:13:03.09,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:13:03.38,0:13:05.14,Default,,0,0,0,,Қан жоғалтпасам да.
Dialogue: 0,0:13:07.56,0:13:09.48,Default,,0,0,0,,Тіршілік тарихы 10 миллион жыл...
Dialogue: 0,0:13:09.60,0:13:12.78,Default,,0,0,0,,Жоқ, ол жүздеген миллион жылдарға созылуы мүмкін.
Dialogue: 0,0:13:13.11,0:13:16.78,Default,,0,0,0,,Дүниеде әлі түсіндірілмеген көптеген нәрселер бар.
Dialogue: 0,0:13:18.08,0:13:22.25,Default,,0,0,0,,Біз қандай болсақ, Сая да осында.
Dialogue: 0,0:13:22.59,0:13:23.96,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:13:24.80,0:13:25.89,Default,,0,0,0,,Дана
Dialogue: 0,0:13:26.35,0:13:29.94,Default,,0,0,0,,Ол баланың неге олай екенін де білмеймін.
Dialogue: 0,0:13:31.02,0:13:33.69,Default,,0,0,0,,Егер рас болса, мен ол бала туралы бәрін білемін.
Dialogue: 0,0:13:33.78,0:13:36.03,Default,,0,0,0,,Соңын көргім келеді
Dialogue: 0,0:13:36.82,0:13:39.83,Default,,0,0,0,,Мен қаншалықты алыс жүре аламын...
Dialogue: 0,0:13:41.17,0:13:45.51,Default,,0,0,0,,Уақыт ағымы аяусыз.
Dialogue: 0,0:13:51.23,0:13:52.98,Default,,0,0,0,,Қажы иә?
Dialogue: 0,0:13:53.44,0:13:56.53,Default,,0,0,0,,Сіз мені қорқынышты деп ойлайсыз ба?
Dialogue: 0,0:13:57.07,0:13:57.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:59.29,0:14:00.62,Default,,0,0,0,,Менен қорқасың ба?
Dialogue: 0,0:14:01.33,0:14:03.08,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:14:04.46,0:14:05.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:07.47,0:14:08.60,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:14:19.28,0:14:21.16,Default,,0,0,0,,Қажының да жүрек соғысы
Dialogue: 0,0:14:21.25,0:14:24.13,Default,,0,0,0,,Жүрегім бір жылдамдықпен соғып тұрса да
Dialogue: 0,0:14:24.59,0:14:26.92,Default,,0,0,0,,Уақыт неге басқаша өтеді?
Dialogue: 0,0:14:31.93,0:14:33.73,Default,,0,0,0,,Қайық кетіп қалды.
Dialogue: 0,0:14:34.31,0:14:35.15,Default,,0,0,0,,Иә
Dialogue: 0,0:14:35.90,0:14:38.86,Default,,0,0,0,,Қажы сол кездегідей емес пе?
Dialogue: 0,0:14:40.53,0:14:41.66,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:44.12,0:14:47.13,Default,,0,0,0,,Біз алғаш танысқанда бала едік.
Dialogue: 0,0:14:47.26,0:14:49.34,Default,,0,0,0,,Содан ол менен үлкен болып өсті.
Dialogue: 0,0:14:49.89,0:14:50.97,Default,,0,0,0,,Бірақ сонда...
Dialogue: 0,0:14:51.68,0:14:52.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:55.86,0:14:56.73,Default,,0,0,0,,Қажы?
Dialogue: 0,0:15:12.06,0:15:13.23,Default,,0,0,0,,Мен?
Dialogue: 0,0:15:21.07,0:15:22.20,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:23.50,0:15:26.21,Default,,0,0,0,,Қажының уақытын тоқтаттым ба?
Dialogue: 0,0:15:39.24,0:15:40.07,Default,,0,0,0,,Сая!
Dialogue: 0,0:15:40.86,0:15:42.07,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:15:42.49,0:15:46.04,Default,,0,0,0,,Биылғы қарақат тосап өте жақсы.
Dialogue: 0,0:15:46.71,0:15:50.34,Default,,0,0,0,,Жаман мінездің кептелістің сапасына еш қатысы жоқ, солай ма?
Dialogue: 0,0:15:50.76,0:15:54.31,Default,,0,0,0,,Айтқаныңмен сен Джоэл Хаджиге ұқсайсың.
Dialogue: 0,0:15:55.52,0:15:58.57,Default,,0,0,0,,Джоэлге сыйлық дайындадыңыз ба?
Dialogue: 0,0:15:58.86,0:16:00.78,Default,,0,0,0,,Сондықтан мен мұнда келдім.
Dialogue: 0,0:16:00.86,0:16:01.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:03.83,0:16:04.66,Default,,0,0,0,,Мұнда!
Dialogue: 0,0:16:04.73,0:16:05.57,Default,,0,0,0,,Сая!
Dialogue: 0,0:16:17.68,0:16:19.64,Default,,0,0,0,,Бүгінгі туған күн кешінде
Dialogue: 0,0:16:19.81,0:16:21.69,Default,,0,0,0,,Мен сол лалагүлді Джоэлге бергім келеді.
Dialogue: 0,0:16:22.77,0:16:24.61,Default,,0,0,0,,Джоэл лалагүлді жақсы көреді.
Dialogue: 0,0:16:25.03,0:16:28.57,Default,,0,0,0,,Бірақ мұндай қызыл лалагүлдер тек осында өседі.
Dialogue: 0,0:16:31.71,0:16:32.83,Default,,0,0,0,,А... Сая?
Dialogue: 0,0:16:33.63,0:16:35.25,Default,,0,0,0,,Қауіпті, тоқтаңыз.
Dialogue: 0,0:16:35.59,0:16:38.05,Default,,0,0,0,,Олай болса Қажы әлгі лалагүлді әкелсін.
Dialogue: 0,0:16:40.22,0:16:42.39,Default,,0,0,0,,Джоэлге не бере аламын?
Dialogue: 0,0:16:42.89,0:16:44.40,Default,,0,0,0,,Ештеңесі жоқтар...
Dialogue: 0,0:16:55.38,0:16:56.92,Default,,0,0,0,,Спидвагон керемет шығып кетті.
Dialogue: 0,0:17:09.99,0:17:12.58,Default,,0,0,0,,А... олай емес.
Dialogue: 0,0:17:13.91,0:17:14.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:22.60,0:17:23.43,Default,,0,0,0,,Қажы!
Dialogue: 0,0:17:24.14,0:17:24.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:37.50,0:17:38.34,Default,,0,0,0,,Қажы!
Dialogue: 0,0:17:41.60,0:17:42.51,Default,,0,0,0,,Қажы!
Dialogue: 0,0:17:43.93,0:17:44.98,Default,,0,0,0,,Қажы!
Dialogue: 0,0:17:47.61,0:17:48.48,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:17:50.40,0:17:52.99,Default,,0,0,0,,Мен не істеуім керек? Қаншама қан...
Dialogue: 0,0:17:53.12,0:17:54.33,Default,,0,0,0,,Бұл жай ғана қан құю...
Dialogue: 0,0:17:56.25,0:17:59.46,Default,,0,0,0,,Сая өмір сүру үшін қан керек.
Dialogue: 0,0:17:59.92,0:18:00.76,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:18:01.05,0:18:02.76,Default,,0,0,0,,Қан жоғалтпасам да...
Dialogue: 0,0:18:05.18,0:18:08.11,Default,,0,0,0,,Менің қаныммен бөліссең...
Dialogue: 0,0:18:44.72,0:18:45.76,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:18:47.94,0:18:48.77,Default,,0,0,0,,Қажы!
Dialogue: 0,0:18:49.90,0:18:52.45,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:18:52.90,0:18:55.83,Default,,0,0,0,,А, а... а...
Dialogue: 0,0:19:00.88,0:19:01.96,Default,,0,0,0,,Не?
Dialogue: 0,0:19:03.13,0:19:05.43,Default,,0,0,0,,Қажы... Қажы!
Dialogue: 0,0:19:09.02,0:19:11.32,Default,,0,0,0,,Ааа!
Dialogue: 0,0:19:19.62,0:19:20.67,Default,,0,0,0,,Қажы?
Dialogue: 0,0:19:26.81,0:19:28.48,Default,,0,0,0,,Жүрек тондары...
Dialogue: 0,0:19:29.85,0:19:31.15,Default,,0,0,0,,Естімейді
Dialogue: 0,0:19:35.36,0:19:36.62,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:19:38.96,0:19:40.67,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:19:47.68,0:19:51.40,Default,,0,0,0,,Мен сарайға жүгірдім.
Dialogue: 0,0:19:52.06,0:19:53.65,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:19:54.03,0:19:55.49,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:20:12.86,0:20:15.78,Default,,0,0,0,,Уақытыңды тоқтатқан мен бе?
Dialogue: 0,0:20:17.11,0:20:19.74,Default,,0,0,0,,Мен сіздің уақытыңызды тоқтаттым ба?
Dialogue: 0,0:20:20.25,0:20:24.05,Default,,0,0,0,,Өйткені мен саған қан бердім
Dialogue: 0,0:20:24.92,0:20:26.09,Default,,0,0,0,,Сонымен, мен
Dialogue: 0,0:20:26.55,0:20:28.85,Default,,0,0,0,,Мен сенің жаныңда бола аламын
Dialogue: 0,0:20:29.89,0:20:33.23,Default,,0,0,0,,Біз көп уақытты бірге бастан өткердік.
Dialogue: 0,0:20:35.57,0:20:36.82,Default,,0,0,0,,Барлығы мен бе?
Dialogue: 0,0:20:37.95,0:20:39.83,Default,,0,0,0,,Өйткені, мен...
Dialogue: 0,0:20:42.83,0:20:45.34,Default,,0,0,0,,Джоэлдің туған күнінде не болды?
Dialogue: 0,0:20:48.43,0:20:51.22,Default,,0,0,0,,Мен не істедім?
Dialogue: 0,0:20:54.40,0:20:56.78,Default,,0,0,0,,Бұл бала мен бе?
Dialogue: 0,0:20:57.24,0:20:58.11,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:21:02.08,0:21:05.54,Default,,0,0,0,,(Диваның ән айту дауысы)
Dialogue: 0,0:21:08.63,0:21:10.14,Default,,0,0,0,,Дос болайық
Dialogue: 0,0:21:23.37,0:21:24.37,Default,,0,0,0,,Сол ән...
Dialogue: 0,0:21:25.63,0:21:28.80,Default,,0,0,0,,Бұл қыз - дива
Dialogue: 0,0:21:30.30,0:21:33.27,Default,,0,0,0,,Менің әпкем...
Dialogue: 0,0:21:34.39,0:21:35.27,Default,,0,0,0,,Иә
Dialogue: 0,0:21:36.11,0:21:38.49,Default,,0,0,0,,Дива екеуің қандассыңдар.
Dialogue: 0,0:21:40.53,0:21:44.25,Default,,0,0,0,,Сонымен қатар біздің анамыз бен сүйіктіміз.
Dialogue: 0,0:21:45.62,0:21:46.71,Default,,0,0,0,,Сен кімнің мүлкіне рұқсатсыз кіріп алдың?
Dialogue: 0,0:21:52.01,0:21:54.14,Default,,0,0,0,,Есіңде ме? Сая
Dialogue: 0,0:21:55.27,0:22:01.28,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:23.86,0:23:29.87,Default,,0,0,0,,~♪
Dialogue: 0,0:23:31.42,0:23:32.55,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:23:32.80,0:23:34.88,Default,,0,0,0,,Ағаң сені өлтірмекші.
Dialogue: 0,0:23:35.64,0:23:38.68,Default,,0,0,0,,Бірақ мен сенің өлгеніңді қаламаймын
Dialogue: 0,0:23:39.60,0:23:43.57,Default,,0,0,0,,Бізбен бірге қыдырғыңыз келсе
Dialogue: 0,0:23:44.11,0:23:46.37,Default,,0,0,0,,Ағаңның түсінетініне сенімдімін.
Dialogue: 0,0:23:47.28,0:23:49.66,Default,,0,0,0,,Сізде қиналатын ештеңе жоқ.
Dialogue: 0,0:23:50.87,0:23:53.34,Default,,0,0,0,,Ендеше менімен бірге жүр...
Dialogue: 0,0:23:54.01,0:23:55.88,Default,,0,0,0,,Келесі жолы «Blood Plus»
Dialogue: 0,0:23:56.30,0:23:57.68,Default,,0,0,0,,«Екі шевальер»
Dialogue: 0,0:23:58.06,0:23:59.52,Default,,0,0,0,,Сая! Барма!
Dialogue: 0,0:24:01.02,0:24:07.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory