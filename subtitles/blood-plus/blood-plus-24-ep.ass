Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:19.99,0:00:20.91,Default,,0,0,0,,Рику…
Dialogue: 0,0:00:40.56,0:00:41.39,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:00:43.35,0:00:44.18,Default,,0,0,0,,Рику
Dialogue: 0,0:00:49.11,0:00:55.11,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:15.28,0:02:21.28,Default,,0,0,0,,~♪
Dialogue: 0,0:02:27.12,0:02:32.08,Default,,0,0,0,,(Металлдың металға соғылған дыбысы)
Dialogue: 0,0:02:35.71,0:02:39.51,Default,,0,0,0,,Бұл шевальерлердің ұзақ және нәтижесіз шайқасы.
Dialogue: 0,0:02:39.88,0:02:42.30,Default,,0,0,0,,Жүрекке пышақ сұғып кетсе де
Dialogue: 0,0:02:42.39,0:02:44.68,Default,,0,0,0,,Бірнеше минуттан кейін қалыпты жағдайға оралады.
Dialogue: 0,0:02:45.01,0:02:48.31,Default,,0,0,0,,Бірақ мен оны денемнен алып, жаншып кетсем ше?
Dialogue: 0,0:02:49.14,0:02:50.98,Default,,0,0,0,,Не болады?
Dialogue: 0,0:02:56.27,0:02:58.57,Default,,0,0,0,,Енді оны аяқтаймыз ба?
Dialogue: 0,0:03:13.63,0:03:14.54,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:35.40,0:03:37.48,Default,,0,0,0,,Жоқ! Сая
Dialogue: 0,0:03:38.15,0:03:43.70,Default,,0,0,0,,(Диваның ән айту дауысы)
Dialogue: 0,0:03:43.78,0:03:44.86,Default,,0,0,0,,Бұл ән...
Dialogue: 0,0:03:51.00,0:03:51.83,Default,,0,0,0,,Сая
Dialogue: 0,0:03:52.21,0:03:54.25,Default,,0,0,0,,Ах… Хехе…
Dialogue: 0,0:03:54.33,0:03:55.17,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:03:56.46,0:03:58.04,Default,,0,0,0,,Бұл өте қанды
Dialogue: 0,0:03:58.17,0:04:04.01,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:04:14.14,0:04:14.98,Default,,0,0,0,,Рику
Dialogue: 0,0:04:16.77,0:04:18.15,Default,,0,0,0,,Менімен бірдей
Dialogue: 0,0:04:18.65,0:04:20.86,Default,,0,0,0,,Түсіндім! Сайо әпке
Dialogue: 0,0:04:28.12,0:04:29.83,Default,,0,0,0,,Сіз Джоэлсіз.
Dialogue: 0,0:04:30.41,0:04:32.29,Default,,0,0,0,,Мен сенің әкеңді өлтірдім.
Dialogue: 0,0:04:32.54,0:04:35.04,Default,,0,0,0,,Джоэл? Әке?
Dialogue: 0,0:04:35.33,0:04:39.29,Default,,0,0,0,,Мені баяғыда осы бөлмеге қамап қойған адам?
Dialogue: 0,0:04:39.38,0:04:40.80,Default,,0,0,0,,Баршаңыз да сапарыңызды жалғастырғанда абай болыңыздар
Dialogue: 0,0:04:40.92,0:04:43.17,Default,,0,0,0,,Мен оны жек көргенім сонша, өлтірдім.
Dialogue: 0,0:04:45.30,0:04:47.14,Default,,0,0,0,,Рахмет Сайо-ни-сама
Dialogue: 0,0:04:47.76,0:04:49.22,Default,,0,0,0,,Камадо, тұр…
Dialogue: 0,0:04:49.30,0:04:52.72,Default,,0,0,0,,Мені осы бөлмеден шығарып жіберген Сайо-ни-сама болса да.
Dialogue: 0,0:04:52.81,0:04:53.93,Default,,0,0,0,,Мен?
Dialogue: 0,0:04:54.02,0:04:55.85,Default,,0,0,0,,Джоэлдің туған күні
Dialogue: 0,0:04:56.02,0:05:00.52,Default,,0,0,0,,Көрсетемін, таң қалдырамын деген апам еді.
Dialogue: 0,0:05:01.86,0:05:07.49,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:05:13.70,0:05:15.75,Default,,0,0,0,,Сен менің досым боласың ба?
Dialogue: 0,0:05:17.75,0:05:20.96,Default,,0,0,0,,Иә... сен мұнда мәңгі өмір сүрдің.
Dialogue: 0,0:05:22.92,0:05:24.17,Default,,0,0,0,,Денемнің қатып қалатынына ешқандай белгі болмады…
Dialogue: 0,0:05:25.67,0:05:28.13,Default,,0,0,0,,Не? Сыртқа шыққыңыз келе ме?
Dialogue: 0,0:05:28.51,0:05:32.93,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:05:56.79,0:05:57.62,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:02.13,0:06:03.34,Default,,0,0,0,,Эй, сен мені естисің бе?
Dialogue: 0,0:06:04.00,0:06:06.30,Default,,0,0,0,,Уәде еткендей есікті аштым.
Dialogue: 0,0:06:07.67,0:06:10.76,Default,,0,0,0,,Эй, сен Джоэлдің туған күніне келе жатырсың, солай ма?
Dialogue: 0,0:06:10.84,0:06:13.35,Default,,0,0,0,,Сіз маған бұл әнді тыңдауға рұқсат етесіз, солай ма?
Dialogue: 0,0:06:13.76,0:06:15.60,Default,,0,0,0,,Сая! Бұл қайда?
Dialogue: 0,0:06:15.68,0:06:17.31,Default,,0,0,0,,Қажы қоңырау шалып жатыр
Dialogue: 0,0:06:17.48,0:06:20.52,Default,,0,0,0,,Енді мен Қажымен бірге тау лалагүлдерін теруге барамын.
Dialogue: 0,0:06:20.65,0:06:22.52,Default,,0,0,0,,Содан кейін кездескенше.
Dialogue: 0,0:06:22.65,0:06:25.36,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:06:27.94,0:06:30.49,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:06:30.86,0:06:32.74,Default,,0,0,0,,Қажы... Қажы...
Dialogue: 0,0:06:45.75,0:06:52.22,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:06:52.30,0:06:53.72,Default,,0,0,0,,қоғамдық бейбітшілік хатын алмастыру үшін, иә?
Dialogue: 0,0:06:55.39,0:06:57.72,Default,,0,0,0,,Мен не істеуім керек
Dialogue: 0,0:06:59.35,0:07:00.35,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:07.28,0:07:10.32,Default,,0,0,0,,Мен сені өлтіруім керек
Dialogue: 0,0:07:10.95,0:07:12.11,Default,,0,0,0,,«Золушка» сұлулық салонына қош келдіңіз.
Dialogue: 0,0:07:13.66,0:07:14.57,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:07:22.33,0:07:23.75,Default,,0,0,0,,Менің қаныммен!
Dialogue: 0,0:07:27.00,0:07:28.42,Default,,0,0,0,,…баланың санасына ықпал ету үшін миына енгізілген
Dialogue: 0,0:07:29.09,0:07:30.22,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:34.34,0:07:36.05,Default,,0,0,0,,Шынында да өзгеріс жоқ
Dialogue: 0,0:07:36.72,0:07:39.18,Default,,0,0,0,,Апа, біз көптен бері біргеміз.
Dialogue: 0,0:07:39.27,0:07:40.52,Default,,0,0,0,,Адал және тура
Dialogue: 0,0:07:41.06,0:07:42.48,Default,,0,0,0,,Мен, сондай апа.
Dialogue: 0,0:07:42.85,0:07:45.77,Default,,0,0,0,,Мен сені қатты жақсы көремін, сені қатты жек көремін
Dialogue: 0,0:07:46.02,0:07:47.23,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:07:47.36,0:07:49.86,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:07:49.94,0:07:50.78,Default,,0,0,0,,Сая!
Dialogue: 0,0:07:51.15,0:07:51.99,Default,,0,0,0,,Кай
Dialogue: 0,0:07:53.15,0:07:55.24,Default,,0,0,0,,Сайо... 2 адам?
Dialogue: 0,0:07:55.70,0:07:56.87,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:07:56.99,0:07:58.03,Default,,0,0,0,,Дива
Dialogue: 0,0:07:58.62,0:07:59.87,Default,,0,0,0,,Сайоның қарындасы
Dialogue: 0,0:07:59.95,0:08:01.79,Default,,0,0,0,,Бұл емес.
Dialogue: 0,0:08:04.75,0:08:06.04,Default,,0,0,0,,Рику! (Дэвид) Кай!
Dialogue: 0,0:08:06.67,0:08:08.88,Default,,0,0,0,,Рику? Рику, саған не болды?
Dialogue: 0,0:08:09.42,0:08:11.13,Default,,0,0,0,,Көзіңді аш, эй Рику.
Dialogue: 0,0:08:11.21,0:08:12.42,Default,,0,0,0,,Рику!
Dialogue: 0,0:08:12.51,0:08:13.97,Default,,0,0,0,,Бұл дәмді болды
Dialogue: 0,0:08:17.30,0:08:18.14,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:08:31.99,0:08:34.82,Default,,0,0,0,,Ах, жыртылып қалды.
Dialogue: 0,0:08:41.87,0:08:44.62,Default,,0,0,0,,Ең алдымен сіз
Dialogue: 0,0:08:45.16,0:08:46.67,Default,,0,0,0,,Ухххххх...
Dialogue: 0,0:08:47.54,0:08:48.38,Default,,0,0,0,,О!
Dialogue: 0,0:08:48.46,0:08:49.84,Default,,0,0,0,,Ахахаха Ахахаха!
Dialogue: 0,0:08:49.92,0:08:52.59,Default,,0,0,0,,Ахахаха…
Dialogue: 0,0:08:55.43,0:08:57.39,Default,,0,0,0,,Мына қыз да дәмді көрінеді.
Dialogue: 0,0:09:03.06,0:09:03.89,Default,,0,0,0,,Мазасыздық!
Dialogue: 0,0:09:07.35,0:09:08.65,Default,,0,0,0,,Сая
Dialogue: 0,0:09:10.23,0:09:11.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:11.19,0:09:12.03,Default,,0,0,0,,Сая!
Dialogue: 0,0:09:13.48,0:09:14.78,Default,,0,0,0,,Сая!
Dialogue: 0,0:09:16.82,0:09:18.99,Default,,0,0,0,,Ахахаха! Қызық
Dialogue: 0,0:09:19.57,0:09:22.12,Default,,0,0,0,,Әпке, жасырынбақ ойнап жүрсіз бе?
Dialogue: 0,0:09:23.54,0:09:24.62,Default,,0,0,0,,Дива
Dialogue: 0,0:09:26.33,0:09:27.33,Default,,0,0,0,,Шизуку Каваками, Курона Анку, Наширо
Dialogue: 0,0:09:29.13,0:09:30.17,Default,,0,0,0,,Ең алдымен
Dialogue: 0,0:09:30.25,0:09:33.50,Default,,0,0,0,,Ахахаха ахахахха...
Dialogue: 0,0:09:33.59,0:09:35.55,Default,,0,0,0,,Аха…
Dialogue: 0,0:09:38.43,0:09:39.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:56.69,0:09:59.61,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:10:10.88,0:10:13.05,Default,,0,0,0,,Уху-ухху...
Dialogue: 0,0:10:13.17,0:10:15.97,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:10:18.93,0:10:22.97,Default,,0,0,0,,Рику Рику! Оян, Рику!
Dialogue: 0,0:10:23.68,0:10:25.69,Default,,0,0,0,,Рику…Рику!
Dialogue: 0,0:10:27.06,0:10:28.19,Default,,0,0,0,,Рику!
Dialogue: 0,0:10:29.11,0:10:29.94,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:10:31.82,0:10:32.65,Default,,0,0,0,,Рику...
Dialogue: 0,0:10:33.15,0:10:35.57,Default,,0,0,0,,Рику суып барады.
Dialogue: 0,0:10:36.15,0:10:40.12,Default,,0,0,0,,Бірақ мен не істерімді білмеймін.
Dialogue: 0,0:10:42.16,0:10:46.58,Default,,0,0,0,,Рику Мықты болыңыз Рику Рику!
Dialogue: 0,0:11:03.10,0:11:05.73,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:11:06.89,0:11:08.31,Default,,0,0,0,,Дива
Dialogue: 0,0:11:19.53,0:11:21.70,Default,,0,0,0,,Уууууу…
Dialogue: 0,0:11:23.91,0:11:25.91,Default,,0,0,0,,Табылды ~ табылды
Dialogue: 0,0:11:30.04,0:11:32.13,Default,,0,0,0,,Ей, бірге ойнайық.
Dialogue: 0,0:11:43.47,0:11:45.64,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:12:10.29,0:12:12.37,Default,,0,0,0,,Сіз күресуді таңдадыңыз.
Dialogue: 0,0:12:15.96,0:12:17.00,Default,,0,0,0,,Сүлеймен
Dialogue: 0,0:12:17.63,0:12:19.47,Default,,0,0,0,,Мен Дивамын...
Dialogue: 0,0:12:20.09,0:12:22.01,Default,,0,0,0,,Сіз... кесіп алмақшысыз ба?
Dialogue: 0,0:12:23.30,0:12:25.10,Default,,0,0,0,,Сізге қатысты қан
Dialogue: 0,0:12:25.43,0:12:27.85,Default,,0,0,0,,Бұл дүниедегі жалғыз әпкем
Dialogue: 0,0:12:28.68,0:12:30.73,Default,,0,0,0,,Дива барлығын бақытсыз етеді
Dialogue: 0,0:12:31.10,0:12:32.81,Default,,0,0,0,,Әпкеммен
Dialogue: 0,0:12:34.02,0:12:36.77,Default,,0,0,0,,Сіз осында болдыңыз.
Dialogue: 0,0:12:36.86,0:12:39.28,Default,,0,0,0,,Сүлеймен, сенің де ойнағың келе ме?
Dialogue: 0,0:12:39.99,0:12:43.82,Default,,0,0,0,,Жоқ. Сізді ол жерге нақты кім әкелді?
Dialogue: 0,0:12:43.91,0:12:45.20,Default,,0,0,0,,Аншел
Dialogue: 0,0:12:45.62,0:12:47.37,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:12:48.54,0:12:51.83,Default,,0,0,0,,Осы ақымақ төбелестерді тоқтатқыңыз келе ме?
Dialogue: 0,0:12:53.54,0:12:56.09,Default,,0,0,0,,Өзіңді басқа біреуге ұқсатуға қанша тырыссаң да
Dialogue: 0,0:12:56.17,0:12:58.30,Default,,0,0,0,,Зардап шеккен сенсің.
Dialogue: 0,0:12:59.05,0:13:01.13,Default,,0,0,0,,Мен сені бұлай көргім келмейді
Dialogue: 0,0:13:01.55,0:13:04.89,Default,,0,0,0,,Өйткені, біз адам емеспіз.
Dialogue: 0,0:13:05.34,0:13:10.02,Default,,0,0,0,,Дива сізге ұнайтын адамды ренжітті.
Dialogue: 0,0:13:10.10,0:13:12.10,Default,,0,0,0,,Бұл бақытсыз оқиға болды.
Dialogue: 0,0:13:12.18,0:13:13.35,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,0:13:13.44,0:13:15.85,Default,,0,0,0,,Әлгі қыз дәмді көрінді.
Dialogue: 0,0:13:15.94,0:13:16.94,Default,,0,0,0,,Дива
Dialogue: 0,0:13:17.31,0:13:20.78,Default,,0,0,0,,Менің отбасым және достарым бар.
Dialogue: 0,0:13:21.15,0:13:23.74,Default,,0,0,0,,Эмоционалды байланыстағы адамдар
Dialogue: 0,0:13:23.99,0:13:26.70,Default,,0,0,0,,Жүректері байланысқан маңызды адамдар
Dialogue: 0,0:13:28.16,0:13:30.37,Default,,0,0,0,,Сөздеріңізге сенгім келеді, бірақ
Dialogue: 0,0:13:30.49,0:13:34.62,Default,,0,0,0,,Мен енді мұндай мұңды көргім келмейді.
Dialogue: 0,0:13:34.71,0:13:37.84,Default,,0,0,0,,Сондықтан мен қанатты өлтіруді шештім.
Dialogue: 0,0:13:38.50,0:13:40.92,Default,,0,0,0,,Қаптау барлығын қорғайды.
Dialogue: 0,0:13:42.46,0:13:44.09,Default,,0,0,0,,Біз алғаш кездескен кезде
Dialogue: 0,0:13:44.43,0:13:47.55,Default,,0,0,0,,Мен сенімен бірге жүре аламын деп ойладым.
Dialogue: 0,0:13:48.01,0:13:50.56,Default,,0,0,0,,Шевалер сияқты қызметші ретінде емес
Dialogue: 0,0:13:50.64,0:13:54.94,Default,,0,0,0,,Бұл менің Соломон Голдсмит ретіндегі шынайы сезімдерім болды.
Dialogue: 0,0:13:55.52,0:13:58.65,Default,,0,0,0,,Бірақ қазір мен мұңайып отырмын.
Dialogue: 0,0:13:59.32,0:14:01.32,Default,,0,0,0,,Мен Дива шевальемін
Dialogue: 0,0:14:02.94,0:14:05.07,Default,,0,0,0,,Мен сені өлтіруім керек
Dialogue: 0,0:14:08.62,0:14:09.66,Default,,0,0,0,,Сүлеймен
Dialogue: 0,0:14:16.25,0:14:17.83,Default,,0,0,0,,Сонымен!
Dialogue: 0,0:14:42.82,0:14:45.78,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:14:47.82,0:14:50.07,Default,,0,0,0,,Бұл жеткілікті емес пе? Сая
Dialogue: 0,0:14:50.66,0:14:53.16,Default,,0,0,0,,Енді ұрысудың қажеті жоқ.
Dialogue: 0,0:14:53.95,0:14:56.62,Default,,0,0,0,,Жүр, бізбен бірге жүр.
Dialogue: 0,0:14:56.91,0:14:57.75,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:00.67,0:15:02.67,Default,,0,0,0,,Мен сенің осындай сөздер айтқаныңды ұнатпаймын, Маюши.
Dialogue: 0,0:15:02.75,0:15:04.71,Default,,0,0,0,,Сүлеймен қабылданбады
Dialogue: 0,0:15:06.72,0:15:09.13,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:15:15.06,0:15:15.89,Default,,0,0,0,,Не?
Dialogue: 0,0:15:16.73,0:15:17.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:18.69,0:15:19.85,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:15:20.31,0:15:22.52,Default,,0,0,0,,Қаным жетпейді, апа.
Dialogue: 0,0:15:22.61,0:15:25.32,Default,,0,0,0,,Айналасы тәтті тағамдарға толы болса да
Dialogue: 0,0:15:25.69,0:15:28.78,Default,,0,0,0,,Мен... сенен басқамын.
Dialogue: 0,0:15:29.57,0:15:31.74,Default,,0,0,0,,Бірдей емес
Dialogue: 0,0:15:34.95,0:15:35.79,Default,,0,0,0,,Дива
Dialogue: 0,0:15:35.87,0:15:38.33,Default,,0,0,0,,Мен әпкемді өлтіремін.
Dialogue: 0,0:15:38.54,0:15:39.79,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:15:39.87,0:15:40.71,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:41.21,0:15:42.67,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:15:49.34,0:15:50.18,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:56.02,0:15:58.39,Default,,0,0,0,,Апаның қаны мен үшін у
Dialogue: 0,0:15:59.44,0:16:00.85,Default,,0,0,0,,Менің қаным
Dialogue: 0,0:16:02.44,0:16:05.19,Default,,0,0,0,,Қарындасыңа у, солай емес пе?
Dialogue: 0,0:16:06.44,0:16:07.36,Default,,0,0,0,,Иә
Dialogue: 0,0:16:08.44,0:16:09.86,Default,,0,0,0,,Хе-хе-хе
Dialogue: 0,0:16:10.57,0:16:11.95,Default,,0,0,0,,Мен сені қай жерде пышақтауым керек?
Dialogue: 0,0:16:12.61,0:16:16.04,Default,,0,0,0,,Күтілгендей, бұл ең жұмсақ сияқты.
Dialogue: 0,0:16:16.66,0:16:18.16,Default,,0,0,0,,Мүмкін осы жерде
Dialogue: 0,0:16:19.91,0:16:21.92,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:16:26.13,0:16:26.96,Default,,0,0,0,,Біріншісі – сараймен байланысты адамдардың сеніміне ие болу.
Dialogue: 0,0:16:28.13,0:16:29.76,Default,,0,0,0,,Чип! Чип, чип, чип, чип!
Dialogue: 0,0:16:38.56,0:16:39.93,Default,,0,0,0,,Сіз кереметсіз.
Dialogue: 0,0:16:40.56,0:16:42.19,Default,,0,0,0,,Дөрекі Шевалье
Dialogue: 0,0:16:42.85,0:16:44.19,Default,,0,0,0,,Мен оны жек көрмеймін, бірақ
Dialogue: 0,0:16:45.02,0:16:46.02,Default,,0,0,0,,Дива
Dialogue: 0,0:16:52.74,0:16:53.66,Default,,0,0,0,,Қайтару
Dialogue: 0,0:16:53.78,0:16:55.82,Default,,0,0,0,,Мен жаңа көйлек алғым келеді
Dialogue: 0,0:16:55.91,0:16:58.74,Default,,0,0,0,,Егер сіз мұны қаласаңыз
Dialogue: 0,0:17:20.56,0:17:21.56,Default,,0,0,0,,Сая!
Dialogue: 0,0:17:22.43,0:17:25.27,Default,,0,0,0,,Мен сені іздедім. Диваға не болды?
Dialogue: 0,0:17:27.11,0:17:28.02,Default,,0,0,0,,Рику ше?
Dialogue: 0,0:17:29.69,0:17:30.61,Default,,0,0,0,,Рику!
Dialogue: 0,0:17:31.11,0:17:32.49,Default,,0,0,0,,Рику!
Dialogue: 0,0:17:32.86,0:17:34.78,Default,,0,0,0,,Құтқару тобы әлі бар ма?
Dialogue: 0,0:17:34.95,0:17:36.03,Default,,0,0,0,,Уақытында емес
Dialogue: 0,0:17:36.32,0:17:37.74,Default,,0,0,0,,Артық қан кету
Dialogue: 0,0:17:37.83,0:17:40.70,Default,,0,0,0,,Қарғыс атсын! Бірдеңе дұрыс емес пе?
Dialogue: 0,0:17:43.08,0:17:44.58,Default,,0,0,0,,Егер бұл менің қаным болса
Dialogue: 0,0:17:45.58,0:17:47.25,Default,,0,0,0,,Рикуға көмектесе алады
Dialogue: 0,0:17:49.59,0:17:52.21,Default,,0,0,0,,Қаласаңыз
Dialogue: 0,0:17:56.26,0:17:59.47,Default,,0,0,0,,Саяның қаны қандай? ол
Dialogue: 0,0:17:59.81,0:18:01.64,Default,,0,0,0,,Қанымды ішсең
Dialogue: 0,0:18:02.31,0:18:04.69,Default,,0,0,0,,Рику сақталуы мүмкін.
Dialogue: 0,0:18:04.77,0:18:05.98,Default,,0,0,0,,Дегенмен, мен әлі күн бойы Толық шоғырланған тыныс алуды ұстап тұра алмаймын.
Dialogue: 0,0:18:06.06,0:18:06.98,Default,,0,0,0,,Бірақ
Dialogue: 0,0:18:07.56,0:18:08.48,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:18:09.82,0:18:10.73,Default,,0,0,0,,Бірақ
Dialogue: 0,0:18:11.19,0:18:15.11,Default,,0,0,0,,Рикудың уақыты қазіргідей тоқтай береді.
Dialogue: 0,0:18:16.78,0:18:18.16,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:18:19.99,0:18:21.16,Default,,0,0,0,,Күтілгендей, жоқ
Dialogue: 0,0:18:21.24,0:18:24.33,Default,,0,0,0,,Кай мұның не екенін білмейді.
Dialogue: 0,0:18:24.41,0:18:25.91,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:18:26.00,0:18:27.96,Default,,0,0,0,,Бірақ қазір бізде осы ғана, солай ма?
Dialogue: 0,0:18:28.04,0:18:28.88,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:18:28.96,0:18:29.92,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:18:30.29,0:18:33.17,Default,,0,0,0,,Рику менің жалғыз інім.
Dialogue: 0,0:18:33.59,0:18:37.68,Default,,0,0,0,,Рику өлсе, мен жалғыз қаламын.
Dialogue: 0,0:18:38.51,0:18:40.43,Default,,0,0,0,,Мен мұны енді қаламаймын!
Dialogue: 0,0:18:40.51,0:18:43.10,Default,,0,0,0,,Сондықтан Рикуға көмектесіңіз!
Dialogue: 0,0:18:45.98,0:18:47.19,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:47.60,0:18:51.02,Default,,0,0,0,,Рику - Кайдың інісі.
Dialogue: 0,0:18:51.69,0:18:56.36,Default,,0,0,0,,Рику кетсе, Кай жалғыз қалады, солай ма?
Dialogue: 0,0:19:02.03,0:19:02.87,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:04.91,0:19:07.08,Default,,0,0,0,,Мен де Рикуға көмектескім келеді.
Dialogue: 0,0:19:07.87,0:19:10.38,Default,,0,0,0,,Қазір бізде осы ғана, солай ма?
Dialogue: 0,0:19:34.48,0:19:37.19,Default,,0,0,0,,Кай, менің қолымнан ұста.
Dialogue: 0,0:19:39.74,0:19:40.66,Default,,0,0,0,,Уф… Ой, жоқ!
Dialogue: 0,0:19:56.80,0:19:57.84,Default,,0,0,0,,Рику Жарайды...
Dialogue: 0,0:19:58.42,0:19:59.55,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:19:59.93,0:20:02.14,Default,,0,0,0,,Уф! Уф...
Dialogue: 0,0:20:03.10,0:20:06.22,Default,,0,0,0,,Уау! О! Уф!
Dialogue: 0,0:20:06.77,0:20:08.77,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,0:20:08.85,0:20:09.69,Default,,0,0,0,,Ұстаңыз!
Dialogue: 0,0:20:09.77,0:20:11.19,Default,,0,0,0,,Рику! Не болды?
Dialogue: 0,0:20:11.27,0:20:12.56,Default,,0,0,0,,Льюис асығыңыз!
Dialogue: 0,0:20:12.81,0:20:13.65,Default,,0,0,0,,О
Dialogue: 0,0:20:13.73,0:20:14.82,Default,,0,0,0,,Бірақ бұл демондарға да қатысты.
Dialogue: 0,0:20:14.90,0:20:16.61,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,0:20:16.69,0:20:18.57,Default,,0,0,0,,Уф! Ой... Сая
Dialogue: 0,0:20:18.65,0:20:20.32,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:20:20.40,0:20:21.70,Default,,0,0,0,,(Тик-так, тик-так соғады сағат)
Dialogue: 0,0:20:21.78,0:20:25.53,Default,,0,0,0,,Уау...
Dialogue: 0,0:20:27.16,0:20:29.00,Default,,0,0,0,,Мені кешірші Рику
Dialogue: 0,0:20:29.08,0:20:30.96,Default,,0,0,0,,Ой...
Dialogue: 0,0:20:33.54,0:20:34.54,Default,,0,0,0,,Рику?
Dialogue: 0,0:20:35.79,0:20:38.63,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:20:38.84,0:20:40.88,Default,,0,0,0,,Кай, сабыр ет, тыңда.
Dialogue: 0,0:20:41.26,0:20:42.47,Default,,0,0,0,,Біраз уақытқа
Dialogue: 0,0:20:42.55,0:20:46.22,Default,,0,0,0,,Рикудың өмірлік белсенділігі өте төмен деңгейде тұрақты болуы керек.
Dialogue: 0,0:20:46.39,0:20:48.52,Default,,0,0,0,,Өткен істер есепке алынған
Dialogue: 0,0:20:48.60,0:20:50.14,Default,,0,0,0,,Сонымен, жақсысың ба?
Dialogue: 0,0:20:50.23,0:20:53.94,Default,,0,0,0,,Бірақ одан кейін не болатынын әлі білмейміз.
Dialogue: 0,0:20:54.35,0:20:56.11,Default,,0,0,0,,Оны тезірек штабқа апарыңыз.
Dialogue: 0,0:20:56.61,0:20:58.90,Default,,0,0,0,,Маманнан медициналық көмек сұраңыз
Dialogue: 0,0:21:04.45,0:21:11.46,Default,,0,0,0,,(Диваның гуілдеуі)
Dialogue: 0,0:21:13.87,0:21:14.96,Default,,0,0,0,,Аншел
Dialogue: 0,0:21:20.01,0:21:22.38,Default,,0,0,0,,Эй, менің көйлегім тесіліп қалды.
Dialogue: 0,0:21:22.47,0:21:26.51,Default,,0,0,0,,Хмм, сіз жаңасын алғыңыз келгендіктен әдейі атып кеттіңіз, солай ма?
Dialogue: 0,0:21:26.89,0:21:28.31,Default,,0,0,0,,Қандай қатыгез қимыл…
Dialogue: 0,0:21:28.56,0:21:31.18,Default,,0,0,0,,Бауырым, мұнда неге келдің?
Dialogue: 0,0:21:31.52,0:21:34.98,Default,,0,0,0,,Мен Диваның тілегін ғана орындадым.
Dialogue: 0,0:21:35.06,0:21:35.94,Default,,0,0,0,,Әкем білсе, бұл сөзсіз L-ге жетеді.
Dialogue: 0,0:21:36.06,0:21:38.69,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:21:38.77,0:21:41.49,Default,,0,0,0,,Мен бұл туралы естігім келеді.
Dialogue: 0,0:21:41.57,0:21:42.44,Default,,0,0,0,,Сүлеймен
Dialogue: 0,0:21:44.11,0:21:46.66,Default,,0,0,0,,Уххххххх
Dialogue: 0,0:21:47.74,0:21:50.49,Default,,0,0,0,,Сайо-ни-сама, мен сені қатты жақсы көремін
Dialogue: 0,0:21:55.08,0:22:01.09,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:23.42,0:23:29.43,Default,,0,0,0,,~♪
Dialogue: 0,0:23:33.76,0:23:36.27,Default,,0,0,0,,Голдшмидт отбасының мұрагері кім болады?
Dialogue: 0,0:23:36.35,0:23:37.64,Default,,0,0,0,,Джоэлдің аты және
Dialogue: 0,0:23:37.73,0:23:40.85,Default,,0,0,0,,Қызыл қалқанның директоры рөлін қабылдаңыз
Dialogue: 0,0:23:41.40,0:23:44.82,Default,,0,0,0,,Алайда менің отағасын мұрагерлікке алу ойым жоқ.
Dialogue: 0,0:23:45.28,0:23:50.70,Default,,0,0,0,,Мен Джоэлде аз ғана ар-ождан мен жауапкершілікті мұра еттім.
Dialogue: 0,0:23:51.53,0:23:53.62,Default,,0,0,0,,Келесі жолы «Blood Plus»
Dialogue: 0,0:23:53.95,0:23:55.16,Default,,0,0,0,,«Қызыл қалқан»
Dialogue: 0,0:23:55.91,0:23:59.12,Default,,0,0,0,,Дэвид Мен саған сенемін
Dialogue: 0,0:24:00.62,0:24:06.62,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory