Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.64,0:00:02.81,Default,,0,0,0,,Let's play it again
Dialogue: 0,0:00:03.14,0:00:04.89,Default,,0,0,0,,Біздің Вьетнам соғысы!
Dialogue: 0,0:00:05.02,0:00:06.94,Default,,0,0,0,,(Балалар ызылдайды)
Dialogue: 0,0:00:11.03,0:00:12.40,Default,,0,0,0,,Бауырым, не істеуіміз керек?
Dialogue: 0,0:00:14.20,0:00:15.91,Default,,0,0,0,,Рику, сен осында күт!
Dialogue: 0,0:00:16.32,0:00:17.62,Default,,0,0,0,,Кай-нии-чан, қайда бара жатырсың?
Dialogue: 0,0:00:19.08,0:00:20.62,Default,,0,0,0,,Сыртта не болып жатқанын көремін!
Dialogue: 0,0:00:21.16,0:00:22.33,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:00:25.92,0:00:26.75,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:00:30.71,0:00:32.25,Default,,0,0,0,,Гуах! (Роджерс) Маккой!
Dialogue: 0,0:00:39.60,0:00:40.51,Default,,0,0,0,,Маккой…
Dialogue: 0,0:00:41.26,0:00:42.22,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:47.10,0:00:50.44,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:00:51.61,0:00:52.94,Default,,0,0,0,,Неге ұрыспасқа?
Dialogue: 0,0:00:53.03,0:00:55.19,Default,,0,0,0,,Бізде бар нәрсе сенсің!
Dialogue: 0,0:00:56.15,0:00:58.20,Default,,0,0,0,,Жоқ, ән...
Dialogue: 0,0:00:58.28,0:00:59.12,Default,,0,0,0,,Ән?
Dialogue: 0,0:01:03.54,0:01:04.37,Default,,0,0,0,,Сая!
Dialogue: 0,0:01:07.33,0:01:08.29,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:01:09.46,0:01:10.42,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:01:14.63,0:01:16.09,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:01:23.39,0:01:24.81,Default,,0,0,0,,Кесу! Оны кесіңіз
Dialogue: 0,0:01:25.52,0:01:26.77,Default,,0,0,0,,Сая, күрес!
Dialogue: 0,0:01:30.81,0:01:31.90,Default,,0,0,0,,Сол жылы тағы бір үрей басталды
Dialogue: 0,0:01:45.87,0:01:46.79,Default,,0,0,0,,Мен...
Dialogue: 0,0:01:47.37,0:01:49.83,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:01:51.54,0:01:57.55,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:18.92,0:03:24.93,Default,,0,0,0,,~♪
Dialogue: 0,0:04:09.14,0:04:10.01,Default,,0,0,0,,Сая...
Dialogue: 0,0:04:18.23,0:04:19.69,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:04:27.16,0:04:28.24,Default,,0,0,0,,Бұл~!
Dialogue: 0,0:04:35.00,0:04:39.04,Default,,0,0,0,,(Диваның ән айту дауысы)
Dialogue: 0,0:05:38.14,0:05:39.52,Default,,0,0,0,,Әке?
Dialogue: 0,0:05:40.98,0:05:42.73,Default,,0,0,0,,Кай Рику?
Dialogue: 0,0:05:44.57,0:05:45.65,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:03.42,0:06:05.96,Default,,0,0,0,,Гуаааааааааааааааааааа
Dialogue: 0,0:06:07.13,0:06:07.97,Default,,0,0,0,,Сая!
Dialogue: 0,0:06:08.22,0:06:10.55,Default,,0,0,0,,Gu… ah…
Dialogue: 0,0:06:12.14,0:06:12.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:17.81,0:06:18.68,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:18.89,0:06:19.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:23.90,0:06:24.82,Default,,0,0,0,,Сая?
Dialogue: 0,0:06:29.82,0:06:30.65,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:35.66,0:06:36.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:37.12,0:06:38.58,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:06:39.66,0:06:43.25,Default,,0,0,0,,Керемет, бұл ең жақсы кезең
Dialogue: 0,0:06:46.13,0:06:46.96,Default,,0,0,0,,Иә
Dialogue: 0,0:06:48.21,0:06:49.13,Default,,0,0,0,,Не?
Dialogue: 0,0:06:49.72,0:06:51.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:53.43,0:06:54.43,Default,,0,0,0,,Адамдар өте оңай өліп қалады, иә?
Dialogue: 0,0:06:57.72,0:06:59.81,Default,,0,0,0,,Сая оянады
Dialogue: 0,0:07:15.20,0:07:16.12,Default,,0,0,0,,Сіз...
Dialogue: 0,0:07:17.91,0:07:18.74,Default,,0,0,0,,Сая...
Dialogue: 0,0:07:18.83,0:07:20.91,Default,,0,0,0,,Жарайды, Сая.
Dialogue: 0,0:07:26.25,0:07:30.21,Default,,0,0,0,,Мен сізді сол кездегідей кездестіре аламын.
Dialogue: 0,0:07:31.17,0:07:32.80,Default,,0,0,0,,Жүріңдер, келіңдер.
Dialogue: 0,0:07:33.51,0:07:36.85,Default,,0,0,0,,Келесі жолы менімен бірге билейік!
Dialogue: 0,0:07:38.01,0:07:38.85,Default,,0,0,0,,Сая
Dialogue: 0,0:07:40.06,0:07:40.89,Default,,0,0,0,,№
Dialogue: 0,0:07:42.48,0:07:43.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:43.56,0:07:45.77,Default,,0,0,0,,Иә, би билейік!
Dialogue: 0,0:07:45.98,0:07:46.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:48.40,0:07:50.19,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:07:50.44,0:07:51.57,Default,,0,0,0,,Сая~!
Dialogue: 0,0:07:54.03,0:07:55.53,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:55.99,0:07:57.57,Default,,0,0,0,,Не істеп жатырсың, Сая!
Dialogue: 0,0:07:57.78,0:07:58.62,Default,,0,0,0,,Сая!
Dialogue: 0,0:08:05.71,0:08:06.54,Default,,0,0,0,,Кай…
Dialogue: 0,0:08:08.34,0:08:09.21,Default,,0,0,0,,(Демін ала-шала)
Dialogue: 0,0:08:09.38,0:08:10.21,Default,,0,0,0,,Не?
Dialogue: 0,0:08:17.39,0:08:18.22,Default,,0,0,0,,Ой... уау!
Dialogue: 0,0:08:19.89,0:08:21.14,Default,,0,0,0,,Неге!
Dialogue: 0,0:08:21.77,0:08:23.56,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:08:25.02,0:08:26.65,Default,,0,0,0,,Саяға не істедің?
Dialogue: 0,0:08:27.02,0:08:29.15,Default,,0,0,0,,Карл, тоқтат.
Dialogue: 0,0:08:29.48,0:08:30.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:39.32,0:08:40.37,Default,,0,0,0,,Клара
Dialogue: 0,0:08:42.62,0:08:44.08,Default,,0,0,0,,Клара, мықты бол!
Dialogue: 0,0:08:44.16,0:08:45.00,Default,,0,0,0,,Клара!
Dialogue: 0,0:08:46.79,0:08:47.96,Default,,0,0,0,,Сіз...
Dialogue: 0,0:08:49.29,0:08:50.75,Default,,0,0,0,,Сіз қайтып келдіңіз, солай ма?
Dialogue: 0,0:08:53.09,0:08:55.42,Default,,0,0,0,,Мен мұны жасадым...
Dialogue: 0,0:08:56.22,0:08:58.43,Default,,0,0,0,,Ондай жасырын асыл тас болса
Dialogue: 0,0:08:58.97,0:09:03.56,Default,,0,0,0,,Тезірек шығарса екен.
Dialogue: 0,0:09:03.64,0:09:04.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:04.77,0:09:05.60,Default,,0,0,0,,Клара!
Dialogue: 0,0:09:06.64,0:09:08.98,Default,,0,0,0,,Ыдысты тез алыңыз
Dialogue: 0,0:09:10.27,0:09:11.27,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:09:11.44,0:09:12.90,Default,,0,0,0,,Ах, дұрыс... Уф.
Dialogue: 0,0:09:14.53,0:09:17.40,Default,,0,0,0,,Балаларды осылай құртатындар.
Dialogue: 0,0:09:18.41,0:09:19.66,Default,,0,0,0,,Мені жең
Dialogue: 0,0:09:21.16,0:09:25.04,Default,,0,0,0,,Біздің ертеңіміз тек сенсің...
Dialogue: 0,0:09:26.91,0:09:28.87,Default,,0,0,0,,Сіз ертең қорғай аласыз
Dialogue: 0,0:09:30.96,0:09:32.04,Default,,0,0,0,,Ертең...
Dialogue: 0,0:09:32.84,0:09:35.34,Default,,0,0,0,,Бүгінмен ертең үшін өмір сүр
Dialogue: 0,0:09:36.97,0:09:41.09,Default,,0,0,0,,Мұны тек сіз жасай аласыз.
Dialogue: 0,0:09:50.48,0:09:53.07,Default,,0,0,0,,Сүлеймен Сіз дайын сияқтысыз.
Dialogue: 0,0:10:01.28,0:10:03.16,Default,,0,0,0,,Тек сіз жасай алатын нәрселер бар.
Dialogue: 0,0:10:03.78,0:10:05.91,Default,,0,0,0,,Сондықтан біз бармыз
Dialogue: 0,0:10:06.50,0:10:09.75,Default,,0,0,0,,Қызыл қалқан мұндай шайқастарды жалғастырды.
Dialogue: 0,0:10:14.92,0:10:18.80,Default,,0,0,0,,Жүр, апаймен барайық.
Dialogue: 0,0:10:19.55,0:10:21.18,Default,,0,0,0,,Жұмаққа барайық
Dialogue: 0,0:10:28.39,0:10:30.44,Default,,0,0,0,,Не?
Dialogue: 0,0:10:33.65,0:10:34.48,Default,,0,0,0,,Кай
Dialogue: 0,0:10:37.07,0:10:38.44,Default,,0,0,0,,Сұраныс сұрау
Dialogue: 0,0:10:40.03,0:10:41.03,Default,,0,0,0,,Сая
Dialogue: 0,0:10:42.53,0:10:43.87,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:10:44.66,0:10:45.66,Default,,0,0,0,,Ел көлеміндегі ең ізденетін Зұлымдар Альянсы
Dialogue: 0,0:10:46.87,0:10:49.00,Default,,0,0,0,,Мен мұны істеуім керек!
Dialogue: 0,0:10:53.00,0:10:53.96,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:10:54.88,0:10:56.38,Default,,0,0,0,,Кейінірек баруды ұмытпаңыз
Dialogue: 0,0:11:08.68,0:11:11.02,Default,,0,0,0,,Кай-нии-чан, кешігіп қалдың.
Dialogue: 0,0:11:12.31,0:11:15.65,Default,,0,0,0,,Мм... Иә, солай.
Dialogue: 0,0:11:28.58,0:11:31.12,Default,,0,0,0,,Қазір не болып жатыр?
Dialogue: 0,0:11:31.21,0:11:32.37,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:11:32.46,0:11:35.13,Default,,0,0,0,,Сол адамнан сұраған дұрыс болар.
Dialogue: 0,0:11:37.55,0:11:39.92,Default,,0,0,0,,Карл! Сен не істеп жатырсың?
Dialogue: 0,0:11:40.05,0:11:42.63,Default,,0,0,0,,Мен Саяны ыңғайлы түрде өлтіріп алар едім.
Dialogue: 0,0:11:43.18,0:11:45.93,Default,,0,0,0,,Қарапайым адам келбеті менің түнім...
Dialogue: 0,0:11:46.26,0:11:47.43,Default,,0,0,0,,Неге тоқтадың?
Dialogue: 0,0:11:48.31,0:11:49.77,Default,,0,0,0,,Сіз уәде бердіңіз, солай ма?
Dialogue: 0,0:11:50.31,0:11:54.27,Default,,0,0,0,,Кәдімгідей төбелессең де, оңай өлмейсің!
Dialogue: 0,0:11:54.48,0:11:56.86,Default,,0,0,0,,Оған жеңіл қарамағаныңыз жөн.
Dialogue: 0,0:11:57.61,0:11:59.78,Default,,0,0,0,,Осыны сенің ағаң айтпады ма?
Dialogue: 0,0:12:00.07,0:12:02.45,Default,,0,0,0,,Сондықтан Диваны тез жылжытыңыз!
Dialogue: 0,0:12:02.53,0:12:04.61,Default,,0,0,0,,Олар жақында келеді...
Dialogue: 0,0:12:09.20,0:12:12.00,Default,,0,0,0,,Ал... Меніңше, бұл самурай адамы ма?
Dialogue: 0,0:12:20.76,0:12:21.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:26.01,0:12:26.93,Default,,0,0,0,,Сол адам...
Dialogue: 0,0:12:29.39,0:12:32.27,Default,,0,0,0,,Карл, өтінемін...
Dialogue: 0,0:12:32.68,0:12:33.94,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:12:34.31,0:12:35.40,Default,,0,0,0,,Сіз осында болыңыз.
Dialogue: 0,0:12:35.77,0:12:36.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:36.77,0:12:40.73,Default,,0,0,0,,Карл мен Самурайман туралы ақпаратты жинаңыз, содан кейін 02 блогымен оралыңыз.
Dialogue: 0,0:12:54.75,0:12:56.50,Default,,0,0,0,,Ой... уау!
Dialogue: 0,0:13:01.51,0:13:04.59,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:13:06.30,0:13:07.43,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:12.35,0:13:13.64,Default,,0,0,0,,Эй!
Dialogue: 0,0:13:32.58,0:13:33.79,Default,,0,0,0,,Онда… жалаңаш қолмен шайқасайық.
Dialogue: 0,0:13:37.33,0:13:38.67,Default,,0,0,0,,Керемет!
Dialogue: 0,0:13:47.38,0:13:49.47,Default,,0,0,0,,Рику…Рику?
Dialogue: 0,0:13:49.84,0:13:50.68,Default,,0,0,0,,Не?
Dialogue: 0,0:13:51.26,0:13:53.14,Default,,0,0,0,,Мен қорқамын
Dialogue: 0,0:13:56.35,0:13:57.81,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:13:58.52,0:14:00.15,Default,,0,0,0,,Мен сенімдімін Кай-ни-чан...
Dialogue: 0,0:14:02.77,0:14:03.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:03.90,0:14:05.90,Default,,0,0,0,,Бұл соншалықты нашар ма?
Dialogue: 0,0:14:07.11,0:14:10.78,Default,,0,0,0,,Мен... Қызық, не болады?
Dialogue: 0,0:14:13.08,0:14:16.71,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:14:19.83,0:14:20.71,Default,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,0:14:21.29,0:14:23.04,Default,,0,0,0,,Мен шынымен түсінбеймін
Dialogue: 0,0:14:23.13,0:14:24.34,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:14:24.59,0:14:27.17,Default,,0,0,0,,Уайымдама, мен сенімдімін...
Dialogue: 0,0:14:27.47,0:14:28.43,Default,,0,0,0,,Рику!
Dialogue: 0,0:14:29.51,0:14:30.59,Default,,0,0,0,,Кай-нии-чан!
Dialogue: 0,0:14:30.97,0:14:31.85,Default,,0,0,0,,Сайо осында
Dialogue: 0,0:14:31.93,0:14:32.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:32.85,0:14:34.18,Default,,0,0,0,,Толық мәліметтер кейінірек
Dialogue: 0,0:14:34.26,0:14:35.10,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:14:35.22,0:14:36.68,Default,,0,0,0,,Осы жерден асығыңыз! Ах...
Dialogue: 0,0:14:36.98,0:14:37.98,Default,,0,0,0,,Ах
Dialogue: 0,0:14:41.48,0:14:43.69,Default,,0,0,0,,Иә! Уф...
Dialogue: 0,0:14:44.86,0:14:46.40,Default,,0,0,0,,Не істеп жатырсың, Кай-ни-чан?
Dialogue: 0,0:14:47.11,0:14:48.40,Default,,0,0,0,,Муи ештеңе емес!
Dialogue: 0,0:14:48.57,0:14:49.40,Default,,0,0,0,,Рику!
Dialogue: 0,0:14:49.65,0:14:51.16,Default,,0,0,0,,Бұл ештеңе емес!
Dialogue: 0,0:14:53.24,0:14:55.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:57.16,0:14:58.33,Default,,0,0,0,,Гуо~
Dialogue: 0,0:14:59.92,0:15:00.75,Default,,0,0,0,,Уф
Dialogue: 0,0:15:00.87,0:15:02.08,Default,,0,0,0,,Таа~!
Dialogue: 0,0:15:03.13,0:15:03.96,Default,,0,0,0,,Уф, оқ-дәрі астында қалып қоюдың өзі бір әлем екен
Dialogue: 0,0:15:08.72,0:15:09.80,Default,,0,0,0,,Бірақ бұл демондарға да қатысты.
Dialogue: 0,0:15:21.77,0:15:23.40,Default,,0,0,0,,Дегенмен, Ол Майт—
Dialogue: 0,0:15:28.40,0:15:29.32,Default,,0,0,0,,Уау
Dialogue: 0,0:15:32.07,0:15:33.41,Default,,0,0,0,,Мына тікұшақты қу!
Dialogue: 0,0:15:46.46,0:15:48.76,Default,,0,0,0,,Уф... шіркін...
Dialogue: 0,0:15:52.38,0:15:54.97,Default,,0,0,0,,А... олар не?
Dialogue: 0,0:15:55.39,0:15:56.72,Default,,0,0,0,,Red Shield
Dialogue: 0,0:15:57.89,0:16:00.93,Default,,0,0,0,,Бұл біздің жобаға тосқауыл қоюға тырысатын топ.
Dialogue: 0,0:16:03.40,0:16:05.81,Default,,0,0,0,,Сен де жаман адамсың.
Dialogue: 0,0:16:06.02,0:16:09.03,Default,,0,0,0,,Мұндай ақпаратты бізге алдын ала беріңіз.
Dialogue: 0,0:16:09.53,0:16:13.53,Default,,0,0,0,,Сіз сондай-ақ Карлдың Delta 67 пайдаланғанын білдіңіз бе?
Dialogue: 0,0:16:15.66,0:16:18.49,Default,,0,0,0,,Алайда бұл бұрын-соңды кездеспеген ауру түрі...
Dialogue: 0,0:16:18.74,0:16:22.29,Default,,0,0,0,,О, бұл Delta 67 емес.
Dialogue: 0,0:16:22.54,0:16:24.33,Default,,0,0,0,,Не? Бірақ бұл...
Dialogue: 0,0:16:24.46,0:16:27.00,Default,,0,0,0,,О, бұл солай ма?
Dialogue: 0,0:16:27.84,0:16:29.30,Default,,0,0,0,,Таң қалмайсың ба?
Dialogue: 0,0:16:29.63,0:16:31.97,Default,,0,0,0,,Иә, мен оны көріп үйреніп қалдым.
Dialogue: 0,0:16:33.01,0:16:34.47,Default,,0,0,0,,Содан бері
Dialogue: 0,0:16:34.93,0:16:38.35,Default,,0,0,0,,Мен сенің қашан оянатыныңды асыға күттім.
Dialogue: 0,0:16:39.51,0:16:41.93,Default,,0,0,0,,Бұл сезімді қабыл алыңыз!
Dialogue: 0,0:16:42.60,0:16:43.89,Default,,0,0,0,,Ааа!
Dialogue: 0,0:16:45.06,0:16:45.90,Default,,0,0,0,,Сая...
Dialogue: 0,0:16:51.78,0:16:52.61,Default,,0,0,0,,Сая?
Dialogue: 0,0:17:01.66,0:17:02.95,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:17:04.58,0:17:07.50,Default,,0,0,0,,Бұл не? қарақат!
Dialogue: 0,0:17:12.01,0:17:12.88,Default,,0,0,0,,Муи!
Dialogue: 0,0:17:13.21,0:17:16.84,Default,,0,0,0,,Боқта~ Жібер, жібер!
Dialogue: 0,0:17:17.34,0:17:18.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:19.39,0:17:20.43,Default,,0,0,0,,Гуо ~
Dialogue: 0,0:17:21.43,0:17:25.35,Default,,0,0,0,,Уф... Муи, тоқтат.
Dialogue: 0,0:17:25.64,0:17:27.06,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:17:33.44,0:17:34.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:37.32,0:17:39.62,Default,,0,0,0,,Мен мұнда не үшін болдым?
Dialogue: 0,0:17:40.16,0:17:42.58,Default,,0,0,0,,Менің есімде қалмайтын дүниелер көп.
Dialogue: 0,0:17:43.95,0:17:46.92,Default,,0,0,0,,Менің есімде қалғым келмейтін нәрселер көп.
Dialogue: 0,0:17:48.83,0:17:50.75,Default,,0,0,0,,Бірақ сіз
Dialogue: 0,0:17:51.21,0:17:54.05,Default,,0,0,0,,Мұндағы балаларға не істемек болдық
Dialogue: 0,0:17:54.67,0:17:56.22,Default,,0,0,0,,Мен оны міндетті түрде тоқтатамын!
Dialogue: 0,0:17:58.47,0:18:02.56,Default,,0,0,0,,Мен енді мен болмасам да, мүлдем!
Dialogue: 0,0:18:21.78,0:18:22.87,Default,,0,0,0,,Уау
Dialogue: 0,0:18:29.37,0:18:31.75,Default,,0,0,0,,Шыу!
Dialogue: 0,0:18:43.05,0:18:44.18,Default,,0,0,0,,Фантом…
Dialogue: 0,0:18:47.43,0:18:49.14,Default,,0,0,0,,Фантом!
Dialogue: 0,0:19:06.79,0:19:07.62,Default,,0,0,0,,Муи
Dialogue: 0,0:19:09.75,0:19:10.58,Default,,0,0,0,,Муи?
Dialogue: 0,0:19:13.17,0:19:14.50,Default,,0,0,0,,Сәлем Муи
Dialogue: 0,0:19:15.88,0:19:17.21,Default,,0,0,0,,Гуа!
Dialogue: 0,0:19:17.30,0:19:18.30,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:19:20.18,0:19:21.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:21.68,0:19:23.55,Default,,0,0,0,,Уф
Dialogue: 0,0:19:37.53,0:19:41.86,Default,,0,0,0,,Муи бұрынғы қалпына қайтады, солай ма?
Dialogue: 0,0:19:42.99,0:19:43.82,Default,,0,0,0,,О
Dialogue: 0,0:19:54.50,0:19:55.63,Default,,0,0,0,,Мен қайтуға болады?
Dialogue: 0,0:19:56.88,0:19:57.88,Default,,0,0,0,,Сіз бұған сенесіз бе?
Dialogue: 0,0:19:58.92,0:20:01.05,Default,,0,0,0,,Сіз ғажайыптардың бар екеніне сене аласыз ба?
Dialogue: 0,0:20:02.18,0:20:04.26,Default,,0,0,0,,Егер сіз осындай нәрсеге сенсеңіз
Dialogue: 0,0:20:04.55,0:20:07.01,Default,,0,0,0,,Қазірге дейін Құдайдың кешірімі
Dialogue: 0,0:20:09.93,0:20:13.06,Default,,0,0,0,,Бірақ менде сенгім келеді.
Dialogue: 0,0:20:21.07,0:20:22.15,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:20:26.16,0:20:27.03,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:28.87,0:20:29.74,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:30.37,0:20:32.46,Default,,0,0,0,,Мен сені ешқашан кешірмеймін.
Dialogue: 0,0:20:32.83,0:20:35.79,Default,,0,0,0,,Кім не десе де, Сая біздің отбасымыз!
Dialogue: 0,0:20:35.88,0:20:38.04,Default,,0,0,0,,Мен саған енді қалағаныңды істеуге рұқсат бермеймін!
Dialogue: 0,0:20:39.25,0:20:41.17,Default,,0,0,0,,Сая туралы не білесіңдер?
Dialogue: 0,0:20:41.26,0:20:42.67,Default,,0,0,0,,Бәрін айтып берейін!
Dialogue: 0,0:20:43.17,0:20:45.39,Default,,0,0,0,,Бүгіннен бастап мен сені қорғаймын!
Dialogue: 0,0:20:59.61,0:21:02.44,Default,,0,0,0,,Эй, айтшы
Dialogue: 0,0:21:03.90,0:21:05.24,Default,,0,0,0,,Кім кінәлі?
Dialogue: 0,0:21:05.91,0:21:08.57,Default,,0,0,0,,Неліктен бұл қорқынышты нәрсе?
Dialogue: 0,0:21:09.49,0:21:12.70,Default,,0,0,0,,Неліктен Сайо-ничан соғысуы керек?
Dialogue: 0,0:21:16.87,0:21:18.25,Default,,0,0,0,,Мен де саған көмектесемін!
Dialogue: 0,0:21:18.75,0:21:19.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:21.67,0:21:24.01,Default,,0,0,0,,Сондықтан ештеңені жасырудың қажеті жоқ
Dialogue: 0,0:21:31.18,0:21:33.39,Default,,0,0,0,,Барлығын өз бетімен көтерме.
Dialogue: 0,0:21:34.60,0:21:36.39,Default,,0,0,0,,Біз отбасымыз, солай ма?
Dialogue: 0,0:21:38.19,0:21:39.02,Default,,0,0,0,,Иә
Dialogue: 0,0:21:40.27,0:21:41.32,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:21:56.41,0:22:02.42,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:23:18.91,0:23:24.92,Default,,0,0,0,,~♪
Dialogue: 0,0:23:27.30,0:23:28.67,Default,,0,0,0,,Менің ең жақын досым
Dialogue: 0,0:23:28.88,0:23:31.43,Default,,0,0,0,,Бұл сол жеңіл атлетика клубының мүшесі Сайо Отонаши.
Dialogue: 0,0:23:31.80,0:23:34.55,Default,,0,0,0,,Шындығында, мен Интер-Хайге дейін рекорд орната аламын.
Dialogue: 0,0:23:34.68,0:23:36.47,Default,,0,0,0,,Бұл нақты спектакльдер үшін әлсіз.
Dialogue: 0,0:23:36.56,0:23:38.93,Default,,0,0,0,,Мен әрқашан сыни нүктеде жоқ деп айтамын.
Dialogue: 0,0:23:39.10,0:23:41.48,Default,,0,0,0,,Сондай-ақ, қанша жесең де, семірмейсің.
Dialogue: 0,0:23:41.56,0:23:43.27,Default,,0,0,0,,Сіз қызғанасыз ба?
Dialogue: 0,0:23:43.48,0:23:46.44,Default,,0,0,0,,Бірақ қазір... ол кетті.
Dialogue: 0,0:23:47.11,0:23:48.15,Default,,0,0,0,,Ешқайсысы жоқ.
Dialogue: 0,0:23:48.86,0:23:50.61,Default,,0,0,0,,Next time “Blood Plus”
Dialogue: 0,0:23:50.82,0:23:52.24,Default,,0,0,0,,«Өткен жексенбі»
Dialogue: 0,0:23:52.86,0:23:54.49,Default,,0,0,0,,Сая қош келдіңіз
Dialogue: 0,0:23:55.99,0:24:01.99,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory