Dialogue: 0,1:16:51.92,1:16:56.75,Main_Song_JP,,0000,0000,0000,,Сол ән маған қатты ұнады
Dialogue: 0,1:16:57.32,1:17:02.05,Main_Song_JP,,0000,0000,0000,,Ескі таспаның ішінде
Dialogue: 0,1:17:02.00,1:17:08.53,Main_Song_JP,,0000,0000,0000,,Кішкентай сызаттар Өшірілген тақырып
Dialogue: 0,1:17:08.47,1:17:12.20,Main_Song_JP,,0000,0000,0000,,Кемпірқосақ таңы
Dialogue: 0,1:17:12.14,1:17:17.64,Main_Song_JP,,0000,0000,0000,,Сонда бүгін тағы да келеді
Dialogue: 0,1:17:17.58,1:17:22.44,Main_Song_JP,,0000,0000,0000,,Жазғы желді өзіммен бірге алып
Dialogue: 0,1:17:22.38,1:17:28.45,Main_Song_JP,,0000,0000,0000,,Күнделікті жұмысымның бұрышында
Dialogue: 0,1:17:27.74,1:17:32.58,Main_Song_JP,,0000,0000,0000,,Кенет жалғыздыққа тап болдым
Dialogue: 0,1:17:33.06,1:17:43.50,Main_Song_JP,,0000,0000,0000,,Велосипедпен кез келген жерге бару
Dialogue: 0,1:17:43.30,1:17:52.80,Main_Song_JP,,0000,0000,0000,,Желдің соғу жылдамдығын ұмытпа
Dialogue: 0,1:17:53.91,1:18:04.22,Main_Song_JP,,0000,0000,0000,,Ла Ла Ла Ла ән айт, аспанға қара
Dialogue: 0,1:18:04.16,1:18:14.01,Main_Song_JP,,0000,0000,0000,,Ла Ла Ла Ла Бұл менің өмірім Жүрейік
Dialogue: 0,1:18:13.57,1:18:25.10,Main_Song_JP,,0000,0000,0000,,Мен өз күшіммен осы шексіз жолды алға тартамын.
Dialogue: 0,1:18:26.31,1:18:36.58,Main_Song_JP,,0000,0000,0000,,Көп нәрсенің қиылысында мен үнемі адасып қаламын.
Dialogue: 0,1:18:36.52,1:18:43.42,Main_Song_JP,,0000,0000,0000,,Ағып кету немесе қуу немесе басып озу
Dialogue: 0,1:18:42.93,1:18:46.70,Main_Song_JP,,0000,0000,0000,,Қазіргі уақытта өмір сүру
Dialogue: 0,1:18:47.00,1:18:57.51,Main_Song_JP,,0000,0000,0000,,Конфликтіні қабылдау
Dialogue: 0,1:18:57.11,1:19:07.35,Main_Song_JP,,0000,0000,0000,,Ересек болған соң да ұмытпа
Dialogue: 0,1:19:07.89,1:19:18.09,Main_Song_JP,,0000,0000,0000,,Ла Ла Ла Ла ән айт, аспанға қара
Dialogue: 0,1:19:18.03,1:19:27.63,Main_Song_JP,,0000,0000,0000,,Ла Ла Ла Ла Бұл менің өмірім Жүрейік
Dialogue: 0,1:19:27.57,1:19:38.45,Main_Song_JP,,0000,0000,0000,,Бұл тек менікі, сондықтан сіз сенімді болуыңыз керек.
Dialogue: 0,1:19:57.00,1:20:01.65,Main_Song_JP,,0000,0000,0000,,Мен туған қалада армандадым.
Dialogue: 0,1:20:01.51,1:20:06.89,Main_Song_JP,,0000,0000,0000,,Жеңілген сайын есіме түседі
Dialogue: 0,1:20:06.55,1:20:12.10,Main_Song_JP,,0000,0000,0000,,Сол ән сияқты, қазір не істей аласың
