Dialogue: 0,0:00:00.00,0:00:00.00,Default,NTP,0000,0000,0000,,// Restart&SakuraCafe субтитрлер тобына тиесілі түпнұсқа субтитр нұсқасы, жүктеу кезінде дереккөзді ескеріңіз, қосымша ақпаратты сұраудың қажеті жоқ.
Dialogue: 0,0:00:00.00,0:00:00.00,Default,NTP,0000,0000,0000,,//МӘТІН
Dialogue: 0,0:00:44.41,0:00:45.65,Default,,0000,0000,0000,,Кел, Сакура
Dialogue: 0,0:01:09.91,0:01:10.71,Default,,0000,0000,0000,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:01:14.71,0:01:16.31,Default,,0000,0000,0000,,Найзағай императорының шақыруы
Dialogue: 0,0:01:21.04,0:01:22.19,Default,,0000,0000,0000,,Рахмет, Ли
Dialogue: 0,0:01:22.73,0:01:23.86,Default,,0000,0000,0000,,Қарамаңдар
Dialogue: 0,0:01:29.44,0:01:29.96,Default,,0000,0000,0000,,Қазір
Dialogue: 0,0:01:30.44,0:01:30.78,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:01:37.45,0:01:40.34,Default,,0000,0000,0000,,Жел, өсиет тізбегі бол
Dialogue: 0,0:01:41.81,0:01:43.15,Default,,0000,0000,0000,,Ұшу
Dialogue: 0,0:01:55.11,0:01:55.72,Default,,0000,0000,0000,,Секіру
Dialogue: 0,0:02:04.93,0:02:06.87,Default,,0000,0000,0000,,Өзіңіздің шынайы болмысыңызға оралыңыз
Dialogue: 0,0:02:07.32,0:02:09.37,Default,,0000,0000,0000,,Клоу картасы
Dialogue: 0,0:02:34.26,0:02:37.35,Default,,0000,0000,0000,,Сяоран картаны ала жаздады.
Dialogue: 0,0:02:37.97,0:02:40.18,Default,,0000,0000,0000,,Сен сондай сүйкімдісің, Сакура-чан
Dialogue: 0,0:02:41.57,0:02:43.50,Default,,0000,0000,0000,,Жарайсыңдар.
Dialogue: 0,0:02:43.78,0:02:46.27,Default,,0000,0000,0000,,Күткендей, бұл тек Вай күткен нәрсе.
Dialogue: 0,0:02:46.74,0:02:49.12,Default,,0000,0000,0000,,Сәлем, Кардкаптор Сакура
Dialogue: 0,0:04:14.19,0:04:17.28,Default,,0000,0000,0000,,Бұл қайда?
Dialogue: 0,0:04:19.08,0:04:19.95,Default,,0000,0000,0000,,Су?
Dialogue: 0,0:04:46.54,0:04:50.23,Default,,0000,0000,0000,,Бұл ауыртпайды.
Dialogue: 0,0:04:56.04,0:04:59.81,Default,,0000,0000,0000,,Су ағындары.
Dialogue: 0,0:05:11.01,0:05:15.75,Default,,0000,0000,0000,,Су ағады.
Dialogue: 0,0:05:38.36,0:05:39.50,Default,,0000,0000,0000,,Бұл түс пе?
Dialogue: 0,0:05:48.18,0:05:48.70,Default,,0000,0000,0000,,Нишимура
Dialogue: 0,0:05:49.26,0:05:49.74,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:05:52.24,0:05:52.74,Default,,0000,0000,0000,,Кобаяши
Dialogue: 0,0:05:53.17,0:05:53.48,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:05:55.48,0:05:56.36,Default,,0000,0000,0000,,Жақсы жұмыс
Dialogue: 0,0:05:58.16,0:05:58.67,Default,,0000,0000,0000,,Кондо
Dialogue: 0,0:05:59.06,0:05:59.65,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:00.31,0:06:01.79,Default,,0000,0000,0000,,Келесі жолы аздап тырысайық
Dialogue: 0,0:06:03.55,0:06:04.07,Default,,0000,0000,0000,,Шимизу
Dialogue: 0,0:06:04.37,0:06:04.81,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:06.12,0:06:07.07,Default,,0000,0000,0000,,Қалай болды?
Dialogue: 0,0:06:07.48,0:06:11.17,Default,,0000,0000,0000,,Жақсы болды. Мен математикадан сәтсіздікке ұшыраған шығармын деп ойладым.
Dialogue: 0,0:06:08.59,0:06:09.16,Default,,0000,0000,0000,,Дегава
Dialogue: 0,0:06:09.40,0:06:09.92,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:11.59,0:06:12.87,Default,,0000,0000,0000,,Бұл жақсы болды.
Dialogue: 0,0:06:13.43,0:06:14.00,Default,,0000,0000,0000,,Дайдодзи храмы
Dialogue: 0,0:06:14.55,0:06:14.99,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:17.09,0:06:17.55,Default,,0000,0000,0000,,Номура
Dialogue: 0,0:06:17.96,0:06:18.47,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:23.74,0:06:25.11,Default,,0000,0000,0000,,Сіз де Ли үшін алаңдайсыз ба?
Dialogue: 0,0:06:27.20,0:06:28.32,Default,,0000,0000,0000,,Бөлек
Dialogue: 0,0:06:28.50,0:06:30.99,Default,,0000,0000,0000,,Уайымдама, мен сенімен боламын.
Dialogue: 0,0:06:32.47,0:06:35.13,Default,,0000,0000,0000,,Жарайды, апаңа көрсеткің келмейді, солай ма?
Dialogue: 0,0:06:35.13,0:06:35.90,Default,,0000,0000,0000,,Жоқ, жоқ.
Dialogue: 0,0:06:35.90,0:06:37.63,Default,,0000,0000,0000,,Томойо-чан, қалай болды?
Dialogue: 0,0:06:38.06,0:06:39.61,Default,,0000,0000,0000,,Бірінші семестрдегідей болды.
Dialogue: 0,0:06:40.05,0:06:42.29,Default,,0000,0000,0000,,Бұл шынымен жақсы дегенді білдіреді, солай ма?
Dialogue: 0,0:06:45.21,0:06:47.50,Default,,0000,0000,0000,,Ли Сяоран, Ли Чилинг
Dialogue: 0,0:06:48.19,0:06:49.15,Default,,0000,0000,0000,,Yes
Dialogue: 0,0:06:56.84,0:06:59.65,Default,,0000,0000,0000,,Мейрин-чан, сен өзіңе сенімдісің.
Dialogue: 0,0:06:59.88,0:07:03.55,Default,,0000,0000,0000,,Иә, Томойо-чан, сен қысқы демалысқа қайда барасың?
Dialogue: 0,0:07:03.69,0:07:05.01,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:07:06.02,0:07:08.51,Default,,0000,0000,0000,,Неліктен бұл тамаша балл емес?
Dialogue: 0,0:07:10.23,0:07:11.78,Default,,0000,0000,0000,,Мен жаңа ғана Гонконгтан келдім.
Dialogue: 0,0:07:12.39,0:07:13.82,Default,,0000,0000,0000,,Мен жапон тілі туралы көп білмеймін.
Dialogue: 0,0:07:30.33,0:07:32.86,Default,,0000,0000,0000,,Керемет, мен сізге мұны көрсете аламын.
Dialogue: 0,0:07:41.24,0:07:43.30,Default,,0000,0000,0000,,Бірақ, Томойо-чан күткендей, солай емес пе?
Dialogue: 0,0:07:43.54,0:07:46.08,Default,,0000,0000,0000,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:07:46.12,0:07:46.89,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:07:47.78,0:07:49.26,Default,,0000,0000,0000,,Мм мм
Dialogue: 0,0:07:52.94,0:07:54.30,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:07:56.20,0:07:58.19,Default,,0000,0000,0000,,Бұл қысқы демалыстағы үй тапсырмасына арналған ба?
Dialogue: 0,0:07:58.48,0:07:58.94,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:08:00.14,0:08:00.75,Default,,0000,0000,0000,,Иә, қараңыз.
Dialogue: 0,0:08:04.57,0:08:05.24,Default,,0000,0000,0000,,Оны тартып көріңіз.
Dialogue: 0,0:08:06.93,0:08:10.49,Default,,0000,0000,0000,,Дәл қазір Tomoeda сауда ауданында жыл соңындағы жоба жүріп жатыр.
Dialogue: 0,0:08:11.34,0:08:13.10,Default,,0000,0000,0000,,Бас жүлде – Гонконгқа саяхат.
Dialogue: 0,0:08:13.20,0:08:14.14,Default,,0000,0000,0000,,Ойласам, біз ұзақ уақыт сөйлеспеген сияқтымыз
Dialogue: 0,0:08:14.37,0:08:16.26,Default,,0000,0000,0000,,Сакура-чан, бар күшіңді сал.
Dialogue: 0,0:08:16.37,0:08:16.66,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:08:18.80,0:08:21.89,Default,,0000,0000,0000,,Томоеда бастауыш мектебінің көптеген балалары да келді.
Dialogue: 0,0:08:22.16,0:08:24.37,Default,,0000,0000,0000,,Бұл барлығына қатысқаны үшін марапат болды, солай ма?
Dialogue: 0,0:08:28.49,0:08:28.90,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:08:41.86,0:08:42.86,Default,,0000,0000,0000,,Оның түсі қандай болды?
Dialogue: 0,0:08:44.76,0:08:46.46,Default,,0000,0000,0000,,Мен де қатысу сыйлығын алдым.
Dialogue: 0,0:08:50.22,0:08:51.73,Default,,0000,0000,0000,,Э-э-э—
Dialogue: 0,0:08:56.69,0:08:56.90,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:08:58.16,0:08:58.46,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:08:59.72,0:09:00.05,Default,,0000,0000,0000,,Және?
Dialogue: 0,0:09:03.53,0:09:05.17,Default,,0000,0000,0000,,Арнайы сыйлық?
Dialogue: 0,0:09:05.71,0:09:06.55,Default,,0000,0000,0000,,Яан
Dialogue: 0,0:09:06.77,0:09:08.67,Default,,0000,0000,0000,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:09:10.47,0:09:14.81,Default,,0000,0000,0000,,Әй, бұл жай ғана қысқы демалыс емес пе?
Dialogue: 0,0:09:15.25,0:09:16.03,Default,,0000,0000,0000,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:09:16.88,0:09:18.82,Default,,0000,0000,0000,,Бұл менің шетелде бірінші рет болуым.
Dialogue: 0,0:09:20.05,0:09:23.49,Default,,0000,0000,0000,,Гонконг, мен ностальгия сезінемін.
Dialogue: 0,0:09:23.75,0:09:25.68,Default,,0000,0000,0000,,Керо-чан, сен Гонконгта болдың ба?
Dialogue: 0,0:09:26.17,0:09:28.56,Default,,0000,0000,0000,,Мен Қарғамен біраз уақыт боламын.
Dialogue: 0,0:09:31.29,0:09:31.66,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:09:33.14,0:09:36.89,Default,,0000,0000,0000,,Бұл Клоу карталары Гонконгта да болды.
Dialogue: 0,0:09:37.57,0:09:38.81,Default,,0000,0000,0000,,Карточкалар
Dialogue: 0,0:09:38.81,0:09:42.06,Default,,0000,0000,0000,,Сиқыршы Краурид жасаған қылыш.
Dialogue: 0,0:09:45.00,0:09:47.39,Default,,0000,0000,0000,,Гонконг қандай жер?
Dialogue: 0,0:09:47.81,0:09:48.86,Default,,0000,0000,0000,,Тағайындалған кезде
Dialogue: 0,0:09:49.24,0:09:51.31,Default,,0000,0000,0000,,Мен саған жол көрсеткен жер
Dialogue: 0,0:09:51.53,0:09:52.04,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:09:55.92,0:09:56.40,Default,,0000,0000,0000,,Иә? Күте тұрыңыз
Dialogue: 0,0:09:57.76,0:09:58.49,Default,,0000,0000,0000,,Иә? не болды?
Dialogue: 0,0:09:59.42,0:10:02.85,Default,,0000,0000,0000,,Есімде болса, әкеңіз осы қысқы демалыста іссапарға шықпады ма?
Dialogue: 0,0:10:04.66,0:10:05.94,Default,,0000,0000,0000,,Ойланып көрейікші
Dialogue: 0,0:10:10.59,0:10:11.22,Default,,0000,0000,0000,,Жалғастырыңыз
Dialogue: 0,0:10:12.17,0:10:12.76,Default,,0000,0000,0000,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:10:14.00,0:10:15.55,Default,,0000,0000,0000,,Мен арнайы жүлдені жеңіп алдым.
Dialogue: 0,0:10:15.87,0:10:17.02,Default,,0000,0000,0000,,Мен бара алмаймын
Dialogue: 0,0:10:17.37,0:10:19.38,Default,,0000,0000,0000,,Момоя-кун менімен бірге болса, бәрі жақсы болады.
Dialogue: 0,0:10:21.25,0:10:23.47,Default,,0000,0000,0000,,Бірақ аға, толық емес жұмыс күні...
Dialogue: 0,0:10:30.48,0:10:31.23,Default,,0000,0000,0000,,Бес кезекшілік ауысым
Dialogue: 0,0:10:33.21,0:10:34.95,Default,,0000,0000,0000,,үшін? Бірақ бұл жақсы!
Dialogue: 0,0:10:35.26,0:10:39.76,Default,,0000,0000,0000,,Сонда менің орныма Томойо-сан мен Цукиширо-кун ше?
Dialogue: 0,0:10:41.48,0:10:45.21,Default,,0000,0000,0000,,Менің ойымша, бұл жақсы, бірақ ол ешқандай жоспары жоқ екенін айтты.
Dialogue: 0,0:10:47.37,0:10:48.42,Default,,0000,0000,0000,,Уау, мен жасадым!
Dialogue: 0,0:11:01.93,0:11:03.92,Default,,0000,0000,0000,,Бұл менің ұшақта бірінші рет ұшуым!
Dialogue: 0,0:11:08.18,0:11:09.49,Default,,0000,0000,0000,,Бейнебаянды әкелдіңіз бе?
Dialogue: 0,0:11:09.72,0:11:12.99,Default,,0000,0000,0000,,Иә, Сакура-чан Гонконгқа саяхат көлемі
Dialogue: 0,0:11:13.80,0:11:17.77,Default,,0000,0000,0000,,Мен мұндай тамаша фото мүмкіндікті жіберіп алмаймын.
Dialogue: 0,0:11:19.22,0:11:22.98,Default,,0000,0000,0000,,Әрине, фотосессияға киімдерді де алып келдім.
Dialogue: 0,0:11:23.35,0:11:26.28,Default,,0000,0000,0000,,Гонконгқа келгенде бізге келіңіз.
Dialogue: 0,0:11:29.16,0:11:30.91,Default,,0000,0000,0000,,Эй, отырғызу уақыты.
Dialogue: 0,0:11:31.73,0:11:32.36,Default,,0000,0000,0000,,Yes
Dialogue: 0,0:11:37.73,0:11:38.06,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:11:39.42,0:11:41.34,Default,,0000,0000,0000,,Ұшаққа отырғанда аяқ киімді шешіңіз.
Dialogue: 0,0:11:41.68,0:11:43.01,Default,,0000,0000,0000,,Не? Солай ма?
Dialogue: 0,0:11:44.47,0:11:44.77,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:11:51.33,0:11:52.99,Default,,0000,0000,0000,,Құрметті тұтынушы, сол күйінде қалдырыңыз.
Dialogue: 0,0:11:57.28,0:11:58.38,Default,,0000,0000,0000,,Үлкен аға!
Dialogue: 0,0:12:03.88,0:12:06.09,Default,,0000,0000,0000,,Ауырсыну
Dialogue: 0,0:12:07.24,0:12:09.92,Default,,0000,0000,0000,,Эй Сакура, сен әлі келдің бе?
Dialogue: 0,0:12:14.64,0:12:16.10,Default,,0000,0000,0000,,Сәл ұзағырақ ұстаңыз
Dialogue: 0,0:12:16.46,0:12:17.28,Default,,0000,0000,0000,,Соберн
Dialogue: 0,0:12:17.61,0:12:18.20,Default,,0000,0000,0000,,Сакура-чан
Dialogue: 0,0:12:22.50,0:12:23.85,Default,,0000,0000,0000,,Мені шақырғаныңызға рахмет.
Dialogue: 0,0:12:24.73,0:12:26.82,Default,,0000,0000,0000,,Бұл менің шетелге бірінші рет шығуым.
Dialogue: 0,0:12:27.74,0:12:29.65,Default,,0000,0000,0000,,Мен көптеген қызықты нәрселер бар деп үміттенемін
Dialogue: 0,0:12:31.96,0:12:32.58,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:12:41.83,0:12:42.76,Default,,0000,0000,0000,,Күніңіз сәтті өтсін
Dialogue: 0,0:12:55.72,0:12:57.39,Default,,0000,0000,0000,,Сакура
Dialogue: 0,0:12:59.99,0:13:00.74,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:13:01.74,0:13:04.23,Default,,0000,0000,0000,,Сен мені мүлде ұмыттың.
Dialogue: 0,0:13:04.46,0:13:05.46,Default,,0000,0000,0000,,Эххе
Dialogue: 0,0:13:05.83,0:13:07.23,Default,,0000,0000,0000,,Эххеяарука?
Dialogue: 0,0:13:09.69,0:13:14.27,Default,,0000,0000,0000,,Сағынышқа толы Гонконг үшін бүгінді өткізіп жіберемін деп ойлаймын.
Dialogue: 0,0:13:17.15,0:13:17.51,Default,,0000,0000,0000,,қайда?
Dialogue: 0,0:13:19.80,0:13:20.82,Default,,0000,0000,0000,,Гонконг.
Dialogue: 0,0:13:23.13,0:13:23.80,Default,,0000,0000,0000,,Бл…ээ…!!
Dialogue: 0,0:13:26.96,0:13:29.07,Default,,0000,0000,0000,,Гонконг! ?
Dialogue: 0,0:13:42.41,0:13:44.61,Default,,0000,0000,0000,,Гонконг аралы өте жақын, солай емес пе?
Dialogue: 0,0:13:46.39,0:13:48.47,Default,,0000,0000,0000,,Мен мұны 5 минуттай ғана айдадым.
Dialogue: 0,0:13:51.07,0:13:53.34,Default,,0000,0000,0000,,Әй, сен бортқа тым көп отырсың.
Dialogue: 0,0:13:53.34,0:13:54.60,Default,,0000,0000,0000,,Сізді акула жеп қояды
Dialogue: 0,0:13:54.93,0:13:56.94,Default,,0000,0000,0000,,үшін? Акула бар ма?
Dialogue: 0,0:13:58.27,0:13:59.63,Default,,0000,0000,0000,,Бұл нұсқаулықта болды.
Dialogue: 0,0:14:06.72,0:14:07.23,Default,,0000,0000,0000,,Акула?
Dialogue: 0,0:14:11.94,0:14:15.39,Default,,0000,0000,0000,,Шағала мырза! Шағала мырза! Шағала мырза! Шағала мырза!
Dialogue: 0,0:14:15.72,0:14:17.55,Default,,0000,0000,0000,,Сакура-чан, сен де бүгін жақсысың.
Dialogue: 0,0:14:20.02,0:14:20.53,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:14:21.30,0:14:23.92,Default,,0000,0000,0000,,Маған кемелер ұнайды.
Dialogue: 0,0:14:25.20,0:14:25.92,Default,,0000,0000,0000,,Хаха, мен де.
Dialogue: 0,0:14:26.25,0:14:28.92,Default,,0000,0000,0000,,Сакура-чан, сен керемет көрінесің.
Dialogue: 0,0:14:30.01,0:14:31.50,Default,,0000,0000,0000,,Мені кейінірек суретке түсіріңізші.
Dialogue: 0,0:14:32.12,0:14:32.45,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:14:48.25,0:14:50.44,Default,,0000,0000,0000,,Хонма өзгерді.
Dialogue: 0,0:14:51.06,0:14:55.54,Default,,0000,0000,0000,,Керо-чанның Гонконгта тұрғанына өте ұзақ уақыт болды.
Dialogue: 0,0:14:56.98,0:14:57.58,Default,,0000,0000,0000,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:14:59.72,0:15:01.20,Default,,0000,0000,0000,,Белгілер өзгерген жоқ
Dialogue: 0,0:15:01.94,0:15:04.36,Default,,0000,0000,0000,,Бұрынғыдай жынның қатысуы қалады
Dialogue: 0,0:15:05.09,0:15:07.75,Default,,0000,0000,0000,,Жапонияда сағыныш сезімі әлдеқашан сөніп қалды.
Dialogue: 0,0:15:08.45,0:15:09.23,Default,,0000,0000,0000,,Юкине-кун, барсың ба?
Dialogue: 0,0:15:13.69,0:15:15.64,Default,,0000,0000,0000,,Жақсы тамақ
Dialogue: 0,0:15:15.87,0:15:17.91,Default,,0000,0000,0000,,Ах, Керо-чан
Dialogue: 0,0:15:22.98,0:15:24.25,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:15:25.54,0:15:29.00,Default,,0000,0000,0000,,Лотереяда жолы болмаған сияқты Сакура бас жүлдені жеңіп алды.
Dialogue: 0,0:15:29.64,0:15:30.64,Default,,0000,0000,0000,,Не дедің!
Dialogue: 0,0:15:31.16,0:15:32.17,Default,,0000,0000,0000,,Ал, тыңда.
Dialogue: 0,0:15:34.17,0:15:37.83,Default,,0000,0000,0000,,Дүниеде кездейсоқтық жоқ, бірақ Кроу теориясы солай болды
Dialogue: 0,0:15:38.77,0:15:40.23,Default,,0000,0000,0000,,Сакура арнайы жүлдені жеңіп алды.
Dialogue: 0,0:15:40.49,0:15:42.72,Default,,0000,0000,0000,,Менің ойымша, бұл белгілі бір мағынаға ие болуы мүмкін.
Dialogue: 0,0:15:44.19,0:15:45.04,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:15:45.80,0:15:49.09,Default,,0000,0000,0000,,Менің бұлай істегенім Гонконгтың назарын аудара ма?
Dialogue: 0,0:16:10.38,0:16:11.46,Default,,0000,0000,0000,,Білемін, білемін!
Dialogue: 0,0:16:54.21,0:16:54.82,Default,,0000,0000,0000,,Who?
Dialogue: 0,0:17:41.71,0:17:43.02,Default,,0000,0000,0000,,Тағы да сол арман
Dialogue: 0,0:17:46.32,0:17:47.35,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:17:53.03,0:17:54.27,Default,,0000,0000,0000,,Және сол төрт нәрсе.
Dialogue: 0,0:17:54.59,0:17:57.44,Default,,0000,0000,0000,,Мынау да төрт, мынау да, анау да.
Dialogue: 0,0:17:59.77,0:18:00.35,Default,,0000,0000,0000,,Әзірге
Dialogue: 0,0:18:01.89,0:18:03.09,Default,,0000,0000,0000,,Ал, тамақ ішейік.
Dialogue: 0,0:18:03.73,0:18:04.98,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:18:06.08,0:18:08.29,Default,,0000,0000,0000,,Томойо-чан, оны екіге бөлгіңіз келе ме?
Dialogue: 0,0:18:08.66,0:18:09.06,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:18:12.66,0:18:13.44,Default,,0000,0000,0000,,Керо! Ух...
Dialogue: 0,0:18:15.56,0:18:16.07,Default,,0000,0000,0000,,Керо...?
Dialogue: 0,0:18:16.65,0:18:20.31,Default,,0000,0000,0000,,Жоқ, мен басқа нәрсені таңдаймын деп ойлаймын.
Dialogue: 0,0:18:21.15,0:18:22.67,Default,,0000,0000,0000,,Онда тіпті бақаның аяғы да болды ма?
Dialogue: 0,0:18:22.98,0:18:24.83,Default,,0000,0000,0000,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:18:26.74,0:18:28.26,Default,,0000,0000,0000,,Мен қайсысын таңдауым керек?
Dialogue: 0,0:18:29.64,0:18:31.21,Default,,0000,0000,0000,,Қайтарғаныңды маған бер.
Dialogue: 0,0:18:32.74,0:18:34.42,Default,,0000,0000,0000,,Жақын жерде дәл солай емес пе?
Dialogue: 0,0:18:34.72,0:18:36.17,Default,,0000,0000,0000,,Бұл маңызды емес...
Dialogue: 0,0:18:37.28,0:18:38.19,Default,,0000,0000,0000,,Бұл жақсы
Dialogue: 0,0:18:40.43,0:18:41.06,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:18:41.45,0:18:44.14,Default,,0000,0000,0000,,Бұл жақсы
Dialogue: 0,0:19:02.40,0:19:03.46,Default,,0000,0000,0000,,Тез беріңіз
Dialogue: 0,0:19:05.94,0:19:06.44,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:19:12.02,0:19:13.41,Default,,0000,0000,0000,,Мен оны жеймін!
Dialogue: 0,0:19:13.72,0:19:15.72,Default,,0000,0000,0000,,Қараңызшы, дәмді көрінеді.
Dialogue: 0,0:19:16.19,0:19:17.28,Default,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:19:17.86,0:19:19.15,Default,,0000,0000,0000,,Аға, кешіріңіз.
Dialogue: 0,0:19:19.58,0:19:20.18,Default,,0000,0000,0000,,Момоя
Dialogue: 0,0:19:24.66,0:19:27.28,Default,,0000,0000,0000,,Осыны жеп болған соң, келесі жолы Құс көшесіне барамын.
Dialogue: 0,0:19:28.07,0:19:29.31,Default,,0000,0000,0000,,Құстар көшесі?
Dialogue: 0,0:19:29.87,0:19:31.95,Default,,0000,0000,0000,,Құстар көп болатын жер.
Dialogue: 0,0:19:38.93,0:19:42.03,Default,,0000,0000,0000,,Құстардың торы сонша
Dialogue: 0,0:19:43.38,0:19:45.12,Default,,0000,0000,0000,,Гонконг тұрғындары құстарды жақсы көреді.
Dialogue: 0,0:19:45.60,0:19:49.15,Default,,0000,0000,0000,,Ол тіпті сүйікті құсын өзімен бірге қыдырғанда торға салып алып жүреді.
Dialogue: 0,0:19:49.75,0:19:50.92,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:19:54.19,0:19:55.95,Default,,0000,0000,0000,,Құстар көшесі?
Dialogue: 0,0:19:56.06,0:19:57.24,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:19:58.24,0:20:01.14,Default,,0000,0000,0000,,Содан бері бұл жерде ештеңе өзгермеген сияқты.
Dialogue: 0,0:20:03.88,0:20:05.24,Default,,0000,0000,0000,,Өте сүйкімді~
Dialogue: 0,0:20:25.15,0:20:26.12,Default,,0000,0000,0000,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:20:26.74,0:20:29.94,Default,,0000,0000,0000,,Мені біреу бақылап тұрғандай болды.
Dialogue: 0,0:20:40.88,0:20:42.62,Default,,0000,0000,0000,,Бұл, әрине, біртүрлі сезінеді.
Dialogue: 0,0:20:43.53,0:20:46.07,Default,,0000,0000,0000,,Кез келген жағдайда, Clow Card Гонконгта да бар ма?
Dialogue: 0,0:20:46.29,0:20:52.83,Default,,0000,0000,0000,,Жоқ, бұл басқа белгі. Бұл көбірек... зұлымдық.
Dialogue: 0,0:20:53.79,0:20:56.29,Default,,0000,0000,0000,,О, тіпті сол жерде.
Dialogue: 0,0:20:57.31,0:20:58.40,Default,,0000,0000,0000,,Ол қашып кетпеді ме?
Dialogue: 0,0:21:05.59,0:21:06.44,Default,,0000,0000,0000,,Мына құс!
Dialogue: 0,0:21:10.94,0:21:11.79,Default,,0000,0000,0000,,Сакура-чан!
Dialogue: 0,0:21:12.99,0:21:13.99,Default,,0000,0000,0000,,Біз де сені қуамыз!
Dialogue: 0,0:21:15.78,0:21:17.24,Default,,0000,0000,0000,,Не болды? Сакура бір...
Dialogue: 0,0:21:17.24,0:21:17.86,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,0:21:19.49,0:21:20.97,Default,,0000,0000,0000,,Мен жақында қайтамын.
Dialogue: 0,0:21:41.88,0:21:42.83,Default,,0000,0000,0000,,Шығарылым
Dialogue: 0,0:21:45.59,0:21:46.03,Default,,0000,0000,0000,,Секір!
Dialogue: 0,0:21:59.75,0:22:00.17,Default,,0000,0000,0000,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,0:22:18.75,0:22:20.54,Default,,0000,0000,0000,,Не? ...бұл сезім
Dialogue: 0,0:24:00.60,0:24:01.54,Default,,0000,0000,0000,,Оян!
Dialogue: 0,0:24:13.77,0:24:17.61,Default,,0000,0000,0000,,Ли мырза? неге мұнда
Dialogue: 0,0:24:33.64,0:24:36.87,Default,,0000,0000,0000,,Сакура-чан, сен қайда бардың?
Dialogue: 0,0:24:42.79,0:24:44.88,Default,,0000,0000,0000,,Кешіріңіз, жақсысыз ба?
Dialogue: 0,0:24:48.08,0:24:51.38,Default,,0000,0000,0000,,Жарайды, бірақ... жапон?
Dialogue: 0,0:24:52.72,0:24:53.59,Default,,0000,0000,0000,,Сәлем
Dialogue: 0,0:24:53.89,0:24:55.07,Default,,0000,0000,0000,,Дайдоджи-сан!
Dialogue: 0,0:24:56.69,0:24:58.67,Default,,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,0:24:59.72,0:25:03.88,Default,,0000,0000,0000,,Сакура-чан лотереядан бас жүлдені жеңіп алды, сондықтан...
Dialogue: 0,0:25:05.91,0:25:07.54,Default,,0000,0000,0000,,Сәлем, кішкентай қыз!
Dialogue: 0,0:25:07.89,0:25:09.89,Default,,0000,0000,0000,,Ой, тұлыптар да?
Dialogue: 0,0:25:09.89,0:25:10.98,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:25:11.11,0:25:12.70,Default,,0000,0000,0000,,Карантиннен дұрыс өттіңіз бе?
Dialogue: 0,0:25:13.01,0:25:14.35,Default,,0000,0000,0000,,Тағы да айтыңыз!
Dialogue: 0,0:25:18.73,0:25:20.92,Default,,0000,0000,0000,,Айтпақшы, сен Сяоранды көрмедің бе?
Dialogue: 0,0:25:21.81,0:25:24.14,Default,,0000,0000,0000,,Дәл қазір сіз кенеттен біртүрлі қатысуды сезіндіңіз деп айттыңыз.
Dialogue: 0,0:25:24.41,0:25:26.20,Default,,0000,0000,0000,,Мен бір жерге қашып кеттім.
Dialogue: 0,0:25:26.78,0:25:29.38,Default,,0000,0000,0000,,Мен де Сакура-чанды іздеп жүрмін...аа!
Dialogue: 0,0:25:31.56,0:25:32.52,Default,,0000,0000,0000,,Сакура-чан!
Dialogue: 0,0:25:35.33,0:25:36.06,Default,,0000,0000,0000,,Сяоран!
Dialogue: 0,0:25:37.98,0:25:38.89,Default,,0000,0000,0000,,Томойо-чан
Dialogue: 0,0:25:39.56,0:25:42.92,Default,,0000,0000,0000,,Не болды? Сіз жарақат алдыңыз ба?
Dialogue: 0,0:25:43.65,0:25:44.62,Default,,0000,0000,0000,,Ал Кира
Dialogue: 0,0:25:45.49,0:25:46.90,Default,,0000,0000,0000,,Ол суланған.
Dialogue: 0,0:25:45.43,0:25:48.88,Default,,0000,0000,0000,,Сяоран! Сен қайда болдың? Қазірдің өзінде...
Dialogue: 0,0:25:48.85,0:25:49.73,Default,,0000,0000,0000,,Сакура!
Dialogue: 0,0:25:56.31,0:25:57.82,Default,,0000,0000,0000,,Жалғыз қайда бардың? ?
Dialogue: 0,0:25:58.70,0:26:04.50,Default,,0000,0000,0000,,Кешіріңіз...мм...м...мен шалшыққа құлап қалдым...
Dialogue: 0,0:26:05.87,0:26:06.57,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:26:07.83,0:26:08.43,Default,,0000,0000,0000,,Гааах!
Dialogue: 0,0:26:09.93,0:26:10.26,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:26:11.42,0:26:13.82,Default,,0000,0000,0000,,Не, ұялудың қажеті жоқ, солай ма?
Dialogue: 0,0:26:14.14,0:26:14.82,Default,,0000,0000,0000,,Сәлем
Dialogue: 0,0:26:15.28,0:26:16.68,Default,,0000,0000,0000,,Сәлеметсіз бе...
Dialogue: 0,0:26:17.02,0:26:17.95,Default,,0000,0000,0000,,Сәлеметсіз бе!
Dialogue: 0,0:26:20.05,0:26:20.49,Default,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:26:22.02,0:26:24.98,Default,,0000,0000,0000,,Әзірше мен бір жерде киім ауыстыруым керек.
Dialogue: 0,0:26:26.01,0:26:26.59,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:26:58.29,0:27:01.33,Default,,0000,0000,0000,,Қытай Сакура-чанды суретке түсіруге болады дегенге сенбеймін...
Dialogue: 0,0:27:01.91,0:27:03.46,Default,,0000,0000,0000,,Мен өте бақыттымын.
Dialogue: 0,0:27:05.34,0:27:08.00,Default,,0000,0000,0000,,Иә? Томойо-чан саған шынымен жарасады.
Dialogue: 0,0:27:09.23,0:27:11.43,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:27:18.02,0:27:20.62,Default,,0000,0000,0000,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:27:21.71,0:27:22.91,Default,,0000,0000,0000,,Өте сүйкімді~
Dialogue: 0,0:27:23.71,0:27:24.97,Default,,0000,0000,0000,,Бұл сізге жарасады.
Dialogue: 0,0:27:26.32,0:27:28.78,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:27:28.83,0:27:30.44,Default,,0000,0000,0000,,Мен оны жегім келеді~
Dialogue: 0,0:27:30.44,0:27:33.68,Default,,0000,0000,0000,,Шынында~ Ол қазірдің өзінде сүйкімді...
Dialogue: 0,0:27:33.69,0:27:35.15,Default,,0000,0000,0000,,Тегіс...
Dialogue: 0,0:27:34.35,0:27:35.65,Default,,0000,0000,0000,,Сіз қайсысысыз?
Dialogue: 0,0:27:37.00,0:27:37.68,Default,,0000,0000,0000,,Енді...
Dialogue: 0,0:27:39.27,0:27:41.66,Default,,0000,0000,0000,,Неліктен бізге киім ауыстыру керек?
Dialogue: 0,0:27:41.66,0:27:42.84,Default,,0000,0000,0000,,Саған керемет көрінеді, Момоя.
Dialogue: 0,0:27:43.00,0:27:44.45,Default,,0000,0000,0000,,Бұл да жақсы.
Dialogue: 0,0:27:44.92,0:27:45.70,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:27:46.02,0:27:46.57,Default,,0000,0000,0000,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:27:47.38,0:27:47.78,Default,,0000,0000,0000,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:27:52.50,0:27:54.53,Default,,0000,0000,0000,,Бірақ бүгінгі таңғы ботқасы дәмді болды.
Dialogue: 0,0:27:57.87,0:27:59.29,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:27:58.65,0:27:59.18,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:27:59.78,0:28:00.56,Default,,0000,0000,0000,,Келіңіздер...
Dialogue: 0,0:28:02.33,0:28:04.14,Default,,0000,0000,0000,,Сізге қандай қыз ұнайды?
Dialogue: 0,0:28:05.80,0:28:07.05,Default,,0000,0000,0000,,Мен саған көмектесемін, Сяоран.
Dialogue: 0,0:28:08.03,0:28:09.84,Default,,0000,0000,0000,,Бұл адамдар, Ли...
Dialogue: 0,0:28:10.46,0:28:11.34,Default,,0000,0000,0000,,Әпкелер
Dialogue: 0,0:28:11.72,0:28:12.54,Default,,0000,0000,0000,,Төртеуі де?
Dialogue: 0,0:28:14.72,0:28:15.22,Default,,0000,0000,0000,,О
Dialogue: 0,0:28:18.98,0:28:21.53,Default,,0000,0000,0000,,Сіз сондай жарқын ханымсыз.
Dialogue: 0,0:28:22.28,0:28:24.87,Default,,0000,0000,0000,,Не деген күдікті апа.
Dialogue: 0,0:28:25.42,0:28:26.27,Default,,0000,0000,0000,,Керо-чан!
Dialogue: 0,0:28:27.64,0:28:28.81,Default,,0000,0000,0000,,Кешіріңіз, Ли.
Dialogue: 0,0:28:45.37,0:28:46.88,Default,,0000,0000,0000,,Әдемі адам...
Dialogue: 0,0:28:50.37,0:28:51.32,Default,,0000,0000,0000,,Танысқаныма қуаныштымын
Dialogue: 0,0:28:51.38,0:28:51.82,Default,,0000,0000,0000,,Сәлем
Dialogue: 0,0:28:52.40,0:28:53.41,Default,,0000,0000,0000,,Ә? (Кения) Сен➡
Dialogue: 0,0:28:53.67,0:28:55.17,Default,,0000,0000,0000,,үшін? ана?
Dialogue: 0,0:28:59.69,0:29:01.41,Default,,0000,0000,0000,,Сіз жас көрінесіз.
Dialogue: 0,0:29:01.59,0:29:01.97,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:29:03.08,0:29:05.42,Default,,0000,0000,0000,,Құбыжық бастыққа ұқсайды
Dialogue: 0,0:29:05.86,0:29:06.61,Default,,0000,0000,0000,,Керо-чан!
Dialogue: 0,0:29:11.56,0:29:13.44,Default,,0000,0000,0000,,Оны жоққа шығармаңыз.
Dialogue: 0,0:29:14.57,0:29:15.19,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:29:19.22,0:29:23.37,Default,,0000,0000,0000,,Танысқаныма қуаныштымын, мен Сакура Киномотомын.
Dialogue: 0,0:29:23.68,0:29:25.99,Default,,0000,0000,0000,,Бүгін маған әдемі киімдер беріңіз...
Dialogue: 0,0:29:33.88,0:29:36.14,Default,,0000,0000,0000,,Мен күшті күшті сезінемін
Dialogue: 0,0:29:37.04,0:29:39.03,Default,,0000,0000,0000,,Сізде Clow картасы бар.
Dialogue: 0,0:29:49.22,0:29:54.07,Default,,0000,0000,0000,,Күшті күштер қиындықтарды тартуға да себеп болуы мүмкін.
Dialogue: 0,0:29:55.44,0:29:57.44,Default,,0000,0000,0000,,Әсіресе Гонконгта
Dialogue: 0,0:30:04.81,0:30:06.14,Default,,0000,0000,0000,,Түнде болыңыз
Dialogue: 0,0:30:06.59,0:30:06.99,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:30:07.73,0:30:09.45,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:30:14.95,0:30:15.63,Default,,0000,0000,0000,,Сяоран
Dialogue: 0,0:30:18.92,0:30:20.55,Default,,0000,0000,0000,,Есеп картасын тапсырыңыз
Dialogue: 0,0:30:31.87,0:30:34.81,Default,,0000,0000,0000,,А, менде бүгін өте ауыр күн болды.
Dialogue: 0,0:30:39.09,0:30:41.31,Default,,0000,0000,0000,,Сіз әдемі ана едіңіз.
Dialogue: 0,0:30:42.13,0:30:44.11,Default,,0000,0000,0000,,Иә, жақсы болды.
Dialogue: 0,0:30:45.35,0:30:48.14,Default,,0000,0000,0000,,Оның үстіне ол біртүрлі адам болатын.
Dialogue: 0,0:30:48.89,0:30:49.92,Default,,0000,0000,0000,,Мен тек қағаз ғана лақтырамын.
Dialogue: 0,0:30:50.97,0:30:54.24,Default,,0000,0000,0000,,Сол ананың да күші зор.
Dialogue: 0,0:30:54.99,0:30:57.14,Default,,0000,0000,0000,,Күтілгендей, ол Қарға Ридпен туыс.
Dialogue: 0,0:30:57.72,0:30:59.29,Default,,0000,0000,0000,,Қарғаның анасының үйі
Dialogue: 0,0:30:59.58,0:31:02.83,Default,,0000,0000,0000,,Қытайдағы атақты даосшылардың отбасынан шыққан.
Dialogue: 0,0:31:03.88,0:31:07.76,Default,,0000,0000,0000,,Қарға мырза өте атақты сиқыршы болған, солай емес пе?
Dialogue: 0,0:31:08.15,0:31:10.36,Default,,0000,0000,0000,,Сол кездегі ең күштісі шығар.
Dialogue: 0,0:31:11.10,0:31:14.77,Default,,0000,0000,0000,,Бірақ, менде бұрмаланған рух болды, жауларым көп болды.
Dialogue: 0,0:31:15.03,0:31:16.83,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:31:25.66,0:31:27.16,Default,,0000,0000,0000,,Бірақ егер бұл орын алса
Dialogue: 0,0:31:27.49,0:31:29.76,Default,,0000,0000,0000,,Мен киімдерімді әкелуім керек еді.
Dialogue: 0,0:31:31.40,0:31:34.46,Default,,0000,0000,0000,,Қонақ үйге қайтқанда киіміңізді ауыстырыңыз.
Dialogue: 0,0:31:35.04,0:31:35.88,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:31:36.80,0:31:40.44,Default,,0000,0000,0000,,Ал Сакура-чан Гонконг көшелерінде билеп жатыр...
Dialogue: 0,0:31:41.22,0:31:44.24,Default,,0000,0000,0000,,Мені де суретке түсіріңіз~
Dialogue: 0,0:31:47.31,0:31:48.56,Default,,0000,0000,0000,,Қайырлы түн, Томойо-чан
Dialogue: 0,0:31:49.13,0:31:50.10,Default,,0000,0000,0000,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:32:09.86,0:32:14.39,Default,,0000,0000,0000,,Күшті күштер қиындықтарды тартуға да себеп болуы мүмкін.
Dialogue: 0,0:32:16.19,0:32:17.94,Default,,0000,0000,0000,,Әсіресе осы Гонконгта
Dialogue: 0,0:32:37.32,0:32:40.38,Default,,0000,0000,0000,,Бұл тағы да арман
Dialogue: 0,0:32:51.27,0:32:52.96,Default,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:32:58.43,0:32:59.22,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:33:19.51,0:33:22.00,Default,,0000,0000,0000,,Мен көптен бері күттім
Dialogue: 0,0:33:26.28,0:33:29.02,Default,,0000,0000,0000,,Күтіңіз, мәңгілік
Dialogue: 0,0:33:32.51,0:33:38.07,Default,,0000,0000,0000,,Мен көптен бері сені ғана күттім
Dialogue: 0,0:33:59.78,0:34:03.02,Default,,0000,0000,0000,,Ұзақ уақыт тек сен
Dialogue: 0,0:34:21.99,0:34:24.28,Default,,0000,0000,0000,,Сакура, саған не болды? сакура!
Dialogue: 0,0:34:27.30,0:34:28.44,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:34:31.43,0:34:32.04,Default,,0000,0000,0000,,Арман...
Dialogue: 0,0:34:39.07,0:34:40.97,Default,,0000,0000,0000,,Бұл жай ғана арман.
Dialogue: 0,0:34:47.04,0:34:47.31,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:35:07.73,0:35:10.83,Default,,0000,0000,0000,,Нефрит императорының жарлығы төрт бағыт
Dialogue: 0,0:35:07.73,0:35:10.83,Furigana,,0000,0000,0000,,Гёку
Dialogue: 0,0:35:07.73,0:35:10.83,Furigana,,0000,0000,0000,,...
Dialogue: 0,0:35:07.73,0:35:10.83,Furigana,,0000,0000,0000,,Ю
Dialogue: 0,0:35:07.73,0:35:10.83,Furigana,,0000,0000,0000,,Чоку
Dialogue: 0,0:35:07.73,0:35:10.83,Furigana,,0000,0000,0000,,Шин
Dialogue: 0,0:35:07.73,0:35:10.83,Furigana,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:35:07.73,0:35:10.83,Furigana,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:35:07.73,0:35:10.83,Furigana,,0000,0000,0000,,Хо
Dialogue: 0,0:35:12.07,0:35:16.42,Default,,0000,0000,0000,,Алтын, ағаш, су, от, жер, найзағай жел, күн күркіреуі құдай жарлығы
Dialogue: 0,0:35:12.07,0:35:16.42,Furigana,,0000,0000,0000,,Кин
Dialogue: 0,0:35:12.07,0:35:16.42,Furigana,,0000,0000,0000,,Моку
Dialogue: 0,0:35:12.07,0:35:16.42,Furigana,,0000,0000,0000,,Sui
Dialogue: 0,0:35:12.07,0:35:16.42,Furigana,,0000,0000,0000,,Немесе
Dialogue: 0,0:35:12.07,0:35:16.42,Furigana,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:35:12.07,0:35:16.42,Furigana,,0000,0000,0000,,Алапес
Dialogue: 0,0:35:12.07,0:35:16.42,Furigana,,0000,0000,0000,,Иә
Dialogue: 0,0:35:12.07,0:35:16.42,Furigana,,0000,0000,0000,,Алапес
Dialogue: 0,0:35:12.07,0:35:16.42,Furigana,,0000,0000,0000,,Ден
Dialogue: 0,0:35:12.07,0:35:16.42,Furigana,,0000,0000,0000,,Шин
Dialogue: 0,0:35:12.07,0:35:16.42,Furigana,,0000,0000,0000,,Чоку
Dialogue: 0,0:35:17.49,0:35:20.35,Default,,0000,0000,0000,,Нефрит императорының төрт бағыттағы құдайлық сия тасты жазуы
Dialogue: 0,0:35:17.49,0:35:20.35,Furigana,,0000,0000,0000,,Гёку
Dialogue: 0,0:35:17.49,0:35:20.35,Furigana,,0000,0000,0000,,...
Dialogue: 0,0:35:17.49,0:35:20.35,Furigana,,0000,0000,0000,,Ю
Dialogue: 0,0:35:17.49,0:35:20.35,Furigana,,0000,0000,0000,,Чоку
Dialogue: 0,0:35:17.49,0:35:20.35,Furigana,,0000,0000,0000,,Шин
Dialogue: 0,0:35:17.49,0:35:20.35,Furigana,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:35:17.49,0:35:20.35,Furigana,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:35:17.49,0:35:20.35,Furigana,,0000,0000,0000,,Хо
Dialogue: 0,0:35:21.17,0:35:23.69,Default,,0000,0000,0000,,Найзағай Жел Рейден Құдай жарлығы
Dialogue: 0,0:35:21.17,0:35:23.69,Furigana,,0000,0000,0000,,Алапес
Dialogue: 0,0:35:21.17,0:35:23.69,Furigana,,0000,0000,0000,,Иә
Dialogue: 0,0:35:21.17,0:35:23.69,Furigana,,0000,0000,0000,,Алапес
Dialogue: 0,0:35:21.17,0:35:23.69,Furigana,,0000,0000,0000,,Ден
Dialogue: 0,0:35:21.17,0:35:23.69,Furigana,,0000,0000,0000,,Шин
Dialogue: 0,0:35:21.17,0:35:23.69,Furigana,,0000,0000,0000,,Чоку
Dialogue: 0,0:35:24.17,0:35:26.33,Default,,0000,0000,0000,,Жарық журналының найзағайы
Dialogue: 0,0:35:24.17,0:35:26.33,Furigana,,0000,0000,0000,,Кей
Dialogue: 0,0:35:24.17,0:35:26.33,Furigana,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:35:24.17,0:35:26.33,Furigana,,0000,0000,0000,,Hekireki
Dialogue: 0,0:35:24.17,0:35:26.33,Furigana,,0000,0000,0000,,Ден
Dialogue: 0,0:35:24.17,0:35:26.33,Furigana,,0000,0000,0000,,Мынау да.
Dialogue: 0,0:35:24.17,0:35:26.33,Furigana,,0000,0000,0000,,Он
Dialogue: 0,0:35:27.00,0:35:28.75,Default,,0000,0000,0000,,Кенеттен Рицурё!
Dialogue: 0,0:35:27.00,0:35:28.75,Furigana,,0000,0000,0000,,Кюу
Dialogue: 0,0:35:27.00,0:35:28.75,Furigana,,0000,0000,0000,,Кюу
Dialogue: 0,0:35:27.00,0:35:28.75,Furigana,,0000,0000,0000,,Жоқ
Dialogue: 0,0:35:27.00,0:35:28.75,Furigana,,0000,0000,0000,,Рицу
Dialogue: 0,0:35:27.00,0:35:28.75,Furigana,,0000,0000,0000,,Рио
Dialogue: 0,0:35:43.67,0:35:46.93,Default,,0000,0000,0000,,Сізді Гонконгқа шақырған сияқты.
Dialogue: 0,0:35:48.38,0:35:49.41,Default,,0000,0000,0000,,Кімге?
Dialogue: 0,0:35:56.58,0:35:58.39,Default,,0000,0000,0000,,Түсімдегі әйелге
Dialogue: 0,0:36:00.86,0:36:02.08,Default,,0000,0000,0000,,Абайлаңыз
Dialogue: 0,0:36:02.82,0:36:06.77,Default,,0000,0000,0000,,Теңдесі жоқ дағдарыс жақындап келеді.
Dialogue: 0,0:36:07.99,0:36:09.64,Default,,0000,0000,0000,,Мен не істеуім керек...
Dialogue: 0,0:36:11.31,0:36:15.56,Default,,0000,0000,0000,,Сіз жүру керек жолды тек сіз білесіз
Dialogue: 0,0:36:17.01,0:36:19.86,Default,,0000,0000,0000,,Күшті заттар жындарды тартады.
Dialogue: 0,0:36:21.15,0:36:25.21,Default,,0000,0000,0000,,Әсіресе сізде Clow Reed жасаған Clow Card болса.
Dialogue: 0,0:36:26.43,0:36:29.41,Default,,0000,0000,0000,,Сіз шақырған жын да үлкейеді.
Dialogue: 0,0:36:33.55,0:36:37.17,Default,,0000,0000,0000,,Бірақ бұл үшін де нұсқаулық бар.
Dialogue: 0,0:36:41.92,0:36:44.70,Default,,0000,0000,0000,,Азғыратын жын да түсіңде
Dialogue: 0,0:36:45.68,0:36:48.70,Default,,0000,0000,0000,,Ал көмектесу де арманда
Dialogue: 0,0:37:16.62,0:37:20.89,Default,,0000,0000,0000,,Уайымдама, жауабын табасың.
Dialogue: 0,0:37:34.37,0:37:39.26,Default,,0000,0000,0000,,Жоқ, мен қазір кетемін.
Dialogue: 0,0:37:39.40,0:37:42.50,Default,,0000,0000,0000,,Мен жалғыз боламын
Dialogue: 0,0:37:43.16,0:37:45.19,Default,,0000,0000,0000,,Мен кеше шынымен түнеп шықтым.
Dialogue: 0,0:37:45.74,0:37:46.25,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:37:47.69,0:37:49.46,Default,,0000,0000,0000,,Мен де түнеу керек едім.
Dialogue: 0,0:37:57.89,0:38:00.40,Default,,0000,0000,0000,,Мм, көп рахмет.
Dialogue: 0,0:38:14.40,0:38:16.69,Default,,0000,0000,0000,,Ей, кететін уақыт болды.
Dialogue: 0,0:38:18.21,0:38:18.52,Default,,0000,0000,0000,,А, иә
Dialogue: 0,0:38:22.57,0:38:24.21,Default,,0000,0000,0000,,Суға сақ болыңыз
Dialogue: 0,0:38:26.01,0:38:26.49,Default,,0000,0000,0000,,Су?
Dialogue: 0,0:38:30.31,0:38:33.17,Default,,0000,0000,0000,,Артқы жағындағы пышақ Қытай банкі.
Dialogue: 0,0:38:33.55,0:38:38.19,Default,,0000,0000,0000,,-де төбесінде зеңбірек дизайны бар - Гонконг және Шанхай банкі.
Dialogue: 0,0:38:39.04,0:38:43.86,Default,,0000,0000,0000,,Бұл Гонконгтың экономикалық орталығы және екі банк бәсекелес.
Dialogue: 0,0:38:44.30,0:38:45.12,Default,,0000,0000,0000,,(Панда) Бірінші курс студентін жіберуді қамтитын Арнайы сынып ісі — бұл төтенше жағдай.
Dialogue: 0,0:38:46.40,0:38:50.89,Default,,0000,0000,0000,,Өйткені, Сакураның Гонконгқа келуі жай ғана кездейсоқтық сияқты.
Dialogue: 0,0:38:55.13,0:38:57.67,Default,,0000,0000,0000,,Сонымен, мен лотерея ұтып алдым.
Dialogue: 0,0:38:57.88,0:39:00.31,Default,,0000,0000,0000,,Мұның бәрі түсіндегі адамның жұмысы ма?
Dialogue: 0,0:39:01.39,0:39:05.01,Default,,0000,0000,0000,,Осындай нәрсені жасай алатын адам бар ма?
Dialogue: 0,0:39:05.85,0:39:10.82,Default,,0000,0000,0000,,Білмеймін, егер солай болса, неге Сакура...
Dialogue: 0,0:39:22.09,0:39:24.97,Default,,0000,0000,0000,,Неге біз бірге болуымыз керек! ?
Dialogue: 0,0:39:25.51,0:39:28.61,Default,,0000,0000,0000,,Бұл көмектеспейді, анам солай істе деді.
Dialogue: 0,0:39:29.17,0:39:31.26,Default,,0000,0000,0000,,Сізге туристік гид бергенімді қалайсыз ба?
Dialogue: 0,0:39:31.77,0:39:32.43,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:39:32.80,0:39:34.06,Default,,0000,0000,0000,,Сонда ше!
Dialogue: 0,0:39:36.31,0:39:38.49,Default,,0000,0000,0000,,Қандай да бір қауіп жақындап қалған сияқты.
Dialogue: 0,0:39:45.68,0:39:46.66,Default,,0000,0000,0000,,Әдемі...
Dialogue: 0,0:39:50.00,0:39:55.83,Default,,0000,0000,0000,,Ойлап қарасам, түсімдегі әйелдің де шашына әдемі ою бар екен.
Dialogue: 0,0:40:01.47,0:40:02.13,Default,,0000,0000,0000,,Бұл әдемі.
Dialogue: 0,0:40:04.19,0:40:04.61,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:40:13.81,0:40:14.55,Default,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:40:15.10,0:40:18.12,Default,,0000,0000,0000,,Не? Бұл мен... бұл
Dialogue: 0,0:40:19.14,0:40:20.65,Default,,0000,0000,0000,,Юкито-сан, мен...
Dialogue: 0,0:40:21.64,0:40:21.86,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:40:25.23,0:40:26.07,Default,,0000,0000,0000,,Сізге сәйкес келетініне сенімдімін.
Dialogue: 0,0:40:30.45,0:40:32.23,Default,,0000,0000,0000,,Ах, рахмет
Dialogue: 0,0:40:36.34,0:40:37.25,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:40:38.41,0:40:40.00,Default,,0000,0000,0000,,Ештеңе...
Dialogue: 0,0:40:53.67,0:40:54.41,Default,,0000,0000,0000,,Сакура-чан?
Dialogue: 0,0:40:54.53,0:40:56.09,Default,,0000,0000,0000,,Сәлем, Сакура!
Dialogue: 0,0:40:58.42,0:40:59.62,Default,,0000,0000,0000,,Сен ақымақ
Dialogue: 0,0:41:15.35,0:41:16.14,Default,,0000,0000,0000,,Мүлдем...!
Dialogue: 0,0:41:21.20,0:41:22.84,Default,,0000,0000,0000,,Керо-чан, шықсаң болды!
Dialogue: 0,0:41:24.66,0:41:28.29,Default,,0000,0000,0000,,Жындар бар және олар шынымен күшті!
Dialogue: 0,0:41:28.56,0:41:28.88,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:41:35.97,0:41:38.04,Default,,0000,0000,0000,,Бұл сіздің түсіңізде пайда болған құс па?
Dialogue: 0,0:41:38.45,0:41:38.81,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:41:40.33,0:41:42.24,Default,,0000,0000,0000,,Бұл жай құс емес.
Dialogue: 0,0:41:42.68,0:41:45.94,Default,,0000,0000,0000,,Саналылық және күшті сиқырлы күш
Dialogue: 0,0:42:00.80,0:42:02.08,Default,,0000,0000,0000,,Сіз кіріңіз дейсіз бе?
Dialogue: 0,0:42:02.69,0:42:03.73,Default,,0000,0000,0000,,Олардың тәрбиесіне байланысты
Dialogue: 0,0:42:39.49,0:42:40.87,Default,,0000,0000,0000,,Мұнда ешкім жоқ сияқты
Dialogue: 0,0:42:41.58,0:42:41.96,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:42:44.72,0:42:45.40,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:42:46.30,0:42:47.81,Default,,0000,0000,0000,,Судың дыбысын естімейсің бе?
Dialogue: 0,0:42:55.62,0:42:56.27,Default,,0000,0000,0000,,...орындау
Dialogue: 0,0:43:11.56,0:43:12.69,Default,,0000,0000,0000,,Осы кітаптан
Dialogue: 0,0:43:34.90,0:43:35.78,Default,,0000,0000,0000,,Бұл адам...!
Dialogue: 0,0:43:46.99,0:43:48.42,Default,,0000,0000,0000,,Эй, Сакура, сен не істеп жатырсың?
Dialogue: 0,0:43:53.00,0:43:53.76,Default,,0000,0000,0000,,Келіңіздер
Dialogue: 0,0:44:01.63,0:44:03.73,Default,,0000,0000,0000,,Сакура, мықты бол!
Dialogue: 0,0:44:05.64,0:44:06.38,Default,,0000,0000,0000,,Келіңіз...
Dialogue: 0,0:44:13.26,0:44:15.76,Default,,0000,0000,0000,,Мұнда келіңіз...
Dialogue: 0,0:44:21.62,0:44:22.38,Default,,0000,0000,0000,,Мұны істеме...
Dialogue: 0,0:44:24.20,0:44:24.89,Default,,0000,0000,0000,,Сакура-чан
Dialogue: 0,0:44:27.50,0:44:28.40,Default,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:44:28.72,0:44:30.55,Default,,0000,0000,0000,,Мен барлық жерден іздедім.
Dialogue: 0,0:44:31.96,0:44:32.82,Default,,0000,0000,0000,,Бұл белгі
Dialogue: 0,0:44:36.68,0:44:37.33,Default,,0000,0000,0000,,Сакура
Dialogue: 0,0:44:54.22,0:44:56.19,Default,,0000,0000,0000,,Сакура, не болды, эй!
Dialogue: 0,0:45:03.71,0:45:04.73,Default,,0000,0000,0000,,W-не! ?
Dialogue: 0,0:45:46.33,0:45:47.03,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:45:47.81,0:45:48.41,Default,,0000,0000,0000,,Керо-чан...
Dialogue: 0,0:45:48.85,0:45:50.94,Default,,0000,0000,0000,,Сіз есін жиған сияқтысыз.
Dialogue: 0,0:45:51.43,0:45:53.57,Default,,0000,0000,0000,,Әй, бұл түс пе?
Dialogue: 0,0:45:54.26,0:45:55.28,Default,,0000,0000,0000,,Бұл арман емес
Dialogue: 0,0:46:10.17,0:46:13.41,Default,,0000,0000,0000,,Бұл мен сиқырмен жасаған дүние.
Dialogue: 0,0:46:16.75,0:46:18.63,Default,,0000,0000,0000,,Неге ол емес?
Dialogue: 0,0:46:19.39,0:46:21.02,Default,,0000,0000,0000,,Сіз дәл қазір кітаптансыз.
Dialogue: 0,0:46:21.53,0:46:25.25,Default,,0000,0000,0000,,Сен сияқты кішкентай қыз мұнда не үшін келді?
Dialogue: 0,0:46:40.07,0:46:40.91,Default,,0000,0000,0000,,Жауап!
Dialogue: 0,0:46:41.82,0:46:42.28,Default,,0000,0000,0000,,Сакура!
Dialogue: 0,0:46:42.62,0:46:42.92,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:46:46.04,0:46:46.80,Default,,0000,0000,0000,,Ұшу
Dialogue: 0,0:46:47.32,0:46:48.18,Default,,0000,0000,0000,,Клоу картасы! ?
Dialogue: 0,0:46:50.00,0:46:52.81,Default,,0000,0000,0000,,Неліктен, сенде Clow Card бар! ?
Dialogue: 0,0:47:06.66,0:47:09.27,Default,,0000,0000,0000,,Бұл адам Clow Cards туралы білетін сияқты!
Dialogue: 0,0:47:11.11,0:47:12.46,Default,,0000,0000,0000,,Сакура, алда!
Dialogue: 0,0:47:23.26,0:47:24.03,Default,,0000,0000,0000,,Мұзда!
Dialogue: 0,0:47:31.05,0:47:31.81,Default,,0000,0000,0000,,Клоу картасы! ?
Dialogue: 0,0:47:35.96,0:47:36.72,Default,,0000,0000,0000,,Ли мырза!
Dialogue: 0,0:47:39.34,0:47:41.09,Default,,0000,0000,0000,,Сізде де Clow Card бар
Dialogue: 0,0:47:42.51,0:47:43.50,Default,,0000,0000,0000,,Неге мұндасың?
Dialogue: 0,0:47:44.12,0:47:46.58,Default,,0000,0000,0000,,Суға жұтылып, өзімді осында таптым.
Dialogue: 0,0:47:46.97,0:47:48.78,Default,,0000,0000,0000,,Олай болса, бәрі сонда...
Dialogue: 0,0:47:49.14,0:47:50.21,Default,,0000,0000,0000,,Ол бір жерде болуы керек.
Dialogue: 0,0:47:51.32,0:47:52.70,Default,,0000,0000,0000,,Мен оны тезірек табуым керек.
Dialogue: 0,0:47:54.39,0:47:55.62,Default,,0000,0000,0000,,Оны іздеудің қажеті жоқ
Dialogue: 0,0:47:57.99,0:48:01.42,Default,,0000,0000,0000,,Өзіңізбен бірге алғаныңыз сонда.
Dialogue: 0,0:48:18.37,0:48:20.76,Default,,0000,0000,0000,,Мен Қарға Ридке телефон соқтым.
Dialogue: 0,0:48:21.98,0:48:23.00,Default,,0000,0000,0000,,Бірақ неге?
Dialogue: 0,0:48:25.41,0:48:27.26,Default,,0000,0000,0000,,Мына апа қайда?
Dialogue: 0,0:48:28.44,0:48:30.01,Default,,0000,0000,0000,,Кроурид қайда?
Dialogue: 0,0:48:32.29,0:48:33.38,Default,,0000,0000,0000,,Ол екі топқа бөлінеді.
Dialogue: 0,0:48:34.44,0:48:35.87,Default,,0000,0000,0000,,Мен оның қозғалуын тоқтатамын.
Dialogue: 0,0:48:36.44,0:48:39.09,Default,,0000,0000,0000,,Барлығына көмектесу үшін сол мүмкіндікті пайдаланыңыз.
Dialogue: 0,0:48:39.66,0:48:40.09,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:48:41.21,0:48:42.86,Default,,0000,0000,0000,,Қарға Рид қайда! ?
Dialogue: 0,0:48:46.63,0:48:47.17,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:48:47.38,0:48:47.74,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:48:55.13,0:48:55.87,Default,,0000,0000,0000,,Дауыл!
Dialogue: 0,0:49:11.80,0:49:12.73,Default,,0000,0000,0000,,Қылыш!
Dialogue: 0,0:49:27.44,0:49:28.19,Default,,0000,0000,0000,,Ұш!
Dialogue: 0,0:49:30.68,0:49:31.27,Default,,0000,0000,0000,,Керо-чан!
Dialogue: 0,0:49:36.92,0:49:43.37,Default,,0000,0000,0000,,Мейрин-чан… Онии-чан… Юкито-сан…
Dialogue: 0,0:49:45.30,0:49:47.80,Default,,0000,0000,0000,,Күте тұрыңыз, мен бірден қайтамын.
Dialogue: 0,0:49:48.95,0:49:50.36,Default,,0000,0000,0000,,Сакура, тезірек!
Dialogue: 0,0:49:50.45,0:49:50.94,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:50:05.08,0:50:06.61,Default,,0000,0000,0000,,Қат, жоқ!
Dialogue: 0,0:50:12.23,0:50:13.79,Default,,0000,0000,0000,,Байқадың ба, Томойо?
Dialogue: 0,0:50:14.94,0:50:15.97,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:50:19.62,0:50:21.92,Default,,0000,0000,0000,,Мен қайдамын...?
Dialogue: 0,0:50:22.36,0:50:24.00,Default,,0000,0000,0000,,Әзірше мен кейінірек түсіндіремін.
Dialogue: 0,0:50:24.35,0:50:24.78,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:50:40.09,0:50:43.83,Default,,0000,0000,0000,,Құрметті мырза.
Dialogue: 0,0:50:50.53,0:50:51.29,Default,,0000,0000,0000,,Мені кешір!
Dialogue: 0,0:50:57.00,0:50:58.16,Default,,0000,0000,0000,,Керо-чан осында қал!
Dialogue: 0,0:50:58.31,0:50:58.84,Default,,0000,0000,0000,,Сакура!
Dialogue: 0,0:50:58.84,0:50:59.65,Default,,0000,0000,0000,,Сакура-чан!
Dialogue: 0,0:51:03.78,0:51:05.71,Default,,0000,0000,0000,,Ли мырза! Ли мырза!
Dialogue: 0,0:51:06.54,0:51:09.30,Default,,0000,0000,0000,,Ли мырза! Жауап беріңіз!
Dialogue: 0,0:51:10.94,0:51:11.58,Default,,0000,0000,0000,,, қаш
Dialogue: 0,0:51:17.96,0:51:18.75,Default,,0000,0000,0000,,Кенеттен татами төсегі жарылып кетті.
Dialogue: 0,0:51:26.53,0:51:29.31,Default,,0000,0000,0000,,Келме! Тек сендер қаша аласыңдар
Dialogue: 0,0:51:29.76,0:51:30.38,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:51:33.73,0:51:35.36,Default,,0000,0000,0000,,Сиқырлы күш аспанда әлсіз
Dialogue: 0,0:51:36.11,0:51:38.11,Default,,0000,0000,0000,,You should be able to get out by jumping up.
Dialogue: 0,0:51:38.21,0:51:38.91,Default,,0000,0000,0000,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:51:40.87,0:51:41.83,Default,,0000,0000,0000,,Ли мырза!
Dialogue: 0,0:51:49.88,0:51:51.82,Default,,0000,0000,0000,,Кроурид келмесе
Dialogue: 0,0:51:52.29,0:51:54.01,Default,,0000,0000,0000,,Сиқырлы күшіңізді алып тастаңыз
Dialogue: 0,0:51:54.40,0:51:56.44,Default,,0000,0000,0000,,Оны өзіңіз тапқанша
Dialogue: 0,0:51:57.65,0:51:59.81,Default,,0000,0000,0000,,Сен де менің ризығым бол.
Dialogue: 0,0:52:11.18,0:52:13.24,Default,,0000,0000,0000,,Сакура, қашып кет.
Dialogue: 0,0:52:15.52,0:52:16.70,Default,,0000,0000,0000,,Қаш...
Dialogue: 0,0:52:17.82,0:52:20.19,Default,,0000,0000,0000,,If we continue like this, everyone will be arrested.
Dialogue: 0,0:52:21.00,0:52:21.99,Default,,0000,0000,0000,,Сакура!
Dialogue: 0,0:52:43.77,0:52:45.30,Default,,0000,0000,0000,,Қашпа!
Dialogue: 0,0:52:53.82,0:52:54.77,Default,,0000,0000,0000,,Бұл шығу!
Dialogue: 0,0:53:37.73,0:53:38.70,Default,,0000,0000,0000,,Сакура-чан
Dialogue: 0,0:53:40.86,0:53:43.14,Default,,0000,0000,0000,,Бұл менің кінәм, бәрі.
Dialogue: 0,0:53:43.46,0:53:44.85,Default,,0000,0000,0000,,Бұл Сакураның кінәсі емес
Dialogue: 0,0:53:45.19,0:53:47.67,Default,,0000,0000,0000,,Мұның бәрі сол кітапта...
Dialogue: 0,0:53:48.84,0:53:49.22,Default,,0000,0000,0000,,Кітап…
Dialogue: 0,0:53:50.42,0:53:51.34,Default,,0000,0000,0000,,Сол кітап!
Dialogue: 0,0:53:51.68,0:53:52.64,Default,,0000,0000,0000,,Ойланып көрейікші
Dialogue: 0,0:53:55.67,0:53:56.25,Default,,0000,0000,0000,,Кітап?
Dialogue: 0,0:53:56.54,0:53:58.17,Default,,0000,0000,0000,,Менің ойымша, Томойо түсінбеді.
Dialogue: 0,0:53:58.56,0:54:02.20,Default,,0000,0000,0000,,Біз дәл қазір болған әлем сол кітаптың ішіндегі әлемде болды.
Dialogue: 0,0:54:02.85,0:54:04.78,Default,,0000,0000,0000,,Егер сізде бұл кітап болса
Dialogue: 0,0:54:04.92,0:54:05.70,Default,,0000,0000,0000,,Баршаңызға...
Dialogue: 0,0:54:06.49,0:54:07.73,Default,,0000,0000,0000,,Бұл қандай кітап?
Dialogue: 0,0:54:08.24,0:54:13.03,Default,,0000,0000,0000,,Мен сенімдімін... ескі және біртүрлі сезім бар...
Dialogue: 0,0:54:15.22,0:54:16.67,Default,,0000,0000,0000,,Қатысу жоғалса да
Dialogue: 0,0:54:18.49,0:54:21.78,Default,,0000,0000,0000,,Ол жоқ...ол еш жерде жоқ.
Dialogue: 0,0:54:23.26,0:54:24.05,Default,,0000,0000,0000,,Сакура
Dialogue: 0,0:54:26.53,0:54:31.68,Default,,0000,0000,0000,,Ли-кун, Мейлинг-чан, үлкен аға
Dialogue: 0,0:54:34.19,0:54:35.35,Default,,0000,0000,0000,,Юкито-сан
Dialogue: 0,0:54:36.95,0:54:41.39,Default,,0000,0000,0000,,Мықты болыңыз! Әйтеуір, анау сиқыршы әйел...
Dialogue: 0,0:54:43.62,0:54:44.98,Default,,0000,0000,0000,,Ах! Сол әйел!
Dialogue: 0,0:54:45.48,0:54:47.36,Default,,0000,0000,0000,,Қандай қатыгез қимыл…
Dialogue: 0,0:54:49.66,0:54:51.00,Default,,0000,0000,0000,,Сіз тұтынушысыз ба?
Dialogue: 0,0:54:51.37,0:54:52.90,Default,,0000,0000,0000,,Сәл күте тұрыңыз
Dialogue: 0,0:54:53.52,0:54:54.83,Default,,0000,0000,0000,,Біреу келе жатыр.
Dialogue: 0,0:54:55.29,0:54:56.48,Default,,0000,0000,0000,,Әзірше асығыс орындайық
Dialogue: 0,0:54:56.97,0:54:57.30,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:54:57.52,0:55:01.03,Default,,0000,0000,0000,,Customers, Japanese people, what do you want?
Dialogue: 0,0:55:07.05,0:55:11.82,Default,,0000,0000,0000,,That woman was the sister of a fortune teller who lived here in Hong Kong a long time ago.
Dialogue: 0,0:55:12.34,0:55:12.91,Default,,0000,0000,0000,,Болжам
Dialogue: 0,0:55:13.29,0:55:16.78,Default,,0000,0000,0000,,Saya: I guess I should say water fortune-telling.
Dialogue: 0,0:55:17.42,0:55:20.28,Default,,0000,0000,0000,,Various things are reflected on the water surface.
Dialogue: 0,0:55:20.90,0:55:23.46,Default,,0000,0000,0000,,Apparently it had a good reputation as well.
Dialogue: 0,0:55:24.54,0:55:25.04,Default,,0000,0000,0000,,Бірақ?
Dialogue: 0,0:55:26.85,0:55:29.67,Default,,0000,0000,0000,,Бір күні Қарға Рид пайда болды.
Dialogue: 0,0:55:31.76,0:55:33.86,Default,,0000,0000,0000,,Қарға көріпкел емес.
Dialogue: 0,0:55:34.35,0:55:37.70,Default,,0000,0000,0000,,It's a shame, but fortune-telling done in one hand is so accurate.
Dialogue: 0,0:55:38.13,0:55:41.15,Default,,0000,0000,0000,,It seems like that sister's business has gone up.
Dialogue: 0,0:55:41.49,0:55:42.21,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:55:42.91,0:55:47.47,Default,,0000,0000,0000,,From then on, he began to challenge Crow to battle at every opportunity.
Dialogue: 0,0:55:48.57,0:55:53.49,Default,,0000,0000,0000,,But if he was that long ago, he must have already passed away.
Dialogue: 0,0:55:54.33,0:55:55.12,Default,,0000,0000,0000,,Джуцуя
Dialogue: 0,0:55:55.55,0:55:56.24,Default,,0000,0000,0000,,Дзюцу?
Dialogue: 0,0:55:57.24,0:56:01.07,Default,,0000,0000,0000,,Even after I die, all my thoughts will be copied in that book.
Dialogue: 0,0:56:01.65,0:56:03.30,Default,,0000,0000,0000,,Өте қиын техника
Dialogue: 0,0:56:03.71,0:56:05.23,Default,,0000,0000,0000,,Көңілің көп болмаса
Dialogue: 0,0:56:05.23,0:56:07.85,Default,,0000,0000,0000,,You can't get used to the ability to last for decades.
Dialogue: 0,0:56:08.77,0:56:13.35,Default,,0000,0000,0000,,Maybe by now I wouldn't even realize that I was dying.
Dialogue: 0,0:56:14.22,0:56:17.39,Default,,0000,0000,0000,,That sister must have had a grudge against Crow.
Dialogue: 0,0:56:18.47,0:56:20.99,Default,,0000,0000,0000,,Сонымен техниканың мақсаты қандай?
Dialogue: 0,0:56:21.38,0:56:24.94,Default,,0000,0000,0000,,Did you intend to seal Crow inside the book?
Dialogue: 0,0:56:25.40,0:56:29.87,Default,,0000,0000,0000,,That's why Sakura-chan, who has a Clow Card, was attracted to him.
Dialogue: 0,0:56:30.32,0:56:33.93,Default,,0000,0000,0000,,Бірақ оны қайтадан кітапқа қалай енгізуге болады?
Dialogue: 0,0:56:34.36,0:56:35.90,Default,,0000,0000,0000,,Біз асықпасақ, бәрі асықпайды
Dialogue: 0,0:56:37.97,0:56:42.24,Default,,0000,0000,0000,,Yes, there must be an entrance and exit in that space.
Dialogue: 0,0:56:43.23,0:56:46.59,Default,,0000,0000,0000,,The presence of the shop from earlier had already disappeared.
Dialogue: 0,0:56:47.39,0:56:49.89,Default,,0000,0000,0000,,Бұл кітап қазірдің өзінде жоғалып кетті.
Dialogue: 0,0:56:53.95,0:56:54.44,Default,,0000,0000,0000,,Кітап…
Dialogue: 0,0:56:58.34,0:57:02.00,Default,,0000,0000,0000,,Мен ол кітаптың мұқабасын білемін.
Dialogue: 0,0:57:06.07,0:57:08.28,Default,,0000,0000,0000,,Әйел айтқан жер
Dialogue: 0,0:57:13.93,0:57:15.08,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:57:22.39,0:57:24.39,Default,,0000,0000,0000,,Сакура, сен бірдеңе түсіндің бе?
Dialogue: 0,0:57:24.60,0:57:26.91,Default,,0000,0000,0000,,Иә, мен кіреберісті білемін.
Dialogue: 0,0:57:27.25,0:57:28.80,Default,,0000,0000,0000,,Мен кеше бардым.
Dialogue: 0,0:57:29.19,0:57:31.96,Default,,0000,0000,0000,,Сонда мен барлығына бара аламын.
Dialogue: 0,0:57:32.31,0:57:32.63,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:57:32.90,0:57:36.42,Default,,0000,0000,0000,,Жарайды, Кардкаптор Сакураның кезегі.
Dialogue: 0,0:57:36.92,0:57:37.28,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:57:38.43,0:57:40.39,Default,,0000,0000,0000,,Енді тез арада киімімізді ауыстырайық.
Dialogue: 0,0:57:56.99,0:57:57.60,Default,,0000,0000,0000,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:57:58.49,0:57:58.77,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:57:59.85,0:58:02.44,Default,,0000,0000,0000,,Мен толқуды анық сезінемін.
Dialogue: 0,0:58:19.12,0:58:19.96,Default,,0000,0000,0000,,Сакура-чан
Dialogue: 0,0:58:21.20,0:58:22.01,Default,,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,0:58:22.68,0:58:23.82,Default,,0000,0000,0000,,Бұл кедергі.
Dialogue: 0,0:58:24.07,0:58:24.81,Default,,0000,0000,0000,,Тосқауыл
Dialogue: 0,0:58:25.46,0:58:28.30,Default,,0000,0000,0000,,Ұңғыманың айналасында күшті бөгет жасалады.
Dialogue: 0,0:58:29.60,0:58:31.28,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:58:31.97,0:58:32.78,Default,,0000,0000,0000,,Кешіріңіз, бірақ
Dialogue: 0,0:58:33.09,0:58:36.00,Default,,0000,0000,0000,,Біз қазіргі күшімізбен ештеңе істей алмаймыз.
Dialogue: 0,0:58:37.72,0:58:38.26,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:58:41.98,0:58:42.94,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:58:43.66,0:58:44.59,Default,,0000,0000,0000,,Біреу келе жатыр
Dialogue: 0,0:58:49.84,0:58:50.46,Default,,0000,0000,0000,,Сендер не істеп жатырсыңдар?!
Dialogue: 0,0:59:04.39,0:59:05.75,Default,,0000,0000,0000,,Лидің анасы
Dialogue: 0,0:59:10.28,0:59:11.61,Default,,0000,0000,0000,,Төмен болыңыз
Dialogue: 0,0:59:14.71,0:59:16.35,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:59:18.82,0:59:21.11,Default,,0000,0000,0000,,Сяоран есінен танып қалды.
Dialogue: 0,0:59:22.80,0:59:24.38,Default,,0000,0000,0000,,Бұл менмін
Dialogue: 0,0:59:25.80,0:59:27.44,Default,,0000,0000,0000,,№.
Dialogue: 0,0:59:29.30,0:59:32.48,Default,,0000,0000,0000,,Ол күш маған жетпеді.
Dialogue: 0,0:59:43.35,0:59:44.79,Default,,0000,0000,0000,,Massive magical power
Dialogue: 0,1:00:01.06,1:00:02.03,Default,,0000,0000,0000,,Барыңыз
Dialogue: 0,1:00:02.44,1:00:05.48,Default,,0000,0000,0000,,Yes, Tomoyo-chan is here.
Dialogue: 0,1:00:05.91,1:00:06.78,Default,,0000,0000,0000,,Сакура-чан
Dialogue: 0,1:00:08.87,1:00:10.42,Default,,0000,0000,0000,,Please be careful.
Dialogue: 0,1:00:10.88,1:00:11.35,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:00:12.93,1:00:15.58,Default,,0000,0000,0000,,This clothes are very easy to move in.
Dialogue: 0,1:00:17.69,1:00:22.29,Default,,0000,0000,0000,,Completely waterproof. Су астында пайдалануға болады.
Dialogue: 0,1:00:37.39,1:00:38.50,Default,,0000,0000,0000,,Сакура-чан
Dialogue: 0,1:01:03.42,1:01:04.17,Default,,0000,0000,0000,,Бұл
Dialogue: 0,1:01:05.22,1:01:07.96,Default,,0000,0000,0000,,Look around the dimensional tunnel.
Dialogue: 0,1:01:09.74,1:01:11.32,Default,,0000,0000,0000,,Әртүрлі кеңістіктерге қосылған
Dialogue: 0,1:01:11.90,1:01:14.34,Default,,0000,0000,0000,,Бұл жерде адасып қалсаңыз, ешқашан шыға алмайсыз.
Dialogue: 0,1:01:14.77,1:01:15.89,Default,,0000,0000,0000,,Не істеуім керек?
Dialogue: 0,1:01:16.38,1:01:17.45,Default,,0000,0000,0000,,Менің ойымша.
Dialogue: 0,1:01:18.75,1:01:21.26,Default,,0000,0000,0000,,If Sakura has strong feelings
Dialogue: 0,1:01:21.36,1:01:22.92,Default,,0000,0000,0000,,You should be able to go out there.
Dialogue: 0,1:01:25.94,1:01:27.26,Default,,0000,0000,0000,,Барлығына
Dialogue: 0,1:01:29.61,1:01:30.34,Default,,0000,0000,0000,,Міне.
Dialogue: 0,1:01:42.72,1:01:43.80,Default,,0000,0000,0000,,Мұнда емес
Dialogue: 0,1:01:44.73,1:01:45.48,Default,,0000,0000,0000,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,1:01:45.80,1:01:47.66,Default,,0000,0000,0000,,Ол басқа жерде пайда болған сияқты.
Dialogue: 0,1:01:48.28,1:01:50.42,Default,,0000,0000,0000,,Жоқ, бұл белгі
Dialogue: 0,1:01:53.81,1:01:54.55,Default,,0000,0000,0000,,Сол жерде
Dialogue: 0,1:02:11.24,1:02:12.52,Default,,0000,0000,0000,,Құстар көшесі
Dialogue: 0,1:02:13.09,1:02:16.37,Default,,0000,0000,0000,,Бір-бірімен араласқан әртүрлі кеңістіктер көп сияқты.
Dialogue: 0,1:02:17.18,1:02:17.76,Default,,0000,0000,0000,,Кеттік
Dialogue: 0,1:02:18.10,1:02:18.48,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:02:37.44,1:02:40.50,Default,,0000,0000,0000,,Қатысу барған сайын үлкейіп, жақындап келеді.
Dialogue: 0,1:02:56.09,1:02:57.67,Default,,0000,0000,0000,,I can feel the presence from here.
Dialogue: 0,1:03:14.21,1:03:14.86,Default,,0000,0000,0000,,Сакура
Dialogue: 0,1:03:16.01,1:03:16.31,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:03:46.41,1:03:49.13,Default,,0000,0000,0000,,Бұл тағы сенсің бе? Неге қайтып келдің?
Dialogue: 0,1:03:49.50,1:03:51.81,Default,,0000,0000,0000,,Please, give us all back.
Dialogue: 0,1:03:53.19,1:03:57.01,Default,,0000,0000,0000,,Оны қайтарғыңыз келсе, Қарға Ридті өзіңізбен бірге алып келіңіз.
Dialogue: 0,1:03:57.92,1:04:00.17,Default,,0000,0000,0000,,Қанша адам әкелсең де жұмыс істемейді.
Dialogue: 0,1:04:00.46,1:04:01.44,Default,,0000,0000,0000,,Қарға кетіп қалды
Dialogue: 0,1:04:02.10,1:04:04.12,Default,,0000,0000,0000,,I've been waiting for a long time.
Dialogue: 0,1:04:07.71,1:04:10.95,Default,,0000,0000,0000,,Waiting for Crow to come
Dialogue: 0,1:04:12.84,1:04:16.26,Default,,0000,0000,0000,,Мен адамдардың айтқанын соңына дейін тыңдағым келеді.
Dialogue: 0,1:04:17.07,1:04:18.03,Default,,0000,0000,0000,,Сол адам
Dialogue: 0,1:04:25.73,1:04:26.38,Default,,0000,0000,0000,,Не?
Dialogue: 0,1:04:51.70,1:04:52.44,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,1:04:57.04,1:05:00.98,Default,,0000,0000,0000,,Бұл соңы. Crow Reed қайда?
Dialogue: 0,1:05:02.21,1:05:05.47,Default,,0000,0000,0000,,Қарға әлдеқашан кетіп қалды.
Dialogue: 0,1:05:06.79,1:05:09.29,Default,,0000,0000,0000,,Олай болса бұл жерде шіріген дұрыс.
Dialogue: 0,1:05:46.72,1:05:47.45,Default,,0000,0000,0000,,Бұл
Dialogue: 0,1:06:02.48,1:06:02.95,Default,,0000,0000,0000,,Сакура
Dialogue: 0,1:06:03.38,1:06:03.75,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:06:10.51,1:06:12.32,Default,,0000,0000,0000,,Қараңғылық күшін жасыратын кілт
Dialogue: 0,1:06:12.75,1:06:15.01,Default,,0000,0000,0000,,Менің алдымда шынайы болмысыңды көрсет
Dialogue: 0,1:06:16.52,1:06:18.98,Default,,0000,0000,0000,,Сакура келісім-шарт бойынша бұйрық береді
Dialogue: 0,1:06:19.49,1:06:21.04,Default,,0000,0000,0000,,Шығару
Dialogue: 0,1:06:33.10,1:06:33.66,Default,,0000,0000,0000,,Ұшу
Dialogue: 0,1:06:35.94,1:06:36.80,Default,,0000,0000,0000,,Сакура-чан
Dialogue: 0,1:06:40.42,1:06:41.06,Default,,0000,0000,0000,,Келеді
Dialogue: 0,1:06:56.07,1:06:56.77,Default,,0000,0000,0000,,Сол адам
Dialogue: 0,1:06:58.03,1:06:58.52,Default,,0000,0000,0000,,Жоғарыда
Dialogue: 0,1:07:10.70,1:07:13.94,Default,,0000,0000,0000,,Бұл қай жерде? Қарға Ридті қайда жібердің?
Dialogue: 0,1:07:17.17,1:07:18.47,Default,,0000,0000,0000,,Қарға мырза қазірдің өзінде
Dialogue: 0,1:07:33.64,1:07:36.93,Default,,0000,0000,0000,,Сакура Қашып кете берсең, ешқайда жете алмайсың.
Dialogue: 0,1:07:37.36,1:07:38.54,Default,,0000,0000,0000,,Бірақ бәрі
Dialogue: 0,1:08:00.63,1:08:03.23,Default,,0000,0000,0000,,Айтыңызшы, Қарға Рид қайда?
Dialogue: 0,1:08:04.78,1:08:07.40,Default,,0000,0000,0000,,Қарға мырза енді жоқ.
Dialogue: 0,1:08:08.32,1:08:09.23,Default,,0000,0000,0000,,Өтірік айту
Dialogue: 0,1:08:09.85,1:08:12.70,Default,,0000,0000,0000,,Рас, ол баяғыда қайтыс болды.
Dialogue: 0,1:08:12.79,1:08:13.52,Default,,0000,0000,0000,,Бұл өтірік
Dialogue: 0,1:08:19.09,1:08:20.63,Default,,0000,0000,0000,,Ол өле алмайды.
Dialogue: 0,1:08:22.69,1:08:23.73,Default,,0000,0000,0000,,Қарға қамыс
Dialogue: 0,1:08:39.28,1:08:40.43,Default,,0000,0000,0000,,Қарға қамыс
Dialogue: 0,1:08:45.53,1:08:47.83,Default,,0000,0000,0000,,Өлуге болмайды
Dialogue: 0,1:09:08.57,1:09:13.19,Default,,0000,0000,0000,,Мен көптен бері күттім.
Dialogue: 0,1:09:26.13,1:09:30.20,Default,,0000,0000,0000,,Мен бар күшіммен Қарғаны шақыра бердім.
Dialogue: 0,1:09:32.10,1:09:36.35,Default,,0000,0000,0000,,Қанша жыл, неше ондаған жылдар өтсе де
Dialogue: 0,1:10:14.67,1:10:16.61,Default,,0000,0000,0000,,Мұндай нәрсені алуға сұраныс жоқ.
Dialogue: 0,1:10:17.37,1:10:20.03,Default,,0000,0000,0000,,Бүгін сенің туған күнің еді, солай ма?
Dialogue: 0,1:10:24.86,1:10:27.11,Default,,0000,0000,0000,,Мен оны саған бердім.
Dialogue: 0,1:10:28.35,1:10:30.04,Default,,0000,0000,0000,,Қажет болмаса, лақтырыңыз.
Dialogue: 0,1:10:57.05,1:10:59.74,Default,,0000,0000,0000,,Өйткені, бұл адам
Dialogue: 0,1:11:15.96,1:11:19.00,Default,,0000,0000,0000,,Су ағындары.
Dialogue: 0,1:11:21.96,1:11:25.47,Default,,0000,0000,0000,,Су ағады
Dialogue: 0,1:11:36.74,1:11:37.47,Default,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,1:11:42.11,1:11:43.53,Default,,0000,0000,0000,,Көрсеткі
Dialogue: 0,1:12:23.25,1:12:24.23,Default,,0000,0000,0000,,Аня Форджер
Dialogue: 0,1:12:39.67,1:12:43.63,Default,,0000,0000,0000,,Сізге Қарға мырза қатты ұнады, солай ма?
Dialogue: 0,1:12:48.66,1:12:49.82,Default,,0000,0000,0000,,Ауырды, солай емес пе?
Dialogue: 0,1:12:54.67,1:12:56.97,Default,,0000,0000,0000,,Сүйген адамың кеткенде
Dialogue: 0,1:13:00.05,1:13:01.21,Default,,0000,0000,0000,,Ауырды, солай емес пе?
Dialogue: 0,1:13:10.64,1:13:13.97,Default,,0000,0000,0000,,Қарға Рид шынымен өлді ме?
Dialogue: 0,1:13:28.14,1:13:31.89,Default,,0000,0000,0000,,Мен көптен бері күттім
Dialogue: 0,1:13:51.34,1:13:54.41,Default,,0000,0000,0000,,Ұзақ уақыт бойы
Dialogue: 0,1:14:08.89,1:14:13.81,Default,,0000,0000,0000,,Екеуміз кездескенде айтқым келген нәрсе болды.
Dialogue: 0,1:14:53.84,1:14:57.00,Default,,0000,0000,0000,,Су ағады.
Dialogue: 0,1:15:00.65,1:15:04.11,Default,,0000,0000,0000,,Бұл дауыс Қарға-сан болатын.
Dialogue: 0,1:15:25.49,1:15:32.32,Default,,0000,0000,0000,,Ли-кун, Лин-чан, үлкен аға, Юкито-сан
Dialogue: 0,1:15:46.66,1:15:48.87,Default,,0000,0000,0000,,Әкеңнен қандай жақсы кәдесый болады деп ойлайсың?
Dialogue: 0,1:15:50.54,1:15:51.90,Default,,0000,0000,0000,,Шай немесе басқа нәрсе?
Dialogue: 0,1:15:52.46,1:15:53.47,Default,,0000,0000,0000,,Шай
Dialogue: 0,1:15:58.35,1:16:00.78,Default,,0000,0000,0000,,Ертең бұл Жапония.
Dialogue: 0,1:16:02.17,1:16:02.74,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:16:04.61,1:16:08.31,Default,,0000,0000,0000,,Сіз көп нәрсе жасадыңыз, әсіресе кеше.
Dialogue: 0,1:16:09.23,1:16:10.61,Default,,0000,0000,0000,,Хе-хе-хе…
Dialogue: 0,1:16:12.93,1:16:18.15,Default,,0000,0000,0000,,Мен де айтқым келеді, шын сезімімді түсінсеңдер деймін.
Dialogue: 0,1:16:21.18,1:16:24.88,Default,,0000,0000,0000,,Оның мистер Қарғаға бірдеңе айтқысы келді.
Dialogue: 0,1:16:25.80,1:16:27.48,Default,,0000,0000,0000,,Мен шынымен айтқым келетін нәрсе
Dialogue: 0,1:16:35.50,1:16:38.76,Default,,0000,0000,0000,,Бір күні айта алар едім
Dialogue: 0,1:16:42.44,1:16:45.42,Default,,0000,0000,0000,,Гонконгқа қайта келе аласыз деп үміттенемін.
Dialogue: 0,1:16:47.48,1:16:47.88,Default,,0000,0000,0000,,Иә
