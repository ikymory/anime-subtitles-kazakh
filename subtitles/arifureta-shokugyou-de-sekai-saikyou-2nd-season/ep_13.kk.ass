Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.41,0:00:06.42,Default,,0,0,0,,♪～
Dialogue: 0,0:01:25.91,0:01:30.92,Default,,0,0,0,,～♪
Dialogue: 0,0:01:45.81,0:01:46.64,Default,,0,0,0,,Ах
Dialogue: 0,0:01:48.94,0:01:49.98,Default,,0,0,0,,Хажиме-кун
Dialogue: 0,0:01:57.45,0:01:59.86,Default,,0,0,0,,Каори шынымен қамқор.
Dialogue: 0,0:01:59.95,0:02:02.53,Default,,0,0,0,,Аурудан немесе жарақаттан зардап шеккендер
Dialogue: 0,0:02:02.62,0:02:04.20,Default,,0,0,0,,Мен сені жалғыз қалдыра алмаймын.
Dialogue: 0,0:02:04.29,0:02:06.41,Default,,0,0,0,,Каори-сан күткендей.
Dialogue: 0,0:02:06.50,0:02:08.62,Default,,0,0,0,,Каори-оне-чан мейірімді.
Dialogue: 0,0:02:08.71,0:02:09.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:12.38,0:02:14.38,Default,,0,0,0,,Емші болғаныңыз табиғи нәрсе.
Dialogue: 0,0:02:14.46,0:02:17.38,Default,,0,0,0,,Иә? Мен де Каори-сан сияқтымын.
Dialogue: 0,0:02:17.47,0:02:20.01,Default,,0,0,0,,Мен сиқырды қолдансам деп едім
Dialogue: 0,0:02:20.09,0:02:21.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:21.30,0:02:24.60,Default,,0,0,0,,Хе... не?
Dialogue: 0,0:02:29.10,0:02:30.85,Default,,0,0,0,,Сиқырды қолдану бойынша кеңестер?
Dialogue: 0,0:02:30.94,0:02:31.98,Default,,0,0,0,,Иә
Dialogue: 0,0:02:32.06,0:02:35.02,Default,,0,0,0,,Сиқырлы данышпан Юэ-саннан сұрасаңыз, оның қандай кеңестері бар?
Dialogue: 0,0:02:35.11,0:02:39.78,Default,,0,0,0,,Бір-екі сиқырлы заклинание, тіпті нөлдік қабілеті бар мен де іс жүзінде қолдана алады.
Dialogue: 0,0:02:39.86,0:02:42.16,Default,,0,0,0,,Мен оны есте сақтай алатын шығарсың деп ойладым.
Dialogue: 0,0:02:43.45,0:02:46.16,Default,,0,0,0,,Иә, түсіндім, айтамын.
Dialogue: 0,0:02:46.24,0:02:48.50,Default,,0,0,0,,Козырлар неғұрлым көп болса, соғұрлым жақсы
Dialogue: 0,0:02:48.58,0:02:52.67,Default,,0,0,0,,Уау, шынымен бе? Сәлем, бұл Юэ-сан.
Dialogue: 0,0:02:52.75,0:02:54.42,Default,,0,0,0,,Рахмет
Dialogue: 0,0:02:54.50,0:02:57.80,Default,,0,0,0,,Ақырында, мен де сиқырлы дебют жасаймын!
Dialogue: 0,0:02:57.88,0:03:02.76,Default,,0,0,0,,Юэдің сиқырлы сыныбы? Бұл мені де қызықтыратын нәрсе.
Dialogue: 0,0:03:02.84,0:03:05.14,Default,,0,0,0,,Юэ: Мен де сенен бірдеңе сұрасам болады ма?
Dialogue: 0,0:03:05.22,0:03:06.31,Default,,0,0,0,,Мюу Монано
Dialogue: 0,0:03:06.39,0:03:08.89,Default,,0,0,0,,Иә, маңызды емес.
Dialogue: 0,0:03:08.98,0:03:11.73,Default,,0,0,0,,Айдаһарға бір нәрсені үйрететін уақыт келеді.
Dialogue: 0,0:03:11.81,0:03:13.44,Default,,0,0,0,,Мен өте эмоционалды сезінемін.
Dialogue: 0,0:03:13.52,0:03:16.19,Default,,0,0,0,,Сіздің күйеуіңіз қатыспайды ма?
Dialogue: 0,0:03:16.27,0:03:17.82,Default,,0,0,0,,Мен олай істемеймін.
Dialogue: 0,0:03:17.90,0:03:19.19,Default,,0,0,0,,(Хироко) Һм? О…
Dialogue: 0,0:03:19.28,0:03:22.45,Default,,0,0,0,,Хаджиме-сан, сен маған үйретерсің.
Dialogue: 0,0:03:22.53,0:03:25.49,Default,,0,0,0,,Мен сиқырды қолдана алмайтын шығармын деп ойладым.
Dialogue: 0,0:03:25.58,0:03:27.33,Default,,0,0,0,,Сіз қашып бара жатырсыз ба?
Dialogue: 0,0:03:27.41,0:03:29.83,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:03:29.91,0:03:33.37,Default,,0,0,0,,Олай болса, Хаджиме-саннан бізге де сабақ беруін өтінейік.
Dialogue: 0,0:03:33.46,0:03:34.79,Default,,0,0,0,,Папа Монано
Dialogue: 0,0:03:34.88,0:03:36.29,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:03:36.38,0:03:39.63,Default,,0,0,0,,Негізі, сендерге де тоқтаған дұрыс болар еді деп ойлаймын.
Dialogue: 0,0:03:39.71,0:03:40.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:41.01,0:03:43.09,Default,,0,0,0,,Жаман сөз айтуды доғар.
Dialogue: 0,0:03:43.18,0:03:47.35,Default,,0,0,0,,Қорқынышты Хаджиме, маған пайдасы жоқ па?
Dialogue: 0,0:03:47.43,0:03:50.35,Default,,0,0,0,,Әр нәрсенің жақсы және жаман жақтары бар.
Dialogue: 0,0:03:50.43,0:03:52.35,Default,,0,0,0,,Эх~ Хажиме-сан
Dialogue: 0,0:03:52.44,0:03:56.61,Default,,0,0,0,,Сиқырлы мұғалім болуға Юэ-саннан артық ешкім жоқ.
Dialogue: 0,0:03:57.48,0:03:59.32,Default,,0,0,0,,Мен ұзақ өмір сүрдім, бірақ
Dialogue: 0,0:03:59.40,0:04:03.15,Default,,0,0,0,,Мен Юэ сияқты шебер ешкімді көрген емеспін.
Dialogue: 0,0:04:03.82,0:04:06.45,Default,,0,0,0,,Юэден жақсы нұсқаушы жоқ деп ойлаймын.
Dialogue: 0,0:04:06.53,0:04:07.37,Default,,0,0,0,,Фуфу
Dialogue: 0,0:04:07.45,0:04:08.70,Default,,0,0,0,,Папа~
Dialogue: 0,0:04:08.79,0:04:10.12,Default,,0,0,0,,Хажиме~
Dialogue: 0,0:04:12.46,0:04:15.33,Default,,0,0,0,,Уф... Әйтеуір тоқтаттым.
Dialogue: 0,0:04:15.42,0:04:16.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:16.79,0:04:18.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:18.80,0:04:21.21,Default,,0,0,0,,(Инелік аспаз)
Dialogue: 0,0:04:21.88,0:04:26.18,Default,,0,0,0,,Басқаша айтқанда, егер сіз мұнда сиқырды қолдансаңыз
Dialogue: 0,0:04:27.22,0:04:28.18,Default,,0,0,0,,♪ Ранран
Dialogue: 0,0:04:28.26,0:04:30.01,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:30.10,0:04:31.77,Default,,0,0,0,,Содан кейін оны Google арқылы іздеңіз.
Dialogue: 0,0:04:31.85,0:04:34.73,Default,,0,0,0,,Сәлем! жай ғана жасаңыз
Dialogue: 0,0:04:34.81,0:04:37.73,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:04:37.81,0:04:39.98,Default,,0,0,0,,Дұрыс па? Оңай, солай ма?
Dialogue: 0,0:04:40.07,0:04:42.03,Default,,0,0,0,,Түсіндім, түсінбеймін!
Dialogue: 0,0:04:42.11,0:04:44.36,Default,,0,0,0,,Не? Гюн деген не?
Dialogue: 0,0:04:44.45,0:04:46.61,Default,,0,0,0,,Жүгіру сезімі қандай?
Dialogue: 0,0:04:46.70,0:04:47.95,Default,,0,0,0,,Бұл сиқыр
Dialogue: 0,0:04:48.03,0:04:51.08,Default,,0,0,0,,Гю күйінен
Dialogue: 0,0:04:51.83,0:04:55.08,Default,,0,0,0,,Өйткені ол дірілдейді
Dialogue: 0,0:04:55.16,0:04:56.92,Default,,0,0,0,,Сонда міндетті түрде
Dialogue: 0,0:04:57.00,0:05:00.25,Default,,0,0,0,,Кепенге айналады дейді.
Dialogue: 0,0:05:00.34,0:05:02.71,Default,,0,0,0,,Сондықтан оның мағынасы жоқ!
Dialogue: 0,0:05:02.80,0:05:06.01,Default,,0,0,0,,Гюнде қаншама мағына жатыр!
Dialogue: 0,0:05:06.09,0:05:07.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:07.72,0:05:12.06,Default,,0,0,0,,Өтінемін, бізге түсінікті сөздермен айтып беріңізші.
Dialogue: 0,0:05:12.14,0:05:12.97,Default,,0,0,0,,Менің!
Dialogue: 0,0:05:13.06,0:05:14.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:14.81,0:05:16.14,Default,,0,0,0,,Юе
Dialogue: 0,0:05:16.23,0:05:20.19,Default,,0,0,0,,Біз біршама теориялық түсініктеме алғымыз келеді.
Dialogue: 0,0:05:20.27,0:05:22.15,Default,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,0:05:22.23,0:05:24.07,Default,,0,0,0,,Гённың жағдайы қандай? Яғни...
Dialogue: 0,0:05:24.15,0:05:28.61,Default,,0,0,0,,Жазық күйден сиқырлы үдеу жылдамдығы 2,25 есе.
Dialogue: 0,0:05:28.70,0:05:30.99,Default,,0,0,0,,Бұл мән атрибут пен текке байланысты.
Dialogue: 0,0:05:31.08,0:05:35.33,Default,,0,0,0,,Ол 2,25 еседен 2,277 есеге дейін өзгереді.
Dialogue: 0,0:05:35.41,0:05:39.33,Default,,0,0,0,,3,95 жылдамдықпен қарсылық беру арқылы...
Dialogue: 0,0:05:39.42,0:05:43.96,Default,,0,0,0,,Фокустау жылдамдығы және шығарылғаннан кейінгі ауытқу жылдамдығы автоматты түрде соңғы мәндерге жетеді...
Dialogue: 0,0:05:44.05,0:05:46.55,Default,,0,0,0,,Адамдар түсінетін тілде сұраңыз.
Dialogue: 0,0:05:46.63,0:05:47.68,Default,,0,0,0,,Жарайды, мен оны қазір суға толтырамын.
Dialogue: 0,0:05:48.30,0:05:52.31,Default,,0,0,0,,Сондықтан сезім арқылы түсіну үшін қарапайым түсініктеме бердім.
Dialogue: 0,0:05:53.51,0:05:55.43,Default,,0,0,0,,Неге білмейсің?
Dialogue: 0,0:05:55.52,0:05:56.56,Default,,0,0,0,,Myuu
Dialogue: 0,0:05:56.64,0:05:57.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:59.40,0:06:00.56,Default,,0,0,0,,Гуха…
Dialogue: 0,0:06:01.73,0:06:04.78,Default,,0,0,0,,Мен... Қызық, мен ақымақпын ба?
Dialogue: 0,0:06:04.86,0:06:06.90,Default,,0,0,0,,Шындығында, сіз тіпті негізгі нәрсені түсінбейсіз.
Dialogue: 0,0:06:06.99,0:06:11.07,Default,,0,0,0,,Сиқырға шебер деп қалжыңдады. Мүмкін ол ұятсыз шығар?
Dialogue: 0,0:06:11.16,0:06:14.49,Default,,0,0,0,,Тио-оне-чан, жақсысың ба?
Dialogue: 0,0:06:14.58,0:06:15.41,Default,,0,0,0,,Жылдам… бірақ әлі де менің қашықтығымда.
Dialogue: 0,0:06:15.50,0:06:19.17,Default,,0,0,0,,Тио-санның мақтанышы оның бүкіл денесін зақымдап қойған.
Dialogue: 0,0:06:19.25,0:06:21.00,Default,,0,0,0,,Тек тәжірибеде
Dialogue: 0,0:06:21.08,0:06:24.13,Default,,0,0,0,,Жарайды, мен айтқандай істей аласың.
Dialogue: 0,0:06:24.21,0:06:26.13,Default,,0,0,0,,Тұр, тұр.
Dialogue: 0,0:06:26.21,0:06:27.63,Default,,0,0,0,,Тез тұр!
Dialogue: 0,0:06:28.30,0:06:30.89,Default,,0,0,0,,Менен кейін қайталаңыз
Dialogue: 0,0:06:30.97,0:06:33.55,Default,,0,0,0,,Гун Пал Пал Пал
Dialogue: 0,0:06:33.64,0:06:34.47,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:34.56,0:06:37.73,Default,,0,0,0,,Алдыңғы түсініктемеден сәл өзгеше
Dialogue: 0,0:06:37.81,0:06:41.06,Default,,0,0,0,,Жүр, тез, тез!
Dialogue: 0,0:06:41.15,0:06:42.36,Default,,0,0,0,,Жүр, кел, кел.
Dialogue: 0,0:06:42.44,0:06:43.86,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,0:06:43.94,0:06:45.57,Default,,0,0,0,,Иә Гён!
Dialogue: 0,0:06:45.65,0:06:46.69,Default,,0,0,0,,Гюн?
Dialogue: 0,0:06:46.78,0:06:47.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:48.95,0:06:51.49,Default,,0,0,0,,Бұл Гю Гюн.
Dialogue: 0,0:06:51.57,0:06:53.24,Default,,0,0,0,,Гю Гюнджа
Dialogue: 0,0:06:53.32,0:06:54.24,Default,,0,0,0,,Уау
Dialogue: 0,0:06:54.33,0:06:55.24,Default,,0,0,0,,(Яоёрозу) Бір сәт! (Хагакуре) Сен оңай берілмейсің ғой!
Dialogue: 0,0:06:55.33,0:06:56.16,Default,,0,0,0,,Содан кейін Runrun
Dialogue: 0,0:06:56.16,0:06:56.95,Default,,0,0,0,,Содан кейін Runrun
Dialogue: 0,0:06:56.16,0:06:56.95,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:06:56.95,0:06:57.04,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:06:57.04,0:06:57.91,Default,,0,0,0,,Лу… Жүгіру
Dialogue: 0,0:06:57.04,0:06:57.91,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:06:57.91,0:06:59.16,Default,,0,0,0,,Лу… Жүгіру
Dialogue: 0,0:06:59.25,0:07:00.21,Default,,0,0,0,,Жүгіру
Dialogue: 0,0:07:00.29,0:07:02.83,Default,,0,0,0,,Бар жүрегіммен, иә!
Dialogue: 0,0:07:02.92,0:07:04.54,Default,,0,0,0,,Сонымен… солай…
Dialogue: 0,0:07:04.63,0:07:05.84,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:05.92,0:07:09.17,Default,,0,0,0,,Сондықтан мен саған тоқта деп айттым.
Dialogue: 0,0:07:09.26,0:07:12.34,Default,,0,0,0,,Тәжірибесі бар адамдардың кеңестерін мұқият тыңдау керек.
Dialogue: 0,0:07:12.43,0:07:14.64,Default,,0,0,0,,Куу у... ой
Dialogue: 0,0:07:14.72,0:07:16.60,Default,,0,0,0,,Sia tio тұрып
Dialogue: 0,0:07:16.68,0:07:17.81,Default,,0,0,0,,Жүріңдер, тұрыңдар.
Dialogue: 0,0:07:17.89,0:07:19.85,Default,,0,0,0,,Емдеу аяқталды
Dialogue: 0,0:07:19.93,0:07:21.81,Default,,0,0,0,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,0:07:21.89,0:07:23.77,Default,,0,0,0,,Каориге қатысы жоқ
Dialogue: 0,0:07:24.52,0:07:28.65,Default,,0,0,0,,Ю... Юэ-сан маған сиқырлы амалдарды үйретті...
Dialogue: 0,0:07:28.73,0:07:32.03,Default,,0,0,0,,Бұл не? Жақсы, мен де үйренгім келеді.
Dialogue: 0,0:07:32.11,0:07:34.87,Default,,0,0,0,,Каори-сан, мен жаман ештеңе айтпаймын.
Dialogue: 0,0:07:34.95,0:07:36.78,Default,,0,0,0,,Тоқтаған дұрыс
Dialogue: 0,0:07:36.87,0:07:38.49,Default,,0,0,0,,А... неге?
Dialogue: 0,0:07:38.58,0:07:40.75,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:40.83,0:07:44.79,Default,,0,0,0,,Өйткені Юэ-санда ұстаздық талант жоқ!
Dialogue: 0,0:07:44.88,0:07:45.79,Default,,0,0,0,,Не!
Dialogue: 0,0:07:45.88,0:07:48.55,Default,,0,0,0,,Оның үстіне сен адамдардың жүрегін жаралайтын данышпансың.
Dialogue: 0,0:07:48.63,0:07:50.05,Default,,0,0,0,,Myuu
Dialogue: 0,0:07:50.13,0:07:52.05,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:07:52.13,0:07:55.14,Default,,0,0,0,,Каори үйренгіңіз келсе, Tio пайдаланыңыз.
Dialogue: 0,0:07:55.22,0:07:57.97,Default,,0,0,0,,Ол сабақ беруде жақсы.
Dialogue: 0,0:08:00.52,0:08:02.23,Default,,0,0,0,,Идиот...
Dialogue: 0,0:08:02.89,0:08:05.69,Default,,0,0,0,,Фуфу Юэ Сенсэй
Dialogue: 0,0:08:05.77,0:08:07.15,Default,,0,0,0,,Бля Каори
Dialogue: 0,0:08:07.23,0:08:09.73,Default,,0,0,0,,Бұл мағынаны қайталаңыз.
Dialogue: 0,0:08:09.82,0:08:12.45,Default,,0,0,0,,Сондықтан мұғалімнің дарындылығы нөл.
Dialogue: 0,0:08:12.53,0:08:16.53,Default,,0,0,0,,Сені адамдардың жүрегін жаралай алатын данышпансың дейді, солай ма?
Dialogue: 0,0:08:16.62,0:08:19.04,Default,,0,0,0,,Маған үйретіп көріңіз.
Dialogue: 0,0:08:19.12,0:08:22.87,Default,,0,0,0,,А, бұл туралы айтшы, қорғаныс сиқырының қасиетті жойылуы.
Dialogue: 0,0:08:22.96,0:08:24.08,Default,,0,0,0,,Дұрыс па? эй?
Dialogue: 0,0:08:24.17,0:08:28.46,Default,,0,0,0,,Ку... Ешбір мағынасы жоқ деп күлсем де.
Dialogue: 0,0:08:30.05,0:08:32.26,Default,,0,0,0,,Алдымен мазақ етіңіз
Dialogue: 0,0:08:32.34,0:08:34.30,Default,,0,0,0,,Содан кейін қосылдық
Dialogue: 0,0:08:34.38,0:08:36.51,Default,,0,0,0,,Қалғандары Шурун болады.
Dialogue: 0,0:08:36.59,0:08:38.60,Default,,0,0,0,,Осыны айт және орында.
Dialogue: 0,0:08:38.68,0:08:40.06,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:08:40.14,0:08:41.60,Default,,0,0,0,,Неге ол бізді өзінен алыстатқысы келеді?
Dialogue: 0,0:08:41.68,0:08:43.35,Default,,0,0,0,,Могу
Dialogue: 0,0:08:43.89,0:08:45.48,Default,,0,0,0,,Конеконе
Dialogue: 0,0:08:45.56,0:08:48.61,Default,,0,0,0,,Әй, Шурун болды.
Dialogue: 0,0:08:48.69,0:08:50.23,Default,,0,0,0,,Тек мұны істе!
Dialogue: 0,0:08:53.90,0:08:55.53,Default,,0,0,0,,Не!
Dialogue: 0,0:08:55.61,0:08:57.53,Default,,0,0,0,,Ммм...
Dialogue: 0,0:08:57.62,0:09:00.28,Default,,0,0,0,,Каори-Нечан керемет
Dialogue: 0,0:09:00.37,0:09:04.08,Default,,0,0,0,,Бұл не? Иә, сіздің сабақ беру стиліңіз жаман емес.
Dialogue: 0,0:09:04.16,0:09:06.00,Default,,0,0,0,,Мен тез үйренетін нәрселер
Dialogue: 0,0:09:06.08,0:09:09.21,Default,,0,0,0,,Хо... шынымен бе? Сіз оны дұрыс түсіндіңіз бе?
Dialogue: 0,0:09:09.29,0:09:10.25,Default,,0,0,0,,Әрине
Dialogue: 0,0:09:10.34,0:09:12.92,Default,,0,0,0,,Могу Конеконе
Dialogue: 0,0:09:13.01,0:09:15.51,Default,,0,0,0,,Шурунда Иә!
Dialogue: 0,0:09:17.59,0:09:19.01,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:09:19.10,0:09:20.01,Default,,0,0,0,,Дәл!
Dialogue: 0,0:09:20.10,0:09:23.35,Default,,0,0,0,,Жүріңдер, тұрыңдар
Dialogue: 0,0:09:23.43,0:09:24.85,Default,,0,0,0,,Тұр!
Dialogue: 0,0:09:24.93,0:09:26.60,Default,,0,0,0,,Гррр…
Dialogue: 0,0:09:27.40,0:09:29.23,Default,,0,0,0,,Менен кейін қайталау
Dialogue: 0,0:09:29.31,0:09:32.90,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:09:32.98,0:09:35.70,Default,,0,0,0,,Могу Могуды жылдам қайталаңыз
Dialogue: 0,0:09:35.78,0:09:36.78,Default,,0,0,0,,Жоқ, бұл тыңшылық емес
Dialogue: 0,0:09:36.86,0:09:38.32,Default,,0,0,0,,Могу!
Dialogue: 0,0:09:38.41,0:09:40.41,Default,,0,0,0,,Мо… Могю…
Dialogue: 0,0:09:40.49,0:09:41.87,Default,,0,0,0,,Могу!
Dialogue: 0,0:09:45.12,0:09:47.37,Default,,0,0,0,,Могу Конеконе!
Dialogue: 0,0:09:47.46,0:09:49.88,Default,,0,0,0,,Шурунда Иә!
Dialogue: 0,0:09:49.96,0:09:51.25,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:51.34,0:09:52.42,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:52.50,0:09:53.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:54.42,0:09:58.76,Default,,0,0,0,,Меу ме? Әзірше мұны тоқтатуым керек пе?
Dialogue: 0,0:09:58.84,0:10:00.76,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:10:00.85,0:10:02.10,Default,,0,0,0,,Ha
Dialogue: 0,0:10:02.18,0:10:06.18,Default,,0,0,0,,Әйтеуір... бұл өте жанды қала.
Dialogue: 0,0:10:06.27,0:10:10.44,Default,,0,0,0,,Мен бұрын көрмеген киімдер өте көп.
Dialogue: 0,0:10:10.52,0:10:15.94,Default,,0,0,0,,Боялған өндіріс аймағынан күткендей, тұрғындардың киімдерінің түстері де айқын.
Dialogue: 0,0:10:16.03,0:10:18.78,Default,,0,0,0,,Иә, шеберлігі де жақсы сияқты.
Dialogue: 0,0:10:18.86,0:10:20.91,Default,,0,0,0,,Бұл өте керемет.
Dialogue: 0,0:10:20.99,0:10:22.83,Default,,0,0,0,,Айналма жолмен жүргеніңізге қуаныштымын.
Dialogue: 0,0:10:22.91,0:10:24.54,Default,,0,0,0,,Уау, эй Миу
Dialogue: 0,0:10:24.62,0:10:25.45,Default,,0,0,0,,Мю?
Dialogue: 0,0:10:25.54,0:10:30.67,Default,,0,0,0,,Ойланып қарасақ, Кайцзин тайпасы әдетте қандай киім киеді?
Dialogue: 0,0:10:30.75,0:10:32.38,Default,,0,0,0,,Көбінесе киімімді шешіп аламын.
Dialogue: 0,0:10:32.46,0:10:34.80,Default,,0,0,0,,Сіз нудистсіз бе?
Dialogue: 0,0:10:34.88,0:10:36.42,Default,,0,0,0,,Хохо
Dialogue: 0,0:10:37.21,0:10:39.38,Default,,0,0,0,,Бұл өте батыл.
Dialogue: 0,0:10:39.47,0:10:42.55,Default,,0,0,0,,Мен Элисенде тұра алмайтын шығармын.
Dialogue: 0,0:10:42.64,0:10:44.22,Default,,0,0,0,,Олай болса, Хаджиме.
Dialogue: 0,0:10:44.31,0:10:47.52,Default,,0,0,0,,Мен, Мю және үшеуміз Эрисенде тұрамыз ба?
Dialogue: 0,0:10:47.60,0:10:49.44,Default,,0,0,0,,Жоқ... бұл не?
Dialogue: 0,0:10:49.52,0:10:51.69,Default,,0,0,0,,Онда мен де сенімен бірге тұрамын.
Dialogue: 0,0:10:51.77,0:10:52.94,Default,,0,0,0,,Мен де
Dialogue: 0,0:10:53.02,0:10:54.15,Default,,0,0,0,,Сабан Можа
Dialogue: 0,0:10:54.23,0:10:56.98,Default,,0,0,0,,Балалар, сендер...
Dialogue: 0,0:10:57.07,0:10:59.65,Default,,0,0,0,,Уау Ахаха
Dialogue: 0,0:11:01.86,0:11:05.12,Default,,0,0,0,,Миу Сіздің қалаған киіміңіз бар ма?
Dialogue: 0,0:11:05.20,0:11:06.04,Default,,0,0,0,,Өткенге… электрондық хат па?
Dialogue: 0,0:11:06.12,0:11:10.00,Default,,0,0,0,,Маған ұнайтын нәрсе болса, мен оны сатып аламын.
Dialogue: 0,0:11:10.08,0:11:12.75,Default,,0,0,0,,Шынымен бе? Уау
Dialogue: 0,0:11:12.83,0:11:14.42,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:11:14.50,0:11:16.50,Default,,0,0,0,,Сіз өзіңізге ұнайтын нәрсені таңдай аласыз.
Dialogue: 0,0:11:16.59,0:11:19.51,Default,,0,0,0,,Мм, мм... (Каори және т.б.) Ммм...
Dialogue: 0,0:11:19.59,0:11:20.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:20.59,0:11:23.51,Default,,0,0,0,,Ой... балалар, өздерің сатып аласыңдар.
Dialogue: 0,0:11:23.59,0:11:26.64,Default,,0,0,0,,Хаджиме Мәселе мынада...
Dialogue: 0,0:11:26.72,0:11:29.27,Default,,0,0,0,,А... Не болды, Мю?
Dialogue: 0,0:11:29.89,0:11:33.60,Default,,0,0,0,,Юэ-онэ-чанның киімдері әдемі, мен киіп көргім келеді.
Dialogue: 0,0:11:34.36,0:11:35.44,Default,,0,0,0,,Менікі ме?
Dialogue: 0,0:11:35.52,0:11:36.69,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:36.77,0:11:40.99,Default,,0,0,0,,Бірақ Миу, одан да әдемі киімдер көп.
Dialogue: 0,0:11:41.07,0:11:45.28,Default,,0,0,0,,Көрдіңіз бе, Юэ-оне-чан ең керемет әпке.
Dialogue: 0,0:11:45.37,0:11:46.78,Default,,0,0,0,,Өтірікші!
Dialogue: 0,0:11:46.87,0:11:51.37,Default,,0,0,0,,Мен сиқырды қолданғанда, әкемнің қасында төбелескенде, т.б.
Dialogue: 0,0:11:51.46,0:11:53.17,Default,,0,0,0,,Керемет
Dialogue: 0,0:11:53.25,0:11:54.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:55.79,0:11:59.96,Default,,0,0,0,,Мюу әкемнің қызы, бірақ ол әлсіз.
Dialogue: 0,0:12:00.05,0:12:02.76,Default,,0,0,0,,Сондықтан Юэ-оне-чан сияқты әрекет ет.
Dialogue: 0,0:12:02.84,0:12:05.76,Default,,0,0,0,,Кішкене күштірек болсам ғой.
Dialogue: 0,0:12:06.60,0:12:08.01,Default,,0,0,0,,Myuu...
Dialogue: 0,0:12:08.72,0:12:12.10,Default,,0,0,0,,Меу... Мью тым періште, азапты.
Dialogue: 0,0:12:12.18,0:12:13.64,Default,,0,0,0,,Муни...
Dialogue: 0,0:12:13.73,0:12:17.52,Default,,0,0,0,,Миу-чан, мен де салқын емеспін бе?
Dialogue: 0,0:12:17.61,0:12:22.90,Default,,0,0,0,,Кез келген жауды бір соққымен өлтіріңіз. Бұл жай ғана жаппай ет өндіру.
Dialogue: 0,0:12:22.99,0:12:27.49,Default,,0,0,0,,Мю-чан мен Каори-оне-чан оларды басу қабілетіне сенімді.
Dialogue: 0,0:12:27.58,0:12:30.49,Default,,0,0,0,,Мен сізге тұтқыр жарық жүзінің ретсіз түсірілімін көрсетемін.
Dialogue: 0,0:12:30.58,0:12:31.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:31.50,0:12:35.62,Default,,0,0,0,,Мен саған тынысымды және қандай салқын екенімді көрсетемін.
Dialogue: 0,0:12:35.71,0:12:38.13,Default,,0,0,0,,Көздерің ұшқын болсын
Dialogue: 0,0:12:38.21,0:12:39.04,Default,,0,0,0,,Жарайды, мен оны қазір суға толтырамын.
Dialogue: 0,0:12:39.13,0:12:42.05,Default,,0,0,0,,(Шиаттардың және басқалардың дауласып жатқан дауыстары)
Dialogue: 0,0:12:42.13,0:12:43.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:43.34,0:12:45.43,Default,,0,0,0,,Әпкелер, иә?
Dialogue: 0,0:12:45.51,0:12:49.64,Default,,0,0,0,,Шиа-оне-чан салқын болудан бөлек.
Dialogue: 0,0:12:50.60,0:12:51.43,Default,,0,0,0,,Әртүрлі?
Dialogue: 0,0:12:51.52,0:12:52.81,Default,,0,0,0,,Білмеймін!
Dialogue: 0,0:12:52.89,0:12:55.77,Default,,0,0,0,,Каори-оне-чан...
Dialogue: 0,0:12:55.85,0:12:57.56,Default,,0,0,0,,Бұл сәл әлсіз
Dialogue: 0,0:12:57.65,0:12:58.94,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:59.02,0:13:01.23,Default,,0,0,0,,Тио-неечан...
Dialogue: 0,0:13:01.73,0:13:02.82,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:13:02.90,0:13:05.57,Default,,0,0,0,,Жоқ... не дейсің!
Dialogue: 0,0:13:06.99,0:13:07.82,Default,,0,0,0,,Фуфу
Dialogue: 0,0:13:07.91,0:13:11.74,Default,,0,0,0,,Эй... Жыныстық қатынасқа түскеніме біраз болды. Иә.
Dialogue: 0,0:13:11.83,0:13:15.87,Default,,0,0,0,,Юэ, менің ойымша, сізде ондай көзқарас жоқ. кана?
Dialogue: 0,0:13:15.96,0:13:19.71,Default,,0,0,0,,Хехе... Таразыны тигізу деген сөз болса керек.
Dialogue: 0,0:13:19.79,0:13:22.46,Default,,0,0,0,,Айтсаңыз жақсы болар еді деп ойлаймын.
Dialogue: 0,0:13:23.13,0:13:24.22,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:13:24.30,0:13:27.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:27.89,0:13:30.80,Default,,0,0,0,,А... білесің бе, Шиа-Нечанның да.
Dialogue: 0,0:13:30.89,0:13:33.56,Default,,0,0,0,,Каори-Нечан мен Тио-Нечан да
Dialogue: 0,0:13:33.64,0:13:36.06,Default,,0,0,0,,Менің ойымша, киім өте әдемі.
Dialogue: 0,0:13:36.14,0:13:37.14,Default,,0,0,0,,О
Dialogue: 0,0:13:37.23,0:13:39.77,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:13:39.86,0:13:40.86,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:13:40.94,0:13:43.78,Default,,0,0,0,,үшінмыз киім айырбастау кешін өткізейік.
Dialogue: 0,0:13:43.86,0:13:45.07,Default,,0,0,0,,алмасу жиналысы?
Dialogue: 0,0:13:45.15,0:13:46.36,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:46.45,0:13:50.07,Default,,0,0,0,,Егер бұл алмасу кездесуі болса, барлық киімдерді киюге болады.
Dialogue: 0,0:13:50.16,0:13:51.58,Default,,0,0,0,,Бұл қызық болатыны сөзсіз
Dialogue: 0,0:13:51.66,0:13:53.58,Default,,0,0,0,,Аха…
Dialogue: 0,0:13:53.66,0:13:58.00,Default,,0,0,0,,Мюдің ұсынысын қабылдасақ қайтеді?
Dialogue: 0,0:13:58.08,0:14:01.09,Default,,0,0,0,,Жеребе тартып, қандай киім киетінін кездейсоқ шешіңіз.
Dialogue: 0,0:14:01.17,0:14:02.46,Default,,0,0,0,,Мастер Хаджиме-сан
Dialogue: 0,0:14:01.17,0:14:02.46,Default,,0,0,0,,Хажиме (Каори) Хажиме-кун
Dialogue: 0,0:14:02.55,0:14:06.17,Default,,0,0,0,,Бұл қалада сіз материалдар мен бөлшектерге ерекше назар аударуыңыз керек.
Dialogue: 0,0:14:06.26,0:14:08.59,Default,,0,0,0,,Сіз әртүрлі өлшемдерді тез жасай аласыз, солай ма?
Dialogue: 0,0:14:10.26,0:14:12.35,Default,,0,0,0,,Міне!
Dialogue: 0,0:14:12.43,0:14:13.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:17.52,0:14:20.19,Default,,0,0,0,,Әке, қарашы, қарашы.
Dialogue: 0,0:14:20.27,0:14:21.23,Default,,0,0,0,,Иә
Dialogue: 0,0:14:26.99,0:14:30.99,Default,,0,0,0,,Сізге сәйкес емес пе? Миу, сен сәл жетілген сияқтысың.
Dialogue: 0,0:14:31.07,0:14:32.24,Default,,0,0,0,,Эххе
Dialogue: 0,0:14:32.32,0:14:35.24,Default,,0,0,0,,Myuu Сіз оны кенеттен аша алмайсыз, солай ма?
Dialogue: 0,0:14:47.34,0:14:48.76,Default,,0,0,0,,О...
Dialogue: 0,0:14:48.84,0:14:51.14,Default,,0,0,0,,Юэ-онэ-чан әдемі.
Dialogue: 0,0:14:51.22,0:14:52.18,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:52.26,0:14:54.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:56.06,0:14:59.48,Default,,0,0,0,,Бұл... мұндай нәрсені бірінші рет киіп отырмын.
Dialogue: 0,0:14:59.56,0:15:01.90,Default,,0,0,0,,Бұл таңқаларлық ұят.
Dialogue: 0,0:15:05.02,0:15:08.11,Default,,0,0,0,,Каори дірілдеп тұр.
Dialogue: 0,0:15:08.19,0:15:10.65,Default,,0,0,0,,Мата көп, қозғалу қиын.
Dialogue: 0,0:15:10.74,0:15:13.74,Default,,0,0,0,,Сен маған жақсы көрінесің, Тио.
Dialogue: 0,0:15:13.82,0:15:14.66,Default,,0,0,0,,Иә
Dialogue: 0,0:15:14.74,0:15:16.04,Default,,0,0,0,,Nuo?
Dialogue: 0,0:15:16.12,0:15:18.33,Default,,0,0,0,,Шиа саған да жақсы көрінеді.
Dialogue: 0,0:15:18.41,0:15:20.29,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:20.37,0:15:23.79,Default,,0,0,0,,Тио-оне-чан да, Шиа-оне-чан да сүйкімді.
Dialogue: 0,0:15:23.88,0:15:26.80,Default,,0,0,0,,Техехехе...хохохохо...
Dialogue: 0,0:15:26.88,0:15:29.01,Default,,0,0,0,,Каори ше? Ол шықпайды
Dialogue: 0,0:15:29.09,0:15:31.09,Default,,0,0,0,,Иә, күте тұр, мен сені сүйреп шығарамын.
Dialogue: 0,0:15:31.18,0:15:32.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:32.09,0:15:33.18,Default,,0,0,0,,Юе?
Dialogue: 0,0:15:33.26,0:15:34.35,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:15:34.43,0:15:37.39,Default,,0,0,0,,Мүмкін емес! Шиа киімі мүмкін емес қой!
Dialogue: 0,0:15:37.47,0:15:39.35,Default,,0,0,0,,Мата тым аз!
Dialogue: 0,0:15:39.43,0:15:41.56,Default,,0,0,0,,Жақсы емес пе? Жақсы емес пе?
Dialogue: 0,0:15:41.64,0:15:44.48,Default,,0,0,0,,Мүмкін емес! Бұл мүмкін емес!
Dialogue: 0,0:15:44.56,0:15:46.82,Default,,0,0,0,,Бұл жақсы емес пе? (Каори) Уау!
Dialogue: 0,0:15:46.90,0:15:47.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:57.28,0:16:00.96,Default,,0,0,0,,Уф... бұл ұят.
Dialogue: 0,0:16:01.04,0:16:04.00,Default,,0,0,0,,Хажиме-кун, маған көп қарама.
Dialogue: 0,0:16:05.38,0:16:06.84,Default,,0,0,0,,О
Dialogue: 0,0:16:06.92,0:16:08.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:22.69,0:16:28.11,Default,,0,0,0,,(Мюудың ұйықтап жатқан тынысы)
Dialogue: 0,0:16:28.19,0:16:30.19,Default,,0,0,0,,Теңіз нәсілінің баласы болсам да.
Dialogue: 0,0:16:30.28,0:16:34.49,Default,,0,0,0,,Оның міңгірлеп тұрғанын көру қазірдің өзінде сүйкімді котенка
Dialogue: 0,0:16:35.70,0:16:36.78,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:16:36.87,0:16:38.41,Default,,0,0,0,,Оны еркелетейік
Dialogue: 0,0:16:38.49,0:16:40.66,Default,,0,0,0,,Юэ-санның керемет шеберлігімен мен сені оятпаймын.
Dialogue: 0,0:16:40.74,0:16:43.79,Default,,0,0,0,,Мен сізге арқаңызды қағуға рұқсат етіңіз.
Dialogue: 0,0:16:43.87,0:16:45.25,Default,,0,0,0,,Myuu
Dialogue: 0,0:16:45.33,0:16:47.21,Default,,0,0,0,,Нху…
Dialogue: 0,0:16:47.29,0:16:50.96,Default,,0,0,0,,Жоқ, мен біртүрлі дауыс шығара алмадым.
Dialogue: 0,0:16:51.05,0:16:54.63,Default,,0,0,0,,Ой, қандай озық техника.
Dialogue: 0,0:16:54.72,0:16:56.76,Default,,0,0,0,,Мына жігіт істеп жатыр
Dialogue: 0,0:16:58.14,0:16:59.26,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:16:59.35,0:17:02.06,Default,,0,0,0,,Юэ-сан, сенің бет-әлпетің тәртіпсіз.
Dialogue: 0,0:17:02.14,0:17:02.98,Default,,0,0,0,,Ha
Dialogue: 0,0:17:03.06,0:17:04.89,Default,,0,0,0,,Бұл бос дере емес
Dialogue: 0,0:17:04.98,0:17:07.15,Default,,0,0,0,,Ол аздап қауіпті адам сияқты.
Dialogue: 0,0:17:07.23,0:17:10.36,Default,,0,0,0,,Бұзық адам бұзық сияқты қарауға...
Dialogue: 0,0:17:10.44,0:17:11.44,Default,,0,0,0,,Өмір бойы ессіздік
Dialogue: 0,0:17:11.53,0:17:13.15,Default,,0,0,0,,Хэхехе... ах
Dialogue: 0,0:17:14.28,0:17:18.16,Default,,0,0,0,,Асыл, шынында, асыл.
Dialogue: 0,0:17:18.95,0:17:21.49,Default,,0,0,0,,Кейде пайда болатын Хаджиме сөзі
Dialogue: 0,0:17:21.58,0:17:24.50,Default,,0,0,0,,Асыл деген не? Тете деген не?
Dialogue: 0,0:17:24.58,0:17:26.25,Default,,0,0,0,,Тети
Dialogue: 0,0:17:26.33,0:17:28.79,Default,,0,0,0,,Ол бір мектептің формасын киген екен.
Dialogue: 0,0:17:28.88,0:17:33.30,Default,,0,0,0,,Сіз кеше маған ең керемет апа екеніңізді айттыңыз, бірақ...
Dialogue: 0,0:17:33.38,0:17:35.42,Default,,0,0,0,,Менің бір ғана шағымым бар.
Dialogue: 0,0:17:35.51,0:17:38.43,Default,,0,0,0,,Оны ана деп атамайды.
Dialogue: 0,0:17:39.39,0:17:42.56,Default,,0,0,0,,Неліктен? Неге, Миу?
Dialogue: 0,0:17:43.22,0:17:47.06,Default,,0,0,0,,Миудың жалғыз анасы оның нағыз анасы екені рас.
Dialogue: 0,0:17:47.14,0:17:48.69,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:17:48.77,0:17:51.57,Default,,0,0,0,,Бірақ, Юэ-сан.
Dialogue: 0,0:17:51.65,0:17:54.44,Default,,0,0,0,,Меніңше, басқа ана болғаны дұрыс.
Dialogue: 0,0:17:55.40,0:17:59.45,Default,,0,0,0,,Менің ойымша, екі ананың болуы өте жақсы нәрсе.
Dialogue: 0,0:17:59.53,0:18:01.62,Default,,0,0,0,,Жоқ, Юэ-сан
Dialogue: 0,0:18:01.70,0:18:04.24,Default,,0,0,0,,Бұл дүкендегі сатылым емес.
Dialogue: 0,0:18:04.33,0:18:07.54,Default,,0,0,0,,Дәлірек айтсақ, жүрегімдегі дауыс ағып жатыр.
Dialogue: 0,0:18:07.62,0:18:09.42,Default,,0,0,0,,Мю-чан, сен ояусың ба?
Dialogue: 0,0:18:09.50,0:18:12.59,Default,,0,0,0,,Ха, не...?
Dialogue: 0,0:18:12.67,0:18:14.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:14.92,0:18:16.63,Default,,0,0,0,,Мью
Dialogue: 0,0:18:16.72,0:18:18.76,Default,,0,0,0,,бұл... Иә.
Dialogue: 0,0:18:18.84,0:18:20.64,Default,,0,0,0,,Уайымдаудың қажеті жоқ
Dialogue: 0,0:18:20.72,0:18:24.72,Default,,0,0,0,,Тіпті Юэ-онэ-чанның өзі де риза, сондықтан мен өте ризамын.
Dialogue: 0,0:18:24.81,0:18:26.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:26.81,0:18:29.35,Default,,0,0,0,,Мен шыдай алмаймын
Dialogue: 0,0:18:29.44,0:18:32.77,Default,,0,0,0,,Шыдай алмаймын, өмірімнің 3-ші қатарында.
Dialogue: 0,0:18:32.86,0:18:35.36,Default,,0,0,0,,Тұңғиық болса, соған кіргім келеді.
Dialogue: 0,0:18:35.44,0:18:38.32,Default,,0,0,0,,Осындай кезде, егер сіз ана болсаңыз...
Dialogue: 0,0:18:38.40,0:18:41.37,Default,,0,0,0,,Иә, мен оның мұны істейтініне сенімдімін.
Dialogue: 0,0:18:41.45,0:18:42.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:42.57,0:18:45.95,Default,,0,0,0,,Мен Юэ-онэ-чанды жақсы көремін
Dialogue: 0,0:18:46.04,0:18:46.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:46.95,0:18:49.00,Default,,0,0,0,,Күшті және салқын
Dialogue: 0,0:18:49.08,0:18:52.13,Default,,0,0,0,,Өте әдемі және мейірімді
Dialogue: 0,0:18:52.21,0:18:54.13,Default,,0,0,0,,Миу Миу…
Dialogue: 0,0:18:54.21,0:18:57.84,Default,,0,0,0,,Бұл не? Бұл не?
Dialogue: 0,0:18:57.92,0:19:01.93,Default,,0,0,0,,Бұл қауіпсіздік сезімін анам ұстап тұрғандай,
Dialogue: 0,0:19:02.01,0:19:05.60,Default,,0,0,0,,Уф... Мен өзімді әлсіз сезінемін.
Dialogue: 0,0:19:06.22,0:19:08.93,Default,,0,0,0,,Юэ-оне-чан сияқты анам болса
Dialogue: 0,0:19:09.02,0:19:10.98,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:19:11.77,0:19:14.69,Default,,0,0,0,,Бірақ Мюдың анасы бар.
Dialogue: 0,0:19:14.77,0:19:16.53,Default,,0,0,0,,Ана жай ғана ана...
Dialogue: 0,0:19:18.69,0:19:21.53,Default,,0,0,0,,Өйткені Мюдің үлкен әпкесі жоқ.
Dialogue: 0,0:19:24.95,0:19:25.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:26.58,0:19:30.41,Default,,0,0,0,,Иә, Юэ-сан үлкен апа болады.
Dialogue: 0,0:19:30.50,0:19:31.62,Default,,0,0,0,,Фуфу
Dialogue: 0,0:19:33.08,0:19:35.04,Default,,0,0,0,,Мен Мюдің әпкесімін.
Dialogue: 0,0:19:35.13,0:19:38.71,Default,,0,0,0,,Рахмет, Мюу-нечан.
Dialogue: 0,0:19:39.80,0:19:43.43,Default,,0,0,0,,Аа~ Мю мені сипады.
Dialogue: 0,0:19:43.51,0:19:45.05,Default,,0,0,0,,Қандай жеңілдік!
Dialogue: 0,0:19:45.14,0:19:47.18,Default,,0,0,0,,Әпкем аман болсын!
Dialogue: 0,0:19:47.26,0:19:49.64,Default,,0,0,0,,Ю... Юэ-сан сүйкімді ме?
Dialogue: 0,0:19:49.73,0:19:52.44,Default,,0,0,0,,Миу-чан, қорқынышты бала
Dialogue: 0,0:19:52.52,0:19:55.06,Default,,0,0,0,,Миуден аналық сезімді сезінесіз бе?
Dialogue: 0,0:19:55.15,0:19:58.19,Default,,0,0,0,,Оның үстіне Юэ сәбиге айналып бара жатқан сияқты.
Dialogue: 0,0:19:58.28,0:20:00.49,Default,,0,0,0,,О...құдай-ау
Dialogue: 0,0:20:00.57,0:20:04.53,Default,,0,0,0,,Мен бұл құбылыс Мю мен Юэде болады деп ешқашан күтпедім.
Dialogue: 0,0:20:04.62,0:20:07.08,Default,,0,0,0,,Сіз білесіз бе, ұстаз?
Dialogue: 0,0:20:07.16,0:20:09.91,Default,,0,0,0,,А... Түсіндірейін.
Dialogue: 0,0:20:10.00,0:20:13.96,Default,,0,0,0,,Менің әлемімде бұл «көпіршік пен огяру сезімі» деп аталады.
Dialogue: 0,0:20:14.04,0:20:15.67,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:20:15.75,0:20:19.63,Default,,0,0,0,,Юэ мен Мючан қазір қандай жағдайда?
Dialogue: 0,0:20:19.71,0:20:23.72,Default,,0,0,0,,Басқаша айтқанда, Мюдің аналығы мен инклюзивтілігіне байланысты.
Dialogue: 0,0:20:23.80,0:20:25.84,Default,,0,0,0,,Юэ сәби сияқты
Dialogue: 0,0:20:25.93,0:20:28.76,Default,,0,0,0,,Еркелеткің келеді деген сөз!
Dialogue: 0,0:20:28.85,0:20:30.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:30.85,0:20:35.02,Default,,0,0,0,,Бағалы жай ғана қымбат
Dialogue: 0,0:20:35.10,0:20:37.65,Default,,0,0,0,,Позицияны өзгерту де баға жетпес
Dialogue: 0,0:20:37.73,0:20:42.74,Default,,0,0,0,,Мен оны біраз уақыттан бері қарап жүрмін, бірақ күткендей, Ұстаз бұзылды.
Dialogue: 0,0:20:42.82,0:20:46.24,Default,,0,0,0,,Жарайды... жарайды, тіпті Юэ-санға қарсы болса да...
Dialogue: 0,0:20:46.32,0:20:49.28,Default,,0,0,0,,Хаджиме-санның себебі ұшуға бейім.
Dialogue: 0,0:20:49.37,0:20:53.41,Default,,0,0,0,,Мен Юэ өзінің аналық қасиетін толық көрсетті деп ойлағанымда, ол нәрестелік регрессияға қайта оралды.
Dialogue: 0,0:20:53.50,0:20:57.21,Default,,0,0,0,,Оның үстіне бұл жолы мен Мю Чанды ұната бастадым.
Dialogue: 0,0:20:57.29,0:20:59.42,Default,,0,0,0,,Ана болу мүмкіндігі толық
Dialogue: 0,0:20:59.50,0:21:01.38,Default,,0,0,0,,Түсіндім, иә...
Dialogue: 0,0:21:01.46,0:21:04.80,Default,,0,0,0,,Бұл, әрине, сіздің қожайыныңыз төтеп бере алмайтын жойқын күш.
Dialogue: 0,0:21:05.68,0:21:09.01,Default,,0,0,0,,Уф... Үлкен апа болғанның дұрыс екеніне көзім жеткенмен.
Dialogue: 0,0:21:09.10,0:21:11.81,Default,,0,0,0,,Өйткені, ана болу еліктіреді.
Dialogue: 0,0:21:11.89,0:21:14.89,Default,,0,0,0,,Мен Мюдің анасы бола алмайтындықтан—
Dialogue: 0,0:21:17.81,0:21:21.78,Default,,0,0,0,,Мен қайтадан сәбилі болғанымды қалаймын...
Dialogue: 0,0:21:22.57,0:21:24.36,Default,,0,0,0,,Саяхат жалғасады
Dialogue: 0,0:21:24.44,0:21:25.90,Default,,0,0,0,,Қазір Хажимеге шабуыл жасау...
Dialogue: 0,0:21:25.99,0:21:30.78,Default,,0,0,0,,А, мен жай ғана көңілді отбасылық жоспарды іске қоса алмаймын.
Dialogue: 0,0:21:30.87,0:21:34.16,Default,,0,0,0,,Тіпті менде де сонша сезім бар.
Dialogue: 0,0:21:34.25,0:21:39.25,Default,,0,0,0,,Солай бола тұрса да, Мюуға бұдан былай қиындық туғызу жақсы емес...
Dialogue: 0,0:21:39.33,0:21:40.42,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:40.50,0:21:42.67,Default,,0,0,0,,Хаджиме?
Dialogue: 0,0:21:44.72,0:21:45.67,Default,,0,0,0,,Огяру?
Dialogue: 0,0:21:45.76,0:21:47.68,Default,,0,0,0,,Огия!
Dialogue: 0,0:21:47.76,0:21:50.05,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:21:50.14,0:21:53.77,Default,,0,0,0,,Әй... сен сәби боласың ба?
Dialogue: 0,0:21:53.85,0:21:55.56,Default,,0,0,0,,Менің ондай хоббиім жоқ.
Dialogue: 0,0:21:56.73,0:21:57.81,Default,,0,0,0,,Иә
Dialogue: 0,0:21:57.89,0:21:59.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:59.27,0:22:02.61,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:22:02.69,0:22:05.07,Default,,0,0,0,,Огия~!
Dialogue: 0,0:22:05.15,0:22:09.70,Default,,0,0,0,,Огия~!
Dialogue: 0,0:22:11.32,0:22:16.33,Default,,0,0,0,,♪～
Dialogue: 0,0:23:35.87,0:23:40.87,Default,,0,0,0,,～♪
