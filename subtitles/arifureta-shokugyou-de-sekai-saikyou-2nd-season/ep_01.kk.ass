Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:03.92,Default,,0,0,0,,(жүрек тондары)
Dialogue: 0,0:00:04.00,0:00:07.92,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:26.69,0:00:28.06,Default,,0,0,0,,Құт
Dialogue: 0,0:00:28.69,0:00:31.82,Default,,0,0,0,,(Жылдам жүрек соғысы)
Dialogue: 0,0:00:37.49,0:00:39.66,Default,,0,0,0,,Барлық жауларды өлтіріңіз
Dialogue: 0,0:00:49.42,0:00:51.00,Default,,0,0,0,,Тіпті егер солай болса да
Dialogue: 0,0:00:52.34,0:00:54.05,Default,,0,0,0,,Құдай болса да
Dialogue: 0,0:00:56.05,0:00:57.72,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:00:57.80,0:01:02.81,Default,,0,0,0,,♪～
Dialogue: 0,0:02:22.35,0:02:27.93,Default,,0,0,0,,～♪
Dialogue: 0,0:02:36.53,0:02:40.45,Default,,0,0,0,,Мәртебелі, бұл бастапқыда жоспарланғаннан кеш.
Dialogue: 0,0:02:40.53,0:02:44.45,Default,,0,0,0,,Батырдың аман-есен оралғанына көңілім толды.
Dialogue: 0,0:02:44.53,0:02:48.87,Default,,0,0,0,,Хм, жын-шайтандардың жарысы белсенді бола бастағанын естідім.
Dialogue: 0,0:02:48.96,0:02:52.79,Default,,0,0,0,,Батырдың күші керек болатын уақыт таяп қалды.
Dialogue: 0,0:02:53.67,0:02:56.25,Default,,0,0,0,,Сізге не болды, Лилиана ханшайым?
Dialogue: 0,0:02:56.34,0:02:59.30,Default,,0,0,0,,Сіз жайсыз сияқтысыз.
Dialogue: 0,0:02:59.38,0:03:03.64,Default,,0,0,0,,Жоқ... Жоқ, Рим Папасы Иштар, мен...
Dialogue: 0,0:03:05.18,0:03:07.52,Default,,0,0,0,,Құдайдың қолымен Коуки-сан және т.б
Dialogue: 0,0:03:07.60,0:03:10.44,Default,,0,0,0,,Бұл әлемге басқа әлемнен шақырылған
Dialogue: 0,0:03:10.52,0:03:11.64,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:15.73,0:03:17.69,Default,,0,0,0,,Батыр Доно қайтып келді.
Dialogue: 0,0:03:17.78,0:03:18.74,Default,,0,0,0,,Ах
Dialogue: 0,0:03:18.82,0:03:20.49,Default,,0,0,0,,Ах
Dialogue: 0,0:03:22.20,0:03:23.74,Default,,0,0,0,,Шақырудың мақсаты қандай?
Dialogue: 0,0:03:23.82,0:03:27.37,Default,,0,0,0,,Біз адамдарды жын нәсілінен қорғау
Dialogue: 0,0:03:27.45,0:03:30.87,Default,,0,0,0,,Коуки мен оның достарының бастапқы әлеміне қайта оралу мүмкіндігі жоқ.
Dialogue: 0,0:03:30.96,0:03:33.71,Default,,0,0,0,,Құдайдың еркін орындаудан басқа амалым қалмады.
Dialogue: 0,0:03:34.42,0:03:37.67,Default,,0,0,0,,Сол шайқасқа дайындық кезінде болған қайғылы оқиға.
Dialogue: 0,0:03:38.34,0:03:39.59,Default,,0,0,0,,Енді жоқ...
Dialogue: 0,0:03:39.67,0:03:40.51,Default,,0,0,0,,Ах
Dialogue: 0,0:03:47.43,0:03:49.14,Default,,0,0,0,,Лилия
Dialogue: 0,0:03:49.22,0:03:50.77,Default,,0,0,0,,Ах
Dialogue: 0,0:03:52.60,0:03:54.02,Default,,0,0,0,,Тамшылар!
Dialogue: 0,0:03:55.69,0:03:59.69,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:04:04.24,0:04:05.82,Default,,0,0,0,,Ах, хехе
Dialogue: 0,0:04:05.91,0:04:06.99,Default,,0,0,0,,Фуфу
Dialogue: 0,0:04:07.08,0:04:11.37,Default,,0,0,0,,Мен үлкен Оркус лабиринтінен орала алмағандықтан уайымдадым.
Dialogue: 0,0:04:11.45,0:04:14.54,Default,,0,0,0,,Бізде бәрі жақсы. үшін қалай болды?
Dialogue: 0,0:04:14.62,0:04:17.84,Default,,0,0,0,,Иә, екінші тараптар
Dialogue: 0,0:04:17.92,0:04:20.46,Default,,0,0,0,,Ол күнде жаттығумен айналысатын.
Dialogue: 0,0:04:21.13,0:04:23.09,Default,,0,0,0,,Мен Коуки-санға және басқаларға жеңілуге ​​шамасы жоқ.
Dialogue: 0,0:04:23.68,0:04:25.55,Default,,0,0,0,,Тек оған сенбеңіз
Dialogue: 0,0:04:25.64,0:04:28.05,Default,,0,0,0,,Біз де күштірек болуымыз керек.
Dialogue: 0,0:04:34.23,0:04:36.98,Default,,0,0,0,,Эй, Эрин, бірдеңе ішкің келе ме?
Dialogue: 0,0:04:38.11,0:04:39.27,Default,,0,0,0,,Эрин?
Dialogue: 0,0:04:40.02,0:04:42.90,Default,,0,0,0,,Дұрыс, бірдеңе ішкің келе ме?
Dialogue: 0,0:04:42.99,0:04:45.53,Default,,0,0,0,,Егер Шидзуку мен басқалары осылай қайтып келмесе
Dialogue: 0,0:04:45.61,0:04:48.70,Default,,0,0,0,,Өздері барып іздейтіндерін айтты.
Dialogue: 0,0:04:48.78,0:04:51.54,Default,,0,0,0,,Олар достарына қамқорлық жасайтын өте жақсы адамдар.
Dialogue: 0,0:04:53.25,0:04:55.08,Default,,0,0,0,,Титан шабуылына ұшыраған Трост ауданында,
Dialogue: 0,0:04:55.16,0:04:56.96,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:04:57.04,0:04:59.25,Default,,0,0,0,,Сіз сондай қауіпті құбыжықпен күрестіңіз бе?
Dialogue: 0,0:04:59.34,0:05:03.42,Default,,0,0,0,,Ол құбыжық емес. Ол құбыжық.
Dialogue: 0,0:05:03.51,0:05:07.89,Default,,0,0,0,,Коусуке Косуке қайда! Кусуке!
Dialogue: 0,0:05:07.97,0:05:11.68,Default,,0,0,0,,Иә? Ойлап қарасам, Қосыкені көре алмаймын.
Dialogue: 0,0:05:11.76,0:05:13.64,Default,,0,0,0,,Кусуке! Бұл қайда?
Dialogue: 0,0:05:13.73,0:05:15.48,Default,,0,0,0,,Кусуке!
Dialogue: 0,0:05:15.56,0:05:17.40,Default,,0,0,0,,Жоқ, мен осындамын.
Dialogue: 0,0:05:17.48,0:05:18.56,Default,,0,0,0,,Уау
Dialogue: 0,0:05:19.27,0:05:21.69,Default,,0,0,0,,Әдеттегідей, көлеңке жұқа
Dialogue: 0,0:05:21.77,0:05:23.11,Default,,0,0,0,,Мен жылай аламын ба?
Dialogue: 0,0:05:23.19,0:05:24.24,Default,,0,0,0,,Фуфу
Dialogue: 0,0:05:24.32,0:05:26.45,Default,,0,0,0,,Сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:05:26.53,0:05:28.91,Default,,0,0,0,,Бірақ бәрі жақсы сияқты, сондықтан мен жеңілдеп қалдым.
Dialogue: 0,0:05:28.99,0:05:31.58,Default,,0,0,0,,Иә, сонда Каори ше?
Dialogue: 0,0:05:33.37,0:05:35.71,Default,,0,0,0,,Лили, бұл туралы.
Dialogue: 0,0:05:35.79,0:05:36.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:40.96,0:05:42.21,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:42.30,0:05:45.13,Default,,0,0,0,,Каори Нагумо-санмен бірге, солай ма?
Dialogue: 0,0:05:45.21,0:05:46.47,Default,,0,0,0,,Иә
Dialogue: 0,0:05:46.55,0:05:49.14,Default,,0,0,0,,Коуки-санның көңіл-күйінің нашарлауының себебі осы ма?
Dialogue: 0,0:05:49.22,0:05:50.47,Default,,0,0,0,,Ах! Енді түсіндім, сонда
Dialogue: 0,0:05:50.55,0:05:53.14,Default,,0,0,0,,А, менің ойымша, бұл да солай.
Dialogue: 0,0:05:53.22,0:05:56.81,Default,,0,0,0,,Жарайды... Нагумо-кун маған тағы да көмектесті.
Dialogue: 0,0:05:56.89,0:05:57.73,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:05:57.81,0:06:01.19,Default,,0,0,0,,Дегенмен, ол батыр.
Dialogue: 0,0:06:01.27,0:06:03.69,Default,,0,0,0,,Егер сіз үнемі депрессияда жүрсеңіз, бұл проблема болар еді.
Dialogue: 0,0:06:03.78,0:06:04.98,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:05.07,0:06:08.40,Default,,0,0,0,,Ең нашар жағдай, мен бұл туралы бірдеңе істеймін.
Dialogue: 0,0:06:08.49,0:06:10.24,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:06:10.32,0:06:13.45,Default,,0,0,0,,Нагумо-санның аман-есен болғанына өте қуаныштымын.
Dialogue: 0,0:06:13.53,0:06:16.29,Default,,0,0,0,,Мен сенімен бірге қайтқым келді.
Dialogue: 0,0:06:16.37,0:06:20.25,Default,,0,0,0,,Ол өзінің туған әлеміне оралудың басқа жолын іздейтінін айтады.
Dialogue: 0,0:06:20.33,0:06:23.13,Default,,0,0,0,,Сізбен кездесе алмайтыныма біраз көңілім қалды.
Dialogue: 0,0:06:23.21,0:06:25.21,Default,,0,0,0,,Мен сені кездестірсем таң қалар едім.
Dialogue: 0,0:06:25.30,0:06:27.76,Default,,0,0,0,,Тіпті оның келбеті де айтарлықтай өзгерген.
Dialogue: 0,0:06:30.80,0:06:32.43,Default,,0,0,0,,Мен қазірше сенімдімін...
Dialogue: 0,0:06:43.69,0:06:46.15,Default,,0,0,0,,Сыртта Бұл таңқаларлық, Тио-сан.
Dialogue: 0,0:06:46.23,0:06:49.53,Default,,0,0,0,,Хаджиме-санның Бризі болмаса қиын болар еді.
Dialogue: 0,0:06:49.61,0:06:51.70,Default,,0,0,0,,Мүлдем емес, шиа.
Dialogue: 0,0:06:51.78,0:06:55.03,Default,,0,0,0,,Бұл мен алға жылжығым келетін жер емес.
Dialogue: 0,0:06:55.12,0:06:57.66,Default,,0,0,0,,Соңғы келгенімнен мүлде басқаша.
Dialogue: 0,0:06:57.75,0:07:02.25,Default,,0,0,0,,Өте керемет, көзім ауырмайды. Әке керемет.
Dialogue: 0,0:07:02.33,0:07:05.55,Default,,0,0,0,,Дұрыс, Хаджиме Папа керемет~
Dialogue: 0,0:07:05.63,0:07:08.09,Default,,0,0,0,,Миу-чан, салқын су ішкің келе ме?
Dialogue: 0,0:07:08.17,0:07:11.72,Default,,0,0,0,,Сусын~ Рахмет, Каори-оне-чан.
Dialogue: 0,0:07:11.80,0:07:13.30,Default,,0,0,0,,Әй, ақтық...
Dialogue: 0,0:07:15.30,0:07:19.10,Default,,0,0,0,,Немесе... Каори, мені Хаджименің әкесі деп айтуды доғаршы.
Dialogue: 0,0:07:19.18,0:07:21.27,Default,,0,0,0,,Мен қатты қышиды.
Dialogue: 0,0:07:21.35,0:07:24.73,Default,,0,0,0,,Не? Бірақ Мюу-чан сізге әдеттегідей қоңырау шалады, солай ма?
Dialogue: 0,0:07:24.81,0:07:26.32,Default,,0,0,0,,Мью жақсы
Dialogue: 0,0:07:26.40,0:07:30.45,Default,,0,0,0,,Дегенмен, мен сыныптастарымның мені әке деп атағанын қаламаймын.
Dialogue: 0,0:07:30.53,0:07:33.28,Default,,0,0,0,,Иә? Ондай жағдайда мен саған қоңырау шалмаймын.
Dialogue: 0,0:07:33.36,0:07:36.78,Default,,0,0,0,,Бірақ бір күні балам болса, онда...
Dialogue: 0,0:07:36.87,0:07:37.95,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:07:38.04,0:07:40.83,Default,,0,0,0,,Мен алдын ала уәде бердім.
Dialogue: 0,0:07:40.91,0:07:42.12,Default,,0,0,0,,Е...
Dialogue: 0,0:07:42.21,0:07:45.63,Default,,0,0,0,,Хехе мен сені ата-анаммен таныстырамын деп уәде беріп қойғанмын.
Dialogue: 0,0:07:45.71,0:07:46.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:46.79,0:07:49.17,Default,,0,0,0,,Жарқын отбасын жоспарлау өте жақсы
Dialogue: 0,0:07:49.26,0:07:50.51,Default,,0,0,0,,Не!
Dialogue: 0,0:07:50.59,0:07:53.89,Default,,0,0,0,,Сондай-ақ Хаджимемен туған қалада кездесуді жоспарлау.
Dialogue: 0,0:07:53.97,0:07:55.89,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:07:55.97,0:07:56.97,Default,,0,0,0,,Фуфу
Dialogue: 0,0:07:57.05,0:08:00.48,Default,,0,0,0,,Мен... Юэ білмейтін Хаджиме-кунды көп білемін.
Dialogue: 0,0:08:00.56,0:08:02.48,Default,,0,0,0,,Хаджименің болашақ армандары мен хоббиі
Dialogue: 0,0:08:02.56,0:08:03.39,Default,,0,0,0,,Ком-Омбодағы адам да шынайы емес пе еді?
Dialogue: 0,0:08:03.48,0:08:07.32,Default,,0,0,0,,Юэ, Хаджиме қандай аниме немесе манга ұнататынын білесіз бе?
Dialogue: 0,0:08:07.40,0:08:12.78,Default,,0,0,0,,Бұл... Бірақ қазір маңызды емес. Мұнда ондай ештеңе жоқ.
Dialogue: 0,0:08:12.86,0:08:16.12,Default,,0,0,0,,Бұл тәтті. Бұл Хаджиме-кунға қалай қарасаңыз да, ол аниме кейіпкері.
Dialogue: 0,0:08:16.20,0:08:17.03,Default,,0,0,0,,…ол үстем болатынына сенді.
Dialogue: 0,0:08:17.12,0:08:18.95,Default,,0,0,0,,Қаруға да қатысты.
Dialogue: 0,0:08:19.04,0:08:22.83,Default,,0,0,0,,Прототип жасалуда... Не айттыңыз? Кроссбит?
Dialogue: 0,0:08:22.91,0:08:25.12,Default,,0,0,0,,Бұл сөзсіз «Шұңқырдан» кейін үлгіленген
Dialogue: 0,0:08:25.21,0:08:27.79,Default,,0,0,0,,Гаха… Каори
Dialogue: 0,0:08:27.88,0:08:29.50,Default,,0,0,0,,Хмм… ммм…
Dialogue: 0,0:08:29.59,0:08:33.93,Default,,0,0,0,,Woohoo Өзіңізге ұнайтын адам нені ұнататынын білмей мақтана аласыз ба?
Dialogue: 0,0:08:34.01,0:08:36.22,Default,,0,0,0,,Каори жақсы батылдық
Dialogue: 0,0:08:36.30,0:08:40.72,Default,,0,0,0,,Олай болса мен Хаджименің де нені ұнататынын айтайын.
Dialogue: 0,0:08:41.56,0:08:42.81,Default,,0,0,0,,Төсекте
Dialogue: 0,0:08:42.89,0:08:44.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:44.44,0:08:49.23,Default,,0,0,0,,Нанана... Төсекте Уф... Күткендей...
Dialogue: 0,0:08:49.32,0:08:51.69,Default,,0,0,0,,Хехе, сенің екеуміздің айырмашылығымды сезініп көр.
Dialogue: 0,0:08:51.78,0:08:52.61,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:08:52.69,0:08:54.45,Default,,0,0,0,,Фуфуфу (Каори) Гунунуну...
Dialogue: 0,0:08:54.53,0:08:57.62,Default,,0,0,0,,Юэ-оне-чан да, Каори-оне-чан да үнемі ұрысады.
Dialogue: 0,0:08:57.70,0:09:00.66,Default,,0,0,0,,Біз жақсы дос емеспіз. Мен әпкелерімді ұнатпаймын.
Dialogue: 0,0:09:01.29,0:09:05.00,Default,,0,0,0,,Екеуің Мю Чанның алдында сондай ұсқынсызсыңдар.
Dialogue: 0,0:09:05.08,0:09:09.17,Default,,0,0,0,,Дәлірек айтсақ, бұл білімге зиян. Кішкене абай болыңыз.
Dialogue: 0,0:09:09.25,0:09:12.59,Default,,0,0,0,,Ес-түссіз Шиадан ұрысуға
Dialogue: 0,0:09:12.67,0:09:15.55,Default,,0,0,0,,Кешіріңіз, Мю Чан, Шиа
Dialogue: 0,0:09:15.63,0:09:16.55,Default,,0,0,0,,Фу
Dialogue: 0,0:09:18.97,0:09:22.01,Default,,0,0,0,,Ұстаз, алда біраз әбігер бар.
Dialogue: 0,0:09:22.10,0:09:23.14,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:24.60,0:09:26.64,Default,,0,0,0,,Бұл құмды құрт.
Dialogue: 0,0:09:26.73,0:09:30.31,Default,,0,0,0,,Ұлы Грюен шөлінде құм құрттары бар.
Dialogue: 0,0:09:30.40,0:09:32.98,Default,,0,0,0,,Мұнда таңқаларлық ештеңе жоқ...
Dialogue: 0,0:09:34.07,0:09:35.74,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:09:36.49,0:09:39.49,Default,,0,0,0,,Қоршаған олжаны жеу керек пе, жоқ па?
Dialogue: 0,0:09:39.57,0:09:41.45,Default,,0,0,0,,Сіз адасқан сияқтысыз.
Dialogue: 0,0:09:41.53,0:09:43.29,Default,,0,0,0,,Міне, солай көрінеді.
Dialogue: 0,0:09:43.37,0:09:45.29,Default,,0,0,0,,Бұл шынымен рас па?
Dialogue: 0,0:09:45.37,0:09:47.54,Default,,0,0,0,,Олар нашар жегіш.
Dialogue: 0,0:09:47.62,0:09:50.71,Default,,0,0,0,,Жемтігіңнің алдында тайсалмау керек.
Dialogue: 0,0:09:50.79,0:09:51.63,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:57.43,0:09:59.14,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:09:59.22,0:10:00.14,Default,,0,0,0,,Құдай-ай.
Dialogue: 0,0:10:00.89,0:10:02.72,Default,,0,0,0,,(Каоридің айқайы)
Dialogue: 0,0:10:09.73,0:10:12.52,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:10:12.61,0:10:16.49,Default,,0,0,0,,Қандай бұзық! Қанша уақыт кеудемді басып жүрсің?
Dialogue: 0,0:10:16.57,0:10:19.95,Default,,0,0,0,,Бұл форс-мажорлық жағдай.
Dialogue: 0,0:10:29.79,0:10:33.04,Default,,0,0,0,,Сәлем Каори! Сіз тіпті осындай уақытта не істеп жатырсыз?
Dialogue: 0,0:10:33.13,0:10:35.21,Default,,0,0,0,,Өйткені бұл қауіпті! Өйткені ол қауіпті
Dialogue: 0,0:10:35.30,0:10:36.96,Default,,0,0,0,,Мен ұстап тұрмын, себебі бұл қауіпті!
Dialogue: 0,0:10:37.05,0:10:41.01,Default,,0,0,0,,Мен, Каори, маған тосын шабуыл деген не?
Dialogue: 0,0:10:41.09,0:10:42.22,Default,,0,0,0,,Жасайды
Dialogue: 0,0:10:42.30,0:10:44.31,Default,,0,0,0,,Эмма! Рэй!
Dialogue: 0,0:10:44.39,0:10:46.81,Default,,0,0,0,,Ешқашан тентек мақсат болған емес.
Dialogue: 0,0:10:46.89,0:10:48.85,Default,,0,0,0,,Мен сені аздап құшақтағым келді.
Dialogue: 0,0:10:48.93,0:10:51.98,Default,,0,0,0,,Ал егер бәрі жақсы болса, Хаджимені сол күйінде ләззат алғыңыз келе ме?
Dialogue: 0,0:10:52.06,0:10:54.15,Default,,0,0,0,,Иә, дұрыс...бұл дұрыс емес!
Dialogue: 0,0:10:54.23,0:10:57.19,Default,,0,0,0,,Біртүрлі сөздер айтпа. Мен Юэ сияқты бұзық емеспін.
Dialogue: 0,0:10:57.28,0:10:59.32,Default,,0,0,0,,Мені тентек дедің бе?
Dialogue: 0,0:10:59.40,0:11:01.86,Default,,0,0,0,,Хажиммен оңаша қалғанда оны жоққа шығара алмайтыным рас.
Dialogue: 0,0:11:01.95,0:11:04.16,Default,,0,0,0,,Балалар, енді жабыңдар.
Dialogue: 0,0:11:04.24,0:11:07.45,Default,,0,0,0,,Ал Юэ, түнде сөйлесуге тыйым салынады.
Dialogue: 0,0:11:09.54,0:11:12.21,Default,,0,0,0,,Ой, артқа қарай жүгіріп келе жатырмын.
Dialogue: 0,0:11:12.29,0:11:14.79,Default,,0,0,0,,Хаджименің әкесі көлік жүргізуге өте жақсы.
Dialogue: 0,0:11:14.88,0:11:16.38,Default,,0,0,0,,Сондықтан мені әке деме!
Dialogue: 0,0:11:16.46,0:11:18.34,Default,,0,0,0,,Хаджиме Мен әлі балалы болғым келеді.
Dialogue: 0,0:11:18.42,0:11:21.63,Default,,0,0,0,,Сәлем! Қонақ үйді брондағаннан кейін демалыстан ләззат алыңыз.
Dialogue: 0,0:11:21.72,0:11:24.30,Default,,0,0,0,,Мен сені ермек үшін айдалаға лақтырамын.
Dialogue: 0,0:11:24.39,0:11:25.72,Default,,0,0,0,,Тек сабан адамдар үшін қатал!
Dialogue: 0,0:11:25.81,0:11:29.60,Default,,0,0,0,,Ойлап қарасам, мен оны бірінші рет кездейсоқ пайдаланып отырмын.
Dialogue: 0,0:11:34.44,0:11:37.61,Default,,0,0,0,,Ей, Бриздің осындай айласы бар еді.
Dialogue: 0,0:11:37.69,0:11:38.82,Default,,0,0,0,,Хажиме данышпан
Dialogue: 0,0:11:38.90,0:11:40.61,Default,,0,0,0,,Шеберіңіз күткендей.
Dialogue: 0,0:11:50.50,0:11:51.54,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:11:51.62,0:11:53.75,Default,,0,0,0,,Мю оны көрмейтініне көз жеткізіңіз.
Dialogue: 0,0:11:56.29,0:11:58.80,Default,,0,0,0,,Енді не болып жатыр?
Dialogue: 0,0:12:02.55,0:12:06.60,Default,,0,0,0,,Мен мынаны қарап тұрмын, қорқынышты емес пе? Хаджиме-сан
Dialogue: 0,0:12:06.68,0:12:09.52,Default,,0,0,0,,Бұрынғыдан әлдеқайда көп адамдар бар сияқты.
Dialogue: 0,0:12:09.60,0:12:10.93,Default,,0,0,0,,Қараңдаршы.
Dialogue: 0,0:12:31.25,0:12:32.79,Default,,0,0,0,,Хаджиме-кун, солай.
Dialogue: 0,0:12:36.83,0:12:38.04,Default,,0,0,0,,(Джунпей) Тағы айтамын: шегін, сиқыршы.
Dialogue: 0,0:12:38.13,0:12:40.55,Default,,0,0,0,,Құм құрт осыны көздеп отыр ма?
Dialogue: 0,0:12:40.63,0:12:44.63,Default,,0,0,0,,Хажиме-кун, ол жаққа баруға болады ма...?
Dialogue: 0,0:12:44.72,0:12:46.59,Default,,0,0,0,,Миу-чан да сонда.
Dialogue: 0,0:12:46.68,0:12:49.18,Default,,0,0,0,,Хмм... Бірдеңе болып қалса, қиналып қалар едім.
Dialogue: 0,0:12:49.26,0:12:50.85,Default,,0,0,0,,Мю жақсы ма?
Dialogue: 0,0:12:50.93,0:12:54.94,Default,,0,0,0,,Каори емші, сондықтан оған көмектескісі келеді.
Dialogue: 0,0:12:55.73,0:12:56.69,Default,,0,0,0,,Иә
Dialogue: 0,0:12:59.69,0:13:01.82,Default,,0,0,0,,Мю Шиа мен Бриздің ішінде қалады.
Dialogue: 0,0:13:01.90,0:13:03.03,Default,,0,0,0,,Хажиме-кун
Dialogue: 0,0:13:03.11,0:13:07.45,Default,,0,0,0,,Неліктен тамақтанбады деп ойлаймын.
Dialogue: 0,0:13:12.87,0:13:15.25,Default,,0,0,0,,Уф... ха ха ха ха
Dialogue: 0,0:13:15.33,0:13:16.67,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:22.63,0:13:25.01,Default,,0,0,0,,А, сиқырлы қашқын ба?
Dialogue: 0,0:13:25.09,0:13:28.51,Default,,0,0,0,,Ішкен удың әсерінен денеңіздің ішіндегі сиқырлы күш бақылаудан шығып жатыр ма?
Dialogue: 0,0:13:28.59,0:13:31.26,Default,,0,0,0,,Каори Сіз не білдіңіз?
Dialogue: 0,0:13:31.35,0:13:35.06,Default,,0,0,0,,Жаман нәрсе жұтқандықтан болар.
Dialogue: 0,0:13:35.14,0:13:38.40,Default,,0,0,0,,Менің ойымша, оның сиқырының бақылаудан шығуының себебі осы.
Dialogue: 0,0:13:38.48,0:13:40.61,Default,,0,0,0,,Сіздің сиқырыңыз жабайы болып жатыр ма?
Dialogue: 0,0:13:40.69,0:13:43.90,Default,,0,0,0,,Иә, және оны сыртқа шығаруға болмайды.
Dialogue: 0,0:13:43.98,0:13:47.53,Default,,0,0,0,,Ішінен күштеп іске қосылды, басылды
Dialogue: 0,0:13:47.61,0:13:49.41,Default,,0,0,0,,Менің денем бой көтермейді
Dialogue: 0,0:13:49.49,0:13:52.79,Default,,0,0,0,,Бұлай жалғаса берсе, ішкі ағзаларыңыз бен қан тамырларыңыз жарылып кетеді.
Dialogue: 0,0:13:54.45,0:13:58.92,Default,,0,0,0,,Аспан батасы, қайтып оралуыңды осы жерден ізде, Мәнтен!
Dialogue: 0,0:14:02.00,0:14:05.01,Default,,0,0,0,,Әсері жоқ дерлік Неге?
Dialogue: 0,0:14:05.09,0:14:08.38,Default,,0,0,0,,Егер сіз оны тазарта алмасаңыз, бұл сіз соншалықты араласып жатырсыз дегенді білдіре ме?
Dialogue: 0,0:14:11.72,0:14:12.56,Default,,0,0,0,,Каори?
Dialogue: 0,0:14:14.31,0:14:16.98,Default,,0,0,0,,Жарық нұрымен жариялаңыз
Dialogue: 0,0:14:17.06,0:14:19.98,Default,,0,0,0,,Бұл киелі жер және менің доменім.
Dialogue: 0,0:14:20.06,0:14:23.86,Default,,0,0,0,,Барлық жындар менің еркіне түседі, Кайсей!
Dialogue: 0,0:14:25.94,0:14:28.99,Default,,0,0,0,,Жетілдірілген қалпына келтіру сиқыры Кайсей
Dialogue: 0,0:14:29.07,0:14:31.74,Default,,0,0,0,,Адамдардың сиқырлы күшін басқаларға беру арқылы
Dialogue: 0,0:14:31.82,0:14:35.12,Default,,0,0,0,,Сиқырлы қуат таусылуын уақытша болдырмауға болады.
Dialogue: 0,0:14:35.20,0:14:39.37,Default,,0,0,0,,Хмм, сіз сиқырлы қуатты күшпен алуға болады.
Dialogue: 0,0:14:39.46,0:14:43.50,Default,,0,0,0,,Бұл жас жігіттің қашқан сиқырлы күші оның денесінен босатылуы мүмкін.\NБұл
Dialogue: 0,0:14:43.59,0:14:44.80,Default,,0,0,0,,дегенді білдіре ме?
Dialogue: 0,0:14:44.88,0:14:50.13,Default,,0,0,0,,Ал алынған сиқырлы күш мен саған сыйлаған құдайдың кристалды сақинасына салынады...
Dialogue: 0,0:14:50.22,0:14:54.22,Default,,0,0,0,,(Біздің ауыр тыныс алуы)
Dialogue: 0,0:14:59.48,0:15:02.15,Default,,0,0,0,,Фу фу…
Dialogue: 0,0:15:05.19,0:15:08.11,Default,,0,0,0,,Бұл жақын арада болады деп ойламаймын.
Dialogue: 0,0:15:08.19,0:15:10.53,Default,,0,0,0,,Ешқандай іргелі шешімге қол жеткізілмеді
Dialogue: 0,0:15:11.36,0:15:15.74,Default,,0,0,0,,Егер сіз сиқырлы қуатты тым көп жұмсасаңыз, әлсіреп өлуіңіз мүмкін.
Dialogue: 0,0:15:15.83,0:15:18.41,Default,,0,0,0,,Мен қысымды азайту үшін жеткілікті түрде алып тастадым.
Dialogue: 0,0:15:18.50,0:15:20.41,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:15:21.00,0:15:25.63,Default,,0,0,0,,Осылай жалғаса беретін сиқырлы күштің әсерінен мені тағы ішімнен қыспаққа аламын.
Dialogue: 0,0:15:25.71,0:15:29.30,Default,,0,0,0,,Тіпті физикалық шаршаған кезде де мен әлсіреп өлемін деп ойлаймын.
Dialogue: 0,0:15:29.38,0:15:33.30,Default,,0,0,0,,Барлық сабақтарымда мұндай белгілер есімде жоқ.
Dialogue: 0,0:15:33.89,0:15:35.89,Default,,0,0,0,,Юэ мен Тио туралы ештеңе білмейсің бе?
Dialogue: 0,0:15:38.85,0:15:41.14,Default,,0,0,0,,Иә, Каори
Dialogue: 0,0:15:41.23,0:15:44.52,Default,,0,0,0,,Мүмкін болса, бізді де тексеріңіз.
Dialogue: 0,0:15:44.61,0:15:48.90,Default,,0,0,0,,Егер бұл белгісіз ауру болса, оның ауа арқылы жұғу мүмкіндігі бар.
Dialogue: 0,0:15:48.98,0:15:49.94,Default,,0,0,0,,Иә
Dialogue: 0,0:15:52.99,0:15:56.41,Default,,0,0,0,,(Бакуго) Ха! Ал бері кел, шалғайлар! Қатты жарысуға шақырамын!
Dialogue: 0,0:16:00.50,0:16:03.08,Default,,0,0,0,,Мен мен құдай!
Dialogue: 0,0:16:03.17,0:16:06.17,Default,,0,0,0,,Сонымен, мен өлдім бе?
Dialogue: 0,0:16:06.25,0:16:11.38,Default,,0,0,0,,Мені Құдай шақырды... О, құдай
Dialogue: 0,0:16:11.47,0:16:12.34,Default,,0,0,0,,Ой!
Dialogue: 0,0:16:12.42,0:16:13.26,Default,,0,0,0,,Хаджиме-кун?
Dialogue: 0,0:16:13.34,0:16:17.51,Default,,0,0,0,,Ақымақ айтпа, тез оян, өлесің.
Dialogue: 0,0:16:17.60,0:16:20.47,Default,,0,0,0,,А... а... мен тірімін.
Dialogue: 0,0:16:20.56,0:16:22.85,Default,,0,0,0,,Мен солай деп ойладым.
Dialogue: 0,0:16:22.94,0:16:26.36,Default,,0,0,0,,Алла тағала мені әлі тастамаған сияқты.
Dialogue: 0,0:16:26.44,0:16:27.52,Default,,0,0,0,,Хаджиме-кун
Dialogue: 0,0:16:27.61,0:16:30.23,Default,,0,0,0,,Көлікке отырған дұрыс емес пе?
Dialogue: 0,0:16:30.32,0:16:32.78,Default,,0,0,0,,Бұл жерде өте ыстық.
Dialogue: 0,0:16:35.70,0:16:39.79,Default,,0,0,0,,А... бұл жерде ыстық емес.
Dialogue: 0,0:16:39.87,0:16:41.95,Default,,0,0,0,,Бұл әлі де Құдай патшалығы ма?
Dialogue: 0,0:16:42.04,0:16:45.29,Default,,0,0,0,,Иә, бұл су.
Dialogue: 0,0:16:48.09,0:16:49.67,Default,,0,0,0,,Суық!
Dialogue: 0,0:16:51.88,0:16:54.80,Default,,0,0,0,,Ең алдымен көмегіңіз үшін рахмет.
Dialogue: 0,0:16:54.88,0:16:58.80,Default,,0,0,0,,Мен осылай өлсем, бәрі бітер еді.
Dialogue: 0,0:16:58.89,0:17:02.02,Default,,0,0,0,,Менің атым Бес Алға Зенген
Dialogue: 0,0:17:02.10,0:17:03.64,Default,,0,0,0,,Анкажи княздігінің мырзасы
Dialogue: 0,0:17:03.73,0:17:06.06,Default,,0,0,0,,Ландзи Форвард, Лорд Зенгеннің ұлы.
Dialogue: 0,0:17:06.15,0:17:07.94,Default,,0,0,0,,Анкаджи княздігі туралы не деуге болады?
Dialogue: 0,0:17:08.02,0:17:13.11,Default,,0,0,0,,Бұл теңіздегі Элисен қаласынан теңіз өнімдерін тасымалдаудың негізгі нүктесі.
Dialogue: 0,0:17:13.19,0:17:16.20,Default,,0,0,0,,Ерісен – Мюу туып өскен қала.
Dialogue: 0,0:17:16.28,0:17:18.57,Default,,0,0,0,,Анам Мюді күтіп отыр.
Dialogue: 0,0:17:18.66,0:17:21.29,Default,,0,0,0,,Ұстаз, Анкаджи туралы айту.
Dialogue: 0,0:17:21.37,0:17:23.95,Default,,0,0,0,,Біз тоқтағалы тұрған қала
Dialogue: 0,0:17:24.04,0:17:25.08,Default,,0,0,0,,Иә
Dialogue: 0,0:17:25.71,0:17:28.79,Default,,0,0,0,,Бұл қалада бір жамандық болып жатқан сияқты.
Dialogue: 0,0:17:28.88,0:17:31.30,Default,,0,0,0,,Толығырақ айтып бере аласыз ба?
Dialogue: 0,0:17:32.21,0:17:37.18,Default,,0,0,0,,Бірнеше күн бұрын Анкаджиде бірнеше адамның қызуы көтерілді.
Dialogue: 0,0:17:37.26,0:17:41.56,Default,,0,0,0,,Ауыз судың құрамындағы сиқырлы күшті жабайы жіберетін токсин.
Dialogue: 0,0:17:41.64,0:17:43.68,Default,,0,0,0,,Оазистің ластануы себеп болды.
Dialogue: 0,0:17:43.77,0:17:47.81,Default,,0,0,0,,Қауіпсіздікті қамтамасыз ету және басқару мұқият және мұқият
Dialogue: 0,0:17:47.90,0:17:51.19,Default,,0,0,0,,Бірақ қайда, қалай және кім...
Dialogue: 0,0:17:51.90,0:17:55.40,Default,,0,0,0,,Бірақ бұл емдеу әдістері мүлдем жоқ дегенді білдірмейді.
Dialogue: 0,0:17:55.49,0:17:58.57,Default,,0,0,0,,Бұл әдіс Шизуинсеки деп аталатын кенді қажет етеді.
Dialogue: 0,0:17:59.49,0:18:03.41,Default,,0,0,0,,Шизуин тасы сиқырлы күштің белсендіруін тыныштандыратын әсерге ие.
Dialogue: 0,0:18:03.49,0:18:07.21,Default,,0,0,0,,Бұл Грюен Ұлы жанартауынан аз мөлшерде жиналатын бағалы кен.
Dialogue: 0,0:18:07.29,0:18:09.46,Default,,0,0,0,,Ах, Груен жанартауы...
Dialogue: 0,0:18:10.17,0:18:13.96,Default,,0,0,0,,Бірақ Анкаджидің авантюристері ауырып қалды.
Dialogue: 0,0:18:14.71,0:18:19.76,Default,,0,0,0,,Жартылай шытырманшы үлкен жанартауды орап жатқан құмды дауылдан да өте алмайды.
Dialogue: 0,0:18:19.84,0:18:21.97,Default,,0,0,0,,Осыншама қабілеті бар адамдар болса да
Dialogue: 0,0:18:22.05,0:18:25.89,Default,,0,0,0,,Қауіпсіз су қоры айтарлықтай жеткіліксіз болған қазіргі жағдайда...
Dialogue: 0,0:18:25.97,0:18:30.27,Default,,0,0,0,,Қысқасы, көмекке шақыруға бардың да, құладың.
Dialogue: 0,0:18:30.35,0:18:32.23,Default,,0,0,0,,Анкаджи ақыры қауіпті
Dialogue: 0,0:18:33.19,0:18:35.40,Default,,0,0,0,,Оазисті біреу тазартты
Dialogue: 0,0:18:35.48,0:18:39.40,Default,,0,0,0,,Ұлы Груен жанартауынан Шизуин тасын қайтарған дұрыс емес пе?
Dialogue: 0,0:18:42.07,0:18:43.91,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:18:43.99,0:18:47.83,Default,,0,0,0,,Сіз, алтын дәрежелі авантюристер, сіздің құдайыңыз.
Dialogue: 0,0:18:47.91,0:18:50.04,Default,,0,0,0,,Бұл Құдайдың тәртібі ме?
Dialogue: 0,0:18:50.71,0:18:53.13,Default,,0,0,0,,Бізге құдайларды жібер...
Dialogue: 0,0:18:53.21,0:18:54.29,Default,,0,0,0,,Құдай
Dialogue: 0,0:18:55.00,0:18:58.13,Default,,0,0,0,,Саған... жоқ, саған.
Dialogue: 0,0:18:58.22,0:19:01.84,Default,,0,0,0,,Мен Анкаджи княздігінің иесі атынан ресми өтініш жасағым келеді.
Dialogue: 0,0:19:03.14,0:19:05.85,Default,,0,0,0,,Маған күш-қуатыңызды беріңізші.
Dialogue: 0,0:19:13.31,0:19:16.61,Default,,0,0,0,,Әке, маған көмектеспейсіз бе?
Dialogue: 0,0:19:17.78,0:19:18.86,Default,,0,0,0,,Мью
Dialogue: 0,0:19:21.78,0:19:25.49,Default,,0,0,0,,Мен бәрібір Анкаджиге тоқтауды жоспарлап едім.
Dialogue: 0,0:19:25.58,0:19:26.87,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:19:26.95,0:19:28.20,Default,,0,0,0,,Хаджиме-кун
Dialogue: 0,0:19:28.29,0:19:31.04,Default,,0,0,0,,Мен қайтадан бос емес сияқтымын.
Dialogue: 0,0:19:31.12,0:19:32.96,Default,,0,0,0,,Олай болса асығайық
Dialogue: 0,0:19:33.04,0:19:34.75,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:36.13,0:19:40.01,Default,,0,0,0,,Ұлы жанартаудан Шизуин тасын жинауды жалғастыруларыңызды қалаймын.
Dialogue: 0,0:19:40.09,0:19:42.13,Default,,0,0,0,,Суды қамтамасыз ету үшін алдымен патша астанасына барамыз...
Dialogue: 0,0:19:42.22,0:19:44.47,Default,,0,0,0,,Король астанасына барудың қажеті жоқ
Dialogue: 0,0:19:45.18,0:19:47.60,Default,,0,0,0,,Өйткені біз қандай да бір жолмен суды қорғай аламыз.
Dialogue: 0,0:19:47.68,0:19:49.35,Default,,0,0,0,,Анкаджиге дейін жалғастырыңыз
Dialogue: 0,0:19:50.39,0:19:51.60,Default,,0,0,0,,Мен не істей аламын?
Dialogue: 0,0:19:51.69,0:19:53.48,Default,,0,0,0,,Солай емес пе? Юэ
Dialogue: 0,0:19:53.56,0:19:55.48,Default,,0,0,0,,Хаджиме
Dialogue: 0,0:19:55.56,0:19:59.23,Default,,0,0,0,,Бұл! Тек екеумізге арналған кеңістік құруды тоқтата аласыз ба?
Dialogue: 0,0:19:59.32,0:20:03.20,Default,,0,0,0,,Дұрыс, ылғи екеуің ғана қулық жасайсыңдар.
Dialogue: 0,0:20:03.28,0:20:06.24,Default,,0,0,0,,Қандай жасырын!
Dialogue: 0,0:20:08.29,0:20:11.29,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:20:16.84,0:20:19.63,Default,,0,0,0,,Фрид мырза, Каттлеяға шабуыл жасалды.
Dialogue: 0,0:20:19.71,0:20:20.88,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:20:22.26,0:20:23.26,Default,,0,0,0,,Михаил?
Dialogue: 0,0:20:23.34,0:20:26.93,Default,,0,0,0,,Каттлея өлген жоқ.
Dialogue: 0,0:20:27.01,0:20:30.02,Default,,0,0,0,,Оның қасында қаншама құбыжықтар бар...
Dialogue: 0,0:20:30.10,0:20:33.10,Default,,0,0,0,,Ур қаласындағы миссия да сәтсіз аяқталды.
Dialogue: 0,0:20:33.19,0:20:35.44,Default,,0,0,0,,Ур ше?
Dialogue: 0,0:20:35.52,0:20:37.40,Default,,0,0,0,,Операция сәтті аяқталды.
Dialogue: 0,0:20:37.48,0:20:42.11,Default,,0,0,0,,60 000 құбыжық Ур қаласы бойынша құнарлылық құдайын басып алуы керек еді.
Dialogue: 0,0:20:42.19,0:20:45.11,Default,,0,0,0,,Бірақ ол тәртіпсіздіктерге ұшырады.
Dialogue: 0,0:20:45.20,0:20:46.99,Default,,0,0,0,,Тұрақты емес пе?
Dialogue: 0,0:20:47.07,0:20:50.58,Default,,0,0,0,,Құбыжықтар әскерін небәрі төрт адам басып алды.
Dialogue: 0,0:20:50.66,0:20:53.71,Default,,0,0,0,,Урейт тапсырма кезінде қолынан айырылды.
Dialogue: 0,0:20:54.29,0:20:56.38,Default,,0,0,0,,Ақымақ... тіпті Урейт те.
Dialogue: 0,0:20:56.46,0:20:59.50,Default,,0,0,0,,Төртеуі Ур қаласынан кеткен соң.
Dialogue: 0,0:20:59.59,0:21:02.34,Default,,0,0,0,,Шамасы, ол Оркус Ұлы лабиринтіне жүгірді.
Dialogue: 0,0:21:02.42,0:21:05.18,Default,,0,0,0,,Сол кезде Каттлея батырмен байланысқа шықты.
Dialogue: 0,0:21:05.26,0:21:08.43,Default,,0,0,0,,Сонда Кэттля оларға...
Dialogue: 0,0:21:08.51,0:21:10.93,Default,,0,0,0,,Жау сен ойлағаннан да күшті.
Dialogue: 0,0:21:11.01,0:21:13.18,Default,,0,0,0,,Мен үлкен жанартауға қарай бет алдым.
Dialogue: 0,0:21:13.27,0:21:17.73,Default,,0,0,0,,Құдай дәуірінің жаңа сиқырын алыңыз және одан да күшті болыңыз.
Dialogue: 0,0:21:17.81,0:21:19.19,Default,,0,0,0,,Кез келген бағамен
Dialogue: 0,0:21:19.82,0:21:21.19,Default,,0,0,0,,Мистер Фред
Dialogue: 0,0:21:21.28,0:21:23.61,Default,,0,0,0,,үшін Мәртебелі үшін
Dialogue: 0,0:21:23.69,0:21:26.61,Default,,0,0,0,,Ал біз сенетін Құдай үшін
Dialogue: 0,0:21:26.70,0:21:30.33,Default,,0,0,0,,Мен сені жоқта қалдырамын, Михаил, соғыс уақыты жақын.
Dialogue: 0,0:21:31.16,0:21:33.79,Default,,0,0,0,,Каттлеяның жаулары әрқашан жеңіледі
Dialogue: 0,0:21:37.37,0:21:39.25,Default,,0,0,0,,Құдайым маған берді —
Dialogue: 0,0:21:39.33,0:21:43.30,Default,,0,0,0,,Біздің барлық асыл миссияларымызды жою құны.
Dialogue: 0,0:21:43.38,0:21:46.30,Default,,0,0,0,,Қымбат болады, әлі көрмеген жау.
Dialogue: 0,0:21:47.13,0:21:51.31,Default,,0,0,0,,Менімен бетпе-бет келген сәт сенің соңың болмақ.
Dialogue: 0,0:21:51.39,0:21:55.31,Default,,0,0,0,,Пұтқа табынушылардың бұл дүниеде өмір сүруге құқығы жоқ.
Dialogue: 0,0:21:55.93,0:21:57.19,Default,,0,0,0,,Тұрақты емес
Dialogue: 0,0:22:04.03,0:22:09.03,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.94,0:23:33.95,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.99,0:23:38.54,Default,,0,0,0,,Келесі жолы «Қатты жарық»
Dialogue: 0,0:23:40.04,0:23:46.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
