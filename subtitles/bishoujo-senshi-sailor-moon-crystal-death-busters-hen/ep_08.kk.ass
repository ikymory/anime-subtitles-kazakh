Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.79,0:00:05.25,Default,,0,0,0,,Мен Циплин және Пети Лолмын
Dialogue: 0,0:00:05.38,0:00:07.34,Default,,0,0,0,,Екі адам бір бақсы
Dialogue: 0,0:00:07.46,0:00:08.38,Default,,0,0,0,,(Нацуо) Қоғам оның анама және ағаларына не істегенін білмейді—
Dialogue: 0,0:00:08.55,0:00:09.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:09.59,0:00:11.38,Default,,0,0,0,,Taiolon Crystal қайда орналасқан?
Dialogue: 0,0:00:11.51,0:00:14.01,Default,,0,0,0,,Бұл жақын жердегі қуат па? циплин
Dialogue: 0,0:00:14.72,0:00:18.18,Default,,0,0,0,,Бәрің, ояныңдар! Ұрыспа!
Dialogue: 0,0:00:20.27,0:00:23.98,Default,,0,0,0,,Қызғылт қант…
Dialogue: 0,0:00:24.10,0:00:26.69,Default,,0,0,0,,Инфаркт!
Dialogue: 0,0:00:28.36,0:00:30.15,Default,,0,0,0,,Кедергі жасамаңыз!
Dialogue: 0,0:00:30.32,0:00:32.03,Default,,0,0,0,,Иә! (Чиби Мун) Уу...
Dialogue: 0,0:00:32.94,0:00:35.20,Default,,0,0,0,,Стокседо маскасы! Чиби Мун!
Dialogue: 0,0:00:36.28,0:00:37.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:37.95,0:00:39.99,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:00:40.83,0:00:43.54,Default,,0,0,0,,Неліктен біз соғысуымыз керек?
Dialogue: 0,0:00:44.91,0:00:48.17,Default,,0,0,0,,Әркімнің жүрегінде бір-біріне дұшпан болғаны ма?
Dialogue: 0,0:00:49.25,0:00:50.09,Default,,0,0,0,,Бұл Музан мырза…
Dialogue: 0,0:00:50.67,0:00:53.42,Default,,0,0,0,,Үш адам бізге көмектесті.
Dialogue: 0,0:00:53.59,0:00:55.59,Default,,0,0,0,,Ол мені үнемі бақылап отырды.
Dialogue: 0,0:00:56.59,0:00:59.05,Default,,0,0,0,,Маңызды нәрсені қорғау үшін күресіңіз
Dialogue: 0,0:00:59.76,0:01:03.10,Default,,0,0,0,,Біз де сол мақсат үшін күресуіміз керек!
Dialogue: 0,0:01:05.48,0:01:06.44,Default,,0,0,0,,Әй!
Dialogue: 0,0:01:07.44,0:01:08.27,Default,,0,0,0,,Әй!
Dialogue: 0,0:01:08.56,0:01:09.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:10.40,0:01:12.40,Default,,0,0,0,,Бір жүрекпен...
Dialogue: 0,0:01:20.33,0:01:21.99,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:22.74,0:01:23.95,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:01:24.45,0:01:26.46,Default,,0,0,0,,Маған күшіңді бер!
Dialogue: 0,0:01:27.96,0:01:33.30,Default,,0,0,0,,♪〜
Dialogue: 0,0:02:51.83,0:02:57.59,Default,,0,0,0,,〜♪
Dialogue: 0,0:03:06.31,0:03:09.73,Default,,0,0,0,,үшінның жүрегін біріктіру...
Dialogue: 0,0:03:10.52,0:03:12.77,Default,,0,0,0,,Қасиетті Граил жарқырап тұр!
Dialogue: 0,0:03:13.23,0:03:14.65,Default,,0,0,0,,Сейлор Мун!?
Dialogue: 0,0:03:19.03,0:03:19.90,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:03:21.70,0:03:22.53,Default,,0,0,0,,Ах…
Dialogue: 0,0:03:23.24,0:03:25.70,Default,,0,0,0,,Ах…
Dialogue: 0,0:03:30.25,0:03:32.75,Default,,0,0,0,,Бір жүрекпен күресу - бұл...
Dialogue: 0,0:03:32.87,0:03:35.08,Default,,0,0,0,,Біз теңізші Сеншиміз.
Dialogue: 0,0:03:35.88,0:03:37.17,Default,,0,0,0,,Сейлор Мун...
Dialogue: 0,0:03:37.63,0:03:40.09,Default,,0,0,0,,Ол бізді шақырып жатыр...
Dialogue: 0,0:03:42.68,0:03:43.76,Default,,0,0,0,,Ах…
Dialogue: 0,0:03:45.80,0:03:49.47,Default,,0,0,0,,Менің бойтұмарым терең аква айна...
Dialogue: 0,0:03:52.14,0:03:53.81,Default,,0,0,0,,Ха!? Жоқ...
Dialogue: 0,0:03:56.61,0:03:59.98,Default,,0,0,0,,Менің бойтұмар ғарыш семсерім...
Dialogue: 0,0:04:02.40,0:04:03.49,Default,,0,0,0,,Ах…
Dialogue: 0,0:04:07.58,0:04:11.00,Default,,0,0,0,,Менің гранат тұмарым...
Dialogue: 0,0:04:12.41,0:04:14.04,Default,,0,0,0,,Резонанс басталды!?
Dialogue: 0,0:04:17.67,0:04:20.46,Default,,0,0,0,,Сейлор Мунға күш!
Dialogue: 0,0:04:21.59,0:04:22.72,Default,,0,0,0,,Күш!
Dialogue: 0,0:04:23.80,0:04:25.05,Default,,0,0,0,,Күш!
Dialogue: 0,0:04:33.98,0:04:35.81,Default,,0,0,0,,Ах!? Сол жарық...
Dialogue: 0,0:04:48.07,0:04:50.87,Default,,0,0,0,,Ай дағдарысы!
Dialogue: 0,0:04:50.99,0:04:53.29,Default,,0,0,0,,Макияж!
Dialogue: 0,0:05:14.31,0:05:16.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:17.19,0:05:18.02,Default,,0,0,0,,Ах…
Dialogue: 0,0:05:21.65,0:05:22.98,Default,,0,0,0,,брошь...
Dialogue: 0,0:05:23.28,0:05:25.45,Default,,0,0,0,,Жүрекке өзгерді...
Dialogue: 0,0:05:28.95,0:05:30.83,Default,,0,0,0,,Сейлор Мун?
Dialogue: 0,0:05:32.83,0:05:35.12,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:05:35.91,0:05:38.04,Default,,0,0,0,,Супер Сейлор Мун!
Dialogue: 0,0:05:39.83,0:05:43.38,Default,,0,0,0,,Аты аңызға айналған жауынгер Сейлор Мун жеңілмейді
Dialogue: 0,0:05:44.38,0:05:47.97,Default,,0,0,0,,Анашым! Сейлор Мун жеңілмейтін болды!
Dialogue: 0,0:05:48.09,0:05:48.97,Default,,0,0,0,,Анам және
Dialogue: 0,0:05:49.09,0:05:52.01,Default,,0,0,0,,Осы Кристалл Токионы не құтқарды?
Dialogue: 0,0:05:53.10,0:05:57.48,Default,,0,0,0,,Мен міндетті түрде Сейлор Мун сияқты жауынгер боламын!
Dialogue: 0,0:05:57.60,0:05:59.56,Default,,0,0,0,,Жаттығуларыңызға сәттілік.
Dialogue: 0,0:05:59.69,0:06:01.23,Default,,0,0,0,,Кішкентай ханым
Dialogue: 0,0:06:01.65,0:06:04.73,Default,,0,0,0,,Ал өз көздеріңмен мұқият қараңдар
Dialogue: 0,0:06:05.19,0:06:06.61,Default,,0,0,0,,Бір күні сен—
Dialogue: 0,0:06:06.74,0:06:10.03,Default,,0,0,0,,Сіз одан да күшті Сейлор Мунды кездестіресіз.
Dialogue: 0,0:06:10.16,0:06:12.28,Default,,0,0,0,,Супер Сейлор Мунға
Dialogue: 0,0:06:12.74,0:06:15.20,Default,,0,0,0,,Супер Сейлор Мун?
Dialogue: 0,0:06:17.16,0:06:19.46,Default,,0,0,0,,Супер Сейлор Мун!?
Dialogue: 0,0:06:21.75,0:06:22.54,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:06:22.88,0:06:24.67,Default,,0,0,0,,Сейлор Мун…
Dialogue: 0,0:06:24.84,0:06:26.46,Default,,0,0,0,,Қуат қосылды!?
Dialogue: 0,0:06:28.55,0:06:32.72,Default,,0,0,0,,О! Қандай үлкен энергия...
Dialogue: 0,0:06:32.85,0:06:36.52,Default,,0,0,0,,Осы күштің ортасында болып, ешқандай зиян көрмейсіз бе?
Dialogue: 0,0:06:37.77,0:06:40.85,Default,,0,0,0,,Сенгісіз Сейлор Мун
Dialogue: 0,0:06:40.98,0:06:43.11,Default,,0,0,0,,Бұл қандай күш...
Dialogue: 0,0:06:43.27,0:06:48.95,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:06:50.40,0:06:53.53,Default,,0,0,0,,Шықпа... Болма...
Dialogue: 0,0:06:53.95,0:06:56.87,Default,,0,0,0,,Перғауын 90) Қандай жарық құйын
Dialogue: 0,0:06:57.37,0:07:00.50,Default,,0,0,0,,Қандай үлкен аура!
Dialogue: 0,0:07:01.71,0:07:06.13,Default,,0,0,0,,Аспанға еніп жатқан қуат діңін көріп тұрмын.
Dialogue: 0,0:07:07.26,0:07:09.38,Default,,0,0,0,,Бірде менің туған планетамда—
Dialogue: 0,0:07:09.51,0:07:14.68,Default,,0,0,0,,Тайолон кристалы ең қуатты болғанда
Dialogue: 0,0:07:15.18,0:07:18.39,Default,,0,0,0,,Он мың есе артық қуат
Dialogue: 0,0:07:19.14,0:07:21.19,Default,,0,0,0,,Қандай күш!?
Dialogue: 0,0:07:21.77,0:07:26.52,Default,,0,0,0,,Бұл бәріне күш береді!
Dialogue: 0,0:07:26.65,0:07:28.44,Default,,0,0,0,,Уф! Уууу...
Dialogue: 0,0:07:30.57,0:07:33.95,Default,,0,0,0,,Бұл фантом күміс кристалының күші.
Dialogue: 0,0:07:34.07,0:07:36.28,Default,,0,0,0,,Ұстаз перғауын90
Dialogue: 0,0:07:36.87,0:07:38.83,Default,,0,0,0,,Ухухуху...
Dialogue: 0,0:07:39.25,0:07:40.91,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:07:42.08,0:07:44.50,Default,,0,0,0,,Сейлор Мун) Мен енді алданбаймын.
Dialogue: 0,0:07:45.54,0:07:47.96,Default,,0,0,0,,Енді тартынбаңыз!
Dialogue: 0,0:07:58.10,0:08:04.35,Default,,0,0,0,,Кемпірқосақ айдың жүрегі ауырады!
Dialogue: 0,0:08:06.94,0:08:08.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:08.98,0:08:10.86,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:08:15.32,0:08:16.16,Default,,0,0,0,,(Жарылған дыбыс)
Dialogue: 0,0:08:16.32,0:08:17.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:18.37,0:08:20.45,Default,,0,0,0,,Мен, Сейлор Мун...
Dialogue: 0,0:08:20.58,0:08:23.66,Default,,0,0,0,,Менің қымбатты қызметшім Сиқыршылар 5-
Dialogue: 0,0:08:23.79,0:08:28.50,Default,,0,0,0,,Соңғы және ең ұлы сиқыршылар Шиприн мен Петитроллды жеңу...
Dialogue: 0,0:08:28.96,0:08:33.63,Default,,0,0,0,,Бөтен заттарды тез жою және шебердің серіктесі болу.
Dialogue: 0,0:08:33.76,0:08:38.01,Default,,0,0,0,,Біз жаңа әлеміміздің басталуын осы жерден көруіміз керек еді...
Dialogue: 0,0:08:39.10,0:08:42.27,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:08:42.43,0:08:46.15,Default,,0,0,0,,Сіз мистика сияқты, шебердің серіктесісіз бе?
Dialogue: 0,0:08:46.27,0:08:48.23,Default,,0,0,0,,Мен абдырап қалдым...
Dialogue: 0,0:08:48.73,0:08:50.07,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:08:50.19,0:08:52.19,Default,,0,0,0,,Енді мен...
Dialogue: 0,0:08:52.32,0:08:55.61,Default,,0,0,0,,Уф! Маңдайым сынды...
Dialogue: 0,0:08:55.74,0:08:57.11,Default,,0,0,0,,Уууу…
Dialogue: 0,0:08:58.24,0:08:59.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:00.54,0:09:03.62,Default,,0,0,0,,Мен қуат қостым!?
Dialogue: 0,0:09:03.79,0:09:05.96,Default,,0,0,0,,Супер Сейлор Мун!
Dialogue: 0,0:09:06.12,0:09:10.42,Default,,0,0,0,,Бұл аңызға айналған Қасиетті Граил Ай тостағанының күші.
Dialogue: 0,0:09:11.17,0:09:13.67,Default,,0,0,0,,Бұл әркімнен келген күш еді.
Dialogue: 0,0:09:13.80,0:09:17.30,Default,,0,0,0,,Қасиетті Граилдан маған не төгілді
Dialogue: 0,0:09:17.59,0:09:19.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:20.43,0:09:24.02,Default,,0,0,0,,Тұмар Сейлор Мунға күш береді...
Dialogue: 0,0:09:25.81,0:09:29.40,Default,,0,0,0,,Тұмардың алғаш рет осылай жаңғыруы.
Dialogue: 0,0:09:30.40,0:09:34.65,Default,,0,0,0,,Біздің бойтұмардың мұндай күшке ие екеніне сене алар емеспін...
Dialogue: 0,0:09:35.53,0:09:39.20,Default,,0,0,0,,Ақымақ! Тұмар - оятудың кілті...
Dialogue: 0,0:09:39.32,0:09:40.28,Default,,0,0,0,,Уран!
Dialogue: 0,0:09:40.41,0:09:43.49,Default,,0,0,0,,«үшінның жүрегі бір болсын» деп дұға еттім
Dialogue: 0,0:09:45.83,0:09:47.79,Default,,0,0,0,,«Маған күшіңді бер»
Dialogue: 0,0:09:48.42,0:09:49.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:51.13,0:09:54.71,Default,,0,0,0,,Бір сәтке біз міндетті түрде қосылдық.
Dialogue: 0,0:09:55.55,0:09:58.68,Default,,0,0,0,,«Мен бәріне көмектесіп, жауды жеңгім келеді»
Dialogue: 0,0:09:59.22,0:10:01.39,Default,,0,0,0,,Сезім де солай болды
Dialogue: 0,0:10:02.01,0:10:05.27,Default,,0,0,0,,Ал біз, Мун Чалис...
Dialogue: 0,0:10:05.39,0:10:08.02,Default,,0,0,0,,Мен супер Сейлор Мунды шақырдым
Dialogue: 0,0:10:08.85,0:10:11.73,Default,,0,0,0,,Біз сондай бірлікте бола аламыз
Dialogue: 0,0:10:12.27,0:10:14.94,Default,,0,0,0,,Өйткені олар бірдей Теңізші Сенши.
Dialogue: 0,0:10:15.44,0:10:17.74,Default,,0,0,0,,Біз доспыз!
Dialogue: 0,0:10:19.66,0:10:20.82,Default,,0,0,0,,Серіктер…
Dialogue: 0,0:10:20.95,0:10:22.66,Default,,0,0,0,,Супер Сейлор Мун…
Dialogue: 0,0:10:23.99,0:10:26.58,Default,,0,0,0,,Қанша күрессек те,
Dialogue: 0,0:10:26.70,0:10:31.04,Default,,0,0,0,,Тұмар соншалықты мойынсұнушылықпен Сейлор Мунға өз күшін берді.
Dialogue: 0,0:10:32.59,0:10:37.42,Default,,0,0,0,,Тұмар: "Сейлор Мунға шындықты айт" дейді
Dialogue: 0,0:10:39.43,0:10:40.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:48.85,0:10:53.40,Default,,0,0,0,,Ой... Уран бөлмесі Шиприннің шабуылы әбігерге түсті.
Dialogue: 0,0:10:54.02,0:10:56.98,Default,,0,0,0,,Мен шыны шотқа қарауға қорқамын...
Dialogue: 0,0:10:57.11,0:11:00.45,Default,,0,0,0,,Plus Сынған жиһазды жөндеу ақысы
Dialogue: 0,0:11:00.57,0:11:02.45,Default,,0,0,0,,Қанша ақша болса да, ол ешқашан жетпейді
Dialogue: 0,0:11:02.57,0:11:03.41,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:11:03.57,0:11:05.33,Default,,0,0,0,,Бұл қымбат пәтер.
Dialogue: 0,0:11:05.45,0:11:07.83,Default,,0,0,0,,Мұндағы жалдау ақысы 1 миллион иен.
Dialogue: 0,0:11:07.95,0:11:09.79,Default,,0,0,0,,Хя... 1 миллион иен!?
Dialogue: 0,0:11:09.91,0:11:12.04,Default,,0,0,0,,Жоқ... не істеп жатырсың? сол ақша
Dialogue: 0,0:11:12.67,0:11:16.67,Default,,0,0,0,,Бізде меценат бар, сондықтан ақшаға алаңдамаймыз.
Dialogue: 0,0:11:16.80,0:11:19.13,Default,,0,0,0,,Патрон? (Нептун) Харука...
Dialogue: 0,0:11:19.30,0:11:20.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:20.30,0:11:21.47,Default,,0,0,0,,Супер Сейлор Мун
Dialogue: 0,0:11:21.59,0:11:22.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:22.64,0:11:24.55,Default,,0,0,0,,Ханшайым жоқ
Dialogue: 0,0:11:24.85,0:11:29.64,Default,,0,0,0,,Біз бұл үш бойтұмардың әрекетін көрдік—
Dialogue: 0,0:11:29.77,0:11:32.98,Default,,0,0,0,,Бұл тек бір рет болды.
Dialogue: 0,0:11:34.40,0:11:36.02,Default,,0,0,0,,Алайда, осы жағдайда біз әлі де кісі өлтірулердің қалай жасалып жатқанын білмейміз.
Dialogue: 0,0:11:36.73,0:11:41.07,Default,,0,0,0,,Бір кездері Күміс мыңжылдық жойылған кезде.
Dialogue: 0,0:11:41.20,0:11:42.78,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:45.70,0:11:48.66,Default,,0,0,0,,Сол кезде біз—
Dialogue: 0,0:11:48.83,0:11:52.71,Default,,0,0,0,,Сізге өз аумағыңыздан шығуға рұқсат жоқ.
Dialogue: 0,0:11:52.83,0:11:56.46,Default,,0,0,0,,Менің қолымнан келгені алыстан қарау болды.
Dialogue: 0,0:11:57.80,0:11:59.51,Default,,0,0,0,,Алыстан –
Dialogue: 0,0:11:59.63,0:12:03.93,Default,,0,0,0,,Отан-ана Күміс мыңжылдықтың соңғы сәттері...
Dialogue: 0,0:12:05.47,0:12:09.10,Default,,0,0,0,,Жоқ... ол туралы айтпа.
Dialogue: 0,0:12:09.52,0:12:10.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:11.68,0:12:14.06,Default,,0,0,0,,Менің жүрегім сыздап кетті...
Dialogue: 0,0:12:14.98,0:12:16.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:16.48,0:12:18.15,Default,,0,0,0,,Сол кезде... (С Ай) Ха...
Dialogue: 0,0:12:19.36,0:12:20.94,Default,,0,0,0,,Бізде—
Dialogue: 0,0:12:21.07,0:12:24.74,Default,,0,0,0,,Сыртқы күн жүйесіндегі ең күшті қару — бойтұмар —
Dialogue: 0,0:12:25.20,0:12:27.66,Default,,0,0,0,,Мен бұрын-соңды көрмеген резонанспен...
Dialogue: 0,0:12:31.41,0:12:33.66,Default,,0,0,0,,Біз бірге жиналдық
Dialogue: 0,0:12:34.17,0:12:37.79,Default,,0,0,0,,Және әдемі жарқыраған бойтұмар
Dialogue: 0,0:12:38.34,0:12:39.88,Default,,0,0,0,,«Табу жұлдызынан»
Dialogue: 0,0:12:40.05,0:12:44.93,Default,,0,0,0,,Мені оятпа. Сіз соңғы жауынгерді шақырдыңыз.
Dialogue: 0,0:13:04.45,0:13:09.16,Default,,0,0,0,,Үнсіз жауынгер, оның қамқоршысы Сатурн, жойылу планетасы.
Dialogue: 0,0:13:09.78,0:13:11.66,Default,,0,0,0,,Теңізші Сатурн
Dialogue: 0,0:13:14.29,0:13:18.17,Default,,0,0,0,,Сол кезде мен «ақырзаманның» келгенін білдім.
Dialogue: 0,0:13:25.84,0:13:27.18,Default,,0,0,0,,Біз—
Dialogue: 0,0:13:27.30,0:13:30.64,Default,,0,0,0,,Теңізші Сатурнның «Тыныштық глейвиі» бұл...
Dialogue: 0,0:13:30.80,0:13:32.97,Default,,0,0,0,,Сіз ақырын төмен қарай бұрылғанда...
Dialogue: 0,0:13:34.85,0:13:36.69,Default,,0,0,0,,Күміс мыңжылдық...
Dialogue: 0,0:13:36.81,0:13:40.81,Default,,0,0,0,,Мен олардың үнсіз өліп жатқанын көріп, шаршадым.
Dialogue: 0,0:13:44.07,0:13:45.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:46.90,0:13:49.82,Default,,0,0,0,,Үш бойтұмар сап түзегенде...
Dialogue: 0,0:13:50.70,0:13:53.66,Default,,0,0,0,,Теңізші Сатурнды ояту кілті ретінде
Dialogue: 0,0:13:53.79,0:13:55.75,Default,,0,0,0,,Шынайы белсендіру
Dialogue: 0,0:13:56.41,0:14:01.42,Default,,0,0,0,,Ал біз үшеуміз сол кілттің қамқоршысымыз.
Dialogue: 0,0:14:02.46,0:14:06.88,Default,,0,0,0,,Біз жиналып, үш бойтұмар бірге келгенде
Dialogue: 0,0:14:07.01,0:14:10.43,Default,,0,0,0,,Теңізші Сатурнның ояну уақыты
Dialogue: 0,0:14:10.89,0:14:14.60,Default,,0,0,0,,Теңізші Сатурн оянғанда...
Dialogue: 0,0:14:15.60,0:14:19.73,Default,,0,0,0,,Бұл дүниенің ақыры...
Dialogue: 0,0:14:20.56,0:14:23.82,Default,,0,0,0,,Ха... Жоюға апаратын үш бойтұмар
Dialogue: 0,0:14:24.94,0:14:26.82,Default,,0,0,0,,Мынаны айтқыңыз келді...
Dialogue: 0,0:14:27.32,0:14:28.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:29.20,0:14:32.70,Default,,0,0,0,,Біз қорғауға тиісті аумақ алыс.
Dialogue: 0,0:14:32.83,0:14:36.25,Default,,0,0,0,,Әдетте біз ешқашан кездеспейтін едік...
Dialogue: 0,0:14:36.70,0:14:40.42,Default,,0,0,0,,Осылайша мен осы планетада адам болып реинкарнацияландым.
Dialogue: 0,0:14:40.54,0:14:42.50,Default,,0,0,0,,Біз тағы да кездестік
Dialogue: 0,0:14:43.63,0:14:44.55,Default,,0,0,0,,Және—
Dialogue: 0,0:14:45.13,0:14:47.76,Default,,0,0,0,,Жоюшы жауынгердің реинкарнациясы...
Dialogue: 0,0:14:49.55,0:14:50.97,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:51.14,0:14:53.05,Default,,0,0,0,,Ах... (Ай) Ешқандай емес...
Dialogue: 0,0:14:54.05,0:14:56.97,Default,,0,0,0,,Хотару-чан...?
Dialogue: 0,0:14:59.73,0:15:02.40,Default,,0,0,0,,Хотару-чан теңізші Сатурн ма?
Dialogue: 0,0:15:04.27,0:15:07.94,Default,,0,0,0,,Оян... Жина...
Dialogue: 0,0:15:08.36,0:15:10.45,Default,,0,0,0,,Үш бойтұмар
Dialogue: 0,0:15:10.95,0:15:12.99,Default,,0,0,0,,Бағыттаушы шам
Dialogue: 0,0:15:14.03,0:15:15.91,Default,,0,0,0,,Бұл жойылудың басы!
Dialogue: 0,0:15:18.33,0:15:22.37,Default,,0,0,0,,Ха... Сатурнның жаны Тұмарды шақырды!?
Dialogue: 0,0:15:22.75,0:15:26.17,Default,,0,0,0,,Теңізші Сатурнның оянатын уақыты жақын
Dialogue: 0,0:15:26.96,0:15:30.30,Default,,0,0,0,,Оның денесі оны сезіне бастады.
Dialogue: 0,0:15:30.42,0:15:31.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:31.80,0:15:35.51,Default,,0,0,0,,Баршаңызға белгілі, болашақ бар.
Dialogue: 0,0:15:35.64,0:15:37.22,Default,,0,0,0,,Қандай жағдай болмасын—
Dialogue: 0,0:15:37.35,0:15:40.35,Default,,0,0,0,,Мен теңізші Сатурнды оята алмаймын.
Dialogue: 0,0:15:40.85,0:15:42.39,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:15:43.85,0:15:45.52,Default,,0,0,0,,Сол баланы өлтіріңіз
Dialogue: 0,0:15:45.65,0:15:48.73,Default,,0,0,0,,Сатурнды толығымен бекітіңіз.
Dialogue: 0,0:15:49.11,0:15:50.11,Default,,0,0,0,,Иә!?
Dialogue: 0,0:15:50.24,0:15:52.36,Default,,0,0,0,,Бұл өтірік!?
Dialogue: 0,0:15:52.53,0:15:53.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:53.78,0:15:56.12,Default,,0,0,0,,Үш бойтұмар іске қосыла ма, жоқ па...
Dialogue: 0,0:15:56.24,0:15:57.33,Default,,0,0,0,,Мен әлі білмеймін!
Dialogue: 0,0:15:58.16,0:16:00.58,Default,,0,0,0,,Тұмарлар бір-бірімен осылай үндеседі
Dialogue: 0,0:16:00.96,0:16:03.87,Default,,0,0,0,,Супер Сейлор Мунды шақыру мүмкіндігін жіберді
Dialogue: 0,0:16:08.00,0:16:10.67,Default,,0,0,0,,Мен күштің бойымнан ағып жатқанын сезінемін.
Dialogue: 0,0:16:12.68,0:16:16.97,Default,,0,0,0,,Күміс мыңжылдық құлаған кездегідей...
Dialogue: 0,0:16:18.10,0:16:20.72,Default,,0,0,0,,Сатурнды ояту үшін бойтұмар үшін—
Dialogue: 0,0:16:20.85,0:16:23.81,Default,,0,0,0,,Іске қосу уақыты жақын
Dialogue: 0,0:16:24.06,0:16:27.56,Default,,0,0,0,,Сондықтан мені өлтірдің! Басқа жол болуы керек
Dialogue: 0,0:16:27.98,0:16:31.57,Default,,0,0,0,,Біз бас тартпасақ та
Dialogue: 0,0:16:31.69,0:16:35.16,Default,,0,0,0,,Ол баланың денесі ұзаққа бармайды.
Dialogue: 0,0:16:35.28,0:16:37.49,Default,,0,0,0,,Сол қыздың денесін көрдіңіз бе?
Dialogue: 0,0:16:37.62,0:16:39.66,Default,,0,0,0,,Чиби Усаги-чан (Чиби Мун) Ах...
Dialogue: 0,0:16:42.41,0:16:43.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:44.42,0:16:46.33,Default,,0,0,0,,8 жасымда (Чиби Мун) Бақыт...
Dialogue: 0,0:16:46.71,0:16:48.29,Default,,0,0,0,,Жазатайым оқиға салдарынан болған ауыр жарақат
Dialogue: 0,0:16:48.67,0:16:52.51,Default,,0,0,0,,Хотару комадан керемет түрде аман қалды
Dialogue: 0,0:16:53.67,0:16:55.43,Default,,0,0,0,,Ең жақсы миға ие болу—
Dialogue: 0,0:16:56.05,0:17:00.47,Default,,0,0,0,,Профессор Томенің академиядан қуылғаннан кейінгі өмірлік қызметінің жемісі
Dialogue: 0,0:17:01.10,0:17:03.35,Default,,0,0,0,,Адамдар мен машиналарды біріктіру…
Dialogue: 0,0:17:05.10,0:17:07.48,Default,,0,0,0,,Профессор қуыршақ сияқты...
Dialogue: 0,0:17:07.60,0:17:10.61,Default,,0,0,0,,Олар Хотарудың денесін машинаға айналдырды.
Dialogue: 0,0:17:12.48,0:17:16.32,Default,,0,0,0,,Сол баланың кішкентай денесі жалған ғой.
Dialogue: 0,0:17:18.07,0:17:19.87,Default,,0,0,0,,Өмір өткінші...
Dialogue: 0,0:17:20.37,0:17:24.08,Default,,0,0,0,,Көмек берудің жолы жоқ па? Хотару-чан
Dialogue: 0,0:17:24.58,0:17:29.54,Default,,0,0,0,,Қазір баланың денесін құтқарудың бір ғана жолы бар.
Dialogue: 0,0:17:30.59,0:17:32.84,Default,,0,0,0,,Теңізші Сатурн ретіндегі ояну -
Dialogue: 0,0:17:33.21,0:17:35.42,Default,,0,0,0,,Күшті жауынгер болу
Dialogue: 0,0:17:36.97,0:17:39.80,Default,,0,0,0,,Бірақ мен сені олай етуге мәжбүрлей алмаймын...
Dialogue: 0,0:17:39.93,0:17:41.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:42.10,0:17:43.31,Default,,0,0,0,,Ах! Құдай-ай!
Dialogue: 0,0:17:43.64,0:17:45.18,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:17:45.35,0:17:48.81,Default,,0,0,0,,Ол баланы өлтіре алмайсың. үшінн құтқарудың жолы бар!
Dialogue: 0,0:17:48.94,0:17:50.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:50.40,0:17:53.19,Default,,0,0,0,,Сатурн ешқашан оянбауы мүмкін
Dialogue: 0,0:17:53.32,0:17:54.99,Default,,0,0,0,,Өйткені болашақ бар.
Dialogue: 0,0:17:55.82,0:18:00.07,Default,,0,0,0,,Дүние жойылмайды, біз құтқарыламыз.
Dialogue: 0,0:18:00.24,0:18:02.91,Default,,0,0,0,,Мен бәрін сақтай алатыныма сенімдімін...
Dialogue: 0,0:18:03.08,0:18:05.62,Default,,0,0,0,,Сондықтан мені өлтіре алмайсың!
Dialogue: 0,0:18:07.50,0:18:08.33,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:09.83,0:18:11.96,Default,,0,0,0,,Мен мұны айтасыз деп ойладым.
Dialogue: 0,0:18:12.13,0:18:13.25,Default,,0,0,0,,А...
Dialogue: 0,0:18:13.75,0:18:15.21,Default,,0,0,0,,Сонымен, біз
Dialogue: 0,0:18:15.80,0:18:17.88,Default,,0,0,0,,Біз бірге әрекет ете алмаймыз...
Dialogue: 0,0:18:18.22,0:18:20.05,Default,,0,0,0,,Біз дос бола алмаймыз.
Dialogue: 0,0:18:20.97,0:18:25.39,Default,,0,0,0,,Мені жек көру дұрыс емес. Өзіңе жау болғаның дұрыс.
Dialogue: 0,0:18:25.52,0:18:26.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:27.10,0:18:31.90,Default,,0,0,0,,Біз өз миссиямызды орындаймыз және әлемді құтқарамыз
Dialogue: 0,0:18:33.11,0:18:36.24,Default,,0,0,0,,Біз сондай-ақ «Өлім бұзушыларын» жеңеміз.
Dialogue: 0,0:18:36.65,0:18:37.61,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:18:37.74,0:18:40.74,Default,,0,0,0,,Уран! Нептун! Плутон!
Dialogue: 0,0:18:40.91,0:18:42.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:45.45,0:18:49.29,Default,,0,0,0,,Хотару-чан - жойылу әкелетін теңізші Сатурн...
Dialogue: 0,0:18:50.46,0:18:53.96,Default,,0,0,0,,Жұмбақ күшке ие терең көздері бар.
Dialogue: 0,0:18:54.09,0:18:56.59,Default,,0,0,0,,Хотару-чан әрқашан жалғыз болып көрінетін...
Dialogue: 0,0:18:57.92,0:18:59.80,Default,,0,0,0,,Ешкімге айтпауға уәде беремін.
Dialogue: 0,0:18:59.93,0:19:00.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:01.05,0:19:02.76,Default,,0,0,0,,Бұл екеуміздің арамыздағы құпия, солай ма?
Dialogue: 0,0:19:03.05,0:19:04.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:04.97,0:19:05.89,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:19:11.98,0:19:12.86,Default,,0,0,0,,өлтіру
Dialogue: 0,0:19:13.02,0:19:13.86,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:14.02,0:19:15.23,Default,,0,0,0,,Ннн!
Dialogue: 0,0:19:15.90,0:19:17.23,Default,,0,0,0,,Чиби Мун!
Dialogue: 0,0:19:25.70,0:19:27.95,Default,,0,0,0,,Бұл жақсы емес! Мен саған көмектесуім керек!
Dialogue: 0,0:19:28.79,0:19:30.00,Default,,0,0,0,,Хотару-чан...
Dialogue: 0,0:19:36.59,0:19:37.92,Default,,0,0,0,,Ха!? Бұл...
Dialogue: 0,0:19:38.26,0:19:39.97,Default,,0,0,0,,Сейлор Чиби Мун!
Dialogue: 0,0:19:42.05,0:19:44.55,Default,,0,0,0,,Мен бұл жолы қашпаймын
Dialogue: 0,0:19:45.85,0:19:48.56,Default,,0,0,0,,Хотару-чан қандай болса да,
Dialogue: 0,0:19:48.68,0:19:50.06,Default,,0,0,0,,Кез келген адам
Dialogue: 0,0:19:51.02,0:19:53.44,Default,,0,0,0,,Қандай тағдыр болса да
Dialogue: 0,0:19:54.81,0:19:57.27,Default,,0,0,0,,Ол менің досым!
Dialogue: 0,0:19:57.73,0:19:58.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:03.99,0:20:06.33,Default,,0,0,0,,Ах... Хотару-чан!
Dialogue: 0,0:20:06.49,0:20:08.12,Default,,0,0,0,,Хотару-чан!
Dialogue: 0,0:20:08.74,0:20:10.08,Default,,0,0,0,,Ннн…
Dialogue: 0,0:20:14.08,0:20:15.67,Default,,0,0,0,,Иә! (Чиби Мун) Бақыт...
Dialogue: 0,0:20:16.29,0:20:17.75,Default,,0,0,0,,(Терезе әйнегі сынған дыбыс)
Dialogue: 0,0:20:17.88,0:20:19.42,Default,,0,0,0,,Ух... Уууу...
Dialogue: 0,0:20:19.59,0:20:21.17,Default,,0,0,0,,Уууу…
Dialogue: 0,0:20:21.34,0:20:22.47,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:22.63,0:20:23.34,Default,,0,0,0,,Не!?
Dialogue: 0,0:20:23.51,0:20:24.38,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:20:25.34,0:20:26.43,Default,,0,0,0,,Чибиуса!
Dialogue: 0,0:20:26.68,0:20:28.31,Default,,0,0,0,,Ха!? (Смокинг маскасы) Бұл...
Dialogue: 0,0:20:40.57,0:20:42.82,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:20:43.15,0:20:44.45,Default,,0,0,0,,Чиби Мун!
Dialogue: 0,0:20:44.86,0:20:45.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:47.37,0:20:48.20,Default,,0,0,0,,Уф…
Dialogue: 0,0:20:48.66,0:20:50.79,Default,,0,0,0,,Қарғыс атсын... (Ай) Стокседо маскасы!
Dialogue: 0,0:20:52.08,0:20:53.54,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:56.63,0:20:58.84,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:20:59.00,0:21:00.50,Default,,0,0,0,,Ха... Чиби Мун!
Dialogue: 0,0:21:01.00,0:21:02.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:02.42,0:21:03.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:04.55,0:21:07.43,Default,,0,0,0,,А... Кішкентай ханым?
Dialogue: 0,0:21:12.77,0:21:14.27,Default,,0,0,0,,Чиби Мун!
Dialogue: 0,0:21:16.35,0:21:17.48,Default,,0,0,0,,Ннн!
Dialogue: 0,0:21:17.65,0:21:18.61,Default,,0,0,0,,Уууу…
Dialogue: 0,0:21:23.99,0:21:26.78,Default,,0,0,0,,Сейлор Мун! (Марс) Бұл...
Dialogue: 0,0:21:27.82,0:21:28.87,Default,,0,0,0,,Хотару-чан!?
Dialogue: 0,0:21:30.74,0:21:32.41,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:21:37.25,0:21:38.71,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:21:39.46,0:21:42.42,Default,,0,0,0,,Жоқ, Сатурн!? Ол оянды ма?
Dialogue: 0,0:21:42.59,0:21:44.59,Default,,0,0,0,,Тұмар қосылмаған
Dialogue: 0,0:21:44.72,0:21:46.51,Default,,0,0,0,,Сонда бұл қалай көрінеді!?
Dialogue: 0,0:21:46.88,0:21:50.18,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:21:50.68,0:21:55.39,Default,,0,0,0,,Түсіндім... Түсіндім! Мен фантомдық күміс кристалды алдым!
Dialogue: 0,0:21:55.56,0:22:00.23,Default,,0,0,0,,Ұстаз Перғауын90, мен ояндым!
Dialogue: 0,0:22:00.65,0:22:03.53,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:22:03.69,0:22:06.07,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:22:07.36,0:22:08.45,Default,,0,0,0,,Чибиуса!
Dialogue: 0,0:22:08.82,0:22:10.99,Default,,0,0,0,,Чибиуса, мықты бол!
Dialogue: 0,0:22:11.62,0:22:13.08,Default,,0,0,0,,Чибиуса!
Dialogue: 0,0:22:14.37,0:22:15.75,Default,,0,0,0,,Ха…
Dialogue: 0,0:22:17.12,0:22:18.71,Default,,0,0,0,,Тыныс алмайсың!?
Dialogue: 0,0:22:21.00,0:22:27.01,Default,,0,0,0,,♪〜
Dialogue: 0,0:23:48.26,0:23:50.34,Default,,0,0,0,,〜♪
Dialogue: 0,0:23:52.34,0:23:56.68,Default,,0,0,0,,Чибиуса! Бұл өтірік... Көзіңді ашшы!
Dialogue: 0,0:23:57.31,0:24:02.10,Default,,0,0,0,,Келесі акт.34 «Шексіздік 8 «Лабиринт Муген» 1»
Dialogue: 0,0:24:02.52,0:24:04.77,Default,,0,0,0,,Ай сәулесі - махаббат хабары
Dialogue: 0,0:24:06.27,0:24:12.27,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
