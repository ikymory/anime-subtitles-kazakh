Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.21,0:00:04.67,Default,,0,0,0,,Плутон!
Dialogue: 0,0:00:05.42,0:00:06.79,Default,,0,0,0,,Ннн…
Dialogue: 0,0:00:06.92,0:00:08.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:10.55,0:00:13.97,Default,,0,0,0,,Бұл шын ба? Бұл Плутон ба?
Dialogue: 0,0:00:14.63,0:00:16.51,Default,,0,0,0,,Кішкентай ханым…
Dialogue: 0,0:00:16.64,0:00:19.47,Default,,0,0,0,,Сейлор Чиби Мун жоқ
Dialogue: 0,0:00:20.10,0:00:21.10,Default,,0,0,0,,Мен—
Dialogue: 0,0:00:21.22,0:00:24.10,Default,,0,0,0,,Сенің сұлу анаң, сенің ұлы
Dialogue: 0,0:00:24.23,0:00:26.81,Default,,0,0,0,,Neo Queen Serenity көмегімен
Dialogue: 0,0:00:26.94,0:00:28.73,Default,,0,0,0,,Мен реинкарнацияландым.
Dialogue: 0,0:00:29.19,0:00:31.86,Default,,0,0,0,,Маңызды миссия үшін (Сейлор Мун) Га...
Dialogue: 0,0:00:36.53,0:00:37.53,Default,,0,0,0,,Сейлор Мун?
Dialogue: 0,0:00:41.24,0:00:42.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:45.29,0:00:49.38,Default,,0,0,0,,Бұл біз үйреніп қалған Плутоннан қандай да бір айырмашылығы бар...
Dialogue: 0,0:00:50.75,0:00:54.84,Default,,0,0,0,,Күшті және үлкенірек...
Dialogue: 0,0:00:57.84,0:00:59.43,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:00:59.80,0:01:04.48,Default,,0,0,0,,Біздің жаңа патшайым Серенити ханшайымы
Dialogue: 0,0:01:04.81,0:01:05.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:06.31,0:01:12.98,Default,,0,0,0,,Сыртқы Күн жүйесінің жел жұлдызы Уран аспанның қорғаушысы жауынгері ретінде
Dialogue: 0,0:01:13.11,0:01:14.61,Default,,0,0,0,,Теңізші Уран
Dialogue: 0,0:01:15.03,0:01:17.91,Default,,0,0,0,,Сол сияқты сыртқы күн жүйесі—
Dialogue: 0,0:01:18.03,0:01:23.08,Default,,0,0,0,,Нептун қамқоршысы болған теңізші Нептун
Dialogue: 0,0:01:23.41,0:01:27.92,Default,,0,0,0,,Және оның қамқоршысы ретінде жер асты әлемінің жұлдызы Плутон бар.
Dialogue: 0,0:01:28.04,0:01:29.75,Default,,0,0,0,,Теңізші Плутон
Dialogue: 0,0:01:30.92,0:01:35.42,Default,,0,0,0,,Сыртқы Күн жүйесі Біздің үш жауынгер осында!
Dialogue: 0,0:01:37.05,0:01:42.31,Default,,0,0,0,,♪〜
Dialogue: 0,0:03:00.84,0:03:06.60,Default,,0,0,0,,〜♪
Dialogue: 0,0:03:11.06,0:03:12.60,Default,,0,0,0,,Менің ханшайымым
Dialogue: 0,0:03:13.06,0:03:15.23,Default,,0,0,0,,Біздің құрметсіздік...
Dialogue: 0,0:03:15.44,0:03:18.07,Default,,0,0,0,,Мен кез келген өтемақы жасауға дайынмын.
Dialogue: 0,0:03:18.94,0:03:22.74,Default,,0,0,0,,Бірақ мұның бәрі сізді және осы планетаны қорғау үшін.
Dialogue: 0,0:03:23.45,0:03:25.78,Default,,0,0,0,,Мені кешіріңіз. (Ай) А...
Dialogue: 0,0:03:26.12,0:03:29.25,Default,,0,0,0,,Біз де ежелден...
Dialogue: 0,0:03:29.37,0:03:32.62,Default,,0,0,0,,Алыс ғарыштан келген басқыншыларға қарсы соғысқан жауынгер ретінде —
Dialogue: 0,0:03:32.75,0:03:34.00,Default,,0,0,0,,Алыс, алыс -
Dialogue: 0,0:03:34.13,0:03:36.92,Default,,0,0,0,,Күміс мыңжылдықты бақыладым.
Dialogue: 0,0:03:38.46,0:03:42.93,Default,,0,0,0,,Ханшайым және күміс мыңжылдық
Dialogue: 0,0:03:43.26,0:03:46.51,Default,,0,0,0,,Осылайша біз бұл дүниеге қайта оралдық.
Dialogue: 0,0:03:46.76,0:03:52.77,Default,,0,0,0,,Сіз сияқты бізге де реинкарнация уәде етілген...
Dialogue: 0,0:03:53.06,0:03:56.19,Default,,0,0,0,,Мен бұл планетада жаңадан ояндым.
Dialogue: 0,0:03:56.69,0:03:58.82,Default,,0,0,0,,Бірақ тым кеш болған сияқты
Dialogue: 0,0:03:58.94,0:03:59.78,Default,,0,0,0,,А...
Dialogue: 0,0:04:00.03,0:04:04.70,Default,,0,0,0,,Біз толық ояу және қауіпті сезінген кезде...
Dialogue: 0,0:04:04.82,0:04:07.45,Default,,0,0,0,,Олар басып алған болатын.
Dialogue: 0,0:04:07.66,0:04:12.66,Default,,0,0,0,,Ол бекініске терең және тыныш ұялаған.
Dialogue: 0,0:04:13.46,0:04:17.79,Default,,0,0,0,,Бұл жау шапқыншылығына көз жұмғандағы қателігіміз болды.
Dialogue: 0,0:04:18.54,0:04:21.26,Default,,0,0,0,,Өлімді өлтірушілер... олар кімдер...
Dialogue: 0,0:04:21.97,0:04:24.80,Default,,0,0,0,,Кеңістік пен уақытта алыс... Тау жүйесінен—
Dialogue: 0,0:04:24.93,0:04:27.64,Default,,0,0,0,,Бұл әлемді басып алуға келген бөтен адам.
Dialogue: 0,0:04:27.80,0:04:29.51,Default,,0,0,0,,Ха... Тау жүйесі...
Dialogue: 0,0:04:30.72,0:04:32.60,Default,,0,0,0,,Шексіздіктің бұл ауданы —
Dialogue: 0,0:04:32.73,0:04:36.65,Default,,0,0,0,,Ол тылсым күшке ие үлкен аурамен қоршалған.
Dialogue: 0,0:04:36.81,0:04:40.28,Default,,0,0,0,,Олар сол жерде сызылған болуы мүмкін.
Dialogue: 0,0:04:41.44,0:04:46.16,Default,,0,0,0,,Әдейі ме, әлде кездейсоқ па, бұл жерде кеңістік-уақыттағы бұрылыс орын алуда.
Dialogue: 0,0:04:46.28,0:04:48.99,Default,,0,0,0,,Олар сол жерден кірген сияқты.
Dialogue: 0,0:04:49.37,0:04:52.33,Default,,0,0,0,,Кеңістік-уақыттың бұрмалануын тез арада жоймасақ...
Dialogue: 0,0:04:52.45,0:04:55.00,Default,,0,0,0,,Бұл планетаға көбірек шабуыл жасалуда.
Dialogue: 0,0:04:55.54,0:05:00.17,Default,,0,0,0,,Мен өзімді Мүген академиясының студентімін деп көрсетіп, іште не болып жатқанын ақтардым, бірақ...
Dialogue: 0,0:05:00.30,0:05:02.71,Default,,0,0,0,,Бұл енді мүмкін емес.
Dialogue: 0,0:05:02.84,0:05:06.51,Default,,0,0,0,,үшінңызды осыған әкелгенім үшін кешірім сұраймын.
Dialogue: 0,0:05:06.84,0:05:07.76,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:05:07.89,0:05:10.05,Default,,0,0,0,,Келесі жау, өлімді жеңушілер, —
Dialogue: 0,0:05:10.89,0:05:13.18,Default,,0,0,0,,Біз пішін жасаймыз
Dialogue: 0,0:05:13.35,0:05:15.02,Default,,0,0,0,,Біз де көмектесеміз!
Dialogue: 0,0:05:15.18,0:05:15.85,Default,,0,0,0,,Бұл кедергі.
Dialogue: 0,0:05:16.02,0:05:16.89,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:17.02,0:05:18.94,Default,,0,0,0,,Бұл біздің юрисдикциямыз.
Dialogue: 0,0:05:19.73,0:05:21.23,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:05:21.36,0:05:26.15,Default,,0,0,0,,Біз өз миссиямызды уақытты жоғалтпай, кедергісіз орындауымыз керек.
Dialogue: 0,0:05:26.36,0:05:29.49,Default,,0,0,0,,Сондықтан біз де көмектескіміз келеді!
Dialogue: 0,0:05:29.66,0:05:31.45,Default,,0,0,0,,Өзіңізді сонша қауіп төндіргіңіз келе ме?
Dialogue: 0,0:05:31.62,0:05:32.45,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:32.58,0:05:34.83,Default,,0,0,0,,Біз мектептен шыққанда иіскеп көр
Dialogue: 0,0:05:34.95,0:05:37.17,Default,,0,0,0,,Өлімді өлтірушілер бізден кейін келуі мүмкін!
Dialogue: 0,0:05:37.96,0:05:39.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:39.63,0:05:42.05,Default,,0,0,0,,Біз сол пәтерде тұрамыз -
Dialogue: 0,0:05:42.17,0:05:44.05,Default,,0,0,0,,Мүгеншуді үнемі бақылап отырыңыз
Dialogue: 0,0:05:44.80,0:05:45.88,Default,,0,0,0,,Ешқашан сәтсіздікке ұшырамаңыз
Dialogue: 0,0:05:46.42,0:05:47.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:47.72,0:05:48.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:50.34,0:05:53.26,Default,,0,0,0,,Ол бетіңді жасама, ханшайым.
Dialogue: 0,0:05:54.39,0:05:57.23,Default,,0,0,0,,Мен сізді шатастырғым келмеді.
Dialogue: 0,0:06:00.56,0:06:01.86,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:06:02.69,0:06:03.57,Default,,0,0,0,,Уран —
Dialogue: 0,0:06:03.90,0:06:06.44,Default,,0,0,0,,Еркек те, әйел де
Dialogue: 0,0:06:06.57,0:06:10.70,Default,,0,0,0,,Екі жыныстың екеуі де күшті жақтары бар жауынгерлер.
Dialogue: 0,0:06:10.82,0:06:11.66,Default,,0,0,0,,А...
Dialogue: 0,0:06:11.91,0:06:16.87,Default,,0,0,0,,Үшеумізде сізде жоқ ерекше күштер бар.
Dialogue: 0,0:06:17.00,0:06:23.38,Default,,0,0,0,,Бізге күштірек күштер мен күшті заттар берілді.
Dialogue: 0,0:06:23.50,0:06:25.34,Default,,0,0,0,,Оны бізге қалдырыңыз
Dialogue: 0,0:06:25.46,0:06:26.76,Default,,0,0,0,,Мүмкін—
Dialogue: 0,0:06:26.92,0:06:29.51,Default,,0,0,0,,Сізде қандай күшті заттар бар?
Dialogue: 0,0:06:29.63,0:06:31.80,Default,,0,0,0,,Жоюға апаратын үш бойтұмарды айтасыз ба?
Dialogue: 0,0:06:31.93,0:06:32.76,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:33.26,0:06:35.77,Default,,0,0,0,,Қайғылы белгі көптен бері шығып жатыр.
Dialogue: 0,0:06:35.89,0:06:38.60,Default,,0,0,0,,«Талисмандарды жинауға болмайды»...
Dialogue: 0,0:06:38.73,0:06:41.44,Default,,0,0,0,,Сіздің қару бойтұмарыңыз қандай?
Dialogue: 0,0:06:41.56,0:06:44.52,Default,,0,0,0,,Сіздің миссияңыз қандай?
Dialogue: 0,0:06:45.23,0:06:47.57,Default,,0,0,0,,Бізде бар бойтұмарлар және—
Dialogue: 0,0:06:47.69,0:06:50.24,Default,,0,0,0,,Біздің ең үлкен миссиямыз...
Dialogue: 0,0:06:50.57,0:06:54.37,Default,,0,0,0,,Ең үлкен жауды, Жоюшы Құдайды жерлеу
Dialogue: 0,0:06:54.83,0:06:55.91,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:56.04,0:06:58.33,Default,,0,0,0,,Жоюшы Құдай…
Dialogue: 0,0:06:59.91,0:07:01.96,Default,,0,0,0,,Уау! (Қоянның шулаған дыбысы)
Dialogue: 0,0:07:02.08,0:07:05.13,Default,,0,0,0,,Неге мені оятпайсың!?
Dialogue: 0,0:07:05.25,0:07:06.88,Default,,0,0,0,,Анамның ақымақ!
Dialogue: 0,0:07:07.00,0:07:09.59,Default,,0,0,0,,Келесі жаңалық – Мүген Гакуендегі оқиғалар тізбегі.
Dialogue: 0,0:07:09.76,0:07:11.59,Default,,0,0,0,,Оқушылардың жоғалып кетуіне қатысты—
Dialogue: 0,0:07:11.72,0:07:12.55,Default,,0,0,0,,Ата-аналардан
Dialogue: 0,0:07:12.68,0:07:15.22,Default,,0,0,0,,Мектепті жауапкершілікке шақырған дауыстар естіледі.
Dialogue: 0,0:07:15.35,0:07:18.47,Default,,0,0,0,,Қазіргі уақытта мектеп ғимараттары жабық және кіруге тыйым салынған.
Dialogue: 0,0:07:18.60,0:07:20.69,Default,,0,0,0,,Әй... мына жынды ғалым...
Dialogue: 0,0:07:20.81,0:07:22.69,Default,,0,0,0,,Сіз тағы да дүрбелең тудырып жатырсыз ба?
Dialogue: 0,0:07:22.81,0:07:23.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:24.69,0:07:26.15,Default,,0,0,0,,Хотарудың әкесі!
Dialogue: 0,0:07:26.32,0:07:27.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:27.65,0:07:29.94,Default,,0,0,0,,Әке, сіз білесіз бе? сол адам
Dialogue: 0,0:07:30.07,0:07:34.28,Default,,0,0,0,,Әй, ол гендік инженерия бойынша әлемге әйгілі ғалым еді.
Dialogue: 0,0:07:34.99,0:07:36.62,Default,,0,0,0,,Бұл баяғыда болды.
Dialogue: 0,0:07:36.74,0:07:37.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:40.08,0:07:42.17,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:07:42.33,0:07:44.58,Default,,0,0,0,,«Суперорганизм» өмірлік қызметі»
Dialogue: 0,0:07:44.75,0:07:46.67,Default,,0,0,0,,``Жануарларға шамадан тыс тәжірибе жасау''
Dialogue: 0,0:07:46.79,0:07:48.46,Default,,0,0,0,,〝Қайталанатын генетикалық манипуляция〞
Dialogue: 0,0:07:48.59,0:07:51.09,Default,,0,0,0,,〝6 жыл бұрын академиялық қоғамнан шығарылған〞
Dialogue: 0,0:07:51.22,0:07:52.59,Default,,0,0,0,,〝Сол эксперименталды ноу-хау...〞
Dialogue: 0,0:07:52.72,0:07:54.34,Default,,0,0,0,,``Шетелдік компанияларға сату және т.б.''
Dialogue: 0,0:07:54.47,0:07:55.64,Default,,0,0,0,,``Осы арқылы алынған қаражатпен...''
Dialogue: 0,0:07:55.76,0:07:57.64,Default,,0,0,0,,〝Шексіз ауданды сатып алыңыз〞
Dialogue: 0,0:07:58.26,0:08:02.19,Default,,0,0,0,,«Бірақ екі жылдан кейін Мүген ауданында ғимараттың құрылысы кезінде үлкен өрт шықты»...
Dialogue: 0,0:08:02.48,0:08:03.64,Default,,0,0,0,,Хотару-чан...
Dialogue: 0,0:08:03.77,0:08:06.69,Default,,0,0,0,,«Сосын профессор көпшіліктің көзінен ғайып болды...»
Dialogue: 0,0:08:07.23,0:08:10.36,Default,,0,0,0,,«Қазір Муген академиясының төрағасы болып тағайындалды»
Dialogue: 0,0:08:10.99,0:08:13.32,Default,,0,0,0,,Сәлем Чибиуса, саған...
Dialogue: 0,0:08:13.45,0:08:15.95,Default,,0,0,0,,Хотару-чанды бақылап отыруларыңызды қалаймын.
Dialogue: 0,0:08:16.07,0:08:16.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:17.07,0:08:19.70,Default,,0,0,0,,Мен Хотару-чанға күмәнданбаймын.
Dialogue: 0,0:08:19.83,0:08:21.20,Default,,0,0,0,,Бірақ біз...
Dialogue: 0,0:08:21.33,0:08:26.25,Default,,0,0,0,,Қарсыластың аумағын зерттеп, оның жеке басын біліп, оларды жою керек.
Dialogue: 0,0:08:26.38,0:08:27.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:28.21,0:08:30.92,Default,,0,0,0,,Менің ойымша, профессор Томое да күдікті.
Dialogue: 0,0:08:31.13,0:08:32.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:32.84,0:08:34.30,Default,,0,0,0,,Чибиуза
Dialogue: 0,0:08:35.09,0:08:38.64,Default,,0,0,0,,Бұл қиын рөл болуы мүмкін, бірақ сіз мұны істей аласыз ба?
Dialogue: 0,0:08:39.14,0:08:40.31,Default,,0,0,0,,Уууу…
Dialogue: 0,0:08:43.98,0:08:45.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:45.98,0:08:48.81,Default,,0,0,0,,Түсіндім, мен де бар күшімді саламын!
Dialogue: 0,0:08:49.48,0:08:51.07,Default,,0,0,0,,Жауынгер ретінде!
Dialogue: 0,0:08:55.03,0:08:56.24,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:08:57.45,0:08:58.41,Default,,0,0,0,,(Жынның айқайы)
Dialogue: 0,0:08:59.83,0:09:01.41,Default,,0,0,0,,Каори-кун, га...
Dialogue: 0,0:09:01.54,0:09:04.71,Default,,0,0,0,,Кешіріңіз, профессор, мен бей-жай қалдым.
Dialogue: 0,0:09:05.41,0:09:07.88,Default,,0,0,0,,Сіз шебердің сүйіктісісіз...
Dialogue: 0,0:09:08.00,0:09:10.21,Default,,0,0,0,,Бөтен зат Тек теңізші Сеншиді өшіру үшін —
Dialogue: 0,0:09:10.34,0:09:11.88,Default,,0,0,0,,Бұл туралы ойланыңыз.
Dialogue: 0,0:09:12.84,0:09:17.59,Default,,0,0,0,,...Алайда, Ұстаздың барлық тілегін орындай алатын адам...
Dialogue: 0,0:09:17.72,0:09:21.56,Default,,0,0,0,,Сіздің қол астыңыздағыларыңызбен бұл мүмкін емес сияқты, хехехе...
Dialogue: 0,0:09:21.89,0:09:23.22,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:09:25.31,0:09:26.81,Default,,0,0,0,,Перғауын 90) О...
Dialogue: 0,0:09:26.94,0:09:31.27,Default,,0,0,0,,Тіршілік көзі болып табылатын Тайолон хрусталы жұқарып барады.
Dialogue: 0,0:09:31.44,0:09:32.57,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:32.94,0:09:33.99,Default,,0,0,0,,мүмкіндігінше тезірек
Dialogue: 0,0:09:34.11,0:09:38.66,Default,,0,0,0,,Біз Тайолон кристалына жақын жарық алуымыз керек!
Dialogue: 0,0:09:39.41,0:09:43.58,Default,,0,0,0,,Жұлдыздардың қорғаныс күші! Бірге жиналыңдар!
Dialogue: 0,0:09:44.04,0:09:49.67,Default,,0,0,0,,Мен тапқан қауіпсіз баспанамды ешкімге бермеймін!
Dialogue: 0,0:09:57.09,0:10:00.51,Default,,0,0,0,,Жарық осында көбірек жиналуда...
Dialogue: 0,0:10:02.47,0:10:05.93,Default,,0,0,0,,Осы үш жаңа жұлдыздың қорғаныс жарығы...
Dialogue: 0,0:10:06.68,0:10:10.06,Default,,0,0,0,,Қайғылы! Бұл жарық бұрынғыдан да күшті
Dialogue: 0,0:10:12.19,0:10:13.15,Default,,0,0,0,,Ха... Енді...
Dialogue: 0,0:10:13.69,0:10:14.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:16.28,0:10:19.28,Default,,0,0,0,,Менің су айнамды әрдайым шатастырады —
Dialogue: 0,0:10:19.41,0:10:22.99,Default,,0,0,0,,Теңізші-жауынгерлер қандай күшті сәуле шығарды
Dialogue: 0,0:10:23.37,0:10:24.58,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:10:24.95,0:10:27.75,Default,,0,0,0,,Жұлдыздардың күшті қорғаныс жарығымен түсірілген
Dialogue: 0,0:10:27.87,0:10:31.67,Default,,0,0,0,,Біз қашып құтыла алмайтындармыз...
Dialogue: 0,0:10:32.50,0:10:33.75,Default,,0,0,0,,(судың айнасының дыбысы)
Dialogue: 0,0:10:35.71,0:10:38.84,Default,,0,0,0,,Сізге телефон соғуға болады ма? Мистикалық каолинит
Dialogue: 0,0:10:39.26,0:10:43.64,Default,,0,0,0,,Шиприн, 5 Witches сізге осы уақытқа дейін не көрсетті...
Dialogue: 0,0:10:43.76,0:10:46.43,Default,,0,0,0,,Ұятты жою керек.
Dialogue: 0,0:10:46.60,0:10:49.27,Default,,0,0,0,,Ведьма 5 Соңғы ведьма...
Dialogue: 0,0:10:49.39,0:10:53.02,Default,,0,0,0,,Бұл Шиприн Теңізші Сеншиді міндетті түрде өшіреді...
Dialogue: 0,0:10:53.15,0:10:55.11,Default,,0,0,0,,Сол керемет Евхарист —
Dialogue: 0,0:10:55.23,0:11:00.86,Default,,0,0,0,,Ал Тайолон кристалына ұқсас қуатты алуға тырысайық.
Dialogue: 0,0:11:01.16,0:11:05.08,Default,,0,0,0,,Қожайыным Перғауынның көңілінен шығу үшін90
Dialogue: 0,0:11:05.20,0:11:06.16,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:11:06.83,0:11:08.62,Default,,0,0,0,,Бірақ бұған дейін
Dialogue: 0,0:11:08.75,0:11:13.54,Default,,0,0,0,,Біздің мектептің деректерін қайта жазып, мектептен жоғалып кеткен оқушылар бар.
Dialogue: 0,0:11:14.42,0:11:15.67,Default,,0,0,0,,Мен сен осы тасты жарып өте алмайсың деп ойладым…
Dialogue: 0,0:11:16.05,0:11:19.67,Default,,0,0,0,,Ол ыдыс үшін ең жақсы адам болғанымен, ол қауіпті бөгде зат болды.
Dialogue: 0,0:11:20.97,0:11:23.05,Default,,0,0,0,,Табу және өшіру
Dialogue: 0,0:11:23.55,0:11:25.55,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:11:28.52,0:11:29.77,Default,,0,0,0,,Бала тәрбиелеуші ана!
Dialogue: 0,0:11:29.93,0:11:33.77,Default,,0,0,0,,Ертең мен достарыммен кино көремін, үйге кеш келемін.
Dialogue: 0,0:11:33.90,0:11:36.48,Default,,0,0,0,,Сәлем! Сіз оны кіммен бірге көресіз?
Dialogue: 0,0:11:36.61,0:11:38.19,Default,,0,0,0,,Хотару-чан иә?
Dialogue: 0,0:11:38.73,0:11:41.74,Default,,0,0,0,,Чибиуса-чан, келесі жолы кино көргің келе ме?
Dialogue: 0,0:11:42.49,0:11:45.74,Default,,0,0,0,,Жоқ, бұл фильм болуы шарт емес.
Dialogue: 0,0:11:46.28,0:11:48.58,Default,,0,0,0,,Бір жерге барамыз ба?
Dialogue: 0,0:11:48.70,0:11:49.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:50.96,0:11:53.75,Default,,0,0,0,,Хотару-чанның мені шақырғанына сене алар емеспін...
Dialogue: 0,0:11:53.87,0:11:56.92,Default,,0,0,0,,Бір нәрсе туралы сөйлескіңіз келеді ме?
Dialogue: 0,0:11:57.34,0:12:01.38,Default,,0,0,0,,Хотару-чанның әкесі туралы естігім келеді.
Dialogue: 0,0:12:01.55,0:12:02.63,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:12:02.76,0:12:04.05,Default,,0,0,0,,Сәлем Чибиуса!
Dialogue: 0,0:12:04.64,0:12:06.89,Default,,0,0,0,,Не? Бұл әдемі
Dialogue: 0,0:12:07.01,0:12:08.26,Default,,0,0,0,,Әй, Кенюки папа!
Dialogue: 0,0:12:08.64,0:12:09.56,Default,,0,0,0,,Усаги мен Мамо-чанға
Dialogue: 0,0:12:09.68,0:12:12.73,Default,,0,0,0,,Мен сіздің көмегіңізбен жасаған аты аңызға айналған Қасиетті Граил.
Dialogue: 0,0:12:12.85,0:12:13.81,Default,,0,0,0,,Қасиетті Граил?
Dialogue: 0,0:12:13.94,0:12:15.31,Default,,0,0,0,,Қасиетті Граил...
Dialogue: 0,0:12:16.69,0:12:19.19,Default,,0,0,0,,Жауынгердей мықты болып кеттің ғой, солай ма?
Dialogue: 0,0:12:19.32,0:12:20.57,Default,,0,0,0,,Кішкентай ханым
Dialogue: 0,0:12:20.69,0:12:22.03,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:12:35.71,0:12:37.75,Default,,0,0,0,,Хотару-чан, кешігіп қалдың...
Dialogue: 0,0:12:38.42,0:12:42.26,Default,,0,0,0,,Біздің кездесуге бір сағат болды...
Dialogue: 0,0:12:42.67,0:12:46.26,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:12:46.76,0:12:50.06,Default,,0,0,0,,Бұл менің бөлмемдегі телефон, хехе...
Dialogue: 0,0:12:50.18,0:12:53.85,Default,,0,0,0,,Хотару-чан, сен өз бөлмеңде емессің бе?
Dialogue: 0,0:12:53.98,0:12:55.69,Default,,0,0,0,,Ха...мүмкін...
Dialogue: 0,0:12:56.52,0:12:59.48,Default,,0,0,0,,Менің ойымша, сіз қайтадан жалғыз құлап жатырсыз ...
Dialogue: 0,0:13:00.82,0:13:01.65,Default,,0,0,0,,Хотару-чан
Dialogue: 0,0:13:05.99,0:13:09.83,Default,,0,0,0,,Ах... қара бұлт көп...
Dialogue: 0,0:13:11.24,0:13:12.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:13.16,0:13:16.62,Default,,0,0,0,,Сізге жаңа бөлімдер қалай ұнады?
Dialogue: 0,0:13:16.75,0:13:18.08,Default,,0,0,0,,Жарайды, әке.
Dialogue: 0,0:13:18.75,0:13:20.13,Default,,0,0,0,,Таныс
Dialogue: 0,0:13:20.25,0:13:23.05,Default,,0,0,0,,Жаңадан дамыған жасушалар мен нейрондар
Dialogue: 0,0:13:23.21,0:13:26.30,Default,,0,0,0,,Соңғы материалдар мен рецепторлар
Dialogue: 0,0:13:26.59,0:13:29.43,Default,,0,0,0,,Енді сізде апат болмайды.
Dialogue: 0,0:13:29.72,0:13:30.93,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:13:33.43,0:13:37.14,Default,,0,0,0,,Чибиуса-чан үйіне кетті ме деп ойлаймын...
Dialogue: 0,0:13:42.82,0:13:43.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:43.82,0:13:45.07,Default,,0,0,0,,Ха... аа...
Dialogue: 0,0:13:45.44,0:13:46.32,Default,,0,0,0,,Чибиуса-чан...
Dialogue: 0,0:13:47.15,0:13:51.20,Default,,0,0,0,,Кешіріңіз, мен рұқсатсыз кірдім...
Dialogue: 0,0:13:51.33,0:13:52.16,Default,,0,0,0,,Ннн!
Dialogue: 0,0:13:52.62,0:13:53.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:54.20,0:13:55.87,Default,,0,0,0,,Ух... Уууу...
Dialogue: 0,0:13:57.08,0:14:00.38,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:14:00.96,0:14:02.17,Default,,0,0,0,,Я...
Dialogue: 0,0:14:07.34,0:14:08.55,Default,,0,0,0,,Өрт сөндіруші!
Dialogue: 0,0:14:09.05,0:14:11.97,Default,,0,0,0,,Анашым! Бұл ыстық!
Dialogue: 0,0:14:17.60,0:14:18.85,Default,,0,0,0,,Өткенге… электрондық хат па?
Dialogue: 0,0:14:18.98,0:14:21.48,Default,,0,0,0,,Қайырлы таң Хотару
Dialogue: 0,0:14:21.86,0:14:23.57,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:14:24.44,0:14:26.15,Default,,0,0,0,,Қалайсың? Ах...
Dialogue: 0,0:14:26.65,0:14:28.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:28.40,0:14:30.36,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:14:33.20,0:14:34.91,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:37.37,0:14:39.29,Default,,0,0,0,,Қансыз
Dialogue: 0,0:14:39.58,0:14:44.46,Default,,0,0,0,,Менің суық денемнің сырын ешкім білгенін қаламаймын...
Dialogue: 0,0:14:45.34,0:14:47.30,Default,,0,0,0,,Мен көптен бері жалғызбын
Dialogue: 0,0:14:48.76,0:14:49.63,Default,,0,0,0,,Достық белгісі ретінде—
Dialogue: 0,0:14:49.76,0:14:52.60,Default,,0,0,0,,Мен оны Хотару-чанға бергенім дұрыс деп ойладым.
Dialogue: 0,0:14:52.72,0:14:53.64,Default,,0,0,0,,Ах…
Dialogue: 0,0:14:54.60,0:14:56.52,Default,,0,0,0,,Чибиуса-чан...
Dialogue: 0,0:14:57.02,0:14:59.35,Default,,0,0,0,,Ақырында дос болғанымызға қарамастан...
Dialogue: 0,0:15:00.77,0:15:05.65,Default,,0,0,0,,Мұндай денемен өмір сүруге қандай себеп бар?
Dialogue: 0,0:15:06.57,0:15:08.94,Default,,0,0,0,,Менің өмірімнің мәні бар ма?
Dialogue: 0,0:15:10.07,0:15:11.95,Default,,0,0,0,,Уф! Уууу...
Dialogue: 0,0:15:12.07,0:15:14.62,Default,,0,0,0,,Маңдайым... ауырады!
Dialogue: 0,0:15:14.74,0:15:15.87,Default,,0,0,0,,Уууу…
Dialogue: 0,0:15:17.79,0:15:21.83,Default,,0,0,0,,Уа... сендер кімсіңдер?
Dialogue: 0,0:15:24.08,0:15:26.13,Default,,0,0,0,,Неге маған сонша аяйсың?
Dialogue: 0,0:15:26.25,0:15:27.67,Default,,0,0,0,,Мені көріп тұрсың ба?
Dialogue: 0,0:15:28.05,0:15:31.09,Default,,0,0,0,,Иә! Хаха...
Dialogue: 0,0:15:32.89,0:15:35.35,Default,,0,0,0,,Ух... Хаха...
Dialogue: 0,0:15:36.31,0:15:37.81,Default,,0,0,0,,Бұл ауырады…
Dialogue: 0,0:15:38.31,0:15:45.11,Default,,0,0,0,,Маңдайымнан... ішімнен бірдеңе шыққысы келеді.
Dialogue: 0,0:15:47.23,0:15:48.69,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:15:49.11,0:15:51.11,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:15:53.11,0:15:54.53,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:15:55.16,0:15:57.45,Default,,0,0,0,,Мүмкін мен оны көрмеуім керек еді.
Dialogue: 0,0:15:59.08,0:16:00.79,Default,,0,0,0,,Баяғыда мен апатқа ұшырадым...
Dialogue: 0,0:16:01.71,0:16:03.54,Default,,0,0,0,,Менің тыртықтарым көп.
Dialogue: 0,0:16:04.25,0:16:08.00,Default,,0,0,0,,Мен таң қалып, қашып кеттім...
Dialogue: 0,0:16:08.63,0:16:09.76,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:16:09.88,0:16:11.76,Default,,0,0,0,,Хотару-чанды ренжіттіңіз бе?
Dialogue: 0,0:16:11.88,0:16:14.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:15.72,0:16:16.93,Default,,0,0,0,,Барыс?
Dialogue: 0,0:16:17.60,0:16:18.60,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:20.39,0:16:22.43,Default,,0,0,0,,Уау! Ахх...
Dialogue: 0,0:16:22.60,0:16:23.89,Default,,0,0,0,,Уууу…
Dialogue: 0,0:16:24.02,0:16:27.44,Default,,0,0,0,,Денем ұйып қалды... Мына қабылан біртүрлі екен.
Dialogue: 0,0:16:28.90,0:16:29.61,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:30.15,0:16:32.15,Default,,0,0,0,,Ха... (Мамору) Бұл...
Dialogue: 0,0:16:33.28,0:16:36.16,Default,,0,0,0,,Қоян! Ха... Чибиуса?
Dialogue: 0,0:16:38.20,0:16:40.29,Default,,0,0,0,,Ннн…
Dialogue: 0,0:16:40.45,0:16:43.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:43.54,0:16:44.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:49.00,0:16:50.59,Default,,0,0,0,,Тоқтадың ба...ха!?
Dialogue: 0,0:16:51.88,0:16:55.55,Default,,0,0,0,,Шексіз мектептен қашқан Тенну Харука
Dialogue: 0,0:16:55.68,0:16:57.05,Default,,0,0,0,,Мен таптым!
Dialogue: 0,0:16:57.72,0:16:58.93,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:16:59.05,0:16:59.89,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:00.06,0:17:00.93,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:01.06,0:17:01.89,Default,,0,0,0,,Харука!
Dialogue: 0,0:17:02.06,0:17:02.89,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:04.35,0:17:06.52,Default,,0,0,0,,Өлімді өлтірушілер келді!
Dialogue: 0,0:17:06.81,0:17:09.44,Default,,0,0,0,,Менің шабуылымнан құтылатын сен кімсің?
Dialogue: 0,0:17:09.57,0:17:10.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:11.36,0:17:13.65,Default,,0,0,0,,Уран планетасының қуаты!
Dialogue: 0,0:17:13.78,0:17:15.82,Default,,0,0,0,,Макияж!
Dialogue: 0,0:17:30.50,0:17:35.92,Default,,0,0,0,,Аспан жауынгері, қамқоршысы Уран, жел жұлдызы.
Dialogue: 0,0:17:36.55,0:17:38.30,Default,,0,0,0,,Теңізші Уран!
Dialogue: 0,0:17:40.10,0:17:40.97,Default,,0,0,0,,Уран!
Dialogue: 0,0:17:41.10,0:17:42.06,Default,,0,0,0,,Нептун!
Dialogue: 0,0:17:42.18,0:17:43.02,Default,,0,0,0,,Плутон!
Dialogue: 0,0:17:43.68,0:17:48.02,Default,,0,0,0,,Жұлдыздардың қамқоршысы бар ма!? Мен оны ешқашан теңізші жауынгер деп ойламаппын ...
Dialogue: 0,0:17:48.15,0:17:49.40,Default,,0,0,0,,Аа... дұрыс!
Dialogue: 0,0:17:49.86,0:17:51.94,Default,,0,0,0,,Мен бәрін тазалаймын!
Dialogue: 0,0:17:52.27,0:17:54.57,Default,,0,0,0,,Бүкіл қала қиыншылықта!
Dialogue: 0,0:17:54.69,0:17:56.03,Default,,0,0,0,,Иә! (соққы дыбысы)
Dialogue: 0,0:17:56.15,0:17:57.28,Default,,0,0,0,,Ннн!
Dialogue: 0,0:17:57.61,0:17:59.91,Default,,0,0,0,,Ерте жауған сол барыстың арқасында.
Dialogue: 0,0:18:00.12,0:18:01.66,Default,,0,0,0,,үшін, қараңдар!
Dialogue: 0,0:18:02.99,0:18:05.95,Default,,0,0,0,,Уран және оның достары Муген аспанында...
Dialogue: 0,0:18:06.12,0:18:07.92,Default,,0,0,0,,Ааа...
Dialogue: 0,0:18:08.25,0:18:10.96,Default,,0,0,0,,Сол жігіттерді жайына қалдыр.
Dialogue: 0,0:18:11.09,0:18:12.42,Default,,0,0,0,,үшінмыз кеттік!
Dialogue: 0,0:18:13.09,0:18:14.00,Default,,0,0,0,,Қоян...
Dialogue: 0,0:18:14.71,0:18:18.13,Default,,0,0,0,,Қала тұрғындарына және сол үш адамға да көмектес!
Dialogue: 0,0:18:18.30,0:18:22.35,Default,,0,0,0,,...
Dialogue: 0,0:18:22.47,0:18:26.85,Default,,0,0,0,,Ешкім бұл деңгейден 999 (Үш тоғыз) Шиприннің сиқырынан құтыла алмады!
Dialogue: 0,0:18:27.27,0:18:29.10,Default,,0,0,0,,Лента бұзғыш!
Dialogue: 0,0:18:30.23,0:18:31.06,Default,,0,0,0,,Иә! Хмм!
Dialogue: 0,0:18:31.23,0:18:32.11,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:32.23,0:18:33.32,Default,,0,0,0,,Уран! Нептун!
Dialogue: 0,0:18:33.61,0:18:34.98,Default,,0,0,0,,Ха! (Плутон) Ха...
Dialogue: 0,0:18:35.36,0:18:36.69,Default,,0,0,0,,Ахх...
Dialogue: 0,0:18:37.40,0:18:38.78,Default,,0,0,0,,Ннн…
Dialogue: 0,0:18:39.07,0:18:40.95,Default,,0,0,0,,Лента бұзғыш!
Dialogue: 0,0:18:42.16,0:18:46.33,Default,,0,0,0,,Марс жыланының оты!
Dialogue: 0,0:18:48.16,0:18:49.12,Default,,0,0,0,,Чи…
Dialogue: 0,0:18:51.88,0:18:54.13,Default,,0,0,0,,Балалар мұнда неге келдіңдер...
Dialogue: 0,0:18:54.21,0:18:55.17,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,0:18:55.84,0:18:57.42,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін!
Dialogue: 0,0:18:58.72,0:18:59.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:59.97,0:19:00.97,Default,,0,0,0,,Уф…
Dialogue: 0,0:19:03.05,0:19:04.35,Default,,0,0,0,,Ухуху…
Dialogue: 0,0:19:05.76,0:19:06.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:10.31,0:19:11.44,Default,,0,0,0,,Ахх...
Dialogue: 0,0:19:12.44,0:19:16.44,Default,,0,0,0,,Сонымен... балалар, сонша өлгіңіз келе ме?
Dialogue: 0,0:19:16.86,0:19:19.36,Default,,0,0,0,,Онда біз сен үшін күресеміз.
Dialogue: 0,0:19:19.49,0:19:21.07,Default,,0,0,0,,Мен сенен құтыламын.
Dialogue: 0,0:19:21.41,0:19:22.95,Default,,0,0,0,,Сізге қарсылас болайық!
Dialogue: 0,0:19:27.95,0:19:29.50,Default,,0,0,0,,үшінна не болды!?
Dialogue: 0,0:19:29.75,0:19:30.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:31.54,0:19:32.75,Default,,0,0,0,,үшінна!
Dialogue: 0,0:19:33.83,0:19:34.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:36.55,0:19:37.42,Default,,0,0,0,,Ннн!
Dialogue: 0,0:19:39.17,0:19:41.59,Default,,0,0,0,,Ха! Хмм... мммм!
Dialogue: 0,0:19:41.76,0:19:45.14,Default,,0,0,0,,Меркурий аквамист!
Dialogue: 0,0:19:45.80,0:19:47.68,Default,,0,0,0,,Жану…
Dialogue: 0,0:19:48.47,0:19:50.02,Default,,0,0,0,,Мандала!
Dialogue: 0,0:19:51.69,0:19:54.86,Default,,0,0,0,,Венера мені жақсы көреді!
Dialogue: 0,0:19:55.02,0:19:56.32,Default,,0,0,0,,Ия... (Нептун) Ия!
Dialogue: 0,0:19:58.69,0:20:01.78,Default,,0,0,0,,Уран! Нептун! Плутон!
Dialogue: 0,0:20:01.99,0:20:02.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:03.86,0:20:05.53,Default,,0,0,0,,үшінна! Тоқта!
Dialogue: 0,0:20:05.95,0:20:11.21,Default,,0,0,0,,Менің сиқырым - жүрегімнің тереңінде ұялаған қара жүректі күшейту.
Dialogue: 0,0:20:11.46,0:20:14.21,Default,,0,0,0,,Шынайы сезімдеріңізді ашыңыз және бір-біріңізді каннибализмге айналдырыңыз!
Dialogue: 0,0:20:14.37,0:20:16.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:17.88,0:20:19.67,Default,,0,0,0,,...
Dialogue: 0,0:20:20.92,0:20:25.84,Default,,0,0,0,,Таяқшама қуат бер Жүрек Ай Таяқ!
Dialogue: 0,0:20:30.85,0:20:34.27,Default,,0,0,0,,Ай спиралы...
Dialogue: 0,0:20:34.44,0:20:36.61,Default,,0,0,0,,Инфаркт!
Dialogue: 0,0:20:45.49,0:20:46.49,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:47.41,0:20:50.87,Default,,0,0,0,,Мен Cyplin және Petit Lol
Dialogue: 0,0:20:50.99,0:20:52.87,Default,,0,0,0,,Екі адам, бір бақсы
Dialogue: 0,0:20:53.00,0:20:53.91,Default,,0,0,0,,(Нацуо) Қоғам оның анама және ағаларына не істегенін білмейді—
Dialogue: 0,0:20:54.08,0:20:54.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:55.42,0:20:57.08,Default,,0,0,0,,Тайолон кристалы қайда орналасқан?
Dialogue: 0,0:20:57.21,0:20:59.46,Default,,0,0,0,,Бұл жақын жердегі қуат па? циплин
Dialogue: 0,0:21:00.34,0:21:03.76,Default,,0,0,0,,Бәрің, ояныңдар! Ұрыспа!
Dialogue: 0,0:21:06.01,0:21:09.35,Default,,0,0,0,,Қызғылт қант…
Dialogue: 0,0:21:09.89,0:21:12.22,Default,,0,0,0,,Инфаркт!
Dialogue: 0,0:21:14.10,0:21:15.69,Default,,0,0,0,,Кедергі жасамаңыз!
Dialogue: 0,0:21:15.89,0:21:17.48,Default,,0,0,0,,Иә! (Чиби Мун) Уу...
Dialogue: 0,0:21:18.69,0:21:20.77,Default,,0,0,0,,Стокседо маскасы! Чиби Мун!
Dialogue: 0,0:21:21.98,0:21:23.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:23.69,0:21:25.53,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:21:26.70,0:21:29.53,Default,,0,0,0,,Неге соғысуымыз керек?
Dialogue: 0,0:21:30.70,0:21:33.70,Default,,0,0,0,,Әркімнің жүрегінде бір-біріне жау болғаны ма?
Dialogue: 0,0:21:34.83,0:21:35.75,Default,,0,0,0,,Бұл Музан мырза…
Dialogue: 0,0:21:36.46,0:21:39.17,Default,,0,0,0,,Үш адам бізге көмектесті.
Dialogue: 0,0:21:39.33,0:21:41.63,Default,,0,0,0,,Ол мені үнемі бақылап отырды.
Dialogue: 0,0:21:42.42,0:21:45.09,Default,,0,0,0,,Маңызды нәрсені қорғау үшін күресіңіз
Dialogue: 0,0:21:45.59,0:21:48.89,Default,,0,0,0,,Біз де сол мақсат үшін күресуіміз керек!
Dialogue: 0,0:21:51.43,0:21:52.26,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:53.14,0:21:53.97,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:54.39,0:21:55.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:56.73,0:21:58.81,Default,,0,0,0,,Бір жүрекпен...
Dialogue: 0,0:22:06.15,0:22:08.24,Default,,0,0,0,,Ха…
Dialogue: 0,0:22:14.58,0:22:16.00,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:22:16.75,0:22:18.62,Default,,0,0,0,,Маған күшіңді бер!
Dialogue: 0,0:22:21.13,0:22:27.13,Default,,0,0,0,,♪〜
Dialogue: 0,0:23:48.30,0:23:50.30,Default,,0,0,0,,〜♪
Dialogue: 0,0:23:52.38,0:23:54.43,Default,,0,0,0,,үшінның жүрегімен бір кісідей күрес
Dialogue: 0,0:23:54.59,0:23:56.76,Default,,0,0,0,,Бұл біз, матрос Сенши!
Dialogue: 0,0:23:57.10,0:24:02.14,Default,,0,0,0,,Келесі акт.33 «Шексіз 7 трансформациясы SUPER SILORMOON»
Dialogue: 0,0:24:02.52,0:24:04.52,Default,,0,0,0,,Ай сәулесі - махаббат хабары
Dialogue: 0,0:24:06.02,0:24:12.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
