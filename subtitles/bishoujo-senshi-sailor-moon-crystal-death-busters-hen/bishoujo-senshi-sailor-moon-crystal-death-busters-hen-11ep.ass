Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.84,0:00:10.80,Default,,0,0,0,,Ха... бұл...
Dialogue: 0,0:00:11.63,0:00:14.05,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:00:14.38,0:00:16.68,Default,,0,0,0,,Ха... Хотару-чан!
Dialogue: 0,0:00:16.85,0:00:17.72,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:00:22.10,0:00:24.06,Default,,0,0,0,,Кеңістікте ауытқу бар.
Dialogue: 0,0:00:26.52,0:00:29.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:31.03,0:00:32.61,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:33.03,0:00:33.99,Default,,0,0,0,,Хотару-чан...
Dialogue: 0,0:00:35.32,0:00:37.70,Default,,0,0,0,,Жоқ. Бұл сурет...
Dialogue: 0,0:00:38.53,0:00:40.29,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:00:48.50,0:00:50.96,Default,,0,0,0,,А... Ууууууу!
Dialogue: 0,0:00:51.13,0:00:52.34,Default,,0,0,0,,Ннн…
Dialogue: 0,0:01:05.14,0:01:06.60,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:07.44,0:01:11.19,Default,,0,0,0,,Меркурий! Марс! Юпитер! Венера!
Dialogue: 0,0:01:11.57,0:01:13.57,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:01:14.74,0:01:17.32,Default,,0,0,0,,Жоқ... Мен жақындай алмаймын.
Dialogue: 0,0:01:17.49,0:01:18.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:26.00,0:01:27.33,Default,,0,0,0,,Хмм... бұл...
Dialogue: 0,0:01:27.96,0:01:30.54,Default,,0,0,0,,Мен енді Хотару-чан емеспін!
Dialogue: 0,0:01:31.59,0:01:35.51,Default,,0,0,0,,А... хех хе...
Dialogue: 0,0:01:35.97,0:01:41.30,Default,,0,0,0,,♪〜
Dialogue: 0,0:02:59.84,0:03:05.60,Default,,0,0,0,,〜♪
Dialogue: 0,0:03:11.98,0:03:13.56,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:03:16.69,0:03:20.24,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:03:22.53,0:03:25.12,Default,,0,0,0,,Мен бұны күтпедім... Нһ!
Dialogue: 0,0:03:25.87,0:03:28.29,Default,,0,0,0,,Теңіз бұрқырай бастады...
Dialogue: 0,0:03:29.04,0:03:31.96,Default,,0,0,0,,Аспан... Дауыл келе ме?
Dialogue: 0,0:03:32.58,0:03:34.83,Default,,0,0,0,,Кеңістік-уақыттың бұрмалануы кеңейеді
Dialogue: 0,0:03:40.26,0:03:42.22,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:03:42.47,0:03:44.14,Default,,0,0,0,,Уақыт келді!
Dialogue: 0,0:03:44.30,0:03:45.43,Default,,0,0,0,,Қазір уақыт —
Dialogue: 0,0:03:45.55,0:03:51.81,Default,,0,0,0,,Қуатты жинаған 90-шы перғауын осы планетамен ассимиляцияланады...
Dialogue: 0,0:03:51.98,0:03:54.48,Default,,0,0,0,,Аспаптардың уақыты келді!
Dialogue: 0,0:03:56.02,0:03:58.61,Default,,0,0,0,,Құралға айналу... Мұндай нәрсе...
Dialogue: 0,0:03:59.03,0:04:02.82,Default,,0,0,0,,Перғауын 90 – біздің қожайынымыз
Dialogue: 0,0:04:02.95,0:04:09.04,Default,,0,0,0,,Шебердің трансформациясы аяқталғаннан кейін бұл жер екінші Тау жүйесіне айналады.
Dialogue: 0,0:04:10.66,0:04:14.42,Default,,0,0,0,,Бұл жұлдыз біздің планетамызға айналады!
Dialogue: 0,0:04:14.58,0:04:15.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:18.50,0:04:20.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:21.30,0:04:22.63,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:04:22.97,0:04:26.01,Default,,0,0,0,,Уран Нептун Плутон!
Dialogue: 0,0:04:26.93,0:04:27.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:28.05,0:04:28.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:29.10,0:04:30.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:30.18,0:04:34.06,Default,,0,0,0,,Үшеуміздің күшімізбен оның шабуылын тоқтата аламыз!
Dialogue: 0,0:04:35.23,0:04:38.73,Default,,0,0,0,,Neo Queen Serenity жақында билік етеді!
Dialogue: 0,0:04:40.73,0:04:43.78,Default,,0,0,0,,Бұл біздің патшайым дүниеге келген планета!
Dialogue: 0,0:04:45.70,0:04:47.78,Default,,0,0,0,,Жаңа күміс мыңжылдық және
Dialogue: 0,0:04:47.91,0:04:49.95,Default,,0,0,0,,Біз бұл планетаны қорғауымыз керек!
Dialogue: 0,0:04:50.12,0:04:53.04,Default,,0,0,0,,Бұл біздің миссиямыз!
Dialogue: 0,0:05:07.30,0:05:08.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:08.72,0:05:09.89,Default,,0,0,0,,Ннн!
Dialogue: 0,0:05:10.05,0:05:11.26,Default,,0,0,0,,Ннн!
Dialogue: 0,0:05:11.43,0:05:14.23,Default,,0,0,0,,Қарғыс атсын... Шлагбаум қойдың ба...
Dialogue: 0,0:05:14.35,0:05:15.81,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:15.98,0:05:18.56,Default,,0,0,0,,Бірақ бұл пайдасыз...
Dialogue: 0,0:05:20.32,0:05:21.52,Default,,0,0,0,,Уууу…
Dialogue: 0,0:05:21.65,0:05:25.03,Default,,0,0,0,,Шебердің аспапқа айналуына санаулы күндер қалды
Dialogue: 0,0:05:25.15,0:05:29.24,Default,,0,0,0,,Енді адам денесінің ішінде болу қажет емес...
Dialogue: 0,0:05:29.41,0:05:30.62,Default,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,0:05:32.33,0:05:33.45,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:37.21,0:05:38.75,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:05:40.67,0:05:41.63,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:05:41.75,0:05:44.09,Default,,0,0,0,,Бұлай жалғаса берсе, Хотару-чанның денесі...
Dialogue: 0,0:05:44.26,0:05:46.01,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:05:46.17,0:05:48.30,Default,,0,0,0,,А... хех хе...
Dialogue: 0,0:05:48.43,0:05:49.26,Default,,0,0,0,,Ха…
Dialogue: 0,0:05:49.59,0:05:52.26,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:05:52.81,0:05:55.10,Default,,0,0,0,,Бостандық жоқ...
Dialogue: 0,0:05:55.22,0:05:57.69,Default,,0,0,0,,Денемнен шыға алмаймын...
Dialogue: 0,0:05:58.31,0:05:59.98,Default,,0,0,0,,Оны жіберіп алмаңыз!
Dialogue: 0,0:06:00.15,0:06:02.15,Default,,0,0,0,,Хмм... бұл кім!?
Dialogue: 0,0:06:02.77,0:06:05.86,Default,,0,0,0,,Бұл дене әлі де менің денем!
Dialogue: 0,0:06:05.99,0:06:08.24,Default,,0,0,0,,Мен саған ештеңе істеуге рұқсат бермеймін!
Dialogue: 0,0:06:08.40,0:06:11.41,Default,,0,0,0,,Мен сені бұл жағдайдан шығармаймын!
Dialogue: 0,0:06:11.57,0:06:17.62,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:06:19.54,0:06:22.00,Default,,0,0,0,,Ха... хех хе...
Dialogue: 0,0:06:23.21,0:06:26.13,Default,,0,0,0,,Баяғыда ризығыма айналды.
Dialogue: 0,0:06:26.26,0:06:28.59,Default,,0,0,0,,Мен оны жоғалып кетті деп ойладым...
Dialogue: 0,0:06:28.72,0:06:31.26,Default,,0,0,0,,Ол әлі тірі ме?
Dialogue: 0,0:06:35.64,0:06:36.39,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:37.64,0:06:41.69,Default,,0,0,0,,Мен елес күміс кристалды жұтып, күштірек болдым.
Dialogue: 0,0:06:41.81,0:06:44.90,Default,,0,0,0,,Бұл сіз басқара алатын нәрсе ме...
Dialogue: 0,0:06:45.44,0:06:47.57,Default,,0,0,0,,Кішкентай Евхаристия сияқты!
Dialogue: 0,0:06:47.69,0:06:50.57,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:06:52.12,0:06:52.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:56.16,0:07:00.04,Default,,0,0,0,,Жоқ... Бұлай жалғаса берсе, Хотару-чанның денесі...
Dialogue: 0,0:07:00.16,0:07:01.33,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:07:01.46,0:07:02.54,Default,,0,0,0,,Ннн!
Dialogue: 0,0:07:04.38,0:07:06.17,Default,,0,0,0,,...
Dialogue: 0,0:07:07.34,0:07:12.09,Default,,0,0,0,,Таяқшама қуат бер Жүрек Ай Таяқ!
Dialogue: 0,0:07:17.60,0:07:21.23,Default,,0,0,0,,Ай спиралы...
Dialogue: 0,0:07:21.35,0:07:23.60,Default,,0,0,0,,Инфаркт!
Dialogue: 0,0:07:30.24,0:07:31.57,Default,,0,0,0,,(Полиция қызметкері) Бізді сатқанымен, олар біздің одақтастарымызға айналды деген сөз емес
Dialogue: 0,0:07:31.70,0:07:33.03,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:07:35.99,0:07:38.04,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:07:38.16,0:07:39.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:40.79,0:07:43.33,Default,,0,0,0,,Айдың спиральды инфарктісі...
Dialogue: 0,0:07:44.33,0:07:45.33,Default,,0,0,0,,Бұл жұмыс істемейді!
Dialogue: 0,0:07:45.50,0:07:48.42,Default,,0,0,0,,Мен ешкімге жол бермеймін
Dialogue: 0,0:07:48.84,0:07:52.59,Default,,0,0,0,,Мен бұл бүкіл денені жұлып аламын және оны бөліктерге айналдырамын!
Dialogue: 0,0:07:52.72,0:07:55.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:58.14,0:08:00.18,Default,,0,0,0,,Ол құлап кететін сияқты...
Dialogue: 0,0:08:00.31,0:08:02.81,Default,,0,0,0,,Денесі жарылған...
Dialogue: 0,0:08:03.90,0:08:05.15,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:08.52,0:08:12.36,Default,,0,0,0,,Чибиуса-чанның жаны және елес күміс кристалы...
Dialogue: 0,0:08:12.49,0:08:15.45,Default,,0,0,0,,Мен сені еш нәрсеге қарамастан қорғаймын
Dialogue: 0,0:08:16.16,0:08:19.45,Default,,0,0,0,,Сіз жеңілетініңізге сенімдісіз бе?
Dialogue: 0,0:08:20.45,0:08:24.17,Default,,0,0,0,,Мен елес күміс кристалдан қуат ала алмаймын...
Dialogue: 0,0:08:24.29,0:08:27.04,Default,,0,0,0,,Nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn...
Dialogue: 0,0:08:27.34,0:08:29.75,Default,,0,0,0,,Мен саған жол бермеймін!
Dialogue: 0,0:08:30.09,0:08:32.17,Default,,0,0,0,,Көбірек қуат!
Dialogue: 0,0:08:32.34,0:08:34.84,Default,,0,0,0,,Теңізші жауынгерлердің киелі денесі!
Dialogue: 0,0:08:37.97,0:08:38.80,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:39.76,0:08:40.77,Default,,0,0,0,,Меркурий!
Dialogue: 0,0:08:41.68,0:08:42.52,Default,,0,0,0,,Юпитер!
Dialogue: 0,0:08:43.27,0:08:44.27,Default,,0,0,0,,Марс!
Dialogue: 0,0:08:44.94,0:08:45.90,Default,,0,0,0,,Венера!
Dialogue: 0,0:08:48.11,0:08:49.48,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:08:49.94,0:08:51.57,Default,,0,0,0,,Ммм... Нмм...
Dialogue: 0,0:08:51.86,0:08:53.78,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:08:54.36,0:08:57.20,Default,,0,0,0,,Барлығың, берік болыңдар!
Dialogue: 0,0:08:57.53,0:08:58.78,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:08:59.28,0:09:01.74,Default,,0,0,0,,Төрт жанды ұрлады!?
Dialogue: 0,0:09:04.29,0:09:05.67,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:06.21,0:09:07.04,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:09:07.21,0:09:09.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:13.01,0:09:13.92,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:15.01,0:09:18.22,Default,,0,0,0,,Евхаристияда 4 адам болады деп ойламадым...
Dialogue: 0,0:09:18.72,0:09:20.26,Default,,0,0,0,,Оны ешқашан бермеңіз!
Dialogue: 0,0:09:21.43,0:09:22.81,Default,,0,0,0,,Ннн!
Dialogue: 0,0:09:23.35,0:09:25.48,Default,,0,0,0,,Ннн!
Dialogue: 0,0:09:25.60,0:09:28.52,Default,,0,0,0,,Сен тітіркендіргіш жәндік!
Dialogue: 0,0:09:28.65,0:09:31.48,Default,,0,0,0,,Маған Евхаристияны беріңіз!
Dialogue: 0,0:09:31.86,0:09:33.78,Default,,0,0,0,,Ух... Ааа!
Dialogue: 0,0:09:34.03,0:09:35.24,Default,,0,0,0,,Ах! Құдай-ай!
Dialogue: 0,0:09:35.36,0:09:42.16,Default,,0,0,0,,Менің күшіммен, елес күміс кристалды, Чибиусаның және төрт жауынгердің жаны...
Dialogue: 0,0:09:42.74,0:09:44.75,Default,,0,0,0,,Қорғау мүмкін болмауы мүмкін...
Dialogue: 0,0:09:45.25,0:09:46.08,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:48.75,0:09:50.13,Default,,0,0,0,,Ғажайып...
Dialogue: 0,0:09:51.38,0:09:54.13,Default,,0,0,0,,Мен тек жанға айналдым...
Dialogue: 0,0:09:55.05,0:09:57.47,Default,,0,0,0,,Менің де денемді басып алды
Dialogue: 0,0:09:58.34,0:10:01.22,Default,,0,0,0,,Бұл менің өлгенімді білдіреді...
Dialogue: 0,0:10:03.35,0:10:05.85,Default,,0,0,0,,Бірақ мен неге...
Dialogue: 0,0:10:06.43,0:10:08.89,Default,,0,0,0,,Сіз қатты жұмыс істеп жатырсыз ба?
Dialogue: 0,0:10:10.86,0:10:12.82,Default,,0,0,0,,Әкем де кетті.
Dialogue: 0,0:10:13.40,0:10:15.82,Default,,0,0,0,,Менде ештеңе болмаса да...
Dialogue: 0,0:10:17.28,0:10:22.12,Default,,0,0,0,,Бірақ неге менде әлі күш жоқ?
Dialogue: 0,0:10:23.58,0:10:26.54,Default,,0,0,0,,Мен осыншама күшті болдым ба деп ойлаймын...
Dialogue: 0,0:10:27.87,0:10:29.08,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:31.21,0:10:32.88,Default,,0,0,0,,Чибиуса-чан...
Dialogue: 0,0:10:34.75,0:10:39.22,Default,,0,0,0,,Мен ішімде басқа, үлкенірек «менді» сезінемін.
Dialogue: 0,0:10:39.72,0:10:40.72,Default,,0,0,0,,Мен —
Dialogue: 0,0:10:41.30,0:10:46.39,Default,,0,0,0,,Онда: «Барлығыңызбен барлығына көмектесіңіз» делінген.
Dialogue: 0,0:10:46.77,0:10:50.39,Default,,0,0,0,,Сонымен... мен енді не істей аламын...
Dialogue: 0,0:10:50.52,0:10:55.82,Default,,0,0,0,,Бұл бес адамның жаны және елес күміс кристалл...
Dialogue: 0,0:10:56.23,0:10:58.32,Default,,0,0,0,,Бұл жерден кет!
Dialogue: 0,0:11:10.87,0:11:14.29,Default,,0,0,0,,Сонымен... мен енді не істей аламын...
Dialogue: 0,0:11:16.71,0:11:17.76,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:20.72,0:11:21.88,Default,,0,0,0,,Не!?
Dialogue: 0,0:11:23.76,0:11:26.06,Default,,0,0,0,,Евхаристі түгелдей алып кетті!
Dialogue: 0,0:11:27.43,0:11:30.14,Default,,0,0,0,,Ия... Бірақ...
Dialogue: 0,0:11:31.19,0:11:33.56,Default,,0,0,0,,Қазір мен босмын
Dialogue: 0,0:11:33.73,0:11:36.07,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:11:39.94,0:11:40.78,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:42.86,0:11:43.70,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:11:43.86,0:11:45.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:46.12,0:11:48.49,Default,,0,0,0,,Сіз денеңізге оралдыңыз!
Dialogue: 0,0:11:48.91,0:11:50.45,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:51.29,0:11:52.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:52.75,0:11:54.75,Default,,0,0,0,,Я...
Dialogue: 0,0:11:55.54,0:11:56.59,Default,,0,0,0,,Хотару-чан
Dialogue: 0,0:11:56.71,0:11:58.30,Default,,0,0,0,,Сіз мені құтқардыңыз.
Dialogue: 0,0:11:58.42,0:11:59.55,Default,,0,0,0,,Бізге…
Dialogue: 0,0:11:59.67,0:12:00.84,Default,,0,0,0,,Жан...
Dialogue: 0,0:12:00.97,0:12:02.30,Default,,0,0,0,,9 ханымнан...
Dialogue: 0,0:12:03.22,0:12:04.22,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:12:07.26,0:12:09.52,Default,,0,0,0,,А, күте тұрыңыз, Хотару-чан!
Dialogue: 0,0:12:12.64,0:12:13.60,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:17.94,0:12:19.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:20.19,0:12:21.40,Default,,0,0,0,,Сен…
Dialogue: 0,0:12:29.58,0:12:31.79,Default,,0,0,0,,Ахх... (Мамору) Чибиуса!
Dialogue: 0,0:12:32.41,0:12:34.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:37.29,0:12:39.04,Default,,0,0,0,,Мамо...чан...
Dialogue: 0,0:12:39.21,0:12:41.51,Default,,0,0,0,,Чибиуса Жақсы...
Dialogue: 0,0:12:41.63,0:12:43.22,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:45.51,0:12:46.80,Default,,0,0,0,,Хотару-чан!
Dialogue: 0,0:12:46.93,0:12:52.06,Default,,0,0,0,,Чибиуса-чанға көмектесе алғаныма қуаныштымын.
Dialogue: 0,0:12:53.18,0:12:57.10,Default,,0,0,0,,Екеуміз де қыз болғандықтан біртүрлі шығар...
Dialogue: 0,0:12:58.36,0:13:00.82,Default,,0,0,0,,Бұл тағдырлы кездесу деп ойладым
Dialogue: 0,0:13:00.94,0:13:02.23,Default,,0,0,0,,Мен де...
Dialogue: 0,0:13:02.57,0:13:05.65,Default,,0,0,0,,Мен солай ойладым, Хотару-чан!
Dialogue: 0,0:13:05.78,0:13:07.32,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:13:13.54,0:13:15.04,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:13:15.21,0:13:18.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:19.46,0:13:20.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:20.88,0:13:21.71,Default,,0,0,0,,Хотару-чан!
Dialogue: 0,0:13:25.42,0:13:27.80,Default,,0,0,0,,Танысқаныма қуаныштымын...
Dialogue: 0,0:13:29.39,0:13:33.56,Default,,0,0,0,,Дос болғанымызға өте қуаныштымын...
Dialogue: 0,0:13:34.73,0:13:37.65,Default,,0,0,0,,Мен туралы, Чибиуса-чан...
Dialogue: 0,0:13:37.81,0:13:39.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:39.73,0:13:41.19,Default,,0,0,0,,Мен сені жақсы көремін...
Dialogue: 0,0:13:42.61,0:13:43.73,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:45.07,0:13:47.03,Default,,0,0,0,,Хо… Хотару-чан…
Dialogue: 0,0:13:48.66,0:13:51.49,Default,,0,0,0,,Рахмет Чибиуса-чан...
Dialogue: 0,0:13:52.91,0:13:53.95,Default,,0,0,0,,Қош бол...
Dialogue: 0,0:13:54.08,0:13:55.12,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:55.25,0:13:58.08,Default,,0,0,0,,О, күте тұрыңыз! Жоғалып кетпеңіз!
Dialogue: 0,0:13:58.37,0:13:59.83,Default,,0,0,0,,Хотару-чан!
Dialogue: 0,0:14:01.96,0:14:03.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:05.55,0:14:07.68,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:14:07.80,0:14:10.43,Default,,0,0,0,,Бұл... осылай...
Dialogue: 0,0:14:11.51,0:14:14.39,Default,,0,0,0,,Сондай аянышты тағдыр бар...
Dialogue: 0,0:14:14.52,0:14:16.27,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:14:16.39,0:14:17.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:19.06,0:14:20.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:24.07,0:14:25.07,Default,,0,0,0,,Чибиуса...
Dialogue: 0,0:14:25.23,0:14:26.57,Default,,0,0,0,,(Чибиусаның айқайы)
Dialogue: 0,0:14:26.69,0:14:30.07,Default,,0,0,0,,Сіз Сейлор Мунға көмектесіп, бірге күресе аласыз ба?
Dialogue: 0,0:14:30.20,0:14:31.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:34.37,0:14:35.41,Default,,0,0,0,,Чибиуса...
Dialogue: 0,0:14:35.83,0:14:37.00,Default,,0,0,0,,Уууу…
Dialogue: 0,0:14:38.79,0:14:40.62,Default,,0,0,0,,Nnn… nn…
Dialogue: 0,0:14:41.67,0:14:43.00,Default,,0,0,0,,Ннн…
Dialogue: 0,0:14:43.63,0:14:45.05,Default,,0,0,0,,Мен күресе аламын...
Dialogue: 0,0:14:45.46,0:14:46.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:46.46,0:14:48.97,Default,,0,0,0,,Жоқ, ұрысайық.
Dialogue: 0,0:14:49.09,0:14:52.47,Default,,0,0,0,,Хотару-чан мені осы өмірмен құтқарды!
Dialogue: 0,0:14:55.47,0:14:56.68,Default,,0,0,0,,Мен енді жыламаймын
Dialogue: 0,0:14:58.23,0:15:00.69,Default,,0,0,0,,Мен де матрос жауынгермін!
Dialogue: 0,0:15:02.19,0:15:04.23,Default,,0,0,0,,Ай призмасының күші!
Dialogue: 0,0:15:04.36,0:15:06.36,Default,,0,0,0,,Макияж!
Dialogue: 0,0:15:30.38,0:15:34.39,Default,,0,0,0,,Мамо-чан, күш-жігеріңіз үшін рахмет!
Dialogue: 0,0:15:35.01,0:15:38.39,Default,,0,0,0,,Мен Сейлор Мун сияқты күшті болмасам да...
Dialogue: 0,0:15:38.93,0:15:41.89,Default,,0,0,0,,Бар күшімді салып, бірге күресемін!
Dialogue: 0,0:15:44.69,0:15:48.19,Default,,0,0,0,,Аа... Қызымды күйеуге шығарып жатқан сияқтымын.
Dialogue: 0,0:15:48.94,0:15:49.82,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:50.19,0:15:53.61,Default,,0,0,0,,Бұл біртүрлі. Белгілі бір себептермен қуат толып кетеді.
Dialogue: 0,0:15:54.32,0:15:57.87,Default,,0,0,0,,Мен Чибиусадан қуат алған сияқтымын...
Dialogue: 0,0:15:59.08,0:16:01.46,Default,,0,0,0,,Ал Хотару-чанның күші...
Dialogue: 0,0:16:03.29,0:16:05.71,Default,,0,0,0,,Қоян! Мен де бірден барамын
Dialogue: 0,0:16:17.26,0:16:22.10,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:16:22.27,0:16:24.81,Default,,0,0,0,,Ах... (Юпитер) Біртүрлі болып көрінеді.
Dialogue: 0,0:16:25.27,0:16:27.36,Default,,0,0,0,,Уау...
Dialogue: 0,0:16:27.48,0:16:29.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:30.07,0:16:34.78,Default,,0,0,0,,Үлкен болып барады... Оның құдіреті барған сайын үлкейеді.
Dialogue: 0,0:16:36.74,0:16:41.04,Default,,0,0,0,,Бұл күш! Күміс кристалдың күші!
Dialogue: 0,0:16:41.45,0:16:42.58,Default,,0,0,0,,Ннн…
Dialogue: 0,0:16:43.08,0:16:45.71,Default,,0,0,0,,Оны маған беріңіз!
Dialogue: 0,0:16:47.42,0:16:49.55,Default,,0,0,0,,Юпитер кокосы…
Dialogue: 0,0:16:50.30,0:16:51.30,Default,,0,0,0,,Циклон!
Dialogue: 0,0:16:52.92,0:16:57.47,Default,,0,0,0,,Марс жыланының оты!
Dialogue: 0,0:16:59.14,0:17:03.77,Default,,0,0,0,,Су Миражы (Mercury Aqua Mirage)!
Dialogue: 0,0:17:05.10,0:17:06.27,Default,,0,0,0,,Венера…
Dialogue: 0,0:17:08.77,0:17:12.65,Default,,0,0,0,,Шынжырлы қылыш көзді қысыңыз!
Dialogue: 0,0:17:16.86,0:17:18.74,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:17:19.53,0:17:20.70,Default,,0,0,0,,Ахх...
Dialogue: 0,0:17:21.37,0:17:22.45,Default,,0,0,0,,Ннн!
Dialogue: 0,0:17:22.62,0:17:23.62,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:25.29,0:17:28.25,Default,,0,0,0,,Қызғылт қант…
Dialogue: 0,0:17:28.79,0:17:31.67,Default,,0,0,0,,Инфаркт!
Dialogue: 0,0:17:32.76,0:17:34.01,Default,,0,0,0,,Уф! Уууу...
Dialogue: 0,0:17:34.30,0:17:35.92,Default,,0,0,0,,Ахх...
Dialogue: 0,0:17:37.13,0:17:38.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:39.01,0:17:41.85,Default,,0,0,0,,Уау... болмайды...
Dialogue: 0,0:17:44.60,0:17:48.31,Default,,0,0,0,,Сейлор Чиби Мун Ояндың!
Dialogue: 0,0:17:49.06,0:17:50.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:50.56,0:17:53.23,Default,,0,0,0,,Маған Хотару-чан көмектесті.
Dialogue: 0,0:17:55.99,0:17:57.95,Default,,0,0,0,,Барлығын сызыққа қойыңыз...
Dialogue: 0,0:17:58.07,0:17:59.66,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:17:59.82,0:18:02.45,Default,,0,0,0,,Сіз мені қорғадыңыз!
Dialogue: 0,0:18:03.58,0:18:05.12,Default,,0,0,0,,Өйткені ол
Dialogue: 0,0:18:06.04,0:18:07.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:09.42,0:18:10.42,Default,,0,0,0,,Хотару-чан...
Dialogue: 0,0:18:11.17,0:18:12.50,Default,,0,0,0,,Ол кетті...
Dialogue: 0,0:18:14.38,0:18:15.76,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:18:17.26,0:18:19.55,Default,,0,0,0,,Хотару-чан осында.
Dialogue: 0,0:18:19.72,0:18:22.60,Default,,0,0,0,,Ха... (Чиби Мун) Біздің ішімізде!
Dialogue: 0,0:18:23.85,0:18:25.43,Default,,0,0,0,,Біздің…
Dialogue: 0,0:18:27.35,0:18:30.98,Default,,0,0,0,,Хотару-чан осында.
Dialogue: 0,0:18:31.40,0:18:32.69,Default,,0,0,0,,Мұнда…
Dialogue: 0,0:18:34.11,0:18:35.48,Default,,0,0,0,,Ннн…
Dialogue: 0,0:18:35.90,0:18:37.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:38.57,0:18:42.53,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:18:47.54,0:18:48.58,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:49.87,0:18:52.58,Default,,0,0,0,,Кешіріңіз! Өтінемін, мені кешірші!
Dialogue: 0,0:18:53.42,0:18:57.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:58.05,0:18:59.63,Default,,0,0,0,,Ха…
Dialogue: 0,0:18:59.80,0:19:01.64,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:07.39,0:19:08.56,Default,,0,0,0,,Ах, ол біте салысымен —
Dialogue: 0,0:19:08.73,0:19:10.31,Default,,0,0,0,,Әй, Мамо-чан!
Dialogue: 0,0:19:11.31,0:19:12.52,Default,,0,0,0,,Стокседо маскасы!
Dialogue: 0,0:19:12.98,0:19:14.57,Default,,0,0,0,,Кедергі ұзаққа созылмайды!
Dialogue: 0,0:19:14.69,0:19:18.32,Default,,0,0,0,,Жалқаулықпен жүрсек, бұл планетаны әлгі жігіт тоздырады!
Dialogue: 0,0:19:18.61,0:19:19.78,Default,,0,0,0,,Ннн…
Dialogue: 0,0:19:19.95,0:19:21.66,Default,,0,0,0,,(үру)
Dialogue: 0,0:19:21.78,0:19:23.62,Default,,0,0,0,,Оны тез жең!
Dialogue: 0,0:19:23.91,0:19:26.49,Default,,0,0,0,,Супер Сейлор Мунға айналу
Dialogue: 0,0:19:26.91,0:19:29.58,Default,,0,0,0,,Иә! Мен оны қорғауым керек!
Dialogue: 0,0:19:31.17,0:19:34.79,Default,,0,0,0,,Сондай-ақ бізге өмір сыйлаған Хотару-чанға!
Dialogue: 0,0:19:36.00,0:19:37.67,Default,,0,0,0,,Бұл жұлдыз...
Dialogue: 0,0:19:38.46,0:19:39.92,Default,,0,0,0,,Біз құтқаруымыз керек!
Dialogue: 0,0:19:40.76,0:19:42.05,Default,,0,0,0,,Барлығына! (Барлығы) Иә!
Dialogue: 0,0:19:42.80,0:19:44.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:45.55,0:19:46.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:49.77,0:19:51.27,Default,,0,0,0,,Ай тостаған!
Dialogue: 0,0:19:51.64,0:19:53.73,Default,,0,0,0,,Шық, қолыма ал!
Dialogue: 0,0:19:54.52,0:19:58.61,Default,,0,0,0,,Бірге жинал, киелі жауынгерлердің киелі күші!
Dialogue: 0,0:20:01.99,0:20:03.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:17.29,0:20:18.80,Default,,0,0,0,,Сейлор Мун…
Dialogue: 0,0:20:19.63,0:20:21.76,Default,,0,0,0,,Мен де күшті болғым келеді
Dialogue: 0,0:20:22.55,0:20:24.38,Default,,0,0,0,,Мен де бір күні...
Dialogue: 0,0:20:24.84,0:20:26.51,Default,,0,0,0,,Сейлор Мун сияқты
Dialogue: 0,0:20:29.22,0:20:30.52,Default,,0,0,0,,Мен де...
Dialogue: 0,0:20:36.52,0:20:37.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:38.27,0:20:41.86,Default,,0,0,0,,Екі Ай тостаған...
Dialogue: 0,0:20:43.28,0:20:45.95,Default,,0,0,0,,Бұл... Кішкентай ханым
Dialogue: 0,0:20:46.07,0:20:48.41,Default,,0,0,0,,Сейлор Чиби Мунның ойлары—
Dialogue: 0,0:20:48.53,0:20:50.99,Default,,0,0,0,,Мен жаңа оянуды жігерлендіремін.
Dialogue: 0,0:20:52.91,0:20:55.71,Default,,0,0,0,,Сейлор Чиби Мунның өзгеруі!
Dialogue: 0,0:20:56.25,0:20:57.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:58.13,0:20:59.46,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:11.39,0:21:13.81,Default,,0,0,0,,Ай дағдарысы!
Dialogue: 0,0:21:13.93,0:21:15.85,Default,,0,0,0,,Макияж!
Dialogue: 0,0:21:44.21,0:21:45.47,Default,,0,0,0,,Сейлор Чиби Мун) Ах...
Dialogue: 0,0:21:47.88,0:21:49.59,Default,,0,0,0,,Чиби Мун!
Dialogue: 0,0:21:50.22,0:21:51.85,Default,,0,0,0,,Өзгертілді!
Dialogue: 0,0:21:52.01,0:21:54.52,Default,,0,0,0,,Ах... Кішкентай ханым
Dialogue: 0,0:21:55.77,0:21:57.27,Default,,0,0,0,,Бұл сурет...
Dialogue: 0,0:21:57.81,0:22:00.11,Default,,0,0,0,,Супер Сейлор Чиби Мун!
Dialogue: 0,0:22:00.23,0:22:01.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:22:01.23,0:22:03.03,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:22:03.15,0:22:04.48,Default,,0,0,0,,(үру)
Dialogue: 0,0:22:06.95,0:22:08.03,Default,,0,0,0,,Сейлор Мун) Кеттік.
Dialogue: 0,0:22:08.16,0:22:10.03,Default,,0,0,0,,Супер Сейлор Чиби Мун!
Dialogue: 0,0:22:10.57,0:22:13.33,Default,,0,0,0,,Иә! супер теңізші ай
Dialogue: 0,0:22:14.16,0:22:17.46,Default,,0,0,0,,Енді күш біріктірейік!
Dialogue: 0,0:22:21.08,0:22:27.09,Default,,0,0,0,,♪〜
Dialogue: 0,0:23:48.17,0:23:50.30,Default,,0,0,0,,〜♪
Dialogue: 0,0:23:51.88,0:23:55.72,Default,,0,0,0,,Біз жүрегімізде Хотару-чанның сезімімен күресеміз!
