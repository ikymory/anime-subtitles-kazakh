Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.43,0:00:17.35,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:20.52,0:00:21.52,Default,,0,0,0,,Жоғары мәртебелі
Dialogue: 0,0:00:22.10,0:00:23.98,Default,,0,0,0,,Мені «Сиқыр императоры» деп атаңыз
Dialogue: 0,0:00:24.44,0:00:26.44,Default,,0,0,0,,Келби табылды ма?
Dialogue: 0,0:00:27.06,0:00:30.78,Default,,0,0,0,,Сиқырлар патшасы, Локк, бұл Мадура қаласы...
Dialogue: 0,0:00:30.90,0:00:35.45,Default,,0,0,0,,Князьдің досы Робот пен жұмбақ құбыжық кескілескен шайқаста.
Dialogue: 0,0:00:35.78,0:00:38.66,Default,,0,0,0,,Осыдан кейін біз роботтың қайда екенін қадағалап жатырмыз.
Dialogue: 0,0:00:43.41,0:00:44.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:46.21,0:00:49.17,Default,,0,0,0,,Маған сенің қалай іздегенің бәрібір.
Dialogue: 0,0:00:49.29,0:00:50.63,Default,,0,0,0,,Бәрібір оны табыңыз
Dialogue: 0,0:00:51.38,0:00:55.84,Default,,0,0,0,,Енді мен үш патшалықтың әскерін өз қалауым бойынша басқара аламын.
Dialogue: 0,0:00:56.22,0:00:57.22,Default,,0,0,0,,Солдаттар арасынан...
Dialogue: 0,0:00:57.34,0:01:00.76,Default,,0,0,0,,Сіздің орнын басатын адамды табу оңай.
Dialogue: 0,0:01:01.01,0:01:03.68,Default,,0,0,0,,Анықтама алғанша бетіңізді көрсетпеңіз.
Dialogue: 0,0:01:04.18,0:01:05.19,Default,,0,0,0,,Ku…
Dialogue: 0,0:01:12.03,0:01:16.07,Default,,0,0,0,,(Бұлғар патшасының ыңырануы)
Dialogue: 0,0:01:16.20,0:01:17.16,Default,,0,0,0,,(Бұлғар патшасы) Уф...
Dialogue: 0,0:01:17.28,0:01:21.53,Default,,0,0,0,,Сіз тақтаға тұтқында болса да келдіңіз, солай емес пе, әке?
Dialogue: 0,0:01:21.66,0:01:25.96,Default,,0,0,0,,(Бұлғар патшасы) Сиқырдың сұмдығын бағалама.
Dialogue: 0,0:01:26.08,0:01:27.12,Default,,0,0,0,,(Саусақтарды сермеу) (Бұлғар патшасы) Ух...
Dialogue: 0,0:01:27.25,0:01:28.54,Default,,0,0,0,,Не!
Dialogue: 0,0:01:28.79,0:01:31.00,Default,,0,0,0,,Сиқырды бағалама!
Dialogue: 0,0:01:31.46,0:01:34.09,Default,,0,0,0,,Бұл сіздің бақылауыңызда емес.
Dialogue: 0,0:01:34.21,0:01:38.47,Default,,0,0,0,,Сен мені бес патшалықты басқарғандай билеймін деп ойлама.
Dialogue: 0,0:01:39.14,0:01:40.43,Default,,0,0,0,,Төрт.
Dialogue: 0,0:01:40.72,0:01:42.35,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:01:42.47,0:01:46.23,Default,,0,0,0,,Түс халқы мені өте жылы қабылдады.
Dialogue: 0,0:01:46.48,0:01:48.06,Default,,0,0,0,,Бес билік арасындағы келісімнің арқасында...
Dialogue: 0,0:01:48.19,0:01:50.73,Default,,0,0,0,,Бұзылған сияқты.
Dialogue: 0,0:01:51.15,0:01:53.23,Default,,0,0,0,,(Бұлғар патшасы) Сен сияқты ақымақтар болмаса...
Dialogue: 0,0:01:53.36,0:01:56.65,Default,,0,0,0,,Сиқыр жойылып кетпес еді, бірақ өркендеген болар еді.
Dialogue: 0,0:01:56.78,0:02:01.57,Default,,0,0,0,,Сиқырды жоққа шығаруды сиқыршылардың өздері жасады... Уау!
Dialogue: 0,0:02:01.70,0:02:03.70,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:02:03.95,0:02:06.96,Default,,0,0,0,,Келби сені ерте ме, кеш пе ұстайды
Dialogue: 0,0:02:07.08,0:02:10.79,Default,,0,0,0,,Бірақ қазір тұрған жеріңді ашатын болсаң, екеуіңе тірі қалдырамын.
Dialogue: 0,0:02:10.92,0:02:13.92,Default,,0,0,0,,Қаласаң сарайда тұра аласың.
Dialogue: 0,0:02:14.05,0:02:15.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:15.51,0:02:19.18,Default,,0,0,0,,Сен бәрібір өлгенше зынданға қамап қоятынына сенімдімін.
Dialogue: 0,0:02:19.30,0:02:22.68,Default,,0,0,0,,Өзіңді осылай ұстасаң, тез өлесің.
Dialogue: 0,0:02:22.97,0:02:26.68,Default,,0,0,0,,(Бұлғар патша) Сенің ашуың қорқыныштың көрінісі, балам.
Dialogue: 0,0:02:26.81,0:02:28.56,Default,,0,0,0,,Сен неден қорқасың?
Dialogue: 0,0:02:29.44,0:02:30.94,Default,,0,0,0,,Куу!
Dialogue: 0,0:02:33.11,0:02:35.82,Default,,0,0,0,,(Бұлғар патшасы) Ах! Гуаа!
Dialogue: 0,0:02:35.94,0:02:41.03,Default,,0,0,0,,(Бұлғар патшасының ыңырануы)
Dialogue: 0,0:02:41.49,0:02:43.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:47.04,0:02:52.96,Default,,0,0,0,,‪♪～
Dialogue: 0,0:04:11.83,0:04:16.92,Default,,0,0,0,,‪～♪
Dialogue: 0,0:04:18.00,0:04:19.92,Default,,0,0,0,,〝7-эпизод Ханым мен бала〞
Dialogue: 0,0:04:20.34,0:04:23.38,Default,,0,0,0,,(Бұлғар патшасының ыңырануы)
Dialogue: 0,0:04:23.51,0:04:28.68,Default,,0,0,0,,(Бұлғар патшасы) Уф! Ой... аа... ой...
Dialogue: 0,0:04:28.81,0:04:30.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:30.81,0:04:36.10,Default,,0,0,0,,(Бұлғар патшасының ыңырануы)
Dialogue: 0,0:04:39.11,0:04:42.65,Default,,0,0,0,,Кел, сиқырлы рух!
Dialogue: 0,0:04:43.82,0:04:47.91,Default,,0,0,0,,(Рух) Бұл қате түсінік. Саған бұйрық беретін менмін.
Dialogue: 0,0:04:48.32,0:04:49.37,Default,,0,0,0,,Нууууу
Dialogue: 0,0:04:52.45,0:04:55.75,Default,,0,0,0,,Жоооооооооооооооооооооооооооооооооооооооооооооооооооооооуууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:04:55.87,0:04:59.92,Default,,0,0,0,,Мен өз ағамды міндетті түрде табамын. Мен мұқият іздеймін!
Dialogue: 0,0:05:00.04,0:05:03.21,Default,,0,0,0,,Арх! Уф
Dialogue: 0,0:05:03.34,0:05:06.47,Default,,0,0,0,,Гууууууууууууууууууууууууу...
Dialogue: 0,0:05:06.59,0:05:07.14,Default,,0,0,0,,(Рух) Сені таппасаң не болатынын есте сақта.
Dialogue: 0,0:05:07.14,0:05:09.80,Default,,0,0,0,,(Рух) Сені таппасаң не болатынын есте сақта.
Dialogue: 0,0:05:07.14,0:05:09.80,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:05:09.93,0:05:13.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:13.81,0:05:16.56,Default,,0,0,0,,Ха... у...
Dialogue: 0,0:05:18.06,0:05:22.19,Default,,0,0,0,,Уф... Ха ха... Уф
Dialogue: 0,0:05:22.32,0:05:25.95,Default,,0,0,0,,Гуаааааааа!
Dialogue: 0,0:05:26.24,0:05:30.53,Default,,0,0,0,,Сіз әлемге нені ашуға тырысасыз?
Dialogue: 0,0:05:38.00,0:05:41.38,Default,,0,0,0,,(Келби) Уау! Уф! Itata...
Dialogue: 0,0:05:41.88,0:05:43.00,Default,,0,0,0,,(Один) Абайлаңыз
Dialogue: 0,0:05:43.13,0:05:45.13,Default,,0,0,0,,(Келби) Маған айта аласыз!
Dialogue: 0,0:05:45.42,0:05:49.30,Default,,0,0,0,,(Один) Өзіңіз көруіңіз керек, князь.
Dialogue: 0,0:05:49.43,0:05:52.72,Default,,0,0,0,,Біз осындай шарасыз жағдайдамыз.
Dialogue: 0,0:05:53.60,0:05:58.31,Default,,0,0,0,,(Келби) Түсіндім, мен құнсыз бұзылған әлсізбін.
Dialogue: 0,0:05:58.44,0:06:02.27,Default,,0,0,0,,Жоқ, керісінше ол сенің әкеңе ұқсайды.
Dialogue: 0,0:06:02.40,0:06:04.07,Default,,0,0,0,,(Келби) Ақымақ болма!
Dialogue: 0,0:06:05.78,0:06:07.40,Default,,0,0,0,,Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,0:06:08.11,0:06:11.91,Default,,0,0,0,,Сіздің жасыңызда Мәртебеліге ұқсайсыз.
Dialogue: 0,0:06:12.03,0:06:14.62,Default,,0,0,0,,Идеалистік, бірақ ешқашан ақымақ емес
Dialogue: 0,0:06:15.29,0:06:19.08,Default,,0,0,0,,Бұл қашу сізді өз шегіңізге итермелейді.
Dialogue: 0,0:06:19.21,0:06:20.71,Default,,0,0,0,,Бірақ біз...
Dialogue: 0,0:06:20.83,0:06:23.29,Default,,0,0,0,,Біз сіздің шектеулеріңізді әлі көрмедік.
Dialogue: 0,0:06:23.42,0:06:26.59,Default,,0,0,0,,Егер сіз күш салсаңыз, міндетті түрде ұлы патша боласыз.
Dialogue: 0,0:06:27.47,0:06:28.80,Default,,0,0,0,,Рахмет Один
Dialogue: 0,0:06:29.68,0:06:34.64,Default,,0,0,0,,Сол жартастың астында тынығып, желдің ізімізді өшіруін күтейік.
Dialogue: 0,0:06:34.93,0:06:35.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:37.56,0:06:40.73,Default,,0,0,0,,Сіз не істеп жатырсыз? кеттік
Dialogue: 0,0:06:40.94,0:06:43.48,Default,,0,0,0,,(Один) Бұл тамаша стратегия, ханзада.
Dialogue: 0,0:06:43.61,0:06:46.44,Default,,0,0,0,,Бірақ бұл демалатын уақыт емес.
Dialogue: 0,0:06:49.36,0:06:51.32,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:59.96,0:07:01.96,Default,,0,0,0,,Мен мұндай көпірге шыдай алмаймын
Dialogue: 0,0:07:02.08,0:07:05.17,Default,,0,0,0,,Ақырын өтсеңіз жақсы. Барайық.
Dialogue: 0,0:07:10.34,0:07:12.55,Default,,0,0,0,,(Келби) Ақырын! ? (Один) Жүгір!
Dialogue: 0,0:07:12.93,0:07:15.93,Default,,0,0,0,,(Келби) Уау!
Dialogue: 0,0:07:24.23,0:07:26.11,Default,,0,0,0,,Мен өліп қала жаздадым
Dialogue: 0,0:07:26.23,0:07:28.32,Default,,0,0,0,,Тәуекел өзіне тән
Dialogue: 0,0:07:28.44,0:07:31.49,Default,,0,0,0,,Бодика патшалығына кім шабуыл жасаса да...
Dialogue: 0,0:07:31.61,0:07:33.70,Default,,0,0,0,,Олардың бізден кейін келетініне сенімдімін.
Dialogue: 0,0:07:33.99,0:07:37.91,Default,,0,0,0,,«Сіз қаншалықты ұзақ қашсаңыз, жау сізді оңай табады» солай ма?
Dialogue: 0,0:07:38.04,0:07:39.87,Default,,0,0,0,,Мен мұны бұрын естігенмін.
Dialogue: 0,0:07:42.96,0:07:43.96,Default,,0,0,0,,(Один Келби) Ах...
Dialogue: 0,0:07:53.63,0:07:56.39,Default,,0,0,0,,Мұны маған қалдыр да, үндеме.
Dialogue: 0,0:07:56.51,0:07:59.89,Default,,0,0,0,,Балалар сендер күдіктенесіңдер. Неге сонша асығасың?
Dialogue: 0,0:08:00.18,0:08:02.35,Default,,0,0,0,,Біз металл сынықтарын жинаймыз.
Dialogue: 0,0:08:02.48,0:08:05.31,Default,,0,0,0,,Мен металл сынықтарын іздеп жүрмін. Сізде қоқыс жоқ па?
Dialogue: 0,0:08:05.44,0:08:09.98,Default,,0,0,0,,Мека эскорт тобымен металл сынықтарын алу?
Dialogue: 0,0:08:10.28,0:08:13.61,Default,,0,0,0,,(Один) Жолда оны алыңыз, мен оны қайта бағдарламаладым.
Dialogue: 0,0:08:13.74,0:08:15.49,Default,,0,0,0,,Егер саған бірдеңе болса, орнына...
Dialogue: 0,0:08:15.62,0:08:17.33,Default,,0,0,0,,Мен көмекке үміттендім.
Dialogue: 0,0:08:17.87,0:08:20.54,Default,,0,0,0,,Бала ше? сен неге үндемейсің?
Dialogue: 0,0:08:20.66,0:08:25.21,Default,,0,0,0,,Қызметші Ол тыныш, бірақ еңбекқор.
Dialogue: 0,0:08:36.55,0:08:38.43,Default,,0,0,0,,Вальдориан емес.
Dialogue: 0,0:08:38.55,0:08:40.06,Default,,0,0,0,,Бодика халқы?
Dialogue: 0,0:08:40.18,0:08:43.06,Default,,0,0,0,,(Один) Біз... жауап берудің қажеті жоқ.
Dialogue: 0,0:08:43.18,0:08:44.35,Default,,0,0,0,,Осы баладан сұрау
Dialogue: 0,0:08:44.73,0:08:45.60,Default,,0,0,0,,(Келби) Ой...
Dialogue: 0,0:08:46.73,0:08:47.56,Default,,0,0,0,,Жауап!
Dialogue: 0,0:08:52.07,0:08:55.15,Default,,0,0,0,,Сіз оңтүстіктің тұрғыны сияқтысыз. Уф...
Dialogue: 0,0:08:55.28,0:08:57.95,Default,,0,0,0,,Сіз Бодика роялти сияқты сөйлейсіз.
Dialogue: 0,0:08:59.74,0:09:02.87,Default,,0,0,0,,Мен осылай сөйлейтін баланы іздедім.
Dialogue: 0,0:09:02.87,0:09:03.66,Default,,0,0,0,,Мен осылай сөйлейтін баланы іздедім.
Dialogue: 0,0:09:02.87,0:09:03.66,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:09:03.66,0:09:04.21,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:09:04.33,0:09:05.41,Default,,0,0,0,,(Аяқ) (Келби) Ах...
Dialogue: 0,0:09:05.54,0:09:07.12,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:09:07.96,0:09:08.92,Default,,0,0,0,,(Один) Хмф!
Dialogue: 0,0:09:09.96,0:09:11.71,Default,,0,0,0,,Арх! (Келби) Ах!
Dialogue: 0,0:09:11.84,0:09:12.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:14.47,0:09:15.80,Default,,0,0,0,,(Один) Ах!
Dialogue: 0,0:09:17.43,0:09:19.72,Default,,0,0,0,,Иә! Хмф!
Dialogue: 0,0:09:22.68,0:09:24.73,Default,,0,0,0,,Хмф! Урья!
Dialogue: 0,0:09:28.48,0:09:29.27,Default,,0,0,0,,Хмф!
Dialogue: 0,0:09:31.36,0:09:32.36,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:09:32.90,0:09:35.28,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:09:39.28,0:09:41.66,Default,,0,0,0,,(Хильда Один) Иә! Ха! Ха!
Dialogue: 0,0:09:43.29,0:09:44.75,Default,,0,0,0,,(Один) Хмф! Апыр-ай!
Dialogue: 0,0:09:49.83,0:09:50.96,Default,,0,0,0,,Ku…
Dialogue: 0,0:09:52.00,0:09:52.88,Default,,0,0,0,,(Келби Один) Ах...
Dialogue: 0,0:09:55.55,0:09:59.05,Default,,0,0,0,,Один Тоқта! Ол адам қарусыз!
Dialogue: 0,0:10:00.68,0:10:03.22,Default,,0,0,0,,Мен бұл туралы толық білемін.
Dialogue: 0,0:10:03.68,0:10:06.31,Default,,0,0,0,,Айтыңызшы, бұл кімнің бұйрығы?
Dialogue: 0,0:10:07.18,0:10:09.02,Default,,0,0,0,,Сіз ханзада Келбисіз.
Dialogue: 0,0:10:09.90,0:10:11.23,Default,,0,0,0,,Мүлдем басқаша
Dialogue: 0,0:10:11.65,0:10:15.44,Default,,0,0,0,,Бодикаға кім шабуыл жасады? Валь д'Орға кім шабуыл жасады?
Dialogue: 0,0:10:15.90,0:10:18.78,Default,,0,0,0,,Менің қожайыным - Сиқырдың императоры, Локк!
Dialogue: 0,0:10:20.20,0:10:21.70,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:10:21.82,0:10:23.74,Default,,0,0,0,,Сіз Түстенсіз бе?
Dialogue: 0,0:10:24.24,0:10:27.46,Default,,0,0,0,,Мен әскеримін. Мен артық ештеңе айта алмаймын.
Dialogue: 0,0:10:28.33,0:10:29.50,Default,,0,0,0,,(Odin) Nu...
Dialogue: 0,0:10:30.29,0:10:31.92,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:10:33.75,0:10:36.26,Default,,0,0,0,,Хильда (Один) Хилда...
Dialogue: 0,0:10:36.38,0:10:39.51,Default,,0,0,0,,Бүгін сізді Бодика князі Келби құтқарған күн.
Dialogue: 0,0:10:39.63,0:10:40.59,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:10:41.18,0:10:43.01,Default,,0,0,0,,Мынаны мына әйелге бер
Dialogue: 0,0:10:43.14,0:10:47.48,Default,,0,0,0,,(Кейси ызылдайды) (Филли қорылдады)
Dialogue: 0,0:10:47.60,0:10:52.61,Default,,0,0,0,,(Филли қорылдау)
Dialogue: 0,0:10:54.82,0:10:55.82,Default,,0,0,0,,Хехе...
Dialogue: 0,0:10:55.94,0:11:00.45,Default,,0,0,0,,(Филли қорылдау)
Dialogue: 0,0:11:00.57,0:11:01.82,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:03.16,0:11:04.28,Default,,0,0,0,,(Филли) Гуг…
Dialogue: 0,0:11:04.41,0:11:05.41,Default,,0,0,0,,(Филли) Арх! Ахх
Dialogue: 0,0:11:05.53,0:11:07.87,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:11:08.87,0:11:10.37,Default,,0,0,0,,Не! ?
Dialogue: 0,0:11:10.50,0:11:13.75,Default,,0,0,0,,Қайырлы таң. Сен қорылдап жаттың.
Dialogue: 0,0:11:14.46,0:11:17.67,Default,,0,0,0,,Өз көлігіңде ұйықтап, сергек оянғанның несі айып?
Dialogue: 0,0:11:17.80,0:11:19.76,Default,,0,0,0,,Ерте жолға шығайық.
Dialogue: 0,0:11:19.88,0:11:22.34,Default,,0,0,0,,(Филли) Сәлем! Менің теледидарыммен араласпа!
Dialogue: 0,0:11:22.80,0:11:26.06,Default,,0,0,0,,Мен сенен теледидарды жөндеуді сұрадым.
Dialogue: 0,0:11:27.06,0:11:30.81,Default,,0,0,0,,(Кейси) А... Мен кейбір бөліктерді табуым керек шығар.
Dialogue: 0,0:11:30.94,0:11:34.06,Default,,0,0,0,,Робот теледидарда не істемекші?
Dialogue: 0,0:11:34.19,0:11:36.52,Default,,0,0,0,,Маған ертегілер ұнайды.
Dialogue: 0,0:11:36.65,0:11:40.82,Default,,0,0,0,,Ұйқыға кеткенде біраз уақыт тоқтау керек...
Dialogue: 0,0:11:40.95,0:11:43.82,Default,,0,0,0,,(Филли) Эй, сары душ қабылда.
Dialogue: 0,0:11:44.57,0:11:47.28,Default,,0,0,0,,Бұл! Егер сіз Кейсиге көлік жүргізуге рұқсат етсеңіз...
Dialogue: 0,0:11:44.57,0:11:47.28,Default,,0,0,0,,(жеңілдететін дыбыс)
Dialogue: 0,0:11:47.28,0:11:47.41,Default,,0,0,0,,(Жеңілдететін дыбыс)
Dialogue: 0,0:11:47.41,0:11:50.33,Default,,0,0,0,,(Жеңілдететін дыбыс)
Dialogue: 0,0:11:47.41,0:11:50.33,Default,,0,0,0,,Тезірек қозғалайық. Мен жасасам жақсы...
Dialogue: 0,0:11:50.45,0:11:51.79,Default,,0,0,0,,(Түкірген дыбыс)
Dialogue: 0,0:12:00.76,0:12:02.01,Default,,0,0,0,,(Ханымның күні) Қарғыс атсын...
Dialogue: 0,0:12:04.51,0:12:07.01,Default,,0,0,0,,Бала Фили!
Dialogue: 0,0:12:09.39,0:12:10.85,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:12:11.81,0:12:13.19,Default,,0,0,0,,(әйнек сынған дыбыс)
Dialogue: 0,0:12:13.69,0:12:16.44,Default,,0,0,0,,(Дэй ханым) Батти Неше адам бар?
Dialogue: 0,0:12:16.56,0:12:18.61,Default,,0,0,0,,(Батти) Осы уақытқа дейін барлығы осы ма?
Dialogue: 0,0:12:18.86,0:12:22.61,Default,,0,0,0,,35 сыйлы аңшы бар. Жеңіс/жеңіл рекорды - Филли...
Dialogue: 0,0:12:22.74,0:12:25.41,Default,,0,0,0,,(Ханымның күні) Мен жеңіс/жеңіл рекордының қандай екенін білемін!
Dialogue: 0,0:12:26.28,0:12:29.12,Default,,0,0,0,,Бұл қаладағы барлық сый-құрметшілер өлтірілді.
Dialogue: 0,0:12:29.24,0:12:32.83,Default,,0,0,0,,Сол сасық бейбақтың арқасында бізге жұмыс күші жетпейді!
Dialogue: 0,0:12:33.29,0:12:34.54,Default,,0,0,0,,Маған виски беріңіз!
Dialogue: 0,0:12:35.12,0:12:36.17,Default,,0,0,0,,(Батти) Доктор Фаусс-
Dialogue: 0,0:12:36.29,0:12:39.50,Default,,0,0,0,,Бізге арақ ішпеу керек, ұстаз.
Dialogue: 0,0:12:39.84,0:12:42.97,Default,,0,0,0,,Келесі жолы дәрігерлер туралы айтсам, оны тегін бермеймін.
Dialogue: 0,0:12:49.97,0:12:52.39,Default,,0,0,0,,Әлгі ақымақтың мойнында...
Dialogue: 0,0:12:52.89,0:12:55.39,Default,,0,0,0,,Маған бұл бизнесті тастауға жеткілікті...
Dialogue: 0,0:12:55.52,0:12:57.98,Default,,0,0,0,,Көп ақшаға қауіп төніп тұр
Dialogue: 0,0:12:58.81,0:13:02.86,Default,,0,0,0,,Анау бала, сен менің зейнетке шығуыма кедергі келтірдің.
Dialogue: 0,0:13:03.69,0:13:05.95,Default,,0,0,0,,Мен сені өлтірсем де, өлмеймін!
Dialogue: 0,0:13:06.07,0:13:08.57,Default,,0,0,0,,(Батти) Менің бір ұсынысым бар, сэр.
Dialogue: 0,0:13:08.70,0:13:09.66,Default,,0,0,0,,Бала Филли -
Dialogue: 0,0:13:09.78,0:13:11.91,Default,,0,0,0,,Сіз мүмкін емес деңгейдегі іздеуші адам сияқтысыз.
Dialogue: 0,0:13:12.16,0:13:14.91,Default,,0,0,0,,А, бұл мүмкін емес!
Dialogue: 0,0:13:15.79,0:13:17.08,Default,,0,0,0,,(Батти) Мақсат қаншалықты жақсы болса.
Dialogue: 0,0:13:17.21,0:13:19.21,Default,,0,0,0,,Бізге зұлым байлық аңшы керек
Dialogue: 0,0:13:19.75,0:13:22.63,Default,,0,0,0,,Мен мұны түсінбеймін деп ойлайсыз ба?
Dialogue: 0,0:13:22.76,0:13:26.22,Default,,0,0,0,,(Батти) Түсінсең де нәтижеге әкелмейді.
Dialogue: 0,0:13:26.34,0:13:29.09,Default,,0,0,0,,Сонымен, берілгендіктің көрінісі ретінде...
Dialogue: 0,0:13:29.22,0:13:31.64,Default,,0,0,0,,Мен Джоджоның орнын таптым.
Dialogue: 0,0:13:32.10,0:13:34.73,Default,,0,0,0,,(Ханымның күні) Джожо? Джожо?
Dialogue: 0,0:13:34.85,0:13:36.35,Default,,0,0,0,,ДжоДжо зейнетке шығуы керек еді.
Dialogue: 0,0:13:36.77,0:13:37.69,Default,,0,0,0,,(Батти) Егер ол адам...
Dialogue: 0,0:13:37.81,0:13:40.56,Default,,0,0,0,,Осы бітпейтін құбылыстан туындайтын уайымымыз...
Dialogue: 0,0:13:40.69,0:13:42.57,Default,,0,0,0,,Олар толық түсінеді.
Dialogue: 0,0:13:42.69,0:13:48.36,Default,,0,0,0,,(Дэй ханым) А, жарайды. Мен комиссияны екі есе төлеймін, бірақ алдын ала төлемеймін.
Dialogue: 0,0:13:48.49,0:13:51.91,Default,,0,0,0,,24 сағат ішінде ұсталса, 10% қосымша ақы
Dialogue: 0,0:13:52.03,0:13:54.95,Default,,0,0,0,,Тыңдашы, Батти, егер бұл менің ақшам болса...
Dialogue: 0,0:13:55.08,0:13:57.33,Default,,0,0,0,,Филиге шабуыл жасайық, ол білсін.
Dialogue: 0,0:13:57.46,0:14:01.34,Default,,0,0,0,,Мен сенен сыйлы аңшыларды өлтіргенің үшін кек аламын.
Dialogue: 0,0:14:02.09,0:14:03.17,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:05.63,0:14:08.47,Default,,0,0,0,,Әр жерде сол зат басқа нәрселерді соқты.
Dialogue: 0,0:14:08.59,0:14:11.89,Default,,0,0,0,,Жақсы азаматтар болуы керек.
Dialogue: 0,0:14:15.35,0:14:16.89,Default,,0,0,0,,(Один) Келіңіз, князь.
Dialogue: 0,0:14:17.02,0:14:19.35,Default,,0,0,0,,Бұл жерде бұдан былай пайдалана алатын ештеңе жоқ.
Dialogue: 0,0:14:20.90,0:14:22.06,Default,,0,0,0,,(Келби) Чикаробо…
Dialogue: 0,0:14:22.73,0:14:24.53,Default,,0,0,0,,(Один) Бірдеңе дедіңіз бе, князь?
Dialogue: 0,0:14:25.19,0:14:27.74,Default,,0,0,0,,(Келби) Мына баланың бетіндегі электр тогы жыпылықтайды...
Dialogue: 0,0:14:27.86,0:14:29.86,Default,,0,0,0,,Мен оны «Чикаробо» деп атадым.
Dialogue: 0,0:14:30.28,0:14:34.16,Default,,0,0,0,,Жаттығу кезінде мен бұл баланы бір қарағанда танитынмын.
Dialogue: 0,0:14:34.29,0:14:36.70,Default,,0,0,0,,Төрт жыл бойы бізді қорғап келесің.
Dialogue: 0,0:14:39.96,0:14:41.88,Default,,0,0,0,,(Один) Тек роботтың құрбандығы үшін...
Dialogue: 0,0:14:42.00,0:14:43.84,Default,,0,0,0,,Сіз осы уақытқа дейін келдіңіз
Dialogue: 0,0:14:43.96,0:14:47.55,Default,,0,0,0,,Гала сарайына жеткенде, кез келген ауыстыру болады.
Dialogue: 0,0:14:47.67,0:14:49.01,Default,,0,0,0,,Бұл ауыстыру...
Dialogue: 0,0:14:49.47,0:14:51.22,Default,,0,0,0,,(Один) Бұл ұрыс алаңы, ханзада.
Dialogue: 0,0:14:51.80,0:14:54.60,Default,,0,0,0,,Ұрыс алаңында роботтар жай ғана құрал.
Dialogue: 0,0:14:54.72,0:14:56.35,Default,,0,0,0,,Қайғылы болма
Dialogue: 0,0:14:56.47,0:14:59.73,Default,,0,0,0,,Бұл адамдар қарапайым адамдар емес.
Dialogue: 0,0:15:19.00,0:15:20.87,Default,,0,0,0,,(асқазанның айқайлауы)
Dialogue: 0,0:15:21.50,0:15:23.88,Default,,0,0,0,,Эй, Чибиробо, сен...
Dialogue: 0,0:15:24.00,0:15:27.50,Default,,0,0,0,,Кеше түнде жарты қап картоп ұрлаған жоқсың ба?
Dialogue: 0,0:15:27.63,0:15:29.34,Default,,0,0,0,,(Кейси) Бұл дұрыс емес.
Dialogue: 0,0:15:29.72,0:15:33.68,Default,,0,0,0,,Мен Филлидің таңғы асына біразын сақтап қойдым.
Dialogue: 0,0:15:38.06,0:15:39.06,Default,,0,0,0,,Жоқ! ?
Dialogue: 0,0:15:39.85,0:15:41.81,Default,,0,0,0,,Оның алдында маған бірдеңе айт.
Dialogue: 0,0:15:41.94,0:15:44.73,Default,,0,0,0,,Мен Сэм Филли туралы естуден шаршадым.
Dialogue: 0,0:15:44.86,0:15:47.36,Default,,0,0,0,,Мұның бәрі төбелес пен үлкен әбігерге байланысты.
Dialogue: 0,0:15:47.48,0:15:48.73,Default,,0,0,0,,(Филли) Бұл жолы басқа!
Dialogue: 0,0:15:48.86,0:15:49.74,Default,,0,0,0,,(тежегіш дыбысы)
Dialogue: 0,0:15:50.11,0:15:52.86,Default,,0,0,0,,Өйткені, бұл жалғасып жатқан оқиға.
Dialogue: 0,0:15:53.28,0:15:54.32,Default,,0,0,0,,Уау! (Кейси) Уау!
Dialogue: 0,0:15:54.95,0:15:59.79,Default,,0,0,0,,Олай болса, бір әйелмен ұрысып қалғанымды айтайын.
Dialogue: 0,0:16:00.70,0:16:03.29,Default,,0,0,0,,Бұрышқа ілінген сасық сияқты, тым жаман...
Dialogue: 0,0:16:03.42,0:16:07.54,Default,,0,0,0,,Жылқының бөксесіндей шіркін, қыстың жаңбырындай суық.
Dialogue: 0,0:16:07.92,0:16:09.38,Default,,0,0,0,,Атауы «Ханымдар күні»
Dialogue: 0,0:16:09.51,0:16:12.68,Default,,0,0,0,,Ханымдар күні? Бұл жақсы есім
Dialogue: 0,0:16:12.80,0:16:15.09,Default,,0,0,0,,(Кейси) Иә! (Филли) Тым мейірімді болмаңыз
Dialogue: 0,0:16:15.59,0:16:17.01,Default,,0,0,0,,(Сэм Кейси) Иә?
Dialogue: 0,0:16:17.14,0:16:19.31,Default,,0,0,0,,(Филли) Сол күні мен басқалар сияқты едім...
Dialogue: 0,0:16:19.43,0:16:22.02,Default,,0,0,0,,Мен жалғыз қалдым және не істеуім керек екеніне назар аудардым.
Dialogue: 0,0:16:23.81,0:16:24.73,Default,,0,0,0,,(Боунти аңшылары) Хехе
Dialogue: 0,0:16:26.52,0:16:27.90,Default,,0,0,0,,(Боунти аңшысының тыныс алу дыбысы)
Dialogue: 0,0:16:29.02,0:16:30.61,Default,,0,0,0,,Ханым күнінен хабарлама.
Dialogue: 0,0:16:35.16,0:16:36.53,Default,,0,0,0,,‪
Dialogue: 0,0:16:36.99,0:16:38.91,Default,,0,0,0,,(Дэй ханым) Филли, бейбақ!
Dialogue: 0,0:16:39.03,0:16:42.41,Default,,0,0,0,,Мен сіздің барлық сыйлығыңызды аламын!
Dialogue: 0,0:16:42.54,0:16:43.50,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:44.42,0:16:46.63,Default,,0,0,0,,Күткендей ме?
Dialogue: 0,0:16:48.84,0:16:51.51,Default,,0,0,0,,Сәлем ханым күні! Егер сіз мені ұстағыңыз келсе -
Dialogue: 0,0:16:51.63,0:16:54.93,Default,,0,0,0,,Мына үлкен есекті көтеріп, осында кел!
Dialogue: 0,0:16:55.51,0:16:57.76,Default,,0,0,0,,Филли Бұл дөрекі!
Dialogue: 0,0:16:57.89,0:16:59.85,Default,,0,0,0,,(Филли) Неліктен? Ол семіз әйел.
Dialogue: 0,0:16:59.97,0:17:03.39,Default,,0,0,0,,Адамды дәл сипаттасаңыз, мағынасы болады.
Dialogue: 0,0:17:03.52,0:17:05.39,Default,,0,0,0,,Сіз бұл жағдайдан қалай өттіңіз?
Dialogue: 0,0:17:06.52,0:17:08.61,Default,,0,0,0,,(Филли) Не болды деп ойлайсың?
Dialogue: 0,0:17:09.44,0:17:11.40,Default,,0,0,0,,(Ханымның күні) Әңгімешіл бейбақ!
Dialogue: 0,0:17:11.53,0:17:14.70,Default,,0,0,0,,Ешқандай құтылу мүмкін емес! Сыртқа шығып, сыйлығыңызды алыңыз!
Dialogue: 0,0:17:15.99,0:17:18.03,Default,,0,0,0,,Ол келмейтін сияқты, бастық.
Dialogue: 0,0:17:18.16,0:17:19.83,Default,,0,0,0,,(Ханымның күні) Кәдімгі ойынды ойна, Джерри.
Dialogue: 0,0:17:19.95,0:17:21.41,Default,,0,0,0,,(Джерри) Түсіндім.
Dialogue: 0,0:17:30.04,0:17:33.17,Default,,0,0,0,,(гитара орындауы)
Dialogue: 0,0:17:33.26,0:17:33.59,Default,,0,0,0,,♪～
Dialogue: 0,0:17:33.59,0:17:35.76,Default,,0,0,0,,♪～
Dialogue: 0,0:17:33.59,0:17:35.76,Default,,0,0,0,,(Ханымның күні) Осы ән біткенше шықпаса...
Dialogue: 0,0:17:35.76,0:17:35.88,Default,,0,0,0,,♪～
Dialogue: 0,0:17:35.88,0:17:37.13,Default,,0,0,0,,♪～
Dialogue: 0,0:17:35.88,0:17:37.13,Default,,0,0,0,,Тез кірейік!
Dialogue: 0,0:17:37.13,0:17:38.26,Default,,0,0,0,,♪～
Dialogue: 0,0:17:51.48,0:17:53.48,Default,,0,0,0,,～♪
Dialogue: 0,0:17:53.61,0:17:54.90,Default,,0,0,0,,(Ханымдар күні) Түсіріңіз!
Dialogue: 0,0:18:11.29,0:18:13.09,Default,,0,0,0,,(Филли) У...
Dialogue: 0,0:18:13.21,0:18:16.30,Default,,0,0,0,,Үйге қазір қайтқыңыз келсе...
Dialogue: 0,0:18:16.42,0:18:21.10,Default,,0,0,0,,Өмір... көмек...
Dialogue: 0,0:18:21.39,0:18:22.51,Default,,0,0,0,,А...
Dialogue: 0,0:18:26.18,0:18:27.94,Default,,0,0,0,,(Ханымдар күні) Көбірек түсіріңіз!
Dialogue: 0,0:18:28.06,0:18:30.65,Default,,0,0,0,,Бұл мені бұрын мазақ еткені үшін кек алу.
Dialogue: 0,0:18:30.77,0:18:31.40,Default,,0,0,0,,(Филли) Басшы…
Dialogue: 0,0:18:33.19,0:18:35.03,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:35.15,0:18:37.53,Default,,0,0,0,,А... а... а...
Dialogue: 0,0:18:40.07,0:18:40.91,Default,,0,0,0,,Хехехе
Dialogue: 0,0:18:43.45,0:18:44.24,Default,,0,0,0,,(Джерри) Ах!
Dialogue: 0,0:18:45.41,0:18:46.16,Default,,0,0,0,,(Боунти аңшысы) Уф!
Dialogue: 0,0:18:46.70,0:18:47.91,Default,,0,0,0,,(Филли) Уф!
Dialogue: 0,0:18:51.38,0:18:52.29,Default,,0,0,0,,(Боунти аңшысы) Ах! (Джерри) Ах!
Dialogue: 0,0:18:53.59,0:18:55.34,Default,,0,0,0,,(Боунти аңшысы) Уф!
Dialogue: 0,0:18:55.46,0:18:56.84,Default,,0,0,0,,Ku…
Dialogue: 0,0:18:57.92,0:18:59.93,Default,,0,0,0,,Ой...
Dialogue: 0,0:19:00.63,0:19:02.59,Default,,0,0,0,,Маған қоңырау шалмаңыз.
Dialogue: 0,0:19:06.01,0:19:07.56,Default,,0,0,0,,(Джерри) Сәлем! (Филли) Барар алдында...
Dialogue: 0,0:19:07.68,0:19:10.02,Default,,0,0,0,,Маған кету әнін ойнатыңыз
Dialogue: 0,0:19:13.23,0:19:15.19,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:19:15.32,0:19:18.11,Default,,0,0,0,,(Филли) Мен үйден кетуім керек сияқты.
Dialogue: 0,0:19:18.24,0:19:19.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:20.07,0:19:25.08,Default,,0,0,0,,(гитара орындауы)
Dialogue: 0,0:19:28.25,0:19:29.50,Default,,0,0,0,,Бұл бастамасы ма?
Dialogue: 0,0:19:29.62,0:19:31.54,Default,,0,0,0,,Бұл бастамасы
Dialogue: 0,0:19:31.67,0:19:32.79,Default,,0,0,0,,(Кейси) Жақсы!
Dialogue: 0,0:19:32.92,0:19:34.92,Default,,0,0,0,,(Радио музыка) (Филли) Ой?
Dialogue: 0,0:19:35.04,0:19:37.42,Default,,0,0,0,,(Кейси) Мен айтып отырған нәрсемді аздап ойлап таптым, солай ма?
Dialogue: 0,0:19:37.55,0:19:38.51,Default,,0,0,0,,Не!
Dialogue: 0,0:19:39.17,0:19:41.72,Default,,0,0,0,,Филидің иісі туралы ешкім ештеңе айтқан жоқ.
Dialogue: 0,0:19:41.84,0:19:44.34,Default,,0,0,0,,Әдетте сіз бірінші айтасыз, солай ма?
Dialogue: 0,0:19:44.89,0:19:48.27,Default,,0,0,0,,Оның иісі қаншалықты жағымсыз екені маңызды емес, солай ма?
Dialogue: 0,0:19:48.39,0:19:50.60,Default,,0,0,0,,Леди Дэй оны жалғыз қалдыруымды өтінді...
Dialogue: 0,0:19:50.73,0:19:52.10,Default,,0,0,0,,Сен мені шын тыңдадың ба?
Dialogue: 0,0:19:52.44,0:19:56.11,Default,,0,0,0,,Тыңдамайтын шығарсың, мазалама.
Dialogue: 0,0:19:56.23,0:19:58.32,Default,,0,0,0,,Қаша бастағаннан кейін тоқтай алмайсың.
Dialogue: 0,0:19:58.90,0:20:01.49,Default,,0,0,0,,Өлгенше мені біреу қуады.
Dialogue: 0,0:20:01.61,0:20:03.45,Default,,0,0,0,,Мен ұсталсам не болады?
Dialogue: 0,0:20:03.57,0:20:04.99,Default,,0,0,0,,(Кейси) Сіз мені өлтіресіз!
Dialogue: 0,0:20:05.12,0:20:07.45,Default,,0,0,0,,Ерекшеліктер бар...
Dialogue: 0,0:20:07.58,0:20:08.49,Default,,0,0,0,,‪
Dialogue: 0,0:20:11.75,0:20:13.21,Default,,0,0,0,,(Филли Есау)
Dialogue: 0,0:20:13.33,0:20:14.92,Default,,0,0,0,,Мен сізге көлік жүргізуді тапсырдым.
Dialogue: 0,0:20:18.00,0:20:19.13,Default,,0,0,0,,Бұл сен емессің.
Dialogue: 0,0:20:19.50,0:20:20.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:21.26,0:20:22.47,Default,,0,0,0,,(Кейси) Хэхехе
Dialogue: 0,0:20:30.02,0:20:32.52,Default,,0,0,0,,(Ер адам) Жүр! О, менің!
Dialogue: 0,0:20:32.94,0:20:36.48,Default,,0,0,0,,(оқ пен қирау дыбыстары)
Dialogue: 0,0:20:58.63,0:21:00.67,Default,,0,0,0,,(Бір нәрсені басқан дыбыс) (Батти) А?
Dialogue: 0,0:21:02.97,0:21:05.47,Default,,0,0,0,,Мен сенің орнында болсам, қозғалмас едім.
Dialogue: 0,0:21:05.59,0:21:08.18,Default,,0,0,0,,(Батти) А... Меніңше.
Dialogue: 0,0:21:08.30,0:21:10.97,Default,,0,0,0,,Мен саған хабар беруге келдім.
Dialogue: 0,0:21:11.60,0:21:14.10,Default,,0,0,0,,Джожо Біраз уақыт болды, солай емес пе?
Dialogue: 0,0:21:14.23,0:21:17.40,Default,,0,0,0,,Эй, мен сенімен жаңа жұмыс туралы сөйлескім келеді.
Dialogue: 0,0:21:17.52,0:21:18.27,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:21:18.40,0:21:20.44,Default,,0,0,0,,Ух... тыңда!
Dialogue: 0,0:21:20.73,0:21:22.78,Default,,0,0,0,,Жоқ, мен жұмысты доғардым.
Dialogue: 0,0:21:22.78,0:21:23.28,Default,,0,0,0,,Жоқ, мен жұмысты доғардым.
Dialogue: 0,0:21:22.78,0:21:23.28,Default,,0,0,0,,(Бетті айналдыру дыбысы)
Dialogue: 0,0:21:23.28,0:21:23.40,Default,,0,0,0,,(Бетті айналдыру дыбысы)
Dialogue: 0,0:21:23.40,0:21:24.65,Default,,0,0,0,,(Бетті айналдыру дыбысы)
Dialogue: 0,0:21:23.40,0:21:24.65,Default,,0,0,0,,Кітап оқу кезінде...
Dialogue: 0,0:21:24.78,0:21:27.41,Default,,0,0,0,,Кейде мені өлтіруге келетіндер болады.
Dialogue: 0,0:21:27.91,0:21:31.08,Default,,0,0,0,,Бала Фили есімі таныс сияқты ма?
Dialogue: 0,0:21:31.74,0:21:32.58,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:33.33,0:21:36.87,Default,,0,0,0,,Мен сенің жалақыңды білемін, мен саған одан екі есе төлеймін...
Dialogue: 0,0:21:37.00,0:21:39.13,Default,,0,0,0,,Қалайы жігіт, «үш» десем...
Dialogue: 0,0:21:39.25,0:21:41.13,Default,,0,0,0,,Бұл аяқты жоғары көтеріңіз
Dialogue: 0,0:21:41.25,0:21:42.75,Default,,0,0,0,,(Батти) Иә? Тез бол!
Dialogue: 0,0:21:42.88,0:21:44.13,Default,,0,0,0,,Үш! (мылтық)
Dialogue: 0,0:21:44.26,0:21:45.13,Default,,0,0,0,,(Батти) Уау!
Dialogue: 0,0:21:47.09,0:21:49.14,Default,,0,0,0,,Рөлдер өте көп...
Dialogue: 0,0:21:54.56,0:21:56.06,Default,,0,0,0,,(Ханымның күні) Мәміле жасағыңыз келе ме?
Dialogue: 0,0:21:56.18,0:21:58.06,Default,,0,0,0,,Леди күні ақшасын алыңыз
Dialogue: 0,0:21:58.85,0:22:01.57,Default,,0,0,0,,Мен оған көп қарыздармын.
Dialogue: 0,0:22:03.53,0:22:04.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:04.99,0:22:08.28,Default,,0,0,0,,Мен Фили Баланы тегін өлтіремін.
Dialogue: 0,0:22:08.41,0:22:10.20,Default,,0,0,0,,‪
Dialogue: 0,0:22:11.07,0:22:16.08,Default,,0,0,0,,♪～
Dialogue: 0,0:23:35.91,0:23:40.91,Default,,0,0,0,,～♪
