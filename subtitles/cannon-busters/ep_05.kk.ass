Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:27.73,0:00:28.94,Default,,0,0,0,,(Кейси ызылдайды)
Dialogue: 0,0:00:31.28,0:00:32.11,Default,,0,0,0,,(Филли) ілмек…
Dialogue: 0,0:00:43.62,0:00:45.50,Default,,0,0,0,,Бұл ақылсыз көлік жүргізу.
Dialogue: 0,0:00:45.79,0:00:47.88,Default,,0,0,0,,(Филли) Бұл менің көлігім, мен оны қалауымша жүргізе аламын.
Dialogue: 0,0:00:48.25,0:00:50.21,Default,,0,0,0,,Егер сізге ұнамаса, түсіңіз.
Dialogue: 0,0:00:50.71,0:00:54.01,Default,,0,0,0,,Көлікті құрметтеу және жолаушыларды құрметтеу.
Dialogue: 0,0:00:54.13,0:00:56.59,Default,,0,0,0,,Қоршаған ортаны құрметтемеу
Dialogue: 0,0:00:56.72,0:01:00.26,Default,,0,0,0,,Бұл өлудің лайықты жолы емес.
Dialogue: 0,0:01:00.85,0:01:03.89,Default,,0,0,0,,Ха! Мен қалай өлемін?
Dialogue: 0,0:01:04.02,0:01:05.69,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,0:01:05.81,0:01:06.73,Default,,0,0,0,,Ах
Dialogue: 0,0:01:08.06,0:01:11.27,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл табиғатқа деген құрмет!
Dialogue: 0,0:01:11.40,0:01:14.15,Default,,0,0,0,,Алға қарап, рульді ұстаңыз.
Dialogue: 0,0:01:14.53,0:01:17.74,Default,,0,0,0,,(Филли) Маған қарап тұрма, бұл жиіркенішті.
Dialogue: 0,0:01:20.08,0:01:23.87,Default,,0,0,0,,(Бессидің сынған дыбысы) (Филли) А... аа!
Dialogue: 0,0:01:24.00,0:01:29.92,Default,,0,0,0,,‪♪～
Dialogue: 0,0:02:48.79,0:02:53.96,Default,,0,0,0,,‪～♪
Dialogue: 0,0:02:55.04,0:02:56.96,Default,,0,0,0,,５ 21･･･〞
Dialogue: 0,0:02:57.92,0:03:01.93,Default,,0,0,0,,(Бессиді жөндеу дыбысы)
Dialogue: 0,0:03:06.14,0:03:09.31,Default,,0,0,0,,(Филли) Қарғыс атсын! Өзің кінәлі, тегін мінген қария.
Dialogue: 0,0:03:09.73,0:03:10.85,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:03:10.98,0:03:13.90,Default,,0,0,0,,Фили сізге Бессиді жүргізуге рұқсат берді ме?
Dialogue: 0,0:03:14.02,0:03:17.19,Default,,0,0,0,,Жоқ! Бұл жігіт...
Dialogue: 0,0:03:17.48,0:03:20.20,Default,,0,0,0,,Ендеше, арыққа түсуімізге не себеп болды?
Dialogue: 0,0:03:20.32,0:03:22.16,Default,,0,0,0,,Бұл Филидің кінәсі.
Dialogue: 0,0:03:22.28,0:03:24.41,Default,,0,0,0,,(Филли) Бұл жігіт менің жолыма кедергі келтірді!
Dialogue: 0,0:03:24.53,0:03:27.99,Default,,0,0,0,,Мен жай ғана сіздің абайсызда жүргізуіңізді көрсеткім келді.
Dialogue: 0,0:03:28.12,0:03:32.33,Default,,0,0,0,,Маңызды жүкті алып жүргенде, бұлай жүргізуге қалай батылы барады?
Dialogue: 0,0:03:32.79,0:03:36.54,Default,,0,0,0,,Олай болса келесі қалаға барасың, жігіт!
Dialogue: 0,0:03:36.67,0:03:39.55,Default,,0,0,0,,Осыған байланысты қарғыс атқан қарт мүлде...
Dialogue: 0,0:03:40.01,0:03:42.30,Default,,0,0,0,,Жақында мен көлік жүргізе алмаймын.
Dialogue: 0,0:03:42.80,0:03:44.64,Default,,0,0,0,,Сіз мас боласыз.
Dialogue: 0,0:03:44.93,0:03:49.56,Default,,0,0,0,,Укуку…
Dialogue: 0,0:03:49.68,0:03:53.94,Default,,0,0,0,,Ах! ДДСҰ? Мұны кім жасады?
Dialogue: 0,0:03:54.27,0:03:56.40,Default,,0,0,0,,Мен жақсы көретін жалғыз нәрсені ішкен адам...
Dialogue: 0,0:03:56.52,0:03:57.69,Default,,0,0,0,,Қайда және кім?
Dialogue: 0,0:04:08.24,0:04:10.75,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:04:11.04,0:04:13.71,Default,,0,0,0,,Картоп чипсы да!
Dialogue: 0,0:04:14.12,0:04:14.96,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:26.97,0:04:27.80,Default,,0,0,0,,Фуга!
Dialogue: 0,0:04:31.52,0:04:33.31,Default,,0,0,0,,Гаргар...
Dialogue: 0,0:04:33.56,0:04:37.19,Default,,0,0,0,,Болды... Ронин, араласпа!
Dialogue: 0,0:04:38.86,0:04:41.23,Default,,0,0,0,,Сен тек қорқақсың! Дұрыс па?
Dialogue: 0,0:04:41.48,0:04:43.53,Default,,0,0,0,,Мен сияқты, жоқ, одан да көп
Dialogue: 0,0:04:43.74,0:04:47.03,Default,,0,0,0,,Себебі ол ренжіген Цзии-сан сияқты төбелеседі.
Dialogue: 0,0:04:47.70,0:04:49.03,Default,,0,0,0,,Оны қайдан алдың?
Dialogue: 0,0:04:50.33,0:04:53.54,Default,,0,0,0,,Алаяқ па? Мен тұтынушымын.
Dialogue: 0,0:04:53.66,0:04:56.50,Default,,0,0,0,,Қонақтардың көңілін көтеруді де білмейсіз бе?
Dialogue: 0,0:05:00.84,0:05:02.46,Default,,0,0,0,,(Филли) Сіз мақтанасыз ба?
Dialogue: 0,0:05:03.01,0:05:06.88,Default,,0,0,0,,Қонақтарға ең болмағанда ішетін бірдеңе ұсыну әдептілік.
Dialogue: 0,0:05:07.01,0:05:08.72,Default,,0,0,0,,Рұқсатсыз ішу арқылы...
Dialogue: 0,0:05:08.85,0:05:11.93,Default,,0,0,0,,Менің күтушілеріңізді қысқартуға тырысып жатқанымды көрмейсіз бе?
Dialogue: 0,0:05:13.27,0:05:15.44,Default,,0,0,0,,Сеніп тапсыруды ұйымдастырғаннан кейін
Dialogue: 0,0:05:17.52,0:05:18.86,Default,,0,0,0,,(Кейси) Жөндеу аяқталды!
Dialogue: 0,0:05:19.23,0:05:21.44,Default,,0,0,0,,(Филли) Жарайды, кеттік, балалар.
Dialogue: 0,0:05:22.11,0:05:23.36,Default,,0,0,0,,Тоғызды артқа қалдырыңыз.
Dialogue: 0,0:05:24.07,0:05:26.95,Default,,0,0,0,,Тоқта, мен сені артта қалдыра алмаймын.
Dialogue: 0,0:05:27.07,0:05:28.78,Default,,0,0,0,,Ол кісі біздің достарымыздың бірі...
Dialogue: 0,0:05:28.91,0:05:32.91,Default,,0,0,0,,Иә? Ой... дұрыс, бұл...
Dialogue: 0,0:05:33.04,0:05:33.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:38.62,0:05:41.04,Default,,0,0,0,,(Филли) Бұл менің картоп чиптерім бе?
Dialogue: 0,0:05:41.17,0:05:43.88,Default,,0,0,0,,Солай ма? Мен білмедім
Dialogue: 0,0:05:44.30,0:05:46.30,Default,,0,0,0,,Бұл менің соңғы тістеуім!
Dialogue: 0,0:05:46.42,0:05:48.72,Default,,0,0,0,,Неліктен картоп жейсің?
Dialogue: 0,0:05:48.84,0:05:50.51,Default,,0,0,0,,Бұл робот болса да!
Dialogue: 0,0:05:50.64,0:05:52.72,Default,,0,0,0,,Өйткені тамақ ішу қызық
Dialogue: 0,0:05:55.31,0:05:56.56,Default,,0,0,0,,Мен…
Dialogue: 0,0:05:56.68,0:05:59.77,Default,,0,0,0,,О, менің аузым жиіркенішті сезіледі!
Dialogue: 0,0:05:59.90,0:06:03.11,Default,,0,0,0,,Ауызға картоп пен құм толтырғандай.
Dialogue: 0,0:06:03.23,0:06:05.57,Default,,0,0,0,,(Филли айқай)
Dialogue: 0,0:06:05.69,0:06:08.28,Default,,0,0,0,,(Филли) Ах... аа... Хмф!
Dialogue: 0,0:06:11.91,0:06:13.58,Default,,0,0,0,,Ол бала.
Dialogue: 0,0:06:14.70,0:06:16.70,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:06:17.21,0:06:19.17,Default,,0,0,0,,(Бос сыраның дыбысы) Хехе
Dialogue: 0,0:06:19.46,0:06:20.54,Default,,0,0,0,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:06:20.79,0:06:23.84,Default,,0,0,0,,Аузыңыз шұғыл күтімді қажет етеді.
Dialogue: 0,0:06:23.96,0:06:26.13,Default,,0,0,0,,(Филли) Пайдасыз ақымақтар
Dialogue: 0,0:06:26.26,0:06:27.17,Default,,0,0,0,,Ақымақ роботтар...
Dialogue: 0,0:06:27.30,0:06:29.76,Default,,0,0,0,,Сіз тіпті аяқ киім кимейтін ақымақпен бірге жүрсіз...
Dialogue: 0,0:06:29.88,0:06:31.26,Default,,0,0,0,,Басқа ақымақ робот...
Dialogue: 0,0:06:31.39,0:06:34.06,Default,,0,0,0,,Олар картоптың қадірін де түсінбейді.
Dialogue: 0,0:06:34.18,0:06:36.18,Default,,0,0,0,,(іштің айқайлауы)
Dialogue: 0,0:06:37.35,0:06:39.77,Default,,0,0,0,,(Филли) Кеше жегенім бір кәмпит болды.
Dialogue: 0,0:06:42.27,0:06:44.27,Default,,0,0,0,,(Баяулаған дыбыс) (Филли) Иә?
Dialogue: 0,0:06:50.82,0:06:53.62,Default,,0,0,0,,(Филли) Бесси Сіздің де қарныңыз ашты ма?
Dialogue: 0,0:06:54.70,0:06:56.08,Default,,0,0,0,,Ах~аа
Dialogue: 0,0:06:58.08,0:06:59.79,Default,,0,0,0,,Хмм... Аа?
Dialogue: 0,0:07:07.59,0:07:09.34,Default,,0,0,0,,(Филли) Әлгі кішкентай жігіт...
Dialogue: 0,0:07:09.47,0:07:11.22,Default,,0,0,0,,(іш шымырлайды) (Филли) О, жоқ!
Dialogue: 0,0:07:11.34,0:07:13.85,Default,,0,0,0,,Мен сені кешіре алмаймын! аштан өлу
Dialogue: 0,0:07:16.14,0:07:17.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:18.31,0:07:20.23,Default,,0,0,0,,Хехе...
Dialogue: 0,0:07:21.10,0:07:22.27,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:07:23.40,0:07:25.06,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:25.98,0:07:27.07,Default,,0,0,0,,(Жануардың айқайы)
Dialogue: 0,0:07:27.19,0:07:30.49,Default,,0,0,0,,А, мен мұны істей алмаймын! Сіз қандайсыз!
Dialogue: 0,0:07:31.53,0:07:33.99,Default,,0,0,0,,Боқ... Иә?
Dialogue: 0,0:07:38.83,0:07:41.37,Default,,0,0,0,,Ах... хахахаха...
Dialogue: 0,0:07:41.50,0:07:43.46,Default,,0,0,0,,Хехехехехе...
Dialogue: 0,0:07:44.13,0:07:45.33,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:47.42,0:07:50.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:51.47,0:07:54.64,Default,,0,0,0,,(Өсімдіктердің өсуі)
Dialogue: 0,0:07:55.55,0:07:56.60,Default,,0,0,0,,Не?
Dialogue: 0,0:08:00.02,0:08:01.48,Default,,0,0,0,,(өсімдіктердің көгеруі)
Dialogue: 0,0:08:05.02,0:08:10.15,Default,,0,0,0,,(адамдардың дауысы)
Dialogue: 0,0:08:12.78,0:08:13.82,Default,,0,0,0,,Уау...
Dialogue: 0,0:08:13.95,0:08:17.74,Default,,0,0,0,,(Ер) Жүр, көңілді билейік, жас ханым.
Dialogue: 0,0:08:17.87,0:08:20.41,Default,,0,0,0,,(Ер адам) Міне! Ооооо...
Dialogue: 0,0:08:20.66,0:08:22.62,Default,,0,0,0,,(Кейси) Бәрібір рахмет.
Dialogue: 0,0:08:22.87,0:08:25.12,Default,,0,0,0,,Бұл өте талғампаз би болды.
Dialogue: 0,0:08:25.25,0:08:26.33,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:08:31.63,0:08:33.22,Default,,0,0,0,,Уау, қара!
Dialogue: 0,0:08:33.59,0:08:35.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:35.80,0:08:38.01,Default,,0,0,0,,Мен мұны шынымен көргім келеді.
Dialogue: 0,0:08:38.14,0:08:41.31,Default,,0,0,0,,Бұл сіздің денеңізді жабысқақ етеді...
Dialogue: 0,0:08:43.43,0:08:44.56,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:08:49.65,0:08:50.86,Default,,0,0,0,,Енді екеуің.
Dialogue: 0,0:08:51.23,0:08:54.95,Default,,0,0,0,,Тәттілер туралы айтатын болсақ, алкоголь - тамаша сүйемелдеу.
Dialogue: 0,0:08:57.24,0:08:59.99,Default,,0,0,0,,Уф... уау!
Dialogue: 0,0:09:01.08,0:09:04.46,Default,,0,0,0,,Уа... не... бұл қандай өсімдік?
Dialogue: 0,0:09:04.87,0:09:07.29,Default,,0,0,0,,Табиғат - ең жаман!
Dialogue: 0,0:09:08.00,0:09:09.42,Default,,0,0,0,,А? Хмм
Dialogue: 0,0:09:10.55,0:09:12.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:17.80,0:09:18.84,Default,,0,0,0,,(Әйел) Қош келдіңіз
Dialogue: 0,0:09:27.65,0:09:29.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:29.73,0:09:31.07,Default,,0,0,0,,(Кейси) О...
Dialogue: 0,0:09:32.94,0:09:34.19,Default,,0,0,0,,Ммм
Dialogue: 0,0:09:35.19,0:09:37.78,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:09:37.91,0:09:38.74,Default,,0,0,0,,Па!
Dialogue: 0,0:09:39.07,0:09:41.12,Default,,0,0,0,,Браво (Кейси) Керемет!
Dialogue: 0,0:09:46.50,0:09:48.33,Default,,0,0,0,,(Сэм Кейси) О...
Dialogue: 0,0:09:48.46,0:09:49.75,Default,,0,0,0,,О!
Dialogue: 0,0:09:50.04,0:09:53.67,Default,,0,0,0,,(Сұрақ қоюшы) Енді көптен күткен викторина уақыты!
Dialogue: 0,0:09:53.80,0:09:55.63,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:09:55.76,0:09:58.18,Default,,0,0,0,,(Сұрақ қоюшы) Бір мысық, екі жылқы бар.
Dialogue: 0,0:09:58.30,0:09:59.93,Default,,0,0,0,,(Сұрақ қоюшы) Сонымен қояндар ше? (түйменің басылған дыбысы)
Dialogue: 0,0:10:00.05,0:10:00.93,Default,,0,0,0,,(Кейси Сэм) Үш құс!
Dialogue: 0,0:10:01.05,0:10:02.26,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:10:02.39,0:10:03.93,Default,,0,0,0,,(Көрермендердің қошеметі мен қошеметі)
Dialogue: 0,0:10:04.47,0:10:05.85,Default,,0,0,0,,(әйелдер) жүлдесі.
Dialogue: 0,0:10:05.98,0:10:06.81,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:10:07.94,0:10:08.77,Default,,0,0,0,,Хахаха
Dialogue: 0,0:10:08.98,0:10:10.73,Default,,0,0,0,,Бірінен соң бірі барайық!
Dialogue: 0,0:10:10.98,0:10:11.81,Default,,0,0,0,,(Түйме басылған дыбыс)
Dialogue: 0,0:10:12.15,0:10:14.73,Default,,0,0,0,,(2 адам) Бауыр Кейбір жағдайларда тік ішек (Сұрақ беруші) Дұрыс!
Dialogue: 0,0:10:14.86,0:10:15.94,Default,,0,0,0,,(Басылған түйменің дыбысы) (Кейси Сэм) D витамині!
Dialogue: 0,0:10:16.07,0:10:17.07,Default,,0,0,0,,(Сұрақ қоюшы) Дұрыс! (түйменің басылған дыбысы)
Dialogue: 0,0:10:17.19,0:10:19.49,Default,,0,0,0,,(Кейси Сэм) Лимон сарымсақ туралған жалапено және тұз!
Dialogue: 0,0:10:19.61,0:10:20.74,Default,,0,0,0,,(Сұрақ қоюшы) Барлығы дұрыс!
Dialogue: 0,0:10:21.87,0:10:22.70,Default,,0,0,0,,Уууу
Dialogue: 0,0:10:26.58,0:10:28.66,Default,,0,0,0,,Адамдар бақытты емес пе?
Dialogue: 0,0:10:28.79,0:10:31.46,Default,,0,0,0,,Денеңіздің іші жабысып қалады деп уайымдамаңыз.
Dialogue: 0,0:10:31.58,0:10:34.05,Default,,0,0,0,,Мен қалаған уақытымда қалағанымды жей аламын.
Dialogue: 0,0:10:34.17,0:10:36.88,Default,,0,0,0,,«Тамақтанудан» гөрі, тамақтану керек.
Dialogue: 0,0:10:37.01,0:10:39.68,Default,,0,0,0,,Не? Мен тамақ ішпесем не болады?
Dialogue: 0,0:10:39.97,0:10:41.80,Default,,0,0,0,,Сіздің көңіл-күйіңіз өте нашар.
Dialogue: 0,0:10:41.93,0:10:43.51,Default,,0,0,0,,Сонда сен өлесің.
Dialogue: 0,0:10:46.27,0:10:48.10,Default,,0,0,0,,А, кешіріңізші.
Dialogue: 0,0:10:52.15,0:10:53.94,Default,,0,0,0,,Ішу трюктері Көбірек қалайсыз ба?
Dialogue: 0,0:10:54.48,0:10:55.57,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:59.03,0:11:00.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:00.36,0:11:03.82,Default,,0,0,0,,(Әйелдер күледі) (Филли) Ах... хахаха
Dialogue: 0,0:11:05.20,0:11:06.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:06.74,0:11:08.75,Default,,0,0,0,,(Әйелдердің күлкісі)
Dialogue: 0,0:11:10.29,0:11:12.58,Default,,0,0,0,,Бәлкім, бұл жерде жаман емес шығар.
Dialogue: 0,0:11:13.00,0:11:14.34,Default,,0,0,0,,Мәңгі осында қалайық
Dialogue: 0,0:11:14.46,0:11:15.75,Default,,0,0,0,,Мұнда әйелді табыңыз-
Dialogue: 0,0:11:15.88,0:11:17.76,Default,,0,0,0,,Семіз, шіркін бала ту.
Dialogue: 0,0:11:17.88,0:11:19.51,Default,,0,0,0,,Мені семіз, ұсқынсыз бала етіп өсір.
Dialogue: 0,0:11:19.63,0:11:21.51,Default,,0,0,0,,Өлгенше осында бірге тұрайық
Dialogue: 0,0:11:21.63,0:11:23.47,Default,,0,0,0,,Мүмкін мен хоббимен айналысуым керек шығар.
Dialogue: 0,0:11:23.59,0:11:26.51,Default,,0,0,0,,Тоқу үшін қажет нәрсенің бәрі осында.
Dialogue: 0,0:11:27.10,0:11:31.02,Default,,0,0,0,,Ешкім сыраңызды ұрлай алмайды немесе картопты жей алмайды.
Dialogue: 0,0:11:31.14,0:11:34.52,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:11:34.65,0:11:36.40,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:36.52,0:11:40.49,Default,,0,0,0,,Ха ха ха... Осылай өлудің жолы бар ма?
Dialogue: 0,0:11:40.99,0:11:44.53,Default,,0,0,0,,(Әйел) Жоқ~ Өте сүйкімді~ Хахаха...
Dialogue: 0,0:11:46.53,0:11:48.54,Default,,0,0,0,,(Әйел) Иә? сәлем мен Сам
Dialogue: 0,0:11:48.99,0:11:51.00,Default,,0,0,0,,Сіз картоп чипсы жеп көрдіңіз бе?
Dialogue: 0,0:11:51.12,0:11:52.04,Default,,0,0,0,,(Әйел) Әрқашан
Dialogue: 0,0:11:52.79,0:11:54.83,Default,,0,0,0,,Сіз толқын тәрізді жеп көрдіңіз бе?
Dialogue: 0,0:11:55.25,0:11:58.34,Default,,0,0,0,,Жоқ Менің жегенім тегіс болды.
Dialogue: 0,0:11:58.46,0:12:00.30,Default,,0,0,0,,Е! тыңда
Dialogue: 0,0:12:00.80,0:12:03.47,Default,,0,0,0,,Бұл бала ешқашан гофрленген картопты жеген емес!
Dialogue: 0,0:12:03.59,0:12:04.68,Default,,0,0,0,,(Әйелдер) Ех!
Dialogue: 0,0:12:04.80,0:12:06.30,Default,,0,0,0,,(Әйел) Өйткені бетінің ауданы ұлғаяды.
Dialogue: 0,0:12:06.43,0:12:08.06,Default,,0,0,0,,Дәмінен көбірек ләззат алуға болады.
Dialogue: 0,0:12:08.43,0:12:11.64,Default,,0,0,0,,(Әйел) Иә, бір уақытта тістеп алған жақсы.
Dialogue: 0,0:12:11.77,0:12:16.02,Default,,0,0,0,,Бұл сізді тыныштандырады және бір суретте 20 суретті тамашалай аласыз.
Dialogue: 0,0:12:16.15,0:12:19.82,Default,,0,0,0,,(Әйел) Мен күні бойы стерильді зауытта жұмыс істеймін...
Dialogue: 0,0:12:19.94,0:12:24.07,Default,,0,0,0,,Үйге барып, бір қап гофрленген картопты жұтып қойғаннан артық ештеңе жоқ.
Dialogue: 0,0:12:24.32,0:12:26.45,Default,,0,0,0,,Әртүрлі тағамдарды да жеп көру керек.
Dialogue: 0,0:12:26.57,0:12:28.12,Default,,0,0,0,,Әртүрлі дәмдер
Dialogue: 0,0:12:28.24,0:12:31.00,Default,,0,0,0,,Картоп чипсінің әртүрлі дәмі бар ма?
Dialogue: 0,0:12:31.12,0:12:32.33,Default,,0,0,0,,(Әйелдер) Жоқ!
Dialogue: 0,0:12:32.46,0:12:33.75,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:33.87,0:12:35.75,Default,,0,0,0,,А... А?
Dialogue: 0,0:12:36.38,0:12:38.79,Default,,0,0,0,,6273-бірлік
Dialogue: 0,0:12:38.92,0:12:41.67,Default,,0,0,0,,Сіздің күйеуіңіз де солай ма?
Dialogue: 0,0:12:41.80,0:12:44.76,Default,,0,0,0,,Жаңа ғана сәбиге Виктория есімін қоюды жөн көрдік.
Dialogue: 0,0:12:47.80,0:12:49.14,Default,,0,0,0,,(Әйелдер) Хэхехе...
Dialogue: 0,0:12:49.26,0:12:50.51,Default,,0,0,0,,Ах
Dialogue: 0,0:12:54.39,0:12:57.44,Default,,0,0,0,,(Қонақтар айқайлайды)
Dialogue: 0,0:12:57.56,0:12:58.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:11.37,0:13:12.37,Default,,0,0,0,,Аяқ
Dialogue: 0,0:13:13.29,0:13:15.96,Default,,0,0,0,,Он екіден бері біраз уақыт өтті
Dialogue: 0,0:13:16.54,0:13:18.79,Default,,0,0,0,,Ешкім таба алмайтын адам...
Dialogue: 0,0:13:18.92,0:13:20.50,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:13:23.63,0:13:25.80,Default,,0,0,0,,Уф... не?
Dialogue: 0,0:13:25.93,0:13:28.05,Default,,0,0,0,,Мен сені мұнда қалай азғырдым?
Dialogue: 0,0:13:28.18,0:13:29.05,Default,,0,0,0,,Оны естігің келмей ме?
Dialogue: 0,0:13:29.80,0:13:31.14,Default,,0,0,0,,‪
Dialogue: 0,0:13:33.68,0:13:36.10,Default,,0,0,0,,Мен сені азғырдым.
Dialogue: 0,0:13:36.23,0:13:37.98,Default,,0,0,0,,(Кейси) Уау!
Dialogue: 0,0:13:38.10,0:13:40.06,Default,,0,0,0,,6273 бірлік! (6273-бірлік) Ах...
Dialogue: 0,0:13:41.19,0:13:42.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:44.11,0:13:46.03,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:13:48.78,0:13:51.74,Default,,0,0,0,,Менің ойымша, ол ұйымға оңайлықпен оралмайды.
Dialogue: 0,0:13:51.95,0:13:56.04,Default,,0,0,0,,Ішімдіктің бәрін ішіп, ойын ойнап болған соң, ә...
Dialogue: 0,0:13:56.16,0:13:58.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:58.58,0:13:59.63,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:20.48,0:14:21.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:21.40,0:14:22.31,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:25.40,0:14:26.28,Default,,0,0,0,,Иә
Dialogue: 0,0:14:28.20,0:14:29.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:41.83,0:14:45.63,Default,,0,0,0,,Сәлем, менің салатыма бір нәрсе бере аласыз ба?
Dialogue: 0,0:14:47.88,0:14:51.55,Default,,0,0,0,,Мен мұны Филиге мүмкіндігінше тезірек жеткізгім келеді.
Dialogue: 0,0:14:51.68,0:14:52.97,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:14:53.10,0:14:55.60,Default,,0,0,0,,Бұл тамақ болса да, оған өмір сүру керек.
Dialogue: 0,0:14:55.72,0:14:58.64,Default,,0,0,0,,Мен оны қызық үшін жегенім үшін кешірім сұраймын.
Dialogue: 0,0:14:59.94,0:15:02.31,Default,,0,0,0,,(6273-бөлім) Бұл екеуінің арасындағы шайқас аяқталады...
Dialogue: 0,0:15:02.44,0:15:03.86,Default,,0,0,0,,Тоғыз бізбен бірге...
Dialogue: 0,0:15:03.98,0:15:06.94,Default,,0,0,0,,Сіз Қызыл Ронинге қайта оралуды қабылдайсыз ба?
Dialogue: 0,0:15:07.07,0:15:10.57,Default,,0,0,0,,Рұқсатсыз кеткеніңіз үшін не өлтіресіз.
Dialogue: 0,0:15:10.86,0:15:12.53,Default,,0,0,0,,Виктория қызық!
Dialogue: 0,0:15:12.66,0:15:13.91,Default,,0,0,0,,Уфуфу
Dialogue: 0,0:15:15.91,0:15:16.74,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:20.62,0:15:21.58,Default,,0,0,0,,Хмф!
Dialogue: 0,0:15:22.08,0:15:23.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:24.88,0:15:26.25,Default,,0,0,0,,Ой...
Dialogue: 0,0:15:26.96,0:15:27.71,Default,,0,0,0,,Хаха
Dialogue: 0,0:15:30.84,0:15:32.51,Default,,0,0,0,,Иә! иә! ?
Dialogue: 0,0:15:39.89,0:15:40.73,Default,,0,0,0,,Арх!
Dialogue: 0,0:15:43.73,0:15:44.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:45.98,0:15:47.82,Default,,0,0,0,,(тесетін дыбыс)
Dialogue: 0,0:15:58.91,0:16:01.54,Default,,0,0,0,,Сіз соншалықты күшті болдыңыз ба?
Dialogue: 0,0:16:01.91,0:16:04.50,Default,,0,0,0,,Мен бүгін ішімдікті көп іштім.
Dialogue: 0,0:16:09.13,0:16:11.84,Default,,0,0,0,,Сіз неден тартынасыз? Тез жасаңыз!
Dialogue: 0,0:16:13.22,0:16:15.26,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:16:15.64,0:16:16.85,Default,,0,0,0,,Дұрыс түсініңіз!
Dialogue: 0,0:16:17.14,0:16:20.60,Default,,0,0,0,,Сені өлтіремін бе? Бұл менің ниетім емес
Dialogue: 0,0:16:21.02,0:16:22.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:30.36,0:16:33.65,Default,,0,0,0,,Он екі Мен сені сүйемін
Dialogue: 0,0:16:33.78,0:16:36.91,Default,,0,0,0,,Сол ақылды роботтарға рахмет.
Dialogue: 0,0:16:37.03,0:16:40.04,Default,,0,0,0,,Ақырында мұны айтуға әбден мас болдым.
Dialogue: 0,0:16:40.54,0:16:43.50,Default,,0,0,0,,Олай болса, өтінемін! Менімен бірге қайт!
Dialogue: 0,0:16:43.62,0:16:46.42,Default,,0,0,0,,Ұйымдағы барлық Рониндер сізді іздеп жатыр.
Dialogue: 0,0:16:46.54,0:16:48.71,Default,,0,0,0,,Қайтпасаң, өлтіресің!
Dialogue: 0,0:16:49.04,0:16:52.30,Default,,0,0,0,,Жоқ десем, мені де өлтіресің бе?
Dialogue: 0,0:16:52.42,0:16:53.76,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:14.32,0:17:18.41,Default,,0,0,0,,Бұл тапсырма осы үйдегілердің барлығын өлтіру.
Dialogue: 0,0:17:18.91,0:17:20.53,Default,,0,0,0,,Балалар бар, солай ма?
Dialogue: 0,0:17:21.74,0:17:25.08,Default,,0,0,0,,Жарайды, бәрі, мен ештеңе сезбеймін.
Dialogue: 0,0:17:30.54,0:17:33.88,Default,,0,0,0,,Бай өмірден бақытты жалғыз нәрсе
Dialogue: 0,0:17:34.01,0:17:36.18,Default,,0,0,0,,Бұл бейбіт өлім
Dialogue: 0,0:17:36.63,0:17:39.64,Default,,0,0,0,,(Адамның ұйықтап жатқан тынысы)
Dialogue: 0,0:17:41.76,0:17:42.64,Default,,0,0,0,,(Ер) Ух...
Dialogue: 0,0:17:55.90,0:17:56.74,Default,,0,0,0,,Ах
Dialogue: 0,0:17:57.07,0:17:58.91,Default,,0,0,0,,(Қыз) А... аа...
Dialogue: 0,0:18:02.62,0:18:05.29,Default,,0,0,0,,Сіз де мені өлтіруді жоспарлап отырсыз ба?
Dialogue: 0,0:18:12.96,0:18:14.21,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:14.34,0:18:16.42,Default,,0,0,0,,(кесу дыбысы)
Dialogue: 0,0:18:21.30,0:18:22.89,Default,,0,0,0,,Тез орындаңыз
Dialogue: 0,0:18:23.22,0:18:25.89,Default,,0,0,0,,Қараңдар, мен саған жеңілдетемін.
Dialogue: 0,0:18:32.61,0:18:34.32,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:18:35.11,0:18:37.28,Default,,0,0,0,,(құсу дыбысы)
Dialogue: 0,0:18:37.99,0:18:40.91,Default,,0,0,0,,Жоқ, бұл жылы сыраның кесірінен.
Dialogue: 0,0:18:41.03,0:18:43.24,Default,,0,0,0,,(Тоғыздың түкірген дыбысы) Фуфуфу
Dialogue: 0,0:18:48.66,0:18:50.96,Default,,0,0,0,,Менімен бірге келгіңіз келетініне сенімдісіз бе?
Dialogue: 0,0:18:51.08,0:18:53.42,Default,,0,0,0,,Қызыл Ронинге оралудың қажеті жоқ
Dialogue: 0,0:18:53.79,0:18:56.55,Default,,0,0,0,,Бір жерге бірге барайық
Dialogue: 0,0:18:57.55,0:18:59.30,Default,,0,0,0,,Бір күні тағы кездесетінімізге сенімдімін
Dialogue: 0,0:18:59.63,0:19:01.05,Default,,0,0,0,,көремін.
Dialogue: 0,0:19:02.18,0:19:04.51,Default,,0,0,0,,Барлығы бұл хикки деп ойлайды.
Dialogue: 0,0:19:05.43,0:19:06.52,Default,,0,0,0,,Аяқ
Dialogue: 0,0:19:07.93,0:19:09.73,Default,,0,0,0,,Көріскенше, қария.
Dialogue: 0,0:19:10.73,0:19:12.52,Default,,0,0,0,,Ах хехе
Dialogue: 0,0:19:13.31,0:19:16.19,Default,,0,0,0,,Менің жасым небәрі 30-да.
Dialogue: 0,0:19:16.44,0:19:18.03,Default,,0,0,0,,(Кейси) Виктория!
Dialogue: 0,0:19:26.16,0:19:29.45,Default,,0,0,0,,6273 блогы туралы не ойлайсыз?
Dialogue: 0,0:19:29.58,0:19:31.46,Default,,0,0,0,,Сізге еруім керек пе еді?
Dialogue: 0,0:19:31.58,0:19:34.84,Default,,0,0,0,,(6273-бірлік) Ақпараттың жоқтығынан қайсысы жақсы екенін білмеймін.
Dialogue: 0,0:19:47.22,0:19:50.89,Default,,0,0,0,,Мүмкін мен де сені Виктория деп атағаным жөн болар.
Dialogue: 0,0:19:51.02,0:19:52.14,Default,,0,0,0,,(6273 бірлік) Бұл жақсы
Dialogue: 0,0:19:52.27,0:19:55.40,Default,,0,0,0,,Алдыңғы атқа қарағанда айтылуы әлдеқайда жеңіл
Dialogue: 0,0:19:58.48,0:20:01.20,Default,,0,0,0,,А... хмм?
Dialogue: 0,0:20:01.82,0:20:04.66,Default,,0,0,0,,Сіз өмірге қайта оралсаңыз да, оны қайтадан балқытуды жоспарлап отырсыз ба?
Dialogue: 0,0:20:04.78,0:20:06.28,Default,,0,0,0,,Бұл елес өсімдік...
Dialogue: 0,0:20:06.74,0:20:08.24,Default,,0,0,0,,Табиғат-Анаға алғысымызды білдірейік!
Dialogue: 0,0:20:16.42,0:20:18.50,Default,,0,0,0,,Е...Арчичичи!
Dialogue: 0,0:20:18.92,0:20:21.01,Default,,0,0,0,,Мен табиғатты жек көремін!
Dialogue: 0,0:20:21.92,0:20:24.43,Default,,0,0,0,,Тамақ жемесең ренжіп қалатыныңды естідім.
Dialogue: 0,0:20:24.55,0:20:27.01,Default,,0,0,0,,Осыны жеп, өзіңізді жақсы сезініңіз.
Dialogue: 0,0:20:27.35,0:20:28.72,Default,,0,0,0,,Хахаха
Dialogue: 0,0:20:35.10,0:20:37.36,Default,,0,0,0,,Көңілді болды, бірақ қоштасатын кез келді.
Dialogue: 0,0:20:37.94,0:20:40.15,Default,,0,0,0,,Сіз кетейін бе?
Dialogue: 0,0:20:40.61,0:20:43.28,Default,,0,0,0,,Әркім өз жолымен жүруі керек.
Dialogue: 0,0:20:43.40,0:20:46.74,Default,,0,0,0,,Менің өз саяхатыма қайтатын уақытым таяп қалды.
Dialogue: 0,0:20:46.87,0:20:48.91,Default,,0,0,0,,Сізде сыра жоқ.
Dialogue: 0,0:20:49.33,0:20:52.20,Default,,0,0,0,,Не, сыра әкелген жоқсың ба?
Dialogue: 0,0:20:52.33,0:20:53.62,Default,,0,0,0,,Иә, қоймада жоқ
Dialogue: 0,0:20:54.37,0:20:58.42,Default,,0,0,0,,Кездескенше, мас ковбой
Dialogue: 0,0:21:04.63,0:21:07.30,Default,,0,0,0,,(Кейси ызылдайды)
Dialogue: 0,0:21:12.43,0:21:13.27,Default,,0,0,0,,(Филли) Hmph
Dialogue: 0,0:21:15.89,0:21:18.61,Default,,0,0,0,,Оны бөліспеңіз. Бұл менікі.
Dialogue: 0,0:21:18.73,0:21:20.86,Default,,0,0,0,,Ашкөз картоп ұры
Dialogue: 0,0:21:20.98,0:21:22.19,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:22.32,0:21:24.19,Default,,0,0,0,,Көңіл айтқым келді.
Dialogue: 0,0:21:24.82,0:21:28.16,Default,,0,0,0,,Біз жоқта ол тағы да дүниеден өткен сияқты.
Dialogue: 0,0:21:30.53,0:21:32.95,Default,,0,0,0,,Не, тіпті есеп жүргізіп жатырсың ба?
Dialogue: 0,0:21:33.08,0:21:36.21,Default,,0,0,0,,Тәніме қарама, бұзық
Dialogue: 0,0:21:36.33,0:21:37.12,Default,,0,0,0,,Эхехе
Dialogue: 0,0:21:37.25,0:21:40.75,Default,,0,0,0,,Бірақ... иә, рахмет.
Dialogue: 0,0:21:40.88,0:21:42.96,Default,,0,0,0,,Салаттар және басқа да заттар
Dialogue: 0,0:21:43.38,0:21:46.17,Default,,0,0,0,,Әрине, біз доспыз.
Dialogue: 0,0:21:46.47,0:21:47.43,Default,,0,0,0,,(Эдди) Фили?
Dialogue: 0,0:21:47.55,0:21:49.93,Default,,0,0,0,,Бала Фили, мен сенің сонда екеніңді білемін
Dialogue: 0,0:21:50.30,0:21:52.35,Default,,0,0,0,,Радионы дереу алыңыз немесе...
Dialogue: 0,0:21:52.47,0:21:53.22,Default,,0,0,0,,(Арнаны өзгерту дыбысы)
Dialogue: 0,0:21:53.35,0:21:56.98,Default,,0,0,0,,(Радио музыка)
Dialogue: 0,0:21:57.35,0:21:58.85,Default,,0,0,0,,Бұл жақсы ән.
Dialogue: 0,0:21:59.31,0:22:00.61,Default,,0,0,0,,(Филли) Хмм.
Dialogue: 0,0:22:00.73,0:22:03.44,Default,,0,0,0,,Жарайсыңдар, кететін уақыт келді, алаяқтар.
Dialogue: 0,0:22:03.57,0:22:05.57,Default,,0,0,0,,(қозғалтқыштың іске қосу дыбысы)
Dialogue: 0,0:22:11.07,0:22:16.08,Default,,0,0,0,,♪～
Dialogue: 0,0:23:35.91,0:23:40.91,Default,,0,0,0,,～♪
