Dialogue: 0,0:00:14.28,0:00:18.03,STAFF,,0,0,0,,Бұл субтитрді Менг Чая жазған Джоки Кин шығарған Бұл жұмыс түпнұсқа нұсқасын сатып алу арқылы қолдау көрсетеді Субтитр тобы Жаңа QQ тобын шақыру: 421320480
Dialogue: 0,0:00:18.03,0:00:21.79,STAFF,,0,0,0,,Аударма: i-ді осы әлемге қою Ронни мектебі/Уақыты: Ронни Дамуы: Юзукико Кеш кезең: Пои Сыртта: GEEK
Dialogue: 1,0:19:30.63,0:19:32.87,COMMENT,,0,0,0,,Ескертпе: Гүл қолданылған кезде оның жапондық атауы.
Dialogue: 0,0:02:52.07,0:02:57.49,Gothic,,0,0,0,,Алғашқы жазғы оқу-жаттығу жиыны
Dialogue: 0,0:01:22.90,0:01:25.98,OP_JP,,0,0,0,,Сәлем, танысқаныма қуаныштымын.
Dialogue: 0,0:01:26.40,0:01:29.32,OP_JP,,0,0,0,,MANKAI компаниясына қош келдіңіз
Dialogue: 0,0:01:29.32,0:01:34.53,OP_JP,,0,0,0,,Папаппа, кенет гүлдеді
Dialogue: 0,0:01:35.53,0:01:39.95,OP_JP,,0,0,0,,Қозғала бастағанда, арман басталады
Dialogue: 0,0:01:41.04,0:01:45.63,OP_JP,,0,0,0,,Сізге ғашық болатын сценарийлер
Dialogue: 0,0:01:46.63,0:01:51.63,OP_JP,,0,0,0,,Қандай жағдайда болсаңыз да
Dialogue: 0,0:01:51.63,0:01:53.80,OP_JP,,0,0,0,,Қолыңызды созсаңыз
Dialogue: 0,0:01:53.80,0:01:59.14,OP_JP,,0,0,0,,Сізді армандаған кезең күтіп тұр
Dialogue: 0,0:01:59.77,0:02:02.60,OP_JP,,0,0,0,,Бақытқа сен кінәлісің
Dialogue: 0,0:01:59.77,0:02:02.60,OP_JP,,0,0,0,,Эйфория
Dialogue: 0,0:02:02.60,0:02:05.19,OP_JP,,0,0,0,,Дүние өзгерген сияқты
Dialogue: 0,0:02:05.19,0:02:08.02,OP_JP,,0,0,0,,«Тағдыр» десең
Dialogue: 0,0:02:08.02,0:02:12.57,OP_JP,,0,0,0,,Шулы перде көтеріледі
Dialogue: 0,0:02:13.03,0:02:20.16,OP_JP,,0,0,0,,Сенімен бірге гүлдейміз, арман хикаясы
Dialogue: 0,0:02:20.16,0:02:26.38,OP_JP,,0,0,0,,Басты кейіпкер болсын, қосалқы кейіпкер болсын маңызды емес.
Dialogue: 0,0:02:26.38,0:02:32.97,OP_JP,,0,0,0,,Әр адам батыр болып туылғанына сенімдімін.
Dialogue: 0,0:02:32.97,0:02:38.10,OP_JP,,0,0,0,,Астыңда құлпырып 1-бет
Dialogue: 0,0:02:38.10,0:02:40.31,OP_JP,,0,0,0,,Біз кездейсоқ кездестік.
Dialogue: 0,0:02:40.31,0:02:43.14,OP_JP,,0,0,0,,MANKAI компаниясына қош келдіңіз
Dialogue: 0,0:02:43.14,0:02:48.82,OP_JP,,0,0,0,,Папаппа, кенет гүлдеді
Dialogue: 0,0:22:11.98,0:22:17.65,ED_JP,,0,0,0,,Мен сол бұрышқа бұрылғанымда кенеттен мен
Dialogue: 0,0:22:17.65,0:22:24.66,ED_JP,,0,0,0,,Бақыт деген не деп ойладым.
Dialogue: 0,0:22:26.95,0:22:32.79,ED_JP,,0,0,0,,Төбеге шыққанда тынысы тарылып
Dialogue: 0,0:22:32.79,0:22:39.09,ED_JP,,0,0,0,,Мен барлығының сүйікті декорациясын көрдім
Dialogue: 0,0:22:40.21,0:22:47.64,ED_JP,,0,0,0,,Ауа райы болжамы онша сенімді емес.
Dialogue: 0,0:22:47.64,0:22:55.27,ED_JP,,0,0,0,,Бұлттарды, бүкіл қызғылт сары аспанды итеріп жібереді
Dialogue: 0,0:22:55.27,0:22:58.98,ED_JP,,0,0,0,,Мен өз сезімімнен бас тарта алмаймын
Dialogue: 0,0:22:58.98,0:23:03.78,ED_JP,,0,0,0,,Бас тартпайтын арманыңды ұста
Dialogue: 0,0:23:03.78,0:23:10.04,ED_JP,,0,0,0,,Осы уақытқа дейін бірге келдік.
Dialogue: 0,0:23:10.04,0:23:14.04,ED_JP,,0,0,0,,Жаныңа қарасаң,
Dialogue: 0,0:23:14.04,0:23:18.54,ED_JP,,0,0,0,,Барлығының жүзі жарқырап тұр
Dialogue: 0,0:23:18.54,0:23:26.05,ED_JP,,0,0,0,,Кеудедегі қызғылт сары жүрек
Dialogue: 0,0:00:17.53,0:00:18.62,JP,,0,0,0,,Ыстық
Dialogue: 0,0:00:19.08,0:00:21.13,JP,,0,0,0,,Бұл нағыз ыңғайсыздық.
Dialogue: 0,0:00:21.23,0:00:22.10,JP,,0,0,0,,(Каишо) Қорықпа—ағамның қаны менікімен бірдей қасиетке ие емес.
Dialogue: 0,0:00:22.10,0:00:23.79,JP,,0,0,0,,Бәріміз бірге естеліктер жасайық
Dialogue: 0,0:00:27.02,0:00:29.88,JP,,0,0,0,,Үшбұрышқа қараңдар
Dialogue: 0,0:00:29.88,0:00:31.88,JP,,0,0,0,,Лайк басыңыз Суретке түсейік
Dialogue: 0,0:00:31.88,0:00:33.54,JP,,0,0,0,,Олай болса мен кетейін.
Dialogue: 0,0:00:33.88,0:00:37.67,JP,,0,0,0,,Мен кетсем де жатақхана жақсы бола ма?
Dialogue: 0,0:00:37.67,0:00:39.67,JP,,0,0,0,,Иә, оны маған қалдырыңыз.
Dialogue: 0,0:00:40.15,0:00:42.35,JP,,0,0,0,,Бұл әдеттегіден айтарлықтай ерекшеленбейді.
Dialogue: 0,0:00:42.48,0:00:44.02,JP,,0,0,0,,Мен де сенімен бірге барамын.
Dialogue: 0,0:00:45.07,0:00:47.53,JP,,0,0,0,,Мен алмаймын, себебі бұл жазғы топтық жаттығу.
Dialogue: 0,0:00:47.72,0:00:49.32,JP,,0,0,0,,Онда мен жазғы топқа қосыламын.
Dialogue: 0,0:00:49.32,0:00:51.95,JP,,0,0,0,,Масуми-кун, көктемгі топ не істейді?
Dialogue: 0,0:00:52.27,0:00:54.90,JP,,0,0,0,,Негізінде, сіз неге бара аласыз?
Dialogue: 0,0:00:54.90,0:00:56.38,JP,,0,0,0,,Мен бе?
Dialogue: 0,0:00:56.48,0:00:58.87,JP,,0,0,0,,Мен, әрине, жұмысшымын.
Dialogue: 0,0:00:58.87,0:01:01.09,JP,,0,0,0,,Мен көңілді мәлімдеме жасадым.
Dialogue: 0,0:01:01.09,0:01:02.37,JP,,0,0,0,,Мен де солай істеймін
Dialogue: 0,0:01:05.13,0:01:07.05,JP,,0,0,0,,Әй, өзімшіл болма.
Dialogue: 0,0:01:07.05,0:01:08.19,JP,,0,0,0,,Цузуриді жіберіңіз
Dialogue: 0,0:01:08.19,0:01:10.71,JP,,0,0,0,,Мен мынаны ұстаймын, келіңдер.
Dialogue: 0,0:01:11.24,0:01:13.36,JP,,0,0,0,,Барлығына сәттілік
Dialogue: 0,0:01:14.68,0:01:15.60,JP,,0,0,0,,Тенма-кун да
Dialogue: 0,0:01:16.50,0:01:17.79,JP,,0,0,0,,Жақсы өтеді деп үміттенемін.
Dialogue: 0,0:01:19.60,0:01:20.06,JP,,0,0,0,,О
Dialogue: 0,0:03:02.69,0:03:04.41,JP,,0,0,0,,Міне, келдік.
Dialogue: 0,0:03:04.71,0:03:06.18,JP,,0,0,0,,Баршаңызға жақсы жұмыс
Dialogue: 0,0:03:10.65,0:03:12.18,JP,,0,0,0,,Бұл жаттығу лагері ме?
Dialogue: 0,0:03:12.63,0:03:14.37,JP,,0,0,0,,Бұл қалай сезінеді
Dialogue: 0,0:03:14.37,0:03:17.37,JP,,0,0,0,,Неге екені белгісіз, бұл маған клубтық оқу-жаттығу жиынын еске түсіреді.
Dialogue: 0,0:03:17.56,0:03:19.56,JP,,0,0,0,,Үшбұрышты шатыр
Dialogue: 0,0:03:19.83,0:03:23.10,JP,,0,0,0,,Ретро болғаны дұрыс, орнатуды жаңартайық.
Dialogue: 0,0:03:23.74,0:03:25.73,JP,,0,0,0,,Юкки және басқалармен бірге суретке түсейік
Dialogue: 0,0:03:25.73,0:03:27.03,JP,,0,0,0,,Суретке түсіруге рұқсат етілмейді
Dialogue: 0,0:03:27.93,0:03:29.15,JP,,0,0,0,,Жалқау болмаңыз
Dialogue: 0,0:03:29.40,0:03:30.18,JP,,0,0,0,,Тез барайық.
Dialogue: 0,0:03:30.95,0:03:32.40,JP,,0,0,0,,Иә, иә
Dialogue: 0,0:03:34.62,0:03:37.12,JP,,0,0,0,,Сіз неге сонша ынталысыз?
Dialogue: 0,0:03:37.88,0:03:39.33,JP,,0,0,0,,Кеттік, Сачи-кун
Dialogue: 0,0:03:48.39,0:03:49.86,JP,,0,0,0,,Айтшы, Шеразада
Dialogue: 0,0:03:50.71,0:03:53.19,JP,,0,0,0,,Елес жұмақ оазисі қайда орналасқан?
Dialogue: 0,0:03:53.61,0:03:55.84,JP,,0,0,0,,Бүгін кешке де сөйлесейік.
Dialogue: 0,0:03:56.20,0:03:57.91,JP,,0,0,0,,Баяғыда бір елде...
Dialogue: 0,0:03:57.91,0:03:58.91,JP,,0,0,0,,Ұзақ кіріспе
Dialogue: 0,0:03:58.91,0:03:59.63,JP,,0,0,0,,Үш жолда
Dialogue: 0,0:04:00.21,0:04:02.78,JP,,0,0,0,,Аладдин сиқырлы шам шебері
Dialogue: 0,0:04:03.10,0:04:03.83,JP,,0,0,0,,Жүректеріңізді құрбан етіңіздер!! Жүректеріңізді құрбан етіңіздер!! (Әскери полиция) Хич
Dialogue: 0,0:04:05.51,0:04:07.38,JP,,0,0,0,,Абайлаңыз Alibaba
Dialogue: 0,0:04:08.23,0:04:09.38,JP,,0,0,0,,Сачи-кун, қазір...
Dialogue: 0,0:04:09.38,0:04:09.87,JP,,0,0,0,,Эй
Dialogue: 0,0:04:10.82,0:04:13.27,JP,,0,0,0,,Шехаразада ауа райы ондай емес.
Dialogue: 0,0:04:16.66,0:04:20.24,JP,,0,0,0,,Ах, өйткені патша гаремге қосылуымды өтінді.
Dialogue: 0,0:04:20.59,0:04:21.44,JP,,0,0,0,,Иә.
Dialogue: 0,0:04:22.01,0:04:24.25,JP,,0,0,0,,Соңында түсінікті болады
Dialogue: 0,0:04:24.25,0:04:26.19,JP,,0,0,0,,Актерлер осыны ескере отырып әрекет етуі керек.
Dialogue: 0,0:04:26.81,0:04:27.68,JP,,0,0,0,,Иә, иә
Dialogue: 0,0:04:30.62,0:04:32.71,JP,,0,0,0,,Абайлаңыз Alibaba
Dialogue: 0,0:04:33.19,0:04:36.47,JP,,0,0,0,,Сіз әрқашан адамдардың айтқанын дұрыс тыңдамайтыныңызды айттыңыз.
Dialogue: 0,0:04:36.47,0:04:38.34,JP,,0,0,0,,Өйткені оның өлімге әкелетін кемшілігі бар
Dialogue: 0,0:04:38.54,0:04:41.43,JP,,0,0,0,,Alibaba-ға да ешқандай сезім жоқ.
Dialogue: 0,0:04:41.79,0:04:43.16,JP,,0,0,0,,Мұны интуитивті түрде жасамаңыз
Dialogue: 0,0:04:44.20,0:04:45.40,JP,,0,0,0,,Мен білемін.
Dialogue: 0,0:04:47.57,0:04:49.14,JP,,0,0,0,,Бұл қыз да өте сүйкімді
Dialogue: 0,0:04:49.47,0:04:51.73,JP,,0,0,0,,Эй, сен менімен қыдырғың келе ме?
Dialogue: 0,0:04:51.85,0:04:53.72,JP,,0,0,0,,Онда кернеуді күшейтіңіз
Dialogue: 0,0:04:54.38,0:04:55.16,JP,,0,0,0,,Солай ма?
Dialogue: 0,0:04:55.73,0:04:57.09,JP,,0,0,0,,Өйткені ол менің болашақ әйелім
Dialogue: 0,0:04:57.39,0:04:59.93,JP,,0,0,0,,Басқа қыздарды алған кезде өзгеру
Dialogue: 0,0:05:01.19,0:05:02.45,JP,,0,0,0,,Міне, солай.
Dialogue: 0,0:05:02.69,0:05:03.60,JP,,0,0,0,,Осы қарқынмен, Хамон…
Dialogue: 0,0:05:04.50,0:05:06.58,JP,,0,0,0,,Өсе бер, Алибаба
Dialogue: 0,0:05:07.50,0:05:08.42,JP,,0,0,0,,Фантом мектебі...
Dialogue: 0,0:05:08.42,0:05:09.04,JP,,0,0,0,,Жұмақ
Dialogue: 0,0:05:09.63,0:05:10.43,JP,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:11.65,0:05:14.99,JP,,0,0,0,,Үлкен бол... Үлкен бол, Әлібаба
Dialogue: 0,0:05:15.57,0:05:18.28,JP,,0,0,0,,Ешқандай елес жұмақ жоқ.
Dialogue: 0,0:05:18.94,0:05:20.95,JP,,0,0,0,,Бұл қиял-ғажайып жұмақ болар еді
Dialogue: 0,0:05:21.10,0:05:24.17,JP,,0,0,0,,Бұл иллюзия, сондықтан ол өмір сүре алмайды.
Dialogue: 0,0:05:24.33,0:05:26.16,JP,,0,0,0,,Абайсыз шындық
Dialogue: 0,0:05:27.18,0:05:27.95,JP,,0,0,0,,Не болды?
Dialogue: 0,0:05:31.77,0:05:34.24,JP,,0,0,0,,Сол бұлтты үшбұрыш
Dialogue: 0,0:05:35.08,0:05:36.58,JP,,0,0,0,,Ол қазір жаттығуда.
Dialogue: 0,0:05:36.58,0:05:37.95,JP,,0,0,0,,Ойынға назар аударыңыз
Dialogue: 0,0:05:37.95,0:05:40.20,JP,,0,0,0,,Үшбұрыштарға толы
Dialogue: 0,0:05:40.70,0:05:42.59,JP,,0,0,0,,Біз үзіліс жасаймыз ба?
Dialogue: 0,0:05:44.87,0:05:49.82,JP,,0,0,0,,Неліктен Шеразада «Мың бір түнді» бастады?
Dialogue: 0,0:05:50.18,0:05:51.83,JP,,0,0,0,,Бұл жұмыс түрі ме?
Dialogue: 0,0:05:51.83,0:05:52.67,JP,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:05:52.67,0:05:55.42,JP,,0,0,0,,Күріш шарын алғаныңыз үшін алғыс ретінде.
Dialogue: 0,0:05:55.42,0:05:56.79,JP,,0,0,0,,Мүлдем жоқ
Dialogue: 0,0:05:58.19,0:06:00.73,JP,,0,0,0,,Менде Цузуру жоқ, сондықтан білмеймін.
Dialogue: 0,0:06:01.71,0:06:05.21,JP,,0,0,0,,Бұл сценарий Араб түндері стилінде реттелген.
Dialogue: 0,0:06:05.21,0:06:06.71,JP,,0,0,0,,Бұл басқаша болуы мүмкін.
Dialogue: 0,0:06:07.42,0:06:12.72,JP,,0,0,0,,Бастапқы оқиға бойынша патша түнде бірге жүрген әйелді өлтірген.
Dialogue: 0,0:06:13.15,0:06:14.72,JP,,0,0,0,,Оны тоқтату үшін
Dialogue: 0,0:06:15.06,0:06:17.77,JP,,0,0,0,,Патшаға үйленіп, ертегі айтып бер.
Dialogue: 0,0:06:18.45,0:06:21.20,JP,,0,0,0,,Әр түнде оқиғаны шарықтау шегіне дейін айтыңыз.
Dialogue: 0,0:06:21.46,0:06:24.37,JP,,0,0,0,,Сізді ертең көреміз деп уәде беру арқылы жалғастырыңыз
Dialogue: 0,0:06:24.71,0:06:27.06,JP,,0,0,0,,Өзіңізді өлтіруді тоқтатыңыз
Dialogue: 0,0:06:27.22,0:06:28.92,JP,,0,0,0,,Муккун мәліметтері
Dialogue: 0,0:06:29.35,0:06:31.32,JP,,0,0,0,,Мен барлық томдарды оқыдым.
Dialogue: 0,0:06:31.32,0:06:32.38,JP,,0,0,0,,Барлық томдар?
Dialogue: 0,0:06:32.38,0:06:34.07,JP,,0,0,0,,Бұл өте ұзақ емес пе?
Dialogue: 0,0:06:34.26,0:06:35.67,JP,,0,0,0,,Кітапханадан қарыз алу
Dialogue: 0,0:06:36.54,0:06:39.37,JP,,0,0,0,,Ересектерге арналған әңгімелер де болды.
Dialogue: 0,0:06:39.61,0:06:40.76,JP,,0,0,0,,Себебі бұл қызықты болды
Dialogue: 0,0:06:40.76,0:06:42.21,JP,,0,0,0,,Мен оны аз уақытта оқып бітірдім.
Dialogue: 0,0:06:43.54,0:06:44.20,JP,,0,0,0,,Муку
Dialogue: 0,0:06:46.59,0:06:50.39,JP,,0,0,0,,Сен кереметсің, біз саған Супер Санкаку-кун береміз
Dialogue: 0,0:06:50.72,0:06:52.26,JP,,0,0,0,,Бұл не?
Dialogue: 0,0:06:52.46,0:06:53.99,JP,,0,0,0,,Сүйкімді
Dialogue: 0,0:06:54.69,0:06:56.27,JP,,0,0,0,,Иә, сүйкімді
Dialogue: 0,0:06:56.63,0:06:57.67,JP,,0,0,0,,Оны асыра алмаңыз
Dialogue: 0,0:06:58.06,0:07:01.16,JP,,0,0,0,,Бұл керемет, өйткені оның үстінде тәж бар.
Dialogue: 0,0:07:01.16,0:07:03.77,JP,,0,0,0,,Өшіргіштен жаңартылды
Dialogue: 0,0:07:04.00,0:07:05.09,JP,,0,0,0,,Рахмет
Dialogue: 0,0:07:05.09,0:07:07.64,JP,,0,0,0,,Эй, сен оны рөлге дайындалу үшін оқыдың ба?
Dialogue: 0,0:07:08.82,0:07:12.06,JP,,0,0,0,,Мен «Мың бір түн» әлемін көбірек түсінгім келеді.
Dialogue: 0,0:07:13.01,0:07:14.70,JP,,0,0,0,,Мен күш-жігерді бағалаймын.
Dialogue: 0,0:07:15.51,0:07:16.55,JP,,0,0,0,,Рахмет
Dialogue: 0,0:07:18.09,0:07:20.40,JP,,0,0,0,,Әйелдерді өлтіретін патша?
Dialogue: 0,0:07:21.08,0:07:23.56,JP,,0,0,0,,Егер солай болса, мен міндетті түрде үйленгім келмейді.
Dialogue: 0,0:07:23.86,0:07:26.35,JP,,0,0,0,,Шеразаданың сезімін түсінуге болады.
Dialogue: 0,0:07:26.70,0:07:28.34,JP,,0,0,0,,Сіз де аздап үйренуіңіз керек.
Dialogue: 0,0:07:28.69,0:07:30.16,JP,,0,0,0,,Қараңыз, міне осы ғой?
Dialogue: 0,0:07:30.84,0:07:32.36,JP,,0,0,0,,Мен оны костюмдерге анықтама ретінде пайдаланғым келеді.
Dialogue: 0,0:07:32.59,0:07:33.89,JP,,0,0,0,,Мәліметтерді кейінірек айтыңыз
Dialogue: 0,0:07:34.61,0:07:35.36,JP,,0,0,0,,Әрине
Dialogue: 0,0:07:40.23,0:07:41.85,JP,,0,0,0,,Сен бүкіл отбасыңмен бірге осыған көшіп алғаның дұрыс.
Dialogue: 0,0:07:42.06,0:07:44.20,JP,,0,0,0,,Аш Пекоринко~
Dialogue: 0,0:07:44.20,0:07:46.59,JP,,0,0,0,,Онигири Онигири
Dialogue: 0,0:07:46.59,0:07:48.33,JP,,0,0,0,,Кешкі асқа не ішеміз?
Dialogue: 0,0:07:48.77,0:07:51.61,JP,,0,0,0,,Достығымызды тереңдету үшін бәріміз бірге жасаймыз.
Dialogue: 0,0:07:52.56,0:07:54.46,JP,,0,0,0,,Оқу-жаттығу жиынында аспаз жоқ па?
Dialogue: 0,0:07:54.61,0:07:55.84,JP,,0,0,0,,Мен болсам
Dialogue: 0,0:07:55.84,0:07:56.46,JP,,0,0,0,,Таныстырулар!
Dialogue: 0,0:07:58.16,0:07:59.66,JP,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:07:59.66,0:08:03.94,JP,,0,0,0,,Өйткені бүгінгі кешкі ас мәзірі барлық адамдар жақсы көретін шынайы карри.
Dialogue: 0,0:08:03.94,0:08:04.91,JP,,0,0,0,,Матака?
Dialogue: 0,0:08:04.91,0:08:06.44,JP,,0,0,0,,Шетелдік Карридің оралуы
Dialogue: 0,0:08:06.78,0:08:10.34,JP,,0,0,0,,Сонымен... Бірақ қараңызшы, директордың карриі дәмді екен.
Dialogue: 0,0:08:10.59,0:08:13.08,JP,,0,0,0,,Еліктеу Дәмді екенін білемін.
Dialogue: 0,0:08:13.08,0:08:15.27,JP,,0,0,0,,Егер сізде күріш шарлары болса, бұл жақсы.
Dialogue: 0,0:08:15.42,0:08:19.29,JP,,0,0,0,,Бұл дәмдеуіш тікелей Үндістаннан әкелінді.
Dialogue: 0,0:08:19.29,0:08:21.01,JP,,0,0,0,,Иә, иә, мен тамақ жейтін адаммын.
Dialogue: 0,0:08:21.26,0:08:22.77,JP,,0,0,0,,Жай ғана қосқышты аударыңыз.
Dialogue: 0,0:08:23.13,0:08:25.38,JP,,0,0,0,,Көкөністерді жуу керек пе?
Dialogue: 0,0:08:25.38,0:08:26.90,JP,,0,0,0,,Рецептті Google іздеп көрейік
Dialogue: 0,0:08:26.90,0:08:29.06,JP,,0,0,0,,Мен күріш шарларына жауаптымын
Dialogue: 0,0:08:34.24,0:08:36.39,JP,,0,0,0,,Ей, сен күрішіңді жақсырақ қайрайсың.
Dialogue: 0,0:08:36.74,0:08:38.89,JP,,0,0,0,,Толық мәліметтер спектакльден тыс уақытта да
Dialogue: 0,0:08:39.14,0:08:41.28,JP,,0,0,0,,Мен жай ғана айқынды айтып отырмын.
Dialogue: 0,0:08:41.72,0:08:43.57,JP,,0,0,0,,Ал ол қандай күріш?
Dialogue: 0,0:08:43.91,0:08:46.29,JP,,0,0,0,,Мен тек пикарин күрішін жеуді шештім.
Dialogue: 0,0:08:46.63,0:08:48.01,JP,,0,0,0,,Тым өзімшіл
Dialogue: 0,0:08:48.38,0:08:50.29,JP,,0,0,0,,Сіз тым өрескелсіз
Dialogue: 0,0:08:50.80,0:08:51.93,JP,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:08:52.16,0:08:53.74,JP,,0,0,0,,Бұл күріш те дәмді.
Dialogue: 0,0:08:53.91,0:08:55.24,JP,,0,0,0,,Дайкон актері, аузыңды жап!
Dialogue: 0,0:08:56.53,0:08:57.46,JP,,0,0,0,,Шалғам…
Dialogue: 0,0:08:58.35,0:09:00.13,JP,,0,0,0,,Шалғам да дәмді.
Dialogue: 0,0:09:00.44,0:09:03.31,JP,,0,0,0,,Күріш шарын жасағанда бәрі дәмді болады.
Dialogue: 0,0:09:03.31,0:09:05.56,JP,,0,0,0,,Себебі сен оғашсың.
Dialogue: 0,0:09:08.34,0:09:10.16,JP,,0,0,0,,Бұл не деген күрсіну?
Dialogue: 0,0:09:10.98,0:09:13.19,JP,,0,0,0,,Жаныңызда болғанда атмосфера нашарлайды.
Dialogue: 0,0:09:13.19,0:09:14.46,JP,,0,0,0,,Менің кінәм бар ма?
Dialogue: 0,0:09:14.80,0:09:17.21,JP,,0,0,0,,Бірінші кезекте күрішті дұрыс қайрамағандықтан.
Dialogue: 0,0:09:17.21,0:09:18.46,JP,,0,0,0,,Басқаларды кінәламаңыз
Dialogue: 0,0:09:18.89,0:09:19.80,JP,,0,0,0,,Не?
Dialogue: 0,0:09:20.08,0:09:21.28,JP,,0,0,0,,Мұнда Тентен
Dialogue: 0,0:09:21.71,0:09:23.61,JP,,0,0,0,,Сүйкімді емес нәрсені айту
Dialogue: 0,0:09:23.61,0:09:25.43,JP,,0,0,0,,Мен достарымды жоғалтамын
Dialogue: 0,0:09:28.30,0:09:30.66,JP,,0,0,0,,Сен сияқтылардың бәріне жақсы болып көрінсем де
Dialogue: 0,0:09:30.66,0:09:33.11,JP,,0,0,0,,Мен кездейсоқ достар табуды ойламаймын.
Dialogue: 0,0:09:38.14,0:09:39.31,JP,,0,0,0,,Жақсы
Dialogue: 0,0:09:45.94,0:09:48.55,JP,,0,0,0,,Нені айтудың дұрыс, ненің бұрыс екенін білмейсің бе?
Dialogue: 0,0:09:53.65,0:09:54.50,JP,,0,0,0,,Тенма-кун
Dialogue: 0,0:09:55.79,0:09:56.72,JP,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:10:10.00,0:10:11.05,JP,,0,0,0,,О, болды.
Dialogue: 0,0:10:16.09,0:10:16.76,JP,,0,0,0,,Бұл не?
Dialogue: 0,0:10:19.54,0:10:20.01,JP,,0,0,0,,Иә
Dialogue: 0,0:10:20.51,0:10:22.05,JP,,0,0,0,,Өте дәмді болып шықты.
Dialogue: 0,0:10:22.41,0:10:23.61,JP,,0,0,0,,Керемет орындау
Dialogue: 0,0:10:23.93,0:10:25.32,JP,,0,0,0,,Барлығы тамақтанып үлгерді
Dialogue: 0,0:10:27.22,0:10:28.01,JP,,0,0,0,,Қажет емес
Dialogue: 0,0:10:32.14,0:10:34.15,JP,,0,0,0,,Бұл жерде ештеңе жоқ шығар.
Dialogue: 0,0:10:34.47,0:10:36.98,JP,,0,0,0,,Тамақ ішпесеңіз, жаттығу кезінде күшіңіз қалмайды.
Dialogue: 0,0:10:46.67,0:10:47.50,JP,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:10:48.25,0:10:49.26,JP,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:10:49.26,0:10:51.35,JP,,0,0,0,,Оны барлығы жақсы қабылдады.
Dialogue: 0,0:10:51.53,0:10:55.45,JP,,0,0,0,,Сачи-кун мені супер карри бөтен деп атайды.
Dialogue: 0,0:10:55.45,0:10:57.39,JP,,0,0,0,,Ол лақап атқа неге ризасың?
Dialogue: 0,0:10:58.22,0:11:01.15,JP,,0,0,0,,Ей, ертең бәріміз бірге тамақтанайық.
Dialogue: 0,0:11:01.50,0:11:03.31,JP,,0,0,0,,Тенма-кун көсем ретінде
Dialogue: 0,0:11:03.31,0:11:06.10,JP,,0,0,0,,Мен сіз бәріне қамқор екеніңізді айта аламын.
Dialogue: 0,0:11:06.84,0:11:10.39,JP,,0,0,0,,Сіздің арқаңызда рөл туралы түсінігім бірте-бірте тереңдей түсті.
Dialogue: 0,0:11:10.60,0:11:13.05,JP,,0,0,0,,Сіздің актерлік шеберлігіңіз жақсарып жатыр деп ойламайсыз ба?
Dialogue: 0,0:11:13.71,0:11:14.77,JP,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:11:15.66,0:11:18.55,JP,,0,0,0,,Рурикава епті болғандықтан, ол өз сөздерін жасыруға бейім.
Dialogue: 0,0:11:19.92,0:11:22.00,JP,,0,0,0,,Бірақ қозғалыста сұлулық бар
Dialogue: 0,0:11:22.69,0:11:24.32,JP,,0,0,0,,Өйткені мен өзімді қалай көрсету керектігін білемін
Dialogue: 0,0:11:24.52,0:11:25.77,JP,,0,0,0,,Сахнада гүлдену
Dialogue: 0,0:11:28.30,0:11:31.58,JP,,0,0,0,,Миёши жақсы жағынан да, жаман жағынан да орташа.
Dialogue: 0,0:11:32.29,0:11:34.06,JP,,0,0,0,,Мен адамдарға жақсы бейімделемін, бірақ
Dialogue: 0,0:11:34.06,0:11:34.96,JP,,0,0,0,,Әлсіз итеру
Dialogue: 0,0:11:35.45,0:11:38.67,JP,,0,0,0,,Бірақ ол кез келген серіктесті орналастыру үшін жеткілікті икемді.
Dialogue: 0,0:11:39.32,0:11:41.87,JP,,0,0,0,,Кусака жаман, бірақ еңбекқор.
Dialogue: 0,0:11:42.50,0:11:45.08,JP,,0,0,0,,Мен өз рөлімді ойлап, оны ойнауға тырысамын.
Dialogue: 0,0:11:45.87,0:11:47.62,JP,,0,0,0,,Сізді тым қобалжытатын нәрселерді түзетсеңіз
Dialogue: 0,0:11:47.62,0:11:49.02,JP,,0,0,0,,Түрлендіру мүмкін
Dialogue: 0,0:11:50.42,0:11:52.26,JP,,0,0,0,,Икаруганың қабілеті шынайы
Dialogue: 0,0:11:52.71,0:11:55.96,JP,,0,0,0,,Егер сіз мұны байыппен қабылдасаңыз, менімен бәсекелесе алатын актерлік шеберлікке ие боласыз.
Dialogue: 0,0:11:56.87,0:12:00.16,JP,,0,0,0,,Соған қарамастан, мен тым дірілдеп тұрғаным үшін ештеңе істей алмаймын.
Dialogue: 0,0:12:02.72,0:12:03.38,JP,,0,0,0,,Бұл не?
Dialogue: 0,0:12:04.15,0:12:08.35,JP,,0,0,0,,Мен Тенма-кунның көшбасшы болғанына қаншалықты қуанғанымды енді ғана түсіндім.
Dialogue: 0,0:12:11.41,0:12:13.72,JP,,0,0,0,,Ертең мен барлығынан дұрыстап кешірім сұраймын.
Dialogue: 0,0:12:13.94,0:12:16.73,JP,,0,0,0,,Әдеттегідей әркімнің кемшілігін көрсетіңіз.
Dialogue: 0,0:12:16.90,0:12:20.11,JP,,0,0,0,,Сол сияқты, оны істеген ісі үшін мадақтаңыз.
Dialogue: 0,0:12:20.66,0:12:22.97,JP,,0,0,0,,Өйткені ол актер ретінде менің ағам.
Dialogue: 0,0:12:23.15,0:12:24.65,JP,,0,0,0,,Бұл сіздің қолыңыздан келеді, солай ма?
Dialogue: 0,0:12:25.07,0:12:26.78,JP,,0,0,0,,Сіз кіммен сөйлесесіз?
Dialogue: 0,0:12:27.96,0:12:29.03,JP,,0,0,0,,Бір күні мен болады
Dialogue: 0,0:12:29.03,0:12:32.73,JP,,0,0,0,,Ол әлемнің түкпір-түкпірінен «Ең үздік ер адам рөлі» марапаттарын жеңіп алған адам.
Dialogue: 0,0:12:34.13,0:12:36.13,JP,,0,0,0,,Мен актерлік басшылыққа аламын.
Dialogue: 0,0:12:38.78,0:12:39.56,JP,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:12:39.74,0:12:41.28,JP,,0,0,0,,Бұл күлетін жер емес.
Dialogue: 0,0:12:41.53,0:12:42.73,JP,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:12:42.84,0:12:45.36,JP,,0,0,0,,Мен сізге сенемін, көшбасшы.
Dialogue: 0,0:12:48.47,0:12:49.77,JP,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:13:01.28,0:13:01.98,JP,,0,0,0,,Тенма-кун
Dialogue: 0,0:13:02.64,0:13:04.26,JP,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:13:06.78,0:13:08.20,JP,,0,0,0,,Қайырлы таң
Dialogue: 0,0:13:10.72,0:13:11.43,JP,,0,0,0,,Қайырлы таң
Dialogue: 0,0:13:17.80,0:13:20.58,JP,,0,0,0,,Бүгін үшбұрыш нөлдік күн.
Dialogue: 0,0:13:21.72,0:13:25.29,JP,,0,0,0,,Ауа бұлыңғыр, мен де күңгірт.
Dialogue: 0,0:13:26.29,0:13:27.60,JP,,0,0,0,,Баршаңызға қайырлы таң
Dialogue: 0,0:13:27.82,0:13:29.64,JP,,0,0,0,,Ал, денені қыздыру жаттығуларынан бастайық.
Dialogue: 0,0:13:36.26,0:13:38.13,JP,,0,0,0,,Жарайды, соз.
Dialogue: 0,0:13:38.77,0:13:39.41,JP,,0,0,0,,Эй
Dialogue: 0,0:13:40.58,0:13:41.24,JP,,0,0,0,,Не болды?
Dialogue: 0,0:13:43.03,0:13:45.43,JP,,0,0,0,,Сіз кімге қоңырау шалып жатырсыз?
Dialogue: 0,0:13:46.78,0:13:47.74,JP,,0,0,0,,Барлығы.
Dialogue: 0,0:13:49.37,0:13:53.80,JP,,0,0,0,,Кешегі күн туралы не айтайын...
Dialogue: 0,0:13:55.23,0:13:55.89,JP,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:13:57.40,0:14:00.20,JP,,0,0,0,,Сонымен... бұл дегеніміз...
Dialogue: 0,0:14:01.87,0:14:03.87,JP,,0,0,0,,Мен кеше тым көп айттым деп ойлаймын.
Dialogue: 0,0:14:09.06,0:14:09.58,JP,,0,0,0,,Бар болғаны
Dialogue: 0,0:14:11.58,0:14:12.99,JP,,0,0,0,,Тағы айтатын нәрсе бар ма?
Dialogue: 0,0:14:13.16,0:14:14.05,JP,,0,0,0,,Осымен
Dialogue: 0,0:14:14.38,0:14:15.91,JP,,0,0,0,,Тез созылу.
Dialogue: 0,0:14:18.03,0:14:20.68,JP,,0,0,0,,Неліктен кешірім сұрай алмайсың?
Dialogue: 0,0:14:21.35,0:14:24.34,JP,,0,0,0,,Тенма-кунның қолынан келгенін жасап жатқанына сенімдімін.
Dialogue: 0,0:14:25.06,0:14:27.16,JP,,1200,0,0,,Тентеннің құлағы қызарып кетті.
Dialogue: 0,0:14:26.36,0:14:27.92,JP,,0,1200,0,,Мен сендерге үшбұрыш беремін.
Dialogue: 0,0:14:26.85,0:14:27.93,JP,,0,0,0,,Қызыл түске айналмаңыз
Dialogue: 0,0:14:30.58,0:14:32.30,JP,,0,0,0,,Оазис таба алмасаң
Dialogue: 0,0:14:32.84,0:14:33.80,JP,,0,0,0,,Не болады?
Dialogue: 0,0:14:34.69,0:14:36.46,JP,,0,0,0,,Мен оны осы уақытқа дейін создым.
Dialogue: 0,0:14:36.78,0:14:38.46,JP,,0,0,0,,Мен енді ештеңе істей алмаймын
Dialogue: 0,0:14:38.99,0:14:41.15,JP,,0,0,0,,Менің патша гареміне қосылудан басқа амалым жоқ.
Dialogue: 0,0:14:42.26,0:14:45.04,JP,,0,0,0,,Енді эмоцияларыңызды аздап тежеу ​​керек.
Dialogue: 0,0:14:45.21,0:14:46.04,JP,,0,0,0,,Иә, иә
Dialogue: 0,0:14:46.70,0:14:48.52,JP,,0,0,0,,Бірақ бұл қимыл жақсы болды.
Dialogue: 0,0:14:50.53,0:14:51.67,JP,,0,0,0,,Бұл не?
Dialogue: 0,0:14:51.67,0:14:53.67,JP,,0,0,0,,Тентен мақтады.
Dialogue: 0,0:14:53.67,0:14:56.87,JP,,0,0,0,,Бұл, әрине, үлкен сезімді жеткізетін пьеса болды.
Dialogue: 0,0:14:57.14,0:14:58.87,JP,,0,0,0,,Біреуді мақтау жиіркенішті.
Dialogue: 0,0:14:59.21,0:15:00.29,JP,,0,0,0,,Менің ішім дірілдейді
Dialogue: 0,0:15:00.63,0:15:01.71,JP,,0,0,0,,Не?
Dialogue: 0,0:15:02.17,0:15:05.47,JP,,0,0,0,,Сачи-кун өзінің де бақытты екенін шын айта алса екен.
Dialogue: 0,0:15:05.47,0:15:07.72,JP,,0,0,0,,Мен ерекше бақытты емеспін.
Dialogue: 0,0:15:07.72,0:15:10.47,JP,,0,0,0,,Сачи шыншыл емес
Dialogue: 0,0:15:12.29,0:15:14.39,JP,,0,0,0,,Өсе бер, Алибаба
Dialogue: 0,0:15:14.82,0:15:17.20,JP,,0,0,0,,Ешқандай елес жұмақ жоқ.
Dialogue: 0,0:15:17.64,0:15:20.90,JP,,0,0,0,,Бір айналымда миллионер бола алмайсың.
Dialogue: 0,0:15:21.42,0:15:22.83,JP,,0,0,0,,Байыпты жұмыс жасаңыз
Dialogue: 0,0:15:23.29,0:15:25.47,JP,,0,0,0,,Сол ойды нақтырақ жеткізген дұрыс.
Dialogue: 0,0:15:26.06,0:15:26.66,JP,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:27.05,0:15:29.41,JP,,0,0,0,,Бірақ оны білдіру тәсілі жақсы.
Dialogue: 0,0:15:32.06,0:15:32.78,JP,,0,0,0,,Рахмет
Dialogue: 0,0:15:35.20,0:15:37.17,JP,,0,0,0,,Қазіргі сезіммен интонацияңызды ұмытпаңыз.
Dialogue: 0,0:15:37.37,0:15:40.44,JP,,0,0,0,,Сондай-ақ ым-ишараны қолдану өз сезімдеріңізді көбірек көрсетуге көмектеседі.
Dialogue: 0,0:15:41.26,0:15:42.03,JP,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:15:43.05,0:15:46.20,JP,,0,0,0,,Барлығы, түскі ас дайын.
Dialogue: 0,0:15:47.12,0:15:49.88,JP,,0,0,0,,Мен ешқашан менеджердің тағамын жеген емеспін.
Dialogue: 0,0:15:50.23,0:15:52.13,JP,,0,0,0,,Мен бұл карри емес деп үміттенемін
Dialogue: 0,0:15:52.27,0:15:53.30,JP,,0,0,0,,Бұл тест
Dialogue: 0,0:15:53.50,0:15:54.72,JP,,0,0,0,,Онигири
Dialogue: 0,0:15:54.72,0:15:56.40,JP,,0,0,0,,Sumie тұрақты
Dialogue: 0,0:15:57.85,0:15:59.22,JP,,0,0,0,,Күтпеген жерден...
Dialogue: 0,0:15:59.73,0:16:00.94,JP,,0,0,0,,Карри удон
Dialogue: 0,0:16:01.49,0:16:03.65,JP,,0,0,0,,Тіпті кешегі карриді қайта пайдалану
Dialogue: 0,0:16:03.65,0:16:04.95,JP,,0,0,0,,Дәміне кепілдік беріледі
Dialogue: 0,0:16:05.21,0:16:07.73,JP,,0,0,0,,Жарайды... жарайды деп ойлаймын.
Dialogue: 0,0:16:08.07,0:16:11.15,JP,,0,0,0,,Күріш шарлары жоқ, үмітсіздік
Dialogue: 0,0:16:11.15,0:16:13.36,JP,,0,0,0,,Суми картоп үшбұрышы
Dialogue: 0,0:16:14.02,0:16:16.94,JP,,0,0,0,,Бұл шын үшбұрыш үшбұрышы
Dialogue: 0,0:16:19.58,0:16:20.14,JP,,0,0,0,,Эй
Dialogue: 0,0:16:21.19,0:16:24.61,JP,,0,0,0,,Мен осыдан кейін барлығын карри хош иістендіріп алуды жоспарламаймын.
Dialogue: 0,0:16:24.73,0:16:26.66,JP,,0,0,0,,Бұл кейінірек көңіл көтеру үшін.
Dialogue: 0,0:16:27.06,0:16:28.97,JP,,0,0,0,,Мен тіпті бір миллиметрді күте алмаймын.
Dialogue: 0,0:16:30.36,0:16:31.51,JP,,0,0,0,,Одан да көп, Юки-кун
Dialogue: 0,0:16:31.76,0:16:34.48,JP,,0,0,0,,Таңертеңгілік жаттығу: Сіз айтарлықтай жақсардыңыз.
Dialogue: 0,0:16:36.14,0:16:39.28,JP,,0,0,0,,Сенің әлгі намысқой жүзің шынымен тітіркендіреді.
Dialogue: 0,0:16:39.73,0:16:42.76,JP,,0,0,0,,Понкотсу көшбасшысына не енгізілгенін білмеймін.
Dialogue: 0,0:16:46.03,0:16:47.26,JP,,0,0,0,,Бұл көңілсіз
Dialogue: 0,0:16:47.51,0:16:49.76,JP,,0,0,0,,Әлгі жігіттің сөзі дұрыс, солай ма?
Dialogue: 0,0:16:50.19,0:16:51.61,JP,,0,0,0,,Актерлік өнерге қатысты...
Dialogue: 0,0:16:53.24,0:16:54.45,JP,,0,0,0,,Ештеңе
Dialogue: 0,0:16:58.61,0:17:00.25,JP,,0,0,0,,Мен де бүгін шаршадым.
Dialogue: 0,0:17:01.50,0:17:03.42,JP,,0,0,0,,Баршаңызға еңбектеріңіз үшін рахмет.
Dialogue: 0,0:17:03.71,0:17:06.09,JP,,0,0,0,,Мен бүгін сендерге тапсырма дайындап қойдым.
Dialogue: 0,0:17:06.28,0:17:07.58,JP,,0,0,0,,Іс-әрекеттер?
Dialogue: 0,0:17:08.97,0:17:10.74,JP,,0,0,0,,Жаз - отшашуды білдіреді
Dialogue: 0,0:17:11.39,0:17:13.76,JP,,0,0,0,,Жаттығу жиынында есте сақтаудың да маңызы зор.
Dialogue: 0,0:17:14.13,0:17:16.09,JP,,0,0,0,,Бұл, әрине, жақсы.
Dialogue: 0,0:17:16.63,0:17:18.44,JP,,0,0,0,,Бұл отшашулар ма?
Dialogue: 0,0:17:24.40,0:17:26.22,JP,,0,0,0,,Зымырандық отшашу
Dialogue: 0,0:17:26.22,0:17:27.14,JP,,0,0,0,,Бұл не?
Dialogue: 0,0:17:27.40,0:17:30.18,JP,,0,0,0,,Тенма-кун, сіз зымырандық отшашуларды қолданып көрмедіңіз бе?
Dialogue: 0,0:17:30.44,0:17:33.67,JP,,0,0,0,,Мен драманы түсіру кезінде от шашатын шамдарды қолдандым.
Dialogue: 0,0:17:35.14,0:17:37.54,JP,,0,0,0,,Әп-сәтте көз алдыма Риа Мицуэ бейнесі түсті.
Dialogue: 0,0:17:37.54,0:17:40.75,JP,,0,0,0,,Сыныптасын ойнаған актрисамен юката костюмін кию
Dialogue: 0,0:17:40.75,0:17:42.56,JP,,0,0,0,,Толық айтудың қажеті жоқ
Dialogue: 0,0:17:43.80,0:17:46.09,JP,,0,0,0,,Қыздар мангасындағы көрініске ұқсайды
Dialogue: 0,0:17:46.34,0:17:48.01,JP,,0,0,0,,Мен саған тәнтімін
Dialogue: 0,0:17:48.79,0:17:49.88,JP,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:50.18,0:17:54.00,JP,,0,0,0,,Ұшқындар шашыраңқы және онша қызықты емес.
Dialogue: 0,0:17:54.46,0:17:56.80,JP,,0,0,0,,Тентен зымыран отшашуы
Dialogue: 0,0:17:56.98,0:17:59.94,JP,,0,0,0,,Ол жарылыспен жарылады.
Dialogue: 0,0:17:59.94,0:18:00.69,JP,,0,0,0,,Не?
Dialogue: 0,0:18:01.05,0:18:02.04,JP,,0,0,0,,Оған не болды?
Dialogue: 0,0:18:02.04,0:18:04.33,JP,,0,0,0,,Сосын ішінен петардалар атылды.
Dialogue: 0,0:18:04.33,0:18:06.16,JP,,0,0,0,,Менің басыма жаңбыр жауып тұр
Dialogue: 0,0:18:06.16,0:18:08.30,JP,,0,0,0,,Бұл өте қауіпті емес пе?
Dialogue: 0,0:18:08.30,0:18:11.24,JP,,0,0,0,,Петарда дабылы Петарда дабылы
Dialogue: 0,0:18:11.63,0:18:13.22,JP,,0,0,0,,Эй... Сәлем, балалар.
Dialogue: 0,0:18:13.96,0:18:15.82,JP,,0,0,0,,Олай болса, жарықтандырайық.
Dialogue: 0,0:18:16.33,0:18:17.65,JP,,0,0,0,,Ал... күте тұрыңыз
Dialogue: 0,0:18:17.82,0:18:21.24,JP,,1200,0,0,,3 2 1
Dialogue: 0,0:18:19.68,0:18:21.48,JP,,0,0,0,,Әлі дулығаға дайын емес
Dialogue: 0,0:18:22.60,0:18:23.50,JP,,0,0,0,,Тенма-кун...
Dialogue: 0,0:18:35.85,0:18:39.24,JP,,0,0,0,,Кешіріңіз, мен жарылыс туралы қалжыңдадым.
Dialogue: 0,0:18:39.63,0:18:41.10,JP,,0,0,0,,Сенесіз бе?
Dialogue: 0,0:18:43.58,0:18:44.83,JP,,0,0,0,,Балалар
Dialogue: 0,0:18:45.12,0:18:46.35,JP,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:18:52.85,0:18:54.14,JP,,0,0,0,,Бұл қызық
Dialogue: 0,0:18:57.81,0:18:58.97,JP,,0,0,0,,Көбірек жасаңыз
Dialogue: 0,0:19:00.59,0:19:01.32,JP,,0,0,0,,Миёши
Dialogue: 0,0:19:04.05,0:19:06.25,JP,,0,0,0,,Кеше болған оқиға жаман болды.
Dialogue: 0,0:19:09.64,0:19:10.64,JP,,0,0,0,,Соңында?
Dialogue: 0,0:19:11.93,0:19:13.74,JP,,0,0,0,,Сондықтан Тенма-сама
Dialogue: 0,0:19:15.13,0:19:17.81,JP,,0,0,0,,Тентен Маған бәрібір.
Dialogue: 0,0:19:18.11,0:19:20.32,JP,,0,0,0,,Ал бұрынғы Айко.
Dialogue: 0,0:19:21.47,0:19:23.76,JP,,0,0,0,,Эй, сен не айтып тұрсың?
Dialogue: 0,0:19:24.24,0:19:27.23,JP,,0,0,0,,Олай болса, татуласуымызды еске алу үшін.
Dialogue: 0,0:19:30.63,0:19:32.87,JP,,0,0,0,,Тамая
Dialogue: 0,0:19:34.11,0:19:35.06,JP,,0,0,0,,Мүлдем
Dialogue: 0,0:19:35.25,0:19:36.92,JP,,0,0,0,,Олар қарапайым отшашулар емес пе?
Dialogue: 0,0:19:37.38,0:19:38.66,JP,,0,0,0,,Бұл анық
Dialogue: 0,0:19:39.07,0:19:41.58,JP,,0,0,0,,Кәне, осылай істей берейік.
Dialogue: 0,0:19:51.14,0:19:53.17,JP,,0,0,0,,Әдемі үшбұрыш
Dialogue: 0,0:19:53.57,0:19:54.90,JP,,0,0,0,,Данышпан Суми
Dialogue: 0,0:19:55.20,0:19:56.65,JP,,0,0,0,,Мен инста деңгейімді көтере аламын ба?
Dialogue: 0,0:20:01.57,0:20:04.35,JP,,0,0,0,,Бұл мектептегі саяхат сияқты.
Dialogue: 0,0:20:04.59,0:20:06.80,JP,,0,0,0,,О, солай болуы мүмкін.
Dialogue: 0,0:20:07.01,0:20:08.43,JP,,0,0,0,,Мен ол жерде ешқашан болған емеспін.
Dialogue: 0,0:20:09.05,0:20:09.86,JP,,0,0,0,,Солай ма?
Dialogue: 0,0:20:10.08,0:20:12.06,JP,,0,0,0,,Мен өзімнің ойын-сауық әрекеттеріммен айналысамын.
Dialogue: 0,0:20:12.06,0:20:14.47,JP,,0,0,0,,Мектептегі барлық іс-шаралар тоқтатылды.
Dialogue: 0,0:20:16.14,0:20:17.48,JP,,0,0,0,,Танымал сатушы күткендей
Dialogue: 0,0:20:17.96,0:20:19.47,JP,,0,0,0,,Мен өзімді аздап жалғыз сезінемін.
Dialogue: 0,0:20:19.69,0:20:21.73,JP,,0,0,0,,Мен де ол жерде ешқашан болған емеспін.
Dialogue: 0,0:20:21.89,0:20:25.20,JP,,0,0,0,,Іссапар шығындары болған жоқ.
Dialogue: 0,0:20:25.69,0:20:29.19,JP,,0,0,0,,Үшбұрыш жатақханада біраздан бері тұрып жатқан сияқты.
Dialogue: 0,0:20:29.47,0:20:30.55,JP,,0,0,0,,Үйге барасыз ба?
Dialogue: 0,0:20:31.21,0:20:33.01,JP,,0,0,0,,Жоқ, мүлде емес
Dialogue: 0,0:20:34.76,0:20:37.71,JP,,0,0,0,,Жарайды, өйткені Тэнтен мен Суми бара алмады.
Dialogue: 0,0:20:37.83,0:20:39.38,JP,,0,0,0,,Көп естеліктер жасайық
Dialogue: 0,0:20:39.38,0:20:40.21,JP,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:20:40.37,0:20:42.04,JP,,0,0,0,,Біз бәрібір доспыз.
Dialogue: 0,0:20:42.26,0:20:44.46,JP,,0,0,0,,Бұл мектеп саяхаты сияқты шығар.
Dialogue: 0,0:20:44.85,0:20:47.64,JP,,0,0,0,,Казу Тенма достары
Dialogue: 0,0:20:49.23,0:20:50.22,JP,,0,0,0,,Мен емес
Dialogue: 0,0:20:50.81,0:20:54.31,JP,,0,0,0,,Бір театр ұжымында болғандықтан, біз әлі де доспыз.
Dialogue: 0,0:20:56.28,0:20:58.20,JP,,0,0,0,,Сүйіспеншіліктің белгісі ретінде бір оқ
Dialogue: 0,0:20:58.75,0:20:59.82,JP,,0,0,0,,Тышқанның отшашуы
Dialogue: 0,0:21:00.23,0:21:01.38,JP,,0,0,0,,Бұл не?
Dialogue: 0,0:21:01.83,0:21:04.24,JP,,0,0,0,,Аяқ астынан ұшқындар сықырлап
Dialogue: 0,0:21:04.24,0:21:06.64,JP,,0,0,0,,Барлық бағыттағы отшашулар
Dialogue: 0,0:21:07.56,0:21:09.46,JP,,0,0,0,,Сіз тағы да асыра сілтеп отырсыз.
Dialogue: 0,0:21:09.73,0:21:11.36,JP,,0,0,0,,Бұл жолы ерекше
Dialogue: 0,0:21:11.59,0:21:12.88,JP,,0,0,0,,10 ұпай
Dialogue: 0,0:21:13.53,0:21:14.84,JP,,0,0,0,,Ой, эвакуация
Dialogue: 0,0:21:15.03,0:21:18.48,JP,,1200,0,0,,3 2 1
Dialogue: 0,0:21:16.14,0:21:18.39,JP,,0,400,0,,Мен енді алданбаймын
Dialogue: 0,0:21:18.60,0:21:19.88,JP,,0,0,0,,Міне.
Dialogue: 0,0:21:27.15,0:21:28.80,JP,,0,0,0,,Сондықтан мен айттым
Dialogue: 0,0:21:31.68,0:21:33.80,JP,,0,0,0,,Бұл қауіпті. Бұл не?
Dialogue: 0,0:21:36.65,0:21:37.75,JP,,0,0,0,,Жоқ
Dialogue: 0,0:21:37.75,0:21:38.74,JP,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,0:21:38.91,0:21:39.91,JP,,0,0,0,,Бұл мүмкін емес деп айтпаңыз
Dialogue: 0,0:21:39.91,0:21:42.08,JP,,0,0,0,,Қарашы, Тентен, мен сонда бардым.
Dialogue: 0,0:23:41.35,0:23:42.97,JP,,0,0,0,,Үшбұрыш…
Dialogue: 1,0:00:17.53,0:00:18.62,CN,,0,0,0,,Коен
Dialogue: 1,0:00:19.08,0:00:21.13,CN,,0,0,0,,Мамасао
Dialogue: 1,0:00:21.23,0:00:22.10,CN,,0,0,0,,Фукиюки тәжірибесі
Dialogue: 1,0:00:22.10,0:00:23.79,CN,,0,0,0,,Үй иесі туралы естеліктер
Dialogue: 1,0:00:27.02,0:00:29.88,CN,,0,0,0,,Жақсы көрініс – үшбұрыш
Dialogue: 1,0:00:29.88,0:00:31.88,CN,,0,0,0,,Тыңдалмаған
Dialogue: 1,0:00:31.88,0:00:33.54,CN,,0,0,0,,Нагатоға кіру
Dialogue: 1,0:00:33.88,0:00:37.67,CN,,0,0,0,,Қонақ үйден шыққан кезде
Dialogue: 1,0:00:37.67,0:00:39.67,CN,,0,0,0,,бейқамдық
Dialogue: 1,0:00:40.15,0:00:42.35,CN,,0,0,0,,Бейбітшілік пен татулық кезіндегі наразылық
Dialogue: 1,0:00:42.48,0:00:44.02,CN,,0,0,0,,Гаяичи оянып кетіп қалады
Dialogue: 1,0:00:45.07,0:00:47.53,CN,,0,0,0,,Жазда жаттығуға болады.
Dialogue: 1,0:00:47.72,0:00:49.32,CN,,0,0,0,,Наганың жазғы топқа қосылуы
Dialogue: 1,0:00:49.32,0:00:51.95,CN,,0,0,0,,Масуми көктемі сериясы қажет пе?
Dialogue: 1,0:00:52.27,0:00:54.90,CN,,0,0,0,,Бірақ бұл әлі де мүмкін бе?
Dialogue: 1,0:00:54.90,0:00:56.38,CN,,0,0,0,,Рисут
Dialogue: 1,0:00:56.48,0:00:58.87,CN,,0,0,0,,Әрине мен шабуылшымын.
Dialogue: 1,0:00:58.87,0:01:01.09,CN,,0,0,0,,Рухани күштің декларациясы
Dialogue: 1,0:01:01.09,0:01:02.37,CN,,0,0,0,,Гая Канаме соққысы
Dialogue: 1,0:01:05.13,0:01:07.05,CN,,0,0,0,,...
Dialogue: 1,0:01:07.05,0:01:08.19,CN,,0,0,0,,Хоккайдо
Dialogue: 1,0:01:08.19,0:01:10.71,CN,,0,0,0,,Мен сені басқа жерге апарамын.
Dialogue: 1,0:01:11.24,0:01:13.36,CN,,0,0,0,,Үй иесі
Dialogue: 1,0:01:14.68,0:01:15.60,CN,,0,0,0,,Тенма Язе
Dialogue: 1,0:01:16.50,0:01:17.79,CN,,0,0,0,,Құттықтаймыз!
Dialogue: 1,0:01:19.60,0:01:20.06,CN,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 1,0:03:02.69,0:03:04.41,CN,,0,0,0,,Жақсы келу орны
Dialogue: 1,0:03:04.71,0:03:06.18,CN,,0,0,0,,Қожайын қиналып отыр
Dialogue: 1,0:03:10.65,0:03:12.18,CN,,0,0,0,,Бұл оқу-жаттығу жиынының орналасқан жері.
Dialogue: 1,0:03:12.63,0:03:14.37,CN,,0,0,0,,Дорё Аранами
Dialogue: 1,0:03:14.37,0:03:17.37,CN,,0,0,0,,Әлеуметтік оқу-жаттығу лагерін еске түсіру
Dialogue: 1,0:03:17.56,0:03:19.56,CN,,0,0,0,,Үшбұрышты қорап
Dialogue: 1,0:03:19.83,0:03:23.10,CN,,0,0,0,,Inste
Dialogue: 1,0:03:23.74,0:03:25.73,CN,,0,0,0,,Кішкентай Юки
Dialogue: 1,0:03:25.73,0:03:27.03,CN,,0,0,0,,Тыйым салу
Dialogue: 1,0:03:27.93,0:03:29.15,CN,,0,0,0,,...
Dialogue: 1,0:03:29.40,0:03:30.18,CN,,0,0,0,,Ләззат алудың барысы
Dialogue: 1,0:03:30.95,0:03:32.40,CN,,0,0,0,,Жақсы дәм
Dialogue: 1,0:03:34.62,0:03:37.12,CN,,0,0,0,,Бұл адам қайда?
Dialogue: 1,0:03:37.88,0:03:39.33,CN,,0,0,0,,Сачи Хаджиме
Dialogue: 1,0:03:48.39,0:03:49.86,CN,,0,0,0,,Ашу
Dialogue: 1,0:03:50.71,0:03:53.19,CN,,0,0,0,,Арман саябағы міндетті түрде сонда
Dialogue: 1,0:03:53.61,0:03:55.84,CN,,0,0,0,,Натоя да әңгіме кітабының бөлігі
Dialogue: 1,0:03:56.20,0:03:57.91,CN,,0,0,0,,Бұрын бір ғана ұлт болған...
Dialogue: 1,0:03:57.91,0:03:58.91,CN,,0,0,0,,Ашылу уақыты
Dialogue: 1,0:03:58.91,0:03:59.63,CN,,0,0,0,,Үш тармақ
Dialogue: 1,0:04:00.21,0:04:02.78,CN,,0,0,0,,Ала Дин Сиқырлы Жарық Сиқыршысы
Dialogue: 1,0:04:03.10,0:04:03.83,CN,,0,0,0,,Мен кеттім
Dialogue: 1,0:04:05.51,0:04:07.38,CN,,0,0,0,,Қорқақ нүкте Alibaba
Dialogue: 1,0:04:08.23,0:04:09.38,CN,,0,0,0,,Бақытты және талантты...
Dialogue: 1,0:04:09.38,0:04:09.87,CN,,0,0,0,,Әрине, мен ашуланамын — мен сонша…
Dialogue: 1,0:04:10.82,0:04:13.27,CN,,0,0,0,,Бұл аймақта әртүрлі көктегі әсерлер бар.
Dialogue: 1,0:04:16.66,0:04:20.24,CN,,0,0,0,,Бұл патша келгеннен кейінгі алғашқы ғибадатхана.
Dialogue: 1,0:04:20.59,0:04:21.44,CN,,0,0,0,,Ауырды! Өте қатты ауырды! Тоқта, тоқта! Қол тигізбе!
Dialogue: 1,0:04:22.01,0:04:24.25,CN,,0,0,0,,Тарихтағы ең соңғы оқиға
Dialogue: 1,0:04:24.25,0:04:26.19,CN,,0,0,0,,Алайда, әртістер келгенде эмоционалды қойылым аяқталды.
Dialogue: 1,0:04:26.81,0:04:27.68,CN,,0,0,0,,қолайлы
Dialogue: 1,0:04:30.62,0:04:32.71,CN,,0,0,0,,Alibaba абай болу керек
Dialogue: 1,0:04:33.19,0:04:36.47,CN,,0,0,0,,Бұрын шыншыл болған басқа адамдар туралы айту
Dialogue: 1,0:04:36.47,0:04:38.34,CN,,0,0,0,,Бұл өлімге әкелетін кемшілік
Dialogue: 1,0:04:38.54,0:04:41.43,CN,,0,0,0,,Барлығын қамтитын эмоциялар
Dialogue: 1,0:04:41.79,0:04:43.16,CN,,0,0,0,,Бөлек рухани орындау
Dialogue: 1,0:04:44.20,0:04:45.40,CN,,0,0,0,,Гачидо
Dialogue: 1,0:04:47.57,0:04:49.14,CN,,0,0,0,,Мен енемді жақсы көремін
Dialogue: 1,0:04:49.47,0:04:51.73,CN,,0,0,0,,Мен не айттым?
Dialogue: 1,0:04:51.85,0:04:53.72,CN,,0,0,0,,1 жоғары табыстылық нүктесі
Dialogue: 1,0:04:54.38,0:04:55.16,CN,,0,0,0,,Сіз бе?
Dialogue: 1,0:04:55.73,0:04:57.09,CN,,0,0,0,,Болашақ әйелі мен баласы
Dialogue: 1,0:04:57.39,0:04:59.93,CN,,0,0,0,,Басқалар талап ететін арнайы қондырғыларға немесе толықтыруларға арналған техникалық шарттар
Dialogue: 1,0:05:01.19,0:05:02.45,CN,,0,0,0,,Түпнұсқа осылай
Dialogue: 1,0:05:02.69,0:05:03.60,CN,,0,0,0,,OK OK
Dialogue: 1,0:05:04.50,0:05:06.58,CN,,0,0,0,,Alibaba жетілген нүктесі
Dialogue: 1,0:05:07.50,0:05:08.42,CN,,0,0,0,,Арман мектебі...
Dialogue: 1,0:05:08.42,0:05:09.04,CN,,0,0,0,,Бақ
Dialogue: 1,0:05:09.63,0:05:10.43,CN,,0,0,0,,Кешір мені.
Dialogue: 1,0:05:11.65,0:05:14.99,CN,,0,0,0,,Жетілу... Жетілу нүктесі Alibaba
Dialogue: 1,0:05:15.57,0:05:18.28,CN,,0,0,0,,Армандағы қиял-ғажайып бақтың іргелі жоқтығы
Dialogue: 1,0:05:18.94,0:05:20.95,CN,,0,0,0,,Na - арман елес саябағы
Dialogue: 1,0:05:21.10,0:05:24.17,CN,,0,0,0,,Себеп - арман, демек, мүмкін емес болмыс
Dialogue: 1,0:05:24.33,0:05:26.16,CN,,0,0,0,,Мәселенің анық екенін растаңыз.
Dialogue: 1,0:05:27.18,0:05:27.95,CN,,0,0,0,,Менің алдын ала сезімім айқын көрсетті, мен жеңетінімді
Dialogue: 1,0:05:31.77,0:05:34.24,CN,,0,0,0,,Наката үшбұрышты
Dialogue: 1,0:05:35.08,0:05:36.58,CN,,0,0,0,,Қазіргі уақытта мүмкін қазір алынып тасталды
Dialogue: 1,0:05:36.58,0:05:37.95,CN,,0,0,0,,Дисплейде шоғырланған ақыл
Dialogue: 1,0:05:37.95,0:05:40.20,CN,,0,0,0,,Кота үшбұрышы
Dialogue: 1,0:05:40.70,0:05:42.59,CN,,0,0,0,,Мен қысқа үзіліс жасаймын.
Dialogue: 1,0:05:44.87,0:05:49.82,CN,,0,0,0,,Әңгімелесу: 1 000 000 және 1 000 иен түнде тау келген кезде келді?
Dialogue: 1,0:05:50.18,0:05:51.83,CN,,0,0,0,,Бұл осыған байланысты ма?
Dialogue: 1,0:05:51.83,0:05:52.67,CN,,0,0,0,,...
Dialogue: 1,0:05:52.67,0:05:55.42,CN,,0,0,0,,Бұл тамақтың жауабы.
Dialogue: 1,0:05:55.42,0:05:56.79,CN,,0,0,0,,Абсолютті конформист емес
Dialogue: 1,0:05:58.19,0:06:00.73,CN,,0,0,0,,Ичироның болмауы
Dialogue: 1,0:06:01.71,0:06:05.21,CN,,0,0,0,,Бұл аспандағы түнгі аспанның түзетілген нұсқасы
Dialogue: 1,0:06:05.21,0:06:06.71,CN,,0,0,0,,Анықталмаған сөздер, әртүрлі төл туындылар
Dialogue: 1,0:06:07.42,0:06:12.72,CN,,0,0,0,,Бастапқы оқиғада: Патшаның кездесуі, аспанның әр түні және түннің басқа әйелдері.
Dialogue: 1,0:06:13.15,0:06:14.72,CN,,0,0,0,,Тыйым салуды тоқтатқан патша
Dialogue: 1,0:06:15.06,0:06:17.77,CN,,0,0,0,,Корольдің әйелінің әңгімесі және басқа да әңгімелер
Dialogue: 1,0:06:18.45,0:06:21.20,CN,,0,0,0,,Тарихи қалаға су толқыны жеткенше әр түнде
Dialogue: 1,0:06:21.46,0:06:24.37,CN,,0,0,0,,Одан кейін екінші түндегі мәліметтер жақсы.
Dialogue: 1,0:06:24.71,0:06:27.06,CN,,0,0,0,,Эмбаргодан шеттетілгендіктен өзін-өзі өлтіру
Dialogue: 1,0:06:27.22,0:06:28.92,CN,,0,0,0,,Огура
Dialogue: 1,0:06:29.35,0:06:31.32,CN,,0,0,0,,Себебі мен оқуымды аяқтадым
Dialogue: 1,0:06:31.32,0:06:32.38,CN,,0,0,0,,Орындалды ма?
Dialogue: 1,0:06:32.38,0:06:34.07,CN,,0,0,0,,Бұл өте ұзақ па?
Dialogue: 1,0:06:34.26,0:06:35.67,CN,,0,0,0,,Кітапты жалға алу
Dialogue: 1,0:06:36.54,0:06:39.37,CN,,0,0,0,,Ересектерге арналған тривиальды әңгіме
Dialogue: 1,0:06:39.61,0:06:40.76,CN,,0,0,0,,Дегенмен, бұл шындық.
Dialogue: 1,0:06:40.76,0:06:42.21,CN,,0,0,0,,Аяқталған күтім
Dialogue: 1,0:06:43.54,0:06:44.20,CN,,0,0,0,,Муку
Dialogue: 1,0:06:46.59,0:06:50.39,CN,,0,0,0,,Сіз ең жоғары стандарттарға қол жеткізе алмайсыз.
Dialogue: 1,0:06:50.72,0:06:52.26,CN,,0,0,0,,Мұндайды есту өте сирек
Dialogue: 1,0:06:52.46,0:06:53.99,CN,,0,0,0,,Сәттілік
Dialogue: 1,0:06:54.69,0:06:56.27,CN,,0,0,0,,...
Dialogue: 1,0:06:56.63,0:06:57.67,CN,,0,0,0,,Бөлек күшті
Dialogue: 1,0:06:58.06,0:07:01.16,CN,,0,0,0,,Тәж тәжі
Dialogue: 1,0:07:01.16,0:07:03.77,CN,,0,0,0,,...
Dialogue: 1,0:07:04.00,0:07:05.09,CN,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 1,0:07:05.09,0:07:07.64,CN,,0,0,0,,...
Dialogue: 1,0:07:08.82,0:07:12.06,CN,,0,0,0,,Ойларым өзгеріп, дүниені 1000 түн түсіндім.
Dialogue: 1,0:07:13.01,0:07:14.70,CN,,0,0,0,,Еңбегіңізге рахмет.
Dialogue: 1,0:07:15.51,0:07:16.55,CN,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 1,0:07:18.09,0:07:20.40,CN,,0,0,0,,Өлім ханшайымы
Dialogue: 1,0:07:21.08,0:07:23.56,CN,,0,0,0,,Мен басқа адамға некеде емеспін.
Dialogue: 1,0:07:23.86,0:07:26.35,CN,,0,0,0,,Таудың, таудың сезімін түсінесің.
Dialogue: 1,0:07:26.70,0:07:28.34,CN,,0,0,0,,Біраз оқу
Dialogue: 1,0:07:28.69,0:07:30.16,CN,,0,0,0,,Сізге ұнайды
Dialogue: 1,0:07:30.84,0:07:32.36,CN,,0,0,0,,Жұмысыма киім жасауға арналған сілтемелер
Dialogue: 1,0:07:32.59,0:07:33.89,CN,,0,0,0,,Менің жазбамның мазмұны
Dialogue: 1,0:07:34.61,0:07:35.36,CN,,0,0,0,,Әрине мүмкін
Dialogue: 1,0:07:40.23,0:07:41.85,CN,,0,0,0,,Үй иесі ащы
Dialogue: 1,0:07:42.06,0:07:44.20,CN,,0,0,0,,...
Dialogue: 1,0:07:44.20,0:07:46.59,CN,,0,0,0,,Кешкі ас Түскі ас
Dialogue: 1,0:07:46.59,0:07:48.33,CN,,0,0,0,,Бүгін кешке тамақтанғыңыз келе ме?
Dialogue: 1,0:07:48.77,0:07:51.61,CN,,0,0,0,,...
Dialogue: 1,0:07:52.56,0:07:54.46,CN,,0,0,0,,Оқу-жаттығу лагерінің орны жоқ
Dialogue: 1,0:07:54.61,0:07:55.84,CN,,0,0,0,,Еріксіз әңгіме
Dialogue: 1,0:07:55.84,0:07:56.46,CN,,0,0,0,,Интервенция
Dialogue: 1,0:07:58.16,0:07:59.66,CN,,0,0,0,,Қажетсіз күтім
Dialogue: 1,0:07:59.66,0:08:03.94,CN,,0,0,0,,Бұл түнгі кешкі ас астаналықтардың барлығы үшін тамаша тағам
Dialogue: 1,0:08:03.94,0:08:04.91,CN,,0,0,0,,Тағы да солай.
Dialogue: 1,0:08:04.91,0:08:06.44,CN,,0,0,0,,Шетелдіктерді қайта шығару
Dialogue: 1,0:08:06.78,0:08:10.34,CN,,0,0,0,,Дегенмен... Дегенмен, бұл режиссердің таңдауы.
Dialogue: 1,0:08:10.59,0:08:13.08,CN,,0,0,0,,Негізі маған ұнайды.
Dialogue: 1,0:08:13.08,0:08:15.27,CN,,0,0,0,,Тамақтану
Dialogue: 1,0:08:15.42,0:08:19.29,CN,,0,0,0,,Бұл хош иістерді тікелей Үндістаннан алуға болады.
Dialogue: 1,0:08:19.29,0:08:21.01,CN,,0,0,0,,Жақсы дәм
Dialogue: 1,0:08:21.26,0:08:22.77,CN,,0,0,0,,Электр көзін ашу үшін тек сұраныс қажет.
Dialogue: 1,0:08:23.13,0:08:25.38,CN,,0,0,0,,...
Dialogue: 1,0:08:25.38,0:08:26.90,CN,,0,0,0,,Tanikaichigenainagu
Dialogue: 1,0:08:26.90,0:08:29.06,CN,,0,0,0,,Тамақтану менің есебінен
Dialogue: 1,0:08:34.24,0:08:36.39,CN,,0,0,0,,...
Dialogue: 1,0:08:36.74,0:08:38.89,CN,,0,0,0,,Көпшілікке шығудан басқа, шаш ұзарту туралы өтініштер
Dialogue: 1,0:08:39.14,0:08:41.28,CN,,0,0,0,,Бұл жай ғана себеп
Dialogue: 1,0:08:41.72,0:08:43.57,CN,,0,0,0,,Дегенмен, күріштің сапасы
Dialogue: 1,0:08:43.91,0:08:46.29,CN,,0,0,0,,Мен жай ғана жеңіл күріш жеймін
Dialogue: 1,0:08:46.63,0:08:48.01,CN,,0,0,0,,Тайин Шурё
Dialogue: 1,0:08:48.38,0:08:50.29,CN,,0,0,0,,Бұл сіз жасайсыз.
Dialogue: 1,0:08:50.80,0:08:51.93,CN,,0,0,0,,Салқындату нүктесі
Dialogue: 1,0:08:52.16,0:08:53.74,CN,,0,0,0,,Бұл да менің сүйікті тағамым.
Dialogue: 1,0:08:53.91,0:08:55.24,CN,,0,0,0,,Сіздің аяқтарыңыз жабық.
Dialogue: 1,0:08:56.53,0:08:57.46,CN,,0,0,0,,Тыңдау…
Dialogue: 1,0:08:58.35,0:09:00.13,CN,,0,0,0,,...
Dialogue: 1,0:09:00.44,0:09:03.31,CN,,0,0,0,,Бұл тұрарлық емес.
Dialogue: 1,0:09:03.31,0:09:05.56,CN,,0,0,0,,Өйткені сен құбыжықсың
Dialogue: 1,0:09:08.34,0:09:10.16,CN,,0,0,0,,Бұл сіздің ниетіңіз.
Dialogue: 1,0:09:10.98,0:09:13.19,CN,,0,0,0,,Сізге тек сонда болу керек.
Dialogue: 1,0:09:13.19,0:09:14.46,CN,,0,0,0,,Жарақат?
Dialogue: 1,0:09:14.80,0:09:17.21,CN,,0,0,0,,Егер сізге ұнамаса, бұл туралы алаңдамаңыз.
Dialogue: 1,0:09:17.21,0:09:18.46,CN,,0,0,0,,Басқа біреудің басына тағы бір құбыжық келеді
Dialogue: 1,0:09:18.89,0:09:19.80,CN,,0,0,0,,Не дедің?
Dialogue: 1,0:09:20.08,0:09:21.28,CN,,0,0,0,,Tentenді тоқтатыңыз және тоқтатыңыз
Dialogue: 1,0:09:21.71,0:09:23.61,CN,,0,0,0,,Жағымсыз сөйлеу
Dialogue: 1,0:09:23.61,0:09:25.43,CN,,0,0,0,,Сағынған дос
Dialogue: 1,0:09:28.30,0:09:30.66,CN,,0,0,0,,Астананың кім екендігі туралы айтудың тағы бір жолы
Dialogue: 1,0:09:30.66,0:09:33.11,CN,,0,0,0,,Елордада кімді көріп тұрсың?
Dialogue: 1,0:09:38.14,0:09:39.31,CN,,0,0,0,,Э-э...
Dialogue: 1,0:09:45.94,0:09:48.55,CN,,0,0,0,,Сіз не айтарыңызды білдіңіз бе?
Dialogue: 1,0:09:53.65,0:09:54.50,CN,,0,0,0,,Тенма
Dialogue: 1,0:09:55.79,0:09:56.72,CN,,0,0,0,,Бөлек түтік және т.б.
Dialogue: 1,0:10:10.00,0:10:11.05,CN,,0,0,0,,...
Dialogue: 1,0:10:16.09,0:10:16.76,CN,,0,0,0,,Ондық
Dialogue: 1,0:10:19.54,0:10:20.01,CN,,0,0,0,,Неаполь, таңғы 11:26
Dialogue: 1,0:10:20.51,0:10:22.05,CN,,0,0,0,,Маған ұнайды
Dialogue: 1,0:10:22.41,0:10:23.61,CN,,0,0,0,,Ғажайып туындылар
Dialogue: 1,0:10:23.93,0:10:25.32,CN,,0,0,0,,Үй иесінің экскурсиясын аяқтау
Dialogue: 1,0:10:27.22,0:10:28.01,CN,,0,0,0,,Кекірмеу
Dialogue: 1,0:10:32.14,0:10:34.15,CN,,0,0,0,,Жақын немесе жақын жерде
Dialogue: 1,0:10:34.47,0:10:36.98,CN,,0,0,0,,Әңгіменің соңы
Dialogue: 1,0:10:46.67,0:10:47.50,CN,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 1,0:10:48.25,0:10:49.26,CN,,0,0,0,,артқа
Dialogue: 1,0:10:49.26,0:10:51.35,CN,,0,0,0,,Жалға берушінің аты-жөні
Dialogue: 1,0:10:51.53,0:10:55.45,CN,,0,0,0,,Бақыт – менің зарым
Dialogue: 1,0:10:55.45,0:10:57.39,CN,,0,0,0,,Мен бұл арнайы басылымға өте қуаныштымын.
Dialogue: 1,0:10:58.22,0:11:01.15,CN,,0,0,0,,Мейтенва Дайке Иккоу Коу
Dialogue: 1,0:11:01.50,0:11:03.31,CN,,0,0,0,,Өз сезіміңізді қабылдау үшін өз әдісіңізді қалай қолдануға болады
Dialogue: 1,0:11:03.31,0:11:06.10,CN,,0,0,0,,Жұмыс жетекшісі
Dialogue: 1,0:11:06.84,0:11:10.39,CN,,0,0,0,,...
Dialogue: 1,0:11:10.60,0:11:13.05,CN,,0,0,0,,Шебердің қойылымын көргіңіз келе ме?
Dialogue: 1,0:11:13.71,0:11:14.77,CN,,0,0,0,,Айырмашылықты табыңыз
Dialogue: 1,0:11:15.66,0:11:18.55,CN,,0,0,0,,Рурикаваның өзін-өзі түсінуі жапон тіліне оңай аударылады.
Dialogue: 1,0:11:19.92,0:11:22.00,CN,,0,0,0,,Дегенмен, басқа да тартымды қозғалыстар бар.
Dialogue: 1,0:11:22.69,0:11:24.32,CN,,0,0,0,,Басқа білім, сіз өз ойыңызды қалай жеткізесіз?
Dialogue: 1,0:11:24.52,0:11:25.77,CN,,0,0,0,,Сондықтан сахналық әсер жақсы.
Dialogue: 1,0:11:28.30,0:11:31.58,CN,,0,0,0,,Аяқталған Миёши Тай Зуйбун қазірдің өзінде жақсы және жаман нүкте болып табылады
Dialogue: 1,0:11:32.29,0:11:34.06,CN,,0,0,0,,Басқа адам
Dialogue: 1,0:11:34.06,0:11:34.96,CN,,0,0,0,,Алайда негізгі қозғалысқа рұқсат етілмейді.
Dialogue: 1,0:11:35.45,0:11:38.67,CN,,0,0,0,,Тағы қандай лауазымдар бар?
Dialogue: 1,0:11:39.32,0:11:41.87,CN,,0,0,0,,Кусаканың актерлік айырмашылығы, бірақ бұл оң талпыныс
Dialogue: 1,0:11:42.50,0:11:45.08,CN,,0,0,0,,Жақсы тәжірибеден кейін шоу аяқталды
Dialogue: 1,0:11:45.87,0:11:47.62,CN,,0,0,0,,Лев.
Dialogue: 1,0:11:47.62,0:11:49.02,CN,,0,0,0,,Жұмысқа орналасудағы үлкен серпіліс
Dialogue: 1,0:11:50.42,0:11:52.26,CN,,0,0,0,,Мадараның нақты орындауына күдік
Dialogue: 1,0:11:52.71,0:11:55.96,CN,,0,0,0,,Актерлік өнер туралы басқа сөздер
Dialogue: 1,0:11:56.87,0:12:00.16,CN,,0,0,0,,Одан құтылуға болады, бірақ бұл шындық.
Dialogue: 1,0:12:02.72,0:12:03.38,CN,,0,0,0,,...
Dialogue: 1,0:12:04.15,0:12:08.35,CN,,0,0,0,,Егер сіз кенеттен өзіңізді көріп, өзіңізді таңдасаңыз, сіз таңдалған адам боласыз.
Dialogue: 1,0:12:11.41,0:12:13.72,CN,,0,0,0,,Тамаша ауа-райы
Dialogue: 1,0:12:13.94,0:12:16.73,CN,,0,0,0,,Сурет әрқашан бір нүктеден кейін, басқа кемшіліктер бар.
Dialogue: 1,0:12:16.90,0:12:20.11,CN,,0,0,0,,Басқа адамдар үшін бірдей уақыт ұзақтығы
Dialogue: 1,0:12:20.66,0:12:22.97,CN,,0,0,0,,Сіз керемет орындаушы бола аласыз
Dialogue: 1,0:12:23.15,0:12:24.65,CN,,0,0,0,,Бұл нүктеге қалай жетуге болады
Dialogue: 1,0:12:25.07,0:12:26.78,CN,,0,0,0,,Сіз кімге қарайсыз?
Dialogue: 1,0:12:27.96,0:12:29.03,CN,,0,0,0,,Юичитен Гато
Dialogue: 1,0:12:29.03,0:12:32.73,CN,,0,0,0,,Дүниедегі ең сұлу адам
Dialogue: 1,0:12:34.13,0:12:36.13,CN,,0,0,0,,Нұсқаулықтың міндетін атқарушы Кона Исшо
Dialogue: 1,0:12:38.78,0:12:39.56,CN,,0,0,0,,Бұл 3
Dialogue: 1,0:12:39.74,0:12:41.28,CN,,0,0,0,,Бұл дұрыс емес.
Dialogue: 1,0:12:41.53,0:12:42.73,CN,,0,0,0,,...
Dialogue: 1,0:12:42.84,0:12:45.36,CN,,0,0,0,,...
Dialogue: 1,0:12:48.47,0:12:49.77,CN,,0,0,0,,Қай жерде өлдің?
Dialogue: 1,0:13:01.28,0:13:01.98,CN,,0,0,0,,Тенма
Dialogue: 1,0:13:02.64,0:13:04.26,CN,,0,0,0,,Хая… Хаякамиёши
Dialogue: 1,0:13:06.78,0:13:08.20,CN,,0,0,0,,Йошиёши Хаяками
Dialogue: 1,0:13:10.72,0:13:11.43,CN,,0,0,0,,Йошиёши Хаяками
Dialogue: 1,0:13:17.80,0:13:20.58,CN,,0,0,0,,Енді Теня үшбұрышты бір аспан
Dialogue: 1,0:13:21.72,0:13:25.29,CN,,0,0,0,,...
Dialogue: 1,0:13:26.29,0:13:27.60,CN,,0,0,0,,Үй иесі Хаяками
Dialogue: 1,0:13:27.82,0:13:29.64,CN,,0,0,0,,Ыстық дене жаттығуларына жақындау
Dialogue: 1,0:13:36.26,0:13:38.13,CN,,0,0,0,,Жарайды
Dialogue: 1,0:13:38.77,0:13:39.41,CN,,0,0,0,,Әрине, мен ашуланамын — мен сонша…
Dialogue: 1,0:13:40.58,0:13:41.24,CN,,0,0,0,,Менің алдын ала сезімім айқын көрсетті, мен жеңетінімді
Dialogue: 1,0:13:43.03,0:13:45.43,CN,,0,0,0,,Кімге жылап тұрсың?
Dialogue: 1,0:13:46.78,0:13:47.74,CN,,0,0,0,,Таймлайн: Yi Hua; Пост-өндіріс: Blackfeather; Арнайы эффектілер: akk; Кодтау: prpr Dog; BD түзетулер: Xizi Ganle
Dialogue: 1,0:13:49.37,0:13:53.80,CN,,0,0,0,,Өткеннің жағдайлары қандай?
Dialogue: 1,0:13:55.23,0:13:55.89,CN,,0,0,0,,Әрине, бөлек.
Dialogue: 1,0:13:57.40,0:14:00.20,CN,,0,0,0,,Себеп… сонымен қатар түсініктеме…
Dialogue: 1,0:14:01.87,0:14:03.87,CN,,0,0,0,,Мен өткенде өзімді қалай оқыту керектігін білдім.
Dialogue: 1,0:14:09.06,0:14:09.58,CN,,0,0,0,,Баяндау аяқталды
Dialogue: 1,0:14:11.58,0:14:12.99,CN,,0,0,0,,Басқа талап етілетін түсініктеме бар ма?
Dialogue: 1,0:14:13.16,0:14:14.05,CN,,0,0,0,,Баяндау аяқталды
Dialogue: 1,0:14:14.38,0:14:15.91,CN,,0,0,0,,...
Dialogue: 1,0:14:18.03,0:14:20.68,CN,,0,0,0,,Оны төлеу мүмкін емес пе?
Dialogue: 1,0:14:21.35,0:14:24.34,CN,,0,0,0,,Оң шешімді бекіту
Dialogue: 1,0:14:25.06,0:14:27.16,CN,,1200,0,0,,Тентеннің құлағы бітті
Dialogue: 1,0:14:26.36,0:14:27.92,CN,,0,1200,0,,...
Dialogue: 1,0:14:26.85,0:14:27.93,CN,,0,0,0,,Талантты жоғалту
Dialogue: 1,0:14:30.58,0:14:32.30,CN,,0,0,0,,болмауы керек
Dialogue: 1,0:14:32.84,0:14:33.80,CN,,0,0,0,,Сізбен кездесу?
Dialogue: 1,0:14:34.69,0:14:36.46,CN,,0,0,0,,Бағдарламаның соңы
Dialogue: 1,0:14:36.78,0:14:38.46,CN,,0,0,0,,Шындық - өлі заң
Dialogue: 1,0:14:38.99,0:14:41.15,CN,,0,0,0,,Патшаға қосылғаннан кейін
Dialogue: 1,0:14:42.26,0:14:45.04,CN,,0,0,0,,Нари Сенсай, аздап басылған эмоцияны салыстыру
Dialogue: 1,0:14:45.21,0:14:46.04,CN,,0,0,0,,Жақсы дәм
Dialogue: 1,0:14:46.70,0:14:48.52,CN,,0,0,0,,Дегенмен, қозғалыс күшті емес.
Dialogue: 1,0:14:50.53,0:14:51.67,CN,,0,0,0,,Әрине, бөлек.
Dialogue: 1,0:14:51.67,0:14:53.67,CN,,0,0,0,,Тентенжожинрио
Dialogue: 1,0:14:53.67,0:14:56.87,CN,,0,0,0,,Бекіту: Дарындылық пен сезімнің талантты көрінісі
Dialogue: 1,0:14:57.14,0:14:58.87,CN,,0,0,0,,Көңіл-күйі жақсы адам
Dialogue: 1,0:14:59.21,0:15:00.29,CN,,0,0,0,,Тері ісігінің пайда болуы
Dialogue: 1,0:15:00.63,0:15:01.71,CN,,0,0,0,,Не дедің?
Dialogue: 1,0:15:02.17,0:15:05.47,CN,,0,0,0,,Юкия тан бір ұпаймен бағалады, өзіне ләззат алды.
Dialogue: 1,0:15:05.47,0:15:07.72,CN,,0,0,0,,Мен бақытты болғаныма қуаныштымын
Dialogue: 1,0:15:07.72,0:15:10.47,CN,,0,0,0,,Сачи Бір Ұпай Я Ундан Рейтингі
Dialogue: 1,0:15:12.29,0:15:14.39,CN,,0,0,0,,Alibaba жетілу нүктесі
Dialogue: 1,0:15:14.82,0:15:17.20,CN,,0,0,0,,Армандағы қиял-ғажайып бақтың іргелі жоқтығы
Dialogue: 1,0:15:17.64,0:15:20.90,CN,,0,0,0,,Бір түнде бай болу мүмкін емес
Dialogue: 1,0:15:21.42,0:15:22.83,CN,,0,0,0,,Шындықты артта қалдыр
Dialogue: 1,0:15:23.29,0:15:25.47,CN,,0,0,0,,Қойылымның әсері жақсарды.
Dialogue: 1,0:15:26.06,0:15:26.66,CN,,0,0,0,,Кешір
Dialogue: 1,0:15:27.05,0:15:29.41,CN,,0,0,0,,Алайда өрнектеу тәсілі басқаша.
Dialogue: 1,0:15:32.06,0:15:32.78,CN,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 1,0:15:35.20,0:15:37.17,CN,,0,0,0,,Қажетсіз ұмытшақтықты басу
Dialogue: 1,0:15:37.37,0:15:40.44,CN,,0,0,0,,Біраз уақыттан кейін аяқ-қол қозғалысының бір нүктесін арттыру, эмоцияны білдіру қабілетін арттыру
Dialogue: 1,0:15:41.26,0:15:42.03,CN,,0,0,0,,Мен жасап көремін
Dialogue: 1,0:15:43.05,0:15:46.20,CN,,0,0,0,,Құрметті баршаңызға, Түскі асыңыз құтты болсын.
Dialogue: 1,0:15:47.12,0:15:49.88,CN,,0,0,0,,...
Dialogue: 1,0:15:50.23,0:15:52.13,CN,,0,0,0,,Алайда мұны істегіңіз келмейді.
Dialogue: 1,0:15:52.27,0:15:53.30,CN,,0,0,0,,Жиналыс бірдей.
Dialogue: 1,0:15:53.50,0:15:54.72,CN,,0,0,0,,Кешкі ас
Dialogue: 1,0:15:54.72,0:15:56.40,CN,,0,0,0,,Кіші бұрыштық жел стилі
Dialogue: 1,0:15:57.85,0:15:59.22,CN,,0,0,0,,Мүлдем...
Dialogue: 1,0:15:59.73,0:16:00.94,CN,,0,0,0,,Қыс
Dialogue: 1,0:16:01.49,0:16:03.65,CN,,0,0,0,,Мен бұрын арнайы ауыр салмақты қолдандым.
Dialogue: 1,0:16:03.65,0:16:04.95,CN,,0,0,0,,Аджидоға кепілдік беруге болады
Dialogue: 1,0:16:05.21,0:16:07.73,CN,,0,0,0,,Жақсы... Жақсы
Dialogue: 1,0:16:08.07,0:16:11.15,CN,,0,0,0,,Тамақ жетіспейді
Dialogue: 1,0:16:11.15,0:16:13.36,CN,,0,0,0,,Кіші бұрыш Дозу үшбұрыш
Dialogue: 1,0:16:14.02,0:16:16.94,CN,,0,0,0,,шынайы үшбұрыш үшбұрышы
Dialogue: 1,0:16:19.58,0:16:20.14,CN,,0,0,0,,Менің әңгімем
Dialogue: 1,0:16:21.19,0:16:24.61,CN,,0,0,0,,Астананың барлық дәмін көрмеген соң
Dialogue: 1,0:16:24.73,0:16:26.66,CN,,0,0,0,,Құрметке үміттену
Dialogue: 1,0:16:27.06,0:16:28.97,CN,,0,0,0,,Мен үлкен үміт күтемін
Dialogue: 1,0:16:30.36,0:16:31.51,CN,,0,0,0,,Юки Корё
Dialogue: 1,0:16:31.76,0:16:34.48,CN,,0,0,0,,Орындаудың арнайы эффектілері
Dialogue: 1,0:16:36.14,0:16:39.28,CN,,0,0,0,,Осы жерде кездескенше
Dialogue: 1,0:16:39.73,0:16:42.76,CN,,0,0,0,,Өкінішке орай, мен жолды білмедім.
Dialogue: 1,0:16:46.03,0:16:47.26,CN,,0,0,0,,Абсурд және түсініксіз
Dialogue: 1,0:16:47.51,0:16:49.76,CN,,0,0,0,,Тадина Иенің анықтамалық нүктесі осы нүкте болып табылады.
Dialogue: 1,0:16:50.19,0:16:51.61,CN,,0,0,0,,Гуанью ойнайды...
Dialogue: 1,0:16:53.24,0:16:54.45,CN,,0,0,0,,Ой, керемет екен.
Dialogue: 1,0:16:58.61,0:17:00.25,CN,,0,0,0,,Йошихиро Контеня
Dialogue: 1,0:17:01.50,0:17:03.42,CN,,0,0,0,,Үй иесі ащы
Dialogue: 1,0:17:03.71,0:17:06.09,CN,,0,0,0,,Енді мен әрекетке дайынмын
Dialogue: 1,0:17:06.28,0:17:07.58,CN,,0,0,0,,Белсенділік?
Dialogue: 1,0:17:08.97,0:17:10.74,CN,,0,0,0,,...
Dialogue: 1,0:17:11.39,0:17:13.76,CN,,0,0,0,,Оқу-жаттығу жиыны туралы естеліктер маңызды
Dialogue: 1,0:17:14.13,0:17:16.09,CN,,0,0,0,,Өте жақсы таяқ
Dialogue: 1,0:17:16.63,0:17:18.44,CN,,0,0,0,,Бұл ыстық гүл ме?
Dialogue: 1,0:17:24.40,0:17:26.22,CN,,0,0,0,,Жарқыраған от
Dialogue: 1,0:17:26.22,0:17:27.14,CN,,0,0,0,,Накореджия
Dialogue: 1,0:17:27.40,0:17:30.18,CN,,0,0,0,,Тенма Сіз отыңызды жоғалттыңыз ба?
Dialogue: 1,0:17:30.44,0:17:33.67,CN,,0,0,0,,Электрондық музыка көрсетілген сәт
Dialogue: 1,0:17:35.14,0:17:37.54,CN,,0,0,0,,Ағымдағы экран теңізде бір сәтте пайда болады
Dialogue: 1,0:17:37.54,0:17:40.75,CN,,0,0,0,,Юката киген жапондық дужинши әйел орындаушысы
Dialogue: 1,0:17:40.75,0:17:42.56,CN,,0,0,0,,Қажет емес мәліметтер түсіндірілді
Dialogue: 1,0:17:43.80,0:17:46.09,CN,,0,0,0,,Жақсы қыздың мангасынан көрініс
Dialogue: 1,0:17:46.34,0:17:48.01,CN,,0,0,0,,Шынайы мүміннің таңданысы
Dialogue: 1,0:17:48.79,0:17:49.88,CN,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 1,0:17:50.18,0:17:54.00,CN,,0,0,0,,Өлім ниеті
Dialogue: 1,0:17:54.46,0:17:56.80,CN,,0,0,0,,Осы отты шырақ гүлін тентен
Dialogue: 1,0:17:56.98,0:17:59.94,CN,,0,0,0,,Кайкачи Бакубакуя
Dialogue: 1,0:17:59.94,0:18:00.69,CN,,0,0,0,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 1,0:18:01.05,0:18:02.04,CN,,0,0,0,,Ауырды! Өте қатты ауырды! Тоқта, тоқта! Қол тигізбе!
Dialogue: 1,0:18:02.04,0:18:04.33,CN,,0,0,0,,Юлиден ұшатын петардалар
Dialogue: 1,0:18:04.33,0:18:06.16,CN,,0,0,0,,Жәшіктің басына келгеннен кейін
Dialogue: 1,0:18:06.16,0:18:08.30,CN,,0,0,0,,Коятаға қауіп төніп тұр
Dialogue: 1,0:18:08.30,0:18:11.24,CN,,0,0,0,,Полиция отшашу туралы есеп. Полиция отшашу туралы есеп
Dialogue: 1,0:18:11.63,0:18:13.22,CN,,0,0,0,,Жалға беруші… Жалға беруші, т.б.
Dialogue: 1,0:18:13.96,0:18:15.82,CN,,0,0,0,,Наганың тұтануы аяқталды
Dialogue: 1,0:18:16.33,0:18:17.65,CN,,0,0,0,,т.б. т.б.
Dialogue: 1,0:18:17.82,0:18:21.24,CN,,1200,0,0,,321
Dialogue: 1,0:18:19.68,0:18:21.48,CN,,0,0,0,,Мен өмірден айырылдым.
Dialogue: 1,0:18:22.60,0:18:23.50,CN,,0,0,0,,Тенма және т.б.…
Dialogue: 1,0:18:35.85,0:18:39.24,CN,,0,0,0,,Жарылысты күшейту.
Dialogue: 1,0:18:39.63,0:18:41.10,CN,,0,0,0,,Өзара қарым-қатынас
Dialogue: 1,0:18:43.58,0:18:44.83,CN,,0,0,0,,Сіз
Dialogue: 1,0:18:45.12,0:18:46.35,CN,,0,0,0,,...
Dialogue: 1,0:18:52.85,0:18:54.14,CN,,0,0,0,,Нағыз ашық жүрек
Dialogue: 1,0:18:57.81,0:18:58.97,CN,,0,0,0,,Қайта шығару
Dialogue: 1,0:19:00.59,0:19:01.32,CN,,0,0,0,,Миёши
Dialogue: 1,0:19:04.05,0:19:06.25,CN,,0,0,0,,Кеше менің туған күнім болды.
Dialogue: 1,0:19:09.64,0:19:10.64,CN,,0,0,0,,Саяхаттың соңы?
Dialogue: 1,0:19:11.93,0:19:13.74,CN,,0,0,0,,Шыны керек, аспан үлкендерге толы.
Dialogue: 1,0:19:15.13,0:19:17.81,CN,,0,0,0,,Tenten Мен түбегейлі өлдім.
Dialogue: 1,0:19:18.11,0:19:20.32,CN,,0,0,0,,Дегенмен, сен талантты, таланттысың.
Dialogue: 1,0:19:21.47,0:19:23.76,CN,,0,0,0,,...
Dialogue: 1,0:19:24.24,0:19:27.23,CN,,0,0,0,,Жаныңа тыныштық тілеймін.
Dialogue: 1,0:19:30.63,0:19:32.87,CN,,0,0,0,,Тамая
Dialogue: 1,0:19:34.11,0:19:35.06,CN,,0,0,0,,Барлығыңды өлтіреміз
Dialogue: 1,0:19:35.25,0:19:36.92,CN,,0,0,0,,Бұл қалыпты түтін емес.
Dialogue: 1,0:19:37.38,0:19:38.66,CN,,0,0,0,,Табиғи түрде аяқталды
Dialogue: 1,0:19:39.07,0:19:41.58,CN,,0,0,0,,Жақсы шолу
Dialogue: 1,0:19:51.14,0:19:53.17,CN,,0,0,0,,Жақсы дрейфтік үшбұрыш
Dialogue: 1,0:19:53.57,0:19:54.90,CN,,0,0,0,,Козуми – данышпан
Dialogue: 1,0:19:55.20,0:19:56.65,CN,,0,0,0,,Мен мұны істей аламын.
Dialogue: 1,0:20:01.57,0:20:04.35,CN,,0,0,0,,Мектептен алған әсер
Dialogue: 1,0:20:04.59,0:20:06.80,CN,,0,0,0,,Мәліметтер қандай?
Dialogue: 1,0:20:07.01,0:20:08.43,CN,,0,0,0,,Мен есінен танып қалдым
Dialogue: 1,0:20:09.05,0:20:09.86,CN,,0,0,0,,Шынайы оқиға?
Dialogue: 1,0:20:10.08,0:20:12.06,CN,,0,0,0,,Мен мансаппен айналысамын.
Dialogue: 1,0:20:12.06,0:20:14.47,CN,,0,0,0,,Мектептегі барлық іс-шаралар тоқтатылды
Dialogue: 1,0:20:16.14,0:20:17.48,CN,,0,0,0,,Бұл тұрарлық емес.
Dialogue: 1,0:20:17.96,0:20:19.47,CN,,0,0,0,,...
Dialogue: 1,0:20:19.69,0:20:21.73,CN,,0,0,0,,Гаяның өлімі
Dialogue: 1,0:20:21.89,0:20:25.20,CN,,0,0,0,,Қайтыс болған адамдардың іссапар шығындары
Dialogue: 1,0:20:25.69,0:20:29.19,CN,,0,0,0,,Жатақханада тұрғаныма көп болды.
Dialogue: 1,0:20:29.47,0:20:30.55,CN,,0,0,0,,Қайталанды ма?
Dialogue: 1,0:20:31.21,0:20:33.01,CN,,0,0,0,,Негізгі капиталдың жоғалуы
Dialogue: 1,0:20:34.76,0:20:37.71,CN,,0,0,0,,Тентенва аспанның кішкентай бұрышы
Dialogue: 1,0:20:37.83,0:20:39.38,CN,,0,0,0,,Басынан бастап көбірек естеліктер
Dialogue: 1,0:20:39.38,0:20:40.21,CN,,0,0,0,,Ол өзінің Стэндін шығарды. Оған кім қарсы шығады?
Dialogue: 1,0:20:40.37,0:20:42.04,CN,,0,0,0,,Астанам – жақсы досым.
Dialogue: 1,0:20:42.26,0:20:44.46,CN,,0,0,0,,Мектепке саяхат суреті
Dialogue: 1,0:20:44.85,0:20:47.64,CN,,0,0,0,,Айчи Тенма Томотомо
Dialogue: 1,0:20:49.23,0:20:50.22,CN,,0,0,0,,Мен сенімді емеспін
Dialogue: 1,0:20:50.81,0:20:54.31,CN,,0,0,0,,Бұл дәл сол фильм.
Dialogue: 1,0:20:56.28,0:20:58.20,CN,,0,0,0,,Бұл біздің достығымыз
Dialogue: 1,0:20:58.75,0:20:59.82,CN,,0,0,0,,Лао Рат Янхуа
Dialogue: 1,0:21:00.23,0:21:01.38,CN,,0,0,0,,Накореджия
Dialogue: 1,0:21:01.83,0:21:04.24,CN,,0,0,0,,Жердегі кездесу
Dialogue: 1,0:21:04.24,0:21:06.64,CN,,0,0,0,,Соқыр нүктелері жоқ жан-жақты шабуыл
Dialogue: 1,0:21:07.56,0:21:09.46,CN,,0,0,0,,Сіз тағы да келдіңіз.
Dialogue: 1,0:21:09.73,0:21:11.36,CN,,0,0,0,,Ерекше жағдайлар
Dialogue: 1,0:21:11.59,0:21:12.88,CN,,0,0,0,,Алғашқы сәулелену он бөлік
Dialogue: 1,0:21:13.53,0:21:14.84,CN,,0,0,0,,Толық жұмыртқа, оңай құтылу
Dialogue: 1,0:21:15.03,0:21:18.48,CN,,1200,0,0,,321
Dialogue: 1,0:21:16.14,0:21:18.39,CN,,0,400,0,,Вакафукайды қайта бекіту аяқталды
Dialogue: 1,0:21:18.60,0:21:19.88,CN,,0,0,0,,Кетіңіз
Dialogue: 1,0:21:27.15,0:21:28.80,CN,,0,0,0,,Менің астанам өтті
Dialogue: 1,0:21:31.68,0:21:33.80,CN,,0,0,0,,Шығыстағы көптеген қауіптер
Dialogue: 1,0:21:36.65,0:21:37.75,CN,,0,0,0,,алынған жоқ
Dialogue: 1,0:21:37.75,0:21:38.74,CN,,0,0,0,,Райо Коуки
Dialogue: 1,0:21:38.91,0:21:39.91,CN,,0,0,0,,Басқа адамның орны
Dialogue: 1,0:21:39.91,0:21:42.08,CN,,0,0,0,,Сізге Тентен Кошин келді
Dialogue: 1,0:23:41.35,0:23:42.97,CN,,0,0,0,,Үшбұрыш…
Dialogue: 0,0:23:44.47,0:23:50.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
