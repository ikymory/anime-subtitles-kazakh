Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.00,0:00:16.88,Default,,0,0,0,,‎(Құбыжық айқайлау)
Dialogue: 0,0:00:16.96,0:00:18.96,Default,,0,0,0,,‎Киберқұдайдың атымен
Dialogue: 0,0:00:19.04,0:00:20.34,Default,,0,0,0,,Фенелопа бұйрықтары
Dialogue: 0,0:00:21.09,0:00:23.63,Default,,0,0,0,,Менің қалауым, жерді толтыр!
Dialogue: 0,0:00:29.38,0:00:30.21,Default,,0,0,0,,‎Hmph
Dialogue: 0,0:00:35.75,0:00:37.04,Default,,0,0,0,,‎Монетизация
Dialogue: 0,0:00:42.29,0:00:43.79,Default,,0,0,0,,‎（‎‎）～
Dialogue: 0,0:00:43.79,0:00:44.59,Default,,0,0,0,,‎（‎‎）～ ♪～
Dialogue: 0,0:00:44.59,0:00:48.09,Default,,0,0,0,,♪～
Dialogue: 0,0:00:48.17,0:00:51.38,Default,,0,0,0,,Мен тағы да қызықсыз нәрсені пайдаға айналдырдым.
Dialogue: 0,0:01:25.92,0:01:30.92,Default,,0,0,0,,～♪
Dialogue: 0,0:01:43.75,0:01:45.04,Default,,0,0,0,,‎（‎‎）
Dialogue: 0,0:01:45.13,0:01:48.21,Default,,0,0,0,,Мен екеуін бағындырдым. Мен табысқа жеттім.
Dialogue: 0,0:01:49.25,0:01:51.00,Default,,0,0,0,,(Ретсуко) Бұл кейіпкер Хайда ма?
Dialogue: 0,0:01:51.09,0:01:54.13,Default,,0,0,0,,Оны сонша ойыншының арасынан қалай таптың?
Dialogue: 0,0:01:54.21,0:01:56.75,Default,,0,0,0,,Хайданың есептік жазбасына алдын ала рұқсатсыз кіру
Dialogue: 0,0:01:56.84,0:01:58.84,Default,,0,0,0,,Мен сенің атыңды және тұрған жеріңді білдім.
Dialogue: 0,0:01:58.92,0:02:00.04,Default,,0,0,0,,‎Фенеко күткендей!
Dialogue: 0,0:02:00.54,0:02:04.29,Default,,0,0,0,,‎(Фенеко) Егер сізде оның электрондық пошта мекенжайы мен махаббат құпия сөзі болса,
Dialogue: 0,0:02:04.38,0:02:06.00,Default,,0,0,0,,Іс жүзінде кез келген жерде тегін өту.
Dialogue: 0,0:02:06.09,0:02:06.92,Default,,0,0,0,,Жазбалар алу
Dialogue: 0,0:02:07.00,0:02:07.88,Default,,0,0,0,,Иә
Dialogue: 0,0:02:10.09,0:02:13.21,Default,,0,0,0,,Сонымен, оның қазір қайда екенін біле алдыңыз ба?
Dialogue: 0,0:02:13.29,0:02:16.92,Default,,0,0,0,,Огикубоның айналасында адамдар бар сияқты, бірақ мен егжей-тегжейін білмеймін.
Dialogue: 0,0:02:17.46,0:02:20.50,Default,,0,0,0,,‎Сіз білуге ​​тырысып, ескерту жасасаңыз жақсы емес.
Dialogue: 0,0:02:22.13,0:02:23.63,Default,,0,0,0,,Сонда мен не істеуім керек?
Dialogue: 0,0:02:25.54,0:02:27.71,Default,,0,0,0,,‎Одан да сенімді әдіс бар
Dialogue: 0,0:02:53.50,0:02:54.38,Default,,0,0,0,,‎Офлайн жиналыс?
Dialogue: 0,0:02:54.88,0:02:58.34,Default,,0,0,0,,А, біз Огикубо станциясының алдындағы отбасылық мейрамханада кездесеміз.
Dialogue: 0,0:02:58.92,0:03:01.50,Default,,0,0,0,,Бұл Шикабане есімді адам да сонда болады дегенді білдіре ме?
Dialogue: 0,0:03:02.00,0:03:03.38,Default,,0,0,0,,Бұл міндетті түрде келеді.
Dialogue: 0,0:03:06.25,0:03:08.59,Default,,0,0,0,,‎(Ретсуко) Бұл адам...еркек пе?
Dialogue: 0,0:03:09.25,0:03:10.75,Default,,0,0,0,,Ол осылай деді.
Dialogue: 0,0:03:11.34,0:03:13.09,Default,,0,0,0,,Өзін кейіп танытқан әйел (Ретсуко)?
Dialogue: 0,0:03:13.17,0:03:14.46,Default,,0,0,0,,Мен оны интернетте түсінбеймін
Dialogue: 0,0:03:14.96,0:03:16.96,Default,,0,0,0,,‎(Ретсуко) Қараңызшы, Гори менеджерлері де солай айтты!
Dialogue: 0,0:03:17.04,0:03:19.96,Default,,0,0,0,,Хайда-кун бір әйелдің үйіне көшіп келеді.
Dialogue: 0,0:03:20.04,0:03:21.13,Default,,0,0,0,,Бұл емес.
Dialogue: 0,0:03:21.21,0:03:23.29,Default,,0,0,0,,‎(Ретсуко) Осы уақытта, осы адамның орнында...
Dialogue: 0,0:03:23.38,0:03:25.17,Default,,0,0,0,,Демек, бұл дұрыс емес!
Dialogue: 0,0:03:25.25,0:03:26.38,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:26.46,0:03:27.67,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:03:31.17,0:03:33.34,Default,,0,0,0,,(Фенеко) Сіз ештеңе түсінбейсіз.
Dialogue: 0,0:03:34.63,0:03:35.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:36.67,0:03:38.46,Default,,0,0,0,,‎(Фенеко) Менің оған деген жауапсыз махаббатым бар
Dialogue: 0,0:03:38.54,0:03:39.96,Default,,0,0,0,,‎Біз 5 жыл бойы кездесіп жүрміз.
Dialogue: 0,0:03:40.46,0:03:42.09,Default,,0,0,0,,Кешіріңіз, бірақ менің бұл мәселеге қатысым жоқ.
Dialogue: 0,0:03:42.17,0:03:44.50,Default,,0,0,0,,Мен Рецукоға қарағанда жақсы түсінемін.
Dialogue: 0,0:03:45.25,0:03:46.63,Default,,0,0,0,,‎Хаидаға сену
Dialogue: 0,0:03:48.04,0:03:49.67,Default,,0,0,0,,Ол ақымақ
Dialogue: 0,0:03:49.75,0:03:52.79,Default,,0,0,0,,Мен ешқашан Рецукоға опасыздық жасайтын ештеңе жасамаймын.
Dialogue: 0,0:03:54.34,0:03:55.17,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:03:56.00,0:03:58.04,Default,,0,0,0,,Сіз мұны тексересіз бе?
Dialogue: 0,0:04:05.42,0:04:08.96,Default,,0,0,0,,(Каба Мегуми) Хаа хаа ха ха...
Dialogue: 0,0:04:09.04,0:04:10.96,Default,,0,0,0,,‎Тайхен!
Dialogue: 0,0:04:24.29,0:04:25.63,Default,,0,0,0,,Сіз маған опасыздық жасап жатырсыз.
Dialogue: 0,0:04:25.71,0:04:26.59,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:27.21,0:04:29.88,Default,,0,0,0,,Жоқ, бірақ сіз әлі түсінбейсіз.
Dialogue: 0,0:04:29.96,0:04:31.46,Default,,0,0,0,,‎Күтіп, не болатынын көрейік
Dialogue: 0,0:04:31.54,0:04:32.59,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:04:37.00,0:04:38.63,Default,,0,0,0,,‎(Каба Мегуми) Ой, кешіріңіз!
Dialogue: 0,0:04:38.71,0:04:41.09,Default,,0,0,0,,Мұнда тапсырыс беріңіз
Dialogue: 0,0:04:41.17,0:04:43.54,Default,,0,0,0,,‎(‎Анай‎) Каба Мегуми-сан, себебі сізді байқайды!
Dialogue: 0,0:04:43.63,0:04:45.42,Default,,0,0,0,,‎Тынш
Dialogue: 0,0:04:46.38,0:04:48.09,Default,,0,0,0,,(Фенеко) Кабае-сан, сен не істеп жатырсың?
Dialogue: 0,0:04:48.17,0:04:51.21,Default,,0,0,0,,Ах, Фенеко-чан, мен де қызық бола бастадым...
Dialogue: 0,0:04:51.29,0:04:52.46,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:04:52.96,0:04:54.34,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:54.92,0:04:58.13,Default,,0,0,0,,‎Жоқ, мен Каба Мегумиден көп нәрсе естідім және қызық болдым.
Dialogue: 0,0:04:58.75,0:05:01.71,Default,,0,0,0,,мырза. Хайда алдыңғы түнде қалуымды өтінді.
Dialogue: 0,0:05:01.79,0:05:04.21,Default,,0,0,0,,Бұл өте жақсы сезінді, мен бір рет бас тарттым ...
Dialogue: 0,0:05:04.29,0:05:07.29,Default,,0,0,0,,‎Мүмкін мұның бір қатысы бар шығар?
Dialogue: 0,0:05:08.46,0:05:09.34,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:05:09.92,0:05:11.54,Default,,0,0,0,,‎Осыдан кейін Хайда дүкеннен шыққанда
Dialogue: 0,0:05:11.63,0:05:13.92,Default,,0,0,0,,Мен жасырын түрде осыдан кейін қосуды ойлап жүрмін.
Dialogue: 0,0:05:14.00,0:05:16.34,Default,,0,0,0,,‎Өтінемін, шу шығармаңыз.
Dialogue: 0,0:05:16.42,0:05:17.59,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:18.09,0:05:19.04,Default,,0,0,0,,На!
Dialogue: 0,0:05:19.13,0:05:20.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:25.29,0:05:26.84,Default,,0,0,0,,‎(Фенеко/Анай) Сәлем!
Dialogue: 0,0:05:26.92,0:05:28.71,Default,,0,0,0,,‎(Фенеко) Рецуко Қазір емес!
Dialogue: 0,0:05:28.79,0:05:30.54,Default,,0,0,0,,‎(Анай) Осы жерде ұстаңыз!
Dialogue: 0,0:05:30.63,0:05:31.46,Default,,0,0,0,,‎ (құлап жатқан дыбыс)
Dialogue: 0,0:05:32.13,0:05:33.79,Default,,0,0,0,,‎(Фенеко) Эй, сабыр ет ‎(Ретсуко) Гарруру...
Dialogue: 0,0:05:33.88,0:05:35.25,Default,,0,0,0,,‎(Каба Мегумидің гуілдеуі)
Dialogue: 0,0:05:35.34,0:05:37.67,Default,,0,0,0,,(Анай) Әй, қайда барасың?
Dialogue: 0,0:05:37.75,0:05:38.84,Default,,0,0,0,,‎Хмм… хмм?
Dialogue: 0,0:05:39.50,0:05:43.29,Default,,0,0,0,,Мен олардың не туралы айтып жатқанын естімеймін, сондықтан телефонды тыңдау құрылғысын орнатамын деп ойлаймын...
Dialogue: 0,0:05:43.38,0:05:45.63,Default,,0,0,0,,‎(Анай) Сен міндетті түрде білесің!
Dialogue: 0,0:05:45.71,0:05:47.79,Default,,0,0,0,,‎(Kabae) ‎Түсінбеу үшін мен мұны істеймін.
Dialogue: 0,0:05:47.88,0:05:50.54,Default,,0,0,0,,‎(Анай) Бұл жақсы емес...
Dialogue: 0,0:05:54.88,0:05:57.13,Default,,0,0,0,,Фенелопа неше жаста?
Dialogue: 0,0:05:58.17,0:06:00.79,Default,,0,0,0,,‎Кәне... 50 ағай?
Dialogue: 0,0:06:00.88,0:06:01.71,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:02.54,0:06:05.34,Default,,0,0,0,,‎Ол адам сөйлемнің соңына ``(жарылыс)'' қосады, солай ма?
Dialogue: 0,0:06:06.00,0:06:08.34,Default,,0,0,0,,Мен мұны істедім. Бұл интернет сленг сияқты.
Dialogue: 0,0:06:08.84,0:06:09.92,Default,,0,0,0,,А...
Dialogue: 0,0:06:12.67,0:06:14.29,Default,,0,0,0,,‎Тым кеш.
Dialogue: 0,0:06:15.00,0:06:16.79,Default,,0,0,0,,‎Ей, ол келмейтін шығар.
Dialogue: 0,0:06:17.59,0:06:21.38,Default,,0,0,0,,Жоқ, сен келесің, өйткені сен уәде бергенсің.
Dialogue: 0,0:06:23.46,0:06:25.25,Default,,0,0,0,,‎(Хабар рингтоны) ‎(Хайда) Ах!
Dialogue: 0,0:06:30.29,0:06:34.29,Default,,0,0,0,,‎«Кенеттен, қандай да бір қиындықтарға байланысты мен бизнес серіктесіме оралуым керек (lol)»
Dialogue: 0,0:06:35.96,0:06:39.42,Default,,0,0,0,,(Фенеко) «Мен бүгін офлайн кездесуге қатыса алмаймын.»
Dialogue: 0,0:07:07.54,0:07:09.17,Default,,0,0,0,,‎(Хайда) Жауап.
Dialogue: 0,0:07:10.21,0:07:11.59,Default,,0,0,0,,‎Сен бос емес шығарсың?
Dialogue: 0,0:07:13.96,0:07:16.92,Default,,0,0,0,,Жарайды, бәрібір ойында кейін кездесеміз.
Dialogue: 0,0:07:19.84,0:07:21.79,Default,,0,0,0,,Мен сені енді ешқашан көрмейтін сияқтымын.
Dialogue: 0,0:07:23.04,0:07:24.79,Default,,0,0,0,,Иә? Неліктен?
Dialogue: 0,0:07:25.75,0:07:27.04,Default,,0,0,0,,Әйтеуір
Dialogue: 0,0:07:27.54,0:07:29.50,Default,,0,0,0,,Мұндай жағдай жиі болады.
Dialogue: 0,0:07:32.29,0:07:33.13,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:07:34.21,0:07:35.84,Default,,0,0,0,,Міне, бұл.
Dialogue: 0,0:07:41.34,0:07:42.29,Default,,0,0,0,,‎Хаида Хаса
Dialogue: 0,0:07:44.00,0:07:45.96,Default,,0,0,0,,‎Осында қанша уақыт болуды жоспарлайсыз?
Dialogue: 0,0:07:47.34,0:07:50.63,Default,,0,0,0,,Егер сіз бөлмені жалға алатын болсаңыз, ол шамамен 300 000 иен тұрады.
Dialogue: 0,0:07:52.71,0:07:54.84,Default,,0,0,0,,Сіз шынымен бұл жерден шыға алмайсыз ба?
Dialogue: 0,0:07:56.71,0:07:59.67,Default,,0,0,0,,Бұл жақын арада болмауы мүмкін.
Dialogue: 0,0:08:00.29,0:08:01.46,Default,,0,0,0,,Сіз түсінесіз.
Dialogue: 0,0:08:02.88,0:08:04.50,Default,,0,0,0,,Мен жақында білдім.
Dialogue: 0,0:08:04.59,0:08:05.71,Default,,0,0,0,,Қашаннан бері?
Dialogue: 0,0:08:05.79,0:08:08.17,Default,,0,0,0,,Ұйқыға кеткеннен кейін аяқтарыңызды осында созыңыз
Dialogue: 0,0:08:09.88,0:08:11.17,Default,,0,0,0,,Ұйқы маңызды
Dialogue: 0,0:08:13.75,0:08:16.42,Default,,0,0,0,,Қайтаратын жерің болса, шындыққа қайтып оралма.
Dialogue: 0,0:08:16.92,0:08:18.46,Default,,0,0,0,,Мен оны аяймын.
Dialogue: 0,0:08:21.09,0:08:22.09,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:24.17,0:08:25.59,Default,,0,0,0,,Шикабане туралы не істеуіміз керек?
Dialogue: 0,0:08:26.09,0:08:28.00,Default,,0,0,0,,‎Себебі маған бұл жер ұнайды
Dialogue: 0,0:08:31.84,0:08:33.50,Default,,0,0,0,,Шикабане неше жаста?
Dialogue: 0,0:08:34.17,0:08:35.17,Default,,0,0,0,,‎21
Dialogue: 0,0:08:36.29,0:08:37.13,Default,,0,0,0,,Сіздің шын есіміңіз кім?
Dialogue: 0,0:08:39.17,0:08:40.09,Default,,0,0,0,,Айтпа
Dialogue: 0,0:08:44.67,0:08:46.59,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:08:59.54,0:09:00.46,Default,,0,0,0,,А?
Dialogue: 0,0:09:00.96,0:09:01.75,Default,,0,0,0,,‎Қайта…!
Dialogue: 0,0:09:08.04,0:09:09.71,Default,,0,0,0,,Кінәлі адам
Dialogue: 0,0:09:11.42,0:09:13.88,Default,,0,0,0,,Толығырақ тыңдайық.
Dialogue: 0,0:09:13.96,0:09:16.54,Default,,0,0,0,,‎Угугу…
Dialogue: 0,0:09:20.34,0:09:24.75,Default,,0,0,0,,(Death Metal караоке)
Dialogue: 0,0:09:33.79,0:09:36.04,Default,,0,0,0,,‎(Фенеко) Қайсысы жақсы, газдалған немесе су?
Dialogue: 0,0:09:37.50,0:09:39.29,Default,,0,0,0,,‎А, сосын су.
Dialogue: 0,0:09:41.96,0:09:43.50,Default,,0,0,0,,Мен сізге алғыс айтқым келеді.
Dialogue: 0,0:09:44.34,0:09:46.92,Default,,0,0,0,,Маған қамқор болмасаң
Dialogue: 0,0:09:47.00,0:09:51.34,Default,,0,0,0,,Хайда қазірге дейін оқиға орнында өлі жатуы мүмкін еді.
Dialogue: 0,0:09:53.09,0:09:55.42,Default,,0,0,0,,Бірақ мен қызыма жамандық жасадым.
Dialogue: 0,0:09:56.42,0:09:59.13,Default,,0,0,0,,‎Хайда жай ғана ақымақ және қоқыс. Ол туралы алаңдамаңыз.
Dialogue: 0,0:09:59.84,0:10:00.75,Default,,0,0,0,,Ах
Dialogue: 0,0:10:00.84,0:10:03.13,Default,,0,0,0,,Мен саған шындықты айттым, маған бәрібір.
Dialogue: 0,0:10:03.21,0:10:04.92,Default,,0,0,0,,Мен сені жек көрмеймін.
Dialogue: 0,0:10:08.50,0:10:10.96,Default,,0,0,0,,‎Мм... сенен бір нәрсе сұрасам болады ма?
Dialogue: 0,0:10:11.54,0:10:12.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:13.75,0:10:14.71,Default,,0,0,0,,мырза. Фенелопа?
Dialogue: 0,0:10:14.79,0:10:15.84,Default,,0,0,0,,‎Сен қайдан білдің?
Dialogue: 0,0:10:19.21,0:10:22.50,Default,,0,0,0,,Олай болса, барлығыңызға, көмектеріңізге көп рахмет!
Dialogue: 0,0:10:22.59,0:10:26.50,Default,,0,0,0,,‎Жоқ, жоқ, бұл. Енді қайтып келе алмайсың.
Dialogue: 0,0:10:26.59,0:10:27.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:28.00,0:10:30.75,Default,,0,0,0,,(Клерк) Мм... Біз түрмеде немесе басқада жатқандай емеспіз.
Dialogue: 0,0:10:30.84,0:10:35.29,Default,,0,0,0,,‎Ахахаха… ‎(Хаида) Ахаха Ахаха…
Dialogue: 0,0:10:37.63,0:10:38.42,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:39.50,0:10:40.63,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:11:04.96,0:11:05.84,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:06.79,0:11:07.71,Default,,0,0,0,,Жарайды, қазір.
Dialogue: 0,0:11:08.63,0:11:10.34,Default,,0,0,0,,Жалғыз бірдеңе жасауға тырысу
Dialogue: 0,0:11:10.42,0:11:13.34,Default,,0,0,0,,Неғұрлым жаман болсам, мен де соншалықты жаманмын.
Dialogue: 0,0:11:15.42,0:11:19.13,Default,,0,0,0,,Мен сізге әр жолы не ойлайтыныңызды айтқым келеді.
Dialogue: 0,0:11:19.21,0:11:21.29,Default,,0,0,0,,‎Жай жақшаны қосуға тырыспаңыз
Dialogue: 0,0:11:22.79,0:11:25.54,Default,,0,0,0,,Егер біз болмасақ, бірге болудың еш мәні жоқ деп ойлаймын
Dialogue: 0,0:11:27.09,0:11:27.92,Default,,0,0,0,,Иә
Dialogue: 0,0:11:28.63,0:11:29.59,Default,,0,0,0,,Түсінді
Dialogue: 0,0:11:34.50,0:11:35.42,Default,,0,0,0,,‎(Хайда) О!
Dialogue: 0,0:11:36.34,0:11:38.96,Default,,0,0,0,,Соңында жердегі жарық көрінеді
Dialogue: 0,0:11:39.04,0:11:42.09,Default,,0,0,0,,‎Асыра сілтеу! Сіз дәл қазір жерде болдыңыз, солай ма?
Dialogue: 0,0:11:42.17,0:11:44.50,Default,,0,0,0,,Ақыры маған бір нәрсе келді.
Dialogue: 0,0:11:45.84,0:11:48.09,Default,,0,0,0,,(Ретсуко) Олай болса, жерге қарай жүгір!
Dialogue: 0,0:11:48.71,0:11:50.04,Default,,0,0,0,,‎(Хайда) Сәлем!
Dialogue: 0,0:11:50.13,0:11:54.50,Default,,0,0,0,,‎Hohohohohoho…
Dialogue: 0,0:11:55.50,0:11:59.42,Default,,0,0,0,,‎Хаа һаа…
Dialogue: 0,0:12:00.54,0:12:01.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:07.79,0:12:08.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:11.42,0:12:12.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:16.34,0:12:17.75,Default,,0,0,0,,‎Бұл не?
Dialogue: 0,0:12:19.25,0:12:20.29,Default,,0,0,0,,‎(Ретсуко) Хайда
Dialogue: 0,0:12:22.50,0:12:23.71,Default,,0,0,0,,Хайда-кун
Dialogue: 0,0:12:25.84,0:12:26.67,Default,,0,0,0,,‎Хайда-кун?
Dialogue: 0,0:12:26.75,0:12:27.59,Default,,0,0,0,,‎(Хайда) Ха
Dialogue: 0,0:12:36.38,0:12:37.34,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:39.09,0:12:39.92,Default,,0,0,0,,‎Жоқ…
Dialogue: 0,0:12:42.17,0:12:43.25,Default,,0,0,0,,Бұл ештеңе емес...
Dialogue: 0,0:13:19.25,0:13:20.09,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:13:21.29,0:13:22.29,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:13:24.88,0:13:26.96,Default,,0,0,0,,‎(Хайда) Ой, ояусың ба?
Dialogue: 0,0:13:27.84,0:13:29.54,Default,,0,0,0,,‎Күріш жақында дайын болады.
Dialogue: 0,0:13:30.42,0:13:32.96,Default,,0,0,0,,‎(Ретсуко) Не?
Dialogue: 0,0:13:33.04,0:13:33.92,Default,,0,0,0,,Ех!
Dialogue: 0,0:13:34.84,0:13:36.71,Default,,0,0,0,,‎Хайда-кун керемет!
Dialogue: 0,0:13:44.79,0:13:46.79,Default,,0,0,0,,‎Не, бірге тұрасың ба?
Dialogue: 0,0:13:47.67,0:13:49.46,Default,,0,0,0,,‎(‎Вашими‎) Басқаша айтқанда...
Dialogue: 0,0:13:51.29,0:13:52.46,Default,,0,0,0,,‎(Вашими/Гори) жол?
Dialogue: 0,0:13:52.96,0:13:54.34,Default,,0,0,0,,Бұл рас, бірақ...
Dialogue: 0,0:13:55.29,0:13:57.04,Default,,0,0,0,,Жарайды емес пе?
Dialogue: 0,0:13:57.13,0:13:59.34,Default,,0,0,0,,‎Әр адамның осындай кездері болады.
Dialogue: 0,0:14:00.50,0:14:03.84,Default,,0,0,0,,Бірге тұрсаң, ата-анаңмен амандасу керек.
Dialogue: 0,0:14:04.42,0:14:05.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:06.09,0:14:07.63,Default,,0,0,0,,Рецуко айта ала ма?
Dialogue: 0,0:14:08.29,0:14:10.84,Default,,0,0,0,,Хайда жұмыссыз.
Dialogue: 0,0:14:11.84,0:14:14.46,Default,,0,0,0,,‎Хмм... Кейін сәлем беремін.
Dialogue: 0,0:14:14.96,0:14:18.09,Default,,0,0,0,,Әзірше мен Хайда-кунға жұмыс іздеуде сәттілік тілеймін.
Dialogue: 0,0:14:19.42,0:14:22.96,Default,,0,0,0,,Менің жаңа өмірім өте жақсы сезінгендіктен
Dialogue: 0,0:14:23.54,0:14:25.88,Default,,0,0,0,,Осылай сөйлей бер мен сені ренжітетін сияқтымын.
Dialogue: 0,0:14:26.38,0:14:28.63,Default,,0,0,0,,Мен біраз уайымдап тұрмын.
Dialogue: 0,0:14:31.46,0:14:32.84,Default,,0,0,0,,‎(Вашими/Гори) Жарайды.
Dialogue: 0,0:14:33.67,0:14:34.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:34.59,0:14:37.17,Default,,0,0,0,,‎(Вашими/Гори) ‎Бір айдан кейін одан жалығып кетесің.
Dialogue: 0,0:14:38.92,0:14:41.96,Default,,0,0,0,,‎ (иіскеу дыбысы)
Dialogue: 0,0:14:53.75,0:14:55.13,Default,,0,0,0,,‎(Ретсуко) Хайда-кун
Dialogue: 0,0:14:55.21,0:14:56.96,Default,,0,0,0,,‎Егер мен оны шешсем, оны кір жуғыш машинаға сала аласыз ба?
Dialogue: 0,0:14:57.04,0:14:57.88,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:57.96,0:14:59.38,Default,,0,0,0,,‎Дәретхананы дұрыс жуу
Dialogue: 0,0:14:59.46,0:15:00.46,Default,,0,0,0,,‎(Хайда) Кешіріңіз.
Dialogue: 0,0:15:11.21,0:15:12.17,Default,,0,0,0,,(Ретсуко) Бұл адам...
Dialogue: 0,0:15:13.29,0:15:15.59,Default,,0,0,0,,‎Сен қашан қайтасың?
Dialogue: 0,0:15:18.42,0:15:19.63,Default,,0,0,0,,‎(Ретсуко) Хайда-кун
Dialogue: 0,0:15:20.54,0:15:23.17,Default,,0,0,0,,‎Кешіріңіз, мен теледидарды естімеймін.
Dialogue: 0,0:15:23.25,0:15:25.63,Default,,0,0,0,,Не, бірдеңе дедің бе?
Dialogue: 0,0:15:30.29,0:15:31.13,Default,,0,0,0,,‎(Ретсуко) Иә
Dialogue: 0,0:15:31.63,0:15:34.17,Default,,0,0,0,,Мен саған ақша беремін. Шөп безгегіне қарсы дәрі сатып ал.
Dialogue: 0,0:15:34.25,0:15:36.46,Default,,0,0,0,,‎Е, жарайды, жарайды.
Dialogue: 0,0:15:36.54,0:15:38.21,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:15:38.29,0:15:40.13,Default,,0,0,0,,(Ретсуко) Цк, жарамайды.
Dialogue: 0,0:15:40.21,0:15:42.79,Default,,0,0,0,,‎(Retsuko) Тәтті тағамдар мен шырындар да ‎Сіз өзіңізге ұнайтын нәрсені сатып ала аласыз.
Dialogue: 0,0:15:42.88,0:15:43.71,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:15:44.29,0:15:46.29,Default,,0,0,0,,Иә, келіңіз.
Dialogue: 0,0:15:51.59,0:15:53.17,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:16:01.96,0:16:02.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:03.84,0:16:04.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:05.96,0:16:10.75,Default,,0,0,0,,(есік қоңырауы)
Dialogue: 0,0:16:11.29,0:16:17.71,Default,,0,0,0,,‎(жылау)
Dialogue: 0,0:16:19.00,0:16:20.46,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:16:26.25,0:16:28.13,Default,,0,0,0,,‎(Ретсукомо) Эй, (Хайда) Уф
Dialogue: 0,0:16:28.21,0:16:29.50,Default,,0,0,0,,‎(Ретсукомо) Сіз кімсіз?
Dialogue: 0,0:16:30.00,0:16:34.29,Default,,0,0,0,,Е, жоқ, мен күдікті адам емеспін...
Dialogue: 0,0:16:36.71,0:16:39.17,Default,,0,0,0,,‎Қызыңызбен қандай қарым-қатынастасыз?
Dialogue: 0,0:16:39.75,0:16:44.75,Default,,0,0,0,,♪～
Dialogue: 0,0:17:04.63,0:17:09.63,Default,,0,0,0,,～♪
