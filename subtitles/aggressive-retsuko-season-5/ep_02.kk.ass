Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.34,0:00:15.00,Default,,0,0,0,,(Анай) Сәлем Та-сан? Уау, біраз уақыт өтті!
Dialogue: 0,0:00:15.09,0:00:16.46,Default,,0,0,0,,‎Қалайсың?
Dialogue: 0,0:00:16.96,0:00:19.04,Default,,0,0,0,,‎(Хайда) Ахаха Генки Генки
Dialogue: 0,0:00:19.71,0:00:21.46,Default,,0,0,0,,(Анай) Келесі жұмысыңды шештің бе?
Dialogue: 0,0:00:21.54,0:00:24.17,Default,,0,0,0,,‎Аа, бұл болғалы тұр...
Dialogue: 0,0:00:24.79,0:00:26.13,Default,,0,0,0,,Мен бақыттымын.
Dialogue: 0,0:00:26.75,0:00:28.59,Default,,0,0,0,,Шынымды айтсам, мен уайымдадым.
Dialogue: 0,0:00:28.67,0:00:29.63,Default,,0,0,0,,Дәл осылай, әйтеуір
Dialogue: 0,0:00:29.71,0:00:32.46,Default,,0,0,0,,Қызық, Хайда мырза екеуміз айырылысып қаламыз ба?
Dialogue: 0,0:00:33.42,0:00:35.71,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:00:36.21,0:00:39.13,Default,,0,0,0,,‎Біз сенімен тек жұмыс үшін кездескен жоқпыз, солай ма?
Dialogue: 0,0:00:39.96,0:00:41.29,Default,,0,0,0,,мырза. Хайда…
Dialogue: 0,0:00:42.50,0:00:45.17,Default,,0,0,0,,Қарсы болмасаң...
Dialogue: 0,0:00:45.79,0:00:49.04,Default,,0,0,0,,Бүгін менімен түнеуге бола ма?
Dialogue: 0,0:00:49.13,0:00:50.21,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:00:53.67,0:00:54.92,Default,,0,0,0,,А, мүмкін емес пе?
Dialogue: 0,0:00:55.54,0:00:57.54,Default,,0,0,0,,‎Менің бөлмелесім ұялшақ!
Dialogue: 0,0:00:57.63,0:00:58.67,Default,,0,0,0,,Иә…
Dialogue: 0,0:00:59.75,0:01:01.42,Default,,0,0,0,,Огами мырза ше?
Dialogue: 0,0:01:01.50,0:01:04.13,Default,,0,0,0,,Огами? Жоқ, аз ғана
Dialogue: 0,0:01:04.21,0:01:06.84,Default,,0,0,0,,Біз олардың түнде қалуын өтінетіндей жақсы дос емеспіз...
Dialogue: 0,0:01:06.92,0:01:08.54,Default,,0,0,0,,‎(Анай) Иә? (Хайда) А?
Dialogue: 0,0:01:09.96,0:01:13.38,Default,,0,0,0,,♪~ Бірақ Хайда-сан екеуміз де онша жақын емеспіз, солай ма?
Dialogue: 0,0:01:13.38,0:01:14.96,Default,,0,0,0,,♪～
Dialogue: 0,0:02:07.54,0:02:09.75,Default,,0,0,0,,‎(Хайда) Арзаны жақсы.
Dialogue: 0,0:02:11.09,0:02:14.17,Default,,0,0,0,,‎Егер сіз кеңсе қызметкері болсаңыз, пакеттік төлемдерге жеңілдік беріледі.
Dialogue: 0,0:02:14.25,0:02:16.75,Default,,0,0,0,,‎(Хайда) А, онда бұл 8 сағаттық.
Dialogue: 0,0:02:16.84,0:02:18.25,Default,,0,0,0,,‎(Сатушы) Сізге көп рахмет.
Dialogue: 0,0:02:18.34,0:02:21.46,Default,,0,0,0,,‎Шығу кезінде осы слипті алдыңғы үстелге әкеліңіз.
Dialogue: 0,0:02:39.96,0:02:40.79,Default,,0,0,0,,‎Фуу…
Dialogue: 0,0:02:41.63,0:02:42.46,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:02:44.54,0:02:45.71,Default,,0,0,0,,Мен ұйықтай аламын ба?
Dialogue: 0,0:02:48.92,0:02:49.79,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:02:49.88,0:02:52.46,Default,,0,0,0,,Сіз жұмысқа тұрғанша кездеспеймін дедіңіз бе?
Dialogue: 0,0:02:52.54,0:02:54.67,Default,,0,0,0,,Бұл Рецуко үшін түбегейлі қадам болды.
Dialogue: 0,0:02:54.75,0:02:56.21,Default,,0,0,0,,‎(Ретсуко) ‎Мен бүлініп қалдым.
Dialogue: 0,0:02:56.29,0:02:57.79,Default,,0,0,0,,Мұнда қатаң болайық.
Dialogue: 0,0:02:58.29,0:02:59.63,Default,,0,0,0,,‎(‎Вашими‎) Жақсы шешім.
Dialogue: 0,0:03:00.13,0:03:02.67,Default,,0,0,0,,Сіз бір-біріңізге сүйенетін қарым-қатынас жақсы емес
Dialogue: 0,0:03:02.75,0:03:06.04,Default,,0,0,0,,‎Мен сізбен жиі хабарласып тұрамын.
Dialogue: 0,0:03:06.13,0:03:06.96,Default,,0,0,0,,‎(Вашими) Дұрыс жауап
Dialogue: 0,0:03:08.38,0:03:10.67,Default,,0,0,0,,‎Бірақ мен біраз уайымдап тұрмын.
Dialogue: 0,0:03:10.75,0:03:11.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:12.34,0:03:14.71,Default,,0,0,0,,Бұл Хайданың құмарлығы бар ойын.
Dialogue: 0,0:03:14.79,0:03:17.21,Default,,0,0,0,,Сізде ойнайтын достарыңыз бар, солай ма?
Dialogue: 0,0:03:17.29,0:03:19.25,Default,,0,0,0,,(Уашими) Ойын ескі, Гори-чан.
Dialogue: 0,0:03:19.34,0:03:22.21,Default,,0,0,0,,Мен ол адам жаман адам емес деп үміттенемін.
Dialogue: 0,0:03:22.92,0:03:25.34,Default,,0,0,0,,‎Хайда-кун ‎Себебі сен оңай әсер ететін типсің
Dialogue: 0,0:03:37.79,0:03:39.46,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:03:42.00,0:03:43.42,Default,,0,0,0,,‎Necafe қазір Necafe
Dialogue: 0,0:03:48.79,0:03:50.09,Default,,0,0,0,,‎(Хайда) «Неге?»...
Dialogue: 0,0:03:50.17,0:03:52.17,Default,,0,0,0,,Шығу тегі туралы айтатын болсақ, бұл сіз едіңіз!
Dialogue: 0,0:03:56.38,0:03:57.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:58.09,0:03:59.84,Default,,0,0,0,,‎“Анагура‎‎Огикубо‎ дүкені”
Dialogue: 0,0:04:07.42,0:04:10.09,Default,,0,0,0,,‎(Хайда) Иә? Мен мұндай нәрсені естігенде не істеуім керек?
Dialogue: 0,0:04:16.09,0:04:18.21,Default,,0,0,0,,‎Мм… Иә…
Dialogue: 0,0:04:35.42,0:04:36.59,Default,,0,0,0,,(Есіктің ашылған дыбысы) (Хайда) Иә?
Dialogue: 0,0:04:40.67,0:04:41.92,Default,,0,0,0,,‎(Әйел) Бұл Хайда ма?
Dialogue: 0,0:04:43.67,0:04:44.88,Default,,0,0,0,,Иә…
Dialogue: 0,0:04:45.67,0:04:47.21,Default,,0,0,0,,Мен Шикабане
Dialogue: 0,0:04:47.71,0:04:49.46,Default,,0,0,0,,Қандай сәйкестік?
Dialogue: 0,0:04:50.96,0:04:51.79,Default,,0,0,0,,О, жоқ...
Dialogue: 0,0:04:58.54,0:05:00.21,Default,,0,0,0,,Мен басқа адамның әйел екенін білген бойда
Dialogue: 0,0:05:00.29,0:05:02.63,Default,,0,0,0,,Жұмбақтан қызыққан ер адамдар бар.
Dialogue: 0,0:05:04.71,0:05:06.42,Default,,0,0,0,,Жақында менімен сыртта кездесуіңізді өтінемін.
Dialogue: 0,0:05:06.50,0:05:08.04,Default,,0,0,0,,Бұл қиыншылық.
Dialogue: 0,0:05:09.34,0:05:12.09,Default,,0,0,0,,‎Еркек болып көріну ыңғайлырақ.
Dialogue: 0,0:05:13.17,0:05:14.96,Default,,0,0,0,,‎Менімен кездесуге болады ма?
Dialogue: 0,0:05:15.04,0:05:16.84,Default,,0,0,0,,‎Хаиданың құрбысы бар.
Dialogue: 0,0:05:17.88,0:05:19.42,Default,,0,0,0,,‎Некафеге не үшін келдің?
Dialogue: 0,0:05:19.50,0:05:22.71,Default,,0,0,0,,‎Басатын жерің жоқ болса, қызыңа жылау керек.
Dialogue: 0,0:05:22.79,0:05:25.21,Default,,0,0,0,,Сонша ақша төлеген соң ақша жоқ деп айта аласыз ба...
Dialogue: 0,0:05:25.29,0:05:27.42,Default,,0,0,0,,Бұл мұндай атмосфера емес еді.
Dialogue: 0,0:05:27.50,0:05:29.17,Default,,0,0,0,,Сіз қанша төледіңіз?
Dialogue: 0,0:05:31.38,0:05:32.42,Default,,0,0,0,,‎(Хайда) Осыншама
Dialogue: 0,0:05:32.50,0:05:34.46,Default,,0,0,0,,30 000? Бұл ақылсыз
Dialogue: 0,0:05:35.17,0:05:37.17,Default,,0,0,0,,‎(Хайда) №, 30…
Dialogue: 0,0:05:39.79,0:05:40.75,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:05:40.84,0:05:44.34,Default,,0,0,0,,А... білесің бе... Түпнұсқа туралы айтсам...
Dialogue: 0,0:05:45.00,0:05:46.75,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:05:49.04,0:05:51.92,Default,,0,0,0,,Кофе сервері соңғы уақытта өзін жақсы сезінбейді.
Dialogue: 0,0:05:57.63,0:05:59.79,Default,,0,0,0,,Менің Netcafe-ге түсіп кеткенім кінәлі ме?
Dialogue: 0,0:06:00.79,0:06:03.09,Default,,0,0,0,,Бұл идея жаңашыл.
Dialogue: 0,0:06:03.67,0:06:05.50,Default,,0,0,0,,‎Қайырлы түн~
Dialogue: 0,0:06:11.46,0:06:14.04,Default,,0,0,0,,‎(Хайда) Хмм... Ммм...
Dialogue: 0,0:06:14.04,0:06:15.46,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,0:06:15.46,0:06:17.29,Default,,0,0,0,,‎(Хайда) Хмм...
Dialogue: 0,0:06:17.29,0:06:18.42,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,0:06:19.29,0:06:22.71,Default,,0,0,0,,‎(аяқ дыбысы)
Dialogue: 0,0:06:22.79,0:06:24.34,Default,,0,0,0,,Мен ұйықтай алмаймын
Dialogue: 0,0:06:36.67,0:06:38.67,Default,,0,0,0,,‎(Хабар рингтоны) ‎(Haida) Huh!
Dialogue: 0,0:06:50.84,0:06:54.17,Default,,0,0,0,,‎
Dialogue: 0,0:06:57.50,0:06:58.54,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:07:13.17,0:07:14.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:20.67,0:07:23.42,Default,,0,0,0,,‎Хмм? О... күте тұрыңыз.
Dialogue: 0,0:07:24.21,0:07:25.25,Default,,0,0,0,,‎Ағымдағы мекенжай?
Dialogue: 0,0:07:26.63,0:07:29.13,Default,,0,0,0,,‎Хух~ ‎“Хайда” – оның шын аты.
Dialogue: 0,0:07:31.42,0:07:34.54,Default,,0,0,0,,‎(Хайда) Уау! Мұнда не үшін келдің?
Dialogue: 0,0:07:35.34,0:07:36.75,Default,,0,0,0,,Мен жұмысқа келдім.
Dialogue: 0,0:07:37.71,0:07:38.59,Default,,0,0,0,,Жұмыс?
Dialogue: 0,0:07:39.09,0:07:40.71,Default,,0,0,0,,‎Интернеттен табылған жалғыз кадрлар
Dialogue: 0,0:07:41.46,0:07:44.54,Default,,0,0,0,,‎Іс қағаздарын жүргізу, дүкенді таныстыру, жазу және т.б.
Dialogue: 0,0:07:50.04,0:07:52.59,Default,,0,0,0,,Мекен-жайыңыз болмаса, түйіндемеңізді жазу қиынға соғады, солай ма?
Dialogue: 0,0:07:55.09,0:07:57.71,Default,,0,0,0,,Сіз оны лайықты компанияға жіберуді жоспарлап отырсыз ба?
Dialogue: 0,0:07:58.25,0:08:01.71,Default,,0,0,0,,Ондай жағдайда жалған адрес жазу қауіпті емес пе?
Dialogue: 0,0:08:02.71,0:08:04.92,Default,,0,0,0,,Қоғам мүшелері үшін сенім бірінші орында, солай ма?
Dialogue: 0,0:08:08.13,0:08:09.67,Default,,0,0,0,,‎Ата-анамның мекен-жайын жазуым керек пе?
Dialogue: 0,0:08:13.38,0:08:15.34,Default,,0,0,0,,‎(Хайда) Ата-анамның үйі біраз...
Dialogue: 0,0:08:16.75,0:08:19.96,Default,,0,0,0,,Себеп болуы керек. Бұл Necafe немесе басқа нәрсеге түспей ме?
Dialogue: 0,0:08:23.00,0:08:25.67,Default,,0,0,0,,Шикабаненің досы ма? Ха~
Dialogue: 0,0:08:26.17,0:08:29.38,Default,,0,0,0,,Мен оларды сізге міндетті түрде таныстырамын. Сайтта адам жеткіліксіз.
Dialogue: 0,0:08:30.09,0:08:31.09,Default,,0,0,0,,Сіз ауыр жүкті көтере аласыз ба?
Dialogue: 0,0:08:31.17,0:08:32.59,Default,,0,0,0,,Мен сенімді емеспін...
Dialogue: 0,0:08:33.25,0:08:36.96,Default,,0,0,0,,Қалыпты жұмысқа орналасқыңыз келсе, ақшаңызды жинап, алдымен осы жерден кетіңіз.
Dialogue: 0,0:08:37.04,0:08:40.09,Default,,0,0,0,,Мен сұхбатқа ұйқысыз зомбидің жүзімен барғанымда да,
Dialogue: 0,0:08:40.17,0:08:41.13,Default,,0,0,0,,Сізді тастап кетесіз.
Dialogue: 0,0:08:46.84,0:08:49.79,Default,,0,0,0,,Мұнда келгенде аяғыңды дұрыстап қарау керек.
Dialogue: 0,0:08:49.88,0:08:51.96,Default,,0,0,0,,‎Егер сіз жарқын болашақты армандаған болсаңыз
Dialogue: 0,0:08:52.63,0:08:53.67,Default,,0,0,0,,‎Себебі ол бітеліп қалады, солай ма?
Dialogue: 0,0:09:04.67,0:09:05.54,Default,,0,0,0,,‎Жүру
Dialogue: 0,0:09:08.17,0:09:10.46,Default,,0,0,0,,Жұмыс киімін сол жерден алуға болады.
Dialogue: 0,0:09:25.46,0:09:28.34,Default,,0,0,0,,‎Хаа
Dialogue: 0,0:09:28.42,0:09:30.79,Default,,0,0,0,,‎Мм... Ммм.
Dialogue: 0,0:09:31.63,0:09:33.34,Default,,0,0,0,,‎Nuo~
Dialogue: 0,0:09:33.96,0:09:36.42,Default,,0,0,0,,‎Хайда-кун ‎Жақсысың ба? Сіз бара аласыз ба?
Dialogue: 0,0:09:37.00,0:09:38.17,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:09:39.84,0:09:42.54,Default,,0,0,0,,‎(Хайда) Ха хмм хааа хмм...
Dialogue: 0,0:09:43.50,0:09:45.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:50.75,0:09:53.54,Default,,0,0,0,,‎Ах~ Ах~
Dialogue: 0,0:09:53.63,0:09:55.84,Default,,0,0,0,,Менің физикалық күшім онша емес.
Dialogue: 0,0:09:58.09,0:10:00.21,Default,,0,0,0,,А, қарным ашты.
Dialogue: 0,0:10:02.75,0:10:04.54,Default,,0,0,0,,‎Бірақ мен тамақ ішкенде құсамын...
Dialogue: 0,0:10:05.34,0:10:06.63,Default,,0,0,0,,‎(Хабар рингтоны)
Dialogue: 0,0:10:14.25,0:10:15.79,Default,,0,0,0,,(Хайда) Күнделікті жалақы 10 000 иен
Dialogue: 0,0:10:17.29,0:10:19.13,Default,,0,0,0,,‎Интернет-кафеде тұру ақысы 2000 иен
Dialogue: 0,0:10:19.96,0:10:21.67,Default,,0,0,0,,‎Тамақтану шығындары 1520 иен
Dialogue: 0,0:10:22.46,0:10:24.09,Default,,0,0,0,,Ванна ақысы 480 иен
Dialogue: 0,0:10:24.17,0:10:25.79,Default,,0,0,0,,‎Монета шкафын пайдалану ақысы 900 иен
Dialogue: 0,0:10:26.67,0:10:28.84,Default,,0,0,0,,‎Монетаның кір жуу ақысы 800 иен
Dialogue: 0,0:10:30.88,0:10:33.38,Default,,0,0,0,,Ал, онда...
Dialogue: 0,0:10:41.17,0:10:42.63,Default,,0,0,0,,‎(Клерк) Бұл Хайда мырза.
Dialogue: 0,0:10:43.13,0:10:44.71,Default,,0,0,0,,Бүгін таңертең үйге барасыз ба?
Dialogue: 0,0:10:45.59,0:10:48.09,Default,,0,0,0,,(Хайда) Иә, түн ортасында оқиға орнында болды.
Dialogue: 0,0:10:48.92,0:10:50.75,Default,,0,0,0,,‎(Сатушы) Бұл қиын көрініс болған сияқты.
Dialogue: 0,0:10:50.84,0:10:52.38,Default,,0,0,0,,Ұйқы
Dialogue: 0,0:10:53.13,0:10:55.63,Default,,0,0,0,,(сатушы) Жақын жерде бір оқиға болған сияқты.
Dialogue: 0,0:10:55.71,0:10:57.42,Default,,0,0,0,,‎Қазір барлық жеке бөлмелер орналасқан.
Dialogue: 0,0:10:57.50,0:10:59.25,Default,,0,0,0,,Тек ашық орындар қалды.
Dialogue: 0,0:10:59.34,0:11:00.67,Default,,0,0,0,,Қарсысыз ба?
Dialogue: 0,0:11:07.25,0:11:11.34,Default,,0,0,0,,(Хайда) ‎Ақшаңызды тез жинап, бұл жерден кетіңіз.
Dialogue: 0,0:11:13.04,0:11:14.63,Default,,0,0,0,,‎(Хабар рингтоны)
Dialogue: 0,0:11:30.75,0:11:31.75,Default,,0,0,0,,‎( құлаған дыбыс)
Dialogue: 0,0:11:39.75,0:11:43.00,Default,,0,0,0,,‎(Фенеко) Рецуконың тұрақты байланысы ‎Оқыңыз
Dialogue: 0,0:11:43.09,0:11:45.50,Default,,0,0,0,,‎(Фенеко) Аматсусае ‎Біз бір-бірімізбен байланысымызды үздік.
Dialogue: 0,0:11:46.13,0:11:48.92,Default,,0,0,0,,‎Ол сондай үмітсіз! Анау ақымақ!
Dialogue: 0,0:11:49.00,0:11:50.50,Default,,0,0,0,,Бұл сөзсіз ойын, солай ма?
Dialogue: 0,0:11:50.59,0:11:53.29,Default,,0,0,0,,‎Түні бойы ойнап жүр, мен сенің ұйықтап жатқаныңа сенімдімін, солай ма?
Dialogue: 0,0:11:53.38,0:11:55.92,Default,,0,0,0,,Фенеко, бұл ойын емес.
Dialogue: 0,0:11:56.00,0:11:57.84,Default,,0,0,0,,‎Мяу! Кешіріңіз...
Dialogue: 0,0:11:57.92,0:11:59.50,Default,,0,0,0,,Мен жай ғана толқып кеттім...
Dialogue: 0,0:12:00.00,0:12:02.84,Default,,0,0,0,,‎Бұл жолғы сауалнама – өмір сүру жағдайын зерттеу.
Dialogue: 0,0:12:03.42,0:12:05.96,Default,,0,0,0,,Хайданың жүрегінен шайтанды қуып тастаңыз ...
Dialogue: 0,0:12:06.04,0:12:08.54,Default,,0,0,0,,Жарқын болашақты жүзеге асыру
Dialogue: 0,0:12:08.63,0:12:11.13,Default,,0,0,0,,Ең жақсы ойын-сауық!
Dialogue: 0,0:12:11.21,0:12:13.79,Default,,0,0,0,,‎Хахаха...
Dialogue: 0,0:12:15.38,0:12:16.96,Default,,0,0,0,,Хайда!
Dialogue: 0,0:12:18.63,0:12:19.67,Default,,0,0,0,,Біреу жоқ па?
Dialogue: 0,0:12:19.75,0:12:21.13,Default,,0,0,0,,‎(Ретсуко) Икусуды пайдаланып жатқан шығар
Dialogue: 0,0:12:21.63,0:12:22.67,Default,,0,0,0,,Сәлем Хайда!
Dialogue: 0,0:12:23.17,0:12:27.00,Default,,0,0,0,,‎Есік Егер сынғың келмесе, тыныш шық!
Dialogue: 0,0:12:27.09,0:12:29.79,Default,,0,0,0,,‎Хайда~!
Dialogue: 0,0:12:34.96,0:12:37.59,Default,,0,0,0,,Мен мұнда екі аптадан бері тұрамын.
Dialogue: 0,0:12:37.67,0:12:39.04,Default,,0,0,0,,‎Иә~
Dialogue: 0,0:12:39.79,0:12:40.79,Default,,0,0,0,,Сіз нені айтып тұрсыз?
Dialogue: 0,0:12:47.88,0:12:54.84,Default,,0,0,0,,‎(Ұялы телефон рингтоны)
Dialogue: 0,0:12:56.25,0:12:57.71,Default,,0,0,0,,‎Tsk, тітіркендіргіш.
Dialogue: 0,0:12:57.79,0:12:59.71,Default,,0,0,0,,‎Смартфоныңыздың қоңырауы кім?
Dialogue: 0,0:13:06.79,0:13:07.96,Default,,0,0,0,,Қоңырау соғып тұр
Dialogue: 0,0:13:10.75,0:13:11.79,Default,,0,0,0,,‎Хмм... а
Dialogue: 0,0:13:12.54,0:13:13.38,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:13:14.04,0:13:15.38,Default,,0,0,0,,‎Мм…
Dialogue: 0,0:13:18.71,0:13:20.63,Default,,0,0,0,,О, Рецуко?
Dialogue: 0,0:13:21.25,0:13:22.67,Default,,0,0,0,,‎Хмм…
Dialogue: 0,0:13:23.67,0:13:24.50,Default,,0,0,0,,Не?
Dialogue: 0,0:13:25.96,0:13:28.13,Default,,0,0,0,,‎Хайда-кун, қазір қайдасың?
Dialogue: 0,0:13:28.84,0:13:29.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:30.46,0:13:32.34,Default,,0,0,0,,‎Үй... Бірақ
Dialogue: 0,0:13:36.79,0:13:38.00,Default,,0,0,0,,‎(Вашими/Гори) алдау.
Dialogue: 0,0:13:40.84,0:13:42.75,Default,,0,0,0,,‎Ретсуко Шындыққа қараңыз
Dialogue: 0,0:13:44.50,0:13:47.21,Default,,0,0,0,,‎Қашықтан бақыланатын ‎Қызық күндер
Dialogue: 0,0:13:47.29,0:13:50.13,Default,,0,0,0,,‎(Вашими) ‎Осы уақытта мен онлайн ойын арқылы танысқан әйел.
Dialogue: 0,0:13:50.21,0:13:51.96,Default,,0,0,0,,‎Екі адамның ғашық болуы...
Dialogue: 0,0:13:52.04,0:13:55.29,Default,,0,0,0,,(Вашими) Ал Хайда екінші тараптың үйіне көшіп келді...
Dialogue: 0,0:13:55.38,0:13:56.46,Default,,0,0,0,,‎(Вашими/Гори) ‎Жақында жұп болады
Dialogue: 0,0:13:56.54,0:13:59.25,Default,,0,0,0,,Instagram желісінде косплей фотоларын жүктеп жатқан екі адам
Dialogue: 0,0:13:59.34,0:14:02.38,Default,,0,0,0,,‎Осындай бос сөзді айтып, болжауды доғара аласыз ба?
Dialogue: 0,0:14:02.46,0:14:05.50,Default,,0,0,0,,Олай ойласаң, Хайда-куннан сұра.
Dialogue: 0,0:14:05.59,0:14:08.42,Default,,0,0,0,,Әйтпесе, адасушылықтарымыз көбейе береді.
Dialogue: 0,0:14:09.17,0:14:10.17,Default,,0,0,0,,Сәлем, Рецуко
Dialogue: 0,0:14:10.84,0:14:12.75,Default,,0,0,0,,Қайтадан мұқият тыңдаңыз.
Dialogue: 0,0:14:12.84,0:14:13.67,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:14:14.46,0:14:16.09,Default,,0,0,0,,‎(Ретсуко) Қорқынышты мүмкін емес
Dialogue: 0,0:14:16.17,0:14:18.25,Default,,0,0,0,,‎Онда мен оны сен үшін тыңдаймын.
Dialogue: 0,0:14:22.29,0:14:23.13,Default,,0,0,0,,Мен сұрай алмаймын...
Dialogue: 0,0:14:32.13,0:14:39.09,Default,,0,0,0,,‎ (ұйықтау тынысы)
Dialogue: 0,0:14:40.63,0:14:42.38,Default,,0,0,0,,‎Ха... Иә?
Dialogue: 0,0:14:44.96,0:14:45.79,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:14:47.25,0:14:49.75,Default,,0,0,0,,‎Мм! Ал...
Dialogue: 0,0:14:51.17,0:14:52.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:54.13,0:14:56.46,Default,,0,0,0,,Ол зомби сияқты көрінді, ол өлді.
Dialogue: 0,0:14:56.54,0:14:58.71,Default,,0,0,0,,Докачин-сан оны маған алып келді.
Dialogue: 0,0:14:59.42,0:15:02.04,Default,,0,0,0,,‎Мен денемді созып, ұйықтағаныма біраз болды.
Dialogue: 0,0:15:02.13,0:15:02.96,Default,,0,0,0,,А...
Dialogue: 0,0:15:04.88,0:15:07.42,Default,,0,0,0,,‎Бұл бөлмені екі адам жалға алса, арзанырақ.
Dialogue: 0,0:15:08.67,0:15:09.75,Default,,0,0,0,,‎Неге бөліспеске?
Dialogue: 0,0:15:09.84,0:15:11.59,Default,,0,0,0,,‎Жоқ, мен оны тоқтатамын.
Dialogue: 0,0:15:14.13,0:15:16.54,Default,,0,0,0,,Тіпті мен аздап жауапкершілікті сезінемін.
Dialogue: 0,0:15:17.38,0:15:20.88,Default,,0,0,0,,Оқиға орнына шаршамай келсең, Жарақат алсаң бітті.
Dialogue: 0,0:15:22.71,0:15:24.29,Default,,0,0,0,,‎(шу) ‎(Хайда) Ах.
Dialogue: 0,0:15:24.92,0:15:26.34,Default,,0,0,0,,Біріккен майдан құрайық
Dialogue: 0,0:15:27.09,0:15:29.17,Default,,0,0,0,,Олар сол жерде солай істеді, солай ма?
Dialogue: 0,0:15:33.79,0:15:35.25,Default,,0,0,0,,Шикабанеге қара!
Dialogue: 0,0:15:35.34,0:15:39.25,Default,,0,0,0,,‎Бұл өте сирек кездесетін бұйым ‎Мұрамаса семсерінің күші!
Dialogue: 0,0:15:39.75,0:15:40.59,Default,,0,0,0,,‎Йошикита
Dialogue: 0,0:15:41.29,0:15:43.75,Default,,0,0,0,,‎(Хайда) Найзағай найзағай!
Dialogue: 0,0:15:43.84,0:15:44.67,Default,,0,0,0,,бастап
Dialogue: 0,0:15:44.75,0:15:47.09,Default,,0,0,0,,‎(Хайда) Гидро найзағай!
Dialogue: 0,0:15:48.04,0:15:49.21,Default,,0,0,0,,Қайдан?
Dialogue: 0,0:15:49.29,0:15:53.09,Default,,0,0,0,,‎Соңғы найзағай!
Dialogue: 0,0:15:53.17,0:15:54.13,Default,,0,0,0,,‎(Құбыжықтың айқайы)
Dialogue: 0,0:15:54.21,0:15:57.21,Default,,0,0,0,,‎(Хайда) Ораораора…
Dialogue: 0,0:15:59.21,0:16:00.54,Default,,0,0,0,,‎(Хаида/Шикабане) ‎Тым финал
Dialogue: 0,0:16:01.92,0:16:02.75,Default,,0,0,0,,‎(Хайда) Аяқ
Dialogue: 0,0:16:04.42,0:16:09.17,Default,,0,0,0,,‎ (ұйықтау тынысы)
Dialogue: 0,0:16:12.67,0:16:15.21,Default,,0,0,0,,‎Хмм!
Dialogue: 0,0:16:16.71,0:16:17.88,Default,,0,0,0,,‎Ха…
Dialogue: 0,0:16:26.84,0:16:29.25,Default,,0,0,0,,‎О, болды!
Dialogue: 0,0:16:29.34,0:16:30.67,Default,,0,0,0,,‎(Хайда) Оңай жеңіс
Dialogue: 0,0:16:33.17,0:16:34.42,Default,,0,0,0,,‎Оссу Шикабане
Dialogue: 0,0:16:34.50,0:16:35.34,Default,,0,0,0,,‎Осу
Dialogue: 0,0:16:38.84,0:16:40.75,Default,,0,0,0,,Хайда, сен бүгін аңға барасың ба?
Dialogue: 0,0:16:40.84,0:16:43.21,Default,,0,0,0,,‎Хмм, мен бүгін тоқтайтын шығармын.
Dialogue: 0,0:16:44.79,0:16:47.59,Default,,0,0,0,,Кеше Хайда ұйықтаған соң, мен жеке ойнадым.
Dialogue: 0,0:16:47.67,0:16:49.34,Default,,0,0,0,,‎Жоғалған орманда Жаңадан бастаушылармен танысыңыз
Dialogue: 0,0:16:49.42,0:16:50.38,Default,,0,0,0,,‎Уау~
Dialogue: 0,0:16:51.38,0:16:53.25,Default,,0,0,0,,Біз таңға дейін бірге ойнадық.
Dialogue: 0,0:16:54.71,0:16:57.96,Default,,0,0,0,,‎Бұл адам соңғы найзағайды көргісі келеді.
Dialogue: 0,0:16:58.46,0:17:01.00,Default,,0,0,0,,‎Мен сізге аздап көрсетейін бе?
Dialogue: 0,0:17:04.79,0:17:06.17,Default,,0,0,0,,А, міне, келді.
Dialogue: 0,0:17:07.29,0:17:08.29,Default,,0,0,0,,Сол адам
Dialogue: 0,0:17:08.38,0:17:09.46,Default,,0,0,0,,‎(Хайда) Ху~
Dialogue: 0,0:17:09.96,0:17:12.09,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:17:18.09,0:17:19.96,Default,,0,0,0,,‎Сәлеметсіз бе, танысқаныма қуаныштымын.
Dialogue: 0,0:17:20.50,0:17:21.63,Default,,0,0,0,,Бұл Фенелопа
Dialogue: 0,0:17:22.54,0:17:27.54,Default,,0,0,0,,♪～
Dialogue: 0,0:17:47.42,0:17:52.42,Default,,0,0,0,,～♪
