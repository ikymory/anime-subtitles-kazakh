Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.30,0:00:05.63,Default,,0,0,0,,<Бітіру...Барлығы аз-аздан өзгереді>
Dialogue: 0,0:00:05.63,0:00:08.97,Default,,0,0,0,,<Мені үйреткен түрлі оқиғалар➡
Dialogue: 0,0:00:08.97,0:00:13.31,Default,,0,0,0,,Осы уақытқа дейін кездестіргендердің барлығына алғыс айтамын➡
Dialogue: 0,0:00:13.31,0:00:15.98,Default,,0,0,0,,Рахмет... Қалай ➡
Dialogue: 0,0:00:15.98,0:00:18.98,Default,,0,0,0,,Ұялғаным сонша, айта алмаймын> (Жарайды, президент) <Жарайды~>
Dialogue: 0,0:00:30.96,0:00:35.96,Default,,0,0,0,,♪
Dialogue: 0,0:00:35.96,0:00:37.97,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:00:37.97,0:00:43.64,Default,,0,0,0,,Сіз бүгін барлық оқуыңызды сәтті аяқтаған түлектерсіз.
Dialogue: 0,0:00:43.64,0:00:49.31,Default,,0,0,0,,Біз дәстүрлі мектебімізден екенімізді мақтан тұтамыз және әрқашан болашаққа ұмтыламыз.
Dialogue: 0,0:00:49.31,0:00:54.25,Default,,0,0,0,,Үлкен қанаттарын қағады деп сенемін.
Dialogue: 0,0:00:54.25,0:01:00.92,Default,,0,0,0,,(қоңырау)
Dialogue: 0,0:01:00.92,0:01:03.26,Default,,0,0,0,,Әй, Алиса-сенпай осында!
Dialogue: 0,0:01:03.26,0:01:06.26,Default,,0,0,0,,Біз не істеуіміз керек? сен айтасың
Dialogue: 0,0:01:06.26,0:01:08.60,Default,,0,0,0,,Иә! мен... мен?
Dialogue: 0,0:01:08.60,0:01:12.60,Default,,0,0,0,,А, Алиса-сенпай?
Dialogue: 0,0:01:12.60,0:01:14.60,Default,,0,0,0,,Сізді мектеп бітіруіңізбен құттықтаймыз
Dialogue: 0,0:01:14.60,0:01:16.61,Default,,0,0,0,,Сондай-ақ... қарсы болмасаңыз.
Dialogue: 0,0:01:16.61,0:01:19.61,Default,,0,0,0,,Сіздің формаңыздың екінші түймешігін аламын ба?
Dialogue: 0,0:01:26.28,0:01:28.28,Default,,0,0,0,,Иә
Dialogue: 0,0:01:28.28,0:01:31.29,Default,,0,0,0,,А, рахмет, мен жасадым!
Dialogue: 0,0:01:31.29,0:01:34.62,Default,,0,0,0,,Сізге жақсы (сынып оқушылары) Уау...
Dialogue: 0,0:01:34.62,0:01:38.29,Default,,0,0,0,,Мен де! (Сынып жетекшісі) Негізі мен де әрқашан жанкүйер болдым.
Dialogue: 0,0:01:38.29,0:01:40.30,Default,,0,0,0,,Ым... (сыныптан төмен) А, мен де қумын!
Dialogue: 0,0:01:40.30,0:01:43.60,Default,,0,0,0,,Бұл... Иә! (Сынып оқушылары) Алиса-сенпай!
Dialogue: 0,0:01:46.30,0:01:49.30,Default,,0,0,0,,Бұл үлкен тосынсый.
Dialogue: 0,0:01:49.30,0:01:52.57,Default,,0,0,0,,Ах... Мм.
Dialogue: 0,0:01:52.57,0:01:56.58,Default,,0,0,0,,Хэхе~ (Президент Ария) Пупуй (Акури) Хэхехе
Dialogue: 0,0:01:56.58,0:02:01.25,Default,,0,0,0,,Мен саған бүгін мектеп бітіру рәсімі екенін айтқан жоқпын, солай ма?
Dialogue: 0,0:02:01.25,0:02:05.59,Default,,0,0,0,,Хмф, бір мектептің түлектерін кемітпеңіз.
Dialogue: 0,0:02:05.59,0:02:08.59,Default,,0,0,0,,Сені мектеп бітіруіңмен құттықтаймыз, Алиса Чан
Dialogue: 0,0:02:11.59,0:02:13.60,Default,,0,0,0,,Фу…
Dialogue: 0,0:02:13.60,0:02:15.93,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:02:15.93,0:02:18.60,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:02:18.60,0:02:21.94,Default,,0,0,0,,<Ай-чан ақыры осы жазда➡
Dialogue: 0,0:02:21.94,0:02:26.61,Default,,0,0,0,,Алиса орта мектепті қуана бітірді＞
Dialogue: 0,0:02:26.61,0:02:46.63,Default,,0,0,0,,♬～
Dialogue: 0,0:02:46.63,0:03:06.58,Default,,0,0,0,,♬～
Dialogue: 0,0:03:06.58,0:03:18.59,Default,,0,0,0,,♬～
Dialogue: 0,0:03:18.59,0:03:20.60,Default,,0,0,0,,Қалыпты жағдайға оралсам ше?
Dialogue: 0,0:03:20.60,0:03:22.93,Default,,0,0,0,,Мен де соны ойлап отырмын.
Dialogue: 0,0:03:22.93,0:03:27.94,Default,,0,0,0,,Бұл менің орта мектептегі соңғы сыныбым, сондықтан оны орындаудан басқа амалым жоқ.
Dialogue: 0,0:03:27.94,0:03:30.94,Default,,0,0,0,,Фуфуфу аа...
Dialogue: 0,0:03:30.94,0:03:33.28,Default,,0,0,0,,Ах, Афина-сан.
Dialogue: 0,0:03:33.28,0:03:50.23,Default,,0,0,0,,♬～
Dialogue: 0,0:03:50.23,0:03:54.23,Default,,0,0,0,,Кіші, сен төңкеріліп жүре алмадың.
Dialogue: 0,0:03:54.23,0:03:57.90,Default,,0,0,0,,Сонда бұл үлкен проблема емес.
Dialogue: 0,0:03:57.90,0:04:01.90,Default,,0,0,0,,Афина-сенпай жүргенде уақыт тоқтайды.
Dialogue: 0,0:04:01.90,0:04:04.91,Default,,0,0,0,,Иә? Хехе
Dialogue: 0,0:04:04.91,0:04:08.91,Default,,0,0,0,,♬～
Dialogue: 0,0:04:12.91,0:04:15.92,Default,,0,0,0,,Өтіп бара жатқан гондола!
Dialogue: 0,0:04:15.92,0:04:18.25,Default,,0,0,0,,О~ (Президент Ария) Пу~и
Dialogue: 0,0:04:18.25,0:04:22.59,Default,,0,0,0,,Қатты дауыс! Джуниор-чан, көңіл көтер!
Dialogue: 0,0:04:22.59,0:04:25.26,Default,,0,0,0,,Иә, толы.
Dialogue: 0,0:04:25.26,0:04:28.26,Default,,0,0,0,,Осы уақытқа дейін мектеп алған уақыт
Dialogue: 0,0:04:28.26,0:04:31.93,Default,,0,0,0,,Бұдан былай сіз үлкендермен бірге үнемі жаттығу жасай аласыз.
Dialogue: 0,0:04:31.93,0:04:33.94,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:04:33.94,0:04:37.24,Default,,0,0,0,,Бұл мені шынымен бақытты етеді.
Dialogue: 0,0:04:38.27,0:04:41.61,Default,,0,0,0,,Хехе... Жарайды!
Dialogue: 0,0:04:41.61,0:04:44.28,Default,,0,0,0,,Бүгін тағы да Приманы көздеп алайық! Барайық!
Dialogue: 0,0:04:44.28,0:04:46.95,Default,,0,0,0,,О (Ария президенті) Пуи Акари Ария президенті
Dialogue: 0,0:04:46.95,0:04:50.22,Default,,0,0,0,,Біріншіден, сөйлеуге машықтандыру! Ха ха (Президент Ария) Пупуй
Dialogue: 0,0:04:50.22,0:04:53.52,Default,,0,0,0,,Өтіп бара жатқан гондола! (Президент Ария) Пуиню Пуиню~!
Dialogue: 0,0:04:54.89,0:04:56.89,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:56.89,0:05:00.23,Default,,0,0,0,,Сонымен, Алиса Чан, мектеп бітір.
Dialogue: 0,0:05:00.23,0:05:02.90,Default,,0,0,0,,Дәл қазір көңіл-күйіңіз көтеріңкі, солай емес пе?
Dialogue: 0,0:05:02.90,0:05:07.24,Default,,0,0,0,,Иә, мен қазір өзімді үлкен және салқын сезінемін.
Dialogue: 0,0:05:07.24,0:05:09.57,Default,,0,0,0,,Маған да біртүрлі.
Dialogue: 0,0:05:09.57,0:05:12.57,Default,,0,0,0,,Қазір не істесем де нәтиже беретін сияқты...
Dialogue: 0,0:05:12.57,0:05:15.91,Default,,0,0,0,,Ал, жақсы, жақсы
Dialogue: 0,0:05:15.91,0:05:19.25,Default,,0,0,0,,Ал, жақсы...
Dialogue: 0,0:05:19.25,0:05:22.92,Default,,0,0,0,,Ал, Президент Иә Иә (Ал, Президент) Жарайды
Dialogue: 0,0:05:22.92,0:05:27.26,Default,,0,0,0,,Маған бер, маған бер (Маа, президент) Маама, Маама
Dialogue: 0,0:05:27.26,0:05:29.59,Default,,0,0,0,,Жақсы, жақсы
Dialogue: 0,0:05:29.59,0:05:31.59,Default,,0,0,0,,Иә (Жақсы, Президент) Жақсы.
Dialogue: 0,0:05:31.59,0:05:33.60,Default,,0,0,0,,Хмм, жақсы!
Dialogue: 0,0:05:33.60,0:05:36.93,Default,,0,0,0,,Ал, жақсы... жақсы! Ах
Dialogue: 0,0:05:36.93,0:05:40.24,Default,,0,0,0,,Сәлем Алиса, иә?
Dialogue: 0,0:05:41.60,0:05:45.61,Default,,0,0,0,,Ертең пикникке барамыз ба?
Dialogue: 0,0:05:45.61,0:05:47.61,Default,,0,0,0,,А...
Dialogue: 0,0:05:50.55,0:05:54.88,Default,,0,0,0,,Бұл жолы, сөзсіз, хехе
Dialogue: 0,0:05:54.88,0:05:56.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:58.22,0:06:00.22,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:06:00.22,0:06:09.23,Default,,0,0,0,,♬～
Dialogue: 0,0:06:09.23,0:06:11.23,Default,,0,0,0,,Афина Сенпай
Dialogue: 0,0:06:11.23,0:06:14.94,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:17.57,0:06:19.98,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:20.91,0:06:22.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:24.25,0:06:27.92,Default,,0,0,0,,Түскі ас қорабы да дайын.
Dialogue: 0,0:06:27.92,0:06:31.25,Default,,0,0,0,,Бұл үлкен және мінсіз, Афина-сенпай.
Dialogue: 0,0:06:31.25,0:06:33.26,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:06:37.93,0:06:41.26,Default,,0,0,0,,Иә, Алиса, иә?
Dialogue: 0,0:06:41.26,0:06:44.27,Default,,0,0,0,,Бүгін мен тапсырыс берушімін.
Dialogue: 0,0:06:44.27,0:06:48.27,Default,,0,0,0,,Сіз Алисаның бір күн бойы Undine рөлін ойнағанын қалайсыз ба?
Dialogue: 0,0:06:48.27,0:06:50.27,Default,,0,0,0,,А...
Dialogue: 0,0:06:55.88,0:06:59.88,Default,,0,0,0,,Бұл қызықты идея. Қабыл алайық.
Dialogue: 0,0:06:59.88,0:07:04.89,Default,,0,0,0,,Олай болса, Афина-сенпай бұдан былай менің маңызды клиентім.
Dialogue: 0,0:07:04.89,0:07:07.22,Default,,0,0,0,,Иә, мен де танысқаныма қуаныштымын.
Dialogue: 0,0:07:07.22,0:07:09.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:09.89,0:07:13.50,Default,,0,0,0,,Тұтынушы, маған көмектесіңізші.
Dialogue: 0,0:07:19.23,0:07:21.90,Default,,0,0,0,,Тұтынушы? иә?
Dialogue: 0,0:07:21.90,0:07:23.91,Default,,0,0,0,,А... иә
Dialogue: 0,0:07:26.24,0:07:28.24,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:07:28.24,0:07:32.25,Default,,0,0,0,,Алиса, сен күлімдеуді жақсылап алдың.
Dialogue: 0,0:07:32.25,0:07:36.58,Default,,0,0,0,,Тұтынушы: Кешіріңіз, бұл біздің бірінші кездесуіміз бе?
Dialogue: 0,0:07:36.58,0:07:40.92,Default,,0,0,0,,Ах, кешіріңіз, хехе...
Dialogue: 0,0:07:40.92,0:07:46.59,Default,,0,0,0,,Тұтынушы Шындығында, маған ең жақсы күлкі сыйлайтын аға буыным бар.
Dialogue: 0,0:07:46.59,0:07:50.20,Default,,0,0,0,,Біз күнде бірге жаттығу жасаймыз.
Dialogue: 0,0:07:50.20,0:08:06.21,Default,,0,0,0,,♬～
Dialogue: 0,0:08:06.21,0:08:09.55,Default,,0,0,0,,Бұл ені 48 метр болатын Үлкен канал.
Dialogue: 0,0:08:09.55,0:08:12.55,Default,,0,0,0,,Риалто көпірі бір аркамен созылған
Dialogue: 0,0:08:12.55,0:08:15.89,Default,,0,0,0,,Бұл аймақ Әулие Марк алаңынан ерекшеленеді.
Dialogue: 0,0:08:15.89,0:08:20.23,Default,,0,0,0,,Дүкендердің, базарлардың, барлардың және резиденциялардың қоспасы
Dialogue: 0,0:08:20.23,0:08:24.57,Default,,0,0,0,,Нео-Венециядағы адамдардың шынайы өмірін сезіне аласыз
Dialogue: 0,0:08:24.57,0:08:28.24,Default,,0,0,0,,Қаланың орталығы деуге болатын тағы бір жер.
Dialogue: 0,0:08:28.24,0:08:30.57,Default,,0,0,0,,Undine туристік ақпараты
Dialogue: 0,0:08:30.57,0:08:34.24,Default,,0,0,0,,Бұл өте түсінікті және түсінуге оңай.
Dialogue: 0,0:08:34.24,0:08:40.25,Default,,0,0,0,,Күн сайын маған бірдеңе істеуге тыйым салатын қатал аға бар, жаттығу кезінде мені қатты итермелейді.
Dialogue: 0,0:08:40.25,0:08:42.25,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:08:43.25,0:08:47.59,Default,,0,0,0,,Енді, тұтынушы, енді қайда баруымыз керек?
Dialogue: 0,0:08:47.59,0:08:50.53,Default,,0,0,0,,Егер сізде көрікті жерлер болса
Dialogue: 0,0:08:50.53,0:08:53.23,Default,,0,0,0,,Бізбен байланысыңыз.
Dialogue: 0,0:08:54.20,0:08:56.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:56.87,0:09:00.54,Default,,0,0,0,,Хехе, дұрыс.
Dialogue: 0,0:09:00.54,0:09:03.87,Default,,0,0,0,,Олай болса, сөзіңізді қабыл алыңыз...
Dialogue: 0,0:09:03.87,0:09:11.88,Default,,0,0,0,,♬～
Dialogue: 0,0:09:11.88,0:09:16.22,Default,,0,0,0,,Осы жерден ауыл біраз уақытқа дейін жалғасады.
Dialogue: 0,0:09:16.22,0:09:20.22,Default,,0,0,0,,Порт қалашығына тән белгілі декорациядан айырмашылығы
Dialogue: 0,0:09:20.22,0:09:23.56,Default,,0,0,0,,Нео Венецияны тағы бір рет тамашалаңыз
Dialogue: 0,0:09:23.56,0:09:26.56,Default,,0,0,0,,Иә (жақсы, президент) жақсы.
Dialogue: 0,0:09:31.23,0:09:33.23,Default,,0,0,0,,⚟(Бу ысқырығы) Иә?
Dialogue: 0,0:09:33.23,0:09:35.57,Default,,0,0,0,,⚟(Бу ысқырығы)
Dialogue: 0,0:09:35.57,0:09:37.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:37.91,0:09:50.92,Default,,0,0,0,,♬～
Dialogue: 0,0:09:50.92,0:09:54.92,Default,,0,0,0,,Сәлем (әйел) Кешіріңіз, сэр.
Dialogue: 0,0:09:54.92,0:09:57.23,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:10:00.60,0:10:02.93,Default,,0,0,0,,Циао (әйел) Бонгиорно
Dialogue: 0,0:10:02.93,0:10:05.60,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:10:05.60,0:10:08.27,Default,,0,0,0,,Көңілді Тұтынушыға ұқсайды
Dialogue: 0,0:10:08.27,0:10:10.94,Default,,0,0,0,,Иә, өте
Dialogue: 0,0:10:12.97,0:10:17.28,Default,,0,0,0,,(Сиырдың улауы)
Dialogue: 0,0:10:22.65,0:10:25.99,Default,,0,0,0,,Тұтынушы Шай алғыңыз келе ме?
Dialogue: 0,0:10:25.99,0:10:28.99,Default,,0,0,0,,Рахмет, жеткілікті.
Dialogue: 0,0:10:28.99,0:10:30.99,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:10:30.99,0:10:35.00,Default,,0,0,0,,Бүгін пикник үшін тамаша күн.
Dialogue: 0,0:10:35.00,0:10:50.28,Default,,0,0,0,,♬～
Dialogue: 0,0:10:50.28,0:10:53.28,Default,,0,0,0,,Ундайн мырза, иә?
Dialogue: 0,0:10:53.28,0:10:56.95,Default,,0,0,0,,Енді барамыз ба? Иә.
Dialogue: 0,0:10:56.95,0:11:08.63,Default,,0,0,0,,♬～
Dialogue: 0,0:11:08.63,0:11:11.97,Default,,0,0,0,,Жақсы! Хехе...
Dialogue: 0,0:11:11.97,0:11:16.64,Default,,0,0,0,,♬～
Dialogue: 0,0:11:16.64,0:11:19.64,Default,,0,0,0,,Сәлеметсіз бе, ағай (әкімші)?
Dialogue: 0,0:11:19.64,0:11:21.64,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:11:21.64,0:11:25.65,Default,,0,0,0,,Эй, мен енді түсейін деп жатырмын.
Dialogue: 0,0:11:25.65,0:11:28.65,Default,,0,0,0,,Тағы біраз күтіңіз Иә.
Dialogue: 0,0:11:28.65,0:11:46.94,Default,,0,0,0,,♬～
Dialogue: 0,0:11:46.94,0:11:48.94,Default,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:11:48.94,0:11:50.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:55.61,0:11:58.61,Default,,0,0,0,,Не болды? Мистер Ундин
Dialogue: 0,0:11:58.61,0:12:02.95,Default,,0,0,0,,Мен соншалықты сенімсіз болып көрінемін бе?
Dialogue: 0,0:12:02.95,0:12:06.25,Default,,0,0,0,,Жоқ, бұл өте сенімді.
Dialogue: 0,0:12:07.29,0:12:12.63,Default,,0,0,0,,Хехе... Бүгінгі еңбегіңіз үшін рахмет, Алиса Чан.
Dialogue: 0,0:12:12.63,0:12:15.30,Default,,0,0,0,,Иә? Бұл су көтергіш
Dialogue: 0,0:12:15.30,0:12:20.64,Default,,0,0,0,,Шыңға жеткенше, жұмыс режимін ұмытып, демалыңыз.
Dialogue: 0,0:12:20.64,0:12:23.97,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:12:23.97,0:12:28.98,Default,,0,0,0,,Бұл таңқаларлық, Алиса Чан, сіз қазір бәрін жасай аласыз.
Dialogue: 0,0:12:28.98,0:12:30.98,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:30.98,0:12:36.32,Default,,0,0,0,,Ескек есу және туристік ақпарат сияқты нәрселер менің аға буын өкілдеріммен жаттығуымның нәтижесі екені рас.
Dialogue: 0,0:12:36.32,0:12:40.26,Default,,0,0,0,,Менің ойымша, мен өзімді өте керемет болдым ...
Dialogue: 0,0:12:40.26,0:12:42.26,Default,,0,0,0,,Не?
Dialogue: 0,0:12:42.26,0:12:45.93,Default,,0,0,0,,Шынымды айтсам, Canzone...
Dialogue: 0,0:12:45.93,0:12:49.93,Default,,0,0,0,,Бастау үшін менің дауысым төмен.
Dialogue: 0,0:12:49.93,0:12:52.93,Default,,0,0,0,,Менің де ән айтуым онша жақсы емес.
Dialogue: 0,0:12:52.93,0:12:58.61,Default,,0,0,0,,Даусыңыздың дұрыс дыбыс деңгейінде екеніне сенімдісіз бе? Сіз күйсіз емессіз бе?
Dialogue: 0,0:12:58.61,0:13:02.28,Default,,0,0,0,,Мен жақсы ән айтуды неғұрлым көп ойласам, соғұрлым көп болады
Dialogue: 0,0:13:02.28,0:13:06.58,Default,,0,0,0,,Менің басым толығымен ағады.
Dialogue: 0,0:13:08.95,0:13:12.62,Default,,0,0,0,,Ал, хехе...
Dialogue: 0,0:13:12.62,0:13:15.96,Default,,0,0,0,,Адамның өзі қиын деп айтатын әндері
Dialogue: 0,0:13:15.96,0:13:19.29,Default,,0,0,0,,Тыңдаушыларда да азапты сезінемін.
Dialogue: 0,0:13:19.29,0:13:21.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:21.63,0:13:25.63,Default,,0,0,0,,Әрине, ән айту керек, бірақ
Dialogue: 0,0:13:25.63,0:13:31.31,Default,,0,0,0,,Ең бастысы мен ән айтқанды жақсы көремін.
Dialogue: 0,0:13:31.31,0:13:35.31,Default,,0,0,0,,Мен ән айтқанды жақсы көремін...
Dialogue: 0,0:13:37.31,0:13:39.31,Default,,0,0,0,,Алиса әні
Dialogue: 0,0:13:39.31,0:13:42.25,Default,,0,0,0,,Алиса-чанның өзі маған ғашық болуы керек.
Dialogue: 0,0:13:42.25,0:13:45.59,Default,,0,0,0,,Саған тағы кім ғашық болады?
Dialogue: 0,0:13:45.59,0:14:01.27,Default,,0,0,0,,♬～
Dialogue: 0,0:14:01.27,0:14:03.60,Default,,0,0,0,,Афина Сенпай...
Dialogue: 0,0:14:03.60,0:14:05.94,Default,,0,0,0,,Ундин мырза
Dialogue: 0,0:14:05.94,0:14:08.94,Default,,0,0,0,,Баратын жер алдыңызда.
Dialogue: 0,0:14:10.28,0:14:12.28,Default,,0,0,0,,Иә
Dialogue: 0,0:14:12.28,0:14:20.29,Default,,0,0,0,,♬～
Dialogue: 0,0:14:20.29,0:14:22.62,Default,,0,0,0,,Ха, уау...
Dialogue: 0,0:14:22.62,0:14:31.30,Default,,0,0,0,,♬～
Dialogue: 0,0:14:31.30,0:14:35.30,Default,,0,0,0,,Сіз білесіз бе? Мистер Ундин
Dialogue: 0,0:14:35.30,0:14:38.97,Default,,0,0,0,,Бұл планетаның бетінде су асып кетеді
Dialogue: 0,0:14:38.97,0:14:42.24,Default,,0,0,0,,Aqua деп аталмас бұрын
Dialogue: 0,0:14:42.24,0:14:45.25,Default,,0,0,0,,Бұл дүние қызғылт сары болды.
Dialogue: 0,0:14:45.25,0:14:48.25,Default,,0,0,0,,Мен ол туралы естідім
Dialogue: 0,0:14:48.25,0:14:50.25,Default,,0,0,0,,Мүмкін сондықтан болар
Dialogue: 0,0:14:50.25,0:14:53.92,Default,,0,0,0,,Бұл дүниенің сарғыш түске боялған кезі.
Dialogue: 0,0:14:53.92,0:14:56.92,Default,,0,0,0,,Аквада тұратын біздер үшін
Dialogue: 0,0:14:56.92,0:15:00.93,Default,,0,0,0,,Өте қымбатты және сағыныш
Dialogue: 0,0:15:00.93,0:15:06.60,Default,,0,0,0,,Біздің мәңгілігіміз осында сияқты.
Dialogue: 0,0:15:06.60,0:15:26.62,Default,,0,0,0,,♬～
Dialogue: 0,0:15:26.62,0:15:32.96,Default,,0,0,0,,♬～
Dialogue: 0,0:15:32.96,0:15:36.56,Default,,0,0,0,,<Мм... сонда біреу бар ма? ＞
Dialogue: 0,0:15:37.63,0:15:42.04,Default,,0,0,0,,<Бұл Ақари-сенпай мен Айка-сенпай...>
Dialogue: 0,0:15:44.57,0:15:48.58,Default,,0,0,0,,<Ал бұрынғы су лифтіндегі қартпен➡
Dialogue: 0,0:15:48.58,0:15:53.28,Default,,0,0,0,,Арттағы адамдар - компаниядағы үлкен жігіттер және гондола қауымдастығының адамдары＞
Dialogue: 0,0:15:57.92,0:16:00.22,Default,,0,0,0,,<Жер бетінде бұл не...>
Dialogue: 0,0:16:05.93,0:16:10.26,Default,,0,0,0,,Бүгінгі күн үшін рахмет, Ундине-сан.
Dialogue: 0,0:16:10.26,0:16:14.27,Default,,0,0,0,,Соңғы бір әнді ойнауыңызды өтінемін бе?
Dialogue: 0,0:16:14.27,0:16:18.27,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:16:23.28,0:16:25.58,Default,,0,0,0,,Ундин мырза
Dialogue: 0,0:16:28.95,0:16:32.62,Default,,0,0,0,,Тұтынушы бұл акваға өз атын береді.
Dialogue: 0,0:16:32.62,0:16:35.62,Default,,0,0,0,,Сіз үш үлкен су перілерін білесіз бе?
Dialogue: 0,0:16:35.62,0:16:37.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:39.63,0:16:44.23,Default,,0,0,0,,Негізі, мен осылай көрінсем де, солардың бірімін.
Dialogue: 0,0:16:44.23,0:16:48.57,Default,,0,0,0,,Мен Сиреннің нөмірі бірінші шәкіртімін.
Dialogue: 0,0:16:48.57,0:16:50.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:57.91,0:17:06.25,Default,,0,0,0,,♪ Весперугио
Dialogue: 0,0:17:06.25,0:17:14.60,Default,,0,0,0,,♪ Флуас эн ондатей
Dialogue: 0,0:17:14.60,0:17:23.60,Default,,0,0,0,,♪ Эстас Киль Ла Канте
Dialogue: 0,0:17:23.60,0:17:34.32,Default,,0,0,0,,♪ Вера канто де фелисио
Dialogue: 0,0:17:37.62,0:17:46.56,Default,,0,0,0,,♪ Chu Vi Remarquis ендірілген
Dialogue: 0,0:17:46.56,0:17:54.90,Default,,0,0,0,,♪ Портанта Фабрезцо
Dialogue: 0,0:17:54.90,0:18:02.24,Default,,0,0,0,,♪ Супер Ла Мало Фругас
Dialogue: 0,0:18:02.24,0:18:12.95,Default,,0,0,0,,♪ Эли Флугус Кун Амо
Dialogue: 0,0:18:15.59,0:18:23.93,Default,,0,0,0,,♪ Оранджа виолончель
Dialogue: 0,0:18:23.93,0:18:32.61,Default,,0,0,0,,♪ Эмозиас Миа Спиритон
Dialogue: 0,0:18:32.61,0:18:45.22,Default,,0,0,0,,♪ Стеро де Респеро Стеро Лумис Этерне
Dialogue: 0,0:18:45.22,0:18:53.89,Default,,0,0,0,,♪ Лумис Этерн
Dialogue: 0,0:18:53.89,0:18:58.90,Default,,0,0,0,,♬～
Dialogue: 0,0:18:58.90,0:19:01.90,Default,,0,0,0,,Ааа аа...!
Dialogue: 0,0:19:03.24,0:19:08.24,Default,,0,0,0,,Pupupupupui~
Dialogue: 0,0:19:08.24,0:19:11.25,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:19:11.25,0:19:17.59,Default,,0,0,0,,Тұтынушы Мен ән айтуда ешқашан жақсы болған емеспін, бірақ
Dialogue: 0,0:19:17.59,0:19:22.26,Default,,0,0,0,,Бала кезімде ән айтқанды жақсы көретінмін.
Dialogue: 0,0:19:22.26,0:19:25.59,Default,,0,0,0,,Тұтынушының сөздері сіздің сол кездегі сезіміңізді көрсетеді
Dialogue: 0,0:19:25.59,0:19:28.30,Default,,0,0,0,,Бұл есіме түсті
Dialogue: 0,0:19:33.93,0:19:36.60,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:19:36.60,0:19:45.95,Default,,0,0,0,,♬～
Dialogue: 0,0:19:45.95,0:19:47.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:47.95,0:19:57.29,Default,,0,0,0,,♬～
Dialogue: 0,0:19:57.29,0:19:59.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:00.96,0:20:03.30,Default,,0,0,0,,Не? Компания бұл
Dialogue: 0,0:20:03.30,0:20:07.64,Default,,0,0,0,,Мен сенің орта мектепті бітірген күніңді күттім.
Dialogue: 0,0:20:07.64,0:20:10.30,Default,,0,0,0,,Рульді басқару техникасы тамаша
Dialogue: 0,0:20:10.30,0:20:13.97,Default,,0,0,0,,Туристік ақпарат және тұтынушыларға қызмет көрсету мәселелері
Dialogue: 0,0:20:13.97,0:20:16.64,Default,,0,0,0,,Сондай-ақ Canzone
Dialogue: 0,0:20:16.64,0:20:18.65,Default,,0,0,0,,Бүгінгі емтиханды жақсы тапсырдың.
Dialogue: 0,0:20:18.65,0:20:22.35,Default,,0,0,0,,Керемет эволюцияның дәлелдерін көрсету
Dialogue: 0,0:20:24.99,0:20:28.29,Default,,0,0,0,,Афина-сенпай, бұл...
Dialogue: 0,0:20:29.99,0:20:31.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:31.99,0:20:34.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:34.33,0:20:39.93,Default,,0,0,0,,Сізге, ұшқыштық индустрияның келесі буыны
Dialogue: 0,0:20:39.93,0:20:46.27,Default,,0,0,0,,Гондола қауымдастығының ерекше беделі және үлкен үміттері бар.
Dialogue: 0,0:20:46.27,0:20:50.28,Default,,0,0,0,,Біз бұрын-соңды болмаған шешім қабылдадық.
Dialogue: 0,0:20:50.28,0:20:52.28,Default,,0,0,0,,Ах... (Президент Ария) Пупуй!?
Dialogue: 0,0:20:52.28,0:20:54.28,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:20:57.62,0:21:00.62,Default,,0,0,0,,Құттықтаймыз Алиса Чан
Dialogue: 0,0:21:02.29,0:21:06.63,Default,,0,0,0,,Апельсин ханшайымы жоқ
Dialogue: 0,0:21:06.63,0:21:11.03,Default,,0,0,0,,Бүгіннен бастап сіз Prima Undineсіз.
Dialogue: 0,0:21:12.30,0:21:16.30,Default,,0,0,0,,Апельсин… Ханшайым
Dialogue: 0,0:21:16.30,0:21:20.01,Default,,0,0,0,,Бұл... көше атауы...
Dialogue: 0,0:21:20.98,0:21:23.58,Default,,0,0,0,,Иә! (Президент Ария) Пуи~⁉
Dialogue: 0,0:21:26.65,0:21:30.35,Default,,0,0,0,,Ал, хехе
Dialogue: 0,0:21:33.32,0:21:35.99,Default,,0,0,0,,Афина Сенпай
Dialogue: 0,0:21:35.99,0:21:37.99,Default,,0,0,0,,Иә
Dialogue: 0,0:21:37.99,0:21:40.93,Default,,0,0,0,,Афина Сенпай...
Dialogue: 0,0:21:40.93,0:21:43.23,Default,,0,0,0,,Алиса-чан
Dialogue: 0,0:21:45.27,0:21:51.27,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:21:54.61,0:21:56.61,Default,,0,0,0,,Алиса!
Dialogue: 0,0:21:57.61,0:21:59.61,Default,,0,0,0,,Үлкендер...
Dialogue: 0,0:21:59.61,0:22:01.95,Default,,0,0,0,,Алиса! Кіші!
Dialogue: 0,0:22:01.95,0:22:04.29,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,0:22:04.29,0:22:06.29,Default,,0,0,0,,Ал...
Dialogue: 0,0:22:06.29,0:22:08.29,Default,,0,0,0,,Құттықтаймыз кіші
Dialogue: 0,0:22:08.29,0:22:11.29,Default,,0,0,0,,Сенпай... (Президент Ария) Пуи~
Dialogue: 0,0:22:12.63,0:22:14.96,Default,,0,0,0,,Маған көмектес~! Гү…
Dialogue: 0,0:22:14.96,0:22:18.57,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:22:23.64,0:22:25.64,Default,,0,0,0,,Ах...!
Dialogue: 0,0:22:25.64,0:22:28.64,Default,,0,0,0,,<Ай-чан Акваға ойылған➡
Dialogue: 0,0:22:28.64,0:22:30.64,Default,,0,0,0,,Undine-дің жарқын тарихы➡
Dialogue: 0,0:22:30.64,0:22:33.65,Default,,0,0,0,,Прима дәрежесіне бірінші рет көтерілу➡
Dialogue: 0,0:22:33.65,0:22:36.65,Default,,0,0,0,,Жаңа аңыз дүниеге келді＞
Dialogue: 0,0:22:36.65,0:22:41.26,Default,,0,0,0,,<Алис-сан, сен шынымен де кереметсің. Мен сізге қайран қаламын.>
Dialogue: 0,0:22:41.26,0:22:44.59,Default,,0,0,0,,<Құттықтаймыз Алиса>
Dialogue: 0,0:22:44.59,0:23:04.61,Default,,0,0,0,,♬～
Dialogue: 0,0:23:04.61,0:23:24.63,Default,,0,0,0,,♬～
Dialogue: 0,0:23:24.63,0:23:44.59,Default,,0,0,0,,♬～
Dialogue: 0,0:23:44.59,0:24:04.61,Default,,0,0,0,,♬～
Dialogue: 0,0:24:04.61,0:24:13.95,Default,,0,0,0,,♬～
Dialogue: 0,0:24:15.98,0:24:19.32,Default,,0,0,0,,<Алиса-чан - Прима...> <Менде қазірдің өзінде көп ескертулер бар>
Dialogue: 0,0:24:19.32,0:24:21.32,Default,,0,0,0,,<Мен қатты қобалжыдым>
Dialogue: 0,0:24:21.32,0:24:23.99,Default,,0,0,0,,＜Осындай уақытта демалыңыз＞
Dialogue: 0,0:24:23.99,0:24:25.99,Default,,0,0,0,,<Келесі жолы...>
Dialogue: 0,0:24:26.99,0:24:29.00,Default,,0,0,0,,<Енді маған қолыңды бер>
Dialogue: 0,0:24:30.50,0:24:36.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory