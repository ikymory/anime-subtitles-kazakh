Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.30,0:00:03.97,Default,,0,0,0,,<Мен қайтадан сәтсіздікке ұшырадым>
Dialogue: 0,0:00:03.97,0:00:06.30,Default,,0,0,0,,<Алисия үшін қазірдің өзінде қиын.>
Dialogue: 0,0:00:06.30,0:00:08.64,Default,,0,0,0,,<Сіз ұрысып қалдыңыз ба? ＞ <Уф>
Dialogue: 0,0:00:08.64,0:00:11.31,Default,,0,0,0,,<Сосын ше? ＞ <“Ой, хэхэ”>
Dialogue: 0,0:00:11.31,0:00:13.31,Default,,0,0,0,,<Қандай тәтті>
Dialogue: 0,0:00:13.31,0:00:16.31,Default,,0,0,0,,<Бірақ бұл Алисия болса, ол: «Ой, хехе»>
Dialogue: 0,0:00:16.31,0:00:18.98,Default,,0,0,0,,＜Жоқ, бұл жай ғана "Ммммм"＞
Dialogue: 0,0:00:30.96,0:00:34.96,Default,,0,0,0,,(торғай жылайды)
Dialogue: 0,0:00:37.63,0:00:39.97,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:00:39.97,0:00:42.30,Default,,0,0,0,,Уау! (Президент Ария) Пуи?
Dialogue: 0,0:00:42.30,0:00:44.64,Default,,0,0,0,,Бұл үлкен құлпынай.
Dialogue: 0,0:00:44.64,0:00:47.31,Default,,0,0,0,,О, өте тәтті
Dialogue: 0,0:00:47.31,0:00:49.65,Default,,0,0,0,,Ағай, мынаны беріңізші.
Dialogue: 0,0:00:49.65,0:00:53.25,Default,,0,0,0,,Иә, өзгерту үшін рахмет.
Dialogue: 0,0:00:53.25,0:00:56.92,Default,,0,0,0,,Афина-сенпай, не сатып алғаныңды ұмыттың.
Dialogue: 0,0:00:56.92,0:01:00.26,Default,,0,0,0,,Акари Өзгерістерді өзгерту! А, жоқ.
Dialogue: 0,0:01:00.26,0:01:02.59,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:01:02.59,0:01:04.59,Default,,0,0,0,,Кешіріңіз, Айка-чан.
Dialogue: 0,0:01:04.59,0:01:07.60,Default,,0,0,0,,Неліктен Афина-сенпай үнемі осылай болады?
Dialogue: 0,0:01:07.60,0:01:09.93,Default,,0,0,0,,Әй, ағалар.
Dialogue: 0,0:01:09.93,0:01:11.93,Default,,0,0,0,,Сәлем Сәлем
Dialogue: 0,0:01:11.93,0:01:15.27,Default,,0,0,0,,Сәлем Алиса мен Афина.
Dialogue: 0,0:01:15.27,0:01:18.94,Default,,0,0,0,,Жарайды~ (Президент Ария) Уф! Pupui…
Dialogue: 0,0:01:18.94,0:01:24.28,Default,,0,0,0,,<Ах~ Акари-сан, анаң тағы ұрысты>
Dialogue: 0,0:01:24.28,0:01:29.28,Default,,0,0,0,,<Ай-чан, мен де Айка-чаннан көп ұрысамын>
Dialogue: 0,0:01:29.28,0:01:34.62,Default,,0,0,0,,<Білемін, сен мені қатты ойлайсың, бірақ...>
Dialogue: 0,0:01:34.62,0:01:38.63,Default,,0,0,0,,<Мүмкін болса, ұрысқың келмейді.>
Dialogue: 0,0:01:38.63,0:01:58.58,Default,,0,0,0,,♬～
Dialogue: 0,0:01:58.58,0:02:18.60,Default,,0,0,0,,♬～
Dialogue: 0,0:02:18.60,0:02:38.62,Default,,0,0,0,,♬～
Dialogue: 0,0:02:38.62,0:02:58.57,Default,,0,0,0,,♬～
Dialogue: 0,0:02:58.57,0:03:18.59,Default,,0,0,0,,♬～
Dialogue: 0,0:03:18.59,0:03:27.30,Default,,0,0,0,,♬～
Dialogue: 0,0:03:34.61,0:03:36.61,Default,,0,0,0,,Күшік пуи! Хахи?
Dialogue: 0,0:03:36.61,0:03:39.95,Default,,0,0,0,,Пуиню да... Президент Ария шығар?
Dialogue: 0,0:03:39.95,0:03:43.62,Default,,0,0,0,,Жаттығу Маған көмектесе аласыз ба? (Президент Ария) Пупу~и!
Dialogue: 0,0:03:43.62,0:03:45.95,Default,,0,0,0,,А...
Dialogue: 0,0:03:45.95,0:03:48.96,Default,,0,0,0,,Маған көмектесе аласыз ба?
Dialogue: 0,0:03:48.96,0:03:52.56,Default,,0,0,0,,Уф... бұл ауыр~
Dialogue: 0,0:03:52.56,0:03:56.90,Default,,0,0,0,,Түсіндім, Президент Ария, бұл бұлшықетті күшейту.
Dialogue: 0,0:03:56.90,0:03:59.57,Default,,0,0,0,,(шағала дыбысы)
Dialogue: 0,0:03:59.57,0:04:02.57,Default,,0,0,0,,Бұл көру өткірлігін динамикалық арттыру.
Dialogue: 0,0:04:02.57,0:04:07.24,Default,,0,0,0,,Динамикалық көру өткірлігі... Ария Президент, мен ұйықтап қалдым.
Dialogue: 0,0:04:07.24,0:04:09.24,Default,,0,0,0,,Бір күн бұрын және кейін...
Dialogue: 0,0:04:09.24,0:04:11.58,Default,,0,0,0,,Бұл тепе-теңдікті жақсарту.
Dialogue: 0,0:04:11.58,0:04:13.92,Default,,0,0,0,,Бұл Акари, ойынға тыйым салынған!
Dialogue: 0,0:04:13.92,0:04:16.25,Default,,0,0,0,,Иә, бұл сізсіз.
Dialogue: 0,0:04:16.25,0:04:20.26,Default,,0,0,0,,Дәл осылай, сіз бірден жаттығудан өте қызық боласыз.
Dialogue: 0,0:04:20.26,0:04:25.26,Default,,0,0,0,,Олай жасасаң, Алисия саған ұрысады~
Dialogue: 0,0:04:25.26,0:04:27.93,Default,,0,0,0,,А... иә? Джуниор-чан
Dialogue: 0,0:04:27.93,0:04:31.60,Default,,0,0,0,,Жарайды... дұрыс, кешіріңіз.
Dialogue: 0,0:04:31.60,0:04:33.60,Default,,0,0,0,,Ұрысу...
Dialogue: 0,0:04:36.27,0:04:38.61,Default,,0,0,0,,Рефлексия! Рефлексия!
Dialogue: 0,0:04:38.61,0:04:40.94,Default,,0,0,0,,Әлгі Акари-сенпай
Dialogue: 0,0:04:40.94,0:04:44.28,Default,,0,0,0,,Алисияға қалай ұрысасың?
Dialogue: 0,0:04:44.28,0:04:47.62,Default,,0,0,0,,ше? Ха~ Сәлем~
Dialogue: 0,0:04:47.62,0:04:50.89,Default,,0,0,0,,Ха~ Сәлем~
Dialogue: 0,0:04:50.89,0:04:55.56,Default,,0,0,0,,Ватахи: Алисия маған ұрысты
Dialogue: 0,0:04:55.56,0:04:58.56,Default,,0,0,0,,Мүмкін емес~ Хахи
Dialogue: 0,0:04:58.56,0:05:00.56,Default,,0,0,0,,Ньянто⁉ күрсініп...
Dialogue: 0,0:05:00.56,0:05:04.23,Default,,0,0,0,,Бұрын-соңды болмаған ба? Иә
Dialogue: 0,0:05:04.23,0:05:08.57,Default,,0,0,0,,Ойлап қарасам, мен сенің ашуланғаныңды көрмедім деп ойлаймын.
Dialogue: 0,0:05:08.57,0:05:11.57,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:11.57,0:05:14.91,Default,,0,0,0,,Алисияның саған ұрысуы мүмкін емес.
Dialogue: 0,0:05:14.91,0:05:17.91,Default,,0,0,0,,Ашуланбаңыз.
Dialogue: 0,0:05:17.91,0:05:20.25,Default,,0,0,0,,Өйткені бұл Алисия.
Dialogue: 0,0:05:20.25,0:05:24.25,Default,,0,0,0,,Жерге түскен су пері Алисия күткендей.
Dialogue: 0,0:05:24.25,0:05:26.59,Default,,0,0,0,,Мисс Перфект!
Dialogue: 0,0:05:26.59,0:05:28.92,Default,,0,0,0,,Аа, бірақ қазір ойласам
Dialogue: 0,0:05:28.92,0:05:31.59,Default,,0,0,0,,Афина Алисаға ұрысып жатыр.
Dialogue: 0,0:05:31.59,0:05:33.93,Default,,0,0,0,,Мен оны бұрын ешқашан көрген емеспін.
Dialogue: 0,0:05:33.93,0:05:35.93,Default,,0,0,0,,Әрине, бұл өте үлкен.
Dialogue: 0,0:05:35.93,0:05:39.60,Default,,0,0,0,,Ебедейсіз Афина-сенпайды ұрсам да,
Dialogue: 0,0:05:39.60,0:05:41.94,Default,,0,0,0,,Мен ешқашан ұрыспаймын.
Dialogue: 0,0:05:41.94,0:05:45.24,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:05:46.27,0:05:50.88,Default,,0,0,0,,(қоңырау)
Dialogue: 0,0:05:50.88,0:05:54.22,Default,,0,0,0,,<Афина-сенпайды ұрса да➡
Dialogue: 0,0:05:54.22,0:05:57.22,Default,,0,0,0,,Алисияның Акари-сенпайға ұрыспауының себебі➡
Dialogue: 0,0:05:57.22,0:06:00.52,Default,,0,0,0,,Қалай қарасаң да, бұл үлкен жұмбақ>
Dialogue: 0,0:06:05.56,0:06:07.56,Default,,0,0,0,,Ха...
Dialogue: 0,0:06:07.56,0:06:09.56,Default,,0,0,0,,Уа, президент Ария!
Dialogue: 0,0:06:10.57,0:06:13.24,Default,,0,0,0,,Күшік пуи... хахи
Dialogue: 0,0:06:13.24,0:06:16.57,Default,,0,0,0,,Мен қатты шу шығара жаздадым.
Dialogue: 0,0:06:16.57,0:06:20.58,Default,,0,0,0,,Әй, жақсысың ба? Иә...
Dialogue: 0,0:06:20.58,0:06:22.91,Default,,0,0,0,,<Алисия да адам>
Dialogue: 0,0:06:22.91,0:06:24.91,Default,,0,0,0,,<Ешкім білмей тітіркену➡
Dialogue: 0,0:06:24.91,0:06:27.58,Default,,0,0,0,,Сенің дірілдеп қалатын кездері міндетті түрде болады.
Dialogue: 0,0:06:27.58,0:06:31.25,Default,,0,0,0,,<Әсіресе, Акари-сенпайға шын көңіл бөлсеңіз➡
Dialogue: 0,0:06:31.25,0:06:33.92,Default,,0,0,0,,Ұрыса сыпайы бол...>
Dialogue: 0,0:06:33.92,0:06:36.26,Default,,0,0,0,,Пуи? Уф...
Dialogue: 0,0:06:36.26,0:06:38.93,Default,,0,0,0,,Алиса?
Dialogue: 0,0:06:38.93,0:06:41.93,Default,,0,0,0,,Пуи Пуи Пуи Пуи…
Dialogue: 0,0:06:41.93,0:06:44.27,Default,,0,0,0,,Не… не болды? Алиса Чан
Dialogue: 0,0:06:44.27,0:06:47.60,Default,,0,0,0,,А, иә, мен сізге әдетте қандай да бір жолмен қамқорлық жасаймын.
Dialogue: 0,0:06:47.60,0:06:49.60,Default,,0,0,0,,ARIA компаниясын тазалау
Dialogue: 0,0:06:49.60,0:06:52.21,Default,,0,0,0,,Мен сізге сахнаның артында көмектесуге тырыстым.
Dialogue: 0,0:06:52.21,0:06:54.91,Default,,0,0,0,,Пуйпуи? Ах...
Dialogue: 0,0:06:55.88,0:06:57.88,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:06:57.88,0:07:03.89,Default,,0,0,0,,(қоңырау)
Dialogue: 0,0:07:10.56,0:07:13.26,Default,,0,0,0,,Ах... Хахи!
Dialogue: 0,0:07:14.23,0:07:17.57,Default,,0,0,0,,Ондай жерде не істеп жүрсің?
Dialogue: 0,0:07:17.57,0:07:19.57,Default,,0,0,0,,Біраздан соң—
Dialogue: 0,0:07:19.57,0:07:22.57,Default,,0,0,0,,А-а... Мен ерте тұрдым.
Dialogue: 0,0:07:22.57,0:07:24.91,Default,,0,0,0,,Таңертең бәрімен сәлемдескеннен кейін анда-санда,
Dialogue: 0,0:07:24.91,0:07:28.24,Default,,0,0,0,,Мен мектепке барсам ба деп ойладым.
Dialogue: 0,0:07:28.24,0:07:30.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:30.58,0:07:36.25,Default,,0,0,0,,(қоңырау)
Dialogue: 0,0:07:36.25,0:07:39.59,Default,,0,0,0,,Сәлем Алисия, не болды?
Dialogue: 0,0:07:39.59,0:07:43.26,Default,,0,0,0,,Тұтынушының жағдайына байланысты мен бүгін ерте бітірдім.
Dialogue: 0,0:07:43.26,0:07:45.93,Default,,0,0,0,,Барлығымыз шай ішейік пе?
Dialogue: 0,0:07:45.93,0:07:48.26,Default,,0,0,0,,Иә! Алисиямен шай!
Dialogue: 0,0:07:48.26,0:07:50.20,Default,,0,0,0,,Жарайсың, Айка...
Dialogue: 0,0:07:50.20,0:07:52.20,Default,,0,0,0,,Хахи Пуи!
Dialogue: 0,0:07:52.20,0:07:54.54,Default,,0,0,0,,О~ Мен мұны істеймін, президент Ария.
Dialogue: 0,0:07:54.54,0:07:57.21,Default,,0,0,0,,Кешіріңіз, президент Ария.
Dialogue: 0,0:07:57.21,0:08:00.88,Default,,0,0,0,,Pucchai p…
Dialogue: 0,0:08:00.88,0:08:02.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:02.88,0:08:05.55,Default,,0,0,0,,Амансың ба? Ария президенті
Dialogue: 0,0:08:05.55,0:08:07.55,Default,,0,0,0,,Айтпақшы, Алиса ше?
Dialogue: 0,0:08:07.55,0:08:10.55,Default,,0,0,0,,Мен бүгін үйге бардым, өйткені менің жұмысым бар еді.
Dialogue: 0,0:08:10.55,0:08:13.22,Default,,0,0,0,,Пуи? А, президент Ария?
Dialogue: 0,0:08:13.22,0:08:15.22,Default,,0,0,0,,Ал (Президент Ария) Мияу!
Dialogue: 0,0:08:15.22,0:08:17.23,Default,,0,0,0,,Нуна хахи...
Dialogue: 0,0:08:17.23,0:08:19.56,Default,,0,0,0,,Ах... Алиса-чан
Dialogue: 0,0:08:19.56,0:08:22.90,Default,,0,0,0,,Сен мұнда не үшін келдің? Сіздің бизнесіңіз ше?
Dialogue: 0,0:08:22.90,0:08:25.90,Default,,0,0,0,,Сіз... бизнес...
Dialogue: 0,0:08:25.90,0:08:28.90,Default,,0,0,0,,... Ол ерте аяқталды, сондықтан мен Алисиямен бірге жүргендей болдым.
Dialogue: 0,0:08:28.90,0:08:31.57,Default,,0,0,0,,Мен шай ішетін болдым да, қайтып келдім.
Dialogue: 0,0:08:31.57,0:08:33.91,Default,,0,0,0,,Иә? Алдын ала ескерту?
Dialogue: 0,0:08:33.91,0:08:35.91,Default,,0,0,0,,Бұл өте орынды.
Dialogue: 0,0:08:35.91,0:08:37.91,Default,,0,0,0,,(кесенің сынған дыбысы)
Dialogue: 0,0:08:39.25,0:08:41.58,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:08:41.58,0:08:45.92,Default,,0,0,0,,Сіз не істеп жатырсыз? Не істеуім керек?
Dialogue: 0,0:08:45.92,0:08:49.59,Default,,0,0,0,,Бұл Алисияның сүйікті шәйі.
Dialogue: 0,0:08:49.59,0:08:52.19,Default,,0,0,0,,Иә! Әй, бұл ненің дыбысы?
Dialogue: 0,0:08:52.19,0:08:55.20,Default,,0,0,0,,Гясу! Жақсы~
Dialogue: 0,0:08:55.20,0:08:58.90,Default,,0,0,0,,Кешіріңіз. (Ал, президент) Ал...
Dialogue: 0,0:09:00.87,0:09:04.54,Default,,0,0,0,,Барлығының жарақат алмағанына қуаныштымын.
Dialogue: 0,0:09:04.54,0:09:08.21,Default,,0,0,0,,Мен де саған көмектесемін. Мен шынымен кешірім сұраймын.
Dialogue: 0,0:09:08.21,0:09:10.55,Default,,0,0,0,,О, жарайды, бұл туралы уайымдама.
Dialogue: 0,0:09:10.55,0:09:13.55,Default,,0,0,0,,<Мен саған ұрыспаймын>
Dialogue: 0,0:09:13.55,0:09:15.55,Default,,0,0,0,,⚟ (Президент Ария) Пуи Пуи! (Акари/Айка) Иә?
Dialogue: 0,0:09:15.55,0:09:17.55,Default,,0,0,0,,Пуинью! Ах!
Dialogue: 0,0:09:17.55,0:09:21.22,Default,,0,0,0,,Өте қорқынышты, Акаридің гондоласы теңізге ағып кетті.
Dialogue: 0,0:09:21.22,0:09:24.89,Default,,0,0,0,,Жарайды, мен барамын.
Dialogue: 0,0:09:24.89,0:09:27.56,Default,,0,0,0,,А... Айка-чан, не істеуіміз керек?
Dialogue: 0,0:09:27.56,0:09:30.23,Default,,0,0,0,,Өйткені арқанды дұрыс байламадың.
Dialogue: 0,0:09:30.23,0:09:32.23,Default,,0,0,0,,Хахи~
Dialogue: 0,0:09:32.23,0:09:35.24,Default,,0,0,0,,<Бұл жолы үлкен мүмкіндік>
Dialogue: 0,0:09:35.24,0:09:37.57,Default,,0,0,0,,<Бұл үлкен қателік>
Dialogue: 0,0:09:37.57,0:09:41.98,Default,,0,0,0,,<Күткендей, Алисия-сан да Акари-сенпайды ұрысады.>
Dialogue: 0,0:09:43.91,0:09:46.25,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:09:46.25,0:09:49.92,Default,,0,0,0,,Оған үшкір металл немесе бірдеңе тиген сияқты.
Dialogue: 0,0:09:49.92,0:09:52.59,Default,,0,0,0,,Арқан үзілген сияқты.
Dialogue: 0,0:09:52.59,0:09:55.26,Default,,0,0,0,,Рахмет, Алисия.
Dialogue: 0,0:09:55.26,0:09:59.26,Default,,0,0,0,,Мұны бірден байқағаны үшін Президент Арияға алғыс айтамыз.
Dialogue: 0,0:09:59.26,0:10:03.60,Default,,0,0,0,,Пуиню! Рахмет, Президент Ария.
Dialogue: 0,0:10:03.60,0:10:05.60,Default,,0,0,0,,Пуи Пуи
Dialogue: 0,0:10:05.60,0:10:09.27,Default,,0,0,0,,Енді бәріміз бірге шәй ішейік.
Dialogue: 0,0:10:09.27,0:10:12.61,Default,,0,0,0,,Ха~сәлеметсіз бе! Сәлем Алисия
Dialogue: 0,0:10:12.61,0:10:16.95,Default,,0,0,0,,Егер бұл Акира-сан болса, «Уау, Айка, сенің түйінді қалай байлағаныңды түсінбеймін!»
Dialogue: 0,0:10:16.95,0:10:19.28,Default,,0,0,0,,Ол ашуланған болуы керек.
Dialogue: 0,0:10:19.28,0:10:22.95,Default,,0,0,0,,Бұл өте сабырлы жауап болды.
Dialogue: 0,0:10:22.95,0:10:28.96,Default,,0,0,0,,<Бірақ бұл шынымен Ақари-сенпайдың қателігі болса➡
Dialogue: 0,0:10:28.96,0:10:32.29,Default,,0,0,0,,Алисия да Акари-сенпайға ұрысып қалды...>
Dialogue: 0,0:10:32.29,0:10:35.96,Default,,0,0,0,,Фуфу мияу
Dialogue: 0,0:10:35.96,0:10:40.30,Default,,0,0,0,,<Мен сені сөгуім керек еді... иә?>
Dialogue: 0,0:10:40.30,0:10:47.64,Default,,0,0,0,,♬～
Dialogue: 0,0:10:47.64,0:10:52.91,Default,,0,0,0,,<Мысалы, Акари-сенпайды тастап кеткені үшін ұрыспаңдар➡
Dialogue: 0,0:10:52.91,0:10:57.59,Default,,0,0,0,,Бұл болмайды, солай ма? ＞
Dialogue: 0,0:10:57.59,0:10:59.99,Default,,0,0,0,,<Алисия-сан…>
Dialogue: 0,0:11:03.59,0:11:05.59,Default,,0,0,0,,<Содан бері бір апта>
Dialogue: 0,0:11:05.59,0:11:08.60,Default,,0,0,0,,<Алисияның ойын растау үшін анықтама➡
Dialogue: 0,0:11:08.60,0:11:10.93,Default,,0,0,0,,Мен ештеңе ұстамадым＞
Dialogue: 0,0:11:10.93,0:11:13.27,Default,,0,0,0,,<Күткендей, Акари-сенпай➡
Dialogue: 0,0:11:13.27,0:11:16.97,Default,,0,0,0,,Олардың үлкен қателік жасауынан басқа амал жоқ па?＞
Dialogue: 0,0:11:19.61,0:11:22.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:22.28,0:11:25.98,Default,,0,0,0,,Күткеніңізге рахмет. Бұл ерекше парфе.
Dialogue: 0,0:11:30.95,0:11:33.96,Default,,0,0,0,,＜Бұл жақсырақ стратегияларды ойлап табуға арналған➡
Dialogue: 0,0:11:33.96,0:11:36.56,Default,,0,0,0,,Бұл ми үшін үлкен қант қоры＞
Dialogue: 0,0:11:38.29,0:11:40.56,Default,,0,0,0,,(қоңырау)
Dialogue: 0,0:11:40.56,0:11:43.57,Default,,0,0,0,,Ха... ха
Dialogue: 0,0:11:43.57,0:11:49.57,Default,,0,0,0,,(қоңырау)
Dialogue: 0,0:12:02.58,0:12:05.25,Default,,0,0,0,,Қандай таңғаларлық сәйкестік, Алиса-чан.
Dialogue: 0,0:12:05.25,0:12:07.92,Default,,0,0,0,,Сен қазір мектептен үйге барасың ба?
Dialogue: 0,0:12:07.92,0:12:10.26,Default,,0,0,0,,Е?.. Иә.
Dialogue: 0,0:12:10.26,0:12:13.60,Default,,0,0,0,,Мен сізге қосылсам болады ма?
Dialogue: 0,0:12:13.60,0:12:16.60,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:12:16.60,0:12:20.27,Default,,0,0,0,,＜Сонымен... бұл үлкен және ыңғайсыз＞
Dialogue: 0,0:12:20.27,0:12:22.60,Default,,0,0,0,,<Әй, бұл не...>
Dialogue: 0,0:12:22.60,0:12:24.94,Default,,0,0,0,,Күшік!
Dialogue: 0,0:12:24.94,0:12:27.61,Default,,0,0,0,,<Бұл жазалау ойыны ма?>
Dialogue: 0,0:12:27.61,0:12:30.28,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:12:30.28,0:12:33.98,Default,,0,0,0,,Puppu~i (Даяшы) Иә, менде бәрі жақсы.
Dialogue: 0,0:12:40.56,0:12:42.89,Default,,0,0,0,,Я...
Dialogue: 0,0:12:42.89,0:12:46.56,Default,,0,0,0,,Ух
Dialogue: 0,0:12:46.56,0:12:50.23,Default,,0,0,0,,<Күтілгендей, Алисияны жасырын бақылаған адам➡ болды
Dialogue: 0,0:12:50.23,0:12:52.23,Default,,0,0,0,,Түсіндіңіз бе?＞
Dialogue: 0,0:12:52.23,0:12:54.24,Default,,0,0,0,,Сәлем Алиса
Dialogue: 0,0:12:54.24,0:12:56.24,Default,,0,0,0,,... иә?
Dialogue: 0,0:12:57.24,0:13:02.91,Default,,0,0,0,,《Ой, менің артымнан жасырынып жүрген жаман балаға➡
Dialogue: 0,0:13:02.91,0:13:06.58,Default,,0,0,0,,Жазалаудың қажеті жоқ》
Dialogue: 0,0:13:06.58,0:13:10.59,Default,,0,0,0,,<Ах~ Сонымен... Мен қатты қысылып қалдым>
Dialogue: 0,0:13:10.59,0:13:15.59,Default,,0,0,0,,Мүмкін екеуміз бірінші рет жалғыз қалған шығармыз?
Dialogue: 0,0:13:15.59,0:13:19.59,Default,,0,0,0,,Иә? Иә
Dialogue: 0,0:13:19.59,0:13:23.60,Default,,0,0,0,,Ха... енді ойласам
Dialogue: 0,0:13:23.60,0:13:26.93,Default,,0,0,0,,Бір-бірімізді бұрыннан білсек те, біртүрлі.
Dialogue: 0,0:13:26.93,0:13:29.27,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:13:29.27,0:13:31.94,Default,,0,0,0,,Сонымен Алиса
Dialogue: 0,0:13:31.94,0:13:35.28,Default,,0,0,0,,Менен сұрағыңыз келетін нәрсе бар ма?
Dialogue: 0,0:13:35.28,0:13:37.28,Default,,0,0,0,,А...
Dialogue: 0,0:13:41.22,0:13:43.55,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:13:43.55,0:13:46.55,Default,,0,0,0,,Погни!
Dialogue: 0,0:13:46.55,0:13:49.89,Default,,0,0,0,,Не...не туралы айтып тұрсың?
Dialogue: 0,0:13:49.89,0:13:51.89,Default,,0,0,0,,Пуинью Пуиню~ Фуфуфу
Dialogue: 0,0:13:51.89,0:13:55.90,Default,,0,0,0,,Соңғы кездері сен маған көп қарап жүрсің ғой, солай ма?
Dialogue: 0,0:13:55.90,0:14:00.90,Default,,0,0,0,,Оның құштарлығы сонша, жүрегім дір ете қалды.
Dialogue: 0,0:14:00.90,0:14:05.57,Default,,0,0,0,,Қазір екеуміз ғана, сондықтан келіңіздер.
Dialogue: 0,0:14:05.57,0:14:08.98,Default,,0,0,0,,А... а... а...
Dialogue: 0,0:14:09.91,0:14:13.92,Default,,0,0,0,,<Ах~ Күткендей, бәрі басынан өткерілді! ＞
Dialogue: 0,0:14:13.92,0:14:17.52,Default,,0,0,0,,<Дәл Мисс Перфект! ＞
Dialogue: 0,0:14:20.92,0:14:24.53,Default,,0,0,0,,<Ондай жағдайда соғып, сындырыңыз>
Dialogue: 0,0:14:26.59,0:14:32.30,Default,,0,0,0,,Алисия неге ұрыспайды?
Dialogue: 0,0:14:33.60,0:14:35.94,Default,,0,0,0,,Ақари-сенпай осылай деді
Dialogue: 0,0:14:35.94,0:14:40.88,Default,,0,0,0,,Мен Алисияның ашуланғанын көрген емеспін.
Dialogue: 0,0:14:40.88,0:14:43.88,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:14:43.88,0:14:46.88,Default,,0,0,0,,Жасөспірім қанша қателік жіберсе де,
Dialogue: 0,0:14:46.88,0:14:48.88,Default,,0,0,0,,Маған ұрыспайсың ба?
Dialogue: 0,0:14:48.88,0:14:52.89,Default,,0,0,0,,Егер солай болса, бұл суық емес пе?
Dialogue: 0,0:14:52.89,0:14:54.89,Default,,0,0,0,,Пуи?
Dialogue: 0,0:14:56.22,0:14:58.23,Default,,0,0,0,,Pupui?
Dialogue: 0,0:14:59.23,0:15:02.53,Default,,0,0,0,,Пуи? Пфф...
Dialogue: 0,0:15:05.23,0:15:07.24,Default,,0,0,0,,Уау
Dialogue: 0,0:15:08.24,0:15:12.24,Default,,0,0,0,,Кешіріңіз, Президент Ария (Президент Ария) Пуи?
Dialogue: 0,0:15:12.24,0:15:14.58,Default,,0,0,0,,Анау кішкентай қызға
Dialogue: 0,0:15:14.58,0:15:17.58,Default,,0,0,0,,Маған мынаны бере аласыз ба?
Dialogue: 0,0:15:17.58,0:15:20.58,Default,,0,0,0,,Пуи бұл...
Dialogue: 0,0:15:23.92,0:15:26.22,Default,,0,0,0,,Алисия?
Dialogue: 0,0:15:27.26,0:15:29.26,Default,,0,0,0,,Хехехе
Dialogue: 0,0:15:29.26,0:15:32.26,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:15:32.26,0:15:35.93,Default,,0,0,0,,Пуи Пуи
Dialogue: 0,0:15:35.93,0:15:38.27,Default,,0,0,0,,Күшік күшік...
Dialogue: 0,0:15:38.27,0:15:40.57,Default,,0,0,0,,Алисия...
Dialogue: 0,0:15:45.54,0:15:48.54,Default,,0,0,0,,Хехе, мүмкін...
Dialogue: 0,0:15:52.55,0:15:54.55,Default,,0,0,0,,Пу?
Dialogue: 0,0:15:55.55,0:15:58.22,Default,,0,0,0,,Күшік күшік...
Dialogue: 0,0:15:58.22,0:16:08.56,Default,,0,0,0,,♬～
Dialogue: 0,0:16:08.56,0:16:10.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:10.57,0:16:15.57,Default,,0,0,0,,♬～
Dialogue: 0,0:16:15.57,0:16:20.24,Default,,0,0,0,,А, Нянко-сан, сен маған мына кәмпит шарын бере аласың ба?
Dialogue: 0,0:16:20.24,0:16:22.24,Default,,0,0,0,,Пуйпуи
Dialogue: 0,0:16:23.58,0:16:25.98,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:16:29.58,0:16:32.59,Default,,0,0,0,,Pupui Pupupu…
Dialogue: 0,0:16:32.59,0:16:35.59,Default,,0,0,0,,Ах...хе-хе-о, ау.
Dialogue: 0,0:16:36.59,0:16:40.86,Default,,0,0,0,,Президент Ария Бұл керемет емес пе? (Президент Ария) Қара!
Dialogue: 0,0:16:40.86,0:16:44.20,Default,,0,0,0,,Тапсырма өте сәтті болды.
Dialogue: 0,0:16:44.20,0:16:47.54,Default,,0,0,0,,Ол бала да өте қуанышты.
Dialogue: 0,0:16:47.54,0:16:51.54,Default,,0,0,0,,Енді келесі үстелдегі баламен сөйлесейік.
Dialogue: 0,0:16:51.54,0:16:53.54,Default,,0,0,0,,Пуинью
Dialogue: 0,0:16:58.21,0:17:00.55,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:17:00.55,0:17:04.89,Default,,0,0,0,,Ғажайып таңғажайып! Бұл бұрынғыдан әлдеқайда жылдам
Dialogue: 0,0:17:04.89,0:17:07.89,Default,,0,0,0,,Пуф... хехе
Dialogue: 0,0:17:08.89,0:17:10.89,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:17:10.89,0:17:16.23,Default,,0,0,0,,А... иә, жеткізу сәтті өтті.
Dialogue: 0,0:17:16.23,0:17:20.90,Default,,0,0,0,,Хехе... Алиса-чан, парфетті жеп болған соң.
Dialogue: 0,0:17:20.90,0:17:24.51,Default,,0,0,0,,Кішкене серуендеуді қалайсыз ба? сурет?
Dialogue: 0,0:17:39.25,0:17:41.52,Default,,0,0,0,,Мм... (Президент Ария) Пуи?
Dialogue: 0,0:17:41.52,0:17:44.53,Default,,0,0,0,,Бірінші рет біраз уақыт қажет болды, солай емес пе?
Dialogue: 0,0:17:44.53,0:17:46.53,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:17:46.53,0:17:50.20,Default,,0,0,0,,Неліктен мен айналма жолмен жүремін немесе басқа жерге барамын?
Dialogue: 0,0:17:50.20,0:17:53.50,Default,,0,0,0,,Маған қателігіңді айтпадың ба?
Dialogue: 0,0:17:54.54,0:17:56.54,Default,,0,0,0,,Иә
Dialogue: 0,0:17:58.21,0:18:00.88,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:00.88,0:18:02.88,Default,,0,0,0,,Pupui?
Dialogue: 0,0:18:02.88,0:18:07.55,Default,,0,0,0,,Қарбызды президент Ариямен бөлгіңіз келсе.
Dialogue: 0,0:18:07.55,0:18:12.22,Default,,0,0,0,,«Бұл олай емес» деп шақырудың орнына, олай емес.
Dialogue: 0,0:18:12.22,0:18:16.52,Default,,0,0,0,,«Міне, міне» деп шақыра беремін.
Dialogue: 0,0:18:17.56,0:18:20.23,Default,,0,0,0,,Егер сіз бұл сіз емес деп айта берсеңіз
Dialogue: 0,0:18:20.23,0:18:23.90,Default,,0,0,0,,Президент Ария қателесуден қорқады.
Dialogue: 0,0:18:23.90,0:18:28.57,Default,,0,0,0,,Мен ақырында қозғала алмаймын деп ойлаймын.
Dialogue: 0,0:18:28.57,0:18:38.58,Default,,0,0,0,,♬～
Dialogue: 0,0:18:38.58,0:18:41.98,Default,,0,0,0,,Иә? (Президент Ария) Пуи
Dialogue: 0,0:18:46.19,0:18:50.19,Default,,0,0,0,,Пу-иню!
Dialogue: 0,0:18:55.20,0:18:57.87,Default,,0,0,0,,Бұл менің жолым
Dialogue: 0,0:18:57.87,0:19:17.89,Default,,0,0,0,,♬～
Dialogue: 0,0:19:17.89,0:19:29.23,Default,,0,0,0,,♬～
Dialogue: 0,0:19:29.23,0:19:31.57,Default,,0,0,0,,Ум...
Dialogue: 0,0:19:31.57,0:19:35.90,Default,,0,0,0,,Бірақ мен мәңгілікке сәтсіздікке ұшырасам
Dialogue: 0,0:19:35.90,0:19:38.91,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:19:38.91,0:19:40.91,Default,,0,0,0,,Иә
Dialogue: 0,0:19:40.91,0:19:43.24,Default,,0,0,0,,Ол кезде мен сенімен бірге боламын.
Dialogue: 0,0:19:43.24,0:19:47.92,Default,,0,0,0,,Оқымағаныма қатты өкінемін.
Dialogue: 0,0:19:47.92,0:19:49.92,Default,,0,0,0,,А...
Dialogue: 0,0:19:52.59,0:19:57.29,Default,,0,0,0,,Өйткені мен де кемелсіз адаммын.
Dialogue: 0,0:20:02.93,0:20:07.27,Default,,0,0,0,,Пу~пу пуи~ пуиню
Dialogue: 0,0:20:07.27,0:20:11.27,Default,,0,0,0,,Жоғары сынып ретінде, кіші сыныптарға сабақ бергенде
Dialogue: 0,0:20:11.27,0:20:15.28,Default,,0,0,0,,Кейде бәрі дұрыс болмай қалады.
Dialogue: 0,0:20:15.28,0:20:18.95,Default,,0,0,0,,Осындай кезде мен шынымен де ойлаймын.
Dialogue: 0,0:20:18.95,0:20:22.95,Default,,0,0,0,,Әй, үйрету және үйрету.
Dialogue: 0,0:20:22.95,0:20:26.55,Default,,0,0,0,,Шындығында, олар өте ұқсас.
Dialogue: 0,0:20:27.96,0:20:33.29,Default,,0,0,0,,Олай болса, мен Акари-чанмен бір кісідей жұмыс істей аламын.
Dialogue: 0,0:20:33.29,0:20:38.63,Default,,0,0,0,,Қатты тырысып, жиі сәтсіздікке ұшырау
Dialogue: 0,0:20:38.63,0:20:42.24,Default,,0,0,0,,Соңында, бірге
Dialogue: 0,0:20:42.24,0:20:45.57,Default,,0,0,0,,Қуанышымды Таңмен бөліскім келеді.
Dialogue: 0,0:20:45.57,0:20:50.58,Default,,0,0,0,,(қоңырау)
Dialogue: 0,0:20:50.58,0:20:58.92,Default,,0,0,0,,♬～
Dialogue: 0,0:20:58.92,0:21:01.26,Default,,0,0,0,,Әй, Алисия!
Dialogue: 0,0:21:01.26,0:21:04.59,Default,,0,0,0,,Алиса! О, құдайым
Dialogue: 0,0:21:04.59,0:21:06.59,Default,,0,0,0,,Бүгін біртүрлі кездейсоқтықтар тізбегі.
Dialogue: 0,0:21:06.59,0:21:08.93,Default,,0,0,0,,Пуиню!
Dialogue: 0,0:21:08.93,0:21:11.27,Default,,0,0,0,,Президент Ария, сіз қайда бардыңыз деп қызық болдым.
Dialogue: 0,0:21:11.27,0:21:13.60,Default,,0,0,0,,Сіз Алисиямен бірге болдыңыз, солай ма?
Dialogue: 0,0:21:13.60,0:21:15.60,Default,,0,0,0,,Ню кіші
Dialogue: 0,0:21:15.60,0:21:18.61,Default,,0,0,0,,Жаттығуға кешігіп, қай жерде айналма жолмен келемін деп ойладым.
Dialogue: 0,0:21:18.61,0:21:21.61,Default,,0,0,0,,Сен Алисиямен серуендеп жүргенің соншалықты жасырын.
Dialogue: 0,0:21:21.61,0:21:25.61,Default,,0,0,0,,Алиса-чан, не айтып жатқанымызды құпия сақта.
Dialogue: 0,0:21:25.61,0:21:29.28,Default,,0,0,0,,Ах… Неге?
Dialogue: 0,0:21:29.28,0:21:31.95,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:21:31.95,0:21:34.62,Default,,0,0,0,,Бұл ұят емес.
Dialogue: 0,0:21:34.62,0:21:36.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:36.62,0:21:48.24,Default,,0,0,0,,♬～
Dialogue: 0,0:21:48.24,0:21:51.24,Default,,0,0,0,,Оны құпия ұстаудың қажеті жоқ деп ойлаймын.
Dialogue: 0,0:21:51.24,0:21:53.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:58.58,0:22:02.58,Default,,0,0,0,,Екеуің ұялып қалдыңдар, мен саған қарап тұрмын.
Dialogue: 0,0:22:02.58,0:22:04.99,Default,,0,0,0,,Өйткені біз біртұтаспыз.
Dialogue: 0,0:22:08.26,0:22:10.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:10.93,0:22:13.26,Default,,0,0,0,,Хехе
Dialogue: 0,0:22:13.26,0:22:17.97,Default,,0,0,0,,Кешіріңіз, мен оны үлкен және ұялшақ айттым.
Dialogue: 0,0:22:21.27,0:22:23.27,Default,,0,0,0,,Маған ұрысыңызшы
Dialogue: 0,0:22:23.27,0:22:25.27,Default,,0,0,0,,О, Құдайым
Dialogue: 0,0:22:25.27,0:22:29.61,Default,,0,0,0,,Алисияны монополиялауға тыйым салынады!
Dialogue: 0,0:22:29.61,0:22:32.61,Default,,0,0,0,,<Аа, менің анам да➡
Dialogue: 0,0:22:32.61,0:22:35.95,Default,,0,0,0,,Алисиядай болсам ғой>
Dialogue: 0,0:22:35.95,0:22:40.89,Default,,0,0,0,,<Иә? Бірақ кейін ол менің анама ұқсамайды деп ойлаймын.>
Dialogue: 0,0:22:40.89,0:22:42.89,Default,,0,0,0,,<Хехехе>
Dialogue: 0,0:22:44.89,0:23:04.91,Default,,0,0,0,,♬～
Dialogue: 0,0:23:04.91,0:23:20.93,Default,,0,0,0,,♬～
Dialogue: 0,0:23:20.93,0:23:26.93,Default,,0,0,0,,♬～
Dialogue: 0,0:23:26.93,0:23:46.89,Default,,0,0,0,,♬～
Dialogue: 0,0:23:46.89,0:24:06.91,Default,,0,0,0,,♬～
Dialogue: 0,0:24:06.91,0:24:13.91,Default,,0,0,0,,♬～
Dialogue: 0,0:24:15.92,0:24:18.59,Default,,0,0,0,,<Президент Ария Ойланып көріңізші, Президент Ария➡
Dialogue: 0,0:24:18.59,0:24:21.26,Default,,0,0,0,,Сіз қашаннан бері ARIA компаниясында жұмыс істейсіз? ＞
Dialogue: 0,0:24:21.26,0:24:23.92,Default,,0,0,0,,<Пуинюу> <Араара Уфуфу>
Dialogue: 0,0:24:23.92,0:24:25.93,Default,,0,0,0,,<Келесі жолы...>
Dialogue: 0,0:24:26.93,0:24:28.93,Default,,0,0,0,,<Енді маған қолыңды бер>
Dialogue: 0,0:24:30.43,0:24:36.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory