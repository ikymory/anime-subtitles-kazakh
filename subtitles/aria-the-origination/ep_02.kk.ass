Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.30,0:00:04.63,Default,,0,0,0,,<Мен біраз уақыттан бері бірінші рет бронь жасадым>
Dialogue: 0,0:00:04.63,0:00:07.30,Default,,0,0,0,,＜Енді тәжірибеңіздің нәтижелерін көрсететін уақыт＞
Dialogue: 0,0:00:07.30,0:00:09.64,Default,,0,0,0,,<Сәттілік> <Иә! ＞
Dialogue: 0,0:00:09.64,0:00:13.31,Default,,0,0,0,,<Төтенше жағдай туындағанда, аман қалу үшін бар күшіңізді пайдаланыңыз>
Dialogue: 0,0:00:13.31,0:00:16.65,Default,,0,0,0,,<Иә! > <Артқа есу арқылы толық жылдамдықпен қашыңыз>
Dialogue: 0,0:00:16.65,0:00:18.98,Default,,0,0,0,,<Иә! > <Жоқ, жоқ...>
Dialogue: 0,0:00:31.29,0:00:35.30,Default,,0,0,0,,<Ай-чан, карнавалдан кейінгі Нео-Венецияда➡
Dialogue: 0,0:00:35.30,0:00:39.00,Default,,0,0,0,,Көктемнің белгілері бірте-бірте жақындап келеді.＞
Dialogue: 0,0:00:41.97,0:00:43.97,Default,,0,0,0,,Pupui? Ах...
Dialogue: 0,0:00:43.97,0:00:48.31,Default,,0,0,0,,Қайтадан қош келдіңіз, Алисия! (Президент Ария) Пуи Пуиню~
Dialogue: 0,0:00:48.31,0:00:51.91,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:51.91,0:00:53.92,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:00:53.92,0:00:57.25,Default,,0,0,0,,Көңілді болды~ Жүр, қолыңды берші.
Dialogue: 0,0:00:57.25,0:00:59.25,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:59.25,0:01:01.26,Default,,0,0,0,,<Туристік маусым өтті➡
Dialogue: 0,0:01:01.26,0:01:05.93,Default,,0,0,0,,Ундинестің жұмысы басылды.＞
Dialogue: 0,0:01:05.93,0:01:08.93,Default,,0,0,0,,Бүгінгі кестеде тағы бір нәрсе қалды.
Dialogue: 0,0:01:08.93,0:01:12.94,Default,,0,0,0,,Ертең таңертең бір кездесу бар, ал түстен кейін әлі брондау жоқ.
Dialogue: 0,0:01:12.94,0:01:16.61,Default,,0,0,0,,☎ (рингтон)
Dialogue: 0,0:01:16.61,0:01:19.61,Default,,0,0,0,,Иә, ARIA компаниясы.
Dialogue: 0,0:01:21.28,0:01:24.28,Default,,0,0,0,,☎ Иә?! О, кешіріңіз...
Dialogue: 0,0:01:24.28,0:01:26.62,Default,,0,0,0,,☎ Иә, біз сізді күтеміз.
Dialogue: 0,0:01:26.62,0:01:30.32,Default,,0,0,0,,Өтінемін, ертең.
Dialogue: 0,0:01:33.62,0:01:35.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:35.62,0:01:38.63,Default,,0,0,0,,Әй, не болды?
Dialogue: 0,0:01:38.63,0:01:42.63,Default,,0,0,0,,Бұл жұмысқа сұраныс болды.
Dialogue: 0,0:01:42.63,0:01:46.64,Default,,0,0,0,,Менің саған көрсеткенім осы.
Dialogue: 0,0:01:46.64,0:01:50.24,Default,,0,0,0,,Жақсы! Құттықтаймын Акари-чан
Dialogue: 0,0:01:50.24,0:01:52.24,Default,,0,0,0,,Мен ертең бар күшімді салуым керек.
Dialogue: 0,0:01:52.24,0:01:54.58,Default,,0,0,0,,Пупуиню~!
Dialogue: 0,0:01:54.58,0:01:56.91,Default,,0,0,0,,Иә, мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:01:56.91,0:02:16.93,Default,,0,0,0,,♬～
Dialogue: 0,0:02:16.93,0:02:36.95,Default,,0,0,0,,♬～
Dialogue: 0,0:02:36.95,0:02:56.91,Default,,0,0,0,,♬～
Dialogue: 0,0:02:56.91,0:03:16.93,Default,,0,0,0,,♬～
Dialogue: 0,0:03:16.93,0:03:36.95,Default,,0,0,0,,♬～
Dialogue: 0,0:03:36.95,0:03:50.96,Default,,0,0,0,,♬～
Dialogue: 0,0:04:00.57,0:04:04.24,Default,,0,0,0,,Үлкен көктемгі есінеуге тыйым салынады! Хахи кешіріңіз
Dialogue: 0,0:04:04.24,0:04:09.24,Default,,0,0,0,,Өйткені бүгінгі жолды таңдау үшін таңға дейін уақыт кетті.
Dialogue: 0,0:04:09.24,0:04:13.58,Default,,0,0,0,,Бұл күдікті. Неліктен?
Dialogue: 0,0:04:13.58,0:04:16.25,Default,,0,0,0,,Себебі ARIA компаниясына қоңырау шалыңыз.
Dialogue: 0,0:04:16.25,0:04:18.92,Default,,0,0,0,,Алисияда бос орын болса да.
Dialogue: 0,0:04:18.92,0:04:21.26,Default,,0,0,0,,Жалғыз Акариді қалай ұсынуға болады?
Dialogue: 0,0:04:21.26,0:04:23.59,Default,,0,0,0,,Бір себеп болуы керек, солай ма?
Dialogue: 0,0:04:23.59,0:04:25.59,Default,,0,0,0,,Себебі неде?
Dialogue: 0,0:04:25.59,0:04:29.60,Default,,0,0,0,,Мысалы, сіз бойдақтармен көңіл көтеруді ойлайтын шығарсыз.
Dialogue: 0,0:04:29.60,0:04:32.60,Default,,0,0,0,,Иә! Әдейі жалғыз таңдаңыз
Dialogue: 0,0:04:32.60,0:04:36.27,Default,,0,0,0,,Балаға мүмкін емес тапсырмаларды беруді ұнататын тұтынушы бар сияқты.
Dialogue: 0,0:04:36.27,0:04:38.94,Default,,0,0,0,,Егер осындай тұтынушы болса, Акари сол болар еді.
Dialogue: 0,0:04:38.94,0:04:41.94,Default,,0,0,0,,Жай араласып, шатастырып, бәлеге қаласың.
Dialogue: 0,0:04:41.94,0:04:44.61,Default,,0,0,0,,《Күте~》 《Пуиню~! 》
Dialogue: 0,0:04:44.61,0:04:46.95,Default,,0,0,0,,Мүмкін... Иә?
Dialogue: 0,0:04:46.95,0:04:50.22,Default,,0,0,0,,Ол алдын ала хабарланбаған аты аңызға айналған инспектор болуы мүмкін.
Dialogue: 0,0:04:50.22,0:04:53.56,Default,,0,0,0,,Хабарламасыз инспектор? Бұл жай ғана қауесет
Dialogue: 0,0:04:53.56,0:04:57.56,Default,,0,0,0,,Гондола қауымдастығы жіберген аңызға айналған инспектор
Dialogue: 0,0:04:57.56,0:04:59.90,Default,,0,0,0,,Жалғыз гондолада хабарсыз жүру
Dialogue: 0,0:04:59.90,0:05:02.56,Default,,0,0,0,,Олар сіздің қабілетіңізді тексереді.
Dialogue: 0,0:05:02.56,0:05:05.57,Default,,0,0,0,,Сонымен, тексеру сәтсіз аяқталса не болады?
Dialogue: 0,0:05:05.57,0:05:07.57,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:05:07.57,0:05:11.91,Default,,0,0,0,,Егер сәтсіздікке ұшырасаңыз, жалғызбастылар жұптық деңгейге дейін төмендейтін сияқты.
Dialogue: 0,0:05:11.91,0:05:14.24,Default,,0,0,0,,Иә! Эх, аа, аа...
Dialogue: 0,0:05:14.24,0:05:16.91,Default,,0,0,0,,До-до-до... Мен не істеуім керек? Мен не істеу керек, Айка-чан?
Dialogue: 0,0:05:16.91,0:05:19.92,Default,,0,0,0,,Тынышталыңыз, Акари.
Dialogue: 0,0:05:19.92,0:05:22.58,Default,,0,0,0,,Сонда кездескенше.
Dialogue: 0,0:05:22.58,0:05:24.92,Default,,0,0,0,,Акари Акари Сенпай
Dialogue: 0,0:05:24.92,0:05:27.92,Default,,0,0,0,,Тұтынушы ұнамаса да, бар күшіңізді салып көріңіз.
Dialogue: 0,0:05:27.92,0:05:30.59,Default,,0,0,0,,Өтінемін, сәтсіздікке ұшырамаңыз
Dialogue: 0,0:05:30.59,0:05:35.00,Default,,0,0,0,,Иә, рахмет Айка-чан, Алиса-чан.
Dialogue: 0,0:05:36.93,0:05:40.94,Default,,0,0,0,,Кәне, жаттығу жасайық, кенже.
Dialogue: 0,0:05:40.94,0:05:43.27,Default,,0,0,0,,Иә, Айка-сенпай.
Dialogue: 0,0:05:43.27,0:05:46.27,Default,,0,0,0,,Мен жаңа ғана оралдым.
Dialogue: 0,0:05:46.27,0:05:49.28,Default,,0,0,0,,Қош келдіңіз Акари-чан
Dialogue: 0,0:05:49.28,0:05:51.55,Default,,0,0,0,,Уәденің уақыты жақындап қалды.
Dialogue: 0,0:05:51.55,0:05:53.55,Default,,0,0,0,,Иә
Dialogue: 0,0:05:53.55,0:05:56.89,Default,,0,0,0,,Мен қобалжыдым.
Dialogue: 0,0:05:56.89,0:05:59.89,Default,,0,0,0,,Әй, біраз болды.
Dialogue: 0,0:05:59.89,0:06:02.89,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:06:02.89,0:06:07.50,Default,,0,0,0,,Кеше мен жоспарымды картаға салдым.
Dialogue: 0,0:06:08.90,0:06:11.20,Default,,0,0,0,,Ал...
Dialogue: 0,0:06:13.57,0:06:15.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:15.57,0:06:17.57,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:17.57,0:06:21.24,Default,,0,0,0,,Ах...хехехе
Dialogue: 0,0:06:21.24,0:06:24.95,Default,,0,0,0,,Мен бүгін Амарантаға тапсырыс бердім.
Dialogue: 0,0:06:25.91,0:06:28.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:28.25,0:06:30.59,Default,,0,0,0,,ARIA компаниясына қош келдіңіз
Dialogue: 0,0:06:30.59,0:06:34.92,Default,,0,0,0,,Мен Акари Мизунашимін, мен бүгін саған айналаны көрсетемін.
Dialogue: 0,0:06:34.92,0:06:38.26,Default,,0,0,0,,Алдын ала рахмет.
Dialogue: 0,0:06:38.26,0:06:42.96,Default,,0,0,0,,Біз оны бірден дайындаймыз, сондықтан сәл күте тұрыңыз.
Dialogue: 0,0:06:44.27,0:06:47.57,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:06:51.54,0:06:53.88,Default,,0,0,0,,Басатын жерде абай болыңыз.
Dialogue: 0,0:06:53.88,0:06:55.88,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:57.55,0:06:59.55,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:59.55,0:07:01.88,Default,,0,0,0,,Әй, сен де осында неге отырмайсың?
Dialogue: 0,0:07:01.88,0:07:06.19,Default,,0,0,0,,Не? Бірге көңіл көтерейік
Dialogue: 0,0:07:07.56,0:07:12.56,Default,,0,0,0,,Тұтынушы: Сіз көргіңіз келетін ерекше орындар бар ма?
Dialogue: 0,0:07:12.56,0:07:16.90,Default,,0,0,0,,Жарайды... Саған қалдырамын.
Dialogue: 0,0:07:16.90,0:07:21.90,Default,,0,0,0,,Не? Маған қалдырыңыз...?
Dialogue: 0,0:07:21.90,0:07:25.91,Default,,0,0,0,,Мен жас кезімнен Нео-Венезияның үлкен жанкүйерімін.
Dialogue: 0,0:07:25.91,0:07:27.91,Default,,0,0,0,,Мен бұл жерде бұрын талай рет болғанмын.
Dialogue: 0,0:07:27.91,0:07:31.25,Default,,0,0,0,,Мен туристік орындардың көпшілігінде болдым.
Dialogue: 0,0:07:31.25,0:07:33.58,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:07:33.58,0:07:37.59,Default,,0,0,0,,Өтінемін, мұны бүгін сіз ғана жасай аласыз.
Dialogue: 0,0:07:37.59,0:07:40.59,Default,,0,0,0,,Сіз маған Нео Венецияны көрсете аласыз ба?
Dialogue: 0,0:07:40.59,0:07:44.29,Default,,0,0,0,,Ах...хехе
Dialogue: 0,0:07:45.26,0:07:48.26,Default,,0,0,0,,Иә, мен бар күшімді саламын!
Dialogue: 0,0:07:48.26,0:07:56.54,Default,,0,0,0,,♬～
Dialogue: 0,0:07:56.54,0:07:58.54,Default,,0,0,0,,Мен бардым
Dialogue: 0,0:07:58.54,0:08:01.88,Default,,0,0,0,,Айка-сенпай, жаттығуың керек емес пе еді?
Dialogue: 0,0:08:01.88,0:08:05.21,Default,,0,0,0,,Жоқ... Мен жалғыз Акари үшін уайымдаймын!
Dialogue: 0,0:08:05.21,0:08:07.88,Default,,0,0,0,,Үйге баруға болады, кіші Чан.
Dialogue: 0,0:08:07.88,0:08:11.89,Default,,0,0,0,,Хмм... Жоқ, мен де сені ертіп барамын.
Dialogue: 0,0:08:11.89,0:08:13.89,Default,,0,0,0,,Аты аңызға айналған инспектор болсаң
Dialogue: 0,0:08:13.89,0:08:17.23,Default,,0,0,0,,Мені олардың қандай тексерулер жасайтыны қызықтырады.
Dialogue: 0,0:08:17.23,0:08:19.23,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:08:19.23,0:08:22.56,Default,,0,0,0,,Жарайды, кенже, мен бәрібір барамын.
Dialogue: 0,0:08:22.56,0:08:25.27,Default,,0,0,0,,Жүр! раджа
Dialogue: 0,0:08:30.24,0:08:35.24,Default,,0,0,0,,Тұтынушы, оң жақтағы ғимаратқа қараңызшы.
Dialogue: 0,0:08:35.24,0:08:39.95,Default,,0,0,0,,Бұл ғимарат тарихи ғимарат емес, бірақ...
Dialogue: 0,0:08:43.59,0:08:46.92,Default,,0,0,0,,Енді, егер сіз мұны жасасаңыз ...
Dialogue: 0,0:08:46.92,0:08:50.86,Default,,0,0,0,,Шатырдағы мүсінге назар аударыңыз.
Dialogue: 0,0:08:50.86,0:08:53.53,Default,,0,0,0,,Жақсы! Тек осы жерден қараған кезде
Dialogue: 0,0:08:53.53,0:08:57.20,Default,,0,0,0,,Мүсін қалқып тұрған аралды ұстап тұрған сияқты.
Dialogue: 0,0:08:57.20,0:09:00.54,Default,,0,0,0,,Ой, хехе, қызық екен.
Dialogue: 0,0:09:00.54,0:09:03.20,Default,,0,0,0,,Бұл рас (Президент Ария) Пуи
Dialogue: 0,0:09:03.20,0:09:05.21,Default,,0,0,0,,＜Жақсы…＞
Dialogue: 0,0:09:05.21,0:09:07.54,Default,,0,0,0,,Акари-сан, иә?
Dialogue: 0,0:09:07.54,0:09:11.88,Default,,0,0,0,,Сіз гондоланы сәл алға жылжыта аласыз ба?
Dialogue: 0,0:09:11.88,0:09:13.88,Default,,0,0,0,,Иә
Dialogue: 0,0:09:17.22,0:09:19.55,Default,,0,0,0,,Бұл солай ма? Иә
Dialogue: 0,0:09:19.55,0:09:22.89,Default,,0,0,0,,Мен оны екі палинаның арасына қоя аламын ба?
Dialogue: 0,0:09:22.89,0:09:24.89,Default,,0,0,0,,Иә
Dialogue: 0,0:09:27.56,0:09:29.56,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:09:29.56,0:09:32.27,Default,,0,0,0,,Бір күні тозаққа түсіп кетермін.
Dialogue: 0,0:09:33.23,0:09:36.24,Default,,0,0,0,,Ах! Бұл жолы екеуміз ғана...
Dialogue: 0,0:09:36.24,0:09:38.24,Default,,0,0,0,,Хехехе
Dialogue: 0,0:09:38.24,0:09:41.91,Default,,0,0,0,,Осы екі палинаның арасына қараған кезде ғана
Dialogue: 0,0:09:41.91,0:09:45.25,Default,,0,0,0,,Мынадай көрінеді...
Dialogue: 0,0:09:45.25,0:09:50.25,Default,,0,0,0,,А... Амаранта, сен мұнда бұрын болғансың.
Dialogue: 0,0:09:50.25,0:09:52.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:52.59,0:09:54.92,Default,,0,0,0,,Хехе
Dialogue: 0,0:09:54.92,0:09:57.93,Default,,0,0,0,,Иә, бұрын бір рет қана.
Dialogue: 0,0:09:57.93,0:09:59.93,Default,,0,0,0,,Бірақ қызық болды.
Dialogue: 0,0:09:59.93,0:10:02.93,Default,,0,0,0,,Енді мені қайда апарасың?
Dialogue: 0,0:10:02.93,0:10:06.60,Default,,0,0,0,,Иә, содан кейін келесі межелі жерге.
Dialogue: 0,0:10:06.60,0:10:21.95,Default,,0,0,0,,♬～
Dialogue: 0,0:10:21.95,0:10:23.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:23.95,0:10:28.96,Default,,0,0,0,,Мұнда ерекше бірдеңе болды ма? Келіңіздер...
Dialogue: 0,0:10:30.96,0:10:36.97,Default,,0,0,0,,♬～
Dialogue: 0,0:10:36.97,0:10:40.24,Default,,0,0,0,,Қазіргі уақытта ештеңе жоқ сияқты.
Dialogue: 0,0:10:40.24,0:10:43.94,Default,,0,0,0,,Қорқынышты бөлік әлі алда.
Dialogue: 0,0:10:45.24,0:10:48.58,Default,,0,0,0,,Уау, кенже, артқа, артқа! Ах...
Dialogue: 0,0:10:48.58,0:10:51.58,Default,,0,0,0,,Бұл пастор Нео-Венециядан.
Dialogue: 0,0:10:51.58,0:10:55.58,Default,,0,0,0,,Сіз күрделі миниатюра жасайсыз.
Dialogue: 0,0:10:55.58,0:10:58.25,Default,,0,0,0,,хобби ретінде 2 жыл бұрын басталған
Dialogue: 0,0:10:58.25,0:11:02.96,Default,,0,0,0,,Нео Венецияның басты аралы ақыры қалыптасып келеді.
Dialogue: 0,0:11:04.26,0:11:06.26,Default,,0,0,0,,Сіз не қарап тұрсыз?
Dialogue: 0,0:11:06.26,0:11:09.56,Default,,0,0,0,,Мен мұндай жерде көрікті жер бар деп ешқашан ойламаппын.
Dialogue: 0,0:11:10.93,0:11:13.94,Default,,0,0,0,,Пуи? Пуи Пуи Пуи Пуи Ню
Dialogue: 0,0:11:13.94,0:11:17.94,Default,,0,0,0,,Пуи Пуи Пуи Пуи~! Президент Ария, не болды?
Dialogue: 0,0:11:17.94,0:11:21.61,Default,,0,0,0,,Pippi pipui pipui pii… (Пастор) О, солай ма?
Dialogue: 0,0:11:21.61,0:11:24.28,Default,,0,0,0,,Хехе... Соңғы рет осында келгенмін
Dialogue: 0,0:11:24.28,0:11:27.62,Default,,0,0,0,,Тек Сан-Марко аймағы ғана аяқталды.
Dialogue: 0,0:11:27.62,0:11:32.32,Default,,0,0,0,,Барлығын аяқтау үшін тағы бес жыл қажет.
Dialogue: 0,0:11:33.62,0:11:36.29,Default,,0,0,0,,Кез келген уақытта келіңіз және қайта көріңіз.
Dialogue: 0,0:11:36.29,0:11:38.59,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:40.90,0:11:45.90,Default,,0,0,0,,Хехехе... неше түрлі адам бар.
Dialogue: 0,0:11:45.90,0:11:47.90,Default,,0,0,0,,Иә! Барлығы
Dialogue: 0,0:11:47.90,0:11:51.24,Default,,0,0,0,,Мен Neo Venezia-ның үлкен жанкүйерімін.
Dialogue: 0,0:11:51.24,0:12:01.58,Default,,0,0,0,,♬～
Dialogue: 0,0:12:01.58,0:12:05.92,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:12:05.92,0:12:09.59,Default,,0,0,0,,Иә, Алисия-сан, рахмет, Акари-чан.
Dialogue: 0,0:12:09.59,0:12:13.26,Default,,0,0,0,,Пуи Пуй Пуй Пуй Пуиню~! Иә иә
Dialogue: 0,0:12:13.26,0:12:16.56,Default,,0,0,0,,Президент Ария үшін де көп нәрсе бар.
Dialogue: 0,0:12:21.27,0:12:24.94,Default,,0,0,0,,Уау...хехехе дәмді
Dialogue: 0,0:12:24.94,0:12:28.28,Default,,0,0,0,,Иә! Өйткені бұл Нео Венецияичи
Dialogue: 0,0:12:28.28,0:12:32.61,Default,,0,0,0,,Президент Ария, күн ыстық, сондықтан мен хо-хоу боламын.
Dialogue: 0,0:12:32.61,0:12:35.28,Default,,0,0,0,,Фу Фу
Dialogue: 0,0:12:35.28,0:12:37.99,Default,,0,0,0,,Келіңіз, өтінемін (Президент Ария) Пуи
Dialogue: 0,0:12:40.22,0:12:42.22,Default,,0,0,0,,Погни!
Dialogue: 0,0:12:42.22,0:12:44.89,Default,,0,0,0,,Анау картоп майы дүкені (иесі) Иә.
Dialogue: 0,0:12:44.89,0:12:47.23,Default,,0,0,0,,Сіз майды жақында ауыстырдыңыз ба?
Dialogue: 0,0:12:47.23,0:12:51.57,Default,,0,0,0,,Иә, көптен бері пайдаланатын дүкенім жабылды.
Dialogue: 0,0:12:51.57,0:12:54.90,Default,,0,0,0,,Жоқ...? Мен жақсы сары майды таңдадым.
Dialogue: 0,0:12:54.90,0:12:58.57,Default,,0,0,0,,Жоқ, бұрынғыдан да дәмді болды.
Dialogue: 0,0:12:58.57,0:13:01.91,Default,,0,0,0,,Бұл рас па? Жақсы~
Dialogue: 0,0:13:01.91,0:13:04.25,Default,,0,0,0,,Әдеттегідей рахмет
Dialogue: 0,0:13:04.25,0:13:06.55,Default,,0,0,0,,Әрқашан...?
Dialogue: 0,0:13:09.92,0:13:11.92,Default,,0,0,0,,Мен де картоп майын жегім келеді!
Dialogue: 0,0:13:11.92,0:13:15.26,Default,,0,0,0,,Айка-сенпай, шыдамды болыңыз, өйткені...
Dialogue: 0,0:13:15.26,0:13:17.93,Default,,0,0,0,,Ах
Dialogue: 0,0:13:17.93,0:13:19.93,Default,,0,0,0,,Уууууууууууууууххххх
Dialogue: 0,0:13:24.93,0:13:29.27,Default,,0,0,0,,О? Міне, жоспарланған уақыт аяқталуға жақын.
Dialogue: 0,0:13:29.27,0:13:31.61,Default,,0,0,0,,(Сузуя) Ал сен неге Гульге айналдың?
Dialogue: 0,0:13:31.61,0:13:34.61,Default,,0,0,0,,А, иә, дұрыс.
Dialogue: 0,0:13:34.61,0:13:40.31,Default,,0,0,0,,Акари-сан, бүгінгі күн үшін көп рахмет. Бұл өте қызық болды.
Dialogue: 0,0:13:54.56,0:13:56.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:56.90,0:14:00.90,Default,,0,0,0,,А, анау Амаранта-сан, Алисия-сан.
Dialogue: 0,0:14:00.90,0:14:04.57,Default,,0,0,0,,Менің тағы бір ерекше орным бар.
Dialogue: 0,0:14:04.57,0:14:07.58,Default,,0,0,0,,Мен сізге тағы бір жерді ғана көрсете аламын.
Dialogue: 0,0:14:07.58,0:14:09.91,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:14:09.91,0:14:12.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:16.25,0:14:20.59,Default,,0,0,0,,Әлі де жақсы. Олай болса, өтінемін.
Dialogue: 0,0:14:20.59,0:14:22.99,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:26.26,0:14:28.26,Default,,0,0,0,,қиын өмір кешкен.
Dialogue: 0,0:14:28.26,0:14:31.93,Default,,0,0,0,,Мүмкін сізге емтиханнан өте алмадыңыз деп айтқан шығар...
Dialogue: 0,0:14:31.93,0:14:34.94,Default,,0,0,0,,Иә!? Амал жоқ...
Dialogue: 0,0:14:34.94,0:14:38.54,Default,,0,0,0,,Иә... тездетіп оның соңынан ерейік.
Dialogue: 0,0:14:42.54,0:14:47.22,Default,,0,0,0,,Сондай тар су жолында... Қызық, қайда барасың?
Dialogue: 0,0:14:47.22,0:14:57.56,Default,,0,0,0,,♬～
Dialogue: 0,0:14:57.56,0:15:00.23,Default,,0,0,0,,<Сіз қаншалықты алысқа баруға дайынсыз? ＞
Dialogue: 0,0:15:00.23,0:15:08.57,Default,,0,0,0,,♬～
Dialogue: 0,0:15:08.57,0:15:10.57,Default,,0,0,0,,Оны ұмытып қалдың ба?
Dialogue: 0,0:15:11.57,0:15:13.91,Default,,0,0,0,,Жақсы
Dialogue: 0,0:15:13.91,0:15:18.51,Default,,0,0,0,,Артқа тартыңыз, өйткені сіз сәл тар аумақтан өтесіз.
Dialogue: 0,0:15:22.25,0:15:24.59,Default,,0,0,0,,Жақсы! (Президент Ария) Пупуй!
Dialogue: 0,0:15:24.59,0:15:32.93,Default,,0,0,0,,♬～
Dialogue: 0,0:15:32.93,0:15:34.93,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:35.93,0:15:39.60,Default,,0,0,0,,Бұл аймақ су деңгейі көтерілген кезде су астында қалды.
Dialogue: 0,0:15:39.60,0:15:43.54,Default,,0,0,0,,Бұл енді пайдаланылмайтын монастырьдің ауласы.
Dialogue: 0,0:15:43.54,0:15:46.21,Default,,0,0,0,,Қандай керемет жер.
Dialogue: 0,0:15:46.21,0:15:49.54,Default,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:15:49.54,0:15:53.21,Default,,0,0,0,,Фуфуфу Акари-сан, иә?
Dialogue: 0,0:15:53.21,0:15:56.88,Default,,0,0,0,,Қызық, бұл есіктің артында не тұр?
Dialogue: 0,0:15:56.88,0:16:00.56,Default,,0,0,0,,Мм, мен білмеймін...
Dialogue: 0,0:16:00.56,0:16:03.89,Default,,0,0,0,,Хехехехе, біраз жүрейік.
Dialogue: 0,0:16:03.89,0:16:08.20,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:16:11.90,0:16:13.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:13.90,0:16:16.57,Default,,0,0,0,,Аа, осылай түзу жүрейік.
Dialogue: 0,0:16:16.57,0:16:18.57,Default,,0,0,0,,Иә
Dialogue: 0,0:16:18.57,0:16:27.25,Default,,0,0,0,,♬～
Dialogue: 0,0:16:27.25,0:16:29.58,Default,,0,0,0,,Жолдағы бұрылыс...
Dialogue: 0,0:16:29.58,0:16:33.59,Default,,0,0,0,,Ақари-сенпай қай бағытқа барды?
Dialogue: 0,0:16:33.59,0:16:35.99,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:16:37.59,0:16:39.59,Default,,0,0,0,,Мұнда!
Dialogue: 0,0:16:43.53,0:16:45.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:45.87,0:16:57.48,Default,,0,0,0,,♬～
Dialogue: 0,0:17:00.88,0:17:03.18,Default,,0,0,0,,Ах! о қымбаттым!
Dialogue: 0,0:17:08.56,0:17:10.56,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:17:10.56,0:17:14.56,Default,,0,0,0,,Акари-сан, сол жерге түсейік.
Dialogue: 0,0:17:14.56,0:17:16.90,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:17:16.90,0:17:29.24,Default,,0,0,0,,♬～
Dialogue: 0,0:17:29.24,0:17:32.25,Default,,0,0,0,,Уау~ Бұл керемет...!
Dialogue: 0,0:17:32.25,0:17:37.59,Default,,0,0,0,,Бірақ әлі вистерия гүлдейтін мезгіл емес.
Dialogue: 0,0:17:37.59,0:17:41.52,Default,,0,0,0,,Бұл жерде күн сәулесі жиі түседі, бірақ
Dialogue: 0,0:17:41.52,0:17:45.86,Default,,0,0,0,,Ғимараттармен қоршалған, суық жел соқпайды, солай ма?
Dialogue: 0,0:17:45.86,0:17:48.20,Default,,0,0,0,,Сонымен сырттай салыстырғанда
Dialogue: 0,0:17:48.20,0:17:51.87,Default,,0,0,0,,Гүлдер әрқашан сәл ертерек гүлдейді.
Dialogue: 0,0:17:51.87,0:17:56.17,Default,,0,0,0,,Солай ма? Бұл тамаша.
Dialogue: 0,0:18:00.88,0:18:03.54,Default,,0,0,0,,Амаранта
Dialogue: 0,0:18:03.54,0:18:08.22,Default,,0,0,0,,Мүмкін мен бүгін көрсеткен жер шығар
Dialogue: 0,0:18:08.22,0:18:10.55,Default,,0,0,0,,Барлығы Амарантаға
Dialogue: 0,0:18:10.55,0:18:13.55,Default,,0,0,0,,Сіз бұрын болған жерде болдыңыз ба?
Dialogue: 0,0:18:13.55,0:18:15.56,Default,,0,0,0,,Иә
Dialogue: 0,0:18:15.56,0:18:17.89,Default,,0,0,0,,Шит… шит…
Dialogue: 0,0:18:17.89,0:18:22.23,Default,,0,0,0,,Мен әйтеуір өзім үшін тамаша орын тапқым келді.
Dialogue: 0,0:18:22.23,0:18:24.90,Default,,0,0,0,,Мен сізге хабарладым...
Dialogue: 0,0:18:24.90,0:18:27.20,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:18:33.91,0:18:35.91,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:36.91,0:18:40.85,Default,,0,0,0,,Акари-сан, енді менің жүрегімде
Dialogue: 0,0:18:40.85,0:18:44.85,Default,,0,0,0,,Бүгінгі күннен керемет естеліктерге толы.
Dialogue: 0,0:18:44.85,0:18:47.19,Default,,0,0,0,,Иә? Бірақ...
Dialogue: 0,0:18:47.19,0:18:49.86,Default,,0,0,0,,Бүгін маған көрсеткен жер
Dialogue: 0,0:18:49.86,0:18:53.86,Default,,0,0,0,,Барлығы сенің жүрегіңмен толды.
Dialogue: 0,0:18:53.86,0:18:57.53,Default,,0,0,0,,Нео Венеция қаласындағы менің сүйікті жерім
Dialogue: 0,0:18:57.53,0:19:01.20,Default,,0,0,0,,Сенің жүрегің мені таныстырғың келеді дейді.
Dialogue: 0,0:19:01.20,0:19:04.51,Default,,0,0,0,,Менің жүрегім...
Dialogue: 0,0:19:05.87,0:19:09.54,Default,,0,0,0,,Бұл ең маңыздысы
Dialogue: 0,0:19:09.54,0:19:13.88,Default,,0,0,0,,...
Dialogue: 0,0:19:13.88,0:19:17.22,Default,,0,0,0,,Соңғы бір нәрсе, егер сізде ол жүрек болмаса
Dialogue: 0,0:19:17.22,0:19:20.55,Default,,0,0,0,,Бұл шын мәнінде керемет естелік емес.
Dialogue: 0,0:19:20.55,0:19:24.23,Default,,0,0,0,,Бүгін мен шынымен көргім келген нәрсе болды
Dialogue: 0,0:19:24.23,0:19:27.56,Default,,0,0,0,,Ол мені қызықтыруға бар күшін салады.
Dialogue: 0,0:19:27.56,0:19:30.56,Default,,0,0,0,,Бұл сіздің кім екеніңіз
Dialogue: 0,0:19:30.56,0:19:33.90,Default,,0,0,0,,ARIA компаниясының қонақжайлылық рухы
Dialogue: 0,0:19:33.90,0:19:36.90,Default,,0,0,0,,...
Dialogue: 0,0:19:36.90,0:19:38.91,Default,,0,0,0,,Ал сол сиқыршылар культінің адамдарына келсек—
Dialogue: 0,0:19:40.57,0:19:42.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:47.58,0:19:50.25,Default,,0,0,0,,Уау...!
Dialogue: 0,0:19:50.25,0:19:52.25,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:52.25,0:19:55.26,Default,,0,0,0,,Әй, Айка-чан, Алиса-чан!
Dialogue: 0,0:19:55.26,0:19:58.93,Default,,0,0,0,,…
Dialogue: 0,0:19:58.93,0:20:01.93,Default,,0,0,0,,Tsk, бұл дұрыс емес! Джуниор-чан...хехе
Dialogue: 0,0:20:01.93,0:20:03.93,Default,,0,0,0,,Қандай керемет дос.
Dialogue: 0,0:20:03.93,0:20:06.93,Default,,0,0,0,,Иә өте
Dialogue: 0,0:20:06.93,0:20:09.24,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:20:10.60,0:20:16.61,Default,,0,0,0,,♬～
Dialogue: 0,0:20:16.61,0:20:18.95,Default,,0,0,0,,Сәлем, Акари-сан
Dialogue: 0,0:20:18.95,0:20:21.95,Default,,0,0,0,,...
Dialogue: 0,0:20:21.95,0:20:26.29,Default,,0,0,0,,...
Dialogue: 0,0:20:26.29,0:20:30.62,Default,,0,0,0,,Бастапқыда жалғыз гондоланы арзанға мінетін жүйе болған.
Dialogue: 0,0:20:30.62,0:20:34.96,Default,,0,0,0,,...
Dialogue: 0,0:20:34.96,0:20:39.30,Default,,0,0,0,,...
Dialogue: 0,0:20:39.30,0:20:41.57,Default,,0,0,0,,Бұл құрылған жүйе.
Dialogue: 0,0:20:41.57,0:20:44.24,Default,,0,0,0,,Бойдақ кезімде де
Dialogue: 0,0:20:44.24,0:20:47.91,Default,,0,0,0,,...
Dialogue: 0,0:20:47.91,0:20:50.91,Default,,0,0,0,,Акира-чан мен Афина-чан да.
Dialogue: 0,0:20:50.91,0:20:53.58,Default,,0,0,0,,А, Акира-сан да?
Dialogue: 0,0:20:53.58,0:20:58.59,Default,,0,0,0,,Афина-сенпай қиындық тудырды ма?
Dialogue: 0,0:20:58.59,0:21:04.59,Default,,0,0,0,,...
Dialogue: 0,0:21:06.26,0:21:10.26,Default,,0,0,0,,...
Dialogue: 0,0:21:10.26,0:21:12.27,Default,,0,0,0,,Нео-Венеция қаласы
Dialogue: 0,0:21:12.27,0:21:15.60,Default,,0,0,0,,...
Dialogue: 0,0:21:15.60,0:21:19.94,Default,,0,0,0,,...
Dialogue: 0,0:21:19.94,0:21:22.61,Default,,0,0,0,,Сенің есейгеніңді көру
Dialogue: 0,0:21:22.61,0:21:25.31,Default,,0,0,0,,Ең бақытты
Dialogue: 0,0:21:26.95,0:21:28.95,Default,,0,0,0,,Бұл — бір сәт бұрынғы Итадори ешқашан жасамайтын қимыл
Dialogue: 0,0:21:31.95,0:21:35.96,Default,,0,0,0,,Бір күні ержетіп, прима боламын
Dialogue: 0,0:21:35.96,0:21:39.63,Default,,0,0,0,,...
Dialogue: 0,0:21:39.63,0:21:43.23,Default,,0,0,0,,Иә, мен қуанар едім
Dialogue: 0,0:21:43.23,0:21:45.23,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:45.23,0:21:51.91,Default,,0,0,0,,♬～
Dialogue: 0,0:21:51.91,0:21:54.91,Default,,0,0,0,,...
Dialogue: 0,0:21:54.91,0:21:58.91,Default,,0,0,0,,...
Dialogue: 0,0:21:58.91,0:22:02.25,Default,,0,0,0,,Иә, әрине, тағы кездескенше.
Dialogue: 0,0:22:02.25,0:22:04.25,Default,,0,0,0,,Сонымен, қоштас.
Dialogue: 0,0:22:09.26,0:22:11.93,Default,,0,0,0,,Алисия
Dialogue: 0,0:22:11.93,0:22:16.60,Default,,0,0,0,,Мен прима болу үшін бар күшімді салуым керек.
Dialogue: 0,0:22:16.60,0:22:19.30,Default,,0,0,0,,（）
Dialogue: 0,0:22:23.27,0:22:28.28,Default,,0,0,0,,<Ай-чан, бүгін мен осы нео-Венеция қаласындамын➡
Dialogue: 0,0:22:28.28,0:22:33.61,Default,,0,0,0,,Жоқ, мені бүкіл Аква планетасы бақылап тұрғандай сезіндім.>
Dialogue: 0,0:22:33.61,0:22:36.28,Default,,0,0,0,,<Сен керемет тұтынушы болдың, Акари-сан>
Dialogue: 0,0:22:36.28,0:22:38.29,Default,,0,0,0,,<Мүмкін бұл адам➡
Dialogue: 0,0:22:38.29,0:22:42.22,Default,,0,0,0,,Мүмкін Аква оны Акари-санға жіберген шығар.＞
Dialogue: 0,0:22:42.22,0:22:44.89,Default,,0,0,0,,<Олай деп ойламайсың ба? Акари-сан>
Dialogue: 0,0:22:44.89,0:23:04.91,Default,,0,0,0,,♬～
Dialogue: 0,0:23:04.91,0:23:20.93,Default,,0,0,0,,♬～
Dialogue: 0,0:23:20.93,0:23:35.61,Default,,0,0,0,,♬～
Dialogue: 0,0:23:35.61,0:23:55.56,Default,,0,0,0,,♬～
Dialogue: 0,0:23:55.56,0:24:13.91,Default,,0,0,0,,♬～
Dialogue: 0,0:24:16.28,0:24:19.62,Default,,0,0,0,,<Жаңа дүкен ашылды! > <Не? Не? Қандай дүкен? ＞
Dialogue: 0,0:24:19.62,0:24:21.96,Default,,0,0,0,,<Айқа-сенпай үлкен балаға ұқсайды>
Dialogue: 0,0:24:21.96,0:24:23.96,Default,,0,0,0,,<Не? Сен не туралы айтып тұрсың? ＞
Dialogue: 0,0:24:23.96,0:24:25.96,Default,,0,0,0,,<Келесі жолы...>
Dialogue: 0,0:24:26.96,0:24:28.96,Default,,0,0,0,,<Қолыңызды беріңізші>
Dialogue: 0,0:24:30.46,0:24:36.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory