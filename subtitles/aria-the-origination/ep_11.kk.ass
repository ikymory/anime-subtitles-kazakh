Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.80,0:00:03.80,Default,,0,0,0,,Иә, мен көрдім.
Dialogue: 0,0:00:03.80,0:00:05.80,Default,,0,0,0,,Иә, көп рахмет.
Dialogue: 0,0:00:05.80,0:00:09.81,Default,,0,0,0,,Канагава университетінің орта мектебі Нагината клубы.
Dialogue: 0,0:00:13.74,0:00:16.75,Default,,0,0,0,,Канто турниріне дейінгі жаңа ойыншылар жарысын жақыннан көрсету.
Dialogue: 0,0:00:32.46,0:00:34.46,Default,,0,0,0,,<Хмм, мен жақсы ештеңе ойлай алмаймын>
Dialogue: 0,0:00:34.46,0:00:37.13,Default,,0,0,0,,<Не болды? Сізде әдеттен тыс ойлар бар ма? ＞
Dialogue: 0,0:00:37.13,0:00:40.14,Default,,0,0,0,,<Е... аа, сәл ғана> <Хехе хехе хехе~>
Dialogue: 0,0:00:40.14,0:00:42.47,Default,,0,0,0,,<Сіз жақсы көрінесіз> <Иә! ＞
Dialogue: 0,0:00:42.47,0:00:45.14,Default,,0,0,0,,<Дәл қазір мен толық мотивация режиміндемін.>
Dialogue: 0,0:00:45.14,0:00:47.81,Default,,0,0,0,,<Ха! Барибарин мотивацияланған ханшайым...>
Dialogue: 0,0:00:47.81,0:00:49.81,Default,,0,0,0,,<Не? Бұл> (Президент Химе) <Ня? ＞
Dialogue: 0,0:01:04.79,0:01:09.80,Default,,0,0,0,,(Сөйлесуді тоқтату дауыстары)
Dialogue: 0,0:01:17.47,0:01:20.14,Default,,0,0,0,,Қыз ханшайым
Dialogue: 0,0:01:20.14,0:01:22.41,Default,,0,0,0,,Өзімшіл патшайым
Dialogue: 0,0:01:22.41,0:01:24.75,Default,,0,0,0,,Ханшайым күткендей
Dialogue: 0,0:01:24.75,0:01:26.75,Default,,0,0,0,,Ханшайымға тыйым салу
Dialogue: 0,0:01:26.75,0:01:29.05,Default,,0,0,0,,Жылаушы серенада
Dialogue: 0,0:01:30.09,0:01:32.39,Default,,0,0,0,,Я...
Dialogue: 0,0:01:34.76,0:01:40.10,Default,,0,0,0,,Оның жағдайында жай ғана прима болу жеткіліксіз.
Dialogue: 0,0:01:40.10,0:01:42.10,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:01:43.10,0:01:46.77,Default,,0,0,0,,Эй, сен мұны естідің бе? Элис Кэррол туралы
Dialogue: 0,0:01:46.77,0:01:48.77,Default,,0,0,0,,А, мен білемін.
Dialogue: 0,0:01:48.77,0:01:53.11,Default,,0,0,0,,Жарты ай бұрын сіз жұптан примаға көтерілдіңіз.
Dialogue: 0,0:01:53.11,0:01:57.11,Default,,0,0,0,,Өтірікші, бұл керемет. (Ундине) Бұл тарихта бірінші рет.
Dialogue: 0,0:01:57.11,0:02:00.78,Default,,0,0,0,,Бірақ Айка-сан, сенде бәрі жақсы.
Dialogue: 0,0:02:00.78,0:02:04.09,Default,,0,0,0,,Ауа жақсы болуы мүмкін бе?
Dialogue: 0,0:02:05.12,0:02:09.12,Default,,0,0,0,,Сіздің қарсыласыңыз бәсекелес компанияның келесі эйсі болғандықтан, солай емес пе?
Dialogue: 0,0:02:09.12,0:02:11.46,Default,,0,0,0,,Иә, Химеяның мұрагері ретінде.
Dialogue: 0,0:02:11.46,0:02:14.46,Default,,0,0,0,,Қатты қысымға ұшырады ма деп ойлаймын.
Dialogue: 0,0:02:20.47,0:02:29.41,Default,,0,0,0,,♬～
Dialogue: 0,0:02:29.41,0:02:31.41,Default,,0,0,0,,Я...
Dialogue: 0,0:02:31.41,0:02:51.43,Default,,0,0,0,,♬～
Dialogue: 0,0:02:51.43,0:03:11.45,Default,,0,0,0,,♬～
Dialogue: 0,0:03:11.45,0:03:31.41,Default,,0,0,0,,♬～
Dialogue: 0,0:03:31.41,0:03:51.43,Default,,0,0,0,,♬～
Dialogue: 0,0:03:51.43,0:04:10.11,Default,,0,0,0,,♬～
Dialogue: 0,0:04:10.11,0:04:12.11,Default,,0,0,0,,♬～
Dialogue: 0,0:04:16.45,0:04:19.79,Default,,0,0,0,,Маған қолыңызды беріңізші. (Күйеуі) Ой, кешіріңіз.
Dialogue: 0,0:04:19.79,0:04:23.39,Default,,0,0,0,,Сақ болыңыз (күйеуі)
Dialogue: 0,0:04:26.06,0:04:29.73,Default,,0,0,0,,Бүгін көптеген пилоттық гид дүкендерінің ішінен.
Dialogue: 0,0:04:29.73,0:04:33.40,Default,,0,0,0,,Himeya-ны таңдағаныңызға рахмет.
Dialogue: 0,0:04:33.40,0:04:37.07,Default,,0,0,0,,Көңілді болды (күйеуі) Ах, гондола керемет болды!
Dialogue: 0,0:04:37.07,0:04:39.07,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:39.07,0:04:42.74,Default,,0,0,0,,Сіздің сапарыңыз есте қаларлықтай болады деп сенеміз.
Dialogue: 0,0:04:42.74,0:04:45.75,Default,,0,0,0,,Сізге ең жақсы тілектерімді білдіремін.
Dialogue: 0,0:04:45.75,0:04:49.75,Default,,0,0,0,,Жақында прима боласыз деп үміттенемін. (Күйеуі) Мен сені сүйем.
Dialogue: 0,0:04:49.75,0:04:53.09,Default,,0,0,0,,Рахмет, мен бар күшімді саламын.
Dialogue: 0,0:04:53.09,0:04:58.09,Default,,0,0,0,,Болашақта Химеямен жұмыс істеуді асыға күтеміз!
Dialogue: 0,0:04:58.09,0:05:01.10,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:05:01.10,0:05:03.77,Default,,0,0,0,,Са-тето... (Акира) Ммм...
Dialogue: 0,0:05:03.77,0:05:08.10,Default,,0,0,0,,Нуна Муу...
Dialogue: 0,0:05:08.10,0:05:12.44,Default,,0,0,0,,Не болды? Акира-сан, жоқ...
Dialogue: 0,0:05:12.44,0:05:14.78,Default,,0,0,0,,Ха! Мүмкін мен
Dialogue: 0,0:05:14.78,0:05:17.78,Default,,0,0,0,,Туристік ақпарат Мен қате айттым ба?
Dialogue: 0,0:05:17.78,0:05:21.05,Default,,0,0,0,,Ой, жоқ... Солай ма?
Dialogue: 0,0:05:21.05,0:05:23.39,Default,,0,0,0,,Сіз бір жерде жылдамдықты шектедіңіз бе?
Dialogue: 0,0:05:23.39,0:05:25.72,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:05:25.72,0:05:27.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:27.72,0:05:30.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:30.73,0:05:32.73,Default,,0,0,0,,Айка! иә!
Dialogue: 0,0:05:35.06,0:05:37.40,Default,,0,0,0,,А…?
Dialogue: 0,0:05:37.40,0:05:41.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:41.74,0:05:45.74,Default,,0,0,0,,Мен бүгін түнгі круизді жоспарладым.
Dialogue: 0,0:05:45.74,0:05:47.74,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:05:47.74,0:05:50.75,Default,,0,0,0,,Мен де көмекші ретінде атқа мінуді жоспарлап отырмын.
Dialogue: 0,0:05:50.75,0:05:53.08,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:05:53.08,0:05:55.75,Default,,0,0,0,,Өткен күні мен дәмді желато дүкенін таптым.
Dialogue: 0,0:05:55.75,0:05:59.35,Default,,0,0,0,,Қазір танысуды бастайық. Иә.
Dialogue: 0,0:06:01.09,0:06:04.09,Default,,0,0,0,,Иә, Лимон, рахмет.
Dialogue: 0,0:06:04.09,0:06:06.76,Default,,0,0,0,,Уау~ Дәмді көрінеді!
Dialogue: 0,0:06:06.76,0:06:09.43,Default,,0,0,0,,Акира тамақ ішпей ме?
Dialogue: 0,0:06:09.43,0:06:12.43,Default,,0,0,0,,О, мен қарсы емеспін.
Dialogue: 0,0:06:12.43,0:06:15.84,Default,,0,0,0,,Цукияэ деп айтқан Акира-сан ба?
Dialogue: 0,0:06:16.77,0:06:19.11,Default,,0,0,0,,Жарайды, ризашылықпен тамақтан.
Dialogue: 0,0:06:19.11,0:06:22.81,Default,,0,0,0,,А, иә, мен аламын.
Dialogue: 0,0:06:28.05,0:06:31.35,Default,,0,0,0,,Хмм, тамаша.
Dialogue: 0,0:06:36.73,0:06:42.03,Default,,0,0,0,,Бұл өте дәмді. Акира да жесе екен.
Dialogue: 0,0:06:43.73,0:06:46.40,Default,,0,0,0,,Сіз жақсы көрінесіз.
Dialogue: 0,0:06:46.40,0:06:50.81,Default,,0,0,0,,А... Иә, жақсы жүрсің!
Dialogue: 0,0:06:52.41,0:06:54.74,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:54.74,0:06:58.08,Default,,0,0,0,,Мұны Акира-сан да біледі, солай ма? (Акира) Иә?
Dialogue: 0,0:06:58.08,0:07:03.42,Default,,0,0,0,,Бұл кіші скипте Примаға көтерілді.
Dialogue: 0,0:07:03.42,0:07:07.76,Default,,0,0,0,,Мен Акаримен бірге сол сәттің куәсі болдым.
Dialogue: 0,0:07:07.76,0:07:10.09,Default,,0,0,0,,Менің жолым болды.
Dialogue: 0,0:07:10.09,0:07:14.76,Default,,0,0,0,,Сіз де қатыстыңыз ба? Иә, тамаша арнайы орындықтар
Dialogue: 0,0:07:14.76,0:07:17.10,Default,,0,0,0,,Бір қолғапты алғаннан кейін
Dialogue: 0,0:07:17.10,0:07:19.77,Default,,0,0,0,,Екіншісі де алынады.
Dialogue: 0,0:07:19.77,0:07:23.71,Default,,0,0,0,,Неге сонша таң қалдың, кенже?
Dialogue: 0,0:07:23.71,0:07:27.38,Default,,0,0,0,,Данышпан қыздар әр нәрсені басқаша жасайды.
Dialogue: 0,0:07:27.38,0:07:29.78,Default,,0,0,0,,Мен де ұтыла алмаймын!
Dialogue: 0,0:07:31.38,0:07:34.05,Default,,0,0,0,,Айка…
Dialogue: 0,0:07:34.05,0:07:38.05,Default,,0,0,0,,Ертеңге барайық!
Dialogue: 0,0:07:45.06,0:07:49.06,Default,,0,0,0,,Жетер... Жетер, Айка.
Dialogue: 0,0:07:50.40,0:07:52.73,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:52.73,0:07:55.40,Default,,0,0,0,,Ха... Акира-сан!
Dialogue: 0,0:07:55.40,0:08:00.74,Default,,0,0,0,,Химеяның Айка С. Гранчеста дәл қазір жанып жатыр.
Dialogue: 0,0:08:00.74,0:08:04.41,Default,,0,0,0,,Жүгіргенде, сенен сәл жылдамырақ адам тұрғанда
Dialogue: 0,0:08:04.41,0:08:07.42,Default,,0,0,0,,Тартылып бара жатқандай сезім Бұл болды!
Dialogue: 0,0:08:07.42,0:08:11.09,Default,,0,0,0,,Әдеттегіден тезірек жүгіре алатындай сезім
Dialogue: 0,0:08:11.09,0:08:15.42,Default,,0,0,0,,Бұл сіздің Undine ретінде одан да көп прогреске жету мүмкіндігіңіз.
Dialogue: 0,0:08:15.42,0:08:17.43,Default,,0,0,0,,Акира-сан
Dialogue: 0,0:08:17.43,0:08:22.36,Default,,0,0,0,,Кішіме алғысым шексіз.
Dialogue: 0,0:08:22.36,0:08:25.37,Default,,0,0,0,,Осы сезімді сезіне білу
Dialogue: 0,0:08:27.70,0:08:31.04,Default,,0,0,0,,Акира-сан, қатты жаттыға бер.
Dialogue: 0,0:08:31.04,0:08:36.04,Default,,0,0,0,,Енді маған қанша ауыр сөз айтса да, жарайды!
Dialogue: 0,0:08:40.05,0:08:42.72,Default,,0,0,0,,Хм хехехе...
Dialogue: 0,0:08:42.72,0:08:58.07,Default,,0,0,0,,♬～
Dialogue: 0,0:08:58.07,0:09:00.07,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:00.07,0:09:04.41,Default,,0,0,0,,Иә, бұл жаман болды хаха...
Dialogue: 0,0:09:04.41,0:09:09.08,Default,,0,0,0,,Айка Келесі айдағы мерекелерге қандай жоспарларыңыз бар?
Dialogue: 0,0:09:09.08,0:09:11.75,Default,,0,0,0,,Аа, мен бұл күні мүлдем жұмыссыз қалдым.
Dialogue: 0,0:09:11.75,0:09:15.75,Default,,0,0,0,,Мен Аль-кунмен бірге дүкен аралауға барамын. Хе, мияу...
Dialogue: 0,0:09:15.75,0:09:18.09,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:18.09,0:09:20.42,Default,,0,0,0,,Жарайды, бас тартыңыз.
Dialogue: 0,0:09:20.42,0:09:22.36,Default,,0,0,0,,Гясу! (Президент Химе) Мяу~
Dialogue: 0,0:09:22.36,0:09:26.69,Default,,0,0,0,,Бұл менің демалысым бар жалғыз күн, сондықтан мен сені сол күні менімен бірге өткізуге рұқсат етемін.
Dialogue: 0,0:09:26.69,0:09:29.36,Default,,0,0,0,,Мұндай өлтіру ...
Dialogue: 0,0:09:29.36,0:09:31.70,Default,,0,0,0,,Бұрын сіздің рухыңызға не болды?
Dialogue: 0,0:09:31.70,0:09:35.30,Default,,0,0,0,,Иә? (Қағаздың қайта бүктелген дыбысы)
Dialogue: 0,0:09:36.70,0:09:39.31,Default,,0,0,0,,Қараңызшы, иә?
Dialogue: 0,0:09:41.71,0:09:46.05,Default,,0,0,0,,«Нағыз ханшайым» Сіз нені айтасыз? Бұл
Dialogue: 0,0:09:46.05,0:09:49.38,Default,,0,0,0,,«Вагамама патшайымы Отоме ханшайымы➡
Dialogue: 0,0:09:49.38,0:09:51.39,Default,,0,0,0,,Crybaby серенадасы»
Dialogue: 0,0:09:51.39,0:09:53.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:53.72,0:09:56.72,Default,,0,0,0,,«Розен»…
Dialogue: 0,0:09:56.72,0:09:58.73,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:58.73,0:10:04.33,Default,,0,0,0,,Қайсысы жақсы? Оның тілегін де тыңдау керек сияқты.
Dialogue: 0,0:10:05.40,0:10:08.40,Default,,0,0,0,,Акира-сан…
Dialogue: 0,0:10:08.40,0:10:11.11,Default,,0,0,0,,Құлап қалсаң, қабылдамаймын.
Dialogue: 0,0:10:16.41,0:10:19.41,Default,,0,0,0,,Мәртебелі болашақ патшайым
Dialogue: 0,0:10:19.41,0:10:27.76,Default,,0,0,0,,♬～
Dialogue: 0,0:10:27.76,0:10:29.76,Default,,0,0,0,,Мияу
Dialogue: 0,0:10:29.76,0:10:31.76,Default,,0,0,0,,Мм...!
Dialogue: 0,0:10:34.10,0:10:36.10,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:41.44,0:10:43.44,Default,,0,0,0,,Иә
Dialogue: 0,0:10:46.11,0:10:48.11,Default,,0,0,0,,Уау
Dialogue: 0,0:10:49.78,0:10:52.38,Default,,0,0,0,,Уфуфу (Президент Химе) Мяу~
Dialogue: 0,0:10:55.12,0:10:59.45,Default,,0,0,0,,Сонда да бұл мыжылған қағаз жоқ.
Dialogue: 0,0:10:59.45,0:11:02.12,Default,,0,0,0,,Уау! шулы
Dialogue: 0,0:11:02.12,0:11:07.13,Default,,0,0,0,,<Барлығы менің сүйікті Розен патшайымның атынан>
Dialogue: 0,0:11:29.82,0:11:39.16,Default,,0,0,0,,♬～
Dialogue: 0,0:11:39.16,0:11:41.83,Default,,0,0,0,,Апельсин ханшайымы
Dialogue: 0,0:11:41.83,0:11:44.83,Default,,0,0,0,,Иә? қызғылт сары ханшайым
Dialogue: 0,0:11:47.84,0:11:50.84,Default,,0,0,0,,Апельсин ханшайымы?
Dialogue: 0,0:11:53.51,0:11:57.18,Default,,0,0,0,,Апельсин ханшайымы! Ха ха...
Dialogue: 0,0:11:57.18,0:12:00.18,Default,,0,0,0,,Элис Кэрролл Иә!
Dialogue: 0,0:12:01.85,0:12:04.85,Default,,0,0,0,,Менің лақап атыма үйренуім керек.
Dialogue: 0,0:12:04.85,0:12:08.86,Default,,0,0,0,,Резервтері бар тұтынушылар осында. Кешіріңіз.
Dialogue: 0,0:12:10.86,0:12:14.20,Default,,0,0,0,,<Прима болғаннан кейін менің күндерім тастап кетуге толы болды>
Dialogue: 0,0:12:14.20,0:12:17.20,Default,,0,0,0,,<Әр күн бас айналу қарқынымен өтеді>
Dialogue: 0,0:12:19.53,0:12:23.20,Default,,0,0,0,,<Ойлануға уақытым бола қалса, тез мазасызданатын мен үшін➡
Dialogue: 0,0:12:23.20,0:12:26.21,Default,,0,0,0,,Бұл дұрыс сома екеніне сенімдімін>
Dialogue: 0,0:12:27.81,0:12:31.48,Default,,0,0,0,,Маған көмектесіңізші. Рақмет сізге.
Dialogue: 0,0:12:31.48,0:12:51.17,Default,,0,0,0,,♬～
Dialogue: 0,0:12:51.17,0:12:53.17,Default,,0,0,0,,♬～
Dialogue: 0,0:12:53.17,0:12:55.50,Default,,0,0,0,,Бұл күрсіну көпірі
Dialogue: 0,0:12:55.50,0:12:58.51,Default,,0,0,0,,Сырты тұтас тастан жасалған.
Dialogue: 0,0:12:58.51,0:13:02.84,Default,,0,0,0,,Бір ғажабы, іші ағаштан жасалған. (Қария)
Dialogue: 0,0:13:02.84,0:13:06.18,Default,,0,0,0,,Кейінірек барайық. (Қария) Дұрыс.
Dialogue: 0,0:13:06.18,0:13:09.85,Default,,0,0,0,,Қаласаңыз, мен турға тапсырыс бергім келеді.
Dialogue: 0,0:13:09.85,0:13:13.86,Default,,0,0,0,,Сізге қалай ұнайды? (Қария) О, бұл көмектеседі.
Dialogue: 0,0:13:13.86,0:13:17.53,Default,,0,0,0,,Мен сенен бір жақсылық сұрайын ба?
Dialogue: 0,0:13:17.53,0:13:19.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:21.86,0:13:24.53,Default,,0,0,0,,<Ақәрі-сенпай мен Айқа-сенпай>
Dialogue: 0,0:13:24.53,0:13:27.94,Default,,0,0,0,,<Бірлескен тәжірибеде екеуміз де бар күшімізді саламыз>
Dialogue: 0,0:13:31.47,0:13:34.81,Default,,0,0,0,,Ай көрген күннен бастап...
Dialogue: 0,0:13:34.81,0:13:37.15,Default,,0,0,0,,Ум... А, иә!
Dialogue: 0,0:13:37.15,0:13:41.15,Default,,0,0,0,,Ундин мырза, бұл арал қалай аталады?
Dialogue: 0,0:13:41.15,0:13:44.15,Default,,0,0,0,,Сан-Джорджо-Маджиор аралы
Dialogue: 0,0:13:44.15,0:13:48.16,Default,,0,0,0,,Сол қоңырау мұнарасына көтерілсеңіз, жағалаудың панорамалық көрінісін көре аласыз.
Dialogue: 0,0:13:48.16,0:13:52.16,Default,,0,0,0,,Олай болса, Күрсіну көпірінен өткен соң, сол жаққа да барайық.
Dialogue: 0,0:13:52.16,0:13:54.16,Default,,0,0,0,,Иә
Dialogue: 0,0:13:58.50,0:14:03.84,Default,,0,0,0,,<Соңғы уақытқа дейін біз күнде бірге болдық...>
Dialogue: 0,0:14:03.84,0:14:07.14,Default,,0,0,0,,<Мен сені көптен бері көрмедім.>
Dialogue: 0,0:14:11.18,0:14:15.52,Default,,0,0,0,,Еңбегің үшін рахмет.Еңбегің үшін рахмет
Dialogue: 0,0:14:15.52,0:14:20.22,Default,,0,0,0,,Әй, бұл өте ұзақ! Соңғы кездері осылай...
Dialogue: 0,0:14:23.19,0:14:28.20,Default,,0,0,0,,<Кенеттен сені көруге барсам жаман болар еді, сондықтан саған хабарлаймын.>
Dialogue: 0,0:14:32.80,0:14:34.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:35.80,0:14:39.14,Default,,0,0,0,,<Мен сенімен түнде кездескім келетініне сене алар емеспін➡
Dialogue: 0,0:14:39.14,0:14:41.81,Default,,0,0,0,,Бұл, әрине, ыңғайсыздық>
Dialogue: 0,0:14:41.81,0:14:44.11,Default,,0,0,0,,<Жалпы себеп жоқ>
Dialogue: 0,0:14:45.81,0:14:49.82,Default,,0,0,0,,<Триггер жоқ...>
Dialogue: 0,0:14:49.82,0:14:57.49,Default,,0,0,0,,♬～
Dialogue: 0,0:14:57.49,0:15:00.16,Default,,0,0,0,,Афина-сенпай, кешігіп қаласыз.
Dialogue: 0,0:15:00.16,0:15:02.16,Default,,0,0,0,,Не? Иә...
Dialogue: 0,0:15:02.16,0:15:05.50,Default,,0,0,0,,Хмм... у...
Dialogue: 0,0:15:05.50,0:15:08.17,Default,,0,0,0,,Ах! мен барамын
Dialogue: 0,0:15:08.17,0:15:11.84,Default,,0,0,0,,Ал, келіңдер.
Dialogue: 0,0:15:11.84,0:15:13.84,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:15:16.84,0:15:19.18,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:15:19.18,0:15:21.48,Default,,0,0,0,,Ал...
Dialogue: 0,0:15:25.52,0:15:29.52,Default,,0,0,0,,<Бәрі жақсы, басқасы бар ма?>
Dialogue: 0,0:15:30.46,0:15:32.46,Default,,0,0,0,,<Бірдеңе...>
Dialogue: 0,0:15:36.13,0:15:39.13,Default,,0,0,0,,Бұл ғимаратта жөндеу жұмыстары жүргізілуде.
Dialogue: 0,0:15:39.13,0:15:44.44,Default,,0,0,0,,Санта-Мария делла Салют насыбайгүлі 17 ғасырда салынған.
Dialogue: 0,0:15:46.47,0:15:49.81,Default,,0,0,0,,Бұл «Тухоу Кенроку» деген атпен белгілі
Dialogue: 0,0:15:49.81,0:15:52.81,Default,,0,0,0,,Венеция саудагері Марко Полоның туған жері
Dialogue: 0,0:15:52.81,0:15:54.82,Default,,0,0,0,,Қалпына келтірілді
Dialogue: 0,0:15:54.82,0:15:58.49,Default,,0,0,0,,Қазіргі уақытта ол мемориалдық зал ретінде жұртшылық үшін ашық.
Dialogue: 0,0:15:58.49,0:16:02.89,Default,,0,0,0,,Егер сіз осы аймақта болсаңыз, неге тоқтамасқа?
Dialogue: 0,0:16:04.83,0:16:06.83,Default,,0,0,0,,Писани Моретта сарайы
Dialogue: 0,0:16:06.83,0:16:09.83,Default,,0,0,0,,Сондай-ақ ол маскарадтық шарлар өткізілетін орын ретінде де танымал және т.б.
Dialogue: 0,0:16:09.83,0:16:13.50,Default,,0,0,0,,Готикалық интерьер сәнді.
Dialogue: 0,0:16:13.50,0:16:26.45,Default,,0,0,0,,♬～
Dialogue: 0,0:16:26.45,0:16:29.78,Default,,0,0,0,,О~ (Әйел) Жарайды...
Dialogue: 0,0:16:29.78,0:16:41.80,Default,,0,0,0,,♬～
Dialogue: 0,0:16:41.80,0:16:45.47,Default,,0,0,0,,Уми! (Алиса/Ана) Хехехе...
Dialogue: 0,0:16:45.47,0:16:48.14,Default,,0,0,0,,Әрі қарай жүрейік.
Dialogue: 0,0:16:48.14,0:16:51.14,Default,,0,0,0,,Кампанил (ысырма дыбысы)
Dialogue: 0,0:16:52.14,0:16:55.14,Default,,0,0,0,,Бұл қызықты болды. (Бала) Иә, қызық болды!
Dialogue: 0,0:16:55.14,0:16:57.81,Default,,0,0,0,,Гондоламен жүру өте ыңғайлы.
Dialogue: 0,0:16:57.81,0:17:01.15,Default,,0,0,0,,Келесі жолы мен Акваға келгенде, Алисадан сұраймын.
Dialogue: 0,0:17:01.15,0:17:03.15,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:03.15,0:17:05.49,Default,,0,0,0,,Олай болса (ана) сау болыңыз
Dialogue: 0,0:17:05.49,0:17:08.16,Default,,0,0,0,,Қош бол
Dialogue: 0,0:17:08.16,0:17:10.86,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:17:11.83,0:17:13.83,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:17:13.83,0:17:15.83,Default,,0,0,0,,Ах
Dialogue: 0,0:17:18.17,0:17:20.47,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:17:22.17,0:17:24.51,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:17:24.51,0:17:27.78,Default,,0,0,0,,Мен оны апама беремін, иә?
Dialogue: 0,0:17:27.78,0:17:34.12,Default,,0,0,0,,♬～
Dialogue: 0,0:17:34.12,0:17:37.79,Default,,0,0,0,,Хехе, рахмет
Dialogue: 0,0:17:37.79,0:17:39.79,Default,,0,0,0,,Чип! Чип, чип, чип, чип!
Dialogue: 0,0:17:41.46,0:17:44.46,Default,,0,0,0,,Қалай болды? (Анасы) Әпкесі: Не?
Dialogue: 0,0:17:44.46,0:17:46.46,Default,,0,0,0,,«Рахмет»
Dialogue: 0,0:17:46.46,0:17:49.80,Default,,0,0,0,,Мен көремін. Бұл жақсы. (Бала) Иә.
Dialogue: 0,0:17:49.80,0:17:52.47,Default,,0,0,0,,Ей, кешкі асқа не жеу керек?
Dialogue: 0,0:17:52.47,0:17:54.80,Default,,0,0,0,,Иә... Не жегің келеді?
Dialogue: 0,0:17:54.80,0:17:57.47,Default,,0,0,0,,Өте дәмді!
Dialogue: 0,0:17:57.47,0:18:00.47,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:18:00.47,0:18:20.49,Default,,0,0,0,,♬～
Dialogue: 0,0:18:20.49,0:18:31.44,Default,,0,0,0,,♬～
Dialogue: 0,0:18:31.44,0:18:35.44,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Орамал үшін рахмет.
Dialogue: 0,0:18:35.44,0:18:38.45,Default,,0,0,0,,О, оны сонда қалдырыңыз.
Dialogue: 0,0:18:38.45,0:18:57.47,Default,,0,0,0,,♬～
Dialogue: 0,0:18:57.47,0:19:03.14,Default,,0,0,0,,<Әр күн қиын, бірақ қызықты нәрселер де көп➡
Dialogue: 0,0:19:03.14,0:19:07.81,Default,,0,0,0,,Менің айтқым келетін нәрселер өте көп...>
Dialogue: 0,0:19:07.81,0:19:13.81,Default,,0,0,0,,<Мен сенімен танысқым келеді, бірақ бұл өте қиын>
Dialogue: 0,0:19:16.82,0:19:21.12,Default,,0,0,0,,<Мен сені осылай мәңгі көре алмаймын ба деп ойлаймын>
Dialogue: 0,0:19:23.16,0:19:25.16,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:25.16,0:19:28.43,Default,,0,0,0,,<Пеши Пеши Пеши Пеши, қандай үлкен сұмдық>
Dialogue: 0,0:19:28.43,0:19:33.13,Default,,0,0,0,,<Айқа-сенпай маған үнемі теріс ойлама> деп айтатын
Dialogue: 0,0:19:36.77,0:19:43.11,Default,,0,0,0,,♬～
Dialogue: 0,0:19:43.11,0:19:45.78,Default,,0,0,0,,Мен өзімді жалғыз сезінемін...
Dialogue: 0,0:19:45.78,0:19:54.79,Default,,0,0,0,,♬～
Dialogue: 0,0:20:04.13,0:20:08.44,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:20:11.14,0:20:14.84,Default,,0,0,0,,⚟Иә
Dialogue: 0,0:20:16.48,0:20:18.81,Default,,0,0,0,,Мен үйге жаңа ғана оралдым.
Dialogue: 0,0:20:18.81,0:20:23.82,Default,,0,0,0,,(Барлығының күбірлеген дауыстары)
Dialogue: 0,0:20:28.82,0:20:30.83,Default,,0,0,0,,⚟ Өшпейді!
Dialogue: 0,0:20:30.83,0:20:33.49,Default,,0,0,0,,Бұл сағатта сізге не керек?
Dialogue: 0,0:20:33.49,0:20:37.83,Default,,0,0,0,,Жарайсыңдар! Сіз айтқандай, мен жол бойы келдім.
Dialogue: 0,0:20:37.83,0:20:41.50,Default,,0,0,0,,Біз баратын пицца бар, солай ма?
Dialogue: 0,0:20:41.50,0:20:43.84,Default,,0,0,0,,Бұл жаңа жұмыс
Dialogue: 0,0:20:43.84,0:20:48.18,Default,,0,0,0,,Өте дәмді дейді, сондықтан бәріміз бірге қолданып көрейік деп ойладым.
Dialogue: 0,0:20:48.18,0:20:53.18,Default,,0,0,0,,Жүр, жылы болғанша тамақтанайық. (Президент Ария) Пуи Пуи Пуи Пуи Пуи
Dialogue: 0,0:20:53.18,0:20:55.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:55.85,0:20:59.19,Default,,0,0,0,,Енді тамақтанайық (Президент Ария) Пупупуиню~!
Dialogue: 0,0:20:59.19,0:21:02.86,Default,,0,0,0,,Уау! Менің де қарным ашты~
Dialogue: 0,0:21:02.86,0:21:06.53,Default,,0,0,0,,Мен банандарды көп жесем де, мен үлкен тойымсызмын.
Dialogue: 0,0:21:06.53,0:21:08.53,Default,,0,0,0,,Нуна
Dialogue: 0,0:21:08.53,0:21:13.53,Default,,0,0,0,,♬～
Dialogue: 0,0:21:13.53,0:21:17.54,Default,,0,0,0,,<Әдеттегі үш адам, әдеттегі әңгіме➡
Dialogue: 0,0:21:17.54,0:21:21.54,Default,,0,0,0,,Әдеттегі уақыт, әдеттегі атмосфера>
Dialogue: 0,0:21:21.54,0:21:25.81,Default,,0,0,0,,<Осы уақытқа дейін мен сені енді ешқашан көрмесем, не істер едім деп ойладым>
Dialogue: 0,0:21:25.81,0:21:29.48,Default,,0,0,0,,<Сізбен кездескім келсе де уақытым да, мүмкіндігім де жоқ➡
Dialogue: 0,0:21:29.48,0:21:32.19,Default,,0,0,0,,Мен солай ойладым...>
Dialogue: 0,0:21:34.16,0:21:39.49,Default,,0,0,0,,Күте тұрыңыз~ Сіз бұл туралы ойладыңыз ба? Бұл кішінің жаман әдеті.
Dialogue: 0,0:21:39.49,0:21:43.16,Default,,0,0,0,,Иә!? Мен оны тікелей айттым ба?
Dialogue: 0,0:21:43.16,0:21:45.17,Default,,0,0,0,,Иә, ол жерде болды.
Dialogue: 0,0:21:45.17,0:21:50.84,Default,,0,0,0,,Уақыт деген нәрсе жоқ, оны осылай жасау үшін өзіңізді күштеп алу керек.
Dialogue: 0,0:21:50.84,0:21:52.84,Default,,0,0,0,,Бірақ... иә?
Dialogue: 0,0:21:52.84,0:21:55.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:55.18,0:21:59.18,Default,,0,0,0,,Бірақ ешқандай себеп жоқ.
Dialogue: 0,0:21:59.18,0:22:03.52,Default,,0,0,0,,Мен соңғы кездері қатты тығылып қалдым.
Dialogue: 0,0:22:03.52,0:22:08.19,Default,,0,0,0,,Мына пицца сияқты менде кездесетін ештеңе жоқ.
Dialogue: 0,0:22:08.19,0:22:12.53,Default,,0,0,0,,Менде ештеңе жоқ...
Dialogue: 0,0:22:12.53,0:22:17.87,Default,,0,0,0,,♬～
Dialogue: 0,0:22:17.87,0:22:20.53,Default,,0,0,0,,Иә, иә?
Dialogue: 0,0:22:20.53,0:22:24.87,Default,,0,0,0,,Алиса Чан жоқ па? (Айка/Алис) Хмм?
Dialogue: 0,0:22:24.87,0:22:29.48,Default,,0,0,0,,Кездесуге мүмкіндік немесе арнайы себеп қажет емес.
Dialogue: 0,0:22:29.48,0:22:32.15,Default,,0,0,0,,Алиса жеткілікті
Dialogue: 0,0:22:32.15,0:22:34.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:35.48,0:22:39.82,Default,,0,0,0,,Иә, ұятсыз жолдарға тыйым салынады! Иә~
Dialogue: 0,0:22:39.82,0:22:58.84,Default,,0,0,0,,♬～
Dialogue: 0,0:22:58.84,0:23:00.84,Default,,0,0,0,,♬～
Dialogue: 0,0:23:00.84,0:23:02.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:02.84,0:23:07.45,Default,,0,0,0,,Кішімнен жеңілмеу үшін бар күшімді саламын.
Dialogue: 0,0:23:09.52,0:23:11.85,Default,,0,0,0,,Мен де
Dialogue: 0,0:23:11.85,0:23:14.19,Default,,0,0,0,,Хехехе
Dialogue: 0,0:23:14.19,0:23:17.52,Default,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,0:23:17.52,0:23:20.53,Default,,0,0,0,,Хм
Dialogue: 0,0:23:22.20,0:23:26.50,Default,,0,0,0,,<Осы дос болса, жарайды.>
Dialogue: 0,0:23:30.80,0:23:50.82,Default,,0,0,0,,♬～
Dialogue: 0,0:23:50.82,0:24:10.84,Default,,0,0,0,,♬～
Dialogue: 0,0:24:10.84,0:24:30.80,Default,,0,0,0,,♬～
Dialogue: 0,0:24:30.80,0:24:50.82,Default,,0,0,0,,♬～
Dialogue: 0,0:24:50.82,0:24:59.83,Default,,0,0,0,,♬～
Dialogue: 0,0:25:01.83,0:25:06.83,Default,,0,0,0,,<Мен бұл күнді күттім, Мен саған әрқашан сүйсіндім>
Dialogue: 0,0:25:06.83,0:25:09.17,Default,,0,0,0,,<Және бұдан былай да>
