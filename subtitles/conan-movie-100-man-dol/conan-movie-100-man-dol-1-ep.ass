Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:36.57,0:00:39.58,Default,,0,0,0,,Бұл Сейрио қылыш.
Dialogue: 0,0:00:50.25,0:00:52.38,Default,,0,0,0,,- (Солдат) Орындайық! -(Мачида) А...
Dialogue: 0,0:00:52.46,0:00:54.38,Default,,0,0,0,,Үкімет әскері?
Dialogue: 0,0:00:54.47,0:00:56.38,Default,,0,0,0,,Хиджиката: Дайын бол!
Dialogue: 0,0:00:56.47,0:00:57.51,Default,,0,0,0,,Ну... Уф
Dialogue: 0,0:00:58.43,0:00:59.26,Default,,0,0,0,,Не болды?
Dialogue: 0,0:00:59.85,0:01:03.52,Default,,0,0,0,,Неліктен тоқтап, жеңу мүмкіндігін жіберіп алу керек?
Dialogue: 0,0:01:04.27,0:01:05.60,Default,,0,0,0,,Яаааа!
Dialogue: 0,0:01:07.10,0:01:08.23,Default,,0,0,0,,Аһ!
Dialogue: 0,0:01:09.19,0:01:10.40,Default,,0,0,0,,Аһ!
Dialogue: 0,0:01:13.61,0:01:14.82,Default,,0,0,0,,Гах...
Dialogue: 0,0:01:14.90,0:01:16.65,Default,,0,0,0,,Аһ!
Dialogue: 0,0:01:28.58,0:01:29.67,Default,,0,0,0,,Жұлдыз?
Dialogue: 0,0:01:31.50,0:01:33.67,Default,,0,0,0,,Сенімді болыңыз
Dialogue: 0,0:01:33.76,0:01:36.93,Default,,0,0,0,,Мен бұл сейфте вакизаши бар екенін растадым.
Dialogue: 0,0:01:37.51,0:01:39.43,Default,,0,0,0,,Қазіргі уақытта сағат 22.00.
Dialogue: 0,0:01:39.51,0:01:42.43,Default,,0,0,0,,Мен оны 2 сағат өткенге дейін бұзуға рұқсат бермеймін.
Dialogue: 0,0:01:43.01,0:01:44.81,Default,,0,0,0,,Бүгін түн ортасы
Dialogue: 0,0:01:44.89,0:01:46.60,Default,,0,0,0,,Такузо Акиге тиесілі
Dialogue: 0,0:01:46.68,0:01:51.48,Default,,0,0,0,,Эйрю Хигашикубоның екі вакизаши шыңға шығады.
Dialogue: 0,0:01:52.23,0:01:53.69,Default,,0,0,0,,Қарғыс атсын, балақай!
Dialogue: 0,0:01:53.78,0:01:56.03,Default,,0,0,0,,Шығудағы металл іздегіш
Dialogue: 0,0:01:56.11,0:01:58.32,Default,,0,0,0,,Оны әрі қарай пайдалануыңызға қарсы емеспін.
Dialogue: 0,0:01:58.40,0:02:02.20,Default,,0,0,0,,Бізде әдетте қатаң қауіпсіздік шаралары бар, бірақ...
Dialogue: 0,0:02:02.28,0:02:04.12,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:02:05.62,0:02:08.21,Default,,0,0,0,,Бүгін түнде кіруге тыйым салынады.
Dialogue: 0,0:02:08.29,0:02:10.71,Default,,0,0,0,,Мен қалпына келтіру үшін ілулі шиыршықты алуға келдім.
Dialogue: 0,0:02:11.29,0:02:12.84,Default,,0,0,0,,<Мен оны «Спайс» деп атаймын➡
Dialogue: 0,0:02:14.71,0:02:16.97,Default,,0,0,0,,- (Жүргізуші) Еңбегіңізге рахмет, қауіпсіздік - (Офицер) Ешқандай проблема жоқ сияқты.
Dialogue: 0,0:02:20.80,0:02:21.97,Default,,0,0,0,,Не?
Dialogue: 0,0:02:22.05,0:02:25.68,Default,,0,0,0,,Дұрыс, мен Сумито Кугаки, заңгермін.
Dialogue: 0,0:02:25.77,0:02:27.27,Default,,0,0,0,,Сізбен байланысу мүмкін емес пе?
Dialogue: 0,0:02:27.35,0:02:29.60,Default,,0,0,0,,Ол үйіне оралған болуы керек!
Dialogue: 0,0:02:29.69,0:02:31.23,Default,,0,0,0,,- (Когоро) Әй! -Апыр-ай!
Dialogue: 0,0:02:31.31,0:02:32.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:32.31,0:02:34.57,Default,,0,0,0,,Садақтар! Өйткені бұл балаларды өлтіруші
Dialogue: 0,0:02:34.65,0:02:36.57,Default,,0,0,0,,Еркін қыдырма!
Dialogue: 0,0:02:36.65,0:02:37.90,Default,,0,0,0,,Біраз қорқынышты, иә?
Dialogue: 0,0:02:38.49,0:02:39.90,Default,,0,0,0,,Хмм... Менің ойымша, бұл жеткіліксіз.
Dialogue: 0,0:02:39.90,0:02:41.20,Default,,0,0,0,,Хм... Менің ойымша, бұл жеткіліксіз.
Dialogue: 0,0:02:39.90,0:02:41.20,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:41.20,0:02:42.57,Default,,0,0,0,,Хмм... Менің ойымша, бұл жеткіліксіз.
Dialogue: 0,0:02:42.66,0:02:44.99,Default,,0,0,0,,Әй, қош келдіңіз ағай.
Dialogue: 0,0:02:45.08,0:02:47.54,Default,,0,0,0,,Әңгіменің ортасында жуынатын бөлмеге барғаным өкінішті.
Dialogue: 0,0:02:47.62,0:02:49.54,Default,,0,0,0,,Ой, сонда да бала бар ма еді?
Dialogue: 0,0:02:49.62,0:02:52.25,Default,,0,0,0,,Иә, мен балаларды өлтірушімін.
Dialogue: 0,0:02:52.33,0:02:53.92,Default,,0,0,0,,Өзіңіз айтпаңыз
Dialogue: 0,0:02:54.00,0:02:56.21,Default,,0,0,0,,Осакадан келген детектив Бауес де менімен бірге.
Dialogue: 0,0:02:56.84,0:02:58.55,Default,,0,0,0,,Менің де барғым келді
Dialogue: 0,0:02:58.63,0:02:59.51,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:02:59.59,0:03:02.05,Default,,0,0,0,,Кейзабуро Акиге не болды?
Dialogue: 0,0:03:02.14,0:03:04.51,Default,,0,0,0,,Ах, Акие отбасының оқиғасы.
Dialogue: 0,0:03:05.10,0:03:07.18,Default,,0,0,0,,негізін қалаушы Кейзабуро Аки,
Dialogue: 0,0:03:07.27,0:03:09.68,Default,,0,0,0,,Хоккайдода белсенді жұмыс істеген кәсіпкер.
Dialogue: 0,0:03:09.77,0:03:12.48,Default,,0,0,0,,Акие Зайбацудың негізін салған адам.
Dialogue: 0,0:03:12.56,0:03:16.36,Default,,0,0,0,,Ол қайтыс болғаннан кейін оның орнына жалғыз ұлы Тадаюки отырды.
Dialogue: 0,0:03:16.44,0:03:18.78,Default,,0,0,0,,Кәсіпкерлікті одан әрі дамыту
Dialogue: 0,0:03:18.86,0:03:20.15,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:20.24,0:03:24.03,Default,,0,0,0,,Алайда екінші ұрпақ Тадаюки де бір жыл бұрын аурудан қайтыс болды.
Dialogue: 0,0:03:24.12,0:03:25.16,Default,,0,0,0,,Үшінші буын...
Dialogue: 0,0:03:26.12,0:03:28.16,Default,,0,0,0,,Тадаюкидің ұлы Такузо
Dialogue: 0,0:03:28.75,0:03:31.83,Default,,0,0,0,,Иә, бірақ мені Такузо-сан ауыстырғаннан кейін.
Dialogue: 0,0:03:31.92,0:03:34.92,Default,,0,0,0,,Бізге қарағанда, бұл бизнес жақсы жүрмейтін сияқты.
Dialogue: 0,0:03:35.59,0:03:38.59,Default,,0,0,0,,Ақшадан қиналып, коллекцияңызды аукционға қойыңыз
Dialogue: 0,0:03:38.67,0:03:43.05,Default,,0,0,0,,Сонымен, барлығын бірге сатып алған Suzuki Zaibatsu болды ма?
Dialogue: 0,0:03:43.13,0:03:45.80,Default,,0,0,0,,Бірақ Баланың көздеген Вакизаши?
Dialogue: 0,0:03:45.89,0:03:47.97,Default,,0,0,0,,Оның Big Jewel-ге қатысы жоқ, солай ма?
Dialogue: 0,0:03:48.06,0:03:49.43,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:03:50.02,0:03:54.44,Default,,0,0,0,,Кейзабуро - Тосизо Хиджикатаның үлкен жанкүйері және оған қатысты барлық нәрсені сатып алады.
Dialogue: 0,0:03:54.52,0:03:56.81,Default,,0,0,0,,Олар мұның бәрін сатып алған сияқты.
Dialogue: 0,0:03:56.90,0:04:00.11,Default,,0,0,0,,Бұл тізімде зергерлік бұйымдар болған жоқ.
Dialogue: 0,0:04:00.19,0:04:01.32,Default,,0,0,0,,Манга салмас бұрын жаттығулар
Dialogue: 0,0:04:01.40,0:04:05.07,Default,,0,0,0,,Кид мақсат етіп отырған Вакизаши соншалықты құнды емес.
Dialogue: 0,0:04:05.16,0:04:10.66,Default,,0,0,0,,Оны Эйрю Хигашикубо есімді белгісіз қылышшы жасаған деп естідім...
Dialogue: 0,0:04:12.62,0:04:13.62,Default,,0,0,0,,Я...
Dialogue: 0,0:04:13.71,0:04:17.21,Default,,0,0,0,,Мен қазір сатып алулар тізімін қайта тексеремін.
Dialogue: 0,0:04:17.29,0:04:21.26,Default,,0,0,0,,Аки отбасының коллекциясы мен тізімі сәйкес келмейді.
Dialogue: 0,0:04:21.34,0:04:23.30,Default,,0,0,0,,Бұл бір ғана кітап.
Dialogue: 0,0:04:23.38,0:04:26.01,Default,,0,0,0,,Сізге рахмет, мен Хакодатеге бара аламын!
Dialogue: 0,0:04:26.09,0:04:29.47,Default,,0,0,0,,Бұл Кид мырзамен кездесу мүмкіндігі болды!
Dialogue: 0,0:04:30.06,0:04:31.18,Default,,0,0,0,,Хаха…
Dialogue: 0,0:04:31.27,0:04:34.19,Default,,0,0,0,,Тек сенімді болу үшін ілулі шиыршықты тексеріңіз.
Dialogue: 0,0:04:35.31,0:04:37.94,Default,,0,0,0,,Мәселе жоқ. Мен оған тағы бір рет қарай аламын ба?
Dialogue: 0,0:04:38.02,0:04:38.86,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:39.48,0:04:40.86,Default,,0,0,0,,(ысырманың ашылу дыбысы)
Dialogue: 0,0:04:41.53,0:04:42.36,Default,,0,0,0,,Жоқ, бұл тек қана тәжірибе.
Dialogue: 0,0:04:44.20,0:04:48.62,Default,,0,0,0,,Хабарлама беріңіз және күзетшіңізді қоймаға қарай бұрыңыз.
Dialogue: 0,0:04:48.70,0:04:52.62,Default,,0,0,0,,Сіз қазір жеткіліксіз жүк тиеу қондырғысынан бірдеңе ұрламақшысыз ба?
Dialogue: 0,0:04:53.41,0:04:55.04,Default,,0,0,0,,А... Әй, сен!
Dialogue: 0,0:04:55.71,0:04:59.04,Default,,0,0,0,,Мен кеше түнде қоймаға жасырын кірдім.
Dialogue: 0,0:04:59.13,0:05:02.88,Default,,0,0,0,,Мен вакизашиды сейфке салмас бұрын жалғанға ауыстырдым.
Dialogue: 0,0:05:03.46,0:05:05.63,Default,,0,0,0,,Негізі мен оны сол қалпында алғым келді.
Dialogue: 0,0:05:05.72,0:05:07.64,Default,,0,0,0,,Шығу қауіпсіздігі тым қатаң
Dialogue: 0,0:05:07.72,0:05:10.43,Default,,0,0,0,,Тіпті елес ұры да бас тартты.
Dialogue: 0,0:05:10.51,0:05:12.39,Default,,0,0,0,,Сіз кімсіз...
Dialogue: 0,0:05:12.47,0:05:16.23,Default,,0,0,0,,Хабарламада «Бүгін түн ортасында» деп жазылған.
Dialogue: 0,0:05:16.31,0:05:19.52,Default,,0,0,0,,Түнгі сағат 12, екі сағаттан кейін.
Dialogue: 0,0:05:19.61,0:05:22.57,Default,,0,0,0,,22 сағат бұрын сағат 12
Dialogue: 0,0:05:22.65,0:05:23.48,Default,,0,0,0,,Басқаша айтқанда—
Dialogue: 0,0:05:23.99,0:05:26.40,Default,,0,0,0,,Кайто Кид 22 сағат бұрын
Dialogue: 0,0:05:26.49,0:05:29.16,Default,,0,0,0,,Екі вакизаши ұрлаған соң
Dialogue: 0,0:05:29.24,0:05:31.66,Default,,0,0,0,,Хабарлама беру?
Dialogue: 0,0:05:32.37,0:05:35.41,Default,,0,0,0,,Мен де сені тексеріп көрейін.
Dialogue: 0,0:05:35.50,0:05:39.54,Default,,0,0,0,,Ол лотерея ұтып алып, отбасымен бірге ыстық бұлаққа саяхаттаған сияқты.
Dialogue: 0,0:05:39.63,0:05:42.71,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:05:43.25,0:05:44.38,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:48.84,0:05:49.68,Default,,0,0,0,,Кеке
Dialogue: 0,0:05:51.76,0:05:53.22,Default,,0,0,0,,- (Хедзи) Маған рұқсат етіңіз! -Эй
Dialogue: 0,0:05:54.14,0:05:55.56,Default,,0,0,0,,-Итадаки! -(Хедзи) Аа.
Dialogue: 0,0:05:55.64,0:05:57.31,Default,,0,0,0,,- (Хейджи) А... - Иә.
Dialogue: 0,0:05:57.39,0:05:58.81,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:58.90,0:06:00.06,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:01.44,0:06:02.27,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:04.61,0:06:05.65,Default,,0,0,0,,Теня да батыр ма?
Dialogue: 0,0:06:06.61,0:06:08.11,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:06:08.20,0:06:09.16,Default,,0,0,0,,Не болды!
Dialogue: 0,0:06:09.91,0:06:10.91,Default,,0,0,0,,Бала?
Dialogue: 0,0:06:10.99,0:06:13.03,Default,,0,0,0,,Phantom Thief Кид осында!
Dialogue: 0,0:06:13.12,0:06:14.29,Default,,0,0,0,,Барлық жерден іздеңіз!
Dialogue: 0,0:06:14.37,0:06:15.41,Default,,0,0,0,,О!
Dialogue: 0,0:06:17.12,0:06:18.54,Default,,0,0,0,,Кайто Бала...
Dialogue: 0,0:06:19.42,0:06:21.29,Default,,0,0,0,,Менің саған өшім бар
Dialogue: 0,0:06:21.38,0:06:24.30,Default,,0,0,0,,Ұмытпа!
Dialogue: 0,0:06:25.38,0:06:28.17,Default,,0,0,0,,Кайто Бала!
Dialogue: 0,0:06:31.76,0:06:32.80,Default,,0,0,0,,Гррр…
Dialogue: 0,0:06:32.89,0:06:34.18,Default,,0,0,0,,Тек сен
Dialogue: 0,0:06:34.26,0:06:37.68,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:06:37.77,0:06:38.98,Default,,0,0,0,,Ол бар, қашып кетпесін!
Dialogue: 0,0:06:39.06,0:06:40.94,Default,,0,0,0,,Сүйіскен кек қорқынышты...
Dialogue: 0,0:06:41.56,0:06:42.56,Default,,0,0,0,,Иә
Dialogue: 0,0:06:44.40,0:06:46.15,Default,,0,0,0,,Ол қашып кетті!
Dialogue: 0,0:06:48.78,0:06:50.03,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:06:52.78,0:06:54.16,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:54.24,0:06:55.58,Default,,0,0,0,,Әрқашан бір қолға ұсталу...
Dialogue: 0,0:06:55.58,0:06:56.95,Default,,0,0,0,,Әрқашан бір қолға ұсталу...
Dialogue: 0,0:06:55.58,0:06:56.95,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:06:56.95,0:06:57.04,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:06:57.04,0:06:58.20,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:06:57.04,0:06:58.20,Default,,0,0,0,,Ах
Dialogue: 0,0:06:58.29,0:06:59.79,Default,,0,0,0,,Кайто Кид бұл...
Dialogue: 0,0:06:59.87,0:07:02.04,Default,,0,0,0,,Әй, не істеп жатырсың!
Dialogue: 0,0:07:03.38,0:07:04.21,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:09.30,0:07:10.51,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:11.84,0:07:13.76,Default,,0,0,0,,Мен саған қашпа дедім ғой!
Dialogue: 0,0:07:14.60,0:07:16.35,Default,,0,0,0,,- (Хедзи) Ах! -Апыр-ай!
Dialogue: 0,0:07:18.64,0:07:20.43,Default,,0,0,0,,Баланы алдау
Dialogue: 0,0:07:20.52,0:07:22.69,Default,,0,0,0,,Бұл жұмыс істей ме? Бұлыңғыр!
Dialogue: 0,0:07:24.15,0:07:25.52,Default,,0,0,0,,Өз күшіңді қалай қолдануды үйрен.
Dialogue: 0,0:07:25.61,0:07:27.19,Default,,0,0,0,,Батыстың детективі
Dialogue: 0,0:07:27.28,0:07:28.32,Default,,0,0,0,,Шулы!
Dialogue: 0,0:07:28.40,0:07:30.53,Default,,0,0,0,,Ой... ой
Dialogue: 0,0:07:30.61,0:07:33.11,Default,,0,0,0,,Бүгін қашып кетуіме жол берме!
Dialogue: 0,0:07:33.20,0:07:34.07,Default,,0,0,0,,Эй, күте тұрыңыз...
Dialogue: 0,0:07:38.08,0:07:40.00,Default,,0,0,0,,Морота!
Dialogue: 0,0:07:40.08,0:07:40.91,Default,,0,0,0,,Ябе
Dialogue: 0,0:07:48.55,0:07:50.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:50.63,0:07:51.92,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:52.88,0:07:55.09,Default,,0,0,0,,Менің атым Дарио Брандо.
Dialogue: 0,0:07:57.43,0:07:58.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:59.18,0:08:00.56,Default,,0,0,0,,Бір минут күте тұрыңыз, Кайто!
Dialogue: 0,0:08:01.18,0:08:03.90,Default,,0,0,0,,Мен оны сақтаймын... ау.
Dialogue: 0,0:08:03.98,0:08:06.06,Default,,0,0,0,,Кездескенше, Батыстың детективі
Dialogue: 0,0:08:08.94,0:08:12.32,Default,,0,0,0,,Бұл бет тура Кудоға ұқсайды.
Dialogue: 0,0:08:13.40,0:08:15.32,Default,,0,0,0,,Тіпті дауыс...
Dialogue: 0,0:08:18.20,0:08:23.21,Default,,0,0,0,,♪~
Dialogue: 0,0:08:38.05,0:08:40.39,Default,,0,0,0,,Мен орта мектептің детективімін, Шиничи Кудо
Dialogue: 0,0:08:41.60,0:08:43.77,Default,,0,0,0,,Бала күнгі досы және сыныптасы Ран Моримен
Dialogue: 0,0:08:43.85,0:08:45.77,Default,,0,0,0,,Ойын-сауық саябағына барыңыз
Dialogue: 0,0:08:45.90,0:08:49.86,Default,,0,0,0,,Мен қара киінген адамның күдікті транзакциясының куәсі болдым.
Dialogue: 0,0:08:50.94,0:08:53.57,Default,,0,0,0,,Мен транзакцияларды қарауға құмар болдым.
Dialogue: 0,0:08:53.65,0:08:57.62,Default,,0,0,0,,Артынан келе жатқан басқа серігін байқамадым.
Dialogue: 0,0:08:58.82,0:09:02.91,Default,,0,0,0,,Ол кісі маған у ішті, мен оянсам...
Dialogue: 0,0:09:04.16,0:09:07.08,Default,,0,0,0,,Менің денем кішірейіп кетті.
Dialogue: 0,0:09:07.67,0:09:10.04,Default,,0,0,0,,Егер олар Шиничи Кудоның тірі екенін білсе ше?
Dialogue: 0,0:09:10.13,0:09:14.67,Default,,0,0,0,,Сондай-ақ, менің өмірім нысанаға алынып, айналамдағы адамдарға зиян тигізуде.
Dialogue: 0,0:09:15.30,0:09:18.55,Default,,0,0,0,,Доктор Агасаның кеңесі бойынша мен өзімнің шынайы тұлғамды жасыруды шештім.
Dialogue: 0,0:09:18.64,0:09:20.47,Default,,0,0,0,,Ран менің атымды сұрағанда, мен бірден айттым
Dialogue: 0,0:09:21.06,0:09:23.18,Default,,0,0,0,,Конан Эдогава деп аталған
Dialogue: 0,0:09:23.27,0:09:25.06,Default,,0,0,0,,Өз ақпаратын алу
Dialogue: 0,0:09:25.14,0:09:28.77,Default,,0,0,0,,Ранның әкесі детектив болып жұмыс істейтін үйіне көшті.
Dialogue: 0,0:09:30.19,0:09:32.32,Default,,0,0,0,,Менің шын тұлғамды кім біледі?
Dialogue: 0,0:09:32.40,0:09:35.03,Default,,0,0,0,,Батыс орта мектебінің детективі Хэйдзи Хаттори
Dialogue: 0,0:09:35.61,0:09:39.32,Default,,0,0,0,,Тағы бір, менің тағдырлас серіктесім Кайто Кид
Dialogue: 0,0:09:39.41,0:09:42.62,Default,,0,0,0,,Белгісіз фантом ұры және бетперде шебері
Dialogue: 0,0:09:42.70,0:09:43.83,Default,,0,0,0,,Казуха кейпінде
Dialogue: 0,0:09:43.91,0:09:46.50,Default,,0,0,0,,Ернімді ұрламақшы болдың, тентек қылдың.
Dialogue: 0,0:09:46.58,0:09:47.46,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:09:47.54,0:09:50.25,Default,,0,0,0,,Бетперде екенін байқамадым, бұл менің кінәм.
Dialogue: 0,0:09:50.33,0:09:52.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:53.34,0:09:55.21,Default,,0,0,0,,Кішірейсең де, миың сол күйінде қалады
Dialogue: 0,0:09:55.80,0:09:57.63,Default,,0,0,0,,Лабиринті жоқ детектив
Dialogue: 0,0:09:58.34,0:10:01.51,Default,,0,0,0,,Әрқашан бір ақиқат бар!
Dialogue: 0,0:10:01.60,0:10:02.68,Default,,0,0,0,,Иә
Dialogue: 0,0:10:01.60,0:10:02.68,Default,,0,0,0,,~♪
Dialogue: 0,0:10:02.68,0:10:06.18,Default,,0,0,0,,~♪
Dialogue: 0,0:10:06.81,0:10:08.56,Default,,0,0,0,,Бұл сіздің соңғы жүк пе?
Dialogue: 0,0:10:08.64,0:10:09.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:10.35,0:10:12.69,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:10:13.94,0:10:16.15,Default,,0,0,0,,Һм? Ой!
Dialogue: 0,0:10:18.15,0:10:20.07,Default,,0,0,0,,Ал, тамақ ішіп алайық.
Dialogue: 0,0:10:21.70,0:10:23.62,Default,,0,0,0,,А... а...
Dialogue: 0,0:10:27.46,0:10:29.46,Default,,0,0,0,,(шағала дыбысы)
Dialogue: 0,0:10:31.29,0:10:33.13,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:10:33.21,0:10:36.84,Default,,0,0,0,,Қатысушы ойыншы Хэйдзи Хаттори келе ме?
Dialogue: 0,0:10:36.92,0:10:39.38,Default,,0,0,0,,Хм... Мен оны әлі де көргім келеді.
Dialogue: 0,0:10:39.47,0:10:40.63,Default,,0,0,0,,Я...
Dialogue: 0,0:10:40.72,0:10:42.89,Default,,0,0,0,,...Хедзи қайда кетті?
Dialogue: 0,0:10:43.47,0:10:46.89,Default,,0,0,0,,Қонақүй бөлмесіне қайтып келмеді.
Dialogue: 0,0:10:46.97,0:10:49.98,Default,,0,0,0,,...
Dialogue: 0,0:10:50.06,0:10:51.65,Default,,0,0,0,,Егер Кид шықса, оны жайына қалдырыңыз.
Dialogue: 0,0:10:51.73,0:10:52.65,Default,,0,0,0,,(қылыш сермеу)
Dialogue: 0,0:10:52.73,0:10:54.65,Default,,0,0,0,,А, бұл дыбыс...
Dialogue: 0,0:11:02.66,0:11:04.24,Default,,0,0,0,,Хэдзи, сен мұнда не істеп жүрсің...
Dialogue: 0,0:11:04.33,0:11:05.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:06.49,0:11:08.87,Default,,0,0,0,,Кешіріңіз, сіз дұрыс емес адамсыз.
Dialogue: 0,0:11:11.87,0:11:14.54,Default,,0,0,0,,Бірақ сіз бұл шу шығардыңыз.
Dialogue: 0,0:11:14.63,0:11:16.71,Default,,0,0,0,,Дыбыс қылыш сияқты ма?
Dialogue: 0,0:11:16.80,0:11:17.80,Default,,0,0,0,,Сая
Dialogue: 0,0:11:17.88,0:11:20.05,Default,,0,0,0,,«Ауыздың шырылдауы», солай ма?
Dialogue: 0,0:11:20.13,0:11:23.55,Default,,0,0,0,,Дыбыс жоғары болса, бұл қылыштың дұрыс тербелгенінің дәлелі.
Dialogue: 0,0:11:25.18,0:11:26.81,Default,,0,0,0,,Керемет!
Dialogue: 0,0:11:27.64,0:11:28.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:30.23,0:11:33.06,Default,,0,0,0,,...
Dialogue: 0,0:11:34.19,0:11:35.23,Default,,0,0,0,,Конан-кун, кеттік.
Dialogue: 0,0:11:35.31,0:11:37.19,Default,,0,0,0,,А... иә
Dialogue: 0,0:11:38.65,0:11:41.45,Default,,0,0,0,,Сәлем! Таааа
Dialogue: 0,0:11:43.24,0:11:44.95,Default,,0,0,0,,Коте! беті!
Dialogue: 0,0:11:45.03,0:11:45.87,Default,,0,0,0,,Торсо!
Dialogue: 0,0:11:46.49,0:11:47.37,Default,,0,0,0,,Бір!
Dialogue: 0,0:11:47.45,0:11:49.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:49.95,0:11:51.58,Default,,0,0,0,,«Бергілеу».
Dialogue: 0,0:11:51.66,0:11:55.58,Default,,0,0,0,,Хатторидің Иихин байқауында шынайы сезімдерімді көрсете алмаймын.
Dialogue: 0,0:11:55.67,0:11:58.13,Default,,0,0,0,,Эй, мен сені сонда кездестірдім, Казуха-чан!
Dialogue: 0,0:11:59.26,0:12:01.51,Default,,0,0,0,,Хаттори келеді деп ойламаймын.
Dialogue: 0,0:12:01.59,0:12:04.01,Default,,0,0,0,,Таңертеңнен бері көрінген жоқ.
Dialogue: 0,0:12:04.09,0:12:06.89,Default,,0,0,0,,Дәл қазір Ран Чан және басқалары бөлініп, іздеп жатыр.
Dialogue: 0,0:12:06.97,0:12:08.22,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:12:08.31,0:12:10.98,Default,,0,0,0,,Ертең командалық жарысқа қатысуды жоспарлайсыз ба?
Dialogue: 0,0:12:11.06,0:12:13.94,Default,,0,0,0,,Мен де білмеймін. Хеджиден сұраңыз.
Dialogue: 0,0:12:14.02,0:12:15.31,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:12:15.90,0:12:19.82,Default,,0,0,0,,Енді Хиджири Фукуджоның арнайы демонстрациясынан бастайық.
Dialogue: 0,0:12:19.90,0:12:23.82,Default,,0,0,0,,(Әйел тұтынушылардың шуы)
Dialogue: 0,0:12:24.41,0:12:26.07,Default,,0,0,0,,Бұл адам бүгін таңертең...
Dialogue: 0,0:12:31.66,0:12:33.21,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:12:33.79,0:12:35.75,Default,,0,0,0,,Иә! Иә!
Dialogue: 0,0:12:38.46,0:12:39.88,Default,,0,0,0,,Бірінші болып Айс Фриз!
Dialogue: 0,0:12:44.51,0:12:47.05,Default,,0,0,0,,Не, саған ол жігіт қызық па?
Dialogue: 0,0:12:47.14,0:12:49.05,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:12:49.14,0:12:51.31,Default,,0,0,0,,- (Окита) Шынымен бе? -(Қазуба) Расында солай істе.
Dialogue: 0,0:12:52.02,0:12:54.27,Default,,0,0,0,,-(Окита) Олай болса Хатториге барыңызшы.-(Казуба) Иә.
Dialogue: 0,0:12:54.35,0:12:57.06,Default,,0,0,0,,Әй, сен, қызғылт лента
Dialogue: 0,0:12:57.81,0:12:59.06,Default,,0,0,0,,Таң қалай?
Dialogue: 0,0:12:59.15,0:13:01.11,Default,,0,0,0,,А... кешіріңіз!
Dialogue: 0,0:13:01.19,0:13:03.82,Default,,0,0,0,,Арнайы демонстрациялық жаттығу Мен сізді мазалағандай болдым
Dialogue: 0,0:13:05.15,0:13:07.62,Default,,0,0,0,,Мен сіз бір жерден қарап отырған шығарсыз деп ойладым.
Dialogue: 0,0:13:07.70,0:13:09.33,Default,,0,0,0,,Мен одан да ынталы сезінемін.
Dialogue: 0,0:13:09.41,0:13:10.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:10.66,0:13:14.62,Default,,0,0,0,,Мен Хиджири Фукуджо, Яхатазака университетінің медицина факультетінің мүшесімін.
Dialogue: 0,0:13:14.71,0:13:15.75,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,0:13:15.83,0:13:18.71,Default,,0,0,0,,Мен Кайга академиясынан Казуха Тоямамын.
Dialogue: 0,0:13:18.79,0:13:21.96,Default,,0,0,0,,Казуха... Керемет есім екен.
Dialogue: 0,0:13:22.05,0:13:24.51,Default,,0,0,0,,- (Хиджири) Қайта танысқаныма қуаныштымын - (Қазуба) А... иә.
Dialogue: 0,0:13:25.22,0:13:29.64,Default,,0,0,0,,Мен Киото Сеншин орта мектебінің оқушысы Соудзи Окитамын.
Dialogue: 0,0:13:29.72,0:13:33.35,Default,,0,0,0,,Мен сізді білемін, өйткені сіз кендо әлеміндегі әйгілі адамдардың бірісіз.
Dialogue: 0,0:13:33.43,0:13:35.02,Default,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,0:13:35.10,0:13:37.35,Default,,0,0,0,,Окита-кун, Казуха-чан ше?
Dialogue: 0,0:13:37.44,0:13:38.52,Default,,0,0,0,,Жігіт пе?
Dialogue: 0,0:13:38.60,0:13:40.15,Default,,0,0,0,,Жай ғана таныс
Dialogue: 0,0:13:40.73,0:13:42.15,Default,,0,0,0,,Иә
Dialogue: 0,0:13:42.23,0:13:45.11,Default,,0,0,0,,Біз тағы кездесеміз деп үміттенемін.
Dialogue: 0,0:13:45.19,0:13:46.15,Default,,0,0,0,,Хона…
Dialogue: 0,0:13:47.82,0:13:49.91,Default,,0,0,0,,- (Қыз) Әй, бұл не? -(Қыз) Шынымен
Dialogue: 0,0:13:49.99,0:13:51.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:51.62,0:13:53.04,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:13:53.12,0:13:56.04,Default,,0,0,0,,Осы көріністі Хатториге көрсетіңіз.
Dialogue: 0,0:13:56.12,0:13:58.12,Default,,0,0,0,,Казуха-чан! мұнда
Dialogue: 0,0:13:58.21,0:14:00.54,Default,,0,0,0,,Ран-чан! Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:14:01.13,0:14:03.84,Default,,0,0,0,,Соңында Хаттори-кун табылмады.
Dialogue: 0,0:14:03.92,0:14:05.01,Default,,0,0,0,,Мен енді білмеймін! Сол жігіт
Dialogue: 0,0:14:05.01,0:14:06.05,Default,,0,0,0,,Мен енді білмеймін! Сол жігіт
Dialogue: 0,0:14:05.01,0:14:06.05,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:14:06.05,0:14:07.05,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:14:07.05,0:14:07.97,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:14:07.05,0:14:07.97,Default,,0,0,0,,Не? Шулы
Dialogue: 0,0:14:07.97,0:14:09.39,Default,,0,0,0,,Не? Шулы
Dialogue: 0,0:14:10.55,0:14:13.93,Default,,0,0,0,,Хэйдзи Хоккайдодағы кендо турниріне қатысады.
Dialogue: 0,0:14:14.01,0:14:16.98,Default,,0,0,0,,Сен айтқаның үшін мен асығыс келдім.
Dialogue: 0,0:14:17.06,0:14:19.81,Default,,0,0,0,,Неліктен сіз өтетін жерге келе алмайсыз?
Dialogue: 0,0:14:20.40,0:14:22.15,Default,,0,0,0,,I'm sorry.
Dialogue: 0,0:14:22.23,0:14:24.07,Default,,0,0,0,,- (Күзгі жапырақтар) Жарайды, иә - (Иори) Тек...
Dialogue: 0,0:14:24.65,0:14:27.49,Default,,0,0,0,,Олардың Хоккайдоға келетініне еш күмән жоқ сияқты.
Dialogue: 0,0:14:27.57,0:14:30.70,Default,,0,0,0,,Бұл аймақта көптеген конфессиялық көркем жерлер бар.
Dialogue: 0,0:14:31.28,0:14:32.58,Default,,0,0,0,,(Миямура) Хмм… сол тү не жайлы еді…
Dialogue: 0,0:14:32.66,0:14:35.20,Default,,0,0,0,,Кез келген жағдайда, Хэйдзи-кун, Леф-чан?
Dialogue: 0,0:14:35.70,0:14:36.58,Default,,0,0,0,,Иә
Dialogue: 0,0:14:37.16,0:14:39.58,Default,,0,0,0,,Біз мұны мүлдем тоқтатуымыз керек!
Dialogue: 0,0:14:40.58,0:14:41.83,Default,,0,0,0,,Мен зерттедім
Dialogue: 0,0:14:41.92,0:14:45.59,Default,,0,0,0,,Саппорода Сағат мұнарасы деп аталатын керемет көрініс бар.
Dialogue: 0,0:14:45.67,0:14:48.22,Default,,0,0,0,,Ал, Иори, Саппороға бар!
Dialogue: 0,0:14:48.30,0:14:50.72,Default,,0,0,0,,Жарайсың, жас ханым.
Dialogue: 0,0:14:54.81,0:14:57.14,Default,,0,0,0,,Ол қандай тікұшақ?
Dialogue: 0,0:14:57.77,0:14:59.98,Default,,0,0,0,,Эй, мен Хакодатеге дейін келдім.
Dialogue: 0,0:15:00.60,0:15:02.48,Default,,0,0,0,,Таңертеңгілік базарға барып, дәмді тамақ ішейік.
Dialogue: 0,0:15:02.48,0:15:03.02,Default,,0,0,0,,Таңертеңгілік базарға барып, дәмді тамақ ішейік.
Dialogue: 0,0:15:02.48,0:15:03.02,Default,,0,0,0,,
Dialogue: 0,0:15:03.02,0:15:03.11,Default,,0,0,0,,
Dialogue: 0,0:15:03.11,0:15:05.48,Default,,0,0,0,,
Dialogue: 0,0:15:03.11,0:15:05.48,Default,,0,0,0,,А... Бірдеңе болды деп ойлаймын.
Dialogue: 0,0:15:09.70,0:15:11.24,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:15:12.41,0:15:14.49,Default,,0,0,0,,- (Нишимура) Дене ше? -(Офицер) Міне, бұрышта.
Dialogue: 0,0:15:15.12,0:15:16.99,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:17.08,0:15:19.00,Default,,0,0,0,,Қандай қызық нәрсе.
Dialogue: 0,0:15:19.71,0:15:21.50,Default,,0,0,0,,Әй, кеш болды емес пе?
Dialogue: 0,0:15:22.08,0:15:23.88,Default,,0,0,0,,- (Казуба) Хэйдзи! -(Хедзи) Бұл жеткілікті ме?
Dialogue: 0,0:15:23.96,0:15:26.50,Default,,0,0,0,,Иә, ынтымақтастық үшін рахмет.
Dialogue: 0,0:15:26.59,0:15:27.96,Default,,0,0,0,,Апыр-ай, жақсы болды. Сонымен, іс шешілді ғой?
Dialogue: 0,0:15:28.05,0:15:31.51,Default,,0,0,0,,Мен Хакодате түні бойы Баланы қуып жүгірдім.
Dialogue: 0,0:15:32.09,0:15:33.51,Default,,0,0,0,,Бірақ неге мұнда?
Dialogue: 0,0:15:33.59,0:15:35.89,Default,,0,0,0,,Мен сол жақтағы орындықта ұйықтап жатқанмын.
Dialogue: 0,0:15:35.97,0:15:39.02,Default,,0,0,0,,Полицейлер мені оятып, сұрақ қойды.
Dialogue: 0,0:15:39.10,0:15:41.10,Default,,0,0,0,,Сіз мені күдікті ретінде қарастырасыз ба?
Dialogue: 0,0:15:41.19,0:15:42.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:44.36,0:15:45.44,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:45.52,0:15:47.69,Default,,0,0,0,,- (Хедзи) Жоқ, бұл ештеңе емес - иә?
Dialogue: 0,0:15:47.78,0:15:49.03,Default,,0,0,0,,Моури детективі
Dialogue: 0,0:15:49.11,0:15:50.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:50.11,0:15:52.49,Default,,0,0,0,,Сіз Когоро Моурисіз, солай ма?
Dialogue: 0,0:15:52.57,0:15:55.57,Default,,0,0,0,,Ал, сен қайсысысың?
Dialogue: 0,0:15:55.66,0:15:57.79,Default,,0,0,0,,- (Нишимура) Сен ұмыттың ба? -(Когоро) Ахах...
Dialogue: 0,0:15:57.87,0:16:00.66,Default,,0,0,0,,Бұл Хоккайдо полициясының инспекторы Нишимура.
Dialogue: 0,0:16:01.25,0:16:03.46,Default,,0,0,0,,Хокутсей оқиғасы кезінде кездестік.
Dialogue: 0,0:16:03.54,0:16:04.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:04.50,0:16:07.92,Default,,0,0,0,,Мен көлікте тамаша шегерімдерімді көрсеттім.
Dialogue: 0,0:16:08.50,0:16:09.09,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,0:16:09.09,0:16:10.84,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,0:16:09.09,0:16:10.84,Default,,0,0,0,,Менің есімде жоқ.
Dialogue: 0,0:16:10.92,0:16:13.68,Default,,0,0,0,,Мм... қандай да бір оқиға болды ма?
Dialogue: 0,0:16:13.76,0:16:16.14,Default,,0,0,0,,Ханым да Боуеспен келді ме?
Dialogue: 0,0:16:16.22,0:16:18.68,Default,,0,0,0,,Ол жерден ер адамның денесі табылды.
Dialogue: 0,0:16:18.76,0:16:20.52,Default,,0,0,0,,Біртүрлі нәрсе бар...
Dialogue: 0,0:16:20.60,0:16:23.19,Default,,0,0,0,,Сол істі ашқан ұлы детектив.
Dialogue: 0,0:16:23.27,0:16:25.19,Default,,0,0,0,,Қарап жібересіз бе?
Dialogue: 0,0:16:25.77,0:16:26.98,Default,,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:16:27.06,0:16:29.65,Default,,0,0,0,,Менің артымнан ермеңдер, сендер қауіпті екенсіңдер.
Dialogue: 0,0:16:29.73,0:16:30.69,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:16:31.28,0:16:32.99,Default,,0,0,0,,Ах... сол оқиға
Dialogue: 0,0:16:33.07,0:16:35.07,Default,,0,0,0,,Менің ойымша, қарт оны шешуге шешім қабылдады ...
Dialogue: 0,0:16:35.66,0:16:38.03,Default,,0,0,0,,Оны шешкен әкем.
Dialogue: 0,0:16:38.12,0:16:39.70,Default,,0,0,0,,(Юсакудың түшкіруі)
Dialogue: 0,0:16:39.79,0:16:41.33,Default,,0,0,0,,О, суық па?
Dialogue: 0,0:16:41.41,0:16:44.12,Default,,0,0,0,,Жоқ, біреу өсек айтып жатыр ма деп ойлаймын.
Dialogue: 0,0:16:44.21,0:16:46.83,Default,,0,0,0,,Хмм, менде қызба жоқ.
Dialogue: 0,0:16:47.71,0:16:48.84,Default,,0,0,0,,Я...
Dialogue: 0,0:16:48.92,0:16:50.46,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:16:50.55,0:16:52.34,Default,,0,0,0,,Жәбірленушінің жеке басы қандай?
Dialogue: 0,0:16:52.42,0:16:54.47,Default,,0,0,0,,Сумито Кугаки 43 жаста
Dialogue: 0,0:16:54.55,0:16:55.76,Default,,0,0,0,,Мен заңгермін.
Dialogue: 0,0:16:55.84,0:16:59.22,Default,,0,0,0,,Кісі өлтіру қаруы жапондық қылыш тәрізді өткір пышақ деп есептеледі.
Dialogue: 0,0:16:59.30,0:17:01.97,Default,,0,0,0,,Кугаки... бір жерде...
Dialogue: 0,0:17:03.06,0:17:06.81,Default,,0,0,0,,Кугаки мырза Аки Зайбатсудың заң кеңесшісі болып жұмыс істей ме?
Dialogue: 0,0:17:06.90,0:17:09.73,Default,,0,0,0,,Сен мені жақсы білесің, Боуес, дұрыс айтасың.
Dialogue: 0,0:17:09.82,0:17:11.98,Default,,0,0,0,,Кешегі оқиға кезінде сені бағып-қаққан үй осы ма?
Dialogue: 0,0:17:12.57,0:17:14.65,Default,,0,0,0,,Кейбір байланыс бар сияқты.
Dialogue: 0,0:17:14.74,0:17:18.20,Default,,0,0,0,,Нишимура инспектор, жәбірленушінің заттарын көре аламын ба?
Dialogue: 0,0:17:18.28,0:17:19.49,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:17:21.41,0:17:24.08,Default,,0,0,0,,Әуе билеттері мен такси чектері?
Dialogue: 0,0:17:24.16,0:17:26.58,Default,,0,0,0,,Мына жерде бос гольф сөмкесі
Dialogue: 0,0:17:27.17,0:17:29.21,Default,,0,0,0,,...және смартфон табылмады.
Dialogue: 0,0:17:29.96,0:17:31.63,Default,,0,0,0,,Бізде бар ақпарат негізінде
Dialogue: 0,0:17:31.71,0:17:35.38,Default,,0,0,0,,Жәбірленуші кеше Дубайдан шығып, Наритаға келді.
Dialogue: 0,0:17:35.47,0:17:37.93,Default,,0,0,0,,Сол жерден мен Хакодатеге ішкі рейспен келдім.
Dialogue: 0,0:17:38.51,0:17:41.22,Default,,0,0,0,,Сіз әуежайдан такси ұстаған сияқтысыз.
Dialogue: 0,0:17:43.81,0:17:46.60,Default,,0,0,0,,Сіз бір-біріңізді таныдыңыз ба? Сіз мені таң қалдырдыңыз ба?
Dialogue: 0,0:17:47.19,0:17:49.10,Default,,0,0,0,,Бет-аузын кесіп тастады
Dialogue: 0,0:17:49.19,0:17:52.23,Default,,0,0,0,,Гольф сөмкесінің ішіндегі заттарға не болды?
Dialogue: 0,0:17:52.32,0:17:53.86,Default,,0,0,0,,Бір адамды өлтіру
Dialogue: 0,0:17:53.94,0:17:56.86,Default,,0,0,0,,Сіз гольф сойылдарының жиынтығын алып кеттіңіз бе?
Dialogue: 0,0:17:57.45,0:18:00.62,Default,,0,0,0,,Қалай қарасам да, гольфтен үйге келе жатқанда оны көрмеймін.
Dialogue: 0,0:18:00.70,0:18:04.62,Default,,0,0,0,,А... Әй, қарағым, сол қолыңда бірдеңе бар.
Dialogue: 0,0:18:04.70,0:18:05.54,Default,,0,0,0,,Не?
Dialogue: 0,0:18:05.62,0:18:06.91,Default,,0,0,0,,Эй, сот сарапшысын шақыр!
Dialogue: 0,0:18:07.00,0:18:08.37,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:08.46,0:18:10.63,Default,,0,0,0,,«Токиодағы білім»?
Dialogue: 0,0:18:10.71,0:18:14.71,Default,,0,0,0,,Не? Бұл оқулықтың сынығы ма, әлде бір нәрсе ме?
Dialogue: 0,0:18:16.01,0:18:17.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:17.13,0:18:18.88,Default,,0,0,0,,Backstop! тоқта!
Dialogue: 0,0:18:21.72,0:18:23.89,Default,,0,0,0,,- Иә? -(Нишимура) Ақыры келдің бе?
Dialogue: 0,0:18:24.68,0:18:27.27,Default,,0,0,0,,Уау, мен мұны қайтадан жасадым.
Dialogue: 0,0:18:27.35,0:18:30.40,Default,,0,0,0,,Кавазоэ, сен не істедің!
Dialogue: 0,0:18:30.48,0:18:32.73,Default,,0,0,0,,Кешіріңіз! Мен біраз зерттеу жүргіздім
Dialogue: 0,0:18:32.82,0:18:34.36,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:18:34.44,0:18:35.48,Default,,0,0,0,,Я...
Dialogue: 0,0:18:35.57,0:18:38.70,Default,,0,0,0,,Бұл менің қарамағымдағы сержант Йошихиса Кавазоэ.
Dialogue: 0,0:18:39.28,0:18:42.24,Default,,0,0,0,,Мен ебедеймін, бірақ кешігіп қалатын адам емеспін.
Dialogue: 0,0:18:42.32,0:18:43.20,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:18:43.28,0:18:45.74,Default,,0,0,0,,(Ллойд) Бүгінгі серуен — немесе дұрысы, «Үккі» операциясы
Dialogue: 0,0:18:45.83,0:18:47.20,Default,,0,0,0,,Когоро Моури?
Dialogue: 0,0:18:47.29,0:18:50.21,Default,,0,0,0,,-Күрсін... Не істеу керек? - Хун
Dialogue: 0,0:18:50.29,0:18:54.25,Default,,0,0,0,,Детектив стилімен не істей аласыз? Оны жай қалдырыңыз.
Dialogue: 0,0:18:54.34,0:18:58.22,Default,,0,0,0,,Оның орнына, бұл ертерек келген.
Dialogue: 0,0:19:02.89,0:19:05.72,Default,,0,0,0,,Кугаки, сен оны жақсы таптың.
Dialogue: 0,0:19:06.93,0:19:08.27,Default,,0,0,0,,Ах... ой
Dialogue: 0,0:19:08.35,0:19:10.19,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:19:11.48,0:19:12.31,Default,,0,0,0,,Иә
Dialogue: 0,0:19:13.06,0:19:15.82,Default,,0,0,0,,Енді төртеуі қалды.
Dialogue: 0,0:19:15.90,0:19:17.07,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:17.82,0:19:20.99,Default,,0,0,0,,Бастық! Менің бөлмемнің есігінде осындай нәрсе бар
Dialogue: 0,0:19:22.36,0:19:25.03,Default,,0,0,0,,Мен бұл қылышты алсам ше?
Dialogue: 0,0:19:25.12,0:19:26.24,Default,,0,0,0,,Қызықты
Dialogue: 0,0:19:26.95,0:19:29.75,Default,,0,0,0,,Начо: Қонақ үйдің айналасын қорғаңыз. Асығыңыз.
Dialogue: 0,0:19:29.83,0:19:31.75,Default,,0,0,0,,Бір, екі, үш.
Dialogue: 0,0:19:32.33,0:19:35.25,Default,,0,0,0,,Бар болғаны 4 дана қалды...
Dialogue: 0,0:19:41.01,0:19:42.76,Default,,0,0,0,,Енді түсіндірейін.
Dialogue: 0,0:19:42.84,0:19:45.72,Default,,0,0,0,,Бұл адам Брайан Д. Кадокура.
Dialogue: 0,0:19:45.80,0:19:48.02,Default,,0,0,0,,Мен жапондық американдық инвестормын.
Dialogue: 0,0:19:48.10,0:19:50.89,Default,,0,0,0,,Мен бұл кісінің атын бұрын естігенмін.
Dialogue: 0,0:19:50.98,0:19:52.52,Default,,0,0,0,,Миллионер және қайырымдылық
Dialogue: 0,0:19:52.60,0:19:54.27,Default,,0,0,0,,Сіз ақша беретін филантропсыз ба?
Dialogue: 0,0:19:54.86,0:19:56.40,Default,,0,0,0,,Сіз өте жақсы білесіз.
Dialogue: 0,0:19:56.48,0:19:58.78,Default,,0,0,0,,Бірақ бұл жай ғана көпшілікке арналған бет.
Dialogue: 0,0:19:58.86,0:20:02.78,Default,,0,0,0,,Сахна артында ол қару сатушы ретінде белсенді, деп аталатын...
Dialogue: 0,0:20:03.45,0:20:05.28,Default,,0,0,0,,Өлім саудагері
Dialogue: 0,0:20:05.87,0:20:08.99,Default,,0,0,0,,Олар бүкіл Азияда кең көлемде бизнес жасайды.
Dialogue: 0,0:20:09.08,0:20:12.25,Default,,0,0,0,,Полиция оны жылдар бойы таңбалап келеді.
Dialogue: 0,0:20:12.33,0:20:14.00,Default,,0,0,0,,Менің кеңесім бойынша
Dialogue: 0,0:20:14.08,0:20:16.54,Default,,0,0,0,,Кавазоэ мұндай нәрсе туралы көп біледі.
Dialogue: 0,0:20:17.13,0:20:19.42,Default,,0,0,0,,Кадокураның бұл жолғы Жапонияға сапарының мақсаты
Dialogue: 0,0:20:19.50,0:20:21.63,Default,,0,0,0,,Сіз қайырымдылық шарасына қатысуыңыз керек, бірақ...
Dialogue: 0,0:20:21.72,0:20:22.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:23.18,0:20:24.30,Default,,0,0,0,,Бұл қандай фотосурет?
Dialogue: 0,0:20:24.89,0:20:26.30,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:20:26.39,0:20:27.55,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:20:27.64,0:20:30.72,Default,,0,0,0,,Kawazoe Компьютерге сусын қоймаңыз!
Dialogue: 0,0:20:30.81,0:20:32.23,Default,,0,0,0,,- (Кавазоэ) О, құдай! -(Нишимура) Аа...
Dialogue: 0,0:20:33.31,0:20:34.48,Default,,0,0,0,,Тақырыпқа қайта оралу
Dialogue: 0,0:20:34.56,0:20:37.61,Default,,0,0,0,,Кадокураның Жапонияға сапарының нақты мақсаты
Dialogue: 0,0:20:37.69,0:20:41.49,Default,,0,0,0,,Кейзабуро Аки жасырған қазынада болса керек.
Dialogue: 0,0:20:41.57,0:20:46.82,Default,,0,0,0,,Кейзабуро Акси соғысқа дейін Хоккайдода алтын тамырды тапты.
Dialogue: 0,0:20:46.91,0:20:49.12,Default,,0,0,0,,Үлкен байлық жинады
Dialogue: 0,0:20:49.20,0:20:54.00,Default,,0,0,0,,...Бірақ ол қайтыс болғаннан кейін оның байлығының бір бөлігі қараңғыда жоғалып кетті.
Dialogue: 0,0:20:54.08,0:20:58.75,Default,,0,0,0,,Соның бәрін алтын құймаға айналдырып, бір жерге тығып қойған деседі.
Dialogue: 0,0:20:58.84,0:21:01.00,Default,,0,0,0,,Кейзабуро қалдырған қазына
Dialogue: 0,0:21:01.09,0:21:04.22,Default,,0,0,0,,Біз оның не екенін әлі білмейміз.
Dialogue: 0,0:21:04.30,0:21:05.55,Default,,0,0,0,,Алтын құймалар емес
Dialogue: 0,0:21:05.63,0:21:09.51,Default,,0,0,0,,Оның қандай да бір күшті қару болғаны туралы теория да бар.
Dialogue: 0,0:21:10.18,0:21:14.39,Default,,0,0,0,,Кейзабуро да соғыс жылдарында әскери өнеркәсіппен терең айналысты.
Dialogue: 0,0:21:14.48,0:21:17.69,Default,,0,0,0,,Оны сол кезде алғаны айтылады.
Dialogue: 0,0:21:18.23,0:21:21.32,Default,,0,0,0,,Соғыс барысын толығымен өзгерте алатын нәрсе!
Dialogue: 0,0:21:21.40,0:21:22.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:23.11,0:21:25.53,Default,,0,0,0,,Соғыс барысын өзгерте ме?
Dialogue: 0,0:21:26.24,0:21:30.12,Default,,0,0,0,,Менің ойымша, қару сатушы бір нәрсені нысанаға алатын сияқты.
Dialogue: 0,0:21:30.20,0:21:34.04,Default,,0,0,0,,Сонымен қатар менде Моури мырзаға көрсеткім келетін фотосуретім бар.
Dialogue: 0,0:21:34.62,0:21:36.04,Default,,0,0,0,,Бұл Кадокра және
Dialogue: 0,0:21:36.12,0:21:38.58,Default,,0,0,0,,Бұл өлтірілген адвокат Кугаки болды ма?
Dialogue: 0,0:21:38.67,0:21:41.96,Default,,0,0,0,,Иә, оған Такузо Акие бұйырды.
Dialogue: 0,0:21:42.05,0:21:45.05,Default,,0,0,0,,Ол қазынаның жатқан жерін іздеген деген болжам бар.
Dialogue: 0,0:21:45.13,0:21:48.93,Default,,0,0,0,,Кәсібінде сәтсіздікке ұшырап, ақша үшін қиындыққа тап болған Такузо үшін.
Dialogue: 0,0:21:49.01,0:21:52.56,Default,,0,0,0,,Мен оны қатты қалаймын, бұл қазына.
Dialogue: 0,0:21:53.52,0:21:55.10,Default,,0,0,0,,Бірақ мұндай Кугаки
Dialogue: 0,0:21:55.18,0:21:57.56,Default,,0,0,0,,Кадокураны не үшін кездестірдіңіз?
Dialogue: 0,0:21:57.64,0:21:59.81,Default,,0,0,0,,Кугаки жұмыс берушіге опасыздық жасады
Dialogue: 0,0:21:59.90,0:22:03.69,Default,,0,0,0,,Мүмкін ол қазына туралы ақпаратты Кадокураға жеткізгісі келген шығар.
Dialogue: 0,0:22:04.28,0:22:06.45,Default,,0,0,0,,Ойланып көріңізші, бірнеше қауіпсіздік камералары...
Dialogue: 0,0:22:06.53,0:22:09.95,Default,,0,0,0,,Кугаки гольф сөмкесін көтеріп жүрген көрінеді.
Dialogue: 0,0:22:10.03,0:22:12.33,Default,,0,0,0,,Дегенмен, гольф сөмкесінің мазмұнына қатысты.
Dialogue: 0,0:22:12.41,0:22:13.95,Default,,0,0,0,,Расталмаған
Dialogue: 0,0:22:14.62,0:22:17.50,Default,,0,0,0,,Гольф сөмкесінің ішінде не бар Мүмкін...
Dialogue: 0,0:22:17.58,0:22:18.46,Default,,0,0,0,,Қылыш
Dialogue: 0,0:22:19.04,0:22:22.46,Default,,0,0,0,,Сондай-ақ, бұл қағаз атыс қаруы мен қылыштарды тіркеу куәлігі болып табылады.
Dialogue: 0,0:22:22.54,0:22:26.97,Default,,0,0,0,,Иә, ол префектуралық білім беру кеңесінде тексерілгеннен кейін тіркеледі.
Dialogue: 0,0:22:27.55,0:22:28.93,Default,,0,0,0,,Токиода болса
Dialogue: 0,0:22:29.01,0:22:30.59,Default,,0,0,0,,Тіркелген нәрсені жасасаңыз
Dialogue: 0,0:22:30.68,0:22:33.22,Default,,0,0,0,,Құрамында «Токио қалалық білім басқармасы» деген сөздер бар
Dialogue: 0,0:22:33.31,0:22:36.98,Default,,0,0,0,,Қарастырылып отырған қылыш Дубайда сатып алынған болуы мүмкін.
Dialogue: 0,0:22:37.06,0:22:40.81,Default,,0,0,0,,Әрине, мұндай нәрсені ашық түрде кіргізуге болмайды.
Dialogue: 0,0:22:40.90,0:22:43.32,Default,,0,0,0,,Құпия жолды жасырын пайдаланды
Dialogue: 0,0:22:43.40,0:22:45.73,Default,,0,0,0,,Тіркеу куәлігі жалған болуы мүмкін.
Dialogue: 0,0:22:45.82,0:22:47.74,Default,,0,0,0,,Ал, Джё-санның қылышы
Dialogue: 0,0:22:47.82,0:22:49.86,Default,,0,0,0,,Шетелдік дилетанттардың қолында.
Dialogue: 0,0:22:50.53,0:22:53.16,Default,,0,0,0,,Прокурор Кугаки іздеген жапондық қылыш
Dialogue: 0,0:22:53.24,0:22:55.62,Default,,0,0,0,,Оның Дубайда болуы таңқаларлық емес
Dialogue: 0,0:22:55.70,0:22:58.62,Default,,0,0,0,,Мен сатып алынған қылышты Жапонияға әкелген бойда
Dialogue: 0,0:22:58.71,0:23:01.21,Default,,0,0,0,,Адвокат Кугаки өлтірілді
Dialogue: 0,0:23:01.29,0:23:05.34,Default,,0,0,0,,Кінәлінің мақсаты табиғи түрде қылыш болды деп есептеу керек.
Dialogue: 0,0:23:05.42,0:23:09.38,Default,,0,0,0,,Жарайды, мен инспектор Нишимураға кейінірек айтамын.
Dialogue: 0,0:23:09.97,0:23:10.93,Default,,0,0,0,,Ақан
Dialogue: 0,0:23:11.01,0:23:13.39,Default,,0,0,0,,Хэйдзи-кун, мен сені еш жерден таба алмаймын.
Dialogue: 0,0:23:14.01,0:23:16.60,Default,,0,0,0,,Шынымен, қайда бардың?
Dialogue: 0,0:23:16.68,0:23:17.89,Default,,0,0,0,,- (Иори) Ханым - (Момия) А?
Dialogue: 0,0:23:17.97,0:23:20.44,Default,,0,0,0,,Бұл Отару шығар.
Dialogue: 0,0:23:20.52,0:23:21.52,Default,,0,0,0,,Отару?
Dialogue: 0,0:23:21.60,0:23:22.65,Default,,0,0,0,,Бұдан былай —
Dialogue: 0,0:23:22.73,0:23:25.48,Default,,0,0,0,,Отару каналы ымырт кезінде газ шамдарымен жарқырайды
Dialogue: 0,0:23:25.57,0:23:28.11,Default,,0,0,0,,Үлкен мойындау нүктесі ретінде, көңіл-күй тамаша ...
Dialogue: 0,0:23:28.19,0:23:30.90,Default,,0,0,0,,Онда! Иори Отару және Отару!
Dialogue: 0,0:23:31.99,0:23:34.28,Default,,0,0,0,,Жарайсың, жас ханым.
Dialogue: 0,0:23:46.21,0:23:49.26,Default,,0,0,0,,Бастық! Полиция осы жолмен келе жатқан сияқты.
Dialogue: 0,0:23:49.34,0:23:50.42,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:23:50.51,0:23:52.59,Default,,0,0,0,,Маған бәрібір, келсең, өтейін.
Dialogue: 0,0:23:55.26,0:23:57.56,Default,,0,0,0,,Бұл елордалық полиция департаментінің екінші тергеу бөлімінің қызметкері Накамори.
Dialogue: 0,0:23:58.22,0:24:01.18,Default,,0,0,0,,Мен сізге Кайто Кидтен хабарлама алғаныңызды естідім.
Dialogue: 0,0:24:01.27,0:24:04.69,Default,,0,0,0,,Бала? Бұл не?
Dialogue: 0,0:24:04.77,0:24:06.11,Default,,0,0,0,,Бірінші осы бөлмеде
Dialogue: 0,0:24:06.19,0:24:09.69,Default,,0,0,0,,Елес ұры нысанаға алатын қазына жоқ.
Dialogue: 0,0:24:09.78,0:24:12.86,Default,,0,0,0,,Бұл өте әсерлі емес пе?
Dialogue: 0,0:24:12.95,0:24:14.45,Default,,0,0,0,,Саған бәрібір?
Dialogue: 0,0:24:14.53,0:24:15.95,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:24:16.03,0:24:17.66,Default,,0,0,0,,Бірақ қызық болу туралы.
Dialogue: 0,0:24:17.74,0:24:21.33,Default,,0,0,0,,Неге бортқа жалғыз келдің?
Dialogue: 0,0:24:22.08,0:24:23.83,Default,,0,0,0,,Сіз қалалық полиция департаментінің инспекторысыз, солай ма?
Dialogue: 0,0:24:24.54,0:24:26.84,Default,,0,0,0,,Қол астындағыларға не болды?
Dialogue: 0,0:24:26.92,0:24:29.46,Default,,0,0,0,,Бұл менің сүйікті қылышым.
Dialogue: 0,0:24:29.55,0:24:31.59,Default,,0,0,0,,Аты жоқ, бірақ анықтығы тамаша
Dialogue: 0,0:24:32.17,0:24:35.93,Default,,0,0,0,,Бұл сіз көздеп отырған Намакура семсерінен өзгеше!
Dialogue: 0,0:24:36.01,0:24:38.26,Default,,0,0,0,,Кайто Бала!
Dialogue: 0,0:24:40.10,0:24:42.68,Default,,0,0,0,,Ой, не? Мен оны көре алмаймын!
Dialogue: 0,0:24:43.77,0:24:45.52,Default,,0,0,0,,Сәлем! монах!
Dialogue: 0,0:24:45.60,0:24:47.61,Default,,0,0,0,,Арх! Уау
Dialogue: 0,0:24:49.73,0:24:50.57,Default,,0,0,0,,зұлым қылмыстарды болдырмау үшін, бірақ —
Dialogue: 0,0:24:54.70,0:24:55.82,Default,,0,0,0,,Кеке
Dialogue: 0,0:24:57.20,0:24:58.53,Default,,0,0,0,,Бұл бала!
Dialogue: 0,0:24:58.62,0:25:00.41,Default,,0,0,0,,Кадокурадағы қонақүйден.
Dialogue: 0,0:25:00.49,0:25:02.29,Default,,0,0,0,,Ұстаңыз, құда!
Dialogue: 0,0:25:04.37,0:25:06.29,Default,,0,0,0,,Қылыш ұстаған бала?
Dialogue: 0,0:25:06.37,0:25:10.05,Default,,0,0,0,,Түсіндім, ақыры сәттілік келді.
Dialogue: 0,0:25:12.13,0:25:15.18,Default,,0,0,0,,Мен ақыры дем аламын.
Dialogue: 0,0:25:18.30,0:25:21.81,Default,,0,0,0,,Бұл қылышта не бар?
Dialogue: 0,0:25:21.89,0:25:23.06,Default,,0,0,0,,Ата-аналар…
Dialogue: 0,0:25:23.56,0:25:24.68,Default,,0,0,0,,А...
Dialogue: 0,0:25:24.77,0:25:25.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:25.98,0:25:26.98,Default,,0,0,0,,Не?
Dialogue: 0,0:25:27.06,0:25:28.36,Default,,0,0,0,,Ха! Ум... Иә?
Dialogue: 0,0:25:28.94,0:25:30.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:30.86,0:25:31.69,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:25:39.87,0:25:40.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:52.21,0:25:53.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:02.97,0:26:03.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:04.89,0:26:05.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:07.27,0:26:08.60,Default,,0,0,0,,Аһ!
Dialogue: 0,0:26:16.40,0:26:17.70,Default,,0,0,0,,Гррр…
Dialogue: 0,0:26:17.78,0:26:18.95,Default,,0,0,0,,Сәлем
Dialogue: 0,0:26:22.03,0:26:24.87,Default,,0,0,0,,Иә, бұл көп нәрсе істеу керек сияқты.
Dialogue: 0,0:26:27.21,0:26:30.21,Default,,0,0,0,,А... не! Мекуги сыртқа шығады
Dialogue: 0,0:26:35.63,0:26:36.51,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:26:38.59,0:26:40.26,Default,,0,0,0,,Мақсатымды шеше алмаймын.
Dialogue: 0,0:26:40.34,0:26:41.39,Default,,0,0,0,,Балам, жолдан кет!
Dialogue: 0,0:26:42.47,0:26:44.39,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,0:26:51.40,0:26:53.32,Default,,0,0,0,,Ха... қазір!
Dialogue: 0,0:27:00.36,0:27:01.32,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:27:04.99,0:27:07.66,Default,,0,0,0,,(Автокөлік қозғалтқышының дыбысы және кенеттен іске қосу дыбысы)
Dialogue: 0,0:27:07.75,0:27:09.50,Default,,0,0,0,,Сіз қашып кеттіңіз бе?
Dialogue: 0,0:27:09.58,0:27:11.12,Default,,0,0,0,,Амансың ба? Хаттори
Dialogue: 0,0:27:11.21,0:27:12.58,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:27:12.67,0:27:15.34,Default,,0,0,0,,Бірақ сіз қалай ойлайсыз?
Dialogue: 0,0:27:16.17,0:27:18.26,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:27:18.34,0:27:21.09,Default,,0,0,0,,Мұны тергейтін детектив, солай ма?
Dialogue: 0,0:27:22.68,0:27:24.85,Default,,0,0,0,,Мен айтқым келеді...
Dialogue: 0,0:27:25.47,0:27:27.60,Default,,0,0,0,,Өйткені сен маған қауіпті жерде көмектестің.
Dialogue: 0,0:27:28.31,0:27:31.10,Default,,0,0,0,,Мен сізге қайтарамын.
Dialogue: 0,0:27:33.69,0:27:36.98,Default,,0,0,0,,Қарапайым тілмен айтқанда, бұл қызығушылық.
Dialogue: 0,0:27:37.07,0:27:41.24,Default,,0,0,0,,Бір адам керемет қазынаны ұрламақ болды.
Dialogue: 0,0:27:41.32,0:27:45.12,Default,,0,0,0,,Бірақ ол ұрламай жоғалып кетті.
Dialogue: 0,0:27:45.74,0:27:47.87,Default,,0,0,0,,Мен жай ғана білгім келеді
Dialogue: 0,0:27:47.95,0:27:50.83,Default,,0,0,0,,Ол жігіт қандай қазынаны көздеді?
Dialogue: 0,0:27:50.91,0:27:52.25,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:27:53.12,0:27:55.88,Default,,0,0,0,,Ал сен оны неге ұрламадың?
Dialogue: 0,0:27:56.46,0:28:00.84,Default,,0,0,0,,Сонда бұл адам Кейзабуро Акидің қазынасы нені көздеді?
Dialogue: 0,0:28:00.92,0:28:02.18,Default,,0,0,0,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,0:28:02.26,0:28:06.14,Default,,0,0,0,,Бірақ сізбен бір уақытта Кадокура мен Такузо да қозғала бастайды.
Dialogue: 0,0:28:06.22,0:28:08.64,Default,,0,0,0,,Оны кездейсоқ алып тастауға болмайды.
Dialogue: 0,0:28:08.72,0:28:09.89,Default,,0,0,0,,Жақында
Dialogue: 0,0:28:09.97,0:28:14.27,Default,,0,0,0,,Қазынаны жасырған делінетін Кейзабуро Акие жазған қолжазба жазбасы.
Dialogue: 0,0:28:14.35,0:28:15.65,Default,,0,0,0,,Табылғандықтан болар.
Dialogue: 0,0:28:16.23,0:28:20.15,Default,,0,0,0,,Онда бір ғана сөз жазылған: Хигашикубо Эйрю.
Dialogue: 0,0:28:20.24,0:28:22.65,Default,,0,0,0,,Осы вакизаши жасаған сол.
Dialogue: 0,0:28:22.74,0:28:27.16,Default,,0,0,0,,Барлығы алты семсерді Эйрю Хигашикубо жасаған делінеді.
Dialogue: 0,0:28:27.74,0:28:31.66,Default,,0,0,0,,Егер сіз олардың барлығын жинасаңыз, қазынаның қайда жасырылғанын білуіңіз мүмкін.
Dialogue: 0,0:28:31.75,0:28:33.04,Default,,0,0,0,,Айтылады
Dialogue: 0,0:28:33.12,0:28:34.37,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:28:34.46,0:28:35.54,Default,,0,0,0,,Такузо Саякара
Dialogue: 0,0:28:35.63,0:28:38.25,Default,,0,0,0,,Қолда жоқ төрт қылыш қайда?
Dialogue: 0,0:28:38.34,0:28:41.30,Default,,0,0,0,,Неліктен Кугакиге тергеуге рұқсат бересіз?
Dialogue: 0,0:28:41.38,0:28:43.80,Default,,0,0,0,,Олардың екеуі бір, және—
Dialogue: 0,0:28:44.38,0:28:47.05,Default,,0,0,0,,Алты кітаптың үшеуі осында.
Dialogue: 0,0:28:47.14,0:28:50.06,Default,,0,0,0,,Екіншісі кеше сізден еді.
Dialogue: 0,0:28:50.14,0:28:52.60,Default,,0,0,0,,О, мен полицияға хабарладым.
Dialogue: 0,0:28:52.68,0:28:54.81,Default,,0,0,0,,Қалған екеуі қайда?
Dialogue: 0,0:28:54.89,0:28:56.90,Default,,0,0,0,,Хакодате орта мектебінің мұғалімі
Dialogue: 0,0:28:56.98,0:28:59.82,Default,,0,0,0,,Райо Фукуджо есімді жігітте бар болса керек.
Dialogue: 0,0:28:59.90,0:29:01.65,Default,,0,0,0,,Орта мектеп мұғалімі?
Dialogue: 0,0:29:01.74,0:29:05.74,Default,,0,0,0,,Дәл қазір ол ауырып, сабақты тастап, үйінде отырған сияқты.
Dialogue: 0,0:29:05.82,0:29:07.53,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:29:07.62,0:29:10.87,Default,,0,0,0,,Саған шабуыл жасаған бетперде киген бейбақ кім екенін білесің бе?
Dialogue: 0,0:29:10.95,0:29:12.25,Default,,0,0,0,,Саана
Dialogue: 0,0:29:12.33,0:29:15.33,Default,,0,0,0,,Оның қылыш шеберлігі өте әсерлі болды.
Dialogue: 0,0:29:15.42,0:29:17.33,Default,,0,0,0,,That's right.
Dialogue: 0,0:29:17.42,0:29:19.67,Default,,0,0,0,,Джумонджи кесінді…
Dialogue: 0,0:29:19.75,0:29:23.09,Default,,0,0,0,,Бұл адвокат Кугакидің денесінде қалған нәрсемен бірдей.
Dialogue: 0,0:29:23.67,0:29:26.72,Default,,0,0,0,,Басқаша айтқанда, ол Кугакиді өлтірген кінәлі...
Dialogue: 0,0:29:26.80,0:29:28.34,Default,,0,0,0,,Егер солай болса
Dialogue: 0,0:29:28.43,0:29:31.85,Default,,0,0,0,,Менің қайда екенімді қайдан білді?
Dialogue: 0,0:29:32.43,0:29:33.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:35.98,0:29:37.77,Default,,0,0,0,,Менің ойымша, сіз бұл жігіттің соңынан ергенсіз.
Dialogue: 0,0:29:37.85,0:29:40.73,Default,,0,0,0,,Бұл таратқыш па?
Dialogue: 0,0:29:40.82,0:29:42.94,Default,,0,0,0,,Бұл сіз де жиі қолданатын қозғалыс.
Dialogue: 0,0:29:43.03,0:29:44.32,Default,,0,0,0,,Ұлы ұры
Dialogue: 0,0:29:44.40,0:29:46.65,Default,,0,0,0,,Мұны маған айтпадың ба?
Dialogue: 0,0:29:46.74,0:29:48.53,Default,,0,0,0,,Детектив
Dialogue: 0,0:29:51.16,0:29:53.29,Default,,0,0,0,,- Иә! - (Хайдзи) Күте тұрыңыз!
Dialogue: 0,0:29:53.37,0:29:55.41,Default,,0,0,0,,Қылыш пен қазынаны не істеуіміз керек?
Dialogue: 0,0:29:55.50,0:29:56.87,Default,,0,0,0,,Мен қылышты қолданамын!
Dialogue: 0,0:29:56.96,0:30:00.21,Default,,0,0,0,,Балалар, сендер осындай жұмбақтарды жақсы шешесіңдер, солай ма?
Dialogue: 0,0:30:00.29,0:30:02.13,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,0:30:02.21,0:30:03.88,Default,,0,0,0,,Сол жігіт!
Dialogue: 0,0:30:06.05,0:30:08.38,Default,,0,0,0,,- (Хедзи) Эй Кудо - А?
Dialogue: 0,0:30:08.97,0:30:12.14,Default,,0,0,0,,Сіз кездейсоқ ағасыз ба?
Dialogue: 0,0:30:12.72,0:30:14.35,Default,,0,0,0,,Кенеттен не болды...
Dialogue: 0,0:30:14.43,0:30:17.73,Default,,0,0,0,,Мен Юби Кидпен төбелескенімде оның түрін көрдім.
Dialogue: 0,0:30:17.81,0:30:19.73,Default,,0,0,0,,Ол дәл сіз жасаған нәрсені жасады.
Dialogue: 0,0:30:19.81,0:30:20.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:20.98,0:30:23.65,Default,,0,0,0,,Менің даусым да сенікіне ұқсайды.
Dialogue: 0,0:30:23.73,0:30:25.99,Default,,0,0,0,,-Бұл жай ғана кездейсоқтық емес пе? -(Хедзи) Кездейсоқ па?
Dialogue: 0,0:30:26.07,0:30:27.40,Default,,0,0,0,,О
Dialogue: 0,0:30:27.49,0:30:29.66,Default,,0,0,0,,Иә, біреуге еліктеу
Dialogue: 0,0:30:31.53,0:30:33.28,Default,,0,0,0,,Бұл жай ғана кездейсоқтық
Dialogue: 0,0:30:34.79,0:30:36.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:30:36.66,0:30:38.79,Default,,0,0,0,,Иә, жарай ма?
Dialogue: 0,0:30:39.46,0:30:40.67,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:30:40.75,0:30:43.13,Default,,0,0,0,,Бұл қызықты болды, сондықтан мен оны соңына дейін міндім.
Dialogue: 0,0:30:43.21,0:30:44.09,Default,,0,0,0,,Жоқ
Dialogue: 0,0:30:44.17,0:30:46.63,Default,,0,0,0,,Мен де трамвайға мінгім келді.
Dialogue: 0,0:30:46.71,0:30:48.30,Default,,0,0,0,,
Dialogue: 0,0:30:50.05,0:30:52.64,Default,,0,0,0,,Мүмкін Моуридің қызы шығар?
Dialogue: 0,0:30:54.14,0:30:55.14,Default,,0,0,0,,Кокояна
Dialogue: 0,0:30:55.72,0:30:58.39,Default,,0,0,0,,Сіз инспектор Нишимураға Фукудзо мырза туралы хабардар еттіңіз бе?
Dialogue: 0,0:30:58.48,0:31:00.60,Default,,0,0,0,,Ах, қылышты салып жатқанда.
Dialogue: 0,0:31:00.69,0:31:02.94,Default,,0,0,0,,Біз осында кездесуіміз керек...
Dialogue: 0,0:31:03.02,0:31:04.73,Default,,0,0,0,,
Dialogue: 0,0:31:04.82,0:31:05.65,Default,,0,0,0,,Бұл сол ма?
Dialogue: 0,0:31:06.61,0:31:07.78,Default,,0,0,0,,Ах Хэйдзи
Dialogue: 0,0:31:07.86,0:31:10.07,Default,,0,0,0,,Казуха, сен неге қостың?
Dialogue: 0,0:31:10.15,0:31:11.53,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:31:11.61,0:31:13.95,Default,,0,0,0,,Мен екеуіңді қонақүйге апаруым керек еді.
Dialogue: 0,0:31:14.03,0:31:17.04,Default,,0,0,0,,Жолда инспектор Нишимура осы жерден тоқтауымды айтты.
Dialogue: 0,0:31:17.12,0:31:19.91,Default,,0,0,0,,А, біз үшін алаңдамаңыз.
Dialogue: 0,0:31:20.00,0:31:22.38,Default,,0,0,0,,Мен бір жерден такси аламын.
Dialogue: 0,0:31:24.50,0:31:26.09,Default,,0,0,0,,Ах! Бұл маған тиді
Dialogue: 0,0:31:26.17,0:31:30.09,Default,,0,0,0,,Не? Окита-кун, матчқа не болды?
Dialogue: 0,0:31:30.17,0:31:32.09,Default,,0,0,0,,Иә, мен жарты жолда қалыс қалдым.
Dialogue: 0,0:31:32.68,0:31:35.10,Default,,0,0,0,,Хатторидің Оран турнирі қызықсыз.
Dialogue: 0,0:31:35.18,0:31:38.64,Default,,0,0,0,,Мына бір сөз: Шағымданба, ашуымнан арыла алмайтын сияқтымын.
Dialogue: 0,0:31:38.73,0:31:41.10,Default,,0,0,0,,Мен барлық жерден іздедім.
Dialogue: 0,0:31:41.69,0:31:43.23,Default,,0,0,0,,- (Хедзи) Не... - Не?
Dialogue: 0,0:31:43.81,0:31:45.27,Default,,0,0,0,,Эй, бұл Бала.
Dialogue: 0,0:31:45.36,0:31:49.24,Default,,0,0,0,,О, сен Киото диалектісінде не істеп жүрсің?
Dialogue: 0,0:31:50.49,0:31:52.24,Default,,0,0,0,,- (Әулие) Казуха-чан! -(Қазуба) А.
Dialogue: 0,0:31:52.32,0:31:53.70,Default,,0,0,0,,Фукудзо мырза
Dialogue: 0,0:31:53.78,0:31:55.74,Default,,0,0,0,,Әлде... Казуха-чан?
Dialogue: 0,0:31:55.83,0:31:57.74,Default,,0,0,0,,Казуха-чан, бір-біріңді танисыңдар ма?
Dialogue: 0,0:31:57.83,0:31:59.75,Default,,0,0,0,,Иә, мен сені бүгін таңертең турнирде көремін.
Dialogue: 0,0:31:59.83,0:32:02.00,Default,,0,0,0,,Окита-кун да сенімен бірге ме?
Dialogue: 0,0:32:02.08,0:32:04.13,Default,,0,0,0,,Менің үйімде істейтін бірдеңе болса, кіріңіз.
Dialogue: 0,0:32:04.71,0:32:06.71,Default,,0,0,0,,А... бұл мен емес.
Dialogue: 0,0:32:06.79,0:32:10.80,Default,,0,0,0,,Мен сені енді көремін деп ойламадым. Хакодатеде қанша уақыт боласыз?
Dialogue: 0,0:32:10.88,0:32:13.64,Default,,0,0,0,,Жарайды... Ертеңіне дейін күйдіремін.
Dialogue: 0,0:32:14.30,0:32:18.35,Default,,0,0,0,,Қаласаңыз, мен сіздермен Хакодатедегі көрікті жерлермен бөліскім келеді...
Dialogue: 0,0:32:18.43,0:32:20.89,Default,,0,0,0,,Күт, күт, күт, күт, күт!
Dialogue: 0,0:32:20.98,0:32:24.06,Default,,0,0,0,,Неге, сен Казухамен жақсы таныссың!
Dialogue: 0,0:32:24.15,0:32:25.86,Default,,0,0,0,,Ал, сен кімсің?
Dialogue: 0,0:32:25.94,0:32:28.57,Default,,0,0,0,,Хэйдзи Хаттори Казуханың бала күнгі досы
Dialogue: 0,0:32:28.65,0:32:31.90,Default,,0,0,0,,Мен көремін. Біз бір-бірімізді бала кезімізден білеміз.
Dialogue: 0,0:32:31.99,0:32:33.40,Default,,0,0,0,,Бұл... Көбінесе Хана Казуха
Dialogue: 0,0:32:33.49,0:32:35.45,Default,,0,0,0,,Мені көркем жерлер қызықтырмайды!
Dialogue: 0,0:32:36.03,0:32:39.16,Default,,0,0,0,,Оның үстіне мен сенімен ешқашан бармас едім, ақымақ!
Dialogue: 0,0:32:39.24,0:32:40.75,Default,,0,0,0,,Уау, Хэйдзи...
Dialogue: 0,0:32:40.83,0:32:42.71,Default,,0,0,0,,Хэйдзи Хаттори…
Dialogue: 0,0:32:43.25,0:32:45.12,Default,,0,0,0,,Бұл есім есімде.
Dialogue: 0,0:32:45.21,0:32:50.00,Default,,0,0,0,,Ол осы турнирде жеңіске жетудің фавориттерінің бірі, бірақ қандай да бір себептермен матчқа қатыспады.
Dialogue: 0,0:32:50.09,0:32:51.63,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,0:32:51.71,0:32:54.13,Default,,0,0,0,,Онда неге менімен жарыспайсың?
Dialogue: 0,0:32:54.22,0:32:56.64,Default,,0,0,0,,Қылышыңды сермеуге қиналып жүрсің бе?
Dialogue: 0,0:32:56.72,0:32:58.30,Default,,0,0,0,,Бұл ойын ма?
Dialogue: 0,0:32:58.39,0:33:01.64,Default,,0,0,0,,Егер мен жеңсем, мен оған Хакодаттың айналасын көрсетемін.
Dialogue: 0,0:33:01.72,0:33:03.81,Default,,0,0,0,,- (Қазуба) А? -(Хедзи) Мен жеңсем ше?
Dialogue: 0,0:33:03.89,0:33:07.15,Default,,0,0,0,,Мен сізге Хакодаттағы ең керемет көріністі айтамын
Dialogue: 0,0:33:07.23,0:33:08.86,Default,,0,0,0,,Керемет көрініс?
Dialogue: 0,0:33:08.94,0:33:10.65,Default,,0,0,0,,Мен... алмаймын.
Dialogue: 0,0:33:11.23,0:33:13.65,Default,,0,0,0,,А-а... тек жолы болғандай көрінді.
Dialogue: 0,0:33:14.70,0:33:16.16,Default,,0,0,0,,Окита-кун, тоқтат.
Dialogue: 0,0:33:16.24,0:33:19.37,Default,,0,0,0,,Иә? Неліктен? Қызық сияқты.
Dialogue: 0,0:33:19.45,0:33:20.66,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:33:21.24,0:33:23.16,Default,,0,0,0,,Алдымен есін жоғалтқан дұрыс...
Dialogue: 0,0:33:23.25,0:33:25.92,Default,,0,0,0,,Жоғалту және жеңілу
Dialogue: 0,0:33:31.96,0:33:33.01,Default,,0,0,0,,О...
Dialogue: 0,0:33:39.97,0:33:41.01,Default,,0,0,0,,Бұл адам…
Dialogue: 0,0:33:41.10,0:33:42.77,Default,,0,0,0,,Yayoriru
Dialogue: 0,0:33:43.47,0:33:45.27,Default,,0,0,0,,- (Хедзи) Ия! - (Әулие) Әй!
Dialogue: 0,0:33:48.81,0:33:50.15,Default,,0,0,0,,Екеуің тоқтаңдар!
Dialogue: 0,0:33:51.07,0:33:52.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:52.28,0:33:53.44,Default,,0,0,0,,Ах
Dialogue: 0,0:33:55.11,0:33:57.45,Default,,0,0,0,,Қасиетті, не болып жатыр?
Dialogue: 0,0:33:58.20,0:34:01.08,Default,,0,0,0,,Бақшада жарысу оңай емес.
Dialogue: 0,0:34:01.16,0:34:03.70,Default,,0,0,0,,Осындай шу шығарғаным үшін кешіріңіз, әке.
Dialogue: 0,0:34:03.79,0:34:05.91,Default,,0,0,0,,Сіз кіреберісті тазалауды аяқтадыңыз ба?
Dialogue: 0,0:34:06.00,0:34:07.04,Default,,0,0,0,,Бітті
Dialogue: 0,0:34:07.12,0:34:08.17,Default,,0,0,0,,Дегенмен, Титан аумағына әрбір шығу
Dialogue: 0,0:34:08.25,0:34:09.96,Default,,0,0,0,,Кіре берістегі энергияны реттеу арқылы
Dialogue: 0,0:34:10.04,0:34:12.46,Default,,0,0,0,,Сәттілік табиғи түрде келеді.
Dialogue: 0,0:34:13.38,0:34:14.51,Default,,0,0,0,,Иә...
Dialogue: 0,0:34:14.59,0:34:16.47,Default,,0,0,0,,Сонда сіз ше?
Dialogue: 0,0:34:16.55,0:34:20.89,Default,,0,0,0,,Райо Фукудзо, солай ма? Менің атым Кавазоэ, префектуралық полиция қызметкері.
Dialogue: 0,0:34:20.97,0:34:26.02,Default,,0,0,0,,Мен сізден Кейзабуро Акие жасырған қазына туралы сұрағым келеді.
Dialogue: 0,0:34:26.10,0:34:27.89,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:34:27.98,0:34:29.35,Default,,0,0,0,,Үйде сөйлесейік
Dialogue: 0,0:34:29.44,0:34:30.73,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:34:31.52,0:34:33.40,Default,,0,0,0,,Сонда бізде бұл бар
Dialogue: 0,0:34:33.48,0:34:35.49,Default,,0,0,0,,Мен алдымен қонақүйге қайтамын.
Dialogue: 0,0:34:42.41,0:34:43.70,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:34:43.79,0:34:45.87,Default,,0,0,0,,- (Кавазоэ) Жақсысың ба? -(Рёи) Иә.
Dialogue: 0,0:34:45.95,0:34:48.16,Default,,0,0,0,,Өйткені ол ұзақ уақыт бойы аурумен ауырады.
Dialogue: 0,0:34:49.25,0:34:50.88,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:34:50.96,0:34:56.42,Default,,0,0,0,,Эйрю Хигашикубоның қылышы - Кейзабуро Акоэ қазынасының кілті.
Dialogue: 0,0:34:56.51,0:34:59.26,Default,,0,0,0,,Мен бұл туралы естідім.
Dialogue: 0,0:34:59.34,0:35:02.47,Default,,0,0,0,,Бір күні маған біреу келеді.
Dialogue: 0,0:35:02.55,0:35:05.39,Default,,0,0,0,,Фукуджо мырзаның қолындағы екі қылыш
Dialogue: 0,0:35:05.47,0:35:07.48,Default,,0,0,0,,Оны қалай алдың?
Dialogue: 0,0:35:08.02,0:35:09.31,Default,,0,0,0,,Менің арғы атам
Dialogue: 0,0:35:09.39,0:35:12.94,Default,,0,0,0,,Оны маған Кейзабуро Акоенің өзі берген деп естідім.
Dialogue: 0,0:35:13.02,0:35:15.57,Default,,0,0,0,,Менің арғы атам өлкетануды зерттеген.
Dialogue: 0,0:35:15.65,0:35:19.49,Default,,0,0,0,,Тосизо Хиджикатаға ғашық болған Кейзабуро Акимен
Dialogue: 0,0:35:19.57,0:35:21.49,Default,,0,0,0,,Біз келіскен сияқтымыз.
Dialogue: 0,0:35:21.57,0:35:24.37,Default,,0,0,0,,Маған сол қылышты көрсетсеңші...
Dialogue: 0,0:35:24.45,0:35:26.29,Default,,0,0,0,,Сіз қалайсыз?
Dialogue: 0,0:35:26.37,0:35:27.75,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:35:27.83,0:35:30.00,Default,,0,0,0,,- (Рйоэй) Хиджири - (Хиджири) Ия, бірақ...
Dialogue: 0,0:35:30.08,0:35:33.67,Default,,0,0,0,,Маған да сол суретті әкел.
Dialogue: 0,0:35:33.75,0:35:34.75,Default,,0,0,0,,Иә
Dialogue: 0,0:35:34.84,0:35:36.63,Default,,0,0,0,,-Рёэ-сан - (Рёэ) Иә?
Dialogue: 0,0:35:36.71,0:35:38.76,Default,,0,0,0,,Мына жерде сіздің бөлмеңізді қарауға болады ма?
Dialogue: 0,0:35:38.84,0:35:41.13,Default,,0,0,0,,- (Рёэй) Ой, жарайды - Ия!
Dialogue: 0,0:35:42.13,0:35:43.64,Default,,0,0,0,,Iaido турнирі…
Dialogue: 0,0:35:43.72,0:35:46.85,Default,,0,0,0,,Бұл таңқаларлық. Бұның бәрі Хиджри-сандікі.
Dialogue: 0,0:35:46.93,0:35:48.89,Default,,0,0,0,,Рёи иайдемен де айналыса ма?
Dialogue: 0,0:35:49.48,0:35:53.19,Default,,0,0,0,,Біз ұрпақтар бойы Iaido нұсқаушысы ретінде қызмет еттік.
Dialogue: 0,0:35:53.27,0:35:56.94,Default,,0,0,0,,Мен ақылға қонымсыз болдым және бірден кеттім.
Dialogue: 0,0:35:57.02,0:36:01.90,Default,,0,0,0,,Хиджиридің шебер болғаны сонша, ол Фукуджо отбасындағы өзінен бұрынғылардан асып түсті.
Dialogue: 0,0:36:01.99,0:36:04.28,Default,,0,0,0,,Ол мен мақтанатын ұлым.
Dialogue: 0,0:36:04.37,0:36:06.66,Default,,0,0,0,,Бұл «сондай» емес, солай емес пе?
Dialogue: 0,0:36:06.74,0:36:08.66,Default,,0,0,0,,Эй, қандай кездейсоқтық, Жучи!
Dialogue: 0,0:36:09.25,0:36:11.16,Default,,0,0,0,,Хигашикубо Эйрюдің қылышы!
Dialogue: 0,0:36:11.75,0:36:14.58,Default,,0,0,0,,Пішіні Кугаки әкелген пішінмен бірдей.
Dialogue: 0,0:36:14.67,0:36:16.54,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:36:17.50,0:36:19.42,Default,,0,0,0,,Бұл қандай қағаз?
Dialogue: 0,0:36:19.51,0:36:22.17,Default,,0,0,0,,Оған қылышпен бірге берілген болса керек.
Dialogue: 0,0:36:22.26,0:36:26.18,Default,,0,0,0,,Мен бұл нені білдіретінін білмеймін.
Dialogue: 0,0:36:26.80,0:36:28.68,Default,,0,0,0,,Енді оны өзіңізбен бірге алыңыз.
Dialogue: 0,0:36:28.76,0:36:31.23,Default,,0,0,0,,Рахмет (ұялы телефонның діріл дыбысы)
Dialogue: 0,0:36:31.31,0:36:32.81,Default,,0,0,0,,Маған мұқият қарауыңызды өтінемін.
Dialogue: 0,0:36:32.89,0:36:34.15,Default,,0,0,0,,- (Кавазоэ) Иә... - (Хедзи) Әрине.
Dialogue: 0,0:36:34.23,0:36:36.19,Default,,0,0,0,,Иә, бұл рас па?
Dialogue: 0,0:36:36.77,0:36:40.19,Default,,0,0,0,,Такузо Акиге шабуыл жасалып, ауруханаға жеткізілген сияқты!
Dialogue: 0,0:36:46.03,0:36:48.16,Default,,0,0,0,,Мен адвокат Кугаки туралы естідім.
Dialogue: 0,0:36:48.24,0:36:50.45,Default,,0,0,0,,Мен Хакодате полиция бөлімшесіне бара жатыр едім.
Dialogue: 0,0:36:51.04,0:36:53.96,Default,,0,0,0,,Мені кенет жүк көлігі соқты... Ауырды.
Dialogue: 0,0:36:54.04,0:36:55.96,Default,,0,0,0,,Бұл жай ғана оқыс оқиға емес пе?
Dialogue: 0,0:36:56.04,0:36:58.59,Default,,0,0,0,,Жоқ, бұл кездейсоқ емес еді.
Dialogue: 0,0:36:58.67,0:37:00.46,Default,,0,0,0,,Мен саған әдейі соқтығыстым!
Dialogue: 0,0:37:00.55,0:37:02.42,Default,,0,0,0,,- (Такузо) Ах! -(Накамори) Ой
Dialogue: 0,0:37:02.51,0:37:04.63,Default,,0,0,0,,Әй, жақсысың ба?
Dialogue: 0,0:37:04.72,0:37:06.76,Default,,0,0,0,,Иә, кешіріңіз
Dialogue: 0,0:37:06.84,0:37:09.26,Default,,0,0,0,,Сонымен, сіз кінәлі адамды танисыз ба?
Dialogue: 0,0:37:09.35,0:37:13.06,Default,,0,0,0,,Менің естуімше, Кадокурадан біреу сияқты...
Dialogue: 0,0:37:13.14,0:37:14.73,Default,,0,0,0,,Мотив қазына ма?
Dialogue: 0,0:37:14.81,0:37:18.98,Default,,0,0,0,,Атасы жасырған қазынаның соңынан ергені анық.
Dialogue: 0,0:37:20.11,0:37:22.78,Default,,0,0,0,,Баршаңызға сеніп тапсырғым келетін бір нәрсе бар.
Dialogue: 0,0:37:24.86,0:37:29.03,Default,,0,0,0,,Бұл менің үйімде уакизашимен бірге сақталған.
Dialogue: 0,0:37:29.12,0:37:31.95,Default,,0,0,0,,Бұл сізге қазына табу керек нәрсе.
Dialogue: 0,0:37:32.04,0:37:34.58,Default,,0,0,0,,Бұл қазына картасы деп аталатын нәрсе ме?
Dialogue: 0,0:37:34.66,0:37:36.79,Default,,0,0,0,,Бірақ бұл маған енді керек емес
Dialogue: 0,0:37:36.87,0:37:39.09,Default,,0,0,0,,Қазынадан алу
Dialogue: 0,0:37:39.17,0:37:42.26,Default,,0,0,0,,Өмірсіз ешнәрсеге қол жеткізілмейді
Dialogue: 0,0:37:42.34,0:37:45.42,Default,,0,0,0,,Тіпті мен сенген Кугаки де...
Dialogue: 0,0:37:49.64,0:37:51.89,Default,,0,0,0,,(орындыққа отыру дыбысы)
Dialogue: 0,0:37:51.97,0:37:52.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:53.39,0:37:54.81,Default,,0,0,0,,Юбе Баланы қуып келеді
Dialogue: 0,0:37:54.89,0:37:57.56,Default,,0,0,0,,Ол Хакодаттың айналасында жүгіріп келе жатқанын айтты.
Dialogue: 0,0:37:58.31,0:37:59.56,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:37:59.65,0:38:00.69,Default,,0,0,0,,Аһ!
Dialogue: 0,0:38:00.77,0:38:01.82,Default,,0,0,0,,Карта
Dialogue: 0,0:38:01.90,0:38:04.65,Default,,0,0,0,,Туристік орындарда белгілер болды.
Dialogue: 0,0:38:04.74,0:38:08.57,Default,,0,0,0,,Расында, сен аралап жүргенде тексеріп тұрған жоқсың ба?
Dialogue: 0,0:38:08.66,0:38:13.12,Default,,0,0,0,,Я... сен маған солай қарап тұрсың. Кудо күткендей... бұл...
Dialogue: 0,0:38:13.20,0:38:14.75,Default,,0,0,0,,Сіз Хакодате тауында болдыңыз ба?
Dialogue: 0,0:38:14.83,0:38:17.08,Default,,0,0,0,,Бұлай тауға шығудың мәні жоқ.
Dialogue: 0,0:38:17.16,0:38:18.83,Default,,0,0,0,,Хаттори-кун, сен білмейсің бе?
Dialogue: 0,0:38:19.54,0:38:21.34,Default,,0,0,0,,Хакодате тауынан түнгі көрініс
Dialogue: 0,0:38:21.92,0:38:24.59,Default,,0,0,0,,Бұл «миллион долларлық түнгі көрініс» деп айтылады.
Dialogue: 0,0:38:24.67,0:38:27.26,Default,,0,0,0,,Не... миллион доллар?
Dialogue: 0,0:38:27.34,0:38:29.84,Default,,0,0,0,,Бұл өте романтикалық.
Dialogue: 0,0:38:29.93,0:38:32.05,Default,,0,0,0,,Мен ол жерге міндетті түрде барар едім...
Dialogue: 0,0:38:32.14,0:38:34.85,Default,,0,0,0,,Эй, мен сенен бірнәрсе сұрайын деп едім.
Dialogue: 0,0:38:35.73,0:38:37.85,Default,,0,0,0,,Миллион доллардың түнгі көрінісі...
Dialogue: 0,0:38:38.85,0:38:40.35,Default,,0,0,0,,Биг Бенден жоғары ма?
Dialogue: 0,0:38:40.44,0:38:41.90,Default,,0,0,0,,А...
Dialogue: 0,0:38:44.07,0:38:45.90,Default,,0,0,0,,Мен сүйген әйелдің жүрегі...
Dialogue: 0,0:38:47.24,0:38:49.16,Default,,0,0,0,,Иә! Әлбетте жақсырақ
Dialogue: 0,0:38:49.74,0:38:51.20,Default,,0,0,0,,Шиничи Кешіріңіз
Dialogue: 0,0:38:51.28,0:38:54.16,Default,,0,0,0,,Енді Хаттори-кунды қолдауым керек.
Dialogue: 0,0:38:55.16,0:38:56.16,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:38:56.75,0:38:58.71,Default,,0,0,0,,Биг Бенден жоғары ма?
Dialogue: 0,0:39:06.38,0:39:07.42,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:39:09.38,0:39:10.51,Default,,0,0,0,,Ах, кешір, кешір
Dialogue: 0,0:39:10.59,0:39:12.72,Default,,0,0,0,,...Өте сақ болыңыз.
Dialogue: 0,0:39:12.80,0:39:15.56,Default,,0,0,0,,Детектив Мори мен инспектор Нишимура қазір
Dialogue: 0,0:39:15.64,0:39:19.10,Default,,0,0,0,,Адвокат Кугакиді өлтіру ісіне назар аудару туралы шешім қабылданды.
Dialogue: 0,0:39:19.19,0:39:22.56,Default,,0,0,0,,Біз бұл қылыштың жұмбағын шешуіміз керек.
Dialogue: 0,0:39:22.65,0:39:23.86,Default,,0,0,0,,Міне, қылыш
Dialogue: 0,0:39:23.94,0:39:26.82,Default,,0,0,0,,Кайтоу Кидтің де көздегені осы.
Dialogue: 0,0:39:26.90,0:39:29.86,Default,,0,0,0,,Мына жігіт сондай сенімді түрде ішке кірді
Dialogue: 0,0:39:30.61,0:39:33.87,Default,,0,0,0,,Сондай-ақ, мен бұл жолы Кидті екі рет көрдім.
Dialogue: 0,0:39:33.95,0:39:36.70,Default,,0,0,0,,Хаттори-кун, Эдогава-кун және...
Dialogue: 0,0:39:36.79,0:39:38.37,Default,,0,0,0,,Кеше сәлем
Dialogue: 0,0:39:38.45,0:39:39.87,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:39:39.96,0:39:43.92,Default,,0,0,0,,Менің ең жақын досым Хэйдзи менімен бірге келгісі келеді.
Dialogue: 0,0:39:44.00,0:39:45.75,Default,,0,0,0,,Менің артымнан жүр~
Dialogue: 0,0:39:45.84,0:39:48.63,Default,,0,0,0,,Бұл жігіттің Киото диалектісі мені ашуландырады.
Dialogue: 0,0:39:48.71,0:39:49.76,Default,,0,0,0,,That's right.
Dialogue: 0,0:39:50.38,0:39:53.22,Default,,0,0,0,,Бұл кестені Такузо Аки берген
Dialogue: 0,0:39:53.30,0:39:54.76,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:39:54.85,0:39:57.77,Default,,0,0,0,,Ироха тілінде жазылған 48 әріп бар.
Dialogue: 0,0:39:58.31,0:40:00.27,Default,,0,0,0,,Бұйрық ақылсыз.
Dialogue: 0,0:40:00.94,0:40:05.27,Default,,0,0,0,,Бұл менің кеше түлкі жігітпен соғысқан қылышым.
Dialogue: 0,0:40:05.82,0:40:08.90,Default,,0,0,0,,Бұл қылышта мекүги және мекуги тесіктері бар.
Dialogue: 0,0:40:08.98,0:40:10.44,Default,,0,0,0,,Мекуги?
Dialogue: 0,0:40:10.53,0:40:11.53,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:40:11.61,0:40:15.91,Default,,0,0,0,,Бұл пышақты тұтқадан түсіріп алмас үшін шеге сияқты.
Dialogue: 0,0:40:15.99,0:40:19.87,Default,,0,0,0,,Қасиетті орындардағы кейбір әулие қылыштарында мекүги жоқ сияқты.
Dialogue: 0,0:40:19.95,0:40:21.79,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:40:21.87,0:40:24.46,Default,,0,0,0,,Мен мұның мағынасы бар ма деп ойлаймын.
Dialogue: 0,0:40:24.54,0:40:27.80,Default,,0,0,0,,Әй, бұл қылыштың да мекугиі жоқ.
Dialogue: 0,0:40:27.88,0:40:31.05,Default,,0,0,0,,Екеуін де Кадокура алды.
Dialogue: 0,0:40:31.13,0:40:34.05,Default,,0,0,0,,Қалған төртеуінің мекүгісі бар.
Dialogue: 0,0:40:34.14,0:40:35.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:35.89,0:40:37.56,Default,,0,0,0,,Әй, сенде балға бар ма?
Dialogue: 0,0:40:37.64,0:40:38.93,Default,,0,0,0,,А, жақсы
Dialogue: 0,0:40:43.23,0:40:46.94,Default,,0,0,0,,Мекуги-ананың әртүрлі пішіндері бар.
Dialogue: 0,0:40:47.02,0:40:51.86,Default,,0,0,0,,Дегенмен, ең жақсы мекүги тесігі - мінсіз шеңбер деп есептеледі.
Dialogue: 0,0:40:51.94,0:40:55.07,Default,,0,0,0,,Қылыштың соққысын кең жерде қабылдауға болады.
Dialogue: 0,0:40:55.16,0:40:56.87,Default,,0,0,0,,Егер тамаша шеңбер дұрыс болса
Dialogue: 0,0:40:56.95,0:40:59.29,Default,,0,0,0,,Олардың барлығы тамаша шеңберлер болса жақсы емес пе?
Dialogue: 0,0:40:59.37,0:41:02.83,Default,,0,0,0,,Оның мұндай оғаш пішінде болуының бір себебі болуы керек.
Dialogue: 0,0:41:04.71,0:41:06.33,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:41:06.42,0:41:10.71,Default,,0,0,0,,Шеңберлер, жартылай шеңберлер және жұлдыз пішіндері. Мен олардың нені білдіретінін білмеймін.
Dialogue: 0,0:41:10.80,0:41:12.34,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:41:17.39,0:41:19.60,Default,,0,0,0,,Ай... бұл не?
Dialogue: 0,0:41:19.68,0:41:20.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:21.39,0:41:23.85,Default,,0,0,0,,Түнгі аспанда жарқыраған ай
Dialogue: 0,0:41:23.93,0:41:25.39,Default,,0,0,0,,Мен аспанда ұшқан сайын —
Dialogue: 0,0:41:26.56,0:41:28.40,Default,,0,0,0,,Ол бағдар ретінде қызмет етеді.
Dialogue: 0,0:41:29.06,0:41:32.53,Default,,0,0,0,,Мекуги тесігі жоқ қылыш жаңа айды бейнелейді.
Dialogue: 0,0:41:32.61,0:41:36.91,Default,,0,0,0,,Жарты айдың бірі өсіп келе жатқан ай, бірі азайып бара жатқан ай.
Dialogue: 0,0:41:36.99,0:41:39.53,Default,,0,0,0,,Керемет шеңбер - толық ай
Dialogue: 0,0:41:41.24,0:41:46.29,Default,,0,0,0,,Аспанда ұшу... Ұша аласың ба?
Dialogue: 0,0:41:46.37,0:41:50.09,Default,,0,0,0,,Иә? Жоқ, мысалы! Мысал ше?
Dialogue: 0,0:41:50.17,0:41:52.09,Default,,0,0,0,,Сәлем, Кейзабуро Аки.
Dialogue: 0,0:41:52.17,0:41:54.51,Default,,0,0,0,,Сіз Тосизо Хиджикатаның жанкүйері болдыңыз, солай ма?
Dialogue: 0,0:41:54.59,0:41:57.09,Default,,0,0,0,,Олай болса, Хиджиката атымен аталған нәрсе емес пе?
Dialogue: 0,0:41:57.18,0:42:00.93,Default,,0,0,0,,Бұл сызық әрине мүмкін.
Dialogue: 0,0:42:02.43,0:42:04.18,Default,,0,0,0,,Хиджиката мен Цуки...
Dialogue: 0,0:42:04.27,0:42:05.60,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:42:06.19,0:42:07.81,Default,,0,0,0,,Жоқ, мен мүлде түсінбеймін.
Dialogue: 0,0:42:07.90,0:42:09.31,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:42:09.40,0:42:13.15,Default,,0,0,0,,Тосизо Хиджиката тарихына үңілгіңіз келе ме?
Dialogue: 0,0:42:13.23,0:42:14.07,Default,,0,0,0,,Сәлеметсіз бе? Ол кім?
Dialogue: 0,0:42:14.15,0:42:15.24,Default,,0,0,0,,Суық!
Dialogue: 0,0:42:15.32,0:42:16.70,Default,,0,0,0,,Әй, Хэйдзи-кун!
Dialogue: 0,0:42:16.78,0:42:18.32,Default,,0,0,0,,Ол ақыры шықты!
Dialogue: 0,0:42:18.41,0:42:19.49,Default,,0,0,0,,Сондай-ақ... күзгі жапырақтар?
Dialogue: 0,0:42:19.57,0:42:21.87,Default,,0,0,0,,Сіз бұл санды қайдан білесіз?
Dialogue: 0,0:42:21.95,0:42:26.00,Default,,0,0,0,,Хехехе, мен Иориден біраз зерттеу жүргізуін өтіндім.
Dialogue: 0,0:42:26.08,0:42:27.75,Default,,0,0,0,,Хона, маған кеше белгісіз қоңырау келді.
Dialogue: 0,0:42:27.83,0:42:29.96,Default,,0,0,0,,Мен Джё-санды кездестіреді деп күтпедім...
Dialogue: 0,0:42:30.04,0:42:31.50,Default,,0,0,0,,Иә! Бұл менің үйім
Dialogue: 0,0:42:32.09,0:42:33.67,Default,,0,0,0,,Хэйдзи-кунды іздеймін
Dialogue: 0,0:42:33.75,0:42:37.63,Default,,0,0,0,,Саппоро, Отару және Абашириді аралаған соң, мен қазір Вакканайдамын.
Dialogue: 0,0:42:37.72,0:42:39.01,Default,,0,0,0,,Қараңдаршы, көріп тұрсың ба?
Dialogue: 0,0:42:39.09,0:42:41.51,Default,,0,0,0,,Бұл Жапонияның ең солтүстік нүктесі
Dialogue: 0,0:42:42.10,0:42:43.14,Default,,0,0,0,,Я...
Dialogue: 0,0:42:43.22,0:42:45.27,Default,,0,0,0,,Осындай нәрсені көргенде солай болады.
Dialogue: 0,0:42:45.93,0:42:47.98,Default,,0,0,0,,Мен қазір істі тергеп жатырмын...
Dialogue: 0,0:42:48.56,0:42:50.85,Default,,0,0,0,,Иә? Сол тақта...
Dialogue: 0,0:42:50.94,0:42:52.86,Default,,0,0,0,,Қарап жібере аласыз ба?
Dialogue: 0,0:42:52.94,0:42:54.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:54.28,0:42:56.19,Default,,0,0,0,,Иә, асығыңыз.
Dialogue: 0,0:42:58.45,0:43:03.49,Default,,0,0,0,,Хиджиката Хан мен Цуки...оның оқиғаға қатысы бар ма?
Dialogue: 0,0:43:03.58,0:43:06.87,Default,,0,0,0,,Бұл байланысты болуы да мүмкін...
Dialogue: 0,0:43:06.95,0:43:11.25,Default,,0,0,0,,Ах... Бұл Хиджиката Ханның «Тойота Хакушудан» айырмашылығы бар ма?
Dialogue: 0,0:43:11.33,0:43:13.75,Default,,0,0,0,,Хогиокухок? Бұл не?
Dialogue: 0,0:43:14.38,0:43:17.88,Default,,0,0,0,,Хиджиката Тамада болғанда хайку шығаратын.
Dialogue: 0,0:43:17.97,0:43:22.26,Default,,0,0,0,,Оларды жинақтайтын кітапшаның тақырыбы: «Тойота Хакушу»
Dialogue: 0,0:43:22.34,0:43:26.06,Default,,0,0,0,,Шинсенгуми жынының командирінің орынбасары хайку өлеңін жазып жатыр.
Dialogue: 0,0:43:26.14,0:43:29.14,Default,,0,0,0,,Сонымен, сіз кім туралы айтып отырсыз?
Dialogue: 0,0:43:29.23,0:43:33.73,Default,,0,0,0,,Тойотама Хакукушуда 41 өлең бар.
Dialogue: 0,0:43:33.81,0:43:36.78,Default,,0,0,0,,Ай көрінетін 6 сөз тіркесі бар.
Dialogue: 0,0:43:37.65,0:43:38.78,Default,,0,0,0,,Бесінші
Dialogue: 0,0:43:38.86,0:43:42.82,Default,,0,0,0,,Ақ пион Айлы түнде бояуыңды қалаймын
Dialogue: 0,0:43:42.91,0:43:44.16,Default,,0,0,0,,19
Dialogue: 0,0:43:44.24,0:43:47.91,Default,,0,0,0,,Көктемгі жаңбыр жарты ай суының түбінде жарқырайды.
Dialogue: 0,0:43:48.50,0:43:49.87,Default,,0,0,0,,20
Dialogue: 0,0:43:49.96,0:43:51.58,Default,,0,0,0,,22
Dialogue: 0,0:43:51.67,0:43:53.08,Default,,0,0,0,,35
Dialogue: 0,0:43:53.17,0:43:54.54,Default,,0,0,0,,36
Dialogue: 0,0:43:54.63,0:43:55.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:43:55.63,0:43:58.38,Default,,0,0,0,,Бұл! Бұл өте үлкен
Dialogue: 0,0:43:58.46,0:44:00.13,Default,,0,0,0,,Күзгі жапырақтар!
Dialogue: 0,0:43:58.46,0:44:00.13,Default,,0,0,0,,(Қоңыраудың дыбысы ажыратылады)
Dialogue: 0,0:44:00.22,0:44:02.13,Default,,0,0,0,,Қазірдің өзінде! Хэйдзи-кун
Dialogue: 0,0:44:02.22,0:44:04.85,Default,,0,0,0,,Қазір қайда екеніңізді сұрайын.
Dialogue: 0,0:44:04.93,0:44:06.64,Default,,0,0,0,,Қазір не болып жатыр, Иори?
Dialogue: 0,0:44:06.72,0:44:11.64,Default,,0,0,0,,Жас ханым, сіз Тосизо Хиджиката туралы ойласаңыз, Горёкаку емес пе?
Dialogue: 0,0:44:11.73,0:44:15.52,Default,,0,0,0,,Сол жерде Горёкакудың панорамалық көрінісін ұсынатын мұнара да бар.
Dialogue: 0,0:44:16.11,0:44:18.69,Default,,0,0,0,,Горёкаку Утара Хакодате…
Dialogue: 0,0:44:18.78,0:44:21.90,Default,,0,0,0,,Қазірдің өзінде! Сіз бірінші болған жер емес пе?
Dialogue: 0,0:44:22.82,0:44:24.41,Default,,0,0,0,,Бұл былайша айтқанда айқас кесте.
Dialogue: 0,0:44:24.99,0:44:26.78,Default,,0,0,0,,Кестенің өзі қарапайым.
Dialogue: 0,0:44:26.87,0:44:29.29,Default,,0,0,0,,Маңыздысы - оны оқудың кілті.
Dialogue: 0,0:44:29.37,0:44:32.54,Default,,0,0,0,,Бұл Toyotama Hakukushu-дағы алты хайку.
Dialogue: 0,0:44:33.33,0:44:35.29,Default,,0,0,0,,Бірінші 5-тармақ
Dialogue: 0,0:44:35.38,0:44:38.05,Default,,0,0,0,,0-ден 9-ға дейін жоғарғы қатарда
Dialogue: 0,0:44:38.13,0:44:40.59,Default,,0,0,0,,Басқаша айтқанда, санның 1-ші цифры жоғарғы жағында.
Dialogue: 0,0:44:40.67,0:44:42.93,Default,,0,0,0,,Ондықтар орны сол жақтағы сан екенін көруге болады.
Dialogue: 0,0:44:43.01,0:44:45.59,Default,,0,0,0,,Сонда 5 санына сәйкес әріп...
Dialogue: 0,0:44:46.39,0:44:47.81,Default,,0,0,0,,«Хо» тағы
Dialogue: 0,0:44:47.89,0:44:50.60,Default,,0,0,0,,Келесі 19 1 және 9 саны
Dialogue: 0,0:44:51.39,0:44:52.56,Default,,0,0,0,,«Құда»
Dialogue: 0,0:44:52.64,0:44:54.31,Default,,0,0,0,,Осы қарқынмен қалғандары...
Dialogue: 0,0:44:54.90,0:44:59.02,Default,,0,0,0,,No 20 No 22 No 35 No 36
Dialogue: 0,0:44:59.11,0:45:01.07,Default,,0,0,0,,Ретімен орналастырылған...
Dialogue: 0,0:45:01.15,0:45:03.45,Default,,0,0,0,,...
Dialogue: 0,0:45:03.53,0:45:06.99,Default,,0,0,0,,Хокутоға келсек, бағыт туралы айтайық.
Dialogue: 0,0:45:07.07,0:45:08.33,Default,,0,0,0,,Они дегеніміз не?
Dialogue: 0,0:45:08.41,0:45:10.87,Default,,0,0,0,,Солтүстік-шығыс... мүмкін
Dialogue: 0,0:45:10.95,0:45:13.08,Default,,0,0,0,,Мен мұны бұрын теледидардан көргенмін.
Dialogue: 0,0:45:13.16,0:45:14.75,Default,,0,0,0,,Горёкаку салынған кезде
Dialogue: 0,0:45:14.83,0:45:17.96,Default,,0,0,0,,Солтүстік-шығыс жындар қақпасы, сондықтан олар сол жерге ғибадатхана салды.
Dialogue: 0,0:45:18.04,0:45:21.09,Default,,0,0,0,,Түсіндім! Солтүстік-шығыстағы Они
Dialogue: 0,0:45:21.67,0:45:24.30,Default,,0,0,0,,Мекугиана Горёкаку жұлдыз пішіні ме?
Dialogue: 0,0:45:24.38,0:45:26.09,Default,,0,0,0,,Иә, мен сенімдімін.
Dialogue: 0,0:45:26.18,0:45:29.89,Default,,0,0,0,,Мұқият қарасаңыз, осы алты қылыштың цубасы бір-біріне сай келетінін байқауға болады.
Dialogue: 0,0:45:29.97,0:45:32.56,Default,,0,0,0,,Оның пішіні Горёкакуға ұқсайды.
Dialogue: 0,0:45:32.64,0:45:34.31,Default,,0,0,0,,Бұл қасиетті жерде қазына бар дегенді білдіре ме?
Dialogue: 0,0:45:34.39,0:45:37.06,Default,,0,0,0,,Аа, бірақ қазір ешқайсысы қалмаған сияқты.
Dialogue: 0,0:45:37.15,0:45:37.98,Default,,0,0,0,,Не?
Dialogue: 0,0:45:38.06,0:45:42.07,Default,,0,0,0,,Горёкаку 1864 жылы аяқталды.
Dialogue: 0,0:45:42.15,0:45:44.19,Default,,0,0,0,,Сол кезде солтүстік-шығыс жын қақпасында
Dialogue: 0,0:45:44.28,0:45:46.78,Default,,0,0,0,,Тошогу ғибадатханасы қорғау үшін салынған деседі.
Dialogue: 0,0:45:46.86,0:45:49.20,Default,,0,0,0,,Алайда Хакодате соғысына байланысты бірден кейін,
Dialogue: 0,0:45:49.28,0:45:51.37,Default,,0,0,0,,Ғибадатхананың ғимараты өртенді.
Dialogue: 0,0:45:51.45,0:45:52.58,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:45:52.66,0:45:53.79,Default,,0,0,0,,Жоқ, өртенгеннен кейін.
Dialogue: 0,0:45:53.87,0:45:56.25,Default,,0,0,0,,Ол басқа жерге көшіп кеткен болуы керек.
Dialogue: 0,0:45:56.33,0:45:59.21,Default,,0,0,0,,Кейзабуро Аки бұл кодты жасады.
Dialogue: 0,0:45:59.29,0:46:01.42,Default,,0,0,0,,Соғысқа дейін соғысқа дейін
Dialogue: 0,0:46:01.50,0:46:03.80,Default,,0,0,0,,Бұл Хакодате соғысынан әлдеқайда кейінірек болды.
Dialogue: 0,0:46:03.88,0:46:06.51,Default,,0,0,0,,Содан кейін код нені көрсетеді
Dialogue: 0,0:46:06.59,0:46:08.30,Default,,0,0,0,,Бұл көшкеннен кейінгі орын емес пе?
Dialogue: 0,0:46:08.39,0:46:09.60,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:46:09.68,0:46:13.43,Default,,0,0,0,,Ғибадатхананың ғимараты өртеніп кетсе де, ғибадат ету нысаны сол күйінде қалғаны рас.
Dialogue: 0,0:46:13.52,0:46:15.06,Default,,0,0,0,,Қаланы аралап шыққаннан кейін
Dialogue: 0,0:46:15.14,0:46:18.10,Default,,0,0,0,,Қазір Хоккайдо Тошогу храмы деп аталады...
Dialogue: 0,0:46:18.19,0:46:21.77,Default,,0,0,0,,Иә? Жағасында бір нәрсе дөңес.
Dialogue: 0,0:46:21.86,0:46:22.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:24.65,0:46:27.82,Default,,0,0,0,,Бұл телефонды тыңдау құрылғысы. Мен білмей тұрып...
Dialogue: 0,0:46:27.91,0:46:30.32,Default,,0,0,0,,Сол кезде аурухана бөлмесінде...
Dialogue: 0,0:46:32.66,0:46:36.21,Default,,0,0,0,,Такузо Аки! Әлгі бейбақ...
Dialogue: 0,0:46:36.29,0:46:38.96,Default,,0,0,0,,Мен инспектор Нишимураға есеп беремін!
Dialogue: 0,0:46:39.04,0:46:40.83,Default,,0,0,0,,Орындалды.
Dialogue: 0,0:46:40.92,0:46:44.71,Default,,0,0,0,,Олар бізге жұмбақтарды шешуге және қазынаны алдын ала ұрлауға тырысады.
Dialogue: 0,0:46:44.80,0:46:48.51,Default,,0,0,0,,Ах, егер Кадокралар Такузоны белгілеп жатса.
Dialogue: 0,0:46:48.59,0:46:50.14,Default,,0,0,0,,Олар да қазына...
Dialogue: 0,0:46:50.22,0:46:52.35,Default,,0,0,0,,Мені толығымен артқы жағына қойды.
Dialogue: 0,0:46:52.43,0:46:53.93,Default,,0,0,0,,... Окита жоғалып кетті!
Dialogue: 0,0:46:54.01,0:46:54.85,Default,,0,0,0,,Не!
Dialogue: 0,0:46:56.14,0:46:58.10,Default,,0,0,0,,Балалар...
Dialogue: 0,0:46:58.19,0:47:00.60,Default,,0,0,0,,Мен көрдім. Мен түсінемін. Хахаха...
Dialogue: 0,0:47:01.19,0:47:04.11,Default,,0,0,0,,Хоккайдо Тошогу храмына барайық!
Dialogue: 0,0:47:05.32,0:47:07.11,Default,,0,0,0,,Ол ақырында қозғалды ма?
Dialogue: 0,0:47:07.19,0:47:10.45,Default,,0,0,0,,Такузодан көзіңді алма.
Dialogue: 0,0:47:10.53,0:47:13.12,Default,,0,0,0,,Ғұн, қазына біздікі.
Dialogue: 0,0:47:18.25,0:47:19.87,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:47:22.42,0:47:24.29,Default,,0,0,0,,Сіз табынушысыз ба?
Dialogue: 0,0:47:24.38,0:47:26.26,Default,,0,0,0,,Кенеттен кешіріңіз
Dialogue: 0,0:47:26.34,0:47:29.63,Default,,0,0,0,,Мен Когоро Моури есімді детективпін.
Dialogue: 0,0:47:30.22,0:47:31.13,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:47:31.22,0:47:33.55,Default,,0,0,0,,Негізі маймылдың қалауы бойынша
Dialogue: 0,0:47:33.64,0:47:36.64,Default,,0,0,0,,Мен Кейзабуро Аки мырзаға қатысты бірдеңе іздеп жүрмін
Dialogue: 0,0:47:36.72,0:47:40.35,Default,,0,0,0,,Мұнда осындай нәрсе бар ма?
Dialogue: 0,0:47:40.44,0:47:41.90,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:47:44.23,0:47:47.15,Default,,0,0,0,,Жоқ, біздің ғибадатханада ондай нәрсе жоқ.
Dialogue: 0,0:47:48.15,0:47:52.82,Default,,0,0,0,,Солай ма? Жоқ, кешіріңіз.
Dialogue: 0,0:48:07.92,0:48:11.01,Default,,0,0,0,,Иә? Материалдар әртүрлі ме?
Dialogue: 0,0:48:14.47,0:48:15.55,Default,,0,0,0,,Бұл...
Dialogue: 0,0:48:24.10,0:48:25.56,Default,,0,0,0,,Керемет жауап!
Dialogue: 0,0:48:26.32,0:48:27.77,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:48:28.98,0:48:31.95,Default,,0,0,0,,Өкінішке орай, маған Кавазое қоңырау шалды, кеш болды...
Dialogue: 0,0:48:32.03,0:48:34.95,Default,,0,0,0,,(Когораның ұйқысы)
Dialogue: 0,0:48:35.03,0:48:39.24,Default,,0,0,0,,Бұл ұйықтап жатқан Когоро ма?
Dialogue: 0,0:48:50.09,0:48:53.09,Default,,0,0,0,,Ақырында қазынаға жолығу керек пе?
Dialogue: 0,0:48:58.18,0:48:59.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:59.22,0:49:00.97,Default,,0,0,0,,Міне, балам.
Dialogue: 0,0:49:01.06,0:49:03.23,Default,,0,0,0,,Күтілгендей, ол жылдам.
Dialogue: 0,0:49:03.31,0:49:06.61,Default,,0,0,0,,Мен саған ол қазынаны бере алмаймын.
Dialogue: 0,0:49:06.69,0:49:08.15,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:49:08.23,0:49:10.57,Default,,0,0,0,,Егер сіз оны ала алсаңыз, оған барыңыз!
Dialogue: 0,0:49:10.65,0:49:11.69,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:49:11.78,0:49:14.20,Default,,0,0,0,,Уф, қарғыс атқыр, мен көрмеймін... Ах!
Dialogue: 0,0:49:17.95,0:49:20.08,Default,,0,0,0,,Кішкене... Ах.
Dialogue: 0,0:49:20.99,0:49:22.58,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:49:22.66,0:49:25.08,Default,,0,0,0,,Енді маған берші... (көлік дөңгелегі дыбысы)
Dialogue: 0,0:49:25.17,0:49:26.58,Default,,0,0,0,,Не?
Dialogue: 0,0:49:26.67,0:49:27.71,Default,,0,0,0,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,0:49:29.29,0:49:30.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:34.68,0:49:36.22,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:49:38.39,0:49:39.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:42.52,0:49:44.73,Default,,0,0,0,,Бля саған, фантом ұры!
Dialogue: 0,0:49:44.81,0:49:45.73,Default,,0,0,0,,Ол жоғалды...
Dialogue: 0,0:49:45.81,0:49:47.73,Default,,0,0,0,,Оларға мейірімділік жоқ.
Dialogue: 0,0:49:48.61,0:49:49.65,Default,,0,0,0,,Хамф!
Dialogue: 0,0:49:51.78,0:49:52.61,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:49:53.24,0:49:54.61,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:49:54.70,0:49:56.03,Default,,0,0,0,,Мені қу, Начо!
Dialogue: 0,0:49:56.11,0:49:59.24,Default,,0,0,0,,Онда бар күшіңізді салыңыз, детективтер.
Dialogue: 0,0:50:05.33,0:50:07.62,Default,,0,0,0,,- (Хедзи) Сіз әлі менің артымнан келесіз бе? -Ой
Dialogue: 0,0:50:12.42,0:50:13.38,Default,,0,0,0,,Кя!
Dialogue: 0,0:50:15.47,0:50:18.64,Default,,0,0,0,,Бұл Хаттори ма? Сен не істеп жатырсың?
Dialogue: 0,0:50:19.22,0:50:20.43,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:50:21.60,0:50:22.43,Default,,0,0,0,,Хаттори!
Dialogue: 0,0:50:26.52,0:50:27.48,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:50:27.56,0:50:29.23,Default,,0,0,0,,Раxмет!
Dialogue: 0,0:50:29.31,0:50:30.36,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:50:31.94,0:50:33.07,Default,,0,0,0,,Ах
Dialogue: 0,0:50:34.90,0:50:36.99,Default,,0,0,0,,А, Хиджири-сан? Неге...
Dialogue: 0,0:50:37.74,0:50:40.99,Default,,0,0,0,,Мен сендерді өте жылдам қуып келе жатқандарыңды көрдім.
Dialogue: 0,0:50:41.07,0:50:42.62,Default,,0,0,0,,Қызықтырасыз ба?
Dialogue: 0,0:50:42.70,0:50:44.20,Default,,0,0,0,,Мүмкін Казуха-чан да шығар...
Dialogue: 0,0:50:44.29,0:50:45.62,Default,,0,0,0,,О! Ой!
Dialogue: 0,0:50:46.58,0:50:48.75,Default,,0,0,0,,Тіпті олай емес.
Dialogue: 0,0:50:49.75,0:50:52.00,Default,,0,0,0,,Қат! Ол неге?
Dialogue: 0,0:50:54.67,0:50:57.76,Default,,0,0,0,,Сәлем, балақай! Маған мына қорапты беріңіз!
Dialogue: 0,0:51:00.14,0:51:01.97,Default,,0,0,0,,- (Қасиетті) Мұны маған қалдыр да, қашып кет - Бірақ...
Dialogue: 0,0:51:02.80,0:51:04.72,Default,,0,0,0,,- (Такузоның нөкерлері) Ух... - (Қасиетті) Оның орнына...
Dialogue: 0,0:51:04.81,0:51:08.85,Default,,0,0,0,,Казуха-чанға мен саған көмектескенімді айт.
Dialogue: 0,0:51:08.94,0:51:11.27,Default,,0,0,0,,Күте тұрыңыз... Арх!
Dialogue: 0,0:51:13.23,0:51:14.40,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:51:15.19,0:51:17.03,Default,,0,0,0,,Біз байсалды боламыз ба?
Dialogue: 0,0:51:20.74,0:51:22.57,Default,,0,0,0,,Кя! не?
Dialogue: 0,0:51:25.41,0:51:27.25,Default,,0,0,0,,Хаха...
Dialogue: 0,0:51:31.29,0:51:32.33,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:51:32.92,0:51:33.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:51:35.42,0:51:38.67,Default,,0,0,0,,Барлығы жүгір! Қазір қашып кет!
Dialogue: 0,0:51:40.59,0:51:41.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:51:42.89,0:51:43.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:51:43.93,0:51:45.14,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:51:45.22,0:51:46.56,Default,,0,0,0,,Йотто!
Dialogue: 0,0:51:47.47,0:51:49.81,Default,,0,0,0,,Бір баланы пайдалану
Dialogue: 0,0:51:49.89,0:51:51.35,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:51:51.44,0:51:52.56,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:51:55.65,0:51:58.07,Default,,0,0,0,,Құрмет
Dialogue: 0,0:51:58.15,0:52:01.07,Default,,0,0,0,,«Көбінесе ұсталатын күндерде» қателік емес пе?
Dialogue: 0,0:52:04.83,0:52:06.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:07.87,0:52:09.04,Default,,0,0,0,,Уф!
Dialogue: 0,0:52:18.17,0:52:20.67,Default,,0,0,0,,Не... онда ештеңе жоқ.
Dialogue: 0,0:52:20.76,0:52:22.01,Default,,0,0,0,,Қазір 17:59… 47, 48, 49…
Dialogue: 0,0:52:22.55,0:52:24.09,Default,,0,0,0,,Неге әлі тұрсыңдар, әңгімелесіп?
Dialogue: 0,0:52:26.18,0:52:28.72,Default,,0,0,0,,Не болып жатыр? Қат!
Dialogue: 0,0:52:29.31,0:52:32.48,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:52:33.31,0:52:34.35,Default,,0,0,0,,Неліктен шықпайды?
Dialogue: 0,0:52:34.44,0:52:35.86,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:52:39.61,0:52:41.15,Default,,0,0,0,,Мен фильм түсіріп жатырмын!
Dialogue: 0,0:52:41.24,0:52:42.32,Default,,0,0,0,,Өте керемет!
Dialogue: 0,0:52:42.40,0:52:44.53,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:52:44.61,0:52:46.87,Default,,0,0,0,,Такузо Аки, бас тарт.
Dialogue: 0,0:52:46.95,0:52:48.70,Default,,0,0,0,,Мәміле жасағыңыз келе ме?
Dialogue: 0,0:52:48.79,0:52:51.08,Default,,0,0,0,,Менде Кадокура туралы мәлімет бар.
Dialogue: 0,0:52:51.16,0:52:53.25,Default,,0,0,0,,- (Накамори) Мені алып кетіңіз - (Офицер) Иә!
Dialogue: 0,0:52:53.33,0:52:54.62,Default,,0,0,0,,Кеттік
Dialogue: 0,0:52:55.29,0:52:56.33,Default,,0,0,0,,Амансың ба? Құрмет
Dialogue: 0,0:52:56.42,0:52:59.25,Default,,0,0,0,,О, аздап ысқылаңыз.
Dialogue: 0,0:52:59.34,0:53:02.47,Default,,0,0,0,,Қалай болғанда да, бос болу деген нені білдіреді?
Dialogue: 0,0:53:02.55,0:53:03.68,Default,,0,0,0,,Бұл үлкен әбігер.
Dialogue: 0,0:53:03.76,0:53:05.01,Default,,0,0,0,,Иә? Ах! О... сен!
Dialogue: 0,0:53:05.80,0:53:07.47,Default,,0,0,0,,Неліктен мұндай жерге тап болдыңыз?
Dialogue: 0,0:53:07.55,0:53:09.14,Default,,0,0,0,,- (Хедзи) Не! - (Әулие) Көрсет.
Dialogue: 0,0:53:09.22,0:53:11.89,Default,,0,0,0,,- (Хедзи) Эй... не істеп жатырсың! -(Әулие) Ауырды, солай ма?
Dialogue: 0,0:53:11.98,0:53:13.56,Default,,0,0,0,,Бұл ауырмайды!
Dialogue: 0,0:53:13.64,0:53:17.52,Default,,0,0,0,,Мен сендерді кендо турнирі өтетін жерде көрдім.
Dialogue: 0,0:53:17.61,0:53:21.90,Default,,0,0,0,,Егер мен бала күнгі досымның соңынан ерсем, мен Казуха-чанмен кездесуі мүмкін.
Dialogue: 0,0:53:21.99,0:53:24.20,Default,,0,0,0,,«Казуба-чан»!
Dialogue: 0,0:53:25.03,0:53:25.86,Default,,0,0,0,,Жарайды
Dialogue: 0,0:53:25.95,0:53:28.07,Default,,0,0,0,,- (Хедзи) Қажетсіз істермен айналыспа! - (Әулие) Сүйектің еш айыбы жоқ.
Dialogue: 0,0:53:28.16,0:53:30.95,Default,,0,0,0,,Бұл деңгейде ауырсыну тез арада жоғалады.
Dialogue: 0,0:53:31.70,0:53:33.46,Default,,0,0,0,,Сіз келесідесіз
Dialogue: 0,0:53:34.33,0:53:37.38,Default,,0,0,0,,Хиджири-сан, сен медициналық училищедесің, солай ма?
Dialogue: 0,0:53:37.46,0:53:40.46,Default,,0,0,0,,Иә, марқұм анам дәрігер болған.
Dialogue: 0,0:53:41.50,0:53:43.26,Default,,0,0,0,,Мүмкін әсер осы шығар
Dialogue: 0,0:53:44.30,0:53:47.01,Default,,0,0,0,,Жарайды, бұл жақсы.
Dialogue: 0,0:53:47.89,0:53:49.43,Default,,0,0,0,,Рахмет, ау
Dialogue: 0,0:53:49.51,0:53:51.81,Default,,0,0,0,,- (Нишимура) Хиджири Фукуджо - (Хиджири) Иә?
Dialogue: 0,0:53:53.10,0:53:56.73,Default,,0,0,0,,Сіздің қылышыңыздың қынынан адвокат Кугакидің саусақ іздері табылды.
Dialogue: 0,0:53:56.81,0:53:57.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:58.23,0:53:59.98,Default,,0,0,0,,Кісі өлтірді деген күдікпен қамауға алу
Dialogue: 0,0:54:00.07,0:54:00.90,Default,,0,0,0,,А...
Dialogue: 0,0:54:02.07,0:54:02.90,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,0:54:02.98,0:54:05.70,Default,,0,0,0,,Күте тұрыңыз, менде ештеңе жоқ...
Dialogue: 0,0:54:05.78,0:54:07.78,Default,,0,0,0,,Мен сенімен полиция бөлімшесінде сөйлесемін.
Dialogue: 0,0:54:10.28,0:54:12.54,Default,,0,0,0,,-(Қасиетті қыз) Кешіріңіз -(Кавазоэ) Иә?
Dialogue: 0,0:54:12.62,0:54:15.41,Default,,0,0,0,,- (Мико) Сіз полиция қызметкерісіз бе? -(Кавазоэ) Иә.
Dialogue: 0,0:54:15.50,0:54:19.46,Default,,0,0,0,,Мен Хоккайдодағы Тошогу храмындағы ғибадатхананың қызымын.
Dialogue: 0,0:54:19.54,0:54:21.54,Default,,0,0,0,,Менің атым Мико Йошинага.
Dialogue: 0,0:54:22.13,0:54:24.38,Default,,0,0,0,,Кавазое! Сен не істеп жатырсың? Барайық!
Dialogue: 0,0:54:24.46,0:54:25.84,Default,,0,0,0,,А, жақсы
Dialogue: 0,0:54:26.84,0:54:29.89,Default,,0,0,0,,Мен сізбен бір нәрсе туралы сөйлесуім керек.
Dialogue: 0,0:54:29.97,0:54:32.56,Default,,0,0,0,,Полиция шақырсаңыз, олар міне.
Dialogue: 0,0:54:32.64,0:54:34.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:34.93,0:54:36.85,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:54:36.94,0:54:39.56,Default,,0,0,0,,Екеуімен сөйлесіңізші.
Dialogue: 0,0:54:39.65,0:54:40.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:41.40,0:54:42.61,Default,,0,0,0,,Hey dad
Dialogue: 0,0:54:42.69,0:54:44.19,Default,,0,0,0,,Мен гамбургер жегім келеді!
Dialogue: 0,0:54:44.28,0:54:46.19,Default,,0,0,0,,Қораптың ішіндегі заттар ұрланды ма?
Dialogue: 0,0:54:46.99,0:54:48.95,Default,,0,0,0,,Бұл жеңіл болуы керек.
Dialogue: 0,0:54:49.03,0:54:53.20,Default,,0,0,0,,Бұл бірнеше жыл бұрын болды, бірақ қылмыскер әлі ұсталған жоқ...
Dialogue: 0,0:54:53.74,0:54:58.00,Default,,0,0,0,,Ол қылыштың тарихы туралы біз көп білмейміз.
Dialogue: 0,0:54:58.08,0:55:01.71,Default,,0,0,0,,Тек аты «Хоширио қылыш»
Dialogue: 0,0:55:01.79,0:55:04.46,Default,,0,0,0,,Қандай қылыш қолданғаныңыз есіңізде ме?
Dialogue: 0,0:55:04.55,0:55:07.30,Default,,0,0,0,,Цуба мен мекуги тесігі ерекше болды.
Dialogue: 0,0:55:07.38,0:55:08.55,Default,,0,0,0,,Ерекшеліктер?
Dialogue: 0,0:55:08.63,0:55:12.55,Default,,0,0,0,,Иә, цубада жұлдызша тәрізді ою-өрнек бар.
Dialogue: 0,0:55:12.64,0:55:14.10,Default,,0,0,0,,Жұлдыз пішіні?
Dialogue: 0,0:55:15.89,0:55:17.31,Default,,0,0,0,,Бұл осылай болды
Dialogue: 0,0:55:17.39,0:55:18.73,Default,,0,0,0,,Жұлдыздар мен...
Dialogue: 0,0:55:18.81,0:55:22.73,Default,,0,0,0,,Көз...Цуба Горёкаку дегенді білдіруі мүмкін.
Dialogue: 0,0:55:22.81,0:55:24.69,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:55:24.77,0:55:26.82,Default,,0,0,0,,Сіз бұл көзді Мекугиана деп ойлайсыз ба?
Dialogue: 0,0:55:26.90,0:55:29.28,Default,,0,0,0,,Иә, тесік – тамаша шеңбер.
Dialogue: 0,0:55:29.36,0:55:32.82,Default,,0,0,0,,Оны қоршап тұрған бадам тәрізді өрнек бар.
Dialogue: 0,0:55:32.91,0:55:35.62,Default,,0,0,0,,Ол адамның көзіне ұқсайды.
Dialogue: 0,0:55:35.70,0:55:37.08,Default,,0,0,0,,О, және
Dialogue: 0,0:55:37.16,0:55:40.33,Default,,0,0,0,,Қылыштан басқа ұрпақтар бойына келесі заттар сақталған.
Dialogue: 0,0:55:42.42,0:55:43.84,Default,,0,0,0,,Бұл ескі сурет.
Dialogue: 0,0:55:44.46,0:55:48.34,Default,,0,0,0,,Шамасы, ол біздің ғибадатханада Хоширио семсерімен бірге сақталған...
Dialogue: 0,0:55:48.42,0:55:49.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:49.42,0:55:51.09,Default,,0,0,0,,- Эй Хаттори - (Хедзи) Иә?
Dialogue: 0,0:55:51.18,0:55:53.93,Default,,0,0,0,,Рёи-сан маған сеніп тапсырған картинаны әкелдің бе?
Dialogue: 0,0:55:54.01,0:55:55.89,Default,,0,0,0,,Бұл менің сөмкемде.
Dialogue: 0,0:55:55.97,0:55:57.77,Default,,0,0,0,,Оны осы суреттің үстіне қойып көріңіз.
Dialogue: 0,0:55:57.85,0:55:59.64,Default,,0,0,0,,А, солай ма?
Dialogue: 0,0:56:06.65,0:56:07.78,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:56:10.11,0:56:11.99,Default,,0,0,0,,Хмм.
Dialogue: 0,0:56:12.07,0:56:14.45,Default,,0,0,0,,Горёкакудың орналасқан жері тамаша!
Dialogue: 0,0:56:14.53,0:56:16.66,Default,,0,0,0,,Бұл кездейсоқ емес.
Dialogue: 0,0:56:16.74,0:56:19.16,Default,,0,0,0,,Бұл жерде бірдеңе өртеніп жатқан сияқты.
Dialogue: 0,0:56:19.25,0:56:23.17,Default,,0,0,0,,А-а, енді ойлап қарасам, осындай әңгіме естідім.
Dialogue: 0,0:56:23.25,0:56:25.75,Default,,0,0,0,,Соғыс кезінде болған көрінеді.
Dialogue: 0,0:56:25.84,0:56:28.92,Default,,0,0,0,,Бір түнде, бір-ақ рет Горёкаку өртеніп кетті.
Dialogue: 0,0:56:29.01,0:56:30.30,Default,,0,0,0,,Горёкаку?
Dialogue: 0,0:56:30.38,0:56:33.38,Default,,0,0,0,,Иә, ор өртеніп жатыр.
Dialogue: 0,0:56:33.93,0:56:36.81,Default,,0,0,0,,Қараңғы түнде жұлдыз пішіні шығады...
Dialogue: 0,0:56:37.39,0:56:39.06,Default,,0,0,0,,Дәл осылай
Dialogue: 0,0:56:39.97,0:56:41.85,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:56:42.35,0:56:44.44,Default,,0,0,0,,Ақпаратты реттегенде...
Dialogue: 0,0:56:45.06,0:56:47.48,Default,,0,0,0,,Вакизашиде ироха кейіпкерлерінің кестесі бар.
Dialogue: 0,0:56:47.57,0:56:50.90,Default,,0,0,0,,Фукудзо отбасындағы қылыш және Тошогу храмындағы қылыш
Dialogue: 0,0:56:50.99,0:56:53.03,Default,,0,0,0,,Хакодатенің әрбір суреті
Dialogue: 0,0:56:53.86,0:56:55.82,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:56:55.91,0:56:57.70,Default,,0,0,0,,Ах! Ха
Dialogue: 0,0:56:57.78,0:56:59.20,Default,,0,0,0,,Иори
Dialogue: 0,0:56:59.29,0:57:00.45,Default,,0,0,0,,Жақсы аттыңыз ба?
Dialogue: 0,0:57:01.12,0:57:02.96,Default,,0,0,0,,Бұл ең жақсы кадр
Dialogue: 0,0:57:03.04,0:57:04.58,Default,,0,0,0,,Окини!
Dialogue: 0,0:57:04.67,0:57:07.92,Default,,0,0,0,,Бірақ шынымен де Хиджиката Ханте сондай әдемі.
Dialogue: 0,0:57:08.00,0:57:10.71,Default,,0,0,0,,Жақсы, Хэйдзи-кун жақсырақ...
Dialogue: 0,0:57:10.80,0:57:12.63,Default,,0,0,0,,Хэйдзи-кун еш жерде жоқ!
Dialogue: 0,0:57:12.72,0:57:14.22,Default,,0,0,0,,I'm sorry.
Dialogue: 0,0:57:14.30,0:57:15.72,Default,,0,0,0,,Мен не істедім
Dialogue: 0,0:57:15.80,0:57:18.81,Default,,0,0,0,,Мен бір мойындау пунктін ұмытып қалдым.
Dialogue: 0,0:57:18.89,0:57:20.52,Default,,0,0,0,,Қайда? Айтып көріңіз
Dialogue: 0,0:57:20.60,0:57:22.85,Default,,0,0,0,,Сол жерден Хакодате тауы көрінеді.
Dialogue: 0,0:57:23.52,0:57:26.52,Default,,0,0,0,,Арқан жолының басынан түнгі көрініс
Dialogue: 0,0:57:26.60,0:57:28.11,Default,,0,0,0,,1 миллион доллар деп айтылады...
Dialogue: 0,0:57:28.69,0:57:30.28,Default,,0,0,0,,1 миллион доллар…
Dialogue: 0,0:57:30.36,0:57:32.11,Default,,0,0,0,,Таңқаларлық арзан, бірақ...
Dialogue: 0,0:57:33.78,0:57:34.61,Default,,0,0,0,,Онда!
Dialogue: 0,0:57:35.20,0:57:37.41,Default,,0,0,0,,Хеджи-кун міндетті түрде сонда болады.
Dialogue: 0,0:57:37.49,0:57:38.99,Default,,0,0,0,,Мен жақында барамын.
Dialogue: 0,0:57:39.08,0:57:40.99,Default,,0,0,0,,- (Иори) Болды, жас ханым - (Момия) А?
Dialogue: 0,0:57:41.58,0:57:42.75,Default,,0,0,0,,Болжам бойынша
Dialogue: 0,0:57:42.83,0:57:44.75,Default,,0,0,0,,Бүгін түннен бастап қатты жаңбыр жауатын сияқты.
Dialogue: 0,0:57:44.83,0:57:46.54,Default,,0,0,0,,Қатты жаңбыр?
Dialogue: 0,0:57:46.62,0:57:49.79,Default,,0,0,0,,Хона, бүгін кешке мойындау болмайды деп ойлаймын.
Dialogue: 0,0:57:49.88,0:57:52.51,Default,,0,0,0,,Оның орнына ертең түн ашық болатын сияқты.
Dialogue: 0,0:57:54.47,0:57:55.84,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:57:56.59,0:57:59.01,Default,,0,0,0,,Шынымен ертең түнде болатын сияқты.
Dialogue: 0,0:58:00.35,0:58:02.27,Default,,0,0,0,,X-күн
Dialogue: 0,0:58:03.27,0:58:05.69,Default,,0,0,0,,Сондықтан мен кісі өлтірушімін...
Dialogue: 0,0:58:05.77,0:58:08.65,Default,,0,0,0,,Олай болса, жәбірленушінің саусақ іздері неліктен қабықта?
Dialogue: 0,0:58:09.23,0:58:10.73,Default,,0,0,0,,Гррр…
Dialogue: 0,0:58:10.82,0:58:12.32,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:58:12.40,0:58:14.65,Default,,0,0,0,,Мен қазір қылышты тексеріп жатырмын.
Dialogue: 0,0:58:14.74,0:58:17.28,Default,,0,0,0,,Қан мен майды түсіріп алсаңыз да оңай көре аласыз.
Dialogue: 0,0:58:17.36,0:58:19.03,Default,,0,0,0,,Мен мұны істеген жоқпын!
Dialogue: 0,0:58:19.62,0:58:21.83,Default,,0,0,0,,Бұл қандай да бір қателік.
Dialogue: 0,0:58:24.25,0:58:26.04,Default,,0,0,0,,Айтсаңыз да.
Dialogue: 0,0:58:26.12,0:58:29.29,Default,,0,0,0,,Мен саған сен туралы ештеңе айта алмаймын...
Dialogue: 0,0:58:29.38,0:58:30.71,Default,,0,0,0,,Бұл туралы бірдеңе жасаңыз!
Dialogue: 0,0:58:30.79,0:58:32.67,Default,,0,0,0,,Жақсы шешім, менеджер.
Dialogue: 0,0:58:33.59,0:58:36.17,Default,,0,0,0,,Бірақ сіз менің сұрағыма жауап беруіңіз керек.
Dialogue: 0,0:58:36.26,0:58:37.80,Default,,0,0,0,,-Мм... -(Басқарушы) Иә.
Dialogue: 0,0:58:37.88,0:58:41.43,Default,,0,0,0,,Мен Кугакидің осында қалуды жоспарлағанын естідім.
Dialogue: 0,0:58:42.06,0:58:44.43,Default,,0,0,0,,Пакет сізге жеткізілмеді ме?
Dialogue: 0,0:58:45.18,0:58:47.35,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:58:47.44,0:58:50.52,Default,,0,0,0,,Иә, менде сізде бір жүк бар.
Dialogue: 0,0:58:50.61,0:58:53.32,Default,,0,0,0,,Жіберуші Кугаки мырзаның өзі.
Dialogue: 0,0:58:53.40,0:58:56.32,Default,,0,0,0,,Иә, соны маған көрсетсеңші.
Dialogue: 0,0:58:56.90,0:58:59.03,Default,,0,0,0,,Екі ақ-қара фотосурет
Dialogue: 0,0:58:59.11,0:59:00.82,Default,,0,0,0,,Хоширио қылыш...
Dialogue: 0,0:59:00.91,0:59:02.20,Default,,0,0,0,,Маған Риппл тиді, Жура!
Dialogue: 0,0:59:02.28,0:59:03.20,Default,,0,0,0,,Сахна артына қараңыз
Dialogue: 0,0:59:04.49,0:59:06.08,Default,,0,0,0,,Кейзабуро Акое…
Dialogue: 0,0:59:06.16,0:59:09.96,Default,,0,0,0,,Басқа сурет Горёкаку қаласының орталығында түсірілген сияқты.
Dialogue: 0,0:59:10.04,0:59:12.46,Default,,0,0,0,,Шар? Не үшін?
Dialogue: 0,0:59:12.54,0:59:14.84,Default,,0,0,0,,Сіз қандай да бір бақылау жасап жатқан сияқтысыз.
Dialogue: 0,0:59:14.92,0:59:16.42,Default,,0,0,0,,Неге екенін білмеймін
Dialogue: 0,0:59:16.51,0:59:18.97,Default,,0,0,0,,Егер сіз ондағы жарықтың шағылысына қарасаңыз, мүмкін—
Dialogue: 0,0:59:19.59,0:59:21.68,Default,,0,0,0,,Шардың едені шыныдан жасалған.
Dialogue: 0,0:59:21.76,0:59:23.26,Default,,0,0,0,,Егер сіз жай ғана бақылау жасасаңыз
Dialogue: 0,0:59:23.35,0:59:26.72,Default,,0,0,0,,Қымбат қылышымды өзіммен бірге алып қиналмас едім.
Dialogue: 0,0:59:26.81,0:59:29.73,Default,,0,0,0,,Біз қазынаны табудың барлық кеңестерін тапқан сияқтымыз.
Dialogue: 0,0:59:29.81,0:59:32.81,Default,,0,0,0,,Қалғаны сіздің ойыңыз... (Кенет тоқтаған дыбыс)
Dialogue: 0,0:59:32.90,0:59:33.73,Default,,0,0,0,,Ии!
Dialogue: 0,0:59:33.82,0:59:35.44,Default,,0,0,0,,Мен таптым, Кайто Бала!
Dialogue: 0,0:59:35.53,0:59:36.86,Default,,0,0,0,,- (Накамори) Қауіпсіз! -(Отряд мүшелері) Иә!
Dialogue: 0,0:59:37.94,0:59:40.95,Default,,0,0,0,,Инспектор Нишимура тергеуде болуы керек!
Dialogue: 0,0:59:41.03,0:59:43.37,Default,,0,0,0,,...Мен сондай асықтым.
Dialogue: 0,0:59:43.45,0:59:47.29,Default,,0,0,0,,Бірақ менде қазынаны табуға әлі де бөлшектер жетпейді.
Dialogue: 0,0:59:47.37,0:59:48.58,Default,,0,0,0,,Хмм.
Dialogue: 0,0:59:48.66,0:59:52.04,Default,,0,0,0,,Мүмкін Райо-санның орнында бірдеңе бар шығар.
Dialogue: 0,0:59:53.13,0:59:55.30,Default,,0,0,0,,Әке, телефон қандай болды?
Dialogue: 0,0:59:55.38,0:59:57.96,Default,,0,0,0,,Тағы бір тергеу жиналысы болады.
Dialogue: 0,0:59:58.05,0:59:59.26,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:59:59.34,1:00:01.30,Default,,0,0,0,,Мен шаршадым
Dialogue: 0,1:00:01.38,1:00:04.18,Default,,0,0,0,,Мен жаңа ғана полиция бөлімінде ұйықтап қалдым.
Dialogue: 0,1:00:04.26,1:00:05.72,Default,,0,0,0,,
Dialogue: 0,1:00:06.31,1:00:10.81,Default,,0,0,0,,Хиджири Фукуджо Кугакиді өлтірді деген күдікті ретінде қамауға алынды.
Dialogue: 0,1:00:10.89,1:00:13.56,Default,,0,0,0,,- (Қазуба) Не, Хиджири-сан? - (Жүгіріп) Неге?
Dialogue: 0,1:00:13.65,1:00:16.82,Default,,0,0,0,,Иә, мен сізбен төмен түскенде сөйлесемін.
Dialogue: 0,1:00:16.90,1:00:19.61,Default,,0,0,0,,Саған рахмет, мен де бүгін түні бойы ұйықтадым.
Dialogue: 0,1:00:19.69,1:00:22.07,Default,,0,0,0,,Балаға қамқор болыңыз.
Dialogue: 0,1:00:23.82,1:00:26.58,Default,,0,0,0,,Мен оны мүлдем түсінбеймін.
Dialogue: 0,1:00:26.66,1:00:28.75,Default,,0,0,0,,Ағай, бұл жер керемет!
Dialogue: 0,1:00:28.83,1:00:31.00,Default,,0,0,0,,Эй, төмен қарашы.
Dialogue: 0,1:00:31.08,1:00:33.37,Default,,0,0,0,,А... ә? Сәлем...
Dialogue: 0,1:00:33.46,1:00:36.92,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,1:00:38.46,1:00:40.09,Default,,0,0,0,,О... тат!
Dialogue: 0,1:00:40.17,1:00:43.72,Default,,0,0,0,,Бұл... Жақсысың ба? Әке, мықты болыңыз!
Dialogue: 0,1:00:49.22,1:00:50.73,Default,,0,0,0,,Хмм, дәмді
Dialogue: 0,1:00:50.81,1:00:54.02,Default,,0,0,0,,- (Нидерланды) Полиция дереу келеді - (Когоро) О, өтінемін.
Dialogue: 0,1:00:55.02,1:00:57.61,Default,,0,0,0,,- (Күзгі жапырақтар) Не болды? -(Иори) Жоқ, ештеңе.
Dialogue: 0,1:00:59.40,1:01:01.24,Default,,0,0,0,,Не болды? Казуха-чан
Dialogue: 0,1:01:01.32,1:01:05.16,Default,,0,0,0,,Мен Хиджири-санға аздап алаңдаймын...
Dialogue: 0,1:01:05.24,1:01:06.99,Default,,0,0,0,,Оқиғаға қатысты?
Dialogue: 0,1:01:08.24,1:01:09.83,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:01:09.91,1:01:12.00,Default,,0,0,0,,Бұл не екені түсініксіз.
Dialogue: 0,1:01:12.08,1:01:13.50,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,1:01:13.58,1:01:16.96,Default,,0,0,0,,Ах, Хаттори-кун естіледі емес пе?
Dialogue: 0,1:01:18.42,1:01:19.59,Default,,0,0,0,,Шоко
Dialogue: 0,1:01:19.67,1:01:22.63,Default,,0,0,0,,Хэйджидің велосипеді солай естіледі...
Dialogue: 0,1:01:22.72,1:01:24.84,Default,,0,0,0,,Дыбыс басқа...
Dialogue: 0,1:01:26.39,1:01:28.64,Default,,0,0,0,,А... Дұрыс, дыбыс!
Dialogue: 0,1:01:28.72,1:01:30.89,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,1:01:33.48,1:01:36.56,Default,,0,0,0,,Кадокураның қолы айналып кеткен сияқты.
Dialogue: 0,1:01:36.65,1:01:38.02,Default,,0,0,0,,Райо-санды іздейік
Dialogue: 0,1:01:39.77,1:01:41.53,Default,,0,0,0,,Бұл жерді де бүлдірген... Ах.
Dialogue: 0,1:01:41.61,1:01:42.78,Default,,0,0,0,,Қан!
Dialogue: 0,1:01:42.86,1:01:45.32,Default,,0,0,0,,Оны күштеп алып кеткен сияқты.
Dialogue: 0,1:01:45.41,1:01:47.62,Default,,0,0,0,,Мен Рёи-саннан қазына туралы не білемін
Dialogue: 0,1:01:47.70,1:01:49.33,Default,,0,0,0,,Менен сұрауды жоспарлап отырсыз ба?
Dialogue: 0,1:01:49.41,1:01:51.79,Default,,0,0,0,,Сіз бірінші қадамды қайтадан алдыңыз.
Dialogue: 0,1:01:51.87,1:01:54.37,Default,,0,0,0,,Эй, бірдеңе дұрыс емес сияқты ма?
Dialogue: 0,1:01:54.46,1:01:55.54,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:58.38,1:01:59.54,Default,,0,0,0,,Китамакура
Dialogue: 0,1:01:59.63,1:02:02.80,Default,,0,0,0,,Марқұмды солтүстікке қаратып жатқызу әдеттегі әдет пе?
Dialogue: 0,1:02:02.88,1:02:05.43,Default,,0,0,0,,Рёи өз бақытын ойлайтын адам болатын.
Dialogue: 0,1:02:06.38,1:02:07.55,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,1:02:07.64,1:02:08.93,Default,,0,0,0,,Иә? бұл!
Dialogue: 0,1:02:09.01,1:02:10.93,Default,,0,0,0,,Бұл Рёиден келген хабарлама ма?
Dialogue: 0,1:02:11.01,1:02:14.81,Default,,0,0,0,,Мен шабуылды сездім де, дереу қанмен жазып алдым.
Dialogue: 0,1:02:14.89,1:02:17.40,Default,,0,0,0,,Китамакурада өзіңізді жайсыз сезініңіз.
Dialogue: 0,1:02:17.48,1:02:19.94,Default,,0,0,0,,Қан дақтары осындай нәрсе болса, жақсы болар еді.
Dialogue: 0,1:02:20.65,1:02:22.36,Default,,0,0,0,,Қызыл жұлдыз туралы айту
Dialogue: 0,1:02:22.44,1:02:25.15,Default,,0,0,0,,Горёкакуның жанып тұрған суреті көз алдыма келеді...
Dialogue: 0,1:02:25.24,1:02:26.78,Default,,0,0,0,,Бірақ бұл сурет нені білдіреді?
Dialogue: 0,1:02:26.78,1:02:27.57,Default,,0,0,0,,Бірақ бұл сурет нені білдіреді?
Dialogue: 0,1:02:26.78,1:02:27.57,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,1:02:27.57,1:02:27.66,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,1:02:27.66,1:02:28.82,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,1:02:27.66,1:02:28.82,Default,,0,0,0,,Түсінбейсіз бе?
Dialogue: 0,1:02:29.70,1:02:30.83,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,1:02:31.41,1:02:34.58,Default,,0,0,0,,Кісі өлтірген күдіктімен кездесу – шектен шығу!
Dialogue: 0,1:02:34.66,1:02:37.21,Default,,0,0,0,,Оның әкесі ұрланған!
Dialogue: 0,1:02:37.29,1:02:40.08,Default,,0,0,0,,Біз де мәселені зерттеп жатырмыз.
Dialogue: 0,1:02:40.17,1:02:42.00,Default,,0,0,0,,Жоқ, жоқ, мен сені бұдан былай кіргізбеймін!
Dialogue: 0,1:02:42.09,1:02:44.01,Default,,0,0,0,,Маған бір сәтке рұқсат бере аласыз ба?
Dialogue: 0,1:02:44.09,1:02:47.30,Default,,0,0,0,,Детектив Хаттори Хэйджи осында болуы керек.
Dialogue: 0,1:02:47.38,1:02:50.01,Default,,0,0,0,,- (Хедзи) О, Казуха, мінекей! -(Казуба) Әй, Хэйдзи!
Dialogue: 0,1:02:50.60,1:02:52.47,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,1:02:52.56,1:02:55.06,Default,,0,0,0,,Хиджири-сан туралы бірдеңе байқадым.
Dialogue: 0,1:02:55.14,1:02:56.39,Default,,0,0,0,,Не байқадың?
Dialogue: 0,1:02:56.48,1:02:59.06,Default,,0,0,0,,Мен кеше турнир басталар алдында
Dialogue: 0,1:02:59.15,1:03:02.32,Default,,0,0,0,,Хиджири жалғыз өзі иайде жаттығады, мен оны жол бойы бақылап отырдым.
Dialogue: 0,1:03:02.40,1:03:05.11,Default,,0,0,0,,Заңгер Кугаки
Dialogue: 0,1:03:05.19,1:03:07.53,Default,,0,0,0,,Егер мен оны сол кезде істесем, мені әлдеқашан өлтіріп кеткен болар еді.
Dialogue: 0,1:03:07.61,1:03:10.07,Default,,0,0,0,,Оны алиби айғағы ретінде пайдалануға болмайды.
Dialogue: 0,1:03:10.16,1:03:11.41,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:03:11.49,1:03:13.41,Default,,0,0,0,,Сол кезде қылышты қынап ал.
Dialogue: 0,1:03:13.49,1:03:16.33,Default,,0,0,0,,Мен сырт еткен дыбысты естідім...
Dialogue: 0,1:03:16.41,1:03:17.96,Default,,0,0,0,,Сол дыбыспен
Dialogue: 0,1:03:18.04,1:03:19.96,Default,,0,0,0,,Кейінірек мен демонстрацияда естіген дыбыс
Dialogue: 0,1:03:20.04,1:03:21.04,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:03:21.13,1:03:22.17,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:22.25,1:03:24.80,Default,,0,0,0,,Мүмкін қынап қате болған шығар?
Dialogue: 0,1:03:24.88,1:03:26.17,Default,,0,0,0,,Бұл дұрыс болуы мүмкін.
Dialogue: 0,1:03:26.26,1:03:29.80,Default,,0,0,0,,Біреу Хижиридің қынасын жалғанға ауыстырды.
Dialogue: 0,1:03:29.88,1:03:33.80,Default,,0,0,0,,Ол Хиджири мырзаның қынына адвокат Кугакидің саусақ іздерін салып, оны өлтірді.
Dialogue: 0,1:03:33.89,1:03:35.77,Default,,0,0,0,,Мен оны кейінірек қайта қойдым.
Dialogue: 0,1:03:35.85,1:03:36.81,Default,,0,0,0,,...т.б.
Dialogue: 0,1:03:36.89,1:03:38.06,Default,,0,0,0,,Міне!
Dialogue: 0,1:03:38.14,1:03:41.60,Default,,0,0,0,,Казуханың үлкендігі сонша, мен байқадым!
Dialogue: 0,1:03:41.69,1:03:42.81,Default,,0,0,0,,Хехе
Dialogue: 0,1:03:42.90,1:03:44.82,Default,,0,0,0,,Мұны Киелі Рухпен растаңыз.
Dialogue: 0,1:03:45.40,1:03:48.82,Default,,0,0,0,,Тағы бір айта кететін жайт, осыны да тыңдай аласыз ба?
Dialogue: 0,1:03:48.90,1:03:52.37,Default,,0,0,0,,Бұл не? Жақсы, маған фото жіберіңіз.
Dialogue: 0,1:03:52.45,1:03:53.82,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:03:54.41,1:03:56.87,Default,,0,0,0,,- (Жүгіріп) Әке, берік болыңыз - Когораның ағасы
Dialogue: 0,1:03:56.95,1:03:58.83,Default,,0,0,0,,-Не болды? - (Жүгіріп) Конан-кун!
Dialogue: 0,1:03:59.41,1:04:02.42,Default,,0,0,0,,Мен жай ғана бақылау алаңындағы шыны еденге аяқ бастым.
Dialogue: 0,1:04:02.50,1:04:04.59,Default,,0,0,0,,Мен таң қалғаным сонша, белімді ауыртып алдым.
Dialogue: 0,1:04:04.67,1:04:05.92,Default,,0,0,0,,Хаха…
Dialogue: 0,1:04:06.00,1:04:08.17,Default,,0,0,0,,Өзіңізді қатты итермеңіз.
Dialogue: 0,1:04:08.26,1:04:09.09,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:09.17,1:04:11.84,Default,,0,0,0,,Инспектор Накамори! Не болды?
Dialogue: 0,1:04:11.93,1:04:15.47,Default,,0,0,0,,Бұрын Такузо Кадокураның жасырынған жерін айтқан.
Dialogue: 0,1:04:15.56,1:04:18.10,Default,,0,0,0,,Сондықтан біз, Елордалық полиция департаменті, бұдан былай сонда боламыз...
Dialogue: 0,1:04:18.18,1:04:21.64,Default,,0,0,0,,Түсіндім, мен саған қалдырамын.
Dialogue: 0,1:04:22.52,1:04:25.15,Default,,0,0,0,,Қылыш қабы ауыстырылды ма?
Dialogue: 0,1:04:25.69,1:04:26.82,Default,,0,0,0,,Менен сұрасаңыз
Dialogue: 0,1:04:26.90,1:04:29.36,Default,,0,0,0,,Таңертеңгілік жаттығу кезінде мен біртүрлі нәрсені сезіндім.
Dialogue: 0,1:04:29.44,1:04:30.99,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:04:31.07,1:04:34.20,Default,,0,0,0,,Қыныңды қайта бағалау және қылышпен бағалаудың қорытындысы шыққан бойда.
Dialogue: 0,1:04:34.28,1:04:36.24,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,1:04:37.20,1:04:38.54,Default,,0,0,0,,Және…
Dialogue: 0,1:04:38.62,1:04:41.00,Default,,0,0,0,,Бұл жігіт сізге бірдеңені еске түсіре ме?
Dialogue: 0,1:04:41.58,1:04:45.08,Default,,0,0,0,,Әкеңнің бөлмесінде болса керек.
Dialogue: 0,1:04:46.84,1:04:48.75,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,1:04:55.85,1:04:57.01,Default,,0,0,0,,Жаңбыр...
Dialogue: 0,1:05:07.44,1:05:08.52,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:12.86,1:05:13.78,Default,,0,0,0,,Ха!
Dialogue: 0,1:05:17.49,1:05:19.16,Default,,0,0,0,,Әлгі бейбақ!
Dialogue: 0,1:05:19.24,1:05:20.62,Default,,0,0,0,,Жаңбыр өте жаман.
Dialogue: 0,1:05:20.70,1:05:21.95,Default,,0,0,0,,Не, адамдар ұшып жатыр!
Dialogue: 0,1:05:25.00,1:05:26.79,Default,,0,0,0,,Қаш!
Dialogue: 0,1:05:26.88,1:05:28.17,Default,,0,0,0,,Әй!
Dialogue: 0,1:05:30.17,1:05:31.46,Default,,0,0,0,,Уау!
Dialogue: 0,1:05:33.13,1:05:33.97,Default,,0,0,0,,Ах!
Dialogue: 0,1:05:35.43,1:05:36.80,Default,,0,0,0,,Бұл не? Сен сонда екенсің ғой.
Dialogue: 0,1:05:37.43,1:05:39.68,Default,,0,0,0,,Сіз оны жойдыңыз ба?
Dialogue: 0,1:05:43.52,1:05:44.56,Default,,0,0,0,,Аһ!
Dialogue: 0,1:05:44.64,1:05:45.56,Default,,0,0,0,,Ах!
Dialogue: 0,1:05:46.19,1:05:48.56,Default,,0,0,0,,Ух... ух ха ха ха
Dialogue: 0,1:05:50.90,1:05:52.07,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:55.53,1:05:56.36,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:05:56.45,1:05:58.03,Default,,0,0,0,,Аһ!
Dialogue: 0,1:06:00.45,1:06:03.20,Default,,0,0,0,,Ей, менің жолымнан кет.
Dialogue: 0,1:06:03.87,1:06:06.33,Default,,0,0,0,,Кадокура!
Dialogue: 0,1:06:10.67,1:06:11.50,Default,,0,0,0,,Не!
Dialogue: 0,1:06:12.09,1:06:14.01,Default,,0,0,0,,Немесе… Кайто Бала!
Dialogue: 0,1:06:14.09,1:06:16.26,Default,,0,0,0,,Сен неге... Цк!
Dialogue: 0,1:06:27.44,1:06:28.65,Default,,0,0,0,,Инспектор Накамори...
Dialogue: 0,1:06:50.58,1:06:53.92,Default,,0,0,0,,Такузо өлді, хмф.
Dialogue: 0,1:06:54.67,1:06:55.92,Default,,0,0,0,,Ібіліс
Dialogue: 0,1:06:58.59,1:07:00.14,Default,,0,0,0,,- (Дәрігер) Есіңізде ме? -(Медбике) Жауап жоқ!
Dialogue: 0,1:07:00.22,1:07:01.05,Default,,0,0,0,,Жүгір!
Dialogue: 0,1:07:01.68,1:07:04.06,Default,,0,0,0,,Иығынан, арқасынан соққы алған көрінеді.
Dialogue: 0,1:07:04.93,1:07:06.31,Default,,0,0,0,,Бұл ақылсыз...
Dialogue: 0,1:07:21.16,1:07:22.62,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:07:22.70,1:07:24.66,Default,,0,0,0,,Кел, кел, кел!
Dialogue: 0,1:07:24.74,1:07:27.00,Default,,0,0,0,,Солтүстік жер!
Dialogue: 0,1:07:27.08,1:07:29.37,Default,,0,0,0,,Бұл мен күткеннен жылдамырақ болды.
Dialogue: 0,1:07:29.46,1:07:31.71,Default,,0,0,0,,Шинкансен өте керемет болды!
Dialogue: 0,1:07:31.79,1:07:34.63,Default,,0,0,0,,Екібенді де көп жедім.
Dialogue: 0,1:07:34.71,1:07:36.63,Default,,0,0,0,,Біреу керек
Dialogue: 0,1:07:36.71,1:07:39.72,Default,,0,0,0,,Ол Хоккайдо Шинкансенге мінгісі келетінін айтты.
Dialogue: 0,1:07:39.80,1:07:41.68,Default,,0,0,0,,Ал, олай айтпа.
Dialogue: 0,1:07:41.76,1:07:44.35,Default,,0,0,0,,Әңгіменің бәрі ұшақтар туралы болса, қызық емес пе?
Dialogue: 0,1:07:44.43,1:07:46.35,Default,,0,0,0,,Саяхаттаудың ең жақсы жері - пойыз!
Dialogue: 0,1:07:47.06,1:07:47.89,Default,,0,0,0,,
Dialogue: 0,1:07:47.98,1:07:49.35,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,1:07:49.44,1:07:50.31,Default,,0,0,0,,Уф...
Dialogue: 0,1:07:50.39,1:07:51.98,Default,,0,0,0,,Викторина уақыты!
Dialogue: 0,1:07:52.06,1:07:54.19,Default,,0,0,0,,Е!
Dialogue: 0,1:07:54.86,1:07:57.69,Default,,0,0,0,,Сол Шинсенгуми Тосизо Хиджиката
Dialogue: 0,1:07:57.78,1:08:01.16,Default,,0,0,0,,Хакодатте қайсысы сәтсіз аяқталды?
Dialogue: 0,1:08:01.24,1:08:04.24,Default,,0,0,0,,1 Құны он рио тұратын атақты қылыш сатып алу
Dialogue: 0,1:08:04.33,1:08:06.58,Default,,0,0,0,,Ақшаның жартысы жеткіліксіз болды
Dialogue: 0,1:08:06.66,1:08:09.29,Default,,0,0,0,,2 Хакодате тауына көтерілу жолында
Dialogue: 0,1:08:09.37,1:08:11.92,Default,,0,0,0,,Менің қолымның бауы үзілді!
Dialogue: 0,1:08:12.00,1:08:13.92,Default,,0,0,0,,Хмм.
Dialogue: 0,1:08:14.00,1:08:15.84,Default,,0,0,0,,А...жауабы 1
Dialogue: 0,1:08:15.92,1:08:17.84,Default,,0,0,0,,Горёкакуда бес рио жоғалды
Dialogue: 0,1:08:17.92,1:08:20.38,Default,,0,0,0,,- (Агаса) Дұрыс! -(Мицухико) Хайбар мырза күткендей!
Dialogue: 0,1:08:20.47,1:08:21.84,Default,,0,0,0,,Келесі, екінші сұрақ!
Dialogue: 0,1:08:21.93,1:08:23.97,Default,,0,0,0,,- (Хайбара) Қане, аман-есен ойнайық! -(Ағаса) Иә...
Dialogue: 0,1:08:24.68,1:08:25.72,Default,,0,0,0,,Әкем туралы
Dialogue: 0,1:08:25.81,1:08:28.02,Default,,0,0,0,,Мен бәрін алаңдатқан сияқтымын.
Dialogue: 0,1:08:28.10,1:08:29.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:08:29.64,1:08:34.36,Default,,0,0,0,,Операция жаңа ғана аяқталды, мен қазір жансақтау бөлімінде жатырмын...
Dialogue: 0,1:08:35.02,1:08:36.11,Default,,0,0,0,,Сана әлі...
Dialogue: 0,1:08:36.19,1:08:37.48,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:08:37.57,1:08:41.78,Default,,0,0,0,,А, мен Аокомын, Джинзо Накаморидің қызымын.
Dialogue: 0,1:08:41.86,1:08:43.36,Default,,0,0,0,,Танысқаныма қуаныштымын, мен
Dialogue: 0,1:08:43.45,1:08:45.16,Default,,0,0,0,,Йо... Танысқаныма қуаныштымын.
Dialogue: 0,1:08:45.24,1:08:47.62,Default,,0,0,0,,Полицейлер осында ма?
Dialogue: 0,1:08:47.70,1:08:48.58,Default,,0,0,0,,Не?
Dialogue: 0,1:08:48.66,1:08:52.29,Default,,0,0,0,,Маған Кадокура есімді адам қоңырау шалды.
Dialogue: 0,1:08:52.37,1:08:53.87,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,1:08:55.00,1:08:58.38,Default,,0,0,0,,Мен сенің не жоспарлап жатқаныңды білмеймін, бірақ мен сенің тұрған жеріңді көрсетемін.
Dialogue: 0,1:08:58.46,1:09:00.09,Default,,0,0,0,,Тегін Ryoei-Сан!
Dialogue: 0,1:09:00.17,1:09:02.88,Default,,0,0,0,,Иә, мен оны саған қайтарамын, бірақ...
Dialogue: 0,1:09:03.47,1:09:05.14,Default,,0,0,0,,Қазынаға айырбастау
Dialogue: 0,1:09:05.22,1:09:08.68,Default,,0,0,0,,Күте тұрыңыз! Біз әлі күнге дейін қазынаның қайда екенін білмейміз.
Dialogue: 0,1:09:08.76,1:09:12.14,Default,,0,0,0,,Олай болса, тез тауып ал, батыстың ұлы детективі.
Dialogue: 0,1:09:12.81,1:09:15.15,Default,,0,0,0,,Маған Рёи-санмен сөйлесуге рұқсат етіңіз.
Dialogue: 0,1:09:15.23,1:09:18.15,Default,,0,0,0,,Бұл адамның кілттерді білу мүмкіндігі бар.
Dialogue: 0,1:09:18.23,1:09:21.49,Default,,0,0,0,,Рёи ештеңе айтқысы келмейтін сияқты.
Dialogue: 0,1:09:21.57,1:09:23.78,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,1:09:23.86,1:09:26.99,Default,,0,0,0,,Менің үндемеуімнің себебі, сіз туралы айтуға тұрарлық...
Dialogue: 0,1:09:27.07,1:09:29.03,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:09:29.12,1:09:32.04,Default,,0,0,0,,Маған белгілі бір адамнан өтініш түсті.
Dialogue: 0,1:09:32.12,1:09:36.04,Default,,0,0,0,,Мен Кейзабуро Акиден қалған қазынаны іздеуді жалғастырдым.
Dialogue: 0,1:09:36.63,1:09:39.80,Default,,0,0,0,,Мен қазынаның ішінде не бар екенін де білмеймін.
Dialogue: 0,1:09:39.88,1:09:41.55,Default,,0,0,0,,Біз білетін жалғыз нәрсе
Dialogue: 0,1:09:42.17,1:09:44.55,Default,,0,0,0,,Сол кездегі соғыс барысын өзгертетін нәрсе —
Dialogue: 0,1:09:44.63,1:09:46.97,Default,,0,0,0,,Оның қару болғаны ғана.
Dialogue: 0,1:09:51.18,1:09:55.31,Default,,0,0,0,,Сіз бұл белгілі бір адамның өтініші дедіңіз, бірақ ол кім?
Dialogue: 0,1:09:55.39,1:09:57.56,Default,,0,0,0,,Бұл Тадаюки Акое.
Dialogue: 0,1:09:57.65,1:09:58.77,Default,,0,0,0,,Тадаюки?
Dialogue: 0,1:09:58.86,1:10:00.57,Default,,0,0,0,,Ол Такузоның әкесі.
Dialogue: 0,1:10:00.65,1:10:01.57,Default,,0,0,0,,Әке?
Dialogue: 0,1:10:03.19,1:10:05.65,Default,,0,0,0,,Қазір көп уақыт өтті
Dialogue: 0,1:10:05.74,1:10:08.99,Default,,0,0,0,,Ол екеуміз қарлы Хакодатте кездестік.
Dialogue: 0,1:10:10.16,1:10:12.33,Default,,0,0,0,,- (Тадаюки) Уау! -(Рёи) А?
Dialogue: 0,1:10:13.70,1:10:14.96,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,1:10:15.04,1:10:17.50,Default,,0,0,0,,Әй, менің бейқамдығым.
Dialogue: 0,1:10:18.08,1:10:19.96,Default,,0,0,0,,Мен қысқы теңізді көргім келеді.
Dialogue: 0,1:10:20.54,1:10:22.71,Default,,0,0,0,,Арғы атамның жол көрсетуі ғана ойыма келеді.
Dialogue: 0,1:10:23.30,1:10:25.67,Default,,0,0,0,,Бұл тағдырлы кездесу болды
Dialogue: 0,1:10:27.30,1:10:30.97,Default,,0,0,0,,Содан бері мені Тадаюки тұлғасы қызықтырды.
Dialogue: 0,1:10:31.06,1:10:35.98,Default,,0,0,0,,Аяғын жарақаттап, таяғын қоя алмай серігі болды.
Dialogue: 0,1:10:36.06,1:10:38.73,Default,,0,0,0,,Кейзабуроның қазынасын тапты
Dialogue: 0,1:10:38.81,1:10:41.11,Default,,0,0,0,,Бұл бет бір жерде...
Dialogue: 0,1:10:41.69,1:10:43.98,Default,,0,0,0,,Бірақ Тадаюки-сан
Dialogue: 0,1:10:44.07,1:10:46.40,Default,,0,0,0,,Қазынаның қайда екенін таппай-ақ.
Dialogue: 0,1:10:46.49,1:10:49.24,Default,,0,0,0,,Өткен жылы аурудан қайтыс болды.
Dialogue: 0,1:10:49.32,1:10:51.58,Default,,0,0,0,,Маған бір нәрсені сеніп тапсырыңыз...
Dialogue: 0,1:10:51.66,1:10:53.49,Default,,0,0,0,,Бірдеңе? бұл не
Dialogue: 0,1:10:55.41,1:10:57.00,Default,,0,0,0,,Қазынаның жойылуы
Dialogue: 0,1:10:58.96,1:11:02.88,Default,,0,0,0,,Тадаюки Акие - қазынаны жасырған Кейзабуроның ұлы.
Dialogue: 0,1:11:03.46,1:11:06.13,Default,,0,0,0,,Неліктен ол қазынаны жойғысы келеді?
Dialogue: 0,1:11:06.22,1:11:10.80,Default,,0,0,0,,Тадаюки әкесінің артында қалғандарының болашағына алаңдайды.
Dialogue: 0,1:11:10.89,1:11:14.43,Default,,0,0,0,,Осы сұмдық мұрадан құтылуға тырысу...
Dialogue: 0,1:11:14.52,1:11:16.10,Default,,0,0,0,,Алданбаңыз!
Dialogue: 0,1:11:16.18,1:11:17.94,Default,,0,0,0,,Бастық Қазір жаман!
Dialogue: 0,1:11:18.02,1:11:19.44,Default,,0,0,0,,Егер атқың келсе, ат!
Dialogue: 0,1:11:19.52,1:11:22.44,Default,,0,0,0,,Бірақ менің ерік-жігерімді тоқтату мүмкін емес.
Dialogue: 0,1:11:22.52,1:11:23.52,Default,,0,0,0,,Хехе
Dialogue: 0,1:11:23.61,1:11:26.44,Default,,0,0,0,,Мына жігіттің өмірін сақтап қалғың келсе, тыңда.
Dialogue: 0,1:11:26.53,1:11:28.95,Default,,0,0,0,,Маған Акие отбасының қазынасын әкел.
Dialogue: 0,1:11:29.03,1:11:31.91,Default,,0,0,0,,Мені ақымақ деп айт! біз сауда жасамаймыз
Dialogue: 0,1:11:31.99,1:11:34.70,Default,,0,0,0,,Сіз мұны айта аласыз ба?
Dialogue: 0,1:11:40.17,1:11:41.46,Default,,0,0,0,,B... Жарылыс!
Dialogue: 0,1:11:42.04,1:11:43.46,Default,,0,0,0,,Дәл сол бомба
Dialogue: 0,1:11:43.54,1:11:45.96,Default,,0,0,0,,Бірнеше Хакодате қаласында орнатылды.
Dialogue: 0,1:11:46.05,1:11:49.34,Default,,0,0,0,,Егер қазынаны 24 сағат ішінде әкелмесең...
Dialogue: 0,1:11:49.43,1:11:50.68,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,1:11:50.76,1:11:51.59,Default,,0,0,0,,(Қоңыраудың дыбысы ажыратылады)
Dialogue: 0,1:11:51.68,1:11:54.60,Default,,0,0,0,,Қала барымтада ма?
Dialogue: 0,1:11:55.56,1:11:57.10,Default,,0,0,0,,Тергеуде, кешіріңіз.
Dialogue: 0,1:11:57.68,1:11:59.94,Default,,0,0,0,,Маған ваннаға баруға рұқсат бере аласыз ба?
Dialogue: 0,1:12:00.02,1:12:02.60,Default,,0,0,0,,Әй, тез істе.
Dialogue: 0,1:12:03.15,1:12:04.86,Default,,0,0,0,,Хакодате қалалық ауруханасы, асығыңыз!
Dialogue: 0,1:12:04.94,1:12:06.19,Default,,0,0,0,,Ах!
Dialogue: 0,1:12:10.28,1:12:11.61,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:12:21.21,1:12:22.58,Default,,0,0,0,,Әкем
Dialogue: 0,1:12:25.92,1:12:27.05,Default,,0,0,0,,Хмм...
Dialogue: 0,1:12:28.05,1:12:28.88,Default,,0,0,0,,Уф!
Dialogue: 0,1:12:29.63,1:12:30.92,Default,,0,0,0,,Әке!
Dialogue: 0,1:12:36.06,1:12:38.72,Default,,0,0,0,,Я...
Dialogue: 0,1:12:44.15,1:12:45.15,Default,,0,0,0,,Иә
Dialogue: 0,1:12:45.86,1:12:49.65,Default,,0,0,0,,(Kadokura ағылшын тілі)
Dialogue: 0,1:12:50.24,1:12:53.16,Default,,0,0,0,,(Ағылшын тілі)
Dialogue: 0,1:13:07.88,1:13:10.67,Default,,0,0,0,,Осы жерде тоқтамай, тіке жүр...
Dialogue: 0,1:13:10.76,1:13:12.17,Default,,0,0,0,,Эй, Боуз, осы жолмен.
Dialogue: 0,1:13:12.26,1:13:15.18,Default,,0,0,0,,Инспектор Накамори есін жиды ма?
Dialogue: 0,1:13:15.26,1:13:18.14,Default,,0,0,0,,Иә, бірақ мен сені әлі кездестіре алмаймын.
Dialogue: 0,1:13:18.22,1:13:20.68,Default,,0,0,0,,Мен түсінемін, бірақ бұл жақсы.
Dialogue: 0,1:13:20.77,1:13:23.35,Default,,0,0,0,,Мазалағаныңызға рахмет.
Dialogue: 0,1:13:23.44,1:13:26.11,Default,,0,0,0,,Сондай-ақ, әкемнің маған айтқаны...
Dialogue: 0,1:13:26.19,1:13:28.36,Default,,0,0,0,,- (Хедзи) Айтыңызшы? -(Аоко) Иә.
Dialogue: 0,1:13:28.44,1:13:31.82,Default,,0,0,0,,Такузо Аки есімді адам оқ тигеннен кейін есін жоғалтқанға дейін.
Dialogue: 0,1:13:31.90,1:13:33.95,Default,,0,0,0,,Әкеңе айтар сөзің қалдырған сияқтысың...
Dialogue: 0,1:13:34.49,1:13:37.70,Default,,0,0,0,,«Мачида Шотоку жоқ Никки»
Dialogue: 0,1:13:37.78,1:13:38.70,Default,,0,0,0,,Күнделік...
Dialogue: 0,1:13:38.70,1:13:39.83,Default,,0,0,0,,Күнделік...
Dialogue: 0,1:13:38.70,1:13:39.83,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:13:39.83,1:13:39.91,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:13:39.91,1:13:40.83,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:13:39.91,1:13:40.83,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:40.91,1:13:44.33,Default,,0,0,0,,- (Медбике) Дәлізде жүгірме! -(Кавазоэ)... Кешіріңіз!
Dialogue: 0,1:13:44.42,1:13:45.62,Default,,0,0,0,,Не болды?
Dialogue: 0,1:13:45.71,1:13:48.34,Default,,0,0,0,,Маған жаңа ғана инспектор Нишимура қоңырау шалды.
Dialogue: 0,1:13:48.42,1:13:50.50,Default,,0,0,0,,Хиджири Фукудзо қашып кеткен сияқты!
Dialogue: 0,1:13:51.09,1:13:52.01,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,1:13:52.09,1:13:54.01,Default,,0,0,0,,Баратын жері белгісіз.
Dialogue: 0,1:13:54.09,1:13:57.39,Default,,0,0,0,,...Бірден болып жатқан тым көп нәрсе!
Dialogue: 0,1:13:57.47,1:13:58.72,Default,,0,0,0,,- (Когоро) Кеттік! -(Кавазоэ) Иә!
Dialogue: 0,1:13:58.80,1:14:00.76,Default,,0,0,0,,Сондықтан дәлізде жүгірме!
Dialogue: 0,1:14:00.85,1:14:02.39,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,1:14:03.18,1:14:05.23,Default,,0,0,0,,Қасиетті, неге?
Dialogue: 0,1:14:05.31,1:14:06.85,Default,,0,0,0,,Сәл тынышталсам ғой
Dialogue: 0,1:14:06.94,1:14:08.65,Default,,0,0,0,,Мен бос болуым керек еді!
Dialogue: 0,1:14:08.73,1:14:10.98,Default,,0,0,0,,Үндемей қалсаң, уақытында үлгере алмайсың.
Dialogue: 0,1:14:11.07,1:14:12.65,Default,,0,0,0,,Бірдеңе болған болуы керек, солай ма?
Dialogue: 0,1:14:12.73,1:14:15.86,Default,,0,0,0,,Бұл жағдайда, бұрын Райо-санмен телефон арқылы сөйлескенде,
Dialogue: 0,1:14:15.95,1:14:17.66,Default,,0,0,0,,Менің назарымды аударған бір сөз болды.
Dialogue: 0,1:14:17.74,1:14:21.54,Default,,0,0,0,,«Бірақ менің ерік-жігерімді тоқтату мүмкін емес», солай ма?
Dialogue: 0,1:14:21.62,1:14:22.79,Default,,0,0,0,,Міне.
Dialogue: 0,1:14:22.87,1:14:24.91,Default,,0,0,0,,Ертерек байқаған жөн
Dialogue: 0,1:14:25.00,1:14:27.92,Default,,0,0,0,,Тадаюкидің өсиетін Рёи мұраға алғаны сияқты.
Dialogue: 0,1:14:28.00,1:14:30.29,Default,,0,0,0,,Райо-санның өсиетін иеленетін біреу бар.
Dialogue: 0,1:14:30.38,1:14:32.55,Default,,0,0,0,,Ұлының киелілігі осы ма?
Dialogue: 0,1:14:32.63,1:14:35.30,Default,,0,0,0,,Татамиде қалдырылған жұлдызша
Dialogue: 0,1:14:35.38,1:14:36.51,Default,,0,0,0,,Бұл Әулие үшін болды.
Dialogue: 0,1:14:36.59,1:14:40.30,Default,,0,0,0,,Мүмкін бұл қандай да бір хабарды жеткізудің бір жолы болған шығар.
Dialogue: 0,1:14:40.39,1:14:41.22,Default,,0,0,0,,А...
Dialogue: 0,1:14:41.31,1:14:42.85,Default,,0,0,0,,Хааа~
Dialogue: 0,1:14:42.93,1:14:44.56,Default,,0,0,0,,... дегеніміз не?
Dialogue: 0,1:14:44.64,1:14:48.19,Default,,0,0,0,,Сіз, Аоконың кішкентай кезіндегі досы.
Dialogue: 0,1:14:48.27,1:14:50.15,Default,,0,0,0,,Олар өте ұқсас.
Dialogue: 0,1:14:50.23,1:14:52.07,Default,,0,0,0,,Дұрыс...
Dialogue: 0,1:14:52.15,1:14:54.36,Default,,0,0,0,,Иә, дәл солай!
Dialogue: 0,1:14:54.44,1:14:57.45,Default,,0,0,0,,Иә? Кішкентай жырау, кенет не болды?
Dialogue: 0,1:14:57.53,1:14:58.86,Default,,0,0,0,,Соноко апа
Dialogue: 0,1:14:58.95,1:15:00.12,Default,,0,0,0,,Маған келесі сұраққа жауап бер.
Dialogue: 0,1:15:00.20,1:15:02.87,Default,,0,0,0,,Каталогта кітап жоқ дедіңіз.
Dialogue: 0,1:15:02.95,1:15:06.46,Default,,0,0,0,,Дұрыс, ақыры таба алмадым.
Dialogue: 0,1:15:06.54,1:15:08.42,Default,,0,0,0,,Кітаптың атын білесіз бе?
Dialogue: 0,1:15:08.50,1:15:11.54,Default,,0,0,0,,Тақырып? Ал, бұл не болды?
Dialogue: 0,1:15:11.63,1:15:13.96,Default,,0,0,0,,Мен сенімдімін ескі күнделік
Dialogue: 0,1:15:14.05,1:15:16.38,Default,,0,0,0,,Масанори Мачида...
Dialogue: 0,1:15:16.47,1:15:22.01,Default,,0,0,0,,Ол Хакодате соғысы кезінде Хакодате теңіз өнімдерін көтерме сатушы болды.
Dialogue: 0,1:15:22.10,1:15:24.64,Default,,0,0,0,,Мұндай адамның күнделігі Акие отбасына қалай түсті?
Dialogue: 0,1:15:24.72,1:15:28.77,Default,,0,0,0,,Масанори Мачида Хиджикатамен бірнеше рет кездескен сияқты.
Dialogue: 0,1:15:28.85,1:15:31.77,Default,,0,0,0,,Ал мен бұл туралы күнделігіме жаздым.
Dialogue: 0,1:15:31.86,1:15:34.78,Default,,0,0,0,,Бірақ дәл қазір ол сізде жоқ, солай ма?
Dialogue: 0,1:15:34.86,1:15:37.53,Default,,0,0,0,,Suzuki Zaibatsu қуатын бағаламаңыз.
Dialogue: 0,1:15:37.61,1:15:39.45,Default,,0,0,0,,Шынайы жоқ болса да
Dialogue: 0,1:15:39.53,1:15:41.66,Default,,0,0,0,,Мен кітапты Кейзабуро Акиге саттым.
Dialogue: 0,1:15:41.74,1:15:44.28,Default,,0,0,0,,Мен бастапқы иесін таптым және...
Dialogue: 0,1:15:44.37,1:15:46.91,Default,,0,0,0,,Бұл адамның көшірмесі болды.
Dialogue: 0,1:15:47.00,1:15:48.00,Default,,0,0,0,,- (Хедзи) Шынымен бе? -Шынымен бе?
Dialogue: 0,1:15:48.08,1:15:49.29,Default,,0,0,0,,Маған жібере аласыз ба?
Dialogue: 0,1:15:49.37,1:15:50.42,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:15:50.50,1:15:52.88,Default,,0,0,0,,Мен оны деректерге түрлендірдім, сондықтан оны бірден жіберемін.
Dialogue: 0,1:15:52.96,1:15:54.34,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:15:54.84,1:15:57.05,Default,,0,0,0,,Мұны кім жасағанын білмеймін, бірақ
Dialogue: 0,1:15:57.13,1:15:59.30,Default,,0,0,0,,Seiryo семсерін ұрлаған жігіт
Dialogue: 0,1:15:59.38,1:16:02.01,Default,,0,0,0,,Ол кітаптарды да ұрлауы мүмкін.
Dialogue: 0,1:16:02.09,1:16:03.97,Default,,0,0,0,,Ах, жинақтан.
Dialogue: 0,1:16:04.05,1:16:06.64,Default,,0,0,0,,Мен тек кітаптар жетіспейді деп уайымдадым.
Dialogue: 0,1:16:06.72,1:16:07.85,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:16:07.93,1:16:09.35,Default,,0,0,0,,Соноко-ни-чан күткендей
Dialogue: 0,1:16:09.43,1:16:11.27,Default,,0,0,0,,Жылдам жұмыс істейді
Dialogue: 0,1:16:13.61,1:16:15.27,Default,,0,0,0,,А, міне, солай.
Dialogue: 0,1:16:15.36,1:16:18.40,Default,,0,0,0,,Масанори Хиджикатаға қылыш береді.
Dialogue: 0,1:16:20.24,1:16:22.91,Default,,0,0,0,,«Түн ортасында Хиджиката-доного қар жауады»
Dialogue: 0,1:16:22.99,1:16:26.70,Default,,0,0,0,,«Мен саған сыйлық ретінде Жұлдызды қылышты ұсынғым келеді».
Dialogue: 0,1:16:26.79,1:16:30.21,Default,,0,0,0,,«Бұл Горёкаку қамалын салу кезінде жасалған».
Dialogue: 0,1:16:30.29,1:16:32.42,Default,,0,0,0,,Алайда оларға үкімет әскері шабуыл жасады...
Dialogue: 0,1:16:35.25,1:16:36.46,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:37.55,1:16:42.30,Default,,0,0,0,,Қылышпен шайқаста бағаланатын нәрсе үнемі өзгеріп тұратын және икемді.
Dialogue: 0,1:16:42.38,1:16:43.72,Default,,0,0,0,,Аһ!
Dialogue: 0,1:16:43.80,1:16:48.64,Default,,0,0,0,,Қандай техникаға қарамастан жеңуге дайын болыңыз!
Dialogue: 0,1:16:48.72,1:16:51.06,Default,,0,0,0,,Уф... уф
Dialogue: 0,1:16:56.40,1:16:59.82,Default,,0,0,0,,Кешіріңіз, бірақ мен бұл қылышты қабылдай алмаймын.
Dialogue: 0,1:17:01.82,1:17:04.70,Default,,0,0,0,,Өйткені менде Канесада бар.
Dialogue: 0,1:17:05.28,1:17:06.33,Default,,0,0,0,,Иә
Dialogue: 0,1:17:06.41,1:17:07.49,Default,,0,0,0,,Хиджиката-доно
Dialogue: 0,1:17:07.58,1:17:11.08,Default,,0,0,0,,«Менің ойымша, мен жағдайды өз бетімше шеше аламын».
Dialogue: 0,1:17:11.16,1:17:13.21,Default,,0,0,0,,Мұның өзі тіпті кеңес емес.
Dialogue: 0,1:17:13.29,1:17:15.96,Default,,0,0,0,,- (Хедзи) Саяна - (Аюми) Конан!
Dialogue: 0,1:17:16.04,1:17:19.30,Default,,0,0,0,,Сәлем, балалар, бұл мен күткеннен де жылдам болды.
Dialogue: 0,1:17:19.38,1:17:21.59,Default,,0,0,0,,Детектив тобын шұғыл шақыру және не істеу керек
Dialogue: 0,1:17:21.67,1:17:23.22,Default,,0,0,0,,Не болса да, мен асығамын!
Dialogue: 0,1:17:23.30,1:17:26.64,Default,,0,0,0,,Менің бизнесім болған жалғыз адам доктор Агаса болды.
Dialogue: 0,1:17:26.72,1:17:28.85,Default,,0,0,0,,Демалуға уақыт жоқ!
Dialogue: 0,1:17:28.93,1:17:31.85,Default,,0,0,0,,Мен Шыңғысханды теңіз өнімдерімен бірге жеуім керек.
Dialogue: 0,1:17:31.93,1:17:34.31,Default,,0,0,0,,Бұған дейін, дәрігер, сіз не сұрадыңыз?
Dialogue: 0,1:17:34.39,1:17:36.02,Default,,0,0,0,,А, бұл тамаша.
Dialogue: 0,1:17:36.10,1:17:37.98,Default,,0,0,0,,Эй, Конан-кун, қарашы.
Dialogue: 0,1:17:38.07,1:17:40.82,Default,,0,0,0,,Бұл мен станцияда алған мөрім!
Dialogue: 0,1:17:41.61,1:17:42.53,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:42.61,1:17:43.99,Default,,0,0,0,,(Желдің екпіні)
Dialogue: 0,1:17:55.04,1:17:56.04,Default,,0,0,0,,Ха…
Dialogue: 0,1:18:01.76,1:18:02.80,Default,,0,0,0,,Конан-кун?
Dialogue: 0,1:18:02.88,1:18:05.93,Default,,0,0,0,,Хаттори: Бұл көрсеткіш емес пе?
Dialogue: 0,1:18:06.01,1:18:08.93,Default,,0,0,0,,Аа, мен де соны енді ғана түсіндім.
Dialogue: 0,1:18:09.55,1:18:12.93,Default,,0,0,0,,Ақырында шешім қабылдау уақыты келді.
Dialogue: 0,1:18:13.93,1:18:16.90,Default,,0,0,0,,Аа, бүгін кешкі сағат 7.
Dialogue: 0,1:18:16.98,1:18:18.98,Default,,0,0,0,,Орналасқан жері Горёкаку ма?
Dialogue: 0,1:18:19.48,1:18:20.94,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:18:21.57,1:18:24.53,Default,,0,0,0,,Казуха-чан, ары қарай не істейсің?
Dialogue: 0,1:18:24.61,1:18:26.24,Default,,0,0,0,,Арқан жолы туралы не деуге болады?
Dialogue: 0,1:18:26.32,1:18:27.32,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:18:27.41,1:18:28.82,Default,,0,0,0,,Хэйдзиден
Dialogue: 0,1:18:30.62,1:18:32.62,Default,,0,0,0,,Сәлеметсіз бе? Не болды?
Dialogue: 0,1:18:32.70,1:18:34.08,Default,,0,0,0,,Іс шешілді ме?
Dialogue: 0,1:18:34.16,1:18:38.33,Default,,0,0,0,,Әлі күйіп тұр, бірақ түнде тозып қалатын сияқты.
Dialogue: 0,1:18:39.54,1:18:42.84,Default,,0,0,0,,Бүгін кешке Хакодате тауында мені күтуге қарсы боласыз ба?
Dialogue: 0,1:18:42.92,1:18:46.59,Default,,0,0,0,,Не? Хакодате тауы? Мен шынымен де қарсы емеспін
Dialogue: 0,1:18:47.72,1:18:49.05,Default,,0,0,0,,Мүлдем.
Dialogue: 0,1:18:49.14,1:18:52.35,Default,,0,0,0,,Жағдай дөрекі болса, мен не болса да кетемін!
Dialogue: 0,1:18:52.43,1:18:54.56,Default,,0,0,0,,Жарайды, мен күтемін.
Dialogue: 0,1:18:54.64,1:18:55.68,Default,,0,0,0,,Хона
Dialogue: 0,1:19:01.06,1:19:03.53,Default,,0,0,0,,Әзірге ешқандай ауытқулар жоқ.
Dialogue: 0,1:19:15.58,1:19:18.58,Default,,0,0,0,,Сен тоқта... Уау!
Dialogue: 0,1:19:21.42,1:19:22.50,Default,,0,0,0,,Иә, Иори
Dialogue: 0,1:19:23.09,1:19:27.26,Default,,0,0,0,,Егер Хэйдзи миллион доллардың алдында мойындай бастаса ше?
Dialogue: 0,1:19:27.34,1:19:29.01,Default,,0,0,0,,Мен оған міндетті түрде тосқауыл қоямын.
Dialogue: 0,1:19:29.09,1:19:31.72,Default,,0,0,0,,Мен түсіндім, жас ханым.
Dialogue: 0,1:19:31.80,1:19:36.27,Default,,0,0,0,,Бізде бұл үшін сізге қажет нәрсенің бәрі бар.
Dialogue: 0,1:19:36.93,1:19:39.77,Default,,0,0,0,,Мен саған сенемін, Иори.
Dialogue: 0,1:19:46.82,1:19:50.28,Default,,0,0,0,,Не? Мен екі бала келеді деп ойламадым.
Dialogue: 0,1:19:50.36,1:19:52.49,Default,,0,0,0,,Балалар... Уф.
Dialogue: 0,1:19:52.57,1:19:55.33,Default,,0,0,0,,Ал, айтайын.
Dialogue: 0,1:19:55.41,1:19:57.62,Default,,0,0,0,,Қазына қайда?
Dialogue: 0,1:19:57.70,1:19:59.16,Default,,0,0,0,,Иә, мен әлі білмеймін.
Dialogue: 0,1:19:59.25,1:20:02.25,Default,,0,0,0,,Енді сол жерді табамыз.
Dialogue: 0,1:20:02.33,1:20:04.80,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:06.51,1:20:07.67,Default,,0,0,0,,Шар?
Dialogue: 0,1:20:07.76,1:20:10.22,Default,,0,0,0,,Соғыс кезінде Кейзабуро Акое
Dialogue: 0,1:20:10.30,1:20:13.18,Default,,0,0,0,,Енді әуе шарын ұшырудың мақсаты туралы ойланайық.
Dialogue: 0,1:20:13.26,1:20:15.22,Default,,0,0,0,,Үш ұпай
Dialogue: 0,1:20:15.31,1:20:18.56,Default,,0,0,0,,Шардың едені шыныдан жасалған болуы керек.
Dialogue: 0,1:20:18.64,1:20:21.69,Default,,0,0,0,,Кейзабуроның өзінде қылыш бар
Dialogue: 0,1:20:21.77,1:20:25.94,Default,,0,0,0,,Шарға отыру және телескоп арқылы бір нәрсеге қарау
Dialogue: 0,1:20:26.02,1:20:27.94,Default,,0,0,0,,Қылыш дегеніміз не?
Dialogue: 0,1:20:28.03,1:20:31.49,Default,,0,0,0,,Тошогу ғибадатханасынан жоғалып кеткен Сейрио қылыш деп аталатын нәрсе.
Dialogue: 0,1:20:31.57,1:20:35.41,Default,,0,0,0,,Дұрыс, бірақ соңында таба алмадым.
Dialogue: 0,1:20:35.49,1:20:38.87,Default,,0,0,0,,Қылышсыз қазынаның қайда екенін білсеңіз ше?
Dialogue: 0,1:20:38.95,1:20:40.46,Default,,0,0,0,,Соған қарамастан, бұл түтін неге осынша көп?
Dialogue: 0,1:20:41.08,1:20:43.08,Default,,0,0,0,,Ал, қараңдаршы.
Dialogue: 0,1:20:47.17,1:20:49.26,Default,,0,0,0,,Түнгі көрініс қызық
Dialogue: 0,1:20:49.34,1:20:51.09,Default,,0,0,0,,Содан (ұялы телефонның діріл дыбысы)
Dialogue: 0,1:20:52.38,1:20:54.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:20:54.22,1:20:58.47,Default,,0,0,0,,Горёкаку соғыс кезінде бір түн күйіп қалған деген әңгіме бар.
Dialogue: 0,1:20:58.56,1:21:01.89,Default,,0,0,0,,Егер бұл сурет сол уақытты бейнелесе...
Dialogue: 0,1:21:01.98,1:21:02.81,Default,,0,0,0,,Жасаңыз.
Dialogue: 0,1:21:06.77,1:21:08.07,Default,,0,0,0,,Не?
Dialogue: 0,1:21:13.28,1:21:14.45,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:21:15.53,1:21:16.74,Default,,0,0,0,,Хмм?
Dialogue: 0,1:21:20.16,1:21:21.37,Default,,0,0,0,,Конан-кун!
Dialogue: 0,1:21:21.45,1:21:23.83,Default,,0,0,0,,Мен бәрін тамаша дайындадым!
Dialogue: 0,1:21:23.92,1:21:26.84,Default,,0,0,0,,Күтуден шаршадым
Dialogue: 0,1:21:26.92,1:21:30.34,Default,,0,0,0,,Енді мұны тез аяқтай аласыз ба?
Dialogue: 0,1:21:30.42,1:21:32.09,Default,,0,0,0,,«Зардап шегушілер ашу-ыза білдіреді»
Dialogue: 0,1:21:34.43,1:21:36.30,Default,,0,0,0,,Не істесеңіз де...
Dialogue: 0,1:21:36.39,1:21:39.81,Default,,0,0,0,,Тосизо Хиджикатаға табынған Кейзабуро,
Dialogue: 0,1:21:39.89,1:21:42.48,Default,,0,0,0,,Қазынаны қайда жасыру керектігін қарастырғанда
Dialogue: 0,1:21:42.56,1:21:44.85,Default,,0,0,0,,Мен Хиджикатаға қатысты бірдеңені қолдандым.
Dialogue: 0,1:21:45.44,1:21:47.86,Default,,0,0,0,,Біріншіден, бұл Горёкаку жері
Dialogue: 0,1:21:48.44,1:21:53.45,Default,,0,0,0,,Бір түнде қолданылған семсер: Хоширио қылыш
Dialogue: 0,1:21:53.53,1:21:57.82,Default,,0,0,0,,Және, мүмкін, қазынаның орналасқан жерімен тығыз байланысты ...
Dialogue: 0,1:21:59.45,1:22:01.04,Default,,0,0,0,,Биіктік.
Dialogue: 0,1:22:01.12,1:22:05.96,Default,,0,0,0,,Мен оны биіктігін тексеру үшін пайдалануым керек еді, бірақ ол жұлдызды қылыш болып шықты.
Dialogue: 0,1:22:06.04,1:22:07.38,Default,,0,0,0,,Енді жоқ
Dialogue: 0,1:22:07.46,1:22:08.29,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:08.38,1:22:10.13,Default,,0,0,0,,Бірақ мен алмастырушы таптым.
Dialogue: 0,1:22:10.21,1:22:13.80,Default,,0,0,0,,Кеңес Масанори Мачиданың күнделігінен алынды.
Dialogue: 0,1:22:13.88,1:22:17.14,Default,,0,0,0,,Хиджиката жаңа үкіметтен қастандықты өлтіреді.
Dialogue: 0,1:22:17.22,1:22:19.30,Default,,0,0,0,,Егжей-тегжейлі жазылған
Dialogue: 0,1:22:19.39,1:22:22.31,Default,,0,0,0,,Хиджиката екі адамды кесіп тастап, жалғастырады...
Dialogue: 0,1:22:22.39,1:22:25.27,Default,,0,0,0,,Арттан келе жатқан үшінші адамды көру үшін бұрылыңыз.
Dialogue: 0,1:22:25.35,1:22:27.48,Default,,0,0,0,,Бүктелетін экран түгел тесілген дейді.
Dialogue: 0,1:22:28.10,1:22:30.48,Default,,0,0,0,,Мен біреуді кесіп алдым, күзетшіге қан түсті.
Dialogue: 0,1:22:30.57,1:22:33.90,Default,,0,0,0,,Сол қылышпен жиналмалы экранды тесіп өтсеңіз не болады деп ойлайсыз?
Dialogue: 0,1:22:33.99,1:22:35.61,Default,,0,0,0,,Бұл осылай болады
Dialogue: 0,1:22:35.70,1:22:37.78,Default,,0,0,0,,Кітап ұрланған, бірақ
Dialogue: 0,1:22:37.86,1:22:41.12,Default,,0,0,0,,Сол кездегі жиналмалы экран әлі жинақта болды.
Dialogue: 0,1:22:41.20,1:22:43.83,Default,,0,0,0,,Егер сіз суретке түсірсеңіз, пішінді алып тастауға болады.
Dialogue: 0,1:22:43.91,1:22:47.42,Default,,0,0,0,,Қылыш Горёкаку аяқталғанын еске алу үшін жасалған.
Dialogue: 0,1:22:47.50,1:22:51.13,Default,,0,0,0,,Цубаның жұлдызды пішіні Горёкакуды дәл бейнелейді.
Dialogue: 0,1:22:51.21,1:22:53.42,Default,,0,0,0,,Міне, мен сізге бұрын көрсеткен шардың суреті.
Dialogue: 0,1:22:53.51,1:22:56.26,Default,,0,0,0,,Кейзабуро-сан қылышын жерге қадады.
Dialogue: 0,1:22:56.34,1:22:58.64,Default,,0,0,0,,Мүмкін шыны еденнің ортасында
Dialogue: 0,1:22:58.72,1:23:02.22,Default,,0,0,0,,Жапон қылышының орташа ұзындығы шамамен 70 см.
Dialogue: 0,1:23:02.31,1:23:04.52,Default,,0,0,0,,Хоширёотқа келетін болсақ, бұл туралы.
Dialogue: 0,1:23:04.60,1:23:06.39,Default,,0,0,0,,Бірақ шын мәнінде маңыздысы
Dialogue: 0,1:23:06.48,1:23:10.19,Default,,0,0,0,,Пышақтың ұзындығы емес, цубадан көзге дейінгі қашықтық.
Dialogue: 0,1:23:10.94,1:23:13.19,Default,,0,0,0,,Хоширио семсерінің Мекуги тесігінің айналасында
Dialogue: 0,1:23:13.78,1:23:17.45,Default,,0,0,0,,Адамның көзіне ұқсайтын өрнек қосылған сияқты.
Dialogue: 0,1:23:17.53,1:23:19.95,Default,,0,0,0,,Көзіңізді сол жерге тураласаңыз
Dialogue: 0,1:23:20.03,1:23:24.45,Default,,0,0,0,,Учикатана жағдайында цубадан мекүги тесігіне дейінгі ұзындық шамамен —
Dialogue: 0,1:23:24.54,1:23:26.58,Default,,0,0,0,,4 саусақ
Dialogue: 0,1:23:26.66,1:23:30.67,Default,,0,0,0,,Осы позициядан қарағанда, цубаның жұлдыз пішіні және Горёкаку сыртқы орының өлшемі
Dialogue: 0,1:23:30.75,1:23:32.46,Default,,0,0,0,,Өте жақсы сәйкес келетін нүктелер
Dialogue: 0,1:23:33.04,1:23:34.71,Default,,0,0,0,,Ол іздеген биіктік
Dialogue: 0,1:23:37.55,1:23:38.88,Default,,0,0,0,,Иә! мұнда
Dialogue: 0,1:23:38.97,1:23:39.97,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,1:23:44.85,1:23:47.43,Default,,0,0,0,,Не, мына биіктікте не бар...
Dialogue: 0,1:23:47.52,1:23:48.73,Default,,0,0,0,,Жоқ, мүмкін емес…
Dialogue: 0,1:23:48.81,1:23:53.02,Default,,0,0,0,,Хакодате бұл биіктікте бір ғана нәрсе бар.
Dialogue: 0,1:23:53.11,1:23:53.98,Default,,0,0,0,,Келесіні сұрау
Dialogue: 0,1:24:01.82,1:24:03.49,Default,,0,0,0,,Цубурая-кун, қазір!
Dialogue: 0,1:24:03.58,1:24:04.83,Default,,0,0,0,,Иә!
Dialogue: 0,1:24:09.79,1:24:11.46,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,1:24:12.79,1:24:14.88,Default,,0,0,0,,Наха… Хакодате…
Dialogue: 0,1:24:14.96,1:24:16.30,Default,,0,0,0,,Иә
Dialogue: 0,1:24:16.80,1:24:18.84,Default,,0,0,0,,Акие отбасының қазынасы...
Dialogue: 0,1:24:19.42,1:24:21.22,Default,,0,0,0,,Хакодате тауында орналасқан
Dialogue: 0,1:24:23.55,1:24:26.43,Default,,0,0,0,,Иә? Ол жақта жарық емес пе?
Dialogue: 0,1:24:26.51,1:24:29.73,Default,,0,0,0,,А... шынымен бе? Фестивальдарда да солай жасамайды ма?
Dialogue: 0,1:24:29.81,1:24:31.39,Default,,0,0,0,,Біраз жүрейік.
Dialogue: 0,1:24:31.48,1:24:34.15,Default,,0,0,0,,Казуха-чан, бұл жерден кетпе!
Dialogue: 0,1:24:34.23,1:24:36.15,Default,,0,0,0,,Хаттори-кун келе жатыр, солай ма?
Dialogue: 0,1:24:36.23,1:24:37.69,Default,,0,0,0,,Се... Сейана
Dialogue: 0,1:24:37.78,1:24:39.90,Default,,0,0,0,,Мен уәдемді орындадым.
Dialogue: 0,1:24:39.99,1:24:42.95,Default,,0,0,0,,Алдымен, бомбаның қайда екенін айта аласыз ба?
Dialogue: 0,1:24:43.03,1:24:44.16,Default,,0,0,0,,Хехехе
Dialogue: 0,1:24:44.91,1:24:46.66,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,1:24:47.29,1:24:48.83,Default,,0,0,0,,Өте тәтті!
Dialogue: 0,1:24:48.91,1:24:49.95,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:24:50.04,1:24:52.62,Default,,0,0,0,,Мен барлық бомбаларды жарып жіберемін.
Dialogue: 0,1:24:52.71,1:24:55.54,Default,,0,0,0,,Шатасуды пайдаланып, қазынаны алыңыз.
Dialogue: 0,1:24:55.63,1:24:58.38,Default,,0,0,0,,Жапониядан қашу үшін!
Dialogue: 0,1:24:59.59,1:25:00.80,Default,,0,0,0,,Не...
Dialogue: 0,1:25:01.55,1:25:02.38,Default,,0,0,0,,Нвааах!
Dialogue: 0,1:25:02.47,1:25:03.72,Default,,0,0,0,,Начо!
Dialogue: 0,1:25:07.97,1:25:09.39,Default,,0,0,0,,Начо!
Dialogue: 0,1:25:09.47,1:25:10.39,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,1:25:17.32,1:25:18.40,Default,,0,0,0,,Хун
Dialogue: 0,1:25:20.99,1:25:22.32,Default,,0,0,0,,Бала!
Dialogue: 0,1:25:22.40,1:25:23.49,Default,,0,0,0,,Жаса!
Dialogue: 0,1:25:28.87,1:25:29.70,Default,,0,0,0,,А... О, жоқ!
Dialogue: 0,1:25:29.79,1:25:31.25,Default,,0,0,0,,Хаттори!
Dialogue: 0,1:25:32.54,1:25:34.62,Default,,0,0,0,,Ооо!
Dialogue: 0,1:25:35.21,1:25:37.04,Default,,0,0,0,,- (Окита) Хмф! - (Миниондар) Арх!
Dialogue: 0,1:25:37.88,1:25:39.05,Default,,0,0,0,,Әйтеуір, ол жақында ғана қорқынышты сынақтан өтті
Dialogue: 0,1:25:39.13,1:25:41.26,Default,,0,0,0,,Уф... бұл ыңғайсыздық!
Dialogue: 0,1:25:41.34,1:25:42.63,Default,,0,0,0,,Бастық, кешіріңіз.
Dialogue: 0,1:25:42.72,1:25:44.59,Default,,0,0,0,,Ақымақ! Рёиді әкел.
Dialogue: 0,1:25:44.68,1:25:45.55,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:25:46.18,1:25:48.47,Default,,0,0,0,,Эй... Ти!
Dialogue: 0,1:25:51.06,1:25:52.23,Default,,0,0,0,,- (Хедзи) Ия! - (Миньон) Арх!
Dialogue: 0,1:25:56.06,1:25:58.82,Default,,0,0,0,,- (Окита) Сіз де маған қосыла аласыз ба? -(Хедзи) Окита кеш болды.
Dialogue: 0,1:25:58.90,1:26:00.78,Default,,0,0,0,,- (Ер адам) Эй! - (Миниондар) Арх!
Dialogue: 0,1:26:00.86,1:26:02.15,Default,,0,0,0,,Бұл не...
Dialogue: 0,1:26:02.24,1:26:05.82,Default,,0,0,0,,Мен шынымен күшті көрінетін нәрсені көрдім, сондықтан оны өзіммен бірге алып келдім ...
Dialogue: 0,1:26:07.78,1:26:11.70,Default,,0,0,0,,Жаман адамдар көп деп естігендіктен келдім.
Dialogue: 0,1:26:11.79,1:26:12.70,Default,,0,0,0,,Иә
Dialogue: 0,1:26:12.79,1:26:15.12,Default,,0,0,0,,Балалар!
Dialogue: 0,1:26:15.21,1:26:16.37,Default,,0,0,0,,Аһ!
Dialogue: 0,1:26:17.13,1:26:18.79,Default,,0,0,0,,Иә!
Dialogue: 0,1:26:18.88,1:26:20.63,Default,,0,0,0,,(Миньондар ыңырсыды)
Dialogue: 0,1:26:21.38,1:26:24.01,Default,,0,0,0,,- (Хедзи) Кім? Ол адам - (Окита) Саана
Dialogue: 0,1:26:25.84,1:26:26.76,Default,,0,0,0,,Кадокура!
Dialogue: 0,1:26:26.84,1:26:28.30,Default,,0,0,0,,Сәлем, құда!
Dialogue: 0,1:26:28.39,1:26:30.01,Default,,0,0,0,,- (Хейджи) Иә! - (Миньон) Арх!
Dialogue: 0,1:26:30.10,1:26:31.26,Default,,0,0,0,,Аюми!
Dialogue: 0,1:26:31.35,1:26:33.68,Default,,0,0,0,,Конан!
Dialogue: 0,1:26:43.23,1:26:45.53,Default,,0,0,0,,Ой, бұл керемет.
Dialogue: 0,1:26:45.61,1:26:47.07,Default,,0,0,0,,Гуааах
Dialogue: 0,1:26:48.11,1:26:49.45,Default,,0,0,0,,Ммм
Dialogue: 0,1:26:50.12,1:26:51.08,Default,,0,0,0,,Әй!
Dialogue: 0,1:26:51.78,1:26:53.29,Default,,0,0,0,,Сәлем Хаттори!
Dialogue: 0,1:26:56.83,1:26:59.75,Default,,0,0,0,,Кешіріңіз, бірақ мен мұны шешуім керек, ақымақ.
Dialogue: 0,1:26:59.83,1:27:01.88,Default,,0,0,0,,Мен бұл мүмкіндікті пайдаланамын!
Dialogue: 0,1:27:02.59,1:27:04.63,Default,,0,0,0,,О, оны маған қалдырыңыз.
Dialogue: 0,1:27:15.31,1:27:18.35,Default,,0,0,0,,Осы қарқынмен мен жете алмаймын!
Dialogue: 0,1:27:18.44,1:27:21.81,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,1:27:37.08,1:27:38.25,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:39.08,1:27:41.58,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:27:45.17,1:27:47.84,Default,,0,0,0,,Хэйдзи Хаттори! Сіз бұл жерді қайдан білдіңіз?
Dialogue: 0,1:27:48.55,1:27:51.59,Default,,0,0,0,,Ха! Мен велосипедіме таратқыш орнаттым!
Dialogue: 0,1:27:51.68,1:27:52.97,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:27:58.52,1:27:59.35,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:28:00.02,1:28:01.35,Default,,0,0,0,,Гах...
Dialogue: 0,1:28:01.44,1:28:02.31,Default,,0,0,0,,Әй!
Dialogue: 0,1:28:09.49,1:28:11.24,Default,,0,0,0,,- (Иори) Ханым - (Момия) А?
Dialogue: 0,1:28:11.32,1:28:15.16,Default,,0,0,0,,Хакодате ауруханасында көлік жарылғанға ұқсайды.
Dialogue: 0,1:28:15.24,1:28:18.41,Default,,0,0,0,,Осыған ұқсас басқа ескертулер де болды.
Dialogue: 0,1:28:18.50,1:28:21.00,Default,,0,0,0,,Бұл қандай сұмдық болса керек.
Dialogue: 0,1:28:22.00,1:28:26.05,Default,,0,0,0,,Егер сен мұны істесең, Хэйдзикун, сен тіпті мойындай алмайсың.
Dialogue: 0,1:28:26.59,1:28:30.93,Default,,0,0,0,,Иә? Ол әрқашан Хэйдзикунмен бірге...
Dialogue: 0,1:28:32.09,1:28:34.39,Default,,0,0,0,,Жарайды, Иори, қолда.
Dialogue: 0,1:28:34.47,1:28:36.39,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,1:28:50.36,1:28:51.45,Default,,0,0,0,,Уф!
Dialogue: 0,1:28:58.37,1:28:59.66,Default,,0,0,0,,Уф...
Dialogue: 0,1:29:07.75,1:29:08.80,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,1:29:11.92,1:29:13.18,Default,,0,0,0,,Сәлем, бар!
Dialogue: 0,1:29:14.80,1:29:16.18,Default,,0,0,0,,Уф!
Dialogue: 0,1:29:17.51,1:29:18.93,Default,,0,0,0,,Әй, бұл бала!
Dialogue: 0,1:29:23.77,1:29:25.44,Default,,0,0,0,,Керемет!
Dialogue: 0,1:29:37.28,1:29:39.12,Default,,0,0,0,,ол немесе сенімге толы қуғыншы,
Dialogue: 0,1:29:45.08,1:29:47.09,Default,,0,0,0,,(Сатушы-ассистент) Енді сізге осы құжаттарға қол қою ғана қалды—
Dialogue: 0,1:29:48.29,1:29:50.71,Default,,0,0,0,,Үлкен мөлшердегі мылтық тиеу!
Dialogue: 0,1:29:50.80,1:29:53.63,Default,,0,0,0,,Хакодате тауында осындай нәрсе жарылып кетсе ше?
Dialogue: 0,1:29:53.72,1:29:54.84,Default,,0,0,0,,Казуха!
Dialogue: 0,1:29:55.80,1:29:57.47,Default,,0,0,0,,Уф!
Dialogue: 0,1:29:59.85,1:30:01.02,Default,,0,0,0,,Хаттори!
Dialogue: 0,1:30:01.10,1:30:03.43,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,1:30:04.10,1:30:05.19,Default,,0,0,0,,Аһ!
Dialogue: 0,1:30:06.40,1:30:07.81,Default,,0,0,0,,Гррр... Не!
Dialogue: 0,1:30:07.90,1:30:10.19,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,1:30:10.27,1:30:11.57,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,1:30:12.49,1:30:15.49,Default,,0,0,0,,Горёкаку ұзақ уақыттан кейін көңілді өтті.
Dialogue: 0,1:30:15.57,1:30:18.07,Default,,0,0,0,,Мен осында болғандықтан өте қуаныштымын.
Dialogue: 0,1:30:18.16,1:30:19.16,Default,,0,0,0,,Окита!
Dialogue: 0,1:30:19.24,1:30:20.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:20.41,1:30:21.91,Default,,0,0,0,,- (Онимару) Мен үйге бара жатырмын - (Окита) А...
Dialogue: 0,1:30:23.16,1:30:24.41,Default,,0,0,0,,Эй
Dialogue: 0,1:30:27.00,1:30:28.42,Default,,0,0,0,,Гахххх...
Dialogue: 0,1:30:30.88,1:30:33.01,Default,,0,0,0,,Ақымақ, сен тоқтамайсың! (шу)
Dialogue: 0,1:30:33.09,1:30:34.01,Default,,0,0,0,,О!
Dialogue: 0,1:30:35.09,1:30:36.55,Default,,0,0,0,,Тұрақты!
Dialogue: 0,1:30:48.98,1:30:50.94,Default,,0,0,0,,Енді не болады? Уф!
Dialogue: 0,1:30:51.69,1:30:54.61,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,1:30:55.40,1:30:56.32,Default,,0,0,0,,Уф...
Dialogue: 0,1:31:01.74,1:31:03.08,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,1:31:03.16,1:31:05.58,Default,,0,0,0,,Жаңа ғана үлкен отшашу атылды, солай ма?
Dialogue: 0,1:31:05.66,1:31:07.25,Default,,0,0,0,,Ақылымның арқасында Менің ақылымның арқасында
Dialogue: 0,1:31:07.33,1:31:09.00,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:31:09.58,1:31:10.54,Default,,0,0,0,,Гах...
Dialogue: 0,1:31:10.63,1:31:13.34,Default,,0,0,0,,Неліктен бұл бала бірінші болды...
Dialogue: 0,1:31:14.21,1:31:15.63,Default,,0,0,0,,Әй!
Dialogue: 0,1:31:16.67,1:31:17.80,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:31:18.38,1:31:20.26,Default,,0,0,0,,Не?! Һмм…
Dialogue: 0,1:31:21.72,1:31:25.18,Default,,0,0,0,,Сіз қандайсыз?!
Dialogue: 0,1:31:27.48,1:31:28.31,Default,,0,0,0,,- (Рёэй) Та! -Хмм...
Dialogue: 0,1:31:29.15,1:31:29.98,Default,,0,0,0,,Ga!
Dialogue: 0,1:31:34.73,1:31:37.45,Default,,0,0,0,,Бастыққа тым жақындамаңыз!
Dialogue: 0,1:31:37.53,1:31:38.53,Default,,0,0,0,,Уф...
Dialogue: 0,1:31:39.45,1:31:40.57,Default,,0,0,0,,Хмм.
Dialogue: 0,1:31:40.66,1:31:42.49,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,1:31:45.41,1:31:49.17,Default,,0,0,0,,Ауырып қалсаң да өзің сияқты.
Dialogue: 0,1:31:50.00,1:31:53.42,Default,,0,0,0,,Сен адвокат Кугакиді өлтіргенсің ғой.
Dialogue: 0,1:31:54.05,1:31:55.92,Default,,0,0,0,,Райо Фукуджо
Dialogue: 0,1:31:56.01,1:32:00.05,Default,,0,0,0,,Менің қылыштанғандығымды көру үшін әдейі соққыға жығылғандай болып тұрсың ба?
Dialogue: 0,1:32:00.13,1:32:00.97,Default,,0,0,0,,Иә
Dialogue: 0,1:32:01.05,1:32:03.97,Default,,0,0,0,,Бірақ мен Иайдо туралы білімім бар.
Dialogue: 0,1:32:04.06,1:32:06.18,Default,,0,0,0,,Әулиеден басқа ешкім білмеуі керек.
Dialogue: 0,1:32:06.27,1:32:09.23,Default,,0,0,0,,Иайдомен айналысатын адамдар бұл бөлікті жиі кесіп тастайды, солай ма?
Dialogue: 0,1:32:09.81,1:32:12.73,Default,,0,0,0,,Дәрі-дәрмекті ішкенде, көзіме түсті.
Dialogue: 0,1:32:14.23,1:32:17.49,Default,,0,0,0,,Я, бұл тамаша бақылаушы көз.
Dialogue: 0,1:32:18.19,1:32:22.62,Default,,0,0,0,,Әйтеуір, Боуес, сен кімсің?
Dialogue: 0,1:32:22.70,1:32:24.91,Default,,0,0,0,,Конан Эдогава
Dialogue: 0,1:32:24.99,1:32:26.87,Default,,0,0,0,,Детектив
Dialogue: 0,1:32:30.46,1:32:31.79,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:32:31.87,1:32:34.88,Default,,0,0,0,,Осы жарылғышпен барлық қазынаны жоюды жоспарлап отырсыз ба?
Dialogue: 0,1:32:34.96,1:32:37.88,Default,,0,0,0,,Әкемнің наным-сенімін осылай мұраға қалдырдым!
Dialogue: 0,1:32:37.96,1:32:39.88,Default,,0,0,0,,Сенім дегеніміз не?
Dialogue: 0,1:32:39.97,1:32:41.59,Default,,0,0,0,,Әкеңнен бөлексің!
Dialogue: 0,1:32:41.68,1:32:43.89,Default,,0,0,0,,Мұны істеудің қандай қажеттілігі бар?
Dialogue: 0,1:32:45.14,1:32:48.02,Default,,0,0,0,,Анам майданға дәрігер болып аттанған.
Dialogue: 0,1:32:48.10,1:32:49.39,Default,,0,0,0,,сонда қайтыс болды
Dialogue: 0,1:32:49.98,1:32:52.94,Default,,0,0,0,,Балаларды жаудың бомбалауынан қорғауға тырысу!
Dialogue: 0,1:32:54.27,1:32:58.94,Default,,0,0,0,,Қару адамды жояды, ақша адамды жаман етеді!
Dialogue: 0,1:32:59.53,1:33:01.07,Default,,0,0,0,,Сіздің арманыңыз рас па?
Dialogue: 0,1:33:01.65,1:33:05.07,Default,,0,0,0,,Ана жолын қуып, дәрігер болу басқа емес пе?
Dialogue: 0,1:33:06.99,1:33:08.49,Default,,0,0,0,,Мен ұмытып кетіппін
Dialogue: 0,1:33:09.37,1:33:10.87,Default,,0,0,0,,Ұмытпа
Dialogue: 0,1:33:11.75,1:33:13.04,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:33:17.04,1:33:18.75,Default,,0,0,0,,Науқастан қайтыс болған Тадаюки
Dialogue: 0,1:33:19.34,1:33:24.14,Default,,0,0,0,,Менің әкем Кейзабуро мырза сізге жасырылған қазынаны басқаруды тапсырды.
Dialogue: 0,1:33:24.22,1:33:28.18,Default,,0,0,0,,Эйрю Хигашикубо туралы ақпаратты таратқан сен едің ғой?
Dialogue: 0,1:33:28.26,1:33:29.89,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,1:33:29.97,1:33:34.31,Default,,0,0,0,,Хигашикубоның аты тек Тадаюкиде болған ақпарат болды.
Dialogue: 0,1:33:34.40,1:33:38.15,Default,,0,0,0,,Күтілгендей, Такузо мен Кадокура пайда болды.
Dialogue: 0,1:33:38.23,1:33:39.90,Default,,0,0,0,,Шайқас басталды
Dialogue: 0,1:33:39.98,1:33:44.41,Default,,0,0,0,,Сіздің мақсатыңыз оларға қазынаны табу болды.
Dialogue: 0,1:33:44.99,1:33:49.08,Default,,0,0,0,,Менде де шыдамайтын денем бар, Бір ғана арқа сүйер адамым – Әулие.
Dialogue: 0,1:33:49.16,1:33:52.75,Default,,0,0,0,,Қазынаны өз бетімше табу мүмкін емес еді.
Dialogue: 0,1:33:53.37,1:33:55.67,Default,,0,0,0,,Адвокат Кугакиді кім өлтірді?
Dialogue: 0,1:33:56.29,1:33:59.75,Default,,0,0,0,,Бұл сіздің ұлыңыз Хиджириді полициядан жасыру, солай ма?
Dialogue: 0,1:33:59.84,1:34:03.55,Default,,0,0,0,,Кадокралар ақыры маған назар аударады.
Dialogue: 0,1:34:03.63,1:34:06.43,Default,,0,0,0,,Ол кезде бірінші нысана Қасиетті.
Dialogue: 0,1:34:06.51,1:34:09.10,Default,,0,0,0,,Сол себепті мен баламды Нұрегіне киіндірдім.
Dialogue: 0,1:34:09.18,1:34:11.81,Default,,0,0,0,,Мен жауап алғаныма көз жеткіздім.
Dialogue: 0,1:34:11.89,1:34:15.81,Default,,0,0,0,,Сіздің ұлыңызға полицияда ешкім тиісе алмайды.
Dialogue: 0,1:34:15.90,1:34:20.27,Default,,0,0,0,,Қаптаманы ауыстырып, оған жәбірленушінің саусақ іздерін салып, жалған айғақтар жасады.
Dialogue: 0,1:34:20.36,1:34:24.57,Default,,0,0,0,,Бірақ мұндай нәрсе үшін біреудің өмірін қию!
Dialogue: 0,1:34:24.65,1:34:26.70,Default,,0,0,0,,Жұмыс берушіге опасыздық жасау
Dialogue: 0,1:34:26.78,1:34:30.28,Default,,0,0,0,,Бұл Кадокураға қылыш сатпақ болған адам.
Dialogue: 0,1:34:30.37,1:34:32.33,Default,,0,0,0,,Аяуға лайық емес
Dialogue: 0,1:34:32.91,1:34:35.50,Default,,0,0,0,,Кугакиді өлтіргеннен кейін ұрлаған қылыш
Dialogue: 0,1:34:35.58,1:34:37.83,Default,,0,0,0,,Кадокураға әдейі жіберілді
Dialogue: 0,1:34:37.92,1:34:40.13,Default,,0,0,0,,Олар қазынаны қайдан тапты
Dialogue: 0,1:34:40.21,1:34:42.76,Default,,0,0,0,,Мен бәрін өшіруді жоспарладым, бірақ...
Dialogue: 0,1:34:42.84,1:34:44.84,Default,,0,0,0,,Кидке шабуыл жасаған сен болдың ғой?
Dialogue: 0,1:34:45.51,1:34:48.55,Default,,0,0,0,,Өйткені Кугакиден алынған қылышқа таратқыш орнатылған.
Dialogue: 0,1:34:48.64,1:34:50.18,Default,,0,0,0,,Мен сізге еріп жүре аламын
Dialogue: 0,1:34:50.26,1:34:52.81,Default,,0,0,0,,Сіз де көлік жүргізе аласыз.
Dialogue: 0,1:34:53.68,1:34:55.60,Default,,0,0,0,,Сіз соншалықты қайдан білдіңіз?
Dialogue: 0,1:34:56.19,1:34:59.65,Default,,0,0,0,,Тадаюки аяғының жарақатына байланысты таяғын жібере алмады.
Dialogue: 0,1:34:59.73,1:35:01.61,Default,,0,0,0,,Мұны айтқан сіз едіңіз.
Dialogue: 0,1:35:02.19,1:35:05.49,Default,,0,0,0,,Тадаюки мырза, көлік жүргізе алмау керек еді,
Dialogue: 0,1:35:05.57,1:35:08.49,Default,,0,0,0,,Неліктен барлық жерге бара алдың?
Dialogue: 0,1:35:08.57,1:35:10.49,Default,,0,0,0,,Жүргізуші болды.
Dialogue: 0,1:35:10.57,1:35:15.00,Default,,0,0,0,,Тадаюки-санның жалғыз серіктесі, яғни сен.
Dialogue: 0,1:35:16.33,1:35:17.42,Default,,0,0,0,,Иә
Dialogue: 0,1:35:17.50,1:35:22.09,Default,,0,0,0,,Балалар, сіздердің және біртүрлі елес ұрылардың араласуы күтпеген еді.
Dialogue: 0,1:35:22.17,1:35:24.80,Default,,0,0,0,,Бірақ нәтиже өзгеріссіз қалады.
Dialogue: 0,1:35:24.88,1:35:27.93,Default,,0,0,0,,Бұл дүниеден қазыналар отқа оранған —
Dialogue: 0,1:35:28.43,1:35:29.26,Default,,0,0,0,,жоғалады
Dialogue: 0,1:35:31.60,1:35:32.89,Default,,0,0,0,,Уф!
Dialogue: 0,1:35:32.97,1:35:35.35,Default,,0,0,0,,Жалынмен өртенген...
Dialogue: 0,1:35:35.43,1:35:36.68,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,1:35:37.60,1:35:39.73,Default,,0,0,0,,Ууууууу!
Dialogue: 0,1:35:51.57,1:35:52.74,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:53.33,1:35:54.66,Default,,0,0,0,,Ой…
Dialogue: 0,1:35:59.17,1:36:00.46,Default,,0,0,0,,Уау!
Dialogue: 0,1:36:00.54,1:36:01.71,Default,,0,0,0,,Хаттори!
Dialogue: 0,1:36:01.79,1:36:03.21,Default,,0,0,0,,Ха!
Dialogue: 0,1:36:04.00,1:36:05.34,Default,,0,0,0,,Гррр…
Dialogue: 0,1:36:06.80,1:36:08.13,Default,,0,0,0,,Уф... аа!
Dialogue: 0,1:36:09.01,1:36:12.60,Default,,0,0,0,,Казуха!
Dialogue: 0,1:36:12.68,1:36:14.14,Default,,0,0,0,,Ki…
Dialogue: 0,1:36:14.22,1:36:15.39,Default,,0,0,0,,Бала!
Dialogue: 0,1:36:15.97,1:36:17.39,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,1:36:17.48,1:36:19.56,Default,,0,0,0,,Батыстың детективі
Dialogue: 0,1:36:19.64,1:36:20.94,Default,,0,0,0,,Уау!
Dialogue: 0,1:36:26.48,1:36:27.90,Default,,0,0,0,,Сол тауда
Dialogue: 0,1:36:27.99,1:36:30.86,Default,,0,0,0,,Сіз үшін маңызды біреу болуы керек!
Dialogue: 0,1:36:36.29,1:36:39.79,Default,,0,0,0,,Осымен сүйіспеншіліктің қарызы жойылады.
Dialogue: 0,1:36:41.96,1:36:43.17,Default,,0,0,0,,Ах...
Dialogue: 0,1:36:45.63,1:36:46.88,Default,,0,0,0,,Хмм...
Dialogue: 0,1:36:51.13,1:36:54.80,Default,,0,0,0,,Келме, Хэйдзи. Бірдеңе дұрыс емес пе?
Dialogue: 0,1:36:55.60,1:36:57.31,Default,,0,0,0,,- (Жүгіріп) Әй, бұл не? - (Қазуба) А?
Dialogue: 0,1:36:58.27,1:37:00.31,Default,,0,0,0,,Бұл ұшақ па?
Dialogue: 0,1:37:04.15,1:37:05.81,Default,,0,0,0,,Хаха...
Dialogue: 0,1:37:06.40,1:37:07.82,Default,,0,0,0,,Хаха...
Dialogue: 0,1:37:09.19,1:37:10.40,Default,,0,0,0,,Фу…
Dialogue: 0,1:37:21.21,1:37:22.08,Default,,0,0,0,,Уф...
Dialogue: 0,1:37:23.67,1:37:25.00,Default,,0,0,0,,Ах!
Dialogue: 0,1:37:25.58,1:37:26.50,Default,,0,0,0,,Аһ!
Dialogue: 0,1:37:29.92,1:37:30.76,Default,,0,0,0,,Эй!
Dialogue: 0,1:37:31.34,1:37:32.76,Default,,0,0,0,,Оян!
Dialogue: 0,1:37:33.51,1:37:37.30,Default,,0,0,0,,Қарғыс атсын! Арх... қозғал!
Dialogue: 0,1:37:37.39,1:37:38.68,Default,,0,0,0,,Сәлем! Оян!
Dialogue: 0,1:37:38.76,1:37:40.56,Default,,0,0,0,,Иә, бірдеңе істейік...
Dialogue: 0,1:37:43.39,1:37:44.31,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:45.44,1:37:46.73,Default,,0,0,0,,Не~!? (Официант) Бұл – «Ой-Пи», көріп тұрсыз ба.
Dialogue: 0,1:38:00.20,1:38:01.62,Default,,0,0,0,,- (Жүгіріп) Не? - (Қазуба) Не істеп жатырсың?
Dialogue: 0,1:38:01.70,1:38:05.21,Default,,0,0,0,,Cessna тауға соғылды! Барлығы қашады!
Dialogue: 0,1:38:05.29,1:38:08.38,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:38:08.46,1:38:10.30,Default,,0,0,0,,Қасиетті!
Dialogue: 0,1:38:12.72,1:38:13.80,Default,,0,0,0,,Жарайды
Dialogue: 0,1:38:13.88,1:38:15.80,Default,,0,0,0,,Хиджири жақсы сияқты.
Dialogue: 0,1:38:16.39,1:38:17.55,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:38:17.64,1:38:19.05,Default,,0,0,0,,Ха…
Dialogue: 0,1:38:19.14,1:38:21.06,Default,,0,0,0,,Фу…
Dialogue: 0,1:38:21.14,1:38:23.27,Default,,0,0,0,,Та… қазына
Dialogue: 0,1:38:23.35,1:38:24.81,Default,,0,0,0,,Бұл менің қазынам
Dialogue: 0,1:38:24.89,1:38:27.15,Default,,0,0,0,,Оны ешкімге бермеңіз!
Dialogue: 0,1:38:27.23,1:38:28.65,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:38:31.23,1:38:32.48,Default,,0,0,0,,Уф...
Dialogue: 0,1:38:37.11,1:38:38.16,Default,,0,0,0,,Иә
Dialogue: 0,1:38:46.33,1:38:47.17,Default,,0,0,0,,…және
Dialogue: 0,1:38:47.25,1:38:49.92,Default,,0,0,0,,Хакодате тауы бір кездері әскери нысан ретінде пайдаланылған.
Dialogue: 0,1:38:50.00,1:38:52.67,Default,,0,0,0,,Қарапайым халық тауға кіре алмайтын жер болса керек.
Dialogue: 0,1:38:53.30,1:38:55.67,Default,,0,0,0,,Міне, осындай нәрсе...
Dialogue: 0,1:38:58.26,1:38:59.30,Default,,0,0,0,,Ах...
Dialogue: 0,1:39:04.60,1:39:07.44,Default,,0,0,0,,Эй, Изуна.
Dialogue: 0,1:39:07.52,1:39:09.86,Default,,0,0,0,,сені Нью-Йоркке қайта апару үшін.
Dialogue: 0,1:39:15.24,1:39:17.36,Default,,0,0,0,,Бұл ескі шифрлау машинасы.
Dialogue: 0,1:39:17.95,1:39:19.37,Default,,0,0,0,,Шифрлау машинасы?
Dialogue: 0,1:39:19.45,1:39:22.49,Default,,0,0,0,,Соғыс кезінде қолданылған атақты
Dialogue: 0,1:39:23.08,1:39:26.54,Default,,0,0,0,,Бұл жапондық стильде жетілдірілген прототип емес пе?
Dialogue: 0,1:39:26.62,1:39:29.75,Default,,0,0,0,,Ал оның айналасына кодты бұзатын машиналар тізіліп тұр
Dialogue: 0,1:39:29.83,1:39:33.59,Default,,0,0,0,,Кейзабуро Акое айтып отырған «қазынаның» шынайы табиғаты
Dialogue: 0,1:39:33.67,1:39:37.76,Default,,0,0,0,,Соғыс кезінде бұл әртүрлі елдердің кодтарын шешу үшін пайдаланылды деп ойлаймын...
Dialogue: 0,1:39:37.84,1:39:41.80,Default,,0,0,0,,Менің ойымша, олар жеңіліске ұшыраған жағдайда реквизицияланбау үшін оны жасырған.
Dialogue: 0,1:39:41.89,1:39:44.01,Default,,0,0,0,,Енді ол пайдалы емес.
Dialogue: 0,1:39:44.10,1:39:47.52,Default,,0,0,0,,Бұл бір машина әлдеқайда жақсырақ.
Dialogue: 0,1:39:49.65,1:39:53.27,Default,,0,0,0,,Бұл… осындай нәрсе үшін…
Dialogue: 0,1:39:53.36,1:39:57.19,Default,,0,0,0,,Осы себепті біз...
Dialogue: 0,1:39:58.24,1:40:02.16,Default,,0,0,0,,(Рёидің жылағаны)
Dialogue: 0,1:40:03.62,1:40:07.75,Default,,0,0,0,,-де? Сіз іздеген жауапты таптыңыз ба?
Dialogue: 0,1:40:07.83,1:40:09.29,Default,,0,0,0,,Мен таптым
Dialogue: 0,1:40:09.96,1:40:12.92,Default,,0,0,0,,Мен оны таптым, бірақ ұрлаған жоқпын, солай ма?
Dialogue: 0,1:40:14.34,1:40:15.42,Default,,0,0,0,,Әке
Dialogue: 0,1:40:18.72,1:40:20.43,Default,,0,0,0,,- (Кавазоэ) Инспектор! - (Нишимура) А?
Dialogue: 0,1:40:21.18,1:40:22.68,Default,,0,0,0,,Инспектор Нишимура!
Dialogue: 0,1:40:22.76,1:40:24.43,Default,,0,0,0,,- (Когоро) Ой... - (Нишимура) Эй, Кавазоэ!
Dialogue: 0,1:40:24.51,1:40:26.22,Default,,0,0,0,,Машина! (Соқтығыс дыбысы)
Dialogue: 0,1:40:26.31,1:40:29.14,Default,,0,0,0,,Ах, мен мұны қайталадым.
Dialogue: 0,1:40:29.23,1:40:30.06,Default,,0,0,0,,Инспектор!
Dialogue: 0,1:40:30.64,1:40:33.31,Default,,0,0,0,,Каникулдан қайтқанда, қатты шу болды.
Dialogue: 0,1:40:33.40,1:40:34.48,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,1:40:34.57,1:40:35.65,Default,,0,0,0,,Не болды?
Dialogue: 0,1:40:35.73,1:40:37.07,Default,,0,0,0,,Демалыс туралы не деуге болады?
Dialogue: 0,1:40:37.15,1:40:39.86,Default,,0,0,0,,Иә, сауда ауданындағы лотереяда.
Dialogue: 0,1:40:39.95,1:40:43.32,Default,,0,0,0,,Мен 3 күн 2 түн жұмбақ турда ұттым.
Dialogue: 0,1:40:43.41,1:40:46.91,Default,,0,0,0,,Тур кезінде смартфондарды да өшіру керек.
Dialogue: 0,1:40:46.99,1:40:48.25,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,1:40:48.33,1:40:49.20,Default,,0,0,0,,Ах!
Dialogue: 0,1:40:49.96,1:40:52.83,Default,,0,0,0,,Сонда осы уақыт бойы менімен бірге болған Кавазоэ ше...
Dialogue: 0,1:40:54.92,1:40:56.84,Default,,0,0,0,,Парашют!
Dialogue: 0,1:41:00.92,1:41:03.72,Default,,0,0,0,,Уау, Хэйдзи аспаннан құлады!
Dialogue: 0,1:41:05.80,1:41:08.31,Default,,0,0,0,,Керемет! Бұл таңқаларлық, Хаттори-кун.
Dialogue: 0,1:41:08.39,1:41:11.48,Default,,0,0,0,,Ол көктен түскен ханзадаға ұқсайды!
Dialogue: 0,1:41:16.02,1:41:17.32,Default,,0,0,0,,Хэйдзи!
Dialogue: 0,1:41:17.40,1:41:19.32,Default,,0,0,0,,Иә? Казуха!
Dialogue: 0,1:41:21.90,1:41:23.70,Default,,0,0,0,,Ух... (Қылыш үні)
Dialogue: 0,1:41:24.53,1:41:26.49,Default,,0,0,0,,Ах! Хиджири-сан, не болды?
Dialogue: 0,1:41:26.58,1:41:28.45,Default,,0,0,0,,О, мен саған шынымен қамқор болуым керек.
Dialogue: 0,1:41:29.58,1:41:31.12,Default,,0,0,0,,Гамба!
Dialogue: 0,1:41:31.21,1:41:32.87,Default,,0,0,0,,- (Қазуба) А? -(Хедзи) А...
Dialogue: 0,1:41:33.58,1:41:35.38,Default,,0,0,0,,Хэйдзи, сен не істеп жүрсің?
Dialogue: 0,1:41:35.46,1:41:37.13,Default,,0,0,0,,Сіз уайымдайсыз ба?
Dialogue: 0,1:41:37.21,1:41:38.09,Default,,0,0,0,,Нашар
Dialogue: 0,1:41:38.17,1:41:40.09,Default,,0,0,0,,Бұл мен күткеннен де көп уақытты алды.
Dialogue: 0,1:41:40.17,1:41:42.88,Default,,0,0,0,,- (Хедзи) Сонымен... Сонымен... - (Казуба) Хэйдзи! Мұнда кел
Dialogue: 0,1:41:42.97,1:41:46.60,Default,,0,0,0,,Жоғарыдан көрінетін түнгі көрініс сондай әдемі.
Dialogue: 0,1:41:46.68,1:41:47.89,Default,,0,0,0,,Сәлем Казуха...
Dialogue: 0,1:41:50.85,1:41:52.39,Default,,0,0,0,,Не? Әдемі емес пе?
Dialogue: 0,1:41:53.23,1:41:55.77,Default,,0,0,0,,Мен оны Хэйдзиге де көрсетемін деп ойладым.
Dialogue: 0,1:41:57.48,1:41:58.40,Default,,0,0,0,,Хэйдзи?
Dialogue: 0,1:41:59.98,1:42:00.90,Default,,0,0,0,,Казуха
Dialogue: 0,1:42:02.99,1:42:05.74,Default,,0,0,0,,Негізінен тазартылған сияқты.
Dialogue: 0,1:42:05.82,1:42:07.91,Default,,0,0,0,,Бұл не? ол
Dialogue: 0,1:42:07.99,1:42:10.70,Default,,0,0,0,,Толтырғыш граната перделері
Dialogue: 0,1:42:10.79,1:42:12.70,Default,,0,0,0,,Мұнда түйреуіш... (Желдің екпіні)
Dialogue: 0,1:42:14.29,1:42:15.71,Default,,0,0,0,,Ах...
Dialogue: 0,1:42:18.63,1:42:20.21,Default,,0,0,0,,Казуха! (құлап түскен дыбыс)
Dialogue: 0,1:42:21.42,1:42:22.42,Default,,0,0,0,,Иә?
Dialogue: 0,1:42:22.51,1:42:23.76,Default,,0,0,0,,Иә?
Dialogue: 0,1:42:23.84,1:42:25.22,Default,,0,0,0,,Бейшара Хэйдзи!
Dialogue: 0,1:42:25.80,1:42:26.89,Default,,0,0,0,,Ах...
Dialogue: 0,1:42:26.97,1:42:28.47,Default,,0,0,0,,Ах!
Dialogue: 0,1:42:28.55,1:42:30.47,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,1:42:38.94,1:42:40.61,Default,,0,0,0,,Сәлем Казуха
Dialogue: 0,1:42:40.69,1:42:42.86,Default,,0,0,0,,Барыңды істе, Казуха!
Dialogue: 0,1:42:42.94,1:42:44.24,Default,,0,0,0,,Хмм...
Dialogue: 0,1:42:46.36,1:42:47.61,Default,,0,0,0,,Хэйдзи…
Dialogue: 0,1:42:48.12,1:42:49.83,Default,,0,0,0,,Мен қақпаны бұзып өттім дедің—дәл қазір де, қазір де, солай емес пе?
Dialogue: 0,1:42:49.91,1:42:51.12,Default,,0,0,0,,Казуха!
Dialogue: 0,1:42:54.83,1:42:56.33,Default,,0,0,0,,Сәлем Казуха
Dialogue: 0,1:42:56.42,1:42:57.79,Default,,0,0,0,,Адамдар үшін емес
Dialogue: 0,1:42:57.88,1:43:00.13,Default,,0,0,0,,Жалпы мотив бар.
Dialogue: 0,1:43:00.21,1:43:03.26,Default,,0,0,0,,адамның сол адамды өлтіру мотиві
Dialogue: 0,1:43:03.34,1:43:06.01,Default,,0,0,0,,Адамдардың сол арманға ұмтылу себебі
Dialogue: 0,1:43:06.68,1:43:07.51,Default,,0,0,0,,Хонде
Dialogue: 0,1:43:08.22,1:43:11.51,Default,,0,0,0,,Біреудің сол адамға ғашық болу себебі
Dialogue: 0,1:43:12.10,1:43:16.18,Default,,0,0,0,,Мен детективпін, бірақ себебін түсіндіре алмаймын.
Dialogue: 0,1:43:16.27,1:43:20.02,Default,,0,0,0,,Бұл керемет емес, бірақ маған қатты ұнайды...
Dialogue: 0,1:43:20.11,1:43:21.52,Default,,0,0,0,,Мен көмектесе алмаймын
Dialogue: 0,1:43:22.27,1:43:23.73,Default,,0,0,0,,Казуха
Dialogue: 0,1:43:23.82,1:43:25.78,Default,,0,0,0,,Сіз туралы!
Dialogue: 0,1:43:25.86,1:43:29.78,Default,,0,0,0,,♪~
Dialogue: 0,1:47:39.36,1:47:44.37,Default,,0,0,0,,~♪
Dialogue: 0,1:47:46.00,1:47:47.12,Default,,0,0,0,,Эй
Dialogue: 0,1:47:47.21,1:47:49.37,Default,,0,0,0,,Казуха, бірдеңе айт
Dialogue: 0,1:47:49.46,1:47:51.38,Default,,0,0,0,,Казуха!
Dialogue: 0,1:47:51.46,1:47:54.30,Default,,0,0,0,,Кешіріңіз Хэйдзи! Жаңа ғана не айттыңыз?
Dialogue: 0,1:47:54.38,1:47:56.13,Default,,0,0,0,,- Ал (Хедзи) ше? -(Жүгіріп) Иә...
Dialogue: 0,1:47:56.21,1:47:59.38,Default,,0,0,0,,Бұрынғы жарылыс туралы ештеңе естіген жоқпын.
Dialogue: 0,1:47:59.47,1:48:02.18,Default,,0,0,0,,Жарқырап тұрғаны сонша, жылауымды тоқтата алмаймын
Dialogue: 0,1:48:02.26,1:48:04.76,Default,,0,0,0,,Бұл таң қалдыратын гранатаның кесірінен.
Dialogue: 0,1:48:04.85,1:48:07.64,Default,,0,0,0,,Оны жайына қалдырсам, сауығып кетеді...
Dialogue: 0,1:48:08.56,1:48:11.56,Default,,0,0,0,,Сұрау біртүрлі болды ма?
Dialogue: 0,1:48:11.65,1:48:14.65,Default,,0,0,0,,(«Кайдың» тауда жаңғырық дауысы)
Dialogue: 0,1:48:14.73,1:48:18.28,Default,,0,0,0,,Неге екенін білмеймін, бірақ жарақат алған адамдар болмауы керек деп ойлаймын.
Dialogue: 0,1:48:18.36,1:48:19.65,Default,,0,0,0,,Iori шығару
Dialogue: 0,1:48:19.74,1:48:22.16,Default,,0,0,0,,Жарайсың, жас ханым.
Dialogue: 0,1:48:22.24,1:48:26.66,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,1:48:26.75,1:48:28.66,Default,,0,0,0,,Иә, аға?
Dialogue: 0,1:48:28.75,1:48:30.92,Default,,0,0,0,,Юсакудың інілері болды ма?
Dialogue: 0,1:48:31.00,1:48:35.92,Default,,0,0,0,,Әй, ата-анам мен жас кезімде ажырасып кеткен.
Dialogue: 0,1:48:36.00,1:48:38.34,Default,,0,0,0,,Мені анам қабылдады.
Dialogue: 0,1:48:38.42,1:48:41.26,Default,,0,0,0,,Егіз ағамды әкем алып кеткен...
Dialogue: 0,1:48:41.34,1:48:42.43,Default,,0,0,0,,Маған айтпадың ба?
Dialogue: 0,1:48:43.51,1:48:45.35,Default,,0,0,0,,Мен оны бірінші рет естіп тұрмын!
Dialogue: 0,1:48:45.43,1:48:47.81,Default,,0,0,0,,Не? Сіз әлі кездесесіз бе?
Dialogue: 0,1:48:47.89,1:48:51.19,Default,,0,0,0,,Хмм, мен сені көрмегеніме 20 жылдан асты.
Dialogue: 0,1:48:51.27,1:48:53.56,Default,,0,0,0,,Қызық, сіз бұрын кездестірдіңіз бе?
Dialogue: 0,1:48:53.65,1:48:55.94,Default,,0,0,0,,Өтірік! Ол кім?
Dialogue: 0,1:48:56.02,1:49:00.11,Default,,0,0,0,,Ол Юсакумен құрдас, сондықтан Когоро-чан болуы мүмкін емес...
Dialogue: 0,1:49:01.07,1:49:03.70,Default,,0,0,0,,Кейде олар маған сыйлықтар береді
Dialogue: 0,1:49:03.78,1:49:06.12,Default,,0,0,0,,Келесі күні мен Макадами марапаттарын тойлауға бардым.
Dialogue: 0,1:49:06.20,1:49:07.91,Default,,0,0,0,,Ол маған ескі қылыш жіберді.
Dialogue: 0,1:49:07.99,1:49:10.25,Default,,0,0,0,,Қылыш? Хмм...
Dialogue: 0,1:49:10.33,1:49:11.16,Default,,0,0,0,,Ах!
Dialogue: 0,1:49:11.25,1:49:13.92,Default,,0,0,0,,Бұл шұңқырда көрсетіледі.
Dialogue: 0,1:49:14.00,1:49:15.59,Default,,0,0,0,,Өйткені ол тот басқан және шықпайды
Dialogue: 0,1:49:15.67,1:49:19.30,Default,,0,0,0,,Арқаны тырнауға өте ыңғайлы, солай емес пе? Ахахха
Dialogue: 0,1:49:19.38,1:49:22.97,Default,,0,0,0,,Хаха... Одан да "Түнгі барон сериясының" соңғы туындысы.
Dialogue: 0,1:49:22.97,1:49:23.51,Default,,0,0,0,,Хаха... Одан да "Түнгі барон сериясының" соңғы туындысы.
Dialogue: 0,1:49:22.97,1:49:23.51,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:49:23.51,1:49:23.59,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:49:23.59,1:49:25.30,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:49:23.59,1:49:25.30,Default,,0,0,0,,Сіз маған ойыңызды айта аласыз ба?
Dialogue: 0,1:49:25.39,1:49:26.30,Default,,0,0,0,,Сіз оны оқыдыңыз, солай ма?
Dialogue: 0,1:49:28.10,1:49:29.06,Default,,0,0,0,,Иә
Dialogue: 0,1:49:32.44,1:49:35.06,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:49:37.65,1:49:38.98,Default,,0,0,0,,Хехе
Dialogue: 0,1:49:52.46,1:49:53.50,Default,,0,0,0,,Иә
Dialogue: 0,1:49:55.00,1:50:01.00,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory