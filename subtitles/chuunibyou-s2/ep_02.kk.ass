Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:05.00,ZZ,,0,0,0,,Бұл субтитр білім беру және алмасу үшін пайдалануға арналған,коммерциялық пайдалануға тыйым салынған құдай субтитрлерінің тіркесімі болып табылады.
Dialogue: 0,0:00:05.00,0:00:10.00,ZZ,,0,0,0,,：& ：& ： ： ： ：
Dialogue: 0,0:01:31.74,0:01:35.66,JPOP,,0,0,0,,Мен ғашық болғым келеді
Dialogue: 0,0:01:48.50,0:01:52.16,JPOP,,0,0,0,,Арманың жалғасын тапсын
Dialogue: 0,0:01:52.60,0:01:58.06,JPOP,,0,0,0,,Уәде берсем де, жүрегім бір жерден қорқады, ауырады
Dialogue: 0,0:01:58.58,0:02:04.08,JPOP,,0,0,0,,Мен жалғыз емес екенімді сенгім келеді
Dialogue: 0,0:02:04.08,0:02:09.68,JPOP,,0,0,0,,Мен сені ойлау арқылы бақыттымын деп айта алмаймын
Dialogue: 0,0:02:09.68,0:02:12.88,JPOP,,0,0,0,,Мен бос сеніммен жүрсем де
Dialogue: 0,0:02:12.96,0:02:19.82,JPOP,,0,0,0,,Күліп, менің батылдығыма айналасың
Dialogue: 0,0:02:19.82,0:02:24.22,JPOP,,0,0,0,,Бір сөзбен әлеміңді өзгерте алсам
Dialogue: 0,0:02:24.38,0:02:30.30,JPOP,,0,0,0,,Екі махаббат дамитыны рас.
Dialogue: 0,0:02:30.30,0:02:35.36,JPOP,,0,0,0,,Мен ойлану арқылы таптым
Dialogue: 0,0:02:35.50,0:02:38.10,JPOP,,0,0,0,,Мен әрқашан сенің жолыңмен жүрдім
Dialogue: 0,0:02:38.10,0:02:42.72,JPOP,,0,0,0,,Мен оны жеткізуге дайын болмасам да
Dialogue: 0,0:02:42.72,0:02:45.12,JPOP,,0,0,0,,Мен сізге шынымды айтқым келеді
Dialogue: 0,0:02:45.12,0:02:48.08,JPOP,,0,0,0,,Менің жүрегім қандай болса, менің даусым жарқырайды
Dialogue: 0,0:02:48.08,0:02:53.90,JPOP,,0,0,0,,дауысты бұзса, ол жаңғырық береді
Dialogue: 0,0:00:01.92,0:00:03.44,JPDB,,0,0,0,,Тоғаши-күннің үйінде
Dialogue: 0,0:00:03.68,0:00:05.56,JPDB,,0,0,0,,Иә, біз бірге тұрамыз.
Dialogue: 0,0:00:05.68,0:00:06.84,JPDB,,0,0,0,,Не істеу керек
Dialogue: 0,0:00:07.42,0:00:08.82,JPDB,,0,0,0,,Мен оны көргім келмейді
Dialogue: 0,0:00:08.96,0:00:11.04,JPDB,,0,0,0,,Бірге тұрудың не керегі бар...
Dialogue: 0,0:00:11.04,0:00:11.80,JPDB,,0,0,0,,Жетеді
Dialogue: 0,0:00:12.20,0:00:14.38,JPDB,,0,0,0,,Ресми келісім-шарттағы шебер
Dialogue: 0,0:00:14.38,0:00:17.62,JPDB,,0,0,0,,Сізге бар болғаны жасырынған жерді Қараңғы жалын шеберімен бөлісу керек.
Dialogue: 0,0:00:18.02,0:00:21.86,JPDB,,0,0,0,,Мен сен ойлағандай шірік өмір сүрмеймін.
Dialogue: 0,0:00:22.04,0:00:23.24,JPDB,,0,0,0,,Дұрыс.
Dialogue: 0,0:00:23.30,0:00:27.22,JPDB,,0,0,0,,Оның үстіне Тоғаши-кун мектепте бұл туралы айтпауымды айтты.
Dialogue: 0,0:00:27.68,0:00:28.90,JPDB,,0,0,0,,Мен білемін.
Dialogue: 0,0:00:29.26,0:00:32.06,JPDB,,0,0,0,,Бірақ біз жоғары сынып оқушыларымыз, ғашықпыз.
Dialogue: 0,0:00:32.28,0:00:34.48,JPDB,,0,0,0,,Екеуі бірге тұрады.
Dialogue: 0,0:00:34.86,0:00:36.40,JPDB,,0,0,0,,Маған бәрібір
Dialogue: 0,0:00:36.40,0:00:39.78,JPDB,,0,0,0,,Маған тек сен сияқты жемқор жалған сиқыршылар ғана көңіл бөледі.
Dialogue: 0,0:00:39.78,0:00:41.62,JPDB,,0,0,0,,Декомори - бос емес өлім
Dialogue: 0,0:00:41.62,0:00:43.14,JPDB,,0,0,0,,Тыныштық, Өлім.
Dialogue: 0,0:00:43.38,0:00:45.14,JPDB,,0,0,0,,Дөңес-чан, сен не істеп жатырсың?
Dialogue: 0,0:00:45.76,0:00:50.94,JPDB,,0,0,0,,Мен шытырман оқиғалы кітап жазып жатырмын.
Dialogue: 0,0:00:51.12,0:00:52.36,JPDB,,0,0,0,,Шытырман оқиғалы кітап
Dialogue: 0,0:00:52.60,0:00:56.28,JPDB,,0,0,0,,Сабақта жоқ сыныптастарыма конспект құрастырып жатырмын.
Dialogue: 0,0:00:56.92,0:00:59.36,JPDB,,0,0,0,,Олай болса, сен осында қал.
Dialogue: 0,0:01:00.34,0:01:02.04,JPDB,,0,0,0,,Күмін-сенпай қызықпайды.
Dialogue: 0,0:01:03.18,0:01:05.46,JPDB,,0,0,0,,Ғашықтар бірге тұрады.
Dialogue: 0,0:01:05.64,0:01:07.86,JPDB,,0,0,0,,Қарашы, егер көзіміз түйісе қалса, көңілім көтерілер еді.
Dialogue: 0,0:01:08.06,0:01:11.26,JPDB,,0,0,0,,Ешкім болмаса, бәлкім, бір-бірімізді сәл құшақтайтын едік.
Dialogue: 0,0:01:11.40,0:01:13.82,JPDB,,0,0,0,,Қарындасым қарамаса, сүйіспеншілік.
Dialogue: 0,0:01:13.94,0:01:15.88,JPDB,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:01:16.20,0:01:18.02,JPDB,,0,0,0,,Дұрыс.
Dialogue: 0,0:01:19.46,0:01:21.12,JPDB,,0,0,0,,Үнсіз өлім
Dialogue: 0,0:01:21.12,0:01:23.74,JPDB,,0,0,0,,Үнсіз өлім Үнсіз өлім Үнсіз өлім
Dialogue: 0,0:01:23.94,0:01:25.40,JPDB,,0,0,0,,Маған өте қызық.
Dialogue: 0,0:01:25.50,0:01:27.00,JPDB,,0,0,0,,Найнайдың өлімі
Dialogue: 0,0:02:57.96,0:02:59.42,JPDB,,0,0,0,,Қараңғылық толқындарынан ба?
Dialogue: 0,0:02:59.50,0:03:03.18,JPDB,,0,0,0,,Шебердің пішіні шөлдің ар жағында, көзге көрінбейтін өлім
Dialogue: 0,0:03:03.96,0:03:06.94,JPDB,,0,0,0,,Мастер Мастер қайда орналасқан?
Dialogue: 0,0:03:06.94,0:03:09.28,JPDB,,0,0,0,,Мен бұл үшін қатты уайымдап отырмын.
Dialogue: 0,0:03:09.42,0:03:12.60,JPDB,,0,0,0,,Жазбаны керемет жылдамдықпен аяқтадыңыз.
Dialogue: 0,0:03:12.94,0:03:15.08,JPDB,,0,0,0,,О, міне, Тоғашы-күн.
Dialogue: 0,0:03:15.54,0:03:17.84,JPDB,,0,0,0,,Шынымен, сен не істеп жатырсың?
Dialogue: 0,0:03:18.48,0:03:20.00,JPDB,,0,0,0,,Сіз желді оқисыз ба?
Dialogue: 0,0:03:20.36,0:03:24.70,JPDB,,0,0,0,,Әлде Өлім қараңғыларға жаңа соғыс жариялап жатыр ма?
Dialogue: 0,0:03:25.76,0:03:29.54,JPDB,,0,0,0,,Менің ойымша, олар кірді алып жатқан шығар.
Dialogue: 0,0:03:30.06,0:03:32.30,JPDB,,0,0,0,,Кешіріңіз, мен оны импорттауды ұмытып кетіппін.
Dialogue: 0,0:03:32.72,0:03:35.42,JPDB,,0,0,0,,Жоқ, Рикка бүгін кезекшілікте болды.
Dialogue: 0,0:03:35.82,0:03:38.30,JPDB,,0,0,0,,Бірақ бәрібір, мен мұны бұрын жасағанмын.
Dialogue: 0,0:03:38.30,0:03:40.92,JPDB,,0,0,0,,Жоқ, оны Рикка бастапқыда ұсынған.
Dialogue: 0,0:03:43.62,0:03:46.86,JPDB,,0,0,0,,Зұлым патша хаос қараңғы кастрюль аяқталды
Dialogue: 0,0:03:47.30,0:03:49.82,JPDB,,0,0,0,,Сіз өзіңізді қара қазан дейсіз бе?
Dialogue: 0,0:03:50.18,0:03:54.52,JPDB,,0,0,0,,Рикка-сан, ертеңнен бастап тамақты маған және ағаңа қалдыр.
Dialogue: 0,0:03:55.16,0:03:56.08,JPDB,,0,0,0,,Түсінді
Dialogue: 0,0:03:57.30,0:04:00.04,JPDB,,0,0,0,,Содан кейін мен басқа миссияларға жауапты боламын.
Dialogue: 0,0:04:00.40,0:04:02.00,JPDB,,0,0,0,,Өйткені мен бұған да мән бермедім.
Dialogue: 0,0:04:02.32,0:04:04.00,JPDB,,0,0,0,,Менің ойымша, бұл баж жүйесіне айналды.
Dialogue: 0,0:04:04.48,0:04:05.06,JPDB,,0,0,0,,Бар ма?
Dialogue: 0,0:04:05.44,0:04:06.88,JPDB,,0,0,0,,Мен жаңа ғана оралдым.
Dialogue: 0,0:04:11.90,0:04:14.12,JPDB,,0,0,0,,Сен сол кезде өлуің керек еді.
Dialogue: 0,0:04:14.26,0:04:15.38,JPDB,,0,0,0,,Аздап тазалаңыз.
Dialogue: 0,0:04:16.04,0:04:17.84,JPDB,,0,0,0,,Жалғыз не істеп жатырсың?
Dialogue: 0,0:04:18.06,0:04:19.98,JPDB,,0,0,0,,О, сіз оны сатып алдыңыз ба?
Dialogue: 0,0:04:21.10,0:04:22.74,JPDB,,0,0,0,,Мен оны сатып алған жоқпын.
Dialogue: 0,0:04:23.06,0:04:24.72,JPDB,,0,0,0,,Тағдыр жазғандай, менің қолымда...
Dialogue: 0,0:04:24.72,0:04:26.58,JPDB,,0,0,0,,Уау, көрейін.
Dialogue: 0,0:04:28.74,0:04:29.18,JPDB,,0,0,0,,Иә
Dialogue: 0,0:04:29.44,0:04:30.30,JPDB,,0,0,0,,Рахмет
Dialogue: 0,0:04:31.26,0:04:34.78,JPDB,,0,0,0,,О, сен де осымен елестерді жойып жіберетіндей бола аласың.
Dialogue: 0,0:04:36.12,0:04:37.28,JPDB,,0,0,0,,Юта керемет
Dialogue: 0,0:04:37.76,0:04:38.80,JPDB,,0,0,0,,Юта
Dialogue: 0,0:04:39.94,0:04:40.98,JPDB,,0,0,0,,Оны өзіңіз тазалаңыз
Dialogue: 0,0:04:42.00,0:04:43.60,JPDB,,0,0,0,,Бірақ бұл қымбат болар еді
Dialogue: 0,0:04:44.36,0:04:45.94,JPDB,,0,0,0,,Мұндай ақша жиі болатын.
Dialogue: 0,0:04:49.62,0:04:53.10,JPDB,,0,0,0,,Күні кеше сіз Тоқа-сан ақша жібергенін айттыңыз.
Dialogue: 0,0:04:54.96,0:04:57.08,JPDB,,0,0,0,,Рикка Жоқ, Джау Шинган.
Dialogue: 0,0:04:57.74,0:05:00.58,JPDB,,0,0,0,,Сіз маған алтын кітабыңызды көрсете аласыз ба?
Dialogue: 0,0:05:01.06,0:05:03.86,JPDB,,0,0,0,,Бұл зұлым патша Шинганның соңғы маңызды құпиясы.
Dialogue: 0,0:05:04.30,0:05:07.66,JPDB,,0,0,0,,Юта болса да, ашуға келісе алмаймын.
Dialogue: 0,0:05:07.92,0:05:10.10,JPDB,,0,0,0,,Маған зұлым патшаның шынайы көздерін көрсет
Dialogue: 0,0:05:10.48,0:05:14.94,JPDB,,0,0,0,,Егер сіз оны ашсаңыз, онда мөрленген барлық зұлымдық бүкіл әлемге таралады.
Dialogue: 0,0:05:15.08,0:05:16.62,JPDB,,0,0,0,,Алға, көрсетші.
Dialogue: 0,0:05:17.54,0:05:18.48,JPDB,,0,0,0,,Юта жақсы емес
Dialogue: 0,0:05:22.00,0:05:24.66,JPDB,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:05:24.76,0:05:26.10,JPDB,,0,0,0,,Жауынгерлік қабілеті 150 000
Dialogue: 0,0:05:26.84,0:05:29.04,JPDB,,0,0,0,,Ол тіпті Приестядан да асып түсе ме?
Dialogue: 0,0:05:29.60,0:05:32.60,JPDB,,0,0,0,,Тоқа-саннан кешірім сұра
Dialogue: 0,0:05:32.86,0:05:34.52,JPDB,,0,0,0,,7-ші эпизод: Секси тапанша дебют жасайды – Бірінші бөлім
Dialogue: 0,0:05:33.84,0:05:35.26,JPDB,,0,0,0,,Тоқта
Dialogue: 0,0:05:36.56,0:05:38.58,JPDB,,0,0,0,,Бұл мектеп сияқты.
Dialogue: 0,0:05:38.84,0:05:40.12,JPDB,,0,0,0,,Сіз әлі білмейсіз.
Dialogue: 0,0:05:40.60,0:05:44.18,JPDB,,0,0,0,,Біз ғашық болсақ та, бұл әрқашан жабысып тұратынымызды білдірмейді.
Dialogue: 0,0:05:45.12,0:05:47.86,JPDB,,0,0,0,,Хмм, мен көшіп кеттім.
Dialogue: 0,0:05:49.38,0:05:54.26,JPDB,,0,0,0,,Бірақ сіз шынымен бір айға 1000 иеннен аз ақшаға өмір сүруді жоспарладыңыз ба?
Dialogue: 0,0:05:54.70,0:05:57.64,JPDB,,0,0,0,,Зұлым патшаның шынайы көзінің күштерінің бірі: Қаракецу
Dialogue: 0,0:05:57.90,0:06:00.40,JPDB,,0,0,0,,Зұлым патша Шинганның сиқырлы күші оның денесінде жасырылған.
Dialogue: 0,0:06:00.64,0:06:05.84,JPDB,,0,0,0,,Бірнеше жыл тамақ ішпей-ақ өмір мен функцияны сақтауға болады.
Dialogue: 0,0:06:06.96,0:06:08.54,JPDB,,0,0,0,,Сіз оны қолданып көргіңіз келе ме?
Dialogue: 0,0:06:08.82,0:06:10.30,JPDB,,0,0,0,,Сіз аштыңыз ба?
Dialogue: 0,0:06:11.48,0:06:13.14,JPDB,,0,0,0,,Кешіріңіз, екі сөмке.
Dialogue: 0,0:06:13.68,0:06:15.88,JPDB,,0,0,0,,Бірге кешкі ас ішуге дүкен аралауға барайық.
Dialogue: 0,0:06:15.88,0:06:18.26,JPDB,,0,0,0,,Олар ғашықтарға ұқсай бастады.
Dialogue: 0,0:06:18.50,0:06:19.22,JPDB,,0,0,0,,Барайық
Dialogue: 0,0:06:19.84,0:06:20.46,JPDB,,0,0,0,,Хе-хе, рақмет
Dialogue: 0,0:06:21.00,0:06:23.80,JPDB,,0,0,0,,Дәлірек айтсақ, дүкен ішінде роликтерді қолданбау туралы айтылған.
Dialogue: 0,0:06:24.28,0:06:26.44,JPDB,,0,0,0,,Жаудың сізге кез келген уақытта шабуыл жасамайтынына кепілдік жоқ.
Dialogue: 0,0:06:26.88,0:06:30.68,JPDB,,0,0,0,,Ондай жағдайда сол жерде үйілген тәттілерді құлатып, жаудың жолын бөгеңіз.
Dialogue: 0,0:06:31.00,0:06:32.82,JPDB,,0,0,0,,Шамдарды дереу жойыңыз
Dialogue: 0,0:06:32.98,0:06:35.34,JPDB,,0,0,0,,Көру мүмкіндігі жойылған жерде
Dialogue: 0,0:06:37.10,0:06:37.94,JPDB,,0,0,0,,Құқық бұзушылық пен қорғаныстың интеграциясы
Dialogue: 0,0:06:38.60,0:06:39.64,JPDB,,0,0,0,,Өтінемін, мұны жасамаңыз.
Dialogue: 0,0:06:39.98,0:06:41.96,JPDB,,0,0,0,,Әй, бұл уақыт емес пе?
Dialogue: 0,0:06:42.26,0:06:42.66,JPDB,,0,0,0,,Кеттік
Dialogue: 0,0:06:42.76,0:06:43.30,JPDB,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:06:44.84,0:06:45.44,JPDB,,0,0,0,,Зире
Dialogue: 0,0:06:46.06,0:06:47.46,JPDB,,0,0,0,,Юта, мынаны сатып алайық.
Dialogue: 0,0:06:47.56,0:06:48.12,JPDB,,0,0,0,,Зире
Dialogue: 0,0:06:48.72,0:06:50.40,JPDB,,0,0,0,,Мұның қажеті жоқ.
Dialogue: 0,0:06:50.76,0:06:51.86,JPDB,,0,0,0,,Оны орнына қойыңыз
Dialogue: 0,0:06:52.82,0:06:55.30,JPDB,,0,0,0,,Юта Куминді сатып алайық
Dialogue: 0,0:06:55.96,0:06:57.74,JPDB,,0,0,0,,Рикка-чан сүйкімді
Dialogue: 0,0:06:57.74,0:07:00.48,JPDB,,0,0,0,,Дөңес қорғағыш дөңес қорғағышты да іздейді.
Dialogue: 0,0:07:00.48,0:07:02.56,JPDB,,0,0,0,,Идиот, бұлай болуы мүмкін емес.
Dialogue: 0,0:07:02.84,0:07:06.80,JPDB,,0,0,0,,Бұл зире тұқымы. Оның құбыжықтарды ұйықтататын қасиеті бар.
Dialogue: 0,0:07:07.30,0:07:09.72,JPDB,,0,0,0,,Зире, бәлкім, сіз карриге немесе басқа нәрсеге салатын нәрсе.
Dialogue: 0,0:07:10.18,0:07:12.82,JPDB,,0,0,0,,Біз маңызды ештеңе жасамаймыз.
Dialogue: 0,0:07:13.42,0:07:15.08,JPDB,,0,0,0,,Қатты рукс жеткілікті.
Dialogue: 0,0:07:15.50,0:07:17.38,JPDB,,0,0,0,,Юта Куминді жек көре ме?
Dialogue: 0,0:07:17.80,0:07:19.56,JPDB,,0,0,0,,Мұны ешкім айтпас еді.
Dialogue: 0,0:07:19.84,0:07:20.72,JPDB,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:07:24.72,0:07:27.64,JPDB,,0,0,0,,Әйтеуір, Тоғашы-күн екеуміз бөлініп кеттік.
Dialogue: 0,0:07:27.88,0:07:29.82,JPDB,,0,0,0,,Сіз нені байыппен қарап отырсыз?
Dialogue: 0,0:07:30.62,0:07:32.66,JPDB,,0,0,0,,Бүгінгі көк кристал
Dialogue: 0,0:07:34.26,0:07:35.92,JPDB,,0,0,0,,Сіз шештіңіз бе? Барайық.
Dialogue: 0,0:07:44.34,0:07:47.76,JPDB,,0,0,0,,Юта Мен жағдайды ерекшелік бойынша тексеремін.
Dialogue: 0,0:07:48.28,0:07:48.98,JPDB,,0,0,0,,Мен кеткім келеді
Dialogue: 0,0:07:49.54,0:07:50.32,JPDB,,0,0,0,,Бұдан былай?
Dialogue: 0,0:07:51.18,0:07:52.58,JPDB,,0,0,0,,Кешкі асқа дейін үйде болыңыз.
Dialogue: 0,0:07:53.22,0:07:54.86,JPDB,,0,0,0,,Зұлым патша Шинганның атымен
Dialogue: 0,0:07:58.20,0:08:00.58,JPDB,,0,0,0,,О, қожадан шақыру өлімі.
Dialogue: 0,0:08:00.74,0:08:03.28,JPDB,,0,0,0,,Өлімге бару Декомори Өлімге бару
Dialogue: 0,0:08:05.06,0:08:07.76,JPDB,,0,0,0,,Екеуміздің жақсы дос болғанымызға қуаныштымын.
Dialogue: 0,0:08:08.18,0:08:10.62,JPDB,,0,0,0,,Ол шынымен де ғашыққа ұқсамайтын.
Dialogue: 0,0:08:10.62,0:08:11.88,JPDB,,0,0,0,,Мәселе мынада.
Dialogue: 0,0:08:12.92,0:08:14.40,JPDB,,0,0,0,,Біз жарты жыл бойы кездесіп жүрміз.
Dialogue: 0,0:08:14.68,0:08:17.68,JPDB,,0,0,0,,Бұл әдетте ең қызықты уақыт деп айтылады.
Dialogue: 0,0:08:18.02,0:08:19.04,JPDB,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:08:19.26,0:08:21.12,JPDB,,0,0,0,,Дене осылай жұмыс істейді
Dialogue: 0,0:08:21.58,0:08:22.70,JPDB,,0,0,0,,Бұл шығар
Dialogue: 0,0:08:23.70,0:08:24.76,JPDB,,0,0,0,,Жалқаулық кезеңі
Dialogue: 0,0:08:25.28,0:08:27.04,JPDB,,0,0,0,,Кентукки Фрид
Dialogue: 0,0:08:28.34,0:08:30.08,JPDB,,0,0,0,,Ауырды, Морисама-чан.
Dialogue: 0,0:08:30.08,0:08:31.92,JPDB,,0,0,0,,Мен аға болсам да
Dialogue: 0,0:08:31.92,0:08:34.58,JPDB,,0,0,0,,Одан да зерігу кезеңі.
Dialogue: 0,0:08:34.78,0:08:35.90,JPDB,,0,0,0,,Айтсаңыз да
Dialogue: 0,0:08:36.06,0:08:38.36,JPDB,,0,0,0,,Которию-сан туралы не ойлайсың?
Dialogue: 0,0:08:38.46,0:08:39.34,JPDB,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:39.34,0:08:41.12,JPDB,,0,0,0,,Олар ғашық болса керек.
Dialogue: 0,0:08:41.24,0:08:43.84,JPDB,,0,0,0,,Олар бір-бірінің сезімін растаған болуы керек.
Dialogue: 0,0:08:43.84,0:08:45.92,JPDB,,0,0,0,,Бұл рас.
Dialogue: 0,0:08:46.06,0:08:48.58,JPDB,,0,0,0,,Екеуміз бірге жүргенде қобалжымаймын
Dialogue: 0,0:08:48.90,0:08:51.36,JPDB,,0,0,0,,Қол ұстасу, бір-біріне қарау, т.б.
Dialogue: 0,0:08:51.94,0:08:53.68,JPDB,,0,0,0,,Оның Нибутаниге еш қатысы жоқ шығар.
Dialogue: 0,0:08:53.68,0:08:55.12,JPDB,,0,0,0,,Жарайды, сен қалай ойлайсың?
Dialogue: 0,0:08:55.70,0:08:58.82,JPDB,,0,0,0,,Екінші курс студенті болғаннан кейін де Которию-сан сол күйінде қалады.
Dialogue: 0,0:08:59.32,0:09:02.74,JPDB,,0,0,0,,Тоғашы-күн де ​​Тоғашы-күн, ол біртүрлі толқып тұр.
Dialogue: 0,0:09:02.82,0:09:03.64,JPDB,,0,0,0,,Хохок
Dialogue: 0,0:09:04.18,0:09:06.02,JPDB,,0,0,0,,Мен оны кеше жасырын қарап шықтым.
Dialogue: 0,0:09:06.08,0:09:08.16,JPDB,,0,0,0,,Олар ғашық емес, ата-ана немесе бала емес.
Dialogue: 0,0:09:08.44,0:09:10.32,JPDB,,0,0,0,,Дәлірек айтсақ, атасы мен немересі
Dialogue: 0,0:09:10.50,0:09:13.22,JPDB,,0,0,0,,Ата кім? Әлде ол мені аңдыды ма?
Dialogue: 0,0:09:13.22,0:09:15.96,JPDB,,0,0,0,,Тогаши-кун Куминді жек көреді, солай ма?
Dialogue: 0,0:09:15.96,0:09:17.12,JPDB,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:09:17.32,0:09:18.92,JPDB,,0,0,0,,Бірге тұрайық, Тоғашы-күн
Dialogue: 0,0:09:19.02,0:09:20.44,JPDB,,0,0,0,,Біз бірге тұрамыз.
Dialogue: 0,0:09:21.36,0:09:25.20,JPDB,,0,0,0,,''Мен сені сүйемін'' немесе ''Мен сені сүйемін'' деген ұғым жоқ.
Dialogue: 0,0:09:25.58,0:09:29.22,JPDB,,0,0,0,,Иә, бірақ менің ойымша, бұл жалығу кезеңімен бірдей емес.
Dialogue: 0,0:09:29.36,0:09:30.28,JPDB,,0,0,0,,Неліктен?
Dialogue: 0,0:09:30.58,0:09:34.30,JPDB,,0,0,0,,Жоқ, бұл ғашықтар суып бара жатыр деген сөз.
Dialogue: 0,0:09:34.54,0:09:38.40,JPDB,,0,0,0,,Мен және Рикка, көрдің бе, біз әлі қол ұстасып үлгерген жоқпыз.
Dialogue: 0,0:09:41.04,0:09:42.06,JPDB,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:09:42.54,0:09:43.86,JPDB,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:09:43.86,0:09:44.50,JPDB,,0,0,0,,О
Dialogue: 0,0:09:44.92,0:09:48.58,JPDB,,0,0,0,,Сондықтан зерігу кезеңі тіпті басталған жоқ.
Dialogue: 0,0:09:49.94,0:09:51.80,JPDB,,0,0,0,,Юта Тогаши
Dialogue: 0,0:09:51.80,0:09:54.16,JPDB,,0,0,0,,Ендеше неге сонша ашуланасың?
Dialogue: 0,0:09:54.38,0:09:55.56,JPDB,,0,0,0,,Біз кездесе бастадық
Dialogue: 0,0:09:56.14,0:09:57.52,JPDB,,0,0,0,,Кио Өткен күз
Dialogue: 0,0:09:58.10,0:09:59.70,JPDB,,0,0,0,,Бізде кемеде кездесу болды
Dialogue: 0,0:09:59.92,0:10:00.56,JPDB,,0,0,0,,Рождество
Dialogue: 0,0:10:00.56,0:10:05.10,JPDB,,0,0,0,,Одан кейін Жаңа жылда ғашықтар күні болды, бірақ қол ұстасып та қалмадық.
Dialogue: 0,0:10:05.10,0:10:06.14,JPDB,,0,0,0,,Бұл ауырады, Нибутани.
Dialogue: 0,0:10:06.14,0:10:07.16,JPDB,,0,0,0,,Бір сәт осында келіңіз.
Dialogue: 0,0:10:07.80,0:10:09.46,JPDB,,0,0,0,,Тоқта, күт, Нибутани
Dialogue: 0,0:10:09.54,0:10:11.70,JPDB,,0,0,0,,Тоғашы, маған қарашы.
Dialogue: 0,0:10:11.70,0:10:12.48,JPDB,,0,0,0,,Бұл жерден кет
Dialogue: 0,0:10:23.62,0:10:25.36,JPDB,,0,0,0,,Бұл Фурин Миябе.
Dialogue: 0,0:10:25.98,0:10:28.28,JPDB,,0,0,0,,Сәлеметсіз бе, бұл Фурин.
Dialogue: 0,0:10:29.56,0:10:32.40,JPDB,,0,0,0,,Миябе-сан махаббат туралы өте жақсы біледі.
Dialogue: 0,0:10:32.52,0:10:34.58,JPDB,,0,0,0,,Оның сізге жақсы кеңес беретініне сенімдімін.
Dialogue: 0,0:10:34.64,0:10:36.20,JPDB,,0,0,0,,дегенді қалай түсінесіңдер?
Dialogue: 0,0:10:36.76,0:10:39.76,JPDB,,0,0,0,,Риккамен бірге тұратыным құпия екенін айттым.
Dialogue: 0,0:10:39.88,0:10:42.72,JPDB,,0,0,0,,Білемін, олай айтқан жоқпын.
Dialogue: 0,0:10:43.06,0:10:47.04,JPDB,,0,0,0,,Мен жай ғана Тоғашы-күннің сүйіктісімен тіл табыса алмағанын айтып едім.
Dialogue: 0,0:10:47.32,0:10:50.30,JPDB,,0,0,0,,Тогаши-кунның құрбысы Рикка-чан, солай ма?
Dialogue: 0,0:10:50.72,0:10:53.76,JPDB,,0,0,0,,Иә, жоқ, мұны қалай айтасыз?
Dialogue: 0,0:10:54.02,0:10:57.94,JPDB,,0,0,0,,Жасыратын ештеңем жоқ, бірінші курстан бастап сыныбымда атақтымын.
Dialogue: 0,0:10:58.36,0:11:00.76,JPDB,,0,0,0,,Мен көремін. Рикка-чан екеуміз қысылып қалдық.
Dialogue: 0,0:11:01.12,0:11:02.12,JPDB,,0,0,0,,Бұл мүмкіндік болуы мүмкін
Dialogue: 0,0:11:03.36,0:11:05.38,JPDB,,0,0,0,,Негізі мен Юриймін.
Dialogue: 0,0:11:05.60,0:11:07.52,JPDB,,0,0,0,,Айтпақшы, мен қазір Рикка-чанға ғашықпын.
Dialogue: 0,0:11:07.98,0:11:11.44,JPDB,,0,0,0,,Мен мұны айтып отырған жоқпын, себебі мен білсем, махаббатым қысқа болуы мүмкін.
Dialogue: 0,0:11:11.96,0:11:13.06,JPDB,,0,0,0,,Бұл бәсекелес болды ма?
Dialogue: 0,0:11:13.30,0:11:14.62,JPDB,,0,0,0,,тез жоғалып кету.
Dialogue: 0,0:11:14.98,0:11:17.00,JPDB,,0,0,0,,Әзілден басқа
Dialogue: 0,0:11:17.24,0:11:18.36,JPDB,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:11:18.90,0:11:21.56,JPDB,,0,0,0,,Әзірше Тогаши-кунның ұялы телефонын беріңізші
Dialogue: 0,0:11:22.88,0:11:23.46,JPDB,,0,0,0,,Иә
Dialogue: 0,0:11:23.64,0:11:25.32,JPDB,,0,0,0,,Ал, мені кездесуге шақырыңыз.
Dialogue: 0,0:11:25.50,0:11:28.60,JPDB,,0,0,0,,Осындай атмосфераны жасап, реакцияны көрген дұрыс.
Dialogue: 0,0:11:29.08,0:11:30.56,JPDB,,0,0,0,,Сіз өз бетіңізше не істеп жатырсыз?
Dialogue: 0,0:11:30.80,0:11:31.56,JPDB,,0,0,0,,Бұл электрондық пошта.
Dialogue: 0,0:11:31.68,0:11:34.00,JPDB,,0,0,0,,Келесі жексенбіде кездесуге барғыңыз келе ме?
Dialogue: 0,0:11:34.20,0:11:36.14,JPDB,,0,0,0,,Бұл да маңызды тақырып.
Dialogue: 0,0:11:36.14,0:11:36.68,JPDB,,0,0,0,,Жіберу
Dialogue: 0,0:11:40.12,0:11:43.80,JPDB,,0,0,0,,Мен қатты толқып кеттім, өйткені Рикка-чанға өз сезімімді білдіргім келіп тұрғандай болды.
Dialogue: 0,0:11:44.40,0:11:44.94,JPDB,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:11:45.70,0:11:47.06,JPDB,,0,0,0,,Жақсы көрінсеңіз де
Dialogue: 0,0:11:47.30,0:11:50.78,JPDB,,0,0,0,,Қыздар жігіттердің өздеріне жақындағанын күтіп тұр.
Dialogue: 0,0:11:51.18,0:11:51.82,JPDB,,0,0,0,,Тіпті Рокка
Dialogue: 0,0:11:52.60,0:11:53.84,JPDB,,0,0,0,,Менің ойымша.
Dialogue: 0,0:11:54.20,0:11:58.02,JPDB,,0,0,0,,Которию-сан, мен орта буын ауруына байланысты анық сөйлей алмаймын.
Dialogue: 0,0:11:58.48,0:12:00.78,JPDB,,0,0,0,,Тоғаши-кун жақсы жете алмаса,
Dialogue: 0,0:12:01.12,0:12:03.84,JPDB,,0,0,0,,Бұл рас.
Dialogue: 0,0:12:08.28,0:12:09.26,JPDB,,0,0,0,,Сол сияқты
Dialogue: 0,0:12:09.80,0:12:14.38,JPDB,,0,0,0,,Рикка екеуміз де жексенбі күні кездесуге ниеттенбей кеттік.
Dialogue: 0,0:12:16.96,0:12:18.40,JPDB,,0,0,0,,Қайырлы таң Су айдаһары
Dialogue: 0,0:12:19.08,0:12:19.78,JPDB,,0,0,0,,Қайырлы таң
Dialogue: 0,0:12:20.14,0:12:21.74,JPDB,,0,0,0,,Рикка-сан сүйкімді
Dialogue: 0,0:12:22.54,0:12:25.86,JPDB,,0,0,0,,Ерекше рәсімдерде ғана киюге болатын шапан.
Dialogue: 0,0:12:27.60,0:12:30.04,JPDB,,0,0,0,,Бүгін ерекше нәрсе бар ма?
Dialogue: 0,0:12:30.52,0:12:30.78,JPDB,,0,0,0,,Иә?
Dialogue: 0,0:12:37.16,0:12:37.56,JPDB,,0,0,0,,Жарайды
Dialogue: 0,0:12:38.02,0:12:38.74,JPDB,,0,0,0,,Сонда барамыз ба?
Dialogue: 0,0:12:39.26,0:12:41.08,JPDB,,0,0,0,,Алдымен баратын жер қандай екенін сұраңыз?
Dialogue: 0,0:12:43.22,0:12:45.76,JPDB,,0,0,0,,Біраз бұрын Рикка барғысы келген жер.
Dialogue: 0,0:12:46.14,0:12:46.90,JPDB,,0,0,0,,I
Dialogue: 0,0:12:48.70,0:12:49.72,JPDB,,0,0,0,,Ойлау
Dialogue: 0,0:12:50.10,0:12:50.68,JPDB,,0,0,0,,Жоқ
Dialogue: 0,0:12:51.66,0:12:53.16,JPDB,,0,0,0,,Жарайды, барғанда көресің.
Dialogue: 0,0:12:54.04,0:12:54.64,JPDB,,0,0,0,,Сіз қамауға алындыңыз ба?
Dialogue: 0,0:12:55.40,0:12:56.54,JPDB,,0,0,0,,Технологиялық шығарылым
Dialogue: 0,0:12:56.98,0:12:58.40,JPDB,,0,0,0,,Сұрыптауға дайындық аяқталды
Dialogue: 0,0:12:58.82,0:13:00.36,JPDB,,0,0,0,,Юта барлық жасыл
Dialogue: 0,0:13:00.70,0:13:01.08,JPDB,,0,0,0,,Таныстырулар!
Dialogue: 0,0:13:02.56,0:13:03.40,JPDB,,0,0,0,,баяу
Dialogue: 0,0:13:03.80,0:13:04.72,JPDB,,0,0,0,,Иә, иә
Dialogue: 0,0:13:07.92,0:13:09.68,JPDB,,0,0,0,,Бұл қалай? Сенімен бәрі жақсы ма?
Dialogue: 0,0:13:09.92,0:13:10.80,JPDB,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:13:11.08,0:13:12.74,JPDB,,0,0,0,,Нашар көрінуден басқа
Dialogue: 0,0:13:12.90,0:13:14.94,JPDB,,0,0,0,,Өз көзқарасыңызға шыдамдылық танытыңыз
Dialogue: 0,0:13:15.90,0:13:17.80,JPDB,,0,0,0,,Мен көлікті қауіпсіз жүргізуге тырысамын.
Dialogue: 0,0:13:18.32,0:13:21.54,JPDB,,0,0,0,,Жарайды, Ютаның өлімі менің де өлімім.
Dialogue: 0,0:13:21.54,0:13:22.50,JPDB,,0,0,0,,Қорқынышты сөздер айтпа
Dialogue: 0,0:13:23.06,0:13:25.96,JPDB,,0,0,0,,Сонымен қатар, Джау Шинган ең күшті.
Dialogue: 0,0:13:26.32,0:13:28.82,JPDB,,0,0,0,,Сіз тіпті нашар көрінгенде де бәрін көре аласыз
Dialogue: 0,0:13:29.72,0:13:31.36,JPDB,,0,0,0,,Ютаның да жүрегінде
Dialogue: 0,0:13:32.10,0:13:34.18,JPDB,,0,0,0,,Мұндай қабілет туралы бірінші рет естіп тұрмын.
Dialogue: 0,0:13:34.90,0:13:35.78,JPDB,,0,0,0,,Енді Юта...
Dialogue: 0,0:13:36.88,0:13:44.38,JPDB,,0,0,0,,«Дәл қазір мен дыбыс жылдамдығынан да жылдаммын, бұл менің найзағай мен найзағайдың жылдам соғу стилім» деп ойлаймын.
Dialogue: 0,0:13:44.38,0:13:45.32,JPDB,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:13:45.72,0:13:47.04,JPDB,,0,0,0,,А, бұл
Dialogue: 0,0:13:48.80,0:13:49.90,JPDB,,0,0,0,,Жел энергиясын өндіру.
Dialogue: 0,0:13:52.00,0:13:52.70,JPDB,,0,0,0,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:13:53.10,0:13:55.30,JPDB,,0,0,0,,Қараңғылық күшімен жел диірменін айналдыру
Dialogue: 0,0:13:57.12,0:13:58.18,JPDB,,0,0,0,,Юта да
Dialogue: 0,0:13:58.32,0:13:59.20,JPDB,,0,0,0,,Жоқ, бұл мүмкін емес еді.
Dialogue: 0,0:13:59.74,0:14:02.90,JPDB,,0,0,0,,Екеуміздің қара күшімізді біріктірсек, жарайды.
Dialogue: 0,0:14:04.30,0:14:05.10,JPDB,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:14:05.60,0:14:07.86,JPDB,,0,0,0,,Зұлым патша Қараңғы жалын Айдаһар Қараңғы толқын
Dialogue: 0,0:14:08.40,0:14:09.42,JPDB,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:14:10.50,0:14:13.84,JPDB,,0,0,0,,Енді ойлап қарасам, күні кеше қатты жел соққан жел диірмені қираған екен...
Dialogue: 0,0:14:22.10,0:14:23.44,JPDB,,0,0,0,,Лулуенің көбеюі
Dialogue: 0,0:14:24.66,0:14:28.00,JPDB,,0,0,0,,Нағыз дельфиндерді көргіңіз келетінін жоғарыда айттыңыз.
Dialogue: 0,0:14:29.24,0:14:30.50,JPDB,,0,0,0,,Кайл сен данышпансың
Dialogue: 0,0:14:30.92,0:14:35.36,JPDB,,0,0,0,,Бұл балыққа ұқсайды, бірақ бұл қараңғылықтың жасырын жауынгері шығар.
Dialogue: 0,0:14:35.70,0:14:37.20,JPDB,,0,0,0,,Мен сені соңғы уақытта көрмедім.
Dialogue: 0,0:14:38.30,0:14:39.74,JPDB,,0,0,0,,Ескі билеушілер
Dialogue: 0,0:14:43.74,0:14:45.12,JPDB,,0,0,0,,Сіз жақсы көрінсеңіз де
Dialogue: 0,0:14:45.36,0:14:48.72,JPDB,,0,0,0,,Қыздар жігіттердің өздеріне жақындағанын күтіп тұр.
Dialogue: 0,0:14:51.82,0:14:52.24,JPDB,,0,0,0,,Рикка
Dialogue: 0,0:14:55.54,0:14:58.16,JPDB,,0,0,0,,Білесің бе, бұл екеуміз ғана.
Dialogue: 0,0:14:59.50,0:15:00.32,JPDB,,0,0,0,,Қол ұстасып тұрған жоқсың ба?
Dialogue: 0,0:15:01.82,0:15:04.30,JPDB,,0,0,0,,Жоқ, ұят болсаң жақсы.
Dialogue: 0,0:15:04.86,0:15:09.32,JPDB,,0,0,0,,Алайда екеуміз кездесіп қалғандықтан, мен кішкентай саусағымды ғана ұстадым.
Dialogue: 0,0:15:33.06,0:15:34.44,JPDB,,0,0,0,,Пингвин пингвині
Dialogue: 0,0:15:34.44,0:15:35.22,JPDB,,0,0,0,,Наутилус
Dialogue: 0,0:15:35.42,0:15:37.52,JPDB,,0,0,0,,Наутилус жоқ
Dialogue: 0,0:15:37.80,0:15:41.72,JPDB,,0,0,0,,Мен Мискатоник университетіне қатысқым келді.
Dialogue: 0,0:15:42.30,0:15:45.62,JPDB,,0,0,0,,Му өркениетінде материк болған жоқ.
Dialogue: 0,0:15:49.56,0:15:52.66,JPDB,,0,0,0,,Айтпақшы, Кайл тек жапон нұсқасында ғана бар сияқты.
Dialogue: 0,0:15:52.92,0:15:53.76,JPDB,,0,0,0,,Шынымен не?
Dialogue: 0,0:15:54.24,0:15:55.20,JPDB,,0,0,0,,Қандай жылдамдық
Dialogue: 0,0:15:55.56,0:15:57.38,JPDB,,0,0,0,,Сиқырлы кеңістікті кесіп өтетін жылдамдық
Dialogue: 0,0:15:59.42,0:16:03.86,JPDB,,0,0,0,,Иә, дельфиндерге нұсқау бергісі келетін достарыңыз бар ма?
Dialogue: 0,0:16:03.86,0:16:05.76,JPDB,,0,0,0,,Иә, иә
Dialogue: 0,0:16:06.34,0:16:07.66,JPDB,,0,0,0,,Міне, ана жақтағы қыз.
Dialogue: 0,0:16:07.80,0:16:08.20,JPDB,,0,0,0,,Иә
Dialogue: 0,0:16:09.34,0:16:12.10,JPDB,,0,0,0,,Маған атыңызды және жасыңызды айта аласыз ба?
Dialogue: 0,0:16:12.40,0:16:14.12,JPDB,,0,0,0,,Тат Рикка Которию
Dialogue: 0,0:16:14.56,0:16:17.94,JPDB,,0,0,0,,Шо Шо Мен бастауыш мектептің алтыншы сыныбында оқимын.
Dialogue: 0,0:16:18.30,0:16:19.50,JPDB,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:21.36,0:16:24.96,JPDB,,0,0,0,,Дельфиннің бетіне мұқият қарап, басын екі жаққа бұрыңыз.
Dialogue: 0,0:16:26.20,0:16:28.08,JPDB,,0,0,0,,Ой, сабыр ет, Ирука.
Dialogue: 0,0:16:28.08,0:16:28.90,JPDB,,0,0,0,,Жарайды
Dialogue: 0,0:16:29.16,0:16:30.30,JPDB,,0,0,0,,Бетімді сүртейін бе?
Dialogue: 0,0:16:31.18,0:16:31.80,JPDB,,0,0,0,,Жарайды
Dialogue: 0,0:16:32.52,0:16:33.24,JPDB,,0,0,0,,Содан кейін келесі
Dialogue: 0,0:16:33.54,0:16:37.80,JPDB,,0,0,0,,Жаттықтырушы апаңыздан секіру белгісін беруді үйретуін сұраңыз.
Dialogue: 0,0:16:38.28,0:16:40.34,JPDB,,0,0,0,,Алдымен оң қолыңызбен аспанды көрсетіңіз.
Dialogue: 0,0:16:40.94,0:16:43.98,JPDB,,0,0,0,,Содан кейін осы оң қолды сол иығыңызға қойыңыз.
Dialogue: 0,0:16:44.56,0:16:47.36,JPDB,,0,0,0,,Бір, екі, үш белгілері бар.
Dialogue: 0,0:16:47.74,0:16:50.46,JPDB,,0,0,0,,Осы оң қолды диагональ бойынша жоғары қарай сермеңіз.
Dialogue: 0,0:16:50.88,0:16:54.00,JPDB,,0,0,0,,Олай болса, бір, екі, үш.
Dialogue: 0,0:16:57.40,0:17:00.78,JPDB,,0,0,0,,Мухахаха, дельфин менің қалауым бойынша қозғалады.
Dialogue: 0,0:17:00.78,0:17:01.96,JPDB,,0,0,0,,Тоқта, ақымақ.
Dialogue: 0,0:17:04.72,0:17:05.78,JPDB,,0,0,0,,Кел, Дженгоро
Dialogue: 0,0:17:07.24,0:17:09.12,JPDB,,0,0,0,,Жапондық алып саламандр
Dialogue: 0,0:17:18.12,0:17:21.26,JPDB,,0,0,0,,Ақырында бәрі әдеттегідей болды.
Dialogue: 0,0:17:21.80,0:17:24.12,JPDB,,0,0,0,,Тоғаши-кун жақсы жетекшілік ету керек.
Dialogue: 0,0:17:24.74,0:17:26.54,JPDB,,0,0,0,,Менің ойымша, бұл рас.
Dialogue: 0,0:17:29.48,0:17:30.02,JPDB,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:17:30.42,0:17:31.54,JPDB,,0,0,0,,Фуруфуру шейк
Dialogue: 0,0:17:32.06,0:17:33.60,JPDB,,0,0,0,,Ал мынаны орындайық
Dialogue: 0,0:17:34.64,0:17:38.72,JPDB,,0,0,0,,Сіз оны автоматқа қанша рет салсаңыз да, ол қайта оралады. Бұл таңдалған 10 иендік монета.
Dialogue: 0,0:17:40.30,0:17:42.88,JPDB,,0,0,0,,Менің ойымша, сен бәріне қуанасың.
Dialogue: 0,0:17:43.28,0:17:44.26,JPDB,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:17:44.56,0:17:47.84,JPDB,,0,0,0,,Ах, бірақ мен бұл Гиза 10 деп ойладым, бірақ солай емес пе?
Dialogue: 0,0:17:49.90,0:17:52.04,JPDB,,0,0,0,,Бірақ ол ескі, сондықтан әбден тозған.
Dialogue: 0,0:17:52.80,0:17:53.42,JPDB,,0,0,0,,Денемнің қатып қалатынына ешқандай белгі болмады…
Dialogue: 0,0:17:53.92,0:17:56.76,JPDB,,0,0,0,,Сен дүниеден қуылған адамсың
Dialogue: 0,0:17:57.50,0:18:00.28,JPDB,,0,0,0,,Мен жаңа ғана сауда автоматы жүйесінен бас тарттым.
Dialogue: 0,0:18:00.68,0:18:02.04,JPDB,,0,0,0,,Қалыпты жағдайда басқа жерде қолдануға болады
Dialogue: 0,0:18:03.30,0:18:06.80,JPDB,,0,0,0,,Бірақ таңдалған адам болудың артықшылығы...
Dialogue: 0,0:18:06.92,0:18:07.80,JPDB,,0,0,0,,​​Қайсысы?
Dialogue: 0,0:18:08.52,0:18:10.22,JPDB,,0,0,0,,Бүгін көңілді болды.
Dialogue: 0,0:18:10.88,0:18:12.52,JPDB,,0,0,0,,Дельфин қараңғылықты кесіп өтті
Dialogue: 0,0:18:13.32,0:18:14.70,JPDB,,0,0,0,,Тіпті қолымызды дұрыс ұстадық.
Dialogue: 0,0:18:15.32,0:18:17.64,JPDB,,0,0,0,,Иә, қосылыңыз
Dialogue: 0,0:18:17.88,0:18:19.82,JPDB,,0,0,0,,Шексіз қосылымдар
Dialogue: 0,0:18:22.56,0:18:25.10,JPDB,,0,0,0,,Бірақ мен әлі түсінбеймін
Dialogue: 0,0:18:26.14,0:18:28.60,JPDB,,0,0,0,,Мен Ютамен ғашықтар келісімін жасадым.
Dialogue: 0,0:18:29.02,0:18:30.08,JPDB,,0,0,0,,Сондықтан менің сүйіктім
Dialogue: 0,0:18:30.56,0:18:34.16,JPDB,,0,0,0,,Бірақ мен ғашық дегеннің не екенін әлі түсінбеймін.
Dialogue: 0,0:18:35.02,0:18:38.96,JPDB,,0,0,0,,Осыны ойласам абдырап қаламын.
Dialogue: 0,0:18:39.58,0:18:40.16,JPDB,,0,0,0,,Рикка
Dialogue: 0,0:18:40.62,0:18:44.62,JPDB,,0,0,0,,Бұл ғашықтардың келісімі болғандықтан, белгілі бір физикалық байланыс сөзсіз.
Dialogue: 0,0:18:44.94,0:18:46.18,JPDB,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:46.72,0:18:47.60,JPDB,,0,0,0,,Дегенмен
Dialogue: 0,0:18:47.82,0:18:48.56,JPDB,,0,0,0,,Қайсысы?
Dialogue: 0,0:18:49.22,0:18:50.14,JPDB,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:18:51.74,0:18:54.40,JPDB,,0,0,0,,Мен тіпті ғашық дегеннің не екенін зерттедім.
Dialogue: 0,0:18:54.80,0:18:56.54,JPDB,,0,0,0,,Бірақ мен сенімді емеспін
Dialogue: 0,0:18:57.48,0:18:59.50,JPDB,,0,0,0,,Мен де интернеттен қарадым, бірақ түсінбеймін.
Dialogue: 0,0:18:59.84,0:19:04.42,JPDB,,0,0,0,,Егер сізде ортақ құқықтық қатынас болса, оларды ғашықтар деп айта алмайсыз.
Dialogue: 0,0:19:04.96,0:19:07.20,JPDB,,0,0,0,,Джау Шинген келісімшартынан өте ерекшеленеді.
Dialogue: 0,0:19:07.96,0:19:11.28,JPDB,,0,0,0,,Демек, Риккаға ғашықтың келісімі ұнамады ма?
Dialogue: 0,0:19:11.56,0:19:13.18,JPDB,,0,0,0,,Жоқ, маған ұнамайды.
Dialogue: 0,0:19:13.62,0:19:14.28,JPDB,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:19:15.22,0:19:17.56,JPDB,,0,0,0,,Бірақ мен не істерімді білмеймін
Dialogue: 0,0:19:18.52,0:19:21.38,JPDB,,0,0,0,,Бір нәрсені өзгерту керек
Dialogue: 0,0:19:25.22,0:19:27.68,JPDB,,0,0,0,,Бірақ мен сізге бір нәрсені айта аламын.
Dialogue: 0,0:19:28.66,0:19:30.46,JPDB,,0,0,0,,Көңілді күн аяқталды
Dialogue: 0,0:19:31.64,0:19:32.98,JPDB,,0,0,0,,Мен қазір үйге бара жатырмын
Dialogue: 0,0:19:34.04,0:19:35.74,JPDB,,0,0,0,,Ютамен бір үйде
Dialogue: 0,0:19:39.16,0:19:41.24,JPDB,,0,0,0,,Мен ешқашан мұндай бақытты болған емеспін.
Dialogue: 0,0:19:44.46,0:19:47.96,JPDB,,0,0,0,,Қуанғаным сонша, мен өлімнің жалауын алды деп ойлаймын.
Dialogue: 0,0:19:50.56,0:19:51.46,JPDB,,0,0,0,,бұрылды
Dialogue: 0,0:19:54.08,0:19:56.42,JPDB,,0,0,0,,Юта екеуміз сөйлестік.
Dialogue: 0,0:19:59.44,0:20:01.40,JPDB,,0,0,0,,Джау Шинген әлі де ең күшті
Dialogue: 0,0:20:02.86,0:20:04.94,JPDB,,0,0,0,,Қараңғы кадр шебері келесі ең күшті
Dialogue: 0,0:20:08.54,0:20:09.16,JPDB,,0,0,0,,Юта
Dialogue: 0,0:20:11.66,0:20:13.88,JPDB,,0,0,0,,Кешіріңіз, кешіріңіз, бұл дұрыс емес.
Dialogue: 0,0:20:20.04,0:20:21.42,JPDB,,0,0,0,,Джау Шинген күткендей
Dialogue: 0,0:20:21.86,0:20:24.76,JPDB,,0,0,0,,Бұл қараңғы кадр шебері күткен нәрсеге ие болды.
Dialogue: 0,0:20:26.72,0:20:30.40,JPDB,,0,0,0,,Біз жасаған келісім-шарт зайырлы әлемде ғашықтар келісімі ретінде белгілі емес.
Dialogue: 0,0:20:31.06,0:20:32.90,JPDB,,0,0,0,,Зұлым патшаның шынайы көзді сүйетіндер туралы келісімі
Dialogue: 0,0:20:33.58,0:20:39.14,JPDB,,0,0,0,,Сондықтан, лас ақыл-ойға батқан қарапайым адамдардың конвенцияларына ерудің қажеті жоқ.
Dialogue: 0,0:20:39.88,0:20:43.42,JPDB,,0,0,0,,Бізге тек өзімізге ғана тән қарым-қатынас құру керек.
Dialogue: 0,0:20:44.02,0:20:46.16,JPDB,,0,0,0,,Сіз оны алаңдамай-ақ орындай аласыз.
Dialogue: 0,0:20:46.78,0:20:50.06,JPDB,,0,0,0,,Егер бұл Dark Frame Master және Джау Шинган
Dialogue: 0,0:20:52.22,0:20:53.12,JPDB,,0,0,0,,Юта
Dialogue: 0,0:20:54.34,0:20:56.44,JPDB,,0,0,0,,Сонымен, сіз қалай ойлайсыз?
Dialogue: 0,0:20:57.96,0:20:58.32,JPDB,,0,0,0,,Иә
Dialogue: 0,0:21:01.04,0:21:02.96,JPDB,,0,0,0,,Мен жел диірменін иіргеннен кейін қайттым.
Dialogue: 0,0:21:03.62,0:21:05.64,JPDB,,0,0,0,,Мен бұл нені білдіретінін түсінбеймін.
Dialogue: 0,0:21:06.48,0:21:08.06,JPDB,,0,0,0,,Бұл шын мәнінде сізге қажет нәрсе.
Dialogue: 0,0:21:08.58,0:21:13.12,JPDB,,0,0,0,,А, әзірге, менің ойымша, Рикканың Рикка болып қалуы жақсы.
Dialogue: 0,0:21:14.26,0:21:15.60,JPDB,,0,0,0,,Бұл өте сергітеді.
Dialogue: 0,0:21:17.72,0:21:20.16,JPDB,,0,0,0,,Жарайды, егер бұл жақсы болса, бұл жақсы.
Dialogue: 0,0:21:20.86,0:21:22.80,JPDB,,0,0,0,,Миябе дәл осылай деді.
Dialogue: 0,0:21:23.48,0:21:25.82,JPDB,,0,0,0,,Мен осылайша әйтеуір кейінге қалдырамын.
Dialogue: 0,0:21:26.08,0:21:29.76,JPDB,,0,0,0,,Әдетте екі адамның арасында келеңсіздіктер болады дейді.
Dialogue: 0,0:21:59.78,0:22:01.56,JPDB,,0,0,0,,Менің сиқырымды көр
Dialogue: 0,0:22:20.90,0:22:24.30,JPED,,0,0,0,,Бүршік жарған қараңғы түн аласапыран әкеледі
Dialogue: 0,0:22:24.30,0:22:26.74,JPED,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:22:27.12,0:22:31.28,JPED,,0,0,0,,Алыс теңізден шыққан жеті дыбыс
Dialogue: 0,0:22:31.28,0:22:32.54,JPED,,0,0,0,,Менің жүрегім дүрсілдеп тұр
Dialogue: 0,0:22:32.54,0:22:36.50,JPED,,0,0,0,,Фестиваль бренді рифте жарқырайды
Dialogue: 0,0:22:36.50,0:22:38.52,JPED,,0,0,0,,Сіз әлі де жалғастырғыңыз келе ме?
Dialogue: 0,0:22:38.52,0:22:42.28,JPED,,0,0,0,,Махаббат нұрында жарқырап
Dialogue: 0,0:22:42.28,0:22:44.00,JPED,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз
Dialogue: 0,0:22:44.00,0:22:46.94,JPED,,0,0,0,,Біз бір болдық
Dialogue: 0,0:22:46.94,0:22:49.58,JPED,,0,0,0,,Аспанда ұшу
Dialogue: 0,0:22:49.80,0:22:55.38,JPED,,0,0,0,,Тәкаппарлық – айқайлаған отшашу іспетті
Dialogue: 0,0:22:55.46,0:23:00.92,JPED,,0,0,0,,Жылтырлық бір сәтте жарылып кетті
Dialogue: 0,0:23:01.28,0:23:06.98,JPED,,0,0,0,,Сайқымазақ өзінің әділдігін ұшады
Dialogue: 0,0:23:06.98,0:23:12.44,JPED,,0,0,0,,Ақымақ ай сәулесінде жоқтықты құшақтайды
Dialogue: 0,0:23:12.72,0:23:18.40,JPED,,0,0,0,,Ойын бізді қуып жетуге арналған болса
Dialogue: 0,0:23:18.40,0:23:23.26,JPED,,0,0,0,,Ең болмағанда мен шірімейтін ақымақ болғым келеді.
Dialogue: 0,0:23:23.36,0:23:28.78,JPED,,0,0,0,,Көңіл толқып айқайлады
Dialogue: 0,0:23:28.78,0:23:32.96,JPED,,0,0,0,,Бұл әлемді қуу
Dialogue: 0,0:23:34.46,0:23:40.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
