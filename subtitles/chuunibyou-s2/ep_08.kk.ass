Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:22:19.20,0:22:22.60,JPED,,0,0,0,,Бүршік атып келе жатқан қараңғы түн аласапыранға түседі
Dialogue: 0,0:22:22.60,0:22:25.04,JPED,,0,0,0,,
Dialogue: 0,0:22:25.42,0:22:29.58,JPED,,0,0,0,,Мәңгіліктен шыққан жеті дыбыс
Dialogue: 0,0:22:29.58,0:22:30.84,JPED,,0,0,0,,
Dialogue: 0,0:22:30.84,0:22:34.80,JPED,,0,0,0,,Сиқырлы балғаның белгісі рифте жарқырайды
Dialogue: 0,0:22:34.80,0:22:36.82,JPED,,0,0,0,,(Мен әлі де жалғастыруды жоспарлап отырмын)
Dialogue: 0,0:22:36.82,0:22:40.58,JPED,,0,0,0,,Аврора сүйіспеншілікпен жарқырайды
Dialogue: 0,0:22:40.58,0:22:42.30,JPED,,0,0,0,,
Dialogue: 0,0:22:42.30,0:22:45.24,JPED,,0,0,0,,Біз бір болдық
Dialogue: 0,0:22:45.24,0:22:47.88,JPED,,0,0,0,,Аспанда ұшу
Dialogue: 0,0:22:48.10,0:22:53.68,JPED,,0,0,0,,Мақтанышпен жарылған отшашу сияқты
Dialogue: 0,0:22:53.76,0:22:59.22,JPED,,0,0,0,,Жылтырлық бір сәтте жарылып кетті
Dialogue: 0,0:22:59.58,0:23:05.28,JPED,,0,0,0,,Сайқымазақ өзінің әділдігін ұшады
Dialogue: 0,0:23:05.28,0:23:10.74,JPED,,0,0,0,,Ақымақ ай сәулесінде адасушылықты сақтайды.
Dialogue: 0,0:23:11.02,0:23:16.70,JPED,,0,0,0,,Ойын бізді қуып жетуге арналған болса
Dialogue: 0,0:23:16.70,0:23:21.56,JPED,,0,0,0,,Ең болмағанда мен шірімейтін ақымақ болғым келеді.
Dialogue: 0,0:23:21.66,0:23:27.08,JPED,,0,0,0,,Көңіл толқып айқайлады
Dialogue: 0,0:23:27.08,0:23:31.26,JPED,,0,0,0,,Бұл әлемді қуу
Dialogue: 0,0:22:19.20,0:22:22.60,ZWED,,0,0,0,,Бүршік жарған қараңғы түн
Dialogue: 0,0:22:22.60,0:22:25.04,ZWED,,0,0,0,,(Мазасыздық)
Dialogue: 0,0:22:25.42,0:22:29.58,ZWED,,0,0,0,,Жеті түрлі түсті нота
Dialogue: 0,0:22:29.58,0:22:30.84,ZWED,,0,0,0,,(Қызықты)
Dialogue: 0,0:22:30.84,0:22:34.80,ZWED,,0,0,0,,Сиқырлы бренд
Dialogue: 0,0:22:34.80,0:22:36.82,ZWED,,0,0,0,,(Сіз қалай ойлайсыз?)
Dialogue: 0,0:22:36.82,0:22:40.58,ZWED,,0,0,0,,Махаббат заңы туралы
Dialogue: 0,0:22:40.58,0:22:42.30,ZWED,,0,0,0,,(Kai-тоқтаудың төменгі жартысы)
Dialogue: 0,0:22:42.30,0:22:45.24,ZWED,,0,0,0,,Біз біртұтаспыз.
Dialogue: 0,0:22:45.24,0:22:47.88,ZWED,,0,0,0,,Ұшатын аспан
Dialogue: 0,0:22:48.10,0:22:53.68,ZWED,,0,0,0,,Тәкаппарлықтай биік сөнетін от
Dialogue: 0,0:22:53.76,0:22:59.22,ZWED,,0,0,0,,Жарық моменті кезіндегі жарылыс
Dialogue: 0,0:22:59.58,0:23:05.28,ZWED,,0,0,0,,Кіші өгіз елші сақалы
Dialogue: 0,0:23:05.28,0:23:10.74,ZWED,,0,0,0,,Ай көлеңкесіндегі ақымақ
Dialogue: 0,0:23:11.02,0:23:16.70,ZWED,,0,0,0,,Ойыншы мені әлі қуып келеді.
Dialogue: 0,0:23:16.70,0:23:21.56,ZWED,,0,0,0,,Барынша аз, Өлмейтін қылышпын.
Dialogue: 0,0:23:21.66,0:23:27.08,ZWED,,0,0,0,,Көтерілген жанның ұлы зары
Dialogue: 0,0:23:27.08,0:23:31.26,ZWED,,0,0,0,,Дүниеден қуылған
Dialogue: 0,0:01:12.04,0:01:15.96,JPOP,,0,0,0,,Мен ғашық болғым келеді
Dialogue: 0,0:01:28.80,0:01:32.46,JPOP,,0,0,0,,Арманың жалғасын тапсын
Dialogue: 0,0:01:32.90,0:01:38.36,JPOP,,0,0,0,,Уәде берсем де, жүрегім бір жерден қорқады, ауырады
Dialogue: 0,0:01:38.88,0:01:44.38,JPOP,,0,0,0,,Мен жалғыз емес екенімді сенгім келеді
Dialogue: 0,0:01:44.38,0:01:49.98,JPOP,,0,0,0,,Мен сені ойлау арқылы бақыттымын деп айта алмаймын
Dialogue: 0,0:01:49.98,0:01:53.18,JPOP,,0,0,0,,Мен бос сеніммен жүрсем де
Dialogue: 0,0:01:53.26,0:02:00.12,JPOP,,0,0,0,,Күліп, менің батылдығыма айналасың
Dialogue: 0,0:02:00.12,0:02:04.52,JPOP,,0,0,0,,Бір сөзбен әлеміңді өзгерте алсам
Dialogue: 0,0:02:04.68,0:02:10.60,JPOP,,0,0,0,,Екі махаббат дамитыны рас.
Dialogue: 0,0:02:10.60,0:02:15.66,JPOP,,0,0,0,,Мен ойлану арқылы таптым
Dialogue: 0,0:02:15.80,0:02:18.40,JPOP,,0,0,0,,Мен әрқашан сенің жолыңмен жүрдім
Dialogue: 0,0:02:18.40,0:02:23.02,JPOP,,0,0,0,,Мен оны жеткізуге дайын болмасам да
Dialogue: 0,0:02:23.02,0:02:25.42,JPOP,,0,0,0,,Мен сізге шынымды айтқым келеді
Dialogue: 0,0:02:25.42,0:02:28.38,JPOP,,0,0,0,,Менің жүрегім қандай болса, менің даусым жарқырайды
Dialogue: 0,0:02:28.38,0:02:34.20,JPOP,,0,0,0,,дауысты бұзса, ол жаңғырық береді
Dialogue: 0,0:00:00.34,0:00:01.34,JPDB,,0,0,0,,Мен көремін.
Dialogue: 0,0:00:01.76,0:00:04.30,JPDB,,0,0,0,,Сонда әлем қайта жасалды ма?
Dialogue: 0,0:00:05.96,0:00:07.90,JPDB,,0,0,0,,Біз ұрыс даласында жүргенде
Dialogue: 0,0:00:08.14,0:00:10.10,JPDB,,0,0,0,,Саңылауды қараңғылық басып өтеді.
Dialogue: 0,0:00:11.50,0:00:13.94,JPDB,,0,0,0,,Бұл мүлде басқа әлемдік сызық.
Dialogue: 0,0:00:14.24,0:00:15.76,JPDB,,0,0,0,,Қалай ойласаң да, солай шығар.
Dialogue: 0,0:00:17.08,0:00:18.74,JPDB,,0,0,0,,Жоқ, бұл біртүрлі сезім
Dialogue: 0,0:00:19.72,0:00:23.36,JPDB,,0,0,0,,Қараңғылық әлемі осы уақытқа дейін жаулап алды ма?
Dialogue: 0,0:00:23.88,0:00:24.80,JPDB,,0,0,0,,Оның артында қандай себеп тұрса да,
Dialogue: 0,0:00:26.12,0:00:27.28,JPDB,,0,0,0,,Шварц Шуц
Dialogue: 0,0:00:28.16,0:00:30.32,JPDB,,0,0,0,,А Тогаши-кун мен Рикка-чан
Dialogue: 0,0:00:30.40,0:00:31.28,JPDB,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:00:31.56,0:00:33.72,JPDB,,0,0,0,,Мектеп саяхаты қалай өтті?
Dialogue: 0,0:00:33.90,0:00:35.94,JPDB,,0,0,0,,Иә, мен абдырап қалдым.
Dialogue: 0,0:00:36.10,0:00:37.46,JPDB,,0,0,0,,Бұл көңілді болар еді
Dialogue: 0,0:00:37.88,0:00:40.20,JPDB,,0,0,0,,Екеуің бірге қаланы араладыңдар, солай ма?
Dialogue: 0,0:00:40.46,0:00:42.84,JPDB,,0,0,0,,А, бұл жаңалық.
Dialogue: 0,0:00:43.36,0:00:46.74,JPDB,,0,0,0,,Schwarzzechs Perfect Customization Gelzoniansus
Dialogue: 0,0:00:46.98,0:00:48.16,JPDB,,0,0,0,,Оны араластырмаңыз
Dialogue: 0,0:00:48.50,0:00:49.52,JPDB,,0,0,0,,Гельзони
Dialogue: 0,0:00:49.70,0:00:51.44,JPDB,,0,0,0,,Қайырлы таң Өлім
Dialogue: 0,0:00:51.44,0:00:55.12,JPDB,,0,0,0,,О, Герзониант мырза және Өлім, қожайын емес кім?
Dialogue: 0,0:00:55.12,0:00:56.48,JPDB,,0,0,0,,Сондықтан оны араластырмаңыз.
Dialogue: 0,0:00:57.64,0:00:58.28,JPDB,,0,0,0,,Декомори
Dialogue: 0,0:01:00.80,0:01:03.40,JPDB,,0,0,0,,Неге таң қалдыңыз, ұстаз?
Dialogue: 0,0:01:05.64,0:01:07.28,JPDB,,0,0,0,,Өлшемдері де бұрмаланған
Dialogue: 0,0:02:40.54,0:02:42.28,JPDB,,0,0,0,,Бұл нағыз Морисама
Dialogue: 0,0:02:42.36,0:02:43.76,JPDB,,0,0,0,,C Қатты дауыс
Dialogue: 0,0:02:44.46,0:02:45.54,JPDB,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:02:46.12,0:02:47.94,JPDB,,0,0,0,,Нақты ештеңе болмайды.
Dialogue: 0,0:02:48.24,0:02:49.90,JPDB,,0,0,0,,Мен осындамын
Dialogue: 0,0:02:50.32,0:02:52.86,JPDB,,0,0,0,,Бірақ сіз кездестім дейсіз.
Dialogue: 0,0:02:53.32,0:02:59.24,JPDB,,0,0,0,,Морисама-чан мен оның достары мектепте саяхатта жүргенде веб-сайтта кездескен сияқты.
Dialogue: 0,0:02:59.60,0:02:59.92,JPDB,,0,0,0,,Міне, келдік
Dialogue: 0,0:03:03.50,0:03:05.00,JPDB,,0,0,0,,Сәттілік Өлім
Dialogue: 0,0:03:05.28,0:03:08.16,JPDB,,0,0,0,,Біз сізді күттік, Морисама мырза.
Dialogue: 0,0:03:08.78,0:03:13.34,JPDB,,0,0,0,,Сәттілік, мен сені күттім, Саня.
Dialogue: 0,0:03:14.28,0:03:15.40,JPDB,,0,0,0,,Бұл Санья.
Dialogue: 0,0:03:16.10,0:03:17.90,JPDB,,0,0,0,,Бірақ сол қолдағы асыл тас
Dialogue: 0,0:03:18.42,0:03:20.20,JPDB,,0,0,0,,Бұл Морисамердің белгісі.
Dialogue: 0,0:03:21.36,0:03:26.44,JPDB,,0,0,0,,Бүгін де сиқыршы Морисама сізге жол көрсетуге келді.
Dialogue: 0,0:03:26.90,0:03:27.82,JPDB,,0,0,0,,Иә өлім
Dialogue: 0,0:03:28.12,0:03:29.60,JPDB,,0,0,0,,Рахмет
Dialogue: 0,0:03:29.92,0:03:33.44,JPDB,,0,0,0,,Алдымен өзімізбен және аруақтармен тазартамыз.
Dialogue: 0,0:03:33.78,0:03:36.50,JPDB,,0,0,0,,Қолдарыңызды біріктіріп, тыныш көзіңізді жұмыңыз.
Dialogue: 0,0:03:36.66,0:03:37.10,JPDB,,0,0,0,,Иә
Dialogue: 0,0:03:50.48,0:03:51.20,JPDB,,0,0,0,,Бітті
Dialogue: 0,0:03:51.84,0:03:52.70,JPDB,,0,0,0,,Бұл не?
Dialogue: 0,0:03:53.18,0:03:55.18,JPDB,,0,0,0,,Сиқырлы тазартатын құрылғы шығар
Dialogue: 0,0:03:56.18,0:03:57.98,JPDB,,0,0,0,,Қалай қарасаң да, сандық фотоаппарат шығар.
Dialogue: 0,0:03:58.40,0:04:02.06,JPDB,,0,0,0,,Бірақ бұл әйел несі?
Dialogue: 0,0:04:03.40,0:04:08.38,JPDB,,0,0,0,,Сонымен, олар қайтып келгенде, мен оларға өзімнің қатысуымды хабарладым.
Dialogue: 0,0:04:08.60,0:04:09.48,JPDB,,0,0,0,,Иә, өлім
Dialogue: 0,0:04:09.60,0:04:13.66,JPDB,,0,0,0,,Бір күні мен жалған Жазға Морисама-саманың бар екенін хабарлаймын.
Dialogue: 0,0:04:14.74,0:04:16.44,JPDB,,0,0,0,,Үрген жүз Жасырын өлім
Dialogue: 0,0:04:16.80,0:04:17.58,JPDB,,0,0,0,,Санья
Dialogue: 0,0:04:17.90,0:04:21.22,JPDB,,0,0,0,,Мұндай жаман жүректі адамдарға қарамау керек.
Dialogue: 0,0:04:22.28,0:04:26.42,JPDB,,0,0,0,,Әрине, өзін морисамерлер деп көрсететін қарапайым адамдар бар.
Dialogue: 0,0:04:26.74,0:04:30.96,JPDB,,0,0,0,,Сенің жүрегің ұсқынсыз, бұрмаланғанына сенімдімін.
Dialogue: 0,0:04:31.04,0:04:31.34,JPDB,,0,0,0,,На
Dialogue: 0,0:04:31.64,0:04:35.26,JPDB,,0,0,0,,Бірақ мұндай нәрселерді жек көретін болсаңыз
Dialogue: 0,0:04:35.56,0:04:38.36,JPDB,,0,0,0,,Таза Сәнияның өзі де арам болады.
Dialogue: 0,0:04:38.72,0:04:40.44,JPDB,,0,0,0,,Маңыздысы – махаббат
Dialogue: 0,0:04:40.98,0:04:44.80,JPDB,,0,0,0,,Себебі сен біреуді алдаудан басқа амалы жоқ ақымақ шіріген қарапайым адамсың.
Dialogue: 0,0:04:45.24,0:04:48.16,JPDB,,0,0,0,,Біз ақырын жүргізуіміз керек
Dialogue: 0,0:04:49.70,0:04:52.94,JPDB,,0,0,0,,Әй, қызық екен, анау әйел.
Dialogue: 0,0:04:54.34,0:04:55.12,JPDB,,0,0,0,,Келісімді пайдаланбай-ақ мені одақтасың қыла аласың деп ойладың ғой?
Dialogue: 0,0:04:57.32,0:04:58.90,JPDB,,0,0,0,,Сіз фейксіз
Dialogue: 0,0:04:59.68,0:05:02.00,JPDB,,0,0,0,,Сіз бұл жалған емес деп айтасыз.
Dialogue: 0,0:05:02.38,0:05:06.00,JPDB,,0,0,0,,Әй, онда менің атымды өтірік айттың.
Dialogue: 0,0:05:07.82,0:05:09.38,JPDB,,0,0,0,,Қайсысы өтірік айтады?
Dialogue: 0,0:05:09.66,0:05:11.88,JPDB,,0,0,0,,Рұқсатсыз басты бетті жасаңыз
Dialogue: 0,0:05:12.30,0:05:15.30,JPDB,,0,0,0,,О, мен Саньядан естідім.
Dialogue: 0,0:05:15.64,0:05:17.70,JPDB,,0,0,0,,Қалайша өзіңізді сонша өтірік айта аласыз?
Dialogue: 0,0:05:17.96,0:05:21.02,JPDB,,0,0,0,,Сенің жүрегің шынымен лас, солай емес пе?
Dialogue: 0,0:05:21.60,0:05:22.98,JPDB,,0,0,0,,Сенің түрің осындай
Dialogue: 0,0:05:24.68,0:05:25.68,JPDB,,0,0,0,,Морисама-сама
Dialogue: 0,0:05:25.68,0:05:27.00,JPDB,,0,0,0,,Сіз алыс болуыңыз керек.
Dialogue: 0,0:05:27.00,0:05:28.00,JPDB,,0,0,0,,О, Санья
Dialogue: 0,0:05:28.22,0:05:29.64,JPDB,,0,0,0,,Бұл не, Санья?
Dialogue: 0,0:05:29.90,0:05:30.42,JPDB,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:05:30.66,0:05:33.90,JPDB,,0,0,0,,Бұл менмін. Мен сен сияқты шынайы болмысымды жасырамын.
Dialogue: 0,0:05:34.00,0:05:36.64,JPDB,,0,0,0,,Мен жақсы адамдар сияқты әрекет ететін әйелдерді жек көремін.
Dialogue: 0,0:05:36.80,0:05:38.02,JPDB,,0,0,0,,Сіз мұны айтасыз ба?
Dialogue: 0,0:05:38.32,0:05:40.18,JPDB,,0,0,0,,Әңгімені үзбеңіз
Dialogue: 0,0:05:40.66,0:05:44.70,JPDB,,0,0,0,,Демек, сен нағыз Морисамерсің бе?
Dialogue: 0,0:05:44.86,0:05:45.50,JPDB,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:05:45.72,0:05:48.42,JPDB,,0,0,0,,Ендеше, жеке басын неге жасыру керек?
Dialogue: 0,0:05:48.98,0:05:53.28,JPDB,,0,0,0,,Мен оның қасиетті кітап Мабиногионды өртеуге әрекеттенгенін естідім.
Dialogue: 0,0:05:53.34,0:05:54.52,JPDB,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:05:54.52,0:05:55.56,JPDB,,0,0,0,,Өлім
Dialogue: 0,0:05:55.80,0:05:58.96,JPDB,,0,0,0,,Сіз фейк болғаныңыз үшін солай істедіңіз.
Dialogue: 0,0:05:58.96,0:05:59.86,JPDB,,0,0,0,,Қандай қатыгез қимыл…
Dialogue: 0,0:06:00.20,0:06:01.64,JPDB,,0,0,0,,Неліктен?
Dialogue: 0,0:06:01.98,0:06:03.36,JPDB,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:06:04.00,0:06:04.92,JPDB,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:06:05.32,0:06:06.26,JPDB,,0,0,0,,Бұл күрделі.
Dialogue: 0,0:06:06.44,0:06:08.00,JPDB,,0,0,0,,Жарайды, үндеме.
Dialogue: 0,0:06:11.42,0:06:15.28,JPDB,,0,0,0,,Дәлелдерді ертең әкелемін деп айту жақсы идея болды ма?
Dialogue: 0,0:06:15.72,0:06:18.46,JPDB,,0,0,0,,Сіз бұл жерден шегінуге болмайды.
Dialogue: 0,0:06:20.40,0:06:23.56,JPDB,,0,0,0,,Қара тарих ретінде толығымен жойылды.
Dialogue: 0,0:06:23.78,0:06:25.14,JPDB,,0,0,0,,Ештеңе қалмады
Dialogue: 0,0:06:25.64,0:06:28.00,JPDB,,0,0,0,,Қол әшекейлері дәлел бола алмайды.
Dialogue: 0,0:06:29.24,0:06:29.98,JPDB,,0,0,0,,Буггарати мен басқалары шынында да осы пойызға мініпті
Dialogue: 0,0:06:30.60,0:06:33.60,JPDB,,0,0,0,,Егер бұл орын алса, соңғы шара
Dialogue: 0,0:06:34.76,0:06:36.14,JPDB,,0,0,0,,Аруақтарға бұйрық беріңіз
Dialogue: 0,0:06:36.48,0:06:37.90,JPDB,,0,0,0,,Менің өтінішімді тыңда.
Dialogue: 0,0:06:38.10,0:06:39.56,JPDB,,0,0,0,,Бұл соңғы шара ма?
Dialogue: 0,0:06:40.30,0:06:41.40,JPDB,,0,0,0,,Күшті сезіну
Dialogue: 0,0:06:42.00,0:06:42.86,JPDB,,0,0,0,,Жарайды
Dialogue: 0,0:06:43.40,0:06:46.94,JPDB,,0,0,0,,Іздегенімді 100 хиттен табатынмын.
Dialogue: 0,0:06:47.68,0:06:50.34,JPDB,,0,0,0,,Көріпкелдікте шындық жоқ дейді.
Dialogue: 0,0:06:50.52,0:06:52.20,JPDB,,0,0,0,,Үндемей қал, бұл көңіл бөледі
Dialogue: 0,0:06:53.76,0:06:55.34,JPDB,,0,0,0,,Оны таба алмадыңыз ба?
Dialogue: 0,0:06:56.20,0:06:59.78,JPDB,,0,0,0,,Өйткені, Нибутани Декомори айтқандай.
Dialogue: 0,0:07:00.08,0:07:00.84,JPDB,,0,0,0,,Жалған
Dialogue: 0,0:07:01.54,0:07:02.62,JPDB,,0,0,0,,Б-барлаушы? Не туралы айтып тұрсыздар?
Dialogue: 0,0:07:04.20,0:07:08.26,JPDB,,0,0,0,,Бірақ кімнің шын екені маңызды емес.
Dialogue: 0,0:07:18.22,0:07:19.22,JPDB,,0,0,0,,Юта
Dialogue: 0,0:07:19.52,0:07:19.84,JPDB,,0,0,0,,Иә
Dialogue: 0,0:07:30.16,0:07:33.68,JPDB,,0,0,0,,Ешқандай дәлел жоқ па?
Dialogue: 0,0:07:34.36,0:07:37.02,JPDB,,0,0,0,,Мен нағыз адаммын.
Dialogue: 0,0:07:37.14,0:07:39.90,JPDB,,0,0,0,,Өлім, өйткені жалғандар бәсекелесуге тырысады
Dialogue: 0,0:07:40.14,0:07:43.70,JPDB,,0,0,0,,Сіз қандай қорқынышты іс істеп жатқаныңызды білмейсіз.
Dialogue: 0,0:07:43.70,0:07:44.80,JPDB,,0,0,0,,Сендер тым шулысыңдар.
Dialogue: 0,0:07:45.00,0:07:48.60,JPDB,,0,0,0,,Мен сізге айтамын, сізде ешқандай дәлел жоқ.
Dialogue: 0,0:07:48.90,0:07:50.44,JPDB,,0,0,0,,Ол таңғаларлық адам.
Dialogue: 0,0:07:50.98,0:07:52.94,JPDB,,0,0,0,,Менің Морисамер екенімді дәлелдеу
Dialogue: 0,0:07:53.56,0:07:55.26,JPDB,,0,0,0,,Бұл менмін
Dialogue: 0,0:07:56.28,0:07:56.70,JPDB,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:07:56.92,0:07:59.98,JPDB,,0,0,0,,Мабиногионды бейнелейтін сиқыршы ретіндегі келбеті
Dialogue: 0,0:08:00.52,0:08:04.14,JPDB,,0,0,0,,Санья сияқты күші бар адамды көргенде бірден түсінесіз.
Dialogue: 0,0:08:05.12,0:08:06.56,JPDB,,0,0,0,,Солай ма?
Dialogue: 0,0:08:06.72,0:08:09.56,JPDB,,0,0,0,,Мен Декомориді көргенде-ақ білдім.
Dialogue: 0,0:08:09.76,0:08:12.72,JPDB,,0,0,0,,Бұл адам нағыз Морисамер.
Dialogue: 0,0:08:12.80,0:08:16.62,JPDB,,0,0,0,,Сіз менің шынайымын деп бұрын айттыңыз.
Dialogue: 0,0:08:16.78,0:08:18.74,JPDB,,0,0,0,,Сіз немен мақтанасыз?
Dialogue: 0,0:08:18.86,0:08:22.42,JPDB,,0,0,0,,Бұл сізді абайсызда ұстаудың жетілдірілген тактикасы.
Dialogue: 0,0:08:22.42,0:08:23.62,JPDB,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:08:23.62,0:08:24.68,JPDB,,0,0,0,,Сенбеңіз
Dialogue: 0,0:08:25.14,0:08:26.38,JPDB,,0,0,0,,Мен мұны анық айтамын
Dialogue: 0,0:08:26.94,0:08:31.12,JPDB,,0,0,0,,Мен сенің жалған екеніңді білдім.
Dialogue: 0,0:08:32.00,0:08:36.14,JPDB,,0,0,0,,Мұндай лас беті бар адамның Морисамер болуы мүмкін емес.
Dialogue: 0,0:08:36.86,0:08:41.28,JPDB,,0,0,0,,Осыны түсінген соң ойыңды өзгертіп, Саньяны таста.
Dialogue: 0,0:08:43.08,0:08:44.76,JPDB,,0,0,0,,Дыбыс шығармайтын өлім бе?
Dialogue: 0,0:08:44.94,0:08:46.86,JPDB,,0,0,0,,Күтілгендей, бұл жай ғана жалған...
Dialogue: 0,0:08:45.86,0:08:46.90,JPDB,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:08:47.96,0:08:51.68,JPDB,,0,0,0,,Өткеннің зұлмат тарихы сыртқа шығарылғаны емес.
Dialogue: 0,0:08:51.80,0:08:53.70,JPDB,,0,0,0,,Оған мән бермеңіз.
Dialogue: 0,0:08:54.66,0:08:58.24,JPDB,,0,0,0,,Менің Морисамер екенімді растайтын ешқандай дәлел жоқ.
Dialogue: 0,0:08:59.20,0:09:02.12,JPDB,,0,0,0,,Ақырында сізден азат болу сергітеді.
Dialogue: 0,0:09:02.60,0:09:03.06,JPDB,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:09:03.70,0:09:04.62,JPDB,,0,0,0,,Морисама-чан
Dialogue: 0,0:09:06.20,0:09:07.30,JPDB,,0,0,0,,Эй Нибутани
Dialogue: 0,0:09:08.56,0:09:10.08,JPDB,,0,0,0,,жалған жаз
Dialogue: 0,0:09:13.16,0:09:16.36,JPDB,,0,0,0,,Енді сіз дұрыс жолмен жүре аласыз.
Dialogue: 0,0:09:16.88,0:09:17.64,JPDB,,0,0,0,,Ол да
Dialogue: 0,0:09:18.30,0:09:19.52,JPDB,,0,0,0,,Морисамер-сама
Dialogue: 0,0:09:28.50,0:09:31.60,JPDB,,0,0,0,,Ақырында сізден құтылу сергітеді.
Dialogue: 0,0:09:32.18,0:09:35.70,JPDB,,0,0,0,,Сіз не туралы айтып тұрсыз? Бұл шынымен көңілсіз.
Dialogue: 0,0:09:36.26,0:09:38.50,JPDB,,0,0,0,,Сана Чан, не болды?
Dialogue: 0,0:09:38.80,0:09:40.66,JPDB,,0,0,0,,Бүгін өзіңізді жақсы сезінбейтін сияқтысыз.
Dialogue: 0,0:09:41.66,0:09:43.06,JPDB,,0,0,0,,Бұл ештеңе емес, Өлім.
Dialogue: 0,0:09:43.62,0:09:44.32,JPDB,,0,0,0,,Иә
Dialogue: 0,0:09:46.94,0:09:50.66,JPDB,,0,0,0,,Сабақтан кейін менің үйімде Мабиногионды бірге оқиық.
Dialogue: 0,0:09:52.54,0:09:53.70,JPDB,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:09:56.08,0:09:58.14,JPDB,,0,0,0,,Оның маған еш қатысы жоқ деп ойлаймын.
Dialogue: 0,0:09:58.66,0:10:01.68,JPDB,,0,0,0,,Менің ойымша, мұның бір қатысы бар. Бұл сіздің жалғаныңыз.
Dialogue: 0,0:10:02.18,0:10:04.44,JPDB,,0,0,0,,Тек бұл туралы алаңдамаңыз
Dialogue: 0,0:10:06.84,0:10:07.64,JPDB,,0,0,0,,(Жаңа атқарушы)
Dialogue: 0,0:10:07.98,0:10:08.64,JPDB,,0,0,0,,Декомори
Dialogue: 0,0:10:10.16,0:10:12.10,JPDB,,0,0,0,,Кешегі күн шедевр болды
Dialogue: 0,0:10:12.10,0:10:14.60,JPDB,,0,0,0,,Сіздің жалғандығыңыз ақыры әшкере болды.
Dialogue: 0,0:10:14.92,0:10:15.98,JPDB,,0,0,0,,Ақымақ және
Dialogue: 0,0:10:17.70,0:10:18.58,JPDB,,0,0,0,,Өлімді күту
Dialogue: 0,0:10:18.68,0:10:19.40,JPDB,,0,0,0,,Не?
Dialogue: 0,0:10:19.40,0:10:21.24,JPDB,,0,0,0,,Сіз нені ойлап отырсыз?
Dialogue: 0,0:10:21.42,0:10:25.58,JPDB,,0,0,0,,Декомориден жеңіліп, жалған болып көріну шынымен де көңілсіз болды ма?
Dialogue: 0,0:10:26.24,0:10:26.86,JPDB,,0,0,0,,Бөлек
Dialogue: 0,0:10:29.00,0:10:30.76,JPDB,,0,0,0,,Қараңдар, сабақ басталып жатыр.
Dialogue: 0,0:10:32.80,0:10:33.66,JPDB,,0,0,0,,Қорлар
Dialogue: 0,0:10:33.94,0:10:36.70,JPDB,,0,0,0,,Адамдар мен үшін мұны істеу үшін қиындық көрсе де,
Dialogue: 0,0:10:38.68,0:10:39.38,JPDB,,0,0,0,,Жақсы ма?
Dialogue: 0,0:10:39.78,0:10:40.50,JPDB,,0,0,0,,Не
Dialogue: 0,0:10:54.30,0:10:56.66,JPDB,,0,0,0,,Сонымен Деко-чан үйіне қайтты.
Dialogue: 0,0:10:57.04,0:10:57.56,JPDB,,0,0,0,,Иә
Dialogue: 0,0:10:57.66,0:10:58.88,JPDB,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:10:59.04,0:11:01.36,JPDB,,0,0,0,,Тоғаши-күн бұл үшін көп жұмыс істеуі керек.
Dialogue: 0,0:11:01.80,0:11:03.78,JPDB,,0,0,0,,Герзониант мырза деген не?
Dialogue: 0,0:11:03.88,0:11:05.78,JPDB,,0,0,0,,Өтінемін, егде жастағыларыңызды еске түсірмеңіз
Dialogue: 0,0:11:06.44,0:11:09.08,JPDB,,0,0,0,,Екеуіңді бөлмеге шақырдым.
Dialogue: 0,0:11:09.24,0:11:11.18,JPDB,,0,0,0,,Ағымдағы дөңес қорғаныс жарамсыз.
Dialogue: 0,0:11:11.76,0:11:13.36,JPDB,,0,0,0,,Уақытша қызметшіні іздеу
Dialogue: 0,0:11:13.78,0:11:14.96,JPDB,,0,0,0,,Сен де сенсің.
Dialogue: 0,0:11:15.84,0:11:18.42,JPDB,,0,0,0,,Деко-чан, сен шынымен жақсысың ба?
Dialogue: 0,0:11:18.84,0:11:21.38,JPDB,,0,0,0,,Мен ол адамнан қорқамын.
Dialogue: 0,0:11:21.86,0:11:22.64,JPDB,,0,0,0,,Неліктен?
Dialogue: 0,0:11:25.78,0:11:26.54,JPDB,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:11:27.22,0:11:27.80,JPDB,,0,0,0,,Ұнады
Dialogue: 0,0:11:28.18,0:11:30.14,JPDB,,0,0,0,,Әй, – дейді Күмін-сенпай.
Dialogue: 0,0:11:30.18,0:11:32.06,JPDB,,0,0,0,,Бұл Декомориге ғашық көздер.
Dialogue: 0,0:11:32.46,0:11:34.44,JPDB,,0,0,0,,Қандай бос сөз айтып тұрсың?
Dialogue: 0,0:11:34.78,0:11:37.10,JPDB,,0,0,0,,Жоқ, мен де солай ойладым.
Dialogue: 0,0:11:37.54,0:11:38.56,JPDB,,0,0,0,,Артқа қарау
Dialogue: 0,0:11:39.04,0:11:42.22,JPDB,,0,0,0,,Декомориге көзқарасым сәл басқаша екені рас.
Dialogue: 0,0:11:44.20,0:11:46.06,JPDB,,0,0,0,,Дұрыс сөйлескен дұрыс.
Dialogue: 0,0:11:46.74,0:11:48.18,JPDB,,0,0,0,,Неліктен?
Dialogue: 0,0:11:48.36,0:11:49.78,JPDB,,0,0,0,,Тіпті егер
Dialogue: 0,0:11:49.90,0:11:52.96,JPDB,,0,0,0,,Әлгі ақымақ соны қаласа, жарайды.
Dialogue: 0,0:11:53.26,0:11:56.60,JPDB,,0,0,0,,Қыңыр болу мүмкін емес.
Dialogue: 0,0:11:57.22,0:11:59.76,JPDB,,0,0,0,,Декомори бұл жігітті Морисама деп ойлайды.
Dialogue: 0,0:11:59.92,0:12:01.86,JPDB,,0,0,0,,Бұл жиіркенішті дейді.
Dialogue: 0,0:12:02.24,0:12:04.76,JPDB,,0,0,0,,Мұндай жалған нәрселерге оңай іліну.
Dialogue: 0,0:12:06.20,0:12:07.28,JPDB,,0,0,0,,Кептеліп қалды ма деп ойлаймын.
Dialogue: 0,0:12:08.24,0:12:12.70,JPDB,,0,0,0,,Деко-чан Морисама-чанның шынайы болғанын қалайтыныңызға сенімдімін.
Dialogue: 0,0:12:13.12,0:12:13.70,JPDB,,0,0,0,,Сонымен...
Dialogue: 0,0:12:14.96,0:12:18.58,JPDB,,0,0,0,,Ақымақтың соншалықты күрделі нәрсені ойлауы мүмкін емес.
Dialogue: 0,0:12:19.32,0:12:19.54,JPDB,,0,0,0,,Иә?
Dialogue: 0,0:12:20.80,0:12:21.26,JPDB,,0,0,0,,Не болды?
Dialogue: 0,0:12:21.50,0:12:21.74,JPDB,,0,0,0,,(Бір күні сені қолға түсіреміз)
Dialogue: 0,0:12:24.42,0:12:25.20,JPDB,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:25.84,0:12:28.58,JPDB,,0,0,0,,Бұл Деко-чанның суреті шығар.
Dialogue: 0,0:12:32.58,0:12:33.30,JPDB,,0,0,0,,Ұрыс
Dialogue: 0,0:12:33.78,0:12:37.56,JPDB,,0,0,0,,А, оны Декомори алдында жекпе-жекке шақырыңыз және оны жеңіңіз.
Dialogue: 0,0:12:38.14,0:12:40.08,JPDB,,0,0,0,,Морисамер екеніңізді дәлелдеңіз
Dialogue: 0,0:12:40.86,0:12:44.24,JPDB,,0,0,0,,Өйткені Нибутанидің нағыз Морисама екендігі туралы ешқандай дәлел жоқ.
Dialogue: 0,0:12:44.46,0:12:45.78,JPDB,,0,0,0,,Бұл ең жақсы әдіс
Dialogue: 0,0:12:46.10,0:12:47.18,JPDB,,0,0,0,,Хаа
Dialogue: 0,0:12:47.54,0:12:49.36,JPDB,,0,0,0,,Сіз мұны бұрын жасаған шығарсыз.
Dialogue: 0,0:12:49.64,0:12:51.80,JPDB,,0,0,0,,Морисама болып көрініп, төбелесіңіз.
Dialogue: 0,0:12:52.44,0:12:54.38,JPDB,,0,0,0,,Осылайша мен де Рикканың сеніміне ие болдым.
Dialogue: 0,0:12:54.54,0:12:54.76,JPDB,,0,0,0,,Иә
Dialogue: 0,0:12:55.70,0:12:56.30,JPDB,,0,0,0,,Ғашық болу
Dialogue: 0,0:12:56.44,0:12:57.18,JPDB,,0,0,0,,Жоқ
Dialogue: 0,0:12:57.60,0:12:58.96,JPDB,,0,0,0,,Мен де ұялып тұрмын.
Dialogue: 0,0:12:59.58,0:13:01.66,JPDB,,0,0,0,,Бірақ бұл туралы ойлануға уақытыңыз жоқ шығар.
Dialogue: 0,0:13:02.14,0:13:05.30,JPDB,,0,0,0,,Дұрыс, Деко-чанды шынымен де алып кетеді.
Dialogue: 0,0:13:05.62,0:13:07.42,JPDB,,0,0,0,,Шындығында, мен...
Dialogue: 0,0:13:07.42,0:13:08.88,JPDB,,0,0,0,,Ах, бұл қазірдің өзінде тітіркендіргіш.
Dialogue: 0,0:13:09.70,0:13:10.78,JPDB,,0,0,0,,Риккаға барыңыз
Dialogue: 0,0:13:11.90,0:13:12.70,JPDB,,0,0,0,,Түсінікті.
Dialogue: 0,0:13:13.50,0:13:14.30,JPDB,,0,0,0,,Не?
Dialogue: 0,0:13:14.42,0:13:15.08,JPDB,,0,0,0,,Арнайы дайындық
Dialogue: 0,0:13:15.74,0:13:18.70,JPDB,,0,0,0,,Зұлым патшаның шынайы көзінің күші оның денесінде таңбаланған.
Dialogue: 0,0:13:19.02,0:13:19.92,JPDB,,0,0,0,,Explode Real
Dialogue: 0,0:13:20.16,0:13:21.38,JPDB,,0,0,0,,Pop Synapse
Dialogue: 0,0:13:21.64,0:13:24.58,JPDB,,0,0,0,,Бұл әлемді қуу
Dialogue: 0,0:13:25.68,0:13:25.94,JPDB,,0,0,0,,Бұл
Dialogue: 0,0:13:26.38,0:13:26.82,JPDB,,0,0,0,,Не болды?
Dialogue: 0,0:13:27.86,0:13:30.36,JPDB,,0,0,0,,Бұл әлемді қуу
Dialogue: 0,0:13:31.32,0:13:33.60,JPDB,,0,0,0,,Бұл ғибадатханамен бірдеңе дұрыс емес.
Dialogue: 0,0:13:33.72,0:13:35.24,JPDB,,0,0,0,,Үйлесімділік деген бар ма?
Dialogue: 0,0:13:35.50,0:13:36.76,JPDB,,0,0,0,,Бірақ біз не істейміз?
Dialogue: 0,0:13:37.04,0:13:40.52,JPDB,,0,0,0,,Рикка-чан жұмыс істемесе, Деко-чан да болмайды.
Dialogue: 0,0:13:41.10,0:13:41.90,JPDB,,0,0,0,,Тоғаши мырза
Dialogue: 0,0:13:42.22,0:13:43.68,JPDB,,0,0,0,,Мен бітірдім
Dialogue: 0,0:13:44.72,0:13:46.48,JPDB,,0,0,0,,Сиқырлы жын патша қыз
Dialogue: 0,0:13:47.22,0:13:47.98,JPDB,,0,0,0,,Шичиномия?
Dialogue: 0,0:13:48.40,0:13:48.76,JPDB,,0,0,0,,Бірақ...
Dialogue: 0,0:13:49.72,0:13:51.42,JPDB,,0,0,0,,деді сиқырлы жын қыз
Dialogue: 0,0:13:52.10,0:13:54.86,JPDB,,0,0,0,,Мен мәңгі сиқырлы жын қыз боламын
Dialogue: 0,0:13:55.88,0:13:59.72,JPDB,,0,0,0,,Сонымен қатар, Юта екеуміздің келісім-шартымыз абсолютті...
Dialogue: 0,0:14:00.34,0:14:00.90,JPDB,,0,0,0,,Сонымен
Dialogue: 0,0:14:04.50,0:14:05.40,JPDB,,0,0,0,,Шақыру
Dialogue: 0,0:14:08.06,0:14:11.86,JPDB,,0,0,0,,Сиқырлы жын патша қыз София сақинасы SP Сатурн VII
Dialogue: 0,0:14:12.16,0:14:14.20,JPDB,,0,0,0,,Періштені өлтіретін мен боламын.
Dialogue: 0,0:14:14.58,0:14:15.96,JPDB,,0,0,0,,Кешіріңіз, осындай уақытта.
Dialogue: 0,0:14:16.44,0:14:19.66,JPDB,,0,0,0,,Жоқ, ол маған мектептегі саяхатқа көмектесті.
Dialogue: 0,0:14:20.14,0:14:21.28,JPDB,,0,0,0,,Бірақ бұл жақсы болды.
Dialogue: 0,0:14:21.50,0:14:24.00,JPDB,,0,0,0,,Одан кейін екеуіңде бәрі жақсы болған сияқты.
Dialogue: 0,0:14:24.22,0:14:24.66,JPDB,,0,0,0,,Иә?
Dialogue: 0,0:14:25.66,0:14:28.84,JPDB,,0,0,0,,Морисамерге арнайы жауынгерлік дайындық беруім керек пе?
Dialogue: 0,0:14:29.46,0:14:30.70,JPDB,,0,0,0,,Шынымен не?
Dialogue: 0,0:14:31.06,0:14:31.94,JPDB,,0,0,0,,Өтінемін
Dialogue: 0,0:14:32.62,0:14:33.92,JPDB,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:14:34.10,0:14:35.78,JPDB,,0,0,0,,Ол өзін Морисама деп атаған кезде
Dialogue: 0,0:14:36.00,0:14:39.34,JPDB,,0,0,0,,Біз серіктес болдық, сондықтан мен оны жақсы білемін.
Dialogue: 0,0:14:39.92,0:14:44.08,JPDB,,0,0,0,,Қараңдаршы, ол жерде емдік шөптер бар. Сіз оларды үнемі теріп, жеп жүрдіңіз.
Dialogue: 0,0:14:45.08,0:14:45.72,JPDB,,0,0,0,,Тоқта
Dialogue: 0,0:14:45.80,0:14:48.08,JPDB,,0,0,0,,Ағаштарды зақымдап, шырынын ішу
Dialogue: 0,0:14:48.08,0:14:49.58,JPDB,,0,0,0,,Тоқта
Dialogue: 0,0:14:49.58,0:14:52.62,JPDB,,0,0,0,,Күні бойы құспен сөйлесуге тырыстың ба?
Dialogue: 0,0:14:53.96,0:14:55.94,JPDB,,0,0,0,,Ұят, ұят, ұят...
Dialogue: 0,0:14:55.94,0:14:56.90,JPDB,,0,0,0,,Ұятыңды таста
Dialogue: 0,0:14:57.16,0:14:59.90,JPDB,,0,0,0,,Сіз Морисама, 1200 жыл өмір сүрген сиқыршы болуыңыз керек.
Dialogue: 0,0:15:00.12,0:15:01.44,JPDB,,0,0,0,,Менің ойымша, сіз махаббатыңызды жеткізу үшін келдіңіз.
Dialogue: 0,0:15:01.70,0:15:03.66,JPDB,,0,0,0,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:15:03.66,0:15:04.42,JPDB,,0,0,0,,Жарайды
Dialogue: 0,0:15:05.46,0:15:06.86,JPDB,,0,0,0,,Менің мұны істеуден басқа амалым жоқ, өтінемін.
Dialogue: 0,0:15:07.26,0:15:08.44,JPDB,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:15:08.44,0:15:10.78,JPDB,,0,0,0,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:15:18.78,0:15:22.70,JPDB,,0,0,0,,Өйткені, ол жігіт нағыз фейк еді.
Dialogue: 0,0:15:23.18,0:15:25.86,JPDB,,0,0,0,,Әу бастан білгенім сол еді
Dialogue: 0,0:15:27.14,0:15:29.16,JPDB,,0,0,0,,Бұл бетті жылдам жойыңыз.
Dialogue: 0,0:15:29.50,0:15:31.26,JPDB,,0,0,0,,Мен саған кәдесый сатып алмаймын.
Dialogue: 0,0:15:34.90,0:15:36.10,JPDB,,0,0,0,,Бұл не?
Dialogue: 0,0:15:36.68,0:15:38.42,JPDB,,0,0,0,,Мот Морисама-сама
Dialogue: 0,0:15:39.50,0:15:41.90,JPDB,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:15:44.06,0:15:47.82,JPDB,,0,0,0,,Жүрегің әлі таза емес сияқты.
Dialogue: 0,0:15:48.14,0:15:49.68,JPDB,,0,0,0,,Не, Морисама-сама?
Dialogue: 0,0:15:50.76,0:15:52.72,JPDB,,0,0,0,,Мен сізді тазартуға рұқсат етіңіз.
Dialogue: 0,0:15:53.44,0:15:56.64,JPDB,,0,0,0,,Барлығын менің махаббатыммен қоршап ал
Dialogue: 0,0:15:56.64,0:15:59.80,JPDB,,0,0,0,,Морисама-сама, өлімге жақын, жақын.
Dialogue: 0,0:16:00.06,0:16:01.40,JPDB,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:16:03.86,0:16:05.18,JPDB,,0,0,0,,Оны тоқтатыңыз Өлім
Dialogue: 0,0:16:05.40,0:16:07.08,JPDB,,0,0,0,,Санья
Dialogue: 0,0:16:07.48,0:16:10.48,JPDB,,0,0,0,,Саньяның орны сүйкімді, сәбиге ұқсайды
Dialogue: 0,0:16:10.48,0:16:12.40,JPDB,,0,0,0,,Тоқта, тоқта
Dialogue: 0,0:16:12.40,0:16:15.18,JPDB,,0,0,0,,Маған көмектесші, Жалған жаз
Dialogue: 0,0:16:15.86,0:16:16.90,JPDB,,0,0,0,,Осымен
Dialogue: 0,0:16:20.54,0:16:25.78,JPDB,,0,0,0,,Жадым жоғалса да, 1500 жыл өмір сүрдім.
Dialogue: 0,0:16:26.46,0:16:29.48,JPDB,,0,0,0,,Бұл дүниеде бар нағыз сиқыршы
Dialogue: 0,0:16:30.40,0:16:33.58,JPDB,,0,0,0,,Аруақтардың жетелеуімен әңгімелерді айналдырушы
Dialogue: 0,0:16:34.64,0:16:37.54,JPDB,,0,0,0,,Менің атым Морисамер
Dialogue: 0,0:16:39.02,0:16:39.32,JPDB,,0,0,0,,На
Dialogue: 0,0:16:40.04,0:16:41.84,JPDB,,0,0,0,,Сіз қайтадан келдіңіз
Dialogue: 0,0:16:42.10,0:16:43.82,JPDB,,0,0,0,,Өздерін Морисама деп атайтындар
Dialogue: 0,0:16:44.66,0:16:48.68,JPDB,,0,0,0,,Нақты Морисамер қайсысы екенін анықтайық.
Dialogue: 0,0:16:49.40,0:16:51.12,JPDB,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:51.82,0:16:54.18,JPDB,,0,0,0,,Бұл оқиға енді аяқталды.
Dialogue: 0,0:16:54.70,0:16:58.60,JPDB,,0,0,0,,Онда мені махаббатыңмен тазарт.
Dialogue: 0,0:16:59.22,0:17:01.18,JPDB,,0,0,0,,Болашақты мәңгілікке өшір
Dialogue: 0,0:17:02.12,0:17:07.10,JPDB,,0,0,0,,Енді, сиқыршылар, мәңгілік күресейік.
Dialogue: 0,0:17:07.68,0:17:08.66,JPDB,,0,0,0,,Ұшатын пері
Dialogue: 0,0:17:09.22,0:17:10.36,JPDB,,0,0,0,,Сыбырлы рух
Dialogue: 0,0:17:10.90,0:17:13.34,JPDB,,0,0,0,,Рухани карикатура
Dialogue: 0,0:17:19.54,0:17:20.88,JPDB,,0,0,0,,Нибутаниге барыңыз
Dialogue: 0,0:17:21.04,0:17:22.14,JPDB,,0,0,0,,Ә? Жоқ, мен ештеңе істеген жоқпын…
Dialogue: 0,0:17:22.44,0:17:25.72,JPDB,,0,0,0,,Осы уақытқа дейін жеткен болсаң, ұялмайсың.
Dialogue: 0,0:17:30.62,0:17:31.62,JPDB,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:32.00,0:17:33.94,JPDB,,0,0,0,,Мен Саняны қатты қаладым
Dialogue: 0,0:17:34.20,0:17:35.52,JPDB,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:17:35.72,0:17:39.58,JPDB,,0,0,0,,Маған сіздің өзіңізді Морисамер деп атағаныңыз ұнамайды.
Dialogue: 0,0:17:40.30,0:17:41.58,JPDB,,0,0,0,,Мен шынмын
Dialogue: 0,0:17:41.90,0:17:43.92,JPDB,,0,0,0,,Келіңіздер, рухтар.
Dialogue: 0,0:17:45.36,0:17:47.30,JPDB,,0,0,0,,Перілер, күш
Dialogue: 0,0:17:51.42,0:17:55.08,JPDB,,0,0,0,,Қазіргі заманда қара тарихтан асқан ұят нәрсе жоқ.
Dialogue: 0,0:17:55.54,0:17:59.28,JPDB,,0,0,0,,Бірақ бәрібір, Морисаманы мен жасадым.
Dialogue: 0,0:18:00.20,0:18:00.98,JPDB,,0,0,0,,Жалған жаз
Dialogue: 0,0:18:01.32,0:18:06.22,JPDB,,0,0,0,,Мен сен сияқты адамдарға өздерінің таяз мақсаттары үшін пайдалануына жол бермеймін.
Dialogue: 0,0:18:08.44,0:18:13.38,JPDB,,0,0,0,,Міне, менің өзіме деген бұрмаланған махаббатым.
Dialogue: 0,0:18:18.30,0:18:18.86,JPDB,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:18:19.26,0:18:20.58,JPDB,,0,0,0,,Сыни соққы
Dialogue: 0,0:18:22.26,0:18:22.84,JPDB,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:18:23.24,0:18:24.98,JPDB,,0,0,0,,Түсінсең, тез кет.
Dialogue: 0,0:18:30.06,0:18:32.06,JPDB,,0,0,0,,Ағымдағы шабуыл дегеніміз не?
Dialogue: 0,0:18:32.26,0:18:34.86,JPDB,,0,0,0,,Морисаманың құдіреті осы
Dialogue: 0,0:18:37.62,0:18:41.78,JPDB,,0,0,0,,Өте өкінішті, мен Мабиногионның барлық жазбаларын іздедім.
Dialogue: 0,0:18:41.96,0:18:43.02,JPDB,,0,0,0,,Барлығын білу
Dialogue: 0,0:18:43.56,0:18:45.84,JPDB,,0,0,0,,Морисамерден гөрі Морисамер болу
Dialogue: 0,0:18:46.82,0:18:48.32,JPDB,,0,0,0,,Ол бала менікі.
Dialogue: 0,0:18:48.64,0:18:50.58,JPDB,,0,0,0,,Мен өз періштемді таптым
Dialogue: 0,0:18:51.20,0:18:54.70,JPDB,,0,0,0,,Мен сені көшеде алғаш көргеннен бері қудым.
Dialogue: 0,0:18:55.18,0:18:57.00,JPDB,,0,0,0,,Мен мүмкіндікті күттім
Dialogue: 0,0:18:58.16,0:18:59.64,JPDB,,0,0,0,,Ешқашан берме
Dialogue: 0,0:19:02.12,0:19:03.10,JPDB,,0,0,0,,Морисама-чан
Dialogue: 0,0:19:03.10,0:19:03.64,JPDB,,0,0,0,,Нибутани
Dialogue: 0,0:19:06.48,0:19:11.20,JPDB,,0,0,0,,Менің адасушылықтарым сізден жақсырақ сияқты, Фейк мырза.
Dialogue: 0,0:19:12.20,0:19:14.40,JPDB,,0,0,0,,Енді мен жоғалып кетейін.
Dialogue: 0,0:19:15.20,0:19:16.00,JPDB,,0,0,0,,Бұл жолы
Dialogue: 0,0:19:20.12,0:19:21.90,JPDB,,0,0,0,,Жоғал
Dialogue: 0,0:19:34.44,0:19:36.92,JPDB,,0,0,0,,Егер оңайырақ болса, мен шыдаймын.
Dialogue: 0,0:19:44.06,0:19:45.18,JPDB,,0,0,0,,Мен сізге айтып тұрмын.
Dialogue: 0,0:19:45.60,0:19:48.80,JPDB,,0,0,0,,Мен мұны істеп, осы ақымақ жылды алсам да
Dialogue: 0,0:19:48.98,0:19:50.02,JPDB,,0,0,0,,Сіз тек өкінесіз
Dialogue: 0,0:19:50.14,0:19:50.70,JPDB,,0,0,0,,На
Dialogue: 0,0:19:51.42,0:19:52.74,JPDB,,0,0,0,,Бұл жігіт ең нашар
Dialogue: 0,0:19:53.40,0:19:55.36,JPDB,,0,0,0,,Адамдардың айтқанын мүлде тыңдамаймын.
Dialogue: 0,0:19:55.90,0:19:58.84,JPDB,,0,0,0,,Мен үлкендерге құрмет көрсетпеймін.
Dialogue: 0,0:19:59.62,0:20:02.22,JPDB,,0,0,0,,Ол өзімшіл, қатыгез және шулы.
Dialogue: 0,0:20:02.76,0:20:05.52,JPDB,,0,0,0,,Сол әдет мені жалғыз, кішіпейіл етеді.
Dialogue: 0,0:20:05.80,0:20:06.54,JPDB,,0,0,0,,Бұл жылауық сәби
Dialogue: 0,0:20:07.02,0:20:10.26,JPDB,,0,0,0,,Дәл осы кезде ол кенеттен керемет сүйкімді жымиды.
Dialogue: 0,0:20:11.14,0:20:12.02,JPDB,,0,0,0,,Жалған жаз
Dialogue: 0,0:20:12.40,0:20:13.98,JPDB,,0,0,0,,Періштелер шектен шыққан
Dialogue: 0,0:20:14.44,0:20:16.08,JPDB,,0,0,0,,Шайтаннан да қиын
Dialogue: 0,0:20:17.02,0:20:18.40,JPDB,,0,0,0,,Ең үлкен ақымақ
Dialogue: 0,0:20:19.50,0:20:20.72,JPDB,,0,0,0,,Сен ақымақсың
Dialogue: 0,0:20:21.38,0:20:24.44,JPDB,,0,0,0,,Менің Саньямды ластама
Dialogue: 0,0:20:24.56,0:20:25.30,JPDB,,0,0,0,,Нибутани
Dialogue: 0,0:20:25.88,0:20:28.34,JPDB,,0,0,0,,Мжолнир Хаммер
Dialogue: 0,0:20:28.92,0:20:31.00,JPDB,,0,0,0,,Санья, сен не айтып тұрсың?
Dialogue: 0,0:20:31.34,0:20:33.58,JPDB,,0,0,0,,Бұл жігіт сөзсіз фейк
Dialogue: 0,0:20:33.58,0:20:34.78,JPDB,,0,0,0,,Жалған самадалар
Dialogue: 0,0:20:35.02,0:20:38.06,JPDB,,0,0,0,,Бірақ бұл әділетті жалған өлім
Dialogue: 0,0:20:38.06,0:20:39.40,JPDB,,0,0,0,,Сізге ұқсамайды
Dialogue: 0,0:20:40.34,0:20:42.18,JPDB,,0,0,0,,Сіз де Морисама емессіз.
Dialogue: 0,0:20:42.36,0:20:45.40,JPDB,,0,0,0,,Нағыз Морисама-сама ешқашан мұндай нәрсені жасамас еді.
Dialogue: 0,0:20:45.58,0:20:45.94,JPDB,,0,0,0,,На
Dialogue: 0,0:20:46.36,0:20:48.54,JPDB,,0,0,0,,Нағыз тері киген жалған
Dialogue: 0,0:20:48.78,0:20:51.20,JPDB,,0,0,0,,Жалған жаз - Декомори жеңетін өлім
Dialogue: 0,0:20:51.60,0:20:56.46,JPDB,,0,0,0,,Greathammer GX-тің соңғы соңы
Dialogue: 0,0:21:04.56,0:21:07.18,JPDB,,0,0,0,,Мен сені алғаш көргеннен бері жақсы көремін.
Dialogue: 0,0:21:07.66,0:21:09.54,JPDB,,0,0,0,,Мен сені періште деп ойладым
Dialogue: 0,0:21:10.14,0:21:14.30,JPDB,,0,0,0,,Міне, сондықтан мен сізді айналдырғым келеді, және бұл ...
Dialogue: 0,0:21:14.88,0:21:16.72,JPDB,,0,0,0,,Мұның несі жақсы?
Dialogue: 0,0:21:17.26,0:21:20.14,JPDB,,0,0,0,,Міне... Санья - періште
Dialogue: 0,0:21:20.42,0:21:23.90,JPDB,,0,0,0,,Махаббатты да, адамдарды да білмейтін пәк, пәк періште.
Dialogue: 0,0:21:24.14,0:21:26.46,JPDB,,0,0,0,,Сүйуді былай қойғанда, тіпті қол ұстасып...
Dialogue: 0,0:21:27.38,0:21:28.86,JPDB,,0,0,0,,Менде бірінші сүйіспеншілік болды.
Dialogue: 0,0:21:29.18,0:21:29.70,JPDB,,0,0,0,,Иә?
Dialogue: 0,0:21:29.86,0:21:31.00,JPDB,,0,0,0,,Рождествоға арналған
Dialogue: 0,0:21:31.34,0:21:32.60,JPDB,,0,0,0,,А, бұл...
Dialogue: 0,0:21:33.16,0:21:33.78,JPDB,,0,0,0,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:21:34.28,0:21:38.72,JPDB,,0,0,0,,Мен бұл бала деп ойладым.
Dialogue: 0,0:21:43.12,0:21:43.76,JPDB,,0,0,0,,Жеңіс
Dialogue: 0,0:21:44.52,0:21:46.38,JPDB,,0,0,0,,Сіз ештеңе істеген жоқсыз.
Dialogue: 0,0:21:46.54,0:21:47.48,JPDB,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:21:47.80,0:21:49.70,JPDB,,0,0,0,,Екеуіңіз қалыпты жағдайға оралған сияқтысыз.
Dialogue: 0,0:21:49.70,0:21:52.32,JPDB,,0,0,0,,Мен саған айтамын, бұл сүйіспеншілік кездейсоқ болды.
Dialogue: 0,0:21:52.58,0:21:53.98,JPDB,,0,0,0,,Табиғи өлім
Dialogue: 0,0:21:53.98,0:21:55.64,JPDB,,0,0,0,,Неліктен қызыл?
Dialogue: 0,0:21:56.02,0:21:57.64,JPDB,,0,0,0,,Бұл қызыл емес.
Dialogue: 0,0:21:57.64,0:21:59.70,JPDB,,0,0,0,,Бұл сенсің, қызылсың.
Dialogue: 0,0:21:59.86,0:22:01.46,JPDB,,0,0,0,,Өлмеген өлім
Dialogue: 0,0:22:01.72,0:22:03.78,JPDB,,0,0,0,,Бұл шынымен сүйкімді емес.
Dialogue: 0,0:23:32.76,0:23:38.76,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
