Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:05.00,ZZ,,0,0,0,,Бұл субтитр білім беру және алмасу үшін пайдалануға арналған,коммерциялық пайдалануға тыйым салынған құдай субтитрлерінің тіркесімі болып табылады.
Dialogue: 0,0:00:05.00,0:00:10.00,ZZ,,0,0,0,,Жапония: Мори Луо және Анонимді аударма: Мори Луо және Янцзи жапон мектебінің аудармасы: Шао аудармасы мектеп кітабы: Сяо Ай Уақыт беті: Сяо Линг жүйесі: На Ся
Dialogue: 0,0:22:20.90,0:22:24.30,JPED,,0,0,0,,Бүршік атып келе жатқан қараңғы түн аласапыранға түседі
Dialogue: 0,0:22:24.30,0:22:26.74,JPED,,0,0,0,,
Dialogue: 0,0:22:27.12,0:22:31.28,JPED,,0,0,0,,Мәңгіліктен шыққан жеті дыбыс
Dialogue: 0,0:22:31.28,0:22:32.54,JPED,,0,0,0,,
Dialogue: 0,0:22:32.54,0:22:36.50,JPED,,0,0,0,,Сиқырлы балғаның белгісі рифте жарқырайды
Dialogue: 0,0:22:36.50,0:22:38.52,JPED,,0,0,0,,(Мен әлі де жалғастыруды жоспарлап отырмын)
Dialogue: 0,0:22:38.52,0:22:42.28,JPED,,0,0,0,,Аврора сүйіспеншілікпен жарқырайды
Dialogue: 0,0:22:42.28,0:22:44.00,JPED,,0,0,0,,
Dialogue: 0,0:22:44.00,0:22:46.94,JPED,,0,0,0,,Біз бір болдық
Dialogue: 0,0:22:46.94,0:22:49.58,JPED,,0,0,0,,Аспанда ұшу
Dialogue: 0,0:22:49.80,0:22:55.38,JPED,,0,0,0,,Мақтанышпен жарылған отшашу сияқты
Dialogue: 0,0:22:55.46,0:23:00.92,JPED,,0,0,0,,Жылтырлық бір сәтте жарылып кетті
Dialogue: 0,0:23:01.28,0:23:06.98,JPED,,0,0,0,,Сайқымазақ өзінің әділдігін ұшады
Dialogue: 0,0:23:06.98,0:23:12.44,JPED,,0,0,0,,Ақымақ ай сәулесінде адасушылықты сақтайды.
Dialogue: 0,0:23:12.72,0:23:18.40,JPED,,0,0,0,,Ойын бізді қуып жетуге арналған болса
Dialogue: 0,0:23:18.40,0:23:23.26,JPED,,0,0,0,,Ең болмағанда мен шірімейтін ақымақ болғым келеді.
Dialogue: 0,0:23:23.36,0:23:28.78,JPED,,0,0,0,,Көңіл толқып айқайлады
Dialogue: 0,0:23:28.78,0:23:32.96,JPED,,0,0,0,,Бұл әлемді қуу
Dialogue: 0,0:00:49.82,0:00:53.74,JPOP,,0,0,0,,Мен ғашық болғым келеді
Dialogue: 0,0:01:06.58,0:01:10.24,JPOP,,0,0,0,,Арманың жалғасын тапсын
Dialogue: 0,0:01:10.68,0:01:16.14,JPOP,,0,0,0,,Уәде берсем де, жүрегім бір жерден қорқады, ауырады
Dialogue: 0,0:01:16.66,0:01:22.16,JPOP,,0,0,0,,Мен жалғыз емес екенімді сенгім келеді
Dialogue: 0,0:01:22.16,0:01:27.76,JPOP,,0,0,0,,Мен сені ойлау арқылы бақыттымын деп айта алмаймын
Dialogue: 0,0:01:27.76,0:01:30.96,JPOP,,0,0,0,,Мен бос сеніммен жүрсем де
Dialogue: 0,0:01:31.04,0:01:37.90,JPOP,,0,0,0,,Күліп, менің батылдығыма айналасың
Dialogue: 0,0:01:37.90,0:01:42.30,JPOP,,0,0,0,,Бір сөзбен әлеміңді өзгерте алсам
Dialogue: 0,0:01:42.46,0:01:48.38,JPOP,,0,0,0,,Екі махаббат дамитыны рас.
Dialogue: 0,0:01:48.38,0:01:53.44,JPOP,,0,0,0,,Мен ойлану арқылы таптым
Dialogue: 0,0:01:53.58,0:01:56.18,JPOP,,0,0,0,,Мен әрқашан сенің жолыңмен жүрдім
Dialogue: 0,0:01:56.18,0:02:00.80,JPOP,,0,0,0,,Мен оны жеткізуге дайын болмасам да
Dialogue: 0,0:02:00.80,0:02:03.20,JPOP,,0,0,0,,Мен сізге шынымды айтқым келеді
Dialogue: 0,0:02:03.20,0:02:06.16,JPOP,,0,0,0,,Менің жүрегім қандай болса, менің даусым жарқырайды
Dialogue: 0,0:02:06.16,0:02:11.98,JPOP,,0,0,0,,дауысты бұзса, ол жаңғырық береді
Dialogue: 0,0:00:49.82,0:00:53.74,ZWOP,,0,0,0,,Мен ғашық болғым келеді
Dialogue: 0,0:00:01.84,0:00:03.68,JPDB,,0,0,0,,Өкіл жиналысы?
Dialogue: 0,0:00:03.90,0:00:07.21,JPDB,,0,0,0,,Көктемнен бастап үйірмелер саны қайта көбейгендіктен болар.
Dialogue: 0,0:00:07.44,0:00:09.65,JPDB,,0,0,0,,Клуб бөлмелері таусылып бара жатқан сияқты.
Dialogue: 0,0:00:11.20,0:00:14.40,JPDB,,0,0,0,,Алтыншы сиқыршылар соғысы басталып, базалар үшін бәсекелеседі!
Dialogue: 0,0:00:14.52,0:00:15.66,JPDB,,0,0,0,,Ыстық даму өлімі
Dialogue: 0,0:00:15.66,0:00:16.42,JPDB,,0,0,0,,Тыныш.
Dialogue: 0,0:00:17.33,0:00:17.99,JPDB,,0,0,0,,Сонымен
Dialogue: 0,0:00:18.90,0:00:24.08,JPDB,,0,0,0,,Студенттік кеңес барлық үйірмелерді жинап, есеп беру сессиясын өткізгісі келетінін айтты.
Dialogue: 0,0:00:24.24,0:00:26.46,JPDB,,0,0,0,,Мен Тогаши-кун мен оның достарын да келулерін өтіндім.
Dialogue: 0,0:00:27.02,0:00:31.28,JPDB,,0,0,0,,Бұл нақты әрекеті жоқ клубтың клуб бөлмесін алып тастауға арналған жиналыс.
Dialogue: 0,0:00:31.68,0:00:33.66,JPDB,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:00:33.66,0:00:34.29,JPDB,,0,0,0,,Мүлдем солай.
Dialogue: 0,0:00:34.71,0:00:36.96,JPDB,,0,0,0,,Кездесу бүгін сабақтан кейін болатын сияқты.
Dialogue: 0,0:00:37.12,0:00:38.49,JPDB,,0,0,0,,Өкілдер қатысуы керек.
Dialogue: 0,0:00:38.81,0:00:40.70,JPDB,,0,0,0,,Ендеше, өкілі Тоғашы-күн.
Dialogue: 0,0:00:40.93,0:00:41.20,JPDB,,0,0,0,,Жоқ
Dialogue: 0,0:00:41.76,0:00:43.21,JPDB,,0,0,0,,Бұл Рикка-чан, солай ма?
Dialogue: 0,0:02:15.79,0:02:17.84,JPDB,,0,0,0,,Бұл сенбі күні өтетін орын
Dialogue: 0,0:02:18.03,0:02:22.60,JPDB,,0,0,0,,Барлық шешім қабылдайтын органдар Әлемнің тенденциялары осында шешілді ме?
Dialogue: 0,0:02:25.82,0:02:28.17,JPDB,,0,0,0,,Қорқынышты көрінетін адамдар көп.
Dialogue: 0,0:02:28.44,0:02:31.98,JPDB,,0,0,0,,Әрбір клуб қандай да бір түрде клуб бөлмесін алуға тырысады.
Dialogue: 0,0:02:33.52,0:02:34.64,JPDB,,0,0,0,,Икука Рикка
Dialogue: 0,0:02:37.55,0:02:38.08,JPDB,,0,0,0,,Декомори
Dialogue: 0,0:02:38.52,0:02:39.61,JPDB,,0,0,0,,Иә Өлім шебері
Dialogue: 0,0:02:39.96,0:02:45.53,JPDB,,0,0,0,,Бүгін осы уақытта мен Қиыр Шығыс сиқырлы қоғамының командирі қызметін Декомориге тапсырамын.
Dialogue: 0,0:02:48.21,0:02:49.73,JPDB,,0,0,0,,Бұл ұйықтайтын қоғам.
Dialogue: 0,0:02:50.05,0:02:51.59,JPDB,,0,0,0,,Мен қараңғыда өмір сүремін
Dialogue: 0,0:02:52.08,0:02:55.98,JPDB,,0,0,0,,Қоғамдық орындарға осылай шығу үлкен қауіп төндіреді.
Dialogue: 0,0:02:56.41,0:02:57.30,JPDB,,0,0,0,,Сыртқа шыққыңыз келмейді.
Dialogue: 0,0:02:57.30,0:02:59.68,JPDB,,0,0,0,,Юта: Мен жиналысқа қатысу арқылы.
Dialogue: 0,0:03:00.01,0:03:05.13,JPDB,,0,0,0,,Зұлым патшаның Шинганынан асып түсетін қараңғы күш оның айналасындағы қарапайым адамдарға әсер етуі мүмкін.
Dialogue: 0,0:03:05.40,0:03:07.98,JPDB,,0,0,0,,Сондықтан шыққың келмейді.
Dialogue: 0,0:03:11.36,0:03:11.81,JPDB,,0,0,0,,Эй
Dialogue: 0,0:03:12.20,0:03:12.90,JPDB,,0,0,0,,Бұл
Dialogue: 0,0:03:13.76,0:03:15.81,JPDB,,0,0,0,,Кездесу басталғалы жатыр.
Dialogue: 0,0:03:18.58,0:03:22.57,JPDB,,0,0,0,,Тоғашы-күн менімен бірге барса жақсы болар еді деп ойлаймын.
Dialogue: 0,0:03:22.73,0:03:24.12,JPDB,,0,0,0,,Оған көмектесу мүмкін емес, солай ма?
Dialogue: 0,0:03:24.57,0:03:26.36,JPDB,,0,0,0,,Бір ғана өкіл бар дейді.
Dialogue: 0,0:03:26.84,0:03:28.93,JPDB,,0,0,0,,Ұстаз, Қараңғы бір өлімнен күткендей
Dialogue: 0,0:03:28.93,0:03:33.46,JPDB,,0,0,0,,Бүкіл денесіне оранған қара аураға ешкім жақындай алмайды.
Dialogue: 0,0:03:33.60,0:03:34.69,JPDB,,0,0,0,,Ол жай ғана қобалжыған шығар.
Dialogue: 0,0:03:34.97,0:03:40.33,JPDB,,0,0,0,,Қиыр Шығыс сиқырлы ұйықтау қоғамы жаз
Dialogue: 0,0:03:40.33,0:03:42.33,JPDB,,0,0,0,,Бұл менмін, мен сені күттім.
Dialogue: 0,0:03:44.17,0:03:45.80,JPDB,,0,0,0,,әрекеттерді сипаттайды
Dialogue: 0,0:03:45.80,0:03:49.06,JPDB,,0,0,0,,Өкінішке орай, мен бұған жауап бере алмаймын.
Dialogue: 0,0:03:49.44,0:03:51.53,JPDB,,0,0,0,,Менің бірлестігім туралы білетіндер
Dialogue: 0,0:03:51.97,0:03:55.51,JPDB,,0,0,0,,Оған сәйкес тәуекелдер мен өмірге қауіп төнеді.
Dialogue: 0,0:03:55.97,0:03:58.08,JPDB,,0,0,0,,Оның кесірінен бүлінген құлаған періштелер...
Dialogue: 0,0:04:04.77,0:04:06.84,JPDB,,0,0,0,,Қолжазбаны дұрыс жаздыңыз.
Dialogue: 0,0:04:07.02,0:04:09.37,JPDB,,0,0,0,,Жарайды, жалғыз сөйлесуге болмайды.
Dialogue: 0,0:04:11.51,0:04:14.46,JPDB,,0,0,0,,Біздің Қиыр Шығыстағы сиқырлы ұйықтау қоғамының жазы...
Dialogue: 0,0:04:17.17,0:04:20.88,JPDB,,0,0,0,,Қарапайым адам күткендей, зұлым патшаның шынайы көз алдында мүлде үнсіз қалған кішкентай зат.
Dialogue: 0,0:04:20.97,0:04:21.68,JPDB,,0,0,0,,Жеңіс
Dialogue: 0,0:04:21.68,0:04:23.17,JPDB,,0,0,0,,Ұстаздың өлімінен күткендей
Dialogue: 0,0:04:23.17,0:04:25.33,JPDB,,0,0,0,,Қараңғы аура керемет
Dialogue: 0,0:04:25.77,0:04:30.55,JPDB,,0,0,0,,Сөйтіп оны ештеңе айтпастан қуып жіберді.
Dialogue: 0,0:04:30.55,0:04:33.48,JPDB,,0,0,0,,Мені қуып жіберді, дәлірек айтсам, өзім шықтым.
Dialogue: 0,0:04:33.66,0:04:35.68,JPDB,,0,0,0,,Тарихи материалдарға негізделген мәдениеттану…
Dialogue: 0,0:04:35.68,0:04:38.77,JPDB,,0,0,0,,Сіз аздап анық сөйлей аласыз ба?
Dialogue: 0,0:04:42.95,0:04:43.88,JPDB,,0,0,0,,Шарт
Dialogue: 0,0:04:44.66,0:04:45.31,JPDB,,0,0,0,,...
Dialogue: 0,0:04:45.68,0:04:48.52,JPDB,,0,0,0,,Тоғашы-күнмен неге шықпадың?
Dialogue: 0,0:04:48.72,0:04:51.93,JPDB,,0,0,0,,Сондықтан бір ғана өкіл қатыса алады деп шешілді.
Dialogue: 0,0:04:52.06,0:04:55.66,JPDB,,0,0,0,,Мұндай кезде сіз кездесіп жүргеніңізді пайдалануыңыз керек.
Dialogue: 0,0:04:55.89,0:04:56.64,JPDB,,0,0,0,,(Балалардың шуы)
Dialogue: 0,0:04:57.40,0:05:00.05,JPDB,,0,0,0,,Мен Рикка екеуміз бір, екеуміз жалғызбыз.
Dialogue: 0,0:05:00.80,0:05:05.09,JPDB,,0,0,0,,Екі адамды ешкім ажырата алмайды.
Dialogue: 0,0:05:06.54,0:05:08.16,JPDB,,0,0,0,,Жоқ, бұл өте ұят болар еді.
Dialogue: 0,0:05:08.58,0:05:11.17,JPDB,,0,0,0,,Соңғы кездері екеуміз ондай болмайтынбыз.
Dialogue: 0,0:05:11.48,0:05:11.77,JPDB,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:05:13.48,0:05:15.21,JPDB,,0,0,0,,Күн ыстық.
Dialogue: 0,0:05:15.21,0:05:16.33,JPDB,,0,0,0,,Ол қайда?
Dialogue: 0,0:05:16.88,0:05:18.80,JPDB,,0,0,0,,Міне, сені қуып жібереді.
Dialogue: 0,0:05:21.16,0:05:22.49,JPDB,,0,0,0,,Сәлем
Dialogue: 0,0:05:22.78,0:05:23.50,JPDB,,0,0,0,,Мұғалім
Dialogue: 0,0:05:24.16,0:05:26.06,JPDB,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:05:26.49,0:05:27.85,JPDB,,0,0,0,,Арнайы ескертулер шығарылды
Dialogue: 0,0:05:28.73,0:05:29.62,JPDB,,0,0,0,,Студенттік кеңес
Dialogue: 0,0:05:30.01,0:05:34.86,JPDB,,0,0,0,,Иә, олар клуб бөлмесін пайдаланудан басқа ештеңе істеп жатқан сияқты емес.
Dialogue: 0,0:05:35.28,0:05:37.04,JPDB,,0,0,0,,Сіз кеңесші ретінде қалай ойлайсыз?
Dialogue: 0,0:05:37.60,0:05:40.62,JPDB,,0,0,0,,Ал, бұл табиғи реакция ма?
Dialogue: 0,0:05:41.16,0:05:43.14,JPDB,,0,0,0,,Тек оны қайтарыңыз.
Dialogue: 0,0:05:43.14,0:05:44.40,JPDB,,0,0,0,,Сонымен не болды?
Dialogue: 0,0:05:45.53,0:05:50.00,JPDB,,0,0,0,,Мен эдвайзер ретінде үйірме жұмысын тексеріп, бір рет есеп беремін.
Dialogue: 0,0:05:50.37,0:05:53.64,JPDB,,0,0,0,,Сонда Тогаши-кун мен басқалары мұнда не істеп жүр?
Dialogue: 0,0:05:55.76,0:05:56.82,JPDB,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:05:56.93,0:05:57.37,JPDB,,0,0,0,,Иә
Dialogue: 0,0:05:57.97,0:05:59.57,JPDB,,0,0,0,,Сіз кеңесшісіз, солай ма?
Dialogue: 0,0:06:00.02,0:06:03.92,JPDB,,0,0,0,,Дұрыс, бүгін маған студенттік кеңес мүшесі осылай деді.
Dialogue: 0,0:06:05.30,0:06:07.42,JPDB,,0,0,0,,Бірақ сиқырлы шеңберлер және т.б.
Dialogue: 0,0:06:07.69,0:06:09.73,JPDB,,0,0,0,,Сиқырлы нәрсе жасап жатқан шығар
Dialogue: 0,0:06:11.78,0:06:13.37,JPDB,,0,0,0,,Оны қайтарыңыз.
Dialogue: 0,0:06:13.37,0:06:15.04,JPDB,,0,0,0,,Майльнир торнадосы
Dialogue: 0,0:06:15.16,0:06:16.20,JPDB,,0,0,0,,Жоқ сияқты.
Dialogue: 0,0:06:16.49,0:06:17.13,JPDB,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:06:17.92,0:06:19.62,JPDB,,0,0,0,,Бірақ мен ұйықтаймын.
Dialogue: 0,0:06:20.20,0:06:20.89,JPDB,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,0:06:21.17,0:06:21.57,JPDB,,0,0,0,,Иә
Dialogue: 0,0:06:21.92,0:06:22.69,JPDB,,0,0,0,,Ұйқы
Dialogue: 0,0:06:23.08,0:06:25.18,JPDB,,0,0,0,,Иә, бұл атауда.
Dialogue: 0,0:06:25.40,0:06:26.80,JPDB,,0,0,0,,Ұйқы қоғамының жазы
Dialogue: 0,0:06:27.28,0:06:28.10,JPDB,,0,0,0,,Бұл рас
Dialogue: 0,0:06:28.44,0:06:30.20,JPDB,,0,0,0,,Сонда бұл да ұйықтау клубы ма?
Dialogue: 0,0:06:30.20,0:06:31.05,JPDB,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:06:31.37,0:06:35.81,JPDB,,0,0,0,,Жарайды, сиқырлы қоғам тынығып алса да ештеңе шешілмейді.
Dialogue: 0,0:06:35.97,0:06:39.68,JPDB,,0,0,0,,Олай емес. Егер бұл ұйықтау клубы болса, онда ешқандай проблема жоқ.
Dialogue: 0,0:06:40.85,0:06:42.90,JPDB,,0,0,0,,Ұйқы чемпионаты деген бар ма?
Dialogue: 0,0:06:42.94,0:06:47.40,JPDB,,0,0,0,,Иә, Еуропада жарыстар өткізіледі.
Dialogue: 0,0:06:47.89,0:06:50.73,JPDB,,0,0,0,,Ұйқыларды жақсы немесе нашар деп қалай бағалаймыз?
Dialogue: 0,0:06:50.77,0:06:55.53,JPDB,,0,0,0,,Ұйықтау жылдамдығын, ұйықтау қалпын және ұйқының тереңдігін білесіз.
Dialogue: 0,0:06:55.77,0:06:58.96,JPDB,,0,0,0,,Содан кейін оянғанша жалпы уақытты шешіңіз.
Dialogue: 0,0:06:59.17,0:07:00.92,JPDB,,0,0,0,,Күмін-сенпайды білесің бе?
Dialogue: 0,0:07:01.05,0:07:03.42,JPDB,,0,0,0,,Иә, мен ұйықтауды зерттеп жатырмын.
Dialogue: 0,0:07:03.69,0:07:07.02,JPDB,,0,0,0,,Осылайша мен мұғалім менің танысым болатын мектепке бардым.
Dialogue: 0,0:07:07.26,0:07:09.45,JPDB,,0,0,0,,Сиеста клубы болды.
Dialogue: 0,0:07:09.66,0:07:10.46,JPDB,,0,0,0,,Сиеста
Dialogue: 0,0:07:11.61,0:07:12.40,JPDB,,0,0,0,,Мұнда күт
Dialogue: 0,0:07:12.66,0:07:14.38,JPDB,,0,0,0,,Дұрыс, ұстаз.
Dialogue: 0,0:07:14.49,0:07:16.78,JPDB,,0,0,0,,Ұйқыға арналған испан тілі
Dialogue: 0,0:07:17.38,0:07:21.40,JPDB,,0,0,0,,Мәселен, егер сіз сол елмен шетелде ойын ойнап жатсаңыз, онда
Dialogue: 0,0:07:21.73,0:07:23.44,JPDB,,0,0,0,,Студенттер кеңесі де мойындауы керек.
Dialogue: 0,0:07:24.34,0:07:25.12,JPDB,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:07:26.25,0:07:30.50,JPDB,,0,0,0,,Содан кейін мен басқа мектепке олардың шетелдік ойын ойнағысы келетінін сұрайтын электрондық хат жіберемін.
Мен айтқым келеді
Dialogue: 0,0:07:30.57,0:07:31.34,JPDB,,0,0,0,,А, жақсы
Dialogue: 0,0:07:32.22,0:07:33.58,JPDB,,0,0,0,,...
Dialogue: 0,0:07:34.16,0:07:38.13,JPDB,,0,0,0,,Арамызда дұрыс ұйықтайтын Күмін-сенпай ғана.
Dialogue: 0,0:07:38.46,0:07:40.40,JPDB,,0,0,0,,Ойын кенет қиын болды ма?
Dialogue: 0,0:07:40.92,0:07:41.82,JPDB,,0,0,0,,Жарайды
Dialogue: 0,0:07:42.02,0:07:45.24,JPDB,,0,0,0,,Бұл соншалықты қиын емес, мен саған үйретемін.
Dialogue: 0,0:07:45.64,0:07:46.37,JPDB,,0,0,0,,Бұл рас па?
Dialogue: 0,0:07:47.00,0:07:49.16,JPDB,,0,0,0,,Иә, оны маған қалдырыңыз.
Dialogue: 0,0:07:49.66,0:07:50.89,JPDB,,0,0,0,,Қараңғылық келе жатыр
Dialogue: 0,0:07:51.41,0:07:52.22,JPDB,,0,0,0,,Демек, бұл… иллюзия.
Dialogue: 0,0:07:52.57,0:07:54.28,JPDB,,0,0,0,,Пойыздардан сақ болыңыз
Dialogue: 0,0:07:54.94,0:07:58.57,JPDB,,0,0,0,,Солай бола тұрса да, ұйықтау – соншалықты терең нәрсе.
Dialogue: 0,0:07:59.04,0:08:03.26,JPDB,,0,0,0,,Иә, әдемі ұйықтау өте қиын.
Dialogue: 0,0:08:03.68,0:08:05.90,JPDB,,0,0,0,,Майдан жұмысшылары қалай ұйықтайды?
Dialogue: 0,0:08:06.04,0:08:08.56,JPDB,,0,0,0,,Бұл әдемі және әсерлі.
Dialogue: 0,0:08:09.08,0:08:09.84,JPDB,,0,0,0,,Солай ма?
Dialogue: 0,0:08:10.56,0:08:11.00,JPDB,,0,0,0,,Иә
Dialogue: 0,0:08:11.56,0:08:14.80,JPDB,,0,0,0,,Сол қалпы, сол ыңғайлы өрнек
Dialogue: 0,0:08:15.33,0:08:19.81,JPDB,,0,0,0,,Ұйқының тереңдігін терең ұйқы деп атауға болмайды.
Dialogue: 0,0:08:20.26,0:08:21.81,JPDB,,0,0,0,,ұқсайды
Dialogue: 0,0:08:26.64,0:08:27.12,JPDB,,0,0,0,,(Үш мүйізді) Құрлықтағыдай еркін қозғала алмайсың. Көресің әлі!
Dialogue: 0,0:08:29.14,0:08:33.18,JPDB,,0,0,0,,Бірақ мұндай оқиғадан кейін сіз ғажайып адам болып көріне бастайсыз.
Dialogue: 0,0:08:33.52,0:08:33.98,JPDB,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:08:34.84,0:08:35.54,JPDB,,0,0,0,,Бұл
Dialogue: 0,0:08:37.08,0:08:37.56,JPDB,,0,0,0,,Иә
Dialogue: 0,0:08:37.97,0:08:43.14,JPDB,,0,0,0,,Сіз Гинко Гакуэн орта мектебінде ұйықтау клубының мүшесісіз бе?
Dialogue: 0,0:08:43.53,0:08:45.12,JPDB,,0,0,0,,Иә, бірақ
Dialogue: 0,0:08:46.04,0:08:51.76,JPDB,,0,0,0,,Менің атым Нему және мен Момиджигаока орта мектебінің Siesta клубының өкілімін.
Dialogue: 0,0:08:53.05,0:08:54.26,JPDB,,0,0,0,,Сиеста клубы
Dialogue: 0,0:08:54.61,0:08:57.98,JPDB,,0,0,0,,Не? Бүкіл денемнен толып жатқан бұл ұйқышыл аура не?
Dialogue: 0,0:08:58.48,0:09:00.65,JPDB,,0,0,0,,Менің бүкіл денемдегі ұйқышылдық
Dialogue: 0,0:09:07.13,0:09:08.10,JPDB,,0,0,0,,Өлім шебері
Dialogue: 0,0:09:08.45,0:09:09.97,JPDB,,0,0,0,,Өлім сорып алды
Dialogue: 0,0:09:10.54,0:09:11.28,JPDB,,0,0,0,,Декомори
Dialogue: 0,0:09:11.78,0:09:16.09,JPDB,,0,0,0,,Маған кеңесшім қоңырау шалды, ол біраз уақыттан бері бірінші рет матчқа өтініш берді.
Dialogue: 0,0:09:16.16,0:09:18.17,JPDB,,0,0,0,,Сәлем айтқым келді.
Dialogue: 0,0:09:18.17,0:09:19.53,JPDB,,0,0,0,,Әй, неге әуре?
Dialogue: 0,0:09:19.88,0:09:20.41,JPDB,,0,0,0,,Бірақ
Dialogue: 0,0:09:20.73,0:09:21.09,JPDB,,0,0,0,,Бірақ
Dialogue: 0,0:09:21.82,0:09:23.69,JPDB,,0,0,0,,Мұның қажеті жоқ еді.
Dialogue: 0,0:09:24.10,0:09:24.38,JPDB,,0,0,0,,Иә?
Dialogue: 0,0:09:25.48,0:09:30.25,JPDB,,0,0,0,,Менің байқағаным, ол ұйықтап жатқанын байыппен қабылдамайтын сияқты.
Dialogue: 0,0:09:30.54,0:09:33.84,JPDB,,0,0,0,,Бұл негізінен жай ғана ойнайтын клуб шығар.
Dialogue: 0,0:09:34.02,0:09:35.04,JPDB,,0,0,0,,...
Dialogue: 0,0:09:35.34,0:09:36.69,JPDB,,0,0,0,,(Идзуми) Уау! Бұл өте қызықты естіледі.
Dialogue: 0,0:09:37.20,0:09:42.13,JPDB,,0,0,0,,Өздерін ұйықтау клубтары деп атайтын көптеген орындар дәл сіз сияқты.
Dialogue: 0,0:09:42.76,0:09:48.50,JPDB,,0,0,0,,Дегенмен, біз Siesta клубында ұйықтауға мән береміз.
Dialogue: 0,0:09:49.02,0:09:53.02,JPDB,,0,0,0,,Адамдардың тек көңіл көтеру үшін сіріңкеге өтініш бермегенін қалаймын.
Dialogue: 0,0:09:53.60,0:09:55.01,JPDB,,0,0,0,,Қандай кездейсоқ кездесу, Хиёри
Dialogue: 0,0:09:56.05,0:09:56.98,JPDB,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:09:57.77,0:10:01.82,JPDB,,0,0,0,,Сәйкестік болмайды, сондықтан кеңесшіге хабарлаңыз.
Dialogue: 0,0:10:02.30,0:10:04.41,JPDB,,0,0,0,,Бұл жай ғана көңіл көтеру үшін емес.
Dialogue: 0,0:10:06.20,0:10:07.37,JPDB,,0,0,0,,Тіпті қалжыңдамайды да.
Dialogue: 0,0:10:07.93,0:10:08.76,JPDB,,0,0,0,,Кумин Сенпай
Dialogue: 0,0:10:09.40,0:10:14.04,JPDB,,0,0,0,,Қиыр Шығыс сиқырлы ұйықтау қоғамы әрқашан жазда белсенді.
Dialogue: 0,0:10:14.58,0:10:15.74,JPDB,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:10:15.89,0:10:19.29,JPDB,,0,0,0,,Е, а, Тоғашы-күн
Dialogue: 0,0:10:20.46,0:10:21.98,JPDB,,0,0,0,,...
Dialogue: 0,0:10:23.14,0:10:24.05,JPDB,,0,0,0,,Мастер
Dialogue: 0,0:10:25.96,0:10:27.85,JPDB,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:30.04,0:10:34.56,JPDB,,0,0,0,,Сондықтан мұны маңызды шайқас деп қабылдау қауіпсіз.
Dialogue: 0,0:10:35.06,0:10:36.00,JPDB,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:10:36.29,0:10:39.21,JPDB,,0,0,0,,Мен зұлым патша Шинганға ант етемін, шайқастар әрқашан ауыр болады.
Dialogue: 0,0:10:39.62,0:10:40.80,JPDB,,0,0,0,,Жеңілсең, сәтсіздікке дайындал
Dialogue: 0,0:10:41.21,0:10:42.84,JPDB,,0,0,0,,Өртенген өлім шебері
Dialogue: 0,0:10:43.00,0:10:45.66,JPDB,,0,0,0,,Егер мен бұл шайқаста жеңілсем,
Dialogue: 0,0:10:45.93,0:10:46.52,JPDB,,0,0,0,,Бұл жағдайда
Dialogue: 0,0:10:47.64,0:10:48.97,JPDB,,0,0,0,,Қауымдастықты тарату
Dialogue: 0,0:11:00.08,0:11:01.41,JPDB,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:11:01.85,0:11:04.93,JPDB,,0,0,0,,Сіздің немқұрайлы мінезіңіз туралы бірдеңе жасаңыз.
Dialogue: 0,0:11:05.81,0:11:08.49,JPDB,,0,0,0,,Ұрыстар жағдайға байланысты өзгереді...
Dialogue: 0,0:11:10.01,0:11:11.01,JPDB,,0,0,0,,Орындалды
Dialogue: 0,0:11:11.97,0:11:15.05,JPDB,,0,0,0,,Бұл ресми ойын алаңы ма?
Dialogue: 0,0:11:15.48,0:11:18.58,JPDB,,0,0,0,,Иә, оны Жапонияның орта мектептегі ұйықтау федерациясы ресми түрде таниды.
Dialogue: 0,0:11:18.96,0:11:20.61,JPDB,,0,0,0,,Кәсіби нұсқа сәл үлкенірек.
Dialogue: 0,0:11:20.61,0:11:21.10,JPDB,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:11:23.50,0:11:26.29,JPDB,,0,0,0,,Командалық шайқастар әр командада бес адамнан өтеді.
Dialogue: 0,0:11:26.62,0:11:28.69,JPDB,,0,0,0,,Қаншалықты тез ұйықтауға болады?
Dialogue: 0,0:11:28.81,0:11:31.17,JPDB,,0,0,0,,Сонымен қатар көркемдік нүктелер мен қалып нүктелері бар.
Dialogue: 0,0:11:31.61,0:11:32.85,JPDB,,0,0,0,,Бұл өте күрделі.
Dialogue: 0,0:11:33.37,0:11:34.89,JPDB,,0,0,0,,Олай болса бір рет байқап көрейік
Dialogue: 0,0:11:35.30,0:11:39.69,JPDB,,0,0,0,,Дәл қазір өз қалпыңыз туралы көп уайымдамаңыз, алдымен ұйықтауды ойлаңыз.
Dialogue: 0,0:11:39.81,0:11:42.13,JPDB,,0,0,0,,Менің драма үйірмем де бар.
Dialogue: 0,0:11:42.20,0:11:45.54,JPDB,,0,0,0,,Сіз кеткен бойда тарау туралы шешім қабылданады.
Dialogue: 0,0:11:47.16,0:11:48.48,JPDB,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:11:51.49,0:11:54.50,JPDB,,0,0,0,,Ұйықтау оңай емес.
Dialogue: 0,0:11:55.06,0:11:56.90,JPDB,,0,0,0,,Әзірше көзіңізді жұмыңыз
Dialogue: 0,0:12:05.13,0:12:08.25,JPDB,,0,0,0,,Бұл дауыс...Которию-сан
Dialogue: 0,0:12:09.05,0:12:10.37,JPDB,,0,0,0,,Юта Юта
Dialogue: 0,0:12:10.37,0:12:11.94,JPDB,,0,0,0,,Сен не істеп жатырсың?
Dialogue: 0,0:12:14.05,0:12:15.17,JPDB,,0,0,0,,Юта
Dialogue: 0,0:12:15.17,0:12:15.93,JPDB,,0,0,0,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:12:19.58,0:12:20.52,JPDB,,0,0,0,,Жоқ, бірақ Йор-чан менің байқамай тұрғанымда үйленіп кеткеніне сенбеймін.
Dialogue: 0,0:12:21.29,0:12:22.69,JPDB,,0,0,0,,Цк, әртүрлі өлім
Dialogue: 0,0:12:22.86,0:12:24.84,JPDB,,0,0,0,,Бұл
Dialogue: 0,0:12:24.96,0:12:25.85,JPDB,,0,0,0,,Юта…
Dialogue: 0,0:12:27.18,0:12:29.73,JPDB,,0,0,0,,Менің денем қозғалмайды.
Dialogue: 0,0:12:29.73,0:12:30.65,JPDB,,0,0,0,,құлдық?
Dialogue: 0,0:12:30.76,0:12:31.82,JPDB,,0,0,0,,Табиғи өлім
Dialogue: 0,0:12:32.05,0:12:36.74,JPDB,,0,0,0,,Ұстаз сіз сияқты жаман, күмәнді нәрселерді ойлайтындардан ерекшеленеді.
Dialogue: 0,0:12:36.88,0:12:38.74,JPDB,,0,0,0,,Мен ештеңе айтпас едім
Dialogue: 0,0:12:38.96,0:12:41.42,JPDB,,0,0,0,,Көлеңке дегенді қалай түсінесіңдер?
Dialogue: 0,0:12:41.42,0:12:43.02,JPDB,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:12:43.34,0:12:44.54,JPDB,,0,0,0,,Омасан
Dialogue: 0,0:12:44.77,0:12:47.45,JPDB,,0,0,0,,Тыныш өлім, Жалған жаз
Dialogue: 0,0:12:47.45,0:12:49.28,JPDB,,0,0,0,,Эй, тоқта!
Dialogue: 0,0:12:49.32,0:12:50.12,JPDB,,0,0,0,,Шулы өлім
Dialogue: 0,0:12:50.12,0:12:52.88,JPDB,,0,0,0,,Жоқ, мен дұрыс ұйықтауым керек.
Dialogue: 0,0:12:53.33,0:12:55.04,JPDB,,0,0,0,,Келесі жолы мен далада ұйықтаймын.
Dialogue: 0,0:12:55.46,0:13:00.57,JPDB,,0,0,0,,Қоршаған орта өзгерсе де бірдей ұйықтау түнгі ұйқы үшін өте маңызды.
Dialogue: 0,0:13:01.20,0:13:02.14,JPDB,,0,0,0,,Мұнда?
Dialogue: 0,0:13:02.53,0:13:03.84,JPDB,,0,0,0,,Осындай жерде
Dialogue: 0,0:13:03.97,0:13:04.52,JPDB,,0,0,0,,Ах! Джибрил, қайдан шығып қалдың?
Dialogue: 0,0:13:05.22,0:13:07.53,JPDB,,0,0,0,,Жарық, жарық заттар шабуылдаған өлім
Dialogue: 0,0:13:08.33,0:13:12.65,JPDB,,0,0,0,,Schwarz Shield прототипінің белгісі Ⅳ
Dialogue: 0,0:13:14.78,0:13:15.96,JPDB,,0,0,0,,Олай болса жүзейік
Dialogue: 0,0:13:16.29,0:13:17.13,JPDB,,0,0,0,,Бұл кенеттен болды ма?
Dialogue: 0,0:13:17.68,0:13:22.33,JPDB,,0,0,0,,Иә, ыңғайлы шаршау - жақсы ұйықтаудың ең жақсы тәсілі.
Dialogue: 0,0:13:22.72,0:13:24.30,JPDB,,0,0,0,,Бірақ неге бассейн?
Dialogue: 0,0:13:24.30,0:13:25.96,JPDB,,0,0,0,,Кіруге әлі тым суық.
Dialogue: 0,0:13:26.45,0:13:30.38,JPDB,,0,0,0,,Мен көрдім. Өкінішті. Жүзу - ең жақсысы.
Dialogue: 0,0:13:30.58,0:13:33.22,JPDB,,0,0,0,,Суға түскеннен кейінгі ұйқы деп аталады.
Dialogue: 0,0:13:33.50,0:13:34.30,JPDB,,0,0,0,,Бұл сөз тіркесі ме?
Dialogue: 0,0:13:34.49,0:13:36.05,JPDB,,0,0,0,,Әй, Өлім мұнда кел.
Dialogue: 0,0:13:37.16,0:13:38.76,JPDB,,0,0,0,,Бұл...Исшики
Dialogue: 0,0:13:39.22,0:13:40.42,JPDB,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:13:40.92,0:13:44.08,JPDB,,0,0,0,,Жарайды, Күмін сенпайды естіген шығар.
Dialogue: 0,0:13:44.40,0:13:47.22,JPDB,,0,0,0,,Сіз мұнда ұйықтай алатыныңызды көрсету үшін келдіңіз.
Dialogue: 0,0:13:49.20,0:13:49.74,JPDB,,0,0,0,,Үйге барасыз ба?
Dialogue: 0,0:13:50.26,0:13:50.72,JPDB,,0,0,0,,Иә.
Dialogue: 0,0:13:52.54,0:13:53.62,JPDB,,0,0,0,,Кумин Сенпай
Dialogue: 0,0:13:55.78,0:13:58.10,JPDB,,0,0,0,,Бұл мен ойлағаннан да қиын. Ұйықтау
Dialogue: 0,0:13:59.09,0:14:01.42,JPDB,,0,0,0,,Дайын бол, ұйықтай бер десең де, мен жасамаймын.
Dialogue: 0,0:14:02.65,0:14:05.18,JPDB,,0,0,0,,Уайымдама, Джау Шинган құдіретті.
Dialogue: 0,0:14:06.00,0:14:07.26,JPDB,,0,0,0,,Ұстаздың өлімінен күткендей
Dialogue: 0,0:14:07.64,0:14:09.25,JPDB,,0,0,0,,Сіз осылай айтып тұрсыз ба?
Dialogue: 0,0:14:09.50,0:14:10.97,JPDB,,0,0,0,,Жеңілсек, тараймыз.
Dialogue: 0,0:14:11.40,0:14:12.84,JPDB,,0,0,0,,Сізге тек жеңіске жету керек
Dialogue: 0,0:14:14.82,0:14:15.42,JPDB,,0,0,0,,Юта
Dialogue: 0,0:14:15.42,0:14:16.04,JPDB,,0,0,0,,Мен бе?
Dialogue: 0,0:14:16.16,0:14:18.17,JPDB,,0,0,0,,Жарайды, барлығына.
Dialogue: 0,0:14:18.54,0:14:20.57,JPDB,,0,0,0,,Бұл мызғымас сенімділік деген не?
Dialogue: 0,0:14:24.41,0:14:25.81,JPDB,,0,0,0,,Декомори Жақсы уақыт
Dialogue: 0,0:14:25.81,0:14:26.25,JPDB,,0,0,0,,Демек, бұл… иллюзия.
Dialogue: 0,0:14:26.56,0:14:28.05,JPDB,,0,0,0,,Оны неге рұқсатсыз дайындадың?
Dialogue: 0,0:14:28.50,0:14:30.44,JPDB,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:14:30.74,0:14:33.36,JPDB,,0,0,0,,Менің ойымша, сіз өз стратегияңыз туралы аздап ойлануыңыз керек.
Dialogue: 0,0:14:33.68,0:14:35.97,JPDB,,0,0,0,,Стратегия деп аталса да, ұйқы ойыны шығар.
Dialogue: 0,0:14:36.28,0:14:38.77,JPDB,,0,0,0,,Ұйықтаудың жақсы жолы болмаса.
Dialogue: 0,0:14:39.21,0:14:39.81,JPDB,,0,0,0,,Иә.
Dialogue: 0,0:14:40.44,0:14:42.56,JPDB,,0,0,0,,Ойланып қарасаңыз, оңай жолы бар.
Dialogue: 0,0:14:44.18,0:14:46.29,JPDB,,0,0,0,,Таңмен бірге қараңғылық сейілгенше
Dialogue: 0,0:14:46.64,0:14:48.28,JPDB,,0,0,0,,Бірге күресейік
Dialogue: 0,0:14:48.88,0:14:50.12,JPDB,,0,0,0,,Әрине
Dialogue: 0,0:14:50.40,0:14:53.48,JPDB,,0,0,0,,Осылай бәріміз таңға дейін ұйықтамай тұрдық.
Dialogue: 0,0:14:53.65,0:14:55.69,JPDB,,0,0,0,,Матч кезінде ұйқыңыз келетіні сөзсіз.
Dialogue: 0,0:14:56.01,0:14:56.76,JPDB,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:56.96,0:14:59.60,JPDB,,0,0,0,,Ұйқы үшін онша әдемі емес
Dialogue: 0,0:15:00.00,0:15:03.28,JPDB,,0,0,0,,Мен бәрібір ұйықтағаннан кейін не болатынын басқара алмаймын.
Dialogue: 0,0:15:03.97,0:15:06.18,JPDB,,0,0,0,,Біріншіден, ерте ұйықтау маңызды емес пе?
Dialogue: 0,0:15:06.50,0:15:07.60,JPDB,,0,0,0,,Бұл да дұрыс.
Dialogue: 0,0:15:07.98,0:15:09.05,JPDB,,0,0,0,,Олай болса асықпаңыз.
Dialogue: 0,0:15:09.86,0:15:10.17,JPDB,,0,0,0,,О
Dialogue: 0,0:15:10.36,0:15:11.21,JPDB,,0,0,0,,Қайырлы түн
Dialogue: 0,0:15:11.93,0:15:14.14,JPDB,,0,0,0,,Бұл қалай болуы мүмкін?
Dialogue: 0,0:15:14.14,0:15:15.92,JPDB,,0,0,0,,Шыққан өлім, ұлы кедейлер
Dialogue: 0,0:15:17.24,0:15:20.74,JPDB,,0,0,0,,Өлімді параллель жеу Бейшара патша Патша жарылғыш өлім
Dialogue: 0,0:15:20.74,0:15:23.38,JPDB,,0,0,0,,Жоқ, менің камабоко фабрикам
Dialogue: 0,0:15:23.66,0:15:26.13,JPDB,,0,0,0,,Иә, елу комбо
Dialogue: 0,0:15:29.21,0:15:35.61,JPDB,,0,0,0,,I Жарқыраған монохромды құбыжық
Dialogue: 0,0:15:35.78,0:15:38.74,JPDB,,0,0,0,,Сіз кезіп жүрген виртуалды әлем
Dialogue: 0,0:15:42.70,0:15:43.84,JPDB,,0,0,0,,Юта
Dialogue: 0,0:15:44.01,0:15:45.24,JPDB,,0,0,0,,Батыл
Dialogue: 0,0:15:54.97,0:15:56.74,JPDB,,0,0,0,,Бұл не?
Dialogue: 0,0:15:59.44,0:16:00.36,JPDB,,0,0,0,,Қайырлы таң, батыр
Dialogue: 0,0:16:03.00,0:16:04.29,JPDB,,0,0,0,,Тоғашы-күн, болды.
Dialogue: 0,0:16:04.52,0:16:04.96,JPDB,,0,0,0,,Иә?
Dialogue: 0,0:16:04.96,0:16:07.86,JPDB,,0,0,0,,Егер Dark Frame Master қараңғы жаққа бұрылса ше?
Dialogue: 0,0:16:07.86,0:16:08.50,JPDB,,0,0,0,,Жоқ
Dialogue: 0,0:16:09.72,0:16:12.72,JPDB,,0,0,0,,Кешіріңіз, кешіріңіз, менің ескі әдеттерім ақыры шықты.
Dialogue: 0,0:16:13.12,0:16:17.13,JPDB,,0,0,0,,Батыр мен зұлым патша Шинган ғашықтар келісімімен байланысты деп айтылады.
Dialogue: 0,0:16:17.66,0:16:19.00,JPDB,,0,0,0,,Мен мұны қайтарамын.
Dialogue: 0,0:16:20.56,0:16:22.04,JPDB,,0,0,0,,Бұл не?
Dialogue: 0,0:16:23.26,0:16:24.01,JPDB,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:16:24.89,0:16:25.94,JPDB,,0,0,0,,Кішкене ғана.
Dialogue: 0,0:16:26.33,0:16:27.42,JPDB,,0,0,0,,Өлім кетті
Dialogue: 0,0:16:29.06,0:16:30.50,JPDB,,0,0,0,,Тұз себіңіз Тұз камфора жапырағы
Dialogue: 0,0:16:30.76,0:16:34.44,JPDB,,0,0,0,,Одан гөрі, ағайындар, ұйықтамайсыздар ма?
Dialogue: 0,0:16:35.46,0:16:37.57,JPDB,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:16:38.06,0:16:41.18,JPDB,,0,0,0,,Жарайды, бұл да сиқырлы жын қыздың жоспары.
Dialogue: 0,0:16:41.37,0:16:44.29,JPDB,,0,0,0,,Жоқ, алдымен ұйықтап қалғанымыз өзімізден шығар.
Dialogue: 0,0:16:44.85,0:16:45.65,JPDB,,0,0,0,,Асығыңыз!
Dialogue: 0,0:16:47.16,0:16:51.86,JPDB,,0,0,0,,Енді Ginkgo Academy High School Far East Magical Nap қоғамының жазғы матчы...
Dialogue: 0,0:16:52.29,0:16:56.38,JPDB,,0,0,0,,Момиджигаока орта мектебінің сиеста клубы үшін жаттығу матчы өтеді.
Dialogue: 0,0:16:56.98,0:16:58.53,JPDB,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:16:59.04,0:17:02.34,JPDB,,0,0,0,,Мен өзімді жеңе алатындай сезінбеймін.
Dialogue: 0,0:17:04.42,0:17:07.61,JPDB,,0,0,0,,Осы кезде оның ояу немесе ояу екенін де айта алмаймын.
Dialogue: 0,0:17:07.70,0:17:10.25,JPDB,,0,0,0,,Сөзсіз арман әлемінің тұрғыны
Dialogue: 0,0:17:10.94,0:17:11.44,JPDB,,0,0,0,,Қауіп
Dialogue: 0,0:17:12.00,0:17:15.40,JPDB,,0,0,0,,Уәде етілгендей, жеңілсек, тараймыз.
Dialogue: 0,0:17:16.00,0:17:21.53,JPDB,,0,0,0,,Мен адамдар өздерін «Ұйқы клубы» деп ойнайтын кем дегенде бір бөліктің жоғалғанын көргім келеді.
Dialogue: 0,0:17:22.52,0:17:23.77,JPDB,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:17:24.00,0:17:26.04,JPDB,,0,0,0,,Қалай ойласаң да жеңе алмайсың.
Dialogue: 0,0:17:26.20,0:17:28.81,JPDB,,0,0,0,,Барлығы тыныш ұйықтап, терісі тегіс болды.
Dialogue: 0,0:17:29.21,0:17:30.90,JPDB,,0,0,0,,Бізге қалған қолдар
Dialogue: 0,0:17:31.82,0:17:33.70,JPDB,,0,0,0,,Мен әлі кешірім сұрай аламын.
Dialogue: 0,0:17:34.29,0:17:34.94,JPDB,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:17:35.74,0:17:37.26,JPDB,,0,0,0,,Біз жеңілмейміз
Dialogue: 0,0:17:37.60,0:17:39.77,JPDB,,0,0,0,,Бұл бөлік соншалықты жалқау емес.
Dialogue: 0,0:17:40.33,0:17:41.16,JPDB,,0,0,0,,Кумин Сенпай
Dialogue: 0,0:17:41.65,0:17:44.85,JPDB,,0,0,0,,Мен Рикка-чанды алғаш көргенде солай ойладым.
Dialogue: 0,0:17:46.08,0:17:47.46,JPDB,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:17:47.70,0:17:48.62,JPDB,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:17:49.37,0:17:53.38,JPDB,,0,0,0,,Басқаша айтқанда, біздің шынайы мақсатымыз – көрінбейтін шекараны зерттеу.
Dialogue: 0,0:17:54.17,0:17:56.61,JPDB,,0,0,0,,Бірақ іс-шаралар мұнымен бітпейді.
Dialogue: 0,0:17:57.60,0:18:00.24,JPDB,,0,0,0,,Бұл біздің бірлестігіміз
Dialogue: 0,0:18:02.28,0:18:03.89,JPDB,,0,0,0,,Сол кезде мен ойладым
Dialogue: 0,0:18:04.57,0:18:09.41,JPDB,,0,0,0,,Мен Рикка-чанмен және басқалармен жұмыс істей алатындай сезінемін.
Dialogue: 0,0:18:09.93,0:18:12.98,JPDB,,0,0,0,,Менімен жүр, басқа адам Чуунибиоу.
Dialogue: 0,0:18:13.45,0:18:18.10,JPDB,,0,0,0,,Иә, бірақ менің ойымша, адамдар мұны түсінбейді.
Dialogue: 0,0:18:18.32,0:18:21.73,JPDB,,0,0,0,,Адамдар ауыр жұмыс істеп жатқан немесе байсалды болған жерде.
Dialogue: 0,0:18:22.49,0:18:23.78,JPDB,,0,0,0,,Ұйқы клубымен бірдей шығар
Dialogue: 0,0:18:25.08,0:18:25.65,JPDB,,0,0,0,,Кумин
Dialogue: 0,0:18:26.10,0:18:30.22,JPDB,,0,0,0,,Қиыр Шығыс сиқырлы ұйықтау қоғамы жазда қатты ұйықтайды.
Dialogue: 0,0:18:31.00,0:18:32.62,JPDB,,0,0,0,,Қатты ойна
Dialogue: 0,0:18:33.30,0:18:35.66,JPDB,,0,0,0,,Мен қудалау үшін көп жұмыс істеп жатырмын.
Dialogue: 0,0:18:36.42,0:18:37.58,JPDB,,0,0,0,,Сондықтан мен жеңілмеймін
Dialogue: 0,0:18:39.36,0:18:40.20,JPDB,,0,0,0,,Бұл ең күшті
Dialogue: 0,0:18:43.12,0:18:43.64,JPDB,,0,0,0,,Иә
Dialogue: 0,0:18:44.37,0:18:45.46,JPDB,,0,0,0,,Explode Real
Dialogue: 0,0:18:45.46,0:18:46.65,JPDB,,0,0,0,,Pop Synapse
Dialogue: 0,0:18:46.65,0:18:49.58,JPDB,,0,0,0,,Бұл әлемді қуу
Dialogue: 0,0:19:01.41,0:19:04.12,JPDB,,0,0,0,,Бұл ұйқы әлемі біздікі
Dialogue: 0,0:19:04.80,0:19:06.46,JPDB,,0,0,0,,Тез кетіңіз
Dialogue: 0,0:19:06.56,0:19:09.45,JPDB,,0,0,0,,Авалон Смашер
Dialogue: 0,0:19:13.38,0:19:15.18,JPDB,,0,0,0,,Мжолнир Хаммер
Dialogue: 0,0:19:23.28,0:19:23.85,JPDB,,0,0,0,,Дисквалификация
Dialogue: 0,0:19:25.68,0:19:29.89,JPDB,,0,0,0,,Мені Қараңғы жалын иесінің қараңғы оттары құшақтады...
Dialogue: 0,0:19:31.33,0:19:32.12,JPDB,,0,0,0,,Дисквалификация
Dialogue: 0,0:19:35.06,0:19:36.41,JPDB,,0,0,0,,Неге тек мен?
Dialogue: 0,0:19:38.37,0:19:40.10,JPDB,,0,0,0,,Менің аяғым ауырды
Dialogue: 0,0:19:40.10,0:19:40.80,JPDB,,0,0,0,,Дисквалификация
Dialogue: 0,0:19:43.64,0:19:44.70,JPDB,,0,0,0,,Қалғаны сол
Dialogue: 0,0:19:45.13,0:19:46.64,JPDB,,0,0,0,,Тек осы екеуі өлді
Dialogue: 0,0:19:47.04,0:19:51.01,JPDB,,0,0,0,,NREM өлтіру әдісі Циркадиандық ырғақты бұзу
Dialogue: 0,0:19:52.97,0:19:54.38,JPDB,,0,0,0,,Тағдыр сақинасы
Dialogue: 0,0:19:57.94,0:20:00.92,JPDB,,0,0,0,,Неліктен сенде сонша күш болса да?
Dialogue: 0,0:20:01.66,0:20:04.42,JPDB,,0,0,0,,Егер байсалды болсақ, дүниені көздеп алар едік.
Dialogue: 0,0:20:04.94,0:20:08.09,JPDB,,0,0,0,,Маған бұл жер ұнайды.
Dialogue: 0,0:20:10.70,0:20:11.81,JPDB,,0,0,0,,Мынау
Dialogue: 0,0:20:17.58,0:20:19.97,JPDB,,0,0,0,,Сондықтан мен ол жерді қорғаймын
Dialogue: 0,0:20:21.56,0:20:22.90,JPDB,,0,0,0,,Ұйқыдағы адамның оянуы
Dialogue: 0,0:20:34.84,0:20:37.26,JPDB,,0,0,0,,Күмін сенпай Күмін сенпай
Dialogue: 0,0:20:42.68,0:20:44.62,JPDB,,0,0,0,,Тоғаши-кун бәрі
Dialogue: 0,0:20:44.97,0:20:45.74,JPDB,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:20:46.29,0:20:47.25,JPDB,,0,0,0,,Біз жеңеміз.
Dialogue: 0,0:20:47.62,0:20:49.00,JPDB,,0,0,0,,Кумин рахмет
Dialogue: 0,0:20:50.20,0:20:50.85,JPDB,,0,0,0,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,0:20:51.06,0:20:52.20,JPDB,,0,0,0,,Ұйқылар
Dialogue: 0,0:20:52.62,0:20:54.94,JPDB,,0,0,0,,Үйге бардым, әбден жеңілдім.
Dialogue: 0,0:20:55.54,0:20:57.53,JPDB,,0,0,0,,Олай болса, біз таралудың қажеті жоқ.
Dialogue: 0,0:20:57.76,0:20:58.80,JPDB,,0,0,0,,Әрине өлім
Dialogue: 0,0:20:58.96,0:21:01.30,JPDB,,0,0,0,,Ертең мен тағы да жалған Жазмен күресемін.
Dialogue: 0,0:21:01.30,0:21:02.60,JPDB,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:21:05.64,0:21:06.29,JPDB,,0,0,0,,Не?
Dialogue: 0,0:21:06.92,0:21:09.64,JPDB,,0,0,0,,Мен ұйықтап жатқанда қызық түс көрдім.
Dialogue: 0,0:21:10.21,0:21:11.00,JPDB,,0,0,0,,Қандай арман
Dialogue: 0,0:21:11.80,0:21:16.73,JPDB,,0,0,0,,Барлығымен...Түс болды ма деп
Dialogue: 0,0:21:19.54,0:21:21.24,JPDB,,0,0,0,,Бұл қуатты босатыңыз
Dialogue: 0,0:21:23.86,0:21:25.25,JPDB,,0,0,0,,Найзағайдың жарылуы
Dialogue: 0,0:21:28.13,0:21:30.97,JPDB,,0,0,0,,Егер сізде бұл болса, найзағай атрибуты техникасы тамаша болады.
Dialogue: 0,0:21:31.22,0:21:33.42,JPDB,,0,0,0,,Болатын өлім Декомори да өліммен аяқталады
Dialogue: 0,0:21:33.77,0:21:36.64,JPDB,,0,0,0,,Бір жылы Сіз тағы да костюмде трюк ойнадыңыз.
Dialogue: 0,0:21:36.64,0:21:38.33,JPDB,,0,0,0,,Ажал келді, жалған жаз
Dialogue: 0,0:21:40.24,0:21:41.40,JPDB,,0,0,0,,Өте жан-жақты
Dialogue: 0,0:21:41.53,0:21:42.98,JPDB,,0,0,0,,Қажетсіз істермен айналыспаңыз
Dialogue: 0,0:21:43.13,0:21:44.65,JPDB,,0,0,0,,Басқа жерден іздеме
Dialogue: 0,0:21:44.89,0:21:46.01,ZWDB,,0,0,0,,Сіз
Dialogue: 0,0:21:45.14,0:21:47.61,JPDB,,0,0,0,,Соңында ештеңе өзгерген жоқ.
Dialogue: 0,0:21:48.08,0:21:49.38,JPDB,,0,0,0,,Мен тіпті ұйықтамаймын.
Dialogue: 0,0:21:49.73,0:21:54.28,JPDB,,0,0,0,,Иә, бірақ мен қазір іште ұйықтап жатқан ең бақыттымын.
Dialogue: 0,0:21:54.72,0:21:55.93,JPDB,,0,0,0,,Қайырлы түн
Dialogue: 0,0:21:56.30,0:21:57.49,JPDB,,0,0,0,,Тағы бір ату
Dialogue: 0,0:21:57.49,0:21:58.54,JPDB,,0,0,0,,Юта қауіпті
Dialogue: 0,0:22:00.29,0:22:01.17,JPDB,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:22:01.17,0:22:02.54,JPDB,,0,0,0,,Декомори найзағай
Dialogue: 0,0:22:02.54,0:22:03.68,JPDB,,0,0,0,,Раджадес
Dialogue: 0,0:22:03.68,0:22:05.80,JPDB,,0,0,0,,Адамдардың айтқанын тыңдау
Dialogue: 0,0:23:34.46,0:23:40.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
