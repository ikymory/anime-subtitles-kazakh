Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.28,0:00:04.45,Default,,0,0,0,,Өте ыстық!
Dialogue: 0,0:00:04.45,0:00:07.28,Default,,0,0,0,,Бұл шынымен тропикалық ел сияқты! Қахар!
Dialogue: 0,0:00:07.28,0:00:11.62,Default,,0,0,0,,Айна назарын өзіне аудартады...
Dialogue: 0,0:00:07.28,0:00:11.62,Default,,0,0,0,,Аа, кешіріңіз...
Dialogue: 0,0:00:11.62,0:00:15.96,Default,,0,0,0,,Бірақ мүмкін...
Dialogue: 0,0:00:11.62,0:00:15.96,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:00:15.96,0:00:18.79,Default,,0,0,0,,Сол жерден
Dialogue: 0,0:00:15.96,0:00:18.79,Default,,0,0,0,,Менің ойымша, бұл жақсырақ...
Dialogue: 0,0:00:18.79,0:00:21.09,Default,,0,0,0,,Өйткені бұл жерде басқа біреу...
Dialogue: 0,0:01:52.32,0:01:55.26,Default,,0,0,0,,Мұнда
Dialogue: 0,0:01:52.32,0:01:55.26,Default,,0,0,0,,Бүгіннен бастап мен үш түн осында боламын.
Dialogue: 0,0:01:55.26,0:01:58.76,Default,,0,0,0,,Шынымен, сондай әдемі жерде ме?
Dialogue: 0,0:01:55.26,0:01:58.76,Default,,0,0,0,,О
Dialogue: 0,0:01:58.76,0:02:00.93,Default,,0,0,0,,Тамақты өзім дайындаймын.
Dialogue: 0,0:02:00.93,0:02:02.93,Default,,0,0,0,,Тіпті бассейн де бар, Китахара!
Dialogue: 0,0:02:02.93,0:02:06.83,Default,,0,0,0,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,0:02:02.93,0:02:06.83,Default,,0,0,0,,Хахахаха! Көп дүрбелеңге түспеңіз
Dialogue: 0,0:02:15.94,0:02:21.12,Default,,0,0,0,,Ол өте тар.
Dialogue: 0,0:02:15.94,0:02:21.12,Default,,0,0,0,,Екі адамдық бөлмеде төрт адам бар.
Dialogue: 0,0:02:21.12,0:02:23.29,Default,,0,0,0,,Оның тар екеніне көмектесу мүмкін емес.
Dialogue: 0,0:02:23.29,0:02:26.96,Default,,0,0,0,,Менің ағаларым тым күшті болғандықтан шығар.
Dialogue: 0,0:02:23.29,0:02:26.96,Default,,0,0,0,,Бар.
Dialogue: 0,0:02:26.96,0:02:32.29,Default,,0,0,0,,Егер бұл орын алса, бұл мен немесе Китахара.
Dialogue: 0,0:02:26.96,0:02:32.29,Default,,0,0,0,,Біреуіміз еденде ұйықтауымыз керек.
Dialogue: 0,0:02:32.29,0:02:35.96,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:02:32.29,0:02:35.96,Default,,0,0,0,,Физикалық тұрғыдан басқа таңдау жоқ.
Dialogue: 0,0:02:35.96,0:02:39.13,Default,,0,0,0,,Кешіріңіз~
Dialogue: 0,0:02:35.96,0:02:39.13,Default,,0,0,0,,Әзірше ➡︎ шешіңіз
Dialogue: 0,0:02:39.13,0:02:41.30,Default,,0,0,0,,Бұл туралы кейінірек ойлану...
Dialogue: 0,0:02:41.30,0:02:43.81,Default,,0,0,0,,Не болса да, ең алдымен теңіз!
Dialogue: 0,0:02:43.81,0:02:46.64,Default,,0,0,0,,Уху... Ухуфуфуфуфуфу
Dialogue: 0,0:02:46.64,0:02:52.31,Default,,0,0,0,,Өте қызық сияқты
Dialogue: 0,0:02:46.64,0:02:52.31,Default,,0,0,0,,Әрине.
Dialogue: 0,0:02:52.31,0:02:55.58,Default,,0,0,0,,Бұл, әрине, жақсы.
Dialogue: 0,0:02:52.31,0:02:55.58,Default,,0,0,0,,Эхехе
Dialogue: 0,0:02:55.58,0:02:58.42,Default,,0,0,0,,⚞(Токита) Сәлем!
Dialogue: 0,0:02:55.58,0:02:58.42,Default,,0,0,0,,Мен алдымен артқы теңізге барамын!
Dialogue: 0,0:02:58.42,0:03:00.42,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:03:02.42,0:03:04.76,Default,,0,0,0,,Күткеніңізге рахмет!
Dialogue: 0,0:03:04.76,0:03:07.43,Default,,0,0,0,,О!
Dialogue: 0,0:03:04.76,0:03:07.43,Default,,0,0,0,,Тез кел!
Dialogue: 0,0:03:07.43,0:03:12.77,Default,,0,0,0,,《Аа, бақыт...
Dialogue: 0,0:03:07.43,0:03:12.77,Default,,0,0,0,,Бұл менің жастық шағымның 1 беті
Dialogue: 0,0:03:12.77,0:03:16.61,Default,,0,0,0,,Жүрегіңіздің альбомын безендіретін асыл естеліктер...
Dialogue: 0,0:03:16.61,0:03:19.27,Default,,0,0,0,,Хахахахаха! 》
Dialogue: 0,0:03:19.27,0:03:22.44,Default,,0,0,0,,Менің альбом мозаикаға толы!
Dialogue: 0,0:03:22.44,0:03:25.45,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:03:22.44,0:03:25.45,Default,,0,0,0,,Оны жалға беру туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:03:25.45,0:03:27.78,Default,,0,0,0,,Дәл!
Dialogue: 0,0:03:27.78,0:03:29.79,Default,,0,0,0,,Қозғалайық
Dialogue: 0,0:03:27.78,0:03:29.79,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:29.79,0:03:33.29,Default,,0,0,0,,Мұнда адамдар жоқ
Dialogue: 0,0:03:29.79,0:03:33.29,Default,,0,0,0,,Еркін киінуге болады
Dialogue: 0,0:03:33.29,0:03:36.12,Default,,0,0,0,,Біз қозғаламыз, солай ма?
Dialogue: 0,0:03:33.29,0:03:36.12,Default,,0,0,0,,О, о...
Ол
Dialogue: 0,0:03:36.12,0:03:40.13,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ түсінемін.
Dialogue: 0,0:03:40.13,0:03:43.97,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:03:40.13,0:03:43.97,Default,,0,0,0,,Бұл кәдімгі жағажай.
Dialogue: 0,0:03:43.97,0:03:46.80,Default,,0,0,0,,Егер солай десеңіз
Dialogue: 0,0:03:43.97,0:03:46.80,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:03:46.80,0:03:49.14,Default,,0,0,0,,Бұл көңілді болатын сияқты.
Dialogue: 0,0:03:49.14,0:03:52.31,Default,,0,0,0,,Ал, мен саған сусын алып келейін!
Dialogue: 0,0:03:49.14,0:03:52.31,Default,,0,0,0,,А, мен де!
Dialogue: 0,0:03:52.31,0:03:55.41,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:55.41,0:03:58.08,Default,,0,0,0,,Паразольді жалға алу және т.б.
Dialogue: 0,0:03:55.41,0:03:58.08,Default,,0,0,0,,Бар сияқты.
Dialogue: 0,0:03:58.08,0:04:01.92,Default,,0,0,0,,Мен оны қарызға аламын ба?
Dialogue: 0,0:03:58.08,0:04:01.92,Default,,0,0,0,,Сізге демалыс орны қажет болуы мүмкін
Dialogue: 0,0:04:01.92,0:04:05.59,Default,,0,0,0,,Біздің үйді пайдалансаңыз
Dialogue: 0,0:04:01.92,0:04:05.59,Default,,0,0,0,,Біз сізге қолшатырларды тегін береміз.
Dialogue: 0,0:04:05.59,0:04:08.59,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:05.59,0:04:08.59,Default,,0,0,0,,«Қолдану» дегенді қалай түсінесіңдер?
Dialogue: 0,0:04:08.59,0:04:11.29,Default,,0,0,0,,Мен осылай істеп жатырмын.
Dialogue: 0,0:04:08.59,0:04:11.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:13.26,0:04:15.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:15.26,0:04:17.77,Default,,0,0,0,,Банан қайығы?
Dialogue: 0,0:04:15.26,0:04:17.77,Default,,0,0,0,,Содан кейін➡︎
Dialogue: 0,0:04:17.77,0:04:19.77,Default,,0,0,0,,Үш адам бірге мінсе ше?
Dialogue: 0,0:04:19.77,0:04:23.77,Default,,0,0,0,,Жоқ... мен...
Dialogue: 0,0:04:19.77,0:04:23.77,Default,,0,0,0,,Жүрейік, Китахара!
Dialogue: 0,0:04:23.77,0:04:27.61,Default,,0,0,0,,Алғашында неге екенін түсінбесем де, менде жеккөру сезімі пайда болды—
Dialogue: 0,0:04:23.77,0:04:27.61,Default,,0,0,0,,Міне осылай➡︎
Dialogue: 0,0:04:27.61,0:04:30.45,Default,,0,0,0,,Бүгін түнде қайда ұйықтау керек
Dialogue: 0,0:04:27.61,0:04:30.45,Default,,0,0,0,,Шешім қабылдау туралы не айтасыз?
Dialogue: 0,0:04:30.45,0:04:33.78,Default,,0,0,0,,Бірінші шайқалған жеңіледі.
Dialogue: 0,0:04:30.45,0:04:33.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:33.78,0:04:38.12,Default,,0,0,0,,Әрине, қорқамын десең
Dialogue: 0,0:04:33.78,0:04:38.12,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:04:38.12,0:04:40.79,Default,,0,0,0,,Сіз маған айтасыз.
Dialogue: 0,0:04:40.79,0:04:43.96,Default,,0,0,0,,Жоғары! Мен бұл шайқасқа қатысамын!
Dialogue: 0,0:04:43.96,0:04:47.46,Default,,0,0,0,,Жарайды ма? Иори
Dialogue: 0,0:04:43.96,0:04:47.46,Default,,0,0,0,,Жақсы жасамасаң, суға түсесің.
Dialogue: 0,0:04:47.46,0:04:51.30,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:04:47.46,0:04:51.30,Default,,0,0,0,,Бізде құтқару кеудешелері бар және бізде стратегиялар бар.
Dialogue: 0,0:04:51.30,0:04:54.64,Default,,0,0,0,,«Мен бірде сенімен жақсылап сөйлескім келеді.»
Dialogue: 0,0:04:51.30,0:04:54.64,Default,,0,0,0,,Және мәңгі➡︎
Dialogue: 0,0:04:54.64,0:04:58.41,Default,,0,0,0,,Сіз судан қорқасыз ба?
Dialogue: 0,0:04:54.64,0:04:58.41,Default,,0,0,0,,Өйткені мен қала алмаймын.
Dialogue: 0,0:04:58.41,0:05:02.91,Default,,0,0,0,,Айтпақшы, бұл шайқалады.
Dialogue: 0,0:04:58.41,0:05:02.91,Default,,0,0,0,,бар ма?
Dialogue: 0,0:05:02.91,0:05:05.25,Default,,0,0,0,,Көп емес.
Dialogue: 0,0:05:05.25,0:05:09.25,Default,,0,0,0,,Бұл жағдайда бұл жақсы сәйкес келмеуі мүмкін.
Dialogue: 0,0:05:05.25,0:05:09.25,Default,,0,0,0,,Міне!
Dialogue: 0,0:05:09.25,0:05:14.59,Default,,0,0,0,,Жарайды, сонда болды...
Dialogue: 0,0:05:09.25,0:05:14.59,Default,,0,0,0,,Теңіз спортынан ыңғайлы рахат алыңыз
Dialogue: 0,0:05:14.59,0:05:18.39,Default,,0,0,0,,Олай болса, тұтқада.
Dialogue: 0,0:05:14.59,0:05:18.39,Default,,0,0,0,,Мықтап ұстаңыз.
Dialogue: 0,0:05:25.77,0:05:27.77,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:05:27.77,0:05:29.94,Default,,0,0,0,,Сен қандай жексұрынсың!
Dialogue: 0,0:05:29.94,0:05:32.94,Default,,0,0,0,,Сіз жиі осындайсыз.
Dialogue: 0,0:05:29.94,0:05:32.94,Default,,0,0,0,,Ештеңе ойлама!
Dialogue: 0,0:05:32.94,0:05:35.44,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:05:32.94,0:05:35.44,Default,,0,0,0,,Мен де солай істеп жүрдім...
Dialogue: 0,0:05:35.44,0:05:37.64,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:05:39.78,0:05:43.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:39.78,0:05:43.12,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:05:43.12,0:05:46.12,Default,,0,0,0,,Не болды? Кохеи!
Dialogue: 0,0:05:43.12,0:05:46.12,Default,,0,0,0,,Бетіңіз тар!
Dialogue: 0,0:05:46.12,0:05:50.29,Default,,0,0,0,,Судан қорқатын сенсің.
Dialogue: 0,0:05:46.12,0:05:50.29,Default,,0,0,0,,Кішкентай емес пе?
Dialogue: 0,0:05:50.29,0:05:54.63,Default,,0,0,0,,Ондай жағдайда бір қолмен күресу керек пе?
Dialogue: 0,0:05:50.29,0:05:54.63,Default,,0,0,0,,Бұл артық емес пе?
Dialogue: 0,0:05:54.63,0:05:56.73,Default,,0,0,0,,Жылдамдаңыз!
Dialogue: 0,0:05:54.63,0:05:56.73,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:05:56.73,0:05:58.73,Default,,0,0,0,,Баркер
Dialogue: 0,0:06:00.90,0:06:03.07,Default,,0,0,0,,Бұл жақсы~. Жастық шақ...
Dialogue: 0,0:06:03.07,0:06:05.57,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:05.57,0:06:10.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:10.08,0:06:13.08,Default,,0,0,0,,《Мен бара аламын...
Dialogue: 0,0:06:10.08,0:06:13.08,Default,,0,0,0,,Егер сіз аяқтарыңызбен итерсеңіз, сіз басқара аласыз...
Dialogue: 0,0:06:13.08,0:06:15.92,Default,,0,0,0,,Бірақ бәрі бірдей...》
Dialogue: 0,0:06:15.92,0:06:18.09,Default,,0,0,0,,кінәсіз жас қызды алдап, миын жуғандығым
Dialogue: 0,0:06:18.09,0:06:20.92,Default,,0,0,0,,《Мен бұл аяққа бірдеңе жасауым керек.》
Dialogue: 0,0:06:20.92,0:06:23.43,Default,,0,0,0,,Дауыстық актер Мизуки Кая осында!
Dialogue: 0,0:06:23.43,0:06:25.43,Default,,0,0,0,,Мына жерде AV актрисасы бар!
Dialogue: 0,0:06:25.43,0:06:27.43,Default,,0,0,0,,Не!?
Dialogue: 0,0:06:27.43,0:06:29.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:27.43,0:06:29.60,Default,,0,0,0,,(Теңізге құлау дыбысы)
Dialogue: 0,0:06:29.60,0:06:32.43,Default,,0,0,0,,Құлды.
Dialogue: 0,0:06:29.60,0:06:32.43,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:32.43,0:06:35.10,Default,,0,0,0,,Олар жалқау.
Dialogue: 0,0:06:32.43,0:06:35.10,Default,,0,0,0,,Мына бейбақ!
Dialogue: 0,0:06:35.10,0:06:37.94,Default,,0,0,0,,Сіз!
Dialogue: 0,0:06:35.10,0:06:37.94,Default,,0,0,0,,Сондықтан сен өлесің.
Dialogue: 0,0:06:37.94,0:06:41.61,Default,,0,0,0,,Әй, көңіл көтердің бе?
Dialogue: 0,0:06:37.94,0:06:41.61,Default,,0,0,0,,Мен көңілді болдым, бірақ...
Dialogue: 0,0:06:41.61,0:06:44.78,Default,,0,0,0,,Керемет~ Мен де жас болғым келеді...
Dialogue: 0,0:06:44.78,0:06:46.95,Default,,0,0,0,,Иә! Ахаха!
Dialogue: 0,0:06:46.95,0:06:51.15,Default,,0,0,0,,Олай болса, сен де атқа мінгің келе ме?
Dialogue: 0,0:06:46.95,0:06:51.15,Default,,0,0,0,,Иә? Бұл жақсы ма?
Dialogue: 0,0:06:54.79,0:06:57.89,Default,,0,0,0,,Одан кейін оңға бұрылыңыз.
Dialogue: 0,0:06:54.79,0:06:57.89,Default,,0,0,0,,О
Dialogue: 0,0:07:01.23,0:07:03.23,Default,,0,0,0,,Керемет тұрақтылық
Dialogue: 0,0:07:03.23,0:07:06.57,Default,,0,0,0,,Не болды? Айна
Dialogue: 0,0:07:03.23,0:07:06.57,Default,,0,0,0,,Сіздің көзіңізге теңіз суы түсті ме?
Dialogue: 0,0:07:06.57,0:07:11.41,Default,,0,0,0,,Ах~ мен ойнадым. Мен ойнадым...
Dialogue: 0,0:07:06.57,0:07:11.41,Default,,0,0,0,,Өлім тіпті жаза да емес.
Dialogue: 0,0:07:11.41,0:07:14.24,Default,,0,0,0,,Уууу, әлі бірінші күн.
Dialogue: 0,0:07:14.24,0:07:19.58,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:07:14.24,0:07:19.58,Default,,0,0,0,,Бұл ертеңнен бастап лицензиялық оқу.
Dialogue: 0,0:07:19.58,0:07:22.42,Default,,0,0,0,,Ұйықтар алдында
Dialogue: 0,0:07:19.58,0:07:22.42,Default,,0,0,0,,Оқулықты қарап шығыңыз.
Dialogue: 0,0:07:22.42,0:07:24.42,Default,,0,0,0,,Ui~ssu
Dialogue: 0,0:07:24.42,0:07:26.92,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:07:24.42,0:07:26.92,Default,,0,0,0,,Бұл сенің төсегің...
Dialogue: 0,0:07:26.92,0:07:30.82,Default,,0,0,0,,Аа... дұрыс.
Dialogue: 0,0:07:26.92,0:07:30.82,Default,,0,0,0,,Кім жеңді?
Dialogue: 0,0:07:33.26,0:07:35.60,Default,,0,0,0,,Толқындардың айырмашылығына байланысты бұл Кохеи болды.
Dialogue: 0,0:07:35.60,0:07:37.93,Default,,0,0,0,,Бұл ақымақ!
Dialogue: 0,0:07:37.93,0:07:41.27,Default,,0,0,0,,Толқындардың айырмашылығы – қате!
Dialogue: 0,0:07:37.93,0:07:41.27,Default,,0,0,0,,А? Не болды?
Dialogue: 0,0:07:41.27,0:07:46.44,Default,,0,0,0,,Аа, шын мәнінде...
Dialogue: 0,0:07:41.27,0:07:46.44,Default,,0,0,0,,А, кереует жетпей ме?
Dialogue: 0,0:07:46.44,0:07:48.44,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,0:07:48.44,0:07:51.28,Default,,0,0,0,,Бұл емес
Dialogue: 0,0:07:48.44,0:07:51.28,Default,,0,0,0,,Сіз дұрыс ұйықтай алмайсыз, солай ма?
Dialogue: 0,0:07:51.28,0:07:54.28,Default,,0,0,0,,Лицензиялық оқыту ұйқының болмауына байланысты қауіпті...
Dialogue: 0,0:07:54.28,0:07:58.08,Default,,0,0,0,,Олай болса, мұны істейміз бе?
Dialogue: 0,0:07:54.28,0:07:58.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:07.23,0:08:10.23,Default,,0,0,0,,Осы бөлмеде
Dialogue: 0,0:08:07.23,0:08:10.23,Default,,0,0,0,,Сіз қолдарыңызды және аяқтарыңызды соза аласыз, солай ма?
Dialogue: 0,0:08:10.23,0:08:14.07,Default,,0,0,0,,Сондай-ақ лицензиялық оқыту үшін
Dialogue: 0,0:08:10.23,0:08:14.07,Default,,0,0,0,,Сізге дұрыс ұйықтау керек, солай ма?
Dialogue: 0,0:08:14.07,0:08:17.07,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:08:14.07,0:08:17.07,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:08:17.07,0:08:19.87,Default,,0,0,0,,♬~
Dialogue: 0,0:08:22.41,0:08:24.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:22.41,0:08:24.41,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:24.41,0:08:26.41,Default,,0,0,0,,Ой! Хе
Dialogue: 0,0:08:26.41,0:08:29.31,Default,,0,0,0,,О, аа...
Dialogue: 0,0:08:34.42,0:08:40.62,Default,,0,0,0,,📱(діріл дыбысы)
Dialogue: 0,0:08:50.42,0:08:52.75,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:08:52.75,0:08:54.92,Default,,0,0,0,,О
Dialogue: 0,0:08:52.75,0:08:54.92,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:08:54.92,0:09:00.03,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:54.92,0:09:00.03,Default,,0,0,0,,Мен ұйықтап жатқанда маған хабар келді.
Dialogue: 0,0:09:00.03,0:09:02.53,Default,,0,0,0,,Иә!?
Dialogue: 0,0:09:02.53,0:09:04.87,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:09:04.87,0:09:09.37,Default,,0,0,0,,Міне, сол екі адамға қарсы.
Dialogue: 0,0:09:04.87,0:09:09.37,Default,,0,0,0,,Менің ойымша, Иори ештеңе істей алмайды.
Dialogue: 0,0:09:09.37,0:09:11.87,Default,,0,0,0,,Ұйқыңыз жетіспеуі мүмкін.
Dialogue: 0,0:09:11.87,0:09:14.88,Default,,0,0,0,,Сонымен
Dialogue: 0,0:09:11.87,0:09:14.88,Default,,0,0,0,,Емтихан нәтижелері апатты болады.
Dialogue: 0,0:09:14.88,0:09:18.38,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:09:14.88,0:09:18.38,Default,,0,0,0,,Жоқ, жоқ, бәрі жақсы.
Dialogue: 0,0:09:18.38,0:09:22.05,Default,,0,0,0,,Ұйқының жоқтығына мән бермейді.
Dialogue: 0,0:09:18.38,0:09:22.05,Default,,0,0,0,,Өйткені мен ақымақпын
Dialogue: 0,0:09:22.05,0:09:25.89,Default,,0,0,0,,А...
Dialogue: 0,0:09:22.05,0:09:25.89,Default,,0,0,0,,Біреу аздап айтысыңызшы.
Dialogue: 0,0:09:25.89,0:09:29.39,Default,,0,0,0,,Оу Иори
Dialogue: 0,0:09:25.89,0:09:29.39,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:09:29.39,0:09:34.23,Default,,0,0,0,,Айтайын, мен сенен артықпын.
Dialogue: 0,0:09:29.39,0:09:34.23,Default,,0,0,0,,Жоғары балл алатыныма сенімдімін.
Dialogue: 0,0:09:34.23,0:09:36.73,Default,,0,0,0,,Әй... ақымақтар көп айтады.
Dialogue: 0,0:09:36.73,0:09:40.24,Default,,0,0,0,,А?
Dialogue: 0,0:09:36.73,0:09:40.24,Default,,0,0,0,,17 ұпай неміс тілінде жақсы айтылған!
Dialogue: 0,0:09:40.24,0:09:44.07,Default,,0,0,0,,Куу~! Кездейсоқ 20 ұпай
Dialogue: 0,0:09:40.24,0:09:44.07,Default,,0,0,0,,Бұлай бастық болма!
Dialogue: 0,0:09:44.07,0:09:47.91,Default,,0,0,0,,20 ұпай?
Dialogue: 0,0:09:44.07,0:09:47.91,Default,,0,0,0,,100 ұпай
Dialogue: 0,0:09:47.91,0:09:50.58,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:09:47.91,0:09:50.58,Default,,0,0,0,,Мен міндетті түрде алаңдай бастадым.
Dialogue: 0,0:09:50.58,0:09:55.08,Default,,0,0,0,,Кішкене байқап көргіңіз келе ме?
Dialogue: 0,0:09:50.58,0:09:55.08,Default,,0,0,0,,Ей, екеуің де! Бұл проблема
Dialogue: 0,0:09:55.08,0:09:57.75,Default,,0,0,0,,А? иә?
Dialogue: 0,0:09:55.08,0:09:57.75,Default,,0,0,0,,Судың ұзақ қашықтыққа қозғалысы ➡︎
Dialogue: 0,0:09:57.75,0:10:01.92,Default,,0,0,0,,Қайсысы аз шаршатады?
Dialogue: 0,0:09:57.75,0:10:01.92,Default,,0,0,0,,А. Бетіңізді суға салып, төмен қаратып жатыңыз.
Dialogue: 0,0:10:01.92,0:10:03.93,Default,,0,0,0,,B Шалқаңыздан жатыңыз
Dialogue: 0,0:10:03.93,0:10:06.43,Default,,0,0,0,,B!
Dialogue: 0,0:10:03.93,0:10:06.43,Default,,0,0,0,,Бірақ соғыс жыртқыштары сиқыр қолдана алмайды ғой, иә?
Dialogue: 0,0:10:06.43,0:10:10.60,Default,,0,0,0,,Ашық судағы сүңгуірлер сүңгуі мүмкін
Dialogue: 0,0:10:06.43,0:10:10.60,Default,,0,0,0,,Ең үлкен тереңдік дегеніміз не?
Dialogue: 0,0:10:10.60,0:10:12.60,Default,,0,0,0,,18 метр
Dialogue: 0,0:10:12.60,0:10:14.60,Default,,0,0,0,,Бұл ақылға қонымды мәселе.
Dialogue: 0,0:10:14.60,0:10:17.94,Default,,0,0,0,,Олай болса
Dialogue: 0,0:10:14.60,0:10:17.94,Default,,0,0,0,,Менің де парасатты сұрақ бар...
Dialogue: 0,0:10:17.94,0:10:21.11,Default,,0,0,0,,Киім ауыстырған кезде киім ауыстыратын бөлмені пайдаланыңыз...
Dialogue: 0,0:10:17.94,0:10:21.11,Default,,0,0,0,,Қолданбаңыз!
Dialogue: 0,0:10:21.11,0:10:23.78,Default,,0,0,0,,Әлі де мәселе
Dialogue: 0,0:10:21.11,0:10:23.78,Default,,0,0,0,,Мен әлі ештеңе айтқан жоқпын...
Dialogue: 0,0:10:23.78,0:10:26.95,Default,,0,0,0,,Nja
Dialogue: 0,0:10:23.78,0:10:26.95,Default,,0,0,0,,Сізге қиын сұрақтар қояйын ба?
Dialogue: 0,0:10:26.95,0:10:30.12,Default,,0,0,0,,Жылы ұстау керек
Dialogue: 0,0:10:26.95,0:10:30.12,Default,,0,0,0,,Қандай температурада су қозғалысын тоқтатады?
Dialogue: 0,0:10:30.12,0:10:33.79,Default,,0,0,0,,А... бұл...
Dialogue: 0,0:10:30.12,0:10:33.79,Default,,0,0,0,,Бұл 18 градус.
Dialogue: 0,0:10:33.79,0:10:35.79,Default,,0,0,0,,О!
Dialogue: 0,0:10:33.79,0:10:35.79,Default,,0,0,0,,(дұрыс жауап дыбысы)
Dialogue: 0,0:10:35.79,0:10:38.79,Default,,0,0,0,,Сен істейсің, Иори.
Dialogue: 0,0:10:35.79,0:10:38.79,Default,,0,0,0,,Сен жақсы оқисың.
Dialogue: 0,0:10:38.79,0:10:43.46,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:10:38.79,0:10:43.46,Default,,0,0,0,,Ху... Кохэй, сен білмейсің.
Dialogue: 0,0:10:43.46,0:10:47.47,Default,,0,0,0,,Юубе Мен ол бөлмеде қаншамын?
Dialogue: 0,0:10:43.46,0:10:47.47,Default,,0,0,0,,Оқулықты оқыдың ба?
Dialogue: 0,0:10:47.47,0:10:51.31,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:47.47,0:10:51.31,Default,,0,0,0,,Жарақат алудың мәні неде?
Dialogue: 0,0:10:51.31,0:10:54.31,Default,,0,0,0,,Қарап тұрмай
Dialogue: 0,0:10:51.31,0:10:54.31,Default,,0,0,0,,Бұл оқудың нәтижесі.
Dialogue: 0,0:10:54.31,0:10:57.41,Default,,0,0,0,,Қарғыс атсын... О!
Dialogue: 0,0:10:57.41,0:11:01.08,Default,,0,0,0,,Қауіпсіз тоқтау тереңдігі қандай?
Dialogue: 0,0:10:57.41,0:11:01.08,Default,,0,0,0,,3-6 метр
Dialogue: 0,0:11:01.08,0:11:04.42,Default,,0,0,0,,О
Dialogue: 0,0:11:01.08,0:11:04.42,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:11:04.42,0:11:08.26,Default,,0,0,0,,Содан кейін балық аулау желісін немесе торды кесіңіз.
Dialogue: 0,0:11:04.42,0:11:08.26,Default,,0,0,0,,Арнайы жүздері бар ілгектер ше?
Dialogue: 0,0:11:08.26,0:11:10.26,Default,,0,0,0,,Пышақты орнатыңыз
Dialogue: 0,0:11:08.26,0:11:10.26,Default,,0,0,0,,(дұрыс жауап дыбысы)
Dialogue: 0,0:11:10.26,0:11:12.59,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:11:10.26,0:11:12.59,Default,,0,0,0,,Бұл үлкен мәселе
Dialogue: 0,0:11:12.59,0:11:15.10,Default,,0,0,0,,Бұл қол сигналы қандай?
Dialogue: 0,0:11:12.59,0:11:15.10,Default,,0,0,0,,Сүт бездері
Dialogue: 0,0:11:15.10,0:11:17.77,Default,,0,0,0,,Эй, күте тұрыңыз
Dialogue: 0,0:11:15.10,0:11:17.77,Default,,0,0,0,,Сіз кенеттен не айтып тұрсыз?
Dialogue: 0,0:11:17.77,0:11:21.27,Default,,0,0,0,,О... жоқ... бұл дұрыс емес.
Dialogue: 0,0:11:17.77,0:11:21.27,Default,,0,0,0,,«Мына жерден қараңыз»
Dialogue: 0,0:11:21.27,0:11:24.11,Default,,0,0,0,,Хм... онда бұл туралы не деуге болады?
Dialogue: 0,0:11:24.11,0:11:27.94,Default,,0,0,0,,«Мойындағы желкеге ​​қара».
Dialogue: 0,0:11:24.11,0:11:27.94,Default,,0,0,0,,Жоқ... олай емес...
Dialogue: 0,0:11:27.94,0:11:30.95,Default,,0,0,0,,Бұған қарамаңыз.
Dialogue: 0,0:11:27.94,0:11:30.95,Default,,0,0,0,,Мен оқулыққа назар аударуым керек...
Dialogue: 0,0:11:30.95,0:11:33.11,Default,,0,0,0,,Оқулықта…
Dialogue: 0,0:11:30.95,0:11:33.11,Default,,0,0,0,,Оқулыққа көңіл бөлу...
Dialogue: 0,0:11:33.11,0:11:36.12,Default,,0,0,0,,Мен осы аймақты оқып жатқан жағдай болды
Dialogue: 0,0:11:33.11,0:11:36.12,Default,,0,0,0,,Мен оны көре алмаймын
Dialogue: 0,0:11:36.12,0:11:38.79,Default,,0,0,0,,Көзіңді айналдырасың ба?
Dialogue: 0,0:11:38.79,0:11:44.46,Default,,0,0,0,,Міне, бұл туралы.
Dialogue: 0,0:11:38.79,0:11:44.46,Default,,0,0,0,,Шоғырлануды бұзу өте аянышты.
Dialogue: 0,0:11:44.46,0:11:46.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:52.80,0:11:56.07,Default,,0,0,0,,Қайырлы таң...
Dialogue: 0,0:11:52.80,0:11:56.07,Default,,0,0,0,,Неге мектеп формаңды киіп жүрсің? Одан кейін мектепке барасың ба?
Dialogue: 0,0:11:56.07,0:11:59.91,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:56.07,0:11:59.91,Default,,0,0,0,,Мен оны көрмедім, Раракотан...
Dialogue: 0,0:11:59.91,0:12:03.08,Default,,0,0,0,,Nja
Dialogue: 0,0:11:59.91,0:12:03.08,Default,,0,0,0,,Түні бойы ұйықтай алмадың ба?
Dialogue: 0,0:12:03.08,0:12:05.41,Default,,0,0,0,,Оның өңі әдемі.
Dialogue: 0,0:12:05.41,0:12:08.58,Default,,0,0,0,,Жоқ, мен өзімді ұйықтауға мәжбүр еттім.
Dialogue: 0,0:12:05.41,0:12:08.58,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:12:08.58,0:12:12.92,Default,,0,0,0,,Өзіңізді өшіріңіз
Dialogue: 0,0:12:08.58,0:12:12.92,Default,,0,0,0,,Бұл күшті қимыл.
Dialogue: 0,0:12:12.92,0:12:15.42,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:12:12.92,0:12:15.42,Default,,0,0,0,,Сіз ұйықтадым деп айта аласыз ба?
Dialogue: 0,0:12:15.42,0:12:18.43,Default,,0,0,0,,Бұл бәрібір проблема емес сияқты.
Dialogue: 0,0:12:15.42,0:12:18.43,Default,,0,0,0,,Бәрінен бұрын
Dialogue: 0,0:12:18.43,0:12:22.10,Default,,0,0,0,,Таңғы асты өзіміз дайындаймыз.
Dialogue: 0,0:12:18.43,0:12:22.10,Default,,0,0,0,,Қарап жатырсыздар деп үміттенемін.
Dialogue: 0,0:12:22.10,0:12:24.10,Default,,0,0,0,,Үйсу
Dialogue: 0,0:12:26.60,0:12:28.77,Default,,0,0,0,,Сіз осында жазасыз ба?
Dialogue: 0,0:12:28.77,0:12:31.77,Default,,0,0,0,,Қосымша
Dialogue: 0,0:12:28.77,0:12:31.77,Default,,0,0,0,,Мен мұны ресми жерде жасаймыз ба деп ойлаймын...
Dialogue: 0,0:12:31.77,0:12:34.78,Default,,0,0,0,,Емтиханның өзі өте жұмсақ болған сияқты.
Dialogue: 0,0:12:34.78,0:12:37.11,Default,,0,0,0,,Сұрақтардың көпшілігінде 4 таңдау бар.
Dialogue: 0,0:12:37.11,0:12:41.78,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:12:37.11,0:12:41.78,Default,,0,0,0,,Сонда біздің күш-жігеріміз қандай...
Dialogue: 0,0:12:41.78,0:12:46.45,Default,,0,0,0,,Сіз не айтасыз? Жақсы?
Dialogue: 0,0:12:41.78,0:12:46.45,Default,,0,0,0,,Қауіпсіздік техникасы туралы білім.
Dialogue: 0,0:12:46.45,0:12:49.29,Default,,0,0,0,,Қанша оқысаң да
Dialogue: 0,0:12:46.45,0:12:49.29,Default,,0,0,0,,Жоғалту деген бар ма?
Dialogue: 0,0:12:49.29,0:12:51.46,Default,,0,0,0,,♬~
Dialogue: 0,0:12:49.29,0:12:51.46,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:12:51.46,0:12:54.63,Default,,0,0,0,,Қалыпты сүңгу кезінде
Dialogue: 0,0:12:51.46,0:12:54.63,Default,,0,0,0,,Себебі алшақтық тым үлкен
Dialogue: 0,0:12:54.63,0:12:57.43,Default,,0,0,0,,Емтиханды бастайық~
Dialogue: 0,0:13:01.57,0:13:05.07,Default,,0,0,0,,Жақсы ма деп ойлаймын...
Dialogue: 0,0:13:01.57,0:13:05.07,Default,,0,0,0,,Иә? Сіз Иори үшін алаңдайсыз ба?
Dialogue: 0,0:13:05.07,0:13:09.08,Default,,0,0,0,,Жарайды, солай ма?
Dialogue: 0,0:13:05.07,0:13:09.08,Default,,0,0,0,,Бірақ дәл қазір...
Dialogue: 0,0:13:09.08,0:13:11.41,Default,,0,0,0,,()
Dialogue: 0,0:13:11.41,0:13:15.08,Default,,0,0,0,,Бұл бірнеше таңдаулы сұрақ.
Dialogue: 0,0:13:11.41,0:13:15.08,Default,,0,0,0,,Қажетсіз нәрселерді жазуға орын жоқ.
Dialogue: 0,0:13:15.08,0:13:17.42,Default,,0,0,0,,Егер уайымдасаңыз, неге қарап көрмеске?
Dialogue: 0,0:13:17.42,0:13:21.09,Default,,0,0,0,,Мен жүгері дорбаларын жүк көліктеріне тиеп, қоймаға апаратынмын.
Dialogue: 0,0:13:21.09,0:13:24.29,Default,,0,0,0,,Чи Чан шынымен сүйкімді~
Dialogue: 0,0:13:30.93,0:13:34.94,Default,,0,0,0,,А, а, а, а, а...
Dialogue: 0,0:13:34.94,0:13:37.44,Default,,0,0,0,,Киса...
Dialogue: 0,0:13:37.44,0:13:39.44,Default,,0,0,0,,Не!
Dialogue: 0,0:13:42.61,0:13:45.61,Default,,0,0,0,,Иә, бәрі өтті.
Dialogue: 0,0:13:42.61,0:13:45.61,Default,,0,0,0,,Нодока Тойохама, дұрыс…
Dialogue: 0,0:13:45.61,0:13:50.41,Default,,0,0,0,,Неліктен бетіңіз ісінген?
Dialogue: 0,0:13:45.61,0:13:50.41,Default,,0,0,0,,Бұл түнде қалудың зияны.
Dialogue: 0,0:13:55.12,0:13:57.73,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:13:55.12,0:13:57.73,Default,,0,0,0,,Бастапқы қалдық қысым неге тең?
Dialogue: 0,0:13:57.73,0:14:00.23,Default,,0,0,0,,200
Dialogue: 0,0:13:57.73,0:14:00.23,Default,,0,0,0,,200
Dialogue: 0,0:14:00.23,0:14:04.23,Default,,0,0,0,,200
Dialogue: 0,0:14:00.23,0:14:04.23,Default,,0,0,0,,Қалдық қысым 60-қа жеткенде маған хабарлаңыз.
Dialogue: 0,0:14:04.23,0:14:07.57,Default,,0,0,0,,Иә
Dialogue: 0,0:14:04.23,0:14:07.57,Default,,0,0,0,,60-та қате бар ма?
Dialogue: 0,0:14:07.57,0:14:11.41,Default,,0,0,0,,Су бетіне шығу уақыты келді.
Dialogue: 0,0:14:11.41,0:14:14.74,Default,,0,0,0,,BCD табылған
Dialogue: 0,0:14:11.41,0:14:14.74,Default,,0,0,0,,Қуат үрлеу түймесін ➡︎ басқан кезде
Dialogue: 0,0:14:14.74,0:14:18.58,Default,,0,0,0,,Ең жақсының ішінде ауа бар және қалқып тұрады.
Dialogue: 0,0:14:18.58,0:14:23.78,Default,,0,0,0,,Егер сіз осы түймені жоғары бассаңыз
Dialogue: 0,0:14:18.58,0:14:23.78,Default,,0,0,0,,Ауа шығып, шөгеді
Dialogue: 0,0:14:30.26,0:14:32.43,Default,,0,0,0,,♬~
Dialogue: 0,0:14:32.43,0:14:36.13,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:14:41.44,0:14:43.60,Default,,0,0,0,,<Нанака: реттегішті бір рет алыңыз➡︎
Dialogue: 0,0:14:43.60,0:14:46.90,Default,,0,0,0,,Суды төгіп, қайта орнатыңыз>
Dialogue: 0,0:14:49.11,0:14:54.62,Default,,0,0,0,,<Суды қалай шығаруға болады
Dialogue: 0,0:14:49.11,0:14:54.62,Default,,0,0,0,,Қалай тыныс алу керек және ➡︎
Dialogue: 0,0:14:54.62,0:14:58.89,Default,,0,0,0,,Бет түймешігін пайдалану жолы
Dialogue: 0,0:14:54.62,0:14:58.89,Default,,0,0,0,,Екі> бар
Dialogue: 0,0:14:58.89,0:15:02.39,Default,,0,0,0,,《Мұраны тастап, тағы да...》
Dialogue: 0,0:15:02.39,0:15:05.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:05.89,0:15:10.23,Default,,0,0,0,,Ақырын және сабырлы
Dialogue: 0,0:15:10.23,0:15:12.57,Default,,0,0,0,,Чисаның бір тармақты кеңесі
Dialogue: 0,0:15:12.57,0:15:16.74,Default,,0,0,0,,Тіркеу ізін жоғалтсаңыз
Dialogue: 0,0:15:12.57,0:15:16.74,Default,,0,0,0,,Оң иықты бір рет төмен түсіріңіз➡︎
Dialogue: 0,0:15:16.74,0:15:21.24,Default,,0,0,0,,Қолды төменнен жоғарыға бұрғанда
Dialogue: 0,0:15:16.74,0:15:21.24,Default,,0,0,0,,Шланг ұсталып қалады
Dialogue: 0,0:15:21.24,0:15:23.84,Default,,0,0,0,,《Жарайды, мен тазалау түймесін қолданамын...》
Dialogue: 0,0:15:26.25,0:15:28.92,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:15:28.92,0:15:31.12,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:15:34.59,0:15:36.59,Default,,0,0,0,,《Жарайды》
Dialogue: 0,0:15:36.59,0:15:40.09,Default,,0,0,0,,<Маскаға су құйыңыз
Dialogue: 0,0:15:36.59,0:15:40.09,Default,,0,0,0,,Суды ағызыңыз
Dialogue: 0,0:15:40.09,0:15:43.26,Default,,0,0,0,,Масканың жоғарғы бөлігін ұстаңыз
Dialogue: 0,0:15:40.09,0:15:43.26,Default,,0,0,0,,Мұрынмен дем шығарғанда➡︎
Dialogue: 0,0:15:43.26,0:15:46.27,Default,,0,0,0,,Су сыртқа шығарылды
Dialogue: 0,0:15:43.26,0:15:46.27,Default,,0,0,0,,Төменнен шығу＞
Dialogue: 0,0:15:46.27,0:15:48.94,Default,,0,0,0,,《Жарайды
Dialogue: 0,0:15:46.27,0:15:48.94,Default,,0,0,0,,Һмпф
Dialogue: 0,0:15:48.94,0:15:50.94,Default,,0,0,0,,Орындалды》
Dialogue: 0,0:15:53.44,0:15:57.04,Default,,0,0,0,,Уф! Ой... ой...
Dialogue: 0,0:15:57.04,0:15:59.88,Default,,0,0,0,,《Қалдық қысым дегеніміз не?
Dialogue: 0,0:15:57.04,0:15:59.88,Default,,0,0,0,,80
Dialogue: 0,0:15:59.88,0:16:02.72,Default,,0,0,0,,60
Dialogue: 0,0:15:59.88,0:16:02.72,Default,,0,0,0,,60
Dialogue: 0,0:16:02.72,0:16:06.05,Default,,0,0,0,,беті
Dialogue: 0,0:16:02.72,0:16:06.05,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:06.05,0:16:09.56,Default,,0,0,0,,Өйткені, Окинавадағы теңіз басқа!
Dialogue: 0,0:16:09.56,0:16:14.73,Default,,0,0,0,,Сіз әрқашан суға түскіңіз келеді!
Dialogue: 0,0:16:09.56,0:16:14.73,Default,,0,0,0,,Бізге ауа-райы жақсы болды.
Dialogue: 0,0:16:14.73,0:16:19.07,Default,,0,0,0,,Huh Қалдық қысым 60 жігіт
Dialogue: 0,0:16:14.73,0:16:19.07,Default,,0,0,0,,А?
Dialogue: 0,0:16:19.07,0:16:22.07,Default,,0,0,0,,Мен 180-ден бастадым.
Dialogue: 0,0:16:22.07,0:16:25.24,Default,,0,0,0,,Мүмкіндігінше сүңгу алдында
Dialogue: 0,0:16:22.07,0:16:25.24,Default,,0,0,0,,Сіз 200 дедіңіз, солай ма?
Dialogue: 0,0:16:25.24,0:16:29.24,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:25.24,0:16:29.24,Default,,0,0,0,,Біз соңғы қалдық қысым туралы айтып отырған сияқтымыз.
Dialogue: 0,0:16:29.24,0:16:31.25,Default,,0,0,0,,Бұл жабу кезіндегі мән бе?
Dialogue: 0,0:16:31.25,0:16:35.42,Default,,0,0,0,,Ештеңені дау-дамайға айналдырмаңыз.
Dialogue: 0,0:16:31.25,0:16:35.42,Default,,0,0,0,,Сол жігіттер
Dialogue: 0,0:16:35.42,0:16:38.92,Default,,0,0,0,,Айтпақшы, менің ағаларым
Dialogue: 0,0:16:35.42,0:16:38.92,Default,,0,0,0,,Неше жаста болды?
Dialogue: 0,0:16:38.92,0:16:42.09,Default,,0,0,0,,Иә? Бұл 110
Dialogue: 0,0:16:38.92,0:16:42.09,Default,,0,0,0,,(Фушигиро) Түпкі Дала жабылды! Арнайы сынып жойылды.
Dialogue: 0,0:16:42.09,0:16:44.76,Default,,0,0,0,,120
Dialogue: 0,0:16:42.09,0:16:44.76,Default,,0,0,0,,130
Dialogue: 0,0:16:44.76,0:16:48.10,Default,,0,0,0,,Нанака ше?
Dialogue: 0,0:16:44.76,0:16:48.10,Default,,0,0,0,,Мен де Чиса-чанмен біргемін.
Dialogue: 0,0:16:48.10,0:16:51.60,Default,,0,0,0,,Сонша...
Dialogue: 0,0:16:48.10,0:16:51.60,Default,,0,0,0,,Әртүрлі цифрлар
Dialogue: 0,0:16:51.60,0:16:55.54,Default,,0,0,0,,Сонымен, сіз әлі де суға түсе алдыңыз, солай ма?
Dialogue: 0,0:16:51.60,0:16:55.54,Default,,0,0,0,,Мен осындамын, мама
Dialogue: 0,0:16:55.54,0:16:59.71,Default,,0,0,0,,Бірінші көтеріліп, төменге сүңгісек.
Dialogue: 0,0:16:55.54,0:16:59.71,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:16:59.71,0:17:05.38,Default,,0,0,0,,Ахахха! Бұл болмайды
Dialogue: 0,0:16:59.71,0:17:05.38,Default,,0,0,0,,Дайвинг – топтық әрекет.
Dialogue: 0,0:17:05.38,0:17:08.72,Default,,0,0,0,,Бір адам жоғары көтерілгенде
Dialogue: 0,0:17:05.38,0:17:08.72,Default,,0,0,0,,Бәріміз бірге жоғары көтерілейік
Dialogue: 0,0:17:08.72,0:17:12.89,Default,,0,0,0,,Бірнеше нұсқаушы болса
Dialogue: 0,0:17:08.72,0:17:12.89,Default,,0,0,0,,Бұл басқа әңгіме.
Dialogue: 0,0:17:12.89,0:17:18.73,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:12.89,0:17:18.73,Default,,0,0,0,,Мені ұстама, дөңес.
Dialogue: 0,0:17:18.73,0:17:22.06,Default,,0,0,0,,Сонымен
Dialogue: 0,0:17:18.73,0:17:22.06,Default,,0,0,0,,Маған неге жоғарыдан қарап тұрсың?
Dialogue: 0,0:17:22.06,0:17:26.73,Default,,0,0,0,,Топтық әрекетті айтқаннан кейін бірден
Dialogue: 0,0:17:22.06,0:17:26.73,Default,,0,0,0,,Сіз тыныштықты бұзып жатырсыз.
Dialogue: 0,0:17:26.73,0:17:30.74,Default,,0,0,0,,Ұжымдық әрекет…
Dialogue: 0,0:17:30.74,0:17:34.08,Default,,0,0,0,,((Егер бала болса
Dialogue: 0,0:17:30.74,0:17:34.08,Default,,0,0,0,,Бұл жақсы тәжірибе емес.
Dialogue: 0,0:17:34.08,0:17:37.08,Default,,0,0,0,,Мені ұстап тұрғаны ренжітті.
Dialogue: 0,0:17:37.08,0:17:41.42,Default,,0,0,0,,Кешіріңіз, бірақ
Dialogue: 0,0:17:37.08,0:17:41.42,Default,,0,0,0,,өтінемін, бас тарта аласыз ба? ))
Dialogue: 0,0:17:41.42,0:17:45.59,Default,,0,0,0,,Айна?
Dialogue: 0,0:17:41.42,0:17:45.59,Default,,0,0,0,,А, а... не?
Dialogue: 0,0:17:45.59,0:17:48.42,Default,,0,0,0,,Мен аң-таң болдым. Сенімен бәрі жақсы ма?
Dialogue: 0,0:17:48.42,0:17:52.09,Default,,0,0,0,,Не, шаршадың ба?
Dialogue: 0,0:17:48.42,0:17:52.09,Default,,0,0,0,,Рухым жетпейді, Кебако.
Dialogue: 0,0:17:52.09,0:17:57.03,Default,,0,0,0,,Сол үшін мені қаңбақ деп айтпа!
Dialogue: 0,0:17:52.09,0:17:57.03,Default,,0,0,0,,Менің физикалық күшімде де, рухымда да проблема жоқ.
Dialogue: 0,0:17:57.03,0:17:59.03,Default,,0,0,0,,Бұл жақсы болар еді...
Dialogue: 0,0:17:59.03,0:18:02.04,Default,,0,0,0,,Егер сіз тіпті ең кішкентай ыңғайсыздықты сезінсеңіз
Dialogue: 0,0:17:59.03,0:18:02.04,Default,,0,0,0,,Маған бірден айтыңыз
Dialogue: 0,0:18:02.04,0:18:04.87,Default,,0,0,0,,Бұл үлкен мәселе болғандықтан
Dialogue: 0,0:18:02.04,0:18:04.87,Default,,0,0,0,,Бұл туралы ойламаңыз
Dialogue: 0,0:18:04.87,0:18:10.04,Default,,0,0,0,,Теңіздегі мысықтар қауіпті.
Dialogue: 0,0:18:04.87,0:18:10.04,Default,,0,0,0,,Кешкі ас ішейік пе? О…
Dialogue: 0,0:18:10.04,0:18:13.05,Default,,0,0,0,,<Нанака: Бади
Dialogue: 0,0:18:10.04,0:18:13.05,Default,,0,0,0,,Ауа таусылған жағдайда➡︎
Dialogue: 0,0:18:13.05,0:18:19.39,Default,,0,0,0,,Менің сегізаяқым
Dialogue: 0,0:18:13.05,0:18:19.39,Default,,0,0,0,,Бос ақшаңызды екінші тарапқа беріңіз
Dialogue: 0,0:18:19.39,0:18:24.09,Default,,0,0,0,,Достарға ауаны бөлу
Dialogue: 0,0:18:19.39,0:18:24.09,Default,,0,0,0,,Мықтап ұстаңыз және жүзіңіз>
Dialogue: 0,0:18:30.06,0:18:32.23,Default,,0,0,0,,Мен бұны бұрыннан-ақ есіме түсіріп қойдым, білесің бе.
Dialogue: 0,0:18:32.23,0:18:50.75,Default,,0,0,0,,♬︎～
Dialogue: 0,0:18:50.75,0:18:53.25,Default,,0,0,0,,《Әдемі теңіз...
Dialogue: 0,0:18:53.25,0:18:57.35,Default,,0,0,0,,Әр адам су астында мәңгі қалғысы келеді.
Dialogue: 0,0:18:53.25,0:18:57.35,Default,,0,0,0,,Менің ойымша》
Dialogue: 0,0:19:00.53,0:19:05.70,Default,,0,0,0,,《Қалдық қысым дегеніміз не?
Dialogue: 0,0:19:00.53,0:19:05.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:05.70,0:19:08.20,Default,,0,0,0,,90
Dialogue: 0,0:19:05.70,0:19:08.20,Default,,0,0,0,,80
Dialogue: 0,0:19:08.20,0:19:10.37,Default,,0,0,0,,Екеуіміздің де әлі уақытымыз көп...
Dialogue: 0,0:19:10.37,0:19:14.38,Default,,0,0,0,,Бәріне мен кінәлімін...
Dialogue: 0,0:19:14.38,0:19:17.71,Default,,0,0,0,,Қалдық қысым дәл қазір 60 болды.
Dialogue: 0,0:19:14.38,0:19:17.71,Default,,0,0,0,,Әлі уақыт бар еді➡︎
Dialogue: 0,0:19:17.71,0:19:20.31,Default,,0,0,0,,Аз ғана болса...》
Dialogue: 0,0:19:27.22,0:19:30.02,Default,,0,0,0,,《Бұл 60...
Dialogue: 0,0:19:27.22,0:19:30.02,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:36.90,0:19:39.90,Default,,0,0,0,,Нодока Тойохама, дұрыс…
Dialogue: 0,0:19:39.90,0:19:43.57,Default,,0,0,0,,Сәлем, Кебако
Dialogue: 0,0:19:39.90,0:19:43.57,Default,,0,0,0,,Не?
Dialogue: 0,0:19:43.57,0:19:46.07,Default,,0,0,0,,Бұл «Не?» емес.
Dialogue: 0,0:19:43.57,0:19:46.07,Default,,0,0,0,,Сіз енді➡︎
Dialogue: 0,0:19:46.07,0:19:48.91,Default,,0,0,0,,Сіз қалдық қысымды алдауға тырыстыңыз.
Dialogue: 0,0:19:46.07,0:19:48.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:48.91,0:19:53.41,Default,,0,0,0,,Теңізде өгіз болған жақсы емес дейді.
Dialogue: 0,0:19:48.91,0:19:53.41,Default,,0,0,0,,Жаңа ғана айтқанмен.
Dialogue: 0,0:19:53.41,0:19:58.25,Default,,0,0,0,,Мен қанша қалдық қысымды сезінсем де...
Dialogue: 0,0:19:53.41,0:19:58.25,Default,,0,0,0,,(Толық шоғырлану тынысы)
Dialogue: 0,0:19:58.25,0:20:01.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:58.25,0:20:01.42,Default,,0,0,0,,Өйткені бұл менің кінәм➡︎
Dialogue: 0,0:20:01.42,0:20:04.76,Default,,0,0,0,,Барлығы тез тұруы керек
Dialogue: 0,0:20:01.42,0:20:04.76,Default,,0,0,0,,Мен бара алмаймын деп ойладым...
Dialogue: 0,0:20:04.76,0:20:07.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:04.76,0:20:07.76,Default,,0,0,0,,Себебі мен қалдық қысым шайқасында жеңілгім келмейді➡︎
Dialogue: 0,0:20:07.76,0:20:11.60,Default,,0,0,0,,Ол сені алдамақ болған жоқ па?
Dialogue: 0,0:20:07.76,0:20:11.60,Default,,0,0,0,,Мен мұны істемеймін!
Dialogue: 0,0:20:11.60,0:20:15.94,Default,,0,0,0,,Сол... біздің үлкендеріміздің.
Dialogue: 0,0:20:11.60,0:20:15.94,Default,,0,0,0,,Мазасыздық болмас үшін...
Dialogue: 0,0:20:15.94,0:20:18.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:15.94,0:20:18.94,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:18.94,0:20:21.28,Default,,0,0,0,,Жоқ, бұл не?➡︎
Dialogue: 0,0:20:21.28,0:20:24.11,Default,,0,0,0,,Адамдарды жақсы көресің.
Dialogue: 0,0:20:21.28,0:20:24.11,Default,,0,0,0,,Мен ол жерде жоқ деп ойладым.
Dialogue: 0,0:20:24.11,0:20:27.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:24.11,0:20:27.28,Default,,0,0,0,,Не? Мен түсінбеймін, бірақ...
Dialogue: 0,0:20:27.28,0:20:29.78,Default,,0,0,0,,Сіз түсінбейтін адамсыз, солай ма?
Dialogue: 0,0:20:29.78,0:20:33.45,Default,,0,0,0,,Сол адамдар
Dialogue: 0,0:20:29.78,0:20:33.45,Default,,0,0,0,,Сіз бұл туралы ойлайсыз ба?
Dialogue: 0,0:20:33.45,0:20:35.46,Default,,0,0,0,,А...
Dialogue: 0,0:20:33.45,0:20:35.46,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:20:35.46,0:20:38.63,Default,,0,0,0,,Эй... күте тұр!? иә?
Dialogue: 0,0:20:38.63,0:20:41.96,Default,,0,0,0,,Бұл сияқты көрінеді
Dialogue: 0,0:20:38.63,0:20:41.96,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:41.96,0:20:45.97,Default,,0,0,0,,Сіз бұл туралы ойладыңыз ба?
Dialogue: 0,0:20:41.96,0:20:45.97,Default,,0,0,0,,Білесің бе, Айна
Dialogue: 0,0:20:45.97,0:20:48.47,Default,,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,0:20:45.97,0:20:48.47,Default,,0,0,0,,Айна бізге➡︎
Dialogue: 0,0:20:48.47,0:20:50.81,Default,,0,0,0,,Неліктен құрметтеу тілін қолданасыз?
Dialogue: 0,0:20:50.81,0:20:54.64,Default,,0,0,0,,Жарайды, себебі мен жоғары курста оқимын.
Dialogue: 0,0:20:50.81,0:20:54.64,Default,,0,0,0,,Әрине...
Dialogue: 0,0:20:54.64,0:20:58.08,Default,,0,0,0,,Иә, иә. Айна үшін.
Dialogue: 0,0:20:54.64,0:20:58.08,Default,,0,0,0,,Үлкендерге құрмет көрсету➡︎
Dialogue: 0,0:20:58.08,0:21:02.08,Default,,0,0,0,,Бұл табиғи нәрсе.
Dialogue: 0,0:20:58.08,0:21:02.08,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:21:02.08,0:21:04.75,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:21:04.75,0:21:09.09,Default,,0,0,0,,Құрметті қариялар төзімді
Dialogue: 0,0:21:04.75,0:21:09.09,Default,,0,0,0,,Бұл анық емес деп ойлайсыз ба?
Dialogue: 0,0:21:09.09,0:21:13.43,Default,,0,0,0,,Тыңдармандар, танысуға қуаныштымын.
Dialogue: 0,0:21:09.09,0:21:13.43,Default,,0,0,0,,Жаңадан бастаушылар үшін ауаны тұтыну жылдам
Dialogue: 0,0:21:13.43,0:21:16.93,Default,,0,0,0,,Күміс шашты жарты эльф
Dialogue: 0,0:21:13.43,0:21:16.93,Default,,0,0,0,,Бұл анық емес пе?
Dialogue: 0,0:21:16.93,0:21:20.27,Default,,0,0,0,,Біз сияқты
Dialogue: 0,0:21:16.93,0:21:20.27,Default,,0,0,0,,Қалағанымша айтамын.
Dialogue: 0,0:21:20.27,0:21:24.77,Default,,0,0,0,,Содан кейін келесі жолы оны жақсартуға болады.
Dialogue: 0,0:21:20.27,0:21:24.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:24.77,0:21:28.28,Default,,0,0,0,,Алайда мұндай қауесеттер
Dialogue: 0,0:21:24.77,0:21:28.28,Default,,0,0,0,,Қайта жақпаңыз
Dialogue: 0,0:21:28.28,0:21:31.45,Default,,0,0,0,,Әсіресе қауіпсіздікке қатысты
Dialogue: 0,0:21:28.28,0:21:31.45,Default,,0,0,0,,Ешқашан
Dialogue: 0,0:21:31.45,0:21:36.45,Default,,0,0,0,,Адамның адалдығы - ең жақсы!
Dialogue: 0,0:21:31.45,0:21:36.45,Default,,0,0,0,,О, ау!
Dialogue: 0,0:21:36.45,0:21:39.15,Default,,0,0,0,,Мұндағы қарт адамдар сәл басқаша, солай емес пе?
Dialogue: 0,0:21:41.12,0:21:43.32,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:45.63,0:21:49.80,Default,,0,0,0,,Бірақ солай.
Dialogue: 0,0:21:45.63,0:21:49.80,Default,,0,0,0,,Мана өте сақ➡︎
Dialogue: 0,0:21:49.80,0:21:53.80,Default,,0,0,0,,Бізге тән мен жан бер
Dialogue: 0,0:21:49.80,0:21:53.80,Default,,0,0,0,,Өзіңді әшкерелей алмағандықтан емес пе?
Dialogue: 0,0:21:53.80,0:21:56.57,Default,,0,0,0,,Не!
Dialogue: 0,0:21:53.80,0:21:56.57,Default,,0,0,0,,Сіздің ойыңыз бар!
Dialogue: 0,0:21:56.57,0:21:59.07,Default,,0,0,0,,Суға түсу костюмдері жақсы!
Dialogue: 0,0:21:59.07,0:22:03.08,Default,,0,0,0,,Қайсысы! Мен сізге мысал көрсетемін!
Dialogue: 0,0:21:59.07,0:22:03.08,Default,,0,0,0,,Бұл да ағаның міндеті!
Dialogue: 0,0:22:03.08,0:22:05.25,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:22:05.25,0:22:09.58,Default,,0,0,0,,Бұл жақсы...
Dialogue: 0,0:22:05.25,0:22:09.58,Default,,0,0,0,,Иори-кун, бұл жақсы емес...
Dialogue: 0,0:22:09.58,0:22:13.09,Default,,0,0,0,,Не? Басқа проблемалар бар ма?
Dialogue: 0,0:22:09.58,0:22:13.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:13.09,0:22:18.29,Default,,0,0,0,,Қазір жағдай жүріп жатқанда, Иори-кун жалғыз.
Dialogue: 0,0:22:13.09,0:22:18.29,Default,,0,0,0,,Емтиханнан өте алмай қалуыңыз мүмкін
Dialogue: 0,0:22:22.26,0:22:26.26,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:22:22.26,0:22:26.26,Default,,0,0,0,,Иә, шындап.
Dialogue: 0,0:22:27.76,0:22:33.76,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
