Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.25,0:00:15.26,Default,,0,0,0,,♬︎～
Dialogue: 0,0:00:15.26,0:00:18.43,Default,,0,0,0,,Хмм! Келді!
Dialogue: 0,0:00:18.43,0:00:21.93,Default,,0,0,0,,Бұл Миякодзима
Dialogue: 0,0:00:18.43,0:00:21.93,Default,,0,0,0,,Бұл өте алыс болды.
Dialogue: 0,0:00:21.93,0:00:26.27,Default,,0,0,0,,Префектура шегінде
Dialogue: 0,0:00:21.93,0:00:26.27,Default,,0,0,0,,Ұшақта болу сергітеді.
Dialogue: 0,0:00:26.27,0:00:29.44,Default,,0,0,0,,Тайвань негізгі аралға қарағанда жақсырақ.
Dialogue: 0,0:00:26.27,0:00:29.44,Default,,0,0,0,,Жақын сияқты.
Dialogue: 0,0:00:29.44,0:00:31.94,Default,,0,0,0,,Ал, бұл алыс.
Dialogue: 0,0:00:31.94,0:00:34.94,Default,,0,0,0,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:00:31.94,0:00:34.94,Default,,0,0,0,,Бейсаналық...
Dialogue: 0,0:00:34.94,0:00:37.61,Default,,0,0,0,,Егер қазір суға түскіңіз келсе, ішімдік ішпеңіз.
Dialogue: 0,0:00:37.61,0:00:40.78,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:00:37.61,0:00:40.78,Default,,0,0,0,,Сіз ПаВ~-ға әбден құмарсыз
Dialogue: 0,0:00:40.78,0:00:43.45,Default,,0,0,0,,Әй?
Dialogue: 0,0:00:40.78,0:00:43.45,Default,,0,0,0,,Ей! Естисің бе!? Польнареф!?
Dialogue: 0,0:00:43.45,0:00:46.95,Default,,0,0,0,,Сәлем! Сіз жігіттер!
Dialogue: 0,0:00:43.45,0:00:46.95,Default,,0,0,0,,Сіз аман-есен жеткен сияқтысыз.
Dialogue: 0,0:00:49.96,0:00:52.63,Default,,0,0,0,,Жол бойы келгенім үшін кешірім сұраймын.
Dialogue: 0,0:00:52.63,0:00:54.80,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:00:52.63,0:00:54.80,Default,,0,0,0,,Біз➡︎
Dialogue: 0,0:00:54.80,0:00:58.57,Default,,0,0,0,,Өйткені мен кеше түнде келдім.
Dialogue: 0,0:00:54.80,0:00:58.57,Default,,0,0,0,,Бұл өте ерте.
Dialogue: 0,0:00:58.57,0:01:02.07,Default,,0,0,0,,Мен таңертең суға түсемін.
Dialogue: 0,0:00:58.57,0:01:02.07,Default,,0,0,0,,Мен бір күн бұрын баруым керек.
Dialogue: 0,0:01:02.07,0:01:05.57,Default,,0,0,0,,Одан кейінгісі жақсы.
Dialogue: 0,0:01:02.07,0:01:05.57,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:01:05.57,0:01:09.24,Default,,0,0,0,,Отори?
Dialogue: 0,0:01:05.57,0:01:09.24,Default,,0,0,0,,Бұл Мияконың ішу стилі болса керек.
Dialogue: 0,0:01:09.24,0:01:12.91,Default,,0,0,0,,Сіз естіген жоқсыз ба?
Dialogue: 0,0:01:09.24,0:01:12.91,Default,,0,0,0,,Бұл оқу-жаттығу жиынының мақсатының 80%-ы ➡︎
Dialogue: 0,0:01:12.91,0:01:16.42,Default,,0,0,0,,Бұл автоматты.
Dialogue: 0,0:01:12.91,0:01:16.42,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:01:16.42,0:01:18.82,Default,,0,0,0,,Міне!
Dialogue: 0,0:01:22.09,0:01:24.59,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:01:22.09,0:01:24.59,Default,,0,0,0,,Интернеттен бір қауесетті көрдім➡︎
Dialogue: 0,0:01:24.59,0:01:28.76,Rubi,,0,0,0,,Миякончу
Dialogue: 0,0:01:24.59,0:01:28.76,Default,,0,0,0,,«Мияко тұрғындарына рұқсат етілмейді» деген жазу
Dialogue: 0,0:01:24.59,0:01:28.76,Default,,0,0,0,,Оны сататын дүкен бар ма?
Dialogue: 0,0:01:28.76,0:01:31.60,Default,,0,0,0,,Жігіт Оториге телефон соқты
Dialogue: 0,0:01:28.76,0:01:31.60,Default,,0,0,0,,Бұл тым таңқаларлық па?
Dialogue: 0,0:01:31.60,0:01:33.94,Default,,0,0,0,,Күтілгендей, бұл қалалық аңыз.
Dialogue: 0,0:01:33.94,0:01:36.94,Default,,0,0,0,,Сондай қорқынышты түрде ішетін адам
Dialogue: 0,0:01:33.94,0:01:36.94,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:01:36.94,0:01:39.11,Default,,0,0,0,,Бұл емес пе?
Dialogue: 0,0:01:39.11,0:01:43.28,Default,,0,0,0,,Сіз
Dialogue: 0,0:01:39.11,0:01:43.28,Default,,0,0,0,,Сен онда не істедің?
Dialogue: 0,0:01:43.28,0:01:47.62,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:01:43.28,0:01:47.62,Default,,0,0,0,,Бұл сүңгуірдің дебюті
Dialogue: 0,0:01:47.62,0:01:50.79,Default,,0,0,0,,Аа... бұл рас...
Dialogue: 0,0:01:50.79,0:01:53.79,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,0:01:50.79,0:01:53.79,Default,,0,0,0,,Кеше қызуым көтеріліп, төсекке жаттым.
Dialogue: 0,0:01:53.79,0:01:56.73,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:01:53.79,0:01:56.73,Default,,0,0,0,,Сонымен лицензия ала алмадыңыз ба?
Dialogue: 0,0:01:56.73,0:01:58.89,Default,,0,0,0,,Ұят...
Dialogue: 0,0:01:58.89,0:02:01.23,Default,,0,0,0,,Біраз
Dialogue: 0,0:01:58.89,0:02:01.23,Default,,0,0,0,,Мен оны тым көп күтемін...
Dialogue: 0,0:02:01.23,0:02:04.23,Default,,0,0,0,,Бұл жара мен қазып алынған топырақ неден?
Dialogue: 0,0:02:01.23,0:02:04.23,Default,,0,0,0,,Саяхатта балаңыздың қызуы көтеріліп жатыр ма?
Dialogue: 0,0:02:04.23,0:02:07.40,Default,,0,0,0,,Сонымен
Dialogue: 0,0:02:04.23,0:02:07.40,Default,,0,0,0,,Мен сенімен суға түсе алмаймын.
Dialogue: 0,0:02:07.40,0:02:10.40,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:07.40,0:02:10.40,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:02:15.24,0:02:20.75,Default,,0,0,0,,О! Керемет жылдамдық!
Dialogue: 0,0:02:15.24,0:02:20.75,Default,,0,0,0,,Жел өте жақсы!
Dialogue: 0,0:02:20.75,0:02:24.92,Default,,0,0,0,,Әй, не?
Dialogue: 0,0:02:20.75,0:02:24.92,Default,,0,0,0,,Әй... менің бетім жақын!
Dialogue: 0,0:02:24.92,0:02:28.42,Default,,0,0,0,,Жаңадан бастағандар көңіл көтере бастады
Dialogue: 0,0:02:28.42,0:02:31.09,Default,,0,0,0,,А?
Dialogue: 0,0:02:28.42,0:02:31.09,Default,,0,0,0,,Мен сізді естимін!
Dialogue: 0,0:02:31.09,0:02:33.09,Default,,0,0,0,,Міне!
Dialogue: 0,0:02:31.09,0:02:33.09,Default,,0,0,0,,Бұл тек екінші рет!
Dialogue: 0,0:02:33.09,0:02:37.60,Default,,0,0,0,,Жаңадан бастаушыларға арналған
Dialogue: 0,0:02:33.09,0:02:37.60,Default,,0,0,0,,Мен борттағы менеджерге айтайын ба?
Dialogue: 0,0:02:37.60,0:02:41.94,Default,,0,0,0,,О, тоқтат!
Dialogue: 0,0:02:37.60,0:02:41.94,Default,,0,0,0,,Басқа тұтынушылар бар!
Dialogue: 0,0:02:41.94,0:02:46.11,Default,,0,0,0,,Олай болса, бәріңе.
Dialogue: 0,0:02:41.94,0:02:46.11,Default,,0,0,0,,Кездесу басталады!
Dialogue: 0,0:02:46.11,0:02:48.41,Default,,0,0,0,,Неге ол маған ашулана қарады?
Dialogue: 0,0:02:50.95,0:02:53.11,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,0:02:53.11,0:02:59.22,Default,,0,0,0,,Тереңдігі 17 метр
Dialogue: 0,0:02:53.11,0:02:59.22,Default,,0,0,0,,Сүңгу уақыты 40 минутқа жоспарланған.
Dialogue: 0,0:02:59.22,0:03:02.56,Default,,0,0,0,,Олай болса, бәріңе.
Dialogue: 0,0:02:59.22,0:03:02.56,Default,,0,0,0,,Дайын болыңыз!
Dialogue: 0,0:03:02.56,0:03:04.56,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:03:04.56,0:03:07.40,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:03:04.56,0:03:07.40,Default,,0,0,0,,Киінетін бөлмеде ауыстырайық!
Dialogue: 0,0:03:07.40,0:03:10.73,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:03:07.40,0:03:10.73,Default,,0,0,0,,Не?
Dialogue: 0,0:03:10.73,0:03:13.74,Default,,0,0,0,,Тереңдігі 17 метр болса, лицензия жоқ...
Dialogue: 0,0:03:13.74,0:03:15.74,Default,,0,0,0,,Онда бәрібір.
Dialogue: 0,0:03:15.74,0:03:19.74,Default,,0,0,0,,1-ші және 2-ші сеанстар сынақтық суға түсуге арналған.
Dialogue: 0,0:03:15.74,0:03:19.74,Default,,0,0,0,,Мен оны араластыруға тура келді.
Dialogue: 0,0:03:19.74,0:03:21.91,Default,,0,0,0,,Үшіншіге қатысты не істеуім керек?
Dialogue: 0,0:03:21.91,0:03:24.75,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:03:21.91,0:03:24.75,Default,,0,0,0,,Сіз үш сүңгуді жоспарлап отырған сияқтысыз.
Dialogue: 0,0:03:24.75,0:03:27.25,Default,,0,0,0,,Мен кемеде күтемін.
Dialogue: 0,0:03:27.25,0:03:31.59,Default,,0,0,0,,Мүмкін мен де араластыруым керек.
Dialogue: 0,0:03:27.25,0:03:31.59,Default,,0,0,0,,А? Неліктен?
Dialogue: 0,0:03:31.59,0:03:34.59,Default,,0,0,0,,Өйткені
Dialogue: 0,0:03:31.59,0:03:34.59,Default,,0,0,0,,Мен жақсы суға түсе алатыныма сенімді емеспін...
Dialogue: 0,0:03:34.59,0:03:38.59,Default,,0,0,0,,Қандай бос сөз
Dialogue: 0,0:03:34.59,0:03:38.59,Default,,0,0,0,,Менің үлкендерім де артымнан келеді➡︎
Dialogue: 0,0:03:38.59,0:03:41.10,Default,,0,0,0,,Мына жігіт те сонда, солай ма?
Dialogue: 0,0:03:41.10,0:03:46.10,Default,,0,0,0,,Бұл керемет теңіз
Dialogue: 0,0:03:41.10,0:03:46.10,Default,,0,0,0,,Барынша алысқа барыңыз
Dialogue: 0,0:03:46.10,0:03:49.10,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:46.10,0:03:49.10,Default,,0,0,0,,⚞Сүңгуірден өту➡︎
Dialogue: 0,0:03:49.10,0:03:51.61,Default,,0,0,0,,Жиналыңыз!
Dialogue: 0,0:03:49.10,0:03:51.61,Default,,0,0,0,,Қап…
Dialogue: 0,0:03:51.61,0:03:54.31,Default,,0,0,0,,Міне, солай⚞
Dialogue: 0,0:03:51.61,0:03:54.31,Default,,0,0,0,,Көңілді болыңыз!
Dialogue: 0,0:04:04.05,0:04:07.39,Default,,0,0,0,,Ақырын және сабырлы
Dialogue: 0,0:04:04.05,0:04:07.39,Default,,0,0,0,,Құлақтарды алу кезінде.
Dialogue: 0,0:04:07.39,0:04:09.72,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:04:09.72,0:04:42.26,Default,,0,0,0,,♬︎～
Dialogue: 0,0:04:42.26,0:04:44.76,Default,,0,0,0,,Теңіз тасбақасы жақындады.
Dialogue: 0,0:04:44.76,0:04:49.10,Default,,0,0,0,,Бұл керемет болды!
Dialogue: 0,0:04:44.76,0:04:49.10,Default,,0,0,0,,Ата-аналар мен балалар кіреді!
Dialogue: 0,0:04:49.10,0:04:52.10,Default,,0,0,0,,Екі өлшемді сияқты
Dialogue: 0,0:04:49.10,0:04:52.10,Default,,0,0,0,,Бұл керемет болды!
Dialogue: 0,0:04:52.10,0:04:54.44,Default,,0,0,0,,Иоридің орнынан
Dialogue: 0,0:04:52.10,0:04:54.44,Default,,0,0,0,,Сіз оны көрмедіңіз бе?
Dialogue: 0,0:04:54.44,0:04:58.21,Default,,0,0,0,,Өкінішке орай...
Dialogue: 0,0:04:54.44,0:04:58.21,Default,,0,0,0,,Егер бұл фото болса, мен түсірдім!
Dialogue: 0,0:04:58.21,0:05:01.71,Default,,0,0,0,,Қараңызшы, мынандай.
Dialogue: 0,0:04:58.21,0:05:01.71,Default,,0,0,0,,Уа, ау!
Dialogue: 0,0:05:01.71,0:05:04.05,Default,,0,0,0,,Мүмкін болса
Dialogue: 0,0:05:01.71,0:05:04.05,Default,,0,0,0,,Мен оны жақыннан көргім келді!
Dialogue: 0,0:05:04.05,0:05:07.38,Default,,0,0,0,,Не! Лицензия алсаңыз
Dialogue: 0,0:05:04.05,0:05:07.38,Default,,0,0,0,,Тағы бір мүмкіндік бар!
Dialogue: 0,0:05:07.38,0:05:09.72,Default,,0,0,0,,Келесіде қолыңнан келгеннің бәрін жаса, кенже.
Dialogue: 0,0:05:09.72,0:05:13.32,Default,,0,0,0,,Маған айтқанда
Dialogue: 0,0:05:09.72,0:05:13.32,Default,,0,0,0,,Біртүрлі ашуланбаңыз.
Dialogue: 0,0:05:16.22,0:05:19.06,Default,,0,0,0,,Мен шай алайын.
Dialogue: 0,0:05:19.06,0:05:21.73,Default,,0,0,0,,Нодока Тойохама, дұрыс…
Dialogue: 0,0:05:21.73,0:05:36.24,Default,,0,0,0,,♬︎〜
Dialogue: 0,0:05:36.24,0:05:40.34,Default,,0,0,0,,《Аа, бұл жер аквариумға ұқсайды...》
Dialogue: 0,0:05:42.75,0:05:46.55,Default,,0,0,0,,((Келесі
Dialogue: 0,0:05:42.75,0:05:46.55,Default,,0,0,0,,Мен оны жақынырақ көргім келеді))
Dialogue: 0,0:05:50.26,0:05:54.36,Default,,0,0,0,,《Ол жерден алыс...》
Dialogue: 0,0:06:01.54,0:06:03.87,Default,,0,0,0,,Бұл өте керемет болды...
Dialogue: 0,0:06:03.87,0:06:06.37,Default,,0,0,0,,Бұл маған камераны қалайды.
Dialogue: 0,0:06:06.37,0:06:09.21,Default,,0,0,0,,Жарықтың түсу жолы
Dialogue: 0,0:06:06.37,0:06:09.21,Default,,0,0,0,,Бұл жақсы уақыт болды.
Dialogue: 0,0:06:09.21,0:06:11.88,Default,,0,0,0,,Екеуі де емес пе!?
Dialogue: 0,0:06:09.21,0:06:11.88,Default,,0,0,0,,Оны көру саған емес.
Dialogue: 0,0:06:11.88,0:06:16.22,Default,,0,0,0,,Иә? Ал Иори ше?
Dialogue: 0,0:06:11.88,0:06:16.22,Default,,0,0,0,,Сіз палубада демаламын дедіңіз.
Dialogue: 0,0:06:16.22,0:06:21.39,Default,,0,0,0,,Ммм, түсіндім.
Dialogue: 0,0:06:16.22,0:06:21.39,Default,,0,0,0,,Иори бүгін өте тыныш сияқты.
Dialogue: 0,0:06:21.39,0:06:26.90,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:06:21.39,0:06:26.90,Default,,0,0,0,,Мүмкін сіз өзіңізді жақсы сезінбейтін шығарсыз.
Dialogue: 0,0:06:26.90,0:06:29.73,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:06:26.90,0:06:29.73,Default,,0,0,0,,Не болды? Чиса-чан
Dialogue: 0,0:06:29.73,0:06:35.83,Default,,0,0,0,,Үшіншісін жасамаймын.
Dialogue: 0,0:06:29.73,0:06:35.83,Default,,0,0,0,,Тек тыңдаңыз...
Dialogue: 0,0:06:50.25,0:06:52.59,Default,,0,0,0,,Білесің бе, Иори?
Dialogue: 0,0:06:52.59,0:06:59.19,Default,,0,0,0,,Бәрімен суға түсе алмайтыным ұят.
Dialogue: 0,0:06:52.59,0:06:59.19,Default,,0,0,0,,Бұл соңғы рет емес
Dialogue: 0,0:06:59.19,0:07:05.87,Default,,0,0,0,,Сіз ертең сынақ тәжірибесіне бара аласыз.
Dialogue: 0,0:06:59.19,0:07:05.87,Default,,0,0,0,,Олар да таяз нүктелерге баратын сияқты...
Dialogue: 0,0:07:05.87,0:07:08.87,Default,,0,0,0,,Иә, иә! Бұрынғы толық емес жұмысымда➡︎
Dialogue: 0,0:07:08.87,0:07:12.37,Default,,0,0,0,,Мен аквариумға кіру билетін алдым.
Dialogue: 0,0:07:08.87,0:07:12.37,Default,,0,0,0,,Сізге ұнаса...
Dialogue: 0,0:07:12.37,0:07:16.04,Default,,0,0,0,,Чиса…
Dialogue: 0,0:07:12.37,0:07:16.04,Default,,0,0,0,,(Жолаушы) Білемін, білемін. Сен бар күшіңді салып жатқан сияқтысың.
Dialogue: 0,0:07:16.04,0:07:19.88,Default,,0,0,0,,Кеме қатты шайқалады...
Dialogue: 0,0:07:19.88,0:07:22.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:22.22,0:07:26.05,Default,,0,0,0,,Кеңес бергендей, қозғалыс ауруына қарсы дәрі
Dialogue: 0,0:07:22.22,0:07:26.05,Default,,0,0,0,,Мен оны ішуім керек еді...
Dialogue: 0,0:07:26.05,0:07:31.89,Default,,0,0,0,,Сондай-ақ, суға түсу алдында су бетінде күту
Dialogue: 0,0:07:26.05,0:07:31.89,Default,,0,0,0,,Бұл да өте діріл және қатал...
Dialogue: 0,0:07:31.89,0:07:34.06,Default,,0,0,0,,Iori…
Dialogue: 0,0:07:31.89,0:07:34.06,Default,,0,0,0,,Не?
Dialogue: 0,0:07:34.06,0:07:36.90,Default,,0,0,0,,Мүмкін ол жай ғана мас болған шығар?
Dialogue: 0,0:07:36.90,0:07:40.90,Default,,0,0,0,,«Тек» нені білдіреді?
Dialogue: 0,0:07:36.90,0:07:40.90,Default,,0,0,0,,Бұл өте ауыр...
Dialogue: 0,0:07:45.07,0:07:47.91,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:07:45.07,0:07:47.91,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:07:47.91,0:07:51.25,Default,,0,0,0,,Бірақ, солай, Чиза.
Dialogue: 0,0:07:47.91,0:07:51.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:51.25,0:07:56.35,Default,,0,0,0,,Ха... Сіз жақсы әйелсіз.
Dialogue: 0,0:07:56.35,0:08:00.19,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың?
Dialogue: 0,0:08:00.19,0:08:05.36,Default,,0,0,0,,Жалғыз қалған маған
Dialogue: 0,0:08:00.19,0:08:05.36,Default,,0,0,0,,Сіз қамқор болдыңыз, солай ма?
Dialogue: 0,0:08:05.36,0:08:09.70,Default,,0,0,0,,Бұл іс жүзінде олай емес...
Dialogue: 0,0:08:05.36,0:08:09.70,Default,,0,0,0,,Жарайды, Чиса.
Dialogue: 0,0:08:09.70,0:08:14.70,Default,,0,0,0,,Мен тек осы деңгейде ғана сүңги аламын.
Dialogue: 0,0:08:09.70,0:08:14.70,Default,,0,0,0,,Мен сені жек көрмеймін.
Dialogue: 0,0:08:17.37,0:08:21.38,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:08:17.37,0:08:21.38,Default,,0,0,0,,Таңғажайып сүңгу
Dialogue: 0,0:08:21.38,0:08:25.55,Default,,0,0,0,,Теңізде ғана емес
Dialogue: 0,0:08:21.38,0:08:25.55,Default,,0,0,0,,Қайыққа міну қызық болады деп ойламадым.
Dialogue: 0,0:08:25.55,0:08:27.55,Default,,0,0,0,,Кеме?
Dialogue: 0,0:08:25.55,0:08:27.55,Default,,0,0,0,,Жаңа ғана осы нүктеге жеттім➡︎
Dialogue: 0,0:08:27.55,0:08:29.72,Default,,0,0,0,,Көшіп келе жатқанда солай ойладым.
Dialogue: 0,0:08:29.72,0:08:33.22,Default,,0,0,0,,Теңізде көргенім туралы
Dialogue: 0,0:08:29.72,0:08:33.22,Default,,0,0,0,,Сөйлесу➡︎
Dialogue: 0,0:08:33.22,0:08:36.22,Default,,0,0,0,,Барлығымыз түскі асты қайықта іштік.
Dialogue: 0,0:08:36.22,0:08:39.73,Default,,0,0,0,,Теңіз самалы мен күн сәулесінде дем алу
Dialogue: 0,0:08:36.22,0:08:39.73,Default,,0,0,0,,Жылжыту немесе
Dialogue: 0,0:08:39.73,0:08:44.73,Default,,0,0,0,,Бұл өте жақсы сезіледі
Dialogue: 0,0:08:39.73,0:08:44.73,Default,,0,0,0,,Иә
Dialogue: 0,0:08:44.73,0:08:48.24,Default,,0,0,0,,Тіпті үнемі шулы ағаларым
Dialogue: 0,0:08:44.73,0:08:48.24,Default,,0,0,0,,Міне.
Dialogue: 0,0:08:48.24,0:08:51.41,Default,,0,0,0,,Күнге күйіп жатқан мысыққа ұқсайды.
Dialogue: 0,0:08:51.41,0:08:54.41,Default,,0,0,0,,Дайвинг тәжірибесіне не себеп болды?
Dialogue: 0,0:08:51.41,0:08:54.41,Default,,0,0,0,,Өте жаман➡︎
Dialogue: 0,0:08:54.41,0:08:57.51,Default,,0,0,0,,Мен тағы да келгім келді.
Dialogue: 0,0:08:54.41,0:08:57.51,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:57.51,0:08:59.85,Default,,0,0,0,,Ол тесілді ме?
Dialogue: 0,0:08:57.51,0:08:59.85,Default,,0,0,0,,Себебі мен үшінші рет суға түсе алмадым➡︎
Dialogue: 0,0:08:59.85,0:09:04.35,Default,,0,0,0,,Сіз кек алғыңыз келеді, солай ма?
Dialogue: 0,0:08:59.85,0:09:04.35,Default,,0,0,0,,Бұл рас...
Dialogue: 0,0:09:06.35,0:09:08.86,Default,,0,0,0,,Егер бұл Иоридің сыйы болса
Dialogue: 0,0:09:08.86,0:09:11.86,Default,,0,0,0,,Менің қаржылық жағдайымды білесіз бе?
Dialogue: 0,0:09:08.86,0:09:11.86,Default,,0,0,0,,Жақсы айтылған.
Dialogue: 0,0:09:11.86,0:09:15.03,Default,,0,0,0,,Егер мен лотерея ұтып алсам,
Dialogue: 0,0:09:11.86,0:09:15.03,Default,,0,0,0,,Мен сені әкелемін.
Dialogue: 0,0:09:15.03,0:09:18.23,Default,,0,0,0,,Иә, мен күтпей күтемін.
Dialogue: 0,0:09:20.20,0:09:23.87,Default,,0,0,0,,Олай болса, бәріңе.
Dialogue: 0,0:09:20.20,0:09:23.87,Default,,0,0,0,,Бұл борттық суға түсудің соңы.
Dialogue: 0,0:09:23.87,0:09:27.38,Default,,0,0,0,,Жерге қайтайық!
Dialogue: 0,0:09:23.87,0:09:27.38,Default,,0,0,0,,Ui~ssu
Dialogue: 0,0:09:27.38,0:09:47.28,Default,,0,0,0,,♬︎～
Dialogue: 0,0:09:49.23,0:09:51.40,Default,,0,0,0,,Барлығың тыңдаңдар.
Dialogue: 0,0:09:51.40,0:09:55.57,Default,,0,0,0,,Миякодзимаға келу себептерінің 80% құрайды
Dialogue: 0,0:09:51.40,0:09:55.57,Default,,0,0,0,,Бұл толық тәжірибе, бірақ...
Dialogue: 0,0:09:55.57,0:09:59.57,Default,,0,0,0,,Жоспарланған дүкен
Dialogue: 0,0:09:55.57,0:09:59.57,Default,,0,0,0,,Белгілі бір себептермен уақытша жабылуына байланысты➡︎
Dialogue: 0,0:09:59.57,0:10:03.24,Default,,0,0,0,,Мен бас тартуға тура келді.
Dialogue: 0,0:09:59.57,0:10:03.24,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:10:03.24,0:10:07.08,Default,,0,0,0,,Отори шексіз сусындар дегенді білдіреді, солай ма?
Dialogue: 0,0:10:03.24,0:10:07.08,Default,,0,0,0,,Ах
Dialogue: 0,0:10:07.08,0:10:10.25,Default,,0,0,0,,Шексіз дүниежүзілік соғыстан
Dialogue: 0,0:10:07.08,0:10:10.25,Default,,0,0,0,,Сіз қашып кеттіңіз бе?
Dialogue: 0,0:10:10.25,0:10:13.76,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:10:10.25,0:10:13.76,Default,,0,0,0,,Қазір Миякодзимада тыныш түн...
Dialogue: 0,0:10:13.76,0:10:16.26,Default,,0,0,0,,Бірақ
Dialogue: 0,0:10:13.76,0:10:16.26,Default,,0,0,0,,Мен Миякодзимаға дейін келдім.
Dialogue: 0,0:10:16.26,0:10:19.59,Default,,0,0,0,,Кем дегенде өзіміздікі
Dialogue: 0,0:10:16.26,0:10:19.59,Default,,0,0,0,,Оториді қолданып көрейік!
Dialogue: 0,0:10:19.59,0:10:22.29,Default,,0,0,0,,♬~
Dialogue: 0,0:10:26.77,0:10:28.77,Default,,0,0,0,,Гррр…
Dialogue: 0,0:10:28.77,0:10:32.44,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:10:28.77,0:10:32.44,Default,,0,0,0,,Бұлай жүгірме, 1 курс.
Dialogue: 0,0:10:32.44,0:10:35.34,Default,,0,0,0,,Ал, бастайық.
Dialogue: 0,0:10:38.65,0:10:41.16,Default,,0,0,0,,Біздің Отори нұсқасы қандай?
Dialogue: 0,0:10:41.16,0:10:45.16,Default,,0,0,0,,Жарайды, олай уайымдама.
Dialogue: 0,0:10:41.16,0:10:45.16,Default,,0,0,0,,Мен оны қазір түсіндіремін.
Dialogue: 0,0:10:45.16,0:10:48.33,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:10:45.16,0:10:48.33,Default,,0,0,0,,Мен де сол бөтелке саке ішуді ойлап отырмын.
Dialogue: 0,0:10:48.33,0:10:50.50,Default,,0,0,0,,Бұл керемет оқу-жаттығу жиыны.
Dialogue: 0,0:10:50.50,0:10:53.33,Default,,0,0,0,,Бір қазаннан шыққан күріш сияқты.
Dialogue: 0,0:10:53.33,0:10:55.77,Default,,0,0,0,,Дегенмен,
Dialogue: 0,0:10:53.33,0:10:55.77,Default,,0,0,0,,Әркімнің қалауы➡︎
Dialogue: 0,0:10:55.77,0:11:00.27,Default,,0,0,0,,Сакеге сәйкес келу таңқаларлық қиын
Dialogue: 0,0:10:55.77,0:11:00.27,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:11:00.27,0:11:04.11,Default,,0,0,0,,Бірақ мұнда барлығының алған әсері бар.
Dialogue: 0,0:11:00.27,0:11:04.11,Default,,0,0,0,,Өзгеше болу үшін жалғыз болу керек.
Dialogue: 0,0:11:04.11,0:11:08.62,Default,,0,0,0,,Бұл рас болуы мүмкін...
Dialogue: 0,0:11:04.11,0:11:08.62,Default,,0,0,0,,Бұл оқу-жаттығу жиынын еске түсіретін сусын...
Dialogue: 0,0:11:08.62,0:11:10.95,Default,,0,0,0,,Сонымен біз ойладық
Dialogue: 0,0:11:10.95,0:11:16.12,Default,,0,0,0,,Сондықтан бұл әділ
Dialogue: 0,0:11:10.95,0:11:16.12,Default,,0,0,0,,Ыстық саке ішкен жақсы болар еді деп ойлаймын.
Dialogue: 0,0:11:16.12,0:11:19.13,Default,,0,0,0,,Әділдікті қалай сақтау керек
Dialogue: 0,0:11:16.12,0:11:19.13,Default,,0,0,0,,Біртүрлі емес пе?
Dialogue: 0,0:11:19.13,0:11:23.97,Default,,0,0,0,,Енді мына құмыраны бұраңыз.
Dialogue: 0,0:11:19.13,0:11:23.97,Default,,0,0,0,,Мен саған сүйікті сусыныңды құйып берейін.
Dialogue: 0,0:11:23.97,0:11:27.80,Default,,0,0,0,,Ол кезде бәрі жақсы.
Dialogue: 0,0:11:23.97,0:11:27.80,Default,,0,0,0,,Бірнеше сөз айтыңыз.
Dialogue: 0,0:11:27.80,0:11:30.81,Default,,0,0,0,,Ауызша?
Dialogue: 0,0:11:27.80,0:11:30.81,Default,,0,0,0,,Отори дегеніміз не? Бір сөз➡︎
Dialogue: 0,0:11:30.81,0:11:32.81,Default,,0,0,0,,Бірдеңе айту керек сияқты.
Dialogue: 0,0:11:32.81,0:11:35.31,Default,,0,0,0,,«Арал мен теңіздің сұлулығына арналған».
Dialogue: 0,0:11:32.81,0:11:35.31,Default,,0,0,0,,т.б.
Dialogue: 0,0:11:35.31,0:11:37.31,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:37.31,0:11:40.82,Default,,0,0,0,,Біріншіден, біз сәл байсалдымыз.
Dialogue: 0,0:11:37.31,0:11:40.82,Default,,0,0,0,,Әңгімелесейік
Dialogue: 0,0:11:40.82,0:11:43.32,Default,,0,0,0,,Біз әр жерден келдік➡︎
Dialogue: 0,0:11:43.32,0:11:45.99,Default,,0,0,0,,Дегенмен, не болып жатқанын түсінбеймін.
Dialogue: 0,0:11:43.32,0:11:45.99,Default,,0,0,0,,Бір уақытта бір жерге жиналу...
Dialogue: 0,0:11:45.99,0:11:50.66,Default,,0,0,0,,Бір қайықта, бір банка шарап ішу
Dialogue: 0,0:11:45.99,0:11:50.66,Default,,0,0,0,,Мен оны іше алатыныма қуаныштымын.
Dialogue: 0,0:11:50.66,0:11:55.60,Default,,0,0,0,,Барлығы осында
Dialogue: 0,0:11:50.66,0:11:55.60,Default,,0,0,0,,Пікірлес адамдар мен достар
Dialogue: 0,0:11:55.60,0:11:58.77,Default,,0,0,0,,Соңында
Dialogue: 0,0:11:55.60,0:11:58.77,Default,,0,0,0,,Жолымыз алшақ болса да➡︎
Dialogue: 0,0:11:58.77,0:12:03.27,Default,,0,0,0,,Бірге өткізген уақыт ешқашан кетпейді
Dialogue: 0,0:12:03.27,0:12:06.94,Default,,0,0,0,,Барлығына өміріне көмектесуіңізді өтінемін.
Dialogue: 0,0:12:03.27,0:12:06.94,Default,,0,0,0,,Жастық шағымнан естелік ретінде...
Dialogue: 0,0:12:06.94,0:12:09.44,Default,,0,0,0,,Бүгін бұл күн
Dialogue: 0,0:12:06.94,0:12:09.44,Default,,0,0,0,,Ұмытпа!
Dialogue: 0,0:12:09.44,0:12:11.45,Default,,0,0,0,,Меніңше, Каэдэге де уақыт келген сияқты
Dialogue: 0,0:12:11.45,0:12:14.45,Default,,0,0,0,,Ахх!
Dialogue: 0,0:12:11.45,0:12:14.45,Default,,0,0,0,,Менің жастық шағымнан қандай естеліктер қалды!
Dialogue: 0,0:12:14.45,0:12:17.29,Default,,0,0,0,,Естеліктер алдында
Dialogue: 0,0:12:14.45,0:12:17.29,Default,,0,0,0,,Сіз тіпті естеліктеріңізді артта қалдырғыңыз келмейді!
Dialogue: 0,0:12:17.29,0:12:20.96,Default,,0,0,0,,Балалар мен сендермен өткізген күндерім
Dialogue: 0,0:12:17.29,0:12:20.96,Default,,0,0,0,,Мен оны ешқашан ұмытпаймын!
Dialogue: 0,0:12:20.96,0:12:25.29,Default,,0,0,0,,Онда құйып не керек!
Dialogue: 0,0:12:20.96,0:12:25.29,Default,,0,0,0,,Сіз оны шынымен есте сақтағыңыз келе ме?
Dialogue: 0,0:12:25.29,0:12:29.13,Default,,0,0,0,,Шығысқа қараңыз
Dialogue: 0,0:12:25.29,0:12:29.13,Default,,0,0,0,,Мен өлсем бола ма?
Dialogue: 0,0:12:29.13,0:12:31.13,Default,,0,0,0,,Не болды? шығыс
Dialogue: 0,0:12:31.13,0:12:34.47,Default,,0,0,0,,Жоқ, мен тек химияны оқимын.
Dialogue: 0,0:12:31.13,0:12:34.47,Default,,0,0,0,,Себебі мен келдім➡︎
Dialogue: 0,0:12:34.47,0:12:37.64,Default,,0,0,0,,Мұндай жағдайларда
Dialogue: 0,0:12:34.47,0:12:37.64,Default,,0,0,0,,Мен ештеңе істей алмаймын...
Dialogue: 0,0:12:37.64,0:12:39.97,Default,,0,0,0,,Демек, кем дегенде...
Dialogue: 0,0:12:39.97,0:12:43.14,Default,,0,0,0,,Мен не істей аламын...
Dialogue: 0,0:12:43.14,0:12:45.31,Default,,0,0,0,,Оны салмаңыз!
Dialogue: 0,0:12:45.31,0:12:47.65,Default,,0,0,0,,Хахаха! Бұл әзіл
Dialogue: 0,0:12:47.65,0:12:50.82,Default,,0,0,0,,Осы заттарды араластырсаңыз
Dialogue: 0,0:12:47.65,0:12:50.82,Default,,0,0,0,,Жиілік төмендейді.
Dialogue: 0,0:12:50.82,0:12:55.92,Default,,0,0,0,,Дезинфекциялық спиртке қарағанда қаттырақ па?
Dialogue: 0,0:12:50.82,0:12:55.92,Default,,0,0,0,,Бұл сусын емес!
Dialogue: 0,0:12:55.92,0:12:59.43,Default,,0,0,0,,Егер сіз осындай нәрсемен тост жасасаңыз
Dialogue: 0,0:12:55.92,0:12:59.43,Default,,0,0,0,,Өмірге кепілдік жоқ!
Dialogue: 0,0:12:59.43,0:13:04.27,Default,,0,0,0,,Әрі қарай не болады?
Dialogue: 0,0:12:59.43,0:13:04.27,Default,,0,0,0,,Бетіңізге су құйып, ештеңе жемеңіз...
Dialogue: 0,0:13:04.27,0:13:07.10,Default,,0,0,0,,Жиілікті қауіпсіз диапазонға дейін төмендетіңіз!
Dialogue: 0,0:13:07.10,0:13:09.60,Default,,0,0,0,,Әй, сендер де балалар.
Dialogue: 0,0:13:07.10,0:13:09.60,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:09.60,0:13:11.60,Default,,0,0,0,,Кешкі ас ішейік пе? О…
Dialogue: 0,0:13:13.61,0:13:16.44,Default,,0,0,0,,Көздер! Менің көзім!
Dialogue: 0,0:13:13.61,0:13:16.44,Default,,0,0,0,,Арманым үшін.
Dialogue: 0,0:13:16.44,0:13:20.78,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:13:16.44,0:13:20.78,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:13:20.78,0:13:24.79,Default,,0,0,0,,Әй, сен не істеп жатырсың?
Dialogue: 0,0:13:20.78,0:13:24.79,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:24.79,0:13:28.12,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:13:24.79,0:13:28.12,Default,,0,0,0,,Сіз ашуланбайсыз ба?
Dialogue: 0,0:13:28.12,0:13:31.63,Default,,0,0,0,,Егер сіз осындай нәрсеге ашуланатын жігіт болсаңыз
Dialogue: 0,0:13:28.12,0:13:31.63,Default,,0,0,0,,PaB емес
Dialogue: 0,0:13:31.63,0:13:36.46,Default,,0,0,0,,Ол ешқашан да болмайды!
Dialogue: 0,0:13:31.63,0:13:36.46,Default,,0,0,0,,Жарайды, мен де өзімді қосамын.
Dialogue: 0,0:13:36.46,0:13:40.80,Default,,0,0,0,,О, міне Иори!
Dialogue: 0,0:13:36.46,0:13:40.80,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:13:40.80,0:13:45.47,Default,,0,0,0,,Шынтақ ұру жақсы болса да...
Dialogue: 0,0:13:40.80,0:13:45.47,Default,,0,0,0,,Қызықты жері: Біртүрлі!
Dialogue: 0,0:13:45.47,0:13:48.48,Default,,0,0,0,,Ең болмағанда...
Dialogue: 0,0:13:45.47,0:13:48.48,Default,,0,0,0,,Осымен, әйтеуір...
Dialogue: 0,0:13:48.48,0:13:51.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:48.48,0:13:51.65,Default,,0,0,0,,Жарайды, мен мойындаймын.
Dialogue: 0,0:13:51.65,0:13:55.58,Default,,0,0,0,,Күте тұрыңдар, балалар.
Dialogue: 0,0:13:51.65,0:13:55.58,Default,,0,0,0,,Оның алдында айтар сөзің бар ма?
Dialogue: 0,0:13:55.58,0:13:58.75,Default,,0,0,0,,Үлкен!
Dialogue: 0,0:13:55.58,0:13:58.75,Default,,0,0,0,,А... енді ойласам
Dialogue: 0,0:13:58.75,0:14:02.42,Default,,0,0,0,,Не болды? Кохеи
Dialogue: 0,0:13:58.75,0:14:02.42,Default,,0,0,0,,Айтар ойым жоқ
Dialogue: 0,0:14:02.42,0:14:05.43,Default,,0,0,0,,Не, сен мұндай нәрсеге шебер емессің бе?
Dialogue: 0,0:14:05.43,0:14:07.76,Default,,0,0,0,,Иә... Не істеуім керек...
Dialogue: 0,0:14:07.76,0:14:11.77,Default,,0,0,0,,Хмм, тағы да.
Dialogue: 0,0:14:07.76,0:14:11.77,Default,,0,0,0,,Өзімді таныстырсам қалай болады?
Dialogue: 0,0:14:11.77,0:14:17.27,Default,,0,0,0,,Түсіндім! Сонымен, сіздің атыңыз бен хоббиіңіз.
Dialogue: 0,0:14:11.77,0:14:17.27,Default,,0,0,0,,Ұраным туралы бірдеңе айту керек пе?
Dialogue: 0,0:14:17.27,0:14:19.44,Default,,0,0,0,,Бұл жеткілікті!
Dialogue: 0,0:14:19.44,0:14:22.94,Default,,0,0,0,,Сәлем, 1 курс балалары.
Dialogue: 0,0:14:19.44,0:14:22.94,Default,,0,0,0,,Өз ойыңызды айтыңыз
Dialogue: 0,0:14:22.94,0:14:27.78,Default,,0,0,0,,Иә
Dialogue: 0,0:14:22.94,0:14:27.78,Default,,0,0,0,,Хоббиді атаңыз Ұраны Хоббиіңізді атаңыз…
Dialogue: 0,0:14:27.78,0:14:32.79,Default,,0,0,0,,Е, мен осы шеңберге рахмет айтамын.
Dialogue: 0,0:14:27.78,0:14:32.79,Default,,0,0,0,,Мен оны әрқашан жек көретінмін ...
Dialogue: 0,0:14:32.79,0:14:35.79,Default,,0,0,0,,Кохеи Имамура!
Dialogue: 0,0:14:32.79,0:14:35.79,Default,,0,0,0,,Мен оның сүйкімділігін байқадым.
Dialogue: 0,0:14:35.79,0:14:38.79,Default,,0,0,0,,Басында мені алып кетті...
Dialogue: 0,0:14:35.79,0:14:38.79,Default,,0,0,0,,Аниме және ойындар!
Dialogue: 0,0:14:38.79,0:14:40.80,Default,,0,0,0,,...қазір де
Dialogue: 0,0:14:38.79,0:14:40.80,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:14:40.80,0:14:44.30,Default,,0,0,0,,Сонымен қатар, Ягами-сан, Мокки-саннан Цукидің қозғалысын бақылап отыруды сұраңыз
Dialogue: 0,0:14:40.80,0:14:44.30,Default,,0,0,0,,Өз бетіңізше көбірек күш салыңыз...
Dialogue: 0,0:14:44.30,0:14:46.30,Default,,0,0,0,,Кохэй-чан, өтінемін, маған тұрмысқа шықшы!
Dialogue: 0,0:14:46.30,0:14:48.80,Default,,0,0,0,,Мен айта алу үшін бар күшімді салғым келеді...
Dialogue: 0,0:14:48.80,0:14:50.97,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:14:50.97,0:14:54.64,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:50.97,0:14:54.64,Default,,0,0,0,,Бұл менің жолым!
Dialogue: 0,0:14:54.64,0:14:56.91,Default,,0,0,0,,Бұл өте жақсы баяндама болды.
Dialogue: 0,0:14:56.91,0:15:00.58,Default,,0,0,0,,Екеуміздің арамыз қысқарып барады.
Dialogue: 0,0:14:56.91,0:15:00.58,Default,,0,0,0,,Әңгімені айту деген нені білдіреді?
Dialogue: 0,0:15:00.58,0:15:03.42,Default,,0,0,0,,♬~
Dialogue: 0,0:15:03.42,0:15:08.59,Default,,0,0,0,,Енді, барлығыңыз, сізде алкоголь бар ма?
Dialogue: 0,0:15:03.42,0:15:08.59,Default,,0,0,0,,Осы уақытқа дейін көп су құйсам да...
Dialogue: 0,0:15:08.59,0:15:12.76,Default,,0,0,0,,Қарашы, Китахара
Dialogue: 0,0:15:08.59,0:15:12.76,Default,,0,0,0,,Отори үшін дұрыс этикет бар.
Dialogue: 0,0:15:12.76,0:15:16.60,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:15:12.76,0:15:16.60,Default,,0,0,0,,Егер сіз маған мынаны көрсетсеңіз...
Dialogue: 0,0:15:16.60,0:15:19.93,Default,,0,0,0,,Өзіңізді бұл ішу жолынан босатыңыз!
Dialogue: 0,0:15:19.93,0:15:22.93,Default,,0,0,0,,Сенпай, қарашы.
Dialogue: 0,0:15:19.93,0:15:22.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:39.29,0:15:41.62,Default,,0,0,0,,Төзе бер, шыдай бер!
Dialogue: 0,0:15:39.29,0:15:41.62,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:15:41.62,0:15:44.79,Default,,0,0,0,,Кемінде 12 рет
Dialogue: 0,0:15:41.62,0:15:44.79,Default,,0,0,0,,Маған тост керек!
Dialogue: 0,0:15:44.79,0:15:48.80,Default,,0,0,0,,Егер бұлай болса, менде ішімдік жетпей қалады!
Dialogue: 0,0:15:44.79,0:15:48.80,Default,,0,0,0,,Мен осында барлығын қосуым керек пе?
Dialogue: 0,0:15:48.80,0:15:51.80,Default,,0,0,0,,Мен бұлай болады деп күткен жоқпын!
Dialogue: 0,0:15:51.80,0:15:54.47,Default,,0,0,0,,Жақсы, жақсы!
Dialogue: 0,0:15:51.80,0:15:54.47,Default,,0,0,0,,Мен күшті алкогольді ішуге үйреніп қалдым!
Dialogue: 0,0:15:54.47,0:15:57.74,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:15:54.47,0:15:57.74,Default,,0,0,0,,Қазір ең маңыздысы...
Dialogue: 0,0:15:57.74,0:16:01.24,Default,,0,0,0,,Ішімдік ішсем де, мас болмаймын.
Dialogue: 0,0:15:57.74,0:16:01.24,Default,,0,0,0,,Күшті ақыл-ой күші!
Dialogue: 0,0:16:01.24,0:16:04.08,Default,,0,0,0,,Ууу-хуу!
Dialogue: 0,0:16:01.24,0:16:04.08,Default,,0,0,0,,Керемет! Сіз жігіттер!
Dialogue: 0,0:16:04.08,0:16:06.41,Default,,0,0,0,,Біздің кішіміз күткендей!
Dialogue: 0,0:16:06.41,0:16:10.08,Default,,0,0,0,,Бұл көрініс кенет таныс болды...
Dialogue: 0,0:16:06.41,0:16:10.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:10.08,0:16:13.25,Default,,0,0,0,,Барлығы көңілді жүрген сияқты
Dialogue: 0,0:16:10.08,0:16:13.25,Default,,0,0,0,,Ол тынышталды.
Dialogue: 0,0:16:13.25,0:16:15.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:13.25,0:16:15.42,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:15.42,0:16:18.09,Default,,0,0,0,,Ішімдігім таусылды.
Dialogue: 0,0:16:15.42,0:16:18.09,Default,,0,0,0,,Қазірдің өзінде?!
Dialogue: 0,0:16:18.09,0:16:21.76,Default,,0,0,0,,Жарайды, солай ішсең.
Dialogue: 0,0:16:21.76,0:16:24.60,Default,,0,0,0,,Онда мен оны саған сатып аламын.
Dialogue: 0,0:16:24.60,0:16:27.77,Default,,0,0,0,,Күрсін... Жарайды.
Dialogue: 0,0:16:24.60,0:16:27.77,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:16:27.77,0:16:31.11,Default,,0,0,0,,Қалғандары ішіп отырды.
Dialogue: 0,0:16:31.11,0:16:38.11,Default,,0,0,0,,Жалғыз қиын, сондықтан маған көмектесіңізші.
Dialogue: 0,0:16:31.11,0:16:38.11,Default,,0,0,0,,Иә? Аа, дұрыс
Dialogue: 0,0:16:38.11,0:16:40.78,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:16:38.11,0:16:40.78,Default,,0,0,0,,Сіз не ойлап отырсыз!?
Dialogue: 0,0:16:40.78,0:16:44.28,Default,,0,0,0,,Не? Ой жаман жаман
Dialogue: 0,0:16:40.78,0:16:44.28,Default,,0,0,0,,Кездейсоқ
Dialogue: 0,0:16:47.12,0:16:51.42,Default,,0,0,0,,Бармайсың ба?
Dialogue: 0,0:16:47.12,0:16:51.42,Default,,0,0,0,,Бұл қауіпсіздік белдігін тағу керек дегенді білдірмейді!
Dialogue: 0,0:16:57.06,0:17:01.24,Default,,0,0,0,,《Алғаш рет келу
Dialogue: 0,0:16:57.06,0:17:01.24,Default,,0,0,0,,Оңтүстік аралда өткен түн...
Dialogue: 0,0:17:01.24,0:17:05.41,Default,,0,0,0,,Биік аспан мен кең теңіз ең жақсы еркіндік сезімін береді
Dialogue: 0,0:17:05.41,0:17:08.41,Default,,0,0,0,,Мүмкін сондықтан...
Dialogue: 0,0:17:08.41,0:17:12.31,Default,,0,0,0,,Мына ақымақ
Dialogue: 0,0:17:08.41,0:17:12.31,Default,,0,0,0,,Мен далаға жалаңаш шықтым...》
Dialogue: 0,0:17:15.42,0:17:19.42,Default,,0,0,0,,Мен бұған сене алар емеспін!
Dialogue: 0,0:17:15.42,0:17:19.42,Default,,0,0,0,,Мен жай ғана абайсызда болдым.
Dialogue: 0,0:17:19.42,0:17:22.26,Default,,0,0,0,,Бұлай ашуланба~
Dialogue: 0,0:17:19.42,0:17:22.26,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:22.26,0:17:25.59,Default,,0,0,0,,Мынау киінген жігіт
Dialogue: 0,0:17:22.26,0:17:25.59,Default,,0,0,0,,Мен көліктен түстім!
Dialogue: 0,0:17:25.59,0:17:29.76,Default,,0,0,0,,Өте жылы болды...
Dialogue: 0,0:17:25.59,0:17:29.76,Default,,0,0,0,,Хмм... Бұл мағынасы бар.
Dialogue: 0,0:17:29.76,0:17:32.60,Default,,0,0,0,,Курорттық аймақтар үшін бірегей
Dialogue: 0,0:17:29.76,0:17:32.60,Default,,0,0,0,,Ашық болу сезімі дегеніміз не?
Dialogue: 0,0:17:32.60,0:17:34.60,Default,,0,0,0,,Бұл жиі болады!
Dialogue: 0,0:17:34.60,0:17:37.44,Default,,0,0,0,,Неліктен олардың барлығы Иоримен келіседі!?
Dialogue: 0,0:17:37.44,0:17:41.28,Default,,0,0,0,,Бірақ, Кебако, жақсылап ойлан.
Dialogue: 0,0:17:37.44,0:17:41.28,Default,,0,0,0,,Не!
Dialogue: 0,0:17:41.28,0:17:45.61,Default,,0,0,0,,Оңтүстік арал, жұлдызға толы аспан
Dialogue: 0,0:17:41.28,0:17:45.61,Default,,0,0,0,,Ер адаммен көлік жүргізу!
Dialogue: 0,0:17:45.61,0:17:48.45,Default,,0,0,0,,Міне
Dialogue: 0,0:17:45.61,0:17:48.45,Default,,0,0,0,,Жастық деген осы емес пе?
Dialogue: 0,0:17:48.45,0:17:51.62,Default,,0,0,0,,Екінші тарап
Dialogue: 0,0:17:48.45,0:17:51.62,Default,,0,0,0,,Жартылай жалаңаш бұзық болмасаң!
Dialogue: 0,0:17:51.62,0:17:55.12,Default,,0,0,0,,Түсіндім... Кешіріңіз.
Dialogue: 0,0:17:51.62,0:17:55.12,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:17:55.12,0:17:57.89,Default,,0,0,0,,Бірақ мен қанша болса да
Dialogue: 0,0:17:55.12,0:17:57.89,Default,,0,0,0,,Жалаңаштық дегеніміз...
Dialogue: 0,0:17:57.89,0:18:00.56,Default,,0,0,0,,Оны шешудің жолдары жеткіліксіз.
Dialogue: 0,0:17:57.89,0:18:00.56,Default,,0,0,0,,Өйткені оның мағынасы жоқ!
Dialogue: 0,0:18:00.56,0:18:03.90,Default,,0,0,0,,Ең алдымен,
Dialogue: 0,0:18:00.56,0:18:03.90,Default,,0,0,0,,Ішкенде киіміңді шешудің қажеті жоқ!
Dialogue: 0,0:18:03.90,0:18:07.57,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:03.90,0:18:07.57,Default,,0,0,0,,Түсінбегендей кейіп танытпа!
Dialogue: 0,0:18:07.57,0:18:10.57,Default,,0,0,0,,Жақсы, жақсы
Dialogue: 0,0:18:07.57,0:18:10.57,Default,,0,0,0,,Тек мынаны ішіп, тынышталыңыз.
Dialogue: 0,0:18:10.57,0:18:14.57,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:18:10.57,0:18:14.57,Default,,0,0,0,,Ах! Бұл менікі...
Dialogue: 0,0:18:19.58,0:18:23.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:19.58,0:18:23.08,Default,,0,0,0,,Онда не болды?
Dialogue: 0,0:18:23.08,0:18:25.25,Default,,0,0,0,,Бұл бұрынғы Отори қалдықтары.
Dialogue: 0,0:18:25.25,0:18:28.26,Default,,0,0,0,,Тек жағдайда
Dialogue: 0,0:18:25.25,0:18:28.26,Default,,0,0,0,,Мен оны екі рет сұйылттым...
Dialogue: 0,0:18:28.26,0:18:31.43,Default,,0,0,0,,Сонда да 30 градустан жоғары...
Dialogue: 0,0:18:31.43,0:18:35.43,Default,,0,0,0,,Бірақ бұл...
Dialogue: 0,0:18:31.43,0:18:35.43,Default,,0,0,0,,Мүмкін сіз тыныш болуыңыз керек шығар.
Dialogue: 0,0:18:35.43,0:18:38.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:35.43,0:18:38.27,Default,,0,0,0,,Не?
Dialogue: 0,0:18:35.43,0:18:38.27,Default,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,0:18:38.27,0:18:40.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:40.93,0:18:43.77,Default,,0,0,0,,Сәлем Иори
Dialogue: 0,0:18:40.93,0:18:43.77,Default,,0,0,0,,Һм? Не болды?
Dialogue: 0,0:18:43.77,0:18:47.94,Default,,0,0,0,,Иори баяу, солай емес пе?
Dialogue: 0,0:18:43.77,0:18:47.94,Default,,0,0,0,,Не?Кенеттен
Dialogue: 0,0:18:47.94,0:18:50.94,Default,,0,0,0,,Менде не сонша баяу?
Dialogue: 0,0:18:47.94,0:18:50.94,Default,,0,0,0,,Бұл күңгірт~
Dialogue: 0,0:18:50.94,0:18:54.95,Default,,0,0,0,,Менің өтінішім бойынша
Dialogue: 0,0:18:50.94,0:18:54.95,Default,,0,0,0,,Олар мені мүлдем байқамайды.
Dialogue: 0,0:18:54.95,0:18:58.05,Default,,0,0,0,,Иә!? Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:58.05,0:19:03.56,Default,,0,0,0,,Мен ойладым. Өйткені Иори түтіккен.
Dialogue: 0,0:18:58.05,0:19:03.56,Default,,0,0,0,,Айтсам да, айта алмаймын
Dialogue: 0,0:19:03.56,0:19:06.73,Default,,0,0,0,,Оны көрсетудің бірден-бір жолы - әрекет...
Dialogue: 0,0:19:06.73,0:19:10.40,Default,,0,0,0,,Кебако…
Dialogue: 0,0:19:06.73,0:19:10.40,Default,,0,0,0,,Әйтеуір... бұдан арғы ақиқат соңы бар ма?
Dialogue: 0,0:19:10.40,0:19:12.57,Default,,0,0,0,,Мен енді шыдай алмаймын!
Dialogue: 0,0:19:12.57,0:19:16.40,Default,,0,0,0,,Қанша айтсаң да өтпейді
Dialogue: 0,0:19:12.57,0:19:16.40,Default,,0,0,0,,Жақсырақ...
Dialogue: 0,0:19:16.40,0:19:19.57,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,0:19:16.40,0:19:19.57,Default,,0,0,0,,Киіміңді шеш!
Dialogue: 0,0:19:19.57,0:19:21.58,Default,,0,0,0,,А-а... Сіз де солай ма?
Dialogue: 0,0:19:21.58,0:19:26.58,Default,,0,0,0,,Жоқ... Бұлай айтқанда...
Dialogue: 0,0:19:21.58,0:19:26.58,Default,,0,0,0,,Хохо Солай ма?
Dialogue: 0,0:19:26.58,0:19:28.58,Default,,0,0,0,,Сонда біз...
Dialogue: 0,0:19:28.58,0:19:32.59,Default,,0,0,0,,Мен оны шешемін!
Dialogue: 0,0:19:28.58,0:19:32.59,Default,,0,0,0,,Күте тұрыңыз! Тыныштал!
Dialogue: 0,0:19:32.59,0:19:35.42,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:19:32.59,0:19:35.42,Default,,0,0,0,,Келесі - Кохэй! Сау бол!
Dialogue: 0,0:19:35.42,0:19:37.42,Default,,0,0,0,,Олар қосымша күш әкелді.
Dialogue: 0,0:19:40.59,0:19:43.10,Default,,0,0,0,,Бұл ақылсыз болды...
Dialogue: 0,0:19:40.59,0:19:43.10,Default,,0,0,0,,Бір ғана сусын➡︎
Dialogue: 0,0:19:43.10,0:19:45.43,Default,,0,0,0,,Мен бұлай өзгереді деп күтпедім...
Dialogue: 0,0:19:45.43,0:19:48.44,Default,,0,0,0,,Біріншіден, сіз
Dialogue: 0,0:19:45.43,0:19:48.44,Default,,0,0,0,,Көліктен жалаңаш түспесең!
Dialogue: 0,0:19:48.44,0:19:51.61,Default,,0,0,0,,Егер сіз дүкенге барсаңыз
Dialogue: 0,0:19:48.44,0:19:51.61,Default,,0,0,0,,Бұл тамаша болар еді!
Dialogue: 0,0:19:51.61,0:19:55.81,Default,,0,0,0,,Гурул... Болды!
Dialogue: 0,0:19:51.61,0:19:55.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:59.28,0:20:01.78,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:20:01.78,0:20:04.79,Default,,0,0,0,,Мен... Мен теледидар сигналын ала алмаймын!
Dialogue: 0,0:20:04.79,0:20:06.79,Default,,0,0,0,,Неге бәрібір жазбасқа?
Dialogue: 0,0:20:06.79,0:20:10.96,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:20:06.79,0:20:10.96,Default,,0,0,0,,Сіз нақты уақыттың маңыздылығын білмейсіз бе?
Dialogue: 0,0:20:10.96,0:20:15.80,Default,,0,0,0,,1-A сыныбы 1-B сыныбына қарсы—
Dialogue: 0,0:20:10.96,0:20:15.80,Default,,0,0,0,,Бірақ мен бұл туралы қайта ойласам...
Dialogue: 0,0:20:15.80,0:20:17.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:17.80,0:20:20.97,Default,,0,0,0,,Жоқ, бұл менмін
Dialogue: 0,0:20:17.80,0:20:20.97,Default,,0,0,0,,Мен мұндай шеңберге кіремін деп ешқашан ойламадым.
Dialogue: 0,0:20:20.97,0:20:23.97,Default,,0,0,0,,Сізге
Dialogue: 0,0:20:20.97,0:20:23.97,Default,,0,0,0,,Менің ойымша, бұл сізге жарасады.
Dialogue: 0,0:20:23.97,0:20:27.31,Default,,0,0,0,,Сіз жекпе-жек сатасыз ба? Мінеки!
Dialogue: 0,0:20:23.97,0:20:27.31,Default,,0,0,0,,Біріншіден, мен➡︎
Dialogue: 0,0:20:27.31,0:20:31.98,Default,,0,0,0,,Мен сені алдап кіргіздің!
Dialogue: 0,0:20:27.31,0:20:31.98,Default,,0,0,0,,Алдау сіздің нашар тыңдаушы екеніңізді білдіреді.
Dialogue: 0,0:20:31.98,0:20:35.32,Default,,0,0,0,,Сіз шынымен маған басқаша айтқыңыз келе ме?
Dialogue: 0,0:20:31.98,0:20:35.32,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:35.32,0:20:37.48,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:20:37.48,0:20:40.32,Default,,0,0,0,,Себебі сенің үмітің
Dialogue: 0,0:20:37.48,0:20:40.32,Default,,0,0,0,,Бұл орындалмады ма?
Dialogue: 0,0:20:40.32,0:20:42.49,Default,,0,0,0,,Қайда!
Dialogue: 0,0:20:40.32,0:20:42.49,Default,,0,0,0,,Қараңдар, мен саған айттым ғой, солай ма?
Dialogue: 0,0:20:42.49,0:20:46.66,Default,,0,0,0,,«Университетке келгенде армандай өмір сүресің.
Dialogue: 0,0:20:42.49,0:20:46.66,Default,,0,0,0,,Мен сені күтіп отыр деп ойладым.''
Dialogue: 0,0:20:46.66,0:20:49.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:49.33,0:20:53.00,Default,,0,0,0,,Бұл өмір де
Dialogue: 0,0:20:49.33,0:20:53.00,Default,,0,0,0,,Бір мағынада бұл түс сияқты, солай ма?
Dialogue: 0,0:20:53.00,0:20:55.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:55.94,0:20:59.94,Default,,0,0,0,,Аа... Аа, солай.
Dialogue: 0,0:20:59.94,0:21:03.44,Default,,0,0,0,,Бұл түс болса да, бұл әлі қорқынышты түс.
Dialogue: 0,0:20:59.94,0:21:03.44,Default,,0,0,0,,Бір сәт күтсеңіз, ол жақында келеді деп ойлаймын.
Dialogue: 0,0:21:03.44,0:21:08.84,Default,,0,0,0,,Сәлем! Бұл өлімнің зұлымдығы ма?
Dialogue: 0,0:21:03.44,0:21:08.84,Default,,0,0,0,,Гах!
Dialogue: 0,0:21:18.63,0:21:21.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:18.63,0:21:21.63,Default,,0,0,0,,Чи Чан, не болды? ол
Dialogue: 0,0:21:21.63,0:21:26.13,Default,,0,0,0,,Дүкеннен басып шығару...
Dialogue: 0,0:21:21.63,0:21:26.13,Default,,0,0,0,,өтіңіз ~ Бұл әдемі кадр.
Dialogue: 0,0:21:26.13,0:21:28.93,Default,,0,0,0,,Сурет сапасы жақсы, бірақ...
Dialogue: 0,0:21:35.31,0:21:37.31,Default,,0,0,0,,Жан түршігерлік алшақтық...
Dialogue: 0,0:21:37.31,0:21:39.48,Default,,0,0,0,,Маған екеуі де ұнайды
Dialogue: 0,0:21:39.48,0:21:41.98,Default,,0,0,0,,Міне
Dialogue: 0,0:21:39.48,0:21:41.98,Default,,0,0,0,,Үйдегідей сезінесіз, солай ма?
Dialogue: 0,0:23:50.31,0:23:52.31,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:23:53.81,0:23:59.81,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
