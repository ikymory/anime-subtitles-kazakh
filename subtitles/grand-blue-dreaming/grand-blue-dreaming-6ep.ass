Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.28,0:00:04.95,Default,,0,0,0,,Чиса…
Dialogue: 0,0:00:00.28,0:00:04.95,Default,,0,0,0,,Өтінемін, менің қасымда болшы.
Dialogue: 0,0:00:04.95,0:00:06.96,Default,,0,0,0,,Ұнатпау
Dialogue: 0,0:00:06.96,0:00:09.63,Default,,0,0,0,,Менен бірдеңе істеуді талап етпе
Dialogue: 0,0:00:09.63,0:00:12.13,Default,,0,0,0,,Менің қасымда болу арқылы
Dialogue: 0,0:00:09.63,0:00:12.13,Default,,0,0,0,,Enough is enough
Dialogue: 0,0:00:12.13,0:00:15.83,Default,,0,0,0,,Мен оны мүлдем жек көремін. бас тарт.
Dialogue: 0,0:00:12.13,0:00:15.83,Default,,0,0,0,,А...
Dialogue: 0,0:00:18.13,0:00:20.13,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:22.14,0:00:26.31,Default,,0,0,0,,Answer next door
Dialogue: 0,0:00:22.14,0:00:26.31,Default,,0,0,0,,Just show me!
Dialogue: 0,0:00:26.31,0:00:28.31,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:00:26.31,0:00:28.31,Default,,0,0,0,,Хмф!
Dialogue: 0,0:00:28.31,0:00:30.31,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:00:30.31,0:00:33.65,Default,,0,0,0,,Консервілеу келіссөздері сәтсіздікке ұшырайды
Dialogue: 0,0:00:30.31,0:00:33.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:00:33.65,0:00:36.32,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:00:33.65,0:00:36.32,Default,,0,0,0,,It's impossible if things continue like this.
Dialogue: 0,0:00:36.32,0:00:38.99,Default,,0,0,0,,Неміс тіліндегі төмендеткіш бірлік
Dialogue: 0,0:00:36.32,0:00:38.99,Default,,0,0,0,,Бұл ауырады
Dialogue: 0,0:00:38.99,0:00:41.66,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:00:38.99,0:00:41.66,Default,,0,0,0,,Өз бетімізше бірдеңе жасайық
Dialogue: 0,0:00:41.66,0:00:44.49,Default,,0,0,0,,Сіз шынымен қазір оқуға барасыз ба?
Dialogue: 0,0:00:44.49,0:00:46.50,Default,,0,0,0,,Емтиханға көп уақыт қалды.
Dialogue: 0,0:00:46.50,0:00:49.83,Default,,0,0,0,,Challenging the limits of reduced copying of notes
Dialogue: 0,0:00:49.83,0:00:51.83,Default,,0,0,0,,Өз бетімен консервілеу?
Dialogue: 0,0:00:53.84,0:00:55.77,Default,,0,0,0,,This is the maximum size that you can read.
Dialogue: 0,0:00:55.77,0:00:57.77,Default,,0,0,0,,Ол әлдеқайда кішірейгенімен...
Dialogue: 0,0:00:57.77,0:01:00.11,Default,,0,0,0,,Оны қайда жасырамын деп ойлануым керек.
Dialogue: 0,0:01:00.11,0:01:02.78,Default,,0,0,0,,Китахара! Кунилингус?
Dialogue: 0,0:01:02.78,0:01:04.78,Default,,0,0,0,,Мені де араластырыңыз.
Dialogue: 0,0:01:02.78,0:01:04.78,Default,,0,0,0,,Мен де Мен де
Dialogue: 0,0:01:04.78,0:01:08.12,Default,,0,0,0,,Неліктен менің айналамда адамдар бар?
Dialogue: 0,0:01:04.78,0:01:08.12,Default,,0,0,0,,Are all these kinds of crap gathered here?
Dialogue: 0,0:01:08.12,0:01:10.12,Default,,0,0,0,,Туысқан рух, солай ма?
Dialogue: 0,0:01:10.12,0:01:12.12,Default,,0,0,0,,Сонымен
Dialogue: 0,0:01:10.12,0:01:12.12,Default,,0,0,0,,Мұны қалай енгізуге болады?
Dialogue: 0,0:01:12.12,0:01:16.63,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:01:12.12,0:01:16.63,Default,,0,0,0,,Мысалы, қарындаш қораптың ішінде!
Dialogue: 0,0:01:16.63,0:01:19.30,Default,,0,0,0,,Сусынның жапсырмасы
Dialogue: 0,0:01:19.30,0:01:21.63,Default,,0,0,0,,Сүлгінің іші
Dialogue: 0,0:01:21.63,0:01:24.13,Default,,0,0,0,,Хмм, Нодзима не істеу керек?
Dialogue: 0,0:01:24.13,0:01:28.64,Default,,0,0,0,,Мен жалғыз барамын
Dialogue: 0,0:01:24.13,0:01:28.64,Default,,0,0,0,,Бір түн... Бір түндік қарым-қатынас?
Dialogue: 0,0:01:28.64,0:01:31.31,Default,,0,0,0,,Жоқ, ол менің қолымда!
Dialogue: 0,0:01:31.31,0:01:33.31,Default,,0,0,0,,Китахара не істейді?
Dialogue: 0,0:01:33.31,0:01:35.31,Default,,0,0,0,,Менің ойымша, бұл желдеткіштің артқы жағы.
Dialogue: 0,0:01:35.31,0:01:37.31,Default,,0,0,0,,Олай болса, оны киімге салуым керек пе?
Dialogue: 0,0:01:37.31,0:01:40.32,Default,,0,0,0,,Балалар, неміс тіліндегі бірлік
Dialogue: 0,0:01:37.31,0:01:40.32,Default,,0,0,0,,Сіз ненің маңызды екенін білесіз бе?
Dialogue: 0,0:01:40.32,0:01:42.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:40.32,0:01:42.32,Default,,0,0,0,,Әрине!
Dialogue: 0,0:01:42.32,0:01:46.16,Default,,0,0,0,,Ешқашан соңына дейін берілме
Dialogue: 0,0:01:42.32,0:01:46.16,Default,,0,0,0,,Барлығымыз несие алайық!
Dialogue: 0,0:01:46.16,0:01:48.16,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:01:50.49,0:01:54.83,Default,,0,0,0,,Иә, онда...
Dialogue: 0,0:01:50.49,0:01:54.83,Default,,0,0,0,,Алдымен қарындаш қорапшаңызды қойыңыз.
Dialogue: 0,0:01:54.83,0:01:56.93,Default,,0,0,0,,Иә!?
Dialogue: 0,0:01:54.83,0:01:56.93,Default,,0,0,0,,бірақ полиция оларға қатыгездік көрсете ме?
Dialogue: 0,0:01:56.93,0:01:59.60,Default,,0,0,0,,Бұл ақымақтық. Сіз оны күтуіңіз керек еді.
Dialogue: 0,0:01:59.60,0:02:02.44,Default,,0,0,0,,《Эй, маған көмектес! 》
Dialogue: 0,0:01:59.60,0:02:02.44,Default,,0,0,0,,《Мм, не істеуім керек? 》
Dialogue: 0,0:02:02.44,0:02:06.11,Default,,0,0,0,,≪Сонымен қатар ішіп-жеуге тыйым салынады.
Dialogue: 0,0:02:06.11,0:02:08.11,Default,,0,0,0,,《Маған олай қарама》
Dialogue: 0,0:02:08.11,0:02:10.11,Default,,0,0,0,,《Бұл туралы бірдеңе жасаңыз》
Dialogue: 0,0:02:10.11,0:02:15.62,Default,,0,0,0,,《Бірақ басқалары неге істеді
Dialogue: 0,0:02:10.11,0:02:15.62,Default,,0,0,0,,Сіз салқын жүзді сақтай аласыз ба? 》
Dialogue: 0,0:02:15.62,0:02:18.29,Default,,0,0,0,,《Өзіңізге сенімді екеніңізге сенімдісіз бе? 》
Dialogue: 0,0:02:18.29,0:02:20.29,Default,,0,0,0,,Сағат 1-де басталады
Dialogue: 0,0:02:20.29,0:02:24.96,Default,,0,0,0,,Жұмысты аяқтағаннан кейін кете аласыз.
Dialogue: 0,0:02:20.29,0:02:24.96,Default,,0,0,0,,бастайық
Dialogue: 0,0:02:24.96,0:02:26.96,Default,,0,0,0,,Шығу
Dialogue: 0,0:02:26.96,0:02:30.47,Default,,0,0,0,,《Шынықты күлкі болды ма》
Dialogue: 0,0:02:26.96,0:02:30.47,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:30.47,0:02:33.30,Default,,0,0,0,,《түйген тер
Dialogue: 0,0:02:30.47,0:02:33.30,Default,,0,0,0,,Мен мәтінді оқи алмаймын! 》
Dialogue: 0,0:02:33.30,0:02:35.30,Default,,0,0,0,,《Бақаға》
Dialogue: 0,0:02:35.30,0:02:38.64,Default,,0,0,0,,《Мм...
Dialogue: 0,0:02:35.30,0:02:38.64,Default,,0,0,0,,Өйткені мен бұл ыстықта қолыма сүйенемін》
Dialogue: 0,0:02:38.64,0:02:40.64,Default,,0,0,0,,《Енді ойлап қарасам, Шимокава бұл жерде жоқ.》
Dialogue: 0,0:02:40.64,0:02:42.98,Default,,0,0,0,,《Аа, ол жігіт жай ғана...》
Dialogue: 0,0:02:42.98,0:02:44.98,Default,,0,0,0,,📱
Dialogue: 0,0:02:47.65,0:02:49.65,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:02:51.65,0:02:54.16,Default,,0,0,0,,«Дәл қазір» Не?
Dialogue: 0,0:02:51.65,0:02:54.16,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:02:54.16,0:02:56.59,Default,,0,0,0,,Тағы бір адам ғана қайтыс болды.
Dialogue: 0,0:02:56.59,0:03:00.76,Default,,0,0,0,,《Бірақ кенепке қарасаңыз да
Dialogue: 0,0:02:56.59,0:03:00.76,Default,,0,0,0,,Әрең шешілді! 》
Dialogue: 0,0:03:00.76,0:03:04.10,Default,,0,0,0,,《Бұл барлығына арналған
Dialogue: 0,0:03:00.76,0:03:04.10,Default,,0,0,0,,Біз ынтымақтасуымыз керек》
Dialogue: 0,0:03:04.10,0:03:06.90,Default,,0,0,0,,《Бұл командалық ойын》
Dialogue: 0,0:03:04.10,0:03:06.90,Default,,0,0,0,,《Маған қалдыр! 》
Dialogue: 0,0:03:13.44,0:03:16.28,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:16.28,0:03:20.38,Default,,0,0,0,,Ах... Барлығымыз ынтымақтаса аламыз ба!?
Dialogue: 0,0:03:22.95,0:03:25.79,Default,,0,0,0,,Барлығы нашар жұмыс істейді.
Dialogue: 0,0:03:25.79,0:03:28.29,Default,,0,0,0,,Есеп тым қиын.
Dialogue: 0,0:03:28.29,0:03:30.96,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:03:30.96,0:03:33.63,Default,,0,0,0,,Қызметтік сұрақ қойыңыз
Dialogue: 0,0:03:30.96,0:03:33.63,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:03:33.63,0:03:36.47,Default,,0,0,0,,Дәріс барысында баяндамадан сұрақтар қойылады.
Dialogue: 0,0:03:36.47,0:03:40.64,Default,,0,0,0,,Мен айтқалы тұрған сөздерді неміс тіліне аударыңыз.
Dialogue: 0,0:03:36.47,0:03:40.64,Default,,0,0,0,,Артқы жағына жаз
Dialogue: 0,0:03:40.64,0:03:44.14,Default,,0,0,0,,1 сұрақ: «Жүрек ревматизмі»
Dialogue: 0,0:03:44.14,0:03:46.14,Default,,0,0,0,,《Сіз түсінесіз бе!? Мүмкін емес! 》
Dialogue: 0,0:03:46.14,0:03:48.14,Default,,0,0,0,,《Қызмет көрсетудің мәні
Dialogue: 0,0:03:46.14,0:03:48.14,Default,,0,0,0,,Маған біреу айтсын! 》
Dialogue: 0,0:03:48.14,0:03:52.82,Default,,0,0,0,,2-сұрақ: «Банан ұстаған жалаңаш адам»
Dialogue: 0,0:03:52.82,0:03:54.98,Default,,0,0,0,,《Ямамото: Дәріс барысында
Dialogue: 0,0:03:52.82,0:03:54.98,Default,,0,0,0,,Сіз не туралы айттыңыз!?》
Dialogue: 0,0:03:54.98,0:03:57.59,Default,,0,0,0,,《Фудзивара: Шынымен
Dialogue: 0,0:03:54.98,0:03:57.59,Default,,0,0,0,,Бұл неміс лекциясы ма!?
Dialogue: 0,0:03:57.59,0:03:59.59,Default,,0,0,0,,Соңғы сұрақ
Dialogue: 0,0:04:01.76,0:04:03.76,Default,,0,0,0,,«Джеймс Томас»
Dialogue: 0,0:04:03.76,0:04:06.43,Default,,0,0,0,,Бұл адамның аты!
Dialogue: 0,0:04:03.76,0:04:06.43,Default,,0,0,0,,Бұл ағылшынша екені анық!?
Dialogue: 0,0:04:06.43,0:04:08.43,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:04:11.27,0:04:13.27,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:04:13.27,0:04:16.61,Default,,0,0,0,,Анықталмаған?
Dialogue: 0,0:04:13.27,0:04:16.61,Default,,0,0,0,,Мен оның орнын толтыруым керек...
Dialogue: 0,0:04:16.61,0:04:20.28,Default,,0,0,0,,Ал, бәріңе.
Dialogue: 0,0:04:16.61,0:04:20.28,Default,,0,0,0,,Өте нашар орындалды.
Dialogue: 0,0:04:20.28,0:04:25.45,Default,,0,0,0,,Сонымен, егер 10 ұпай немесе одан көп болса, бұл дұрыс.
Dialogue: 0,0:04:20.28,0:04:25.45,Default,,0,0,0,,Егер балл 20 немесе одан жоғары болса, ол «жақсы» болып саналады.
Dialogue: 0,0:04:25.45,0:04:28.62,Default,,0,0,0,,Шынымен!?
Dialogue: 0,0:04:25.45,0:04:28.62,Default,,0,0,0,,Иә! Мен бара аламын деп ешқашан ойламадым!
Dialogue: 0,0:04:28.62,0:04:32.92,Default,,0,0,0,,Дұрыс! Рақмет сізге!
Dialogue: 0,0:04:28.62,0:04:32.92,Default,,0,0,0,,О, мүлде! иә?
Dialogue: 0,0:04:34.96,0:04:36.96,Default,,0,0,0,,«Қайталау»?
Dialogue: 0,0:04:36.96,0:04:39.96,Default,,0,0,0,,Қат!
Dialogue: 0,0:04:39.96,0:04:42.36,Default,,0,0,0,,Ол тағы да ақымақтық жасап жатыр.
Dialogue: 0,0:06:14.26,0:06:16.26,Default,,0,0,0,,Сонымен күн қалай болды?
Dialogue: 0,0:06:16.26,0:06:19.93,Default,,0,0,0,,Бұл өте көп болды.
Dialogue: 0,0:06:16.26,0:06:19.93,Default,,0,0,0,,Мына фотоға қараңыз
Dialogue: 0,0:06:19.93,0:06:21.93,Default,,0,0,0,,Мына балалар костюмдер киіп алған.
Dialogue: 0,0:06:21.93,0:06:23.93,Default,,0,0,0,,рух
Dialogue: 0,0:06:21.93,0:06:23.93,Default,,0,0,0,,Себебі мен сізге кіруге рұқсат бердім➡︎
Dialogue: 0,0:06:23.93,0:06:27.44,Default,,0,0,0,,Шүкіршілік ет
Dialogue: 0,0:06:23.93,0:06:27.44,Default,,0,0,0,,Балалар, сендер көңілдеріңді қалдырмайсыңдар.
Dialogue: 0,0:06:27.44,0:06:30.61,Default,,0,0,0,,Айтпақшы, сіз
Dialogue: 0,0:06:27.44,0:06:30.61,Default,,0,0,0,,Сіз ішке кіремін дедіңіз...
Dialogue: 0,0:06:30.61,0:06:32.61,Default,,0,0,0,,Оның қандай шеңбер екенін білесің бе?
Dialogue: 0,0:06:32.61,0:06:36.11,Default,,0,0,0,,Дайвинг, солай ма?
Dialogue: 0,0:06:32.61,0:06:36.11,Default,,0,0,0,,Мен саған тәнті болдым, солай емес пе?
Dialogue: 0,0:06:36.11,0:06:38.28,Default,,0,0,0,,Бұл ересектердің хоббиі сияқты.
Dialogue: 0,0:06:38.28,0:06:41.95,Default,,0,0,0,,Теңізде және түрлі-түсті балықтарда
Dialogue: 0,0:06:38.28,0:06:41.95,Default,,0,0,0,,Мені қызықтырады
Dialogue: 0,0:06:41.95,0:06:43.95,Default,,0,0,0,,Таудан түскеннен кейін, қолым түсіп кететіндей болғанша қылыш шабуды жаттықтырамын
Dialogue: 0,0:06:43.95,0:06:47.12,Default,,0,0,0,,Оңтүстік аралдың әдемі теңізінде
Dialogue: 0,0:06:43.95,0:06:47.12,Default,,0,0,0,,Университет достарымен суға түсу
Dialogue: 0,0:06:47.12,0:06:49.12,Default,,0,0,0,,Бұл жай ғана драма сияқты емес пе?
Dialogue: 0,0:06:49.12,0:06:51.63,Default,,0,0,0,,Егер
Dialogue: 0,0:06:49.12,0:06:51.63,Default,,0,0,0,,Бұл шеңберді пайдалануды тоқтатыңыз.
Dialogue: 0,0:06:51.63,0:06:53.96,Default,,0,0,0,,осында
Dialogue: 0,0:06:51.63,0:06:53.96,Default,,0,0,0,,Бұл сүңгуір шеңбері емес пе?
Dialogue: 0,0:06:53.96,0:06:56.06,Default,,0,0,0,,Хахаха Бұл әзіл Бұл әзіл
Dialogue: 0,0:06:56.06,0:06:58.07,Default,,0,0,0,,Сіз сондай-ақ дайвинг жасай аласыз
Dialogue: 0,0:06:56.06,0:06:58.07,Default,,0,0,0,,Ешқандай➡︎ жоқ дегенді білдірмейді
Dialogue: 0,0:06:58.07,0:07:01.07,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:06:58.07,0:07:01.07,Default,,0,0,0,,Сәлем! жаңадан келген!
Dialogue: 0,0:07:01.07,0:07:03.41,Default,,0,0,0,,Сәлемдесу кеші Бастайық!
Dialogue: 0,0:07:01.07,0:07:03.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:03.41,0:07:05.41,Default,,0,0,0,,Енді өзімді таныстырып өтейін.
Dialogue: 0,0:07:07.41,0:07:10.91,Default,,0,0,0,,Менің атым Айна Йошивара, мен Aomi Girls университетінің бірінші курс студентімін.
Dialogue: 0,0:07:10.91,0:07:12.92,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:07:12.92,0:07:16.75,Default,,0,0,0,,Мен сүңгуірге қызығатынмын.
Dialogue: 0,0:07:12.92,0:07:16.75,Default,,0,0,0,,Мен мұны ешқашан жасаған емеспін.
Dialogue: 0,0:07:16.75,0:07:18.75,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:07:18.75,0:07:20.85,Default,,0,0,0,,Сонымен
Dialogue: 0,0:07:18.75,0:07:20.85,Default,,0,0,0,,Мен енді көп нәрсені үйренемін...
Dialogue: 0,0:07:22.93,0:07:24.93,Default,,0,0,0,,Бұл шеңбер біртүрлі емес пе?
Dialogue: 0,0:07:24.93,0:07:26.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:24.93,0:07:26.93,Default,,0,0,0,,Сен оны қашан шештің!?
Dialogue: 0,0:07:26.93,0:07:28.93,Default,,0,0,0,,Тіпті таң қалсаңыз да...
Dialogue: 0,0:07:28.93,0:07:31.43,Default,,0,0,0,,Иззу көктем фестивалінде ішкен кезде
Dialogue: 0,0:07:28.93,0:07:31.43,Default,,0,0,0,,Сіз оны көп көрдіңіз, солай емес пе?
Dialogue: 0,0:07:31.43,0:07:34.77,Default,,0,0,0,,Бұл мектеп фестивалінде болды.
Dialogue: 0,0:07:31.43,0:07:34.77,Default,,0,0,0,,Мен оны сілкіп тастағаным үшін емес.
Dialogue: 0,0:07:34.77,0:07:37.61,Default,,0,0,0,,Не болды? Айна
Dialogue: 0,0:07:34.77,0:07:37.61,Default,,0,0,0,,Не болса да...
Dialogue: 0,0:07:37.61,0:07:40.78,Default,,0,0,0,,​​О?
Dialogue: 0,0:07:37.61,0:07:40.78,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:07:40.78,0:07:43.95,Default,,0,0,0,,《Де... Бірақ тек Котегава мырза
Dialogue: 0,0:07:40.78,0:07:43.95,Default,,0,0,0,,Қарапайым адам болуы керек》
Dialogue: 0,0:07:43.95,0:07:47.28,Default,,0,0,0,,Өтінемін! Котегава!
Dialogue: 0,0:07:43.95,0:07:47.28,Default,,0,0,0,,Тойға бара жатқан сенсің ғой...
Dialogue: 0,0:07:47.28,0:07:50.62,Default,,0,0,0,,Жоқ, Чиза.
Dialogue: 0,0:07:47.28,0:07:50.62,Default,,0,0,0,,Мен жоғарыда отыр деп тұрған жоқпын.
Dialogue: 0,0:07:50.62,0:07:53.96,Default,,0,0,0,,Мен оны басуым керек пе еді?
Dialogue: 0,0:07:50.62,0:07:53.96,Default,,0,0,0,,《Олай емес...》
Dialogue: 0,0:07:53.96,0:07:56.06,Default,,0,0,0,,Екеуің не істеп жатырсыңдар?
Dialogue: 0,0:07:56.06,0:07:58.06,Default,,0,0,0,,Бөлек
Dialogue: 0,0:07:56.06,0:07:58.06,Default,,0,0,0,,Нанака-сан...
Dialogue: 0,0:07:58.06,0:08:00.86,Default,,0,0,0,,Қарашы, Чиса-чан
Dialogue: 0,0:07:58.06,0:08:00.86,Default,,0,0,0,,Иори-куннан түсіңіз.
Dialogue: 0,0:08:02.90,0:08:05.40,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:02.90,0:08:05.40,Default,,0,0,0,,Ол жерде қарапайым адам болған!
Dialogue: 0,0:08:05.40,0:08:07.40,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:08:07.40,0:08:09.40,Default,,0,0,0,,Нанака-сан, сен де кесе алғың келе ме?
Dialogue: 0,0:08:09.40,0:08:11.40,Default,,0,0,0,,Рахмет, онда...
Dialogue: 0,0:08:13.41,0:08:15.41,Default,,0,0,0,,Мен мұны аламын.
Dialogue: 0,0:08:15.41,0:08:18.75,Default,,0,0,0,,Иә? Міне бітті.
Dialogue: 0,0:08:15.41,0:08:18.75,Default,,0,0,0,,Котегава мырзаның жартылай ішуі…
Dialogue: 0,0:08:18.75,0:08:21.58,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:18.75,0:08:21.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:21.58,0:08:23.59,Default,,0,0,0,,Ухуху…
Dialogue: 0,0:08:23.59,0:08:25.59,Default,,0,0,0,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:08:23.59,0:08:25.59,Default,,0,0,0,,Ештеңе сұрама
Dialogue: 0,0:08:25.59,0:08:28.59,Default,,0,0,0,,Сіз ештеңе көрген жоқсыз. Жақсы?
Dialogue: 0,0:08:28.59,0:08:30.93,Default,,0,0,0,,Сәлем, балалар!
Dialogue: 0,0:08:30.93,0:08:34.10,Default,,0,0,0,,Дұрыс тост жасамасаңыз
Dialogue: 0,0:08:30.93,0:08:34.10,Default,,0,0,0,,Жақсы емес!
Dialogue: 0,0:08:34.10,0:08:36.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:34.10,0:08:36.43,Default,,0,0,0,,О, күте тұрыңыз ...
Dialogue: 0,0:08:36.43,0:08:39.43,Default,,0,0,0,,Бұл Йошивара мырза
Dialogue: 0,0:08:36.43,0:08:39.43,Default,,0,0,0,,Иә
Dialogue: 0,0:08:39.43,0:08:41.44,Default,,0,0,0,,Сіз дайвингке қызығасыз ба?
Dialogue: 0,0:08:41.44,0:08:44.61,Default,,0,0,0,,Иә, әр жағдайда. Бұл не?
Dialogue: 0,0:08:44.61,0:08:47.78,Default,,0,0,0,,Жоқ, ерекше ештеңе жоқ ➡︎
Dialogue: 0,0:08:47.78,0:08:50.95,Default,,0,0,0,,Мен өзімді бақытты сезінемін
Dialogue: 0,0:08:50.95,0:08:54.12,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:08:50.95,0:08:54.12,Default,,0,0,0,,Шынайы қызығушылық танытыңыз➡︎
Dialogue: 0,0:08:54.12,0:08:57.89,Default,,0,0,0,,Айна ғана қосылды.
Dialogue: 0,0:08:54.12,0:08:57.89,Default,,0,0,0,,Ха ха...
Dialogue: 0,0:08:57.89,0:09:01.39,Default,,0,0,0,,Айтпақшы, дайвинг дегеніміз не?
Dialogue: 0,0:08:57.89,0:09:01.39,Default,,0,0,0,,Оны дайындауым керек пе?
Dialogue: 0,0:09:01.39,0:09:05.06,Default,,0,0,0,,Хмм, иә...
Dialogue: 0,0:09:01.39,0:09:05.06,Default,,0,0,0,,Әртүрлі заттар бар...
Dialogue: 0,0:09:05.06,0:09:07.73,Default,,0,0,0,,Алдымен
Dialogue: 0,0:09:05.06,0:09:07.73,Default,,0,0,0,,Мен оны жалға алған дұрыс деп ойлаймын.
Dialogue: 0,0:09:07.73,0:09:10.07,Default,,0,0,0,,Әзірге орамал немесе купальник болуы мүмкін.
Dialogue: 0,0:09:10.07,0:09:12.07,Default,,0,0,0,,Ммм... купальник?
Dialogue: 0,0:09:12.07,0:09:16.24,Default,,0,0,0,,Сіз купальниктерді ұнатпайсыз ба?
Dialogue: 0,0:09:12.07,0:09:16.24,Default,,0,0,0,,Маған ұнамайды, дәлірек айтсақ, ұялдым...
Dialogue: 0,0:09:16.24,0:09:18.41,Default,,0,0,0,,Уууу, бәрі жақсы.
Dialogue: 0,0:09:18.41,0:09:21.41,Default,,0,0,0,,Ұялатын ештеңе жоқ
Dialogue: 0,0:09:18.41,0:09:21.41,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:09:21.41,0:09:24.91,Default,,0,0,0,,Мұның бәрі сіз туралы.
Dialogue: 0,0:09:21.41,0:09:24.91,Default,,0,0,0,,Өйткені мен сүңгуге үйреніп қалғанмын➡︎
Dialogue: 0,0:09:24.91,0:09:26.92,Default,,0,0,0,,Қарапайым адамдар...
Dialogue: 0,0:09:24.91,0:09:26.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.92,0:09:28.92,Default,,0,0,0,,Васшои! Васшои!
Dialogue: 0,0:09:28.92,0:09:31.42,Default,,0,0,0,,Қарапайым халық еш жерде жоқ.
Dialogue: 0,0:09:31.42,0:09:33.42,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:09:33.42,0:09:37.09,Default,,0,0,0,,Сонымен қатар, лифчиктің ішкі толтырғышы бар, сондықтан шын мәнінде…
Dialogue: 0,0:09:33.42,0:09:37.09,Default,,0,0,0,,Бүгін менің қарсы алу кешім➡︎
Dialogue: 0,0:09:37.09,0:09:39.59,Default,,0,0,0,,Барлығыңыз киініңіздер!
Dialogue: 0,0:09:41.93,0:09:43.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:41.93,0:09:43.93,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:09:43.93,0:09:46.10,Default,,0,0,0,,Ішімдігім таусылды.
Dialogue: 0,0:09:43.93,0:09:46.10,Default,,0,0,0,,Иә!?
Dialogue: 0,0:09:46.10,0:09:49.10,Default,,0,0,0,,Тіпті біреуі емес пе?
Dialogue: 0,0:09:46.10,0:09:49.10,Default,,0,0,0,,Сіз санды қате бағаладыңыз.
Dialogue: 0,0:09:49.10,0:09:51.44,Default,,0,0,0,,Аға деп санауға болатын біреу...
Dialogue: 0,0:09:51.44,0:09:53.44,Default,,0,0,0,,А, онда мен оны сатып аламын.
Dialogue: 0,0:09:53.44,0:09:55.78,Default,,0,0,0,,Ауыр емес пе? біз барамыз
Dialogue: 0,0:09:55.78,0:09:58.45,Default,,0,0,0,,Жарайды, дүкенге жақын.
Dialogue: 0,0:09:58.45,0:10:00.45,Default,,0,0,0,,А, онда мен де.
Dialogue: 0,0:10:00.45,0:10:03.79,Default,,0,0,0,,Олай болса, кеттік!
Dialogue: 0,0:10:00.45,0:10:03.79,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:10:03.79,0:10:06.62,Default,,0,0,0,,Дұрыс киінулеріңізді сұраймыз.
Dialogue: 0,0:10:06.62,0:10:08.62,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:10:08.62,0:10:12.63,Default,,0,0,0,,Күрсін, мен оған тез үйренуім керек.
Dialogue: 0,0:10:08.62,0:10:12.63,Default,,0,0,0,,Күміс шашты жарты эльф
Dialogue: 0,0:10:12.63,0:10:15.13,Default,,0,0,0,,Екі адам
Dialogue: 0,0:10:12.63,0:10:15.13,Default,,0,0,0,,Мен тым тез үйреніп кеттім.
Dialogue: 0,0:10:15.13,0:10:17.30,Default,,0,0,0,,Әй, бұл кім?
Dialogue: 0,0:10:17.30,0:10:19.97,Default,,0,0,0,,Саңырауқұлақтар қателесті
Dialogue: 0,0:10:17.30,0:10:19.97,Default,,0,0,0,,Бамбук бұтақтарын кім сатып алды?
Dialogue: 0,0:10:19.97,0:10:22.80,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың?
Dialogue: 0,0:10:22.80,0:10:24.81,Default,,0,0,0,,Әдетте бамбук өсінділері саңырауқұлақтарға қарағанда жақсы.
Dialogue: 0,0:10:24.81,0:10:26.81,Default,,0,0,0,,Қалжыңдама
Dialogue: 0,0:10:26.81,0:10:29.48,Default,,0,0,0,,Бамбук өсінділері ше?
Dialogue: 0,0:10:26.81,0:10:29.48,Default,,0,0,0,,Дәм сезбейтіндерге тамақ па?
Dialogue: 0,0:10:29.48,0:10:32.98,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:10:29.48,0:10:32.98,Default,,0,0,0,,Саңырауқұлақтар тілге азық.
Dialogue: 0,0:10:32.98,0:10:34.98,Default,,0,0,0,,Сәлем! Не дедіңіз!?
Dialogue: 0,0:10:34.98,0:10:37.99,Default,,0,0,0,,Мен тіпті крекер мен печеньенің дәмінің айырмашылығын білмеймін.
Dialogue: 0,0:10:34.98,0:10:37.99,Default,,0,0,0,,Менде дәм сезімі жоқ!
Dialogue: 0,0:10:37.99,0:10:40.99,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:10:37.99,0:10:40.99,Default,,0,0,0,,Сатуды салыстырып көрдіңіз бе?
Dialogue: 0,0:10:40.99,0:10:44.33,Default,,0,0,0,,Әй, егер солай айтсаң
Dialogue: 0,0:10:40.99,0:10:44.33,Default,,0,0,0,,Бұл қазірдің өзінде соғыс!
Dialogue: 0,0:10:44.33,0:10:47.50,Default,,0,0,0,,А? Не? Мұнда!
Dialogue: 0,0:10:44.33,0:10:47.50,Default,,0,0,0,,А, күте тұр, күте тұр.
Dialogue: 0,0:10:47.50,0:10:50.33,Default,,0,0,0,,Менің ұрысқым келмейді. Мен ұрысқым келмейді.
Dialogue: 0,0:10:47.50,0:10:50.33,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:10:50.33,0:10:53.67,Default,,0,0,0,,Осындай кезде ойын ойнаңыз.
Dialogue: 0,0:10:50.33,0:10:53.67,Default,,0,0,0,,Мен сізге бұрын айтқанмын
Dialogue: 0,0:10:53.67,0:10:55.60,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:10:55.60,0:10:57.61,Default,,0,0,0,,Қандай ойын?
Dialogue: 0,0:10:55.60,0:10:57.61,Default,,0,0,0,,Жарысқа қатысуым керек пе?
Dialogue: 0,0:10:57.61,0:11:00.11,Default,,0,0,0,,That's right.
Dialogue: 0,0:10:57.61,0:11:00.11,Default,,0,0,0,,Мен ортада шешім қабылдауым керек пе?
Dialogue: 0,0:11:00.11,0:11:03.11,Default,,0,0,0,,Сонда Түркия мен Баки ше?
Dialogue: 0,0:11:00.11,0:11:03.11,Default,,0,0,0,,Ойын идеясын тап
Dialogue: 0,0:11:03.11,0:11:06.11,Default,,0,0,0,,Жарайды, сіз оны таңдадыңыз ба?
Dialogue: 0,0:11:03.11,0:11:06.11,Default,,0,0,0,,Иә
Dialogue: 0,0:11:06.11,0:11:08.12,Default,,0,0,0,,Ал, нәтижесін көрейік...
Dialogue: 0,0:11:08.12,0:11:12.79,Default,,0,0,0,,Бұл горшок ойыны.
Dialogue: 0,0:11:08.12,0:11:12.79,Default,,0,0,0,,Не...қандай болса да!
Dialogue: 0,0:11:12.79,0:11:17.29,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:11:12.79,0:11:17.29,Default,,0,0,0,,Бұл кімнің идеясы болды? Осы сияқты... Иә?
Dialogue: 0,0:11:17.29,0:11:19.29,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:11:19.29,0:11:21.96,Default,,0,0,0,,Азуса-сан!
Dialogue: 0,0:11:19.29,0:11:21.96,Default,,0,0,0,,Мүмкіндік! Мүмкіндік!
Dialogue: 0,0:11:21.96,0:11:25.80,Default,,0,0,0,,Ал, кәне, горшок ойынын ойнайық
Dialogue: 0,0:11:21.96,0:11:25.80,Default,,0,0,0,,Мен мәселені шешемін.
Dialogue: 0,0:11:25.80,0:11:28.64,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:11:25.80,0:11:28.64,Default,,0,0,0,,Бұл біртүрлі!
Dialogue: 0,0:11:28.64,0:11:30.64,Default,,0,0,0,,Күлкілі емес Күлкілі емес!
Dialogue: 0,0:11:30.64,0:11:33.81,Default,,0,0,0,,Қасиетті аласапыранның нәтижесі. бас тарт.
Dialogue: 0,0:11:33.81,0:11:37.31,Default,,0,0,0,,Бірақ қалта жоқ.
Dialogue: 0,0:11:33.81,0:11:37.31,Default,,0,0,0,,Мен қаласам да, алмадым.
Dialogue: 0,0:11:37.31,0:11:39.82,Default,,0,0,0,,Хмм…
Dialogue: 0,0:11:37.31,0:11:39.82,Default,,0,0,0,,Әрине жоқ.
Dialogue: 0,0:11:39.82,0:11:41.82,Default,,0,0,0,,Мұны пайдалануым керек пе?
Dialogue: 0,0:11:44.65,0:11:47.16,Default,,0,0,0,,Кішкене үлкен
Dialogue: 0,0:11:44.65,0:11:47.16,Default,,0,0,0,,Маған қызық, бұл қандай екен
Dialogue: 0,0:11:47.16,0:11:49.49,Default,,0,0,0,,Кім бірінші жіберсе, сол жеңіледі.
Dialogue: 0,0:11:49.49,0:11:51.99,Default,,0,0,0,,Олай болса, бастайық!
Dialogue: 0,0:11:51.99,0:11:54.66,Default,,0,0,0,,Могумогумогу...!
Dialogue: 0,0:11:54.66,0:11:57.93,Default,,0,0,0,,Сурет мен ойлағаннан да нашар.
Dialogue: 0,0:11:57.93,0:12:00.60,Default,,0,0,0,,Чи-чанға және т.б
Dialogue: 0,0:11:57.93,0:12:00.60,Default,,0,0,0,,Мен оны сізге көрсете алмаймын.
Dialogue: 0,0:12:00.60,0:12:02.60,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:12:02.60,0:12:05.94,Default,,0,0,0,,Шешімсіз
Dialogue: 0,0:12:02.60,0:12:05.94,Default,,0,0,0,,Ұтыс ойыны дегеніміз не?
Dialogue: 0,0:12:05.94,0:12:07.94,Default,,0,0,0,,Жоқ, бұл мүмкін емес.
Dialogue: 0,0:12:07.94,0:12:11.28,Default,,0,0,0,,Ауыз іші
Dialogue: 0,0:12:07.94,0:12:11.28,Default,,0,0,0,,Бұл болады.
Dialogue: 0,0:12:11.28,0:12:14.62,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:12:11.28,0:12:14.62,Default,,0,0,0,,Азуса-сан, не?
Dialogue: 0,0:12:14.62,0:12:17.12,Default,,0,0,0,,Мен кәстрөл дайындаймын деп ойлаймын.
Dialogue: 0,0:12:17.12,0:12:19.29,Default,,0,0,0,,📱
Dialogue: 0,0:12:19.29,0:12:22.29,Default,,0,0,0,,Азуса-сан
Dialogue: 0,0:12:19.29,0:12:22.29,Default,,0,0,0,,«Маған горшок сатып беріңізші»
Dialogue: 0,0:12:22.29,0:12:25.39,Default,,0,0,0,,Потчи?
Dialogue: 0,0:12:22.29,0:12:25.39,Default,,0,0,0,,Тәтті заттар сирек кездеседі
Dialogue: 0,0:12:29.13,0:12:31.63,Default,,0,0,0,,Мен жоқта не болды?
Dialogue: 0,0:12:31.63,0:12:34.30,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:12:31.63,0:12:34.30,Default,,0,0,0,,Қарттар, көңілді жүрсіз бе?
Dialogue: 0,0:12:34.30,0:12:37.47,Default,,0,0,0,,Сосын менің үлкендерге де.
Dialogue: 0,0:12:34.30,0:12:37.47,Default,,0,0,0,,қатысуыңызды сұраймын!
Dialogue: 0,0:12:37.47,0:12:40.48,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:12:37.47,0:12:40.48,Default,,0,0,0,,Маған бәрібір, бірақ
Dialogue: 0,0:12:40.48,0:12:44.81,Default,,0,0,0,,Мен де қарсы емеспін...бірақ
Dialogue: 0,0:12:40.48,0:12:44.81,Default,,0,0,0,,Ойын ойнау үшін екі адамды қалай таңдайсыз?
Dialogue: 0,0:12:44.81,0:12:48.65,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:44.81,0:12:48.65,Default,,0,0,0,,Бұл тастай қатты ма, әлде бір нәрсе.
Dialogue: 0,0:12:48.65,0:12:50.99,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:12:48.65,0:12:50.99,Default,,0,0,0,,Төменгі жағына келгенде!
Dialogue: 0,0:12:50.99,0:12:53.19,Default,,0,0,0,,Иә, иә! сізді түсіндім!
Dialogue: 0,0:12:55.26,0:12:58.43,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:12:55.26,0:12:58.43,Default,,0,0,0,,Мен оны сатып алдым.
Dialogue: 0,0:12:58.43,0:13:02.93,Default,,0,0,0,,Шығар! Қауіпсіз! Жарайсың!
Dialogue: 0,0:13:02.93,0:13:04.93,Default,,0,0,0,,Ах, қош келдіңіз!
Dialogue: 0,0:13:04.93,0:13:06.94,Default,,0,0,0,,Неліктен бұлай болады!?
Dialogue: 0,0:13:06.94,0:13:09.77,Default,,0,0,0,,Күте тұрыңыз, Кебако, мұның себебі бар.
Dialogue: 0,0:13:09.77,0:13:14.28,Default,,0,0,0,,Біз горшок ойынын ойнауға бардық
Dialogue: 0,0:13:09.77,0:13:14.28,Default,,0,0,0,,Біріншіден, мен жәй ғана жанкен ойнадым.
Dialogue: 0,0:13:14.28,0:13:17.28,Default,,0,0,0,,Егер сіз жай ғана секіргіңіз келсе
Dialogue: 0,0:13:14.28,0:13:17.28,Default,,0,0,0,,Оны шешудің қажеті жоқ!
Dialogue: 0,0:13:17.28,0:13:20.12,Default,,0,0,0,,Өйткені бұл бейсбол жұдырығы
Dialogue: 0,0:13:17.28,0:13:20.12,Default,,0,0,0,,Оны шешу керек.
Dialogue: 0,0:13:20.12,0:13:22.62,Default,,0,0,0,,Күміс шашты жарты эльф
Dialogue: 0,0:13:20.12,0:13:22.62,Default,,0,0,0,,Бейсбол жұдырығынан басқа қалаусыз заттар➡︎
Dialogue: 0,0:13:22.62,0:13:27.12,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:13:22.62,0:13:27.12,Default,,0,0,0,,Қысқасы, бұл әдеттегідей ме?
Dialogue: 0,0:13:27.12,0:13:30.29,Default,,0,0,0,,Әдеттегідей.
Dialogue: 0,0:13:30.29,0:13:34.30,Default,,0,0,0,,Бірақ не?
Dialogue: 0,0:13:30.29,0:13:34.30,Default,,0,0,0,,Жаңа студенттер саны артты➡︎
Dialogue: 0,0:13:34.30,0:13:37.47,Default,,0,0,0,,Соңында
Dialogue: 0,0:13:34.30,0:13:37.47,Default,,0,0,0,,Лицензия бойынша оқуға дайындықты бастау керек пе?
Dialogue: 0,0:13:37.47,0:13:39.47,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:13:39.47,0:13:41.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:39.47,0:13:41.47,Default,,0,0,0,,Бұл лицензия ма?
Dialogue: 0,0:13:41.47,0:13:44.81,Default,,0,0,0,,Бұл сіздің киіміңізді тез шешіп алғаныңызды білдіре ме?
Dialogue: 0,0:13:41.47,0:13:44.81,Default,,0,0,0,,Сіз оны ерте ішуіңіз керек, солай ма?
Dialogue: 0,0:13:44.81,0:13:48.31,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:13:44.81,0:13:48.31,Default,,0,0,0,,Менің ойымша, бұл суға түсуге шешім қабылдады.
Dialogue: 0,0:13:48.31,0:13:50.31,Default,,0,0,0,,Дайвинг!?
Dialogue: 0,0:13:52.31,0:13:55.25,Default,,0,0,0,,Бұл ақымақ!
Dialogue: 0,0:13:52.31,0:13:55.25,Default,,0,0,0,,♬~
Dialogue: 0,0:13:55.25,0:13:58.25,Default,,0,0,0,,Бұл реакцияға біз кінәліміз бе?
Dialogue: 0,0:13:58.25,0:14:00.26,Default,,0,0,0,,Менің ойымша, бұл 50/50.
Dialogue: 0,0:14:00.26,0:14:05.09,Default,,0,0,0,,Мен сендерден сұрайын, бірақ балалар, оқулығыңда не бар?
Dialogue: 0,0:14:00.26,0:14:05.09,Default,,0,0,0,,Менің ойымша, сіз оны оқыдыңыз ба?
Dialogue: 0,0:14:05.09,0:14:08.10,Default,,0,0,0,,Әрине...
Dialogue: 0,0:14:05.09,0:14:08.10,Default,,0,0,0,,Сұрау қажет емес
Dialogue: 0,0:14:08.10,0:14:11.60,Default,,0,0,0,,Бұл жігіттер маған ешқашан қарамайды.
Dialogue: 0,0:14:11.60,0:14:15.10,Default,,0,0,0,,Бірін байқап көргіңіз келе ме?
Dialogue: 0,0:14:11.60,0:14:15.10,Default,,0,0,0,,Иә
Dialogue: 0,0:14:15.10,0:14:17.94,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:14:15.10,0:14:17.94,Default,,0,0,0,,Қол сигналын білесіз бе?
Dialogue: 0,0:14:17.94,0:14:21.28,Default,,0,0,0,,Иә
Dialogue: 0,0:14:17.94,0:14:21.28,Default,,0,0,0,,Негізінде сен ишарасың, солай ма?
Dialogue: 0,0:14:21.28,0:14:25.11,Default,,0,0,0,,Су астындағы байланыс үшін қолданылады
Dialogue: 0,0:14:21.28,0:14:25.11,Default,,0,0,0,,Бұл маңызды белгі.
Dialogue: 0,0:14:25.11,0:14:27.95,Default,,0,0,0,,Енді мен оны сынап көремін.
Dialogue: 0,0:14:27.95,0:14:31.45,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:14:27.95,0:14:31.45,Default,,0,0,0,,Неге шағымданып жатқаныңызды ойлаңыз.
Dialogue: 0,0:14:40.63,0:14:42.63,Default,,0,0,0,,《Басқаша айтқанда...》
Dialogue: 0,0:14:50.47,0:14:53.31,Default,,0,0,0,,Енді, Иори.
Dialogue: 0,0:14:50.47,0:14:53.31,Default,,0,0,0,,Не істеу керек?
Dialogue: 0,0:14:53.31,0:14:57.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:53.31,0:14:57.91,Default,,0,0,0,,Қарсыласыңыздан бұрын су астындағы мылтықпен атыңыз
Dialogue: 0,0:14:57.91,0:14:59.91,Default,,0,0,0,,Жағдай қандай?
Dialogue: 0,0:14:59.91,0:15:03.42,Default,,0,0,0,,Қажетсіз
Dialogue: 0,0:14:59.91,0:15:03.42,Default,,0,0,0,,Иори алдында қол сигналдарын қолдануға болмайды.
Dialogue: 0,0:15:03.42,0:15:05.42,Default,,0,0,0,,Келесі кезекте Кохейге келді.
Dialogue: 0,0:15:05.42,0:15:08.26,Default,,0,0,0,,Менің Китахарадан айырмашылығым
Dialogue: 0,0:15:05.42,0:15:08.26,Default,,0,0,0,,Мен саған көрсетемін
Dialogue: 0,0:15:08.26,0:15:10.26,Default,,0,0,0,,Хозакуна Бокенас
Dialogue: 0,0:15:22.77,0:15:26.61,Default,,0,0,0,,Сіз қалай ойлайсыз? Кохеи
Dialogue: 0,0:15:22.77,0:15:26.61,Default,,0,0,0,,Мен сені жылы көзіммен бақылаймын.
Dialogue: 0,0:15:26.61,0:15:28.61,Default,,0,0,0,,Бұл біртүрлі ой.
Dialogue: 0,0:15:28.61,0:15:31.11,Default,,0,0,0,,Менің ойымша, сіз оқымағансыз.
Dialogue: 0,0:15:31.11,0:15:34.45,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:31.11,0:15:34.45,Default,,0,0,0,,Мен мұны білдім.
Dialogue: 0,0:15:34.45,0:15:38.29,Default,,0,0,0,,Сонымен
Dialogue: 0,0:15:34.45,0:15:38.29,Default,,0,0,0,,Біраз оқыңыз.
Dialogue: 0,0:15:38.29,0:15:40.62,Default,,0,0,0,,Сіз қазір бастайсыз ба?
Dialogue: 0,0:15:38.29,0:15:40.62,Default,,0,0,0,,Есіңізде болса, таң қаласыз ➡︎
Dialogue: 0,0:15:40.62,0:15:44.42,Default,,0,0,0,,Мүмкін жақсы нәрсе болатын шығар?
Dialogue: 0,0:15:40.62,0:15:44.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:46.63,0:15:48.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:48.63,0:15:51.47,Default,,0,0,0,,Иори-кун, сен лицензия оқисың ба?
Dialogue: 0,0:15:51.47,0:15:54.14,Default,,0,0,0,,Иә. Тек қол сигналы...
Dialogue: 0,0:15:54.14,0:15:56.14,Default,,0,0,0,,~ Қайсысы...
Dialogue: 0,0:15:59.74,0:16:01.74,Default,,0,0,0,,《Бұл сезім! 》
Dialogue: 0,0:16:01.74,0:16:04.25,Default,,0,0,0,,Осы жерден үйренуден бастаңыз.
Dialogue: 0,0:16:04.25,0:16:07.25,Default,,0,0,0,,《Жоқ, шынымен
Dialogue: 0,0:16:04.25,0:16:07.25,Default,,0,0,0,,Жақсы нәрселер болады...
Dialogue: 0,0:16:07.25,0:16:10.25,Default,,0,0,0,,Қандай керемет!
Dialogue: 0,0:16:07.25,0:16:10.25,Default,,0,0,0,,Қол сигналы! 》
Dialogue: 0,0:16:10.25,0:16:14.09,Default,,0,0,0,,Аа, енді ойлап қарасам, Иори-кун...
Dialogue: 0,0:16:10.25,0:16:14.09,Default,,0,0,0,,Иә? иә
Dialogue: 0,0:16:14.09,0:16:18.09,Default,,0,0,0,,Мен жаңа ғана осындай нәрсені естідім.
Dialogue: 0,0:16:14.09,0:16:18.09,Default,,0,0,0,,Сен оны білесің бе?
Dialogue: 0,0:16:18.09,0:16:20.10,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:20.10,0:16:23.90,Default,,0,0,0,,Иори-кун мен Чиса-чан
Dialogue: 0,0:16:20.10,0:16:23.90,Default,,0,0,0,,Танысу туралы әңгімелеу.
Dialogue: 0,0:16:25.93,0:16:28.44,Default,,0,0,0,,О
Dialogue: 0,0:16:25.93,0:16:28.44,Default,,0,0,0,,Бұл бірден пайдалы бола бастады.
Dialogue: 0,0:16:28.44,0:16:31.11,Default,,0,0,0,,Бұл белгі «мәселе орын алды» дейді.
Dialogue: 0,0:16:31.11,0:16:34.44,Default,,0,0,0,,А, бұл маңызды белгілердің бірі.
Dialogue: 0,0:16:34.44,0:16:38.61,Default,,0,0,0,,U.A. спорттық күні теледидарда көрсетілген сол жігіт қой.
Dialogue: 0,0:16:34.44,0:16:38.61,Default,,0,0,0,,Азуса-сан, бұл төтенше жағдай!
Dialogue: 0,0:16:38.61,0:16:41.95,Default,,0,0,0,,Нанака-сан
Dialogue: 0,0:16:38.61,0:16:41.95,Default,,0,0,0,,Сіз оқиғаны бұрыннан білетін сияқтысыз...
Dialogue: 0,0:16:41.95,0:16:44.45,Default,,0,0,0,,Ах~
Dialogue: 0,0:16:41.95,0:16:44.45,Default,,0,0,0,,Жарай ма?
Dialogue: 0,0:16:44.45,0:16:46.79,Default,,0,0,0,,Жарайды! Маған қалдырыңыз!
Dialogue: 0,0:16:46.79,0:16:49.79,Default,,0,0,0,,Азуса-сан күткендей! сенімді!
Dialogue: 0,0:16:49.79,0:16:52.29,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:16:49.79,0:16:52.29,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:16:52.29,0:16:54.63,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:16:54.63,0:16:58.57,Default,,0,0,0,,Иори шынымен ұнататын қыз кім?
Dialogue: 0,0:16:54.63,0:16:58.57,Default,,0,0,0,,Айтыңызшы!
Dialogue: 0,0:16:58.57,0:17:02.74,Default,,0,0,0,,Иә!? О жоқ~
Dialogue: 0,0:16:58.57,0:17:02.74,Default,,0,0,0,,Мен Чисаны жақсы көремін~
Dialogue: 0,0:17:02.74,0:17:04.74,Default,,0,0,0,,Ахахаха! Ахаха! Ахаха!
Dialogue: 0,0:17:04.74,0:17:08.91,Default,,0,0,0,,Иори өте жақсы көреді
Dialogue: 0,0:17:04.74,0:17:08.91,Default,,0,0,0,,Сен қабір қазғанды ұнатасың.
Dialogue: 0,0:17:08.91,0:17:13.58,Default,,0,0,0,,Мен... ори... кун?
Dialogue: 0,0:17:08.91,0:17:13.58,Default,,0,0,0,,Уау!?
Dialogue: 0,0:17:13.58,0:17:17.25,Default,,0,0,0,,Және бұл
Dialogue: 0,0:17:13.58,0:17:17.25,Default,,0,0,0,,«Осында келіңізші»?
Dialogue: 0,0:17:17.25,0:17:20.09,Default,,0,0,0,,Иори тәжірибесі
Dialogue: 0,0:17:17.25,0:17:20.09,Default,,0,0,0,,Барған сайын есімде
Dialogue: 0,0:17:20.09,0:17:22.26,Default,,0,0,0,,Кохеи де жеңілуге шамасы келмейді.
Dialogue: 0,0:17:22.26,0:17:25.43,Default,,0,0,0,,Дұрыс, Нанака-сан.
Dialogue: 0,0:17:22.26,0:17:25.43,Default,,0,0,0,,Енді бұл...
Dialogue: 0,0:17:25.43,0:17:28.26,Default,,0,0,0,,Керемет!
Dialogue: 0,0:17:25.43,0:17:28.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:28.26,0:17:32.60,Default,,0,0,0,,Соңғы уақытта екеуінің қарым-қатынасы болды
Dialogue: 0,0:17:28.26,0:17:32.60,Default,,0,0,0,,Мен уайымдадым, себебі бұл қауіпті көрінді.
Dialogue: 0,0:17:32.60,0:17:35.27,Default,,0,0,0,,Бірақ егер Иори-кун солай болса.
Dialogue: 0,0:17:32.60,0:17:35.27,Default,,0,0,0,,Жарайды, солай ма?
Dialogue: 0,0:17:35.27,0:17:37.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:35.27,0:17:37.94,Default,,0,0,0,,Нанака Жарай ма?
Dialogue: 0,0:17:37.94,0:17:39.94,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:17:39.94,0:17:42.44,Default,,0,0,0,,Өйткені, қара
Dialogue: 0,0:17:39.94,0:17:42.44,Default,,0,0,0,,Чи-чан мен Иори...
Dialogue: 0,0:17:42.44,0:17:44.45,Default,,0,0,0,,Жақсы нәрсе емес!
Dialogue: 0,0:17:44.45,0:17:46.78,Default,,0,0,0,,Екеуміз кездесіп жүргендей.
Dialogue: 0,0:17:44.45,0:17:46.78,Default,,0,0,0,,Көріп тұрғаныңызша➡︎
Dialogue: 0,0:17:46.78,0:17:50.45,Default,,0,0,0,,Біз жақсы доспыз, солай ма?
Dialogue: 0,0:17:46.78,0:17:50.45,Default,,0,0,0,,《Қандай ыңғайлы түсіндіру! 》
Dialogue: 0,0:17:50.45,0:17:52.95,Default,,0,0,0,,Хмм... олай емес➡︎
Dialogue: 0,0:17:52.95,0:17:55.56,Default,,0,0,0,,Егер олар шынымен кездесіп жүрген болса ше?
Dialogue: 0,0:17:52.95,0:17:55.56,Default,,0,0,0,,Бұл!?
Dialogue: 0,0:17:55.56,0:17:59.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:55.56,0:17:59.73,Default,,0,0,0,,Ухуху, мен шынымен түсінбеймін.
Dialogue: 0,0:17:59.73,0:18:02.06,Default,,0,0,0,,Жоқ, солай емес пе?
Dialogue: 0,0:18:02.06,0:18:05.57,Default,,0,0,0,,Абсолютті Азусаның сұрағы
Dialogue: 0,0:18:02.06,0:18:05.57,Default,,0,0,0,,Мағынасын мүлде түсінбеймін...
Dialogue: 0,0:18:05.57,0:18:08.24,Default,,0,0,0,,Жоқ, олай емес➡︎
Dialogue: 0,0:18:08.24,0:18:12.07,Default,,0,0,0,,Мен не істеймін
Dialogue: 0,0:18:08.24,0:18:12.07,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:18:12.07,0:18:14.74,Default,,0,0,0,,《Жақында аламын
Dialogue: 0,0:18:12.07,0:18:14.74,Default,,0,0,0,,Сізді өлтіруі мүмкін》
Dialogue: 0,0:18:14.74,0:18:18.41,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:18:14.74,0:18:18.41,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:18:18.41,0:18:21.58,Default,,0,0,0,,Сен кімсің? Және неге Буггаратиды білесің?
Dialogue: 0,0:18:18.41,0:18:21.58,Default,,0,0,0,,Соңғы кездері өте ауыр болды.
Dialogue: 0,0:18:21.58,0:18:23.59,Default,,0,0,0,,Әпке ретінде➡︎
Dialogue: 0,0:18:23.59,0:18:26.09,Default,,0,0,0,,Сіз оны назардан тыс қалдыра алмайсыз.
Dialogue: 0,0:18:23.59,0:18:26.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:26.09,0:18:29.39,Default,,0,0,0,,Олай болса
Dialogue: 0,0:18:26.09,0:18:29.39,Default,,0,0,0,,Ертең осылай жаттығу жасайық
Dialogue: 0,0:18:32.59,0:18:36.60,Default,,0,0,0,,Иә бүгін.
Dialogue: 0,0:18:32.59,0:18:36.60,Default,,0,0,0,,Әр жұпты суға батырыңыз
Dialogue: 0,0:18:36.60,0:18:39.27,Default,,0,0,0,,《Не? Бұл ыңғайсыз.
Dialogue: 0,0:18:39.27,0:18:42.27,Default,,0,0,0,,Олай болса, алдымен
Dialogue: 0,0:18:39.27,0:18:42.27,Default,,0,0,0,,Біз купальник киеміз бе?
Dialogue: 0,0:18:42.27,0:18:44.61,Default,,0,0,0,,Не!
Dialogue: 0,0:18:42.27,0:18:44.61,Default,,0,0,0,,Ал, мен киімімді ауыстырайын ба?
Dialogue: 0,0:18:44.61,0:18:46.61,Default,,0,0,0,,Сіз мұнда өзгеріп жатырсыз ба?
Dialogue: 0,0:18:46.61,0:18:48.78,Default,,0,0,0,,Енді
Dialogue: 0,0:18:46.61,0:18:48.78,Default,,0,0,0,,Сізге бәрібір болар.
Dialogue: 0,0:18:48.78,0:18:54.12,Default,,0,0,0,,Мәселе бұл емес... Кя!
Dialogue: 0,0:18:48.78,0:18:54.12,Default,,0,0,0,,Екеуің не істеп жатырсыңдар!?
Dialogue: 0,0:18:54.12,0:18:56.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:54.12,0:18:56.38,Default,,0,0,0,,Сіз киіміңізді ауыстырып жатырсыз ба?
Dialogue: 0,0:18:56.38,0:18:58.39,Default,,0,0,0,,Тіпті көпшілік алдында!?
Dialogue: 0,0:18:58.39,0:19:01.06,Default,,0,0,0,,Котегава мырза, бірдеңе айтыңыз...
Dialogue: 0,0:19:01.06,0:19:03.89,Default,,0,0,0,,Егер сіз астына купальник кимеген болсаңыз.
Dialogue: 0,0:19:03.89,0:19:07.56,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:19:03.89,0:19:07.56,Default,,0,0,0,,Азуса іш киімге ұқсайды.
Dialogue: 0,0:19:07.56,0:19:11.57,Default,,0,0,0,,Мен үшін купальникпен көріну жаңалық.
Dialogue: 0,0:19:07.56,0:19:11.57,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:19:11.57,0:19:15.24,Default,,0,0,0,,Кішкене үлкендер
Dialogue: 0,0:19:11.57,0:19:15.24,Default,,0,0,0,,Жазықсыз болса жақсы.
Dialogue: 0,0:19:15.24,0:19:17.74,Default,,0,0,0,,《Мен бұл адамдарды жек көремін! 》
Dialogue: 0,0:19:20.91,0:19:24.08,Default,,0,0,0,,Нанака-сан...
Dialogue: 0,0:19:20.91,0:19:24.08,Default,,0,0,0,,Не? Иори-кун
Dialogue: 0,0:19:24.08,0:19:26.92,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:24.08,0:19:26.92,Default,,0,0,0,,Чиса екеуміз жұппыз ба?
Dialogue: 0,0:19:26.92,0:19:29.75,Default,,0,0,0,,Екі адамға
Dialogue: 0,0:19:26.92,0:19:29.75,Default,,0,0,0,,Мен сенімен татуласып кеткім келді.
Dialogue: 0,0:19:29.75,0:19:31.92,Default,,0,0,0,,Керісінше, керісінше әсер ететін сияқты...
Dialogue: 0,0:19:31.92,0:19:34.59,Default,,0,0,0,,Жарайды. Чи-чан.
Dialogue: 0,0:19:31.92,0:19:34.59,Default,,0,0,0,,Теңізге түссеңіз➡︎
Dialogue: 0,0:19:34.59,0:19:37.09,Default,,0,0,0,,Өйткені ол өте талғампаз бала.
Dialogue: 0,0:19:34.59,0:19:37.09,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:37.09,0:19:40.89,Default,,0,0,0,,Егер адам мұны естісе
Dialogue: 0,0:19:37.09,0:19:40.89,Default,,0,0,0,,Мен қатты ашуландым
Dialogue: 0,0:19:46.43,0:19:50.10,Default,,0,0,0,,Олай болса, Иори.
Dialogue: 0,0:19:46.43,0:19:50.10,Default,,0,0,0,,Мені тастама
Dialogue: 0,0:19:50.10,0:19:54.11,Default,,0,0,0,,(Игги) Ұф! (Джозеф) Хи-хи
Dialogue: 0,0:19:50.10,0:19:54.11,Default,,0,0,0,,Не болды? Иори. Мазасыз ба?
Dialogue: 0,0:19:54.11,0:19:56.11,Default,,0,0,0,,Не? А, жоқ...
Dialogue: 0,0:19:56.11,0:19:59.45,Default,,0,0,0,,Бүгін өте таяз.
Dialogue: 0,0:19:56.11,0:19:59.45,Default,,0,0,0,,Тек жүзіңіз
Dialogue: 0,0:19:59.45,0:20:03.28,Default,,0,0,0,,Қорықсаңыз, өзіңізді итермеңіз.
Dialogue: 0,0:19:59.45,0:20:03.28,Default,,0,0,0,,Егер бірдеңе болса, маған дереу хабарлаңыз.
Dialogue: 0,0:20:03.28,0:20:05.88,Default,,0,0,0,,О, о, мен түсіндім.
Dialogue: 0,0:20:10.63,0:20:12.79,Default,,0,0,0,,《Жарайды, мен кете аламын.
Dialogue: 0,0:20:12.79,0:20:15.96,Default,,0,0,0,,Бұл достық атмосфера емес.
Dialogue: 0,0:20:15.96,0:20:41.66,Default,,0,0,0,,♬︎～
Dialogue: 0,0:20:41.66,0:20:47.50,Default,,0,0,0,,《Иә? Чисаның бірі
Dialogue: 0,0:20:41.66,0:20:47.50,Default,,0,0,0,,Ашуланғанның орнына...》
Dialogue: 0,0:20:47.50,0:20:59.27,Default,,0,0,0,,♬︎～
Dialogue: 0,0:20:59.27,0:21:01.44,Default,,0,0,0,,《Аа~ түсіндім.
Dialogue: 0,0:21:01.44,0:21:04.94,Default,,0,0,0,,Ол жай ғана байыпты.
Dialogue: 0,0:21:12.79,0:21:15.39,Default,,0,0,0,,《Жағдайда
Dialogue: 0,0:21:12.79,0:21:15.39,Default,,0,0,0,,Жазатайым оқиғаларды болдырмау үшін》
Dialogue: 0,0:21:17.79,0:21:21.79,Default,,0,0,0,,《Мүмкіндігінше
Dialogue: 0,0:21:17.79,0:21:21.79,Default,,0,0,0,,Суда болудан ләззат алу үшін》
Dialogue: 0,0:21:27.64,0:21:30.34,Default,,0,0,0,,《Мен суды ұнатпайтындар үшін...》
Dialogue: 0,0:21:37.15,0:21:39.98,Default,,0,0,0,,Бұл өте қызық болды!
Dialogue: 0,0:21:39.98,0:21:42.65,Default,,0,0,0,,Сізге ұнаған сияқты.
Dialogue: 0,0:21:39.98,0:21:42.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:42.65,0:21:44.65,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:44.65,0:21:46.99,Default,,0,0,0,,Ах~
Dialogue: 0,0:21:46.99,0:21:49.66,Default,,0,0,0,,Иори көңілді болды ма?
Dialogue: 0,0:21:49.66,0:21:54.00,Default,,0,0,0,,Ах! Әрине!
Dialogue: 0,0:21:54.00,0:21:58.77,Default,,0,0,0,,Шындығында мен Хори ханымға біраз уақыттан бері ғашықпын.
Dialogue: 0,0:21:58.77,0:22:00.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:03.94,0:22:06.77,Default,,0,0,0,,Біз бәрібір бітімге келе алдық.
Dialogue: 0,0:22:03.94,0:22:06.77,Default,,0,0,0,,Иә
Dialogue: 0,0:22:06.77,0:22:08.78,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:22:08.78,0:22:12.78,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:22:08.78,0:22:12.78,Default,,0,0,0,,Нанака-санның сіңлісі күткендей.
Dialogue: 0,0:22:12.78,0:22:16.62,Default,,0,0,0,,Не?
Dialogue: 0,0:22:12.78,0:22:16.62,Default,,0,0,0,,Артынан бақылап тұрғанда ойладым➡︎
Dialogue: 0,0:22:16.62,0:22:19.62,Default,,0,0,0,,Оның бөкселерінің сызығы керемет болды!
Dialogue: 0,0:22:22.29,0:22:24.29,Default,,0,0,0,,20 000 рет өл!
Dialogue: 0,0:22:22.29,0:22:24.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:24.29,0:22:26.29,Default,,0,0,0,,(Теңізге құлау дыбысы)
Dialogue: 0,0:22:27.79,0:22:33.79,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
