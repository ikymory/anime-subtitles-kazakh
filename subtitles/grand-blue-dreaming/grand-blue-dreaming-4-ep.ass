Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.28,0:00:07.28,Default,,0,0,0,,Иззу көктем фестивалі! Алақай!
Dialogue: 0,0:01:41.31,0:01:43.31,Default,,0,0,0,,Мен қатты қуандым, бірақ...
Dialogue: 0,0:01:43.31,0:01:45.65,Default,,0,0,0,,Біз дүкен ұстаушымыз ба?
Dialogue: 0,0:01:45.65,0:01:47.65,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:01:47.65,0:01:51.32,Default,,0,0,0,,Жақсы жұмыс! Қалыңыз қалай?
Dialogue: 0,0:01:51.32,0:01:53.82,Default,,0,0,0,,Бұл біраз әбігерге түсті, солай емес пе?
Dialogue: 0,0:01:53.82,0:01:56.42,Default,,0,0,0,,Менің іскер бәсекелесім бар сияқты...
Dialogue: 0,0:01:59.93,0:02:03.77,Default,,0,0,0,,А, Тинкербел?
Dialogue: 0,0:01:59.93,0:02:03.77,Default,,0,0,0,,Тинкербель дегеніміз не?
Dialogue: 0,0:02:03.77,0:02:07.77,Default,,0,0,0,,Әдемі еркектер бірге
Dialogue: 0,0:02:03.77,0:02:07.77,Default,,0,0,0,,Әйелдер қатынасы ең жоғары теннисші
Dialogue: 0,0:02:07.77,0:02:09.77,Default,,0,0,0,,өтіңіз
Dialogue: 0,0:02:09.77,0:02:12.28,Default,,0,0,0,,Сізге шикі сағыз ұнайды ма?
Dialogue: 0,0:02:09.77,0:02:12.28,Default,,0,0,0,,Бұл шошқаның қаны.
Dialogue: 0,0:02:12.28,0:02:15.11,Default,,0,0,0,,Тік бетпен не тастауым керек?
Dialogue: 0,0:02:12.28,0:02:15.11,Default,,0,0,0,,Сөйлеуді тоқтатыңыз
Dialogue: 0,0:02:15.11,0:02:19.78,Default,,0,0,0,,О!
Dialogue: 0,0:02:15.11,0:02:19.78,Default,,0,0,0,,Уау, бұл ыстық!
Dialogue: 0,0:02:19.78,0:02:23.62,Default,,0,0,0,,Жаяу келдің бе?
Dialogue: 0,0:02:19.78,0:02:23.62,Default,,0,0,0,,Ня, жарты жолға дейін автобус
Dialogue: 0,0:02:23.62,0:02:25.96,Default,,0,0,0,,Жоқ, жоқ, әдетте
Dialogue: 0,0:02:23.62,0:02:25.96,Default,,0,0,0,,Әңгімелесу Сіз оны бастасаңыз да...
Dialogue: 0,0:02:25.96,0:02:27.96,Default,,0,0,0,,Әзірше киіңіз.
Dialogue: 0,0:02:27.96,0:02:30.29,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,0:02:27.96,0:02:30.29,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:02:30.29,0:02:32.30,Default,,0,0,0,,Бұл көріністе не болды?
Dialogue: 0,0:02:32.30,0:02:34.63,Default,,0,0,0,,Дәл сол жерде
Dialogue: 0,0:02:32.30,0:02:34.63,Default,,0,0,0,,Мен ұсталдым.
Dialogue: 0,0:02:34.63,0:02:36.97,Default,,0,0,0,,Оны жақсырақ жуыңыз
Dialogue: 0,0:02:34.63,0:02:36.97,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:02:36.97,0:02:40.14,Default,,0,0,0,,Түнде бәрібір
Dialogue: 0,0:02:36.97,0:02:40.14,Default,,0,0,0,,Құсуыңмен лас болады.
Dialogue: 0,0:02:40.14,0:02:44.44,Default,,0,0,0,,Түнде сені қандай сенбі күтіп тұр!?
Dialogue: 0,0:02:40.14,0:02:44.44,Default,,0,0,0,,Бұл шынымен де шайтанның мерекесі.
Dialogue: 0,0:02:46.48,0:02:48.81,Default,,0,0,0,,Мен футболка іздесем қалай болады?
Dialogue: 0,0:02:48.81,0:02:51.48,Default,,0,0,0,,Мен оны сол күйінде қалдырғым келеді.
Dialogue: 0,0:02:51.48,0:02:53.48,Default,,0,0,0,,Күтілгендей, бұл аздап...
Dialogue: 0,0:02:53.48,0:02:57.09,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:02:53.48,0:02:57.09,Default,,0,0,0,,Олай болса, Иори сенімен бірге барады!
Dialogue: 0,0:02:57.09,0:02:59.29,Default,,0,0,0,,О, күте тұрыңыз... неге мен де?
Dialogue: 0,0:03:01.92,0:03:06.60,Default,,0,0,0,,Хмм!
Dialogue: 0,0:03:01.92,0:03:06.60,Default,,0,0,0,,Мектеп фестивалі қызық және жақсы!
Dialogue: 0,0:03:06.60,0:03:09.27,Default,,0,0,0,,Азуса-сан
Dialogue: 0,0:03:06.60,0:03:09.27,Default,,0,0,0,,Сізге фестивальдер ұнайтын сияқты.
Dialogue: 0,0:03:09.27,0:03:11.27,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:03:11.27,0:03:13.94,Default,,0,0,0,,Ах, «ұнату» туралы айтсақ...
Dialogue: 0,0:03:11.27,0:03:13.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:13.94,0:03:16.77,Default,,0,0,0,,Иори қандай адам?
Dialogue: 0,0:03:16.77,0:03:19.44,Default,,0,0,0,,Не... кенеттен не болды...
Dialogue: 0,0:03:19.44,0:03:23.61,Default,,0,0,0,,Жоқ, қара!
Dialogue: 0,0:03:19.44,0:03:23.61,Default,,0,0,0,,Бір хоббиі бар адам ретінде.
Dialogue: 0,0:03:23.61,0:03:25.61,Default,,0,0,0,,《Енді ойласам...》
Dialogue: 0,0:03:25.61,0:03:28.45,Default,,0,0,0,,((Шындығында мен де
Dialogue: 0,0:03:25.61,0:03:28.45,Default,,0,0,0,,Екеуі де жақсы))
Dialogue: 0,0:03:28.45,0:03:32.96,Default,,0,0,0,,Айтпақшы, мен еркек болсам, Тоққы дер едім.
Dialogue: 0,0:03:28.45,0:03:32.96,Default,,0,0,0,,Әйел үшін Нанака жақсы.
Dialogue: 0,0:03:32.96,0:03:35.96,Default,,0,0,0,,Сіз Нанака-сансыз ба?
Dialogue: 0,0:03:32.96,0:03:35.96,Default,,0,0,0,,Сонымен, Иори туралы не деуге болады?
Dialogue: 0,0:03:35.96,0:03:38.79,Default,,0,0,0,,Не? иә? Бұл не?
Dialogue: 0,0:03:35.96,0:03:38.79,Default,,0,0,0,,Сүйікті түрі
Dialogue: 0,0:03:38.79,0:03:40.80,Default,,0,0,0,,《Түсінбеушілікті шешіңіз!
Dialogue: 0,0:03:40.80,0:03:43.47,Default,,0,0,0,,«Мен гей емеспін» десеңіз
Dialogue: 0,0:03:40.80,0:03:43.47,Default,,0,0,0,,Бұл жалғыз орын! 》
Dialogue: 0,0:03:43.47,0:03:45.47,Default,,0,0,0,,Іс жүзінде...
Dialogue: 0,0:03:45.47,0:03:47.97,Default,,0,0,0,,Ах, бірақ жақсы болды.
Dialogue: 0,0:03:45.47,0:03:47.97,Default,,0,0,0,,Менің достарым бар
Dialogue: 0,0:03:47.97,0:03:49.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:47.97,0:03:49.97,Default,,0,0,0,,Қанша, тіпті мен үшін➡︎
Dialogue: 0,0:03:49.97,0:03:52.98,Default,,0,0,0,,Басқаларға
Dialogue: 0,0:03:49.97,0:03:52.98,Default,,0,0,0,,Сіз бұл туралы ешқашан айта алмайсыз.
Dialogue: 0,0:03:52.98,0:03:55.75,Default,,0,0,0,,Маған көмектесші, Құдай!
Dialogue: 0,0:03:55.75,0:03:58.41,Default,,0,0,0,,Иоридің сізге не ұнайды?
Dialogue: 0,0:03:58.41,0:04:01.92,Default,,0,0,0,,Сәлем Китахара
Dialogue: 0,0:03:58.41,0:04:01.92,Default,,0,0,0,,Не?
Dialogue: 0,0:04:01.92,0:04:03.92,Default,,0,0,0,,Неліктен Азуса-сан?
Dialogue: 0,0:04:03.92,0:04:06.76,Default,,0,0,0,,Кенет сіз екеуміз дүкенші ауыстырдық.
Dialogue: 0,0:04:03.92,0:04:06.76,Default,,0,0,0,,Сіз айттыңыз ба?
Dialogue: 0,0:04:06.76,0:04:08.76,Default,,0,0,0,,...
Dialogue: 0,0:04:08.76,0:04:11.26,Default,,0,0,0,,((Жарайды
Dialogue: 0,0:04:08.76,0:04:11.26,Default,,0,0,0,,Кел, Иоримен ойна!
Dialogue: 0,0:04:11.26,0:04:13.60,Default,,0,0,0,,Ах ха...))
Dialogue: 0,0:04:13.60,0:04:15.93,Default,,0,0,0,,Дәл осы...
Dialogue: 0,0:04:13.60,0:04:15.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:15.93,0:04:18.10,Default,,0,0,0,,Мен саған бірдеңе жасадым.
Dialogue: 0,0:04:15.93,0:04:18.10,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:04:18.10,0:04:21.10,Default,,0,0,0,,Мені не нәрсеге түсірдің!?
Dialogue: 0,0:04:23.11,0:04:25.11,Default,,0,0,0,,Жоқ, бірақ бұл бейбіт.
Dialogue: 0,0:04:25.11,0:04:27.11,Default,,0,0,0,,Өйткені үлкендер жоқ.
Dialogue: 0,0:04:27.11,0:04:29.78,Default,,0,0,0,,Кейде осындай күн болғаны жақсы
Dialogue: 0,0:04:29.78,0:04:32.28,Default,,0,0,0,,Иори үшін Кохеи емес пе?
Dialogue: 0,0:04:32.28,0:04:34.28,Default,,0,0,0,,Сіз дұрыс жерге келдіңіз.
Dialogue: 0,0:04:34.28,0:04:37.12,Default,,0,0,0,,Не!
Dialogue: 0,0:04:34.28,0:04:37.12,Default,,0,0,0,,Сіз әрекеттесетін шеңберлер ➡︎
Dialogue: 0,0:04:37.12,0:04:39.79,Default,,0,0,0,,Бүгін кешке
Dialogue: 0,0:04:37.12,0:04:39.79,Default,,0,0,0,,Бірлесіп ішу туралы әңгімелестік.
Dialogue: 0,0:04:39.79,0:04:43.96,Default,,0,0,0,,~ Бұл шын мәнінде бірлескен партия.
Dialogue: 0,0:04:39.79,0:04:43.96,Default,,0,0,0,,Олай болса, сүйкімді қыздар да...
Dialogue: 0,0:04:43.96,0:04:47.46,Default,,0,0,0,,Хахахаха! Яғни
Dialogue: 0,0:04:43.96,0:04:47.46,Default,,0,0,0,,Олармен тексеріңіз.
Dialogue: 0,0:04:51.80,0:04:53.80,Default,,0,0,0,,Ni!
Dialogue: 0,0:04:53.80,0:04:55.74,Default,,0,0,0,,Әрине қыз емес
Dialogue: 0,0:04:55.74,0:04:59.08,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:04:55.74,0:04:59.08,Default,,0,0,0,,Менің шатырыма келгің келе ме?
Dialogue: 0,0:04:59.08,0:05:01.08,Default,,0,0,0,,Бұл әрине қызық
Dialogue: 0,0:05:01.08,0:05:03.75,Default,,0,0,0,,А, бұл біраз.
Dialogue: 0,0:05:03.75,0:05:05.75,Default,,0,0,0,,Қанша дана тапсырыс бересіз?
Dialogue: 0,0:05:05.75,0:05:08.08,Default,,0,0,0,,Онда мен 5 билет аламын, LINE арқылы айтыңыз...
Dialogue: 0,0:05:08.08,0:05:10.09,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:05:10.09,0:05:12.09,Default,,0,0,0,,Көңілді сияқты ма? Аға
Dialogue: 0,0:05:12.09,0:05:15.26,Default,,0,0,0,,Балалар сендер де тозақты көресіңдер ме? О?
Dialogue: 0,0:05:15.26,0:05:18.09,Default,,0,0,0,,Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:05:15.26,0:05:18.09,Default,,0,0,0,,Тек жағдайда
Dialogue: 0,0:05:18.09,0:05:20.10,Default,,0,0,0,,Олай болса мен келіп сені тағы шақырамын.
Dialogue: 0,0:05:20.10,0:05:22.77,Default,,0,0,0,,Тұз қосыңыз! тұз!
Dialogue: 0,0:05:20.10,0:05:22.77,Default,,0,0,0,,Аузыңды жап! Артқы заряд!
Dialogue: 0,0:05:22.77,0:05:24.77,Default,,0,0,0,,Екеуміз де аман қалдық.
Dialogue: 0,0:05:24.77,0:05:26.77,Default,,0,0,0,,Һмпф
Dialogue: 0,0:05:24.77,0:05:26.77,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:26.77,0:05:29.61,Default,,0,0,0,,Сонымен дүкен менеджері өзгерді ме?
Dialogue: 0,0:05:26.77,0:05:29.61,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:29.61,0:05:32.27,Default,,0,0,0,,Содан кейін Чи-чан мен Иори
Dialogue: 0,0:05:29.61,0:05:32.27,Default,,0,0,0,,Орын ауыстырамыз ба?
Dialogue: 0,0:05:32.27,0:05:34.78,Default,,0,0,0,,Иә
Dialogue: 0,0:05:34.78,0:05:37.78,Default,,0,0,0,,Маған Кохеймен не болғанын айт.
Dialogue: 0,0:05:34.78,0:05:37.78,Default,,0,0,0,,Боу!
Dialogue: 0,0:05:37.78,0:05:40.62,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:05:37.78,0:05:40.62,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:05:40.62,0:05:43.62,Default,,0,0,0,,Мен және Чиса мұны істейміз.
Dialogue: 0,0:05:40.62,0:05:43.62,Default,,0,0,0,,Азуса-сан, үзіліс алуыңызды өтінемін.
Dialogue: 0,0:05:43.62,0:05:49.29,Default,,0,0,0,,Мен әрқашан дүкенші болдым.
Dialogue: 0,0:05:43.62,0:05:49.29,Default,,0,0,0,,Өтінемін~!
Dialogue: 0,0:05:49.29,0:05:53.63,Default,,0,0,0,,Бұл өте жаман, Чиза.
Dialogue: 0,0:05:49.29,0:05:53.63,Default,,0,0,0,,Мүлдем... және неге?
Dialogue: 0,0:05:53.63,0:05:55.90,Default,,0,0,0,,Аа, не айтайын➡︎
Dialogue: 0,0:05:55.90,0:05:58.73,Default,,0,0,0,,Азуса-санмен жалғыз қалу
Dialogue: 0,0:05:55.90,0:05:58.73,Default,,0,0,0,,Мен одан аулақ болғым келеді.
Dialogue: 0,0:05:58.73,0:06:02.07,Default,,0,0,0,,Хмм…
Dialogue: 0,0:05:58.73,0:06:02.07,Default,,0,0,0,,Ал, Азуса-сан әдемі екен.
Dialogue: 0,0:06:02.07,0:06:04.74,Default,,0,0,0,,Екеуің ғана қобалжисың, солай ма?
Dialogue: 0,0:06:04.74,0:06:07.41,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:06:04.74,0:06:07.41,Default,,0,0,0,,Қобалжу туралы айтатын болсам, мен...
Dialogue: 0,0:06:07.41,0:06:11.58,Default,,0,0,0,,Не? Бұл жарқын жауап
Dialogue: 0,0:06:07.41,0:06:11.58,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:06:11.58,0:06:14.78,Default,,0,0,0,,Иә, кешіріңіз!
Dialogue: 0,0:06:11.58,0:06:14.78,Default,,0,0,0,,Сәл күте тұрыңыз
Dialogue: 0,0:06:19.59,0:06:21.76,Default,,0,0,0,,Айтпақшы, Жұмбақтар сайысы сағат нешеде?
Dialogue: 0,0:06:21.76,0:06:24.59,Default,,0,0,0,,Марапаттау рәсімі ертең сағат 4-тен басталады.
Dialogue: 0,0:06:24.59,0:06:26.60,Default,,0,0,0,,Бүгін түн.
Dialogue: 0,0:06:26.60,0:06:29.93,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:06:26.60,0:06:29.93,Default,,0,0,0,,Ол 600 иен болады
Dialogue: 0,0:06:26.60,0:06:29.93,Default,,0,0,0,,Иә
Dialogue: 0,0:06:29.93,0:06:31.93,Default,,0,0,0,,(Iori/Chisa)
Dialogue: 0,0:06:29.93,0:06:31.93,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:06:33.94,0:06:36.77,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:06:33.94,0:06:36.77,Default,,0,0,0,,Дайын болған дұрыс емес пе?
Dialogue: 0,0:06:36.77,0:06:39.61,Default,,0,0,0,,Мен сол қалпында кетуді жоспарлап отырмын.
Dialogue: 0,0:06:39.61,0:06:43.61,Default,,0,0,0,,Жоқ, Чи Чан
Dialogue: 0,0:06:39.61,0:06:43.61,Default,,0,0,0,,Сүйкімді Чиса-чан➡︎
Dialogue: 0,0:06:43.61,0:06:46.12,Default,,0,0,0,,Көптеген адамдарға
Dialogue: 0,0:06:43.61,0:06:46.12,Default,,0,0,0,,Мен оны көруім керек.
Dialogue: 0,0:06:46.12,0:06:48.95,Default,,0,0,0,,Е...
Dialogue: 0,0:06:46.12,0:06:48.95,Default,,0,0,0,,Бұл тамаша мүмкіндік.
Dialogue: 0,0:06:48.95,0:06:50.95,Default,,0,0,0,,Сәттілік~
Dialogue: 0,0:06:50.95,0:06:54.29,Default,,0,0,0,,Котегава қайда барады?
Dialogue: 0,0:06:50.95,0:06:54.29,Default,,0,0,0,,Бұл Mythcom үшін макияж.
Dialogue: 0,0:06:54.29,0:06:56.89,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:06:54.29,0:06:56.89,Default,,0,0,0,,Менің де жасағанымды қалайсың ба?
Dialogue: 0,0:06:56.89,0:06:59.40,Default,,0,0,0,,Сіз қаншалықты алыссыз?
Dialogue: 0,0:06:56.89,0:06:59.40,Default,,0,0,0,,Сен мені қорлайсың ба?
Dialogue: 0,0:06:59.40,0:07:01.90,Default,,0,0,0,,Өйткені менің шашым ұзын
Dialogue: 0,0:06:59.40,0:07:01.90,Default,,0,0,0,,Әйел сияқты киіну керек!
Dialogue: 0,0:07:01.90,0:07:04.90,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:07:01.90,0:07:04.90,Default,,0,0,0,,Сіз Neta ұясына лайықсыз!
Dialogue: 0,0:07:04.90,0:07:06.90,Default,,0,0,0,,Не! бұл!
Dialogue: 0,0:07:06.90,0:07:10.30,Default,,0,0,0,,Сәлем! Әзірге дүкенді жабыңыз
Dialogue: 0,0:07:06.90,0:07:10.30,Default,,0,0,0,,Яонға барайық!
Dialogue: 0,0:07:16.25,0:07:18.75,Default,,0,0,0,,Ішінде біршама адам бар.
Dialogue: 0,0:07:18.75,0:07:21.92,Default,,0,0,0,,Ал, бұл және еркек жынысы
Dialogue: 0,0:07:18.75,0:07:21.92,Default,,0,0,0,,Өйткені бұл сахнаның орталық бөлігі.
Dialogue: 0,0:07:21.92,0:07:24.59,Default,,0,0,0,,Осыншама көп адамның алдына шығасың ба?
Dialogue: 0,0:07:24.59,0:07:27.59,Default,,0,0,0,,Сен жақсысың, солай емес пе?
Dialogue: 0,0:07:24.59,0:07:27.59,Default,,0,0,0,,Өйткені ол еркек сияқты киінген.
Dialogue: 0,0:07:27.59,0:07:29.59,Default,,0,0,0,,Нета кадрына көңіліңіз толмай ма?
Dialogue: 0,0:07:29.59,0:07:32.09,Default,,0,0,0,,Һмпф
Dialogue: 0,0:07:29.59,0:07:32.09,Default,,0,0,0,,Маған шығудың қажеті жоқ.
Dialogue: 0,0:07:32.09,0:07:34.89,Default,,0,0,0,,Сіз не айтасыз? Қарашы, Иори.
Dialogue: 0,0:07:32.09,0:07:34.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:38.43,0:07:40.94,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:07:40.94,0:07:42.94,Default,,0,0,0,,《Кохеи/Иори: Бұл біртүрлі》
Dialogue: 0,0:07:42.94,0:07:46.44,Default,,0,0,0,,Тіпті басқа шеңберлер
Dialogue: 0,0:07:42.94,0:07:46.44,Default,,0,0,0,,Материалдық жақтауды дайындап қойдыңыз, солай ма?
Dialogue: 0,0:07:46.44,0:07:49.28,Default,,0,0,0,,Айна-чан өте сүйкімді!
Dialogue: 0,0:07:49.28,0:07:52.28,Default,,0,0,0,,Иә! Ах...
Dialogue: 0,0:07:52.28,0:07:55.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:52.28,0:07:55.12,Default,,0,0,0,,Бсен!
Dialogue: 0,0:07:55.12,0:07:57.12,Default,,0,0,0,,Кебат…
Dialogue: 0,0:07:59.05,0:08:01.05,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:08:05.89,0:08:08.73,Default,,0,0,0,,Біртүрлі сезіледі.
Dialogue: 0,0:08:08.73,0:08:10.73,Default,,0,0,0,,Бұл ашулы ма?
Dialogue: 0,0:08:10.73,0:08:13.24,Default,,0,0,0,,Аты-жөніңізді және серіктестік шеңберіңізді енгізіңіз.
Dialogue: 0,0:08:13.24,0:08:15.24,Default,,0,0,0,,Бұл Пик а Будан шыққан Чиса Котегава.
Dialogue: 0,0:08:15.24,0:08:17.24,Default,,0,0,0,,Жоқ, мүмкін
Dialogue: 0,0:08:15.24,0:08:17.24,Default,,0,0,0,,Бұл қобалжыған сияқты.
Dialogue: 0,0:08:17.24,0:08:19.24,Default,,0,0,0,,Сен өте ебедейсің, Котегава.
Dialogue: 0,0:08:19.24,0:08:21.24,Default,,0,0,0,,Бірақ бұл жаман.
Dialogue: 0,0:08:21.24,0:08:23.25,Default,,0,0,0,,Егер бұл жалғаса берсе
Dialogue: 0,0:08:21.24,0:08:23.25,Default,,0,0,0,,Жоғалту мүмкіндігі бар.
Dialogue: 0,0:08:23.25,0:08:25.41,Default,,0,0,0,,Сіздің хоббиіңіз қандай?
Dialogue: 0,0:08:23.25,0:08:25.41,Default,,0,0,0,,Дайвинг
Dialogue: 0,0:08:25.41,0:08:27.75,Default,,0,0,0,,Кохэй, біздің қолымыздан бір нәрсе бар ма?
Dialogue: 0,0:08:27.75,0:08:30.09,Default,,0,0,0,,Сіз бұл ойын түрімен таныссыз ба?
Dialogue: 0,0:08:30.09,0:08:33.92,Default,,0,0,0,,Әрине
Dialogue: 0,0:08:30.09,0:08:33.92,Default,,0,0,0,,Мен бұл ойын түрімен таныспын➡︎
Dialogue: 0,0:08:33.92,0:08:36.43,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:08:33.92,0:08:36.43,Default,,0,0,0,,Үнсіз кейіпкер жарқырап тұрғанда➡︎
Dialogue: 0,0:08:36.43,0:08:38.43,Default,,0,0,0,,Бұл сіз сирек көретін күлкі ме?
Dialogue: 0,0:08:38.43,0:08:41.43,Default,,0,0,0,,Кохеи... Онии-чан
Dialogue: 0,0:08:41.43,0:08:44.93,Default,,0,0,0,,Күлімсіреу...
Dialogue: 0,0:08:41.43,0:08:44.93,Default,,0,0,0,,Чисаны күлдірту өте қиын.
Dialogue: 0,0:08:44.93,0:08:47.94,Default,,0,0,0,,Күлімсіресеңіз
Dialogue: 0,0:08:44.93,0:08:47.94,Default,,0,0,0,,Ұсталғанда күлмейсің бе?
Dialogue: 0,0:08:47.94,0:08:51.27,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:08:47.94,0:08:51.27,Default,,0,0,0,,Чиса!
Dialogue: 0,0:08:51.27,0:08:53.27,Default,,0,0,0,,Хехехехе...
Dialogue: 0,0:08:55.21,0:08:57.21,Default,,0,0,0,,Жоқ! Бұл керісінше әсер етеді!
Dialogue: 0,0:08:57.21,0:08:59.21,Default,,0,0,0,,Яғни
Dialogue: 0,0:08:57.21,0:08:59.21,Default,,0,0,0,,Бұл тұтынушылардың алдында жасамауыңыз керек бет.
Dialogue: 0,0:08:59.21,0:09:03.89,Default,,0,0,0,,Тағы бірдеңе бар ма?
Dialogue: 0,0:08:59.21,0:09:03.89,Default,,0,0,0,,Бұл жай ғана ұят па?
Dialogue: 0,0:09:03.89,0:09:06.72,Default,,0,0,0,,Ұялдың ба...
Dialogue: 0,0:09:03.89,0:09:06.72,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:09:06.72,0:09:09.06,Default,,0,0,0,,Менің білуімше...
Dialogue: 0,0:09:09.06,0:09:11.23,Default,,0,0,0,,Енді шеңбермен таныстырайық...
Dialogue: 0,0:09:11.23,0:09:13.23,Default,,0,0,0,,Чиса!
Dialogue: 0,0:09:19.40,0:09:23.07,Default,,0,0,0,,Ұят болма
Dialogue: 0,0:09:19.40,0:09:23.07,Default,,0,0,0,,Бұл біртүрлі. Әдетте осында...
Dialogue: 0,0:09:23.07,0:09:25.07,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:23.07,0:09:25.07,Default,,0,0,0,,Сіз қаншалықты әдемісіз?
Ол
Dialogue: 0,0:09:25.07,0:09:27.08,Default,,0,0,0,,болуы керек
Dialogue: 0,0:09:27.08,0:09:29.58,Default,,0,0,0,,Қоқысқа қарайтын сол көздер.
Dialogue: 0,0:09:27.08,0:09:29.58,Default,,0,0,0,,Бұл да сәтсіздік.
Dialogue: 0,0:09:29.58,0:09:31.91,Default,,0,0,0,,-ге келетін болсақ, қалғаны дәл солай.
Dialogue: 0,0:09:29.58,0:09:31.91,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:31.91,0:09:34.75,Default,,0,0,0,,Бүгінгі киім
Dialogue: 0,0:09:31.91,0:09:34.75,Default,,0,0,0,,Жарайды! Бұл юбка
Dialogue: 0,0:09:34.75,0:09:37.09,Default,,0,0,0,,А... айтудың қажеті жоқ.
Dialogue: 0,0:09:37.09,0:09:40.26,Default,,0,0,0,,Неліктен хабарланады?
Dialogue: 0,0:09:37.09,0:09:40.26,Default,,0,0,0,,Сіздің ойларыңыз біртүрлі.
Dialogue: 0,0:09:40.26,0:09:42.42,Default,,0,0,0,,Мәселе мынада
Dialogue: 0,0:09:40.26,0:09:42.42,Default,,0,0,0,,Оны қалай аударамын...
Dialogue: 0,0:09:42.42,0:09:45.26,Default,,0,0,0,,Мынаны қараңыз!
Dialogue: 0,0:09:42.42,0:09:45.26,Default,,0,0,0,,Супербол?
Dialogue: 0,0:09:45.26,0:09:47.26,Default,,0,0,0,,Сен оны Чисаның аяғына лақтырасың ба?
Dialogue: 0,0:09:47.26,0:09:49.43,Default,,0,0,0,,Иә! Бұл ұят
Dialogue: 0,0:09:49.43,0:09:52.43,Default,,0,0,0,,Қараймын, бастауыш сынып оқушылары.
Dialogue: 0,0:09:49.43,0:09:52.43,Default,,0,0,0,,Бұл жай еркелік.
Dialogue: 0,0:09:52.43,0:09:55.44,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,0:09:52.43,0:09:55.44,Default,,0,0,0,,Бұл Чисаның ашуын келтірер еді...
Dialogue: 0,0:09:55.44,0:09:58.44,Default,,0,0,0,,That's right.
Dialogue: 0,0:09:55.44,0:09:58.44,Default,,0,0,0,,Қылмыскер Иори өлтірілуі мүмкін.
Dialogue: 0,0:09:58.44,0:10:00.78,Default,,0,0,0,,Неліктен мен мұны істеймін?
Dialogue: 0,0:09:58.44,0:10:00.78,Default,,0,0,0,,Бұл расталды ма?
Dialogue: 0,0:10:00.78,0:10:04.28,Default,,0,0,0,,Чиса-чан туралы ойлағанда, көз алдыңызға Иори келеді, солай емес пе?
Dialogue: 0,0:10:00.78,0:10:04.28,Default,,0,0,0,,Тым болмаса жүйелі түрде шешіп алайық.
Dialogue: 0,0:10:04.28,0:10:07.28,Default,,0,0,0,,Жақсырақ жол бар
Dialogue: 0,0:10:04.28,0:10:07.28,Default,,0,0,0,,Уг!?
Dialogue: 0,0:10:07.28,0:10:09.28,Default,,0,0,0,,Барлығы бір уақытта лақтырады➡︎
Dialogue: 0,0:10:09.28,0:10:11.95,Default,,0,0,0,,Қылмыскерді анықтамау деген нені білдіреді?
Dialogue: 0,0:10:09.28,0:10:11.95,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:11.95,0:10:14.29,Default,,0,0,0,,Сізге
Dialogue: 0,0:10:11.95,0:10:14.29,Default,,0,0,0,,Жақсы идея!
Dialogue: 0,0:10:14.29,0:10:17.29,Default,,0,0,0,,Олай болса, кеттік!
Dialogue: 0,0:10:17.29,0:10:20.80,Default,,0,0,0,,Кеттік! Ия... Се!
Dialogue: 0,0:10:20.80,0:10:22.80,Default,,0,0,0,,Не?!
Dialogue: 0,0:10:26.97,0:10:28.97,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:10:28.97,0:10:30.97,Default,,0,0,0,,Жақсы! Бұл жақсы сезінеді!
Dialogue: 0,0:10:28.97,0:10:30.97,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:10:30.97,0:10:32.98,Default,,0,0,0,,♬~
Dialogue: 0,0:10:32.98,0:10:36.48,Default,,0,0,0,,Ах... ха...
Dialogue: 0,0:10:36.48,0:10:38.48,Default,,0,0,0,,(ысырма дыбысы)
Dialogue: 0,0:10:38.48,0:10:40.48,Default,,0,0,0,,Жақсы бақылау, Иори!
Dialogue: 0,0:10:40.48,0:10:43.49,Default,,0,0,0,,Ақыр соңында, осындай нәрсе
Dialogue: 0,0:10:40.48,0:10:43.49,Default,,0,0,0,,Мұны тек сіз жасай аласыз!
Dialogue: 0,0:10:43.49,0:10:47.66,Default,,0,0,0,,Маған қалдырыңызшы! иә?
Dialogue: 0,0:10:47.66,0:10:50.66,Default,,0,0,0,,Мм, жақсысың ба?
Dialogue: 0,0:10:50.66,0:10:53.66,Default,,0,0,0,,Иә! неге
Dialogue: 0,0:10:50.66,0:10:53.66,Default,,0,0,0,,Бәрің лақтырмайсыңдар ма?
Dialogue: 0,0:10:56.10,0:10:59.10,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:11:07.61,0:11:11.95,Default,,0,0,0,,Бірден өлім жазасына кесілсе ше?
Dialogue: 0,0:11:07.61,0:11:11.95,Default,,0,0,0,,Бір ғана нәрсе...
Dialogue: 0,0:11:11.95,0:11:13.95,Default,,0,0,0,,(солқылдаған бұталардың дыбысы)
Dialogue: 0,0:11:13.95,0:11:16.29,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:13.95,0:11:16.29,Default,,0,0,0,,О, елес!
Dialogue: 0,0:11:16.29,0:11:20.46,Default,,0,0,0,,Егер есімде дұрыс болса, сен жұмбақ сайысында болдың... балақай?
Dialogue: 0,0:11:20.46,0:11:23.46,Default,,0,0,0,,Эй, сен...
Dialogue: 0,0:11:20.46,0:11:23.46,Default,,0,0,0,,Не?
Dialogue: 0,0:11:23.46,0:11:27.36,Default,,0,0,0,,Менімен бірге бол
Dialogue: 0,0:11:23.46,0:11:27.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:30.30,0:11:32.63,Default,,0,0,0,,Сен екеуміз бірге шығамыз ба?
Dialogue: 0,0:11:32.63,0:11:34.64,Default,,0,0,0,,Иә, шағымыңыз бар ма?
Dialogue: 0,0:11:34.64,0:11:36.97,Default,,0,0,0,,(Танжиро) Тұр, тұр! Тоқта, Иносукэ~!
Dialogue: 0,0:11:34.64,0:11:36.97,Default,,0,0,0,,Аты-жөнін де білмейтін адамға...
Dialogue: 0,0:11:36.97,0:11:39.14,Default,,0,0,0,,Мана Йошивара! Жастық шақ
Dialogue: 0,0:11:39.14,0:11:41.48,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:11:39.14,0:11:41.48,Default,,0,0,0,,Мүлдем жақсы емес
Dialogue: 0,0:11:41.48,0:11:44.81,Default,,0,0,0,,Құттықтаймыз Кохеи
Dialogue: 0,0:11:41.48,0:11:44.81,Default,,0,0,0,,Мәңгілік бақытты бол
Dialogue: 0,0:11:44.81,0:11:47.32,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:11:47.32,0:11:49.82,Default,,0,0,0,,Жас жігіттер екеуің ғана болар деп ойладым.
Dialogue: 0,0:11:49.82,0:11:53.66,Default,,0,0,0,,Мені мұндай жағдайда қалдыруға қалай дәтің бар?
Dialogue: 0,0:11:49.82,0:11:53.66,Default,,0,0,0,,Сізде адамның жүрегі жоқ па?
Dialogue: 0,0:11:53.66,0:11:57.76,Default,,0,0,0,,Сіз жай ғана сабырмен сөзімді кесіп тастадыңыз.
Dialogue: 0,0:11:53.66,0:11:57.76,Default,,0,0,0,,Кузу не дейді!
Dialogue: 0,0:11:57.76,0:11:59.76,Default,,0,0,0,,Қоғамдық махаббат хатынан бері —
Dialogue: 0,0:11:59.76,0:12:01.76,Default,,0,0,0,,Хмм… Уф
Dialogue: 0,0:12:01.76,0:12:05.10,Default,,0,0,0,,Балалар сендер осындай жерде болдыңдар ма?
Dialogue: 0,0:12:01.76,0:12:05.10,Default,,0,0,0,,Сіз не істеп жүрсіз?
Dialogue: 0,0:12:05.10,0:12:09.44,Default,,0,0,0,,Жастар... дұрыс па?
Dialogue: 0,0:12:05.10,0:12:09.44,Default,,0,0,0,,Бұл жара мен қазып алынған топырақ неден?
Dialogue: 0,0:12:09.44,0:12:11.44,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:14.11,0:12:17.28,Default,,0,0,0,,А... бұл дұрыс емес адам.
Dialogue: 0,0:12:17.28,0:12:19.45,Default,,0,0,0,,Мен әлі ештеңе айтқан жоқпын.
Dialogue: 0,0:12:19.45,0:12:22.95,Default,,0,0,0,,Бұл дұрыс емес, Чиза! Яғни
Dialogue: 0,0:12:19.45,0:12:22.95,Default,,0,0,0,,Өзіңіздің сүйкімділігіңізді көрсету үшін➡︎
Dialogue: 0,0:12:22.95,0:12:24.95,Default,,0,0,0,,Басқаша айтқанда, сүйкімді Чиса
Dialogue: 0,0:12:22.95,0:12:24.95,Default,,0,0,0,,Мен сізге көрсеткім келеді...
Dialogue: 0,0:12:24.95,0:12:26.96,Default,,0,0,0,,Хмм, жеткілікті.
Dialogue: 0,0:12:26.96,0:12:30.13,Default,,0,0,0,,Иә? Мені кешіресің бе?
Dialogue: 0,0:12:30.13,0:12:34.13,Default,,0,0,0,,Оны маған қарызға бер
Dialogue: 0,0:12:30.13,0:12:34.13,Default,,0,0,0,,Seriously! Рахмет Чиса!
Dialogue: 0,0:12:34.13,0:12:36.30,Default,,0,0,0,,Тағы да рахмет
Dialogue: 0,0:12:34.13,0:12:36.30,Default,,0,0,0,,Underwear with a bit more sex appeal➡︎
Dialogue: 0,0:12:36.30,0:12:38.30,Default,,0,0,0,,I'll buy it for you!
Dialogue: 0,0:12:38.30,0:12:40.30,Default,,0,0,0,,Even though I was forgiven...
Dialogue: 0,0:12:40.30,0:12:43.97,Default,,0,0,0,,Or rather, what to look at is
Dialogue: 0,0:12:40.30,0:12:43.97,Default,,0,0,0,,You saw that, you pervert!
Dialogue: 0,0:12:43.97,0:12:48.97,Default,,0,0,0,,Chisa? Мүмкін
Dialogue: 0,0:12:43.97,0:12:48.97,Default,,0,0,0,,Are you really angry?
Dialogue: 0,0:12:50.98,0:12:52.98,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:12:52.98,0:12:55.58,Default,,0,0,0,,Uh... Thank you for the meal.
Dialogue: 0,0:12:55.58,0:12:57.92,Default,,0,0,0,,About 2 liters came out!
Dialogue: 0,0:12:57.92,0:13:00.76,Default,,0,0,0,,Сіз өзіңіздің қайсарлығыңызды көрсеттіңіз.
Dialogue: 0,0:12:57.92,0:13:00.76,Default,,0,0,0,,As expected of Iori!
Dialogue: 0,0:13:20.27,0:13:23.27,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:13:20.27,0:13:23.27,Default,,0,0,0,,(Серо) «Өте жылдам адам» деген лақап ат тек сән үшін ғана емес қой?
Dialogue: 0,0:13:23.27,0:13:25.27,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:13:25.27,0:13:27.61,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:13:25.27,0:13:27.61,Default,,0,0,0,,Мен табанды қызға ғашық болдым
Dialogue: 0,0:13:27.61,0:13:29.61,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:13:29.61,0:13:31.61,Default,,0,0,0,,Ah, well.
Dialogue: 0,0:13:31.61,0:13:34.28,Default,,0,0,0,,((See, you promised at noon.
Dialogue: 0,0:13:34.28,0:13:36.28,Default,,0,0,0,,Сізде алдын ала міндеттеме бар, солай ма?
Dialogue: 0,0:13:36.28,0:13:38.95,Default,,0,0,0,,Жақсы, алдын ала жазылыңыз.
Dialogue: 0,0:13:36.28,0:13:38.95,Default,,0,0,0,,Бұл бәрібір, солай ма?
Dialogue: 0,0:13:38.95,0:13:40.95,Default,,0,0,0,,《Taku…》
Dialogue: 0,0:13:40.95,0:13:44.46,Default,,0,0,0,,Сәлем саған
Dialogue: 0,0:13:40.95,0:13:44.46,Default,,0,0,0,,Сіз «Мистер» байқауына қатыспайсыз ба?
Dialogue: 0,0:13:44.46,0:13:48.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:44.46,0:13:48.46,Default,,0,0,0,,Мен оны биылғы жылы жасөспірімдерге қалдырсам ба деп ойлаймын.
Dialogue: 0,0:13:48.46,0:13:50.46,Default,,0,0,0,,Жер
Dialogue: 0,0:13:48.46,0:13:50.46,Default,,0,0,0,,Менің көрінгенімді көргіңіз келе ме?
Dialogue: 0,0:13:50.46,0:13:53.80,Default,,0,0,0,,Көргім келеді Көргім келеді
Dialogue: 0,0:13:50.46,0:13:53.80,Default,,0,0,0,,Алдыңғы қатардан қол шапалақтау
Dialogue: 0,0:13:53.80,0:13:56.14,Default,,0,0,0,,Менің таңдауым жоқ))
Dialogue: 0,0:13:56.14,0:13:58.97,Default,,0,0,0,,айтыңыз
Dialogue: 0,0:13:56.14,0:13:58.97,Default,,0,0,0,,Мен тіркеліп жатқанда ол қашып кетті.
Dialogue: 0,0:13:58.97,0:14:00.97,Default,,0,0,0,,Азуса-сан күткендей
Dialogue: 0,0:14:00.97,0:14:03.31,Default,,0,0,0,,Сіз маған қолдау көрсетесіз бе?
Dialogue: 0,0:14:00.97,0:14:03.31,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:14:03.31,0:14:06.31,Default,,0,0,0,,Hide
Dialogue: 0,0:14:03.31,0:14:06.31,Default,,0,0,0,,Жарайды, сенің аман болғаныңа қуаныштымын.
Dialogue: 0,0:14:06.31,0:14:09.32,Default,,0,0,0,,Мен оны кездесуге уақытында жасадым.
Dialogue: 0,0:14:06.31,0:14:09.32,Default,,0,0,0,,Міне~
Dialogue: 0,0:14:09.32,0:14:13.65,Default,,0,0,0,,Иә? Gathering?
Dialogue: 0,0:14:09.32,0:14:13.65,Default,,0,0,0,,Иә! Уәде бойынша саған қонаққа келдім!
Dialogue: 0,0:14:13.65,0:14:15.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:15.59,0:14:19.39,Default,,0,0,0,,Иә, қуанышты шу шығармаңыз!
Dialogue: 0,0:14:15.59,0:14:19.39,Default,,0,0,0,,Iori! Кохеи!
Dialogue: 0,0:14:21.43,0:14:24.26,Default,,0,0,0,,More than usual
Dialogue: 0,0:14:21.43,0:14:24.26,Default,,0,0,0,,Қандай тамаша ішімдік кеші.
Dialogue: 0,0:14:24.26,0:14:26.77,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:14:24.26,0:14:26.77,Default,,0,0,0,,Уг!?
Dialogue: 0,0:14:26.77,0:14:28.93,Default,,0,0,0,,Сіз...
Dialogue: 0,0:14:28.93,0:14:31.44,Default,,0,0,0,,Уф, сен...
Dialogue: 0,0:14:31.44,0:14:33.44,Default,,0,0,0,,Тоқта... Күт, күт, күт!
Dialogue: 0,0:14:36.11,0:14:38.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:36.11,0:14:38.44,Default,,0,0,0,,Не... неге мен?
Dialogue: 0,0:14:38.44,0:14:40.45,Default,,0,0,0,,Теннисшілермен
Dialogue: 0,0:14:38.44,0:14:40.45,Default,,0,0,0,,Мен оны ішуім керек пе?
Dialogue: 0,0:14:40.45,0:14:42.62,Default,,0,0,0,,А? Не?
Dialogue: 0,0:14:42.62,0:14:44.62,Default,,0,0,0,,Мен саған не үшін айттым?
Dialogue: 0,0:14:44.62,0:14:47.95,Default,,0,0,0,,Мен сыныпқа барып қарап келейін.
Dialogue: 0,0:14:44.62,0:14:47.95,Default,,0,0,0,,Уф, алкогольдің иісі бар...
Dialogue: 0,0:14:47.95,0:14:51.46,Default,,0,0,0,,Өйткені сен әдемісің
Dialogue: 0,0:14:47.95,0:14:51.46,Default,,0,0,0,,Анықталған Румон
Dialogue: 0,0:14:51.46,0:14:56.13,Default,,0,0,0,,Менің ойымша, бұл теннисші.
Dialogue: 0,0:14:51.46,0:14:56.13,Default,,0,0,0,,Сұлу жігіттер тобы кірді.
Dialogue: 0,0:14:56.13,0:14:58.96,Default,,0,0,0,,Егер сіз жігітті жасасаңыз
Dialogue: 0,0:14:56.13,0:14:58.96,Default,,0,0,0,,Сіз бақытты бола аласыз
Dialogue: 0,0:14:58.96,0:15:02.13,Default,,0,0,0,,Кітапта көрдім
Dialogue: 0,0:14:58.96,0:15:02.13,Default,,0,0,0,,Мен қызғылт университет өмірін қалаймын
Dialogue: 0,0:15:02.13,0:15:06.47,Default,,0,0,0,,Бірақ... айтыңызшы!
Dialogue: 0,0:15:06.47,0:15:09.31,Default,,0,0,0,,Неліктен біз әрқашан осындамыз?
Dialogue: 0,0:15:06.47,0:15:09.31,Default,,0,0,0,,Когенато~
Dialogue: 0,0:15:09.31,0:15:12.65,Default,,0,0,0,,Бұл аралас сусын ба?
Dialogue: 0,0:15:09.31,0:15:12.65,Default,,0,0,0,,Бір бірімен біте қайнасып кеткен біртүрлі.
Dialogue: 0,0:15:12.65,0:15:14.75,Default,,0,0,0,,Барымызды салайық, солай ма?
Dialogue: 0,0:15:14.75,0:15:17.25,Default,,0,0,0,,Дұрыс? Қатты тырысайық, жарай ма?
Dialogue: 0,0:15:17.25,0:15:20.42,Default,,0,0,0,,Мен өлсем бола ма?
Dialogue: 0,0:15:17.25,0:15:20.42,Default,,0,0,0,,Бұл, әрине, таңқаларлық болды, жаман мағынада.
Dialogue: 0,0:15:20.42,0:15:23.42,Default,,0,0,0,,Макияж да дәл осылай орындалады
Dialogue: 0,0:15:20.42,0:15:23.42,Default,,0,0,0,,Зерттеу➡︎
Dialogue: 0,0:15:23.42,0:15:26.59,Default,,0,0,0,,Бейтаныс киім киген...
Dialogue: 0,0:15:26.59,0:15:28.76,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, сонымен қатар қолыңнан келгеннің бәрін істе➡︎
Dialogue: 0,0:15:28.76,0:15:31.26,Default,,0,0,0,,Не! Маған қоңырау шал, сен бейбақсың!
Dialogue: 0,0:15:31.26,0:15:33.93,Default,,0,0,0,,Бұл фильм немесе драма емес еді!
Dialogue: 0,0:15:31.26,0:15:33.93,Default,,0,0,0,,Согенамон!
Dialogue: 0,0:15:33.93,0:15:36.60,Default,,0,0,0,,Ал...
Dialogue: 0,0:15:33.93,0:15:36.60,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:15:36.60,0:15:38.60,Default,,0,0,0,,Қайда? Огимото-яда екен ғой.
Dialogue: 0,0:15:38.60,0:15:41.77,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:38.60,0:15:41.77,Default,,0,0,0,,Мені бәрінің мазақ еткенін қаламаймын!?
Dialogue: 0,0:15:41.77,0:15:44.94,Default,,0,0,0,,Барлығы?
Dialogue: 0,0:15:41.77,0:15:44.94,Default,,0,0,0,,Тимбел балалары?
Dialogue: 0,0:15:44.94,0:15:46.95,Default,,0,0,0,,Міне, солай көрінеді.
Dialogue: 0,0:15:46.95,0:15:49.11,Default,,0,0,0,,Түсті зат ретінде қарастырылса да
Dialogue: 0,0:15:46.95,0:15:49.11,Default,,0,0,0,,Бұл ақылға қонымсыз.
Dialogue: 0,0:15:49.11,0:15:51.95,Default,,0,0,0,,Алдымен барлығы
Dialogue: 0,0:15:49.11,0:15:51.95,Default,,0,0,0,,«Өте сүйкімді»...
Dialogue: 0,0:15:51.95,0:15:54.12,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:51.95,0:15:54.12,Default,,0,0,0,,Сіз қатты күлетін едіңіз!
Dialogue: 0,0:15:54.12,0:15:56.62,Default,,0,0,0,,Ха...
Dialogue: 0,0:15:54.12,0:15:56.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:54.12,0:15:56.62,Default,,0,0,0,,Мен айттым.
Dialogue: 0,0:15:56.62,0:15:59.12,Default,,0,0,0,,Мм... ауырып қалдың ба?
Dialogue: 0,0:15:59.12,0:16:01.96,Default,,0,0,0,,Біз мұны да түсінеміз.
Dialogue: 0,0:16:01.96,0:16:05.30,Default,,0,0,0,,Алдымен
Dialogue: 0,0:16:01.96,0:16:05.30,Default,,0,0,0,,Мен мұны әзіл ретінде қабылдаған дұрыс деп ойладым.
Dialogue: 0,0:16:05.30,0:16:08.47,Default,,0,0,0,,Екеуміз жарасып, көңіл көтерсек
Dialogue: 0,0:16:05.30,0:16:08.47,Default,,0,0,0,,Әлі де
Dialogue: 0,0:16:08.47,0:16:11.30,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:08.47,0:16:11.30,Default,,0,0,0,,Бұл шынымен де қалағаныңыз емес пе?
Dialogue: 0,0:16:11.30,0:16:16.24,Default,,0,0,0,,Бірақ сол балалар жұмбақ сайысын аяқтады.
Dialogue: 0,0:16:11.30,0:16:16.24,Default,,0,0,0,,Ішетін кешке келгенде...
Dialogue: 0,0:16:16.24,0:16:19.41,Default,,0,0,0,,((Кудо: Мен жеткілікті күлдім.
Dialogue: 0,0:16:16.24,0:16:19.41,Default,,0,0,0,,Үйге бара аласыз))
Dialogue: 0,0:16:19.41,0:16:21.91,Default,,0,0,0,,Цукуёми-кун мен Каэрубүки-санға қандай сынақтар қойылған?
Dialogue: 0,0:16:21.91,0:16:26.09,Default,,0,0,0,,Өзіңізді өзгертуге мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:16:21.91,0:16:26.09,Default,,0,0,0,,Мен мұны істемеуім керек еді.
Dialogue: 0,0:16:26.09,0:16:32.93,Default,,0,0,0,,Ақырында не істесем де, күліп аламын.
Dialogue: 0,0:16:26.09,0:16:32.93,Default,,0,0,0,,Олар күледі
Dialogue: 0,0:16:32.93,0:16:36.10,Default,,0,0,0,,Сен... сен...
Dialogue: 0,0:16:32.93,0:16:36.10,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:16:36.10,0:16:40.10,Default,,0,0,0,,Адамдарға жай ғана күліңіз
Dialogue: 0,0:16:36.10,0:16:40.10,Default,,0,0,0,,Адамдар маған күледі➡︎
Dialogue: 0,0:16:40.10,0:16:43.27,Default,,0,0,0,,Олардың бұл жерде болуы мүмкін емес.
Dialogue: 0,0:16:40.10,0:16:43.27,Default,,0,0,0,,Кім шалбарын шылаған, сен, қанды шошқа!
Dialogue: 0,0:16:43.27,0:16:45.57,Default,,0,0,0,,Мен саған бір қызық көрсетемін!
Dialogue: 0,0:16:51.94,0:16:54.95,Default,,0,0,0,,Керемет! үлкен! Мен ашуландым!
Dialogue: 0,0:16:54.95,0:17:00.29,Default,,0,0,0,,Сіздің отбасыңызда жыл сайын ерлер сайысы өтеді.
Dialogue: 0,0:16:54.95,0:17:00.29,Default,,0,0,0,,Сіз оны бодибилдинг турнирімен шатастырмайсыз ба?
Dialogue: 0,0:17:00.29,0:17:03.96,Default,,0,0,0,,Балалар, маған айтқандарыңды қаламаймын.
Dialogue: 0,0:17:00.29,0:17:03.96,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:17:03.96,0:17:05.96,Default,,0,0,0,,Иә, бұл келесі!
Dialogue: 0,0:17:05.96,0:17:09.63,Default,,0,0,0,,Бұл Кудо, Tennis Circle Tinkerbel төрағасы.
Dialogue: 0,0:17:05.96,0:17:09.63,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:17:09.63,0:17:12.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:12.13,0:17:14.13,Default,,0,0,0,,Олай болса өзіңізді PR жасай аласыз.
Dialogue: 0,0:17:14.13,0:17:17.24,Default,,0,0,0,,Тиісті.
Dialogue: 0,0:17:14.13,0:17:17.24,Default,,0,0,0,,Өйткені мен ер адаммен айналысамын.
Dialogue: 0,0:17:17.24,0:17:19.57,Default,,0,0,0,,Сәттілік Кудо-сан!
Dialogue: 0,0:17:19.57,0:17:23.08,Default,,0,0,0,,Төраға!
Dialogue: 0,0:17:19.57,0:17:23.08,Default,,0,0,0,,Биыл да оңай жеңе аламыз!
Dialogue: 0,0:17:23.08,0:17:26.58,Default,,0,0,0,,《Бұл анық.
Dialogue: 0,0:17:23.08,0:17:26.58,Default,,0,0,0,,Деңгейі басқалардан ерекшеленеді》
Dialogue: 0,0:17:26.58,0:17:28.58,Default,,0,0,0,,сәйкес,
Dialogue: 0,0:17:31.08,0:17:34.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:31.08,0:17:34.09,Default,,0,0,0,,Әдемі!
Dialogue: 0,0:17:31.08,0:17:34.09,Default,,0,0,0,,Бірақ неге форма?
Dialogue: 0,0:17:34.09,0:17:36.09,Default,,0,0,0,,《Жалаңаш ақымақтар болды ма?
Dialogue: 0,0:17:34.09,0:17:36.09,Default,,0,0,0,,Мұндай нәрсе》
Dialogue: 0,0:17:36.09,0:17:38.09,Default,,0,0,0,,Бұл Пик а Будан шыққан Кохеи Имамура.
Dialogue: 0,0:17:38.09,0:17:41.09,Default,,0,0,0,,《Жарайды.
Dialogue: 0,0:17:38.09,0:17:41.09,Default,,0,0,0,,Менің жеңісім өзгермейді.
Dialogue: 0,0:17:41.09,0:17:44.26,Default,,0,0,0,,Енді, PR...
Dialogue: 0,0:17:44.26,0:17:46.93,Default,,0,0,0,,Ум...
Dialogue: 0,0:17:44.26,0:17:46.93,Default,,0,0,0,,Азуса Хамаока!
Dialogue: 0,0:17:46.93,0:17:51.10,Default,,0,0,0,,Тимбердің төрағасы Кудо емес.
Dialogue: 0,0:17:46.93,0:17:51.10,Default,,0,0,0,,Менімен бірге болыңыз!
Dialogue: 0,0:17:51.10,0:17:55.11,Default,,0,0,0,,Ой! Бұл Имамура-сан
Dialogue: 0,0:17:51.10,0:17:55.11,Default,,0,0,0,,Кенеттен мойындау!
Dialogue: 0,0:17:55.11,0:17:57.11,Default,,0,0,0,,《Тч, бұл ерекше...
Dialogue: 0,0:17:57.11,0:17:59.81,Default,,0,0,0,,Рұқсатсыз не істеу керек?
Dialogue: 0,0:17:57.11,0:17:59.81,Default,,0,0,0,,Мен біреудің атын пайдаланып жатырмын》
Dialogue: 0,0:18:02.11,0:18:04.45,Default,,0,0,0,,Жоқ, маған беріңізші.
Dialogue: 0,0:18:04.45,0:18:08.12,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:18:04.45,0:18:08.12,Default,,0,0,0,,Төраға Кудо да келесісін мойындады!
Dialogue: 0,0:18:08.12,0:18:10.12,Default,,0,0,0,,Дегенмен, жай кешіру ұзақ мерзімде саған еш пайда әкелмейді.
Dialogue: 0,0:18:12.12,0:18:16.40,Default,,0,0,0,,Енді қайсысын таңдайсың?
Dialogue: 0,0:18:16.40,0:18:20.07,Default,,0,0,0,,О! Бұл Төраға Кудо!
Dialogue: 0,0:18:20.07,0:18:22.74,Default,,0,0,0,,Жарыс басталмас бұрын Қвиркіңді қолданба! Өзіңді шаршатпа!
Dialogue: 0,0:18:20.07,0:18:22.74,Default,,0,0,0,,Бұл оқиға болды
Dialogue: 0,0:18:22.74,0:18:25.90,Default,,0,0,0,,Дегенмен, әр адамның өзi бар
Dialogue: 0,0:18:22.74,0:18:25.90,Default,,0,0,0,,Деңгейлер бар➡︎
Dialogue: 0,0:18:25.90,0:18:29.91,Default,,0,0,0,,Сізге сәйкес келетін адам бар
Dialogue: 0,0:18:25.90,0:18:29.91,Default,,0,0,0,,Мүмкін бар шығар?
Dialogue: 0,0:18:29.91,0:18:33.08,Default,,0,0,0,,Саған жарасатын адам... Эй
Dialogue: 0,0:18:33.08,0:18:37.08,Default,,0,0,0,,Фуфуфуфу…
Dialogue: 0,0:18:37.08,0:18:40.09,Default,,0,0,0,,Ахахаха! Гахахахаха!
Dialogue: 0,0:18:40.09,0:18:44.26,Default,,0,0,0,,Өте өкінішті! Бұл еркек!
Dialogue: 0,0:18:44.26,0:18:46.26,Default,,0,0,0,,Жоқ, түсінемін.
Dialogue: 0,0:18:46.26,0:18:48.43,Default,,0,0,0,,Мен мұндай боламын деп ешқашан ойламадым
Dialogue: 0,0:18:46.26,0:18:48.43,Default,,0,0,0,,Әлемнің президенті Тимбельмен➡︎
Dialogue: 0,0:18:48.43,0:18:51.26,Default,,0,0,0,,Сіз бірге өте жақсы көрінесіз!
Dialogue: 0,0:18:48.43,0:18:51.26,Default,,0,0,0,,Саған жақсылық, Китахара!
Dialogue: 0,0:18:51.26,0:18:54.43,Default,,0,0,0,,Сіздің айқас киінуіңіз
Dialogue: 0,0:18:51.26,0:18:54.43,Default,,0,0,0,,Бұл кісінің сүйкімділігімен пара-пар сияқты!
Dialogue: 0,0:18:54.43,0:18:56.77,Default,,0,0,0,,Сонымен
Dialogue: 0,0:18:54.43,0:18:56.77,Default,,0,0,0,,Боо Иори Китахараны қараңыз➡︎
Dialogue: 0,0:18:56.77,0:18:58.94,Default,,0,0,0,,Мен ерлер сайысына секіріп, қатысамын!
Dialogue: 0,0:18:58.94,0:19:01.77,Default,,0,0,0,,Гахахахаха!
Dialogue: 0,0:18:58.94,0:19:01.77,Default,,0,0,0,,Олар мұны істеді!
Dialogue: 0,0:19:01.77,0:19:03.78,Default,,0,0,0,,Мен орта мектепте оқып жүргенде бір сыныптасымның —
Dialogue: 0,0:19:01.77,0:19:03.78,Default,,0,0,0,,Бір минут күтіңіз! мен...
Dialogue: 0,0:19:03.78,0:19:07.95,Default,,0,0,0,,Жоқ, мен не істеуім керек!
Dialogue: 0,0:19:03.78,0:19:07.95,Default,,0,0,0,,Төраға мені мойындады.
Dialogue: 0,0:19:07.95,0:19:10.28,Default,,0,0,0,,Бұл көңілсіз, бірақ мен кері шегінемін.
Dialogue: 0,0:19:10.28,0:19:13.79,Default,,0,0,0,,Суенага мырза
Dialogue: 0,0:19:10.28,0:19:13.79,Default,,0,0,0,,Бізге қосылыңыз!
Dialogue: 0,0:19:13.79,0:19:16.89,Default,,0,0,0,,Сәлем! не? Сол жігіт
Dialogue: 0,0:19:13.79,0:19:16.89,Default,,0,0,0,,Кудо мырза, сіз нені айтып тұрсыз?
Dialogue: 0,0:19:16.89,0:19:18.89,Default,,0,0,0,,Тч, бұл дұрыс емес! Бұл...
Dialogue: 0,0:19:18.89,0:19:22.73,Default,,0,0,0,,Иә, төраға.
Dialogue: 0,0:19:18.89,0:19:22.73,Default,,0,0,0,,Мен жеткілікті күлдім...
Dialogue: 0,0:19:22.73,0:19:24.73,Default,,0,0,0,,Үйге бара аласыз.
Dialogue: 0,0:19:28.40,0:19:31.40,Default,,0,0,0,,Не? Күлкілі емес пе?
Dialogue: 0,0:19:35.91,0:19:38.41,Default,,0,0,0,,Сіз мұны істедіңіз.
Dialogue: 0,0:19:41.25,0:19:43.25,Default,,0,0,0,,Ах~
Dialogue: 0,0:19:43.25,0:19:47.92,Default,,0,0,0,,Құттықтаймыз! Ерлер мен әйелдер арасындағы екі сайысқа қол жеткіздік!
Dialogue: 0,0:19:47.92,0:19:49.92,Default,,0,0,0,,Жоқ, ахахха...
Dialogue: 0,0:19:49.92,0:19:53.43,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:19:49.92,0:19:53.43,Default,,0,0,0,,Тост ішейік! Сәлем!
Dialogue: 0,0:19:53.43,0:19:55.43,Default,,0,0,0,,Раковина!?
Dialogue: 0,0:19:55.43,0:19:57.76,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:19:55.43,0:19:57.76,Default,,0,0,0,,Бұл тост ыдысы емес...
Dialogue: 0,0:19:57.76,0:20:00.10,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:20:00.10,0:20:05.27,Default,,0,0,0,,Мм...не айтайын...
Dialogue: 0,0:20:05.27,0:20:07.77,Default,,0,0,0,,Не?Бұл
Dialogue: 0,0:20:07.77,0:20:11.28,Default,,0,0,0,,Көріп отырғаныңыздай?
Dialogue: 0,0:20:07.77,0:20:11.28,Default,,0,0,0,,Үлкенірек ыдыс алғыңыз келе ме?
Dialogue: 0,0:20:11.28,0:20:13.61,Default,,0,0,0,,О... жоқ, мен...
Dialogue: 0,0:20:13.61,0:20:15.61,Default,,0,0,0,,Өйткені, ішетін болсаң, адам көп болуы керек.
Dialogue: 0,0:20:15.61,0:20:17.61,Default,,0,0,0,,Тұрма, отыр
Dialogue: 0,0:20:19.79,0:20:22.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:22.29,0:20:26.63,Default,,0,0,0,,Ал егер менімен ішкің келсе?
Dialogue: 0,0:20:22.29,0:20:26.63,Default,,0,0,0,,Осыны шын айтыңыз.
Dialogue: 0,0:20:26.63,0:20:28.63,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:26.63,0:20:28.63,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:20:28.63,0:20:31.83,Default,,0,0,0,,Ол жын сияқты жынды
Dialogue: 0,0:20:28.63,0:20:31.83,Default,,0,0,0,,Мұны тоқтатыңыз!
Dialogue: 0,0:20:33.80,0:20:35.80,Default,,0,0,0,,Не? Бұл тым қараңғы...
Dialogue: 0,0:20:35.80,0:20:38.30,Default,,0,0,0,,Нанбо жоқ Монжа!
Dialogue: 0,0:20:35.80,0:20:38.30,Default,,0,0,0,,бос!?
Dialogue: 0,0:20:38.30,0:20:40.81,Default,,0,0,0,,Жаттығу әдісі басқа!
Dialogue: 0,0:20:40.81,0:20:43.31,Default,,0,0,0,,Бұл жақсы жыл болды.
Dialogue: 0,0:20:40.81,0:20:43.31,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:20:43.31,0:20:45.98,Default,,0,0,0,,Оны маған беріңіз
Dialogue: 0,0:20:43.31,0:20:45.98,Default,,0,0,0,,Ұйқыда сөйлесіңіз.
Dialogue: 0,0:20:45.98,0:20:48.65,Default,,0,0,0,,Бірақ бәрі осы.
Dialogue: 0,0:20:45.98,0:20:48.65,Default,,0,0,0,,Мен оны жек көрдім.
Dialogue: 0,0:20:48.65,0:20:50.98,Default,,0,0,0,,Мені де сұрағанда таң қалдым.
Dialogue: 0,0:20:50.98,0:20:55.18,Default,,0,0,0,,Керемет нәтиже, солай ма?
Dialogue: 0,0:20:50.98,0:20:55.18,Default,,0,0,0,,Сол бала үшін.
Dialogue: 0,0:20:57.16,0:21:00.16,Default,,0,0,0,,Сіз мифтік қызсыз, солай ма?
Dialogue: 0,0:20:57.16,0:21:00.16,Default,,0,0,0,,Өте сүйкімді!
Dialogue: 0,0:21:00.16,0:21:02.66,Default,,0,0,0,,Тапсырысыңыз ше?
Dialogue: 0,0:21:00.16,0:21:02.66,Default,,0,0,0,,Бұл біз➡︎
Dialogue: 0,0:21:02.66,0:21:05.33,Default,,0,0,0,,Олар сол жерде якитори жасап жатыр.
Dialogue: 0,0:21:02.66,0:21:05.33,Default,,0,0,0,,Кейінірек келгіңіз келе ме?
Dialogue: 0,0:21:05.33,0:21:09.00,Default,,0,0,0,,Мен олай істеуден аулақпын.
Dialogue: 0,0:21:05.33,0:21:09.00,Default,,0,0,0,,Эй, біз бірінші шақырдық.
Dialogue: 0,0:21:09.00,0:21:11.34,Default,,0,0,0,,Қызықсыз ештеңе айтпа.
Dialogue: 0,0:21:11.34,0:21:14.34,Default,,0,0,0,,Дүкенді артымдағы екі адамға қалдырсам.
Dialogue: 0,0:21:11.34,0:21:14.34,Default,,0,0,0,,Жарайды, солай ма?
Dialogue: 0,0:21:14.34,0:21:16.34,Default,,0,0,0,,Уайымдама...!
Dialogue: 0,0:21:19.28,0:21:22.45,Default,,0,0,0,,Балалар, сендерге менің кіші оқушымнан бірдеңе керек пе?
Dialogue: 0,0:21:22.45,0:21:25.12,Default,,0,0,0,,Сізге ұнамайтын сияқты.
Dialogue: 0,0:21:25.12,0:21:27.12,Default,,0,0,0,,Сәлем! Шашырау! Шашырау!
Dialogue: 0,0:21:27.12,0:21:29.12,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:21:27.12,0:21:29.12,Default,,0,0,0,,Иә
Dialogue: 0,0:21:29.12,0:21:31.79,Default,,0,0,0,,Мүлдем олар
Dialogue: 0,0:21:29.12,0:21:31.79,Default,,0,0,0,,Сіз мұнда не үшін келдіңіз?
Dialogue: 0,0:21:31.79,0:21:35.46,Default,,0,0,0,,Әй, балалар, ояныңдар!
Dialogue: 0,0:21:31.79,0:21:35.46,Default,,0,0,0,,Марапаттау рәсімінің уақыты келді!
Dialogue: 0,0:21:35.46,0:21:38.46,Default,,0,0,0,,Құттықтаймыз, CIU ханым!
Dialogue: 0,0:21:38.46,0:21:40.47,Default,,0,0,0,,Сәлем
Dialogue: 0,0:21:40.47,0:21:44.47,Default,,0,0,0,,Сахналық қойылым ең жақсы болды
Dialogue: 0,0:21:40.47,0:21:44.47,Default,,0,0,0,,Беделге келетін болсақ...
Dialogue: 0,0:21:44.47,0:21:47.31,Default,,0,0,0,,Не?
Dialogue: 0,0:21:44.47,0:21:47.31,Default,,0,0,0,,Сіз өте ашулы көрінесіз.
Dialogue: 0,0:21:47.31,0:21:49.47,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:21:49.47,0:21:51.64,Default,,0,0,0,,Жек көру?
Dialogue: 0,0:21:49.47,0:21:51.64,Default,,0,0,0,,Команда құрамын келіссөз жүргізуді бастайық.
Dialogue: 0,0:21:51.64,0:21:53.65,Default,,0,0,0,,Өйткені Чи-чан➡︎
Dialogue: 0,0:21:53.65,0:21:56.48,Default,,0,0,0,,Иори және басқалары үшін
Dialogue: 0,0:21:53.65,0:21:56.48,Default,,0,0,0,,Жұмбақ комикстерге барудан басқа амалым болмаса да...
Dialogue: 0,0:21:56.48,0:21:58.48,Default,,0,0,0,,Бірақ Иори және басқалары➡︎
Dialogue: 0,0:21:58.48,0:22:00.99,Default,,0,0,0,,Басқа балаларға арналған
Dialogue: 0,0:21:58.48,0:22:00.99,Default,,0,0,0,,Сіз көп жұмыс істедіңіз, солай емес пе?
Dialogue: 0,0:22:00.99,0:22:03.49,Default,,0,0,0,,Ең алдымен,
Dialogue: 0,0:22:00.99,0:22:03.49,Default,,0,0,0,,Чи Чан ер адаммен араласып қалады➡︎
Dialogue: 0,0:22:03.49,0:22:05.49,Default,,0,0,0,,Себебі сұлулық байқауына қатысқанмын➡︎
Dialogue: 0,0:22:05.49,0:22:08.33,Default,,0,0,0,,Өзім туралы
Dialogue: 0,0:22:05.49,0:22:08.33,Default,,0,0,0,,Сіз маған көмектеспейсіз➡︎
Dialogue: 0,0:22:08.33,0:22:10.33,Default,,0,0,0,,Бұл мені ашуландырады.
Dialogue: 0,0:22:10.33,0:22:14.50,Default,,0,0,0,,Менен сұрасаңыз...
Dialogue: 0,0:22:10.33,0:22:14.50,Default,,0,0,0,,Бұл мені ашуландырады.
Dialogue: 0,0:22:14.50,0:22:18.77,Default,,0,0,0,,Бұл қуаныш
Dialogue: 0,0:22:14.50,0:22:18.77,Default,,0,0,0,,Кімге айтқыңыз келеді?
Dialogue: 0,0:22:18.77,0:22:21.27,Default,,0,0,0,,Иә, дұрыс айтасың.
Dialogue: 0,0:22:21.27,0:22:26.11,Default,,0,0,0,,Әлгі мас жігіт.
Dialogue: 0,0:22:21.27,0:22:26.11,Default,,0,0,0,,Мен жігітіме айтқым келеді
Dialogue: 0,0:22:26.11,0:22:28.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:28.11,0:22:30.28,Default,,0,0,0,,А... жігітім?
Dialogue: 0,0:22:28.11,0:22:30.28,Default,,0,0,0,,Сіз ол туралы айтып отырсыз ба!?
Dialogue: 0,0:22:30.28,0:22:32.28,Default,,0,0,0,,Бұл
Dialogue: 0,0:22:30.28,0:22:32.28,Default,,0,0,0,,Сіз бұзық еркек емессіз бе?
Dialogue: 0,0:22:32.28,0:22:35.12,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:32.28,0:22:35.12,Default,,0,0,0,,Сіз Иориді еркектерден қорғану үшін қолдандыңыз ба?
Dialogue: 0,0:22:35.12,0:22:37.79,Default,,0,0,0,,Енді бұл екі ғашық па?
Dialogue: 0,0:22:37.79,0:22:42.29,Default,,0,0,0,,Сол балалар...
Dialogue: 0,0:22:37.79,0:22:42.29,Default,,0,0,0,,Маған қызық, сіз не істеуді жоспарлап отырсыз.
Dialogue: 0,0:22:42.29,0:22:45.79,Default,,0,0,0,,Өлтір! Өлтір! Өлтір!
Dialogue: 0,0:22:47.29,0:22:53.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
