Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.47,0:00:04.98,Default,,0,0,0,,《Иори: Жаман...》
Dialogue: 0,0:00:04.98,0:00:07.98,Default,,0,0,0,,((Нанака: Тек Иори-кун
Dialogue: 0,0:00:04.98,0:00:07.98,Default,,0,0,0,,Сәтсіз қалуыңыз мүмкін))
Dialogue: 0,0:00:07.98,0:00:10.48,Default,,0,0,0,,《Мен ғана сәтсіздікке ұшырадым...
Dialogue: 0,0:00:10.48,0:00:13.82,Default,,0,0,0,,Бұл факт
Dialogue: 0,0:00:10.48,0:00:13.82,Default,,0,0,0,,Егер олар білсе...
Dialogue: 0,0:00:13.82,0:00:16.99,Default,,0,0,0,,Өлімнен де жаман қорлық! 》
Dialogue: 0,0:00:16.99,0:00:21.16,Default,,0,0,0,,((Иори-кун).
Dialogue: 0,0:00:16.99,0:00:21.16,Default,,0,0,0,,Сіз масканы тазалауда өте нашар сияқтысыз))
Dialogue: 0,0:00:21.16,0:00:23.66,Default,,0,0,0,,《Бәрекелді, менде маска бар.
Dialogue: 0,0:00:23.66,0:00:26.33,Default,,0,0,0,,Бассейн де, теңіз де жақын
Dialogue: 0,0:00:26.33,0:00:30.33,Default,,0,0,0,,Қалай деген сұрақ туындайды
Dialogue: 0,0:00:26.33,0:00:30.33,Default,,0,0,0,,Оларға соқпастан жаттығыңыз》
Dialogue: 0,0:00:30.33,0:00:33.50,Default,,0,0,0,,Жою мүмкін емес...
Dialogue: 0,0:00:30.33,0:00:33.50,Default,,0,0,0,,Иә? Иори
Dialogue: 0,0:00:33.50,0:00:36.67,Default,,0,0,0,,Жоқ, қазір кешкі ас уақыты...
Dialogue: 0,0:00:33.50,0:00:36.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:36.67,0:00:40.84,Default,,0,0,0,,Мен сені умен өлтіруім керек пе?
Dialogue: 0,0:00:36.67,0:00:40.84,Default,,0,0,0,,Әдемі күліп не айтып тұрсың?
Dialogue: 0,0:00:40.84,0:00:43.85,Default,,0,0,0,,Чиса!
Dialogue: 0,0:00:40.84,0:00:43.85,Default,,0,0,0,,Тыңдаудың дәмі жаман!
Dialogue: 0,0:00:43.85,0:00:46.18,Default,,0,0,0,,Менің ойымша, бұл улану сияқты жаман емес.
Dialogue: 0,0:00:46.18,0:00:50.69,Default,,0,0,0,,Эй, мен көлікті несиеге алайын деп жатырмын.
Dialogue: 0,0:00:46.18,0:00:50.69,Default,,0,0,0,,Оны базардан сатып алыңыз!
Dialogue: 0,0:00:50.69,0:00:53.52,Default,,0,0,0,,А... қараңдаршы!
Dialogue: 0,0:00:50.69,0:00:53.52,Default,,0,0,0,,Чиса мені шақырып жатыр!
Dialogue: 0,0:00:53.52,0:00:57.22,Default,,0,0,0,,А... бұл күдікті.
Dialogue: 0,0:02:28.49,0:02:30.89,Default,,0,0,0,,Ал, мынаны қолдан.
Dialogue: 0,0:02:33.82,0:02:37.66,Default,,0,0,0,,Мен не істеуім керек? Бауырлар
Dialogue: 0,0:02:33.82,0:02:37.66,Default,,0,0,0,,Мен не істесем де...
Dialogue: 0,0:02:37.66,0:02:40.33,Default,,0,0,0,,Бұған
Dialogue: 0,0:02:37.66,0:02:40.33,Default,,0,0,0,,Барлығымыз бортқа қалай шыға аламыз?
Dialogue: 0,0:02:40.33,0:02:42.67,Default,,0,0,0,,Брондау кезінде қателік жібердіңіз бе?
Dialogue: 0,0:02:42.67,0:02:44.83,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:42.67,0:02:44.83,Default,,0,0,0,,Мен ескертпе жасадым.
Dialogue: 0,0:02:44.83,0:02:48.51,Default,,0,0,0,,Ахса! 4 адам және 8 адам
Dialogue: 0,0:02:44.83,0:02:48.51,Default,,0,0,0,,Мен қате жібердім.
Dialogue: 0,0:02:48.51,0:02:52.01,Default,,0,0,0,,Қалыпты Бұл туралы қателесесіз бе!?
Dialogue: 0,0:02:48.51,0:02:52.01,Default,,0,0,0,,Нашар Нашар
Dialogue: 0,0:02:52.01,0:02:55.45,Default,,0,0,0,,Енді басқа көлік алайық.
Dialogue: 0,0:02:52.01,0:02:55.45,Default,,0,0,0,,Басқа көлік пе?
Dialogue: 0,0:02:55.45,0:02:58.45,Default,,0,0,0,,Қателік жасағаны үшін кешірім сұрау
Dialogue: 0,0:02:55.45,0:02:58.45,Default,,0,0,0,,Арты кең ашық көлік➡︎
Dialogue: 0,0:02:58.45,0:03:00.95,Default,,0,0,0,,Мен оны сізге тегін беремін. Эй!
Dialogue: 0,0:03:00.95,0:03:03.65,Default,,0,0,0,,Шынымен!?
Dialogue: 0,0:03:00.95,0:03:03.65,Default,,0,0,0,,Машинаны аш!?
Dialogue: 0,0:03:08.96,0:03:11.13,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:03:08.96,0:03:11.13,Default,,0,0,0,,Бұл, әрине, кең...
Dialogue: 0,0:03:11.13,0:03:14.30,Default,,0,0,0,,Еркіндік сезімі де теңдесі жоқ...
Dialogue: 0,0:03:11.13,0:03:14.30,Default,,0,0,0,,Мәселе жоқ...
Dialogue: 0,0:03:14.30,0:03:17.13,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:03:14.30,0:03:17.13,Default,,0,0,0,,Кәдімгі 8 орындық әкеліңіз!
Dialogue: 0,0:03:17.13,0:03:21.64,Default,,0,0,0,,Бізде мұндай үлкен көлік жоқ.
Dialogue: 0,0:03:17.13,0:03:21.64,Default,,0,0,0,,Бұл не? Бұл дүкен!
Dialogue: 0,0:03:21.64,0:03:24.98,Default,,0,0,0,,Олай болса, сапарыңыз сәтті өтсін!
Dialogue: 0,0:03:21.64,0:03:24.98,Default,,0,0,0,,Уа... жігіт!
Dialogue: 0,0:03:24.98,0:03:28.14,Default,,0,0,0,,Біз не істеуіміз керек? Бұл...
Dialogue: 0,0:03:24.98,0:03:28.14,Default,,0,0,0,,Бұл машина механикалық.
Dialogue: 0,0:03:28.14,0:03:30.48,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:03:28.14,0:03:30.48,Default,,0,0,0,,Мен лицензиямды ұмытып қалдым.
Dialogue: 0,0:03:30.48,0:03:35.65,Default,,0,0,0,,Жоспар
Dialogue: 0,0:03:30.48,0:03:35.65,Default,,0,0,0,,Мен тек автоматты машиналарды пайдаланамын...
Dialogue: 0,0:03:35.65,0:03:37.85,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:43.49,0:03:47.33,Default,,0,0,0,,А... өмір қысқа болды.
Dialogue: 0,0:03:47.33,0:03:50.00,Default,,0,0,0,,Аспан... сондай көгілдір
Dialogue: 0,0:03:50.00,0:03:52.17,Default,,0,0,0,,Балалар сендер шынымен дөрекі екенсіңдер!
Dialogue: 0,0:03:52.17,0:03:55.01,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:03:52.17,0:03:55.01,Default,,0,0,0,,Бұл ыңғайлы жүру!
Dialogue: 0,0:03:55.01,0:03:57.61,Default,,0,0,0,,Әй, ағайын
Dialogue: 0,0:03:55.01,0:03:57.61,Default,,0,0,0,,Мен айтуды ұмытып кетіппін...
Dialogue: 0,0:03:57.61,0:03:59.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:57.61,0:03:59.94,Default,,0,0,0,,Бұдан былай сіз жүретін жол ➡︎ болады
Dialogue: 0,0:03:59.94,0:04:02.11,Default,,0,0,0,,Мұның бәрі жеке меншік.
Dialogue: 0,0:04:02.11,0:04:04.61,Default,,0,0,0,,Сіз таңғажайып нәрселерді мақтанышпен айтып жатырсыз.
Dialogue: 0,0:04:02.11,0:04:04.61,Default,,0,0,0,,Бұл қарт
Dialogue: 0,0:04:04.61,0:04:07.45,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:04:04.61,0:04:07.45,Default,,0,0,0,,Олай болса, кеттік!
Dialogue: 0,0:04:07.45,0:04:10.15,Default,,0,0,0,,Барлығына! Мені бір нәрсе ұстап алды!
Dialogue: 0,0:04:07.45,0:04:10.15,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:13.96,0:04:16.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:13.96,0:04:16.13,Default,,0,0,0,,Кебако механикалық көлікті ➡︎ жүргізеді
Dialogue: 0,0:04:16.13,0:04:20.13,Default,,0,0,0,,Егер сіз оны қалыпты түрде іске қоссаңыз ше?
Dialogue: 0,0:04:16.13,0:04:20.13,Default,,0,0,0,,Мен оған әбден үйреніп қалғандай сезінемін.
Dialogue: 0,0:04:20.13,0:04:22.97,Default,,0,0,0,,Неге сонша үйреніп қалдың?
Dialogue: 0,0:04:20.13,0:04:22.97,Default,,0,0,0,,Аа... Ах...
Dialogue: 0,0:04:22.97,0:04:25.97,Default,,0,0,0,,Мен үйреніп қалған шығармын...
Dialogue: 0,0:04:22.97,0:04:25.97,Default,,0,0,0,,Жоқ, бұл тамаша.
Dialogue: 0,0:04:25.97,0:04:29.31,Default,,0,0,0,,О... болмайды!
Dialogue: 0,0:04:25.97,0:04:29.31,Default,,0,0,0,,Қалаға сәйкес келетін үй➡︎
Dialogue: 0,0:04:29.31,0:04:31.98,Default,,0,0,0,,Көлікпен
Dialogue: 0,0:04:29.31,0:04:31.98,Default,,0,0,0,,Сіз далада көмектестім дедіңіз бе?
Dialogue: 0,0:04:31.98,0:04:36.48,Default,,0,0,0,,Түсінемін... Солай ма?
Dialogue: 0,0:04:31.98,0:04:36.48,Default,,0,0,0,,Сонда сіз сенімді бола аласыз.
Dialogue: 0,0:04:42.49,0:04:44.99,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:04:44.99,0:04:47.99,Default,,0,0,0,,Бір қызығы, бұл да жақсы!
Dialogue: 0,0:04:44.99,0:04:47.99,Default,,0,0,0,,О!
Dialogue: 0,0:04:47.99,0:04:50.66,Default,,0,0,0,,Бірақ егер бұл орын алса
Dialogue: 0,0:04:47.99,0:04:50.66,Default,,0,0,0,,Мен сыра ішкім келеді.
Dialogue: 0,0:04:50.66,0:04:54.00,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:04:50.66,0:04:54.00,Default,,0,0,0,,Тым болмаса түнге дейін шыда!
Dialogue: 0,0:04:54.00,0:04:58.27,Default,,0,0,0,,Уф! Бұл келе жатқан көлік!
Dialogue: 0,0:04:54.00,0:04:58.27,Default,,0,0,0,,Жоқ! Жасыру!
Dialogue: 0,0:04:58.27,0:05:01.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:01.27,0:05:05.61,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:05:05.61,0:05:08.78,Default,,0,0,0,,Жақсы! Мәселе жоқ.
Dialogue: 0,0:05:05.61,0:05:08.78,Default,,0,0,0,,Әрине, қазір ➡︎
Dialogue: 0,0:05:08.78,0:05:10.78,Default,,0,0,0,,Бортта адамдар бар сияқты.
Dialogue: 0,0:05:08.78,0:05:10.78,Default,,0,0,0,,Сіз оны көре алмайсыз, солай ма?
Dialogue: 0,0:05:10.78,0:05:14.45,Default,,0,0,0,,Мәйітті тасымалдау
Dialogue: 0,0:05:10.78,0:05:14.45,Default,,0,0,0,,Бұл қарапайым жеңіл жүк көлігіне ұқсайды.
Dialogue: 0,0:05:14.45,0:05:17.45,Default,,0,0,0,,Хахахаха...!
Dialogue: 0,0:05:14.45,0:05:17.45,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:05:17.45,0:05:20.62,Default,,0,0,0,,Ахахаха!
Dialogue: 0,0:05:17.45,0:05:20.62,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:05:20.62,0:05:24.63,Default,,0,0,0,,Ал, әрқайсыңыз.
Dialogue: 0,0:05:20.62,0:05:24.63,Default,,0,0,0,,Сатып алғыңыз келетін ингредиенттерді таңдаңыз...
Dialogue: 0,0:05:24.63,0:05:27.30,Default,,0,0,0,,Біз қайтып келгенде, бәрі
Dialogue: 0,0:05:24.63,0:05:27.30,Default,,0,0,0,,Бір уақытта бір затты жасайық!
Dialogue: 0,0:05:27.30,0:05:30.63,Default,,0,0,0,,Керемет!
Dialogue: 0,0:05:27.30,0:05:30.63,Default,,0,0,0,,Олай болса, сәттілік тілеймін!
Dialogue: 0,0:05:30.63,0:05:32.63,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:05:40.81,0:05:42.98,Default,,0,0,0,,Раракотан!
Dialogue: 0,0:05:42.98,0:05:46.15,Default,,0,0,0,,Сирек кездесетін заттар өте көп.
Dialogue: 0,0:05:42.98,0:05:46.15,Default,,0,0,0,,Иә
Dialogue: 0,0:05:46.15,0:05:49.15,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:05:46.15,0:05:49.15,Default,,0,0,0,,Ингредиенттерді таңдаудағы талғамыңыз тексеріледі.
Dialogue: 0,0:05:49.15,0:05:52.16,Default,,0,0,0,,Үлкендер не істейді?
Dialogue: 0,0:05:49.15,0:05:52.16,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:05:52.16,0:05:54.66,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:05:52.16,0:05:54.66,Default,,0,0,0,,Өте әсерлі Қвирк қой, иә!➡
Dialogue: 0,0:05:54.66,0:05:58.09,Default,,0,0,0,,Олай болса мен сенен сұрайын.
Dialogue: 0,0:05:54.66,0:05:58.09,Default,,0,0,0,,Сәлем, қош келдіңіз! Не істеу оңай?
Dialogue: 0,0:05:58.09,0:06:01.43,Default,,0,0,0,,болды
Dialogue: 0,0:05:58.09,0:06:01.43,Default,,0,0,0,,Ал, мен...
Dialogue: 0,0:06:01.43,0:06:04.43,Default,,0,0,0,,Қартты жегім келеді.
Dialogue: 0,0:06:04.43,0:06:06.44,Default,,0,0,0,,Не!
Dialogue: 0,0:06:06.44,0:06:08.44,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:06:06.44,0:06:08.44,Default,,0,0,0,,Не болды? Кебако
Dialogue: 0,0:06:08.44,0:06:12.28,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:06:08.44,0:06:12.28,Default,,0,0,0,,Ах... Азуса-сан...
Dialogue: 0,0:06:12.28,0:06:15.28,Default,,0,0,0,,Балық сатушының ағасы
Dialogue: 0,0:06:12.28,0:06:15.28,Default,,0,0,0,,Мен тамақ ішейін деп едім...
Dialogue: 0,0:06:15.28,0:06:19.12,Default,,0,0,0,,Балық сатушы?
Dialogue: 0,0:06:15.28,0:06:19.12,Default,,0,0,0,,Не көрдің?
Dialogue: 0,0:06:19.12,0:06:22.29,Default,,0,0,0,,Жоқ! Қазіргісі
Dialogue: 0,0:06:19.12,0:06:22.29,Default,,0,0,0,,Мен қате естіген шығармын!
Dialogue: 0,0:06:22.29,0:06:24.79,Default,,0,0,0,,О... түсіндім.
Dialogue: 0,0:06:22.29,0:06:24.79,Default,,0,0,0,,Бұл жақсы болар еді.
Dialogue: 0,0:06:24.79,0:06:27.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:27.29,0:06:30.13,Default,,0,0,0,,Енді Тоқыта-сенпайдан сұрайын!
Dialogue: 0,0:06:27.29,0:06:30.13,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:30.13,0:06:33.13,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ келіңіз.
Dialogue: 0,0:06:30.13,0:06:33.13,Default,,0,0,0,,Ум...
Dialogue: 0,0:06:33.13,0:06:35.97,Default,,0,0,0,,Аа, дұрыс. Мен➡︎
Dialogue: 0,0:06:35.97,0:06:38.97,Default,,0,0,0,,Мен Хамасакидің әйелін қалаймын
Dialogue: 0,0:06:35.97,0:06:38.97,Default,,0,0,0,,Эх!
Dialogue: 0,0:06:38.97,0:06:41.64,Default,,0,0,0,,Сен оған көп қиындық көрсеттің ғой, иә?
Dialogue: 0,0:06:38.97,0:06:41.64,Default,,0,0,0,,Айна?
Dialogue: 0,0:06:41.64,0:06:45.64,Default,,0,0,0,,Токита-сенпай...
Dialogue: 0,0:06:41.64,0:06:45.64,Default,,0,0,0,,Ол адамға не болды?
Dialogue: 0,0:06:45.64,0:06:48.98,Default,,0,0,0,,Үйленген әйелге тиісуге тырысу...
Dialogue: 0,0:06:45.64,0:06:48.98,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:06:48.98,0:06:51.48,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:06:48.98,0:06:51.48,Default,,0,0,0,,Сіз не тыңдадыңыз?
Dialogue: 0,0:06:51.48,0:06:53.48,Default,,0,0,0,,Сіз қате естігеніңізге сенімдісіз бе?
Dialogue: 0,0:06:53.48,0:06:57.09,Default,,0,0,0,,Бірақ бұл құлақтармен анық!
Dialogue: 0,0:06:53.48,0:06:57.09,Default,,0,0,0,,Олай болса, бұл галлюцинация.
Dialogue: 0,0:06:57.09,0:06:59.59,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:06:57.09,0:06:59.59,Default,,0,0,0,,Бәріміз барып тексерейік!
Dialogue: 0,0:06:59.59,0:07:02.26,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:06:59.59,0:07:02.26,Default,,0,0,0,,Маған үш дана беріңіз.
Dialogue: 0,0:07:02.26,0:07:04.59,Default,,0,0,0,,Ах
Dialogue: 0,0:07:04.59,0:07:07.43,Default,,0,0,0,,Қош келдіңіз! Сен не іздеп тұрсың?
Dialogue: 0,0:07:07.43,0:07:11.43,Default,,0,0,0,,Бұл жай ғана сатып алу.
Dialogue: 0,0:07:07.43,0:07:11.43,Default,,0,0,0,,Мұнда таңғаларлық ештеңе жоқ.
Dialogue: 0,0:07:11.43,0:07:15.27,Default,,0,0,0,,Хмм... Меніңше, солай ма?
Dialogue: 0,0:07:11.43,0:07:15.27,Default,,0,0,0,,Бұл Айнаның түсінбестігі емес пе?
Dialogue: 0,0:07:15.27,0:07:18.44,Default,,0,0,0,,Бірінші кезекте осындай жерде
Dialogue: 0,0:07:15.27,0:07:18.44,Default,,0,0,0,,Менің ойымша, ол оғаш нәрселерді жасамайды.
Dialogue: 0,0:07:18.44,0:07:22.28,Default,,0,0,0,,А... әрине.
Dialogue: 0,0:07:18.44,0:07:22.28,Default,,0,0,0,,Үйде бәрі бар.
Dialogue: 0,0:07:22.28,0:07:24.61,Default,,0,0,0,,Маған еркін айтыңыз
Dialogue: 0,0:07:22.28,0:07:24.61,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:07:24.61,0:07:26.62,Default,,0,0,0,,Етті Коукусей
Dialogue: 0,0:07:26.62,0:07:28.62,Default,,0,0,0,,Шығар!
Dialogue: 0,0:07:26.62,0:07:28.62,Default,,0,0,0,,Бұл шықты!
Dialogue: 0,0:07:28.62,0:07:31.79,Default,,0,0,0,,Сіз осындай жерден не сатып алмақсыз?
Dialogue: 0,0:07:28.62,0:07:31.79,Default,,0,0,0,,Сондықтан мен айттым!
Dialogue: 0,0:07:31.79,0:07:33.96,Default,,0,0,0,,Бұл туралы хабарлауым керек пе...
Dialogue: 0,0:07:33.96,0:07:36.13,Default,,0,0,0,,Бұл қандай жаман иіс?
Dialogue: 0,0:07:33.96,0:07:36.13,Default,,0,0,0,,Жағдайды тыңдаған дұрыс болар еді...
Dialogue: 0,0:07:36.13,0:07:38.13,Default,,0,0,0,,Екеуің күтіңдер.
Dialogue: 0,0:07:36.13,0:07:38.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:38.13,0:07:41.80,Default,,0,0,0,,Менің ойымша, бұл түсінбеушілік шығар.
Dialogue: 0,0:07:38.13,0:07:41.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:41.80,0:07:44.97,Default,,0,0,0,,Олардың барлығы балық атаулары.
Dialogue: 0,0:07:44.97,0:07:47.80,Default,,0,0,0,,(Джунпей) Маған ұнамайтын адамдарды өлтіретін түйме болса да—
Dialogue: 0,0:07:44.97,0:07:47.80,Default,,0,0,0,,Атаудың тамаша мағынасы.
Dialogue: 0,0:07:47.80,0:07:50.47,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:07:47.80,0:07:50.47,Default,,0,0,0,,Азуса-сан да, Токита-сенпай да...
Dialogue: 0,0:07:50.47,0:07:53.31,Default,,0,0,0,,Сіз балық сатып алмақ болдыңыз ба?
Dialogue: 0,0:07:50.47,0:07:53.31,Default,,0,0,0,,Иә
Dialogue: 0,0:07:53.31,0:07:56.58,Default,,0,0,0,,Егер сіз бұл туралы шындап ойласаңыз
Dialogue: 0,0:07:53.31,0:07:56.58,Default,,0,0,0,,Мен мұндай нәрсені сатып алу мүмкін емес.
Dialogue: 0,0:07:56.58,0:08:00.08,Default,,0,0,0,,Ал... Мен басынан бастадым.
Dialogue: 0,0:07:56.58,0:08:00.08,Default,,0,0,0,,Мен оны білдім! Хахаха...
Dialogue: 0,0:08:00.08,0:08:02.42,Default,,0,0,0,,Толығымен
Dialogue: 0,0:08:00.08,0:08:02.42,Default,,0,0,0,,Бірге таң қалсақ та
Dialogue: 0,0:08:02.42,0:08:05.42,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:02.42,0:08:05.42,Default,,0,0,0,,Иә! Қош келдіңіз
Dialogue: 0,0:08:05.42,0:08:08.42,Default,,0,0,0,,Бір тістеу ересек адамды өлтіруі мүмкін
Dialogue: 0,0:08:05.42,0:08:08.42,Default,,0,0,0,,Сізді құлататын бір улы балық...
Dialogue: 0,0:08:08.42,0:08:10.42,Default,,0,0,0,,Эй, не болып жатыр?
Dialogue: 0,0:08:13.10,0:08:15.93,Default,,0,0,0,,Біреудің саудасын аңду деген не?
Dialogue: 0,0:08:13.10,0:08:15.93,Default,,0,0,0,,Сіздің дәміңіз нашар!
Dialogue: 0,0:08:15.93,0:08:18.77,Default,,0,0,0,,Улы балық сатып алмақ болған адам
Dialogue: 0,0:08:15.93,0:08:18.77,Default,,0,0,0,,Не айту керек!
Dialogue: 0,0:08:18.77,0:08:21.94,Default,,0,0,0,,Тағы да біртүрлі нәрсе
Dialogue: 0,0:08:18.77,0:08:21.94,Default,,0,0,0,,Сіз жоспар құрып жатырсыз!
Dialogue: 0,0:08:21.94,0:08:26.28,Default,,0,0,0,,《Tch... Сәтсіздік пе? Бұл жалғаса берсе...
Dialogue: 0,0:08:26.28,0:08:29.11,Default,,0,0,0,,Өлетіндей қорланған
Dialogue: 0,0:08:26.28,0:08:29.11,Default,,0,0,0,,Алу үшін...》
Dialogue: 0,0:08:29.11,0:08:31.28,Default,,0,0,0,,Иә, бәрі де бір тартады.
Dialogue: 0,0:08:31.28,0:08:33.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:31.28,0:08:33.62,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:08:33.62,0:08:36.62,Default,,0,0,0,,Ыдыс-аяқтың ретін шешу үшін ұтыс ойыны.
Dialogue: 0,0:08:33.62,0:08:36.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:36.62,0:08:38.96,Default,,0,0,0,,Асханаға әркім сыймайды.
Dialogue: 0,0:08:38.96,0:08:41.29,Default,,0,0,0,,Бір уақытта екі адам
Dialogue: 0,0:08:38.96,0:08:41.29,Default,,0,0,0,,Оны ретімен орындайық.
Dialogue: 0,0:08:41.29,0:08:44.63,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:08:41.29,0:08:44.63,Default,,0,0,0,,Тек біреуін салу керек.
Dialogue: 0,0:08:44.63,0:08:46.80,Default,,0,0,0,,《Иә? Екеуің бірге тамақ жасап жатырсыңдар ма?
Dialogue: 0,0:08:46.80,0:08:51.13,Default,,0,0,0,,Ха! Бұл лотереяны білдіреді
Dialogue: 0,0:08:46.80,0:08:51.13,Default,,0,0,0,,Kohei және Kebako➡︎ орнатсаңыз
Dialogue: 0,0:08:51.13,0:08:55.24,Default,,0,0,0,,Олар тамақ пісіріп жатқанда
Dialogue: 0,0:08:51.13,0:08:55.24,Default,,0,0,0,,Сіз жаттығу жасай аласыз! 》
Dialogue: 0,0:08:55.24,0:08:59.58,Default,,0,0,0,,I саны 4
Dialogue: 0,0:08:55.24,0:08:59.58,Default,,0,0,0,,Мен 2-ші нөмірмін. Иә?
Dialogue: 0,0:08:59.58,0:09:01.91,Default,,0,0,0,,Чисамен бірге келіңіз.
Dialogue: 0,0:08:59.58,0:09:01.91,Default,,0,0,0,,Чисамен келіңіз...
Dialogue: 0,0:09:01.91,0:09:03.91,Default,,0,0,0,,Боу?
Dialogue: 0,0:09:01.91,0:09:03.91,Default,,0,0,0,,Чисамен бірге келіңіз.
Dialogue: 0,0:09:03.91,0:09:05.92,Default,,0,0,0,,Чисамен бірге келіңіз.
Dialogue: 0,0:09:03.91,0:09:05.92,Default,,0,0,0,,Чисамен...
Dialogue: 0,0:09:05.92,0:09:10.09,Default,,0,0,0,,Iori?
Dialogue: 0,0:09:05.92,0:09:10.09,Default,,0,0,0,,Құдайдан өтінемін! Өтінемін!
Dialogue: 0,0:09:10.09,0:09:12.92,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:09:12.92,0:09:14.92,Default,,0,0,0,,Кел, Чиза! Біз бір жұппыз!
Dialogue: 0,0:09:14.92,0:09:18.09,Default,,0,0,0,,Айна, бұл жиіркенішті, сондықтан мен сені ауыстырамын.
Dialogue: 0,0:09:14.92,0:09:18.09,Default,,0,0,0,,А...
Dialogue: 0,0:09:18.09,0:09:20.43,Default,,0,0,0,,Неге олай айтып тұрсың, Чиса?
Dialogue: 0,0:09:20.43,0:09:23.60,Default,,0,0,0,,Мен және сіздің жұбыңыз
Dialogue: 0,0:09:20.43,0:09:23.60,Default,,0,0,0,,Ас әзірлеуді қызық жасайық!
Dialogue: 0,0:09:23.60,0:09:26.44,Default,,0,0,0,,Бұл, әрине, жиіркенішті.
Dialogue: 0,0:09:23.60,0:09:26.44,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:09:26.44,0:09:29.27,Default,,0,0,0,,Тамақ пісіріп жатқанда мен пышақты үнемі ұстаймын.
Dialogue: 0,0:09:29.27,0:09:34.44,Default,,0,0,0,,Иори! Бұл тым көп
Dialogue: 0,0:09:29.27,0:09:34.44,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:09:34.44,0:09:36.95,Default,,0,0,0,,《Азуса-сан байқады...》
Dialogue: 0,0:09:36.95,0:09:39.45,Default,,0,0,0,,Ештеңе, ештеңе...
Dialogue: 0,0:09:39.45,0:09:42.45,Default,,0,0,0,,Кохейдің қызғанышы
Dialogue: 0,0:09:39.45,0:09:42.45,Default,,0,0,0,,Сіз жағдайды араластыруға тырысып жатырсыз!
Dialogue: 0,0:09:44.79,0:09:46.79,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:09:46.79,0:09:48.96,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:09:48.96,0:09:50.96,Default,,0,0,0,,Бұл қызық па?
Dialogue: 0,0:09:48.96,0:09:50.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:50.96,0:09:52.96,Default,,0,0,0,,Иә! Жылап тұрсың ба!?
Dialogue: 0,0:09:52.96,0:09:55.63,Default,,0,0,0,,Енді бізде тамақ дайындау кезегі...
Dialogue: 0,0:09:55.63,0:09:59.80,Default,,0,0,0,,Неге сонша алыссың?
Dialogue: 0,0:09:59.80,0:10:03.97,Default,,0,0,0,,《Алайда, жаттығу жасасаңыз да
Dialogue: 0,0:09:59.80,0:10:03.97,Default,,0,0,0,,Жалғыз мұны істеу қиын...
Dialogue: 0,0:10:03.97,0:10:07.81,Default,,0,0,0,,Мына жігітке не болғанын айт.
Dialogue: 0,0:10:03.97,0:10:07.81,Default,,0,0,0,,Көмек сұрауым керек пе...》
Dialogue: 0,0:10:07.81,0:10:09.81,Default,,0,0,0,,Сәлем Чиса
Dialogue: 0,0:10:07.81,0:10:09.81,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:09.81,0:10:13.32,Default,,0,0,0,,Не?
Dialogue: 0,0:10:09.81,0:10:13.32,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:10:13.32,0:10:15.49,Default,,0,0,0,,Шай ішейік
Dialogue: 0,0:10:15.49,0:10:18.99,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:10:15.49,0:10:18.99,Default,,0,0,0,,Бұл солай болды.
Dialogue: 0,0:10:18.99,0:10:22.33,Default,,0,0,0,,Сондықтан Чиса, жаттығуға...
Dialogue: 0,0:10:22.33,0:10:26.16,Default,,0,0,0,,сол жер мен сол уақытты, иә, Эрен...?
Dialogue: 0,0:10:22.33,0:10:26.16,Default,,0,0,0,,Уау! Уф!
Dialogue: 0,0:10:26.16,0:10:30.50,Default,,0,0,0,,《Не деп тұрсың!?
Dialogue: 0,0:10:26.16,0:10:30.50,Default,,0,0,0,,Иори Чисаға... неге!?
Dialogue: 0,0:10:30.50,0:10:32.84,Default,,0,0,0,,Эй... тыныштал.
Dialogue: 0,0:10:30.50,0:10:32.84,Default,,0,0,0,,Сатып алу кезінде лайк➡︎
Dialogue: 0,0:10:32.84,0:10:34.84,Default,,0,0,0,,Бұл түсінбеушілік болуы мүмкін...》
Dialogue: 0,0:10:34.84,0:10:37.84,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:10:34.84,0:10:37.84,Default,,0,0,0,,О, мен байсалдымын.
Dialogue: 0,0:10:37.84,0:10:40.01,Default,,0,0,0,,Өйткені мен де саған ғашық болып жатырмын
Dialogue: 0,0:10:40.01,0:10:42.01,Default,,0,0,0,,《Бұл түсініспеушілік емес! 》
Dialogue: 0,0:10:42.01,0:10:46.52,Default,,0,0,0,,Бірақ өткен күні Чиса: «Осындай біреуге...
Dialogue: 0,0:10:42.01,0:10:46.52,Default,,0,0,0,,Мен бұл туралы ойланбаймын ...
Dialogue: 0,0:10:46.52,0:10:48.52,Default,,0,0,0,,Түсіндім... Мен бақыттымын.
Dialogue: 0,0:10:48.52,0:10:50.52,Default,,0,0,0,,《Маған ұнамайды~! 》
Dialogue: 0,0:10:50.52,0:10:54.69,Default,,0,0,0,,Бірақ мен үшін бұл жақсы ма?
Dialogue: 0,0:10:50.52,0:10:54.69,Default,,0,0,0,,Аа, менде жалғыз сенсің
Dialogue: 0,0:10:54.69,0:10:58.63,Default,,0,0,0,,Не болды? Кебако
Dialogue: 0,0:10:54.69,0:10:58.63,Default,,0,0,0,,Цк... Чиса мен Иори...
Dialogue: 0,0:10:58.63,0:11:00.63,Default,,0,0,0,,Оларға не болды?
Dialogue: 0,0:11:00.63,0:11:03.30,Default,,0,0,0,,Осы уақытқа дейін
Dialogue: 0,0:11:00.63,0:11:03.30,Default,,0,0,0,,Мен сені жек көрдім деп ойладым!
Dialogue: 0,0:11:03.30,0:11:07.30,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:11:03.30,0:11:07.30,Default,,0,0,0,,Аузымнан айтқым келмейді...
Dialogue: 0,0:11:07.30,0:11:10.64,Default,,0,0,0,,Тағы да
Dialogue: 0,0:11:07.30,0:11:10.64,Default,,0,0,0,,Бұл ақымақ түсінбеушілік болса керек.
Dialogue: 0,0:11:10.64,0:11:14.14,Default,,0,0,0,,Бірақ салмақ болмаса
Dialogue: 0,0:11:10.64,0:11:14.14,Default,,0,0,0,,Сіздің денеңіз қалқып кетуі мүмкін, бұл жаттығуды қиындатады.
Dialogue: 0,0:11:14.14,0:11:17.31,Default,,0,0,0,,Өзің бар
Dialogue: 0,0:11:14.14,0:11:17.31,Default,,0,0,0,,Денеме ауыр нәрсе...
Dialogue: 0,0:11:17.31,0:11:19.32,Default,,0,0,0,,Сіз мені байлай аласыз ба?
Dialogue: 0,0:11:19.32,0:11:21.82,Default,,0,0,0,,《Уф!? Не айтқың келеді!?
Dialogue: 0,0:11:21.82,0:11:24.15,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:21.82,0:11:24.15,Default,,0,0,0,,Кебаконың бұрын айтқаны...
Dialogue: 0,0:11:24.15,0:11:27.16,Default,,0,0,0,,Ерекше бейімділіктің оятуын білдіре ме?
Dialogue: 0,0:11:27.16,0:11:30.16,Default,,0,0,0,,Жоқ...бірақ бұрын болған оқиға
Dialogue: 0,0:11:27.16,0:11:30.16,Default,,0,0,0,,Бір ғана сөз жеткіліксіз...》
Dialogue: 0,0:11:30.16,0:11:34.16,Default,,0,0,0,,Бұл аздап қауіпті ме?
Dialogue: 0,0:11:30.16,0:11:34.16,Default,,0,0,0,,Мен көремін... сонда кем дегенде...
Dialogue: 0,0:11:34.16,0:11:36.17,Default,,0,0,0,,《Фактілерді қайта тексеріңіз...》
Dialogue: 0,0:11:36.17,0:11:38.67,Default,,0,0,0,,Маған мүмкіндігінше қатты бас
Dialogue: 0,0:11:38.67,0:11:41.50,Default,,0,0,0,,《О!?》
Dialogue: 0,0:11:41.50,0:11:45.34,Default,,0,0,0,,Қалай... қалай болды?
Dialogue: 0,0:11:41.50,0:11:45.34,Default,,0,0,0,,Дұрыс айттыңыз...
Dialogue: 0,0:11:45.34,0:11:48.34,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:45.34,0:11:48.34,Default,,0,0,0,,Оның ояу болғанына сене алар емеспін...
Dialogue: 0,0:11:48.34,0:11:51.01,Default,,0,0,0,,Көрдім... Ақыр аяғында мен ояу едім.
Dialogue: 0,0:11:51.01,0:11:53.52,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:11:51.01,0:11:53.52,Default,,0,0,0,,Қайтадан қош келдіңіз~
Dialogue: 0,0:11:53.52,0:11:56.45,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:11:53.52,0:11:56.45,Default,,0,0,0,,Кешкі ас жарайды ма?
Dialogue: 0,0:11:56.45,0:12:00.29,Default,,0,0,0,,Уайымдамаңыз! Уайымдама! дәл қазір
Dialogue: 0,0:11:56.45,0:12:00.29,Default,,0,0,0,,Енді біздің кезегіміз
Dialogue: 0,0:12:00.29,0:12:05.13,Default,,0,0,0,,Мен оны уақытында жасағаныма қуаныштымын.
Dialogue: 0,0:12:00.29,0:12:05.13,Default,,0,0,0,,Бұл жақсы, бірақ...
Dialogue: 0,0:12:05.13,0:12:07.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:05.13,0:12:07.96,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:12:07.96,0:12:11.30,Default,,0,0,0,,А...
Dialogue: 0,0:12:07.96,0:12:11.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:11.30,0:12:15.14,Default,,0,0,0,,Қандай да бір себептермен Иори және басқалар
Dialogue: 0,0:12:11.30,0:12:15.14,Default,,0,0,0,,Біртүрлі атмосфера бар, солай емес пе?
Dialogue: 0,0:12:15.14,0:12:17.97,Default,,0,0,0,,Iori?
Dialogue: 0,0:12:15.14,0:12:17.97,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:12:17.97,0:12:19.97,Default,,0,0,0,,Атап айтқанда, ештеңе жоқ
Dialogue: 0,0:12:36.83,0:12:40.33,Default,,0,0,0,,А... Чиса?
Dialogue: 0,0:12:42.33,0:12:45.33,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:12:42.33,0:12:45.33,Default,,0,0,0,,Менімен бірге болыңыз
Dialogue: 0,0:12:45.33,0:12:48.17,Default,,0,0,0,,Иә? Иоридің дауысы...
Dialogue: 0,0:12:48.17,0:12:51.01,Default,,0,0,0,,Жоқ, бұл екеуі
Dialogue: 0,0:12:48.17,0:12:51.01,Default,,0,0,0,,Біз кездесе бастағанымыз үшін➡︎
Dialogue: 0,0:12:51.01,0:12:53.01,Default,,0,0,0,,Жасырын...
Dialogue: 0,0:12:53.01,0:12:56.45,Default,,0,0,0,,Мен суланып бара жатырмын ...
Dialogue: 0,0:12:53.01,0:12:56.45,Default,,0,0,0,,Киіміңді шешіп алған дұрыс
Dialogue: 0,0:12:56.45,0:12:59.62,Default,,0,0,0,,Боу?
Dialogue: 0,0:12:56.45,0:12:59.62,Default,,0,0,0,,Түсіндім. Оны шешіңіз.
Dialogue: 0,0:12:59.62,0:13:03.95,Default,,0,0,0,,Жарайды, онда... жасайық.
Dialogue: 0,0:12:59.62,0:13:03.95,Default,,0,0,0,,На… на…
Dialogue: 0,0:13:03.95,0:13:06.35,Default,,0,0,0,,Не істеп жатырсың...!
Dialogue: 0,0:13:08.62,0:13:11.79,Default,,0,0,0,,Сіз шынымен не істеп жатырсыз?!
Dialogue: 0,0:13:11.79,0:13:14.80,Default,,0,0,0,,Гохо! Кебако! Сіз мұнда не істеп жүрсіз?
Dialogue: 0,0:13:14.80,0:13:16.80,Default,,0,0,0,,Бұл менің жолым!
Dialogue: 0,0:13:16.80,0:13:20.14,Default,,0,0,0,,Егер сіз бірдеңе дұрыс емес деп ойласаңыз
Dialogue: 0,0:13:16.80,0:13:20.14,Default,,0,0,0,,Оның жүріс-тұрысы да біртүрлі!
Dialogue: 0,0:13:20.14,0:13:23.64,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:13:20.14,0:13:23.64,Default,,0,0,0,,Сіз әмияныңызды бассейнге тастадыңыз...
Dialogue: 0,0:13:23.64,0:13:27.81,Default,,0,0,0,,Қаншама ақымақтық!
Dialogue: 0,0:13:23.64,0:13:27.81,Default,,0,0,0,,Иори... Шынымды айтсам.
Dialogue: 0,0:13:27.81,0:13:30.65,Default,,0,0,0,,Кешеден бері
Dialogue: 0,0:13:27.81,0:13:30.65,Default,,0,0,0,,Сіз бірдеңені жасырып тұрсыз ба?
Dialogue: 0,0:13:30.65,0:13:34.48,Default,,0,0,0,,Ух... ха... Қолымнан келмейді.
Dialogue: 0,0:13:30.65,0:13:34.48,Default,,0,0,0,,Сіз шыншылсыз ба?
Dialogue: 0,0:13:34.48,0:13:36.49,Default,,0,0,0,,Кебако
Dialogue: 0,0:13:34.48,0:13:36.49,Default,,0,0,0,,Иә
Dialogue: 0,0:13:36.49,0:13:38.99,Default,,0,0,0,,Шын мәнінде, бұл суға түсу тәжірибесі.
Dialogue: 0,0:13:38.99,0:13:41.32,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:38.99,0:13:41.32,Default,,0,0,0,,Сен маған шындықты айтпайсың ба!
Dialogue: 0,0:13:41.32,0:13:43.49,Default,,0,0,0,,Мен саған шындықты айттым!?
Dialogue: 0,0:13:43.49,0:13:47.50,Default,,0,0,0,,Себебі ол озық пайдаланушылар үшін анық.
Dialogue: 0,0:13:43.49,0:13:47.50,Default,,0,0,0,,Сіз біртүрлі нәрсе істеп жатырсыз!
Dialogue: 0,0:13:47.50,0:13:50.00,Default,,0,0,0,,Жоқ... бұл жаңадан бастағандар үшін көбірек.
Dialogue: 0,0:13:50.00,0:13:53.84,Default,,0,0,0,,Айна бұл
Dialogue: 0,0:13:50.00,0:13:53.84,Default,,0,0,0,,Өйткені бұл шын мәнінде суға түсу жаттығуы.
Dialogue: 0,0:13:53.84,0:13:58.77,Default,,0,0,0,,Ә? Шынында ма?
Dialogue: 0,0:13:53.84,0:13:58.77,Default,,0,0,0,,Неліктен бұл Чиса деп ойлайсың?
Dialogue: 0,0:13:58.77,0:14:02.11,Default,,0,0,0,,Ендеше бетперделерді тазалауға жаттығып көрейік...
Dialogue: 0,0:14:02.11,0:14:05.78,Default,,0,0,0,,Мен... сонда түсінемін
Dialogue: 0,0:14:02.11,0:14:05.78,Default,,0,0,0,,Егер сіз мұны басынан бастап айтқан болсаңыз...
Dialogue: 0,0:14:05.78,0:14:08.45,Default,,0,0,0,,Сізді күлдіретін нәрсе
Dialogue: 0,0:14:05.78,0:14:08.45,Default,,0,0,0,,Өйткені бұл акула
Dialogue: 0,0:14:08.45,0:14:11.95,Default,,0,0,0,,Күлме!
Dialogue: 0,0:14:08.45,0:14:11.95,Default,,0,0,0,,Айтсаңыз, мен сізге көмектескенім жөн болар еді.
Dialogue: 0,0:14:11.95,0:14:14.29,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:14:11.95,0:14:14.29,Default,,0,0,0,,Бір минут... Не туралы айтып тұрсың? Осы сәтте...
Dialogue: 0,0:14:14.29,0:14:18.09,Default,,0,0,0,,Сонымен? Не істеуім керек?
Dialogue: 0,0:14:14.29,0:14:18.09,Default,,0,0,0,,О! Сонда...
Dialogue: 0,0:14:21.30,0:14:25.80,Default,,0,0,0,,Хмм... Аа...
Dialogue: 0,0:14:25.80,0:14:28.47,Default,,0,0,0,,Жабайы болма
Dialogue: 0,0:14:25.80,0:14:28.47,Default,,0,0,0,,Шатаспаңыз!
Dialogue: 0,0:14:28.47,0:14:31.81,Default,,0,0,0,,Сәлеметсіз бе, сіз полициясыз ба?
Dialogue: 0,0:14:31.81,0:14:34.81,Default,,0,0,0,,Маскада әлі су қалады...
Dialogue: 0,0:14:34.81,0:14:39.48,Default,,0,0,0,,Аз ғана уақыт қалған сияқты.
Dialogue: 0,0:14:34.81,0:14:39.48,Default,,0,0,0,,Мүмкін сіз әлі де судан қорқатын шығарсыз?
Dialogue: 0,0:14:39.48,0:14:41.98,Default,,0,0,0,,Жақсы! Егер бұл орын алса, мен мұны істеймін бе?
Dialogue: 0,0:14:41.98,0:14:43.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:41.98,0:14:43.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:43.99,0:14:48.16,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:14:43.99,0:14:48.16,Default,,0,0,0,,Бұл мен бұрын қолданған әдіс...
Dialogue: 0,0:14:48.16,0:14:51.49,Default,,0,0,0,,Бұл монша... Бұл монша...
Dialogue: 0,0:14:51.49,0:14:54.33,Default,,0,0,0,,Сіз мұны бұрын жасадыңыз ба?
Dialogue: 0,0:14:51.49,0:14:54.33,Default,,0,0,0,,Өйткені мен маңызды емеспін
Dialogue: 0,0:14:54.33,0:14:57.10,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:14:54.33,0:14:57.10,Default,,0,0,0,,Бұл шынымен тиімді ме?
Dialogue: 0,0:14:57.10,0:15:01.60,Default,,0,0,0,,Жоқ, мүлде емес.
Dialogue: 0,0:14:57.10,0:15:01.60,Default,,0,0,0,,Иә? Сонымен, сіз не істемексіз?
Dialogue: 0,0:15:06.28,0:15:11.61,Default,,0,0,0,,Бұл жақынырақ
Dialogue: 0,0:15:06.28,0:15:11.61,Default,,0,0,0,,Себебі сізді көруге болады.
Dialogue: 0,0:15:11.61,0:15:16.62,Default,,0,0,0,,Мен не істей аламын?
Dialogue: 0,0:15:11.61,0:15:16.62,Default,,0,0,0,,Мен мұның бәрін орындағым келеді.
Dialogue: 0,0:15:16.62,0:15:18.95,Default,,0,0,0,,Ендеше алдымен ұйықтап ал.
Dialogue: 0,0:15:18.95,0:15:22.12,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:15:18.95,0:15:22.12,Default,,0,0,0,,Мұны да модерациямен орындау керек.
Dialogue: 0,0:15:22.12,0:15:24.29,Default,,0,0,0,,Менімен бірге болғандарыңызға рахмет.
Dialogue: 0,0:15:24.29,0:15:26.30,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:15:24.29,0:15:26.30,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:15:26.30,0:15:29.80,Default,,0,0,0,,Қайырлы түн~
Dialogue: 0,0:15:29.80,0:15:31.90,Default,,0,0,0,,ал біз батырлармыз.
Dialogue: 0,0:15:38.97,0:15:42.65,Default,,0,0,0,,Буха! Жарайды... осылай.
Dialogue: 0,0:15:42.65,0:15:45.65,Default,,0,0,0,,Мм... кешіріңіз.
Dialogue: 0,0:15:42.65,0:15:45.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:45.65,0:15:48.82,Default,,0,0,0,,Мен полиция қызметкерімін...
Dialogue: 0,0:15:45.65,0:15:48.82,Default,,0,0,0,,Уау
Dialogue: 0,0:15:48.82,0:15:51.65,Default,,0,0,0,,Эксцентрлік мінез-құлықпен айналысатын ерлер мен әйелдер бар.
Dialogue: 0,0:15:48.82,0:15:51.65,Default,,0,0,0,,Біз есеп алдық.
Dialogue: 0,0:15:51.65,0:15:55.42,Default,,0,0,0,,О... жоқ...
Dialogue: 0,0:15:51.65,0:15:55.42,Default,,0,0,0,,Қателік бар емес пе?
Dialogue: 0,0:15:55.42,0:15:59.43,Default,,0,0,0,,Күдікті адамдар кімдер?
Dialogue: 0,0:15:55.42,0:15:59.43,Default,,0,0,0,,Оны ешкім көрмеді. Хахахаха
Dialogue: 0,0:15:59.43,0:16:02.43,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:15:59.43,0:16:02.43,Default,,0,0,0,,Иә. Бұл қандай қауіпті адам➡︎
Dialogue: 0,0:16:02.43,0:16:04.77,Default,,0,0,0,,Көлеңкелер мен пішіндер...
Dialogue: 0,0:16:02.43,0:16:04.77,Default,,0,0,0,,Хмм…
Dialogue: 0,0:16:04.77,0:16:09.94,Default,,0,0,0,,Тек сенімді болу үшін күдікті адам жоқ.
Dialogue: 0,0:16:04.77,0:16:09.94,Default,,0,0,0,,Мен айналама қараймын.
Dialogue: 0,0:16:09.94,0:16:12.84,Default,,0,0,0,,Ой... Жарайды...
Dialogue: 0,0:16:15.78,0:16:18.08,Default,,0,0,0,,《Мен шыға алмаймын! 》
Dialogue: 0,0:16:28.62,0:16:32.46,Default,,0,0,0,,Иоридің суық тиіп құлағанын айтады.
Dialogue: 0,0:16:28.62,0:16:32.46,Default,,0,0,0,,Солай сияқты...
Dialogue: 0,0:16:32.46,0:16:37.47,Default,,0,0,0,,Оянсам, жанымда бетім қызарып кетті.
Dialogue: 0,0:16:32.46,0:16:37.47,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:16:37.47,0:16:40.64,Default,,0,0,0,,Иори күткендей!
Dialogue: 0,0:16:37.47,0:16:40.64,Default,,0,0,0,,Бақастар да суық тиеді➡︎
Dialogue: 0,0:16:40.64,0:16:42.64,Default,,0,0,0,,Бұл сәл басқаша.
Dialogue: 0,0:16:42.64,0:16:46.14,Default,,0,0,0,,Бұл соншалықты ыстық емес.
Dialogue: 0,0:16:42.64,0:16:46.14,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:16:46.14,0:16:48.31,Default,,0,0,0,,Бүгінгі тәжірибелік сабақ мүмкін емес.
Dialogue: 0,0:16:48.31,0:16:50.98,Default,,0,0,0,,Себебі мен біртүрлі нәрсе айттым...
Dialogue: 0,0:16:50.98,0:16:54.65,Default,,0,0,0,,Жоқ, жоқ, жоқ! Нанака-санға
Dialogue: 0,0:16:50.98,0:16:54.65,Default,,0,0,0,,Мен жауапты емеспін деп ойлаймын.
Dialogue: 0,0:16:54.65,0:16:58.25,Default,,0,0,0,,Эксцентриситет айқын
Dialogue: 0,0:16:54.65,0:16:58.25,Default,,0,0,0,,Бұл оның өз жауапкершілігі.
Dialogue: 0,0:16:58.25,0:17:00.26,Default,,0,0,0,,Міне, сондықтан...
Dialogue: 0,0:17:00.26,0:17:02.26,Default,,0,0,0,,Иориден келген
Dialogue: 0,0:17:00.26,0:17:02.26,Default,,0,0,0,,Ұйықтап алайық
Dialogue: 0,0:17:02.26,0:17:06.10,Default,,0,0,0,,Айна мен Кохеи өздері
Dialogue: 0,0:17:02.26,0:17:06.10,Default,,0,0,0,,Мен лицензия алуға назар аударуым керек.
Dialogue: 0,0:17:06.10,0:17:08.30,Default,,0,0,0,,Иә
Dialogue: 0,0:17:06.10,0:17:08.30,Default,,0,0,0,,Қосымша күштер! Біз тез арада қорғаныс жасауымыз керек, әйтпесе қайтадан қоршауға алынамыз.
Dialogue: 0,0:17:15.94,0:17:19.44,Default,,0,0,0,,Мм... Тез ұйықтағаннан кейін
Dialogue: 0,0:17:15.94,0:17:19.44,Default,,0,0,0,,Өте сергітеді!
Dialogue: 0,0:17:19.44,0:17:22.11,Default,,0,0,0,,ертең оны үйіңізге әкеліп береміз.
Dialogue: 0,0:17:22.11,0:17:25.45,Default,,0,0,0,,Ой! Өзіңді жақсы сезініп тұрған сияқтысың, Иори.
Dialogue: 0,0:17:25.45,0:17:28.45,Default,,0,0,0,,Азуса-сан
Dialogue: 0,0:17:25.45,0:17:28.45,Default,,0,0,0,,Сіз дайвингке бармадыңыз ба?
Dialogue: 0,0:17:28.45,0:17:31.29,Default,,0,0,0,,Ал...
Dialogue: 0,0:17:28.45,0:17:31.29,Default,,0,0,0,,Кешіріңіз... бұл менің кінәм.
Dialogue: 0,0:17:31.29,0:17:33.46,Default,,0,0,0,,Не не!
Dialogue: 0,0:17:33.46,0:17:37.13,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:17:33.46,0:17:37.13,Default,,0,0,0,,Мен дерлік қалпына келдім.
Dialogue: 0,0:17:37.13,0:17:39.63,Default,,0,0,0,,Шынымды айтсам, медицина да.
Dialogue: 0,0:17:37.13,0:17:39.63,Default,,0,0,0,,Мен оны ішуім керек еді➡︎
Dialogue: 0,0:17:39.63,0:17:43.30,Default,,0,0,0,,Дәріхана жұмыс істемейді.
Dialogue: 0,0:17:39.63,0:17:43.30,Default,,0,0,0,,Бұлай алысқа барудың қажеті жоқ...
Dialogue: 0,0:17:43.30,0:17:45.30,Default,,0,0,0,,Жоқ! Иори!
Dialogue: 0,0:17:45.30,0:17:48.97,Default,,0,0,0,,Мен ертеңнен кейін де теңізде боламын.
Dialogue: 0,0:17:45.30,0:17:48.97,Default,,0,0,0,,Мен оны дұрыстап алуым керек!
Dialogue: 0,0:17:48.97,0:17:51.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:48.97,0:17:51.97,Default,,0,0,0,,Дәрі жоқ ➡︎
Dialogue: 0,0:17:51.97,0:17:54.17,Default,,0,0,0,,Осыған байланысты
Dialogue: 0,0:17:51.97,0:17:54.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:58.75,0:18:01.75,Default,,0,0,0,,Азуса-сан... бұл не?
Dialogue: 0,0:17:58.75,0:18:01.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:01.75,0:18:03.75,Default,,0,0,0,,Атақты халық емдері Білмейсіз бе?
Dialogue: 0,0:18:03.75,0:18:05.75,Default,,0,0,0,,《Білемін... білемін, бірақ➡︎
Dialogue: 0,0:18:05.75,0:18:07.76,Default,,0,0,0,,Есептер 1 және 2➡︎
Dialogue: 0,0:18:07.76,0:18:09.76,Default,,0,0,0,,Қайсысы?》
Dialogue: 0,0:18:09.76,0:18:12.76,Default,,0,0,0,,Олай болса, Иори...
Dialogue: 0,0:18:09.76,0:18:12.76,Default,,0,0,0,,Ха... иә...
Dialogue: 0,0:18:12.76,0:18:16.10,Default,,0,0,0,,Басыңызды сыртқа шығарыңыз
Dialogue: 0,0:18:12.76,0:18:16.10,Default,,0,0,0,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:18:16.10,0:18:18.10,Default,,0,0,0,,《Жақсы, 1...》
Dialogue: 0,0:18:18.10,0:18:22.94,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:18:18.10,0:18:22.94,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:18:22.94,0:18:26.84,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:18:22.94,0:18:26.84,Default,,0,0,0,,Рахмет... Иә?
Dialogue: 0,0:18:29.45,0:18:33.62,Default,,0,0,0,,Келесі жолы оны алып тастай аласыз ба?
Dialogue: 0,0:18:29.45,0:18:33.62,Default,,0,0,0,,О, комбинация техникасы!
Dialogue: 0,0:18:33.62,0:18:36.29,Default,,0,0,0,,Ах... Азуса-сан!
Dialogue: 0,0:18:33.62,0:18:36.29,Default,,0,0,0,,Алысқа барудың қажеті жоқ!
Dialogue: 0,0:18:36.29,0:18:40.62,Default,,0,0,0,,Жоқ, жоқ. Дәрі жоқ.
Dialogue: 0,0:18:36.29,0:18:40.62,Default,,0,0,0,,Мен мұны істеуім керек ...
Dialogue: 0,0:18:40.62,0:18:43.46,Default,,0,0,0,,《Ух... жақсы емес. Осылай жалғаса берсе➡︎
Dialogue: 0,0:18:43.46,0:18:47.80,Default,,0,0,0,,Денсаулықтан басқа нәрсеге зиян келтіріңіз! 》
Dialogue: 0,0:18:47.80,0:18:49.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:47.80,0:18:49.80,Default,,0,0,0,,Дәрі ретінде қолдануға болатын басқа заттар➡︎
Dialogue: 0,0:18:49.80,0:18:53.14,Default,,0,0,0,,Мен оны іздеймін!
Dialogue: 0,0:18:53.14,0:18:56.41,Default,,0,0,0,,Бұл дәрі ретінде
Dialogue: 0,0:18:53.14,0:18:56.41,Default,,0,0,0,,Бұл тамаша емес пе?
Dialogue: 0,0:18:56.41,0:19:02.91,Default,,0,0,0,,Әрине. Стерилизация әсері Терлеу әсері
Dialogue: 0,0:18:56.41,0:19:02.91,Default,,0,0,0,,Ұйқыға шақыратын және нәрлі
Dialogue: 0,0:19:02.91,0:19:05.25,Default,,0,0,0,,Хякуяку көшбасшысынан күткендей!
Dialogue: 0,0:19:05.25,0:19:07.92,Default,,0,0,0,,Ауру адамдарға ішуге болмайды
Dialogue: 0,0:19:05.25,0:19:07.92,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:19:07.92,0:19:12.09,Default,,0,0,0,,Бірақ мен ішімдік ішіп, қазір ұйықтасам,
Dialogue: 0,0:19:07.92,0:19:12.09,Default,,0,0,0,,Түнде қайтадан ұйықтай алмайсыз ба?
Dialogue: 0,0:19:12.09,0:19:15.26,Default,,0,0,0,,Біз алғаш кездескенде түн бойы
Dialogue: 0,0:19:12.09,0:19:15.26,Default,,0,0,0,,Түнде ұйықтай алмайтын сияқтысың.
Dialogue: 0,0:19:15.26,0:19:18.93,Default,,0,0,0,,Бұл тағы бір себеп...
Dialogue: 0,0:19:15.26,0:19:18.93,Default,,0,0,0,,Басқа себеп?
Dialogue: 0,0:19:18.93,0:19:20.93,Default,,0,0,0,,Жоқ... себебі ➡︎ қараңыз
Dialogue: 0,0:19:20.93,0:19:23.27,Default,,0,0,0,,Азуса-сан және Нанака-сан
Dialogue: 0,0:19:20.93,0:19:23.27,Default,,0,0,0,,Қасымда ұйықтасаң➡︎
Dialogue: 0,0:19:23.27,0:19:27.77,Default,,0,0,0,,Әдетте мен қобалжыймын, ұйықтай алмаймын.
Dialogue: 0,0:19:23.27,0:19:27.77,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:19:27.77,0:19:32.11,Default,,0,0,0,,Бұл жаман нәрсе болды.
Dialogue: 0,0:19:27.77,0:19:32.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:32.11,0:19:34.94,Default,,0,0,0,,Азуса-сан?
Dialogue: 0,0:19:32.11,0:19:34.94,Default,,0,0,0,,Ясса Иори
Dialogue: 0,0:19:34.94,0:19:36.95,Default,,0,0,0,,Иә
Dialogue: 0,0:19:36.95,0:19:40.12,Default,,0,0,0,,Біз жыныстық қатынасқа түсеміз бе?
Dialogue: 0,0:19:40.12,0:19:43.95,Default,,0,0,0,,Бұлхо! Гохо... Гохо...
Dialogue: 0,0:19:40.12,0:19:43.95,Default,,0,0,0,,Иә!? Не кенеттен...
Dialogue: 0,0:19:43.95,0:19:45.96,Default,,0,0,0,,Сонда сіз қобалжымайсыз.
Dialogue: 0,0:19:45.96,0:19:48.79,Default,,0,0,0,,Жоқ, жоқ, жоқ... солай
Dialogue: 0,0:19:45.96,0:19:48.79,Default,,0,0,0,,Менің ойымша, бұл жеңіл қарау керек нәрсе!
Dialogue: 0,0:19:48.79,0:19:53.96,Default,,0,0,0,,Мм! Дөрекі! Мен де
Dialogue: 0,0:19:48.79,0:19:53.96,Default,,0,0,0,,Әлгі біртүрлі жігіттер мұны істемейді.
Dialogue: 0,0:19:53.96,0:19:55.97,Default,,0,0,0,,А...
Dialogue: 0,0:19:55.97,0:19:58.47,Default,,0,0,0,,Бірақ Иори туралы не деуге болады?
Dialogue: 0,0:19:55.97,0:19:58.47,Default,,0,0,0,,Өйткені маған ұнайды➡︎
Dialogue: 0,0:19:58.47,0:20:00.64,Default,,0,0,0,,Менің ойымша, бір рет жасаған дұрыс.
Dialogue: 0,0:20:00.64,0:20:02.97,Default,,0,0,0,,《Қандай спорттық сезім...》
Dialogue: 0,0:20:02.97,0:20:05.14,Default,,0,0,0,,Не... Мен жартылай қалжыңдап тұрмын.
Dialogue: 0,0:20:05.14,0:20:07.98,Default,,0,0,0,,Егер сіз жұлқынып кетсеңіз
Dialogue: 0,0:20:05.14,0:20:07.98,Default,,0,0,0,,Бұл қызықсыз
Dialogue: 0,0:20:07.98,0:20:09.98,Default,,0,0,0,,Өзім көзіммен құлағанын көрген әлсіз адам.
Dialogue: 0,0:20:09.98,0:20:13.65,Default,,0,0,0,,Сонымен... жартысы
Dialogue: 0,0:20:13.65,0:20:16.95,Default,,0,0,0,,Егер сіз мұны шынымен жасағыңыз келсе
Dialogue: 0,0:20:13.65,0:20:16.95,Default,,0,0,0,,Жарайды, бірақ?
Dialogue: 0,0:20:20.82,0:20:22.83,Default,,0,0,0,,Қарғыс атсын... Қарғыс атсын...
Dialogue: 0,0:20:22.83,0:20:26.33,Default,,0,0,0,,《Мен сынақтан өтіп жатырмын. Мен қазір➡︎мін
Dialogue: 0,0:20:26.33,0:20:31.67,Default,,0,0,0,,Уау... Мені сынап жатыр! 》
Dialogue: 0,0:20:31.67,0:20:34.00,Default,,0,0,0,,Иә...
Dialogue: 0,0:20:34.00,0:20:38.70,Default,,0,0,0,,Метокимасу...
Dialogue: 0,0:20:34.00,0:20:38.70,Default,,0,0,0,,Ахаха! Бұл ұят
Dialogue: 0,0:20:40.84,0:20:43.85,Default,,0,0,0,,Айтпақшы, Азуса-сан
Dialogue: 0,0:20:40.84,0:20:43.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:43.85,0:20:47.18,Default,,0,0,0,,Нанака-саннан басқа
Dialogue: 0,0:20:43.85,0:20:47.18,Default,,0,0,0,,Токита-сенпай саған да ұнайды, солай ма?
Dialogue: 0,0:20:47.18,0:20:50.19,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:20:47.18,0:20:50.19,Default,,0,0,0,,Сосын Токита-сенпай➡︎
Dialogue: 0,0:20:50.19,0:20:52.69,Default,,0,0,0,,Сіз жақындамайсыз ба?
Dialogue: 0,0:20:52.69,0:20:56.46,Default,,0,0,0,,Мм... Тоқкиді➡︎ қалай атайсың
Dialogue: 0,0:20:56.46,0:20:58.63,Default,,0,0,0,,Бұл жеміссіз махаббат емес пе?
Dialogue: 0,0:20:58.63,0:21:00.80,Default,,0,0,0,,《Нанака-сан деген кім?
Dialogue: 0,0:20:58.63,0:21:00.80,Default,,0,0,0,,Олай емес пе?》
Dialogue: 0,0:21:00.80,0:21:04.97,Default,,0,0,0,,Неліктен бедеу?
Dialogue: 0,0:21:00.80,0:21:04.97,Default,,0,0,0,,Иә? Сіз Иориді білмейсіз бе?
Dialogue: 0,0:21:04.97,0:21:08.47,Default,,0,0,0,,Қый!
Dialogue: 0,0:21:04.97,0:21:08.47,Default,,0,0,0,,Себебі Токихаса➡︎
Dialogue: 0,0:21:08.47,0:21:10.87,Default,,0,0,0,,Менің қызым бар.
Dialogue: 0,0:21:13.14,0:21:16.48,Default,,0,0,0,,Иә? Бұл адамның қызы бар ма?
Dialogue: 0,0:21:16.48,0:21:18.48,Default,,0,0,0,,Иә, ол
Dialogue: 0,0:21:16.48,0:21:18.48,Default,,0,0,0,,Үй?
Dialogue: 0,0:21:18.48,0:21:21.48,Default,,0,0,0,,Бұл қалай болуы мүмкін?
Dialogue: 0,0:21:18.48,0:21:21.48,Default,,0,0,0,,Гомо қоспалары?
Dialogue: 0,0:21:21.48,0:21:24.99,Default,,0,0,0,,А, сен жарыс туралы сұрадың ба?
Dialogue: 0,0:21:21.48,0:21:24.99,Default,,0,0,0,,Ол адам.
Dialogue: 0,0:21:24.99,0:21:29.49,Default,,0,0,0,,Түсіндім... Тоқыта-сенпайдың қызы бар!
Dialogue: 0,0:21:24.99,0:21:29.49,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:21:29.49,0:21:31.66,Default,,0,0,0,,Хахахаха...!
Dialogue: 0,0:21:31.66,0:21:34.50,Default,,0,0,0,,Ішейік!
Dialogue: 0,0:21:31.66,0:21:34.50,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:21:34.50,0:21:37.50,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:21:34.50,0:21:37.50,Default,,0,0,0,,Менен басқа адам мұны қалай істей алды?
Dialogue: 0,0:21:37.50,0:21:40.67,Default,,0,0,0,,О! Бұл көп ішу керек!
Dialogue: 0,0:21:37.50,0:21:40.67,Default,,0,0,0,,Ахахха! Жүр, жүр!
Dialogue: 0,0:21:40.67,0:21:43.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:43.84,0:21:48.34,Default,,0,0,0,,Көңілді
Dialogue: 0,0:21:43.84,0:21:48.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:48.34,0:21:50.85,Default,,0,0,0,,Лицензия алуыңызбен құттықтаймыз
Dialogue: 0,0:21:50.85,0:21:54.35,Default,,0,0,0,,Енді сендер де жақсы сүңгуірсіңдер.
Dialogue: 0,0:21:50.85,0:21:54.35,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,0:21:54.35,0:21:58.95,Default,,0,0,0,,Бұл жігіт күдікті сияқты.
Dialogue: 0,0:21:54.35,0:21:58.95,Default,,0,0,0,,Әй... Мен қазірден бастап сауығып кетемін!
Dialogue: 0,0:21:58.95,0:22:00.96,Default,,0,0,0,,Хахаха! Бұл рух!
Dialogue: 0,0:22:00.96,0:22:05.29,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:22:00.96,0:22:05.29,Default,,0,0,0,,Ақырында, ертең Миякодзима!
Dialogue: 0,0:22:05.29,0:22:09.39,Default,,0,0,0,,Олай болса, тойлайық...
Dialogue: 0,0:22:05.29,0:22:09.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:11.80,0:22:15.47,Default,,0,0,0,,♬~
Dialogue: 0,0:22:15.47,0:22:17.64,Default,,0,0,0,,Бірінші ашылған сияқты.
Dialogue: 0,0:22:17.64,0:22:22.44,Default,,0,0,0,,Сіздің толық қалпына келгеніңізді көру өте жақсы!
Dialogue: 0,0:22:17.64,0:22:22.44,Default,,0,0,0,,О, сен өте жылдамсың.
Dialogue: 0,0:22:25.31,0:22:27.31,Default,,0,0,0,,《M…》
Dialogue: 0,0:22:28.81,0:22:34.81,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
