Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:35.90,0:00:39.37,Default,,0,0,0,,Уф! Уф... Уф!
Dialogue: 0,0:00:39.37,0:00:42.85,Default,,0,0,0,,Гуах! Апыр-ай! Гооооооо!
Dialogue: 0,0:00:42.85,0:00:45.46,Default,,0,0,0,,～
Dialogue: 0,0:00:45.46,0:00:50.56,Default,,0,0,0,,～ ～ ～
Dialogue: 0,0:00:50.56,0:00:53.80,Default,,0,0,0,,～
Dialogue: 0,0:00:53.80,0:00:59.89,Default,,0,0,0,,Сен
Dialogue: 0,0:00:59.89,0:01:01.99,Default,,0,0,0,,Жақында кездесеміз.
Dialogue: 0,0:01:04.88,0:01:24.65,Default,,0,0,0,,Сен
Dialogue: 0,0:01:24.65,0:01:44.55,Default,,0,0,0,,Сен
Dialogue: 0,0:01:44.55,0:02:04.59,Default,,0,0,0,,Сен
Dialogue: 0,0:02:04.59,0:02:22.69,Default,,0,0,0,,Сен
Dialogue: 0,0:02:28.46,0:02:34.56,Default,,0,0,0,,Сен
Dialogue: 0,0:02:47.01,0:02:50.02,Default,,0,0,0,,Қайырлы таң. (Қара) О.
Dialogue: 0,0:02:50.02,0:02:52.62,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:03:02.19,0:03:15.07,Default,,0,0,0,,Сен
Dialogue: 0,0:03:15.07,0:03:17.59,Default,,0,0,0,,Ах... пелмен.
Dialogue: 0,0:03:17.59,0:03:19.81,Default,,0,0,0,,Пельмени, солай ма? Эй!
Dialogue: 0,0:03:19.81,0:03:22.93,Default,,0,0,0,,Иә. Иә, мен де көмектесемін.
Dialogue: 0,0:03:22.93,0:03:24.97,Default,,0,0,0,,Қажет емес. Неліктен?
Dialogue: 0,0:03:24.97,0:03:28.27,Default,,0,0,0,,Мен бұл заттарды толтыруға ғана шебермін.
Dialogue: 0,0:03:30.56,0:03:33.43,Default,,0,0,0,,Ей, көже пісірейік.
Dialogue: 0,0:03:33.43,0:03:35.91,Default,,0,0,0,,Мен бұған жауапты боламын.
Dialogue: 0,0:03:35.91,0:03:42.67,Default,,0,0,0,,Сен
Dialogue: 0,0:03:42.67,0:03:46.39,Default,,0,0,0,,Ет тоқаш? Жоқ, бұл пелмен.
Dialogue: 0,0:03:46.39,0:03:50.39,Default,,0,0,0,,Орыс тағамдары. Астында сорпа бар, солай ма?
Dialogue: 0,0:03:52.23,0:03:54.78,Default,,0,0,0,,Дәмді. Дұрыс па?
Dialogue: 0,0:03:54.78,0:03:56.85,Default,,0,0,0,,Ет тоқаш.
Dialogue: 0,0:03:56.85,0:03:59.22,Default,,0,0,0,,Сондықтан оны пельмен деп атайды...
Dialogue: 0,0:03:59.22,0:04:02.70,Default,,0,0,0,,Шілдеге еліктейміз бе? Бұл өте үлкен.
Dialogue: 0,0:04:02.70,0:04:04.77,Default,,0,0,0,,Оны жесең, ол бірдей.
Dialogue: 0,0:04:04.77,0:04:07.63,Default,,0,0,0,,Сен
Dialogue: 0,0:04:07.63,0:04:09.88,Default,,0,0,0,,Бүгін біз бөлек қозғаламыз.
Dialogue: 0,0:04:09.88,0:04:14.95,Default,,0,0,0,,Сіз басқа жерге барасыз ба? Менің айналысатын шаруам бар.
Dialogue: 0,0:04:14.95,0:04:17.07,Default,,0,0,0,,Мен де саған көмектесемін.
Dialogue: 0,0:04:17.07,0:04:19.67,Default,,0,0,0,,Сізде бір нәрсе істеу керек.
Dialogue: 0,0:04:21.21,0:04:25.71,Default,,0,0,0,,Мен өзіме қамқорлық жасаймын.
Dialogue: 0,0:04:25.71,0:04:28.08,Default,,0,0,0,,Сіз қайтып келесіз, солай ма?
Dialogue: 0,0:04:28.08,0:04:33.38,Default,,0,0,0,,Маған уәде бер. Мен өзіме де талғампазмын. сондықтан….
Dialogue: 0,0:04:34.87,0:04:36.87,Default,,0,0,0,,​​Түсіндім.
Dialogue: 0,0:04:38.29,0:04:40.29,Default,,0,0,0,,Банг (есік дыбысы)
Dialogue: 0,0:04:41.68,0:04:44.86,Default,,0,0,0,,BK201 Йоконы алады!?
Dialogue: 0,0:04:44.86,0:04:47.77,Default,,0,0,0,,Сіз сенімдісіз бе? (Кобаяши) Йокоды кім ұрлап әкетті?
Dialogue: 0,0:04:47.77,0:04:51.22,Default,,0,0,0,,Бұл ол. Оған күмән жоқ. →
Dialogue: 0,0:04:51.22,0:04:55.82,Default,,0,0,0,,Ол Изанамидің қайда екенін Йокодан білген шығар.
Dialogue: 0,0:04:55.82,0:04:58.88,Default,,0,0,0,,Мұны Йоко білді ме?
Dialogue: 0,0:04:58.88,0:05:02.21,Default,,0,0,0,,Изанамиге келсек, Хазуки екеуміз келісеміз. →
Dialogue: 0,0:05:02.21,0:05:05.00,Default,,0,0,0,,Сіз Михаил Павличенконың → болып қала бересіз
Dialogue: 0,0:05:05.00,0:05:08.57,Default,,0,0,0,,Балаңызды іздеңіз. Мүмкіндігінше тезірек.
Dialogue: 0,0:05:08.57,0:05:12.14,Default,,0,0,0,,Біз осы уақытта циклден шықтық ба? →
Dialogue: 0,0:05:12.14,0:05:14.88,Default,,0,0,0,,Менің жолдастарым өлтірілсе де. →
Dialogue: 0,0:05:14.88,0:05:19.41,Default,,0,0,0,,Жүр, Мисаки-чан, москит торының астындағы сыртқы топ бірге жақсы араласады.
Dialogue: 0,0:05:19.41,0:05:24.27,Default,,0,0,0,,«Изанаги судың жалған түбіне қарап, Изанамиді күтеді.→
Dialogue: 0,0:05:24.27,0:05:29.61,Default,,0,0,0,,Изанами мұхит түбін кесіп өтіп, ақырында екеуі кездеседі. →
Dialogue: 0,0:05:29.61,0:05:32.23,Default,,0,0,0,,Сонда аспан мен жер екіге бөлінеді →
Dialogue: 0,0:05:32.23,0:05:35.41,Default,,0,0,0,,Онда тозақтың есігі ашылмайды. →
Dialogue: 0,0:05:35.41,0:05:39.02,Default,,0,0,0,,Қақпадан кім шыққанын білмеймін. →
Dialogue: 0,0:05:39.02,0:05:43.15,Default,,0,0,0,,Тек қақтығыс аяқталмай жалғасады.
Dialogue: 0,0:05:43.15,0:05:47.84,Default,,0,0,0,,Бұл Митака құжаты деп аталатын өте құпия құжатта жазылған мәлімдеме.
Dialogue: 0,0:05:47.84,0:05:52.16,Default,,0,0,0,,Маған бұл болашақ естелік екенін айтты.
Dialogue: 0,0:05:52.16,0:05:54.72,Default,,0,0,0,,Егер сіз мұны тура мағынада алсаңыз →
Dialogue: 0,0:05:54.72,0:05:56.84,Default,,0,0,0,,Изанами Изанагимен кездеседі→
Dialogue: 0,0:05:56.84,0:05:59.96,Default,,0,0,0,,Қандай да бір қорқынышты апат болады.
Dialogue: 0,0:05:59.96,0:06:05.03,Default,,0,0,0,,«Белгі батпай көтерілетін Юмихари айында.→
Dialogue: 0,0:06:05.03,0:06:10.18,Default,,0,0,0,,Жақында ол толып, Изанами теңізіне айналады».
Dialogue: 0,0:06:10.18,0:06:12.25,Default,,0,0,0,,Жақсы зерттеу. →
Dialogue: 0,0:06:12.25,0:06:17.44,Default,,0,0,0,,Сіз қорқатындай, пайғамбарлықтың соңғы кезеңі басталды.
Dialogue: 0,0:06:17.44,0:06:19.94,Default,,0,0,0,,Осы уақытқа дейін мен саған үндемедім →
Dialogue: 0,0:06:19.94,0:06:22.81,Default,,0,0,0,,Бұл қажетсіз шатасуды болдырмау үшін қажет. →
Dialogue: 0,0:06:22.81,0:06:26.72,Default,,0,0,0,,Тіпті пайғамбарлықтарды түсіндіру үшін соғыс болды.
Dialogue: 0,0:06:26.72,0:06:29.32,Default,,0,0,0,,Аспандағы соғыс? (Кобаяши) Дұрыс.
Dialogue: 0,0:06:30.72,0:06:33.91,Default,,0,0,0,,Изанамидің оянуын енді тоқтату мүмкін емес.
Dialogue: 0,0:06:33.91,0:06:38.98,Default,,0,0,0,,Бізге пайғамбарлықты жоққа шығарудың бір ғана әдісі қалды. →
Dialogue: 0,0:06:38.98,0:06:41.85,Default,,0,0,0,,Изанагиді басып алып, кәдеге жаратыңыз. →
Dialogue: 0,0:06:41.85,0:06:44.35,Default,,0,0,0,,Изанамимен кездесу алдында.
Dialogue: 0,0:06:47.00,0:06:49.82,Default,,0,0,0,,Сіз мені қонақ үйге көруге барған шығарсыз. иә?
Dialogue: 0,0:06:49.82,0:06:51.87,Default,,0,0,0,,Бұл Хей туралы. →
Dialogue: 0,0:06:51.87,0:06:54.51,Default,,0,0,0,,Ескі қонақжайды білу Біздің көзқарасымыздан→
Dialogue: 0,0:06:54.51,0:06:58.83,Default,,0,0,0,,Изанами деп қорқатын қазіргі қонақ үй мүлдем басқа адам.
Dialogue: 0,0:06:58.83,0:07:02.07,Default,,0,0,0,,Оны кейбіреулер эволюция деп атайтын сияқты.→
Dialogue: 0,0:07:02.07,0:07:05.07,Default,,0,0,0,,Хейге бәрібір. →
Dialogue: 0,0:07:05.07,0:07:07.51,Default,,0,0,0,,Қонақ үйді ауыстырған мен болдым→
Dialogue: 0,0:07:07.51,0:07:10.01,Default,,0,0,0,,Ол осылай ойлайды.
Dialogue: 0,0:07:11.38,0:07:14.08,Default,,0,0,0,,Ендеше шешейік...
Dialogue: 0,0:07:15.81,0:07:19.21,Default,,0,0,0,,Иә? Мен де жайғасуым керек.
Dialogue: 0,0:07:20.85,0:07:24.39,Default,,0,0,0,,Шионмен кездесіп, дұрыс сөйлесіңіз.
Dialogue: 0,0:07:24.39,0:07:37.47,Default,,0,0,0,,Сен
Dialogue: 0,0:07:37.47,0:07:41.47,Default,,0,0,0,,Бұл саяхатыңызды аяқтайтын жалғыз орын.
Dialogue: 0,0:07:42.89,0:07:45.19,Default,,0,0,0,,… !?
Dialogue: 0,0:07:49.45,0:07:51.35,Default,,0,0,0,,Ха! Әке...
Dialogue: 0,0:07:51.35,0:07:55.15,Default,,0,0,0,,Суфанг. Неліктен? Ол өлтірілді...
Dialogue: 0,0:07:55.15,0:07:59.02,Default,,0,0,0,,Бұл көшірме. көшірме?
Dialogue: 0,0:07:59.02,0:08:02.03,Default,,0,0,0,,Өзіңізді жаман адамдардан қорғау үшін жасалған→
Dialogue: 0,0:08:02.03,0:08:06.16,Default,,0,0,0,,Бұл жай қуыршақ. Ол менің нағыз әкем емес.
Dialogue: 0,0:08:06.16,0:08:10.37,Default,,0,0,0,,Сухо? Менімен бірге.
Dialogue: 0,0:08:10.37,0:08:14.51,Default,,0,0,0,,Мен де көшірушімін. иә? Неге олай болды...
Dialogue: 0,0:08:14.51,0:08:18.89,Default,,0,0,0,,Мен анамды кездестірдім. Сол кезде мен → дегенді естідім
Dialogue: 0,0:08:18.89,0:08:22.18,Default,,0,0,0,,Мен бір рет өлдім...
Dialogue: 0,0:08:22.18,0:08:25.38,Default,,0,0,0,,Ол әлі де жауапсыз әйел.
Dialogue: 0,0:08:26.87,0:08:30.41,Default,,0,0,0,,Сіз мен туралы немесе Шион туралы ештеңе білмесеңіз де.
Dialogue: 0,0:08:30.41,0:08:32.87,Default,,0,0,0,,Папа…. Анама→
Dialogue: 0,0:08:32.87,0:08:36.46,Default,,0,0,0,,Саған не құйылғанын білмеймін, бірақ осылай ойла.
Dialogue: 0,0:08:36.46,0:08:39.93,Default,,0,0,0,,Сіз өлген жоқсыз. Эх...
Dialogue: 0,0:08:39.93,0:08:45.15,Default,,0,0,0,,Сіз шынымен де осындасыз. Мен мұнда өз естеліктеріммен және эмоциялармен келдім. →
Dialogue: 0,0:08:45.15,0:08:48.09,Default,,0,0,0,,Шынында да, бір рет сіздің денеңіз өлді. →
Dialogue: 0,0:08:48.09,0:08:52.64,Default,,0,0,0,,Бірақ ол Шионның күшімен қайта тірілді.
Dialogue: 0,0:08:52.64,0:08:54.73,Default,,0,0,0,,Шион?
Dialogue: 0,0:08:54.73,0:08:58.02,Default,,0,0,0,,Мені әкем жаратқан жоқ па?
Dialogue: 0,0:08:58.02,0:09:01.50,Default,,0,0,0,,Екі жыл бұрын Шион мердігер болған кезде →
Dialogue: 0,0:09:01.50,0:09:04.17,Default,,0,0,0,,Есіңде ме? Иә.
Dialogue: 0,0:09:04.17,0:09:07.21,Default,,0,0,0,,Сол күні біз Сібірде болдық→
Dialogue: 0,0:09:07.21,0:09:10.33,Default,,0,0,0,,Аңшылықтан кейін от жағу →
Dialogue: 0,0:09:10.33,0:09:14.52,Default,,0,0,0,,Ыстық сорпа ішіп,...→
Dialogue: 0,0:09:14.52,0:09:17.12,Default,,0,0,0,,Шион мердігер болды.
Dialogue: 0,0:09:19.14,0:09:21.16,Default,,0,0,0,,Бұл да өтірік пе?
Dialogue: 0,0:09:21.16,0:09:23.61,Default,,0,0,0,,Жұлдыздар түскені рас. →
Dialogue: 0,0:09:23.61,0:09:25.86,Default,,0,0,0,,Бірақ одан кейін не болатыны басқа.
Dialogue: 0,0:09:25.86,0:09:28.18,Default,,0,0,0,,Біріншіден, Шион - →
Dialogue: 0,0:09:28.18,0:09:31.33,Default,,0,0,0,,Туғаннан бастап келісім-шарт иесі болған. иә?
Dialogue: 0,0:09:31.33,0:09:34.02,Default,,0,0,0,,Басынан ерекше болды ма?
Dialogue: 0,0:09:34.02,0:09:36.84,Default,,0,0,0,,Және Сухо. Сіз бірінші →
Dialogue: 0,0:09:36.84,0:09:38.87,Default,,0,0,0,,Ол жоқ еді.
Dialogue: 0,0:09:38.87,0:09:44.73,Default,,0,0,0,,Сен
Dialogue: 0,0:09:44.73,0:09:46.80,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:46.80,0:09:49.48,Default,,0,0,0,,Шион! →
Dialogue: 0,0:09:49.48,0:09:52.08,Default,,0,0,0,,Шион! Шион!!
Dialogue: 0,0:09:53.49,0:09:56.01,Default,,0,0,0,,Уф... Сухо...
Dialogue: 0,0:09:56.01,0:10:03.68,Default,,0,0,0,,Сен
Dialogue: 0,0:10:03.68,0:10:06.15,Default,,0,0,0,,Мен де Әуелі не болды →
Dialogue: 0,0:10:06.15,0:10:09.60,Default,,0,0,0,,Мен түсінбедім. Шионның келісім-шарт қабілеті →
Dialogue: 0,0:10:09.60,0:10:12.87,Default,,0,0,0,,Көшірме жасау, бірақ адамдарды көшіру, т.б.→
Dialogue: 0,0:10:12.87,0:10:15.88,Default,,0,0,0,,Өйткені ол жоқ еді. Әсіресе өзім...
Dialogue: 0,0:10:15.88,0:10:19.16,Default,,0,0,0,,Әй, мына қыз қыз ғой. Бұл дұрыс. →
Dialogue: 0,0:10:19.16,0:10:22.17,Default,,0,0,0,,Сондықтан бұл Сухо. Бұл Шион емес!
Dialogue: 0,0:10:22.17,0:10:26.70,Default,,0,0,0,,Шион көшірмелерінің түпнұсқадан әрқашан бір айырмашылығы бар.
Dialogue: 0,0:10:26.70,0:10:30.44,Default,,0,0,0,,Мен себебін білмеймін. Бірақ бұл маңызды емес.
Dialogue: 0,0:10:30.44,0:10:33.04,Default,,0,0,0,,Ал сіздің есте сақтау қабілетіңіз ше?
Dialogue: 0,0:10:33.04,0:10:37.55,Default,,0,0,0,,Неліктен менде өзім туралы естеліктер бар?
Dialogue: 0,0:10:37.55,0:10:41.69,Default,,0,0,0,,Шион сенің жадыңды елестеткені сол еді→
Dialogue: 0,0:10:41.69,0:10:45.89,Default,,0,0,0,,Әкем МЕН арқылы оны шығарып алып, саған жөндеді.
Dialogue: 0,0:10:45.89,0:10:49.38,Default,,0,0,0,,Бес жасқа дейінгі естеліктеріңізбен бірге.
Dialogue: 0,0:10:49.38,0:10:52.55,Default,,0,0,0,,Сонымен, аквариум туралы не есте қалды?
Dialogue: 0,0:10:52.55,0:10:57.05,Default,,0,0,0,,Бұл сізге Шионның сыйлығы болса керек.
Dialogue: 0,0:10:59.19,0:11:01.59,Default,,0,0,0,,Бұл сыйлық емес.
Dialogue: 0,0:11:03.06,0:11:05.76,Default,,0,0,0,,Бұл болуы керек...
Dialogue: 0,0:11:05.76,0:11:08.88,Default,,0,0,0,,Мен Шионмен кездесуім керек.
Dialogue: 0,0:11:08.88,0:11:11.85,Default,,0,0,0,,Шион қайда орналасқан? Сухо….
Dialogue: 0,0:11:11.85,0:11:14.85,Default,,0,0,0,,Өтінемін, әке. Шионмен кездесуге рұқсат етіңіз!
Dialogue: 0,0:11:25.56,0:11:28.57,Default,,0,0,0,,Мен доктор Павличенконың баласын таптым. →
Dialogue: 0,0:11:28.57,0:11:31.62,Default,,0,0,0,,Хигашиикбукуро, Тосима Уорд... Ах!
Dialogue: 0,0:11:31.62,0:11:34.87,Default,,0,0,0,,Хигашиикебукуро, Тосима Уорд... Енді не болады?
Dialogue: 0,0:11:34.87,0:11:37.81,Default,,0,0,0,,Мен білмеймін. Кенеттен қуыршақ жүйесінде→
Dialogue: 0,0:11:37.81,0:11:40.51,Default,,0,0,0,,Біреу араласқан сияқты... (Шизүмэ) Интервенция? →
Dialogue: 0,0:11:40.51,0:11:43.01,Default,,0,0,0,,Сіз мұны істей алмайсыз ба? →
Dialogue: 0,0:11:43.01,0:11:45.42,Default,,0,0,0,,Қуыршақтар өз желісінде→
Dialogue: 0,0:11:45.42,0:11:48.54,Default,,0,0,0,,Қосылған деп естідім.→
Dialogue: 0,0:11:48.54,0:11:50.96,Default,,0,0,0,,Иә, бұл рас болуы керек.
Dialogue: 0,0:11:50.96,0:11:53.88,Default,,0,0,0,,Айтпақшы, доктор Павличенко да МЕН →
Dialogue: 0,0:11:53.88,0:11:57.71,Default,,0,0,0,,Олар осыған ұқсас желі құрылымы бар деп ойласа керек→
Dialogue: 0,0:11:57.71,0:12:01.87,Default,,0,0,0,,Сіз қалай ойлайсыз? Неге қазір бұл туралы айтып отырсың?
Dialogue: 0,0:12:01.87,0:12:04.17,Default,,0,0,0,,Оны жоғары толқын деп ойлаңыз.
Dialogue: 0,0:12:06.37,0:12:09.22,Default,,0,0,0,,Әзірше күн сәулесіне барыңыз.
Dialogue: 0,0:12:09.22,0:12:14.26,Default,,0,0,0,,Хигашиикебукуро, Тосима Уорд... Егер сіз соншалықты көп білсеңіз, менде бір болжам бар.
Dialogue: 0,0:12:14.26,0:12:17.76,Default,,0,0,0,,Лавли-чанның осында екеніне күмәнім жоқ.
Dialogue: 0,0:12:21.52,0:12:24.16,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:24.16,0:12:27.26,Default,,0,0,0,,Кел. Не келе жатыр?
Dialogue: 0,0:12:28.61,0:12:31.30,Default,,0,0,0,,​​Түсіндім.
Dialogue: 0,0:12:31.30,0:12:33.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:33.35,0:12:36.88,Default,,0,0,0,,шілде!? Әй шілде!
Dialogue: 0,0:12:36.88,0:12:39.34,Default,,0,0,0,,Иә... Егер сіз оны тапсаңыз →
Dialogue: 0,0:12:39.34,0:12:41.44,Default,,0,0,0,,Менің таңдауым жоқ. →
Dialogue: 0,0:12:41.44,0:12:45.53,Default,,0,0,0,,Қуыршақтарына қашу жолын айт.
Dialogue: 0,0:12:45.53,0:12:49.38,Default,,0,0,0,,Мен сізге айттым. иә. Жақсы бала.
Dialogue: 0,0:12:49.38,0:12:52.30,Default,,0,0,0,,А, мен де таптым. Мұнда да?
Dialogue: 0,0:12:55.72,0:13:00.46,Default,,0,0,0,,Ой, сен мұны күтпеген жерден істедің. Маған бұл әскери техника ұнайды.
Dialogue: 0,0:13:00.46,0:13:02.46,Default,,0,0,0,,Дыбыстық сигнал (жұмыс дыбысы)
Dialogue: 0,0:13:05.88,0:13:07.88,Default,,0,0,0,,Шырылдау...
Dialogue: 0,0:15:17.66,0:15:27.52,Default,,0,0,0,,Сен
Dialogue: 0,0:15:27.52,0:15:38.75,Default,,0,0,0,,Сен
Dialogue: 0,0:15:38.75,0:15:42.65,Default,,0,0,0,,Сол жамбастар мен үшін сыйлық па?
Dialogue: 0,0:15:44.62,0:15:48.29,Default,,0,0,0,,Аа... Oro? Әкең де жаныңда ма? →
Dialogue: 0,0:15:48.29,0:15:50.81,Default,,0,0,0,,Ал, мен бүгін осындамын. →
Dialogue: 0,0:15:50.81,0:15:54.33,Default,,0,0,0,,Келіңіздер. Шаш қалың өскенше →
Dialogue: 0,0:15:54.33,0:15:57.64,Default,,0,0,0,,Мен саған қамқор боламын. Сен не туралы айтып тұрсың?
Dialogue: 0,0:15:57.64,0:16:03.16,Default,,0,0,0,,Сандар туралы әңгімелеу. Шаштар жамбаста өсе ме?
Dialogue: 0,0:16:03.16,0:16:05.79,Default,,0,0,0,,Дұрыс, есейгенде →
Dialogue: 0,0:16:05.79,0:16:09.28,Default,,0,0,0,,Қария сияқты Өкінішке орай.
Dialogue: 0,0:16:09.28,0:16:12.45,Default,,0,0,0,,Ол онша өспейді. Мен еркек болмасам да.
Dialogue: 0,0:16:12.45,0:16:15.52,Default,,0,0,0,,Не? Сіз еркексіз бе?
Dialogue: 0,0:16:15.52,0:16:18.19,Default,,0,0,0,,Шамасы, сол ақымақ әлі жалғыз →
Dialogue: 0,0:16:18.19,0:16:20.34,Default,,0,0,0,,Ол сені Шион деп ойлайтын сияқты.
Dialogue: 0,0:16:20.34,0:16:23.34,Default,,0,0,0,,А?! Эй, Момонга сөйлеп тұр!!
Dialogue: 0,0:16:23.34,0:16:26.53,Default,,0,0,0,,Бұл таңқаларлық бөлік.
Dialogue: 0,0:16:26.53,0:16:28.55,Default,,0,0,0,,—умеренділермен қақтығысып жатыр.
Dialogue: 0,0:16:28.55,0:16:31.62,Default,,0,0,0,,Жарылыс! Ой, ау, ау... бұл қауіпті!
Dialogue: 0,0:16:31.62,0:16:33.69,Default,,0,0,0,,Келіңіз.
Dialogue: 0,0:16:33.69,0:16:36.86,Default,,0,0,0,,Сен
Dialogue: 0,0:16:36.86,0:16:40.46,Default,,0,0,0,,Мүмкін мен ғана алданып қалған шығармын?
Dialogue: 0,0:16:40.46,0:16:44.13,Default,,0,0,0,,Сен
Dialogue: 0,0:16:44.13,0:16:46.17,Default,,0,0,0,,Түсірілді.
Dialogue: 0,0:16:46.17,0:16:53.12,Default,,0,0,0,,Сен
Dialogue: 0,0:16:53.12,0:16:55.46,Default,,0,0,0,,Ха! Хамф!
Dialogue: 0,0:16:55.46,0:17:04.06,Default,,0,0,0,,Сен
Dialogue: 0,0:17:05.97,0:17:07.97,Default,,0,0,0,,Папа…. Ах.
Dialogue: 0,0:17:14.58,0:17:18.48,Default,,0,0,0,,Не істеу керек? Бұрынғы азғындыққа қайта оралудан басқа амалым жоқ.
Dialogue: 0,0:17:19.83,0:17:21.87,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:17:21.87,0:17:24.27,Default,,0,0,0,,（）
Dialogue: 0,0:17:25.66,0:17:27.93,Default,,0,0,0,,Қадам...(аяқ дыбысы)
Dialogue: 0,0:17:27.93,0:17:30.33,Default,,0,0,0,,А... сен...
Dialogue: 0,0:17:30.33,0:17:35.13,Default,,0,0,0,,Өкінішке орай, қазір барсаңыз, ештеңе істей алмайсыз.
Dialogue: 0,0:17:36.57,0:17:38.92,Default,,0,0,0,,Сіз кімсіз!?
Dialogue: 0,0:17:38.92,0:17:41.52,Default,,0,0,0,,Күте тұрыңыз! Ол шабуылдың нысанасы ...
Dialogue: 0,0:17:43.11,0:17:45.16,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:17:45.16,0:17:47.96,Default,,0,0,0,,Билибилі! Апыр-ай!!
Dialogue: 0,0:17:50.58,0:17:54.15,Default,,0,0,0,,Не... не...? Доктор Шрейдер күткендей. →
Dialogue: 0,0:17:54.15,0:17:56.97,Default,,0,0,0,,Пайдасыз нәрсе жасасаң, ол дүниедегі ең жақсысы болады→
Dialogue: 0,0:17:56.97,0:18:00.64,Default,,0,0,0,,Мен мұны айтқым келеді, бірақ оның күші мүлдем жоқ. →
Dialogue: 0,0:18:00.64,0:18:04.18,Default,,0,0,0,,Мен оның жоғалып кеткенін естідім. Сен қандайсың...?
Dialogue: 0,0:18:04.18,0:18:06.81,Default,,0,0,0,,Бұл туралы кейінірек сөйлесейік.
Dialogue: 0,0:18:06.81,0:18:09.63,Default,,0,0,0,,Ендігі басымдық – бұл жерден қашу.
Dialogue: 0,0:18:09.63,0:18:13.35,Default,,0,0,0,,Жақында мұнда да қан теңізі болады.
Dialogue: 0,0:18:13.35,0:18:16.24,Default,,0,0,0,,…（）
Dialogue: 0,0:18:16.24,0:18:19.06,Default,,0,0,0,,Бұл не? Енді «ұйымдастырусыз»→
Dialogue: 0,0:18:19.06,0:18:24.15,Default,,0,0,0,,Америка, ұлы мемлекет көптен күткен қайтып оралғысы келетін сияқты.
Dialogue: 0,0:18:24.15,0:18:26.95,Default,,0,0,0,,Неліктен Америка?
Dialogue: 0,0:18:26.95,0:18:32.04,Default,,0,0,0,,Мен Изанами мен Изанагиді мақсат етіп отырмын. Мақсат? Өйткені бұл...
Dialogue: 0,0:18:32.04,0:18:34.48,Default,,0,0,0,,Дұрыс, бірақ сол адамдарға →
Dialogue: 0,0:18:34.48,0:18:37.96,Default,,0,0,0,,Бұл энергия ресурсы болуы мүмкін сияқты. →
Dialogue: 0,0:18:37.96,0:18:42.03,Default,,0,0,0,,Қалай болғанда да, мұны сол балаға қалдырып, әзірге қалдырайық. →
Dialogue: 0,0:18:42.03,0:18:45.64,Default,,0,0,0,,She was trained for times like this→
Dialogue: 0,0:18:45.64,0:18:47.67,Default,,0,0,0,,To the Black Grim Reaper.
Dialogue: 0,0:18:47.67,0:18:52.59,Default,,0,0,0,,Сен
Dialogue: 0,0:18:52.59,0:18:54.65,Default,,0,0,0,,Ugh... Dad...
Dialogue: 0,0:18:54.65,0:18:56.71,Default,,0,0,0,,…
Dialogue: 0,0:18:56.71,0:18:58.71,Default,,0,0,0,,Соқ!
Dialogue: 0,0:19:00.07,0:19:04.96,Default,,0,0,0,,Қайда? Керемет Чан!
Dialogue: 0,0:19:04.96,0:19:07.59,Default,,0,0,0,,It's the pervert from earlier.
Dialogue: 0,0:19:07.59,0:19:10.86,Default,,0,0,0,,Тез. Мені артта қалдырыңыз...
Dialogue: 0,0:19:10.86,0:19:23.97,Default,,0,0,0,,Сен
Dialogue: 0,0:19:23.97,0:19:26.51,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:19:26.51,0:19:30.16,Default,,0,0,0,,Leave this to me. Мен жақында қайтамын.
Dialogue: 0,0:19:30.16,0:19:35.62,Default,,0,0,0,,Сен
Dialogue: 0,0:19:35.62,0:19:39.46,Default,,0,0,0,,Мао. Мен әкемді сұрадым. Эй! →
Dialogue: 0,0:19:39.46,0:19:41.51,Default,,0,0,0,,Suho!
Dialogue: 0,0:19:41.51,0:19:43.78,Default,,0,0,0,,Соқ! Эй! →
Dialogue: 0,0:19:43.78,0:19:48.95,Default,,0,0,0,,Lovely-chan, come out. →
Dialogue: 0,0:19:48.95,0:19:51.14,Default,,0,0,0,,О? Бон!
Dialogue: 0,0:19:51.14,0:19:53.47,Default,,0,0,0,,Бум! (Шинме) Уф!
Dialogue: 0,0:19:53.47,0:19:56.74,Default,,0,0,0,,Damn... What a shock.
Dialogue: 0,0:19:56.74,0:19:58.84,Default,,0,0,0,,Rattle... (Shinme) Oh no!
Dialogue: 0,0:20:00.88,0:20:02.96,Default,,0,0,0,,Бум! Бум!
Dialogue: 0,0:20:02.96,0:20:06.16,Default,,0,0,0,,Damn... He'll do it!
Dialogue: 0,0:20:07.79,0:20:10.94,Default,,0,0,0,,Lovely-chan!!
Dialogue: 0,0:20:10.94,0:20:12.94,Default,,0,0,0,,Сен
Dialogue: 0,0:20:12.94,0:20:15.49,Default,,0,0,0,,Бум! Hehehe →
Dialogue: 0,0:20:15.49,0:20:17.89,Default,,0,0,0,,Lovely!!
Dialogue: 0,0:20:19.81,0:20:22.10,Default,,0,0,0,,Дока! Бон!
Dialogue: 0,0:20:22.10,0:20:26.19,Default,,0,0,0,,Уф! (Шинме) Фу~ Бұл мүлдем жойылды →
Dialogue: 0,0:20:26.19,0:20:28.41,Default,,0,0,0,,If it's dangerous, I won't do it. →
Dialogue: 0,0:20:28.41,0:20:31.81,Default,,0,0,0,,Мен өліп қала жаздадым.
Dialogue: 0,0:20:31.81,0:20:33.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:36.20,0:20:38.87,Default,,0,0,0,,Дауысты жақсы деп есептейтіндер бар екеніне сенімдімін →
Dialogue: 0,0:20:38.87,0:20:40.87,Default,,0,0,0,,I guess there are →
Dialogue: 0,0:20:40.87,0:20:43.27,Default,,0,0,0,,I don't have any hobbies like that.
Dialogue: 0,0:20:46.24,0:20:49.54,Default,,0,0,0,,Уф…. (Шинме) Мүмкін емес.
Dialogue: 0,0:20:52.03,0:20:55.93,Default,,0,0,0,,I won't forgive you, will you?
Dialogue: 0,0:20:55.93,0:21:00.14,Default,,0,0,0,,Ah! Ол аурады! Не болып жатыр? Эй!
Dialogue: 0,0:21:00.14,0:21:03.07,Default,,0,0,0,,It backfired! It won't rub!
Dialogue: 0,0:21:03.07,0:21:05.07,Default,,0,0,0,,Katya... Ah!
Dialogue: 0,0:21:07.70,0:21:11.23,Default,,0,0,0,,You're not going to die anyway. Ха...
Dialogue: 0,0:21:11.23,0:21:13.33,Default,,0,0,0,,Бум! Бум!
Dialogue: 0,0:21:15.55,0:21:17.55,Default,,0,0,0,,Сахна жасаңыз!
Dialogue: 0,0:21:24.08,0:21:26.08,Default,,0,0,0,,Уф….
Dialogue: 0,0:21:27.80,0:21:29.83,Default,,0,0,0,,…（）
Dialogue: 0,0:21:29.83,0:21:33.37,Default,,0,0,0,,Suho! Stay strong, Dad!
Dialogue: 0,0:21:33.37,0:21:35.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:37.04,0:21:40.34,Default,,0,0,0,,Daddy is no good anymore...
Dialogue: 0,0:21:40.34,0:21:42.88,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Мен де әкемді алып кетемін.
Dialogue: 0,0:21:42.88,0:21:45.73,Default,,0,0,0,,That's enough. It's not good!
Dialogue: 0,0:21:45.73,0:21:48.62,Default,,0,0,0,,No, it's fine.
Dialogue: 0,0:21:48.62,0:21:54.68,Default,,0,0,0,,Сенің есейгеніңді көргенде әкем...
Dialogue: 0,0:21:54.68,0:21:58.21,Default,,0,0,0,,Күте тұрыңыз! Оны жай ғана қабылдамаңыз.
Dialogue: 0,0:21:58.21,0:22:02.02,Default,,0,0,0,,Өйткені мен бұрынғыдай емеспін, солай ма?
Dialogue: 0,0:22:02.02,0:22:05.02,Default,,0,0,0,,Бұл көшірме, бұл мердігер→
Dialogue: 0,0:22:05.02,0:22:07.10,Default,,0,0,0,,Мен әкем білетін адаммын...
Dialogue: 0,0:22:07.10,0:22:11.06,Default,,0,0,0,,Сен
Dialogue: 0,0:22:11.06,0:22:16.65,Default,,0,0,0,,Сіз әрқашан менің Сухом болып қаласыз...
Dialogue: 0,0:22:16.65,0:22:20.48,Default,,0,0,0,,Папа…. Шион бұл жақсы деп айтқанша →
Dialogue: 0,0:22:20.48,0:22:23.49,Default,,0,0,0,,Оған жол бермеңіз.
Dialogue: 0,0:22:23.49,0:22:28.18,Default,,0,0,0,,Сен
Dialogue: 0,0:22:28.18,0:22:31.38,Default,,0,0,0,,Әке? Папа~!
Dialogue: 0,0:22:32.80,0:22:35.35,Default,,0,0,0,,...
Dialogue: 0,0:22:35.35,0:22:39.19,Default,,0,0,0,,Артық емес. Кеттік, Сухо. →
Dialogue: 0,0:22:39.19,0:22:41.19,Default,,0,0,0,,Сухо!
Dialogue: 0,0:22:41.19,0:22:46.79,Default,,0,0,0,,Сен
Dialogue: 0,0:22:51.00,0:22:53.03,Default,,0,0,0,,→
Dialogue: 0,0:22:53.03,0:22:56.27,Default,,0,0,0,,«Жаудың ақшасын алған пайда көреді». →
Dialogue: 0,0:22:56.27,0:22:59.76,Default,,0,0,0,,Адамның жадының пайдасы бар.
Dialogue: 0,0:22:59.76,0:23:03.46,Default,,0,0,0,,Кеш болған жоқ па? C.I.A.
Dialogue: 0,0:23:18.19,0:23:20.19,Default,,0,0,0,,Ха...
Dialogue: 0,0:23:24.63,0:23:27.30,Default,,0,0,0,,Заш Заш Заш Заш!
Dialogue: 0,0:23:27.30,0:23:29.55,Default,,0,0,0,,Сен
Dialogue: 0,0:23:29.55,0:23:31.57,Default,,0,0,0,,BK201.
Dialogue: 0,0:23:31.57,0:23:36.16,Default,,0,0,0,,Сен
Dialogue: 0,0:23:36.16,0:23:38.36,Default,,0,0,0,,Өл! Уф...
Dialogue: 0,0:23:39.80,0:23:59.50,Default,,0,0,0,,Сен
Dialogue: 0,0:23:59.50,0:24:19.54,Default,,0,0,0,,Сен
Dialogue: 0,0:24:19.54,0:24:39.51,Default,,0,0,0,,Сен
Dialogue: 0,0:24:39.51,0:24:59.49,Default,,0,0,0,,Сен
Dialogue: 0,0:24:59.49,0:25:09.49,Default,,0,0,0,,Сен
Dialogue: 0,0:25:12.54,0:25:15.54,Default,,0,0,0,,Мен бұл жолды қайта пайдаланамын деп ойламадым →
Dialogue: 0,0:25:15.54,0:25:18.18,Default,,0,0,0,,Қақпаға кіргенде не болады? →
Dialogue: 0,0:25:18.18,0:25:21.83,Default,,0,0,0,,Шион Павличенко шынымен де осында бола ма?
Dialogue: 0,0:25:21.83,0:25:24.54,Default,,0,0,0,,Менің айтып тұрғаным осы. Ол кім? →
Dialogue: 0,0:25:24.54,0:25:27.44,Default,,0,0,0,,Осылай айтатындар. иә? →
Dialogue: 0,0:25:28.87,0:25:31.18,Default,,0,0,0,,Мұнда біреу бар. →
Dialogue: 0,0:25:31.18,0:25:33.18,Default,,0,0,0,,Ей!
Dialogue: 0,0:25:34.63,0:25:37.33,Default,,0,0,0,,Сен... Неге келдің?
Dialogue: 0,0:25:41.47,0:25:43.95,Default,,0,0,0,,Олар?
Dialogue: 0,0:25:43.95,0:25:48.01,Default,,0,0,0,,Иә, Рикардо. Мені олай атама. →
Dialogue: 0,0:25:48.01,0:25:50.93,Default,,0,0,0,,Сен екеуміз енді ғашық емеспіз.
Dialogue: 0,0:25:50.93,0:25:53.11,Default,,0,0,0,,Әдеттегідей суық.
Dialogue: 0,0:25:53.11,0:25:56.83,Default,,0,0,0,,Ри... Тиін сөйледі. Бұл Момонга!
Dialogue: 0,0:25:56.83,0:26:00.97,Default,,0,0,0,,Айтпақшы, сіздің қалаған қызыңыз кім? иә? →
Dialogue: 0,0:26:00.97,0:26:06.19,Default,,0,0,0,,Иә? Сухо қайда кетті? Мен бұрын осында болғанмын.
Dialogue: 0,0:26:06.19,0:26:09.08,Default,,0,0,0,,Екеуіңнің сезімдерің байланысты.
Dialogue: 0,0:26:09.08,0:26:13.87,Default,,0,0,0,,Бұл қақпа. Кез келген тілек орындалатын жер.
Dialogue: 0,0:26:13.87,0:26:16.97,Default,,0,0,0,,Бірақ бірдеңені жоғалтатын жер.
Dialogue: 0,0:26:18.37,0:26:20.96,Default,,0,0,0,,Міне... Ха!
Dialogue: 0,0:26:20.96,0:26:24.98,Default,,0,0,0,,Шион!? Шион!
Dialogue: 0,0:26:24.98,0:26:27.18,Default,,0,0,0,,Шион?
Dialogue: 0,0:26:27.18,0:26:29.18,Default,,0,0,0,,Шион!
Dialogue: 0,0:28:02.53,0:28:04.90,Default,,0,0,0,,<Ол жерде жай ғана гүлдер жайнап тұрды>
Dialogue: 0,0:28:04.90,0:28:09.22,Default,,0,0,0,,<Тозақтың есігі ашылғанда, болашаққа арналған армандар төгіледі>
Dialogue: 0,0:28:09.22,0:28:11.92,Default,,0,0,0,,<Қызыл ай - жойылуға үміт>
Dialogue: 0,0:28:11.92,0:28:14.52,Default,,0,0,0,,<Бұл саяхаттың басы>
Dialogue: 0,0:28:16.02,0:28:22.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory