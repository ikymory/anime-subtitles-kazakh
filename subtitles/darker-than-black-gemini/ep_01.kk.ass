Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.38,0:00:14.24,Default,,0,0,0,,Сен
Dialogue: 0,0:00:14.24,0:00:17.84,Default,,0,0,0,,Ах! Аққан жұлдыз. (Сухо) Ха! қайда? қайда?
Dialogue: 0,0:00:19.21,0:00:23.60,Default,,0,0,0,,Әке, аққан жұлдыз сөнбей тұрып үш рет тілек айтсаңыз→
Dialogue: 0,0:00:23.60,0:00:26.17,Default,,0,0,0,,Тілегіңіз орындалады деген рас па?
Dialogue: 0,0:00:26.17,0:00:29.22,Default,,0,0,0,,Бұл Жапонияда өткен сиқыр. →
Dialogue: 0,0:00:29.22,0:00:31.72,Default,,0,0,0,,Мен анамнан баяғыда сұрадым. →
Dialogue: 0,0:00:33.54,0:00:36.13,Default,,0,0,0,,Әдемі болу үшін басқа да сиқырлар бар→
Dialogue: 0,0:00:36.13,0:00:39.02,Default,,0,0,0,,Маған бойыңды өсіретін бір сиқыр бар екенін айтты.
Dialogue: 0,0:00:39.02,0:00:41.02,Default,,0,0,0,,Иә? Шынымен!?
Dialogue: 0,0:00:43.34,0:00:45.61,Default,,0,0,0,,Сіз не сұрап тұрсыз?
Dialogue: 0,0:00:45.61,0:00:47.93,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:00:47.93,0:00:50.11,Default,,0,0,0,,Әке, жұлдыздар түсіп жатыр→
Dialogue: 0,0:00:50.11,0:00:52.61,Default,,0,0,0,,Біреу өлгенде деген рас па?
Dialogue: 0,0:00:54.05,0:00:58.40,Default,,0,0,0,,Келіңіздер ме? Тым болмаса нағыз жұлдызды аспанды көргенде→
Dialogue: 0,0:00:58.40,0:01:00.49,Default,,0,0,0,,Бұл жай ғана ертегі болды.
Dialogue: 0,0:01:00.49,0:01:04.09,Default,,0,0,0,,Сен
Dialogue: 0,0:01:04.09,0:01:06.74,Default,,0,0,0,,Ах, тағы! иә? шын?
Dialogue: 0,0:01:06.74,0:01:16.95,Default,,0,0,0,,Сен
Dialogue: 0,0:01:16.95,0:01:19.15,Default,,0,0,0,,А... Әке.
Dialogue: 0,0:01:20.54,0:01:22.89,Default,,0,0,0,,Бұл басталды ма?
Dialogue: 0,0:01:22.89,0:01:24.93,Default,,0,0,0,,Уау….
Dialogue: 0,0:01:24.93,0:01:28.23,Default,,0,0,0,,Уау... (Шион) Хаха. Аа…. →
Dialogue: 0,0:01:28.23,0:01:31.35,Default,,0,0,0,,Хаха. Уау...хахаха.
Dialogue: 0,0:01:31.35,0:01:37.19,Default,,0,0,0,,Сен
Dialogue: 0,0:01:37.19,0:01:39.24,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:39.24,0:01:43.83,Default,,0,0,0,,Сен
Dialogue: 0,0:01:43.83,0:01:46.63,Default,,0,0,0,,Бум!
Dialogue: 0,0:01:46.63,0:01:53.17,Default,,0,0,0,,Сен
Dialogue: 0,0:01:53.17,0:01:55.58,Default,,0,0,0,,Шион!
Dialogue: 0,0:01:55.58,0:01:58.18,Default,,0,0,0,,Шион! Шион!!
Dialogue: 0,0:01:59.65,0:02:02.83,Default,,0,0,0,,Уф… Сухо….
Dialogue: 0,0:02:02.83,0:02:06.00,Default,,0,0,0,,<Бұл екі жыл бұрын болған>
Dialogue: 0,0:02:06.00,0:02:10.37,Default,,0,0,0,,<Токиодағы жарылыс деп аталатын оқиға болған түн →
Dialogue: 0,0:02:10.37,0:02:12.97,Default,,0,0,0,,Шион мердігер болды＞
Dialogue: 0,0:02:15.96,0:02:19.15,Default,,0,0,0,,Темекі түтіні негізгі түтінге қарағанда жанама түтін болуы ықтимал→
Dialogue: 0,0:02:19.15,0:02:21.90,Default,,0,0,0,,Құрамында көптеген зиянды заттар бар. →
Dialogue: 0,0:02:21.90,0:02:24.96,Default,,0,0,0,,Диметилнитрозамин жоғары канцерогенді →
Dialogue: 0,0:02:24.96,0:02:29.28,Default,,0,0,0,,Ал негізгі түтін 5,3-тен 43 нанограмға дейін →
Dialogue: 0,0:02:29.28,0:02:33.73,Default,,0,0,0,,Пайдаланылған түтін 680-ден 823 нанограмға дейін. →
Dialogue: 0,0:02:33.73,0:02:37.27,Default,,0,0,0,,Хинолиннің түтіні негізгі түтіннен 11 есе көп. →
Dialogue: 0,0:02:37.27,0:02:40.59,Default,,0,0,0,,Құрамында шамамен 18 000 нанограмма бар.
Dialogue: 0,0:02:40.59,0:02:42.72,Default,,0,0,0,,Сондықтан мен орыстарға темекі бердім →
Dialogue: 0,0:02:42.72,0:02:45.72,Default,,0,0,0,,Оны тоқтатуға тырысу мүмкін емес. →
Dialogue: 0,0:02:47.95,0:02:50.10,Default,,0,0,0,,Жарайды, ұтымды ойласаңыз →
Dialogue: 0,0:02:50.10,0:02:52.93,Default,,0,0,0,,Мен тоқтату керек екенін білемін. →
Dialogue: 0,0:02:52.93,0:02:55.57,Default,,0,0,0,,Бірақ егер бұл қауесет келісімшарттың иесі болса да.
Dialogue: 0,0:02:55.57,0:02:58.17,Default,,0,0,0,,Бұл орын алмайынша мүмкін емес.
Dialogue: 0,0:02:59.52,0:03:03.09,Default,,0,0,0,,Рахмет. Эй, сен ол туралы естідің бе? →
Dialogue: 0,0:03:03.09,0:03:07.51,Default,,0,0,0,,Келісімшарт иесі қайтыс болған кезде бұл жұлдыз ағады.
Dialogue: 0,0:03:07.51,0:03:10.63,Default,,0,0,0,,Жоқ…. Сіз шынымен сондасыз ба?
Dialogue: 0,0:03:10.63,0:03:13.47,Default,,0,0,0,,Мұндай адамдар. Менімен танысқыңыз келе ме?
Dialogue: 0,0:03:13.47,0:03:17.54,Default,,0,0,0,,Өтінемін. Олар сондай шулы топ, солай емес пе?
Dialogue: 0,0:03:17.54,0:03:20.61,Default,,0,0,0,,Тозақ енді тегіс.
Dialogue: 0,0:03:20.61,0:03:23.13,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:03:23.13,0:03:25.35,Default,,0,0,0,,Гача (есік дыбысы) Қош келдіңіз.
Dialogue: 0,0:03:25.35,0:03:27.72,Default,,0,0,0,,Глендеверон 1968→
Dialogue: 0,0:03:27.72,0:03:30.27,Default,,0,0,0,,Тікелей. иә?
Dialogue: 0,0:03:30.27,0:03:33.21,Default,,0,0,0,,Бұл 33 жастағы шери құты. →
Dialogue: 0,0:03:33.21,0:03:35.28,Default,,0,0,0,,Осы дүкеннің артындағы өлі қор →
Dialogue: 0,0:03:35.28,0:03:40.06,Default,,0,0,0,,Мен оның табылғанын естідім. Тұтынушы: Неге олай істедің?
Dialogue: 0,0:03:40.06,0:03:44.82,Default,,0,0,0,,～ （ＢＧＭ）
Dialogue: 0,0:03:44.82,0:03:47.94,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет. рақмет сізге.
Dialogue: 0,0:03:47.94,0:03:51.06,Default,,0,0,0,,～（ＢＧＭ）
Dialogue: 0,0:03:51.06,0:03:54.71,Default,,0,0,0,,Сәуір, солай ма? Сіз 7 тамыздасыз ба?
Dialogue: 0,0:03:54.71,0:03:57.00,Default,,0,0,0,,Сиқыршы деп аталатын адам...
Dialogue: 0,0:03:57.00,0:03:59.75,Default,,0,0,0,,Ақпарат Ресей билігіне жіберілді. →
Dialogue: 0,0:03:59.75,0:04:02.64,Default,,0,0,0,,ФСБ толтыру екі күннен кейін болады.
Dialogue: 0,0:04:02.64,0:04:05.46,Default,,0,0,0,,Жарайды. Қорытындылауға болатын деректерден басқа →
Dialogue: 0,0:04:05.46,0:04:07.86,Default,,0,0,0,,Берейік. Шілде ше?
Dialogue: 0,0:04:07.86,0:04:10.96,Default,,0,0,0,,Ол қазірдің өзінде осында. Жақсы.
Dialogue: 0,0:04:12.35,0:04:15.55,Default,,0,0,0,,Gacha bang (есік дыбысы)
Dialogue: 0,0:04:26.09,0:04:41.89,Default,,0,0,0,,Сен
Dialogue: 0,0:04:49.25,0:04:51.30,Default,,0,0,0,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:04:51.30,0:04:53.50,Default,,0,0,0,,!?
Dialogue: 0,0:04:55.17,0:04:57.77,Default,,0,0,0,,Не? Сіз және Сухо жиі →
Dialogue: 0,0:04:57.77,0:05:01.01,Default,,0,0,0,,Сіз менімен біргесіз, солай ма? Мен оны көптен бері қарап жүрмін. →
Dialogue: 0,0:05:01.01,0:05:03.11,Default,,0,0,0,,Мен бұл туралы көптен бері қызықтырдым...
Dialogue: 0,0:05:03.11,0:05:05.28,Default,,0,0,0,,Ах! Бұл Ника.
Dialogue: 0,0:05:05.28,0:05:07.53,Default,,0,0,0,,Мен де ақымақпын →
Dialogue: 0,0:05:07.53,0:05:09.89,Default,,0,0,0,,Мүмкін біз үнемі ұрысып қалатын шығармыз, бірақ мен білмеймін.→
Dialogue: 0,0:05:09.89,0:05:14.07,Default,,0,0,0,,Мен сені бағалаймын. Мен оны бағалағым келеді!
Dialogue: 0,0:05:14.07,0:05:18.28,Default,,0,0,0,,Сол себепті... Менімен араласқаныңызды қалаймын!
Dialogue: 0,0:05:18.28,0:05:21.88,Default,,0,0,0,,Уау... Уау~ Мойындау уақыты келді.
Dialogue: 0,0:05:21.88,0:05:24.77,Default,,0,0,0,,Ой, не істеуім керек...? Біз не істеуіміз керек? Мен не істеуім керек...
Dialogue: 0,0:05:24.77,0:05:28.24,Default,,0,0,0,,（） …
Dialogue: 0,0:05:28.24,0:05:31.81,Default,,0,0,0,,Жарайды ма? Бұл менмін...
Dialogue: 0,0:05:31.81,0:05:34.54,Default,,0,0,0,,Ой!
Dialogue: 0,0:05:34.54,0:05:36.54,Default,,0,0,0,,Каша
Dialogue: 0,0:05:39.00,0:05:42.54,Default,,0,0,0,,Шынымен бе? Бұл шынымен жақсы ма?
Dialogue: 0,0:05:42.54,0:05:44.54,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:46.14,0:05:49.19,Default,,0,0,0,,Уау! →
Dialogue: 0,0:05:49.19,0:05:52.50,Default,,0,0,0,,Уау! Йотто! →
Dialogue: 0,0:05:52.50,0:05:54.78,Default,,0,0,0,,Yo~tto! Хехе.
Dialogue: 0,0:05:54.78,0:05:57.00,Default,,0,0,0,,Ой…. →
Dialogue: 0,0:05:57.00,0:05:59.69,Default,,0,0,0,,Бүгін сенімен үйге келе аламын ба?
Dialogue: 0,0:05:59.69,0:06:03.19,Default,,0,0,0,,Иә! Куу~.
Dialogue: 0,0:06:04.79,0:06:07.38,Default,,0,0,0,,Бип... Каша
Dialogue: 0,0:06:07.38,0:06:09.41,Default,,0,0,0,,Сонда кездескенше!
Dialogue: 0,0:06:09.41,0:06:14.94,Default,,0,0,0,,Сен
Dialogue: 0,0:06:14.94,0:06:17.52,Default,,0,0,0,,Каша Уау!!
Dialogue: 0,0:06:17.52,0:06:20.16,Default,,0,0,0,,Сухо!? Ауырды...
Dialogue: 0,0:06:20.16,0:06:22.44,Default,,0,0,0,,Бұл... жарайды!? Сіз мұнда не істеп жүрсіз...?
Dialogue: 0,0:06:22.44,0:06:25.31,Default,,0,0,0,,А... Көрдің бе?
Dialogue: 0,0:06:25.31,0:06:28.23,Default,,0,0,0,,Хэ-хэ-хэ, мінекей.
Dialogue: 0,0:06:28.23,0:06:31.84,Default,,0,0,0,,А, жоқ... бұл әдейі емес. Бұл кездейсоқтық. Бұл кездейсоқтық!
Dialogue: 0,0:06:31.84,0:06:34.22,Default,,0,0,0,,Эй, бұл камера...
Dialogue: 0,0:06:34.22,0:06:37.29,Default,,0,0,0,,Жоқ~! Өшір, өшір! Апыр-ай! Күтіңіз, күтіңіз!
Dialogue: 0,0:06:37.29,0:06:40.59,Default,,0,0,0,,Өйткені Таня өте әдемі көрінді!
Dialogue: 0,0:06:40.59,0:06:44.93,Default,,0,0,0,,Сәлем. Дыбыстық сигнал
Dialogue: 0,0:06:44.93,0:06:47.07,Default,,0,0,0,,Әй, бұл сүйкімді. →
Dialogue: 0,0:06:47.07,0:06:51.69,Default,,0,0,0,,Аа, бірақ Сухо, жақсы ма? Өйткені Ника Сохоға тиесілі...
Dialogue: 0,0:06:51.69,0:06:54.32,Default,,0,0,0,,Мен!? Бұл әзіл емес!
Dialogue: 0,0:06:54.32,0:06:56.68,Default,,0,0,0,,Мен Никамен фото клубында болдым→
Dialogue: 0,0:06:56.68,0:06:59.21,Default,,0,0,0,,Кім сондай зорлықшы...→
Dialogue: 0,0:06:59.21,0:07:01.53,Default,,0,0,0,,Жоқ. Ерм...→
Dialogue: 0,0:07:01.53,0:07:04.84,Default,,0,0,0,,Жарайды, анау жігіт. Мен төбелесуге тез →
Dialogue: 0,0:07:04.84,0:07:09.09,Default,,0,0,0,,Ол менен бір сынып жоғары болса да, ол әлі кішкентай және оның стиль сезімі керемет емес.
Dialogue: 0,0:07:09.09,0:07:13.51,Default,,0,0,0,,Ол таңқаларлықтай кішкентай балаларға мейірімді және жақсы жігіт.
Dialogue: 0,0:07:13.51,0:07:18.10,Default,,0,0,0,,Мен кепілдік беремін. Рахмет Сухо.
Dialogue: 0,0:07:18.10,0:07:20.85,Default,,0,0,0,,Таня, сен ғашық болып қалған шығарсың.
Dialogue: 0,0:07:20.85,0:07:23.79,Default,,0,0,0,,Тоқта! (2 адам) Хехехехе.
Dialogue: 0,0:07:23.79,0:07:26.07,Default,,0,0,0,,（）～ →
Dialogue: 0,0:07:26.07,0:07:29.91,Default,,0,0,0,,～ （） ～
Dialogue: 0,0:07:29.91,0:07:32.51,Default,,0,0,0,,А, дұрыс! Қазір барайық!
Dialogue: 0,0:07:33.98,0:07:36.02,Default,,0,0,0,,<Әлем бір түнде өзгеруі мүмкін→
Dialogue: 0,0:07:36.02,0:07:38.05,Default,,0,0,0,,Жиі болады
Dialogue: 0,0:07:38.05,0:07:40.49,Default,,0,0,0,,Каша Каша
Dialogue: 0,0:07:40.49,0:07:43.54,Default,,0,0,0,,<Мен әлі махаббаттың не екенін білмеймін>
Dialogue: 0,0:07:43.54,0:07:48.46,Default,,0,0,0,,Сен
Dialogue: 0,0:07:48.46,0:07:52.73,Default,,0,0,0,,＜Бірақ мен Таня үшін сол күннің келгенін білдім＞
Dialogue: 0,0:07:52.73,0:08:04.74,Default,,0,0,0,,Сен
Dialogue: 0,0:08:04.74,0:08:09.12,Default,,0,0,0,,<Біз ешқашан нағыз жұлдызды аспанды көрген емеспіз>
Dialogue: 0,0:08:09.12,0:08:11.38,Default,,0,0,0,,<Осыдан 13 жыл бұрын бір күн, кенет →
Dialogue: 0,0:08:11.38,0:08:14.20,Default,,0,0,0,,Токио мен Бразилияда қақпалар ашылды＞
Dialogue: 0,0:08:14.20,0:08:16.41,Default,,0,0,0,,<Токио қақпасы - «Тозақ қақпасы»>
Dialogue: 0,0:08:16.41,0:08:19.94,Default,,0,0,0,,<Бразилия қақпасы «Аспан қақпасы» деп аталды>
Dialogue: 0,0:08:19.94,0:08:24.50,Default,,0,0,0,,<Қақпа жанында белгісіз заттар мен түсініксіз құбылыстар пайда болады→
Dialogue: 0,0:08:24.50,0:08:26.90,Default,,0,0,0,,Оған ешкім жақындай алмады >
Dialogue: 0,0:08:26.90,0:08:29.60,Default,,0,0,0,,Қаша Қаша Қаша
Dialogue: 0,0:08:29.60,0:08:32.06,Default,,0,0,0,,Сіз не істеп жатырсыз? Бұл күлкілі болса да.
Dialogue: 0,0:08:32.06,0:08:35.51,Default,,0,0,0,,Оған көмектесу мүмкін емес! Бұл линза макро линзамен бірге келмейді.
Dialogue: 0,0:08:35.51,0:08:37.54,Default,,0,0,0,,Жоқ, менің айтқым келгені бұл емес.
Dialogue: 0,0:08:37.54,0:08:40.30,Default,,0,0,0,,Шалбарыңыз толығымен көрінеді. Уф!
Dialogue: 0,0:08:40.30,0:08:43.22,Default,,0,0,0,,Мен колготки киіп жүрмін, сондықтан ұялмаймын!
Dialogue: 0,0:08:43.22,0:08:45.27,Default,,0,0,0,,Бұл ұят!
Dialogue: 0,0:08:45.27,0:08:54.48,Default,,0,0,0,,Сен
Dialogue: 0,0:08:54.48,0:08:57.71,Default,,0,0,0,,<Әлем қатты өзгерді>
Dialogue: 0,0:08:57.71,0:09:00.50,Default,,0,0,0,,<Сонымен қатар үлкен соғыс болды>
Dialogue: 0,0:09:00.50,0:09:04.19,Default,,0,0,0,,<Бұл аймақ соғыстан аз зардап шекті→
Dialogue: 0,0:09:04.19,0:09:06.69,Default,,0,0,0,,Өзгерістер келе бастады>
Dialogue: 0,0:09:11.28,0:09:13.28,Default,,0,0,0,,Сылдырмақ...
Dialogue: 0,0:09:15.18,0:09:17.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:17.22,0:09:19.89,Default,,0,0,0,,Сәлем! мияу!
Dialogue: 0,0:09:19.89,0:09:23.24,Default,,0,0,0,,Гача Сухоға қош келдіңіз. не?
Dialogue: 0,0:09:23.24,0:09:26.96,Default,,0,0,0,,Мен үйдемін, Белла. Бұл қаңғыбас мысық. Бұл Петядан кейін болды.
Dialogue: 0,0:09:26.96,0:09:30.68,Default,,0,0,0,,Шынымен бе? Мен абай болуым керек. →
Dialogue: 0,0:09:30.68,0:09:33.98,Default,,0,0,0,,Кешіріңіз, дәрігер, мен де бүгін бос емеспін→
Dialogue: 0,0:09:33.98,0:09:37.65,Default,,0,0,0,,Ғылыми-зерттеу институты қайтып келе алмайтынын айтты. →
Dialogue: 0,0:09:37.65,0:09:41.31,Default,,0,0,0,,Мен көп күріш жасадым, оны жеп қойыңыз.
Dialogue: 0,0:09:41.31,0:09:43.71,Default,,0,0,0,,Иә! Эй, Белла, тыңда, тыңда.
Dialogue: 0,0:09:43.71,0:09:46.05,Default,,0,0,0,,Таня бүгін есінен танып қалды!
Dialogue: 0,0:09:46.05,0:09:48.87,Default,,0,0,0,,Шынымен!? Кімге? кімге? Бұл Ника!
Dialogue: 0,0:09:48.87,0:09:51.38,Default,,0,0,0,,Мен таң қалдым! Иә~ Өтірік~ →
Dialogue: 0,0:09:51.38,0:09:53.49,Default,,0,0,0,,Ника Сохоның жігіті емес пе еді?
Dialogue: 0,0:09:53.49,0:09:58.78,Default,,0,0,0,,Жоқ! Бұл мүлдем басқа! Эй, мен сенімдімін...
Dialogue: 0,0:09:58.78,0:10:00.88,Default,,0,0,0,,Чи~га~у~!
Dialogue: 0,0:10:00.88,0:10:04.23,Default,,0,0,0,,Сонда Сухода біреу бар ма? Маған ұнайтын адам.
Dialogue: 0,0:10:04.23,0:10:07.53,Default,,0,0,0,,Егер ол жоқ болса, ол әлдеқашан~! Хехе.
Dialogue: 0,0:10:09.34,0:10:14.87,Default,,0,0,0,,<Қақпаның пайда болуымен нағыз жұлдызды аспан ғайып болды>
Dialogue: 0,0:10:14.87,0:10:18.47,Default,,0,0,0,,<Біздің қазір қарап отырғанымыз - жалған аспан>
Dialogue: 0,0:10:20.05,0:10:23.05,Default,,0,0,0,,<Ал мен білемін>
Dialogue: 0,0:10:25.09,0:10:30.19,Default,,0,0,0,,＜Аспандағы бұл жұлдыз – келісімге отырған тараптың өмірі＞
Dialogue: 0,0:10:31.81,0:10:34.28,Default,,0,0,0,,Concon Бұл менмін. Мен кіремін.
Dialogue: 0,0:10:34.28,0:10:36.58,Default,,0,0,0,,（） （）
Dialogue: 0,0:10:38.00,0:10:43.00,Default,,0,0,0,,Қайтадан қош келдіңіз, Сухо. Шион қазір.
Dialogue: 0,0:10:45.77,0:10:47.94,Default,,0,0,0,,Махаббат...? →
Dialogue: 0,0:10:47.94,0:10:51.59,Default,,0,0,0,,Бұл түсіну қиын эмоциялардың бірі. →
Dialogue: 0,0:10:51.59,0:10:55.73,Default,,0,0,0,,Гормон секрециясының әсерінен болатын реакция екені анық болса да→
Dialogue: 0,0:10:55.73,0:10:58.12,Default,,0,0,0,,Адамдар оған тәуелді болуға тырысады.
Dialogue: 0,0:10:58.12,0:11:01.42,Default,,0,0,0,,Жоқ, бұл жақсы сезім емес.
Dialogue: 0,0:11:02.74,0:11:05.34,Default,,0,0,0,,Не... не? (Шион) Жоқ... →
Dialogue: 0,0:11:05.34,0:11:10.96,Default,,0,0,0,,Сенің осылай армандай алатының керемет деп ойлаймын, Сухо.
Dialogue: 0,0:11:10.96,0:11:13.76,Default,,0,0,0,,Бұл не? Сіз мені мазақ етіп жатырсыз...
Dialogue: 0,0:11:15.64,0:11:18.10,Default,,0,0,0,,Дегенмен, армандар - сіз оятуға болатын нәрсе. →
Dialogue: 0,0:11:18.10,0:11:20.30,Default,,0,0,0,,Ана мен әке сияқты.
Dialogue: 0,0:11:22.34,0:11:27.64,Default,,0,0,0,,Қараңдаршы, анамның фотокітапшасы. Анам жақсы көрінеді.
Dialogue: 0,0:11:29.62,0:11:35.19,Default,,0,0,0,,Эй, Шион, анама барайық. Жапонияға...
Dialogue: 0,0:11:35.19,0:11:37.66,Default,,0,0,0,,Неліктен? Неге...
Dialogue: 0,0:11:37.66,0:11:41.76,Default,,0,0,0,,Анам маған қазір керек емес адам.
Dialogue: 0,0:11:44.65,0:11:46.65,Default,,0,0,0,,Уш (есік дыбысы)
Dialogue: 0,0:11:50.10,0:11:52.74,Default,,0,0,0,,… …（）
Dialogue: 0,0:11:52.74,0:11:55.74,Default,,0,0,0,,А... Әке. Уф!
Dialogue: 0,0:11:57.24,0:11:59.76,Default,,0,0,0,,Ол маған бұл бөлмеде көп қалмау керектігін айтты.
Dialogue: 0,0:11:59.76,0:12:04.50,Default,,0,0,0,,Бірақ әке... Шион менің інім ғой, солай ма? Ол менің егіз ағам!
Dialogue: 0,0:12:04.50,0:12:06.67,Default,,0,0,0,,Ағайындылар немесе отбасы →
Dialogue: 0,0:12:06.67,0:12:09.46,Default,,0,0,0,,Оның Шионға қатысы жоқ. Түсінбесеңіз →
Dialogue: 0,0:12:09.46,0:12:11.49,Default,,0,0,0,,Сіз зардап шегесіз.
Dialogue: 0,0:12:11.49,0:12:14.94,Default,,0,0,0,,Неліктен!? Неге, олар отбасы болса да!
Dialogue: 0,0:12:14.94,0:12:18.00,Default,,0,0,0,,Сізде... әлі де осындай нәрсе бар.
Dialogue: 0,0:12:18.00,0:12:20.80,Default,,0,0,0,,Анам... мені күтіп отыр!
Dialogue: 0,0:12:20.80,0:12:22.84,Default,,0,0,0,,Сонымен... Сухо!
Dialogue: 0,0:12:22.84,0:12:27.41,Default,,0,0,0,,Армандауға болмайды. Уақыт тек алға жылжиды. →
Dialogue: 0,0:12:27.41,0:12:29.71,Default,,0,0,0,,Артқа жол жоқ.
Dialogue: 0,0:12:31.80,0:12:34.10,Default,,0,0,0,,Сухо! Bang!
Dialogue: 0,0:12:38.94,0:12:42.74,Default,,0,0,0,,Кю~ Кю~ Мердігерлердің жүрегі жоқ...
Dialogue: 0,0:12:44.64,0:12:48.34,Default,,0,0,0,,Эй Петя, сен қалай ойлайсың?
Dialogue: 0,0:12:53.13,0:12:55.20,Default,,0,0,0,,Баша (Печа) Кю~!
Dialogue: 0,0:12:55.20,0:12:57.37,Default,,0,0,0,,Уау! Мұнда! башан
Dialogue: 0,0:12:57.37,0:13:00.97,Default,,0,0,0,,Әй, Печа! Уф! Уф... Уау! Ах... Уау!
Dialogue: 0,0:13:02.41,0:13:04.41,Default,,0,0,0,,Жоқ!!
Dialogue: 0,0:15:10.85,0:15:15.64,Default,,0,0,0,,<Әлем бір түнде жиі өзгереді>
Dialogue: 0,0:15:15.64,0:15:17.94,Default,,0,0,0,,＜Алдын ала ескертусіз...＞
Dialogue: 0,0:15:20.63,0:15:22.63,Default,,0,0,0,,...
Dialogue: 0,0:15:27.19,0:15:30.76,Default,,0,0,0,,Не болды? Таня. Менің кешігіп қалуым әдеттен тыс.
Dialogue: 0,0:15:30.76,0:15:32.76,Default,,0,0,0,,Ештеңе.
Dialogue: 0,0:15:35.50,0:15:37.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:40.48,0:15:42.48,Default,,0,0,0,,Гача
Dialogue: 0,0:15:46.91,0:15:48.91,Default,,0,0,0,,Таня! (Саша) Таня!
Dialogue: 0,0:15:51.04,0:15:54.91,Default,,0,0,0,,Не болды? Таня біртүрлі әрекет етеді.
Dialogue: 0,0:15:54.91,0:15:56.91,Default,,0,0,0,,Таня….
Dialogue: 0,0:16:00.10,0:16:02.69,Default,,0,0,0,,Таня! →
Dialogue: 0,0:16:02.69,0:16:05.56,Default,,0,0,0,,Күте тұрыңыз, эй!
Dialogue: 0,0:16:05.56,0:16:10.16,Default,,0,0,0,,Босатыңыз. А... Әй, не болды?
Dialogue: 0,0:16:10.16,0:16:13.37,Default,,0,0,0,,Бүгін таңертең жиналысқа келмедің бе? Неліктен? →
Dialogue: 0,0:16:13.37,0:16:15.54,Default,,0,0,0,,Мен бірдеңені дұрыс істемедім бе?
Dialogue: 0,0:16:15.54,0:16:18.32,Default,,0,0,0,,Оның мағынасыз екенін түсіндім. Босқа кетті ме?
Dialogue: 0,0:16:18.32,0:16:20.92,Default,,0,0,0,,Сіздің балаңызды дүниеге әкелетін ойым әлі жоқ→
Dialogue: 0,0:16:20.92,0:16:23.63,Default,,0,0,0,,Мұны істеудің қажеті жоқ.
Dialogue: 0,0:16:23.63,0:16:25.80,Default,,0,0,0,,Ол ниетпен оны байытпа!
Dialogue: 0,0:16:25.80,0:16:28.58,Default,,0,0,0,,Содан кейін жіберіңіз. Фу... Ақымақ болма!
Dialogue: 0,0:16:28.58,0:16:31.68,Default,,0,0,0,,Эй, не болды? (Таня) Егер мені жібермесең...
Dialogue: 0,0:16:33.77,0:16:36.41,Default,,0,0,0,,А... аа....
Dialogue: 0,0:16:36.41,0:16:39.01,Default,,0,0,0,,Lancernopt синхротрондық сәулеленуі….
Dialogue: 0,0:16:40.49,0:16:43.73,Default,,0,0,0,,Уау! Апыр-ай! →
Dialogue: 0,0:16:43.73,0:16:46.02,Default,,0,0,0,,Уау! Аа….
Dialogue: 0,0:16:46.02,0:16:48.05,Default,,0,0,0,,Таня!
Dialogue: 0,0:16:48.05,0:16:51.62,Default,,0,0,0,,Уау... Уау... →
Dialogue: 0,0:16:51.62,0:16:55.49,Default,,0,0,0,,Хаа хаа ха....
Dialogue: 0,0:16:55.49,0:16:58.39,Default,,0,0,0,,Бұлз жыпылықтау Ах... Ааа...
Dialogue: 0,0:17:00.90,0:17:03.30,Default,,0,0,0,,Ke… Мердігер?
Dialogue: 0,0:17:06.32,0:17:09.32,Default,,0,0,0,,Уау! (Елена) Мұғалім~!
Dialogue: 0,0:17:10.76,0:17:12.98,Default,,0,0,0,,Таня!
Dialogue: 0,0:17:12.98,0:17:15.76,Default,,0,0,0,,Келісімге келген адамға реинкарнация белгілері жоқ. →
Dialogue: 0,0:17:15.76,0:17:17.80,Default,,0,0,0,,Бұл кенеттен. →
Dialogue: 0,0:17:17.80,0:17:21.52,Default,,0,0,0,,Тұлға және мінез-құлық үлгілері айтарлықтай өзгереді →
Dialogue: 0,0:17:21.52,0:17:23.57,Default,,0,0,0,,Әрқашан дүрбелең тудырыңыз. →
Dialogue: 0,0:17:23.57,0:17:25.84,Default,,0,0,0,,Көп ұзамай ол мемлекеттік мекемеде ұсталды→
Dialogue: 0,0:17:25.84,0:17:29.39,Default,,0,0,0,,Ал айналадағы адамдардың мердігер туралы естеліктері →
Dialogue: 0,0:17:29.39,0:17:31.43,Default,,0,0,0,,Жойылған Ah...
Dialogue: 0,0:17:31.43,0:17:35.36,Default,,0,0,0,,Әкем зерттеп жатқан ME-ді пайдаланыңыз.
Dialogue: 0,0:17:35.36,0:17:41.52,Default,,0,0,0,,Сен
Dialogue: 0,0:17:41.52,0:17:43.99,Default,,0,0,0,,Таня... жоқ!
Dialogue: 0,0:17:43.99,0:17:50.11,Default,,0,0,0,,Сен
Dialogue: 0,0:17:50.11,0:17:53.10,Default,,0,0,0,,Ах... Уф...
Dialogue: 0,0:17:53.10,0:17:58.30,Default,,0,0,0,,Сен
Dialogue: 0,0:18:01.39,0:18:05.11,Default,,0,0,0,,Әке. Шион! Неге мұндасың?
Dialogue: 0,0:18:05.11,0:18:08.58,Default,,0,0,0,,Сіз бұл үйде көптеген құпия өткелдер салдыңыз.
Dialogue: 0,0:18:08.58,0:18:11.02,Default,,0,0,0,,Қауіп маған немесе әкеме жақындаса да→
Dialogue: 0,0:18:11.02,0:18:14.20,Default,,0,0,0,,Бірден қашып құтылу үшін. →
Dialogue: 0,0:18:14.20,0:18:17.92,Default,,0,0,0,,Уақыт келді, әке. сен….
Dialogue: 0,0:18:17.92,0:18:20.22,Default,,0,0,0,,Мен бағаны төледім.
Dialogue: 0,0:18:22.36,0:18:30.10,Default,,0,0,0,,Сен
Dialogue: 0,0:18:30.10,0:18:32.10,Default,,0,0,0,,Гача
Dialogue: 0,0:18:34.17,0:18:36.17,Default,,0,0,0,,Гакко
Dialogue: 0,0:18:37.84,0:18:39.88,Default,,0,0,0,,Ол меннен қанша есе мықты. (Очако) Ах…
Dialogue: 0,0:18:39.88,0:18:43.70,Default,,0,0,0,,Сен
Dialogue: 0,0:18:43.70,0:18:45.94,Default,,0,0,0,,Ол меннен қанша есе мықты. (Очако) Ах…
Dialogue: 0,0:18:45.94,0:18:47.77,Default,,0,0,0,,Гашан! Дада!
Dialogue: 0,0:18:47.77,0:18:49.99,Default,,0,0,0,,...
Dialogue: 0,0:18:49.99,0:18:53.46,Default,,0,0,0,,Сухо…. Шион?
Dialogue: 0,0:18:53.46,0:18:56.06,Default,,0,0,0,,Кел, Сухо. Менің бөлмеме.
Dialogue: 0,0:18:59.23,0:19:02.05,Default,,0,0,0,,...
Dialogue: 0,0:19:02.05,0:19:06.01,Default,,0,0,0,,Сен
Dialogue: 0,0:19:06.01,0:19:08.04,Default,,0,0,0,,Белла?
Dialogue: 0,0:19:08.04,0:19:13.03,Default,,0,0,0,,Сен
Dialogue: 0,0:19:13.03,0:19:15.18,Default,,0,0,0,,Ах! Қозғалма. →
Dialogue: 0,0:19:15.18,0:19:17.70,Default,,0,0,0,,Әзірше осы зертханадағы барлығын қатырыңыз. →
Dialogue: 0,0:19:17.70,0:19:20.10,Default,,0,0,0,,Ештеңеге қол тигізбеңіз. →
Dialogue: 0,0:19:20.10,0:19:22.62,Default,,0,0,0,,Ах! Бум!
Dialogue: 0,0:19:22.62,0:19:26.14,Default,,0,0,0,,Киіміңді ауыстыр. Менің киімім ерекшеленбейді.
Dialogue: 0,0:19:26.14,0:19:29.46,Default,,0,0,0,,Кацун... (Шионның дауысы) Бұл бойтұмар. →
Dialogue: 0,0:19:29.46,0:19:33.13,Default,,0,0,0,,Оны міндетті түрде киіңіз. Шион?
Dialogue: 0,0:19:33.13,0:19:36.55,Default,,0,0,0,,Жоғалтып алмасақ, міндетті түрде тағы кездесеміз.
Dialogue: 0,0:19:36.55,0:19:41.41,Default,,0,0,0,,Сен
Dialogue: 0,0:19:41.41,0:19:43.69,Default,,0,0,0,,Ғылыми-зерттеу институтына қарай шығу. →
Dialogue: 0,0:19:43.69,0:19:47.05,Default,,0,0,0,,Белла шығудың жолын біледі. Белла?
Dialogue: 0,0:19:47.05,0:19:50.12,Default,,0,0,0,,Сіз нені айтасыз? Шион. Не болып жатыр!
Dialogue: 0,0:19:50.12,0:19:52.39,Default,,0,0,0,,Мен қуған жоқпын ба?
Dialogue: 0,0:19:52.39,0:19:56.09,Default,,0,0,0,,Сұрақтар қойылмаған. Сау бол Сухо.
Dialogue: 0,0:19:57.52,0:19:59.58,Default,,0,0,0,,Бұл газ ыдысы. Қашу.
Dialogue: 0,0:19:59.58,0:20:02.14,Default,,0,0,0,,Түсінді. Оны кесте бойынша жинаңыз. →
Dialogue: 0,0:20:02.14,0:20:05.40,Default,,0,0,0,,Доктор Шионның деректеріне басымдық беріледі.
Dialogue: 0,0:20:05.40,0:20:07.40,Default,,0,0,0,,Түсіндім. →
Dialogue: 0,0:20:09.24,0:20:13.37,Default,,0,0,0,,Tsk! Бірінші гол: жеңіліс. Ол қашып кеткен сияқты. →
Dialogue: 0,0:20:13.37,0:20:15.47,Default,,0,0,0,,шілде Оның қайда бара жатқанын білесіз бе?
Dialogue: 0,0:20:15.47,0:20:19.43,Default,,0,0,0,,Мен білмеймін. Бұл бөлмеде әйнек жоқ.
Dialogue: 0,0:20:19.43,0:20:21.65,Default,,0,0,0,,Жарайды. Дәрігер бөлмесі ше?
Dialogue: 0,0:20:21.65,0:20:24.02,Default,,0,0,0,,Онда кім бар? (сәуір/музыка) Шион? →
Dialogue: 0,0:20:24.02,0:20:26.57,Default,,0,0,0,,Әлде ФСБ? (Шілде радиосы) № →
Dialogue: 0,0:20:26.57,0:20:29.64,Default,,0,0,0,,Ересектер. шығыстық. →
Dialogue: 0,0:20:29.64,0:20:32.54,Default,,0,0,0,,Бетперде кию.
Dialogue: 0,0:20:32.54,0:20:34.53,Default,,0,0,0,,Маска? Дыбыстық сигнал... (ескерту дыбысы)
Dialogue: 0,0:20:34.53,0:20:36.63,Default,,0,0,0,,Сәуір телефондары тыңдалып жатыр. →
Dialogue: 0,0:20:36.63,0:20:40.13,Default,,0,0,0,,Содан кейін Радио бұғатталған. C. Tsk жоспарымен жалғастырыңыз!
Dialogue: 0,0:20:41.95,0:20:44.57,Default,,0,0,0,,...
Dialogue: 0,0:20:44.57,0:20:47.77,Default,,0,0,0,,… （）
Dialogue: 0,0:20:49.61,0:20:52.01,Default,,0,0,0,,...
Dialogue: 0,0:20:52.01,0:20:55.43,Default,,0,0,0,,- Шион? Шион қайда?
Dialogue: 0,0:20:55.43,0:20:57.47,Default,,0,0,0,,...
Dialogue: 0,0:20:57.47,0:21:00.10,Default,,0,0,0,,…
Dialogue: 0,0:21:00.10,0:21:03.11,Default,,0,0,0,,（） ～!!
Dialogue: 0,0:21:03.11,0:21:11.86,Default,,0,0,0,,Сен
Dialogue: 0,0:21:11.86,0:21:14.16,Default,,0,0,0,,Айналдыра! (Найзағай) Ах...
Dialogue: 0,0:21:15.89,0:21:18.35,Default,,0,0,0,,Аа….
Dialogue: 0,0:21:18.35,0:21:20.35,Default,,0,0,0,,Пишаан! (найзағай)
Dialogue: 0,0:21:21.94,0:21:24.84,Default,,0,0,0,,Хахаха... Дәрігер!
Dialogue: 0,0:21:26.45,0:21:29.15,Default,,0,0,0,,Қарғыс атсын! Өлді. →
Dialogue: 0,0:21:29.15,0:21:31.73,Default,,0,0,0,,Зақым жоқ. Құсу да →
Dialogue: 0,0:21:31.73,0:21:34.44,Default,,0,0,0,,Басқа іздер табылмады.
Dialogue: 0,0:21:34.44,0:21:36.89,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:21:36.89,0:21:41.58,Default,,0,0,0,,Мен MI6-дан келген сәуірмін. Сіз әңгімені естіген болуыңыз керек.
Dialogue: 0,0:21:41.58,0:21:44.15,Default,,0,0,0,,Шион: Нақты не болды?
Dialogue: 0,0:21:44.15,0:21:47.82,Default,,0,0,0,,Дәрігер неліктен өлді? Белла?
Dialogue: 0,0:21:47.82,0:21:50.45,Default,,0,0,0,,Сухо?
Dialogue: 0,0:21:50.45,0:21:54.41,Default,,0,0,0,,Шион ше? Шион қайда!? Аа... білмеймін.
Dialogue: 0,0:21:54.41,0:21:56.51,Default,,0,0,0,,…（）
Dialogue: 0,0:21:58.38,0:22:01.73,Default,,0,0,0,,Гача Докарн!!
Dialogue: 0,0:22:01.73,0:22:05.03,Default,,0,0,0,,Хахахаха….
Dialogue: 0,0:22:06.35,0:22:08.87,Default,,0,0,0,,Bang Bang Bang!
Dialogue: 0,0:22:08.87,0:22:10.86,Default,,0,0,0,,Tsk…. Ха!
Dialogue: 0,0:22:10.86,0:22:13.56,Default,,0,0,0,,Сен
Dialogue: 0,0:22:13.56,0:22:16.73,Default,,0,0,0,,Міне. Сізбен бірге келгенімді қалайсыз ба?
Dialogue: 0,0:22:16.73,0:22:19.20,Default,,0,0,0,,Егер сіз оның тыныш болуын қаласаңыз, оны ажыратуға болады.
Dialogue: 0,0:22:19.20,0:22:21.60,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:22:21.60,0:22:23.64,Default,,0,0,0,,Дон! Ол аурады!
Dialogue: 0,0:22:23.64,0:22:26.16,Default,,0,0,0,,Келіңіздер! Бұл қарастыру болса да, осындай нәрсе→
Dialogue: 0,0:22:26.16,0:22:31.16,Default,,0,0,0,,Мен соншалықты көп жегім келмейді. Қарғыс атсын!
Dialogue: 0,0:22:33.38,0:22:36.68,Default,,0,0,0,,Ах! Бұл ысырап. Мүлдем емес…→
Dialogue: 0,0:22:36.68,0:22:39.28,Default,,0,0,0,,Ертең бұлшық еттерім ауырады.
Dialogue: 0,0:22:40.67,0:22:43.91,Default,,0,0,0,,Керемет!
Dialogue: 0,0:22:43.91,0:22:45.91,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:48.04,0:22:52.43,Default,,0,0,0,,Мердігер? Бұл қиын... Банг!
Dialogue: 0,0:22:52.43,0:23:00.89,Default,,0,0,0,,Сен
Dialogue: 0,0:23:00.89,0:23:02.88,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:23:02.88,0:23:04.91,Default,,0,0,0,,Сен
Dialogue: 0,0:23:04.91,0:23:07.61,Default,,0,0,0,,Уф! Қарғыс атсын!
Dialogue: 0,0:23:07.61,0:23:11.08,Default,,0,0,0,,Сен
Dialogue: 0,0:23:11.08,0:23:13.45,Default,,0,0,0,,Заа!
Dialogue: 0,0:23:13.45,0:23:17.56,Default,,0,0,0,,Сен
Dialogue: 0,0:23:17.56,0:23:20.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:20.34,0:23:24.44,Default,,0,0,0,,Теаа
Dialogue: 0,0:23:25.80,0:23:29.00,Default,,0,0,0,,Уф... иә...
Dialogue: 0,0:23:30.84,0:23:32.84,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:23:35.71,0:23:38.69,Default,,0,0,0,,Сіз жаман нәрсе жасадыңыз. Уф! →
Dialogue: 0,0:23:38.69,0:23:41.05,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:23:41.05,0:23:43.08,Default,,0,0,0,,Сіз...
Dialogue: 0,0:23:43.08,0:23:45.90,Default,,0,0,0,,Сен
Dialogue: 0,0:23:45.90,0:23:47.89,Default,,0,0,0,,Банг! Пюн пюн пюн
Dialogue: 0,0:23:47.89,0:23:56.49,Default,,0,0,0,,Сен
Dialogue: 0,0:24:00.78,0:24:20.22,Default,,0,0,0,,Сен
Dialogue: 0,0:24:20.22,0:24:40.21,Default,,0,0,0,,Сен
Dialogue: 0,0:24:40.21,0:25:00.39,Default,,0,0,0,,Сен
Dialogue: 0,0:25:00.39,0:25:20.25,Default,,0,0,0,,Сен
Dialogue: 0,0:25:20.25,0:25:30.25,Default,,0,0,0,,Сен
Dialogue: 0,0:25:36.15,0:25:38.36,Default,,0,0,0,,Катсун…
Dialogue: 0,0:25:38.36,0:25:42.66,Default,,0,0,0,,БҚ… 201….
Dialogue: 0,0:27:29.22,0:27:31.21,Default,,0,0,0,,<Жалған аспанда жұлдыздар ағып жатыр→
Dialogue: 0,0:27:31.21,0:27:34.68,Default,,0,0,0,,Өмір жарқыраған сәтте жоғалады＞
Dialogue: 0,0:27:34.68,0:27:38.25,Default,,0,0,0,,<Қызыл жалын кешегі байланыстарды өшіреді→
Dialogue: 0,0:27:38.25,0:27:40.99,Default,,0,0,0,,Барлығын өртеп жіберу＞
Dialogue: 0,0:27:40.99,0:27:44.37,Default,,0,0,0,,<Суық жүз жүректі тесіп өтеді→
Dialogue: 0,0:27:44.37,0:27:47.94,Default,,0,0,0,,Тоңған қалада жалғыз қыз кезіп жүр＞
Dialogue: 0,0:27:47.94,0:27:50.71,Default,,0,0,0,,<Жарық түскен жұлдызға қайтып келмейді→
Dialogue: 0,0:27:50.71,0:27:53.65,Default,,0,0,0,,Қара және шіріген>
Dialogue: 0,0:27:53.65,0:27:57.15,Default,,0,0,0,,<Жұлдыздар қайтадан ағады>
