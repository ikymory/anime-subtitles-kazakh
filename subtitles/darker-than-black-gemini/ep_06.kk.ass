Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.18,0:00:11.54,Default,,0000,0000,0000,,Хмм, дәмді! →
Dialogue: 0,0:00:11.54,0:00:14.90,Default,,0000,0000,0000,,Қандай қарапайым!
Dialogue: 0,0:00:14.90,0:00:16.26,Default,,0000,0000,0000,,Мен шыдай алмаймын. →
Dialogue: 0,0:00:16.26,0:00:18.78,Default,,0000,0000,0000,,Түстен кейінгі шайды жайбарақат ішу керек.
Dialogue: 0,0:00:18.78,0:00:22.31,Default,,0000,0000,0000,,Бұл оңай болатын уақыт емес! →
Dialogue: 0,0:00:22.31,0:00:24.50,Default,,0000,0000,0000,,Анашым, мен келдім, анашым!
Dialogue: 0,0:00:24.50,0:00:26.86,Default,,0000,0000,0000,,Фу. →
Dialogue: 0,0:00:26.86,0:00:29.86,Default,,0000,0000,0000,,Мен аузыма спонжды көп қоятынымды жиі айтамын.
Dialogue: 0,0:00:31.57,0:00:50.44,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:00:50.44,0:01:10.30,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:10.30,0:01:30.34,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:30.34,0:01:49.34,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:54.91,0:02:00.91,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:07.21,0:02:10.40,Default,,0000,0000,0000,,Сіз әдеттегідей өте шеберсіз, Мичиру-чан.
Dialogue: 0,0:02:10.40,0:02:13.59,Default,,0000,0000,0000,,Эй... танысқаныма қуаныштымын! Емес... →
Dialogue: 0,0:02:13.59,0:02:16.29,Default,,0000,0000,0000,,Үнемі фотоларыңа қараймын... А... мінекей→
Dialogue: 0,0:02:16.29,0:02:18.64,Default,,0000,0000,0000,,Атақты адамдардың жанкүйерлеріне қараңдар!
Dialogue: 0,0:02:18.64,0:02:21.01,Default,,0000,0000,0000,,Тоқтайын деген ниетім жоқ еді, бірақ→
Dialogue: 0,0:02:21.01,0:02:24.01,Default,,0000,0000,0000,,Бұл қарастыру болғандықтан, мен оған көмектесе алмаймын.
Dialogue: 0,0:02:26.22,0:02:28.58,Default,,0000,0000,0000,,Дыбыстық сигнал (жұмыс дыбысы) Қыз осында→
Dialogue: 0,0:02:28.58,0:02:30.10,Default,,0000,0000,0000,,Сіз келдіңіз, солай ма? Ах... ой! →
Dialogue: 0,0:02:30.10,0:02:33.29,Default,,0000,0000,0000,,Мына бала сүйкімді! Сіздерді таныстыруға рұқсат етіңіздер! →
Dialogue: 0,0:02:33.29,0:02:36.15,Default,,0000,0000,0000,,Бәлкім бір күні сенің анаң немесе қайынсіңлілерің болып қалармын. →
Dialogue: 0,0:02:36.15,0:02:39.69,Default,,0000,0000,0000,,Дұрыс? Қараңызшы, ене соғысы!
Dialogue: 0,0:02:39.69,0:02:42.88,Default,,0000,0000,0000,,Ерекше ұлы, иә?
Dialogue: 0,0:02:42.88,0:02:45.24,Default,,0000,0000,0000,,Мені тастап кеткен ананы қарсы алыңыздар
Dialogue: 0,0:02:45.24,0:02:47.94,Default,,0000,0000,0000,,Хехе, білімі жақсы емес пе еді? →
Dialogue: 0,0:02:47.94,0:02:51.81,Default,,0000,0000,0000,,Ақыл-парасат байламынан арылған еркіндік перзенті.
Dialogue: 0,0:02:51.81,0:02:54.17,Default,,0000,0000,0000,,Әй, білім... →
Dialogue: 0,0:02:54.17,0:02:57.17,Default,,0000,0000,0000,,Ал, ол 20 минуттай пісіріледі.
Dialogue: 0,0:02:59.22,0:03:02.25,Default,,0000,0000,0000,,А...Анашым, үйге барасыз ба? →
Dialogue: 0,0:03:02.25,0:03:04.27,Default,,0000,0000,0000,,Әсерлі кездесу?
Dialogue: 0,0:03:04.27,0:03:07.97,Default,,0000,0000,0000,,Өйткені мен аналық ештеңе істеп жатқан жоқпын.→
Dialogue: 0,0:03:07.97,0:03:09.16,Default,,0000,0000,0000,,Бір кеңес
Dialogue: 0,0:03:09.16,0:03:14.87,Default,,0000,0000,0000,,Менің ойымша, ол қызға көп араласпаған дұрыс. →
Dialogue: 0,0:03:14.87,0:03:16.06,Default,,0000,0000,0000,,Ауыратынына сенімдімін
Dialogue: 0,0:03:16.06,0:03:18.91,Default,,0000,0000,0000,,А...
Dialogue: 0,0:03:18.91,0:03:20.26,Default,,0000,0000,0000,,Банг (есік дыбысы)
Dialogue: 0,0:03:20.26,0:03:22.45,Default,,0000,0000,0000,,Мылтық! А~ уже!!
Dialogue: 0,0:03:22.45,0:03:26.65,Default,,0000,0000,0000,,Анам менен бас тартты!
Dialogue: 0,0:03:26.65,0:03:28.85,Default,,0000,0000,0000,,NG...сен әлі сол қызбен біргесің →
Dialogue: 0,0:03:28.85,0:03:31.87,Default,,0000,0000,0000,,Сіз маған қарамайсыз. Бұл дұрыс! Мен →
Dialogue: 0,0:03:31.87,0:03:35.87,Default,,0000,0000,0000,,Мен сол қызға жүгінуге тырыстым! Әй, Норио!
Dialogue: 0,0:03:36.92,0:03:39.79,Default,,0000,0000,0000,,～→
Dialogue: 0,0:03:39.79,0:03:44.17,Default,,0000,0000,0000,,Мичиру-чан, менің білім беру саясатым →
Dialogue: 0,0:03:44.17,0:03:47.54,Default,,0000,0000,0000,,Өмірде не болса да→
Dialogue: 0,0:03:47.54,0:03:50.54,Default,,0000,0000,0000,,Зардап шегуден аулақ бола алмайтын кездер болады.
Dialogue: 0,0:03:52.75,0:03:54.11,Default,,0000,0000,0000,,Кит?
Dialogue: 0,0:03:54.11,0:03:57.13,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:57.13,0:03:59.16,Default,,0000,0000,0000,,Эй, ол туралы ше? Заза…
Dialogue: 0,0:03:59.16,0:04:02.18,Default,,0000,0000,0000,,Цк, радиотолқын тұрақты емес пе?
Dialogue: 0,0:04:02.18,0:04:07.40,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:07.40,0:04:10.76,Default,,0000,0000,0000,,Ха! (Мао/Музыка) Не болды?
Dialogue: 0,0:04:10.76,0:04:13.29,Default,,0000,0000,0000,,Жоқ, бұл менің қиялым сияқты.
Dialogue: 0,0:04:13.29,0:04:16.82,Default,,0000,0000,0000,,Әй, мен басқа жаққа бет алып бара жатырмын.
Dialogue: 0,0:04:16.82,0:04:18.18,Default,,0000,0000,0000,,…（）
Dialogue: 0,0:04:18.18,0:04:20.53,Default,,0000,0000,0000,,Иә? Мұнда.
Dialogue: 0,0:04:20.53,0:04:30.47,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:30.47,0:04:41.07,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:41.07,0:04:43.26,Default,,0000,0000,0000,,Дыбыстық сигнал (жұмыс дыбысы) сигналы
Dialogue: 0,0:04:43.26,0:04:57.23,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:57.23,0:05:00.27,Default,,0000,0000,0000,,Сіз ұсталды. Сықырлау (жүк көлігінің тежегішінің дыбысы)
Dialogue: 0,0:05:00.27,0:05:07.66,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:05:07.66,0:05:10.53,Default,,0000,0000,0000,,Ол шықты, BK201. →
Dialogue: 0,0:05:10.53,0:05:14.90,Default,,0000,0000,0000,,I thought Misaki-chan wouldn't do anything troublesome either→
Dialogue: 0,0:05:14.90,0:05:17.10,Default,,0000,0000,0000,,Осылайша сіз дұрыс ұстайсыз →
Dialogue: 0,0:05:17.10,0:05:20.30,Default,,0000,0000,0000,,Күткендей, бұл шірік байланыс, солай емес пе?
Dialogue: 0,0:05:20.30,0:05:30.23,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:05:30.23,0:05:34.43,Default,,0000,0000,0000,,Мен мұны біраз уақытқа дейін жасай аламын →
Dialogue: 0,0:05:34.43,0:05:38.98,Default,,0000,0000,0000,,BK201. Қарғыс атсын!
Dialogue: 0,0:05:38.98,0:05:41.84,Default,,0000,0000,0000,,Дока! Бұл ауырмайды!
Dialogue: 0,0:05:41.84,0:05:44.84,Default,,0000,0000,0000,,Мылтық! Уф! Арх!
Dialogue: 0,0:05:46.72,0:05:49.92,Default,,0000,0000,0000,,Қарғыс атсын... (Мао/Музыка) Эй! ше?
Dialogue: 0,0:05:49.92,0:05:53.12,Default,,0000,0000,0000,,Бұл біртүрлі. Неліктен сіз жай ғана ток соғуды қолданбайсыз? →
Dialogue: 0,0:05:53.12,0:05:56.16,Default,,0000,0000,0000,,Неге сонша қорқақсың?
Dialogue: 0,0:05:56.16,0:05:59.69,Default,,0000,0000,0000,,Эй, бұл не? Эй!
Dialogue: 0,0:05:59.69,0:06:02.38,Default,,0000,0000,0000,,Сіз мені естисіз бе? BK201 ше?
Dialogue: 0,0:06:02.38,0:06:05.58,Default,,0000,0000,0000,,Эй, Мисаки-чан, маған кедергі жасама.
Dialogue: 0,0:06:05.58,0:06:07.43,Default,,0000,0000,0000,,Дәл қазір... Бум!
Dialogue: 0,0:06:07.43,0:06:11.30,Default,,0000,0000,0000,,Біз көңілді! мылтық!
Dialogue: 0,0:06:11.30,0:06:14.83,Default,,0000,0000,0000,,Арх! Оны тірідей түсіріңіз!
Dialogue: 0,0:06:14.83,0:06:16.83,Default,,0000,0000,0000,,There's something I want to ask him... Zaza…
Dialogue: 0,0:06:17.37,0:06:19.37,Default,,0000,0000,0000,,Жүктеу платформасын ашыңыз.
Dialogue: 0,0:06:21.40,0:06:23.40,Default,,0000,0000,0000,,Мен оны Хейдің жігіті деп ойламадым...
Dialogue: 0,0:06:25.78,0:06:28.81,Default,,0000,0000,0000,,Шілде Қандай көлік керек-жарақтары?
Dialogue: 0,0:06:28.81,0:06:30.33,Default,,0000,0000,0000,,Алдыңғы жақтан үшінші машина. →
Dialogue: 0,0:06:30.33,0:06:33.19,Default,,0000,0000,0000,,Үлкен қорап. →
Dialogue: 0,0:06:33.19,0:06:35.55,Default,,0000,0000,0000,,Қораптың ішінде...
Dialogue: 0,0:06:35.55,0:06:38.58,Default,,0000,0000,0000,,Бум! (Шизүмэ) Жай ғана қашып кетпе.
Dialogue: 0,0:06:38.58,0:06:42.45,Default,,0000,0000,0000,,When I'm eating time in a place like this, my precious Honey-chan...
Dialogue: 0,0:06:42.45,0:06:44.63,Default,,0000,0000,0000,,Мен сені алып кетемін!
Dialogue: 0,0:06:44.63,0:06:47.00,Default,,0000,0000,0000,,Мен оған өзін қалай қорғау керектігін үйреттім.
Dialogue: 0,0:06:47.00,0:06:49.35,Default,,0000,0000,0000,,♬~
Dialogue: 0,0:06:49.35,0:06:51.21,Default,,0000,0000,0000,,Иә? Сіз кім туралы айтып тұрсыз? →
Dialogue: 0,0:06:51.21,0:06:54.73,Default,,0000,0000,0000,,Маған екі жақты әсер қалдырмайды. →
Dialogue: 0,0:06:54.73,0:06:56.59,Default,,0000,0000,0000,,Менің айтып отырғаным Изанами. →
Dialogue: 0,0:06:56.59,0:06:58.94,Default,,0000,0000,0000,,Бұл қуыршақ туралы.
Dialogue: 0,0:06:58.94,0:07:01.31,Default,,0000,0000,0000,,Doll? Мүмкін емес!
Dialogue: 0,0:07:01.31,0:07:05.51,Default,,0000,0000,0000,,Қораптың ішінде... жалаңаш әйел.
Dialogue: 0,0:07:05.51,0:07:08.21,Default,,0000,0000,0000,,Адам? Мен оны естіген жоқпын. Миссиясы - керек-жарақтарды жою ...
Dialogue: 0,0:07:08.21,0:07:10.56,Default,,0000,0000,0000,,Жарайды. иә?
Dialogue: 0,0:07:10.56,0:07:13.09,Default,,0000,0000,0000,,Жарайды. Мен де тырна түсіре алдым.
Dialogue: 0,0:07:13.09,0:07:15.45,Default,,0000,0000,0000,,Тырналар мен адамдар дегеніміз не?
Dialogue: 0,0:07:15.45,0:07:19.81,Default,,0000,0000,0000,,Сіз мердігер болғандықтан атуға болады. Ах...
Dialogue: 0,0:07:19.81,0:07:22.35,Default,,0000,0000,0000,,…（）
Dialogue: 0,0:07:22.35,0:07:25.04,Default,,0000,0000,0000,,Не болды!! (Радио) Не ​​болды?
Dialogue: 0,0:07:25.04,0:07:27.40,Default,,0000,0000,0000,,Мен қызықты нәрсе таптым.
Dialogue: 0,0:07:27.40,0:07:29.25,Default,,0000,0000,0000,,Izanagi? (Хазуки) Мүмкін.
Dialogue: 0,0:07:29.25,0:07:32.11,Default,,0000,0000,0000,,Мені де өлтірме. →
Dialogue: 0,0:07:32.11,0:07:34.64,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:07:34.64,0:07:37.33,Default,,0000,0000,0000,,Жоқ….
Dialogue: 0,0:07:37.33,0:07:40.53,Default,,0000,0000,0000,,Қаш. Мен сол жаққа бара жатырмын. Ах...
Dialogue: 0,0:07:40.53,0:07:42.55,Default,,0000,0000,0000,,Сіз маған тең келерсіз. Жүгір!
Dialogue: 0,0:07:42.55,0:07:48.78,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:48.78,0:07:52.81,Default,,0000,0000,0000,,Хааааааааааааааааааааааааааа.
Dialogue: 0,0:07:52.81,0:07:56.52,Default,,0000,0000,0000,,Мердігер ретінде бұзушылықтарыңызды анықтаңыз.
Dialogue: 0,0:07:56.52,0:07:59.22,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:59.22,0:08:02.24,Default,,0000,0000,0000,,Мен атуым керек. (Мао/Музыка) Қыз, сен не істеп жатырсың...?
Dialogue: 0,0:08:02.24,0:08:05.94,Default,,0000,0000,0000,,Өйткені ол маған оны атып тастауды айтты.
Dialogue: 0,0:08:05.94,0:08:07.13,Default,,0000,0000,0000,,Әй, не болды!? шілде!
Dialogue: 0,0:08:07.13,0:08:10.50,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:08:10.50,0:08:14.20,Default,,0000,0000,0000,,I know. Мен бұрын кездескен адам.
Dialogue: 0,0:08:14.20,0:08:16.39,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:08:16.39,0:08:21.10,Default,,0000,0000,0000,,Скандинав... Күміс шашы бар қуыршақ.
Dialogue: 0,0:08:21.10,0:08:25.97,Default,,0000,0000,0000,,That’s it! Неліктен? Неге ол жігіт...
Dialogue: 0,0:08:25.97,0:08:28.84,Default,,0000,0000,0000,,Келіңіздер ме? Өйткені мені қызықтырмайды. →
Dialogue: 0,0:08:28.84,0:08:32.88,Default,,0000,0000,0000,,Одан да қызық болайық.
Dialogue: 0,0:08:32.88,0:08:34.24,Default,,0000,0000,0000,,Қарғыс атсын! Кішкене ғана →
Dialogue: 0,0:08:34.24,0:08:37.09,Default,,0000,0000,0000,,I'm so bored! Dogon!
Dialogue: 0,0:08:37.09,0:08:39.45,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:08:39.45,0:08:42.98,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:08:42.98,0:08:46.52,Default,,0000,0000,0000,,Иә? Is that the contractor? Don't look!
Dialogue: 0,0:08:46.52,0:08:50.72,Default,,0000,0000,0000,,Білмеймін деп, жанынан өтіп кетпесең, қарныңды алып кетеді!
Dialogue: 0,0:08:50.72,0:08:53.93,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:08:53.93,0:08:57.96,Default,,0000,0000,0000,,Don! Эй, мердігер, сіз жоғарыдасыз ба?
Dialogue: 0,0:08:57.96,0:09:01.17,Default,,0000,0000,0000,,Shhh! Байқамағандай кейіп танытыңыз. It will be taken away!
Dialogue: 0,0:09:01.17,0:09:05.17,Default,,0000,0000,0000,,О, күте тұрыңыз! Truck truck... →
Dialogue: 0,0:09:06.05,0:09:09.05,Default,,0000,0000,0000,,It was this guy!
Dialogue: 0,0:09:17.16,0:09:19.35,Default,,0000,0000,0000,,Yo! Апыр-ай!
Dialogue: 0,0:09:19.35,0:09:21.35,Default,,0000,0000,0000,,Олар қайда...? Yaa!
Dialogue: 0,0:09:23.72,0:09:25.72,Default,,0000,0000,0000,,Гяааааааай!
Dialogue: 0,0:09:28.28,0:09:30.46,Default,,0000,0000,0000,,July Measure.
Dialogue: 0,0:09:30.46,0:09:35.34,Default,,0000,0000,0000,,Қарғыс атқыр... не күтіп тұрсың!? Ол қазірдің өзінде осы деңгейге жетті ...
Dialogue: 0,0:09:35.34,0:09:37.53,Default,,0000,0000,0000,,Қашықтық 1500. Қандай...
Dialogue: 0,0:09:37.53,0:09:39.55,Default,,0000,0000,0000,,Желдің жылдамдығы 3 солтүстік-батыс жел→
Dialogue: 0,0:09:39.55,0:09:42.55,Default,,0000,0000,0000,,5 миль түзету сол жақта.
Dialogue: 0,0:09:47.63,0:09:49.99,Default,,0000,0000,0000,,...
Dialogue: 0,0:09:49.99,0:09:52.52,Default,,0000,0000,0000,,Атпа, Сухо! Бон!
Dialogue: 0,0:09:52.52,0:09:55.37,Default,,0000,0000,0000,,Пишун! (Савасаки) Ой...
Dialogue: 0,0:09:55.37,0:09:57.39,Default,,0000,0000,0000,,Бум! (Сарбаздар) Уа...
Dialogue: 0,0:09:57.39,0:09:59.75,Default,,0000,0000,0000,,Ішінде….
Dialogue: 0,0:09:59.75,0:10:02.95,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:02.95,0:10:07.49,Default,,0000,0000,0000,,Олардың жартысы Хазукиге қолдау көрсетіп, жауды қолға түсіру үшін қарсы жағаға бет алады.
Dialogue: 0,0:10:07.49,0:10:11.87,Default,,0000,0000,0000,,Қалған жабдықтардың қауіпсіздігін растаңыз. Тасымалдау жұмысын жалғастырыңыз!
Dialogue: 0,0:10:11.87,0:10:14.23,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:14.23,0:10:17.76,Default,,0000,0000,0000,,Шығыс бағыт бойынша шегіну. Екінші нүктеде кездесе алмасаңыз →
Dialogue: 0,0:10:17.76,0:10:19.45,Default,,0000,0000,0000,,Мао мен оны сұрадым. Ах...
Dialogue: 0,0:10:19.45,0:10:21.81,Default,,0000,0000,0000,,…
Dialogue: 0,0:10:21.81,0:10:30.23,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:30.23,0:10:42.35,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:42.35,0:10:44.70,Default,,0000,0000,0000,,Башан…
Dialogue: 0,0:10:44.70,0:10:47.40,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:47.40,0:10:49.25,Default,,0000,0000,0000,,(Тодороки) Олар тек мұнда ғана пайда болды ма, әлде бүкіл мектеп бойынша ма…?➡
Dialogue: 0,0:10:49.25,0:10:54.64,Default,,0000,0000,0000,,BK201 токтың кез келген жол арқылы еркін өтуіне мүмкіндік береді.
Dialogue: 0,0:10:54.64,0:10:57.17,Default,,0000,0000,0000,,Онымен су астында әрекет ету...
Dialogue: 0,0:10:57.17,0:11:00.19,Default,,0000,0000,0000,,Сіз сенімдісіз бе? (Савасаки) Уайымдама. →
Dialogue: 0,0:11:00.19,0:11:02.38,Default,,0000,0000,0000,,Ресейден әкелінген мәліметтерді талдау→
Dialogue: 0,0:11:02.38,0:11:04.57,Default,,0000,0000,0000,,Қате жоқ. →
Dialogue: 0,0:11:04.57,0:11:10.57,Default,,0000,0000,0000,,БК201... Ол мердігер болу мүмкіндігін әлдеқашан жоғалтқан.
Dialogue: 0,0:13:17.90,0:13:20.59,Default,,0000,0000,0000,,Сіз оны артта қалдырасыз ба?
Dialogue: 0,0:13:20.59,0:13:22.78,Default,,0000,0000,0000,,Байланысты күтіңіз және кездесіңіз. →
Dialogue: 0,0:13:22.78,0:13:25.78,Default,,0000,0000,0000,,Егер ол жоқ болса... болды.
Dialogue: 0,0:13:27.16,0:13:30.86,Default,,0000,0000,0000,,Инн бұрын кім болған?
Dialogue: 0,0:13:30.86,0:13:34.40,Default,,0000,0000,0000,,Бұл біздің досымыз болған қуыршақ.
Dialogue: 0,0:13:34.40,0:13:36.09,Default,,0000,0000,0000,,(Шинобу) Мұнда тірі қалғандар жоқ сияқты.
Dialogue: 0,0:13:36.09,0:13:40.09,Default,,0000,0000,0000,,Енді ол Хейдің серігі ғана.
Dialogue: 0,0:13:41.63,0:13:43.63,Default,,0000,0000,0000,,Оның...
Dialogue: 0,0:13:55.60,0:13:59.48,Default,,0000,0000,0000,,Ха! Баша!
Dialogue: 0,0:13:59.48,0:14:02.18,Default,,0000,0000,0000,,Уф... уау! Ах! Гах...
Dialogue: 0,0:14:02.18,0:14:05.21,Default,,0000,0000,0000,,Ертерек айтқаныңызға рахмет.
Dialogue: 0,0:14:05.21,0:14:07.23,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:14:07.23,0:14:10.23,Default,,0000,0000,0000,,Күрсін, мен оны еш жерден таба алмаймын.
Dialogue: 0,0:14:12.44,0:14:17.99,Default,,0000,0000,0000,,Дұрыс. Себебі мен ол қызды ойламаймын...
Dialogue: 0,0:14:17.99,0:14:19.99,Default,,0000,0000,0000,,～→
Dialogue: 0,0:14:20.86,0:14:24.39,Default,,0000,0000,0000,,Ах, жаман. Мен енді сендермен →
Dialogue: 0,0:14:24.39,0:14:26.75,Default,,0000,0000,0000,,Бұл жастықты босқа өткізетін уақыт емес.
Dialogue: 0,0:14:26.75,0:14:29.28,Default,,0000,0000,0000,,Бұл керемет! Ол қыз мердігермен қатты ұрысып жатыр!
Dialogue: 0,0:14:29.28,0:14:31.14,Default,,0000,0000,0000,,Не? Екінші адам – апай.
Dialogue: 0,0:14:31.14,0:14:34.00,Default,,0000,0000,0000,,Апай…. О, жоқ! →
Dialogue: 0,0:14:34.00,0:14:37.86,Default,,0000,0000,0000,,Ене соғысы басталып кетті ғой!?
Dialogue: 0,0:14:37.86,0:14:39.72,Default,,0000,0000,0000,,Сухо! Зиян→
Dialogue: 0,0:14:39.72,0:14:41.90,Default,,0000,0000,0000,,Қосуға арналмаған. →
Dialogue: 0,0:14:41.90,0:14:45.90,Default,,0000,0000,0000,,Менің балам да ашуланатын шығар. Келме.
Dialogue: 0,0:14:47.12,0:14:51.50,Default,,0000,0000,0000,,Менімен бірге жүр. бірге?
Dialogue: 0,0:14:51.50,0:14:56.38,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:14:56.38,0:14:59.38,Default,,0000,0000,0000,,Келіңіздер. Келме.
Dialogue: 0,0:15:01.10,0:15:03.45,Default,,0000,0000,0000,,Келме!
Dialogue: 0,0:15:03.45,0:15:19.44,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:15:19.44,0:15:21.64,Default,,0000,0000,0000,,Жоқ! Сөйлессең түсінесің!
Dialogue: 0,0:15:21.64,0:15:24.33,Default,,0000,0000,0000,,Әйелдер арасындағы төбелес!
Dialogue: 0,0:15:24.33,0:15:27.33,Default,,0000,0000,0000,,Бум! Ха!
Dialogue: 0,0:15:28.21,0:15:30.21,Default,,0000,0000,0000,,Забар!
Dialogue: 0,0:15:34.59,0:15:36.59,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:15:37.46,0:15:40.99,Default,,0000,0000,0000,,Аа... Ах! →
Dialogue: 0,0:15:40.99,0:15:44.53,Default,,0000,0000,0000,,Уф... Уф! Апыр-ай!
Dialogue: 0,0:15:44.53,0:15:47.56,Default,,0000,0000,0000,,Рухты бақылау. Не!?
Dialogue: 0,0:15:47.56,0:15:49.56,Default,,0000,0000,0000,,Уф... аа...
Dialogue: 0,0:15:53.46,0:15:56.65,Default,,0000,0000,0000,,Ух... у... Ха!
Dialogue: 0,0:15:56.65,0:15:59.01,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:15:59.01,0:16:02.04,Default,,0000,0000,0000,,… ～→
Dialogue: 0,0:16:02.04,0:16:06.09,Default,,0000,0000,0000,,Анашым! Анашым, анашым!
Dialogue: 0,0:16:06.09,0:16:16.18,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:16.18,0:16:20.89,Default,,0000,0000,0000,,Әлде... Анама? Анашым! →
Dialogue: 0,0:16:20.89,0:16:24.89,Default,,0000,0000,0000,,Неге... неге...?
Dialogue: 0,0:16:25.44,0:16:27.80,Default,,0000,0000,0000,,Норио….
Dialogue: 0,0:16:27.80,0:16:32.67,Default,,0000,0000,0000,,Сіз... жасадыңыз ба? Ах.
Dialogue: 0,0:16:32.67,0:16:36.72,Default,,0000,0000,0000,,Неге сен... ана? →
Dialogue: 0,0:16:36.72,0:16:39.58,Default,,0000,0000,0000,,Мердігер... Сол себепті бе?
Dialogue: 0,0:16:39.58,0:16:43.62,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:43.62,0:16:47.16,Default,,0000,0000,0000,,Мердігер тұлға болып табылады. Біреуді өлтіру дұрыс па?
Dialogue: 0,0:16:47.16,0:16:52.88,Default,,0000,0000,0000,,Ууууууууууууууууууууу
Dialogue: 0,0:16:52.88,0:16:54.88,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:17:01.80,0:17:05.34,Default,,0000,0000,0000,,Уф... у... у... →
Dialogue: 0,0:17:05.34,0:17:08.34,Default,,0000,0000,0000,,Уф... аа...
Dialogue: 0,0:17:09.71,0:17:12.41,Default,,0000,0000,0000,,Сіз мұны білдіңіз, солай ма? Сіз?
Dialogue: 0,0:17:12.41,0:17:14.43,Default,,0000,0000,0000,,Иә. Бірақ сүңгуір қайық →
Dialogue: 0,0:17:14.43,0:17:17.79,Default,,0000,0000,0000,,Мен сенен оны көтереді деп күтпедім. →
Dialogue: 0,0:17:17.79,0:17:21.33,Default,,0000,0000,0000,,That young lady is also thinking of a big trick.
Dialogue: 0,0:17:21.33,0:17:23.85,Default,,0000,0000,0000,,...
Dialogue: 0,0:17:23.85,0:17:27.89,Default,,0000,0000,0000,,If you don't know that, can you follow my instructions? →
Dialogue: 0,0:17:27.89,0:17:31.59,Default,,0000,0000,0000,,Мердігер де таң қаларлықтай ылғалды.
Dialogue: 0,0:17:31.59,0:17:34.13,Default,,0000,0000,0000,,Қолыңызды кесіңіз. саған сенуге болмайды.
Dialogue: 0,0:17:34.13,0:17:36.32,Default,,0000,0000,0000,,Бұл менің жолым. →
Dialogue: 0,0:17:36.32,0:17:39.84,Default,,0000,0000,0000,,Сен сол қуыршақты өлтіремін дедің→
Dialogue: 0,0:17:39.84,0:17:41.84,Default,,0000,0000,0000,,Көңілім қатты толқып кетті, бірақ көңілім қалды.
Dialogue: 0,0:17:42.55,0:17:44.07,Default,,0000,0000,0000,,Гачан!
Dialogue: 0,0:17:44.07,0:17:48.93,Default,,0000,0000,0000,,Мердігер - кісі өлтіруші.
Dialogue: 0,0:17:48.93,0:17:50.45,Default,,0000,0000,0000,,Тапсырыс берсем де...→
Dialogue: 0,0:17:50.45,0:17:53.15,Default,,0000,0000,0000,,Неліктен Иньді өлтірмеді?
Dialogue: 0,0:17:53.15,0:17:56.35,Default,,0000,0000,0000,,Хмм…. Ол бекітілгендіктен бе?
Dialogue: 0,0:17:56.35,0:18:00.22,Default,,0000,0000,0000,,Келіңіздер ме? Сіз одан сұрауыңыз керек.
Dialogue: 0,0:18:00.22,0:18:02.22,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:06.62,0:18:10.62,Default,,0000,0000,0000,,Әлгі сүңгуір қайық Токиоға бет алған сияқты.
Dialogue: 0,0:18:12.18,0:18:15.87,Default,,0000,0000,0000,,Бірақ неге In?
Dialogue: 0,0:18:15.87,0:18:18.90,Default,,0000,0000,0000,,Сол мердігер қайтыс болғанда мен сонда болдым.
Dialogue: 0,0:18:18.90,0:18:22.11,Default,,0000,0000,0000,,Ах... Иннің байқағыштық рухы.
Dialogue: 0,0:18:22.11,0:18:26.98,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:18:26.98,0:18:29.84,Default,,0000,0000,0000,,Барлығы... ішінде ме?
Dialogue: 0,0:18:29.84,0:18:31.53,Default,,0000,0000,0000,,Ах, келесіде Токио.
Dialogue: 0,0:18:31.53,0:18:35.08,Default,,0000,0000,0000,,Бұл жас ханымның баратын жерімен сәйкес келеді.
Dialogue: 0,0:18:35.08,0:18:37.43,Default,,0000,0000,0000,,Токио….
Dialogue: 0,0:18:37.43,0:18:42.47,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:18:42.47,0:18:46.51,Default,,0000,0000,0000,,Эй…. Мүмкін сізде күш бар ...
Dialogue: 0,0:18:46.51,0:18:52.58,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:18:52.58,0:18:55.44,Default,,0000,0000,0000,,Мердігерге қарсы қарулар….
Dialogue: 0,0:18:55.44,0:18:59.81,Default,,0000,0000,0000,,Бұл BK201 қуатын алып тастаған жоқ па?
Dialogue: 0,0:18:59.81,0:19:03.52,Default,,0000,0000,0000,,Мен сіздің соншалықты көп білетініңізге таң қалдым.
Dialogue: 0,0:19:03.52,0:19:07.89,Default,,0000,0000,0000,,Сіз кімсіз? №3 қозғалтқыш дегеніміз не?
Dialogue: 0,0:19:07.89,0:19:11.26,Default,,0000,0000,0000,,Мен бұлай айта алмаймын. Жай→
Dialogue: 0,0:19:11.26,0:19:14.30,Default,,0000,0000,0000,,Мені одақтас деп санамаған дұрыс деп ойлаймын.
Dialogue: 0,0:19:14.30,0:19:19.84,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:19:19.84,0:19:24.73,Default,,0000,0000,0000,,Егер BK201 қуыршағы Изанами осында болса...
Dialogue: 0,0:19:24.73,0:19:27.92,Default,,0000,0000,0000,,Иә. BK201 бұл→
Dialogue: 0,0:19:27.92,0:19:29.92,Default,,0000,0000,0000,,Олардың бізден кейін келетініне сенімдімін.
Dialogue: 0,0:19:34.99,0:19:37.53,Default,,0000,0000,0000,,Бұл қай жер? Бұл тек ересектерге арналған ыңғайлылық. →
Dialogue: 0,0:19:37.53,0:19:40.53,Default,,0000,0000,0000,,Әр жерде бөлек үйлер бар.
Dialogue: 0,0:19:44.76,0:19:46.76,Default,,0000,0000,0000,,шілде, қант қосыңыз.
Dialogue: 0,0:19:57.22,0:20:00.92,Default,,0000,0000,0000,,Сіз не қарап тұрсыз?
Dialogue: 0,0:20:00.92,0:20:04.96,Default,,0000,0000,0000,,Норио: Бұл мердігер ана деп аталды.
Dialogue: 0,0:20:04.96,0:20:07.16,Default,,0000,0000,0000,,О? Norio Мен туралы→
Dialogue: 0,0:20:07.16,0:20:09.51,Default,,0000,0000,0000,,Ол мені жақсы көретінін айтты.
Dialogue: 0,0:20:09.51,0:20:12.51,Default,,0000,0000,0000,,Бірақ бұл сізге енді ұнамайтынына сенімдімін.
Dialogue: 0,0:20:15.41,0:20:17.41,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:20:21.63,0:20:26.63,Default,,0000,0000,0000,,≪Біреуге ғашық болу деген нені білдіреді?≫
Dialogue: 0,0:20:28.53,0:20:31.23,Default,,0000,0000,0000,,Атпа! Атпа, Сухо!
Dialogue: 0,0:20:31.23,0:20:36.78,Default,,0000,0000,0000,,<<Ол менің атымды атады>>
Dialogue: 0,0:20:36.78,0:20:38.47,Default,,0000,0000,0000,,...
Dialogue: 0,0:20:38.47,0:20:41.47,Default,,0000,0000,0000,,Еврей
Dialogue: 0,0:20:43.85,0:20:47.39,Default,,0000,0000,0000,,Мен қайтадан арамшөп жеуге мәжбүр болғым келмейді.
Dialogue: 0,0:20:47.39,0:20:49.39,Default,,0000,0000,0000,,Материал дегеніміз не?
Dialogue: 0,0:20:51.43,0:20:54.13,Default,,0000,0000,0000,,Дәруменді көкөніссіз ала алмайсың→
Dialogue: 0,0:20:54.13,0:20:57.66,Default,,0000,0000,0000,,Мен консервілерді ұнатпаймын, өйткені оның иісі темір сияқты.
Dialogue: 0,0:20:57.66,0:21:02.87,Default,,0000,0000,0000,,Бұл консервілердің иісінен құтылады.
Dialogue: 0,0:21:02.87,0:21:04.87,Default,,0000,0000,0000,,Ой... Ой...
Dialogue: 0,0:21:05.41,0:21:09.41,Default,,0000,0000,0000,,Енді атпа. иә? Неліктен?
Dialogue: 0,0:21:11.46,0:21:13.46,Default,,0000,0000,0000,,Сізге сәйкес емес.
Dialogue: 0,0:21:15.34,0:21:20.55,Default,,0000,0000,0000,,Алкоголь бітті. Бұл дұрыс.
Dialogue: 0,0:21:20.55,0:21:28.13,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:21:28.13,0:21:30.49,Default,,0000,0000,0000,,Сіз бірдеңе сатып алғыңыз келе ме?
Dialogue: 0,0:21:30.49,0:21:33.85,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:21:33.85,0:21:36.71,Default,,0000,0000,0000,,Мен атпаймын.
Dialogue: 0,0:21:36.71,0:21:40.71,Default,,0000,0000,0000,,Оның орнына... енді ішімдік ішпеңіз.
Dialogue: 0,0:21:41.93,0:21:44.96,Default,,0000,0000,0000,,Бұл алмасу шарты ма?
Dialogue: 0,0:21:44.96,0:21:46.96,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:47.99,0:21:50.85,Default,,0000,0000,0000,,Мен көкөніс сатып алуға барамын.
Dialogue: 0,0:21:50.85,0:21:55.74,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:21:55.74,0:22:00.74,Default,,0000,0000,0000,,（）
Dialogue: 0,0:22:01.30,0:22:04.99,Default,,0000,0000,0000,,Conconnorio →
Dialogue: 0,0:22:04.99,0:22:09.88,Default,,0000,0000,0000,,Торттың қалған бөлігі әлі жұмсақ, өйткені мен оны орап алдым.
Dialogue: 0,0:22:09.88,0:22:11.88,Default,,0000,0000,0000,,...
Dialogue: 0,0:22:12.91,0:22:15.44,Default,,0000,0000,0000,,→
Dialogue: 0,0:22:15.44,0:22:18.30,Default,,0000,0000,0000,,→
Dialogue: 0,0:22:18.30,0:22:22.67,Default,,0000,0000,0000,,...
Dialogue: 0,0:22:22.67,0:22:25.67,Default,,0000,0000,0000,,…
Dialogue: 0,0:22:27.89,0:22:31.10,Default,,0000,0000,0000,,Бұл жақсы емес пе? Әркім бір сәтке бір-біріне тиісе алады →
Dialogue: 0,0:22:31.10,0:22:34.12,Default,,0000,0000,0000,,Өтіңіз... →
Dialogue: 0,0:22:34.12,0:22:38.83,Default,,0000,0000,0000,,Бір жерде бір-бірімізден өтіп кететін кездер де болуы мүмкін. →
Dialogue: 0,0:22:38.83,0:22:41.83,Default,,0000,0000,0000,,Сонымен... бұл жақсы...
Dialogue: 0,0:22:43.55,0:22:45.73,Default,,0000,0000,0000,,Гача... (есік дыбысы)
Dialogue: 0,0:22:45.73,0:22:48.60,Default,,0000,0000,0000,,О, Аманойвато.
Dialogue: 0,0:22:48.60,0:22:50.12,Default,,0000,0000,0000,,Қайтадан бір-бірімізден өту дегенді қалай түсінеміз?
Dialogue: 0,0:22:50.12,0:22:54.82,Default,,0000,0000,0000,,Мен анам үшін таң қалдым!
Dialogue: 0,0:22:54.82,0:22:57.02,Default,,0000,0000,0000,,Иә... Анам туралы естеліктерім қандай?
Dialogue: 0,0:22:57.02,0:23:00.21,Default,,0000,0000,0000,,Фотодан басқа ештеңе көрмедім.
Dialogue: 0,0:23:00.21,0:23:02.57,Default,,0000,0000,0000,,Бірақ бұдан былай →
Dialogue: 0,0:23:02.57,0:23:04.43,Default,,0000,0000,0000,,Мен оны үнемі есімде сақтайтыныма сенімдімін...
Dialogue: 0,0:23:04.43,0:23:07.29,Default,,0000,0000,0000,,Иә, иә….
Dialogue: 0,0:23:07.29,0:23:10.99,Default,,0000,0000,0000,,Мен ол қызды ұмыта алмаймын...→
Dialogue: 0,0:23:10.99,0:23:13.69,Default,,0000,0000,0000,,Менің есімде болғандықтан, сондықтан... →
Dialogue: 0,0:23:13.69,0:23:17.55,Default,,0000,0000,0000,,Ууу... Ууууууу... →
Dialogue: 0,0:23:17.55,0:23:21.93,Default,,0000,0000,0000,,Ууууууууууууууууууууууууууу.
Dialogue: 0,0:23:21.93,0:23:24.62,Default,,0000,0000,0000,,Барлығын жегеніңізге көз жеткізіңіз.
Dialogue: 0,0:23:24.62,0:23:28.49,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:28.49,0:23:32.20,Default,,0000,0000,0000,,Уф... Жақсы адам боласың.
Dialogue: 0,0:23:32.20,0:23:36.91,Default,,0000,0000,0000,,Уф! Гохо! Қараңызшы, мен кептеліп қалдым!
Dialogue: 0,0:23:36.91,0:23:40.78,Default,,0000,0000,0000,,Уф! Уф….
Dialogue: 0,0:23:40.78,0:23:59.31,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:59.31,0:24:19.85,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:19.85,0:24:39.21,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:39.21,0:24:59.41,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:59.41,0:25:09.41,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:36.94,0:25:38.94,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:25:44.02,0:25:46.88,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:25:46.88,0:25:48.88,Default,,0000,0000,0000,,Бұл ештеңе емес...
Dialogue: 0,0:25:52.77,0:25:54.77,Default,,0000,0000,0000,,Ой, болмайды.
Dialogue: 0,0:27:35.30,0:27:39.17,Default,,0000,0000,0000,,<Боран жолды жауып, қараңғылықты таза ақ түсте жасырады>
Dialogue: 0,0:27:39.17,0:27:42.53,Default,,0000,0000,0000,,<Қыдырудың арғы жағында не бар→
Dialogue: 0,0:27:42.53,0:27:45.39,Default,,0000,0000,0000,,Күдік пен жалғыздық＞
Dialogue: 0,0:27:45.39,0:27:49.27,Default,,0000,0000,0000,,＜Мейірімділікке жабысу да тұзақ＞
Dialogue: 0,0:27:49.27,0:27:52.47,Default,,0000,0000,0000,,<Қуыршақ ешқашан дыбыс шығармайды>
Dialogue: 0,0:27:52.47,0:27:55.99,Default,,0000,0000,0000,,<Тіпті тірі емес>
Dialogue: 0,0:27:55.99,0:27:59.20,Default,,0000,0000,0000,,<Жүректің естілмейтін дыбыстары>
Dialogue: 0,0:27:59.20,0:28:02.20,Default,,0000,0000,0000,,<Ал ешкім байқамайды>
Dialogue: 0,0:28:03.70,0:28:09.70,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory