Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.05,0:00:06.05,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:00:08.11,0:00:11.30,Default,,0,0,0,,Ха! Жоқ!!
Dialogue: 0,0:00:11.30,0:00:13.30,Default,,0,0,0,,Бумды басыңыз! Бон!
Dialogue: 0,0:00:16.35,0:00:18.71,Default,,0,0,0,,Шырылдау...
Dialogue: 0,0:00:18.71,0:00:22.58,Default,,0,0,0,,Гуах~!! Гуаа~!
Dialogue: 0,0:00:22.58,0:00:28.58,Default,,0,0,0,,Ахх!!
Dialogue: 0,0:00:29.49,0:00:34.49,Default,,0,0,0,,Ха! Гррр!!
Dialogue: 0,0:00:36.05,0:00:38.57,Default,,0,0,0,,…（） （）
Dialogue: 0,0:00:38.57,0:00:41.61,Default,,0,0,0,,Иә. Бұл тек BK201. →
Dialogue: 0,0:00:41.61,0:00:45.47,Default,,0,0,0,,Керемет... Доктор Шредер болжағандай.
Dialogue: 0,0:00:45.47,0:00:48.00,Default,,0,0,0,,Сен
Dialogue: 0,0:00:48.00,0:00:52.38,Default,,0,0,0,,Гуах! Ааааааа!!
Dialogue: 0,0:00:52.38,0:01:00.46,Default,,0,0,0,,Сен
Dialogue: 0,0:01:00.46,0:01:04.50,Default,,0,0,0,,Ара! B-B-B-B!
Dialogue: 0,0:01:04.50,0:01:07.19,Default,,0,0,0,,Ха... (Шинме) Қарғыс атсын!
Dialogue: 0,0:01:07.19,0:01:09.72,Default,,0,0,0,,Шырылдау! Жақсылық!
Dialogue: 0,0:01:09.72,0:01:18.64,Default,,0,0,0,,Сен
Dialogue: 0,0:01:18.64,0:01:20.99,Default,,0,0,0,,Қашқың келсе, дәл қазір.
Dialogue: 0,0:01:20.99,0:01:26.22,Default,,0,0,0,,Сен
Dialogue: 0,0:01:26.22,0:01:28.74,Default,,0,0,0,,Башан!
Dialogue: 0,0:01:28.74,0:01:33.45,Default,,0,0,0,,Сен
Dialogue: 0,0:01:33.45,0:01:35.98,Default,,0,0,0,,Мен мұны істемеймін. Бұзық әрекет ету →
Dialogue: 0,0:01:35.98,0:01:38.34,Default,,0,0,0,,Жүрегім елжірейді, ханзадасым.
Dialogue: 0,0:01:38.34,0:01:48.77,Default,,0,0,0,,Сен
Dialogue: 0,0:01:48.77,0:01:50.77,Default,,0,0,0,,Гуша! (7 тамыз) Уф!
Dialogue: 0,0:01:53.32,0:01:59.32,Default,,0,0,0,,Ууууууууууу (полиция көлігінің сиренасы)
Dialogue: 0,0:02:02.08,0:03:20.01,Default,,0,0,0,,Сен
Dialogue: 0,0:03:26.25,0:03:32.25,Default,,0,0,0,,Сен
Dialogue: 0,0:03:37.86,0:03:42.74,Default,,0,0,0,,Сен
Dialogue: 0,0:03:42.74,0:03:44.74,Default,,0,0,0,,≪In…≫
Dialogue: 0,0:03:46.45,0:03:48.14,Default,,0,0,0,,≪Эй...≫
Dialogue: 0,0:03:48.14,0:03:51.14,Default,,0,0,0,,<<Тоқта! ішінде! ≫
Dialogue: 0,0:03:54.19,0:03:56.19,Default,,0,0,0,,≪Қош бол... Эй...≫
Dialogue: 0,0:04:00.76,0:04:02.76,Default,,0,0,0,,Ішінде…. Ха...
Dialogue: 0,0:04:09.84,0:04:11.20,Default,,0,0,0,,Мен оны жүзеге асырамын…
Dialogue: 0,0:04:11.20,0:04:13.20,Default,,0,0,0,,Қарғыс атсын! Уф...
Dialogue: 0,0:04:15.57,0:04:17.09,Default,,0,0,0,,Жібер! Жіберу!
Dialogue: 0,0:04:17.09,0:04:20.45,Default,,0,0,0,,Сіз менісіз бе?
Dialogue: 0,0:04:20.45,0:04:22.45,Default,,0,0,0,,Сіз білмейсіз!
Dialogue: 0,0:04:26.85,0:04:30.72,Default,,0,0,0,,Күн ыстық! Йоко-чан от! Тым жақын, тым ыстық.
Dialogue: 0,0:04:30.72,0:04:34.76,Default,,0,0,0,,Кешіріңіз. Бірақ бұл менің моксибусты бірінші рет қолдануым.
Dialogue: 0,0:04:34.76,0:04:38.47,Default,,0,0,0,,Хахаха, бұл менің бірінші тәжірибем. Бұл үлкен мәселе...
Dialogue: 0,0:04:38.47,0:04:40.82,Default,,0,0,0,,Өтемақы үшін жалықтыру уақыты →
Dialogue: 0,0:04:40.82,0:04:43.02,Default,,0,0,0,,Уақытыңызды стильде өткізуге болады... Ыстық!!
Dialogue: 0,0:04:43.02,0:04:46.72,Default,,0,0,0,,Кешіріңіз, қолым тайып кетті. Өтірікші!
Dialogue: 0,0:04:46.72,0:04:49.91,Default,,0,0,0,,Айтайын дегенім, дыбыс шығармай бөлмеге кір!
Dialogue: 0,0:04:49.91,0:04:52.78,Default,,0,0,0,,Бұл әдет. (Шинме) Ха. →
Dialogue: 0,0:04:52.78,0:04:54.47,Default,,0,0,0,,Менеджер не дейді?
Dialogue: 0,0:04:54.47,0:04:59.84,Default,,0,0,0,,Миссияны жалғастыру. Міндетті түрде Изанагиді алыңыз.
Dialogue: 0,0:04:59.84,0:05:02.88,Default,,0,0,0,,Егер бұл мүмкін болмаса, оны міндетті түрде жойыңыз.
Dialogue: 0,0:05:02.88,0:05:05.57,Default,,0,0,0,,Әй... Неткен асыл сүйкімді→
Dialogue: 0,0:05:05.57,0:05:08.27,Default,,0,0,0,,Қатыгездік көрсету... жоқ→
Dialogue: 0,0:05:08.27,0:05:11.30,Default,,0,0,0,,Бақытсыз өмір сізге жоғары ұпай береді ме?
Dialogue: 0,0:05:11.30,0:05:14.30,Default,,0,0,0,,Хмм... иә?
Dialogue: 0,0:05:15.34,0:05:17.34,Default,,0,0,0,,Бұзық…. Қарғыс атқыр...
Dialogue: 0,0:05:19.05,0:05:22.05,Default,,0,0,0,,Әкеңді не үшін өлтірдің?
Dialogue: 0,0:05:27.46,0:05:29.31,Default,,0,0,0,,Бірдеңе айт!
Dialogue: 0,0:05:29.31,0:05:32.01,Default,,0,0,0,,Сіз мұны білесіз бе? Олар не істеп жатыр!?
Dialogue: 0,0:05:32.01,0:05:35.70,Default,,0,0,0,,Неге Шионды іздеп жүрсің!
Dialogue: 0,0:05:35.70,0:05:38.23,Default,,0,0,0,,Неліктен әкемді өлтіру керек болды?
Dialogue: 0,0:05:38.23,0:05:40.25,Default,,0,0,0,,Мені жек көрсең, өлтір.
Dialogue: 0,0:05:40.25,0:05:43.61,Default,,0,0,0,,Ха... Қарғыс атсын!
Dialogue: 0,0:05:43.61,0:05:45.81,Default,,0,0,0,,Мен сені жек көремін!
Dialogue: 0,0:05:45.81,0:05:48.81,Default,,0,0,0,,Бірақ мен біреуді өлтіргенше өлгенім артық!
Dialogue: 0,0:05:50.02,0:05:52.71,Default,,0,0,0,,Ол бейбіт бала.
Dialogue: 0,0:05:52.71,0:05:56.42,Default,,0,0,0,,Ешкімді алмастыратын ешкім жоқ! Бұл бір ғана нәрсе!
Dialogue: 0,0:05:56.42,0:05:59.77,Default,,0,0,0,,Бірақ бұл...
Dialogue: 0,0:05:59.77,0:06:02.80,Default,,0,0,0,,Мен сенің ғашық немесе туыс екеніңе сенімдімін→
Dialogue: 0,0:06:02.80,0:06:05.50,Default,,0,0,0,,Мен сені ойланбастан өлтіретін шығармын!
Dialogue: 0,0:06:05.50,0:06:07.50,Default,,0,0,0,,Батин! Қарғыс атсын! Уф!
Dialogue: 0,0:06:09.04,0:06:11.56,Default,,0,0,0,,Үндетпе.
Dialogue: 0,0:06:11.56,0:06:15.27,Default,,0,0,0,,Бұл не... Мынау не...?
Dialogue: 0,0:06:15.27,0:06:17.63,Default,,0,0,0,,Күні кешеге дейін ештеңе болған жоқ →
Dialogue: 0,0:06:17.63,0:06:19.82,Default,,0,0,0,,Кенеттен бәрі тәртіпсіздікке ұшырады!
Dialogue: 0,0:06:19.82,0:06:22.34,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:22.34,0:06:24.36,Default,,0,0,0,,Маған ұнамайды. Адамдар өледі →
Dialogue: 0,0:06:24.36,0:06:27.89,Default,,0,0,0,,Тіпті өлтіріңіз! Қазірдің өзінде…→
Dialogue: 0,0:06:27.89,0:06:31.89,Default,,0,0,0,,Маған ұнамайды! Уф...
Dialogue: 0,0:06:33.95,0:06:35.47,Default,,0,0,0,,Таңертең ерте шақырылу→
Dialogue: 0,0:06:35.47,0:06:37.33,Default,,0,0,0,,Полковниктің бөксесі... →
Dialogue: 0,0:06:37.33,0:06:41.86,Default,,0,0,0,,Бірақ бұл күшпен не істеуіміз керек?
Dialogue: 0,0:06:41.86,0:06:44.06,Default,,0,0,0,,Қосымша қызметкерлер сұралды ма?
Dialogue: 0,0:06:44.06,0:06:46.58,Default,,0,0,0,,күрсіну…. Жоғарыдағы жігіттер →
Dialogue: 0,0:06:46.58,0:06:49.78,Default,,0,0,0,,Бұл істің маңыздылығы түсінілмейді. →
Dialogue: 0,0:06:49.78,0:06:52.30,Default,,0,0,0,,Қолда бір ғана жаңа бөлік бар. →
Dialogue: 0,0:06:52.30,0:06:56.68,Default,,0,0,0,,Тірі қалудың жалғыз жолы - әдеттегі күштердің көп мөлшерін жұмылдыру...
Dialogue: 0,0:06:56.68,0:06:58.21,Default,,0,0,0,,Бұл полковниктен еш айырмашылығы жоқ.
Dialogue: 0,0:06:58.21,0:07:00.21,Default,,0,0,0,,Майор. (Репнеен) Иә?
Dialogue: 0,0:07:04.43,0:07:06.28,Default,,0,0,0,,Түсіру?
Dialogue: 0,0:07:06.28,0:07:09.47,Default,,0,0,0,,Сіз шогиді білесіз бе? иә?
Dialogue: 0,0:07:09.47,0:07:11.50,Default,,0,0,0,,Бұл жапон ойыны. Шахматтан айырмашылығы →
Dialogue: 0,0:07:11.50,0:07:14.19,Default,,0,0,0,,Түсірілген бөліктерді өз бөліктеріңіз ретінде алыңыз →
Dialogue: 0,0:07:14.19,0:07:16.55,Default,,0,0,0,,Тақтаға қайтаруға болады.
Dialogue: 0,0:07:16.55,0:07:22.44,Default,,0,0,0,,Сен
Dialogue: 0,0:07:22.44,0:07:24.29,Default,,0,0,0,,Ұйықтаймын деп жылап алдың ба? →
Dialogue: 0,0:07:24.29,0:07:27.83,Default,,0,0,0,,Міне, кешеге дейін мен қарапайым орта мектеп оқушысы едім→
Dialogue: 0,0:07:27.83,0:07:30.19,Default,,0,0,0,,Басқа таңдау жоқ. →
Dialogue: 0,0:07:30.19,0:07:33.72,Default,,0,0,0,,Таң қалмайсың ба? Мен таң қалдым.
Dialogue: 0,0:07:33.72,0:07:36.41,Default,,0,0,0,,Естің денеден тыс болуы туралы не айттыңыз?
Dialogue: 0,0:07:36.41,0:07:39.11,Default,,0,0,0,,Менің ойымша, бұл рас болды. Жақсы. →
Dialogue: 0,0:07:39.11,0:07:41.96,Default,,0,0,0,,Кәдімгі сақтық көшірме болса да→
Dialogue: 0,0:07:41.96,0:07:43.15,Default,,0,0,0,,Токиодағы оқиғаның соңғы бұрылысы → болып табылады
Dialogue: 0,0:07:43.15,0:07:46.85,Default,,0,0,0,,Мен бұл туралы жаңа ғана естідім...
Dialogue: 0,0:07:46.85,0:07:49.21,Default,,0,0,0,,Сіз қазір қайда ұстайсыз?
Dialogue: 0,0:07:49.21,0:07:52.74,Default,,0,0,0,,Мен де сізбен бір жердемін, эй.
Dialogue: 0,0:07:52.74,0:07:55.60,Default,,0,0,0,,ЦРУ? Жоқ.
Dialogue: 0,0:07:55.60,0:07:59.64,Default,,0,0,0,,А... Иә, анау әйел. →
Dialogue: 0,0:07:59.64,0:08:02.64,Default,,0,0,0,,Мен сізге бұйрықтардың өзгеруі туралы айту үшін келдім.
Dialogue: 0,0:08:04.03,0:08:06.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:06.38,0:08:22.04,Default,,0,0,0,,Сен
Dialogue: 0,0:08:22.04,0:08:25.57,Default,,0,0,0,,Таня!
Dialogue: 0,0:08:25.57,0:08:27.57,Default,,0,0,0,,Ника….
Dialogue: 0,0:08:29.78,0:08:31.13,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:08:31.13,0:08:35.84,Default,,0,0,0,,Менің санам денемдегі өзгерістерге ілесе алмайды. →
Dialogue: 0,0:08:35.84,0:08:39.87,Default,,0,0,0,,Екеуміз бірге болсақ, тағы да бір сұмдықтың болатынына сенімдімін...
Dialogue: 0,0:08:39.87,0:08:42.24,Default,,0,0,0,,Сен
Dialogue: 0,0:08:42.24,0:08:45.43,Default,,0,0,0,,Жақсы. Біз тағы кездестік.
Dialogue: 0,0:08:45.43,0:08:48.43,Default,,0,0,0,,Жарайды, Таня.
Dialogue: 0,0:08:52.84,0:08:55.03,Default,,0,0,0,,...
Dialogue: 0,0:08:57.23,0:09:00.23,Default,,0,0,0,,Баки! Сен не істеп жатырсың?
Dialogue: 0,0:09:04.46,0:09:07.46,Default,,0,0,0,,Ах... Кит?
Dialogue: 0,0:09:12.04,0:09:14.89,Default,,0,0,0,,«Мен күтемін»….
Dialogue: 0,0:09:14.89,0:09:16.08,Default,,0,0,0,,Бұл Шион.
Dialogue: 0,0:09:16.08,0:09:21.46,Default,,0,0,0,,Икебукуро? Икебукуро? қайда?
Dialogue: 0,0:09:21.46,0:09:24.33,Default,,0,0,0,,Токио... Тозақ қақпасының жанында.
Dialogue: 0,0:09:24.33,0:09:27.35,Default,,0,0,0,,Бұл тыйым салынған аймақтың бөлігі.
Dialogue: 0,0:09:27.35,0:09:29.21,Default,,0,0,0,,Шион сонда ма? Ха!
Dialogue: 0,0:09:29.21,0:09:32.74,Default,,0,0,0,,Ах... уф... Ха!
Dialogue: 0,0:09:32.74,0:09:35.27,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:09:35.27,0:09:38.63,Default,,0,0,0,,Заку… Ха….
Dialogue: 0,0:09:38.63,0:09:41.83,Default,,0,0,0,,Тұру. Ах...
Dialogue: 0,0:09:41.83,0:09:43.83,Default,,0,0,0,,Жапонияға барғыңыз келе ме?
Dialogue: 0,0:09:44.53,0:09:46.53,Default,,0,0,0,,Мен сені өзіммен бірге алып кетемін.
Dialogue: 0,0:11:53.31,0:11:55.00,Default,,0,0,0,,Жоқ... кесілген.
Dialogue: 0,0:11:55.00,0:11:57.02,Default,,0,0,0,,Бірақ қоңырау соғылды ма?
Dialogue: 0,0:11:57.02,0:11:59.71,Default,,0,0,0,,Иә. →
Dialogue: 0,0:11:59.71,0:12:02.91,Default,,0,0,0,,Сухо, сен жақсысың деп үміттенемін...
Dialogue: 0,0:12:02.91,0:12:04.91,Default,,0,0,0,,Орналасу туралы не деуге болады?
Dialogue: 0,0:12:06.44,0:12:08.44,Default,,0,0,0,,Таня Бұл жеткілікті.
Dialogue: 0,0:12:09.47,0:12:13.35,Default,,0,0,0,,Сен
Dialogue: 0,0:12:13.35,0:12:15.35,Default,,0,0,0,,Шуыл
Dialogue: 0,0:12:17.89,0:12:19.58,Default,,0,0,0,,<Алғашқы қадамды жасау>
Dialogue: 0,0:12:19.58,0:12:21.93,Default,,0,0,0,,Ол меннен қанша есе мықты. (Очако) Ах…
Dialogue: 0,0:12:21.93,0:12:26.14,Default,,0,0,0,,Сен
Dialogue: 0,0:12:26.14,0:12:29.17,Default,,0,0,0,,Бұл ұялы телефон. Оның жүрген жері анықталды.
Dialogue: 0,0:12:29.17,0:12:31.36,Default,,0,0,0,,Аа...
Dialogue: 0,0:12:31.36,0:12:38.27,Default,,0,0,0,,Сен
Dialogue: 0,0:12:38.27,0:12:40.45,Default,,0,0,0,,Не? Сол жарық.
Dialogue: 0,0:12:40.45,0:12:44.82,Default,,0,0,0,,An observing spirit... Don't look, it's pretentious.
Dialogue: 0,0:12:44.82,0:12:56.11,Default,,0,0,0,,Сен
Dialogue: 0,0:12:56.11,0:12:59.97,Default,,0,0,0,,Мына жақтағы пойыз. Байқамай кіріңіз.
Dialogue: 0,0:12:59.97,0:13:01.97,Default,,0,0,0,,Пойыз 5 минуттан кейін кетеді. иә?
Dialogue: 0,0:13:04.69,0:13:06.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:06.21,0:13:08.56,Default,,0,0,0,,Докка! Бакки! (2 адам) Уау!
Dialogue: 0,0:13:08.56,0:13:10.42,Default,,0,0,0,,Ха! Қарғыс атқыр...
Dialogue: 0,0:13:10.42,0:13:12.77,Default,,0,0,0,,Ах! Қарғыс атсын!
Dialogue: 0,0:13:12.77,0:13:14.46,Default,,0,0,0,,Дада, Дада, Дада!
Dialogue: 0,0:13:14.46,0:13:16.82,Default,,0,0,0,,Иә, мен қазір сонда барамын.
Dialogue: 0,0:13:16.82,0:13:21.36,Default,,0,0,0,,Сен
Dialogue: 0,0:13:21.36,0:13:23.21,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:23.21,0:13:25.24,Default,,0,0,0,,Таня? Неге….
Dialogue: 0,0:13:25.24,0:13:28.26,Default,,0,0,0,,Мәміле жасады. Мен сені ұстасам →
Dialogue: 0,0:13:28.26,0:13:31.46,Default,,0,0,0,,Adequate remuneration and future status guaranteed.
Dialogue: 0,0:13:31.46,0:13:35.84,Default,,0,0,0,,Ника ше? не болды? Неге Таня...
Dialogue: 0,0:13:35.84,0:13:40.84,Default,,0,0,0,,Жауап, Сухо. Шион Павличенко қайда?
Dialogue: 0,0:13:41.06,0:13:43.75,Default,,0,0,0,,Жауабы.
Dialogue: 0,0:13:43.75,0:13:47.75,Default,,0,0,0,,Тоқта, Таня! неге?
Dialogue: 0,0:13:48.13,0:13:50.65,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:50.65,0:13:53.68,Default,,0,0,0,,Аа... Тоқта!
Dialogue: 0,0:13:53.68,0:13:55.68,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:57.89,0:13:59.08,Default,,0,0,0,,Да-да-да-да-да! Да-да-да-да!
Dialogue: 0,0:13:59.08,0:14:03.45,Default,,0,0,0,,Сен
Dialogue: 0,0:14:03.45,0:14:07.65,Default,,0,0,0,,Мен кешігіп қалдым. (Савасаки) Біз не істеуіміз керек?
Dialogue: 0,0:14:07.65,0:14:10.02,Default,,0,0,0,,Оған көмектесу мүмкін емес. Ал, бір кадр →
Dialogue: 0,0:14:10.02,0:14:13.02,Default,,0,0,0,,Шақылдап тістейсің бе?
Dialogue: 0,0:14:15.40,0:14:17.40,Default,,0,0,0,,Катя
Dialogue: 0,0:14:21.63,0:14:25.50,Default,,0,0,0,,Мао Мен бұл баланы сұраймын. Мен соны сұраймын...
Dialogue: 0,0:14:25.50,0:14:27.52,Default,,0,0,0,,Не? Эй, эй! →
Dialogue: 0,0:14:27.52,0:14:29.52,Default,,0,0,0,,Сәлем! Мен енді білмеймін! Ха!
Dialogue: 0,0:14:31.89,0:14:33.75,Default,,0,0,0,,Уау! Петя сен...
Dialogue: 0,0:14:33.75,0:14:37.62,Default,,0,0,0,,Surprises and explanations are left behind. Кеттік, қыз! →
Dialogue: 0,0:14:37.62,0:14:39.97,Default,,0,0,0,,Дайвинг.
Dialogue: 0,0:14:39.97,0:14:51.76,Default,,0,0,0,,Сен
Dialogue: 0,0:14:51.76,0:14:53.12,Default,,0,0,0,,Кел! Сіз жоғары көтеріле аласыз.
Dialogue: 0,0:14:53.12,0:14:59.50,Default,,0,0,0,,Сен
Dialogue: 0,0:14:59.50,0:15:01.69,Default,,0,0,0,,Сәлем! (Солдат) Эй!
Dialogue: 0,0:15:01.69,0:15:03.55,Default,,0,0,0,,Бұл жақсы. Хей жемге айналады→
Dialogue: 0,0:15:03.55,0:15:06.91,Default,,0,0,0,,...
Dialogue: 0,0:15:06.91,0:15:09.94,Default,,0,0,0,,If you can take advantage of the chaos and escape...
Dialogue: 0,0:15:09.94,0:15:11.29,Default,,0,0,0,,Да-да-да-да-да-да-да!
Dialogue: 0,0:15:11.29,0:15:14.66,Default,,0,0,0,,Сен
Dialogue: 0,0:15:14.66,0:15:17.69,Default,,0,0,0,,（）
Dialogue: 0,0:15:17.69,0:15:21.72,Default,,0,0,0,,Сен
Dialogue: 0,0:15:21.72,0:15:23.25,Default,,0,0,0,,Кету Жарайсың!
Dialogue: 0,0:15:23.25,0:15:26.78,Default,,0,0,0,,Жарақат алудан сақ болыңыз!
Dialogue: 0,0:15:26.78,0:15:28.13,Default,,0,0,0,,Майор! (Репнеен) Ат!
Dialogue: 0,0:15:28.13,0:15:32.00,Default,,0,0,0,,Дада да да! Да-да-да-да! Канг канг канг!
Dialogue: 0,0:15:32.00,0:15:35.00,Default,,0,0,0,,Баки! (Сарбаздар) Уау! Ах~!
Dialogue: 0,0:15:37.55,0:15:39.91,Default,,0,0,0,,Да-да-да-да! Да-да-да-да! Кан Кан!
Dialogue: 0,0:15:39.91,0:15:41.26,Default,,0,0,0,,Заш! Заш! (Сарбаздар) Уау! Ах!
Dialogue: 0,0:15:41.26,0:15:45.64,Default,,0,0,0,,Сен
Dialogue: 0,0:15:45.64,0:15:48.66,Default,,0,0,0,,Қарғыс атсын! Гигги!
Dialogue: 0,0:15:48.66,0:15:50.52,Default,,0,0,0,,Сен
Dialogue: 0,0:15:50.52,0:15:53.38,Default,,0,0,0,,Boom! Boom!!
Dialogue: 0,0:15:53.38,0:15:55.57,Default,,0,0,0,,О! Апыр-ай!
Dialogue: 0,0:15:55.57,0:16:00.78,Default,,0,0,0,,Сен
Dialogue: 0,0:16:00.78,0:16:02.96,Default,,0,0,0,,Кешіріңіз. Бұл шығын ба?
Dialogue: 0,0:16:02.96,0:16:08.70,Default,,0,0,0,,Сен
Dialogue: 0,0:16:08.70,0:16:11.70,Default,,0,0,0,,Boom!!
Dialogue: 0,0:16:17.62,0:16:19.62,Default,,0,0,0,,Осы сияқты...
Dialogue: 0,0:16:21.49,0:16:23.49,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:16:25.20,0:16:28.20,Default,,0,0,0,,Why is this...?
Dialogue: 0,0:16:29.74,0:16:32.44,Default,,0,0,0,,Boom! Уф! Uuu... ugh...
Dialogue: 0,0:16:32.44,0:16:34.44,Default,,0,0,0,,Click Click…
Dialogue: 0,0:16:36.65,0:16:39.65,Default,,0,0,0,,～
Dialogue: 0,0:16:41.19,0:16:45.57,Default,,0,0,0,,Тоқта, Таня! We are friends!?
Dialogue: 0,0:16:45.57,0:16:49.77,Default,,0,0,0,,Иә. Сен екеуміз дос болдық.
Dialogue: 0,0:16:49.77,0:16:53.48,Default,,0,0,0,,Алайда мен Шион есімді інім бар дегенді естімеппін.
Dialogue: 0,0:16:53.48,0:16:56.18,Default,,0,0,0,,Ол бар ма? Ах...
Dialogue: 0,0:16:56.18,0:16:59.53,Default,,0,0,0,,Бұл шынымен сіз туралы емес пе?
Dialogue: 0,0:16:59.53,0:17:01.53,Default,,0,0,0,,Міне... Ах.
Dialogue: 0,0:17:04.09,0:17:07.45,Default,,0,0,0,,Мен сенің өміріңді сақтап қала алар едім.
Dialogue: 0,0:17:07.45,0:17:11.16,Default,,0,0,0,,Ника! No way...Tanya!
Dialogue: 0,0:17:11.16,0:17:15.37,Default,,0,0,0,,Үйге бірге барайық...Таня.
Dialogue: 0,0:17:15.37,0:17:17.89,Default,,0,0,0,,Цк….
Dialogue: 0,0:17:17.89,0:17:19.41,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:17:19.41,0:17:23.27,Default,,0,0,0,,Тоқташы, өтінемін! Өтінемін, тоқтатыңыз!
Dialogue: 0,0:17:23.27,0:17:26.64,Default,,0,0,0,,Таня!! Бум!
Dialogue: 0,0:17:26.64,0:17:29.64,Default,,0,0,0,,Уау!!
Dialogue: 0,0:17:30.02,0:17:34.05,Default,,0,0,0,,Ха! Уф...
Dialogue: 0,0:17:34.05,0:17:36.05,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,0:17:40.28,0:17:43.47,Default,,0,0,0,,Осы сияқты...
Dialogue: 0,0:17:43.47,0:17:47.85,Default,,0,0,0,,Уау!!
Dialogue: 0,0:17:47.85,0:17:55.43,Default,,0,0,0,,Сен
Dialogue: 0,0:17:55.43,0:17:58.29,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:17:58.29,0:18:02.83,Default,,0,0,0,,Мен ояндым. It's starting.
Dialogue: 0,0:18:02.83,0:18:05.83,Default,,0,0,0,,Соңы... Басталып жатыр.
Dialogue: 0,0:18:08.89,0:18:10.58,Default,,0,0,0,,Хехе.
Dialogue: 0,0:18:10.58,0:18:12.58,Default,,0,0,0,,Басталып жатыр.
Dialogue: 0,0:18:15.80,0:18:17.80,Default,,0,0,0,,Пишаан! (найзағай)
Dialogue: 0,0:18:19.50,0:18:21.50,Default,,0,0,0,,≪ Мердігер...≫
Dialogue: 0,0:18:24.55,0:18:26.41,Default,,0,0,0,,<<Әркім өлуі керек>>
Dialogue: 0,0:18:26.41,0:18:51.49,Default,,0,0,0,,Сен
Dialogue: 0,0:18:51.49,0:18:53.18,Default,,0,0,0,,Бум! Уф!
Dialogue: 0,0:18:53.18,0:19:00.41,Default,,0,0,0,,Сен
Dialogue: 0,0:19:00.41,0:19:02.26,Default,,0,0,0,,Бум! Канг!
Dialogue: 0,0:19:02.26,0:19:04.26,Default,,0,0,0,,Бум!
Dialogue: 0,0:19:05.30,0:19:08.50,Default,,0,0,0,,120 градус солға. →
Dialogue: 0,0:19:08.50,0:19:12.03,Default,,0,0,0,,3 метр жоғары. 10 сантиметр қалды. →
Dialogue: 0,0:19:12.03,0:19:14.38,Default,,0,0,0,,Оңға 2…. Бон!
Dialogue: 0,0:19:14.38,0:19:16.90,Default,,0,0,0,,Пюн! Қарғыс атсын!
Dialogue: 0,0:19:16.90,0:19:18.90,Default,,0,0,0,,20 градус оңға. 3 метр төмен.
Dialogue: 0,0:19:19.11,0:19:22.30,Default,,0,0,0,,Жоқ! Уф!
Dialogue: 0,0:19:22.30,0:19:25.49,Default,,0,0,0,,Бум! Бум!
Dialogue: 0,0:19:25.49,0:19:28.03,Default,,0,0,0,,110 градус оңға. 50 см төмен.
Dialogue: 0,0:19:28.03,0:20:01.73,Default,,0,0,0,,Сен
Dialogue: 0,0:20:04.06,0:20:08.09,Default,,0,0,0,,Сіздің атыңыз кім? шілде.
Dialogue: 0,0:20:08.09,0:20:10.09,Default,,0,0,0,,Эй, эй, бұл...
Dialogue: 0,0:20:11.46,0:20:13.46,Default,,0,0,0,,Келіңіз.
Dialogue: 0,0:20:23.74,0:20:28.45,Default,,0,0,0,,«Үш пайда болса, үш ауру» демекші, ханым.
Dialogue: 0,0:20:28.45,0:20:32.33,Default,,0,0,0,,О, Смит мырза, бүгінгі оқиға қандай?
Dialogue: 0,0:20:32.33,0:20:35.53,Default,,0,0,0,,Қара қырғын... өз орнында→
Dialogue: 0,0:20:35.53,0:20:37.72,Default,,0,0,0,,Мен сіздің ойыңыз бар ма деп ойладым.
Dialogue: 0,0:20:37.72,0:20:41.93,Default,,0,0,0,,Жақсы! Мен дүниежүзілік ЦРУ-ны алдайды деп ешқашан күтпедім...→
Dialogue: 0,0:20:41.93,0:20:44.62,Default,,0,0,0,,Бұл ондай әңгіме емес, солай емес пе?
Dialogue: 0,0:20:44.62,0:20:46.62,Default,,0,0,0,,…
Dialogue: 0,0:20:47.48,0:20:50.34,Default,,0,0,0,,Іскерлік әңгімелер қабылданады.
Dialogue: 0,0:20:50.34,0:20:53.21,Default,,0,0,0,,Біздің өнімдер ақпарат болып табылады.
Dialogue: 0,0:20:53.21,0:20:55.40,Default,,0,0,0,,Маған тиісті өтемақы бере алсаңыз →
Dialogue: 0,0:20:55.40,0:20:59.40,Default,,0,0,0,,Біздің ұранымыз – кез келген уақытта кез келген адамға сату.
Dialogue: 0,0:21:00.62,0:21:03.14,Default,,0,0,0,,«Солдат асықты тыңдайды». →
Dialogue: 0,0:21:03.14,0:21:06.17,Default,,0,0,0,,Сіздің ертерек жауап беруіңізді күтемін →
Dialogue: 0,0:21:06.17,0:21:08.17,Default,,0,0,0,,Орей ханым.
Dialogue: 0,0:21:09.54,0:21:12.06,Default,,0,0,0,,Жұлдыздар шынымен де жоғалып кетті.
Dialogue: 0,0:21:12.06,0:21:15.76,Default,,0,0,0,,Жұлдыз түсіп кетсе, өлді деген сөз. →
Dialogue: 0,0:21:15.76,0:21:17.45,Default,,0,0,0,,Мен оның жоғалып кеткенін естіген емеспін. →
Dialogue: 0,0:21:17.45,0:21:19.81,Default,,0,0,0,,Мен қателестім бе? бірақ….
Dialogue: 0,0:21:19.81,0:21:21.81,Default,,0,0,0,,Кешіріңіз, мен де бос емеспін. →
Dialogue: 0,0:21:23.34,0:21:26.20,Default,,0,0,0,,Тек бас тартыңыз және жаңа адамды іздеңіз.
Dialogue: 0,0:21:26.20,0:21:30.20,Default,,0,0,0,,Канами~. (Канами) Менің ойымша, бұл жақсы мүмкіндік.
Dialogue: 0,0:21:38.16,0:21:40.16,Default,,0,0,0,,Дыбыстық сигнал (жұмыс дыбысы)
Dialogue: 0,0:21:42.03,0:21:44.89,Default,,0,0,0,,Бұл Кирихара. (Сайто) Бастық! А... жоқ →
Dialogue: 0,0:21:44.89,0:21:47.91,Default,,0,0,0,,Кирихара-сан, біраз уақыт болды.
Dialogue: 0,0:21:47.91,0:21:50.28,Default,,0,0,0,,Сайто: Қазір жақсы ма? Сізден сұрайын дегенім бар.
Dialogue: 0,0:21:50.28,0:21:53.65,Default,,0,0,0,,Хаха. Жоқ, бәрі жақсы! →
Dialogue: 0,0:21:53.65,0:21:56.67,Default,,0,0,0,,Бұл не? Іс жүзінде...→
Dialogue: 0,0:21:56.67,0:21:59.37,Default,,0,0,0,,Бұл BK201 туралы... (Сайто) Бастық... →
Dialogue: 0,0:21:59.37,0:22:03.74,Default,,0,0,0,,Кешіріңіз... бұл... мердігерге қатысты ақпарат →
Dialogue: 0,0:22:03.74,0:22:07.11,Default,,0,0,0,,Мен сені шығара алмаймын... Дұрыс.
Dialogue: 0,0:22:07.11,0:22:11.99,Default,,0,0,0,,Егер мен аралға жер аударылған адаммен әлі де байланысым бар екенін білсем...
Dialogue: 0,0:22:11.99,0:22:14.85,Default,,0,0,0,,Міне! Менің ішкі бастығым →
Dialogue: 0,0:22:14.85,0:22:16.21,Default,,0,0,0,,Бұл жай ғана бастық Кирихара.
Dialogue: 0,0:22:16.21,0:22:20.75,Default,,0,0,0,,Жаман болды. Мен сізге келесі жолы қайта қоңырау шаламын.
Dialogue: 0,0:22:20.75,0:22:22.60,Default,,0,0,0,,Бастық…. иә?
Dialogue: 0,0:22:22.60,0:22:26.97,Default,,0,0,0,,Сонымен... сіз 3-ші қозғалтқыш туралы естідіңіз бе?
Dialogue: 0,0:22:26.97,0:22:29.67,Default,,0,0,0,,№3 қозғалтқыш? жоқ….
Dialogue: 0,0:22:29.67,0:22:32.70,Default,,0,0,0,,Сақ болыңыз. Тіпті олар көрінсе де→
Dialogue: 0,0:22:32.70,0:22:35.73,Default,,0,0,0,,...
Dialogue: 0,0:22:35.73,0:22:38.26,Default,,0,0,0,,（）
Dialogue: 0,0:22:38.26,0:22:41.95,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:41.95,0:22:43.64,Default,,0,0,0,,Танысқаныма қуаныштымын. →
Dialogue: 0,0:22:43.64,0:22:45.00,Default,,0,0,0,,Менің атым Кобаяши.
Dialogue: 0,0:22:45.00,0:22:49.70,Default,,0,0,0,,«Ішкі істер және коммуникациялар министрлігі»? Саған не қажет?
Dialogue: 0,0:22:49.70,0:22:52.90,Default,,0,0,0,,Сен
Dialogue: 0,0:22:52.90,0:22:55.43,Default,,0,0,0,,Екі жыл бұрын... Қоғамдық қауіпсіздік министрлігінің ішкі ақпараты →
Dialogue: 0,0:22:55.43,0:22:58.79,Default,,0,0,0,,Интернетте жасырын түрде жарияланды→
Dialogue: 0,0:22:58.79,0:23:02.83,Default,,0,0,0,,Мердігердің бар екендігі әлемге белгілі болды. →
Dialogue: 0,0:23:02.83,0:23:04.19,Default,,0,0,0,,Бірақ сонымен бірге ол «Ұйым»→ деп аталады
Dialogue: 0,0:23:04.19,0:23:08.39,Default,,0,0,0,,Оның бар екендігінің ізі табылмады.
Dialogue: 0,0:23:08.39,0:23:12.39,Default,,0,0,0,,Сіз қозғалтқыш 3 туралы естідіңіз бе?
Dialogue: 0,0:23:14.95,0:23:17.81,Default,,0,0,0,,Ішкі істер және коммуникациялар министрлігі бүркеніштен басқа ештеңе емес.
Dialogue: 0,0:23:17.81,0:23:21.19,Default,,0,0,0,,Біздің мақсатымыз – ұйымның қалдықтарын жою.
Dialogue: 0,0:23:21.19,0:23:25.22,Default,,0,0,0,,Бұған қол жеткізу үшін заңнан тыс шаралар қабылдануы мүмкін →
Dialogue: 0,0:23:25.22,0:23:28.26,Default,,0,0,0,,Рұқсат етілген. Мұндай мекеме→
Dialogue: 0,0:23:28.26,0:23:31.62,Default,,0,0,0,,Менен не керек?
Dialogue: 0,0:23:31.62,0:23:34.81,Default,,0,0,0,,BK201 өлмеген.
Dialogue: 0,0:23:34.81,0:23:38.35,Default,,0,0,0,,Аа... (Кобаяши) Ол кісі қазір қараңғыда.
Dialogue: 0,0:23:38.35,0:23:42.40,Default,,0,0,0,,Қазір қайда болсаң, оған жете алмайсың.
Dialogue: 0,0:23:42.40,0:23:44.75,Default,,0,0,0,,Келіңіз.
Dialogue: 0,0:23:44.75,0:23:48.46,Default,,0,0,0,,Сен
Dialogue: 0,0:23:48.46,0:23:51.16,Default,,0,0,0,,Бастық... Бастық! Дыбыстық сигнал
Dialogue: 0,0:23:51.16,0:25:21.12,Default,,0,0,0,,Сен
Dialogue: 0,0:25:28.79,0:25:31.49,Default,,0,0,0,,Фу. Сіз көп ішіп жатқан жоқсыз ба?
Dialogue: 0,0:25:31.49,0:25:34.51,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:25:34.51,0:25:37.72,Default,,0,0,0,,Эй... қонақ үйдегі жігітке не болды?
Dialogue: 0,0:25:37.72,0:25:40.72,Default,,0,0,0,,Мен бармын...→
Dialogue: 0,0:25:41.59,0:25:44.59,Default,,0,0,0,,Әлгі әйелді өлтіріңіз. Ха...
Dialogue: 0,0:25:46.30,0:25:49.00,Default,,0,0,0,,≪Мердігер мүмкіндігін пайдаланғаннан кейін→
Dialogue: 0,0:25:49.00,0:25:51.00,Default,,0,0,0,,Қарау төленуі керек≫
Dialogue: 0,0:25:53.70,0:25:56.70,Default,,0,0,0,,≪Мен мердігер болдым≫
Dialogue: 0,0:27:30.34,0:27:32.03,Default,,0,0,0,,＜Мен қайда барарымды білмеймін →
Dialogue: 0,0:27:32.03,0:27:34.22,Default,,0,0,0,,Қалқымалы солтүстік қала＞
Dialogue: 0,0:27:34.22,0:27:36.24,Default,,0,0,0,,<Көгілдір көл беті ештеңені көрсетпейді→
Dialogue: 0,0:27:36.24,0:27:38.59,Default,,0,0,0,,Жаңғырған мылтық дыбыстары→
Dialogue: 0,0:27:38.59,0:27:42.12,Default,,0,0,0,,Жоғалғанға арналған реквием>
Dialogue: 0,0:27:42.12,0:27:46.67,Default,,0,0,0,,<Жалған күлімсіреу - демалыстың бағасы>
Dialogue: 0,0:27:46.67,0:27:49.37,Default,,0,0,0,,<Кездесу де қоштасуға әкеледі>
Dialogue: 0,0:27:49.37,0:27:51.72,Default,,0,0,0,,＜Енді жылу жоқ→
Dialogue: 0,0:27:51.72,0:27:53.24,Default,,0,0,0,,Сұрайтын ештеңе жоқ>
Dialogue: 0,0:27:53.24,0:27:57.24,Default,,0,0,0,,<Бірақ... бала күлді>
Dialogue: 0,0:27:58.74,0:28:04.74,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory