Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:25.56,0:00:27.98,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:00:37.57,0:00:40.74,Default,,0,0,0,,(Гента мен оның достары қуанады)
Dialogue: 0,0:00:40.83,0:00:41.95,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:00:42.04,0:00:44.46,Default,,0,0,0,,Әп-сәтте ұшып кетті.
Dialogue: 0,0:00:44.54,0:00:47.46,Default,,0,0,0,,-(Мицухико) Ол өте жоғары ұшады. -(Гента/Аюми) О.
Dialogue: 0,0:00:47.54,0:00:49.88,Default,,0,0,0,,- (Гента) Маған да көрсетші - (Аюми) О, мен де.
Dialogue: 0,0:00:49.88,0:00:50.55,Default,,0,0,0,,- (Гента) Маған да көрсетші - (Аюми) О, мен де.
Dialogue: 0,0:00:49.88,0:00:50.55,Default,,0,0,0,,Жоқ, сәл күте тұрыңыз.
Dialogue: 0,0:00:50.55,0:00:50.63,Default,,0,0,0,,Жоқ, сәл күте тұрыңыз.
Dialogue: 0,0:00:50.63,0:00:52.34,Default,,0,0,0,,Жоқ, сәл күте тұрыңыз.
Dialogue: 0,0:00:50.63,0:00:52.34,Default,,0,0,0,,Муфофофо
Dialogue: 0,0:00:52.42,0:00:56.59,Default,,0,0,0,,10 000 метр биіктікте 30 минут ұшуға болады.
Dialogue: 0,0:00:56.68,0:01:00.68,Default,,0,0,0,,Бұл дрондар бойынша әлемдік рекорд шығар.
Dialogue: 0,0:01:00.76,0:01:05.19,Default,,0,0,0,,Бірақ мұндай биіктікте қалай маневр жасайсыз?
Dialogue: 0,0:01:05.27,0:01:06.39,Default,,0,0,0,,Спутниктік байланысты пайдаланады.
Dialogue: 0,0:01:06.39,0:01:07.35,Default,,0,0,0,,Спутниктік байланысты пайдаланады.
Dialogue: 0,0:01:06.39,0:01:07.35,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:08.02,0:01:11.48,Default,,0,0,0,,Сондықтан сіз оны алыста болсаңыз да басқара аласыз.
Dialogue: 0,0:01:11.57,0:01:12.61,Default,,0,0,0,,Хмм.
Dialogue: 0,0:01:12.69,0:01:15.15,Default,,0,0,0,,Ұшақтан жіберілген суреттер және
Dialogue: 0,0:01:15.24,0:01:18.16,Default,,0,0,0,,Ұшатын картоп ендік пен бойлық деректеріне сүйенеді
Dialogue: 0,0:01:18.74,0:01:21.20,Default,,0,0,0,,Бағыт жылдамдығы камерасының жұмысы
Dialogue: 0,0:01:21.28,0:01:24.66,Default,,0,0,0,,Қиын, өйткені үшеуін қатар орындау керек.
Dialogue: 0,0:01:24.75,0:01:27.75,Default,,0,0,0,,Бірақ олар неге мұндай дрон жасады?
Dialogue: 0,0:01:27.83,0:01:29.17,Default,,0,0,0,,Не?
Dialogue: 0,0:01:29.25,0:01:32.17,Default,,0,0,0,,Бұл ер адамның романтикасы.
Dialogue: 0,0:01:34.21,0:01:36.93,Default,,0,0,0,,Егер сізде бұл болса, тіпті сіз Эверестке шыға алмасаңыз да
Dialogue: 0,0:01:37.01,0:01:39.22,Default,,0,0,0,,Бұл сізді тауға шыққандай сезінеді, солай ма?
Dialogue: 0,0:01:39.30,0:01:41.97,Default,,0,0,0,,Муфофофофо…
Dialogue: 0,0:01:42.06,0:01:45.10,Default,,0,0,0,,Бұл қорқынышты күлкі.
Dialogue: 0,0:01:45.18,0:01:48.98,Default,,0,0,0,,Бұл әртүрлі заңдарды бұзатын өнертабыс.
Dialogue: 0,0:01:49.06,0:01:51.31,Default,,0,0,0,,Енді, жарнамадан кейін
Dialogue: 0,0:01:51.40,0:01:52.73,Default,,0,0,0,,Біз сізге алдағы Токио саммиті туралы соңғы ақпаратты жібереміз
Dialogue: 0,0:01:52.73,0:01:53.94,Default,,0,0,0,,Біз сізге алдағы Токио саммиті туралы соңғы ақпаратты жібереміз
Dialogue: 0,0:01:52.73,0:01:53.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:53.94,0:01:55.28,Default,,0,0,0,,Біз сізге алдағы Токио саммиті туралы соңғы ақпаратты жібереміз
Dialogue: 0,0:01:56.99,0:01:58.66,Default,,0,0,0,,Саммит осында!
Dialogue: 0,0:01:58.74,0:02:01.74,Default,,0,0,0,,Токио шығанағындағы қалпына келтірілген жерде орналасқан біріктірілген курорт —
Dialogue: 0,0:02:01.83,0:02:03.74,Default,,0,0,0,,Edge of Ocean халықаралық конференция орталығында
Dialogue: 0,0:02:03.83,0:02:05.50,Default,,0,0,0,,Келесі аптада өтеді
Dialogue: 0,0:02:06.37,0:02:09.17,Default,,0,0,0,,Edge of Ocean келесі айда ашылады деп жоспарланған.
Dialogue: 0,0:02:09.25,0:02:10.92,Default,,0,0,0,,Жағалаудағы қалаға лайық
Dialogue: 0,0:02:11.00,0:02:12.17,Default,,0,0,0,,Суды көп ішіңіз
Dialogue: 0,0:02:12.25,0:02:13.34,Default,,0,0,0,,Жасалған—
Dialogue: 0,0:02:13.42,0:02:15.51,Default,,0,0,0,,Әр түрлі нысандардан тұрады
Dialogue: 0,0:02:16.46,0:02:19.30,Default,,0,0,0,,Казино мұнарасы раковина мотивімен салынған.
Dialogue: 0,0:02:19.38,0:02:22.76,Default,,0,0,0,,Ол теңіз қауіпсіздігін қорғау үшін маяк қызметін де атқарады.
Dialogue: 0,0:02:22.85,0:02:25.60,Default,,0,0,0,,Сіз Мұхит жиегін көре аласыз.
Dialogue: 0,0:02:25.68,0:02:28.27,Default,,0,0,0,,Сондай-ақ, казино мұнарасының жанындағы сауда орталығында.
Dialogue: 0,0:02:28.35,0:02:31.52,Default,,0,0,0,,Үлкен сарқырамалар мен аспалы бақтар реттелген.
Dialogue: 0,0:02:31.60,0:02:35.78,Default,,0,0,0,,Келушілерге тыныштық сезімін береді.
Dialogue: 0,0:02:36.61,0:02:40.16,Default,,0,0,0,,Тағы бір ұғым – «wa»
Dialogue: 0,0:02:40.24,0:02:42.28,Default,,0,0,0,,Халықаралық конференц-орталықтың интерьері
Dialogue: 0,0:02:42.37,0:02:45.54,Default,,0,0,0,,Жапон бақтарының эстетикалық сұлулығын енгізу
Dialogue: 0,0:02:45.62,0:02:49.29,Default,,0,0,0,,Бірінші қабатта стильді мейрамхана да бар.
Dialogue: 0,0:02:49.37,0:02:51.54,Default,,0,0,0,,Толығырақ
Dialogue: 0,0:02:51.62,0:02:55.30,Default,,0,0,0,,Сайттың периметрі бойынша өтетін екі қабатты монорельс
Dialogue: 0,0:02:55.38,0:02:57.67,Default,,0,0,0,,Шынымен дәстүр мен болашақтың қосындысы.
Dialogue: 0,0:02:57.76,0:03:01.09,Default,,0,0,0,,Ақылды қала атмосферасын жасайды
Dialogue: 0,0:03:01.18,0:03:03.60,Default,,0,0,0,,Көріп отырғаныңыздай, Мұхит жиегі
Dialogue: 0,0:03:03.68,0:03:06.18,Default,,0,0,0,,Екі көпір арқылы қосылған
Dialogue: 0,0:03:06.26,0:03:10.31,Default,,0,0,0,,Саммит өтетін 1 мамырда елордалық полиция департаменті қауіпсіздікке жауапты болады.
Dialogue: 0,0:03:10.39,0:03:13.81,Default,,0,0,0,,22 000 полиция қызметкеріне дейін
Dialogue: 0,0:03:13.90,0:03:17.07,Default,,0,0,0,,Бұл қаражат Токиодағы қауіпсіздікті қамтамасыз етуге жұмсалатыны жарияланды.
Dialogue: 0,0:03:17.15,0:03:20.82,Default,,0,0,0,,Әрі қарай біз сізге «Хакучо» ұшқышсыз зонды туралы жаңалықтар жібереміз.
Dialogue: 0,0:03:36.29,0:03:37.71,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:03:53.69,0:03:56.15,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:04:14.62,0:04:17.29,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:04:20.05,0:04:21.42,Default,,0,0,0,,Иә, ә
Dialogue: 0,0:04:26.34,0:04:27.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:34.06,0:04:39.07,Default,,0,0,0,,♪~
Dialogue: 0,0:04:52.62,0:04:55.25,Default,,0,0,0,,Мен Шиничи Кудо, орта мектептің детективімін.
Dialogue: 0,0:04:55.33,0:04:57.50,Default,,0,0,0,,Бала күнгі досы және сыныптасы Ран Моримен
Dialogue: 0,0:04:57.58,0:04:59.00,Default,,0,0,0,,Ойын-сауық саябағына барыңыз
Dialogue: 0,0:04:59.09,0:05:00.25,Default,,0,0,0,,Қара киінген адам
Dialogue: 0,0:05:00.34,0:05:03.09,Default,,0,0,0,,Күдікті транзакция оқиғасының куәсі болды
Dialogue: 0,0:05:03.76,0:05:06.18,Default,,0,0,0,,Мен транзакцияларды қарауға құмар болдым.
Dialogue: 0,0:05:06.26,0:05:08.55,Default,,0,0,0,,Артынан келе жатқан басқа серікке.
Dialogue: 0,0:05:08.64,0:05:10.01,Default,,0,0,0,,Байқамадым
Dialogue: 0,0:05:12.35,0:05:15.23,Default,,0,0,0,,Ол кісі маған у ішті.
Dialogue: 0,0:05:15.31,0:05:16.60,Default,,0,0,0,,Сіз оянғанда...
Dialogue: 0,0:05:20.90,0:05:22.94,Default,,0,0,0,,Менің денем кішірейіп кетті.
Dialogue: 0,0:05:23.94,0:05:26.90,Default,,0,0,0,,Егер олар Шиничи Кудоның тірі екенін білсе ше?
Dialogue: 0,0:05:26.99,0:05:28.24,Default,,0,0,0,,Менің өмірімдегі тағы бір әрекет
Dialogue: 0,0:05:28.32,0:05:30.58,Default,,0,0,0,,Айналаңыздағы адамдарға да қауіп төнеді.
Dialogue: 0,0:05:31.78,0:05:33.16,Default,,0,0,0,,Доктор Агасаның кеңесі бойынша
Dialogue: 0,0:05:33.24,0:05:35.29,Default,,0,0,0,,Мен өзімнің шынайы тұлғамды жасыруды шештім.
Dialogue: 0,0:05:35.91,0:05:38.37,Default,,0,0,0,,Ран менің атымды сұрағанда, мен бірден
Dialogue: 0,0:05:38.46,0:05:40.75,Default,,0,0,0,,«Конан Эдогава» деп аталады
Dialogue: 0,0:05:40.84,0:05:42.55,Default,,0,0,0,,Олар туралы мәлімет алу
Dialogue: 0,0:05:42.63,0:05:44.21,Default,,0,0,0,,Менің әкем детектив.
Dialogue: 0,0:05:44.30,0:05:46.17,Default,,0,0,0,,Ранның үйіне кіріп кетті
Dialogue: 0,0:05:49.43,0:05:52.39,Default,,0,0,0,,Бұл жігіттер Гента Мицухико Аюми
Dialogue: 0,0:05:52.47,0:05:54.64,Default,,0,0,0,,Бұл менің кішірейіп кеткен сыныптасым.
Dialogue: 0,0:05:55.56,0:05:57.19,Default,,0,0,0,,Және Ай Хайбара
Dialogue: 0,0:05:57.27,0:05:59.40,Default,,0,0,0,,Шын есімі - Шихо Мияно
Dialogue: 0,0:05:59.48,0:06:00.69,Default,,0,0,0,,Ол бастапқыда болды
Dialogue: 0,0:06:00.77,0:06:03.32,Default,,0,0,0,,Қара киінген кісілердің досы еді.
Dialogue: 0,0:06:03.40,0:06:06.74,Default,,0,0,0,,Өз өміріңді аяқтау үшін мен сияқты дәрі іш
Dialogue: 0,0:06:06.82,0:06:08.61,Default,,0,0,0,,Менің денем кішірейіп кетті.
Dialogue: 0,0:06:10.66,0:06:12.08,Default,,0,0,0,,Және жұмбақпен қапталған -
Dialogue: 0,0:06:12.16,0:06:14.12,Default,,0,0,0,,Қара ұйымның мүшесі
Dialogue: 0,0:06:14.20,0:06:16.45,Default,,0,0,0,,Бурбон Тору Амуро
Dialogue: 0,0:06:17.00,0:06:19.79,Default,,0,0,0,,Оның шынайы тұлғасы – ол қоғамдық қауіпсіздік полициясына басшылық етеді.
Dialogue: 0,0:06:19.87,0:06:24.30,Default,,0,0,0,,Ұлттық полиция агенттігінің қауіпсіздік бюросының «Нөл» құпия агенттігіне жататын полиция қызметкерлері
Dialogue: 0,0:06:25.25,0:06:28.88,Default,,0,0,0,,Оны жасыру үшін мен детектив Мориге шәкірт болдым.
Dialogue: 0,0:06:28.97,0:06:33.05,Default,,0,0,0,,Пуаро кафесінде жұмыс істейтін жұмбақ адам.
Dialogue: 0,0:06:36.35,0:06:38.10,Default,,0,0,0,,Кішірейсең де, миың сол күйінде қалады
Dialogue: 0,0:06:38.89,0:06:41.10,Default,,0,0,0,,Лабиринті жоқ детектив
Dialogue: 0,0:06:41.65,0:06:45.11,Default,,0,0,0,,Әрқашан бір шындық бар!
Dialogue: 0,0:06:50.45,0:06:52.57,Default,,0,0,0,,Пилотсыз зонд Хакучога
Dialogue: 0,0:06:52.66,0:06:54.58,Default,,0,0,0,,Марстан үлгілерді жинау аяқталды
Dialogue: 0,0:06:54.66,0:06:56.70,Default,,0,0,0,,1 мамыр Жапония уақыты
Dialogue: 0,0:06:56.79,0:06:59.54,Default,,0,0,0,,Біз Жерге қайта ораламыз.
Dialogue: 0,0:07:00.04,0:07:03.84,Default,,0,0,0,,Қайтқанда зонд корпусы атмосферада жанып кетеді.
Dialogue: 0,0:07:03.92,0:07:07.63,Default,,0,0,0,,Диаметрі шамамен 4 метр болатын Жерге қайтарылатын капсула ғана.
Dialogue: 0,0:07:07.71,0:07:09.47,Default,,0,0,0,,Атмосфераға қайта кіріңіз
Dialogue: 0,0:07:10.55,0:07:12.55,Default,,0,0,0,,Содан кейін парашютпен секіріңіз
Dialogue: 0,0:07:12.64,0:07:16.43,Default,,0,0,0,,Жапонияға жақын Тынық мұхитына қонуға жоспарланған.
Dialogue: 0,0:07:16.51,0:07:17.56,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:17.64,0:07:19.10,Default,,0,0,0,,Үлгі капсуласында бар
Dialogue: 0,0:07:19.18,0:07:23.90,Default,,0,0,0,,GPS-пен жабдықталған дәл бағдарлау жүйесі деп аталатын нәрсе бар.
Dialogue: 0,0:07:23.98,0:07:26.98,Default,,0,0,0,,Құлау нүктесі 200 метр радиуста.
Dialogue: 0,0:07:27.07,0:07:28.07,Default,,0,0,0,,Я~ Аа.
Dialogue: 0,0:07:28.07,0:07:28.90,Default,,0,0,0,,Ху~ Аа.
Dialogue: 0,0:07:28.07,0:07:28.90,Default,,0,0,0,,Уау
Dialogue: 0,0:07:28.99,0:07:30.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:30.65,0:07:32.66,Default,,0,0,0,,- (Мицухико) Сәл күте тұрыңыз... - (Гента) Маған асығыңыз.
Dialogue: 0,0:07:32.74,0:07:35.53,Default,,0,0,0,,Ха...
Dialogue: 0,0:07:32.74,0:07:35.53,Default,,0,0,0,,(Гента мен оның достарының әбігері)
Dialogue: 0,0:07:35.53,0:07:36.12,Default,,0,0,0,,(Гента мен оның достарының әбігері)
Dialogue: 0,0:07:36.20,0:07:37.91,Default,,0,0,0,,- (Гента және басқалар) Ах! -(Ағаса) Уау, уау.
Dialogue: 0,0:07:39.00,0:07:40.79,Default,,0,0,0,,Хмм… контроллер.
Dialogue: 0,0:07:40.87,0:07:45.17,Default,,0,0,0,,Оны үш бөлікке бөлейік: бағыт, жылдамдық және камера.
Dialogue: 0,0:07:45.25,0:07:46.88,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:07:46.96,0:07:47.84,Default,,0,0,0,,Біз шоудың ортасындамыз, бірақ міне жаңадан келген жаңалық.
Dialogue: 0,0:07:47.84,0:07:48.84,Default,,0,0,0,,Біз шоудың ортасындамыз, бірақ міне жаңадан келген жаңалық.
Dialogue: 0,0:07:47.84,0:07:48.84,Default,,0,0,0,,Ах
Dialogue: 0,0:07:48.84,0:07:50.38,Default,,0,0,0,,Біз шоудың ортасындамыз, бірақ міне жаңа ғана келген жаңалық.
Dialogue: 0,0:07:50.47,0:07:51.55,Default,,0,0,0,,Мен сізге айтамын
Dialogue: 0,0:07:51.63,0:07:54.43,Default,,0,0,0,,Келесі аптада Токио саммиті өтетін Халықаралық конференция орталығында.
Dialogue: 0,0:07:54.51,0:07:56.60,Default,,0,0,0,,Бұрын үлкен жарылыс болды.
Dialogue: 0,0:07:56.68,0:07:57.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:57.43,0:07:57.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:57.43,0:07:57.89,Default,,0,0,0,,Бұл сол кездегі қауіпсіздік камерасынан түсірілген кадрлар.
Dialogue: 0,0:07:57.89,0:07:59.35,Default,,0,0,0,,Бұл сол кездегі қауіпсіздік камерасынан түсірілген кадрлар.
Dialogue: 0,0:08:06.19,0:08:07.57,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:08.44,0:08:12.24,Default,,0,0,0,,Біріктірілген курорттық Мұхит жиегі сайтқа айналды
Dialogue: 0,0:08:12.32,0:08:14.07,Default,,0,0,0,,Ол әлі ашылмағандықтан, тұтынушылар болған жоқ.
Dialogue: 0,0:08:14.07,0:08:15.74,Default,,0,0,0,,Клиенттер болған жоқ, себебі ол әлі ашылмаған.
Dialogue: 0,0:08:14.07,0:08:15.74,Default,,0,0,0,,Дәрігер!
Dialogue: 0,0:08:15.82,0:08:19.20,Default,,0,0,0,,Бірнеше полиция қызметкері саммит қауіпсіздігін алдын ала тексеріп жатқан.
Dialogue: 0,0:08:19.29,0:08:22.46,Default,,0,0,0,,Құрбан болғандар туралы ақпарат бар. қайталаймын.
Dialogue: 0,0:08:22.54,0:08:23.79,Default,,0,0,0,,Ах
Dialogue: 0,0:08:22.54,0:08:23.79,Default,,0,0,0,,Бұрын, Мұхит шетіндегі біріктірілген курортта.
Dialogue: 0,0:08:23.79,0:08:24.29,Default,,0,0,0,,Бұрын, Мұхит шетіндегі біріктірілген курортта.
Dialogue: 0,0:08:24.29,0:08:25.63,Default,,0,0,0,,Бұрын, Мұхит шетіндегі біріктірілген курортта.
Dialogue: 0,0:08:24.29,0:08:25.63,Default,,0,0,0,,Мүмкін бұл терроризм шығар.
Dialogue: 0,0:08:25.63,0:08:25.71,Default,,0,0,0,,Бұрын, Мұхиттың шетіндегі біріктірілген курортында.
Dialogue: 0,0:08:25.71,0:08:26.33,Default,,0,0,0,,Бұрын, Мұхит шетіндегі біріктірілген курортта.
Dialogue: 0,0:08:25.71,0:08:26.33,Default,,0,0,0,,Саммит келесі аптада, солай ма?
Dialogue: 0,0:08:26.33,0:08:26.42,Default,,0,0,0,,Саммит келесі аптада, солай ма?
Dialogue: 0,0:08:26.42,0:08:28.38,Default,,0,0,0,,Саммит келесі аптада, солай ма?
Dialogue: 0,0:08:26.42,0:08:28.38,Default,,0,0,0,,Жарылыс болды
Dialogue: 0,0:08:28.46,0:08:29.21,Default,,0,0,0,,Елордалық полиция департаментінің хабарламасына сәйкес, қазіргі уақытта —
Dialogue: 0,0:08:29.21,0:08:30.71,Default,,0,0,0,,Елордалық полиция департаментінің хабарламасына сәйкес, қазіргі уақытта —
Dialogue: 0,0:08:29.21,0:08:30.71,Default,,0,0,0,,Бұл апат болуы мүмкін.
Dialogue: 0,0:08:30.80,0:08:35.34,Default,,0,0,0,,Қаза болған және жарақаттанған полиция қызметкерлерінің саны және бұл жазатайым оқиға немесе оқиға болды ма
Dialogue: 0,0:08:35.43,0:08:38.39,Default,,0,0,0,,Ол әлі тергеуде, сондықтан әлі анық емес.
Dialogue: 0,0:08:38.47,0:08:42.23,Default,,0,0,0,,Полиция қызметкері қаза тапты немесе жарақат алды ма? Уайымдама
Dialogue: 0,0:08:42.31,0:08:44.98,Default,,0,0,0,,Міне, доктор! Экран жоғалып кетті!
Dialogue: 0,0:08:45.06,0:08:47.15,Default,,0,0,0,,О, енді барайық.
Dialogue: 0,0:08:47.23,0:08:51.48,Default,,0,0,0,,Ал, егер менен сұрасаңыз, саммит алдында теракт орын алса ше?
Dialogue: 0,0:08:51.57,0:08:54.36,Default,,0,0,0,,Нақты өнімділіктегі қауіпсіздік күшейе түседі.
Dialogue: 0,0:08:55.40,0:08:56.36,Default,,0,0,0,,Иә?what up?
Dialogue: 0,0:08:56.45,0:09:00.83,Default,,0,0,0,,Жарылыстан кейін бірден қауіпсіздік камерасының түсірілімі...
Dialogue: 0,0:09:01.79,0:09:03.08,Default,,0,0,0,,Сіз бірдеңе көрдіңіз бе?
Dialogue: 0,0:09:04.08,0:09:07.79,Default,,0,0,0,,Бұл бір сәтке ғана болды, сондықтан мен қате түсінген шығармын.
Dialogue: 0,0:09:07.88,0:09:08.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:08.79,0:09:10.09,Default,,0,0,0,,Сол адам
Dialogue: 0,0:09:10.67,0:09:11.75,Default,,0,0,0,,Мен Пуарода жұмыс істеймін...
Dialogue: 0,0:09:11.84,0:09:12.84,Default,,0,0,0,,Га
Dialogue: 0,0:09:17.34,0:09:20.35,Default,,0,0,0,,Егер есімде дұрыс болса, оның аты Тоору Амуро болатын.
Dialogue: 0,0:09:20.43,0:09:22.35,Default,,0,0,0,,Амуро-сан?
Dialogue: 0,0:09:23.77,0:09:25.35,Default,,0,0,0,,Сот сараптамасының нәтижелері—
Dialogue: 0,0:09:25.43,0:09:28.60,Default,,0,0,0,,Оқиға орнынан жарылғыш зат табылмады.
Dialogue: 0,0:09:28.69,0:09:32.02,Default,,0,0,0,,Халықаралық конференц-залдың бірінші қабатында жапон мейрамханасы бар.
Dialogue: 0,0:09:32.11,0:09:35.74,Default,,0,0,0,,Жарылыс болған жертөледе ас үй бар.
Dialogue: 0,0:09:35.82,0:09:38.70,Default,,0,0,0,,Онда газдың көп мөлшері анықталды.
Dialogue: 0,0:09:38.78,0:09:40.70,Default,,0,0,0,,Сондықтан бұл газ жарылысы болды деп қорытынды жасауға болады деп ойлаймын.
Dialogue: 0,0:09:40.70,0:09:42.70,Default,,0,0,0,,Сондықтан бұл газ жарылысы болды деп қорытынды жасауға болады деп ойлаймын.
Dialogue: 0,0:09:40.70,0:09:42.70,Default,,0,0,0,,- (Детектив) Газ? - (Детектив) Бұл оқыс оқиға болды.
Dialogue: 0,0:09:43.54,0:09:46.87,Default,,0,0,0,,Күте тұрыңыз, бұл ғимарат жаңа ғана аяқталды.
Dialogue: 0,0:09:46.96,0:09:49.25,Default,,0,0,0,,Газдың шығуы екіталай
Dialogue: 0,0:09:49.33,0:09:52.30,Default,,0,0,0,,Иә, шын мәнінде бұл газ құбыры ең соңғы үлгі.
Dialogue: 0,0:09:52.92,0:09:56.30,Default,,0,0,0,,Сондай-ақ газ клапанын онлайн режимінде ашу және жабу мүмкіндігі бар.
Dialogue: 0,0:09:56.97,0:09:59.30,Default,,0,0,0,,Олай болса газдың шығуы неліктен пайда болады?
Dialogue: 0,0:10:00.01,0:10:03.51,Default,,0,0,0,,Жүйе басынан бастап ақаулы болуы мүмкін.
Dialogue: 0,0:10:03.60,0:10:06.23,Default,,0,0,0,,Сіз оны тексерген жоқсыз ба?
Dialogue: 0,0:10:06.31,0:10:07.98,Default,,0,0,0,,Бүгін жоспарланған
Dialogue: 0,0:10:08.06,0:10:09.98,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:10:10.06,0:10:11.65,Default,,0,0,0,,Мұхиттың жағасында
Dialogue: 0,0:10:11.73,0:10:14.28,Default,,0,0,0,,Бүгін интернет ортасы дайын болған күн болды.
Dialogue: 0,0:10:14.36,0:10:19.66,Default,,0,0,0,,Бүгін таңертең елордалық полиция департаментінің қоғамдық қауіпсіздік департаменті қауіпсіздікті тексеруден кейін мен тексеруді жоспарладым.
Dialogue: 0,0:10:20.36,0:10:24.58,Default,,0,0,0,,Олай болса, бұл жолы апаттың болу ықтималдығы жоғары.
Dialogue: 0,0:10:24.66,0:10:27.33,Default,,0,0,0,,Иә, егер бұл саммитке бағытталған лаңкестік әрекет болса.
Dialogue: 0,0:10:27.41,0:10:31.92,Default,,0,0,0,,Әлемнің түкпір-түкпірінен келген құрметті адамдар келесі аптада 1 мамырда өтетін жерге жиналады.
Dialogue: 0,0:10:32.00,0:10:33.59,Default,,0,0,0,,Ол орындалмайынша мағынасыз.
Dialogue: 0,0:10:34.17,0:10:36.55,Default,,0,0,0,,Саммит өтетін орын
Dialogue: 0,0:10:36.63,0:10:39.18,Default,,0,0,0,,Осы мәселеге байланысты өзгерістер болады.
Dialogue: 0,0:10:39.26,0:10:41.26,Default,,0,0,0,,(Детективтердің күбірі)
Dialogue: 0,0:10:41.26,0:10:41.76,Default,,0,0,0,,(Детективтердің күбірі)
Dialogue: 0,0:10:41.26,0:10:41.76,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:41.76,0:10:41.84,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:41.84,0:10:43.01,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:41.84,0:10:43.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:43.01,0:10:43.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:43.43,0:10:44.56,Default,,0,0,0,,Біз сонда барамыз.
Dialogue: 0,0:10:44.64,0:10:46.47,Default,,0,0,0,,Аты-жөніңізді және байланысыңызды көрсетіңіз
Dialogue: 0,0:10:46.56,0:10:49.48,Default,,0,0,0,,Менің атым Юя Казами, Токио қалалық полиция департаментінің қоғамдық қауіпсіздік департаментінен.
Dialogue: 0,0:10:50.19,0:10:52.52,Default,,0,0,0,,Газдың жарылуына әкелетін тұтандырғыш заттар ше?
Dialogue: 0,0:10:52.61,0:10:53.61,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:10:53.69,0:10:55.98,Default,,0,0,0,,Қылмыстық бөлім электр жабдықтарын тергеп жатыр.
Dialogue: 0,0:10:56.65,0:10:58.24,Default,,0,0,0,,Өртендіргіш материал
Dialogue: 0,0:10:58.32,0:11:00.74,Default,,0,0,0,,Жоғары вольтты кабель болуы мүмкін
Dialogue: 0,0:11:00.82,0:11:03.74,Default,,0,0,0,,Құрылыс қатесі табылған болуы мүмкін бе?
Dialogue: 0,0:11:03.82,0:11:05.91,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:11:05.99,0:11:11.04,Default,,0,0,0,,Саусақ іздері жоғары вольтты кабельді сақтау есігінен өртеніп кеткен.
Dialogue: 0,0:11:11.12,0:11:13.96,Default,,0,0,0,,Сонымен, жарылыс алдында қалған саусақ іздері?
Dialogue: 0,0:11:14.04,0:11:17.63,Default,,0,0,0,,Иә, учаскеге кірген адамдар құрылысшылар.
Dialogue: 0,0:11:17.71,0:11:20.76,Default,,0,0,0,,Бүгін таңертең біз қауіпсіздікті тек Қоғамдық қауіпсіздік министрлігінде тексердік.
Dialogue: 0,0:11:20.84,0:11:25.93,Default,,0,0,0,,Сондықтан құрылысшылар мен полиция қызметкерлерінің саусақ іздері
Dialogue: 0,0:11:26.01,0:11:28.14,Default,,0,0,0,,Мәліметтер базасын сәйкестендіру нәтижелері
Dialogue: 0,0:11:28.22,0:11:32.40,Default,,0,0,0,,Бұрын Токио қалалық полиция департаментінің бірінші тергеу бөлімінің мүшесі болған.
Dialogue: 0,0:11:32.48,0:11:36.15,Default,,0,0,0,,Когоро Моуридің саусақ ізімен сәйкестендірілді
Dialogue: 0,0:11:36.23,0:11:38.32,Default,,0,0,0,,- (Такаги) Не? - (Аққу) Бұл ақымақтық.
Dialogue: 0,0:11:38.82,0:11:39.65,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:11:39.74,0:11:41.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:41.20,0:11:43.66,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:48.12,0:11:50.41,Default,,0,0,0,,Полигондағы халықаралық конференция орталығы?
Dialogue: 0,0:11:50.50,0:11:52.92,Default,,0,0,0,,Мен мұндай жерде ешқашан болған емеспін!
Dialogue: 0,0:11:53.00,0:11:56.17,Default,,0,0,0,,Бірақ қылмыс болған жерден Мори мырзаның саусақ іздері табылды.
Dialogue: 0,0:11:56.25,0:11:59.30,Default,,0,0,0,,Жоқ! Эй!
Dialogue: 0,0:11:59.38,0:12:04.18,Default,,0,0,0,,Әке, сіз тағы да мас болып, рұқсатсыз кірген жоқсыз ба?
Dialogue: 0,0:12:04.26,0:12:07.93,Default,,0,0,0,,Ешқайда кетпе!
Dialogue: 0,0:12:08.76,0:12:11.73,Default,,0,0,0,,Бұл қандай да бір қателік. Қарасам да ештеңе таба алмадым.
Dialogue: 0,0:12:11.81,0:12:12.69,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:12:12.77,0:12:14.56,Default,,0,0,0,,Бұл не сұмдық?
Dialogue: 0,0:12:14.65,0:12:16.65,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:12:18.44,0:12:20.53,Default,,0,0,0,,- (Казами) Кешіріңіз - (Жүгіріп) А, иә.
Dialogue: 0,0:12:24.74,0:12:27.53,Default,,0,0,0,,Конан-кун, не болды?
Dialogue: 0,0:12:28.24,0:12:31.75,Default,,0,0,0,,Анау детективтің беті жараланған, жақсысың ба?
Dialogue: 0,0:12:31.83,0:12:33.96,Default,,0,0,0,,О, Казами-сан?
Dialogue: 0,0:12:34.04,0:12:37.33,Default,,0,0,0,,Ол жарылыс орнында болса керек.
Dialogue: 0,0:12:37.42,0:12:38.59,Default,,0,0,0,,- Мм... - (Такаги) Хмм?
Dialogue: 0,0:12:40.92,0:12:45.89,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:12:45.97,0:12:48.26,Default,,0,0,0,,А, мен ваннадамын, хехехехе
Dialogue: 0,0:12:50.68,0:12:52.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:52.60,0:12:53.48,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:12:53.48,0:12:53.81,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:12:53.48,0:12:53.81,Default,,0,0,0,,О, не болды?
Dialogue: 0,0:12:53.81,0:12:55.48,Default,,0,0,0,,О, не болды?
Dialogue: 0,0:12:55.56,0:12:56.44,Default,,0,0,0,,Иә
Dialogue: 0,0:12:57.56,0:13:01.03,Default,,0,0,0,,Әкеңді полиция күдіктеніп отыр ма?
Dialogue: 0,0:13:01.11,0:13:06.03,Default,,0,0,0,,Иә, менің ойымша, бұл қандай да бір қателік.
Dialogue: 0,0:13:06.11,0:13:09.78,Default,,0,0,0,,Жарайды, мен де қараймын.
Dialogue: 0,0:13:10.95,0:13:13.45,Default,,0,0,0,,Балама құрылғыларды пайдалану қиын
Dialogue: 0,0:13:14.62,0:13:17.50,Default,,0,0,0,,Иә? менің смартфоным
Dialogue: 0,0:13:20.29,0:13:22.51,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:13:22.59,0:13:24.38,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:13:24.47,0:13:25.38,Default,,0,0,0,,А, доктор?
Dialogue: 0,0:13:25.47,0:13:29.39,Default,,0,0,0,,Иә? О, Шиничи, не болды?
Dialogue: 0,0:13:29.47,0:13:32.39,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:13:32.47,0:13:33.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:34.23,0:13:36.31,Default,,0,0,0,,Бұл жігіттер қашаннан бері осылай істеп келеді?
Dialogue: 0,0:13:36.31,0:13:37.14,Default,,0,0,0,,Бұл жігіттер қашаннан бері осылай істеп келеді?
Dialogue: 0,0:13:36.31,0:13:37.14,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:13:37.23,0:13:39.06,Default,,0,0,0,,Сәлем Такаги! Бірдеңе жасаңыз
Dialogue: 0,0:13:37.23,0:13:39.06,Default,,0,0,0,,Тағы біраз күтіңіз.
Dialogue: 0,0:13:39.15,0:13:40.56,Default,,0,0,0,,- (Когоро) Оларды тез айдап жібер - (Такаги) А, иә.
Dialogue: 0,0:13:41.27,0:13:42.11,Default,,0,0,0,,Ах
Dialogue: 0,0:13:43.40,0:13:44.40,Default,,0,0,0,,Ах
Dialogue: 0,0:13:45.99,0:13:47.95,Default,,0,0,0,,Менің смартфоным...
Dialogue: 0,0:13:51.49,0:13:56.54,Default,,0,0,0,,(ұшқышсыз ұшу дыбысы)
Dialogue: 0,0:13:56.62,0:13:58.92,Default,,0,0,0,,Ой, бұл қызық.
Dialogue: 0,0:13:59.00,0:14:00.50,Default,,0,0,0,,Ах, Гента-кун
Dialogue: 0,0:14:00.58,0:14:03.05,Default,,0,0,0,,Баяулатыңыз.
Dialogue: 0,0:14:03.13,0:14:04.76,Default,,0,0,0,,Себебі мен түсіріп жатырмын.
Dialogue: 0,0:14:04.84,0:14:06.67,Default,,0,0,0,,Авдол мен басқалар… келе жатыр…
Dialogue: 0,0:14:06.76,0:14:10.80,Default,,0,0,0,,Бірақ оның осыншама алысқа ұша алатыны ғажап.
Dialogue: 0,0:14:11.43,0:14:14.52,Default,,0,0,0,,Сіз оны тіпті 30 км қашықтықта басқара аласыз.
Dialogue: 0,0:14:14.60,0:14:18.14,Default,,0,0,0,,Әй, біз 20 шақырым жерге ұшып кеттік.
Dialogue: 0,0:14:18.23,0:14:19.23,Default,,0,0,0,,- (Гента/Аюми) Хэхехе... - (Агаса) А?
Dialogue: 0,0:14:20.90,0:14:23.73,Default,,0,0,0,,Сайтамадағы апама бірдеңені жеткізіп бердім.
Dialogue: 0,0:14:23.82,0:14:26.03,Default,,0,0,0,,Апай қатты қуанды.
Dialogue: 0,0:14:26.03,0:14:26.86,Default,,0,0,0,,Апай қатты қуанды.
Dialogue: 0,0:14:26.03,0:14:26.86,Default,,0,0,0,,(Хайбардың есінеу)
Dialogue: 0,0:14:26.94,0:14:27.78,Default,,0,0,0,,-(Аюми) Иә -(Мицухико) Дұрыс.
Dialogue: 0,0:14:27.86,0:14:29.11,Default,,0,0,0,,Мен мұны білмей тұрып...
Dialogue: 0,0:14:29.20,0:14:33.87,Default,,0,0,0,,Бірақ бұл экран кішкентай, оны көру қиын емес пе?
Dialogue: 0,0:14:33.95,0:14:35.54,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:35.62,0:14:39.37,Default,,0,0,0,,Бастапқыда үш адамға бөлу жоспарланбаған.
Dialogue: 0,0:14:39.46,0:14:40.83,Default,,0,0,0,,Сәлем, доктор
Dialogue: 0,0:14:40.92,0:14:43.79,Default,,0,0,0,,Менің контроллеріме де экран қосыңыз.
Dialogue: 0,0:14:43.88,0:14:45.63,Default,,0,0,0,,Оны Аюмиге де қойыңыз
Dialogue: 0,0:14:45.71,0:14:48.67,Default,,0,0,0,,Хмм, дұрыс.
Dialogue: 0,0:14:48.76,0:14:50.63,Default,,0,0,0,,Жарайды, онда викторинаға қатысайық!
Dialogue: 0,0:14:50.72,0:14:51.64,Default,,0,0,0,,Хе-хе-хе-хе. Міне, 1-курстың үшеуіміз ақыры бірге жиналдық
Dialogue: 0,0:14:51.72,0:14:54.31,Default,,0,0,0,,Жарайды, егер сұраққа дұрыс жауап берсеңіз
Dialogue: 0,0:14:54.39,0:14:56.81,Default,,0,0,0,,Әрқайсысын монитормен қамтамасыз етемін.
Dialogue: 0,0:14:56.89,0:14:58.06,Default,,0,0,0,,Гэез
Dialogue: 0,0:14:58.14,0:14:59.39,Default,,0,0,0,,Сонымен сұрақ туындайды
Dialogue: 0,0:15:01.06,0:15:02.77,Default,,0,0,0,,Хирагана сызығында
Dialogue: 0,0:15:02.86,0:15:06.86,Default,,0,0,0,,Төмендегілердің қайсысының масштабы ең үлкен?
Dialogue: 0,0:15:11.99,0:15:14.41,Default,,0,0,0,,Шкаласы дегеніміз не?
Dialogue: 0,0:15:14.49,0:15:18.20,Default,,0,0,0,,Ең үлкені?
Dialogue: 0,0:15:18.29,0:15:20.83,Default,,0,0,0,,Хирагананы кең ауқымда айтсаң да...
Dialogue: 0,0:15:20.91,0:15:23.29,Default,,0,0,0,,Жол - Aiueo
Dialogue: 0,0:15:23.38,0:15:26.50,Default,,0,0,0,,Ка сызығын басқа сөзбен ойластырыңыз.
Dialogue: 0,0:15:26.59,0:15:30.63,Default,,0,0,0,,...
Dialogue: 0,0:15:30.72,0:15:32.38,Default,,0,0,0,,Е, мен түсінбеймін.
Dialogue: 0,0:15:32.47,0:15:34.85,Default,,0,0,0,,Уа, Аюми-чан, камераны жылжытпашы.
Dialogue: 0,0:15:34.85,0:15:35.76,Default,,0,0,0,,Уау, Аюми-чан, камераны жылжытпашы.
Dialogue: 0,0:15:34.85,0:15:35.76,Default,,0,0,0,,Аа, кешіріңіз... Кешіріңіз.
Dialogue: 0,0:15:35.76,0:15:36.35,Default,,0,0,0,,Аа, кешіріңіз... Кешіріңіз.
Dialogue: 0,0:15:36.35,0:15:36.85,Default,,0,0,0,,Аа, кешіріңіз... Кешіріңіз.
Dialogue: 0,0:15:36.35,0:15:36.85,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:36.85,0:15:37.89,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:37.97,0:15:40.27,Default,,0,0,0,,Содан кейін №1 кеңес: Аққу
Dialogue: 0,0:15:40.35,0:15:41.56,Default,,0,0,0,,Аққу?
Dialogue: 0,0:15:41.64,0:15:43.65,Default,,0,0,0,,Эй... Эй, Айкун.
Dialogue: 0,0:15:43.73,0:15:47.98,Default,,0,0,0,,Аққулар туралы айтсақ, Аққу көлі
Dialogue: 0,0:15:48.07,0:15:51.90,Default,,0,0,0,,А, бұл үлкен көл, демек бұл Миюки!
Dialogue: 0,0:15:51.99,0:15:53.24,Default,,0,0,0,,Бұл емес.
Dialogue: 0,0:15:53.32,0:15:54.24,Default,,0,0,0,,Нұсқау №2 Аққу қайтып келеді
Dialogue: 0,0:15:54.24,0:15:56.03,Default,,0,0,0,,Нұсқау №2 Аққу қайтып келеді
Dialogue: 0,0:15:54.24,0:15:56.03,Default,,0,0,0,,О...
Dialogue: 0,0:15:56.62,0:15:58.99,Default,,0,0,0,,Ширатори мырза үйіне бара жатыр ма?
Dialogue: 0,0:15:59.08,0:16:01.79,Default,,0,0,0,,Әй, онда бұл көл ғой!
Dialogue: 0,0:16:01.87,0:16:06.21,Default,,0,0,0,,Үй үйі Үй…
Dialogue: 0,0:16:06.29,0:16:07.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:07.25,0:16:08.96,Default,,0,0,0,,Сенің әрекетің тым балалық… немесе жай ғана қысқа көзді.
Dialogue: 0,0:16:09.05,0:16:12.09,Default,,0,0,0,,«Аққу» ұшқышсыз зонд ғарыштан қайтып келеді.
Dialogue: 0,0:16:12.17,0:16:13.84,Default,,0,0,0,,Сонымен, дұрыс жауап қандай?
Dialogue: 0,0:16:13.93,0:16:15.76,Default,,0,0,0,,Бұл №1, А жолы.
Dialogue: 0,0:16:15.84,0:16:18.64,Default,,0,0,0,,aiueo ортаңғы әрпі «u»
Dialogue: 0,0:16:18.72,0:16:20.89,Default,,0,0,0,,Басқаша айтқанда, «Учуу»
Dialogue: 0,0:16:21.52,0:16:24.65,Default,,0,0,0,,Ғаламның масштабы барлық нәрселерден үлкен.
Dialogue: 0,0:16:24.73,0:16:26.90,Default,,0,0,0,,- (Хайбара) Иә, тамаша жауап - (Мицухико) Ия!
Dialogue: 0,0:16:27.65,0:16:29.40,Default,,0,0,0,,Айкун қазірдің өзінде
Dialogue: 0,0:16:29.48,0:16:32.90,Default,,0,0,0,,Әр жолы тым көп кеңестер
Dialogue: 0,0:16:33.53,0:16:35.16,Default,,0,0,0,,Білесіз бе, доктор.
Dialogue: 0,0:16:35.24,0:16:38.78,Default,,0,0,0,,Дронды басқарған кезде викторинадан өту қауіпті емес пе?
Dialogue: 0,0:16:38.87,0:16:41.25,Default,,0,0,0,,Ал қазір барлығы не істеп жатыр?
Dialogue: 0,0:16:41.33,0:16:44.00,Default,,0,0,0,,Дәрігердің викторинасынан айырмашылығы, бұл ойын емес.
Dialogue: 0,0:16:44.08,0:16:45.29,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:46.13,0:16:49.55,Default,,0,0,0,,Біз, Қылмыстық іздестіру департаменті және Қоғамдық қауіпсіздік және Қауіпсіздік департаменті.
Dialogue: 0,0:16:49.63,0:16:53.22,Default,,0,0,0,,Мен саммитке дейін сайтты тексеруім керек еді.
Dialogue: 0,0:16:53.30,0:16:56.80,Default,,0,0,0,,Жарылыс кезінде Қоғамдық қауіпсіздік министрлігі жауапты болды.
Dialogue: 0,0:16:56.89,0:16:59.68,Default,,0,0,0,,Сондықтан детектив Казами жарақат алды.
Dialogue: 0,0:16:59.76,0:17:03.68,Default,,0,0,0,,Ол ғимараттың сыртында болды, сондықтан ол жеңіл жарақаттармен аман қалды.
Dialogue: 0,0:17:03.77,0:17:05.69,Default,,0,0,0,,Ғимарат ішіндегі адамдар...
Dialogue: 0,0:17:05.77,0:17:10.19,Default,,0,0,0,,Иә, мен жаңалықтардан кейбір адамдардың қайтыс болғанын көрдім.
Dialogue: 0,0:17:10.27,0:17:14.57,Default,,0,0,0,,А, мен мұны айтпауым керек сияқты.
Dialogue: 0,0:17:14.65,0:17:17.95,Default,,0,0,0,,Жәбірленуші азаматтық емес, тек полиция қызметкері болды.
Dialogue: 0,0:17:18.03,0:17:20.20,Default,,0,0,0,,Бәлкім, бұл бата болуы мүмкін.
Dialogue: 0,0:17:21.03,0:17:23.87,Default,,0,0,0,,Саммит кезінде жарылыс орын алса ше?
Dialogue: 0,0:17:23.95,0:17:26.21,Default,,0,0,0,,Дүниенің бәрі дүр сілкінді, солай емес пе?
Dialogue: 0,0:17:26.29,0:17:31.80,Default,,0,0,0,,Жоқ, елордалық полиция департаменті...әсіресе Қоғамдық қауіпсіздік департаменті шабуылда.
Dialogue: 0,0:17:31.88,0:17:34.21,Default,,0,0,0,,Саммит алдында жарылыс болды.
Dialogue: 0,0:17:34.30,0:17:35.22,Default,,0,0,0,,Мен көмектесе алмаймын
Dialogue: 0,0:17:35.30,0:17:36.38,Default,,0,0,0,,Жазатайым оқиға?
Dialogue: 0,0:17:36.47,0:17:39.22,Default,,0,0,0,,А, жоқ, оқиға орнындағы жағдайдан.
Dialogue: 0,0:17:39.30,0:17:42.47,Default,,0,0,0,,Алдымен оны жазатайым оқиға ретінде қарастыру керек еді.
Dialogue: 0,0:17:43.14,0:17:46.23,Default,,0,0,0,,Когоро ағасының саусақ іздері оқиға орнында болды, солай ма?
Dialogue: 0,0:17:46.31,0:17:51.44,Default,,0,0,0,,А, Казами-сан тауып алды да, кенеттен іс болды.
Dialogue: 0,0:17:52.32,0:17:53.82,Default,,0,0,0,,Детектив Казами...
Dialogue: 0,0:17:53.90,0:17:54.94,Default,,0,0,0,,Ах
Dialogue: 0,0:17:56.82,0:17:58.53,Default,,0,0,0,,Детектив Такаги, рахмет
Dialogue: 0,0:17:58.61,0:17:59.45,Default,,0,0,0,,-Кездескенше! -(Такаги) Ах.
Dialogue: 0,0:18:00.78,0:18:03.20,Default,,0,0,0,,Үйге қайтқанда сақ болыңыз!
Dialogue: 0,0:18:03.29,0:18:04.79,Default,,0,0,0,,Жүгіру Не болды?
Dialogue: 0,0:18:04.87,0:18:06.62,Default,,0,0,0,,- (Жүгіріп) Шиничи, маған көмектесші - А?
Dialogue: 0,0:18:06.71,0:18:08.62,Default,,0,0,0,,Әкем қамауға алынады!
Dialogue: 0,0:18:08.71,0:18:10.17,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:13.59,0:18:15.76,Default,,0,0,0,,Сондықтан мен білмеймін!
Dialogue: 0,0:18:15.84,0:18:19.68,Default,,0,0,0,,Бұл сіздің тәркіленген компьютеріңізден шықты.
Dialogue: 0,0:18:19.76,0:18:21.85,Default,,0,0,0,,Саммит күнтізбесі
Dialogue: 0,0:18:21.93,0:18:25.68,Default,,0,0,0,,Міне, жарылған халықаралық конференц-орталықтың еден жоспары.
Dialogue: 0,0:18:25.77,0:18:26.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:26.85,0:18:31.56,Default,,0,0,0,,Бұл өтірік! Менің әкем мұндай материалдарды компьютеріне сақтай алмайды.
Dialogue: 0,0:18:31.65,0:18:32.56,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:18:32.65,0:18:34.69,Default,,0,0,0,,Мен компьютерді өте білмеймін!
Dialogue: 0,0:18:34.78,0:18:36.57,Default,,0,0,0,,Дұрыс, мүмкін емес!
Dialogue: 0,0:18:36.65,0:18:38.28,Default,,0,0,0,,Қалай болғанда да, мен полициядан толығырақ мәлімет сұраймын.
Dialogue: 0,0:18:38.28,0:18:39.36,Default,,0,0,0,,Қалай болғанда да, мен полициядан толығырақ мәлімет сұраймын.
Dialogue: 0,0:18:38.28,0:18:39.36,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:18:39.36,0:18:39.45,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:18:39.45,0:18:39.78,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:18:39.45,0:18:39.78,Default,,0,0,0,,Ой, әзіл!
Dialogue: 0,0:18:39.78,0:18:40.91,Default,,0,0,0,,Ой, әзіл!
Dialogue: 0,0:18:40.99,0:18:43.49,Default,,0,0,0,,Сіз қоғамдық қауіпсіздікті ерікті түрде сүйемелдеу туралы білесіз бе?
Dialogue: 0,0:18:45.12,0:18:48.16,Default,,0,0,0,,Енді мен сізді қызметтік міндеттеріңізге кедергі келтіргеніңіз үшін қамауға аламын.
Dialogue: 0,0:18:48.25,0:18:50.08,Default,,0,0,0,,Жарайды... Менің ойымша, мен жай ғана төледім...
Dialogue: 0,0:18:50.17,0:18:51.67,Default,,0,0,0,,Эй... Уф.
Dialogue: 0,0:18:51.75,0:18:52.79,Default,,0,0,0,,Га
Dialogue: 0,0:18:52.88,0:18:54.55,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:52.88,0:18:54.55,Default,,0,0,0,,- (Жүгіріп) Бұл... - (Соноко) Бұл өтірік, солай ма?
Dialogue: 0,0:18:54.55,0:18:54.63,Default,,0,0,0,,- (Жүгіріп) Бұл... - (Соноко) Бұл өтірік, солай ма?
Dialogue: 0,0:18:54.63,0:18:55.80,Default,,0,0,0,,- (Жүгіріп) Бұл... - (Соноко) Бұл өтірік, солай ма?
Dialogue: 0,0:18:54.63,0:18:55.80,Default,,0,0,0,,28 сәуір 16:56.
Dialogue: 0,0:18:55.80,0:18:56.88,Default,,0,0,0,,28 сәуір 16:56.
Dialogue: 0,0:18:56.88,0:18:58.80,Default,,0,0,0,,28 сәуір 16:56
Dialogue: 0,0:18:56.88,0:18:58.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:58.88,0:19:01.30,Default,,0,0,0,,Эй, жібер!
Dialogue: 0,0:19:01.39,0:19:03.18,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:19:01.39,0:19:03.18,Default,,0,0,0,,Егер сіз зорлық-зомбылық жасасаңыз, айыптар тек өседі.
Dialogue: 0,0:19:03.18,0:19:03.26,Default,,0,0,0,,Егер сіз зорлық-зомбылық жасасаңыз, айыптар тек өседі.
Dialogue: 0,0:19:03.26,0:19:04.47,Default,,0,0,0,,Егер сіз зорлық-зомбылық жасасаңыз, айыптар тек өседі.
Dialogue: 0,0:19:03.26,0:19:04.47,Default,,0,0,0,,Эй, қарғыс атсын!
Dialogue: 0,0:19:04.56,0:19:05.18,Default,,0,0,0,,Менен аулақ жүр, эй!
Dialogue: 0,0:19:05.18,0:19:06.18,Default,,0,0,0,,Жібер, эй!
Dialogue: 0,0:19:05.18,0:19:06.18,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:19:06.27,0:19:08.77,Default,,0,0,0,,Когороның ағасы кінәлі болса
Dialogue: 0,0:19:08.85,0:19:11.90,Default,,0,0,0,,Саммит өтетін орынды жаруға не себеп болды?
Dialogue: 0,0:19:11.98,0:19:13.52,Default,,0,0,0,,Иә, не үшін?
Dialogue: 0,0:19:13.61,0:19:16.36,Default,,0,0,0,,Біз бұл туралы сұхбат кезінде де сұраймыз.
Dialogue: 0,0:19:16.44,0:19:17.53,Default,,0,0,0,,Эй, күте тұр, эй!
Dialogue: 0,0:19:17.61,0:19:18.78,Default,,0,0,0,,Әке!
Dialogue: 0,0:19:18.86,0:19:21.49,Default,,0,0,0,,Сабыр ет, Ран, Кудо-кунға дереу хабарлас.
Dialogue: 0,0:19:21.57,0:19:23.37,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:19:25.16,0:19:26.49,Default,,0,0,0,,Мен жасаған болсам да...
Dialogue: 0,0:19:26.58,0:19:27.41,Default,,0,0,0,,(Ранның жылағаны)
Dialogue: 0,0:19:27.41,0:19:28.91,Default,,0,0,0,,(Ранның жылағаны)
Dialogue: 0,0:19:27.41,0:19:28.91,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:29.00,0:19:33.04,Default,,0,0,0,,Неге ол кісі осындай уақытта келмейді?
Dialogue: 0,0:19:33.13,0:19:34.00,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:19:36.75,0:19:38.09,Default,,0,0,0,,Қарғыс атсын хаха
Dialogue: 0,0:19:38.17,0:19:42.72,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:19:42.80,0:19:47.14,Default,,0,0,0,,Шашың байланған екен.
Dialogue: 0,0:19:58.15,0:19:59.90,Default,,0,0,0,,Бұл қоғамдық қауіпсіздіктің детективі, солай ма?
Dialogue: 0,0:20:01.82,0:20:04.28,Default,,0,0,0,,Енді мен білмеймін бе?
Dialogue: 0,0:20:04.36,0:20:08.29,Default,,0,0,0,,Детектив Казами де, Амуро да жараланған.
Dialogue: 0,0:20:09.04,0:20:12.37,Default,,0,0,0,,Жарылыс болған жерде Амуро мырза да болды.
Dialogue: 0,0:20:13.12,0:20:15.08,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды білмеймін.
Dialogue: 0,0:20:15.17,0:20:17.75,Default,,0,0,0,,Сіз саммит өтетін орынды алдын ала қарап шықтыңыз, солай ма?
Dialogue: 0,0:20:18.59,0:20:21.38,Default,,0,0,0,,Мен терроризмнің болуы мүмкін екенін сол кезде сезгеніме сенімдімін.
Dialogue: 0,0:20:22.17,0:20:25.89,Default,,0,0,0,,Бірақ қазіргі жағдай бойынша, жарылыс жазатайым оқиға ретінде қарастырылады.
Dialogue: 0,0:20:25.97,0:20:29.14,Default,,0,0,0,,Сонда олар күдікті жасады, солай емес пе?
Dialogue: 0,0:20:31.23,0:20:33.98,Default,,0,0,0,,Егер Амуро мырзаға немесе полиция қызметкеріне ұнаса
Dialogue: 0,0:20:34.06,0:20:35.85,Default,,0,0,0,,Компьютерді бұрмалау
Dialogue: 0,0:20:35.94,0:20:38.65,Default,,0,0,0,,Оқиға орнында саусақ іздерін қалдыруға болмайды ма?
Dialogue: 0,0:20:39.23,0:20:40.69,Default,,0,0,0,,Полиция
Dialogue: 0,0:20:40.78,0:20:43.24,Default,,0,0,0,,Дәлелсіз әңгімемен айналыспаймын.
Dialogue: 0,0:20:43.32,0:20:45.16,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:20:49.12,0:20:51.50,Default,,0,0,0,,Бұл менің өмірім үшін қымбат болса да
Dialogue: 0,0:20:51.58,0:20:54.87,Default,,0,0,0,,Өйткені біз қорғауымыз керек нәрселер бар.
Dialogue: 0,0:20:54.96,0:20:56.00,Default,,0,0,0,,Ах
Dialogue: 0,0:21:00.42,0:21:04.22,Default,,0,0,0,,Бұл жолы Амуро мырза жау болуы мүмкін.
Dialogue: 0,0:21:06.89,0:21:07.93,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:08.01,0:21:10.93,Default,,0,0,0,,Неге әкеңді қорғамайсың?
Dialogue: 0,0:21:11.01,0:21:15.60,Default,,0,0,0,,Шынымен оны ағай жарып жіберді деп ойлайсыз ба?
Dialogue: 0,0:21:15.69,0:21:17.73,Default,,0,0,0,,Сіз ол адамға олай жасай алмайсыз.
Dialogue: 0,0:21:17.81,0:21:20.15,Default,,0,0,0,,Сонда неге...
Dialogue: 0,0:21:21.36,0:21:24.99,Default,,0,0,0,,Адвокаттар отбасы мүшелерінің мүддесін қорғамайды.
Dialogue: 0,0:21:25.07,0:21:30.24,Default,,0,0,0,,Өйткені судьяның объективтілік жоқ деп пайымдау мүмкіндігі жоғары.
Dialogue: 0,0:21:30.33,0:21:33.79,Default,,0,0,0,,Басқаша айтқанда, егер мен ол адамның қорғауын қабылдасам,
Dialogue: 0,0:21:33.87,0:21:36.67,Default,,0,0,0,,Бұл шын мәнінде сізге қарсы жұмыс істеуі мүмкін.
Dialogue: 0,0:21:36.75,0:21:38.42,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:38.50,0:21:42.55,Default,,0,0,0,,Уайымдамаңыз, мен жақын арада жақсы адвокат табамын.
Dialogue: 0,0:21:44.55,0:21:46.13,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:46.22,0:21:48.89,Default,,0,0,0,,Фуруя мырза айтқандай болды.
Dialogue: 0,0:21:49.39,0:21:51.30,Default,,0,0,0,,Егер мен ертерек білсем
Dialogue: 0,0:21:51.39,0:21:53.89,Default,,0,0,0,,々 …
Dialogue: 0,0:21:54.77,0:21:58.52,Default,,0,0,0,,...
Dialogue: 0,0:21:58.60,0:22:00.48,Default,,0,0,0,,Қазіргі уақытта біз
Dialogue: 0,0:22:00.56,0:22:03.40,Default,,0,0,0,,...
Dialogue: 0,0:22:03.48,0:22:06.03,Default,,0,0,0,,...
Dialogue: 0,0:22:06.53,0:22:08.49,Default,,0,0,0,,Фуруя мырза ше?
Dialogue: 0,0:22:08.57,0:22:12.08,Default,,0,0,0,,Біз оқиға орнында газ клапанына қол жеткізген коммуникацияларды зерттеп жатырмыз.
Dialogue: 0,0:22:12.66,0:22:15.45,Default,,0,0,0,,...
Dialogue: 0,0:22:15.54,0:22:16.75,Default,,0,0,0,,Не ол?
Dialogue: 0,0:22:16.83,0:22:21.25,Default,,0,0,0,,...
Dialogue: 0,0:22:21.33,0:22:22.54,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:22:23.21,0:22:24.80,Default,,0,0,0,,Мысал не болып жатыр?
Dialogue: 0,0:22:24.88,0:22:27.80,Default,,0,0,0,,Иә, 2291— енгізіңіз
Dialogue: 0,0:22:27.88,0:22:29.72,Default,,0,0,0,,Ұйымдастырылған
Dialogue: 0,0:22:31.30,0:22:32.47,Default,,0,0,0,,Ах
Dialogue: 0,0:22:32.97,0:22:33.81,Default,,0,0,0,,Фуруя мырза?
Dialogue: 0,0:22:34.64,0:22:35.72,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:22:43.23,0:22:44.07,Default,,0,0,0,,Бұл дегеніміз…
Dialogue: 0,0:22:44.15,0:22:45.57,Default,,0,0,0,,-（） -（）…
Dialogue: 0,0:22:45.65,0:22:47.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:47.15,0:22:48.99,Default,,0,0,0,,Бұл дегеніміз
Dialogue: 0,0:22:49.57,0:22:51.70,Default,,0,0,0,,Когоро Моуридің компьютерінен
Dialogue: 0,0:22:51.78,0:22:55.95,Default,,0,0,0,,Оқиға орнындағы газ клапанына қол жеткізілгенін дәлелдеді ме?
Dialogue: 0,0:22:56.04,0:22:57.33,Default,,0,0,0,,Иә
Dialogue: 0,0:22:57.41,0:23:01.29,Default,,0,0,0,,Бұл туралы Киберқылмысты бақылау бөлімі хабарлады
Dialogue: 0,0:23:01.38,0:23:03.09,Default,,0,0,0,,Шешілді.
Dialogue: 0,0:23:03.17,0:23:05.21,Default,,0,0,0,,Когоро Моури осы жерге жасырын кіріп келді.
Dialogue: 0,0:23:05.30,0:23:08.72,Default,,0,0,0,,Біз бұл есікті ашып, жоғары вольтты кабельді орнаттық.
Dialogue: 0,0:23:08.80,0:23:10.22,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:23:10.30,0:23:13.89,Default,,0,0,0,,Бұл жағдайда Моури қауіпсіздік камерасынан көрінуі керек еді.
Dialogue: 0,0:23:13.97,0:23:15.26,Default,,0,0,0,,-（）  -（）
Dialogue: 0,0:23:15.35,0:23:18.18,Default,,0,0,0,,Неліктен сайтта интернет кеше ғана болды?
Dialogue: 0,0:23:18.18,0:23:19.02,Default,,0,0,0,,...
Dialogue: 0,0:23:18.18,0:23:19.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:19.10,0:23:20.77,Default,,0,0,0,,Бізбен бірге жүр!
Dialogue: 0,0:23:20.85,0:23:23.02,Default,,0,0,0,,Жауап алу кезінде олар не айтты?
Dialogue: 0,0:23:23.11,0:23:25.82,Default,,0,0,0,,Когоро Моури теріске шығаруды жалғастырады
Dialogue: 0,0:23:25.90,0:23:28.19,Default,,0,0,0,,Сіз оны жоққа шығарсаңыз да, істі прокурорларға жібере аласыз.
Dialogue: 0,0:23:28.28,0:23:30.78,Default,,0,0,0,,Сіз оның себебін білмесеңіз де, прокурорларға жібересіз бе?
Dialogue: 0,0:23:30.86,0:23:33.62,Default,,0,0,0,,Егер дәлелдер жиналса, прокурорларға жіберіңіз
Dialogue: 0,0:23:34.24,0:23:35.20,Default,,0,0,0,,Полиция қызметкері ретінде бұл заңдылық.
Dialogue: 0,0:23:35.20,0:23:36.95,Default,,0,0,0,,Полиция қызметкері ретінде бұл заңдылық.
Dialogue: 0,0:23:35.20,0:23:36.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:37.04,0:23:39.62,Default,,0,0,0,,Күте тұрыңыз! Мені бір нәрсе ұстайды
Dialogue: 0,0:23:39.70,0:23:41.12,Default,,0,0,0,,Олар Жапонияда, анамды күтіп, оны қауіпсіз ұстап отыр ➡
Dialogue: 0,0:23:41.21,0:23:44.54,Default,,0,0,0,,«Мені бірдеңе мазалайды, бірдеңе дұрыс емес»
Dialogue: 0,0:23:44.63,0:23:47.13,Default,,0,0,0,,Осы көптеген тергеушілер әрекет етеді деп ойлайсыз ба?
Dialogue: 0,0:23:47.21,0:23:49.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:49.63,0:23:51.55,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:23:52.34,0:23:53.51,Default,,0,0,0,,Иә
Dialogue: 0,0:23:54.47,0:23:55.68,Default,,0,0,0,,Я...
Dialogue: 0,0:23:56.56,0:24:00.18,Default,,0,0,0,,Сонда... неге мені ешкім қорғамайды?
Dialogue: 0,0:24:00.27,0:24:01.81,Default,,0,0,0,,Бұл үлкен оқиға болғандықтан ба?
Dialogue: 0,0:24:01.89,0:24:05.27,Default,,0,0,0,,Иә, және күдікті қорғайды
Dialogue: 0,0:24:05.36,0:24:08.44,Default,,0,0,0,,Ол «Ұйқыдағы Когоро» деген атақты адам.
Dialogue: 0,0:24:08.53,0:24:11.36,Default,,0,0,0,,Ешбір заңгер қымсынбауы керек.
Dialogue: 0,0:24:12.03,0:24:12.28,Default,,0,0,0,,Я...
Dialogue: 0,0:24:12.28,0:24:13.11,Default,,0,0,0,,Я...
Dialogue: 0,0:24:12.28,0:24:13.11,Default,,0,0,0,,
Dialogue: 0,0:24:13.11,0:24:13.20,Default,,0,0,0,,
Dialogue: 0,0:24:13.20,0:24:13.86,Default,,0,0,0,,
Dialogue: 0,0:24:13.20,0:24:13.86,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:24:13.86,0:24:13.95,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:24:13.95,0:24:14.78,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:24:13.95,0:24:14.78,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:24:14.87,0:24:16.49,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:24:16.58,0:24:17.66,Default,,0,0,0,,Ширатори инспектор!
Dialogue: 0,0:24:18.41,0:24:22.25,Default,,0,0,0,,Жаңалық болмас бұрын айтып беруім керек деп ойладым.
Dialogue: 0,0:24:22.33,0:24:23.17,Default,,0,0,0,,Не?
Dialogue: 0,0:24:24.04,0:24:25.58,Default,,0,0,0,,Моури мырза...
Dialogue: 0,0:24:26.25,0:24:27.34,Default,,0,0,0,,Прокурорларға жіберілді
Dialogue: 0,0:24:27.42,0:24:28.84,Default,,0,0,0,,- (Жүгіріп) Ха! -Уф
Dialogue: 0,0:24:28.92,0:24:31.63,Default,,0,0,0,,Істі прокуратураға жіберу үшін жеткілікті дәлелдеме бар ма?
Dialogue: 0,0:24:31.72,0:24:34.05,Default,,0,0,0,,Оқиға орнынан Мори мырзаның саусақ іздері табылды
Dialogue: 0,0:24:34.13,0:24:36.14,Default,,0,0,0,,Компьютерде болған сайттың еден жоспары
Dialogue: 0,0:24:36.22,0:24:40.89,Default,,0,0,0,,Саммит күнтізбесі және жанғыш материалдарға кіру журналы
Dialogue: 0,0:24:41.52,0:24:44.06,Default,,0,0,0,,А... Прокуратураға жіберуге жетеді.
Dialogue: 0,0:24:44.14,0:24:47.61,Default,,0,0,0,,Неліктен әкем...
Dialogue: 0,0:24:47.69,0:24:49.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:24:50.19,0:24:51.40,Default,,0,0,0,,Ішек
Dialogue: 0,0:24:53.45,0:24:55.07,Default,,0,0,0,,Анам…
Dialogue: 0,0:24:55.16,0:24:56.07,Default,,0,0,0,,Күте тұр, жүгірді.
Dialogue: 0,0:24:56.95,0:24:59.66,Default,,0,0,0,,Мен қартқа міндетті түрде көмектесемін.
Dialogue: 0,0:25:03.00,0:25:03.83,Default,,0,0,0,,Дәрігер!
Dialogue: 0,0:25:03.91,0:25:05.21,Default,,0,0,0,,Оны таптыңыз ба?
Dialogue: 0,0:25:05.29,0:25:07.54,Default,,0,0,0,,О, келдің бе?
Dialogue: 0,0:25:07.63,0:25:08.79,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:25:11.34,0:25:14.47,Default,,0,0,0,,Бұл бомбаға ұқсайды.
Dialogue: 0,0:25:14.55,0:25:19.22,Default,,0,0,0,,Сіз маған шашылған қоқыстарды суретке түсіруді сұрадыңыз, солай ма?
Dialogue: 0,0:25:19.30,0:25:24.23,Default,,0,0,0,,Суреттер басқатырғыш сияқты біріктіріліп, қайта құрастырылды.
Dialogue: 0,0:25:25.31,0:25:28.90,Default,,0,0,0,,Енді бомбаның түрін анықтау
Dialogue: 0,0:25:28.98,0:25:33.40,Default,,0,0,0,,Ай-кун оны интернеттегі барлық суреттермен сәйкестендіреді.
Dialogue: 0,0:25:34.53,0:25:35.45,Default,,0,0,0,,Жарайды
Dialogue: 0,0:25:36.15,0:25:38.28,Default,,0,0,0,,Иә, сәйкестік болды.
Dialogue: 0,0:25:38.37,0:25:40.08,Default,,0,0,0,,- (Ағаса) А? -Не?
Dialogue: 0,0:25:40.16,0:25:41.87,Default,,0,0,0,,Мен сізге толық мәлімет беремін.
Dialogue: 0,0:25:46.41,0:25:49.17,Default,,0,0,0,,IoT қысымды ыдыс?
Dialogue: 0,0:25:49.25,0:25:52.09,Default,,0,0,0,,«Кәстрөл тәрізді тамаша қысымды пеш»
Dialogue: 0,0:25:52.75,0:25:56.63,Default,,0,0,0,,«Смартфоныңыздан жай ғана қысымды, температураны және уақытты орнатыңыз»
Dialogue: 0,0:25:56.72,0:25:58.59,Default,,0,0,0,,«Сорпа пісіре алады, т.б.».
Dialogue: 0,0:25:58.68,0:25:59.55,Default,,0,0,0,,...өйткені
Dialogue: 0,0:25:59.64,0:26:00.85,Default,,0,0,0,,Ас әзірлеу?
Dialogue: 0,0:26:00.93,0:26:03.10,Default,,0,0,0,,Қысымды қазандарға қосымша
Dialogue: 0,0:26:03.18,0:26:07.60,Default,,0,0,0,,Қуыруға арналған табалар, кәстрөлдер, ыдыс-аяқтар да шашылып жатты.
Dialogue: 0,0:26:07.69,0:26:13.11,Default,,0,0,0,,Жарылыс мекеме ішіндегі мейрамхананың асханасында болған көрінеді.
Dialogue: 0,0:26:13.19,0:26:14.94,Default,,0,0,0,,-Не! -(Хайбара) А?
Dialogue: 0,0:26:15.03,0:26:17.03,Default,,0,0,0,,Бұл бомба емес!
Dialogue: 0,0:26:17.11,0:26:18.11,Default,,0,0,0,,- (Агаса) Міне! -Ах
Dialogue: 0,0:26:18.20,0:26:21.57,Default,,0,0,0,,Сіз маған жарылғыш заттарды іздеуді сұрадыңыз.
Dialogue: 0,0:26:21.66,0:26:24.74,Default,,0,0,0,,Айкүн де осылай тынбай еңбек етіп жүр.
Dialogue: 0,0:26:24.83,0:26:27.87,Default,,0,0,0,,Бұл сізге ұқсамайды.
Dialogue: 0,0:26:29.79,0:26:31.46,Default,,0,0,0,,Окабе?
Dialogue: 0,0:26:31.54,0:26:34.00,Default,,0,0,0,,Не болды? Бірдеңе болды ма?
Dialogue: 0,0:26:34.09,0:26:38.26,Default,,0,0,0,,Когороның ағасы прокуратураға жіберілді
Dialogue: 0,0:26:38.34,0:26:39.88,Default,,0,0,0,,- (Хайбара) Ах - (Ағаса) Иә.
Dialogue: 0,0:26:45.35,0:26:47.77,Default,,0,0,0,,А... аа
Dialogue: 0,0:26:48.35,0:26:49.77,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:26:49.85,0:26:52.15,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:26:52.23,0:26:54.90,Default,,0,0,0,,Сондықтан мен, Сакако Тачибана.
Dialogue: 0,0:26:54.98,0:26:57.74,Default,,0,0,0,,Ұйықтап жатқан Когороны қорғауға рұқсат етіңіз.
Dialogue: 0,0:27:00.28,0:27:02.99,Default,,0,0,0,,Бұл мен осы уақытқа дейін қараған істерім.
Dialogue: 0,0:27:03.49,0:27:07.37,Default,,0,0,0,,Иә? Ниджоин университетіндегі экстремистік оқиға
Dialogue: 0,0:27:07.45,0:27:09.66,Default,,0,0,0,,Экономика, сауда және өнеркәсіп министрлігі тыңшылық ісі
Dialogue: 0,0:27:10.37,0:27:12.42,Default,,0,0,0,,Қоғамдық қауіпсіздікке қатысты оқиғалар көп.
Dialogue: 0,0:27:12.50,0:27:15.80,Default,,0,0,0,,Аа, бұл жағдай үшін өте қолайлы...
Dialogue: 0,0:27:15.88,0:27:18.63,Default,,0,0,0,,Сонымен, сіздің апаңыздың сотының нәтижесі қандай болды?
Dialogue: 0,0:27:18.72,0:27:20.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:20.88,0:27:23.97,Default,,0,0,0,,Сіз қиын сөздер білесіз бе?
Dialogue: 0,0:27:24.05,0:27:25.60,Default,,0,0,0,,Мен бәрін жоғалтып жатырмын
Dialogue: 0,0:27:25.68,0:27:26.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:27.06,0:27:28.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:28.31,0:27:31.98,Default,,0,0,0,,А, бірақ қоғамдық қауіпсіздік жағдайлары қиын, солай емес пе?
Dialogue: 0,0:27:32.06,0:27:35.23,Default,,0,0,0,,Иә Прокурорлар қозғаған істердің табыстылығы қандай?
Dialogue: 0,0:27:35.32,0:27:37.40,Default,,0,0,0,,Өздеріңіз білетіндей, 90%-дан астам
Dialogue: 0,0:27:37.48,0:27:40.15,Default,,0,0,0,,Егер бұл қоғамдық қауіпсіздік оқиғасы болса, баға жоғарырақ болады.
Dialogue: 0,0:27:40.24,0:27:43.24,Default,,0,0,0,,Басқаша айтқанда, сізде жеңу мүмкін емес.
Dialogue: 0,0:27:43.32,0:27:45.03,Default,,0,0,0,,Бірақ мен К-бенмін, сондықтан
Dialogue: 0,0:27:45.12,0:27:46.41,Default,,0,0,0,,Қабен?
Dialogue: 0,0:27:46.49,0:27:49.50,Default,,0,0,0,,Ұялы телефоннан кеңсеңіз және жұмысыңыз жоқ—
Dialogue: 0,0:27:49.58,0:27:51.92,Default,,0,0,0,,штаттан тыс заңгер.
Dialogue: 0,0:27:52.00,0:27:54.29,Default,,0,0,0,,Сондықтан қолайсыз сот болса да біз мұны істеуіміз керек.
Dialogue: 0,0:27:54.38,0:27:57.55,Default,,0,0,0,,Ендеше әкеңді қорға.
Dialogue: 0,0:27:57.63,0:27:59.55,Default,,0,0,0,,Сіз заңгер іздеп жүрсіз бе?
Dialogue: 0,0:27:59.63,0:28:03.47,Default,,0,0,0,,Мен мұны адвокаттар алқасында естідім. Маған орындауға рұқсат етіңізші.
Dialogue: 0,0:28:03.55,0:28:05.26,Default,,0,0,0,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,0:28:05.35,0:28:07.97,Default,,0,0,0,,А, эй... сәл күте тұрыңыз.
Dialogue: 0,0:28:08.72,0:28:10.48,Default,,0,0,0,,Жоқ, мама.
Dialogue: 0,0:28:10.56,0:28:13.14,Default,,0,0,0,,Бұл адвокаттың жеңіске деген ниеті жоқ.
Dialogue: 0,0:28:13.23,0:28:14.98,Default,,0,0,0,,Әрине жоқ
Dialogue: 0,0:28:15.56,0:28:17.11,Default,,0,0,0,,Бірақ сіз нашар заңгер сияқтысыз, сондықтан айыптау жағы сізді кінәлауы мүмкін.
Dialogue: 0,0:28:17.11,0:28:18.36,Default,,0,0,0,,Бірақ сіз нашар адвокат сияқтысыз, сондықтан айыптау жағы сізді кінәлайтын шығар.
Dialogue: 0,0:28:17.11,0:28:18.36,Default,,0,0,0,,О.
Dialogue: 0,0:28:18.36,0:28:20.11,Default,,0,0,0,,Бірақ сіз нашар адвокат сияқтысыз, сондықтан айыптау жағы сізді кінәлайтын шығар.
Dialogue: 0,0:28:20.19,0:28:22.15,Default,,0,0,0,,Сіз бұлай жеңе алмайсыз.
Dialogue: 0,0:28:22.24,0:28:24.70,Default,,0,0,0,,Мемлекеттік қорғаушыдан сұраған дұрыс
Dialogue: 0,0:28:24.78,0:28:26.70,Default,,0,0,0,,Осылайша мені тоқтатпайды.
Dialogue: 0,0:28:26.78,0:28:27.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:27.91,0:28:31.12,Default,,0,0,0,,Бірақ егер ол сол адам болса, мен айта аламын.
Dialogue: 0,0:28:31.20,0:28:34.12,Default,,0,0,0,,Ах... тіпті егер...
Dialogue: 0,0:28:34.21,0:28:34.79,Default,,0,0,0,,Мен уайымнан басқа ештеңе сезбеймін.
Dialogue: 0,0:28:34.79,0:28:36.13,Default,,0,0,0,,Мен уайымнан басқа ештеңе сезбеймін.
Dialogue: 0,0:28:34.79,0:28:36.13,Default,,0,0,0,,Мына мысықтың аты кім?
Dialogue: 0,0:28:36.13,0:28:36.79,Default,,0,0,0,,Мына мысықтың аты кім?
Dialogue: 0,0:28:36.88,0:28:37.88,Default,,0,0,0,,Бұл Горо-чан.
Dialogue: 0,0:28:42.84,0:28:47.43,Default,,0,0,0,,Мен сіздің полицияға одан бас тартуды жалғастырғаныңызды естідім.
Dialogue: 0,0:28:47.51,0:28:50.81,Default,,0,0,0,,Әрине мен ештеңе істеген жоқпын.
Dialogue: 0,0:28:50.89,0:28:54.73,Default,,0,0,0,,Бірақ сіз кінәлі екеніңізге ешқандай дәлел жоқ.
Dialogue: 0,0:28:54.81,0:28:56.27,Default,,0,0,0,,Өте көп
Dialogue: 0,0:28:56.35,0:28:59.07,Default,,0,0,0,,Мен мұны түсінбеймін, прокурор.
Dialogue: 0,0:28:59.15,0:29:01.94,Default,,0,0,0,,Мен тек біреу мені жақтады деп ойлаймын.
Dialogue: 0,0:29:03.40,0:29:04.86,Default,,0,0,0,,Бұл жарылыс оқиғасы
Dialogue: 0,0:29:04.95,0:29:07.37,Default,,0,0,0,,Аудандық қоғамдық қауіпсіздік бөлімінің прокуроры Құсақабе
Dialogue: 0,0:29:07.45,0:29:09.49,Default,,0,0,0,,Мен жауаптымын
Dialogue: 0,0:29:09.58,0:29:11.16,Default,,0,0,0,,О, бұл қорқынышты.
Dialogue: 0,0:29:11.24,0:29:14.75,Default,,0,0,0,,Мен қоғамдық қауіпсіздік істерін сирек қорғасам да,
Dialogue: 0,0:29:14.83,0:29:16.25,Default,,0,0,0,,Мен сенің атыңды білемін.
Dialogue: 0,0:29:16.33,0:29:18.79,Default,,0,0,0,,Сіз шынымен де соншалықты керемет прокурорсыз ба?
Dialogue: 0,0:29:19.42,0:29:23.47,Default,,0,0,0,,Дәл доктор Хи сияқты ол ешқашан жеңілмейтін білікті прокурор.
Dialogue: 0,0:29:24.26,0:29:25.97,Default,,0,0,0,,Сіз маған мүлдем қарама-қайшысыз.
Dialogue: 0,0:29:26.59,0:29:27.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:29:29.10,0:29:31.97,Default,,0,0,0,,А, мен бұл оқиғаны білемін.
Dialogue: 0,0:29:32.06,0:29:33.85,Default,,0,0,0,,NAZU рұқсатсыз кіру оқиғасы
Dialogue: 0,0:29:33.93,0:29:38.02,Default,,0,0,0,,НАЗУ Америкада ғарышты игерумен айналысады.
Dialogue: 0,0:29:38.10,0:29:39.31,Default,,0,0,0,,Сол атақты?
Dialogue: 0,0:29:39.40,0:29:44.24,Default,,0,0,0,,Аа, өткен жылы ойын компаниясының қызметкері оған көңіл көтеру үшін кірген оқиға болды.
Dialogue: 0,0:29:45.15,0:29:47.57,Default,,0,0,0,,Ол кездегі прокурор да Құсақабе мырза болатын.
Dialogue: 0,0:29:47.66,0:29:49.24,Default,,0,0,0,,Сот сонымен қатар...
Dialogue: 0,0:29:49.32,0:29:52.24,Default,,0,0,0,,Әрине мен жеңілдім.
Dialogue: 0,0:29:52.33,0:29:54.00,Default,,0,0,0,,Әрине...
Dialogue: 0,0:29:54.08,0:29:56.00,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:30:01.25,0:30:04.30,Default,,0,0,0,,Бұл бүгінгі жауап алудың нәтижесі.
Dialogue: 0,0:30:04.38,0:30:08.51,Default,,0,0,0,,Мен Когоро Моуридің жарылыс жасауға ешқандай себебі болмағанына алаңдаймын.
Dialogue: 0,0:30:09.55,0:30:11.05,Default,,0,0,0,,Хмм.
Dialogue: 0,0:30:12.10,0:30:14.39,Default,,0,0,0,,Мотив... Эй
Dialogue: 0,0:30:15.31,0:30:18.39,Default,,0,0,0,,Бірақ дәлелдер өте көп.
Dialogue: 0,0:30:18.48,0:30:20.15,Default,,0,0,0,,Айыптау қорытындысын ертең шығару керек емес пе?
Dialogue: 0,0:30:20.23,0:30:22.65,Default,,0,0,0,,Ах... бірақ
Dialogue: 0,0:30:22.73,0:30:26.65,Default,,0,0,0,,Мысалы, жарылыс орнындағы газ клапанына қол жеткізген.
Dialogue: 0,0:30:26.74,0:30:28.20,Default,,0,0,0,,Бұл жазба
Dialogue: 0,0:30:28.28,0:30:30.53,Default,,0,0,0,,Күдіктінің компьютері үшінші тұлғаға берілді
Dialogue: 0,0:30:30.62,0:30:33.20,Default,,0,0,0,,Ол релелік нүкте ретінде де қолданылған болуы мүмкін.
Dialogue: 0,0:30:33.83,0:30:36.66,Default,,0,0,0,,Содан кейін еден жоспары немесе кесте сияқты дәлелдерді келтіріңіз.
Dialogue: 0,0:30:36.75,0:30:37.71,Default,,0,0,0,,Компьютерде қалдырыңыз
Dialogue: 0,0:30:37.79,0:30:40.12,Default,,0,0,0,,Мен өзімнің кінәлі болу мүмкіндігімді толығымен қарастырдым...
Dialogue: 0,0:30:40.21,0:30:41.46,Default,,0,0,0,,Бас Құсақабе
Dialogue: 0,0:30:42.13,0:30:48.05,Default,,0,0,0,,Бұл дәлелді елемеу сіздің жеке болжамыңыз.
Dialogue: 0,0:30:48.13,0:30:52.39,Default,,0,0,0,,Директор Ивай, мен полицияға қосымша тергеу жүргіземін...
Dialogue: 0,0:30:52.47,0:30:55.27,Default,,0,0,0,,Когоро Моури қылмыстық жауапкершілікке тартылсын.
Dialogue: 0,0:30:56.14,0:31:00.31,Default,,0,0,0,,Бұл Қоғамдық қауіпсіздік министрлігінің шешімі, жарай ма?
Dialogue: 0,0:31:00.98,0:31:04.69,Default,,0,0,0,,Қоғамдық қауіпсіздік министрлігі дегеніміз не? Біз Прокуратурамыз ба?
Dialogue: 0,0:31:04.77,0:31:07.82,Default,,0,0,0,,Әлде Ұлттық полиция агенттігі ме?
Dialogue: 0,0:31:10.49,0:31:11.32,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:31:11.91,0:31:13.45,Default,,0,0,0,,Шығу.
Dialogue: 0,0:31:13.53,0:31:14.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:31:26.50,0:31:28.84,Default,,0,0,0,,Сізге қосымша тергеу қажет болды ма?
Dialogue: 0,0:31:28.92,0:31:31.09,Default,,0,0,0,,Прокурор Құсақабеге иә
Dialogue: 0,0:31:31.18,0:31:35.60,Default,,0,0,0,,Әкең сол тергеуде жауапқа тартылмайды екен...
Dialogue: 0,0:31:35.68,0:31:39.89,Default,,0,0,0,,No Қосымша тергеу прокурор Құсақабенің қарауында.
Dialogue: 0,0:31:39.98,0:31:42.35,Default,,0,0,0,,Қоғамдық қауіпсіздік полициясы қылмыстық қудалауды шешкен сияқты.
Dialogue: 0,0:31:42.44,0:31:45.90,Default,,0,0,0,,Күте тұрыңыз, неге полиция қудалауға араласады?
Dialogue: 0,0:31:45.98,0:31:49.11,Default,,0,0,0,,Полицияны прокурорлар қадағалауы керек
Dialogue: 0,0:31:49.19,0:31:53.32,Default,,0,0,0,,Ең бастысы, айыптау – прокурордың айрықша құзыреті...
Dialogue: 0,0:31:53.41,0:31:54.24,Default,,0,0,0,,Ах
Dialogue: 0,0:31:54.32,0:31:56.99,Default,,0,0,0,,Иә, дұрыс айтасыз.
Dialogue: 0,0:31:57.08,0:32:03.12,Default,,0,0,0,,Бірақ бұл прокуратураның азаматтық және қылмыстық істер жөніндегі бөлімшелері мен арнайы тергеу бөлімшелеріндегі жағдай.
Dialogue: 0,0:32:03.79,0:32:07.30,Default,,0,0,0,,Қоғамдық қауіпсіздік министрлігіне қатысты жағдай сәл басқаша.
Dialogue: 0,0:32:07.38,0:32:09.21,Default,,0,0,0,,Мұғалім де білуі керек.
Dialogue: 0,0:32:09.30,0:32:10.13,Default,,0,0,0,,Ах
Dialogue: 0,0:32:11.22,0:32:14.59,Default,,0,0,0,,А, мен түсіндім. Қоғамдық қауіпсіздік министрлігі деп атасаңыз да.
Dialogue: 0,0:32:15.39,0:32:20.35,Default,,0,0,0,,Елордалық полиция департаментінің, Ұлттық полиция агенттігінің және прокуратураның әрқайсысында өздерінің қоғамдық қауіпсіздік бөлімдері бар.
Dialogue: 0,0:32:21.02,0:32:24.27,Default,,0,0,0,,Полиция тергеу нәтижелерін прокуратураға жібереді.
Dialogue: 0,0:32:24.35,0:32:28.61,Default,,0,0,0,,Осыдан кейін прокуратура істі қайтадан тексереді.
Dialogue: 0,0:32:29.61,0:32:31.36,Default,,0,0,0,,Күдіктіні жауапқа тарту керек пе
Dialogue: 0,0:32:31.44,0:32:34.11,Default,,0,0,0,,Осы прокурордың тергеуіне негізделген
Dialogue: 0,0:32:34.20,0:32:37.37,Default,,0,0,0,,Шешімді әдетте прокурор қабылдайды.
Dialogue: 0,0:32:38.91,0:32:42.37,Default,,0,0,0,,Бірақ прокуратураның қоғамдық қауіпсіздік бөлімі басқа.
Dialogue: 0,0:32:43.41,0:32:44.54,Default,,0,0,0,,Ашығын айтқанда
Dialogue: 0,0:32:44.62,0:32:48.63,Default,,0,0,0,,Прокурорлар қамтамасыз ететін қоғамдық қауіпсіздік полиция қамтамасыз ететін қоғамдық қауіпсіздікке сәйкес келмейді.
Dialogue: 0,0:32:49.25,0:32:53.38,Default,,0,0,0,,Тергеушілер саны мен олардың ноу-хауында үлкен айырмашылық бар.
Dialogue: 0,0:32:54.22,0:32:59.14,Default,,0,0,0,,Сондықтан қылмыстық қудалау кезінде қоғамдық қауіпсіздікті ескеру қажет болатын кездер болады.
Dialogue: 0,0:32:59.22,0:33:02.02,Default,,0,0,0,,Қоғамдық қауіпсіздікті қарастыру
Dialogue: 0,0:33:02.64,0:33:05.69,Default,,0,0,0,,Әсіресе саммит өтетін жердегі жарылыс.
Dialogue: 0,0:33:05.77,0:33:09.27,Default,,0,0,0,,Қоғамдық қауіпсіздік полициясының бетіне балшық жағуға да қатысты.
Dialogue: 0,0:33:09.98,0:33:14.03,Default,,0,0,0,,Зарядтарды әкелу қысымын елестету оңай.
Dialogue: 0,0:33:14.11,0:33:16.53,Default,,0,0,0,,Олай болса, әкең...
Dialogue: 0,0:33:18.03,0:33:20.28,Default,,0,0,0,,Иә, сізді жауапқа тартатыныңызға сенімдімін.
Dialogue: 0,0:33:20.37,0:33:22.37,Default,,0,0,0,,Бұл...
Dialogue: 0,0:33:24.00,0:33:28.13,Default,,0,0,0,,Бұл адвокат қылмыстық қудалауды қалайтын сияқты.
Dialogue: 0,0:33:31.80,0:33:33.26,Default,,0,0,0,,Когоро ағасының компьютері
Dialogue: 0,0:33:33.34,0:33:36.88,Default,,0,0,0,,Біз сізді біреудің айла-шарғы жасау мүмкіндігін зерттеп жатырмыз, солай ма?
Dialogue: 0,0:33:36.97,0:33:39.18,Default,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:33:39.26,0:33:44.06,Default,,0,0,0,,Құсақабе прокуроры қосымша тергеу жүргізуімді сұрады.
Dialogue: 0,0:33:44.14,0:33:46.19,Default,,0,0,0,,Маған мүмкіндігінше айтып беріңізші.
Dialogue: 0,0:33:46.81,0:33:49.69,Default,,0,0,0,,Шиничи-чан Когораның ағасына көмектесу үшін
Dialogue: 0,0:33:49.77,0:33:52.57,Default,,0,0,0,,Мен кез келген ақпарат алғым келеді.
Dialogue: 0,0:33:52.65,0:33:54.03,Default,,0,0,0,,-(Амуро) Мори мырза... -Иә?
Dialogue: 0,0:33:54.11,0:33:55.99,Default,,0,0,0,,Не болды?
Dialogue: 0,0:33:56.74,0:33:57.66,Default,,0,0,0,,Амуро-кун
Dialogue: 0,0:33:58.78,0:33:59.66,Default,,0,0,0,,Сіз мұны естідіңіз бе?
Dialogue: 0,0:33:59.74,0:34:01.20,Default,,0,0,0,,Қый!
Dialogue: 0,0:34:01.28,0:34:03.16,Default,,0,0,0,,Мен Моури мырза үшін алаңдаймын.
Dialogue: 0,0:34:03.75,0:34:06.58,Default,,0,0,0,,Мен жаңа ғана Пуародан сыйлық әкелдім.
Dialogue: 0,0:34:06.66,0:34:10.25,Default,,0,0,0,,А, Моури-кун енді жоқ.
Dialogue: 0,0:34:10.33,0:34:14.76,Default,,0,0,0,,Егер сізді прокуратураға жіберсе, сізді әдетте уақытша ұстау изоляторына апарады.
Dialogue: 0,0:34:14.84,0:34:17.47,Default,,0,0,0,,Амуро-сан білмеуі мүмкін емес, солай ма?
Dialogue: 0,0:34:17.55,0:34:19.97,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:34:20.05,0:34:22.26,Default,,0,0,0,,Сіз бұрынғыдай білімдісіз.
Dialogue: 0,0:34:22.35,0:34:24.10,Default,,0,0,0,,О, және
Dialogue: 0,0:34:24.18,0:34:27.27,Default,,0,0,0,,Сіз мұндай заттарды уақытша ұстау изоляторына әкеле алмайсыз.
Dialogue: 0,0:34:28.10,0:34:29.77,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:34:30.61,0:34:32.48,Default,,0,0,0,,Сіз нені мақсат етесіз?
Dialogue: 0,0:34:32.57,0:34:33.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:37.86,0:34:40.11,Default,,0,0,0,,2291 Сәтті тапсыру
Dialogue: 0,0:34:40.62,0:34:44.24,Default,,0,0,0,,Не? Сіз Амуро-санға не айттыңыз?
Dialogue: 0,0:34:44.33,0:34:45.16,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:34:46.04,0:34:47.00,Default,,0,0,0,,- Сәлем, детектив! -(Казами) Ах.
Dialogue: 0,0:34:47.62,0:34:51.42,Default,,0,0,0,,Өтінемін, ағамнан алған компьютеріңізді маған қайтарып беріңізші!
Dialogue: 0,0:34:51.50,0:34:54.71,Default,,0,0,0,,Оған менің сүйікті ойындарым да кіреді!
Dialogue: 0,0:34:54.80,0:34:55.84,Default,,0,0,0,,Бұл дәлел. Мен оны әлі қайтара алмаймын.
Dialogue: 0,0:34:55.84,0:34:58.05,Default,,0,0,0,,Бұл дәлел. Мен оны әлі қайтара алмаймын.
Dialogue: 0,0:34:55.84,0:34:58.05,Default,,0,0,0,,Қайтарыңыз...
Dialogue: 0,0:34:58.13,0:35:01.18,Default,,0,0,0,,Эй, Конан-кун, тоқтат.
Dialogue: 0,0:35:01.26,0:35:05.85,Default,,0,0,0,,Бұл бағдарламалық құрал болса да, доктор.
Dialogue: 0,0:35:12.73,0:35:16.40,Default,,0,0,0,,Аа, Конан-кун, мен саған көп қоңырау шалдым.
Dialogue: 0,0:35:16.48,0:35:18.28,Default,,0,0,0,,Ғибадатхана қыз-қызметшісінің киімі оған жарасады.
Dialogue: 0,0:35:19.70,0:35:20.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:21.32,0:35:23.24,Default,,0,0,0,,Батарея бітті.
Dialogue: 0,0:35:23.32,0:35:25.58,Default,,0,0,0,,Онымен зарядтай аласыз ба?
Dialogue: 0,0:35:25.66,0:35:27.83,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:35:31.62,0:35:34.54,Default,,0,0,0,,Менде әдетте көбірек батарея болады.
Dialogue: 0,0:35:35.17,0:35:37.05,Default,,0,0,0,,Сонда мені неге шақырдың?
Dialogue: 0,0:35:37.13,0:35:39.80,Default,,0,0,0,,Іс материалдары жақын арада келеді.
Dialogue: 0,0:35:39.88,0:35:42.72,Default,,0,0,0,,Ран оны Конанның да көргенін қалайды.
Dialogue: 0,0:35:43.47,0:35:47.10,Default,,0,0,0,,Өйткені Конан жиі қызықты нәрселерді табады.
Dialogue: 0,0:35:47.18,0:35:52.15,Default,,0,0,0,,Сонымен қатар, бірдеңе болып қалса, Шиничиге айта аласыз.
Dialogue: 0,0:35:52.23,0:35:55.48,Default,,0,0,0,,Иә, Шиничи-чанға міндетті түрде айтыңыз.
Dialogue: 0,0:35:56.19,0:35:58.61,Default,,0,0,0,,Рахмет, Конан-кун.
Dialogue: 0,0:35:59.78,0:36:01.15,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:36:01.95,0:36:04.28,Default,,0,0,0,,Айыптаушы тарап сұраған дәлелдемелер
Dialogue: 0,0:36:04.37,0:36:06.03,Default,,0,0,0,,Сіз нені айтасыз...
Dialogue: 0,0:36:06.87,0:36:08.79,Default,,0,0,0,,Ағаңызды айыптау туралы шешім қабылданды ма?
Dialogue: 0,0:36:08.87,0:36:11.21,Default,,0,0,0,,Прокурор жақында сізге айып тағатындарын айтады.
Dialogue: 0,0:36:11.29,0:36:13.21,Default,,0,0,0,,Маған хабарласты.
Dialogue: 0,0:36:14.08,0:36:15.54,Default,,0,0,0,,Әкем
Dialogue: 0,0:36:16.17,0:36:19.88,Default,,0,0,0,,Уайымдама, мен саған міндетті түрде көмектесемін.
Dialogue: 0,0:36:19.96,0:36:21.84,Default,,0,0,0,,- (Эри) Онда - (Сайко) Иә.
Dialogue: 0,0:36:22.59,0:36:25.34,Default,,0,0,0,,Мәлімдеме жазбасы Оқиға орнындағы сараптамалық есеп
Dialogue: 0,0:36:25.97,0:36:28.47,Default,,0,0,0,,Қылмыс орнындағы фотосуреттер.
Dialogue: 0,0:36:28.56,0:36:30.35,Default,,0,0,0,,Аа, үлкен сома.
Dialogue: 0,0:36:30.43,0:36:33.73,Default,,0,0,0,,Хм, мен бір анықтама табуым керек.
Dialogue: 0,0:36:33.81,0:36:36.86,Default,,0,0,0,,Тәтті, бірдеңе дұрыс емес пе?
Dialogue: 0,0:36:39.07,0:36:40.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:41.94,0:36:43.07,Default,,0,0,0,,Хмм
Dialogue: 0,0:36:44.45,0:36:46.78,Default,,0,0,0,,- (Жүгіріп) Не болды? -Не?
Dialogue: 0,0:36:46.87,0:36:49.79,Default,,0,0,0,,Жоқ, мен оны бір жерден көргендей болдым...
Dialogue: 0,0:36:49.87,0:36:54.62,Default,,0,0,0,,Ха, мынаны қарасаң, жарылыс әдісі анық көрінеді.
Dialogue: 0,0:36:54.71,0:36:57.13,Default,,0,0,0,,Полицияның тергеу материалдары
Dialogue: 0,0:36:57.21,0:37:00.13,Default,,0,0,0,,Бұл қылмыс туралы егжей-тегжейлі нұсқаулық сияқты.
Dialogue: 0,0:37:00.84,0:37:02.38,Default,,0,0,0,,Нұсқаулық…
Dialogue: 0,0:37:02.47,0:37:07.43,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:37:07.93,0:37:09.81,Default,,0,0,0,,Иә, бұл Тачибана.
Dialogue: 0,0:37:10.35,0:37:11.39,Default,,0,0,0,,Сот?
Dialogue: 0,0:37:11.47,0:37:13.14,Default,,0,0,0,,- (Эри/Ран) Иә?
Dialogue: 0,0:37:13.23,0:37:16.90,Default,,0,0,0,,Иә Бұл сотқа дейінгі реттеу рәсімі ме?
Dialogue: 0,0:37:19.07,0:37:19.90,Default,,0,0,0,,Директор Ивай
Dialogue: 0,0:37:19.98,0:37:21.86,Default,,0,0,0,,Неге мен туралы үндемеу керек?
Dialogue: 0,0:37:21.94,0:37:25.36,Default,,0,0,0,,Сіз қорғаушыға айып тағылатынын айттыңыз ба?
Dialogue: 0,0:37:25.45,0:37:29.66,Default,,0,0,0,,Мені қайта-қайта айтуға мәжбүрлеме. Бұл қоғамдық қауіпсіздік полициясының шешімі.
Dialogue: 0,0:37:29.74,0:37:31.83,Default,,0,0,0,,Айыптау шешімі ғана емес
Dialogue: 0,0:37:31.91,0:37:34.96,Default,,0,0,0,,Сіз белгіленген уақытқа дейін қоғамдық қауіпсіздік полициясының қамқорлығындасыз ба?
Dialogue: 0,0:37:35.04,0:37:39.04,Default,,0,0,0,,Сонымен, ертең айыптаушы мен қорғаушы кездеседі.
Dialogue: 0,0:37:39.13,0:37:41.84,Default,,0,0,0,,Сотқа дейінгі реттеу процедураларын жалғастыруды қалау
Dialogue: 0,0:37:41.92,0:37:44.42,Default,,0,0,0,,Менімен сот хабарласты.
Dialogue: 0,0:37:44.51,0:37:48.68,Default,,0,0,0,,Неліктен бұл хабар Ивай супервайзеріне жіберілді?
Dialogue: 0,0:37:48.76,0:37:50.93,Default,,0,0,0,,Мен жауапты прокурормын.
Dialogue: 0,0:37:51.60,0:37:55.43,Default,,0,0,0,,Процедура аяқталғаннан кейін бізге хабарласыңыз.
Dialogue: 0,0:37:55.52,0:37:56.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:37:58.02,0:38:01.48,Default,,0,0,0,,Жоқ, бұл үлкен балмұздақ
Dialogue: 0,0:38:01.57,0:38:03.15,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:38:04.19,0:38:06.99,Default,,0,0,0,,А, мен кеңсе қызметкерінен сұрайын.
Dialogue: 0,0:38:07.07,0:38:10.03,Default,,0,0,0,,Амуро-сан, маған ұн мен жұмыртқа берші.
Dialogue: 0,0:38:10.57,0:38:13.66,Default,,0,0,0,,Азуса жақсы жар болады деп ойлаймын.
Dialogue: 0,0:38:13.74,0:38:15.83,Default,,0,0,0,,Ха...тшш
Dialogue: 0,0:38:15.91,0:38:18.58,Default,,0,0,0,,- (Азуса) Шапшаң сөздер мен әрекеттерден аулақ болыңыз - (Амуро) Иә?
Dialogue: 0,0:38:18.67,0:38:21.54,Default,,0,0,0,,Амуро-сан біздің қарапайым орта мектептегі қыздарымызға өте танымал.
Dialogue: 0,0:38:21.63,0:38:25.05,Default,,0,0,0,,Өткен күні интернетте мен аванс жасап жатырмын деген үлкен шу болды.
Dialogue: 0,0:38:25.13,0:38:27.09,Default,,0,0,0,,Қазіргі заманда қайда, кім тыңдап жатыр?
Dialogue: 0,0:38:27.17,0:38:29.14,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:38:29.68,0:38:31.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:38.56,0:38:39.94,Default,,0,0,0,,Фуруя мырза\NМенің ойымша, бұл
Dialogue: 0,0:38:41.48,0:38:44.23,Default,,0,0,0,,Неліктен мұны оқиғаға айналдыруға мән бересіз?
Dialogue: 0,0:38:44.94,0:38:48.24,Default,,0,0,0,,Егер ол жазатайым оқиға ретінде өңделсе, сіз ордер ала алмайсыз.
Dialogue: 0,0:38:48.32,0:38:53.16,Default,,0,0,0,,Қоғамдық қауіпсіздік ордерсіз заңсыз тінту жүргізе алуы керек.
Dialogue: 0,0:38:53.24,0:38:57.08,Default,,0,0,0,,Сондықтан біз заңды құралдарды ашық қалдыруымыз керек.
Dialogue: 0,0:38:58.41,0:39:01.08,Default,,0,0,0,,Өзіңді тұншықтырып өлтіресің
Dialogue: 0,0:39:01.17,0:39:05.25,Default,,0,0,0,,Мен кез келген заңсыз жұмысты өзім реттеймін.
Dialogue: 0,0:39:05.88,0:39:07.63,Default,,0,0,0,,Өйткені бұл қоғамдық қауіпсіздік.
Dialogue: 0,0:39:07.72,0:39:10.63,Default,,0,0,0,,Бірақ оқиғаны жария ету заңды ма...
Dialogue: 0,0:39:10.72,0:39:12.89,Default,,0,0,0,,Заңсыз жасыру туралы шешім қабылдау
Dialogue: 0,0:39:12.97,0:39:15.14,Default,,0,0,0,,Біз қоғамдық қауіпсіздік болуымыз керек.
Dialogue: 0,0:39:15.89,0:39:17.14,Default,,0,0,0,,Әрине.
Dialogue: 0,0:39:17.22,0:39:21.65,Default,,0,0,0,,Алайда Жапонияны қайсысы жақсы қорғайды?
Dialogue: 0,0:39:21.73,0:39:23.73,Default,,0,0,0,,Ойланып болған соң
Dialogue: 0,0:39:25.78,0:39:28.65,Default,,0,0,0,,А, Амуро мырза, кеңсе қызметкері...
Dialogue: 0,0:39:32.16,0:39:34.37,Default,,0,0,0,,Прокурордан бастайық.
Dialogue: 0,0:39:34.45,0:39:39.00,Default,,0,0,0,,Дәлелдеуге жататын фактілерді түсіндіріп, дәлелдемелерді ашыңыз.
Dialogue: 0,0:39:39.08,0:39:39.91,Default,,0,0,0,,Иә
Dialogue: 0,0:39:40.00,0:39:43.83,Default,,0,0,0,,Енді мен дәлелдер тізімін ұсынамын.
Dialogue: 0,0:39:46.00,0:39:47.13,Default,,0,0,0,,- (Эри) Ран - (Ран) Ах
Dialogue: 0,0:39:47.21,0:39:49.30,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:39:49.38,0:39:50.67,Default,,0,0,0,,Бірақ
Dialogue: 0,0:39:51.68,0:39:54.18,Default,,0,0,0,,Бүгін әлі сот емес, солай ма?
Dialogue: 0,0:39:54.26,0:39:58.10,Default,,0,0,0,,Иә Сотқа дейінгі іс жүргізу
Dialogue: 0,0:39:58.18,0:40:01.56,Default,,0,0,0,,Мәселелер мен дәлелдерді қысқартып, күнді шешіңіз.
Dialogue: 0,0:40:02.14,0:40:03.44,Default,,0,0,0,,Мен саған айттым ғой, солай ма?
Dialogue: 0,0:40:03.52,0:40:04.65,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:40:04.73,0:40:05.69,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:40:05.77,0:40:06.90,Default,,0,0,0,,Ах
Dialogue: 0,0:40:07.73,0:40:09.49,Default,,0,0,0,,Сакако мырза!
Dialogue: 0,0:40:14.07,0:40:17.08,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:40:18.08,0:40:19.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:19.66,0:40:21.62,Default,,0,0,0,,Бұл Кусакабе, Iwai директоры.
Dialogue: 0,0:40:21.71,0:40:24.58,Default,,0,0,0,,Сотқа дейінгі өндіріс жаңа ғана аяқталды.
Dialogue: 0,0:40:24.67,0:40:25.50,Default,,0,0,0,,Хмм
Dialogue: 0,0:40:26.29,0:40:28.75,Default,,0,0,0,,Прокурор Құсақабе қандай дәлелдерді ашты?
Dialogue: 0,0:40:28.84,0:40:32.30,Default,,0,0,0,,Бұл мен бұрын алған дәлелдер бойынша болды.
Dialogue: 0,0:40:32.38,0:40:33.76,Default,,0,0,0,,Міне тізім
Dialogue: 0,0:40:35.55,0:40:36.80,Default,,0,0,0,,Сот қай күні?
Dialogue: 0,0:40:36.89,0:40:40.56,Default,,0,0,0,,Бұл шешім қабылданды және ол жоспарланғандай.
Dialogue: 0,0:40:40.64,0:40:43.64,Default,,0,0,0,,Аа, кешіріңіз, бір сәт оқыңыз.
Dialogue: 0,0:40:43.73,0:40:45.56,Default,,0,0,0,,Мен ваннаға барамын.
Dialogue: 0,0:40:46.73,0:40:49.57,Default,,0,0,0,,Аа, Сакако мырза, дәретхана екінші жақта!
Dialogue: 0,0:40:49.65,0:40:51.78,Default,,0,0,0,,Сакако мырза!
Dialogue: 0,0:40:52.57,0:40:53.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:40:54.36,0:40:55.28,Default,,0,0,0,,(телефонды тыңдау шуы)
Dialogue: 0,0:40:55.28,0:40:55.87,Default,,0,0,0,,(телефонды тыңдау шуы)
Dialogue: 0,0:40:55.28,0:40:55.87,Default,,0,0,0,,Ах
Dialogue: 0,0:40:55.87,0:40:55.95,Default,,0,0,0,,Ах
Dialogue: 0,0:40:55.95,0:40:56.32,Default,,0,0,0,,Ах
Dialogue: 0,0:40:55.95,0:40:56.32,Default,,0,0,0,,…Жағдай қалай?
Dialogue: 0,0:40:56.32,0:40:56.41,Default,,0,0,0,,…Жағдай қалай?
Dialogue: 0,0:40:56.41,0:40:57.49,Default,,0,0,0,,...Жағдай қандай?
Dialogue: 0,0:40:56.41,0:40:57.49,Default,,0,0,0,,Бұл...
Dialogue: 0,0:40:58.41,0:41:00.49,Default,,0,0,0,,Мен оны кеше детектив Казамиде сынап көрдім.
Dialogue: 0,0:41:01.12,0:41:02.83,Default,,0,0,0,,Сіз жақынсыз ба?
Dialogue: 0,0:41:02.91,0:41:05.00,Default,,0,0,0,,Түсіндім, сұрауды жалғастырамын.
Dialogue: 0,0:41:05.08,0:41:06.67,Default,,0,0,0,,Өте жақын!
Dialogue: 0,0:41:08.25,0:41:11.51,Default,,0,0,0,,Бұл соттың ішінде ме?
Dialogue: 0,0:41:13.92,0:41:14.76,Default,,0,0,0,,Хмм
Dialogue: 0,0:41:15.76,0:41:17.55,Default,,0,0,0,,Ха, ол қайда?
Dialogue: 0,0:41:19.47,0:41:20.18,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:41:20.18,0:41:22.81,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:41:20.18,0:41:22.81,Default,,0,0,0,,Ха, бұл Сакако-сенсэйдің қоңырау үні ме?
Dialogue: 0,0:41:22.89,0:41:24.94,Default,,0,0,0,,А, Сакако-сенсэй?
Dialogue: 0,0:41:25.02,0:41:27.10,Default,,0,0,0,,Мен бір нәрсені растағым келеді.
Dialogue: 0,0:41:27.19,0:41:29.19,Default,,0,0,0,,Аа, мен бірден қайтамын.
Dialogue: 0,0:41:29.27,0:41:32.61,Default,,0,0,0,,Ха, детектив Казамидің тыңдау құрылғысы неге қосылды?
Dialogue: 0,0:41:32.69,0:41:34.70,Default,,0,0,0,,Сакайко Сенсейдің дауысы
Dialogue: 0,0:41:35.99,0:41:39.03,Default,,0,0,0,,Сіз детектив Казамидің қасында болдыңыз ба?
Dialogue: 0,0:41:39.53,0:41:41.91,Default,,0,0,0,,Жоқ, мен аудионы естігенімше.
Dialogue: 0,0:41:42.54,0:41:45.29,Default,,0,0,0,,Екеуі біраз уақыт жақын болса керек.
Dialogue: 0,0:41:48.25,0:41:49.92,Default,,0,0,0,,Бұл кездейсоқтық емес
Dialogue: 0,0:41:54.72,0:41:57.30,Default,,0,0,0,,Қоғамдық қауіпсіздік министрлігінің тергеу нәтижелері
Dialogue: 0,0:41:57.38,0:41:59.76,Default,,0,0,0,,Жарылыс орнына рұқсатсыз кіру
Dialogue: 0,0:41:59.85,0:42:02.39,Default,,0,0,0,,«Нор» қолданылғанын білдім.
Dialogue: 0,0:42:02.47,0:42:03.97,Default,,0,0,0,,Нұх?
Dialogue: 0,0:42:04.06,0:42:06.39,Default,,0,0,0,,IP мекенжайыңызды шифрлаңыз
Dialogue: 0,0:42:06.48,0:42:09.77,Default,,0,0,0,,Бірнеше компьютерден өту арқылы бақылауды мүмкін етпеу —
Dialogue: 0,0:42:09.86,0:42:11.90,Default,,0,0,0,,Браузердің бағдарламалық құралы
Dialogue: 0,0:42:11.98,0:42:15.32,Default,,0,0,0,,Нұхтың анонимділігін жоюға бола ма?
Dialogue: 0,0:42:15.40,0:42:17.99,Default,,0,0,0,,Негізінде бұл мүмкін емес
Dialogue: 0,0:42:18.07,0:42:22.12,Default,,0,0,0,,Дегенмен, егер Noah браузерінде қате конфигурация немесе қате болса.
Dialogue: 0,0:42:22.20,0:42:25.12,Default,,0,0,0,,Пайдаланушыны анықтау мүмкіндігі бар.
Dialogue: 0,0:42:25.20,0:42:27.12,Default,,0,0,0,,Екінші жағынан...
Dialogue: 0,0:42:27.21,0:42:28.96,Default,,0,0,0,,Кінәлінің Noah браузеріне
Dialogue: 0,0:42:29.04,0:42:33.46,Default,,0,0,0,,Егер осалдықты осы жерден жасасаңыз, оны қадағалау мүмкіндігі бар.
Dialogue: 0,0:42:34.59,0:42:37.38,Default,,0,0,0,,Қазіргі уақытта біз Қоғамдық қауіпсіздік министрлігіндегі серверді бақылап жатырмыз.
Dialogue: 0,0:42:37.47,0:42:41.30,Default,,0,0,0,,Пайдаланушыларды анықтау мүмкіндіктерін іздеу
Dialogue: 0,0:42:41.39,0:42:42.55,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:42:42.64,0:42:43.76,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:42:45.64,0:42:46.85,Default,,0,0,0,,Мені шақырды
Dialogue: 0,0:42:47.52,0:42:49.35,Default,,0,0,0,,Мен бөлмеден уақытша шығамын.
Dialogue: 0,0:42:49.44,0:42:50.56,Default,,0,0,0,,О
Dialogue: 0,0:42:54.11,0:42:56.11,Default,,0,0,0,,- (Амуро) Бұл тергеу жиналысын тыңдау ма? -А?
Dialogue: 0,0:42:56.74,0:42:59.74,Default,,0,0,0,,Неге мұнда?
Dialogue: 0,0:42:59.82,0:43:04.91,Default,,0,0,0,,Моури Когороға келгенде, сен сондай еңбекқорсың.
Dialogue: 0,0:43:04.99,0:43:08.00,Default,,0,0,0,,Әлде бұл Ран-ничанға арналған ба?
Dialogue: 0,0:43:08.08,0:43:09.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:09.04,0:43:09.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:09.04,0:43:09.58,Default,,0,0,0,,(шу)
Dialogue: 0,0:43:09.58,0:43:09.67,Default,,0,0,0,,(шу)
Dialogue: 0,0:43:09.67,0:43:10.50,Default,,0,0,0,,(шу)
Dialogue: 0,0:43:09.67,0:43:10.50,Default,,0,0,0,,Га
Dialogue: 0,0:43:10.58,0:43:12.50,Default,,0,0,0,,Маған бәрібір, шықшы.
Dialogue: 0,0:43:15.75,0:43:17.63,Default,,0,0,0,,Мені неге шақырдың?
Dialogue: 0,0:43:19.05,0:43:20.26,Default,,0,0,0,,Фуруя мырза?
Dialogue: 0,0:43:22.64,0:43:24.35,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:43:24.43,0:43:25.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:43:26.68,0:43:28.35,Default,,0,0,0,,Ах... уф...
Dialogue: 0,0:43:28.43,0:43:29.85,Default,,0,0,0,,Уф
Dialogue: 0,0:43:32.40,0:43:33.23,Default,,0,0,0,,Ах
Dialogue: 0,0:43:34.82,0:43:37.48,Default,,0,0,0,,Бұл қоғамдық қауіпсіздікке жақсы қызмет етеді.
Dialogue: 0,0:43:38.19,0:43:40.70,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:43:44.78,0:43:47.70,Default,,0,0,0,,Айтуынша, ол жүріп өтіп, көзге көрінгеннің бәрін мөлдір етіп қояды.
Dialogue: 0,0:43:48.29,0:43:49.62,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:43:56.42,0:43:59.92,Default,,0,0,0,,Тыңдау құрылғысын орнаттыңыз ба?
Dialogue: 0,0:44:01.47,0:44:02.68,Default,,0,0,0,,Жоқ, мүмкін емес
Dialogue: 0,0:44:02.76,0:44:05.10,Default,,0,0,0,,Осындай бала...
Dialogue: 0,0:44:05.18,0:44:06.10,Default,,0,0,0,,-Мистер Амуро - (Казами) Ах.
Dialogue: 0,0:44:06.64,0:44:11.10,Default,,0,0,0,,Ұлттық полиция агенттігінің нөлі, ол бүкіл ел бойынша қоғамдық қауіпсіздік полициясын бақылайды
Dialogue: 0,0:44:11.19,0:44:12.31,Default,,0,0,0,,Хмм
Dialogue: 0,0:44:14.44,0:44:16.86,Default,,0,0,0,,Амуро мырзамен кім хабарласа алады?
Dialogue: 0,0:44:16.94,0:44:21.24,Default,,0,0,0,,Қоғамдық қауіпсіздік полициясының ішінде детективтердің шектеулі саны ғана
Dialogue: 0,0:44:21.32,0:44:23.24,Default,,0,0,0,,Бұл Казами-сан болды, солай ма?
Dialogue: 0,0:44:24.82,0:44:27.66,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:44:29.20,0:44:30.54,Default,,0,0,0,,Конан Эдогава
Dialogue: 0,0:44:31.71,0:44:33.29,Default,,0,0,0,,Детектив
Dialogue: 0,0:44:45.14,0:44:47.68,Default,,0,0,0,,Сіз айтып отырған Амуро есімді адам
Dialogue: 0,0:44:47.76,0:44:49.31,Default,,0,0,0,,Ах
Dialogue: 0,0:44:49.39,0:44:51.31,Default,,0,0,0,,Кісі өлтіруші
Dialogue: 0,0:44:51.39,0:44:52.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:58.48,0:45:02.90,Default,,0,0,0,,Өткен жылы мен тергеу изоляторында тергеушіні өз-өзіне қол жұмсауға мәжбүрледім.
Dialogue: 0,0:45:02.99,0:45:04.91,Default,,0,0,0,,Суицид...
Dialogue: 0,0:45:06.74,0:45:10.41,Default,,0,0,0,,Жаман, балаға олай айтпауым керек еді.
Dialogue: 0,0:45:12.25,0:45:15.83,Default,,0,0,0,,Бірақ қандай да бір себептермен сіз бұл оқиғаны айта аласыз.
Dialogue: 0,0:45:15.92,0:45:17.50,Default,,0,0,0,,Ол біртүрлі бала.
Dialogue: 0,0:45:19.17,0:45:21.84,Default,,0,0,0,,Қоғамдық қауіпсіздік департаменті, Нойдың айтуынша
Dialogue: 0,0:45:21.92,0:45:24.55,Default,,0,0,0,,Қол жеткізу орнын көрсеткен бойда, Когоро Моури...
Dialogue: 0,0:45:24.55,0:45:24.93,Default,,0,0,0,,Қол жеткізу орнын көрсеткен бойда, Когоро Моури...
Dialogue: 0,0:45:24.55,0:45:24.93,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:45:24.93,0:45:25.01,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:45:25.01,0:45:25.84,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:45:25.01,0:45:25.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:25.93,0:45:27.09,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:45:27.18,0:45:29.39,Default,,0,0,0,,Дәл қазір Токиода бір қорқынышты нәрсе болып жатыр.
Dialogue: 0,0:45:29.47,0:45:30.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:33.48,0:45:34.94,Default,,0,0,0,,-(Жоғары сынып оқушысы) Атцу -(Мектеп оқушысы) Уау
Dialogue: 0,0:45:35.02,0:45:36.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:38.81,0:45:41.65,Default,,0,0,0,,Уау... не?
Dialogue: 0,0:45:45.74,0:45:48.16,Default,,0,0,0,,- (Қыз) Ана Қиын! -(Әке) А?
Dialogue: 0,0:45:48.24,0:45:49.41,Default,,0,0,0,,- (Ана) Өтірік - (Барлығы) Уау!
Dialogue: 0,0:45:49.49,0:45:50.78,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:45:51.58,0:45:52.41,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:45:52.49,0:45:53.75,Default,,0,0,0,,Кя не?
Dialogue: 0,0:45:53.83,0:45:55.41,Default,,0,0,0,,- (Кіші мектеп оқушысы) Бұл қауіпті емес пе? -(Вокзал қызметкерлері) Уау!
Dialogue: 0,0:45:55.50,0:45:56.58,Default,,0,0,0,,
Dialogue: 0,0:45:56.67,0:45:58.42,Default,,0,0,0,,Ой, бұл не?
Dialogue: 0,0:45:59.13,0:46:00.75,Default,,0,0,0,,Біз қашанға дейін солай істейміз...
Dialogue: 0,0:46:00.84,0:46:02.09,Default,,0,0,0,,Уф
Dialogue: 0,0:46:02.17,0:46:03.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:46:04.05,0:46:05.30,Default,,0,0,0,,Бүгін не істеп жатыр
Dialogue: 0,0:46:05.38,0:46:06.84,Default,,0,0,0,,Токио саммитіне арналған
Dialogue: 0,0:46:06.93,0:46:09.43,Default,,0,0,0,,Токио жоғары дайындықта
Dialogue: 0,0:46:09.51,0:46:12.06,Default,,0,0,0,,Бірінен соң бірі болып жатқан жұмбақ құбылыстар туралы
Dialogue: 0,0:46:12.14,0:46:14.68,Default,,0,0,0,,Елордалық полиция департаментінен әлі ресми мәлімдеме болған жоқ.
Dialogue: 0,0:46:15.43,0:46:18.19,Default,,0,0,0,,Жапонияға ғана емес, саммитке қатысушы елдерге де назар аудару
Dialogue: 0,0:46:18.27,0:46:21.94,Default,,0,0,0,,Жапон үкіметіне алаңдаушылық пен сын дауыстары жетіп жатыр
Dialogue: 0,0:46:22.73,0:46:25.53,Default,,0,0,0,,Сондай-ақ компьютерлер мен электр қазандары жарылғаны туралы ақпарат бар.
Dialogue: 0,0:46:25.61,0:46:26.57,Default,,0,0,0,,Шатасу тарауда...
Dialogue: 0,0:46:26.57,0:46:27.45,Default,,0,0,0,,Шатасу тарауда...
Dialogue: 0,0:46:26.57,0:46:27.45,Default,,0,0,0,,- (Жүгіріп) Ахх - (Эри) Сәлем!
Dialogue: 0,0:46:29.16,0:46:30.87,Default,,0,0,0,,Не болды?
Dialogue: 0,0:46:30.95,0:46:33.62,Default,,0,0,0,,Осыны қайталауға рұқсат етіңіз...
Dialogue: 0,0:46:33.70,0:46:37.41,Default,,0,0,0,,Уф, қылмыскердің мақсаты қандай?
Dialogue: 0,0:46:38.46,0:46:40.42,Default,,0,0,0,,Электр аспаптары?
Dialogue: 0,0:46:41.34,0:46:42.17,Default,,0,0,0,,Хмм
Dialogue: 0,0:46:42.25,0:46:44.59,Default,,0,0,0,,«Смартфондағы қысым температурасы»
Dialogue: 0,0:46:44.67,0:46:46.34,Default,,0,0,0,,«Тек уақытты орнатыңыз»
Dialogue: 0,0:46:46.42,0:46:48.43,Default,,0,0,0,,«Сорпа пісіре алады, т.б.».
Dialogue: 0,0:46:48.51,0:46:50.18,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:46:51.01,0:46:54.93,Default,,0,0,0,,Бұл лаңкестік әрекеттердің біріншісі саммит өтетін жерді бомбалау болды!
Dialogue: 0,0:46:55.02,0:46:58.69,Default,,0,0,0,,(Төтенше көлік сиренасы)
Dialogue: 0,0:46:58.77,0:47:01.65,Default,,0,0,0,,(Байланыс командалық штабында шулы)
Dialogue: 0,0:47:01.73,0:47:02.56,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:47:02.65,0:47:05.23,Default,,0,0,0,,Байланыс басқармасының штабы да дүрбелеңде.
Dialogue: 0,0:47:05.32,0:47:06.44,Default,,0,0,0,,Бүгінгі күні Токиода 100-ден астам сайт бар!
Dialogue: 0,0:47:06.44,0:47:07.49,Default,,0,0,0,,Бүгінгі күні Токиода 100-ден астам сайт бар!
Dialogue: 0,0:47:06.44,0:47:07.49,Default,,0,0,0,,Регистрді орнату Базаға нұсқаулар беріңіз!
Dialogue: 0,0:47:07.49,0:47:07.57,Default,,0,0,0,,Тіркелгіні орнату Маған базаға қатысты нұсқаулар беріңіз!
Dialogue: 0,0:47:07.57,0:47:08.65,Default,,0,0,0,,Регистрді орнату База бойынша нұсқаулар беріңіз!
Dialogue: 0,0:47:07.57,0:47:08.65,Default,,0,0,0,,Штаб қалалық полиция департаментінде орналасуы керек!
Dialogue: 0,0:47:08.65,0:47:09.36,Default,,0,0,0,,Штаб қалалық полиция департаментінде орналасуы керек!
Dialogue: 0,0:47:09.45,0:47:11.16,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:47:11.82,0:47:13.53,Default,,0,0,0,,Бұл терроризм ме?
Dialogue: 0,0:47:13.62,0:47:15.58,Default,,0,0,0,,Жазбаша мәлімдеме жасалды ма?
Dialogue: 0,0:47:16.70,0:47:19.71,Default,,0,0,0,,Конан-кун, кешіріңіз, бірақ дәл қазір сізбен сөйлесетін уақыт...
Dialogue: 0,0:47:19.79,0:47:23.63,Default,,0,0,0,,Инспектор Мегур: Мұның бәрі IoT терроризмі екеніне сенімдімін.
Dialogue: 0,0:47:23.71,0:47:24.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:24.63,0:47:26.38,Default,,0,0,0,,IoT терроризмі?
Dialogue: 0,0:47:26.46,0:47:29.34,Default,,0,0,0,,Кінәліде интернетке кіре алатын электронды құрылғы бар.
Dialogue: 0,0:47:29.42,0:47:31.55,Default,,0,0,0,,Олар еріксіз жүгіріп келеді!
Dialogue: 0,0:47:33.01,0:47:36.97,Default,,0,0,0,,Сондықтан, егер сіз интернеттен ажыратсаңыз, ашуды тоқтатуға болады.
Dialogue: 0,0:47:40.73,0:47:42.69,Default,,0,0,0,,IoT терроризмі?
Dialogue: 0,0:47:45.32,0:47:46.78,Default,,0,0,0,,Қандай бала
Dialogue: 0,0:47:49.19,0:47:52.11,Default,,0,0,0,,Оқиға орнынан қысымға арналған қазан да табылды.
Dialogue: 0,0:47:52.20,0:47:53.45,Default,,0,0,0,,IoT тұрмыстық техникасы болуы керек
Dialogue: 0,0:47:55.95,0:47:58.87,Default,,0,0,0,,Қылмыскер газ клапанын онлайн режимде басқарды.
Dialogue: 0,0:47:58.95,0:48:01.46,Default,,0,0,0,,Учаскені газбен толтырғаннан кейін
Dialogue: 0,0:48:01.54,0:48:04.21,Default,,0,0,0,,IoT қысымды ыдысты пиротехникалық құрал ретінде пайдалану
Dialogue: 0,0:48:04.29,0:48:06.34,Default,,0,0,0,,Мен саммит өтетін орынды жарып жібердім.
Dialogue: 0,0:48:09.17,0:48:11.05,Default,,0,0,0,,Ал... онда...
Dialogue: 0,0:48:11.13,0:48:11.97,Default,,0,0,0,,Иә
Dialogue: 0,0:48:12.63,0:48:14.97,Default,,0,0,0,,Когораның ағасы мұны істей алмайды.
Dialogue: 0,0:48:15.05,0:48:16.64,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:48:16.72,0:48:18.89,Default,,0,0,0,,Иә? А, аа, эй, а, а...
Dialogue: 0,0:48:18.97,0:48:19.81,Default,,0,0,0,,Ол «Рух толқынын» қолдануда — қалағанынша жоғалып, қайта пайда бола алады.
Dialogue: 0,0:48:19.89,0:48:22.27,Default,,0,0,0,,Шиничи-Чан осылай деді, сондықтан қамқорлық жасаңыз.
Dialogue: 0,0:48:22.35,0:48:24.27,Default,,0,0,0,,Инспектор (кесу дыбысы)
Dialogue: 0,0:48:24.35,0:48:25.52,Default,,0,0,0,,Я...
Dialogue: 0,0:48:26.82,0:48:27.94,Default,,0,0,0,,- (Рен) Конан-кун - Мм
Dialogue: 0,0:48:29.19,0:48:33.95,Default,,0,0,0,,Шиничи, сен әкең үшін көп жұмыс істеп жатырсың.
Dialogue: 0,0:48:34.70,0:48:36.45,Default,,0,0,0,,Ах… Хмпф
Dialogue: 0,0:48:39.79,0:48:41.29,Default,,0,0,0,,Барлоу
Dialogue: 0,0:48:41.37,0:48:44.58,Default,,0,0,0,,Бұл тек сенің әкең үшін емес.
Dialogue: 0,0:48:45.29,0:48:46.71,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:48:46.79,0:48:47.71,Default,,0,0,0,,Егер бұл рас болса, сіз істі жеңе аласыз.
Dialogue: 0,0:48:47.71,0:48:51.21,Default,,0,0,0,,Егер бұл рас болса, сіз істі жеңе аласыз.
Dialogue: 0,0:48:47.71,0:48:51.21,Default,,0,0,0,,(жерлеушінің айқайы)
Dialogue: 0,0:48:51.21,0:48:51.30,Default,,0,0,0,,(жерлеушінің айқайы)
Dialogue: 0,0:48:51.30,0:48:52.72,Default,,0,0,0,,(жерлеушінің айқайы)
Dialogue: 0,0:48:51.30,0:48:52.72,Default,,0,0,0,,Иә, прокурорлар ұстаған қария
Dialogue: 0,0:48:52.72,0:48:54.22,Default,,0,0,0,,Иә, прокурорлар қамауға алған қария
Dialogue: 0,0:48:54.30,0:48:56.72,Default,,0,0,0,,Мен қазір интернетке кіре алмаймын.
Dialogue: 0,0:48:56.80,0:48:58.22,Default,,0,0,0,,Жоқ
Dialogue: 0,0:48:58.31,0:49:01.02,Default,,0,0,0,,Күн мен уақытты алдын ала орнатсаңыз
Dialogue: 0,0:49:01.10,0:49:04.56,Default,,0,0,0,,IoT терроризмі ұсталғаннан кейін де мүмкін
Dialogue: 0,0:49:04.65,0:49:05.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:05.90,0:49:09.48,Default,,0,0,0,,Серверді қадағалап, қол жеткізу орнын анықтасаңыз
Dialogue: 0,0:49:09.57,0:49:11.82,Default,,0,0,0,,Моридің айыптаулары түпкілікті болды
Dialogue: 0,0:49:11.90,0:49:13.57,Default,,0,0,0,,Міне!
Dialogue: 0,0:49:14.91,0:49:16.57,Default,,0,0,0,,Бірақ серверді зерттеу?
Dialogue: 0,0:49:16.66,0:49:17.95,Default,,0,0,0,,Бұл қиын емес пе?
Dialogue: 0,0:49:18.03,0:49:20.24,Default,,0,0,0,,Сотқа дейін аяқталады ма?
Dialogue: 0,0:49:20.33,0:49:23.96,Default,,0,0,0,,Қоғамдық қауіпсіздік тексеріп жатыр, сондықтан бұл қиын болмауы керек.
Dialogue: 0,0:49:24.04,0:49:24.87,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:49:25.71,0:49:28.63,Default,,0,0,0,,Қоғамдық қауіпсіздік мұны тексеріп жатқанын қайдан білесіз?
Dialogue: 0,0:49:28.71,0:49:29.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:30.63,0:49:32.09,Default,,0,0,0,,Уф
Dialogue: 0,0:49:30.63,0:49:32.09,Default,,0,0,0,,(жерлеушінің айқайы)
Dialogue: 0,0:49:32.17,0:49:34.51,Default,,0,0,0,,А, кешіріңіз.
Dialogue: 0,0:49:34.59,0:49:37.59,Default,,0,0,0,,Ха... Дұрыс, балақай.
Dialogue: 0,0:49:37.68,0:49:41.60,Default,,0,0,0,,Қоғамдық қауіпсіздік мұндай тергеулерді жиі жүргізеді.
Dialogue: 0,0:49:42.22,0:49:46.35,Default,,0,0,0,,Қоғамдық қауіпсіздік полициясының көптеген әріптестері бар.
Dialogue: 0,0:49:46.44,0:49:47.77,Default,,0,0,0,,Бірлескен жұмысшы дегеніміз не?
Dialogue: 0,0:49:47.85,0:49:51.19,Default,,0,0,0,,Қоғамдық қауіпсіздік детективтерінің тергеуімен ынтымақтасатын азаматтық тұлғалар туралы не деуге болады?
Dialogue: 0,0:49:51.27,0:49:52.73,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:49:52.82,0:49:57.86,Default,,0,0,0,,Әсіресе Байланысты тоқтату туралы заңға сәйкес тергеуге жататын серверлерге қатысты.
Dialogue: 0,0:49:57.95,0:50:00.87,Default,,0,0,0,,Көптеген адамдар қоғамдық қауіпсіздік полициясымен ынтымақтасады.
Dialogue: 0,0:50:00.95,0:50:03.41,Default,,0,0,0,,Егер сіз осындай серіктес болсаңыз
Dialogue: 0,0:50:03.50,0:50:06.87,Default,,0,0,0,,Біз Моури мырзаның сайтқа заңсыз кіргені туралы дәлелдер алуымыз керек.
Dialogue: 0,0:50:06.96,0:50:11.42,Default,,0,0,0,,А, әрине, егер мұндай дәлелдер болса.
Dialogue: 0,0:50:11.96,0:50:14.13,Default,,0,0,0,,А, жеткілікті.
Dialogue: 0,0:50:14.21,0:50:16.22,Default,,0,0,0,,- (Сайко) Солай ма? -(Эри) Иә.
Dialogue: 0,0:50:16.30,0:50:18.64,Default,,0,0,0,,Сабырлы болыңыз және мердігерден сұраңыз
Dialogue: 0,0:50:18.72,0:50:22.06,Default,,0,0,0,,Ақыр соңында, бұл қандай қызық сезім?
Dialogue: 0,0:50:22.14,0:50:24.39,Default,,0,0,0,,Оның әлі де бірдеңесі бар...
Dialogue: 0,0:50:25.39,0:50:26.73,Default,,0,0,0,,Әлі де шатасу бар -
Dialogue: 0,0:50:26.81,0:50:28.15,Default,,0,0,0,,Бірқатар оқиғаларға қатысты—
Dialogue: 0,0:50:28.73,0:50:33.11,Default,,0,0,0,,Елордалық полиция департаменті IoT терроризмінің жоғары ықтималдығы бар екенін жариялады.
Dialogue: 0,0:50:33.19,0:50:34.03,Default,,0,0,0,,(Бейнені тоқтататын дыбыс)
Dialogue: 0,0:50:34.11,0:50:37.24,Default,,0,0,0,,Мен бұл IoT терроризмі деп ешқашан ойламадым.
Dialogue: 0,0:50:38.45,0:50:42.24,Default,,0,0,0,,Мұндай әдісті анықтау үшін біреу күткендей.
Dialogue: 0,0:50:42.83,0:50:47.50,Default,,0,0,0,,Оны анықтаған мен емес едім, бірақ сіздің арқаңызда мен оны іске айналдыра алдым.
Dialogue: 0,0:50:48.25,0:50:52.13,Default,,0,0,0,,Сондықтан біз заңсыз жасаған жұмысымызды тоқтатқымыз келеді.
Dialogue: 0,0:50:52.21,0:50:54.34,Default,,0,0,0,,Бірлескен жұмыскерлерді босату
Dialogue: 0,0:50:54.42,0:50:55.55,Default,,0,0,0,,Ах
Dialogue: 0,0:51:01.05,0:51:04.31,Default,,0,0,0,,Бұған дейін қазір Zero-да бар ақпаратты қарастырайық.
Dialogue: 0,0:51:04.39,0:51:05.64,Default,,0,0,0,,Гвуу…
Dialogue: 0,0:51:05.72,0:51:06.56,Default,,0,0,0,,О
Dialogue: 0,0:51:07.52,0:51:09.35,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:51:09.44,0:51:10.48,Default,,0,0,0,,...
Dialogue: 0,0:51:11.15,0:51:14.57,Default,,0,0,0,,Бұл ақпаратты Киберқылмыспен күрес бөліміне жіберіңіз.
Dialogue: 0,0:51:14.65,0:51:17.24,Default,,0,0,0,,Тергеу жиналысында Қылмыстық іздестіру бөліміне есеп беру
Dialogue: 0,0:51:17.32,0:51:20.57,Default,,0,0,0,,Сіз қылмыстық бөлімге гүл әкелесіз бе?
Dialogue: 0,0:51:20.66,0:51:23.24,Default,,0,0,0,,Біз бұл туралы Қоғамдық қауіпсіздік министрлігіне хабарлауымыз керек.
Dialogue: 0,0:51:23.87,0:51:26.62,Default,,0,0,0,,Әй, бұл сыйлық.
Dialogue: 0,0:51:26.70,0:51:30.50,Default,,0,0,0,,Қылмыстық іздестіру департаментінің арқасында лаңкестік жарылыс іске айналды.
Dialogue: 0,0:51:30.58,0:51:34.59,Default,,0,0,0,,Және бұл ақпарат нөлден шыққан факт
Dialogue: 0,0:51:34.67,0:51:37.09,Default,,0,0,0,,Бұл туралы режиссерге сахна артында хабарланды.
Dialogue: 0,0:51:37.17,0:51:40.84,Default,,0,0,0,,Хм... Фуруя-сан қорқынышты.
Dialogue: 0,0:51:43.05,0:51:47.77,Default,,0,0,0,,Казами: Менен де қорқынышты екі адам бар.
Dialogue: 0,0:51:48.52,0:51:53.11,Default,,0,0,0,,Біреуі әлі бала.
Dialogue: 0,0:51:54.02,0:51:58.61,Default,,0,0,0,,Мен дәл Фуруя мырза сияқты баланы ойладым.
Dialogue: 0,0:52:00.24,0:52:02.74,Default,,0,0,0,,Мұндай жағдайда бәрін маған қалдыр.
Dialogue: 0,0:52:05.28,0:52:06.74,Default,,0,0,0,,Моуридің компьютерінен
Dialogue: 0,0:52:06.83,0:52:10.75,Default,,0,0,0,,Рұқсат етілмеген кірудің дәлелі табылды деп хабарланды.
Dialogue: 0,0:52:11.54,0:52:13.75,Default,,0,0,0,,Ол релелік нүкте ретінде де қолданылған.
Dialogue: 0,0:52:13.83,0:52:15.71,Default,,0,0,0,,Я...
Dialogue: 0,0:52:15.79,0:52:17.17,Default,,0,0,0,,Сонда қандай іздер бар?
Dialogue: 0,0:52:18.05,0:52:19.51,Default,,0,0,0,,Қоғамдық Wi-Fi желісінен
Dialogue: 0,0:52:19.59,0:52:22.18,Default,,0,0,0,,Қолдануға болмайтын смартфонмен кіру
Dialogue: 0,0:52:22.26,0:52:24.01,Default,,0,0,0,,Бақылау мүмкін болмады
Dialogue: 0,0:52:24.09,0:52:25.01,Default,,0,0,0,,Бірақ содан кейін
Dialogue: 0,0:52:25.10,0:52:28.31,Default,,0,0,0,,Мори мырзаны прокуратура қамауға алуда.
Dialogue: 0,0:52:28.39,0:52:31.27,Default,,0,0,0,,Кіру нүктесінде болу мүмкін болмады
Dialogue: 0,0:52:31.35,0:52:35.73,Default,,0,0,0,,Сонымен қатар, IoT терроризміне рұқсатсыз кіруге қатысты
Dialogue: 0,0:52:35.81,0:52:37.77,Default,,0,0,0,,Алдыңғы жағдайдағыдай техника —
Dialogue: 0,0:52:38.36,0:52:40.53,Default,,0,0,0,,Нұх пайдаланылды
Dialogue: 0,0:52:40.61,0:52:42.24,Default,,0,0,0,,(Детективтердің күбірі)
Dialogue: 0,0:52:40.61,0:52:42.24,Default,,0,0,0,,Бұл бұрынғыдай қылмыскер ме?
Dialogue: 0,0:52:42.24,0:52:43.24,Default,,0,0,0,,Дәл сол қылмыскер ме?
Dialogue: 0,0:52:43.32,0:52:46.28,Default,,0,0,0,,Серверді анықтау Тергеу қалай жүріп жатыр?
Dialogue: 0,0:52:46.37,0:52:50.16,Default,,0,0,0,,Киберқылмыстық бөлімнің есебіне сәйкес
Dialogue: 0,0:52:50.25,0:52:53.79,Default,,0,0,0,,Жүйе НАЗУ-да екен.
Dialogue: 0,0:52:53.87,0:52:54.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:55.00,0:52:58.42,Default,,0,0,0,,(Детективтердің күбірі)
Dialogue: 0,0:53:00.13,0:53:01.30,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:53:01.38,0:53:03.09,Default,,0,0,0,,Кешіріңіз, мен кешігіп қалдым.
Dialogue: 0,0:53:03.17,0:53:04.18,Default,,0,0,0,,Курияма мырза
Dialogue: 0,0:53:04.26,0:53:07.39,Default,,0,0,0,,Кешіріңіз, бұл жай ғана тамаша демалыс болды.
Dialogue: 0,0:53:07.47,0:53:09.68,Default,,0,0,0,,Жоқ, бұл мұғалім үшін үлкен мәселе.
Dialogue: 0,0:53:09.76,0:53:13.44,Default,,0,0,0,,Мен кеңсе қызметкері болғандықтан, ойнауға ақшам жоқ.
Dialogue: 0,0:53:13.52,0:53:14.98,Default,,0,0,0,,Бұл көмектеседі.
Dialogue: 0,0:53:15.06,0:53:16.44,Default,,0,0,0,,Жақсы
Dialogue: 0,0:53:17.27,0:53:20.03,Default,,0,0,0,,Адвокат Сакако Тачибанаға қатысты сауалнама нәтижелері
Dialogue: 0,0:53:20.11,0:53:21.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:21.15,0:53:24.86,Default,,0,0,0,,Иә? Мені Шиничи Кудо сұрады.
Dialogue: 0,0:53:25.57,0:53:26.82,Default,,0,0,0,,Шиничи?
Dialogue: 0,0:53:26.91,0:53:30.87,Default,,0,0,0,,Эй, Шиничи-нии-чан, мен сенен соны сұрадым.
Dialogue: 0,0:53:30.95,0:53:34.54,Default,,0,0,0,,Неліктен Тачибана мырзаның тергеуі?
Dialogue: 0,0:53:34.62,0:53:36.25,Default,,0,0,0,,- Эй, эй - (Эри) Иә?
Dialogue: 0,0:53:36.33,0:53:41.17,Default,,0,0,0,,Әңгіме Шиничи-нии-чан туралы болғандықтан, қандай да бір себеп болуы керек.
Dialogue: 0,0:53:41.25,0:53:43.38,Default,,0,0,0,,Неге бәрібір қарамайсың?
Dialogue: 0,0:53:44.34,0:53:46.64,Default,,0,0,0,,Өткен жылы Тачибана мырзаның кеңсе қызметкері
Dialogue: 0,0:53:46.72,0:53:49.01,Default,,0,0,0,,Оқиғаға себеп болып жатқаныңызды түсіндім.
Dialogue: 0,0:53:49.10,0:53:53.23,Default,,0,0,0,,Иә? Тачибана-сенсей К-бен болуы керек.
Dialogue: 0,0:53:53.31,0:53:55.27,Default,,0,0,0,,Мен өткен жылы кеңсемді жаптым.
Dialogue: 0,0:53:57.02,0:54:00.52,Default,,0,0,0,,Сол кезде кеңсе қызметкері болған Фумичи Хаба есімді адам
Dialogue: 0,0:54:00.61,0:54:03.86,Default,,0,0,0,,Ойын компаниясына кіріп, ұрлық жасады.
Dialogue: 0,0:54:03.94,0:54:05.36,Default,,0,0,0,,Қамауға алынғандықтан
Dialogue: 0,0:54:06.11,0:54:08.11,Default,,0,0,0,,Оның үстіне Хабаны прокуратураға жібергеннен кейін.
Dialogue: 0,0:54:08.70,0:54:11.12,Default,,0,0,0,,Тергеу изоляторында өз-өзіне қол жұмсады
Dialogue: 0,0:54:11.20,0:54:13.08,Default,,0,0,0,,Иә? Суицид?
Dialogue: 0,0:54:13.16,0:54:14.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:15.04,0:54:16.87,Default,,0,0,0,,Суицид…
Dialogue: 0,0:54:19.63,0:54:21.38,Default,,0,0,0,,Олар қарт адамды шынымен сынап жатыр
Dialogue: 0,0:54:22.05,0:54:24.13,Default,,0,0,0,,Когоро Моуридің компьютері
Dialogue: 0,0:54:24.21,0:54:27.38,Default,,0,0,0,,Мен біреудің айла-шарғы жасап жатқанын білдім.
Dialogue: 0,0:54:27.47,0:54:31.14,Default,,0,0,0,,Сондықтан оның кінәлі болуы екіталай.
Dialogue: 0,0:54:31.97,0:54:34.64,Default,,0,0,0,,Иә, сондықтан
Dialogue: 0,0:54:34.72,0:54:37.52,Default,,0,0,0,,Оның пиротехникадағы саусақ іздері ше?
Dialogue: 0,0:54:37.60,0:54:41.77,Default,,0,0,0,,Ах, жанып кеткен саусақ іздері.
Dialogue: 0,0:54:41.86,0:54:44.53,Default,,0,0,0,,Тасымалдау оңай ма?
Dialogue: 0,0:54:45.36,0:54:49.16,Default,,0,0,0,,Бұл қоғамдық қауіпсіздік полициясының қорытындысы ма?
Dialogue: 0,0:54:49.24,0:54:51.57,Default,,0,0,0,,Моури Когоро жауапқа тартылмаған
Dialogue: 0,0:54:51.66,0:54:55.70,Default,,0,0,0,,Сіз қылмыстық қудалаудан бас тарту туралы шешім қабылданғанға дейін қоғамдық қауіпсіздік полициясының қамқорлығындасыз ба?
Dialogue: 0,0:54:55.79,0:54:57.62,Default,,0,0,0,,Сіз табандысыз.
Dialogue: 0,0:54:57.62,0:54:58.21,Default,,0,0,0,,Сіз табандысыз.
Dialogue: 0,0:54:57.62,0:54:58.21,Default,,0,0,0,,(жану дыбысы)
Dialogue: 0,0:54:58.21,0:54:58.29,Default,,0,0,0,,(жану дыбысы)
Dialogue: 0,0:54:58.29,0:54:59.12,Default,,0,0,0,,(жану дыбысы)
Dialogue: 0,0:54:58.29,0:54:59.12,Default,,0,0,0,,Ха!
Dialogue: 0,0:54:59.79,0:55:01.63,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:55:01.71,0:55:03.34,Default,,0,0,0,,- (Ивай) Ах! -(Құсақабе) А.
Dialogue: 0,0:55:04.09,0:55:05.84,Default,,0,0,0,,Ааааааааааааааааааааааа!
Dialogue: 0,0:55:05.92,0:55:07.63,Default,,0,0,0,,Уф уф...
Dialogue: 0,0:55:07.72,0:55:08.63,Default,,0,0,0,,Әй!
Dialogue: 0,0:55:09.30,0:55:12.68,Default,,0,0,0,,(Құсақабенің айқайы)
Dialogue: 0,0:55:16.81,0:55:19.69,Default,,0,0,0,,- (Эри) Не, прокурор Ивай? - (Аққу) Иә.
Dialogue: 0,0:55:19.77,0:55:21.35,Default,,0,0,0,,Күйігі шамалы болса да, біз оны күтіп алып, ауруханаға жеткіздік.
Dialogue: 0,0:55:21.35,0:55:23.73,Default,,0,0,0,,Күйігі шамалы болса да, күтімге алып, ауруханаға жеткіздік.
Dialogue: 0,0:55:21.35,0:55:23.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:55:24.57,0:55:26.99,Default,,0,0,0,,Бұл да IoT терроризмі ме?
Dialogue: 0,0:55:27.07,0:55:29.32,Default,,0,0,0,,Егер сіз сол смартфонға қарасаңыз
Dialogue: 0,0:55:29.40,0:55:31.95,Default,,0,0,0,,Бұрынғыдай Нұхтан кіру болды...
Dialogue: 0,0:55:31.95,0:55:33.07,Default,,0,0,0,,Бұрынғыдай Нұхтан кіру болды...
Dialogue: 0,0:55:31.95,0:55:33.07,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:55:33.07,0:55:34.16,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:55:34.16,0:55:34.78,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:55:34.16,0:55:34.78,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:55:34.78,0:55:35.66,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:55:35.74,0:55:37.20,Default,,0,0,0,,Иә Аққу
Dialogue: 0,0:55:37.29,0:55:38.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:38.71,0:55:40.87,Default,,0,0,0,,- (Аққу) Аа, күте тұрыңыз - (3 адам) А?
Dialogue: 0,0:55:41.71,0:55:44.00,Default,,0,0,0,,Мори мырзаны қудалауға болмайды деп шешілді.
Dialogue: 0,0:55:44.09,0:55:45.59,Default,,0,0,0,,Га
Dialogue: 0,0:55:45.67,0:55:46.76,Default,,0,0,0,,Ах
Dialogue: 0,0:55:46.84,0:55:48.34,Default,,0,0,0,,- (Жүгіріп) Анашым! -(Эри) Ах.
Dialogue: 0,0:55:48.42,0:55:49.42,Default,,0,0,0,,- (Ран) ха - (Эри) иә
Dialogue: 0,0:55:50.26,0:55:52.93,Default,,0,0,0,,Я, бұл жақсы, Ран-ни-чан.
Dialogue: 0,0:55:53.60,0:55:56.06,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:55:56.14,0:55:59.02,Default,,0,0,0,,А, мен Шиничи мен Сонокого да айтуым керек.
Dialogue: 0,0:55:59.10,0:56:00.31,Default,,0,0,0,,- (Эри) Иә - (Жүгіріп) Хехе
Dialogue: 0,0:56:01.10,0:56:01.44,Default,,0,0,0,,Ах
Dialogue: 0,0:56:01.44,0:56:02.15,Default,,0,0,0,,Ах
Dialogue: 0,0:56:01.44,0:56:02.15,Default,,0,0,0,,Айтпақшы, мұнымен не істеуіміз керек?
Dialogue: 0,0:56:02.15,0:56:03.48,Default,,0,0,0,,Айтпақшы, мұнымен не істеуіміз керек?
Dialogue: 0,0:56:04.27,0:56:06.78,Default,,0,0,0,,Прокурор Фумиичи Хабадан жауап алды.
Dialogue: 0,0:56:06.86,0:56:08.53,Default,,0,0,0,,Бұл рекорд.
Dialogue: 0,0:56:09.32,0:56:13.95,Default,,0,0,0,,Иә? Бұл адам смартфоны өртенген кезде күйіп қалған прокурор Ивай болатын.
Dialogue: 0,0:56:14.03,0:56:15.99,Default,,0,0,0,,Өткен жылы мен бас прокурор болдым.
Dialogue: 0,0:56:16.08,0:56:19.20,Default,,0,0,0,,Иә, бірақ қазір мен бас прокурормын.
Dialogue: 0,0:56:19.29,0:56:20.83,Default,,0,0,0,,Ол менің әріптесім болған прокурор Құсақабенің бастығы.
Dialogue: 0,0:56:20.83,0:56:21.96,Default,,0,0,0,,Ол менің әріптесім болған прокурор Құсақабенің бастығы.
Dialogue: 0,0:56:20.83,0:56:21.96,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:56:21.96,0:56:22.00,Default,,0,0,0,,Ол менің әріптесім болған прокурор Құсақабенің бастығы.
Dialogue: 0,0:56:22.08,0:56:23.71,Default,,0,0,0,,- (Сайко) Дұрыс па?
Dialogue: 0,0:56:24.38,0:56:26.46,Default,,0,0,0,,Прокурор Ивай біртүрлі
Dialogue: 0,0:56:26.54,0:56:29.71,Default,,0,0,0,,Мен Фумиха Хабаның ұрлық оқиғасы үшін жоғарыладым.
Dialogue: 0,0:56:30.55,0:56:32.63,Default,,0,0,0,,- (Сайко) Айтпақшы, бұл не? -(Жасыл) Иә?
Dialogue: 0,0:56:33.59,0:56:37.89,Default,,0,0,0,,Неге маған және менің бұрынғы кеңсе қызметкеріме қарап отырсың?
Dialogue: 0,0:56:38.47,0:56:39.47,Default,,0,0,0,,Ал...
Dialogue: 0,0:56:39.56,0:56:43.14,Default,,0,0,0,,Кешіріңіз, мен сізбен жақынырақ танысқым келді.
Dialogue: 0,0:56:43.23,0:56:45.40,Default,,0,0,0,,Мен Курияма мырзадан сұрадым
Dialogue: 0,0:56:48.98,0:56:52.90,Default,,0,0,0,,Мен көп зерттеу жасадым, сіз тамаша кеңсе қызметкері сияқтысыз.
Dialogue: 0,0:56:52.99,0:56:54.78,Default,,0,0,0,,Сіз де?
Dialogue: 0,0:56:54.86,0:56:57.66,Default,,0,0,0,,Хаба мырза да солай айтып тұрғандай.
Dialogue: 0,0:56:58.66,0:57:01.29,Default,,0,0,0,,Ұрлық жасаған адам.
Dialogue: 0,0:57:01.37,0:57:05.50,Default,,0,0,0,,Ол Сакако-сенсэйдің кеңсесін қиратқан жаман кеңсе қызметкері, солай ма?
Dialogue: 0,0:57:05.58,0:57:08.21,Default,,0,0,0,,Уф... бұл 231-дің кінәсі емес еді!
Dialogue: 0,0:57:08.21,0:57:09.30,Default,,0,0,0,,Уф... бұл 231-дің кінәсі емес еді!
Dialogue: 0,0:57:08.21,0:57:09.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:10.00,0:57:14.72,Default,,0,0,0,,Мен күшсіз болғандықтан...
Dialogue: 0,0:57:14.80,0:57:16.93,Default,,0,0,0,,Сіз мені атыммен атайсыз.
Dialogue: 0,0:57:17.01,0:57:21.85,Default,,0,0,0,,Менің кеңсемде жұмыс істейтін кеңсе қызметкері «Екі-Үш-Бір» деп аталды.
Dialogue: 0,0:57:27.40,0:57:29.61,Default,,0,0,0,,Ол түрмеде өз-өзіне қол жұмсады ма?
Dialogue: 0,0:57:29.69,0:57:31.48,Default,,0,0,0,,Иә?Иә
Dialogue: 0,0:57:32.82,0:57:34.11,Default,,0,0,0,,Бұл суицид
Dialogue: 0,0:57:34.90,0:57:38.87,Default,,0,0,0,,Қоғамдық қауіпсіздік полициясы тергеу изоляторында жауап алған соң
Dialogue: 0,0:57:38.95,0:57:40.12,Default,,0,0,0,,Бұл бірден болды.
Dialogue: 0,0:57:40.20,0:57:41.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:42.20,0:57:47.00,Default,,0,0,0,,Өткен жылы мен тергеу изоляторында тергеушіні өз-өзіне қол жұмсауға мәжбүрледім.
Dialogue: 0,0:57:47.58,0:57:49.50,Default,,0,0,0,,Неліктен қоғамдық қауіпсіздік полициясы?
Dialogue: 0,0:57:49.59,0:57:52.01,Default,,0,0,0,,Мен мұндайды естімеппін.
Dialogue: 0,0:57:52.09,0:57:57.01,Default,,0,0,0,,Мұндай оғаш оқиғалар Нисаничидің өзін-өзі өлтіруімен бір мезгілде болды.
Dialogue: 0,0:57:57.09,0:57:59.80,Default,,0,0,0,,Фумиичи Хаба мырза
Dialogue: 0,0:57:59.89,0:58:02.72,Default,,0,0,0,,Сіз судья стажеры ретінде жұмыстан шығарылдыңыз, солай ма?
Dialogue: 0,0:58:02.81,0:58:05.35,Default,,0,0,0,,Сонда сіз судья болуды мақсат еттіңіз бе?
Dialogue: 0,0:58:05.44,0:58:06.81,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:58:06.90,0:58:09.98,Default,,0,0,0,,Заңгерлерді даярлау институтының жабылу салтанатында
Dialogue: 0,0:58:10.06,0:58:11.44,Default,,0,0,0,,Ол...
Dialogue: 0,0:58:13.57,0:58:17.74,Default,,0,0,0,,Болашақта судья және заңгер болатындар —
Dialogue: 0,0:58:17.82,0:58:18.78,Default,,0,0,0,,Біздің кездесуіміз...
Dialogue: 0,0:58:18.87,0:58:19.91,Default,,0,0,0,,- (Хаба) Директор! -(Директор) Ой.
Dialogue: 0,0:58:19.99,0:58:20.83,Default,,0,0,0,,Директор!
Dialogue: 0,0:58:20.91,0:58:24.08,Default,,0,0,0,,Менің... бас тартуыма қатысты—
Dialogue: 0,0:58:24.16,0:58:25.75,Default,,0,0,0,,Түсіндіруіңізді сұраймын!
Dialogue: 0,0:58:25.83,0:58:27.04,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:58:27.12,0:58:27.83,Default,,0,0,0,,Менің судья болып сайланбау себебім!
Dialogue: 0,0:58:27.83,0:58:28.71,Default,,0,0,0,,Менің судья болып сайланбау себебім!
Dialogue: 0,0:58:27.83,0:58:28.71,Default,,0,0,0,,Ei
Dialogue: 0,0:58:28.71,0:58:28.79,Default,,0,0,0,,Менің судья болып сайланбау себебім!
Dialogue: 0,0:58:28.79,0:58:30.67,Default,,0,0,0,,Менің судья болып сайланбау себебім!
Dialogue: 0,0:58:28.79,0:58:30.67,Default,,0,0,0,,(Тренингтердің шуы)
Dialogue: 0,0:58:30.67,0:58:30.75,Default,,0,0,0,,Менің судья болып сайланбау себебім!
Dialogue: 0,0:58:30.75,0:58:31.21,Default,,0,0,0,,Менің судья болып сайланбау себебім!
Dialogue: 0,0:58:30.75,0:58:31.21,Default,,0,0,0,,Тыныш бол!
Dialogue: 0,0:58:31.21,0:58:31.29,Default,,0,0,0,,Тыныш бол!
Dialogue: 0,0:58:31.29,0:58:32.30,Default,,0,0,0,,Тыныш бол!
Dialogue: 0,0:58:31.29,0:58:32.30,Default,,0,0,0,,Еш себепсіз мен сізге судья болу миссиясын бердім...
Dialogue: 0,0:58:32.30,0:58:32.38,Default,,0,0,0,,Еш себепсіз мен сізге судья болу миссиясын бердім...
Dialogue: 0,0:58:32.38,0:58:33.21,Default,,0,0,0,,Еш себепсіз мен сізге судья болу миссиясын бердім...
Dialogue: 0,0:58:32.38,0:58:33.21,Default,,0,0,0,,Күші жойылды!
Dialogue: 0,0:58:33.21,0:58:33.30,Default,,0,0,0,,Еш себепсіз мен сізге судья болу миссиясын бердім...
Dialogue: 0,0:58:33.30,0:58:34.71,Default,,0,0,0,,Еш себепсіз мен сізге судья болу миссиясын бердім...
Dialogue: 0,0:58:33.30,0:58:34.71,Default,,0,0,0,,Мұнда тыңдаушылар күтіп тұр!
Dialogue: 0,0:58:34.80,0:58:37.47,Default,,0,0,0,,Миссияны алып тастау... Оны алып тастау!
Dialogue: 0,0:58:37.55,0:58:41.72,Default,,0,0,0,,Мен кешіре алмаймын, кешіре алмаймын, кешіре алмаймын!
Dialogue: 0,0:58:43.72,0:58:48.60,Default,,0,0,0,,Бұл әрекет өзін-өзі қанағаттандыратын әділеттілік сезімімен басқарылатын бақылаудан тыс әрекет ретінде қарастырылады.
Dialogue: 0,0:58:48.69,0:58:50.48,Default,,0,0,0,,Судьяны былай қойғанда...
Dialogue: 0,0:58:50.56,0:58:55.49,Default,,0,0,0,,Маған заңгер болуға мүмкіндік болмады, менің судьялық мансабым аяқталды.
Dialogue: 0,0:58:56.19,0:58:58.36,Default,,0,0,0,,Неліктен Хаба мырзаны кеңсе қызметкері еттіңіз?
Dialogue: 0,0:59:00.49,0:59:03.62,Default,,0,0,0,,Әр адамның екі жағы бар.
Dialogue: 0,0:59:04.24,0:59:07.50,Default,,0,0,0,,Сіз көріп отырған нәрсе оның бір жағы ғана.
Dialogue: 0,0:59:12.59,0:59:15.51,Default,,0,0,0,,Сырттан қызымның аузынан естідім.
Dialogue: 0,0:59:15.59,0:59:19.63,Default,,0,0,0,,Мори мырзаны қудаламаса, мен онымен біттім.
Dialogue: 0,0:59:19.72,0:59:21.76,Default,,0,0,0,,Иә? Жақсы... жақсы
Dialogue: 0,0:59:23.85,0:59:24.76,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:59:27.06,0:59:30.48,Default,,0,0,0,,Менің де зерттеуім қалды.
Dialogue: 0,0:59:30.56,0:59:32.86,Default,,0,0,0,,Сіз кінәлі Нұхты тергеуге барасыз, солай ма?
Dialogue: 0,0:59:32.94,0:59:36.15,Default,,0,0,0,,Иә, біз NAZU-дан тергеумен ынтымақтасуды сұрадық.
Dialogue: 0,0:59:36.23,0:59:38.65,Default,,0,0,0,,NAZU американдық па?
Dialogue: 0,0:59:38.74,0:59:39.90,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:59:39.99,0:59:44.16,Default,,0,0,0,,NAZU-да өткен жылы Нұхты пайдаланып рұқсатсыз кіру оқиғасы болды.
Dialogue: 0,0:59:44.24,0:59:47.41,Default,,0,0,0,,Аа, Сакако-сенсэй мені қорғады...
Dialogue: 0,0:59:47.50,0:59:49.21,Default,,0,0,0,,Бұл басталды
Dialogue: 0,0:59:49.29,0:59:51.67,Default,,0,0,0,,Ноа пайдаланушыны қадағалау жүйесі
Dialogue: 0,0:59:51.75,0:59:53.75,Default,,0,0,0,,НАЗУ-да аяқталды.
Dialogue: 0,0:59:53.84,0:59:56.17,Default,,0,0,0,,Мен оны ертеңнен бастап талдаймын.
Dialogue: 0,0:59:56.25,0:59:57.76,Default,,0,0,0,,NAZU бүгін -
Dialogue: 0,0:59:57.84,1:00:01.18,Default,,0,0,0,,Мен аққуды суға қондыру миссиясымен айналысамын.
Dialogue: 0,1:00:01.26,1:00:04.05,Default,,0,0,0,,Сіз ұшқышсыз зонд туралы айтып отырсыз, солай ма?
Dialogue: 0,1:00:04.14,1:00:06.85,Default,,0,0,0,,Әй, сол күн мен саммит сәйкес келді.
Dialogue: 0,1:00:06.93,1:00:08.56,Default,,0,0,0,,Елордалық полиция департаменті де қиыншылықта.
Dialogue: 0,1:00:08.64,1:00:12.60,Default,,0,0,0,,Көрдім, саммит бүгін басталады...
Dialogue: 0,1:00:13.40,1:00:14.48,Default,,0,0,0,,Ах
Dialogue: 0,1:00:15.86,1:00:19.57,Default,,0,0,0,,Жарылыс кезінде Қоғамдық қауіпсіздік министрлігі жауапты болды.
Dialogue: 0,1:00:19.65,1:00:20.61,Default,,0,0,0,,Ашығын айтқанда
Dialogue: 0,1:00:20.70,1:00:24.87,Default,,0,0,0,,Прокурорлар қамтамасыз ететін қоғамдық қауіпсіздік полиция қамтамасыз ететін қоғамдық қауіпсіздікке сәйкес келмейді.
Dialogue: 0,1:00:24.95,1:00:30.12,Default,,0,0,0,,Сондықтан қылмыстық қудалау кезінде қоғамдық қауіпсіздікті ескеру қажет болатын кездер болады.
Dialogue: 0,1:00:30.20,1:00:34.50,Default,,0,0,0,,Қоғамдық қауіпсіздік полициясының көптеген әріптестері бар.
Dialogue: 0,1:00:35.54,1:00:37.21,Default,,0,0,0,,Сакако-сенсэйдің қоңырау үні?
Dialogue: 0,1:00:38.17,1:00:40.76,Default,,0,0,0,,Неліктен детектив Казамидің тыңдау құрылғысы...
Dialogue: 0,1:00:41.26,1:00:43.68,Default,,0,0,0,,Сіз айтып отырған Амуро есімді адам
Dialogue: 0,1:00:43.76,1:00:45.14,Default,,0,0,0,,Кісі өлтіруші
Dialogue: 0,1:00:46.22,1:00:50.68,Default,,0,0,0,,Хаба прокуратураға жіберілгеннен кейін ол уақытша ұстау изоляторында өз-өзіне қол жұмсады.
Dialogue: 0,1:00:50.77,1:00:52.81,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,1:00:53.35,1:00:56.02,Default,,0,0,0,,А, мен бұл оқиғаны білемін.
Dialogue: 0,1:00:56.11,1:00:57.65,Default,,0,0,0,,NAZU рұқсатсыз кіру оқиғасы
Dialogue: 0,1:00:57.73,1:00:59.07,Default,,0,0,0,,IoT терроризмі?
Dialogue: 0,1:00:59.15,1:01:00.90,Default,,0,0,0,,Интернетке кіре алатын электр құрылғылары
Dialogue: 0,1:01:00.99,1:01:02.74,Default,,0,0,0,,Ол жабайы жұмыс істеуге мүмкіндік береді!
Dialogue: 0,1:01:02.82,1:01:04.78,Default,,0,0,0,,Полицияның тергеу материалдары
Dialogue: 0,1:01:04.86,1:01:07.62,Default,,0,0,0,,Бұл қылмыс туралы егжей-тегжейлі нұсқаулық сияқты.
Dialogue: 0,1:01:07.70,1:01:10.29,Default,,0,0,0,,Иә, сәйкестік болды.
Dialogue: 0,1:01:10.79,1:01:12.71,Default,,0,0,0,,Мен оны бір жерден көргендей сезінемін...
Dialogue: 0,1:01:14.87,1:01:17.71,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:01:18.84,1:01:20.46,Default,,0,0,0,,-Мидори-сан! - (Жасыл) Уау
Dialogue: 0,1:01:20.55,1:01:22.84,Default,,0,0,0,,NAZU рұқсатсыз кіру оқиғасы туралы толық ақпарат
Dialogue: 0,1:01:22.92,1:01:24.18,Default,,0,0,0,,Оны бірден смартфонға жіберіңіз!
Dialogue: 0,1:01:24.26,1:01:25.09,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:25.18,1:01:27.22,Default,,0,0,0,,Шиничи-нии-чан осылай деді!
Dialogue: 0,1:01:29.85,1:01:31.10,Default,,0,0,0,,Ах, Конан-кун.
Dialogue: 0,1:01:31.18,1:01:35.31,Default,,0,0,0,,Мен әкемді алып кету үшін қалалық полиция бөліміне бара жатырмын...
Dialogue: 0,1:01:35.81,1:01:36.94,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,1:01:37.44,1:01:40.11,Default,,0,0,0,,Неліктен Шиничи телефонға жауап бермейді?
Dialogue: 0,1:01:46.61,1:01:48.03,Default,,0,0,0,,Хмм
Dialogue: 0,1:01:55.46,1:01:56.29,Default,,0,0,0,,Хмм
Dialogue: 0,1:02:03.80,1:02:06.59,Default,,0,0,0,,Менің келетінімді білген сияқтысың.
Dialogue: 0,1:02:06.68,1:02:09.60,Default,,0,0,0,,Мен алғаш рет біртүрлі нәрсені байқадым.
Dialogue: 0,1:02:15.89,1:02:18.19,Default,,0,0,0,,- (Казами) Кешіріңіз - (Жүгіріп) А... А, иә.
Dialogue: 0,1:02:24.53,1:02:28.70,Default,,0,0,0,,Дәрігерден оны қарап шығуды сұрағанымда, қашықтан басқару құралы орнатылған.
Dialogue: 0,1:02:28.78,1:02:31.33,Default,,0,0,0,,Бұл белгішені қалдырмайтын түрі.
Dialogue: 0,1:02:31.95,1:02:33.83,Default,,0,0,0,,Қоғамдық қауіпсіздік органдары қандай дәлелдер келтірді?
Dialogue: 0,1:02:33.91,1:02:36.62,Default,,0,0,0,,Күткендей болған жоқ.
Dialogue: 0,1:02:36.71,1:02:40.08,Default,,0,0,0,,Енді сіз білесіз бе, неге қолданбаны жоймадыңыз?
Dialogue: 0,1:02:40.17,1:02:42.59,Default,,0,0,0,,Мен қылмыскермен кездесейін деп жатырмын.
Dialogue: 0,1:02:42.67,1:02:44.46,Default,,0,0,0,,Террористік актіні жасаған адам болуы мүмкін бе?
Dialogue: 0,1:02:44.55,1:02:46.92,Default,,0,0,0,,Иә, мотив де.
Dialogue: 0,1:02:47.47,1:02:48.76,Default,,0,0,0,,Мотив
Dialogue: 0,1:02:49.76,1:02:51.85,Default,,0,0,0,,Амуро мырза, бұл сендерсіңдер.
Dialogue: 0,1:02:51.93,1:02:53.35,Default,,0,0,0,,Хмм...
Dialogue: 0,1:02:53.43,1:02:57.10,Default,,0,0,0,,Мұның бәрі NAZU рұқсатсыз кіру оқиғасынан басталды.
Dialogue: 0,1:02:57.19,1:02:59.40,Default,,0,0,0,,Бұл өткен жылы болған...
Dialogue: 0,1:02:59.48,1:03:01.94,Default,,0,0,0,,Ха, Фуми Хаба?
Dialogue: 0,1:03:02.02,1:03:06.86,Default,,0,0,0,,Иә, Хаба мырза өткен жылы тергеу изоляторында өз-өзіне қол жұмсады.
Dialogue: 0,1:03:06.94,1:03:10.53,Default,,0,0,0,,Аа, өткен жылы бүгін болды.
Dialogue: 0,1:03:10.62,1:03:13.53,Default,,0,0,0,,Өткен жылы... бүгін!?
Dialogue: 0,1:03:14.45,1:03:17.04,Default,,0,0,0,,О, құдайым
Dialogue: 0,1:03:17.12,1:03:20.54,Default,,0,0,0,,Қылмыскердің кек алуы әлі бітпегеніне сенімдімін!
Dialogue: 0,1:03:22.34,1:03:23.46,Default,,0,0,0,,Уф
Dialogue: 0,1:03:28.55,1:03:29.76,Default,,0,0,0,,Иә? иә?
Dialogue: 0,1:03:29.84,1:03:30.93,Default,,0,0,0,,Иә!
Dialogue: 0,1:03:34.93,1:03:35.97,Default,,0,0,0,,Уф!
Dialogue: 0,1:03:36.06,1:03:37.02,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,1:03:38.39,1:03:39.81,Default,,0,0,0,,IoT терроризмі?
Dialogue: 0,1:03:41.23,1:03:43.65,Default,,0,0,0,,А... иә?
Dialogue: 0,1:03:45.23,1:03:46.57,Default,,0,0,0,,Уф
Dialogue: 0,1:03:49.65,1:03:51.32,Default,,0,0,0,,Уф...
Dialogue: 0,1:03:52.11,1:03:54.49,Default,,0,0,0,,Уф... уф.
Dialogue: 0,1:03:56.58,1:03:59.21,Default,,0,0,0,,Ууууууууууу!
Dialogue: 0,1:04:01.08,1:04:02.17,Default,,0,0,0,,Уф
Dialogue: 0,1:04:04.38,1:04:05.29,Default,,0,0,0,,Ах
Dialogue: 0,1:04:09.30,1:04:10.34,Default,,0,0,0,,Уф
Dialogue: 0,1:04:12.68,1:04:13.84,Default,,0,0,0,,Амуро-сан!
Dialogue: 0,1:04:17.93,1:04:20.35,Default,,0,0,0,,Ой, ой!
Dialogue: 0,1:04:20.43,1:04:23.02,Default,,0,0,0,,- (Амуро) Жүр! -Хмм
Dialogue: 0,1:04:27.61,1:04:30.44,Default,,0,0,0,,Марстан Жерге оралу
Dialogue: 0,1:04:30.53,1:04:32.53,Default,,0,0,0,,Хакучо ұшқышсыз зонд
Dialogue: 0,1:04:32.61,1:04:34.28,Default,,0,0,0,,Баршаңызға қайырлы кеш
Dialogue: 0,1:04:34.37,1:04:37.03,Default,,0,0,0,,Бұл Нагано префектурасының Ұлттық астрономиялық обсерваториясы.
Dialogue: 0,1:04:38.87,1:04:41.54,Default,,0,0,0,,Уа, бұл ұзақ болды
Dialogue: 0,1:04:41.62,1:04:42.83,Default,,0,0,0,,Мен оны сізге жіберемін.
Dialogue: 0,1:04:42.92,1:04:44.08,Default,,0,0,0,,Е...
Dialogue: 0,1:04:44.17,1:04:46.71,Default,,0,0,0,,Аққу жақында қайтады ма?
Dialogue: 0,1:04:46.79,1:04:48.80,Default,,0,0,0,,Маған теледидар хабарын көрсетіңізші.
Dialogue: 0,1:04:48.88,1:04:50.01,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:04:50.09,1:04:52.05,Default,,0,0,0,,Жоқ, оны үйде көріңіз.
Dialogue: 0,1:04:52.13,1:04:53.26,Default,,0,0,0,,-(Аюми) Эх~ -(Мицухико) Бұл Хайбара мырза.
Dialogue: 0,1:04:53.26,1:04:54.89,Default,,0,0,0,,-(Аюми) Эх~ -(Мицухико) Бұл Хайбара мырза.
Dialogue: 0,1:04:53.26,1:04:54.89,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:04:54.89,1:04:54.97,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:04:54.97,1:04:55.43,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:04:54.97,1:04:55.43,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:55.43,1:04:56.26,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:57.64,1:04:59.93,Default,,0,0,0,,О, не болды?
Dialogue: 0,1:05:01.02,1:05:05.19,Default,,0,0,0,,А, онда балалар эфирді көргісі келеді.
Dialogue: 0,1:05:05.27,1:05:07.65,Default,,0,0,0,,Иә? Атмосфераға кіруге дейін қанша уақыт бар?
Dialogue: 0,1:05:07.65,1:05:08.73,Default,,0,0,0,,Иә? Атмосфераға кіруге дейін қанша уақыт бар?
Dialogue: 0,1:05:07.65,1:05:08.73,Default,,0,0,0,,Га
Dialogue: 0,1:05:09.23,1:05:10.99,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,1:05:11.07,1:05:12.45,Default,,0,0,0,,Кудо-кун?
Dialogue: 0,1:05:13.32,1:05:16.32,Default,,0,0,0,,Бір сағаттан аз қалды ма? Менің уақытым жоқ
Dialogue: 0,1:05:16.41,1:05:18.83,Default,,0,0,0,,Конан-кун, кінәлі күткендей.
Dialogue: 0,1:05:18.91,1:05:22.91,Default,,0,0,0,,А, мен NAZU-ға рұқсатсыз кіруді және оны тастауды жоспарлап отырмын.
Dialogue: 0,1:05:23.00,1:05:24.25,Default,,0,0,0,,Бірақ дәл қайда?
Dialogue: 0,1:05:24.33,1:05:26.17,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:05:26.25,1:05:27.50,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:05:29.21,1:05:30.80,Default,,0,0,0,,Ғарыштан не бар?
Dialogue: 0,1:05:38.26,1:05:39.26,Default,,0,0,0,,О, міне!
Dialogue: 0,1:05:39.85,1:05:40.97,Default,,0,0,0,,Ағай!
Dialogue: 0,1:05:41.06,1:05:42.02,Default,,0,0,0,,Ах
Dialogue: 0,1:05:42.10,1:05:43.02,Default,,0,0,0,,Әке!
Dialogue: 0,1:05:43.10,1:05:44.77,Default,,0,0,0,,- (Когоро) Ой, о - (Такаги) Аха
Dialogue: 0,1:05:44.85,1:05:45.94,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:05:46.02,1:05:49.19,Default,,0,0,0,,Хмм, сен мені алаңдаттың, Ран.
Dialogue: 0,1:05:49.27,1:05:51.69,Default,,0,0,0,,Өте жақсы.
Dialogue: 0,1:05:52.40,1:05:55.70,Default,,0,0,0,,Сондай-ақ, Эри, мен бәрі үшін кешірім сұраймын.
Dialogue: 0,1:05:55.78,1:05:57.45,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,1:05:58.03,1:06:00.20,Default,,0,0,0,,Сізге жақсы жүгірді
Dialogue: 0,1:06:00.91,1:06:03.12,Default,,0,0,0,,Рахмет Соноко
Dialogue: 0,1:06:03.20,1:06:05.04,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,1:06:05.12,1:06:08.50,Default,,0,0,0,,Осы әсерлі көріністі жұмбақтарға да жіберейік.
Dialogue: 0,1:06:08.58,1:06:10.21,Default,,0,0,0,,- (Такаги) А, онда мен... - (Жүгіріп) Эй, Соноко.
Dialogue: 0,1:06:10.21,1:06:10.88,Default,,0,0,0,,- (Такаги) А, онда мен... - (Жүгіріп) Эй, Соноко.
Dialogue: 0,1:06:10.21,1:06:10.88,Default,,0,0,0,,(Когораның Секібарайы)
Dialogue: 0,1:06:10.88,1:06:10.96,Default,,0,0,0,,(Когораның Секібарайы)
Dialogue: 0,1:06:10.96,1:06:11.84,Default,,0,0,0,,(Когораның Секібарайы)
Dialogue: 0,1:06:10.96,1:06:11.84,Default,,0,0,0,,Біз сізге қазір хабарласуымыз керек.
Dialogue: 0,1:06:11.84,1:06:11.92,Default,,0,0,0,,Біз сізбен қазір байланысуымыз керек.
Dialogue: 0,1:06:11.92,1:06:12.96,Default,,0,0,0,,Біз сізге қазір хабарласуымыз керек.
Dialogue: 0,1:06:11.92,1:06:12.96,Default,,0,0,0,,Мұндай емес қой. (Миямура) Шынымен бе?
Dialogue: 0,1:06:12.96,1:06:13.05,Default,,0,0,0,,Мұндай емес қой. (Миямура) Шынымен бе?
Dialogue: 0,1:06:13.05,1:06:13.80,Default,,0,0,0,,Мұндай емес қой. (Миямура) Шынымен бе?
Dialogue: 0,1:06:13.05,1:06:13.80,Default,,0,0,0,,Жоғары ірімшік
Dialogue: 0,1:06:13.80,1:06:15.05,Default,,0,0,0,,Жоғары ірімшік
Dialogue: 0,1:06:15.13,1:06:16.01,Default,,0,0,0,,- (Ран) Ах - (Соноко) О
Dialogue: 0,1:06:19.10,1:06:21.01,Default,,0,0,0,,(Детективтердің әбігері)
Dialogue: 0,1:06:21.10,1:06:23.77,Default,,0,0,0,,Біреу маған қосалқы жарық беріңізші.
Dialogue: 0,1:06:23.85,1:06:27.02,Default,,0,0,0,,Инспектор, апаттық қуат көзі жойылған сияқты.
Dialogue: 0,1:06:27.10,1:06:27.94,Default,,0,0,0,,Не?
Dialogue: 0,1:06:28.02,1:06:30.23,Default,,0,0,0,,Қарғыс атқыр, не болады?
Dialogue: 0,1:06:30.23,1:06:31.07,Default,,0,0,0,,Қарғыс атқыр, не болады?
Dialogue: 0,1:06:30.23,1:06:31.07,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:06:32.40,1:06:33.44,Default,,0,0,0,,NAZU баяндамасы
Dialogue: 0,1:06:33.53,1:06:36.61,Default,,0,0,0,,Ұшқышсыз ғарыш аппараттарына рұқсатсыз кіру расталды
Dialogue: 0,1:06:37.28,1:06:38.24,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,1:06:38.32,1:06:39.82,Default,,0,0,0,,Хаа… Хаа… Хаа…
Dialogue: 0,1:06:39.91,1:06:42.49,Default,,0,0,0,,Капсуланы бөлуге болмайтын сияқты.
Dialogue: 0,1:06:43.74,1:06:44.75,Default,,0,0,0,,Аққу денесі
Dialogue: 0,1:06:44.83,1:06:47.00,Default,,0,0,0,,Атмосферада жанып кетеді
Dialogue: 0,1:06:47.08,1:06:49.75,Default,,0,0,0,,Капсуланың түсу нүктесі өшірілген болып шықты.
Dialogue: 0,1:06:49.83,1:06:51.50,Default,,0,0,0,,НАЗУ-да әбігер болған сияқты.
Dialogue: 0,1:06:52.34,1:06:55.01,Default,,0,0,0,,Күзді болжаудың соңғы деректерін жіберіңіз
Dialogue: 0,1:06:55.80,1:06:59.97,Default,,0,0,0,,Бойлық 139 градус 45 минут 8,405 секунд шығыс
Dialogue: 0,1:07:00.85,1:07:02.97,Default,,0,0,0,,NAZU бойынша күтілетін құлау нүктесі болып табылады
Dialogue: 0,1:07:03.93,1:07:05.77,Default,,0,0,0,,Не, мына жер...
Dialogue: 0,1:07:05.85,1:07:07.18,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:07.81,1:07:09.06,Default,,0,0,0,,О, тәңірім
Dialogue: 0,1:07:09.90,1:07:11.15,Default,,0,0,0,,Конан-кун!
Dialogue: 0,1:07:11.23,1:07:12.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:12.15,1:07:15.36,Default,,0,0,0,,Ха, қылмыскердің мақсаты...
Dialogue: 0,1:07:17.86,1:07:19.36,Default,,0,0,0,,Елордалық полиция департаменті!
Dialogue: 0,1:07:19.45,1:07:22.87,Default,,0,0,0,,Қалалық полиция департаментіне капсула? Не болып жатыр!
Dialogue: 0,1:07:23.49,1:07:27.62,Default,,0,0,0,,Бұл жерге 4 метрден асатын капсула құласа
Dialogue: 0,1:07:27.71,1:07:29.75,Default,,0,0,0,,Зиянды елестету мүмкін емес!
Dialogue: 0,1:07:29.83,1:07:33.50,Default,,0,0,0,,Шұғыл түрде үлкен персоналды тасымалдау.
Dialogue: 0,1:07:33.59,1:07:38.09,Default,,0,0,0,,Елордалық полиция департаментінің айналасындағы 1 км радиуста дереу эвакуациялау
Dialogue: 0,1:07:38.17,1:07:39.38,Default,,0,0,0,,Иә!
Dialogue: 0,1:07:39.47,1:07:40.84,Default,,0,0,0,,Эй
Dialogue: 0,1:07:40.93,1:07:43.60,Default,,0,0,0,,- (Детектив) Эвакуациялық карта дегеніміз не? - (Детектив) Уақытымыз жоқ!
Dialogue: 0,1:07:43.68,1:07:45.10,Default,,0,0,0,,Әкем
Dialogue: 0,1:07:45.18,1:07:47.43,Default,,0,0,0,,Жарайды, мен сенімен біргемін.
Dialogue: 0,1:07:47.52,1:07:48.85,Default,,0,0,0,,Эри сен де
Dialogue: 0,1:07:49.52,1:07:51.10,Default,,0,0,0,,Менің қасымнан кетпе
Dialogue: 0,1:07:51.19,1:07:53.73,Default,,0,0,0,,Иә... иә
Dialogue: 0,1:07:54.32,1:07:56.23,Default,,0,0,0,,- (Соноко) Мен істеймін - (Жүгіріп) Ха... иә.
Dialogue: 0,1:07:57.36,1:07:59.61,Default,,0,0,0,,Ғарыш кемесінен бөлінген капсула
Dialogue: 0,1:07:59.70,1:08:01.78,Default,,0,0,0,,Тек метеорит сияқты құлау
Dialogue: 0,1:08:01.86,1:08:05.03,Default,,0,0,0,,Яғни, атмосфераға түскенге дейін аз ғана уақыт.
Dialogue: 0,1:08:05.12,1:08:06.99,Default,,0,0,0,,Орбитаны басқару мүмкін емес
Dialogue: 0,1:08:07.87,1:08:10.00,Default,,0,0,0,,Елордалық полиция бөлімінен 1 км қашықтықта—
Dialogue: 0,1:08:10.08,1:08:12.37,Default,,0,0,0,,Министрліктер мен ведомстволар Көптеген саябақтар мен қонақ үйлер
Dialogue: 0,1:08:13.00,1:08:15.54,Default,,0,0,0,,Эвакуацияланушылардың санын шамамен есептеңіз.
Dialogue: 0,1:08:15.63,1:08:17.30,Default,,0,0,0,,Шамамен 150 000 адам
Dialogue: 0,1:08:17.92,1:08:20.01,Default,,0,0,0,,Осыншама адамдарға пана ретінде —
Dialogue: 0,1:08:20.59,1:08:24.26,Default,,0,0,0,,Біз кандидаттардың 1 км қашықтықтағы орындар мен маршруттардың тізімін жасадық.
Dialogue: 0,1:08:24.35,1:08:27.52,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,1:08:28.22,1:08:29.23,Default,,0,0,0,,Премьер-министр
Dialogue: 0,1:08:29.31,1:08:30.73,Default,,0,0,0,,NAZU-дан жадты түзету
Dialogue: 0,1:08:30.81,1:08:32.52,Default,,0,0,0,,Бұл мүмкін емес деп хабарлаңыз
Dialogue: 0,1:08:32.60,1:08:33.85,Default,,0,0,0,,Не?
Dialogue: 0,1:08:33.94,1:08:37.61,Default,,0,0,0,,Жердегі станциядан ғарыш аппаратына жіберілетін сигнал нақты код болып табылады.
Dialogue: 0,1:08:37.69,1:08:39.53,Default,,0,0,0,,Ол шифрланған ба?
Dialogue: 0,1:08:40.11,1:08:41.90,Default,,0,0,0,,Код сәйкес келмесе
Dialogue: 0,1:08:41.99,1:08:44.66,Default,,0,0,0,,Жадты қайта жазу мүмкін емес сияқты.
Dialogue: 0,1:08:44.74,1:08:48.04,Default,,0,0,0,,Бұл кінәлі кодты өзгерткенін білдіре ме?
Dialogue: 0,1:08:48.12,1:08:52.67,Default,,0,0,0,,Ах, олар NAZU-ға заңсыз кіріп, ғарыш кемесінің орбитасын өзгерткен кезде.
Dialogue: 0,1:08:52.75,1:08:55.58,Default,,0,0,0,,Маған өзгертілген кодты есту керек
Dialogue: 0,1:08:55.67,1:08:58.17,Default,,0,0,0,,Осы мақсатта мен сенің серіктес болғаныңды қалаймын.
Dialogue: 0,1:08:58.96,1:09:01.42,Default,,0,0,0,,Осындай таңғажайып дүниелерді дамытатын дәрігерге
Dialogue: 0,1:09:02.01,1:09:03.30,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,1:09:05.22,1:09:08.31,Default,,0,0,0,,Өлгендерді қайтару
Dialogue: 0,1:09:12.39,1:09:16.81,Default,,0,0,0,,Яну күткендей, сіз осындай стратегия ойлап таптыңыз.
Dialogue: 0,1:09:17.40,1:09:20.15,Default,,0,0,0,,Мен кодты қазір естігім келеді.
Dialogue: 0,1:09:21.19,1:09:24.20,Default,,0,0,0,,Біз жылдамдықты одан әрі арттыра алдық.
Dialogue: 0,1:09:26.95,1:09:29.83,Default,,0,0,0,,Дәрігер, сурет дірілдеп тұр.
Dialogue: 0,1:09:30.45,1:09:32.58,Default,,0,0,0,,Бұл жұмыс істемейді.
Dialogue: 0,1:09:32.66,1:09:37.59,Default,,0,0,0,,Хмм, түнде бірінші рет ұшуым.
Dialogue: 0,1:09:37.67,1:09:40.96,Default,,0,0,0,,Әй, түнгі дрон, мұны да істе!
Dialogue: 0,1:09:41.05,1:09:43.22,Default,,0,0,0,,Ақылдылар ғана айлакер!
Dialogue: 0,1:09:43.30,1:09:44.97,Default,,0,0,0,,Балалар...
Dialogue: 0,1:09:45.05,1:09:48.76,Default,,0,0,0,,Теледидардан аққуды көре алмаймын!
Dialogue: 0,1:09:48.85,1:09:52.06,Default,,0,0,0,,Иә. Олай болса мен сенен бір жақсылық сұрасам бола ма?
Dialogue: 0,1:09:52.14,1:09:54.23,Default,,0,0,0,,Мен дәрігердің ұшқышы бола ма деп алаңдаймын.
Dialogue: 0,1:09:54.31,1:09:55.31,Default,,0,0,0,,Ахаха
Dialogue: 0,1:09:55.39,1:09:58.31,Default,,0,0,0,,- (Аюми) Уау, мен жасадым! -(Мицухико) Мен оны асыға күтемін!
Dialogue: 0,1:09:58.40,1:09:59.57,Default,,0,0,0,,Осы жерден айналып өтейік…
Dialogue: 0,1:09:59.65,1:10:01.40,Default,,0,0,0,,Сіз мұны айтып тұрсыз ба?
Dialogue: 0,1:10:02.19,1:10:06.91,Default,,0,0,0,,Мұны сол балаларға қалдырыңыз, дайындалайық.
Dialogue: 0,1:10:06.99,1:10:08.16,Default,,0,0,0,,Біз!
Dialogue: 0,1:10:08.24,1:10:09.41,Default,,0,0,0,,Дрон!
Dialogue: 0,1:10:09.49,1:10:11.04,Default,,0,0,0,,Ұшатын команда!
Dialogue: 0,1:10:11.12,1:10:13.50,Default,,0,0,0,,Польнарефф?
Dialogue: 0,1:10:18.46,1:10:22.80,Default,,0,0,0,,Енді Токио шығанағындағы полигонда шамамен 30 000 адам тұрады.
Dialogue: 0,1:10:22.88,1:10:24.84,Default,,0,0,0,,Мұхит жағасындағы пана
Dialogue: 0,1:10:24.92,1:10:27.34,Default,,0,0,0,,- (Әйел) Қай жерде? -(Әйел) Білмеймін.
Dialogue: 0,1:10:28.64,1:10:32.14,Default,,0,0,0,,Саммит өткізуді жоспарлаған жеріңіз осы болды ма?
Dialogue: 0,1:10:32.22,1:10:35.89,Default,,0,0,0,,Біз казино мұнарасын паналаймыз.
Dialogue: 0,1:10:36.77,1:10:38.27,Default,,0,0,0,,Казино мұнарасы?
Dialogue: 0,1:10:38.35,1:10:39.98,Default,,0,0,0,,О, мінекей.
Dialogue: 0,1:10:45.78,1:10:48.32,Default,,0,0,0,,Дұрыс, мен Шиничиге хабарласуым керек.
Dialogue: 0,1:10:48.41,1:10:51.33,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:11:01.79,1:11:03.50,Default,,0,0,0,,NAZU кодтарды жіберуді жалғастыруда, бірақ
Dialogue: 0,1:11:04.21,1:11:06.51,Default,,0,0,0,,Біз зондқа кіре алмайтын сияқтымыз.
Dialogue: 0,1:11:06.59,1:11:08.38,Default,,0,0,0,,Құрсын!
Dialogue: 0,1:11:09.80,1:11:12.35,Default,,0,0,0,,Кодты тез естуім керек!
Dialogue: 0,1:11:24.23,1:11:25.07,Default,,0,0,0,,Га
Dialogue: 0,1:11:27.86,1:11:28.70,Default,,0,0,0,,Хмм
Dialogue: 0,1:11:34.08,1:11:34.95,Default,,0,0,0,,Хмм
Dialogue: 0,1:11:42.33,1:11:45.84,Default,,0,0,0,,Бұл NAZU жерүсті станциясында көрсетілген деректер, солай емес пе?
Dialogue: 0,1:11:47.09,1:11:49.09,Default,,0,0,0,,Террорист
Dialogue: 0,1:11:50.13,1:11:52.18,Default,,0,0,0,,Хмм, аа, а...
Dialogue: 0,1:11:53.05,1:11:56.31,Default,,0,0,0,,Құсақабе прокурор, сіз екеніңізді білмедім.
Dialogue: 0,1:11:57.14,1:11:58.77,Default,,0,0,0,,Бұл не, балалар?
Dialogue: 0,1:11:58.85,1:12:01.90,Default,,0,0,0,,Мен ертерек байқаған болар едім.
Dialogue: 0,1:12:01.98,1:12:04.69,Default,,0,0,0,,Мен сіз сұраған дәлелдер тізімін көргенде.
Dialogue: 0,1:12:05.73,1:12:08.69,Default,,0,0,0,,Бұл шыны кесегі қылмыскер ғана білетін нақты нәрсе...
Dialogue: 0,1:12:08.78,1:12:10.74,Default,,0,0,0,,Бұл тұтандырғыш материалдың бөлігі болды.
Dialogue: 0,1:12:12.78,1:12:15.58,Default,,0,0,0,,Сіз мұны дәлел ретінде келтірдіңіз.
Dialogue: 0,1:12:15.66,1:12:19.83,Default,,0,0,0,,Пиротехника әлі де жоғары вольтты кабельдер деп есептелетін уақытта.
Dialogue: 0,1:12:19.91,1:12:21.29,Default,,0,0,0,,Уф...
Dialogue: 0,1:12:21.29,1:12:22.83,Default,,0,0,0,,Уф...
Dialogue: 0,1:12:21.29,1:12:22.83,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:12:22.92,1:12:24.96,Default,,0,0,0,,Жақсы уақыт
Dialogue: 0,1:12:25.04,1:12:27.84,Default,,0,0,0,,Өткен жылы орын алған NAZU рұқсатсыз кіру оқиғасына қатысты—
Dialogue: 0,1:12:27.92,1:12:29.21,Default,,0,0,0,,Сот құжаттары.
Dialogue: 0,1:12:29.30,1:12:30.59,Default,,0,0,0,,Сіз жауапты болдыңыз.
Dialogue: 0,1:12:31.38,1:12:35.85,Default,,0,0,0,,Мен түсінемін, бұл оқиғаның әдісі Нұхтың көмегімен рұқсатсыз кіру болды.
Dialogue: 0,1:12:36.47,1:12:39.43,Default,,0,0,0,,Мен жетекшілік еткен істің әдіс-тәсілдерін қолдану
Dialogue: 0,1:12:39.52,1:12:41.85,Default,,0,0,0,,Сіз кибертерроризм жасадыңыз, солай ма?
Dialogue: 0,1:12:41.94,1:12:43.48,Default,,0,0,0,,Уф...
Dialogue: 0,1:12:43.56,1:12:46.27,Default,,0,0,0,,Бірақ қате есеп болды.
Dialogue: 0,1:12:46.36,1:12:50.24,Default,,0,0,0,,NAZU қылмыскерлерді қадағалау жүйесін аяқтап қойған.
Dialogue: 0,1:12:50.32,1:12:54.49,Default,,0,0,0,,Мұны біле тұра, сіз оған қатені жасаған Ноа арқылы кірдіңіз.
Dialogue: 0,1:12:54.57,1:12:57.08,Default,,0,0,0,,IoT терроризмі болып көріну
Dialogue: 0,1:12:57.16,1:12:59.75,Default,,0,0,0,,Мен бастығымның смартфонын өртеп жібердім.
Dialogue: 0,1:12:59.83,1:13:03.75,Default,,0,0,0,,Манекенді полиция анықтауы үшін.
Dialogue: 0,1:13:03.83,1:13:04.96,Default,,0,0,0,,-(Құсақабе) Әй, а... -Солай...
Dialogue: 0,1:13:05.04,1:13:07.09,Default,,0,0,0,,IoT терроризмінің уақыты біртүрлі болды.
Dialogue: 0,1:13:07.09,1:13:07.92,Default,,0,0,0,,IoT терроризмінің уақыты біртүрлі болды.
Dialogue: 0,1:13:07.09,1:13:07.92,Default,,0,0,0,,Уф
Dialogue: 0,1:13:08.00,1:13:09.30,Default,,0,0,0,,Ах
Dialogue: 0,1:13:09.38,1:13:11.01,Default,,0,0,0,,Менің заттарыма рұқсатсыз тиіспе!
Dialogue: 0,1:13:11.09,1:13:11.92,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:13:25.56,1:13:28.44,Default,,0,0,0,,Сол смартфонда Нұхтың қолданылған іздері бар.
Dialogue: 0,1:13:28.52,1:13:29.82,Default,,0,0,0,,Мүлдем!
Dialogue: 0,1:13:36.41,1:13:38.24,Default,,0,0,0,,Маған қашуға рұқсат етіңіз!
Dialogue: 0,1:13:41.83,1:13:44.50,Default,,0,0,0,,Аххххх
Dialogue: 0,1:13:44.58,1:13:46.00,Default,,0,0,0,,Жоқ?
Dialogue: 0,1:13:46.67,1:13:47.96,Default,,0,0,0,,Мәселе жоқ!
Dialogue: 0,1:13:53.59,1:13:54.80,Default,,0,0,0,,Менің атым Джоэстар. Өмірімді сақтап қалғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,1:13:58.55,1:13:59.60,Default,,0,0,0,,- (Амуро) Уф - (Кусакабе) Шүкір!
Dialogue: 0,1:13:59.68,1:14:01.10,Default,,0,0,0,,- (Амуро) - (Кусакабе) Нува!
Dialogue: 0,1:14:01.18,1:14:02.77,Default,,0,0,0,,- (Амуро) - (Кусакабе) Гуха!
Dialogue: 0,1:14:03.60,1:14:04.69,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:04.77,1:14:05.77,Default,,0,0,0,,Прокурор Құсақабе
Dialogue: 0,1:14:05.85,1:14:10.77,Default,,0,0,0,,Сіздің терактіге шынымен де қоғамдық қауіпсіздік полициясы себеп болды ма?
Dialogue: 0,1:14:10.86,1:14:12.78,Default,,0,0,0,,Саммит өтетін орын жарылған.
Dialogue: 0,1:14:12.86,1:14:15.61,Default,,0,0,0,,Егер американдық зонд Токиоға түссе
Dialogue: 0,1:14:15.70,1:14:19.45,Default,,0,0,0,,Қоғамдық қауіпсіздік полициясының беделі толығымен жойылады.
Dialogue: 0,1:14:19.53,1:14:21.79,Default,,0,0,0,,Сіз қоғамдық қауіпсіздік полициясын неге сонша жек көресіз?
Dialogue: 0,1:14:22.45,1:14:24.87,Default,,0,0,0,,Құдіретің күшті болғанша
Dialogue: 0,1:14:24.96,1:14:28.29,Default,,0,0,0,,Біз, қоғамдық қауіпсіздік прокурорлары, әділдік орната алмаймыз!
Dialogue: 0,1:14:28.38,1:14:31.92,Default,,0,0,0,,Адамдардың әділдік үшін өлгені дұрыс па?
Dialogue: 0,1:14:32.00,1:14:34.42,Default,,0,0,0,,Бейбіт тұрғындарды өлтіру ниеті болмаған
Dialogue: 0,1:14:35.38,1:14:38.84,Default,,0,0,0,,Сондықтан олар тек қоғамдық қауіпсіздік полициясы болған кезде бомбалады.
Dialogue: 0,1:14:39.34,1:14:42.76,Default,,0,0,0,,Өлімге әкелуі екіталай IoT терроризмін таңдаңыз
Dialogue: 0,1:14:42.85,1:14:46.44,Default,,0,0,0,,Мен капсуланы тастау үшін де сол орынды таңдадым.
Dialogue: 0,1:14:48.19,1:14:53.19,Default,,0,0,0,,Ішіндегі бейбіт тұрғындарды эвакуациялау үшін елордалық полиция департаментінің электр қуатын өшірдіңіз бе?
Dialogue: 0,1:14:53.28,1:14:54.11,Default,,0,0,0,,О
Dialogue: 0,1:14:54.19,1:14:55.49,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:14:55.57,1:14:58.91,Default,,0,0,0,,Осы жолда IoT терроризмін тудырған адам
Dialogue: 0,1:14:58.99,1:15:00.53,Default,,0,0,0,,Адамдардың кіруін тоқтату
Dialogue: 0,1:15:00.62,1:15:03.45,Default,,0,0,0,,Десе де, біреуді құрбандыққа шалу мүмкіндігі бар.
Dialogue: 0,1:15:03.54,1:15:04.83,Default,,0,0,0,,Жеткілікті болуы керек!
Dialogue: 0,1:15:04.91,1:15:06.37,Default,,0,0,0,,Уф
Dialogue: 0,1:15:06.46,1:15:09.33,Default,,0,0,0,,Әділдік үшін кейбір құрбандықтардан құтылу мүмкін емес.
Dialogue: 0,1:15:09.42,1:15:11.34,Default,,0,0,0,,Бұл әділдік емес!
Dialogue: 0,1:15:13.59,1:15:14.84,Default,,0,0,0,,Менің...
Dialogue: 0,1:15:16.55,1:15:20.39,Default,,0,0,0,,Менің әріптестерім де құрбан болды.
Dialogue: 0,1:15:21.09,1:15:22.60,Default,,0,0,0,,- Хаба мырза - (Құсақабе) Ах.
Dialogue: 0,1:15:22.68,1:15:25.60,Default,,0,0,0,,Ол сіздің әріптесіңіз болды.
Dialogue: 0,1:15:25.68,1:15:27.60,Default,,0,0,0,,Неге... неге...
Dialogue: 0,1:15:28.19,1:15:30.23,Default,,0,0,0,,Бұл рұқсат коды PIN нөмірі.
Dialogue: 0,1:15:31.48,1:15:34.07,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,1:15:34.15,1:15:36.82,Default,,0,0,0,,Сирек болғандықтан қызық болдым.
Dialogue: 0,1:15:36.90,1:15:40.82,Default,,0,0,0,,Ұмытпау үшін кіріс дыбысын өшірмедің бе?
Dialogue: 0,1:15:41.32,1:15:42.91,Default,,0,0,0,,Нисан Хаба
Dialogue: 0,1:15:43.70,1:15:45.04,Default,,0,0,0,,Жоқ
Dialogue: 0,1:15:45.12,1:15:48.37,Default,,0,0,0,,Менің осы жігіттерден кек алуға деген құштарлығымды есте ұстау үшін!
Dialogue: 0,1:15:49.00,1:15:53.04,Default,,0,0,0,,Қоғамдық қауіпсіздік полициясының барлық қызметкерлері нөлге хабарланады.
Dialogue: 0,1:15:53.13,1:15:54.75,Default,,0,0,0,,Нөмір арқылы басқарылады
Dialogue: 0,1:15:54.84,1:15:59.47,Default,,0,0,0,,Алайда, қоғамдық қауіпсіздік тергеушілері бір-бірінің әріптестерін білмейді.
Dialogue: 0,1:15:59.55,1:16:02.93,Default,,0,0,0,,Сонымен қатар, қоғамдық қауіпсіздік прокурорының әріптестері бар ма еді?
Dialogue: 0,1:16:03.01,1:16:04.51,Default,,0,0,0,,Мен бұл туралы өткен жылға дейін білмедім.
Dialogue: 0,1:16:05.18,1:16:09.18,Default,,0,0,0,,Сол кезде сіз менің әріптестерімді кесіп тастадыңыз ғой!?
Dialogue: 0,1:16:09.27,1:16:11.98,Default,,0,0,0,,Түсіндім, бұл жерде арам ниет бар еді.
Dialogue: 0,1:16:12.06,1:16:14.94,Default,,0,0,0,,Хаба мырза өткен жылы жасаған ұрлық оқиғасына қатысты.
Dialogue: 0,1:16:15.02,1:16:18.19,Default,,0,0,0,,Сол... Мен Хабадан соны сұрадым.
Dialogue: 0,1:16:19.19,1:16:22.20,Default,,0,0,0,,NAZU рұқсатсыз кіру оқиғасын тергеу үшін
Dialogue: 0,1:16:22.82,1:16:24.45,Default,,0,0,0,,Егер қол жеткізу деректері
Dialogue: 0,1:16:24.53,1:16:28.87,Default,,0,0,0,,Хаба күдіктінің өзі келіп-кететін ойын компаниясында екенін білді.
Dialogue: 0,1:16:28.95,1:16:31.37,Default,,0,0,0,,Оны ұрлауға әрекеттену
Dialogue: 0,1:16:33.71,1:16:34.84,Default,,0,0,0,,Га
Dialogue: 0,1:16:41.84,1:16:43.51,Default,,0,0,0,,Қоғамдық қауіпсіздік саласындағы әріптестер
Dialogue: 0,1:16:43.59,1:16:46.56,Default,,0,0,0,,Заңсыз және қауіпті зерттеулер жүргізуге мәжбүрлеу
Dialogue: 0,1:16:46.64,1:16:47.47,Default,,0,0,0,,Ах
Dialogue: 0,1:16:47.56,1:16:49.18,Default,,0,0,0,,Саған үйрететін кез келді
Dialogue: 0,1:16:49.27,1:16:52.85,Default,,0,0,0,,Қоғамдық қауіпсіздік пен әріптестер арасындағы қарым-қатынас жақын туыстарға қарағанда күштірек.
Dialogue: 0,1:16:52.94,1:16:55.98,Default,,0,0,0,,Бұл тек ақшаға негізделген қарым-қатынас емес.
Dialogue: 0,1:16:56.73,1:17:00.49,Default,,0,0,0,,Біз шынымен бір жүрекпіз, миссия сезімімен байланыстырамыз.
Dialogue: 0,1:17:01.65,1:17:05.24,Default,,0,0,0,,Жауап алу кезінде неге менің әріптесім екеніңді айтпадың?
Dialogue: 0,1:17:05.32,1:17:07.12,Default,,0,0,0,,Менің қателігім үшін
Dialogue: 0,1:17:07.20,1:17:11.00,Default,,0,0,0,,Мен сіздің қоғамдық қауіпсіздік прокуроры статусыңызды алып тастай алмаймын.
Dialogue: 0,1:17:11.08,1:17:14.04,Default,,0,0,0,,Мен туралы емес, қазір өзім туралы көбірек.
Dialogue: 0,1:17:14.12,1:17:16.59,Default,,0,0,0,,Әділдік мәртебесінен айырылудың азабы
Dialogue: 0,1:17:16.67,1:17:18.42,Default,,0,0,0,,Мен бәрінен де көп білемін
Dialogue: 0,1:17:18.50,1:17:20.17,Default,,0,0,0,,Хмм
Dialogue: 0,1:17:20.26,1:17:24.13,Default,,0,0,0,,Өміріңіз туралы ойланыңыз!
Dialogue: 0,1:17:24.22,1:17:25.84,Default,,0,0,0,,Менің өмірімнен
Dialogue: 0,1:17:25.93,1:17:29.18,Default,,0,0,0,,Көптеген жапондықтардың өмірі әлдеқайда маңызды.
Dialogue: 0,1:17:29.26,1:17:30.27,Default,,0,0,0,,Уф
Dialogue: 0,1:17:30.35,1:17:31.93,Default,,0,0,0,,Мен үнемі айтатынмын
Dialogue: 0,1:17:32.02,1:17:35.48,Default,,0,0,0,,Сіздің амбицияңыз менікі сияқты.
Dialogue: 0,1:17:36.56,1:17:37.86,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,1:17:37.94,1:17:40.03,Default,,0,0,0,,Оның ұрлығы бойынша іс жүргізетін прокурорға.
Dialogue: 0,1:17:40.11,1:17:41.69,Default,,0,0,0,,Мен саған бәрін айттым
Dialogue: 0,1:17:42.40,1:17:44.57,Default,,0,0,0,,Хаба менің әріптесім.
Dialogue: 0,1:17:44.65,1:17:47.03,Default,,0,0,0,,Ол ұрлық жасады, өйткені мен...
Dialogue: 0,1:17:47.12,1:17:49.58,Default,,0,0,0,,- (Ивай) Сонда да мен оны жауапқа тартамын - (Кусакабе) Не?
Dialogue: 0,1:17:51.24,1:17:54.12,Default,,0,0,0,,Жоқ, мен тағы да қоғамдық қауіпсіздік полициясына барамын...
Dialogue: 0,1:17:54.21,1:17:55.50,Default,,0,0,0,,Қорықпа.
Dialogue: 0,1:17:55.58,1:17:57.96,Default,,0,0,0,,Оның аузынан атың шықпасын.
Dialogue: 0,1:17:58.04,1:18:00.88,Default,,0,0,0,,Мен сотта жақсы өнер көрсетемін.
Dialogue: 0,1:18:00.96,1:18:03.55,Default,,0,0,0,,Сенің айтып тұрғаның бұл емес!
Dialogue: 0,1:18:04.84,1:18:07.68,Default,,0,0,0,,Кейінірек мен қоғамдық қауіпсіздік полициясымен тікелей сөйлесуге тырыстым.
Dialogue: 0,1:18:07.76,1:18:09.39,Default,,0,0,0,,Мен елордалық полиция бөліміне бара жатқанда
Dialogue: 0,1:18:09.47,1:18:12.97,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:18:13.06,1:18:13.89,Default,,0,0,0,,Иә
Dialogue: 0,1:18:14.98,1:18:16.65,Default,,0,0,0,,Хаба өз-өзіне қол жұмсады.
Dialogue: 0,1:18:18.69,1:18:19.52,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:20.11,1:18:22.11,Default,,0,0,0,,Неге екенін білмеймін
Dialogue: 0,1:18:22.19,1:18:23.82,Default,,0,0,0,,Тергеу изоляторындағы қоғамдық қауіпсіздік полициясы
Dialogue: 0,1:18:23.90,1:18:26.53,Default,,0,0,0,,Ерекше жауап алудан кейін бірден.
Dialogue: 0,1:18:27.49,1:18:31.28,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:18:32.29,1:18:34.20,Default,,0,0,0,,Ха, уһ, ах
Dialogue: 0,1:18:34.29,1:18:35.71,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:40.71,1:18:42.21,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:44.30,1:18:47.72,Default,,0,0,0,,Уау!
Dialogue: 0,1:18:48.76,1:18:51.22,Default,,0,0,0,,Хабаны өз-өзіне қол жұмсауға не итермеледі...
Dialogue: 0,1:18:51.30,1:18:54.72,Default,,0,0,0,,Жоқ, оны өлтірген қоғамдық қауіпсіздік полициясы!
Dialogue: 0,1:18:56.27,1:18:59.81,Default,,0,0,0,,Сондықтан біз қалалық полиция департаментінде тергеуді тоқтатуды жоспарладық.
Dialogue: 0,1:18:59.90,1:19:04.36,Default,,0,0,0,,Әй, аққудың қайтқан күні Хабаның қайтыс болған күні екенін білгеннен бері.
Dialogue: 0,1:19:04.44,1:19:06.19,Default,,0,0,0,,IoT терроризмі туралы не деуге болады?
Dialogue: 0,1:19:06.28,1:19:07.86,Default,,0,0,0,,Бұл жоспарда жоқ, бірақ
Dialogue: 0,1:19:07.95,1:19:10.28,Default,,0,0,0,,Прокурор ретінде мен жазықсыз адамдарға қараймын.
Dialogue: 0,1:19:10.37,1:19:12.99,Default,,0,0,0,,Мен оның жауапқа тартылуына жол бере алмадым.
Dialogue: 0,1:19:13.08,1:19:16.12,Default,,0,0,0,,Когоро Моуридің кінәлі емес екенін дәлелдеу
Dialogue: 0,1:19:16.20,1:19:17.37,Default,,0,0,0,,IoT терроризмі?
Dialogue: 0,1:19:17.46,1:19:18.54,Default,,0,0,0,,О
Dialogue: 0,1:19:18.62,1:19:22.13,Default,,0,0,0,,Алайда залал көлемі күткеннен де асып түсті.
Dialogue: 0,1:19:23.04,1:19:26.05,Default,,0,0,0,,Мен бұдан былай қылмыс жасай алмаймын.
Dialogue: 0,1:19:26.13,1:19:28.88,Default,,0,0,0,,Маған рұқсатсыз кіру арқылы өзгертілген кодты айтыңыз.
Dialogue: 0,1:19:29.89,1:19:33.05,Default,,0,0,0,,Қоғамдық қауіпсіздік прокурорлары – әділеттілікті қорғайтын кәсіби мамандар.
Dialogue: 0,1:19:33.14,1:19:36.27,Default,,0,0,0,,Хаба сияқты әділеттілік жоғалмауы керек.
Dialogue: 0,1:19:36.35,1:19:37.85,Default,,0,0,0,,Кодты айтыңыз
Dialogue: 0,1:19:37.93,1:19:40.15,Default,,0,0,0,,Тек мені қамауға ал.
Dialogue: 0,1:19:40.23,1:19:42.69,Default,,0,0,0,,Жауап алу кезінде барлығын үнсіз қалдырыңыз
Dialogue: 0,1:19:42.77,1:19:44.65,Default,,0,0,0,,- Прокурор Құсақабе - (Құсақабе) Ах.
Dialogue: 0,1:19:47.86,1:19:49.40,Default,,0,0,0,,Құсақабе мырза
Dialogue: 0,1:19:51.78,1:19:52.66,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:19:52.74,1:19:54.66,Default,,0,0,0,,Неге Хаба!
Dialogue: 0,1:19:56.54,1:19:59.16,Default,,0,0,0,,Елордалық полиция департаментінің тікұшақ алаңынан тікелей түсірілім.
Dialogue: 0,1:19:59.92,1:20:01.29,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:20:01.88,1:20:05.17,Default,,0,0,0,,Одан тергеу изоляторында жауап алған қоғамдық қауіпсіздік полициясы
Dialogue: 0,1:20:05.25,1:20:07.63,Default,,0,0,0,,Өз-өзіне қол жұмсасын
Dialogue: 0,1:20:07.71,1:20:10.55,Default,,0,0,0,,Мен сені ескі өміріңнен бас тартуға мәжбүр еттім.
Dialogue: 0,1:20:10.63,1:20:13.72,Default,,0,0,0,,Мемлекеттік қауіпсіздік прокурорының кооператорды пайдалану фактісі
Dialogue: 0,1:20:13.80,1:20:15.76,Default,,0,0,0,,Жасыру
Dialogue: 0,1:20:15.85,1:20:20.19,Default,,0,0,0,,Және мемлекеттік қауіпсіздік прокуроры енді ешқашан кооператор жасамайтынына көз жеткізу.
Dialogue: 0,1:20:20.27,1:20:22.69,Default,,0,0,0,,Бұл да сізден жасырылды.
Dialogue: 0,1:20:23.52,1:20:27.94,Default,,0,0,0,,Мен кез келген заңсыз жұмысты өзім реттеймін.
Dialogue: 0,1:20:28.03,1:20:29.82,Default,,0,0,0,,Сізде ондай күш жоқ.
Dialogue: 0,1:20:29.90,1:20:31.28,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:31.36,1:20:34.16,Default,,0,0,0,,Мұны қоғамдық қауіпсіздік полициясы анықтады.
Dialogue: 0,1:20:34.91,1:20:39.41,Default,,0,0,0,,Хаба мырза өзінің судья болуы керек екеніне сенімді болды.
Dialogue: 0,1:20:39.50,1:20:41.33,Default,,0,0,0,,Оның әділдік сезімі күшті болды, солай ма?
Dialogue: 0,1:20:44.17,1:20:47.42,Default,,0,0,0,,Сондықтан мені судья стажеры ретінде жұмыстан шығарды.
Dialogue: 0,1:20:47.50,1:20:49.59,Default,,0,0,0,,Мен оны серіктес еттім, өйткені оның барар жері жоқ.
Dialogue: 0,1:20:49.67,1:20:52.80,Default,,0,0,0,,Дұрыс, Құсақабе мырза.
Dialogue: 0,1:20:52.88,1:20:55.85,Default,,0,0,0,,Мені өмір тұңғиығынан көтердің.
Dialogue: 0,1:20:56.93,1:21:00.81,Default,,0,0,0,,Қарым-қатынас екі жылға ғана созылғанымен, Құсақабе мырза
Dialogue: 0,1:21:00.89,1:21:05.11,Default,,0,0,0,,Ол маған сіздің арқаңызда мен қоғамдық қауіпсіздік прокуроры ретінде күресе алатынымды айтты.
Dialogue: 0,1:21:05.19,1:21:06.19,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,1:21:06.19,1:21:09.36,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,1:21:06.19,1:21:09.36,Default,,0,0,0,,Сондықтан мен әлі де осылай күресе аламын.
Dialogue: 0,1:21:10.03,1:21:13.45,Default,,0,0,0,,Құсақабе-сан, өзгертілген кодты айтыңызшы.
Dialogue: 0,1:21:13.53,1:21:14.36,Default,,0,0,0,,Ах
Dialogue: 0,1:21:14.45,1:21:18.03,Default,,0,0,0,,Құлап қалсаң, Хаба аман-есен шықпайды.
Dialogue: 0,1:21:18.12,1:21:20.75,Default,,0,0,0,,Ха, лас!
Dialogue: 0,1:21:20.83,1:21:23.42,Default,,0,0,0,,Қоғамдық қауіпсіздік полициясы осылай жұмыс істей ме?
Dialogue: 0,1:21:23.50,1:21:26.63,Default,,0,0,0,,Жақында аққу атмосфераға енеді
Dialogue: 0,1:21:26.71,1:21:28.42,Default,,0,0,0,,Әлі код жоқ!
Dialogue: 0,1:21:29.00,1:21:29.96,Default,,0,0,0,,Егер бұл жалғаса берсе
Dialogue: 0,1:21:30.05,1:21:31.92,Default,,0,0,0,,Сіз енді ғарыш кемесіне қол жеткізе алмайсыз.
Dialogue: 0,1:21:32.01,1:21:34.34,Default,,0,0,0,,Фуруя мырза, уақыт таяп қалды.
Dialogue: 0,1:21:34.43,1:21:36.89,Default,,0,0,0,,Цк, кодты тез айт!
Dialogue: 0,1:21:36.97,1:21:39.14,Default,,0,0,0,,Прокурор Құсақабе асығыңыз!
Dialogue: 0,1:21:39.22,1:21:42.89,Default,,0,0,0,,Уф... бірақ
Dialogue: 0,1:21:49.48,1:21:52.57,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,1:21:54.36,1:21:55.82,Default,,0,0,0,,- (Хаба) Құсақабе мырза - (Құсақабе) Ах.
Dialogue: 0,1:21:55.91,1:22:00.08,Default,,0,0,0,,Сенің әділдігің осы ма?
Dialogue: 0,1:22:00.16,1:22:01.62,Default,,0,0,0,,Ах
Dialogue: 0,1:22:04.92,1:22:06.83,Default,,0,0,0,,NAZU-ға рұқсатсыз кіру
Dialogue: 0,1:22:07.63,1:22:09.59,Default,,0,0,0,,Өзгертілген код...
Dialogue: 0,1:22:13.80,1:22:15.55,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,1:22:16.18,1:22:17.34,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,1:22:32.53,1:22:34.11,Default,,0,0,0,,Не! Қараңғы?
Dialogue: 0,1:22:34.19,1:22:39.12,Default,,0,0,0,,Иә, бұл атмосфераға енгеннен кейін бірден 5 минуттай қысқа мерзім.
Dialogue: 0,1:22:39.20,1:22:42.08,Default,,0,0,0,,Осы уақыт ішінде плазма түзіледі.
Dialogue: 0,1:22:42.16,1:22:44.20,Default,,0,0,0,,Байланыс күйін сақтау мүмкін емес
Dialogue: 0,1:22:44.29,1:22:47.87,Default,,0,0,0,,Олар траекторияның нақты түзетілгенін білмейтін сияқты.
Dialogue: 0,1:22:47.96,1:22:51.46,Default,,0,0,0,,Оның үстіне парашюттің ашылмау мүмкіндігі бар.
Dialogue: 0,1:22:51.54,1:22:52.50,Default,,0,0,0,,Міне!
Dialogue: 0,1:22:53.46,1:22:54.88,Default,,0,0,0,,Хаба...
Dialogue: 0,1:22:54.97,1:22:57.97,Default,,0,0,0,,Хабаны тез арада сол жерден эвакуациялаңыз!
Dialogue: 0,1:22:58.05,1:23:00.85,Default,,0,0,0,,Уф... Прокурор Құсақабе!
Dialogue: 0,1:23:04.89,1:23:06.94,Default,,0,0,0,,Сіз Шиничиден естідіңіз бе?
Dialogue: 0,1:23:07.02,1:23:10.40,Default,,0,0,0,,Жоқ, мен дауыстық пошта қалдырдым.
Dialogue: 0,1:23:10.48,1:23:13.48,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,1:23:13.57,1:23:16.61,Default,,0,0,0,,Конан-кунның да қуаты таусылған сияқты.
Dialogue: 0,1:23:16.70,1:23:19.86,Default,,0,0,0,,Әңгіме әлгі бәйбіше туралы, сондықтан бәрі жақсы болатынына сенімдімін.
Dialogue: 0,1:23:20.49,1:23:23.62,Default,,0,0,0,,Соған қарамастан, бұл таңғажайып биік.
Dialogue: 0,1:23:24.49,1:23:27.12,Default,,0,0,0,,Жүр, тез кетейік, мына жаққа.
Dialogue: 0,1:23:27.21,1:23:30.13,Default,,0,0,0,,(Құсақабенің ауыр тыныс алуы)
Dialogue: 0,1:23:32.00,1:23:33.63,Default,,0,0,0,,Хаба қайда!
Dialogue: 0,1:23:34.21,1:23:36.80,Default,,0,0,0,,Хаха...
Dialogue: 0,1:23:36.88,1:23:38.38,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:23:38.38,1:23:38.72,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:23:38.38,1:23:38.72,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:23:38.72,1:23:38.80,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:23:38.80,1:23:39.63,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:23:38.80,1:23:39.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:39.72,1:23:42.26,Default,,0,0,0,,Ол мұнда жоқ
Dialogue: 0,1:23:42.35,1:23:45.02,Default,,0,0,0,,Иә...бірақ бұл ұялы телефонда дұрыс.
Dialogue: 0,1:23:45.60,1:23:48.14,Default,,0,0,0,,Сіз қарап отырған нәрсе құрама сурет болды.
Dialogue: 0,1:23:48.23,1:23:49.39,Default,,0,0,0,,Уф...
Dialogue: 0,1:23:50.15,1:23:52.94,Default,,0,0,0,,Дронмен түсірілген кадрларды пайдалану
Dialogue: 0,1:23:53.02,1:23:56.65,Default,,0,0,0,,Мен сізді елордалық полиция департаментінің тікұшақ айлағында жүргендей етіп көрсеттім.
Dialogue: 0,1:23:57.28,1:23:59.65,Default,,0,0,0,,Ол қазір қауіпсіз жерде.
Dialogue: 0,1:24:02.70,1:24:04.03,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:24:04.12,1:24:08.04,Default,,0,0,0,,Амуро мырза, бағытыңызды түзете алмасаңыз ше?
Dialogue: 0,1:24:08.12,1:24:10.58,Default,,0,0,0,,Күтілгендей, төмендеу позициясы...
Dialogue: 0,1:24:10.67,1:24:14.29,Default,,0,0,0,,Ах, ұзындығы 4 метрден асатын капсула.
Dialogue: 0,1:24:14.38,1:24:17.67,Default,,0,0,0,,Ол мұнда секундына 10 километрден астам жылдамдықпен құлап жатыр.
Dialogue: 0,1:24:18.47,1:24:22.43,Default,,0,0,0,,Амуро мырза жарылғыш заттарды бірден ала ала ма?
Dialogue: 0,1:24:22.51,1:24:25.26,Default,,0,0,0,,Ыстыққа төзімді капсуланы жоюды жоспарлап отырсыз ба?
Dialogue: 0,1:24:25.35,1:24:26.18,Default,,0,0,0,,Жоқ
Dialogue: 0,1:24:26.93,1:24:30.35,Default,,0,0,0,,Тынық мұхитына дейін траекторияны өзгерту үшін жеткілікті жарылғыш заттар.
Dialogue: 0,1:24:30.44,1:24:31.90,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:32.44,1:24:34.65,Default,,0,0,0,,А, сен не ойлап тұрсың?
Dialogue: 0,1:24:35.27,1:24:37.19,Default,,0,0,0,,Басқа жол бар ма?
Dialogue: 0,1:24:38.57,1:24:41.03,Default,,0,0,0,,Казами, дереу қозғалыңыз.
Dialogue: 0,1:24:41.61,1:24:46.03,Default,,0,0,0,,Ах, бұл қоғамдық қауіпсіздікті жақсы білетін заңсыз жұмыс.
Dialogue: 0,1:24:52.17,1:24:55.38,Default,,0,0,0,,Қоғамдық қауіпсіздік сот-медициналық сараптамасы тәркілеген жарылғыш заттардың ішінде
Dialogue: 0,1:24:55.46,1:24:57.67,Default,,0,0,0,,Ең күшті
Dialogue: 0,1:24:57.75,1:24:59.30,Default,,0,0,0,,Тұра алмайсың ба?
Dialogue: 0,1:24:59.38,1:25:03.80,Default,,0,0,0,,Кәдеге жарату мерзімі жақындап келе жатқандықтан, сізге тек жазбаларды қайта жазу қажет.
Dialogue: 0,1:25:03.89,1:25:04.26,Default,,0,0,0,,Жарайды
Dialogue: 0,1:25:04.26,1:25:04.80,Default,,0,0,0,,Жарайды
Dialogue: 0,1:25:04.26,1:25:04.80,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,1:25:04.80,1:25:04.89,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,1:25:04.89,1:25:05.55,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,1:25:04.89,1:25:05.55,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:25:05.55,1:25:06.10,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:25:11.52,1:25:14.69,Default,,0,0,0,,Мәселе жоқ, бұл мекенжай
Dialogue: 0,1:25:14.77,1:25:17.32,Default,,0,0,0,,Капсуланың болжамды траектория деректерін жіберіңіз
Dialogue: 0,1:25:17.40,1:25:18.78,Default,,0,0,0,,Хмм...
Dialogue: 0,1:25:18.86,1:25:20.07,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,1:25:20.15,1:25:21.65,Default,,0,0,0,,Ұшайық!
Dialogue: 0,1:25:21.74,1:25:23.82,Default,,0,0,0,,- (Гента) Жарайды! -(Аюми) Иә.
Dialogue: 0,1:25:24.61,1:25:28.58,Default,,0,0,0,,Сіз оны қай жерде жару керектігін есептеп беруімді сұрасаңыз да.
Dialogue: 0,1:25:28.66,1:25:31.70,Default,,0,0,0,,Ол адамдармен өте қатал.
Dialogue: 0,1:25:32.50,1:25:33.58,Default,,0,0,0,,Хмм!
Dialogue: 0,1:25:33.67,1:25:34.79,Default,,0,0,0,,Уф...
Dialogue: 0,1:25:35.29,1:25:37.71,Default,,0,0,0,,Мицухико-кун Аюми-кун
Dialogue: 0,1:25:38.34,1:25:41.21,Default,,0,0,0,,Гента-кун мен Ай-кун
Dialogue: 0,1:25:42.17,1:25:45.22,Default,,0,0,0,,Балалар сендер бұл елді қорғайсыңдар.
Dialogue: 0,1:25:50.31,1:25:53.23,Default,,0,0,0,,Ұшақ тербеліп тұр.
Dialogue: 0,1:25:53.31,1:25:55.52,Default,,0,0,0,,Дәрігердің жүгі ауыр емес пе?
Dialogue: 0,1:25:55.60,1:25:57.65,Default,,0,0,0,,Осы жерде қалдырайық.
Dialogue: 0,1:25:57.73,1:25:58.98,Default,,0,0,0,,- (Ағаса) Жақсы... Жақсы! -Иә...
Dialogue: 0,1:25:59.07,1:26:03.40,Default,,0,0,0,,Сол жүк менің асыл қазынам!
Dialogue: 0,1:26:04.11,1:26:05.24,Default,,0,0,0,,Қателік шегі тең
Dialogue: 0,1:26:05.32,1:26:07.74,Default,,0,0,0,,Мен оны шамамен 10 метр радиусқа дейін тарылттым.
Dialogue: 0,1:26:08.66,1:26:10.49,Default,,0,0,0,,Мен сізге дроннан түсірілген кадрларды жіберемін.
Dialogue: 0,1:26:10.58,1:26:12.91,Default,,0,0,0,,Сол жерде уақытты реттеңіз.
Dialogue: 0,1:26:13.00,1:26:14.71,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:26:15.29,1:26:17.00,Default,,0,0,0,,- (Аюми) Бірақ шынымен жақсы ма? -Ах
Dialogue: 0,1:26:17.63,1:26:21.88,Default,,0,0,0,,Біз аққу капсуласын жақыннан суретке түсірдік.
Dialogue: 0,1:26:21.96,1:26:25.80,Default,,0,0,0,,Жарайды, полиция рұқсат берді.
Dialogue: 0,1:26:27.93,1:26:30.14,Default,,0,0,0,,Қоғамдық қауіпсіздік полициясы.
Dialogue: 0,1:26:30.97,1:26:31.97,Default,,0,0,0,,Ах
Dialogue: 0,1:26:50.70,1:26:51.91,Default,,0,0,0,,Не!?
Dialogue: 0,1:26:51.99,1:26:53.91,Default,,0,0,0,,Парашют шықпай ма?
Dialogue: 0,1:26:54.00,1:26:57.37,Default,,0,0,0,,Жылу қалқаны құлыпталған сияқты.
Dialogue: 0,1:26:57.46,1:27:00.00,Default,,0,0,0,,Премьер-министр, жою туралы бұйрық!
Dialogue: 0,1:27:00.08,1:27:01.17,Default,,0,0,0,,(Night Eye) Мен ойлағандай, «Барлығы Бір» шын мәнінде Миллиоға берілуі керек еді.
Dialogue: 0,1:27:01.88,1:27:03.05,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:27:03.13,1:27:07.22,Default,,0,0,0,,Осы биіктікте ұстап алу көбірек зиян келтіруі мүмкін...
Dialogue: 0,1:27:13.64,1:27:16.48,Default,,0,0,0,,30 000 метр биіктіктен өтті
Dialogue: 0,1:27:16.56,1:27:18.85,Default,,0,0,0,,Ә, қысқа үзіліс жасайық па?
Dialogue: 0,1:27:19.94,1:27:21.36,Default,,0,0,0,,Оны асыра алмаңыз
Dialogue: 0,1:27:22.36,1:27:24.11,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,1:27:24.69,1:27:25.78,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:27:26.53,1:27:27.61,Default,,0,0,0,,Амуро мырза
Dialogue: 0,1:27:28.40,1:27:30.20,Default,,0,0,0,,Осы арқылы уақытты біле аласыз ба?
Dialogue: 0,1:27:30.28,1:27:31.12,Default,,0,0,0,,О
Dialogue: 0,1:27:35.95,1:27:37.50,Default,,0,0,0,,Капсулаға жақындаңыз!
Dialogue: 0,1:27:38.12,1:27:39.75,Default,,0,0,0,,Мен оны сұрадым.
Dialogue: 0,1:27:40.83,1:27:41.92,Default,,0,0,0,,Балалар
Dialogue: 0,1:27:45.67,1:27:47.76,Default,,0,0,0,,Осылай жалғастырсақ, соқтығысамыз, солай ма?
Dialogue: 0,1:27:47.84,1:27:50.22,Default,,0,0,0,,Бұл... бәрібір.
Dialogue: 0,1:27:50.30,1:27:53.85,Default,,0,0,0,,Бұл дрон жақындап келе жатқан нысанды сезгенде,
Dialogue: 0,1:27:53.93,1:27:56.93,Default,,0,0,0,,Рұқсатсыз айналуға мүмкіндік беретін жүйемен жабдықталған.
Dialogue: 0,1:27:57.02,1:27:59.27,Default,,0,0,0,,Барлығымыз, жақындауымыз керек.
Dialogue: 0,1:27:59.35,1:28:01.31,Default,,0,0,0,,Капсула Сіз оның ұшып бара жатқанын көре алмайсыз.
Dialogue: 0,1:28:01.40,1:28:03.65,Default,,0,0,0,,- (Гента) Джи - (Аюми) Эх~ Мен оны көргім келеді!
Dialogue: 0,1:28:03.73,1:28:05.48,Default,,0,0,0,,Мицухико, жүр!
Dialogue: 0,1:28:05.57,1:28:06.82,Default,,0,0,0,,Сенің әрекетің тым балалық… немесе жай ғана қысқа көзді.
Dialogue: 0,1:28:10.03,1:28:13.83,Default,,0,0,0,,Кудо-кун, бұлай зорлық-зомбылық жасама.
Dialogue: 0,1:28:21.54,1:28:22.63,Default,,0,0,0,,Хмм
Dialogue: 0,1:28:27.71,1:28:30.63,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:28:38.43,1:28:39.73,Default,,0,0,0,,Келеді!
Dialogue: 0,1:28:41.31,1:28:44.02,Default,,0,0,0,,Бар... Бар!
Dialogue: 0,1:28:49.65,1:28:51.40,Default,,0,0,0,,Хмм (ұялы телефон рингтоны)
Dialogue: 0,1:29:11.34,1:29:13.84,Default,,0,0,0,,Парашют ашылды
Dialogue: 0,1:29:18.56,1:29:19.56,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:19.64,1:29:21.85,Default,,0,0,0,,Мен енді ештеңе көре алмаймын
Dialogue: 0,1:29:21.93,1:29:24.85,Default,,0,0,0,,Хмм, біз бір-бірімізді соқтығыстық деп ойлаймын, солай ма?
Dialogue: 0,1:29:24.94,1:29:28.02,Default,,0,0,0,,Бұл жүйе, оны қалауыңыз бойынша айналып өтуге болады, солай ма?
Dialogue: 0,1:29:28.11,1:29:30.36,Default,,0,0,0,,Иә, мүмкін.
Dialogue: 0,1:29:30.44,1:29:32.99,Default,,0,0,0,,Батарея біткен болуы мүмкін.
Dialogue: 0,1:29:33.07,1:29:36.12,Default,,0,0,0,,Менің айтайын дегенім, менде ондай жүйе жоқ.
Dialogue: 0,1:29:36.20,1:29:39.74,Default,,0,0,0,,Ха, жақсы өткен сияқты.
Dialogue: 0,1:29:39.83,1:29:41.62,Default,,0,0,0,,- (Хаба) Мен таң қалдым - (Хайбара) А.
Dialogue: 0,1:29:41.70,1:29:44.87,Default,,0,0,0,,Ал сендер ше...
Dialogue: 0,1:29:45.63,1:29:50.13,Default,,0,0,0,,Кішкентай детективтің әріптесі ме деп ойлаймын.
Dialogue: 0,1:29:50.21,1:29:51.88,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:52.72,1:29:54.01,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,1:29:55.09,1:29:56.30,Default,,0,0,0,,Бұл сәтті болды.
Dialogue: 0,1:29:56.39,1:29:57.93,Default,,0,0,0,,Жақсы
Dialogue: 0,1:29:58.01,1:29:59.39,Default,,0,0,0,,Фуруя мырза\NМенің ойымша, бұл
Dialogue: 0,1:30:00.06,1:30:02.02,Default,,0,0,0,,Қамау және алып кету
Dialogue: 0,1:30:02.10,1:30:02.98,Default,,0,0,0,,О
Dialogue: 0,1:30:03.06,1:30:04.27,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,1:30:07.19,1:30:08.02,Default,,0,0,0,,Құсақабе мырза
Dialogue: 0,1:30:09.11,1:30:12.28,Default,,0,0,0,,Біз әлі де бір рухтамыз
Dialogue: 0,1:30:14.32,1:30:15.40,Default,,0,0,0,,О
Dialogue: 0,1:30:15.95,1:30:17.28,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,1:30:18.57,1:30:19.53,Default,,0,0,0,,- (Сайко) Екі-үш-бір! -Не?
Dialogue: 0,1:30:20.20,1:30:21.04,Default,,0,0,0,,Сакайко!
Dialogue: 0,1:30:21.12,1:30:24.16,Default,,0,0,0,,Ах... 231
Dialogue: 0,1:30:24.87,1:30:28.17,Default,,0,0,0,,Мен оны тірі деп ойламаппын.
Dialogue: 0,1:30:28.25,1:30:32.05,Default,,0,0,0,,Ол өте қорқынышты адам.
Dialogue: 0,1:30:32.13,1:30:35.13,Default,,0,0,0,,Сіз де серіктес болдыңыз...
Dialogue: 0,1:30:35.97,1:30:38.30,Default,,0,0,0,,Бұл да қоғамдық қауіпсіздік прокуроры.
Dialogue: 0,1:30:43.14,1:30:44.81,Default,,0,0,0,,-Мистер Сайко - (Сайко) А?
Dialogue: 0,1:30:45.48,1:30:49.69,Default,,0,0,0,,Сіз де детектив Казамидің серіктесі болдыңыз.
Dialogue: 0,1:30:50.77,1:30:55.82,Default,,0,0,0,,Бала, мен сенің 231-ді неге жалдағаныңды естідім.
Dialogue: 0,1:30:56.95,1:30:59.62,Default,,0,0,0,,Судья стажеры қызметінен босатылған адамға
Dialogue: 0,1:30:59.70,1:31:03.20,Default,,0,0,0,,Қоғамдық қауіпсіздік полициясы оны қызығушылық танытқан адам ретінде атап өтті.
Dialogue: 0,1:31:04.66,1:31:07.46,Default,,0,0,0,,Сондықтан мен оны жұмысқа алдым
Dialogue: 0,1:31:07.54,1:31:10.13,Default,,0,0,0,,Әрекеттер туралы хабарлау бұйырылды
Dialogue: 0,1:31:11.84,1:31:14.55,Default,,0,0,0,,Бірақ екі және үш жұмыс істегенде
Dialogue: 0,1:31:14.63,1:31:18.05,Default,,0,0,0,,Неге екені белгісіз, мен оған қатты тартыла бастадым.
Dialogue: 0,1:31:18.84,1:31:20.64,Default,,0,0,0,,Мен де солай болдым
Dialogue: 0,1:31:22.05,1:31:26.56,Default,,0,0,0,,Сондықтан мен бұл жағдайға қатты өкінемін.
Dialogue: 0,1:31:28.14,1:31:31.36,Default,,0,0,0,,Ол мен сияқты әріптес болды.
Dialogue: 0,1:31:31.94,1:31:33.15,Default,,0,0,0,,Га
Dialogue: 0,1:31:34.65,1:31:39.03,Default,,0,0,0,,Барлығы NAZU рұқсатсыз кіру оқиғасынан басталды.
Dialogue: 0,1:31:39.11,1:31:39.95,Default,,0,0,0,,Иә
Dialogue: 0,1:31:40.99,1:31:44.41,Default,,0,0,0,,Қоғамдық қауіпсіздік бізге күдіктіні соттау керектігін айтады
Dialogue: 0,1:31:44.49,1:31:46.33,Default,,0,0,0,,Мен тергеу жүргіздім.
Dialogue: 0,1:31:47.25,1:31:50.79,Default,,0,0,0,,Мұндай жағдайда күдікті кіріп-шығатын ойын компаниясында.
Dialogue: 0,1:31:50.88,1:31:52.04,Default,,0,0,0,,Ол ұсталды
Dialogue: 0,1:31:54.21,1:31:58.47,Default,,0,0,0,,Мен оның неге олай істегенін түсінбедім.
Dialogue: 0,1:32:00.51,1:32:05.01,Default,,0,0,0,,Мен қоғамдық қауіпсіздік полициясынан оған көмектесуін сұрадым.
Dialogue: 0,1:32:05.10,1:32:06.81,Default,,0,0,0,,Бірақ ол өз-өзіне қол жұмсады
Dialogue: 0,1:32:07.68,1:32:10.44,Default,,0,0,0,,Мен қоғамдық қауіпсіздік полициясын жек көрдім.
Dialogue: 0,1:32:10.52,1:32:15.65,Default,,0,0,0,,Мен кеңсемді жауып, әріптес ретінде кек алу мүмкіндігін іздедім.
Dialogue: 0,1:32:15.73,1:32:16.94,Default,,0,0,0,,Осындай уақытта
Dialogue: 0,1:32:17.57,1:32:20.36,Default,,0,0,0,,Когораның ағасы ақталсын.
Dialogue: 0,1:32:20.45,1:32:22.20,Default,,0,0,0,,Сізге өзіңізді қорғау бұйырылды.
Dialogue: 0,1:32:22.28,1:32:23.66,Default,,0,0,0,,Иә
Dialogue: 0,1:32:24.33,1:32:27.12,Default,,0,0,0,,Неліктен қоғамдық қауіпсіздік полициясы оны ақтағысы келеді?
Dialogue: 0,1:32:27.20,1:32:29.21,Default,,0,0,0,,Мен түсінбедім.
Dialogue: 0,1:32:29.29,1:32:31.96,Default,,0,0,0,,Сонда мен сені соттаймын деп ойладым.
Dialogue: 0,1:32:32.67,1:32:34.84,Default,,0,0,0,,Туысы жоқ адамдарды қатыстыру?
Dialogue: 0,1:32:34.92,1:32:37.30,Default,,0,0,0,,Менің таңдауым болмады!
Dialogue: 0,1:32:37.38,1:32:39.22,Default,,0,0,0,,Мен бұны ешқашан күткен емеспін...
Dialogue: 0,1:32:40.22,1:32:43.26,Default,,0,0,0,,Мен қоғамдық қауіпсіздік полициясының қорғауымен аман қалдым.
Dialogue: 0,1:32:44.05,1:32:46.72,Default,,0,0,0,,Білсем, бұлай болатын еді...
Dialogue: 0,1:32:51.23,1:32:55.77,Default,,0,0,0,,Нисаничи енді сіздің серіктесіңіз, солай ма?
Dialogue: 0,1:32:55.86,1:32:56.82,Default,,0,0,0,,Ах
Dialogue: 0,1:32:57.98,1:32:59.74,Default,,0,0,0,,Ол қандай сан?
Dialogue: 0,1:33:00.40,1:33:01.49,Default,,0,0,0,,«Қандай сан»?
Dialogue: 0,1:33:02.36,1:33:06.74,Default,,0,0,0,,Қоғамдық қауіпсіздік бізге сахнаның артындағы нөмірлер арқылы қоңырау шалып жатыр, солай ма?
Dialogue: 0,1:33:07.83,1:33:10.25,Default,,0,0,0,,Мен 2291мін, солай ма?
Dialogue: 0,1:33:12.04,1:33:13.87,Default,,0,0,0,,Сонда ол қандай сан?
Dialogue: 0,1:33:15.25,1:33:16.84,Default,,0,0,0,,Сакайко Тачибана
Dialogue: 0,1:33:17.55,1:33:21.34,Default,,0,0,0,,Сізді қоғамдық қауіпсіздік полициясымен ынтымақтасудан босатыңыз
Dialogue: 0,1:33:21.42,1:33:22.63,Default,,0,0,0,,Жақсы ма? флюгер
Dialogue: 0,1:33:22.72,1:33:27.35,Default,,0,0,0,,Заңсыз жұмыстарды өзіңіз тазалауыңыз керек.
Dialogue: 0,1:33:27.43,1:33:29.64,Default,,0,0,0,,Бұл қоғамдық қауіпсіздік болды, солай ма?
Dialogue: 0,1:33:30.64,1:33:35.23,Default,,0,0,0,,Хаба осында, сен енді боссың.
Dialogue: 0,1:33:35.31,1:33:37.69,Default,,0,0,0,,Оны көргіңіз келсе, тоқтауымыз керек...
Dialogue: 0,1:33:38.36,1:33:39.36,Default,,0,0,0,,Мақтанба!
Dialogue: 0,1:33:39.44,1:33:40.61,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:33:46.20,1:33:49.62,Default,,0,0,0,,Мен сіздің серіктес болуды шештім.
Dialogue: 0,1:33:49.70,1:33:52.54,Default,,0,0,0,,Саған опасыздық жасау менің шешімім болды.
Dialogue: 0,1:33:52.62,1:33:55.42,Default,,0,0,0,,Оны жақсы көру менің шешімім болды
Dialogue: 0,1:33:56.17,1:33:58.54,Default,,0,0,0,,Менің бүкіл өмірім
Dialogue: 0,1:33:58.63,1:34:01.67,Default,,0,0,0,,Балалар, мені манипуляциялады деп ойламаңыздар!
Dialogue: 0,1:34:02.38,1:34:07.47,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:34:11.02,1:34:12.43,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,1:34:15.60,1:34:16.85,Default,,0,0,0,,сақай…
Dialogue: 0,1:34:21.69,1:34:25.45,Default,,0,0,0,,Ол сені қанша жек көрсе де, оны соңына дейін қорға.
Dialogue: 0,1:34:25.53,1:34:27.20,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,1:34:27.28,1:34:29.70,Default,,0,0,0,,Біз қоғамдық қауіпсіздікпіз.
Dialogue: 0,1:34:32.58,1:34:37.33,Default,,0,0,0,,Сіздің арқаңызда біз Жапонияны құлатқан террористті ұстай алдық.
Dialogue: 0,1:34:37.42,1:34:39.09,Default,,0,0,0,,Сіз қашан терроризм деп ойладыңыз?
Dialogue: 0,1:34:39.17,1:34:41.84,Default,,0,0,0,,Сіздің пікіріңіз дұрыс.
Dialogue: 0,1:34:43.38,1:34:46.84,Default,,0,0,0,,Сол күні Халықаралық конференция орталығын тексеру кезінде
Dialogue: 0,1:34:47.43,1:34:50.68,Default,,0,0,0,,Мен газ клапандарына онлайн кіруге болатынын білдім.
Dialogue: 0,1:34:52.26,1:34:55.73,Default,,0,0,0,,Оны пайдаланып лаңкестік бомбалау мүмкіндігін қарастыру
Dialogue: 0,1:34:55.81,1:34:58.73,Default,,0,0,0,,Мен қоғамдық қауіпсіздік криминалистикасына нұсқау бергенімде...
Dialogue: 0,1:35:02.02,1:35:06.49,Default,,0,0,0,,Алайда оқиға орнындағы мән-жайларды ескере отырып, оны жазатайым оқиға ретінде қарастыру мүмкіндігі болды.
Dialogue: 0,1:35:06.57,1:35:09.49,Default,,0,0,0,,Осылайша сіз күдікті тудырдыңыз.
Dialogue: 0,1:35:10.20,1:35:13.87,Default,,0,0,0,,Күдіктіні полициядан мүмкіндігінше тезірек алып тастаңыз
Dialogue: 0,1:35:13.95,1:35:18.33,Default,,0,0,0,,Мен істі қоғамдық қауіпсіздікті қамтамасыз ететін прокуратураға жібергім келді.
Dialogue: 0,1:35:18.42,1:35:21.96,Default,,0,0,0,,Сондықтан мен доктор Сакаконы заңгер етіп жібердім.
Dialogue: 0,1:35:22.04,1:35:26.76,Default,,0,0,0,,Апат сызығы жойылғаннан кейін, Когороның ағасы босатылды.
Dialogue: 0,1:35:27.34,1:35:31.18,Default,,0,0,0,,Керемет, сен барлық жұмбақтарды шешесің.
Dialogue: 0,1:35:31.76,1:35:35.77,Default,,0,0,0,,Жоқ, әлі шешілмеген жұмбақ бар...
Dialogue: 0,1:35:35.85,1:35:37.18,Default,,0,0,0,,- (Амуро) Ұялы телефон - Иә?
Dialogue: 0,1:35:37.27,1:35:39.77,Default,,0,0,0,,Содан бері жарқырап тұр.
Dialogue: 0,1:35:39.85,1:35:40.69,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:35:45.36,1:35:46.69,Default,,0,0,0,,О, Шиничи?
Dialogue: 0,1:35:46.78,1:35:50.57,Default,,0,0,0,,Мен қазір Мұхит шетіндегі казино мұнарасын паналап жатырмын.
Dialogue: 0,1:35:50.57,1:35:50.82,Default,,0,0,0,,Мен қазір Мұхит шетіндегі казино мұнарасын паналап жатырмын.
Dialogue: 0,1:35:50.57,1:35:50.82,Default,,0,0,0,,Иә
Dialogue: 0,1:35:50.82,1:35:50.91,Default,,0,0,0,,Иә
Dialogue: 0,1:35:50.91,1:35:51.87,Default,,0,0,0,,Иә
Dialogue: 0,1:35:50.91,1:35:51.87,Default,,0,0,0,,Осы жауап беру құрылғысын естісеңіз, маған қоңырау шалыңыз.
Dialogue: 0,1:35:51.87,1:35:53.45,Default,,0,0,0,,Осы жауап беру құрылғысын естісеңіз, маған қоңырау шалыңыз.
Dialogue: 0,1:35:53.53,1:35:55.54,Default,,0,0,0,,Не!? Капсула?
Dialogue: 0,1:35:55.62,1:35:57.46,Default,,0,0,0,,Иә?
Dialogue: 0,1:35:58.71,1:36:00.67,Default,,0,0,0,,Шығу тегі белгісіз жарылыс салдарынан
Dialogue: 0,1:36:00.75,1:36:03.96,Default,,0,0,0,,Осы жылдамдықпен ол Токио шығанағындағы полигонға түседі!
Dialogue: 0,1:36:04.04,1:36:05.96,Default,,0,0,0,,Полигондардың бірі
Dialogue: 0,1:36:06.05,1:36:09.72,Default,,0,0,0,,30 000 адам эвакуацияланған Мұхит шеті бар.
Dialogue: 0,1:36:09.80,1:36:11.89,Default,,0,0,0,,Енді тосқауыл болмайды
Dialogue: 0,1:36:11.97,1:36:13.72,Default,,0,0,0,,- (Такаги) Баяу қабылдасаңыз болады! -(Сато) Әлі уақыт бар!
Dialogue: 0,1:36:13.80,1:36:14.89,Default,,0,0,0,,Баспаңыз!
Dialogue: 0,1:36:15.47,1:36:17.39,Default,,0,0,0,,Барлығыңыз тынышталыңыздар.
Dialogue: 0,1:36:18.27,1:36:21.60,Default,,0,0,0,,Біз келген кездегідей барлығының мінетініне сенімдімін.
Dialogue: 0,1:36:22.10,1:36:23.48,Default,,0,0,0,,- (Чиба) Инспектор - (Мегуре) Иә?
Dialogue: 0,1:36:23.56,1:36:25.48,Default,,0,0,0,,Ақпарат шатастыратын сияқты
Dialogue: 0,1:36:25.57,1:36:27.65,Default,,0,0,0,,Мұнда жалпы көліктер эвакуациялануда.
Dialogue: 0,1:36:27.74,1:36:28.90,Default,,0,0,0,,Не!?
Dialogue: 0,1:36:28.99,1:36:31.41,Default,,0,0,0,,Жалғыз екі көпірде үлкен кептеліс бар.
Dialogue: 0,1:36:31.49,1:36:36.16,Default,,0,0,0,,(Азаматтық қорғаныс сиренасы)
Dialogue: 0,1:36:37.41,1:36:38.41,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,1:36:39.21,1:36:41.12,Default,,0,0,0,,Мен үрейленіп тұрмын
Dialogue: 0,1:36:42.00,1:36:43.63,Default,,0,0,0,,Шиничи…
Dialogue: 0,1:36:44.84,1:36:48.34,Default,,0,0,0,,Боқ, жоқ, мен Ранмен байланыса алмаймын!
Dialogue: 0,1:36:48.42,1:36:50.51,Default,,0,0,0,,Не істеу керек! Менің уақытым жоқ
Dialogue: 0,1:36:50.59,1:36:54.76,Default,,0,0,0,,Амуро мырза, бұл жолы мен сізден менің әріптесім болуыңызды сұраймын.
Dialogue: 0,1:36:54.85,1:36:55.93,Default,,0,0,0,,Иә?
Dialogue: 0,1:36:56.60,1:36:57.72,Default,,0,0,0,,Иә
Dialogue: 0,1:37:07.53,1:37:08.94,Default,,0,0,0,,Алда кептеліс бар.
Dialogue: 0,1:37:09.03,1:37:09.86,Default,,0,0,0,,Құт
Dialogue: 0,1:37:09.94,1:37:12.86,Default,,0,0,0,,Эвакуация бойынша нұсқаулық дұрыс жұмыс істемей ме?
Dialogue: 0,1:37:27.38,1:37:28.63,Default,,0,0,0,,Иә
Dialogue: 0,1:37:36.22,1:37:37.39,Default,,0,0,0,,Уф
Dialogue: 0,1:37:45.27,1:37:46.52,Default,,0,0,0,,Иә?
Dialogue: 0,1:37:57.12,1:37:58.45,Default,,0,0,0,,Уф
Dialogue: 0,1:38:16.43,1:38:18.55,Default,,0,0,0,,Бұл казино мұнарасы ма?
Dialogue: 0,1:38:18.64,1:38:20.76,Default,,0,0,0,,- (Казами) Фуруя мырза! -Ха!
Dialogue: 0,1:38:20.85,1:38:24.27,Default,,0,0,0,,Капсуланың парашюті ұшып кетті және ол үдеуде!
Dialogue: 0,1:38:24.35,1:38:25.52,Default,,0,0,0,,Сонымен?
Dialogue: 0,1:38:25.60,1:38:28.56,Default,,0,0,0,,NAZU болжамды құлау нүктесін берді.
Dialogue: 0,1:38:28.65,1:38:32.61,Default,,0,0,0,,Осы қарқынмен біз 5 минутта казино мұнарасына құлаймыз!
Dialogue: 0,1:38:32.69,1:38:33.61,Default,,0,0,0,,Цк
Dialogue: 0,1:38:33.69,1:38:34.95,Default,,0,0,0,,- (Kazami) Деректерді тасымалдау! -Жүгіріп...
Dialogue: 0,1:38:35.03,1:38:38.03,Default,,0,0,0,,Не істеу керек, не істеу керек
Dialogue: 0,1:38:38.12,1:38:39.58,Default,,0,0,0,,Ха, аа
Dialogue: 0,1:38:41.12,1:38:43.33,Default,,0,0,0,,Амуро-сан! Уф...
Dialogue: 0,1:38:43.41,1:38:45.83,Default,,0,0,0,,Мықтап ұстаңыз
Dialogue: 0,1:38:50.75,1:38:52.09,Default,,0,0,0,,Амуро мырза, сіз не істемексіз?
Dialogue: 0,1:38:52.17,1:38:53.26,Default,,0,0,0,,Құт
Dialogue: 0,1:38:55.93,1:38:56.97,Default,,0,0,0,,Га
Dialogue: 0,1:39:01.93,1:39:02.89,Default,,0,0,0,,Құт
Dialogue: 0,1:39:05.10,1:39:06.02,Default,,0,0,0,,Уф
Dialogue: 0,1:39:15.11,1:39:15.94,Default,,0,0,0,,Міне, уақыты!
Dialogue: 0,1:39:20.91,1:39:22.33,Default,,0,0,0,,Гуаааахх
Dialogue: 0,1:39:25.41,1:39:26.83,Default,,0,0,0,,Ішек
Dialogue: 0,1:39:32.13,1:39:34.71,Default,,0,0,0,,Мен өлемін деп ойладым.
Dialogue: 0,1:39:34.80,1:39:36.72,Default,,0,0,0,,Солай болса да, бұл таңқаларлық.
Dialogue: 0,1:39:36.80,1:39:38.72,Default,,0,0,0,,Қауіпті сезінудің жоқтығы, көріп тұрмын.
Dialogue: 0,1:39:38.80,1:39:40.01,Default,,0,0,0,,барлығын бірге орналастырыңыз.
Dialogue: 0,1:39:42.30,1:39:43.14,Default,,0,0,0,,Га
Dialogue: 0,1:39:44.14,1:39:46.23,Default,,0,0,0,,Осы салынып жатқан ғимаратқа қарай
Dialogue: 0,1:39:48.14,1:39:50.27,Default,,0,0,0,,Иә? Оши
Dialogue: 0,1:39:58.15,1:40:00.49,Default,,0,0,0,,Балалар, кетпеңдер.
Dialogue: 0,1:40:00.57,1:40:01.57,Default,,0,0,0,,Иә
Dialogue: 0,1:40:01.66,1:40:04.37,Default,,0,0,0,,Бір қорқынышты нәрсе болды.
Dialogue: 0,1:40:15.09,1:40:16.96,Default,,0,0,0,,Біз оны уақытында орындаймыз ба?
Dialogue: 0,1:40:17.05,1:40:21.14,Default,,0,0,0,,Осы ғимараттың биіктігі мен казино мұнарасына дейінгі қашықтықты ескере отырып.
Dialogue: 0,1:40:21.22,1:40:23.85,Default,,0,0,0,,Егер сіз осы жерден бір минутта жылдамдасаңыз
Dialogue: 0,1:40:26.10,1:40:27.60,Default,,0,0,0,,Ичи немесе барабан таяқшасы?
Dialogue: 0,1:40:28.93,1:40:33.44,Default,,0,0,0,,Өтінемін, уақытында жасаңыз, Ран!
Dialogue: 0,1:40:35.36,1:40:37.19,Default,,0,0,0,,О... не?
Dialogue: 0,1:40:37.28,1:40:39.11,Default,,0,0,0,,Махаббаттың құдіреті зор
Dialogue: 0,1:40:39.19,1:40:40.61,Default,,0,0,0,,Иә?
Dialogue: 0,1:40:41.61,1:40:45.12,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,1:40:50.96,1:40:52.88,Default,,0,0,0,,Мен сізден біраз уақыттан бері осыны сұрағым келді.
Dialogue: 0,1:40:52.96,1:40:55.13,Default,,0,0,0,,Амуро мырзаның сүйген қызы бар ма?
Dialogue: 0,1:40:55.21,1:40:56.59,Default,,0,0,0,,Иә?
Dialogue: 0,1:40:56.67,1:40:59.38,Default,,0,0,0,,Хмм... иә.
Dialogue: 0,1:41:02.18,1:41:05.39,Default,,0,0,0,,Менің сүйіктім...
Dialogue: 0,1:41:05.47,1:41:08.47,Default,,0,0,0,,Әй, бұл ел.
Dialogue: 0,1:41:13.90,1:41:15.02,Default,,0,0,0,,Кеттік, Амуро-сан.
Dialogue: 0,1:41:15.11,1:41:17.78,Default,,0,0,0,,Оны тіпті 1 мм-ге ауыстыру керек пе?
Dialogue: 0,1:41:17.86,1:41:19.78,Default,,0,0,0,,Бұл менің ниетім
Dialogue: 0,1:41:21.28,1:41:22.20,Default,,0,0,0,,5!
Dialogue: 0,1:41:22.28,1:41:23.20,Default,,0,0,0,,4!
Dialogue: 0,1:41:23.28,1:41:24.20,Default,,0,0,0,,Үш!
Dialogue: 0,1:41:24.28,1:41:25.20,Default,,0,0,0,,Екі!
Dialogue: 0,1:41:25.28,1:41:26.45,Default,,0,0,0,,Айтпақшы, мен әлдеқайда жақсардым, бірақ соңғы кезде
Dialogue: 0,1:41:26.53,1:41:27.95,Default,,0,0,0,,Нөл!
Dialogue: 0,1:41:30.91,1:41:31.87,Default,,0,0,0,,Уф
Dialogue: 0,1:41:34.37,1:41:36.54,Default,,0,0,0,,Жоқ, ол жеткіліксіз!
Dialogue: 0,1:41:36.63,1:41:38.05,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,1:41:48.35,1:41:49.68,Default,,0,0,0,,Уф
Dialogue: 0,1:41:51.02,1:41:52.18,Default,,0,0,0,,Хмм
Dialogue: 0,1:42:00.23,1:42:01.40,Default,,0,0,0,,Уф
Dialogue: 0,1:42:05.16,1:42:06.62,Default,,0,0,0,,Уф
Dialogue: 0,1:42:07.32,1:42:09.79,Default,,0,0,0,,Уф... уф
Dialogue: 0,1:42:12.29,1:42:18.46,Default,,0,0,0,,Жүр!
Dialogue: 0,1:42:20.67,1:42:21.84,Default,,0,0,0,,Уау
Dialogue: 0,1:42:23.17,1:42:24.55,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:42:31.18,1:42:32.18,Default,,0,0,0,,Жүгірдім!
Dialogue: 0,1:42:32.27,1:42:33.93,Default,,0,0,0,,Әке!
Dialogue: 0,1:42:34.98,1:42:36.02,Default,,0,0,0,,Орхидея…
Dialogue: 0,1:42:36.10,1:42:36.94,Default,,0,0,0,,Құт
Dialogue: 0,1:42:41.15,1:42:43.82,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:42:44.49,1:42:45.32,Default,,0,0,0,,Ішек
Dialogue: 0,1:42:46.28,1:42:48.07,Default,,0,0,0,,Гах... Гах!
Dialogue: 0,1:42:48.16,1:42:49.83,Default,,0,0,0,,Уау
Dialogue: 0,1:42:50.99,1:42:52.41,Default,,0,0,0,,-(Амуро) Уф.
Dialogue: 0,1:43:09.43,1:43:11.47,Default,,0,0,0,,А-а-а-а-а-а-а, сәлем...
Dialogue: 0,1:43:13.64,1:43:16.56,Default,,0,0,0,,Ах...
Dialogue: 0,1:43:19.65,1:43:22.32,Default,,0,0,0,,(сықырлау)
Dialogue: 0,1:43:22.40,1:43:24.57,Default,,0,0,0,,(Барлығы күңкілдейді)
Dialogue: 0,1:43:31.45,1:43:32.87,Default,,0,0,0,,Я...
Dialogue: 0,1:43:34.20,1:43:35.41,Default,,0,0,0,,Ах
Dialogue: 0,1:43:35.50,1:43:36.83,Default,,0,0,0,,-(Амуро) Қалғанын өзім жасаймын. -Хмм.
Dialogue: 0,1:43:37.50,1:43:39.33,Default,,0,0,0,,Сіз де дереу кетуіңіз керек.
Dialogue: 0,1:43:39.42,1:43:41.59,Default,,0,0,0,,Жұмбақ әлі шешілмеген
Dialogue: 0,1:43:42.25,1:43:45.09,Default,,0,0,0,,Неліктен Когораның ағасын қатыстырдыңыз?
Dialogue: 0,1:43:45.88,1:43:50.97,Default,,0,0,0,,Аа, лауазымыма байланысты мен көпшілік алдында тергеу жүргізе алмаймын.
Dialogue: 0,1:43:51.05,1:43:55.97,Default,,0,0,0,,Егер сіз оны іске тартсаңыз, сіз еріксіз әріптеске айналасыз.
Dialogue: 0,1:43:56.06,1:43:57.48,Default,,0,0,0,,А...
Dialogue: 0,1:43:57.56,1:44:02.23,Default,,0,0,0,,Осылайша мен сіздің шынайы күшіңізді қарызға аламын, солай ма?
Dialogue: 0,1:44:02.31,1:44:04.07,Default,,0,0,0,,Ах...
Dialogue: 0,1:44:05.94,1:44:08.24,Default,,0,0,0,,Сіз тым көп сатып алдыңыз.
Dialogue: 0,1:44:14.70,1:44:19.71,Default,,0,0,0,,♪~
Dialogue: 0,1:48:21.74,1:48:26.75,Default,,0,0,0,,~♪
Dialogue: 0,1:48:29.33,1:48:31.00,Default,,0,0,0,,Қылмыстық жетекші сияқты —
Dialogue: 0,1:48:31.08,1:48:33.75,Default,,0,0,0,,Полицияның тергеу материалдарынан шабыттандырылған
Dialogue: 0,1:48:33.84,1:48:37.34,Default,,0,0,0,,Осындай ерекше ниетпен терактілер сериясын жасаған бұрынғы прокурор.
Dialogue: 0,1:48:37.92,1:48:40.68,Default,,0,0,0,,Күдікті Макото Кусакабеге қатысты, елордалық полиция департаменті...
Dialogue: 0,1:48:40.76,1:48:42.01,Default,,0,0,0,,Хмм...
Dialogue: 0,1:48:42.09,1:48:44.35,Default,,0,0,0,,Қоғамдық қауіпсіздік мотивтен жойылды.
Dialogue: 0,1:48:44.43,1:48:48.23,Default,,0,0,0,,Бұл қоғамдық қауіпсіздік полициясының шешімі болуы керек.
Dialogue: 0,1:48:49.31,1:48:51.23,Default,,0,0,0,,Токио шығанағына аман-есен қонды
Dialogue: 0,1:48:51.31,1:48:53.98,Default,,0,0,0,,Қалпына келтірілген ғарыш кемесі Аққу капсуласының ішінде —
Dialogue: 0,1:48:53.98,1:48:54.56,Default,,0,0,0,,Қалпына келтірілген ғарыш кемесі Аққу капсуласының ішінде —
Dialogue: 0,1:48:53.98,1:48:54.56,Default,,0,0,0,,Сақ бол.
Dialogue: 0,1:48:54.56,1:48:54.65,Default,,0,0,0,,Сақ бол.
Dialogue: 0,1:48:54.65,1:48:55.61,Default,,0,0,0,,Сақ бол.
Dialogue: 0,1:48:54.65,1:48:55.61,Default,,0,0,0,,Құрамында Марстан алынған заттар бар
Dialogue: 0,1:48:55.61,1:48:56.90,Default,,0,0,0,,Құрамында Марстан алынған заттар бар
Dialogue: 0,1:48:56.98,1:48:58.53,Default,,0,0,0,,Ғаламның жұмбақтарын шешу
Dialogue: 0,1:48:58.61,1:49:01.45,Default,,0,0,0,,Үлкен үміт күтіп тұрғаны жарияланды.
Dialogue: 0,1:49:02.49,1:49:03.99,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,1:49:04.07,1:49:06.12,Default,,0,0,0,,Бірақ мен оны дронмен көргім келеді.
Dialogue: 0,1:49:06.20,1:49:09.16,Default,,0,0,0,,Маған дәрігердің жүгі керек.
Dialogue: 0,1:49:09.25,1:49:11.12,Default,,0,0,0,,Эх, аа, хехехе...
Dialogue: 0,1:49:11.75,1:49:16.21,Default,,0,0,0,,Сол балалар, мен олардың капсуланың қалпына келуіне үлес қосқанына сене алар емеспін.
Dialogue: 0,1:49:16.29,1:49:18.34,Default,,0,0,0,,Сіз мүлде олай ойламайтын сияқтысыз.
Dialogue: 0,1:49:18.42,1:49:22.13,Default,,0,0,0,,О, Жапонияны дағдарыстан құтқарды.
Dialogue: 0,1:49:22.22,1:49:25.14,Default,,0,0,0,,Олар шынымен де керемет балалар.
Dialogue: 0,1:49:25.22,1:49:29.77,Default,,0,0,0,,Жарайды, дәрігердің дронымен Марсты зерттейік.
Dialogue: 0,1:49:29.85,1:49:31.43,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:49:31.52,1:49:32.44,Default,,0,0,0,,Жасайық Жасайық
Dialogue: 0,1:49:32.52,1:49:35.23,Default,,0,0,0,,Дәрігер, жаңасын жасаңыз.
Dialogue: 0,1:49:35.31,1:49:37.61,Default,,0,0,0,,Оны үлкейтіңіз.
Dialogue: 0,1:49:37.69,1:49:38.94,Default,,0,0,0,,Эххен иә?
Dialogue: 0,1:49:39.57,1:49:40.90,Default,,0,0,0,,Бар күшімізді салып көрейік
Dialogue: 0,1:49:40.99,1:49:42.32,Default,,0,0,0,,(Гента мен оның достарының толқыған дауыстары)
Dialogue: 0,1:49:42.40,1:49:45.41,Default,,0,0,0,,- (Хайбара) Аа... - (Мицухико) Марс Мен оны асыға күтемін~
Dialogue: 0,1:49:45.49,1:49:46.83,Default,,0,0,0,,Эй, сәлем
Dialogue: 0,1:49:46.91,1:49:49.87,Default,,0,0,0,,Жоқ, бұл мүмкін емес.
Dialogue: 0,1:49:51.37,1:49:57.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory