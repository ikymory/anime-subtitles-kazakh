Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.01,0:00:14.01,Default,,0,0,0,,♪～
Dialogue: 0,0:01:38.13,0:01:40.14,Default,,0,0,0,,～♪
Dialogue: 0,0:01:43.97,0:01:46.39,Default,,0,0,0,,Арх! Ха!
Dialogue: 0,0:01:49.48,0:01:51.44,Default,,0,0,0,,Менде бар—
Dialogue: 0,0:01:52.48,0:01:54.36,Default,,0,0,0,,Азу тістердің қажеті жоқ
Dialogue: 0,0:01:56.61,0:01:58.74,Default,,0,0,0,,Енді менің денем -
Dialogue: 0,0:01:58.82,0:02:01.41,Default,,0,0,0,,Мен сені жұдырықтауға құқылымын!
Dialogue: 0,0:02:01.49,0:02:03.12,Default,,0,0,0,,-Уау! -Гхаха
Dialogue: 0,0:02:05.41,0:02:07.75,Default,,0,0,0,,Ой...
Dialogue: 0,0:02:08.96,0:02:11.17,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:02:11.25,0:02:16.71,Default,,0,0,0,,Мен оны алуға батылдым, бірақ қандай тәтті соққы.
Dialogue: 0,0:02:16.80,0:02:20.68,Default,,0,0,0,,Бұл сіздің мінезіңізді білдіретін сияқты.
Dialogue: 0,0:02:23.05,0:02:25.68,Default,,0,0,0,,Азу тістері алынса да әлсіремейді.
Dialogue: 0,0:02:25.77,0:02:30.10,Default,,0,0,0,,Жоқ, керісінше тез тұрады.
Dialogue: 0,0:02:30.19,0:02:35.57,Default,,0,0,0,,Сіздің рухыңыз жыртқыштардың басында да билік етеді.
Dialogue: 0,0:02:36.44,0:02:38.57,Default,,0,0,0,,(Өрт дабылы)
Dialogue: 0,0:02:39.15,0:02:40.32,Default,,0,0,0,,Хехе...
Dialogue: 0,0:02:40.41,0:02:43.24,Default,,0,0,0,,Төмендегі жігіттер асығыс кіріп келеді.
Dialogue: 0,0:02:43.78,0:02:44.62,Default,,0,0,0,,О
Dialogue: 0,0:02:45.33,0:02:48.37,Default,,0,0,0,,Тіпті жыртқыштардың да ақыл-ойы бар.
Dialogue: 0,0:02:49.08,0:02:50.71,Default,,0,0,0,,үшін азап шегеді
Dialogue: 0,0:02:51.79,0:02:54.42,Default,,0,0,0,,Сіздің істеп жатқаныңыз дұрыс емес
Dialogue: 0,0:02:54.50,0:02:57.17,Default,,0,0,0,,Бұл жай ғана нүкте қою үшін түсірілген ату болды.
Dialogue: 0,0:02:58.72,0:03:03.14,Default,,0,0,0,,Бистерге дөрекі болғаным үшін кешірім сұраймын.
Dialogue: 0,0:03:04.10,0:03:06.14,Default,,0,0,0,,Онда бұл менмін
Dialogue: 0,0:03:08.35,0:03:10.69,Default,,0,0,0,,Құрметті Яхья, өрт дабылы бар!
Dialogue: 0,0:03:10.77,0:03:11.85,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:03:12.65,0:03:15.19,Default,,0,0,0,,Шам жаңа ғана құлады.
Dialogue: 0,0:03:18.94,0:03:23.66,Default,,0,0,0,,Мен саған ғашық болдым, Легоши
Dialogue: 0,0:03:32.75,0:03:35.00,Default,,0,0,0,,Менің саусағымды көзіңмен бақылаңыз
Dialogue: 0,0:03:35.08,0:03:36.84,Default,,0,0,0,,Иә? Қараңыз
Dialogue: 0,0:03:38.21,0:03:39.26,Default,,0,0,0,,Әлі емес.
Dialogue: 0,0:03:39.34,0:03:41.55,Default,,0,0,0,,-Хмм... -Даусымды естімей тұрсың ба?
Dialogue: 0,0:03:42.63,0:03:46.35,Default,,0,0,0,,Хмм... аа... а...
Dialogue: 0,0:03:47.43,0:03:50.77,Default,,0,0,0,,Хмм, сізде квинус белгілері жоқ деп ойлаймын.
Dialogue: 0,0:03:50.85,0:03:53.65,Default,,0,0,0,,Уф... ой
Dialogue: 0,0:03:54.40,0:03:56.23,Default,,0,0,0,,Негізгі дене қайда өзі?
Dialogue: 0,0:03:56.31,0:03:57.07,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:03:57.15,0:03:58.52,Default,,0,0,0,,- Уф! -хаха
Dialogue: 0,0:03:59.28,0:04:01.57,Default,,0,0,0,,Уайымдамаңыз, мен дәрігермін.
Dialogue: 0,0:04:01.65,0:04:04.53,Default,,0,0,0,,Дегенмен, ол өзінің өрескел өңдеуімен танымал.
Dialogue: 0,0:04:04.61,0:04:08.49,Default,,0,0,0,,Ал, қазірден бастап тіл табысайық, жарай ма?
Dialogue: 0,0:04:08.58,0:04:09.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:10.45,0:04:11.29,Default,,0,0,0,,О
Dialogue: 0,0:04:12.16,0:04:13.25,Default,,0,0,0,,О, Легоси!
Dialogue: 0,0:04:13.33,0:04:15.92,Default,,0,0,0,,Хмм... Го Синь мырза
Dialogue: 0,0:04:16.00,0:04:18.92,Default,,0,0,0,,Өзіңізді итермеңіз. Бірнеше күн ғана үндемеңіз.
Dialogue: 0,0:04:19.00,0:04:19.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:22.09,0:04:23.17,Default,,0,0,0,,Уф… Бұған қуануым керек пе?
Dialogue: 0,0:04:24.09,0:04:26.93,Default,,0,0,0,,Хахахахаха, оған да тиісуді доғар.
Dialogue: 0,0:04:27.97,0:04:28.76,Default,,0,0,0,,Уф
Dialogue: 0,0:04:29.68,0:04:30.64,Default,,0,0,0,,-Оппа -Ой
Dialogue: 0,0:04:31.43,0:04:34.73,Default,,0,0,0,,Айтайын дегенім, науқас әйел болса да аямаймын.
Dialogue: 0,0:04:34.81,0:04:35.56,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:36.02,0:04:38.23,Default,,0,0,0,,Ақымақ сияқты әрекет етуді доғар
Dialogue: 0,0:04:38.31,0:04:39.57,Default,,0,0,0,,-Бұ -Уф
Dialogue: 0,0:04:40.61,0:04:43.11,Default,,0,0,0,,Ммм...
Dialogue: 0,0:04:47.78,0:04:50.45,Default,,0,0,0,,Кешіріңіз, бірақ аурухана бөлмесінде орын жоқ.
Dialogue: 0,0:04:57.13,0:04:59.38,Default,,0,0,0,,Қоянды өлтіру.
Dialogue: 0,0:05:02.96,0:05:04.59,Default,,0,0,0,,Сонда да мен таң қалдым.
Dialogue: 0,0:05:04.67,0:05:07.72,Default,,0,0,0,,Менің үйіме келген бойда кенет құлап қалдың.
Dialogue: 0,0:05:07.80,0:05:08.47,Default,,0,0,0,,Хун
Dialogue: 0,0:05:08.89,0:05:10.35,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:05:14.68,0:05:15.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:16.44,0:05:17.73,Default,,0,0,0,,Яхья?
Dialogue: 0,0:05:18.23,0:05:21.27,Default,,0,0,0,,Сіз Яхьямен төбелесіп көрдіңіз бе?
Dialogue: 0,0:05:25.19,0:05:27.74,Default,,0,0,0,,Ей, ақымақ, сен осындай нәрсені оқисың ба?
Dialogue: 0,0:05:28.28,0:05:31.03,Default,,0,0,0,,Біз квинуспен ауыратын науқастармен айналысамыз.
Dialogue: 0,0:05:31.12,0:05:32.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:32.45,0:05:33.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:37.00,0:05:38.33,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:05:41.67,0:05:44.34,Default,,0,0,0,,Күрсіну~ Жетеді!
Dialogue: 0,0:05:44.92,0:05:48.01,Default,,0,0,0,,Әйтеуір, ісік басылғанша осында неге демалмайсың?
Dialogue: 0,0:06:04.90,0:06:06.24,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:10.45,0:06:11.87,Default,,0,0,0,,Ия... Уаа...
Dialogue: 0,0:06:14.70,0:06:17.66,Default,,0,0,0,,Тамақты өлтіретін адамдардың екі түрі бар.
Dialogue: 0,0:06:18.62,0:06:21.33,Default,,0,0,0,,Көбірек ет алғыңыз келе ме?
Dialogue: 0,0:06:21.42,0:06:24.30,Default,,0,0,0,,Айыбын сезініп еттен сақтану
Dialogue: 0,0:06:24.38,0:06:27.51,Default,,0,0,0,,Емдеу әдістеріне байланысты өзгереді
Dialogue: 0,0:06:32.55,0:06:34.35,Default,,0,0,0,,Сіз кеше түнде болдыңыз
Dialogue: 0,0:06:34.43,0:06:37.89,Default,,0,0,0,,Мен Гай орталығындағы аллеяда тірі қоян жедім.
Dialogue: 0,0:06:38.64,0:06:40.23,Default,,0,0,0,,Сіз бір-біріңізді таныдыңыз ба?
Dialogue: 0,0:06:42.11,0:06:44.02,Default,,0,0,0,,(Айдың ауыр тыныс алуы)
Dialogue: 0,0:06:44.11,0:06:46.69,Default,,0,0,0,,-Мұғалім -Хмм?
Dialogue: 0,0:06:48.24,0:06:51.20,Default,,0,0,0,,Сіз мені ұстай аласыз
Dialogue: 0,0:06:53.07,0:06:54.41,Default,,0,0,0,,Сәлем, мұғалім
Dialogue: 0,0:06:54.95,0:06:56.99,Default,,0,0,0,,Эй, мені ұста!
Dialogue: 0,0:06:57.08,0:06:57.70,Default,,0,0,0,,Сіз өзіңізбен бетпе-бет келуден қорқасыз ба? а?
Dialogue: 0,0:06:57.70,0:07:00.08,Default,,0,0,0,,Сіз өзіңізбен бетпе-бет келуден қорқасыз ба? а?
Dialogue: 0,0:06:57.70,0:07:00.08,Default,,0,0,0,,Ал егер? Эй!
Dialogue: 0,0:07:00.16,0:07:01.54,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:07:02.29,0:07:04.04,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:07:04.13,0:07:07.17,Default,,0,0,0,,Мені ұстаңыз! Егер сіз білмесеңіз!
Dialogue: 0,0:07:07.71,0:07:09.84,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:07:10.76,0:07:13.18,Default,,0,0,0,,Мені ұстаңыз! неге!
Dialogue: 0,0:07:13.26,0:07:15.26,Default,,0,0,0,,-Неге! -Эй, тыңда!
Dialogue: 0,0:07:15.35,0:07:17.35,Default,,0,0,0,,Мен сені шынымен ұстадым
Dialogue: 0,0:07:17.43,0:07:19.48,Default,,0,0,0,,Сіздің мәселеңіз шешілмейді
Dialogue: 0,0:07:20.48,0:07:24.27,Default,,0,0,0,,Мен сізге не себеп болғанын білуім керек.
Dialogue: 0,0:07:24.36,0:07:27.23,Default,,0,0,0,,Сенің жүрегің әрдайым ауырады.
Dialogue: 0,0:07:28.53,0:07:30.36,Default,,0,0,0,,Сіз ауырып қалдыңыз ба?
Dialogue: 0,0:07:31.20,0:07:32.36,Default,,0,0,0,,Мен?
Dialogue: 0,0:07:32.99,0:07:34.20,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:35.49,0:07:40.46,Default,,0,0,0,,Бірақ алдымен жасағаныңызды қабылдаңыз.
Dialogue: 0,0:07:40.54,0:07:42.79,Default,,0,0,0,,Қаншалықты азапты болса да
Dialogue: 0,0:07:46.42,0:07:48.71,Default,,0,0,0,,Өзіңіз туралы айтып беріңіз
Dialogue: 0,0:07:49.71,0:07:51.59,Default,,0,0,0,,Мен туралы…
Dialogue: 0,0:07:52.22,0:07:53.76,Default,,0,0,0,,Мен тыңдаймын
Dialogue: 0,0:07:58.39,0:07:59.64,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:59.72,0:08:03.44,Default,,0,0,0,,Мен саған ет жегенің үшін кешірім сұра дедім бе?
Dialogue: 0,0:08:04.23,0:08:07.44,Default,,0,0,0,,Жасым ұлғайған сайын тіке болдым.
Dialogue: 0,0:08:08.57,0:08:10.82,Default,,0,0,0,,Жас кезімде жолдасым болды.
Dialogue: 0,0:08:10.90,0:08:14.86,Default,,0,0,0,,Олар сәбіз бен таяқтың арасын теңестіруге тырысқан сияқты.
Dialogue: 0,0:08:17.12,0:08:19.29,Default,,0,0,0,,Жарайды, ол да ән жазушы.
Dialogue: 0,0:08:19.37,0:08:22.16,Default,,0,0,0,,Бұл улы монитор кесірткесі болса керек.
Dialogue: 0,0:08:23.04,0:08:26.04,Default,,0,0,0,,Гоу... Хин мен бе?
Dialogue: 0,0:08:26.54,0:08:28.13,Default,,0,0,0,,Барыңыз... Ша?\NМенің ойымша, бұл
Dialogue: 0,0:08:28.21,0:08:29.42,Default,,0,0,0,,...
Dialogue: 0,0:08:29.50,0:08:31.76,Default,,0,0,0,,Иә! Ата?
Dialogue: 0,0:08:32.97,0:08:33.67,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:33.76,0:08:35.97,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:08:36.64,0:08:38.60,Default,,0,0,0,,Сондықтан күшті болды
Dialogue: 0,0:08:39.14,0:08:41.68,Default,,0,0,0,,Олар төбелескен соң ажырасып кеткен деген қауесет бар.
Dialogue: 0,0:08:41.77,0:08:45.23,Default,,0,0,0,,Бұл сәл басқаша болуы мүмкін.
Dialogue: 0,0:08:46.90,0:08:48.90,Default,,0,0,0,,Ата мен Яхья-сан
Dialogue: 0,0:08:49.40,0:08:50.86,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:51.40,0:08:52.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:59.03,0:09:01.70,Default,,0,0,0,,Фотосуреттің орны анықталды
Dialogue: 0,0:09:01.79,0:09:04.04,Default,,0,0,0,,Бұл Центр көшесіндегі көп пәтерлі ғимарат.
Dialogue: 0,0:09:04.12,0:09:05.75,Default,,0,0,0,,Піл сүйегі болды ма?
Dialogue: 0,0:09:06.25,0:09:09.50,Default,,0,0,0,,Жоқ, менде күдікті нәрсе бар.
Dialogue: 0,0:09:10.71,0:09:14.59,Default,,0,0,0,,Егер сіз осы ғимараттың әр қабатының еден жоспарын қабаттастырсаңыз...
Dialogue: 0,0:09:15.13,0:09:16.51,Default,,0,0,0,,Ооо
Dialogue: 0,0:09:16.97,0:09:19.39,Default,,0,0,0,,Міне, осы бөлім
Dialogue: 0,0:09:19.47,0:09:23.98,Default,,0,0,0,,Терезесі мен есігі жоқ кеңістік жер астында созылады.
Dialogue: 0,0:09:26.60,0:09:29.56,Default,,0,0,0,,5-қабаттағы шөпқоректілер кеңесшісі бөлмесі
Dialogue: 0,0:09:30.65,0:09:33.53,Default,,0,0,0,,Бұл ақымақ үлкен диван.
Dialogue: 0,0:09:34.65,0:09:36.53,Default,,0,0,0,,Каминге масштабтау
Dialogue: 0,0:09:37.45,0:09:38.70,Default,,0,0,0,,Еденге келіңіз
Dialogue: 0,0:09:40.32,0:09:41.08,Default,,0,0,0,,Хун
Dialogue: 0,0:09:41.70,0:09:43.49,Default,,0,0,0,,Камин қайтадан
Dialogue: 0,0:09:45.29,0:09:46.66,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:47.25,0:09:48.92,Default,,0,0,0,,Оң жақтағы ше?
Dialogue: 0,0:09:49.83,0:09:51.84,Default,,0,0,0,,Мен мұнда кеңесшімін.
Dialogue: 0,0:09:51.92,0:09:53.67,Default,,0,0,0,,Газель?
Dialogue: 0,0:09:55.17,0:09:58.68,Default,,0,0,0,,Егер олар шөпқоректілер болса, сақ болыңыз.
Dialogue: 0,0:09:58.76,0:10:02.81,Default,,0,0,0,,Пілді өлтіріп, оны Камин тесігінен тастаңыз.
Dialogue: 0,0:10:02.89,0:10:04.77,Default,,0,0,0,,Жер астында бұзу
Dialogue: 0,0:10:05.47,0:10:08.69,Default,,0,0,0,,Ақша ретінде пайдалануға болатын піл сүйегінен ғана орындаңыз
Dialogue: 0,0:10:08.77,0:10:10.40,Default,,0,0,0,,Бұл мағынасы бар.
Dialogue: 0,0:10:11.19,0:10:13.94,Default,,0,0,0,,Осындай қарбалас қаланың ортасында?
Dialogue: 0,0:10:17.40,0:10:21.16,Default,,0,0,0,,Бұл… мен үшін сынақ па?
Dialogue: 0,0:10:26.66,0:10:29.08,Default,,0,0,0,,О, сен кереметсің.
Dialogue: 0,0:10:29.17,0:10:31.63,Default,,0,0,0,,Хехехе, бұл үлкен тіреуіш.
Dialogue: 0,0:10:32.21,0:10:35.00,Default,,0,0,0,,Бұл маған көп көмектесті.
Dialogue: 0,0:10:35.09,0:10:36.30,Default,,0,0,0,,Кинустың баяндамасы да.
Dialogue: 0,0:10:36.38,0:10:38.80,Default,,0,0,0,,Хехе, бұл шектен шыққан.
Dialogue: 0,0:10:38.88,0:10:42.26,Default,,0,0,0,,Мен сонда бір апта болдым, зеріктім.
Dialogue: 0,0:10:42.35,0:10:43.22,Default,,0,0,0,,Хаха
Dialogue: 0,0:10:43.72,0:10:45.64,Default,,0,0,0,,Ах, Легоши, бұл.
Dialogue: 0,0:10:46.64,0:10:47.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:47.60,0:10:49.44,Default,,0,0,0,,Енді мен дұрыс сөйлей аламын.
Dialogue: 0,0:10:49.52,0:10:50.73,Default,,0,0,0,,Тамақты да жеуге болады.
Dialogue: 0,0:10:50.81,0:10:52.40,Default,,0,0,0,,Ойласам, біз ұзақ уақыт сөйлеспеген сияқтымыз
Dialogue: 0,0:10:53.36,0:10:55.40,Default,,0,0,0,,-Бірақ маған керегі жоқ -Ой?
Dialogue: 0,0:10:55.48,0:11:00.28,Default,,0,0,0,,Тіпті мен өз азуымды жұлып алдым.
Dialogue: 0,0:11:00.36,0:11:02.07,Default,,0,0,0,,Маған бұл енді керек емес.
Dialogue: 0,0:11:02.16,0:11:03.78,Default,,0,0,0,,Біз не жеуіміз керек?
Dialogue: 0,0:11:03.87,0:11:05.91,Default,,0,0,0,,Өлгенше ботқа жеймін.
Dialogue: 0,0:11:05.99,0:11:07.70,Default,,0,0,0,,Сіз әйелдер арасында танымал емессіз бе?
Dialogue: 0,0:11:07.79,0:11:09.46,Default,,0,0,0,,Мен бәрібір өмір бойы пәк боламын.
Dialogue: 0,0:11:09.54,0:11:12.54,Default,,0,0,0,,Ку… Гугугу…
Dialogue: 0,0:11:13.50,0:11:14.75,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:11:15.67,0:11:16.46,Default,,0,0,0,,Легоши
Dialogue: 0,0:11:16.92,0:11:20.05,Default,,0,0,0,,Мен сізді мәжбүрлемеймін, бірақ бір рет киіп көріңіз.
Dialogue: 0,0:11:22.47,0:11:23.64,Default,,0,0,0,,Легоши!
Dialogue: 0,0:11:24.55,0:11:27.26,Default,,0,0,0,,Егер Гохин-Чан дегенге дейін барса
Dialogue: 0,0:11:32.35,0:11:34.15,Default,,0,0,0,,Қа… уф…
Dialogue: 0,0:11:37.53,0:11:39.90,Default,,0,0,0,,Хехехе Сіз қалай ойлайсыз?
Dialogue: 0,0:11:39.99,0:11:42.86,Default,,0,0,0,,Хмм, тынышталды.
Dialogue: 0,0:11:44.07,0:11:45.45,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:11:46.24,0:11:48.70,Default,,0,0,0,,Азу тістерді қолданбай, мықты болғым келеді
Dialogue: 0,0:11:48.79,0:11:51.08,Default,,0,0,0,,Сіз Гохин мырзаның қол астында жаттығасыз, солай ма?
Dialogue: 0,0:11:52.92,0:11:55.29,Default,,0,0,0,,Бірақ сен аюмен жекпе-жекке шығасың
Dialogue: 0,0:11:55.38,0:11:58.84,Default,,0,0,0,,Соңында қарақшының аяғын жеп жеңдім.
Dialogue: 0,0:11:59.51,0:12:03.18,Default,,0,0,0,,Осы уақытқа дейін келген болсаңыз, қасқыр өзіңізді қабыл алыңыз.
Dialogue: 0,0:12:03.26,0:12:04.05,Default,,0,0,0,,I—
Dialogue: 0,0:12:04.64,0:12:07.89,Default,,0,0,0,,Яхья-санның үлкен қатысуына куә болу
Dialogue: 0,0:12:07.97,0:12:11.31,Default,,0,0,0,,Ең бірінші барған жерім жерасты базары болды.
Dialogue: 0,0:12:12.73,0:12:15.90,Default,,0,0,0,,Егер мен бейсаналық сүйенетін жерім осы болса.
Dialogue: 0,0:12:15.98,0:12:16.94,Default,,0,0,0,,Мен...
Dialogue: 0,0:12:17.65,0:12:19.15,Default,,0,0,0,,Бұл қайшылық емес пе?
Dialogue: 0,0:12:21.03,0:12:25.49,Default,,0,0,0,,Егер сіз солай ойласаңыз, көңіліңізден шыққанша өзіңіз де ойланыңыз.
Dialogue: 0,0:12:26.62,0:12:29.79,Default,,0,0,0,,Иә, көп рахмет.
Dialogue: 0,0:12:39.50,0:12:44.01,Default,,0,0,0,,Тибет құм түлкілері бет әлпетін нақты көрсетпейді.
Dialogue: 0,0:12:44.09,0:12:45.93,Default,,0,0,0,,Бағалау қиын болды.
Dialogue: 0,0:12:47.18,0:12:51.35,Default,,0,0,0,,Мұғаліммен төбелесіп, одан көмек алдым.
Dialogue: 0,0:12:52.10,0:12:55.23,Default,,0,0,0,,Мен эмоцияларымды бірте-бірте қалпына келтіре бастадым.
Dialogue: 0,0:12:55.94,0:12:58.06,Default,,0,0,0,,Жақсы жұмыс, Ай
Dialogue: 0,0:13:00.27,0:13:05.07,Default,,0,0,0,,Мұғаліммен бірге болған сайын өзімді кінәлі сезіндім.
Dialogue: 0,0:13:05.74,0:13:09.12,Default,,0,0,0,,Сіз енді ешқашан кісі өлтірмейсіз.
Dialogue: 0,0:13:10.49,0:13:11.66,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:13:11.74,0:13:12.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:13.91,0:13:15.08,Default,,0,0,0,,I—
Dialogue: 0,0:13:16.37,0:13:18.29,Default,,0,0,0,,Өзіңізді полицияға тапсырыңыз
Dialogue: 0,0:13:24.92,0:13:28.68,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:13:29.22,0:13:29.97,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:13:31.39,0:13:34.18,Default,,0,0,0,,Мен бәрібір сенің күлкіңді көргім келді.
Dialogue: 0,0:13:34.81,0:13:36.98,Default,,0,0,0,,Мұғалім, күліңіз.
Dialogue: 0,0:13:37.06,0:13:40.15,Default,,0,0,0,,Сіз ең жақсы жол – науқастың өзі қабылдауы деп айттыңыз.
Dialogue: 0,0:13:40.23,0:13:43.19,Default,,0,0,0,,Ал, қоғам үшін.
Dialogue: 0,0:13:44.53,0:13:45.74,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:13:45.82,0:13:48.86,Default,,0,0,0,,Менің дәл қазір мұңайғаным дұрыс.
Dialogue: 0,0:13:48.95,0:13:52.49,Default,,0,0,0,,Олай болса, күлкімді сізге қалдырамын, ұстаз.
Dialogue: 0,0:13:52.58,0:13:53.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:53.33,0:13:56.87,Default,,0,0,0,,Мен түрмеден күліп шыққанша күте тұрыңыз.
Dialogue: 0,0:13:56.96,0:13:57.71,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:13:58.71,0:14:00.25,Default,,0,0,0,,Маған уәде бере аласыз ба?
Dialogue: 0,0:14:00.33,0:14:01.59,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:02.29,0:14:05.21,Default,,0,0,0,,Күлкі болмаса, олар оны қабылдамайды, солай ма?
Dialogue: 0,0:14:07.88,0:14:09.72,Default,,0,0,0,,Тезірек оралыңыз.
Dialogue: 0,0:14:16.14,0:14:17.43,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:14:18.31,0:14:21.19,Default,,0,0,0,,Күтілгендей, нысандар жақсы жабдықталған.
Dialogue: 0,0:14:21.27,0:14:23.98,Default,,0,0,0,,Хару-чан, сен өсімдіктерді жақсы көресің.
Dialogue: 0,0:14:24.07,0:14:25.28,Default,,0,0,0,,Жоқ... Лиза ше?
Dialogue: 0,0:14:25.94,0:14:28.99,Default,,0,0,0,,Бұл оқу орны жұмысқа тұруға қолайлы деп естідім.
Dialogue: 0,0:14:29.07,0:14:30.70,Default,,0,0,0,,Хару-чан басқаша ма?
Dialogue: 0,0:14:30.78,0:14:33.03,Default,,0,0,0,,Мен мейрамхана ашқым келеді.
Dialogue: 0,0:14:33.12,0:14:34.03,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:34.12,0:14:38.04,Default,,0,0,0,,Сонымен, мен тіпті етқоректілер де рахаттана алатын көкөністерді ұсынғым келеді.
Dialogue: 0,0:14:38.54,0:14:39.50,Default,,0,0,0,,Не?
Dialogue: 0,0:14:39.58,0:14:40.12,Default,,0,0,0,,Содан кейін—
Dialogue: 0,0:14:40.21,0:14:43.42,Default,,0,0,0,,Бәріміз бір тағамды жесек, қызық болмай ма?
Dialogue: 0,0:14:43.50,0:14:46.46,Default,,0,0,0,,Сондықтан мен осындай нәрселерді зерттесем деп тілеймін.
Dialogue: 0,0:14:46.55,0:14:49.51,Default,,0,0,0,,Сен өзгердің, Хару-чан.
Dialogue: 0,0:14:54.93,0:14:56.72,Default,,0,0,0,,Жаңа студенттер
Dialogue: 0,0:14:56.81,0:15:00.27,Default,,0,0,0,,«Дәмі және жеуге жарамды өсімдіктер» сабағына қош келдіңіздер!
Dialogue: 0,0:15:00.85,0:15:01.52,Default,,0,0,0,,О
Dialogue: 0,0:15:02.31,0:15:03.36,Default,,0,0,0,,Тек осы екі қарапайым белгіні есте сақта.
Dialogue: 0,0:15:03.98,0:15:07.03,Default,,0,0,0,,Олардың барлығы шөпқоректілер, солай ма?
Dialogue: 0,0:15:07.11,0:15:12.45,Default,,0,0,0,,Бұл әдемі өсімдіктер аңның иісін сезбейді хахаха...
Dialogue: 0,0:15:12.53,0:15:13.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:14.83,0:15:20.08,Default,,0,0,0,,Біз шөпқоректілердің етқоректілерге қарағанда дәм сезу қабілеті әлдеқайда жақсы.
Dialogue: 0,0:15:20.16,0:15:24.21,Default,,0,0,0,,Олар біз білетін нәрселердің дәмін сезе алмайды.
Dialogue: 0,0:15:24.29,0:15:26.13,Default,,0,0,0,,Бұл айуандық және қатыгездік.
Dialogue: 0,0:15:28.59,0:15:30.34,Default,,0,0,0,,Бұл кемсітушілік емес пе?
Dialogue: 0,0:15:30.42,0:15:31.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:31.55,0:15:34.93,Default,,0,0,0,,Менің жігітім де үнемі сол сөздерді ренжітетінін айтады.
Dialogue: 0,0:15:35.01,0:15:37.85,Default,,0,0,0,,Білім беру жағдайында мұндай сөздерді айту қауіпті емес пе?
Dialogue: 0,0:15:37.93,0:15:42.02,Default,,0,0,0,,Иә, әрине, кешіріңіз.
Dialogue: 0,0:15:43.10,0:15:44.48,Default,,0,0,0,,Сіз шынымен кездесіп жүрсіз бе?
Dialogue: 0,0:15:44.56,0:15:48.11,Default,,0,0,0,,Жоқ, сіз кездесе бастағаннан кейін құндылықтарыңыз шынымен өзгереді.
Dialogue: 0,0:15:48.19,0:15:51.70,Default,,0,0,0,,Иә, ендеше өзімізді жұлып алып, сабақты бастайық.
Dialogue: 0,0:15:55.57,0:15:57.33,Default,,0,0,0,,Ако-чан керемет!
Dialogue: 0,0:15:57.41,0:15:59.12,Default,,0,0,0,,Өте керемет болды!
Dialogue: 0,0:15:59.20,0:16:01.37,Default,,0,0,0,,О? Не? не болды?
Dialogue: 0,0:16:01.46,0:16:05.50,Default,,0,0,0,,Мен профессорға ескі құндылықтардың ақсақ екенін айттым.
Dialogue: 0,0:16:05.58,0:16:08.92,Default,,0,0,0,,Жыртқыш пен шөпқоректінің арасындағы сүйіспеншілік қауіпті болып саналады.
Dialogue: 0,0:16:09.00,0:16:12.93,Default,,0,0,0,,Егер біз бір-бірімізді өзіміз сияқты түсінсек, міндетті түрде бәрі жақсы болар еді.
Dialogue: 0,0:16:13.01,0:16:15.01,Default,,0,0,0,,Меніңше, бұл жайды жай айтпаған жөн.
Dialogue: 0,0:16:15.09,0:16:15.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:17.55,0:16:21.73,Default,,0,0,0,,Етқоректілер мен шөпқоректілер бір-бірін түсіну арқылы ғана жұп бола алатын болса.
Dialogue: 0,0:16:21.81,0:16:25.06,Default,,0,0,0,,Бұл дүниеде сою оқиғаларының жиі орын алуы мүмкін емес.
Dialogue: 0,0:16:25.69,0:16:29.02,Default,,0,0,0,,Жүрегің не істесе де, түйсігіңе жете алмайды.
Dialogue: 0,0:16:29.11,0:16:30.94,Default,,0,0,0,,Мен дұрыс түсіндім бе деп ойлаймын.
Dialogue: 0,0:16:31.03,0:16:31.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:31.94,0:16:34.36,Default,,0,0,0,,Сіз оның денесін іздейсіз,
Dialogue: 0,0:16:34.45,0:16:36.57,Default,,0,0,0,,Шынымен біреуді толық сүю мүмкін бе?
Dialogue: 0,0:16:37.91,0:16:39.79,Default,,0,0,0,,Немесе мен солай ойладым.
Dialogue: 0,0:16:39.87,0:16:42.29,Default,,0,0,0,,Біріншіден, екеуіңе қатысты
Dialogue: 0,0:16:42.37,0:16:44.16,Default,,0,0,0,,Біз сән арқылы танысамыз, солай ма?
Dialogue: 0,0:16:44.75,0:16:45.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:48.59,0:16:50.00,Default,,0,0,0,,Та-да!
Dialogue: 0,0:16:50.09,0:16:52.42,Default,,0,0,0,,Мазасыз деп ұрма.
Dialogue: 0,0:16:52.51,0:16:54.30,Default,,0,0,0,,Неге ашуланбайсың?
Dialogue: 0,0:16:54.38,0:16:56.72,Default,,0,0,0,,Маған тым болмаса біреуін берші.
Dialogue: 0,0:16:56.80,0:16:58.43,Default,,0,0,0,,Мен ұялдым, солай ма?
Dialogue: 0,0:16:58.51,0:17:00.68,Default,,0,0,0,,О, мен емес...
Dialogue: 0,0:17:00.76,0:17:03.52,Default,,0,0,0,,Жарайды, сен жұлдыз болғандықтан ашулысың.
Dialogue: 0,0:17:03.60,0:17:05.27,Default,,0,0,0,,Олар сәнге байланысты кездесіп жатыр.
Dialogue: 0,0:17:05.35,0:17:06.48,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:17:06.56,0:17:11.48,Default,,0,0,0,,Шынымды айтсам, біз бір-бірімізбен ойнап жатырмыз, сондықтан бұлай ашуланудың қажеті жоқ, солай ма?
Dialogue: 0,0:17:12.11,0:17:13.53,Default,,0,0,0,,- Эйр - А?
Dialogue: 0,0:17:14.74,0:17:16.95,Default,,0,0,0,,Сіз қарапайым арыстансыз.
Dialogue: 0,0:17:17.03,0:17:18.03,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:18.12,0:17:21.58,Default,,0,0,0,,Мен қоянды ұрғашы ретінде көрмей қашып бара жатырсың ба?
Dialogue: 0,0:17:21.66,0:17:24.91,Default,,0,0,0,,Егер басқаша айтсаң, мені осы жерде және қазір сүй!
Dialogue: 0,0:17:25.46,0:17:28.46,Default,,0,0,0,,Ахахаха... хаха~
Dialogue: 0,0:17:28.54,0:17:29.84,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:17:39.51,0:17:40.26,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:41.31,0:17:43.89,Default,,0,0,0,,А-а... тырыссаң қолыңнан келеді.
Dialogue: 0,0:17:43.97,0:17:46.98,Default,,0,0,0,,«Қарапайым арыстанды» елемеуге болмайды.
Dialogue: 0,0:18:12.09,0:18:13.84,Default,,0,0,0,,Мұндағы керек-жарақтар пілдерге арналған.
Dialogue: 0,0:18:13.92,0:18:16.17,Default,,0,0,0,,Өлшемдері сәйкес келеді.
Dialogue: 0,0:18:16.76,0:18:20.68,Default,,0,0,0,,Шөпқоректі мұғаліммен сөйлескеніме қуаныштымын.
Dialogue: 0,0:18:22.14,0:18:25.18,Default,,0,0,0,,Қаншалықты үлкен немесе қауіпті болса да
Dialogue: 0,0:18:25.85,0:18:28.06,Default,,0,0,0,,Өйткені біз шөпқоректіміз
Dialogue: 0,0:18:28.14,0:18:30.31,Default,,0,0,0,,Бұл... бұл...
Dialogue: 0,0:18:31.52,0:18:35.69,Default,,0,0,0,,Жарайды, үрейленбе, бәрін сыртқа шығар.
Dialogue: 0,0:18:36.65,0:18:39.66,Default,,0,0,0,,(піл жылайды)
Dialogue: 0,0:18:45.16,0:18:46.16,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,0:18:46.70,0:18:50.25,Default,,0,0,0,,Кешіріңіз, мен жылағым келген жоқпын.
Dialogue: 0,0:18:50.75,0:18:51.63,Default,,0,0,0,,Оның жеңінің астында не бар екенін анықтайық
Dialogue: 0,0:18:57.21,0:18:59.93,Default,,0,0,0,,А, менің ойымша, бұл науқас.
Dialogue: 0,0:19:00.01,0:19:01.97,Default,,0,0,0,,Сіз тапсырыс бердіңіз бе?
Dialogue: 0,0:19:02.05,0:19:04.47,Default,,0,0,0,,Бағалы заттарды қабылдау бөлімінде қалдыру керек.
Dialogue: 0,0:19:05.06,0:19:07.06,Default,,0,0,0,,Мен сенің кім екеніңді білемін.
Dialogue: 0,0:19:07.14,0:19:10.44,Default,,0,0,0,,Бистер-сама мені танитыны үшін мақтанамын.
Dialogue: 0,0:19:10.52,0:19:12.69,Default,,0,0,0,,Хахаха бұл менмін
Dialogue: 0,0:19:13.81,0:19:14.73,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:15.82,0:19:16.78,Default,,0,0,0,,Сіз...!
Dialogue: 0,0:19:16.86,0:19:19.24,Default,,0,0,0,,О? Сіз білдіңіз бе?
Dialogue: 0,0:19:20.36,0:19:21.78,Default,,0,0,0,,Менің атым Қауын
Dialogue: 0,0:19:22.61,0:19:24.07,Default,,0,0,0,,Есіңізде ме?
Dialogue: 0,0:19:24.62,0:19:26.41,Default,,0,0,0,,Гах…
Dialogue: 0,0:19:27.79,0:19:29.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:29.08,0:19:31.67,Default,,0,0,0,,А, мен сенімен танысуға мүмкіндік алдым.
Dialogue: 0,0:19:32.79,0:19:35.54,Default,,0,0,0,,Кешіріңіз, мен сізді кешке шақыра алмаймын.
Dialogue: 0,0:19:36.67,0:19:38.71,Default,,0,0,0,,А... күте тұрыңыз...
Dialogue: 0,0:19:39.80,0:19:40.72,Default,,0,0,0,,(Итадори) Ол менің жұдырығымды толық жеделдемей тұрып маңдайына алды!
Dialogue: 0,0:19:43.47,0:19:45.26,Default,,0,0,0,,(Яхьяның айқайы)
Dialogue: 0,0:19:48.77,0:19:51.39,Default,,0,0,0,,Күрсін, мен тым көп айттым.
Dialogue: 0,0:19:51.48,0:19:54.61,Default,,0,0,0,,Шынымды айтсам, мен қате айтқан жоқпын.
Dialogue: 0,0:19:54.69,0:19:55.86,Default,,0,0,0,,Дос жұптарға арналған
Dialogue: 0,0:19:55.94,0:19:58.23,Default,,0,0,0,,Кенеттен бірдеңе айту шынымен де ең жаман нәрсе.
Dialogue: 0,0:19:59.78,0:20:03.03,Default,,0,0,0,,Мүмкін мен қызғанған шығармын.
Dialogue: 0,0:20:03.11,0:20:05.91,Default,,0,0,0,,Бұл нәсілдік жұп көңіл көтеріп жүрген сияқты.
Dialogue: 0,0:20:06.58,0:20:08.45,Default,,0,0,0,,Ако-чаннан дұрыстап кешірім сұрайық
Dialogue: 0,0:20:08.54,0:20:08.99,Default,,0,0,0,,- (1-оқушы) Иә? Шынайы ма? -(2-оқушы) Өте қауіпті көрінеді.
Dialogue: 0,0:20:08.99,0:20:11.16,Default,,0,0,0,,- (1-оқушы) Иә? Шынайы ма? -(2-оқушы) Өте қауіпті көрінеді.
Dialogue: 0,0:20:08.99,0:20:11.16,Default,,0,0,0,,(сирена дыбысы)
Dialogue: 0,0:20:11.16,0:20:12.16,Default,,0,0,0,,(сирена дыбысы)
Dialogue: 0,0:20:13.00,0:20:14.08,Default,,0,0,0,,О, Ако!
Dialogue: 0,0:20:14.17,0:20:15.71,Default,,0,0,0,,Әй, артқа тұр, артқа тұр.
Dialogue: 0,0:20:17.29,0:20:20.13,Default,,0,0,0,,Мен... Мен енді түсінбеймін.
Dialogue: 0,0:20:21.38,0:20:22.55,Default,,0,0,0,,Ааах…
Dialogue: 0,0:20:24.13,0:20:24.72,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:25.80,0:20:26.85,Default,,0,0,0,,Мен...
Dialogue: 0,0:20:30.06,0:20:31.68,Default,,0,0,0,,Ол мені сүйіп алуымды өтінді.
Dialogue: 0,0:20:32.56,0:20:34.27,Default,,0,0,0,,Менің оны жегім келмеді.
Dialogue: 0,0:20:34.77,0:20:37.48,Default,,0,0,0,,Бірақ мен абдырап қалдым...
Dialogue: 0,0:20:37.56,0:20:38.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:40.78,0:20:43.28,Default,,0,0,0,,Өтінемін! Өтінемін маған көмектесіңіз!
Dialogue: 0,0:20:43.36,0:20:45.57,Default,,0,0,0,,- (2-ші полиция қызметкері) Тезірек жүріңіз! -Ако!
Dialogue: 0,0:20:45.66,0:20:46.62,Default,,0,0,0,,Сәлем! ауызыңды жап!
Dialogue: 0,0:20:47.20,0:20:48.37,Default,,0,0,0,,-Ако! -(Полиция қызметкері 1) Кіріңіз.
Dialogue: 0,0:20:49.74,0:20:52.33,Default,,0,0,0,,Жер қанға боялған
Dialogue: 0,0:20:53.58,0:20:56.21,Default,,0,0,0,,Бүгін өте жылы және көңілді.
Dialogue: 0,0:21:01.46,0:21:02.34,Default,,0,0,0,,Сіз дымқыл боласыз
Dialogue: 0,0:21:03.51,0:21:06.34,Default,,0,0,0,,Уақыт өте келе белгілер қалады, солай ма?
Dialogue: 0,0:21:09.01,0:21:11.43,Default,,0,0,0,,Сен оның денесін іздейсің,
Dialogue: 0,0:21:11.52,0:21:13.98,Default,,0,0,0,,Шынымен біреуді толық сүю мүмкін бе?
Dialogue: 0,0:21:16.73,0:21:18.27,Default,,0,0,0,,Мен оны әу бастан білдім
Dialogue: 0,0:21:21.32,0:21:23.57,Default,,0,0,0,,Етқоректіге деген шынайы махаббат –
Dialogue: 0,0:21:24.44,0:21:25.40,Default,,0,0,0,,Бұл қиын
Dialogue: 0,0:21:25.90,0:21:27.45,Default,,0,0,0,,Тек ауыратын нәрселер
Dialogue: 0,0:21:28.24,0:21:31.62,Default,,0,0,0,,Әрқашан бірге күлу оңай болған жоқ.
Dialogue: 0,0:21:33.04,0:21:34.04,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:21:34.71,0:21:35.66,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:36.54,0:21:38.29,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:21:40.25,0:21:41.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:42.00,0:21:43.46,Default,,0,0,0,,Ах~
Dialogue: 0,0:21:43.55,0:21:45.38,Default,,0,0,0,,Ахх!
Dialogue: 0,0:21:50.64,0:21:51.81,Default,,0,0,0,,Бүгін сағат 15:00 шамасында...
Dialogue: 0,0:21:51.89,0:21:53.10,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:21:53.18,0:21:56.69,Default,,0,0,0,,Алғама университетінде союға әрекеттену оқиғасы орын алды.
Dialogue: 0,0:21:56.77,0:21:58.69,Default,,0,0,0,,Бұл Хару-чанның университеті.
Dialogue: 0,0:21:58.77,0:22:00.52,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:22:03.23,0:22:03.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:04.53,0:22:06.99,Default,,0,0,0,,Легоси-кун! туылған күніңмен!
Dialogue: 0,0:22:07.07,0:22:11.28,Default,,0,0,0,,А... осыны айтқым келді.
Dialogue: 0,0:22:11.99,0:22:13.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.54,0:23:41.54,Default,,0,0,0,,～♪
