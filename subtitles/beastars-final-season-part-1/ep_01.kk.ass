Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:49.17,0:00:56.13,Default,,0,0,0,,(араластырғыштың айналу дыбысы)
Dialogue: 0,0:01:18.95,0:01:23.08,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:01:23.70,0:01:25.25,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:01:27.00,0:01:29.88,Default,,0,0,0,,Бұл қаңтардағы есеп пе?
Dialogue: 0,0:01:31.25,0:01:33.84,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,0:01:34.67,0:01:39.43,Default,,0,0,0,,17 жасар қасқыр досының бұғының аяғын жеп қойды.
Dialogue: 0,0:01:40.51,0:01:43.31,Default,,0,0,0,,Мұндай жағдайлар өте көп.
Dialogue: 0,0:01:44.81,0:01:46.02,Default,,0,0,0,,Қателіктеріңе көп тоқталудың орнына,
Dialogue: 0,0:01:46.98,0:01:49.85,Default,,0,0,0,,«Достар өзара келіседі».
Dialogue: 0,0:01:50.98,0:01:56.69,Default,,0,0,0,,«Мақсат тамақ өлтірушіні жеңу немесе жеңу болды»?
Dialogue: 0,0:01:57.65,0:02:01.62,Default,,0,0,0,,Уларды умен бақылау...?
Dialogue: 0,0:02:02.53,0:02:04.24,Default,,0,0,0,,Қызықты
Dialogue: 0,0:02:05.16,0:02:07.58,Default,,0,0,0,,Бірақ бұл қауіпті ой.
Dialogue: 0,0:02:09.12,0:02:13.09,Default,,0,0,0,,Келісім болса да, оны ешқашан кешіруге болмайды.
Dialogue: 0,0:02:18.47,0:02:20.34,Default,,0,0,0,,Бұл дүние —
Dialogue: 0,0:02:22.22,0:02:24.10,Default,,0,0,0,,Құбыжық ретінде
Dialogue: 0,0:03:02.47,0:03:05.22,Default,,0,0,0,,(Легошидің ырылдауы)
Dialogue: 0,0:03:10.35,0:03:13.19,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:03:14.48,0:03:16.02,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:03:17.94,0:03:19.40,Default,,0,0,0,,Шыу!
Dialogue: 0,0:03:28.54,0:03:32.46,Default,,0,0,0,,(құтырған дыбыс)
Dialogue: 0,0:03:36.79,0:03:40.34,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:03:42.26,0:03:43.84,Default,,0,0,0,,(құтырған дыбыс)
Dialogue: 0,0:03:50.06,0:03:51.18,Default,,0,0,0,,Шыу!
Dialogue: 0,0:03:54.73,0:03:57.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:57.73,0:03:59.48,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:04:10.04,0:04:12.58,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:04:14.50,0:04:15.92,Default,,0,0,0,,Шыу!
Dialogue: 0,0:04:16.00,0:04:17.88,Default,,0,0,0,,Легоши жеңіз
Dialogue: 0,0:04:19.67,0:04:22.01,Default,,0,0,0,,Бірінші және соңғы ет
Dialogue: 0,0:04:22.09,0:04:23.80,Default,,0,0,0,,Тіпті ант етсең де...
Dialogue: 0,0:04:23.80,0:04:24.43,Default,,0,0,0,,Тіпті ант етсең де...
Dialogue: 0,0:04:23.80,0:04:24.43,Default,,0,0,0,,Сүйікті саусағыңызды таңдаңыз
Dialogue: 0,0:04:24.43,0:04:25.01,Default,,0,0,0,,Сүйікті саусағыңызды таңдаңыз
Dialogue: 0,0:04:25.01,0:04:26.51,Default,,0,0,0,,Сүйікті саусағыңызды таңдаңыз
Dialogue: 0,0:04:25.01,0:04:26.51,Default,,0,0,0,,Оның дәмі мен құрылымы...
Dialogue: 0,0:04:26.51,0:04:28.22,Default,,0,0,0,,Оның дәмі мен құрылымы...
Dialogue: 0,0:04:28.30,0:04:29.18,Default,,0,0,0,,Сен де мұны қалайсың ба?
Dialogue: 0,0:04:29.18,0:04:29.93,Default,,0,0,0,,Сен де соны қалайсың ба?
Dialogue: 0,0:04:29.18,0:04:29.93,Default,,0,0,0,,Нодогоши дәмі…
Dialogue: 0,0:04:29.93,0:04:30.01,Default,,0,0,0,,Нодогоши дәмі…
Dialogue: 0,0:04:30.01,0:04:31.52,Default,,0,0,0,,Нодогоши дәмі…
Dialogue: 0,0:04:30.01,0:04:31.52,Default,,0,0,0,,Қоянның қаны
Dialogue: 0,0:04:31.52,0:04:32.35,Default,,0,0,0,,Нодогоши дәмі…
Dialogue: 0,0:04:33.60,0:04:34.64,Default,,0,0,0,,Аһ!
Dialogue: 0,0:04:35.40,0:04:36.65,Default,,0,0,0,,жылы
Dialogue: 0,0:04:38.19,0:04:39.11,Default,,0,0,0,,Шарасыз
Dialogue: 0,0:04:40.57,0:04:41.57,Default,,0,0,0,,Қайғымен
Dialogue: 0,0:04:42.53,0:04:45.82,Default,,0,0,0,,Сіз шынымен бақыттысыз.
Dialogue: 0,0:04:45.91,0:04:47.82,Default,,0,0,0,,Қалай күрессең де, сенің мәнің
Dialogue: 0,0:04:47.91,0:04:51.04,Default,,0,0,0,,Қараңғыда боялған жыртқыш жыртқыш аң
Dialogue: 0,0:04:51.12,0:04:55.25,Default,,0,0,0,,Мен бұл қанның зардабын тарттым.
Dialogue: 0,0:04:59.04,0:05:00.67,Default,,0,0,0,,Мен бұл дүниені қалаймын
Dialogue: 0,0:05:01.17,0:05:04.17,Default,,0,0,0,,Мен оның Хару-чанның тыныш өмір сүретін жері болғанын қалаймын.
Dialogue: 0,0:05:06.01,0:05:06.63,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:05:08.89,0:05:09.85,Default,,0,0,0,,(шағу дыбысы)
Dialogue: 0,0:05:09.93,0:05:11.68,Default,,0,0,0,,Осы денеде ағып жатқан қан
Dialogue: 0,0:05:12.72,0:05:14.98,Default,,0,0,0,,Әлі тірі ет іздеуде
Dialogue: 0,0:05:15.06,0:05:22.07,Default,,0,0,0,,(Легошидің айқайы мен азап дауысы)
Dialogue: 0,0:05:30.99,0:05:32.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:32.91,0:05:34.70,Default,,0,0,0,,(Легошидің ырылдауы)
Dialogue: 0,0:05:34.79,0:05:35.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:37.08,0:05:39.17,Default,,0,0,0,,Ах! шулы!
Dialogue: 0,0:05:39.25,0:05:42.59,Default,,0,0,0,,Әр түн, әр түн! Менің де ертең жұмысым бар!
Dialogue: 0,0:05:42.67,0:05:44.88,Default,,0,0,0,,(Легошидің ырылдауы)
Dialogue: 0,0:05:47.88,0:05:52.64,Default,,0,0,0,,Ол көшіп келгенде сәлем демеген, сондықтан ол жақсы адам емес.
Dialogue: 0,0:05:53.01,0:05:55.06,Default,,0,0,0,,Бір ауыз сөзбен даттаймын.
Dialogue: 0,0:05:58.94,0:06:00.23,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:06:02.11,0:06:03.69,Default,,0,0,0,,Қасқыр?
Dialogue: 0,0:06:05.11,0:06:06.11,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:06:06.69,0:06:09.82,Default,,0,0,0,,Кенеттен шағымдану жақсы емес.
Dialogue: 0,0:06:10.28,0:06:16.20,Default,,0,0,0,,(бетті сумен жуған дыбыс)
Dialogue: 0,0:06:17.66,0:06:19.79,Default,,0,0,0,,Сәлем… Қайырлы кеш.
Dialogue: 0,0:06:19.87,0:06:21.29,Default,,0,0,0,,(кранды ашу дыбысы)
Dialogue: 0,0:06:21.38,0:06:22.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:22.13,0:06:23.21,Default,,0,0,0,,Ха...
Dialogue: 0,0:06:23.80,0:06:25.34,Default,,0,0,0,,I... I
Dialogue: 0,0:06:25.42,0:06:28.67,Default,,0,0,0,,Менің атым Жеті, мен көрші бөлмеденмін. Танысқаныма қуаныштымын...
Dialogue: 0,0:06:28.76,0:06:30.09,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:06:36.39,0:06:38.64,Default,,0,0,0,,Еленбейді ме? Бұл не?
Dialogue: 0,0:06:39.23,0:06:41.02,Default,,0,0,0,,Қоғам мүшесі ретінде мүмкін емес
Dialogue: 0,0:06:42.94,0:06:45.86,Default,,0,0,0,,Кешіріңіз, көршім.
Dialogue: 0,0:06:48.24,0:06:51.86,Default,,0,0,0,,Мен бұған ешқашан жол бермеймін, иә?
Dialogue: 0,0:06:53.32,0:06:56.37,Default,,0,0,0,,(Ит үреді)
Dialogue: 0,0:07:01.87,0:07:05.80,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:07:07.34,0:07:10.80,Default,,0,0,0,,Иә? Менде ет жеуге реакция жоқ.
Dialogue: 0,0:07:12.47,0:07:15.72,Default,,0,0,0,,Сіз ет жемейтініңізге сенімдісіз бе? Сол жігіт
Dialogue: 0,0:07:17.27,0:07:20.14,Default,,0,0,0,,Жоқ, бұл симптом біртүрлі.
Dialogue: 0,0:07:20.23,0:07:21.98,Default,,0,0,0,,(Ит үреді)
Dialogue: 0,0:07:22.06,0:07:24.27,Default,,0,0,0,,Бұл тек ет ауруы емес.
Dialogue: 0,0:07:26.98,0:07:28.99,Default,,0,0,0,,Жеткізу Мен әкелдім.
Dialogue: 0,0:07:29.07,0:07:31.86,Default,,0,0,0,,О, кіріңіз.
Dialogue: 0,0:07:34.70,0:07:36.03,Default,,0,0,0,,Оны сол жерде қалдырыңыз.
Dialogue: 0,0:07:41.58,0:07:44.75,Default,,0,0,0,,Бамбук жапырағы жағылған шәйнек дәуірі
Dialogue: 0,0:07:44.83,0:07:46.46,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:07:46.54,0:07:47.55,Default,,0,0,0,,500 иен
Dialogue: 0,0:07:47.63,0:07:50.72,Default,,0,0,0,,Не кисең де жақсы көрінесің.
Dialogue: 0,0:07:50.80,0:07:52.68,Default,,0,0,0,,Сіз мені кроссовка деп қалжыңдап тұрсыз ба?
Dialogue: 0,0:07:52.76,0:07:56.01,Default,,0,0,0,,Сол кезде мен ажырасқан әйелім маған қайта орала ма деп уайымдадым.
Dialogue: 0,0:07:56.10,0:07:56.97,Default,,0,0,0,,Гахахаха!
Dialogue: 0,0:07:57.64,0:07:58.47,Default,,0,0,0,,Ал, отырыңыз.
Dialogue: 0,0:08:00.93,0:08:03.23,Default,,0,0,0,,Уф, не істеуді жоспарлап отырсыз?
Dialogue: 0,0:08:04.77,0:08:06.90,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:08:07.48,0:08:10.53,Default,,0,0,0,,Уф... маған тістеп берші.
Dialogue: 0,0:08:10.61,0:08:12.90,Default,,0,0,0,,Ууууу... Кинус...
Dialogue: 0,0:08:12.99,0:08:17.49,Default,,0,0,0,,Мен шөпқоректінің аяғын жедім.
Dialogue: 0,0:08:17.58,0:08:20.29,Default,,0,0,0,,Мен түрмеде жасаған қылмыстарымды өтеуді көздедім.
Dialogue: 0,0:08:21.00,0:08:24.58,Default,,0,0,0,,Бірақ Луис ағаларының айғақтарының арқасында,
Dialogue: 0,0:08:25.63,0:08:28.84,Default,,0,0,0,,Ол жеңіл айыппен босатылды.
Dialogue: 0,0:08:29.96,0:08:34.13,Default,,0,0,0,,Бірақ «каннибализмге дейінгі» жазбада қалған сияқты.
Dialogue: 0,0:08:34.76,0:08:38.18,Default,,0,0,0,,Бетінде тыртығы бар тың бұрынғы сотталған?
Dialogue: 0,0:08:38.85,0:08:42.85,Default,,0,0,0,,Өйткені, олар әлі күнге дейін жегіштерді ұстап, емдейді.
Dialogue: 0,0:08:43.56,0:08:45.19,Default,,0,0,0,,(Гухиннің күрсінуі)
Dialogue: 0,0:08:45.77,0:08:48.15,Default,,0,0,0,,Жағдай бұрынғыдан жақсы емес.
Dialogue: 0,0:08:48.90,0:08:51.98,Default,,0,0,0,,Сіз маған тағы да жұмысыма көмектесесіз бе?
Dialogue: 0,0:08:52.82,0:08:54.24,Default,,0,0,0,,Мен удон мейрамханасынан көп ақша табамын
Dialogue: 0,0:08:54.32,0:08:55.70,Default,,0,0,0,,Жоқ, маған керегі жоқ.
Dialogue: 0,0:08:55.78,0:08:57.87,Default,,0,0,0,,Заңсыз ақша?
Dialogue: 0,0:08:57.95,0:09:00.28,Default,,0,0,0,,Не деген сұмдық, қарғыс атқыр бала!
Dialogue: 0,0:09:02.33,0:09:06.50,Default,,0,0,0,,Мен қояным Хару-чанмен жұртшылықтың көз алдында еңбек етіп жүрмін.
Dialogue: 0,0:09:06.58,0:09:10.34,Default,,0,0,0,,Менің мақсатым – бақытты отбасылық өмір сүру.
Dialogue: 0,0:09:12.84,0:09:15.05,Default,,0,0,0,,Айтпақшы, сіз ше?
Dialogue: 0,0:09:15.13,0:09:15.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:16.26,0:09:19.05,Default,,0,0,0,,А... үйде ме?
Dialogue: 0,0:09:19.14,0:09:21.56,Default,,0,0,0,,А, жоқ, оны мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:09:21.64,0:09:23.52,Default,,0,0,0,,Мен жай ғана бұлыңғыр естідім.
Dialogue: 0,0:09:23.60,0:09:24.52,Default,,0,0,0,,Ал...
Dialogue: 0,0:09:25.43,0:09:27.60,Default,,0,0,0,,Әкесі де, анасы да жоқ
Dialogue: 0,0:09:28.35,0:09:30.52,Default,,0,0,0,,Мен атаммен бірге тұрдым.
Dialogue: 0,0:09:31.48,0:09:33.15,Default,,0,0,0,,Қарияның жағдайы жақсы ма?
Dialogue: 0,0:09:33.69,0:09:34.57,Default,,0,0,0,,О, расымен бе?
Dialogue: 0,0:09:37.11,0:09:37.91,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:38.49,0:09:41.91,Default,,0,0,0,,Аа, біз жаман емеспіз.
Dialogue: 0,0:09:41.99,0:09:43.74,Default,,0,0,0,,Мен ғана...
Dialogue: 0,0:09:45.04,0:09:47.79,Default,,0,0,0,,Сіз маған қамауға алынғаныңызды да айтқан жоқсыз.
Dialogue: 0,0:09:52.96,0:09:55.01,Default,,0,0,0,,Мұны өзіңізбен бірге алыңыз. Бұл дәрі.
Dialogue: 0,0:09:55.09,0:09:55.92,Default,,0,0,0,,О
Dialogue: 0,0:09:56.55,0:09:58.05,Default,,0,0,0,,Еттен бас тарту белгілері
Dialogue: 0,0:09:58.13,0:10:01.18,Default,,0,0,0,,Шамамен 3 толық айға дейін бұл өте қиын.
Dialogue: 0,0:10:01.80,0:10:02.81,Default,,0,0,0,,Кез келген жағдайда.
Dialogue: 0,0:10:02.89,0:10:03.72,Default,,0,0,0,,О
Dialogue: 0,0:10:05.27,0:10:06.35,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:06.89,0:10:07.73,Default,,0,0,0,,О
Dialogue: 0,0:10:08.94,0:10:11.11,Default,,0,0,0,,- Кездескенше - Кешіріңіз?
Dialogue: 0,0:10:13.48,0:10:14.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:15.90,0:10:16.57,Default,,0,0,0,,Легоши!
Dialogue: 0,0:10:16.65,0:10:18.24,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:10:18.32,0:10:21.20,Default,,0,0,0,,Сіз жаңа ғана каннибализмге дейінгі айттыңыз.
Dialogue: 0,0:10:21.87,0:10:22.41,Default,,0,0,0,,Иә
Dialogue: 0,0:10:23.08,0:10:24.16,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:24.24,0:10:26.75,Default,,0,0,0,,Егер сіз каннибалға дейінгі адам болсаңыз, олай істей алмайсыз.
Dialogue: 0,0:10:27.33,0:10:28.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:28.16,0:10:30.37,Default,,0,0,0,,Шөпқоректілермен аралас неке
Dialogue: 0,0:10:30.46,0:10:31.25,Default,,0,0,0,,Не!
Dialogue: 0,0:10:32.00,0:10:33.34,Default,,0,0,0,,Тұрмысқа шыға алмайсыз ба?
Dialogue: 0,0:10:34.38,0:10:35.63,Default,,0,0,0,,Эх!
Dialogue: 0,0:10:36.67,0:10:43.68,Default,,0,0,0,,Хару чааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:10:46.64,0:10:47.43,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:48.31,0:10:50.19,Default,,0,0,0,,Бұл жастық шақ.
Dialogue: 0,0:11:00.28,0:11:01.41,Default,,0,0,0,,Ибуки
Dialogue: 0,0:11:02.11,0:11:05.91,Default,,0,0,0,,Аңдар патшасы қаһарлы және күшті болуы керек, бірақ...
Dialogue: 0,0:11:06.87,0:11:11.96,Default,,0,0,0,,Жалаң сұлу, жұмсақ.
Dialogue: 0,0:11:22.89,0:11:25.30,Default,,0,0,0,,Сіз қалай ойлайсыз? Аяқтарың қалай?
Dialogue: 0,0:11:26.01,0:11:28.31,Default,,0,0,0,,Бір қызығы, ол жүруге көмектеседі.
Dialogue: 0,0:11:30.73,0:11:34.61,Default,,0,0,0,,Өйткені біз ең соңғы материалдар мен үздік технологияны қолдандық.
Dialogue: 0,0:11:35.31,0:11:37.53,Default,,0,0,0,,Университет өмірі қиындық тудырмайды.
Dialogue: 0,0:11:41.45,0:11:43.24,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:44.74,0:11:46.28,Default,,0,0,0,,Сіздің аяқтарыңыз
Dialogue: 0,0:11:46.37,0:11:50.75,Default,,0,0,0,,Бұл Horns конгломератының мұрагері ретінде жолда жүруге арналған.
Dialogue: 0,0:11:50.83,0:11:53.58,Default,,0,0,0,,Етқоректілердің тұтынуына арналмаған
Dialogue: 0,0:11:54.71,0:11:55.88,Default,,0,0,0,,Иә
Dialogue: 0,0:11:55.96,0:11:59.51,Default,,0,0,0,,Маған импровизация ұнады, бірақ бұл тым көп болды.
Dialogue: 0,0:12:00.30,0:12:03.09,Default,,0,0,0,,Менің жоспарың бойынша өмір сүргенімді қалайсың ба?
Dialogue: 0,0:12:03.63,0:12:06.51,Default,,0,0,0,,Хехе, дұрыс.
Dialogue: 0,0:12:06.60,0:12:08.14,Default,,0,0,0,,Бірақ бұл бәрі емес.
Dialogue: 0,0:12:08.76,0:12:11.60,Default,,0,0,0,,Мен сенің өз бетінше ойланып, жасағаныңды қалаймын.
Dialogue: 0,0:12:11.68,0:12:13.35,Default,,0,0,0,,Сіздің рөліңіз
Dialogue: 0,0:12:16.40,0:12:20.07,Default,,0,0,0,,Бұл жолы мен онымен бетпе-бет келуім керек.
Dialogue: 0,0:12:20.90,0:12:22.99,Default,,0,0,0,,Қоғамнан тыс емес
Dialogue: 0,0:12:24.11,0:12:27.91,Default,,0,0,0,,Бұл қоғамда біз қалай өмір сүріп жатырмыз?
Dialogue: 0,0:12:52.43,0:12:54.89,Default,,0,0,0,,Сіз бэк-маркетке бардыңыз ба?
Dialogue: 0,0:12:54.98,0:12:56.52,Default,,0,0,0,,Ет пәктігін бітірдіңіз бе?
Dialogue: 0,0:12:57.23,0:12:58.06,Default,,0,0,0,,Қандай ет?
Dialogue: 0,0:12:58.15,0:12:59.94,Default,,0,0,0,,Менің ойымша, бұл шошқа...
Dialogue: 0,0:13:00.02,0:13:02.03,Default,,0,0,0,,Не? «Ойлау» нені білдіреді?
Dialogue: 0,0:13:02.11,0:13:04.28,Default,,0,0,0,,Ештеңе етпейді, мен жедім.
Dialogue: 0,0:13:04.36,0:13:06.07,Default,,0,0,0,,Бұл күдікті.
Dialogue: 0,0:13:07.78,0:13:11.08,Default,,0,0,0,,Мұндай әңгіме бұрын соңды болмаған.
Dialogue: 0,0:13:11.16,0:13:12.37,Default,,0,0,0,,(Мектеп директорының жөтелі)
Dialogue: 0,0:13:15.04,0:13:16.00,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:13:16.96,0:13:21.05,Default,,0,0,0,,Өздеріңіз білетіндей, мектебіміз жаңа оқу жылынан басталады.
Dialogue: 0,0:13:21.13,0:13:26.34,Default,,0,0,0,,Біз жыртқыштар мен шөпқоректілерге бөлек зерттеу жүргізуді ұйғардық.
Dialogue: 0,0:13:27.97,0:13:30.18,Default,,0,0,0,,Өткен жылы болған қайғылы оқиға болды
Dialogue: 0,0:13:30.26,0:13:33.22,Default,,0,0,0,,Ешқашан қайталанбау керек
Dialogue: 0,0:13:34.10,0:13:37.06,Default,,0,0,0,,Кейде түсініксіз болуы мүмкін, бірақ
Dialogue: 0,0:13:37.14,0:13:38.40,Default,,0,0,0,,Болашақта барлығыңызға...
Dialogue: 0,0:13:38.48,0:13:40.77,Default,,0,0,0,,Сыныптағы иіс жақсара ма?
Dialogue: 0,0:13:40.86,0:13:43.15,Default,,0,0,0,,Көз жоғалады.
Dialogue: 0,0:13:43.23,0:13:44.32,Default,,0,0,0,,Мен мұны айта аламын
Dialogue: 0,0:13:43.23,0:13:44.32,Default,,0,0,0,,Дәлізде секірудің қажеті жоқ.
Dialogue: 0,0:13:44.32,0:13:45.28,Default,,0,0,0,,Дәлізде секірудің қажеті жоқ.
Dialogue: 0,0:13:45.32,0:13:47.70,Default,,0,0,0,,Шынымды айтсам, бөлек оқу қауіпсіз емес пе?
Dialogue: 0,0:13:47.78,0:13:49.91,Default,,0,0,0,,Біз де қарапайымбыз ғой, солай емес пе?
Dialogue: 0,0:13:47.78,0:13:49.91,Default,,0,0,0,,Ештеңеге алаңдамайсыз, солай ма?
Dialogue: 0,0:13:49.91,0:13:50.37,Default,,0,0,0,,Ештеңеге алаңдамайсыз, солай ма?
Dialogue: 0,0:13:50.45,0:13:51.74,Default,,0,0,0,,Әрине
Dialogue: 0,0:13:52.24,0:13:56.58,Default,,0,0,0,,Соңында биылғы арнайы сынып оқушыларын жариялаймыз.
Dialogue: 0,0:13:57.16,0:13:58.67,Default,,0,0,0,,Бұл бәрібір азу.
Dialogue: 0,0:13:58.75,0:14:01.50,Default,,0,0,0,,Егер сіздің атыңыз шақырылса, тұрыңыз.
Dialogue: 0,0:14:02.34,0:14:03.92,Default,,0,0,0,,А класы Рэнд-кун
Dialogue: 0,0:14:05.88,0:14:07.80,Default,,0,0,0,,С сыныбы Дэнни
Dialogue: 0,0:14:09.51,0:14:11.47,Default,,0,0,0,,E класс Джек
Dialogue: 0,0:14:13.14,0:14:15.02,Default,,0,0,0,,F класы Лэнс-кун
Dialogue: 0,0:14:16.02,0:14:17.89,Default,,0,0,0,,G класы Мик
Dialogue: 0,0:14:18.89,0:14:20.81,Default,,0,0,0,,Бұл жоғарыда аталған бес жануар.
Dialogue: 0,0:14:21.77,0:14:22.94,Default,,0,0,0,,(Крекер дыбысы)
Dialogue: 0,0:14:23.02,0:14:25.69,Default,,0,0,0,,Congratulations Jack!
Dialogue: 0,0:14:25.78,0:14:26.99,Default,,0,0,0,,Жоқ, рахмет
Dialogue: 0,0:14:27.07,0:14:29.95,Default,,0,0,0,,Элиталық курс шешілді.
Dialogue: 0,0:14:30.03,0:14:32.99,Default,,0,0,0,,Легоши Шиппо осындай нәрсені жасауға қуанышты болар еді
Dialogue: 0,0:14:33.08,0:14:35.12,Default,,0,0,0,,(5 күлкі)
Dialogue: 0,0:14:35.20,0:14:38.33,Default,,0,0,0,,О, кешіріңіз.
Dialogue: 0,0:14:42.59,0:14:43.29,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:14:43.38,0:14:45.34,Default,,0,0,0,,О, Джек.
Dialogue: 0,0:14:45.42,0:14:47.88,Default,,0,0,0,,Легоси қайда екенін білмейсіз бе?
Dialogue: 0,0:14:47.97,0:14:48.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:49.01,0:14:51.59,Default,,0,0,0,,Иә! Сіз Легосидің атасысыз ба?
Dialogue: 0,0:14:51.68,0:14:53.39,Default,,0,0,0,,Аа, көп уақыт болды.
Dialogue: 0,0:14:51.68,0:14:53.39,Default,,0,0,0,,Легошидің атасы?
Dialogue: 0,0:14:53.39,0:14:53.47,Default,,0,0,0,,Легошидің атасы?
Dialogue: 0,0:14:53.47,0:14:54.22,Default,,0,0,0,,Легошидің атасы?
Dialogue: 0,0:14:53.47,0:14:54.22,Default,,0,0,0,,Легосидің мектептен шығарылғаны рас па?
Dialogue: 0,0:14:54.22,0:14:56.72,Default,,0,0,0,,Легосидің мектептен шығарылғаны рас па?
Dialogue: 0,0:14:56.81,0:14:59.06,Default,,0,0,0,,Менің оқу ақысы қайтарылды.
Dialogue: 0,0:14:59.14,0:15:03.11,Default,,0,0,0,,Телефон да жұмыс істемейді. Сіз бірдеңе білесіз бе?
Dialogue: 0,0:15:03.19,0:15:05.27,Default,,0,0,0,,Мен телефонмен келісім-шартты тоқтаттым.
Dialogue: 0,0:15:05.36,0:15:08.24,Default,,0,0,0,,Мен сізді оқудан шығару туралы біледі деп ойладым.
Dialogue: 0,0:15:10.24,0:15:12.70,Default,,0,0,0,,Ренжіткенім үшін кешіріңіз, мен уайымдадым.
Dialogue: 0,0:15:12.78,0:15:15.37,Default,,0,0,0,,Ата, сенімді болыңыз.
Dialogue: 0,0:15:15.45,0:15:17.08,Default,,0,0,0,,Легоси болса, уайымдамаңыз
Dialogue: 0,0:15:17.16,0:15:18.00,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:15:18.08,0:15:19.66,Default,,0,0,0,,Мен кенеттен мектептен шығып қалдым.
Dialogue: 0,0:15:19.75,0:15:23.29,Default,,0,0,0,,Менің ойымша, оның өзіндік ойлау тәсілі болған шығар.
Dialogue: 0,0:15:23.38,0:15:26.00,Default,,0,0,0,,Өйткені Легосидің өзегі бар.
Dialogue: 0,0:15:26.09,0:15:28.05,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:15:28.13,0:15:31.01,Default,,0,0,0,,Ол менің жалғыз асыл немерем.
Dialogue: 0,0:15:39.85,0:15:41.64,Default,,0,0,0,,Әй, Халлу!
Dialogue: 0,0:15:41.73,0:15:42.90,Default,,0,0,0,,А, міне, міне!
Dialogue: 0,0:15:42.98,0:15:47.52,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз. Жаңа студенттерге арналған бағдарлау сессиясы ұзаққа созылды.
Dialogue: 0,0:15:48.69,0:15:51.65,Default,,0,0,0,,Қуаныштымын, осында келгім келді~
Dialogue: 0,0:15:51.74,0:15:53.49,Default,,0,0,0,,Бұл кафе латте өте дәмді.
Dialogue: 0,0:15:53.57,0:15:54.66,Default,,0,0,0,,Дәл солай жасалған
Dialogue: 0,0:15:54.74,0:15:56.78,Default,,0,0,0,,-Шынымен бе? -Е, келесі жолы солай істейік.
Dialogue: 0,0:15:56.87,0:15:58.62,Default,,0,0,0,,Эй, айтпақшы, курсыңа не болды?
Dialogue: 0,0:15:58.70,0:16:00.16,Default,,0,0,0,,Ей, бәрі жақсы.
Dialogue: 0,0:16:00.25,0:16:03.54,Default,,0,0,0,,Университеттің 1 курсы, жақсы бастама
Dialogue: 0,0:16:03.62,0:16:07.29,Default,,0,0,0,,Мен кампустың жарқыраған өмірін өткізуді шештім.
Dialogue: 0,0:16:07.38,0:16:10.80,Default,,0,0,0,,Менімен қоштас, мектептегі қорқытылған бала.
Dialogue: 0,0:16:10.88,0:16:13.13,Default,,0,0,0,,Іс жүзінде...
Dialogue: 0,0:16:13.22,0:16:16.05,Default,,0,0,0,,Мен жігітімді екеуіңмен таныстырғым келеді.
Dialogue: 0,0:16:16.14,0:16:17.43,Default,,0,0,0,,Эх!
Dialogue: 0,0:16:17.51,0:16:19.52,Default,,0,0,0,,Ако-чан, сенің жігітің бар ма?
Dialogue: 0,0:16:19.60,0:16:21.93,Default,,0,0,0,,Жоқ, Хару-чан, сен білесің бе?
Dialogue: 0,0:16:22.02,0:16:23.56,Default,,0,0,0,,Не? О, жоқ...
Dialogue: 0,0:16:23.64,0:16:24.81,Default,,0,0,0,,Қандай бала?
Dialogue: 0,0:16:24.90,0:16:27.27,Default,,0,0,0,,А, міне, міне!
Dialogue: 0,0:16:33.24,0:16:36.16,Default,,0,0,0,,Эй, Эйрд дейік.
Dialogue: 0,0:16:36.24,0:16:38.20,Default,,0,0,0,,Бұл менің жігітім
Dialogue: 0,0:16:40.87,0:16:41.87,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:16:42.45,0:16:44.96,Default,,0,0,0,,Ақыр аяғында бұл сондай сезім.
Dialogue: 0,0:16:45.04,0:16:46.33,Default,,0,0,0,,Сіз таң қаласыз.
Dialogue: 0,0:16:46.42,0:16:50.46,Default,,0,0,0,,Мен Акомен кездескенде оның реакциясы сергітеді.
Dialogue: 0,0:16:50.55,0:16:52.34,Default,,0,0,0,,Сасық емес пе?
Dialogue: 0,0:16:52.97,0:16:54.72,Default,,0,0,0,,Жыртқыш аңның иісі бар.
Dialogue: 0,0:16:55.68,0:16:57.89,Default,,0,0,0,,Тәбетіңіз жоғалады.
Dialogue: 0,0:16:58.76,0:17:02.02,Default,,0,0,0,,Біздің дәуірде әр түрлі жігіттер жоқ.
Dialogue: 0,0:17:02.10,0:17:04.27,Default,,0,0,0,,Бұл ешқашан болуы мүмкін емес еді.
Dialogue: 0,0:17:04.35,0:17:07.19,Default,,0,0,0,,Басқа нәсілге ғашық болу – ауру, солай ма?
Dialogue: 0,0:17:07.86,0:17:11.69,Default,,0,0,0,,Өзіңіздің адамдарыңыздың бәрі қауіпсіз екенін сіз зардап шеккеннен кейін ғана түсінесіз.
Dialogue: 0,0:17:12.74,0:17:14.57,Default,,0,0,0,,Әй, біз неге орынды өзгертпейміз?
Dialogue: 0,0:17:15.40,0:17:16.53,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:17.57,0:17:20.20,Default,,0,0,0,,Әй, бұл өте қызықты болды!
Dialogue: 0,0:17:20.78,0:17:22.20,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:17:23.08,0:17:25.00,Default,,0,0,0,,- (1-қой) Қайда бара жатырсың? -(2-қой) Иә...
Dialogue: 0,0:17:26.25,0:17:27.88,Default,,0,0,0,,Эй, Легоши-кун
Dialogue: 0,0:17:28.63,0:17:32.76,Default,,0,0,0,,Ересектер қоғамы мен ойлағаннан да қорқынышты болып көрінеді.
Dialogue: 0,0:17:35.05,0:17:37.05,Default,,0,0,0,,♪～
Dialogue: 0,0:18:00.16,0:18:02.16,Default,,0,0,0,,～♪
Dialogue: 0,0:18:06.04,0:18:08.54,Default,,0,0,0,,Жастар білмейтін шығар.
Dialogue: 0,0:18:09.37,0:18:13.71,Default,,0,0,0,,Ол кезде әр түрлі оқиғалармен қызу болатын.
Dialogue: 0,0:18:14.63,0:18:17.51,Default,,0,0,0,,Мен оны әлі де анық көріп тұрмын
Dialogue: 0,0:18:18.38,0:18:22.10,Default,,0,0,0,,Бастапқыда бұл күн асыл етті тойлау күні болған.
Dialogue: 0,0:18:22.76,0:18:26.18,Default,,0,0,0,,Сондықтан «Махаббат ет күні» деп аталады.
Dialogue: 0,0:18:27.06,0:18:31.11,Default,,0,0,0,,Енді артқы нарықта шымтезек соғысының уақыты келді.
Dialogue: 0,0:18:34.48,0:18:37.32,Default,,0,0,0,,Комодо айдаһарларының Доку тобы
Dialogue: 0,0:18:37.40,0:18:39.24,Default,,0,0,0,,Жарайды, мен көптен күттім!
Dialogue: 0,0:18:39.32,0:18:41.57,Default,,0,0,0,,Қызыл түлкілердің Инари тобы
Dialogue: 0,0:18:42.37,0:18:44.62,Default,,0,0,0,,Барыстардың Мадара тобы
Dialogue: 0,0:18:45.24,0:18:47.45,Default,,0,0,0,,Шишигуми арыстаны
Dialogue: 0,0:18:49.71,0:18:53.92,Default,,0,0,0,,Бұл топ өткен жылға дейін жақсы жұмыс істеп келді.
Dialogue: 0,0:18:54.50,0:18:56.42,Default,,0,0,0,,Енді бас тартудың уақыты келді.
Dialogue: 0,0:18:57.55,0:19:01.64,Default,,0,0,0,,Бастықсыз «топ» деп айта алмайсың.
Dialogue: 0,0:19:02.47,0:19:05.89,Default,,0,0,0,,Келіңіздер, Махаббат еті күні арзандатайық.
Dialogue: 0,0:19:06.52,0:19:09.23,Default,,0,0,0,,Мүмкін болса, бір-бірден тістеп алғым келеді.
Dialogue: 0,0:19:09.89,0:19:11.40,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:19:11.48,0:19:13.94,Default,,0,0,0,,Сіз жыртқышсыз...
Dialogue: 0,0:19:14.90,0:19:16.73,Default,,0,0,0,,Гуааах
Dialogue: 0,0:19:33.63,0:19:39.01,Default,,0,0,0,,(Легошидің ырылдауы)
Dialogue: 0,0:19:39.09,0:19:43.93,Default,,0,0,0,,(Легосидің жабайы жүгіру дыбысы)
Dialogue: 0,0:19:44.43,0:19:45.26,Default,,0,0,0,,(бөтелкенің құлаған дыбысы)
Dialogue: 0,0:19:45.35,0:19:47.56,Default,,0,0,0,,(Легошидің ырылдауы)
Dialogue: 0,0:19:47.64,0:19:51.39,Default,,0,0,0,,Сіз өз шегіңізге жеттіңіз! Мен бүгін арыз жазамын.
Dialogue: 0,0:19:52.31,0:19:59.15,Default,,0,0,0,,(Легошидің ауыр тыныс алуы)
Dialogue: 0,0:20:02.24,0:20:03.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:04.20,0:20:05.32,Default,,0,0,0,,Сақ болмаңыз.
Dialogue: 0,0:20:12.21,0:20:14.96,Default,,0,0,0,,(Легоси тынысы)
Dialogue: 0,0:20:17.17,0:20:18.38,Default,,0,0,0,,Ум...
Dialogue: 0,0:20:20.63,0:20:23.05,Default,,0,0,0,,Жарайды... Уау
Dialogue: 0,0:20:23.13,0:20:26.09,Default,,0,0,0,,(Легошидің ырылдауы)
Dialogue: 0,0:20:27.43,0:20:31.02,Default,,0,0,0,,(Легошидің ауыр тыныс алуы)
Dialogue: 0,0:20:34.98,0:20:36.31,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:20:36.40,0:20:38.86,Default,,0,0,0,,Сәл күтсеңіз жақсы.
Dialogue: 0,0:20:38.94,0:20:41.36,Default,,0,0,0,,Шикізатты дайындамасаңыз —
Dialogue: 0,0:20:41.44,0:20:43.74,Default,,0,0,0,,Мен сізге дәрі бере алмаймын.
Dialogue: 0,0:20:43.82,0:20:46.32,Default,,0,0,0,,Маған көп нәрсе лақтырылды.
Dialogue: 0,0:20:46.41,0:20:47.32,Default,,0,0,0,,Мұндай жағдайлар бола ма?
Dialogue: 0,0:20:47.91,0:20:50.66,Default,,0,0,0,,Әдемі бастығыңды жеумен айналыстың ба?
Dialogue: 0,0:20:50.74,0:20:51.95,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:52.04,0:20:54.41,Default,,0,0,0,,Бұл жерде қате жоқ.
Dialogue: 0,0:20:55.46,0:20:58.59,Default,,0,0,0,,Шикізатты күшті дәрілік заттарға саудалай алатын топтар
Dialogue: 0,0:20:58.67,0:21:01.00,Default,,0,0,0,,Сіз жалғыз емессіз.
Dialogue: 0,0:21:01.09,0:21:03.92,Default,,0,0,0,,Мен келесі аптада бірдеңе істеймін.
Dialogue: 0,0:21:04.01,0:21:05.72,Default,,0,0,0,,Бұл сенімсіз.
Dialogue: 0,0:21:06.72,0:21:10.35,Default,,0,0,0,,Мен піл сүйегінің бір бөлігін де ала алмайтын сияқтымын.
Dialogue: 0,0:21:10.43,0:21:12.06,Default,,0,0,0,,Бұдан былай...
Dialogue: 0,0:21:13.27,0:21:14.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:14.23,0:21:17.02,Default,,0,0,0,,Мен сені күтуге мәжбүр еттім. Бұл жақсы ма?
Dialogue: 0,0:21:21.32,0:21:22.61,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:21:22.69,0:21:27.82,Default,,0,0,0,,Дүниедегі Шиши-гумиден күткендей сапалы піл сүйегі.
Dialogue: 0,0:21:28.57,0:21:30.41,Default,,0,0,0,,Эй, бұл кім?
Dialogue: 0,0:21:30.49,0:21:31.45,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:21:32.04,0:21:34.71,Default,,0,0,0,,Сіз мұнымен дәрі жасай алуыңыз керек.
Dialogue: 0,0:21:34.79,0:21:36.96,Default,,0,0,0,,Оны белгіленген мерзімге дейін дайындаңыз
Dialogue: 0,0:21:37.04,0:21:38.88,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:21:38.96,0:21:42.34,Default,,0,0,0,,Бұл мерзімін өткізіп жіберген адам.
Dialogue: 0,0:21:49.30,0:21:50.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:51.30,0:21:52.35,Default,,0,0,0,,А... а...
Dialogue: 0,0:21:55.23,0:21:57.60,Default,,0,0,0,,Мені қалдыршы, не істеп жатырсың...
Dialogue: 0,0:21:58.23,0:21:58.85,Default,,0,0,0,,Уф
Dialogue: 0,0:22:00.02,0:22:02.94,Default,,0,0,0,,«Теме» деме, ақымақ мысық!
Dialogue: 0,0:22:04.19,0:22:05.36,Default,,0,0,0,,«Бастық»
Dialogue: 0,0:22:06.11,0:22:07.61,Default,,0,0,0,,Мені «Бастық» деп атаңыз
Dialogue: 0,0:22:11.99,0:22:13.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.54,0:23:41.54,Default,,0,0,0,,～♪
