Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.01,0:00:14.01,Default,,0,0,0,,♪～
Dialogue: 0,0:01:38.13,0:01:40.14,Default,,0,0,0,,～♪
Dialogue: 0,0:01:47.02,0:01:51.40,Default,,0,0,0,,(Легошидің ырылдауы)
Dialogue: 0,0:01:56.11,0:02:01.03,Default,,0,0,0,,(Легошидің ырылдауы)
Dialogue: 0,0:02:12.46,0:02:14.13,Default,,0,0,0,,Жоқ, олар шын мәнінде тамақтанбай-ақ қоятындай деңгейге дейін дамыды, бірақ…
Dialogue: 0,0:02:14.21,0:02:16.55,Default,,0,0,0,,Біреу... Мен біреуге қоңырау шалуым керек.
Dialogue: 0,0:02:26.35,0:02:29.39,Default,,0,0,0,,Сабыр ет... Сабыр ет, мен.
Dialogue: 0,0:02:30.10,0:02:31.94,Default,,0,0,0,,Легоши жеңіз
Dialogue: 0,0:02:32.02,0:02:34.19,Default,,0,0,0,,Тірі шөпқоректілердің еті
Dialogue: 0,0:02:35.69,0:02:37.03,Default,,0,0,0,,Мені жынды қыл
Dialogue: 0,0:02:37.90,0:02:42.70,Default,,0,0,0,,Ааа
Dialogue: 0,0:02:47.12,0:02:48.12,Default,,0,0,0,,-Ааа -ха
Dialogue: 0,0:02:48.20,0:02:50.04,Default,,0,0,0,,(Легошидің ауыр тыныс алуы)
Dialogue: 0,0:02:56.05,0:02:57.42,Default,,0,0,0,,Жеті мырза...
Dialogue: 0,0:02:58.01,0:02:58.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:01.51,0:03:04.93,Default,,0,0,0,,(Легошидің ауыр тыныс алуы)
Dialogue: 0,0:03:06.31,0:03:08.10,Default,,0,0,0,,Не болды, қарт әже?
Dialogue: 0,0:03:08.68,0:03:10.56,Default,,0,0,0,,Бұл Жеті мырза болды, солай ма?
Dialogue: 0,0:03:12.23,0:03:13.40,Default,,0,0,0,,Иә
Dialogue: 0,0:03:14.48,0:03:15.86,Default,,0,0,0,,Бұл бөлме…
Dialogue: 0,0:03:17.32,0:03:20.86,Default,,0,0,0,,Электр жарығы жоқ, не істеуім керек?
Dialogue: 0,0:03:21.61,0:03:24.74,Default,,0,0,0,,Сондықтан... электрмен жабдықтау компаниясына қоңырау шалыңыз—
Dialogue: 0,0:03:24.82,0:03:26.91,Default,,0,0,0,,Маған мекен-жайыңызды айтыңыз.
Dialogue: 0,0:03:26.99,0:03:28.66,Default,,0,0,0,,Электр компаниясы…?
Dialogue: 0,0:03:28.75,0:03:29.83,Default,,0,0,0,,Иә
Dialogue: 0,0:03:29.91,0:03:32.42,Default,,0,0,0,,Қуатты қашықтан басқару пульті арқылы қосуға болады.
Dialogue: 0,0:03:38.67,0:03:40.84,Default,,0,0,0,,Сізде ұялы телефон бар ма?
Dialogue: 0,0:03:41.47,0:03:44.18,Default,,0,0,0,,Егер сіз оны Zuzzle арқылы іздесеңіз, сан шығады.
Dialogue: 0,0:03:45.26,0:03:46.64,Default,,0,0,0,,Сукуна мен қондырғы — табиғи жаулар, түсінесің бе.
Dialogue: 0,0:03:47.56,0:03:50.48,Default,,0,0,0,,Мен орта мектепті бітірген кезде келісім-шарттан бас тарттым.
Dialogue: 0,0:03:51.43,0:03:52.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:54.69,0:04:00.03,Default,,0,0,0,,«Дүниежүзілік тарих» «Теңіз тілі» «Жоғары мектеп бітіру туралы аттестаттау»
Dialogue: 0,0:04:00.74,0:04:02.61,Default,,0,0,0,,Сіз әлі жасөспірімсіз бе?
Dialogue: 0,0:04:02.70,0:04:05.62,Default,,0,0,0,,Ах… 17.
Dialogue: 0,0:04:05.70,0:04:08.41,Default,,0,0,0,,Қазір мен удон мейрамханасында жұмыс істеймін.
Dialogue: 0,0:04:08.95,0:04:09.83,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:15.92,0:04:18.71,Default,,0,0,0,,17 аяқ киім жасасаңыз, түсінікті емес пе?
Dialogue: 0,0:04:19.34,0:04:23.76,Default,,0,0,0,,Ірі жыртқыштар үшін көптеген нұсқалар жоқ.
Dialogue: 0,0:04:23.84,0:04:26.26,Default,,0,0,0,,Иә, бұл дұрыс болуы мүмкін.
Dialogue: 0,0:04:27.43,0:04:29.93,Default,,0,0,0,,Мен сол өндірушіде жұмыс істеймін.
Dialogue: 0,0:04:30.47,0:04:32.56,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:04:33.60,0:04:35.27,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:04:35.35,0:04:39.32,Default,,0,0,0,,Аа, менде осындай әңгіме болған сияқты.
Dialogue: 0,0:04:39.82,0:04:41.65,Default,,0,0,0,,Тәбеті басылады
Dialogue: 0,0:04:42.36,0:04:43.90,Default,,0,0,0,,Сукуна мен қондырғы — табиғи жаулар, түсінесің бе.
Dialogue: 0,0:04:44.78,0:04:46.99,Default,,0,0,0,,Менің атым Легоши.
Dialogue: 0,0:04:47.07,0:04:49.12,Default,,0,0,0,,Кеш сәлемдескенім үшін кешіріңіз...
Dialogue: 0,0:04:49.12,0:04:50.66,Default,,0,0,0,,Сәлем беруге кешігіп қалғаным үшін кешіріңіз.
Dialogue: 0,0:04:49.12,0:04:50.66,Default,,0,0,0,,Үлкен жара
Dialogue: 0,0:04:50.66,0:04:51.37,Default,,0,0,0,,Кеш сәлемдескенім үшін кешіріңіз...
Dialogue: 0,0:04:51.45,0:04:53.12,Default,,0,0,0,,- Уа уа ва! -сурет?
Dialogue: 0,0:04:54.50,0:04:56.37,Default,,0,0,0,,О, о... маған тиіспе
Dialogue: 0,0:04:56.46,0:04:57.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:57.92,0:04:59.25,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:00.75,0:05:01.92,Default,,0,0,0,,Хааа~
Dialogue: 0,0:05:03.26,0:05:06.55,Default,,0,0,0,,Мен сіздің энергетикалық компанияңыздың нөмірін іздеймін.
Dialogue: 0,0:05:11.51,0:05:12.97,Default,,0,0,0,,Сукуна мен қондырғы — табиғи жаулар, түсінесің бе.
Dialogue: 0,0:05:14.18,0:05:17.10,Default,,0,0,0,,Мен үшін мұны сұрау біртүрлі.
Dialogue: 0,0:05:18.48,0:05:22.48,Default,,0,0,0,,Неге қашудың орнына осында қаласың?
Dialogue: 0,0:05:23.23,0:05:24.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:26.57,0:05:27.70,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:29.95,0:05:34.37,Default,,0,0,0,,Бір жыртқыштың мені дұрыс атыммен атағанына біраз болды.
Dialogue: 0,0:05:34.45,0:05:35.66,Default,,0,0,0,,Мен жай ғана бақытты болдым
Dialogue: 0,0:05:48.55,0:05:50.72,Default,,0,0,0,,Соны ішсең, бір оқта сіңіп кетесің.
Dialogue: 0,0:05:50.80,0:05:53.77,Default,,0,0,0,,Әлгі аға оның саусағын жегенін айтты.
Dialogue: 0,0:05:53.85,0:05:54.81,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:05:54.89,0:05:56.93,Default,,0,0,0,,О, бұл да жаңалықтарда болды.
Dialogue: 0,0:05:57.02,0:06:00.10,Default,,0,0,0,,Хехе, бұл зат шынымен де ұша алады!
Dialogue: 0,0:06:00.19,0:06:02.48,Default,,0,0,0,,Осыншама көп ішу дұрыс па?
Dialogue: 0,0:06:02.57,0:06:04.48,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:06:05.15,0:06:06.11,Default,,0,0,0,,Хой
Dialogue: 0,0:06:06.19,0:06:06.86,Default,,0,0,0,,О...
Dialogue: 0,0:06:08.86,0:06:11.20,Default,,0,0,0,,(ішемін деп кейіп көрсету)
Dialogue: 0,0:06:11.95,0:06:13.45,Default,,0,0,0,,Ол бос емес пе?
Dialogue: 0,0:06:13.53,0:06:15.29,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:06:15.37,0:06:16.25,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,0:06:16.87,0:06:19.17,Default,,0,0,0,,Сен, бейбақ.
Dialogue: 0,0:06:23.04,0:06:24.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:25.09,0:06:27.67,Default,,0,0,0,,А, мынау.
Dialogue: 0,0:06:27.76,0:06:30.59,Default,,0,0,0,,Сіздің алдыңызда кешіріңіз.
Dialogue: 0,0:06:31.72,0:06:33.01,Default,,0,0,0,,Мен оны лақтырамын
Dialogue: 0,0:06:33.97,0:06:35.89,Default,,0,0,0,,Ой, жарайды, жарайды.
Dialogue: 0,0:06:35.97,0:06:40.40,Default,,0,0,0,,Саған жамандық жасасақ, бірден университеттен шығарылады.
Dialogue: 0,0:06:40.48,0:06:42.15,Default,,0,0,0,,Егер Мүйіз конгломерат сізге қарап тұрса
Dialogue: 0,0:06:42.23,0:06:44.77,Default,,0,0,0,,Сіз үздік компанияда жұмысқа орналаса алмайсыз.
Dialogue: 0,0:06:45.57,0:06:46.98,Default,,0,0,0,,Маған беріңіз
Dialogue: 0,0:06:49.57,0:06:50.86,Default,,0,0,0,,Оны маған беріңіз
Dialogue: 0,0:06:52.57,0:06:53.74,Default,,0,0,0,,Ет ауруы?
Dialogue: 0,0:06:53.83,0:06:54.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:55.33,0:06:57.83,Default,,0,0,0,,Бұл еттен бас тарту белгілері.
Dialogue: 0,0:06:59.50,0:07:00.87,Default,,0,0,0,,Осыған байланысты ма?
Dialogue: 0,0:07:00.96,0:07:02.71,Default,,0,0,0,,Тек оны қайтарыңыз!
Dialogue: 0,0:07:03.67,0:07:04.21,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:04.29,0:07:07.76,Default,,0,0,0,,Етқоректілердің көпшілігі оларға бұлай істегенде ашуланады.
Dialogue: 0,0:07:07.84,0:07:08.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:09.67,0:07:11.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:11.97,0:07:15.51,Default,,0,0,0,,Мұны маған Шиши-гумидің жігіттері үйретті.
Dialogue: 0,0:07:16.06,0:07:17.22,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:07:17.31,0:07:20.35,Default,,0,0,0,,Арыстанның күші – қару ғана.
Dialogue: 0,0:07:20.85,0:07:22.98,Default,,0,0,0,,Оны қате қолданбаңыз
Dialogue: 0,0:07:24.69,0:07:27.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:30.65,0:07:31.86,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:07:32.91,0:07:34.45,Default,,0,0,0,,Бұл әдемі, солай емес пе?
Dialogue: 0,0:07:35.37,0:07:37.54,Default,,0,0,0,,Енді ауырмай ма?
Dialogue: 0,0:07:38.08,0:07:40.46,Default,,0,0,0,,Мен ойлағандай ыңғайсыздық сезінбеймін.
Dialogue: 0,0:07:42.29,0:07:44.67,Default,,0,0,0,,Маған неге көрсетіп жатырсың?
Dialogue: 0,0:07:46.50,0:07:50.47,Default,,0,0,0,,Менің артқы нарықта болғанымды жалғыз сен ғана білесің.
Dialogue: 0,0:07:50.55,0:07:52.72,Default,,0,0,0,,Менің ойымша, бұл байланыс.
Dialogue: 0,0:07:53.93,0:07:56.14,Default,,0,0,0,,Сіз біреудің білгенін қалайсыз, солай ма?
Dialogue: 0,0:07:56.22,0:07:56.76,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:56.85,0:07:58.97,Default,,0,0,0,,Сіз уайымдап жүрсіз бе?
Dialogue: 0,0:07:59.06,0:08:01.23,Default,,0,0,0,,Жоқ... жоқ.
Dialogue: 0,0:08:01.77,0:08:04.69,Default,,0,0,0,,Бұғылар жылына бір рет мүйіз өсіреді.
Dialogue: 0,0:08:04.77,0:08:08.61,Default,,0,0,0,,Сондықтан да мен денемді жоғалтып алсам да, шу шығармаймын және ештеңеден қорықпаймын.
Dialogue: 0,0:08:08.69,0:08:09.90,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:08:35.64,0:08:36.72,Default,,0,0,0,,Ум...
Dialogue: 0,0:08:37.30,0:08:40.14,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:08:41.18,0:08:45.52,Default,,0,0,0,,Кешіріңіз, мен... мен жай ғана...
Dialogue: 0,0:08:45.60,0:08:47.65,Default,,0,0,0,,-Ой, жарайды, мен де ұмытамын. -А?
Dialogue: 0,0:08:47.73,0:08:50.36,Default,,0,0,0,,Жоқ... жоқ, ұмыту дегенді қалай түсінесіңдер?
Dialogue: 0,0:08:50.44,0:08:51.86,Default,,0,0,0,,Бұл менің алғашқы сүйісім!
Dialogue: 0,0:08:51.94,0:08:52.82,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:08:53.61,0:08:56.57,Default,,0,0,0,,Сіз тіпті жараланған шөпқоректілерге де жанашыр болғыңыз келеді.
Dialogue: 0,0:08:56.66,0:08:58.32,Default,,0,0,0,,Сен мені сүйдің
Dialogue: 0,0:08:58.41,0:09:00.12,Default,,0,0,0,,Бұл әңгіме аяқталды.
Dialogue: 0,0:09:01.66,0:09:03.54,Default,,0,0,0,,Неліктен бұлай...
Dialogue: 0,0:09:04.71,0:09:06.75,Default,,0,0,0,,Мен ауырдым
Dialogue: 0,0:09:07.38,0:09:10.42,Default,,0,0,0,,Ал, мен сендерден үйірме жұмыстары туралы сұрадым.
Dialogue: 0,0:09:18.59,0:09:20.51,Default,,0,0,0,,Ешқандай жамандық болмайды.
Dialogue: 0,0:09:20.60,0:09:22.64,Default,,0,0,0,,Түр аралық махаббат оянғанда
Dialogue: 0,0:09:24.27,0:09:26.10,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:28.02,0:09:31.07,Default,,0,0,0,,Мен жыртқыштармен байланысымды үзуім керек еді.
Dialogue: 0,0:09:31.15,0:09:33.40,Default,,0,0,0,,Мені әлі де мазалап жүр
Dialogue: 0,0:09:33.48,0:09:34.24,Default,,0,0,0,,Әдетте, сақ болу үшін, су астында олардың бірнешеуін күзетте ұстауымыз керек еді.
Dialogue: 0,0:09:36.95,0:09:38.24,Default,,0,0,0,,(шығарып жатқан дыбыс)
Dialogue: 0,0:09:39.82,0:09:41.87,Default,,0,0,0,,(құты қақпағының ашылған дыбысы)
Dialogue: 0,0:09:50.67,0:09:52.09,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:09:53.59,0:09:56.34,Default,,0,0,0,,Хехе...
Dialogue: 0,0:09:58.51,0:10:02.51,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:10:05.60,0:10:08.31,Default,,0,0,0,,Ах~ Хэхе~
Dialogue: 0,0:10:11.15,0:10:13.40,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:10:16.24,0:10:17.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:18.78,0:10:21.37,Default,,0,0,0,,Ки-ии
Dialogue: 0,0:10:26.04,0:10:30.29,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:10:31.04,0:10:37.63,Default,,0,0,0,,Мен бұған ешқашан жол бермеймін, иә?
Dialogue: 0,0:10:43.89,0:10:46.77,Default,,0,0,0,,Сіз 30 минуттан астам күттіңіз.
Dialogue: 0,0:10:46.85,0:10:50.10,Default,,0,0,0,,Ол Шиши-гумиді қайта тұрғызғалы жатқанын айтты...
Dialogue: 0,0:10:57.99,0:10:59.07,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:00.36,0:11:02.87,Default,,0,0,0,,Иә? бұршақ пастасы?
Dialogue: 0,0:11:07.58,0:11:10.16,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:11:12.67,0:11:13.46,Default,,0,0,0,,Джинма?
Dialogue: 0,0:11:15.71,0:11:20.42,Default,,0,0,0,,(Джинманың ауыр тыныс алуы)
Dialogue: 0,0:11:23.43,0:11:24.51,Default,,0,0,0,,Урия
Dialogue: 0,0:11:26.06,0:11:27.06,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:11:36.52,0:11:39.03,Default,,0,0,0,,Тоқта, тыныштал, Джинма.
Dialogue: 0,0:11:40.49,0:11:41.86,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:44.74,0:11:47.79,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:47.87,0:11:49.54,Default,,0,0,0,,Оның нұсқаулары?
Dialogue: 0,0:11:50.12,0:11:52.04,Default,,0,0,0,,Уф... Мен білмеймін.
Dialogue: 0,0:11:52.12,0:11:53.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:53.62,0:12:00.34,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:01.38,0:12:02.72,Default,,0,0,0,,Бастық?
Dialogue: 0,0:12:02.80,0:12:06.47,Default,,0,0,0,,Егер дилер яки жасаса, бітті.
Dialogue: 0,0:12:06.55,0:12:10.56,Default,,0,0,0,,ше? Як және дилер дегенді қалай түсінесіз?
Dialogue: 0,0:12:12.56,0:12:15.69,Default,,0,0,0,,Бұл жай ғана энергетикалық сусын емес пе?
Dialogue: 0,0:12:15.77,0:12:18.15,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:18.23,0:12:19.78,Default,,0,0,0,,«Кинус» бар
Dialogue: 0,0:12:19.86,0:12:24.28,Default,,0,0,0,,Шөпқоректілердің сүйектері мен етінің аз мөлшері араласады.
Dialogue: 0,0:12:24.36,0:12:26.16,Default,,0,0,0,,Ішімдік сізге сергектік береді.
Dialogue: 0,0:12:26.24,0:12:29.70,Default,,0,0,0,,Тіпті ет жеуге деген құштарлығымды да қанағаттандырады.
Dialogue: 0,0:12:30.66,0:12:36.04,Default,,0,0,0,,Бірақ мен неғұрлым көп ішсем, соғұрлым өзімді қанағатсыз сезінемін және—
Dialogue: 0,0:12:36.83,0:12:41.13,Default,,0,0,0,,Артқы базарға нағыз ет іздеп келу
Dialogue: 0,0:12:41.71,0:12:45.43,Default,,0,0,0,,Шиши-гуми арқасында жер асты базары өркендеп келеді.
Dialogue: 0,0:12:47.05,0:12:48.18,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:12:48.85,0:12:52.14,Default,,0,0,0,,Егер ет жеу тәжірибесі бар адам...
Dialogue: 0,0:12:55.10,0:12:57.86,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:13:03.36,0:13:05.49,Default,,0,0,0,,Орынға апарыңыз
Dialogue: 0,0:13:05.57,0:13:09.78,Default,,0,0,0,,Гардона Алғама Центр көшесі?
Dialogue: 0,0:13:10.37,0:13:12.95,Default,,0,0,0,,Сіз мұны қоғамдық қоғамға сатасыз ба?
Dialogue: 0,0:13:13.04,0:13:15.58,Default,,0,0,0,,Балалар, оны алып жүріңдер.
Dialogue: 0,0:13:15.66,0:13:19.84,Default,,0,0,0,,Сол шіріктің бетін ашсаң, сатылатын дүние де сатылмайды.
Dialogue: 0,0:13:20.67,0:13:22.09,Default,,0,0,0,,Орындаймын деп айтпа.
Dialogue: 0,0:13:23.51,0:13:28.01,Default,,0,0,0,,Бір піл сүйегі әкелу арқылы Шиши-гумиге бастық боламын деп ойламаңыз.
Dialogue: 0,0:13:28.80,0:13:31.22,Default,,0,0,0,,А... жарайды, солай.
Dialogue: 0,0:13:31.31,0:13:32.47,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:32.97,0:13:35.14,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:13:35.23,0:13:35.85,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:37.39,0:13:38.85,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:13:38.94,0:13:40.81,Default,,0,0,0,,О... шын айтасыз ба?
Dialogue: 0,0:13:50.74,0:13:51.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:51.91,0:13:53.58,Default,,0,0,0,,Рам-чан
Dialogue: 0,0:13:53.66,0:13:58.79,Default,,0,0,0,,Мереке болса да сауда алаңын тексеру? Жұмысқа әлі де ынталы
Dialogue: 0,0:13:58.87,0:14:01.79,Default,,0,0,0,,Біз де емеспіз. Хехехе
Dialogue: 0,0:14:02.38,0:14:05.71,Default,,0,0,0,,Ауа-райы жақсы болды, демалыс күні де жақсы болды.
Dialogue: 0,0:14:05.80,0:14:06.97,Default,,0,0,0,,Мен шынымен твиттер жазбаймын
Dialogue: 0,0:14:07.05,0:14:11.22,Default,,0,0,0,,Рам-чан - шөпқоректі жануар, сондықтан сіз жай ғана жеңіл жүріңіз.
Dialogue: 0,0:14:11.30,0:14:13.64,Default,,0,0,0,,Хехе, дұрыс.
Dialogue: 0,0:14:13.72,0:14:17.02,Default,,0,0,0,,Бірақ бәрібір, өтірік күлімсіреп құтылуға болады
Dialogue: 0,0:14:17.10,0:14:18.94,Default,,0,0,0,,Бұл менің өмірімді басқару тәсілі.
Dialogue: 0,0:14:19.02,0:14:21.40,Default,,0,0,0,,Бізге ет жеу қиын.
Dialogue: 0,0:14:21.48,0:14:23.61,Default,,0,0,0,,Бұл кезде Рам-чанға күлімсіреу керек.
Dialogue: 0,0:14:23.61,0:14:24.86,Default,,0,0,0,,Бұл кезде Рам-чанға күлімсіреу керек.
Dialogue: 0,0:14:23.61,0:14:24.86,Default,,0,0,0,,Сукуна мен қондырғы — табиғи жаулар, түсінесің бе.
Dialogue: 0,0:14:25.48,0:14:26.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:28.57,0:14:31.57,Default,,0,0,0,,Бұл кішкене сияқты.
Dialogue: 0,0:14:33.24,0:14:35.54,Default,,0,0,0,,О... а...
Dialogue: 0,0:14:35.62,0:14:37.37,Default,,0,0,0,,Рам-чан, бір-біріңді танисыңдар ма?
Dialogue: 0,0:14:37.45,0:14:39.00,Default,,0,0,0,,- Иә? - Менің көршім
Dialogue: 0,0:14:39.08,0:14:44.04,Default,,0,0,0,,А... а, мен қорқып кеттім. Мен оны жігітім деп ойладым.
Dialogue: 0,0:14:44.13,0:14:45.50,Default,,0,0,0,,-Жоқ, бірақ -Жоқ...
Dialogue: 0,0:14:46.30,0:14:49.26,Default,,0,0,0,,Ал бұл кісінің аты Жеті мырза.
Dialogue: 0,0:14:49.34,0:14:50.51,Default,,0,0,0,,Ром емес
Dialogue: 0,0:14:50.59,0:14:51.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:51.55,0:14:53.60,Default,,0,0,0,,Бұл компанияның лақап аты немесе басқасы ма?
Dialogue: 0,0:14:53.68,0:14:57.39,Default,,0,0,0,,Жоқ... дұрыс, үлкендер арасындағы әзілдер.
Dialogue: 0,0:14:57.47,0:14:58.27,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:14:58.81,0:15:03.36,Default,,0,0,0,,А... біз ондай зұлымдықты білдірмейміз...
Dialogue: 0,0:15:03.90,0:15:04.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:05.44,0:15:08.28,Default,,0,0,0,,Ио... ойланып қарасаңыз, бұл өте қорқынышты, солай емес пе?
Dialogue: 0,0:15:08.36,0:15:09.70,Default,,0,0,0,,Мұны саған кім айтты? сіз бе?
Dialogue: 0,0:15:09.78,0:15:11.86,Default,,0,0,0,,А, жоқ, жоқ... бұл менеджер!
Dialogue: 0,0:15:11.95,0:15:15.20,Default,,0,0,0,,Эй, жеке өміріңді бұзғаным үшін кешір. Жұмыста кездескенше...
Dialogue: 0,0:15:15.28,0:15:17.79,Default,,0,0,0,,Кездескенше, Жеті мырза
Dialogue: 0,0:15:18.83,0:15:20.83,Default,,0,0,0,,Күте тұрыңыз, не?
Dialogue: 0,0:15:21.79,0:15:25.92,Default,,0,0,0,,Мен компанияда қорқытуға шыдап, қолымнан келгеннің бәрін істеуге тырыстым.
Dialogue: 0,0:15:26.00,0:15:27.71,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:15:27.80,0:15:30.17,Default,,0,0,0,,Жеті мырза мазасыз болып көрінді.
Dialogue: 0,0:15:30.76,0:15:32.68,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:15:34.68,0:15:36.76,Default,,0,0,0,,Сонда сен маған көмектесемін деп ойладың ба?
Dialogue: 0,0:15:36.85,0:15:38.22,Default,,0,0,0,,А? Ә?
Dialogue: 0,0:15:39.93,0:15:41.98,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:15:42.06,0:15:43.73,Default,,0,0,0,,Кешіріңіз, у...
Dialogue: 0,0:15:43.81,0:15:46.86,Default,,0,0,0,,Жігітіңіз деп түсінбегенді жек көрдіңіз бе?
Dialogue: 0,0:15:46.94,0:15:48.69,Default,,0,0,0,,Бірақ мен оны дұрыстап жоққа шығардым.
Dialogue: 0,0:15:48.78,0:15:52.07,Default,,0,0,0,,Бала Бала Шынында да бала
Dialogue: 0,0:15:52.61,0:15:53.61,Default,,0,0,0,,Неге!
Dialogue: 0,0:15:55.62,0:15:59.70,Default,,0,0,0,,Неліктен сен сияқты бала маған қарағанда көбірек айтады?
Dialogue: 0,0:15:59.79,0:16:02.04,Default,,0,0,0,,Сіздің әлеуметтік тәжірибеңіз көп емес.
Dialogue: 0,0:16:02.12,0:16:05.88,Default,,0,0,0,,Бірде-бір достық күлімсіреп, мен олардың үндерін бір ауыз сөзбен өшірдім.
Dialogue: 0,0:16:06.50,0:16:09.30,Default,,0,0,0,,Жай ғана үлкен жыртқыш!
Dialogue: 0,0:16:09.38,0:16:11.42,Default,,0,0,0,,Қасқыр сонда! Мен хабарлаймын!
Dialogue: 0,0:16:11.51,0:16:12.42,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:16:12.51,0:16:14.47,Default,,0,0,0,,А... жарайды.
Dialogue: 0,0:16:19.35,0:16:21.35,Default,,0,0,0,,ойыма да келмеген
Dialogue: 0,0:16:22.02,0:16:26.19,Default,,0,0,0,,Ол кісі мен білмейтін өмірдің қиындығын біледі.
Dialogue: 0,0:16:26.86,0:16:29.32,Default,,0,0,0,,Мен көп нәрсені бастан өткердім.
Dialogue: 0,0:16:30.48,0:16:32.28,Default,,0,0,0,,(құты ашылған дыбыс)
Dialogue: 0,0:16:32.86,0:16:35.53,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:16:36.16,0:16:38.70,Default,,0,0,0,,О пух~
Dialogue: 0,0:16:39.45,0:16:40.74,Default,,0,0,0,,Жеті мырза
Dialogue: 0,0:16:41.91,0:16:45.92,Default,,0,0,0,,Неге менің артымнан келе жатырсың? Мен жалғыз ішетін сияқтымын!
Dialogue: 0,0:16:46.71,0:16:48.59,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:16:48.67,0:16:52.34,Default,,0,0,0,,Севеннің сезімін ескермей, өзімшілдікпен айналыс.
Dialogue: 0,0:16:53.01,0:16:53.92,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:16:54.47,0:16:55.72,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:16:56.26,0:16:57.72,Default,,0,0,0,,Ересектер –
Dialogue: 0,0:16:57.80,0:17:00.56,Default,,0,0,0,,Кешірім сұрағыңыз келген адам сізден кешірім сұрағанда
Dialogue: 0,0:17:00.64,0:17:02.22,Default,,0,0,0,,Мен өзімді бақытсыз сезінемін
Dialogue: 0,0:17:03.14,0:17:04.73,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,0:17:05.81,0:17:07.94,Default,,0,0,0,,Ештеңе айтудың қажеті жоқ
Dialogue: 0,0:17:08.61,0:17:11.53,Default,,0,0,0,,Бұл сіздің кінәңіз емес, әрине.
Dialogue: 0,0:17:14.03,0:17:16.03,Default,,0,0,0,,Тіпті жауап бермеген дұрыс па?
Dialogue: 0,0:17:16.11,0:17:18.57,Default,,0,0,0,,Хехе, сен ақымақтықпен байсалдысың.
Dialogue: 0,0:17:19.99,0:17:21.03,Default,,0,0,0,,(құбырдың соғу дыбысы)
Dialogue: 0,0:17:24.16,0:17:28.63,Default,,0,0,0,,(кеме ысқырығы)
Dialogue: 0,0:17:33.71,0:17:36.55,Default,,0,0,0,,Бұл ақша менікі болса екен.
Dialogue: 0,0:17:36.63,0:17:38.01,Default,,0,0,0,,Сіз не жейсіз?
Dialogue: 0,0:17:38.09,0:17:40.93,Default,,0,0,0,,Тоқта, әйтпесе өлтіресің.
Dialogue: 0,0:17:41.01,0:17:43.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:43.31,0:17:48.15,Default,,0,0,0,,Чу Чу…
Dialogue: 0,0:17:51.32,0:17:52.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:52.65,0:17:54.94,Default,,0,0,0,,Гухин...?
Dialogue: 0,0:17:59.74,0:18:03.04,Default,,0,0,0,,Бұл Гухин емес, бұл «Бес жүз бұрышты егеуқұйрық»!
Dialogue: 0,0:18:03.95,0:18:06.29,Default,,0,0,0,,Гуаа
Dialogue: 0,0:18:06.37,0:18:07.62,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:18:08.71,0:18:09.83,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:18:09.92,0:18:11.21,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:18:11.29,0:18:12.71,Default,,0,0,0,,Онда да!
Dialogue: 0,0:18:12.80,0:18:14.84,Default,,0,0,0,,Біз не істеуіміз керек? Бұл Шиши-гумидің ақшасы!
Dialogue: 0,0:18:14.92,0:18:16.76,Default,,0,0,0,,Мен мұны білемін!
Dialogue: 0,0:18:19.13,0:18:22.76,Default,,0,0,0,,Чу Чу…
Dialogue: 0,0:18:22.85,0:18:24.01,Default,,0,0,0,,Сол сұм Боинго! Ең болмағанда қазір! Мылтығым➡
Dialogue: 0,0:18:27.31,0:18:29.27,Default,,0,0,0,,Эй, күте тұрыңыз!
Dialogue: 0,0:18:29.35,0:18:30.90,Default,,0,0,0,,Чу Чу
Dialogue: 0,0:18:30.98,0:18:35.19,Default,,0,0,0,,Біздің саясат – зұлым адамдардың ақшасын ұрлау.
Dialogue: 0,0:18:36.07,0:18:41.53,Default,,0,0,0,,Егер біз 500 малды түгел жұмылдырсақ, жер асты базары мен жер үсті қоғам туралы бәрін түсіне аламыз.
Dialogue: 0,0:18:42.53,0:18:44.79,Default,,0,0,0,,Бұл өте қызықты жұмыс.
Dialogue: 0,0:18:52.21,0:18:54.84,Default,,0,0,0,,(егеуқұйрықтардың шуы)
Dialogue: 0,0:18:57.17,0:19:00.80,Default,,0,0,0,,(егеуқұйрықтардың айқайы)
Dialogue: 0,0:19:03.47,0:19:06.39,Default,,0,0,0,,Әкімнің алтын сағатын ұрлағандар сендер болдыңдар ғой?
Dialogue: 0,0:19:06.89,0:19:07.47,Default,,0,0,0,,Түкіру
Dialogue: 0,0:19:07.56,0:19:08.10,Default,,0,0,0,,Құт
Dialogue: 0,0:19:11.56,0:19:14.61,Default,,0,0,0,,Қанша егеуқұйрық бұзақысы өлді?
Dialogue: 0,0:19:14.69,0:19:17.23,Default,,0,0,0,,Полиция ауырмайды және қышымайды.
Dialogue: 0,0:19:18.36,0:19:20.57,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:20.65,0:19:22.78,Default,,0,0,0,,Өмір тең
Dialogue: 0,0:19:23.45,0:19:25.33,Default,,0,0,0,,Я… Яхья-сама
Dialogue: 0,0:19:25.41,0:19:29.79,Default,,0,0,0,,Тіпті күлкілі салмақты сіз сияқты үлкен нәсілдер де.
Dialogue: 0,0:19:29.87,0:19:33.50,Default,,0,0,0,,Автоматты есіктерге де жауап бермейтін шағын жарыстар да бар.
Dialogue: 0,0:19:33.58,0:19:35.75,Default,,0,0,0,,Бұл қызметші де
Dialogue: 0,0:19:36.67,0:19:38.51,Default,,0,0,0,,Біз бәріміз бірдейміз
Dialogue: 0,0:19:38.59,0:19:41.22,Default,,0,0,0,,Барлық тіршілік бірдей кішкентай.
Dialogue: 0,0:19:42.72,0:19:45.89,Default,,0,0,0,,Сол кішкентай өмірді құтқару
Dialogue: 0,0:19:46.76,0:19:49.02,Default,,0,0,0,,Бұл менің жұмысым.
Dialogue: 0,0:19:52.81,0:19:56.15,Default,,0,0,0,,Өйткені олар... егеуқұйрықтар.
Dialogue: 0,0:19:56.23,0:19:59.65,Default,,0,0,0,,Менің күнделікті әрекеттерім апат болды.
Dialogue: 0,0:19:59.74,0:20:01.82,Default,,0,0,0,,мысал туралы не деуге болады?
Dialogue: 0,0:20:02.82,0:20:06.12,Default,,0,0,0,,Доку тобы Инари тобы Мадара тобы
Dialogue: 0,0:20:06.20,0:20:08.41,Default,,0,0,0,,Әр жұп әртүрлі болып көрінеді.
Dialogue: 0,0:20:08.49,0:20:10.12,Default,,0,0,0,,Сонымен, бұл Шишигуми ме?
Dialogue: 0,0:20:10.20,0:20:14.08,Default,,0,0,0,,Ал, қазіргі Шиши-гумиде бастық жоқ.
Dialogue: 0,0:20:14.17,0:20:16.13,Default,,0,0,0,,«Кинусты» қалай өңдеу керек...
Dialogue: 0,0:20:16.84,0:20:21.30,Default,,0,0,0,,Соңғы уақытта ол астыртын базарлардан тыс жерлерде тез таралып жатқан сияқты.
Dialogue: 0,0:20:22.01,0:20:25.05,Default,,0,0,0,,Ол әлі де қоғамдық қоғамда айналып жүр ме?
Dialogue: 0,0:20:25.14,0:20:26.85,Default,,0,0,0,,Алдымен мені кешіріңіз.
Dialogue: 0,0:20:27.51,0:20:30.72,Default,,0,0,0,,Иә, бұл да өте жылдам.
Dialogue: 0,0:20:30.81,0:20:33.44,Default,,0,0,0,,Жас жыртқыштардың қолында
Dialogue: 0,0:20:34.31,0:20:36.52,Default,,0,0,0,,Ғылыми зерттеулер институтының талдауында
Dialogue: 0,0:20:36.61,0:20:40.15,Default,,0,0,0,,Құрамында есірткіге ұқсас ингредиенттер бар.
Dialogue: 0,0:20:40.23,0:20:45.41,Default,,0,0,0,,Ерекше қауіпті - ет жеу тарихы бар жыртқыштар.
Dialogue: 0,0:20:46.28,0:20:50.37,Default,,0,0,0,,Бір рет қабылдағаннан кейін де зорлық-зомбылық әсерлері күшейеді.
Dialogue: 0,0:20:50.45,0:20:54.50,Default,,0,0,0,,Етке деген құштарлығың күшті болады...
Dialogue: 0,0:20:56.67,0:20:59.46,Default,,0,0,0,,Бұл менің алғашқы дұрыс ақшам.
Dialogue: 0,0:21:00.34,0:21:03.09,Default,,0,0,0,,Енді сіз жалдау ақысы мен электр қуатын төлей аласыз.
Dialogue: 0,0:21:03.17,0:21:05.72,Default,,0,0,0,,Мен Хару-чанға гүл алғым келеді.
Dialogue: 0,0:21:06.34,0:21:09.22,Default,,0,0,0,,Мен мұны дұрыс орындай алатын сияқтымын.
Dialogue: 0,0:21:09.93,0:21:15.52,Default,,0,0,0,,Сондықтан мен бұдан былай Хару-чаннан құпия сақтағым келмейді.
Dialogue: 0,0:21:19.19,0:21:20.27,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:21:20.36,0:21:22.78,Default,,0,0,0,,Үлкен аға Қайырлы кеш, аға!
Dialogue: 0,0:21:22.86,0:21:24.28,Default,,0,0,0,,Қайырлы кеш?
Dialogue: 0,0:21:24.36,0:21:25.57,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:27.03,0:21:30.20,Default,,0,0,0,,Жыртқыштарға арналған энергетикалық сусын ше?
Dialogue: 0,0:21:31.20,0:21:33.70,Default,,0,0,0,,Бауырым, шаршадың ба?
Dialogue: 0,0:21:33.79,0:21:35.29,Default,,0,0,0,,Сондай-ақ дилерлер
Dialogue: 0,0:21:35.37,0:21:39.08,Default,,0,0,0,,Сіз бұл туралы көп білмей, зорлық-зомбылық мәселесімен айналысып жатқан сияқтысыз.
Dialogue: 0,0:21:40.63,0:21:42.50,Default,,0,0,0,,Жағдайға байланысты—
Dialogue: 0,0:21:42.59,0:21:46.55,Default,,0,0,0,,Жыртқыштар бір-бірін өлтіруі мүмкін.
Dialogue: 0,0:21:48.01,0:21:50.89,Default,,0,0,0,,Ал, мен өзімнің физикалық күшіме сенімдімін.
Dialogue: 0,0:21:50.97,0:21:53.85,Default,,0,0,0,,Жарайды, жарайды, мен алданып қалдым деп ойладым...
Dialogue: 0,0:21:53.93,0:21:56.27,Default,,0,0,0,,Алдымен бір бөтелкені қолданып көріңіз.
Dialogue: 0,0:21:58.15,0:21:58.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:11.99,0:22:13.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.54,0:23:41.54,Default,,0,0,0,,～♪
