Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.01,0:00:14.01,Default,,0,0,0,,♪～
Dialogue: 0,0:01:38.13,0:01:40.14,Default,,0,0,0,,～♪
Dialogue: 0,0:01:51.69,0:01:54.53,Default,,0,0,0,,Миозин актин миоген...
Dialogue: 0,0:01:54.61,0:01:58.45,Default,,0,0,0,,Тонгкат фосфат Мака
Dialogue: 0,0:01:58.53,0:01:59.24,Default,,0,0,0,,Шинигаминің көздерін алу үшін,
Dialogue: 0,0:01:59.78,0:02:02.58,Default,,0,0,0,,Ет пен сүйектің құрамдас бөлігі.
Dialogue: 0,0:02:02.66,0:02:05.50,Default,,0,0,0,,Осыған ұқсас нәрсе – сатылымдағы сусын
Dialogue: 0,0:02:05.58,0:02:08.16,Default,,0,0,0,,Ет ауруы сияқты белгілер пайда болады.
Dialogue: 0,0:02:08.25,0:02:12.00,Default,,0,0,0,,Бірақ бұл ет ауруын қоздыру үшін жеткіліксіз.
Dialogue: 0,0:02:12.09,0:02:13.21,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:13.29,0:02:15.67,Default,,0,0,0,,Сонымен тағы қандай себептер бар?
Dialogue: 0,0:02:15.76,0:02:19.13,Default,,0,0,0,,Иә, басқа затпен әрекеттесу арқылы—
Dialogue: 0,0:02:19.22,0:02:22.01,Default,,0,0,0,,Мүмкін ол орталық жүйке жүйесін қоздырады
Dialogue: 0,0:02:22.64,0:02:24.68,Default,,0,0,0,,Катализатор сияқты нәрсе бар ма?
Dialogue: 0,0:02:24.76,0:02:26.39,Default,,0,0,0,,Хмм.
Dialogue: 0,0:02:26.47,0:02:30.27,Default,,0,0,0,,Шөпқоректілер оны ішсе де, оларда ешқандай белгілер байқалмайтын сияқты.
Dialogue: 0,0:02:30.35,0:02:32.73,Default,,0,0,0,,Тек жыртқыштарда болатын нәрсе.
Dialogue: 0,0:02:33.19,0:02:34.36,Default,,0,0,0,,Бірақ мен Юлий деген адам емеспін.
Dialogue: 0,0:02:34.44,0:02:36.53,Default,,0,0,0,,Бұл менің тәжірибемнен тыс.
Dialogue: 0,0:02:37.11,0:02:39.99,Default,,0,0,0,,Бірақ бұл туралы көбірек білетін зерттеушілер бар.
Dialogue: 0,0:02:40.07,0:02:42.16,Default,,0,0,0,,Сіз ғылыми-зерттеу институтындасыз ба?
Dialogue: 0,0:02:42.24,0:02:45.45,Default,,0,0,0,,Жоқ, бұл басқа жерде...
Dialogue: 0,0:02:45.54,0:02:46.95,Default,,0,0,0,,Аз ғана.
Dialogue: 0,0:02:48.33,0:02:49.33,Default,,0,0,0,,Бірақ мен Юлий деген адам емеспін.
Dialogue: 0,0:02:49.41,0:02:52.33,Default,,0,0,0,,Ол керемет, бірақ ол көлеңкелі.
Dialogue: 0,0:02:52.42,0:02:54.00,Default,,0,0,0,,Мені таныстыра аласыз ба...
Dialogue: 0,0:02:54.09,0:02:54.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:56.46,0:02:58.21,Default,,0,0,0,,Не?
Dialogue: 0,0:02:58.30,0:02:59.72,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:59.80,0:03:02.01,Default,,0,0,0,,Не болды? Сенімен бәрі жақсы ма?
Dialogue: 0,0:03:02.09,0:03:03.39,Default,,0,0,0,,Луис мырза!
Dialogue: 0,0:03:05.89,0:03:07.64,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:07.72,0:03:09.98,Default,,0,0,0,,Байланыс ақпаратыңызды жіберіңіз
Dialogue: 0,0:03:10.06,0:03:11.23,Default,,0,0,0,,(шерткен дыбыс)
Dialogue: 0,0:03:11.31,0:03:12.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:12.15,0:03:13.65,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:03:14.90,0:03:16.65,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:03:17.98,0:03:21.15,Default,,0,0,0,,Легоши сізді тізеден төмен тамақтандыруы керек еді.
Dialogue: 0,0:03:23.07,0:03:25.91,Default,,0,0,0,,Бірдеңе болды ма? Легошиге
Dialogue: 0,0:03:31.50,0:03:33.17,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:03:33.25,0:03:35.46,Default,,0,0,0,,Шынымен де, сол қасқыр туралы.
Dialogue: 0,0:03:35.54,0:03:36.50,Default,,0,0,0,,«Мен бірде сенімен жақсылап сөйлескім келеді.»
Dialogue: 0,0:03:36.59,0:03:38.34,Default,,0,0,0,,Сондықтан да осылай айтып отырсыз.
Dialogue: 0,0:03:38.42,0:03:40.63,Default,,0,0,0,,Менен иесі сұрағандықтан
Dialogue: 0,0:03:40.72,0:03:43.26,Default,,0,0,0,,Біз де жорғалап жүрміз бе?
Dialogue: 0,0:03:43.34,0:03:46.55,Default,,0,0,0,,Қоштасып үйге кететіндей ақымақ емеспін.
Dialogue: 0,0:03:46.64,0:03:49.43,Default,,0,0,0,,Қанша айтсам да, түсінбейсің, ақымақ.
Dialogue: 0,0:03:49.52,0:03:50.23,Default,,0,0,0,,Не!
Dialogue: 0,0:03:50.31,0:03:52.89,Default,,0,0,0,,Тіпті біз сенің жалаңаштығыңды көреміз
Dialogue: 0,0:03:52.98,0:03:56.06,Default,,0,0,0,,Мен ғибадат жасай алмайтын нәрсені істегім келмейді.
Dialogue: 0,0:03:56.15,0:03:58.44,Default,,0,0,0,,Айтпа, жеңілірек болады.
Dialogue: 0,0:03:59.03,0:04:00.61,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:04:01.74,0:04:02.78,Default,,0,0,0,,(Агата тілін шертеді)
Dialogue: 0,0:04:02.86,0:04:04.45,Default,,0,0,0,,Мен көмектесе алмаймын.
Dialogue: 0,0:04:05.41,0:04:06.95,Default,,0,0,0,,үшін осы
Dialogue: 0,0:04:08.49,0:04:09.91,Default,,0,0,0,,Ха...
Dialogue: 0,0:04:09.99,0:04:12.29,Default,,0,0,0,,Үйге де құр алақан бара алмаймыз.
Dialogue: 0,0:04:12.87,0:04:13.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:15.21,0:04:19.71,Default,,0,0,0,,Біз келгенде сен енді жоқ едің.
Dialogue: 0,0:04:19.80,0:04:20.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:20.63,0:04:21.38,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:04:22.47,0:04:24.80,Default,,0,0,0,,Мен бұрынғы бастығыма уәде бердім.
Dialogue: 0,0:04:24.88,0:04:27.47,Default,,0,0,0,,Мен сені қорғаймын.
Dialogue: 0,0:04:27.55,0:04:30.77,Default,,0,0,0,,Сіздің бұрынғы бастығыңыз Джика Чан болды ма?
Dialogue: 0,0:04:30.85,0:04:33.23,Default,,0,0,0,,Шиши-гуми уәдесінде тұрады
Dialogue: 0,0:04:37.44,0:04:40.28,Default,,0,0,0,,Сіз басқа кәдесый ұтып ала аласыз.
Dialogue: 0,0:04:42.53,0:04:45.07,Default,,0,0,0,,Әй, сен мені өлтіремін дедің ғой.
Dialogue: 0,0:04:45.15,0:04:46.78,Default,,0,0,0,,Жаман емес пе?
Dialogue: 0,0:04:46.86,0:04:48.12,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:04:48.20,0:04:49.74,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:04:50.33,0:04:50.91,Default,,0,0,0,,А…?
Dialogue: 0,0:05:05.01,0:05:06.88,Default,,0,0,0,,Зузл жолы
Dialogue: 0,0:05:06.97,0:05:09.72,Default,,0,0,0,,Жер асты нарығын қарастырыңыз.
Dialogue: 0,0:05:10.60,0:05:12.85,Default,,0,0,0,,Мені тауып алса жаман болар еді.
Dialogue: 0,0:05:13.81,0:05:18.06,Default,,0,0,0,,(еркін ауыр тыныс алу)
Dialogue: 0,0:05:21.73,0:05:23.11,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:23.19,0:05:24.69,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:05:26.95,0:05:28.41,Default,,0,0,0,,Ах
Dialogue: 0,0:05:29.78,0:05:30.74,Default,,0,0,0,,(дыбысты ауыстыру)
Dialogue: 0,0:05:31.66,0:05:33.54,Default,,0,0,0,,Техникалық қызмет көрсету қажет
Dialogue: 0,0:05:34.20,0:05:35.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:43.42,0:05:44.80,Default,,0,0,0,,Егер бізге шабуыл жасалса, онда
Dialogue: 0,0:05:47.63,0:05:51.85,Default,,0,0,0,,Біздің соңғы уәдемізді ұмытпайтыныңызға сенімдімін.
Dialogue: 0,0:05:52.81,0:05:57.23,Default,,0,0,0,,Келесі жолы сені артқы базарда көрсем, мен сені өлтіремін.
Dialogue: 0,0:05:58.69,0:06:02.07,Default,,0,0,0,,О, мен уәдемді бұздым.
Dialogue: 0,0:06:03.23,0:06:04.11,Default,,0,0,0,,Ату!
Dialogue: 0,0:06:05.94,0:06:09.32,Default,,0,0,0,,Тәтті, мен неге...
Dialogue: 0,0:06:09.95,0:06:11.37,Default,,0,0,0,,Еш ойланбаңыз
Dialogue: 0,0:06:13.03,0:06:14.58,Default,,0,0,0,,Ибуки және мына жігіт—
Dialogue: 0,0:06:14.66,0:06:17.75,Default,,0,0,0,,Мен сені неге өлтіруім керек?
Dialogue: 0,0:06:18.87,0:06:23.17,Default,,0,0,0,,Ол бетіңді жасама, сен хайуандардың патшасысың.
Dialogue: 0,0:06:23.67,0:06:26.09,Default,,0,0,0,,Оның жүзі байсалды...
Dialogue: 0,0:06:27.26,0:06:31.22,Default,,0,0,0,,Сіз ең жақсы бастық болдыңыз.
Dialogue: 0,0:06:31.30,0:06:32.68,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:46.53,0:06:51.82,Default,,0,0,0,,Мүйіздердің қайта өсуі... Ол кез болды ма?
Dialogue: 0,0:06:53.12,0:06:55.70,Default,,0,0,0,,Сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:06:57.50,0:06:58.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:59.83,0:07:03.25,Default,,0,0,0,,Келесі жолы сені көргенде өлтіремін.
Dialogue: 0,0:07:03.33,0:07:05.63,Default,,0,0,0,,Иә, мен осылай уәде бердім.
Dialogue: 0,0:07:06.17,0:07:09.88,Default,,0,0,0,,Бірақ біз сенің олай екеніңді білмейміз.
Dialogue: 0,0:07:09.97,0:07:11.72,Default,,0,0,0,,(мүшелердің күлкілері)
Dialogue: 0,0:07:13.18,0:07:13.85,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:07:14.39,0:07:17.31,Default,,0,0,0,,- (Еркін) Мен сені сағындым - Эй эй
Dialogue: 0,0:07:17.39,0:07:18.47,Default,,0,0,0,,Сен өлесің.
Dialogue: 0,0:07:18.56,0:07:20.39,Default,,0,0,0,,Сіз...
Dialogue: 0,0:07:20.48,0:07:21.52,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:07:25.77,0:07:28.53,Default,,0,0,0,,Керемет
Dialogue: 0,0:07:28.61,0:07:31.49,Default,,0,0,0,,Бірақ былай қарасаң, бұғы баласына ұқсайды.
Dialogue: 0,0:07:31.57,0:07:32.78,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:07:32.86,0:07:36.53,Default,,0,0,0,,Қандай ысырап, әдемі өскен.
Dialogue: 0,0:07:36.62,0:07:38.37,Default,,0,0,0,,Мұнымен не істеуіміз керек?
Dialogue: 0,0:07:38.45,0:07:40.37,Default,,0,0,0,,Мен саған кәдесый ретінде беремін.
Dialogue: 0,0:07:40.46,0:07:41.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:42.00,0:07:43.50,Default,,0,0,0,,Бұрынғы бастық күткендей
Dialogue: 0,0:07:44.13,0:07:47.38,Default,,0,0,0,,Айтпақшы, басқа жарақаттар бар ма?
Dialogue: 0,0:07:47.46,0:07:49.63,Default,,0,0,0,,Біртүрлі жүрдің.
Dialogue: 0,0:07:49.71,0:07:51.59,Default,,0,0,0,,А, менің оң аяғым кетіп қалды.
Dialogue: 0,0:07:51.67,0:07:53.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:55.51,0:07:57.10,Default,,0,0,0,,О~
Dialogue: 0,0:07:57.18,0:07:59.43,Default,,0,0,0,,Ал, дене мүшесін жоғалту
Dialogue: 0,0:07:59.52,0:08:00.73,Default,,0,0,0,,Себебі мен бұрышта үйреніп қалғанмын.
Dialogue: 0,0:08:01.56,0:08:03.14,Default,,0,0,0,,Бұл үлкен мәселе емес
Dialogue: 0,0:08:03.85,0:08:04.69,Default,,0,0,0,,Осыдан-
Dialogue: 0,0:08:05.98,0:08:08.94,Default,,0,0,0,,Балалар, сендер жалқау болып тұрсыңдар ма?
Dialogue: 0,0:08:09.73,0:08:11.36,Default,,0,0,0,,(Агата күрсінуі)
Dialogue: 0,0:08:11.44,0:08:15.28,Default,,0,0,0,,Біз айына екі мезгіл ғана ет жеуіміз керек.
Dialogue: 0,0:08:15.36,0:08:18.12,Default,,0,0,0,,Бұл Шиши-гуми үшін жаңа ереже.
Dialogue: 0,0:08:18.70,0:08:22.37,Default,,0,0,0,,Оның назарын ұрлап, етін жесең, ол бірден біледі...
Dialogue: 0,0:08:22.46,0:08:23.54,Default,,0,0,0,,үшінңыз, осы жерде қалыңыздар.
Dialogue: 0,0:08:24.17,0:08:25.04,Default,,0,0,0,,Бұл жігіт пе?
Dialogue: 0,0:08:25.12,0:08:27.96,Default,,0,0,0,,Ендеше, сіз артқы нарыққа не үшін келдіңіз?
Dialogue: 0,0:08:28.04,0:08:29.21,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:08:29.92,0:08:32.42,Default,,0,0,0,,Копила... у...
Dialogue: 0,0:08:34.59,0:08:38.10,Default,,0,0,0,,Копи Лувак? Ах...
Dialogue: 0,0:08:38.18,0:08:39.39,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:08:39.47,0:08:41.06,Default,,0,0,0,,О? О
Dialogue: 0,0:08:41.14,0:08:44.27,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:08:44.35,0:08:46.56,Default,,0,0,0,,-Бұл бастық! -(Виктор) Иә.
Dialogue: 0,0:08:54.40,0:08:57.82,Default,,0,0,0,,Мен оның жиіркенішті екенін білемін, бірақ иіс пен жасырынудан құтылу үшін осыны пайдаланыңыз.
Dialogue: 0,0:09:10.00,0:09:13.76,Default,,0,0,0,,Қараңдаршы, бұл мысықтарға арналған кәдесый.
Dialogue: 0,0:09:15.88,0:09:17.80,Default,,0,0,0,,(мүшелердің таңқаларлық дыбыстары)
Dialogue: 0,0:09:17.89,0:09:21.68,Default,,0,0,0,,Мен ешқандай қауіпсіздік жасай алмадым, бірақ бұл пайдасыз болды...
Dialogue: 0,0:09:21.76,0:09:24.14,Default,,0,0,0,,Бұл интерьерге қатысты болар.
Dialogue: 0,0:09:24.89,0:09:25.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:25.81,0:09:26.81,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:09:26.89,0:09:29.69,Default,,0,0,0,,Сіз стриптизші стейк жейсіз бе?
Dialogue: 0,0:09:30.69,0:09:33.90,Default,,0,0,0,,Газель? Жоқ, бұл азулар...
Dialogue: 0,0:09:34.44,0:09:35.86,Default,,0,0,0,,Бұл араласпа ма?
Dialogue: 0,0:09:38.53,0:09:41.28,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:09:41.87,0:09:45.04,Default,,0,0,0,,стриптизшілер трафиктен кейін
Dialogue: 0,0:09:45.12,0:09:48.46,Default,,0,0,0,,Оның орнына иесі тәртіптік жазаға тартылды.
Dialogue: 0,0:09:48.54,0:09:50.17,Default,,0,0,0,,А...?
Dialogue: 0,0:09:50.25,0:09:51.42,Default,,0,0,0,,Сіз—
Dialogue: 0,0:09:51.50,0:09:55.38,Default,,0,0,0,,Бұл кешкі асты алмастыра алады деп ойлайсыз ба?
Dialogue: 0,0:09:55.46,0:09:57.97,Default,,0,0,0,,Ол жақтағы Синоги үлкен.
Dialogue: 0,0:09:58.59,0:10:00.30,Default,,0,0,0,,Және Шишигуми
Dialogue: 0,0:10:00.39,0:10:03.76,Default,,0,0,0,,Мен Шиманың жігіттерін жеп қояйын деп тамаққа алаңдамаймын.
Dialogue: 0,0:10:04.47,0:10:09.40,Default,,0,0,0,,Күрсін, мен таң қалдым.
Dialogue: 0,0:10:09.98,0:10:14.73,Default,,0,0,0,,Ол берік идеялармен әрекет етеді.
Dialogue: 0,0:10:14.82,0:10:15.86,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:10:15.94,0:10:17.03,Default,,0,0,0,,Хаха...
Dialogue: 0,0:10:17.11,0:10:19.28,Default,,0,0,0,,(Рюкю) үшінның өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:10:19.36,0:10:21.24,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,0:10:22.83,0:10:26.87,Default,,0,0,0,,Конго арыстаны Агата, 26 жаста
Dialogue: 0,0:10:26.95,0:10:29.17,Default,,0,0,0,,Шиши-гуми тобының ең жас мүшесі!
Dialogue: 0,0:10:29.25,0:10:32.96,Default,,0,0,0,,(Агатаның айқайы)
Dialogue: 0,0:10:33.04,0:10:36.92,Default,,0,0,0,,Шынымды айтсам тым суық.
Dialogue: 0,0:10:37.01,0:10:40.13,Default,,0,0,0,,Арыстан бала қызықсыз
Dialogue: 0,0:10:40.89,0:10:41.76,Default,,0,0,0,,Сәлем бос
Dialogue: 0,0:10:41.84,0:10:43.47,Default,,0,0,0,,Э? Иә.
Dialogue: 0,0:10:44.06,0:10:46.39,Default,,0,0,0,,Мұнда бөгде адам бар.
Dialogue: 0,0:10:49.10,0:10:52.65,Default,,0,0,0,,Балалар, мені сыйламайсыңдар ма?
Dialogue: 0,0:10:53.52,0:10:56.69,Default,,0,0,0,,Мен иісі арқылы айта аламын.
Dialogue: 0,0:10:58.90,0:11:00.45,Default,,0,0,0,,Мен мұнда отырып ауа оғын атып, оны дәл тигізе алар едім
Dialogue: 0,0:11:00.53,0:11:01.86,Default,,0,0,0,,Сіз немен айналысып жатырсыз?
Dialogue: 0,0:11:01.95,0:11:05.41,Default,,0,0,0,,Тез менің алдымнан сүйреңіз.
Dialogue: 0,0:11:06.08,0:11:10.33,Default,,0,0,0,,Бүгін кешкі асқа қайсысын алғыңыз келеді, ана ма, әлде Агата ма?
Dialogue: 0,0:11:10.41,0:11:12.29,Default,,0,0,0,,Эй, маған жауап бер.
Dialogue: 0,0:11:12.38,0:11:13.83,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:11:13.92,0:11:15.54,Default,,0,0,0,,Менің кетуден басқа амалым жоқ.
Dialogue: 0,0:11:15.63,0:11:17.80,Default,,0,0,0,,Бва! Мен дәл тиетіндей едім...
Dialogue: 0,0:11:30.52,0:11:33.90,Default,,0,0,0,,Әй, бұғы еді ғой.
Dialogue: 0,0:11:33.98,0:11:37.86,Default,,0,0,0,,Мүйіздерде қан бар шынымен балғын көрінеді ме?
Dialogue: 0,0:11:37.94,0:11:39.19,Default,,0,0,0,,Мигель мырза?
Dialogue: 0,0:11:39.94,0:11:44.41,Default,,0,0,0,,Мен бастығымның бұйрығын бұзып, ашкөздіктің жетегінде кеттім.
Dialogue: 0,0:11:44.49,0:11:47.91,Default,,0,0,0,,Артқы базарда сатып жүрген киікті жедім!
Dialogue: 0,0:11:48.45,0:11:52.08,Default,,0,0,0,,Мен сылтау айтпаймын. Менің қолымнан келмейді.
Dialogue: 0,0:11:52.75,0:11:56.67,Default,,0,0,0,,Жыртқыштар жай ғана ақымақ тіршілік иелері.
Dialogue: 0,0:11:57.55,0:11:58.75,Default,,0,0,0,,Міне!
Dialogue: 0,0:11:59.34,0:12:02.09,Default,,0,0,0,,Сіз жыртқыштар мен шөпқоректілердің қоспасысыз.
Dialogue: 0,0:12:02.17,0:12:04.47,Default,,0,0,0,,Бұл мінсіз тіршілік иесі, былайша айтқанда...
Dialogue: 0,0:12:05.18,0:12:07.72,Default,,0,0,0,,Мен қарапайым арыстанмын
Dialogue: 0,0:12:07.81,0:12:12.44,Default,,0,0,0,,Мен тіпті айына екі рет ет жеу деген қарапайым ережені ұстана алмадым.
Dialogue: 0,0:12:13.27,0:12:15.52,Default,,0,0,0,,Маған мүмкіндік берілсе...
Dialogue: 0,0:12:16.06,0:12:16.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:17.69,0:12:19.23,Default,,0,0,0,,Бұл жолы еттен бас тартыңыз...
Dialogue: 0,0:12:19.32,0:12:24.32,Default,,0,0,0,,Мен саған барынша жақын болуға, мінсіз жаратылысқа ұмтыламын.
Dialogue: 0,0:12:24.41,0:12:29.41,Default,,0,0,0,,Хмм, сен өз басыңды ақымақтықпен пайдаландың.
Dialogue: 0,0:12:32.25,0:12:35.75,Default,,0,0,0,,Мен кешкі ас ішуді жоспарлап едім, бірақ
Dialogue: 0,0:12:35.83,0:12:39.13,Default,,0,0,0,,Сіздің қарым-қатынасыңызды Яхья да білді.
Dialogue: 0,0:12:39.21,0:12:41.80,Default,,0,0,0,,Мұнда ұзақ тұрудың қажеті жоқ.
Dialogue: 0,0:12:45.93,0:12:46.68,Default,,0,0,0,,А…?
Dialogue: 0,0:12:47.72,0:12:51.93,Default,,0,0,0,,Ой! Хехе... Соңғы кездері ұмытшақ болып жүрмін.
Dialogue: 0,0:12:52.02,0:12:56.81,Default,,0,0,0,,Шөпқоректідей әлсіз жазасың.
Dialogue: 0,0:12:57.73,0:13:00.98,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:13:04.36,0:13:06.95,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:13:07.03,0:13:07.82,Default,,0,0,0,,Гах…
Dialogue: 0,0:13:07.91,0:13:12.20,Default,,0,0,0,,Сіз де білікті адам болуыңыз керек.
Dialogue: 0,0:13:12.29,0:13:14.25,Default,,0,0,0,,Хехе, осыншама.
Dialogue: 0,0:13:15.08,0:13:15.96,Default,,0,0,0,,(шу)
Dialogue: 0,0:13:16.04,0:13:17.29,Default,,0,0,0,,О
Dialogue: 0,0:13:19.04,0:13:20.67,Default,,0,0,0,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:13:21.42,0:13:23.26,Default,,0,0,0,,Рахмет айтпа
Dialogue: 0,0:13:23.34,0:13:25.84,Default,,0,0,0,,Мен жай ғана аянышты арыстан болғым келмейді.
Dialogue: 0,0:13:28.30,0:13:30.35,Default,,0,0,0,,Сіз Копи Лувакке барасыз ба?
Dialogue: 0,0:13:30.85,0:13:31.64,Default,,0,0,0,,О
Dialogue: 0,0:13:32.39,0:13:34.06,Default,,0,0,0,,Кинусқа қатысты
Dialogue: 0,0:13:34.14,0:13:36.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:43.19,0:13:44.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:47.24,0:13:51.41,Default,,0,0,0,,(Медициналық құрылғылардың электронды дыбыстары)
Dialogue: 0,0:13:52.12,0:13:54.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:04.59,0:14:07.76,Default,,0,0,0,,Түсіндім! Мені қауын атып алды
Dialogue: 0,0:14:08.43,0:14:11.18,Default,,0,0,0,,Бұл жерге әкелінді ме?
Dialogue: 0,0:14:11.26,0:14:11.80,Default,,0,0,0,,Уау
Dialogue: 0,0:14:13.68,0:14:15.14,Default,,0,0,0,,Содан мен
Dialogue: 0,0:14:17.52,0:14:18.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:32.28,0:14:36.75,Default,,0,0,0,,Өмір мен өлім арасында адасып жүргенім шығар?
Dialogue: 0,0:14:38.00,0:14:40.96,Default,,0,0,0,,Мен өлемін бе?
Dialogue: 0,0:14:42.63,0:14:45.84,Default,,0,0,0,,Ах~ Егер бұлай болатын болса, мен Хару-чанмен бірге боламын...
Dialogue: 0,0:14:46.55,0:14:49.26,Default,,0,0,0,,Мен Хару-чанды сүйіп алуым керек еді.
Dialogue: 0,0:14:49.34,0:14:51.97,Default,,0,0,0,,Ах... Хару-чан...
Dialogue: 0,0:14:52.80,0:14:55.47,Default,,0,0,0,,Менің өлгенімді білсең, жылайсың ба?
Dialogue: 0,0:14:56.14,0:14:58.52,Default,,0,0,0,,Жоқ, оның ашуланатынына сенімдімін.
Dialogue: 0,0:15:00.02,0:15:02.44,Default,,0,0,0,,(Легошидің күрсінуі)
Dialogue: 0,0:15:02.52,0:15:05.48,Default,,0,0,0,,Бас тартуға әлі ерте емес пе?
Dialogue: 0,0:15:05.57,0:15:08.15,Default,,0,0,0,,Жоқ, өйткені бұл қазірдің өзінде...
Dialogue: 0,0:15:08.99,0:15:09.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:13.78,0:15:14.62,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:15:18.58,0:15:20.12,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:15:22.88,0:15:24.08,Default,,0,0,0,,Мен қазір-
Dialogue: 0,0:15:24.84,0:15:28.76,Default,,0,0,0,,6 жыл бұрын қайтыс болған анасымен қайта қауышты
Dialogue: 0,0:15:28.84,0:15:31.68,Default,,0,0,0,,Сен есейдің, Легоси.
Dialogue: 0,0:15:33.51,0:15:35.35,Default,,0,0,0,,А, міне...
Dialogue: 0,0:15:38.56,0:15:39.81,Default,,0,0,0,,Сен ақымақ бала.
Dialogue: 0,0:15:39.89,0:15:43.98,Default,,0,0,0,,Мен үндемеуші едім, енді қауіпке секіремін.
Dialogue: 0,0:15:44.06,0:15:44.86,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:44.94,0:15:47.15,Default,,0,0,0,,Көп уайымдамаңыз
Dialogue: 0,0:15:47.23,0:15:48.48,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:49.15,0:15:50.86,Default,,0,0,0,,Қауын өзі туралы айтады
Dialogue: 0,0:15:50.94,0:15:54.16,Default,,0,0,0,,Мен оның «бөтен нысан» екенін қабылдай алмаймын.
Dialogue: 0,0:15:54.24,0:15:56.70,Default,,0,0,0,,Себебі менің анам да аралас.
Dialogue: 0,0:15:56.78,0:16:00.04,Default,,0,0,0,,Егер Хару-чан екеуміздің баламыз болса...
Dialogue: 0,0:16:00.12,0:16:02.04,Default,,0,0,0,,Ақыр аяғында бұл аралас.
Dialogue: 0,0:16:02.71,0:16:04.67,Default,,0,0,0,,Бала өзі туралы да ойлайды.
Dialogue: 0,0:16:05.25,0:16:08.00,Default,,0,0,0,,Қызық, сіз «бөтен затты» айтып тұрсыз ба?
Dialogue: 0,0:16:08.63,0:16:11.22,Default,,0,0,0,,Иә, бұл «бөтен нысан».
Dialogue: 0,0:16:12.55,0:16:13.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:20.81,0:16:24.31,Default,,0,0,0,,Бес күннен бері тамақ ішкен жоқсың.
Dialogue: 0,0:16:27.06,0:16:28.40,Default,,0,0,0,,(Яхьяның күрсінуі)
Dialogue: 0,0:16:29.57,0:16:32.32,Default,,0,0,0,,Сіздің атаңыз комодо айдаһары
Dialogue: 0,0:16:32.40,0:16:35.07,Default,,0,0,0,,Әже – сұр қасқыр
Dialogue: 0,0:16:35.16,0:16:38.12,Default,,0,0,0,,Мен сол екі жануардың арасында тудым.
Dialogue: 0,0:16:38.70,0:16:42.62,Default,,0,0,0,,Ерекше болғандықтан қандай ұсқынсыз жаратылыстар туады?
Dialogue: 0,0:16:43.25,0:16:45.87,Default,,0,0,0,,Жұртшылық қызық болды.
Dialogue: 0,0:16:47.50,0:16:49.67,Default,,0,0,0,,Өкінішке орай,
Dialogue: 0,0:16:49.75,0:16:52.63,Default,,0,0,0,,Мен әдемі қасқырға айналдым
Dialogue: 0,0:16:53.51,0:16:54.84,Default,,0,0,0,,Бұл есімде
Dialogue: 0,0:16:55.51,0:16:56.93,Default,,0,0,0,,Атам қырқып жатты.
Dialogue: 0,0:16:57.01,0:16:59.56,Default,,0,0,0,,Мен модель болған кезім
Dialogue: 0,0:16:59.64,0:17:01.77,Default,,0,0,0,,«Реано сұр қасқыр»
Dialogue: 0,0:17:01.85,0:17:03.52,Default,,0,0,0,,Бұл өте танымал болды.
Dialogue: 0,0:17:04.14,0:17:05.48,Default,,0,0,0,,Мен түсіндім деп ойлаймын.
Dialogue: 0,0:17:05.56,0:17:07.56,Default,,0,0,0,,Бұл ең танымал кезең болды.
Dialogue: 0,0:17:08.31,0:17:09.57,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:17:09.65,0:17:10.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:12.94,0:17:16.07,Default,,0,0,0,,Менің әкем Комодо айдаһары.
Dialogue: 0,0:17:16.16,0:17:18.74,Default,,0,0,0,,Мен ешкімге кешірім айта алмаймын
Dialogue: 0,0:17:20.62,0:17:22.75,Default,,0,0,0,,Ешқашан кешірім сұрама
Dialogue: 0,0:17:22.83,0:17:26.62,Default,,0,0,0,,Мен кесірткенің уын ойламай-ақ сендермен тамақты бөлісе аламын.
Dialogue: 0,0:17:27.17,0:17:29.21,Default,,0,0,0,,Бірге тамақтануға болады
Dialogue: 0,0:17:29.29,0:17:31.25,Default,,0,0,0,,Осының өзі мені бақытты етеді.
Dialogue: 0,0:17:31.96,0:17:33.59,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:17:35.34,0:17:37.51,Default,,0,0,0,,Мені шын жақсы көретін.
Dialogue: 0,0:17:39.26,0:17:41.64,Default,,0,0,0,,Бірақ мен үнемі қорқатынмын.
Dialogue: 0,0:17:42.35,0:17:44.81,Default,,0,0,0,,Өйткені менің денем
Dialogue: 0,0:17:44.89,0:17:47.69,Default,,0,0,0,,Оның тамырында комодо айдаһарының қаны бар.
Dialogue: 0,0:17:49.15,0:17:50.15,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:17:50.23,0:17:52.78,Default,,0,0,0,,♬~
Dialogue: 0,0:17:54.11,0:17:55.07,Default,,0,0,0,,Өзін жақсы сезінеді
Dialogue: 0,0:17:55.86,0:17:56.70,Default,,0,0,0,,Ах
Dialogue: 0,0:17:58.16,0:18:00.16,Default,,0,0,0,,(Реаноның айқайы)
Dialogue: 0,0:18:03.49,0:18:04.66,Default,,0,0,0,,Дәрігерге –
Dialogue: 0,0:18:04.75,0:18:08.92,Default,,0,0,0,,Жасқа тәуелді гендер сирек кездеседі.
Dialogue: 0,0:18:09.00,0:18:11.42,Default,,0,0,0,,Олар ештеңе істей алмайтынын айтты.
Dialogue: 0,0:18:13.96,0:18:15.80,Default,,0,0,0,,Уау, қарашы
Dialogue: 0,0:18:15.88,0:18:17.17,Default,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:18:17.76,0:18:19.05,Default,,0,0,0,,Алыс болыңыз
Dialogue: 0,0:18:19.80,0:18:21.30,Default,,0,0,0,,Өте лас
Dialogue: 0,0:18:21.97,0:18:24.18,Default,,0,0,0,,Бұл улы, оған қол тигізбе.
Dialogue: 0,0:18:24.26,0:18:26.02,Default,,0,0,0,,Бұл қауіпті, өлтіріңіз.
Dialogue: 0,0:18:28.06,0:18:29.31,Default,,0,0,0,,Өлу
Dialogue: 0,0:18:34.44,0:18:36.69,Default,,0,0,0,,Қасқыр да, кесіртке де емес
Dialogue: 0,0:18:37.24,0:18:38.11,Default,,0,0,0,,Иә
Dialogue: 0,0:18:38.74,0:18:43.37,Default,,0,0,0,,Бұл дүниеде мен есімсіз, жат жаратылыспын.
Dialogue: 0,0:18:45.87,0:18:47.25,Default,,0,0,0,,Бұл «бөтен нысан» болды
Dialogue: 0,0:18:49.62,0:18:50.67,Default,,0,0,0,,Және…
Dialogue: 0,0:18:55.30,0:19:00.26,Default,,0,0,0,,(қатысқандардың сенімі)
Dialogue: 0,0:19:08.77,0:19:10.85,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:19.65,0:19:21.86,Default,,0,0,0,,Мен өз-өзіме қол жұмсағанымның алдындағы түні.
Dialogue: 0,0:19:22.49,0:19:25.62,Default,,0,0,0,,Біраз уақыт бірге жаттық.
Dialogue: 0,0:19:27.33,0:19:30.58,Default,,0,0,0,,Кешіріңіз, мен ештеңе айтқан жоқпын.
Dialogue: 0,0:19:31.17,0:19:35.42,Default,,0,0,0,,Мен соңына дейін өзімшіл ана болдым.
Dialogue: 0,0:19:36.84,0:19:38.55,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:19:39.38,0:19:40.34,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:40.42,0:19:41.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:41.47,0:19:44.76,Default,,0,0,0,,Мен шынымен де сол кезде ояу едім.
Dialogue: 0,0:19:45.89,0:19:50.81,Default,,0,0,0,,Ананың таразы мен жүні өте әдемі болатын.
Dialogue: 0,0:19:50.89,0:19:53.81,Default,,0,0,0,,Иә... шынымен бе?
Dialogue: 0,0:19:53.90,0:19:55.69,Default,,0,0,0,,Мен сені сүйгім келді
Dialogue: 0,0:19:56.36,0:19:58.53,Default,,0,0,0,,Мен бұрылып сені құшақтағым келді.
Dialogue: 0,0:19:59.36,0:20:00.94,Default,,0,0,0,,Мен сенің мені ұстағаныңды қаладым
Dialogue: 0,0:20:01.90,0:20:06.37,Default,,0,0,0,,Өйткені ол менің бұл дүниедегі жалғыз анам.
Dialogue: 0,0:20:07.91,0:20:09.62,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,0:20:10.66,0:20:11.87,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:14.17,0:20:15.79,Default,,0,0,0,,Сол кезде мен...
Dialogue: 0,0:20:15.88,0:20:18.84,Default,,0,0,0,,Үндемеген жақсы, маған қарамаған жақсы
Dialogue: 0,0:20:18.92,0:20:21.13,Default,,0,0,0,,Мен анаңа жарайды деп ойладым.
Dialogue: 0,0:20:22.17,0:20:24.18,Default,,0,0,0,,Сіз осылай ойладыңыз ба?
Dialogue: 0,0:20:24.26,0:20:25.14,Default,,0,0,0,,Иә
Dialogue: 0,0:20:27.05,0:20:29.97,Default,,0,0,0,,Неге артыңа қарамадың?
Dialogue: 0,0:20:31.02,0:20:34.73,Default,,0,0,0,,Мама, ол кезде айтуыңыз керек еді.
Dialogue: 0,0:20:35.94,0:20:37.02,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:38.23,0:20:39.27,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:40.07,0:20:44.36,Default,,0,0,0,,Егер мен Легошидің сөздерін тыңдаған болсам, бәрі басқаша болуы мүмкін еді.
Dialogue: 0,0:20:45.36,0:20:48.78,Default,,0,0,0,,Бірақ мен енді өмірге қайта келе алмаймын
Dialogue: 0,0:20:49.45,0:20:50.54,Default,,0,0,0,,Сонымен—
Dialogue: 0,0:20:50.62,0:20:54.92,Default,,0,0,0,,Уайымдап, қиналған Микске айқайлаңыз.
Dialogue: 0,0:20:55.50,0:20:56.88,Default,,0,0,0,,Сіздің сөздеріңіз
Dialogue: 0,0:20:57.75,0:20:59.63,Default,,0,0,0,,Менің сөздерім...
Dialogue: 0,0:20:59.71,0:21:02.63,Default,,0,0,0,,Иә, сіздің сөздеріңіз
Dialogue: 0,0:21:02.71,0:21:04.88,Default,,0,0,0,,Денеңізде көптеген тыртықтар
Dialogue: 0,0:21:05.51,0:21:09.18,Default,,0,0,0,,Олардың әрқайсысы сіздің сөзіңіз.
Dialogue: 0,0:21:11.39,0:21:12.64,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:14.77,0:21:17.15,Default,,0,0,0,,Мен не істегім келетінін білемін.
Dialogue: 0,0:21:18.65,0:21:20.48,Default,,0,0,0,,Легошиді ұмытпаңыз
Dialogue: 0,0:21:21.69,0:21:24.32,Default,,0,0,0,,Атам екеуміздің қанымызсыңдар.
Dialogue: 0,0:21:24.40,0:21:27.53,Default,,0,0,0,,Сіз басқалардан күшті және мейірімді бола аласыз
Dialogue: 0,0:21:28.78,0:21:30.24,Default,,0,0,0,,Мен мұны істей аламын ба?
Dialogue: 0,0:21:31.66,0:21:32.74,Default,,0,0,0,,Легоши
Dialogue: 0,0:21:33.58,0:21:34.91,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:21:40.25,0:21:41.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:43.13,0:21:44.38,Default,,0,0,0,,(Таңданған екі дауыс)
Dialogue: 0,0:21:45.55,0:21:47.18,Default,,0,0,0,,Легоши...?
Dialogue: 0,0:22:00.23,0:22:07.20,Default,,0,0,0,,(Легошидің айқайы)
Dialogue: 0,0:22:11.99,0:22:13.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.54,0:23:41.54,Default,,0,0,0,,～♪
