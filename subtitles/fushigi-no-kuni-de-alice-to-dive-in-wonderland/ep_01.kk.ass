Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:58.35,0:01:00.27,Default,,0,0,0,,Иә, келді, келді.
Dialogue: 0,0:01:00.62,0:01:02.11,Default,,0,0,0,,Әдеттегідей рахмет
Dialogue: 0,0:01:03.26,0:01:05.85,Default,,0,0,0,,Бірақ өте көп
Dialogue: 0,0:01:05.85,0:01:08.75,Default,,0,0,0,,Жеуге болмайтын нәрсені досыңызға беріңіз.
Dialogue: 0,0:01:08.75,0:01:10.34,Default,,0,0,0,,Иә иә аламын
Dialogue: 0,0:01:11.64,0:01:13.19,Default,,0,0,0,,Келесі 49 күн
Dialogue: 0,0:01:13.49,0:01:14.53,Default,,0,0,0,,Мен келе аламын деп ойлаймын
Dialogue: 0,0:01:14.53,0:01:16.24,Default,,0,0,0,,Менің ойымша, бұл жақсы шығар.
Dialogue: 0,0:01:16.52,0:01:19.92,Default,,0,0,0,,Аа, дұрыс, мен осы аптада әжемнің үйіне барамын.
Dialogue: 0,0:01:21.97,0:01:25.14,Default,,0,0,0,,Соңғы сұхбат аяқталды.
Dialogue: 0,0:01:25.14,0:01:27.56,Default,,0,0,0,,Бұл Чи әжей ме?
Dialogue: 0,0:01:28.84,0:01:31.02,Default,,0,0,0,,Иә, мен уәде бердім.
Dialogue: 0,0:01:32.96,0:01:34.32,Default,,0,0,0,,Эй, міне.
Dialogue: 0,0:01:34.87,0:01:36.43,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:01:36.43,0:01:37.54,Default,,0,0,0,,Рахмет
Dialogue: 0,0:01:40.38,0:01:42.13,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:01:42.73,0:01:45.59,Default,,0,0,0,,Толығымен ымыраға келу өнімі.
Dialogue: 0,0:01:45.59,0:01:48.50,Default,,0,0,0,,О, бұл өте жомарт мәлімдеме.
Dialogue: 0,0:01:48.50,0:01:50.06,Default,,0,0,0,,Бұл менің ата-анамның үйінен.
Dialogue: 0,0:01:50.06,0:01:51.36,Default,,0,0,0,,Ал оның Регалияларының көбі шын мәнінде Нора болып шықты.
Dialogue: 0,0:01:51.36,0:01:52.88,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:01:56.23,0:01:57.35,Default,,0,0,0,,Тәтті
Dialogue: 0,0:01:57.76,0:01:59.30,Default,,0,0,0,,Қаласаңыз, үйге апарыңыз.
Dialogue: 0,0:01:59.66,0:02:01.17,Default,,0,0,0,,Өйткені мен оның бәрін жей алмаймын
Dialogue: 0,0:02:01.51,0:02:04.22,Default,,0,0,0,,Менде пышақ жоқ.
Dialogue: 0,0:02:04.22,0:02:06.06,Default,,0,0,0,,Үйге апару үшін қабығын аршыңыз.
Dialogue: 0,0:02:06.06,0:02:07.27,Default,,0,0,0,,Бала?
Dialogue: 0,0:02:07.27,0:02:09.70,Default,,0,0,0,,Себебі Көтерілу өте мейірімді.
Dialogue: 0,0:02:09.70,0:02:11.95,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:02:14.49,0:02:15.78,Default,,0,0,0,,Бұл дәмді
Dialogue: 0,0:02:15.78,0:02:17.05,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:02:17.05,0:02:19.87,Default,,0,0,0,,Слайстағы Юрий оны Пенстада ұсынды.
Dialogue: 0,0:02:20.07,0:02:21.86,Default,,0,0,0,,2 сағат күте отырып сақтаңыз
Dialogue: 0,0:02:23.90,0:02:25.14,Default,,0,0,0,,Шинигаминің көздерін алу үшін,
Dialogue: 0,0:02:25.14,0:02:26.37,Default,,0,0,0,,«Ұнату»
Dialogue: 0,0:02:26.37,0:02:27.51,Default,,0,0,0,,Мен де
Dialogue: 0,0:02:28.49,0:02:30.09,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:02:32.30,0:02:33.72,Default,,0,0,0,,Дәмді
Dialogue: 0,0:02:35.02,0:02:37.76,Default,,0,0,0,,Мен оның тезірек, кез келген жерде шешілгенін қалаймын.
Dialogue: 0,0:02:37.76,0:02:38.60,Default,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:02:38.60,0:02:41.16,Default,,0,0,0,,Жазба парағы Қанша жаздыңыз?
Dialogue: 0,0:02:41.85,0:02:44.07,Default,,0,0,0,,Жақсы ірі компания
Dialogue: 0,0:02:44.07,0:02:46.38,Default,,0,0,0,,«Жұмыс іздеуші Кэрриге» қарап
Dialogue: 0,0:02:46.38,0:02:47.91,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:50.01,0:02:52.11,Default,,0,0,0,,Бәріңе сәлем.
Dialogue: 0,0:02:52.11,0:02:53.47,Default,,0,0,0,,Кэрри
Dialogue: 0,0:02:54.14,0:02:58.00,Default,,0,0,0,,Мен, Кэрри, өте танымал компаниялардан бірнеше жұмыс ұсыныстарын алған...
Dialogue: 0,0:02:57.53,0:03:01.43,Default,,0,0,0,,Егер мен Кэрри айтқандай істесем, мен де жұмысқа ұсыныс алдым.
Dialogue: 0,0:03:01.43,0:03:02.48,Default,,0,0,0,,Шынымен
Dialogue: 0,0:03:06.01,0:03:07.02,Default,,0,0,0,,Оған дейін
Dialogue: 0,0:03:07.02,0:03:08.56,Default,,0,0,0,,Сіз өте адалсыз.
Dialogue: 0,0:03:09.03,0:03:11.19,Default,,0,0,0,,Мен мұның бәрін жасадым.
Dialogue: 0,0:03:11.19,0:03:13.34,Default,,0,0,0,,Маған ренжі
Dialogue: 0,0:03:15.30,0:03:18.64,Default,,0,0,0,,Қатты тырыспаңыз және доңғалақ жарылып қалмаңыз.
Dialogue: 0,0:03:18.64,0:03:21.95,Default,,0,0,0,,Дұрыс, маған да үзіліс керек.
Dialogue: 0,0:03:21.95,0:03:23.64,Default,,0,0,0,,Бүгін мереке, ендеше ішейік.
Dialogue: 0,0:03:24.58,0:03:26.16,Default,,0,0,0,,Бұл пицца дәмді
Dialogue: 0,0:03:26.16,0:03:28.90,Default,,0,0,0,,Оны қайдан сатып алдыңыз? Бұл сондай шайнау
Dialogue: 0,0:03:57.25,0:03:59.16,Default,,0,0,0,,Чиккишо
Dialogue: 0,0:04:14.73,0:04:18.36,Default,,0,0,0,,Емдеу құралдары…дәрмендер…дәрілер…
Dialogue: 0,0:04:18.36,0:04:22.03,Default,,0,0,0,,Емдеу құралдары…дәрмендер…дәрілер…
Dialogue: 0,0:04:42.13,0:04:44.18,Default,,0,0,0,,Мен тыныс алуды ұмытып кеттім
Dialogue: 0,0:05:15.23,0:05:17.84,Default,,0,0,0,,Кагами жақын арада Бұл Кагами
Dialogue: 0,0:05:18.58,0:05:22.09,Default,,0,0,0,,2-платформаға келу Шығу сол жақта
Dialogue: 0,0:05:22.59,0:05:26.00,Default,,0,0,0,,Пойыздан түскенде ештеңе қалдырмаңыз.
Dialogue: 0,0:05:26.60,0:05:29.35,Default,,0,0,0,,Кагамиден кейін біз Фудисироға тоқтаймыз.
Dialogue: 0,0:06:02.88,0:06:03.92,Default,,0,0,0,,Урай мырза
Dialogue: 0,0:06:07.37,0:06:10.39,Default,,0,0,0,,Бүгінгі қарбалас жұмыстарыңыз үшін рахмет.
Dialogue: 0,0:06:10.81,0:06:12.31,Default,,0,0,0,,Бұл әжеге арналған
Dialogue: 0,0:06:12.88,0:06:14.68,Default,,0,0,0,,Төраға риза болады.
Dialogue: 0,0:06:15.32,0:06:18.51,Default,,0,0,0,,Сіз біраз уақыттан бері осы жобаға назар аудардыңыз.
Dialogue: 0,0:06:22.31,0:06:26.24,Default,,0,0,0,,Әже «Алиса ғажайыптар елінде» фильмін қатты жақсы көретін.
Dialogue: 0,0:06:26.78,0:06:30.16,Default,,0,0,0,,Иә, сізде ерекше естеліктер болды.
Dialogue: 0,0:06:31.78,0:06:36.29,Default,,0,0,0,,Парк ашылғанға дейін оны көре алмағаныңызға өкінетініңізге сенімдімін.
Dialogue: 0,0:06:37.47,0:06:38.10,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:39.67,0:06:43.22,Default,,0,0,0,,Соңына дейін барынша дайындалыңыз.
Dialogue: 0,0:06:43.22,0:06:47.50,Default,,0,0,0,,Тек сынақ қана қалғанша аяқталды.
Dialogue: 0,0:07:06.96,0:07:08.16,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:07:08.47,0:07:10.34,Default,,0,0,0,,Урай мырза, енді не істейсіз?
Dialogue: 0,0:07:10.99,0:07:12.74,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:07:17.98,0:07:20.30,Default,,0,0,0,,Төрағаның қалауына сәйкес
Dialogue: 0,0:07:20.30,0:07:23.93,Default,,0,0,0,,Әже күткендей, сіз бұл туралы дұрыс ойлап отырсыз.
Dialogue: 0,0:07:24.43,0:07:25.76,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:07:26.18,0:07:27.59,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:07:27.59,0:07:30.66,Default,,0,0,0,,Сен маған сол жасырын мұра туралы айттың...
Dialogue: 0,0:07:31.14,0:07:32.10,Default,,0,0,0,,Әрине...
Dialogue: 0,0:07:32.42,0:07:33.39,Default,,0,0,0,,№
Dialogue: 0,0:07:36.66,0:07:41.35,Default,,0,0,0,,Сіз Риздің өз жолын кесуге құқығы бар дедіңіз.
Dialogue: 0,0:07:41.57,0:07:45.36,Default,,0,0,0,,Мен білемін. Мен оны бала кезімнен естідім.
Dialogue: 0,0:07:46.30,0:07:49.81,Default,,0,0,0,,Мұрагым болса, жұмыс іздемес едім.
Dialogue: 0,0:07:50.56,0:07:54.32,Default,,0,0,0,,Мен әлем ондай емес екенін білемін.
Dialogue: 0,0:07:55.04,0:07:58.17,Default,,0,0,0,,Төрағаның барлық жеке мүлкі реттелді.
Dialogue: 0,0:07:58.17,0:08:00.14,Default,,0,0,0,,Қорға толығымен берілді
Dialogue: 0,0:08:00.88,0:08:04.08,Default,,0,0,0,,А, онда мені сол қорға жұмысқа ала аласыз ба?
Dialogue: 0,0:08:04.08,0:08:08.01,Default,,0,0,0,,Кешіріңіз, бірақ жаңа түлектерді жұмысқа алу жоспарда жоқ.
Dialogue: 0,0:08:08.38,0:08:12.38,Default,,0,0,0,,Мен Райске алдағы жұмыстарына сәттілік тілеймін.
Dialogue: 0,0:08:14.08,0:08:16.68,Default,,0,0,0,,Урай мырза, мұндай нәрсе.
Dialogue: 0,0:08:21.45,0:08:23.66,Default,,0,0,0,,Сіз мұны басқалар сияқты істеп жатырсыз.
Dialogue: 0,0:08:24.02,0:08:25.70,Default,,0,0,0,,Жақсы емес, солай ма?
Dialogue: 0,0:08:38.26,0:08:41.37,Default,,0,0,0,,Мен бүгін осының бәрін ұмытқым келгендіктен келдім.
Dialogue: 0,0:08:41.37,0:08:43.42,Default,,0,0,0,,Мен сенің көңіл-күйіңді өзгертейін.
Dialogue: 0,0:08:43.42,0:08:44.58,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:08:54.21,0:08:54.83,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:08:55.61,0:08:56.44,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:01.30,0:09:02.95,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:09:02.95,0:09:04.07,Default,,0,0,0,,онда Цуки-кунге қатысты күдік мүлде сейіледі.
Dialogue: 0,0:09:04.53,0:09:06.66,Default,,0,0,0,,Бас ғимаратқа барамыз ба?
Dialogue: 0,0:09:11.40,0:09:14.35,Default,,0,0,0,,Бұл аймақ гүлге толы болады.
Dialogue: 0,0:09:14.87,0:09:17.08,Default,,0,0,0,,Сондай-ақ биік таулы көкөністер мен жемістерді өсіреміз.
Dialogue: 0,0:09:17.67,0:09:21.81,Default,,0,0,0,,Әр мезгілдің жемісін сезе білсең, жүрегің рахаттанады.
Dialogue: 0,0:09:22.81,0:09:26.79,Default,,0,0,0,,«Топырақты ұмытпа» - президенттің жақсы көретін сөзі болды.
Dialogue: 0,0:09:33.62,0:09:34.85,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:09:34.85,0:09:36.17,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:09:36.45,0:09:37.08,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:44.47,0:09:45.52,Default,,0,0,0,,Ішке кіріңіз.
Dialogue: 0,0:09:53.51,0:09:54.67,Default,,0,0,0,,Керемет
Dialogue: 0,0:10:00.95,0:10:02.81,Default,,0,0,0,,Ах, ақ қоян
Dialogue: 0,0:10:10.13,0:10:11.86,Default,,0,0,0,,Сіз суретке түсіре аласыз.
Dialogue: 0,0:10:11.86,0:10:14.25,Default,,0,0,0,,Сіз оны сыртқа шығармасаңыз, еркіндікке ие болыңыз.
Dialogue: 0,0:10:14.59,0:10:15.62,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:45.37,0:10:47.08,Default,,0,0,0,,Бұл бөлме.
Dialogue: 0,0:10:51.79,0:10:52.58,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:11:02.29,0:11:05.46,Default,,0,0,0,,Ғажайыптар әлемінің сынақ мониторы болу тарихына қатысты.
Dialogue: 0,0:11:05.46,0:11:06.96,Default,,0,0,0,,Сіз тыңдап отырсыз.
Dialogue: 0,0:11:07.25,0:11:07.93,Default,,0,0,0,,Иә
Dialogue: 0,0:11:08.30,0:11:10.61,Default,,0,0,0,,Толық масштабты ашу алдында сынақ
Dialogue: 0,0:11:10.61,0:11:12.01,Default,,0,0,0,,сияқты нәрсе, солай ма?
Dialogue: 0,0:11:12.01,0:11:13.59,Default,,0,0,0,,Қош бол
Dialogue: 0,0:11:16.39,0:11:18.26,Default,,0,0,0,,Қандай аттракциондар бар?
Dialogue: 0,0:11:18.26,0:11:19.52,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:11:21.41,0:11:23.28,Default,,0,0,0,,Бұл мүлде мүмкін емес
Dialogue: 0,0:11:23.93,0:11:24.96,Default,,0,0,0,,Маған аздап айтып беріңізші
Dialogue: 0,0:11:26.28,0:11:27.83,Default,,0,0,0,,Басы кесілген
Dialogue: 0,0:11:28.96,0:11:29.67,Default,,0,0,0,,Иә
Dialogue: 0,0:11:34.20,0:11:35.04,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:11:38.10,0:11:40.39,Default,,0,0,0,,Енді бастайық.
Dialogue: 0,0:11:43.84,0:11:47.25,Default,,0,0,0,,Бұдан былай бұл құрылғыны құлағыңызға салыңыз.
Dialogue: 0,0:11:47.25,0:11:49.98,Default,,0,0,0,,Біз сені ғажайып елге саяхатқа апарамыз.
Dialogue: 0,0:11:50.17,0:11:54.49,Default,,0,0,0,,Құрылғы танылса, құрылғы автоматты түрде іске қосылады
Dialogue: 0,0:11:55.04,0:11:57.52,Default,,0,0,0,,Біраз уақыттан кейін нұсқаулық пайда болады.
Dialogue: 0,0:11:57.52,0:11:59.83,Default,,0,0,0,,Кіру үшін нұсқауларды орындаңыз
Dialogue: 0,0:12:00.55,0:12:02.17,Default,,0,0,0,,Суға батыру сезіміне жету
Dialogue: 0,0:12:02.17,0:12:06.26,Default,,0,0,0,,Оны қайтып келгенше киюді ұсынамыз.
Dialogue: 0,0:12:06.68,0:12:08.29,Default,,0,0,0,,Оны алып тастасам не болады?
Dialogue: 0,0:12:08.61,0:12:09.37,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:12:09.37,0:12:10.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:13.18,0:12:15.00,Default,,0,0,0,,Жарайды, мен оны жоймаймын.
Dialogue: 0,0:12:17.53,0:12:19.13,Default,,0,0,0,,Уақытыңызды бөліңіз
Dialogue: 0,0:12:45.07,0:12:45.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:52.25,0:12:53.38,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:11.27,0:13:12.32,Default,,0,0,0,,Асығу керек Асығу керек
Dialogue: 0,0:13:12.32,0:13:13.84,Default,,0,0,0,,Менің уақытым жоқ.
Dialogue: 0,0:13:13.84,0:13:15.58,Default,,0,0,0,,бос емес, бос емес
Dialogue: 0,0:13:15.58,0:13:17.16,Default,,0,0,0,,Мен бір секундты да босқа өткізгім келмейді...
Dialogue: 0,0:13:16.42,0:13:18.03,Default,,0,0,0,,А...мм...
Dialogue: 0,0:13:17.16,0:13:18.77,Default,,0,0,0,,Неге бос емессің...
Dialogue: 0,0:13:19.86,0:13:21.66,Default,,0,0,0,,А...мм...
Dialogue: 0,0:13:21.97,0:13:25.74,Default,,0,0,0,,Мүмкін сіз гид шығарсыз?
Dialogue: 0,0:13:25.74,0:13:28.20,Default,,0,0,0,,Аа, менің уақытым жоқ.
Dialogue: 0,0:13:28.20,0:13:29.90,Default,,0,0,0,,Қоянның өмір сүру ұзақтығы 10 жыл болса.
Dialogue: 0,0:13:29.90,0:13:31.56,Default,,0,0,0,,Уақыт бойынша небәрі 520 апта
Dialogue: 0,0:13:31.56,0:13:35.39,Default,,0,0,0,,Басқаша айтқанда, бар болғаны 315 619 200 секунд бар.
Dialogue: 0,0:13:35.69,0:13:36.71,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:13:36.94,0:13:38.92,Default,,0,0,0,,Кібісе 3 жыл болады деп болжануда.
Dialogue: 0,0:13:39.16,0:13:39.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:40.81,0:13:43.35,Default,,0,0,0,,Сіз қазіргі реакцияңызбен 10 секундты босқа жібердіңіз.
Dialogue: 0,0:13:43.35,0:13:44.42,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:13:44.42,0:13:46.06,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:13:46.54,0:13:47.66,Default,,0,0,0,,Сіздің атыңыз
Dialogue: 0,0:13:47.66,0:13:50.20,Default,,0,0,0,,Ах...Мен Риз Азуминомын.
Dialogue: 0,0:13:50.20,0:13:52.04,Default,,0,0,0,,Мұнда бірінші рет келу
Dialogue: 0,0:13:52.04,0:13:52.44,Default,,0,0,0,,Иә
Dialogue: 0,0:13:52.44,0:13:53.64,Default,,0,0,0,,Туған күні
Dialogue: 0,0:13:53.64,0:13:54.51,Default,,0,0,0,,2003…
Dialogue: 0,0:13:54.51,0:13:55.67,Default,,0,0,0,,Тез жауап беріңіз
Dialogue: 0,0:13:55.67,0:13:57.51,Default,,0,0,0,,30 қазан 2003 ж
Dialogue: 0,0:13:57.51,0:13:59.74,Default,,0,0,0,,Сіздің сүйікті түсіңіз қандай? Сіздің сүйікті тағамыңыз қандай?
Dialogue: 0,0:14:00.20,0:14:01.91,Default,,0,0,0,,Мм... көк?
Dialogue: 0,0:14:02.34,0:14:04.50,Default,,0,0,0,,Жоқ, сары... мүмкін
Dialogue: 0,0:14:03.68,0:14:04.50,Default,,0,0,0,,​​Қайсысы?
Dialogue: 0,0:14:04.89,0:14:06.57,Default,,0,0,0,,Тамақ көп
Dialogue: 0,0:14:06.57,0:14:07.24,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:14:07.24,0:14:09.32,Default,,0,0,0,,Мен бірден жауап бере алмаймын деп ойлаймын.
Dialogue: 0,0:14:08.13,0:14:08.84,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:14:09.32,0:14:10.80,Default,,0,0,0,,Ал, сенің сүйікті сөзің қандай?
Dialogue: 0,0:14:11.05,0:14:12.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:12.41,0:14:13.87,Default,,0,0,0,,Мен не істегім келеді
Dialogue: 0,0:14:13.87,0:14:15.70,Default,,0,0,0,,Ең маңыздысы
Dialogue: 0,0:14:15.70,0:14:17.50,Default,,0,0,0,,Бірден айтсаң да...
Dialogue: 0,0:14:18.85,0:14:20.17,Default,,0,0,0,,Мен Тайпаны білемін.
Dialogue: 0,0:14:20.17,0:14:22.50,Default,,0,0,0,,Уақыт өнімділігі Уақыт тиімділігі
Dialogue: 0,0:14:22.50,0:14:24.09,Default,,0,0,0,,Маған тез жауап беруіңіз керек.
Dialogue: 0,0:14:24.09,0:14:28.17,Default,,0,0,0,,Мен Pensta-ны 2 есе жылдамдықпен танымал аниме мен драмаларды тексеріп отырып көрдім.
Dialogue: 0,0:14:28.17,0:14:31.92,Default,,0,0,0,,Менің қолданбаларда ойын ойнауға және манга оқуға уақытым жоқ.
Dialogue: 0,0:14:31.92,0:14:32.61,Default,,0,0,0,,Тайпа…
Dialogue: 0,0:14:32.61,0:14:34.47,Default,,0,0,0,,Кел, тез, тез
Dialogue: 0,0:14:35.06,0:14:37.02,Default,,0,0,0,,Сұрақ Бұл не?
Dialogue: 0,0:14:37.02,0:14:37.70,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:40.35,0:14:42.67,Default,,0,0,0,,Сіз ұрысты сатып жатырсыз.
Dialogue: 0,0:14:49.95,0:14:51.71,Default,,0,0,0,,Иә, бұл сұрақтар үшін.
Dialogue: 0,0:14:51.71,0:14:53.60,Default,,0,0,0,,Енді менің жұмысым аяқталды
Dialogue: 0,0:14:53.60,0:14:57.32,Default,,0,0,0,,Қарғыс атқыр... маған 7 минут 20 секунд кетті.
Dialogue: 0,0:14:58.58,0:14:59.96,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:15:00.16,0:15:00.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:05.87,0:15:07.04,Default,,0,0,0,,Қандай... улы алма
Dialogue: 0,0:15:07.04,0:15:08.84,Default,,0,0,0,,Жоқ, бұл менің смартфоным.
Dialogue: 0,0:15:08.84,0:15:09.70,Default,,0,0,0,,Жоқ, бұл біртүрлі.
Dialogue: 0,0:15:09.70,0:15:11.18,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:15:11.39,0:15:13.71,Default,,0,0,0,,Менің уақытым жоқ
Dialogue: 0,0:15:13.71,0:15:15.27,Default,,0,0,0,,Мен мұны патшайымға жеткізуім керек.
Dialogue: 0,0:15:15.27,0:15:16.19,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:15:16.52,0:15:18.34,Default,,0,0,0,,Әй, бос емес, бос емес
Dialogue: 0,0:15:18.69,0:15:20.55,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:15:19.00,0:15:20.23,Default,,0,0,0,,Менің смартфоным...
Dialogue: 0,0:15:28.17,0:15:30.78,Default,,0,0,0,,Иә, сәл күте тұрыңыз.
Dialogue: 0,0:16:25.17,0:16:27.94,Default,,0,0,0,,Бас кесуші?
Dialogue: 0,0:16:28.39,0:16:30.26,Default,,0,0,0,,бос емес
Dialogue: 0,0:16:30.26,0:16:31.99,Default,,0,0,0,,Мен оны патшайымға тез жеткізуім керек.
Dialogue: 0,0:16:31.99,0:16:34.10,Default,,0,0,0,,Аа, менің уақытым жоқ.
Dialogue: 0,0:16:34.10,0:16:35.14,Default,,0,0,0,,Егер сіз оны патшайымға жеткізсеңіз...
Dialogue: 0,0:16:34.86,0:16:36.68,Default,,0,0,0,,Қайтарыңыз
Dialogue: 0,0:16:35.14,0:16:37.22,Default,,0,0,0,,Осыдан кейін мен екі семинарға қатыстым...
Dialogue: 0,0:16:37.74,0:16:39.35,Default,,0,0,0,,Бұл алма емес.
Dialogue: 0,0:16:39.35,0:16:40.96,Default,,0,0,0,,Бұл менің смартфоным.
Dialogue: 0,0:16:40.96,0:16:42.11,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:16:42.11,0:16:43.52,Default,,0,0,0,,Е...жоқ
Dialogue: 0,0:16:43.52,0:16:44.67,Default,,0,0,0,,Аа, менің уақытым жоқ.
Dialogue: 0,0:16:44.67,0:16:45.96,Default,,0,0,0,,Егер бұл орын алса, ваннада пісіріңіз.
Dialogue: 0,0:16:45.96,0:16:47.68,Default,,0,0,0,,Дәретханада тамақ ішіп, жаттығу кезінде...
Dialogue: 0,0:16:49.41,0:16:51.39,Default,,0,0,0,,Не?
Dialogue: 0,0:17:03.50,0:17:05.50,Default,,0,0,0,,Мынау...
Dialogue: 0,0:17:05.50,0:17:06.24,Default,,0,0,0,,Эй
Dialogue: 0,0:17:06.24,0:17:06.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:07.54,0:17:08.66,Default,,0,0,0,,Ал қазір, шын мәнінде, өте жақсы сезімдемін
Dialogue: 0,0:17:09.56,0:17:11.56,Default,,0,0,0,,Бассаң, өлесің.
Dialogue: 0,0:17:14.28,0:17:17.77,Default,,0,0,0,,Бүгін құлағыңыздың көңіл-күйі нашар ма?
Dialogue: 0,0:17:18.27,0:17:21.02,Default,,0,0,0,,Сіз сондай кішкентай болуыңыз керек.
Dialogue: 0,0:17:21.40,0:17:23.08,Default,,0,0,0,,Бұл біртүрлі, солай емес пе?
Dialogue: 0,0:17:23.08,0:17:26.65,Default,,0,0,0,,Үстел үстіндегі сусынды ішкенде денем жиырылып қалды.
Dialogue: 0,0:17:27.53,0:17:30.17,Default,,0,0,0,,Мен сен туралы білемін
Dialogue: 0,0:17:30.52,0:17:32.66,Default,,0,0,0,,Және қалай оралуға болады
Dialogue: 0,0:17:32.87,0:17:33.75,Default,,0,0,0,,Рас
Dialogue: 0,0:17:37.49,0:17:39.33,Default,,0,0,0,,Маған не істеу керектігін айтыңыз
Dialogue: 0,0:17:39.33,0:17:40.35,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:17:43.04,0:17:44.32,Default,,0,0,0,,Қараңдаршы, бұл жерде болды.
Dialogue: 0,0:17:47.36,0:17:48.85,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:17:52.41,0:17:53.35,Default,,0,0,0,,Бұл торт.
Dialogue: 0,0:17:54.06,0:17:56.58,Default,,0,0,0,,Мен оны суретті кітаптан оқыдым.
Dialogue: 0,0:17:57.14,0:17:59.20,Default,,0,0,0,,Осы тортты жегенде...
Dialogue: 0,0:17:59.51,0:18:01.81,Default,,0,0,0,,Ол үлкейе ме, кішірейе ме?
Dialogue: 0,0:18:02.25,0:18:03.95,Default,,0,0,0,,Байқауға болатын қызықты нәрселер
Dialogue: 0,0:18:09.66,0:18:11.02,Default,,0,0,0,,Дәмді
Dialogue: 0,0:18:18.98,0:18:20.03,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:21.05,0:18:22.48,Default,,0,0,0,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,0:18:23.89,0:18:24.76,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:25.07,0:18:27.21,Default,,0,0,0,,Қайтып оралғаныңыз жақсы болды.
Dialogue: 0,0:18:27.66,0:18:30.15,Default,,0,0,0,,Бірақ біртүрлі оқиғадан кейін
Dialogue: 0,0:18:30.15,0:18:32.34,Default,,0,0,0,,Айқын болу қызықсыз.
Dialogue: 0,0:18:32.69,0:18:34.47,Default,,0,0,0,,Сіз де олай ойламайсыз.
Dialogue: 0,0:18:35.17,0:18:36.72,Default,,0,0,0,,Түпнұсқа…
Dialogue: 0,0:18:38.20,0:18:39.61,Default,,0,0,0,,Мен шынмын ба?
Dialogue: 0,0:18:40.06,0:18:41.59,Default,,0,0,0,,Сосын жалғандары да бар.
Dialogue: 0,0:18:42.14,0:18:45.01,Default,,0,0,0,,Бұл қызықты оқиға сияқты.
Dialogue: 0,0:18:45.87,0:18:47.58,Default,,0,0,0,,Сіз Алисасыз ба?
Dialogue: 0,0:18:48.08,0:18:49.44,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:18:49.88,0:18:51.25,Default,,0,0,0,,Атақты
Dialogue: 0,0:18:51.92,0:18:52.78,Default,,0,0,0,,Қызық екен
Dialogue: 0,0:18:53.39,0:18:56.70,Default,,0,0,0,,Менің атымды сұра, мен оны өзім айтпаймын
Dialogue: 0,0:18:57.23,0:18:59.05,Default,,0,0,0,,Түсіндім, кешіріңіз.
Dialogue: 0,0:18:59.62,0:19:02.20,Default,,0,0,0,,Менің атым Райз Азумино.
Dialogue: 0,0:19:02.45,0:19:04.15,Default,,0,0,0,,Көтерілу...?
Dialogue: 0,0:19:04.66,0:19:05.85,Default,,0,0,0,,Көтерілу жақсы.
Dialogue: 0,0:19:05.85,0:19:07.46,Default,,0,0,0,,Көтерілу қайдан пайда болды?
Dialogue: 0,0:19:10.20,0:19:12.12,Default,,0,0,0,,«Алыс» болуы мүмкін бе?
Dialogue: 0,0:19:13.73,0:19:15.46,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:19:15.79,0:19:16.52,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:17.22,0:19:21.23,Default,,0,0,0,,Мен үшін маңызды нәрсені ақ қоян алып кетті.
Dialogue: 0,0:19:21.51,0:19:23.28,Default,,0,0,0,,Мен оны іздеуім керек...
Dialogue: 0,0:19:23.28,0:19:24.86,Default,,0,0,0,,Не маңызды?
Dialogue: 0,0:19:24.86,0:19:26.90,Default,,0,0,0,,Енді бұл алма...
Dialogue: 0,0:19:27.46,0:19:28.65,Default,,0,0,0,,Apple?
Dialogue: 0,0:19:30.55,0:19:33.74,Default,,0,0,0,,Эй, шар, бұл таңқаларлық емес.
Dialogue: 0,0:19:33.74,0:19:34.55,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:19:39.89,0:19:40.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:41.49,0:19:43.24,Default,,0,0,0,,Бұл қауіпті...
Dialogue: 0,0:19:43.24,0:19:47.50,Default,,0,0,0,,Мүмкін Балон мырза да торт жеген шығар?
Dialogue: 0,0:19:47.50,0:19:48.58,Default,,0,0,0,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:19:56.94,0:19:58.09,Default,,0,0,0,,Бұл жақсы емес сияқты
Dialogue: 0,0:19:59.63,0:20:00.85,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:20:00.85,0:20:01.96,Default,,0,0,0,,Сыртқа шығайық
Dialogue: 0,0:20:08.24,0:20:09.98,Default,,0,0,0,,үшін құлыптаулы болды.
Dialogue: 0,0:20:09.98,0:20:10.65,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:20:11.15,0:20:14.28,Default,,0,0,0,,Көтерілмес бұрын мен бәрін сынап көрдім.
Dialogue: 0,0:20:14.28,0:20:15.65,Default,,0,0,0,,Басқа шығулар
Dialogue: 0,0:20:15.65,0:20:18.28,Default,,0,0,0,,Мен білмеймін. Менің де мұнда бірінші рет болуым.
Dialogue: 0,0:20:19.88,0:20:21.12,Default,,0,0,0,,Ябба
Dialogue: 0,0:20:25.23,0:20:26.16,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:27.48,0:20:29.92,Default,,0,0,0,,Ризаның көздері әдемі
Dialogue: 0,0:21:08.48,0:21:11.41,Default,,0,0,0,,Кең және ыңғайлы
Dialogue: 0,0:21:13.10,0:21:15.07,Default,,0,0,0,,Әдемі қамал
Dialogue: 0,0:21:15.07,0:21:17.28,Default,,0,0,0,,Менің ойымша, бұл Жүрек ханшайымының сарайы.
Dialogue: 0,0:21:17.28,0:21:18.77,Default,,0,0,0,,Қандай керемет жер.
Dialogue: 0,0:21:19.62,0:21:20.46,Default,,0,0,0,,Кеттік
Dialogue: 0,0:21:20.46,0:21:21.03,Default,,0,0,0,,Иә
Dialogue: 0,0:21:22.14,0:21:24.93,Default,,0,0,0,,Эй, қол ұстаса болады.
Dialogue: 0,0:21:25.68,0:21:26.57,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:22:23.69,0:22:24.82,Default,,0,0,0,,Өте кең
Dialogue: 0,0:22:24.82,0:22:27.45,Default,,0,0,0,,Ақ қоянды табу қиын сияқты.
Dialogue: 0,0:22:28.15,0:22:29.58,Default,,0,0,0,,Көтерілу Қара, қара
Dialogue: 0,0:22:30.30,0:22:32.13,Default,,0,0,0,,Бұл жерде қызық нәрсе бар.
Dialogue: 0,0:22:36.90,0:22:37.57,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:22:38.78,0:22:40.32,Default,,0,0,0,,Үлпілдек
Dialogue: 0,0:23:16.42,0:23:18.20,Default,,0,0,0,,Алиса, бұл қауіпті.
Dialogue: 0,0:23:18.20,0:23:20.78,Default,,0,0,0,,Егер жоғарыдан бірдеңе құласа, жарақат аласыз.
Dialogue: 0,0:23:21.04,0:23:22.34,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:23:22.34,0:23:22.97,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:23:23.62,0:23:24.26,Default,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:23:25.87,0:23:28.08,Default,,0,0,0,,Мүмкін мен де ұша алатын шығармын
Dialogue: 0,0:23:29.97,0:23:30.85,Default,,0,0,0,,Алиса
Dialogue: 0,0:23:32.28,0:23:35.19,Default,,0,0,0,,Ғажайып Сезім бойы биіктеу
Dialogue: 0,0:23:35.19,0:23:36.31,Default,,0,0,0,,Эй...күте тұрыңыз.
Dialogue: 0,0:23:39.23,0:23:41.83,Default,,0,0,0,,Жоқ...бұл туралы не істеуім керек?
Dialogue: 0,0:23:42.73,0:23:44.83,Default,,0,0,0,,Шахмат тақтасынан сұраңыз
Dialogue: 0,0:23:48.94,0:23:51.16,Default,,0,0,0,,Аспанға жүгіру
Dialogue: 0,0:23:57.33,0:23:58.29,Default,,0,0,0,,Неге...
Dialogue: 0,0:23:58.71,0:24:00.06,Default,,0,0,0,,Енді түсейік.
Dialogue: 0,0:24:00.06,0:24:01.75,Default,,0,0,0,,Бұл бос сөз.
Dialogue: 0,0:24:14.60,0:24:16.86,Default,,0,0,0,,Жарайды, мен жеңілмеймін.
Dialogue: 0,0:24:25.95,0:24:26.88,Default,,0,0,0,,Негізсіз
Dialogue: 0,0:24:27.32,0:24:29.61,Default,,0,0,0,,Тез түсіңіз
Dialogue: 0,0:24:35.25,0:24:36.26,Default,,0,0,0,,Көтерілу
Dialogue: 0,0:24:36.70,0:24:37.94,Default,,0,0,0,,Қараңыз және қараңыз
Dialogue: 0,0:24:37.94,0:24:40.21,Default,,0,0,0,,Таңғажайып пейзаж
Dialogue: 0,0:25:01.48,0:25:02.71,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:25:04.52,0:25:05.09,Default,,0,0,0,,Эй
Dialogue: 0,0:25:15.91,0:25:16.95,Default,,0,0,0,,Қоян
Dialogue: 0,0:25:16.95,0:25:17.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:24.84,0:25:26.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:27.05,0:25:28.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:04.20,0:26:05.94,Default,,0,0,0,,Бас айналу
Dialogue: 0,0:26:31.65,0:26:33.03,Default,,0,0,0,,Мақсат
Dialogue: 0,0:26:50.45,0:26:53.65,Default,,0,0,0,,Ойлап қарасам, биік жерлерді жек көретінмін.
Dialogue: 0,0:26:53.65,0:26:55.85,Default,,0,0,0,,Роллер костер де мүмкін емес
Dialogue: 0,0:26:57.50,0:27:00.82,Default,,0,0,0,,Егер сен сонша қорқатын болсаң, көзіңді жұмуың керек еді.
Dialogue: 0,0:27:01.16,0:27:02.31,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:27:09.08,0:27:10.19,Default,,0,0,0,,Иә.
Dialogue: 0,0:27:10.19,0:27:13.32,Default,,0,0,0,,Мен жаңа ғана алма ұстап тұрған қоянды көрдім.
Dialogue: 0,0:27:13.75,0:27:14.74,Default,,0,0,0,,Рас
Dialogue: 0,0:27:15.36,0:27:15.95,Default,,0,0,0,,Иә
Dialogue: 0,0:27:29.28,0:27:31.76,Default,,0,0,0,,Менің ойымша, сіз осында келдіңіз.
Dialogue: 0,0:27:32.28,0:27:35.38,Default,,0,0,0,,Үлкен саңырауқұлақ
Dialogue: 0,0:27:43.64,0:27:44.96,Default,,0,0,0,,Мен бұл жерде екеніне сенімдімін.
Dialogue: 0,0:27:46.31,0:27:47.69,Default,,0,0,0,,Эй...күте тұрыңыз.
Dialogue: 0,0:27:50.59,0:27:51.44,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:28:25.14,0:28:28.07,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:28:28.80,0:28:30.69,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:28:31.21,0:28:32.94,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:28:33.28,0:28:35.24,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:28:35.57,0:28:38.16,Default,,0,0,0,,Қайда барарымды білмесем де
Dialogue: 0,0:28:38.16,0:28:40.08,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:28:40.08,0:28:43.26,Default,,0,0,0,,Мм...Мен бірдеңе іздедім.
Dialogue: 0,0:28:43.56,0:28:46.97,Default,,0,0,0,,Мына жерде алма ұстап тұрған қоянды көрдіңіз бе?
Dialogue: 0,0:28:47.25,0:28:50.25,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:28:55.25,0:28:56.63,Default,,0,0,0,,Бұл...
Dialogue: 0,0:28:56.93,0:28:57.95,Default,,0,0,0,,Ылғалдатқыш?
Dialogue: 0,0:28:59.60,0:29:01.10,Default,,0,0,0,,түтінге толы
Dialogue: 0,0:29:02.24,0:29:04.79,Default,,0,0,0,,Өйткені құрғақтық – теріңіздің жауы
Dialogue: 0,0:29:06.42,0:29:09.11,Default,,0,0,0,,Сіздің теріңіз шынымен әдемі.
Dialogue: 0,0:29:09.11,0:29:10.35,Default,,0,0,0,,Оны түртіңіз
Dialogue: 0,0:29:10.67,0:29:12.49,Default,,0,0,0,,А...жоқ
Dialogue: 0,0:29:12.49,0:29:13.90,Default,,0,0,0,,Иә, Алиса?
Dialogue: 0,0:29:17.99,0:29:19.65,Default,,0,0,0,,Пурупуру
Dialogue: 0,0:29:22.99,0:29:25.51,Default,,0,0,0,,Өйткені мен сирек адаммын
Dialogue: 0,0:29:25.84,0:29:28.79,Default,,0,0,0,,Мен әрқашан әдемі болғым келеді
Dialogue: 0,0:29:28.98,0:29:29.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:30.04,0:29:32.23,Default,,0,0,0,,Иә, бұл менің қалам жұлдызым
Dialogue: 0,0:29:32.23,0:29:35.42,Default,,0,0,0,,1 миллионнан астам жазылушы
Dialogue: 0,0:29:35.65,0:29:37.82,Default,,0,0,0,,1 миллион…?
Dialogue: 0,0:29:43.06,0:29:44.51,Default,,0,0,0,,Жазушылар?
Dialogue: 0,0:29:45.01,0:29:47.88,Default,,0,0,0,,Мен, бұл құрт әлеміндегі біраз мәселе.
Dialogue: 0,0:29:48.20,0:29:54.02,Default,,0,0,0,,Оны «мыңжылдықта бір рет болатын құрт» және «ғажайып құрт» деп атаған.
Dialogue: 0,0:29:54.02,0:29:56.71,Default,,0,0,0,,Сіз өте харизматикалықсыз.
Dialogue: 0,0:29:57.41,0:29:59.87,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:30:00.15,0:30:02.97,Default,,0,0,0,,Маған лайк саны қызық.
Dialogue: 0,0:30:03.50,0:30:04.82,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:30:05.32,0:30:11.15,Default,,0,0,0,,Жақында басқа жас және әдемі құрттары танымал болды.
Dialogue: 0,0:30:11.94,0:30:14.07,Default,,0,0,0,,Бақылаушы минус 2
Dialogue: 0,0:30:14.07,0:30:14.96,Default,,0,0,0,,Таң қалдыратын…
Dialogue: 0,0:30:25.56,0:30:27.85,Default,,0,0,0,,Сұлулыққа арналған алоэ шырыны пакеті
Dialogue: 0,0:30:28.02,0:30:30.64,Default,,0,0,0,,Массажға арналған қуатты тапанша
Dialogue: 0,0:30:30.64,0:30:33.21,Default,,0,0,0,,Маған көбірек тырысу керек...
Dialogue: 0,0:30:33.21,0:30:35.81,Default,,0,0,0,,Толығырақ Көбірек...
Dialogue: 0,0:30:39.21,0:30:41.39,Default,,0,0,0,,Жазушылар плюс 1
Dialogue: 0,0:30:48.18,0:30:50.90,Default,,0,0,0,,Мына жапырақ дәмді екен
Dialogue: 0,0:30:51.54,0:30:52.96,Default,,0,0,0,,Дәмін көріңіз
Dialogue: 0,0:30:54.40,0:30:55.88,Default,,0,0,0,,Жапырақтан жасалған смузи
Dialogue: 0,0:30:56.33,0:30:58.99,Default,,0,0,0,,Оны ішсең, әдемі боласың.
Dialogue: 0,0:31:08.19,0:31:09.47,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:31:15.99,0:31:17.32,Default,,0,0,0,,Дәмді
Dialogue: 0,0:31:17.32,0:31:18.06,Default,,0,0,0,,Рас
Dialogue: 0,0:31:18.41,0:31:19.78,Default,,0,0,0,,Шынымен де рас
Dialogue: 0,0:31:23.08,0:31:25.65,Default,,0,0,0,,Өтірікші Мен ашулы емеспін
Dialogue: 0,0:31:25.65,0:31:29.19,Default,,0,0,0,,Алиса мені шахмат тақтасына ертерек отырғызғанда мен қорықтым.
Dialogue: 0,0:31:29.41,0:31:30.26,Default,,0,0,0,,Өз кезегінде
Dialogue: 0,0:31:32.47,0:31:34.12,Default,,0,0,0,,Сізге қалай ұнады?
Dialogue: 0,0:31:34.12,0:31:36.40,Default,,0,0,0,,Иә, тағы бір сусын алғыңыз келе ме?
Dialogue: 0,0:31:36.40,0:31:37.58,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:31:36.40,0:31:37.58,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:31:37.58,0:31:38.71,Default,,0,0,0,,Бұл жаман...
Dialogue: 0,0:31:39.01,0:31:42.30,Default,,0,0,0,,Сұлулыққа дәмді...
Dialogue: 0,0:31:42.30,0:31:44.63,Default,,0,0,0,,Бақылаушы минус 3
Dialogue: 0,0:31:47.74,0:31:50.39,Default,,0,0,0,,Көбірек Көбірек...
Dialogue: 0,0:31:50.67,0:31:52.65,Default,,0,0,0,,Минус 7
Dialogue: 0,0:31:58.36,0:32:01.32,Default,,0,0,0,,Сәлем, шынжыр табан мырза
Dialogue: 0,0:32:14.66,0:32:15.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:15.62,0:32:16.44,Default,,0,0,0,,О.
Dialogue: 0,0:32:17.24,0:32:18.81,Default,,0,0,0,,Қуыршаққа айналады
Dialogue: 0,0:32:19.08,0:32:20.06,Default,,0,0,0,,Иә
Dialogue: 0,0:32:27.23,0:32:28.68,Default,,0,0,0,,Жоғарыға қара
Dialogue: 0,0:33:06.01,0:33:08.38,Default,,0,0,0,,Қандай әдемі
Dialogue: 0,0:33:20.06,0:33:21.40,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:33:22.94,0:33:24.74,Default,,0,0,0,,Мен ересек болдым
Dialogue: 0,0:33:24.74,0:33:27.25,Default,,0,0,0,,Енді маған ешкім лайк бермейді
Dialogue: 0,0:33:28.81,0:33:29.90,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:33:29.90,0:33:33.99,Default,,0,0,0,,үшінна жас, сүйкімді, бұйра құрт ұнайтын сияқты.
Dialogue: 0,0:33:34.31,0:33:37.15,Default,,0,0,0,,Мен ересек адам ретінде маған қызығушылық танытпаймын.
Dialogue: 0,0:33:38.78,0:33:39.95,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:33:40.31,0:33:43.74,Default,,0,0,0,,Менің ойымша, ол көбелек сияқты әлдеқайда жақсы көрінеді.
Dialogue: 0,0:33:43.74,0:33:45.11,Default,,0,0,0,,Нресс
Dialogue: 0,0:33:45.11,0:33:46.42,Default,,0,0,0,,Ух...иә
Dialogue: 0,0:33:46.42,0:33:47.74,Default,,0,0,0,,Шарап
Dialogue: 0,0:33:47.74,0:33:49.82,Default,,0,0,0,,Шынжыр табандар әлемі туралы ештеңе білмесем де.
Dialogue: 0,0:33:49.82,0:33:52.93,Default,,0,0,0,,Мен оны ешқашан таратпасам да, білемін деп кейіп танытпа.
Dialogue: 0,0:33:53.19,0:33:55.43,Default,,0,0,0,,Мен бұл шынымен әдемі деп ойладым.
Dialogue: 0,0:33:55.74,0:33:56.76,Default,,0,0,0,,Әдемі?
Dialogue: 0,0:33:56.76,0:33:58.28,Default,,0,0,0,,Шын мәнінде не әдемі?
Dialogue: 0,0:33:58.28,0:34:00.47,Default,,0,0,0,,Сіздің ойыңызша сұлулық дегеніміз не?
Dialogue: 0,0:34:07.19,0:34:11.20,Default,,0,0,0,,Қош бол, мені іздеме
Dialogue: 0,0:34:12.27,0:34:14.00,Default,,0,0,0,,Тоқта, қайда бара жатырсың?
Dialogue: 0,0:34:14.34,0:34:15.82,Default,,0,0,0,,Асықпа
Dialogue: 0,0:34:16.50,0:34:19.16,Default,,0,0,0,,Сәлем, Мото Аомуши-сан.
Dialogue: 0,0:34:19.88,0:34:22.67,Default,,0,0,0,,Мен бұл қанаттарды жақсы көремін.
Dialogue: 0,0:34:22.97,0:34:24.26,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:34:42.57,0:34:44.61,Default,,0,0,0,,Қоян мырза ол жерде болмады.
Dialogue: 0,0:35:30.19,0:35:31.44,Default,,0,0,0,,Төмен түсу Төмен түсу
Dialogue: 0,0:35:31.44,0:35:33.19,Default,,0,0,0,,Бұл патшайымның жолы.
Dialogue: 0,0:35:33.50,0:35:35.52,Default,,0,0,0,,Королева...
Dialogue: 0,0:35:35.86,0:35:37.66,Default,,0,0,0,,Жоқ, ол төмендемейді.
Dialogue: 0,0:35:37.66,0:35:38.74,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:35:38.74,0:35:39.79,Default,,0,0,0,,Төмен түсу Төмен түсу
Dialogue: 0,0:35:39.79,0:35:41.16,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:35:41.16,0:35:42.26,Default,,0,0,0,,төмен түспейді
Dialogue: 0,0:35:42.26,0:35:44.60,Default,,0,0,0,,Бұл не, лайықсыз адам?
Dialogue: 0,0:35:42.98,0:35:44.60,Default,,0,0,0,,Алиса, төмен түс.
Dialogue: 0,0:35:44.60,0:35:45.62,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:35:45.90,0:35:47.83,Default,,0,0,0,,Королева...
Dialogue: 0,0:35:48.68,0:35:50.24,Default,,0,0,0,,Бұл өте қауіпті.
Dialogue: 0,0:35:50.79,0:35:52.51,Default,,0,0,0,,Менің басымды кесіп тастаймын
Dialogue: 0,0:35:50.24,0:35:54.01,Default,,0,0,0,,Ханшайымның іші
Dialogue: 0,0:35:52.51,0:35:54.01,Default,,0,0,0,,Бұл бос сөз.
Dialogue: 0,0:36:03.30,0:36:04.77,Default,,0,0,0,,Алиса осында
Dialogue: 0,0:36:21.89,0:36:22.55,Default,,0,0,0,,Мен осындамын ғой?
Dialogue: 0,0:36:33.19,0:36:34.55,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:36:36.78,0:36:37.80,Default,,0,0,0,,Сәлем
Dialogue: 0,0:36:38.91,0:36:41.18,Default,,0,0,0,,Қорқудың қажеті жоқ.
Dialogue: 0,0:36:41.51,0:36:42.81,Default,,0,0,0,,Шық!
Dialogue: 0,0:36:46.19,0:36:48.36,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:36:49.24,0:36:52.54,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын, патшайым.
Dialogue: 0,0:36:53.98,0:36:55.44,Default,,0,0,0,,Алисаға көтерілу
Dialogue: 0,0:36:56.66,0:36:59.54,Default,,0,0,0,,Ғажайыптар еліне қош келдіңіз
Dialogue: 0,0:37:02.63,0:37:03.90,Default,,0,0,0,,Уақытыңызды алыңыз
Dialogue: 0,0:37:08.14,0:37:09.15,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:37:20.68,0:37:22.18,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:37:22.18,0:37:24.22,Default,,0,0,0,,Бұл мойын. Бұл мойын.
Dialogue: 0,0:37:30.98,0:37:32.56,Default,,0,0,0,,Басыңды кес
Dialogue: 0,0:37:36.35,0:37:37.62,Default,,0,0,0,,О...тоқтаңдар!
Dialogue: 0,0:37:37.62,0:37:38.92,Default,,0,0,0,,Сіз айтқандай
Dialogue: 0,0:37:50.88,0:37:52.49,Default,,0,0,0,,(Кёко) Ах…
Dialogue: 0,0:37:53.60,0:37:54.88,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:37:54.88,0:37:56.87,Default,,0,0,0,,Менің де ұрғым келеді
Dialogue: 0,0:37:57.16,0:38:00.41,Default,,0,0,0,,Қорқынышты. Мен сені мейірімді адам деп ойладым.
Dialogue: 0,0:38:00.71,0:38:01.55,Default,,0,0,0,,Қорқынышты ма?
Dialogue: 0,0:38:02.44,0:38:04.42,Default,,0,0,0,,Олар бақытты
Dialogue: 0,0:38:04.89,0:38:05.66,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:38:06.69,0:38:08.08,Default,,0,0,0,,Олай болса, айтыңызшы.
Dialogue: 0,0:38:08.51,0:38:12.25,Default,,0,0,0,,Мейірімділік дегеніміз не деп ойлайсың?
Dialogue: 0,0:38:14.27,0:38:19.92,Default,,0,0,0,,Мен Трамп сарбаздарының басын алудан шаршадым.
Dialogue: 0,0:38:21.44,0:38:25.70,Default,,0,0,0,,Сіздің мойыныңыз әдемі.
Dialogue: 0,0:38:30.41,0:38:31.46,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:38:33.50,0:38:35.23,Default,,0,0,0,,Бізде шұғыл хабар бар.
Dialogue: 0,0:38:36.63,0:38:39.59,Default,,0,0,0,,Патшайым ханшайым Бұл қиын Бұл қиын
Dialogue: 0,0:38:40.02,0:38:43.80,Default,,0,0,0,,Патшаның алдында дөрекілік көрсетіп жатырсың. Тыныштанып, сөйлеңіз.
Dialogue: 0,0:38:43.80,0:38:46.89,Default,,0,0,0,,Мына біртүрлі алмаға қараңдаршы
Dialogue: 0,0:38:46.89,0:38:50.54,Default,,0,0,0,,Ғажайыптар еліне қауіпті адам осындай нәрсені әкелді...
Dialogue: 0,0:38:54.81,0:38:57.03,Default,,0,0,0,,Міне, олар. Мен оларды жай ғана көрдім.
Dialogue: 0,0:38:57.03,0:38:57.84,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:38:57.84,0:38:59.37,Default,,0,0,0,,Ол қайда? Бұл қайда?
Dialogue: 0,0:39:02.32,0:39:03.84,Default,,0,0,0,,Жүр, тұрайық
Dialogue: 0,0:39:03.84,0:39:05.14,Default,,0,0,0,,Ух...иә
Dialogue: 0,0:39:27.03,0:39:29.23,Default,,0,0,0,,Жарайды, ешкім келмейді.
Dialogue: 0,0:39:30.13,0:39:31.21,Default,,0,0,0,,Сәлем Алиса
Dialogue: 0,0:39:31.54,0:39:33.69,Default,,0,0,0,,Мына алма сондай біртүрлі
Dialogue: 0,0:39:33.90,0:39:35.85,Default,,0,0,0,,Жүр, мен білмеймін.
Dialogue: 0,0:39:35.85,0:39:39.69,Default,,0,0,0,,Рұқсатсыз алып кетті, мен одан бетер қиналдым.
Dialogue: 0,0:39:39.69,0:39:43.09,Default,,0,0,0,,Әлгі қоян менің кінәм дейді.
Dialogue: 0,0:39:43.09,0:39:44.78,Default,,0,0,0,,Мен өте жақсы түсінемін.
Dialogue: 0,0:39:45.23,0:39:47.72,Default,,0,0,0,,Бұл жердің бәрі біртүрлі.
Dialogue: 0,0:39:51.86,0:39:53.41,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:39:53.75,0:39:56.18,Default,,0,0,0,,Менің асқазаным Пенпекорин
Dialogue: 0,0:40:10.30,0:40:13.36,Default,,0,0,0,,Қабырғалар қызыл болуы керек
Dialogue: 0,0:40:22.07,0:40:24.88,Default,,0,0,0,,Жасыл ең жақсы
Dialogue: 0,0:40:30.47,0:40:34.39,Default,,0,0,0,,Көңілді, бітпейтін шығарма, мәңгілік жұмбақ
Dialogue: 0,0:40:34.39,0:40:37.71,Default,,0,0,0,,Неліктен қанша сурет салсам да, оның соңы жоқ?
Dialogue: 0,0:40:40.56,0:40:42.47,Default,,0,0,0,,Қызыл түс әдемірек
Dialogue: 0,0:40:42.47,0:40:44.12,Default,,0,0,0,,Жасыл түс әдемірек
Dialogue: 0,0:40:45.17,0:40:46.34,Default,,0,0,0,,Бұл қызыл.
Dialogue: 0,0:40:46.34,0:40:47.09,Default,,0,0,0,,Бұл жасыл.
Dialogue: 0,0:40:47.09,0:40:48.69,Default,,0,0,0,,Қайсысы да жақсы.
Dialogue: 0,0:40:48.69,0:40:50.82,Default,,0,0,0,,Екеуі де біртүрлі.
Dialogue: 0,0:40:53.14,0:40:54.47,Default,,0,0,0,,Сіз осылай айтасыз...
Dialogue: 0,0:40:54.47,0:40:55.56,Default,,0,0,0,,Бұл тек болжам ғана, айтпақшы.
Dialogue: 0,0:40:54.47,0:40:55.56,Default,,0,0,0,,Бұл тек болжам ғана, айтпақшы.
Dialogue: 0,0:40:57.30,0:40:58.66,Default,,0,0,0,,Сізге қайсысы ұнайды?
Dialogue: 0,0:40:58.66,0:41:00.65,Default,,0,0,0,,Осы жерде және қазір анық болайық.
Dialogue: 0,0:41:01.37,0:41:02.82,Default,,0,0,0,,Ал, мен
Dialogue: 0,0:41:02.82,0:41:04.50,Default,,0,0,0,,Ол қызыл болуы керек, солай ма?
Dialogue: 0,0:41:04.50,0:41:06.11,Default,,0,0,0,,Бұл міндетті түрде жасыл, солай ма?
Dialogue: 0,0:41:06.40,0:41:11.86,Default,,0,0,0,,Ух...ммм, қызыл жақсы, жасыл да әдемі.
Dialogue: 0,0:41:11.86,0:41:13.62,Default,,0,0,0,,Маған көк түсті ұнайды
Dialogue: 0,0:41:13.62,0:41:14.56,Default,,0,0,0,,Иә
Dialogue: 0,0:41:13.62,0:41:14.56,Default,,0,0,0,,Иә
Dialogue: 0,0:41:15.81,0:41:19.62,Default,,0,0,0,,А...м, екеуіне де алаңдама.
Dialogue: 0,0:41:20.00,0:41:22.25,Default,,0,0,0,,Бұл артықшылық мәселесі.
Dialogue: 0,0:41:22.25,0:41:24.47,Default,,0,0,0,,Қызыл да, жасыл да жаман емес...
Dialogue: 0,0:41:24.47,0:41:25.37,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:41:25.37,0:41:26.42,Default,,0,0,0,,Оны көк түске айналдырайық
Dialogue: 0,0:41:26.42,0:41:27.00,Default,,0,0,0,,Е...
Dialogue: 0,0:41:27.78,0:41:29.89,Default,,0,0,0,,Белгілі бір уақытта шай ішу
Dialogue: 0,0:41:30.25,0:41:32.09,Default,,0,0,0,,Балалар, бізге қосылсаңдаршы?
Dialogue: 0,0:41:32.09,0:41:33.29,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:41:33.80,0:41:35.04,Default,,0,0,0,,Жүр, тұрайық
Dialogue: 0,0:41:35.04,0:41:36.36,Default,,0,0,0,,Ух...иә
Dialogue: 0,0:41:37.16,0:41:40.09,Default,,0,0,0,,Сізге кедергі жасағанымыз дұрыс па?
Dialogue: 0,0:41:40.09,0:41:41.38,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:41:41.38,0:41:43.87,Default,,0,0,0,,Неғұрлым көп болса, соғұрлым көңілді болады.
Dialogue: 0,0:41:52.66,0:41:55.51,Default,,0,0,0,,Керемет үлкен сарай
Dialogue: 0,0:41:55.51,0:41:57.23,Default,,0,0,0,,Шамамен бізбен бірдей.
Dialogue: 0,0:41:57.23,0:41:57.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:09.05,0:42:10.55,Default,,0,0,0,,Міне, кеттік.
Dialogue: 0,0:42:10.88,0:42:12.51,Default,,0,0,0,,Керемет
Dialogue: 0,0:42:12.51,0:42:16.72,Default,,0,0,0,,Мен дәмді шелпектердің болатынына сенімдімін. Мен оны асыға күтемін.
Dialogue: 0,0:42:25.37,0:42:28.89,Default,,0,0,0,,Қателерге толы шай кешіне қош келдіңіздер.
Dialogue: 0,0:42:29.37,0:42:31.07,Default,,0,0,0,,Жұмыртқа шықты.
Dialogue: 0,0:42:31.07,0:42:32.50,Default,,0,0,0,,Мен жаңа ғана жұмыртқа дедім.
Dialogue: 0,0:42:33.20,0:42:35.61,Default,,0,0,0,,Осы үйдің иесіне дөрекілік көрсету
Dialogue: 0,0:42:35.61,0:42:39.08,Default,,0,0,0,,Алиса, бұл Humpty Dumpty.
Dialogue: 0,0:42:39.08,0:42:43.47,Default,,0,0,0,,Тез ішке кіріңіз, шайды бастай алмаймыз.
Dialogue: 0,0:42:43.47,0:42:45.79,Default,,0,0,0,,Мені шақырғаныңызға рахмет.
Dialogue: 0,0:42:46.20,0:42:49.04,Default,,0,0,0,,Иә, сен аздап ақымақ сияқтысың.
Dialogue: 0,0:42:49.04,0:42:50.17,Default,,0,0,0,,Көмек алыңыз
Dialogue: 0,0:42:50.38,0:42:50.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:51.94,0:42:53.63,Default,,0,0,0,,Бізде жұмыс күші жетіспейді.
Dialogue: 0,0:42:53.85,0:42:56.64,Default,,0,0,0,,Бұл жерде адал адамдар жоқ.
Dialogue: 0,0:42:57.01,0:42:58.45,Default,,0,0,0,,Жоқ, бұл тыңшылық емес
Dialogue: 0,0:42:58.45,0:42:59.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:07.77,0:43:10.15,Default,,0,0,0,,Кесте слайдқа ұқсайды.
Dialogue: 0,0:43:13.92,0:43:15.38,Default,,0,0,0,,Қараңдар, мынаны беріңдер.
Dialogue: 0,0:43:15.38,0:43:15.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:20.84,0:43:22.08,Default,,0,0,0,,Бұл не орындық?
Dialogue: 0,0:43:22.52,0:43:24.12,Default,,0,0,0,,Менің бөксем қисайған
Dialogue: 0,0:43:24.77,0:43:27.58,Default,,0,0,0,,Шай ішу қандай қызық.
Dialogue: 0,0:43:29.82,0:43:31.09,Default,,0,0,0,,Бұл жақсы иіс.
Dialogue: 0,0:43:31.09,0:43:33.59,Default,,0,0,0,,Тек иісі ғана ішімді толтырады
Dialogue: 0,0:43:33.59,0:43:36.24,Default,,0,0,0,,Бұл менің мақтан тұтатын шие тортым.
Dialogue: 0,0:43:36.24,0:43:37.97,Default,,0,0,0,,Алайда оны ешқашан жеуге болмайды.
Dialogue: 0,0:43:38.28,0:43:40.07,Default,,0,0,0,,Иә, неге?
Dialogue: 0,0:43:40.07,0:43:41.93,Default,,0,0,0,,Неліктен оны жеуге болмайды?
Dialogue: 0,0:43:41.93,0:43:45.60,Default,,0,0,0,,Ол сондай шулы бала. Ол үнемі шағымданады.
Dialogue: 0,0:43:46.75,0:43:48.48,Default,,0,0,0,,Тағы бір шыны шай алғыңыз келе ме?
Dialogue: 0,0:43:48.85,0:43:50.88,Default,,0,0,0,,Мен әлі ішкен жоқпын.
Dialogue: 0,0:43:51.32,0:43:53.25,Default,,0,0,0,,Шай туралы айтатын болсақ, британдық қара шай
Dialogue: 0,0:43:53.25,0:43:55.37,Default,,0,0,0,,Яғни қызыл - ең жақсысы
Dialogue: 0,0:43:55.37,0:43:58.49,Default,,0,0,0,,Жоқ, шығыстың сыры, көк шайдың көкі.
Dialogue: 0,0:43:58.86,0:44:00.20,Default,,0,0,0,,Шайды толтыру
Dialogue: 0,0:44:00.20,0:44:01.67,Default,,0,0,0,,Көк шайды толтыру
Dialogue: 0,0:44:02.17,0:44:04.41,Default,,0,0,0,,Маған таңқурай шырыны ұнайды
Dialogue: 0,0:44:04.41,0:44:06.50,Default,,0,0,0,,Өзімшіл тұтынушыларға толы
Dialogue: 0,0:44:06.74,0:44:09.59,Default,,0,0,0,,Оларды тез, барлығын бір уақытта кіргізіңіз.
Dialogue: 0,0:44:10.74,0:44:12.46,Default,,0,0,0,,Тәртібі дұрыс емес пе?
Dialogue: 0,0:44:13.58,0:44:14.90,Default,,0,0,0,,Мүмкін болса
Dialogue: 0,0:44:15.42,0:44:16.55,Default,,0,0,0,,Осы жерден
Dialogue: 0,0:44:16.55,0:44:17.51,Default,,0,0,0,,Бұл бірінші
Dialogue: 0,0:44:17.78,0:44:18.56,Default,,0,0,0,,Мұнда
Dialogue: 0,0:44:18.56,0:44:19.34,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:44:19.34,0:44:19.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:19.68,0:44:20.69,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:44:20.69,0:44:21.39,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:44:21.39,0:44:23.36,Default,,0,0,0,,Оны қай жолмен енгізуім керек?
Dialogue: 0,0:44:26.46,0:44:28.71,Default,,0,0,0,,Жүр, мен тыныш отырайын.
Dialogue: 0,0:44:34.42,0:44:37.70,Default,,0,0,0,,Мм...бұл баланы қанша уақыт ұстауым керек?
Dialogue: 0,0:44:37.97,0:44:39.32,Default,,0,0,0,,Иә деп айтқанша
Dialogue: 0,0:44:39.32,0:44:43.45,Default,,0,0,0,,Бұл шынымен жаман шай кеші, мен күткеннен әлдеқайда көп.
Dialogue: 0,0:44:43.45,0:44:44.46,Default,,0,0,0,,Ер адамның аты – Ллойд Форджер
Dialogue: 0,0:44:44.46,0:44:46.29,Default,,0,0,0,,Кешіріңіз, Алиса.
Dialogue: 0,0:44:46.53,0:44:49.78,Default,,0,0,0,,Мен қожайыныма осылай көмектесуді тоқтатсам ғой.
Dialogue: 0,0:44:49.78,0:44:51.84,Default,,0,0,0,,Мен бұл туралы бірдеңе істеймін.
Dialogue: 0,0:44:51.84,0:44:54.77,Default,,0,0,0,,Іс осылай жалғаса берсе, бәрі түбіне түседі.
Dialogue: 0,0:44:54.77,0:44:56.09,Default,,0,0,0,,Бұл тәртіпсіздік болады
Dialogue: 0,0:44:56.09,0:44:58.18,Default,,0,0,0,,Сен, тыныш бол.
Dialogue: 0,0:44:58.18,0:44:59.76,Default,,0,0,0,,Қайсысы қаттырақ?
Dialogue: 0,0:45:06.03,0:45:08.25,Default,,0,0,0,,Ұйқыдан тұрсаң, бәлеге қаласың.
Dialogue: 0,0:45:10.70,0:45:12.06,Default,,0,0,0,,Не болады?
Dialogue: 0,0:45:15.70,0:45:16.78,Default,,0,0,0,,Не болады?
Dialogue: 0,0:45:16.78,0:45:18.86,Default,,0,0,0,,Мен тыңдаймын
Dialogue: 0,0:45:29.12,0:45:30.87,Default,,0,0,0,,Мен енді шыдай алмаймын
Dialogue: 0,0:45:44.12,0:45:45.22,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:45:45.87,0:45:47.15,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:45:47.15,0:45:49.81,Default,,0,0,0,,Сондықтан мен саған оны жеме дедім.
Dialogue: 0,0:45:50.82,0:45:51.69,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:45:55.57,0:45:57.54,Default,,0,0,0,,Ашкөзсің
Dialogue: 0,0:45:58.50,0:46:02.16,Default,,0,0,0,,Бұл шынымен де ең жаман нәрсе
Dialogue: 0,0:46:25.86,0:46:28.68,Default,,0,0,0,,Ауырсынды... ауыртады...
Dialogue: 0,0:46:29.39,0:46:32.59,Default,,0,0,0,,Маған көмектес... көмектес...
Dialogue: 0,0:46:42.05,0:46:43.59,Default,,0,0,0,,Жылама Алиса
Dialogue: 0,0:46:46.76,0:46:50.71,Default,,0,0,0,,Әй, ол күннен-күнге кішірейіп барады.
Dialogue: 0,0:46:50.71,0:46:52.75,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:46:54.25,0:46:56.08,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:46:56.08,0:46:58.14,Default,,0,0,0,,Үлкендеу немесе кішірейту
Dialogue: 0,0:47:14.64,0:47:17.48,Default,,0,0,0,,Мен ауырып тұрмын... көмектесіңізші...
Dialogue: 0,0:47:17.48,0:47:18.57,Default,,0,0,0,,Алиса
Dialogue: 0,0:47:19.94,0:47:22.94,Default,,0,0,0,,Көтерілуге көмектесу
Dialogue: 0,0:47:23.24,0:47:25.03,Default,,0,0,0,,Алиса, мынаны іш.
Dialogue: 0,0:47:25.27,0:47:27.74,Default,,0,0,0,,Эй, мен сені естимін, Алиса.
Dialogue: 0,0:47:27.74,0:47:28.74,Default,,0,0,0,,Каранэс ауданына оралу.
Dialogue: 0,0:47:29.88,0:47:30.49,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:47:30.89,0:47:31.74,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,0:47:33.00,0:47:36.00,Default,,0,0,0,,Мен ауырып тұрмын... көмектесіңізші...
Dialogue: 0,0:47:34.08,0:47:36.00,Default,,0,0,0,,Бәрін шарға салдың ба?
Dialogue: 0,0:47:38.00,0:47:39.74,Default,,0,0,0,,Маған көмектесіңіз...
Dialogue: 0,0:48:21.76,0:48:22.62,Default,,0,0,0,,Алиса
Dialogue: 0,0:48:25.96,0:48:27.49,Default,,0,0,0,,Бұл қазірдің өзінде қиын
Dialogue: 0,0:48:27.49,0:48:30.42,Default,,0,0,0,,Мұнда ештеңе жеуге болмайды.
Dialogue: 0,0:48:30.42,0:48:31.64,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:48:34.06,0:48:36.35,Default,,0,0,0,,Өзен Алисаның көз жасынан пайда болды.
Dialogue: 0,0:48:37.24,0:48:39.27,Default,,0,0,0,,Сізді қайда апарып жатыр?
Dialogue: 0,0:48:39.94,0:48:42.91,Default,,0,0,0,,Мен асығуым керек еді, бірақ қарғыс атсын
Dialogue: 0,0:48:51.37,0:48:53.33,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:48:55.33,0:48:57.54,Default,,0,0,0,,Бар, жүр
Dialogue: 0,0:49:03.01,0:49:04.74,Default,,0,0,0,,Ия
Dialogue: 0,0:49:09.06,0:49:10.41,Default,,0,0,0,,Итатата
Dialogue: 0,0:49:10.41,0:49:12.12,Default,,0,0,0,,Алиса, бәрі жақсы.
Dialogue: 0,0:49:12.12,0:49:13.66,Default,,0,0,0,,Иә, менде бәрі жақсы.
Dialogue: 0,0:49:14.17,0:49:16.32,Default,,0,0,0,,Бірақ мұнда қайда?
Dialogue: 0,0:49:39.21,0:49:40.83,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:49:40.83,0:49:43.72,Default,,0,0,0,,Біртүрлі Мылқау және Ди цирк үйі
Dialogue: 0,0:49:43.72,0:49:46.14,Default,,0,0,0,,Міне, келдіңіз.
Dialogue: 0,0:49:46.14,0:49:47.71,Default,,0,0,0,,Дам мен Ди?
Dialogue: 0,0:49:47.71,0:49:49.89,Default,,0,0,0,,Мен Твидлимін.
Dialogue: 0,0:49:49.89,0:49:52.22,Default,,0,0,0,,Шамасы, мен Твидледуммын
Dialogue: 0,0:49:52.22,0:49:54.73,Default,,0,0,0,,Сәлеметсіз бе, Ди мырза, Дам мырза
Dialogue: 0,0:49:54.73,0:49:56.58,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:49:56.58,0:49:57.95,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:49:57.95,0:50:00.31,Default,,0,0,0,,Мен жаңа цирк үйін салдым.
Dialogue: 0,0:50:00.31,0:50:01.64,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:50:01.64,0:50:04.08,Default,,0,0,0,,Цирк үйі құлағалы тұр.
Dialogue: 0,0:50:04.08,0:50:05.23,Default,,0,0,0,,Сіз құлағалы жатырсыз ба?
Dialogue: 0,0:50:05.23,0:50:07.15,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:50:07.42,0:50:09.49,Default,,0,0,0,,Амал жоқ деп ойлағым келеді
Dialogue: 0,0:50:09.83,0:50:11.39,Default,,0,0,0,,Қаласаңыз, қараңыз
Dialogue: 0,0:50:11.39,0:50:14.75,Default,,0,0,0,,Жоқ, мен алма іздедім...
Dialogue: 0,0:50:15.35,0:50:16.80,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:50:16.80,0:50:18.73,Default,,0,0,0,,А, жоқ, онша емес.
Dialogue: 0,0:50:18.73,0:50:20.29,Default,,0,0,0,,Мен көп жаттығу жасадым.
Dialogue: 0,0:50:20.29,0:50:21.96,Default,,0,0,0,,Сен жақсысың.
Dialogue: 0,0:50:21.96,0:50:23.53,Default,,0,0,0,,Мен сені мақтауға мәжбүрмін.
Dialogue: 0,0:50:23.53,0:50:25.45,Default,,0,0,0,,Үш Құдайханымды адам қолымен ластау—
Dialogue: 0,0:50:25.45,0:50:27.33,Default,,0,0,0,,Бұл әдемі цирк үйі.
Dialogue: 0,0:50:27.33,0:50:29.29,Default,,0,0,0,,Бірде-бір тұтынушы келмеді.
Dialogue: 0,0:50:29.29,0:50:30.38,Default,,0,0,0,,Денемнің қатып қалатынына ешқандай белгі болмады…
Dialogue: 0,0:50:30.77,0:50:33.76,Default,,0,0,0,,Алиса, мені аяймын деп айтпа.
Dialogue: 0,0:50:33.76,0:50:34.89,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:50:34.89,0:50:37.33,Default,,0,0,0,,Жарайды, жарайды, тура айт.
Dialogue: 0,0:50:37.33,0:50:39.06,Default,,0,0,0,,Балалар, сендер де солай жасағыларың келеді
Dialogue: 0,0:50:39.06,0:50:40.94,Default,,0,0,0,,Иә, бұл қызықты көрінеді.
Dialogue: 0,0:50:40.94,0:50:43.01,Default,,0,0,0,,Содан кейін бұл тыңдау.
Dialogue: 0,0:50:43.01,0:50:43.61,Default,,0,0,0,,Ха
Dialogue: 0,0:50:47.36,0:50:49.85,Default,,0,0,0,,Е, мен мұны істей алмаймын.
Dialogue: 0,0:50:50.40,0:50:52.15,Default,,0,0,0,,Сіз тырыспайынша білмейсіз
Dialogue: 0,0:50:52.48,0:50:53.89,Default,,0,0,0,,Армандар үлкен
Dialogue: 0,0:50:53.89,0:50:55.47,Default,,0,0,0,,Бұл иллюзия
Dialogue: 0,0:50:55.47,0:50:56.79,Default,,0,0,0,,Жоғары мұраттар
Dialogue: 0,0:50:56.79,0:50:58.85,Default,,0,0,0,,Шындық қатыгез
Dialogue: 0,0:51:01.42,0:51:03.53,Default,,0,0,0,,Кел де қызық болайық Орн
Dialogue: 0,0:51:04.24,0:51:06.63,Default,,0,0,0,,Мен бұрын ешқашан рэп айтқан емеспін.
Dialogue: 0,0:51:06.63,0:51:09.72,Default,,0,0,0,,Бұл жай ғана ойлауды тоқтату.
Dialogue: 0,0:51:10.09,0:51:13.10,Default,,0,0,0,,Бұл ұят, сондықтан кешіріңіз.
Dialogue: 0,0:51:13.10,0:51:15.74,Default,,0,0,0,,Таңқаларлықтай ырғақты
Dialogue: 0,0:51:16.09,0:51:18.58,Default,,0,0,0,,Мен сізде атмосфераны оқитын және жоқ деп айта алмайтын мінезіңіз бар екеніне сенімдімін.
Dialogue: 0,0:51:18.58,0:51:21.60,Default,,0,0,0,,Мені айналамдағылар алып кетеді. Бұл шын мәнінде ыңғайсыздық.
Dialogue: 0,0:51:21.60,0:51:23.00,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:51:23.00,0:51:24.85,Default,,0,0,0,,Ал... бұл дұрыс емес.
Dialogue: 0,0:51:24.85,0:51:27.97,Default,,0,0,0,,Менің стилім - позитивті көзқараспен барлық нәрседе қолымнан келгеннің бәрін жасау.
Dialogue: 0,0:51:27.97,0:51:29.20,Default,,0,0,0,,Жағымды күлкі
Dialogue: 0,0:51:29.20,0:51:30.52,Default,,0,0,0,,Өзіңізді жарнамалаңыз
Dialogue: 0,0:51:30.52,0:51:33.74,Default,,0,0,0,,Тіпті жұмыс іздеудің өзі де жақсы болмайды.
Dialogue: 0,0:51:33.74,0:51:36.41,Default,,0,0,0,,Мен көп жұмыс істеп жатырмын
Dialogue: 0,0:51:36.41,0:51:38.63,Default,,0,0,0,,Ерінбей еңбек ету – ақиқат.
Dialogue: 0,0:51:38.63,0:51:40.74,Default,,0,0,0,,Бұл көтерілістің жақсы жағы
Dialogue: 0,0:51:40.74,0:51:42.91,Default,,0,0,0,,Мен сұхбатта кейде өтірік айтамын.
Dialogue: 0,0:51:42.91,0:51:45.98,Default,,0,0,0,,Күніңіз қызықты өтіп жатқан сияқты.
Dialogue: 0,0:51:45.98,0:51:49.76,Default,,0,0,0,,Мен өзім білмейтін күшті жақтарыма жүгінемін.
Dialogue: 0,0:51:49.76,0:51:52.46,Default,,0,0,0,,Мен ненің рас екенін де білмеймін
Dialogue: 0,0:51:52.46,0:51:54.86,Default,,0,0,0,,Неліктен сонша жұмыс істегіңіз келеді?
Dialogue: 0,0:51:55.98,0:51:57.69,Default,,0,0,0,,Иә, кейде.
Dialogue: 0,0:51:57.69,0:52:00.64,Default,,0,0,0,,Неге жұмыс істеу керек деп ойлаған кезде
Dialogue: 0,0:52:00.64,0:52:02.10,Default,,0,0,0,,Көбірек айтыңыз
Dialogue: 0,0:52:02.82,0:52:04.90,Default,,0,0,0,,Мен шынымен де жалқау болғым келеді.
Dialogue: 0,0:52:04.90,0:52:07.27,Default,,0,0,0,,Таңертеңгі сағат 10-ға дейін ұйықтағым келеді
Dialogue: 0,0:52:07.27,0:52:09.36,Default,,0,0,0,,Бірақ әркім өзін-өзі алдайды
Dialogue: 0,0:52:09.36,0:52:11.86,Default,,0,0,0,,«Байыпты болу дұрыс» деп есептеймін
Dialogue: 0,0:52:11.86,0:52:13.53,Default,,0,0,0,,Себебі мен емтихан тапсырғым келеді.
Dialogue: 0,0:52:13.53,0:52:16.01,Default,,0,0,0,,Себебі маған сен керек екеніңді айтқым келеді
Dialogue: 0,0:52:16.01,0:52:18.35,Default,,0,0,0,,Позаңызды түзетіңіз және жай ғана күліңіз
Dialogue: 0,0:52:18.35,0:52:20.74,Default,,0,0,0,,Сұраққа иә деп жауап беріңіз.
Dialogue: 0,0:52:20.74,0:52:22.78,Default,,0,0,0,,Позитивті апелляция Толық өкілеттілік
Dialogue: 0,0:52:22.78,0:52:24.98,Default,,0,0,0,,Өйткені мен басқа жолды білмеймін.
Dialogue: 0,0:52:24.98,0:52:27.25,Default,,0,0,0,,Күн сайын мен сәтсіздікке ұшырамауға тырысамын.
Dialogue: 0,0:52:27.25,0:52:29.94,Default,,0,0,0,,Иә, мен жай ғана шарасызмын.
Dialogue: 0,0:52:30.87,0:52:32.59,Default,,0,0,0,,...
Dialogue: 0,0:52:32.59,0:52:34.34,Default,,0,0,0,,Жұмысқа қабылдау
Dialogue: 0,0:52:35.30,0:52:35.94,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:52:35.94,0:52:38.59,Default,,0,0,0,,Көтерілу өте жақсы болды.
Dialogue: 0,0:52:38.98,0:52:42.72,Default,,0,0,0,,Мен бірінші рет жұмысқа қабылдандым, бірақ көңілім онша емес.
Dialogue: 0,0:52:42.72,0:52:43.94,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:52:44.34,0:52:46.65,Default,,0,0,0,,Бұл шын мәнінде цирк тыңдауы.
Dialogue: 0,0:52:46.65,0:52:48.39,Default,,0,0,0,,Оның рэпке қатысы бар ма?
Dialogue: 0,0:52:48.85,0:52:49.90,Default,,0,0,0,,Маған сән журналының түсірілімінде қолданылған осы киімді берді
Dialogue: 0,0:52:50.29,0:52:52.45,Default,,0,0,0,,Сіз дарынды екенсіз.
Dialogue: 0,0:52:52.45,0:52:54.43,Default,,0,0,0,,Ертең циркке келіңіз.
Dialogue: 0,0:52:54.43,0:52:56.15,Default,,0,0,0,,Жоқ, бұл жақсы.
Dialogue: 0,0:52:56.54,0:52:57.96,Default,,0,0,0,,Жаңа жұлдыздың тууы
Dialogue: 0,0:52:57.96,0:52:59.98,Default,,0,0,0,,Бірден жарнамалауға барайық.
Dialogue: 0,0:53:02.88,0:53:04.66,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:53:04.66,0:53:06.65,Default,,0,0,0,,Ұры
Dialogue: 0,0:53:07.09,0:53:08.66,Default,,0,0,0,,Жоқ, тіпті қазір де, егер рұқсат етсеңіз…
Dialogue: 0,0:53:20.09,0:53:22.73,Default,,0,0,0,,Мұнда ештеңе жоқ.
Dialogue: 0,0:53:25.11,0:53:26.58,Default,,0,0,0,,Іші бос
Dialogue: 0,0:53:27.04,0:53:29.00,Default,,0,0,0,,Мұнда да алма жоқ сияқты.
Dialogue: 0,0:53:31.29,0:53:33.40,Default,,0,0,0,,Сіз алма іздеп жүрсіз бе?
Dialogue: 0,0:53:39.65,0:53:41.00,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:53:41.24,0:53:43.03,Default,,0,0,0,,Бұл Чешир мысық.
Dialogue: 0,0:53:43.03,0:53:46.41,Default,,0,0,0,,Сақ болмасаң, тапсаң жейсің.
Dialogue: 0,0:53:46.66,0:53:48.90,Default,,0,0,0,,Менің алмамды білесің бе?
Dialogue: 0,0:53:49.44,0:53:52.13,Default,,0,0,0,,Білемін десем, білемін.
Dialogue: 0,0:53:52.13,0:53:54.92,Default,,0,0,0,,Білмесең, білмеймін деуге болады.
Dialogue: 0,0:53:54.92,0:53:56.95,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:53:58.55,0:54:00.16,Default,,0,0,0,,Эй Чешир мысық
Dialogue: 0,0:54:00.54,0:54:02.85,Default,,0,0,0,,Мен бұл аралдан қалай шығу керектігін білемін.
Dialogue: 0,0:54:03.15,0:54:05.81,Default,,0,0,0,,Тек келген жолмен қайтыңыз.
Dialogue: 0,0:54:05.81,0:54:07.89,Default,,0,0,0,,Менің қазанымды ұрлап кетті
Dialogue: 0,0:54:07.89,0:54:10.29,Default,,0,0,0,,Қанатты пайдаланып ұшу жақсы
Dialogue: 0,0:54:10.62,0:54:13.23,Default,,0,0,0,,Бірақ біздің қанатымыз жоқ.
Dialogue: 0,0:54:14.07,0:54:17.23,Default,,0,0,0,,Содан кейін аяқпен өтіңіз.
Dialogue: 0,0:54:17.23,0:54:19.41,Default,,0,0,0,,Жолда суға батып кету
Dialogue: 0,0:54:19.41,0:54:21.01,Default,,0,0,0,,Тек жүзіңіз
Dialogue: 0,0:54:21.32,0:54:23.28,Default,,0,0,0,,Мен түсінемін, бұл оңай.
Dialogue: 0,0:54:23.28,0:54:26.80,Default,,0,0,0,,Ол жерге қалай жеткеніңіз маңызды емес.
Dialogue: 0,0:54:27.09,0:54:28.76,Default,,0,0,0,,Қайда барғыңыз келеді?
Dialogue: 0,0:54:28.76,0:54:31.21,Default,,0,0,0,,Егер сізде ондай болса, сіз оған жете аласыз
Dialogue: 0,0:54:32.19,0:54:33.29,Default,,0,0,0,,Содан кейін, мысалы
Dialogue: 0,0:54:33.29,0:54:36.41,Default,,0,0,0,,Көлді розеткадан суырып алсаң, шомылғандай
Dialogue: 0,0:54:36.41,0:54:38.33,Default,,0,0,0,,Мүмкін мен сусыз жүре алатын шығармын
Dialogue: 0,0:54:38.33,0:54:39.55,Default,,0,0,0,,Жоқ, бұл қауіпті.
Dialogue: 0,0:54:39.55,0:54:41.21,Default,,0,0,0,,Сіз тырыспайынша білмейсіз
Dialogue: 0,0:54:41.21,0:54:43.11,Default,,0,0,0,,Менің киімім қайтадан суланып жатыр.
Dialogue: 0,0:54:43.11,0:54:44.58,Default,,0,0,0,,Жарайды, осымен бітті.
Dialogue: 0,0:54:44.58,0:54:46.30,Default,,0,0,0,,Суға батып кетсе не істеу керек
Dialogue: 0,0:54:46.56,0:54:48.27,Default,,0,0,0,,Жарайды, мен сенімдімін
Dialogue: 0,0:54:48.60,0:54:51.35,Default,,0,0,0,,Өйткені бұл жер ғажайып ел.
Dialogue: 0,0:54:52.80,0:54:54.41,Default,,0,0,0,,Кім көп көңілді болса, сол жеңеді.
Dialogue: 0,0:55:00.52,0:55:02.19,Default,,0,0,0,,Сен де кел, тұр.
Dialogue: 0,0:55:02.19,0:55:03.36,Default,,0,0,0,,Мен мұнда жүктеме болғым келмейді.
Dialogue: 0,0:55:05.39,0:55:06.79,Default,,0,0,0,,Бұл керемет ел
Dialogue: 0,0:55:06.79,0:55:07.97,Default,,0,0,0,,Мен жүзе аламын
Dialogue: 0,0:55:07.97,0:55:09.71,Default,,0,0,0,,Су астында міндетті түрде жүзе аласыз
Dialogue: 0,0:55:09.71,0:55:11.29,Default,,0,0,0,,Балық сияқты жүзіңіз
Dialogue: 0,0:55:27.00,0:55:28.64,Default,,0,0,0,,Мен жүзе аламын...
Dialogue: 0,0:55:28.64,0:55:30.41,Default,,0,0,0,,Мен жүзе аламын...
Dialogue: 0,0:55:30.41,0:55:32.09,Default,,0,0,0,,Тұр, бәрібір
Dialogue: 0,0:57:05.19,0:57:05.81,Default,,0,0,0,,Бұл
Dialogue: 0,0:57:09.82,0:57:11.83,Default,,0,0,0,,Тұр, бәрібір
Dialogue: 0,0:57:11.83,0:57:12.57,Default,,0,0,0,,Иә
Dialogue: 0,0:57:28.61,0:57:30.45,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:57:30.73,0:57:31.90,Default,,0,0,0,,(Отокоцудың дауысы)
Dialogue: 0,0:57:33.39,0:57:34.69,Default,,0,0,0,,Мұны орындаңыз
Dialogue: 0,0:57:37.09,0:57:38.18,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:57:49.60,0:57:51.67,Default,,0,0,0,,Бұл...менің
Dialogue: 0,0:57:52.02,0:57:53.69,Default,,0,0,0,,Сізге жақсы
Dialogue: 0,0:57:54.09,0:57:56.18,Default,,0,0,0,,Бәрі жақсы болды Риза
Dialogue: 0,0:58:14.84,0:58:17.24,Default,,0,0,0,,Бұл жерде түн ғана.
Dialogue: 0,0:58:17.24,0:58:20.02,Default,,0,0,0,,үшінның ұйықтап жатқанына сенімдімін.
Dialogue: 0,0:58:20.42,0:58:21.85,Default,,0,0,0,,Мен қараңғыдан қорықпаймын
Dialogue: 0,0:58:22.26,0:58:24.56,Default,,0,0,0,,Маған түнде ұнайды, өйткені мен түс көре аламын.
Dialogue: 0,0:58:25.03,0:58:28.59,Default,,0,0,0,,Футонның ішінде өте жақсы сезіледі, мен оны жақсы көремін.
Dialogue: 0,0:58:36.70,0:58:37.96,Default,,0,0,0,,Тұйық жол
Dialogue: 0,0:58:41.83,0:58:44.17,Default,,0,0,0,,Жұлдыздар өте әдемі
Dialogue: 0,0:58:55.54,0:58:57.14,Default,,0,0,0,,Мен мұнда жүктеме болғым келмейді.
Dialogue: 0,0:58:57.92,0:58:59.96,Default,,0,0,0,,Мен шөптің иісін жақсы көремін
Dialogue: 0,0:59:12.00,0:59:13.99,Default,,0,0,0,,Бұл рас, жақсы сезінеді.
Dialogue: 0,0:59:15.98,0:59:18.81,Default,,0,0,0,,Эй, Тұр, сен мұнда неге келдің?
Dialogue: 0,0:59:19.30,0:59:21.08,Default,,0,0,0,,Мені әжем шақырды
Dialogue: 0,0:59:35.35,0:59:37.20,Default,,0,0,0,,Ол керемет әже болды
Dialogue: 0,0:59:39.31,0:59:41.57,Default,,0,0,0,,Мен сені енді көре алмаймын
Dialogue: 0,0:59:45.92,0:59:46.77,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:59:48.71,0:59:50.12,Default,,0,0,0,,Ол қайтыс болды.
Dialogue: 0,1:00:15.56,1:00:16.81,Default,,0,0,0,,Уф…
Dialogue: 0,1:00:30.35,1:00:33.44,Default,,0,0,0,,Алма соншалықты маңызды ма?
Dialogue: 0,1:00:33.80,1:00:35.96,Default,,0,0,0,,Әй...
Dialogue: 0,1:00:35.96,1:00:39.31,Default,,0,0,0,,Бұл алма, бірақ ол алма емес...
Dialogue: 0,1:00:40.63,1:00:42.95,Default,,0,0,0,,Маған алмадан гөрі жүзім ұнайды.
Dialogue: 0,1:00:43.64,1:00:47.25,Default,,0,0,0,,Эй, Риздің ең маңыздысы не?
Dialogue: 0,1:00:47.82,1:00:49.42,Default,,0,0,0,,Мен Дина мысықпын
Dialogue: 0,1:00:49.71,1:00:51.90,Default,,0,0,0,,Ол жақсы бала, өйткені ол тыныш.
Dialogue: 0,1:00:53.44,1:00:55.22,Default,,0,0,0,,Мен үшін маңызды нәрсе...
Dialogue: 0,1:00:56.80,1:00:59.29,Default,,0,0,0,,Ең бастысы...
Dialogue: 0,1:01:11.75,1:01:15.54,Default,,0,0,0,,Менің бағалайтыным – ынтымақтастық.
Dialogue: 0,1:01:16.36,1:01:17.01,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:26.64,1:01:28.67,Default,,0,0,0,,Мен Райзаның дауысын естімеймін
Dialogue: 0,1:01:46.60,1:01:47.46,Default,,0,0,0,,Көтерілу?
Dialogue: 0,1:01:48.65,1:01:50.73,Default,,0,0,0,,Эй, бұл Rise, солай ма?
Dialogue: 0,1:01:51.29,1:01:52.99,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:53.42,1:01:55.70,Default,,0,0,0,,Ой... жоқ, бұл не?
Dialogue: 0,1:01:55.70,1:01:56.73,Default,,0,0,0,,Бұл болды
Dialogue: 0,1:01:57.10,1:02:00.34,Default,,0,0,0,,Райздың киімінде ақау бар.
Dialogue: 0,1:01:57.10,1:01:59.37,Default,,0,0,0,,Мен неге бұлай болып тұрмын...
Dialogue: 0,1:02:00.34,1:02:01.99,Default,,0,0,0,,Мына жақта, мына жақта
Dialogue: 0,1:02:02.32,1:02:03.20,Default,,0,0,0,,Біреу келе жатыр
Dialogue: 0,1:02:03.20,1:02:04.49,Default,,0,0,0,,Онда барыңыз
Dialogue: 0,1:02:11.80,1:02:12.31,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,1:02:12.31,1:02:13.66,Default,,0,0,0,,Тыныш болыңыз
Dialogue: 0,1:02:13.88,1:02:15.26,Default,,0,0,0,,Какари
Dialogue: 0,1:02:16.38,1:02:17.26,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,1:02:18.80,1:02:21.01,Default,,0,0,0,,Itata... тоқтатыңыз.
Dialogue: 0,1:02:23.82,1:02:25.38,Default,,0,0,0,,Тоқта
Dialogue: 0,1:02:27.58,1:02:29.06,Default,,0,0,0,,Оны да ұстаңыз.
Dialogue: 0,1:02:44.10,1:02:47.16,Default,,0,0,0,,Сіз бізді ұстағанда не істеуді жоспарлап отырсыз?
Dialogue: 0,1:02:47.16,1:02:49.72,Default,,0,0,0,,Патшайымның қалауы бойынша
Dialogue: 0,1:02:49.72,1:02:51.16,Default,,0,0,0,,Шидай Шидай
Dialogue: 0,1:03:23.85,1:03:25.20,Default,,0,0,0,,А, бос емес, бос емес
Dialogue: 0,1:03:25.20,1:03:26.70,Default,,0,0,0,,Сабаққа кедергі келтіп жатырсың, шығып кетші.
Dialogue: 0,1:03:28.61,1:03:30.16,Default,,0,0,0,,Тыныш, тыныш
Dialogue: 0,1:03:31.14,1:03:34.06,Default,,0,0,0,,Бұл... сот па?
Dialogue: 0,1:03:36.50,1:03:37.53,Default,,0,0,0,,Алиса…
Dialogue: 0,1:03:40.08,1:03:41.92,Default,,0,0,0,,Шығар, эй.
Dialogue: 0,1:03:41.92,1:03:43.61,Default,,0,0,0,,Тыныш болыңыз
Dialogue: 0,1:03:44.04,1:03:45.01,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,1:03:46.10,1:03:47.76,Default,,0,0,0,,Сот қазір басталады.
Dialogue: 0,1:03:47.76,1:03:50.06,Default,,0,0,0,,Айыпталушы Райс Азумино алға шығады
Dialogue: 0,1:03:50.75,1:03:52.25,Default,,0,0,0,,Жүр, жүр.
Dialogue: 0,1:04:03.66,1:04:04.74,Default,,0,0,0,,Құрметті төрағалық етуші
Dialogue: 0,1:04:04.74,1:04:08.27,Default,,0,0,0,,Мен бұл адамның кінәсін әшкерелейтін маңызды дәлелдер келтіремін.
Dialogue: 0,1:04:08.27,1:04:10.16,Default,,0,0,0,,Бұл бос уақыт, сондықтан екі есе жылдамдық.
Dialogue: 0,1:04:10.72,1:04:11.70,Default,,0,0,0,,Мен асығып тұрмын...
Dialogue: 0,1:04:12.13,1:04:13.29,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,1:04:13.94,1:04:16.08,Default,,0,0,0,,Мына алмаға қараңдар.
Dialogue: 0,1:04:16.08,1:04:18.32,Default,,0,0,0,,Оның мен бұрын көрмеген түсі мен пішіні бар.
Dialogue: 0,1:04:18.32,1:04:20.92,Default,,0,0,0,,Бұл дүниеден емес
Dialogue: 0,1:04:20.92,1:04:23.58,Default,,0,0,0,,Ғажайыптар әлеміне осындай қауіпті заттарды әкелу...
Dialogue: 0,1:04:23.58,1:04:24.55,Default,,0,0,0,,алынып тасталды
Dialogue: 0,1:04:24.55,1:04:26.22,Default,,0,0,0,,Бұл дұрыс, дұрыс.
Dialogue: 0,1:04:24.91,1:04:26.22,Default,,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,1:04:29.11,1:04:31.05,Default,,0,0,0,,Мен емес
Dialogue: 0,1:04:32.22,1:04:34.46,Default,,0,0,0,,Смартфоныңыз алмаға айналғаннан кейін
Dialogue: 0,1:04:34.46,1:04:37.40,Default,,0,0,0,,Ақ қоян кенет: «Бұл қиын!» - деді.
Dialogue: 0,1:04:37.40,1:04:39.48,Default,,0,0,0,,Мен оны өзіммен бірге алып кеттім.
Dialogue: 0,1:04:40.60,1:04:42.60,Default,,0,0,0,,Тыныш, тыныш
Dialogue: 0,1:04:43.72,1:04:46.32,Default,,0,0,0,,Сіз мүлде түсінбейсіз.
Dialogue: 0,1:04:46.89,1:04:49.74,Default,,0,0,0,,Менің күнәкарлығым...
Dialogue: 0,1:04:50.53,1:04:52.74,Default,,0,0,0,,Менің күнәм...?
Dialogue: 0,1:04:54.04,1:04:57.15,Default,,0,0,0,,Куә ретінде оны жақсы білетін адамды шақырыңыз.
Dialogue: 0,1:04:57.15,1:04:59.00,Default,,0,0,0,,Бірінші куәгер
Dialogue: 0,1:05:15.68,1:05:16.95,Default,,0,0,0,,Аомуши мырза...
Dialogue: 0,1:05:17.44,1:05:18.65,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,1:05:18.65,1:05:20.60,Default,,0,0,0,,Қалай қарасаң да, ол көбелек.
Dialogue: 0,1:05:20.60,1:05:23.94,Default,,0,0,0,,Қанаттары қандай тамаша, теріңіз де жылтыр емес пе?
Dialogue: 0,1:05:23.94,1:05:26.14,Default,,0,0,0,,Ой, мен Penstar ойнаймын.
Dialogue: 0,1:05:26.14,1:05:28.15,Default,,0,0,0,,Артынан шығайық... "Ұнады"
Dialogue: 0,1:05:37.89,1:05:40.42,Default,,0,0,0,,Оқиға болған күні қайда болдыңыз?
Dialogue: 0,1:05:40.42,1:05:43.92,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:05:43.92,1:05:46.20,Default,,0,0,0,,Сіз сотталушыны білесіз бе?
Dialogue: 0,1:05:46.61,1:05:49.74,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:05:51.81,1:05:55.08,Default,,0,0,0,,Әй, сен де көбелекке айналдың.
Dialogue: 0,1:05:55.08,1:05:57.47,Default,,0,0,0,,Ол мүлдем басқаша көрінеді.
Dialogue: 0,1:05:57.47,1:05:59.05,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,1:05:59.05,1:06:02.15,Default,,0,0,0,,Мен мұны білмей тұрып, мен осылай көріндім.
Dialogue: 0,1:06:02.15,1:06:05.29,Default,,0,0,0,,Мен түсіндім, өйткені Мен де солай болдым.
Dialogue: 0,1:06:05.71,1:06:06.71,Default,,0,0,0,,Бірақ эй
Dialogue: 0,1:06:07.15,1:06:09.00,Default,,0,0,0,,Бұл жақсы болуы мүмкін.
Dialogue: 0,1:06:09.48,1:06:12.44,Default,,0,0,0,,Енді мен осылай ойласам, бұл әлдеқайда оңай.
Dialogue: 0,1:06:12.94,1:06:15.89,Default,,0,0,0,,Егер сіз де өзіңізді қазіргідей қабылдауға тырыссаңыз
Dialogue: 0,1:06:18.04,1:06:19.22,Default,,0,0,0,,Керемет
Dialogue: 0,1:06:27.67,1:06:28.92,Default,,0,0,0,,Келесі куәгерлер
Dialogue: 0,1:06:32.43,1:06:34.85,Default,,0,0,0,,Сіз сотталушыны білесіз бе?
Dialogue: 0,1:06:34.85,1:06:35.77,Default,,0,0,0,,Жоқ
Dialogue: 0,1:06:35.77,1:06:37.85,Default,,0,0,0,,Мен мұндай құбыжықты бұрын көрген емеспін.
Dialogue: 0,1:06:41.78,1:06:42.41,Default,,0,0,0,,Мотой
Dialogue: 0,1:06:42.41,1:06:43.77,Default,,0,0,0,,Мен өте жақсы білемін
Dialogue: 0,1:06:43.77,1:06:45.83,Default,,0,0,0,,Біз шай ішу кезінде қысқа ғана кездестік.
Dialogue: 0,1:06:45.83,1:06:47.94,Default,,0,0,0,,Сотталушы жауыз ба?
Dialogue: 0,1:06:49.91,1:06:50.82,Default,,0,0,0,,Танымал жауаптар
Dialogue: 0,1:06:50.82,1:06:52.86,Default,,0,0,0,,Жазықсыз қылмыскер
Dialogue: 0,1:06:53.34,1:06:56.69,Default,,0,0,0,,Мүмкін ол Дормус мырзаның нұсқауы бойынша сөйлеп тұрған шығар?
Dialogue: 0,1:06:59.78,1:07:01.95,Default,,0,0,0,,Тышқанның айтқаны мүлдем дұрыс.
Dialogue: 0,1:07:01.95,1:07:03.41,Default,,0,0,0,,Мен қарсы тұруға қорқамын
Dialogue: 0,1:07:08.21,1:07:11.50,Default,,0,0,0,,Бұл...итатата...
Dialogue: 0,1:07:11.50,1:07:13.05,Default,,0,0,0,,Итататата...
Dialogue: 0,1:07:11.94,1:07:13.05,Default,,0,0,0,,Не болды?
Dialogue: 0,1:07:13.05,1:07:15.56,Default,,0,0,0,,Менің ішім ауырады
Dialogue: 0,1:07:14.86,1:07:15.56,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:16.28,1:07:18.02,Default,,0,0,0,,Ауырды
Dialogue: 0,1:07:22.90,1:07:25.08,Default,,0,0,0,,Егер сіз байыпты болу дұрыс деп ойласаңыз, сіз үлкен қателік жасайсыз.
Dialogue: 0,1:07:25.08,1:07:27.11,Default,,0,0,0,,Парасаттылық - үлкен мазасыздық
Dialogue: 0,1:07:27.31,1:07:30.38,Default,,0,0,0,,Мен айналамдағыларға жайсыздық тудырып жатқанымды түсінбедім.
Dialogue: 0,1:07:30.38,1:07:32.34,Default,,0,0,0,,Айыпталушы әлі де кінәлі
Dialogue: 0,1:07:32.34,1:07:35.03,Default,,0,0,0,,Мен тек сіз сұрағаныңыз үшін көмектестім.
Dialogue: 0,1:07:36.15,1:07:37.92,Default,,0,0,0,,Тыныш, тыныш
Dialogue: 0,1:07:37.92,1:07:39.87,Default,,0,0,0,,Соңғы куәгерді шақырыңыз
Dialogue: 0,1:07:40.19,1:07:41.37,Default,,0,0,0,,Иә
Dialogue: 0,1:07:42.72,1:07:43.37,Default,,0,0,0,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,1:07:43.62,1:07:45.10,Default,,0,0,0,,Куәгер көрінбейді
Dialogue: 0,1:07:51.49,1:07:55.13,Default,,0,0,0,,Соңғы куәгер - сотталушыны жақсы білетін Ринго.
Dialogue: 0,1:07:55.13,1:07:55.87,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:56.70,1:07:59.52,Default,,0,0,0,,Мен әдетте сөйлей бермеймін, өйткені менде шухигим бар.
Dialogue: 0,1:07:59.52,1:08:00.81,Default,,0,0,0,,Бүгін Токубетсу
Dialogue: 0,1:08:01.74,1:08:05.78,Default,,0,0,0,,Мен ескерткенімдей, ол алмадан абай бол.
Dialogue: 0,1:08:06.23,1:08:07.19,Default,,0,0,0,,Чешир мысық
Dialogue: 0,1:08:07.53,1:08:09.69,Default,,0,0,0,,Мен куәгерден сұраймын
Dialogue: 0,1:08:09.69,1:08:11.17,Default,,0,0,0,,6+1 ай…
Dialogue: 0,1:08:11.17,1:08:15.57,Default,,0,0,0,,Сотталушы «лайк» түймесін 83 рет басқан.
Dialogue: 0,1:08:17.12,1:08:17.70,Default,,0,0,0,,Иә
Dialogue: 0,1:08:17.89,1:08:20.23,Default,,0,0,0,,Мұның несі жақсы?
Dialogue: 0,1:08:20.94,1:08:22.45,Default,,0,0,0,,үшін мұны істеп жатыр
Dialogue: 0,1:08:22.75,1:08:24.16,Default,,0,0,0,,«үшін» деген кім?
Dialogue: 0,1:08:24.83,1:08:26.93,Default,,0,0,0,,Итататата...
Dialogue: 0,1:08:27.63,1:08:29.54,Default,,0,0,0,,Не болды? Сенімен бәрі жақсы ма?
Dialogue: 0,1:08:28.44,1:08:29.54,Default,,0,0,0,,Асығыңыз, асығыңыз
Dialogue: 0,1:08:29.83,1:08:31.71,Default,,0,0,0,,Күте тұрыңыз, мен қазір барамын.
Dialogue: 0,1:08:33.17,1:08:36.88,Default,,0,0,0,,Жүрек ханшайымы ашуланғанда қорқынышты болады.
Dialogue: 0,1:08:49.06,1:08:50.84,Default,,0,0,0,,Келесі күні әрі қарай
Dialogue: 0,1:08:50.84,1:08:53.76,Default,,0,0,0,,Маған университет лекциясында маңызды сұрақ қойылса да.
Dialogue: 0,1:08:53.76,1:08:55.24,Default,,0,0,0,,Профессордан сұрамады
Dialogue: 0,1:08:55.42,1:08:56.74,Default,,0,0,0,,Мен ерекшеленгім келмейді.
Dialogue: 0,1:08:56.74,1:08:58.44,Default,,0,0,0,,Өте абайсыздық
Dialogue: 0,1:08:58.44,1:09:02.24,Default,,0,0,0,,Мен әлсіреп жүрсем де, осы уақыт ішінде өзімді ақтап алдым.
Dialogue: 0,1:09:02.82,1:09:03.99,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,1:09:03.99,1:09:05.83,Default,,0,0,0,,Бұл кешірім сұрауға арналған баспасөз конференциясының мәселесі.
Dialogue: 0,1:09:06.24,1:09:08.32,Default,,0,0,0,,Жоқ... қарсылық
Dialogue: 0,1:09:10.08,1:09:12.21,Default,,0,0,0,,Сот талқылауы дегеніміз не? Фарс
Dialogue: 0,1:09:12.56,1:09:15.46,Default,,0,0,0,,Сіз туралы ешкім ойламайды
Dialogue: 0,1:09:15.76,1:09:18.91,Default,,0,0,0,,Біреудің сөзіне қарап бағаланасың
Dialogue: 0,1:09:18.91,1:09:19.48,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:19.72,1:09:23.72,Default,,0,0,0,,Мен барлық компанияларға өтірік айтып, ''Сіздің компанияңыз - менің бірінші таңдауым'' дедім.
Dialogue: 0,1:09:23.72,1:09:25.72,Default,,0,0,0,,Бұл дұрыс деп ойлайсың ба?
Dialogue: 0,1:09:25.98,1:09:27.02,Default,,0,0,0,,Не болды?
Dialogue: 0,1:09:27.02,1:09:28.48,Default,,0,0,0,,Не болды?
Dialogue: 0,1:09:28.48,1:09:31.12,Default,,0,0,0,,Сонымен қатар, стрессті жеңілдету үшін
Dialogue: 0,1:09:31.12,1:09:34.06,Default,,0,0,0,,Түнде түнде барлық бейкүнә зомбилерді өлтірді
Dialogue: 0,1:09:34.06,1:09:37.09,Default,,0,0,0,,Иә, барлығы 75379 дене.
Dialogue: 0,1:09:37.44,1:09:39.07,Default,,0,0,0,,Мен мұны күн сайын жасаймын
Dialogue: 0,1:09:39.22,1:09:40.63,Default,,0,0,0,,Сенің есі дұрыс па?
Dialogue: 0,1:09:40.63,1:09:41.57,Default,,0,0,0,,Көп емес
Dialogue: 0,1:09:41.57,1:09:43.16,Default,,0,0,0,,Не деген сұмдық.
Dialogue: 0,1:09:43.16,1:09:44.58,Default,,0,0,0,,Ұят болды
Dialogue: 0,1:09:52.27,1:09:55.50,Default,,0,0,0,,Мен не үшін сотталып жатырмын?
Dialogue: 0,1:09:56.61,1:09:58.00,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,1:09:58.00,1:09:58.55,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:59.20,1:10:02.38,Default,,0,0,0,,«Ұнады» дұрыстап, атмосфераны мұқият оқып шығыңыз
Dialogue: 0,1:10:02.38,1:10:05.10,Default,,0,0,0,,Жақсы бала болмасаң, сәтсіздікке ұшырайсың.
Dialogue: 0,1:10:06.10,1:10:08.46,Default,,0,0,0,,Сіз басқалармен бірдей әрекет жасайсыз.
Dialogue: 0,1:10:08.46,1:10:10.10,Default,,0,0,0,,Жақсы емес, солай ма?
Dialogue: 0,1:10:11.29,1:10:14.42,Default,,0,0,0,,Емдеу құралы
Dialogue: 0,1:10:14.42,1:10:16.26,Default,,0,0,0,,Емдеу шаралары...
Dialogue: 0,1:10:15.06,1:10:15.98,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:10:16.26,1:10:17.61,Default,,0,0,0,,Сенің арқасында тіпті трусигім де суға малып кетті. О, Құдай-ай…
Dialogue: 0,1:10:17.61,1:10:19.61,Default,,0,0,0,,Тапсырма тапсырмалары
Dialogue: 0,1:10:19.61,1:10:22.57,Default,,0,0,0,,Енді, Мәртебелі, үкіміңізді айтыңыз.
Dialogue: 0,1:10:35.97,1:10:37.63,Default,,0,0,0,,Басыңды кес
Dialogue: 0,1:10:41.13,1:10:43.76,Default,,0,0,0,,Кінәлі Кінәлі Өте кінәлі
Dialogue: 0,1:10:50.95,1:10:53.03,Default,,0,0,0,,Ешкімге қиындық тудырмау
Dialogue: 0,1:10:53.47,1:10:57.23,Default,,0,0,0,,Мен қуып жету үшін бар күшімді салуым керек.
Dialogue: 0,1:10:57.94,1:11:00.32,Default,,0,0,0,,Мен неге сонша...
Dialogue: 0,1:11:01.14,1:11:01.95,Default,,0,0,0,,Көтерілу
Dialogue: 0,1:11:05.70,1:11:07.45,Default,,0,0,0,,Юзай Юзай
Dialogue: 0,1:11:06.45,1:11:08.15,Default,,0,0,0,,Сен аузыңды жап
Dialogue: 0,1:11:10.45,1:11:13.50,Default,,0,0,0,,Юзай Юзай…
Dialogue: 0,1:11:13.50,1:11:14.88,Default,,0,0,0,,Маңызды дәлелдер...
Dialogue: 0,1:11:14.88,1:11:15.83,Default,,0,0,0,,Мені ұстаңыз
Dialogue: 0,1:11:15.83,1:11:16.88,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,1:11:16.88,1:11:17.92,Default,,0,0,0,,Сәлем
Dialogue: 0,1:11:19.10,1:11:21.05,Default,,0,0,0,,Алисаның да басын кесіңіз.
Dialogue: 0,1:11:21.47,1:11:23.30,Default,,0,0,0,,Юзай Юзай…
Dialogue: 0,1:11:23.56,1:11:25.97,Default,,0,0,0,,Неге...жақсы емес?
Dialogue: 0,1:11:27.28,1:11:29.31,Default,,0,0,0,,Маған не болды?
Dialogue: 0,1:11:29.31,1:11:31.10,Default,,0,0,0,,Мен бәрін білемін.
Dialogue: 0,1:11:31.10,1:11:32.56,Default,,0,0,0,,Нені түсіндің?
Dialogue: 0,1:11:33.06,1:11:35.22,Default,,0,0,0,,Мен туралы не білесің?
Dialogue: 0,1:11:35.90,1:11:39.69,Default,,0,0,0,,Мен әлі өзімді білмеймін.
Dialogue: 0,1:11:41.08,1:11:42.65,Default,,0,0,0,,Бұл мәселе болды, солай емес пе?
Dialogue: 0,1:11:43.69,1:11:45.56,Default,,0,0,0,,Қосымша күтім
Dialogue: 0,1:11:45.56,1:11:48.17,Default,,0,0,0,,Бұл ең...
Dialogue: 0,1:11:48.17,1:11:49.57,Default,,0,0,0,,Мазасыз
Dialogue: 0,1:11:50.09,1:11:52.16,Default,,0,0,0,,Қысқа уақытта және сөзбен...
Dialogue: 0,1:11:52.16,1:11:55.42,Default,,0,0,0,,Сөзімді кесіп, байлама
Dialogue: 0,1:11:59.10,1:12:00.41,Default,,0,0,0,,Марияның шабуылында болғанда
Dialogue: 0,1:12:06.59,1:12:08.07,Default,,0,0,0,,Бұл қиын. Ол қатты.
Dialogue: 0,1:12:08.07,1:12:09.56,Default,,0,0,0,,Ол жарылып кетеді
Dialogue: 0,1:12:09.56,1:12:11.43,Default,,0,0,0,,Мені ұстаңыз
Dialogue: 0,1:12:14.69,1:12:15.91,Default,,0,0,0,,Алиса, қаш
Dialogue: 0,1:12:16.69,1:12:18.92,Default,,0,0,0,,Енді маған қатысың жоқ
Dialogue: 0,1:12:31.56,1:12:32.58,Default,,0,0,0,,Бұл
Dialogue: 0,1:12:33.55,1:12:34.55,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,1:12:34.55,1:12:36.38,Default,,0,0,0,,Көтерілу жоғалды
Dialogue: 0,1:12:36.38,1:12:37.87,Default,,0,0,0,,Қайда жоғалып кетті?
Dialogue: 0,1:13:10.90,1:13:13.67,Default,,0,0,0,,Риз Азумино қайда кетті?
Dialogue: 0,1:13:15.09,1:13:17.14,Default,,0,0,0,,Әр бұрышты іздеңіз
Dialogue: 0,1:13:17.57,1:13:19.45,Default,,0,0,0,,Оны жіберіп алмаңыз
Dialogue: 0,1:13:49.60,1:13:53.35,Default,,0,0,0,,Тез таппасаң, басыңды кесіп тастайды.
Dialogue: 0,1:13:55.47,1:13:57.73,Default,,0,0,0,,Тек іздеуді жалғастырайық.
Dialogue: 0,1:13:58.03,1:13:59.00,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:14:02.75,1:14:06.15,Default,,0,0,0,,Мен бастапқы пішініме орала аламын ба?
Dialogue: 0,1:14:06.55,1:14:07.86,Default,,0,0,0,,Өтінемін, Ятоны құтқарыңдар!
Dialogue: 0,1:14:10.19,1:14:11.60,Default,,0,0,0,,Сіз мені көре аласыз ба?
Dialogue: 0,1:14:12.37,1:14:14.89,Default,,0,0,0,,Көргің келсе, анық көруге болады.
Dialogue: 0,1:14:14.89,1:14:17.10,Default,,0,0,0,,Көргің келмесе, көре алмайсың.
Dialogue: 0,1:14:17.48,1:14:20.47,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:14:20.98,1:14:22.83,Default,,0,0,0,,Қарапайым заттар
Dialogue: 0,1:14:22.83,1:14:25.11,Default,,0,0,0,,Бұл дүниені тастап кет.
Dialogue: 0,1:14:25.57,1:14:28.28,Default,,0,0,0,,Қайтқанда бәрі жоғалады.
Dialogue: 0,1:14:28.28,1:14:31.29,Default,,0,0,0,,Бұл көзге киген нәрсені шешіп ал.
Dialogue: 0,1:14:31.78,1:14:32.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:34.97,1:14:37.51,Default,,0,0,0,,Екі бірдей сапар болмайды
Dialogue: 0,1:14:37.51,1:14:40.36,Default,,0,0,0,,Келесі кездескенімізде бұл жаңа дүние болады
Dialogue: 0,1:14:41.39,1:14:43.44,Default,,0,0,0,,Бүгінгі Алиса кім?
Dialogue: 0,1:14:44.59,1:14:46.18,Default,,0,0,0,,Біз енді ешқашан кездесе алмаймыз
Dialogue: 0,1:14:47.88,1:14:51.68,Default,,0,0,0,,Чешир мысық, Алиса қайда кеткенін білесің бе?
Dialogue: 0,1:14:51.93,1:14:54.26,Default,,0,0,0,,Енді ол қайда?
Dialogue: 0,1:14:54.47,1:14:58.05,Default,,0,0,0,,Мен Алисаны көргім келеді. Мен бұлай үйге бара алмаймын.
Dialogue: 0,1:15:06.32,1:15:08.19,Default,,0,0,0,,Біртүрлі бала екенсің.
Dialogue: 0,1:15:08.60,1:15:13.58,Default,,0,0,0,,Кездеспесең жүрегіңде ұзақ сақталады.
Dialogue: 0,1:16:22.87,1:16:26.31,Default,,0,0,0,,Міне, әжелер бақшасында
Dialogue: 0,1:16:47.96,1:16:49.17,Default,,0,0,0,,Әже...
Dialogue: 0,1:16:49.76,1:16:51.25,Default,,0,0,0,,Әже
Dialogue: 0,1:16:52.25,1:16:55.03,Default,,0,0,0,,Әже, қарашы, қарашы
Dialogue: 0,1:16:55.03,1:16:56.26,Default,,0,0,0,,Эй!
Dialogue: 0,1:16:58.40,1:16:59.44,Default,,0,0,0,,Жақсы
Dialogue: 0,1:16:59.44,1:17:00.76,Default,,0,0,0,,Сол жерден табылды
Dialogue: 0,1:17:01.79,1:17:03.24,Default,,0,0,0,,Сүйкімді
Dialogue: 0,1:17:03.64,1:17:05.54,Default,,0,0,0,,Маған кесіртке ұнайды
Dialogue: 0,1:17:05.54,1:17:06.17,Default,,0,0,0,,Иә
Dialogue: 0,1:17:06.78,1:17:10.66,Default,,0,0,0,,Бірақ ол сыныптағы барлық достарын жек көретінін айтады.
Dialogue: 0,1:17:10.88,1:17:12.56,Default,,0,0,0,,Сондықтан мен оны құпия ұстаймын
Dialogue: 0,1:17:13.46,1:17:16.12,Default,,0,0,0,,Маған құпияны айтқаныңызға рахмет
Dialogue: 0,1:17:16.45,1:17:19.29,Default,,0,0,0,,Керісінше мен саған сырымды айтайын.
Dialogue: 0,1:17:19.62,1:17:20.52,Default,,0,0,0,,Эй!
Dialogue: 0,1:17:22.62,1:17:27.63,Default,,0,0,0,,Бір күні мен өзімнің сүйікті таңғажайып елімді құрғым келеді.
Dialogue: 0,1:17:27.99,1:17:30.75,Default,,0,0,0,,Уау, керемет
Dialogue: 0,1:17:31.01,1:17:34.95,Default,,0,0,0,,Орындаған соң, мен бірінші болып Ризді шақырамын.
Dialogue: 0,1:17:34.95,1:17:36.30,Default,,0,0,0,,Ой! Ол бұрыштан айналып кетті!
Dialogue: 0,1:17:41.47,1:17:42.76,Default,,0,0,0,,(Нишики) Бұл... осы туралы сұрауға мен дұрыс адаммын ба?
Dialogue: 0,1:17:43.28,1:17:45.58,Default,,0,0,0,,Қиын нәрсе болған кезде
Dialogue: 0,1:17:46.23,1:17:49.75,Default,,0,0,0,,Мен өзімнің сүйікті ғажайыптар әлеміне қашып бара жаттым.
Dialogue: 0,1:17:50.35,1:17:54.32,Default,,0,0,0,,Өзіңіз жақсы көретін нәрселердің айналасында болу сізді жақсы сезінеді.
Dialogue: 0,1:17:54.91,1:17:55.61,Default,,0,0,0,,Иә
Dialogue: 0,1:17:57.46,1:18:01.21,Default,,0,0,0,,Өзіңізді жақсы сезінген кезде, әдеттегі өміріңізге оралыңыз.
Dialogue: 0,1:18:01.80,1:18:03.62,Default,,0,0,0,,Қайта қиындап барады...
Dialogue: 0,1:18:04.15,1:18:06.12,Default,,0,0,0,,Осындай нәрсені қайталау
Dialogue: 0,1:18:07.32,1:18:10.63,Default,,0,0,0,,Егер біз шынымен де ғажайыптар әлемін жасай алсақ
Dialogue: 0,1:18:10.63,1:18:12.94,Default,,0,0,0,,Бұл қаншалықты жақсы болар еді деп ойлайсыз?
Dialogue: 0,1:18:13.83,1:18:16.46,Default,,0,0,0,,Менің соңғы өзімшілдігім.
Dialogue: 0,1:18:17.03,1:18:19.58,Default,,0,0,0,,Өзгенің сөзіне еріп кету
Dialogue: 0,1:18:19.58,1:18:23.64,Default,,0,0,0,,Басқалардың айтқанын тыңдай берсем, тұншығып қаламын.
Dialogue: 0,1:18:24.66,1:18:27.51,Default,,0,0,0,,Риз жақсы қыз, сондықтан мен біраз уайымдап тұрмын.
Dialogue: 0,1:18:29.62,1:18:32.76,Default,,0,0,0,,Райздың «лайктарын» күтіңіз
Dialogue: 0,1:18:33.53,1:18:37.48,Default,,0,0,0,,Осылай жасасаң, әр күнім қызық болатынына сенімдімін.
Dialogue: 0,1:18:38.09,1:18:39.27,Default,,0,0,0,,Мен ғой, мен…-сан ба?
Dialogue: 0,1:18:42.91,1:18:45.24,Default,,0,0,0,,Саусақпен кесу Генман
Dialogue: 0,1:18:45.24,1:18:50.59,Default,,0,0,0,,Өтірік айтсаң, мың ине жұтамын.
Dialogue: 0,1:18:51.01,1:18:52.87,Default,,0,0,0,,Мен саусағымды кесіп алдым
Dialogue: 0,1:18:54.38,1:18:55.78,Default,,0,0,0,,Әже...
Dialogue: 0,1:19:17.62,1:19:18.54,Default,,0,0,0,,Алиса
Dialogue: 0,1:19:22.45,1:19:23.32,Default,,0,0,0,,Алиса
Dialogue: 0,1:19:44.53,1:19:45.81,Default,,0,0,0,,көтерілу?
Dialogue: 0,1:19:46.45,1:19:47.63,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,1:19:48.41,1:19:50.09,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,1:19:51.20,1:19:52.23,Default,,0,0,0,,Мен осындамын
Dialogue: 0,1:19:53.93,1:19:56.21,Default,,0,0,0,,Мен көрінбей, қашып кеттім.
Dialogue: 0,1:19:58.44,1:19:59.59,Default,,0,0,0,,Мен таң қалмадым
Dialogue: 0,1:20:00.16,1:20:03.02,Default,,0,0,0,,Біртүрлі айдаһар болып қалудың орнына
Dialogue: 0,1:20:03.02,1:20:04.35,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:20:04.35,1:20:05.15,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:20:06.99,1:20:09.87,Default,,0,0,0,,Алманы лақтырып жіберейін деп едім, бірақ
Dialogue: 0,1:20:10.18,1:20:11.65,Default,,0,0,0,,Жоғалу...
Dialogue: 0,1:20:12.19,1:20:14.83,Default,,0,0,0,,Сізді қатысқаным үшін кешіріңіз.
Dialogue: 0,1:20:15.04,1:20:16.68,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,1:20:16.68,1:20:17.79,Default,,0,0,0,,Рисеха
Dialogue: 0,1:20:21.79,1:20:23.65,Default,,0,0,0,,Ешкім байқамайды
Dialogue: 0,1:20:24.29,1:20:27.18,Default,,0,0,0,,Ыңғайлы, бірақ аздап жалғыз
Dialogue: 0,1:20:27.96,1:20:31.84,Default,,0,0,0,,Қол-аяғымның қандай болғаны есімде жоқ.
Dialogue: 0,1:20:33.19,1:20:36.10,Default,,0,0,0,,Маған Ризаның қара көздері ұнайды
Dialogue: 0,1:20:36.10,1:20:36.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:37.58,1:20:41.27,Default,,0,0,0,,Қар жауғаннан кейінгі түнгі аспандай жарқырап тұр
Dialogue: 0,1:20:41.50,1:20:42.82,Default,,0,0,0,,Өте әдемі
Dialogue: 0,1:20:44.13,1:20:45.29,Default,,0,0,0,,Рахмет
Dialogue: 0,1:20:46.53,1:20:48.37,Default,,0,0,0,,Сіз де бірдеңе айтуыңыз керек.
Dialogue: 0,1:20:51.08,1:20:53.08,Default,,0,0,0,,Кіші құлақшалар...
Dialogue: 0,1:20:53.29,1:20:54.00,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,1:20:57.79,1:20:59.60,Default,,0,0,0,,Rise нені ұнатады?
Dialogue: 0,1:21:00.90,1:21:02.50,Default,,0,0,0,,Маған Көтерілу туралы айтып беріңіз
Dialogue: 0,1:21:03.81,1:21:05.34,Default,,0,0,0,,Жақсы
Dialogue: 0,1:21:09.33,1:21:10.80,Default,,0,0,0,,Сіздің сүйікті гүліңіз қандай?
Dialogue: 0,1:21:13.41,1:21:14.94,Default,,0,0,0,,Ақ беде
Dialogue: 0,1:21:14.94,1:21:16.48,Default,,0,0,0,,Раушан гүлі немесе басқа нәрсе емес.
Dialogue: 0,1:21:17.05,1:21:19.54,Default,,0,0,0,,Маған оның кішкентай және көзге көрінбейтіндігі ұнайды.
Dialogue: 0,1:21:19.97,1:21:22.07,Default,,0,0,0,,Мен тәж жасайтынмын.
Dialogue: 0,1:21:22.58,1:21:24.11,Default,,0,0,0,,Сондай ностальгиялық
Dialogue: 0,1:21:24.37,1:21:26.01,Default,,0,0,0,,Сіздің сүйікті жаратылысыңыз қандай?
Dialogue: 0,1:21:26.33,1:21:28.32,Default,,0,0,0,,Жылтыр көк кесіртке
Dialogue: 0,1:21:28.32,1:21:29.00,Default,,0,0,0,,Иә
Dialogue: 0,1:21:29.44,1:21:31.43,Default,,0,0,0,,Мен оны кішкентайымнан жақсы көремін.
Dialogue: 0,1:21:31.96,1:21:33.66,Default,,0,0,0,,Әй, жақсы.
Dialogue: 0,1:21:33.95,1:21:36.27,Default,,0,0,0,,Мен кесірткелерді жек көремін
Dialogue: 0,1:21:36.27,1:21:37.04,Default,,0,0,0,,Иә
Dialogue: 0,1:21:37.65,1:21:41.17,Default,,0,0,0,,Менің сүйікті жаратылысым – Дина мысық.
Dialogue: 0,1:21:41.50,1:21:45.64,Default,,0,0,0,,Динаның табанынан попкорнның иісі бар.
Dialogue: 0,1:21:45.64,1:21:46.81,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,1:21:47.72,1:21:49.68,Default,,0,0,0,,Саған тағы не ұнайды?
Dialogue: 0,1:21:50.17,1:21:51.07,Default,,0,0,0,,Ал...
Dialogue: 0,1:21:52.37,1:21:54.62,Default,,0,0,0,,Қысқа торт Мен кәдімгі күні сатып аламын
Dialogue: 0,1:21:54.95,1:21:58.69,Default,,0,0,0,,Көмек көрсеткені үшін сыйлық ретінде жаңа піскен балмұздақ
Dialogue: 0,1:21:59.06,1:22:00.24,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,1:22:00.76,1:22:03.31,Default,,0,0,0,,Чирименжако араласқан кішкентай краб?
Dialogue: 0,1:22:03.31,1:22:04.16,Default,,0,0,0,,Шаян?
Dialogue: 0,1:22:04.52,1:22:08.95,Default,,0,0,0,,Маған В дәрежелі арзан қорқынышты фильмдер де ұнайды.
Dialogue: 0,1:22:10.24,1:22:14.46,Default,,0,0,0,,Менің құпия хоббиім ваннаға түскеннен кейін зомби ойындарын ойнау.
Dialogue: 0,1:22:14.46,1:22:17.41,Default,,0,0,0,,Мен ойынды тазалағаннан кейін бірнеше рет ойнадым.
Dialogue: 0,1:22:17.85,1:22:19.19,Default,,0,0,0,,Қызық екен
Dialogue: 0,1:22:19.19,1:22:20.54,Default,,0,0,0,,Бұл біртүрлі, солай емес пе?
Dialogue: 0,1:22:21.08,1:22:23.04,Default,,0,0,0,,Бірақ бұл Rise, солай ма?
Dialogue: 0,1:22:23.30,1:22:23.83,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:27.81,1:22:30.23,Default,,0,0,0,,Маған да шаштарым мінсіз болған күндер ұнайды
Dialogue: 0,1:22:30.62,1:22:33.45,Default,,0,0,0,,Маған анамның шашымды тарағаны ұнайды.
Dialogue: 0,1:22:34.04,1:22:37.93,Default,,0,0,0,,Велосипедсіз ұзақ еңіспен төмен түсу
Dialogue: 0,1:22:37.93,1:22:42.08,Default,,0,0,0,,Ұзын баспалдақтың тұтқасынан өту және төмен сырғанау.
Dialogue: 0,1:22:42.81,1:22:44.09,Default,,0,0,0,,Мен ашуланатын сияқтымын
Dialogue: 0,1:22:44.09,1:22:45.72,Default,,0,0,0,,Иә, мен ашуланамын.
Dialogue: 0,1:22:48.81,1:22:53.28,Default,,0,0,0,,Маған қызметші Нэнсидің киімдерді үтіктеп жатқанын көрген ұнайды.
Dialogue: 0,1:22:53.53,1:22:56.95,Default,,0,0,0,,Маған жол бойына созылған құлаған жапырақтарды басқан ұнайды.
Dialogue: 0,1:22:57.77,1:23:01.69,Default,,0,0,0,,Маған күннің батқаны емес, қызғылт күннің батуы ұнайды.
Dialogue: 0,1:23:02.16,1:23:05.86,Default,,0,0,0,,Менің ата-анамның үйінен тау үстіндегі үлкен найзағай бұлттары көрінеді
Dialogue: 0,1:23:06.39,1:23:10.32,Default,,0,0,0,,Ал бос туннельдің арғы жағындағы балғын жасыл желектер.
Dialogue: 0,1:23:10.68,1:23:15.03,Default,,0,0,0,,Маған балконнан көрінетін қысқы түнгі аспанның үлкен алтыбұрышты пішіні де ұнады.
Dialogue: 0,1:23:15.36,1:23:20.04,Default,,0,0,0,,Қыста тастарды каминге жағып, бір шелек суға тастайды.
Dialogue: 0,1:23:20.04,1:23:22.85,Default,,0,0,0,,Ең жақсысы - оны шытырлату.
Dialogue: 0,1:23:22.85,1:23:24.15,Default,,0,0,0,,Жаздың ыстық күнінде
Dialogue: 0,1:23:24.15,1:23:27.03,Default,,0,0,0,,Мұздың орнына мұздатылған лимондарды сидрге қосыңыз.
Dialogue: 0,1:23:27.03,1:23:29.44,Default,,0,0,0,,Ең дұрысы оны шытырлату керек
Dialogue: 0,1:23:29.86,1:23:33.95,Default,,0,0,0,,Маған үлпілдек, жаңа кептірілген орамалдағы күннің иісі ұнайды.
Dialogue: 0,1:23:34.25,1:23:37.41,Default,,0,0,0,,Маған жаңа жауған асфальттың иісі ұнайды.
Dialogue: 0,1:23:37.61,1:23:41.23,Default,,0,0,0,,Маған да құдық түбіне дейін қатты айқайлаған ұнайды.
Dialogue: 0,1:23:41.52,1:23:43.37,Default,,0,0,0,,Дыбыс жаңғырық береді
Dialogue: 0,1:23:45.92,1:23:47.88,Default,,0,0,0,,Менің сүйікті дыбысым...
Dialogue: 0,1:23:51.89,1:23:57.47,Default,,0,0,0,,Әжем қастерлеген ескі музыкалық қораптың үні
Dialogue: 0,1:24:02.41,1:24:03.31,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,1:24:04.55,1:24:06.65,Default,,0,0,0,,Маған ұнайтын нәрселер көп
Dialogue: 0,1:24:09.19,1:24:11.36,Default,,0,0,0,,Көтерілу қалыпты жағдайға оралды
Dialogue: 0,1:24:12.05,1:24:12.59,Default,,0,0,0,,Ха
Dialogue: 0,1:24:16.68,1:24:17.60,Default,,0,0,0,,Көтерілу
Dialogue: 0,1:24:19.18,1:24:21.49,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,1:24:21.99,1:24:24.25,Default,,0,0,0,,Рахмет Алиса
Dialogue: 0,1:24:27.35,1:24:29.50,Default,,0,0,0,,Эй, фотоға түсіре аласың ба?
Dialogue: 0,1:24:31.35,1:24:32.04,Default,,0,0,0,,Иә
Dialogue: 0,1:24:36.54,1:24:39.25,Default,,0,0,0,,Чешир мысығы Мен білмей тұрып
Dialogue: 0,1:24:42.89,1:24:45.40,Default,,0,0,0,,Үйге кететін уақыт жеткен сияқты
Dialogue: 0,1:24:58.49,1:25:01.78,Default,,0,0,0,,Құттықтаймыз Құттықтаймыз...
Dialogue: 0,1:25:02.08,1:25:06.08,Default,,0,0,0,,Құттықтаймыз Құттықтаймыз...
Dialogue: 0,1:25:10.60,1:25:11.66,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:25:11.99,1:25:13.96,Default,,0,0,0,,Мен мүлде түсінбеймін
Dialogue: 0,1:25:13.96,1:25:16.79,Default,,0,0,0,,Бұл дүние әдетте ақымақ
Dialogue: 0,1:25:19.47,1:25:21.60,Default,,0,0,0,,Алиса енді не істейді?
Dialogue: 0,1:25:22.11,1:25:24.12,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,1:25:24.12,1:25:26.35,Default,,0,0,0,,Жауабы жоқ жұмбақпен бірдей
Dialogue: 0,1:25:26.93,1:25:30.36,Default,,0,0,0,,Қызықты оқиғалар күнде болады, сондықтан мен ешқашан жалықпаймын.
Dialogue: 0,1:25:35.59,1:25:37.80,Default,,0,0,0,,Екеуміз көбірек бірге болғанымызды қалаймын.
Dialogue: 0,1:25:39.07,1:25:40.74,Default,,0,0,0,,Бұл бос сөз
Dialogue: 0,1:25:44.87,1:25:45.94,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:26:00.59,1:26:02.28,Default,,0,0,0,,Кінәсіздігіңізбен құттықтаймыз
Dialogue: 0,1:26:02.92,1:26:05.42,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,1:26:07.60,1:26:09.01,Default,,0,0,0,,Минерва біз үшін осындай қауіпсіз орын дайындап қойған еді
Dialogue: 0,1:26:18.01,1:26:20.28,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,1:26:21.60,1:26:24.74,Default,,0,0,0,,Мен Райсқа одан әрі сәттілік тілеймін.
Dialogue: 0,1:26:26.42,1:26:28.96,Default,,0,0,0,,Маған сені Джеббервокта да ұнаттым.
Dialogue: 0,1:26:29.50,1:26:31.73,Default,,0,0,0,,Мен ризамын рахмет
Dialogue: 0,1:26:32.38,1:26:35.19,Default,,0,0,0,,Тыңдау бірінші рет өтті
Dialogue: 0,1:26:35.19,1:26:37.96,Default,,0,0,0,,Өз қабілетіңізді есте сақтаңыз
Dialogue: 0,1:26:41.19,1:26:43.41,Default,,0,0,0,,Мен оны өз компанияма жұмысқа алуды ойладым.
Dialogue: 0,1:26:43.41,1:26:44.67,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,1:26:45.57,1:26:46.63,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,1:26:46.85,1:26:48.03,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,1:26:48.65,1:26:50.22,Default,,0,0,0,,үшін жақсы жұмыс істейді деп үміттенемін.
Dialogue: 0,1:27:05.50,1:27:07.36,Default,,0,0,0,,Көріскенше сау болыңыз
Dialogue: 0,1:27:11.09,1:27:12.02,Default,,0,0,0,,Алиса…
Dialogue: 0,1:27:27.77,1:27:28.71,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,1:27:46.46,1:27:49.03,Default,,0,0,0,,Қош бол Rise
Dialogue: 0,1:27:46.46,1:27:48.11,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,1:28:35.18,1:28:36.44,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,1:28:37.81,1:28:40.90,Default,,0,0,0,,Ғажайыптар еліндегі уақытыңыз қалай өтті?
Dialogue: 0,1:28:41.46,1:28:45.13,Default,,0,0,0,,Көп нәрсе болды, мен үйге бара алмайтын шығармын деп ойладым.
Dialogue: 0,1:28:45.70,1:28:48.07,Default,,0,0,0,,Ғажайыптар елінде не болады?
Dialogue: 0,1:28:48.07,1:28:50.50,Default,,0,0,0,,үшін қонаққа байланысты.
Dialogue: 0,1:28:50.92,1:28:52.91,Default,,0,0,0,,Шексіз мүмкіндіктер бар сияқты.
Dialogue: 0,1:28:54.57,1:28:58.90,Default,,0,0,0,,Келесі жолы келгенде, бұл тағы бір жаңа әлем болады.
Dialogue: 0,1:28:59.20,1:28:59.82,Default,,0,0,0,,Иә
Dialogue: 0,1:29:00.37,1:29:02.90,Default,,0,0,0,,Сіздің пікіріңіз негізінде тексерілді және түзетілді.
Dialogue: 0,1:29:02.90,1:29:06.40,Default,,0,0,0,,Алты айдан кейін ресми түрде ашылады деп жоспарланған
Dialogue: 0,1:29:07.16,1:29:08.94,Default,,0,0,0,,Мен қазірден бастап бос боламын.
Dialogue: 0,1:29:10.41,1:29:12.24,Default,,0,0,0,,Өлтірген барлық адамдарыңа — соның ішінде менің атамды да!
Dialogue: 0,1:29:12.66,1:29:16.40,Default,,0,0,0,,Маған сеніп тапсырылған мұраны тапсыруды ұмытып кетіппін.
Dialogue: 0,1:29:25.78,1:29:26.70,Default,,0,0,0,,Бұл…
Dialogue: 0,1:29:46.72,1:29:48.47,Default,,0,0,0,,Әже соңына дейін
Dialogue: 0,1:29:49.24,1:29:51.64,Default,,0,0,0,,Сіз өзіңіз жақсы көретін нәрсені бағаладыңыз, солай ма?
Dialogue: 0,1:29:55.45,1:29:58.15,Default,,0,0,0,,Мен де солай істеймін
Dialogue: 0,1:30:10.12,1:30:12.22,Default,,0,0,0,,Сіз кенеттен басынан бастайтыныңызды айттыңыз.
Dialogue: 0,1:30:12.64,1:30:14.97,Default,,0,0,0,,Хант бұл кезде таң қалды.
Dialogue: 0,1:30:15.25,1:30:17.26,Default,,0,0,0,,Мен қызғаншақ болдым.
Dialogue: 0,1:30:17.26,1:30:18.51,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,1:30:18.93,1:30:20.48,Default,,0,0,0,,Бұл шешім қабылданғанына қуаныштымын.
Dialogue: 0,1:30:21.02,1:30:23.52,Default,,0,0,0,,Бұл өте шағын компания.
Dialogue: 0,1:30:24.07,1:30:26.42,Default,,0,0,0,,Мен бұл жер жақсы деп ойладым.
Dialogue: 0,1:30:27.36,1:30:29.28,Default,,0,0,0,,Тұр, сен өзгердің.
Dialogue: 0,1:30:29.28,1:30:30.20,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,1:30:31.11,1:30:32.17,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,1:30:32.17,1:30:34.26,Default,,0,0,0,,Менің жігітім бар шығар
Dialogue: 0,1:30:34.52,1:30:35.45,Default,,0,0,0,,Міне.
Dialogue: 0,1:30:35.88,1:30:37.34,Default,,0,0,0,,Жоқ.
