Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:36.91,0:00:40.91,Default,,0,0,0,,(Дриблинг дыбысы)
Dialogue: 0,0:00:46.58,0:00:48.00,Default,,0,0,0,,Сен жақсардың, Риота.
Dialogue: 0,0:00:48.08,0:00:49.96,Default,,0,0,0,,Сіз енді мұндай трюк жасай аласыз ба?
Dialogue: 0,0:00:50.09,0:00:51.38,Default,,0,0,0,,Тұрақты болу
Dialogue: 0,0:00:51.67,0:00:55.09,Default,,0,0,0,,Ой! Иә, жақсы
Dialogue: 0,0:01:19.45,0:01:24.25,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:01:26.83,0:01:32.21,Default,,0,0,0,,Мен осы үйдің капитаны боламын, мама.
Dialogue: 0,0:01:36.47,0:01:38.51,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:01:45.02,0:01:46.35,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:01:50.02,0:01:52.36,Default,,0,0,0,,(Сотаның жылағаны)
Dialogue: 0,0:01:57.03,0:01:58.36,Default,,0,0,0,,Тыңда, Риота.
Dialogue: 0,0:02:01.03,0:02:03.33,Default,,0,0,0,,Біз анамды қолдауымыз керек.
Dialogue: 0,0:02:06.29,0:02:08.08,Default,,0,0,0,,Мен капитанмын
Dialogue: 0,0:02:09.21,0:02:11.17,Default,,0,0,0,,Сіз капитанның орынбасарысыз.
Dialogue: 0,0:02:12.79,0:02:14.17,Default,,0,0,0,,Өтінемін, Риота.
Dialogue: 0,0:02:20.39,0:02:23.47,Default,,0,0,0,,Егер сіз тұрақты болуды мақсат етсеңіз, мен де онымен бірге боламын.
Dialogue: 0,0:02:25.39,0:02:26.60,Default,,0,0,0,,1 бойынша 1
Dialogue: 0,0:02:35.98,0:02:36.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:36.82,0:02:39.65,Default,,0,0,0,,Менен оңайлықпен бет бұрма! Мен өзім қиналып жүрмін!
Dialogue: 0,0:02:40.41,0:02:41.99,Default,,0,0,0,,Қарғыс атсын... Ах!
Dialogue: 0,0:02:51.37,0:02:53.33,Default,,0,0,0,,Сен мені жеңесің.
Dialogue: 0,0:02:54.38,0:02:56.25,Default,,0,0,0,,Сіз қорқасыз ба? Бұл батылдықты қажет етеді
Dialogue: 0,0:03:01.93,0:03:02.97,Default,,0,0,0,,Жоғары…
Dialogue: 0,0:03:03.09,0:03:08.10,Default,,0,0,0,,(доп домалау дыбысы)
Dialogue: 0,0:03:08.64,0:03:10.02,Default,,0,0,0,,Ой...
Dialogue: 0,0:03:12.35,0:03:15.98,Default,,0,0,0,,Мен де, жүрегім осылай.
Dialogue: 0,0:03:17.78,0:03:21.32,Default,,0,0,0,,Сондықтан мен өзімді жақсы көремін.
Dialogue: 0,0:03:28.33,0:03:30.16,Default,,0,0,0,,- (Рёта) Қате! -(Сота) Жоқ жоқ!
Dialogue: 0,0:03:35.67,0:03:37.50,Default,,0,0,0,,Сен құлаған соң, шайқас бітті! Риота!
Dialogue: 0,0:03:37.84,0:03:40.34,Default,,0,0,0,,Иә! Келіңіздер!
Dialogue: 0,0:03:41.72,0:03:42.88,Default,,0,0,0,,Жалтармаңыз!
Dialogue: 0,0:03:45.60,0:03:46.60,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:48.31,0:03:49.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:49.47,0:03:51.39,Default,,0,0,0,,Ай!
Dialogue: 0,0:03:51.52,0:03:56.36,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:03:56.48,0:03:57.86,Default,,0,0,0,,Мен барынша тырыстым
Dialogue: 0,0:03:58.73,0:04:00.07,Default,,0,0,0,,Мен жақсы болдым.
Dialogue: 0,0:04:00.57,0:04:02.90,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:04:03.03,0:04:04.28,Default,,0,0,0,,Ұмытпаңыз
Dialogue: 0,0:04:06.99,0:04:07.99,Default,,0,0,0,,(бетті жуу дыбысы)
Dialogue: 0,0:04:08.62,0:04:09.74,Default,,0,0,0,,Со-чан!
Dialogue: 0,0:04:10.04,0:04:10.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:11.70,0:04:13.12,Default,,0,0,0,,Қайтадан жасаңыз!
Dialogue: 0,0:04:13.25,0:04:14.67,Default,,0,0,0,,О, жасайық!
Dialogue: 0,0:04:14.79,0:04:16.88,Default,,0,0,0,,- (Досым) Эй! -(Сота) А.
Dialogue: 0,0:04:17.79,0:04:19.50,Default,,0,0,0,,Сұраңыз!
Dialogue: 0,0:04:20.59,0:04:22.01,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:04:28.14,0:04:29.68,Default,,0,0,0,,1-ге 1 жасайық!
Dialogue: 0,0:04:29.81,0:04:31.89,Default,,0,0,0,,Кешіріңіз, мен уәде бердім.
Dialogue: 0,0:04:32.02,0:04:34.35,Default,,0,0,0,,1on1 Жасайық! Тағы да!
Dialogue: 0,0:04:34.48,0:04:36.02,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:04:36.40,0:04:37.77,Default,,0,0,0,,Олай болса мені де алып кет!
Dialogue: 0,0:04:37.90,0:04:39.52,Default,,0,0,0,,Жоқ, әлі ерте.
Dialogue: 0,0:04:40.15,0:04:43.74,Default,,0,0,0,,Дриблингке жаттығу. Сіз тұрақты аулауға барасыз, солай ма?
Dialogue: 0,0:04:43.86,0:04:44.78,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:47.41,0:04:50.87,Default,,0,0,0,,...Иә! Мен мұны 1-ге 1 жасаймыз дедім!
Dialogue: 0,0:04:50.99,0:04:52.83,Default,,0,0,0,,«Тағы бір рет» Мен өтірік айттым!
Dialogue: 0,0:04:52.95,0:04:55.29,Default,,0,0,0,,Өтірікші! Ақымақ сота!
Dialogue: 0,0:04:55.62,0:04:59.59,Default,,0,0,0,,Барка! Идиот! Ақымақ пақыр!
Dialogue: 0,0:05:00.04,0:05:02.38,Default,,0,0,0,,Қайтып келме!
Dialogue: 0,0:05:06.38,0:05:10.26,Default,,0,0,0,,(кеме қозғалтқышының дыбысы)
Dialogue: 0,0:05:10.39,0:05:14.27,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:05:29.49,0:05:30.49,Default,,0,0,0,,Жүректеріңізді құрбан етіңіздер!! Жүректеріңізді құрбан етіңіздер!! (Әскери полиция) Хич
Dialogue: 0,0:05:32.58,0:05:34.20,Default,,0,0,0,,(шкаф есігінің жабылу дыбысы)
Dialogue: 0,0:05:35.33,0:05:39.33,Default,,0,0,0,,(қарындаш жүгіру дыбысы)
Dialogue: 0,0:05:41.13,0:05:45.13,Default,,0,0,0,,♪ (басс кіріспе)
Dialogue: 0,0:05:51.22,0:05:55.22,Default,,0,0,0,,♪ (Барабандар қосылды)
Dialogue: 0,0:06:02.48,0:06:06.49,Default,,0,0,0,,♪ (Гитара 1 қосылды)
Dialogue: 0,0:06:13.41,0:06:17.41,Default,,0,0,0,,♪ (Гитара 2 қосылды)
Dialogue: 0,0:07:47.96,0:07:52.97,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:08:08.23,0:08:09.23,Default,,0,0,0,,- (Акаги) Әй! -(Кавада) О!
Dialogue: 0,0:08:09.98,0:08:10.90,Default,,0,0,0,,Дория!
Dialogue: 0,0:08:11.69,0:08:12.53,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:08:11.69,0:08:12.53,Default,,0,0,0,,~♪
Dialogue: 0,0:08:12.53,0:08:13.86,Default,,0,0,0,,~♪
Dialogue: 0,0:08:17.20,0:08:19.83,Default,,0,0,0,,Цк... Басынан сықырлап жатыр.
Dialogue: 0,0:08:26.50,0:08:27.21,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:38.85,0:08:39.56,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:08:40.47,0:08:41.18,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:08:42.43,0:08:43.14,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:43.39,0:08:45.06,Default,,0,0,0,,- (Жоқ) О! -(Сакураги) Иә!
Dialogue: 0,0:08:45.44,0:08:46.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:48.06,0:08:48.90,Default,,0,0,0,,О...
Dialogue: 0,0:08:50.23,0:08:53.90,Default,,0,0,0,,А... иә? О!
Dialogue: 0,0:08:54.45,0:08:57.28,Default,,0,0,0,,- (Сакураги) Бұл не, Рё-чин? -(Рёта) Ой...
Dialogue: 0,0:08:57.70,0:08:59.28,Default,,0,0,0,,Жоқ, мен шешемін деп ешқашан ойламадым...
Dialogue: 0,0:08:59.41,0:09:00.16,Default,,0,0,0,,(Ер адам) Гвуу! (Танжиро) Уф…
Dialogue: 0,0:09:00.28,0:09:04.54,Default,,0,0,0,,Бір бөтелке Бұл бір!
Dialogue: 0,0:09:06.21,0:09:08.17,Default,,0,0,0,,- (Фукацу) Екі ұпай бірдей, Пён - (Рёта) Пён?
Dialogue: 0,0:09:08.63,0:09:10.17,Default,,0,0,0,,Жақсы, жақсы, Фукацу!
Dialogue: 0,0:09:10.25,0:09:11.96,Default,,0,0,0,,Жақсы, жақсы, Фукацу!
Dialogue: 0,0:09:12.09,0:09:13.76,Default,,0,0,0,,Жақсы, жақсы!
Dialogue: 0,0:09:14.59,0:09:15.88,Default,,0,0,0,,Жақсы, жақсы, Фукацу!
Dialogue: 0,0:09:15.97,0:09:17.39,Default,,0,0,0,,Жақсы, жақсы, Фукацу!
Dialogue: 0,0:09:17.51,0:09:20.89,Default,,0,0,0,,Жақсы, жақсы, Фукацу! Ооооооооооооо!
Dialogue: 0,0:09:21.01,0:09:24.10,Default,,0,0,0,,Жоқ! бұл қандай атмосфера
Dialogue: 0,0:09:24.23,0:09:27.19,Default,,0,0,0,,- (Окусуноки) Неше клуб мүшесі бар? -(Нома) Беделді сезіну.
Dialogue: 0,0:09:27.52,0:09:30.52,Default,,0,0,0,,Онымен салыстырғанда біз өзімізді қожа сияқты сезінеміз.
Dialogue: 0,0:09:31.23,0:09:32.28,Default,,0,0,0,,Әпке
Dialogue: 0,0:09:32.40,0:09:33.28,Default,,0,0,0,,Жарай бер, жарай бер — сен ауаны тұншықтырып жатырсың, шетке жыл.
Dialogue: 0,0:09:33.40,0:09:34.36,Default,,0,0,0,,Дұшпандық топ
Dialogue: 0,0:09:34.49,0:09:35.28,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:36.61,0:09:38.16,Default,,0,0,0,,Қорғаныс!
Dialogue: 0,0:09:39.03,0:09:41.16,Default,,0,0,0,,Ақыр соңында, мынауының да сәйкес келетін футболкасы бар
Dialogue: 0,0:09:41.24,0:09:42.70,Default,,0,0,0,,Оны жасау керек пе еді?
Dialogue: 0,0:09:42.83,0:09:44.79,Default,,0,0,0,,Жоқ, балалар неге сендермен?
Dialogue: 0,0:09:45.58,0:09:47.04,Default,,0,0,0,,Ханамичи Джама! Кет!
Dialogue: 0,0:09:47.33,0:09:48.33,Default,,0,0,0,,(Ер адам) Гвуу! (Танжиро) Уф…
Dialogue: 0,0:09:48.79,0:09:52.67,Default,,0,0,0,,Мұнда әуесқой Ханамичидің пайда болуы фактісі...
Dialogue: 0,0:09:52.80,0:09:54.51,Default,,0,0,0,,«Қызыл шашым үшін кешірім сұраймын» деген сияқты.
Dialogue: 0,0:09:54.63,0:09:55.51,Default,,0,0,0,,Бұл сайқымазақ.
Dialogue: 0,0:09:55.92,0:09:57.80,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:09:57.93,0:10:01.35,Default,,0,0,0,,А... Мен өзімді ата-ана атанғандай сезінемін.
Dialogue: 0,0:10:01.47,0:10:02.35,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:10:02.47,0:10:04.72,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Маған қолдау көрсетуіңізді өтінемін!
Dialogue: 0,0:10:05.35,0:10:07.44,Default,,0,0,0,,Үш шан!
Dialogue: 0,0:10:18.32,0:10:19.61,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:10:19.74,0:10:22.49,Default,,0,0,0,,Жақсы, жақсы, Мицуи!
Dialogue: 0,0:10:24.54,0:10:28.16,Default,,0,0,0,,О! Сіз мазасыз адам сияқты әрекет етесіз
Dialogue: 0,0:10:28.83,0:10:32.88,Default,,0,0,0,,Жарайды, бірақ бүгінгі Мицуи жақсы, Санно.
Dialogue: 0,0:10:37.13,0:10:37.88,Default,,0,0,0,,Ах
Dialogue: 0,0:10:38.92,0:10:39.84,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:10:53.19,0:10:54.19,Default,,0,0,0,,Жақсы
Dialogue: 0,0:11:10.00,0:11:11.62,Default,,0,0,0,,Бұл керемет досым
Dialogue: 0,0:11:34.11,0:11:35.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:37.65,0:11:38.40,Default,,0,0,0,,Тынш!
Dialogue: 0,0:11:44.28,0:11:46.24,Default,,0,0,0,,Горилла Данк!
Dialogue: 0,0:11:46.37,0:11:48.83,Default,,0,0,0,,Жарайды, қорғаныс! Мен бір тоқтатамын!
Dialogue: 0,0:11:48.95,0:11:50.00,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:11:57.13,0:11:58.13,Default,,0,0,0,,Сиыр!
Dialogue: 0,0:11:59.80,0:12:01.22,Default,,0,0,0,,Авдол мен басқалар… келе жатыр…
Dialogue: 0,0:12:02.05,0:12:03.13,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:03.84,0:12:08.06,Default,,0,0,0,,Хмф, сонша қимылдамасаң, бірінші саған тиеді.
Dialogue: 0,0:12:13.98,0:12:14.73,Default,,0,0,0,,Бұл тек алдын алу тексерісі ғана
Dialogue: 0,0:12:15.73,0:12:16.52,Default,,0,0,0,,О!
Dialogue: 0,0:12:16.86,0:12:17.61,Default,,0,0,0,,Бұл!?
Dialogue: 0,0:12:18.57,0:12:19.40,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:12:21.44,0:12:22.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:23.74,0:12:25.74,Default,,0,0,0,,Сонымен... данышпан?
Dialogue: 0,0:12:35.42,0:12:36.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:45.84,0:12:48.05,Default,,0,0,0,,Осындай өткір жетекті кім жасайды?
Dialogue: 0,0:12:48.14,0:12:49.72,Default,,0,0,0,,Жапонияда жоқ
Dialogue: 0,0:13:01.48,0:13:02.74,Default,,0,0,0,,Бұл Жапониядағы ең жақсысы ма?
Dialogue: 0,0:13:03.44,0:13:04.20,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:07.99,0:13:08.82,Default,,0,0,0,,Ах
Dialogue: 0,0:13:09.07,0:13:09.91,Default,,0,0,0,,Ой
Dialogue: 0,0:13:10.12,0:13:11.16,Default,,0,0,0,,Керемет
Dialogue: 0,0:13:15.29,0:13:16.29,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:13:18.79,0:13:19.92,Default,,0,0,0,,Онда...
Dialogue: 0,0:13:20.88,0:13:22.96,Default,,0,0,0,,- (Сакураги) Дұрыс істе, жарайды! -(Жоқ) А?
Dialogue: 0,0:13:25.17,0:13:28.55,Default,,0,0,0,,Қорғаныс! Қорғаныс!
Dialogue: 0,0:13:29.60,0:13:30.80,Default,,0,0,0,,Я...
Dialogue: 0,0:13:38.69,0:13:40.86,Default,,0,0,0,,Я...
Dialogue: 0,0:13:41.77,0:13:42.69,Default,,0,0,0,,(Жарыл!)
Dialogue: 0,0:13:42.82,0:13:44.44,Default,,0,0,0,,Король Ямано
Dialogue: 0,0:13:45.11,0:13:47.70,Default,,0,0,0,,Бұл Жапониядағы ең жақсы күзетші
Dialogue: 0,0:13:50.07,0:13:51.99,Default,,0,0,0,,Жапонияның барлық жерінде күзетшілер сындырылды.
Dialogue: 0,0:13:52.12,0:13:53.04,Default,,0,0,0,,Өз сөзіңнен қайтпа, Мияги!
Dialogue: 0,0:13:53.16,0:13:53.95,Default,,0,0,0,,Өз сөзіңізден қайтпаңыз!
Dialogue: 0,0:14:08.93,0:14:12.47,Default,,0,0,0,,Мен сенімен 40 минут араласамын, бейбақ!
Dialogue: 0,0:14:19.10,0:14:21.31,Default,,0,0,0,,- (дриблинг дыбысы) - (қарсы жаттықтырушының дауысы) Артқа қайт, қайт!
Dialogue: 0,0:14:22.98,0:14:24.78,Default,,0,0,0,,- (Командалас) Рибан! -(Қарсы жаттықтырушы) Жүгір, жүгір!
Dialogue: 0,0:14:24.90,0:14:25.99,Default,,0,0,0,,Каору-чан!
Dialogue: 0,0:14:26.11,0:14:29.66,Default,,0,0,0,,Сіз ертерек келуіңіз керек. Бұл жерде бос.
Dialogue: 0,0:14:29.78,0:14:30.95,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:33.74,0:14:36.75,Default,,0,0,0,,Сізді осында көргеніме қуаныштымын. Мен сені күттім.
Dialogue: 0,0:14:36.87,0:14:38.71,Default,,0,0,0,,О.
Dialogue: 0,0:14:40.00,0:14:41.54,Default,,0,0,0,,Иә, мұқият қараңыз! Мұқият қараңыз!
Dialogue: 0,0:14:43.42,0:14:45.63,Default,,0,0,0,,Иә! Рё-чан!
Dialogue: 0,0:14:46.13,0:14:47.55,Default,,0,0,0,,Бірден, бірінен соң бірі!
Dialogue: 0,0:14:49.13,0:14:50.05,Default,,0,0,0,,Жақсы пас!
Dialogue: 0,0:14:52.01,0:14:54.85,Default,,0,0,0,,Иә, жақсы! Иә, кеттік!
Dialogue: 0,0:14:55.93,0:14:57.31,Default,,0,0,0,,Бұрыл, бұрыл! Кең!
Dialogue: 0,0:14:59.14,0:15:00.81,Default,,0,0,0,,Мен мұқият қарауым керек!
Dialogue: 0,0:15:02.06,0:15:03.36,Default,,0,0,0,,Наиш!
Dialogue: 0,0:15:04.90,0:15:08.65,Default,,0,0,0,,Сен әдеттегіден өткір екенсің, Рё Чан.
Dialogue: 0,0:15:08.78,0:15:11.16,Default,,0,0,0,,Мама келе жатқандықтан шығар.
Dialogue: 0,0:15:13.57,0:15:14.83,Default,,0,0,0,,Жүр!
Dialogue: 0,0:15:17.37,0:15:19.62,Default,,0,0,0,,Бұлай жасама No 7 Кішкентай болса да
Dialogue: 0,0:15:20.12,0:15:21.25,Default,,0,0,0,,Бұл бала.
Dialogue: 0,0:15:21.37,0:15:25.13,Default,,0,0,0,,Қараңызшы, Сота Миягидің інісі бірнеше жыл бұрын қайтыс болды.
Dialogue: 0,0:15:25.25,0:15:27.96,Default,,0,0,0,,Ах! Бірдей 7 нөмірін кию
Dialogue: 0,0:15:28.96,0:15:31.34,Default,,0,0,0,,Бұл бала ерекше еді.
Dialogue: 0,0:15:32.51,0:15:34.22,Default,,0,0,0,,Ол өлді ме?
Dialogue: 0,0:15:34.35,0:15:35.97,Default,,0,0,0,,Тіпті теңіздегі апаттар
Dialogue: 0,0:15:36.10,0:15:37.10,Default,,0,0,0,,№.
Dialogue: 0,0:15:37.22,0:15:38.22,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:39.10,0:15:42.65,Default,,0,0,0,,Со Чан қазір алыс аралда жалғыз тұрады.
Dialogue: 0,0:15:42.77,0:15:43.69,Default,,0,0,0,,Анна!
Dialogue: 0,0:15:44.44,0:15:45.73,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:47.27,0:15:48.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:49.57,0:15:50.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:50.53,0:15:51.70,Default,,0,0,0,,Айя~
Dialogue: 0,0:15:51.82,0:15:53.24,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:15:53.36,0:15:54.87,Default,,0,0,0,,Екінші тайм бастайық!
Dialogue: 0,0:15:55.62,0:15:56.87,Default,,0,0,0,,Иә, зейінімізді жинақтайық.
Dialogue: 0,0:15:56.95,0:15:58.04,Default,,0,0,0,,Осы жерден назар аударайық.
Dialogue: 0,0:15:58.54,0:15:59.41,Default,,0,0,0,,Number 7!
Dialogue: 0,0:15:59.54,0:16:00.87,Default,,0,0,0,,Number 15! Number 6!
Dialogue: 0,0:16:01.00,0:16:02.41,Default,,0,0,0,,
Dialogue: 0,0:16:05.42,0:16:06.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:09.21,0:16:10.51,Default,,0,0,0,,Осы жерден Осы жерден!
Dialogue: 0,0:16:11.59,0:16:13.38,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:16:15.14,0:16:18.64,Default,,0,0,0,,Мен бірде сенің ағаңмен матч ойнадым.
Dialogue: 0,0:16:20.52,0:16:23.85,Default,,0,0,0,,Сол кезде ағамнан қатты жеңіліп қалдым.
Dialogue: 0,0:16:25.98,0:16:28.65,Default,,0,0,0,,Бұл не? Бауырым, бұл үлкен мәселе емес.
Dialogue: 0,0:16:29.15,0:16:30.28,Default,,0,0,0,,Ах
Dialogue: 0,0:16:30.40,0:16:31.74,Default,,0,0,0,,Артқа қайт, қайт!
Dialogue: 0,0:16:32.82,0:16:35.20,Default,,0,0,0,,Ah... Good luck!
Dialogue: 0,0:16:35.49,0:16:37.70,Default,,0,0,0,,Ryota bullish!
Dialogue: 0,0:16:41.25,0:16:42.12,Default,,0,0,0,,Маған қалдыр!
Dialogue: 0,0:16:49.29,0:16:50.25,Default,,0,0,0,,Ryo-chan!
Dialogue: 0,0:16:51.38,0:16:52.26,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:16:52.38,0:16:53.80,Default,,0,0,0,,Рё-чанға сәттілік!
Dialogue: 0,0:16:53.92,0:16:56.34,Default,,0,0,0,,-(Әйел В) Мен бара аламын! -(Female C) Don't lose!
Dialogue: 0,0:16:59.05,0:17:00.56,Default,,0,0,0,,Иә, қатты, қатты!
Dialogue: 0,0:17:00.93,0:17:01.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:02.06,0:17:02.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:04.18,0:17:06.40,Default,,0,0,0,,Бірден, бірден! Жүгір, жүгір!
Dialogue: 0,0:17:09.94,0:17:11.40,Default,,0,0,0,,Айя~
Dialogue: 0,0:17:12.36,0:17:13.90,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:17:14.53,0:17:16.45,Default,,0,0,0,,Ағаңнан бөлексің.
Dialogue: 0,0:17:17.11,0:17:19.78,Default,,0,0,0,,Мен сені алмастыра алмаймын.
Dialogue: 0,0:17:29.54,0:17:32.55,Default,,0,0,0,,♪~
Dialogue: 0,0:18:49.87,0:18:51.21,Default,,0,0,0,,(Бетті айналдыру дыбысы)
Dialogue: 0,0:18:56.63,0:19:02.64,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:20.07,0:19:21.07,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:24.95,0:19:29.00,Default,,0,0,0,,Иә? А, мен қазір тазалауды ойлап жатырмын.
Dialogue: 0,0:19:29.45,0:19:32.25,Default,,0,0,0,,Бұл үйді басқа жерге көшіруім керек пе?
Dialogue: 0,0:19:32.92,0:19:36.25,Default,,0,0,0,,Сіз ағайынды болғандықтан бір нөмірді пайдаланудың қажеті жоқ.
Dialogue: 0,0:19:37.63,0:19:39.05,Default,,0,0,0,,Let me change it.
Dialogue: 0,0:19:47.10,0:19:48.22,Default,,0,0,0,,Маған 7 саны ұнайды...
Dialogue: 0,0:19:49.47,0:19:50.64,Default,,0,0,0,,(қорапқа лақтыру дыбысы)
Dialogue: 0,0:19:53.31,0:19:57.32,Default,,0,0,0,,Тек сол күні Миямура-кунды шақырғаныңды ұмытпа.
Dialogue: 0,0:19:58.36,0:19:59.53,Default,,0,0,0,,(қорапқа лақтыру дыбысы)
Dialogue: 0,0:20:00.24,0:20:02.24,Default,,0,0,0,,- (Ryota) Ugh! -Не...
Dialogue: 0,0:20:05.49,0:20:06.24,Default,,0,0,0,,Ой! Незуко қайда?
Dialogue: 0,0:20:07.03,0:20:08.91,Default,,0,0,0,,Бұл жерге кірме!
Dialogue: 0,0:20:09.49,0:20:12.25,Default,,0,0,0,,Take it off! You have your own!
Dialogue: 0,0:20:12.54,0:20:13.96,Default,,0,0,0,,(Фото жақтауының сынған дыбысы)
Dialogue: 0,0:20:14.79,0:20:18.09,Default,,0,0,0,,Тоқта... Тоқта!
Dialogue: 0,0:20:19.71,0:20:22.72,Default,,0,0,0,,~♪
Dialogue: 0,0:20:25.22,0:20:28.97,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:29.10,0:20:31.85,Default,,0,0,0,,Мен сені алмастыра алмаймын.
Dialogue: 0,0:20:32.23,0:20:33.77,Default,,0,0,0,,(Kaoru's cry)
Dialogue: 0,0:20:45.41,0:20:48.78,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:20:48.91,0:20:51.54,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:20:57.96,0:20:58.92,Default,,0,0,0,,
Dialogue: 0,0:20:59.04,0:21:00.75,Default,,0,0,0,,Екінші жарты Бастайық!
Dialogue: 0,0:21:11.47,0:21:14.18,Default,,0,0,0,,Осы жерден тағы бір матч басталады.
Dialogue: 0,0:21:25.11,0:21:26.86,Default,,0,0,0,,Wow, Sawakita!
Dialogue: 0,0:21:26.99,0:21:28.82,Default,,0,0,0,,Үш!? Үш!
Dialogue: 0,0:21:28.95,0:21:30.20,Default,,0,0,0,,Дөңмай, қайтарып аламын!
Dialogue: 0,0:21:30.58,0:21:31.58,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:35.58,0:21:37.37,Default,,0,0,0,,- (Ясуда) Бас!? - (Акаги) Міне келді!
Dialogue: 0,0:21:37.58,0:21:38.29,Default,,0,0,0,,Ах
Dialogue: 0,0:21:38.92,0:21:41.75,Default,,0,0,0,,Екінші таймға 3 минут
Dialogue: 0,0:21:42.21,0:21:43.21,Default,,0,0,0,,Уф
Dialogue: 0,0:21:43.71,0:21:44.97,Default,,0,0,0,,Мияги асуы! Шығар!
Dialogue: 0,0:21:45.09,0:21:46.38,Default,,0,0,0,,Мені итеріп жатырсың, бейбақ!
Dialogue: 0,0:21:46.51,0:21:47.51,Default,,0,0,0,,Профессор, шай ішесіз бе?
Dialogue: 0,0:21:51.05,0:21:51.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:00.15,0:22:00.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:13.29,0:22:14.54,Default,,0,0,0,,Сәлем! Айтыңызшы...
Dialogue: 0,0:22:18.75,0:22:19.96,Default,,0,0,0,,Яббе…
Dialogue: 0,0:22:20.08,0:22:21.75,Default,,0,0,0,,Бұл қиын
Dialogue: 0,0:22:26.47,0:22:27.30,Default,,0,0,0,,(Киришима & Сейро) Хахаха… Шынымен бе? Шынымен бе? Бакуго!
Dialogue: 0,0:22:27.55,0:22:30.68,Default,,0,0,0,,Сіз не істеп жатырсыз? Тез әкел!
Dialogue: 0,0:22:32.01,0:22:33.01,Default,,0,0,0,,Оны атамаңыз!
Dialogue: 0,0:22:33.14,0:22:34.64,Default,,0,0,0,,О...
Dialogue: 0,0:22:34.77,0:22:36.27,Default,,0,0,0,,Құқық бұзушылық үшін айыптау!
Dialogue: 0,0:22:37.14,0:22:40.77,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:22:42.44,0:22:44.44,Default,,0,0,0,,Енді барлығына өзіңізді таныстырыңыз.
Dialogue: 0,0:22:54.53,0:22:57.00,Default,,0,0,0,,Мияги… Риота
Dialogue: 0,0:22:57.12,0:22:59.33,Default,,0,0,0,,Бүгіннен бастап біз бірге оқимыз.
Dialogue: 0,0:22:59.41,0:23:00.37,Default,,0,0,0,,Бұл Риота Мияги.
Dialogue: 0,0:23:00.50,0:23:01.92,Default,,0,0,0,,- (Бала) Жасың нешеде - (Қыз) Кіші дауыс
Dialogue: 0,0:23:02.04,0:23:04.21,Default,,0,0,0,,Мияги-кун жаңа ғана Окинавадан көшіп келді.
Dialogue: 0,0:23:04.34,0:23:06.92,Default,,0,0,0,,Мен түсінбейтін нәрселер көп деп ойлаймын, сондықтан...
Dialogue: 0,0:23:07.88,0:23:12.89,Default,,0,0,0,,Ай!
Dialogue: 0,0:23:14.85,0:23:19.60,Default,,0,0,0,,(Инелік аспаз)
Dialogue: 0,0:23:20.52,0:23:21.73,Default,,0,0,0,,Джоэстар әулеті
Dialogue: 0,0:23:24.61,0:23:25.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:25.44,0:23:27.73,Default,,0,0,0,,Алаңдамаңыз
Dialogue: 0,0:23:28.82,0:23:34.37,Default,,0,0,0,,(Анна мен оның достары ойнайды)
Dialogue: 0,0:23:53.01,0:23:54.01,Default,,0,0,0,,Ей!
Dialogue: 0,0:23:54.97,0:23:57.18,Default,,0,0,0,,Басқа жерде доп ойнамаңыз!
Dialogue: 0,0:24:05.52,0:24:06.57,Default,,0,0,0,,Әй!
Dialogue: 0,0:24:07.02,0:24:08.44,Default,,0,0,0,,Шулы!
Dialogue: 0,0:24:09.65,0:24:11.36,Default,,0,0,0,,(Дриблинг дыбысы)
Dialogue: 0,0:24:11.49,0:24:15.28,Default,,0,0,0,,(Ұлдардың айқайы)
Dialogue: 0,0:24:15.41,0:24:17.99,Default,,0,0,0,,Өте жақсы! Мен кете аламын, бара аламын
Dialogue: 0,0:24:18.49,0:24:19.79,Default,,0,0,0,,Ах! Қазірдің өзінде реван реван!
Dialogue: 0,0:24:19.91,0:24:21.75,Default,,0,0,0,,Ах! Қайдан шығардың?
Dialogue: 0,0:24:21.87,0:24:22.79,Default,,0,0,0,,(Жігіттердің күлкісі)
Dialogue: 0,0:24:23.08,0:24:25.83,Default,,0,0,0,,Бұл мүмкін емес! Мұнда бір ғана адам бар.
Dialogue: 0,0:24:26.63,0:24:28.21,Default,,0,0,0,,Ол кіре ала ма?
Dialogue: 0,0:24:30.05,0:24:32.34,Default,,0,0,0,,Мені аулақ жүруге шақыратын аура бар.
Dialogue: 0,0:24:33.80,0:24:34.97,Default,,0,0,0,,Неге үзіліс жасамайсың?
Dialogue: 0,0:24:35.09,0:24:37.01,Default,,0,0,0,,Аа, келісемін, жарайды.
Dialogue: 0,0:24:38.51,0:24:39.56,Default,,0,0,0,,О...
Dialogue: 0,0:24:49.90,0:24:51.15,Default,,0,0,0,,Бастауыш сынып оқушысы?
Dialogue: 0,0:24:53.32,0:24:54.53,Default,,0,0,0,,Бұл орта мектептің 1-ші жылы!
Dialogue: 0,0:25:19.26,0:25:20.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:29.40,0:25:31.69,Default,,0,0,0,,Тек өз дағдыларыңызды көрсету сізді жеңе алмайды!
Dialogue: 0,0:25:33.69,0:25:35.20,Default,,0,0,0,,Қысыңыз! Қысым!
Dialogue: 0,0:25:35.45,0:25:36.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:42.58,0:25:43.58,Default,,0,0,0,,Әй?
Dialogue: 0,0:25:44.58,0:25:46.37,Default,,0,0,0,,Сіз жай ғана бас тартасыз ба?
Dialogue: 0,0:25:47.79,0:25:49.33,Default,,0,0,0,,Егер сіз мұның бәрін өзіңіз жасасаңыз
Dialogue: 0,0:25:49.46,0:25:51.80,Default,,0,0,0,,Бұл сіздің техникаңыздың босқа кетуі.
Dialogue: 0,0:25:51.92,0:25:53.55,Default,,0,0,0,,Үш шан!
Dialogue: 0,0:25:55.01,0:25:57.93,Default,,0,0,0,,Қайтадан жасайық, келесі жолы жеңіп кел
Dialogue: 0,0:26:00.01,0:26:01.18,Default,,0,0,0,,Ой...
Dialogue: 0,0:26:07.31,0:26:08.31,Default,,0,0,0,,(Шешіліп жатқан атыстың дыбысы)
Dialogue: 0,0:26:11.11,0:26:14.94,Default,,0,0,0,,Сіз не істеп жатырсыз? Допқа әлі қол тигізбеңіз!
Dialogue: 0,0:26:15.07,0:26:16.28,Default,,0,0,0,,Бұл тітіркендіргіш!
Dialogue: 0,0:26:16.78,0:26:20.74,Default,,0,0,0,,20 ұпай Ашайық па? Шохоку мырза, бірінші рет қатысып отыр
Dialogue: 0,0:26:21.53,0:26:23.24,Default,,0,0,0,,Бұл менің жүрегімді ауыртады
Dialogue: 0,0:26:23.83,0:26:24.66,Default,,0,0,0,,Бұл 5 секунд болады!
Dialogue: 0,0:26:24.79,0:26:26.04,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:26:27.66,0:26:29.33,Default,,0,0,0,,10 секунд! Асығыңыз және алға ұмтылыңыз!
Dialogue: 0,0:26:31.67,0:26:32.59,Default,,0,0,0,,Тики шоу!
Dialogue: 0,0:26:32.88,0:26:34.50,Default,,0,0,0,,Ах! Нашар пас!
Dialogue: 0,0:26:34.63,0:26:35.51,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:26:46.52,0:26:49.10,Default,,0,0,0,,Рукава Сіз де көтерілуіңіз керек! Оны үш адаммен алып жүріңіз!
Dialogue: 0,0:26:53.19,0:26:55.07,Default,,0,0,0,,Хаха...
Dialogue: 0,0:26:56.94,0:26:59.57,Default,,0,0,0,,Хаха...
Dialogue: 0,0:27:00.32,0:27:01.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:07.08,0:27:07.91,Default,,0,0,0,,
Dialogue: 0,0:27:08.08,0:27:09.08,Default,,0,0,0,,Ах
Dialogue: 0,0:27:09.37,0:27:10.79,Default,,0,0,0,,Санау! Бір лақтыру!
Dialogue: 0,0:27:12.08,0:27:14.25,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:27:14.38,0:27:15.71,Default,,0,0,0,,) Күту уақыты қызыл!
Dialogue: 0,0:27:16.25,0:27:21.05,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:27:21.30,0:27:23.05,Default,,0,0,0,,Рёчинко!
Dialogue: 0,0:27:23.43,0:27:25.56,Default,,0,0,0,,Сіз әлі допты ұстаған жоқсыз.
Dialogue: 0,0:27:25.68,0:27:31.31,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:27:32.35,0:27:34.90,Default,,0,0,0,,30 секунд тыныс алу
Dialogue: 0,0:27:36.61,0:27:39.90,Default,,0,0,0,,(Сакураги терең тыныс алады)
Dialogue: 0,0:27:41.11,0:27:45.16,Default,,0,0,0,,Егер мен тау патшасы болсам, мен әлі күнге дейін аймақтық баспасөзбен жүрер едім.
Dialogue: 0,0:27:45.28,0:27:47.58,Default,,0,0,0,,сынған немесе
Dialogue: 0,0:27:48.45,0:27:51.33,Default,,0,0,0,,Басқа адамның жүрегі толығымен жараланғанша
Dialogue: 0,0:27:52.87,0:27:54.67,Default,,0,0,0,,Бұл ойын!
Dialogue: 0,0:27:54.79,0:27:57.46,Default,,0,0,0,,Шохоку баспасөзге мүлдем жауап бере алмайды.
Dialogue: 0,0:27:57.59,0:27:58.84,Default,,0,0,0,,Енді соғудың уақыты келді!
Dialogue: 0,0:27:58.96,0:28:00.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:28:00.72,0:28:02.93,Default,,0,0,0,,Хаха...
Dialogue: 0,0:28:03.05,0:28:04.64,Default,,0,0,0,,Ол бұзылмайды
Dialogue: 0,0:28:05.22,0:28:06.22,Default,,0,0,0,,Ха!
Dialogue: 0,0:28:07.97,0:28:09.18,Default,,0,0,0,,Мицуи мырза, Рукава мырза
Dialogue: 0,0:28:09.31,0:28:10.31,Default,,0,0,0,,- (Мицуи) Иә - (Нагарекава) Біз
Dialogue: 0,0:28:10.43,0:28:12.31,Default,,0,0,0,,Бәріміз де алға қарай жүгірейік
Dialogue: 0,0:28:14.44,0:28:15.36,Default,,0,0,0,,Мияги-кун
Dialogue: 0,0:28:15.48,0:28:16.56,Default,,0,0,0,,Иә
Dialogue: 0,0:28:17.65,0:28:19.90,Default,,0,0,0,,Бұл сіздің кезеңіңіз.
Dialogue: 0,0:28:22.61,0:28:25.62,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:28:26.91,0:28:29.04,Default,,0,0,0,,Мен не істеуім керек? Қарт адам!
Dialogue: 0,0:28:29.16,0:28:31.54,Default,,0,0,0,,Бұл данышпан Сакураги!
Dialogue: 0,0:28:31.66,0:28:35.29,Default,,0,0,0,,Сіз сақинаға қарай жүгіресіз...
Dialogue: 0,0:28:35.42,0:28:36.25,Default,,0,0,0,,Жарайды
Dialogue: 0,0:28:37.00,0:28:38.00,Default,,0,0,0,,Риота!
Dialogue: 0,0:28:38.84,0:28:39.67,Default,,0,0,0,,Маған қолыңды бер.
Dialogue: 0,0:28:39.80,0:28:41.59,Default,,0,0,0,,Қызыл асығыс
Dialogue: 0,0:28:42.05,0:28:43.26,Default,,0,0,0,,А, не!?
Dialogue: 0,0:28:44.88,0:28:45.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:47.85,0:28:50.31,Default,,0,0,0,,Әдеттегідей бастық болыңыз.
Dialogue: 0,0:28:54.19,0:28:56.27,Default,,0,0,0,,Бұл 15 ұпайлық айырмашылық!
Dialogue: 0,0:28:57.73,0:28:58.61,Default,,0,0,0,,О!
Dialogue: 0,0:28:59.07,0:29:00.07,Default,,0,0,0,,О!
Dialogue: 0,0:29:00.61,0:29:02.57,Default,,0,0,0,,Бұл тағы да солай ма? Миягиді нысанаға алу
Dialogue: 0,0:29:02.69,0:29:03.57,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:29:05.45,0:29:06.49,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:29:07.37,0:29:08.32,Default,,0,0,0,,Sawakita Ball Pyong!
Dialogue: 0,0:29:09.12,0:29:10.03,Default,,0,0,0,,Әй!
Dialogue: 0,0:29:17.25,0:29:18.38,Default,,0,0,0,,Уууу!
Dialogue: 0,0:29:18.50,0:29:19.38,Default,,0,0,0,,Жылдам секіру!
Dialogue: 0,0:29:19.50,0:29:20.34,Default,,0,0,0,,Сынған!
Dialogue: 0,0:29:20.46,0:29:21.88,Default,,0,0,0,,Жылдамдыққа келетін болсақ, мен №1...
Dialogue: 0,0:29:22.13,0:29:22.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:23.09,0:29:24.17,Default,,0,0,0,,...Дапён!
Dialogue: 0,0:29:25.22,0:29:26.34,Default,,0,0,0,,Жақсы! Баспасөздегі жаңалық!
Dialogue: 0,0:29:27.93,0:29:28.72,Default,,0,0,0,,3-тен 2-ге дейін!
Dialogue: 0,0:29:28.85,0:29:30.56,Default,,0,0,0,,Мұндағы ағынды өзгертіңіз!
Dialogue: 0,0:29:31.56,0:29:32.52,Default,,0,0,0,,Буши!
Dialogue: 0,0:29:33.48,0:29:34.35,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:29:36.35,0:29:37.31,Default,,0,0,0,,Мен оған қол тигіздім!
Dialogue: 0,0:29:37.65,0:29:38.81,Default,,0,0,0,,Фуримукизама оқу-жаттығу жиыны
Dialogue: 0,0:29:38.94,0:29:40.19,Default,,0,0,0,,- (Сакураги) Ах! -(Рёта) Ақымақ!
Dialogue: 0,0:29:42.82,0:29:45.45,Default,,0,0,0,,- (Ишии) Рахмет... - (Когуре) Бір! Біреуін алайық!
Dialogue: 0,0:29:46.65,0:29:47.78,Default,,0,0,0,,Кавата…
Dialogue: 0,0:30:02.63,0:30:03.63,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:30:05.30,0:30:06.30,Default,,0,0,0,,Кірдің бе?
Dialogue: 0,0:30:06.47,0:30:07.47,Default,,0,0,0,,Жоқ, бұрыш жоқ!
Dialogue: 0,0:30:09.22,0:30:11.18,Default,,0,0,0,,Жақсы! Керемет қорғаныс!
Dialogue: 0,0:30:21.40,0:30:22.32,Default,,0,0,0,,Уау, дәмді!
Dialogue: 0,0:30:24.15,0:30:25.15,Default,,0,0,0,,Поо!
Dialogue: 0,0:30:27.90,0:30:29.24,Default,,0,0,0,,- (Кавада) Хмф! -(Сакураги) Жақсы...
Dialogue: 0,0:30:29.36,0:30:33.37,Default,,0,0,0,,Жақсы, жақсы, Кавада, Кавада, жақсы, Кавада
Dialogue: 0,0:30:33.95,0:30:37.37,Default,,0,0,0,,Мен бұл адамды жеңе аламын ба?
Dialogue: 0,0:30:37.66,0:30:41.71,Default,,0,0,0,,Жақсы, жақсы, Кавата! Жақсы, жақсы, Кавата!
Dialogue: 0,0:30:42.04,0:30:43.59,Default,,0,0,0,,Қайтар, Ақағы!
Dialogue: 0,0:30:43.71,0:30:44.55,Default,,0,0,0,,Бір бөтелке!
Dialogue: 0,0:30:48.38,0:30:51.51,Default,,0,0,0,,Мен бұл шабуыл үлгісін білемін.
Dialogue: 0,0:30:52.93,0:30:53.93,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:30:56.85,0:30:58.77,Default,,0,0,0,,Мен де бұл үлгіні білемін.
Dialogue: 0,0:30:59.44,0:31:00.31,Default,,0,0,0,,Буши!
Dialogue: 0,0:31:00.56,0:31:01.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:01.52,0:31:02.69,Default,,0,0,0,,Уау...
Dialogue: 0,0:31:16.04,0:31:16.79,Default,,0,0,0,,Ах
Dialogue: 0,0:31:16.91,0:31:17.91,Default,,0,0,0,,Жоқ
Dialogue: 0,0:31:18.79,0:31:19.54,Default,,0,0,0,,Ах
Dialogue: 0,0:31:20.21,0:31:21.04,Default,,0,0,0,,Әй!
Dialogue: 0,0:31:25.55,0:31:27.05,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:31:27.17,0:31:29.26,Default,,0,0,0,,20 ұпай айырмашылығы! Тау патшасы!
Dialogue: 0,0:31:33.43,0:31:36.06,Default,,0,0,0,,Уау! Бұл керемет, Санно!
Dialogue: 0,0:31:37.27,0:31:38.64,Default,,0,0,0,,20 ұпай айырмашылығы...
Dialogue: 0,0:31:39.23,0:31:40.81,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:31:45.90,0:31:47.44,Default,,0,0,0,,- (Савакита) Ша! -(Кавада) О!
Dialogue: 0,0:31:49.90,0:31:52.95,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:31:53.07,0:31:55.37,Default,,0,0,0,,Бір! Алдымен біреуін алайық!
Dialogue: 0,0:32:01.92,0:32:04.17,Default,,0,0,0,,Ичино, Мицуиге қара.
Dialogue: 0,0:32:05.00,0:32:08.09,Default,,0,0,0,,Бірінші таймдағы қорғанысыңыз күткендей жұмыс істеп тұрған сияқты.
Dialogue: 0,0:32:10.72,0:32:12.30,Default,,0,0,0,,Дененің соққысы сияқты
Dialogue: 0,0:32:12.80,0:32:14.68,Default,,0,0,0,,Хаха...
Dialogue: 0,0:32:15.68,0:32:16.55,Default,,0,0,0,,Ән айту
Dialogue: 0,0:32:20.52,0:32:21.48,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:32:21.77,0:32:22.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:23.27,0:32:25.56,Default,,0,0,0,,Секіру ықтималдығы төмен...
Dialogue: 0,0:32:25.86,0:32:27.90,Default,,0,0,0,,Мен Риотаның әлсіз жақтарын көре аламын.
Dialogue: 0,0:32:28.86,0:32:31.49,Default,,0,0,0,,(Жаңбырдың дыбысы)
Dialogue: 0,0:32:31.61,0:32:32.53,Default,,0,0,0,,Боқ
Dialogue: 0,0:32:32.65,0:32:34.99,Default,,0,0,0,,Егер бұл орын алса, соңғы қару - Сакураги!
Dialogue: 0,0:32:35.11,0:32:35.95,Default,,0,0,0,,Бұл ойын, Пол!
Dialogue: 0,0:32:36.07,0:32:37.24,Default,,0,0,0,,Соңғы қару?
Dialogue: 0,0:32:37.91,0:32:38.74,Default,,0,0,0,,Уф
Dialogue: 0,0:32:41.04,0:32:41.70,Default,,0,0,0,,Сакураги!
Dialogue: 0,0:32:41.83,0:32:42.91,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:32:43.16,0:32:43.96,Default,,0,0,0,,Уф
Dialogue: 0,0:32:44.08,0:32:45.54,Default,,0,0,0,,Қосарлы дриблинг
Dialogue: 0,0:32:45.67,0:32:46.67,Default,,0,0,0,,Уф, суық қой!
Dialogue: 0,0:32:47.00,0:32:48.42,Default,,0,0,0,,А... кетті.
Dialogue: 0,0:32:48.54,0:32:49.55,Default,,0,0,0,,Сіз әуесқойсыз ба?
Dialogue: 0,0:32:49.67,0:32:51.42,Default,,0,0,0,,Бұл қос дриблинг!
Dialogue: 0,0:32:52.34,0:32:54.18,Default,,0,0,0,,Әй, қалжыңдасаң, мен сені өлтіремін.
Dialogue: 0,0:32:54.30,0:32:56.34,Default,,0,0,0,,Шулы бейбақ, аузыңды жап!
Dialogue: 0,0:33:06.02,0:33:08.02,Default,,0,0,0,,8 минутта мақсат жоқ па?
Dialogue: 0,0:33:08.82,0:33:10.69,Default,,0,0,0,,Қалай болғанда да, біреуін ал.
Dialogue: 0,0:33:11.82,0:33:12.74,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:33:12.86,0:33:13.70,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:33:16.41,0:33:17.57,Default,,0,0,0,,Шық! Шығар!
Dialogue: 0,0:33:18.83,0:33:19.99,Default,,0,0,0,,≫ Тап-тап-тап (аяқ дыбысы) (Ол Майт) Һм?
Dialogue: 0,0:33:24.08,0:33:25.50,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:33:25.92,0:33:27.17,Default,,0,0,0,,- (Рёта) Рукаваға қауіп төніп тұр! - (Көгуре) Қайтып әкел!
Dialogue: 0,0:33:27.29,0:33:28.75,Default,,0,0,0,,Бұл тым жабысқақ №11!
Dialogue: 0,0:33:28.88,0:33:30.50,Default,,0,0,0,,Күйеу! сұраңыз!
Dialogue: 0,0:33:30.92,0:33:32.55,Default,,0,0,0,,Мен жеңіліске шыдай алмаймын.
Dialogue: 0,0:33:33.09,0:33:34.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:33:36.13,0:33:37.14,Default,,0,0,0,,
Dialogue: 0,0:33:38.18,0:33:39.05,Default,,0,0,0,,Не!
Dialogue: 0,0:33:39.18,0:33:42.47,Default,,0,0,0,,Ооооооооо!
Dialogue: 0,0:33:42.60,0:33:43.60,Default,,0,0,0,,Уақыт бітті!
Dialogue: 0,0:33:44.02,0:33:45.10,Default,,0,0,0,,Керемет ойын Керемет ойын
Dialogue: 0,0:33:45.23,0:33:46.60,Default,,0,0,0,,Жағдайы жақсы, жағдайы жақсы!
Dialogue: 0,0:33:50.44,0:33:53.07,Default,,0,0,0,,Орташа команданың осы уақытқа жетуіне не себеп болды?
Dialogue: 0,0:33:53.19,0:33:54.90,Default,,0,0,0,,Өйткені мақсаттың түбі күшті
Dialogue: 0,0:33:55.86,0:33:58.57,Default,,0,0,0,,Күйеуім ұрысатындықтан, айналамдағылар өмір сүре алады.
Dialogue: 0,0:34:02.37,0:34:03.54,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:34:05.62,0:34:07.83,Default,,0,0,0,,Қорғаныс! қорғаныс!
Dialogue: 0,0:34:07.96,0:34:09.42,Default,,0,0,0,,Қорғаныс - бұл сезім!
Dialogue: 0,0:34:10.21,0:34:11.71,Default,,0,0,0,,Сөзімізді айтайық!
Dialogue: 0,0:34:12.50,0:34:15.01,Default,,0,0,0,,Ааааааааааааааааааааааааааааччии
Dialogue: 0,0:34:17.55,0:34:18.63,Default,,0,0,0,,Мияги!
Dialogue: 0,0:34:19.26,0:34:20.30,Default,,0,0,0,,Әңгімелесейік пе?
Dialogue: 0,0:34:20.43,0:34:23.89,Default,,0,0,0,,Үніңді жауып, ойнама! Сөйле!
Dialogue: 0,0:34:25.18,0:34:26.27,Default,,0,0,0,,Гохон
Dialogue: 0,0:34:27.06,0:34:28.10,Default,,0,0,0,,Келесі!
Dialogue: 0,0:34:29.15,0:34:31.69,Default,,0,0,0,,Мен ондай адам емеспін.
Dialogue: 0,0:34:31.81,0:34:32.90,Default,,0,0,0,,Мияги!
Dialogue: 0,0:34:45.91,0:34:48.54,Default,,0,0,0,,Осындай салқын пас қажет болды ма? қазір
Dialogue: 0,0:34:49.46,0:34:51.00,Default,,0,0,0,,Сіздің ойыныңыз күлкілі!
Dialogue: 0,0:34:51.13,0:34:51.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:52.09,0:34:54.55,Default,,0,0,0,,Шулы.
Dialogue: 0,0:34:54.96,0:34:56.71,Default,,0,0,0,,Оны елемеңіз.
Dialogue: 0,0:34:56.84,0:34:58.59,Default,,0,0,0,,Балалар, ақырында үйреніп кетесіңдер.
Dialogue: 0,0:35:00.89,0:35:02.93,Default,,0,0,0,,Бұл өту жылдамырақ
Dialogue: 0,0:35:05.18,0:35:07.52,Default,,0,0,0,,Қорғаныс жауап бере алмайды
Dialogue: 0,0:35:09.89,0:35:11.73,Default,,0,0,0,,Жоқ, мен одақтастарым да жауап бере алмайды деп ешқашан күткен емеспін.
Dialogue: 0,0:35:11.81,0:35:13.69,Default,,0,0,0,,Мен олай ойламадым.
Dialogue: 0,0:35:14.65,0:35:15.82,Default,,0,0,0,,Не!
Dialogue: 0,0:35:17.94,0:35:20.82,Default,,0,0,0,,сәйкес келмейді Шынымен сәйкес келмейді
Dialogue: 0,0:35:22.62,0:35:24.41,Default,,0,0,0,,Өйткені мен оны асыға күтемін.
Dialogue: 0,0:35:25.24,0:35:27.50,Default,,0,0,0,,Акаги-сан басқаларға қарағанда Риотаны көбірек ойлайды.
Dialogue: 0,0:35:27.62,0:35:28.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:29.08,0:35:30.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:35:30.87,0:35:31.79,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:35:33.00,0:35:34.29,Default,,0,0,0,,Tsk! а?
Dialogue: 0,0:35:46.26,0:35:49.10,Default,,0,0,0,,Хмм? Хехе
Dialogue: 0,0:35:51.31,0:35:53.40,Default,,0,0,0,,О? Хехе
Dialogue: 0,0:35:55.82,0:35:57.44,Default,,0,0,0,,Читчи на
Dialogue: 0,0:35:58.32,0:36:01.20,Default,,0,0,0,,Оны кім күтеді? бұл кішкентай жігіт
Dialogue: 0,0:36:02.15,0:36:04.07,Default,,0,0,0,,Баскетболда биіктік маңызды емес пе?
Dialogue: 0,0:36:04.91,0:36:05.91,Default,,0,0,0,,Әй?
Dialogue: 0,0:36:06.24,0:36:07.70,Default,,0,0,0,,Райотаға барайық
Dialogue: 0,0:36:07.83,0:36:09.08,Default,,0,0,0,,- (Рёта) Әй, ұзын шаш! -(Ясуда) Ой, жүр.
Dialogue: 0,0:36:09.37,0:36:10.41,Default,,0,0,0,,Әй?
Dialogue: 0,0:36:10.54,0:36:11.58,Default,,0,0,0,,Ах!?
Dialogue: 0,0:36:12.00,0:36:14.17,Default,,0,0,0,,Мен оны кез келген уақытта 1-ге 1 орындаймын.
Dialogue: 0,0:36:14.29,0:36:15.59,Default,,0,0,0,,Оның орнына, сіз
Dialogue: 0,0:36:16.09,0:36:18.09,Default,,0,0,0,,Жеңілсең ұлсың.
Dialogue: 0,0:36:18.21,0:36:20.09,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:36:20.21,0:36:23.59,Default,,0,0,0,,(Құқық бұзушылардың айқайы)
Dialogue: 0,0:36:24.26,0:36:27.01,Default,,0,0,0,,Цк... анау бала.
Dialogue: 0,0:36:27.14,0:36:28.60,Default,,0,0,0,,- (Мицуи) Норио - (Хотта) Әй?
Dialogue: 0,0:36:30.06,0:36:31.60,Default,,0,0,0,,Мен ол жігітті басып тастаймын.
Dialogue: 0,0:36:32.31,0:36:34.06,Default,,0,0,0,,Келісемін (саусақтарды сермеу)
Dialogue: 0,0:36:39.94,0:36:42.11,Default,,0,0,0,,(Дриблинг дыбысы)
Dialogue: 0,0:36:44.61,0:36:45.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:36:56.88,0:36:59.59,Default,,0,0,0,,Бірақ ол бәрін жоғалтты
Dialogue: 0,0:37:01.21,0:37:05.34,Default,,0,0,0,,Неліктен талонға кіре алмаймын? Мен оны бере алмаймын.
Dialogue: 0,0:37:08.85,0:37:10.06,Default,,0,0,0,,- (Ақағы) Сенпай! -(Тәкенака) Әй!
Dialogue: 0,0:37:10.22,0:37:11.47,Default,,0,0,0,,(Допты кесу дыбысы)
Dialogue: 0,0:37:12.23,0:37:14.06,Default,,0,0,0,,Уф… ағам…
Dialogue: 0,0:37:14.44,0:37:15.69,Default,,0,0,0,,Бос доп!
Dialogue: 0,0:37:16.56,0:37:17.56,Default,,0,0,0,,Қорғаныс!
Dialogue: 0,0:37:17.69,0:37:19.23,Default,,0,0,0,,Артқа қайт, қайт!
Dialogue: 0,0:37:19.94,0:37:22.19,Default,,0,0,0,,Мені шығарып сал, Чикушо
Dialogue: 0,0:37:23.07,0:37:24.57,Default,,0,0,0,,Хаха...
Dialogue: 0,0:37:24.70,0:37:26.07,Default,,0,0,0,,
Dialogue: 0,0:37:37.29,0:37:38.50,Default,,0,0,0,,Гетаксо
Dialogue: 0,0:37:39.96,0:37:42.76,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:37:46.80,0:37:47.80,Default,,0,0,0,,(өшіру дыбысы)
Dialogue: 0,0:37:49.43,0:37:51.18,Default,,0,0,0,,(шкаф есігінің жабылу дыбысы)
Dialogue: 0,0:37:51.31,0:37:52.14,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:37:52.26,0:37:55.85,Default,,0,0,0,,Мен бар күшімді салған жалғыз мен болғандай сезінемін.
Dialogue: 0,0:37:56.48,0:37:58.90,Default,,0,0,0,,А, бітті.
Dialogue: 0,0:37:59.23,0:38:00.94,Default,,0,0,0,,Енді мен зейнеткерлікке шықтым!
Dialogue: 0,0:38:01.07,0:38:02.65,Default,,0,0,0,,Біздің ұрпақ кетті
Dialogue: 0,0:38:02.78,0:38:07.74,Default,,0,0,0,,Террор диктатурасы ақыры басталғалы тұр.
Dialogue: 0,0:38:08.49,0:38:10.28,Default,,0,0,0,,Денемнің қатып қалатынына ешқандай белгі болмады…
Dialogue: 0,0:38:11.08,0:38:14.70,Default,,0,0,0,,Жарайсыңдар, балалар бір жыл бойы бар күшіңді салуларың керек.
Dialogue: 0,0:38:15.91,0:38:18.42,Default,,0,0,0,,Жазға дейін шыдамаймын
Dialogue: 0,0:38:19.00,0:38:20.29,Default,,0,0,0,,Проблемалық бала
Dialogue: 0,0:38:20.71,0:38:21.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:22.30,0:38:24.51,Default,,0,0,0,,Не? Бұл көздер
Dialogue: 0,0:38:25.42,0:38:26.88,Default,,0,0,0,,Сіз оны атайсыз ба?
Dialogue: 0,0:38:27.34,0:38:31.18,Default,,0,0,0,,Ұлулар мен проблемалы балалар, олардың тіл табысуы мүмкін емес.
Dialogue: 0,0:38:31.43,0:38:32.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:38:32.85,0:38:33.68,Default,,0,0,0,,Ах
Dialogue: 0,0:38:34.06,0:38:35.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:35.47,0:38:37.60,Default,,0,0,0,,Мияги өте алады
Dialogue: 0,0:38:42.82,0:38:47.45,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:38:47.57,0:38:51.87,Default,,0,0,0,,Сіз тым көп ойлап отырсыз. Мен аяғымды аздап жылжытуым керек пе?
Dialogue: 0,0:38:52.83,0:38:54.45,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:38:54.58,0:38:55.87,Default,,0,0,0,,- (Анзай) Когуре-кун - (Когуре) Иә.
Dialogue: 0,0:38:56.20,0:38:57.71,Default,,0,0,0,,Мен Сакураги-кунмен орын ауыстырамын.
Dialogue: 0,0:38:57.91,0:38:59.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:59.29,0:39:01.88,Default,,0,0,0,,Иә Бастау Қызыл шық!
Dialogue: 0,0:39:06.09,0:39:09.93,Default,,0,0,0,,Қария! Бұл данышпанды тастау үшін ...
Dialogue: 0,0:39:10.26,0:39:11.64,Default,,0,0,0,,Сіз бас тарттыңыз.
Dialogue: 0,0:39:12.68,0:39:15.97,Default,,0,0,0,,Мегане-кун зейнеткерлікке шыққандықтан, ол оны ақыры босататынын айтады.
Dialogue: 0,0:39:16.85,0:39:18.48,Default,,0,0,0,,Санно Келесі қарсылас қайда?
Dialogue: 0,0:39:18.60,0:39:20.81,Default,,0,0,0,,О, Айва Гакуин қызықты көрінеді
Dialogue: 0,0:39:22.44,0:39:24.23,Default,,0,0,0,,Мен жалғызбын ба...?
Dialogue: 0,0:39:24.36,0:39:26.65,Default,,0,0,0,,Егер сіз әлі де жеңемін деп ойласаңыз...
Dialogue: 0,0:39:26.78,0:39:29.45,Default,,0,0,0,,Берген жоқсың ба, қария...
Dialogue: 0,0:39:30.45,0:39:31.82,Default,,0,0,0,,Бас тарту керек пе?
Dialogue: 0,0:39:33.57,0:39:37.04,Default,,0,0,0,,Егер бас тартсаң, ойын бітеді, солай ма?
Dialogue: 0,0:39:37.50,0:39:38.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:38.91,0:39:40.12,Default,,0,0,0,,- (Ryota) Экранды өшіріңіз! -(Көгуре) Жарайды.
Dialogue: 0,0:39:43.00,0:39:44.00,Default,,0,0,0,,(Шешіліп жатқан атыстың дыбысы)
Dialogue: 0,0:39:45.04,0:39:47.09,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:39:47.71,0:39:49.34,Default,,0,0,0,,Келесіде кірсем, барамын. Дайын бол.
Dialogue: 0,0:39:49.47,0:39:50.30,Default,,0,0,0,,Иә
Dialogue: 0,0:39:52.01,0:39:53.47,Default,,0,0,0,,Биіктігі қиын
Dialogue: 0,0:39:54.64,0:39:55.76,Default,,0,0,0,,Хмм.
Dialogue: 0,0:40:01.27,0:40:02.27,Default,,0,0,0,,Рибан!
Dialogue: 0,0:40:03.19,0:40:04.23,Default,,0,0,0,,Міне, уақыты!
Dialogue: 0,0:40:04.77,0:40:05.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:07.11,0:40:10.82,Default,,0,0,0,,Егер сіз кері соққы алған болсаңыз не болар еді?
Dialogue: 0,0:40:15.66,0:40:18.04,Default,,0,0,0,,Yamao Сенімді жоғалту?
Dialogue: 0,0:40:19.25,0:40:20.75,Default,,0,0,0,,Жоқ
Dialogue: 0,0:40:20.87,0:40:26.21,Default,,0,0,0,,Біріншіден, Санноның соққылардан жылдам шабуылдары жоғалады.
Dialogue: 0,0:40:27.71,0:40:32.13,Default,,0,0,0,,Ал Шохокуда тағы бір мүмкіндік болады.
Dialogue: 0,0:40:32.55,0:40:33.97,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:40:35.01,0:40:39.18,Default,,0,0,0,,Минус 2 ұпай жоғалып, плюс 2 ұпайға мүмкіндік жасайды
Dialogue: 0,0:40:40.27,0:40:41.93,Default,,0,0,0,,Түсіндің бе, Сакураги-кун?
Dialogue: 0,0:40:43.27,0:40:43.98,Default,,0,0,0,,Ура!
Dialogue: 0,0:40:44.06,0:40:46.15,Default,,0,0,0,,Бұл жұмыстың 4 ұпайына тең!
Dialogue: 0,0:40:48.19,0:40:52.95,Default,,0,0,0,,Егер сіз мұны істей алсаңыз, сіз қуып жетуге болатын козир боласыз...!
Dialogue: 0,0:40:54.24,0:40:56.41,Default,,0,0,0,,Доп, сорып ал Доп, сор
Dialogue: 0,0:40:56.53,0:40:57.74,Default,,0,0,0,,Ахх!
Dialogue: 0,0:41:00.04,0:41:03.08,Default,,0,0,0,,Мен өз ойымды сенің жүрегіңе салдым, өтінемін, Сакураги-кун!
Dialogue: 0,0:41:03.46,0:41:04.33,Default,,0,0,0,,- (Сасаока) Мен де! - (Сакураги) А?
Dialogue: 0,0:41:05.37,0:41:07.29,Default,,0,0,0,,Менің де ойым! Сору, сору~
Dialogue: 0,0:41:07.42,0:41:09.34,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:41:09.84,0:41:11.21,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:41:14.59,0:41:16.30,Default,,0,0,0,,Мүлдем.
Dialogue: 0,0:41:16.47,0:41:18.85,Default,,0,0,0,,Қарапайым адам осылай ойлайды.
Dialogue: 0,0:41:18.97,0:41:20.76,Default,,0,0,0,,Жарайды, мен қарапайым адаммын.
Dialogue: 0,0:41:20.89,0:41:22.81,Default,,0,0,0,,Сіз жай ғана ойлану арқылы серпіліске жете аласыз ба?
Dialogue: 0,0:41:26.69,0:41:27.98,Default,,0,0,0,,Әлі емес пе, қария?
Dialogue: 0,0:41:28.65,0:41:31.98,Default,,0,0,0,,Менің кезегім әлі алда...!
Dialogue: 0,0:41:32.53,0:41:36.57,Default,,0,0,0,,- (Сакураги) Мені тез шығар! - (Шонохоку орындық) Ооо!
Dialogue: 0,0:41:36.70,0:41:39.07,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:41:39.49,0:41:43.75,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:41:44.25,0:41:45.08,Default,,0,0,0,,Фу…
Dialogue: 0,0:41:48.25,0:41:50.59,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:41:50.92,0:41:52.84,Default,,0,0,0,,Ханамичи~!
Dialogue: 0,0:41:52.96,0:41:55.55,Default,,0,0,0,,Осы ұпай айырмашылығымен сіз Сакурагиді жібересіз бе?
Dialogue: 0,0:41:56.13,0:41:59.39,Default,,0,0,0,,Сол бір жылда 3P (үш ұпай) болған жоқ.
Dialogue: 0,0:42:00.39,0:42:02.22,Default,,0,0,0,,Сәттілік Сакураги
Dialogue: 0,0:42:02.51,0:42:04.39,Default,,0,0,0,,Аа, Мистер Көзілдірік
Dialogue: 0,0:42:05.23,0:42:06.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:06.39,0:42:07.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:07.94,0:42:08.94,Default,,0,0,0,,
Dialogue: 0,0:42:12.27,0:42:13.11,Default,,0,0,0,,Хмф!
Dialogue: 0,0:42:13.86,0:42:14.90,Default,,0,0,0,,Ханамичи
Dialogue: 0,0:42:15.53,0:42:17.45,Default,,0,0,0,,Мен сені күттім, проблема бала.
Dialogue: 0,0:42:19.95,0:42:21.95,Default,,0,0,0,,Қуып жетейік, Доширото
Dialogue: 0,0:42:24.75,0:42:29.08,Default,,0,0,0,,Егер бас тартсаң, ойын бітті...
Dialogue: 0,0:42:29.83,0:42:35.09,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:42:36.63,0:42:37.42,Default,,0,0,0,,Аһ!
Dialogue: 0,0:42:38.76,0:42:39.59,Default,,0,0,0,,Эй!
Dialogue: 0,0:42:40.39,0:42:43.39,Default,,0,0,0,,Не... осындай уақытта не істеу керек?
Dialogue: 0,0:42:44.22,0:42:46.14,Default,,0,0,0,,Қарғыс атсын! Уф...
Dialogue: 0,0:42:47.98,0:42:49.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:42:55.48,0:42:56.69,Default,,0,0,0,,Оо?
Dialogue: 0,0:42:57.07,0:43:00.57,Default,,0,0,0,,Соңында соққы алмасқан адамның сен болғаныңа қуаныштымын
Dialogue: 0,0:43:04.20,0:43:05.16,Default,,0,0,0,,Бұл не, сен?
Dialogue: 0,0:43:05.29,0:43:06.00,Default,,0,0,0,,
Dialogue: 0,0:43:06.12,0:43:07.96,Default,,0,0,0,,Не істеп жатырсың! Түсіңіз!
Dialogue: 0,0:43:08.41,0:43:09.58,Default,,0,0,0,,Әлгі ақымақ!
Dialogue: 0,0:43:11.17,0:43:12.00,Default,,0,0,0,,А...
Dialogue: 0,0:43:12.92,0:43:13.92,Default,,0,0,0,,Ухон
Dialogue: 0,0:43:15.30,0:43:19.93,Default,,0,0,0,,Мен Ямаоны жеңемін! Гений Сакураги!
Dialogue: 0,0:43:24.60,0:43:27.39,Default,,0,0,0,,Бас тарту! Сіз не ойлап отырсыз?
Dialogue: 0,0:43:27.52,0:43:28.52,Default,,0,0,0,,Онда түс!
Dialogue: 0,0:43:29.85,0:43:31.52,Default,,0,0,0,,Қуып жіберіңіз!
Dialogue: 0,0:43:34.11,0:43:35.32,Default,,0,0,0,,О...
Dialogue: 0,0:43:36.19,0:43:37.32,Default,,0,0,0,,Бақатаре!
Dialogue: 0,0:43:38.94,0:43:39.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:43:40.07,0:43:43.37,Default,,0,0,0,,Бұл жігіт баскетбол ойнай бастағанына төрт ай болды...
Dialogue: 0,0:43:43.49,0:43:45.99,Default,,0,0,0,,Егер келесі жолы солай жасасаңыз, сізді қуып жібереді.
Dialogue: 0,0:43:47.24,0:43:50.75,Default,,0,0,0,,Хехехехех, қалайсың?
Dialogue: 0,0:43:52.00,0:43:53.25,Default,,0,0,0,,Әй?
Dialogue: 0,0:43:55.79,0:43:58.05,Default,,0,0,0,,Енді жеңуден басқа амалымыз жоқ.
Dialogue: 0,0:43:58.30,0:44:00.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:01.93,0:44:03.47,Default,,0,0,0,,Бұл не, Гори? Ол бет
Dialogue: 0,0:44:03.59,0:44:05.55,Default,,0,0,0,,Сіз жеңе алмаймын деп ойлайсыз ба?
Dialogue: 0,0:44:05.85,0:44:07.14,Default,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:44:07.56,0:44:09.48,Default,,0,0,0,,Бұл сіз айтқандай оңайлықпен ұпай айырмашылығы емес.
Dialogue: 0,0:44:09.60,0:44:10.60,Default,,0,0,0,,Әй?
Dialogue: 0,0:44:10.73,0:44:11.77,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:44:11.89,0:44:15.61,Default,,0,0,0,,Баскетболдағы бөртпенің жалпы мағынасы маған қатысты емес.
Dialogue: 0,0:44:16.94,0:44:18.90,Default,,0,0,0,,Өйткені бұл Широто!
Dialogue: 0,0:44:25.57,0:44:26.99,Default,,0,0,0,,Кәне, кеттік, балалар!
Dialogue: 0,0:44:27.12,0:44:29.70,Default,,0,0,0,,Өлім ниетімен осы данышпанның соңынан ер!
Dialogue: 0,0:44:30.04,0:44:32.54,Default,,0,0,0,,Шығу! Шығарыңыз! Төреші: Бұл тәтті!
Dialogue: 0,0:44:32.67,0:44:34.67,Default,,0,0,0,,А? Мен сені ести алмаймын
Dialogue: 0,0:44:35.54,0:44:36.96,Default,,0,0,0,,Colla temera!
Dialogue: 0,0:44:37.80,0:44:39.76,Default,,0,0,0,,Жеңіске қуанайық!
Dialogue: 0,0:44:39.88,0:44:41.51,Default,,0,0,0,,Мазасыз тұтынушыларға берілмеңіз!
Dialogue: 0,0:44:43.63,0:44:45.51,Default,,0,0,0,,«Жеңіске»?
Dialogue: 0,0:44:46.93,0:44:47.93,Default,,0,0,0,,Алғашқыда сүйкімді көрінгенімен,
Dialogue: 0,0:44:48.68,0:44:50.89,Default,,0,0,0,,- (Какуда) Сіз әлі де жарыса аласыз! -(Иши) Жүр!
Dialogue: 0,0:44:53.23,0:44:53.98,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:44:54.10,0:44:56.52,Default,,0,0,0,,Анау ақымақ түзу ойлай алмайды, үйге қайт!
Dialogue: 0,0:44:56.81,0:44:57.69,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:44:58.36,0:44:59.23,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:45:02.24,0:45:03.15,Default,,0,0,0,,Уф!
Dialogue: 0,0:45:05.95,0:45:06.70,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:45:12.83,0:45:14.00,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:45:14.12,0:45:15.04,Default,,0,0,0,,Мен бұған жол бермеймін. Мен бұған жол бермеймін!
Dialogue: 0,0:45:15.50,0:45:16.33,Default,,0,0,0,,Тынш!
Dialogue: 0,0:45:21.09,0:45:22.01,Default,,0,0,0,,Фу…
Dialogue: 0,0:45:25.97,0:45:28.55,Default,,0,0,0,,Екінші таймдағы есеп 26-2
Dialogue: 0,0:45:28.68,0:45:30.81,Default,,0,0,0,,Бірақ қуатта онша үлкен айырмашылық жоқ.
Dialogue: 0,0:45:31.31,0:45:33.14,Default,,0,0,0,,Ағын міндетті түрде қайтадан келеді!
Dialogue: 0,0:45:34.14,0:45:37.52,Default,,0,0,0,,Бұл жағдайда, егер айырмашылық шамамен 10 ұпай болса, әлі де мүмкіндік бар!
Dialogue: 0,0:45:40.02,0:45:41.19,Default,,0,0,0,,Akagi Help!
Dialogue: 0,0:45:46.16,0:45:47.03,Default,,0,0,0,,- (Көгуре) Жарайсың! -(Ясуда) Риота!
Dialogue: 0,0:45:48.16,0:45:49.16,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:45:49.70,0:45:51.95,Default,,0,0,0,,Ағынды өзіміз табуымыз керек!
Dialogue: 0,0:45:53.79,0:45:55.50,Default,,0,0,0,,Хаха...
Dialogue: 0,0:45:56.00,0:45:57.42,Default,,0,0,0,,Хаха...
Dialogue: 0,0:45:58.50,0:46:00.21,Default,,0,0,0,,Ей ей ей ей ей ей эй ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей ей
Dialogue: 0,0:46:01.25,0:46:02.50,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:46:02.92,0:46:04.34,Default,,0,0,0,,- (Ишии) Үш! -(Сасаока) Кіріңіз!
Dialogue: 0,0:46:06.88,0:46:07.97,Default,,0,0,0,,Уф! Сол қол...
Dialogue: 0,0:46:08.09,0:46:09.14,Default,,0,0,0,,Бұл жалған!
Dialogue: 0,0:46:14.18,0:46:15.73,Default,,0,0,0,,- (Ясуда) Ия! -(Какуда) Сакураги!
Dialogue: 0,0:46:15.85,0:46:17.02,Default,,0,0,0,,Ханамичи
Dialogue: 0,0:46:17.77,0:46:19.81,Default,,0,0,0,,Кахахаха, көрдің бе?
Dialogue: 0,0:46:20.23,0:46:22.57,Default,,0,0,0,,Керемет! Ол бала нұсқауды орындады...!
Dialogue: 0,0:46:22.69,0:46:26.24,Default,,0,0,0,,Маған осы екі кітап берілген сияқты.
Dialogue: 0,0:46:27.07,0:46:32.45,Default,,0,0,0,,Сондай-ақ, Сакурагиді қосу мақсаты тек кері серпілу үшін ғана емес.
Dialogue: 0,0:46:32.58,0:46:33.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:34.04,0:46:35.95,Default,,0,0,0,,Алдымен ұпай айырмашылығын 10 ұпайға жеткізейік!
Dialogue: 0,0:46:36.08,0:46:37.04,Default,,0,0,0,,Лорд Тенген…
Dialogue: 0,0:46:37.16,0:46:40.50,Default,,0,0,0,,Бар, жүр, Шохоку! Осеоза Шохоку!
Dialogue: 0,0:46:40.79,0:46:43.59,Default,,0,0,0,,Шохокуға бар! Осеоза Шохоку!
Dialogue: 0,0:46:43.71,0:46:46.26,Default,,0,0,0,,Қорғаныс! Қорғаныс!
Dialogue: 0,0:46:49.22,0:46:50.18,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:46:50.43,0:46:52.01,Default,,0,0,0,,Күйеу! Допты тым көп тоқтатыңыз!
Dialogue: 0,0:46:53.68,0:46:54.97,Default,,0,0,0,,Ах! Бұл өте жақсы сәйкес келмейді
Dialogue: 0,0:46:55.60,0:46:56.43,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:47:02.11,0:47:02.98,Default,,0,0,0,,Әй!
Dialogue: 0,0:47:03.11,0:47:04.11,Default,,0,0,0,,Қымбат екен!
Dialogue: 0,0:47:04.78,0:47:05.61,Default,,0,0,0,,Дая!
Dialogue: 0,0:47:05.73,0:47:07.40,Default,,0,0,0,,Жоқ, одан да көп...
Dialogue: 0,0:47:07.90,0:47:08.74,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,0:47:09.07,0:47:10.28,Default,,0,0,0,,Неліктен!?
Dialogue: 0,0:47:13.53,0:47:15.29,Default,,0,0,0,,Қызыл бала! Сіз жасай аласыз!
Dialogue: 0,0:47:16.54,0:47:17.41,Default,,0,0,0,,өту! гүл композициясы!
Dialogue: 0,0:47:18.46,0:47:19.46,Default,,0,0,0,,Менің атым Джоэстар. Өмірімді сақтап қалғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,0:47:22.21,0:47:23.67,Default,,0,0,0,,Ха...
Dialogue: 0,0:47:26.59,0:47:28.22,Default,,0,0,0,,Ұлттық үстемдік...
Dialogue: 0,0:47:30.01,0:47:33.18,Default,,0,0,0,,Уууу!
Dialogue: 0,0:47:33.30,0:47:34.14,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:47:34.47,0:47:35.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:36.68,0:47:37.93,Default,,0,0,0,,
Dialogue: 0,0:47:38.98,0:47:40.85,Default,,0,0,0,,Құқық бұзушылық! Қылмыстық айыптау!
Dialogue: 0,0:47:40.98,0:47:42.90,Default,,0,0,0,,Мен... аа...
Dialogue: 0,0:47:44.36,0:47:45.82,Default,,0,0,0,,Хаха...
Dialogue: 0,0:47:45.94,0:47:49.90,Default,,0,0,0,,Жалғыз, дандан, жалғыз, дандан♪
Dialogue: 0,0:47:50.03,0:47:54.03,Default,,0,0,0,,Жалғыз, дандан, жалғыз, дандан♪
Dialogue: 0,0:47:54.16,0:47:55.66,Default,,0,0,0,,Жалғыз...♪
Dialogue: 0,0:47:55.78,0:47:57.58,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:47:57.70,0:47:59.00,Default,,0,0,0,,Хмм... ашыңыз.
Dialogue: 0,0:47:59.12,0:48:01.67,Default,,0,0,0,,Ашық қалдырыңыз... тут... йо!
Dialogue: 0,0:48:01.79,0:48:03.04,Default,,0,0,0,,Itatatatata!
Dialogue: 0,0:48:03.17,0:48:04.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:05.04,0:48:06.04,Default,,0,0,0,,Хехехе
Dialogue: 0,0:48:07.92,0:48:10.84,Default,,0,0,0,,Осылай құлайық
Dialogue: 0,0:48:11.63,0:48:13.80,Default,,0,0,0,,Мен ешкімді кінәламаймын
Dialogue: 0,0:48:13.93,0:48:15.85,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:48:16.39,0:48:18.14,Default,,0,0,0,,Бұл біріншіден мүмкін емес~♪
Dialogue: 0,0:48:18.27,0:48:20.14,Default,,0,0,0,,Бұл бәрібір мүмкін емес~♪
Dialogue: 0,0:48:20.27,0:48:21.27,Default,,0,0,0,,
Dialogue: 0,0:48:24.02,0:48:29.07,Default,,0,0,0,,Өзіңді ғана дұрыс деп санайсың ба?
Dialogue: 0,0:48:32.49,0:48:36.07,Default,,0,0,0,,Мені мәжбүрлеме, менің арманым – бүкіл елді бағындыру.
Dialogue: 0,0:48:36.20,0:48:37.87,Default,,0,0,0,,Өйткені бұл қолайсыздық туғызады
Dialogue: 0,0:48:39.33,0:48:42.46,Default,,0,0,0,,Мен сенен сұрайын деп едім, Ақағи.
Dialogue: 0,0:48:42.79,0:48:45.71,Default,,0,0,0,,Жоғарыдан төмен қарау қандай сезімде болады?
Dialogue: 0,0:48:46.88,0:48:49.13,Default,,0,0,0,,Қалай ойлайсыңдар, біз қандайбыз?
Dialogue: 0,0:48:59.51,0:49:02.77,Default,,0,0,0,,Хаха...
Dialogue: 0,0:49:13.03,0:49:14.03,Default,,0,0,0,,Ашық!
Dialogue: 0,0:49:16.74,0:49:18.62,Default,,0,0,0,,Ууууууууууу!
Dialogue: 0,0:49:19.37,0:49:21.87,Default,,0,0,0,,Хмм... мм!
Dialogue: 0,0:49:22.58,0:49:23.46,Default,,0,0,0,,(Акагидің кеудесін соққан дыбысы)
Dialogue: 0,0:49:25.79,0:49:26.79,Default,,0,0,0,,Иә
Dialogue: 0,0:49:29.21,0:49:32.84,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:49:36.18,0:49:38.05,Default,,0,0,0,,Амансың ба? Сіз кезекпен жүресіз бе?
Dialogue: 0,0:49:38.18,0:49:39.43,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:49:40.56,0:49:41.64,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:49:41.77,0:49:43.27,Default,,0,0,0,,Бұл менікі...
Dialogue: 0,0:49:44.02,0:49:45.89,Default,,0,0,0,,Тілегім орындалды
Dialogue: 0,0:49:47.60,0:49:49.86,Default,,0,0,0,,Ооо!
Dialogue: 0,0:49:50.36,0:49:51.19,Default,,0,0,0,,Хо
Dialogue: 0,0:49:51.69,0:49:53.69,Default,,0,0,0,,Қазір он жылға жуық уақыт болды, иә? Ол анама тіпті кешірім сұрауға да келген жоқ
Dialogue: 0,0:49:54.57,0:49:57.45,Default,,0,0,0,,Хехе, бұл сұмдық көріне бастады. Ақырында.
Dialogue: 0,0:49:57.78,0:50:01.12,Default,,0,0,0,,Кавада - Кавада, Оме - Оме.
Dialogue: 0,0:50:01.66,0:50:03.70,Default,,0,0,0,,Акаги - Акаги
Dialogue: 0,0:50:03.83,0:50:04.66,Default,,0,0,0,,Мен...
Dialogue: 0,0:50:05.29,0:50:06.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:50:08.04,0:50:09.04,Default,,0,0,0,,Уф!
Dialogue: 0,0:50:11.13,0:50:12.13,Default,,0,0,0,,Эй!
Dialogue: 0,0:50:13.13,0:50:14.80,Default,,0,0,0,,Қызыл шар
Dialogue: 0,0:50:14.92,0:50:17.01,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:50:20.30,0:50:21.30,Default,,0,0,0,,Хехе
Dialogue: 0,0:50:22.39,0:50:23.39,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:50:31.98,0:50:32.90,Default,,0,0,0,,Бір бөтелке!
Dialogue: 0,0:50:34.69,0:50:36.07,Default,,0,0,0,,- (Кавада) Жүр! - (Акаги) Хмф!
Dialogue: 0,0:50:36.19,0:50:38.66,Default,,0,0,0,,Хаха...
Dialogue: 0,0:50:38.78,0:50:41.03,Default,,0,0,0,,Бұл жігіт өзінің шегінде.
Dialogue: 0,0:50:42.08,0:50:45.54,Default,,0,0,0,,Кавада - Кавада, Акаги - Акаги...
Dialogue: 0,0:50:45.66,0:50:46.41,Default,,0,0,0,,Әй?
Dialogue: 0,0:50:46.54,0:50:50.00,Default,,0,0,0,,Ал мен... Мен кіммін?
Dialogue: 0,0:50:51.38,0:50:53.42,Default,,0,0,0,,- (Кавада) Жарысқың келмей ме? -(Акаги) Шу!
Dialogue: 0,0:50:54.21,0:50:56.26,Default,,0,0,0,,Менің атымды айт...!
Dialogue: 0,0:50:56.38,0:50:58.43,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:51:03.51,0:51:04.64,Default,,0,0,0,,- (Құқық бұзушы) Әй... - (Рёта) О...
Dialogue: 0,0:51:13.11,0:51:14.98,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:51:15.36,0:51:17.36,Default,,0,0,0,,Бұл жаман манга ма?
Dialogue: 0,0:51:17.49,0:51:19.49,Default,,0,0,0,,Бұл шынымен де солай.
Dialogue: 0,0:51:34.75,0:51:38.42,Default,,0,0,0,,Маған ұнамайды анау қисық қастарың.
Dialogue: 0,0:51:40.38,0:51:43.64,Default,,0,0,0,,Маған бұл тегіс ұзын шаш ұнамайды.
Dialogue: 0,0:51:46.26,0:51:47.43,Default,,0,0,0,,Гррр…
Dialogue: 0,0:51:50.73,0:51:53.23,Default,,0,0,0,,Менің атымды айт!
Dialogue: 0,0:51:57.11,0:51:58.11,Default,,0,0,0,,Мицуи...!
Dialogue: 0,0:52:04.53,0:52:06.28,Default,,0,0,0,,Не болды, қарт әже?
Dialogue: 0,0:52:06.41,0:52:07.99,Default,,0,0,0,,Оу!
Dialogue: 0,0:52:12.00,0:52:13.50,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:52:18.21,0:52:20.51,Default,,0,0,0,,Жарайды, ұпай айырмашылығы 10 ұпай!
Dialogue: 0,0:52:22.88,0:52:23.72,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:52:25.35,0:52:26.35,Default,,0,0,0,,Сәлем Мияги
Dialogue: 0,0:52:26.81,0:52:28.60,Default,,0,0,0,,Мені пайдалан...
Dialogue: 0,0:52:29.22,0:52:30.56,Default,,0,0,0,,Бұл жұмыс істеді...
Dialogue: 0,0:52:33.73,0:52:38.78,Default,,0,0,0,,Ах... Экранға Акаги қояды.
Dialogue: 0,0:52:38.90,0:52:40.61,Default,,0,0,0,,Мен ашық боламын
Dialogue: 0,0:52:48.08,0:52:51.91,Default,,0,0,0,,Менен 3Р алсаң, ештеңе қалмайды...!
Dialogue: 0,0:52:52.75,0:52:53.58,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:52:58.00,0:52:58.84,Default,,0,0,0,,Оу!
Dialogue: 0,0:52:59.09,0:53:00.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:53:03.22,0:53:04.22,Default,,0,0,0,,Керемет!
Dialogue: 0,0:53:04.76,0:53:07.35,Default,,0,0,0,,Мичи! Үш!
Dialogue: 0,0:53:07.76,0:53:11.56,Default,,0,0,0,,Мен сақинаны қазір ғана көріп тұрмын.
Dialogue: 0,0:53:19.82,0:53:22.65,Default,,0,0,0,,Қане, шабуыл қорғаныстан басталады!
Dialogue: 0,0:53:23.40,0:53:25.24,Default,,0,0,0,,Иә? Сіз қазір қорғаныстасыз ба?
Dialogue: 0,0:53:25.36,0:53:28.41,Default,,0,0,0,,Неліктен? Қалай қарасаң да тозған...
Dialogue: 0,0:53:28.99,0:53:32.58,Default,,0,0,0,,Мацумото уайымдама, ән айтайық, ән салайық
Dialogue: 0,0:53:35.29,0:53:36.83,Default,,0,0,0,,Шибутойга
Dialogue: 0,0:53:37.54,0:53:40.59,Default,,0,0,0,,Егер сіз үштікке жақын болсаңыз, оны қорғау оңайырақ.
Dialogue: 0,0:53:42.88,0:53:43.88,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:53:47.72,0:53:50.01,Default,,0,0,0,,Тек құлаған нәрсені алғаныңызға көз жеткізіңіз.
Dialogue: 0,0:53:51.64,0:53:52.56,Default,,0,0,0,,Келесің бе?
Dialogue: 0,0:53:52.68,0:53:53.85,Default,,0,0,0,,Мен кіре алмаймын.
Dialogue: 0,0:53:54.18,0:53:55.19,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:53:55.39,0:53:56.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:53:56.27,0:53:57.48,Default,,0,0,0,,Ребаунд!
Dialogue: 0,0:53:58.36,0:53:59.19,Default,,0,0,0,,О!
Dialogue: 0,0:53:59.52,0:54:00.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:54:00.57,0:54:01.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:54:01.90,0:54:02.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:54:12.29,0:54:16.87,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:54:17.00,0:54:18.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:54:20.84,0:54:22.96,Default,,0,0,0,,Әй, не болды?
Dialogue: 0,0:54:37.44,0:54:39.60,Default,,0,0,0,,Эй, бұл осы жерден! О...
Dialogue: 0,0:54:39.73,0:54:40.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:41.11,0:54:41.94,Default,,0,0,0,,(бас соғу дыбысы)
Dialogue: 0,0:54:42.19,0:54:43.28,Default,,0,0,0,,Ал ең бастысы, Иносукэ, өзің қалайсың?
Dialogue: 0,0:54:43.57,0:54:44.94,Default,,0,0,0,,Уф!
Dialogue: 0,0:54:45.49,0:54:46.65,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:54:47.07,0:54:48.11,Default,,0,0,0,,Эй!
Dialogue: 0,0:54:48.24,0:54:49.70,Default,,0,0,0,,Сәлем! (соққы дыбысы)
Dialogue: 0,0:54:50.03,0:54:51.99,Default,,0,0,0,,Қалайсың? Корра!
Dialogue: 0,0:54:53.20,0:54:54.04,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:54:54.16,0:54:55.62,Default,,0,0,0,,Бұл! Кола!
Dialogue: 0,0:54:56.16,0:54:58.50,Default,,0,0,0,,Олар… Ди… О…ның… жігіттері…
Dialogue: 0,0:54:58.62,0:55:03.55,Default,,0,0,0,,Бұл ақымақ! Ей, бейбақ!
Dialogue: 0,0:55:07.22,0:55:08.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:55:09.63,0:55:10.72,Default,,0,0,0,,Хамф!
Dialogue: 0,0:55:12.97,0:55:13.89,Default,,0,0,0,,Ой…
Dialogue: 0,0:55:15.81,0:55:16.89,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:55:17.35,0:55:19.56,Default,,0,0,0,,Ааа! Уф!
Dialogue: 0,0:55:19.98,0:55:21.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:21.69,0:55:22.81,Default,,0,0,0,,Үш шан!
Dialogue: 0,0:55:22.94,0:55:24.57,Default,,0,0,0,,Сәлеметсіз бе! Жолдан кет!
Dialogue: 0,0:55:24.69,0:55:30.49,Default,,0,0,0,,Тек сол күні Миямура-кунды шақырғаныңды ұмытпа.
Dialogue: 0,0:55:33.83,0:55:36.54,Default,,0,0,0,,♪~
Dialogue: 0,0:55:36.66,0:55:38.04,Default,,0,0,0,,Мен оны әлдеқашан салып қойғанмын
Dialogue: 0,0:55:44.96,0:55:46.76,Default,,0,0,0,,Қоқысқа қара.
Dialogue: 0,0:55:49.34,0:55:52.64,Default,,0,0,0,,Жүрегім дүрсілдеп кетті.
Dialogue: 0,0:55:54.89,0:55:57.06,Default,,0,0,0,,Не... не болды? Рё-чан!
Dialogue: 0,0:55:57.18,0:55:58.14,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:55:58.27,0:55:59.81,Default,,0,0,0,,Ең ауыр жарақат алған – Зенитсу-сан
Dialogue: 0,0:56:02.56,0:56:03.69,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:56:16.70,0:56:17.54,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:56:21.87,0:56:22.96,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:56:26.54,0:56:27.59,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:56:30.88,0:56:31.93,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:56:39.39,0:56:42.39,Default,,0,0,0,,~♪
Dialogue: 0,0:56:42.98,0:56:49.69,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:56:55.82,0:56:57.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:56:57.16,0:56:58.28,Default,,0,0,0,,Рё-чан?
Dialogue: 0,0:57:01.33,0:57:02.50,Default,,0,0,0,,Рё-чан!
Dialogue: 0,0:57:03.00,0:57:05.08,Default,,0,0,0,,Рё Чан ана, ояусың!
Dialogue: 0,0:57:06.33,0:57:07.46,Default,,0,0,0,,Рё Чан, жақсысың ба?
Dialogue: 0,0:57:07.59,0:57:10.26,Default,,0,0,0,,Түсіндің бе? Бұл аурухана.
Dialogue: 0,0:57:12.76,0:57:14.34,Default,,0,0,0,,Аурухана...?
Dialogue: 0,0:57:14.76,0:57:17.68,Default,,0,0,0,,Велосипед әбігер болды...
Dialogue: 0,0:57:18.05,0:57:21.31,Default,,0,0,0,,А... велосипедтер...
Dialogue: 0,0:57:22.52,0:57:25.85,Default,,0,0,0,,Мен Окинаваны көрдім, хехехехе...
Dialogue: 0,0:57:26.65,0:57:27.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:28.90,0:57:31.28,Default,,0,0,0,,Сіз не ойлап отырсыз? Сіз!
Dialogue: 0,0:57:38.37,0:57:42.79,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:57:43.46,0:57:47.75,Default,,0,0,0,,Дәрігер: «Менің жолым болды», - деді.
Dialogue: 0,0:57:49.71,0:57:51.63,Default,,0,0,0,,Я...
Dialogue: 0,0:57:56.26,0:57:58.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:58:10.19,0:58:11.19,Default,,0,0,0,,Ах
Dialogue: 0,0:58:11.52,0:58:13.82,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:58:13.94,0:58:16.40,Default,,0,0,0,,Неліктен баяу жүгірмейсіз?
Dialogue: 0,0:58:16.99,0:58:20.33,Default,,0,0,0,,Сіз не туралы айтып отырсыз, бұрынғы бүкіл Жапония ойыншысы?
Dialogue: 0,0:58:28.04,0:58:31.04,Default,,0,0,0,,♪~
Dialogue: 0,0:58:56.24,0:58:58.45,Default,,0,0,0,,Иә? Сен Рё Чансың.
Dialogue: 0,0:58:58.57,0:58:59.41,Default,,0,0,0,,Қашан келдің?
Dialogue: 0,0:59:00.20,0:59:02.58,Default,,0,0,0,,Өсе
Dialogue: 0,0:59:02.70,0:59:03.70,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:59:04.08,0:59:05.87,Default,,0,0,0,,Әже деген кім?
Dialogue: 0,0:59:06.16,0:59:08.41,Default,,0,0,0,,О? Не? Хаха
Dialogue: 0,0:59:08.96,0:59:11.96,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:59:13.25,0:59:14.17,Default,,0,0,0,,Пуппуппу
Dialogue: 0,0:59:14.30,0:59:15.92,Default,,0,0,0,,Со-чан керемет!
Dialogue: 0,0:59:16.05,0:59:16.97,Default,,0,0,0,,Бу!
Dialogue: 0,0:59:17.42,0:59:18.59,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:59:18.72,0:59:19.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:20.30,0:59:21.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:26.81,0:59:29.19,Default,,0,0,0,,(шағала дыбысы)
Dialogue: 0,0:59:31.27,0:59:34.27,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:59:36.94,0:59:39.95,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:59:36.94,0:59:39.95,Default,,0,0,0,,~♪
Dialogue: 0,0:59:44.83,0:59:47.70,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:59:55.50,0:59:56.50,Default,,0,0,0,,Уау!?
Dialogue: 0,0:59:57.63,0:59:58.97,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,1:00:05.22,1:00:06.22,Default,,0,0,0,,Хехе
Dialogue: 0,1:00:48.06,1:00:49.06,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:00:51.68,1:00:52.73,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:09.12,1:01:10.45,Default,,0,0,0,,Бұл кәсіби ме?
Dialogue: 0,1:01:10.79,1:01:13.00,Default,,0,0,0,,Жоқ, жоғары сынып оқушысы
Dialogue: 0,1:01:14.00,1:01:16.25,Default,,0,0,0,,3 қатарынан Жоғары аралық чемпионатқа қол жеткізді
Dialogue: 0,1:01:19.34,1:01:21.59,Default,,0,0,0,,«Ең күшті тау патшасы»
Dialogue: 0,1:01:22.76,1:01:24.18,Default,,0,0,0,,Санно…
Dialogue: 0,1:01:25.26,1:01:27.43,Default,,0,0,0,,Со-чан, сен сонда кіргің келе ме?
Dialogue: 0,1:01:28.14,1:01:29.14,Default,,0,0,0,,Хмм...
Dialogue: 0,1:01:29.97,1:01:31.64,Default,,0,0,0,,Хмм...
Dialogue: 0,1:01:35.90,1:01:38.31,Default,,0,0,0,,(Қаламмен жазу дыбысы)
Dialogue: 0,1:01:39.61,1:01:40.61,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:01:41.32,1:01:43.36,Default,,0,0,0,,Бұл бәрібір
Dialogue: 0,1:01:45.32,1:01:48.95,Default,,0,0,0,,1 орта мектеп 2 орта мектеп 3 орта мектеп 1 орта мектеп...
Dialogue: 0,1:01:49.08,1:01:50.03,Default,,0,0,0,,4 жылдан кейін!
Dialogue: 0,1:01:52.25,1:01:55.75,Default,,0,0,0,,Окинава өкілі Сота Мияги!
Dialogue: 0,1:01:56.42,1:01:57.63,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,1:01:57.75,1:01:59.09,Default,,0,0,0,,А, бұл қауіпті!
Dialogue: 0,1:01:59.21,1:02:01.30,Default,,0,0,0,,Қос ілінісу~
Dialogue: 0,1:02:02.00,1:02:03.84,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:03.97,1:02:05.13,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:02:05.26,1:02:06.09,Default,,0,0,0,,(Шешіліп жатқан атыстың дыбысы)
Dialogue: 0,1:02:06.22,1:02:07.55,Default,,0,0,0,,Шешілді!
Dialogue: 0,1:02:07.72,1:02:10.64,Default,,0,0,0,,Мен ең күшті тау патшасын жеңдім!
Dialogue: 0,1:02:10.76,1:02:11.60,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,1:02:11.72,1:02:13.27,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,1:02:40.29,1:02:41.29,Default,,0,0,0,,Я...
Dialogue: 0,1:02:43.00,1:02:45.42,Default,,0,0,0,,Со-чан, кешіріңіз.
Dialogue: 0,1:02:46.55,1:02:48.09,Default,,0,0,0,,I wonder why
Dialogue: 0,1:02:48.55,1:02:52.26,Default,,0,0,0,,Мен анамды ашуландыра беремін.
Dialogue: 0,1:02:53.72,1:02:55.06,Default,,0,0,0,,Егер Тор осында болса...
Dialogue: 0,1:02:57.56,1:03:01.77,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,1:03:10.74,1:03:13.87,Default,,0,0,0,,Ахх...!
Dialogue: 0,1:03:14.45,1:03:16.70,Default,,0,0,0,,Ааааа...!
Dialogue: 0,1:03:16.83,1:03:19.42,Default,,0,0,0,,Aaaaaaaaaaaaaaaaaaah...aaaaaaaaaaaaaaaaaaaaaaaaaaaah...!
Dialogue: 0,1:03:19.54,1:03:21.75,Default,,0,0,0,,Aaaaaaaaaaaaaaaaaaaah...aaaaaaaaaaaaaaaaaaaaaaah...!
Dialogue: 0,1:03:22.59,1:03:25.76,Default,,0,0,0,,Aaaaaaaaaaaaaaaaaaaaah...aaaaaaaaaaaaaaaaaaaaaaaah...!
Dialogue: 0,1:03:25.88,1:03:28.88,Default,,0,0,0,,Ай!
Dialogue: 0,1:03:41.81,1:03:44.82,Default,,0,0,0,,♪~
Dialogue: 0,1:04:38.87,1:04:40.87,Default,,0,0,0,,(Дриблинг дыбысы)
Dialogue: 0,1:04:44.71,1:04:45.71,Default,,0,0,0,,Әй!
Dialogue: 0,1:04:45.92,1:04:46.79,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:46.92,1:04:48.42,Default,,0,0,0,,(аудитория шуы)
Dialogue: 0,1:04:48.75,1:04:49.84,Default,,0,0,0,,Ал, бақ бұйырсын!
Dialogue: 0,1:04:52.47,1:04:53.88,Default,,0,0,0,,Уау... Эй!
Dialogue: 0,1:04:52.47,1:04:53.88,Default,,0,0,0,,~♪
Dialogue: 0,1:04:54.01,1:04:55.01,Default,,0,0,0,,
Dialogue: 0,1:04:55.80,1:04:56.55,Default,,0,0,0,,Ах
Dialogue: 0,1:04:59.02,1:05:01.06,Default,,0,0,0,,Ниет Ақ саны 4!
Dialogue: 0,1:05:01.18,1:05:02.27,Default,,0,0,0,,(Фукацудың ауыр тыныс алуы)
Dialogue: 0,1:05:02.39,1:05:03.98,Default,,0,0,0,,(қуаныш пен шаттық)
Dialogue: 0,1:05:04.10,1:05:05.44,Default,,0,0,0,,Ниет!?
Dialogue: 0,1:05:05.73,1:05:06.69,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:05:06.81,1:05:08.07,Default,,0,0,0,,Хахаха
Dialogue: 0,1:05:08.19,1:05:09.48,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:05:09.61,1:05:11.44,Default,,0,0,0,,- (Рёта) Жақсы кесілген - (Акаги) Уау!
Dialogue: 0,1:05:14.86,1:05:15.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:16.20,1:05:17.20,Default,,0,0,0,,Иә!?
Dialogue: 0,1:05:18.41,1:05:20.49,Default,,0,0,0,,Бұл ненің басы?
Dialogue: 0,1:05:21.33,1:05:23.71,Default,,0,0,0,,Қайтуды жоспарлайсыз ба?
Dialogue: 0,1:05:24.29,1:05:25.37,Default,,0,0,0,,бұл мәселе болар еді.
Dialogue: 0,1:05:26.42,1:05:28.46,Default,,0,0,0,,Менің бас тартуым нашар.
Dialogue: 0,1:05:28.92,1:05:29.92,Default,,0,0,0,,Я...
Dialogue: 0,1:05:30.38,1:05:31.21,Default,,0,0,0,,Иә!?
Dialogue: 0,1:05:31.51,1:05:33.01,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:36.93,1:05:37.93,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:40.85,1:05:42.27,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,1:05:44.14,1:05:45.23,Default,,0,0,0,,Хмм...
Dialogue: 0,1:05:51.36,1:05:52.69,Default,,0,0,0,,Бұл мәселе!
Dialogue: 0,1:05:53.49,1:05:56.57,Default,,0,0,0,,Осы мүмкіндікті пайдалансақ, әлі де аман қаламыз!
Dialogue: 0,1:05:56.70,1:05:58.28,Default,,0,0,0,,Олай болмаса, Санноны жеңу үшін ешқандай біліктілік жоқ.
Dialogue: 0,1:05:58.66,1:05:59.78,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,1:06:00.03,1:06:01.12,Default,,0,0,0,,Біз 10 ұпай айырмашылығын жасаймыз!
Dialogue: 0,1:06:01.24,1:06:01.99,Default,,0,0,0,,О!
Dialogue: 0,1:06:03.00,1:06:07.17,Default,,0,0,0,,Хмм, біз жақсы ырғаққа кіріп жатырмыз.
Dialogue: 0,1:06:10.34,1:06:14.34,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:06:14.47,1:06:17.09,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,1:06:19.01,1:06:23.89,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:06:24.02,1:06:26.23,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:06:26.35,1:06:29.23,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:06:29.36,1:06:32.07,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:06:32.19,1:06:37.24,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:06:37.36,1:06:41.20,Default,,0,0,0,,Жапонияның ең жақсы қорғаушысы Фукацу екеуміз...
Dialogue: 0,1:06:45.12,1:06:46.41,Default,,0,0,0,,О...
Dialogue: 0,1:06:49.25,1:06:52.25,Default,,0,0,0,,Мен сәйкес келемін бе?
Dialogue: 0,1:06:52.38,1:06:57.43,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,1:07:04.47,1:07:07.48,Default,,0,0,0,,Мен кесу капитанымын.
Dialogue: 0,1:07:10.77,1:07:12.27,Default,,0,0,0,,Менде әрқашан...
Dialogue: 0,1:07:16.11,1:07:17.49,Default,,0,0,0,,Мен әрқашан екіленемін.
Dialogue: 0,1:07:18.49,1:07:22.87,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,1:07:22.99,1:07:24.99,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:07:25.24,1:07:26.37,Default,,0,0,0,,Қай жағынан?
Dialogue: 0,1:07:27.33,1:07:29.08,Default,,0,0,0,,Ол өте жылдам күреседі.
Dialogue: 0,1:07:33.50,1:07:36.84,Default,,0,0,0,,Фукацу Санноның бірінші жылынан бастап негізгі құрамында болды.
Dialogue: 0,1:07:37.59,1:07:40.18,Default,,0,0,0,,Сіз менімен сәйкес боласыз ба?
Dialogue: 0,1:07:41.30,1:07:43.93,Default,,0,0,0,,Өте жақсы, капитан Кат.
Dialogue: 0,1:07:44.64,1:07:45.64,Default,,0,0,0,,Фу…
Dialogue: 0,1:07:49.35,1:07:51.31,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр
Dialogue: 0,1:07:53.81,1:07:56.03,Default,,0,0,0,,Мен білмедім өтірік
Dialogue: 0,1:07:57.19,1:07:59.24,Default,,0,0,0,,Сіз әрқашан ыңғайлы көрінесіз.
Dialogue: 0,1:08:02.07,1:08:04.99,Default,,0,0,0,,(Өсімдіктердің дірілдеген дыбысы)
Dialogue: 0,1:08:05.87,1:08:08.29,Default,,0,0,0,,Сіз де өте сақшысыз.
Dialogue: 0,1:08:08.91,1:08:12.46,Default,,0,0,0,,Канагава №1... бірақ жоқ
Dialogue: 0,1:08:13.00,1:08:16.25,Default,,0,0,0,,No2... бірақ жоқ
Dialogue: 0,1:08:16.71,1:08:17.71,Default,,0,0,0,,Ал...
Dialogue: 0,1:08:17.84,1:08:20.01,Default,,0,0,0,,Жақсы! Бұл жеткілікті
Dialogue: 0,1:08:20.13,1:08:22.97,Default,,0,0,0,,Қиын болған кезде бірдеңе істеуге шешім қабылдаңыз.
Dialogue: 0,1:08:23.84,1:08:24.97,Default,,0,0,0,,(Барлығы төрт адам) Һмм? (JoJo) Дерби?
Dialogue: 0,1:08:25.76,1:08:27.35,Default,,0,0,0,,Дұрыс...
Dialogue: 0,1:08:29.10,1:08:30.60,Default,,0,0,0,,Жақсы мүмкіндік, сондықтан мәселені түпкілікті анықтап алайық.
Dialogue: 0,1:08:33.69,1:08:35.56,Default,,0,0,0,,Алақанға қараңыз
Dialogue: 0,1:08:36.36,1:08:37.36,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:39.82,1:08:43.82,Default,,0,0,0,,(Риотаның ауыр тыныс алуы)
Dialogue: 0,1:08:51.25,1:08:55.88,Default,,0,0,0,,Мияги-кун, сіз үнемі ойнаудан әбден шаршадыңыз.
Dialogue: 0,1:09:02.51,1:09:03.97,Default,,0,0,0,,Рё-чин, шеш!
Dialogue: 0,1:09:04.09,1:09:05.39,Default,,0,0,0,,Шинчоға барыңыз!
Dialogue: 0,1:09:05.47,1:09:06.89,Default,,0,0,0,,Оны жай ғана шешіп алмаңыз!
Dialogue: 0,1:09:07.01,1:09:08.60,Default,,0,0,0,,Шулы және алаңдатады!
Dialogue: 0,1:09:09.27,1:09:13.73,Default,,0,0,0,,Ууууууу~
Dialogue: 0,1:09:18.19,1:09:19.53,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:09:19.94,1:09:22.07,Default,,0,0,0,,А... Аа!
Dialogue: 0,1:09:29.45,1:09:30.45,Default,,0,0,0,,Фу…
Dialogue: 0,1:09:32.75,1:09:34.83,Default,,0,0,0,,Оның жағдайы жақсы.
Dialogue: 0,1:09:41.01,1:09:42.01,Default,,0,0,0,,Фу…
Dialogue: 0,1:09:48.35,1:09:49.60,Default,,0,0,0,,Жақсы! Айтыңызшы...
Dialogue: 0,1:09:49.72,1:09:51.31,Default,,0,0,0,,- (Сакураги) Тынш! -(Рёта) Эй!
Dialogue: 0,1:09:51.43,1:09:52.52,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:09:55.48,1:09:56.48,Default,,0,0,0,,Хмм
Dialogue: 0,1:09:56.98,1:09:57.73,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:58.15,1:09:59.57,Default,,0,0,0,,Экран! ауыстырыңыз!
Dialogue: 0,1:10:03.65,1:10:04.61,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:04.82,1:10:07.11,Default,,0,0,0,,Горилла Данк!
Dialogue: 0,1:10:10.41,1:10:11.62,Default,,0,0,0,,10 ұпай айырмашылығы!
Dialogue: 0,1:10:11.91,1:10:12.91,Default,,0,0,0,,Хмм
Dialogue: 0,1:10:13.37,1:10:14.21,Default,,0,0,0,,Кавата!
Dialogue: 0,1:10:17.92,1:10:18.92,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:20.50,1:10:21.34,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:21.46,1:10:22.38,Default,,0,0,0,,Ах!
Dialogue: 0,1:10:25.80,1:10:26.72,Default,,0,0,0,,(Официант) Ж… Жоқ, мырза. Бұл «Неро» деп аталады➡
Dialogue: 0,1:10:27.26,1:10:28.26,Default,,0,0,0,,Хмф!
Dialogue: 0,1:10:28.80,1:10:30.39,Default,,0,0,0,,Ах!
Dialogue: 0,1:10:30.64,1:10:32.56,Default,,0,0,0,,Кавата қызыл баланы белгілеп тұр!
Dialogue: 0,1:10:32.68,1:10:33.64,Default,,0,0,0,,О!
Dialogue: 0,1:10:33.81,1:10:35.10,Default,,0,0,0,,Кавата…
Dialogue: 0,1:10:35.23,1:10:39.02,Default,,0,0,0,,Мен осыншама көп доп ала алмаған қарсылас кім болды?
Dialogue: 0,1:10:39.15,1:10:42.44,Default,,0,0,0,,Мен сенен басқаны бірінші рет көруім, қарғыс атсын!
Dialogue: 0,1:10:42.57,1:10:44.15,Default,,0,0,0,,Неге сонша бақытты көрінесің?
Dialogue: 0,1:10:44.49,1:10:47.03,Default,,0,0,0,,Хахахаха, өлемін деп маған келші, Маругори!
Dialogue: 0,1:10:47.66,1:10:49.49,Default,,0,0,0,,Хаха! Түсінікті!
Dialogue: 0,1:10:49.87,1:10:53.12,Default,,0,0,0,,Бұл ырғақты жасаған Сакураги болды.
Dialogue: 0,1:10:54.16,1:10:55.08,Default,,0,0,0,,Рибан!
Dialogue: 0,1:10:55.33,1:10:56.37,Default,,0,0,0,,Буо...
Dialogue: 0,1:10:57.25,1:10:58.21,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,1:10:59.63,1:11:01.00,Default,,0,0,0,,Иә? Онда болды ма?
Dialogue: 0,1:11:01.29,1:11:02.34,Default,,0,0,0,,Маругори!
Dialogue: 0,1:11:04.17,1:11:05.80,Default,,0,0,0,,Жоқ, бұл Савакита!
Dialogue: 0,1:11:08.43,1:11:09.59,Default,,0,0,0,,Жарайсың Рукава!
Dialogue: 0,1:11:10.59,1:11:11.35,Default,,0,0,0,,Мені жіберме
Dialogue: 0,1:11:11.55,1:11:12.55,Default,,0,0,0,,Хо
Dialogue: 0,1:11:13.43,1:11:14.18,Default,,0,0,0,,Әй!
Dialogue: 0,1:11:15.06,1:11:15.93,Default,,0,0,0,,Саңырауқұлақтар!
Dialogue: 0,1:11:16.06,1:11:18.06,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:19.06,1:11:20.19,Default,,0,0,0,,О, мен оны тоқтаттым!
Dialogue: 0,1:11:20.31,1:11:23.15,Default,,0,0,0,,Маған дұрыс емес рұқсат берме, Ұйықтап жатырсың ба, түлкі!
Dialogue: 0,1:11:23.69,1:11:24.78,Default,,0,0,0,,Андато?
Dialogue: 0,1:11:27.03,1:11:28.28,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,1:11:28.40,1:11:29.41,Default,,0,0,0,,Не?
Dialogue: 0,1:11:29.70,1:11:32.20,Default,,0,0,0,,Вари Жапонияда үздік атанғанына қатты қуанды.
Dialogue: 0,1:11:32.32,1:11:35.37,Default,,0,0,0,,Мен бұл кішкентай монахқа көмектесе алмайтын сияқтымын.
Dialogue: 0,1:11:36.00,1:11:37.00,Default,,0,0,0,,Я...
Dialogue: 0,1:11:37.37,1:11:39.16,Default,,0,0,0,,- (Рукава) Хмф! - (Сакураги) Шикато? Колла!
Dialogue: 0,1:11:39.58,1:11:41.50,Default,,0,0,0,,Қане, қорғаныс, Сакураги!
Dialogue: 0,1:11:44.13,1:11:47.26,Default,,0,0,0,,Эй, солай ма?
Dialogue: 0,1:11:48.34,1:11:50.93,Default,,0,0,0,,Аа... жаншақта
Dialogue: 0,1:11:51.93,1:11:53.39,Default,,0,0,0,,Мен оны қабылдаймын.
Dialogue: 0,1:11:56.81,1:11:57.64,Default,,0,0,0,,Олар бізден озып кету үшін қиып өтті ме?
Dialogue: 0,1:11:58.68,1:12:00.48,Default,,0,0,0,,- (Акаги) Бұл Кавада! -(Сакураги) Жүр!
Dialogue: 0,1:12:00.60,1:12:01.60,Default,,0,0,0,,Ха!
Dialogue: 0,1:12:03.94,1:12:06.28,Default,,0,0,0,,Иә? Әлі сонда
Dialogue: 0,1:12:10.15,1:12:12.07,Default,,0,0,0,,Жарайсыңдар! Жылдам шабуыл!
Dialogue: 0,1:12:15.95,1:12:16.74,Default,,0,0,0,,Хмф!
Dialogue: 0,1:12:18.12,1:12:19.37,Default,,0,0,0,,Ах! Ол кетті!
Dialogue: 0,1:12:20.08,1:12:20.91,Default,,0,0,0,,Хмф!
Dialogue: 0,1:12:21.21,1:12:22.37,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:12:22.50,1:12:24.34,Default,,0,0,0,,Не болды, қарт әже?
Dialogue: 0,1:12:24.46,1:12:26.50,Default,,0,0,0,,8 ұпай айырмашылығы!
Dialogue: 0,1:12:27.50,1:12:28.51,Default,,0,0,0,,Хмм
Dialogue: 0,1:12:29.01,1:12:31.01,Default,,0,0,0,,Оның белгісі алынуы керек еді.
Dialogue: 0,1:12:31.13,1:12:32.97,Default,,0,0,0,,Шохоку...
Dialogue: 0,1:12:34.93,1:12:37.14,Default,,0,0,0,,Сол бірінші курс дуэтін жоғарыға қойсаңыз
Dialogue: 0,1:12:37.22,1:12:39.31,Default,,0,0,0,,Біраз қиындық тудыратын сияқты.
Dialogue: 0,1:12:39.68,1:12:40.81,Default,,0,0,0,,Біз сол екі адамға қамқорлық жасадық.
Dialogue: 0,1:12:40.89,1:12:42.98,Default,,0,0,0,,Оны басу мүмкін бе, жоқ па, соған байланысты.
Dialogue: 0,1:12:43.35,1:12:46.15,Default,,0,0,0,,Егер сізге соққы тисе, кері соққы беру керек.
Dialogue: 0,1:12:49.23,1:12:50.94,Default,,0,0,0,,Үш еселендіріңіз.
Dialogue: 0,1:12:52.20,1:12:54.28,Default,,0,0,0,,Өтінемін, Фукацу мырза.
Dialogue: 0,1:12:54.82,1:12:56.53,Default,,0,0,0,,Бар, жүр, Санно!
Dialogue: 0,1:12:57.83,1:12:59.37,Default,,0,0,0,,- (Кувата) Шулы! - (Көгуре) Жүр!
Dialogue: 0,1:12:59.50,1:13:00.54,Default,,0,0,0,,1 Қорғаныс тоқтаңыз!
Dialogue: 0,1:13:00.66,1:13:02.21,Default,,0,0,0,,Осеоза Санно!
Dialogue: 0,1:13:04.04,1:13:04.88,Default,,0,0,0,,(Допты соғу дыбысы)
Dialogue: 0,1:13:05.08,1:13:06.29,Default,,0,0,0,,Оны төмендетпеңіз!
Dialogue: 0,1:13:06.59,1:13:07.63,Default,,0,0,0,,Бұл қауіпті, кері қайт!
Dialogue: 0,1:13:10.17,1:13:11.01,Default,,0,0,0,,Бұл кішкентай вакуумдық торнадоның соңғы әсері!
Dialogue: 0,1:13:11.13,1:13:12.01,Default,,0,0,0,,Барыңыз
Dialogue: 0,1:13:13.72,1:13:14.43,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:22.27,1:13:23.44,Default,,0,0,0,,Сонда ше!
Dialogue: 0,1:13:29.69,1:13:34.86,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:13:34.99,1:13:38.33,Default,,0,0,0,,Мен сені күттім, Савакита! Супер Эйс!
Dialogue: 0,1:13:39.12,1:13:41.25,Default,,0,0,0,,Менің жасымда осындай адамдар бар ма?
Dialogue: 0,1:13:42.20,1:13:46.25,Default,,0,0,0,,Менің ойымша, сіз соңғы 17 жыл бойы тек баскетбол туралы ойладыңыз.
Dialogue: 0,1:13:47.46,1:13:48.67,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:13:49.38,1:13:50.55,Default,,0,0,0,,Сіз де, солай ма?
Dialogue: 0,1:13:54.93,1:13:56.26,Default,,0,0,0,,- (Ишии) Мен оны жұлып алдым! -(Домото) Жоқ.
Dialogue: 0,1:13:58.30,1:13:59.60,Default,,0,0,0,,- (Савакита) Фукацу мырза! -(Рёта) Шығар!
Dialogue: 0,1:14:00.31,1:14:01.27,Default,,0,0,0,,Керемет кесу!
Dialogue: 0,1:14:02.43,1:14:03.52,Default,,0,0,0,,О!? Савакита!
Dialogue: 0,1:14:03.64,1:14:05.10,Default,,0,0,0,,Бұл ақымақ! Түлкі!
Dialogue: 0,1:14:05.94,1:14:07.94,Default,,0,0,0,,Ах! Хеначоконың тағы бір түсірілімі!
Dialogue: 0,1:14:08.06,1:14:08.86,Default,,0,0,0,,Ах!
Dialogue: 0,1:14:09.23,1:14:10.07,Default,,0,0,0,,Ах
Dialogue: 0,1:14:10.69,1:14:11.53,Default,,0,0,0,,Келді, келді, келді!
Dialogue: 0,1:14:11.65,1:14:13.07,Default,,0,0,0,,Бұл Магур!
Dialogue: 0,1:14:13.19,1:14:16.82,Default,,0,0,0,,Савакита! Савакита!
Dialogue: 0,1:14:28.21,1:14:31.00,Default,,0,0,0,,Жапонияның ең жақсы ойыншысы болғыңыз келе ме? Рукава
Dialogue: 0,1:14:32.30,1:14:33.13,Default,,0,0,0,,бұл мәселе болар еді.
Dialogue: 0,1:14:33.84,1:14:35.38,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:14:35.51,1:14:36.84,Default,,0,0,0,,Менсіз Жапонияда
Dialogue: 0,1:14:39.64,1:14:40.47,Default,,0,0,0,,Ах!
Dialogue: 0,1:14:41.97,1:14:44.39,Default,,0,0,0,,Эй Дон!
Dialogue: 0,1:14:47.27,1:14:49.15,Default,,0,0,0,,тым кеш! Күте тұрыңыз, Корра!
Dialogue: 0,1:14:52.77,1:14:53.94,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,1:15:09.83,1:15:11.84,Default,,0,0,0,,(қол шапалақтау дыбысы)
Dialogue: 0,1:15:12.63,1:15:15.46,Default,,0,0,0,,Мен орта мектептегі баскетболда қолымнан келгенін жасадым.
Dialogue: 0,1:15:16.84,1:15:19.80,Default,,0,0,0,,Маған дәлелдейтін ештеңе қалмады.
Dialogue: 0,1:15:21.22,1:15:23.64,Default,,0,0,0,,Маған қажетті тәжірибені беріңіз
Dialogue: 0,1:15:24.26,1:15:26.64,Default,,0,0,0,,Егер әлі де бірдеңе болса
Dialogue: 0,1:15:27.35,1:15:29.73,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,1:15:29.98,1:15:31.77,Default,,0,0,0,,Оны маған беріңіз
Dialogue: 0,1:15:34.98,1:15:36.69,Default,,0,0,0,,…6 7 8 9 10
Dialogue: 0,1:15:36.82,1:15:40.53,Default,,0,0,0,,Бес метрге дейін жақындауым керек
Dialogue: 0,1:15:40.66,1:15:44.99,Default,,0,0,0,,Бес метрге дейін жақындауым керек
Dialogue: 0,1:15:45.12,1:15:46.83,Default,,0,0,0,,300!
Dialogue: 0,1:15:49.12,1:15:50.87,Default,,0,0,0,,Осы сияқты
Dialogue: 0,1:15:51.50,1:15:52.92,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:15:53.04,1:15:54.34,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:16:01.89,1:16:02.76,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:02.89,1:16:04.47,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:16:05.31,1:16:08.64,Default,,0,0,0,,Сіз мені Рукаваға 1-ге 1-де жеңе алмайсыз
Dialogue: 0,1:16:08.77,1:16:11.14,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:16:11.27,1:16:14.56,Default,,0,0,0,,Рукаваға соншалықты айқын шабуыл жасалуы мүмкін бе?
Dialogue: 0,1:16:16.94,1:16:17.94,Default,,0,0,0,,Уф...
Dialogue: 0,1:16:19.03,1:16:20.32,Default,,0,0,0,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,1:16:22.61,1:16:23.62,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,1:16:29.45,1:16:30.25,Default,,0,0,0,,Қайта жағу!
Dialogue: 0,1:16:32.17,1:16:35.29,Default,,0,0,0,,Акабозу Бұл жігітті ұшыруға болмайды.
Dialogue: 0,1:16:36.00,1:16:40.55,Default,,0,0,0,,Бірінші допты соға алмау керек, содан кейін ғана допты ұстауға болады.
Dialogue: 0,1:16:40.88,1:16:41.72,Default,,0,0,0,,Қызық!
Dialogue: 0,1:16:42.22,1:16:43.05,Default,,0,0,0,,О!
Dialogue: 0,1:16:48.72,1:16:49.47,Default,,0,0,0,,Әй!
Dialogue: 0,1:16:49.60,1:16:50.68,Default,,0,0,0,,Ой!
Dialogue: 0,1:16:53.31,1:16:56.32,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:17:05.24,1:17:07.53,Default,,0,0,0,,Сіз не істегіңіз келеді? Сіз қазірдің өзінде бас тарттыңыз ба?
Dialogue: 0,1:17:08.12,1:17:10.00,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:17:10.41,1:17:11.37,Default,,0,0,0,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,1:17:11.50,1:17:13.42,Default,,0,0,0,,Жүр! Сіз эйссіз!
Dialogue: 0,1:17:15.83,1:17:17.21,Default,,0,0,0,,Доп қорғансыз!
Dialogue: 0,1:17:19.38,1:17:20.38,Default,,0,0,0,,
Dialogue: 0,1:17:21.63,1:17:24.13,Default,,0,0,0,,Санау! Бір лақтыру!
Dialogue: 0,1:17:26.35,1:17:27.47,Default,,0,0,0,,(Цезарь) Не… Не болып жатыр? Бұл жігіттердің айналасындағы атмосфера…
Dialogue: 0,1:17:27.89,1:17:29.64,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:17:30.27,1:17:31.77,Default,,0,0,0,,Хаха...
Dialogue: 0,1:17:32.56,1:17:37.36,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:17:38.23,1:17:39.23,Default,,0,0,0,,(жұдырықтың соғу дыбысы)
Dialogue: 0,1:17:39.98,1:17:42.78,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,1:17:42.90,1:17:44.36,Default,,0,0,0,,бастық
Dialogue: 0,1:17:44.78,1:17:46.99,Default,,0,0,0,,Ол Жапониядағы ең үздік ойыншы.
Dialogue: 0,1:17:47.95,1:17:50.49,Default,,0,0,0,,Мен сияқты екі жыл, әлі де.
Dialogue: 0,1:17:51.16,1:17:53.62,Default,,0,0,0,,Мына жігіттің көңілсіз жүзіне қараңыз
Dialogue: 0,1:17:57.50,1:17:58.88,Default,,0,0,0,,Мен де
Dialogue: 0,1:17:59.00,1:18:00.34,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,1:18:01.88,1:18:05.18,Default,,0,0,0,,Ойланып қарасам, мен сенімен бірінші рет сөйлесіп тұрмын, солай ма?
Dialogue: 0,1:18:06.55,1:18:11.31,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:18:14.64,1:18:15.98,Default,,0,0,0,,Бұл жақсы ойын болды.
Dialogue: 0,1:18:16.10,1:18:16.94,Default,,0,0,0,,О
Dialogue: 0,1:18:17.65,1:18:18.90,Default,,0,0,0,,Бұл жақсы ойын болды
Dialogue: 0,1:18:19.15,1:18:22.23,Default,,0,0,0,,Шохоку жақсы команда болды.
Dialogue: 0,1:18:25.45,1:18:26.45,Default,,0,0,0,,Эй!
Dialogue: 0,1:18:26.66,1:18:30.12,Default,,0,0,0,,Корттағы бес адам таңғажайып қарсыласпен күресуде.
Dialogue: 0,1:18:30.95,1:18:34.00,Default,,0,0,0,,Орындықта да соңына дейін күресейік!
Dialogue: 0,1:18:41.96,1:18:45.26,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:18:49.30,1:18:50.30,Default,,0,0,0,,Иә
Dialogue: 0,1:18:51.56,1:18:52.39,Default,,0,0,0,,Ха!
Dialogue: 0,1:18:52.51,1:18:53.31,Default,,0,0,0,,(Шешіліп жатқан атыстың дыбысы)
Dialogue: 0,1:18:55.73,1:18:56.73,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:19:05.24,1:19:08.03,Default,,0,0,0,,Сіз әлі түсінбедіңіз бе? Савакитаны жеңе алмайсың.
Dialogue: 0,1:19:16.33,1:19:17.46,Default,,0,0,0,,Бұл не, Рукава?
Dialogue: 0,1:19:21.08,1:19:22.92,Default,,0,0,0,,Тұйық...
Dialogue: 0,1:19:26.42,1:19:27.51,Default,,0,0,0,,Рукава 6 секунд!
Dialogue: 0,1:19:29.76,1:19:32.14,Default,,0,0,0,,Бұл 30 секунд болады! 4 секунд қалды!
Dialogue: 0,1:19:36.06,1:19:36.93,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,1:19:45.23,1:19:46.23,Default,,0,0,0,,
Dialogue: 0,1:19:47.36,1:19:48.57,Default,,0,0,0,,Ах!
Dialogue: 0,1:19:49.20,1:19:50.07,Default,,0,0,0,,Санау!
Dialogue: 0,1:19:50.41,1:19:51.70,Default,,0,0,0,,Иә!
Dialogue: 0,1:19:51.95,1:19:53.07,Default,,0,0,0,,Тынш!
Dialogue: 0,1:19:53.41,1:19:54.66,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,1:19:54.91,1:19:55.74,Default,,0,0,0,,Өту…
Dialogue: 0,1:19:55.95,1:19:57.70,Default,,0,0,0,,Рукава өтеді...
Dialogue: 0,1:19:58.00,1:19:59.41,Default,,0,0,0,,Сол Рукава!
Dialogue: 0,1:20:00.08,1:20:01.63,Default,,0,0,0,,Бұл жігіт өтті...
Dialogue: 0,1:20:04.04,1:20:05.30,Default,,0,0,0,,(Номуның ыңқылдауы)
Dialogue: 0,1:20:07.09,1:20:08.09,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,1:20:09.47,1:20:10.30,Default,,0,0,0,,Енгізіңіз!
Dialogue: 0,1:20:11.30,1:20:12.05,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,1:20:14.01,1:20:15.35,Default,,0,0,0,,- (Рукава) өту - (Сакураги) Хмф!
Dialogue: 0,1:20:16.18,1:20:17.02,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:17.27,1:20:19.73,Default,,0,0,0,,- (Кавада) Хасаме Хасаме! - (Сакураги) Қиямет!
Dialogue: 0,1:20:21.98,1:20:22.98,Default,,0,0,0,,Ах!
Dialogue: 0,1:20:24.90,1:20:25.73,Default,,0,0,0,,Әй!
Dialogue: 0,1:20:26.02,1:20:26.90,Default,,0,0,0,,Ах!
Dialogue: 0,1:20:30.49,1:20:32.36,Default,,0,0,0,,Рукава ақыры келе жатыр
Dialogue: 0,1:20:32.66,1:20:34.87,Default,,0,0,0,,Оның үстіне бұрынғылардан сәл өзгеше.
Dialogue: 0,1:20:35.37,1:20:37.83,Default,,0,0,0,,Алға, көңіліңе жет, Рукава!
Dialogue: 0,1:20:38.83,1:20:39.66,Default,,0,0,0,,Амейо!
Dialogue: 0,1:20:43.04,1:20:44.08,Default,,0,0,0,,Ах!
Dialogue: 0,1:20:44.33,1:20:45.34,Default,,0,0,0,,Уау!
Dialogue: 0,1:20:45.96,1:20:47.75,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:20:50.01,1:20:50.72,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:20:52.22,1:20:54.18,Default,,0,0,0,,Ол түлкінің құйрығын жеуімді тоқтату үшін келді.
Dialogue: 0,1:20:54.76,1:20:57.35,Default,,0,0,0,,Мен енді шеберлігімді арттыра алмаймын.
Dialogue: 0,1:20:57.47,1:20:58.35,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,1:20:58.47,1:21:01.85,Default,,0,0,0,,Өйткені, ол өз шегіне жетті...
Dialogue: 0,1:21:05.56,1:21:07.23,Default,,0,0,0,,Үш жарым минут қалды
Dialogue: 0,1:21:08.61,1:21:09.73,Default,,0,0,0,,13 ұпай!
Dialogue: 0,1:21:13.15,1:21:13.86,Default,,0,0,0,,(Инумаки) Та… (Бірдеңенің тесіп өткен дыбысы)
Dialogue: 0,1:21:14.49,1:21:15.57,Default,,0,0,0,,Желдей жылдам шабуыл!
Dialogue: 0,1:21:16.70,1:21:17.74,Default,,0,0,0,,- (Көгуре) Жарайды, жүр! -(Аяко) Кел!
Dialogue: 0,1:21:17.87,1:21:18.99,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,1:21:24.71,1:21:25.63,Default,,0,0,0,,Ол ойнай алмайды!
Dialogue: 0,1:21:25.75,1:21:27.25,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,1:21:31.76,1:21:33.93,Default,,0,0,0,,Тыныш болыңыз
Dialogue: 0,1:21:34.05,1:21:35.22,Default,,0,0,0,,Бұл дыбыс...
Dialogue: 0,1:21:35.51,1:21:36.51,Default,,0,0,0,,
Dialogue: 0,1:21:36.72,1:21:38.43,Default,,0,0,0,,Мені тірілт
Dialogue: 0,1:21:38.56,1:21:40.06,Default,,0,0,0,,Қалағаныңызша!
Dialogue: 0,1:21:40.31,1:21:41.56,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:41.93,1:21:43.56,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:21:43.77,1:21:44.98,Default,,0,0,0,,10 ұпай айырмашылығы!
Dialogue: 0,1:21:45.23,1:21:46.15,Default,,0,0,0,,Хмф!
Dialogue: 0,1:21:46.27,1:21:48.48,Default,,0,0,0,,Не? Олар бізді 10 ұпаймен қуып жетті!
Dialogue: 0,1:21:48.61,1:21:49.44,Default,,0,0,0,,Не!
Dialogue: 0,1:21:49.57,1:21:50.53,Default,,0,0,0,,Қыңыр...
Dialogue: 0,1:21:55.49,1:21:56.32,Default,,0,0,0,,Бұл!
Dialogue: 0,1:21:57.41,1:21:58.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:59.08,1:22:00.29,Default,,0,0,0,,- (Ишии) Дәмді! -(Какуда) Жарайды!
Dialogue: 0,1:22:00.41,1:22:02.12,Default,,0,0,0,,Осыған қамқор болыңыз!
Dialogue: 0,1:22:06.21,1:22:08.67,Default,,0,0,0,,Қорғаныс! Қорғаныс!
Dialogue: 0,1:22:09.17,1:22:09.88,Default,,0,0,0,,Уф!
Dialogue: 0,1:22:10.00,1:22:10.71,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:22:14.42,1:22:15.18,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,1:22:16.68,1:22:17.68,Default,,0,0,0,,Ах!
Dialogue: 0,1:22:20.47,1:22:22.10,Default,,0,0,0,,8 ұпай айырмашылығы!
Dialogue: 0,1:22:22.77,1:22:23.68,Default,,0,0,0,,Хмм…
Dialogue: 0,1:22:25.52,1:22:28.61,Default,,0,0,0,,2 минут 50 секунд қалғанда 8 ұпай болса, мен білмеймін.
Dialogue: 0,1:22:28.73,1:22:30.32,Default,,0,0,0,,- (Рёта) Уау! -(Акаги) Жарайды!
Dialogue: 0,1:22:30.44,1:22:32.15,Default,,0,0,0,,Читтаа Широи бақытты көрінеді
Dialogue: 0,1:22:32.73,1:22:34.36,Default,,0,0,0,,Мүмкіндік пайда болды!
Dialogue: 0,1:22:35.32,1:22:36.82,Default,,0,0,0,,- (Сакураги) Гори - (Акаги) Иә?
Dialogue: 0,1:22:37.20,1:22:39.28,Default,,0,0,0,,Лукава тағы да басып озады.
Dialogue: 0,1:22:39.87,1:22:41.70,Default,,0,0,0,,Ол өтпейді
Dialogue: 0,1:22:42.49,1:22:44.45,Default,,0,0,0,,Өйткені мен ешқашан жеңілген емеспін
Dialogue: 0,1:22:44.79,1:22:45.79,Default,,0,0,0,,Ха!
Dialogue: 0,1:22:48.21,1:22:49.21,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,1:22:50.04,1:22:50.92,Default,,0,0,0,,Ура!
Dialogue: 0,1:22:53.09,1:22:53.92,Default,,0,0,0,,Әй!
Dialogue: 0,1:22:55.17,1:22:56.76,Default,,0,0,0,,Ах!
Dialogue: 0,1:22:56.97,1:22:58.47,Default,,0,0,0,,Көрдіңіздер!
Dialogue: 0,1:22:58.59,1:23:00.68,Default,,0,0,0,,Данышпанның стратегиясы өз деңгейінде!
Dialogue: 0,1:23:00.80,1:23:02.35,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,1:23:03.72,1:23:06.81,Default,,0,0,0,,Екі минуттан аз ғана уақыт қалды, айырмашылық 8 ұпай! Бұл доп!
Dialogue: 0,1:23:06.94,1:23:08.85,Default,,0,0,0,,Гори Сіз әлі де бара аласыз!
Dialogue: 0,1:23:08.98,1:23:09.98,Default,,0,0,0,,Ах!
Dialogue: 0,1:23:11.56,1:23:12.98,Default,,0,0,0,,- (Көгуре) Кеттік! -(Какуда) Мен кете аламын! Мен бара аламын!
Dialogue: 0,1:23:13.11,1:23:14.11,Default,,0,0,0,,- (Сасаока) Мына жерде! -(Иши) Жүр, кеттік!
Dialogue: 0,1:23:14.23,1:23:15.53,Default,,0,0,0,,Кеттік, кеттік!
Dialogue: 0,1:23:15.94,1:23:18.53,Default,,0,0,0,,Мына жігіт ренжімей ме?
Dialogue: 0,1:23:20.12,1:23:22.12,Default,,0,0,0,,Ах! Бұл маған тиіп жатыр!
Dialogue: 0,1:23:22.24,1:23:22.95,Default,,0,0,0,,Құт
Dialogue: 0,1:23:23.16,1:23:23.99,Default,,0,0,0,,Өтінемін!
Dialogue: 0,1:23:25.50,1:23:28.21,Default,,0,0,0,,Берілмеу Берілмеу
Dialogue: 0,1:23:28.79,1:23:29.75,Default,,0,0,0,,Жолдан кет, Мичи!
Dialogue: 0,1:23:35.88,1:23:38.55,Default,,0,0,0,,(қатты шу)
Dialogue: 0,1:23:38.68,1:23:41.05,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:41.18,1:23:42.39,Default,,0,0,0,,Ах!
Dialogue: 0,1:23:44.56,1:23:47.23,Default,,0,0,0,,Ах... (аудитория тынады)
Dialogue: 0,1:23:47.48,1:23:48.35,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:48.48,1:23:50.85,Default,,0,0,0,,Төреші уақыты!
Dialogue: 0,1:23:51.52,1:23:53.36,Default,,0,0,0,,Қарғыс атсын, қозғалма.
Dialogue: 0,1:23:56.65,1:23:57.49,Default,,0,0,0,,Эй
Dialogue: 0,1:23:57.94,1:23:58.95,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:00.07,1:24:01.03,Default,,0,0,0,,Сакураги!
Dialogue: 0,1:24:09.46,1:24:11.88,Default,,0,0,0,,Сен жақсы жұмыс істедің, бірақ сен нашар жұмыс істедің.
Dialogue: 0,1:24:12.00,1:24:13.00,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:24:15.55,1:24:17.21,Default,,0,0,0,,«Нашар» деп кім айтты?
Dialogue: 0,1:24:17.38,1:24:18.51,Default,,0,0,0,,Ал Хиёриге не болды?!
Dialogue: 0,1:24:18.63,1:24:19.92,Default,,0,0,0,,Тариме!
Dialogue: 0,1:24:20.05,1:24:20.97,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,1:24:21.30,1:24:22.05,Default,,0,0,0,,Екеуі де осы Спорт фестивалінде жоғары деңгейдегі нәтижелерге қол жеткізді!
Dialogue: 0,1:24:22.55,1:24:24.47,Default,,0,0,0,,Керемет, Шохоку!
Dialogue: 0,1:24:24.60,1:24:26.22,Default,,0,0,0,,Бұл маңызды!
Dialogue: 0,1:24:26.35,1:24:27.68,Default,,0,0,0,,- (Көрермендер) Шохоку~! -(Такамия) Бұл кім...?
Dialogue: 0,1:24:27.81,1:24:30.39,Default,,0,0,0,,Шохоку! Шохоку, қолыңнан келгеннің бәрін жаса!
Dialogue: 0,1:24:30.52,1:24:33.77,Default,,0,0,0,,Шохоку! Маған Шохоку рухын көрсет!
Dialogue: 0,1:24:33.90,1:24:41.07,Default,,0,0,0,,(Шохокуды қолдау дауыстары)
Dialogue: 0,1:24:48.20,1:24:50.46,Default,,0,0,0,,Қанша рет бас тарту керек...
Dialogue: 0,1:24:50.83,1:24:53.33,Default,,0,0,0,,Ола, көп шуыл, көбірек шу!
Dialogue: 0,1:24:53.46,1:24:54.46,Default,,0,0,0,,Әй!
Dialogue: 0,1:24:56.13,1:24:57.25,Default,,0,0,0,,Не?
Dialogue: 0,1:25:01.67,1:25:02.93,Default,,0,0,0,,- (Рёта) Шайқас! -(Акаги) Ой!
Dialogue: 0,1:25:03.05,1:25:04.05,Default,,0,0,0,,Иә!
Dialogue: 0,1:25:07.01,1:25:08.06,Default,,0,0,0,,- (Кувата) Жою! -(Иши) Дәмді!
Dialogue: 0,1:25:08.18,1:25:09.18,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:25:10.98,1:25:11.98,Default,,0,0,0,,Өзен…
Dialogue: 0,1:25:12.35,1:25:13.10,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:13.27,1:25:14.06,Default,,0,0,0,,Gunu...
Dialogue: 0,1:25:20.40,1:25:21.61,Default,,0,0,0,,Фу…
Dialogue: 0,1:25:24.95,1:25:25.99,Default,,0,0,0,,Ах!
Dialogue: 0,1:25:27.58,1:25:28.41,Default,,0,0,0,,Фу…
Dialogue: 0,1:25:29.04,1:25:30.58,Default,,0,0,0,,Жарайды, бір!
Dialogue: 0,1:25:31.79,1:25:35.88,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,1:25:36.00,1:25:40.59,Default,,0,0,0,,Қатты болса да, Жүрегім соғып тұрса да
Dialogue: 0,1:25:42.05,1:25:44.30,Default,,0,0,0,,Өзіңізді мүмкіндігінше жақсымын деп көрсетіңіз
Dialogue: 0,1:25:51.43,1:25:54.19,Default,,0,0,0,,Ақымақ, сен әлі де Кавададан қорқасың ба?
Dialogue: 0,1:25:54.64,1:25:56.48,Default,,0,0,0,,Өкінішке орай, Амон мен Акира Кокреяда…
Dialogue: 0,1:25:58.44,1:25:59.52,Default,,0,0,0,,Кезекпен жүріңіз
Dialogue: 0,1:26:00.57,1:26:02.32,Default,,0,0,0,,Маған ермесеңіз
Dialogue: 0,1:26:04.32,1:26:05.15,Default,,0,0,0,,№11!
Dialogue: 0,1:26:05.45,1:26:07.03,Default,,0,0,0,,Мен оны шығарып аламын ба? Бұл жолдама ма?
Dialogue: 0,1:26:07.16,1:26:08.91,Default,,0,0,0,,Сіз бір нәрсені ұмыттыңыз.
Dialogue: 0,1:26:12.66,1:26:14.58,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:26:17.13,1:26:18.50,Default,,0,0,0,,Сіз шешім қабылдадыңыз! 3P!
Dialogue: 0,1:26:18.63,1:26:20.46,Default,,0,0,0,,Санно күту уақыты!
Dialogue: 0,1:26:21.34,1:26:22.51,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,1:26:22.67,1:26:24.55,Default,,0,0,0,,Бес ұпай айырмашылығы! Мен бара аламын! Мен бара аламын!
Dialogue: 0,1:26:25.22,1:26:26.68,Default,,0,0,0,,- (Сакураги) Гуну! -(Аяко) Ах!
Dialogue: 0,1:26:27.34,1:26:30.31,Default,,0,0,0,,Жоқ, барған сайын ауырып барады.
Dialogue: 0,1:26:30.81,1:26:32.93,Default,,0,0,0,,Бір жері ауырады ма? Сакураги Ханамичи
Dialogue: 0,1:26:33.06,1:26:35.23,Default,,0,0,0,,Жоқ, менің арқам сәл...
Dialogue: 0,1:26:35.77,1:26:36.64,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:36.94,1:26:39.19,Default,,0,0,0,,Сіздің арқаңыз қай жерде? Қандай ауырсыну?
Dialogue: 0,1:26:39.31,1:26:42.23,Default,,0,0,0,,Кейде ауырады. Жарайды.
Dialogue: 0,1:26:42.36,1:26:43.36,Default,,0,0,0,,Ugi...
Dialogue: 0,1:26:44.74,1:26:46.07,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:47.16,1:26:49.28,Default,,0,0,0,,Спортшының өміріне әсер етеді.
Dialogue: 0,1:26:55.50,1:26:58.37,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:26:58.50,1:26:59.75,Default,,0,0,0,,Қашпа!
Dialogue: 0,1:27:00.79,1:27:04.17,Default,,0,0,0,,Ха ха ха... міне.
Dialogue: 0,1:27:06.67,1:27:09.80,Default,,0,0,0,,Ағын тоқтамайды. Сіз жүгіре аласыз ба?
Dialogue: 0,1:27:09.93,1:27:11.18,Default,,0,0,0,,Мен енді шеберлігімді арттыра алмаймын.
Dialogue: 0,1:27:11.68,1:27:14.72,Default,,0,0,0,,Жарайды, мен сізге рұқсат беремін.
Dialogue: 0,1:27:18.44,1:27:20.77,Default,,0,0,0,,Қария Сіз бәрін айналдыра аласыз! Ой!?
Dialogue: 0,1:27:21.06,1:27:22.69,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,1:27:23.69,1:27:28.07,Default,,0,0,0,,Сакураги-кун бұл командаға соққы мен жігер қосты.
Dialogue: 0,1:27:28.49,1:27:29.32,Default,,0,0,0,,Nu?
Dialogue: 0,1:27:29.99,1:27:32.95,Default,,0,0,0,,Мияги-кун жылдамдық пен сезімталдық әкеледі
Dialogue: 0,1:27:34.45,1:27:36.91,Default,,0,0,0,,Мицуи-кун бірде абдырап қалды.
Dialogue: 0,1:27:37.04,1:27:38.16,Default,,0,0,0,,Хо хо...
Dialogue: 0,1:27:38.29,1:27:41.79,Default,,0,0,0,,Кейінгі барлау және арнайы снарядтар
Dialogue: 0,1:27:43.13,1:27:47.22,Default,,0,0,0,,Рукава-кунның жарылғыш күші және жеңіске деген ерік-жігері бар.
Dialogue: 0,1:27:48.22,1:27:52.51,Default,,0,0,0,,Акаги-кун мен Когуре-кун әрқашан қолдаған негізде.
Dialogue: 0,1:27:52.64,1:27:55.10,Default,,0,0,0,,Бұл көп қосылды
Dialogue: 0,1:27:56.14,1:27:58.43,Default,,0,0,0,,Бұл Шохоку
Dialogue: 0,1:28:02.44,1:28:04.11,Default,,0,0,0,,Келіңіздер! Шохоку!
Dialogue: 0,1:28:04.36,1:28:06.57,Default,,0,0,0,,Тау патшасы!
Dialogue: 0,1:28:12.91,1:28:16.04,Default,,0,0,0,,Біз шынымен жақсы дос емеспіз.
Dialogue: 0,1:28:16.16,1:28:17.83,Default,,0,0,0,,Балалар, мені ашуландырасыңдар.
Dialogue: 0,1:28:17.95,1:28:18.96,Default,,0,0,0,,Әй?
Dialogue: 0,1:28:19.21,1:28:20.16,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:28:23.88,1:28:24.96,Default,,0,0,0,,«Бірақ» не?
Dialogue: 0,1:28:25.09,1:28:28.01,Default,,0,0,0,,Жоқ...рахмет.
Dialogue: 0,1:28:28.59,1:28:29.42,Default,,0,0,0,,- (Сакураги) А? -(Мицуи) Әй?
Dialogue: 0,1:28:29.84,1:28:32.64,Default,,0,0,0,,- (Мицуи) Ақымақ! -(Сакураги) Бұл саған емес!
Dialogue: 0,1:28:32.97,1:28:34.30,Default,,0,0,0,,Тез шық!
Dialogue: 0,1:28:36.81,1:28:38.18,Default,,0,0,0,,Ола Темера
Dialogue: 0,1:28:38.56,1:28:39.56,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:28:39.68,1:28:40.77,Default,,0,0,0,,О!
Dialogue: 0,1:28:41.64,1:28:43.35,Default,,0,0,0,,Жарайды, жүр!
Dialogue: 0,1:28:44.06,1:28:44.81,Default,,0,0,0,,О!
Dialogue: 0,1:28:46.98,1:28:48.32,Default,,0,0,0,,Мен сәйкессіздікпен келдім!
Dialogue: 0,1:28:49.44,1:28:51.07,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,1:28:51.45,1:28:53.82,Default,,0,0,0,,Қуып бара жатқан жақтан қысым болуы керек, солай ма?
Dialogue: 0,1:28:58.29,1:28:59.12,Default,,0,0,0,,Kawada тегін!
Dialogue: 0,1:29:00.04,1:29:01.00,Default,,0,0,0,,LOL!
Dialogue: 0,1:29:01.37,1:29:03.12,Default,,0,0,0,,Ах!
Dialogue: 0,1:29:03.25,1:29:05.34,Default,,0,0,0,,Дұрыс, екінші тарап...
Dialogue: 0,1:29:05.96,1:29:07.38,Default,,0,0,0,,Ең күшті тау патшасы!
Dialogue: 0,1:29:07.71,1:29:09.26,Default,,0,0,0,,Күтілгендей! Фукацу Кавата!
Dialogue: 0,1:29:13.30,1:29:14.26,Default,,0,0,0,,Қандай да бір себепті,
Dialogue: 0,1:29:16.51,1:29:17.60,Default,,0,0,0,,Аймақты басыңыз!
Dialogue: 0,1:29:17.93,1:29:18.77,Default,,0,0,0,,Риота!
Dialogue: 0,1:29:19.56,1:29:20.64,Default,,0,0,0,,Домото-кун...!
Dialogue: 0,1:29:21.31,1:29:23.35,Default,,0,0,0,,Менің таза қашуға ниетім жоқ.
Dialogue: 0,1:29:23.48,1:29:25.98,Default,,0,0,0,,Мен сізді соңғы раундқа дейін шайқасқа шақырамын.
Dialogue: 0,1:29:26.31,1:29:30.32,Default,,0,0,0,,Бұл жеңілмеген жігіттердің ең жақсы стилі.
Dialogue: 0,1:29:30.57,1:29:32.32,Default,,0,0,0,,- (Харуко) Мияги-сан! -(Такамия) Рё-чин!
Dialogue: 0,1:29:32.82,1:29:35.11,Default,,0,0,0,,Риота шықты! Бұл еркек!
Dialogue: 0,1:29:46.00,1:29:49.00,Default,,0,0,0,,(ыдыс жуу дыбысы)
Dialogue: 0,1:29:51.13,1:29:52.72,Default,,0,0,0,,Анам кішірек пе?
Dialogue: 0,1:29:52.84,1:29:53.76,Default,,0,0,0,,Иә
Dialogue: 0,1:29:54.05,1:29:55.55,Default,,0,0,0,,Дұрыс?
Dialogue: 0,1:29:57.39,1:30:00.35,Default,,0,0,0,,Себебі мен арықпын...
Dialogue: 0,1:30:00.47,1:30:01.56,Default,,0,0,0,,(жылжымалы есіктің ашылу/жабылу дыбысы)
Dialogue: 0,1:30:01.56,1:30:04.64,Default,,0,0,0,,(жылжымалы есіктің ашылу және жабылу дыбысы)
Dialogue: 0,1:30:01.56,1:30:04.64,Default,,0,0,0,,-Бірдеңе дедіңіз бе? -Ештеңе~
Dialogue: 0,1:30:08.44,1:30:11.40,Default,,0,0,0,,Қараңдаршы, мен басты кейіпкерді үлкен етіп жасадым.
Dialogue: 0,1:30:11.98,1:30:13.82,Default,,0,0,0,,Сіз үлкенірексіз.
Dialogue: 0,1:30:14.03,1:30:16.03,Default,,0,0,0,,Пластинаны бекітеміз
Dialogue: 0,1:30:20.16,1:30:23.16,Default,,0,0,0,,Ағайындылардың туған күні бірдей болуы сирек.
Dialogue: 0,1:30:26.71,1:30:28.63,Default,,0,0,0,,
Dialogue: 0,1:30:33.55,1:30:36.38,Default,,0,0,0,,Бұл біздің ерекше екенімізді білдіреді, иә?
Dialogue: 0,1:30:37.34,1:30:38.34,Default,,0,0,0,,Иә
Dialogue: 0,1:30:42.89,1:30:46.14,Default,,0,0,0,,(Шырылдау...)
Dialogue: 0,1:30:46.27,1:30:48.65,Default,,0,0,0,,(ыдыс жуу дыбысы)
Dialogue: 0,1:30:50.36,1:30:51.82,Default,,0,0,0,,Ертең сағат нешеде?
Dialogue: 0,1:30:52.11,1:30:54.65,Default,,0,0,0,,Рё-чан, ертең нешеде кетесің?
Dialogue: 0,1:30:54.78,1:30:57.03,Default,,0,0,0,,Хиросима Интер-Хай
Dialogue: 0,1:30:57.36,1:30:58.20,Default,,0,0,0,,6 сағат
Dialogue: 0,1:30:58.32,1:31:01.66,Default,,0,0,0,,Асығыңыз! Мама, сағат 6 болды.
Dialogue: 0,1:31:02.45,1:31:03.45,Default,,0,0,0,,Хмм...
Dialogue: 0,1:31:05.12,1:31:07.04,Default,,0,0,0,,Рё-чан 17?
Dialogue: 0,1:31:07.17,1:31:08.17,Default,,0,0,0,,Тор ше?
Dialogue: 0,1:31:08.88,1:31:09.88,Default,,0,0,0,,Хмм...
Dialogue: 0,1:31:13.42,1:31:14.42,Default,,0,0,0,,Ах!
Dialogue: 0,1:31:15.76,1:31:18.43,Default,,0,0,0,,Мм… 20 жаста
Dialogue: 0,1:31:19.64,1:31:20.93,Default,,0,0,0,,Тірі болсам ғой
Dialogue: 0,1:31:27.39,1:31:28.23,Default,,0,0,0,,Ах...
Dialogue: 0,1:31:28.35,1:31:32.36,Default,,0,0,0,,(жылжымалы есіктің ашылу/жабылу дыбысы)
Dialogue: 0,1:31:33.48,1:31:34.82,Default,,0,0,0,,20 жас, иә?
Dialogue: 0,1:31:36.57,1:31:38.36,Default,,0,0,0,,Әрқашан 3 жыл айырмашылығы бар
Dialogue: 0,1:31:39.20,1:31:41.07,Default,,0,0,0,,Мен сенен баяғыда өтіп кетсем де.
Dialogue: 0,1:31:44.79,1:31:47.25,Default,,0,0,0,,Со-чанның суретін көрсетейік.
Dialogue: 0,1:31:48.71,1:31:50.33,Default,,0,0,0,,Мен бетімді ұмытамын
Dialogue: 0,1:31:58.59,1:31:59.76,Default,,0,0,0,,(Тоққыл дыбыс)
Dialogue: 0,1:32:00.30,1:32:02.80,Default,,0,0,0,,О, түсіндім. Демек, Иура – ағасы екен.
Dialogue: 0,1:32:14.94,1:32:16.23,Default,,0,0,0,,(ілгіштен алынған дыбыс)
Dialogue: 0,1:32:21.36,1:32:23.66,Default,,0,0,0,,8 жыл болды емес пе?
Dialogue: 0,1:32:24.37,1:32:25.37,Default,,0,0,0,,Иә
Dialogue: 0,1:32:28.12,1:32:31.50,Default,,0,0,0,,17 жасқа толуыңызбен құттықтаймыз
Dialogue: 0,1:32:33.00,1:32:34.17,Default,,0,0,0,,Ариат
Dialogue: 0,1:32:37.38,1:32:38.38,Default,,0,0,0,,(күрсіну)
Dialogue: 0,1:32:40.97,1:32:41.97,Default,,0,0,0,,Ха!
Dialogue: 0,1:32:43.39,1:32:45.43,Default,,0,0,0,,Ах...
Dialogue: 0,1:32:48.31,1:32:50.31,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,1:32:50.43,1:32:54.44,Default,,0,0,0,,(бейне аудио)
Dialogue: 0,1:33:13.17,1:33:16.21,Default,,0,0,0,,♪~
Dialogue: 0,1:33:46.12,1:33:48.16,Default,,0,0,0,,«Ана»?
Dialogue: 0,1:33:48.28,1:33:49.49,Default,,0,0,0,,Не?
Dialogue: 0,1:33:51.79,1:33:53.25,Default,,0,0,0,,«Ана»
Dialogue: 0,1:33:53.91,1:33:58.59,Default,,0,0,0,,«Әрдайым қиындық тудырып, сізді мазалағаным үшін кешіріңіз».
Dialogue: 0,1:33:59.42,1:34:01.80,Default,,0,0,0,,«Сіз баскетболды жек көретін шығарсыз, солай ма?»
Dialogue: 0,1:34:04.13,1:34:06.14,Default,,0,0,0,,«Себебі бұл маған Торчанды еске түсіреді»
Dialogue: 0,1:34:07.72,1:34:13.64,Default,,0,0,0,,«Сөйтсе де маған баскетбол ойнауды тоқтатуды ешқашан айтқан жоқ».
Dialogue: 0,1:34:15.90,1:34:20.86,Default,,0,0,0,,«Біз микроавтобуста отырғанымызда ойынды көруге келгеніңе қуаныштымын».
Dialogue: 0,1:34:22.57,1:34:23.53,Default,,0,0,0,,Санау!
Dialogue: 0,1:34:23.94,1:34:25.57,Default,,0,0,0,,Иә, Тор!
Dialogue: 0,1:34:25.70,1:34:27.82,Default,,0,0,0,,20 пункт, керемет!
Dialogue: 0,1:34:28.16,1:34:30.12,Default,,0,0,0,,Үлкен аға, бұл керемет.
Dialogue: 0,1:34:31.08,1:34:33.12,Default,,0,0,0,,Сіз капитансыз, солай ма?
Dialogue: 0,1:34:33.87,1:34:35.04,Default,,0,0,0,,Хехехе
Dialogue: 0,1:34:35.62,1:34:37.63,Default,,0,0,0,,Ағаңдай боласың ба?
Dialogue: 0,1:34:38.58,1:34:39.63,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,1:34:41.05,1:34:42.84,Default,,0,0,0,,Егер сіз көп жаттығу жасасаңыз.
Dialogue: 0,1:34:45.42,1:34:47.72,Default,,0,0,0,,«Торсыз әлемде»
Dialogue: 0,1:34:48.72,1:34:52.43,Default,,0,0,0,,«Мені тірі қалдырған жалғыз нәрсе – баскетбол».
Dialogue: 0,1:34:57.10,1:35:00.31,Default,,0,0,0,,«Жалғастыруға рұқсат бергеніңіз үшін рахмет».
Dialogue: 0,1:35:02.40,1:35:03.23,Default,,0,0,0,,Уф...
Dialogue: 0,1:35:11.20,1:35:14.29,Default,,0,0,0,,Тоқта! Оны неге лақтыру керек?
Dialogue: 0,1:35:28.30,1:35:30.18,Default,,0,0,0,,Анашым, бұл қиын!
Dialogue: 0,1:35:30.39,1:35:31.51,Default,,0,0,0,,Ха!
Dialogue: 0,1:35:36.64,1:35:39.69,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,1:35:39.81,1:35:43.44,Default,,0,0,0,,Білмеймін, не істеуім керек...
Dialogue: 0,1:36:40.54,1:36:42.96,Default,,0,0,0,,«Мен баскетбол ойнауды жалғастырғаныма қуаныштымын».
Dialogue: 0,1:36:46.38,1:36:48.88,Default,,0,0,0,,«Тор тұруы керек жерде».
Dialogue: 0,1:36:50.17,1:36:54.76,Default,,0,0,0,,«Ертең мен тұрамын».
Dialogue: 0,1:36:57.81,1:36:59.52,Default,,0,0,0,,(Бейне: Дриблинг дыбыстары)
Dialogue: 0,1:37:01.77,1:37:03.10,Default,,0,0,0,,А, суретке түспе!
Dialogue: 0,1:37:03.23,1:37:04.86,Default,,0,0,0,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,1:37:05.90,1:37:08.32,Default,,0,0,0,,Менің белім биік! Шаршадыңыз ба?
Dialogue: 0,1:37:08.44,1:37:10.24,Default,,0,0,0,,- (Сота) Міне! Мінеки! -(Рёта) Шулы!
Dialogue: 0,1:37:10.36,1:37:12.91,Default,,0,0,0,,Ахахха Сәттілік!
Dialogue: 0,1:37:10.36,1:37:12.91,Default,,0,0,0,,~♪
Dialogue: 0,1:37:12.91,1:37:16.37,Default,,0,0,0,,~♪
Dialogue: 0,1:37:16.58,1:37:18.45,Default,,0,0,0,,♪~
Dialogue: 0,1:37:18.58,1:37:19.45,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:37:19.58,1:37:20.66,Default,,0,0,0,,Пён енді ашуланбайды.
Dialogue: 0,1:37:21.41,1:37:24.83,Default,,0,0,0,,Егер мені осы үлкендер бұғаттаса, мен не істеуім керек?
Dialogue: 0,1:37:26.63,1:37:27.63,Default,,0,0,0,,Бару...
Dialogue: 0,1:37:29.17,1:37:30.17,Default,,0,0,0,,(Сирена қосылады)
Dialogue: 0,1:37:30.67,1:37:31.51,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,1:37:31.80,1:37:33.93,Default,,0,0,0,,Жүр! Риота!
Dialogue: 0,1:37:35.22,1:37:40.06,Default,,0,0,0,,Дриблинг - кішкентай адамдардың өмір салты!
Dialogue: 0,1:37:52.78,1:37:54.03,Default,,0,0,0,,Уууу!
Dialogue: 0,1:37:54.32,1:37:55.78,Default,,0,0,0,,- (Көгуре) Әй! - (Аяко) Эй, Риота!
Dialogue: 0,1:37:57.95,1:37:59.79,Default,,0,0,0,,Қорғаныс! Қорғаныс!
Dialogue: 0,1:38:05.79,1:38:07.42,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,1:38:07.71,1:38:08.54,Default,,0,0,0,,Міне, солай!
Dialogue: 0,1:38:10.88,1:38:11.88,Default,,0,0,0,,Кіріңіз!
Dialogue: 0,1:38:13.88,1:38:14.76,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,1:38:17.43,1:38:18.76,Default,,0,0,0,,
Dialogue: 0,1:38:19.10,1:38:21.18,Default,,0,0,0,,Себет жоқ! Фолдан кейін!
Dialogue: 0,1:38:22.31,1:38:23.68,Default,,0,0,0,,Иә?
Dialogue: 0,1:38:27.19,1:38:29.32,Default,,0,0,0,,Жарайды, өтінемін, Акаги!
Dialogue: 0,1:38:31.32,1:38:32.07,Default,,0,0,0,,Фу…
Dialogue: 0,1:38:32.69,1:38:33.53,Default,,0,0,0,,Әй?
Dialogue: 0,1:38:33.65,1:38:34.36,Default,,0,0,0,,~♪
Dialogue: 0,1:38:34.36,1:38:35.45,Default,,0,0,0,,~♪
Dialogue: 0,1:38:34.36,1:38:35.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:38:38.16,1:38:39.74,Default,,0,0,0,,Еркін лақтыру №4.
Dialogue: 0,1:38:39.87,1:38:41.95,Default,,0,0,0,,Бұл менің еркін лақтыруым, Сакураги.
Dialogue: 0,1:38:42.16,1:38:42.87,Default,,0,0,0,,Иә?
Dialogue: 0,1:38:43.00,1:38:45.33,Default,,0,0,0,,(Сакурагидің ізі)
Dialogue: 0,1:38:45.46,1:38:46.50,Default,,0,0,0,,Ха!
Dialogue: 0,1:38:47.00,1:38:48.04,Default,,0,0,0,,О...
Dialogue: 0,1:38:51.21,1:38:53.30,Default,,0,0,0,,(Сакурагидің ауыр тыныс алуы)
Dialogue: 0,1:38:53.63,1:38:54.84,Default,,0,0,0,,Ах...
Dialogue: 0,1:38:59.76,1:39:03.18,Default,,0,0,0,,Есеп жоқ па? Ақымақ болма...
Dialogue: 0,1:39:03.31,1:39:06.48,Default,,0,0,0,,Бұл данышпанның слем-данк...
Dialogue: 0,1:39:07.81,1:39:08.81,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,1:39:08.90,1:39:11.65,Default,,0,0,0,,Мен сені бір күні жеңуді жоспарлап едім, Лукава!
Dialogue: 0,1:39:12.98,1:39:16.70,Default,,0,0,0,,О, сәл күте тұрыңыз! Мен кезекпен жүрмеймін
Dialogue: 0,1:39:19.41,1:39:20.49,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:39:22.12,1:39:25.12,Default,,0,0,0,,Бос допты ертерек соққанда, мен оны ауырттым.
Dialogue: 0,1:39:25.25,1:39:26.71,Default,,0,0,0,,Қайда... қайда?
Dialogue: 0,1:39:27.16,1:39:29.75,Default,,0,0,0,,Аяко-сан, айтпа.
Dialogue: 0,1:39:30.13,1:39:31.29,Default,,0,0,0,,Артқа…
Dialogue: 0,1:39:32.09,1:39:33.30,Default,,0,0,0,,Артқа?
Dialogue: 0,1:39:34.71,1:39:37.09,Default,,0,0,0,,Senshu Life дегеніміз не?
Dialogue: 0,1:39:37.42,1:39:41.55,Default,,0,0,0,,Мүмкін бұл соңы шығар...?
Dialogue: 0,1:39:42.76,1:39:47.23,Default,,0,0,0,,Бұл менің енді баскетбол ойнай алмайтынымды білдіре ме...?
Dialogue: 0,1:39:49.90,1:39:50.94,Default,,0,0,0,,Эй!
Dialogue: 0,1:39:53.77,1:39:55.36,Default,,0,0,0,,Доя! (соққы дыбысы)
Dialogue: 0,1:39:58.40,1:40:00.41,Default,,0,0,0,,Сізге баскетбол ұнайды ма?
Dialogue: 0,1:40:01.03,1:40:02.03,Default,,0,0,0,,Ха...
Dialogue: 0,1:40:02.62,1:40:05.45,Default,,0,0,0,,Мен... Мен оны жақсы көремін, өйткені ол спортшы!
Dialogue: 0,1:40:08.71,1:40:09.71,Default,,0,0,0,,Аға мен әпке!?
Dialogue: 0,1:40:10.04,1:40:10.87,Default,,0,0,0,,Хмф!
Dialogue: 0,1:40:14.09,1:40:15.09,Default,,0,0,0,,Оны қалдырыңыз!
Dialogue: 0,1:40:15.63,1:40:16.80,Default,,0,0,0,,Экранды өшіру!
Dialogue: 0,1:40:18.59,1:40:19.59,Default,,0,0,0,,Әй!
Dialogue: 0,1:40:20.55,1:40:21.55,Default,,0,0,0,,Жарайды, дұрыс!
Dialogue: 0,1:40:28.81,1:40:30.19,Default,,0,0,0,,Соңғысы!
Dialogue: 0,1:40:30.94,1:40:32.86,Default,,0,0,0,,Тек сол қолыңызды қосыңыз
Dialogue: 0,1:40:34.31,1:40:36.19,Default,,0,0,0,,Ребаунд патшаның ұлттық дебюті!
Dialogue: 0,1:40:47.66,1:40:49.87,Default,,0,0,0,,- (Акаги) Жарайды! -(Когуре) Жақсы
Dialogue: 0,1:41:00.38,1:41:01.34,Default,,0,0,0,,Ханамичи
Dialogue: 0,1:41:02.30,1:41:04.39,Default,,0,0,0,,Мен сені күттім, проблема бала.
Dialogue: 0,1:41:05.43,1:41:09.68,Default,,0,0,0,,Чикушо... Чикусо!
Dialogue: 0,1:41:13.23,1:41:14.06,Default,,0,0,0,,Фу…
Dialogue: 0,1:41:14.19,1:41:15.73,Default,,0,0,0,,- (Мицуи дауысы) Шешіңіз! – (Рёта дауысы) Шешіңіз.
Dialogue: 0,1:41:15.90,1:41:16.77,Default,,0,0,0,,Akagi!
Dialogue: 0,1:41:26.33,1:41:27.70,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:41:29.41,1:41:30.12,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:30.29,1:41:31.46,Default,,0,0,0,,Йорошикуды ауыстыру!
Dialogue: 0,1:41:31.58,1:41:32.66,Default,,0,0,0,,Әй?
Dialogue: 0,1:41:33.21,1:41:34.33,Default,,0,0,0,,- (барлығы) Иә! -(Мито) Ханамичи!
Dialogue: 0,1:41:34.46,1:41:35.54,Default,,0,0,0,,- (Такамия) Әй! -(Харуко) Сакураги-кун!
Dialogue: 0,1:41:35.67,1:41:37.29,Default,,0,0,0,,- (Аяко) Не ​​істеп жатырсың? -(Ясуда) Сакураги!
Dialogue: 0,1:41:37.54,1:41:38.75,Default,,0,0,0,,Сакураги-кун
Dialogue: 0,1:41:39.46,1:41:41.55,Default,,0,0,0,,Рё-чин, тезірек барайық!
Dialogue: 0,1:41:42.38,1:41:44.59,Default,,0,0,0,,Гори Оған дейін, мақсаттан төмен, өтінемін!
Dialogue: 0,1:41:45.05,1:41:47.64,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:41:48.26,1:41:49.60,Default,,0,0,0,,Сакураги Ханамичи!
Dialogue: 0,1:41:49.72,1:41:51.43,Default,,0,0,0,,Көп сөйлеме! Келіңіздер!
Dialogue: 0,1:41:51.60,1:41:52.43,Default,,0,0,0,,Ugi...
Dialogue: 0,1:41:52.56,1:41:54.85,Default,,0,0,0,,Қарашы, мен әрең тұрамын!
Dialogue: 0,1:41:55.23,1:41:58.02,Default,,0,0,0,,Кешіріңіз, ауыстыру тоқтатылды.
Dialogue: 0,1:41:58.15,1:41:59.07,Default,,0,0,0,,Колла, қария!
Dialogue: 0,1:42:02.44,1:42:03.82,Default,,0,0,0,,Сакураги-кун
Dialogue: 0,1:42:06.53,1:42:07.70,Default,,0,0,0,,Мен мойындаймын
Dialogue: 0,1:42:09.87,1:42:13.08,Default,,0,0,0,,Мен сізден біртүрлі нәрсені бірден байқадым.
Dialogue: 0,1:42:13.58,1:42:16.50,Default,,0,0,0,,Мен оны білдім, бірақ өзгертпедім.
Dialogue: 0,1:42:17.63,1:42:21.55,Default,,0,0,0,,Себебі мен сіздің ойыныңыздың жақсарғанын көргім келді.
Dialogue: 0,1:42:23.88,1:42:25.88,Default,,0,0,0,,Көшбасшы болу құқығынан айырылды
Dialogue: 0,1:42:27.18,1:42:30.35,Default,,0,0,0,,Өмір бойы өкінетін болдым.
Dialogue: 0,1:42:30.47,1:42:33.48,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:42:34.48,1:42:35.81,Default,,0,0,0,,1 минут қалды!
Dialogue: 0,1:42:35.94,1:42:37.73,Default,,0,0,0,,Бірге дыбыс шығарайық, Сакураги!
Dialogue: 0,1:42:38.73,1:42:39.73,Default,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,1:42:41.82,1:42:44.44,Default,,0,0,0,,Қарияның даңқы қашан болды?
Dialogue: 0,1:42:44.74,1:42:46.57,Default,,0,0,0,,Бүкіл Жапонияның уақыты келді ме?
Dialogue: 0,1:42:49.49,1:42:50.78,Default,,0,0,0,,Мен...
Dialogue: 0,1:42:53.54,1:43:06.51,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:43:09.39,1:43:11.72,Default,,0,0,0,,Мен қазір не істеп жатырмын?
Dialogue: 0,1:43:18.06,1:43:19.19,Default,,0,0,0,,Ух... мінеки!
Dialogue: 0,1:43:20.11,1:43:21.65,Default,,0,0,0,,Қызыл итеру!
Dialogue: 0,1:43:28.16,1:43:31.20,Default,,0,0,0,,Әй, бұл көздің жауын алады.
Dialogue: 0,1:43:31.33,1:43:33.87,Default,,0,0,0,,Сен сол жерде тұрсаң, аңырап.
Dialogue: 0,1:43:33.99,1:43:35.70,Default,,0,0,0,,Хаха...
Dialogue: 0,1:43:36.37,1:43:38.71,Default,,0,0,0,,Шыққыңыз келсе, шығыңыз.
Dialogue: 0,1:43:38.96,1:43:40.00,Default,,0,0,0,,Әй!
Dialogue: 0,1:43:40.33,1:43:41.50,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,1:43:41.63,1:43:42.75,Default,,0,0,0,,Өзгеріс уақыты келді!
Dialogue: 0,1:43:43.71,1:43:45.05,Default,,0,0,0,,Ах!?
Dialogue: 0,1:43:45.30,1:43:46.30,Default,,0,0,0,,Иә?
Dialogue: 0,1:43:46.76,1:43:47.97,Default,,0,0,0,,Ол шығады ма...?
Dialogue: 0,1:43:48.63,1:43:50.05,Default,,0,0,0,,Қызыл бала пайда болды!
Dialogue: 0,1:43:50.18,1:43:51.18,Default,,0,0,0,,Жабайы жүр!
Dialogue: 0,1:43:51.30,1:43:52.39,Default,,0,0,0,,Мен көптен күттім!
Dialogue: 0,1:43:53.14,1:43:55.60,Default,,0,0,0,,- (Рёта) Ханамичи... - (Акаги) Жарайсың ба!?
Dialogue: 0,1:43:55.72,1:43:56.56,Default,,0,0,0,,Сакураги!
Dialogue: 0,1:43:57.18,1:44:00.06,Default,,0,0,0,,Nu? Қандай салмақты жүз
Dialogue: 0,1:44:00.69,1:44:03.32,Default,,0,0,0,,Мен қатты қайғырдым, балалар! менсіз
Dialogue: 0,1:44:04.02,1:44:06.28,Default,,0,0,0,,Бұл данышпан үшін жақсы кемшілік.
Dialogue: 0,1:44:06.40,1:44:08.07,Default,,0,0,0,,Егер бұл Ямао сияқты қарсылас болса.
Dialogue: 0,1:44:08.82,1:44:10.45,Default,,0,0,0,,Хахаха... Уф!
Dialogue: 0,1:44:10.95,1:44:13.08,Default,,0,0,0,,Ах... уф...
Dialogue: 0,1:44:13.20,1:44:15.08,Default,,0,0,0,,Сен жеңесің, Гори!
Dialogue: 0,1:44:15.20,1:44:17.37,Default,,0,0,0,,Бұл өтпелі нүкте, солай емес пе? Сол жігіттер!
Dialogue: 0,1:44:17.50,1:44:18.62,Default,,0,0,0,,бірақ ол да маған күдікпен қарады…
Dialogue: 0,1:44:19.00,1:44:22.83,Default,,0,0,0,,Хмф! Неліктен сіз, төменгі жағындағы, маған мұны айтуыңыз керек?
Dialogue: 0,1:44:22.96,1:44:23.92,Default,,0,0,0,,Не!
Dialogue: 0,1:44:27.09,1:44:28.47,Default,,0,0,0,,- (Рёта) Сәлем! -(Акаги) А?
Dialogue: 0,1:44:28.59,1:44:29.47,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,1:44:31.39,1:44:32.26,Default,,0,0,0,,Иә?
Dialogue: 0,1:44:33.01,1:44:34.05,Default,,0,0,0,,Иә?
Dialogue: 0,1:44:35.89,1:44:38.02,Default,,0,0,0,,Олар тағы да баспасөзге келеді.
Dialogue: 0,1:44:38.64,1:44:39.98,Default,,0,0,0,,Артымнан келе жатыр
Dialogue: 0,1:44:40.77,1:44:45.61,Default,,0,0,0,,Рукава Жыныстық қатынасқа келсек, оны көтеріп алып, баруға болады.
Dialogue: 0,1:44:45.73,1:44:46.57,Default,,0,0,0,,Ер
Dialogue: 0,1:44:46.69,1:44:49.36,Default,,0,0,0,,Данна, Рукаваға қара
Dialogue: 0,1:44:49.70,1:44:50.65,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,1:44:54.37,1:44:55.37,Default,,0,0,0,,Фу…
Dialogue: 0,1:44:56.28,1:44:57.58,Default,,0,0,0,,Осымен
Dialogue: 0,1:44:59.41,1:45:01.21,Default,,0,0,0,,Біз мұны істей аламыз
Dialogue: 0,1:45:05.59,1:45:06.71,Default,,0,0,0,,Оу, уау!
Dialogue: 0,1:45:08.17,1:45:09.17,Default,,0,0,0,,Иә?
Dialogue: 0,1:45:09.46,1:45:10.47,Default,,0,0,0,,Хмм
Dialogue: 0,1:45:11.01,1:45:12.05,Default,,0,0,0,,Иә?
Dialogue: 0,1:45:13.30,1:45:14.26,Default,,0,0,0,,(Риотаның тыныс алу дыбысы)
Dialogue: 0,1:45:14.68,1:45:15.51,Default,,0,0,0,,１･２･３
Dialogue: 0,1:45:15.64,1:45:16.85,Default,,0,0,0,,Жеңіске жет!
Dialogue: 0,1:45:17.26,1:45:18.85,Default,,0,0,0,,- (Сакураги) Тынш! -(Рёта) Жүр, Санно!
Dialogue: 0,1:45:19.06,1:45:20.06,Default,,0,0,0,,О!
Dialogue: 0,1:45:22.60,1:45:23.44,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,1:45:23.90,1:45:26.27,Default,,0,0,0,,Мен байсалдымын! Мен оларды шындап қуып жетуге тырысамын.
Dialogue: 0,1:45:26.40,1:45:28.78,Default,,0,0,0,,Мен 1 минутта 5 ұпай жинауға шындап тырысамын!
Dialogue: 0,1:45:28.90,1:45:29.69,Default,,0,0,0,,Жақсы, Шохоку!
Dialogue: 0,1:45:29.82,1:45:31.03,Default,,0,0,0,,Біз осында келдік.
Dialogue: 0,1:45:31.11,1:45:31.95,Default,,0,0,0,,Қуып кетіңіз!
Dialogue: 0,1:45:32.07,1:45:33.57,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,1:45:33.66,1:45:35.49,Default,,0,0,0,,Осындай командадан жеңілеміз бе?
Dialogue: 0,1:45:35.78,1:45:36.78,Default,,0,0,0,,Қорғаныс!
Dialogue: 0,1:45:36.87,1:45:38.29,Default,,0,0,0,,Қорғаныс! Қорғаныс!
Dialogue: 0,1:45:38.41,1:45:40.37,Default,,0,0,0,,Қорғаңыз!
Dialogue: 0,1:45:40.50,1:45:42.04,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:45:43.00,1:45:43.96,Default,,0,0,0,,Сыртта!?
Dialogue: 0,1:45:45.96,1:45:46.92,Default,,0,0,0,,Ugi...
Dialogue: 0,1:45:47.04,1:45:48.34,Default,,0,0,0,,Бұл ашылды! Мен мақсатты болдым!
Dialogue: 0,1:45:48.46,1:45:49.30,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:45:50.67,1:45:51.59,Default,,0,0,0,,Жүр, Микио!
Dialogue: 0,1:45:52.80,1:45:53.76,Default,,0,0,0,,Ура!
Dialogue: 0,1:45:56.51,1:45:57.97,Default,,0,0,0,,- (Кавада) Не... - (Домото) Нии!?
Dialogue: 0,1:45:58.10,1:45:59.26,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,1:46:03.23,1:46:04.77,Default,,0,0,0,,Кеттік, Рукава!
Dialogue: 0,1:46:07.81,1:46:08.90,Default,,0,0,0,,Жарайды, мен оны тоқтаттым!
Dialogue: 0,1:46:15.95,1:46:16.70,Default,,0,0,0,,Ах!
Dialogue: 0,1:46:17.28,1:46:18.41,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,1:46:18.83,1:46:19.83,Default,,0,0,0,,Жалған!
Dialogue: 0,1:46:20.24,1:46:22.20,Default,,0,0,0,,Ga!
Dialogue: 0,1:46:24.12,1:46:25.12,Default,,0,0,0,,Ха!
Dialogue: 0,1:46:26.83,1:46:28.25,Default,,0,0,0,,3 ұпайды сана!
Dialogue: 0,1:46:28.54,1:46:31.34,Default,,0,0,0,,Фол Ақ №6 Итеру
Dialogue: 0,1:46:31.88,1:46:32.88,Default,,0,0,0,,Бір лақтыру!
Dialogue: 0,1:46:35.05,1:46:38.51,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:46:38.64,1:46:43.27,Default,,0,0,0,,Шохоку Шохоку Шохоку! Шохоку Шохоку Шохоку!
Dialogue: 0,1:46:43.39,1:46:46.52,Default,,0,0,0,,Шохоку Шохоку Шохоку Шохоку!
Dialogue: 0,1:46:47.02,1:46:49.02,Default,,0,0,0,,Жақсы жұмыс, Мицуи!
Dialogue: 0,1:46:50.52,1:46:51.86,Default,,0,0,0,,(Акаги мен Мицуи бестік дыбысы)
Dialogue: 0,1:46:51.98,1:46:53.53,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:46:54.74,1:46:57.95,Default,,0,0,0,,Шохокуға кіргеніме қуаныштымын...
Dialogue: 0,1:47:06.08,1:47:08.46,Default,,0,0,0,,Осы уақытқа дейін жеткен болсаң, бұл сезім шайқасы.
Dialogue: 0,1:47:10.38,1:47:13.05,Default,,0,0,0,,Өзіңізге қаншалықты сенімді бола аласыз?
Dialogue: 0,1:47:14.97,1:47:17.51,Default,,0,0,0,,Сіз қаншалықты өзіңізге сеніп, ойнай аласыз?
Dialogue: 0,1:47:19.14,1:47:20.14,Default,,0,0,0,,О!
Dialogue: 0,1:47:25.98,1:47:29.94,Default,,0,0,0,,(аудиторияны қоздыру)
Dialogue: 0,1:47:40.03,1:47:41.95,Default,,0,0,0,,Хахахахаха!
Dialogue: 0,1:47:43.49,1:47:45.75,Default,,0,0,0,,1 ұпай айырмашылығы!
Dialogue: 0,1:47:47.91,1:47:48.96,Default,,0,0,0,,47!
Dialogue: 0,1:47:49.08,1:47:51.71,Default,,0,0,0,,46! 45! 44!
Dialogue: 0,1:47:51.84,1:47:54.96,Default,,0,0,0,,Өлімге дейін қорғаңыз! Ұстап қалмаңыз!
Dialogue: 0,1:47:56.47,1:47:57.51,Default,,0,0,0,,Сәттілік
Dialogue: 0,1:47:58.05,1:47:59.80,Default,,0,0,0,,Сакураги, бар күшіңді сал
Dialogue: 0,1:48:00.43,1:48:01.43,Default,,0,0,0,,Мияги
Dialogue: 0,1:48:02.39,1:48:03.35,Default,,0,0,0,,Рукава
Dialogue: 0,1:48:04.06,1:48:05.39,Default,,0,0,0,,Мицуиге сәттілік
Dialogue: 0,1:48:07.39,1:48:09.69,Default,,0,0,0,,Сәттілік Акаги!
Dialogue: 0,1:48:16.53,1:48:17.53,Default,,0,0,0,,Рух толқыны! Қ-... Қ-... Жоқ, бұл шынайы нәрсе.
Dialogue: 0,1:48:18.28,1:48:19.07,Default,,0,0,0,,Ах!
Dialogue: 0,1:48:23.66,1:48:25.24,Default,,0,0,0,,- (Сакураги) Уги! -(Рёта) Ах!
Dialogue: 0,1:48:26.20,1:48:27.66,Default,,0,0,0,,Ах!
Dialogue: 0,1:48:29.92,1:48:31.04,Default,,0,0,0,,Жүр!
Dialogue: 0,1:48:32.21,1:48:33.04,Default,,0,0,0,,Қайта бер.
Dialogue: 0,1:48:35.55,1:48:37.38,Default,,0,0,0,,(Қақпа сақинасына соғылған дыбыс)
Dialogue: 0,1:48:37.88,1:48:39.38,Default,,0,0,0,,Ах!
Dialogue: 0,1:48:43.39,1:48:45.22,Default,,0,0,0,,Тоқта! Ертерек тоқтатыңыз!
Dialogue: 0,1:48:46.72,1:48:47.72,Default,,0,0,0,,Ах!
Dialogue: 0,1:48:50.56,1:48:51.44,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:48:52.52,1:48:53.40,Default,,0,0,0,,Бітті!
Dialogue: 0,1:49:08.08,1:49:13.71,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,1:49:26.30,1:49:38.15,Default,,0,0,0,,(тек жүрек соғысы естіледі)
Dialogue: 0,1:50:53.35,1:50:59.98,Default,,0,0,0,,(Екінші қолдың дыбысы)
Dialogue: 0,1:51:55.83,1:51:57.66,Default,,0,0,0,,(екінші қол дыбысты тоқтатады)
Dialogue: 0,1:51:58.08,1:52:02.09,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,1:52:59.14,1:53:01.14,Default,,0,0,0,,(Тыныштықты бұзатын түрту дыбысы)
Dialogue: 0,1:53:07.57,1:53:08.57,Default,,0,0,0,,Хмф!
Dialogue: 0,1:53:09.19,1:53:10.65,Default,,0,0,0,,Тынш!
Dialogue: 0,1:53:10.82,1:53:13.70,Default,,0,0,0,,(қуаныш дауысы)
Dialogue: 0,1:53:13.82,1:53:15.45,Default,,0,0,0,,Тыныш! Жақсы!
Dialogue: 0,1:53:50.61,1:53:53.53,Default,,0,0,0,,Ай!
Dialogue: 0,1:53:53.66,1:53:55.91,Default,,0,0,0,,(Инелік аспаз)
Dialogue: 0,1:53:58.74,1:54:01.91,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,1:54:05.92,1:54:06.92,Default,,0,0,0,,Иә?
Dialogue: 0,1:54:19.68,1:54:20.72,Default,,0,0,0,,Фу…
Dialogue: 0,1:54:39.83,1:54:42.79,Default,,0,0,0,,Санно қалай болды?
Dialogue: 0,1:54:50.04,1:54:51.38,Default,,0,0,0,,Бұл күшті болды
Dialogue: 0,1:55:01.72,1:55:02.93,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:55:03.31,1:55:04.31,Default,,0,0,0,,Ха!
Dialogue: 0,1:55:14.86,1:55:16.07,Default,,0,0,0,,Рё-чан
Dialogue: 0,1:55:19.57,1:55:20.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:55:22.54,1:55:23.54,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:55:26.92,1:55:28.00,Default,,0,0,0,,Тұрғындар балық аулау мен егіншілікпен күнкөреді—
Dialogue: 0,1:55:30.00,1:55:31.17,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:55:36.34,1:55:37.47,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:55:38.13,1:55:39.80,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,1:55:42.47,1:55:43.64,Default,,0,0,0,,Бойыңыз өсті ме?
Dialogue: 0,1:55:43.77,1:55:47.60,Default,,0,0,0,,ше? Оның 4 күнде өсуі мүмкін емес.
Dialogue: 0,1:55:49.81,1:55:51.23,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,1:55:56.65,1:55:57.65,Default,,0,0,0,,Хмм
Dialogue: 0,1:56:06.79,1:56:08.04,Default,,0,0,0,,Со-чанның
Dialogue: 0,1:56:08.29,1:56:09.67,Default,,0,0,0,,Ах...
Dialogue: 0,1:56:24.31,1:56:25.47,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:56:25.60,1:56:27.81,Default,,0,0,0,,Рё-чан!
Dialogue: 0,1:56:29.44,1:56:30.73,Default,,0,0,0,,Рё-чан, қош келдіңіз!
Dialogue: 0,1:56:31.06,1:56:32.69,Default,,0,0,0,,Эй, сен не істеп жатырсың...
Dialogue: 0,1:56:32.81,1:56:34.86,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,1:56:34.98,1:56:37.49,Default,,0,0,0,,Эй, сен мұны істеп қойдың!
Dialogue: 0,1:56:37.61,1:56:39.95,Default,,0,0,0,,- Қараңыз! -(Рёта) Уау...
Dialogue: 0,1:56:40.07,1:56:43.07,Default,,0,0,0,,Сәлем! Күте тұрыңыз, сіз! Мінеки!
Dialogue: 0,1:56:43.20,1:56:44.33,Default,,0,0,0,,-Хахахахаха - (Рёта) Эй!
Dialogue: 0,1:56:44.45,1:56:48.37,Default,,0,0,0,,(Санно мүшелерінің ізі)
Dialogue: 0,1:56:50.67,1:56:54.67,Default,,0,0,0,,(Каваданың інісінің жылауы)
Dialogue: 0,1:56:55.04,1:56:56.05,Default,,0,0,0,,Жоғарыға көтерілейік
Dialogue: 0,1:56:57.80,1:57:03.18,Default,,0,0,0,,«Бұрын жеңілген» бір күні үлкен байлыққа айналады
Dialogue: 0,1:57:16.52,1:57:19.07,Default,,0,0,0,,Маған қажетті тәжірибені беріңіз
Dialogue: 0,1:57:24.87,1:57:26.37,Default,,0,0,0,,Я...
Dialogue: 0,1:57:28.75,1:57:36.79,Default,,0,0,0,,Ууууууууууууууууу...
Dialogue: 0,1:57:40.34,1:57:43.34,Default,,0,0,0,,(Дриблинг дыбысы)
Dialogue: 0,1:57:44.64,1:57:47.06,Default,,0,0,0,,Сіз келгеннен кейін бірдеңе өзгерді ме?
Dialogue: 0,1:57:47.35,1:57:48.72,Default,,0,0,0,,Бұл физикалық.
Dialogue: 0,1:57:48.85,1:57:51.27,Default,,0,0,0,,Айналамдағылардың бәрі Кавата-сан сияқты.
Dialogue: 0,1:57:51.39,1:57:52.35,Default,,0,0,0,,Хаха
Dialogue: 0,1:57:53.14,1:57:54.56,Default,,0,0,0,,Алда қандай міндеттер тұр?
Dialogue: 0,1:57:54.98,1:57:57.65,Default,,0,0,0,,Мен кішірек болғандықтан, мен де доцент ойнаймын.
Dialogue: 0,1:57:57.77,1:57:58.90,Default,,0,0,0,,Әлі көп жол бар.
Dialogue: 0,1:57:59.90,1:58:01.74,Default,,0,0,0,,Мен өз бетімше тым алыс кеттім
Dialogue: 0,1:58:02.82,1:58:03.70,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,1:58:03.82,1:58:06.12,Default,,0,0,0,,Осы уақытқа дейін саяхаттағаныңызға рахмет.
Dialogue: 0,1:58:06.53,1:58:07.16,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,1:58:07.16,1:58:07.74,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,1:58:07.16,1:58:07.74,Default,,0,0,0,,♪~
Dialogue: 0,1:58:07.74,1:58:10.08,Default,,0,0,0,,♪~
Dialogue: 0,1:58:10.20,1:58:11.91,Default,,0,0,0,,Уф... ой...
Dialogue: 0,1:58:12.87,1:58:13.83,Default,,0,0,0,,Я...
Dialogue: 0,1:58:14.96,1:58:19.96,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,1:58:25.68,1:58:27.22,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,1:58:27.60,1:58:29.01,Default,,0,0,0,,
Dialogue: 0,1:58:40.07,1:58:41.23,Default,,0,0,0,,Қорғаныс!
Dialogue: 0,1:58:53.25,1:58:54.25,Default,,0,0,0,,Уссу
Dialogue: 0,1:59:04.26,1:59:05.05,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,1:59:10.51,1:59:11.51,Default,,0,0,0,,(Жарыл!)
Dialogue: 0,1:59:20.86,1:59:23.86,Default,,0,0,0,,♪ «Нөлдік сезім» (гитара рифі)
Dialogue: 0,1:59:33.41,1:59:36.21,Default,,0,0,0,,♪ Үйірден алыс
Dialogue: 0,1:59:36.66,1:59:39.46,Default,,0,0,0,,♪ Аузыма бір түс ұстадым
Dialogue: 0,1:59:39.92,1:59:42.59,Default,,0,0,0,,♪ Бұл аяқталды
Dialogue: 0,1:59:43.09,1:59:45.80,Default,,0,0,0,,♪ Мен солай болатынын сезіндім.
Dialogue: 0,1:59:46.30,1:59:48.97,Default,,0,0,0,,♪ Аң - құм
Dialogue: 0,1:59:49.43,1:59:52.31,Default,,0,0,0,,♪ Бір уыс шашып жібердім.
Dialogue: 0,1:59:52.60,1:59:55.43,Default,,0,0,0,,♪ Бұл соңы
Dialogue: 0,1:59:55.89,1:59:59.52,Default,,0,0,0,,♪ Мен солай болатынын сезіндім.
Dialogue: 0,2:00:02.27,2:00:05.40,Default,,0,0,0,,♪ Белгісіз армандарды орындау
Dialogue: 0,2:00:05.53,2:00:07.45,Default,,0,0,0,,♪ Уәде етілген түнде
Dialogue: 0,2:00:08.91,2:00:11.70,Default,,0,0,0,,♪ Жеңіл желде тілеймін
Dialogue: 0,2:00:11.82,2:00:13.87,Default,,0,0,0,,♪ Тыныш таңертең
Dialogue: 0,2:00:15.70,2:00:18.41,Default,,0,0,0,,♪ Алыстағы жұлдыздан келген бала
Dialogue: 0,2:00:18.75,2:00:21.96,Default,,0,0,0,,♪ Сол қолдағы уәденің ою-өрнегі
Dialogue: 0,2:00:22.17,2:00:24.63,Default,,0,0,0,,♪ Әлі сапарда
Dialogue: 0,2:00:24.75,2:00:26.76,Default,,0,0,0,,♪ Елес бағында
Dialogue: 0,2:00:34.31,2:00:37.39,Default,,0,0,0,,♪ Тұманда жоғалып кетті
Dialogue: 0,2:00:37.52,2:00:40.39,Default,,0,0,0,,♪ Төбеден тыс
Dialogue: 0,2:00:40.65,2:00:43.36,Default,,0,0,0,,♪ Бұл аяқталды
Dialogue: 0,2:00:43.94,2:00:46.82,Default,,0,0,0,,♪ Мен солай болатынын сезіндім.
Dialogue: 0,2:00:47.15,2:00:50.15,Default,,0,0,0,,♪ Қиындық туралы арман
Dialogue: 0,2:00:50.28,2:00:53.32,Default,,0,0,0,,♪ Егер сіз оны қайта айналдырсаңыз
Dialogue: 0,2:00:53.57,2:00:56.37,Default,,0,0,0,,♪ Бұл аяқталды
Dialogue: 0,2:00:56.74,2:01:00.29,Default,,0,0,0,,♪ Мен солай болатынын сезіндім.
Dialogue: 0,2:01:03.33,2:01:06.25,Default,,0,0,0,,♪ Ыстық құмды тепкілеп, қарсы тұрыңыз
Dialogue: 0,2:01:06.38,2:01:08.30,Default,,0,0,0,,♪ Уәденің алдында
Dialogue: 0,2:01:10.17,2:01:12.59,Default,,0,0,0,,♪ Құтқару желісі жоқ
Dialogue: 0,2:01:12.72,2:01:14.72,Default,,0,0,0,,♪ Цирк түнінде
Dialogue: 0,2:01:16.51,2:01:19.43,Default,,0,0,0,,♪ Әлі сапарда
Dialogue: 0,2:01:19.77,2:01:22.85,Default,,0,0,0,,♪ Сол жерге қарай жылдамдаңыз
Dialogue: 0,2:01:23.02,2:01:25.48,Default,,0,0,0,,♪ Жаңбырдан кейінгі люстра
Dialogue: 0,2:01:25.61,2:01:27.65,Default,,0,0,0,,♪ Елес бағында
Dialogue: 0,2:01:40.29,2:01:42.04,Default,,0,0,0,,♪ Swish да сізді тұтатыңыз
Dialogue: 0,2:01:46.67,2:01:48.38,Default,,0,0,0,,♪ Swish да сізді тұтандырады
Dialogue: 0,2:01:53.09,2:01:54.80,Default,,0,0,0,,♪ Swish да сізді тұтандырады
