Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.30,0:00:15.30,Default,,0,0,0,,
Dialogue: 0,0:00:20.72,0:00:24.27,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:27.94,0:00:29.23,Default,,0,0,0,,Кальмар торы
Dialogue: 0,0:00:29.82,0:00:32.03,Default,,0,0,0,,Осылай еліктей алатын адам...
Dialogue: 0,0:00:32.94,0:00:35.03,Default,,0,0,0,,Мен бір ғана адамды білемін
Dialogue: 0,0:00:50.55,0:00:52.09,Default,,0,0,0,,(Теңіз жаяу әскерлерінің гуілдері)
Dialogue: 0,0:01:02.27,0:01:06.98,Default,,0,0,0,,Пират патшасы Гол Д.Роджер дәуірінен аман қалған...
Dialogue: 0,0:01:07.56,0:01:12.32,Default,,0,0,0,,Ол 20 жыл бойы қайда жоғалып кетті?
Dialogue: 0,0:01:13.53,0:01:16.86,Default,,0,0,0,,Роджерден жеңіліп, тұтқынға түссем де.
Dialogue: 0,0:01:16.99,0:01:20.37,Default,,0,0,0,,Екі аяқты кесіп тастаңыз және бұғауларды шешіңіз.
Dialogue: 0,0:01:20.49,0:01:22.62,Default,,0,0,0,,Түрмеден қашқан адам...
Dialogue: 0,0:01:23.24,0:01:25.37,Default,,0,0,0,,Шики Алтын арыстан!
Dialogue: 0,0:01:29.29,0:01:31.04,Default,,0,0,0,,Бұл ескерту
Dialogue: 0,0:01:37.68,0:01:39.76,Default,,0,0,0,,(Теңіз жаяу әскерлерінің айқайы)
Dialogue: 0,0:01:44.22,0:01:45.52,Default,,0,0,0,,Уау
Dialogue: 0,0:01:50.40,0:01:52.27,Default,,0,0,0,,(Теңіз жаяу әскерлерінің айқайы)
Dialogue: 0,0:01:52.44,0:01:54.40,Default,,0,0,0,,Шынында да, бұл JoJo
Dialogue: 0,0:01:56.74,0:01:58.74,Default,,0,0,0,,Ат!Ат!
Dialogue: 0,0:02:02.99,0:02:04.83,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:02:05.45,0:02:09.08,Default,,0,0,0,,Тыныш болып, аңызға айнал.
Dialogue: 0,0:02:09.50,0:02:13.96,Default,,0,0,0,,Сен енді дүниеден кек алуға келдің бе?
Dialogue: 0,0:02:14.42,0:02:20.05,Default,,0,0,0,,Джи~хаха...
Dialogue: 0,0:02:28.60,0:02:29.10,Default,,0,0,0,,(Жануарлардың дыбыстары)
Dialogue: 0,0:02:29.10,0:02:32.61,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:02:29.10,0:02:32.61,Default,,0,0,0,,(Жануарлардың дыбыстары)
Dialogue: 0,0:02:32.61,0:02:34.77,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:02:36.11,0:02:40.78,Default,,0,0,0,,Уф ха ха...
Dialogue: 0,0:02:46.37,0:02:50.92,Default,,0,0,0,,уа ха ха ха
Dialogue: 0,0:03:02.80,0:03:05.31,Default,,0,0,0,,Біз оларды тез табуымыз керек.
Dialogue: 0,0:03:06.39,0:03:07.64,Default,,0,0,0,,Жоқққ!
Dialogue: 0,0:03:19.94,0:03:22.70,Default,,0,0,0,,Gum Gum's ~ Awawa...
Dialogue: 0,0:03:23.28,0:03:25.33,Default,,0,0,0,,Шарлар!
Dialogue: 0,0:03:38.55,0:03:42.97,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:03:44.76,0:03:46.68,Default,,0,0,0,,Уау
Dialogue: 0,0:03:47.47,0:03:49.81,Default,,0,0,0,,Вау!
Dialogue: 0,0:03:50.18,0:03:53.10,Default,,0,0,0,,Ухи ха ха ха... (Жер қағашы ырылдады)
Dialogue: 0,0:03:54.77,0:03:55.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:57.19,0:03:59.82,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:04:01.49,0:04:02.95,Default,,0,0,0,,(Мори сегізаяқтың үруі)
Dialogue: 0,0:04:06.91,0:04:10.08,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:04:11.33,0:04:15.33,Default,,0,0,0,,(Мори сегізаяқтың үруі)
Dialogue: 0,0:04:19.05,0:04:20.96,Default,,0,0,0,,Уау
Dialogue: 0,0:04:22.01,0:04:23.09,Default,,0,0,0,,(Луффидің күшті дауысы)
Dialogue: 0,0:04:25.93,0:04:27.39,Default,,0,0,0,,Міне!
Dialogue: 0,0:04:27.47,0:04:30.35,Default,,0,0,0,,Уф ха ха ха... (Мори сегізаяқ ырылдады)
Dialogue: 0,0:04:30.43,0:04:31.27,Default,,0,0,0,,Уфф
Dialogue: 0,0:04:33.64,0:04:34.60,Default,,0,0,0,,Манты!?
Dialogue: 0,0:04:34.85,0:04:35.85,Default,,0,0,0,,Уау
Dialogue: 0,0:04:36.27,0:04:39.36,Default,,0,0,0,,Ой... уф
Dialogue: 0,0:04:39.73,0:04:40.40,Default,,0,0,0,,Уф
Dialogue: 0,0:04:50.29,0:04:52.00,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:04:52.91,0:04:54.66,Default,,0,0,0,,(Дон Мантидің айқайы)
Dialogue: 0,0:04:59.84,0:05:01.84,Default,,0,0,0,,(Дон сыйынатын мантис қанаттары)
Dialogue: 0,0:05:04.55,0:05:06.72,Default,,0,0,0,,(айқай)
Dialogue: 0,0:05:12.81,0:05:15.81,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:05:18.69,0:05:21.69,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:05:35.46,0:05:39.13,Default,,0,0,0,,
Dialogue: 0,0:05:40.63,0:05:42.55,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:05:42.67,0:05:44.59,Default,,0,0,0,,Шынында не болып жатыр? Бұл арал
Dialogue: 0,0:05:44.67,0:05:48.76,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:05:49.09,0:05:49.76,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:51.47,0:05:53.10,Default,,0,0,0,,(Терогманың айқайы)
Dialogue: 0,0:05:53.22,0:05:56.73,Default,,0,0,0,,Няро! Сіз мұны істеуге дайынсыз ба? Хмм
Dialogue: 0,0:05:56.81,0:05:58.19,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:05:59.60,0:06:01.77,Default,,0,0,0,,Сағыз резеңке —
Dialogue: 0,0:06:02.32,0:06:04.15,Default,,0,0,0,,Мылтық!
Dialogue: 0,0:06:04.86,0:06:05.69,Default,,0,0,0,,Уф
Dialogue: 0,0:06:06.28,0:06:08.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:13.08,0:06:17.33,Default,,0,0,0,,Дұрыс, мұнда жануарларды жалауға болмайды.
Dialogue: 0,0:06:17.83,0:06:19.12,Default,,0,0,0,,(Терогма айқайлау)
Dialogue: 0,0:06:21.54,0:06:23.42,Default,,0,0,0,,3-беріліс (үшінші)
Dialogue: 0,0:06:26.42,0:06:27.42,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:31.34,0:06:33.18,Default,,0,0,0,,Сүйек шары!
Dialogue: 0,0:06:33.26,0:06:34.18,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:06:35.81,0:06:37.18,Default,,0,0,0,,Сағыз резеңке —
Dialogue: 0,0:06:38.73,0:06:42.73,Default,,0,0,0,,Үлкен тапанша!
Dialogue: 0,0:07:08.13,0:07:13.93,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:15.51,0:07:18.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:19.02,0:07:23.65,Default,,0,0,0,,Хмм... хааа аа...
Dialogue: 0,0:07:28.82,0:07:31.45,Default,,0,0,0,,Ха, бұл қауіпті болды.
Dialogue: 0,0:07:31.82,0:07:35.20,Default,,0,0,0,,Бұл әдісті қолданғанда, ұсақ-түйектер қиындық тудырады.
Dialogue: 0,0:07:35.32,0:07:35.99,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:38.41,0:07:40.50,Default,,0,0,0,,Мына сегізаяқ дәмді көрінеді.
Dialogue: 0,0:07:43.04,0:07:47.04,Default,,0,0,0,,(алыстан айқайлау)
Dialogue: 0,0:07:48.34,0:07:50.59,Default,,0,0,0,,Не? ағымдағы дыбыс
Dialogue: 0,0:07:50.72,0:07:53.47,Default,,0,0,0,,Сіз білесіз бе? Ондай ештеңе емес.
Dialogue: 0,0:07:53.76,0:07:57.76,Default,,0,0,0,,Мен жалғыз қалдым ба?
Dialogue: 0,0:08:00.81,0:08:03.56,Default,,0,0,0,,Ах... Гах!
Dialogue: 0,0:08:03.69,0:08:05.44,Default,,0,0,0,,Ха, не болды!
Dialogue: 0,0:08:06.15,0:08:09.19,Default,,0,0,0,,(Әскер құмырсқаларының дыбысы)
Dialogue: 0,0:08:09.57,0:08:11.28,Default,,0,0,0,,Нуо, бұл жолы Әли ме?
Dialogue: 0,0:08:11.44,0:08:14.86,Default,,0,0,0,,Сәлем! (әскери құмырсқалар жылайды)
Dialogue: 0,0:08:14.99,0:08:16.45,Default,,0,0,0,,А... А?
Dialogue: 0,0:08:16.62,0:08:17.33,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:08:17.41,0:08:19.95,Default,,0,0,0,,(Әскери құмырсқалардың дыбысы)
Dialogue: 0,0:08:20.08,0:08:23.08,Default,,0,0,0,,Цк, сенің көздегенің осы ма?
Dialogue: 0,0:08:23.41,0:08:26.46,Default,,0,0,0,,Фрэнки, жанармайың таусылған жоқ па?
Dialogue: 0,0:08:26.58,0:08:29.75,Default,,0,0,0,,Уау, дұрыс! Уф
Dialogue: 0,0:08:30.76,0:08:32.63,Default,,0,0,0,,Иә (әскери құмырсқалардың айқайы)
Dialogue: 0,0:08:37.55,0:08:39.43,Default,,0,0,0,,Уфххх...
Dialogue: 0,0:08:39.51,0:08:41.56,Default,,0,0,0,,Хаха...
Dialogue: 0,0:08:48.15,0:08:49.23,Default,,0,0,0,,Мен қайтамын (Фрэнки)...
Dialogue: 0,0:08:57.99,0:08:59.33,Default,,0,0,0,,(айқай)
Dialogue: 0,0:08:59.41,0:09:00.12,Default,,0,0,0,,Oh?
Dialogue: 0,0:09:02.08,0:09:03.16,Default,,0,0,0,,Tsk
Dialogue: 0,0:09:03.66,0:09:04.71,Default,,0,0,0,,(Әскер құмырсқаларының дыбысы)
Dialogue: 0,0:09:04.79,0:09:05.87,Default,,0,0,0,,Уф
Dialogue: 0,0:09:07.46,0:09:08.46,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:09:13.55,0:09:14.42,Default,,0,0,0,,Нуо ах...
Dialogue: 0,0:09:20.10,0:09:22.01,Default,,0,0,0,,Ах, бірге...
Dialogue: 0,0:09:22.22,0:09:23.39,Default,,0,0,0,,Екеуің де амансыңдар.
Dialogue: 0,0:09:24.10,0:09:27.48,Default,,0,0,0,,Енді мен сізді неге ешқашан нысанаға алмайтыныңызды білемін.
Dialogue: 0,0:09:27.60,0:09:28.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:28.35,0:09:30.27,Default,,0,0,0,,(Әскер құмырсқаларының дыбысы)
Dialogue: 0,0:09:30.48,0:09:33.94,Default,,0,0,0,,Сізде жейтін ештеңе жоқ.
Dialogue: 0,0:09:34.32,0:09:36.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:36.53,0:09:39.70,Default,,0,0,0,,Бұл сәл дөрекі емес пе?!
Dialogue: 0,0:09:40.12,0:09:43.12,Default,,0,0,0,,(Әскер құмырсқаларының дыбысы)
Dialogue: 0,0:09:43.24,0:09:46.25,Default,,0,0,0,,(аспанды кесу дыбысы)
Dialogue: 0,0:09:50.17,0:09:51.50,Default,,0,0,0,,(айқай)
Dialogue: 0,0:09:52.09,0:09:53.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:54.01,0:09:55.51,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:58.22,0:09:59.26,Default,,0,0,0,,(айқай)
Dialogue: 0,0:10:02.89,0:10:03.76,Default,,0,0,0,,(айқай)
Dialogue: 0,0:10:05.98,0:10:06.81,Default,,0,0,0,,(айқай)
Dialogue: 0,0:10:08.60,0:10:11.15,Default,,0,0,0,,Үш ызылдаған ән...
Dialogue: 0,0:10:11.27,0:10:13.23,Default,,0,0,0,,(айқай)
Dialogue: 0,0:10:14.90,0:10:16.99,Default,,0,0,0,,Жебе ұшымен қиғаш сызық!
Dialogue: 0,0:10:17.32,0:10:20.82,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:10:28.37,0:10:31.50,Default,,0,0,0,,Менің қатал жігіт екенім рас.
Dialogue: 0,0:10:31.63,0:10:33.79,Default,,0,0,0,,Мені қазір бір нәрсе қызықтырады...
Dialogue: 0,0:10:37.42,0:10:39.09,Default,,0,0,0,,Жартылай жіңішкеру
Dialogue: 0,0:10:39.59,0:10:45.60,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:10:53.94,0:10:56.82,Default,,0,0,0,,Бірақ бұл аралда не болып жатыр?
Dialogue: 0,0:10:57.07,0:11:00.74,Default,,0,0,0,,Жануарлар да, жәндіктер де біз бұрын-соңды көрмеген жолмен дамуда.
Dialogue: 0,0:11:01.20,0:11:06.04,Default,,0,0,0,,Адамның даналығы да, күші де жете алмайтын дүние, тек күш маңызды.
Dialogue: 0,0:11:06.29,0:11:10.50,Default,,0,0,0,,Хмф! Бұл ең мықтысы аман қалатын арал ма?
Dialogue: 0,0:12:31.58,0:12:37.29,Default,,0,0,0,,~♪
Dialogue: 0,0:13:41.15,0:13:41.52,Default,,0,0,0,,(жеңіл музыка)
Dialogue: 0,0:13:41.52,0:13:42.19,Default,,0,0,0,,(жеңіл музыка)
Dialogue: 0,0:13:41.52,0:13:42.19,Default,,0,0,0,,Га
Dialogue: 0,0:13:42.19,0:13:45.15,Default,,0,0,0,,(жеңіл музыка)
Dialogue: 0,0:14:30.41,0:14:31.37,Default,,0,0,0,,Хун
Dialogue: 0,0:14:32.12,0:14:34.58,Default,,0,0,0,,Ах... хаха
Dialogue: 0,0:14:35.04,0:14:39.08,Default,,0,0,0,,Сіз шешім қабылдадыңыз ба? Бала-чан
Dialogue: 0,0:14:40.58,0:14:42.00,Default,,0,0,0,,Мені тезірек бұл жерден кетіріңіз!
Dialogue: 0,0:14:42.38,0:14:44.25,Default,,0,0,0,,Жихахаха...!
Dialogue: 0,0:14:44.38,0:14:49.97,Default,,0,0,0,,Ол ерік-жігері күшті қыз. Маған ондай қыз ұнамайды.
Dialogue: 0,0:14:51.51,0:14:52.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:52.47,0:14:55.51,Default,,0,0,0,,Уф уф...
Dialogue: 0,0:14:55.64,0:14:58.68,Default,,0,0,0,,Сенің аяғыңның дыбысында ақау бар ма?
Dialogue: 0,0:14:58.81,0:14:59.98,Default,,0,0,0,,Доктор Индиго!
Dialogue: 0,0:15:00.10,0:15:00.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:03.98,0:15:04.98,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:10.28,0:15:11.45,Default,,0,0,0,,Мен не айта аламын?
Dialogue: 0,0:15:11.53,0:15:13.03,Default,,0,0,0,,Енді ойлап қарасам, саған бір нәрсе көрсеткім келеді.
Dialogue: 0,0:15:13.16,0:15:14.37,Default,,0,0,0,,Сөйлескіңіз келе ме?
Dialogue: 0,0:15:14.45,0:15:16.33,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,0:15:16.58,0:15:18.29,Default,,0,0,0,,А... Анашым?
Dialogue: 0,0:15:18.41,0:15:20.21,Default,,0,0,0,,Бұл горилла, қалай қарасаң да!
Dialogue: 0,0:15:21.17,0:15:22.33,Default,,0,0,0,,Иә! (Қызыл) Уау
Dialogue: 0,0:15:22.92,0:15:23.79,Default,,0,0,0,,Маған қарама
Dialogue: 0,0:15:24.42,0:15:27.25,Default,,0,0,0,,Мұз сияқты, балақай
Dialogue: 0,0:15:27.38,0:15:30.17,Default,,0,0,0,,Жихахаха...
Dialogue: 0,0:15:35.10,0:15:37.14,Default,,0,0,0,,Неге ол кезде...
Dialogue: 0,0:15:47.73,0:15:50.19,Default,,0,0,0,,Шығыс теңізде (Шығыс көк) не болып жатыр?
Dialogue: 0,0:15:50.61,0:15:55.49,Default,,0,0,0,,«Шабуыл тудыратын қауіп, кенеттен жоғалып кететін қаланың құпиясы»
Dialogue: 0,0:15:56.08,0:15:59.91,Default,,0,0,0,,Шығыс теңізде (Шығыс көк) бір түнде қалалар бірінен соң бірі жойылып жатқан сияқты.
Dialogue: 0,0:16:00.54,0:16:04.08,Default,,0,0,0,,Әзірге бізге туыс аралдар қауіпсіз сияқты, бірақ...
Dialogue: 0,0:16:04.21,0:16:07.04,Default,,0,0,0,,Бұл қанша уақытқа созылады?
Dialogue: 0,0:16:07.38,0:16:10.26,Default,,0,0,0,,Луффи, Зоро, Нами және Усоп...
Dialogue: 0,0:16:10.38,0:16:12.26,Default,,0,0,0,,Мен Шығыс теңізіненмін (Шығыс көк).
Dialogue: 0,0:16:12.38,0:16:13.34,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:16:13.76,0:16:16.10,Default,,0,0,0,,Бұл да Санджи ме?
Dialogue: 0,0:16:16.64,0:16:19.35,Default,,0,0,0,,Мен Солтүстік теңізде (Солтүстік Көк) дүниеге келдім, бірақ...
Dialogue: 0,0:16:19.47,0:16:21.39,Default,,0,0,0,,Мен Шығыста өстім.
Dialogue: 0,0:16:23.77,0:16:28.36,Default,,0,0,0,,Әй, не? Бұл метеорит пе?
Dialogue: 0,0:16:28.61,0:16:29.65,Default,,0,0,0,,О? Ах...
Dialogue: 0,0:16:29.98,0:16:31.61,Default,,0,0,0,,(Барлығы күңкілдейді)
Dialogue: 0,0:16:42.04,0:16:43.75,Default,,0,0,0,,Не? Иә!
Dialogue: 0,0:16:43.83,0:16:45.12,Default,,0,0,0,,Арал!
Dialogue: 0,0:16:45.42,0:16:47.54,Default,,0,0,0,,Неге ұшып жүрсің? Сол арал
Dialogue: 0,0:16:49.96,0:16:53.38,Default,,0,0,0,,Эй (Фрэнки) Ио ха ха...
Dialogue: 0,0:16:55.18,0:16:56.43,Default,,0,0,0,,Желкен бар
Dialogue: 0,0:16:56.55,0:16:59.18,Default,,0,0,0,,Бұл желкенді кеме ме? Иә, хмм
Dialogue: 0,0:17:00.93,0:17:02.81,Default,,0,0,0,,Бас сүйек және көлденең сүйектер! Бұл қарақшылар кемесі ме?
Dialogue: 0,0:17:02.93,0:17:05.23,Default,,0,0,0,,Ұшатын арал кемесі?
Dialogue: 0,0:17:05.64,0:17:06.69,Default,,0,0,0,,Га
Dialogue: 0,0:17:07.94,0:17:08.98,Default,,0,0,0,,Бұл жел...
Dialogue: 0,0:17:09.52,0:17:13.11,Default,,0,0,0,,Бұл бағыт нашар Луффи, жақын арада циклон келеді.
Dialogue: 0,0:17:13.24,0:17:17.70,Default,,0,0,0,,Не? Ендеше, соларға да айтайық.
Dialogue: 0,0:17:17.82,0:17:18.87,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:17:18.95,0:17:19.32,Default,,0,0,0,,Мына жерде циклон келе жатыр!
Dialogue: 0,0:17:19.32,0:17:22.04,Default,,0,0,0,,Ол жақта циклон келе жатыр!
Dialogue: 0,0:17:19.32,0:17:22.04,Default,,0,0,0,,Егер ойыңды өзгертсең, маған хабарла
Dialogue: 0,0:17:24.75,0:17:26.29,Default,,0,0,0,,Бірдеңе деп айғайлап тұрған сияқты...
Dialogue: 0,0:17:27.54,0:17:29.79,Default,,0,0,0,,Сіз қарақшысыз ба? (Бағыныңқы) Солай көрінеді.
Dialogue: 0,0:17:29.92,0:17:32.92,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:17:33.05,0:17:33.71,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:36.59,0:17:37.55,Default,,0,0,0,,Ах
Dialogue: 0,0:17:39.80,0:17:40.51,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:40.60,0:17:41.89,Default,,0,0,0,,Не… не болды? лүффи
Dialogue: 0,0:17:42.35,0:17:43.27,Default,,0,0,0,,Нами!
Dialogue: 0,0:17:43.39,0:17:45.93,Default,,0,0,0,,Не? Ха... Хм...
Dialogue: 0,0:17:46.06,0:17:47.94,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:17:48.06,0:17:49.56,Default,,0,0,0,,Бұл тонды теру емес пе?
Dialogue: 0,0:17:49.69,0:17:53.44,Default,,0,0,0,,Бұл сіздің Аспан аралында болғаныңызды білдіре ме?
Dialogue: 0,0:17:53.57,0:17:55.78,Default,,0,0,0,,Ақырында сіз қарапайым адам емес сияқтысыз.
Dialogue: 0,0:17:56.15,0:17:58.53,Default,,0,0,0,,Бәрі жақсы, Нами!
Dialogue: 0,0:17:59.20,0:18:00.03,Default,,0,0,0,,Иә
Dialogue: 0,0:18:01.33,0:18:03.91,Default,,0,0,0,,О, сен оны қалай пайдалану керектігін білдің бе?
Dialogue: 0,0:18:07.50,0:18:11.42,Default,,0,0,0,,Жақында циклон болады. Саяхат бағытынан сағат 9-да!
Dialogue: 0,0:18:11.63,0:18:12.84,Default,,0,0,0,,Навигатор командасы
Dialogue: 0,0:18:12.96,0:18:16.26,Default,,0,0,0,,Жоқ, ондай белгілер мүлде жоқ.
Dialogue: 0,0:18:16.51,0:18:18.34,Default,,0,0,0,,Сынап өлшегіш те қалыпты.
Dialogue: 0,0:18:18.63,0:18:20.51,Default,,0,0,0,,Олар сағат 9-ға қарай бұрылды.
Dialogue: 0,0:18:20.76,0:18:22.30,Default,,0,0,0,,Керемет аяқтар! иә?
Dialogue: 0,0:18:25.68,0:18:27.02,Default,,0,0,0,,А, Пермь?
Dialogue: 0,0:18:27.14,0:18:28.64,Default,,0,0,0,,Қалай қарасаң да жаңбырлы бұлт!
Dialogue: 0,0:18:28.98,0:18:30.52,Default,,0,0,0,,А... бұл өтірік, солай ма?
Dialogue: 0,0:18:30.65,0:18:33.48,Default,,0,0,0,,Шики-сама! Бірден, сағат 9-ға қарай бағыттаңыз!
Dialogue: 0,0:18:33.94,0:18:35.36,Default,,0,0,0,,Бұл ақымақ үлкен циклон!
Dialogue: 0,0:18:35.48,0:18:36.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:38.57,0:18:39.36,Default,,0,0,0,,Құт
Dialogue: 0,0:18:57.92,0:18:58.63,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:01.47,0:19:05.85,Default,,0,0,0,,Шики-сама! Өтінемін, ашыңыз, Шики-сама!
Dialogue: 0,0:19:05.97,0:19:07.43,Default,,0,0,0,,(Бағыныңқылардың айқайы)
Dialogue: 0,0:19:23.91,0:19:25.28,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:19:27.62,0:19:31.50,Default,,0,0,0,,Ах… Ах… Ах…
Dialogue: 0,0:19:31.62,0:19:32.96,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:19:33.38,0:19:35.17,Default,,0,0,0,,Болжамды ешқашан жіберіп алмаңыз
Dialogue: 0,0:19:35.59,0:19:36.75,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:19:37.30,0:19:38.84,Default,,0,0,0,,Тіпті—
Dialogue: 0,0:19:38.96,0:19:41.18,Default,,0,0,0,,Осы жігіттердің ең жақсысын көрсетіңіз—
Dialogue: 0,0:19:41.30,0:19:44.68,Default,,0,0,0,,Ауа райын сезетін әйел қандай...
Dialogue: 0,0:19:48.64,0:19:50.35,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:19:55.65,0:19:57.36,Default,,0,0,0,,Ах... аа... енді қалай...
Dialogue: 0,0:19:57.48,0:19:58.86,Default,,0,0,0,,Сіз түстіңіз бе?
Dialogue: 0,0:19:58.98,0:20:00.65,Default,,0,0,0,,Ал... енді...
Dialogue: 0,0:20:01.15,0:20:05.16,Default,,0,0,0,,Мен Шики Алтын арыстанмын, қарақшымын.
Dialogue: 0,0:20:05.99,0:20:08.99,Default,,0,0,0,,Тонды тергіштің дауысы кім?
Dialogue: 0,0:20:09.66,0:20:11.46,Default,,0,0,0,,Гей...
Dialogue: 0,0:20:11.58,0:20:12.66,Default,,0,0,0,,Мен ғана
Dialogue: 0,0:20:14.04,0:20:14.96,Default,,0,0,0,,Иә
Dialogue: 0,0:20:15.17,0:20:19.63,Default,,0,0,0,,Ой... Бала рахмет айтады.
Dialogue: 0,0:20:19.76,0:20:20.71,Default,,0,0,0,,А... жоқ
Dialogue: 0,0:20:21.05,0:20:24.26,Default,,0,0,0,,Әй, ақсақал, бұл неге қалқып тұр?
Dialogue: 0,0:20:24.64,0:20:27.76,Default,,0,0,0,,Иә? Әй, солай ма?
Dialogue: 0,0:20:27.89,0:20:29.97,Default,,0,0,0,,Бұл үлпілдек жеміс қабілеті.
Dialogue: 0,0:20:30.43,0:20:33.56,Default,,0,0,0,,Мен ұстайтын нәрсе, ауырлық күшіне қарамастан...
Dialogue: 0,0:20:33.69,0:20:35.60,Default,,0,0,0,,Сіз оны еркін басқара аласыз ба?
Dialogue: 0,0:20:36.56,0:20:38.02,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:20:39.07,0:20:39.98,Default,,0,0,0,,Осындай күйде Рух толқындарына шоғырлана алмаймын
Dialogue: 0,0:20:40.11,0:20:41.11,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:20:41.99,0:20:44.07,Default,,0,0,0,,О? о? …
Dialogue: 0,0:20:49.41,0:20:51.62,Default,,0,0,0,,Ооо...
Dialogue: 0,0:20:51.75,0:20:53.00,Default,,0,0,0,,Уау
Dialogue: 0,0:20:56.92,0:20:58.13,Default,,0,0,0,,О... а...
Dialogue: 0,0:20:58.42,0:21:00.67,Default,,0,0,0,,О, бұл керемет
Dialogue: 0,0:21:00.80,0:21:02.76,Default,,0,0,0,,Қария! Мені де жұмсақ қыл
Dialogue: 0,0:21:02.92,0:21:04.09,Default,,0,0,0,,Мен де Мен де
Dialogue: 0,0:21:04.22,0:21:06.80,Default,,0,0,0,,Джихахахахаха кешіріңіз
Dialogue: 0,0:21:07.26,0:21:09.26,Default,,0,0,0,,Менен басқа адамдар мен жануарлар —
Dialogue: 0,0:21:09.35,0:21:11.77,Default,,0,0,0,,Тірі заттарды қалқып шығаруға болмайды.
Dialogue: 0,0:21:11.89,0:21:13.31,Default,,0,0,0,,Не? Бұл қызықсыз.
Dialogue: 0,0:21:13.43,0:21:14.77,Default,,0,0,0,,Бу Бу
Dialogue: 0,0:21:15.52,0:21:19.61,Default,,0,0,0,,Айтпақшы, мен сені жасырынған жерімде қонақ қылғым келеді.
Dialogue: 0,0:21:20.36,0:21:23.40,Default,,0,0,0,,Бұл жай ғана алғыс белгісі.Келесіздер ме?
Dialogue: 0,0:21:24.78,0:21:26.82,Default,,0,0,0,,Жоқ, жарай ма?
Dialogue: 0,0:21:27.41,0:21:30.91,Default,,0,0,0,,Біз қазір Шығыс теңізге (Шығыс көк) баруымыз керек.
Dialogue: 0,0:21:31.12,0:21:33.04,Default,,0,0,0,,Иә? Луффи?
Dialogue: 0,0:21:33.12,0:21:34.91,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:35.04,0:21:38.21,Default,,0,0,0,,Эй, эй... шытырман оқиға туралы не айтасыз?
Dialogue: 0,0:21:38.33,0:21:40.63,Default,,0,0,0,,Барлығын қайта жасауға болады.
Dialogue: 0,0:21:40.71,0:21:41.34,Default,,0,0,0,,Иә!?
Dialogue: 0,0:21:41.55,0:21:44.84,Default,,0,0,0,,Туған жеріңнің жігіттері қиналып жатса, сен бір орында тұра алмайсың ба?
Dialogue: 0,0:21:45.01,0:21:47.05,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:21:47.34,0:21:49.55,Default,,0,0,0,,Бұл берілген (темекі тұтату дыбысы)
Dialogue: 0,0:21:49.68,0:21:50.97,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:21:51.68,0:21:53.97,Default,,0,0,0,,Біз ресми түрде келісімге келдік.
Dialogue: 0,0:21:54.60,0:21:56.77,Default,,0,0,0,,Дұрыс... (Чоппер) Хехе.
Dialogue: 0,0:21:56.89,0:21:57.85,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:57.98,0:21:59.10,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:21:59.69,0:22:02.40,Default,,0,0,0,,Сондықтан әдепті болған дұрыс.
Dialogue: 0,0:22:03.86,0:22:05.65,Default,,0,0,0,,Маған одан да қатты ұнайды!
Dialogue: 0,0:22:06.11,0:22:09.41,Default,,0,0,0,,Түсіндім, Шығыс теңіз (Шығыс көк) сенің туған жерің.
Dialogue: 0,0:22:09.95,0:22:11.91,Default,,0,0,0,,Бұл шынымен алаңдататын болуы керек.
Dialogue: 0,0:22:12.58,0:22:16.25,Default,,0,0,0,,Жарайды, түсіндім. Мен сізді сонда апару үшін өз қабілеттерімді пайдаланамын.
Dialogue: 0,0:22:16.62,0:22:18.08,Default,,0,0,0,,Не? Расында ма?
Dialogue: 0,0:22:18.21,0:22:21.17,Default,,0,0,0,,Рахмет! Аға, ол жақсы жігіт.
Dialogue: 0,0:22:21.50,0:22:22.67,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:22:22.84,0:22:24.25,Default,,0,0,0,,Бұл мүмкін емес пе?
Dialogue: 0,0:22:26.76,0:22:29.76,Default,,0,0,0,,Жарайсыңдар, бейбақтар, ұрысқа дайындалыңдар!
Dialogue: 0,0:22:29.89,0:22:31.01,Default,,0,0,0,,Оу!
Dialogue: 0,0:22:31.14,0:22:32.89,Default,,0,0,0,,Сіз өте жылдамсыз!
Dialogue: 0,0:22:55.29,0:22:57.58,Default,,0,0,0,,Ухохохохо жоғары! Уау~
Dialogue: 0,0:22:57.70,0:22:59.33,Default,,0,0,0,,Бұл жақсы сезінеді
Dialogue: 0,0:22:59.46,0:23:02.46,Default,,0,0,0,,Балалар, сіздердің шайқасқа дайындықтарыңызды басқаша елестетесіздер ме?
Dialogue: 0,0:23:02.71,0:23:06.92,Default,,0,0,0,,Мен шынында да аздап шиеленіс болғанын қалаймын.
Dialogue: 0,0:23:07.05,0:23:08.72,Default,,0,0,0,,Сіз ең бос адамсыз!
Dialogue: 0,0:23:09.05,0:23:10.68,Default,,0,0,0,,(Луффи мен Усоптың күлкісі)
Dialogue: 0,0:23:10.80,0:23:12.72,Default,,0,0,0,,А, мен бірдеңені көрдім.
Dialogue: 0,0:23:12.84,0:23:13.68,Default,,0,0,0,,А? о?
Dialogue: 0,0:23:34.99,0:23:36.83,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:23:36.95,0:23:40.12,Default,,0,0,0,,Бәрің де қарияның жүзу қабілетін пайдаланасыңдар ма?
Dialogue: 0,0:23:40.25,0:23:41.58,Default,,0,0,0,,Иә
Dialogue: 0,0:23:42.54,0:23:45.75,Default,,0,0,0,,Бір нәрсе қалқып қалса, ол қалқып кете береді.
Dialogue: 0,0:23:45.92,0:23:46.59,Default,,0,0,0,,Күрсін
Dialogue: 0,0:23:46.71,0:23:49.38,Default,,0,0,0,,Уау, бұл арал үлкен! сурет?
Dialogue: 0,0:23:55.80,0:23:56.93,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:23:57.22,0:23:58.47,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:24:01.94,0:24:03.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:05.40,0:24:06.86,Default,,0,0,0,,Бұл Мелвилл
Dialogue: 0,0:24:06.98,0:24:10.03,Default,,0,0,0,,Бұл шытырман оқиғаны жақсы көретіндер үшін тамаша арал.
Dialogue: 0,0:24:10.19,0:24:12.61,Default,,0,0,0,,Иә? Келіңіздер, көңіліңізден шыққанша ойнаңыз.
Dialogue: 0,0:24:12.86,0:24:14.36,Default,,0,0,0,,Не? Уф, көкек
Dialogue: 0,0:24:14.57,0:24:16.12,Default,,0,0,0,,Сәлем! Хмм
Dialogue: 0,0:24:16.95,0:24:17.87,Default,,0,0,0,,Қайдасың!
Dialogue: 0,0:24:18.20,0:24:19.62,Default,,0,0,0,,Уау, о
Dialogue: 0,0:24:19.83,0:24:20.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:20.66,0:24:22.37,Default,,0,0,0,,Ал оған он алты жасында, Римде…
Dialogue: 0,0:24:22.50,0:24:24.29,Default,,0,0,0,,(Луффи мен оның достарының айқайы)
Dialogue: 0,0:24:24.42,0:24:26.38,Default,,0,0,0,,Навигатор түсінді!
Dialogue: 0,0:24:26.67,0:24:27.92,Default,,0,0,0,,Нумми!
Dialogue: 0,0:24:28.00,0:24:29.42,Default,,0,0,0,,Уф аа~
Dialogue: 0,0:24:29.71,0:24:31.92,Default,,0,0,0,,Жихахаха...
Dialogue: 0,0:24:33.80,0:24:34.51,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:24:34.76,0:24:37.55,Default,,0,0,0,,(Луффи мен оның достарының айқайы)
Dialogue: 0,0:24:37.68,0:24:39.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:39.85,0:24:41.06,Default,,0,0,0,,Уф (Фрэнки) Не?
Dialogue: 0,0:24:41.18,0:24:43.14,Default,,0,0,0,,О, Құдайым!
Dialogue: 0,0:24:43.27,0:24:44.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:44.14,0:24:47.02,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,0:24:47.15,0:24:48.86,Default,,0,0,0,,Хааахх
Dialogue: 0,0:24:48.94,0:24:53.20,Default,,0,0,0,,Луффи! барлығы~!
Dialogue: 0,0:24:53.99,0:24:59.45,Default,,0,0,0,,Жихахахаха Жихахахаха...
Dialogue: 0,0:25:02.87,0:25:07.25,Default,,0,0,0,,Шики-сама! Жаңа эволюциялық форма пайда болды!
Dialogue: 0,0:25:07.38,0:25:08.13,Default,,0,0,0,,(Найзағайдың ыңылдауы)
Dialogue: 0,0:25:08.38,0:25:10.34,Default,,0,0,0,,Қарап көріңізші (Thunderbird) Ku~
Dialogue: 0,0:25:10.75,0:25:11.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:11.96,0:25:13.09,Default,,0,0,0,,Не? гитара?
Dialogue: 0,0:25:13.22,0:25:14.97,Default,,0,0,0,,Қалай қарасаң да құс!
Dialogue: 0,0:25:15.34,0:25:16.47,Default,,0,0,0,,Уф, иә!
Dialogue: 0,0:25:16.59,0:25:18.47,Default,,0,0,0,,Шақыру
Dialogue: 0,0:25:18.55,0:25:19.35,Default,,0,0,0,,Уау
Dialogue: 0,0:25:20.31,0:25:21.97,Default,,0,0,0,,Kur? Кончику зімбір!
Dialogue: 0,0:25:22.10,0:25:25.27,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:25:25.39,0:25:26.48,Default,,0,0,0,,Ей!
Dialogue: 0,0:25:27.10,0:25:28.94,Default,,0,0,0,,Қазір эволюция бар ма?
Dialogue: 0,0:25:29.06,0:25:33.44,Default,,0,0,0,,Иә, бұл электрлік шабуылдарға маманданған түрі...
Dialogue: 0,0:25:33.78,0:25:36.78,Default,,0,0,0,,Ku~ Не? Эволюция
Dialogue: 0,0:25:37.03,0:25:39.62,Default,,0,0,0,,Кино түсірілім алаңында алыстан-ақ ол басты рөлдегі актерді байқады
Dialogue: 0,0:25:40.03,0:25:42.91,Default,,0,0,0,,Маған қосылуыңызды сұраймын.
Dialogue: 0,0:25:43.04,0:25:44.66,Default,,0,0,0,,Мен сізге айтайын.
Dialogue: 0,0:25:45.33,0:25:47.25,Default,,0,0,0,,Бұл аралда бастапқыда:
Dialogue: 0,0:25:47.37,0:25:50.71,Default,,0,0,0,,Біз бұрын көрмеген жолмен дамыған жануарлар
Dialogue: 0,0:25:50.84,0:25:53.38,Default,,0,0,0,,Ол сонда тұрған.
Dialogue: 0,0:25:53.63,0:25:57.09,Default,,0,0,0,,Себеп - «IQ» деп аталатын өсімдік
Dialogue: 0,0:25:58.13,0:26:01.05,Default,,0,0,0,,Бұл зат жануарлардың миына әсер етеді.
Dialogue: 0,0:26:01.18,0:26:04.56,Default,,0,0,0,,Жағдайға сәйкес эволюцияны ынталандыру
Dialogue: 0,0:26:04.93,0:26:09.94,Default,,0,0,0,,Мен мұны білгенде, мен аралдағы барлық IQ-ны бақылап отырдым.
Dialogue: 0,0:26:10.31,0:26:12.52,Default,,0,0,0,,Менің бұл аралға қоныстанғаныма 20 жыл болды.
Dialogue: 0,0:26:12.65,0:26:17.36,Default,,0,0,0,,Соңында біз IQ-дан жаңа препарат жасадық.
Dialogue: 0,0:26:17.86,0:26:20.32,Default,,0,0,0,,Оның аты «SIQ»
Dialogue: 0,0:26:20.66,0:26:21.49,Default,,0,0,0,,Хмм
Dialogue: 0,0:26:21.66,0:26:23.45,Default,,0,0,0,,Мұны жануарларға атыңыз
Dialogue: 0,0:26:23.58,0:26:25.54,Default,,0,0,0,,Жауынгерлік эволюцияға қол жеткізіңіз
Dialogue: 0,0:26:25.66,0:26:29.08,Default,,0,0,0,,Үздіксіз енгізілсе, ол одан да қатал болуы мүмкін.
Dialogue: 0,0:26:29.21,0:26:31.88,Default,,0,0,0,,Бұл аралда жауыз болып кеткен жануарлар бар.
Dialogue: 0,0:26:32.00,0:26:34.30,Default,,0,0,0,,Адамдар көп.
Dialogue: 0,0:26:34.96,0:26:37.01,Default,,0,0,0,,(жануарлардың ыңылдауы)
Dialogue: 0,0:26:38.80,0:26:42.14,Default,,0,0,0,,Қандай сұмдық... Неге?
Dialogue: 0,0:26:42.60,0:26:44.35,Default,,0,0,0,,Сіз менің мақсатымды ақырында түсінесіз.
Dialogue: 0,0:26:44.47,0:26:46.39,Default,,0,0,0,,Уау, аа~ (суға құлаған дыбыс)
Dialogue: 0,0:26:46.52,0:26:47.77,Default,,0,0,0,,Дос болғанымызды қалаймын
Dialogue: 0,0:26:48.89,0:26:50.94,Default,,0,0,0,,Демек, олай емес...
Dialogue: 0,0:26:51.19,0:26:52.73,Default,,0,0,0,,Бұл болады! Уф
Dialogue: 0,0:26:53.15,0:26:55.32,Default,,0,0,0,,Не істесең де өз еркің
Dialogue: 0,0:26:55.44,0:27:00.20,Default,,0,0,0,,Сіз маған қосылуымды өтіне бастайсыз.
Dialogue: 0,0:27:00.36,0:27:02.78,Default,,0,0,0,,Өзіңізді сәл сабырлы сезінсеңіз
Dialogue: 0,0:27:02.91,0:27:05.37,Default,,0,0,0,,Мен саған бәрін айтып беремін
Dialogue: 0,0:27:05.54,0:27:09.62,Default,,0,0,0,,Дос болсаң, сұрай аласың.Менен сұрайтын бірдеңе бар ма?
Dialogue: 0,0:27:10.21,0:27:12.79,Default,,0,0,0,,Жихахаха...
Dialogue: 0,0:27:13.17,0:27:15.05,Default,,0,0,0,,(Скарлеттің айқайы)
Dialogue: 0,0:27:15.17,0:27:18.26,Default,,0,0,0,,Не? «Маған мына әйелді беріңізші»?
Dialogue: 0,0:27:18.38,0:27:19.17,Default,,0,0,0,,Уууу
Dialogue: 0,0:27:19.30,0:27:21.93,Default,,0,0,0,,Әңгіме Сіз жолдан шығып кеттіңіз, эротикалық горилла!
Dialogue: 0,0:27:22.05,0:27:25.31,Default,,0,0,0,,Ха, мен таң қалдым. Мен әжем деп ойладым.
Dialogue: 0,0:27:25.43,0:27:27.97,Default,,0,0,0,,Сізде горилланың түрі қандай? Сенің тегің қандай?
Dialogue: 0,0:27:28.31,0:27:29.89,Default,,0,0,0,,Иә! (Қызыл) Уау
Dialogue: 0,0:27:35.27,0:27:40.57,Default,,0,0,0,,Олардың әлі келмеуінің себебі – сол жануарлар.
Dialogue: 0,0:27:41.91,0:27:44.66,Default,,0,0,0,,Нами!
Dialogue: 0,0:27:44.78,0:27:46.28,Default,,0,0,0,,Айқайламаңыз!
Dialogue: 0,0:27:46.41,0:27:47.74,Default,,0,0,0,,(Каен Кабутоның қанаттары)
Dialogue: 0,0:27:47.87,0:27:50.66,Default,,0,0,0,,Гах! жәндік!
Dialogue: 0,0:27:51.21,0:27:53.38,Default,,0,0,0,,Робин!
Dialogue: 0,0:27:53.50,0:27:56.13,Default,,0,0,0,,Сондықтан айқайламаңыз... (Шиматоридің жылағаны)
Dialogue: 0,0:27:56.25,0:27:57.92,Default,,0,0,0,,Гах! құс!
Dialogue: 0,0:27:58.09,0:28:00.01,Default,,0,0,0,,Нами!
Dialogue: 0,0:28:00.09,0:28:02.47,Default,,0,0,0,,Бұл сөзсіз физикалық күш жұмсау.
Dialogue: 0,0:28:02.55,0:28:03.30,Default,,0,0,0,,Робин…
Dialogue: 0,0:28:03.39,0:28:05.64,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:28:06.89,0:28:08.31,Default,,0,0,0,,Уф йотто
Dialogue: 0,0:28:08.43,0:28:10.39,Default,,0,0,0,,Уа, уау, ау!
Dialogue: 0,0:28:10.89,0:28:14.40,Default,,0,0,0,,А, уау, құла! өл!
Dialogue: 0,0:28:17.44,0:28:19.48,Default,,0,0,0,,Хмм, бұл қауіпті.
Dialogue: 0,0:28:19.61,0:28:21.11,Default,,0,0,0,,Ух... Жоғары... А?
Dialogue: 0,0:28:21.36,0:28:24.36,Default,,0,0,0,,Жоғары! Ең жоғарғы! а?
Dialogue: 0,0:28:24.49,0:28:27.16,Default,,0,0,0,,Жақсы
Dialogue: 0,0:28:27.28,0:28:31.08,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:28:32.41,0:28:33.25,Default,,0,0,0,,Ei
Dialogue: 0,0:28:33.46,0:28:36.04,Default,,0,0,0,,Уау... уау
Dialogue: 0,0:28:36.17,0:28:38.17,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:28:38.46,0:28:40.92,Default,,0,0,0,,Ой... Уау!
Dialogue: 0,0:28:41.76,0:28:42.59,Default,,0,0,0,,А...
Dialogue: 0,0:28:43.01,0:28:45.84,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:28:45.97,0:28:47.22,Default,,0,0,0,,Санджи-кун!?
Dialogue: 0,0:28:47.43,0:28:49.60,Default,,0,0,0,,А... иә?
Dialogue: 0,0:28:50.06,0:28:52.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:57.61,0:28:59.94,Default,,0,0,0,,Жаншылды!
Dialogue: 0,0:29:03.15,0:29:04.28,Default,,0,0,0,,мысық
Dialogue: 0,0:29:09.58,0:29:11.54,Default,,0,0,0,,Жарайсың, жарайсың.
Dialogue: 0,0:29:11.79,0:29:12.95,Default,,0,0,0,,Менің нұсқауларымды орындаңыз! Ха~
Dialogue: 0,0:29:13.08,0:29:15.33,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:29:15.62,0:29:16.96,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:29:17.08,0:29:18.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:29:20.09,0:29:21.42,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:29:24.34,0:29:28.34,Default,,0,0,0,,(Сиыр доптың дауысы)
Dialogue: 0,0:29:31.60,0:29:32.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:29:32.77,0:29:35.31,Default,,0,0,0,,Уф... иә?
Dialogue: 0,0:29:36.52,0:29:37.40,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:29:37.40,0:29:39.11,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:29:37.40,0:29:39.11,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:29:43.19,0:29:46.07,Default,,0,0,0,,О, бұл туралы уайымдама!
Dialogue: 0,0:29:48.66,0:29:52.66,Default,,0,0,0,,(Усопп пен Санджидің айқайы)
Dialogue: 0,0:29:53.50,0:29:55.33,Default,,0,0,0,,(Усопптың айқайы)
Dialogue: 0,0:29:55.66,0:29:59.83,Default,,0,0,0,,Ог, д... бух, гаа...
Dialogue: 0,0:30:06.38,0:30:07.59,Default,,0,0,0,,Сәлем анашым!
Dialogue: 0,0:30:08.38,0:30:10.76,Default,,0,0,0,,Гррррр...
Dialogue: 0,0:30:17.39,0:30:20.69,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:30:20.81,0:30:23.82,Default,,0,0,0,,(Дасоктың ыңырсыуы)
Dialogue: 0,0:30:24.44,0:30:26.32,Default,,0,0,0,,(Эттоозаврдың айқайы)
Dialogue: 0,0:30:29.16,0:30:30.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:30:31.53,0:30:32.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:33.37,0:30:37.37,Default,,0,0,0,,(Эттоозаврдың үруі)
Dialogue: 0,0:30:41.92,0:30:42.79,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:30:55.27,0:30:57.39,Default,,0,0,0,,Жақсы, мен оны уақытында жасадым.
Dialogue: 0,0:31:00.73,0:31:01.60,Default,,0,0,0,,Уф
Dialogue: 0,0:31:01.73,0:31:04.32,Default,,0,0,0,,Чоппер, жүніңді маған қарызға бер.
Dialogue: 0,0:31:04.44,0:31:06.99,Default,,0,0,0,,Иә, суық көрінеді.
Dialogue: 0,0:31:07.11,0:31:08.15,Default,,0,0,0,,Сіз оны шеше аласыз ба?
Dialogue: 0,0:31:17.79,0:31:19.04,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:31:19.16,0:31:20.37,Default,,0,0,0,,Сіз байқадыңыз ба...
Dialogue: 0,0:31:21.21,0:31:22.88,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:31:23.00,0:31:25.92,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:31:26.05,0:31:30.34,Default,,0,0,0,,А? Ал, бұл...
Dialogue: 0,0:31:34.14,0:31:37.56,Default,,0,0,0,,Жарайды, бұл жерден тез кетейік.
Dialogue: 0,0:31:38.22,0:31:41.56,Default,,0,0,0,,Мен бірнеше күннен бері қардың астында қалудан шаршадым.
Dialogue: 0,0:31:41.69,0:31:44.77,Default,,0,0,0,,Қысқы белдеуден жарты күнде өту керек.
Dialogue: 0,0:31:45.19,0:31:46.07,Default,,0,0,0,,Иә? Жақсы
Dialogue: 0,0:31:46.57,0:31:47.44,Default,,0,0,0,,Мына жерде.
Dialogue: 0,0:31:47.53,0:31:48.61,Default,,0,0,0,,Е... уф...
Dialogue: 0,0:31:54.87,0:31:56.12,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:31:56.33,0:31:57.45,Default,,0,0,0,,Осы уақытқа дейін
Dialogue: 0,0:31:57.58,0:32:00.54,Default,,0,0,0,,Сіз Зороның нұсқауларын орындадыңыз.
Dialogue: 0,0:32:00.75,0:32:02.37,Default,,0,0,0,,Бұл жай ғана кездейсоқтық болды.
Dialogue: 0,0:32:02.50,0:32:06.04,Default,,0,0,0,,Сол өзенге ерсең, менің ауылымды табасың.
Dialogue: 0,0:32:06.17,0:32:09.51,Default,,0,0,0,,Маған көмектескеніңіз үшін рахмет, Сяо.
Dialogue: 0,0:32:09.63,0:32:10.47,Default,,0,0,0,,Бұл Зоро.
Dialogue: 0,0:32:10.59,0:32:12.30,Default,,0,0,0,,Мен Тони Тони Чоппермін.
Dialogue: 0,0:32:12.43,0:32:15.30,Default,,0,0,0,,Ах, һ... Горилла сөйледі, уф...
Dialogue: 0,0:32:15.43,0:32:17.89,Default,,0,0,0,,Ха, есінен танып қалма!
Dialogue: 0,0:32:19.64,0:32:21.64,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:32:33.40,0:32:36.78,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:32:37.24,0:32:39.45,Default,,0,0,0,,Адамдар осындай аралда өмір сүрді ме?
Dialogue: 0,0:32:39.58,0:32:40.37,Default,,0,0,0,,Мұндай жағдайда бәрін маған қалдыр.
Dialogue: 0,0:32:46.17,0:32:47.00,Default,,0,0,0,,Әй?
Dialogue: 0,0:32:47.13,0:32:48.75,Default,,0,0,0,,Байқадың ба, Усоп?
Dialogue: 0,0:32:48.88,0:32:50.55,Default,,0,0,0,,А... а
Dialogue: 0,0:32:51.59,0:32:52.92,Default,,0,0,0,,Бұл ауыл
Dialogue: 0,0:32:53.13,0:32:54.88,Default,,0,0,0,,Менің жас қызым жоқ
Dialogue: 0,0:32:55.01,0:32:55.89,Default,,0,0,0,,Жоқ, ол жерде!
Dialogue: 0,0:32:56.51,0:32:58.18,Default,,0,0,0,,Сіз ояусыз ба? (Усопп Санджи) Иә?
Dialogue: 0,0:32:58.47,0:33:02.02,Default,,0,0,0,,Мен таң қалдым, өйткені ол кенет аспаннан құлады.
Dialogue: 0,0:33:02.14,0:33:04.27,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:33:04.77,0:33:06.44,Default,,0,0,0,,Рахмет
Dialogue: 0,0:33:06.56,0:33:07.52,Default,,0,0,0,,Рахмет ханым
Dialogue: 0,0:33:07.65,0:33:09.73,Default,,0,0,0,,Маған ұнамайды, ханым.
Dialogue: 0,0:33:10.36,0:33:11.90,Default,,0,0,0,,Оның қолындағы қанаттар ше?
Dialogue: 0,0:33:12.03,0:33:13.32,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:33:13.44,0:33:16.24,Default,,0,0,0,,Неге екені белгісіз, бұл жерде барлығында бар.
Dialogue: 0,0:33:16.57,0:33:18.12,Default,,0,0,0,,Иә
Dialogue: 0,0:33:19.20,0:33:22.83,Default,,0,0,0,,Бұл ауылда тамақ бар ма?
Dialogue: 0,0:33:23.08,0:33:24.37,Default,,0,0,0,,Барлығы арық, бірақ
Dialogue: 0,0:33:24.50,0:33:25.37,Default,,0,0,0,,Е...
Dialogue: 0,0:33:26.87,0:33:30.00,Default,,0,0,0,,А... ерлер мен жас қыздар...
Dialogue: 0,0:33:30.13,0:33:32.92,Default,,0,0,0,,Барлығы патша сарайына шақырылды.
Dialogue: 0,0:33:33.05,0:33:36.38,Default,,0,0,0,,Жұмысшы жоқ, мен әрең өмір сүріп жатырмын.
Dialogue: 0,0:33:36.59,0:33:39.26,Default,,0,0,0,,Не? Бұл ақылсыз әңгіме.
Dialogue: 0,0:33:39.39,0:33:42.56,Default,,0,0,0,,Шикиге қарсы шықсақ, біз үшін бәрі бітті.
Dialogue: 0,0:33:42.68,0:33:43.81,Default,,0,0,0,,Шики!?
Dialogue: 0,0:33:44.18,0:33:48.44,Default,,0,0,0,,Иә, біз оның бақылауындамыз.
Dialogue: 0,0:33:48.56,0:33:49.36,Default,,0,0,0,,Және...
Dialogue: 0,0:33:49.48,0:33:51.23,Default,,0,0,0,,Ха, балалар, жасырыңдар!
Dialogue: 0,0:33:51.32,0:33:53.86,Default,,0,0,0,,Уау, уф...
Dialogue: 0,0:33:53.99,0:33:55.07,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:33:55.19,0:33:57.32,Default,,0,0,0,,Ой...
Dialogue: 0,0:34:02.91,0:34:04.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:34:04.25,0:34:05.37,Default,,0,0,0,,Не? Иә
Dialogue: 0,0:34:05.50,0:34:08.37,Default,,0,0,0,,Өздігінен жүретін бейне тарату құрылғысы
Dialogue: 0,0:34:08.50,0:34:13.00,Default,,0,0,0,,Сол Денден Муши түсірген суреттер тікелей патша сарайына жіберіледі.
Dialogue: 0,0:34:13.21,0:34:13.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:14.51,0:34:17.05,Default,,0,0,0,,Бізді үнемі бақылап отырады.
Dialogue: 0,0:34:17.18,0:34:19.93,Default,,0,0,0,,Егер сіз Шикиді қорғау үшін ең кішкентай қадам жасасаңыз ...
Dialogue: 0,0:34:20.05,0:34:22.72,Default,,0,0,0,,Мен сізді демонстрация ретінде бірден өлтіруім үшін.
Dialogue: 0,0:34:25.31,0:34:27.06,Default,,0,0,0,,(Мамонт Денс Хаул)
Dialogue: 0,0:34:27.27,0:34:28.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:34:28.90,0:34:30.40,Default,,0,0,0,,Ең алдымен, техникалық колледжде—
Dialogue: 0,0:34:30.52,0:34:32.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:33.57,0:34:34.86,Default,,0,0,0,,(Мамонт Денс Хаул)
Dialogue: 0,0:34:40.91,0:34:42.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:42.33,0:34:44.20,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:34:44.33,0:34:45.70,Default,,0,0,0,,Сасық.
Dialogue: 0,0:34:45.83,0:34:49.46,Default,,0,0,0,,Мұрнымның іші дірілдеп тұрғандай.
Dialogue: 0,0:34:49.62,0:34:50.54,Default,,0,0,0,,Сен оны сезбейсің бе?
Dialogue: 0,0:34:51.13,0:34:53.38,Default,,0,0,0,,Жасыл түсті, иә?
Dialogue: 0,0:34:53.50,0:34:54.80,Default,,0,0,0,,Біздің қала –
Dialogue: 0,0:34:54.92,0:34:57.26,Default,,0,0,0,,Дафт Грин деп аталатын ағашпен қоршалған.
Dialogue: 0,0:34:57.38,0:34:59.26,Default,,0,0,0,,Қаланы жануарлардан қорғау
Dialogue: 0,0:34:59.88,0:35:03.01,Default,,0,0,0,,Барлық жануарлар бұл иісті жек көреді.
Dialogue: 0,0:35:03.14,0:35:04.39,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:35:04.68,0:35:07.35,Default,,0,0,0,,Олай болса, мұрынды тығындаңыз. (Ұсақтауыш) Е~
Dialogue: 0,0:35:07.48,0:35:08.35,Default,,0,0,0,,Кеттік
Dialogue: 0,0:35:08.48,0:35:11.23,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:35:11.35,0:35:12.77,Default,,0,0,0,,Уф
Dialogue: 0,0:35:17.15,0:35:18.78,Default,,0,0,0,,Бұл ма? Иә
Dialogue: 0,0:35:19.28,0:35:22.78,Default,,0,0,0,,Мұрын тығындары болса да, иісі шамалы.
Dialogue: 0,0:35:22.95,0:35:26.41,Default,,0,0,0,,Аа, аздап сасық екені анық.
Dialogue: 0,0:35:26.54,0:35:27.41,Default,,0,0,0,,Кеш!
Dialogue: 0,0:35:27.70,0:35:29.87,Default,,0,0,0,,Демді көп тартпаған дұрыс.
Dialogue: 0,0:35:29.96,0:35:30.92,Default,,0,0,0,,Өйткені ол улы
Dialogue: 0,0:35:31.04,0:35:32.46,Default,,0,0,0,,Тез айт!
Dialogue: 0,0:35:35.04,0:35:35.92,Default,,0,0,0,,Уф
Dialogue: 0,0:35:36.05,0:35:40.22,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:35:40.72,0:35:44.89,Default,,0,0,0,,Мен Дафт Гриннің сыртына көп шықпауым керек десем де.
Dialogue: 0,0:35:45.01,0:35:49.39,Default,,0,0,0,,Өйткені мен әжеме көмектескім келді.
Dialogue: 0,0:35:49.64,0:35:52.02,Default,,0,0,0,,А-а-а... у-у-уф
Dialogue: 0,0:35:52.15,0:35:53.60,Default,,0,0,0,,Сяо...
Dialogue: 0,0:35:53.73,0:35:58.86,Default,,0,0,0,,Уф, өтінемін, мен үшін қауіпті ештеңе жасама.
Dialogue: 0,0:35:59.36,0:36:00.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:01.03,0:36:05.32,Default,,0,0,0,,Өйткені... солай қалдырсаңыз, сіз әжесіз!
Dialogue: 0,0:36:05.45,0:36:07.83,Default,,0,0,0,,(Сяо мен Сяоның анасының жылауы)
Dialogue: 0,0:36:07.95,0:36:11.25,Default,,0,0,0,,Балалар сендерге көп рахмет.
Dialogue: 0,0:36:11.62,0:36:13.96,Default,,0,0,0,,Мен сізге бір нәрсе үшін алғыс айтқым келеді...
Dialogue: 0,0:36:14.08,0:36:16.29,Default,,0,0,0,,Мен кездейсоқ өтіп бара жатырмын.
Dialogue: 0,0:36:16.42,0:36:19.71,Default,,0,0,0,,Дұрыс, мен біраз көмек алдым.
Dialogue: 0,0:36:19.84,0:36:22.43,Default,,0,0,0,,Бұл ауру туралы не деуге болады?
Dialogue: 0,0:36:23.05,0:36:24.76,Default,,0,0,0,,Мені Даф деп атаңыз.
Dialogue: 0,0:36:25.14,0:36:28.10,Default,,0,0,0,,Жасыл көгеру қатайып барады.
Dialogue: 0,0:36:28.22,0:36:30.14,Default,,0,0,0,,Қозғалысыңды тоқтататын ауру.
Dialogue: 0,0:36:31.35,0:36:35.31,Default,,0,0,0,,Егер сіз Daft Green бөлшектерінің көп мөлшерін дем алсаңыз, сіз...
Dialogue: 0,0:36:36.31,0:36:38.15,Default,,0,0,0,,Емдейтін жалғыз дәрі —
Dialogue: 0,0:36:38.27,0:36:42.07,Default,,0,0,0,,Ол IQ деп аталатын өсімдіктен жасалған.
Dialogue: 0,0:36:42.24,0:36:43.78,Default,,0,0,0,,Бір ғана дөңгелек емес...
Dialogue: 0,0:36:44.24,0:36:46.49,Default,,0,0,0,,Сондықтан мен ол жерде жалғыз қалдым...
Dialogue: 0,0:36:46.95,0:36:48.03,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:36:48.16,0:36:51.79,Default,,0,0,0,,А, бұл сенің кінәң емес.
Dialogue: 0,0:36:51.91,0:36:55.37,Default,,0,0,0,,Кінәлі - IQ-ны монополиялаған Шики.
Dialogue: 0,0:36:55.88,0:36:57.75,Default,,0,0,0,,Шики? Шики?
Dialogue: 0,0:36:58.21,0:37:02.63,Default,,0,0,0,,Осыдан 20 жыл бұрын адамдар мен өсімдіктер мен—
Dialogue: 0,0:37:02.76,0:37:06.22,Default,,0,0,0,,Олар сол жануарлармен жақсы өмір сүрді.
Dialogue: 0,0:37:06.34,0:37:09.39,Default,,0,0,0,,Оның бәрін жойды.
Dialogue: 0,0:37:09.51,0:37:12.10,Default,,0,0,0,,Мен олардың тезірек барғанын қалаймын, бұл балалар...
Dialogue: 0,0:37:12.23,0:37:13.89,Default,,0,0,0,,«Стратегия теңізіне»
Dialogue: 0,0:37:14.02,0:37:15.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:20.94,0:37:23.99,Default,,0,0,0,,Сіз мұны қандай да бір жолмен түзете алмайсыз ба?
Dialogue: 0,0:37:24.11,0:37:26.03,Default,,0,0,0,,Бұл мен бұрын соңды көрмеген жағдай.
Dialogue: 0,0:37:26.16,0:37:27.82,Default,,0,0,0,,Мен ештеңе істей алмаймын
Dialogue: 0,0:37:27.95,0:37:30.03,Default,,0,0,0,,Бірақ, егер сіз осында болсаңыз -
Dialogue: 0,0:37:30.16,0:37:33.75,Default,,0,0,0,,Сонымен, әзірге маған ол жануарлар шабуыл жасамайды ма?
Dialogue: 0,0:37:34.08,0:37:36.04,Default,,0,0,0,,Иә, әлі де осында...
Dialogue: 0,0:37:36.17,0:37:38.67,Default,,0,0,0,,Бұл Daft Green иісі сияқты, бірақ...
Dialogue: 0,0:37:38.79,0:37:41.96,Default,,0,0,0,,Осыны ойлап, мен аздап тежей аламын.
Dialogue: 0,0:37:42.55,0:37:45.63,Default,,0,0,0,,Бірақ мұндай жерде... бәрі аман бола ма?
Dialogue: 0,0:37:45.76,0:37:48.34,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:37:48.89,0:37:52.43,Default,,0,0,0,,Кішкене тынығып алғаннан кейін қайтадан ізденейік.
Dialogue: 0,0:37:53.81,0:37:54.77,Default,,0,0,0,,Иә
Dialogue: 0,0:37:55.81,0:37:58.19,Default,,0,0,0,,Менің де шаршадым.
Dialogue: 0,0:38:02.40,0:38:07.07,Default,,0,0,0,,Ах~ Бірдеңе дұрыс емес. Денем ауыр сезінеді.
Dialogue: 0,0:38:07.20,0:38:09.37,Default,,0,0,0,,Әрине сен
Dialogue: 0,0:38:09.49,0:38:13.16,Default,,0,0,0,,Мен соңғы аптада дұрыс ұйықтамадым.
Dialogue: 0,0:38:13.29,0:38:14.79,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:38:17.71,0:38:18.92,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:38:19.25,0:38:21.29,Default,,0,0,0,,Не болып жатыр? Не болып жатыр?
Dialogue: 0,0:38:21.79,0:38:22.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:23.42,0:38:25.26,Default,,0,0,0,,Санджи! Усоп!
Dialogue: 0,0:38:25.38,0:38:26.72,Default,,0,0,0,,Ооо... (Чоппер) Ахахха!
Dialogue: 0,0:38:40.77,0:38:42.02,Default,,0,0,0,,Куу
Dialogue: 0,0:39:23.11,0:39:27.07,Default,,0,0,0,,Барлық капитандар портқа келген сияқты.
Dialogue: 0,0:39:27.65,0:39:31.41,Default,,0,0,0,,Жарайды, жалпы жиналыс біте салысымен кетемін.
Dialogue: 0,0:39:32.07,0:39:33.41,Default,,0,0,0,,Ақырында бүгін түн болды ма?
Dialogue: 0,0:39:34.49,0:39:36.62,Default,,0,0,0,,Арал адамын қалаға қайтарыңыз
Dialogue: 0,0:39:36.95,0:39:38.79,Default,,0,0,0,,Не? Мен сені босатсам болады ма?
Dialogue: 0,0:39:39.87,0:39:41.92,Default,,0,0,0,,Өйткені бұл уәде
Dialogue: 0,0:39:42.42,0:39:44.67,Default,,0,0,0,,Бірақ тек бір адам
Dialogue: 0,0:39:45.71,0:39:49.05,Default,,0,0,0,,Үміт үзілсе, үміт сыйла.
Dialogue: 0,0:39:49.84,0:39:55.76,Default,,0,0,0,,Биік жерден құлаған адамның сызылған жүзі ерекше емес пе?
Dialogue: 0,0:39:55.89,0:39:58.72,Default,,0,0,0,,Жихахаха...
Dialogue: 0,0:39:58.85,0:40:00.23,Default,,0,0,0,,Хмм
Dialogue: 0,0:40:00.31,0:40:01.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:05.02,0:40:06.02,Default,,0,0,0,,Әй?
Dialogue: 0,0:40:06.27,0:40:08.57,Default,,0,0,0,,Шикидің бастығы! (Барлығы) Сіз сөйлескіңіз келе ме?
Dialogue: 0,0:40:08.69,0:40:12.49,Default,,0,0,0,,Бұл үлкен іс болды, қыз қашып кетті!
Dialogue: 0,0:40:14.12,0:40:15.49,Default,,0,0,0,,Не?
Dialogue: 0,0:40:15.66,0:40:16.74,Default,,0,0,0,,Корольдік бассейн —
Dialogue: 0,0:40:16.87,0:40:20.04,Default,,0,0,0,,Оның теңізге тікелей қосылғанын байқаған сияқты.
Dialogue: 0,0:40:21.87,0:40:25.54,Default,,0,0,0,,немқұрайлылық таныту және қиын алу қабілетін жіберіп алу.
Dialogue: 0,0:40:25.67,0:40:28.80,Default,,0,0,0,,Оны табу үшін бүкіл желіні толық пайдаланыңыз!
Dialogue: 0,0:40:28.92,0:40:29.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:40:31.92,0:40:35.26,Default,,0,0,0,,Пу ха ха ха...
Dialogue: 0,0:40:43.02,0:40:43.85,Default,,0,0,0,,Уф
Dialogue: 0,0:41:07.17,0:41:11.67,Default,,0,0,0,,Куаааааааааааааааааааааааааааа
Dialogue: 0,0:41:12.21,0:41:14.26,Default,,0,0,0,,Kur? Қалайсың?
Dialogue: 0,0:41:15.43,0:41:16.43,Default,,0,0,0,,(Поконың әкесі) Поко! Түннің осы уақытында қай жақта адасып жүрсің?
Dialogue: 0,0:41:16.64,0:41:19.60,Default,,0,0,0,,Гуарг Гуарг Гуарг
Dialogue: 0,0:41:22.68,0:41:26.65,Default,,0,0,0,,Гаа гаа гаа гаа…
Dialogue: 0,0:41:28.52,0:41:31.82,Default,,0,0,0,,Го-гу-гу
Dialogue: 0,0:41:33.24,0:41:34.61,Default,,0,0,0,,Мм... (Найзағай) Грррр!
Dialogue: 0,0:41:36.20,0:41:37.28,Default,,0,0,0,,Гуа... ауырады
Dialogue: 0,0:41:39.24,0:41:39.99,Default,,0,0,0,,Quat
Dialogue: 0,0:41:40.62,0:41:42.45,Default,,0,0,0,,Қазірдің өзінде (Thunderbird)
Dialogue: 0,0:41:42.87,0:41:43.66,Default,,0,0,0,,Тоқта
Dialogue: 0,0:41:43.79,0:41:45.62,Default,,0,0,0,,Quak Qua…
Dialogue: 0,0:41:46.04,0:41:46.87,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:41:48.04,0:41:50.84,Default,,0,0,0,,Иә, бірақ бұл маған көмектесті, рахмет.
Dialogue: 0,0:41:50.96,0:41:53.30,Default,,0,0,0,,Шапшаңдық
Dialogue: 0,0:41:53.42,0:41:55.93,Default,,0,0,0,,Әйтеуір, бұл қай жер?
Dialogue: 0,0:41:59.30,0:42:00.26,Default,,0,0,0,,Хмм
Dialogue: 0,0:42:01.47,0:42:05.48,Default,,0,0,0,,Гааааааааа
Dialogue: 0,0:42:10.48,0:42:11.15,Default,,0,0,0,,Ах
Dialogue: 0,0:42:14.49,0:42:16.86,Default,,0,0,0,,Күн шуақты! Ха ха...
Dialogue: 0,0:42:16.99,0:42:19.07,Default,,0,0,0,,Хаха...
Dialogue: 0,0:42:20.32,0:42:21.33,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:42:22.58,0:42:24.25,Default,,0,0,0,,Ах... уау
Dialogue: 0,0:42:24.70,0:42:28.12,Default,,0,0,0,,Хаха...
Dialogue: 0,0:42:28.25,0:42:29.71,Default,,0,0,0,,Әй, Күншуақ!
Dialogue: 0,0:42:30.08,0:42:30.83,Default,,0,0,0,,Луффи!
Dialogue: 0,0:42:31.13,0:42:33.46,Default,,0,0,0,,А? иә? иә? Хмм?
Dialogue: 0,0:42:33.59,0:42:35.88,Default,,0,0,0,,Әй, Нуми!
Dialogue: 0,0:42:36.88,0:42:39.84,Default,,0,0,0,,(Қара ағайындылар айқайлайды)
Dialogue: 0,0:42:39.97,0:42:40.89,Default,,0,0,0,,(Семіз арыстанның ақыруы)
Dialogue: 0,0:42:43.14,0:42:43.81,Default,,0,0,0,,Хе-хе-хе-хе. Міне, 1-курстың үшеуіміз ақыры бірге жиналдық
Dialogue: 0,0:42:44.18,0:42:48.19,Default,,0,0,0,,Сенің аман қалғаныңа және ол жігіттен қашып құтылғаныңа қуаныштымын.
Dialogue: 0,0:42:48.39,0:42:49.85,Default,,0,0,0,,Мұнда келме!
Dialogue: 0,0:42:49.98,0:42:52.19,Default,,0,0,0,,Ха ха ха... хехе хе
Dialogue: 0,0:42:57.44,0:42:58.11,Default,,0,0,0,,Әй?
Dialogue: 0,0:42:58.53,0:43:01.28,Default,,0,0,0,,Салқын
Dialogue: 0,0:43:02.83,0:43:05.87,Default,,0,0,0,,Уау хо хо хо
Dialogue: 0,0:43:06.33,0:43:07.16,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:43:11.67,0:43:13.00,Default,,0,0,0,,Барлығы ше?
Dialogue: 0,0:43:13.13,0:43:16.67,Default,,0,0,0,,Содан бері ешкімді көрмедім. Бұл үлкен жер.
Dialogue: 0,0:43:16.80,0:43:19.93,Default,,0,0,0,,Намиді бірінші рет кездестіремін деп ойламаппын.
Dialogue: 0,0:43:20.30,0:43:23.18,Default,,0,0,0,,Жеп ал, мына шаян дәмді!
Dialogue: 0,0:43:23.30,0:43:24.26,Default,,0,0,0,,Билли
Dialogue: 0,0:43:24.39,0:43:25.47,Default,,0,0,0,,Салқын
Dialogue: 0,0:43:25.76,0:43:29.06,Default,,0,0,0,,Жоқ рахмет? Билли деген кім?
Dialogue: 0,0:43:29.31,0:43:31.27,Default,,0,0,0,,Бұл жігіт. Бұл таң қалдырады, солай ма?
Dialogue: 0,0:43:31.40,0:43:32.73,Default,,0,0,0,,Guar
Dialogue: 0,0:43:33.52,0:43:35.48,Default,,0,0,0,,Не? (Билли) Ква
Dialogue: 0,0:43:35.94,0:43:40.70,Default,,0,0,0,,Түсінемін, ол резеңке адам болғандықтан, оған электр тогы жұмыс істемейді.
Dialogue: 0,0:43:45.41,0:43:49.16,Default,,0,0,0,,Енді біз Күншуақтың қай жерде болуы мүмкін екенін білеміз.
Dialogue: 0,0:43:49.29,0:43:52.00,Default,,0,0,0,,Барлығын күтесіз бе? Немесе іздеу керек пе?
Dialogue: 0,0:43:52.12,0:43:53.75,Default,,0,0,0,,Іздеу!
Dialogue: 0,0:43:57.84,0:44:00.92,Default,,0,0,0,,Бұл шаян керемет.
Dialogue: 0,0:44:01.09,0:44:04.85,Default,,0,0,0,,О! Бұл мен жасаған арнайы дизайн.
Dialogue: 0,0:44:04.97,0:44:06.72,Default,,0,0,0,,Маған Зари Дэвидсон деп қоңырау шалыңыз
Dialogue: 0,0:44:06.85,0:44:07.56,Default,,0,0,0,,Иә
Dialogue: 0,0:44:07.68,0:44:10.73,Default,,0,0,0,,♪ Зари Дэвидсон Зари Дэвидсон
Dialogue: 0,0:44:10.85,0:44:13.06,Default,,0,0,0,,♪ Ла ла ла ~ ла ~ ла ~ ла ла...
Dialogue: 0,0:44:13.27,0:44:14.19,Default,,0,0,0,,О? Ах...
Dialogue: 0,0:44:14.31,0:44:15.52,Default,,0,0,0,,Мен бір нәрсені көріп тұрмын.
Dialogue: 0,0:44:15.86,0:44:17.44,Default,,0,0,0,,Қала? Бұл дұрыс
Dialogue: 0,0:44:18.40,0:44:19.69,Default,,0,0,0,,Уа, уау, ау!
Dialogue: 0,0:44:19.82,0:44:21.99,Default,,0,0,0,,Уаа~
Dialogue: 0,0:44:22.11,0:44:23.99,Default,,0,0,0,,(Фрэнкидің айқайы)
Dialogue: 0,0:44:24.11,0:44:27.28,Default,,0,0,0,,А, мен тілімді тістеп алдым. Әй, менің тілім жоқ.
Dialogue: 0,0:44:27.41,0:44:30.25,Default,,0,0,0,,Мен саған артқа секірме дедім!
Dialogue: 0,0:44:30.37,0:44:31.87,Default,,0,0,0,,Мен қалтырап тұрмын
Dialogue: 0,0:44:32.08,0:44:34.33,Default,,0,0,0,,Жоқ, мен сені тыңдамаймын.
Dialogue: 0,0:44:34.46,0:44:37.21,Default,,0,0,0,,Цк, біз жүреміз бе?
Dialogue: 0,0:44:42.55,0:44:43.43,Default,,0,0,0,,Батырдың аты: Ол Майт
Dialogue: 0,0:44:43.55,0:44:45.93,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа бірге...
Dialogue: 0,0:44:46.05,0:44:47.51,Default,,0,0,0,,Иә? ше?
Dialogue: 0,0:44:47.85,0:44:50.47,Default,,0,0,0,,(Намидің айқайы)
Dialogue: 0,0:44:51.81,0:44:55.81,Default,,0,0,0,,Қуа… Қуа… Қуа…
Dialogue: 0,0:44:58.36,0:45:00.73,Default,,0,0,0,,Иә? Ауыл ғой
Dialogue: 0,0:45:04.49,0:45:07.95,Default,,0,0,0,,Бұл Шикидегі патша сарайының айналасында болған ағаш.
Dialogue: 0,0:45:08.08,0:45:10.58,Default,,0,0,0,,Мүмкін сізге бұл иіс ұнамайды.
Dialogue: 0,0:45:10.70,0:45:12.41,Default,,0,0,0,,Куу... Солай ма?
Dialogue: 0,0:45:12.54,0:45:13.87,Default,,0,0,0,,Куу
Dialogue: 0,0:45:14.16,0:45:16.67,Default,,0,0,0,,Куку ква ква…
Dialogue: 0,0:45:17.00,0:45:20.42,Default,,0,0,0,,Тек сол ағаштармен қоршалған аймақ болса керек.
Dialogue: 0,0:45:20.55,0:45:23.17,Default,,0,0,0,,Жануарлар келмейтін қауіпсіз аймақ.
Dialogue: 0,0:45:23.30,0:45:26.30,Default,,0,0,0,,Сонда бәрі осында болуы мүмкін.
Dialogue: 0,0:45:29.14,0:45:31.31,Default,,0,0,0,,Аман болғаныңызға қуаныштымын, Нами-сан!
Dialogue: 0,0:45:31.89,0:45:36.40,Default,,0,0,0,,Мен осы өткен аптада жақсы ұйықтай алмадым және мен уайымдадым.
Dialogue: 0,0:45:36.52,0:45:38.98,Default,,0,0,0,,
Dialogue: 0,0:45:39.11,0:45:42.15,Default,,0,0,0,,Бұл жігіт ұйықтамай жатыр.
Dialogue: 0,0:45:42.28,0:45:44.32,Default,,0,0,0,,Әй, Робин әлі осында!
Dialogue: 0,0:45:44.45,0:45:46.24,Default,,0,0,0,,Бұл өте шулы!
Dialogue: 0,0:45:46.36,0:45:47.07,Default,,0,0,0,,Әй?
Dialogue: 0,0:45:47.49,0:45:50.62,Default,,0,0,0,,Қалай болғанда да, сендер аман-есен болғандарыңа қуаныштымын.
Dialogue: 0,0:45:50.87,0:45:52.70,Default,,0,0,0,,Ку… Қуа
Dialogue: 0,0:45:52.83,0:45:55.50,Default,,0,0,0,,Иә? Көбейіп барады...
Dialogue: 0,0:45:55.62,0:45:59.17,Default,,0,0,0,,Әй, біз білмей тұрып үлкен отбасы болдық.
Dialogue: 0,0:45:59.63,0:46:02.05,Default,,0,0,0,,Қарсы болмасаңыз, іште демалғыңыз келе ме?
Dialogue: 0,0:46:02.17,0:46:04.26,Default,,0,0,0,,Нами, маған демалуға рұқсат етіңіз.
Dialogue: 0,0:46:04.38,0:46:06.13,Default,,0,0,0,,Не? Иә...
Dialogue: 0,0:46:06.47,0:46:10.39,Default,,0,0,0,,Оян, Сяо, көрші үйге барып, шай жапырақтарын ал.
Dialogue: 0,0:46:10.51,0:46:11.81,Default,,0,0,0,,Иә
Dialogue: 0,0:46:14.89,0:46:16.69,Default,,0,0,0,,Мен сонда болдым, Шикі-сама.
Dialogue: 0,0:46:16.81,0:46:17.77,Default,,0,0,0,,О
Dialogue: 0,0:46:18.10,0:46:22.32,Default,,0,0,0,,Сіз біздің навигаторды алып кетесіз бе?
Dialogue: 0,0:46:22.44,0:46:25.11,Default,,0,0,0,,Жихахаха...
Dialogue: 0,0:46:28.45,0:46:32.45,Default,,0,0,0,,(Қарақшылардың шуы)
Dialogue: 0,0:46:41.25,0:46:43.38,Default,,0,0,0,,Бұл жігіттер жақсы емес.
Dialogue: 0,0:46:43.55,0:46:48.18,Default,,0,0,0,,Сіз шынымен де сонша қарақшыларды жинап, соғыс ашқыңыз келе ме?
Dialogue: 0,0:46:48.18,0:46:48.43,Default,,0,0,0,,Сіз шынымен де сонша қарақшыларды жинап, соғыс ашқыңыз келе ме?
Dialogue: 0,0:46:48.18,0:46:48.43,Default,,0,0,0,,Ах~
Dialogue: 0,0:46:48.43,0:46:48.72,Default,,0,0,0,,Ах~
Dialogue: 0,0:46:48.72,0:46:51.60,Default,,0,0,0,,Мен барлығы Мәңгілік позаны ұстап тұрғанын көргенде...
Dialogue: 0,0:46:48.72,0:46:51.60,Default,,0,0,0,,Ах~
Dialogue: 0,0:46:51.60,0:46:51.72,Default,,0,0,0,,Ах~
Dialogue: 0,0:46:51.72,0:46:54.97,Default,,0,0,0,,Сізге біреу басшылық жасады деп ойлау орынды.
Dialogue: 0,0:46:51.72,0:46:54.97,Default,,0,0,0,,Ах~
Dialogue: 0,0:46:54.97,0:46:55.06,Default,,0,0,0,,Сізге біреу басшылық жасады деп ойлау орынды.
Dialogue: 0,0:46:55.18,0:46:56.27,Default,,0,0,0,,
Dialogue: 0,0:46:56.68,0:46:57.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:58.69,0:47:00.52,Default,,0,0,0,,Барлығын ескерсек, біз үшеу болып өмір сүруге үйрене бастадық.
Dialogue: 0,0:47:00.65,0:47:04.40,Default,,0,0,0,,Шалбарыңызды көре аламын ба?
Dialogue: 0,0:47:04.78,0:47:05.73,Default,,0,0,0,,Гува (Әрдайым) Маған көрсет!
Dialogue: 0,0:47:05.86,0:47:07.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:07.24,0:47:09.24,Default,,0,0,0,,Әй, сен, мына қолдар...
Dialogue: 0,0:47:09.36,0:47:11.82,Default,,0,0,0,,Не? о мынау
Dialogue: 0,0:47:11.99,0:47:15.04,Default,,0,0,0,,Менің ойымша, біз құс болғымыз келеді.
Dialogue: 0,0:47:15.29,0:47:18.96,Default,,0,0,0,,Құс? Сіз болуға тырыссаңыз да, мұндай нәрсеге айналу мүмкін бе?
Dialogue: 0,0:47:19.46,0:47:21.83,Default,,0,0,0,,Уау мына шалбар...
Dialogue: 0,0:47:21.96,0:47:22.96,Default,,0,0,0,,Уф
Dialogue: 0,0:47:24.38,0:47:26.76,Default,,0,0,0,,Балалар, сендер Straw Hat адамдарсыңдар, солай ма?
Dialogue: 0,0:47:26.88,0:47:27.63,Default,,0,0,0,,Польнарефф, бірдеңе болды ма?
Dialogue: 0,0:47:27.92,0:47:32.34,Default,,0,0,0,,Сіз де Шикидің бастығымен бауырластық кесеін айырбастауыңыз керек.
Dialogue: 0,0:47:32.68,0:47:33.55,Default,,0,0,0,,О? Иә—
Dialogue: 0,0:47:33.68,0:47:35.10,Default,,0,0,0,,Менің ойым осы. (Фрэнки) О?
Dialogue: 0,0:47:35.51,0:47:40.19,Default,,0,0,0,,Неліктен Шикидің бастығында қарақшылар көп болды?
Dialogue: 0,0:47:40.31,0:47:44.19,Default,,0,0,0,,«Неге?» Ақымақ болма.
Dialogue: 0,0:47:44.31,0:47:46.73,Default,,0,0,0,,Газетті көрдің бе? Бұл
Dialogue: 0,0:47:47.07,0:47:48.90,Default,,0,0,0,,О? Яғни...
Dialogue: 0,0:47:49.07,0:47:50.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:50.57,0:47:54.58,Default,,0,0,0,,Хаха...
Dialogue: 0,0:47:55.20,0:47:57.16,Default,,0,0,0,,Хаха...
Dialogue: 0,0:48:00.46,0:48:01.83,Default,,0,0,0,,Ха-ха...
Dialogue: 0,0:48:01.96,0:48:04.13,Default,,0,0,0,,Әже! ана! Үлкен жаңалық!
Dialogue: 0,0:48:12.59,0:48:13.64,Default,,0,0,0,,Не?
Dialogue: 0,0:48:13.84,0:48:15.01,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:48:15.14,0:48:17.68,Default,,0,0,0,,Шу-чан мен мына әке қайтып келді.
Dialogue: 0,0:48:17.89,0:48:20.02,Default,,0,0,0,,Барлығы жақында оралады.
Dialogue: 0,0:48:20.14,0:48:22.31,Default,,0,0,0,,Әкем мен әпкемді тағы көремін.
Dialogue: 0,0:48:22.77,0:48:26.65,Default,,0,0,0,,Бұл рас па? Бұл арман емес, солай ма?
Dialogue: 0,0:48:26.77,0:48:28.03,Default,,0,0,0,,Яғни...
Dialogue: 0,0:48:28.15,0:48:31.03,Default,,0,0,0,,Дұрыс, Шики осы жерден кетіп бара жатыр.
Dialogue: 0,0:48:31.15,0:48:33.66,Default,,0,0,0,,Жануарларды өзіңізбен бірге стратегия теңізіне апарыңыз
Dialogue: 0,0:48:34.11,0:48:35.62,Default,,0,0,0,,Шығыс теңізге (Шығыс көк)!
Dialogue: 0,0:48:46.79,0:48:48.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:48.34,0:48:49.76,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:48:50.26,0:48:52.17,Default,,0,0,0,,Шығыс теңізі (Шығыс көгілдір) сіздің туған қалаңыз ба?
Dialogue: 0,0:48:52.38,0:48:53.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:54.01,0:48:56.51,Default,,0,0,0,,Сіз менің мақсатымды ақырында түсінесіз.
Dialogue: 0,0:48:57.05,0:48:58.89,Default,,0,0,0,,Не істесең де, сенен...
Dialogue: 0,0:48:59.01,0:49:03.39,Default,,0,0,0,,Сіз маған қосылуымды өтіне бастайсыз.
Dialogue: 0,0:49:03.73,0:49:07.98,Default,,0,0,0,,Менің кемемнің штурманы бол, балақай.
Dialogue: 0,0:49:08.27,0:49:12.36,Default,,0,0,0,,Егер сіз дос болсаңыз, сұрай аласыз. Менен сұрайтын нәрсе жоқ па?
Dialogue: 0,0:49:12.65,0:49:14.32,Default,,0,0,0,,Джихахахаха...
Dialogue: 0,0:49:14.32,0:49:15.53,Default,,0,0,0,,Джихахахаха...
Dialogue: 0,0:49:14.32,0:49:15.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:15.53,0:49:16.03,Default,,0,0,0,,Джихахахаха...
Dialogue: 0,0:49:16.45,0:49:19.87,Default,,0,0,0,,Мұнда келіп, өмір сүруге үміт арту үшін...
Dialogue: 0,0:49:19.99,0:49:22.25,Default,,0,0,0,,Бұл арман сияқты
Dialogue: 0,0:49:22.41,0:49:28.00,Default,,0,0,0,,Бір минут немесе секунд болса да тезірек Шығыс теңізіне (Шығыс көк) барғаныңызды қалаймын.
Dialogue: 0,0:49:29.17,0:49:30.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:49:35.72,0:49:38.30,Default,,0,0,0,,Ах Луффи
Dialogue: 0,0:49:40.68,0:49:42.02,Default,,0,0,0,,Иә—
Dialogue: 0,0:49:42.31,0:49:47.69,Default,,0,0,0,,Сәлем, әлем үкіметі, флотқа ескерту.
Dialogue: 0,0:49:48.06,0:49:51.94,Default,,0,0,0,,Басқаша айтқанда, Шики бастығының мақсаты...
Dialogue: 0,0:49:52.23,0:49:54.28,Default,,0,0,0,,Шығыс теңізінің жойылуы (Шығыс көк)
Dialogue: 0,0:49:54.36,0:49:56.24,Default,,0,0,0,,Ал дүние құлады
Dialogue: 0,0:49:56.49,0:49:58.53,Default,,0,0,0,,Бүгінгі кешкі жалпы жиналыстан кейін
Dialogue: 0,0:49:58.66,0:50:03.45,Default,,0,0,0,,Олар сол жануарларды шығыс теңізге (Шығыс көк) жіберіп жатқан сияқты.
Dialogue: 0,0:50:03.58,0:50:05.37,Default,,0,0,0,,Олай етпе...
Dialogue: 0,0:50:05.50,0:50:08.04,Default,,0,0,0,,Адамдардың керемет саны өледі
Dialogue: 0,0:50:08.17,0:50:12.88,Default,,0,0,0,,Уайымдамаңыз, бұл Дүниежүзілік үкіметті берілуге мәжбүрлеу.
Dialogue: 0,0:50:13.00,0:50:16.01,Default,,0,0,0,,Бізді бір керемет адам шақырды.
Dialogue: 0,0:50:16.13,0:50:19.93,Default,,0,0,0,,Мүлде жоқ. Қайтадан сәлем!
Dialogue: 0,0:50:20.05,0:50:22.81,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:50:23.14,0:50:24.56,Default,,0,0,0,,О, балалар
Dialogue: 0,0:50:24.68,0:50:27.89,Default,,0,0,0,,Жалпы жиналысқа осылай қатысамын деп ойламаңыз.
Dialogue: 0,0:50:28.19,0:50:29.98,Default,,0,0,0,,Нақты шешім қабылдаңыз
Dialogue: 0,0:50:30.11,0:50:32.82,Default,,0,0,0,,Киім үлгісі, түсінемін.
Dialogue: 0,0:50:33.32,0:50:35.86,Default,,0,0,0,,Бүгін түнде бәрі.
Dialogue: 0,0:50:35.99,0:50:39.36,Default,,0,0,0,,Ол маған демонстрация көрсетемін деді.
Dialogue: 0,0:50:39.91,0:50:41.32,Default,,0,0,0,,Демонстрация?
Dialogue: 0,0:50:41.78,0:50:47.12,Default,,0,0,0,,Әй, бұл аралдағы жалғыз ауылды қиратамыз деді.
Dialogue: 0,0:50:47.25,0:50:49.08,Default,,0,0,0,,Бұл мені тоңазытады.
Dialogue: 0,0:50:49.21,0:50:50.88,Default,,0,0,0,,(Китажима және басқалардың күлкісі)
Dialogue: 0,0:50:51.00,0:50:54.00,Default,,0,0,0,,Осындай аралда адамдар тұратын ауыл бар...
Dialogue: 0,0:50:59.72,0:51:01.09,Default,,0,0,0,,Луффи?
Dialogue: 0,0:51:02.18,0:51:03.93,Default,,0,0,0,,Келме! Нами ха
Dialogue: 0,0:51:11.10,0:51:12.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:18.03,0:51:21.41,Default,,0,0,0,,Балақай, қарашы!
Dialogue: 0,0:51:21.82,0:51:22.66,Default,,0,0,0,,Шики
Dialogue: 0,0:51:23.37,0:51:26.91,Default,,0,0,0,,Жалықпайсың ба, балақай?
Dialogue: 0,0:51:27.20,0:51:31.58,Default,,0,0,0,,Сенің жай ғана тайып тұрғаның маған ауыр тиді.
Dialogue: 0,0:51:32.00,0:51:33.84,Default,,0,0,0,,Үніңді жап, бейбақ.
Dialogue: 0,0:51:33.96,0:51:36.84,Default,,0,0,0,,Сен бізді алдап Намиді алып кеттің.
Dialogue: 0,0:51:37.09,0:51:39.13,Default,,0,0,0,,Жихахаха...
Dialogue: 0,0:51:39.26,0:51:43.89,Default,,0,0,0,,Мұндай жақсы әйелді алып кетпеу қисынсыз болар еді.
Dialogue: 0,0:51:44.14,0:51:44.64,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:51:44.64,0:51:45.60,Default,,0,0,0,,Егер ұрланғанын қаламасаңыз, оны қорғаңыз!
Dialogue: 0,0:51:44.64,0:51:45.60,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:51:45.60,0:51:47.27,Default,,0,0,0,,Тонағыңыз келмесе, өзіңізді қорғаңыз!
Dialogue: 0,0:51:47.47,0:51:49.81,Default,,0,0,0,,Алайда әйел...
Dialogue: 0,0:51:49.94,0:51:54.19,Default,,0,0,0,,Менің ойымша, сен енді мені тастап кете алмайсың.
Dialogue: 0,0:51:54.31,0:51:55.94,Default,,0,0,0,,Уф, солай емес пе?
Dialogue: 0,0:51:56.07,0:51:58.19,Default,,0,0,0,,Baby-chan
Dialogue: 0,0:51:58.44,0:52:00.20,Default,,0,0,0,,Теме...
Dialogue: 0,0:52:00.32,0:52:02.24,Default,,0,0,0,,Әй, руль! Уф
Dialogue: 0,0:52:05.33,0:52:09.04,Default,,0,0,0,,Менің достарыма көмектесіп, қауіпсіз бола аламын деп ойламаңыз.
Dialogue: 0,0:52:09.41,0:52:12.00,Default,,0,0,0,,О? Сіз не істемексіз?
Dialogue: 0,0:52:12.17,0:52:13.21,Default,,0,0,0,,Мені ұр!
Dialogue: 0,0:52:13.42,0:52:14.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:14.92,0:52:15.59,Default,,0,0,0,,Луффи!
Dialogue: 0,0:52:15.96,0:52:18.09,Default,,0,0,0,,Жихахаха...
Dialogue: 0,0:52:18.21,0:52:21.55,Default,,0,0,0,,Мені ұра алсаң, ұр! Хахаха...
Dialogue: 0,0:52:22.93,0:52:25.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:25.93,0:52:29.39,Default,,0,0,0,,Иә? Сағыз орағы!
Dialogue: 0,0:52:29.89,0:52:33.44,Default,,0,0,0,,Уф, өлімге әкелетін Феникс жұлдызы!
Dialogue: 0,0:52:36.48,0:52:37.19,Default,,0,0,0,,Уф
Dialogue: 0,0:52:37.36,0:52:39.90,Default,,0,0,0,,Жердегі жетпіс екі тілек!
Dialogue: 0,0:52:40.28,0:52:41.99,Default,,0,0,0,,Ха ха
Dialogue: 0,0:52:42.11,0:52:43.61,Default,,0,0,0,,Қол күшін арттыру (қол нүктесі)
Dialogue: 0,0:52:44.36,0:52:47.58,Default,,0,0,0,,Туралған тұяқ шие гүлі Фубуки (Кокутей Розео Мичиери)!
Dialogue: 0,0:52:49.41,0:52:50.41,Default,,0,0,0,,Уф
Dialogue: 0,0:52:50.62,0:52:51.50,Default,,0,0,0,,Уф
Dialogue: 0,0:52:51.79,0:52:53.92,Default,,0,0,0,,Емшек еті (поитрин) ату!
Dialogue: 0,0:52:54.08,0:52:54.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:52:55.67,0:52:57.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:52:59.38,0:53:01.97,Default,,0,0,0,,Бұл өте жақсы команда.
Dialogue: 0,0:53:02.09,0:53:05.68,Default,,0,0,0,,Маған араласуға рұқсат беру үлкен мәселе емес пе?
Dialogue: 0,0:53:06.55,0:53:11.14,Default,,0,0,0,,Бірақ мен қолымды тарта алмаймын.
Dialogue: 0,0:53:11.60,0:53:13.02,Default,,0,0,0,,Хаха...
Dialogue: 0,0:53:14.60,0:53:16.06,Default,,0,0,0,,Санджи! Ахх
Dialogue: 0,0:53:16.19,0:53:17.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:53:17.94,0:53:18.86,Default,,0,0,0,,Әй?
Dialogue: 0,0:53:22.15,0:53:23.45,Default,,0,0,0,,Ол сізден басталады.
Dialogue: 0,0:53:23.70,0:53:24.95,Default,,0,0,0,,Хахаха... Қарғыс атсын...
Dialogue: 0,0:53:25.36,0:53:26.62,Default,,0,0,0,,Санджи!
Dialogue: 0,0:53:27.24,0:53:29.62,Default,,0,0,0,,Зымыран!
Dialogue: 0,0:53:29.95,0:53:31.54,Default,,0,0,0,,Уау
Dialogue: 0,0:53:32.00,0:53:33.54,Default,,0,0,0,,Ах (Усақтаушы) Ха!
Dialogue: 0,0:53:35.46,0:53:36.75,Default,,0,0,0,,Уф
Dialogue: 0,0:53:37.21,0:53:39.59,Default,,0,0,0,,А? Сіз бірдеңе туралы айттыңыз ба?
Dialogue: 0,0:53:39.71,0:53:41.05,Default,,0,0,0,,бөлек
Dialogue: 0,0:53:41.59,0:53:43.01,Default,,0,0,0,,Хмммммммммммммммммммммммммммммммммммммммммммммм.
Dialogue: 0,0:53:46.01,0:53:48.97,Default,,0,0,0,,Уф ха ха... (Чоппер) Ха ха...
Dialogue: 0,0:53:52.56,0:53:55.89,Default,,0,0,0,,Сіз менімен тең дәрежеде бәсекелесе аласыз деп ойлайсыз ба?
Dialogue: 0,0:53:56.23,0:53:59.19,Default,,0,0,0,,Бұл қиыншылық. Мен олардың барлығымен бірден айналысамын.
Dialogue: 0,0:54:01.94,0:54:03.15,Default,,0,0,0,,Сіз бірдеңе істеуді жоспарлап отырсыз ба?
Dialogue: 0,0:54:07.99,0:54:08.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:09.82,0:54:10.91,Default,,0,0,0,,Ооо
Dialogue: 0,0:54:11.79,0:54:13.08,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:54:16.92,0:54:18.04,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:54:23.51,0:54:25.76,Default,,0,0,0,,...
Dialogue: 0,0:54:26.42,0:54:29.18,Default,,0,0,0,,Шишииши Джимаки!
Dialogue: 0,0:54:29.43,0:54:30.47,Default,,0,0,0,,Тайтер айтты
Dialogue: 0,0:54:30.60,0:54:34.18,Default,,0,0,0,,(Арыстандардың ұнтағы)
Dialogue: 0,0:54:34.31,0:54:35.18,Default,,0,0,0,,Енді...
Dialogue: 0,0:54:35.31,0:54:36.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:54:36.64,0:54:39.48,Default,,0,0,0,,(Арыстан дорбасы)
Dialogue: 0,0:54:39.77,0:54:40.98,Default,,0,0,0,,Уф
Dialogue: 0,0:54:42.57,0:54:45.11,Default,,0,0,0,,Сағыз резеңке —
Dialogue: 0,0:54:45.61,0:54:46.82,Default,,0,0,0,,Қоршау зеңбірегі!
Dialogue: 0,0:54:49.78,0:54:51.03,Default,,0,0,0,,Ой
Dialogue: 0,0:54:52.83,0:54:54.66,Default,,0,0,0,,Аспаз! а?
Dialogue: 0,0:55:00.46,0:55:03.71,Default,,0,0,0,,Әуе күштері (Arme de Rail) күшті атыс!
Dialogue: 0,0:55:03.84,0:55:07.34,Default,,0,0,0,,Өлімге әкелетін атлас комета!
Dialogue: 0,0:55:07.92,0:55:09.84,Default,,0,0,0,,Жақсы мақсат, бірақ жақсы емес.
Dialogue: 0,0:55:11.80,0:55:15.10,Default,,0,0,0,,Үш қылыш стилі Ушиони Юклав
Dialogue: 0,0:55:15.22,0:55:15.89,Default,,0,0,0,,Уф
Dialogue: 0,0:55:16.02,0:55:18.56,Default,,0,0,0,,Балалар, сендерді өлтіруге тұрарлық емессіңдер.
Dialogue: 0,0:55:18.98,0:55:21.31,Default,,0,0,0,,Ой, ау, Зоро!
Dialogue: 0,0:55:22.86,0:55:24.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:55:24.15,0:55:25.65,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:55:26.40,0:55:28.70,Default,,0,0,0,,Уф (арыстандар айқайлайды)
Dialogue: 0,0:55:28.82,0:55:29.95,Default,,0,0,0,,Беріліс…
Dialogue: 0,0:55:30.03,0:55:31.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:55:35.24,0:55:36.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:55:37.04,0:55:38.37,Default,,0,0,0,,Ха Луффи!
Dialogue: 0,0:55:48.67,0:55:49.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:55:55.14,0:55:55.81,Default,,0,0,0,,Ах
Dialogue: 0,0:55:58.48,0:56:02.77,Default,,0,0,0,,Уф ха ха...
Dialogue: 0,0:56:13.95,0:56:15.45,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:56:15.99,0:56:20.41,Default,,0,0,0,,Джихахха мен сені біраз уақытқа жерге ұйықтатамын.
Dialogue: 0,0:56:20.54,0:56:22.08,Default,,0,0,0,,А... а...
Dialogue: 0,0:56:22.21,0:56:24.63,Default,,0,0,0,,Мен бұл түсінбеген жігітпен мүлде қиналдым.
Dialogue: 0,0:56:25.88,0:56:28.21,Default,,0,0,0,,Сіз бәрін түсіндіңіз...
Dialogue: 0,0:56:28.34,0:56:31.80,Default,,0,0,0,,Маған келгіңіз келсе де.
Dialogue: 0,0:56:33.01,0:56:34.59,Default,,0,0,0,,Эй, жоқ па?
Dialogue: 0,0:56:37.43,0:56:39.27,Default,,0,0,0,,Шығыс теңізі де (Шығыс көк)—
Dialogue: 0,0:56:39.85,0:56:41.56,Default,,0,0,0,,Бұл сіздің әрекетіңіз болды.
Dialogue: 0,0:56:42.10,0:56:43.48,Default,,0,0,0,,Иә
Dialogue: 0,0:56:46.48,0:56:48.23,Default,,0,0,0,,Артық емес—
Dialogue: 0,0:56:48.90,0:56:52.11,Default,,0,0,0,,Достарыңызбен немесе Шығыс теңізімен (Шығыс көк) енді араласпаңыз!
Dialogue: 0,0:56:53.74,0:56:57.53,Default,,0,0,0,,Мен сізге бұйрықтың кері кеткенін айттым.
Dialogue: 0,0:56:57.66,0:57:00.37,Default,,0,0,0,,«Егер дос болсаң, менің бір жақсылығым бар».
Dialogue: 0,0:57:00.75,0:57:02.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:57:02.54,0:57:06.08,Default,,0,0,0,,Маған жалғыз қауіп – сол циклон.
Dialogue: 0,0:57:06.67,0:57:09.75,Default,,0,0,0,,Бізге жақсы навигатор керек...
Dialogue: 0,0:57:09.88,0:57:12.67,Default,,0,0,0,,Сіз де жақсырақ білуіңіз керек.
Dialogue: 0,0:57:15.97,0:57:17.35,Default,,0,0,0,,Ух... а
Dialogue: 0,0:57:19.64,0:57:21.02,Default,,0,0,0,,Бұл естелік пе?
Dialogue: 0,0:57:21.14,0:57:22.68,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:57:22.93,0:57:26.48,Default,,0,0,0,,Бұл менің туған жерімде ажырасқан ағамның маған берген сақинасы.
Dialogue: 0,0:57:32.19,0:57:34.99,Default,,0,0,0,,Егер мен сенің досың болсам—
Dialogue: 0,0:57:35.41,0:57:37.53,Default,,0,0,0,,Сіз Шығыс көкке көмектесесіз бе?
Dialogue: 0,0:57:37.66,0:57:39.49,Default,,0,0,0,,Жихахаха...
Dialogue: 0,0:57:39.62,0:57:44.75,Default,,0,0,0,,Жарайды, мен достарын бәрінен де жоғары қоятын адаммын.
Dialogue: 0,0:57:45.21,0:57:49.34,Default,,0,0,0,,Досымның туған жері болса, қолым тимес еді.
Dialogue: 0,0:57:52.09,0:57:54.13,Default,,0,0,0,,Ақылсыз ойлауды доғар, Нами.
Dialogue: 0,0:57:54.13,0:57:54.97,Default,,0,0,0,,Ақылсыз ойлауды доғар, Нами.
Dialogue: 0,0:57:54.13,0:57:54.97,Default,,0,0,0,,Га
Dialogue: 0,0:57:55.26,0:57:56.89,Default,,0,0,0,,Ха ха ха... Усопп!
Dialogue: 0,0:57:57.51,0:57:59.18,Default,,0,0,0,,Ол әлі есінде болды ма?
Dialogue: 0,0:57:59.30,0:58:03.56,Default,,0,0,0,,Ей, сен туған жерің үшін өзіңді ол жігітке сатпайсың.
Dialogue: 0,0:58:03.81,0:58:04.64,Default,,0,0,0,,Уф
Dialogue: 0,0:58:05.14,0:58:07.10,Default,,0,0,0,,Мұндай өзімшіл нәрсе, иә?
Dialogue: 0,0:58:07.73,0:58:10.23,Default,,0,0,0,,Луффи мені кешірмейді!
Dialogue: 0,0:58:10.77,0:58:14.19,Default,,0,0,0,,«Кешірмеу» нені білдіреді? бала
Dialogue: 0,0:58:15.15,0:58:19.53,Default,,0,0,0,,Эй, сен жағдайды толық түсіне алмайтын сияқтысың!
Dialogue: 0,0:58:22.24,0:58:25.58,Default,,0,0,0,,Ха, күте тұрыңыз! Мен жағдайды түсінемін!
Dialogue: 0,0:58:25.71,0:58:27.12,Default,,0,0,0,,Енді менің достарыммен араласпа!
Dialogue: 0,0:58:28.17,0:58:31.21,Default,,0,0,0,,Хехе, онда жауабын тыңдайық.
Dialogue: 0,0:58:31.50,0:58:34.05,Default,,0,0,0,,Иә? Бала-чан
Dialogue: 0,0:58:35.26,0:58:39.01,Default,,0,0,0,,Усоп, бұл жалғыз жол.
Dialogue: 0,0:58:40.18,0:58:42.89,Default,,0,0,0,,Мен Шығыс теңізді қорғаймын (Шығыс көк)
Dialogue: 0,0:58:43.10,0:58:43.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:58:44.27,0:58:46.64,Default,,0,0,0,,Ендеше, саяхатыңызды жан тыныштығымен жалғастырыңыз.
Dialogue: 0,0:58:46.77,0:58:47.64,Default,,0,0,0,,Жоқ, Нами
Dialogue: 0,0:58:47.77,0:58:49.40,Default,,0,0,0,,Менде бәрі жақсы. Тоқта!
Dialogue: 0,0:58:49.52,0:58:51.36,Default,,0,0,0,,Сіз кез келген жерде тұра аласыз
Dialogue: 0,0:58:51.48,0:58:53.73,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:58:53.86,0:58:55.78,Default,,0,0,0,,Мені мұндай нәрсеге кім сендіре алады...
Dialogue: 0,0:58:55.94,0:58:57.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:57.45,0:58:58.74,Default,,0,0,0,,Райден Нет AB Гранд Чемпионаты
Dialogue: 0,0:59:01.37,0:59:02.70,Default,,0,0,0,,Усоп!
Dialogue: 0,0:59:03.16,0:59:06.20,Default,,0,0,0,,Сен шулы бала екенсің.
Dialogue: 0,0:59:07.71,0:59:10.88,Default,,0,0,0,,Кел, балақай, жауабын тыңдайық.
Dialogue: 0,0:59:12.96,0:59:13.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:59:17.05,0:59:20.47,Default,,0,0,0,,Мен сенің... серігің боламын.
Dialogue: 0,0:59:21.80,0:59:25.39,Default,,0,0,0,,Иә... «Нару»...
Dialogue: 0,0:59:25.60,0:59:27.06,Default,,0,0,0,,Хохо
Dialogue: 0,0:59:32.98,0:59:34.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:59:47.29,0:59:50.29,Default,,0,0,0,,Достарыңызға... өтінемін.
Dialogue: 0,0:59:53.88,0:59:57.05,Default,,0,0,0,,Мен көремін. Жихаха
Dialogue: 0,0:59:57.17,1:00:00.55,Default,,0,0,0,,Қош келдіңіз, дарынды навигатор.
Dialogue: 0,1:00:01.22,1:00:05.51,Default,,0,0,0,,Жемейтін жау барын білу де өсу.
Dialogue: 0,1:00:05.64,1:00:09.14,Default,,0,0,0,,Жихахаха...
Dialogue: 0,1:00:10.89,1:00:11.81,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:12.15,1:00:15.36,Default,,0,0,0,,Мен ұрлаушы емеспін
Dialogue: 0,1:00:15.69,1:00:18.90,Default,,0,0,0,,Қарақшылар әлемінде де адамзат бар.
Dialogue: 0,1:00:19.03,1:00:22.07,Default,,0,0,0,,Осы уақытқа дейін қуаныш пен қайғыны бөліскен достарыма.
Dialogue: 0,1:00:22.20,1:00:25.20,Default,,0,0,0,,Сәлемдемені дұрыс қалдырыңыз
Dialogue: 0,1:01:00.23,1:01:01.99,Default,,0,0,0,,Жақсы сәлемдесу.
Dialogue: 0,1:01:02.82,1:01:04.91,Default,,0,0,0,,Бұдан кейін дәм болмайды.
Dialogue: 0,1:01:05.03,1:01:07.78,Default,,0,0,0,,Менің достарым келіседі.
Dialogue: 0,1:01:08.12,1:01:12.50,Default,,0,0,0,,Әрине, егер бұл жерден тірі шыға алсаң.
Dialogue: 0,1:01:12.62,1:01:17.13,Default,,0,0,0,,Жихаха...
Dialogue: 0,1:01:22.51,1:01:23.38,Default,,0,0,0,,Хмм
Dialogue: 0,1:01:33.31,1:01:36.98,Default,,0,0,0,,Жарайсыңдар, бәрің орындарына отырыңдар.
Dialogue: 0,1:01:37.61,1:01:40.65,Default,,0,0,0,,Жоспарды жоспарланғандай орындау
Dialogue: 0,1:02:19.40,1:02:23.40,Default,,0,0,0,,(Скарлеттің ұрыс айқайы)
Dialogue: 0,1:02:28.45,1:02:29.53,Default,,0,0,0,,(Қызыл азудың айқайы)
Dialogue: 0,1:02:38.42,1:02:42.30,Default,,0,0,0,,(Метеор Эйепекс айқайы)
Dialogue: 0,1:02:51.89,1:02:56.48,Default,,0,0,0,,(Алпауыт жаратылыстардың дауысы)
Dialogue: 0,1:03:08.15,1:03:09.61,Default,,0,0,0,,Хмм, қош келдіңіз.
Dialogue: 0,1:03:09.74,1:03:10.95,Default,,0,0,0,,О
Dialogue: 0,1:03:14.29,1:03:15.91,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,1:03:16.04,1:03:17.08,Default,,0,0,0,,Кіріңіз, иә?
Dialogue: 0,1:03:20.12,1:03:23.88,Default,,0,0,0,,Джихаха Мен оған қанша қарасам, соншалықты әдемі.
Dialogue: 0,1:03:26.59,1:03:27.26,Default,,0,0,0,,Өз баламды ешқашан қателеспес едім.
Dialogue: 0,1:03:28.47,1:03:30.59,Default,,0,0,0,,Сіз дұрыс шешім қабылдадыңыз.
Dialogue: 0,1:03:30.97,1:03:35.47,Default,,0,0,0,,Туған жерің бұлай болмасын деген бақытқа кенел.
Dialogue: 0,1:03:36.81,1:03:38.39,Default,,0,0,0,,(Генерал арыстанның айқайы)
Dialogue: 0,1:03:38.60,1:03:39.27,Default,,0,0,0,,Ха...
Dialogue: 0,1:03:41.35,1:03:44.23,Default,,0,0,0,,(Генерал арыстанның айқайы)
Dialogue: 0,1:03:44.94,1:03:45.69,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:45.98,1:03:47.82,Default,,0,0,0,,Біреу!біреу!
Dialogue: 0,1:03:48.95,1:03:51.36,Default,,0,0,0,,(Мамонт Денс жылайды)
Dialogue: 0,1:03:51.49,1:03:52.82,Default,,0,0,0,,(Әйелдердің айқайы)
Dialogue: 0,1:03:53.12,1:03:55.74,Default,,0,0,0,,(Грокизаврдың айқайы)
Dialogue: 0,1:03:55.83,1:03:58.00,Default,,0,0,0,,(Баланың жылауы)
Dialogue: 0,1:03:58.12,1:04:00.16,Default,,0,0,0,,Жер астына тез өтіңіз
Dialogue: 0,1:04:14.01,1:04:16.22,Default,,0,0,0,,Уау, керемет
Dialogue: 0,1:04:16.35,1:04:19.60,Default,,0,0,0,,Құбыжықтар ауылды жұтып жатыр.
Dialogue: 0,1:04:19.73,1:04:23.23,Default,,0,0,0,,Шикидің бастығы күткендей, ол ештеңе істей алмайды.
Dialogue: 0,1:04:23.31,1:04:26.61,Default,,0,0,0,,(Қарақшылардың күлкісі)
Dialogue: 0,1:04:27.57,1:04:29.32,Default,,0,0,0,,Жай ғана шолу
Dialogue: 0,1:04:29.44,1:04:32.11,Default,,0,0,0,,Жаңа ғана Дафт Гринді ауылдан алып тастады.
Dialogue: 0,1:04:39.04,1:04:40.79,Default,,0,0,0,,Мені қызықтырмайды.
Dialogue: 0,1:04:41.54,1:04:42.96,Default,,0,0,0,,Мен өз бөлмеме оралдым
Dialogue: 0,1:04:48.67,1:04:50.05,Default,,0,0,0,,Не?
Dialogue: 0,1:04:50.97,1:04:53.80,Default,,0,0,0,,Мен одан сайын ашуланады деп ойладым.
Dialogue: 0,1:04:57.05,1:05:00.39,Default,,0,0,0,,Қарғыс атсын, мен уақытында үлгермедім.
Dialogue: 0,1:05:02.56,1:05:04.73,Default,,0,0,0,,Дәл сол газет суреті сияқты
Dialogue: 0,1:05:04.85,1:05:06.94,Default,,0,0,0,,Білмеймін. Не туралы айтып тұрсың? Мен түсінбеймін, Дио.
Dialogue: 0,1:05:07.06,1:05:10.82,Default,,0,0,0,,Барлық Шығыс теңізі (Шығыс көк) ақырында осылай бола ма?
Dialogue: 0,1:05:12.70,1:05:17.07,Default,,0,0,0,,Мугивара! Бар болса жауап беріңіз!
Dialogue: 0,1:05:17.20,1:05:20.12,Default,,0,0,0,,Луффи-сан! Сен ондасың ба?
Dialogue: 0,1:05:27.34,1:05:28.00,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:33.63,1:05:35.55,Default,,0,0,0,,Мугивара! Луффи-сан
Dialogue: 0,1:05:36.05,1:05:37.80,Default,,0,0,0,,(Гиран) Қалай болғанда да, Курокири-сан, комиссия үшін саған сенемін.
Dialogue: 0,1:05:37.93,1:05:40.35,Default,,0,0,0,,Тез қазып алайық. Иә.
Dialogue: 0,1:05:45.48,1:05:48.94,Default,,0,0,0,,Шики Шығыс көк оқиғасының артында тұрған адам ма?
Dialogue: 0,1:05:49.19,1:05:50.32,Default,,0,0,0,,Иә
Dialogue: 0,1:05:52.11,1:05:56.41,Default,,0,0,0,,Сіз бұл құбыжықтарды туған қалаңызды бүлдіру үшін пайдалануды жоспарлайсыз ба?
Dialogue: 0,1:05:56.91,1:06:00.53,Default,,0,0,0,,Әлгі бейбақ... жұртты мазақ ету.
Dialogue: 0,1:06:00.74,1:06:02.33,Default,,0,0,0,,Нами —
Dialogue: 0,1:06:02.83,1:06:06.00,Default,,0,0,0,,Туған жерімді қорғау үшін Шикиге жалғыз ердім.
Dialogue: 0,1:06:06.54,1:06:10.17,Default,,0,0,0,,Бізді Нами құтқарды.
Dialogue: 0,1:06:12.55,1:06:13.38,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:13.63,1:06:15.97,Default,,0,0,0,,Сяо жақсысың ба?
Dialogue: 0,1:06:16.80,1:06:18.43,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:19.39,1:06:22.10,Default,,0,0,0,,Себебі мен жертөледе жасырынып жүрдім.
Dialogue: 0,1:06:22.31,1:06:24.31,Default,,0,0,0,,Бұл туралы толығырақ.
Dialogue: 0,1:06:24.43,1:06:27.60,Default,,0,0,0,,Шығыс көк сенің туған жерің ме?
Dialogue: 0,1:06:29.56,1:06:33.19,Default,,0,0,0,,Бұл да сенің туған жерің ме?
Dialogue: 0,1:06:34.28,1:06:35.65,Default,,0,0,0,,Иә
Dialogue: 0,1:06:35.99,1:06:37.45,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:37.82,1:06:40.37,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,1:06:40.49,1:06:42.16,Default,,0,0,0,,Баланың көзінше
Dialogue: 0,1:06:42.28,1:06:46.54,Default,,0,0,0,,Шикі тезірек Шығыс теңізге (Шығыс көк) барса екен.
Dialogue: 0,1:06:46.66,1:06:50.17,Default,,0,0,0,,Бұл не деген сұмдық!
Dialogue: 0,1:06:50.29,1:06:52.09,Default,,0,0,0,,Мен де қуанып қалдым.
Dialogue: 0,1:06:52.17,1:06:55.30,Default,,0,0,0,,(Сяоның айқайы)
Dialogue: 0,1:06:55.42,1:06:56.13,Default,,0,0,0,,Ах
Dialogue: 0,1:06:56.42,1:06:58.59,Default,,0,0,0,,Сяо Бұған не болды?
Dialogue: 0,1:06:59.30,1:07:01.89,Default,,0,0,0,,А... А, мынау...
Dialogue: 0,1:07:02.01,1:07:04.18,Default,,0,0,0,,Енді оны осы жерден алыңыз...
Dialogue: 0,1:07:04.31,1:07:05.89,Default,,0,0,0,,Көрейін
Dialogue: 0,1:07:06.02,1:07:06.68,Default,,0,0,0,,Иә
Dialogue: 0,1:07:11.11,1:07:13.15,Default,,0,0,0,,Балалар сендер кереметсіңдер, Сяо.
Dialogue: 0,1:07:13.27,1:07:13.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:14.07,1:07:16.78,Default,,0,0,0,,Ауылымыз бей-берекет болса да...
Dialogue: 0,1:07:16.90,1:07:18.86,Default,,0,0,0,,Намиға қамқорлық көрсеткеніңіз үшін рахмет.
Dialogue: 0,1:07:19.61,1:07:23.03,Default,,0,0,0,,Мен мұндай мейірімді адамдарды көрген емеспін.
Dialogue: 0,1:07:23.16,1:07:25.04,Default,,0,0,0,,Ол мүлдем қорқынышты емес.
Dialogue: 0,1:07:25.91,1:07:27.96,Default,,0,0,0,,Хидино Шикидікі
Dialogue: 0,1:07:28.08,1:07:30.42,Default,,0,0,0,,Мен оны ұшырып жіберемін.
Dialogue: 0,1:07:30.79,1:07:33.09,Default,,0,0,0,,Көңіл көтеріңіз! Не?
Dialogue: 0,1:07:33.29,1:07:34.55,Default,,0,0,0,,Хехе
Dialogue: 0,1:07:37.84,1:07:40.22,Default,,0,0,0,,Не? Отокай (тонды теру)?
Dialogue: 0,1:07:40.68,1:07:42.93,Default,,0,0,0,,Аа, Шикиде солай болды.
Dialogue: 0,1:07:44.76,1:07:46.97,Default,,0,0,0,,Барлығының көзінше
Dialogue: 0,1:07:47.10,1:07:49.89,Default,,0,0,0,,Маған үнсіз кетуге рұқсат етіңіз.
Dialogue: 0,1:07:50.39,1:07:51.60,Default,,0,0,0,,Бұл Намидің дауысы.
Dialogue: 0,1:07:52.35,1:07:56.90,Default,,0,0,0,,Мен Шикидің экипажында штурман болып жұмыс істеуді шештім.
Dialogue: 0,1:07:57.32,1:08:00.82,Default,,0,0,0,,Лаффи мен басқалары Шикиге қарсы болса да...
Dialogue: 0,1:08:00.95,1:08:04.12,Default,,0,0,0,,Аты аңызға айналған қарақшы, ол ешқашан асып түсе алмайды.
Dialogue: 0,1:08:04.24,1:08:06.29,Default,,0,0,0,,Тіпті менің артымнан бәрі жүрсе де—
Dialogue: 0,1:08:07.41,1:08:09.58,Default,,0,0,0,,Нәтижесінде адам өлімі
Dialogue: 0,1:08:09.58,1:08:10.33,Default,,0,0,0,,Нәтижесінде адам өлімі
Dialogue: 0,1:08:09.58,1:08:10.33,Default,,0,0,0,,Уф...
Dialogue: 0,1:08:10.33,1:08:10.66,Default,,0,0,0,,Уф...
Dialogue: 0,1:08:11.37,1:08:13.33,Default,,0,0,0,,Осыны айтайын.
Dialogue: 0,1:08:14.17,1:08:15.25,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:08:16.80,1:08:19.76,Default,,0,0,0,,Не? Міне осы!
Dialogue: 0,1:08:21.18,1:08:24.43,Default,,0,0,0,,Не? Ол бұл сөздерді артында қалдырды!
Dialogue: 0,1:08:24.55,1:08:25.97,Default,,0,0,0,,О... сабыр етіңіз.
Dialogue: 0,1:08:26.10,1:08:28.47,Default,,0,0,0,,Сіз мұны істеуге мүмкіндік жоқ дейсіз бе?
Dialogue: 0,1:08:28.60,1:08:30.89,Default,,0,0,0,,Қалағаныңды істе! Сен не туралы айтып тұрсың?
Dialogue: 0,1:08:31.35,1:08:35.27,Default,,0,0,0,,Расында, бәрің де Шикиден жеңілдіңдер ғой, солай ма?
Dialogue: 0,1:08:35.40,1:08:36.44,Default,,0,0,0,,Не!
Dialogue: 0,1:08:36.57,1:08:39.53,Default,,0,0,0,,Бұл... ерекше ештеңе емес... мені... ұрып-соқты...
Dialogue: 0,1:08:39.61,1:08:41.32,Default,,0,0,0,,О... сабыр етіңіз.
Dialogue: 0,1:08:41.45,1:08:42.86,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:08:42.99,1:08:44.03,Default,,0,0,0,,Сәлем...
Dialogue: 0,1:08:44.28,1:08:46.53,Default,,0,0,0,,Ах... Қарғыс атсын.
Dialogue: 0,1:08:52.08,1:08:54.75,Default,,0,0,0,,Эй Усопп, оны тағы тыңдауға рұқсат етіңіз.
Dialogue: 0,1:08:54.88,1:08:57.42,Default,,0,0,0,,Не? А... аа
Dialogue: 0,1:08:57.55,1:08:58.21,Default,,0,0,0,,(басылған ұлулардың дыбысы)
Dialogue: 0,1:08:58.50,1:09:00.21,Default,,0,0,0,,Барлығының көзінше
Dialogue: 0,1:09:00.34,1:09:02.84,Default,,0,0,0,,Маған үнсіз кетуге рұқсат етіңіз.
Dialogue: 0,1:09:04.18,1:09:08.85,Default,,0,0,0,,Мен Шикидің экипажында штурман болып жұмыс істеуді шештім.
Dialogue: 0,1:09:09.18,1:09:12.69,Default,,0,0,0,,Лаффи мен басқалары Шикиге қарсы болса да...
Dialogue: 0,1:09:12.81,1:09:15.06,Default,,0,0,0,,Аты аңызға айналған қарақшы, ешқашан асып түспейтін.
Dialogue: 0,1:09:16.11,1:09:18.90,Default,,0,0,0,,Тіпті менің артымнан бәрі жүрсе де—
Dialogue: 0,1:09:19.28,1:09:22.28,Default,,0,0,0,,Нәтижесінде адам өлімі
Dialogue: 0,1:09:23.24,1:09:24.61,Default,,0,0,0,,Осыны айтайын.
Dialogue: 0,1:09:37.21,1:09:38.79,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,1:09:46.34,1:09:52.22,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:10:28.34,1:10:32.10,Default,,0,0,0,,Элиталар бірінен соң бірі жиналып жатыр.
Dialogue: 0,1:10:33.14,1:10:35.98,Default,,0,0,0,,Соңында, әлемдік үкімет
Dialogue: 0,1:10:36.48,1:10:40.36,Default,,0,0,0,,Менің аяғым дірілдегеніне 20 жыл болды.
Dialogue: 0,1:10:41.02,1:10:43.28,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:45.44,1:10:46.53,Default,,0,0,0,,Э-э, не істеп жатырсыз, мырза?
Dialogue: 0,1:10:47.15,1:10:49.03,Default,,0,0,0,,Nyoho ho ha ho…
Dialogue: 0,1:10:52.53,1:10:55.16,Default,,0,0,0,,(Тодороки) Мен сол жігіттен барынша көп нәрсе үйренгім келеді
Dialogue: 0,1:10:55.45,1:10:56.12,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:56.58,1:10:58.17,Default,,0,0,0,,Қазір мен романтика туралы ойлауға өзімді дайын сезіне алмаймын.
Dialogue: 0,1:11:06.42,1:11:08.76,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:11:29.82,1:11:31.53,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:11:31.66,1:11:35.29,Default,,0,0,0,,Сіз ағаштарды кесіп, құбыжықтар бұл жерге шабуыл жасайсыз ба?
Dialogue: 0,1:11:35.41,1:11:37.16,Default,,0,0,0,,Хехе...
Dialogue: 0,1:11:37.79,1:11:40.04,Default,,0,0,0,,Неліктен мұны істеуге ниеттендіңіз?
Dialogue: 0,1:11:40.21,1:11:42.50,Default,,0,0,0,,Бэйби-чан хехехехе...
Dialogue: 0,1:11:43.59,1:11:46.96,Default,,0,0,0,,Шарттарды қабылдап, орындасам да.
Dialogue: 0,1:11:47.63,1:11:52.43,Default,,0,0,0,,Мені тыңдау мүмкін емес.
Dialogue: 0,1:11:52.85,1:11:55.22,Default,,0,0,0,,Тіпті жойылатын туған қала -
Dialogue: 0,1:11:55.35,1:11:58.77,Default,,0,0,0,,Жаман хабарды естіген достарымның иығын тастағанын көру.
Dialogue: 0,1:11:58.89,1:12:00.44,Default,,0,0,0,,Оны көргім келмейді!
Dialogue: 0,1:12:02.65,1:12:04.90,Default,,0,0,0,,Сіз дәл қазіргі дыбысты естідіңіз ғой, иә?
Dialogue: 0,1:12:06.03,1:12:08.03,Default,,0,0,0,,Асығыс еліктеу
Dialogue: 0,1:12:08.19,1:12:10.82,Default,,0,0,0,,Ух... Ку... Уааа... Уф!
Dialogue: 0,1:12:12.70,1:12:13.70,Default,,0,0,0,,Уф...
Dialogue: 0,1:12:13.82,1:12:16.12,Default,,0,0,0,,Хахаха... Ах... Ах!
Dialogue: 0,1:12:18.37,1:12:22.37,Default,,0,0,0,,Бұл ағаштан бөлінетін күшті токсин қате есептелді ме?
Dialogue: 0,1:12:22.46,1:12:24.71,Default,,0,0,0,,Хахаха... хахаха...
Dialogue: 0,1:12:25.25,1:12:27.67,Default,,0,0,0,,Қарақшылар – менің үйім және менің отбасым.
Dialogue: 0,1:12:27.80,1:12:29.42,Default,,0,0,0,,Айтпа
Dialogue: 0,1:12:29.59,1:12:31.05,Default,,0,0,0,,Уф... аа!
Dialogue: 0,1:12:31.18,1:12:33.72,Default,,0,0,0,,Мұндай нәрсе мені ұстап тұр.
Dialogue: 0,1:12:33.84,1:12:37.60,Default,,0,0,0,,Өз өміріңізге қауіп төндірсеңіз, оған қамқорлық жасамаңыз.
Dialogue: 0,1:12:39.60,1:12:41.89,Default,,0,0,0,,А... а...
Dialogue: 0,1:12:42.39,1:12:43.44,Default,,0,0,0,,Ах!
Dialogue: 0,1:12:46.52,1:12:50.61,Default,,0,0,0,,Жалпы жиналыс аяқталғаннан кейін аман қалудың сәті түссе,
Dialogue: 0,1:12:50.99,1:12:55.12,Default,,0,0,0,,Мен оны өмір бойы штурман ретінде пайдаланамын хахаха...
Dialogue: 0,1:12:55.24,1:12:57.99,Default,,0,0,0,,Маған ерсі әйелдер ұнамайды.
Dialogue: 0,1:12:58.74,1:13:02.04,Default,,0,0,0,,Жихаха...
Dialogue: 0,1:13:02.12,1:13:06.29,Default,,0,0,0,,Жихаха...
Dialogue: 0,1:13:28.57,1:13:30.82,Default,,0,0,0,,Қайырлы жиын, бейбақтар.
Dialogue: 0,1:13:30.94,1:13:34.57,Default,,0,0,0,,Бұдан былай сенің менің бақылауымда болғаныңды қалаймын.
Dialogue: 0,1:13:34.70,1:13:36.87,Default,,0,0,0,,Ант берген тостағанды ауыстырыңыз
Dialogue: 0,1:13:37.66,1:13:42.54,Default,,0,0,0,,Сонымен қатар, мен сатқындарға аямаймын, сондықтан мен солай етуге ниеттемін.
Dialogue: 0,1:13:43.04,1:13:46.92,Default,,0,0,0,,Жүрейік, стратегиялар теңізіне
Dialogue: 0,1:13:47.42,1:13:50.30,Default,,0,0,0,,Қайғылы шығыс теңізіне (Шығыс көк)!
Dialogue: 0,1:13:50.71,1:13:54.63,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,1:14:20.16,1:14:21.95,Default,,0,0,0,,Кеттік, Фрэнки.
Dialogue: 0,1:14:22.08,1:14:22.79,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,1:14:23.16,1:14:24.29,Default,,0,0,0,,(машина жұмысының шуы)
Dialogue: 0,1:14:24.41,1:14:26.87,Default,,0,0,0,,Мықтап ұстаңыз!
Dialogue: 0,1:14:27.00,1:14:29.59,Default,,0,0,0,,Ku de Burst!
Dialogue: 0,1:14:35.67,1:14:37.38,Default,,0,0,0,,(спирт құйылған дыбыс)
Dialogue: 0,1:14:52.44,1:14:53.23,Default,,0,0,0,,Ах
Dialogue: 0,1:14:59.41,1:15:00.53,Default,,0,0,0,,(Қол астындағылардың айқайы)
Dialogue: 0,1:15:09.37,1:15:11.08,Default,,0,0,0,,Уау!
Dialogue: 0,1:15:11.46,1:15:13.00,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,1:15:19.43,1:15:21.18,Default,,0,0,0,,​​Уф... Бұл өтірік.
Dialogue: 0,1:15:21.30,1:15:25.60,Default,,0,0,0,,Қандай жігіт патша сарайына қайықпен барады?
Dialogue: 0,1:15:28.39,1:15:29.44,Default,,0,0,0,,(Қол астындағылардың айқайы)
Dialogue: 0,1:15:36.69,1:15:38.53,Default,,0,0,0,,Өздеріңіз білетіндей—
Dialogue: 0,1:15:38.65,1:15:42.57,Default,,0,0,0,,Шығыс теңізі (Шығыс көк) бес теңіздің ішіндегі ең әлсізі.
Dialogue: 0,1:15:42.95,1:15:45.16,Default,,0,0,0,,Өлгенде сағынатын ұлы адамдар жоқ.
Dialogue: 0,1:15:45.70,1:15:47.87,Default,,0,0,0,,Қалағаныңызша зорлықшыл болыңыз
Dialogue: 0,1:15:49.67,1:15:52.42,Default,,0,0,0,,«Алтын арыстан» қарақшылары құрылды.
Dialogue: 0,1:15:52.79,1:15:54.25,Default,,0,0,0,,Ооо
Dialogue: 0,1:15:55.96,1:15:57.80,Default,,0,0,0,,Шики-сама!
Dialogue: 0,1:15:57.92,1:15:59.09,Default,,0,0,0,,Әй?
Dialogue: 0,1:15:59.84,1:16:01.93,Default,,0,0,0,,Бұл не? Осындай кездерде!
Dialogue: 0,1:16:02.05,1:16:05.89,Default,,0,0,0,,Кешіріңіз, сізден бірден сұрайын дегенім бар.
Dialogue: 0,1:16:08.27,1:16:11.14,Default,,0,0,0,,Сегіз адам? Неге тез түсірмейсің?
Dialogue: 0,1:16:11.56,1:16:12.90,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,1:16:52.69,1:16:53.35,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:54.81,1:16:56.77,Default,,0,0,0,,Сіз шеше алмайсыз, солай істеңіз.
Dialogue: 0,1:16:56.90,1:16:59.03,Default,,0,0,0,,Уау... сәл күте тұрыңыз... Уау!
Dialogue: 0,1:17:29.64,1:17:33.81,Default,,0,0,0,,Бұл сен едің... Мен таң қалдым.
Dialogue: 0,1:17:40.73,1:17:42.99,Default,,0,0,0,,Шығыс теңізге шабуыл жасау (Шығыс көк)?
Dialogue: 0,1:17:44.11,1:17:45.45,Default,,0,0,0,,Жақсы
Dialogue: 0,1:17:50.04,1:17:51.33,Default,,0,0,0,,Нами қауіпсіз бе?
Dialogue: 0,1:17:52.04,1:17:54.16,Default,,0,0,0,,Ой, мен қатты толқып тұрмын
Dialogue: 0,1:17:54.25,1:17:55.71,Default,,0,0,0,,Хехе...
Dialogue: 0,1:17:55.96,1:17:56.83,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,1:17:57.04,1:18:00.17,Default,,0,0,0,,Жихаха...
Dialogue: 0,1:18:00.84,1:18:02.76,Default,,0,0,0,,Бұл біраз алаңдатады...
Dialogue: 0,1:18:03.30,1:18:07.59,Default,,0,0,0,,Сіз сегіз адаммен айналысуды жоспарламайсыз, солай ма?
Dialogue: 0,1:18:19.69,1:18:21.32,Default,,0,0,0,,Мен өзімді құрбан етемін...
Dialogue: 0,1:18:21.44,1:18:24.53,Default,,0,0,0,,Өз туған қаласын қорғай алатынына сенетін ертегі әйел —
Dialogue: 0,1:18:24.86,1:18:28.53,Default,,0,0,0,,Тарту үшін жиналған абайсыз арнайы шабуыл тобы?
Dialogue: 0,1:18:29.07,1:18:30.45,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,1:18:30.58,1:18:31.41,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:32.08,1:18:35.21,Default,,0,0,0,,Нами мұнда құрбандық шалу үшін келген жоқ.
Dialogue: 0,1:18:35.66,1:18:38.79,Default,,0,0,0,,Мен жаңа ғана алға шықтым және осында күресуге келдім!
Dialogue: 0,1:18:43.42,1:18:46.51,Default,,0,0,0,,Дайында, Алтын арыстан Шики
Dialogue: 0,1:18:47.97,1:18:49.80,Default,,0,0,0,,Біз басты күшпіз!
Dialogue: 0,1:18:51.10,1:18:55.10,Default,,0,0,0,,(Қарақшылардың айқайы)
Dialogue: 0,1:19:04.03,1:19:05.32,Default,,0,0,0,,Йохохохо…
Dialogue: 0,1:19:12.62,1:19:16.62,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:19:24.34,1:19:26.97,Default,,0,0,0,,Цк. Оқ таусылды ма? Хмм.
Dialogue: 0,1:19:27.22,1:19:29.84,Default,,0,0,0,,Әлі біраз уақыт қалды.
Dialogue: 0,1:19:29.97,1:19:32.30,Default,,0,0,0,,Бұл сәлемдесудің орнына келеді емес пе?
Dialogue: 0,1:19:32.76,1:19:34.93,Default,,0,0,0,,Усопп Чоппер! Намиді табыңыз!
Dialogue: 0,1:19:35.06,1:19:36.18,Default,,0,0,0,,О, түсіндім!
Dialogue: 0,1:19:36.31,1:19:39.69,Default,,0,0,0,,Уф... Мына секірушілерді атып тастаңдар!
Dialogue: 0,1:19:39.81,1:19:42.40,Default,,0,0,0,,Олардың бәрін өлтіріңіз! (Қарақшылар) О!
Dialogue: 0,1:19:42.52,1:19:44.32,Default,,0,0,0,,(Қарақшылардың айқайы)
Dialogue: 0,1:19:46.69,1:19:49.74,Default,,0,0,0,,Шикидің бастығы артқы бөлмеге барады.
Dialogue: 0,1:19:53.16,1:19:54.53,Default,,0,0,0,,Уау
Dialogue: 0,1:19:55.08,1:19:58.12,Default,,0,0,0,,Басын өлтір! (Қарақшылар) О!
Dialogue: 0,1:19:59.54,1:20:00.58,Default,,0,0,0,,♪
Dialogue: 0,1:20:00.58,1:20:02.88,Default,,0,0,0,,Ұйқыдағы ән Фрэн
Dialogue: 0,1:20:00.58,1:20:02.88,Default,,0,0,0,,♪
Dialogue: 0,1:20:02.88,1:20:03.08,Default,,0,0,0,,Ұйқыдағы ән Фрэн
Dialogue: 0,1:20:03.21,1:20:05.80,Default,,0,0,0,,(Қарақшылардың қорылдауы)
Dialogue: 0,1:20:09.01,1:20:11.13,Default,,0,0,0,,Достарыма...
Dialogue: 0,1:20:13.09,1:20:13.76,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:13.89,1:20:17.18,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,1:20:19.98,1:20:21.27,Default,,0,0,0,,Бастық!
Dialogue: 0,1:20:22.40,1:20:23.61,Default,,0,0,0,,Хмм
Dialogue: 0,1:20:27.90,1:20:28.57,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:20:29.15,1:20:30.78,Default,,0,0,0,,Капитанға кедергі жасамаңыз
Dialogue: 0,1:20:33.37,1:20:34.70,Default,,0,0,0,,Воч
Dialogue: 0,1:20:34.99,1:20:38.20,Default,,0,0,0,,Мен саған айтамын жолдан кет!
Dialogue: 0,1:20:40.79,1:20:44.38,Default,,0,0,0,,Мен тек шекараны аман-есен кесіп өткім келеді.
Dialogue: 0,1:20:44.71,1:20:46.75,Default,,0,0,0,,Куә!
Dialogue: 0,1:20:47.13,1:20:48.34,Default,,0,0,0,,Билли…
Dialogue: 0,1:20:50.63,1:20:53.18,Default,,0,0,0,,Куә!
Dialogue: 0,1:20:55.51,1:20:56.51,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:57.35,1:20:59.43,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,1:20:59.56,1:21:01.10,Default,,0,0,0,,Шақыру
Dialogue: 0,1:21:01.69,1:21:03.90,Default,,0,0,0,,Менің сенен бір жақсылығым бар, менен сұра.
Dialogue: 0,1:21:04.23,1:21:04.90,Default,,0,0,0,,Хмм...
Dialogue: 0,1:21:05.11,1:21:05.77,Default,,0,0,0,,Quat
Dialogue: 0,1:21:06.15,1:21:07.98,Default,,0,0,0,,Шақыру... шақалақ
Dialogue: 0,1:21:08.40,1:21:09.07,Default,,0,0,0,,Qua…
Dialogue: 0,1:21:09.53,1:21:13.41,Default,,0,0,0,,Осылай қал... Мені тыңдаңызшы.
Dialogue: 0,1:21:13.57,1:21:15.24,Default,,0,0,0,,Шақыру
Dialogue: 0,1:21:17.12,1:21:18.08,Default,,0,0,0,,Quat
Dialogue: 0,1:21:19.49,1:21:20.25,Default,,0,0,0,,Тоуууу
Dialogue: 0,1:21:21.04,1:21:22.79,Default,,0,0,0,,(Қарақшылардың ыңырануы)
Dialogue: 0,1:21:23.54,1:21:25.00,Default,,0,0,0,,Қайталанатын от жұлдызы
Dialogue: 0,1:21:25.42,1:21:26.79,Default,,0,0,0,,(Қарақшылардың ыңырануы)
Dialogue: 0,1:21:27.59,1:21:28.92,Default,,0,0,0,,Уау...
Dialogue: 0,1:21:33.84,1:21:35.59,Default,,0,0,0,,Чоппер Оның иісі қандай?
Dialogue: 0,1:21:35.72,1:21:39.26,Default,,0,0,0,,Жоқ, ауада жасыл түс бар.
Dialogue: 0,1:21:39.39,1:21:40.60,Default,,0,0,0,,Менің мұрным жақсы емес
Dialogue: 0,1:21:41.14,1:21:42.93,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,1:21:43.14,1:21:44.06,Default,,0,0,0,,Ах
Dialogue: 0,1:21:49.32,1:21:51.69,Default,,0,0,0,,Міне болды! Нами сонда болды!
Dialogue: 0,1:21:51.82,1:21:52.53,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:57.07,1:22:00.87,Default,,0,0,0,,(Биллидің жылағаны)
Dialogue: 0,1:22:03.91,1:22:07.33,Default,,0,0,0,,Куә!
Dialogue: 0,1:22:07.75,1:22:10.13,Default,,0,0,0,,Куа Куа
Dialogue: 0,1:22:11.38,1:22:12.63,Default,,0,0,0,,Нами
Dialogue: 0,1:22:14.72,1:22:17.01,Default,,0,0,0,,Мені өзіңізбен бірге алып кетесіз бе?
Dialogue: 0,1:22:17.68,1:22:18.64,Default,,0,0,0,,Ах
Dialogue: 0,1:22:20.14,1:22:20.85,Default,,0,0,0,,Иә
Dialogue: 0,1:22:22.02,1:22:23.89,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,1:22:24.52,1:22:28.02,Default,,0,0,0,,Жарайды, уайымдама.
Dialogue: 0,1:22:28.15,1:22:29.31,Default,,0,0,0,,Менің қымбат туған жерім
Dialogue: 0,1:22:29.81,1:22:33.86,Default,,0,0,0,,Мен ешқашан ештеңенің бұзылуына жол бермеймін.
Dialogue: 0,1:22:37.78,1:22:40.08,Default,,0,0,0,,Тағы да. Күте тұрыңыз, Нами.
Dialogue: 0,1:22:43.16,1:22:44.00,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:53.76,1:22:56.80,Default,,0,0,0,,А... аа... у...
Dialogue: 0,1:22:56.93,1:22:58.68,Default,,0,0,0,,Ауырды...
Dialogue: 0,1:22:58.80,1:23:00.64,Default,,0,0,0,,Әйтеуір аман қалдым.
Dialogue: 0,1:23:00.76,1:23:01.93,Default,,0,0,0,,Жоқ... Нами ше?
Dialogue: 0,1:23:03.22,1:23:04.35,Default,,0,0,0,,Нами!
Dialogue: 0,1:23:05.18,1:23:06.56,Default,,0,0,0,,Нами, мықты бол.
Dialogue: 0,1:23:06.69,1:23:08.69,Default,,0,0,0,,Амансың ба? Мен саған қазір көмектесемін
Dialogue: 0,1:23:08.98,1:23:11.61,Default,,0,0,0,,Бұл туу белгісі Сяоның әжесімен бірдей.
Dialogue: 0,1:23:11.73,1:23:13.11,Default,,0,0,0,,Маған тезірек емделу керек...
Dialogue: 0,1:23:13.11,1:23:13.65,Default,,0,0,0,,Тез ем алуым керек...
Dialogue: 0,1:23:13.11,1:23:13.65,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,1:23:13.65,1:23:13.86,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,1:23:13.86,1:23:14.82,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:13.86,1:23:14.82,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,1:23:14.82,1:23:15.53,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,1:23:15.53,1:23:16.53,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:15.53,1:23:16.53,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,1:23:16.53,1:23:17.11,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,1:23:18.95,1:23:21.74,Default,,0,0,0,,Бұл... мынау... (Чоппер) Мүмкін...
Dialogue: 0,1:23:21.83,1:23:25.00,Default,,0,0,0,,Біз жеңілдік.
Dialogue: 0,1:23:25.45,1:23:27.50,Default,,0,0,0,,Осы қарбалас уақытта...
Dialogue: 0,1:23:27.96,1:23:29.96,Default,,0,0,0,,Мен Намиді тез алып қашуым керек.
Dialogue: 0,1:23:30.08,1:23:34.05,Default,,0,0,0,,(Алып тіршілік иелері ырылдады)
Dialogue: 0,1:23:34.50,1:23:37.76,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,1:23:37.88,1:23:39.72,Default,,0,0,0,,(Яоёрозу) Бір сәт! (Хагакуре) Сен оңай берілмейсің ғой!
Dialogue: 0,1:23:39.84,1:23:42.01,Default,,0,0,0,,Эндевордың орнына ма?
Dialogue: 0,1:23:42.18,1:23:43.76,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:23:51.10,1:23:52.02,Default,,0,0,0,,Не?
Dialogue: 0,1:23:52.11,1:23:56.11,Default,,0,0,0,,(Алпауыт тіршілік иелері ырылдады)
Dialogue: 0,1:23:57.36,1:24:00.36,Default,,0,0,0,,(Алып тіршілік иелерінің дыбыстары)
Dialogue: 0,1:24:00.95,1:24:02.16,Default,,0,0,0,,(Морж тауының соғыс айқайы)
Dialogue: 0,1:24:02.28,1:24:04.49,Default,,0,0,0,,Уф... Ах... Уау!
Dialogue: 0,1:24:04.58,1:24:06.08,Default,,0,0,0,,(Қарақшылардың үрейлі дауыстары)
Dialogue: 0,1:24:07.83,1:24:09.16,Default,,0,0,0,,Жүріңдер, жүріңдер, жүріңдер!
Dialogue: 0,1:24:11.33,1:24:12.42,Default,,0,0,0,,Уау
Dialogue: 0,1:24:15.55,1:24:17.46,Default,,0,0,0,,(Теңіз анемонының соғылған дыбысы)
Dialogue: 0,1:24:17.71,1:24:19.01,Default,,0,0,0,,Хехе...
Dialogue: 0,1:24:19.13,1:24:20.18,Default,,0,0,0,,тіпті «костюмнің ашықтығын реттейтін заң жобасы» дайындалған болатын—
Dialogue: 0,1:24:23.89,1:24:25.47,Default,,0,0,0,,Йохохохо…
Dialogue: 0,1:24:29.89,1:24:33.40,Default,,0,0,0,,Санчо Язугири гуілдеді!
Dialogue: 0,1:24:33.52,1:24:34.44,Default,,0,0,0,,(Бачфли еңіреді)
Dialogue: 0,1:24:35.15,1:24:35.82,Default,,0,0,0,,Уф...
Dialogue: 0,1:24:39.03,1:24:40.24,Default,,0,0,0,,(пышақтардың сынған дыбысы)
Dialogue: 0,1:24:41.74,1:24:43.87,Default,,0,0,0,,А... у...
Dialogue: 0,1:24:47.95,1:24:49.00,Default,,0,0,0,,Нуфу
Dialogue: 0,1:24:55.59,1:24:56.54,Default,,0,0,0,,Сіз қалай ойлайсыз? ұсақтағыш
Dialogue: 0,1:24:57.05,1:25:00.26,Default,,0,0,0,,Сізге қауіп төніп тұр. Сіз әрең дем алып жатырсыз.
Dialogue: 0,1:25:00.80,1:25:02.43,Default,,0,0,0,,Бізге тез арада бірдеңе істеу керек.
Dialogue: 0,1:25:02.55,1:25:05.22,Default,,0,0,0,,Ку-а Билли
Dialogue: 0,1:25:05.39,1:25:06.89,Default,,0,0,0,,Куу…
Dialogue: 0,1:25:09.18,1:25:12.23,Default,,0,0,0,,Бұл ауруды тек IQ ғана емдей алады.
Dialogue: 0,1:25:12.35,1:25:14.44,Default,,0,0,0,,Шики мұны монополиялайды.
Dialogue: 0,1:25:14.60,1:25:15.77,Default,,0,0,0,,Не?
Dialogue: 0,1:25:18.02,1:25:19.82,Default,,0,0,0,,Жердің қай жерінде...
Dialogue: 0,1:25:21.69,1:25:22.86,Default,,0,0,0,,Уау!
Dialogue: 0,1:25:23.28,1:25:24.57,Default,,0,0,0,,Жарайды, мен дереу барамын.
Dialogue: 0,1:25:25.32,1:25:28.12,Default,,0,0,0,,А... ауырады... Нами ше?
Dialogue: 0,1:25:28.24,1:25:30.29,Default,,0,0,0,,Әйтеуір жарайды, ха!
Dialogue: 0,1:25:31.66,1:25:33.00,Default,,0,0,0,,Шики!
Dialogue: 0,1:25:33.79,1:25:37.00,Default,,0,0,0,,Сен істедің, қыз.
Dialogue: 0,1:25:38.00,1:25:40.42,Default,,0,0,0,,Оның шынымен өлгісі келетін сияқты.
Dialogue: 0,1:25:41.34,1:25:42.88,Default,,0,0,0,,Сен маған енді керек емессің
Dialogue: 0,1:25:43.76,1:25:48.51,Default,,0,0,0,,Қалай күрессең де, Шығыс көк сені міндетті түрде басып тастайды.
Dialogue: 0,1:25:48.64,1:25:50.14,Default,,0,0,0,,(Арыстан дорбасы)
Dialogue: 0,1:25:50.22,1:25:51.52,Default,,0,0,0,,Уау
Dialogue: 0,1:25:55.94,1:25:57.44,Default,,0,0,0,,Немесе... қоршалған
Dialogue: 0,1:25:57.61,1:25:59.98,Default,,0,0,0,,Шишииши Гошодзимаки!
Dialogue: 0,1:26:00.11,1:26:01.82,Default,,0,0,0,,
Dialogue: 0,1:26:02.11,1:26:03.74,Default,,0,0,0,,Уау! Не?!
Dialogue: 0,1:26:04.07,1:26:06.32,Default,,0,0,0,,Үмітсіз өл!
Dialogue: 0,1:26:06.49,1:26:07.28,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,1:26:07.49,1:26:08.41,Default,,0,0,0,,Уг!?
Dialogue: 0,1:26:11.33,1:26:12.08,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:15.96,1:26:17.38,Default,,0,0,0,,Гррр…
Dialogue: 0,1:26:17.79,1:26:19.50,Default,,0,0,0,,Ах (Чоппер) Ах
Dialogue: 0,1:26:28.43,1:26:29.72,Default,,0,0,0,,Луффи!
Dialogue: 0,1:26:30.01,1:26:31.76,Default,,0,0,0,,Сіз әлі де күресіп жатырсыз ба?
Dialogue: 0,1:26:32.27,1:26:33.60,Default,,0,0,0,,Хмм...
Dialogue: 0,1:26:34.73,1:26:38.06,Default,,0,0,0,,Нами, оны үрлейміз де, бәріміз үйге қайтайық.
Dialogue: 0,1:26:39.27,1:26:40.86,Default,,0,0,0,,Луффи...
Dialogue: 0,1:26:42.23,1:26:44.53,Default,,0,0,0,,Мұны маған қалдыр, Намиден сұра.
Dialogue: 0,1:26:44.65,1:26:46.82,Default,,0,0,0,,Мен... Түсіндім (Чоппер) Сәттілік Луффи.
Dialogue: 0,1:26:47.78,1:26:49.66,Default,,0,0,0,,Қайда қашсаң да,
Dialogue: 0,1:26:49.78,1:26:52.58,Default,,0,0,0,,Барлығын құртудың тағдыры өзгермейді.
Dialogue: 0,1:26:59.92,1:27:03.76,Default,,0,0,0,,Біздің тағдырымызды сен шешесің!
Dialogue: 0,1:27:04.51,1:27:06.47,Default,,0,0,0,,JET зеңбірегі!
Dialogue: 0,1:27:06.80,1:27:09.47,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,1:27:10.72,1:27:12.51,Default,,0,0,0,,Билли, маған күшіңді бер!
Dialogue: 0,1:27:12.60,1:27:14.10,Default,,0,0,0,,Куә!
Dialogue: 0,1:27:16.77,1:27:19.52,Default,,0,0,0,,Мені Шығыс теңізге (Шығыс көкке) жіберме!
Dialogue: 0,1:27:19.65,1:27:21.48,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,1:27:22.36,1:27:26.82,Default,,0,0,0,,Мен Шығыс теңізінің (Шығыс көк) адамға оңай бара алмаймын!
Dialogue: 0,1:27:32.20,1:27:33.58,Default,,0,0,0,,Уау...
Dialogue: 0,1:27:34.24,1:27:35.91,Default,,0,0,0,,Бұл не? Мен қайдамын?
Dialogue: 0,1:27:36.20,1:27:37.62,Default,,0,0,0,,Мұның бәрі IQ туралы.
Dialogue: 0,1:27:38.41,1:27:41.42,Default,,0,0,0,,Ай сәулесінде өседі ме?
Dialogue: 0,1:27:42.04,1:27:44.05,Default,,0,0,0,,Дәрінің иісі бар, а?
Dialogue: 0,1:27:52.05,1:27:54.89,Default,,0,0,0,,Сіз осында IQ зерттеуін жасадыңыз ба?
Dialogue: 0,1:27:56.35,1:27:58.27,Default,,0,0,0,,Қайсысын ішу керек?
Dialogue: 0,1:27:58.39,1:27:59.35,Default,,0,0,0,,Ах
Dialogue: 0,1:28:00.14,1:28:01.19,Default,,0,0,0,,Иә
Dialogue: 0,1:28:01.48,1:28:02.56,Default,,0,0,0,,Ах!
Dialogue: 0,1:28:02.69,1:28:04.44,Default,,0,0,0,,Пиро пиро пиро…
Dialogue: 0,1:28:04.73,1:28:07.90,Default,,0,0,0,,Ах, химиялық заттардың иісі өткір.
Dialogue: 0,1:28:08.03,1:28:09.11,Default,,0,0,0,,Сіз ғалымсыз ба?
Dialogue: 0,1:28:09.45,1:28:11.86,Default,,0,0,0,,А, бұл өте жақсы.
Dialogue: 0,1:28:11.99,1:28:13.41,Default,,0,0,0,,Маған Дафттың дәрісін беріңізші.
Dialogue: 0,1:28:13.57,1:28:17.37,Default,,0,0,0,,Маған бергің келе ме, ақымақ?
Dialogue: 0,1:28:17.50,1:28:18.54,Default,,0,0,0,,Бұл сіз айтып отырсыз ба?
Dialogue: 0,1:28:18.66,1:28:21.67,Default,,0,0,0,,Төтенше жағдайларда оны әрқашан өзіңізбен бірге алып жүресіз.
Dialogue: 0,1:28:21.83,1:28:24.42,Default,,0,0,0,,Бұл оңай емес пе?
Dialogue: 0,1:28:24.54,1:28:25.67,Default,,0,0,0,,Ах
Dialogue: 0,1:28:27.42,1:28:30.47,Default,,0,0,0,,Мен оның бар дәрі-дәрмегін алып тастауым керек сияқты.
Dialogue: 0,1:28:31.01,1:28:32.34,Default,,0,0,0,,Алыста
Dialogue: 0,1:28:32.51,1:28:34.35,Default,,0,0,0,,Мен оны қысқартамын.
Dialogue: 0,1:28:34.55,1:28:35.72,Default,,0,0,0,,Zoro!
Dialogue: 0,1:28:35.85,1:28:38.31,Default,,0,0,0,,Осы уақытқа дейін мені аңдыдыңыз.
Dialogue: 0,1:28:38.39,1:28:42.85,Default,,0,0,0,,Әй, бара берші, оның қолындағы дәрі маған керек.
Dialogue: 0,1:28:44.65,1:28:46.69,Default,,0,0,0,,Егер сіз оны кесіп тастасаңыз ше?
Dialogue: 0,1:28:46.82,1:28:49.36,Default,,0,0,0,,Бұл жылқының сүйегі Шығыс теңізден (Шығыс көк)!
Dialogue: 0,1:28:49.69,1:28:51.24,Default,,0,0,0,,Бұл тек бір ақымақ теңіз.
Dialogue: 0,1:28:51.36,1:28:52.45,Default,,0,0,0,,Ол банкротқа ұшырағандықтан -
Dialogue: 0,1:28:52.57,1:28:55.03,Default,,0,0,0,,Дүниеде пәле болмайды!
Dialogue: 0,1:28:55.33,1:28:56.20,Default,,0,0,0,,Ммм
Dialogue: 0,1:29:01.79,1:29:04.33,Default,,0,0,0,,Химиялық жонглерлік
Dialogue: 0,1:29:06.75,1:29:07.46,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:07.80,1:29:09.84,Default,,0,0,0,,Күйіп қалмаңыз!
Dialogue: 0,1:29:13.93,1:29:15.85,Default,,0,0,0,,Уф... Мен қашып құтыла алмаймын.
Dialogue: 0,1:29:17.06,1:29:17.89,Default,,0,0,0,,Уау!
Dialogue: 0,1:29:18.89,1:29:20.77,Default,,0,0,0,,Зоро! Сенімен бәрі жақсы ма?
Dialogue: 0,1:29:20.98,1:29:22.31,Default,,0,0,0,,Пиро пиро пиро
Dialogue: 0,1:29:22.44,1:29:24.73,Default,,0,0,0,,Сіз қалай ойлайсыз? Химиялық жонглерлік күш
Dialogue: 0,1:29:24.85,1:29:25.52,Default,,0,0,0,,О
Dialogue: 0,1:29:26.73,1:29:29.61,Default,,0,0,0,,Менің акробатикаға уақытым жоқ.
Dialogue: 0,1:29:30.15,1:29:31.11,Default,,0,0,0,,Қый!
Dialogue: 0,1:29:31.24,1:29:34.07,Default,,0,0,0,,Джуглинді жаппай жеңіз!
Dialogue: 0,1:29:36.70,1:29:38.08,Default,,0,0,0,,Zoro!
Dialogue: 0,1:29:38.62,1:29:40.33,Default,,0,0,0,,Оны дұрыс жеді.
Dialogue: 0,1:29:40.45,1:29:41.95,Default,,0,0,0,,Пиро пиро пиро пиро
Dialogue: 0,1:29:46.42,1:29:49.25,Default,,0,0,0,,Демон Ки Тоғыз қылыш стилі
Dialogue: 0,1:29:50.84,1:29:52.13,Default,,0,0,0,,Ашура!
Dialogue: 0,1:29:53.72,1:29:54.38,Default,,0,0,0,,Уау
Dialogue: 0,1:29:54.59,1:29:57.35,Default,,0,0,0,,Шығыс теңізде (Шығыс Көк) туған мен жылқының сүйегі болсам...
Dialogue: 0,1:29:57.93,1:29:59.10,Default,,0,0,0,,Химиялық…
Dialogue: 0,1:29:59.31,1:30:01.43,Default,,0,0,0,,Мен кесетін сен...
Dialogue: 0,1:30:01.56,1:30:03.14,Default,,0,0,0,,Жонглер!
Dialogue: 0,1:30:06.15,1:30:07.31,Default,,0,0,0,,ену!
Dialogue: 0,1:30:07.61,1:30:10.78,Default,,0,0,0,,Уау!
Dialogue: 0,1:30:16.16,1:30:18.83,Default,,0,0,0,,Олар қандай сүйектерге жатады?
Dialogue: 0,1:30:20.12,1:30:21.91,Default,,0,0,0,,Зоро салқын
Dialogue: 0,1:30:22.04,1:30:23.66,Default,,0,0,0,,Ол өлмес пе?
Dialogue: 0,1:30:23.79,1:30:24.96,Default,,0,0,0,,Чоппер (Чоппер) Уа
Dialogue: 0,1:30:25.08,1:30:27.50,Default,,0,0,0,,Ах (Чоппер) Уа!
Dialogue: 0,1:30:28.46,1:30:29.46,Default,,0,0,0,,Антидот
Dialogue: 0,1:30:29.67,1:30:32.13,Default,,0,0,0,,Мен қайтып барамын. Мен Намиді сұрадым.
Dialogue: 0,1:30:32.26,1:30:33.51,Default,,0,0,0,,Иә
Dialogue: 0,1:30:33.63,1:30:34.88,Default,,0,0,0,,Бұл керісінше!
Dialogue: 0,1:30:35.01,1:30:36.76,Default,,0,0,0,,бірақ ол да маған күдікпен қарады…
Dialogue: 0,1:30:40.68,1:30:43.64,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:30:43.77,1:30:47.19,Default,,0,0,0,,Йохохохо... Күткендей.
Dialogue: 0,1:30:47.31,1:30:49.15,Default,,0,0,0,,Мен оны қия алмаймын
Dialogue: 0,1:30:49.27,1:30:53.44,Default,,0,0,0,,Уу-уууу... Ой? Бұл жолмен?
Dialogue: 0,1:30:54.28,1:30:56.45,Default,,0,0,0,,Бізге тез сүңгуді үйретіңізші.
Dialogue: 0,1:30:56.82,1:30:57.61,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,1:31:02.58,1:31:04.12,Default,,0,0,0,,Хехехе
Dialogue: 0,1:31:04.41,1:31:05.91,Default,,0,0,0,,Уф
Dialogue: 0,1:31:06.12,1:31:07.21,Default,,0,0,0,,Робин-чан!
Dialogue: 0,1:31:07.42,1:31:09.29,Default,,0,0,0,,Ухохо Ухохо…
Dialogue: 0,1:31:09.71,1:31:11.67,Default,,0,0,0,,Не!
Dialogue: 0,1:31:12.00,1:31:14.55,Default,,0,0,0,,Робинге үйленсең ше?
Dialogue: 0,1:31:14.67,1:31:17.68,Default,,0,0,0,,Қарғыс атқыр эротикалық горилла!
Dialogue: 0,1:31:17.80,1:31:19.80,Default,,0,0,0,,Сөздерді түсіндің бе?
Dialogue: 0,1:31:24.56,1:31:28.14,Default,,0,0,0,,Сен істедің, қарғыс атқыр эротикалық горилла.
Dialogue: 0,1:31:28.64,1:31:31.11,Default,,0,0,0,,Ол менің алдымдағы ханымның үстіне қолын қойды.
Dialogue: 0,1:31:32.73,1:31:34.03,Default,,0,0,0,,(Маймыл сарбазының айқайы)
Dialogue: 0,1:31:34.32,1:31:35.19,Default,,0,0,0,,Бұл ыңғайсыздық!
Dialogue: 0,1:31:36.28,1:31:37.95,Default,,0,0,0,,Робин!
Dialogue: 0,1:31:38.82,1:31:41.49,Default,,0,0,0,,Ууууах!
Dialogue: 0,1:31:45.87,1:31:49.04,Default,,0,0,0,,Балалар, менің айтып отырғаным осы.
Dialogue: 0,1:31:49.67,1:31:51.71,Default,,0,0,0,,Сіз қай теңізді билейсіз?
Dialogue: 0,1:31:52.42,1:31:54.55,Default,,0,0,0,,Эй, сен білесің бе?
Dialogue: 0,1:31:54.67,1:31:58.67,Default,,0,0,0,,Шығыс теңізде (Шығыс көк) қанша ханымдар бар!
Dialogue: 0,1:32:01.34,1:32:03.93,Default,,0,0,0,,Өтінемін, мұндай істерді қойшы.
Dialogue: 0,1:32:04.35,1:32:05.72,Default,,0,0,0,,О? иә? ау
Dialogue: 0,1:32:07.31,1:32:08.89,Default,,0,0,0,,Ібіліс стиліндегі аяқтар...
Dialogue: 0,1:32:09.23,1:32:12.15,Default,,0,0,0,,(Скарлеттің қабығы)
Dialogue: 0,1:32:13.61,1:32:14.27,Default,,0,0,0,,Не!?
Dialogue: 0,1:32:14.52,1:32:16.40,Default,,0,0,0,,Аң еті (Venaison) түсіріңіз!
Dialogue: 0,1:32:16.57,1:32:19.57,Default,,0,0,0,,(Скарлеттің ыңырсыуы)
Dialogue: 0,1:32:20.20,1:32:22.53,Default,,0,0,0,,Эй!
Dialogue: 0,1:32:22.99,1:32:23.91,Default,,0,0,0,,Ах!
Dialogue: 0,1:32:24.03,1:32:25.37,Default,,0,0,0,,Уф
Dialogue: 0,1:32:25.45,1:32:28.79,Default,,0,0,0,,(Скарлеттің айқайы)
Dialogue: 0,1:32:35.54,1:32:38.67,Default,,0,0,0,,Шығыс теңіздегі махаббат дәмі (Шығыс көк)
Dialogue: 0,1:32:38.84,1:32:40.38,Default,,0,0,0,,Ой, Робин Чан
Dialogue: 0,1:32:43.93,1:32:45.76,Default,,0,0,0,,Йохохохо…
Dialogue: 0,1:32:46.64,1:32:47.68,Default,,0,0,0,,Иә, не!
Dialogue: 0,1:32:47.93,1:32:50.69,Default,,0,0,0,,Жақсысың ба? мамаузель
Dialogue: 0,1:32:50.81,1:32:52.65,Default,,0,0,0,,Бір күні тозаққа түсіп кетермін.
Dialogue: 0,1:32:53.23,1:32:55.48,Default,,0,0,0,,Ей, қандай дәмді тағам әкелдің!
Dialogue: 0,1:32:55.61,1:32:56.44,Default,,0,0,0,,Мен сені жерге тастаймын, қарғыс атқыр...
Dialogue: 0,1:32:56.57,1:32:57.98,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,1:33:00.86,1:33:04.20,Default,,0,0,0,,Мені жерге тастамаймын.
Dialogue: 0,1:33:06.58,1:33:08.20,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:33:09.16,1:33:11.37,Default,,0,0,0,,Қалай болғанда да Намидің қауіпсіздігі бірінші орында.
Dialogue: 0,1:33:11.66,1:33:12.67,Default,,0,0,0,,Усопп?
Dialogue: 0,1:33:12.79,1:33:13.96,Default,,0,0,0,,That's right.
Dialogue: 0,1:33:14.08,1:33:16.29,Default,,0,0,0,,Сондай-ақ Chopper сияқты естіледі
Dialogue: 0,1:33:18.88,1:33:19.80,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,1:33:20.01,1:33:22.26,Default,,0,0,0,,Нами Жақсы.
Dialogue: 0,1:33:22.38,1:33:25.93,Default,,0,0,0,,Сіз ояндыңыз ба? Антидот жұмыс істеген сияқты.
Dialogue: 0,1:33:26.30,1:33:27.56,Default,,0,0,0,,Маған көмектесуге келдің бе?
Dialogue: 0,1:33:27.81,1:33:30.60,Default,,0,0,0,,Хехе, әрине жалғыз біз емеспіз.
Dialogue: 0,1:33:31.06,1:33:33.77,Default,,0,0,0,,Зоро, Санджи, Робин, Фрэнки, Брук...
Dialogue: 0,1:33:33.89,1:33:36.56,Default,,0,0,0,,Луффи де! Бәріміз келдік
Dialogue: 0,1:33:37.52,1:33:40.03,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:33:40.15,1:33:41.90,Default,,0,0,0,,Рахмет
Dialogue: 0,1:33:42.19,1:33:45.66,Default,,0,0,0,,Ей, қазір жылайтын уақыт емес.
Dialogue: 0,1:33:46.37,1:33:47.16,Default,,0,0,0,,Мен білемін
Dialogue: 0,1:33:48.20,1:33:51.83,Default,,0,0,0,,Шикиді жеңбесең, Шығыс теңізі (Шығыс көк)... Иә?
Dialogue: 0,1:33:56.25,1:33:57.75,Default,,0,0,0,,Бұл...
Dialogue: 0,1:33:57.88,1:33:59.80,Default,,0,0,0,,Тоқта (Усопп Чоппер) Ой...
Dialogue: 0,1:33:59.92,1:34:01.38,Default,,0,0,0,,Нами, не болды?
Dialogue: 0,1:34:01.88,1:34:03.59,Default,,0,0,0,,Дауыл келе жатыр (Чоппер) Иә?
Dialogue: 0,1:34:04.22,1:34:08.35,Default,,0,0,0,,Атмосфералық қысым төмендейді. Жақын жерде үлкен бұлт болуы керек.
Dialogue: 0,1:34:08.47,1:34:09.85,Default,,0,0,0,,Мен сарайға қайтамын.
Dialogue: 0,1:34:09.97,1:34:12.06,Default,,0,0,0,,Ә!?
Dialogue: 0,1:34:15.56,1:34:17.06,Default,,0,0,0,,Куә!
Dialogue: 0,1:34:17.19,1:34:18.15,Default,,0,0,0,,Га
Dialogue: 0,1:34:18.23,1:34:19.69,Default,,0,0,0,,Кешір, Ииджичи-сан
Dialogue: 0,1:34:20.11,1:34:22.28,Default,,0,0,0,,Уау! Уау
Dialogue: 0,1:34:22.57,1:34:23.65,Default,,0,0,0,,Уау!
Dialogue: 0,1:34:26.49,1:34:27.49,Default,,0,0,0,,(Джура құстың сайрауы)
Dialogue: 0,1:34:27.70,1:34:29.20,Default,,0,0,0,,Ха! Апыр-ай!
Dialogue: 0,1:34:30.99,1:34:31.70,Default,,0,0,0,,Қуа
Dialogue: 0,1:34:32.04,1:34:33.66,Default,,0,0,0,,Билли, жақсысың ба?
Dialogue: 0,1:34:33.79,1:34:35.08,Default,,0,0,0,,Куә!
Dialogue: 0,1:34:42.13,1:34:44.72,Default,,0,0,0,,Қорытынды жасайтын уақыт келді
Dialogue: 0,1:34:45.26,1:34:46.55,Default,,0,0,0,,Занба!
Dialogue: 0,1:34:53.47,1:34:55.35,Default,,0,0,0,,Куә!
Dialogue: 0,1:35:10.28,1:35:13.91,Default,,0,0,0,,Джихахха... Бұл шайқас болды, балам.
Dialogue: 0,1:35:14.04,1:35:16.54,Default,,0,0,0,,Пурпурпуруру Гача
Dialogue: 0,1:35:16.91,1:35:18.62,Default,,0,0,0,,Штурман командасынан Шики-самаға дейін
Dialogue: 0,1:35:18.75,1:35:20.67,Default,,0,0,0,,Штурман командасынан Шики-самаға дейін
Dialogue: 0,1:35:20.79,1:35:21.46,Default,,0,0,0,,Не?
Dialogue: 0,1:35:21.88,1:35:25.17,Default,,0,0,0,,Аралды шығысқа бұрыңыз. Дауыл келе жатыр!
Dialogue: 0,1:35:25.71,1:35:27.30,Default,,0,0,0,,Дауыл туралы не деуге болады?
Dialogue: 0,1:35:31.64,1:35:32.51,Default,,0,0,0,,(қосу дыбысы)
Dialogue: 0,1:35:32.64,1:35:35.85,Default,,0,0,0,,Бұл... жақсы ма? Хе
Dialogue: 0,1:35:35.98,1:35:38.23,Default,,0,0,0,,(Екі адам еңіреп)
Dialogue: 0,1:35:38.44,1:35:39.60,Default,,0,0,0,,Хе!
Dialogue: 0,1:35:40.48,1:35:43.02,Default,,0,0,0,,Нами... Жарайды, солай ма?
Dialogue: 0,1:35:43.15,1:35:45.03,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,1:35:45.15,1:35:48.70,Default,,0,0,0,,Бірақ жақсы ма? дауылға батып кету
Dialogue: 0,1:35:48.82,1:35:50.03,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,1:35:50.24,1:35:51.53,Default,,0,0,0,,Эх!
Dialogue: 0,1:35:55.49,1:35:58.33,Default,,0,0,0,,Бірақ бұл мұны істеудің жалғыз жолы
Dialogue: 0,1:36:05.55,1:36:09.30,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,1:36:10.43,1:36:12.39,Default,,0,0,0,,Осыған ұқсас нәрсе бар ма?
Dialogue: 0,1:36:12.80,1:36:13.64,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,1:36:14.68,1:36:18.81,Default,,0,0,0,,Шайтанның жемісі бар адамға қиын болуы керек.
Dialogue: 0,1:36:19.31,1:36:22.77,Default,,0,0,0,,Мен енді жастық еркіммен өмір сүре алмаймын.
Dialogue: 0,1:36:22.90,1:36:26.11,Default,,0,0,0,,Шығыс теңізі (Шығыс көк) және сол кішкентай қыз да.
Dialogue: 0,1:36:26.23,1:36:28.24,Default,,0,0,0,,Үмітсіздіктен өлу
Dialogue: 0,1:36:28.32,1:36:30.91,Default,,0,0,0,,Оған басқа әлемнен қараңыз
Dialogue: 0,1:36:31.03,1:36:34.99,Default,,0,0,0,,Арыстан Чикирия!
Dialogue: 0,1:36:39.71,1:36:42.50,Default,,0,0,0,,Уау!
Dialogue: 0,1:36:51.22,1:36:54.64,Default,,0,0,0,,Жихаха...
Dialogue: 0,1:36:54.76,1:36:56.93,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,1:36:57.43,1:36:58.39,Default,,0,0,0,,Пермь?
Dialogue: 0,1:36:58.47,1:37:00.48,Default,,0,0,0,,(Найзағай)
Dialogue: 0,1:37:00.77,1:37:04.98,Default,,0,0,0,,(Алып тіршілік иелерінің дыбыстары)
Dialogue: 0,1:37:05.19,1:37:08.07,Default,,0,0,0,,Не? (Қарақшылар) Құбыжықтар қашып кетеді.
Dialogue: 0,1:37:08.53,1:37:11.70,Default,,0,0,0,,Дауыл! Бұл арал дауылға ұрынуда!
Dialogue: 0,1:37:11.82,1:37:13.95,Default,,0,0,0,,Не!? Уф
Dialogue: 0,1:37:14.07,1:37:16.37,Default,,0,0,0,,Сәлем, балалар! Теңізге қарай жүгірейік!
Dialogue: 0,1:37:16.49,1:37:20.16,Default,,0,0,0,,(Қарақшылар айқайлайды)
Dialogue: 0,1:37:22.12,1:37:25.58,Default,,0,0,0,,Бұлттар біртүрлі бағытта келе жатқандай болды.
Dialogue: 0,1:37:32.51,1:37:34.76,Default,,0,0,0,,Сол құбыжық та құрбан.
Dialogue: 0,1:37:34.89,1:37:38.47,Default,,0,0,0,,Бұл препарат мені осылай жасауға мәжбүр етті.
Dialogue: 0,1:37:38.60,1:37:39.81,Default,,0,0,0,,(Цезарь) Оны «Лиза Лиза» деп атайды.
Dialogue: 0,1:37:39.97,1:37:44.19,Default,,0,0,0,,(Бруктың айқайы)
Dialogue: 0,1:37:44.31,1:37:45.60,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:45.73,1:37:49.73,Default,,0,0,0,,Жоқ, бұл қиын жұмыс.
Dialogue: 0,1:37:50.07,1:37:54.45,Default,,0,0,0,,Аа, егер ол шынымен бұзылса, бұл үлкен мәселе, бірақ менің жағдайымда
Dialogue: 0,1:37:54.57,1:37:57.41,Default,,0,0,0,,Йохохохо... хаа
Dialogue: 0,1:37:57.83,1:38:02.58,Default,,0,0,0,,Ку… Ку…
Dialogue: 0,1:38:02.71,1:38:04.21,Default,,0,0,0,,Кво
Dialogue: 0,1:38:05.79,1:38:08.63,Default,,0,0,0,,Билли, сен әлі де ұша аласың ба?
Dialogue: 0,1:38:09.80,1:38:13.01,Default,,0,0,0,,Куо quaa!
Dialogue: 0,1:38:13.17,1:38:14.68,Default,,0,0,0,,Хи хи
Dialogue: 0,1:38:14.84,1:38:19.76,Default,,0,0,0,,Уау!
Dialogue: 0,1:38:21.47,1:38:23.23,Default,,0,0,0,,Мен оны ұшырып жіберемін!
Dialogue: 0,1:38:24.81,1:38:25.94,Default,,0,0,0,,Мені сұра
Dialogue: 0,1:38:26.77,1:38:27.90,Default,,0,0,0,,Аспанға дейін!
Dialogue: 0,1:38:28.61,1:38:30.48,Default,,0,0,0,,Куә!
Dialogue: 0,1:38:30.94,1:38:31.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:38:31.94,1:38:34.65,Default,,0,0,0,,Кво
Dialogue: 0,1:38:36.07,1:38:37.36,Default,,0,0,0,,Куә!
Dialogue: 0,1:38:37.82,1:38:39.33,Default,,0,0,0,,Бірақ аталған адам өз келісімін берді
Dialogue: 0,1:38:39.45,1:38:40.87,Default,,0,0,0,,Шики!
Dialogue: 0,1:38:41.33,1:38:42.12,Default,,0,0,0,,Әй?
Dialogue: 0,1:38:42.70,1:38:44.00,Default,,0,0,0,,Хаха...
Dialogue: 0,1:38:44.16,1:38:46.75,Default,,0,0,0,,Нами! Мен өте өкінемін!
Dialogue: 0,1:38:46.83,1:38:49.04,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:38:49.46,1:38:51.50,Default,,0,0,0,,Бұл Нами! (Билли) Қуаа
Dialogue: 0,1:38:51.96,1:38:54.21,Default,,0,0,0,,Енді бәрі бітті.
Dialogue: 0,1:38:54.51,1:38:56.68,Default,,0,0,0,,Жарылуға дайын!
Dialogue: 0,1:38:57.22,1:38:59.55,Default,,0,0,0,,Жарылыс... сонда?
Dialogue: 0,1:39:00.10,1:39:01.51,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,1:39:02.81,1:39:06.94,Default,,0,0,0,,Зауыттан да, патша сарайынан да, аралдан да ештеңе қалмады!
Dialogue: 0,1:39:07.44,1:39:10.15,Default,,0,0,0,,Сіздің барлық жоспарларыңыз аяқталды!
Dialogue: 0,1:39:11.23,1:39:14.61,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,1:39:18.66,1:39:20.49,Default,,0,0,0,,Хмм, Нами-сан!
Dialogue: 0,1:39:20.66,1:39:21.83,Default,,0,0,0,,Хмм...
Dialogue: 0,1:39:22.45,1:39:24.75,Default,,0,0,0,,Сіздей жастарға
Dialogue: 0,1:39:24.87,1:39:29.46,Default,,0,0,0,,Менің 20 жылдық жоспарымды бұза алмайсың деп ойлаймын!
Dialogue: 0,1:39:30.92,1:39:35.80,Default,,0,0,0,,Жеңдер! Өлімге толы Тенрюсей!
Dialogue: 0,1:39:35.92,1:39:37.22,Default,,0,0,0,,(Айдаһардың шұңқыры)
Dialogue: 0,1:39:37.47,1:39:40.34,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,1:39:44.89,1:39:47.85,Default,,0,0,0,,Коке қорқынышты! Нуаа!
Dialogue: 0,1:39:48.77,1:39:51.06,Default,,0,0,0,,Билли! Намиге көмектес
Dialogue: 0,1:39:51.19,1:39:53.65,Default,,0,0,0,,Керемет!
Dialogue: 0,1:39:54.32,1:39:54.98,Default,,0,0,0,,Уау
Dialogue: 0,1:39:55.61,1:39:57.03,Default,,0,0,0,,Нами-сан!
Dialogue: 0,1:39:57.32,1:39:58.24,Default,,0,0,0,,Мен ше?
Dialogue: 0,1:40:00.28,1:40:02.03,Default,,0,0,0,,Кукуа
Dialogue: 0,1:40:02.32,1:40:03.12,Default,,0,0,0,,Билли!
Dialogue: 0,1:40:03.37,1:40:05.08,Default,,0,0,0,,Мен бірде ескі жазбаларда осындай зерттеулерді кездестіргенмін.
Dialogue: 0,1:40:05.20,1:40:07.08,Default,,0,0,0,,Бұл сіздің қарсыласыңыз! Шики!
Dialogue: 0,1:40:07.08,1:40:07.91,Default,,0,0,0,,Бұл сіздің қарсыласыңыз! Шики!
Dialogue: 0,1:40:07.08,1:40:07.91,Default,,0,0,0,,Әй?
Dialogue: 0,1:40:08.16,1:40:09.71,Default,,0,0,0,,3-беріліс (Үшінші)!
Dialogue: 0,1:40:11.83,1:40:14.55,Default,,0,0,0,,Сүйек шары!
Dialogue: 0,1:40:16.71,1:40:19.05,Default,,0,0,0,,Барлығына! Лион-Чанға асығыңыз
Dialogue: 0,1:40:19.34,1:40:20.68,Default,,0,0,0,,(Усопптың ыңырануы)
Dialogue: 0,1:40:33.65,1:40:34.61,Default,,0,0,0,,Не? Иә
Dialogue: 0,1:40:37.03,1:40:41.07,Default,,0,0,0,,Өлім - бұл шығын! Найзағай соғып, құлаңыз!
Dialogue: 0,1:40:41.32,1:40:43.32,Default,,0,0,0,,Құлап бара жатқан сенсің! Шики!
Dialogue: 0,1:40:43.32,1:40:43.99,Default,,0,0,0,,Құлап бара жатқан сенсің! Шики!
Dialogue: 0,1:40:43.32,1:40:43.99,Default,,0,0,0,,Әй?
Dialogue: 0,1:40:44.87,1:40:49.96,Default,,0,0,0,,Мен сені Шығыс теңізіне (Шығыс көкке) жібермеймін!
Dialogue: 0,1:40:52.71,1:40:54.00,Default,,0,0,0,,Бұл маңызды емес, иә?
Dialogue: 0,1:40:54.17,1:40:57.80,Default,,0,0,0,,Жихахаха! Ақымақ!
Dialogue: 0,1:40:59.88,1:41:01.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:02.38,1:41:03.51,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:03.68,1:41:04.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:04.97,1:41:07.35,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,1:41:07.72,1:41:09.85,Default,,0,0,0,,Келді, келді, келді!
Dialogue: 0,1:41:09.93,1:41:14.06,Default,,0,0,0,,Жасай бер! Луффи!!
Dialogue: 0,1:41:14.77,1:41:19.53,Default,,0,0,0,,Мен! Бұл теңізді аспаннан басқаратын адам!
Dialogue: 0,1:41:19.90,1:41:23.49,Default,,0,0,0,,Сізге... және достарыңызға да!
Dialogue: 0,1:41:25.07,1:41:26.28,Default,,0,0,0,,Теңіз де!
Dialogue: 0,1:41:27.95,1:41:32.33,Default,,0,0,0,,Қалағанымды істеуге рұқсат етіңіз!!
Dialogue: 0,1:41:33.17,1:41:34.00,Default,,0,0,0,,Әй?
Dialogue: 0,1:41:34.54,1:41:36.84,Default,,0,0,0,,Гигант Тор…
Dialogue: 0,1:41:36.96,1:41:38.17,Default,,0,0,0,,Уф
Dialogue: 0,1:41:40.59,1:41:43.05,Default,,0,0,0,,Балта!
Dialogue: 0,1:41:50.52,1:41:53.23,Default,,0,0,0,,Шығыс теңізден келген адамға (Шығыс көк)
Dialogue: 0,1:41:53.31,1:41:56.27,Default,,0,0,0,,Мен қайтадан бұғатталады ма?
Dialogue: 0,1:41:57.11,1:42:00.94,Default,,0,0,0,,Роджер!!
Dialogue: 0,1:42:05.91,1:42:07.53,Default,,0,0,0,,(Алып тіршілік иелерінің айқайы)
Dialogue: 0,1:42:15.75,1:42:19.29,Default,,0,0,0,,Ұшайық! Ұстап ал!
Dialogue: 0,1:42:19.50,1:42:21.63,Default,,0,0,0,,Ku de Burst!
Dialogue: 0,1:42:26.30,1:42:27.68,Default,,0,0,0,,Уф
Dialogue: 0,1:42:27.97,1:42:29.47,Default,,0,0,0,,Луффи!
Dialogue: 0,1:42:29.85,1:42:30.85,Default,,0,0,0,,Луффи-сан!
Dialogue: 0,1:42:31.22,1:42:33.23,Default,,0,0,0,,Луффи... (2 адам) Ах...
Dialogue: 0,1:42:34.06,1:42:35.98,Default,,0,0,0,,Билли?
Dialogue: 0,1:42:36.06,1:42:38.44,Default,,0,0,0,,Қарғыс атсын Билли!
Dialogue: 0,1:42:50.16,1:42:51.87,Default,,0,0,0,,Уф
Dialogue: 0,1:43:00.92,1:43:01.96,Default,,0,0,0,,Луффи...
Dialogue: 0,1:43:02.34,1:43:03.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:43:08.43,1:43:10.85,Default,,0,0,0,,Уау...
Dialogue: 0,1:43:11.05,1:43:12.10,Default,,0,0,0,,​​О?
Dialogue: 0,1:43:12.39,1:43:15.98,Default,,0,0,0,,Тұрғындар балық аулау мен егіншілікпен күнкөреді—
Dialogue: 0,1:43:16.35,1:43:18.27,Default,,0,0,0,,Луффи? Қайда... қайда?
Dialogue: 0,1:43:18.69,1:43:23.78,Default,,0,0,0,,Қазір он жылға жуық уақыт болды, иә? Ол анама тіпті кешірім сұрауға да келген жоқ
Dialogue: 0,1:43:25.36,1:43:26.86,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:43:27.07,1:43:29.45,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,1:43:29.57,1:43:32.28,Default,,0,0,0,,Иә, бұл өте жақсы болды.
Dialogue: 0,1:43:32.45,1:43:36.25,Default,,0,0,0,,Біз мұны жасадық! Енді Шығыс теңізі (Шығыс көк) қауіпсіз!
Dialogue: 0,1:43:36.62,1:43:39.33,Default,,0,0,0,,Бірақ бұл көрсеткіш күшейтілмейді.
Dialogue: 0,1:43:41.46,1:43:42.13,Default,,0,0,0,,О
Dialogue: 0,1:43:42.59,1:43:44.80,Default,,0,0,0,,Иә, шынымен.
Dialogue: 0,1:43:44.96,1:43:46.38,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,1:43:50.51,1:43:53.14,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:44:04.86,1:44:05.53,Default,,0,0,0,,Әй?
Dialogue: 0,1:44:08.74,1:44:10.16,Default,,0,0,0,,Хмм? Иә...
Dialogue: 0,1:44:13.08,1:44:16.08,Default,,0,0,0,,Шикидің қабілеті ашылды.
Dialogue: 0,1:44:18.37,1:44:20.62,Default,,0,0,0,,(Алып тіршілік иелерінің айқайы)
Dialogue: 0,1:44:20.79,1:44:23.29,Default,,0,0,0,,Ха, Сяо және басқалары?
Dialogue: 0,1:44:23.42,1:44:25.55,Default,,0,0,0,,Эй, мынаны қарашы.
Dialogue: 0,1:44:32.14,1:44:36.89,Default,,0,0,0,,(Сяоның күлкісі)
Dialogue: 0,1:44:39.64,1:44:41.31,Default,,0,0,0,,Хахаха хоо
Dialogue: 0,1:44:41.65,1:44:43.40,Default,,0,0,0,,Жақсы...
Dialogue: 0,1:44:43.73,1:44:45.27,Default,,0,0,0,,Уф Нами
Dialogue: 0,1:44:45.82,1:44:47.23,Default,,0,0,0,,Нами-сан Нами
Dialogue: 0,1:44:47.36,1:44:48.94,Default,,0,0,0,,Сәлем Нами
Dialogue: 0,1:44:49.57,1:44:51.57,Default,,0,0,0,,Салқын
Dialogue: 0,1:45:10.34,1:45:12.93,Default,,0,0,0,,Арал құлап жатыр!
Dialogue: 0,1:45:13.43,1:45:15.76,Default,,0,0,0,,Қаш! Бұл жерден кетіңіз!
Dialogue: 0,1:45:15.89,1:45:17.31,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:45:47.71,1:45:50.55,Default,,0,0,0,,(Алып тіршілік иелерінің айқайы)
Dialogue: 0,1:45:50.63,1:45:55.22,Default,,0,0,0,,(Көк Джектің айқайы)
Dialogue: 0,1:46:04.48,1:46:05.98,Default,,0,0,0,,Шики сонда болды!
Dialogue: 0,1:46:06.10,1:46:08.90,Default,,0,0,0,,Бұл Шики Алтын арыстан. Оны ұстаңыз!
Dialogue: 0,1:46:15.86,1:46:19.41,Default,,0,0,0,,Осының бәрін олар жасады ма?
Dialogue: 0,1:46:19.87,1:46:23.87,Default,,0,0,0,,«Мақсатты қақпақ» қарақшылары! Атысуға дайын!
Dialogue: 0,1:46:24.00,1:46:24.66,Default,,0,0,0,,Ха!
Dialogue: 0,1:46:37.14,1:46:39.14,Default,,0,0,0,,Дұрыс, әлгі сабан қалпақ қарақшылары.
Dialogue: 0,1:46:39.89,1:46:41.14,Default,,0,0,0,,Мугивара…
Dialogue: 0,1:46:41.56,1:46:44.02,Default,,0,0,0,,Біз қазір ақпаратты жинақтап жатырмыз.
Dialogue: 0,1:46:44.14,1:46:46.35,Default,,0,0,0,,Мәліметтер кейінірек хабарланады.
Dialogue: 0,1:46:46.69,1:46:49.31,Default,,0,0,0,,(Тодороки) Мен сол жігіттен барынша көп нәрсе үйренгім келеді
Dialogue: 0,1:46:50.23,1:46:51.57,Default,,0,0,0,,(күрсіну)
Dialogue: 0,1:46:52.78,1:46:56.66,Default,,0,0,0,,Біз ештеңе істеген жоқпыз...
Dialogue: 0,1:47:02.41,1:47:05.12,Default,,0,0,0,,Не істесең де жақсы.
Dialogue: 0,1:47:05.33,1:47:07.42,Default,,0,0,0,,Мен күткеннен тезірек қалпына келдім.
Dialogue: 0,1:47:07.54,1:47:10.29,Default,,0,0,0,,Аа, бірақ сіз әлі өзіңізді қатты итермеуіңіз керек.
Dialogue: 0,1:47:10.67,1:47:14.26,Default,,0,0,0,,Жарайды, мен таза ауа алғым келеді.
Dialogue: 0,1:47:14.59,1:47:18.22,Default,,0,0,0,,Мен көрдім бе? Ендеше кеттік, бәрі де бақытты болады.
Dialogue: 0,1:47:18.64,1:47:19.76,Default,,0,0,0,,Иә
Dialogue: 0,1:47:34.61,1:47:36.61,Default,,0,0,0,,Барлығына! Нами оянды
Dialogue: 0,1:47:36.82,1:47:38.45,Default,,0,0,0,,Не! (2 адам) О!
Dialogue: 0,1:47:38.61,1:47:39.49,Default,,0,0,0,,Иә?
Dialogue: 0,1:47:39.57,1:47:41.83,Default,,0,0,0,,Нами!
Dialogue: 0,1:47:41.95,1:47:43.70,Default,,0,0,0,,Уа, жеткілікті ме?
Dialogue: 0,1:47:43.83,1:47:44.95,Default,,0,0,0,,Иә, толығымен
Dialogue: 0,1:47:45.29,1:47:47.58,Default,,0,0,0,,Эрен сияқты, бронясымен және Коллоссал Титанмен
Dialogue: 0,1:47:47.71,1:47:49.50,Default,,0,0,0,,Қазір өзімді жақсы сезінемін...
Dialogue: 0,1:47:50.08,1:47:51.84,Default,,0,0,0,,Кешіріңіз, Нами-сан, шалбар...
Dialogue: 0,1:47:51.96,1:47:54.46,Default,,0,0,0,,Тоқта! (соққы дыбысы)
Dialogue: 0,1:47:54.59,1:47:55.34,Default,,0,0,0,,Иә
Dialogue: 0,1:47:55.42,1:47:58.80,Default,,0,0,0,,Yohohohoho Бұл тағы да қиын!
Dialogue: 0,1:47:58.93,1:48:01.72,Default,,0,0,0,,Шулы!
Dialogue: 0,1:48:01.89,1:48:03.60,Default,,0,0,0,,Сәлем Нами! иә?
Dialogue: 0,1:48:03.85,1:48:06.14,Default,,0,0,0,,Сен, бұл не?
Dialogue: 0,1:48:06.35,1:48:08.23,Default,,0,0,0,,О, сәл күте тұрыңыз.
Dialogue: 0,1:48:08.52,1:48:11.77,Default,,0,0,0,,Мен Шикиге тең келмейтінімді, бәрі өлетінін...
Dialogue: 0,1:48:11.90,1:48:13.82,Default,,0,0,0,,Сол ақымақ сөздерді қалдырып
Dialogue: 0,1:48:13.94,1:48:16.94,Default,,0,0,0,,Олай болса, мені жер жұтып қойды.
Dialogue: 0,1:48:17.07,1:48:19.11,Default,,0,0,0,,Иә, менің де қарным ашты.
Dialogue: 0,1:48:19.28,1:48:22.03,Default,,0,0,0,,Ой, мен де солай ойладым...
Dialogue: 0,1:48:22.32,1:48:23.91,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,1:48:24.03,1:48:28.04,Default,,0,0,0,,Осы ұзақ қарым-қатынастан кейін мен сені соншалықты сенімсіз деп ойламадым.
Dialogue: 0,1:48:28.16,1:48:29.58,Default,,0,0,0,,Менің көңілім қалды.
Dialogue: 0,1:48:32.00,1:48:34.54,Default,,0,0,0,,Луффи? Сіз не айттыңыз?
Dialogue: 0,1:48:35.05,1:48:37.17,Default,,0,0,0,,А? Бұл не?
Dialogue: 0,1:48:37.51,1:48:39.67,Default,,0,0,0,,Мұны естімегеніңізге сенімдісіз бе?
Dialogue: 0,1:48:40.05,1:48:42.80,Default,,0,0,0,,Нами мұны айтудан басқа амалы қалмаған жағдайда қалды.
Dialogue: 0,1:48:43.01,1:48:46.31,Default,,0,0,0,,Соңғысын естігенде мен де солай ойладым.
Dialogue: 0,1:48:46.56,1:48:48.02,Default,,0,0,0,,Соңында бұл не?
Dialogue: 0,1:48:48.35,1:48:50.98,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,1:48:51.48,1:48:55.19,Default,,0,0,0,,Дегенмен, маған бәрі махаббат хабары сияқты көрінді.
Dialogue: 0,1:48:55.32,1:48:56.73,Default,,0,0,0,,Йохохохо…
Dialogue: 0,1:48:56.98,1:49:00.99,Default,,0,0,0,,Дүниедегі ең түңғыш адам, саған айтқаным сияқты.
Dialogue: 0,1:49:01.28,1:49:03.32,Default,,0,0,0,,Оны қайта тыңдау керек.
Dialogue: 0,1:49:03.45,1:49:04.32,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,1:49:04.45,1:49:06.45,Default,,0,0,0,,Сәлем! А, түсіндім
Dialogue: 0,1:49:06.58,1:49:07.08,Default,,0,0,0,,О, не, тоқтат.
Dialogue: 0,1:49:07.08,1:49:08.12,Default,,0,0,0,,О, не, тоқтат.
Dialogue: 0,1:49:07.08,1:49:08.12,Default,,0,0,0,,Барлығының көзінше
Dialogue: 0,1:49:08.54,1:49:08.87,Default,,0,0,0,,Бұл жеткілікті. Бұл ұят емес.
Dialogue: 0,1:49:08.87,1:49:10.91,Default,,0,0,0,,Бұл жеткілікті. Бұл ұят емес.
Dialogue: 0,1:49:08.87,1:49:10.91,Default,,0,0,0,,Маған үнсіз кетуге рұқсат етіңіз.
Dialogue: 0,1:49:11.04,1:49:12.33,Default,,0,0,0,,Тыныш болыңыз!
Dialogue: 0,1:49:12.46,1:49:12.58,Default,,0,0,0,,Енді бітті, оны лақтыр.
Dialogue: 0,1:49:12.58,1:49:14.92,Default,,0,0,0,,Енді бітті, оны лақтыр.
Dialogue: 0,1:49:12.58,1:49:14.92,Default,,0,0,0,,Мен Шикидің бандасының мүшесімін—
Dialogue: 0,1:49:14.92,1:49:15.04,Default,,0,0,0,,Енді бітті, оны лақтыр.
Dialogue: 0,1:49:15.04,1:49:16.00,Default,,0,0,0,,Енді бітті, оны таста.
Dialogue: 0,1:49:15.04,1:49:16.00,Default,,0,0,0,,Навигатор болып жұмыс істеу үшін...
Dialogue: 0,1:49:16.00,1:49:16.13,Default,,0,0,0,,Енді бітті, оны таста.
Dialogue: 0,1:49:16.13,1:49:16.50,Default,,0,0,0,,Енді бітті, оны таста.
Dialogue: 0,1:49:16.13,1:49:16.50,Default,,0,0,0,,(басылған моллюскалар дыбысы)
Dialogue: 0,1:49:16.50,1:49:16.63,Default,,0,0,0,,(басылған ұлулардың дыбысы)
Dialogue: 0,1:49:16.63,1:49:17.59,Default,,0,0,0,,Ах!
Dialogue: 0,1:49:16.63,1:49:17.59,Default,,0,0,0,,(басылған ұлулардың дыбысы)
Dialogue: 0,1:49:18.92,1:49:20.92,Default,,0,0,0,,Уау ааа?
Dialogue: 0,1:49:21.05,1:49:22.88,Default,,0,0,0,,Әй, әй, асыл ұлуларыңды тастама.
Dialogue: 0,1:49:22.88,1:49:23.51,Default,,0,0,0,,Әй, әй, асыл ұлуларыңды тастама.
Dialogue: 0,1:49:22.88,1:49:23.51,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:49:23.51,1:49:23.64,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:49:23.64,1:49:25.05,Default,,0,0,0,,Мен оны қайта қолданамын
Dialogue: 0,1:49:23.64,1:49:25.05,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:49:25.18,1:49:26.72,Default,,0,0,0,,Эй, уау, эй
Dialogue: 0,1:49:26.85,1:49:28.89,Default,,0,0,0,,Жүр, Нами, оны тастама (моллюскалардың итеріп жатқан дыбысы)
Dialogue: 0,1:49:29.02,1:49:30.64,Default,,0,0,0,,Барлығының көзінше
Dialogue: 0,1:49:31.06,1:49:33.94,Default,,0,0,0,,Маған үнсіз кетуге рұқсат етіңіз.
Dialogue: 0,1:49:34.69,1:49:38.73,Default,,0,0,0,,Мен Шикидің экипажында штурман болып жұмыс істеуді шештім.
Dialogue: 0,1:49:39.65,1:49:42.70,Default,,0,0,0,,Лаффи мен басқалары Шикиге қарсы болса да...
Dialogue: 0,1:49:43.32,1:49:45.82,Default,,0,0,0,,Аты аңызға айналған қарақшы, ешқашан асып түспейтін.
Dialogue: 0,1:49:50.66,1:49:53.25,Default,,0,0,0,,Тіпті менің артымнан бәрі жүрсе де—
Dialogue: 0,1:49:53.79,1:49:56.67,Default,,0,0,0,,Нәтижесінде адам өлімі
Dialogue: 0,1:50:05.26,1:50:07.22,Default,,0,0,0,,Осыны айтайын.
Dialogue: 0,1:50:10.56,1:50:13.23,Default,,0,0,0,,Маған көмектесуге міндетті түрде келіңіз
Dialogue: 0,1:50:15.10,1:50:21.11,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:53:40.35,1:53:46.36,Default,,0,0,0,,~♪
