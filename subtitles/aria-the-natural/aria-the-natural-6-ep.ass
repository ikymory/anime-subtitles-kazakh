Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:27.99,0:00:32.29,Default,,0,0,0,,(Алисаның ұйқысы)
Dialogue: 0,0:00:33.66,0:00:38.33,Default,,0,0,0,,♬～
Dialogue: 0,0:00:38.33,0:00:41.34,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:00:41.34,0:00:47.01,Default,,0,0,0,,♬～
Dialogue: 0,0:00:47.01,0:00:50.68,Default,,0,0,0,,(Президенттің ұйқысы)
Dialogue: 0,0:00:50.68,0:00:54.35,Default,,0,0,0,,(Афинаның ұйықтауы)
Dialogue: 0,0:00:54.35,0:01:14.30,Default,,0,0,0,,♬～
Dialogue: 0,0:01:14.30,0:01:26.98,Default,,0,0,0,,♬～
Dialogue: 0,0:01:26.98,0:01:31.32,Default,,0,0,0,,Қайырлы таң (Ундине) Қайырлы таң
Dialogue: 0,0:01:31.32,0:01:35.66,Default,,0,0,0,,Қайырлы таң (Ундине) Қайырлы таң
Dialogue: 0,0:01:35.66,0:01:37.99,Default,,0,0,0,,Эй, эй, мұнда.
Dialogue: 0,0:01:37.99,0:01:41.00,Default,,0,0,0,,Иә, мен оны асыға күтемін.
Dialogue: 0,0:01:42.00,0:01:44.67,Default,,0,0,0,,Қайырлы таң, Афина-сенпай.
Dialogue: 0,0:01:44.67,0:01:46.67,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:01:46.67,0:01:48.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:48.67,0:01:56.68,Default,,0,0,0,,♬～
Dialogue: 0,0:01:56.68,0:01:59.95,Default,,0,0,0,,<Ай-чан: Нео Венецияда да көктем➡
Dialogue: 0,0:01:59.95,0:02:02.55,Default,,0,0,0,,Ақырзаман жақындап қалды>
Dialogue: 0,0:02:03.62,0:02:09.29,Default,,0,0,0,,<Жақсыма соққан теңіз самалы да мені анда-санда жылытады➡
Dialogue: 0,0:02:09.29,0:02:11.63,Default,,0,0,0,,Ауаның иісі де өзгереді➡
Dialogue: 0,0:02:11.63,0:02:14.96,Default,,0,0,0,,Көп нәрсе өзгере бастауы мүмкін＞
Dialogue: 0,0:02:14.96,0:02:21.64,Default,,0,0,0,,♬～
Dialogue: 0,0:02:21.64,0:02:24.04,Default,,0,0,0,,Алиса!
Dialogue: 0,0:02:25.97,0:02:27.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:27.98,0:02:48.00,Default,,0,0,0,,♬～
Dialogue: 0,0:02:48.00,0:03:07.95,Default,,0,0,0,,♬～
Dialogue: 0,0:03:07.95,0:03:27.97,Default,,0,0,0,,♬～
Dialogue: 0,0:03:27.97,0:03:47.99,Default,,0,0,0,,♬～
Dialogue: 0,0:03:47.99,0:03:50.66,Default,,0,0,0,,Үлкендер, иә? (Айка) А?
Dialogue: 0,0:03:50.66,0:03:55.33,Default,,0,0,0,,Жаттығудан кейін менің бөлмеме анда-санда келгіңіз келе ме?
Dialogue: 0,0:03:55.33,0:03:58.33,Default,,0,0,0,,Не? Жақсы.
Dialogue: 0,0:03:58.33,0:04:04.04,Default,,0,0,0,,♬～
Dialogue: 0,0:04:12.28,0:04:14.62,Default,,0,0,0,,Құдық~ (Президент Ария) Пупупупуи...
Dialogue: 0,0:04:14.62,0:04:16.62,Default,,0,0,0,,Ма ма ма ма ма маа~!
Dialogue: 0,0:04:16.62,0:04:18.62,Default,,0,0,0,,Пуиню~!
Dialogue: 0,0:04:21.96,0:04:24.63,Default,,0,0,0,,Пуи Пуи Пуи...
Dialogue: 0,0:04:24.63,0:04:26.96,Default,,0,0,0,,Хэхе~
Dialogue: 0,0:04:26.96,0:04:30.30,Default,,0,0,0,,Ал, президент Арияның шайнайтын понпоны.
Dialogue: 0,0:04:30.30,0:04:32.63,Default,,0,0,0,,Бұл менің ең жақсы көретінім.
Dialogue: 0,0:04:32.63,0:04:34.64,Default,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,0:04:34.64,0:04:38.64,Default,,0,0,0,,Президент әлі төсекке өздігінен көтеріле алмайды.
Dialogue: 0,0:04:38.64,0:04:42.64,Default,,0,0,0,,Президент Арияның жабысқақ помпондары сізді тістеп алады деп уайымдаудың қажеті жоқ.
Dialogue: 0,0:04:42.64,0:04:44.65,Default,,0,0,0,,Бұл үлкен және қауіпсіз.
Dialogue: 0,0:04:45.65,0:04:48.05,Default,,0,0,0,,Жарайды, ойын бар!
Dialogue: 0,0:04:48.98,0:04:51.99,Default,,0,0,0,,Ойын кезінде басқа жаққа қарауға сен кінәлісің.
Dialogue: 0,0:04:51.99,0:04:53.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:53.99,0:04:56.29,Default,,0,0,0,,Хэхехе~
Dialogue: 0,0:04:58.33,0:05:01.60,Default,,0,0,0,,Карточка ойнау – бұл баланың ойыны ғана.
Dialogue: 0,0:05:01.60,0:05:03.93,Default,,0,0,0,,Ху Ньянто~
Dialogue: 0,0:05:03.93,0:05:06.27,Default,,0,0,0,,Мен байсалды режимде болсам да~
Dialogue: 0,0:05:06.27,0:05:08.27,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:05:08.27,0:05:11.27,Default,,0,0,0,,Нянто Нянто~ Көмегің үшін үлкен рахмет.
Dialogue: 0,0:05:11.27,0:05:13.28,Default,,0,0,0,,Мияу, мияу, мияу!
Dialogue: 0,0:05:13.28,0:05:16.61,Default,,0,0,0,,Айқа-сенпай – алып, алып, алып бала.
Dialogue: 0,0:05:16.61,0:05:18.61,Default,,0,0,0,,Куу…
Dialogue: 0,0:05:18.61,0:05:21.28,Default,,0,0,0,,Осыншама уақыт өтті...
Dialogue: 0,0:05:21.28,0:05:25.95,Default,,0,0,0,,Айка-чан, уақыт болды... А~ Иә, мен тоқтатуым керек.
Dialogue: 0,0:05:25.95,0:05:28.96,Default,,0,0,0,,Сізге түнеу керек (3 адам) А?
Dialogue: 0,0:05:28.96,0:05:31.29,Default,,0,0,0,,Бүгін түнеуіңізді өтінемін.
Dialogue: 0,0:05:31.29,0:05:34.30,Default,,0,0,0,,А, жоқ, бұл жаман.
Dialogue: 0,0:05:34.30,0:05:36.97,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:05:36.97,0:05:39.97,Default,,0,0,0,,Басқа компаниядағы екі адамға түнде қалуға рұқсат беру
Dialogue: 0,0:05:39.97,0:05:44.31,Default,,0,0,0,,Жарайды, мен жатақхана директорымен бұрын сөйлескенмін.
Dialogue: 0,0:05:44.31,0:05:46.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:46.64,0:05:48.64,Default,,0,0,0,,Түнде қалуыңызды өтінемін.
Dialogue: 0,0:05:48.64,0:05:50.65,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:05:51.65,0:05:54.32,Default,,0,0,0,,Жеңіс пен қашу - үлкен қорқақтық.
Dialogue: 0,0:05:54.32,0:05:56.65,Default,,0,0,0,,Аа, бұл солай...
Dialogue: 0,0:05:56.65,0:05:59.32,Default,,0,0,0,,Сонда сіз мұны істейсіз бе? Иә
Dialogue: 0,0:05:59.32,0:06:04.33,Default,,0,0,0,,(сөйлейді)
Dialogue: 0,0:06:09.26,0:06:11.60,Default,,0,0,0,,Бұл компанияның асханасы...
Dialogue: 0,0:06:11.60,0:06:14.60,Default,,0,0,0,,Саладағы ең ірі компаниядан күткендей.
Dialogue: 0,0:06:14.60,0:06:17.94,Default,,0,0,0,,Форма әртүрлі, сондықтан ол аздап көзге түседі.
Dialogue: 0,0:06:17.94,0:06:20.94,Default,,0,0,0,,Не айтып тұрсың, Акари?
Dialogue: 0,0:06:20.94,0:06:24.95,Default,,0,0,0,,Айка-сенпай дұрыс айтады. Менде рұқсат бар.
Dialogue: 0,0:06:24.95,0:06:27.62,Default,,0,0,0,,Уайымдама, бәрібір.
Dialogue: 0,0:06:27.62,0:06:33.62,Default,,0,0,0,,♬～
Dialogue: 0,0:06:33.62,0:06:35.62,Default,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:06:35.62,0:06:39.29,Default,,0,0,0,,Пуипу Пуйпуиню Пуипу Пуи…
Dialogue: 0,0:06:39.29,0:06:41.30,Default,,0,0,0,,Пуипупуиню~!
Dialogue: 0,0:06:41.30,0:06:43.63,Default,,0,0,0,,үшін дәмді болып көрінді, сондықтан мен абдырап қалдым.
Dialogue: 0,0:06:43.63,0:06:46.30,Default,,0,0,0,,Тамақтың сапасы 50/50.
Dialogue: 0,0:06:46.30,0:06:48.64,Default,,0,0,0,,А, Афина, міне келдік.
Dialogue: 0,0:06:48.64,0:06:50.97,Default,,0,0,0,,Уау! Не?!
Dialogue: 0,0:06:50.97,0:06:53.98,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:06:56.31,0:06:58.65,Default,,0,0,0,,Уф... Қауіпсіз, Афина-сан.
Dialogue: 0,0:06:58.65,0:07:00.92,Default,,0,0,0,,Ол мүлде қозғалмайды.
Dialogue: 0,0:07:00.92,0:07:04.52,Default,,0,0,0,,Үлкен, әдеттегідей (Президент Ария) Пуйпуи Пуиню
Dialogue: 0,0:07:05.59,0:07:08.59,Default,,0,0,0,,Уау, қандай керемет бақ!
Dialogue: 0,0:07:08.59,0:07:11.59,Default,,0,0,0,,Мен мұны істеймін Апельсин планетасы
Dialogue: 0,0:07:11.59,0:07:14.60,Default,,0,0,0,,Айка-сенпай, қызғаншақсың ғой.
Dialogue: 0,0:07:14.60,0:07:17.60,Default,,0,0,0,,Нуна! Шынымен әдемі~
Dialogue: 0,0:07:17.60,0:07:20.60,Default,,0,0,0,,Түн ортасында перілер шығады
Dialogue: 0,0:07:20.60,0:07:23.94,Default,,0,0,0,,Олар допты жасырын ұстап тұрған сияқты.
Dialogue: 0,0:07:23.94,0:07:27.28,Default,,0,0,0,,Ұятсыз жолдар жоқ! Реңк~
Dialogue: 0,0:07:27.28,0:07:29.28,Default,,0,0,0,,Пуи~
Dialogue: 0,0:07:30.61,0:07:33.95,Default,,0,0,0,,Пупуй Пуиню~!
Dialogue: 0,0:07:33.95,0:07:35.95,Default,,0,0,0,,Пуппуи
Dialogue: 0,0:07:35.95,0:07:42.62,Default,,0,0,0,,♬～
Dialogue: 0,0:07:42.62,0:07:44.63,Default,,0,0,0,,А... саған жарасады.
Dialogue: 0,0:07:44.63,0:07:46.63,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:48.30,0:07:51.63,Default,,0,0,0,,Ах… Ммм…
Dialogue: 0,0:07:51.63,0:07:54.30,Default,,0,0,0,,Уау, Алиса!
Dialogue: 0,0:07:54.30,0:07:57.31,Default,,0,0,0,,Ол сүйкімді, ханшайым сияқты
Dialogue: 0,0:07:57.31,0:08:01.58,Default,,0,0,0,,Ой, жақсы, жақсы, кенже, сен сондай үлкен көрінесің.
Dialogue: 0,0:08:01.58,0:08:04.25,Default,,0,0,0,,Пуи Пуиню
Dialogue: 0,0:08:04.25,0:08:07.58,Default,,0,0,0,,Афина-сенпай, сен не істеп жатырсың?
Dialogue: 0,0:08:07.58,0:08:10.59,Default,,0,0,0,,Мен неге сонша үлкен екенін түсінбеймін.
Dialogue: 0,0:08:11.59,0:08:13.59,Default,,0,0,0,,Әйтеуір
Dialogue: 0,0:08:14.59,0:08:16.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:17.93,0:08:21.60,Default,,0,0,0,,Суық... Бұлай жүруге болмайды.
Dialogue: 0,0:08:21.60,0:08:25.60,Default,,0,0,0,,♬～
Dialogue: 0,0:08:25.60,0:08:28.94,Default,,0,0,0,,Афина-сенпай, бұл пост емес.
Dialogue: 0,0:08:28.94,0:08:30.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:33.27,0:08:36.95,Default,,0,0,0,,Мен көп жылдар бойы осында тұрсам да, мен әлі де үлкен артта қалдым.
Dialogue: 0,0:08:36.95,0:08:38.95,Default,,0,0,0,,Ах~
Dialogue: 0,0:08:38.95,0:08:41.55,Default,,0,0,0,,Цуй «Цуй»?
Dialogue: 0,0:08:42.62,0:08:45.29,Default,,0,0,0,,Қуанышты нәрсе болды ма?
Dialogue: 0,0:08:45.29,0:08:47.62,Default,,0,0,0,,Иә? Афина аға
Dialogue: 0,0:08:47.62,0:08:50.96,Default,,0,0,0,,Көңіліңіз көтерілген сайын, ебедейсіз болады.
Dialogue: 0,0:08:50.96,0:08:53.63,Default,,0,0,0,,А, иә, солай шығар.
Dialogue: 0,0:08:53.63,0:08:55.96,Default,,0,0,0,,Бұл қазірдің өзінде үлкен мазасыздық.
Dialogue: 0,0:08:55.96,0:08:58.97,Default,,0,0,0,,Неге сонша қуандыңыз?
Dialogue: 0,0:08:58.97,0:09:02.24,Default,,0,0,0,,Алиса-чан көңілді жүрген сияқты.
Dialogue: 0,0:09:02.24,0:09:05.24,Default,,0,0,0,,Жай...
Dialogue: 0,0:09:06.91,0:09:10.25,Default,,0,0,0,,Алиса-чан Алиса-чан, онда хат бар.
Dialogue: 0,0:09:10.25,0:09:12.55,Default,,0,0,0,,А, сәлем
Dialogue: 0,0:09:13.58,0:09:16.25,Default,,0,0,0,,Менің жүрегім лүпілдеп тұр~
Dialogue: 0,0:09:16.25,0:09:20.26,Default,,0,0,0,,Енді біреудің атына жазылған хатқа қуанба!
Dialogue: 0,0:09:20.26,0:09:23.59,Default,,0,0,0,,Ааа~ Аа...
Dialogue: 0,0:09:23.59,0:09:27.26,Default,,0,0,0,,«Жұптың ішкі ақпараты»
Dialogue: 0,0:09:27.26,0:09:29.60,Default,,0,0,0,,Уау, уа, жақсы, жақсы!
Dialogue: 0,0:09:29.60,0:09:32.27,Default,,0,0,0,,Бұл үлкен үй шаруашылықтарына ғана тән оқиға.
Dialogue: 0,0:09:32.27,0:09:34.94,Default,,0,0,0,,Акаридің достары жоқ.
Dialogue: 0,0:09:34.94,0:09:37.27,Default,,0,0,0,,Үйде де кейде жасаймыз.
Dialogue: 0,0:09:37.27,0:09:40.28,Default,,0,0,0,,Бұл оңай, өйткені ол тек синхрондалған.
Dialogue: 0,0:09:42.61,0:09:46.01,Default,,0,0,0,,Не? Эх!
Dialogue: 0,0:10:00.63,0:10:03.63,Default,,0,0,0,,Келмейсіз бе? Алиса иә
Dialogue: 0,0:10:03.63,0:10:08.34,Default,,0,0,0,,Е, бұл ысырап. (Жұптың сөйлейтін дауысы)
Dialogue: 0,0:10:09.30,0:10:11.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:18.98,0:10:22.98,Default,,0,0,0,,А... енді халық ше? Бір минут күтіңіз
Dialogue: 0,0:10:22.98,0:10:26.32,Default,,0,0,0,,Көріп отырғаныңыздай, бұл компанияның жұптары.
Dialogue: 0,0:10:26.32,0:10:28.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:28.32,0:10:31.99,Default,,0,0,0,,Алиса, сен неге кешке қатыспайсың?
Dialogue: 0,0:10:31.99,0:10:34.66,Default,,0,0,0,,Мен анық таныстарды ұнатпаймын.
Dialogue: 0,0:10:34.66,0:10:38.37,Default,,0,0,0,,Мен алдымен өз бөлмеме қайтамын.
Dialogue: 0,0:10:42.00,0:10:44.34,Default,,0,0,0,,Алиса-чан... мм.
Dialogue: 0,0:10:44.34,0:10:48.34,Default,,0,0,0,,Жұмыста мені жек көретін сияқты емес.
Dialogue: 0,0:10:48.34,0:10:50.61,Default,,0,0,0,,Керісінше
Dialogue: 0,0:10:50.61,0:10:53.28,Default,,0,0,0,,Сол жаста мені Orange Planet барлау жүргізді.
Dialogue: 0,0:10:53.28,0:10:57.29,Default,,0,0,0,,Алисаның қабілетін барлығы таниды.
Dialogue: 0,0:10:57.29,0:10:59.95,Default,,0,0,0,,Бірақ бұл көреалмаушылық
Dialogue: 0,0:10:59.95,0:11:02.96,Default,,0,0,0,,Ол қызға дұшпандық сияқты.
Dialogue: 0,0:11:02.96,0:11:13.64,Default,,0,0,0,,♬～
Dialogue: 0,0:11:13.64,0:11:17.64,Default,,0,0,0,,Бұл бала қаншалықты ерекше?
Dialogue: 0,0:11:17.64,0:11:19.64,Default,,0,0,0,,Мен оны мүлде байқамаймын
Dialogue: 0,0:11:19.64,0:11:23.98,Default,,0,0,0,,Жас данышпан қыздың өзі әлі іштей бала.
Dialogue: 0,0:11:23.98,0:11:25.98,Default,,0,0,0,,Айка-чан...
Dialogue: 0,0:11:28.65,0:11:48.67,Default,,0,0,0,,♬～
Dialogue: 0,0:11:48.67,0:12:04.95,Default,,0,0,0,,♬～
Dialogue: 0,0:12:04.95,0:12:07.56,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:12:10.63,0:12:14.63,Default,,0,0,0,,Пу… Пуи Пуи Пуи…
Dialogue: 0,0:12:14.63,0:12:17.33,Default,,0,0,0,,Ал...
Dialogue: 0,0:12:18.97,0:12:22.57,Default,,0,0,0,,Сізге көп күш салудың қажеті жоқ. Ал, Президент.
Dialogue: 0,0:12:23.64,0:12:26.31,Default,,0,0,0,,Өзіңіз төсекке жата алмасаңыз да
Dialogue: 0,0:12:26.31,0:12:28.98,Default,,0,0,0,,Ал, президент - бұл президент.
Dialogue: 0,0:12:28.98,0:12:33.31,Default,,0,0,0,,Мен сенімен біргемін, сондықтан бәрібір.
Dialogue: 0,0:12:33.31,0:12:35.98,Default,,0,0,0,,Ал...
Dialogue: 0,0:12:35.98,0:12:37.99,Default,,0,0,0,,⚟ Жарайды...
Dialogue: 0,0:12:37.99,0:12:47.60,Default,,0,0,0,,♬～
Dialogue: 0,0:12:51.27,0:12:55.27,Default,,0,0,0,,Поо... Хаа~
Dialogue: 0,0:12:55.27,0:13:00.61,Default,,0,0,0,,Orange Planet күткендей, мұндай ванна бар.
Dialogue: 0,0:13:00.61,0:13:02.94,Default,,0,0,0,,Уау~
Dialogue: 0,0:13:02.94,0:13:07.95,Default,,0,0,0,,Мынадай жерге баратын сияқты.
Dialogue: 0,0:13:07.95,0:13:11.29,Default,,0,0,0,,О, кеттік!
Dialogue: 0,0:13:11.29,0:13:13.29,Default,,0,0,0,,Онда ешкім жоқ.
Dialogue: 0,0:13:13.29,0:13:15.96,Default,,0,0,0,,Бұл өте баяу.
Dialogue: 0,0:13:15.96,0:13:18.96,Default,,0,0,0,,Мен әрқашан осы уақытта кіремін.
Dialogue: 0,0:13:18.96,0:13:22.63,Default,,0,0,0,,Ху~ Мен оны жалға беріп жатқан сияқтымын.
Dialogue: 0,0:13:22.63,0:13:25.03,Default,,0,0,0,,Бұл үлкен жеке жалға алу.
Dialogue: 0,0:13:31.97,0:13:34.64,Default,,0,0,0,,Партия Қандай ысырап~
Dialogue: 0,0:13:34.64,0:13:36.64,Default,,0,0,0,,Сіз әлі де айтасыз ба?
Dialogue: 0,0:13:36.64,0:13:40.98,Default,,0,0,0,,Әріптестердің жұптары көп болса да.
Dialogue: 0,0:13:40.98,0:13:44.99,Default,,0,0,0,,Әріптестерімнің бәрі менен үлкен болса да, жарайды.
Dialogue: 0,0:13:44.99,0:13:47.99,Default,,0,0,0,,Мен әңгіменің де сәйкес келмейтініне сенімдімін.
Dialogue: 0,0:13:48.99,0:13:51.59,Default,,0,0,0,,Және сол адамдар
Dialogue: 0,0:13:51.59,0:13:53.93,Default,,0,0,0,,Себебі сен мені жек көресің
Dialogue: 0,0:13:53.93,0:13:55.93,Default,,0,0,0,,Ах... хмм...
Dialogue: 0,0:13:58.60,0:14:04.27,Default,,0,0,0,,♬～
Dialogue: 0,0:14:04.27,0:14:08.61,Default,,0,0,0,,Бұл шынымен жақсы ма? Сіз бәрі жақсы деп жатырсыз, солай емес пе?
Dialogue: 0,0:14:08.61,0:14:11.61,Default,,0,0,0,,Себебі мен бәрі жақсы дедім.
Dialogue: 0,0:14:11.61,0:14:15.62,Default,,0,0,0,,Бұл өте үлкен.
Dialogue: 0,0:14:15.62,0:14:20.62,Default,,0,0,0,,Жарайды, өйткені менде Акари-сенпай мен Айка-сенпай бар.
Dialogue: 0,0:14:20.62,0:14:27.63,Default,,0,0,0,,♬～
Dialogue: 0,0:14:27.63,0:14:30.30,Default,,0,0,0,,Бірдеңе айту бекер сияқты.
Dialogue: 0,0:14:30.30,0:14:33.97,Default,,0,0,0,,Мүмкін сіз өз ойыңызды өзгертетін шығарсыз?
Dialogue: 0,0:14:33.97,0:14:35.97,Default,,0,0,0,,Иә...
Dialogue: 0,0:14:35.97,0:14:54.26,Default,,0,0,0,,♬～
Dialogue: 0,0:14:54.26,0:14:58.93,Default,,0,0,0,,Акари-чан және басқалары тағы да ішке кіреді.
Dialogue: 0,0:14:58.93,0:15:00.93,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:15:00.93,0:15:18.61,Default,,0,0,0,,♬～
Dialogue: 0,0:15:18.61,0:15:20.62,Default,,0,0,0,,Ha
Dialogue: 0,0:15:20.62,0:15:22.95,Default,,0,0,0,,А, сәлем...
Dialogue: 0,0:15:22.95,0:15:28.29,Default,,0,0,0,,♬～
Dialogue: 0,0:15:28.29,0:15:31.96,Default,,0,0,0,,Мен Алиса-чан, Акари-чан және басқалармен бірге болғанда
Dialogue: 0,0:15:31.96,0:15:35.30,Default,,0,0,0,,Көңілді көрінеді Бұл қызық
Dialogue: 0,0:15:35.30,0:15:39.30,Default,,0,0,0,,Жұмыстағы жалғызбастылардан мүлде басқаша.
Dialogue: 0,0:15:39.30,0:15:42.64,Default,,0,0,0,,Мүлдем емес пе? Мүлдем емес
Dialogue: 0,0:15:42.64,0:15:45.97,Default,,0,0,0,,Айка-сенпай менімен достық қарым-қатынаста сөйлеседі.
Dialogue: 0,0:15:45.97,0:15:50.24,Default,,0,0,0,,Ақари-сенпай үнемі күлімдеп, көңіл көтеріп жүретін сияқты.
Dialogue: 0,0:15:50.24,0:15:54.25,Default,,0,0,0,,Жаныңда болсам шаршамаймын. Иә.
Dialogue: 0,0:15:54.25,0:15:57.59,Default,,0,0,0,,Емдік жүйе деп аталатын жүйе? Ұнайды
Dialogue: 0,0:15:57.59,0:15:59.59,Default,,0,0,0,,Иә
Dialogue: 0,0:15:59.59,0:16:01.59,Default,,0,0,0,,(Шаш кептіргішті өшіру дыбысы)
Dialogue: 0,0:16:10.26,0:16:13.94,Default,,0,0,0,,♬～
Dialogue: 0,0:16:13.94,0:16:17.61,Default,,0,0,0,,Онда Алиса айнасы бейнеленген
Dialogue: 0,0:16:17.61,0:16:22.28,Default,,0,0,0,,Әрине, айна сіздің бейнеңізді көрсетеді.
Dialogue: 0,0:16:22.28,0:16:25.58,Default,,0,0,0,,Афина-сенпай, сен үлкен ақымақсың.
Dialogue: 0,0:16:27.95,0:16:31.95,Default,,0,0,0,,Мені бәрі жек көретіндей сезінемін
Dialogue: 0,0:16:31.95,0:16:34.96,Default,,0,0,0,,Өйткені мен бәрін жек көремін
Dialogue: 0,0:16:35.96,0:16:40.29,Default,,0,0,0,,Жоқ, Алиса-чанға қатысты.
Dialogue: 0,0:16:40.29,0:16:43.30,Default,,0,0,0,,Сіз қорқасыз ба...?
Dialogue: 0,0:16:43.30,0:16:45.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:50.57,0:16:55.24,Default,,0,0,0,,Күліп тұрған адамдардың алдында өзімді бақытты сезінемін.
Dialogue: 0,0:16:55.24,0:16:57.58,Default,,0,0,0,,Атрофияға ұшыраған адамның алдында
Dialogue: 0,0:16:57.58,0:17:01.25,Default,,0,0,0,,Мен де қобалжуға бейіммін.
Dialogue: 0,0:17:01.25,0:17:08.26,Default,,0,0,0,,♬～
Dialogue: 0,0:17:08.26,0:17:10.96,Default,,0,0,0,,А... а...
Dialogue: 0,0:17:14.26,0:17:17.93,Default,,0,0,0,,Айна адамның өз бейнесін көрсететіні сияқты
Dialogue: 0,0:17:17.93,0:17:23.27,Default,,0,0,0,,Адамдар да өз жүректерін көрсетеді.
Dialogue: 0,0:17:23.27,0:17:25.94,Default,,0,0,0,,Күлімсіреп көріңіз
Dialogue: 0,0:17:25.94,0:17:29.61,Default,,0,0,0,,Сосын Алиса Чанның алдындағы адам
Dialogue: 0,0:17:29.61,0:17:32.61,Default,,0,0,0,,Күлімсірейтініңізге сенімдімін.
Dialogue: 0,0:17:32.61,0:17:52.57,Default,,0,0,0,,♬～
Dialogue: 0,0:17:52.57,0:17:57.24,Default,,0,0,0,,♬～
Dialogue: 0,0:17:57.24,0:17:59.57,Default,,0,0,0,,Ал...
Dialogue: 0,0:17:59.57,0:18:11.59,Default,,0,0,0,,♬～
Dialogue: 0,0:18:11.59,0:18:13.59,Default,,0,0,0,,Ал...
Dialogue: 0,0:18:13.59,0:18:17.26,Default,,0,0,0,,♬～
Dialogue: 0,0:18:17.26,0:18:20.60,Default,,0,0,0,,Пуи Пуи Пуи… Пуи Пуи⁉
Dialogue: 0,0:18:20.60,0:18:23.60,Default,,0,0,0,,Жақсы! (Президент Ария) Пуи...
Dialogue: 0,0:18:23.60,0:18:26.27,Default,,0,0,0,,Пуи пуи пуи... (Ал, президент) Ал, жарайды, жақсы...
Dialogue: 0,0:18:26.27,0:18:28.27,Default,,0,0,0,,Гяа!
Dialogue: 0,0:18:29.94,0:18:32.61,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:18:32.61,0:18:34.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:38.28,0:18:40.28,Default,,0,0,0,,Ал...
Dialogue: 0,0:18:41.95,0:18:44.95,Default,,0,0,0,,Ал, президент төбелес.
Dialogue: 0,0:18:47.96,0:18:50.22,Default,,0,0,0,,Ал...
Dialogue: 0,0:18:50.22,0:18:52.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:52.56,0:18:54.90,Default,,0,0,0,,...
Dialogue: 0,0:18:54.90,0:18:57.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:57.23,0:18:59.23,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:01.57,0:19:04.57,Default,,0,0,0,,Ха! Ал...
Dialogue: 0,0:19:04.57,0:19:07.24,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:19:07.24,0:19:10.24,Default,,0,0,0,,Күтіңіз… күтіңіз…
Dialogue: 0,0:19:11.25,0:19:13.58,Default,,0,0,0,,Мен оның қоректік тұрғыдан теңдестірілгеніне көз жеткіздім — тіпті ішіне сенің сүйікті раковиналарыңды да қостым.
Dialogue: 0,0:19:13.58,0:19:15.58,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:15.58,0:19:17.92,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:19:17.92,0:19:19.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:19.92,0:19:22.26,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:22.26,0:19:26.93,Default,,0,0,0,,Пуиню~ Пупу күшік…
Dialogue: 0,0:19:26.93,0:19:28.93,Default,,0,0,0,,Иә, бастық!
Dialogue: 0,0:19:28.93,0:19:32.27,Default,,0,0,0,,Бұл өте үлкен. Бұл керемет. Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:19:32.27,0:19:34.27,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:34.27,0:19:36.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:36.27,0:19:44.28,Default,,0,0,0,,♬～
Dialogue: 0,0:19:44.28,0:19:48.62,Default,,0,0,0,,Мен де бар күшімді саламын деп ойлаймын...
Dialogue: 0,0:19:48.62,0:20:06.30,Default,,0,0,0,,♬～
Dialogue: 0,0:20:23.32,0:20:25.99,Default,,0,0,0,,Ісіну~ Мен қызып кеттім~
Dialogue: 0,0:20:25.99,0:20:27.99,Default,,0,0,0,,Қалай? иә?
Dialogue: 0,0:20:27.99,0:20:30.32,Default,,0,0,0,,Тыныш
Dialogue: 0,0:20:30.32,0:20:41.34,Default,,0,0,0,,♬～
Dialogue: 0,0:20:41.34,0:20:43.34,Default,,0,0,0,,О, менің...
Dialogue: 0,0:20:43.34,0:20:45.67,Default,,0,0,0,,Мен ұйықтап жатырмын
Dialogue: 0,0:20:45.67,0:21:00.96,Default,,0,0,0,,♬～
Dialogue: 0,0:21:00.96,0:21:06.29,Default,,0,0,0,,♬～
Dialogue: 0,0:21:06.29,0:21:08.63,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:21:08.63,0:21:10.97,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:21:10.97,0:21:13.97,Default,,0,0,0,,Бұл үлкен және жағымды таң.
Dialogue: 0,0:21:13.97,0:21:15.97,Default,,0,0,0,,Бәрің, ояныңдар!
Dialogue: 0,0:21:15.97,0:21:17.97,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:21:17.97,0:21:22.64,Default,,0,0,0,,Иә, таңғы асыңызды тез ішіп, бүгін де бар күшіңізді салыңыз.
Dialogue: 0,0:21:22.64,0:21:26.98,Default,,0,0,0,,Олай болса, үлкендер, менде мектеп бар.
Dialogue: 0,0:21:26.98,0:21:29.32,Default,,0,0,0,,(Мұғалім) Ал қарама-қарсы, 7-орын, 0 жау ұпайымен…
Dialogue: 0,0:21:29.32,0:21:32.32,Default,,0,0,0,,Кенже, сенің мінезің бөлек емес пе?
Dialogue: 0,0:21:32.32,0:21:35.99,Default,,0,0,0,,Мен шымшып жатырмын... Айка-чанның беті...
Dialogue: 0,0:21:35.99,0:21:37.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:37.99,0:21:44.00,Default,,0,0,0,,♬～
Dialogue: 0,0:21:44.00,0:21:48.34,Default,,0,0,0,,Мм, көңіл күйінде қандай өзгерістер бар деп ойлаймын.
Dialogue: 0,0:21:48.34,0:21:51.27,Default,,0,0,0,,Афина-сенпай, сен бірдеңе білесің бе?
Dialogue: 0,0:21:51.27,0:21:53.27,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:21:53.27,0:21:58.61,Default,,0,0,0,,♬～
Dialogue: 0,0:21:58.61,0:22:02.28,Default,,0,0,0,,<Ай-чан, не болды? ＞
Dialogue: 0,0:22:02.28,0:22:05.29,Default,,0,0,0,,<Алиса-чанның көздері жылтылдап тұр➡
Dialogue: 0,0:22:05.29,0:22:08.29,Default,,0,0,0,,Өте жақсы болды>
Dialogue: 0,0:22:08.29,0:22:11.96,Default,,0,0,0,,<Уау~ Сондай көңілді Алиса➡
Dialogue: 0,0:22:11.96,0:22:14.30,Default,,0,0,0,,Мен оны бір рет көргім келеді＞
Dialogue: 0,0:22:14.30,0:22:17.63,Default,,0,0,0,,<...... десем ашуланасың ба? ＞
Dialogue: 0,0:22:17.63,0:22:21.64,Default,,0,0,0,,<Хехехе, көңілді кеш болды деп үміттенемін>
Dialogue: 0,0:22:21.64,0:22:41.66,Default,,0,0,0,,♬～
Dialogue: 0,0:22:41.66,0:23:01.61,Default,,0,0,0,,♬～
Dialogue: 0,0:23:01.61,0:23:21.63,Default,,0,0,0,,♬～
Dialogue: 0,0:23:21.63,0:23:41.65,Default,,0,0,0,,♬～
Dialogue: 0,0:23:41.65,0:23:54.66,Default,,0,0,0,,♬～
