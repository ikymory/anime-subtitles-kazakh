Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.63,0:00:10.97,Default,,0,0,0,,♬～
Dialogue: 0,0:00:10.97,0:00:20.98,Default,,0,0,0,,♬～
Dialogue: 0,0:00:20.98,0:00:24.65,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, бұл ARIA компаниясы.
Dialogue: 0,0:00:24.65,0:00:28.06,Default,,0,0,0,,Қадамыңызды бақылаңыз.
Dialogue: 0,0:00:31.66,0:00:35.00,Default,,0,0,0,,<Ай-чан, бүгін менің гондоламда➡
Dialogue: 0,0:00:35.00,0:00:38.67,Default,,0,0,0,,Борттағы жолаушылармен көрікті жерлер туралы нақты ақпарат＞
Dialogue: 0,0:00:38.67,0:00:40.67,Default,,0,0,0,,<Мен қазірдің өзінде қуаныштымын➡
Dialogue: 0,0:00:40.67,0:00:43.67,Default,,0,0,0,,Алисия да бізбен бірге нұсқаушы болып жүр...>
Dialogue: 0,0:00:43.67,0:00:45.67,Default,,0,0,0,,Иә, рахмет.
Dialogue: 0,0:00:45.67,0:00:49.08,Default,,0,0,0,,<Ух~ Мен бар күшімді салуым керек! ＞
Dialogue: 0,0:00:53.35,0:00:56.35,Default,,0,0,0,,Олай болса кетейік.
Dialogue: 0,0:00:58.35,0:01:00.62,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:01:00.62,0:01:03.29,Default,,0,0,0,,Фу…
Dialogue: 0,0:01:03.29,0:01:05.63,Default,,0,0,0,,Нео Венецияға қош келдіңіз
Dialogue: 0,0:01:05.63,0:01:09.63,Default,,0,0,0,,Бүгін біз ARIA компаниясының гондоласына отырдық.
Dialogue: 0,0:01:09.63,0:01:11.63,Default,,0,0,0,,Рахмет
Dialogue: 0,0:01:11.63,0:01:15.97,Default,,0,0,0,,Сізге айналаңызды көрсететін адам - ​​мен, Акари Мизунаши.
Dialogue: 0,0:01:15.97,0:01:18.97,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:01:18.97,0:01:38.99,Default,,0,0,0,,♬～
Dialogue: 0,0:01:38.99,0:01:59.01,Default,,0,0,0,,♬～
Dialogue: 0,0:01:59.01,0:02:18.97,Default,,0,0,0,,♬～
Dialogue: 0,0:02:18.97,0:02:38.99,Default,,0,0,0,,♬～
Dialogue: 0,0:02:38.99,0:02:50.60,Default,,0,0,0,,♬～
Dialogue: 0,0:02:57.67,0:03:00.61,Default,,0,0,0,,Бұл хризантема өрнегі
Dialogue: 0,0:03:00.61,0:03:03.01,Default,,0,0,0,,Бұл да хризантема.
Dialogue: 0,0:03:03.95,0:03:05.95,Default,,0,0,0,,Тіпті осындай жерлерде
Dialogue: 0,0:03:05.95,0:03:09.28,Default,,0,0,0,,Мұқият қарасаңыз, одан да көп.
Dialogue: 0,0:03:09.28,0:03:12.62,Default,,0,0,0,,Көріп тұрғандарыңыздай, мына қалада анау-мынау.
Dialogue: 0,0:03:12.62,0:03:16.96,Default,,0,0,0,,Сіз көптеген хризантема әшекейлерін таба аласыз
Dialogue: 0,0:03:16.96,0:03:19.96,Default,,0,0,0,,Бұл гүлді бір кездері Марко Поло пайдаланған.
Dialogue: 0,0:03:19.96,0:03:22.96,Default,,0,0,0,,Қытайдан әкелінген гүл дейді.
Dialogue: 0,0:03:22.96,0:03:26.97,Default,,0,0,0,,Ол кезде Венецияда, Манхомеде бұл барлық қызу болды.
Dialogue: 0,0:03:26.97,0:03:29.30,Default,,0,0,0,,Әй, солай.
Dialogue: 0,0:03:29.30,0:03:31.31,Default,,0,0,0,,Нео Венецияда да бар.
Dialogue: 0,0:03:31.31,0:03:34.98,Default,,0,0,0,,Иә (Firebird) Иә~ Бұл қызық.
Dialogue: 0,0:03:34.98,0:03:37.65,Default,,0,0,0,,Нео-Венециядағы кейбір ғимараттар
Dialogue: 0,0:03:37.65,0:03:39.65,Default,,0,0,0,,Әлгі адамның үйінен... (Айлы түн) Әй!
Dialogue: 0,0:03:39.65,0:03:41.98,Default,,0,0,0,,Не? Бір сәтке тоқтаңыз
Dialogue: 0,0:03:41.98,0:03:43.99,Default,,0,0,0,,Иә
Dialogue: 0,0:03:44.99,0:03:46.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:46.99,0:03:49.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:49.32,0:03:56.67,Default,,0,0,0,,♬～
Dialogue: 0,0:03:56.67,0:03:59.67,Default,,0,0,0,,Қандай тамаша бақ, солай емес пе?
Dialogue: 0,0:03:59.67,0:04:02.67,Default,,0,0,0,,Иә, шынымен...
Dialogue: 0,0:04:03.94,0:04:06.61,Default,,0,0,0,,Оны мәңгі көргім келеді
Dialogue: 0,0:04:06.61,0:04:08.94,Default,,0,0,0,,Хахи~
Dialogue: 0,0:04:08.94,0:04:11.61,Default,,0,0,0,,Бұл ерекше орын ма?
Dialogue: 0,0:04:11.61,0:04:14.95,Default,,0,0,0,,Ех! Ха ха... у...
Dialogue: 0,0:04:14.95,0:04:17.62,Default,,0,0,0,,Жоқ, бұл кәдімгі жеке үй.
Dialogue: 0,0:04:17.62,0:04:20.62,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:04:20.62,0:04:24.29,Default,,0,0,0,,Мұндағы үй әрқашан жақсы күтіледі.
Dialogue: 0,0:04:24.29,0:04:28.30,Default,,0,0,0,,Әр маусымда әр түрлі гүлдерді көруге болады.
Dialogue: 0,0:04:28.30,0:04:32.30,Default,,0,0,0,,Біріншіден, Нео-Венецияның негізгі аралы жасанды жер.
Dialogue: 0,0:04:32.30,0:04:35.30,Default,,0,0,0,,Табиғи гүлдер мен жасыл желектер аз.
Dialogue: 0,0:04:35.30,0:04:39.98,Default,,0,0,0,,Сондықтан үйде әдемі гүлзарды немесе бақшаны күтуге болады.
Dialogue: 0,0:04:39.98,0:04:42.98,Default,,0,0,0,,Әйеліңіздің қадірін өлшейтін барометр.
Dialogue: 0,0:04:42.98,0:04:44.98,Default,,0,0,0,,Айтылады
Dialogue: 0,0:04:44.98,0:04:46.98,Default,,0,0,0,,Я~
Dialogue: 0,0:04:46.98,0:04:49.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:49.65,0:04:53.32,Default,,0,0,0,,Бірақ тұтынушы мұны жақсы байқады.
Dialogue: 0,0:04:53.32,0:04:55.66,Default,,0,0,0,,Бұл мен өткен алғашқы су жолы болса да.
Dialogue: 0,0:04:55.66,0:04:59.33,Default,,0,0,0,,А, жоқ, бұл менің көзіме түсті.
Dialogue: 0,0:04:59.33,0:05:01.93,Default,,0,0,0,,Мен байқамадым, иә?
Dialogue: 0,0:05:01.93,0:05:06.94,Default,,0,0,0,,Мен оны осы уақытқа дейін мүлде байқамадым.
Dialogue: 0,0:05:06.94,0:05:11.61,Default,,0,0,0,,Осы су жолынан жиі өтсем де, Акари-чан...
Dialogue: 0,0:05:11.61,0:05:13.61,Default,,0,0,0,,Керемет! (Айлы түн) Иә?
Dialogue: 0,0:05:13.61,0:05:16.28,Default,,0,0,0,,Тұтынушы Бұл керемет! Иә...
Dialogue: 0,0:05:16.28,0:05:18.95,Default,,0,0,0,,Маған қатты әсер етті.
Dialogue: 0,0:05:18.95,0:05:21.62,Default,,0,0,0,,Керемет ашқаныңыз үшін рахмет.
Dialogue: 0,0:05:21.62,0:05:24.29,Default,,0,0,0,,Күрсін... Әй, һехехе
Dialogue: 0,0:05:24.29,0:05:26.29,Default,,0,0,0,,Пуйпуи нюуню
Dialogue: 0,0:05:29.96,0:05:34.63,Default,,0,0,0,,<Жұмыс аяқталғаннан кейін де жаттығу жалғасуда>
Dialogue: 0,0:05:34.63,0:05:37.30,Default,,0,0,0,,<Клиенттерді қуанту үшін➡
Dialogue: 0,0:05:37.30,0:05:39.97,Default,,0,0,0,,Мен артық, көп, көбірек ➡
Dialogue: 0,0:05:39.97,0:05:42.57,Default,,0,0,0,,Нео-Венецияның сұлулығын білмесеңіз＞
Dialogue: 0,0:05:43.64,0:05:46.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:46.31,0:05:50.98,Default,,0,0,0,,Президент, жақсы жақтары болса, бізге хабарлаңыз.
Dialogue: 0,0:05:50.98,0:05:53.28,Default,,0,0,0,,Pupui~
Dialogue: 0,0:05:55.32,0:05:57.99,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:57.99,0:06:00.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:00.26,0:06:02.56,Default,,0,0,0,,Ммм
Dialogue: 0,0:06:03.59,0:06:05.93,Default,,0,0,0,,Міне! Уау...
Dialogue: 0,0:06:05.93,0:06:07.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:07.93,0:06:11.27,Default,,0,0,0,,Ах, Айка-чан, Алиса-чан
Dialogue: 0,0:06:11.27,0:06:13.27,Default,,0,0,0,,Шеттен қарауға тыйым салынады!
Dialogue: 0,0:06:15.60,0:06:17.94,Default,,0,0,0,,Алисия күткендей
Dialogue: 0,0:06:17.94,0:06:20.94,Default,,0,0,0,,Жеке үйлердің бақшаларынан хабардар екеніңізге де сене алар емеспін.
Dialogue: 0,0:06:20.94,0:06:23.61,Default,,0,0,0,,Мен де Алисияға жақындай аламын.
Dialogue: 0,0:06:23.61,0:06:26.62,Default,,0,0,0,,Мен білмейтін керемет нәрсені іздеп жүрмін...
Dialogue: 0,0:06:26.62,0:06:29.95,Default,,0,0,0,,Демек, егін мүлде жоқ.
Dialogue: 0,0:06:29.95,0:06:33.29,Default,,0,0,0,,Ха... Дұрыс.
Dialogue: 0,0:06:33.29,0:06:35.62,Default,,0,0,0,,Оны сізге қалдыратын уақыт келді! иә?
Dialogue: 0,0:06:35.62,0:06:38.96,Default,,0,0,0,,Бүгін мен сіздерге осы қаланың жасырын ғажайыптарын көрсету үшін ерекше боламын.
Dialogue: 0,0:06:38.96,0:06:41.30,Default,,0,0,0,,Мен сізге айтайын.
Dialogue: 0,0:06:41.30,0:06:49.30,Default,,0,0,0,,♬～
Dialogue: 0,0:06:49.30,0:06:51.97,Default,,0,0,0,,Мұнда бірдеңе бар ма? Айка-чан
Dialogue: 0,0:06:51.97,0:06:54.31,Default,,0,0,0,,Ал, күте тұрыңыз.
Dialogue: 0,0:06:54.31,0:06:57.61,Default,,0,0,0,,Пуи Пуи Пуиню
Dialogue: 0,0:07:00.25,0:07:02.92,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:07:02.92,0:07:04.92,Default,,0,0,0,,Pupui?
Dialogue: 0,0:07:04.92,0:07:09.93,Default,,0,0,0,,(ысқырық тәрізді дыбыс)
Dialogue: 0,0:07:09.93,0:07:11.93,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:07:11.93,0:07:14.93,Default,,0,0,0,,Хе, таң қалған шығарсың.
Dialogue: 0,0:07:14.93,0:07:18.93,Default,,0,0,0,,Бұл ағаш жел соққанда әдемі дыбыс шығарады.
Dialogue: 0,0:07:18.93,0:07:20.94,Default,,0,0,0,,Керемет…
Dialogue: 0,0:07:20.94,0:07:24.61,Default,,0,0,0,,Самалға арнап ән салғандай
Dialogue: 0,0:07:24.61,0:07:27.61,Default,,0,0,0,,Ұятсыз жолдар жоқ! Эх...
Dialogue: 0,0:07:27.61,0:07:30.28,Default,,0,0,0,,Бірақ ол неге дыбыс шығарады?
Dialogue: 0,0:07:30.28,0:07:33.95,Default,,0,0,0,,үшін? Ал...
Dialogue: 0,0:07:33.95,0:07:36.62,Default,,0,0,0,,Жапырақтардың пішіні ерекше.
Dialogue: 0,0:07:36.62,0:07:39.95,Default,,0,0,0,,Ауаны ысқырықтай өткізетін сияқты.
Dialogue: 0,0:07:39.95,0:07:41.96,Default,,0,0,0,,Алиса да білді.
Dialogue: 0,0:07:41.96,0:07:44.63,Default,,0,0,0,,Иә, бұл өте танымал.
Dialogue: 0,0:07:44.63,0:07:47.63,Default,,0,0,0,,Хм... сонда, кенже?
Dialogue: 0,0:07:47.63,0:07:50.30,Default,,0,0,0,,Сіз жақсырақ жер білесіз бе?
Dialogue: 0,0:07:50.30,0:07:52.30,Default,,0,0,0,,Қалай болғанда да.
Dialogue: 0,0:07:52.30,0:07:54.97,Default,,0,0,0,,Олай болса, маған көрсетіңізші. Иә.
Dialogue: 0,0:07:54.97,0:07:57.64,Default,,0,0,0,,Нунунуну... мм...
Dialogue: 0,0:07:57.64,0:08:03.04,Default,,0,0,0,,Бұл керемет дыбыс, солай емес пе, президент мырза?
Dialogue: 0,0:08:03.91,0:08:07.58,Default,,0,0,0,,Уау~ Мына қабырға сүйкімді
Dialogue: 0,0:08:07.58,0:08:11.25,Default,,0,0,0,,Бұл жер «Үмітсіздік үйі» деп аталады.
Dialogue: 0,0:08:11.25,0:08:14.59,Default,,0,0,0,,Шебер суретшінің ғашық болғаны
Dialogue: 0,0:08:14.59,0:08:20.26,Default,,0,0,0,,Жүрегінің салқынын көк қабырғамен білдірсе керек.
Dialogue: 0,0:08:20.26,0:08:23.26,Default,,0,0,0,,Үмітсіздік қалай?
Dialogue: 0,0:08:23.26,0:08:25.60,Default,,0,0,0,,Бұл өте керемет болса да...
Dialogue: 0,0:08:25.60,0:08:27.94,Default,,0,0,0,,Иә? Ха...
Dialogue: 0,0:08:27.94,0:08:30.27,Default,,0,0,0,,Кіші, сен мұны өткізіп алған жоқсың ба?
Dialogue: 0,0:08:30.27,0:08:32.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:35.28,0:08:37.61,Default,,0,0,0,,А, ашық қызыл!
Dialogue: 0,0:08:37.61,0:08:41.62,Default,,0,0,0,,Суретші жай ғана үмітсіз болған жоқ.
Dialogue: 0,0:08:41.62,0:08:45.29,Default,,0,0,0,,Жалындаған жүрегім әлі де қалды...
Dialogue: 0,0:08:45.29,0:08:49.29,Default,,0,0,0,,Мен оны өте танымал деп ойладым~ Ммм
Dialogue: 0,0:08:49.29,0:08:51.29,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:08:51.29,0:08:53.96,Default,,0,0,0,,Nuou...
Dialogue: 0,0:08:53.96,0:08:56.97,Default,,0,0,0,,Ах~ Керемет сезіледі~
Dialogue: 0,0:08:56.97,0:08:59.27,Default,,0,0,0,,Жаңа
Dialogue: 0,0:09:00.24,0:09:02.57,Default,,0,0,0,,Кемпірқосақ субұрқағы!
Dialogue: 0,0:09:02.57,0:09:04.91,Default,,0,0,0,,Креп-мирт жолы
Dialogue: 0,0:09:04.91,0:09:07.24,Default,,0,0,0,,Мысық құлақ тәрізді жартас!
Dialogue: 0,0:09:07.24,0:09:09.91,Default,,0,0,0,,Қолдары ұрланған сағат мұнарасы
Dialogue: 0,0:09:09.91,0:09:11.91,Default,,0,0,0,,Қастары қалың ит!
Dialogue: 0,0:09:11.91,0:09:13.92,Default,,0,0,0,,Тек жарты жолда жүретін баспалдақтар
Dialogue: 0,0:09:13.92,0:09:15.92,Default,,0,0,0,,Мәриямның ер адам мүсіні
Dialogue: 0,0:09:15.92,0:09:17.92,Default,,0,0,0,,Жабылмайтын есік
Dialogue: 0,0:09:17.92,0:09:20.59,Default,,0,0,0,,Ммм
Dialogue: 0,0:09:20.59,0:09:23.59,Default,,0,0,0,,Мынаны қара! оны иіске
Dialogue: 0,0:09:25.26,0:09:28.93,Default,,0,0,0,,Наубайхана болса да соба кеспенің иісі
Dialogue: 0,0:09:28.93,0:09:31.93,Default,,0,0,0,,Иә, керемет емес пе?
Dialogue: 0,0:09:31.93,0:09:35.27,Default,,0,0,0,,Бұл үлкен сұрақ. Иә, кенже.
Dialogue: 0,0:09:35.27,0:09:38.27,Default,,0,0,0,,Собаның иісі наубайханадан шығады.
Dialogue: 0,0:09:38.27,0:09:40.94,Default,,0,0,0,,Мұның несі жақсы? Уф...
Dialogue: 0,0:09:40.94,0:09:44.28,Default,,0,0,0,,Түсінбейсіз бе? Бұл сөзбен жеткізу мүмкін емес керемет
Dialogue: 0,0:09:44.28,0:09:46.61,Default,,0,0,0,,Иә, оның қаншалықты үлкен екенін түсінбеймін.
Dialogue: 0,0:09:46.61,0:09:49.62,Default,,0,0,0,,Хмм, қызықты және тамаша
Dialogue: 0,0:09:49.62,0:09:53.29,Default,,0,0,0,,Собаны да, нанды да жегім келеді.
Dialogue: 0,0:09:53.29,0:09:55.29,Default,,0,0,0,,Апай, маған 3 дана беріңізші.
Dialogue: 0,0:09:55.29,0:09:57.63,Default,,0,0,0,,Иә, 3 дана, иә.
Dialogue: 0,0:09:57.63,0:10:01.30,Default,,0,0,0,,Қараңдар, мен оны Акаридің деңгейіне келтірдім.
Dialogue: 0,0:10:01.30,0:10:03.30,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:10:03.30,0:10:05.30,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:10:05.30,0:10:09.30,Default,,0,0,0,,♬～
Dialogue: 0,0:10:09.30,0:10:13.31,Default,,0,0,0,,Уфуфу, Акари-сенпай, көңіл-күйің жақсы.
Dialogue: 0,0:10:13.31,0:10:15.31,Default,,0,0,0,,Иә! Екеуіңізге рахмет
Dialogue: 0,0:10:15.31,0:10:17.98,Default,,0,0,0,,Мен білмеген көптеген тамаша нәрселерді білдім.
Dialogue: 0,0:10:17.98,0:10:20.98,Default,,0,0,0,,Мен де бірдеңе тапқым келді...
Dialogue: 0,0:10:20.98,0:10:23.99,Default,,0,0,0,,Бірақ қазірдің өзінде қараңғы.
Dialogue: 0,0:10:23.99,0:10:27.32,Default,,0,0,0,,Кешкі астан кейін қайталап көргіңіз келе ме?
Dialogue: 0,0:10:27.32,0:10:29.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:29.32,0:10:31.66,Default,,0,0,0,,Әй, бәрі сәйкес келеді.
Dialogue: 0,0:10:31.66,0:10:34.33,Default,,0,0,0,,Алисия!
Dialogue: 0,0:10:34.33,0:10:36.33,Default,,0,0,0,,Сіз не істеп жүрсіз?
Dialogue: 0,0:10:36.33,0:10:39.33,Default,,0,0,0,,Айка-чан мен Алиса-чанға ах хахи
Dialogue: 0,0:10:39.33,0:10:43.00,Default,,0,0,0,,Маған қаладағы жақсы жасырын жерлер туралы айтты.
Dialogue: 0,0:10:43.00,0:10:46.01,Default,,0,0,0,,О, бұл қызық көрінеді.
Dialogue: 0,0:10:46.01,0:10:49.68,Default,,0,0,0,,Бірақ мен жақсы жақтарын таба алмадым.
Dialogue: 0,0:10:49.68,0:10:53.35,Default,,0,0,0,,Түнде тағы іздеймін деп жатырмын.
Dialogue: 0,0:10:53.35,0:10:55.68,Default,,0,0,0,,О... иә?
Dialogue: 0,0:10:55.68,0:10:59.35,Default,,0,0,0,,Бұл түнде мүмкін емес.
Dialogue: 0,0:10:59.35,0:11:02.96,Default,,0,0,0,,Айқай? Шамдар жанбайды.
Dialogue: 0,0:11:02.96,0:11:07.30,Default,,0,0,0,,Бұл аймақта таңға дейін электр жарығы жоқ.
Dialogue: 0,0:11:07.30,0:11:11.00,Default,,0,0,0,,Электр қуатын өшіру? Бұл түн қараңғы, солай емес пе?
Dialogue: 0,0:11:12.30,0:11:15.60,Default,,0,0,0,,Не? Тым қараңғы...
Dialogue: 0,0:11:36.99,0:11:40.33,Default,,0,0,0,,Не істеуім керек... Иә? Не болды?
Dialogue: 0,0:11:40.33,0:11:43.00,Default,,0,0,0,,А... жоқ, шынында да...
Dialogue: 0,0:11:43.00,0:11:45.00,Default,,0,0,0,,Бірдеңе?
Dialogue: 0,0:11:45.00,0:11:47.00,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:11:47.00,0:11:49.00,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,0:11:49.00,0:11:51.27,Default,,0,0,0,,Оның жасы үлкен екенін білетінмін, бірақ бұл…
Dialogue: 0,0:11:51.27,0:11:53.94,Default,,0,0,0,,Иә? Хахи, бұл менмін
Dialogue: 0,0:11:53.94,0:11:57.55,Default,,0,0,0,,Мен түнде тас қараңғы болса ұйықтай алмайтын адаммын.
Dialogue: 0,0:12:02.28,0:12:04.99,Default,,0,0,0,,Хахи... Пуи?
Dialogue: 0,0:12:06.62,0:12:11.63,Default,,0,0,0,,Қараңғы, Ария президенті Пуиню.
Dialogue: 0,0:12:13.63,0:12:16.63,Default,,0,0,0,,Ах~ Пуи! Пуйпуи…
Dialogue: 0,0:12:17.63,0:12:19.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:19.97,0:12:23.97,Default,,0,0,0,,Қазір қандай? президент
Dialogue: 0,0:12:23.97,0:12:25.97,Default,,0,0,0,,Pui...
Dialogue: 0,0:12:25.97,0:12:27.98,Default,,0,0,0,,《Оның күші одан сайын артуда》
Dialogue: 0,0:12:27.98,0:12:30.98,Default,,0,0,0,,Ву-сәлем! Puppupu…
Dialogue: 0,0:12:30.98,0:12:32.98,Default,,0,0,0,,Uh~ (есіктің ашылған дыбысы)
Dialogue: 0,0:12:32.98,0:12:36.58,Default,,0,0,0,,О, қандай жанды?
Dialogue: 0,0:12:39.32,0:12:41.62,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:12:42.66,0:12:46.66,Default,,0,0,0,,♪ (Алисияның гуілдеуі)
Dialogue: 0,0:12:46.66,0:12:51.27,Default,,0,0,0,,♪～
Dialogue: 0,0:12:51.27,0:12:56.60,Default,,0,0,0,,Мм, мені түнеуге рұқсат беру үшін жолыңыздан шығып кеткеніңіз үшін шынымен өкінемін.
Dialogue: 0,0:12:56.60,0:12:58.61,Default,,0,0,0,,Уау
Dialogue: 0,0:12:58.61,0:13:01.61,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:13:01.61,0:13:05.28,Default,,0,0,0,,Иә, Акари-чан, иә?
Dialogue: 0,0:13:05.28,0:13:07.62,Default,,0,0,0,,Уау... Уау.
Dialogue: 0,0:13:07.62,0:13:09.62,Default,,0,0,0,,Уау уау... уау уау уау
Dialogue: 0,0:13:09.62,0:13:11.62,Default,,0,0,0,,Уау уау уау уау
Dialogue: 0,0:13:11.62,0:13:14.62,Default,,0,0,0,,Енді сапқа тұрыңдар, сапқа тұрыңдар, ха ха!
Dialogue: 0,0:13:14.62,0:13:18.63,Default,,0,0,0,,Хехе, мен қатты толқып тұрмын.
Dialogue: 0,0:13:18.63,0:13:20.63,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:20.63,0:13:40.65,Default,,0,0,0,,♬～
Dialogue: 0,0:13:40.65,0:13:42.65,Default,,0,0,0,,Күшік! Пип пуи... хехе
Dialogue: 0,0:13:42.65,0:13:51.26,Default,,0,0,0,,♬～
Dialogue: 0,0:13:51.26,0:13:53.26,Default,,0,0,0,,Иә Аяқталды
Dialogue: 0,0:13:53.26,0:13:55.26,Default,,0,0,0,,Уау...
Dialogue: 0,0:13:57.60,0:14:00.27,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:14:00.27,0:14:06.61,Default,,0,0,0,,♬～
Dialogue: 0,0:14:06.61,0:14:10.95,Default,,0,0,0,,Керемет... Басқа әлемге қыдырғандай
Dialogue: 0,0:14:10.95,0:14:12.95,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:16.62,0:14:19.62,Default,,0,0,0,,Қызғылт сары күлгін ақ
Dialogue: 0,0:14:19.62,0:14:22.96,Default,,0,0,0,,Жалынның әртүрлі түстері бар, солай емес пе?
Dialogue: 0,0:14:22.96,0:14:24.96,Default,,0,0,0,,Пуиню~
Dialogue: 0,0:14:24.96,0:14:27.63,Default,,0,0,0,,Күрсін, ыстық су жақсы болды.
Dialogue: 0,0:14:27.63,0:14:30.63,Default,,0,0,0,,Мен алдымен шомылдым.
Dialogue: 0,0:14:30.63,0:14:33.63,Default,,0,0,0,,Егер Акари-чан да кірсе ше? Ах хахи
Dialogue: 0,0:14:33.63,0:14:36.30,Default,,0,0,0,,Монша да бір бөлек дүние.
Dialogue: 0,0:14:36.30,0:14:38.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:41.98,0:14:44.58,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:14:50.59,0:14:53.25,Default,,0,0,0,,Ия... Пойнни~
Dialogue: 0,0:14:53.25,0:14:55.26,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:55.26,0:15:00.60,Default,,0,0,0,,Ыстық суда жалын жыпылықтайды, бұл да әдемі.
Dialogue: 0,0:15:00.60,0:15:06.00,Default,,0,0,0,,Я... Пуинюуу
Dialogue: 0,0:15:10.27,0:15:13.94,Default,,0,0,0,,Күрсін, мен мүлдем адасып қалдым
Dialogue: 0,0:15:13.94,0:15:15.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:15.94,0:15:18.55,Default,,0,0,0,,⚟ (ыдыстардың дыбысы)
Dialogue: 0,0:15:19.95,0:15:21.95,Default,,0,0,0,,Алисия...
Dialogue: 0,0:15:21.95,0:15:25.29,Default,,0,0,0,,Мен түн ортасында шай ішу туралы ойладым.
Dialogue: 0,0:15:25.29,0:15:27.29,Default,,0,0,0,,Корольдік сүтті шай
Dialogue: 0,0:15:27.29,0:15:29.29,Default,,0,0,0,,Пуиню Пуй! Уау, бұл жақсы
Dialogue: 0,0:15:29.29,0:15:32.96,Default,,0,0,0,,Егер есімде дұрыс болса, тұтынушы берген печенье бар еді.
Dialogue: 0,0:15:32.96,0:15:34.96,Default,,0,0,0,,Пуиню! Пуипуй...
Dialogue: 0,0:15:34.96,0:15:36.96,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:15:37.97,0:15:41.97,Default,,0,0,0,,Ал, қамырға қарақұмық ұнын пайдаланады.
Dialogue: 0,0:15:41.97,0:15:44.97,Default,,0,0,0,,Айка-чан маған айтты (иіскеу дыбысы)
Dialogue: 0,0:15:44.97,0:15:49.31,Default,,0,0,0,,Иә, хош иістендіргіш үшін соя соусы қолданылатын сияқты.
Dialogue: 0,0:15:49.31,0:15:51.58,Default,,0,0,0,,Қарақұмық наны мен соя соусы?
Dialogue: 0,0:15:51.58,0:15:54.58,Default,,0,0,0,,Түсіндім, сондықтан соба кеспесі иісі шықты.
Dialogue: 0,0:15:54.58,0:15:56.92,Default,,0,0,0,,Біртүрлі, бірақ дәмді көрінеді.
Dialogue: 0,0:15:56.92,0:16:00.92,Default,,0,0,0,,Аа, солай ма? Бұл не?
Dialogue: 0,0:16:01.92,0:16:04.93,Default,,0,0,0,,Уа, уах, уах, бұл қуырылған көк шай.
Dialogue: 0,0:16:04.93,0:16:08.26,Default,,0,0,0,,Міне, шәй құтысы.
Dialogue: 0,0:16:08.26,0:16:11.60,Default,,0,0,0,,Соба нанындағы Ходжича сүті
Dialogue: 0,0:16:11.60,0:16:14.60,Default,,0,0,0,,Басқа әлемде шай ішуге жарамайды ма?
Dialogue: 0,0:16:14.60,0:16:16.60,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:16:17.94,0:16:21.28,Default,,0,0,0,,Уау... дәмді!
Dialogue: 0,0:16:21.28,0:16:24.28,Default,,0,0,0,,Ходжича мен сүт үйлеседі
Dialogue: 0,0:16:24.28,0:16:26.61,Default,,0,0,0,,Жаңа тамаша жаңалық
Dialogue: 0,0:16:26.61,0:16:31.32,Default,,0,0,0,,Бұл нан да дәмді. Бұл керемет неке.
Dialogue: 0,0:16:32.62,0:16:34.62,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:16:34.62,0:16:39.96,Default,,0,0,0,,♬～
Dialogue: 0,0:16:39.96,0:16:43.63,Default,,0,0,0,,Сонша уақыт өтсе де, ол әлі де жарқырайды.
Dialogue: 0,0:16:43.63,0:16:45.63,Default,,0,0,0,,Иә
Dialogue: 0,0:16:45.63,0:16:48.64,Default,,0,0,0,,Шамның жалыны өте әлсіз болса да
Dialogue: 0,0:16:48.64,0:16:53.34,Default,,0,0,0,,Ол баяу, жай және шыдамды түрде жарқырайды.
Dialogue: 0,0:16:54.24,0:16:58.58,Default,,0,0,0,,Ха... мен білмейтін нәрселер өте көп.
Dialogue: 0,0:16:58.58,0:17:00.58,Default,,0,0,0,,Акари-чан?
Dialogue: 0,0:17:00.58,0:17:06.25,Default,,0,0,0,,Алисияға жақындау үшін әлі де дайындығым жоқ сияқты.
Dialogue: 0,0:17:06.25,0:17:09.26,Default,,0,0,0,,Уфуфу аа...
Dialogue: 0,0:17:09.26,0:17:12.93,Default,,0,0,0,,Шам десем, солар есіме түседі.
Dialogue: 0,0:17:12.93,0:17:15.60,Default,,0,0,0,,Ол Акари-чан сияқты бойдақ болған кезде
Dialogue: 0,0:17:15.60,0:17:19.93,Default,,0,0,0,,Тұтынушы маған гардения гүлдерін көргісі келетінін айтты.
Dialogue: 0,0:17:19.93,0:17:24.94,Default,,0,0,0,,Бірақ бір күн бұрын жауған жаңбырдан барлық гүлдер құлап қалыпты.
Dialogue: 0,0:17:24.94,0:17:28.28,Default,,0,0,0,,Білмей жол көрсеттім.
Dialogue: 0,0:17:28.28,0:17:30.61,Default,,0,0,0,,Алисия...
Dialogue: 0,0:17:30.61,0:17:35.28,Default,,0,0,0,,Тұтынушының көңілі қалған түрін менің басымнан ала алмаймын.
Dialogue: 0,0:17:35.28,0:17:37.95,Default,,0,0,0,,Ах... сол түні.
Dialogue: 0,0:17:37.95,0:17:40.96,Default,,0,0,0,,Әже маған шырақ әкелді.
Dialogue: 0,0:17:40.96,0:17:44.29,Default,,0,0,0,,Мен осындай жарықты анда-санда болса жақсы болар еді деп ойладым.
Dialogue: 0,0:17:44.29,0:17:47.63,Default,,0,0,0,,Ал жүрегімде жылы жалын...
Dialogue: 0,0:17:47.63,0:17:51.33,Default,,0,0,0,,《…Жарық жанып тұр, Алисия》
Dialogue: 0,0:17:52.23,0:17:54.57,Default,,0,0,0,,《Жүрегіңдегі жалын? 》
Dialogue: 0,0:17:54.57,0:17:58.57,Default,,0,0,0,,《Иә, күшті жалын болуы керек емес》
Dialogue: 0,0:17:58.57,0:18:04.58,Default,,0,0,0,,《Кішкене жылы отты мәңгілік жанып тұрыңыз》
Dialogue: 0,0:18:04.58,0:18:09.25,Default,,0,0,0,,《Егер сен оған сол жалынды шашсаң, оны міндетті түрде көресің.》
Dialogue: 0,0:18:09.25,0:18:12.59,Default,,0,0,0,,《Бұл жасырын жасырылған жақсы нәрсе》
Dialogue: 0,0:18:12.59,0:18:14.59,Default,,0,0,0,,《Аа...》
Dialogue: 0,0:18:15.59,0:18:19.26,Default,,0,0,0,,Осыдан кейін мен тағы да гарденияны көруге бардым.
Dialogue: 0,0:18:19.26,0:18:22.26,Default,,0,0,0,,Гүлдер құлап кетсе де,
Dialogue: 0,0:18:22.26,0:18:25.27,Default,,0,0,0,,Жерге түскен жапырақшалар жаңбырмен суланған.
Dialogue: 0,0:18:25.27,0:18:28.57,Default,,0,0,0,,Тәтті иіске тұншығып бара жатқандай болдым.
Dialogue: 0,0:18:30.27,0:18:33.27,Default,,0,0,0,,Жақсы нәрсе жасырылды.
Dialogue: 0,0:18:33.27,0:18:35.28,Default,,0,0,0,,Иә
Dialogue: 0,0:18:35.28,0:18:40.62,Default,,0,0,0,,♬～
Dialogue: 0,0:18:40.62,0:18:45.95,Default,,0,0,0,,Кішкентай, сәл жылы отты жағуды жалғастырсаңыз
Dialogue: 0,0:18:45.95,0:18:50.26,Default,,0,0,0,,Жасырын жасырылған сұлулық көзге түседі
Dialogue: 0,0:18:52.23,0:18:55.23,Default,,0,0,0,,Хехе, ұзақ болды.
Dialogue: 0,0:18:55.23,0:18:58.93,Default,,0,0,0,,Демалайық па? Иә.
Dialogue: 0,0:19:01.24,0:19:03.24,Default,,0,0,0,,(Дыбыс шығару)
Dialogue: 0,0:19:03.24,0:19:10.91,Default,,0,0,0,,♬～
Dialogue: 0,0:19:10.91,0:19:12.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:12.91,0:19:19.59,Default,,0,0,0,,♬～
Dialogue: 0,0:19:19.59,0:19:21.59,Default,,0,0,0,,Pupupupupuip
Dialogue: 0,0:19:21.59,0:19:27.93,Default,,0,0,0,,♬～
Dialogue: 0,0:19:27.93,0:19:30.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:30.26,0:19:34.94,Default,,0,0,0,,Қатты қара~ Ой, мен бәрін өшірдім.
Dialogue: 0,0:19:34.94,0:19:38.94,Default,,0,0,0,,Алисия! О, құдайым
Dialogue: 0,0:19:38.94,0:19:43.94,Default,,0,0,0,,♬～
Dialogue: 0,0:19:43.94,0:19:45.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:45.95,0:19:47.95,Default,,0,0,0,,Жарық...
Dialogue: 0,0:19:47.95,0:19:50.62,Default,,0,0,0,,Пуи! А, президент Ария?
Dialogue: 0,0:19:50.62,0:20:10.64,Default,,0,0,0,,♬～
Dialogue: 0,0:20:10.64,0:20:14.31,Default,,0,0,0,,♬～
Dialogue: 0,0:20:14.31,0:20:16.61,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:20:18.65,0:20:22.65,Default,,0,0,0,,Жұлдыздар соншалықты жарық болды, солай емес пе?
Dialogue: 0,0:20:23.98,0:20:26.99,Default,,0,0,0,,Бұл әдеттегі бөлме болса да...
Dialogue: 0,0:20:28.66,0:20:32.66,Default,,0,0,0,,Бұл өте жұмбақ.
Dialogue: 0,0:20:32.66,0:20:34.66,Default,,0,0,0,,Пуинью
Dialogue: 0,0:20:35.66,0:20:38.67,Default,,0,0,0,,Иә, егер ол бірдей болса да.
Dialogue: 0,0:20:38.67,0:20:42.67,Default,,0,0,0,,Күннің уақытына байланысты мүлде басқа беттерді көрсетеді.
Dialogue: 0,0:20:42.67,0:20:47.34,Default,,0,0,0,,Жыл мезгілдері өзгерген сайын атмосфера мен түстер де өзгереді.
Dialogue: 0,0:20:47.34,0:20:50.28,Default,,0,0,0,,Ең бастысы, қазіргі уақытқа бейімделіңіз
Dialogue: 0,0:20:50.28,0:20:52.61,Default,,0,0,0,,Тек өз сезімдеріммен
Dialogue: 0,0:20:52.61,0:20:55.95,Default,,0,0,0,,Сіз көріп отырған әлем толығымен өзгереді
Dialogue: 0,0:20:55.95,0:20:58.95,Default,,0,0,0,,Сіз өзіңіз білмеген керемет нәрсені көресіз
Dialogue: 0,0:20:58.95,0:21:01.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:01.62,0:21:05.96,Default,,0,0,0,,Тіпті мен әлі көп білмеймін.
Dialogue: 0,0:21:05.96,0:21:10.97,Default,,0,0,0,,Бірақ мен бұған өте қуаныштымын.
Dialogue: 0,0:21:10.97,0:21:14.97,Default,,0,0,0,,Өйткені біз білмейтін нәрселер көп.
Dialogue: 0,0:21:14.97,0:21:18.57,Default,,0,0,0,,Әлі де көп тамаша істер күтіп тұр.
Dialogue: 0,0:21:19.97,0:21:23.31,Default,,0,0,0,,Бұдан былай көп, көп, көп
Dialogue: 0,0:21:23.31,0:21:27.01,Default,,0,0,0,,Бұл керемет адамды кездестіруге болатынын білдіреді.
Dialogue: 0,0:21:28.32,0:21:30.65,Default,,0,0,0,,«бәріміз тартынған оқиға орнына бардық —»
Dialogue: 0,0:21:30.65,0:21:33.99,Default,,0,0,0,,Бұл қазірдің өзінде қиын, Акари-чан.
Dialogue: 0,0:21:33.99,0:21:38.33,Default,,0,0,0,,Керемет нәрселер шексіз.
Dialogue: 0,0:21:38.33,0:21:49.34,Default,,0,0,0,,♬～
Dialogue: 0,0:21:49.34,0:21:52.94,Default,,0,0,0,,<Алисия-сан мен бұрын ешқашан білмеген нәрсе➡
Dialogue: 0,0:21:52.94,0:21:56.24,Default,,0,0,0,,Ол маған көп нәрсені үйретті＞
Dialogue: 0,0:21:57.28,0:22:01.95,Default,,0,0,0,,<Сонымен қатар, Алисия бір кездері осында тұрған➡
Dialogue: 0,0:22:01.95,0:22:05.95,Default,,0,0,0,,Бұл бөлмені ARIA компаниясының жаңа қызметкерлері ұрпақтар бойы пайдаланып келеді➡
Dialogue: 0,0:22:05.95,0:22:09.29,Default,,0,0,0,,Берілген заттар>
Dialogue: 0,0:22:09.29,0:22:13.96,Default,,0,0,0,,<Ай-чан, сенің білмейтінің өте керемет➡
Dialogue: 0,0:22:13.96,0:22:17.26,Default,,0,0,0,,Мен білдім! ＞
Dialogue: 0,0:22:19.63,0:22:22.97,Default,,0,0,0,,<Шексіздік қандай тамаша...>
Dialogue: 0,0:22:22.97,0:22:26.64,Default,,0,0,0,,<Тамаша нәрселердің шегі жоқ.>
Dialogue: 0,0:22:26.64,0:22:29.64,Default,,0,0,0,,<Бұл өте жақсы>
Dialogue: 0,0:22:29.64,0:22:49.66,Default,,0,0,0,,♬～
Dialogue: 0,0:22:49.66,0:23:09.62,Default,,0,0,0,,♬～
Dialogue: 0,0:23:09.62,0:23:29.64,Default,,0,0,0,,♬～
Dialogue: 0,0:23:29.64,0:23:49.66,Default,,0,0,0,,♬～
Dialogue: 0,0:23:49.66,0:23:54.66,Default,,0,0,0,,♬～
