Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.30,0:00:07.64,Default,,0,0,0,,<Ай Чан, мен бүгін кезекті тексеруден өткен гондоланы алуға бардым➡
Dialogue: 0,0:00:07.64,0:00:09.64,Default,,0,0,0,,Алисиямен➡
Dialogue: 0,0:00:09.64,0:00:13.34,Default,,0,0,0,,Мен Squero＞ деп аталатын гондола шеберханасындамын
Dialogue: 0,0:00:15.31,0:00:21.32,Default,,0,0,0,,<Айтпақшы, әр гондоланы шебер қолмен жасайды.>
Dialogue: 0,0:00:21.32,0:00:25.65,Default,,0,0,0,,<Әр қайықтың өндіру мерзімі шамамен 3 айды құрайды>
Dialogue: 0,0:00:25.65,0:00:28.66,Default,,0,0,0,,<Пайдалану мерзімі шамамен 20 жыл>
Dialogue: 0,0:00:28.66,0:00:30.99,Default,,0,0,0,,<Кем дегенде бірнеше жылда бір рет➡
Dialogue: 0,0:00:30.99,0:00:33.66,Default,,0,0,0,,Біз оны күрделі жөндеуіміз керек>
Dialogue: 0,0:00:33.66,0:00:37.07,Default,,0,0,0,,Пууууууфуфуфу
Dialogue: 0,0:00:38.67,0:00:42.34,Default,,0,0,0,,<Бұл гондола әбден ескірген сияқты➡
Dialogue: 0,0:00:42.34,0:00:45.34,Default,,0,0,0,,Менің қымбатты серігім＞
Dialogue: 0,0:00:48.01,0:00:51.01,Default,,0,0,0,,Хехе... Жоқ, кешіріңіз, кешіріңіз.
Dialogue: 0,0:00:51.01,0:00:54.35,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз. Жоқ.
Dialogue: 0,0:00:54.35,0:00:58.02,Default,,0,0,0,,- тексеру нәтижесі.
Dialogue: 0,0:00:58.02,0:01:01.29,Default,,0,0,0,,Оны ауыстырудың уақыты келді.
Dialogue: 0,0:01:01.29,0:01:04.96,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:01:04.96,0:01:08.30,Default,,0,0,0,,Мен біраз уақыттан бері ат мініп жүрмін.
Dialogue: 0,0:01:08.30,0:01:12.63,Default,,0,0,0,,Уау, уау... Мен әлі де дұрыс жүре аламын.
Dialogue: 0,0:01:12.63,0:01:16.31,Default,,0,0,0,,Жарайды, мініп алсам ғой.
Dialogue: 0,0:01:16.31,0:01:19.98,Default,,0,0,0,,Бірақ, шынымды айтсам, ақша алып, жолаушыларды бортқа апару керек пе?
Dialogue: 0,0:01:19.98,0:01:23.65,Default,,0,0,0,,Мені дөрекі деп санайтын дәрежеге дейін ренжідім.
Dialogue: 0,0:01:23.65,0:01:27.65,Default,,0,0,0,,Олай болса, оны тек тәжірибе үшін сақтау дегенді қалай түсінесіңдер?
Dialogue: 0,0:01:27.65,0:01:31.65,Default,,0,0,0,,Сора, мен гондоланы аяймын.
Dialogue: 0,0:01:31.65,0:01:36.99,Default,,0,0,0,,Неғұрлым аз пайдалансаңыз, соғұрлым ол тез боса бастайды.
Dialogue: 0,0:01:36.99,0:01:39.66,Default,,0,0,0,,Жолаушыны тасымалдау мүмкін болмаса да
Dialogue: 0,0:01:39.66,0:01:44.33,Default,,0,0,0,,Оны әлі де тасымалдау мақсатында пайдалануға болады.
Dialogue: 0,0:01:44.33,0:01:47.67,Default,,0,0,0,,Күнделікті пайдаланатын иесінің астында
Dialogue: 0,0:01:47.67,0:01:51.34,Default,,0,0,0,,Мен сені пайдалы қызмет мерзіміңнің соңына дейін жұмыс істеймін.
Dialogue: 0,0:01:51.34,0:01:56.01,Default,,0,0,0,,Бұл гондола үшін ең бақытты нәрсе ме?
Dialogue: 0,0:01:56.01,0:02:00.95,Default,,0,0,0,,♬～
Dialogue: 0,0:02:00.95,0:02:02.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:02.95,0:02:22.97,Default,,0,0,0,,♬～
Dialogue: 0,0:02:22.97,0:02:42.99,Default,,0,0,0,,♬～
Dialogue: 0,0:02:42.99,0:03:02.94,Default,,0,0,0,,♬～
Dialogue: 0,0:03:02.94,0:03:22.96,Default,,0,0,0,,♬～
Dialogue: 0,0:03:22.96,0:03:42.98,Default,,0,0,0,,♬～
Dialogue: 0,0:03:42.98,0:03:47.29,Default,,0,0,0,,♬～
Dialogue: 0,0:03:56.67,0:03:58.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:58.67,0:04:11.28,Default,,0,0,0,,♬～
Dialogue: 0,0:04:11.28,0:04:13.62,Default,,0,0,0,,Амансың ба? Акари-чан
Dialogue: 0,0:04:13.62,0:04:16.28,Default,,0,0,0,,Ах... хахи
Dialogue: 0,0:04:16.28,0:04:18.95,Default,,0,0,0,,Қоштасуға мұңайып отырмын.
Dialogue: 0,0:04:18.95,0:04:23.29,Default,,0,0,0,,Тұтынушыларға дөрекілік көрсету дұрыс емес.
Dialogue: 0,0:04:23.29,0:04:25.29,Default,,0,0,0,,Ағай айтқандай
Dialogue: 0,0:04:25.29,0:04:29.63,Default,,0,0,0,,Күнделікті мінгізетін адаммен бірге болған жақсы.
Dialogue: 0,0:04:29.63,0:04:33.64,Default,,0,0,0,,Бұл гондолаға сіз де риза болатыныңызға сенімдімін.
Dialogue: 0,0:04:36.30,0:04:40.64,Default,,0,0,0,,Акари-чан, ертең 1-ші, камераңызды әкеліңіз
Dialogue: 0,0:04:40.64,0:04:44.65,Default,,0,0,0,,Неліктен мына гондоланы алып, есте қалатын жерлерге бармасқа?
Dialogue: 0,0:04:44.65,0:04:46.65,Default,,0,0,0,,Не? Бірақ ертең
Dialogue: 0,0:04:46.65,0:04:49.65,Default,,0,0,0,,Мен Алисияға көмектесуім керек...
Dialogue: 0,0:04:49.65,0:04:52.32,Default,,0,0,0,,Уфуфу, жарайды.
Dialogue: 0,0:04:52.32,0:04:54.99,Default,,0,0,0,,Пуи Пуиню ~ Пуи
Dialogue: 0,0:04:54.99,0:04:56.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:01.93,0:05:04.60,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:04.60,0:05:24.62,Default,,0,0,0,,♬～
Dialogue: 0,0:05:24.62,0:05:44.31,Default,,0,0,0,,♬～
Dialogue: 0,0:05:44.31,0:05:47.61,Default,,0,0,0,,《Бұл Акари-чан қолданатын гондола》
Dialogue: 0,0:05:49.31,0:05:52.65,Default,,0,0,0,,《Уау~ Бұл нағыз гондола! 》
Dialogue: 0,0:05:52.65,0:05:54.98,Default,,0,0,0,,《Ой, хехехе》
Dialogue: 0,0:05:54.98,0:05:59.59,Default,,0,0,0,,《Көп рахмет, Гондола мырза》
Dialogue: 0,0:06:03.26,0:06:05.93,Default,,0,0,0,,《Мизунаши Тори осында! 》
Dialogue: 0,0:06:05.93,0:06:09.23,Default,,0,0,0,,《Иә, иә》 (Президент Ария) 《Пуйпуи》
Dialogue: 0,0:06:10.27,0:06:12.27,Default,,0,0,0,,《Мм...》 《Иә? 》
Dialogue: 0,0:06:12.27,0:06:14.27,Default,,0,0,0,,《Пуй? 》
Dialogue: 0,0:06:14.27,0:06:28.95,Default,,0,0,0,,♬～
Dialogue: 0,0:06:28.95,0:06:32.95,Default,,0,0,0,,《Пуй-ча, пу-ича, пуи-ча, пуи-пуи-ча…》
Dialogue: 0,0:06:32.95,0:06:35.62,Default,,0,0,0,,《Ғажайып, Акари-чан》
Dialogue: 0,0:06:35.62,0:06:39.29,Default,,0,0,0,,《Бірақ айту қиын...➡
Dialogue: 0,0:06:39.29,0:06:41.30,Default,,0,0,0,,Қарсы бағытта есу》
Dialogue: 0,0:06:41.30,0:06:44.30,Default,,0,0,0,,《Е... иә? 》
Dialogue: 0,0:06:46.30,0:06:50.31,Default,,0,0,0,,Хехе... Ертең көп суретке түсейік.
Dialogue: 0,0:06:50.31,0:06:53.31,Default,,0,0,0,,Пуича Пуи Пуича
Dialogue: 0,0:06:53.31,0:07:00.62,Default,,0,0,0,,♬～
Dialogue: 0,0:07:01.58,0:07:04.25,Default,,0,0,0,,Камера Жарайды! Пуи
Dialogue: 0,0:07:04.25,0:07:07.59,Default,,0,0,0,,Жақсы түскі ас! Pupupuiccha~
Dialogue: 0,0:07:07.59,0:07:10.93,Default,,0,0,0,,Жақсы ауа-райы! Пуи
Dialogue: 0,0:07:10.93,0:07:15.26,Default,,0,0,0,,Олай болса, Гондола мырза, қоштасу сапарына барайық!
Dialogue: 0,0:07:15.26,0:07:18.97,Default,,0,0,0,,Пуйпуи Акари-чан
Dialogue: 0,0:07:20.27,0:07:22.27,Default,,0,0,0,,Иә
Dialogue: 0,0:07:23.61,0:07:26.01,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:07:27.28,0:07:29.61,Default,,0,0,0,,Иә, барамын.
Dialogue: 0,0:07:29.61,0:07:37.29,Default,,0,0,0,,♬～
Dialogue: 0,0:07:37.29,0:07:39.29,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:07:39.29,0:07:53.64,Default,,0,0,0,,♬～
Dialogue: 0,0:07:53.64,0:07:55.64,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:57.64,0:07:59.64,Default,,0,0,0,,《Ол...бұл...》
Dialogue: 0,0:07:59.64,0:08:02.24,Default,,0,0,0,,《Акари-чан, сабыр ет》 《Хахи! 》
Dialogue: 0,0:08:02.24,0:08:04.58,Default,,0,0,0,,《Кешіріңіз, кешіріңіз, кешіріңіз, кешіріңіз...》
Dialogue: 0,0:08:04.58,0:08:06.58,Default,,0,0,0,,《Ах! 》 《(Соқтығыс дыбысы)》
Dialogue: 0,0:08:06.58,0:08:26.60,Default,,0,0,0,,♬～
Dialogue: 0,0:08:26.60,0:08:30.61,Default,,0,0,0,,♬～
Dialogue: 0,0:08:30.61,0:08:32.61,Default,,0,0,0,,Сәлем Момико!
Dialogue: 0,0:08:32.61,0:08:36.28,Default,,0,0,0,,Акацуки-сан! Сізді күткенім үшін кешіріңіз
Dialogue: 0,0:08:36.28,0:08:39.95,Default,,0,0,0,,Ал, сен бүгін не істеп жатырсың?
Dialogue: 0,0:08:39.95,0:08:42.62,Default,,0,0,0,,Гондола мырза, қоштасу сапары.
Dialogue: 0,0:08:42.62,0:08:44.62,Default,,0,0,0,,Не? Яғни
Dialogue: 0,0:08:44.62,0:08:47.96,Default,,0,0,0,,Негізі бүгін мен осы гондола-санмен біргемін.
Dialogue: 0,0:08:47.96,0:08:50.96,Default,,0,0,0,,Бұл соңғы есте қалдыруға арналған экскурсия.
Dialogue: 0,0:08:50.96,0:08:52.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:52.96,0:08:55.63,Default,,0,0,0,,Жолаушыларды қазірдің өзінде мінгізу үшін
Dialogue: 0,0:08:55.63,0:08:57.97,Default,,0,0,0,,Өйткені ол тым зақымдалған
Dialogue: 0,0:08:57.97,0:09:01.90,Default,,0,0,0,,Біз гондоланы жаңартуды шештік.
Dialogue: 0,0:09:01.90,0:09:05.24,Default,,0,0,0,,Мен Акацуки мырзаны мына гондолаға отырғыздым.
Dialogue: 0,0:09:05.24,0:09:10.25,Default,,0,0,0,,Сіз біздің бірінші тұтынушымыз болғандықтан, турға бізге қосылуыңызды қалаймыз.
Dialogue: 0,0:09:10.25,0:09:13.25,Default,,0,0,0,,Мм... хмм, түсіндім.
Dialogue: 0,0:09:13.25,0:09:15.25,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:15.25,0:09:18.55,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:24.26,0:09:28.60,Default,,0,0,0,,Енді біз Акацукиді алғаш рет өткізген курсты алайық.
Dialogue: 0,0:09:28.60,0:09:30.60,Default,,0,0,0,,О
Dialogue: 0,0:09:31.93,0:09:36.27,Default,,0,0,0,,《Сәлеметсіз бе, Момико, Укишимаға арналған аспалы жол станциясына барыңыз.》
Dialogue: 0,0:09:36.27,0:09:39.94,Default,,0,0,0,,《Акури-чан, сен тұтынушысың ба? Керемет емес пе》
Dialogue: 0,0:09:39.94,0:09:43.61,Default,,0,0,0,,《Хахи! 》 (Президент Ария)《Пуй Пуиню》
Dialogue: 0,0:09:43.61,0:09:47.28,Default,,0,0,0,,《О? Бірақ бүгін тексеретініме сенімдімін➡
Dialogue: 0,0:09:47.28,0:09:50.62,Default,,0,0,0,,Аспалы жол сағат 6-да аяқталады, солай ма? 》
Dialogue: 0,0:09:50.62,0:09:54.29,Default,,0,0,0,,《Аа...》 《сағат 6... 15 минут қалды ма? 》
Dialogue: 0,0:09:54.29,0:09:57.29,Default,,0,0,0,,《Хахи хахи хахи хахи хахи➡
Dialogue: 0,0:09:57.29,0:10:01.00,Default,,0,0,0,,Хахи хахи хахи...》 (Акацуки)《Сіз уақытында үлгересіз бе? 》
Dialogue: 0,0:10:03.63,0:10:08.30,Default,,0,0,0,,《Кешіріңіз... менің қолым уақытында үлгермейді》
Dialogue: 0,0:10:08.30,0:10:12.31,Default,,0,0,0,,《Алисия-сан, өтінемін》
Dialogue: 0,0:10:12.31,0:10:14.64,Default,,0,0,0,,《Бір минут күте тұрыңыз! 》 《Аа...》
Dialogue: 0,0:10:14.64,0:10:18.65,Default,,0,0,0,,《Мен тек жарты адамға төлей аламын, шындап айта аламын》
Dialogue: 0,0:10:18.65,0:10:23.32,Default,,0,0,0,,《Сонымен қатар, мен сенің қонағыңмын, Момико.》
Dialogue: 0,0:10:23.32,0:10:27.62,Default,,0,0,0,,《Тіпті жарты порция болса да, ол қайтарылмайды, солай ма? 》
Dialogue: 0,0:10:28.99,0:10:32.99,Default,,0,0,0,,《А... түсіндім》
Dialogue: 0,0:10:38.00,0:10:44.01,Default,,0,0,0,,《Бұдан былай біз тұтынушының көруіне кедергі келтіретіндей жолға шығамыз》
Dialogue: 0,0:10:44.01,0:10:46.01,Default,,0,0,0,,《Бару》
Dialogue: 0,0:10:46.01,0:10:57.69,Default,,0,0,0,,♬～
Dialogue: 0,0:10:57.69,0:11:01.39,Default,,0,0,0,,《Жасай берейік Момико》 《Иә》
Dialogue: 0,0:11:02.96,0:11:06.29,Default,,0,0,0,,♬～
Dialogue: 0,0:11:06.29,0:11:09.30,Default,,0,0,0,,Еңбегіңіз үшін рахмет. Бұл соңғы нүкте.
Dialogue: 0,0:11:09.30,0:11:11.30,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:12.63,0:11:14.64,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:11:16.30,0:11:19.97,Default,,0,0,0,,Бүгін бізге қосылғаныңыз үшін рахмет.
Dialogue: 0,0:11:19.97,0:11:22.64,Default,,0,0,0,,Оу (Президент Ария) Пупу Пуиню
Dialogue: 0,0:11:22.64,0:11:25.31,Default,,0,0,0,,Неге сонша байыпты көрінесің, пони-адам?
Dialogue: 0,0:11:25.31,0:11:27.65,Default,,0,0,0,,Nu? Бұл гача қаламы ма?
Dialogue: 0,0:11:27.65,0:11:29.98,Default,,0,0,0,,Айка-чан Алиса-чан Қайырлы таң
Dialogue: 0,0:11:29.98,0:11:32.99,Default,,0,0,0,,Сен не үшін келдің? Мен және менің кенжем
Dialogue: 0,0:11:32.99,0:11:35.66,Default,,0,0,0,,Мен осы турдың келесі қатысушысымын.
Dialogue: 0,0:11:35.66,0:11:37.66,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:39.66,0:11:43.67,Default,,0,0,0,,Екінші өміріңізді жақсы өткізіңіз
Dialogue: 0,0:11:43.67,0:11:45.67,Default,,0,0,0,,Ал...
Dialogue: 0,0:11:45.67,0:11:49.67,Default,,0,0,0,,Кейін кездескенше Момико Иә.
Dialogue: 0,0:11:49.67,0:11:53.68,Default,,0,0,0,,♪ Мен жанып тұрған Саламандірмін
Dialogue: 0,0:11:53.68,0:11:56.68,Default,,0,0,0,,♪ Мен саған көз жасымды көрсетпеймін... Сонымен, барамыз ба?
Dialogue: 0,0:11:56.68,0:12:00.95,Default,,0,0,0,,Мен үлкендермен алғаш кездескен мүйіске барғым келеді.
Dialogue: 0,0:12:00.95,0:12:02.95,Default,,0,0,0,,Иә
Dialogue: 0,0:12:14.96,0:12:26.64,Default,,0,0,0,,♬～
Dialogue: 0,0:12:26.64,0:12:28.64,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:12:29.98,0:12:33.28,Default,,0,0,0,,Бұл жолы тек гондолалар
Dialogue: 0,0:12:35.32,0:12:37.32,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:12:37.32,0:12:47.33,Default,,0,0,0,,♬～
Dialogue: 0,0:12:47.33,0:12:50.26,Default,,0,0,0,,Көп қиындық тудырды
Dialogue: 0,0:12:50.26,0:12:52.93,Default,,0,0,0,,Мен сені мүмкін емес нәрсеге мәжбүрледім бе?
Dialogue: 0,0:12:52.93,0:12:55.94,Default,,0,0,0,,Бірақ эй, бұл сенің гондоласың.
Dialogue: 0,0:12:55.94,0:12:58.61,Default,,0,0,0,,Оған көмектесу мүмкін емес екеніне сенімдімін.
Dialogue: 0,0:12:58.61,0:13:00.61,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:13:00.61,0:13:04.28,Default,,0,0,0,,Гондолистер де сөйлесіп тұрған сияқты.
Dialogue: 0,0:13:04.28,0:13:06.28,Default,,0,0,0,,Қоштасу кеші?
Dialogue: 0,0:13:06.28,0:13:08.62,Default,,0,0,0,,Бәлкім, ол ұятсыз сөздер айтқан шығар.
Dialogue: 0,0:13:08.62,0:13:11.32,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:13:13.29,0:13:18.29,Default,,0,0,0,,Біздің де аттракциондар көп болды емес пе?
Dialogue: 0,0:13:18.29,0:13:21.96,Default,,0,0,0,,Айка-сенпай, жылап тұрсың ба?
Dialogue: 0,0:13:21.96,0:13:24.63,Default,,0,0,0,,Жоқ! Няня... Сен мұны мияулап айтып тұрсың ба?
Dialogue: 0,0:13:24.63,0:13:27.30,Default,,0,0,0,,Сіз мүлде жыламайсыз!
Dialogue: 0,0:13:27.30,0:13:30.97,Default,,0,0,0,,Анау, анау... шайдың буы көзімді қағып кетті.
Dialogue: 0,0:13:30.97,0:13:32.97,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:13:34.31,0:13:37.31,Default,,0,0,0,,Жақында кездескенше, уақытыңызды бөліңіз.
Dialogue: 0,0:13:37.31,0:13:40.01,Default,,0,0,0,,(Бүкіл Құдірет-тың ауыр демі)
Dialogue: 0,0:13:43.99,0:13:46.99,Default,,0,0,0,,Олай болса, Гондола мырза, қоштасу сапары.
Dialogue: 0,0:13:46.99,0:13:49.32,Default,,0,0,0,,3-бөлім (Президент Ария) Пуиню
Dialogue: 0,0:13:49.32,0:13:51.26,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:13:51.26,0:14:04.94,Default,,0,0,0,,♬～
Dialogue: 0,0:14:04.94,0:14:09.28,Default,,0,0,0,,Соңғы курс – жоғарылату емтиханының бірыңғай курсы.
Dialogue: 0,0:14:09.28,0:14:11.28,Default,,0,0,0,,Пуинью
Dialogue: 0,0:14:11.28,0:14:31.30,Default,,0,0,0,,♬～
Dialogue: 0,0:14:31.30,0:14:33.30,Default,,0,0,0,,♬～
Dialogue: 0,0:14:33.30,0:14:35.97,Default,,0,0,0,,Емтиханға келетін болсақ, бұл емтихан курсы.
Dialogue: 0,0:14:35.97,0:14:39.31,Default,,0,0,0,,Үйретпеу дәстүрі.
Dialogue: 0,0:14:39.31,0:14:43.64,Default,,0,0,0,,Мен де ол кезде ештеңе білмедім.
Dialogue: 0,0:14:43.64,0:14:46.05,Default,,0,0,0,,Сондай сағыныш
Dialogue: 0,0:14:47.98,0:14:52.59,Default,,0,0,0,,Иә? Ағай, өтінемін!
Dialogue: 0,0:14:52.59,0:14:54.59,Default,,0,0,0,,Екеуі де осы Спорт фестивалінде жоғары деңгейдегі нәтижелерге қол жеткізді!
Dialogue: 0,0:15:22.28,0:15:25.29,Default,,0,0,0,,I Емтиханға алғаш келгенімде
Dialogue: 0,0:15:25.29,0:15:28.29,Default,,0,0,0,,Маған су шабуыл жасап жатыр деп ойладым...
Dialogue: 0,0:15:28.29,0:15:31.63,Default,,0,0,0,,Пуи Мен ұйықтап кететін сияқтымын
Dialogue: 0,0:15:31.63,0:15:34.30,Default,,0,0,0,,Демалуға көп уақыт
Dialogue: 0,0:15:34.30,0:15:37.00,Default,,0,0,0,,Мен оны қазір жақсы көремін
Dialogue: 0,0:15:46.64,0:15:48.64,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:48.64,0:15:50.58,Default,,0,0,0,,Екеуі де осы Спорт фестивалінде жоғары деңгейдегі нәтижелерге қол жеткізді!
Dialogue: 0,0:15:50.58,0:16:06.93,Default,,0,0,0,,♬～
Dialogue: 0,0:16:06.93,0:16:09.93,Default,,0,0,0,,《Уау... Керемет! 》
Dialogue: 0,0:16:12.27,0:16:16.97,Default,,0,0,0,,《Аа... уау~》
Dialogue: 0,0:16:21.28,0:16:26.61,Default,,0,0,0,,《Бұл жер Үнділер арасындағы Үміт шоқысы деп аталады.》
Dialogue: 0,0:16:26.61,0:16:28.62,Default,,0,0,0,,《Үміт шоқы...》
Dialogue: 0,0:16:28.62,0:16:32.62,Default,,0,0,0,,《Сіз осы жерден Нео-Венецияның панорамалық көрінісін көре аласыз》
Dialogue: 0,0:16:33.96,0:16:35.96,Default,,0,0,0,,《А...》
Dialogue: 0,0:16:40.96,0:16:42.96,Default,,0,0,0,,«Вау…»
Dialogue: 0,0:16:42.96,0:16:46.97,Default,,0,0,0,,《Акари-чан》 《Иә》
Dialogue: 0,0:16:46.97,0:16:48.97,Default,,0,0,0,,《Кімге? 》
Dialogue: 0,0:16:52.57,0:16:54.58,Default,,0,0,0,,《А...》
Dialogue: 0,0:16:54.58,0:16:57.91,Default,,0,0,0,,《Өткенің құтты болсын》 《Иә? 》
Dialogue: 0,0:16:57.91,0:17:01.25,Default,,0,0,0,,《Акари-чан бүгіннен бойдақ》
Dialogue: 0,0:17:01.25,0:17:04.25,Default,,0,0,0,,《Хеха...》 《Пуинью! 》
Dialogue: 0,0:17:04.25,0:17:08.26,Default,,0,0,0,,《Шынымен бе? Алисия》《Иә》
Dialogue: 0,0:17:08.26,0:17:11.26,Default,,0,0,0,,《Пупуи Пуинюпуи! 》
Dialogue: 0,0:17:15.60,0:17:19.60,Default,,0,0,0,,Президент, суретке түсеміз бе?
Dialogue: 0,0:17:19.60,0:17:21.60,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:17:21.60,0:17:41.62,Default,,0,0,0,,♬～
Dialogue: 0,0:17:41.62,0:17:43.62,Default,,0,0,0,,♬～
Dialogue: 0,0:17:43.62,0:17:45.63,Default,,0,0,0,,Пуи…
Dialogue: 0,0:17:45.63,0:17:57.04,Default,,0,0,0,,♬～
Dialogue: 0,0:18:10.59,0:18:12.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:16.26,0:18:19.96,Default,,0,0,0,,Бұл тұтынушы...?
Dialogue: 0,0:18:22.26,0:18:24.93,Default,,0,0,0,,Қашаннан бері...
Dialogue: 0,0:18:24.93,0:18:27.94,Default,,0,0,0,,Мен біраз уақыттан бері басшылықты қолға алдым.
Dialogue: 0,0:18:27.94,0:18:31.27,Default,,0,0,0,,А... мен үшін ескек те бере аласыз ба?
Dialogue: 0,0:18:31.27,0:18:35.28,Default,,0,0,0,,Аа, бірақ мен әлі де жартылай тоқпын...
Dialogue: 0,0:18:35.28,0:18:37.98,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:18:40.62,0:18:44.62,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:18:45.62,0:18:47.62,Default,,0,0,0,,Қаншалықты?
Dialogue: 0,0:18:47.62,0:18:50.56,Default,,0,0,0,,Алдағы жолдың айырығына дейін
Dialogue: 0,0:18:50.56,0:18:52.56,Default,,0,0,0,,Иә
Dialogue: 0,0:18:52.56,0:19:03.90,Default,,0,0,0,,♬～
Dialogue: 0,0:19:03.90,0:19:06.57,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:19:06.57,0:19:09.24,Default,,0,0,0,,Иә
Dialogue: 0,0:19:09.24,0:19:12.91,Default,,0,0,0,,Неге менің гондоламда?
Dialogue: 0,0:19:12.91,0:19:16.58,Default,,0,0,0,,Енді неге?
Dialogue: 0,0:19:16.58,0:19:21.26,Default,,0,0,0,,Мен бұл байланыс екеніне сенімдімін.
Dialogue: 0,0:19:21.26,0:19:25.93,Default,,0,0,0,,Бұл байланыс па? Бұл керемет сөз.
Dialogue: 0,0:19:25.93,0:19:28.93,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:32.93,0:19:34.94,Default,,0,0,0,,келді
Dialogue: 0,0:19:37.27,0:19:42.94,Default,,0,0,0,,Мен тағы біраз уақыт жүре аламын ба?
Dialogue: 0,0:19:42.94,0:19:47.55,Default,,0,0,0,,Есікті сәл ұзағырақ жалғастыра аласыз ба?
Dialogue: 0,0:19:51.29,0:19:53.62,Default,,0,0,0,,Иә
Dialogue: 0,0:19:53.62,0:19:56.29,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:56.29,0:20:15.98,Default,,0,0,0,,♬～
Dialogue: 0,0:20:15.98,0:20:17.98,Default,,0,0,0,,♬～
Dialogue: 0,0:20:20.31,0:20:22.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:22.32,0:20:25.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:25.32,0:20:27.32,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:20:28.99,0:20:33.33,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:20:33.33,0:20:37.33,Default,,0,0,0,,Пу... Пуиню...
Dialogue: 0,0:20:39.33,0:20:42.04,Default,,0,0,0,,Әлгі қарт...
Dialogue: 0,0:20:48.34,0:20:50.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:50.28,0:21:07.63,Default,,0,0,0,,♬～
Dialogue: 0,0:21:07.63,0:21:10.30,Default,,0,0,0,,Дәл қазір, Алисия.
Dialogue: 0,0:21:10.30,0:21:12.97,Default,,0,0,0,,Пупупуиню~
Dialogue: 0,0:21:12.97,0:21:15.27,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:21:19.97,0:21:21.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:21.98,0:21:29.98,Default,,0,0,0,,♬～
Dialogue: 0,0:21:29.98,0:21:34.66,Default,,0,0,0,,Алисия, есіңде ме?
Dialogue: 0,0:21:34.66,0:21:37.99,Default,,0,0,0,,Бұл жағдай
Dialogue: 0,0:21:37.99,0:21:43.00,Default,,0,0,0,,Дәл осы гондолаға алғаш мінгенімдей.
Dialogue: 0,0:21:43.00,0:21:45.00,Default,,0,0,0,,Иә
Dialogue: 0,0:21:45.00,0:21:54.28,Default,,0,0,0,,♬～
Dialogue: 0,0:21:54.28,0:21:56.61,Default,,0,0,0,,Акари-чан...
Dialogue: 0,0:21:56.61,0:22:02.95,Default,,0,0,0,,♬～
Dialogue: 0,0:22:02.95,0:22:08.96,Default,,0,0,0,,Алисия, бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:22:11.29,0:22:13.96,Default,,0,0,0,,Жүр, кешкі ас ішейік.
Dialogue: 0,0:22:13.96,0:22:15.96,Default,,0,0,0,,Хахи (Президент Ария) Пуи Пупу Пуича~!
Dialogue: 0,0:22:15.96,0:22:19.63,Default,,0,0,0,,О, хэхехе (Президент Ария) Пуи Пуи Пуи...!
Dialogue: 0,0:22:19.63,0:22:24.31,Default,,0,0,0,,<Ай-чан, ертең гондоламен қоштасатын күн>
Dialogue: 0,0:22:24.31,0:22:29.31,Default,,0,0,0,,<Акари-сан, сен енді ол гондолаға міне алмайсың.>
Dialogue: 0,0:22:29.31,0:22:33.61,Default,,0,0,0,,<Мен де дұрыстап қоштасқым келеді...>
Dialogue: 0,0:22:34.98,0:22:54.94,Default,,0,0,0,,♬～
Dialogue: 0,0:22:54.94,0:23:14.96,Default,,0,0,0,,♬～
Dialogue: 0,0:23:14.96,0:23:34.98,Default,,0,0,0,,♬～
Dialogue: 0,0:23:34.98,0:23:54.56,Default,,0,0,0,,♬～
