Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.58,0:00:07.46,Default,,0,0,0,,Мен басқа әлемге келдім.
Dialogue: 0,0:00:07.54,0:00:08.80,Default,,0,0,0,,Небәрі 40 жаста
Dialogue: 0,0:00:12.38,0:00:14.88,Default,,0,0,0,,Баяу өмірге ұмтылу
Dialogue: 0,0:00:15.39,0:00:18.10,Default,,0,0,0,,Ал қазір біз
Dialogue: 0,0:00:18.18,0:00:20.68,Default,,0,0,0,,Менің осы елдің корольдік отбасымен аудиториясы болды.
Dialogue: 0,0:00:26.02,0:00:29.77,Default,,0,0,0,,Енді өз өміріңді өртеп жіберетін кез!
Dialogue: 0,0:00:30.53,0:00:34.40,Default,,0,0,0,,♪～
Dialogue: 0,0:01:53.86,0:01:58.45,Default,,0,0,0,,～♪
Dialogue: 0,0:02:00.07,0:02:04.49,Default,,0,0,0,,(Дворяндардың шуы)
Dialogue: 0,0:02:09.08,0:02:11.08,Default,,0,0,0,,Ол сиқыршы ма?
Dialogue: 0,0:02:11.17,0:02:13.50,Default,,0,0,0,,Бұл олай емес
Dialogue: 0,0:02:13.59,0:02:17.01,Default,,0,0,0,,Тақ бөлмесіне аңдар мен аңдарды енгізу?
Dialogue: 0,0:02:17.09,0:02:20.01,Default,,0,0,0,,Мәртебелі де ерке.
Dialogue: 0,0:02:20.09,0:02:21.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:26.60,0:02:29.31,Default,,0,0,0,,Суық тиіп қалдың ба? Жағдайың қалай?
Dialogue: 0,0:02:30.02,0:02:33.02,Default,,0,0,0,,Барлығың тыныш болыңдар! Тыныш
Dialogue: 0,0:02:33.86,0:02:35.78,Default,,0,0,0,,Мәртебелі Корольдің шақыруымен
Dialogue: 0,0:02:35.86,0:02:37.15,Default,,0,0,0,,Өткізілген
Dialogue: 0,0:02:37.24,0:02:41.41,Default,,0,0,0,,Шекарашы сиқыршы Кеничи мен оның отбасынан табылған.
Dialogue: 0,0:02:41.49,0:02:43.53,Default,,0,0,0,,Бұдан былай сиқыршы Кеничи
Dialogue: 0,0:02:43.62,0:02:46.12,Default,,0,0,0,,Мәртебелі алдында соғысайық!
Dialogue: 0,0:02:46.20,0:02:47.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:48.62,0:02:51.04,Default,,0,0,0,,Ана, бұл не?
Dialogue: 0,0:02:51.12,0:02:55.04,Default,,0,0,0,,Король астанасының жарқыраған жаңа жұлдызына қарсы
Dialogue: 0,0:02:55.13,0:02:59.92,Default,,0,0,0,,Құрметті Мелисса Лана Настуртиум!
Dialogue: 0,0:03:00.01,0:03:01.18,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:01.26,0:03:05.43,Default,,0,0,0,,Мен мұнда неге ақсүйектер көп жиналды деп ойлаймын.
Dialogue: 0,0:03:01.26,0:03:05.43,Default,,0,0,0,,(Асылдардың күлкісі)
Dialogue: 0,0:03:05.51,0:03:07.56,Default,,0,0,0,,Адамдарды тамаша ету үшін ме?
Dialogue: 0,0:03:07.64,0:03:12.44,Default,,0,0,0,,Ахаха...!
Dialogue: 0,0:03:12.52,0:03:15.69,Default,,0,0,0,,Шекарадан ұлы сиқыршы келеді дейді.
Dialogue: 0,0:03:15.77,0:03:20.24,Default,,0,0,0,,Қызығып келсеңіз, оның жай ғана қария емес екенін көресіз.
Dialogue: 0,0:03:20.32,0:03:22.20,Default,,0,0,0,,Өкініштісі ол қарт адам.
Dialogue: 0,0:03:22.28,0:03:24.03,Default,,0,0,0,,Ақымақ адам
Dialogue: 0,0:03:24.12,0:03:25.70,Default,,0,0,0,,Отбасы мүшелерін қатыстыру
Dialogue: 0,0:03:25.78,0:03:28.29,Default,,0,0,0,,Ауылға тез қайт.
Dialogue: 0,0:03:29.12,0:03:33.67,Default,,0,0,0,,Тілегіме жауап бер, қараңғылықтың ізбасары!
Dialogue: 0,0:03:35.54,0:03:36.09,Default,,0,0,0,,Маған, Мазалаған жауға.
Dialogue: 0,0:03:36.09,0:03:37.46,Default,,0,0,0,,Маған, Мазалаған жауға.
Dialogue: 0,0:03:36.09,0:03:37.46,Default,,0,0,0,,Гааа!
Dialogue: 0,0:03:37.46,0:03:39.71,Default,,0,0,0,,Гааа!
Dialogue: 0,0:03:39.80,0:03:42.72,Default,,0,0,0,,Маған қара үкім беріңіз!
Dialogue: 0,0:03:43.38,0:03:44.97,Default,,0,0,0,,Кіші айдаһар ня
Dialogue: 0,0:03:45.97,0:03:49.47,Default,,0,0,0,,Қат! Оматсу-сан шақыру
Dialogue: 0,0:03:50.68,0:03:51.73,Default,,0,0,0,,-Мм... -Аа...
Dialogue: 0,0:03:51.81,0:03:54.94,Default,,0,0,0,,Не... Бұл жай ғана жалған.
Dialogue: 0,0:03:55.02,0:03:56.11,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:03:57.19,0:03:58.36,Default,,0,0,0,,(қозғалтқыштың іске қосу дыбысы)
Dialogue: 0,0:04:01.69,0:04:04.11,Default,,0,0,0,,-Кеничи... -Бітті!
Dialogue: 0,0:04:04.20,0:04:05.62,Default,,0,0,0,,Гааа!
Dialogue: 0,0:04:05.70,0:04:06.87,Default,,0,0,0,,кенеттен?
Dialogue: 0,0:04:08.83,0:04:10.75,Default,,0,0,0,,Қорғау Қорғау Қорғау…
Dialogue: 0,0:04:11.58,0:04:12.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:16.33,0:04:18.42,Default,,0,0,0,,Эй, жақсысың ба...
Dialogue: 0,0:04:18.50,0:04:19.75,Default,,0,0,0,,Ха-ха-ха-ха…
Dialogue: 0,0:04:19.84,0:04:22.92,Default,,0,0,0,,Өйткені олар екінші дәрежелі сиқыршыларды әкеледі.
Dialogue: 0,0:04:19.84,0:04:22.92,Default,,0,0,0,,(Асылдардың күлкісі)
Dialogue: 0,0:04:22.92,0:04:23.01,Default,,0,0,0,,(Асылдардың күлкісі)
Dialogue: 0,0:04:23.01,0:04:24.43,Default,,0,0,0,,(Асылдардың күлкісі)
Dialogue: 0,0:04:23.01,0:04:24.43,Default,,0,0,0,,Орынсыз
Dialogue: 0,0:04:24.51,0:04:26.64,Default,,0,0,0,,Бірақ ол өшіп қалды.
Dialogue: 0,0:04:26.72,0:04:30.22,Default,,0,0,0,,Сол шақырылған аңның түсі қандай?
Dialogue: 0,0:04:30.31,0:04:33.27,Default,,0,0,0,,Қызық, қанша оқ тиеді?
Dialogue: 0,0:04:33.35,0:04:34.64,Default,,0,0,0,,Бұл не деген жігіттер...
Dialogue: 0,0:04:34.73,0:04:37.81,Default,,0,0,0,,Күйеу, біз тартамыз
Dialogue: 0,0:04:37.90,0:04:39.15,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:04:40.23,0:04:42.40,Default,,0,0,0,,Hmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm...
Dialogue: 0,0:04:43.49,0:04:44.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:44.95,0:04:46.41,Default,,0,0,0,,Әлем үшін, өзгелер үшін—
Dialogue: 0,0:04:47.57,0:04:49.16,Default,,0,0,0,,(қоңырау)
Dialogue: 0,0:04:52.45,0:04:53.29,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:04:53.37,0:04:54.66,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:57.38,0:04:59.63,Default,,0,0,0,,Шіркін, мен шеше алмаймын!
Dialogue: 0,0:04:59.71,0:05:01.80,Default,,0,0,0,,-Маған қалдырыңыз! -Эй
Dialogue: 0,0:05:01.88,0:05:04.13,Default,,0,0,0,,Қуыс басқа әлемге апарады
Dialogue: 0,0:05:04.22,0:05:05.84,Default,,0,0,0,,Терең байланысты
Dialogue: 0,0:05:05.93,0:05:10.31,Default,,0,0,0,,Жоғалып бара жатқан жандардан қуат бер
Dialogue: 0,0:05:10.39,0:05:12.43,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:05:16.31,0:05:17.44,Default,,0,0,0,,(Зеппели) Мен… э-э, жоқ. (Спидвагон) Ааах…
Dialogue: 0,0:05:20.27,0:05:23.94,Default,,0,0,0,,Қат! Өрмекшілерге қарағанда сиқыр тиімдірек емес пе? Ах...
Dialogue: 0,0:05:27.78,0:05:29.20,Default,,0,0,0,,Қарғыс атсын... қарғыс атсын бақылау!
Dialogue: 0,0:05:29.20,0:05:30.24,Default,,0,0,0,,Қарғыс атсын... қарғыс атсын бақылау!
Dialogue: 0,0:05:29.20,0:05:30.24,Default,,0,0,0,,Жарықтың қиыршық тастары, барлық заттардың көзі
Dialogue: 0,0:05:30.24,0:05:31.62,Default,,0,0,0,,Жарықтың қиыршық тастары, барлық заттардың көзі
Dialogue: 0,0:05:31.70,0:05:34.37,Default,,0,0,0,,Қоңырауыма бірдей дәрежемен жауап бер
Dialogue: 0,0:05:34.45,0:05:36.96,Default,,0,0,0,,Жаулық күшіне қалқан бол.
Dialogue: 0,0:05:37.04,0:05:38.21,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:05:38.79,0:05:40.21,Default,,0,0,0,,Жоғары қорғаныс!
Dialogue: 0,0:05:46.01,0:05:48.72,Default,,0,0,0,,Бұл жоғары қорғаныс емес
Dialogue: 0,0:05:51.80,0:05:54.18,Default,,0,0,0,,(қоңырау соғуы)
Dialogue: 0,0:05:54.27,0:05:55.43,Default,,0,0,0,,(Кіші айдаһардың айқайы)
Dialogue: 0,0:05:55.52,0:05:57.06,Default,,0,0,0,,Бұл менің көзіме қатты тиді.
Dialogue: 0,0:05:57.14,0:05:57.98,Default,,0,0,0,,Болды ма?
Dialogue: 0,0:05:58.06,0:05:59.90,Default,,0,0,0,,Гуруру…
Dialogue: 0,0:06:06.32,0:06:07.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:10.32,0:06:12.74,Default,,0,0,0,,Гуоо!
Dialogue: 0,0:06:12.83,0:06:13.99,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:06:20.58,0:06:23.17,Default,,0,0,0,,Тек оны ұсақтаңыз!
Dialogue: 0,0:06:23.25,0:06:25.59,Default,,0,0,0,,Менің ойымша, бұл мәселені шешеді.
Dialogue: 0,0:06:25.67,0:06:28.93,Default,,0,0,0,,Мен олардың өртенгенін көргім келеді.
Dialogue: 0,0:06:29.01,0:06:29.84,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:06:29.93,0:06:32.51,Default,,0,0,0,,Орман мысықтарын өртеу ысырап емес пе?
Dialogue: 0,0:06:33.14,0:06:35.72,Default,,0,0,0,,Барлық нәрсеге байланысты ұлы
Dialogue: 0,0:06:35.81,0:06:36.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:39.23,0:06:40.90,Default,,0,0,0,,Мен бұған сенбеймін...
Dialogue: 0,0:06:40.98,0:06:45.65,Default,,0,0,0,,Мына тасқа бір сәт өмір сыйла.
Dialogue: 0,0:06:46.36,0:06:47.40,Default,,0,0,0,,Голем өзегі?
Dialogue: 0,0:06:47.49,0:06:48.40,Default,,0,0,0,,О...
Dialogue: 0,0:06:48.49,0:06:52.32,Default,,0,0,0,,Осындай озық сиқыр, қарапайым бала ма?
Dialogue: 0,0:06:52.41,0:06:53.91,Default,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:06:56.24,0:06:58.16,Default,,0,0,0,,(Дворяндардың таңданыс дыбыстары)
Dialogue: 0,0:06:58.87,0:07:00.29,Default,,0,0,0,,Қол?
Dialogue: 0,0:07:00.37,0:07:02.04,Default,,0,0,0,,(Асылдардың күлкісі)
Dialogue: 0,0:07:02.04,0:07:04.50,Default,,0,0,0,,(Асылдардың күлкісі)
Dialogue: 0,0:07:02.04,0:07:04.50,Default,,0,0,0,,Таңданып, адасып қалмады ма?
Dialogue: 0,0:07:04.59,0:07:06.80,Default,,0,0,0,,Қарапайым адам.
Dialogue: 0,0:07:08.13,0:07:09.80,Default,,0,0,0,,(Асылдардың таңданған дыбыстары)
Dialogue: 0,0:07:13.39,0:07:14.80,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:07:16.31,0:07:17.89,Default,,0,0,0,,Ол әлі толық емес пе еді?
Dialogue: 0,0:07:17.97,0:07:18.81,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:07:19.89,0:07:22.31,Default,,0,0,0,,Бұл жеткілікті!
Dialogue: 0,0:07:22.40,0:07:24.06,Default,,0,0,0,,Өте қауіпті!
Dialogue: 0,0:07:24.15,0:07:26.07,Default,,0,0,0,,Оматсу гиганты айналуы
Dialogue: 0,0:07:26.65,0:07:29.57,Default,,0,0,0,,Бұл дүниенің қара бұлттарын ұшырды
Dialogue: 0,0:07:29.65,0:07:31.07,Default,,0,0,0,,Сары құйын!
Dialogue: 0,0:07:31.15,0:07:32.57,Default,,0,0,0,,Қарсылас міндетті түрде өледі
Dialogue: 0,0:07:32.66,0:07:35.58,Default,,0,0,0,,Толық өлімге әкелетін Omatsu Crush!
Dialogue: 0,0:07:35.66,0:07:39.58,Default,,0,0,0,,Бұл абсурдқа қарсы ашудың соққысы.
Dialogue: 0,0:07:40.66,0:07:43.17,Default,,0,0,0,,Қарсылас толығымен өледі!
Dialogue: 0,0:07:40.66,0:07:43.17,Default,,0,0,0,,(Дворяндардың шуы)
Dialogue: 0,0:07:43.17,0:07:45.38,Default,,0,0,0,,(Дворяндардың шуы)
Dialogue: 0,0:07:45.46,0:07:46.63,Default,,0,0,0,,Сақтау
Dialogue: 0,0:07:46.71,0:07:48.05,Default,,0,0,0,,Мен жеңдім!
Dialogue: 0,0:07:48.13,0:07:49.88,Default,,0,0,0,,Біз кереметпіз!
Dialogue: 0,0:07:49.96,0:07:51.51,Default,,0,0,0,,Myooo
Dialogue: 0,0:07:51.59,0:07:52.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:52.93,0:07:55.89,Default,,0,0,0,,Рахмет саған Анемона
Dialogue: 0,0:07:55.97,0:07:57.85,Default,,0,0,0,,-Иә... -Аа...
Dialogue: 0,0:07:57.93,0:07:59.60,Default,,0,0,0,,Ах... Қарғыс атсын!
Dialogue: 0,0:08:00.39,0:08:03.98,Default,,0,0,0,,А-а, мен микрофонды сынап жатырмын.
Dialogue: 0,0:08:04.06,0:08:07.02,Default,,0,0,0,,Бүгін күн ашық. Бүгін күн ашық
Dialogue: 0,0:08:07.11,0:08:09.98,Default,,0,0,0,,Аменбо Акайна Айуэо...
Dialogue: 0,0:08:10.07,0:08:10.99,Default,,0,0,0,,(Кеничидің Секибарасы)
Dialogue: 0,0:08:11.07,0:08:13.53,Default,,0,0,0,,Иә, Мәртебелі Король.
Dialogue: 0,0:08:13.61,0:08:17.28,Default,,0,0,0,,Керемет және мұқият қонақжайлылық үшін рахмет.
Dialogue: 0,0:08:17.37,0:08:19.91,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:08:19.99,0:08:22.37,Default,,0,0,0,,Менің отбасыма қауіп төндіргеніңіз үшін рахмет.
Dialogue: 0,0:08:22.46,0:08:24.67,Default,,0,0,0,,Мен мұны ашудан айттым.
Dialogue: 0,0:08:24.75,0:08:26.67,Default,,0,0,0,,Менің шақырған аңымның күшімен
Dialogue: 0,0:08:26.75,0:08:30.17,Default,,0,0,0,,Мен мына тақ бөлмесін қиратамын.
Dialogue: 0,0:08:30.25,0:08:33.67,Default,,0,0,0,,Сонымен қатар, біз бұл жерден сәтті қашып кеткенде,
Dialogue: 0,0:08:33.76,0:08:35.47,Default,,0,0,0,,Бар біліміммен
Dialogue: 0,0:08:35.55,0:08:38.55,Default,,0,0,0,,Еңкейіп, мына елді қараңыз!
Dialogue: 0,0:08:40.60,0:08:42.52,Default,,0,0,0,,Осы елді еңкейтсең ше?
Dialogue: 0,0:08:42.60,0:08:45.27,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:08:45.35,0:08:49.90,Default,,0,0,0,,Мен бір кіші айдаһарды жеңіп, мақтандым.
Dialogue: 0,0:08:53.07,0:08:53.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:53.99,0:08:56.03,Default,,0,0,0,,Бар біліміммен
Dialogue: 0,0:08:56.11,0:08:59.03,Default,,0,0,0,,Еңкейіп, мына елді қараңыз!
Dialogue: 0,0:08:59.62,0:09:01.16,Default,,0,0,0,,Кеничи
Dialogue: 0,0:09:03.00,0:09:04.21,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:09:04.29,0:09:07.42,Default,,0,0,0,,Мен ашуланып, бірдеңе дедім.
Dialogue: 0,0:09:08.46,0:09:10.38,Default,,0,0,0,,Корольдік сыйақы күтіп тұр.
Dialogue: 0,0:09:10.46,0:09:12.88,Default,,0,0,0,,Мен қандай қауіп барын білмеймін
Dialogue: 0,0:09:13.38,0:09:15.17,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:09:15.26,0:09:18.97,Default,,0,0,0,,Бәріне қауіп төндіретін менмін ғой.
Dialogue: 0,0:09:19.05,0:09:21.97,Default,,0,0,0,,Мен Кеничи айттым
Dialogue: 0,0:09:22.06,0:09:25.23,Default,,0,0,0,,Жақсы, Кеничи қалағанын істе.
Dialogue: 0,0:09:25.31,0:09:27.31,Default,,0,0,0,,Қайда барсаң да мен саған еремін
Dialogue: 0,0:09:27.40,0:09:29.19,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін
Dialogue: 0,0:09:29.27,0:09:32.73,Default,,0,0,0,,Күшті жігіттерге тартылу хайуандардың табиғаты.
Dialogue: 0,0:09:32.82,0:09:35.11,Default,,0,0,0,,Менің мұрнымнан қашып құтыла алмайсың.
Dialogue: 0,0:09:35.19,0:09:36.20,Default,,0,0,0,,Мя~
Dialogue: 0,0:09:36.28,0:09:38.45,Default,,0,0,0,,Мен мәңгі бірге боламыз дедім.
Dialogue: 0,0:09:38.53,0:09:40.45,Default,,0,0,0,,Мен әлі шытырман оқиғаға барған жоқпын!
Dialogue: 0,0:09:40.53,0:09:43.20,Default,,0,0,0,,Бұлай айтқаныңызға ризамын.
Dialogue: 0,0:09:43.29,0:09:47.62,Default,,0,0,0,,Шынымен қашсаң, бейбіт өмірге қайта алмайсың.
Dialogue: 0,0:09:47.71,0:09:50.63,Default,,0,0,0,,Менің айналамдағы адамдарға, тіпті мистер Мурроуға да.
Dialogue: 0,0:09:50.71,0:09:53.09,Default,,0,0,0,,Қандай қиындық тудырады?
Dialogue: 0,0:09:53.17,0:09:54.67,Default,,0,0,0,,Хехе...
Dialogue: 0,0:09:54.76,0:09:57.97,Default,,0,0,0,,Әкем екеуміз... жоқ, Marrow & Co.
Dialogue: 0,0:09:58.05,0:10:02.10,Default,,0,0,0,,Қандай жағдай болса да, мен сені кінәламаймын.
Dialogue: 0,0:10:05.02,0:10:06.48,Default,,0,0,0,,Күтіңіз.
Dialogue: 0,0:10:07.98,0:10:10.19,Default,,0,0,0,,Мен сіздің ойыңызды түсінемін.
Dialogue: 0,0:10:10.27,0:10:11.94,Default,,0,0,0,,Қанша патша болсаң да,
Dialogue: 0,0:10:12.02,0:10:17.28,Default,,0,0,0,,Адамдарды жай ғана көңіл көтеру үшін тамаша ретінде пайдалануға ешқандай себеп жоқ, солай ма?
Dialogue: 0,0:10:18.99,0:10:22.07,Default,,0,0,0,,Менің сүйікті отбасыма қауіп төнді.
Dialogue: 0,0:10:22.16,0:10:24.37,Default,,0,0,0,,Сіздің ашуланғаныңыз таңқаларлық емес.
Dialogue: 0,0:10:24.45,0:10:27.75,Default,,0,0,0,,Мен бұл жерден қашып кетсем де
Dialogue: 0,0:10:27.83,0:10:30.67,Default,,0,0,0,,Бейбіт өмір енді мүмкін емес.
Dialogue: 0,0:10:30.75,0:10:33.25,Default,,0,0,0,,Асылдардың кектері де саған қарсы.
Dialogue: 0,0:10:33.34,0:10:34.75,Default,,0,0,0,,Ал ше?
Dialogue: 0,0:10:34.84,0:10:37.67,Default,,0,0,0,,Бұл жағдайды реттеудің жақсы жолы бар.
Dialogue: 0,0:10:37.76,0:10:38.97,Default,,0,0,0,,Манука?
Dialogue: 0,0:10:39.55,0:10:41.30,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:41.39,0:10:42.43,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:42.51,0:10:46.68,Default,,0,0,0,,Сиқыршы Кеничи, менікі бол!
Dialogue: 0,0:10:46.77,0:10:48.14,Default,,0,0,0,,Сіздің сұрауыңызды қабылдамаймыз.
Dialogue: 0,0:10:49.44,0:10:51.10,Default,,0,0,0,,Қазір сатып аласың ба?
Dialogue: 0,0:10:51.19,0:10:54.15,Default,,0,0,0,,Мүмкін сіз бұл туралы көбірек ойлануыңыз керек немесе шатасып кетуіңіз керек пе?
Dialogue: 0,0:10:55.52,0:10:57.11,Default,,0,0,0,,Кім роялтидің ойыншығы болады?
Dialogue: 0,0:10:57.19,0:10:58.94,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:10:59.03,0:11:00.53,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:11:00.61,0:11:03.41,Default,,0,0,0,,Жас қыз боп шағын тілек
Dialogue: 0,0:11:03.49,0:11:05.95,Default,,0,0,0,,Бір нәрсені сұраңыз
Dialogue: 0,0:11:06.04,0:11:07.16,Default,,0,0,0,,Қалайсыз ба?
Dialogue: 0,0:11:07.24,0:11:10.21,Default,,0,0,0,,Жақында Вараваның туған күнінде
Dialogue: 0,0:11:10.29,0:11:13.38,Default,,0,0,0,,Сен маған сыйлық бердің
Dialogue: 0,0:11:13.46,0:11:16.21,Default,,0,0,0,,Ал ше? Сыйлығыңызға байланысты
Dialogue: 0,0:11:16.30,0:11:19.17,Default,,0,0,0,,Мен әкемнен бұл жағдайды реттеуді сұраймын.
Dialogue: 0,0:11:19.26,0:11:22.43,Default,,0,0,0,,Артында ренішсіз көңіл айту хаты
Dialogue: 0,0:11:22.51,0:11:23.93,Default,,0,0,0,,Сіз оны ала аласыз және жасай аласыз.
Dialogue: 0,0:11:24.01,0:11:25.68,Default,,0,0,0,,Сабыр сақта… Тек сабыр сақтасаң болғаны!
Dialogue: 0,0:11:26.85,0:11:28.14,Default,,0,0,0,,Ол айтады
Dialogue: 0,0:11:28.22,0:11:30.73,Default,,0,0,0,,Басқа роялти мен ақсүйектер қолы тимейтін нәрсе.
Dialogue: 0,0:11:30.81,0:11:34.06,Default,,0,0,0,,Мен нақты бірдеңені қалаймын.
Dialogue: 0,0:11:34.15,0:11:39.61,Default,,0,0,0,,Бірақ зергерлік бұйымдарыма таң қала алмаймын.
Dialogue: 0,0:11:39.69,0:11:41.07,Default,,0,0,0,,Егер сізге...
Dialogue: 0,0:11:41.15,0:11:44.16,Default,,0,0,0,,Зергерлік бұйымдармен бәсекелескіңіз келмейді ме?
Dialogue: 0,0:11:44.24,0:11:45.95,Default,,0,0,0,,А, бірақ...
Dialogue: 0,0:11:46.03,0:11:47.58,Default,,0,0,0,,-Кеничи -Хмм?
Dialogue: 0,0:11:47.66,0:11:52.25,Default,,0,0,0,,Кеничи өнімдерінің тамашалығы жоғары технологияға байланысты.
Dialogue: 0,0:11:52.33,0:11:55.46,Default,,0,0,0,,Сонымен қатар, әлгі киім-кешек пен балта сияқты.
Dialogue: 0,0:11:55.54,0:11:59.84,Default,,0,0,0,,Мен олардың саны көп болса да, пішіндері бірдей болғанына таң қалдым.
Dialogue: 0,0:11:59.92,0:12:03.47,Default,,0,0,0,,Мұндай сыйлықты қарастырған дұрыс па?
Dialogue: 0,0:12:03.55,0:12:04.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:05.22,0:12:06.72,Default,,0,0,0,,және осы адаммен шайқасуға рұқсат етті—
Dialogue: 0,0:12:06.80,0:12:08.89,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:12:08.97,0:12:10.39,Default,,0,0,0,,Бұл інжу-маржан деп аталады...
Dialogue: 0,0:12:10.47,0:12:12.73,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:12:12.81,0:12:15.98,Default,,0,0,0,,Ал інжу-маржан ше? Мұндай үлкен бөлшек
Dialogue: 0,0:12:16.06,0:12:18.98,Default,,0,0,0,,Бір түсті моншақтары бар алқалар және т.б.
Dialogue: 0,0:12:19.07,0:12:21.99,Default,,0,0,0,,Бұл дүниелік емес.
Dialogue: 0,0:12:22.07,0:12:24.16,Default,,0,0,0,,Ол болмауы керек
Dialogue: 0,0:12:31.58,0:12:33.58,Default,,0,0,0,,Қараңызшы, егер сізде бұл бар болса.
Dialogue: 0,0:12:33.66,0:12:35.00,Default,,0,0,0,,Бұл дүниенің игілігі
Dialogue: 0,0:12:35.08,0:12:37.92,Default,,0,0,0,,Хаха, ризамын және бақыттымын
Dialogue: 0,0:12:38.00,0:12:40.96,Default,,0,0,0,,Мен өзімді түсініксіз сезінемін,
Dialogue: 0,0:12:41.05,0:12:44.30,Default,,0,0,0,,Шешім бұл болса, мұны істеу керек пе...
Dialogue: 0,0:12:44.38,0:12:46.34,Default,,0,0,0,,Бірақ соңында бұл
Dialogue: 0,0:12:46.43,0:12:49.64,Default,,0,0,0,,Мүмкін бұл менің қалағаным шығар.
Dialogue: 0,0:12:49.72,0:12:50.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:51.47,0:12:54.39,Default,,0,0,0,,Жоқ~ Өте қорқынышты~
Dialogue: 0,0:12:54.48,0:12:55.56,Default,,0,0,0,,Кішіден ертерек
Dialogue: 0,0:12:55.64,0:12:57.15,Default,,0,0,0,,Бұл қауіптірек емес пе?
Dialogue: 0,0:12:57.23,0:12:59.02,Default,,0,0,0,,Менің атым Кеничи.
Dialogue: 0,0:12:59.11,0:13:01.53,Default,,0,0,0,,Хаха, мен не істеуім керек?
Dialogue: 0,0:13:01.61,0:13:03.19,Default,,0,0,0,,Саған, қызым...
Dialogue: 0,0:13:03.28,0:13:05.82,Default,,0,0,0,,Мен саған осындай алқа сыйлағанымда,
Dialogue: 0,0:13:05.91,0:13:07.53,Default,,0,0,0,,Саман емес пе?
Dialogue: 0,0:13:07.62,0:13:08.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:08.70,0:13:10.62,Default,,0,0,0,,Бірақ бұл Лилит-сама...
Dialogue: 0,0:13:10.70,0:13:12.70,Default,,0,0,0,,Бұл менің туған күніме сыйлық болды.
Dialogue: 0,0:13:12.79,0:13:14.79,Default,,0,0,0,,Жақында менің де туған күнім келеді
Dialogue: 0,0:13:15.41,0:13:16.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:16.67,0:13:19.34,Default,,0,0,0,,Жақында менің де туған күнім келеді
Dialogue: 0,0:13:19.42,0:13:20.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:20.38,0:13:24.67,Default,,0,0,0,,Менің анам қиын адам, ашуланғанда қиналады.
Dialogue: 0,0:13:25.59,0:13:27.38,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:13:27.47,0:13:29.55,Default,,0,0,0,,Әрине, патшайымға да сыйлық.
Dialogue: 0,0:13:29.64,0:13:32.06,Default,,0,0,0,,Біз оны сізге дайындадық.
Dialogue: 0,0:13:32.14,0:13:33.14,Default,,0,0,0,,(Дворяндардың шуы)
Dialogue: 0,0:13:33.14,0:13:36.10,Default,,0,0,0,,(Дворян) Мынау алып маржан қанша тұрады?
Dialogue: 0,0:13:36.19,0:13:38.44,Default,,0,0,0,,Әйелім менен осындай нәрсе сұраса ше?
Dialogue: 0,0:13:38.52,0:13:40.23,Default,,0,0,0,,Аумағы еңкейеді
Dialogue: 0,0:13:40.31,0:13:43.19,Default,,0,0,0,,Ханшайым, бұл саған өте жарасады.
Dialogue: 0,0:13:43.28,0:13:44.90,Default,,0,0,0,,Хохохохо…
Dialogue: 0,0:13:44.99,0:13:47.45,Default,,0,0,0,,Дәл сіз айтқандай.
Dialogue: 0,0:13:47.53,0:13:51.49,Default,,0,0,0,,Бірақ бұл заттардың барлығы бізге тегін берілген сияқты емес.
Dialogue: 0,0:13:53.62,0:13:54.62,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:54.70,0:13:56.96,Default,,0,0,0,,Бұл Вараваның жатын бөлмесінің кілті.
Dialogue: 0,0:13:57.04,0:13:57.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:58.04,0:14:00.84,Default,,0,0,0,,Сіздің әлсіз денеңізге көңіліңіз толмай ма?
Dialogue: 0,0:14:00.92,0:14:02.92,Default,,0,0,0,,Канан да солай болды.
Dialogue: 0,0:14:03.00,0:14:04.80,Default,,0,0,0,,Бұл дүниенің патшалары мен ақсүйектері
Dialogue: 0,0:14:04.88,0:14:09.43,Default,,0,0,0,,Ақшаға сатып ала алмайтын нәрсе сіздің денеңізге тең деп ойлайсыз ба?
Dialogue: 0,0:14:09.51,0:14:12.18,Default,,0,0,0,,Ах, бірақ патшаның алдында...
Dialogue: 0,0:14:12.93,0:14:13.43,Default,,0,0,0,,Пуи
Dialogue: 0,0:14:13.43,0:14:14.35,Default,,0,0,0,,Пуи
Dialogue: 0,0:14:13.43,0:14:14.35,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:14:14.43,0:14:15.35,Default,,0,0,0,,Екінші бомба!
Dialogue: 0,0:14:15.43,0:14:17.52,Default,,0,0,0,,Неліктен қалыпты жағдайда ойнамасқа?
Dialogue: 0,0:14:17.60,0:14:20.86,Default,,0,0,0,,Бұл Лилит патшайым айтқандай ма?
Dialogue: 0,0:14:20.94,0:14:22.11,Default,,0,0,0,,​​Олай болса!
Dialogue: 0,0:14:22.19,0:14:24.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:24.15,0:14:25.82,Default,,0,0,0,,Лилитке атымен қоңырау шалыңыз
Dialogue: 0,0:14:25.90,0:14:27.90,Default,,0,0,0,,Неліктен Варава «ханшайым» болып табылады?
Dialogue: 0,0:14:27.99,0:14:28.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:30.07,0:14:33.62,Default,,0,0,0,,Бүгін мен ханшайыммен бірінші рет кездесіп тұрмын...
Dialogue: 0,0:14:34.49,0:14:37.04,Default,,0,0,0,,Сонда... мен сені қалай шақырайын?
Dialogue: 0,0:14:37.12,0:14:39.87,Default,,0,0,0,,Бұл амарант. «Амала» жақсы.
Dialogue: 0,0:14:39.96,0:14:41.71,Default,,0,0,0,,Олай болса, Амара.
Dialogue: 0,0:14:41.79,0:14:45.38,Default,,0,0,0,,Патша сарайында пайдаланылмайтын ескі жиһаз бар ма?
Dialogue: 0,0:14:45.46,0:14:49.05,Default,,0,0,0,,Ескі жиһаз? Мен солай ойлаймын, бірақ не болды?
Dialogue: 0,0:14:49.13,0:14:52.26,Default,,0,0,0,,Маған осы кілттің орнына соны берсеңіз.
Dialogue: 0,0:14:52.34,0:14:53.64,Default,,0,0,0,,Хмм…
Dialogue: 0,0:14:53.72,0:14:54.89,Default,,0,0,0,,Не...
Dialogue: 0,0:14:58.02,0:14:59.39,Default,,0,0,0,,О~
Dialogue: 0,0:15:01.10,0:15:02.27,Default,,0,0,0,,Хё~
Dialogue: 0,0:15:02.86,0:15:03.90,Default,,0,0,0,,Дохья!
Dialogue: 0,0:15:03.98,0:15:05.40,Default,,0,0,0,,Қайда?
Dialogue: 0,0:15:06.40,0:15:09.53,Default,,0,0,0,,Кеничи, мынаны да ал.
Dialogue: 0,0:15:09.61,0:15:10.78,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:15:10.86,0:15:13.91,Default,,0,0,0,,Бұл менің кішкентай кезімде пайдаланған парта.
Dialogue: 0,0:15:13.99,0:15:15.91,Default,,0,0,0,,Бұған қарап
Dialogue: 0,0:15:15.99,0:15:19.71,Default,,0,0,0,,Сол тозақ күндер қайта тірілгендей болады.
Dialogue: 0,0:15:20.75,0:15:22.25,Default,,0,0,0,,Сақтау
Dialogue: 0,0:15:22.33,0:15:24.84,Default,,0,0,0,,Хохо, бұл оңай емес.
Dialogue: 0,0:15:24.92,0:15:26.59,Default,,0,0,0,,Кеничи Ноу
Dialogue: 0,0:15:26.67,0:15:29.13,Default,,0,0,0,,Мен сені өзіммен бірге алып кетейін бе?
Dialogue: 0,0:15:29.21,0:15:30.63,Default,,0,0,0,,Анашым!
Dialogue: 0,0:15:30.72,0:15:32.55,Default,,0,0,0,,Хохохохо…
Dialogue: 0,0:15:32.64,0:15:35.72,Default,,0,0,0,,Күтілгендей, оны нағыз роялти пайдаланды.
Dialogue: 0,0:15:35.80,0:15:37.64,Default,,0,0,0,,Шынайы антиквариат
Dialogue: 0,0:15:37.72,0:15:41.81,Default,,0,0,0,,Бастапқы әлемде бұл мұражай сапасы болар еді...
Dialogue: 0,0:15:43.90,0:15:45.44,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:45.98,0:15:46.82,Default,,0,0,0,,О...
Dialogue: 0,0:15:47.48,0:15:50.36,Default,,0,0,0,,Сізге рахмет, мен жақсы ұйықтап жатырмын.
Dialogue: 0,0:15:50.44,0:15:52.61,Default,,0,0,0,,Сол үшін көп рахмет.
Dialogue: 0,0:15:52.70,0:15:56.83,Default,,0,0,0,,А, онда бұл ваза себепкер екені сөзсіз.
Dialogue: 0,0:15:56.91,0:16:00.25,Default,,0,0,0,,Осыны берген асылдан жауап алғанымда,
Dialogue: 0,0:16:00.33,0:16:05.21,Default,,0,0,0,,Қарғыс екенін біле тұра бергенін мойындады.
Dialogue: 0,0:16:05.29,0:16:07.84,Default,,0,0,0,,Қарғыс? Қандай мақсатпен?
Dialogue: 0,0:16:07.92,0:16:10.76,Default,,0,0,0,,Әрине, бұл сабан адамды өлтіру.
Dialogue: 0,0:16:10.84,0:16:13.05,Default,,0,0,0,,Осыны жіберген...
Dialogue: 0,0:16:13.13,0:16:16.35,Default,,0,0,0,,Дұрыс, кіші айдаһардың тынысына шомылды.
Dialogue: 0,0:16:16.43,0:16:18.26,Default,,0,0,0,,Өлген адамдар болды, солай ма?
Dialogue: 0,0:16:18.35,0:16:20.06,Default,,0,0,0,,Мүмкін ол сонда болған шығар.
Dialogue: 0,0:16:20.14,0:16:20.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:21.06,0:16:24.06,Default,,0,0,0,,Ол өзіне қастандық жасаған адамды ешқашан күтпеген.
Dialogue: 0,0:16:24.14,0:16:26.11,Default,,0,0,0,,Сіз оны сонда тастадыңыз ба?
Dialogue: 0,0:16:26.19,0:16:27.98,Default,,0,0,0,,Тыныс сол жерде болғандарды өлтіреді.
Dialogue: 0,0:16:28.07,0:16:31.61,Default,,0,0,0,,Оны өртеп жіберу жай ғана кездейсоқтық еді.
Dialogue: 0,0:16:31.69,0:16:32.53,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:16:32.61,0:16:34.49,Default,,0,0,0,,Сонымен... дұрыс...
Dialogue: 0,0:16:34.57,0:16:37.74,Default,,0,0,0,,Ол адамдар патшаға қарсы дворяндар.
Dialogue: 0,0:16:37.83,0:16:39.49,Default,,0,0,0,,Корольдікке қарсы фракция…
Dialogue: 0,0:16:39.58,0:16:43.00,Default,,0,0,0,,Менің патша әулетінің билігіне қарсы шыққандар.
Dialogue: 0,0:16:43.08,0:16:45.83,Default,,0,0,0,,Соңғы кезде Ахимен мырзасы Тунбергия, т.б.
Dialogue: 0,0:16:45.92,0:16:48.25,Default,,0,0,0,,Трендтер алаңдатты.
Dialogue: 0,0:16:48.34,0:16:49.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:49.25,0:16:50.50,Default,,0,0,0,,Тунбергия…
Dialogue: 0,0:16:52.46,0:16:54.93,Default,,0,0,0,,Корольдікке қарсы фракцияның төменгі жағында.
Dialogue: 0,0:16:55.01,0:16:57.59,Default,,0,0,0,,Көршілес Астрантия аумағын басып алуға әрекеттену.
Dialogue: 0,0:16:57.68,0:17:00.31,Default,,0,0,0,,Оның жоспары көп болған сияқты.
Dialogue: 0,0:17:00.39,0:17:03.14,Default,,0,0,0,,Бәлкім, ломбард сатушы жіберер.
Dialogue: 0,0:17:04.27,0:17:06.65,Default,,0,0,0,,Саудагер... Әйтеуір Согарам
Dialogue: 0,0:17:08.36,0:17:09.65,Default,,0,0,0,,Корольдікке қарсылар
Dialogue: 0,0:17:09.73,0:17:14.70,Default,,0,0,0,,Қаскөйлер мен ұрылардың көбі жүгіруші иттер ретінде ұсталды.
Dialogue: 0,0:17:14.78,0:17:16.66,Default,,0,0,0,,Тек Астрантия ғана емес
Dialogue: 0,0:17:16.74,0:17:19.78,Default,,0,0,0,,Далия да жоспарға қосылуға тырысады.
Dialogue: 0,0:17:20.70,0:17:23.16,Default,,0,0,0,,А... А, сонда Шаға да, басқалары да?
Dialogue: 0,0:17:23.87,0:17:26.92,Default,,0,0,0,,Ол Далияның жанындағы ескі сарайда жасырынып жүрген қарақшы емес пе?
Dialogue: 0,0:17:27.00,0:17:28.92,Default,,0,0,0,,Сол кісіден құтылған сен едің.
Dialogue: 0,0:17:30.13,0:17:33.01,Default,,0,0,0,,А... білесің ғой.
Dialogue: 0,0:17:33.59,0:17:36.34,Default,,0,0,0,,Басқару деген нені білдіреді?
Dialogue: 0,0:17:36.43,0:17:39.14,Default,,0,0,0,,Жақсы хабардар болу
Dialogue: 0,0:17:39.22,0:17:43.14,Default,,0,0,0,,Бұл іс патшаға қарсы фракцияның кеңеюі туралы.
Dialogue: 0,0:17:43.22,0:17:45.64,Default,,0,0,0,,Уақытша болса да алдын алуға болатын.
Dialogue: 0,0:17:47.23,0:17:48.65,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:17:48.73,0:17:50.15,Default,,0,0,0,,H…
Dialogue: 0,0:17:50.23,0:17:54.28,Default,,0,0,0,,Сәлем~ Бұл адам өте қорқынышты~
Dialogue: 0,0:17:57.36,0:17:59.53,Default,,0,0,0,,Сәлем, қыз
Dialogue: 0,0:17:59.62,0:18:01.03,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:18:01.12,0:18:05.54,Default,,0,0,0,,Жоғары қорғаныс туралы қайдан білдіңіз?
Dialogue: 0,0:18:06.25,0:18:09.12,Default,,0,0,0,,А-а, сиқырлы кітапта...
Dialogue: 0,0:18:09.63,0:18:12.42,Default,,0,0,0,,Бұл Альмерия мырза деген адам екені айтылды.
Dialogue: 0,0:18:12.50,0:18:15.55,Default,,0,0,0,,Не? Күміс Альмерия?
Dialogue: 0,0:18:15.63,0:18:18.55,Default,,0,0,0,,Сіз Настуртиум мырзаны білесіз бе?
Dialogue: 0,0:18:18.63,0:18:21.09,Default,,0,0,0,,Бұл әйгілі...
Dialogue: 0,0:18:21.64,0:18:24.81,Default,,0,0,0,,А... Қыз, бұл анемон ба?
Dialogue: 0,0:18:24.89,0:18:26.31,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:18:26.39,0:18:28.14,Default,,0,0,0,,Анаң ше?
Dialogue: 0,0:18:28.23,0:18:30.94,Default,,0,0,0,,Өлгенім есімде жоқ
Dialogue: 0,0:18:31.02,0:18:34.44,Default,,0,0,0,,Дұрыс... Сиқырлы әріптер ше?
Dialogue: 0,0:18:34.53,0:18:36.40,Default,,0,0,0,,Әлі оқытылмаған
Dialogue: 0,0:18:37.40,0:18:40.07,Default,,0,0,0,,«Менің қызым Анемонға берілді»
Dialogue: 0,0:18:40.16,0:18:43.08,Default,,0,0,0,,«Егер сізде байланыс болса, сіз бір-біріңізбен кездесесіз».
Dialogue: 0,0:18:43.66,0:18:45.70,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:45.79,0:18:47.96,Default,,0,0,0,,Қадірлеңіз, естелік ретінде сақтаңыз
Dialogue: 0,0:18:48.04,0:18:49.87,Default,,0,0,0,,А... иә
Dialogue: 0,0:18:49.96,0:18:52.33,Default,,0,0,0,,Мүмкін тағы кездесерміз.
Dialogue: 0,0:18:52.42,0:18:54.88,Default,,0,0,0,,Өйткені, мен жеңілмеймін
Dialogue: 0,0:18:57.92,0:19:00.38,Default,,0,0,0,,Кейінірек қосымша сыйлық ретінде
Dialogue: 0,0:19:00.47,0:19:03.10,Default,,0,0,0,,Астильбе көлінің жағасынан алынған жер
Dialogue: 0,0:19:03.68,0:19:05.31,Default,,0,0,0,,Астильбе көлі дегеніміз не?
Dialogue: 0,0:19:05.39,0:19:08.60,Default,,0,0,0,,Менің үйімнің алдынан жайылып жатқан сол көл.
Dialogue: 0,0:19:08.68,0:19:13.11,Default,,0,0,0,,Қарым-қатынасты алу қарапайым адам болып қалуды білдірмейді.
Dialogue: 0,0:19:13.19,0:19:17.86,Default,,0,0,0,,Бірінші буын дворян ретінде оған барон атағы берілді.
Dialogue: 0,0:19:17.94,0:19:20.36,Default,,0,0,0,,Мен ақсүйектерге айналдым.
Dialogue: 0,0:19:22.16,0:19:25.12,Default,,0,0,0,,Сонымен біз үйге қарай бет алдық.
Dialogue: 0,0:19:25.83,0:19:29.29,Default,,0,0,0,,Мен неге жаңа фургон сатып алдым?
Dialogue: 0,0:19:29.37,0:19:33.21,Default,,0,0,0,,Өйткені Лилит-сама мен Милен-сан да бізбен бірге келе жатыр.
Dialogue: 0,0:19:33.71,0:19:36.55,Default,,0,0,0,,Лилит артымнан еруге тырысты, бірақ
Dialogue: 0,0:19:36.63,0:19:40.67,Default,,0,0,0,,Оған жаны ашитын патша оны кешіре алмас еді.
Dialogue: 0,0:19:41.72,0:19:43.22,Default,,0,0,0,,Маған рұқсат бермесеңіз
Dialogue: 0,0:19:43.30,0:19:45.97,Default,,0,0,0,,Мен патшалық мәртебемді алып тастаймын!
Dialogue: 0,0:19:46.05,0:19:49.39,Default,,0,0,0,,Ол өте қатыгездікпен қорқытқан сияқты.
Dialogue: 0,0:19:49.47,0:19:53.27,Default,,0,0,0,,Менің атым барон Кеничи Хамада.
Dialogue: 0,0:19:53.35,0:19:56.15,Default,,0,0,0,,Бұл бақылау болуы керек.
Dialogue: 0,0:19:56.23,0:19:58.90,Default,,0,0,0,,Кеничи сияқты ұлы сиқыршыға
Dialogue: 0,0:19:58.98,0:20:02.32,Default,,0,0,0,,Өйткені патшаға қарсы фракция бір жаққа ауысса, қиын болар еді.
Dialogue: 0,0:20:02.95,0:20:04.70,Default,,0,0,0,,Танысқаныма қуаныштымын, Анемон
Dialogue: 0,0:20:04.78,0:20:05.78,Default,,0,0,0,,Иә
Dialogue: 0,0:20:05.87,0:20:08.24,Default,,0,0,0,,Бірақ мен Кеничиді Лилитке бермеймін.
Dialogue: 0,0:20:08.33,0:20:09.16,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:09.24,0:20:12.33,Default,,0,0,0,,Әрине, Майлен сенімен бірге.
Dialogue: 0,0:20:12.41,0:20:15.38,Default,,0,0,0,,Мен саған бір құмарлықпен қарауды сезінемін.
Dialogue: 0,0:20:15.46,0:20:18.92,Default,,0,0,0,,Сол түнді есіне алды ма деп ойлаймын.
Dialogue: 0,0:20:20.01,0:20:21.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:23.01,0:20:26.18,Default,,0,0,0,,Не? Ал... құбыжық?
Dialogue: 0,0:20:26.26,0:20:28.18,Default,,0,0,0,,Фую-сан!
Dialogue: 0,0:20:30.27,0:20:32.56,Default,,0,0,0,,Кеничи-сан!
Dialogue: 0,0:20:33.56,0:20:35.31,Default,,0,0,0,,Қандай асыл адам!
Dialogue: 0,0:20:35.40,0:20:37.81,Default,,0,0,0,,А... Мен бұл үшін қатты өкінемін.
Dialogue: 0,0:20:37.90,0:20:40.36,Default,,0,0,0,,А, жоқ, бұрынғыдай...
Dialogue: 0,0:20:43.65,0:20:45.57,Default,,0,0,0,,Ол өсті.
Dialogue: 0,0:20:45.66,0:20:46.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:47.16,0:20:48.33,Default,,0,0,0,,Олай емес пе?
Dialogue: 0,0:20:50.16,0:20:51.83,Default,,0,0,0,,Менің сенімімді, махаббатымды арнаған барлығымды тартып алуға... тек бір рух қана, тағы қандай сұмдық!
Dialogue: 0,0:20:52.54,0:20:56.92,Default,,0,0,0,,Барлығы емес... бірақ менің отбасым.
Dialogue: 0,0:20:58.54,0:21:01.51,Default,,0,0,0,,(Люта ойнау)
Dialogue: 0,0:21:01.59,0:21:03.55,Default,,0,0,0,,Ол не үшін келді?
Dialogue: 0,0:21:03.55,0:21:05.38,Default,,0,0,0,,Ол не үшін келді?
Dialogue: 0,0:21:03.55,0:21:05.38,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:21:05.38,0:21:06.47,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:21:06.47,0:21:07.55,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:21:06.47,0:21:07.55,Default,,0,0,0,,Бұл жерде орындалды ма?
Dialogue: 0,0:21:07.55,0:21:09.47,Default,,0,0,0,,Бұл жерде орындалды ма?
Dialogue: 0,0:21:10.14,0:21:15.48,Default,,0,0,0,,Арман – қолға үйретуші, қара сиқырлы аңды айдайтын сиқыршы.
Dialogue: 0,0:21:17.60,0:21:19.23,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:21:20.61,0:21:22.23,Default,,0,0,0,,Қасиетті Рыцарь...
Dialogue: 0,0:21:29.32,0:21:34.87,Default,,0,0,0,,Біреу олардың ұқсайтынын айтты
Dialogue: 0,0:21:37.62,0:21:39.00,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:39.08,0:21:42.88,Default,,0,0,0,,Нағыз баяу өмір енді басталады!
Dialogue: 0,0:21:45.22,0:21:47.09,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:21:48.59,0:21:52.97,Default,,0,0,0,,♪～
Dialogue: 0,0:23:12.14,0:23:17.43,Default,,0,0,0,,～♪
Dialogue: 0,0:23:17.52,0:23:19.18,Default,,0,0,0,,(Примуланың сөйлейтін дауысы)
Dialogue: 0,0:23:19.27,0:23:21.31,Default,,0,0,0,,Бұл майо емес пе?
Dialogue: 0,0:23:21.40,0:23:22.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:22.77,0:23:26.19,Default,,0,0,0,,Айтпақшы, Император Сиқыршысы...
Dialogue: 0,0:23:26.27,0:23:30.07,Default,,0,0,0,,Қызық, мен ол жігітті майонезбен кездестіремін бе?
Dialogue: 0,0:23:31.03,0:23:34.20,Default,,0,0,0,,(Адамдар сөйлейді)
Dialogue: 0,0:23:36.91,0:23:38.95,Default,,0,0,0,,Сәлем, қош келдіңіз!
Dialogue: 0,0:23:40.45,0:23:46.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
