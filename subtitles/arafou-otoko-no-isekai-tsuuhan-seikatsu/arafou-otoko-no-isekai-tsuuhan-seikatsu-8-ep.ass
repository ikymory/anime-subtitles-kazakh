Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.13,0:00:09.30,Default,,0,0,0,,А...
Dialogue: 0,0:00:09.38,0:00:11.67,Default,,0,0,0,,От шары!
Dialogue: 0,0:00:15.51,0:00:16.55,Default,,0,0,0,,- (Примула Кеничи) Ах... - (Мяре) Ня...
Dialogue: 0,0:00:16.64,0:00:19.64,Default,,0,0,0,,Уау! Өрт сөндіргіш Өрт сөндіргіш!
Dialogue: 0,0:00:19.72,0:00:20.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:21.31,0:00:23.31,Default,,0,0,0,,А... Аа!
Dialogue: 0,0:00:23.39,0:00:26.81,Default,,0,0,0,,Хмм... мені көшіріп, мынаны пайдаланыңыз!
Dialogue: 0,0:00:26.90,0:00:28.06,Default,,0,0,0,,Тағы 500 рет!
Dialogue: 0,0:00:28.15,0:00:29.57,Default,,0,0,0,,Мияу мияу...
Dialogue: 0,0:00:29.65,0:00:33.32,Default,,0,0,0,,Фугия!
Dialogue: 0,0:00:36.91,0:00:39.28,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:39.37,0:00:41.70,Default,,0,0,0,,Эмма! Рэй!
Dialogue: 0,0:00:41.79,0:00:44.50,Default,,0,0,0,,О, керемет! Керемет анемон!
Dialogue: 0,0:00:44.58,0:00:45.79,Default,,0,0,0,,Сіз сиқырды пайдалана аласыз.
Dialogue: 0,0:00:45.87,0:00:46.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:48.88,0:00:49.71,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:00:49.79,0:00:50.96,Default,,0,0,0,,Анемон!
Dialogue: 0,0:00:51.55,0:00:52.84,Default,,0,0,0,,Ей, не болып жатыр?
Dialogue: 0,0:00:52.92,0:00:55.09,Default,,0,0,0,,-Кеничи төсекке кетеді -Ах
Dialogue: 0,0:00:55.80,0:00:59.22,Default,,0,0,0,,Бақытымызға орай, таңертең қызуы басылды.
Dialogue: 0,0:00:59.30,0:01:00.72,Default,,0,0,0,,Не?Бұл
Dialogue: 0,0:01:00.81,0:01:01.77,Default,,0,0,0,,Консервіленген шабдалы
Dialogue: 0,0:01:01.85,0:01:04.06,Default,,0,0,0,,Ауру кезінде және аурудан кейін, міне, осы.
Dialogue: 0,0:01:04.56,0:01:05.89,Default,,0,0,0,,Хмм…
Dialogue: 0,0:01:05.98,0:01:08.48,Default,,0,0,0,,Бұл өте тәтті және дәмді...
Dialogue: 0,0:01:08.56,0:01:11.19,Default,,0,0,0,,Ол байланыстырғышқа сәл ұқсас болуы мүмкін.
Dialogue: 0,0:01:11.27,0:01:13.99,Default,,0,0,0,,Қанттың көп мөлшері жұмсалмайды ма?
Dialogue: 0,0:01:14.07,0:01:15.99,Default,,0,0,0,,Иә, қант қосылған.
Dialogue: 0,0:01:16.07,0:01:18.99,Default,,0,0,0,,Сонда оны тек ақсүйектер ғана жей алады.
Dialogue: 0,0:01:19.07,0:01:22.49,Default,,0,0,0,,Дұрыс, қант – монополия...
Dialogue: 0,0:01:22.58,0:01:23.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:27.08,0:01:30.25,Default,,0,0,0,,Мен Кеничимен тағы да кездесе алдым.
Dialogue: 0,0:01:30.34,0:01:33.59,Default,,0,0,0,,Бірақ Кеничидің үйінде Майаре мен Анемондар бар.
Dialogue: 0,0:01:33.67,0:01:36.22,Default,,0,0,0,,Тіпті орман мысығы Белл де сонда болды.
Dialogue: 0,0:01:36.30,0:01:38.51,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:01:38.59,0:01:41.51,Default,,0,0,0,,Кеничиге жан мен тәнімді арнаймын.
Dialogue: 0,0:01:41.60,0:01:44.14,Default,,0,0,0,,Біз өмір бойы бірге өмір сүруге ант еттік.
Dialogue: 0,0:01:44.22,0:01:47.98,Default,,0,0,0,,Өмірімде бір өкінішім жоқ.
Dialogue: 0,0:01:48.56,0:01:52.44,Default,,0,0,0,,♪～
Dialogue: 0,0:03:11.90,0:03:16.48,Default,,0,0,0,,～♪
Dialogue: 0,0:03:18.65,0:03:21.53,Default,,0,0,0,,Анемон жақсарып келеді.
Dialogue: 0,0:03:21.61,0:03:23.16,Default,,0,0,0,,Бірнеше күннен кейін
Dialogue: 0,0:03:23.24,0:03:25.91,Default,,0,0,0,,Мен Мари цикорий безгегінен айыққан соң үйіме шақырдым.
Dialogue: 0,0:03:27.99,0:03:32.46,Default,,0,0,0,,Бұл барлығына аю етін көп мөлшерде жеуге тырысады.
Dialogue: 0,0:03:32.96,0:03:36.38,Default,,0,0,0,,Жанып тұрған еттің иісі сондай тәбетті.
Dialogue: 0,0:03:37.13,0:03:41.72,Default,,0,0,0,,Жабайы аңды жеу баяу өмір сияқты.
Dialogue: 0,0:03:41.80,0:03:42.80,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:03:42.88,0:03:44.01,Default,,0,0,0,,Қатты…
Dialogue: 0,0:03:44.09,0:03:45.51,Default,,0,0,0,,Иә, алмаймын.
Dialogue: 0,0:03:45.60,0:03:46.60,Default,,0,0,0,,Мари
Dialogue: 0,0:03:46.68,0:03:49.22,Default,,0,0,0,,А, жоқ, Мари дұрыс айтады.
Dialogue: 0,0:03:49.31,0:03:51.89,Default,,0,0,0,,Және оның күшті иісі бар.
Dialogue: 0,0:03:51.98,0:03:53.65,Default,,0,0,0,,Ммм...
Dialogue: 0,0:03:54.15,0:03:56.31,Default,,0,0,0,,Қатты етті ұрып-соғуға болады
Dialogue: 0,0:03:56.98,0:03:59.69,Default,,0,0,0,,Соя соусы, чили бұрышы, бұрыш
Dialogue: 0,0:03:59.78,0:04:02.36,Default,,0,0,0,,Ченпи деп аталатын кептірілген мандарин қабығы қосылды.
Dialogue: 0,0:04:02.45,0:04:04.57,Default,,0,0,0,,Құпия тұздықты дайында
Dialogue: 0,0:04:04.66,0:04:08.91,Default,,0,0,0,,Мияу! Онда көптеген дәмдеуіштер бар және жеуге жарамды.
Dialogue: 0,0:04:08.99,0:04:10.54,Default,,0,0,0,,Дәмі бұрынғысынан да жақсы.
Dialogue: 0,0:04:10.62,0:04:11.45,Default,,0,0,0,,Иә
Dialogue: 0,0:04:11.54,0:04:13.67,Default,,0,0,0,,Жақсы қабылданған сияқты.
Dialogue: 0,0:04:13.75,0:04:15.21,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:04:15.29,0:04:16.50,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:04:16.58,0:04:17.46,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:04:17.54,0:04:18.88,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:04:18.96,0:04:22.34,Default,,0,0,0,,Мынау сасық еттің дәмі өте жақсы!
Dialogue: 0,0:04:22.42,0:04:24.43,Default,,0,0,0,,Аю карридің беделі өте жақсы.
Dialogue: 0,0:04:24.51,0:04:27.22,Default,,0,0,0,,Өйткені, тіпті басқа әлемде де карри - бұл әділдік.
Dialogue: 0,0:04:27.30,0:04:29.10,Default,,0,0,0,,Мияу! Мяу~
Dialogue: 0,0:04:29.18,0:04:30.22,Default,,0,0,0,,Жарайды, орындалды.
Dialogue: 0,0:04:30.31,0:04:31.72,Default,,0,0,0,,Эмилия ханым, жоспар бойынша айдаһар арбасымен эвакуацияланыңыз.
Dialogue: 0,0:04:31.81,0:04:33.35,Default,,0,0,0,,Мен де
Dialogue: 0,0:04:33.43,0:04:35.56,Default,,0,0,0,,Кеничи Бұл не?
Dialogue: 0,0:04:35.65,0:04:36.73,Default,,0,0,0,,Бұл суретті кітап, бірақ...
Dialogue: 0,0:04:36.81,0:04:38.06,Default,,0,0,0,,Кітап?
Dialogue: 0,0:04:38.56,0:04:42.07,Default,,0,0,0,,Бұл тамаша. Бұл сатылады.
Dialogue: 0,0:04:42.15,0:04:44.36,Default,,0,0,0,,Кеничидің заттары әрқашан жақсы сатылады
Dialogue: 0,0:04:44.45,0:04:45.86,Default,,0,0,0,,Және…
Dialogue: 0,0:04:52.25,0:04:53.16,Default,,0,0,0,,Кеничи
Dialogue: 0,0:04:53.25,0:04:54.08,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:54.16,0:04:57.42,Default,,0,0,0,,Мен Астранияда бизнеспен айналысқым келеді!
Dialogue: 0,0:04:57.50,0:04:59.04,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:04:59.13,0:05:01.75,Default,,0,0,0,,Бұл адамның нағыз саудагер екендігі.
Dialogue: 0,0:05:01.84,0:05:05.17,Default,,0,0,0,,Бұл мен саудагердің жанын отқа түсірдім дегенді білдіре ме...
Dialogue: 0,0:05:05.26,0:05:09.05,Default,,0,0,0,,Бірақ суретті кітаптар жақсы болса, тағы не сата аласыз?
Dialogue: 0,0:05:09.14,0:05:12.31,Default,,0,0,0,,Аю етінен жасалған қазан-ау-феу және дәнекерленген бұқтырылған ет
Dialogue: 0,0:05:12.39,0:05:13.64,Default,,0,0,0,,Дәмді! Мыңылдап...
Dialogue: 0,0:05:13.73,0:05:14.98,Default,,0,0,0,,Тіпті Астрантияда
Dialogue: 0,0:05:15.06,0:05:16.89,Default,,0,0,0,,Қандай мейрамханада осындай дәмді сорпа беріледі?
Dialogue: 0,0:05:16.98,0:05:19.06,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:05:19.15,0:05:22.57,Default,,0,0,0,,Себебі мен сорпаның қайнар көзін бердім.
Dialogue: 0,0:05:23.15,0:05:25.15,Default,,0,0,0,,Бұл «байланыстырушының тәттілігі»
Dialogue: 0,0:05:25.24,0:05:28.07,Default,,0,0,0,,Сылтау үшін жеткілікті қант қосылды.
Dialogue: 0,0:05:28.16,0:05:29.99,Default,,0,0,0,,Тәтті және дәмді
Dialogue: 0,0:05:30.07,0:05:31.58,Default,,0,0,0,,Оның да иісі жақсы.
Dialogue: 0,0:05:31.66,0:05:32.62,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:32.70,0:05:33.95,Default,,0,0,0,,-Мм... -Ммм?
Dialogue: 0,0:05:34.04,0:05:36.25,Default,,0,0,0,,Егер сіз дүкеннен шығып кетсеңіз
Dialogue: 0,0:05:36.33,0:05:39.75,Default,,0,0,0,,Ең болмағанда жақсылығыңызды қайтара аласыз ба?
Dialogue: 0,0:05:39.83,0:05:41.09,Default,,0,0,0,,Жақсылықты қайтару?
Dialogue: 0,0:05:41.17,0:05:43.67,Default,,0,0,0,,Мен Кеничи-самаға қарыздармын.
Dialogue: 0,0:05:43.76,0:05:46.13,Default,,0,0,0,,Мен көңілсіз болдым.
Dialogue: 0,0:05:46.22,0:05:46.72,Default,,0,0,0,,Ханым, сіз Астрантияға бірінші рет келіп тұрсыз, солай ма?
Dialogue: 0,0:05:46.72,0:05:47.88,Default,,0,0,0,,Ханым, сіз Астрантияға бірінші рет келіп тұрсыз, солай ма?
Dialogue: 0,0:05:46.72,0:05:47.88,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:05:47.88,0:05:49.34,Default,,0,0,0,,Ханым, сіз Астрантияға бірінші рет келіп тұрсыз, солай ма?
Dialogue: 0,0:05:49.43,0:05:53.01,Default,,0,0,0,,Менің даяшы ретінде біраз тәжірибем бар, сондықтан көмектесе аламын деп ойлаймын.
Dialogue: 0,0:05:53.10,0:05:54.81,Default,,0,0,0,,Мен солай деп үміттенемін.
Dialogue: 0,0:05:54.89,0:05:56.18,Default,,0,0,0,,Сәлем? Примула
Dialogue: 0,0:05:56.68,0:05:57.89,Default,,0,0,0,,Ханым...
Dialogue: 0,0:05:57.98,0:05:59.23,Default,,0,0,0,,Мияу...
Dialogue: 0,0:05:59.31,0:06:00.77,Default,,0,0,0,,Мен де саған көмектесемін
Dialogue: 0,0:06:00.86,0:06:02.32,Default,,0,0,0,,Иә, Мари де?
Dialogue: 0,0:06:02.40,0:06:05.86,Default,,0,0,0,,Иә, мен жұмыс істеуге тура келетін жасқа жақындап қалдым.
Dialogue: 0,0:06:05.94,0:06:07.65,Default,,0,0,0,,Анемондарды не істеу керек?
Dialogue: 0,0:06:07.74,0:06:09.86,Default,,0,0,0,,Сол жігіт… Көзіне латкі таққан Какужа ма?
Dialogue: 0,0:06:09.95,0:06:11.37,Default,,0,0,0,,Хохохо… ханым…
Dialogue: 0,0:06:11.37,0:06:13.58,Default,,0,0,0,,Хохохо... Ханым...
Dialogue: 0,0:06:11.37,0:06:13.58,Default,,0,0,0,,Мен Кеничиден кеткенді жек көремін.
Dialogue: 0,0:06:13.66,0:06:15.54,Default,,0,0,0,,Кеничиге көмектес
Dialogue: 0,0:06:13.66,0:06:15.54,Default,,0,0,0,,Хохохо... оххохо...
Dialogue: 0,0:06:15.54,0:06:15.62,Default,,0,0,0,,Хохохо... охохо...
Dialogue: 0,0:06:15.62,0:06:16.75,Default,,0,0,0,,Хохохо... оххохо...
Dialogue: 0,0:06:15.62,0:06:16.75,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:16.75,0:06:17.37,Default,,0,0,0,,Хохохо... оххохо...
Dialogue: 0,0:06:17.46,0:06:20.37,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:06:20.46,0:06:21.63,Default,,0,0,0,,Примула
Dialogue: 0,0:06:21.71,0:06:25.96,Default,,0,0,0,,Ол келесі күні бизнеске кірісетінін айтты.
Dialogue: 0,0:06:30.34,0:06:31.72,Default,,0,0,0,,Шақыру
Dialogue: 0,0:06:33.35,0:06:34.60,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:06:34.68,0:06:35.52,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:06:37.60,0:06:38.81,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:06:37.60,0:06:38.81,Default,,0,0,0,,Жақсы ма? Бұл дүкен
Dialogue: 0,0:06:38.81,0:06:38.89,Default,,0,0,0,,Жақсы ма? Бұл дүкен
Dialogue: 0,0:06:38.89,0:06:39.23,Default,,0,0,0,,Жақсы ма? Бұл дүкен
Dialogue: 0,0:06:38.89,0:06:39.23,Default,,0,0,0,,Күн ыстық, абай болыңыз.
Dialogue: 0,0:06:39.23,0:06:39.31,Default,,0,0,0,,Күн ыстық, абай болыңыз.
Dialogue: 0,0:06:39.31,0:06:40.02,Default,,0,0,0,,Күн ыстық, абай болыңыз.
Dialogue: 0,0:06:39.31,0:06:40.02,Default,,0,0,0,,Жарайды, сіз оны қолданып көргенде түсінесіз.
Dialogue: 0,0:06:40.02,0:06:40.10,Default,,0,0,0,,Жарайды, сіз оны қолданып көргенде түсінесіз.
Dialogue: 0,0:06:40.10,0:06:42.02,Default,,0,0,0,,Жарайды, сіз оны қолданып көргенде түсінесіз.
Dialogue: 0,0:06:40.10,0:06:42.02,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:06:42.11,0:06:44.02,Default,,0,0,0,,Қараңызшы, дәмді көрінеді.
Dialogue: 0,0:06:42.11,0:06:44.02,Default,,0,0,0,,- (Мари) Өтінемін - Келесі адам.
Dialogue: 0,0:06:44.11,0:06:46.53,Default,,0,0,0,,Жоқ, жоқ, иісі басқа... және дәмді~
Dialogue: 0,0:06:46.61,0:06:48.95,Default,,0,0,0,,Бұл кастрюль өте дәмді!
Dialogue: 0,0:06:49.03,0:06:51.16,Default,,0,0,0,,Жоғары санатты мейрамханаларда ғана жеуге болатын тәтті бұқтырылған тағам.
Dialogue: 0,0:06:51.24,0:06:53.41,Default,,0,0,0,,Мен мұндай дүңгіршекте тамақ ішетініме сене алар емеспін!
Dialogue: 0,0:06:53.49,0:06:55.41,Default,,0,0,0,,- (Тапсырыс беруші) Әй, бұл не! -Аа...
Dialogue: 0,0:06:55.49,0:06:56.91,Default,,0,0,0,,(Маридің үрейлі дауысы)
Dialogue: 0,0:06:57.66,0:06:59.87,Default,,0,0,0,,Тұтынушы, не болды?
Dialogue: 0,0:06:59.96,0:07:03.67,Default,,0,0,0,,Бұл дүкен тұтынушыларға құрамында жәндіктер бар тағамды бере ме?
Dialogue: 0,0:07:03.75,0:07:06.05,Default,,0,0,0,,Мынадай нәрсе болуы керек...
Dialogue: 0,0:07:06.13,0:07:10.17,Default,,0,0,0,,Не, біз оны алдық дейсіз бе?
Dialogue: 0,0:07:15.26,0:07:17.31,Default,,0,0,0,,Осы жартастың үстіндегі биік таулар
Dialogue: 0,0:07:17.39,0:07:19.64,Default,,0,0,0,,Толығымен қозғалмаған.
Dialogue: 0,0:07:22.90,0:07:26.44,Default,,0,0,0,,Дәрілік шөптер мен жабайы өсімдіктер көп болуы керек.
Dialogue: 0,0:07:27.32,0:07:29.07,Default,,0,0,0,,Жарқыраған әдемі тас
Dialogue: 0,0:07:29.15,0:07:30.53,Default,,0,0,0,,Көп.
Dialogue: 0,0:07:30.61,0:07:31.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:31.53,0:07:34.57,Default,,0,0,0,,Мен мұндай түсті кенді ешқашан көрген емеспін...
Dialogue: 0,0:07:34.66,0:07:37.83,Default,,0,0,0,,Бірақ мен оны қымбат бағаға сататындай сезінбеймін.
Dialogue: 0,0:07:38.95,0:07:40.58,Default,,0,0,0,,Қашықтық 12 метр
Dialogue: 0,0:07:40.66,0:07:42.83,Default,,0,0,0,,Кенді қалай өндіруге келетін болсақ...
Dialogue: 0,0:07:42.92,0:07:44.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:48.00,0:07:48.84,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:48.92,0:07:51.63,Default,,0,0,0,,Кеничи сатылып кетті!
Dialogue: 0,0:07:51.72,0:07:55.30,Default,,0,0,0,,Кеничиге рахмет, менің барлық суретті кітаптарым сатылды!
Dialogue: 0,0:07:55.39,0:07:58.26,Default,,0,0,0,,Менің жасаған тағамым дәмді болғандықтан шығар.
Dialogue: 0,0:07:58.35,0:08:00.10,Default,,0,0,0,,Бірінші күннен бастап не сатылды?
Dialogue: 0,0:08:00.18,0:08:03.31,Default,,0,0,0,,Күтілгендей, Примуланың іскерлік қабілеті ерекше.
Dialogue: 0,0:08:03.39,0:08:04.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:04.31,0:08:05.86,Default,,0,0,0,,Бұл аңшы кім?
Dialogue: 0,0:08:05.94,0:08:07.61,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:08:07.69,0:08:09.73,Default,,0,0,0,,Кешірім сұраудың қажеті жоқ
Dialogue: 0,0:08:09.82,0:08:11.11,Default,,0,0,0,,- (Қонақтар) А? -Аа...
Dialogue: 0,0:08:11.19,0:08:14.78,Default,,0,0,0,,Қателерді қайда салғаныңызды бақылап отырдым.
Dialogue: 0,0:08:14.86,0:08:16.32,Default,,0,0,0,,Бағана жанындағы сол адам, Сантана—
Dialogue: 0,0:08:16.41,0:08:18.37,Default,,0,0,0,,Нурегину десең
Dialogue: 0,0:08:18.45,0:08:20.33,Default,,0,0,0,,Қалтаңда не бар екенін көрсет
Dialogue: 0,0:08:20.41,0:08:21.79,Default,,0,0,0,,Уау... Уау...
Dialogue: 0,0:08:21.87,0:08:24.37,Default,,0,0,0,,Олардың кейбіреулері әлі де бар, солай емес пе?
Dialogue: 0,0:08:24.46,0:08:26.42,Default,,0,0,0,,Қалай... неге олай істедің?
Dialogue: 0,0:08:26.50,0:08:27.67,Default,,0,0,0,,- (Тапсырыс беруші) Эй! -(Тапсырыс беруші) Жоқ!
Dialogue: 0,0:08:27.75,0:08:30.13,Default,,0,0,0,,Мен оны бүгінге қалдырамын.
Dialogue: 0,0:08:30.21,0:08:31.42,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:08:36.01,0:08:37.26,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:37.35,0:08:40.56,Default,,0,0,0,,Сондықтан мен оны күзетші етіп жалдадым.
Dialogue: 0,0:08:40.64,0:08:42.81,Default,,0,0,0,,Рахмет. Мен де рахмет айтамын.
Dialogue: 0,0:08:42.89,0:08:44.77,Default,,0,0,0,,Мен саған рахмет айтамын.
Dialogue: 0,0:08:44.85,0:08:46.98,Default,,0,0,0,,Егер сізбен байланысы бар сияқты көрінетін адамға қарасаңыз,
Dialogue: 0,0:08:47.06,0:08:49.02,Default,,0,0,0,,Бұл күніне бір ғана күміс монета.
Dialogue: 0,0:08:49.61,0:08:52.15,Default,,0,0,0,,Бұндай дәмді жұмыс жоқ.
Dialogue: 0,0:08:52.24,0:08:55.28,Default,,0,0,0,,Ой, мен өзімді әлі таныстырған жоқпын.
Dialogue: 0,0:08:55.36,0:08:57.37,Default,,0,0,0,,Мен Няменамын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:08:57.45,0:09:00.91,Default,,0,0,0,,Бұл Кеничи. Бұдан былай Примуладан сұрамаңыз.
Dialogue: 0,0:09:02.16,0:09:03.91,Default,,0,0,0,,Қош келдіңіз Кеничи~
Dialogue: 0,0:09:04.00,0:09:06.50,Default,,0,0,0,,Қош келдіңіз Кеничи~
Dialogue: 0,0:09:06.58,0:09:07.42,Default,,0,0,0,,Гяа!
Dialogue: 0,0:09:07.50,0:09:08.96,Default,,0,0,0,,Сақтау
Dialogue: 0,0:09:09.04,0:09:10.59,Default,,0,0,0,,Ол қандай әйел?
Dialogue: 0,0:09:10.67,0:09:12.76,Default,,0,0,0,,Ол Примула жалдаған эскорт.
Dialogue: 0,0:09:12.84,0:09:14.67,Default,,0,0,0,,Мен сені кешкі асқа шақырғым келеді.
Dialogue: 0,0:09:14.76,0:09:16.68,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:16.76,0:09:19.47,Default,,0,0,0,,Мен Кеничиде тағы да әйелдер көп болды деп ойладым.
Dialogue: 0,0:09:19.55,0:09:21.43,Default,,0,0,0,,«Қайтадан» нені білдіреді?
Dialogue: 0,0:09:21.51,0:09:23.18,Default,,0,0,0,,-Мяу -Ой...
Dialogue: 0,0:09:23.27,0:09:25.18,Default,,0,0,0,,-Ня~ -Жарайды, жарайды, мен үйдемін.
Dialogue: 0,0:09:25.27,0:09:26.94,Default,,0,0,0,,- Мяу - Иә, орман мысығы...
Dialogue: 0,0:09:28.27,0:09:30.94,Default,,0,0,0,,Хэхе~
Dialogue: 0,0:09:31.02,0:09:32.69,Default,,0,0,0,,Шынында, сол сырғаң өте батыл екен.
Dialogue: 0,0:09:32.78,0:09:34.36,Default,,0,0,0,,Хмм... дәмді!
Dialogue: 0,0:09:34.44,0:09:35.74,Default,,0,0,0,,Бұл аю етінен жасалған қайнатпа.
Dialogue: 0,0:09:35.82,0:09:38.70,Default,,0,0,0,,Бұл аю еті... бұқтырылған...
Dialogue: 0,0:09:38.78,0:09:40.74,Default,,0,0,0,,Енді бұл шарап.
Dialogue: 0,0:09:40.83,0:09:41.78,Default,,0,0,0,,Бар
Dialogue: 0,0:09:41.87,0:09:42.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:44.29,0:09:46.46,Default,,0,0,0,,Пухааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:09:46.54,0:09:49.42,Default,,0,0,0,,Мен мұндай тамаша шараптың дәмін бірінші рет татып отырмын.
Dialogue: 0,0:09:49.50,0:09:52.63,Default,,0,0,0,,Бұл Шангри-Ладағы ең арзан шарап...
Dialogue: 0,0:09:52.71,0:09:54.21,Default,,0,0,0,,Тамағы жақсы, ішімдігі жақсы.
Dialogue: 0,0:09:54.30,0:09:56.63,Default,,0,0,0,,Бұл жұмақ па хахаха...
Dialogue: 0,0:09:56.72,0:09:57.55,Default,,0,0,0,,Сіз ваннаға түсесіз, солай ма?
Dialogue: 0,0:09:57.63,0:09:58.47,Default,,0,0,0,,Ванна?
Dialogue: 0,0:09:58.55,0:10:01.72,Default,,0,0,0,,Иә Иә! Кеничи мен қайнатамын!
Dialogue: 0,0:10:01.80,0:10:04.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:04.18,0:10:05.73,Default,,0,0,0,,От шары!
Dialogue: 0,0:10:07.69,0:10:08.85,Default,,0,0,0,,О~
Dialogue: 0,0:10:11.81,0:10:12.86,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:10:12.94,0:10:14.57,Default,,0,0,0,,От шары…
Dialogue: 0,0:10:14.65,0:10:16.82,Default,,0,0,0,,Шабуыл сиқырымен ваннаны қайнату...
Dialogue: 0,0:10:16.90,0:10:18.11,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:10:16.90,0:10:18.11,Default,,0,0,0,,(шешініп жатқан дыбыс)
Dialogue: 0,0:10:18.20,0:10:19.70,Default,,0,0,0,,Хэхе~!
Dialogue: 0,0:10:20.20,0:10:21.07,Default,,0,0,0,,-Аа... -Хехехе...
Dialogue: 0,0:10:21.16,0:10:22.16,Default,,0,0,0,,-Мм! -Ух...
Dialogue: 0,0:10:22.78,0:10:25.29,Default,,0,0,0,,А... Мен мұнымен ваннаны тез қайнатамын.
Dialogue: 0,0:10:25.37,0:10:27.54,Default,,0,0,0,,Сиқырды қайталап қолдануға бола ма?
Dialogue: 0,0:10:27.62,0:10:31.54,Default,,0,0,0,,Сиқыр оны пайдаланған сайын өседі.
Dialogue: 0,0:10:31.63,0:10:32.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:33.21,0:10:34.88,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:10:34.96,0:10:38.84,Default,,0,0,0,,Сіз ыстық суға шомылатын министрсіз бе, әлде ақсүйексіз бе?
Dialogue: 0,0:10:38.92,0:10:41.64,Default,,0,0,0,,Бұл шындап жұмақ хахаха...
Dialogue: 0,0:10:41.72,0:10:43.14,Default,,0,0,0,,(Жылытқыштың дыбысы)
Dialogue: 0,0:10:44.18,0:10:46.14,Default,,0,0,0,,Ммммм.
Dialogue: 0,0:10:46.22,0:10:47.73,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:10:48.73,0:10:51.52,Default,,0,0,0,,Жоқ, бұл керемет. Бұл да сиқыр ма?
Dialogue: 0,0:10:51.60,0:10:52.52,Default,,0,0,0,,О
Dialogue: 0,0:10:52.61,0:10:54.19,Default,,0,0,0,,Төсегі де жұмсақ.
Dialogue: 0,0:10:54.27,0:10:56.03,Default,,0,0,0,,Мүмкін мен де осында тұруым керек шығар.
Dialogue: 0,0:10:56.11,0:10:58.11,Default,,0,0,0,,Жоқ! Бөлме кішірейіп барады!
Dialogue: 0,0:10:58.19,0:11:00.07,Default,,0,0,0,,Жақсы, тағы бір адамды қос.
Dialogue: 0,0:11:00.15,0:11:02.03,Default,,0,0,0,,Енді келесі сұрақ.
Dialogue: 0,0:11:02.11,0:11:03.66,Default,,0,0,0,,- Мм... - (Мяре Нямена) Хмм?
Dialogue: 0,0:11:03.74,0:11:06.24,Default,,0,0,0,,Сен маған оқуды үйретесің бе?
Dialogue: 0,0:11:06.33,0:11:09.00,Default,,0,0,0,,Әй, оқып, жазып, есептей алсаң жақсы болар еді.
Dialogue: 0,0:11:09.08,0:11:11.17,Default,,0,0,0,,Өйткені жұмыс ауқымы кеңейеді
Dialogue: 0,0:11:11.25,0:11:13.63,Default,,0,0,0,,Әйелдерге арналған жұмыс көп емес сияқты.
Dialogue: 0,0:11:13.71,0:11:15.04,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:11:15.13,0:11:16.46,Default,,0,0,0,,Соңында білімсіздер
Dialogue: 0,0:11:16.55,0:11:18.51,Default,,0,0,0,,Тек сату керек.
Dialogue: 0,0:11:18.59,0:11:19.55,Default,,0,0,0,,Анемон
Dialogue: 0,0:11:19.63,0:11:21.30,Default,,0,0,0,,Мари де осында.
Dialogue: 0,0:11:21.38,0:11:24.60,Default,,0,0,0,,Неге Примуламен бірге барып, бизнесті үйренбейсің?
Dialogue: 0,0:11:24.68,0:11:28.18,Default,,0,0,0,,Мен сиқырды көбірек үйренемін және Кеничиге көмектесемін!
Dialogue: 0,0:11:28.27,0:11:32.10,Default,,0,0,0,,Кеничимен шытырман оқиғаға барыңыз және айдаһарды жеңіңіз!
Dialogue: 0,0:11:32.19,0:11:33.90,Default,,0,0,0,,Иә... иә?
Dialogue: 0,0:11:33.98,0:11:36.44,Default,,0,0,0,,Ой!
Dialogue: 0,0:11:36.52,0:11:39.65,Default,,0,0,0,,Мен... Мен жайбарақат өмір сүргім келеді.
Dialogue: 0,0:11:39.74,0:11:40.70,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:40.78,0:11:42.32,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:11:46.91,0:11:49.20,Default,,0,0,0,,(Мяре мен Няменаның ұйықтауы)
Dialogue: 0,0:11:49.29,0:11:52.29,Default,,0,0,0,,Содан бері Примула дүкені гүлдене берді.
Dialogue: 0,0:11:52.29,0:11:53.58,Default,,0,0,0,,Содан бері Примула дүкені гүлдене берді.
Dialogue: 0,0:11:52.29,0:11:53.58,Default,,0,0,0,,-(Мари) Иә, өтінемін -Аа...
Dialogue: 0,0:11:53.67,0:11:54.79,Default,,0,0,0,,Нямена да күнде жолсерік болып келетін.
Dialogue: 0,0:11:54.79,0:11:57.50,Default,,0,0,0,,Нямена да күнде жолсерік болып келетін.
Dialogue: 0,0:11:54.79,0:11:57.50,Default,,0,0,0,,-Ммм-(қонақтар) Эй...
Dialogue: 0,0:11:57.50,0:11:58.71,Default,,0,0,0,,-Ммм-(қонақтар) Эй...
Dialogue: 0,0:11:58.80,0:11:59.63,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:11:59.71,0:12:01.97,Default,,0,0,0,,Кротоннан да хат келген сияқты.
Dialogue: 0,0:12:03.18,0:12:04.97,Default,,0,0,0,,Мен болсам...
Dialogue: 0,0:12:05.05,0:12:07.10,Default,,0,0,0,,Майаре мен Анемонның көмегімен
Dialogue: 0,0:12:07.18,0:12:10.47,Default,,0,0,0,,Жартасқа өрмелеу үшін құрылысты аяқтады.
Dialogue: 0,0:12:10.56,0:12:13.02,Default,,0,0,0,,Жарайды, егер солай істесең, жақсы болады.
Dialogue: 0,0:12:13.10,0:12:14.23,Default,,0,0,0,,Мияу!
Dialogue: 0,0:12:14.31,0:12:16.73,Default,,0,0,0,,Мияу мияу мияу~
Dialogue: 0,0:12:16.81,0:12:18.15,Default,,0,0,0,,Мен де көтерілемін!
Dialogue: 0,0:12:18.23,0:12:19.73,Default,,0,0,0,,Жарайды, а...
Dialogue: 0,0:12:19.82,0:12:22.19,Default,,0,0,0,,Бұл қазірдің өзінде ұзақ!
Dialogue: 0,0:12:28.62,0:12:30.37,Default,,0,0,0,,Мм... Кеничи
Dialogue: 0,0:12:30.45,0:12:31.54,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:31.62,0:12:34.67,Default,,0,0,0,,Мен сізден сұрайын деп жүрген едім.
Dialogue: 0,0:12:34.75,0:12:37.75,Default,,0,0,0,,Зат қорабында мұндай заттар өте көп.
Dialogue: 0,0:12:37.84,0:12:39.55,Default,,0,0,0,,Ол кіреді ме?
Dialogue: 0,0:12:39.63,0:12:41.80,Default,,0,0,0,,Әділ сақтау
Dialogue: 0,0:12:41.88,0:12:44.80,Default,,0,0,0,,Дегенмен, қанша болсаң да маған бәрін көрсете алмайсың.
Dialogue: 0,0:12:44.88,0:12:47.01,Default,,0,0,0,,Әрине, анемон мен миаре
Dialogue: 0,0:12:47.09,0:12:48.30,Default,,0,0,0,,- Иә? -бір-бірі-
Dialogue: 0,0:12:48.39,0:12:51.27,Default,,0,0,0,,Бір-екі құпияң бар ма?
Dialogue: 0,0:12:51.35,0:12:55.44,Default,,0,0,0,,Сенің жүрегіңде мен білмейтін бірдеңе бар екеніне сенімдімін.
Dialogue: 0,0:12:55.52,0:12:57.65,Default,,0,0,0,,Жарайды... бұл рас, бірақ...
Dialogue: 0,0:12:57.73,0:13:01.69,Default,,0,0,0,,Қараңызшы, маған сену қиындай бастады, солай ма?
Dialogue: 0,0:13:01.78,0:13:02.99,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:13:03.07,0:13:03.90,Default,,0,0,0,,А...
Dialogue: 0,0:13:05.99,0:13:08.66,Default,,0,0,0,,Егер сіз Далияға қайтқыңыз келсе, ол қазір.
Dialogue: 0,0:13:08.74,0:13:10.45,Default,,0,0,0,,Мен қайтпаймын
Dialogue: 0,0:13:10.53,0:13:11.74,Default,,0,0,0,,Күйеуі
Dialogue: 0,0:13:12.24,0:13:15.96,Default,,0,0,0,,Сіз мені өзіңіздің көз алдыңызда мұндай әрекеттен құтқара аласыз ба?
Dialogue: 0,0:13:16.04,0:13:17.33,Default,,0,0,0,,Бұл менің көзіме улы.
Dialogue: 0,0:13:17.42,0:13:20.71,Default,,0,0,0,,Не, сен жақсы әйелсің, бірақ жарың жоқ па?
Dialogue: 0,0:13:20.79,0:13:24.80,Default,,0,0,0,,Ха... Құнсыз адамнан сұрайтыным осы.
Dialogue: 0,0:13:24.88,0:13:26.13,Default,,0,0,0,,Кеничи~!
Dialogue: 0,0:13:26.22,0:13:27.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:27.26,0:13:29.89,Default,,0,0,0,,Менің қарным ашты!
Dialogue: 0,0:13:35.77,0:13:39.27,Default,,0,0,0,,Келесі күні Примула дүкенін жауып тастады.
Dialogue: 0,0:13:39.90,0:13:42.82,Default,,0,0,0,,Өйткені мен жартастың басына шығамын дедім.
Dialogue: 0,0:13:43.44,0:13:44.86,Default,,0,0,0,,Синерария мен Мари
Dialogue: 0,0:13:44.94,0:13:47.82,Default,,0,0,0,,Майаре мен Нямена мені көтеріп алды.
Dialogue: 0,0:13:47.91,0:13:50.66,Default,,0,0,0,,Саған рахмет, Анемон да бақытты.
Dialogue: 0,0:13:51.16,0:13:53.79,Default,,0,0,0,,Уау... көл сондай үлкен!
Dialogue: 0,0:13:53.87,0:13:55.87,Default,,0,0,0,,Мен де өз ауылымды көремін!
Dialogue: 0,0:13:55.96,0:13:58.00,Default,,0,0,0,,Жартасқа тым жақындамаңыз~
Dialogue: 0,0:13:58.08,0:13:59.96,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:14:00.04,0:14:03.46,Default,,0,0,0,,Мен бірден жүрегімнің мазмұнын зерттеуді шештім...
Dialogue: 0,0:14:03.55,0:14:06.59,Default,,0,0,0,,Бұл жабайы саңырауқұлақ. Бұл өте дәмді.
Dialogue: 0,0:14:06.67,0:14:09.34,Default,,0,0,0,,Келесі жолы мен садақ әкелемін.
Dialogue: 0,0:14:09.43,0:14:12.64,Default,,0,0,0,,Майаре Қызыл шық шөп болды.
Dialogue: 0,0:14:12.72,0:14:13.89,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:14:13.97,0:14:15.98,Default,,0,0,0,,Бұл жасыл шық шөпі.
Dialogue: 0,0:14:24.69,0:14:26.49,Default,,0,0,0,,Хмм... сақтау
Dialogue: 0,0:14:26.57,0:14:28.20,Default,,0,0,0,,Бағалау
Dialogue: 0,0:14:29.32,0:14:31.62,Default,,0,0,0,,200 000 иен? Шынайы ма?
Dialogue: 0,0:14:31.70,0:14:34.03,Default,,0,0,0,,Бір электр балғасы өзін ақтады
Dialogue: 0,0:14:34.12,0:14:35.49,Default,,0,0,0,,Бұл мүмкін
Dialogue: 0,0:14:35.58,0:14:37.20,Default,,0,0,0,,Оңай жеңіс?
Dialogue: 0,0:14:37.83,0:14:39.50,Default,,0,0,0,,(Электр балғасының жұмыс дыбысы)
Dialogue: 0,0:14:41.83,0:14:44.55,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:14:51.34,0:14:52.60,Default,,0,0,0,,Керемет!
Dialogue: 0,0:14:52.68,0:14:54.31,Default,,0,0,0,,Қызықты~
Dialogue: 0,0:14:54.39,0:14:58.10,Default,,0,0,0,,Иісін кетіру үшін сүтке малынған аю етін пайдаланыңыз.
Dialogue: 0,0:14:58.18,0:14:59.77,Default,,0,0,0,,Көкөністер қытай қырыққабаты және бұл жолғы басты кейіпкер.
Dialogue: 0,0:14:59.85,0:15:02.02,Default,,0,0,0,,Бұл жабайы саңырауқұлақ.
Dialogue: 0,0:15:02.10,0:15:03.77,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:15:03.86,0:15:06.28,Default,,0,0,0,,Қараңызшы, бұл гиоза.
Dialogue: 0,0:15:06.36,0:15:07.44,Default,,0,0,0,,«Лайт» жарайды.
Dialogue: 0,0:15:07.53,0:15:09.03,Default,,0,0,0,,-Иә! -(Мари) Сенің қолыңнан келеді!
Dialogue: 0,0:15:09.11,0:15:11.95,Default,,0,0,0,,Миалейлердің шаштары түсіп қалады, сондықтан шыдамды болыңыз.
Dialogue: 0,0:15:12.03,0:15:13.12,Default,,0,0,0,,Мя~
Dialogue: 0,0:15:13.20,0:15:14.03,Default,,0,0,0,,Тс…
Dialogue: 0,0:15:14.12,0:15:15.53,Default,,0,0,0,,(пісіру дыбысы)
Dialogue: 0,0:15:15.62,0:15:17.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:17.87,0:15:19.04,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:19.87,0:15:21.71,Default,,0,0,0,,О~
Dialogue: 0,0:15:22.25,0:15:24.67,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:15:24.75,0:15:25.88,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:15:25.96,0:15:27.17,Default,,0,0,0,,Рас!
Dialogue: 0,0:15:27.25,0:15:28.51,Default,,0,0,0,,Мен…
Dialogue: 0,0:15:28.59,0:15:31.18,Default,,0,0,0,,Мугугу! Ішінен ет шырыны шығады...
Dialogue: 0,0:15:31.26,0:15:32.72,Default,,0,0,0,,Умия~!
Dialogue: 0,0:15:32.80,0:15:34.43,Default,,0,0,0,,Бұл жігіт өте жақсы!
Dialogue: 0,0:15:34.51,0:15:37.72,Default,,0,0,0,,Аю етінен осындай дәмді тағамды қалай жасауға болады?
Dialogue: 0,0:15:37.81,0:15:40.77,Default,,0,0,0,,Кеничи Бұл сары соус та дәмді.
Dialogue: 0,0:15:40.85,0:15:42.94,Default,,0,0,0,,О, бұл майонез деп аталады.
Dialogue: 0,0:15:43.02,0:15:46.19,Default,,0,0,0,,А... Солай ма?
Dialogue: 0,0:15:46.27,0:15:49.11,Default,,0,0,0,,Империяда таңғажайып нәрсе болып жатқанын естідім.
Dialogue: 0,0:15:49.19,0:15:51.90,Default,,0,0,0,,Сиқыршы оны сиқырдың көмегімен жасады, солай ма?
Dialogue: 0,0:15:51.99,0:15:55.03,Default,,0,0,0,,Екі жақты бухгалтерлік есеп және гача сорғысы...
Dialogue: 0,0:15:55.62,0:15:57.83,Default,,0,0,0,,Майонез жігіті
Dialogue: 0,0:15:59.75,0:16:03.12,Default,,0,0,0,,Қызық, ол да гиоза жейді ме...
Dialogue: 0,0:16:04.92,0:16:07.88,Default,,0,0,0,,Кеничи де сиқырмен жаратылған ба?
Dialogue: 0,0:16:07.96,0:16:11.42,Default,,0,0,0,,Жоқ, сірке суы, жұмыртқа және маймен осындай нәрсе жасауға болады.
Dialogue: 0,0:16:11.51,0:16:12.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:12.42,0:16:15.89,Default,,0,0,0,,Бұл сатылады! Рецепт айтып беріңізші!
Dialogue: 0,0:16:15.97,0:16:17.85,Default,,0,0,0,,Хмм... кейінірек.
Dialogue: 0,0:16:17.93,0:16:19.35,Default,,0,0,0,,Ешбір Мен де Тағы бір нәрсе
Dialogue: 0,0:16:21.27,0:16:24.60,Default,,0,0,0,,Иә, гиоза дегенде көз алдыңызға қытай қырыққабаты келеді.
Dialogue: 0,0:16:24.69,0:16:28.52,Default,,0,0,0,,Аю етінің дәмі ерекше емес, ал жабайы саңырауқұлақтардың дәмі де жақсы.
Dialogue: 0,0:16:28.61,0:16:31.15,Default,,0,0,0,,Теріні қалыңдатып, сорпаға қосуға да болады.
Dialogue: 0,0:16:31.24,0:16:33.20,Default,,0,0,0,,Бұл дәмді көрінеді.
Dialogue: 0,0:16:33.28,0:16:35.41,Default,,0,0,0,,Мен де оны өз дүкенімде сатқым келеді!
Dialogue: 0,0:16:35.49,0:16:37.49,Default,,0,0,0,,Бірақ бұл көп күш жұмсауды қажет етеді.
Dialogue: 0,0:16:37.57,0:16:39.66,Default,,0,0,0,,Тек біреуді жалдаңыз
Dialogue: 0,0:16:39.74,0:16:40.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:40.74,0:16:43.75,Default,,0,0,0,,Murrow & Co. Ақша табудың бір құпиясы —
Dialogue: 0,0:16:43.83,0:16:46.92,Default,,0,0,0,,Басқалардың күшін белсенді түрде алыңыз!
Dialogue: 0,0:16:47.00,0:16:49.67,Default,,0,0,0,,Дегенмен, жеткілікті өтемақы төлеуді ұмытпаңыз.
Dialogue: 0,0:16:49.75,0:16:52.26,Default,,0,0,0,,Бизнесмен күткендей.
Dialogue: 0,0:16:52.34,0:16:55.26,Default,,0,0,0,,Қайсысын жасауым керек?
Dialogue: 0,0:16:59.85,0:17:02.56,Default,,0,0,0,,Маған өзімнің отты шарымды көрсетейін.
Dialogue: 0,0:17:03.10,0:17:04.27,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:17:04.35,0:17:06.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:06.10,0:17:07.44,Default,,0,0,0,,Қандай таң қалдырды!
Dialogue: 0,0:17:07.52,0:17:09.11,Default,,0,0,0,,Иә, бұл керемет болды!
Dialogue: 0,0:17:09.19,0:17:12.78,Default,,0,0,0,,Жоқ, жоқ, сіздің сиқырыңыз 100 есе керемет...
Dialogue: 0,0:17:12.86,0:17:15.15,Default,,0,0,0,,Не болды!
Dialogue: 0,0:17:15.24,0:17:17.03,Default,,0,0,0,,Бұл аю етінен жасалған стейк.
Dialogue: 0,0:17:17.11,0:17:19.03,Default,,0,0,0,,Хмм…
Dialogue: 0,0:17:19.12,0:17:20.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:20.28,0:17:22.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:20.28,0:17:22.16,Default,,0,0,0,,Бұл сіздің талғамыңызға сай емес пе?
Dialogue: 0,0:17:22.24,0:17:24.71,Default,,0,0,0,,Керісінше, бұл шындық болу үшін тым жақсы!
Dialogue: 0,0:17:24.79,0:17:26.37,Default,,0,0,0,,Бірақ бұл қандай иіс?
Dialogue: 0,0:17:26.46,0:17:27.29,Default,,0,0,0,,О
Dialogue: 0,0:17:27.37,0:17:29.71,Default,,0,0,0,,Иісін кетіру үшін маринадталған аю еті.
Dialogue: 0,0:17:29.79,0:17:31.17,Default,,0,0,0,,Ішімдіктің иісі бар.
Dialogue: 0,0:17:31.25,0:17:32.34,Default,,0,0,0,,Алкоголь?
Dialogue: 0,0:17:32.42,0:17:33.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:34.34,0:17:36.51,Default,,0,0,0,,Күйеу! Менің сенен кішігірім бір жақсылығым бар.
Dialogue: 0,0:17:36.59,0:17:37.43,Default,,0,0,0,,Ах~
Dialogue: 0,0:17:37.51,0:17:38.34,Default,,0,0,0,,- (Мьяли) Мияу! -Аа...
Dialogue: 0,0:17:38.43,0:17:39.72,Default,,0,0,0,,Иә, иә…
Dialogue: 0,0:17:40.89,0:17:41.35,Default,,0,0,0,,Хехе...
Dialogue: 0,0:17:41.35,0:17:44.43,Default,,0,0,0,,Хехе...
Dialogue: 0,0:17:41.35,0:17:44.43,Default,,0,0,0,,Бұл өте күшті сусын, сондықтан абай болыңыз.
Dialogue: 0,0:17:44.52,0:17:45.56,Default,,0,0,0,,(Ньяменаның иіскеу дыбысы)
Dialogue: 0,0:17:45.64,0:17:47.39,Default,,0,0,0,,О, қандай жақсы иіс!
Dialogue: 0,0:17:47.48,0:17:49.15,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:17:49.23,0:17:50.44,Default,,0,0,0,,Фаах!
Dialogue: 0,0:17:50.52,0:17:52.90,Default,,0,0,0,,Енді... сен маған не істей аласың?
Dialogue: 0,0:17:52.98,0:17:55.90,Default,,0,0,0,,Осындай дәмді тағамды білмесең, қалада тұра алмас едің!
Dialogue: 0,0:17:55.99,0:17:57.95,Default,,0,0,0,,Бұл жігіт аралас сусын ба?
Dialogue: 0,0:17:58.03,0:18:00.32,Default,,0,0,0,,Фугия~! Кеттік
Dialogue: 0,0:18:00.41,0:18:02.20,Default,,0,0,0,,Мен оны мүлдем қабылдамаймын.
Dialogue: 0,0:18:02.28,0:18:04.87,Default,,0,0,0,,Маған сонда тұруға рұқсат бересіз бе?
Dialogue: 0,0:18:04.95,0:18:05.95,Default,,0,0,0,,Күрішпен
Dialogue: 0,0:18:06.04,0:18:07.87,Default,,0,0,0,,Жоқ! Сыртқа шығайық!
Dialogue: 0,0:18:06.04,0:18:07.87,Default,,0,0,0,,А... иә...
Dialogue: 0,0:18:07.96,0:18:09.04,Default,,0,0,0,,Мұнда және мұнда
Dialogue: 0,0:18:09.12,0:18:11.88,Default,,0,0,0,,Нямена Примуланың оққағары ретінде қажет.
Dialogue: 0,0:18:11.96,0:18:14.55,Default,,0,0,0,,Мияу! Мен бұл жігітке сене алмаймын!
Dialogue: 0,0:18:14.63,0:18:16.34,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:18:16.42,0:18:17.72,Default,,0,0,0,,Әй, қыз?
Dialogue: 0,0:18:17.80,0:18:20.14,Default,,0,0,0,,Иә, сіз өте адал адамсыз.
Dialogue: 0,0:18:20.22,0:18:21.47,Default,,0,0,0,,Фугия~!
Dialogue: 0,0:18:21.55,0:18:24.22,Default,,0,0,0,,Примула жақсы болса, мен де жақсымын.
Dialogue: 0,0:18:21.55,0:18:24.22,Default,,0,0,0,,Уф... мияу мияу...
Dialogue: 0,0:18:24.22,0:18:24.31,Default,,0,0,0,,Уф... мияу мияу...
Dialogue: 0,0:18:24.31,0:18:26.39,Default,,0,0,0,,Уф... мияу мияу...
Dialogue: 0,0:18:24.31,0:18:26.39,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:18:26.48,0:18:27.52,Default,,0,0,0,,Ол мені осы күйімде көрмесін деп, батыл болып көрінуге барынша тырысып жүрмін
Dialogue: 0,0:18:27.60,0:18:31.31,Default,,0,0,0,,Нямена-сан тамақ пісіруге және ішуге қызығатын сияқты.
Dialogue: 0,0:18:31.40,0:18:32.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:34.02,0:18:35.36,Default,,0,0,0,,Сонымен... жалдау ақысы қанша?
Dialogue: 0,0:18:35.44,0:18:36.61,Default,,0,0,0,,Маған қажет емес.
Dialogue: 0,0:18:36.69,0:18:37.53,Default,,0,0,0,,Э~?
Dialogue: 0,0:18:37.61,0:18:41.28,Default,,0,0,0,,Күйеуім, сен мені не қылмақшысың?
Dialogue: 0,0:18:41.37,0:18:42.24,Default,,0,0,0,,-Аа... -Аа...
Dialogue: 0,0:18:42.32,0:18:44.66,Default,,0,0,0,,Мүмкін сен мені қолға алмақшысың
Dialogue: 0,0:18:44.74,0:18:46.41,Default,,0,0,0,,Біртүрлі түсініспеушіліктерге жол бермеңіз
Dialogue: 0,0:18:46.41,0:18:46.79,Default,,0,0,0,,Біртүрлі түсініспеушіліктерге жол бермеңіз
Dialogue: 0,0:18:46.41,0:18:46.79,Default,,0,0,0,,Э~?
Dialogue: 0,0:18:46.79,0:18:46.87,Default,,0,0,0,,Э~?
Dialogue: 0,0:18:46.87,0:18:47.87,Default,,0,0,0,,Э~?
Dialogue: 0,0:18:46.87,0:18:47.87,Default,,0,0,0,,Бұрынғыдай
Dialogue: 0,0:18:47.96,0:18:50.79,Default,,0,0,0,,Примуланың жұмысына көмектессеңіз.
Dialogue: 0,0:18:50.87,0:18:53.29,Default,,0,0,0,,Жоқ, мен үлкен үміт күттім.
Dialogue: 0,0:18:53.38,0:18:54.55,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:18:55.84,0:18:57.01,Default,,0,0,0,,Уф, айналаңа абай бол.
Dialogue: 0,0:18:57.09,0:18:59.93,Default,,0,0,0,,Қыздың бөлмесіне келсең де, ештеңе істемей кетіп қалдың ба?
Dialogue: 0,0:18:59.93,0:19:00.76,Default,,0,0,0,,Қыздың бөлмесіне келсең де, ештеңе істемей кетіп қалдың ба?
Dialogue: 0,0:18:59.93,0:19:00.76,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:00.84,0:19:04.05,Default,,0,0,0,,Шах! Егер сіз кеш болды деп ойласаңыз, не істеп жатырсыз?
Dialogue: 0,0:19:04.14,0:19:07.02,Default,,0,0,0,,Бұл не? Маған тапсырсаң жақсы емес пе?
Dialogue: 0,0:19:07.10,0:19:08.98,Default,,0,0,0,,Күйеуім, сені әрқашан жақсы көресің, солай ма?
Dialogue: 0,0:19:09.06,0:19:10.56,Default,,0,0,0,,Үйге қош келдіңіз!
Dialogue: 0,0:19:10.64,0:19:12.35,Default,,0,0,0,,Бұл жігіттер...
Dialogue: 0,0:19:14.23,0:19:15.98,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:19:16.07,0:19:18.65,Default,,0,0,0,,Primula дүкені тұрақты түрде кеңейіп келеді
Dialogue: 0,0:19:18.74,0:19:21.16,Default,,0,0,0,,Дүкен атауы – «Corolla-tei»
Dialogue: 0,0:19:21.24,0:19:23.57,Default,,0,0,0,,Біз де жаңа адамдарды жұмысқа алдық.
Dialogue: 0,0:19:23.66,0:19:26.03,Default,,0,0,0,,Бұл жас ханымның әкесі.
Dialogue: 0,0:19:26.12,0:19:29.04,Default,,0,0,0,,Танысқаныма қуаныштымын, менің атым Айрис.
Dialogue: 0,0:19:29.87,0:19:31.79,Default,,0,0,0,,Бұл менің күйеуім.
Dialogue: 0,0:19:31.87,0:19:32.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:32.92,0:19:34.46,Default,,0,0,0,,Бұл менің күйеуім.
Dialogue: 0,0:19:34.54,0:19:36.84,Default,,0,0,0,,Ас әзірлеуді және бизнесті үйренсін.
Dialogue: 0,0:19:36.92,0:19:39.05,Default,,0,0,0,,Филиал ашу
Dialogue: 0,0:19:39.13,0:19:42.76,Default,,0,0,0,,Төтенше жағдайда сіз жай ғана дүкенді ажырата аласыз.
Dialogue: 0,0:19:42.84,0:19:44.68,Default,,0,0,0,,Кеничи қайтадан қашып кетсе де
Dialogue: 0,0:19:44.76,0:19:47.35,Default,,0,0,0,,Уайымдама, біз сені бірден қуамыз.
Dialogue: 0,0:19:47.43,0:19:49.52,Default,,0,0,0,,Мен саған мүлде сенбеймін...
Dialogue: 0,0:19:49.60,0:19:50.43,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:19:51.10,0:19:52.44,Default,,0,0,0,,Әрі қарай уақыт өтеді
Dialogue: 0,0:19:52.52,0:19:55.73,Default,,0,0,0,,Өндірілетін родониттің жалпы бағаланған құны тең
Dialogue: 0,0:19:55.81,0:19:58.19,Default,,0,0,0,,Ол 15 миллион иеннен сәл астамға жетті.
Dialogue: 0,0:19:58.90,0:20:03.16,Default,,0,0,0,,Жартастағы орман – анемондар емдік шөптер жинайтын жер.
Dialogue: 0,0:20:03.24,0:20:06.74,Default,,0,0,0,,Ол Майаре мен Нямена үшін жақсы аң аулайтын жер ретінде қызмет етеді.
Dialogue: 0,0:20:07.78,0:20:10.16,Default,,0,0,0,,Және Corolla-tei
Dialogue: 0,0:20:10.25,0:20:15.08,Default,,0,0,0,,Мен қаладағы шағын қойманы жалға алып, сол жерде өнім дайындай бастадым.
Dialogue: 0,0:20:15.17,0:20:16.63,Default,,0,0,0,,Йенге түрлендіру
Dialogue: 0,0:20:16.71,0:20:20.01,Default,,0,0,0,,Күнделікті 150 000 иеннен 200 000 иенге дейін сату
Dialogue: 0,0:20:20.09,0:20:23.30,Default,,0,0,0,,Жылдық сатылым 70 миллион иенден асады
Dialogue: 0,0:20:23.38,0:20:24.18,Default,,0,0,0,,Бұл сөреде...
Dialogue: 0,0:20:24.18,0:20:25.93,Default,,0,0,0,,Бұл сөреде...
Dialogue: 0,0:20:24.18,0:20:25.93,Default,,0,0,0,,Сонымен қатар, Айрис бас менеджер және жаттықтырушы болып тағайындалды және барлық қызметкерлерді жинады.
Dialogue: 0,0:20:25.93,0:20:26.89,Default,,0,0,0,,Сонымен қатар, Айрис бас менеджер және жаттықтырушы болып тағайындалды және барлық қызметкерлерді жинады.
Dialogue: 0,0:20:26.89,0:20:29.18,Default,,0,0,0,,Сонымен қатар, Айрис бас менеджер және жаттықтырушы болып тағайындалды және барлық қызметкерлерді жинады.
Dialogue: 0,0:20:26.89,0:20:29.18,Default,,0,0,0,,Маған пакетті беріңізші.
Dialogue: 0,0:20:29.26,0:20:30.39,Default,,0,0,0,,Біз екі филиал аштық.
Dialogue: 0,0:20:30.39,0:20:31.31,Default,,0,0,0,,Біз екі филиал аштық.
Dialogue: 0,0:20:30.39,0:20:31.31,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:31.31,0:20:31.39,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:31.39,0:20:32.06,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:31.39,0:20:32.06,Default,,0,0,0,,Топтың жылдық сатылымы 200 миллион иенге жақындады.
Dialogue: 0,0:20:32.06,0:20:34.44,Default,,0,0,0,,Топтың жылдық сатылымы 200 миллион иенге жақындады.
Dialogue: 0,0:20:34.52,0:20:36.94,Default,,0,0,0,,Бұл нағыз саудагердің күші ме?
Dialogue: 0,0:20:37.02,0:20:40.40,Default,,0,0,0,,Мен сияқты саудагерден бөлек.
Dialogue: 0,0:20:40.94,0:20:43.90,Default,,0,0,0,,Өтен Маллоудың қызынан күткендей.
Dialogue: 0,0:20:43.99,0:20:46.87,Default,,0,0,0,,Тек Кеничи мені сахнаға шығарса.
Dialogue: 0,0:20:46.95,0:20:51.25,Default,,0,0,0,,Егер сіз мұны нөлден орындауға тырыссаңыз, бұл үлкен ерлік болмас еді.
Dialogue: 0,0:20:51.33,0:20:54.25,Default,,0,0,0,,Шынында да, Королла-тейдегі тағам
Dialogue: 0,0:20:54.33,0:20:57.25,Default,,0,0,0,,Құрамында мен Shangri-La-дан сатып алған сорпа бар.
Dialogue: 0,0:20:58.00,0:21:00.13,Default,,0,0,0,,Бастапқы дүниенің құдіреті зор.
Dialogue: 0,0:21:00.84,0:21:04.30,Default,,0,0,0,,Мен бәрі бірқалыпты болады деп үміттенемін...
Dialogue: 0,0:21:17.15,0:21:21.32,Default,,0,0,0,,Ана, бұл кісі инспектор болған сияқты.
Dialogue: 0,0:21:21.40,0:21:22.78,Default,,0,0,0,,Лилит?
Dialogue: 0,0:21:22.86,0:21:26.78,Default,,0,0,0,,Далияда ұя салып жатқан қарақшылардың бағындырылғаны туралы хабар бар.
Dialogue: 0,0:21:26.86,0:21:28.74,Default,,0,0,0,,Бұл Макото ма?
Dialogue: 0,0:21:28.82,0:21:30.12,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:30.20,0:21:32.33,Default,,0,0,0,,Темір шақырылған аңды қандай да бір жолмен басқару —
Dialogue: 0,0:21:32.41,0:21:35.41,Default,,0,0,0,,Оны сиқыршы жасаған деп хабарланды.
Dialogue: 0,0:21:35.50,0:21:38.92,Default,,0,0,0,,Бұл патшаға қарсы фракцияға да зиян тигізеді.
Dialogue: 0,0:21:39.00,0:21:42.55,Default,,0,0,0,,Бірақ темір шақырған аң... ол кім?
Dialogue: 0,0:21:42.63,0:21:44.21,Default,,0,0,0,,Енді...
Dialogue: 0,0:21:44.30,0:21:46.97,Default,,0,0,0,,Бірақ шебер қазір
Dialogue: 0,0:21:47.05,0:21:50.30,Default,,0,0,0,,Ол Астрантияның жанында қоныстанған сияқты.
Dialogue: 0,0:21:50.39,0:21:52.93,Default,,0,0,0,,Астрантияда!
Dialogue: 0,0:21:53.02,0:21:55.31,Default,,0,0,0,,Бұл қызықты сәйкестік.
Dialogue: 0,0:21:55.39,0:21:57.52,Default,,0,0,0,,Хехехе…
Dialogue: 0,0:21:57.60,0:22:00.06,Default,,0,0,0,,Бәлкім, бұл рухтың жетелеуі болар.
Dialogue: 0,0:22:00.15,0:22:04.15,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:22:05.99,0:22:09.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:32.24,0:23:35.91,Default,,0,0,0,,～♪
