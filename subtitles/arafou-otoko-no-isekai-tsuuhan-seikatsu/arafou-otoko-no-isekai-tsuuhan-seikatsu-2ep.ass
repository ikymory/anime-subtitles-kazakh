Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:16.05,0:00:18.68,Default,,0,0,0,,Бұл алмаз немесе кристал емес.
Dialogue: 0,0:00:18.76,0:00:20.85,Default,,0,0,0,,Тіпті циркония және кесілген шыны
Dialogue: 0,0:00:20.93,0:00:22.14,Default,,0,0,0,,Бұл дүниеде, қалай болса солай
Dialogue: 0,0:00:22.23,0:00:23.64,Default,,0,0,0,,Оған тұрарлық болуы керек
Dialogue: 0,0:00:23.73,0:00:26.35,Default,,0,0,0,,Әйелдің жүрегін сәтті жаулап алсаңыз
Dialogue: 0,0:00:26.44,0:00:27.94,Default,,0,0,0,,Мен қуаныштымын...
Dialogue: 0,0:00:28.02,0:00:29.11,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:00:29.19,0:00:32.15,Default,,0,0,0,,Сіз әлі де жақсы тамақ сатып алып жатырсыз.
Dialogue: 0,0:00:32.24,0:00:33.95,Default,,0,0,0,,Сіздің жеткізушілеріңіз қайда?
Dialogue: 0,0:00:34.03,0:00:36.49,Default,,0,0,0,,Хахаха... бұл коммерциялық құпия.
Dialogue: 0,0:00:36.57,0:00:37.91,Default,,0,0,0,,Я...
Dialogue: 0,0:00:37.99,0:00:39.28,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:00:39.37,0:00:40.74,Default,,0,0,0,,А... қош келдіңіз.
Dialogue: 0,0:00:40.83,0:00:43.16,Default,,0,0,0,,Мына қызметші де кеше...
Dialogue: 0,0:00:43.25,0:00:45.25,Default,,0,0,0,,Киім түйреуіштер
Dialogue: 0,0:00:45.33,0:00:47.33,Default,,0,0,0,,Иә Жасың нешеде?
Dialogue: 0,0:00:47.42,0:00:48.63,Default,,0,0,0,,100 дана
Dialogue: 0,0:00:48.71,0:00:49.96,Default,,0,0,0,,100 дана?
Dialogue: 0,0:00:50.05,0:00:50.88,Default,,0,0,0,,Иә
Dialogue: 0,0:00:50.96,0:00:52.92,Default,,0,0,0,,100 дана...
Dialogue: 0,0:00:53.01,0:00:56.13,Default,,0,0,0,,20 мыс тиын немесе 4 күміс монета.
Dialogue: 0,0:00:56.22,0:00:58.14,Default,,0,0,0,,Мен ақшаны сақтап қойдым.
Dialogue: 0,0:00:58.97,0:01:00.18,Default,,0,0,0,,Майдо бар
Dialogue: 0,0:01:06.98,0:01:07.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:07.90,0:01:09.81,Default,,0,0,0,,Оны алып, қарап шығуға болады.
Dialogue: 0,0:01:09.90,0:01:11.27,Default,,0,0,0,,Енді кешіріңіз.
Dialogue: 0,0:01:11.36,0:01:13.78,Default,,0,0,0,,Бұл гауһар тас па?
Dialogue: 0,0:01:13.86,0:01:15.32,Default,,0,0,0,,Бұл жылтыратылған шыны.
Dialogue: 0,0:01:15.40,0:01:16.65,Default,,0,0,0,,Шыны…
Dialogue: 0,0:01:16.74,0:01:19.16,Default,,0,0,0,,Бұл шын мәнінде циркония, бірақ...
Dialogue: 0,0:01:19.24,0:01:21.83,Default,,0,0,0,,Бағасы 6 кішкентай шаршы күміс монета.
Dialogue: 0,0:01:21.91,0:01:23.87,Default,,0,0,0,,Әлі де арзан
Dialogue: 0,0:01:23.95,0:01:26.71,Default,,0,0,0,,Егер сізге ұнаса, сіз оны сақтай аласыз.
Dialogue: 0,0:01:26.79,0:01:28.42,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:01:28.50,0:01:29.96,Default,,0,0,0,,Майдо бар
Dialogue: 0,0:01:31.00,0:01:33.30,Default,,0,0,0,,Менің атым Кеничи
Dialogue: 0,0:01:33.38,0:01:35.97,Default,,0,0,0,,Жасым 40-қа таяп қалды, мен кенет басқа әлемге келдім.
Dialogue: 0,0:01:36.05,0:01:37.51,Default,,0,0,0,,Қандай да бір себептермен үлкен онлайн сауда сайты—
Dialogue: 0,0:01:37.59,0:01:39.39,Default,,0,0,0,,Мен Шангри-Ладан сауда жасай аламын.
Dialogue: 0,0:01:39.47,0:01:43.68,Default,,0,0,0,,Осы басқа әлемде баяу өмір сүруді мақсат ету үшін осы қабілетті пайдаланыңыз
Dialogue: 0,0:01:43.77,0:01:47.94,Default,,0,0,0,,Жүр, мен аман қала аламын ба?
Dialogue: 0,0:01:48.52,0:01:52.40,Default,,0,0,0,,♪～
Dialogue: 0,0:03:11.85,0:03:16.44,Default,,0,0,0,,～♪
Dialogue: 0,0:03:18.65,0:03:19.65,Default,,0,0,0,,Иә
Dialogue: 0,0:03:20.15,0:03:21.15,Default,,0,0,0,,Мен шын мәнінде айта алмаймын.
Dialogue: 0,0:03:21.86,0:03:23.07,Default,,0,0,0,,Киім түйреуіштері…
Dialogue: 0,0:03:23.95,0:03:24.78,Default,,0,0,0,,Иә
Dialogue: 0,0:03:24.87,0:03:25.91,Default,,0,0,0,,Мұнда
Dialogue: 0,0:03:29.00,0:03:30.50,Default,,0,0,0,,Ал...
Dialogue: 0,0:03:30.58,0:03:31.41,Default,,0,0,0,,Ммм
Dialogue: 0,0:03:31.50,0:03:32.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:33.00,0:03:35.67,Default,,0,0,0,,Кешегі аңдар?
Dialogue: 0,0:03:35.75,0:03:37.46,Default,,0,0,0,,Шағым?
Dialogue: 0,0:03:37.55,0:03:38.50,Default,,0,0,0,,(Мяренің иіскеу дыбысы)
Dialogue: 0,0:03:38.59,0:03:39.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:39.51,0:03:42.38,Default,,0,0,0,,Өйткені, дәмдеуіштердің иісі бар.
Dialogue: 0,0:03:42.47,0:03:43.55,Default,,0,0,0,,Иә
Dialogue: 0,0:03:43.64,0:03:47.10,Default,,0,0,0,,Өтінемін! Сізге дәмдеуіштер сатуымызды қалайсыз.
Dialogue: 0,0:03:47.18,0:03:48.60,Default,,0,0,0,,ше? Не айтқың келеді?
Dialogue: 0,0:03:48.68,0:03:49.85,Default,,0,0,0,,Идиот
Dialogue: 0,0:03:49.93,0:03:52.02,Default,,0,0,0,,Сізде дәмдеуіштер бар, солай ма?
Dialogue: 0,0:03:52.10,0:03:53.48,Default,,0,0,0,,Майаре айтты
Dialogue: 0,0:03:53.56,0:03:56.23,Default,,0,0,0,,Сіз дәмдеуіштердің иісіне ұқсайсыз.
Dialogue: 0,0:03:56.31,0:03:59.90,Default,,0,0,0,,Мен мүмкін емес деп отырғаным жоқ, себебі мен сені жаңа деп ойладым.
Dialogue: 0,0:03:59.98,0:04:02.82,Default,,0,0,0,,Егер Бакопа көзіңізге түссе, сіз қиындыққа тап боласыз.
Dialogue: 0,0:04:02.90,0:04:05.41,Default,,0,0,0,,Уф… Спайс синдикаты
Dialogue: 0,0:04:05.49,0:04:08.24,Default,,0,0,0,,Ах, Бакопа, Зоотерра және т.б.
Dialogue: 0,0:04:08.33,0:04:09.54,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:04:09.62,0:04:11.33,Default,,0,0,0,,Онда... сонда.
Dialogue: 0,0:04:11.41,0:04:12.91,Default,,0,0,0,,Әйтеуір~!
Dialogue: 0,0:04:11.41,0:04:12.91,Default,,0,0,0,,Әйтеуір!
Dialogue: 0,0:04:13.00,0:04:14.58,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,0:04:14.67,0:04:16.54,Default,,0,0,0,,Мүмкін емес пе?
Dialogue: 0,0:04:16.63,0:04:17.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:17.54,0:04:19.63,Default,,0,0,0,,Бұл мүмкін емес деп айтуға болмайды.
Dialogue: 0,0:04:19.71,0:04:23.09,Default,,0,0,0,,Менің жаңа күйеуімнің де өз өмірі бар...
Dialogue: 0,0:04:23.17,0:04:25.55,Default,,0,0,0,,Бакопаға қарсы шығасыз ба?
Dialogue: 0,0:04:25.64,0:04:28.30,Default,,0,0,0,,Айуандардың жан азығы болса да.
Dialogue: 0,0:04:28.39,0:04:31.22,Default,,0,0,0,,Ұзын киімге оранба.
Dialogue: 0,0:04:32.31,0:04:34.19,Default,,0,0,0,,Дәмдеуіштерді сатуға болмайды, бірақ
Dialogue: 0,0:04:34.27,0:04:38.06,Default,,0,0,0,,Дәмдеуіштер қолданылған тағам сатып алсаңыз, жарайды деп ойлаймын.
Dialogue: 0,0:04:38.15,0:04:39.11,Default,,0,0,0,,Иә
Dialogue: 0,0:04:39.19,0:04:40.86,Default,,0,0,0,,Бірақ тек бір рет.
Dialogue: 0,0:04:40.94,0:04:44.11,Default,,0,0,0,,Қала сыртында өзен жағасы бар шығар. Онда тамақтанайық.
Dialogue: 0,0:04:44.20,0:04:45.91,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:04:45.99,0:04:48.16,Default,,0,0,0,,Сіз маған қосылғыңыз келе ме?
Dialogue: 0,0:04:48.24,0:04:49.12,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:04:49.20,0:04:51.37,Default,,0,0,0,,Егер сіз мұны шешсеңіз, бұл бос уақыт!
Dialogue: 0,0:04:51.45,0:04:52.29,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:52.37,0:04:54.04,Default,,0,0,0,,-А... эй! - А?
Dialogue: 0,0:04:54.12,0:04:55.12,Default,,0,0,0,,Сақтау
Dialogue: 0,0:04:55.21,0:04:57.04,Default,,0,0,0,,Ұшу барысы мияу~
Dialogue: 0,0:04:57.13,0:04:57.96,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:04:58.04,0:05:01.38,Default,,0,0,0,,(Кеничи мен Анаманың айқайы)
Dialogue: 0,0:05:13.43,0:05:15.81,Default,,0,0,0,,Енді тамақ дайындауды бастайық.
Dialogue: 0,0:05:15.89,0:05:16.89,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:05:16.98,0:05:18.31,Default,,0,0,0,,Енді мына көкөністі кесіңіз.
Dialogue: 0,0:05:18.40,0:05:19.27,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:20.27,0:05:24.49,Default,,0,0,0,,Бұл түс... бұл шынымен көкөніс пе?
Dialogue: 0,0:05:24.57,0:05:27.16,Default,,0,0,0,,Аа, шетелдік екен, дәмді екен.
Dialogue: 0,0:05:27.24,0:05:28.91,Default,,0,0,0,,Хехе... Ио!
Dialogue: 0,0:05:29.99,0:05:31.41,Default,,0,0,0,,-(Мяре) Мяу~ -Ох~
Dialogue: 0,0:05:35.75,0:05:37.42,Default,,0,0,0,,Няфуфу~
Dialogue: 0,0:05:38.21,0:05:39.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:39.63,0:05:41.29,Default,,0,0,0,,Фуха~
Dialogue: 0,0:05:41.38,0:05:43.30,Default,,0,0,0,,Мияу, мияу, иісі жақсы!
Dialogue: 0,0:05:43.38,0:05:45.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:45.88,0:05:46.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:46.88,0:05:48.55,Default,,0,0,0,,Не болды!
Dialogue: 0,0:05:48.63,0:05:50.68,Default,,0,0,0,,Мен мұндай дәмді нәрсені бірінші рет жеп отырмын.
Dialogue: 0,0:05:50.76,0:05:53.18,Default,,0,0,0,,Мияу! Қыжылдап жатыр
Dialogue: 0,0:05:53.26,0:05:55.43,Default,,0,0,0,,Нан да, сорпа да дәмді!
Dialogue: 0,0:05:55.52,0:05:58.48,Default,,0,0,0,,Ал күміс қасықпен тамақ ішу
Dialogue: 0,0:05:58.56,0:06:00.52,Default,,0,0,0,,Сіз асыл адамға ұқсайсыз.
Dialogue: 0,0:06:00.61,0:06:02.82,Default,,0,0,0,,Бұл тот баспайтын болаттан жасалған.
Dialogue: 0,0:06:02.90,0:06:06.24,Default,,0,0,0,,Осындай дәмді тағамды жеу ішімдік ішуге құштарлық тудырады.
Dialogue: 0,0:06:06.32,0:06:08.61,Default,,0,0,0,,-Не болды?-(Нянджи) Мен мұны қалаймын.
Dialogue: 0,0:06:08.70,0:06:10.95,Default,,0,0,0,,Біраз уақыт ұстап тұру керек.
Dialogue: 0,0:06:11.03,0:06:12.20,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:06:12.28,0:06:14.20,Default,,0,0,0,,Маған бұл өте ұнайды.
Dialogue: 0,0:06:14.29,0:06:15.66,Default,,0,0,0,,Мұны да ішіңіз.
Dialogue: 0,0:06:15.75,0:06:17.00,Default,,0,0,0,,Құдай-ай, неге қыздар дәретханасында граффити жазып жүрсің өзің?!
Dialogue: 0,0:06:17.08,0:06:19.37,Default,,0,0,0,,Бұл жерде ішіп-жеу туралы ештеңе айтудың қажеті жоқ.
Dialogue: 0,0:06:19.46,0:06:20.46,Default,,0,0,0,,Ол сонда—сол жақта~
Dialogue: 0,0:06:20.54,0:06:22.46,Default,,0,0,0,,- Эй - (Нянджи) Эй, эй
Dialogue: 0,0:06:22.54,0:06:24.13,Default,,0,0,0,,Күйеу, адамдар тым жақсы емес пе?
Dialogue: 0,0:06:24.13,0:06:26.92,Default,,0,0,0,,Күйеу, адамдар тым жақсы емес пе?
Dialogue: 0,0:06:24.13,0:06:26.92,Default,,0,0,0,,(Ауандардың шуы)
Dialogue: 0,0:06:26.92,0:06:27.01,Default,,0,0,0,,(Ауандардың шуы)
Dialogue: 0,0:06:27.01,0:06:28.13,Default,,0,0,0,,(Ауандардың шуы)
Dialogue: 0,0:06:27.01,0:06:28.13,Default,,0,0,0,,Хахаха... Жақсы емес пе?
Dialogue: 0,0:06:28.13,0:06:29.22,Default,,0,0,0,,Хахаха... Жақсы емес пе?
Dialogue: 0,0:06:29.30,0:06:32.10,Default,,0,0,0,,Шындықты бір сәт ұмытсаң да
Dialogue: 0,0:06:35.47,0:06:37.56,Default,,0,0,0,,Аты... Майаре болды ма?
Dialogue: 0,0:06:37.64,0:06:38.77,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:38.85,0:06:40.10,Default,,0,0,0,,Мен Кеничимін
Dialogue: 0,0:06:40.19,0:06:41.60,Default,,0,0,0,,Мен Някеромын
Dialogue: 0,0:06:41.69,0:06:43.11,Default,,0,0,0,,Бұл Нярумеро.
Dialogue: 0,0:06:43.19,0:06:44.48,Default,,0,0,0,,Няндзису
Dialogue: 0,0:06:44.57,0:06:45.98,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:06:46.07,0:06:47.28,Default,,0,0,0,,Пухаа
Dialogue: 0,0:06:47.36,0:06:49.49,Default,,0,0,0,,Кеничи танысқаныма қуаныштымын
Dialogue: 0,0:06:52.78,0:06:54.62,Default,,0,0,0,,(суға секіру дыбысы)
Dialogue: 0,0:06:54.70,0:06:56.33,Default,,0,0,0,,Няфу~!
Dialogue: 0,0:06:56.41,0:06:58.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:58.20,0:06:59.62,Default,,0,0,0,,(Айуандардың күлкісі)
Dialogue: 0,0:07:00.83,0:07:01.87,Default,,0,0,0,,Мияу!
Dialogue: 0,0:07:02.75,0:07:04.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:07.21,0:07:08.88,Default,,0,0,0,,Нфу~
Dialogue: 0,0:07:08.97,0:07:11.01,Default,,0,0,0,,(Ауандардың ұйықтауы)
Dialogue: 0,0:07:13.80,0:07:14.89,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:07:18.81,0:07:22.31,Default,,0,0,0,,Ғажайып... Құлаған жұлдыздай.
Dialogue: 0,0:07:25.06,0:07:26.15,Default,,0,0,0,,Таңертең қайту?
Dialogue: 0,0:07:26.82,0:07:29.40,Default,,0,0,0,,Ештеңе етпейді, өйткені мен тұру үшін ақша алып жатырмын.
Dialogue: 0,0:07:29.49,0:07:32.86,Default,,0,0,0,,Мен қала сыртында аңдармен ойнадым.
Dialogue: 0,0:07:32.95,0:07:35.20,Default,,0,0,0,,Мен аң терісінен жасалған әйелмен ойнағым келеді.
Dialogue: 0,0:07:35.28,0:07:37.37,Default,,0,0,0,,Менімен ойна.
Dialogue: 0,0:07:37.45,0:07:39.91,Default,,0,0,0,,Тек әйелдер ше?
Dialogue: 0,0:07:42.00,0:07:44.00,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:07:44.63,0:07:45.84,Default,,0,0,0,,Шақыру
Dialogue: 0,0:07:45.92,0:07:47.71,Default,,0,0,0,,Сен мені жек көрдің бе?
Dialogue: 0,0:07:47.80,0:07:49.63,Default,,0,0,0,,Жарайды, мен баяу өмірді мақсат етіп отырмын.
Dialogue: 0,0:07:49.71,0:07:51.51,Default,,0,0,0,,Маған әйел керек емес.
Dialogue: 0,0:07:52.13,0:07:54.64,Default,,0,0,0,,Маргарет Бұл дүкен ме?
Dialogue: 0,0:07:54.72,0:07:56.80,Default,,0,0,0,,Иә, жас ханым.
Dialogue: 0,0:08:00.89,0:08:02.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:11.74,0:08:12.57,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:16.16,0:08:17.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:17.41,0:08:20.29,Default,,0,0,0,,Артында қалдырған затыңызды алуға келдіңіз бе?
Dialogue: 0,0:08:21.00,0:08:21.83,Default,,0,0,0,,Иә
Dialogue: 0,0:08:21.91,0:08:23.08,Default,,0,0,0,,Мұнда
Dialogue: 0,0:08:23.16,0:08:24.83,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:25.96,0:08:27.46,Default,,0,0,0,,Ханым, мынаны алыңыз
Dialogue: 0,0:08:28.79,0:08:31.34,Default,,0,0,0,,Бұл шыны...
Dialogue: 0,0:08:36.55,0:08:39.81,Default,,0,0,0,,Бұл шынымен гауһар емес пе?
Dialogue: 0,0:08:39.89,0:08:42.10,Default,,0,0,0,,Иә, бұл жылтыратылған шыны.
Dialogue: 0,0:08:42.85,0:08:44.69,Default,,0,0,0,,Бұл сізде бар жалғыз өнім ме?
Dialogue: 0,0:08:44.77,0:08:47.52,Default,,0,0,0,,Басқалар болса, маған көрсетіңізші.
Dialogue: 0,0:08:47.61,0:08:48.86,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:50.90,0:08:52.61,Default,,0,0,0,,Элемент қорабы...
Dialogue: 0,0:08:52.69,0:08:54.20,Default,,0,0,0,,Қош бол
Dialogue: 0,0:08:54.28,0:08:58.20,Default,,0,0,0,,Негізі ол Шангри-Ладан жіберілген.
Dialogue: 0,0:09:00.53,0:09:03.66,Default,,0,0,0,,Иесі, менің сізден сұрайын дегенім бар.
Dialogue: 0,0:09:03.75,0:09:05.21,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:09:05.29,0:09:09.46,Default,,0,0,0,,Менің атым Примула, мен Marrow & Co компаниясының қызымын.
Dialogue: 0,0:09:09.54,0:09:11.46,Default,,0,0,0,,Әдепті болыңыз.
Dialogue: 0,0:09:11.55,0:09:13.97,Default,,0,0,0,,Кенеттен болғаны үшін кешіріңіз.
Dialogue: 0,0:09:14.05,0:09:17.64,Default,,0,0,0,,Сіз менің әкемді менің компаниямнан кездестіре аласыз ба?
Dialogue: 0,0:09:17.72,0:09:20.14,Default,,0,0,0,,Ол Мэллоудың қызы ғой.
Dialogue: 0,0:09:20.22,0:09:21.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:21.22,0:09:22.97,Default,,0,0,0,,Бұл үлкен далия дүкені.
Dialogue: 0,0:09:23.06,0:09:27.10,Default,,0,0,0,,Компания президенті Мару мырзаның мінезі керемет және оны көптеген адамдар таңдайды.
Dialogue: 0,0:09:27.19,0:09:29.61,Default,,0,0,0,,Ірі дүкендермен байланыс...
Dialogue: 0,0:09:29.69,0:09:31.65,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:09:31.73,0:09:34.86,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:09:35.44,0:09:39.78,Default,,0,0,0,,Ой... мен мұндай керемет күймеге бірінші рет мініп отырмын.
Dialogue: 0,0:09:39.87,0:09:43.66,Default,,0,0,0,,Хохохо... Асыл арбалар одан да сәнді.
Dialogue: 0,0:09:43.74,0:09:45.12,Default,,0,0,0,,Содан соң…
Dialogue: 0,0:09:48.96,0:09:53.38,Default,,0,0,0,,Негізі менде прототип жасайтын бір шеберім бар еді.
Dialogue: 0,0:09:53.88,0:09:56.38,Default,,0,0,0,,Металды қайта шығару мүмкін емес...
Dialogue: 0,0:09:56.47,0:09:58.88,Default,,0,0,0,,Бір қарағанда қарапайым болып көрінеді, бірақ
Dialogue: 0,0:09:58.97,0:10:02.89,Default,,0,0,0,,Оны жасау үшін озық технология қажет сияқты.
Dialogue: 0,0:10:02.97,0:10:06.48,Default,,0,0,0,,Шеберім де солай айтты.
Dialogue: 0,0:10:06.56,0:10:07.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:07.35,0:10:07.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:07.35,0:10:07.64,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,0:10:07.64,0:10:08.14,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,0:10:08.14,0:10:08.77,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,0:10:08.14,0:10:08.77,Default,,0,0,0,,Біз келген сияқтымыз
Dialogue: 0,0:10:08.77,0:10:09.40,Default,,0,0,0,,Біз келген сияқтымыз
Dialogue: 0,0:10:11.73,0:10:13.36,Default,,0,0,0,,Қандай тамаша...
Dialogue: 0,0:10:13.44,0:10:17.19,Default,,0,0,0,,Дворянның сарайымен салыстырғанда кішкентай.
Dialogue: 0,0:10:17.28,0:10:20.16,Default,,0,0,0,,Аристократтар? Бұл бөлек қоғам.
Dialogue: 0,0:10:27.66,0:10:29.92,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:10:30.00,0:10:32.96,Default,,0,0,0,,Бұл Marrow & Co.
Dialogue: 0,0:10:33.04,0:10:34.55,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:10:34.63,0:10:37.17,Default,,0,0,0,,Бір қыздың шақыруымен өмірден өттім.
Dialogue: 0,0:10:37.26,0:10:38.84,Default,,0,0,0,,Менің атым Кеничи.
Dialogue: 0,0:10:38.92,0:10:40.22,Default,,0,0,0,,Ескерту
Dialogue: 0,0:10:40.30,0:10:41.68,Default,,0,0,0,,Біз Мемлекеттік қауіпсіздік басқармасынан келдік.
Dialogue: 0,0:10:41.76,0:10:43.85,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:10:43.93,0:10:44.97,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:10:46.97,0:10:49.19,Default,,0,0,0,,Хохо~
Dialogue: 0,0:10:52.10,0:10:53.40,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:10:53.48,0:10:54.86,Default,,0,0,0,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,0:10:55.73,0:10:59.03,Default,,0,0,0,,Сізде зат қорабы бар сияқты.
Dialogue: 0,0:10:59.11,0:11:01.95,Default,,0,0,0,,Иә, кішкентай болса да.
Dialogue: 0,0:11:02.03,0:11:04.12,Default,,0,0,0,,Негізі мен де...
Dialogue: 0,0:11:05.79,0:11:06.62,Default,,0,0,0,,О...
Dialogue: 0,0:11:06.70,0:11:09.62,Default,,0,0,0,,Мен бұл элементті қолданамын
Dialogue: 0,0:11:09.71,0:11:12.38,Default,,0,0,0,,Біз компанияны осы дәрежеде өсірдік.
Dialogue: 0,0:11:12.46,0:11:14.67,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:11:14.75,0:11:18.59,Default,,0,0,0,,Мен және басқалары оны тек ауыл шаруашылығы өнімдерін сақтау үшін пайдаланған.
Dialogue: 0,0:11:18.67,0:11:20.63,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:11:20.72,0:11:23.64,Default,,0,0,0,,(Кеничи мен оның достарының күлкісі)
Dialogue: 0,0:11:23.72,0:11:26.39,Default,,0,0,0,,Сонымен, сіздің бизнесіңіз қандай?
Dialogue: 0,0:11:26.47,0:11:28.89,Default,,0,0,0,,Қысқасы,
Dialogue: 0,0:11:28.97,0:11:32.60,Default,,0,0,0,,Мен өнімді Marrow & Co. компаниясына көтерме сатқым келеді.
Dialogue: 0,0:11:32.69,0:11:33.90,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:33.98,0:11:38.53,Default,,0,0,0,,Дұрыс жерге апарсаңыз, қымбатырақ сатылады...
Dialogue: 0,0:11:38.61,0:11:40.57,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:11:40.65,0:11:43.99,Default,,0,0,0,,Олай болса, менің дүкенімнен арзан бағамен сатып алыңыз.
Dialogue: 0,0:11:44.07,0:11:46.16,Default,,0,0,0,,Оны сол күйінде қайта сату керек емес пе?
Dialogue: 0,0:11:46.24,0:11:47.91,Default,,0,0,0,,Тек... ба...
Dialogue: 0,0:11:47.99,0:11:50.79,Default,,0,0,0,,Бұл туралы естісең не болады?
Dialogue: 0,0:11:50.87,0:11:54.92,Default,,0,0,0,,Хмм, бұл өте жақсы емес.
Dialogue: 0,0:11:55.00,0:11:56.54,Default,,0,0,0,,Сонымен қатар, дәптерге қол тимейінше Шinigami-ді көре алмайсың – онда қалай…
Dialogue: 0,0:11:56.63,0:12:00.42,Default,,0,0,0,,Оның үстіне біздің іскер жауларымыз сізге шабуыл жасап жатыр.
Dialogue: 0,0:12:00.51,0:12:04.05,Default,,0,0,0,,Жақсырақ келісім-шарт алуға тырысуы мүмкін
Dialogue: 0,0:12:04.14,0:12:08.22,Default,,0,0,0,,Басқаша айтқанда, ол бизнес бәсекелестеріне араласуға мүмкіндік береді.
Dialogue: 0,0:12:08.31,0:12:14.06,Default,,0,0,0,,Ал егер екінші тарап эксклюзивті шартқа қол қойса
Dialogue: 0,0:12:14.15,0:12:15.73,Default,,0,0,0,,Мен оны тіпті көре алмаймын
Dialogue: 0,0:12:15.81,0:12:18.82,Default,,0,0,0,,Бұл саудагер жасай алатын ең ақымақтық.
Dialogue: 0,0:12:18.90,0:12:21.40,Default,,0,0,0,,... Ақша табудың бір құпиясы—
Dialogue: 0,0:12:21.40,0:12:22.82,Default,,0,0,0,,... Ақша табудың бір құпиясы —
Dialogue: 0,0:12:21.40,0:12:22.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:22.90,0:12:26.41,Default,,0,0,0,,Тікелей пайда көріп қалмаңыз!
Dialogue: 0,0:12:26.49,0:12:30.41,Default,,0,0,0,,Олай болсаң, үлкен бизнестен құр қаласың.
Dialogue: 0,0:12:30.49,0:12:31.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:33.29,0:12:35.04,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:12:35.12,0:12:37.42,Default,,0,0,0,,Сату бағасын 5-ке көбейту туралы не айтуға болады?
Dialogue: 0,0:12:37.50,0:12:38.79,Default,,0,0,0,,-Иә, жақсы -А, жоқ...
Dialogue: 0,0:12:38.88,0:12:40.96,Default,,0,0,0,,-Шынымен қиын ба... -Әке
Dialogue: 0,0:12:41.05,0:12:42.09,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:42.17,0:12:43.47,Default,,0,0,0,,Мұнда келу қандай да бір қорқынышты іс сияқты…
Dialogue: 0,0:12:43.55,0:12:45.51,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:12:45.59,0:12:46.84,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:12:47.43,0:12:49.05,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:12:49.14,0:12:54.89,Default,,0,0,0,,2000-3000 иенге сатып алған нәрсеңіз жүздеген мың иен тұрады, сондықтан бұл жақсы нәрсе.
Dialogue: 0,0:12:54.98,0:12:57.48,Default,,0,0,0,,... компаниясымен келісім-шарт жасалды.
Dialogue: 0,0:12:58.06,0:12:59.98,Default,,0,0,0,,Алғашқы бірнеше транзакциялар ғана
Dialogue: 0,0:13:00.07,0:13:02.99,Default,,0,0,0,,Менің үлесім 1 миллион иенден асты.
Dialogue: 0,0:13:03.65,0:13:05.86,Default,,0,0,0,,Жақсы, тамаша!
Dialogue: 0,0:13:05.95,0:13:08.24,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:13:08.32,0:13:12.41,Default,,0,0,0,,Әке, мен мұны сатып аламын ба?
Dialogue: 0,0:13:12.50,0:13:15.12,Default,,0,0,0,,Ол шынымен қиналған қыз.
Dialogue: 0,0:13:15.21,0:13:18.50,Default,,0,0,0,,Ал, Кеничи мырза, 10 алтын тиынға.
Dialogue: 0,0:13:18.58,0:13:21.92,Default,,0,0,0,,Мен де бұл дүниеде ақшаның қадірін толық түсіндім.
Dialogue: 0,0:13:22.00,0:13:24.38,Default,,0,0,0,,Сонымен 10 алтын монета...
Dialogue: 0,0:13:25.17,0:13:26.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:26.68,0:13:28.30,Default,,0,0,0,,Бұл жеткіліксіз бе?
Dialogue: 0,0:13:28.39,0:13:30.10,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:13:30.18,0:13:31.64,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:31.72,0:13:32.68,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:13:32.77,0:13:33.64,Default,,0,0,0,,Осылайша—
Dialogue: 0,0:13:34.43,0:13:36.64,Default,,0,0,0,,Шангри-Ла төлемінің сомасы
Dialogue: 0,0:13:36.73,0:13:39.15,Default,,0,0,0,,Аз уақытта сома 3 миллион иенден асты.
Dialogue: 0,0:13:46.99,0:13:51.41,Default,,0,0,0,,Ақшаңыз болған соң, баяу өмір жоспарын бастауға болады.
Dialogue: 0,0:14:10.55,0:14:12.68,Default,,0,0,0,,База осы жерде орналасады.
Dialogue: 0,0:14:13.68,0:14:16.27,Default,,0,0,0,,Орманда тіршілік етеді? Шын айтасың ба?
Dialogue: 0,0:14:16.35,0:14:17.18,Default,,0,0,0,,О
Dialogue: 0,0:14:17.27,0:14:18.69,Default,,0,0,0,,Бұл қауіпті ме?
Dialogue: 0,0:14:19.77,0:14:21.69,Default,,0,0,0,,Мен білемін, бірақ...
Dialogue: 0,0:14:21.77,0:14:24.94,Default,,0,0,0,,Бұл қамал қабырғаларынан онша алыс емес.
Dialogue: 0,0:14:25.03,0:14:27.32,Default,,0,0,0,,Бұл жерде бәрі жақсы.
Dialogue: 0,0:14:27.40,0:14:30.41,Default,,0,0,0,,Кеничи шынымен басқаша.
Dialogue: 0,0:14:30.49,0:14:31.82,Default,,0,0,0,,Хаха…
Dialogue: 0,0:14:32.83,0:14:35.12,Default,,0,0,0,,Бұл жігіт бастапқы әлемде де қолданылған.
Dialogue: 0,0:14:35.20,0:14:36.83,Default,,0,0,0,,Сондықтан мен үйреніп қалғанмын.
Dialogue: 0,0:14:37.83,0:14:39.67,Default,,0,0,0,,Мәселе жанармай.
Dialogue: 0,0:14:40.83,0:14:43.34,Default,,0,0,0,,Мен екі тактілі қолдану үшін аралас бензин сатып алдым.
Dialogue: 0,0:14:43.42,0:14:45.46,Default,,0,0,0,,Өте қымбат
Dialogue: 0,0:14:45.55,0:14:48.97,Default,,0,0,0,,Оны бұл дүниеде сатпайды, сондықтан менің амалым жоқ...
Dialogue: 0,0:14:54.14,0:14:59.35,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:14:59.44,0:15:00.85,Default,,0,0,0,,Пухаа
Dialogue: 0,0:15:00.94,0:15:03.73,Default,,0,0,0,,Қазір жол күзетілді.
Dialogue: 0,0:15:03.81,0:15:05.48,Default,,0,0,0,,Келесі…
Dialogue: 0,0:15:06.57,0:15:09.57,Default,,0,0,0,,(Шынжырлы араның жұмыс дыбысы)
Dialogue: 0,0:15:11.20,0:15:13.62,Default,,0,0,0,,Ағашты кесу керек
Dialogue: 0,0:15:17.87,0:15:19.12,Default,,0,0,0,,Қазір...
Dialogue: 0,0:15:27.71,0:15:31.38,Default,,0,0,0,,(Кеничи ентігу)
Dialogue: 0,0:15:31.47,0:15:34.39,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:15:35.97,0:15:37.14,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:40.39,0:15:41.64,Default,,0,0,0,,О... Әй!
Dialogue: 0,0:15:52.99,0:15:53.78,Default,,0,0,0,,Хаха...
Dialogue: 0,0:15:53.78,0:15:54.45,Default,,0,0,0,,Хаха...
Dialogue: 0,0:15:53.78,0:15:54.45,Default,,0,0,0,,Мен оларды қырдым
Dialogue: 0,0:15:54.45,0:15:55.91,Default,,0,0,0,,Мен оларды қырдым
Dialogue: 0,0:15:58.83,0:16:01.16,Default,,0,0,0,,(ағаш құлаған дыбыс)
Dialogue: 0,0:16:01.25,0:16:05.54,Default,,0,0,0,,(Шынжырлы араның жұмыс дыбысы)
Dialogue: 0,0:16:06.75,0:16:10.42,Default,,0,0,0,,Енді мен мұны істеуім керек.
Dialogue: 0,0:16:10.51,0:16:11.92,Default,,0,0,0,,Сақтау
Dialogue: 0,0:16:13.09,0:16:15.18,Default,,0,0,0,,Оны сақтай алмайсыз ба?
Dialogue: 0,0:16:15.26,0:16:18.31,Default,,0,0,0,,Ол тым үлкен бе? Содан кейін...
Dialogue: 0,0:16:18.39,0:16:19.52,Default,,0,0,0,,Шақыру
Dialogue: 0,0:16:20.02,0:16:23.31,Default,,0,0,0,,(Шынжырлы араның жұмыс дыбысы)
Dialogue: 0,0:16:23.39,0:16:24.85,Default,,0,0,0,,Сақтау
Dialogue: 0,0:16:24.94,0:16:26.15,Default,,0,0,0,,Сақтау
Dialogue: 0,0:16:26.23,0:16:27.56,Default,,0,0,0,,Сақтау
Dialogue: 0,0:16:28.15,0:16:31.19,Default,,0,0,0,,Ұзындығы 10 метр болатын сияқты.
Dialogue: 0,0:16:31.28,0:16:34.36,Default,,0,0,0,,Ұзындығы 10 метр нәрсені сыйғыза алсаңыз, көп нәрсені сыйғыза алмайсыз.
Dialogue: 0,0:16:34.36,0:16:36.07,Default,,0,0,0,,Ұзындығы 10 метр нәрсені сыйғыза алсаңыз, көп нәрсені сыйдыра алмайсыз.
Dialogue: 0,0:16:34.36,0:16:36.07,Default,,0,0,0,,Мен оларды қырдым
Dialogue: 0,0:16:36.57,0:16:37.62,Default,,0,0,0,,Әй!
Dialogue: 0,0:16:38.28,0:16:40.62,Default,,0,0,0,,Қалғаны ертең бе?
Dialogue: 0,0:16:43.21,0:16:45.83,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:16:45.92,0:16:46.83,Default,,0,0,0,,Әй!
Dialogue: 0,0:16:46.92,0:16:51.34,Default,,0,0,0,,(Кеничидің созылған дауысы)
Dialogue: 0,0:16:57.18,0:17:01.22,Default,,0,0,0,,Хаха...
Dialogue: 0,0:17:10.69,0:17:13.28,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:17:13.99,0:17:16.32,Default,,0,0,0,,Тосын шабдалы ағашы бұрыш ағашы
Dialogue: 0,0:17:16.41,0:17:19.62,Default,,0,0,0,,Юкичиге, Хигучиге, князь Шотоку!
Dialogue: 0,0:17:19.70,0:17:22.37,Default,,0,0,0,,Кел, кел, алып меха
Dialogue: 0,0:17:22.45,0:17:24.87,Default,,0,0,0,,Экскаваторға шақыру!
Dialogue: 0,0:17:28.46,0:17:29.88,Default,,0,0,0,,О~
Dialogue: 0,0:17:32.50,0:17:34.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:34.47,0:17:35.88,Default,,0,0,0,,Толассыз жұмыстан шаршадым
Dialogue: 0,0:17:35.97,0:17:39.39,Default,,0,0,0,,Мен жаңа ғана 1,2 миллион иенге экскаватор сатып алдым~
Dialogue: 0,0:17:40.47,0:17:41.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:44.85,0:17:48.77,Default,,0,0,0,,Біраз қолданылған, тоты көрініп тұр.
Dialogue: 0,0:17:48.85,0:17:51.02,Default,,0,0,0,,Енді сіз шаршамайсыз
Dialogue: 0,0:17:51.11,0:17:53.53,Default,,0,0,0,,Экскаватор келе жатыр!
Dialogue: 0,0:17:54.36,0:17:55.53,Default,,0,0,0,,(қозғалтқыштың іске қосу дыбысы)
Dialogue: 0,0:17:55.53,0:17:58.07,Default,,0,0,0,,(қозғалтқыштың іске қосу дыбысы)
Dialogue: 0,0:17:55.53,0:17:58.07,Default,,0,0,0,,Бұл дизельді дыбыс па?
Dialogue: 0,0:17:58.16,0:17:59.03,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:17:59.11,0:18:00.82,Default,,0,0,0,,Ауыр техника туралы айтатын болсақ, бұл дизельдік!
Dialogue: 0,0:18:00.91,0:18:03.62,Default,,0,0,0,,Отын жеңіл май, ақшыл май, жеңіл май...
Dialogue: 0,0:18:03.70,0:18:05.16,Default,,0,0,0,,Оны сатпаңыз
Dialogue: 0,0:18:05.25,0:18:06.71,Default,,0,0,0,,Сіз қоспаларды сатасыз ба?
Dialogue: 0,0:18:06.79,0:18:09.50,Default,,0,0,0,,Егер сізде бұл болса, керосинді жеңіл майға ауыстыруға болады...
Dialogue: 0,0:18:09.58,0:18:11.54,Default,,0,0,0,,Олар да керосин сатпай ма?
Dialogue: 0,0:18:11.63,0:18:13.42,Default,,0,0,0,,(Рюкю) үшінның өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:18:13.50,0:18:17.34,Default,,0,0,0,,Осындай үлкен сатып алудан оңай бас тарта аласыз ба?
Dialogue: 0,0:18:17.88,0:18:18.80,Default,,0,0,0,,Ақ керосин
Dialogue: 0,0:18:18.88,0:18:20.97,Default,,0,0,0,,Олар оны кемпингке керек-жарақ ретінде сатады.
Dialogue: 0,0:18:21.05,0:18:22.85,Default,,0,0,0,,Мұны керосиннің орнына қолдануға болады.
Dialogue: 0,0:18:22.93,0:18:25.31,Default,,0,0,0,,1 литр 1800 иен...
Dialogue: 0,0:18:25.39,0:18:27.60,Default,,0,0,0,,Бұл өте қымбат.
Dialogue: 0,0:18:27.68,0:18:30.31,Default,,0,0,0,,Бұл қымбат, бірақ бұл жалғыз!
Dialogue: 0,0:18:32.15,0:18:33.98,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:18:34.07,0:18:37.78,Default,,0,0,0,,Егер ол осы отынмен жұмыс істемесе, бұл қауіпті...
Dialogue: 0,0:18:37.86,0:18:40.07,Default,,0,0,0,,Ха... Жарайды!
Dialogue: 0,0:18:40.16,0:18:42.41,Default,,0,0,0,,Мен мұны істеуім керек пе?
Dialogue: 0,0:18:43.16,0:18:45.08,Default,,0,0,0,,Иә~ Мен оны оқи алмаймын!
Dialogue: 0,0:18:49.67,0:18:51.08,Default,,0,0,0,,(жұмыс дыбысы)
Dialogue: 0,0:18:51.88,0:18:54.59,Default,,0,0,0,,Ах~ Иә!
Dialogue: 0,0:18:59.38,0:19:00.59,Default,,0,0,0,,О! Бұл әлемдегі бірінші
Dialogue: 0,0:19:00.68,0:19:02.85,Default,,0,0,0,,Электр жарығы!
Dialogue: 0,0:19:03.55,0:19:07.47,Default,,0,0,0,,Мүмкін, бұл кернеудің қатты ауытқып кетуінен шығар, бірақ бұл тұрмыстық техника үшін мүмкін емес.
Dialogue: 0,0:19:07.56,0:19:10.10,Default,,0,0,0,,Ал, сен экскаваторды жылжыта аласың ба?
Dialogue: 0,0:19:13.19,0:19:14.57,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:19:14.65,0:19:17.11,Default,,0,0,0,,Әй, тезірек шомылсам ғой.
Dialogue: 0,0:19:18.28,0:19:22.03,Default,,0,0,0,,Солай болса да, жәндіктер аман қала ма екен?
Dialogue: 0,0:19:22.11,0:19:24.66,Default,,0,0,0,,Мен жәндіктерден қорғайтын сиқырлы тас сатып алуым керек пе?
Dialogue: 0,0:19:25.16,0:19:27.87,Default,,0,0,0,,Оны базар жанындағы құрал-саймандар дүкенінен таба аласыз.
Dialogue: 0,0:19:27.95,0:19:29.20,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:31.46,0:19:33.13,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:19:34.04,0:19:36.13,Default,,0,0,0,,- (Ата) Бірдеңе іздеп жүрсіз бе? -Аа...
Dialogue: 0,0:19:36.88,0:19:39.13,Default,,0,0,0,,Ал... сиқыршы!
Dialogue: 0,0:19:40.30,0:19:43.14,Default,,0,0,0,,Күрсін... Мынау бейтаныс жүз.
Dialogue: 0,0:19:43.22,0:19:45.43,Default,,0,0,0,,Мен базардан дүңгіршек бастадым.
Dialogue: 0,0:19:45.51,0:19:47.64,Default,,0,0,0,,Мен де сол саладамын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:19:47.72,0:19:50.27,Default,,0,0,0,,Эй, сен шетелдіксің бе?
Dialogue: 0,0:19:50.35,0:19:53.69,Default,,0,0,0,,Мен шет елдерден қымбат заттарды сатып аламын.
Dialogue: 0,0:19:53.77,0:19:56.02,Default,,0,0,0,,А... жоқ, мен мұнда сату үшін келген жоқпын.
Dialogue: 0,0:19:56.11,0:19:57.27,Default,,0,0,0,,Мен бірдеңе сатып алуға келдім.
Dialogue: 0,0:19:57.36,0:19:59.44,Default,,0,0,0,,Жәндіктерді итеретін сиқырлы тастар бар ма?
Dialogue: 0,0:19:59.53,0:20:01.95,Default,,0,0,0,,А, үш күміс монета.
Dialogue: 0,0:20:02.03,0:20:04.66,Default,,0,0,0,,Жоғары! Хмм...
Dialogue: 0,0:20:05.49,0:20:07.87,Default,,0,0,0,,Сіз маған жеңілдік бере аласыз ба?
Dialogue: 0,0:20:07.95,0:20:09.41,Default,,0,0,0,,Елімнің жемісі.
Dialogue: 0,0:20:09.49,0:20:12.12,Default,,0,0,0,,Хмм, экзотикалық жеміс?
Dialogue: 0,0:20:12.21,0:20:14.46,Default,,0,0,0,,Мен мұны бұрын ешқашан көрген емеспін
Dialogue: 0,0:20:15.00,0:20:17.04,Default,,0,0,0,,Жарайды, екі күміс монета жақсы.
Dialogue: 0,0:20:17.92,0:20:19.17,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:19.84,0:20:22.88,Default,,0,0,0,,Сол қария көп нәрсені біледі.
Dialogue: 0,0:20:22.97,0:20:25.51,Default,,0,0,0,,Ол Далияның тірі сөздігі сияқты.
Dialogue: 0,0:20:25.59,0:20:27.68,Default,,0,0,0,,Жақсы араласудың зияны жоқ.
Dialogue: 0,0:20:27.76,0:20:28.93,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:29.72,0:20:33.14,Default,,0,0,0,,Жақында тағы бірдеңе істеген сияқты.
Dialogue: 0,0:20:33.23,0:20:35.19,Default,,0,0,0,,Ордер жаңартылды.
Dialogue: 0,0:20:35.27,0:20:37.15,Default,,0,0,0,,«Шаға»?…
Dialogue: 0,0:20:37.23,0:20:40.19,Default,,0,0,0,,Осы маңдағы қарақшылардың басы.
Dialogue: 0,0:21:04.01,0:21:04.84,Default,,0,0,0,,(Әйелдердің айқайы)
Dialogue: 0,0:21:04.93,0:21:06.84,Default,,0,0,0,,Бұл қарақшы!
Dialogue: 0,0:21:06.93,0:21:09.35,Default,,0,0,0,,Ғү!
Dialogue: 0,0:21:09.43,0:21:10.97,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:16.27,0:21:17.56,Default,,0,0,0,,Өлім!
Dialogue: 0,0:21:17.65,0:21:21.82,Default,,0,0,0,,Экскаваторлы күрекпен шабуыл!
Dialogue: 0,0:21:22.65,0:21:26.57,Default,,0,0,0,,Бұл Ашиш Жердің Елшісіне түсірілген балға!
Dialogue: 0,0:21:30.91,0:21:34.75,Default,,0,0,0,,Бұл қандай қозғалыс? Бұл басқа әлем! Бұл керемет!
Dialogue: 0,0:21:34.83,0:21:37.54,Default,,0,0,0,,Аға, ауыр техниканы жүргізу қызық~
Dialogue: 0,0:21:37.62,0:21:39.63,Default,,0,0,0,,Мен ол жерді қазып алғым келеді!
Dialogue: 0,0:21:39.71,0:21:42.09,Default,,0,0,0,,Хаха, ол өзгеретін сияқты~
Dialogue: 0,0:21:42.17,0:21:46.84,Default,,0,0,0,,Бірақ ғимараттың іргетасын қалау үшін жер тегіс болуы керек.
Dialogue: 0,0:21:48.14,0:21:50.85,Default,,0,0,0,,Басқа әлемде баяу өмір сүруді жүзеге асыру
Dialogue: 0,0:21:50.93,0:21:54.89,Default,,0,0,0,,Мен мұнда ағаш үй саламын деп мәлімдеймін!
Dialogue: 0,0:21:55.93,0:21:58.44,Default,,0,0,0,,Хмм, бірақ мен экскаватор деген үлкен зат сатып алғаным үшін.
Dialogue: 0,0:21:58.52,0:22:00.56,Default,,0,0,0,,Тепе-теңдігім аздап қынжыламын.
Dialogue: 0,0:22:00.65,0:22:03.61,Default,,0,0,0,,қаражат жинауды талап етеді.
Dialogue: 0,0:22:03.69,0:22:05.40,Default,,0,0,0,,Қазір...
Dialogue: 0,0:22:05.94,0:22:09.95,Default,,0,0,0,,♪～
Dialogue: 0,0:23:32.20,0:23:35.87,Default,,0,0,0,,～♪
