Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.00,0:00:11.42,Default,,0,0,0,,Не? Бортта аң адам бар!
Dialogue: 0,0:00:14.51,0:00:16.47,Default,,0,0,0,,Корольдік капитал пайда болды
Dialogue: 0,0:00:16.55,0:00:17.93,Default,,0,0,0,,-Ох~ -Уау~
Dialogue: 0,0:00:23.98,0:00:26.40,Default,,0,0,0,,- (Мяре) Голем ня - Голем?
Dialogue: 0,0:00:26.48,0:00:28.98,Default,,0,0,0,,Егер бұл Анн ханым болса, оны жылжытуға болады, солай ма?
Dialogue: 0,0:00:29.07,0:00:30.23,Default,,0,0,0,,Мен оны көргім келеді!
Dialogue: 0,0:00:30.32,0:00:31.48,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:00:31.57,0:00:35.95,Default,,0,0,0,,Қажетті процедураларды орындамайынша, сиқырлы тіршілік иелерін белсендіру заңсыз болып табылады.
Dialogue: 0,0:00:36.03,0:00:39.20,Default,,0,0,0,,Осылайша біз патша астанасына келдік.
Dialogue: 0,0:00:42.00,0:00:44.46,Default,,0,0,0,,Бірақ қамал қабырғаларының іші күрделі және біртүрлі.
Dialogue: 0,0:00:46.67,0:00:50.34,Default,,0,0,0,,Құрылым ұлттық құпия сияқты, картасы жоқ.
Dialogue: 0,0:00:55.05,0:00:56.76,Default,,0,0,0,,Бұл Примула.
Dialogue: 0,0:00:56.84,0:01:00.26,Default,,0,0,0,,Анемон күні қыз бен әкесі келе жатыр
Dialogue: 0,0:01:00.35,0:01:03.89,Default,,0,0,0,,Согарам қуылып, Кротонның отбасы көшіп келді.
Dialogue: 0,0:01:03.98,0:01:06.14,Default,,0,0,0,,Менің өмірім қарбалас болды.
Dialogue: 0,0:01:06.23,0:01:10.40,Default,,0,0,0,,Бұл жолы Мәртебелі Король мені астанаға шақырды!
Dialogue: 0,0:01:10.48,0:01:12.94,Default,,0,0,0,,Чи-чи-чи~
Dialogue: 0,0:01:13.53,0:01:17.41,Default,,0,0,0,,♪～
Dialogue: 0,0:02:36.86,0:02:41.45,Default,,0,0,0,,～♪
Dialogue: 0,0:02:46.16,0:02:49.58,Default,,0,0,0,,Патшаның қарауылға жазған хатын көрсет.
Dialogue: 0,0:02:49.66,0:02:52.08,Default,,0,0,0,,Бір сағат күту
Dialogue: 0,0:02:53.92,0:02:55.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:58.59,0:03:02.18,Default,,0,0,0,,Әкеңнің хатын әкелген сол ма?
Dialogue: 0,0:03:02.80,0:03:05.35,Default,,0,0,0,,Мәртебелі Патшаның менің әкем екендігі...
Dialogue: 0,0:03:05.43,0:03:08.47,Default,,0,0,0,,Хаха! Менің атым Кеничи, саудагер.
Dialogue: 0,0:03:08.56,0:03:11.10,Default,,0,0,0,,Бұған сиқыршы болу кіреді ме?
Dialogue: 0,0:03:11.19,0:03:14.69,Default,,0,0,0,,Менің ойымша, мен саудагермін.
Dialogue: 0,0:03:14.77,0:03:18.36,Default,,0,0,0,,Менің хат жібергеніме екі аптадан сәл ғана асты.
Dialogue: 0,0:03:18.44,0:03:20.65,Default,,0,0,0,,Құрметті Ием, Астрантиядан осы жерге дейін
Dialogue: 0,0:03:20.74,0:03:22.86,Default,,0,0,0,,Сен немен келдің?
Dialogue: 0,0:03:22.95,0:03:26.12,Default,,0,0,0,,Мен шақырылған аңға мініп, тас жол бойымен жүрдім.
Dialogue: 0,0:03:26.20,0:03:28.75,Default,,0,0,0,,Не, бұл шақырылған аң!
Dialogue: 0,0:03:28.83,0:03:30.21,Default,,0,0,0,,Шақыру
Dialogue: 0,0:03:31.46,0:03:32.42,Default,,0,0,0,,Күн шығыпты.
Dialogue: 0,0:03:32.50,0:03:34.25,Default,,0,0,0,,Ханшайым, саған қауіп төніп тұр!
Dialogue: 0,0:03:36.34,0:03:38.76,Default,,0,0,0,,Бұл керемет көлік!
Dialogue: 0,0:03:38.84,0:03:40.17,Default,,0,0,0,,Шынында да, егер солай болса
Dialogue: 0,0:03:40.26,0:03:42.84,Default,,0,0,0,,60-қа жуық лига тез өтеді.
Dialogue: 0,0:03:42.93,0:03:44.22,Default,,0,0,0,,Мәртебелі ханшайым
Dialogue: 0,0:03:44.30,0:03:47.97,Default,,0,0,0,,Бейтаныс көлікте абайсызда жүру
Dialogue: 0,0:03:48.06,0:03:50.39,Default,,0,0,0,,Сені осылай алып кетсе не істер едің?
Dialogue: 0,0:03:50.48,0:03:54.15,Default,,0,0,0,,Әй, бұл қызықты естіледі. Байқап көріңіз!
Dialogue: 0,0:03:54.23,0:03:56.36,Default,,0,0,0,,А, бұл ханшайым
Dialogue: 0,0:03:56.44,0:03:58.57,Default,,0,0,0,,Бейбіт күнделікті өмірде толқын жасау
Dialogue: 0,0:03:58.65,0:04:01.24,Default,,0,0,0,,Мен қиындық тудырғанды жақсы көремін.
Dialogue: 0,0:03:58.65,0:04:01.24,Default,,0,0,0,,(Лилиттің күлкісі)
Dialogue: 0,0:04:01.24,0:04:01.74,Default,,0,0,0,,(Лилиттің күлкісі)
Dialogue: 0,0:04:01.82,0:04:04.03,Default,,0,0,0,,Бұл жай ғана әзіл.
Dialogue: 0,0:04:04.11,0:04:05.91,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:04:05.99,0:04:07.91,Default,,0,0,0,,Не қызықсыз?
Dialogue: 0,0:04:08.99,0:04:09.91,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:04:09.99,0:04:12.25,Default,,0,0,0,,Осындай шақырылған аңдар, т.б.
Dialogue: 0,0:04:09.99,0:04:12.25,Default,,0,0,0,,Не ойлап тұрсың!
Dialogue: 0,0:04:12.25,0:04:12.33,Default,,0,0,0,,Сіз не ойлап отырсыз!
Dialogue: 0,0:04:12.33,0:04:12.79,Default,,0,0,0,,Сіз не ойлап отырсыз!
Dialogue: 0,0:04:12.33,0:04:12.79,Default,,0,0,0,,Өте қауіпті!
Dialogue: 0,0:04:12.79,0:04:13.50,Default,,0,0,0,,Өте қауіпті!
Dialogue: 0,0:04:13.58,0:04:14.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:14.75,0:04:17.96,Default,,0,0,0,,Ха! Сізді алаңдататын нәрсе
Dialogue: 0,0:04:18.04,0:04:21.97,Default,,0,0,0,,Сабанда емес, мойнында.
Dialogue: 0,0:04:22.05,0:04:24.38,Default,,0,0,0,,Қанағаттанбасаңыз, жұмыстан неге кетпеске?
Dialogue: 0,0:04:24.47,0:04:25.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:25.51,0:04:26.68,Default,,0,0,0,,Сақтау
Dialogue: 0,0:04:26.76,0:04:27.22,Default,,0,0,0,,(шенеуніктердің таңданған дауыстары)
Dialogue: 0,0:04:27.22,0:04:28.22,Default,,0,0,0,,(шенеуніктердің таңданған дауыстары)
Dialogue: 0,0:04:27.22,0:04:28.22,Default,,0,0,0,,Менің атым Кеничи.
Dialogue: 0,0:04:28.22,0:04:28.76,Default,,0,0,0,,Менің атым Кеничи.
Dialogue: 0,0:04:28.85,0:04:30.52,Default,,0,0,0,,Иә, Мәртебелі
Dialogue: 0,0:04:30.60,0:04:33.02,Default,,0,0,0,,Құлпынай Лилит деп атауға болады.
Dialogue: 0,0:04:33.10,0:04:36.44,Default,,0,0,0,,Онда мен сізді Лилит ханым деп атаймын.
Dialogue: 0,0:04:36.52,0:04:37.94,Default,,0,0,0,,Ммм~
Dialogue: 0,0:04:38.02,0:04:39.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:43.53,0:04:45.45,Default,,0,0,0,,Иә, маған ұнады.
Dialogue: 0,0:04:45.53,0:04:48.95,Default,,0,0,0,,Мен сізді марапаттаймын, тек қалағаныңызды айтыңыз.
Dialogue: 0,0:04:49.03,0:04:52.95,Default,,0,0,0,,Бұл сыйлық па? Хмм...
Dialogue: 0,0:04:53.04,0:04:55.92,Default,,0,0,0,,-де бір бұрыш жақсы, сондықтан
Dialogue: 0,0:04:56.00,0:04:58.96,Default,,0,0,0,,Мен сарайдың артқы ауласында тұра аламын ба?
Dialogue: 0,0:04:59.04,0:05:00.21,Default,,0,0,0,,Жотаро, бұл сенің кінәң емес.
Dialogue: 0,0:05:00.30,0:05:04.09,Default,,0,0,0,,Мәртебелі Корольмен бірге тыңдармандарым келмейінше менің қояр жерім жоқ.
Dialogue: 0,0:05:04.17,0:05:08.14,Default,,0,0,0,,Өздеріңіз көріп тұрғандай, менің отбасымда аңдар бар.
Dialogue: 0,0:05:08.22,0:05:10.72,Default,,0,0,0,,Бірге тұруға болатын нысандар аз.
Dialogue: 0,0:05:10.81,0:05:12.97,Default,,0,0,0,,Поо... хахахаха
Dialogue: 0,0:05:13.06,0:05:16.06,Default,,0,0,0,,Мұндай сыйлық бұрыннан естімеген!
Dialogue: 0,0:05:16.14,0:05:17.48,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:05:17.56,0:05:20.31,Default,,0,0,0,,Мен үшін отбасыммен бірге болу
Dialogue: 0,0:05:20.40,0:05:22.61,Default,,0,0,0,,Ол ең жоғары мәнге ие.
Dialogue: 0,0:05:22.69,0:05:24.74,Default,,0,0,0,,Түсінікті Рұқсат етілген
Dialogue: 0,0:05:24.82,0:05:25.86,Default,,0,0,0,,Аудиторияны анықтағаннан кейін
Dialogue: 0,0:05:25.95,0:05:28.07,Default,,0,0,0,,Сізге дереу хабарласуға болатын жерде болғаныңыз дұрыс.
Dialogue: 0,0:05:28.16,0:05:28.87,Default,,0,0,0,,Іздеудің қажеті жоқ, сондықтан бір оқпен екі құсты өлтіруге болады.
Dialogue: 0,0:05:28.87,0:05:30.37,Default,,0,0,0,,Іздеудің қажеті жоқ болғандықтан, бір оқпен екі құсты өлтіруге болады.
Dialogue: 0,0:05:30.37,0:05:31.37,Default,,0,0,0,,Іздеудің қажеті жоқ, сондықтан бір оқпен екі құсты өлтіруге болады.
Dialogue: 0,0:05:32.04,0:05:36.21,Default,,0,0,0,,Әкеммен бірге аудиторияға бірнеше ай қалды.
Dialogue: 0,0:05:36.29,0:05:37.12,Default,,0,0,0,,Е...
Dialogue: 0,0:05:42.00,0:05:43.76,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:05:47.34,0:05:51.26,Default,,0,0,0,,Кашикоми ~ Кашикоми ~ Мен ~ деймін
Dialogue: 0,0:05:52.31,0:05:54.14,Default,,0,0,0,,-Үйге шақыру -Шақыру!
Dialogue: 0,0:05:55.06,0:05:55.89,Default,,0,0,0,,(шенеуніктердің шошыған дауыстары)
Dialogue: 0,0:05:55.98,0:05:57.35,Default,,0,0,0,,Бұл не!
Dialogue: 0,0:05:57.44,0:05:59.48,Default,,0,0,0,,Бұл біздің үй.
Dialogue: 0,0:05:59.56,0:06:01.02,Default,,0,0,0,,Әй, ханшайым
Dialogue: 0,0:06:01.11,0:06:03.15,Default,,0,0,0,,Уау~ Қалағаныңды істе!
Dialogue: 0,0:06:03.90,0:06:06.82,Default,,0,0,0,,Сонда кереует пен үстел ғана бар ма?
Dialogue: 0,0:06:06.90,0:06:08.78,Default,,0,0,0,,-Сәлем... Ханшайым... -Ханшайым
Dialogue: 0,0:06:08.86,0:06:12.28,Default,,0,0,0,,Басқа элементтер элемент жолағында.
Dialogue: 0,0:06:08.86,0:06:12.28,Default,,0,0,0,,Ханшайым... Ханшайым...
Dialogue: 0,0:06:12.37,0:06:15.41,Default,,0,0,0,,Жарайды, мен шештім. Мен осында қаламын.
Dialogue: 0,0:06:15.50,0:06:16.54,Default,,0,0,0,,Не!
Dialogue: 0,0:06:16.62,0:06:17.66,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:06:17.75,0:06:21.63,Default,,0,0,0,,Белгісіз біреудің жатын бөлмесінде түнеу – шектен шығу!
Dialogue: 0,0:06:21.71,0:06:23.46,Default,,0,0,0,,Өте қызық!
Dialogue: 0,0:06:23.54,0:06:24.92,Default,,0,0,0,,-Мм... -(Шенеуніктер) А...
Dialogue: 0,0:06:25.00,0:06:27.51,Default,,0,0,0,,О... сенімдісің бе?
Dialogue: 0,0:06:27.59,0:06:29.93,Default,,0,0,0,,Мен сізге қонақжайлық көрсете алмаймын...
Dialogue: 0,0:06:30.01,0:06:33.39,Default,,0,0,0,,Мен бұл негізсіз екенін білемін.
Dialogue: 0,0:06:33.47,0:06:34.93,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:06:35.01,0:06:37.06,Default,,0,0,0,,Кішкене өзімшіл болса да
Dialogue: 0,0:06:37.14,0:06:39.94,Default,,0,0,0,,Ол сіз сөйлесе алмайтын типке ұқсамайды.
Dialogue: 0,0:06:41.94,0:06:44.65,Default,,0,0,0,,Мен Няменаның үйін де босатып жібердім.
Dialogue: 0,0:06:44.73,0:06:46.57,Default,,0,0,0,,Экскаваторға шақыру!
Dialogue: 0,0:06:49.32,0:06:51.57,Default,,0,0,0,,Келесіде дәретхана... Е!
Dialogue: 0,0:06:51.66,0:06:54.12,Default,,0,0,0,,Мынау темір шақырылған аң!
Dialogue: 0,0:06:54.20,0:06:55.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:55.16,0:06:57.20,Default,,0,0,0,,Ханшайым! Сен не істеп жатырсың?
Dialogue: 0,0:06:55.16,0:06:57.20,Default,,0,0,0,,Құрметті Лилит, сіз тым көп ойнап жатырсыз.
Dialogue: 0,0:06:57.20,0:06:57.29,Default,,0,0,0,,Құрметті Лилит, сіз тым көп ойнап жатырсыз.
Dialogue: 0,0:06:57.29,0:06:57.75,Default,,0,0,0,,Құрметті Лилит, сіз тым көп ойнап жатырсыз.
Dialogue: 0,0:06:57.29,0:06:57.75,Default,,0,0,0,,Жоғары мәртебелілерді түсіріңіз! Дөрекі адам!
Dialogue: 0,0:06:57.75,0:06:57.83,Default,,0,0,0,,Жоғары мәртебелілерді түсіріңіз! Дөрекі адам!
Dialogue: 0,0:06:57.83,0:06:59.71,Default,,0,0,0,,Жоғары мәртебелілерді түсіріңіз! Дөрекі адам!
Dialogue: 0,0:06:57.83,0:06:59.71,Default,,0,0,0,,Сабандарды уайымдама
Dialogue: 0,0:06:59.79,0:07:00.71,Default,,0,0,0,,Ммм~
Dialogue: 0,0:07:08.09,0:07:08.92,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:07:09.01,0:07:09.84,Default,,0,0,0,,- Иә? -Аа...
Dialogue: 0,0:07:09.92,0:07:12.84,Default,,0,0,0,,Жоғары мәртебелі денесіне абайсызда қол тигізу және т.б.
Dialogue: 0,0:07:12.93,0:07:14.72,Default,,0,0,0,,Қандай дөрекі!
Dialogue: 0,0:07:14.80,0:07:15.81,Default,,0,0,0,,Шақыру
Dialogue: 0,0:07:16.56,0:07:18.98,Default,,0,0,0,,Ей, сен мені өлтіруге келдің.
Dialogue: 0,0:07:19.06,0:07:20.14,Default,,0,0,0,,Шақыр!
Dialogue: 0,0:07:20.81,0:07:22.73,Default,,0,0,0,,Иә! Қарғыс атқыр...
Dialogue: 0,0:07:23.52,0:07:24.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:25.36,0:07:26.61,Default,,0,0,0,,Жоқ, күт, күт, Анемон!
Dialogue: 0,0:07:26.69,0:07:28.61,Default,,0,0,0,,От шары!
Dialogue: 0,0:07:30.44,0:07:32.61,Default,,0,0,0,,Қорғау! Ха!
Dialogue: 0,0:07:32.70,0:07:34.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:34.45,0:07:36.87,Default,,0,0,0,,Эй Анемон, бітті!
Dialogue: 0,0:07:37.83,0:07:39.83,Default,,0,0,0,,Екі жақ, қылышыңды таста!
Dialogue: 0,0:07:39.83,0:07:40.87,Default,,0,0,0,,Екі жақ, қылышыңды таста!
Dialogue: 0,0:07:39.83,0:07:40.87,Default,,0,0,0,,А...
Dialogue: 0,0:07:40.87,0:07:41.29,Default,,0,0,0,,А...
Dialogue: 0,0:07:42.71,0:07:43.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:45.33,0:07:46.38,Default,,0,0,0,,Құрметті Лилит...
Dialogue: 0,0:07:46.46,0:07:49.55,Default,,0,0,0,,Сол жаста сиқыршы болдыңыз ба?
Dialogue: 0,0:07:49.63,0:07:50.92,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:07:51.01,0:07:52.01,Default,,0,0,0,,Анемон
Dialogue: 0,0:07:52.09,0:07:55.26,Default,,0,0,0,,Бұл Лилит, оны атымен атауға болады.
Dialogue: 0,0:07:55.34,0:07:56.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:56.97,0:08:00.06,Default,,0,0,0,,Анемон тағы қандай сиқырды қолдана алады?
Dialogue: 0,0:08:00.14,0:08:01.77,Default,,0,0,0,,Жарылыс…
Dialogue: 0,0:08:01.85,0:08:04.19,Default,,0,0,0,,Жарылыс дегеніміз не?
Dialogue: 0,0:08:04.27,0:08:07.52,Default,,0,0,0,,Өйткені сен менің отбасымның ұлы сиқыршысысың.
Dialogue: 0,0:08:07.61,0:08:10.53,Default,,0,0,0,,Сіз мұны естідіңіз бе? Бұл жарылыс болса ше?
Dialogue: 0,0:08:10.61,0:08:14.16,Default,,0,0,0,,Балалар, сіз екінші дәрежелі арнайы акциялар болдыңыз.
Dialogue: 0,0:08:14.24,0:08:15.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:16.57,0:08:19.29,Default,,0,0,0,,Лилит-сама, бізге уақыт келді
Dialogue: 0,0:08:19.37,0:08:22.04,Default,,0,0,0,,Мен тамақ дайындауым керек, сондықтан...
Dialogue: 0,0:08:22.12,0:08:25.29,Default,,0,0,0,,Неліктен мұны істей алмайсың?
Dialogue: 0,0:08:25.37,0:08:27.29,Default,,0,0,0,,(қыздардың иіскеген дыбысы)
Dialogue: 0,0:08:28.13,0:08:31.55,Default,,0,0,0,,Жақсы иіс шығады. Бұл дәмдеуіш сорпасы ма?
Dialogue: 0,0:08:31.63,0:08:33.30,Default,,0,0,0,,құстар биіктікте ұша алады—
Dialogue: 0,0:08:33.38,0:08:34.76,Default,,0,0,0,,Сол ақ дән ше?
Dialogue: 0,0:08:34.84,0:08:35.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:35.76,0:08:39.31,Default,,0,0,0,,Бұл пісірілген астық.
Dialogue: 0,0:08:39.39,0:08:42.18,Default,,0,0,0,,Мен Лилитке нан дайындауды жоспарлап отырмын...
Dialogue: 0,0:08:42.27,0:08:45.14,Default,,0,0,0,,Мен де сол ақты жегім келеді!
Dialogue: 0,0:08:45.23,0:08:46.81,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:08:51.86,0:08:53.49,Default,,0,0,0,,Мен…
Dialogue: 0,0:08:55.70,0:08:57.32,Default,,0,0,0,,Мынау... бұл дәмді!
Dialogue: 0,0:08:57.41,0:09:01.08,Default,,0,0,0,,Керемет... Карри әділ, тіпті роялти үшін!
Dialogue: 0,0:09:01.66,0:09:04.58,Default,,0,0,0,,Қарапайым адамдар мұндай тағамды үнемі жей ме?
Dialogue: 0,0:09:04.66,0:09:08.50,Default,,0,0,0,,Жоқ, бұл менің туған жерімнен келген тағам.
Dialogue: 0,0:09:08.58,0:09:10.54,Default,,0,0,0,,Бұл елде дәмдеуіштер синдикаты
Dialogue: 0,0:09:10.63,0:09:11.96,Default,,0,0,0,,кең ауқымы бар
Dialogue: 0,0:09:12.05,0:09:14.76,Default,,0,0,0,,Өйткені дәмдеуіштердің бағасы көтерілді
Dialogue: 0,0:09:14.84,0:09:17.13,Default,,0,0,0,,Қарапайым адамдарға тамақ ішу қиын ба деп ойлаймын...
Dialogue: 0,0:09:17.22,0:09:19.47,Default,,0,0,0,,Хмф! Олар...
Dialogue: 0,0:09:19.55,0:09:23.81,Default,,0,0,0,,Сонымен, осы дәмдеуіштің қосындысын айтып бере аласыз ба?
Dialogue: 0,0:09:23.89,0:09:26.31,Default,,0,0,0,,Өйткені мен оны жасаған жоқпын.
Dialogue: 0,0:09:26.39,0:09:28.15,Default,,0,0,0,,Құпия
Dialogue: 0,0:09:29.69,0:09:31.98,Default,,0,0,0,,Аа, егер сіз патша сарайында аспаз болсаңыз.
Dialogue: 0,0:09:32.07,0:09:34.57,Default,,0,0,0,,Оны қайта шығаруға болады.
Dialogue: 0,0:09:34.65,0:09:37.99,Default,,0,0,0,,Хмм... Бұл қызықты естіледі.
Dialogue: 0,0:09:38.07,0:09:40.12,Default,,0,0,0,,- Оның орнына! -сурет!
Dialogue: 0,0:09:40.20,0:09:42.87,Default,,0,0,0,,Уф... Мен қанағаттандым.
Dialogue: 0,0:09:42.95,0:09:45.37,Default,,0,0,0,,Маған да мына табақ пен қасық ұнады.
Dialogue: 0,0:09:45.45,0:09:46.50,Default,,0,0,0,,Мен оны сатып аламын
Dialogue: 0,0:09:46.58,0:09:47.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:47.83,0:09:49.71,Default,,0,0,0,,Пластина 20 алтын монетадан тұрады.
Dialogue: 0,0:09:49.79,0:09:52.67,Default,,0,0,0,,Менің ойымша, қасық шамамен 10 алтын тиын тұрады...
Dialogue: 0,0:09:52.75,0:09:54.05,Default,,0,0,0,,Пластина - бұл.
Dialogue: 0,0:09:54.13,0:09:56.63,Default,,0,0,0,,Қасыққа 20 алтын тиын да сыяды.
Dialogue: 0,0:09:57.22,0:09:58.63,Default,,0,0,0,,Сонымен, Лилит-сама.
Dialogue: 0,0:09:58.72,0:10:03.22,Default,,0,0,0,,Мен саған тәрелке мен қасықтан 20 алтын тиын беремін.
Dialogue: 0,0:10:03.31,0:10:05.18,Default,,0,0,0,,Бұл өте адал.
Dialogue: 0,0:10:05.27,0:10:07.14,Default,,0,0,0,,Әрқайсысынан 10 дана сатып алайық.
Dialogue: 0,0:10:07.23,0:10:08.64,Default,,0,0,0,,Мұқаба…
Dialogue: 0,0:10:10.48,0:10:12.65,Default,,0,0,0,,-Майлен -Иә
Dialogue: 0,0:10:12.73,0:10:15.32,Default,,0,0,0,,Осы дәмдеуішті Самбакқа апарыңыз.
Dialogue: 0,0:10:15.40,0:10:17.15,Default,,0,0,0,,Ақылды ханшайым
Dialogue: 0,0:10:20.24,0:10:21.78,Default,,0,0,0,,Ууу…
Dialogue: 0,0:10:23.20,0:10:24.29,Default,,0,0,0,,Аха…
Dialogue: 0,0:10:24.37,0:10:25.37,Default,,0,0,0,,-Ммм -Ух...
Dialogue: 0,0:10:25.45,0:10:27.04,Default,,0,0,0,,Марлей әскері емес.
Dialogue: 0,0:10:27.12,0:10:28.21,Default,,0,0,0,,Саудагер деп те аталады
Dialogue: 0,0:10:28.29,0:10:30.17,Default,,0,0,0,,Өтірік айтпайсың ғой?
Dialogue: 0,0:10:30.88,0:10:32.50,Default,,0,0,0,,Элемент қорапшасының ішінде
Dialogue: 0,0:10:32.59,0:10:35.67,Default,,0,0,0,,Мұнда көптеген асыл тастар сақталған болуы мүмкін.
Dialogue: 0,0:10:35.76,0:10:38.01,Default,,0,0,0,,Кейбір тыйым салынған заттар
Dialogue: 0,0:10:38.09,0:10:39.59,Default,,0,0,0,,Бұл коммерциялық құпия, сондықтан мен жауап бере алмаймын.
Dialogue: 0,0:10:39.59,0:10:41.55,Default,,0,0,0,,Бұл коммерциялық құпия, сондықтан мен жауап бере алмаймын.
Dialogue: 0,0:10:39.59,0:10:41.55,Default,,0,0,0,,Ммм~
Dialogue: 0,0:10:41.64,0:10:44.64,Default,,0,0,0,,Екеуің тым жақынсыңдар!
Dialogue: 0,0:10:44.72,0:10:45.93,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:46.02,0:10:48.73,Default,,0,0,0,,Анемон Кеничидің қызы емес пе?
Dialogue: 0,0:10:48.81,0:10:51.60,Default,,0,0,0,,Менің қызым болса да, қандас туыс емеспіз.
Dialogue: 0,0:10:51.69,0:10:52.73,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:52.81,0:10:55.36,Default,,0,0,0,,Анемон Кеничиді ұнатады, солай ма?
Dialogue: 0,0:10:55.44,0:10:59.32,Default,,0,0,0,,Тағы бес жылдан кейін мен Кеничидің баласын туамын!
Dialogue: 0,0:10:59.40,0:11:00.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:00.40,0:11:04.24,Default,,0,0,0,,Анемон Бала тусаң, шытырман оқиғаларға бара алмайсың, солай ма?
Dialogue: 0,0:11:04.33,0:11:05.95,Default,,0,0,0,,Ех! Уф...
Dialogue: 0,0:11:06.04,0:11:08.04,Default,,0,0,0,,«Мен өзіме ұнайтын адамның баласын туамын» ...
Dialogue: 0,0:11:08.12,0:11:08.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:09.04,0:11:11.87,Default,,0,0,0,,Сабандай саяси некедегі пешка
Dialogue: 0,0:11:11.96,0:11:14.59,Default,,0,0,0,,Өмір тек байланыссыз сөз
Dialogue: 0,0:11:17.80,0:11:20.38,Default,,0,0,0,,Охо~ Бұл ванна~ Бұл ванна~
Dialogue: 0,0:11:20.47,0:11:21.34,Default,,0,0,0,,Кя~
Dialogue: 0,0:11:21.43,0:11:24.80,Default,,0,0,0,,Ханшайым, ыстық суды көп шашыратпаңыз.
Dialogue: 0,0:11:21.43,0:11:24.80,Default,,0,0,0,,(Лилиттің күлкісі)
Dialogue: 0,0:11:24.89,0:11:26.64,Default,,0,0,0,,Күтілгендей, кәмелетке толмаған король...
Dialogue: 0,0:11:26.72,0:11:28.85,Default,,0,0,0,,Бірге шомылса жаман болады.
Dialogue: 0,0:11:28.93,0:11:30.60,Default,,0,0,0,,Сол мектеп те нашар шешілген.
Dialogue: 0,0:11:30.60,0:11:31.48,Default,,0,0,0,,Мектеп те нашар шешілді.
Dialogue: 0,0:11:31.56,0:11:33.85,Default,,0,0,0,,Қалғанын Примула мен Анемонға қалдырыңыз.
Dialogue: 0,0:11:33.94,0:11:35.90,Default,,0,0,0,,Біз далада ұйықтаймыз.
Dialogue: 0,0:11:36.40,0:11:37.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:37.82,0:11:39.11,Default,,0,0,0,,Эскорт?
Dialogue: 0,0:11:39.69,0:11:43.61,Default,,0,0,0,,Бүгін ханшайыммен бір күн өтті.
Dialogue: 0,0:11:43.70,0:11:46.12,Default,,0,0,0,,Ертең менде де сондай сезім бар...
Dialogue: 0,0:11:43.70,0:11:46.12,Default,,0,0,0,,Аха…
Dialogue: 0,0:11:49.04,0:11:50.08,Default,,0,0,0,,Мяу?
Dialogue: 0,0:11:50.16,0:11:51.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:51.21,0:11:52.79,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:53.71,0:11:55.71,Default,,0,0,0,,Осындай нәрсе...
Dialogue: 0,0:11:55.79,0:11:57.34,Default,,0,0,0,,Біртүрлі сезім бар...
Dialogue: 0,0:11:57.42,0:11:58.63,Default,,0,0,0,,Мяу
Dialogue: 0,0:12:05.01,0:12:07.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:08.56,0:12:12.14,Default,,0,0,0,,Умм... аа...
Dialogue: 0,0:12:12.23,0:12:13.06,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:15.90,0:12:17.31,Default,,0,0,0,,Я...
Dialogue: 0,0:12:20.40,0:12:23.82,Default,,0,0,0,,Бұл сиқыршы Кеничи
Dialogue: 0,0:12:24.91,0:12:26.07,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:12:32.54,0:12:33.83,Default,,0,0,0,,Біреу бар!
Dialogue: 0,0:12:33.91,0:12:35.25,Default,,0,0,0,,Иә
Dialogue: 0,0:12:36.67,0:12:37.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:37.92,0:12:39.63,Default,,0,0,0,,Сіз мені күтуге мәжбүр еттіңіз!
Dialogue: 0,0:12:39.71,0:12:40.75,Default,,0,0,0,,Сол күннен бастап
Dialogue: 0,0:12:40.84,0:12:44.22,Default,,0,0,0,,Біздің ханшайымның еркелеткен күндері басталды.
Dialogue: 0,0:12:44.30,0:12:45.38,Default,,0,0,0,,Кейде
Dialogue: 0,0:12:45.47,0:12:49.47,Default,,0,0,0,,Маған сарайдың жертөлесінде ұя салып жатқан егеуқұйрықтарды жоюды тапсырды.
Dialogue: 0,0:12:49.56,0:12:52.85,Default,,0,0,0,,Мен Шангри-Ладан сатып алған егеуқұйрықтың уытын көп пайдаландым.
Dialogue: 0,0:12:52.93,0:12:54.31,Default,,0,0,0,,1000-нан астам бар ма?
Dialogue: 0,0:12:54.39,0:12:56.90,Default,,0,0,0,,Егеуқұйрықтардың өлуін тоқтатты
Dialogue: 0,0:12:57.69,0:13:01.11,Default,,0,0,0,,Кейде патша саудагерлерімен қарым-қатынаста
Dialogue: 0,0:12:57.69,0:13:01.11,Default,,0,0,0,,(Аукцион туралы айқай)
Dialogue: 0,0:13:01.19,0:13:03.69,Default,,0,0,0,,Менің заттарымдағы үңгір өрмекші
Dialogue: 0,0:13:03.78,0:13:05.99,Default,,0,0,0,,Үлкен аукционды бастау
Dialogue: 0,0:13:06.07,0:13:07.74,Default,,0,0,0,,Кейде
Dialogue: 0,0:13:06.07,0:13:07.74,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:13:07.82,0:13:10.24,Default,,0,0,0,,«Егер мен өзімді ұрлап кетсем».
Dialogue: 0,0:13:10.33,0:13:12.62,Default,,0,0,0,,«Мен құлыптан қалай өте аламын?» деп сұрадым.
Dialogue: 0,0:13:12.62,0:13:13.66,Default,,0,0,0,,«Мен құлыптан қалай өте аламын?» деп сұрадым.
Dialogue: 0,0:13:12.62,0:13:13.66,Default,,0,0,0,,(Қыздың мазасыз дауыстары)
Dialogue: 0,0:13:13.66,0:13:14.50,Default,,0,0,0,,(Қыздың мазасыз дауыстары)
Dialogue: 0,0:13:14.58,0:13:17.04,Default,,0,0,0,,Мен орманды қойып, оны көрсеттім.
Dialogue: 0,0:13:17.12,0:13:20.00,Default,,0,0,0,,Күзетшілерден көп ұятты сатып алу...
Dialogue: 0,0:13:20.50,0:13:22.00,Default,,0,0,0,,Одан әрі...
Dialogue: 0,0:13:23.34,0:13:26.76,Default,,0,0,0,,Кеничи, мен бүгін осылай істеймін.
Dialogue: 0,0:13:26.84,0:13:28.43,Default,,0,0,0,,Сот аспаздары
Dialogue: 0,0:13:28.51,0:13:32.52,Default,,0,0,0,,Біз қайта жасалған карриге ұқсайтын тағамды жедік.
Dialogue: 0,0:13:32.60,0:13:36.44,Default,,0,0,0,,Жақсы дәмдеуіштердің иісі өткір.
Dialogue: 0,0:13:36.52,0:13:39.02,Default,,0,0,0,,Жақсы иіс шығады!
Dialogue: 0,0:13:39.10,0:13:40.65,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:13:40.73,0:13:42.11,Default,,0,0,0,,Кеничи дәмді болса да.
Dialogue: 0,0:13:42.19,0:13:43.40,Default,,0,0,0,,Бұл да дәмді
Dialogue: 0,0:13:43.48,0:13:45.32,Default,,0,0,0,,Бұл өте дәмді.
Dialogue: 0,0:13:45.40,0:13:50.16,Default,,0,0,0,,Мен қолданатын дәмдеуіштердің құны өте қымбат шығар...
Dialogue: 0,0:13:50.24,0:13:51.91,Default,,0,0,0,,Айтпақшы, Кеничи
Dialogue: 0,0:13:51.99,0:13:53.95,Default,,0,0,0,,Элемент қорабында
Dialogue: 0,0:13:54.04,0:13:58.17,Default,,0,0,0,,Бас аспаз Самбақ көбейте алмайтын тағам бар ма?
Dialogue: 0,0:13:58.25,0:13:59.00,Default,,0,0,0,,Не!
Dialogue: 0,0:13:59.00,0:13:59.54,Default,,0,0,0,,Не!
Dialogue: 0,0:13:59.00,0:13:59.54,Default,,0,0,0,,Сіз тағы да айтасыз...
Dialogue: 0,0:13:59.54,0:14:01.29,Default,,0,0,0,,Сіз тағы да айтасыз...
Dialogue: 0,0:14:02.71,0:14:04.63,Default,,0,0,0,,Бұл тәтті ме?
Dialogue: 0,0:14:04.71,0:14:05.55,Default,,0,0,0,,Шынында, сол сырғаң өте батыл екен.
Dialogue: 0,0:14:05.63,0:14:08.18,Default,,0,0,0,,Хмм, тәтті!
Dialogue: 0,0:14:08.26,0:14:11.05,Default,,0,0,0,,Байлығы мен тәттілігі тіліңде ериді!
Dialogue: 0,0:14:11.14,0:14:13.31,Default,,0,0,0,,Хмм... Мм!
Dialogue: 0,0:14:13.39,0:14:15.14,Default,,0,0,0,,Самбак ше?
Dialogue: 0,0:14:15.22,0:14:17.23,Default,,0,0,0,,Мен қорқамын, Мәртебелі, Ханшайым.
Dialogue: 0,0:14:17.31,0:14:19.85,Default,,0,0,0,,Енді мен үшін осыған ұқсас нәрсені жасаудың жалғыз жолы
Dialogue: 0,0:14:19.94,0:14:21.98,Default,,0,0,0,,Мен бұл қиын екенін айтуым керек.
Dialogue: 0,0:14:22.06,0:14:25.36,Default,,0,0,0,,Ендеше, сіз де жасай алмайтын нәрсе бар емес пе?
Dialogue: 0,0:14:25.44,0:14:26.94,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:14:27.03,0:14:29.45,Default,,0,0,0,,Бұл өте дөрекі.
Dialogue: 0,0:14:31.24,0:14:32.32,Default,,0,0,0,,Ресми іс бітті!
Dialogue: 0,0:14:32.41,0:14:33.95,Default,,0,0,0,,Ханшайым, қай жолмен?
Dialogue: 0,0:14:34.03,0:14:36.79,Default,,0,0,0,,Мен Кеничидің орнында шешілгеніне сенімдімін.
Dialogue: 0,0:14:40.46,0:14:41.63,Default,,0,0,0,,Қоймада бар ма?
Dialogue: 0,0:14:41.71,0:14:44.42,Default,,0,0,0,,Бұл тәттіні анам да сұраған.
Dialogue: 0,0:14:44.50,0:14:45.75,Default,,0,0,0,,Ханшайым?
Dialogue: 0,0:14:45.84,0:14:47.05,Default,,0,0,0,,Шақыру
Dialogue: 0,0:14:48.09,0:14:49.51,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:14:49.59,0:14:52.01,Default,,0,0,0,,А... а, жоқ...
Dialogue: 0,0:14:52.09,0:14:56.27,Default,,0,0,0,,Менің анам қиын адам, ашуланғанда қиналып қалады.
Dialogue: 0,0:14:56.35,0:15:00.52,Default,,0,0,0,,Басқаша айтқанда, Лилит-сама тәттілерді бірінші жеді.
Dialogue: 0,0:15:00.60,0:15:02.35,Default,,0,0,0,,Көңіл-күйіңіз нашар ма?
Dialogue: 0,0:15:02.44,0:15:04.44,Default,,0,0,0,,Міне, бұл туралы.
Dialogue: 0,0:15:04.52,0:15:06.78,Default,,0,0,0,,Варава менің биологиялық қызым емес.
Dialogue: 0,0:15:06.86,0:15:08.82,Default,,0,0,0,,Әртүрлі нәрселерге қамқорлық жасаңыз.
Dialogue: 0,0:15:08.90,0:15:12.24,Default,,0,0,0,,А... Мен мұны байқамадым, кешіріңіз.
Dialogue: 0,0:15:12.32,0:15:15.78,Default,,0,0,0,,Маған бәрібір. Екеуміздің қарым-қатынасымыз жаман емес.
Dialogue: 0,0:15:15.87,0:15:19.54,Default,,0,0,0,,Аудитория болған кезде дайындалу керек.
Dialogue: 0,0:15:19.62,0:15:23.00,Default,,0,0,0,,Ол қайтыс болған бәйбішенің қызы болатын.
Dialogue: 0,0:15:23.08,0:15:25.71,Default,,0,0,0,,Патшаның жалғыз баласы ретінде,
Dialogue: 0,0:15:25.79,0:15:27.30,Default,,0,0,0,,Ол көңілі қалған сияқты.
Dialogue: 0,0:15:27.38,0:15:31.38,Default,,0,0,0,,Патшайым өзінен әлдеқайда үлкен қарсылас сияқты ма?
Dialogue: 0,0:15:31.88,0:15:33.55,Default,,0,0,0,,Не? Тағы?
Dialogue: 0,0:15:33.64,0:15:35.26,Default,,0,0,0,,Мен қатысуды сезінемін
Dialogue: 0,0:15:35.35,0:15:36.76,Default,,0,0,0,,Өйткені, бірдеңе бар.
Dialogue: 0,0:15:36.85,0:15:37.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:38.02,0:15:39.35,Default,,0,0,0,,Бұл тағы да осында.
Dialogue: 0,0:15:39.43,0:15:40.98,Default,,0,0,0,,Бәрі де солай.
Dialogue: 0,0:15:41.06,0:15:44.56,Default,,0,0,0,,Негізі сарайды бірдеңе аңдып тұрған сияқты.
Dialogue: 0,0:15:44.65,0:15:45.56,Default,,0,0,0,,Эх!
Dialogue: 0,0:15:45.65,0:15:49.69,Default,,0,0,0,,Корольдік отбасын сақтау үшін өлген адамдар таудай құлады.
Dialogue: 0,0:15:49.78,0:15:51.65,Default,,0,0,0,,Кек сақтағандықтан өлгендердің саны сансыз.
Dialogue: 0,0:15:51.65,0:15:52.74,Default,,0,0,0,,Жек көрушіліктен өлген адамдар сансыз.
Dialogue: 0,0:15:51.65,0:15:52.74,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:52.74,0:15:52.82,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:52.82,0:15:54.03,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:52.82,0:15:54.03,Default,,0,0,0,,Қамалдың аруақтарға толы болғаны маған бәрібір.
Dialogue: 0,0:15:54.03,0:15:55.82,Default,,0,0,0,,Қамалдың аруақтарға толы болғанына бәрібір.
Dialogue: 0,0:15:55.91,0:15:57.74,Default,,0,0,0,,Ханшайым, сізден бір жақсылық сұрауға болады ма?
Dialogue: 0,0:15:57.83,0:15:59.12,Default,,0,0,0,,Мен міндетті түрде сонда боламын.
Dialogue: 0,0:15:59.20,0:16:01.25,Default,,0,0,0,,Мен өзімді үнемі бақылап жүргендей сезінемін.
Dialogue: 0,0:16:01.33,0:16:03.75,Default,,0,0,0,,Егер Унура соншалықты көп айтса...
Dialogue: 0,0:16:03.83,0:16:06.96,Default,,0,0,0,,Кеничи, мен сенен елестерді де жоюды өтінемін бе?
Dialogue: 0,0:16:07.04,0:16:08.96,Default,,0,0,0,,- дейін? -Осылай-
Dialogue: 0,0:16:09.05,0:16:10.97,Default,,0,0,0,,Қызметшілер шулы.
Dialogue: 0,0:16:11.05,0:16:13.26,Default,,0,0,0,,Мен... түсінемін.
Dialogue: 0,0:16:13.34,0:16:15.97,Default,,0,0,0,,Олай болса, менің сізге бір өтінішім бар.
Dialogue: 0,0:16:16.05,0:16:18.60,Default,,0,0,0,,Елестер бар екенін кім анықтай алады?
Dialogue: 0,0:16:18.68,0:16:21.48,Default,,0,0,0,,Тек үй жануары мен орман мысығы.
Dialogue: 0,0:16:21.56,0:16:24.19,Default,,0,0,0,,Олар қамалға кірсін...
Dialogue: 0,0:16:24.27,0:16:25.73,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:16:25.81,0:16:26.69,Default,,0,0,0,,-(Мяре) Мяу~ -Мм~
Dialogue: 0,0:16:26.69,0:16:27.40,Default,,0,0,0,,-(Мяре) Мяу~ -Мм~
Dialogue: 0,0:16:26.69,0:16:27.40,Default,,0,0,0,,Бірақ елестермен қалай күресеміз...
Dialogue: 0,0:16:27.40,0:16:30.19,Default,,0,0,0,,Бірақ елестермен қалай күресеміз...
Dialogue: 0,0:16:30.69,0:16:32.99,Default,,0,0,0,,Кеничи Бұл не?
Dialogue: 0,0:16:33.07,0:16:34.70,Default,,0,0,0,,Бұл бүріккіш.
Dialogue: 0,0:16:34.78,0:16:36.70,Default,,0,0,0,,Ішіне қасиетті суды салдым.
Dialogue: 0,0:16:36.78,0:16:38.24,Default,,0,0,0,,Қасиетті су?
Dialogue: 0,0:16:38.33,0:16:39.41,Default,,0,0,0,,Иә
Dialogue: 0,0:16:39.49,0:16:42.08,Default,,0,0,0,,Шангри-Ла қасиетті суды да сатты.
Dialogue: 0,0:16:42.16,0:16:43.00,Default,,0,0,0,,О!
Dialogue: 0,0:16:43.08,0:16:45.00,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:16:45.67,0:16:46.63,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:16:46.71,0:16:51.30,Default,,0,0,0,,Қасиетті суды саке және тазартатын тұзбен араластырыңыз.
Dialogue: 0,0:16:51.38,0:16:54.76,Default,,0,0,0,,Мұнда жапондық және батыстық стильдерді араластыру арқылы қуатталған нәрсе бар.
Dialogue: 0,0:16:55.76,0:16:58.76,Default,,0,0,0,,Осылайша аруақты жою басталды.
Dialogue: 0,0:16:59.64,0:17:01.14,Default,,0,0,0,,Сіз сол бұрыштасыз ба?
Dialogue: 0,0:17:01.22,0:17:03.18,Default,,0,0,0,,Мен солай сезінемін.
Dialogue: 0,0:17:03.27,0:17:05.64,Default,,0,0,0,,Аа, сен маған қарап тұрған сияқтымын.
Dialogue: 0,0:17:05.73,0:17:08.15,Default,,0,0,0,,Ендеше заклинаниеден бастайық.
Dialogue: 0,0:17:08.23,0:17:10.23,Default,,0,0,0,,Зұлым рухтарды қуыңыз!
Dialogue: 0,0:17:10.32,0:17:13.28,Default,,0,0,0,,Нобо Тариц Хараборис Шакинмей Шакинмей
Dialogue: 0,0:17:13.36,0:17:16.45,Default,,0,0,0,,...
Dialogue: 0,0:17:20.37,0:17:22.16,Default,,0,0,0,,А, ол кетті.
Dialogue: 0,0:17:22.24,0:17:23.29,Default,,0,0,0,,О...
Dialogue: 0,0:17:23.37,0:17:25.00,Default,,0,0,0,,Менің күйеуім жоғалып кетті.
Dialogue: 0,0:17:25.08,0:17:25.83,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:17:25.83,0:17:26.25,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:17:25.83,0:17:26.25,Default,,0,0,0,,Керемет
Dialogue: 0,0:17:26.25,0:17:27.04,Default,,0,0,0,,Керемет
Dialogue: 0,0:17:27.12,0:17:30.29,Default,,0,0,0,,Жоқ, Анемон, бұл керемет емес.
Dialogue: 0,0:17:30.38,0:17:32.38,Default,,0,0,0,,Кеничи Келесі жолы!
Dialogue: 0,0:17:32.46,0:17:33.92,Default,,0,0,0,,-Мух~ -Ханшайым~!
Dialogue: 0,0:17:34.92,0:17:35.88,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:17:35.97,0:17:37.68,Default,,0,0,0,,Қызметшілер бөлмесі
Dialogue: 0,0:17:37.76,0:17:38.30,Default,,0,0,0,,(қыздардың күлкісі)
Dialogue: 0,0:17:38.30,0:17:40.76,Default,,0,0,0,,(қыздардың күлкісі)
Dialogue: 0,0:17:38.30,0:17:40.76,Default,,0,0,0,,Жүрексізсің бе? Жақсы иіс шығады...
Dialogue: 0,0:17:40.76,0:17:41.26,Default,,0,0,0,,(қыздардың күлкісі)
Dialogue: 0,0:17:41.26,0:17:42.18,Default,,0,0,0,,(қыздардың күлкісі)
Dialogue: 0,0:17:41.26,0:17:42.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:42.26,0:17:45.10,Default,,0,0,0,,Ей, тыңда—
Dialogue: 0,0:17:45.18,0:17:46.44,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:17:46.52,0:17:47.73,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:47.81,0:17:48.69,Default,,0,0,0,,Онда!
Dialogue: 0,0:17:48.77,0:17:50.56,Default,,0,0,0,,Зұлым рухтарды қуыңыз!
Dialogue: 0,0:17:50.65,0:17:52.11,Default,,0,0,0,,- (Мяу) Мияу! -сурет?
Dialogue: 0,0:17:52.19,0:17:53.69,Default,,0,0,0,,Сіз сонда көштіңіз бе?
Dialogue: 0,0:17:53.78,0:17:55.78,Default,,0,0,0,,Зұлым рухтарды қуыңыз!
Dialogue: 0,0:17:56.40,0:18:00.16,Default,,0,0,0,,Күрсіну~ Жақсы иіс~
Dialogue: 0,0:18:00.24,0:18:02.24,Default,,0,0,0,,Жұмыстан кейін мен саған сусын беремін.
Dialogue: 0,0:18:02.33,0:18:04.87,Default,,0,0,0,,Бұл туралы не деуге болады? Сіз әлі де бірдеңені сезінесіз бе?
Dialogue: 0,0:18:04.95,0:18:07.08,Default,,0,0,0,,Эй, ол кетті.
Dialogue: 0,0:18:07.16,0:18:09.79,Default,,0,0,0,,Мен қысым жоғалғандай сезінемін.
Dialogue: 0,0:18:09.88,0:18:11.59,Default,,0,0,0,,Мен тіпті біреудің маған қарап тұрғанын сезбеймін
Dialogue: 0,0:18:11.67,0:18:14.84,Default,,0,0,0,,Иә? Бұл плацебо әсері емес пе?
Dialogue: 0,0:18:15.42,0:18:17.59,Default,,0,0,0,,Кел, Кеничи, келесі жолы!
Dialogue: 0,0:18:17.67,0:18:19.09,Default,,0,0,0,,-Әй! -Ммм~
Dialogue: 0,0:18:23.68,0:18:26.60,Default,,0,0,0,,Ақырында, анамның жатын бөлмесінде.
Dialogue: 0,0:18:26.68,0:18:28.44,Default,,0,0,0,,Королеваныкі?
Dialogue: 0,0:18:28.52,0:18:31.48,Default,,0,0,0,,Мұндай жерге кіруге болады ма?
Dialogue: 0,0:18:31.56,0:18:33.82,Default,,0,0,0,,Жарайды, өйткені мен осындамын.
Dialogue: 0,0:18:33.90,0:18:36.99,Default,,0,0,0,,Соңғы кездері анам ұйықтай алмай жүрген сияқты.
Dialogue: 0,0:18:37.07,0:18:40.24,Default,,0,0,0,,Сіз жиі қорқынышты түс көретін сияқтысыз.
Dialogue: 0,0:18:41.07,0:18:42.49,Default,,0,0,0,,-Мм... -(Мяре) Хмм?
Dialogue: 0,0:18:42.57,0:18:44.49,Default,,0,0,0,,Мияу~
Dialogue: 0,0:18:44.58,0:18:46.25,Default,,0,0,0,,-Ваза? -Няу
Dialogue: 0,0:18:47.04,0:18:48.50,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:18:55.34,0:18:57.59,Default,,0,0,0,,Беллдің көзін ала алмаймын
Dialogue: 0,0:18:57.67,0:19:00.26,Default,,0,0,0,,Қасиетті судың әсері жоқ...
Dialogue: 0,0:19:00.34,0:19:03.43,Default,,0,0,0,,Лилит-сама, осы ваза себеп болған сияқты.
Dialogue: 0,0:19:03.51,0:19:06.35,Default,,0,0,0,,Орынды жылжытқан дұрыс немесе кәдеге жарату.
Dialogue: 0,0:19:06.43,0:19:08.85,Default,,0,0,0,,Патшайымға кеңес бере аласыз ба?
Dialogue: 0,0:19:08.93,0:19:10.27,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:19:10.89,0:19:13.44,Default,,0,0,0,,Оның үстіне сыйлық береміз дейді...
Dialogue: 0,0:19:13.52,0:19:16.78,Default,,0,0,0,,Сиқыр туралы бірнеше кітаптар бар.
Dialogue: 0,0:19:16.86,0:19:18.94,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:19:16.86,0:19:18.94,Default,,0,0,0,,Мен сендерге сиқырға байланысты кітаптарды оқуға рұқсат етуді шештім.
Dialogue: 0,0:19:18.94,0:19:20.65,Default,,0,0,0,,Мен сендерге сиқырға қатысты кітаптарды оқуға рұқсат етуді шештім.
Dialogue: 0,0:19:20.74,0:19:24.70,Default,,0,0,0,,Тыңдаңыз, оны өзіңізбен бірге алып шығуға қатаң тыйым салынады, тек оқыңыз.
Dialogue: 0,0:19:24.78,0:19:26.03,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:19:27.49,0:19:31.92,Default,,0,0,0,,«Голем өндірісінің негіздері және қолданылуы» Бұл не?
Dialogue: 0,0:19:32.00,0:19:36.04,Default,,0,0,0,,«Голем жасау үшін ядро ​​керек»?
Dialogue: 0,0:19:36.13,0:19:39.92,Default,,0,0,0,,«Шақыру технологиясының тарихы және практикалық мысалдары»
Dialogue: 0,0:19:40.01,0:19:45.93,Default,,0,0,0,,«Spell Construction Basic Edition» «Жетілдірілген басылым» «Практикалық басылым» Барлық 3 том
Dialogue: 0,0:19:46.01,0:19:48.06,Default,,0,0,0,,«Тыйым салынған сиқырға апаратын ауру»
Dialogue: 0,0:19:48.14,0:19:50.06,Default,,0,0,0,,Мұнымен не істеуіміз керек?
Dialogue: 0,0:19:50.14,0:19:51.94,Default,,0,0,0,,Көшіру…
Dialogue: 0,0:19:55.56,0:19:56.94,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:19:57.02,0:19:59.40,Default,,0,0,0,,Бірақ бұл жаман нәрсе, солай ма?
Dialogue: 0,0:19:59.48,0:20:01.32,Default,,0,0,0,,Не? А... Анемон
Dialogue: 0,0:20:01.40,0:20:05.82,Default,,0,0,0,,Ойланып қарашы, біз ханшайымға қаншалықты ерік бердік.
Dialogue: 0,0:20:07.33,0:20:08.58,Default,,0,0,0,,Иә, жасайық!
Dialogue: 0,0:20:10.25,0:20:12.79,Default,,0,0,0,,4 жарым сағатта 35 кітап
Dialogue: 0,0:20:12.87,0:20:14.67,Default,,0,0,0,,Жарайды, тез қайтайық.
Dialogue: 0,0:20:14.75,0:20:15.58,Default,,0,0,0,,Иә
Dialogue: 0,0:20:17.13,0:20:19.42,Default,,0,0,0,,-Ханшайым, келмедің. -Ой.
Dialogue: 0,0:20:19.50,0:20:20.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:21.13,0:20:23.13,Default,,0,0,0,,Сіз осынша уақыт күттіңіз бе?
Dialogue: 0,0:20:23.22,0:20:24.34,Default,,0,0,0,,Бұл жұмыс.
Dialogue: 0,0:20:24.43,0:20:26.30,Default,,0,0,0,,Жарайды, бұл көзге той болды.
Dialogue: 0,0:20:26.39,0:20:27.80,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:20:27.89,0:20:30.97,Default,,0,0,0,,Бағасы жоқ көптеген құнды кітаптар бар.
Dialogue: 0,0:20:31.06,0:20:33.77,Default,,0,0,0,,Мен дұрыс емес жерге қойған кітап бар.
Dialogue: 0,0:20:33.85,0:20:35.60,Default,,0,0,0,,Мен оны кейінірек түзетемін.
Dialogue: 0,0:20:35.69,0:20:39.11,Default,,0,0,0,,Осындай құнды кітапты көшіріп алдым деп айта алмаймын.
Dialogue: 0,0:20:39.19,0:20:42.24,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:20:48.74,0:20:50.12,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:20:51.29,0:20:53.62,Default,,0,0,0,,Хмм... Сен осындасың ба, Кеничи?
Dialogue: 0,0:20:53.71,0:20:55.25,Default,,0,0,0,,Сіз қоңырау шалып жатырсыз ба?
Dialogue: 0,0:20:56.46,0:21:00.50,Default,,0,0,0,,Майлин сияқты қыздар ұнай ма?
Dialogue: 0,0:21:00.59,0:21:02.84,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:21:02.92,0:21:06.01,Default,,0,0,0,,Шынымды айтсам, бұл маған ұнайды, бірақ бұл не?
Dialogue: 0,0:21:06.09,0:21:07.22,Default,,0,0,0,,Бұл сыйлық.
Dialogue: 0,0:21:07.30,0:21:10.01,Default,,0,0,0,,Майренмен қалағаныңды істе.
Dialogue: 0,0:21:10.10,0:21:12.52,Default,,0,0,0,,Өйткені менің де әйелім бар.
Dialogue: 0,0:21:12.60,0:21:15.10,Default,,0,0,0,,Бұл таңқаларлық қиын.
Dialogue: 0,0:21:15.19,0:21:19.77,Default,,0,0,0,,Кейбір дворяндар қарсыластарын азаптау үшін сиқырлы құралдарды қолданатын сияқты.
Dialogue: 0,0:21:19.86,0:21:22.28,Default,,0,0,0,,Сіздің заттар қорабында не бар?
Dialogue: 0,0:21:22.36,0:21:25.53,Default,,0,0,0,,Ондай нәрсе жоқ па?
Dialogue: 0,0:21:25.61,0:21:27.20,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:21:27.78,0:21:28.91,Default,,0,0,0,,Ум...
Dialogue: 0,0:21:34.00,0:21:36.92,Default,,0,0,0,,Маған мейірімді бола аласыз ба?
Dialogue: 0,0:21:40.50,0:21:42.13,Default,,0,0,0,,Эй!
Dialogue: 0,0:21:40.50,0:21:42.13,Default,,0,0,0,,(Лилиттің күлкісі)
Dialogue: 0,0:21:42.13,0:21:42.21,Default,,0,0,0,,(Лилиттің күлкісі)
Dialogue: 0,0:21:42.21,0:21:43.38,Default,,0,0,0,,(Лилиттің күлкісі)
Dialogue: 0,0:21:42.21,0:21:43.38,Default,,0,0,0,,Әй... Ханшайым, қарамашы өтінемін!
Dialogue: 0,0:21:43.38,0:21:44.92,Default,,0,0,0,,Сәлем... Ханшайым, қарамашы өтінемін!
Dialogue: 0,0:21:51.10,0:21:53.10,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:21:53.18,0:21:54.60,Default,,0,0,0,,Және…
Dialogue: 0,0:21:58.10,0:21:59.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:01.57,0:22:03.82,Default,,0,0,0,,Көрермендер күні келді
Dialogue: 0,0:22:06.03,0:22:10.03,Default,,0,0,0,,♪～
Dialogue: 0,0:23:32.28,0:23:35.95,Default,,0,0,0,,～♪
