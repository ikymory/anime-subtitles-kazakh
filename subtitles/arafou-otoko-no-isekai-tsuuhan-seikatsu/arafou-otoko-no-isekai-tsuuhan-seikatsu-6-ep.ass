Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.25,0:00:09.92,Default,,0,0,0,,Уау! Керемет! Керемет!
Dialogue: 0,0:00:11.63,0:00:13.55,Default,,0,0,0,,Біз жаңа әлемге ұмтыламыз
Dialogue: 0,0:00:13.63,0:00:15.26,Default,,0,0,0,,Мен сапардамын Уау~
Dialogue: 0,0:00:15.34,0:00:16.18,Default,,0,0,0,,Мен қазір қандаймын...
Dialogue: 0,0:00:16.26,0:00:18.60,Default,,0,0,0,,Далиядан 100 шақырымдай жерде
Dialogue: 0,0:00:18.68,0:00:20.72,Default,,0,0,0,,Тағы 5-6 км жүрсеңіз, келесі қалашыққа жетесіз.
Dialogue: 0,0:00:20.81,0:00:23.27,Default,,0,0,0,,Олар Астрантияға келетін сияқты.
Dialogue: 0,0:00:23.77,0:00:26.19,Default,,0,0,0,,Өзен балығынан жасалған балық сорпасы
Dialogue: 0,0:00:26.27,0:00:27.44,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:00:27.52,0:00:28.23,Default,,0,0,0,,Хмм…
Dialogue: 0,0:00:28.23,0:00:28.65,Default,,0,0,0,,Хмм…
Dialogue: 0,0:00:28.23,0:00:28.65,Default,,0,0,0,,Өзен жағасынан балық аулап, балық сорпасын дайында...
Dialogue: 0,0:00:28.65,0:00:30.98,Default,,0,0,0,,Өзен жағасынан балық аулап, балық сорпасын дайында...
Dialogue: 0,0:00:31.07,0:00:33.53,Default,,0,0,0,,Бұл өте баяу өмір сияқты.
Dialogue: 0,0:00:33.61,0:00:35.03,Default,,0,0,0,,Бұл дәмді!
Dialogue: 0,0:00:35.11,0:00:37.91,Default,,0,0,0,,Кеничидің барлық тағамдары дәмді!
Dialogue: 0,0:00:38.45,0:00:40.70,Default,,0,0,0,,Анемон өзінің 12 жаста екенін айтты.
Dialogue: 0,0:00:40.79,0:00:42.95,Default,,0,0,0,,Ол үшін оның денесі кішкентай.
Dialogue: 0,0:00:43.04,0:00:44.50,Default,,0,0,0,,Бұл балаға да
Dialogue: 0,0:00:44.58,0:00:46.96,Default,,0,0,0,,Мен өмірімнің негізін мүмкіндігінше тезірек орнатқым келеді, бірақ...
Dialogue: 0,0:00:47.96,0:00:50.13,Default,,0,0,0,,Керемет ұшу!
Dialogue: 0,0:00:50.21,0:00:51.46,Default,,0,0,0,,Бұл сиқыр ма?
Dialogue: 0,0:00:51.55,0:00:53.21,Default,,0,0,0,,Жақсы
Dialogue: 0,0:00:53.30,0:00:57.97,Default,,0,0,0,,Ху~ Бұл өзен көлге құя ма?
Dialogue: 0,0:00:58.64,0:01:01.47,Default,,0,0,0,,Астрантия қаласы сол жерде ме?
Dialogue: 0,0:01:02.06,0:01:04.85,Default,,0,0,0,,Көлге барайық, көрікті жерді табайық.
Dialogue: 0,0:01:04.93,0:01:05.85,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:20.28,0:01:21.20,Default,,0,0,0,,-(Орман мысығы) Ня... -Аха хахаха...
Dialogue: 0,0:01:21.28,0:01:23.20,Default,,0,0,0,,Мияу!
Dialogue: 0,0:01:21.28,0:01:23.20,Default,,0,0,0,,(Анемонның күлкісі)
Dialogue: 0,0:01:23.20,0:01:26.46,Default,,0,0,0,,(Анемонның күлкісі)
Dialogue: 0,0:01:28.04,0:01:30.96,Default,,0,0,0,,Мен әрқашан Құдайдан сұрадым
Dialogue: 0,0:01:31.04,0:01:33.38,Default,,0,0,0,,Мен құтқарылғым келгендіктен дұға еттім.
Dialogue: 0,0:01:34.21,0:01:36.17,Default,,0,0,0,,Кейде тіпті көз жасым да төгіледі.
Dialogue: 0,0:01:36.26,0:01:38.01,Default,,0,0,0,,Бұл қыз
Dialogue: 0,0:01:38.84,0:01:43.64,Default,,0,0,0,,Бірақ қазір мен сапардамын, оны Кеничи құдайым құтқарды.
Dialogue: 0,0:01:43.72,0:01:47.98,Default,,0,0,0,,Ах~ мен де бүгін көп жегім келеді.
Dialogue: 0,0:01:48.56,0:01:52.44,Default,,0,0,0,,♪～
Dialogue: 0,0:03:11.90,0:03:16.48,Default,,0,0,0,,～♪
Dialogue: 0,0:03:17.98,0:03:20.78,Default,,0,0,0,,(Сарқыраманың дыбысы)
Dialogue: 0,0:03:21.82,0:03:22.78,Default,,0,0,0,,Көрініс те тамаша.
Dialogue: 0,0:03:22.86,0:03:24.82,Default,,0,0,0,,Сіз осы жерде тұрасыз ба?
Dialogue: 0,0:03:24.91,0:03:25.78,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:26.53,0:03:27.58,Default,,0,0,0,,(Кашива қолы)
Dialogue: 0,0:03:27.66,0:03:30.50,Default,,0,0,0,,Кашикоми ~ Кашикоми ~ Мен ~ деймін
Dialogue: 0,0:03:30.58,0:03:31.41,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:03:31.50,0:03:32.46,Default,,0,0,0,,Үйге шақыру!
Dialogue: 0,0:03:33.50,0:03:35.79,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:03:35.88,0:03:37.00,Default,,0,0,0,,Бірақ қызық емес пе?
Dialogue: 0,0:03:37.09,0:03:38.63,Default,,0,0,0,,- (Орман мысығы) Мяу - Хаха...
Dialogue: 0,0:03:38.71,0:03:39.55,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:03:39.63,0:03:41.17,Default,,0,0,0,,Фу…
Dialogue: 0,0:03:42.55,0:03:45.47,Default,,0,0,0,,Қара қара қарға... Мм.
Dialogue: 0,0:03:45.55,0:03:47.43,Default,,0,0,0,,- (Орман мысығы) Мя - А, сосын Том.
Dialogue: 0,0:03:48.22,0:03:49.35,Default,,0,0,0,,- Мм - (Орман мысығы) Мияу
Dialogue: 0,0:03:49.43,0:03:50.85,Default,,0,0,0,,-У-у-(Орман мысығы) Мяу~
Dialogue: 0,0:03:49.43,0:03:50.85,Default,,0,0,0,,Родем
Dialogue: 0,0:03:50.93,0:03:52.10,Default,,0,0,0,,- Уун - (Орман мысығы) Мяу
Dialogue: 0,0:03:50.93,0:03:52.10,Default,,0,0,0,,квартал
Dialogue: 0,0:03:52.19,0:03:53.23,Default,,0,0,0,,- Уун - (Орман мысығы) Мияу
Dialogue: 0,0:03:52.19,0:03:53.23,Default,,0,0,0,,Джиджи…
Dialogue: 0,0:03:53.31,0:03:54.77,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:03:54.85,0:03:55.81,Default,,0,0,0,,-Мууу... -(Орман мысығы) Айнала...
Dialogue: 0,0:03:56.52,0:03:58.32,Default,,0,0,0,,Ах... барқыт
Dialogue: 0,0:03:58.86,0:04:00.74,Default,,0,0,0,,Қоңырау! Белл ше?
Dialogue: 0,0:04:00.82,0:04:02.82,Default,,0,0,0,,Өте сүйкімді! Менің ойымша, бұл жақсы
Dialogue: 0,0:04:02.90,0:04:04.70,Default,,0,0,0,,Танысқаныма қуаныштымын Белл
Dialogue: 0,0:04:04.78,0:04:05.95,Default,,0,0,0,,Мя~
Dialogue: 0,0:04:07.03,0:04:11.96,Default,,0,0,0,,«Менің атым»
Dialogue: 0,0:04:12.04,0:04:14.96,Default,,0,0,0,,«Бұл анемон».
Dialogue: 0,0:04:15.04,0:04:17.88,Default,,0,0,0,,Сіздің оқу және жазу дағдыларыңыз енді тамаша.
Dialogue: 0,0:04:17.96,0:04:19.05,Default,,0,0,0,,-Эхехе -Ах...
Dialogue: 0,0:04:19.13,0:04:20.51,Default,,0,0,0,,Келесі - есептеу
Dialogue: 0,0:04:20.59,0:04:21.84,Default,,0,0,0,,Мм.
Dialogue: 0,0:04:25.01,0:04:25.84,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:25.93,0:04:27.14,Default,,0,0,0,,Шангри-Лаға
Dialogue: 0,0:04:27.22,0:04:28.43,Default,,0,0,0,,Дизель майы жоқ
Dialogue: 0,0:04:28.51,0:04:30.39,Default,,0,0,0,,Қазір мен ақ керосинді қолданамын.
Dialogue: 0,0:04:30.47,0:04:32.85,Default,,0,0,0,,Оны арзандатуға бола ма?
Dialogue: 0,0:04:32.93,0:04:33.98,Default,,0,0,0,,Теледидардан бұрын
Dialogue: 0,0:04:34.06,0:04:36.77,Default,,0,0,0,,Темпурадан алынған мұнай қалдықтарын пайдаланатын биодизельдік отын
Dialogue: 0,0:04:36.85,0:04:38.56,Default,,0,0,0,,Мен оны бұрын көргенмін.
Dialogue: 0,0:04:38.65,0:04:41.94,Default,,0,0,0,,Мен кітап сатып алып, біраз зерттеуім керек пе?
Dialogue: 0,0:04:45.15,0:04:45.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:46.07,0:04:47.78,Default,,0,0,0,,- Не істеп жатырсың? -Мияу?
Dialogue: 0,0:04:47.87,0:04:49.20,Default,,0,0,0,,Кітап оқу
Dialogue: 0,0:04:49.28,0:04:50.66,Default,,0,0,0,,Менің де оқығым келеді!
Dialogue: 0,0:04:50.74,0:04:53.12,Default,,0,0,0,,Жоқ, бұл елдің жазуынан бөлек.
Dialogue: 0,0:04:53.20,0:04:54.33,Default,,0,0,0,,Сіз оны оқи алмайсыз.
Dialogue: 0,0:04:54.41,0:04:57.50,Default,,0,0,0,,Кеничи елінің тілін үйрен!
Dialogue: 0,0:04:59.21,0:05:01.38,Default,,0,0,0,,«жай»
Dialogue: 0,0:05:01.46,0:05:04.63,Default,,0,0,0,,«Охисамага»
Dialogue: 0,0:05:05.47,0:05:08.30,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:05:08.39,0:05:09.89,Default,,0,0,0,,Жарайды, осындай нәрсе.
Dialogue: 0,0:05:09.97,0:05:11.39,Default,,0,0,0,,(Жапырақтардың сыбдыры)
Dialogue: 0,0:05:11.39,0:05:12.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:12.43,0:05:12.52,Default,,0,0,0,,(Жапырақтардың сыбдыры)
Dialogue: 0,0:05:12.52,0:05:14.10,Default,,0,0,0,,Құбыжық?
Dialogue: 0,0:05:14.10,0:05:15.02,Default,,0,0,0,,(Жапырақтардың сыбдыры)
Dialogue: 0,0:05:16.60,0:05:17.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:17.52,0:05:19.23,Default,,0,0,0,,Мия!
Dialogue: 0,0:05:19.73,0:05:20.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:20.73,0:05:21.65,Default,,0,0,0,,Няха!
Dialogue: 0,0:05:23.03,0:05:23.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:23.99,0:05:26.24,Default,,0,0,0,,Мен сені кездестірдім~
Dialogue: 0,0:05:26.32,0:05:27.36,Default,,0,0,0,,Майаре?
Dialogue: 0,0:05:27.45,0:05:30.66,Default,,0,0,0,,Бұл қорқынышты, мен оны сонда қалдырғаныма сене алар емеспін!
Dialogue: 0,0:05:30.74,0:05:31.66,Default,,0,0,0,,Фумя!
Dialogue: 0,0:05:31.74,0:05:33.16,Default,,0,0,0,,Орман мысығы мен Кеничидің арбасының иісіне ерген адам
Dialogue: 0,0:05:33.16,0:05:34.75,Default,,0,0,0,,Мори Неко-сама мен Кеничи арбасының иісіне ерген адам
Dialogue: 0,0:05:33.16,0:05:34.75,Default,,0,0,0,,Мя мя мя...
Dialogue: 0,0:05:34.75,0:05:34.83,Default,,0,0,0,,Мя мыя...
Dialogue: 0,0:05:34.83,0:05:37.08,Default,,0,0,0,,Мя мя мя...
Dialogue: 0,0:05:34.83,0:05:37.08,Default,,0,0,0,,Бұл мәселе болды.
Dialogue: 0,0:05:37.17,0:05:39.75,Default,,0,0,0,,Мя мя мя мя~
Dialogue: 0,0:05:39.83,0:05:40.67,Default,,0,0,0,,О!
Dialogue: 0,0:05:40.75,0:05:41.92,Default,,0,0,0,,Мия!
Dialogue: 0,0:05:44.01,0:05:45.92,Default,,0,0,0,,-Ня? -Ой, бұл Майаре!
Dialogue: 0,0:05:46.67,0:05:47.63,Default,,0,0,0,,-(Мияу) Мяу~ -Ахаха...
Dialogue: 0,0:05:47.72,0:05:49.68,Default,,0,0,0,,Анемон да менімен кездескісі келді
Dialogue: 0,0:05:49.76,0:05:52.26,Default,,0,0,0,,Сен енді бізбен бірге тұрасың.
Dialogue: 0,0:05:52.35,0:05:54.06,Default,,0,0,0,,Мияу, мияу, мияу!
Dialogue: 0,0:05:52.35,0:05:54.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:55.06,0:05:56.06,Default,,0,0,0,,Олар сіздің жағдайыңызды өздеріне тапсыруымды сұрады.
Dialogue: 0,0:05:56.14,0:05:59.27,Default,,0,0,0,,Мен кеткеннен кейін Далия өзгерген жоқ па?
Dialogue: 0,0:05:59.35,0:06:00.77,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:00.86,0:06:01.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:01.77,0:06:05.44,Default,,0,0,0,,Солтүстік полюс Майраның қызына тұрмысқа шығуды ұсынды.
Dialogue: 0,0:06:05.53,0:06:09.41,Default,,0,0,0,,Үйлену туралы ұсыныс сіздің заңды әйеліңіз болуды білдіреді.
Dialogue: 0,0:06:05.53,0:06:09.41,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:06:09.49,0:06:11.12,Default,,0,0,0,,Бұл шар сүзгісі ме?
Dialogue: 0,0:06:11.20,0:06:13.20,Default,,0,0,0,,Үйлену тойына қатыса алсам ғой.
Dialogue: 0,0:06:13.28,0:06:14.58,Default,,0,0,0,,Мен…
Dialogue: 0,0:06:16.79,0:06:18.37,Default,,0,0,0,,Хэхехе~
Dialogue: 0,0:06:19.62,0:06:20.46,Default,,0,0,0,,Ммм
Dialogue: 0,0:06:20.54,0:06:22.46,Default,,0,0,0,,Ах~
Dialogue: 0,0:06:22.54,0:06:24.34,Default,,0,0,0,,Мияу~
Dialogue: 0,0:06:24.42,0:06:26.21,Default,,0,0,0,,Ня~
Dialogue: 0,0:06:28.30,0:06:30.30,Default,,0,0,0,,Бұл кітап па?
Dialogue: 0,0:06:30.38,0:06:31.22,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:31.30,0:06:33.93,Default,,0,0,0,,Қандай әдемі сурет!
Dialogue: 0,0:06:34.01,0:06:35.77,Default,,0,0,0,,Мұны тіпті біз де түсінеміз!
Dialogue: 0,0:06:35.85,0:06:37.27,Default,,0,0,0,,Я~ Түсіндім.
Dialogue: 0,0:06:35.85,0:06:37.27,Default,,0,0,0,,- Дұрыс па? - (Майаре) Хаха...
Dialogue: 0,0:06:37.35,0:06:39.73,Default,,0,0,0,,Оқымасаң да, суретті кітап болса...
Dialogue: 0,0:06:37.35,0:06:39.73,Default,,0,0,0,,Бұл керемет! Ол әдемі!
Dialogue: 0,0:06:39.81,0:06:42.44,Default,,0,0,0,,Кітап бұл дүниеде қымбат.
Dialogue: 0,0:06:39.81,0:06:42.44,Default,,0,0,0,,Кеничи елінен емес пе?
Dialogue: 0,0:06:42.44,0:06:42.52,Default,,0,0,0,,Кеничи елінен емес пе?
Dialogue: 0,0:06:42.52,0:06:43.06,Default,,0,0,0,,Кеничи елінен емес пе?
Dialogue: 0,0:06:42.52,0:06:43.06,Default,,0,0,0,,Жұқа болса да сатады
Dialogue: 0,0:06:43.06,0:06:43.15,Default,,0,0,0,,Жұқа болса да сатады
Dialogue: 0,0:06:43.15,0:06:44.15,Default,,0,0,0,,Жұқа болса да сатады
Dialogue: 0,0:06:43.15,0:06:44.15,Default,,0,0,0,,Тағы бар ма?
Dialogue: 0,0:06:44.15,0:06:44.23,Default,,0,0,0,,Жұқа болса да сатады
Dialogue: 0,0:06:44.23,0:06:44.65,Default,,0,0,0,,Жұқа болса да сатады
Dialogue: 0,0:06:44.23,0:06:44.65,Default,,0,0,0,,-Не~ -(Мяре) Уау~
Dialogue: 0,0:06:44.65,0:06:44.73,Default,,0,0,0,,-Не~ -(Мяре) Уау~
Dialogue: 0,0:06:44.73,0:06:45.90,Default,,0,0,0,,-Не~ -(Мяре) Уау~
Dialogue: 0,0:06:44.73,0:06:45.90,Default,,0,0,0,,Суретті кітап?
Dialogue: 0,0:06:45.90,0:06:45.98,Default,,0,0,0,,Суретті кітап?
Dialogue: 0,0:06:45.98,0:06:46.44,Default,,0,0,0,,Суретті кітап...
Dialogue: 0,0:06:45.98,0:06:46.44,Default,,0,0,0,,Мен әдемі кітап көргім келеді.
Dialogue: 0,0:06:46.44,0:06:46.53,Default,,0,0,0,,Мен әдемі кітап көргім келеді.
Dialogue: 0,0:06:46.53,0:06:48.24,Default,,0,0,0,,Мен әдемі кітап көргім келеді.
Dialogue: 0,0:06:46.53,0:06:48.24,Default,,0,0,0,,Бірақ түпнұсқа дүниедегі ертегілерді суретті кітапқа айналдырсақ жақсы болар еді...
Dialogue: 0,0:06:48.24,0:06:51.16,Default,,0,0,0,,Бірақ түпнұсқа дүниедегі ертегілерді суретті кітапқа айналдырсақ жақсы болар еді...
Dialogue: 0,0:06:51.24,0:06:55.16,Default,,0,0,0,,Ей, бұл елде қандай ертегілер бар?
Dialogue: 0,0:06:55.24,0:06:58.45,Default,,0,0,0,,Ах! Ежелгі патшайым және қасиетті рыцарь
Dialogue: 0,0:06:58.54,0:07:01.58,Default,,0,0,0,,Ал, орман перісінің оқиғасы!
Dialogue: 0,0:07:01.67,0:07:03.33,Default,,0,0,0,,Эльф? О...
Dialogue: 0,0:07:03.42,0:07:04.50,Default,,0,0,0,,Бұл қандай әңгіме?
Dialogue: 0,0:07:04.59,0:07:06.71,Default,,0,0,0,,Орманда тұратын пері
Dialogue: 0,0:07:06.80,0:07:09.55,Default,,0,0,0,,Мен адам ханзадасын кездестіріп, ғашық болдым.
Dialogue: 0,0:07:10.55,0:07:14.43,Default,,0,0,0,,Алайда, эльфтер де, адамдар да бұған мүлдем қарсы болды.
Dialogue: 0,0:07:14.51,0:07:17.31,Default,,0,0,0,,Эльф-сама өлтірілгелі жатыр.
Dialogue: 0,0:07:18.10,0:07:20.81,Default,,0,0,0,,Бірақ перілердің құдіретінің арқасында аман-есен құтылдым.
Dialogue: 0,0:07:21.39,0:07:25.27,Default,,0,0,0,,Екеуі орманның қойнауында бақытты өмір сүреді.
Dialogue: 0,0:07:36.87,0:07:37.74,Default,,0,0,0,,Ал...
Dialogue: 0,0:07:37.83,0:07:40.45,Default,,0,0,0,,Сонымен... өте керемет!
Dialogue: 0,0:07:40.54,0:07:42.00,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:07:42.62,0:07:43.50,Default,,0,0,0,,Олай болса, енді не болады?
Dialogue: 0,0:07:43.58,0:07:45.50,Default,,0,0,0,,Мен кітапты байлаймын.
Dialogue: 0,0:07:46.92,0:07:50.01,Default,,0,0,0,,-Хавава~ -(Мяре) Мямямья~
Dialogue: 0,0:07:50.09,0:07:51.01,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:07:51.09,0:07:52.34,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:52.43,0:07:53.51,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:53.59,0:07:56.10,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:07:56.60,0:07:58.60,Default,,0,0,0,,-(Мяре) Сурет салу қызық -хехе...
Dialogue: 0,0:07:58.68,0:08:00.52,Default,,0,0,0,,Майаре қай суретті ұнатады?
Dialogue: 0,0:08:00.60,0:08:02.89,Default,,0,0,0,,- (Мялей) Мен абдырап қалдым - А...
Dialogue: 0,0:08:04.73,0:08:06.65,Default,,0,0,0,,Анемон, үйге кір.
Dialogue: 0,0:08:06.73,0:08:08.65,Default,,0,0,0,,- Иә? -(Мяре) Не болды?
Dialogue: 0,0:08:08.73,0:08:11.40,Default,,0,0,0,,Тұтынушыға ұқсайды, мүмкін қуғыншы.
Dialogue: 0,0:08:11.49,0:08:12.86,Default,,0,0,0,,-Мяре - (Мяре) Ня?
Dialogue: 0,0:08:12.95,0:08:13.99,Default,,0,0,0,,Анемонды сұраңыз
Dialogue: 0,0:08:14.07,0:08:15.28,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:08:18.95,0:08:20.41,Default,,0,0,0,,-Бұл кім? -Аа...
Dialogue: 0,0:08:20.50,0:08:21.75,Default,,0,0,0,,Шақыру
Dialogue: 0,0:08:22.33,0:08:23.54,Default,,0,0,0,,Мұндағы мақсат не?
Dialogue: 0,0:08:23.62,0:08:26.75,Default,,0,0,0,,Күтіңіз, күтіңіз, мазалаған нәрсені қойыңыз.
Dialogue: 0,0:08:26.83,0:08:29.92,Default,,0,0,0,,Біз қарсы жағадағы Сантанка ауылының тұрғындарымыз.
Dialogue: 0,0:08:30.00,0:08:34.18,Default,,0,0,0,,Ай!
Dialogue: 0,0:08:35.43,0:08:38.51,Default,,0,0,0,,Сантанка ауылынан келген адамның мақсаты не?
Dialogue: 0,0:08:38.60,0:08:40.81,Default,,0,0,0,,Мұнда тұруға болмайды деген ереже бар емес пе?
Dialogue: 0,0:08:40.89,0:08:42.14,Default,,0,0,0,,О
Dialogue: 0,0:08:42.23,0:08:45.65,Default,,0,0,0,,Қарақшы болсақ та, сонда қоныстансақ, қиын болар еді.
Dialogue: 0,0:08:45.73,0:08:46.94,Default,,0,0,0,,Мен жаңа ғана тексеруге келдім.
Dialogue: 0,0:08:47.02,0:08:48.86,Default,,0,0,0,,Мен саудагермін
Dialogue: 0,0:08:48.94,0:08:50.90,Default,,0,0,0,,Бұл өте алаңдатады.
Dialogue: 0,0:08:50.98,0:08:54.15,Default,,0,0,0,,Қаладағы ұрыстан қаштым.
Dialogue: 0,0:08:54.24,0:08:55.07,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:55.15,0:08:56.45,Default,,0,0,0,,Мияу
Dialogue: 0,0:08:56.53,0:08:58.95,Default,,0,0,0,,Жоқ... Орман мысығы!
Dialogue: 0,0:08:59.03,0:09:01.45,Default,,0,0,0,,Ол менің отбасым
Dialogue: 0,0:09:01.54,0:09:04.66,Default,,0,0,0,,Адамдарға қосылмаған орман мысығы бекінеді...
Dialogue: 0,0:09:04.75,0:09:06.58,Default,,0,0,0,,Бұл күйеуінің жаман адам болуы мүмкін емес.
Dialogue: 0,0:09:06.67,0:09:09.88,Default,,0,0,0,,Олай дейтін болсаң, мен оның ештеңесі жоқ екеніне сенімдімін...
Dialogue: 0,0:09:09.96,0:09:12.30,Default,,0,0,0,,Өзімді таныстырып өтейін. Мен Кротонмын.
Dialogue: 0,0:09:12.38,0:09:13.59,Default,,0,0,0,,Біз мияулармыз
Dialogue: 0,0:09:13.67,0:09:15.13,Default,,0,0,0,,Бұл Кеничи
Dialogue: 0,0:09:13.67,0:09:15.13,Default,,0,0,0,,(судың шашырауы)
Dialogue: 0,0:09:16.34,0:09:17.97,Default,,0,0,0,,- Танысқаныма қуаныштымын - Танысқаныма қуаныштымын
Dialogue: 0,0:09:18.05,0:09:20.68,Default,,0,0,0,,Бұрын Астрантияда
Dialogue: 0,0:09:20.76,0:09:22.35,Default,,0,0,0,,Мен шенеунік болып жұмыс істедім.
Dialogue: 0,0:09:22.93,0:09:24.60,Default,,0,0,0,,Бұл менің табиғатым
Dialogue: 0,0:09:26.81,0:09:28.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:28.10,0:09:29.06,Default,,0,0,0,,Кротон
Dialogue: 0,0:09:29.15,0:09:30.61,Default,,0,0,0,,Ешқандай проблема жоқ, солай ма?
Dialogue: 0,0:09:30.69,0:09:32.32,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:09:32.40,0:09:33.36,Default,,0,0,0,,Ято-сама!
Dialogue: 0,0:09:33.44,0:09:36.28,Default,,0,0,0,,Айтпақшы, бұл сатылады ма?
Dialogue: 0,0:09:36.36,0:09:37.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:37.53,0:09:38.53,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:09:38.61,0:09:40.49,Default,,0,0,0,,Суретті кітабыңыз бірден сатылды ма?
Dialogue: 0,0:09:40.58,0:09:42.33,Default,,0,0,0,,Сол Кротонға
Dialogue: 0,0:09:42.41,0:09:45.29,Default,,0,0,0,,Оның Анемонмен құрдас қызы бар сияқты.
Dialogue: 0,0:09:45.37,0:09:47.50,Default,,0,0,0,,Бұл сыйлық болады.
Dialogue: 0,0:09:53.59,0:09:55.63,Default,,0,0,0,,Сақтау қоймасы
Dialogue: 0,0:09:55.72,0:09:57.88,Default,,0,0,0,,Сақтау қоймасы
Dialogue: 0,0:09:57.97,0:09:58.88,Default,,0,0,0,,Сақтау
Dialogue: 0,0:09:58.97,0:10:00.18,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:10:00.26,0:10:01.89,Default,,0,0,0,,О, емдік шөптер.
Dialogue: 0,0:10:01.97,0:10:03.47,Default,,0,0,0,,Мияу
Dialogue: 0,0:10:03.56,0:10:06.56,Default,,0,0,0,,Әй, жүр, мен шөп жинап жатырмын.
Dialogue: 0,0:10:06.64,0:10:09.23,Default,,0,0,0,,Мұнда да анемондар жоқ.
Dialogue: 0,0:10:09.31,0:10:11.19,Default,,0,0,0,,А... бұл не, жылу маусымы?
Dialogue: 0,0:10:11.27,0:10:13.44,Default,,0,0,0,,А... Мен олай ойламаймын.
Dialogue: 0,0:10:13.52,0:10:15.36,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:10:17.82,0:10:18.65,Default,,0,0,0,,Күн ыстық!
Dialogue: 0,0:10:18.74,0:10:22.03,Default,,0,0,0,,Мен Далияны тастап, базамды жылжыттым.
Dialogue: 0,0:10:22.12,0:10:24.54,Default,,0,0,0,,Бос және баяу өмірге ұмтылу
Dialogue: 0,0:10:24.62,0:10:27.08,Default,,0,0,0,,Химиялық заттардан қорғайтын киім кию
Dialogue: 0,0:10:27.16,0:10:28.16,Default,,0,0,0,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,0:10:29.87,0:10:32.04,Default,,0,0,0,,Фу бухаа!
Dialogue: 0,0:10:32.13,0:10:34.46,Default,,0,0,0,,Бұл өте ыстық
Dialogue: 0,0:10:35.09,0:10:37.38,Default,,0,0,0,,Шатырдың ішінде сауна бар.
Dialogue: 0,0:10:38.76,0:10:40.51,Default,,0,0,0,,Қосылған саятшылықта
Dialogue: 0,0:10:40.59,0:10:43.80,Default,,0,0,0,,Олар биодизельдік отынды синтездеді.
Dialogue: 0,0:10:43.89,0:10:47.52,Default,,0,0,0,,Бұл өлімге әкелетін уды қолданатын қауіпті жұмыс болды, бірақ...
Dialogue: 0,0:10:47.60,0:10:49.14,Default,,0,0,0,,Егер біз бұл жетістікке жетсек
Dialogue: 0,0:10:49.23,0:10:52.19,Default,,0,0,0,,Жанармайды арзан сатып алуға болады
Dialogue: 0,0:10:52.27,0:10:55.07,Default,,0,0,0,,(қозғалтқыштың іске қосу дыбысы)
Dialogue: 0,0:10:55.15,0:10:56.98,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:57.07,0:10:59.20,Default,,0,0,0,,Әзірге мен қалаған нәрсеге қол жеткіздім.
Dialogue: 0,0:10:59.28,0:11:00.78,Default,,0,0,0,,…Nodaga
Dialogue: 0,0:11:00.86,0:11:01.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:00.86,0:11:01.82,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:11:01.91,0:11:07.08,Default,,0,0,0,,Мен соңғы бірнеше күнде отын өңдеумен айналыстым.
Dialogue: 0,0:11:07.66,0:11:09.33,Default,,0,0,0,,Ах... Енді, Анемон.
Dialogue: 0,0:11:09.41,0:11:11.50,Default,,0,0,0,,Жаңа суретті кітап жасауым керек пе?
Dialogue: 0,0:11:11.58,0:11:13.08,Default,,0,0,0,,-Хмф -Хаха...
Dialogue: 0,0:11:13.17,0:11:14.17,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:11:14.25,0:11:17.21,Default,,0,0,0,,Мен жақында Астрантияға баруды ойлап жүрмін.
Dialogue: 0,0:11:17.30,0:11:18.55,Default,,0,0,0,,Менімен барғың келе ме?
Dialogue: 0,0:11:18.63,0:11:19.76,Default,,0,0,0,,- (Мяре) Кеттік - Ой...
Dialogue: 0,0:11:19.84,0:11:21.84,Default,,0,0,0,,Ах... мен де!
Dialogue: 0,0:11:22.64,0:11:23.89,Default,,0,0,0,,Астрантияға
Dialogue: 0,0:11:23.97,0:11:27.35,Default,,0,0,0,,Ол жерде бірнеше рет болған Мьяли маған айнала көрсетті.
Dialogue: 0,0:11:28.39,0:11:30.48,Default,,0,0,0,,Мен үйден тура шыға алмадым.
Dialogue: 0,0:11:30.56,0:11:32.60,Default,,0,0,0,,10 шақырымдай жол жүрді.
Dialogue: 0,0:11:32.69,0:11:35.52,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:11:35.61,0:11:37.69,Default,,0,0,0,,Майаре мен осы жерден жаяу барамын.
Dialogue: 0,0:11:37.78,0:11:38.61,Default,,0,0,0,,Мияу!
Dialogue: 0,0:11:44.87,0:11:45.45,Default,,0,0,0,,Енді Астрантияда бірінші бару керек
Dialogue: 0,0:11:45.45,0:11:47.62,Default,,0,0,0,,Енді, Астрантияда, бірінші бару керек
Dialogue: 0,0:11:45.45,0:11:47.62,Default,,0,0,0,,О~
Dialogue: 0,0:11:51.12,0:11:53.67,Default,,0,0,0,,Бұл қаладағы авантюристер гильдиясы.
Dialogue: 0,0:11:54.46,0:11:57.38,Default,,0,0,0,,(Авантюристер дауысы)
Dialogue: 0,0:11:58.00,0:11:59.92,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:12:00.01,0:12:02.01,Default,,0,0,0,,Сізге қандай кәсіп керек?
Dialogue: 0,0:12:02.09,0:12:03.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:03.97,0:12:04.80,Default,,0,0,0,,-Ах... -(Мяре) Ня...
Dialogue: 0,0:12:04.89,0:12:05.76,Default,,0,0,0,,А...
Dialogue: 0,0:12:05.85,0:12:07.64,Default,,0,0,0,,Хаха... Астрантияда Хмм
Dialogue: 0,0:12:07.64,0:12:07.72,Default,,0,0,0,,Мм.
Dialogue: 0,0:12:07.72,0:12:09.52,Default,,0,0,0,,Хмм, мен тіркеуді сұрағым келеді.
Dialogue: 0,0:12:09.60,0:12:10.81,Default,,0,0,0,,Мен сізге бір жақсылық сұрағым келеді.
Dialogue: 0,0:12:10.89,0:12:12.81,Default,,0,0,0,,Сізде гильдия куәлігі бар ма?
Dialogue: 0,0:12:12.89,0:12:14.81,Default,,0,0,0,,Далияда Саудагерлер гильдиясымен
Dialogue: 0,0:12:14.90,0:12:17.06,Default,,0,0,0,,Авантюрист гильдиясында бұрыннан тіркелген.
Dialogue: 0,0:12:17.15,0:12:19.57,Default,,0,0,0,,Біз тек авантюристер гильдиямыз.
Dialogue: 0,0:12:19.65,0:12:22.32,Default,,0,0,0,,Кешіріңіз, сәл күтіңіз.
Dialogue: 0,0:12:22.32,0:12:22.78,Default,,0,0,0,,Кешіріңіз, сәл күтіңіз.
Dialogue: 0,0:12:22.32,0:12:22.78,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:22.78,0:12:22.86,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:22.86,0:12:23.78,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:22.86,0:12:23.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:23.78,0:12:24.70,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:24.78,0:12:27.20,Default,,0,0,0,,-(Мяу) Ня... -Мух!
Dialogue: 0,0:12:27.28,0:12:28.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:27.28,0:12:28.83,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:28.91,0:12:30.83,Default,,0,0,0,,А, бұл! Кеничи мырза
Dialogue: 0,0:12:30.91,0:12:33.46,Default,,0,0,0,,Далияда Шағаны жеңген сен бе?
Dialogue: 0,0:12:33.54,0:12:36.96,Default,,0,0,0,,О, күте тұрыңыз! Жеке ақпараттың ағып кетуіне алаңдамаңыз
Dialogue: 0,0:12:37.04,0:12:39.21,Default,,0,0,0,,ше? жеке ақпарат?
Dialogue: 0,0:12:39.30,0:12:40.59,Default,,0,0,0,,Әйтеуір
Dialogue: 0,0:12:40.67,0:12:42.34,Default,,0,0,0,,Мұны ашық түрде жасамаңыз.
Dialogue: 0,0:12:42.42,0:12:43.30,Default,,0,0,0,,Иә, кешіріңіз...
Dialogue: 0,0:12:43.30,0:12:44.55,Default,,0,0,0,,Иә, кешіріңіз... Кеничи ең күшті! Кеничи Құдай!
Dialogue: 0,0:12:44.55,0:12:44.63,Default,,0,0,0,,Кеничи - ең күшті! Кеничи Құдай!
Dialogue: 0,0:12:44.63,0:12:45.97,Default,,0,0,0,,Кеничи - ең күшті! Кеничи Құдай! (Мяу) Мяу~
Dialogue: 0,0:12:46.05,0:12:47.80,Default,,0,0,0,,-Анемон... -(Қабылдау қызметкері) Хехехе...
Dialogue: 0,0:12:49.05,0:12:50.60,Default,,0,0,0,,Тіркеу аяқталды
Dialogue: 0,0:12:50.68,0:12:53.81,Default,,0,0,0,,Тіркелу жарнасы - бір адамға 1 күміс монета.
Dialogue: 0,0:12:54.52,0:12:56.48,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:12:56.56,0:12:58.27,Default,,0,0,0,,Күріш күріш!
Dialogue: 0,0:12:59.02,0:13:00.27,Default,,0,0,0,,Бұл дүниеде
Dialogue: 0,0:13:00.36,0:13:04.65,Default,,0,0,0,,Сорпа әдетте жай ғана қайнатылған көкөністер мен қоймасыз ет.
Dialogue: 0,0:13:04.74,0:13:05.70,Default,,0,0,0,,Хмм…
Dialogue: 0,0:13:05.78,0:13:06.78,Default,,0,0,0,,Ниа, бізге тез арада мұндадан кету керек.
Dialogue: 0,0:13:06.86,0:13:08.82,Default,,0,0,0,,Менің тағамымды жеуге дағдыланған екі адам
Dialogue: 0,0:13:08.91,0:13:12.79,Default,,0,0,0,,Сіздің осылай көрінетініңіз табиғи нәрсе.
Dialogue: 0,0:13:15.66,0:13:17.42,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:13:17.50,0:13:19.17,Default,,0,0,0,,Сәл жақсарды ма?
Dialogue: 0,0:13:19.25,0:13:20.50,Default,,0,0,0,,Дәмі жақсырақ.
Dialogue: 0,0:13:20.59,0:13:22.17,Default,,0,0,0,,Мияу~
Dialogue: 0,0:13:24.17,0:13:25.38,Default,,0,0,0,,Онда болды ма?
Dialogue: 0,0:13:25.47,0:13:26.51,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:27.93,0:13:29.26,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:29.35,0:13:31.35,Default,,0,0,0,,Келіңіздер... а
Dialogue: 0,0:13:31.43,0:13:33.31,Default,,0,0,0,,Әлгі адам...
Dialogue: 0,0:13:34.18,0:13:35.85,Default,,0,0,0,,Кротон?
Dialogue: 0,0:13:38.10,0:13:39.23,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:13:42.69,0:13:45.44,Default,,0,0,0,,Snowflake құралдар дүкені…
Dialogue: 0,0:13:45.53,0:13:47.57,Default,,0,0,0,,Сиқыршының кемпір дүкені
Dialogue: 0,0:13:47.66,0:13:49.74,Default,,0,0,0,,Қазынаның иісін көрме!
Dialogue: 0,0:13:49.82,0:13:50.99,Default,,0,0,0,,Шашың байланған екен.
Dialogue: 0,0:13:52.33,0:13:54.75,Default,,0,0,0,,Сәлем, қош келдіңіз.
Dialogue: 0,0:13:54.83,0:13:56.58,Default,,0,0,0,,Бұл мен көрмеген бет
Dialogue: 0,0:13:54.83,0:13:56.58,Default,,0,0,0,,Шашың байланған екен.
Dialogue: 0,0:13:56.66,0:13:59.08,Default,,0,0,0,,А, мен Далияданмын, кемпір.
Dialogue: 0,0:13:59.17,0:14:01.13,Default,,0,0,0,,- (Кемпір) Кемпір! -Аа...
Dialogue: 0,0:14:01.21,0:14:02.13,Default,,0,0,0,,Ах... Ой!
Dialogue: 0,0:14:02.21,0:14:03.63,Default,,0,0,0,,О...
Dialogue: 0,0:14:03.71,0:14:06.63,Default,,0,0,0,,Кемпір... жоқ, әпке.
Dialogue: 0,0:14:06.72,0:14:08.43,Default,,0,0,0,,Бұл қандай құрал?
Dialogue: 0,0:14:08.51,0:14:09.55,Default,,0,0,0,,Хохохо…
Dialogue: 0,0:14:09.64,0:14:11.89,Default,,0,0,0,,Сіз осындай нәрселерге қызығасыз ба?
Dialogue: 0,0:14:11.97,0:14:13.72,Default,,0,0,0,,Бұл су ма?
Dialogue: 0,0:14:13.81,0:14:14.77,Default,,0,0,0,,О
Dialogue: 0,0:14:14.85,0:14:17.39,Default,,0,0,0,,Егер сіз осы жерге шарап құйсаңыз...
Dialogue: 0,0:14:20.15,0:14:21.65,Default,,0,0,0,,Оны жағыңыз
Dialogue: 0,0:14:23.27,0:14:24.11,Default,,0,0,0,,(жалау дыбысы)
Dialogue: 0,0:14:24.19,0:14:26.15,Default,,0,0,0,,Шарап...?
Dialogue: 0,0:14:26.24,0:14:28.57,Default,,0,0,0,,Біртүрлі жоғары алкоголь концентрациясы
Dialogue: 0,0:14:28.65,0:14:30.16,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:14:31.91,0:14:33.37,Default,,0,0,0,,Бұл су...
Dialogue: 0,0:14:33.45,0:14:34.41,Default,,0,0,0,,А, мүмкін
Dialogue: 0,0:14:34.49,0:14:38.41,Default,,0,0,0,,Бұл жоғарыдағы контейнердегіден белгілі бір құрамдас бөліктерді бөлу құралы ма?
Dialogue: 0,0:14:38.50,0:14:41.38,Default,,0,0,0,,Хохохо... Жақсы болжам.
Dialogue: 0,0:14:41.46,0:14:42.75,Default,,0,0,0,,Бұл сиқырлы құрал
Dialogue: 0,0:14:42.84,0:14:45.92,Default,,0,0,0,,Сіздің алдыңыздағы ыдыстағы сұйықтық төгілді.
Dialogue: 0,0:14:46.01,0:14:48.17,Default,,0,0,0,,Қалғандары осында түседі.
Dialogue: 0,0:14:48.26,0:14:51.14,Default,,0,0,0,,Ху~ Сиқырлы құралдар керемет
Dialogue: 0,0:14:51.22,0:14:52.05,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:52.14,0:14:56.68,Default,,0,0,0,,Осыны пайдалансаңыз, қуатты химиялық заттарды қолданбай-ақ биодизельді отынды пайдалануға болады...
Dialogue: 0,0:14:56.77,0:14:57.81,Default,,0,0,0,,Бұл қанша?
Dialogue: 0,0:14:57.89,0:15:01.48,Default,,0,0,0,,Иә? Сіз оны сатып алғыңыз келе ме? Сіз?
Dialogue: 0,0:15:01.56,0:15:02.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:04.82,0:15:05.94,Default,,0,0,0,,Жарайды, мен оны сатып алдым!
Dialogue: 0,0:15:06.03,0:15:07.69,Default,,0,0,0,,Кешіріңіз, бірақ бұл күміс монета...
Dialogue: 0,0:15:07.78,0:15:08.69,Default,,0,0,0,,Жоқ дейсіз бе?
Dialogue: 0,0:15:09.36,0:15:10.20,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:11.53,0:15:13.03,Default,,0,0,0,,Хехе...
Dialogue: 0,0:15:13.12,0:15:14.95,Default,,0,0,0,,- Мм... - (Кеничи/Әже) Хм?
Dialogue: 0,0:15:15.03,0:15:18.95,Default,,0,0,0,,Хохохо... Бұл жас ханымға қажет емес.
Dialogue: 0,0:15:19.04,0:15:21.37,Default,,0,0,0,,Өйткені, бұл сиқырлы кітап.
Dialogue: 0,0:15:21.46,0:15:23.83,Default,,0,0,0,,Сиқырлы кітап! Бұл жерде!
Dialogue: 0,0:15:24.50,0:15:25.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:24.50,0:15:25.50,Default,,0,0,0,,Оны оқу сиқырды қолдануға мүмкіндік бере ме?
Dialogue: 0,0:15:25.50,0:15:26.63,Default,,0,0,0,,Оны оқу сиқырды қолдануға мүмкіндік бере ме?
Dialogue: 0,0:15:26.71,0:15:29.72,Default,,0,0,0,,Жоқ, оны қанша сиқырлы күші жоқ адамдар оқыса да.
Dialogue: 0,0:15:29.80,0:15:31.84,Default,,0,0,0,,Бұл болмайды.
Dialogue: 0,0:15:31.93,0:15:34.97,Default,,0,0,0,,Бірақ басқа әлемге келгенде, бұл сиқырлы!
Dialogue: 0,0:15:35.05,0:15:38.64,Default,,0,0,0,,Маған осы жерде тым болмаса сиқыр үйренгенім дұрыс емес пе?
Dialogue: 0,0:15:38.72,0:15:39.81,Default,,0,0,0,,Қанша?
Dialogue: 0,0:15:39.89,0:15:40.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:40.81,0:15:41.77,Default,,0,0,0,,Күнделікті бағаларды білмейтін алғашқы келуші—
Dialogue: 0,0:15:41.85,0:15:43.48,Default,,0,0,0,,Майдо бар
Dialogue: 0,0:15:43.56,0:15:46.15,Default,,0,0,0,,-Хехехе~ -Қайсысын көрсет.
Dialogue: 0,0:15:46.23,0:15:47.23,Default,,0,0,0,,-Аа... -(Әже) Ой...
Dialogue: 0,0:15:47.32,0:15:48.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:48.23,0:15:52.03,Default,,0,0,0,,Сиқырлы кітаптар үшін тіркелу қажет.
Dialogue: 0,0:15:52.11,0:15:54.99,Default,,0,0,0,,Оны бір аптадан кейін алыңыз.
Dialogue: 0,0:15:56.08,0:15:58.08,Default,,0,0,0,,Тезірек үйге қайтайық?
Dialogue: 0,0:15:58.16,0:15:59.75,Default,,0,0,0,,-Ой, кешіріңіз - (Myare Anemon) Ах...
Dialogue: 0,0:15:59.83,0:16:01.25,Default,,0,0,0,,А... менің күйеуім!
Dialogue: 0,0:16:01.33,0:16:03.87,Default,,0,0,0,,-Ой, Кротондікі... -Няньяс.
Dialogue: 0,0:16:03.96,0:16:05.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:05.79,0:16:08.00,Default,,0,0,0,,Кешіріңіз, мен қазір асығып тұрмын!
Dialogue: 0,0:16:08.09,0:16:09.46,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:09.55,0:16:11.26,Default,,0,0,0,,Саана
Dialogue: 0,0:16:11.34,0:16:15.30,Default,,0,0,0,,Жақсы, мен үйге ертерек барғаным жөн.
Dialogue: 0,0:16:15.39,0:16:16.51,Default,,0,0,0,,-(Ер адам) Онда болды ма? -Аа...
Dialogue: 0,0:16:16.60,0:16:17.76,Default,,0,0,0,,О
Dialogue: 0,0:16:18.60,0:16:20.47,Default,,0,0,0,,Кяах!
Dialogue: 0,0:16:21.02,0:16:21.89,Default,,0,0,0,,- (Мьяли) Не? -Аа...
Dialogue: 0,0:16:21.98,0:16:23.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:24.98,0:16:26.77,Default,,0,0,0,,Хехе...
Dialogue: 0,0:16:27.98,0:16:30.44,Default,,0,0,0,,Бұл Кротонның қызы...
Dialogue: 0,0:16:30.53,0:16:31.90,Default,,0,0,0,,Кеничи!
Dialogue: 0,0:16:32.86,0:16:34.95,Default,,0,0,0,,Неге маған көмектеспейсің?
Dialogue: 0,0:16:35.49,0:16:38.41,Default,,0,0,0,,Қайтадан проблемаға айналса, қиын болар еді.
Dialogue: 0,0:16:39.16,0:16:40.41,Default,,0,0,0,,Тәтті, оған көмектесу мүмкін емес.
Dialogue: 0,0:16:40.49,0:16:42.04,Default,,0,0,0,,Анемонды сұраңыз
Dialogue: 0,0:16:42.12,0:16:42.96,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:16:43.04,0:16:45.71,Default,,0,0,0,,Сондай-ақ жағдай қиындаса, көмек сұраңыз.
Dialogue: 0,0:16:45.79,0:16:47.79,Default,,0,0,0,,Жарайды... Саған қалдырамын.
Dialogue: 0,0:16:49.13,0:16:52.26,Default,,0,0,0,,Балаларыңызбен Астрантияға келіңіз.
Dialogue: 0,0:16:49.13,0:16:52.26,Default,,0,0,0,,(Маридің үрейлі дауысы)
Dialogue: 0,0:16:52.26,0:16:52.34,Default,,0,0,0,,(Маридің қорқынышты дауысы)
Dialogue: 0,0:16:52.34,0:16:53.13,Default,,0,0,0,,(Маридің қорқынышты дауысы)
Dialogue: 0,0:16:52.34,0:16:53.13,Default,,0,0,0,,Сіз аздап ерініп қалдыңыз.
Dialogue: 0,0:16:53.13,0:16:55.18,Default,,0,0,0,,Сіз аздап бұзылып қалдыңыз.
Dialogue: 0,0:16:55.26,0:16:56.43,Default,,0,0,0,,Бұл кішкентай вакуумдық торнадоның соңғы әсері!
Dialogue: 0,0:16:56.51,0:16:58.43,Default,,0,0,0,,- Бір минут күте тұрыңыз! -(Еркектер) А?
Dialogue: 0,0:16:59.14,0:17:00.22,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:17:00.76,0:17:01.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:02.02,0:17:04.60,Default,,0,0,0,,Жақсы ата-ана мен балаға тағдырды байлау деген нені білдіреді?
Dialogue: 0,0:17:04.69,0:17:06.23,Default,,0,0,0,,Бұл тыныш емес.
Dialogue: 0,0:17:06.31,0:17:07.65,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:07.73,0:17:09.48,Default,,0,0,0,,Сіз мұны істейсіз бе? а?
Dialogue: 0,0:17:09.57,0:17:10.90,Default,,0,0,0,,Жаман сөз айтпа
Dialogue: 0,0:17:10.98,0:17:12.32,Default,,0,0,0,,Мен қазір шегінуім керек.
Dialogue: 0,0:17:12.40,0:17:14.40,Default,,0,0,0,,Менің сиқырым...
Dialogue: 0,0:17:15.65,0:17:17.07,Default,,0,0,0,,Ол жарылып кетеді!
Dialogue: 0,0:17:17.16,0:17:17.99,Default,,0,0,0,,Бұл сиқыр ма?
Dialogue: 0,0:17:18.07,0:17:19.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:18.07,0:17:19.45,Default,,0,0,0,,(петардалардың дыбысы)
Dialogue: 0,0:17:19.53,0:17:20.58,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,0:17:20.66,0:17:24.04,Default,,0,0,0,,Келесі жолы ол сіздің денеңіздің ішінде жарылады ма?
Dialogue: 0,0:17:24.12,0:17:25.08,Default,,0,0,0,,Хаха...
Dialogue: 0,0:17:25.16,0:17:26.75,Default,,0,0,0,,Бұл... бұл сиқыр!
Dialogue: 0,0:17:26.83,0:17:28.33,Default,,0,0,0,,Кімге... Қаш!
Dialogue: 0,0:17:29.38,0:17:31.75,Default,,0,0,0,,(Мари мен Кротонның үрейлі дауыстары)
Dialogue: 0,0:17:31.75,0:17:33.34,Default,,0,0,0,,(Мари мен Кротонның қорқынышты дауыстары)
Dialogue: 0,0:17:31.75,0:17:33.34,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:17:33.34,0:17:34.21,Default,,0,0,0,,(Мари мен Кротонның үрейлі дауыстары)
Dialogue: 0,0:17:34.30,0:17:35.38,Default,,0,0,0,,Кротон!
Dialogue: 0,0:17:35.47,0:17:36.84,Default,,0,0,0,,- (Кротон Мари) А... - Жарайсың ба?
Dialogue: 0,0:17:36.93,0:17:38.22,Default,,0,0,0,,олардың әрекеттерін күшейту қаупі бар.
Dialogue: 0,0:17:38.30,0:17:41.35,Default,,0,0,0,,Мен тұзаққа түсіп, бөлініп кеттім.
Dialogue: 0,0:17:43.64,0:17:45.68,Default,,0,0,0,,Мен бұл сен болады деп ешқашан күтпедім...
Dialogue: 0,0:17:45.77,0:17:47.52,Default,,0,0,0,,Маған көмектескеніңіз үшін рахмет
Dialogue: 0,0:17:47.60,0:17:49.02,Default,,0,0,0,,Бұрынғы жігіттер ше?
Dialogue: 0,0:17:49.10,0:17:50.36,Default,,0,0,0,,Ол Зоотерраның түбі.
Dialogue: 0,0:17:50.44,0:17:51.48,Default,,0,0,0,,Зоотерра?
Dialogue: 0,0:17:51.57,0:17:53.48,Default,,0,0,0,,Спайс синдикаты
Dialogue: 0,0:17:53.57,0:17:54.65,Default,,0,0,0,,Ах~
Dialogue: 0,0:17:54.74,0:17:56.99,Default,,0,0,0,,Далияда Бакопа деген нәрсе болды ма?
Dialogue: 0,0:17:57.61,0:18:00.82,Default,,0,0,0,,Шенеунік болғанымда біраз адамды ұстадым.
Dialogue: 0,0:18:00.91,0:18:03.24,Default,,0,0,0,,Содан бері мені бақылап жүр...
Dialogue: 0,0:18:03.33,0:18:05.41,Default,,0,0,0,,Әке, досың ба?
Dialogue: 0,0:18:05.50,0:18:08.04,Default,,0,0,0,,Бұл сіздің суретті кітабыңызды сатқан саудагер.
Dialogue: 0,0:18:08.12,0:18:09.83,Default,,0,0,0,,Не, анау кітап!
Dialogue: 0,0:18:09.92,0:18:11.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:11.63,0:18:14.42,Default,,0,0,0,,Кітабыңыз үшін рахмет.
Dialogue: 0,0:18:14.51,0:18:18.26,Default,,0,0,0,,Мен де сол суретті кітапты жасауға көмектестім.
Dialogue: 0,0:18:18.34,0:18:21.68,Default,,0,0,0,,Шынымен бе? Мари де оны жасауға көмектескісі келеді!
Dialogue: 0,0:18:21.76,0:18:22.72,Default,,0,0,0,,Кеничи
Dialogue: 0,0:18:22.81,0:18:26.35,Default,,0,0,0,,Мен Маримен жаңа суретті кітап жасағым келеді.
Dialogue: 0,0:18:26.43,0:18:28.02,Default,,0,0,0,,-Жарайды? -Итомо
Dialogue: 0,0:18:28.10,0:18:30.27,Default,,0,0,0,,Мари I Анемон
Dialogue: 0,0:18:30.35,0:18:33.07,Default,,0,0,0,,Анемон… Танысқаныма қуаныштымын.
Dialogue: 0,0:18:33.15,0:18:35.03,Default,,0,0,0,,Иә, рахмет Мари
Dialogue: 0,0:18:35.11,0:18:38.74,Default,,0,0,0,,Бұл сіздің жасыңызда тапқан алғашқы досыңыз ба?
Dialogue: 0,0:18:35.11,0:18:38.74,Default,,0,0,0,,(Анемон мен Маридің күлкісі)
Dialogue: 0,0:18:44.20,0:18:46.91,Default,,0,0,0,,Хаха...
Dialogue: 0,0:18:47.79,0:18:49.16,Default,,0,0,0,,- Мари! -(Мари) А...
Dialogue: 0,0:18:49.83,0:18:51.67,Default,,0,0,0,,- Мари! -(Мари) Анемон~!
Dialogue: 0,0:18:51.75,0:18:53.00,Default,,0,0,0,,(Кашиваги) Олай деу дұрыс па?
Dialogue: 0,0:18:53.09,0:18:53.92,Default,,0,0,0,,Аха…
Dialogue: 0,0:18:54.00,0:18:54.88,Default,,0,0,0,,Мя~н
Dialogue: 0,0:18:54.96,0:18:59.42,Default,,0,0,0,,Кейінірек Мари ата-анасымен біздің үйге қонаққа келді.
Dialogue: 0,0:19:00.18,0:19:01.68,Default,,0,0,0,,үшінңыз, өтінемін
Dialogue: 0,0:19:02.26,0:19:03.60,Default,,0,0,0,,Хмм…
Dialogue: 0,0:19:03.68,0:19:06.60,Default,,0,0,0,,Бұнда… дәмдеуіштер бар ма?
Dialogue: 0,0:19:06.68,0:19:09.98,Default,,0,0,0,,Аа, бұл бизнес, сондықтан оны алу мүмкін емес.
Dialogue: 0,0:19:10.06,0:19:11.98,Default,,0,0,0,,-Бұл дәмді - (Мари) Иә!
Dialogue: 0,0:19:12.06,0:19:13.44,Default,,0,0,0,,Уау
Dialogue: 0,0:19:13.52,0:19:15.57,Default,,0,0,0,,-Мя~н -Жақсы қыз Жақсы қыз
Dialogue: 0,0:19:15.65,0:19:17.57,Default,,0,0,0,,(Мьялидің күлкісі)
Dialogue: 0,0:19:17.65,0:19:19.86,Default,,0,0,0,,Мари Жақында кездескенше~
Dialogue: 0,0:19:19.95,0:19:22.20,Default,,0,0,0,,Иә, сау болыңыз
Dialogue: 0,0:19:22.28,0:19:24.95,Default,,0,0,0,,Содан кейін Мари мен Анемон
Dialogue: 0,0:19:25.03,0:19:29.33,Default,,0,0,0,,Бір-біріміздің үйге барып, күнде дерлік бірге ойнайтынбыз.
Dialogue: 0,0:19:46.10,0:19:48.85,Default,,0,0,0,,үшінмыз бірге жасаған Золушка суретті кітабы
Dialogue: 0,0:19:48.93,0:19:50.81,Default,,0,0,0,,Енді басып шығару
Dialogue: 0,0:19:50.89,0:19:52.35,Default,,0,0,0,,Содан бір күні...
Dialogue: 0,0:19:55.44,0:19:56.94,Default,,0,0,0,,(Кротонның ентігуі)
Dialogue: 0,0:19:56.94,0:19:58.69,Default,,0,0,0,,(Кротонның ентігуі)
Dialogue: 0,0:19:56.94,0:19:58.69,Default,,0,0,0,,Кротон?
Dialogue: 0,0:19:58.78,0:19:59.94,Default,,0,0,0,,Кеничи…
Dialogue: 0,0:20:00.03,0:20:02.78,Default,,0,0,0,,Сіз саудагер екеніңізді айттыңыз.
Dialogue: 0,0:20:02.86,0:20:04.36,Default,,0,0,0,,Хаха...
Dialogue: 0,0:20:04.45,0:20:07.45,Default,,0,0,0,,Маған көмектесіңізші!
Dialogue: 0,0:20:07.53,0:20:11.29,Default,,0,0,0,,Мұның бәрі менің меншігім. Осы жігітпен маған дәрі сата аласыз ба?
Dialogue: 0,0:20:11.37,0:20:13.37,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:13.46,0:20:15.88,Default,,0,0,0,,Мари жоғары қызбамен ауырады.
Dialogue: 0,0:20:16.84,0:20:19.05,Default,,0,0,0,,Осы аймаққа тән эндемик
Dialogue: 0,0:20:19.13,0:20:23.30,Default,,0,0,0,,Зардап шеккен балалардың көпшілігі түнде аман қалмайтын сияқты.
Dialogue: 0,0:20:23.38,0:20:25.22,Default,,0,0,0,,Кеничи…
Dialogue: 0,0:20:26.72,0:20:28.68,Default,,0,0,0,,Сиқыршыға не болды?
Dialogue: 0,0:20:28.76,0:20:29.81,Default,,0,0,0,,Емдік сиқыр?
Dialogue: 0,0:20:29.89,0:20:32.52,Default,,0,0,0,,Дұрыс, анау кемпір пайдалана алады!
Dialogue: 0,0:20:32.60,0:20:35.90,Default,,0,0,0,,Сиқыршылардың ақшасы жетпейді...
Dialogue: 0,0:20:35.98,0:20:37.40,Default,,0,0,0,,(Тодороки) Мен сол жігіттен барынша көп нәрсе үйренгім келеді
Dialogue: 0,0:20:37.48,0:20:39.52,Default,,0,0,0,,Бұл қызуды басатын дәрі.
Dialogue: 0,0:20:39.61,0:20:41.65,Default,,0,0,0,,Әзірше қызуыңызды төмендетіңіз.
Dialogue: 0,0:20:41.74,0:20:43.40,Default,,0,0,0,,Қалғанын маған қалдыр
Dialogue: 0,0:20:43.49,0:20:44.82,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:20:44.91,0:20:47.03,Default,,0,0,0,,Тезірек үйге қайт! Жақында мен сонда барамын
Dialogue: 0,0:20:47.12,0:20:48.78,Default,,0,0,0,,Мыау! Ах, Ферис, не болды?
Dialogue: 0,0:20:50.12,0:20:52.75,Default,,0,0,0,,Майаре Мен анемонға тапсырыс бердім.
Dialogue: 0,0:20:52.83,0:20:54.21,Default,,0,0,0,,Мен де барамын!
Dialogue: 0,0:20:54.29,0:20:56.42,Default,,0,0,0,,Бұл жақсы болмайды.
Dialogue: 0,0:21:01.59,0:21:02.42,Default,,0,0,0,,Сізге бұл қалай ұнайды?
Dialogue: 0,0:21:03.05,0:21:06.30,Default,,0,0,0,,Бұл сөзсіз цикорий безгегі.
Dialogue: 0,0:21:06.39,0:21:09.76,Default,,0,0,0,,Кемпір күткендей... А, жоқ, бұл сенің әпкең ғой.
Dialogue: 0,0:21:09.85,0:21:11.06,Default,,0,0,0,,Емдік сиқырды сұраңыз
Dialogue: 0,0:21:11.14,0:21:14.52,Default,,0,0,0,,Цикорийді емдік сиқырмен емдеу қиын.
Dialogue: 0,0:21:14.60,0:21:15.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:15.52,0:21:19.65,Default,,0,0,0,,Орманның терең бұлағында, Ауылдың жанынан ағып жатқан өзеннің бастауы.
Dialogue: 0,0:21:19.73,0:21:22.19,Default,,0,0,0,,Цикорий деп аталатын ақ гүл гүлдейді.
Dialogue: 0,0:21:22.28,0:21:25.57,Default,,0,0,0,,Цикорий ауруын тұқыммен емдеуге болады.
Dialogue: 0,0:21:26.57,0:21:28.45,Default,,0,0,0,,Жарайды, мен алып кетейін.
Dialogue: 0,0:21:28.53,0:21:29.57,Default,,0,0,0,,Мен де барамын!
Dialogue: 0,0:21:29.66,0:21:33.04,Default,,0,0,0,,Жоқ, қазір түн болды. Бұл орманда қауіпті.
Dialogue: 0,0:21:33.12,0:21:35.21,Default,,0,0,0,,Кедергі болмаңыз! сұраңыз!
Dialogue: 0,0:21:35.29,0:21:36.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:35.29,0:21:36.58,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:21:36.67,0:21:38.71,Default,,0,0,0,,Мен де барамын...
Dialogue: 0,0:21:38.79,0:21:40.96,Default,,0,0,0,,Өтінемін, Кеничидің күйеуі!
Dialogue: 0,0:21:41.04,0:21:42.55,Default,,0,0,0,,Няньясу…
Dialogue: 0,0:21:44.26,0:21:45.22,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:21:45.30,0:21:49.51,Default,,0,0,0,,Маған ертең таңертең цикорий гүлінің тұқымы керек.
Dialogue: 0,0:21:49.59,0:21:51.14,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:21:52.22,0:21:53.47,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:21:56.02,0:21:58.98,Default,,0,0,0,,Мен үйді таптым деп ойлаған кезде
Dialogue: 0,0:21:59.06,0:22:01.94,Default,,0,0,0,,Қызық көрінеді, солай емес пе?
Dialogue: 0,0:22:02.02,0:22:05.36,Default,,0,0,0,,Хе-хе-хе-хе
Dialogue: 0,0:22:05.94,0:22:09.95,Default,,0,0,0,,♪～
Dialogue: 0,0:23:32.20,0:23:35.87,Default,,0,0,0,,～♪
