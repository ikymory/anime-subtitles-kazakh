Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.83,0:00:04.42,Default,,0,0,0,,(Примуланың ұйқысы)
Dialogue: 0,0:00:04.42,0:00:05.42,Default,,0,0,0,,(Примуланың ұйқысы)
Dialogue: 0,0:00:04.42,0:00:05.42,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:05.42,0:00:07.92,Default,,0,0,0,,(Примуланың ұйқысы)
Dialogue: 0,0:00:14.34,0:00:15.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:17.01,0:00:21.02,Default,,0,0,0,,(Ерекшелердің шуы)
Dialogue: 0,0:00:24.06,0:00:25.31,Default,,0,0,0,,Примула!
Dialogue: 0,0:00:25.40,0:00:26.56,Default,,0,0,0,,Әке!
Dialogue: 0,0:00:26.65,0:00:27.98,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:28.06,0:00:29.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:29.27,0:00:31.44,Default,,0,0,0,,Примула, аман бол.
Dialogue: 0,0:00:31.53,0:00:32.36,Default,,0,0,0,,Мен шындап оралдым
Dialogue: 0,0:00:31.53,0:00:32.36,Default,,0,0,0,,Әкесі осылайша тыртықпен жабылған...
Dialogue: 0,0:00:32.36,0:00:32.44,Default,,0,0,0,,Сенің әкеңнің тыртықтары осындай...
Dialogue: 0,0:00:32.44,0:00:34.70,Default,,0,0,0,,Әкеңнің тыртықтары мынандай...
Dialogue: 0,0:00:32.44,0:00:34.70,Default,,0,0,0,,Бірақ Шағаның өлгенін білмейміз бе?
Dialogue: 0,0:00:34.78,0:00:35.74,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға өте қуаныштымын.
Dialogue: 0,0:00:35.74,0:00:37.91,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға өте қуаныштымын.
Dialogue: 0,0:00:35.74,0:00:37.91,Default,,0,0,0,,Қалай болғанда да, Marrow & Co. банкрот.
Dialogue: 0,0:00:37.91,0:00:38.53,Default,,0,0,0,,Қалай болғанда да, Marrow & Co. банкрот.
Dialogue: 0,0:00:38.62,0:00:39.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:39.53,0:00:40.79,Default,,0,0,0,,Примула
Dialogue: 0,0:00:40.87,0:00:43.96,Default,,0,0,0,,Бұл да өте сапалы блузка, солай емес пе?
Dialogue: 0,0:00:44.04,0:00:46.29,Default,,0,0,0,,Иә, әке!
Dialogue: 0,0:00:46.37,0:00:48.96,Default,,0,0,0,,Кеничи-самадан алынды
Dialogue: 0,0:00:49.04,0:00:50.50,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:50.59,0:00:51.84,Default,,0,0,0,,- Ол сатылады! -сату!
Dialogue: 0,0:00:51.92,0:00:54.84,Default,,0,0,0,,Эмоциялық кездесу іскерлік әңгімеге айналды.
Dialogue: 0,0:00:54.92,0:00:55.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:55.84,0:00:57.26,Default,,0,0,0,,Кеничи-сан
Dialogue: 0,0:00:57.34,0:01:01.14,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:01:01.85,0:01:02.93,Default,,0,0,0,,А... енді ойласам
Dialogue: 0,0:01:03.02,0:01:06.52,Default,,0,0,0,,Олжа зат жәшігінде ме?
Dialogue: 0,0:01:06.60,0:01:08.94,Default,,0,0,0,,Не? Аа иә жақсы...
Dialogue: 0,0:01:09.61,0:01:13.90,Default,,0,0,0,,Иә, қазір менің заттар жәшігімде...
Dialogue: 0,0:01:14.94,0:01:18.11,Default,,0,0,0,,Сол күн есіме түсті
Dialogue: 0,0:01:18.70,0:01:21.53,Default,,0,0,0,,Басқа әлемге әкелу қорқынышы
Dialogue: 0,0:01:21.62,0:01:25.04,Default,,0,0,0,,Шангри-Ланың арқасында аман қалғаным
Dialogue: 0,0:01:25.71,0:01:27.33,Default,,0,0,0,,Тілегім баяу өмір
Dialogue: 0,0:01:27.42,0:01:31.50,Default,,0,0,0,,Мен жай ғана 40-тың шамасында еркін өмір сүргісі келетін адаммын.
Dialogue: 0,0:01:32.05,0:01:36.42,Default,,0,0,0,,♪～
Dialogue: 0,0:02:55.88,0:03:00.47,Default,,0,0,0,,～♪
Dialogue: 0,0:03:04.39,0:03:05.22,Default,,0,0,0,,-Мм... -Уау!
Dialogue: 0,0:03:05.31,0:03:06.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:08.47,0:03:11.14,Default,,0,0,0,,Басын зат жәшігіне саласыз ба?
Dialogue: 0,0:03:11.23,0:03:12.27,Default,,0,0,0,,О
Dialogue: 0,0:03:12.35,0:03:15.57,Default,,0,0,0,,Бағыныштылықтың дәлелі ретінде басын өзіммен бірге алып кетемін.
Dialogue: 0,0:03:15.65,0:03:17.90,Default,,0,0,0,,Бұл жолы өте үлкен сыйлық.
Dialogue: 0,0:03:17.98,0:03:20.19,Default,,0,0,0,,Бетті растау қажет!
Dialogue: 0,0:03:20.28,0:03:22.20,Default,,0,0,0,,Күйеуіңізді бірінші рет көріп тұрсыз ба?
Dialogue: 0,0:03:22.28,0:03:24.74,Default,,0,0,0,,Бірақ егер сіз авантюрист болсаңыз, бұл әрқашан болады.
Dialogue: 0,0:03:24.82,0:03:26.33,Default,,0,0,0,,Сіз үйреніп кетесіз.
Dialogue: 0,0:03:26.41,0:03:28.04,Default,,0,0,0,,Олар жай ғана тірі қалуға тиіс емес.
Dialogue: 0,0:03:28.12,0:03:29.16,Default,,0,0,0,,Бұл көмектеседі
Dialogue: 0,0:03:29.25,0:03:31.58,Default,,0,0,0,,Неғұрлым ұзақ болса, соғұрлым сасық болады.
Dialogue: 0,0:03:31.66,0:03:33.83,Default,,0,0,0,,Оны көтеру қиын
Dialogue: 0,0:03:33.92,0:03:37.38,Default,,0,0,0,,Басқа әлемнен күткендей, бұл тәтті емес еді...
Dialogue: 0,0:03:37.88,0:03:40.09,Default,,0,0,0,,Сақтау қоймасы Сақтау қоймасы…
Dialogue: 0,0:03:40.17,0:03:42.01,Default,,0,0,0,,Бұл қалай болды?
Dialogue: 0,0:03:42.09,0:03:45.05,Default,,0,0,0,,Баяу өмір қайда кетті?
Dialogue: 0,0:03:45.14,0:03:48.81,Default,,0,0,0,,Сонымен қатар, қарақшылардан қару-жарақ пен техника алынып тасталды.
Dialogue: 0,0:03:48.89,0:03:49.56,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:03:49.56,0:03:51.81,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:03:49.56,0:03:51.81,Default,,0,0,0,,Жасырын жерде 100-ге жуық алтын монета
Dialogue: 0,0:03:51.89,0:03:54.19,Default,,0,0,0,,Шаға жинаған деген ой бар.
Dialogue: 0,0:03:54.27,0:03:58.27,Default,,0,0,0,,Кілем, спирт, керамика, зергерлік бұйымдар, қылыш сияқты алтын бұйымдар, т.б.
Dialogue: 0,0:03:58.36,0:04:00.44,Default,,0,0,0,,Сандық жәшік Үстел орындық
Dialogue: 0,0:04:00.53,0:04:03.03,Default,,0,0,0,,Кәстрөлдер, табалар, пышақтар, ыдыс-аяқтар, қасықтар, шанышқылар
Dialogue: 0,0:04:03.11,0:04:06.32,Default,,0,0,0,,Тіпті далаға отырғызылған көкөністер
Dialogue: 0,0:04:06.41,0:04:08.83,Default,,0,0,0,,Құрамында көп олжа бар...
Dialogue: 0,0:04:08.91,0:04:09.95,Default,,0,0,0,,Хоуа~
Dialogue: 0,0:04:09.95,0:04:11.29,Default,,0,0,0,,Хоуа~
Dialogue: 0,0:04:09.95,0:04:11.29,Default,,0,0,0,,Мен оны өзіммен бірге алып кеттім, бірақ...
Dialogue: 0,0:04:11.29,0:04:12.58,Default,,0,0,0,,Мен оны өзіммен бірге алып кеттім, бірақ...
Dialogue: 0,0:04:14.21,0:04:16.21,Default,,0,0,0,,Қайтқандарды туған жерлеріне жіберемін.
Dialogue: 0,0:04:16.29,0:04:17.88,Default,,0,0,0,,(Әйелдердің шуы)
Dialogue: 0,0:04:17.96,0:04:19.09,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:19.17,0:04:21.51,Default,,0,0,0,,Мен туған жеріме оралғанда...
Dialogue: 0,0:04:21.59,0:04:23.51,Default,,0,0,0,,Менің отбасым енді...
Dialogue: 0,0:04:23.59,0:04:24.80,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:04:25.43,0:04:28.60,Default,,0,0,0,,А, онда бізбен бірге Далияға келгіңіз келе ме?
Dialogue: 0,0:04:28.68,0:04:29.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:30.31,0:04:33.94,Default,,0,0,0,,Өз туған қаласына қайтқысы келмейтін басқа біреу болса, маған хабарлаңыз.
Dialogue: 0,0:04:34.02,0:04:38.40,Default,,0,0,0,,Далия - адамдар көп қала, сондықтан қандай да бір жолмен жұмысқа орналасатыныңызға сенімдімін.
Dialogue: 0,0:04:38.48,0:04:42.24,Default,,0,0,0,,Менің зерттеулерім, Marrow & Co.
Dialogue: 0,0:04:42.32,0:04:43.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:44.07,0:04:46.49,Default,,0,0,0,,Анемон ауылы қайда орналасқан?
Dialogue: 0,0:04:46.57,0:04:47.41,Default,,0,0,0,,Уруп
Dialogue: 0,0:04:47.49,0:04:49.24,Default,,0,0,0,,Бұл да алыс.
Dialogue: 0,0:04:49.33,0:04:50.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:50.24,0:04:54.16,Default,,0,0,0,,Бұл Аквилегияға жақын, сондықтан шамамен 500 лига...
Dialogue: 0,0:04:54.25,0:04:55.83,Default,,0,0,0,,800 км...
Dialogue: 0,0:04:55.92,0:04:59.21,Default,,0,0,0,,Жарайды, мен саған жіберемін.
Dialogue: 0,0:05:00.67,0:05:01.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:01.59,0:05:03.26,Default,,0,0,0,,мен оған тек ризашылығымды және ең үлкен құрметімді білдіремін!
Dialogue: 0,0:05:03.34,0:05:07.55,Default,,0,0,0,,Бұл бала аз ақша болсын деп сатылған шығар.
Dialogue: 0,0:05:07.64,0:05:09.30,Default,,0,0,0,,Бейшара.
Dialogue: 0,0:05:09.80,0:05:10.97,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:05:11.47,0:05:14.64,Default,,0,0,0,,үшінмен бірге Далияға барғыңыз келе ме?
Dialogue: 0,0:05:14.73,0:05:16.64,Default,,0,0,0,,Хааа~
Dialogue: 0,0:05:18.27,0:05:21.44,Default,,0,0,0,,Адам үшін ең жақсысы адалдық!
Dialogue: 0,0:05:21.52,0:05:24.44,Default,,0,0,0,,Әпкеңіз күткендей, бұл өте пайдалы.
Dialogue: 0,0:05:24.53,0:05:27.82,Default,,0,0,0,,Сонда Кеничидің күйеуі сияқты біреуді қалайсың ба?
Dialogue: 0,0:05:27.91,0:05:29.41,Default,,0,0,0,,О, жоқ, жоқ
Dialogue: 0,0:05:29.49,0:05:32.58,Default,,0,0,0,,Ондайлар әйелдерді ойламайды.
Dialogue: 0,0:05:32.66,0:05:33.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:33.58,0:05:36.29,Default,,0,0,0,,Қалағаныңды істегің келсе, әйелдерді қалдыр.
Dialogue: 0,0:05:36.37,0:05:39.08,Default,,0,0,0,,Бір жерге жалғыз баратын адам.
Dialogue: 0,0:05:39.17,0:05:42.17,Default,,0,0,0,,(Ата-ана мен баланың қуаныш үні)
Dialogue: 0,0:05:42.25,0:05:43.92,Default,,0,0,0,,О...
Dialogue: 0,0:05:42.25,0:05:43.92,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:43.92,0:05:45.67,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:45.76,0:05:47.43,Default,,0,0,0,,А... а...
Dialogue: 0,0:05:47.51,0:05:50.26,Default,,0,0,0,,Бұл қарақшылар көсемі Шағаның басы.
Dialogue: 0,0:05:50.35,0:05:52.18,Default,,0,0,0,,Жүрегіңе дейін тексер!
Dialogue: 0,0:05:52.26,0:05:54.35,Default,,0,0,0,,Бұл... осында қойылса да...
Dialogue: 0,0:05:54.43,0:05:57.69,Default,,0,0,0,,Бұл мойынның ұзындығы қанша?
Dialogue: 0,0:05:57.77,0:06:01.44,Default,,0,0,0,,Мм... 10... 20... Ал...
Dialogue: 0,0:06:01.52,0:06:03.48,Default,,0,0,0,,А, күйеуім, сен нешеде едің?
Dialogue: 0,0:06:03.57,0:06:04.69,Default,,0,0,0,,52 дана
Dialogue: 0,0:06:04.78,0:06:06.03,Default,,0,0,0,,Өтінемін… 50…
Dialogue: 0,0:06:06.11,0:06:07.03,Default,,0,0,0,,2 дана…
Dialogue: 0,0:06:07.03,0:06:07.45,Default,,0,0,0,,2 дана…
Dialogue: 0,0:06:07.03,0:06:07.45,Default,,0,0,0,,шақыру шақыру шақыру...
Dialogue: 0,0:06:07.45,0:06:08.15,Default,,0,0,0,,шақыру шақыру шақыру...
Dialogue: 0,0:06:08.15,0:06:10.57,Default,,0,0,0,,шақыру шақыру шақыру...
Dialogue: 0,0:06:08.15,0:06:10.57,Default,,0,0,0,,Түні бойы ұйықтамай, оны тексер!
Dialogue: 0,0:06:10.66,0:06:13.03,Default,,0,0,0,,Хаха! Олардың кез келгенін қолдануға болады!
Dialogue: 0,0:06:13.12,0:06:14.58,Default,,0,0,0,,Дұрыс! Бұл дұрыс!
Dialogue: 0,0:06:14.66,0:06:16.45,Default,,0,0,0,,Няхахаха…
Dialogue: 0,0:06:16.54,0:06:18.50,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:06:18.58,0:06:21.08,Default,,0,0,0,,Сіздің сиқырыңыз да ерекше.
Dialogue: 0,0:06:21.17,0:06:24.25,Default,,0,0,0,,Зат қорабы да өте үлкен.
Dialogue: 0,0:06:24.34,0:06:27.34,Default,,0,0,0,,Асылдар біліп қалса, қиналып қаласың.
Dialogue: 0,0:06:27.42,0:06:30.26,Default,,0,0,0,,Қарт аузын жапса екен.
Dialogue: 0,0:06:30.34,0:06:33.05,Default,,0,0,0,,Әрине мен үндемеймін.
Dialogue: 0,0:06:33.14,0:06:36.39,Default,,0,0,0,,Егер жағдай қатты нашарлап кетсе, мен ашуланамын...
Dialogue: 0,0:06:36.47,0:06:37.56,Default,,0,0,0,,Кеничи-доно
Dialogue: 0,0:06:37.64,0:06:39.23,Default,,0,0,0,,Мен енді мырзаның мырзасымын.
Dialogue: 0,0:06:39.31,0:06:41.23,Default,,0,0,0,,Мен граф Аслепиоспен кездесемін.
Dialogue: 0,0:06:41.31,0:06:43.11,Default,,0,0,0,,Дворяндардың қатысуы.
Dialogue: 0,0:06:43.19,0:06:45.44,Default,,0,0,0,,Сіз бұл туралы хабарлайсыз ба?
Dialogue: 0,0:06:45.53,0:06:46.53,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:54.49,0:06:56.99,Default,,0,0,0,,Сонымен тексеру түнге дейін созылды.
Dialogue: 0,0:06:57.58,0:07:02.08,Default,,0,0,0,,Сыйлықтың жалпы сомасы 861 алтын тиынды құрады.
Dialogue: 0,0:07:03.88,0:07:06.25,Default,,0,0,0,,Маған бұл керек емес...
Dialogue: 0,0:07:06.34,0:07:09.47,Default,,0,0,0,,Сіз мүлдем жұмыс істемейсіз, солай ма?
Dialogue: 0,0:07:09.55,0:07:11.26,Default,,0,0,0,,Мен қорықпаймын.
Dialogue: 0,0:07:11.34,0:07:12.39,Default,,0,0,0,,Сақтау
Dialogue: 0,0:07:12.89,0:07:14.05,Default,,0,0,0,,мен оған тек ризашылығымды және ең үлкен құрметімді білдіремін!
Dialogue: 0,0:07:14.14,0:07:15.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:15.22,0:07:19.52,Default,,0,0,0,,Маған анемонды қабылдауға рұқсат бересіз бе?
Dialogue: 0,0:07:20.73,0:07:24.06,Default,,0,0,0,,Менің балам тірі болса...
Dialogue: 0,0:07:24.15,0:07:26.48,Default,,0,0,0,,Жарайды, өтінемін.
Dialogue: 0,0:07:27.23,0:07:29.82,Default,,0,0,0,,Рахмет, сэр.
Dialogue: 0,0:07:29.90,0:07:31.03,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:31.11,0:07:32.74,Default,,0,0,0,,(Адамдардың шуы)
Dialogue: 0,0:07:32.74,0:07:35.53,Default,,0,0,0,,(Адамдардың шуы)
Dialogue: 0,0:07:32.74,0:07:35.53,Default,,0,0,0,,Мен Шағаның бағынады деп күткен жоқпын!
Dialogue: 0,0:07:35.62,0:07:37.54,Default,,0,0,0,,Себебі мені Анама қабылдамады.
Dialogue: 0,0:07:35.62,0:07:37.54,Default,,0,0,0,,Қараңызшы!
Dialogue: 0,0:07:37.62,0:07:40.79,Default,,0,0,0,,Сыйақыны жеті адамға бөлу керек болды.
Dialogue: 0,0:07:37.62,0:07:40.79,Default,,0,0,0,,Енді қорқудың қажеті жоқ
Dialogue: 0,0:07:40.87,0:07:42.96,Default,,0,0,0,,Шаға қарт кісі~
Dialogue: 0,0:07:40.87,0:07:42.96,Default,,0,0,0,,Әр адам 123 алтын тиын алады.
Dialogue: 0,0:07:42.96,0:07:43.04,Default,,0,0,0,,Әр адам 123 алтын тиын алады.
Dialogue: 0,0:07:43.04,0:07:44.83,Default,,0,0,0,,Әр адам 123 алтын тиын алады.
Dialogue: 0,0:07:43.04,0:07:44.83,Default,,0,0,0,,Шаға қарт кісі~
Dialogue: 0,0:07:44.83,0:07:45.50,Default,,0,0,0,,Шаға қарт кісі~
Dialogue: 0,0:07:48.75,0:07:51.05,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:53.38,0:07:56.26,Default,,0,0,0,,Бұл уақытта қала қақпалары жабық.
Dialogue: 0,0:07:56.35,0:07:58.14,Default,,0,0,0,,Мен осында қаламын
Dialogue: 0,0:07:58.22,0:08:01.06,Default,,0,0,0,,Осы жолы маған ергеніңіз үшін рахмет.
Dialogue: 0,0:08:02.10,0:08:03.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:03.85,0:08:04.40,Default,,0,0,0,,(Люта ойнау)
Dialogue: 0,0:08:04.40,0:08:07.32,Default,,0,0,0,,(Люта ойнау)
Dialogue: 0,0:08:04.40,0:08:07.32,Default,,0,0,0,,Тозақ есігін ашқан кім?
Dialogue: 0,0:08:07.40,0:08:08.23,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:08:08.23,0:08:08.61,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:08:08.23,0:08:08.61,Default,,0,0,0,,Күміс рыцарь?
Dialogue: 0,0:08:08.61,0:08:09.82,Default,,0,0,0,,Күміс рыцарь?
Dialogue: 0,0:08:09.90,0:08:11.65,Default,,0,0,0,,Қош келдіңіз...
Dialogue: 0,0:08:09.90,0:08:11.65,Default,,0,0,0,,Қара алтын құбыжықтарды аулайтын сиқыршы немесе қолға үйретуші?
Dialogue: 0,0:08:11.65,0:08:11.74,Default,,0,0,0,,Қара және алтын сиқырлы аңдарды аулайтын сиқыршы немесе қолға үйретуші?
Dialogue: 0,0:08:11.74,0:08:13.20,Default,,0,0,0,,Қара және алтын құбыжықтарды аулайтын сиқыршы немесе қолға үйретуші?
Dialogue: 0,0:08:11.74,0:08:13.20,Default,,0,0,0,,Кеничи!
Dialogue: 0,0:08:13.95,0:08:15.20,Default,,0,0,0,,Кеничиге ұқсайтын біреу
Dialogue: 0,0:08:15.28,0:08:18.20,Default,,0,0,0,,Қарақшыларды сәтті бағындырып, қайтып оралдың деп естідім.
Dialogue: 0,0:08:18.28,0:08:19.99,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:08:20.08,0:08:23.12,Default,,0,0,0,,А, жоқ, жоқ, бұл дұрыс емес адам.
Dialogue: 0,0:08:20.08,0:08:23.12,Default,,0,0,0,,(Қонақтардың шуы)
Dialogue: 0,0:08:23.21,0:08:24.33,Default,,0,0,0,,Не?
Dialogue: 0,0:08:24.42,0:08:26.29,Default,,0,0,0,,Дұрыс, солай емес пе?
Dialogue: 0,0:08:26.38,0:08:28.09,Default,,0,0,0,,Әрине бұл үлкен өтірік
Dialogue: 0,0:08:28.17,0:08:31.96,Default,,0,0,0,,Егер мен сыйлық ақша туралы білсем, мен оны әлі алмас едім.
Dialogue: 0,0:08:32.05,0:08:34.18,Default,,0,0,0,,Мен сенің өлтірілетініңе сенімдімін.
Dialogue: 0,0:08:34.26,0:08:38.43,Default,,0,0,0,,Орман мысықтары жұмыс істейтін мысықтар тобы?
Dialogue: 0,0:08:39.06,0:08:40.22,Default,,0,0,0,,-Мм... -Ой...
Dialogue: 0,0:08:40.31,0:08:42.68,Default,,0,0,0,,Эй, бизнесте табысқа жетсең ше?
Dialogue: 0,0:08:40.31,0:08:42.68,Default,,0,0,0,,О, мен білемін
Dialogue: 0,0:08:42.77,0:08:44.89,Default,,0,0,0,,Қираған қамалдың айы ғана
Dialogue: 0,0:08:42.77,0:08:44.89,Default,,0,0,0,,Мені ханым етем деген уәдең есіңде ме?
Dialogue: 0,0:08:44.89,0:08:46.73,Default,,0,0,0,,Мені ханым етем деген уәдең есіңде ме?
Dialogue: 0,0:08:46.81,0:08:48.48,Default,,0,0,0,,Әйел интуициясы?
Dialogue: 0,0:08:48.56,0:08:50.57,Default,,0,0,0,,Менің Азалияда ақшам бар екендігі
Dialogue: 0,0:08:50.65,0:08:51.73,Default,,0,0,0,,Анықталған сияқты.
Dialogue: 0,0:08:51.82,0:08:54.03,Default,,0,0,0,,Жоқ, сіз бұл уәдені берген жоқсыз.
Dialogue: 0,0:08:54.11,0:08:55.74,Default,,0,0,0,,Айтпақшы, бөлме бос па?
Dialogue: 0,0:08:55.82,0:08:58.53,Default,,0,0,0,,Алдыңғы бөлме бос.
Dialogue: 0,0:08:58.62,0:08:59.70,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:08:59.78,0:09:01.74,Default,,0,0,0,,Сен менімен ойнап жүрдің ғой, солай ма?
Dialogue: 0,0:09:01.83,0:09:03.25,Default,,0,0,0,,- Уау - (Тапсырыс беруші) Эй, Азалия
Dialogue: 0,0:09:03.33,0:09:04.33,Default,,0,0,0,,Маған айқайлаңыз
Dialogue: 0,0:09:04.41,0:09:05.46,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:09:05.54,0:09:06.87,Default,,0,0,0,,Кеничи Бұл қорқынышты!
Dialogue: 0,0:09:06.96,0:09:09.75,Default,,0,0,0,,Ахахах... Мен жаман қариямын.
Dialogue: 0,0:09:10.46,0:09:14.38,Default,,0,0,0,,Тозақ есігін ашқан кім?
Dialogue: 0,0:09:17.80,0:09:21.76,Default,,0,0,0,,Менің ойымша, бұл тек уақыттың мәселесі деп ойлаймын.
Dialogue: 0,0:09:21.85,0:09:23.81,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:23.89,0:09:25.39,Default,,0,0,0,,Мияу~
Dialogue: 0,0:09:31.69,0:09:33.19,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:09:35.40,0:09:36.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:36.36,0:09:38.03,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:09:38.11,0:09:41.91,Default,,0,0,0,,Уау... Азалия мен шаршадым.
Dialogue: 0,0:09:41.99,0:09:43.79,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:09:43.87,0:09:44.91,Default,,0,0,0,,Біраз уақыт болды, сондықтан мен сізге қызмет ұсынайын деп ойладым.
Dialogue: 0,0:09:44.91,0:09:46.79,Default,,0,0,0,,Біраз уақыт болды, сондықтан мен сізге қызмет ұсынайын деп ойладым.
Dialogue: 0,0:09:44.91,0:09:46.79,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:46.79,0:09:47.42,Default,,0,0,0,,Біраз уақыт болды, сондықтан мен сізге қызмет ұсынайын деп ойладым.
Dialogue: 0,0:09:47.50,0:09:50.04,Default,,0,0,0,,Оған көмектесу мүмкін емес, а...
Dialogue: 0,0:09:50.13,0:09:52.50,Default,,0,0,0,,Мен оны аламын! Ах...
Dialogue: 0,0:09:52.59,0:09:54.30,Default,,0,0,0,,А... Не болды, Азалия?
Dialogue: 0,0:09:54.38,0:09:55.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:55.88,0:09:57.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:57.26,0:09:58.63,Default,,0,0,0,,-Джи -Анемон!
Dialogue: 0,0:09:58.72,0:09:59.72,Default,,0,0,0,,Мия?
Dialogue: 0,0:10:00.26,0:10:01.93,Default,,0,0,0,,Соңында...
Dialogue: 0,0:10:00.26,0:10:01.93,Default,,0,0,0,,(Анемонның тынысы)
Dialogue: 0,0:10:01.93,0:10:02.01,Default,,0,0,0,,(Анемонның тынысы)
Dialogue: 0,0:10:02.01,0:10:04.52,Default,,0,0,0,,(Анемонның тынысы)
Dialogue: 0,0:10:02.01,0:10:04.52,Default,,0,0,0,,Анемон менің бөлмемде қалды.
Dialogue: 0,0:10:09.69,0:10:12.06,Default,,0,0,0,,Анама уайымдап жатыр деп ойладым.
Dialogue: 0,0:10:12.15,0:10:15.07,Default,,0,0,0,,Мен базарға бардым, бірақ ол жоқ.
Dialogue: 0,0:10:15.15,0:10:18.95,Default,,0,0,0,,Тіпті ашқан аңдар да білмейміз дейді.
Dialogue: 0,0:10:19.03,0:10:21.82,Default,,0,0,0,,Әзірше бүгін жасайтын ісімізді орындайық.
Dialogue: 0,0:10:21.91,0:10:22.95,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:10:23.03,0:10:24.83,Default,,0,0,0,,Қару-жарақ дүкені қарақшыдан айырылды —
Dialogue: 0,0:10:23.03,0:10:24.83,Default,,0,0,0,,А... а...
Dialogue: 0,0:10:24.83,0:10:24.91,Default,,0,0,0,,А... а...
Dialogue: 0,0:10:24.91,0:10:27.33,Default,,0,0,0,,А... а...
Dialogue: 0,0:10:24.91,0:10:27.33,Default,,0,0,0,,Қару-жарақ пен техниканы сатып алыңыз
Dialogue: 0,0:10:28.00,0:10:30.71,Default,,0,0,0,,Нәтиже: 32 алтын монета
Dialogue: 0,0:10:30.79,0:10:33.38,Default,,0,0,0,,Шағаның жасырынған жеріндегі алтын зат
Dialogue: 0,0:10:30.79,0:10:33.38,Default,,0,0,0,,О~
Dialogue: 0,0:10:33.46,0:10:35.59,Default,,0,0,0,,Оны Murrow & Co. сатып алыңыз.
Dialogue: 0,0:10:35.67,0:10:38.22,Default,,0,0,0,,Бұл 35 алтын монета.
Dialogue: 0,0:10:38.30,0:10:39.88,Default,,0,0,0,,Апа, жақсысың ба?
Dialogue: 0,0:10:38.30,0:10:39.88,Default,,0,0,0,,Жиһазды алып, қарияның құрал-сайман дүкеніне тағзым ет.
Dialogue: 0,0:10:39.88,0:10:41.68,Default,,0,0,0,,Жиһазды алып, қарттың құрал-сайман дүкеніне тағзым ет.
Dialogue: 0,0:10:41.76,0:10:43.97,Default,,0,0,0,,22 алтын монета
Dialogue: 0,0:10:44.06,0:10:47.73,Default,,0,0,0,,үшін шамамен 17,8 миллион иен
Dialogue: 0,0:10:48.35,0:10:50.73,Default,,0,0,0,,Бұл да 7 адамға бөлінген болса...
Dialogue: 0,0:10:50.81,0:10:53.23,Default,,0,0,0,,Бір адамға 12 алтын тиын
Dialogue: 0,0:10:53.86,0:10:55.32,Default,,0,0,0,,Бөлшектер анама және
Dialogue: 0,0:10:55.40,0:10:58.82,Default,,0,0,0,,Оны Далияда тұратын қыздарға берейік.
Dialogue: 0,0:10:59.32,0:11:02.32,Default,,0,0,0,,Мен сені бүгін үйге апарайын ба?
Dialogue: 0,0:11:02.41,0:11:03.24,Default,,0,0,0,,Мияу~
Dialogue: 0,0:11:08.58,0:11:10.41,Default,,0,0,0,,Уау...
Dialogue: 0,0:11:11.08,0:11:13.50,Default,,0,0,0,,Хаха...
Dialogue: 0,0:11:14.38,0:11:16.34,Default,,0,0,0,,Керемет
Dialogue: 0,0:11:17.09,0:11:17.92,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:11:18.01,0:11:19.51,Default,,0,0,0,,-Анемон! -Аа...
Dialogue: 0,0:11:19.59,0:11:20.76,Default,,0,0,0,,А... а...
Dialogue: 0,0:11:24.76,0:11:26.26,Default,,0,0,0,,Мен уайымдадым...
Dialogue: 0,0:11:30.35,0:11:32.52,Default,,0,0,0,,Жоқ... сен мұндасың ба?
Dialogue: 0,0:11:32.60,0:11:34.27,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:35.48,0:11:39.49,Default,,0,0,0,,Маған келсеңіз, мен сізге бизнесті үйретемін.
Dialogue: 0,0:11:39.57,0:11:42.53,Default,,0,0,0,,Сіз енді жалғыздықты сезінбейсіз.
Dialogue: 0,0:11:42.61,0:11:44.62,Default,,0,0,0,,Біз бірге тұрамыз ба?
Dialogue: 0,0:11:44.70,0:11:46.78,Default,,0,0,0,,Кеничимен бірге болу
Dialogue: 0,0:11:46.87,0:11:49.54,Default,,0,0,0,,Анемон Бұл шынымен жақсы ма?
Dialogue: 0,0:11:49.62,0:11:51.29,Default,,0,0,0,,Анаманың қасында болғаны жақсы болар еді...
Dialogue: 0,0:11:51.37,0:11:53.58,Default,,0,0,0,,Кеничимен бірге болу
Dialogue: 0,0:11:54.13,0:11:55.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:56.92,0:11:58.05,Default,,0,0,0,,Қиын болған кезде
Dialogue: 0,0:11:58.13,0:12:00.63,Default,,0,0,0,,Кез келген уақытта маған келіңіз
Dialogue: 0,0:12:09.06,0:12:10.77,Default,,0,0,0,,Жарайды ма деп ойлаймын...
Dialogue: 0,0:12:11.27,0:12:14.94,Default,,0,0,0,,Дегенмен, бұл жеке таңдау.
Dialogue: 0,0:12:16.15,0:12:19.61,Default,,0,0,0,,Неліктен Анемон менімен бірге болғысы келеді?
Dialogue: 0,0:12:19.69,0:12:21.03,Default,,0,0,0,,Ммм
Dialogue: 0,0:12:21.11,0:12:24.03,Default,,0,0,0,,Кеничи мені тойдырды.
Dialogue: 0,0:12:24.11,0:12:25.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:25.20,0:12:27.32,Default,,0,0,0,,Хаха... Онда түскі ас ішейік.
Dialogue: 0,0:12:27.41,0:12:28.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:30.79,0:12:32.71,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:12:32.79,0:12:34.33,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:37.42,0:12:39.71,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:12:40.34,0:12:42.47,Default,,0,0,0,,Ұф… Хмм… Уу…
Dialogue: 0,0:12:43.05,0:12:44.09,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:12:44.18,0:12:46.47,Default,,0,0,0,,Кеничимен бірге кіріңіз! Кеничиге кіріңіз!
Dialogue: 0,0:12:46.55,0:12:47.72,Default,,0,0,0,,...
Dialogue: 0,0:12:47.80,0:12:49.26,Default,,0,0,0,,Біз бірге шомылдық...
Dialogue: 0,0:12:49.26,0:12:50.10,Default,,0,0,0,,Біз бірге шомылдық...
Dialogue: 0,0:12:49.26,0:12:50.10,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:12:50.18,0:12:52.60,Default,,0,0,0,,Кеничимен ұйықтау Кеничимен ұйықта
Dialogue: 0,0:12:52.68,0:12:55.64,Default,,0,0,0,,Сонымен бірге ұйықтадық.
Dialogue: 0,0:12:56.40,0:12:58.98,Default,,0,0,0,,Осындай балам болса да
Dialogue: 0,0:12:59.06,0:13:01.36,Default,,0,0,0,,Бұл таңқаларлық емес.
Dialogue: 0,0:13:02.82,0:13:06.74,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:20.84,0:13:22.00,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:22.09,0:13:24.76,Default,,0,0,0,,Хаха...
Dialogue: 0,0:13:27.84,0:13:29.97,Default,,0,0,0,,Содан бері жарты ай өтті
Dialogue: 0,0:13:30.05,0:13:31.93,Default,,0,0,0,,Солтүстік полюстің рыцары
Dialogue: 0,0:13:32.01,0:13:36.23,Default,,0,0,0,,Шағаны бағындырудағы жетістіктері үшін танылып, барон дәрежесіне көтерілген.
Dialogue: 0,0:13:36.73,0:13:41.07,Default,,0,0,0,,Маған кішігірім аумақ сеніп тапсырылды және қазір тұрғындарды жинап жатырмын.
Dialogue: 0,0:13:41.15,0:13:43.28,Default,,0,0,0,,Сіз де жұбайыңызды іздеп жүрсіз бе?
Dialogue: 0,0:13:43.36,0:13:45.15,Default,,0,0,0,,Сондай-ақ, бұл жай ғана өсек.
Dialogue: 0,0:13:45.24,0:13:48.78,Default,,0,0,0,,Бір дворян атағынан айырылған сияқты.
Dialogue: 0,0:13:49.49,0:13:52.91,Default,,0,0,0,,Ол Примула-санды ұрлау үшін қарақшыларды қолданатын адам.
Dialogue: 0,0:13:52.99,0:13:55.04,Default,,0,0,0,,Менің ойымша, бұл өзін-өзі өлтіру.
Dialogue: 0,0:13:57.00,0:13:58.12,Default,,0,0,0,,Бұл Дрейзин.
Dialogue: 0,0:13:58.21,0:13:59.04,Default,,0,0,0,,О...
Dialogue: 0,0:13:59.96,0:14:00.79,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:14:00.88,0:14:04.09,Default,,0,0,0,,Мистер Маллоу мен оның достары менің салған суреттеріме күлді.
Dialogue: 0,0:14:04.17,0:14:06.80,Default,,0,0,0,,Күткендей, менің бизнеске деген жақсы мұрным бар.
Dialogue: 0,0:14:06.88,0:14:09.64,Default,,0,0,0,,Drygene ыңғайлылығын бірден түсінді
Dialogue: 0,0:14:09.72,0:14:13.81,Default,,0,0,0,,Шаға оқиғасына дейін олар өнімді мұқият дайындап, саудаға шығарған.
Dialogue: 0,0:14:14.56,0:14:18.31,Default,,0,0,0,,Мен сол кезде күлдім, кешіріңіз.
Dialogue: 0,0:14:18.39,0:14:19.90,Default,,0,0,0,,Ал маған
Dialogue: 0,0:14:19.98,0:14:23.19,Default,,0,0,0,,Идеялық алым ретінде бес алтын монета төленді.
Dialogue: 0,0:14:23.27,0:14:25.65,Default,,0,0,0,,... Ақша табудың құпиясы
Dialogue: 0,0:14:25.73,0:14:29.82,Default,,0,0,0,,Бір нәрсе: өз идеяларыңызға құрмет көрсетуден қорықпаңыз.
Dialogue: 0,0:14:33.74,0:14:34.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:38.33,0:14:39.92,Default,,0,0,0,,Кеничи?
Dialogue: 0,0:14:40.00,0:14:41.08,Default,,0,0,0,,О... жоқ
Dialogue: 0,0:14:45.46,0:14:46.59,Default,,0,0,0,,Емтихан аяқталды.
Dialogue: 0,0:14:47.30,0:14:50.76,Default,,0,0,0,,Алған сыйымды барлығына таратып бердім.
Dialogue: 0,0:14:50.84,0:14:52.64,Default,,0,0,0,,Уау~
Dialogue: 0,0:14:53.18,0:14:54.60,Default,,0,0,0,,Қолма-қол ақша тобы және
Dialogue: 0,0:14:53.18,0:14:54.60,Default,,0,0,0,,Хаха...
Dialogue: 0,0:14:54.68,0:14:56.60,Default,,0,0,0,,Гильдия сертификатындағы жинақ тобы
Dialogue: 0,0:14:54.68,0:14:56.60,Default,,0,0,0,,Няху~
Dialogue: 0,0:14:56.68,0:14:58.98,Default,,0,0,0,,Мэрроу мырзадан алған дайындық ақшам да толықтай қайтарылды.
Dialogue: 0,0:14:58.98,0:15:00.73,Default,,0,0,0,,Мэрроу мырзадан алған дайындық ақшам да толығымен қайтарылды.
Dialogue: 0,0:14:58.98,0:15:00.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:00.81,0:15:04.86,Default,,0,0,0,,Бөлшекті сен көмектескен әйелдерге тарат...
Dialogue: 0,0:15:00.81,0:15:04.86,Default,,0,0,0,,(Әйелдердің қуаныш дауыстары)
Dialogue: 0,0:15:07.11,0:15:09.99,Default,,0,0,0,,Менің ойымша, мен оны осыншама бағаға аламын.
Dialogue: 0,0:15:10.07,0:15:12.45,Default,,0,0,0,,Олай болса бұл меннен.
Dialogue: 0,0:15:13.41,0:15:14.62,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:14.70,0:15:15.70,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:16.41,0:15:17.87,Default,,0,0,0,,Ах... хмм...
Dialogue: 0,0:15:29.21,0:15:30.97,Default,,0,0,0,,Анемон Кеттік
Dialogue: 0,0:15:31.05,0:15:31.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:34.72,0:15:37.97,Default,,0,0,0,,Хаха...
Dialogue: 0,0:15:38.06,0:15:38.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:45.56,0:15:46.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:46.48,0:15:47.27,Default,,0,0,0,,Хаха...
Dialogue: 0,0:15:47.27,0:15:48.40,Default,,0,0,0,,Хаха...
Dialogue: 0,0:15:47.27,0:15:48.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:48.40,0:15:49.86,Default,,0,0,0,,Хаха...
Dialogue: 0,0:15:49.86,0:15:50.86,Default,,0,0,0,,Хаха...
Dialogue: 0,0:15:49.86,0:15:50.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:51.74,0:15:54.20,Default,,0,0,0,,Хаха...
Dialogue: 0,0:16:05.42,0:16:06.79,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,0:16:12.88,0:16:16.80,Default,,0,0,0,,Біздің жұмыс беруші сізбен танысқысы келеді.
Dialogue: 0,0:16:16.89,0:16:19.85,Default,,0,0,0,,Сіз өзіңіздің сүйікті шақырылған аңдарыңызды осында шақыра алмайсыз.
Dialogue: 0,0:16:19.93,0:16:21.43,Default,,0,0,0,,Уақытыңызды босқа өткізбеңіз
Dialogue: 0,0:16:21.52,0:16:23.94,Default,,0,0,0,,«Бізге тек өмір керек»\NСондай-ақ,
Dialogue: 0,0:16:24.02,0:16:25.65,Default,,0,0,0,,...
Dialogue: 0,0:16:26.36,0:16:28.44,Default,,0,0,0,,Анемон Жарайды.
Dialogue: 0,0:16:28.52,0:16:29.44,Default,,0,0,0,,Шақыру!
Dialogue: 0,0:16:29.53,0:16:30.36,Default,,0,0,0,,(петардалардың дыбысы)
Dialogue: 0,0:16:30.36,0:16:31.19,Default,,0,0,0,,(петардалардың дыбысы)
Dialogue: 0,0:16:30.36,0:16:31.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:31.19,0:16:31.28,Default,,0,0,0,,(петардалардың дыбысы)
Dialogue: 0,0:16:31.28,0:16:32.32,Default,,0,0,0,,(петардалардың дыбысы)
Dialogue: 0,0:16:31.28,0:16:32.32,Default,,0,0,0,,- Иә! -(Еркектер) Уау!
Dialogue: 0,0:16:32.40,0:16:33.82,Default,,0,0,0,,-Ей! -(Ер) Ух...
Dialogue: 0,0:16:33.90,0:16:35.32,Default,,0,0,0,,...
Dialogue: 0,0:16:33.90,0:16:35.32,Default,,0,0,0,,(Ерлердің шошыған дауыстары)
Dialogue: 0,0:16:35.41,0:16:36.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:37.16,0:16:39.03,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,0:16:39.66,0:16:42.16,Default,,0,0,0,,Оо... әппақ!
Dialogue: 0,0:16:42.25,0:16:43.08,Default,,0,0,0,,-Қозғалмаңыз! -(Еркектер) А...
Dialogue: 0,0:16:43.16,0:16:46.58,Default,,0,0,0,,Егер сіз бұдан артық жасасаңыз, сіз жай ғана жарақат алмайсыз!
Dialogue: 0,0:16:46.67,0:16:49.59,Default,,0,0,0,,(Ерекшелердің шуы)
Dialogue: 0,0:16:49.67,0:16:50.71,Default,,0,0,0,,(Көліктің ішіндегі түрту дыбысы)
Dialogue: 0,0:16:50.80,0:16:52.59,Default,,0,0,0,,(Жыртылу дыбысы)
Dialogue: 0,0:16:52.67,0:16:54.22,Default,,0,0,0,,(Iris) Ол жұмысы барын айтып, бүгін таңертең кетті.
Dialogue: 0,0:16:56.72,0:16:58.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:58.10,0:17:00.10,Default,,0,0,0,,Кеничи-сан, енді ше?
Dialogue: 0,0:17:00.18,0:17:01.56,Default,,0,0,0,,Иә
Dialogue: 0,0:17:02.85,0:17:04.98,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:17:05.06,0:17:07.10,Default,,0,0,0,,Бұл асылдың ісі ме?
Dialogue: 0,0:17:07.19,0:17:09.57,Default,,0,0,0,,Патшаға қарсы топ шығар...
Dialogue: 0,0:17:09.65,0:17:10.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:10.57,0:17:13.74,Default,,0,0,0,,Лордпен бір рет кездескіңіз келе ме?
Dialogue: 0,0:17:10.57,0:17:13.74,Default,,0,0,0,,Хоуа~
Dialogue: 0,0:17:13.82,0:17:16.61,Default,,0,0,0,,Осы жердің иесі граф Аслепиос,
Dialogue: 0,0:17:16.70,0:17:18.74,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:17:18.82,0:17:22.66,Default,,0,0,0,,Сонда да салық салынса, оған қарсы тұра алмайсың, солай ма?
Dialogue: 0,0:17:22.75,0:17:24.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:31.38,0:17:33.34,Default,,0,0,0,,Уақыт келді...
Dialogue: 0,0:17:35.22,0:17:38.14,Default,,0,0,0,,Е, сен Кеничи-санды кездестірдің бе?
Dialogue: 0,0:17:38.22,0:17:39.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:39.76,0:17:41.76,Default,,0,0,0,,Мен әлі де өз тегімді аламын.
Dialogue: 0,0:17:41.85,0:17:43.47,Default,,0,0,0,,Мен сізге алғыс білдірген жоқпын.
Dialogue: 0,0:17:43.56,0:17:45.64,Default,,0,0,0,,Мен де сенімен танысқым келді.
Dialogue: 0,0:17:45.73,0:17:49.65,Default,,0,0,0,,Біз Дригенді ойлап тапқанымыз деп есептейміз.
Dialogue: 0,0:17:49.73,0:17:52.65,Default,,0,0,0,,Мен лордтан сыйлық аламын.
Dialogue: 0,0:17:52.73,0:17:55.36,Default,,0,0,0,,Сонымен қатар, тегіне де рұқсат етілген.
Dialogue: 0,0:17:55.86,0:17:59.78,Default,,0,0,0,,Фамилия өнертабысқа сәйкес «Дрейзин» болды.
Dialogue: 0,0:17:59.87,0:18:02.53,Default,,0,0,0,,Сондықтан менің заңды атым
Dialogue: 0,0:18:02.62,0:18:06.66,Default,,0,0,0,,Бұл «Primula ne Draisine» сияқты
Dialogue: 0,0:18:08.12,0:18:09.33,Default,,0,0,0,,Примула
Dialogue: 0,0:18:09.42,0:18:10.79,Default,,0,0,0,,Иә
Dialogue: 0,0:18:10.88,0:18:12.59,Default,,0,0,0,,Менің кемігім компаниясы
Dialogue: 0,0:18:12.67,0:18:16.05,Default,,0,0,0,,Мен Кеничи-саннан үлкен пайда алдым.
Dialogue: 0,0:18:16.13,0:18:19.05,Default,,0,0,0,,Мен бұл жақсылығымды өтеуім керек.
Dialogue: 0,0:18:19.13,0:18:21.68,Default,,0,0,0,,Иә, әке.
Dialogue: 0,0:18:26.23,0:18:27.18,Default,,0,0,0,,Алдымен
Dialogue: 0,0:18:27.27,0:18:30.77,Default,,0,0,0,,Кішкентай дүңгіршектегі үнсіз орта жастағы ер адам
Dialogue: 0,0:18:30.85,0:18:32.19,Default,,0,0,0,,Мен солай ойладым, бірақ
Dialogue: 0,0:18:32.27,0:18:35.69,Default,,0,0,0,,Мен онымен сөйлескенімде, ол таңқаларлықтай жұмсақ сөйледі.
Dialogue: 0,0:18:35.78,0:18:37.82,Default,,0,0,0,,Мен де зердікті сезіндім.
Dialogue: 0,0:18:37.90,0:18:39.95,Default,,0,0,0,,Біздің алып жүрген бұйымдарымыз да тамаша.
Dialogue: 0,0:18:40.03,0:18:43.20,Default,,0,0,0,,Онымен бизнес жүргізу арқылы ... сатылымдарын арттырды.
Dialogue: 0,0:18:43.28,0:18:45.83,Default,,0,0,0,,Қазір тіпті тегіне де рұқсат етілген.
Dialogue: 0,0:18:45.91,0:18:50.08,Default,,0,0,0,,Сондықтан мен шарасыздан жақындадым...
Dialogue: 0,0:18:51.71,0:18:53.25,Default,,0,0,0,,Бұл жақсы болмады.
Dialogue: 0,0:18:54.29,0:18:58.22,Default,,0,0,0,,Бірақ ол маған көмекке келді.
Dialogue: 0,0:18:59.05,0:19:01.30,Default,,0,0,0,,Мен сенімді болдым
Dialogue: 0,0:19:01.80,0:19:06.22,Default,,0,0,0,,Бұл адам маған көңіл бөледі.
Dialogue: 0,0:19:09.56,0:19:11.31,Default,,0,0,0,,Және шешті
Dialogue: 0,0:19:12.31,0:19:13.98,Default,,0,0,0,,Бұл адамға —
Dialogue: 0,0:19:14.94,0:19:16.53,Default,,0,0,0,,Қалыптастыруға тырысу
Dialogue: 0,0:19:20.70,0:19:21.86,Default,,0,0,0,,(Ватару) Ой, расымен бе? Мен ойлағаннан кіші екен.
Dialogue: 0,0:19:21.95,0:19:25.45,Default,,0,0,0,,Ол сені күтетініне сенімдімін.
Dialogue: 0,0:19:29.20,0:19:30.62,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:33.71,0:19:36.63,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:37.30,0:19:38.13,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:38.80,0:19:40.55,Default,,0,0,0,,Бірдеңе істегіңіз келсе
Dialogue: 0,0:19:40.63,0:19:44.85,Default,,0,0,0,,Әйелдерді тастап, бір жаққа жалғыз баратын адам.
Dialogue: 0,0:19:46.10,0:19:47.89,Default,,0,0,0,,А... а...
Dialogue: 0,0:19:58.57,0:19:59.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:03.45,0:20:04.41,Default,,0,0,0,,Фуё мырза!
Dialogue: 0,0:20:04.49,0:20:05.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:07.20,0:20:09.54,Default,,0,0,0,,Түсіндім, саудагерге...
Dialogue: 0,0:20:09.62,0:20:12.29,Default,,0,0,0,,Бұл көлік танымал Draisine ма?
Dialogue: 0,0:20:12.37,0:20:13.92,Default,,0,0,0,,Артыңыздағы қыз ше?
Dialogue: 0,0:20:14.00,0:20:16.42,Default,,0,0,0,,Оның қасында әдемі орман мысығы да бар.
Dialogue: 0,0:20:16.50,0:20:19.09,Default,,0,0,0,,Қазір қайда бара жатырсың?
Dialogue: 0,0:20:19.17,0:20:20.67,Default,,0,0,0,,Эх, ахах...
Dialogue: 0,0:20:25.76,0:20:27.64,Default,,0,0,0,,Үй қоймасы
Dialogue: 0,0:20:27.72,0:20:30.02,Default,,0,0,0,,О... жоғалып кетті ме?
Dialogue: 0,0:20:30.10,0:20:31.68,Default,,0,0,0,,О, керемет
Dialogue: 0,0:20:31.77,0:20:32.89,Default,,0,0,0,,(қозғалтқыштың іске қосу дыбысы)
Dialogue: 0,0:20:34.94,0:20:37.11,Default,,0,0,0,,Тағы қашасың ба...?
Dialogue: 0,0:20:37.65,0:20:40.19,Default,,0,0,0,,Мен мұнда не үшін келдім деп ойлаймын...
Dialogue: 0,0:20:40.94,0:20:45.49,Default,,0,0,0,,Жоқ, мен оған көмектесе алғаныма қуаныштымын.
Dialogue: 0,0:20:45.57,0:20:48.20,Default,,0,0,0,,Анамаға бармайтыныңызға сенімдісіз бе?
Dialogue: 0,0:20:48.28,0:20:50.20,Default,,0,0,0,,Маған Кеничимен бірге болған ұнайды.
Dialogue: 0,0:20:50.29,0:20:52.54,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:20:52.62,0:20:53.66,Default,,0,0,0,,- (Орман мысығы) Мяу - А?
Dialogue: 0,0:20:53.75,0:20:54.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:55.21,0:20:56.83,Default,,0,0,0,,Бұл сен кімсің?
Dialogue: 0,0:20:57.71,0:21:00.42,Default,,0,0,0,,Жарайды, жарайды, сіз де сарапшы ретінде өмір сүре аласыз.
Dialogue: 0,0:21:00.50,0:21:01.55,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:21:14.89,0:21:15.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:15.81,0:21:19.36,Default,,0,0,0,,Жүр, біз басқа жаққа барамыз.
Dialogue: 0,0:21:19.44,0:21:22.11,Default,,0,0,0,,Орман мысығы өз орманын тастап кеткені дұрыс па?
Dialogue: 0,0:21:22.19,0:21:23.36,Default,,0,0,0,,Мияу
Dialogue: 0,0:21:23.44,0:21:24.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:27.70,0:21:30.62,Default,,0,0,0,,Бұл менің жеке құрғақ генім.
Dialogue: 0,0:21:30.70,0:21:31.95,Default,,0,0,0,,Олар...
Dialogue: 0,0:21:33.20,0:21:35.58,Default,,0,0,0,,Менің отбасым
Dialogue: 0,0:21:35.66,0:21:38.08,Default,,0,0,0,,-Уау... -(Орман мысығы) Мияу
Dialogue: 0,0:21:38.96,0:21:41.13,Default,,0,0,0,,Мен саяхатқа шығайын деп жатырмын.
Dialogue: 0,0:21:41.21,0:21:44.67,Default,,0,0,0,,О, түсіндім. Мен бұған қызғанамын.
Dialogue: 0,0:21:44.76,0:21:47.09,Default,,0,0,0,,Бұл мақсатсыз сапар.
Dialogue: 0,0:21:47.18,0:21:49.59,Default,,0,0,0,,Мен сендерге ақ жол тілеймін.
Dialogue: 0,0:21:49.68,0:21:51.35,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:52.31,0:21:56.31,Default,,0,0,0,,Осылайша қарт, қыз, аң.
Dialogue: 0,0:21:56.39,0:21:58.85,Default,,0,0,0,,Келесі баратын жерді іздеу басталды
Dialogue: 0,0:21:59.52,0:22:01.48,Default,,0,0,0,,Бұл жолы мен соны мақсат етемін.
Dialogue: 0,0:22:02.65,0:22:04.48,Default,,0,0,0,,Баяу өмір
Dialogue: 0,0:22:05.94,0:22:09.95,Default,,0,0,0,,♪～
Dialogue: 0,0:23:32.20,0:23:35.87,Default,,0,0,0,,～♪
Dialogue: 0,0:23:37.37,0:23:43.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
