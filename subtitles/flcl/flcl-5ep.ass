Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.09,0:00:15.22,Default,,0000,0000,0000,,Қоршалған ня
Dialogue: 0,0:00:15.33,0:00:16.52,Default,,0000,0000,0000,,Мерген
Dialogue: 0,0:00:16.63,0:00:18.00,Default,,0000,0000,0000,,Алыстан нысанаға алыну
Dialogue: 0,0:00:18.10,0:00:19.73,Default,,0000,0000,0000,,Мергендер қиыншылық туғызады
Dialogue: 0,0:00:19.83,0:00:21.03,Default,,0000,0000,0000,,Мен қозғала алмаймын.
Dialogue: 0,0:00:21.13,0:00:22.69,Default,,0000,0000,0000,,Бірдеңе жасаңыз.
Dialogue: 0,0:00:23.30,0:00:26.20,Default,,0000,0000,0000,,Йоши! Мен қарт боламын. Бұл қауіпті, сондықтан сіз...
Dialogue: 0,0:00:26.31,0:00:27.57,Default,,0000,0000,0000,,Әрине!
Dialogue: 0,0:00:27.97,0:00:29.77,Default,,0000,0000,0000,,Бұл сіздің ойыныңыз!
Dialogue: 0,0:00:29.91,0:00:32.57,Default,,0000,0000,0000,,Кел, өл! Екеуіміздің махаббатымыз үшін!
Dialogue: 0,0:00:34.65,0:00:35.67,Default,,0000,0000,0000,,Аники!
Dialogue: 0,0:00:36.88,0:00:38.75,Default,,0000,0000,0000,,Өйткені, мен мылтық доппын...
Dialogue: 0,0:00:38.85,0:00:40.44,Default,,0000,0000,0000,,Аники...сен өле алмайсың!
Dialogue: 0,0:00:40.62,0:00:41.25,Default,,0000,0000,0000,,Энни...!
Dialogue: 0,0:00:41.69,0:00:43.21,Default,,0000,0000,0000,,Не... бұл не?
Dialogue: 0,0:00:43.32,0:00:45.12,Default,,0000,0000,0000,,Ой! Апыр-ай...!
Dialogue: 0,0:00:53.97,0:00:55.16,Default,,0000,0000,0000,,Не істеп жатырсың!
Dialogue: 0,0:00:58.81,0:01:02.00,Default,,0000,0000,0000,,Харуко-чан, ауырмайды.
Dialogue: 0,0:01:02.34,0:01:05.51,Default,,0000,0000,0000,,Жүз мың жыл бұрын! Эротикалық маймыл маймыл!
Dialogue: 0,0:01:06.58,0:01:09.52,Default,,0000,0000,0000,,Бұл дұрыс емес, Харуко-чан!
Dialogue: 0,0:01:10.02,0:01:11.68,Default,,0000,0000,0000,,Бұл не... ол сияқты?
Dialogue: 0,0:01:11.79,0:01:13.51,Default,,0000,0000,0000,,А... мынау қызыл күртеше ме?
Dialogue: 0,0:01:14.05,0:01:16.35,Default,,0000,0000,0000,,Неліктен Нао жасыл түсті жақсы көреді?
Dialogue: 0,0:01:16.92,0:01:18.05,Default,,0000,0000,0000,,Бұл ескі шығарма ма?
Dialogue: 0,0:01:18.76,0:01:21.16,Default,,0000,0000,0000,,Кали сарайы? Бұл стильді ханым
Dialogue: 0,0:01:21.26,0:01:24.99,Default,,0000,0000,0000,,Бірақ сіз білесіз бе, Маймыл мырза қызылға ашуланады.
Dialogue: 0,0:01:25.10,0:01:29.26,Default,,0000,0000,0000,,Қанша ұнатпаймын десе де... бұл үнемі бола бермейді.
Dialogue: 0,0:01:29.37,0:01:31.77,Default,,0000,0000,0000,,Ах! Қайда бара жатырсың? Наота-кун! Наота-кун!
Dialogue: 0,0:01:35.98,0:01:39.64,Default,,0000,0000,0000,,Иә? Менің оған деген жеке сезімім бар ма?
Dialogue: 0,0:01:39.85,0:01:42.11,Default,,0000,0000,0000,,Жоқ... олай емес.
Dialogue: 0,0:01:42.38,0:01:44.61,Default,,0000,0000,0000,,Миссияның кешігуі сондықтан емес...
Dialogue: 0,0:01:46.22,0:01:49.68,Default,,0000,0000,0000,,Н.О. арна ашық...
Dialogue: 0,0:01:49.79,0:01:52.42,Default,,0000,0000,0000,,Ұнатады, ұнатпайды, сол сияқты нәрселер...
Dialogue: 0,0:01:53.26,0:01:54.93,Default,,0000,0000,0000,,Радиотолқындар жақсы жұмыс істемейді...Жарайды ма?
Dialogue: 0,0:01:55.46,0:01:56.33,Default,,0000,0000,0000,,Сіз мұны естідіңіз бе?
Dialogue: 0,0:01:57.66,0:01:59.46,Default,,0000,0000,0000,,Тез киініңіз.
Dialogue: 0,0:02:01.07,0:02:02.47,Default,,0000,0000,0000,,Маған ұнайтын адам бар...
Dialogue: 0,0:02:02.80,0:02:03.50,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:02:03.67,0:02:05.90,Default,,0000,0000,0000,,Жоқ... тіпті қарапайым киім де емес.
Dialogue: 0,0:02:06.01,0:02:10.81,Default,,0000,0000,0000,,Мастер Харуконың гитара сыныбы 1 миллисекундта!
Dialogue: 0,0:02:10.81,0:02:12.85,Default,,0000,0000,0000,,Мұндай нәрсені түсіну қиын ба?
Dialogue: 0,0:02:14.58,0:02:16.81,Default,,0000,0000,0000,,Егер сіз гитараны пайдалана алсаңыз, сіз әбден жетілген болып көрінесіз!
Dialogue: 0,0:02:16.92,0:02:18.41,Default,,0000,0000,0000,,Қыздар арасында танымал!
Dialogue: 0,0:02:18.52,0:02:19.11,Default,,0000,0000,0000,,Пён?
Dialogue: 0,0:02:19.22,0:02:20.65,Default,,0000,0000,0000,,«Юзу» немесе «19»...
Dialogue: 0,0:02:20.75,0:02:22.85,Default,,0000,0000,0000,,«Патша» немесе «Ватана сәби»...
Dialogue: 0,0:02:22.96,0:02:23.32,Default,,0000,0000,0000,,- «Хидеки Каджи» сияқты нәрсе!
Dialogue: 0,0:02:23.32,0:02:24.95,Default,,0000,0000,0000,,- Қорқынышты қорқынышты! -"Хидеки Каджи"!
Dialogue: 0,0:02:25.83,0:02:27.49,Default,,0000,0000,0000,,Бір ғана адам бар...
Dialogue: 0,0:02:29.30,0:02:32.06,Default,,0000,0000,0000,,Жамбастарың осылай ілулі тұрса, не істейсің?
Dialogue: 0,0:02:32.27,0:02:37.86,Default,,0000,0000,0000,,Джими Хендрикс пен Маккартни мұның бәрін жасады!
Dialogue: 0,0:02:37.97,0:02:39.46,Default,,0000,0000,0000,,Не істеп жатырсың!
Dialogue: 0,0:02:41.98,0:02:44.47,Default,,0000,0000,0000,,Бұлай айналу қауіпті.
Dialogue: 0,0:02:44.84,0:02:47.54,Default,,0000,0000,0000,,Так-кунның гитарасы, оны қайта пайдаланып көріңіз.
Dialogue: 0,0:02:47.75,0:02:48.71,Default,,0000,0000,0000,,Кәкең...
Dialogue: 0,0:02:49.42,0:02:51.54,Default,,0000,0000,0000,,Өткен күндегідей ғажайып нәрсе
Dialogue: 0,0:02:51.95,0:02:53.11,Default,,0000,0000,0000,,Мені қызықтырмайды.
Dialogue: 0,0:02:53.75,0:02:55.45,Default,,0000,0000,0000,,Ересек адам болыңыз.
Dialogue: 0,0:02:55.56,0:02:56.85,Default,,0000,0000,0000,,Маған айтпа!
Dialogue: 0,0:03:12.17,0:03:14.54,Default,,0000,0000,0000,,Жоқ, бұл Таккун.
Dialogue: 0,0:03:14.64,0:03:16.70,Default,,0000,0000,0000,,Жоқ! Мүйіздер!
Dialogue: 0,0:03:17.14,0:03:18.70,Default,,0000,0000,0000,,Иә! Жоқ...
Dialogue: 0,0:03:19.21,0:03:20.80,Default,,0000,0000,0000,,Мен Таккунды талай рет сүйдім.
Dialogue: 0,0:03:20.91,0:03:23.54,Default,,0000,0000,0000,,Жоқ, бұл мүйіздердің кесірінен!
Dialogue: 0,0:03:23.65,0:03:25.85,Default,,0000,0000,0000,,Мукумуку пён пён Мукумуку пён пён!
Dialogue: 0,0:03:28.02,0:03:30.05,Default,,0000,0000,0000,,Наота-кун, мен сені кешіре алмаймын.
Dialogue: 0,0:03:30.16,0:03:33.46,Default,,0000,0000,0000,,Әкемнің қызметшісінен жасырынып, жасырын... қытық...
Dialogue: 0,0:03:33.50,0:03:34.49,Default,,0000,0000,0000,,- Мукумуку… Пён Пён…
Dialogue: 0,0:03:34.50,0:03:35.69,Default,,0000,0000,0000,,- Жоқ, одан да көп... - Мукумуку... Пён Пён...
Dialogue: 0,0:03:36.50,0:03:38.46,Default,,0000,0000,0000,,Көрдім, түсіндім, Наота-кун.
Dialogue: 0,0:03:38.70,0:03:40.89,Default,,0000,0000,0000,,Бұл Харуко үшін ер адамның ойыны!
Dialogue: 0,0:03:41.10,0:03:41.76,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:03:43.47,0:03:47.13,Default,,0000,0000,0000,,Бұл Харуко-сан үшін Кокчидің қаруы.
Dialogue: 0,0:04:00.29,0:04:02.78,Default,,0000,0000,0000,,Қарашы, қарашы, балам, не болды?
Dialogue: 0,0:04:07.53,0:04:09.39,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? қазірдің өзінде!
Dialogue: 0,0:04:11.03,0:04:14.02,Default,,0000,0000,0000,,Тек осылай қорқып...
Dialogue: 0,0:04:14.13,0:04:16.76,Default,,0000,0000,0000,,Харуко-санды осы әке алып кетеді.
Dialogue: 0,0:04:16.84,0:04:20.36,Default,,0000,0000,0000,,Яда яда Так-кун, мені қорға!
Dialogue: 0,0:04:20.54,0:04:21.63,Default,,0000,0000,0000,,Қазірдің өзінде! Бірге жабыспаңдар!
Dialogue: 0,0:04:24.48,0:04:27.88,Default,,0000,0000,0000,,Мені қалқан ретінде қолданба! Соққанда ауырады!
Dialogue: 0,0:04:28.68,0:04:30.21,Default,,0000,0000,0000,,Ямероттеба!
Dialogue: 0,0:04:38.96,0:04:40.95,Default,,0000,0000,0000,,Мақсатты қосымша расталды
Dialogue: 0,0:04:43.06,0:04:44.19,Default,,0000,0000,0000,,«Көк»! «Көк»!
Dialogue: 0,0:04:44.46,0:04:45.76,Default,,0000,0000,0000,,«Қызыл» емес пе?
Dialogue: 0,0:04:46.13,0:04:48.50,Default,,0000,0000,0000,,Оның «көк» екеніне сенімдісіз бе? Маған бәрібір
Dialogue: 0,0:04:48.57,0:04:50.66,Default,,0000,0000,0000,,Медициналық механикаға кейінгі келісім
Dialogue: 0,0:04:50.84,0:04:53.67,Default,,0000,0000,0000,,Мен мұны осында шешемін, әрі онымен араласуға жол бермеймін.
Dialogue: 0,0:04:53.81,0:04:55.30,Default,,0000,0000,0000,,Менің жұмысым бар, асығыңыздар.
Dialogue: 0,0:04:55.41,0:04:56.57,Default,,0000,0000,0000,,А...бірақ мен жақсылап сұраймын.
Dialogue: 0,0:04:56.68,0:04:59.11,Default,,0000,0000,0000,,Менің айтайын дегенім, ересек адам болу өте жақсы.
Dialogue: 0,0:04:59.45,0:05:02.45,Default,,0000,0000,0000,,Істер дұрыс болмаса, Медициналық механика күрделі түрде араласады.
Dialogue: 0,0:05:02.45,0:05:05.65,Default,,0000,0000,0000,,Дұрыс, Рахалды елемеңіз, бұл жағдайды қиындатады.
Dialogue: 0,0:05:05.79,0:05:07.25,Default,,0000,0000,0000,,Мен кеткенше өзіңді күт.
Dialogue: 0,0:05:07.32,0:05:08.25,Default,,0000,0000,0000,,Қарашы, сен ересек адам сияқтысың.
Dialogue: 0,0:05:08.36,0:05:11.65,Default,,0000,0000,0000,,Көптен көрмеген әйел сенімді көрінетін сияқты...
Dialogue: 0,0:05:11.76,0:05:13.66,Default,,0000,0000,0000,,Бұл менің ересектерге арналған жоспарым
Dialogue: 0,0:05:13.76,0:05:16.66,Default,,0000,0000,0000,,Мен үшін емес пе? Сол тәтті жігіт пе? Мүмкін болса, мен ең тәтті жігітті алғым келеді
Dialogue: 0,0:05:16.76,0:05:18.25,Default,,0000,0000,0000,,Супер әуесқой көңілді жігіт
Dialogue: 0,0:05:23.80,0:05:27.71,Default,,0000,0000,0000,,Тәтті тәтті! Бұл өте тәтті, Наота-кун!
Dialogue: 0,0:05:37.35,0:05:40.88,Default,,0000,0000,0000,,Сіз жай ғана ойнап жатырсыз ба? Бұл шынымен ақымақ көрінеді
Dialogue: 0,0:05:41.29,0:05:43.19,Default,,0000,0000,0000,,Маған ғана жететін сияқты.
Dialogue: 0,0:05:45.69,0:05:47.56,Default,,0000,0000,0000,,Көптен бері көрмеген әйел ше?
Dialogue: 0,0:05:51.03,0:05:53.29,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? Маған да көмектесуге рұқсат етіңіз!
Dialogue: 0,0:05:54.10,0:05:55.57,Default,,0000,0000,0000,,Өйткені менікі...
Dialogue: 0,0:05:55.67,0:05:58.69,Default,,0000,0000,0000,,Сіз не әкелдіңіз? Бұл аман қалу ойыны! Аман қалу ойыны!
Dialogue: 0,0:05:58.81,0:06:00.93,Default,,0000,0000,0000,,♪ Асадже Хируге Йоруге
Dialogue: 0,0:06:01.21,0:06:03.33,Default,,0000,0000,0000,,А... бірдеңе дұрыс емес...
Dialogue: 0,0:06:11.75,0:06:13.22,Default,,0000,0000,0000,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:06:14.05,0:06:14.95,Default,,0000,0000,0000,,Көк!
Dialogue: 0,0:06:14.95,0:06:15.86,Default,,0000,0000,0000,,Көк! Көк!
Dialogue: 0,0:06:15.86,0:06:16.72,Default,,0000,0000,0000,,Көк! Көк! Көк!
Dialogue: 0,0:06:16.72,0:06:17.59,Default,,0000,0000,0000,,Көк! Көк! Көк! Бұл көк!
Dialogue: 0,0:06:17.59,0:06:18.49,Default,,0000,0000,0000,,Кобальт!
Dialogue: 0,0:06:18.86,0:06:21.05,Default,,0000,0000,0000,,Балықтың қисаюына көк деп жаз...
Dialogue: 0,0:06:22.50,0:06:23.79,Default,,0000,0000,0000,,Скумбрия!
Dialogue: 0,0:06:25.17,0:06:26.22,Default,,0000,0000,0000,,Сабагердж!
Dialogue: 0,0:06:27.67,0:06:31.54,Default,,0000,0000,0000,,Ум...балық – көк, скумбрия – жаргон сөз.
Dialogue: 0,0:06:33.44,0:06:35.31,Default,,0000,0000,0000,,Торияаааааааааааааааааааа!
Dialogue: 0,0:06:35.31,0:06:36.17,Default,,0000,0000,0000,,Торияаааааааааааааааааа!
Dialogue: 0,0:06:37.54,0:06:40.57,Default,,0000,0000,0000,,ТВ-кун, қалғанын саған қалдырамын!
Dialogue: 0,0:06:41.38,0:06:43.14,Default,,0000,0000,0000,,Тағы бір адам қалды, мен жеңдім!
Dialogue: 0,0:07:01.67,0:07:03.03,Default,,0000,0000,0000,,Тамма! Танма! Танма!
Dialogue: 0,0:07:03.14,0:07:04.57,Default,,0000,0000,0000,,Тамманы үш ретке дейін қолдануға болады.
Dialogue: 0,0:07:06.47,0:07:07.91,Default,,0000,0000,0000,,Бұл қандай көздер?
Dialogue: 0,0:07:08.01,0:07:09.27,Default,,0000,0000,0000,,Қазір шешілді!
Dialogue: 0,0:07:10.48,0:07:11.38,Default,,0000,0000,0000,,Наота, жақсысың ба?
Dialogue: 0,0:07:11.48,0:07:13.00,Default,,0000,0000,0000,,Өлді ме? Бөліну?
Dialogue: 0,0:07:13.88,0:07:14.85,Default,,0000,0000,0000,,Жарақаттар туралы не деуге болады?
Dialogue: 0,0:07:16.35,0:07:18.41,Default,,0000,0000,0000,,Мен мұндай нәрсеге үйреніп қалғанмын.
Dialogue: 0,0:07:21.35,0:07:22.76,Default,,0000,0000,0000,,Бұл не...?
Dialogue: 0,0:07:22.76,0:07:24.78,Default,,0000,0000,0000,,Жеткізу Мен толық емес жұмыс күнімен жұмыс істеймін.
Dialogue: 0,0:07:25.09,0:07:27.36,Default,,0000,0000,0000,,Толық емес жұмыс күні? Сіз бастауыш сынып оқушысы болсаңыз да?
Dialogue: 0,0:07:27.46,0:07:29.36,Default,,0000,0000,0000,,Жарайды, жарайды, олар білмейді.
Dialogue: 0,0:07:29.46,0:07:31.86,Default,,0000,0000,0000,,Мен үнемі жүретін жалғыз жол - өзен бойында.
Dialogue: 0,0:07:32.07,0:07:33.76,Default,,0000,0000,0000,,Сіз әрқашан осылай істейсіз бе?
Dialogue: 0,0:07:34.10,0:07:35.86,Default,,0000,0000,0000,,Керемет...бұл
Dialogue: 0,0:07:38.54,0:07:40.67,Default,,0000,0000,0000,,Бұл дұрыс емес! Мінеки!
Dialogue: 0,0:07:40.77,0:07:42.54,Default,,0000,0000,0000,,Бұл ойыншық, солай ма? Менің шарларым шығады ма?
Dialogue: 0,0:07:42.64,0:07:43.17,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:07:43.68,0:07:46.07,Default,,0000,0000,0000,,Сонымен... м...
Dialogue: 0,0:07:46.18,0:07:49.21,Default,,0000,0000,0000,,Ах! Иә, Канчи! Мына шырын сатып ал!
Dialogue: 0,0:07:52.55,0:07:54.88,Default,,0000,0000,0000,,Ол тым қышқыл емес!
Dialogue: 0,0:07:57.09,0:07:59.46,Default,,0000,0000,0000,,Наотаса... тыңдап тұрсың ба?
Dialogue: 0,0:07:59.66,0:08:00.35,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:08:00.63,0:08:01.32,Default,,0000,0000,0000,,Сыбыс
Dialogue: 0,0:08:01.39,0:08:03.02,Default,,0000,0000,0000,,Сыбыс...не?
Dialogue: 0,0:08:03.83,0:08:04.76,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:08:05.30,0:08:10.07,Default,,0000,0000,0000,,Күні кешегі спутник апатында қаланы құтқарған Наота емес пе?
Dialogue: 0,0:08:12.77,0:08:15.40,Default,,0000,0000,0000,,Білесің бе, мектептегі тәртіпсіздік сияқты.
Dialogue: 0,0:08:15.51,0:08:18.88,Default,,0000,0000,0000,,Сондықтан менің ойымша, Наота бұл роботты жылжытып жатыр...
Dialogue: 0,0:08:19.31,0:08:19.87,Default,,0000,0000,0000,,...Не!
Dialogue: 0,0:08:24.12,0:08:26.98,Default,,0000,0000,0000,,Неліктен мұндай өсек бар?
Dialogue: 0,0:08:27.35,0:08:29.51,Default,,0000,0000,0000,,Олай болса мен ештеңе істей алмаймын.
Dialogue: 0,0:08:29.92,0:08:33.82,Default,,0000,0000,0000,,Иә? Сіз қозғалып жатырмын деп айтқан кезде, бұл роботты басқарып жатқаныңызды білдіре ме?
Dialogue: 0,0:08:33.93,0:08:36.19,Default,,0000,0000,0000,,Наота ше? Бұл шынымен рас па?
Dialogue: 0,0:08:36.30,0:08:37.52,Default,,0000,0000,0000,,Бұл керемет, Жан!
Dialogue: 0,0:08:38.00,0:08:39.30,Default,,0000,0000,0000,,Бұл рас...
Dialogue: 0,0:08:39.30,0:08:39.73,Default,,0000,0000,0000,,Пён!
Dialogue: 0,0:08:39.83,0:08:41.13,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:08:41.37,0:08:41.57,Default,,0000,0000,0000,,- Чудың әпкесі!
Dialogue: 0,0:08:41.57,0:08:42.34,Default,,0000,0000,0000,,- Жібер, Харуко! - Чудың әпкесі!
Dialogue: 0,0:08:42.34,0:08:42.47,Default,,0000,0000,0000,,- Жібер, Харуко!
Dialogue: 0,0:08:42.47,0:08:43.20,Default,,0000,0000,0000,,- Жібер, Харуко! - Шайнаңыз!
Dialogue: 0,0:08:43.20,0:08:43.30,Default,,0000,0000,0000,,- Шайнаңыз!
Dialogue: 0,0:08:43.30,0:08:43.87,Default,,0000,0000,0000,,- Шайнаңыз! Шайнаңыз!
Dialogue: 0,0:08:43.87,0:08:44.00,Default,,0000,0000,0000,,- Харуко! Тоқта! - Шайнаңыз! Шайнаңыз!
Dialogue: 0,0:08:44.00,0:08:44.84,Default,,0000,0000,0000,,- Харуко! Тоқта! - Шайнаңыз! Шайнаңыз!
Dialogue: 0,0:08:44.84,0:08:44.90,Default,,0000,0000,0000,,- Харуко! Тоқта!
Dialogue: 0,0:08:44.91,0:08:46.70,Default,,0000,0000,0000,,- Харуко! Тоқта! - Ах! Соқ!
Dialogue: 0,0:08:47.04,0:08:49.17,Default,,0000,0000,0000,,Шынымен бе? Бір минут күте тұрыңыз
Dialogue: 0,0:08:50.94,0:08:51.71,Default,,0000,0000,0000,,Иә, бұл
Dialogue: 0,0:08:51.88,0:08:52.57,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:08:52.88,0:08:53.54,Default,,0000,0000,0000,,Жүлделер
Dialogue: 0,0:08:54.05,0:08:56.35,Default,,0000,0000,0000,,Мен толық емес жұмыс күнім үшін ақша төлеуді жоспарладым.
Dialogue: 0,0:09:02.09,0:09:02.88,Default,,0000,0000,0000,,Әдемі...
Dialogue: 0,0:09:09.63,0:09:11.82,Default,,0000,0000,0000,,Сәлем! Самеджи!
Dialogue: 0,0:09:25.75,0:09:28.48,Default,,0000,0000,0000,,Сіз кездесіп жатқаныңызға сенімдісіз бе?
Dialogue: 0,0:09:28.65,0:09:31.98,Default,,0000,0000,0000,,Иә? Бірақ бұл Наотаның ағасының қызы емес пе?
Dialogue: 0,0:09:32.52,0:09:34.51,Default,,0000,0000,0000,,Нені алдың? тапсырма?
Dialogue: 0,0:09:34.75,0:09:38.92,Default,,0000,0000,0000,,Бірақ, бірақ, Чудың әпкесі де Наотаны ұнататын сияқты...
Dialogue: 0,0:09:38.99,0:09:40.32,Default,,0000,0000,0000,,Мен танымалмын.
Dialogue: 0,0:09:41.73,0:09:42.96,Default,,0000,0000,0000,,«Тубу-Тубу»?
Dialogue: 0,0:09:44.63,0:09:47.50,Default,,0000,0000,0000,,Осы күндері «Тубу-Тубу» ұнай ма?
Dialogue: 0,0:09:47.67,0:09:51.07,Default,,0000,0000,0000,,Жоқ...өте қышқыл емес...көрдің бе?
Dialogue: 0,0:09:51.50,0:09:53.56,Default,,0000,0000,0000,,Мен сені сүйемін, Хару-сан...
Dialogue: 0,0:09:54.97,0:09:56.30,Default,,0000,0000,0000,,«Тубу-Тубу»
Dialogue: 0,0:09:58.58,0:09:59.67,Default,,0000,0000,0000,,Мен көрдім
Dialogue: 0,0:10:01.28,0:10:02.68,Default,,0000,0000,0000,,Мен қарап отырдым...
Dialogue: 0,0:10:03.05,0:10:04.74,Default,,0000,0000,0000,,Сіз бұл туралы алаңдайсыз ба?
Dialogue: 0,0:10:05.59,0:10:08.68,Default,,0000,0000,0000,,Жоқ...Мені Харуко қызықтырмайды.
Dialogue: 0,0:10:08.79,0:10:10.45,Default,,0000,0000,0000,,Мен екінші жағын білмеймін.
Dialogue: 0,0:10:10.56,0:10:14.86,Default,,0000,0000,0000,,Ах! Жоқ, дәл қазір Харуко көңілін көтеріп, күңкілдеді...
Dialogue: 0,0:10:14.86,0:10:16.58,Default,,0000,0000,0000,,Мұндай жағдайлар үнемі болып тұрады...
Dialogue: 0,0:10:16.66,0:10:21.16,Default,,0000,0000,0000,,Сондықтан мен мұны әрқашан істейтін нәрсе деп айтсам да, бұл мен оны үнемі жасаймын дегенді білдірмейді...
Dialogue: 0,0:10:21.50,0:10:24.54,Default,,0000,0000,0000,,Бұл керемет, Канчи-саманы айдап келе жатыр...
Dialogue: 0,0:10:24.54,0:10:28.00,Default,,0000,0000,0000,,Қорқынышты алыппен күресу арқылы қаланы жеңу
Dialogue: 0,0:10:28.27,0:10:30.24,Default,,0000,0000,0000,,Бұл! Сіз оны көрдіңіз бе? Қайдан?
Dialogue: 0,0:10:30.51,0:10:33.74,Default,,0000,0000,0000,,Так-кун соңғы кездері таң қалдырды...
Dialogue: 0,0:10:34.25,0:10:36.08,Default,,0000,0000,0000,,Жоқ, бұл үлкен мәселе емес.
Dialogue: 0,0:10:37.95,0:10:39.38,Default,,0000,0000,0000,,Үлкен мәселе емес
Dialogue: 0,0:10:39.52,0:10:42.98,Default,,0000,0000,0000,,Өткенде мен қаланы құтқарып қалдым...
Dialogue: 0,0:10:43.26,0:10:45.49,Default,,0000,0000,0000,,Көрдім, Мәмими де қарап тұрды.
Dialogue: 0,0:10:47.49,0:10:48.89,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:10:53.37,0:10:55.16,Default,,0000,0000,0000,,Су...дәлірек айтсақ, өзен...
Dialogue: 0,0:10:55.27,0:10:58.14,Default,,0000,0000,0000,,Кешіріңіз, мен мақсатымнан айырылдым.
Dialogue: 0,0:10:58.24,0:10:59.73,Default,,0000,0000,0000,,Бұл өзен бірінші класты өзен ме?
Dialogue: 0,0:10:59.84,0:11:01.36,Default,,0000,0000,0000,,Ол қорқынышты.
Dialogue: 0,0:11:01.64,0:11:03.91,Default,,0000,0000,0000,,Ол сабырлы жүзбен ұшып бара жатты...
Dialogue: 0,0:11:08.58,0:11:10.17,Default,,0000,0000,0000,,Кицурубами-кун! Китсурубами-кун!
Dialogue: 0,0:11:10.28,0:11:11.68,Default,,0000,0000,0000,,Не болды? Тағы су ма?
Dialogue: 0,0:11:11.78,0:11:12.72,Default,,0000,0000,0000,,Суық!
Dialogue: 0,0:11:12.82,0:11:13.22,Default,,0000,0000,0000,,- Осыдан кейін шашымның түсімен не істеуім керек?
Dialogue: 0,0:11:13.22,0:11:14.32,Default,,0000,0000,0000,,- Ыстық! Бұл ыстық! - Осыдан кейін шаштың түсімен не істеу керек?
Dialogue: 0,0:11:14.32,0:11:14.39,Default,,0000,0000,0000,,- Осыдан кейін шашымның түсімен не істеуім керек?
Dialogue: 0,0:11:14.39,0:11:15.62,Default,,0000,0000,0000,,- Китсурубами-кун! Ол «қызылға» өзгермес бұрын... - Осыдан кейін шаштың түсімен не істеу керек?
Dialogue: 0,0:11:15.62,0:11:16.36,Default,,0000,0000,0000,,- Кицурубами-кун! Ол «қызылға» айналмай тұрып...
Dialogue: 0,0:11:16.36,0:11:18.19,Default,,0000,0000,0000,,- Китсурубами-кун! «Қызылға» айналғанша... – Кәдімгідей күрең қызыл түсті ме?
Dialogue: 0,0:11:18.19,0:11:18.59,Default,,0000,0000,0000,,- Кәдімгідей каштан қызыл түсті ме?
Dialogue: 0,0:11:18.73,0:11:19.75,Default,,0000,0000,0000,,Ей! Польнареф!
Dialogue: 0,0:11:20.36,0:11:21.59,Default,,0000,0000,0000,,FLCL түсі?
Dialogue: 0,0:11:22.66,0:11:24.13,Default,,0000,0000,0000,,Тегін...
Dialogue: 0,0:11:24.13,0:11:25.62,Default,,0000,0000,0000,,Каштан…?
Dialogue: 0,0:11:31.37,0:11:33.00,Default,,0000,0000,0000,,Не? Сол Майюге!
Dialogue: 0,0:11:33.11,0:11:36.10,Default,,0000,0000,0000,,Көлемді ерлердің сүйкімділігі ме?
Dialogue: 0,0:11:36.21,0:11:39.04,Default,,0000,0000,0000,,Сіз қысқа кесілген әйелдер арасында танымалсыз ба?
Dialogue: 0,0:11:40.01,0:11:40.91,Default,,0000,0000,0000,,Рахал…
Dialogue: 0,0:11:41.15,0:11:44.08,Default,,0000,0000,0000,,Теме! Сіз төмендегі адамға бірдеңе істеп жатырсыз ба?
Dialogue: 0,0:11:51.22,0:11:51.88,Default,,0000,0000,0000,,Бару...
Dialogue: 0,0:11:51.99,0:11:53.48,Default,,0000,0000,0000,,Неге атып жатырсың?
Dialogue: 0,0:11:55.96,0:11:58.83,Default,,0000,0000,0000,,Бүгін сол қалпақ астында тағы да FLCL бар ма?
Dialogue: 0,0:12:01.40,0:12:04.13,Default,,0000,0000,0000,,Шынымды айтсам, Таккун тым керемет.
Dialogue: 0,0:12:04.50,0:12:09.77,Default,,0000,0000,0000,,Мен оны сипап қойдым... Мен оны басып қалдым... Мен оны шатастырдым...
Dialogue: 0,0:12:10.58,0:12:13.77,Default,,0000,0000,0000,,Сен қашан осындай таккун болып кеттің?
Dialogue: 0,0:12:13.98,0:12:15.28,Default,,0000,0000,0000,,есімде жоқ.
Dialogue: 0,0:12:15.55,0:12:18.71,Default,,0000,0000,0000,,Бұл Хару-сан келгеннен кейін болса керек...
Dialogue: 0,0:12:22.12,0:12:23.68,Default,,0000,0000,0000,,Эй, бұл...
Dialogue: 0,0:12:26.26,0:12:27.12,Default,,0000,0000,0000,,Жүр.
Dialogue: 0,0:12:27.46,0:12:29.36,Default,,0000,0000,0000,,Жоқ! Бұл келе жатыр!
Dialogue: 0,0:12:45.21,0:12:47.54,Default,,0000,0000,0000,,Мен де мәңгілік бала болмаймын.
Dialogue: 0,0:12:47.65,0:12:50.14,Default,,0000,0000,0000,,Сақтандыруды қай жаста алу керек?
Dialogue: 0,0:12:51.02,0:12:52.61,Default,,0000,0000,0000,,Бұл өте қауіпті робот.
Dialogue: 0,0:12:52.92,0:12:55.82,Default,,0000,0000,0000,,Егер оны тез шешу мүмкін болмаса, Медициналық механика жұмыс істей бастайды.
Dialogue: 0,0:12:56.56,0:13:01.12,Default,,0000,0000,0000,,Түсінесіз бе? Олар осы мақсат үшін осы планетада зауытты іске қосуға дайын.
Dialogue: 0,0:13:02.06,0:13:02.86,Default,,0000,0000,0000,,Және бұл ...
Dialogue: 0,0:13:03.26,0:13:05.82,Default,,0000,0000,0000,,Қызыл түске боялған зат... «Атомск»
Dialogue: 0,0:13:28.59,0:13:29.38,Default,,0000,0000,0000,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:13:38.76,0:13:39.66,Default,,0000,0000,0000,,Қандай жігіт...
Dialogue: 0,0:13:40.17,0:13:41.63,Default,,0000,0000,0000,,Бұл үлкен мәселе емес.
Dialogue: 0,0:13:41.77,0:13:44.26,Default,,0000,0000,0000,,Әңгіме әлгі әйелге келгенде, сен мүлдем ақымақсың, солай ма?
Dialogue: 0,0:13:44.47,0:13:46.73,Default,,0000,0000,0000,,Неге мені сонша тартасың?
Dialogue: 0,0:13:47.07,0:13:48.23,Default,,0000,0000,0000,,Ауырды!
Dialogue: 0,0:13:49.01,0:13:52.14,Default,,0000,0000,0000,,Шынымды айтсам, ол келгеннен бері жаман күнім болған жоқ.
Dialogue: 0,0:13:52.71,0:13:55.65,Default,,0000,0000,0000,,Қараңызшы, біз енді сирек кездесеміз...
Dialogue: 0,0:13:55.75,0:13:57.51,Default,,0000,0000,0000,,Бұрынғы күндер жақсырақ еді
Dialogue: 0,0:13:59.62,0:14:00.88,Default,,0000,0000,0000,,Ал, енді демалайық.
Dialogue: 0,0:14:01.75,0:14:03.95,Default,,0000,0000,0000,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:14:04.36,0:14:06.06,Default,,0000,0000,0000,,Жарайды, шай.
Dialogue: 0,0:14:06.06,0:14:06.89,Default,,0000,0000,0000,,Сізге ұнамайды ма?
Dialogue: 0,0:14:07.19,0:14:10.39,Default,,0000,0000,0000,,Так-кун мұндай әрекеттерге бармауы керек.
Dialogue: 0,0:14:10.80,0:14:11.29,Default,,0000,0000,0000,,Өйткені...
Dialogue: 0,0:14:12.67,0:14:13.53,Default,,0000,0000,0000,,Сіз...
Dialogue: 0,0:14:13.67,0:14:15.10,Default,,0000,0000,0000,,Бұл Хару-санның кінәсі, солай ма?
Dialogue: 0,0:14:15.20,0:14:16.73,Default,,0000,0000,0000,,Не? Ол жігіттің бұған қатысы жоқ.
Dialogue: 0,0:14:16.84,0:14:18.13,Default,,0000,0000,0000,,Саған Хару-сан ұнай ма?
Dialogue: 0,0:14:18.24,0:14:20.73,Default,,0000,0000,0000,,Менің мұндай ессіз әйелді ұнатуыма ешқандай себеп жоқ, солай ма?
Dialogue: 0,0:14:20.84,0:14:21.83,Default,,0000,0000,0000,,Сізге қаншалықты ұнайды?
Dialogue: 0,0:14:21.94,0:14:24.41,Default,,0000,0000,0000,,Жоқ! Мен сен туралы айтып отырмын...
Dialogue: 0,0:14:24.51,0:14:25.17,Default,,0000,0000,0000,,Таккун…
Dialogue: 0,0:14:25.28,0:14:27.08,Default,,0000,0000,0000,,Саған Хару-сан ұнайды, солай ма?
Dialogue: 0,0:14:32.69,0:14:34.05,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:14:34.32,0:14:36.48,Default,,0000,0000,0000,,Менің істеген ісім тіпті Мамимиге де ұнайды, солай ма?
Dialogue: 0,0:14:39.59,0:14:41.12,Default,,0000,0000,0000,,Қауіпті! қауіпті! Бұл қауіпті!
Dialogue: 0,0:15:04.42,0:15:05.78,Default,,0000,0000,0000,,Ал... Майюге!
Dialogue: 0,0:15:07.79,0:15:08.59,Default,,0000,0000,0000,,Қараңыз!
Dialogue: 0,0:15:08.60,0:15:10.90,Default,,0000,0000,0000,,Медициналық механика тіпті осындай нәрселерге инвестициялады ...
Dialogue: 0,0:15:10.90,0:15:12.96,Default,,0000,0000,0000,,Мен бұл планетаны жоюды жоспарлап отырмын!
Dialogue: 0,0:15:14.06,0:15:15.53,Default,,0000,0000,0000,,Бітті...
Dialogue: 0,0:15:16.10,0:15:17.69,Default,,0000,0000,0000,,Сіз жауапкершілікті қалай аласыз?
Dialogue: 0,0:15:17.83,0:15:20.16,Default,,0000,0000,0000,,Бұны білмедім, Маю, асыл.
Dialogue: 0,0:15:20.27,0:15:21.53,Default,,0000,0000,0000,,Бұл сен кінәлісің!
Dialogue: 0,0:15:21.67,0:15:23.79,Default,,0000,0000,0000,,Бұл маңызды емес!
Dialogue: 0,0:15:23.94,0:15:25.70,Default,,0000,0000,0000,,Бұл гитара бәрібір пайдасыз.
Dialogue: 0,0:15:26.37,0:15:30.57,Default,,0000,0000,0000,,Бұл миллион жыл ерте! Бұл маймыл маймыл!
Dialogue: 0,0:15:30.74,0:15:34.54,Default,,0000,0000,0000,,Бұл дамушы планеталардағы адамдарға қатысты кемсітушілік!
Dialogue: 0,0:15:35.35,0:15:39.05,Default,,0000,0000,0000,,FLCL FLCL… FLCL FLCL…
Dialogue: 0,0:15:39.22,0:15:40.34,Default,,0000,0000,0000,,Осындай жерде...?
Dialogue: 0,0:15:40.49,0:15:44.82,Default,,0000,0000,0000,,Ал... жаман қас... қассыз... қас...
Dialogue: 0,0:15:49.53,0:15:51.76,Default,,0000,0000,0000,,Сен әлі кішкентайсың...
Dialogue: 0,0:15:53.70,0:15:55.60,Default,,0000,0000,0000,,Бұрынғыдай
Dialogue: 0,0:15:56.70,0:15:58.76,Default,,0000,0000,0000,,Так-кун маған қарағанда жақсы болды.
Dialogue: 0,0:15:59.14,0:16:00.87,Default,,0000,0000,0000,,Менімен тағы да ойна...
Dialogue: 0,0:16:03.78,0:16:04.71,Default,,0000,0000,0000,,Боқ...
Dialogue: 0,0:16:04.91,0:16:06.90,Default,,0000,0000,0000,,Бастауыш сынып оқушылары сондай жақсы ма?
Dialogue: 0,0:16:07.31,0:16:10.25,Default,,0000,0000,0000,,Мен жақсы емеспін бе?
Dialogue: 0,0:16:16.56,0:16:17.58,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:16:29.17,0:16:29.93,Default,,0000,0000,0000,,Харуко!
Dialogue: 0,0:16:30.20,0:16:32.73,Default,,0000,0000,0000,,Дайкон V!
Dialogue: 0,0:16:35.54,0:16:37.30,Default,,0000,0000,0000,,Тоқта, Харуко!
Dialogue: 0,0:16:37.44,0:16:39.31,Default,,0000,0000,0000,,Сенпай! Тапсырма аға!
Dialogue: 0,0:16:40.28,0:16:41.61,Default,,0000,0000,0000,,Енді бұлай болмайды
Dialogue: 0,0:16:41.71,0:16:42.70,Default,,0000,0000,0000,,Көмектесші, Түск-сенпай!
Dialogue: 0,0:16:42.82,0:16:43.41,Default,,0000,0000,0000,,Тапсырма-сенпай!
Dialogue: 0,0:16:43.52,0:16:44.11,Default,,0000,0000,0000,,Тапсырма-сенпай!
Dialogue: 0,0:16:44.22,0:16:44.71,Default,,0000,0000,0000,,Тапсырма-сенпай!
Dialogue: 0,0:16:44.82,0:16:45.94,Default,,0000,0000,0000,,Бұл менің ағам емес!
Dialogue: 0,0:16:46.39,0:16:48.95,Default,,0000,0000,0000,,Бұл менмін, солай ма? Саған көмектесетін менмін, солай ма?
Dialogue: 0,0:16:49.26,0:16:52.25,Default,,0000,0000,0000,,Маған қара! Мен саған көмектесемін!
Dialogue: 0,0:16:52.36,0:16:53.55,Default,,0000,0000,0000,,Канчи! !
Dialogue: 0,0:16:59.83,0:17:01.56,Default,,0000,0000,0000,,Жарайсың ба? Мен Наотамын!
Dialogue: 0,0:17:01.77,0:17:03.46,Default,,0000,0000,0000,,Енді мені Так-кун деп атама!
Dialogue: 0,0:17:46.91,0:17:48.04,Default,,0000,0000,0000,,Пайдасыз!
Dialogue: 0,0:17:49.62,0:17:50.84,Default,,0000,0000,0000,,Сәлеметсіз бе!
Dialogue: 0,0:18:00.83,0:18:02.73,Default,,0000,0000,0000,,Құлап жатырмын! артқа! артқа!
Dialogue: 0,0:18:02.83,0:18:04.35,Default,,0000,0000,0000,,Иә? Керісінше қайда?
Dialogue: 0,0:18:07.27,0:18:08.23,Default,,0000,0000,0000,,Не? не?
Dialogue: 0,0:18:08.37,0:18:09.00,Default,,0000,0000,0000,,Сәлем...
Dialogue: 0,0:18:09.00,0:18:09.80,Default,,0000,0000,0000,,Йоме...?
Dialogue: 0,0:18:11.27,0:18:12.60,Default,,0000,0000,0000,,Тодом!
Dialogue: 0,0:18:23.68,0:18:25.08,Default,,0000,0000,0000,,Енді оқ жоқ!
Dialogue: 0,0:18:39.13,0:18:40.03,Default,,0000,0000,0000,,Жетекші!
Dialogue: 0,0:18:40.27,0:18:42.93,Default,,0000,0000,0000,,Сондықтан мүмкін емес дедім!
Dialogue: 0,0:18:56.95,0:18:58.85,Default,,0000,0000,0000,,Бұл жаман! Ол зауытқа барады!
Dialogue: 0,0:18:58.95,0:19:00.32,Default,,0000,0000,0000,,Мен зауытты басқарамын!
Dialogue: 0,0:19:02.29,0:19:02.85,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:19:12.50,0:19:13.73,Default,,0000,0000,0000,,А...бұл...!
Dialogue: 0,0:19:13.97,0:19:15.13,Default,,0000,0000,0000,,Атомск…
Dialogue: 0,0:19:15.87,0:19:20.36,Default,,0000,0000,0000,,Гибсон EB-0 61 жылдық үлгісі! !
Dialogue: 0,0:19:38.89,0:19:40.02,Default,,0000,0000,0000,,Бұл шын...
Dialogue: 0,0:19:41.56,0:19:43.69,Default,,0000,0000,0000,,Ол нағыз қарақшылардың патшасы...
Dialogue: 0,0:20:31.78,0:20:32.97,Default,,0000,0000,0000,,Атомск…
Dialogue: 0,0:20:44.96,0:20:46.08,Default,,0000,0000,0000,,Бұл ауыр көрінеді...
Dialogue: 0,0:21:02.64,0:21:08.10,Default,,0000,0000,0000,,♪ Қызғылт сары слайд аспанды көрсетеді
Dialogue: 0,0:21:09.51,0:21:14.50,Default,,0000,0000,0000,,♪ Губканың мақтанышы ілулі
Dialogue: 0,0:21:14.85,0:21:16.21,Default,,0000,0000,0000,,♪ Өрмекші
Dialogue: 0,0:21:16.32,0:21:22.95,Default,,0000,0000,0000,,♪ Тірідей тұтқынға алындым деген ескертуді жасырудың қажеті жоқ.
Dialogue: 0,0:21:23.06,0:21:27.58,Default,,0000,0000,0000,,♪ Түсті түс көргім келеді
Dialogue: 0,0:21:29.26,0:21:31.79,Default,,0000,0000,0000,,♪ Аққан жұлдызға міну
Dialogue: 0,0:21:32.60,0:21:43.30,Default,,0000,0000,0000,,♪ Жүрегімнің үнімен мылтықтай ән сала бердім
Dialogue: 0,0:21:51.22,0:21:56.38,Default,,0000,0000,0000,,♪ гранж хомяктары жетілген
Dialogue: 0,0:21:58.12,0:22:03.29,Default,,0000,0000,0000,,♪ Кек лобсты әкел
Dialogue: 0,0:22:03.40,0:22:04.73,Default,,0000,0000,0000,,♪ Мерген
Dialogue: 0,0:22:04.83,0:22:11.54,Default,,0000,0000,0000,,♪ Сол шеткі дүниеден не көруге болады?
Dialogue: 0,0:22:11.64,0:22:15.63,Default,,0000,0000,0000,,♪ Мен оны көздегенше ұстағым келеді.
Dialogue: 0,0:22:17.71,0:22:20.44,Default,,0000,0000,0000,,♪ Аққан жұлдызға міну
Dialogue: 0,0:22:21.28,0:22:24.72,Default,,0000,0000,0000,,♪ Сізді іздеп, менде абстиненттік симптомдар болды, мен өтірік айттым.
Dialogue: 0,0:22:24.72,0:22:31.66,Default,,0000,0000,0000,,♪ Сізді іздеп, менде абстиненттік симптомдар болды, мен өтірік айттым.
Dialogue: 0,0:22:31.76,0:22:34.59,Default,,0000,0000,0000,,♪ Аққан жұлдызға міну
Dialogue: 0,0:22:35.06,0:22:45.90,Default,,0000,0000,0000,,♪ Жүрегімнің үнімен мылтықтай ән сала бердім
Dialogue: 0,0:23:12.37,0:23:14.68,Default,,0000,0000,0000,,Мен бәріне ренжідім, бірақ...
Dialogue: 0,0:23:14.68,0:23:17.89,Default,,0000,0000,0000,,Бұл соңғы эпизод болса да, айтатын көп нәрсе жоқ.
Dialogue: 0,0:23:17.92,0:23:20.21,Default,,0000,0000,0000,,Мен аздап алғыр болуға тырыссам да FLCL-ге ұқсамайды.
Dialogue: 0,0:23:20.45,0:23:23.35,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Ол дұрыс аяқталды ма? Директор
Dialogue: 0,0:23:23.35,0:23:24.92,Default,,0000,0000,0000,,А...иә...мүмкін
Dialogue: 0,0:23:24.92,0:23:26.62,Default,,0000,0000,0000,,Келесі жолы: FLCL соңғы эпизоды!
Dialogue: 0,0:23:26.62,0:23:27.45,Default,,0000,0000,0000,,«Фликра»
Dialogue: 0,0:23:27.45,0:23:29.94,Default,,0000,0000,0000,,Жақсы, Конняроме де осылай дейді.
Dialogue: 0,0:23:29.98,0:23:30.76,Default,,0000,0000,0000,,Қараңыз.
Dialogue: 0,0:23:32.26,0:23:38.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
