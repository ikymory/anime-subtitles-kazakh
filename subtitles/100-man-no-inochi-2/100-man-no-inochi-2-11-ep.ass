Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.21,0:00:07.92,Default,,0,0,0,,Көз... тиін
Dialogue: 0,0:00:10.59,0:00:11.51,Default,,0,0,0,,Хмм, хмм, хмм, хмм…
Dialogue: 0,0:00:11.59,0:00:12.59,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:12.67,0:00:13.80,Default,,0,0,0,,Уга~!
Dialogue: 0,0:00:13.88,0:00:16.72,Default,,0,0,0,,Ах!Уф...
Dialogue: 0,0:00:16.80,0:00:18.89,Default,,0,0,0,,Сәлем! Бұл өтірік емес пе?
Dialogue: 0,0:00:18.97,0:00:20.27,Default,,0,0,0,,(Ирис айқайлайды)
Dialogue: 0,0:00:20.35,0:00:21.56,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:23.98,0:00:25.06,Default,,0,0,0,,Йоцуя-кун!
Dialogue: 0,0:00:27.36,0:00:30.94,Default,,0,0,0,,Мен бұл туралы бұрын айттым ба? Ол да менің жұмысым
Dialogue: 0,0:00:31.53,0:00:32.99,Default,,0,0,0,,А...
Dialogue: 0,0:00:33.07,0:00:35.24,Default,,0,0,0,,Неге...
Dialogue: 0,0:00:35.32,0:00:36.91,Default,,0,0,0,,Көршілер көріп қалса немесе сынып кетсе, апат болар еді.
Dialogue: 0,0:00:37.57,0:00:38.66,Default,,0,0,0,,Әй, келші, жанымда отыр, Хиросе.
Dialogue: 0,0:00:40.41,0:00:41.87,Default,,0,0,0,,Гау~!
Dialogue: 0,0:00:43.71,0:00:44.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:48.33,0:00:51.25,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:00:53.17,0:00:55.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:55.72,0:00:58.97,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:00:59.55,0:01:01.56,Default,,0,0,0,,♪～
Dialogue: 0,0:02:25.06,0:02:27.06,Default,,0,0,0,,～♪
Dialogue: 0,0:02:32.48,0:02:34.40,Default,,0,0,0,,(Хакозакидің айқайы)
Dialogue: 0,0:02:34.48,0:02:36.40,Default,,0,0,0,,Бұл...
Dialogue: 0,0:02:36.48,0:02:39.78,Default,,0,0,0,,Ол Джезбидің әкесімен бірдей жігіт... иә?
Dialogue: 0,0:02:39.86,0:02:42.74,Default,,0,0,0,,Ах, Хариган құрты.
Dialogue: 0,0:02:43.53,0:02:45.20,Default,,0,0,0,,Мұндай нәрсе...
Dialogue: 0,0:02:45.29,0:02:48.37,Default,,0,0,0,,Айрис әрқашан бізбен бірге болды.
Dialogue: 0,0:02:49.08,0:02:51.79,Default,,0,0,0,,Егер солай болса, сіз қашан жұқтырдыңыз?
Dialogue: 0,0:03:07.97,0:03:10.56,Default,,0,0,0,,Мен Айристің осындай нәрсені басынан өткергеніне сене алмаймын...
Dialogue: 0,0:03:11.27,0:03:13.35,Default,,0,0,0,,Бэйн сол құбыжық па?
Dialogue: 0,0:03:13.44,0:03:14.31,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:14.40,0:03:15.73,Default,,0,0,0,,Жака…
Dialogue: 0,0:03:15.82,0:03:16.65,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:16.73,0:03:17.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:17.32,0:03:18.90,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:03:18.99,0:03:22.82,Default,,0,0,0,,Мұнда келгеннен бері өзімді жақсы сезінбеймін.
Dialogue: 0,0:03:22.91,0:03:24.20,Default,,0,0,0,,Сіз де?
Dialogue: 0,0:03:24.28,0:03:26.24,Default,,0,0,0,,Шындығында, біз де кімбіз?
Dialogue: 0,0:03:26.33,0:03:30.04,Default,,0,0,0,,Хмм... Қызық, бұл нені білдіреді?
Dialogue: 0,0:03:30.12,0:03:31.21,Default,,0,0,0,,Сіздің денеңіз?
Dialogue: 0,0:03:31.71,0:03:32.79,Default,,0,0,0,,Иә
Dialogue: 0,0:03:33.29,0:03:35.67,Default,,0,0,0,,Белгісіз себеппен әр адам өзін баяу сезінеді.
Dialogue: 0,0:03:35.75,0:03:38.30,Default,,0,0,0,,Бізде ештеңе жоқ...
Dialogue: 0,0:03:38.38,0:03:39.55,Default,,0,0,0,,Иә
Dialogue: 0,0:03:39.63,0:03:41.17,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:03:42.30,0:03:44.51,Default,,0,0,0,,Джифон аралындағы белгілермен бірдей.
Dialogue: 0,0:03:44.59,0:03:47.01,Default,,0,0,0,,Сонда айдаһар епископы?
Dialogue: 0,0:03:47.10,0:03:50.02,Default,,0,0,0,,Бұл жерде тағы да салт-дәстүрлерді өткізіп жатыр дейсіз бе?
Dialogue: 0,0:03:55.98,0:03:58.15,Default,,0,0,0,,Амансың ба? Кейта
Dialogue: 0,0:03:58.73,0:03:59.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:01.69,0:04:03.49,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:04:03.57,0:04:05.37,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:04:05.87,0:04:08.12,Default,,0,0,0,,Мен ол қызды сағындым.
Dialogue: 0,0:04:08.20,0:04:11.00,Default,,0,0,0,,Сондықтан маған бәрібір...
Dialogue: 0,0:04:11.66,0:04:13.46,Default,,0,0,0,,Бұл шынымен ақылға сыйымсыз.
Dialogue: 0,0:04:13.54,0:04:14.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:14.12,0:04:17.09,Default,,0,0,0,,Кенет мені осындай жерге жіберді
Dialogue: 0,0:04:17.17,0:04:19.67,Default,,0,0,0,,Ауырсыну және қорқыныш сезімі
Dialogue: 0,0:04:20.17,0:04:22.47,Default,,0,0,0,,Бұл маған және барлығына қатысты.
Dialogue: 0,0:04:23.47,0:04:26.89,Default,,0,0,0,,Ол салқын болуға тырысады, бірақ Йоцуя-кун да шығар.
Dialogue: 0,0:04:27.39,0:04:28.72,Default,,0,0,0,,Бірақ
Dialogue: 0,0:04:29.56,0:04:31.47,Default,,0,0,0,,Сіз соншалықты ақылға сыймайтын нәрседен өлгіңіз келмейді, солай ма?
Dialogue: 0,0:04:32.23,0:04:33.27,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:04:34.73,0:04:36.31,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:04:36.40,0:04:39.23,Default,,0,0,0,,Сондықтан бәріміз соңына дейін аман болайық!
Dialogue: 0,0:04:39.32,0:04:40.36,Default,,0,0,0,,Кейта
Dialogue: 0,0:04:40.44,0:04:42.94,Default,,0,0,0,,Сен маған қамқор болуың керек, інім, солай ма?
Dialogue: 0,0:04:44.45,0:04:45.24,Default,,0,0,0,,О
Dialogue: 0,0:04:46.16,0:04:46.91,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:04:48.49,0:04:52.04,Default,,0,0,0,,Ей, келесіде бәріміз жағаға барайық.
Dialogue: 0,0:04:52.70,0:04:55.33,Default,,0,0,0,,Теңіз... Керемет.
Dialogue: 0,0:04:56.67,0:04:58.33,Default,,0,0,0,,Үйге аман-есен жетемін деп үміттенемін.
Dialogue: 0,0:04:59.34,0:05:00.34,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:03.59,0:05:04.67,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:05:05.93,0:05:08.76,Default,,0,0,0,,Жаңа Едем - күн шығатын жер
Dialogue: 0,0:05:08.85,0:05:11.01,Default,,0,0,0,,Джунглиден өтетін жерде дейді.
Dialogue: 0,0:05:11.10,0:05:12.43,Default,,0,0,0,,Не?
Dialogue: 0,0:05:12.52,0:05:13.77,Default,,0,0,0,,Шығыс?
Dialogue: 0,0:05:14.27,0:05:16.19,Default,,0,0,0,,Мен ол жерде әлі болған жоқпын.
Dialogue: 0,0:05:16.27,0:05:18.48,Default,,0,0,0,,Не істеу керек? Юсуке
Dialogue: 0,0:05:18.98,0:05:22.11,Default,,0,0,0,,Айдаһар епископы араласса ше?
Dialogue: 0,0:05:22.19,0:05:24.40,Default,,0,0,0,,Соқыр қозғалу қауіпті.
Dialogue: 0,0:05:24.49,0:05:25.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:26.32,0:05:29.62,Default,,0,0,0,,Батыр-сама, Джезбидің айтқанына сенбейсің бе?
Dialogue: 0,0:05:29.70,0:05:33.04,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:05:33.12,0:05:35.16,Default,,0,0,0,,Балалық шақтағы естеліктер ғана
Dialogue: 0,0:05:35.25,0:05:36.75,Default,,0,0,0,,Сіз шеше алмайсыз.
Dialogue: 0,0:05:37.37,0:05:38.67,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:38.75,0:05:40.29,Default,,0,0,0,,(Гоблиндердің айқайы)
Dialogue: 0,0:05:40.38,0:05:40.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:41.04,0:05:43.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:43.46,0:05:44.59,Default,,0,0,0,,Құбыжық?
Dialogue: 0,0:05:44.67,0:05:45.42,Default,,0,0,0,,Тек араласып жүрсің...
Dialogue: 0,0:05:45.51,0:05:46.97,Default,,0,0,0,,Сәлем! (Тории) Қарғыс атсын!
Dialogue: 0,0:05:47.93,0:05:48.59,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:49.22,0:05:51.76,Default,,0,0,0,,Дэн мырза, өтінемін, барлығын алып қашыңыз.
Dialogue: 0,0:05:51.85,0:05:52.51,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:05:52.60,0:05:54.85,Default,,0,0,0,,Бенисуэ Юка, балалар!
Dialogue: 0,0:05:54.93,0:05:56.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:56.60,0:05:57.77,Default,,0,0,0,,Ах! Гуаааа
Dialogue: 0,0:05:57.85,0:05:59.10,Default,,0,0,0,,Иә! Гах!
Dialogue: 0,0:05:59.19,0:06:00.86,Default,,0,0,0,,♬~
Dialogue: 0,0:06:00.94,0:06:01.77,Default,,0,0,0,,Гау! (Йоцуя) Арх!
Dialogue: 0,0:06:04.28,0:06:07.36,Default,,0,0,0,,Қат! Өйткені ол күшті
Dialogue: 0,0:06:08.07,0:06:09.49,Default,,0,0,0,,Барлығы осылай!
Dialogue: 0,0:06:10.37,0:06:12.45,Default,,0,0,0,,Гугья~ (Хокозаки) Ха! Мен сенен кейін келемін!
Dialogue: 0,0:06:12.53,0:06:13.74,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:06:13.83,0:06:14.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:14.70,0:06:16.04,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:06:16.12,0:06:17.00,Default,,0,0,0,,Ланан!
Dialogue: 0,0:06:17.08,0:06:18.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:18.71,0:06:19.67,Default,,0,0,0,,Юка-чан!
Dialogue: 0,0:06:19.75,0:06:20.71,Default,,0,0,0,,Иә
Dialogue: 0,0:06:21.50,0:06:22.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:24.21,0:06:25.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:27.42,0:06:28.26,Default,,0,0,0,,Ах…
Dialogue: 0,0:06:28.34,0:06:29.34,Default,,0,0,0,,Гү!
Dialogue: 0,0:06:29.84,0:06:30.93,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:31.01,0:06:32.26,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:06:32.76,0:06:34.10,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:06:34.18,0:06:35.39,Default,,0,0,0,,Ланан!
Dialogue: 0,0:06:35.89,0:06:36.60,Default,,0,0,0,,Ланан!
Dialogue: 0,0:06:38.85,0:06:40.27,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:41.02,0:06:42.52,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:42.61,0:06:43.11,Default,,0,0,0,,Аһ!
Dialogue: 0,0:06:43.69,0:06:44.44,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:45.90,0:06:47.03,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:47.11,0:06:48.11,Default,,0,0,0,,Тағы нешеу?
Dialogue: 0,0:06:48.69,0:06:49.95,Default,,0,0,0,,1 гоблин
Dialogue: 0,0:06:50.53,0:06:51.61,Default,,0,0,0,,3 коболд
Dialogue: 0,0:06:52.24,0:06:53.20,Default,,0,0,0,,Қарғыс атсын! Гуоа
Dialogue: 0,0:06:53.28,0:06:55.28,Default,,0,0,0,,Жоқ, екі.
Dialogue: 0,0:06:55.37,0:06:56.58,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:56.66,0:06:59.62,Default,,0,0,0,,Иу-чан, мен сені бірден жеңемін!
Dialogue: 0,0:06:59.71,0:07:00.92,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:01.00,0:07:01.96,Default,,0,0,0,,Иә! Гуоа
Dialogue: 0,0:07:02.04,0:07:03.00,Default,,0,0,0,,Иә! Жақсы...
Dialogue: 0,0:07:03.08,0:07:04.00,Default,,0,0,0,,Иә! Уф!
Dialogue: 0,0:07:04.09,0:07:05.29,Default,,0,0,0,,Уф…
Dialogue: 0,0:07:05.38,0:07:06.42,Default,,0,0,0,,Хаа…
Dialogue: 0,0:07:06.50,0:07:07.84,Default,,0,0,0,,Жарайсың (Тории) Хэхе
Dialogue: 0,0:07:07.92,0:07:09.59,Default,,0,0,0,,Өйткені менің өлгім келмейді
Dialogue: 0,0:07:09.67,0:07:12.01,Default,,0,0,0,,Барлығына! Сенімен бәрі жақсы ма?
Dialogue: 0,0:07:12.09,0:07:14.22,Default,,0,0,0,,О! Сен де сонда жақсысың ба?
Dialogue: 0,0:07:14.30,0:07:15.18,Default,,0,0,0,,(Ағаштардың қатты дірілдеген дыбысы)
Dialogue: 0,0:07:15.26,0:07:16.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:17.27,0:07:18.47,Default,,0,0,0,,Го~
Dialogue: 0,0:07:18.56,0:07:20.56,Default,,0,0,0,,Қарғыс атсын... (Йоцуя) Тролль?
Dialogue: 0,0:07:20.64,0:07:21.31,Default,,0,0,0,,Уф... (Торий) Уф!
Dialogue: 0,0:07:21.39,0:07:22.15,Default,,0,0,0,,Гуо!
Dialogue: 0,0:07:22.23,0:07:23.23,Default,,0,0,0,,Ию!
Dialogue: 0,0:07:23.31,0:07:25.06,Default,,0,0,0,,Го~
Dialogue: 0,0:07:26.73,0:07:27.94,Default,,0,0,0,,Ю-чан!
Dialogue: 0,0:07:28.03,0:07:28.57,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:28.65,0:07:30.24,Default,,0,0,0,,Конняро!
Dialogue: 0,0:07:30.32,0:07:30.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:31.07,0:07:31.99,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:32.49,0:07:33.82,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:33.91,0:07:35.20,Default,,0,0,0,,Маған Ю-чанды қайтар!
Dialogue: 0,0:07:35.28,0:07:36.62,Default,,0,0,0,,Жоқ, Хакозаки-сан!
Dialogue: 0,0:07:37.41,0:07:38.66,Default,,0,0,0,,Гавк (Хокозаки) Кя~!
Dialogue: 0,0:07:40.00,0:07:41.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:41.83,0:07:43.08,Default,,0,0,0,,Го~
Dialogue: 0,0:07:43.17,0:07:43.67,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:43.75,0:07:44.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:44.96,0:07:45.84,Default,,0,0,0,,Не?
Dialogue: 0,0:07:45.92,0:07:48.92,Default,,0,0,0,,(Тролл ыңырануы)
Dialogue: 0,0:07:49.01,0:07:50.63,Default,,0,0,0,,Бейбақ! Маған қашуға рұқсат етіңіз!
Dialogue: 0,0:07:50.72,0:07:53.26,Default,,0,0,0,,Өзіңді тым алысқа итерме, ақымақ!
Dialogue: 0,0:07:53.80,0:07:55.43,Default,,0,0,0,,Көп уақыт өтті
Dialogue: 0,0:07:55.51,0:07:56.05,Default,,0,0,0,,​​О?
Dialogue: 0,0:07:58.85,0:08:00.27,Default,,0,0,0,,Кантиль мырза!
Dialogue: 0,0:08:05.98,0:08:07.36,Default,,0,0,0,,Бұл кім? Сол адам
Dialogue: 0,0:08:08.73,0:08:10.11,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:08:11.49,0:08:14.24,Default,,0,0,0,,Ескі және әлі де әдемі
Dialogue: 0,0:08:14.32,0:08:15.91,Default,,0,0,0,,Жоқ! Тынышталыңыз
Dialogue: 0,0:08:15.99,0:08:18.24,Default,,0,0,0,,Менің тамаша атрибуттарым...
Dialogue: 0,0:08:18.83,0:08:21.04,Default,,0,0,0,,Жоқ... болуы керек
Dialogue: 0,0:08:21.12,0:08:25.54,Default,,0,0,0,,Ал... 17 жыл болды ғой, солай ма?
Dialogue: 0,0:08:26.08,0:08:28.96,Default,,0,0,0,,Мен сені цунами алып кеткен деп естідім.
Dialogue: 0,0:08:29.05,0:08:30.09,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:30.59,0:08:34.88,Default,,0,0,0,,Осыдан кейін бірден белгілі бір адам менің өмірімді сақтап қалды.
Dialogue: 0,0:08:37.05,0:08:38.05,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:08:38.14,0:08:41.97,Default,,0,0,0,,Ұлы сиқыршы... Фатина ханым?
Dialogue: 0,0:08:43.23,0:08:45.39,Default,,0,0,0,,Фатина-сама ол кезде!
Dialogue: 0,0:08:45.48,0:08:46.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:47.06,0:08:49.15,Default,,0,0,0,,Сіз Фатина ханымды танисыз ба?
Dialogue: 0,0:08:49.77,0:08:50.86,Default,,0,0,0,,дейін
Dialogue: 0,0:08:50.94,0:08:54.07,Default,,0,0,0,,Бізге көмектескен қайырымды адам
Dialogue: 0,0:08:55.45,0:08:59.24,Default,,0,0,0,,Осыдан кейін мен Фатинаның шәкірті болдым.
Dialogue: 0,0:08:59.33,0:09:01.54,Default,,0,0,0,,Мен сиқыршы болуға жаттығамын.
Dialogue: 0,0:09:01.62,0:09:05.71,Default,,0,0,0,,Сонымен, айдаһар епископы өлді ме?
Dialogue: 0,0:09:05.79,0:09:06.83,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:07.33,0:09:08.33,Default,,0,0,0,,Ум...
Dialogue: 0,0:09:08.83,0:09:12.67,Default,,0,0,0,,Сиқыршылар мен айдаһар епископтары дұшпандық таныта ма?
Dialogue: 0,0:09:13.34,0:09:17.93,Default,,0,0,0,,Айдаһар епископы дегеніміз не? Айдаһарларды тірілтуді жоспарлап отырған топ.
Dialogue: 0,0:09:18.76,0:09:22.01,Default,,0,0,0,,Айдаһар қайта тірілсе, адамзат жойылады.
Dialogue: 0,0:09:22.10,0:09:23.22,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:25.69,0:09:26.98,Default,,0,0,0,,(Айдаһардың айқайы)
Dialogue: 0,0:09:27.06,0:09:30.98,Default,,0,0,0,,Біз сол қайта тірілуге ​​жол бермеу үшін бармыз.
Dialogue: 0,0:09:31.52,0:09:32.61,Default,,0,0,0,,Бұл жолы Фатина-сама
Dialogue: 0,0:09:32.69,0:09:36.15,Default,,0,0,0,,Өйткені мен мұнда айдаһар епископының барын сездім.
Dialogue: 0,0:09:36.24,0:09:37.91,Default,,0,0,0,,Мен жіберілдім
Dialogue: 0,0:09:37.99,0:09:40.07,Default,,0,0,0,,Сонымен
Dialogue: 0,0:09:40.16,0:09:42.66,Default,,0,0,0,,Айдаһар епископы осында...
Dialogue: 0,0:09:42.74,0:09:44.54,Default,,0,0,0,,Бірақ мәселе сонда
Dialogue: 0,0:09:44.62,0:09:46.96,Default,,0,0,0,,Бірнеше ай бұрын осы жерде
Dialogue: 0,0:09:47.04,0:09:50.84,Default,,0,0,0,,Күшті сиқырлы күші бар метеорит құлаған сияқты.
Dialogue: 0,0:09:50.92,0:09:52.21,Default,,0,0,0,,Метеорит?
Dialogue: 0,0:09:57.38,0:10:02.26,Default,,0,0,0,,Бір кесек сол тасты таудың арғы жағында жатқан.
Dialogue: 0,0:10:04.39,0:10:08.14,Default,,0,0,0,,Сол метеориттің сиқырлы күш-қуатын арттыратын күші бар сияқты.
Dialogue: 0,0:10:08.23,0:10:11.06,Default,,0,0,0,,Сол себепті құбыжықтар күшейе түсті ме?
Dialogue: 0,0:10:11.73,0:10:13.98,Default,,0,0,0,,Мен метеорит толқындарының соңынан ердім...
Dialogue: 0,0:10:14.07,0:10:15.61,Default,,0,0,0,,Біз сонда болдық, солай ма?
Dialogue: 0,0:10:16.69,0:10:20.03,Default,,0,0,0,,Қан рәсімдері адамдардың өмірлік күшін қажет етеді.
Dialogue: 0,0:10:20.53,0:10:24.87,Default,,0,0,0,,Жолда ауыл қирап, тым кеш деп ойладым.
Dialogue: 0,0:10:25.58,0:10:28.16,Default,,0,0,0,,Мүмкін менің күшім жетпеген шығар...
Dialogue: 0,0:10:28.87,0:10:31.04,Default,,0,0,0,,Салт әлі де жалғасып жатқан сияқты.
Dialogue: 0,0:10:33.92,0:10:35.21,Default,,0,0,0,,Иә? (Йоцуя) Солай ма?
Dialogue: 0,0:10:35.30,0:10:37.67,Default,,0,0,0,,Yggde үйеңкі тұқымдары
Dialogue: 0,0:10:37.76,0:10:39.93,Default,,0,0,0,,Сиқырлы күшті сіңіру арқылы өсу
Dialogue: 0,0:10:40.43,0:10:46.27,Default,,0,0,0,,Егер сіз мұны өсірсеңіз, метеориттің сиқырлы күші осы аймақта толығымен сақталады.
Dialogue: 0,0:10:46.97,0:10:50.77,Default,,0,0,0,,Бұл құбыжықтардың әдеттен тыс күшін де ұстауға болатынын білдіре ме?
Dialogue: 0,0:10:51.56,0:10:54.52,Default,,0,0,0,,Сонымен бірге біздің сиқырлы күшіміз де.
Dialogue: 0,0:10:54.61,0:10:58.53,Default,,0,0,0,,Шындығында, сиқыр үлкен күш емес.
Dialogue: 0,0:10:58.61,0:11:00.11,Default,,0,0,0,,Бұл пайдалы.
Dialogue: 0,0:11:00.65,0:11:03.32,Default,,0,0,0,,Биологиялық сиқырмен барынша өсемін.
Dialogue: 0,0:11:03.41,0:11:06.79,Default,,0,0,0,,Одан гөрі, бұл Ю-чан мен Бенисью-чан!
Dialogue: 0,0:11:06.87,0:11:08.50,Default,,0,0,0,,Оны жеп қойды!
Dialogue: 0,0:11:08.58,0:11:11.50,Default,,0,0,0,,Сіз үрейленбесеңіз де, оған жүрегіңізді ашсаңыз, оны құтқара аласыз.
Dialogue: 0,0:11:11.58,0:11:13.38,Default,,0,0,0,,Мен де орналасқан жерді білемін.
Dialogue: 0,0:11:16.05,0:11:17.92,Default,,0,0,0,,Тезірек жүр, Юсуке.
Dialogue: 0,0:11:18.01,0:11:19.47,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:11:19.55,0:11:21.34,Default,,0,0,0,,Деок патшалығы?
Dialogue: 0,0:11:21.84,0:11:22.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:22.47,0:11:25.35,Default,,0,0,0,,Мен Деок патшалығы екеніне сенімдімін
Dialogue: 0,0:11:26.01,0:11:28.85,Default,,0,0,0,,Бұл төртінші іздеуде айтқан патшалық емес пе?
Dialogue: 0,0:11:30.18,0:11:33.31,Default,,0,0,0,,Бұл қорқынышты оқиға болды.
Dialogue: 0,0:11:33.81,0:11:35.44,Default,,0,0,0,,Сол патша сарайында жасырылған⸺
Dialogue: 0,0:11:35.52,0:11:37.23,Default,,0,0,0,,Айдаһар епископын жеңді
Dialogue: 0,0:11:37.32,0:11:37.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:37.94,0:11:40.61,Default,,0,0,0,,Әй, сен де сол елде болдың ба?
Dialogue: 0,0:11:41.82,0:11:43.74,Default,,0,0,0,,Шамамен 3 жыл бұрын
Dialogue: 0,0:11:44.74,0:11:45.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:45.45,0:11:46.08,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:11:46.16,0:11:47.33,Default,,0,0,0,,Иә
Dialogue: 0,0:11:47.41,0:11:49.54,Default,,0,0,0,,Мен патшаның бұйрығымен келдім.
Dialogue: 0,0:11:49.62,0:11:52.25,Default,,0,0,0,,Бұл министрдің бөлмесі үшін дұрыс орын болды ма?
Dialogue: 0,0:11:52.33,0:11:53.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:53.37,0:11:54.67,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:56.88,0:11:57.59,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:57.67,0:11:59.00,Default,,0,0,0,,Қаш!
Dialogue: 0,0:11:59.09,0:12:01.30,Default,,0,0,0,,Ах! Wyvern?
Dialogue: 0,0:12:01.38,0:12:02.51,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:12:03.01,0:12:03.97,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:12:04.05,0:12:05.89,Default,,0,0,0,,Бұл қазірдің өзінде жем
Dialogue: 0,0:12:06.97,0:12:09.31,Default,,0,0,0,,Қарғыс атсын... Үкі?
Dialogue: 0,0:12:09.39,0:12:12.14,Default,,0,0,0,,Вентуспен Арс
Dialogue: 0,0:12:12.23,0:12:13.64,Default,,0,0,0,,Ән айту аяқталды
Dialogue: 0,0:12:13.73,0:12:15.06,Default,,0,0,0,,Сильфид!
Dialogue: 0,0:12:16.11,0:12:16.73,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:12:16.81,0:12:18.69,Default,,0,0,0,,Алдыңғы әйнек!
Dialogue: 0,0:12:18.77,0:12:20.40,Default,,0,0,0,,Аһ!
Dialogue: 0,0:12:22.11,0:12:24.99,Default,,0,0,0,,Оның патшалықта болған мақсаты қандай?
Dialogue: 0,0:12:25.07,0:12:26.78,Default,,0,0,0,,Соғыс тудырыңыз
Dialogue: 0,0:12:26.87,0:12:31.29,Default,,0,0,0,,Сол оқиға кезінде қаза болған адамдар қанды рәсімде пайдаланылған сияқты.
Dialogue: 0,0:12:32.08,0:12:33.41,Default,,0,0,0,,О~ Бес күн бұрын D-хат келген екен.
Dialogue: 0,0:12:33.50,0:12:35.92,Default,,0,0,0,,Қан рәсімі әлі де жалғасуда.
Dialogue: 0,0:12:36.00,0:12:38.29,Default,,0,0,0,,Загрос ауылы жеткіліксіз болса ше?
Dialogue: 0,0:12:38.38,0:12:40.55,Default,,0,0,0,,Жақын жерде ауыл немесе қала бар...
Dialogue: 0,0:12:40.63,0:12:43.63,Default,,0,0,0,,Жаңа Эдем шынымен бар ма?
Dialogue: 0,0:12:43.72,0:12:46.43,Default,,0,0,0,,Әй, уақыт келді емес пе?
Dialogue: 0,0:12:47.72,0:12:48.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:48.93,0:12:51.89,Default,,0,0,0,,Бұл «Джек пен бұршақ сабағы» сияқты
Dialogue: 0,0:12:52.39,0:12:53.73,Default,,0,0,0,,Хаа…
Dialogue: 0,0:12:53.81,0:12:57.23,Default,,0,0,0,,Ал, мен биологиялық сиқырды барынша қолдандым.
Dialogue: 0,0:12:57.31,0:12:59.52,Default,,0,0,0,,Ей, жемісін беріп жатыр.
Dialogue: 0,0:13:00.02,0:13:01.65,Default,,0,0,0,,Оның жемісі жеуге жарамды.
Dialogue: 0,0:13:01.73,0:13:03.94,Default,,0,0,0,,Ой! Мен оны жей аламын ба?
Dialogue: 0,0:13:04.03,0:13:06.28,Default,,0,0,0,,Мен оны шұғыл тағам ретінде алуым керек пе?
Dialogue: 0,0:13:06.36,0:13:09.20,Default,,0,0,0,,Әзірге азық-түлікпен қамтамасыз ете алдық.
Dialogue: 0,0:13:09.28,0:13:11.95,Default,,0,0,0,,Мен айналаны зерттеймін.
Dialogue: 0,0:13:12.04,0:13:14.00,Default,,0,0,0,,Бір жерде сиқырлы шеңбер болуы керек.
Dialogue: 0,0:13:14.66,0:13:16.71,Default,,0,0,0,,Алдымен біз оны іздеуіміз керек.
Dialogue: 0,0:13:23.51,0:13:26.22,Default,,0,0,0,,Олай болса, Гленн мырза, мен сізден маған еруіңізді сұраймын.
Dialogue: 0,0:13:26.30,0:13:27.09,Default,,0,0,0,,О
Dialogue: 0,0:13:27.64,0:13:29.09,Default,,0,0,0,,Осы екеуін құтқарыңыз.
Dialogue: 0,0:13:29.68,0:13:32.60,Default,,0,0,0,,Гленн мырза, өзіңіз жақсысыз ба?
Dialogue: 0,0:13:32.68,0:13:35.64,Default,,0,0,0,,Осының арқасында құбыжық әлсіреп кетсе
Dialogue: 0,0:13:35.73,0:13:37.19,Default,,0,0,0,,Бұл қалай да болады
Dialogue: 0,0:13:37.27,0:13:39.77,Default,,0,0,0,,Сондай-ақ, мен растағым келетін бір нәрсе бар.
Dialogue: 0,0:13:40.40,0:13:41.44,Default,,0,0,0,,Растау?
Dialogue: 0,0:13:41.52,0:13:44.82,Default,,0,0,0,,Менің ойымша, бұл менің қиялым ғана.
Dialogue: 0,0:13:44.90,0:13:46.32,Default,,0,0,0,,Дәл ойлағанымдай
Dialogue: 0,0:13:46.40,0:13:48.36,Default,,0,0,0,,Мен де аздап көмектесе аламын.
Dialogue: 0,0:13:48.45,0:13:50.95,Default,,0,0,0,,Хехе, аға жігіт
Dialogue: 0,0:13:51.03,0:13:54.16,Default,,0,0,0,,Мен толқып отырмын, өйткені мен Гленда сияқты сұлу әйелмен біргемін.
Dialogue: 0,0:13:54.25,0:13:54.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:55.75,0:13:59.96,Default,,0,0,0,,Уайымдама, мен сені қорғаймын.
Dialogue: 0,0:14:00.67,0:14:01.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:01.29,0:14:03.42,Default,,0,0,0,,Ланан өлсе ше?
Dialogue: 0,0:14:03.92,0:14:06.59,Default,,0,0,0,,Мен өзімді жалғыз сезінемін.
Dialogue: 0,0:14:06.67,0:14:09.47,Default,,0,0,0,,Ланан басынан сәл ғана соқты.
Dialogue: 0,0:14:09.55,0:14:11.22,Default,,0,0,0,,Мен жақында оянамын
Dialogue: 0,0:14:12.30,0:14:13.26,Default,,0,0,0,,Иә
Dialogue: 0,0:14:13.85,0:14:16.48,Default,,0,0,0,,Бірақ, ол соққыдан құтылды.
Dialogue: 0,0:14:16.98,0:14:19.40,Default,,0,0,0,,Оны картадан тексерудің қажеті жоқ.
Dialogue: 0,0:14:19.48,0:14:21.36,Default,,0,0,0,,Бірақ бұл таң қалдырады.
Dialogue: 0,0:14:21.44,0:14:22.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:22.15,0:14:23.86,Default,,0,0,0,,«Екі адамға көмектескеннен гөрі»
Dialogue: 0,0:14:23.94,0:14:27.65,Default,,0,0,0,,«Егер сіз Жаңа Эденді іздеп, квестті жойсаңыз, ешқандай проблема болмайды.»\NМен сіз
Dialogue: 0,0:14:28.15,0:14:29.61,Default,,0,0,0,,сияқты бірдеңе айтасыз деп ойладым.
Dialogue: 0,0:14:29.70,0:14:32.24,Default,,0,0,0,,Құбыжықтар әлі де бар.
Dialogue: 0,0:14:32.32,0:14:34.79,Default,,0,0,0,,Бірдеңе болған жағдайда сізге жауынгерлік күш қажет.
Dialogue: 0,0:14:35.29,0:14:36.70,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:14:42.00,0:14:45.59,Default,,0,0,0,,Тролль джунгли арқылы қашып кетті ме?
Dialogue: 0,0:14:45.67,0:14:48.72,Default,,0,0,0,,Сонымен сыртта осылай көрінді ме?
Dialogue: 0,0:14:48.80,0:14:50.88,Default,,0,0,0,,Ах! Міне болды
Dialogue: 0,0:14:50.97,0:14:53.80,Default,,0,0,0,,Қарғыс атқыр... Сабыр ет!
Dialogue: 0,0:14:53.89,0:14:55.43,Default,,0,0,0,,Қырықпырлы дүрбелең шығарып жатыр.
Dialogue: 0,0:14:55.51,0:14:59.89,Default,,0,0,0,,Ю-чан мен Бенисуэ-чанды қайтарыңыз!
Dialogue: 0,0:14:59.98,0:15:01.52,Default,,0,0,0,,Гуо~!
Dialogue: 0,0:15:01.60,0:15:03.77,Default,,0,0,0,,Қат! Сол ақымақ!
Dialogue: 0,0:15:03.86,0:15:05.57,Default,,0,0,0,,Грулл... Уау!
Dialogue: 0,0:15:05.65,0:15:07.99,Default,,0,0,0,,Қарғыс атсын... Уау!
Dialogue: 0,0:15:08.57,0:15:09.65,Default,,0,0,0,,Жоғалып кетті…
Dialogue: 0,0:15:09.74,0:15:10.53,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:15:10.61,0:15:11.99,Default,,0,0,0,,Ұрсу!
Dialogue: 0,0:15:12.07,0:15:15.16,Default,,0,0,0,,Ол секіреді, қонған сәтте ашылады!
Dialogue: 0,0:15:15.24,0:15:16.33,Default,,0,0,0,,Го~
Dialogue: 0,0:15:17.45,0:15:18.33,Default,,0,0,0,,Ортағасырларда рыцарьларды дайындау үшін салынған
Dialogue: 0,0:15:18.41,0:15:19.58,Default,,0,0,0,,Міне, уақыты!
Dialogue: 0,0:15:21.08,0:15:22.08,Default,,0,0,0,,Аһ!
Dialogue: 0,0:15:22.17,0:15:25.79,Default,,0,0,0,,Асығыңыз! Бұрынғыдан әлдеқайда жылдам емес пе?
Dialogue: 0,0:15:25.88,0:15:28.05,Default,,0,0,0,,Ол одан да күшті болды ма?
Dialogue: 0,0:15:28.13,0:15:30.72,Default,,0,0,0,,Күрделі көрсеткі!
Dialogue: 0,0:15:31.59,0:15:33.14,Default,,0,0,0,,Гуо~! Уф...
Dialogue: 0,0:15:33.22,0:15:34.85,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:15:34.93,0:15:38.18,Default,,0,0,0,,Қараймын, қанша қуат алсаң да, көзің...
Dialogue: 0,0:15:38.68,0:15:40.89,Default,,0,0,0,,Токитат мырза, басқа көз де!
Dialogue: 0,0:15:40.98,0:15:44.56,Default,,0,0,0,,Сәлем! Біздің басты сәтіміз келді!
Dialogue: 0,0:15:44.65,0:15:46.48,Default,,0,0,0,,Гу…
Dialogue: 0,0:15:47.11,0:15:49.28,Default,,0,0,0,,Көздер! Көздер! Сіз соқтыңыз!
Dialogue: 0,0:15:49.36,0:15:50.61,Default,,0,0,0,,Гуо~!
Dialogue: 0,0:15:50.69,0:15:51.70,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:51.78,0:15:52.78,Default,,0,0,0,,Пудья!
Dialogue: 0,0:15:52.86,0:15:54.37,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:15:55.37,0:15:57.24,Default,,0,0,0,,Гуо~!
Dialogue: 0,0:15:57.87,0:15:59.20,Default,,0,0,0,,Бітті...
Dialogue: 0,0:15:59.29,0:16:00.12,Default,,0,0,0,,Гуо~!
Dialogue: 0,0:16:00.20,0:16:01.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:01.33,0:16:02.62,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:16:03.12,0:16:05.04,Default,,0,0,0,,А... а?
Dialogue: 0,0:16:05.88,0:16:08.59,Default,,0,0,0,,Батыл Тори Фуккатсу!
Dialogue: 0,0:16:10.34,0:16:14.05,Default,,0,0,0,,Хаа... бұл жігіт мені екінші рет жеп отыр.
Dialogue: 0,0:16:14.13,0:16:14.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:19.47,0:16:21.93,Default,,0,0,0,,Бұл мүлдем тұйық.
Dialogue: 0,0:16:22.02,0:16:24.31,Default,,0,0,0,,Эй, мынаны қарашы.
Dialogue: 0,0:16:24.40,0:16:26.15,Default,,0,0,0,,Кантиль мырза осылай деді.
Dialogue: 0,0:16:26.23,0:16:27.82,Default,,0,0,0,,Метеориттің денесі?
Dialogue: 0,0:16:28.32,0:16:33.57,Default,,0,0,0,,Менің ойымша, бұл кішкентай бөліктер осы аймаққа шашылған.
Dialogue: 0,0:16:34.28,0:16:37.87,Default,,0,0,0,,Кантиль мырза, есімде.
Dialogue: 0,0:16:37.95,0:16:40.66,Default,,0,0,0,,Ащылықты арттырып, одан да жақсырақ ет!
Dialogue: 0,0:16:40.74,0:16:41.62,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:16:42.20,0:16:43.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:44.67,0:16:46.00,Default,,0,0,0,,Йоцуя-кун?
Dialogue: 0,0:16:47.29,0:16:49.63,Default,,0,0,0,,Мүмкін жоғарыда Жаңа Әдем бар шығар.
Dialogue: 0,0:16:49.71,0:16:51.38,Default,,0,0,0,,Жаңа Едем?
Dialogue: 0,0:16:51.46,0:16:52.05,Default,,0,0,0,,Джесби
Dialogue: 0,0:16:52.13,0:16:54.88,Default,,0,0,0,,Джунглидің арғы жағында деп айтпадың ба?
Dialogue: 0,0:16:54.97,0:16:58.30,Default,,0,0,0,,Сондай-ақ, бұл Загростан шығыс бағыт.
Dialogue: 0,0:16:58.39,0:17:01.56,Default,,0,0,0,,Сіз бұл әңгімеге сендіңіз бе?
Dialogue: 0,0:17:01.64,0:17:04.06,Default,,0,0,0,,Қан рәсіміне қанша адам қажет болса, сонша адам
Dialogue: 0,0:17:04.14,0:17:06.15,Default,,0,0,0,,Ол әлі де жақын жерде болуы керек.
Dialogue: 0,0:17:06.23,0:17:09.31,Default,,0,0,0,,Егер солай болса, менің ойыма осы ғана келеді.
Dialogue: 0,0:17:09.40,0:17:10.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:10.61,0:17:13.28,Default,,0,0,0,,Осы биікке шығу мүмкін бе?
Dialogue: 0,0:17:13.36,0:17:14.74,Default,,0,0,0,,Бұл мүмкін емес ойын.
Dialogue: 0,0:17:14.82,0:17:17.91,Default,,0,0,0,,Сізде солай болды, солай ма?
Dialogue: 0,0:17:17.99,0:17:19.16,Default,,0,0,0,,​​О... не?
Dialogue: 0,0:17:25.75,0:17:26.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:27.04,0:17:28.88,Default,,0,0,0,,Джесби? Ланан?
Dialogue: 0,0:17:33.13,0:17:34.05,Default,,0,0,0,,Ланан!
Dialogue: 0,0:17:36.59,0:17:38.93,Default,,0,0,0,,Сіз... байқадыңыз!
Dialogue: 0,0:17:39.43,0:17:41.39,Default,,0,0,0,,Мұндай жерде жалғыз қалу қауіпті.
Dialogue: 0,0:17:42.60,0:17:43.68,Default,,0,0,0,,Отар?
Dialogue: 0,0:17:43.77,0:17:46.19,Default,,0,0,0,,А... сөйлей алмайсың!
Dialogue: 0,0:17:47.56,0:17:48.94,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:17:49.61,0:17:52.61,Default,,0,0,0,,Мм... есіңде ештеңе жоқ па?
Dialogue: 0,0:17:52.69,0:17:54.94,Default,,0,0,0,,Менің анам қайтыс болды.
Dialogue: 0,0:17:55.03,0:17:57.61,Default,,0,0,0,,Сонымен... Сонымен...
Dialogue: 0,0:17:57.70,0:17:58.95,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:17:59.03,0:18:00.53,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:18:00.62,0:18:02.95,Default,,0,0,0,,Жарайды... жарайды.
Dialogue: 0,0:18:03.04,0:18:03.74,Default,,0,0,0,,Не?
Dialogue: 0,0:18:04.50,0:18:06.91,Default,,0,0,0,,Әйтеуір, Джесбиге барайық.
Dialogue: 0,0:18:07.00,0:18:08.21,Default,,0,0,0,,Мен сенің бақытты болатыныңа сенімдімін.
Dialogue: 0,0:18:09.71,0:18:11.38,Default,,0,0,0,,Джесби?
Dialogue: 0,0:18:15.30,0:18:16.51,Default,,0,0,0,,Токитате мырза
Dialogue: 0,0:18:16.59,0:18:20.14,Default,,0,0,0,,Есіңізде ме, мен «Джек пен бұршақ сабағы» дегенім бар ма?
Dialogue: 0,0:18:20.22,0:18:24.06,Default,,0,0,0,,Мен мұны айттым, бірақ өмірде солай істеймін деп ойламаппын...
Dialogue: 0,0:18:24.14,0:18:27.18,Default,,0,0,0,,Бірақ мен оның соншалықты тез өсетініне сене алмаймын...
Dialogue: 0,0:18:27.27,0:18:30.10,Default,,0,0,0,,Мұның бәрі сол үлкен метеориттің арқасында.
Dialogue: 0,0:18:30.60,0:18:33.57,Default,,0,0,0,,Сиқырлы күштің артуы бұрынғымен салыстыруға келмейді.
Dialogue: 0,0:18:33.65,0:18:36.24,Default,,0,0,0,,Төтенше тағам үшін рахмет!
Dialogue: 0,0:18:36.32,0:18:38.24,Default,,0,0,0,,Мен толқу үстіндемін!
Dialogue: 0,0:18:43.91,0:18:45.37,Default,,0,0,0,,Әлі емес пе?
Dialogue: 0,0:18:45.45,0:18:47.04,Default,,0,0,0,,Кішкене ғана
Dialogue: 0,0:18:47.12,0:18:50.25,Default,,0,0,0,,Алдыңғы мәлімдемені қайтару Бұл өте қатал.
Dialogue: 0,0:18:57.67,0:18:59.59,Default,,0,0,0,,Тіпті Ұлы науқан кезінде, Лугника патшалығы экспедициялық корпус ұйымдастырған кезде—
Dialogue: 0,0:18:59.68,0:19:01.30,Default,,0,0,0,,Қарғыс атсын... пайдасы жоқ.
Dialogue: 0,0:19:01.39,0:19:03.76,Default,,0,0,0,,Менің біраз үмітім бар еді.
Dialogue: 0,0:19:03.85,0:19:05.56,Default,,0,0,0,,Үйге тез қайт
Dialogue: 0,0:19:06.35,0:19:07.98,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:08.52,0:19:10.19,Default,,0,0,0,,Бұлай болмауы керек...
Dialogue: 0,0:19:10.27,0:19:12.60,Default,,0,0,0,,Йоцуя-кун, кеттік.
Dialogue: 0,0:19:15.36,0:19:19.95,Default,,0,0,0,,Осындай жерге құлап қалсаңыз, оны тірідей қайтара алмайтын шығарсыз.
Dialogue: 0,0:19:20.03,0:19:21.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:23.57,0:19:24.70,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:19:25.20,0:19:27.41,Default,,0,0,0,,Сәлем Юсуке
Dialogue: 0,0:19:27.91,0:19:28.91,Default,,0,0,0,,Не істеп жүрсің?
Dialogue: 0,0:19:29.58,0:19:30.71,Default,,0,0,0,,Секіруге тырысыңыз
Dialogue: 0,0:19:30.79,0:19:31.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:31.50,0:19:33.13,Default,,0,0,0,,Таңбаша?
Dialogue: 0,0:19:33.21,0:19:37.71,Default,,0,0,0,,Жоқ, жоқ, егер сіз сарқырамаға немесе басқа нәрсеге құласаңыз, өмірге қайта орала алмайсыз!
Dialogue: 0,0:19:37.80,0:19:39.34,Default,,0,0,0,,Менің төмен түскім келмейді
Dialogue: 0,0:19:39.42,0:19:40.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:40.09,0:19:41.76,Default,,0,0,0,,Тағы да рахмет!
Dialogue: 0,0:19:42.76,0:19:44.55,Default,,0,0,0,,Эх!
Dialogue: 0,0:19:44.64,0:19:45.47,Default,,0,0,0,,(суға секіру дыбысы)
Dialogue: 0,0:19:47.97,0:19:51.06,Default,,0,0,0,,Ябе, бұл мен күткеннен де тереңірек.
Dialogue: 0,0:19:51.69,0:19:53.60,Default,,0,0,0,,Бәлкім, әлі ерте шығар
Dialogue: 0,0:19:53.69,0:19:56.32,Default,,0,0,0,,Иә? Толқын өзгерді ме?
Dialogue: 0,0:20:02.49,0:20:05.37,Default,,0,0,0,,Пуха! Ха ха ха...
Dialogue: 0,0:20:05.45,0:20:06.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:17.84,0:20:18.59,Default,,0,0,0,,Ах
Dialogue: 0,0:20:19.59,0:20:21.01,Default,,0,0,0,,Ал сендер ше?
Dialogue: 0,0:20:21.09,0:20:23.84,Default,,0,0,0,,Мұнда адамдардың келмегеніне көп болды.
Dialogue: 0,0:20:23.93,0:20:27.89,Default,,0,0,0,,Сіз таң қалдыңыз ба? Мен мұндай жерде қала бар екеніне сене алар емеспін
Dialogue: 0,0:20:29.10,0:20:30.39,Default,,0,0,0,,Иә, жақсы...
Dialogue: 0,0:20:30.89,0:20:33.60,Default,,0,0,0,,Мұнда қанша адам тұрады?
Dialogue: 0,0:20:33.69,0:20:35.69,Default,,0,0,0,,320…
Dialogue: 0,0:20:35.77,0:20:41.07,Default,,0,0,0,,Әй, күні кеше дүниеге сәби келді, яғни қазір 321 адам.
Dialogue: 0,0:20:41.15,0:20:42.78,Default,,0,0,0,,Өте көп!
Dialogue: 0,0:20:42.86,0:20:45.36,Default,,0,0,0,,Барлығыңыз осында мәңгі өмір сүрдіңіздер ме?
Dialogue: 0,0:20:45.45,0:20:51.04,Default,,0,0,0,,Иә, ұрпағымыз тату-тәтті өмір сүріп келеміз.
Dialogue: 0,0:20:51.66,0:20:55.04,Default,,0,0,0,,Бұрын сыртқы әлеммен байланысқан болса керек.
Dialogue: 0,0:20:55.12,0:20:59.25,Default,,0,0,0,,Әй, бірақ мен сырттан қыдырып келген адаммын.
Dialogue: 0,0:20:59.34,0:21:00.25,Default,,0,0,0,,адасып қалдыңыз ба?
Dialogue: 0,0:21:00.34,0:21:00.96,Default,,0,0,0,,Иә
Dialogue: 0,0:21:01.05,0:21:04.42,Default,,0,0,0,,Мен Загрос деген шағын ауылда тұратынмын.
Dialogue: 0,0:21:04.51,0:21:05.68,Default,,0,0,0,,Загрос?
Dialogue: 0,0:21:06.18,0:21:10.47,Default,,0,0,0,,Сонымен... бұл Жаңа Эдем ме?
Dialogue: 0,0:21:10.56,0:21:11.43,Default,,0,0,0,,Жоқ (Йоцуя) А?
Dialogue: 0,0:21:11.52,0:21:12.72,Default,,0,0,0,,Аты жоқ т.б.
Dialogue: 0,0:21:12.81,0:21:13.73,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:21:14.23,0:21:17.15,Default,,0,0,0,,Сыртқы әлеммен байланысы жоқ қалада
Dialogue: 0,0:21:17.23,0:21:19.65,Default,,0,0,0,,Сізге ат қажет емес, солай ма?
Dialogue: 0,0:21:20.65,0:21:22.15,Default,,0,0,0,,Мен бұл адамды танымаймын!
Dialogue: 0,0:21:22.23,0:21:23.49,Default,,0,0,0,,Ланан…
Dialogue: 0,0:21:24.07,0:21:25.65,Default,,0,0,0,,Неге сен Окуцу музыка колледжінің жанындағы орта мектепке өтініш бердің?—
Dialogue: 0,0:21:25.74,0:21:28.03,Default,,0,0,0,,Әпкеңді есіңе түсіре алмайсың ба?
Dialogue: 0,0:21:28.53,0:21:30.49,Default,,0,0,0,,Менің үлкен әпкем жоқ!
Dialogue: 0,0:21:30.58,0:21:31.95,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:32.45,0:21:34.96,Default,,0,0,0,,Маған қарашы, Ланан.
Dialogue: 0,0:21:36.29,0:21:38.04,Default,,0,0,0,,Бұл сенсің ғой, солай ма?
Dialogue: 0,0:21:38.88,0:21:39.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:39.50,0:21:42.71,Default,,0,0,0,,Осы балаға ұқсауға бола ма?
Dialogue: 0,0:21:44.13,0:21:45.92,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:21:46.01,0:21:47.47,Default,,0,0,0,,Джесби
Dialogue: 0,0:21:48.68,0:21:50.89,Default,,0,0,0,,Сіз Айдаһар епископысыз
Dialogue: 0,0:21:56.48,0:21:58.48,Default,,0,0,0,,♪～
Dialogue: 0,0:23:23.90,0:23:25.90,Default,,0,0,0,,～♪
Dialogue: 0,0:23:25.98,0:23:27.36,Default,,0,0,0,,Келесі аптадағы «Кенді 100» не болады?
Dialogue: 0,0:23:28.32,0:23:29.99,Default,,0,0,0,,«Хакозаки рэпер болады»
Dialogue: 0,0:23:30.07,0:23:31.49,Default,,0,0,0,,«Синдо дірілдейді»
Dialogue: 0,0:23:31.57,0:23:34.62,Default,,0,0,0,,Үш кітап бар: ``Yotsuya, Ura-Harajuku-да жоғалдым''.
Dialogue: 0,0:23:34.70,0:23:36.41,Default,,0,0,0,,Келесі аптада қайта тексеріңіз.
Dialogue: 0,0:23:37.29,0:23:38.91,Default,,0,0,0,,Тас, қағаз, қайшы!
Dialogue: 0,0:23:39.00,0:23:40.37,Default,,0,0,0,,Олай болса~!
