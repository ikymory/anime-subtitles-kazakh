Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.29,0:00:02.21,Default,,0,0,0,,(цикада дыбысы)
Dialogue: 0,0:00:02.29,0:00:03.79,Default,,0,0,0,,(Комано) Бүгін де ыстық сияқты.
Dialogue: 0,0:00:03.87,0:00:06.38,Default,,0,0,0,,(Нишида) Кана-чан маған хакама киюдің қажеті жоқ екенін айтты.
Dialogue: 0,0:00:06.46,0:00:07.80,Default,,0,0,0,,Мен құтқарылдым.
Dialogue: 0,0:00:07.88,0:00:10.09,Default,,0,0,0,,(Комано) Шынымен, мен оны кисем өлетін едім.
Dialogue: 0,0:00:10.17,0:00:13.30,Default,,0,0,0,,(Чихая) Хмм... (Тайчи) Жақсысың ба? Чихая
Dialogue: 0,0:00:13.38,0:00:14.93,Default,,0,0,0,,(Чихая) Иә, бәрібір.
Dialogue: 0,0:00:16.51,0:00:17.60,Default,,0,0,0,,Хмммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:00:18.81,0:00:20.60,Default,,0,0,0,,(Мияучи) Енді кеттік.
Dialogue: 0,0:00:20.68,0:00:22.60,Default,,0,0,0,,(Мияучи) Сіз ештеңені ұмытқан жоқсыз.
Dialogue: 0,0:00:22.69,0:00:24.19,Default,,0,0,0,,(Чихая және т.б.) Иә.
Dialogue: 0,0:00:24.69,0:00:26.52,Default,,0,0,0,,(Мияучи) Жарайды, барлығына.
Dialogue: 0,0:00:26.61,0:00:29.48,Default,,0,0,0,,Командалық жарыстардан айырмашылығы, жеке жарыстарда іріктеу кезеңдері болмайды.
Dialogue: 0,0:00:29.57,0:00:32.19,Default,,0,0,0,,400-ден астам қатысушы
Dialogue: 0,0:00:32.28,0:00:36.41,Default,,0,0,0,,Аясе-сан - А класы Машима-кун және Нишида-кун - В класы
Dialogue: 0,0:00:36.49,0:00:38.62,Default,,0,0,0,,Комано мырза мен Оэ мырза D класына жатады.
Dialogue: 0,0:00:38.70,0:00:41.62,Default,,0,0,0,,Әркім әртүрлі жерлерде жарысады.
Dialogue: 0,0:00:41.70,0:00:45.58,Default,,0,0,0,,Еліміздің түкпір-түкпірінен келген қарсыластарға қарсы күшіңізді сынаңыз.
Dialogue: 0,0:00:45.67,0:00:46.88,Default,,0,0,0,,(Чихая және басқалар) Иә!
Dialogue: 0,0:00:46.96,0:00:48.63,Default,,0,0,0,,(ойын) Бүгін сен жаусың, мырза.
Dialogue: 0,0:00:48.71,0:00:50.84,Default,,0,0,0,,(Комано) Мен жеңілмеймін, ешқашан.
Dialogue: 0,0:00:50.92,0:00:53.55,Default,,0,0,0,,Мен де В сыныбының біріншілігін мақсат етіп отырмын.
Dialogue: 0,0:00:53.63,0:00:54.88,Default,,0,0,0,,(Тайчи) Ах аа
Dialogue: 0,0:00:54.97,0:00:58.80,Default,,0,0,0,,Бұл не? Машима, сен қызғанбайсың.
Dialogue: 0,0:00:58.89,0:01:01.10,Default,,0,0,0,,(Тайчи) Нишида (Нишида) А?
Dialogue: 0,0:01:01.18,0:01:02.14,Default,,0,0,0,,(Тайчи) В сыныбы?
Dialogue: 0,0:01:03.48,0:01:05.69,Default,,0,0,0,,Мен тек В сыныбын болжай аламын.
Dialogue: 0,0:01:05.77,0:01:06.90,Default,,0,0,0,,(Нишида) Әрине.
Dialogue: 0,0:01:11.98,0:01:16.99,Default,,0,0,0,,♪~
Dialogue: 0,0:02:16.67,0:02:21.89,Default,,0,0,0,,～♪
Dialogue: 0,0:02:21.97,0:02:27.98,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:02:32.48,0:02:34.44,Default,,0,0,0,,(Қызметкерлер) Сәйкестік картасын тексергеннен кейін
Dialogue: 0,0:02:34.53,0:02:36.65,Default,,0,0,0,,Орыныңыздың нөмірін алыңыз.
Dialogue: 0,0:02:39.28,0:02:40.70,Default,,0,0,0,,Ал...
Dialogue: 0,0:02:41.99,0:02:43.53,Default,,0,0,0,,(Чихая) А, міне, болды.
Dialogue: 0,0:02:44.29,0:02:46.79,Default,,0,0,0,,Менің қарсыласым Кагосимадан келген Ханамото мырза.
Dialogue: 0,0:02:47.50,0:02:48.83,Default,,0,0,0,,Ол қандай бала?
Dialogue: 0,0:02:48.91,0:02:50.50,Default,,0,0,0,,(Судо) Аясе
Dialogue: 0,0:02:50.58,0:02:51.92,Default,,0,0,0,,Уау, Судо мырза!
Dialogue: 0,0:02:52.00,0:02:53.79,Default,,0,0,0,,(Судо) Патшайым шықты.
Dialogue: 0,0:02:53.88,0:02:54.75,Default,,0,0,0,,(Чихая) Иә?
Dialogue: 0,0:02:54.84,0:02:56.05,Default,,0,0,0,,(Судо) Қараңызшы.
Dialogue: 0,0:02:56.13,0:02:58.67,Default,,0,0,0,,Бірінші айналымда біздің Амакасу жеңді
Dialogue: 0,0:03:00.30,0:03:01.43,Default,,0,0,0,,(Чихая) Вакамия…
Dialogue: 0,0:03:01.51,0:03:05.18,Default,,0,0,0,,Шинобу Вакамия 4-сыныпта және қазірдің өзінде А сыныбында оқиды⸺
Dialogue: 0,0:03:07.27,0:03:09.69,Default,,0,0,0,,Киото қаласындағы 1 курс студенті
Dialogue: 0,0:03:11.77,0:03:13.77,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,0:03:14.86,0:03:17.78,Default,,0,0,0,,(Судо) Ол тарихтағы ең жас патшайым.
Dialogue: 0,0:03:17.86,0:03:19.53,Default,,0,0,0,,(Чихая) Ой, анау қыз ғой.
Dialogue: 0,0:03:20.86,0:03:22.87,Default,,0,0,0,,Біз кеше Оми храмында бір-бірімізден өттік.
Dialogue: 0,0:03:26.41,0:03:27.95,Default,,0,0,0,,(Ер оқушы) Бүгін де, өтінемін.
Dialogue: 0,0:03:28.04,0:03:29.29,Default,,0,0,0,,(Оқушы қыз) Ішіндегі футболка
Dialogue: 0,0:03:29.37,0:03:30.58,Default,,0,0,0,,(Әйел студент) Күткендей
Dialogue: 0,0:03:30.66,0:03:32.04,Default,,0,0,0,,(Оқушы қыз) Неліктен қардарума?
Dialogue: 0,0:03:32.12,0:03:34.59,Default,,0,0,0,,(Оқушы ұл) Сүйкімді болса да, көңілін қалдырмайды.
Dialogue: 0,0:03:40.30,0:03:43.18,Default,,0,0,0,,(Шинобу) Ой, Судо мырза, келдің бе?
Dialogue: 0,0:03:43.26,0:03:44.85,Default,,0,0,0,,Сәлем ханшайым
Dialogue: 0,0:03:44.93,0:03:47.72,Default,,0,0,0,,Тоқташы, патшайым.
Dialogue: 0,0:03:47.81,0:03:50.14,Default,,0,0,0,,Қызық, мен бірінші раундта Судо мырзаны жеңдім бе?
Dialogue: 0,0:03:50.23,0:03:52.56,Default,,0,0,0,,Мен жеңілдеп қалдым, бірақ...
Dialogue: 0,0:03:53.40,0:03:58.07,Default,,0,0,0,,Командалық жарысқа қатысудан қалып қалсам да, жеке жарысқа қатыса алдым.
Dialogue: 0,0:03:58.15,0:04:00.24,Default,,0,0,0,,Сізге карутаны қатты ұнатасыз, солай ма?
Dialogue: 0,0:04:00.95,0:04:05.28,Default,,0,0,0,,Хона Ойында жеңсең, жұмсақ бол.
Dialogue: 0,0:04:09.29,0:04:10.25,Default,,0,0,0,,(Судо) Өлтіру
Dialogue: 0,0:04:10.33,0:04:11.54,Default,,0,0,0,,Иә!?
Dialogue: 0,0:04:11.62,0:04:14.17,Default,,0,0,0,,Мені жиіркеніш сіңіп кеткен
Dialogue: 0,0:04:14.25,0:04:15.75,Default,,0,0,0,,Мен де сені құртамын
Dialogue: 0,0:04:15.83,0:04:18.25,Default,,0,0,0,,(Чихая) Уф (Судо) Мен алдын ала раундтағы қарызымды қайтарамын!
Dialogue: 0,0:04:22.72,0:04:24.01,Default,,0,0,0,,(Чихая) патшайым
Dialogue: 0,0:04:24.55,0:04:27.81,Default,,0,0,0,,Жапониядағы ең жақсы карута әйел ойыншысы
Dialogue: 0,0:04:29.60,0:04:31.43,Default,,0,0,0,,Менің мақсаттарым
Dialogue: 0,0:04:33.73,0:04:38.02,Default,,0,0,0,,Қандай карута ойнайсың? Ол қаншалықты күшті болады?
Dialogue: 0,0:04:38.98,0:04:41.28,Default,,0,0,0,,Алдын ала рахмет (Оқушылар) Алдын ала рахмет.
Dialogue: 0,0:04:41.36,0:04:43.36,Default,,0,0,0,,(Амакасу / Шинобу) Сізге көп рахмет.
Dialogue: 0,0:04:44.74,0:04:48.12,Default,,0,0,0,,(Чихая) Мен тез жеңіп, Королеваның матчын көргім келеді.
Dialogue: 0,0:04:49.08,0:04:54.83,Default,,0,0,0,,(литр) Сакуяко но Хана
Dialogue: 0,0:04:56.13,0:04:58.29,Default,,0,0,0,,Такино дегеніміз не...
Dialogue: 0,0:04:58.38,0:04:59.21,Default,,0,0,0,,(Чихая) Жарайды!
Dialogue: 0,0:05:00.34,0:05:01.76,Default,,0,0,0,,(Чантер) Койсучу... (Чихая) Иә?
Dialogue: 0,0:05:02.92,0:05:04.09,Default,,0,0,0,,(Чантер) Ашибикино... (Чихая) Ах.
Dialogue: 0,0:05:04.17,0:05:05.34,Default,,0,0,0,,(Ханамото) Ху (Чихая) Ха
Dialogue: 0,0:05:05.43,0:05:06.59,Default,,0,0,0,,(Ханамото) Иә! (Чихая) Ха!
Dialogue: 0,0:05:10.31,0:05:12.52,Default,,0,0,0,,(Чихая) Тез жеңіске жету аңғалдық.
Dialogue: 0,0:05:12.60,0:05:14.89,Default,,0,0,0,,Мұндағылардың барлығы А сыныбының балалары.
Dialogue: 0,0:05:17.06,0:05:18.69,Default,,0,0,0,,(Шинобу) Саған көп рахмет.
Dialogue: 0,0:05:18.77,0:05:21.15,Default,,0,0,0,,(Амакасу) Рахмет (Чихая) Ха
Dialogue: 0,0:05:22.82,0:05:23.90,Default,,0,0,0,,(Чихая) Бәрі бітті ме?
Dialogue: 0,0:05:25.45,0:05:27.28,Default,,0,0,0,,Жоқ, концентрат.
Dialogue: 0,0:05:28.16,0:05:32.95,Default,,0,0,0,,Мұқият есте сақтаңыз, бір уақытта әрбір картаны тексеріп, назарыңызды аударыңыз.
Dialogue: 0,0:05:34.16,0:05:36.67,Default,,0,0,0,,(Әнші) Нацунёо...
Dialogue: 0,0:05:39.92,0:05:42.76,Default,,0,0,0,,24 картаның Китаоның Амакасудан айырмашылығы бар ма?
Dialogue: 0,0:05:43.46,0:05:46.51,Default,,0,0,0,,(Ер студент) Бұл сізде бір ғана карта бар дегенді білдіре ме?
Dialogue: 0,0:05:46.59,0:05:49.43,Default,,0,0,0,,(Оқушы қыз) Күшті, патшайым күткендей
Dialogue: 0,0:05:50.35,0:05:52.31,Default,,0,0,0,,(Ер оқушы) Менің су құйғышым
Dialogue: 0,0:05:52.39,0:05:53.64,Default,,0,0,0,,(Ер оқушы) Күн ыстық.
Dialogue: 0,0:05:58.60,0:06:01.90,Default,,0,0,0,,(Қызметкерлер) Енді екінші айналымның жұптарын құрайық.
Dialogue: 0,0:06:01.98,0:06:02.82,Default,,0,0,0,,(Чихая) Ханшайымға...
Dialogue: 0,0:06:04.36,0:06:05.32,Default,,0,0,0,,Мен жеңгім келеді
Dialogue: 0,0:06:06.78,0:06:08.45,Default,,0,0,0,,Мен ұрғым келмейді
Dialogue: 0,0:06:09.24,0:06:11.08,Default,,0,0,0,,(Судо) Мен сені жеңемін.
Dialogue: 0,0:06:11.16,0:06:12.74,Default,,0,0,0,,(Ер оқушы) Маған патшайым ұнамайды.
Dialogue: 0,0:06:12.83,0:06:14.75,Default,,0,0,0,,(Оқушы қыз) Абсолютті жиіркенішті қорқынышты
Dialogue: 0,0:06:14.83,0:06:15.91,Default,,0,0,0,,(Ер оқушы) Маған ұнамайды.
Dialogue: 0,0:06:19.08,0:06:19.92,Default,,0,0,0,,(Чихая) Мен жеңгім келеді
Dialogue: 0,0:06:22.96,0:06:24.92,Default,,0,0,0,,Мен ұрғым келмейді
Dialogue: 0,0:06:27.72,0:06:29.18,Default,,0,0,0,,Мен жеңгім келеді
Dialogue: 0,0:06:40.52,0:06:42.48,Default,,0,0,0,,(Мияучи) Ах, Аясе-сан.
Dialogue: 0,0:06:43.65,0:06:46.69,Default,,0,0,0,,Мен Оэ-санның анасынан бейнеролик алдым.
Dialogue: 0,0:06:46.78,0:06:49.66,Default,,0,0,0,,Бүгін бәрінің ойыны... Ах.
Dialogue: 0,0:06:51.91,0:06:52.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:55.29,0:06:57.04,Default,,0,0,0,,(Қызметкерлер) Есте сақтау уақыты аяқталды.
Dialogue: 0,0:06:57.83,0:06:59.54,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:07:00.29,0:07:02.54,Default,,0,0,0,,(Чихая) Алдын ала рахмет. (Оқушылар) Алдын ала рахмет.
Dialogue: 0,0:07:02.63,0:07:04.80,Default,,0,0,0,,(Чихая және т.б.) Рахмет.
Dialogue: 0,0:07:07.05,0:07:08.80,Default,,0,0,0,,(Әнші) Нанивадуни~
Dialogue: 0,0:07:08.88,0:07:09.55,Default,,0,0,0,,Сакуяко но Хана~
Dialogue: 0,0:07:09.55,0:07:11.14,Default,,0,0,0,,Сакуяко но Хана~
Dialogue: 0,0:07:09.55,0:07:11.14,Default,,0,0,0,,(Чихая) Менің орным жақын, дәл оқырманның алдында.
Dialogue: 0,0:07:11.14,0:07:11.22,Default,,0,0,0,,(Чихая) Менің орным жақын, дәл оқырманның алдында.
Dialogue: 0,0:07:11.22,0:07:14.05,Default,,0,0,0,,(Чихая) Менің орным жақын, дәл оқырманның алдында.
Dialogue: 0,0:07:11.22,0:07:14.05,Default,,0,0,0,,Фуюгоморри~
Dialogue: 0,0:07:14.14,0:07:15.35,Default,,0,0,0,,Сорған дыбыс
Dialogue: 0,0:07:15.43,0:07:22.27,Default,,0,0,0,,Қазір ~ Харубе ~ Сакуяко ~ Хана ~
Dialogue: 0,0:07:24.15,0:07:25.19,Default,,0,0,0,,(Чихая) Құсу дыбысы
Dialogue: 0,0:07:25.27,0:07:27.78,Default,,0,0,0,,(Әнші) Қазір ~Харубето~
Dialogue: 0,0:07:27.86,0:07:29.65,Default,,0,0,0,,Сакуяко но Хана
Dialogue: 0,0:07:29.65,0:07:32.07,Default,,0,0,0,,Сакуяко но Хана
Dialogue: 0,0:07:29.65,0:07:32.07,Default,,0,0,0,,Бірінші дыбысты тыңдау
Dialogue: 0,0:07:34.16,0:07:35.49,Default,,0,0,0,,(Әнші) Хо...
Dialogue: 0,0:07:35.58,0:07:36.99,Default,,0,0,0,,(Чихая) Ха
Dialogue: 0,0:07:38.20,0:07:40.37,Default,,0,0,0,,(Әнші)...Тотоғысу~ (Шекшоттарды алып жатқан дыбыс)
Dialogue: 0,0:07:40.46,0:07:43.21,Default,,0,0,0,,Не? ток
Dialogue: 0,0:07:45.34,0:07:47.63,Default,,0,0,0,,Баяу қозғалыста ойнағанда да оны көре алмайсыз ба?
Dialogue: 0,0:07:47.71,0:07:51.34,Default,,0,0,0,,Цукизоно Кореру~
Dialogue: 0,0:07:53.84,0:07:54.97,Default,,0,0,0,,Микано…
Dialogue: 0,0:07:56.51,0:07:58.18,Default,,0,0,0,,(Чихая) Дыбыс жоқ.
Dialogue: 0,0:07:58.27,0:08:00.39,Default,,0,0,0,,(Әнші)...Хара~ (Шоттарды алып жатқан дыбыс)
Dialogue: 0,0:08:00.98,0:08:02.48,Default,,0,0,0,,Асаджи…
Dialogue: 0,0:08:02.56,0:08:04.94,Default,,0,0,0,,(Чихая) Вакуумда ұшқан ине сияқты
Dialogue: 0,0:08:06.57,0:08:07.94,Default,,0,0,0,,Үнсіз Карута
Dialogue: 0,0:08:10.86,0:08:13.49,Default,,0,0,0,,(Офицер) В сыныбының екінші туры.
Dialogue: 0,0:08:13.57,0:08:15.62,Default,,0,0,0,,Комбинацияға қараңыз және нөмірленген орынға отырыңыз.
Dialogue: 0,0:08:15.62,0:08:17.08,Default,,0,0,0,,Комбинацияға қараңыз және нөмірленген орынға отырыңыз.
Dialogue: 0,0:08:15.62,0:08:17.08,Default,,0,0,0,,А, мен әдепкі бойынша жеңдім.
Dialogue: 0,0:08:17.08,0:08:18.08,Default,,0,0,0,,А, мен әдепкі бойынша жеңдім.
Dialogue: 0,0:08:18.16,0:08:19.62,Default,,0,0,0,,Зури Машима
Dialogue: 0,0:08:19.70,0:08:22.41,Default,,0,0,0,,Сіз D класындағы Кана-чанға қолдау көрсетуді жоспарлап отырсыз ғой, солай ма?
Dialogue: 0,0:08:22.50,0:08:24.79,Default,,0,0,0,,Неліктен Оэ-сан болуды шешті?
Dialogue: 0,0:08:24.88,0:08:26.92,Default,,0,0,0,,Егер Кана Чан матчты бірінші аяқтаса,
Dialogue: 0,0:08:27.00,0:08:28.92,Default,,0,0,0,,Маған қолдау көрсетулеріңізді сұраймын.
Dialogue: 0,0:08:29.55,0:08:33.01,Default,,0,0,0,,Сондықтан егер сіз D сыныбын көретін болсаңыз, мен сізге бар күшіңізді салуыңызды айтамын, Кана-чан...
Dialogue: 0,0:08:33.09,0:08:34.68,Default,,0,0,0,,(Аяқ) (Нишида) Иә?
Dialogue: 0,0:08:34.76,0:08:36.05,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:36.14,0:08:40.06,Default,,0,0,0,,(Тайчидің ауыр тыныс алуы)
Dialogue: 0,0:08:41.81,0:08:42.81,Default,,0,0,0,,(Тайчи) Мм...
Dialogue: 0,0:08:45.65,0:08:48.07,Default,,0,0,0,,Вакамия... Шинобу?
Dialogue: 0,0:08:48.15,0:08:49.57,Default,,0,0,0,,Га
Dialogue: 0,0:08:49.65,0:08:53.32,Default,,0,0,0,,Чихая патшайыммен соғысып жатыр
Dialogue: 0,0:08:56.82,0:08:59.91,Default,,0,0,0,,(Мияучи) Жылдамдығы сонша, мен не болып жатқанын білмеймін.
Dialogue: 0,0:08:59.99,0:09:01.91,Default,,0,0,0,,Бірақ мен де түсінемін.
Dialogue: 0,0:09:02.00,0:09:05.83,Default,,0,0,0,,Аясе-санның командасы әлі бірде-бір картаны жоғалтқан жоқ.
Dialogue: 0,0:09:07.13,0:09:08.84,Default,,0,0,0,,(Әнші) Миёшиноно~ (шоттарды алып жатқан дыбыс)
Dialogue: 0,0:09:08.92,0:09:12.84,Default,,0,0,0,,(Әнші) Yama no Akikaze Sayonofukete~
Dialogue: 0,0:09:13.76,0:09:14.59,Default,,0,0,0,,Ах
Dialogue: 0,0:09:15.59,0:09:17.09,Default,,0,0,0,,(Тайчи) Чихая
Dialogue: 0,0:09:17.80,0:09:24.31,Default,,0,0,0,,Туған жер салқын ~ Коромоцу ~ Нари ~
Dialogue: 0,0:09:26.73,0:09:28.52,Default,,0,0,0,,Оэяма~
Dialogue: 0,0:09:28.61,0:09:29.44,Default,,0,0,0,,Ах
Dialogue: 0,0:09:29.52,0:09:31.28,Default,,0,0,0,,(Тайчи)... Асығыңыз, бұл не?
Dialogue: 0,0:09:31.36,0:09:34.57,Default,,0,0,0,,(Мияучи) Бұл тым жылдам. Бұл соншалықты жылдам, мен ештеңе көре алмаймын.
Dialogue: 0,0:09:34.65,0:09:35.90,Default,,0,0,0,,(Тайчи) Мұғалім (Мияучи) Ах.
Dialogue: 0,0:09:36.74,0:09:37.91,Default,,0,0,0,,(Тайчи) Жақсы ма?
Dialogue: 0,0:09:37.99,0:09:39.03,Default,,0,0,0,,(Мияучи) Е... иә.
Dialogue: 0,0:09:41.79,0:09:45.54,Default,,0,0,0,,(Тайчи) Чихая есепшотты оқығаннан кейін жылдамырақ қозғала бастады.
Dialogue: 0,0:09:46.42,0:09:47.50,Default,,0,0,0,,«Ой» сөзін тыңдау
Dialogue: 0,0:09:47.58,0:09:50.25,Default,,0,0,0,,Жаудың «ашылуына» шабуыл жасауға бару
Dialogue: 0,0:09:50.34,0:09:54.30,Default,,0,0,0,,Менің командамның «Ое» қойылса да, мен оны қайтарып алуға тамаша жағдай жасадым.
Dialogue: 0,0:09:54.97,0:09:58.30,Default,,0,0,0,,Бірақ патшайым «Oe» дегенді естігенше қозғалмай тыңдайды
Dialogue: 0,0:09:59.18,0:10:03.18,Default,,0,0,0,,Сонымен... біз оны уақытында жасаймыз ба? Тіпті тыңдаған соң
Dialogue: 0,0:10:04.10,0:10:05.39,Default,,0,0,0,,(Әнші) Ханаса...
Dialogue: 0,0:10:07.31,0:10:11.02,Default,,0,0,0,,...Дұрыс, боранның ертеңінде, қарлы күні.
Dialogue: 0,0:10:11.02,0:10:12.23,Default,,0,0,0,,...Дұрыс, боранның ертеңінде, қарлы күні.
Dialogue: 0,0:10:11.02,0:10:12.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:12.32,0:10:13.69,Default,,0,0,0,,(Тайчи) Чихая
Dialogue: 0,0:10:13.78,0:10:16.49,Default,,0,0,0,,(Ер оқушы) Бұл тағы да болып жатыр ма? (Ер оқушы) Тағы 10 ұпай айырмашылығы бар ма?
Dialogue: 0,0:10:16.57,0:10:18.99,Default,,0,0,0,,(Ер студент) Өйткені, статусы басқа Шинобу Вакамия
Dialogue: 0,0:10:19.07,0:10:20.74,Default,,0,0,0,,(Оқушы қыз) Менімен жарысып жатқан қызды аяймын.
Dialogue: 0,0:10:20.82,0:10:23.95,Default,,0,0,0,,(Ер оқушы) Жақында бұл баланың жауынгерлік рухы жоғалады ма?
Dialogue: 0,0:10:24.04,0:10:26.50,Default,,0,0,0,,(Тайчи) Чихая, егер бұл сіз мақсат етіп отырған карта болса.
Dialogue: 0,0:10:26.58,0:10:29.00,Default,,0,0,0,,Сіз оны патшайым сияқты жылдам алуыңыз керек.
Dialogue: 0,0:10:29.88,0:10:32.00,Default,,0,0,0,,Бірақ ойында ондаған карталар бар.
Dialogue: 0,0:10:32.09,0:10:34.25,Default,,0,0,0,,Сіз барлық бағытты көздей алмайсыз.
Dialogue: 0,0:10:35.67,0:10:38.05,Default,,0,0,0,,Бұл патшайым мұны істей алады дегенді білдіре ме?
Dialogue: 0,0:10:42.05,0:10:43.56,Default,,0,0,0,,(Чихая) Сабыр ет.
Dialogue: 0,0:10:43.64,0:10:45.64,Default,,0,0,0,,Тіпті патшайымның да мүмкіндігі жоқ емес.
Dialogue: 0,0:10:46.64,0:10:48.98,Default,,0,0,0,,Анау «naniwae» және «naniwaga».
Dialogue: 0,0:10:49.06,0:10:50.15,Default,,0,0,0,,Өйткені «бірдеңе» оқылды
Dialogue: 0,0:10:50.23,0:10:52.65,Default,,0,0,0,,Мен екеуіне де «неге» төлей аламын, бірақ мен оларды ажыратпаймын.
Dialogue: 0,0:10:52.73,0:10:53.98,Default,,0,0,0,,(Харада) Мүмкін емес
Dialogue: 0,0:10:54.07,0:10:56.65,Default,,0,0,0,,Барлығын бірден бөлмеу мүмкін емес.
Dialogue: 0,0:10:57.74,0:10:59.40,Default,,0,0,0,,(Чихая) Шексіз нысана позициясы
Dialogue: 0,0:10:59.49,0:11:03.53,Default,,0,0,0,,Бірден екі бөлікті ал!
Dialogue: 0,0:11:04.12,0:11:06.79,Default,,0,0,0,,(Тайчи) Чихая Түсінуге оңай
Dialogue: 0,0:11:07.45,0:11:09.12,Default,,0,0,0,,(Әнші) Васуруру~
Dialogue: 0,0:11:09.21,0:11:11.04,Default,,0,0,0,,Аримаяма~
Dialogue: 0,0:11:11.12,0:11:14.21,Default,,0,0,0,,(Тайчи) Қараңдар! Өйткені мен мақсатты картамда тым көп шешім қабылдаймын
Dialogue: 0,0:11:14.92,0:11:18.22,Default,,0,0,0,,Бірақ мен біріншісін қалаймын.
Dialogue: 0,0:11:19.42,0:11:21.80,Default,,0,0,0,,Күресуге ерік-жігерді жоғалту деген болмайды.
Dialogue: 0,0:11:22.30,0:11:26.22,Default,,0,0,0,,Чихая, маған шабуыл жасау қабілетіңді көрсет.
Dialogue: 0,0:11:26.81,0:11:27.64,Default,,0,0,0,,Не...
Dialogue: 0,0:11:27.72,0:11:29.23,Default,,0,0,0,,(Чихая) Міне келді!
Dialogue: 0,0:11:30.06,0:11:31.48,Default,,0,0,0,,(Әнші)...Менің...
Dialogue: 0,0:11:31.56,0:11:32.40,Default,,0,0,0,,Na
Dialogue: 0,0:11:33.15,0:11:36.07,Default,,0,0,0,,Эй Машима-кун, сендердің қайсысың жеңді?
Dialogue: 0,0:11:36.15,0:11:38.28,Default,,0,0,0,,Мен шынымен түсінбедім.
Dialogue: 0,0:11:38.36,0:11:40.24,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:11:40.32,0:11:43.82,Default,,0,0,0,,Халықтың өзі білмесе не істейсің?
Dialogue: 0,0:11:43.91,0:11:48.04,Default,,0,0,0,,Сіз төрешіден сұрай аласыз немесе бір-біріңізбен талқылай аласыз...
Dialogue: 0,0:11:48.95,0:11:53.50,Default,,0,0,0,,Бірақ ойыншылар неғұрлым озық болса, соғұрлым олар жақсырақ көре алады.
Dialogue: 0,0:11:54.46,0:11:58.51,Default,,0,0,0,,(Чихая) Мен сол екі картаны төлеймін деп секіріп кеттім.
Dialogue: 0,0:12:00.30,0:12:04.39,Default,,0,0,0,,Бірақ патшайымның осы бір ұпайды өтеу үшін өткірлігі бар.
Dialogue: 0,0:12:09.35,0:12:10.89,Default,,0,0,0,,Мен қалай...
Dialogue: 0,0:12:13.56,0:12:15.02,Default,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,0:12:19.07,0:12:20.90,Default,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,0:12:20.99,0:12:21.90,Default,,0,0,0,,(Харада) Чихая-чан
Dialogue: 0,0:12:23.11,0:12:24.03,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:12:24.91,0:12:26.70,Default,,0,0,0,,Өз негізін қорғау сезімінен
Dialogue: 0,0:12:26.78,0:12:29.54,Default,,0,0,0,,Жаудың тереңдігін әрқашан жадында сақта.
Dialogue: 0,0:12:31.00,0:12:35.04,Default,,0,0,0,,(Чихая) Мен шабуылдасам да, басқа қаруым жоқ.
Dialogue: 0,0:12:35.13,0:12:36.54,Default,,0,0,0,,Аю әке!?
Dialogue: 0,0:12:36.63,0:12:39.13,Default,,0,0,0,,Не? Ах...
Dialogue: 0,0:12:39.21,0:12:40.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:40.67,0:12:43.63,Default,,0,0,0,,(Чихая) Не? Бұл футболка ше?
Dialogue: 0,0:12:43.72,0:12:44.55,Default,,0,0,0,,Га
Dialogue: 0,0:12:45.26,0:12:47.80,Default,,0,0,0,,(Чихая) Сноумару ханшайымының футболкасы
Dialogue: 0,0:12:47.89,0:12:49.60,Default,,0,0,0,,Осакада тек ресми дүкен бар.
Dialogue: 0,0:12:49.68,0:12:52.06,Default,,0,0,0,,Snowmaru, оны тек пошта арқылы сатып алуға болады
Dialogue: 0,0:12:52.14,0:12:55.19,Default,,0,0,0,,Шелек алсаң, хонмаж болады. Қауіпті кейіпкер.
Dialogue: 0,0:12:55.27,0:12:57.31,Default,,0,0,0,,(Қар Мару) Шарм нүктесі
Dialogue: 0,0:13:01.40,0:13:03.32,Default,,0,0,0,,(Чихая) жоқ сәйкестік жоқ
Dialogue: 0,0:13:04.45,0:13:09.08,Default,,0,0,0,,Иә, бұл патшайым, бірақ ол жасы 16-дағы қыз.
Dialogue: 0,0:13:09.16,0:13:10.33,Default,,0,0,0,,Жеңіске жету мүмкін емес
Dialogue: 0,0:13:10.41,0:13:11.41,Default,,0,0,0,,Көпіршіктер
Dialogue: 0,0:13:11.41,0:13:13.04,Default,,0,0,0,,Көпіршіктер
Dialogue: 0,0:13:11.41,0:13:13.04,Default,,0,0,0,,(Шинобу) Ақан шоғырлануы
Dialogue: 0,0:13:13.04,0:13:13.12,Default,,0,0,0,,(Шинобу) Ақан шоғырлануы
Dialogue: 0,0:13:13.12,0:13:13.83,Default,,0,0,0,,(Шинобу) Ақан шоғырлануы
Dialogue: 0,0:13:13.12,0:13:13.83,Default,,0,0,0,,Бірден орындаңыз.
Dialogue: 0,0:13:13.83,0:13:17.88,Default,,0,0,0,,Бірден орындаңыз.
Dialogue: 0,0:13:19.46,0:13:21.76,Default,,0,0,0,,Йононака...
Dialogue: 0,0:13:21.84,0:13:23.13,Default,,0,0,0,,Эх (Тайчи) Ах.
Dialogue: 0,0:13:23.22,0:13:24.97,Default,,0,0,0,,(Ер оқушы) Көрдің бе? ток
Dialogue: 0,0:13:25.05,0:13:26.51,Default,,0,0,0,,(Ер оқушы) Уау.
Dialogue: 0,0:13:26.59,0:13:30.39,Default,,0,0,0,,Мен ренжідім. Қазір не болды? Сіз біртүрлі әрекет еттіңіз.
Dialogue: 0,0:13:30.47,0:13:32.56,Default,,0,0,0,,Иә, бұл семсерлесуші.
Dialogue: 0,0:13:32.64,0:13:33.52,Default,,0,0,0,,Қоршаушы?
Dialogue: 0,0:13:34.31,0:13:36.52,Default,,0,0,0,,Чихая лагеріндегі «Йононакайо».
Dialogue: 0,0:13:36.60,0:13:39.23,Default,,0,0,0,,Королеваның лагерінде «Йононакаха» бар.
Dialogue: 0,0:13:39.31,0:13:41.27,Default,,0,0,0,,Ұзын тұрақты таңбалар
Dialogue: 0,0:13:41.36,0:13:44.99,Default,,0,0,0,,Өйткені мен «Йононака» дыбысының келесі дыбысы «ха» немесе «йо» екенін білмеймін.
Dialogue: 0,0:13:45.07,0:13:48.20,Default,,0,0,0,,Оны алып тастауға болмайтындай етіп оқылғанша қоршау
Dialogue: 0,0:13:48.28,0:13:49.28,Default,,0,0,0,,Бұл семсерлесуші.
Dialogue: 0,0:13:49.37,0:13:51.28,Default,,0,0,0,,Мұндай қозғалыс...
Dialogue: 0,0:13:52.12,0:13:56.83,Default,,0,0,0,,Әр ойыншы өз карталарын қоршап алады, ал карталар Чихая лагеріндегі «Йононакайоға» орналастырылған.
Dialogue: 0,0:13:58.00,0:14:01.67,Default,,0,0,0,,Жазбаны басу ғана қалды, бірақ...
Dialogue: 0,0:14:02.50,0:14:04.46,Default,,0,0,0,,Чихая оны басып тұрғанда жылдамырақ
Dialogue: 0,0:14:04.55,0:14:06.17,Default,,0,0,0,,Королеваның қолы кішкене саңылаудан көрінеді...
Dialogue: 0,0:14:11.64,0:14:12.93,Default,,0,0,0,,(Чихая) Менің қолымнан келмейді.
Dialogue: 0,0:14:15.43,0:14:16.69,Default,,0,0,0,,Жеңіске деген қиял...
Dialogue: 0,0:14:18.06,0:14:19.48,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:20.77,0:14:23.28,Default,,0,0,0,,(цикада дыбысы)
Dialogue: 0,0:14:23.36,0:14:24.69,Default,,0,0,0,,(Оқушы қыз) Тым сүйкімді
Dialogue: 0,0:14:24.78,0:14:27.78,Default,,0,0,0,,(Ер оқушы) Оны көпшілік алдында жазалау деп атайды.
Dialogue: 0,0:14:27.86,0:14:29.07,Default,,0,0,0,,Мен шынымен де соққым келмейді.
Dialogue: 0,0:14:29.16,0:14:33.33,Default,,0,0,0,,(Ер оқушы) Бұл қарқынмен біз бір үзінді де ала алмаймыз.
Dialogue: 0,0:14:33.95,0:14:37.66,Default,,0,0,0,,(Тайчи) Егер карталар санының айырмашылығы көбейсе, шабуыл жасағысы келетіндер қолайсыз жағдайда болады.
Dialogue: 0,0:14:37.75,0:14:42.21,Default,,0,0,0,,Ықтималдық мәселелеріне байланысты сіздің командаңызға жіберілген ұсыныстардың саны табиғи түрде артады.
Dialogue: 0,0:14:42.29,0:14:43.88,Default,,0,0,0,,Сезіміңді қорғайды
Dialogue: 0,0:14:43.96,0:14:45.59,Default,,0,0,0,,(Әнші) Менің гайохам~ (Чихая) Ха
Dialogue: 0,0:14:45.67,0:14:50.59,Default,,0,0,0,,(Тайчи) Оның үстіне патшайым өз күшін қорғауға тырысады.
Dialogue: 0,0:14:50.68,0:14:53.10,Default,,0,0,0,,Мен шабуыл жасай алмаймын, бірақ шабуылдан басқа амалым жоқ.
Dialogue: 0,0:14:53.97,0:14:55.60,Default,,0,0,0,,Көңілді Чихая!
Dialogue: 0,0:14:55.68,0:14:56.93,Default,,0,0,0,,Көбінесе~
Dialogue: 0,0:14:57.02,0:14:58.14,Default,,0,0,0,,Ах
Dialogue: 0,0:14:58.23,0:15:01.48,Default,,0,0,0,,(Taichi) What's wrong? Чихая, сен неге шабуыл жасамайсың?
Dialogue: 0,0:15:05.73,0:15:07.61,Default,,0,0,0,,(Шинобу) Ах, тағы да.
Dialogue: 0,0:15:08.74,0:15:11.62,Default,,0,0,0,,Басында бәрі саған қарай асығып бара жатқан сияқты.
Dialogue: 0,0:15:11.70,0:15:15.45,Default,,0,0,0,,(Амакасу) Венера патшайыммен күрес, көтерейік.
Dialogue: 0,0:15:15.54,0:15:21.25,Default,,0,0,0,,(Шинобу) Бірақ ақырында бұл жалғыз өзі карута ойнағандай болады.
Dialogue: 0,0:15:22.75,0:15:25.13,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:15:26.17,0:15:28.34,Default,,0,0,0,,Оны мүмкіндігінше тезірек аяқтаңыз
Dialogue: 0,0:15:29.34,0:15:32.26,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:15:32.34,0:15:34.76,Default,,0,0,0,,(Female student) 15 cards difference? (Ер оқушы) О
Dialogue: 0,0:15:36.35,0:15:37.39,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:15:37.39,0:15:38.56,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:15:37.39,0:15:38.56,Default,,0,0,0,,(Әйел) Не?
Dialogue: 0,0:15:38.56,0:15:38.64,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:15:38.64,0:15:40.27,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:15:38.64,0:15:40.27,Default,,0,0,0,,(Ер адам) Не болды?
Dialogue: 0,0:15:40.35,0:15:44.15,Default,,0,0,0,,Уа, кешіріңіз, кешіріңіз!
Dialogue: 0,0:15:44.98,0:15:47.15,Default,,0,0,0,,(Чихая) Ах... Ах.
Dialogue: 0,0:15:49.78,0:15:51.86,Default,,0,0,0,,(Чихая) Тайчи Сенсэй
Dialogue: 0,0:15:51.95,0:15:53.70,Default,,0,0,0,,(Тайчи) Қолыңнан келгеннің бәрін істе, Чихая!
Dialogue: 0,0:15:53.78,0:15:55.49,Default,,0,0,0,,(Мияучи) Сәттілік, Аясе-сан!
Dialogue: 0,0:15:56.95,0:16:00.87,Default,,0,0,0,,(Чихая) Бірақ мен не істерімді білмеймін.
Dialogue: 0,0:16:01.58,0:16:05.63,Default,,0,0,0,,Мен мұнда келдім, Карутада бірде-бір карта ала алмаймын.
Dialogue: 0,0:16:06.84,0:16:08.71,Default,,0,0,0,,Бұл менің бірінші рет
Dialogue: 0,0:16:10.01,0:16:11.13,Default,,0,0,0,,Га
Dialogue: 0,0:16:14.51,0:16:16.39,Default,,0,0,0,,(Жаңа) Мен бұрыштарды кеспеймін
Dialogue: 0,0:16:16.47,0:16:17.31,Default,,0,0,0,,(Чихая) Ах...
Dialogue: 0,0:16:18.81,0:16:22.60,Default,,0,0,0,,(Чихая) Бұл көңілсіз. Мен кем дегенде біреуін алғым келеді.
Dialogue: 0,0:16:22.69,0:16:25.61,Default,,0,0,0,,Мен ең болмағанда осы бір бөлікті алғым келеді!
Dialogue: 0,0:16:32.49,0:16:34.74,Default,,0,0,0,,(Чихая) Кешіріңіз (Шинобу) Хмм...
Dialogue: 0,0:16:35.87,0:16:39.83,Default,,0,0,0,,(Чихая) Ағын нашар болғанда Судо-сан тұрды ма?
Dialogue: 0,0:16:39.91,0:16:41.62,Default,,0,0,0,,бастық
Dialogue: 0,0:16:42.29,0:16:43.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:43.96,0:16:47.21,Default,,0,0,0,,Мүмкін Королева солақай шығар?
Dialogue: 0,0:16:47.29,0:16:50.71,Default,,0,0,0,,Уау, мен мұны қазір түсінгеніме сене алар емеспін.
Dialogue: 0,0:16:50.80,0:16:53.30,Default,,0,0,0,,Мен қаншалықты қуаныштымын?
Dialogue: 0,0:16:53.38,0:16:54.22,Default,,0,0,0,,(Шинобу) Иә?
Dialogue: 0,0:16:55.68,0:16:56.72,Default,,0,0,0,,(Чихая) Кешіріңіз.
Dialogue: 0,0:16:58.35,0:17:02.73,Default,,0,0,0,,(Чихая) 12 жасар маған деген сезіміңнен айырылып қалсаң не істер едің?
Dialogue: 0,0:17:04.69,0:17:08.27,Default,,0,0,0,,(Шинобу) Иә? Қайтып келдіңіз бе?
Dialogue: 0,0:17:09.07,0:17:10.57,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:11.36,0:17:13.40,Default,,0,0,0,,Ол қанша уақытқа созылады?
Dialogue: 0,0:17:13.49,0:17:16.45,Default,,0,0,0,,Вагатацу~Сомани~
Dialogue: 0,0:17:16.53,0:17:21.08,Default,,0,0,0,,Сумизоманың жеңдері
Dialogue: 0,0:17:23.25,0:17:25.04,Default,,0,0,0,,Мен суық тиіп қалдым~ (Чихая) Уф
Dialogue: 0,0:17:25.12,0:17:28.92,Default,,0,0,0,,(Тайчи) Шабуыл жасап, қайтып оралды. Бұл жақын қоңырау. Қайсысын аламыз?
Dialogue: 0,0:17:29.84,0:17:31.67,Default,,0,0,0,,Ах... аа~
Dialogue: 0,0:17:34.92,0:17:40.14,Default,,0,0,0,,(Чихая) Мен шабуыл жасап, өз базама қайтып келгеннен гөрі, патшайымның түзу сызықпен шабуылы жылдамырақ.
Dialogue: 0,0:17:42.22,0:17:46.14,Default,,0,0,0,,Бірақ мен тек шабуыл жасауды үйрендім.
Dialogue: 0,0:17:46.23,0:17:49.31,Default,,0,0,0,,(Харада) Чихая-чан, ойлансаң түсінесің.
Dialogue: 0,0:17:49.40,0:17:53.53,Default,,0,0,0,,Өзінің қорғанысына сенімді адамдар өз территориясының ең терең жеріне енеді.
Dialogue: 0,0:17:53.61,0:17:56.49,Default,,0,0,0,,Бұл қаншалықты таң қалдырады?
Dialogue: 0,0:17:57.45,0:18:00.49,Default,,0,0,0,,(Чихая) Ағын сені осылай тартады!
Dialogue: 0,0:18:00.58,0:18:03.20,Default,,0,0,0,,(Әнші) Ашық нәрселер ~
Dialogue: 0,0:18:03.29,0:18:07.29,Default,,0,0,0,,Менің ойымша, уақыт келді.
Dialogue: 0,0:18:09.08,0:18:10.21,Default,,0,0,0,,Наниваэно~ (Шинобу) Уф
Dialogue: 0,0:18:10.29,0:18:11.59,Default,,0,0,0,,Ах
Dialogue: 0,0:18:14.09,0:18:17.59,Default,,0,0,0,,(Шинобу) Соқтығыстың ба? Сіз бұл дөрекі болды деп ойладыңыз ба?
Dialogue: 0,0:18:18.38,0:18:20.09,Default,,0,0,0,,Аа... керемет
Dialogue: 0,0:18:21.68,0:18:23.35,Default,,0,0,0,,(Тайчи) Ия, Чихая!
Dialogue: 0,0:18:23.43,0:18:24.35,Default,,0,0,0,,(Мияучи) 1-бет
Dialogue: 0,0:18:24.93,0:18:27.98,Default,,0,0,0,,Жоқ, дәл сол уақыт, сондықтан сіз өз позицияңызды қабылдайсыз.
Dialogue: 0,0:18:28.81,0:18:31.19,Default,,0,0,0,,(Тайчи) Неліктен? Ал, Чихая.
Dialogue: 0,0:18:31.27,0:18:32.73,Default,,0,0,0,,Әдетте, тартпаңыз.
Dialogue: 0,0:18:33.98,0:18:35.65,Default,,0,0,0,,(Шинобу) Солай ма?
Dialogue: 0,0:18:35.74,0:18:36.74,Default,,0,0,0,,(Чихая) Ой, кетті.
Dialogue: 0,0:18:36.82,0:18:42.20,Default,,0,0,0,,Барлық шоттар сіздікі. Аузымызбен алдық деп қадап қояйық.
Dialogue: 0,0:18:42.28,0:18:45.50,Default,,0,0,0,,(Чихая) Харада Сенсейдің Карутасы мүмкін емес нәрселерді жасайды...
Dialogue: 0,0:18:47.83,0:18:50.50,Default,,0,0,0,,Бірақ бұл Оми Кангакукан
Dialogue: 0,0:18:51.88,0:18:55.92,Default,,0,0,0,,Мастер шайқасы да, патшайым шайқасы да бір татами төсенішінде.
Dialogue: 0,0:18:56.42,0:18:58.05,Default,,0,0,0,,Мен қателескім келмейді.
Dialogue: 0,0:19:01.39,0:19:06.98,Default,,0,0,0,,Осы баладан алған бірінші карта қаңтар айында сол орындыққа жалғанады.
Dialogue: 0,0:19:10.60,0:19:15.53,Default,,0,0,0,,(Чихая терең тыныс алады)
Dialogue: 0,0:19:18.78,0:19:20.28,Default,,0,0,0,,(Шинобу) Біртүрлі бала
Dialogue: 0,0:19:23.45,0:19:26.04,Default,,0,0,0,,(Әнші) Бар күшіңді сал!
Dialogue: 0,0:19:26.12,0:19:30.29,Default,,0,0,0,,Койвата ~Керек~
Dialogue: 0,0:19:35.88,0:19:37.13,Default,,0,0,0,,(Әнші) Фу...
Dialogue: 0,0:19:37.96,0:19:39.17,Default,,0,0,0,,...Кукарани~ Акинокусакино...
Dialogue: 0,0:19:39.17,0:19:40.59,Default,,0,0,0,,...Кукарани~Акинокусакино...
Dialogue: 0,0:19:39.17,0:19:40.59,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,0:19:40.59,0:19:41.47,Default,,0,0,0,,...Кукарани~ Акинокусакино...
Dialogue: 0,0:19:41.55,0:19:45.72,Default,,0,0,0,,(Тайчи) Патшайымның басым жағындағы бір таңба ережесін алып тастады.
Dialogue: 0,0:19:47.06,0:19:51.23,Default,,0,0,0,,Уау~ Мен патшайымның жұдырықпен ұрылғанын бірінші рет көруім.
Dialogue: 0,0:19:51.31,0:19:54.73,Default,,0,0,0,,Сіз оны «фукукаранидегі» «фумен» қатар төлеген жоқсыз ба?
Dialogue: 0,0:19:56.36,0:19:57.73,Default,,0,0,0,,(Тайчи) F жазбасы
Dialogue: 0,0:19:58.99,0:20:01.20,Default,,0,0,0,,деді Харада мырза
Dialogue: 0,0:20:01.28,0:20:05.24,Default,,0,0,0,,Чихая дыбысты «фу» болмай тұрып естиді
Dialogue: 0,0:20:06.83,0:20:10.50,Default,,0,0,0,,Дыбысқа айналған сәтте Ф дыбысы
Dialogue: 0,0:20:12.08,0:20:15.54,Default,,0,0,0,,«Фукукарани» де Чихаяның мамандығы.
Dialogue: 0,0:20:17.00,0:20:18.00,Default,,0,0,0,,(Чихая) 1-бет
Dialogue: 0,0:20:19.34,0:20:22.76,Default,,0,0,0,,Сондай-ақ, бұл менің бірінші есепшотым.
Dialogue: 0,0:20:25.35,0:20:26.76,Default,,0,0,0,,Я~
Dialogue: 0,0:20:32.94,0:20:33.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:35.23,0:20:36.27,Default,,0,0,0,,(Тайчи) Чихая!
Dialogue: 0,0:20:42.36,0:20:45.28,Default,,0,0,0,,(литр) Мубе~Ямаказево~
Dialogue: 0,0:20:45.37,0:20:49.29,Default,,0,0,0,,Оны дауыл~ деп атайды
Dialogue: 0,0:20:52.41,0:20:53.79,Default,,0,0,0,,(Чихая) Ха
Dialogue: 0,0:20:54.79,0:20:55.79,Default,,0,0,0,,(Әнші) Чихаябуру...
Dialogue: 0,0:20:55.88,0:20:56.75,Default,,0,0,0,,Мен оны алдым!
Dialogue: 0,0:20:56.83,0:20:57.75,Default,,0,0,0,,(Тайчи) Чихая!
Dialogue: 0,0:20:57.84,0:20:59.13,Default,,0,0,0,,Бір ату! (Әйел студент) Қатарынан жеңіс!
Dialogue: 0,0:21:12.56,0:21:13.85,Default,,0,0,0,,(Чихая) Мынау
Dialogue: 0,0:21:16.10,0:21:18.19,Default,,0,0,0,,Ханшайымға қосылған
Dialogue: 0,0:21:25.03,0:21:30.03,Default,,0,0,0,,♪～
Dialogue: 0,0:22:29.68,0:22:34.68,Default,,0,0,0,,～♪
