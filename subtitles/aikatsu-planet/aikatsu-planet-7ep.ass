Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.31,0:00:05.24,Dorama,NTP,0,0,0,,Табыстың өзін-өзі орталықтандыру аймағы
Dialogue: 0,0:00:05.41,0:00:06.54,Dorama,NTP,0,0,0,,Идол белсендіруші жұлдыз сферасы!
Dialogue: 0,0:00:06.69,0:00:07.60,Dorama,NTP,0,0,0,,Бастапқы нүкте
Dialogue: 0,0:00:09.02,0:00:10.03,Dorama,NTP,0,0,0,,~
Dialogue: 0,0:00:11.39,0:00:12.63,Dorama,NTP,0,0,0,,Жоғарғы шеңбер оқиғасы!
Dialogue: 0,0:00:13.03,0:00:15.74,Dorama,NTP,0,0,0,,Гакоу Отова Майки орта мектебі мен кіші орта мектебінің сыныбы
Dialogue: 0,0:00:16.06,0:00:19.34,Dorama,NTP,0,0,0,,Тірі жұлдыз шарында, кішкентай ұшты пұт, кішкентай гүл!
Dialogue: 0,0:00:19.88,0:00:22.70,Dorama,NTP,0,0,0,,Бұл ай құлып махаббат садақ арнайы дене дамыту қызметі.
Dialogue: 0,0:00:22.90,0:00:25.52,Dorama,NTP,0,0,0,,Тірі жұлдыздар шеңберінен тыс, бұл да қонақжай кумир!
Dialogue: 0,0:00:26.33,0:00:28.21,Dorama,NTP,0,0,0,,Күшті дене қалпы
Dialogue: 0,0:00:28.46,0:00:31.08,Dorama,NTP,0,0,0,,Мен оқу сабақтарымнан көп нәрсені үйрендім.
Dialogue: 0,0:00:31.24,0:00:33.26,Dorama,NTP,0,0,0,,Бұл да бірлескен қызметтің бір түрі.
Dialogue: 0,0:00:36.39,0:00:39.44,Dorama,NTP,0,0,0,,~ ...
Dialogue: 0,0:00:39.62,0:00:43.41,Dorama,NTP,0,0,0,,Сота Кайсей жұлдызы кетті
Dialogue: 0,0:00:43.79,0:00:46.41,Dorama,NTP,0,0,0,,~
Dialogue: 0,0:00:46.95,0:00:49.56,Dorama,NTP,0,0,0,,Сота, сен кінәлісің бе?
Dialogue: 0,0:00:49.88,0:00:52.40,Dorama,NTP,0,0,0,,Шетелдік теледидардың былтырғы бөлімі
Dialogue: 0,0:00:52.57,0:00:54.34,Dorama,NTP,0,0,0,,《Сен өз жұлдызыңнан келдің》?
Dialogue: 0,0:00:54.69,0:00:56.68,Dorama,NTP,0,0,0,,Түпнұсқадан бұл кішкентай ит иттің сыйы
Dialogue: 0,0:00:56.86,0:01:00.08,Dorama,NTP,0,0,0,,Шын мәнінде, бұл Жерден келген жаңа қыз, ғарыштық ракон мысығы.
Dialogue: 0,0:01:00.27,0:01:03.38,Dorama,NTP,0,0,0,,Он аяқты дүние туралы сан алуан әңгімелер бүкіл әлемді таңғалдырады.
Dialogue: 0,0:01:03.69,0:01:04.62,Dorama,NTP,0,0,0,,Гачоу, сахнаны сен мен Мелониге қалдыр.
Dialogue: 0,0:01:05.04,0:01:08.65,Dorama,NTP,0,0,0,,Сізге жүгірудің қажеті жоқ, Сота!
Dialogue: 0,0:01:14.64,0:01:17.80,Dorama,NTP,0,0,0,,Шыны бейне
Dialogue: 0,0:01:17.88,0:01:21.69,Dorama,NTP,0,0,0,,Гачидо, бірақ мен жайбарақат емеспін.
Dialogue: 0,0:01:22.05,0:01:25.95,Dorama,NTP,0,0,0,,Адамдарды жылататын бейнеролик.
Dialogue: 0,0:01:26.18,0:01:28.79,Dorama,NTP,0,0,0,,Өзеннен 3000 фут төмен
Dialogue: 0,0:01:28.96,0:01:31.39,Dorama,NTP,0,0,0,,Сіздің де сол күйде екеніңіз анық па?
Dialogue: 0,0:01:32.30,0:01:35.12,Dorama,NTP,0,0,0,,Маған не айтасың?
Dialogue: 0,0:03:05.96,0:03:10.97,Default,NTP,0,0,0,,Оян, қара өрік, Лилия, Лилия!
Dialogue: 0,0:03:15.51,0:03:16.39,Dorama,NTP,0,0,0,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:03:16.80,0:03:19.77,Dorama,NTP,0,0,0,,Қазір жаңартылды ма?
Dialogue: 0,0:03:19.92,0:03:21.53,Dorama,NTP,0,0,0,,Умеро Рияның жаңа бет түсі
Dialogue: 0,0:03:22.20,0:03:23.15,Dorama,NTP,0,0,0,,Умерури?
Dialogue: 0,0:03:23.31,0:03:26.79,Dorama,NTP,0,0,0,,Қазіргі уақытта әйелдің дүниеге келуіне бата.
Dialogue: 0,0:03:27.12,0:03:29.56,Dorama,NTP,0,0,0,,Әр маусымда қаладан өзгеше бет
Dialogue: 0,0:03:29.84,0:03:32.28,Dorama,NTP,0,0,0,,Ыстықта тез өсетін ұнтақ!
Dialogue: 0,0:03:32.43,0:03:37.65,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:03:32.43,0:03:37.65,Dorama,NTP,0,0,0,,NHK 15
Dialogue: 0,0:03:38.69,0:03:41.28,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:03:41.43,0:03:43.44,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:03:43.99,0:03:50.91,Dorama,NTP,0,0,0,,Мэй Роли оқиғасы туралы әңгіменің қысқаша мазмұны
Dialogue: 0,0:03:51.54,0:03:52.63,Dorama,NTP,0,0,0,,Жақсы немесе жаман!
Dialogue: 0,0:03:54.14,0:03:56.27,Dorama,NTP,0,0,0,,Бұл басты оқиға ма?
Dialogue: 0,0:03:57.77,0:03:59.46,Dorama,NTP,0,0,0,,Бұл оқиғаның негізі.
Dialogue: 0,0:03:59.74,0:04:03.63,Dorama,NTP,0,0,0,,Мен телебағдарламаға қатыса алмаймын.
Dialogue: 0,0:04:06.00,0:04:08.01,Dorama,NTP,0,0,0,,Сіз мұны білгеннен бері
Dialogue: 0,0:04:08.17,0:04:11.42,Dorama,NTP,0,0,0,,Қойылымға қандай шығармалар кіреді?
Dialogue: 0,0:04:11.57,0:04:14.65,Dorama,NTP,0,0,0,,Бұл мен жасаған ең жақсы бейне.
Dialogue: 0,0:04:15.80,0:04:19.39,Dorama,NTP,0,0,0,,~
Dialogue: 0,0:04:22.46,0:04:24.26,Dorama,NTP,0,0,0,,Коичиро Коренаи Хаякаки
Dialogue: 0,0:04:24.54,0:04:31.39,Dorama,NTP,0,0,0,,Хаякаки соңғы уақытта өртті жарылыс бейнекамералары үшін үнемі итермеледі ме?
Dialogue: 0,0:04:31.63,0:04:33.74,Dorama,NTP,0,0,0,,Бұл Умеруридің келесі бейнесі
Dialogue: 0,0:04:33.90,0:04:36.16,Dorama,NTP,0,0,0,,Басқа тараптар сататын әйнектің басылған көшірмесі
Dialogue: 0,0:04:36.32,0:04:38.35,Dorama,NTP,0,0,0,,Бұл кездесуді келесі жолы көру
Dialogue: 0,0:04:38.51,0:04:41.82,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:04:43.64,0:04:46.81,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:04:47.40,0:04:49.17,Dorama,NTP,0,0,0,,Тоқыма кеңейеді!
Dialogue: 0,0:04:49.32,0:04:55.70,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:04:55.86,0:04:57.85,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:04:59.30,0:05:00.51,Dorama,NTP,0,0,0,,Бұл орын болуы керек
Dialogue: 0,0:05:02.24,0:05:03.28,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:05:06.35,0:05:07.46,Dorama,NTP,0,0,0,,Дұрыс емес...
Dialogue: 0,0:05:08.92,0:05:14.61,Dorama,NTP,0,0,0,,Сіз дарынды адамсыз ба?
Dialogue: 0,0:05:16.37,0:05:21.01,Dorama,NTP,0,0,0,,~ ~
Dialogue: 0,0:05:23.07,0:05:24.31,Dorama,NTP,0,0,0,,Кешір мені.
Dialogue: 0,0:05:25.09,0:05:27.51,Dorama,NTP,0,0,0,,Мен мүсінді жақсы көремін
Dialogue: 0,0:05:31.12,0:05:33.38,Dorama,NTP,0,0,0,,Бұл жақсы идея емес~
Dialogue: 0,0:05:33.94,0:05:35.39,Dorama,NTP,0,0,0,,Төлем сатып алу болып табылады.
Dialogue: 0,0:05:35.53,0:05:36.35,Dorama,NTP,0,0,0,,Иә?
Dialogue: 0,0:05:37.84,0:05:44.89,Dorama,NTP,0,0,0,,«Тыныш» - Мэй Луо Лидің жылаған дауысы?
Dialogue: 0,0:05:46.62,0:05:49.13,Dorama,NTP,0,0,0,,Мэй Роли - жылағысы келмейтін бала.
Dialogue: 0,0:05:49.86,0:05:51.63,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:05:53.60,0:05:55.33,Dorama,NTP,0,0,0,,Алайда...
Dialogue: 0,0:05:56.80,0:05:59.15,Dorama,NTP,0,0,0,,Мен кездестім!
Dialogue: 0,0:05:59.31,0:06:00.46,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:06:00.62,0:06:03.76,Dorama,NTP,0,0,0,,Қажетсіз іске қосу Sota!
Dialogue: 0,0:06:03.93,0:06:07.84,Dorama,NTP,0,0,0,,Сота? құшақтау
Dialogue: 0,0:06:13.77,0:06:14.91,Dorama,NTP,0,0,0,,Менің сөздерім...
Dialogue: 0,0:06:16.70,0:06:25.94,Dorama,NTP,0,0,0,,Інжу шынысының бейне көшірмесінің үлкен көшірмесі болуы маңызды.
Dialogue: 0,0:06:26.63,0:06:29.16,Dorama,NTP,0,0,0,,Мен кете аламын ба?
Dialogue: 0,0:06:29.99,0:06:30.46,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:06:31.15,0:06:32.56,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:06:33.59,0:06:37.66,Dorama,NTP,0,0,0,,Соңғы рет сонда болғанымда шаршадым.
Dialogue: 0,0:06:37.87,0:06:39.59,Dorama,NTP,0,0,0,,Мен ескі өмірдің мәнін түсінемін.
Dialogue: 0,0:06:39.78,0:06:44.44,Dorama,NTP,0,0,0,,Үй иесінің мекенжайы: Хаякаки мырза кетуі керек. Бұл теледидарда расталады.
Dialogue: 0,0:06:44.82,0:06:48.57,Dorama,NTP,0,0,0,,Мен саған ғашықпын!
Dialogue: 0,0:06:49.13,0:06:51.54,Dorama,NTP,0,0,0,,Анықтама ретінде көрсетемін.
Dialogue: 0,0:06:51.92,0:06:56.46,Dorama,NTP,0,0,0,,Менің ойым анық, бірақ мен өз ниетімді түсінбеймін.
Dialogue: 0,0:06:57.72,0:07:02.40,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:07:04.08,0:07:05.17,Dorama,NTP,0,0,0,,Бұл анық па?
Dialogue: 0,0:07:06.66,0:07:09.83,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:07:10.64,0:07:13.22,Dorama,NTP,0,0,0,,“"
Dialogue: 0,0:07:13.44,0:07:15.64,Dorama,NTP,0,0,0,,Сезім бар ма?
Dialogue: 0,0:07:15.80,0:07:20.11,Dorama,NTP,0,0,0,,~ ...
Dialogue: 0,0:07:20.72,0:07:23.70,Dorama,NTP,0,0,0,,Сіз құбыжықсыз ба?
Dialogue: 0,0:07:24.33,0:07:27.59,Dorama,NTP,0,0,0,,Такатака Хиротака Такатака Хиротака
Dialogue: 0,0:07:30.39,0:07:33.65,Dorama,NTP,0,0,0,,Мен 100 жасқа толдым.
Dialogue: 0,0:07:33.81,0:07:35.62,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:07:35.90,0:07:41.22,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:07:42.20,0:07:47.10,Dorama,NTP,0,0,0,,Үй иесінің ойы – өз ойы.
Dialogue: 0,0:07:47.49,0:07:49.72,Dorama,NTP,0,0,0,,Шығу тегі
Dialogue: 0,0:07:51.43,0:07:53.51,Dorama,NTP,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:07:54.43,0:07:58.00,Dorama,NTP,0,0,0,,Ең алдымен батыстық сәннен шығу керек...
Dialogue: 0,0:07:58.18,0:07:59.37,Dorama,NTP,0,0,0,,Иә?
Dialogue: 0,0:07:59.92,0:08:02.93,Dorama,NTP,0,0,0,,Ұсынылатын сөйлемдер
Dialogue: 0,0:08:03.20,0:08:04.50,Dorama,NTP,0,0,0,,Я~
Dialogue: 0,0:08:04.81,0:08:07.67,Dorama,NTP,0,0,0,,Ғафутақай ойнап жүр
Dialogue: 0,0:08:08.92,0:08:11.68,Dorama,NTP,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:08:12.01,0:08:13.14,Dorama,NTP,0,0,0,,Мүмкін!
Dialogue: 0,0:08:14.00,0:08:16.58,Dorama,NTP,0,0,0,,Бұл ерекше ма?
Dialogue: 0,0:08:21.39,0:08:23.44,Dorama,NTP,0,0,0,,Дүниедегі сезімдер
Dialogue: 0,0:08:23.92,0:08:27.25,Dorama,NTP,0,0,0,,Дүниеде шынымен қиын ба?
Dialogue: 0,0:08:27.95,0:08:31.62,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:08:33.15,0:08:33.99,Dorama,NTP,0,0,0,,Алқызыл түс?
Dialogue: 0,0:08:34.15,0:08:37.43,Dorama,NTP,0,0,0,,Түрлі түстер бар, Мен бақыттымын, ақпын.
Dialogue: 0,0:08:38.79,0:08:39.55,Dorama,NTP,0,0,0,,Дәмді ме?
Dialogue: 0,0:08:39.75,0:08:42.93,Dorama,NTP,0,0,0,,хош иісті, жеңіл және сергітетін иіс
Dialogue: 0,0:08:43.19,0:08:44.13,Dorama,NTP,0,0,0,,Дәмі?
Dialogue: 0,0:08:44.61,0:08:47.70,Dorama,NTP,0,0,0,,Құрамында пури бар
Dialogue: 0,0:08:49.43,0:08:51.40,Dorama,NTP,0,0,0,,Гачидёрё мұздай суық!
Dialogue: 0,0:08:51.56,0:08:52.53,Dorama,NTP,0,0,0,,Түсіндім!
Dialogue: 0,0:08:52.76,0:08:54.59,Dorama,NTP,0,0,0,,Соңында, сіз түсінесіз.
Dialogue: 0,0:08:54.96,0:08:58.93,Dorama,NTP,0,0,0,,Көп шыны қарсылық жайлылық
Dialogue: 0,0:09:00.41,0:09:05.31,Dorama,NTP,0,0,0,,Мұны пайдаланудың ең жақсы жолы қандай?
Dialogue: 0,0:09:05.91,0:09:10.98,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:09:11.11,0:09:12.28,Dorama,NTP,0,0,0,,Бұл рас па?
Dialogue: 0,0:09:12.46,0:09:14.11,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:09:15.69,0:09:17.29,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:09:19.00,0:09:25.79,Dorama,NTP,0,0,0,,Сыртқы түрі – адамдардың алдынан соққан жылы жел.
Dialogue: 0,0:09:27.27,0:09:32.46,Dorama,NTP,0,0,0,,Сіз батыл және жігерлісіз бе?
Dialogue: 0,0:09:33.58,0:09:35.04,Dorama,NTP,0,0,0,,Төтенше жағдайды сезіну
Dialogue: 0,0:09:35.49,0:09:37.46,Dorama,NTP,0,0,0,,Сәттілік!
Dialogue: 0,0:09:39.28,0:09:44.38,Dorama,NTP,0,0,0,,Адгезия
Dialogue: 0,0:09:44.93,0:09:46.86,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:09:48.79,0:09:51.91,Dorama,NTP,0,0,0,,Бұл сіздің жеке қабілетіңіз.
Dialogue: 0,0:09:52.56,0:09:56.41,Dorama,NTP,0,0,0,,Беру... Сыйлық беру
Dialogue: 0,0:09:56.85,0:10:03.46,Dorama,NTP,0,0,0,,Өзара қарым-қатынас пен ынтымақтастықты түсіну
Dialogue: 0,0:10:03.79,0:10:05.93,Dorama,NTP,0,0,0,,Менде тағы бір мәселе бар
Dialogue: 0,0:10:08.21,0:10:10.73,Dorama,NTP,0,0,0,,Келесі бейнені оқуға болады
Dialogue: 0,0:10:11.23,0:10:13.46,Dorama,NTP,0,0,0,,Сізді асыға күтемін
Dialogue: 0,0:10:14.01,0:10:18.59,Dorama,NTP,0,0,0,,Бұл адамның жеке басы
Dialogue: 0,0:10:19.13,0:10:30.09,Dorama,NTP,0,0,0,,Бұл ақыл-ойды қалыптастыратын өзіндік қарама-қайшылық.
Dialogue: 0,0:10:30.97,0:10:32.33,Dorama,NTP,0,0,0,,Рю Рюри?
Dialogue: 0,0:10:35.26,0:10:38.18,Dorama,NTP,0,0,0,,Жақсы жылу өткір жылу ма?
Dialogue: 0,0:10:38.38,0:10:39.23,Dorama,NTP,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:10:39.38,0:10:40.18,Dorama,NTP,0,0,0,,Шыны
Dialogue: 0,0:10:59.23,0:11:00.54,Dorama,NTP,0,0,0,,Шағын басылым?
Dialogue: 0,0:11:00.70,0:11:03.76,Dorama,NTP,0,0,0,,Шыны ұнайды ма?
Dialogue: 0,0:11:04.40,0:11:07.55,Dorama,NTP,0,0,0,,Майка Юанның арнайы операциясы аяқталды ма?
Dialogue: 0,0:11:07.90,0:11:08.99,Dorama,NTP,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:11:10.71,0:11:12.74,Dorama,NTP,0,0,0,,Айырмалық нүкте жарылып кетті
Dialogue: 0,0:11:18.07,0:11:19.07,Dorama,NTP,0,0,0,,Қарақұрым қоңырау белгісі мұнараның шыңынан алыстап барады. Мен оны сеземін.
Dialogue: 0,0:11:20.31,0:11:25.86,Dorama,NTP,0,0,0,,«Мың сөз, жалындаған құмарлық келді» дедің.
Dialogue: 0,0:11:27.74,0:11:32.29,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:11:32.45,0:11:33.61,Dorama,NTP,0,0,0,,Сіз ше?
Dialogue: 0,0:11:33.83,0:11:35.86,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:11:37.10,0:11:40.76,Dorama,NTP,0,0,0,,Дегенмен, бір бірінші рет бар.
Dialogue: 0,0:11:40.89,0:11:45.35,Dorama,NTP,0,0,0,,Менің өтінішімді беру
Dialogue: 0,0:11:47.44,0:11:49.32,Dorama,NTP,0,0,0,,Манипуляциялық сәтсіздік
Dialogue: 0,0:11:51.09,0:11:52.34,Dorama,NTP,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:53.42,0:11:55.08,Dorama,NTP,0,0,0,,Осыдан кейін біз басқаларға хабарлаймыз.
Dialogue: 0,0:11:56.18,0:11:59.39,Dorama,NTP,0,0,0,,Шыны қазір апатты жоғалту болып табылады.
Dialogue: 0,0:12:00.45,0:12:02.73,Dorama,NTP,0,0,0,,Қабілеттің артықтығын жоғалту
Dialogue: 0,0:12:03.28,0:12:07.19,Dorama,NTP,0,0,0,,Шыны әшекей бұйымдарын сәтті жоғалту
Dialogue: 0,0:12:09.00,0:12:10.19,Dorama,NTP,0,0,0,,Шыны...
Dialogue: 0,0:12:12.26,0:12:15.84,Dorama,NTP,0,0,0,,Мен өмірден ләззат алу қабілетімнен айырылдым.
Dialogue: 0,0:12:16.51,0:12:18.96,Dorama,NTP,0,0,0,,Джухобон бейнесі екінің бірі ме?
Dialogue: 0,0:12:19.33,0:12:21.43,Dorama,NTP,0,0,0,,Бір желкен стилі, Нада өлім ниеті
Dialogue: 0,0:12:22.10,0:12:26.36,Dorama,NTP,0,0,0,,Мен көп жерден айырылдым.
Dialogue: 0,0:12:27.08,0:12:30.68,Dorama,NTP,0,0,0,,Бетінің жоғалуы.
Dialogue: 0,0:12:32.56,0:12:35.54,Dorama,NTP,0,0,0,,Алхордың гүлдегенін көру
Dialogue: 0,0:12:41.32,0:12:43.63,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:12:44.35,0:12:45.98,Dorama,NTP,0,0,0,,Шағын басылым
Dialogue: 0,0:12:46.12,0:12:48.71,Dorama,NTP,0,0,0,,Мен қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:12:49.52,0:12:52.52,Dorama,NTP,0,0,0,,~
Dialogue: 0,0:12:53.96,0:12:56.20,Dorama,NTP,0,0,0,,Басқа адам біреумен кездеспейді.
Dialogue: 0,0:12:56.66,0:12:58.82,Dorama,NTP,0,0,0,,Мен батыстық сәнді адам емеспін.
Dialogue: 0,0:12:59.43,0:13:06.27,Dorama,NTP,0,0,0,,Өзіңіз оқуыңыз керек.
Dialogue: 0,0:13:17.19,0:13:19.21,Dorama,NTP,0,0,0,,Бірінші шақыру!
Dialogue: 0,0:13:19.37,0:13:20.55,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:13:20.70,0:13:22.53,Dorama,NTP,0,0,0,,Шағын басылым Белсенді жұлдыз сфераларының жинағы
Dialogue: 0,0:13:22.68,0:13:24.12,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:13:24.48,0:13:25.84,Dorama,NTP,0,0,0,,Шыны?
Dialogue: 0,0:00:00.00,0:00:02.50,Default,NTP,0,0,0,,Аниме
Dialogue: 0,0:13:52.67,0:13:58.28,Default,NTP,0,0,0,,Әлемнің тірі жұлдыздары туралы әңгіменің шын мәні неде?
Dialogue: 0,0:13:58.62,0:14:00.52,Default,NTP,0,0,0,,Толығырақ айтсам, мен де Ширадомын...
Dialogue: 0,0:14:00.96,0:14:03.94,Default,NTP,0,0,0,,Мен ерте құрмаға толықтай қанағаттанамын.
Dialogue: 0,0:14:04.78,0:14:06.89,Default,NTP,0,0,0,,...
Dialogue: 0,0:14:08.12,0:14:11.53,Default,NTP,0,0,0,,Енді міне теңге, Сырымнан шыққан сыр.
Dialogue: 0,0:14:16.93,0:14:19.36,Default,NTP,0,0,0,,Мен ұялшақ жынмын
Dialogue: 0,0:14:19.50,0:14:25.09,Default,NTP,0,0,0,,Зиянды бал аралары
Dialogue: 0,0:14:25.59,0:14:29.08,Default,NTP,0,0,0,,~
Dialogue: 0,0:14:30.73,0:14:31.89,Default,NTP,0,0,0,,Одан кейін Юичитен
Dialogue: 0,0:14:36.01,0:14:38.54,Default,NTP,0,0,0,,Накоре еріген метеор
Dialogue: 0,0:14:47.86,0:14:51.58,Default,NTP,0,0,0,,Тамаққа көңілім толады...
Dialogue: 0,0:14:51.83,0:14:54.26,Default,NTP,0,0,0,,Балқыту қабілеті
Dialogue: 0,0:14:54.62,0:14:55.74,Default,NTP,0,0,0,,...
Dialogue: 0,0:14:55.91,0:14:57.23,Default,NTP,0,0,0,,Ол бос емес пе?
Dialogue: 0,0:14:57.64,0:14:59.14,Default,NTP,0,0,0,,Мені құтқар!
Dialogue: 0,0:14:59.43,0:15:01.13,Default,NTP,0,0,0,,Сүйектер...
Dialogue: 0,0:15:04.06,0:15:06.48,Default,NTP,0,0,0,,Мен осындамын.
Dialogue: 0,0:15:06.64,0:15:08.28,Default,NTP,0,0,0,,~
Dialogue: 0,0:15:09.92,0:15:11.54,Default,NTP,0,0,0,,~
Dialogue: 0,0:15:13.86,0:15:16.49,Default,NTP,0,0,0,,~
Dialogue: 0,0:15:24.57,0:15:26.22,Default,NTP,0,0,0,,~
Dialogue: 0,0:15:26.55,0:15:27.03,Default,NTP,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:15:27.19,0:15:28.15,Default,NTP,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:15:28.30,0:15:29.42,Default,NTP,0,0,0,,ену
Dialogue: 0,0:15:30.24,0:15:34.24,Default,NTP,0,0,0,,Бұл менің фьюжн досым.
Dialogue: 0,0:15:34.40,0:15:35.22,Default,NTP,0,0,0,,Достық?
Dialogue: 0,0:15:35.59,0:15:37.43,Default,NTP,0,0,0,,...
Dialogue: 0,0:15:37.59,0:15:38.92,Default,NTP,0,0,0,,Рури Рури~
Dialogue: 0,0:15:41.47,0:15:43.42,Default,NTP,0,0,0,,(Жылау)
Dialogue: 0,0:15:43.58,0:15:45.49,Default,NTP,0,0,0,,Құтқарушы Умерури
Dialogue: 0,0:15:45.92,0:15:48.09,Default,NTP,0,0,0,,~ ~
Dialogue: 0,0:15:52.29,0:15:54.72,Default,NTP,0,0,0,,Кеңейту Кеңейту Кеңейту~
Dialogue: 0,0:15:59.23,0:16:02.97,Default,NTP,0,0,0,,...
Dialogue: 0,0:16:06.50,0:16:10.33,Default,NTP,0,0,0,,~
Dialogue: 0,0:16:12.84,0:16:13.80,Default,NTP,0,0,0,,Ах!
Dialogue: 0,0:16:15.33,0:16:16.05,Default,NTP,0,0,0,,Гай!
Dialogue: 0,0:16:16.18,0:16:18.10,Default,NTP,0,0,0,,...
Dialogue: 0,0:16:23.91,0:16:24.86,Default,NTP,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:16:27.03,0:16:28.73,Default,NTP,0,0,0,,Келе жатыр~
Dialogue: 0,0:16:29.63,0:16:31.28,Default,NTP,0,0,0,,...
Dialogue: 0,0:16:31.45,0:16:32.46,Default,NTP,0,0,0,,Рури Рури~
Dialogue: 0,0:16:32.61,0:16:34.39,Default,NTP,0,0,0,,...
Dialogue: 0,0:16:35.39,0:16:37.72,Default,NTP,0,0,0,,...
Dialogue: 0,0:16:38.46,0:16:42.97,Default,NTP,0,0,0,,Сіз әлемнің бұрыш ханшайымысыз!
Dialogue: 0,0:16:43.31,0:16:46.35,Default,NTP,0,0,0,,Мұз бен мұзды адамдарға көмектесу үшін пайдалану мүмкіндігіңіз бар ма?
Dialogue: 0,0:16:46.95,0:16:48.60,Default,NTP,0,0,0,,Өз ойларын қалай пайдалану керек
Dialogue: 0,0:16:48.90,0:16:52.49,Default,NTP,0,0,0,,Мен Бұрыш ханшайымымын және бұл өте қызықты!
Dialogue: 0,0:16:52.81,0:16:54.11,Default,NTP,0,0,0,,Бөлек ойлар
Dialogue: 0,0:16:54.58,0:16:59.62,Default,NTP,0,0,0,,Еріту қабілетімнен айырылып қаламын ба деп қорқамын!
Dialogue: 0,0:16:59.86,0:17:01.81,Default,NTP,0,0,0,,...
Dialogue: 0,0:17:01.97,0:17:03.18,Default,NTP,0,0,0,,Бұрыш!
Dialogue: 0,0:17:04.93,0:17:07.09,Default,NTP,0,0,0,,Бұрыш!
Dialogue: 0,0:17:08.00,0:17:10.09,Default,NTP,0,0,0,,Бұрыш бұралғысы!
Dialogue: 0,0:17:10.29,0:17:11.97,Default,NTP,0,0,0,,~
Dialogue: 0,0:17:12.79,0:17:15.91,Default,NTP,0,0,0,,...
Dialogue: 0,0:17:17.46,0:17:19.64,Default,NTP,0,0,0,,~
Dialogue: 0,0:17:24.25,0:17:27.09,Default,NTP,0,0,0,,Бұрыш жапон шөптерінің дәмі
Dialogue: 0,0:17:27.40,0:17:30.46,Default,NTP,0,0,0,,Шынайы және біртүрлі дәмді
Dialogue: 0,0:17:30.83,0:17:32.52,Default,NTP,0,0,0,,Қоңырау шалу...
Dialogue: 0,0:17:33.15,0:17:38.81,Default,NTP,0,0,0,,Кішкентай тұтынушылар үшін сарымсақ дәмі тамаша!
Dialogue: 0,0:17:39.72,0:17:42.43,Default,NTP,0,0,0,,Сарымсақ Сарымсақ Сарымсақ Сарымсақ
Dialogue: 0,0:17:42.94,0:17:44.44,Default,NTP,0,0,0,,Сарымсақ Сарымсақ Сарымсақ ~
Dialogue: 0,0:17:48.28,0:17:51.81,Default,NTP,0,0,0,,Дәмі өзгерді!
Dialogue: 0,0:17:53.53,0:17:55.98,Default,NTP,0,0,0,,Экскурсия~
Dialogue: 0,0:18:00.17,0:18:03.41,Default,NTP,0,0,0,,Сарымсақ тәрізді иіс
Dialogue: 0,0:18:05.53,0:18:08.22,Default,NTP,0,0,0,,Сергіту және сергіту~
Dialogue: 0,0:18:08.43,0:18:09.87,Default,NTP,0,0,0,,Қоңырау шалу...
Dialogue: 0,0:18:10.99,0:18:13.84,Default,NTP,0,0,0,,Жеңістің жоғалуы
Dialogue: 0,0:18:14.18,0:18:17.31,Default,NTP,0,0,0,,Жоғарғы кезең, келесі кезең!
Dialogue: 0,0:18:18.48,0:18:20.23,Default,NTP,0,0,0,,Пайда іздемеу
Dialogue: 0,0:18:24.56,0:18:29.75,Default,NTP,0,0,0,,(соғыс айқайы)
Dialogue: 0,0:20:40.66,0:20:43.78,Default,NTP,0,0,0,,(алақан дауысы)
Dialogue: 0,0:20:47.61,0:20:50.59,Default,NTP,0,0,0,,Мен оны мойындаймын.
Dialogue: 0,0:20:56.41,0:20:57.52,Default,NTP,0,0,0,,Неаполь, таңғы 11:26
Dialogue: 0,0:20:58.95,0:21:00.03,Default,NTP,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:21:02.69,0:21:05.94,Default,NTP,0,0,0,,~
Dialogue: 0,0:21:11.87,0:21:12.98,Default,NTP,0,0,0,,~
Dialogue: 0,0:21:13.21,0:21:15.43,Default,NTP,0,0,0,,Бұл сенің досың.
Dialogue: 0,0:21:17.54,0:21:19.24,Default,NTP,0,0,0,,ха ха ха
Dialogue: 0,0:21:21.64,0:21:23.14,Default,NTP,0,0,0,,Мен әсер алғаныма сенімдімін.
Dialogue: 0,0:21:23.47,0:21:28.38,Default,NTP,0,0,0,,...
Dialogue: 0,0:21:31.68,0:21:32.51,Default,NTP,0,0,0,,Бұл да рас па?
Dialogue: 0,0:21:32.90,0:21:36.98,Default,NTP,0,0,0,,Бұл стақанды дайындаудың ең жақсы тәсілі.
Dialogue: 0,0:21:37.47,0:21:42.83,Default,NTP,0,0,0,,Бұл мен байланыстырған ең танымал жұмыс және Коичиро Хаякакидің беделінің аты.
Dialogue: 0,0:21:46.25,0:21:47.54,Default,NTP,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:21:48.12,0:21:49.68,Default,NTP,0,0,0,,Аса алғыс
Dialogue: 0,0:21:49.84,0:21:50.93,Default,NTP,0,0,0,,Шыны!
Dialogue: 0,0:21:51.69,0:21:53.40,Default,NTP,0,0,0,,Сәттілік!
Dialogue: 0,0:21:53.61,0:21:54.55,Default,NTP,0,0,0,,Кёукиоу
Dialogue: 0,0:21:54.84,0:21:56.39,Default,NTP,0,0,0,,Тек сақ болыңыз. Шыны!
Dialogue: 0,0:21:56.64,0:21:57.87,Default,NTP,0,0,0,,Сәттілік!
Dialogue: 0,0:00:00.00,0:00:02.50,Default,NTP,0,0,0,,Драма
Dialogue: 0,0:22:01.65,0:22:06.46,Dorama,NTP,0,0,0,,Оқиғаның жалғасы, пьесаның жетістігі 《Өрік лөлінің лөлі лөлі Дайсакукан》 Дайсай Сүйікті әңгіме.
Dialogue: 0,0:22:07.24,0:22:08.41,Dorama,NTP,0,0,0,,Шыны?
Dialogue: 0,0:22:09.25,0:22:11.00,Dorama,NTP,0,0,0,,~
Dialogue: 0,0:22:11.23,0:22:14.03,Dorama,NTP,0,0,0,,Өткен оқиғалар жинағынан бір естелік.
Dialogue: 0,0:22:14.21,0:22:16.86,Dorama,NTP,0,0,0,,Мен жардан тура 3000 фут төменмін!
Dialogue: 0,0:22:17.65,0:22:19.65,Dorama,NTP,0,0,0,,Сіз қаланы 10 рет көрдіңіз бе?
Dialogue: 0,0:22:19.80,0:22:21.85,Dorama,NTP,0,0,0,,10 есе даналық 100 есе!
Dialogue: 0,0:22:22.01,0:22:24.68,Dorama,NTP,0,0,0,,~
Dialogue: 0,0:23:56.97,0:23:59.17,Dorama,NTP,0,0,0,,Сіз қайда барасыз?
Dialogue: 0,0:23:59.57,0:24:01.88,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:24:02.09,0:24:03.96,Dorama,NTP,0,0,0,,...
Dialogue: 0,0:24:04.28,0:24:06.91,Dorama,NTP,0,0,0,,Оның себебі, шыны – қазына.
Dialogue: 0,0:24:08.00,0:24:09.12,Dorama,NTP,0,0,0,,Кадзуки Ойкея
Dialogue: 0,0:24:09.27,0:24:10.48,Dorama,NTP,0,0,0,,Айнаға кіріңіз!
Dialogue: 0,0:24:11.52,0:24:14.70,Default,NTP,0,0,0,,Үй иесі Шимочжоу Казухи Коханавахидің арнайы сахналық шоуы
Dialogue: 0,0:24:14.83,0:24:16.28,Default,NTP,0,0,0,,Полидактилиялық гүл
Dialogue: 0,0:24:16.43,0:24:18.54,Default,NTP,0,0,0,,Бұл менің барлық күш-жігерім!
Dialogue: 0,0:24:19.07,0:24:20.93,Default,NTP,0,0,0,,Жалынды пұт шайқасы
Dialogue: 0,0:24:21.08,0:24:21.94,Default,NTP,0,0,0,,Перденің орналасуы!
Dialogue: 0,0:24:22.30,0:24:24.10,Default,NTP,0,0,0,,Жұп жұлдызды шарлардың жинағы!
Dialogue: 0,0:24:24.26,0:24:25.34,Default,NTP,0,0,0,,...
Dialogue: 0,0:00:03.31,0:00:05.24,Jp,NTP,0,0,0,,Өзіңіз қалаған адам бола алатын орын
Dialogue: 0,0:00:05.41,0:00:06.54,Jp,NTP,0,0,0,,『ｱｲｶﾂﾌﾟﾗﾈｯﾄ！』
Dialogue: 0,0:00:06.69,0:00:07.60,Jp,NTP,0,0,0,,басталады
Dialogue: 0,0:00:09.02,0:00:10.03,Jp,NTP,0,0,0,,Хэхе~
Dialogue: 0,0:00:11.39,0:00:12.63,Jp,NTP,0,0,0,,Әзірге «Икатсу!»
Dialogue: 0,0:00:13.03,0:00:15.74,Jp,NTP,0,0,0,,I Майо Отова, орта мектептің 1 курс студенті
Dialogue: 0,0:00:16.06,0:00:19.34,Jp,NTP,0,0,0,,Мен Айкату планетасында Хананы орындайтын ең жақсы кумирмін
Dialogue: 0,0:00:19.88,0:00:22.70,Jp,NTP,0,0,0,,Манами Цукиширо Купида сияқты керемет.
Dialogue: 0,0:00:22.90,0:00:25.52,Jp,NTP,0,0,0,,Айкацу планетасынан тыс жерлерде де өте танымал кумир!
Dialogue: 0,0:00:26.33,0:00:28.21,Jp,NTP,0,0,0,,Айю-чанның қатты жұмыс істеп жатқанын көру
Dialogue: 0,0:00:28.46,0:00:31.08,Jp,NTP,0,0,0,,Мен бәсекелестермен қызу және байсалды жарыстар өткізуді ұнатпаймын.
Dialogue: 0,0:00:31.24,0:00:33.26,Jp,NTP,0,0,0,,Мен оның кеспе балық екенін білдім.
Dialogue: 0,0:00:36.39,0:00:39.44,Jp,NTP,0,0,0,,Уау, понта...
Dialogue: 0,0:00:39.62,0:00:43.41,Jp,NTP,0,0,0,,Понта жұлдыздарға оралды
Dialogue: 0,0:00:43.79,0:00:46.41,Jp,NTP,0,0,0,,Қайда? Огимото-яда екен ғой.
Dialogue: 0,0:00:46.95,0:00:49.56,Jp,NTP,0,0,0,,Понта деген осы ма?
Dialogue: 0,0:00:49.88,0:00:52.40,Jp,NTP,0,0,0,,Өткен жылы қызу талқыға түскен шетел драмасы?
Dialogue: 0,0:00:52.57,0:00:54.34,Jp,NTP,0,0,0,,«Жұлдыздардан келген саған» дейсің бе?
Dialogue: 0,0:00:54.69,0:00:56.68,Jp,NTP,0,0,0,,Мен ит деп ойлаған үй жануарым шынымен
Dialogue: 0,0:00:56.86,0:01:00.08,Jp,NTP,0,0,0,,Жерге келін іздеп келген ғарыш раконы болған деседі.
Dialogue: 0,0:01:00.27,0:01:03.38,Jp,NTP,0,0,0,,Жан түршіктірер оқиғаға бүкіл әлем үнсіз қалды.
Dialogue: 0,0:01:03.69,0:01:04.62,Jp,NTP,0,0,0,,Иә?
Dialogue: 0,0:01:05.04,0:01:08.65,Jp,NTP,0,0,0,,Барма, Понта~!
Dialogue: 0,0:01:14.64,0:01:17.80,Jp,NTP,0,0,0,,Рури-чан мені сонша жылатқан драма емес еді
Dialogue: 0,0:01:17.88,0:01:21.69,Jp,NTP,0,0,0,,Хмм, мен жақсы емеспін.
Dialogue: 0,0:01:22.05,0:01:25.95,Jp,NTP,0,0,0,,Мен жылататын драмалар мен фильмдерді есіме түсірдім.
Dialogue: 0,0:01:26.18,0:01:28.79,Jp,NTP,0,0,0,,Көз жасы бездерінің ыдырауы және ағуы
Dialogue: 0,0:01:28.96,0:01:31.39,Jp,NTP,0,0,0,,Болады, бірақ көрдің бе?
Dialogue: 0,0:01:32.30,0:01:35.12,Jp,NTP,0,0,0,,Өйткені, тыңда, білесің.
Dialogue: 0,0:03:15.51,0:03:16.39,Jp,NTP,0,0,0,,Не?
Dialogue: 0,0:03:16.80,0:03:19.77,Jp,NTP,0,0,0,,MELTY HOUSE веб-журналы бүгін жаңартылды ма?
Dialogue: 0,0:03:19.92,0:03:21.53,Jp,NTP,0,0,0,,Меллидің жаңа түстері де шығарылды.
Dialogue: 0,0:03:22.20,0:03:23.15,Jp,NTP,0,0,0,,ﾒﾙﾘ？
Dialogue: 0,0:03:23.31,0:03:26.79,Jp,NTP,0,0,0,,Қазіргі уақытта қыздар арасында MELTY HOUSE брендінің тұмары өте танымал.
Dialogue: 0,0:03:27.12,0:03:29.56,Jp,NTP,0,0,0,,Әр маусымда әртүрлі түсті мелис пайда болады.
Dialogue: 0,0:03:29.84,0:03:32.28,Jp,NTP,0,0,0,,Ынталы жанкүйерлер саны тез өсуде!
Dialogue: 0,0:03:32.43,0:03:37.65,Jp,NTP,0,0,0,,Сыбыстарға сәйкес, басты кейіпкер ретінде Мерли ойнайтын таңғы сериалды веб-драма болады.
Dialogue: 0,0:03:38.69,0:03:41.28,Jp,NTP,0,0,0,,Иә? А, сен білмейсің бе?
Dialogue: 0,0:03:41.43,0:03:43.44,Jp,NTP,0,0,0,,Не? Жоқ, бұл мерли, солай ма?
Dialogue: 0,0:03:43.99,0:03:50.91,Jp,NTP,0,0,0,,-де мен Меллидің драмалық сериясы үшін оқиға идеясын ойлап табуды шештім.
Dialogue: 0,0:03:51.54,0:03:52.63,Jp,NTP,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:03:54.14,0:03:56.27,Jp,NTP,0,0,0,,Сюжетті нобай дегеніміз не?
Dialogue: 0,0:03:57.77,0:03:59.46,Jp,NTP,0,0,0,,Әңгіменің негізі
Dialogue: 0,0:03:59.74,0:04:03.63,Jp,NTP,0,0,0,,Келесі драманың қызықты болуы немесе болмауы Рури-чанның бастапқы идеясына байланысты.
Dialogue: 0,0:04:06.00,0:04:08.01,Jp,NTP,0,0,0,,Сол зерттеу үшін
Dialogue: 0,0:04:08.17,0:04:11.42,Jp,NTP,0,0,0,,Түрлі шығармаларды, соның ішінде сізді жылататын драмаларды көргіңіз келе ме?
Dialogue: 0,0:04:11.57,0:04:14.65,Jp,NTP,0,0,0,,Мен оның ең жақсы драма болғанын қалаймын.
Dialogue: 0,0:04:15.80,0:04:19.39,Jp,NTP,0,0,0,,Уау, Понта!
Dialogue: 0,0:04:22.46,0:04:24.26,Jp,NTP,0,0,0,,Бұл Соичиро Хаякаки.
Dialogue: 0,0:04:24.54,0:04:31.39,Jp,NTP,0,0,0,,Хаякаки соңғы кездері теледидар мен фильмдерде танымал шығармалар сериясын түсіріп жүрген сценарист пе?
Dialogue: 0,0:04:31.63,0:04:33.74,Jp,NTP,0,0,0,,Иә, алдағы Мелли драмасында.
Dialogue: 0,0:04:33.90,0:04:36.16,Jp,NTP,0,0,0,,Ол Руридің бастапқы идеясын сценарийге айналдыруды ұйғарды.
Dialogue: 0,0:04:36.32,0:04:38.35,Jp,NTP,0,0,0,,Бұл сөзсіз үлкен хит.
Dialogue: 0,0:04:38.51,0:04:41.82,Jp,NTP,0,0,0,,Сәл күте тұрыңыз, Сегава!
Dialogue: 0,0:04:43.64,0:04:46.81,Jp,NTP,0,0,0,,Шобори-н моримори-гугу~ болды
Dialogue: 0,0:04:47.40,0:04:49.17,Jp,NTP,0,0,0,,Өте жұмсақ!
Dialogue: 0,0:04:49.32,0:04:55.70,Jp,NTP,0,0,0,,Повайонни Маруторонни Джоваде
Dialogue: 0,0:04:55.86,0:04:57.85,Jp,NTP,0,0,0,,Ахахаха
Dialogue: 0,0:04:59.30,0:05:00.51,Jp,NTP,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:05:02.24,0:05:03.28,Jp,NTP,0,0,0,,Иә?
Dialogue: 0,0:05:06.35,0:05:07.46,Jp,NTP,0,0,0,,Жоқ…
Dialogue: 0,0:05:08.92,0:05:14.61,Jp,NTP,0,0,0,,Бұл сіздің ойыңыздағы драманың түпнұсқа жобасы ма?
Dialogue: 0,0:05:16.37,0:05:21.01,Jp,NTP,0,0,0,,Менің ойымша, бұл аһ, егер ол өтпейді ...
Dialogue: 0,0:05:23.07,0:05:24.31,Jp,NTP,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:25.09,0:05:27.51,Jp,NTP,0,0,0,,Мен қателесіппін
Dialogue: 0,0:05:31.12,0:05:33.38,Jp,NTP,0,0,0,,Джова, солай емес пе?
Dialogue: 0,0:05:33.94,0:05:35.39,Jp,NTP,0,0,0,,Бұл суффа~, солай емес пе?
Dialogue: 0,0:05:35.53,0:05:36.35,Jp,NTP,0,0,0,,Иә?
Dialogue: 0,0:05:37.84,0:05:44.89,Jp,NTP,0,0,0,,Сооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо
Dialogue: 0,0:05:46.62,0:05:49.13,Jp,NTP,0,0,0,,Мерлі күшті бала, сондықтан жыламайды.
Dialogue: 0,0:05:49.86,0:05:51.63,Jp,NTP,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:05:53.60,0:05:55.33,Jp,NTP,0,0,0,,Бірақ мен...
Dialogue: 0,0:05:56.80,0:05:59.15,Jp,NTP,0,0,0,,Он көлеңке техникасы
Dialogue: 0,0:05:59.31,0:06:00.46,Jp,NTP,0,0,0,,Қайда? Огимото-яда екен ғой.
Dialogue: 0,0:06:00.62,0:06:03.76,Jp,NTP,0,0,0,,Барма, Понта!
Dialogue: 0,0:06:03.93,0:06:07.84,Jp,NTP,0,0,0,,Понта? Кешіріңіз
Dialogue: 0,0:06:13.77,0:06:14.91,Jp,NTP,0,0,0,,Ум...
Dialogue: 0,0:06:16.70,0:06:25.94,Jp,NTP,0,0,0,,Мен үшін Рури Тамакидің бастапқы драмалық идеясын сценарийге бейімдеу тым көп ауыртпалық сияқты.
Dialogue: 0,0:06:26.63,0:06:29.16,Jp,NTP,0,0,0,,Сіз бас тарта аласыз ба?
Dialogue: 0,0:06:29.99,0:06:30.46,Jp,NTP,0,0,0,,Иә?
Dialogue: 0,0:06:31.15,0:06:32.56,Jp,NTP,0,0,0,,Эх!
Dialogue: 0,0:06:33.59,0:06:37.66,Jp,NTP,0,0,0,,Кеше мен көп нәрсені ойладым.
Dialogue: 0,0:06:37.87,0:06:39.59,Jp,NTP,0,0,0,,Мен сізге айту үшін барымды салдым, бірақ
Dialogue: 0,0:06:39.78,0:06:44.44,Jp,NTP,0,0,0,,Барлығы Хаякаки-сан кетсе, бұл драма міндетті түрде сәтсіздікке ұшырайды дейді.
Dialogue: 0,0:06:44.82,0:06:48.57,Jp,NTP,0,0,0,,Міндетті түрде сәтсіздікке ұшырайтынымды естігенде, одан бетер қызып кеттім!
Dialogue: 0,0:06:49.13,0:06:51.54,Jp,NTP,0,0,0,,Сәлем, қарап жібере аласыз ба?
Dialogue: 0,0:06:51.92,0:06:56.46,Jp,NTP,0,0,0,,Мен Хаякаки мырзаға не істегім келетінін неге айта алмағанымды білгім келеді.
Dialogue: 0,0:06:57.72,0:07:02.40,Jp,NTP,0,0,0,,...
Dialogue: 0,0:07:04.08,0:07:05.17,Jp,NTP,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:07:06.66,0:07:09.83,Jp,NTP,0,0,0,,Хмм, дұрыс.
Dialogue: 0,0:07:10.64,0:07:13.22,Jp,NTP,0,0,0,,Мысалы, бүгінгі Пиороро~
Dialogue: 0,0:07:13.44,0:07:15.64,Jp,NTP,0,0,0,,Екеуің не ойладыңдар?
Dialogue: 0,0:07:15.80,0:07:20.11,Jp,NTP,0,0,0,,Не? Ах, мм...
Dialogue: 0,0:07:20.72,0:07:23.70,Jp,NTP,0,0,0,,Бұл елес пе?
Dialogue: 0,0:07:24.33,0:07:27.59,Jp,NTP,0,0,0,,Пиророн Пиророн
Dialogue: 0,0:07:30.39,0:07:33.65,Jp,NTP,0,0,0,,Мен бұрыннан қалыптасқан жапондық кондитерлік дүкеннен атақты тәттіні сатып алдым.
Dialogue: 0,0:07:33.81,0:07:35.62,Jp,NTP,0,0,0,,Хмм, жоқ.
Dialogue: 0,0:07:35.90,0:07:41.22,Jp,NTP,0,0,0,,Пиророн – Меллидің жүрегінің тереңінде жасырылған жанының айқайы.
Dialogue: 0,0:07:42.20,0:07:47.10,Jp,NTP,0,0,0,,Өз сезімдеріңізді осылай білдіру өте қиын.
Dialogue: 0,0:07:47.49,0:07:49.72,Jp,NTP,0,0,0,,Мен көремін.
Dialogue: 0,0:07:51.43,0:07:53.51,Jp,NTP,0,0,0,,Сонымен не істеуім керек?
Dialogue: 0,0:07:54.43,0:07:58.00,Jp,NTP,0,0,0,,Ең жақсысы - мағынасы бар...
Dialogue: 0,0:07:58.18,0:07:59.37,Jp,NTP,0,0,0,,Иә?
Dialogue: 0,0:07:59.92,0:08:02.93,Jp,NTP,0,0,0,,Оны сабақтас сөйлемдермен жеткізу керек деп ойлаймын.
Dialogue: 0,0:08:03.20,0:08:04.50,Jp,NTP,0,0,0,,Ммм
Dialogue: 0,0:08:04.81,0:08:07.67,Jp,NTP,0,0,0,,Мен мұндай нәрсеге жақсы емеспін.
Dialogue: 0,0:08:08.92,0:08:11.68,Jp,NTP,0,0,0,,Сонда мен бас тартуым керек пе?
Dialogue: 0,0:08:12.01,0:08:13.14,Jp,NTP,0,0,0,,Мүмкін емес!
Dialogue: 0,0:08:14.00,0:08:16.58,Jp,NTP,0,0,0,,Сонда арнайы дайындық жалғыз нұсқа, солай емес пе?
Dialogue: 0,0:08:21.39,0:08:23.44,Jp,NTP,0,0,0,,Бұл жан-жақты сезіледі.
Dialogue: 0,0:08:23.92,0:08:27.25,Jp,NTP,0,0,0,,Бұл дөңгелек нәрсе қиын ба?
Dialogue: 0,0:08:27.95,0:08:31.62,Jp,NTP,0,0,0,,Мм... жұмсақ
Dialogue: 0,0:08:33.15,0:08:33.99,Jp,NTP,0,0,0,,Қандай түс?
Dialogue: 0,0:08:34.15,0:08:37.43,Jp,NTP,0,0,0,,Көп нәрсе бар, бірақ маған ақ түсті ұнайды.
Dialogue: 0,0:08:38.79,0:08:39.55,Jp,NTP,0,0,0,,Хош иіс туралы не деуге болады?
Dialogue: 0,0:08:39.75,0:08:42.93,Jp,NTP,0,0,0,,Жақсы иіс, сәл тәтті
Dialogue: 0,0:08:43.19,0:08:44.13,Jp,NTP,0,0,0,,Оның дәмі қандай?
Dialogue: 0,0:08:44.61,0:08:47.70,Jp,NTP,0,0,0,,Аузыңызда ериді
Dialogue: 0,0:08:49.43,0:08:51.40,Jp,NTP,0,0,0,,Жарайды, балмұздақ!
Dialogue: 0,0:08:51.56,0:08:52.53,Jp,NTP,0,0,0,,ﾋﾟﾝﾎﾟﾝ！
Dialogue: 0,0:08:52.76,0:08:54.59,Jp,NTP,0,0,0,,Мен жасадым. Мен оны түсіндім.
Dialogue: 0,0:08:54.96,0:08:58.93,Jp,NTP,0,0,0,,Маған әр мүмкіндікті мұқият үйреткені үшін Рури-чанға рахмет.
Dialogue: 0,0:09:00.41,0:09:05.31,Jp,NTP,0,0,0,,Енді сіз маған Мерли туралы қазіргідей айтып бере аласыз ба?
Dialogue: 0,0:09:05.91,0:09:10.98,Jp,NTP,0,0,0,,Иә, Мерли өте күшті қыз...
Dialogue: 0,0:09:11.11,0:09:12.28,Jp,NTP,0,0,0,,Ол қаншалықты күшті?
Dialogue: 0,0:09:12.46,0:09:14.11,Jp,NTP,0,0,0,,Бала...
Dialogue: 0,0:09:15.69,0:09:17.29,Jp,NTP,0,0,0,,Жоқ
Dialogue: 0,0:09:19.00,0:09:25.79,Jp,NTP,0,0,0,,Арқамды итеріп, оңтүстік желдей
Dialogue: 0,0:09:27.27,0:09:32.46,Jp,NTP,0,0,0,,Сізге батылдық пен қуат беретін адам ма?
Dialogue: 0,0:09:33.58,0:09:35.04,Jp,NTP,0,0,0,,Бұл өте жақсы сезінеді.
Dialogue: 0,0:09:35.49,0:09:37.46,Jp,NTP,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:09:39.28,0:09:44.38,Jp,NTP,0,0,0,,Содан кейін, Шиориді сценарийші ретінде қарастырыңыз.
Dialogue: 0,0:09:44.93,0:09:46.86,Jp,NTP,0,0,0,,Не, мен?
Dialogue: 0,0:09:48.79,0:09:51.91,Jp,NTP,0,0,0,,Бұл Меллидің өз күшімен байланысты.
Dialogue: 0,0:09:52.56,0:09:56.41,Jp,NTP,0,0,0,,Аутентификацияланған...
Dialogue: 0,0:09:56.85,0:10:03.46,Jp,NTP,0,0,0,,Айналамыздағылардың ортақ пікіріне қол жеткізетінімізге сенімдімін.
Dialogue: 0,0:10:03.79,0:10:05.93,Jp,NTP,0,0,0,,Міне, келесі сұрақ.
Dialogue: 0,0:10:08.21,0:10:10.73,Jp,NTP,0,0,0,,Осы Мелли драмасы арқылы сіз
Dialogue: 0,0:10:11.23,0:10:13.46,Jp,NTP,0,0,0,,Нені жеткізгіңіз келеді?
Dialogue: 0,0:10:14.01,0:10:18.59,Jp,NTP,0,0,0,,Иә, оның жеке басының негізі неде?
Dialogue: 0,0:10:19.13,0:10:30.09,Jp,NTP,0,0,0,,Бір мезгілде әрі аю, әрі тұлып болудың екіұшты психикалық құрылымына негізделген...
Dialogue: 0,0:10:30.97,0:10:32.33,Jp,NTP,0,0,0,,Рури-чан?
Dialogue: 0,0:10:35.26,0:10:38.18,Jp,NTP,0,0,0,,Сіз тым көп ойланып, даналық қызбаңыз бар ма?
Dialogue: 0,0:10:38.38,0:10:39.23,Jp,NTP,0,0,0,,Жақсысың ба?
Dialogue: 0,0:10:39.38,0:10:40.18,Jp,NTP,0,0,0,,Рури-чан
Dialogue: 0,0:10:59.23,0:11:00.54,Jp,NTP,0,0,0,,Шиори-чан?
Dialogue: 0,0:11:00.70,0:11:03.76,Jp,NTP,0,0,0,,Рури-чан, жақсысың ба?
Dialogue: 0,0:11:04.40,0:11:07.55,Jp,NTP,0,0,0,,Майо-чан және басқалары Хана мен Битте жұмыс істей ме?
Dialogue: 0,0:11:07.90,0:11:08.99,Jp,NTP,0,0,0,,Иә
Dialogue: 0,0:11:10.71,0:11:12.74,Jp,NTP,0,0,0,,Жарылып кете жаздады
Dialogue: 0,0:11:18.07,0:11:19.07,Jp,NTP,0,0,0,,Неліктен?
Dialogue: 0,0:11:20.31,0:11:25.86,Jp,NTP,0,0,0,,Мен сенің міндетті түрде сәтсіздікке ұшырайтыныңды естігенде, одан бетер қызып кеттің.
Dialogue: 0,0:11:27.74,0:11:32.29,Jp,NTP,0,0,0,,Мен кішкентай кезімнен модельдікпен айналыстым.
Dialogue: 0,0:11:32.45,0:11:33.61,Jp,NTP,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:11:33.83,0:11:35.86,Jp,NTP,0,0,0,,Иә, керемет
Dialogue: 0,0:11:37.10,0:11:40.76,Jp,NTP,0,0,0,,Бірақ іс жүзінде бір рет.
Dialogue: 0,0:11:40.89,0:11:45.35,Jp,NTP,0,0,0,,Мен бірде анам мен әкеме оны тоқтатуын өтіндім.
Dialogue: 0,0:11:47.44,0:11:49.32,Jp,NTP,0,0,0,,Жұмыста сәтсіздікке ұшырады
Dialogue: 0,0:11:51.09,0:11:52.34,Jp,NTP,0,0,0,,Мен қорқып кеттім
Dialogue: 0,0:11:53.42,0:11:55.08,Jp,NTP,0,0,0,,Содан кейін ол маған айтты
Dialogue: 0,0:11:56.18,0:11:59.39,Jp,NTP,0,0,0,,Рури бүгін үлкен қателік жасады.
Dialogue: 0,0:12:00.45,0:12:02.73,Jp,NTP,0,0,0,,Егер біз мұны жеңе алсақ
Dialogue: 0,0:12:03.28,0:12:07.19,Jp,NTP,0,0,0,,Бұл сәтсіздік Рури үшін қазынаға айналады.
Dialogue: 0,0:12:09.00,0:12:10.19,Jp,NTP,0,0,0,,Рури-чан...
Dialogue: 0,0:12:12.26,0:12:15.84,Jp,NTP,0,0,0,,Содан кейін мен сәтсіздікке ұшырадым.
Dialogue: 0,0:12:16.51,0:12:18.96,Jp,NTP,0,0,0,,Бұл қазына жинау сияқты, солай ма?
Dialogue: 0,0:12:19.33,0:12:21.43,Jp,NTP,0,0,0,,Сәтсіздікке жол бермеу ысырап болар еді
Dialogue: 0,0:12:22.10,0:12:26.36,Jp,NTP,0,0,0,,Мен көп қателік жібердім және оны бар күшіммен жеңдім.
Dialogue: 0,0:12:27.08,0:12:30.68,Jp,NTP,0,0,0,,Бұдан басқа, сіз күлімдеген жүздерді кездестіресіз
Dialogue: 0,0:12:32.56,0:12:35.54,Jp,NTP,0,0,0,,Мен оны Мерлиге де көрсеткім келеді.
Dialogue: 0,0:12:41.32,0:12:43.63,Jp,NTP,0,0,0,,Рақмет саған Рури
Dialogue: 0,0:12:44.35,0:12:45.98,Jp,NTP,0,0,0,,Шиори-чан
Dialogue: 0,0:12:46.12,0:12:48.71,Jp,NTP,0,0,0,,Мен үшін көп еңбек еткеніңіз үшін рахмет.
Dialogue: 0,0:12:49.52,0:12:52.52,Jp,NTP,0,0,0,,Әй, мен су перісі болсам ғой.
Dialogue: 0,0:12:53.96,0:12:56.20,Jp,NTP,0,0,0,,Gyowawawa~ хабарды жеткізбейді
Dialogue: 0,0:12:56.66,0:12:58.82,Jp,NTP,0,0,0,,Мен логикалық нәрселерде жақсы емеспін.
Dialogue: 0,0:12:59.43,0:13:06.27,Jp,NTP,0,0,0,,Бірақ бұл Мерридің сөзі болса, сіз туралы болар еді...
Dialogue: 0,0:13:17.19,0:13:19.21,Jp,NTP,0,0,0,,Түсіндім, сен солай істедің!
Dialogue: 0,0:13:19.37,0:13:20.55,Jp,NTP,0,0,0,,Қу жеді!
Dialogue: 0,0:13:20.70,0:13:22.53,Jp,NTP,0,0,0,,Шиори-чан, Айкату планетасында кездесу
Dialogue: 0,0:13:22.68,0:13:24.12,Jp,NTP,0,0,0,,Майо-чанмен және басқалармен бірге
Dialogue: 0,0:13:24.48,0:13:25.84,Jp,NTP,0,0,0,,Рури-чан?
Dialogue: 0,0:22:01.65,0:22:06.46,Jp,NTP,0,0,0,,Осылайша аяқталған веб-драма, ``Мерлидің Лулили Дайсакусені» өте танымал болды.
Dialogue: 0,0:22:07.24,0:22:08.41,Jp,NTP,0,0,0,,Рури-чан, ғажап емес пе?
Dialogue: 0,0:22:09.25,0:22:11.00,Jp,NTP,0,0,0,,Қайда? Огимото-яда екен ғой.
Dialogue: 0,0:22:11.23,0:22:14.03,Jp,NTP,0,0,0,,«Лурилли Дайсакусеннің» кешегі эфирі есіңізде болса
Dialogue: 0,0:22:14.21,0:22:16.86,Jp,NTP,0,0,0,,Менің жас бездерім шөгіп, ағып жатыр!
Dialogue: 0,0:22:17.65,0:22:19.65,Jp,NTP,0,0,0,,Сен оны он рет көрмедің бе?
Dialogue: 0,0:22:19.80,0:22:21.85,Jp,NTP,0,0,0,,10 есе емес, 100 есе!
Dialogue: 0,0:22:22.01,0:22:24.68,Jp,NTP,0,0,0,,Қайда? Огимото-яда екен ғой.
Dialogue: 0,0:23:56.97,0:23:59.17,Jp,NTP,0,0,0,,Майо-чан, бұл ненің тербелісі?
Dialogue: 0,0:23:59.57,0:24:01.88,Jp,NTP,0,0,0,,Бұл Жарқын сапфир деп аталады.
Dialogue: 0,0:24:02.09,0:24:03.96,Jp,NTP,0,0,0,,Уау, сондай сүйкімді
Dialogue: 0,0:24:04.28,0:24:06.91,Jp,NTP,0,0,0,,Өйткені Рури-чанның әткеншегі маңызды.
Dialogue: 0,0:24:08.00,0:24:09.12,Jp,NTP,0,0,0,,Барлығы бірге
Dialogue: 0,0:24:09.27,0:24:10.48,Jp,NTP,0,0,0,,ﾐﾗｰｲﾝ！
Dialogue: 0,0:18:50.73,0:18:55.71,LIVE,NTP,0,0,0,,Көрген сайын күлімсіреу, пайда болатын сергектік
Dialogue: 0,0:18:55.71,0:19:01.24,LIVE,NTP,0,0,0,,Бұл адам пұт.
Dialogue: 0,0:19:01.24,0:19:06.98,LIVE,NTP,0,0,0,,Жүректің секіруінің үдеуі
Dialogue: 0,0:19:06.98,0:19:12.32,LIVE,NTP,0,0,0,,Адамдардың жүрегінің ортасында ой қалыптасады.
Dialogue: 0,0:19:12.32,0:19:17.36,LIVE,NTP,0,0,0,,Арманда! *Күліп тұрған жүз!
Dialogue: 0,0:19:17.36,0:19:25.44,LIVE,NTP,0,0,0,,Абайсыз, кешірімсіз шоу кезеңі♪
Dialogue: 0,0:19:25.44,0:19:28.50,LIVE,NTP,0,0,0,,Әдемі жел шығады
Dialogue: 0,0:19:28.50,0:19:31.31,LIVE,NTP,0,0,0,,Үміттің шығуы және үміттің шығуы
Dialogue: 0,0:19:31.31,0:19:36.35,LIVE,NTP,0,0,0,,Жеткізу компаниясының ашулы күлкісі!
Dialogue: 0,0:19:36.35,0:19:42.19,LIVE,NTP,0,0,0,,Дағдарысты секіріп, өзгертуге мүмкіндік!
Dialogue: 0,0:19:42.19,0:19:49.06,LIVE,NTP,0,0,0,,Бекіту кездесуі әрі қарай оқу Маған сіздің кумирлік белсенділік ұнайды!
Dialogue: 0,0:19:59.34,0:20:02.61,LIVE,NTP,0,0,0,,Біздің үй иелерінің әрқайсысы
Dialogue: 0,0:20:02.61,0:20:05.21,LIVE,NTP,0,0,0,,Табысты адамдардың кумирлік әңгімелері
Dialogue: 0,0:20:05.21,0:20:10.18,LIVE,NTP,0,0,0,,Бекіту кездесуі Саракаджи Би Миоба
Dialogue: 0,0:20:10.18,0:20:16.09,LIVE,NTP,0,0,0,,Аспаннан жел тұрады.
Dialogue: 0,0:20:16.09,0:20:22.96,LIVE,NTP,0,0,0,,Болашақта кумирлік белсенділік!
Dialogue: 0,0:20:35.97,0:20:38.34,LIVE,NTP,0,0,0,,...
Dialogue: 0,0:18:50.73,0:18:55.71,LIVE_JP,NTP,0,0,0,,Сенің күлкіңді көрген сайын мен өзімді жақсы сезінемін
Dialogue: 0,0:18:55.71,0:19:01.24,LIVE_JP,NTP,0,0,0,,Мүмкін мұндай адам кумир шығар?
Dialogue: 0,0:19:01.24,0:19:06.98,LIVE_JP,NTP,0,0,0,,Жүрегім дүрсілдеп, көзімді алмаймын
Dialogue: 0,0:19:06.98,0:19:12.32,LIVE_JP,NTP,0,0,0,,Мен біреудің жарқыраған жұлдызын нысанаға алғым келеді
Dialogue: 0,0:19:12.32,0:19:17.36,LIVE_JP,NTP,0,0,0,,Армандау! Блуми＊ Күлкі Иә!
Dialogue: 0,0:19:17.36,0:19:25.44,LIVE_JP,NTP,0,0,0,,Күнделікті сахнаны қызықты тербеліспен жасаңыз♪
Dialogue: 0,0:19:25.44,0:19:28.50,LIVE_JP,NTP,0,0,0,,Мен Сақина Сақина Сақинаның бір күні гүлдегенін қалаймын
Dialogue: 0,0:19:28.50,0:19:31.31,LIVE_JP,NTP,0,0,0,,Секіру секіру Секіру Гүлденеді деп үміттенемін
Dialogue: 0,0:19:31.31,0:19:36.35,LIVE_JP,NTP,0,0,0,,Мен саған гүлденген бақытты жібергім келеді (Сен үшін! Блуми＊Күлімде)
Dialogue: 0,0:19:36.35,0:19:42.19,LIVE_JP,NTP,0,0,0,,Кеттік Би билей билей Қиын болсаң да, мүмкіндікті пайдалан!
Dialogue: 0,0:19:42.19,0:19:49.06,LIVE_JP,NTP,0,0,0,,Ол одан да жарқырайды, сондықтан қарауды жалғастырыңыз! Барайық! Айкатсу!
Dialogue: 0,0:19:59.34,0:20:02.61,LIVE_JP,NTP,0,0,0,,Олардың әрқайсысы
Dialogue: 0,0:20:02.61,0:20:05.21,LIVE_JP,NTP,0,0,0,,Біреудің кумирі бола алсам
Dialogue: 0,0:20:05.21,0:20:10.18,LIVE_JP,NTP,0,0,0,,Бұл керемет болуы керек (Мен үшін! Блуми＊күлімсіреу)
Dialogue: 0,0:20:10.18,0:20:16.09,LIVE_JP,NTP,0,0,0,,Хилари жүгіру Жүгіру Жүгіру Желге мініп, бірге жүземіз
Dialogue: 0,0:20:16.09,0:20:22.96,LIVE_JP,NTP,0,0,0,,Одан да жарқырағым келеді Болашаққа аттанайық! Айкатсу!
Dialogue: 0,0:20:35.97,0:20:38.34,LIVE_JP,NTP,0,0,0,,(*Күлкі*)
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,---------------------------------------------------------------------------------------------------------------------
Dialogue: 1,0:01:52.27,0:01:57.34,OP,NTP,0,0,0,,Көрген сайын күлкі, Кездесуден шыққан жігер
Dialogue: 0,0:01:52.27,0:01:57.34,OP,NTP,0,0,0,,Көрген сайын күлімсіреу, пайда болатын сергектік
