Dialogue: 0,0:03:28.80,0:03:35.77,Default,,0,0,0,,Аспанға қарап, басталуды хабарлайтын таңның кобальт көкі
Dialogue: 0,0:03:36.28,0:03:43.22,Default,,0,0,0,,Жер-Анаға қадам басу Иночи толқындарын сезіну
Dialogue: 0,0:03:43.89,0:03:46.60,Default,,0,0,0,,Күн мен жел ырғағы
Dialogue: 0,0:03:46.75,0:03:50.96,Default,,0,0,0,,Жан соғуын үндестіргеннен кейін
Dialogue: 0,0:03:51.43,0:03:58.16,Default,,0,0,0,,Бүгінгі беймәлімге ұшқан қанаттардың әні шырқалады
Dialogue: 0,0:03:58.45,0:04:01.58,Default,,0,0,0,,Мүмкін, Мүмкін Бұл біреудің дауысы емес
Dialogue: 0,0:04:02.19,0:04:05.58,Default,,0,0,0,,Тек менің ішкі дауысыма
Dialogue: 0,0:04:05.94,0:04:13.08,Default,,0,0,0,,Мен таза ақылмен өмір сүргім келеді.
Dialogue: 0,0:04:15.26,0:04:17.04,Default,,0,0,0,,Сіз өзіңіздің ішкі дауысыңызды сезіне аласыз ба?
Dialogue: 0,0:04:17.19,0:04:18.95,Default,,0,0,0,,Шынын айтсам құштарлықпен
Dialogue: 0,0:04:19.12,0:04:20.64,Default,,0,0,0,,Қазір билеймін ＆ Қазір ән айтамын
Dialogue: 0,0:04:20.81,0:04:22.58,Default,,0,0,0,,Би билейік
Dialogue: 0,0:04:22.87,0:04:26.45,Default,,0,0,0,,Әр адам өз тағдырының басты тұлғасы
Dialogue: 0,0:04:26.62,0:04:30.08,Default,,0,0,0,,Жарқыраған әуенді киіп
Dialogue: 0,0:04:30.33,0:04:32.10,Default,,0,0,0,,Мен өзімнің ішкі дауысымды сезінемін
Dialogue: 0,0:04:32.27,0:04:33.97,Default,,0,0,0,,Гүлдер жайнаған
Dialogue: 0,0:04:34.13,0:04:39.51,Default,,0,0,0,,Төгілген жаңа тамшылар жеңіл секіреді.
Dialogue: 0,0:04:39.68,0:04:45.04,Default,,0,0,0,,Бұрын-соңды болмаған ұлы мұхитқа қосылу
Dialogue: 0,0:04:45.62,0:04:49.06,Default,,0,0,0,,Кикоэру Кикоэруё Кибо Джиюу Мираи
Dialogue: 0,0:04:49.25,0:04:52.53,Default,,0,0,0,,Мен неге сенсем де...
Dialogue: 0,0:04:52.98,0:04:56.62,Default,,0,0,0,,Жалғыздық пен оның бәрінен жоғары жарқырау
Dialogue: 0,0:04:56.82,0:04:58.20,Default,,0,0,0,,Сіз білетініңізге сенімдімін.
Dialogue: 0,0:04:58.38,0:05:00.09,Default,,0,0,0,,Мен арманды орындаймын
Dialogue: 0,0:03:28.80,0:03:35.77,Default,,0,0,0,,Декларацияның таңында аспан шатырға көтеріледі.
Dialogue: 0,0:03:36.28,0:03:43.22,Default,,0,0,0,,Жердегі тіршілік толқындарын сезіну
Dialogue: 0,0:03:43.89,0:03:46.60,Default,,0,0,0,,Күн мен жел әуені
Dialogue: 0,0:03:46.75,0:03:50.96,Default,,0,0,0,,Барлық жан соғады
Dialogue: 0,0:03:51.43,0:03:58.16,Default,,0,0,0,,Ұшып барады белгісізге бүгін, Қанатты әнмен
Dialogue: 0,0:03:58.45,0:04:01.58,Default,,0,0,0,,Нами - басқа адамның ән айтатын дауысы
Dialogue: 0,0:04:02.19,0:04:05.58,Default,,0,0,0,,Жай ғана жеке дауыс
Dialogue: 0,0:04:05.94,0:04:13.08,Default,,0,0,0,,Жүрегімнің қолбасшысы
Dialogue: 0,0:04:15.26,0:04:17.04,Default,,0,0,0,,Жүрегіңізге жете аласыз ба?
Dialogue: 0,0:04:17.19,0:04:18.95,Default,,0,0,0,,Құмарлы жер
Dialogue: 0,0:04:19.12,0:04:20.64,Default,,0,0,0,,Секіру, ән айту
Dialogue: 0,0:04:20.81,0:04:22.58,Default,,0,0,0,,Оян
Dialogue: 0,0:04:22.87,0:04:26.45,Default,,0,0,0,,Әр адамның өз өмірін басқару жоспары бар.
Dialogue: 0,0:04:26.62,0:04:30.08,Default,,0,0,0,,сүйемелдейтін нұрлы әуен
Dialogue: 0,0:04:30.33,0:04:32.10,Default,,0,0,0,,Жүрегімнің үні
Dialogue: 0,0:04:32.27,0:04:33.97,Default,,0,0,0,,Сейхана Сейзай ашуланады
Dialogue: 0,0:04:34.13,0:04:39.51,Default,,0,0,0,,Тағы да жаңбыр жауа бастайды.
Dialogue: 0,0:04:39.68,0:04:45.04,Default,,0,0,0,,Бұрын-соңды болмаған жаңбыр суы бар мұхит
Dialogue: 0,0:04:45.62,0:04:49.06,Default,,0,0,0,,Бостандықтың болашағына үміттенеміз
Dialogue: 0,0:04:49.25,0:04:52.53,Default,,0,0,0,,Мен қай уақытта сене бастадым...
Dialogue: 0,0:04:52.98,0:04:56.62,Default,,0,0,0,,Жалғыздық және жақсы жарық
Dialogue: 0,0:04:56.82,0:04:58.20,Default,,0,0,0,,Жеткен бойда жүрегімді білдім
Dialogue: 0,0:04:58.38,0:05:00.09,Default,,0,0,0,,Гааи Аокидің арманы
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,---------------------------------------------------------------------------------------------------------------------
Dialogue: 0,0:06:10.65,0:06:13.04,Default,,0,0,0,,Қайда барғыңыз келеді?
Dialogue: 0,0:06:13.26,0:06:15.61,Default,,0,0,0,,Сіз қандай болғыңыз келеді?
Dialogue: 0,0:06:15.88,0:06:20.82,Default,,0,0,0,,Жүрекпен еркін сурет сал
Dialogue: 0,0:06:21.09,0:06:26.10,Default,,0,0,0,,Менің алдымда не бар, алда не бар
Dialogue: 0,0:06:26.34,0:06:31.40,Default,,0,0,0,,Қызықты және түрлі-түсті
Dialogue: 0,0:06:31.56,0:06:35.63,Default,,0,0,0,,«Мен істей алмаймын» қызықсыз
Dialogue: 0,0:06:36.75,0:06:40.57,Default,,0,0,0,,Тек көріңіз!
Dialogue: 0,0:06:40.97,0:06:45.96,Default,,0,0,0,,Бейне менің болашақ өзіме айналады
Dialogue: 0,0:06:46.25,0:06:51.25,Default,,0,0,0,,Армандар үміт пен арманға айналады
Dialogue: 0,0:06:51.41,0:06:56.44,Default,,0,0,0,,Мақсат мені қозғайды
Dialogue: 0,0:06:56.71,0:07:01.49,Default,,0,0,0,,Оны жүзеге асыру үшін жол жасалады.
Dialogue: 0,0:07:01.90,0:07:04.24,Default,,0,0,0,,Тура жүгіруді бастайық
Dialogue: 0,0:07:04.49,0:07:11.92,Default,,0,0,0,,Өз сезімдеріңізге сенуден бастаңыз
Dialogue: 0,0:07:33.20,0:07:38.08,Default,,0,0,0,,Өйткені бейнелер шындықты жасайды
Dialogue: 0,0:07:38.34,0:07:43.34,Default,,0,0,0,,Елестетіп көрейік!
Dialogue: 0,0:07:43.57,0:07:48.56,Default,,0,0,0,,Ол неғұрлым үлкен болса, соғұрлым көп мүмкіндіктер бар.
Dialogue: 0,0:07:48.79,0:07:53.59,Default,,0,0,0,,Түйіп тұрған арман болсын
Dialogue: 0,0:07:53.88,0:07:56.50,Default,,0,0,0,,Бұл негізсіз
Dialogue: 0,0:07:56.67,0:07:59.49,Default,,0,0,0,,Мен бас тартқым келмейді
Dialogue: 0,0:07:59.66,0:08:04.25,Default,,0,0,0,,Біз де ғажайыптар жасайық
Dialogue: 0,0:06:10.65,0:06:13.04,Default,,0,0,0,,Юли есіңде ме?
Dialogue: 0,0:06:13.26,0:06:15.61,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:06:15.88,0:06:20.82,Default,,0,0,0,,Суретті есте сақтау тегін.
Dialogue: 0,0:06:21.09,0:06:26.10,Default,,0,0,0,,Көз алдымызда не бар Көз алдымызда
Dialogue: 0,0:06:26.34,0:06:31.40,Default,,0,0,0,,Жеті түсті жарық сәулелерінің үздіксіз кеңеюі
Dialogue: 0,0:06:31.56,0:06:35.63,Default,,0,0,0,,Натаның ниетіне «жетпеу» үшін тағы бір сөз
Dialogue: 0,0:06:36.75,0:06:40.57,Default,,0,0,0,,Бірінші әрекет!
Dialogue: 0,0:06:40.97,0:06:45.96,Default,,0,0,0,,Қиялдағы қоғам болашақта аяқталады
Dialogue: 0,0:06:46.25,0:06:51.25,Default,,0,0,0,,Армандағы кездесу
Dialogue: 0,0:06:51.41,0:06:56.44,Default,,0,0,0,,Біздің алға жылжуымыз
Dialogue: 0,0:06:56.71,0:07:01.49,Default,,0,0,0,,Ашылып, шығатын арманды тас жол.
Dialogue: 0,0:07:01.90,0:07:04.24,Default,,0,0,0,,...
Dialogue: 0,0:07:04.49,0:07:11.92,Default,,0,0,0,,Өзіңізге деген сенімділікті бастаңыз
Dialogue: 0,0:07:33.20,0:07:38.08,Default,,0,0,0,,Қиялдың шындығы
Dialogue: 0,0:07:38.34,0:07:43.34,Default,,0,0,0,,Мен сен үшін не істегім келеді
Dialogue: 0,0:07:43.57,0:07:48.56,Default,,0,0,0,,Біртүрлі ой болуы мүмкін.
Dialogue: 0,0:07:48.79,0:07:53.59,Default,,0,0,0,,Менің арманымның трансцендентальды армандары
Dialogue: 0,0:07:53.88,0:07:56.50,Default,,0,0,0,,Жұмысты есептеу – трансцендентті жалпы білім
Dialogue: 0,0:07:56.67,0:07:59.49,Default,,0,0,0,,Сондай-ақ қажетсіз сәулелену
Dialogue: 0,0:07:59.66,0:08:04.25,Default,,0,0,0,,Ғажайып та сәтті.
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,---------------------------------------------------------------------------------------------------------------------
Dialogue: 0,0:09:11.62,0:09:27.12,Default,,0,0,0,,Ертең кездескенше!
Dialogue: 0,0:09:27.84,0:09:31.58,Default,,0,0,0,,Білмес бұрын, сіз дәл сол киімді таңдайсыз.
Dialogue: 0,0:09:31.82,0:09:35.61,Default,,0,0,0,,Әй, ертең тағы сол юбка! Панпан
Dialogue: 0,0:09:35.87,0:09:39.69,Default,,0,0,0,,Мен білмей тұрып, бір жерде ойнадық.
Dialogue: 0,0:09:39.90,0:09:43.52,Default,,0,0,0,,Ах, ертең тағы да жер! Панпан
Dialogue: 0,0:09:43.67,0:09:46.11,Default,,0,0,0,,Өйткені менің идеалымда
Dialogue: 0,0:09:46.27,0:09:50.22,Default,,0,0,0,,Мен бәрін біркелкі түсінгім келеді.
Dialogue: 0,0:09:50.43,0:09:51.49,Default,,0,0,0,,Қиын!
Dialogue: 0,0:09:51.66,0:09:53.91,Default,,0,0,0,,Бірақ әділ, әділ, әділ, әділ.
Dialogue: 0,0:09:54.06,0:09:56.54,Default,,0,0,0,,Әр күн бірдей
Dialogue: 0,0:09:56.75,0:09:59.55,Default,,0,0,0,,Бұл жаман емес!
Dialogue: 0,0:09:59.71,0:10:03.55,Default,,0,0,0,,Күткендей, тағы да, тағы да, ертең тағы!
Dialogue: 0,0:10:03.84,0:10:07.88,Default,,0,0,0,,Мен алға қадам басқым келеді! Юй юи!
Dialogue: 0,0:10:08.04,0:10:11.69,Default,,0,0,0,,Ертең кездескенше!
Dialogue: 0,0:10:11.94,0:10:16.00,Default,,0,0,0,,Бұл әдеттегіден өзгеше. Бұл көңілді көрінеді! Юй юи!
Dialogue: 0,0:10:16.15,0:10:17.96,Default,,0,0,0,,Сіз не істейсіз? Сіз не істейсіз?
Dialogue: 0,0:10:18.13,0:10:20.00,Default,,0,0,0,,Өзіңіз білмейтін нәрсені жасаңыз! иә!
Dialogue: 0,0:10:20.16,0:10:23.68,Default,,0,0,0,,Көріп көрейік уау
Dialogue: 0,0:10:24.02,0:10:26.00,Default,,0,0,0,,Сіз не істейсіз? Сіз не істейсіз?
Dialogue: 0,0:10:26.20,0:10:28.41,Default,,0,0,0,,Қызықты нәрсе жасаңыз! иә!
Dialogue: 0,0:10:29.01,0:10:31.63,Default,,0,0,0,,Бұл жаман емес, солай ма?
Dialogue: 0,0:10:31.84,0:10:35.94,Default,,0,0,0,,Кездейсоқ жинақталған күнделікті өмір
Dialogue: 0,0:10:36.14,0:10:40.06,Default,,0,0,0,,Мен де естеліктерімді ұмытып кететін сияқтымын.
Dialogue: 0,0:10:40.24,0:10:43.98,Default,,0,0,0,,Содан кейін қайтадан, қайтадан, ертеңнен бастап.
Dialogue: 0,0:10:44.18,0:10:48.26,Default,,0,0,0,,Жаңа естеліктер жасайық!
Dialogue: 0,0:10:48.44,0:10:52.14,Default,,0,0,0,,Ертең кездескенше!
Dialogue: 0,0:10:52.29,0:10:56.29,Default,,0,0,0,,Сондықтан мен алға қадам басқым келеді! Юй юи!
Dialogue: 0,0:10:56.52,0:11:00.04,Default,,0,0,0,,Ертең кездескенше!
Dialogue: 0,0:11:00.24,0:11:04.35,Default,,0,0,0,,Бұл әдеттегіден өзгеше. Бұл көңілді көрінеді! Юй юи!
Dialogue: 0,0:11:04.52,0:11:08.05,Default,,0,0,0,,Ертең кездескенше!
Dialogue: 0,0:09:11.62,0:09:27.12,Default,,0,0,0,,Мин Тянь Мин Тянь Мин Тянь Мин Тянь!
Dialogue: 0,0:09:27.84,0:09:31.58,Default,,0,0,0,,Бұл бекітілген көрініс.
Dialogue: 0,0:09:31.82,0:09:35.61,Default,,0,0,0,,...
Dialogue: 0,0:09:35.87,0:09:39.69,Default,,0,0,0,,Бір жергілікті межелі жерге оралу
