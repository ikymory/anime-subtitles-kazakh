Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.29,0:00:05.18,Default,,0,0,0,,Табыстың өзін-өзі орталықтандыру аймағы
Dialogue: 0,0:00:05.33,0:00:06.49,Default,,0,0,0,,Идол белсендіруші жұлдыз сферасы!
Dialogue: 0,0:00:06.67,0:00:07.70,Default,,0,0,0,,Бастапқы нүкте
Dialogue: 0,0:00:08.99,0:00:10.06,Default,,0,0,0,,...
Dialogue: 0,0:00:11.13,0:00:12.55,Default,,0,0,0,,Жоғарғы шеңбер оқиғасы!
Dialogue: 0,0:00:12.86,0:00:15.48,Default,,0,0,0,,Мен Otowa Maiaki жоғарғы орта мектебінің кіші орта мектебінің сыныбын айқайлаймын!
Dialogue: 0,0:00:15.93,0:00:19.00,Default,,0,0,0,,Тірі жұлдыз шарында, кішкентай ұшты пұт, кішкентай гүл!
Dialogue: 0,0:00:19.35,0:00:23.67,Default,,0,0,0,,Шетелде болғаннан бері көп уақыттың ортасында жүргеніме көп уақыт болды!
Dialogue: 0,0:00:23.98,0:00:25.09,Default,,0,0,0,,Себеп керемет!
Dialogue: 0,0:00:25.25,0:00:27.14,Default,,0,0,0,,Себебі мен сізді жігерлендіремін!
Dialogue: 0,0:00:27.62,0:00:31.48,Default,,0,0,0,,Дегенмен, жаңа инкарнацияның жаңа инкарнациясы қайталанады!
Dialogue: 0,0:00:32.37,0:00:35.64,Default,,0,0,0,,Акисакидің ең күшті жауы, Ай Юяның жалындаған тілегі
Dialogue: 0,0:00:35.80,0:00:39.74,Default,,0,0,0,,Тірі әлемдегі ең маңызды жұлдызды доптың тамаша орындауы!
Dialogue: 0,0:00:42.86,0:00:44.37,Default,,0,0,0,,Жиналыс аяқталды
Dialogue: 0,0:00:44.70,0:00:46.09,Default,,0,0,0,,Бұл қазір аспан ба?
Dialogue: 0,0:00:46.23,0:00:46.94,Default,,0,0,0,,Жұлдызша күні
Dialogue: 0,0:00:47.11,0:00:49.01,Default,,0,0,0,,...
Dialogue: 0,0:00:49.16,0:00:51.66,Default,,0,0,0,,Мен дене шынықтыру үйірмесін ойлап отырмын!
Dialogue: 0,0:00:51.94,0:00:54.15,Default,,0,0,0,,Егер кестең болмаса, мен сені жібермеймін!
Dialogue: 0,0:00:54.41,0:00:55.23,Default,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:00:55.40,0:00:59.93,Default,,0,0,0,,Тамақты тез жеу мүмкін бе?
Dialogue: 0,0:01:00.08,0:01:01.85,Default,,0,0,0,,Мен не істерімді білмеймін!
Dialogue: 0,0:01:02.17,0:01:05.43,Default,,0,0,0,,Тірі жұлдыз шарынан кім шыға алады?
Dialogue: 0,0:01:05.70,0:01:07.78,Default,,0,0,0,,Дүние жүзіндегі қалалардың таң қалдыратын бөлігі!
Dialogue: 0,0:01:07.96,0:01:09.93,Default,,0,0,0,,Гая өте қатыгез
Dialogue: 0,0:01:10.59,0:01:11.70,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:01:12.23,0:01:16.10,Default,,0,0,0,,Төтенше жағдай Төтенше жағдай...
Dialogue: 0,0:01:18.50,0:01:19.55,Default,,0,0,0,,Акисаки?
Dialogue: 0,0:01:22.09,0:01:23.05,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:01:24.22,0:01:29.54,Default,,0,0,0,,...
Dialogue: 0,0:01:33.28,0:01:36.90,Default,,0,0,0,,Наританың жергілікті бейнесінің көрінісі
Dialogue: 0,0:01:37.08,0:01:39.18,Default,,0,0,0,,Төменгі бет – құйрықтың құйрығы.
Dialogue: 0,0:01:40.00,0:01:41.55,Default,,0,0,0,,Оны асыға күтпейді
Dialogue: 0,0:01:41.96,0:01:44.86,Default,,0,0,0,,...
Dialogue: 0,0:01:44.99,0:01:46.18,Default,,0,0,0,,Мен не болып жатқанын ойлаумен айналысамын!
Dialogue: 0,0:01:46.36,0:01:47.07,Default,,0,0,0,,Майко
Dialogue: 0,0:01:47.45,0:01:48.35,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:18.99,0:03:23.99,Default,,0,0,0,,Құмарлық көз
Dialogue: 0,0:03:26.13,0:03:27.69,Default,,0,0,0,,Артықшылықты жолақ
Dialogue: 0,0:03:28.87,0:03:30.54,Default,,0,0,0,,Көңілді ме?
Dialogue: 0,0:03:31.08,0:03:32.20,Default,,0,0,0,,Исуми Изуми?
Dialogue: 0,0:03:32.54,0:03:35.68,Default,,0,0,0,,Мен кеңседен шыққан кезде
Dialogue: 0,0:03:36.35,0:03:40.55,Default,,0,0,0,,Изуми Коджи бейнесі де жоғары бағаланады.
Dialogue: 0,0:03:41.69,0:03:43.00,Default,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:03:44.63,0:03:46.90,Default,,0,0,0,,Изуми Кожикай ашық ойлы ма?
Dialogue: 0,0:03:47.73,0:03:49.87,Default,,0,0,0,,...
Dialogue: 0,0:03:50.02,0:03:50.80,Default,,0,0,0,,Шынайы оқиға!?
Dialogue: 0,0:03:50.96,0:03:51.58,Default,,0,0,0,,...
Dialogue: 0,0:03:52.23,0:03:53.00,Default,,0,0,0,,Құшақтаңыз!
Dialogue: 0,0:03:53.16,0:03:53.75,Default,,0,0,0,,Ой, керемет екен.
Dialogue: 0,0:03:54.69,0:03:57.51,Default,,0,0,0,,Изуми Коджи келесі жолы осында болды ма?
Dialogue: 0,0:03:57.78,0:04:00.62,Default,,0,0,0,,Иә! Үйден тыс қабылдау
Dialogue: 0,0:04:03.11,0:04:05.47,Default,,0,0,0,,Демек, марқұмның өлген жері орналасқан.
Dialogue: 0,0:04:05.63,0:04:07.58,Default,,0,0,0,,Таң қалдыңыз!?
Dialogue: 0,0:04:09.57,0:04:10.65,Default,,0,0,0,,...
Dialogue: 0,0:04:10.85,0:04:12.57,Default,,0,0,0,,Мен бос емеспін!
Dialogue: 0,0:04:13.16,0:04:14.78,Default,,0,0,0,,...
Dialogue: 0,0:04:20.88,0:04:24.62,Default,,0,0,0,,Бұл менің шетелде оқу уақытыма назар аударуым керек жер.
Dialogue: 0,0:04:24.76,0:04:26.46,Default,,0,0,0,,Аз мөлшердегі киімге қолданады
Dialogue: 0,0:04:27.77,0:04:30.37,Default,,0,0,0,,Дүние жүзіндегі бірегей тағамдарды қайта қарау
Dialogue: 0,0:04:31.44,0:04:35.16,Default,,0,0,0,,Изуми Коджи көрсеткен менің жаңа менімнің соңғы бейнесі
Dialogue: 0,0:04:35.70,0:04:37.11,Default,,0,0,0,,Инкарнация қызық!
Dialogue: 0,0:04:37.27,0:04:38.04,Default,,0,0,0,,Өлім
Dialogue: 0,0:04:38.57,0:04:39.47,Default,,0,0,0,,...
Dialogue: 0,0:04:39.63,0:04:41.33,Default,,0,0,0,,78 сәтті аяқтау
Dialogue: 0,0:04:41.50,0:04:43.85,Default,,0,0,0,,...
Dialogue: 0,0:04:44.24,0:04:47.84,Default,,0,0,0,,...
Dialogue: 0,0:04:48.00,0:04:50.33,Default,,0,0,0,,Изуми Коджиге алғашқы сапар
Dialogue: 0,0:04:50.51,0:04:54.87,Default,,0,0,0,,Анықталмаған аударма Табысқа жетудің және менімен татулықтың ең жақсы мүмкіндігі
Dialogue: 0,0:04:55.59,0:04:57.13,Default,,0,0,0,,Иә, оны растауға болады!
Dialogue: 0,0:04:59.26,0:05:02.15,Default,,0,0,0,,Жағымсыз оқиға Изуми Коджи оралмас бұрын, мүмкін болатын аранжировка толық емес!
Dialogue: 0,0:05:02.30,0:05:03.18,Default,,0,0,0,,Қиындық!
Dialogue: 0,0:05:03.55,0:05:05.95,Default,,0,0,0,,Мүмкіндік болса, кітапты бір ауыздан оқыңыз!
Dialogue: 0,0:05:06.30,0:05:08.82,Default,,0,0,0,,Бастамас бұрын мазмұны қандай?
Dialogue: 0,0:05:08.98,0:05:11.28,Default,,0,0,0,,Жақсы мақсат
Dialogue: 0,0:05:11.44,0:05:12.24,Default,,0,0,0,,Жағдайлар ағымдағы.
Dialogue: 0,0:05:12.40,0:05:12.92,Default,,0,0,0,,Оның өміріне ешқашан көрмеген әкесі үшін қауіп төндіріліп отыр.
Dialogue: 0,0:05:13.23,0:05:16.17,Default,,0,0,0,,Сізбен кездесу уақыты келді!
Dialogue: 0,0:05:16.33,0:05:17.29,Default,,0,0,0,,Аяқтау
Dialogue: 0,0:05:25.59,0:05:26.55,Default,,0,0,0,,Нана!
Dialogue: 0,0:05:27.32,0:05:30.91,Default,,0,0,0,,Мен Комура Косатода шетелде бірінші рет оқып жатырмын!
Dialogue: 0,0:05:31.07,0:05:33.42,Default,,0,0,0,,Бұл үйлену тойында қолданылатын былғары аяқ киім!
Dialogue: 0,0:05:33.59,0:05:34.94,Default,,0,0,0,,...
Dialogue: 0,0:05:35.79,0:05:37.77,Default,,0,0,0,,Күйеу кеші орта мектебінің ауданы
Dialogue: 0,0:05:37.92,0:05:40.62,Default,,0,0,0,,Жаңа қызға арналған би!
Dialogue: 0,0:05:40.77,0:05:44.26,Default,,0,0,0,,Мен өзімді басқа бидің ортасында жүргендей сезінемін!
Dialogue: 0,0:05:44.66,0:05:46.46,Default,,0,0,0,,Саған би ұнай ма?
Dialogue: 0,0:05:46.78,0:05:47.70,Default,,0,0,0,,...
Dialogue: 0,0:05:48.57,0:05:50.45,Default,,0,0,0,,Ой...
Dialogue: 0,0:05:54.97,0:05:55.94,Default,,0,0,0,,Өлген жоқ!
Dialogue: 0,0:05:56.10,0:05:57.68,Default,,0,0,0,,Қандай ежелгі сезім!
Dialogue: 0,0:05:57.81,0:05:59.93,Default,,0,0,0,,...
Dialogue: 0,0:06:00.65,0:06:01.73,Default,,0,0,0,,(Накайчидің ең қатты дауысы)
Dialogue: 0,0:06:02.28,0:06:04.87,Default,,0,0,0,,Тоқта... Ляоюдың тосынсыйы керемет ашылу.
Dialogue: 0,0:06:05.06,0:06:07.07,Default,,0,0,0,,Мүмкін әңгіме Ою жұмыстары да басталды
Dialogue: 0,0:06:07.32,0:06:09.30,Default,,0,0,0,,Изуми Коджидің қайтып оралу уақыты
Dialogue: 0,0:06:09.45,0:06:10.72,Default,,0,0,0,,...
Dialogue: 0,0:06:16.92,0:06:17.69,Default,,0,0,0,,Нана!
Dialogue: 0,0:06:17.84,0:06:19.62,Default,,0,0,0,,Нанами Мидзуге жұмбақ секіру келді!
Dialogue: 0,0:06:20.48,0:06:23.58,Default,,0,0,0,,Бұл ежелгі өркениеттің мүмкін және белсенді болғанының дәлелі.
Dialogue: 0,0:06:23.75,0:06:25.22,Default,,0,0,0,,Бұл романтикалық оқиға
Dialogue: 0,0:06:25.37,0:06:29.86,Default,,0,0,0,,...
Dialogue: 0,0:06:30.02,0:06:31.36,Default,,0,0,0,,Әнді тыңдаңыз!
Dialogue: 0,0:06:32.19,0:06:32.79,Default,,0,0,0,,...
Dialogue: 0,0:06:32.93,0:06:33.58,Default,,0,0,0,,Оған тұрарлық емес!
Dialogue: 0,0:06:33.73,0:06:34.93,Default,,0,0,0,,Қолдың қозғалысы келе жатыр!
Dialogue: 0,0:06:36.04,0:06:37.85,Default,,0,0,0,,...
Dialogue: 0,0:06:38.57,0:06:39.80,Default,,0,0,0,,Мен осы жерден келдім
Dialogue: 0,0:06:39.98,0:06:41.70,Default,,0,0,0,,Мин Саки сенің жағдайың нашар!
Dialogue: 0,0:06:43.13,0:06:48.98,Default,,0,0,0,,Құрамы: жапон ямасы, ұнтақталған қауын, жемістің жемісі?
Dialogue: 0,0:06:49.57,0:06:53.30,Default,,0,0,0,,Мен Оңтүстік теңіз аралдарында тұрамын.
Dialogue: 0,0:06:53.53,0:06:55.19,Default,,0,0,0,,Дәмді тағамның сыры
Dialogue: 0,0:06:56.83,0:07:01.27,Default,,0,0,0,,Бір ән, бір секір, бір би!
Dialogue: 0,0:07:02.57,0:07:03.90,Default,,0,0,0,,Әңгімелесейік!
Dialogue: 0,0:07:04.58,0:07:07.55,Default,,0,0,0,,Акисаки дүниеге келгені рас па?
Dialogue: 0,0:07:08.96,0:07:10.33,Default,,0,0,0,,...
Dialogue: 0,0:07:11.13,0:07:13.11,Default,,0,0,0,,Басқаларды көру жақсы!
Dialogue: 0,0:07:14.05,0:07:16.60,Default,,0,0,0,,(қол машинасының дауысы)
Dialogue: 0,0:07:17.96,0:07:18.75,Default,,0,0,0,,Шағын басылым?
Dialogue: 0,0:07:18.24,0:07:19.29,Default,,0,0,0,,Майко қолайсыз!
Dialogue: 0,0:07:19.45,0:07:21.80,Default,,0,0,0,,Кездесу жақында аяқталады!
Dialogue: 0,0:07:23.77,0:07:24.84,Default,,0,0,0,,...
Dialogue: 0,0:07:25.57,0:07:27.15,Default,,0,0,0,,Сіз болу керек уақыт ұзақтығы
Dialogue: 0,0:07:27.29,0:07:28.62,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:07:28.78,0:07:30.55,Default,,0,0,0,,Білім және ойлау әдісі
Dialogue: 0,0:07:32.12,0:07:33.69,Default,,0,0,0,,Тағдыр еліне түйреуіш
Dialogue: 0,0:07:34.41,0:07:36.27,Default,,0,0,0,,Мен артта қалғаныма өкінемін
Dialogue: 0,0:07:36.57,0:07:37.44,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:07:37.61,0:07:39.47,Default,,0,0,0,,Бұл қорытындыға келді.
Dialogue: 0,0:07:39.94,0:07:41.13,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:07:46.03,0:07:49.35,Default,,0,0,0,,...
Dialogue: 0,0:07:50.53,0:07:52.30,Default,,0,0,0,,Менің ойым...
Dialogue: 0,0:07:53.17,0:07:55.45,Default,,0,0,0,,Бұл мүмкіндік қазірдің өзінде... бұрыннан бар
Dialogue: 0,0:07:55.63,0:08:02.58,Default,,0,0,0,,Барған сайын барған сайын көбейіп, барған сайын көбейіп бара жатқан жердің бұрынғыдан да терең өзгергенін түсінемін!
Dialogue: 0,0:08:02.96,0:08:03.91,Default,,0,0,0,,Ойлар жоқ!
Dialogue: 0,0:08:05.71,0:08:06.66,Default,,0,0,0,,...
Dialogue: 0,0:08:23.46,0:08:25.58,Default,,0,0,0,,(қол машинасының дауысы)
Dialogue: 0,0:08:25.94,0:08:26.79,Default,,0,0,0,,...
Dialogue: 0,0:08:26.95,0:08:28.29,Default,,0,0,0,,Тәртіпсіздік аяқталды!
Dialogue: 0,0:08:29.12,0:08:32.60,Default,,0,0,0,,Менің секіретін қорапшам астананың бір қабаты.
Dialogue: 0,0:08:32.94,0:08:36.01,Default,,0,0,0,,Ең кіші бөлшекті қарастырайық!
Dialogue: 0,0:08:36.34,0:08:39.61,Default,,0,0,0,,Мен они дүкеніндемін, мен таң қалдым.
Dialogue: 0,0:08:39.82,0:08:43.38,Default,,0,0,0,,Бұрынғы құбыжықтарды құруға түрткі болған өткен оқиға.
Dialogue: 0,0:08:44.04,0:08:47.28,Default,,0,0,0,,Біз істі қайта реттеуді шештік!
Dialogue: 0,0:08:48.02,0:08:50.08,Default,,0,0,0,,Акисаки көңілі қалды! Жұмысқа тұру үшін қажет...
Dialogue: 0,0:08:50.24,0:08:51.30,Default,,0,0,0,,Түс...
Dialogue: 0,0:08:51.64,0:08:54.13,Default,,0,0,0,,Бұл алдыңғысымен жақсы салыстыру.
Dialogue: 0,0:08:54.87,0:08:58.98,Default,,0,0,0,,Ұзындығы... қысқасы жақсы
Dialogue: 0,0:08:59.45,0:09:01.37,Default,,0,0,0,,Зиянды концентрация
Dialogue: 0,0:09:03.09,0:09:05.44,Default,,0,0,0,,Бұл қызықты уақыт емес!
Dialogue: 0,0:09:06.33,0:09:09.59,Default,,0,0,0,,Бұл оқиға: Мен жай ғана тиімді варвармын, мен Изумидің кішкентай әпкесімен біттім!
Dialogue: 0,0:09:11.35,0:09:13.05,Default,,0,0,0,,Автокөлік станциясы...
Dialogue: 0,0:09:14.19,0:09:15.31,Default,,0,0,0,,Міне, келдің!
Dialogue: 0,0:09:22.62,0:09:23.85,Default,,0,0,0,,Қосу
Dialogue: 0,0:09:28.23,0:09:28.68,Default,,0,0,0,,Майко!
Dialogue: 0,0:09:28.86,0:09:30.62,Default,,0,0,0,,...
Dialogue: 0,0:09:30.78,0:09:34.02,Default,,0,0,0,,Сол жерде жүргенде кенет есіме түсті.
Dialogue: 0,0:09:34.18,0:09:35.91,Default,,0,0,0,,Орта мерзімді қызмет аяқталды!
Dialogue: 0,0:09:36.22,0:09:40.08,Default,,0,0,0,,Бұл дизайндағы «Толқу мен жан тыныштығы» үшін үлкен шығын!
Dialogue: 0,0:09:40.24,0:09:41.95,Default,,0,0,0,,Өтемақы қажет
Dialogue: 0,0:09:45.90,0:09:47.99,Default,,0,0,0,,Изуми Коджидің қаланы таныстыруы аяқталды.
Dialogue: 0,0:09:48.67,0:09:51.22,Default,,0,0,0,,...
Dialogue: 0,0:09:52.06,0:09:55.07,Default,,0,0,0,,Аспанда күн жарқырап тұр
Dialogue: 0,0:09:55.23,0:09:56.60,Default,,0,0,0,,...
Dialogue: 0,0:09:58.65,0:10:00.50,Default,,0,0,0,,(қадам дауысы)
Dialogue: 0,0:10:02.98,0:10:04.32,Default,,0,0,0,,...
Dialogue: 0,0:10:04.48,0:10:07.84,Default,,0,0,0,,Жаңа инкарнация белгісіз.
Dialogue: 0,0:10:08.10,0:10:10.41,Default,,0,0,0,,Изуми Коджидің оң қайтарымы Мен мұны естігеніме өкінемін
Dialogue: 0,0:10:10.65,0:10:12.44,Default,,0,0,0,,Қазынаның берекесі аяқталды!
Dialogue: 0,0:10:13.12,0:10:14.34,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:10:14.51,0:10:16.89,Default,,0,0,0,,Шыны алу жақсы ма?
Dialogue: 0,0:10:17.05,0:10:17.73,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:17.88,0:10:19.85,Default,,0,0,0,,...
Dialogue: 0,0:10:20.35,0:10:21.30,Default,,0,0,0,,Сіз шағын басылымсыз!
Dialogue: 0,0:10:21.72,0:10:22.95,Default,,0,0,0,,Осы жерде кездескенше!
Dialogue: 0,0:10:23.36,0:10:24.65,Default,,0,0,0,,Бірінші пайда болуы
Dialogue: 0,0:10:24.82,0:10:25.95,Default,,0,0,0,,Мен сізді асыға күтемін!
Dialogue: 0,0:10:26.12,0:10:26.81,Default,,0,0,0,,Апаттық таяқ
Dialogue: 0,0:10:27.19,0:10:30.26,Default,,0,0,0,,Гай! Ұзын кірпіктер!
Dialogue: 0,0:10:30.75,0:10:32.01,Default,,0,0,0,,Акисаки
Dialogue: 0,0:10:32.90,0:10:36.76,Default,,0,0,0,,Сіздің әйеліңіз Изуми Коджи таң қалдырды ма?
Dialogue: 0,0:10:39.34,0:10:41.32,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Көз
Dialogue: 0,0:10:53.98,0:10:58.24,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:59.70,0:11:01.34,Default,,0,0,0,,Акиаки Акира
Dialogue: 0,0:11:02.37,0:11:06.43,Default,,0,0,0,,Менің сезімдерім адал және шынайы.
Dialogue: 0,0:11:07.62,0:11:09.84,Default,,0,0,0,,Тікелей елші ашылмаған немесе жарасымды мектеп
Dialogue: 0,0:11:10.01,0:11:13.08,Default,,0,0,0,,Болған кезде күлесің
Dialogue: 0,0:11:13.25,0:11:14.91,Default,,0,0,0,,Сен қашан отырасың?
Dialogue: 0,0:11:15.27,0:11:16.60,Default,,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:11:16.85,0:11:19.06,Default,,0,0,0,,Елорданың күлкісі келді.
Dialogue: 0,0:11:25.01,0:11:26.84,Default,,0,0,0,,Бұл Әсеннің кінәсі.
Dialogue: 0,0:11:32.12,0:11:33.40,Default,,0,0,0,,Жадағай өндірісінің киімдері...
Dialogue: 0,0:11:43.17,0:11:44.85,Default,,0,0,0,,Қосымша әсерлер
Dialogue: 0,0:11:48.17,0:11:51.30,Default,,0,0,0,,Қолыма алған алғашқы сыйлық
Dialogue: 0,0:11:52.84,0:11:54.79,Default,,0,0,0,,Бұл бір кішкентай қайын сіңлі
Dialogue: 0,0:11:55.43,0:11:59.20,Default,,0,0,0,,Киім киюдің қажеті жоқ.
Dialogue: 0,0:12:01.18,0:12:03.24,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:12:06.76,0:12:08.64,Default,,0,0,0,,Набо зергерлік бұйымдары
Dialogue: 0,0:12:08.95,0:12:12.68,Default,,0,0,0,,Бекіту және өмір сүру қабілетіне деген үміттің алғашқы екі инкарнациясы
Dialogue: 0,0:12:14.00,0:12:15.88,Default,,0,0,0,,Бұл жол сізге гүлді қалдыруға арналған
Dialogue: 0,0:12:16.45,0:12:18.96,Default,,0,0,0,,Өзін-өзі жою, қайта пайда болу уақыты
Dialogue: 0,0:12:32.88,0:12:34.60,Default,,0,0,0,,...
Dialogue: 0,0:12:40.21,0:12:47.71,Default,,0,0,0,,...
Dialogue: 0,0:13:00.19,0:13:02.41,Default,,0,0,0,,Гармониялық прогресс пен табыс
Dialogue: 0,0:13:02.75,0:13:05.64,Default,,0,0,0,,Таңқаларлық табыс
Dialogue: 0,0:13:05.98,0:13:10.37,Default,,0,0,0,,Дүниедегі жұлдызды дүниенің жаңа жолы қандай?
Dialogue: 0,0:13:10.87,0:13:12.36,Default,,0,0,0,,Сізге арналған бет ұнтағы!
Dialogue: 0,0:13:12.51,0:13:14.19,Default,,0,0,0,,...
Dialogue: 0,0:13:24.54,0:13:27.10,Default,,0,0,0,,Иә! Қышынып тұрғаны сонша!
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Аниме
Dialogue: 0,0:14:01.66,0:14:02.78,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:14:04.50,0:14:06.08,Default,,0,0,0,,Йошихиса қайтыс болды
Dialogue: 0,0:14:06.36,0:14:07.26,Default,,0,0,0,,...
Dialogue: 0,0:14:08.47,0:14:10.43,Default,,0,0,0,,Гүлді орманның келуі
Dialogue: 0,0:14:10.60,0:14:11.57,Default,,0,0,0,,...
Dialogue: 0,0:14:12.49,0:14:13.99,Default,,0,0,0,,Бұл бірінші көрнекі пұт.
Dialogue: 0,0:14:14.18,0:14:15.07,Default,,0,0,0,,Гай!
Dialogue: 0,0:14:15.63,0:14:17.12,Default,,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:14:17.48,0:14:23.25,Default,,0,0,0,,Міне, мен, ең дарынды адаммын, менің сүйікті досым және мен көрген ең тамаша костюммін!
Dialogue: 0,0:14:24.26,0:14:25.35,Default,,0,0,0,,Маған айта аласыз ба?
Dialogue: 0,0:14:25.69,0:14:28.26,Default,,0,0,0,,Император залы?
Dialogue: 0,0:14:25.69,0:14:28.26,Default,,0,0,0,,Сәнді раушан
Dialogue: 0,0:14:28.49,0:14:30.65,Default,,0,0,0,,...
Dialogue: 0,0:14:30.81,0:14:33.31,Default,,0,0,0,,Бұл менің ең жақын досым.
Dialogue: 0,0:14:33.64,0:14:37.86,Default,,0,0,0,,Белгісіз жерден келген адамның оқиғасы
Dialogue: 0,0:14:38.05,0:14:43.39,Default,,0,0,0,,Ура! Бір нүкте, бір нүкте, бір нүкте, бір нүкте, ескі күнбағыс
Dialogue: 0,0:14:38.05,0:14:43.39,Default,,0,0,0,,Люксу күн гүлі
Dialogue: 0,0:14:43.56,0:14:44.31,Default,,0,0,0,,...
Dialogue: 0,0:14:46.64,0:14:47.85,Default,,0,0,0,,Накоре...
Dialogue: 0,0:14:48.16,0:14:50.55,Default,,0,0,0,,Интернат тәжірибесі
Dialogue: 0,0:14:50.83,0:14:51.90,Default,,0,0,0,,Сізде кеш бар...
Dialogue: 0,0:14:52.17,0:14:54.78,Default,,0,0,0,,Дұрыс айтасыз!
Dialogue: 0,0:14:55.31,0:14:56.48,Default,,0,0,0,,Йошихиса ешқашан көрген емес!
Dialogue: 0,0:14:58.15,0:15:03.21,Default,,0,0,0,,Бүкіл орман жақсы ұйымдастырылған, заманның көркі көзге түспейді.
Dialogue: 0,0:15:03.60,0:15:05.83,Default,,0,0,0,,Орманның тереңіне қарай жүгіру
Dialogue: 0,0:15:07.02,0:15:09.22,Default,,0,0,0,,Зал
Dialogue: 0,0:15:09.38,0:15:10.19,Default,,0,0,0,,Гай!
Dialogue: 0,0:15:10.48,0:15:14.92,Default,,0,0,0,,Қазіргі уақытта келген көптеген пұттар бар.
Dialogue: 0,0:15:15.18,0:15:17.69,Default,,0,0,0,,Мен вистерия бұтасын көргенде, тікенге толы.
Dialogue: 0,0:15:17.86,0:15:20.89,Default,,0,0,0,,Пәтер иесінің астанадан кету ниеті
Dialogue: 0,0:15:21.14,0:15:22.59,Default,,0,0,0,,Зиянды вистерия жүзім бұтасы
Dialogue: 0,0:15:24.94,0:15:25.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:26.11,0:15:28.90,Default,,0,0,0,,...
Dialogue: 0,0:15:39.12,0:15:42.86,Default,,0,0,0,,...
Dialogue: 0,0:15:52.20,0:15:53.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:55.10,0:15:56.66,Default,,0,0,0,,Гай!
Dialogue: 0,0:16:04.86,0:16:06.24,Default,,0,0,0,,Төмен баға
Dialogue: 0,0:16:06.56,0:16:08.72,Default,,0,0,0,,Гакьюду императорлық сарайы
Dialogue: 0,0:16:10.35,0:16:11.69,Default,,0,0,0,,Мен айқайлаймын
Dialogue: 0,0:16:11.87,0:16:14.91,Default,,0,0,0,,Барлық уақыттағы ең жарқыраған күлкі!
Dialogue: 0,0:16:15.21,0:16:18.87,Default,,0,0,0,,Сондықтан мен өз күшімді қарызға алдым! Доу Хуан Юань!
Dialogue: 0,0:16:20.56,0:16:24.51,Default,,0,0,0,,Қанның қызуында қимылдайтын жүрегіңе менің сезімім жетті.
Dialogue: 0,0:16:24.68,0:16:27.17,Default,,0,0,0,,Сіздің қабілетіңізді қарызға алмайсыз, бірақ бұл менің батам.
Dialogue: 0,0:16:28.23,0:16:29.46,Default,,0,0,0,,...
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Драма
Dialogue: 0,0:16:46.08,0:16:47.83,Default,,0,0,0,,Сіз бұл туралы естідіңіз бе?
Dialogue: 0,0:16:47.99,0:16:49.98,Default,,0,0,0,,Шыны Контен Сахналық жауынгердің қолы
Dialogue: 0,0:16:50.15,0:16:51.67,Default,,0,0,0,,Бұл жаңа пұт па?
Dialogue: 0,0:16:51.87,0:16:53.62,Default,,0,0,0,,Оқыдым... Жылап тұрсың ба?
Dialogue: 0,0:16:54.29,0:16:55.21,Default,,0,0,0,,...
Dialogue: 0,0:16:53.64,0:16:55.90,Default,,0,0,0,,...
Dialogue: 0,0:16:56.43,0:17:01.11,Default,,0,0,0,,Дүниенің сыртына шығу жолында пайда болатын пұттар.
Dialogue: 0,0:17:01.38,0:17:05.34,Default,,0,0,0,,Егер сізге оқиға ұнамаса, бұл тамашалаудың ең жақсы жері.
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Аниме
Dialogue: 0,0:17:11.46,0:17:15.04,Default,,0,0,0,,...
Dialogue: 0,0:17:15.27,0:17:17.50,Default,,0,0,0,,Гүлдің мүсіні – арман!
Dialogue: 0,0:17:19.16,0:17:22.95,Default,,0,0,0,,Бұл аспанның сезімі... Йошихисаның әсерлі тәжірибесі келді.
Dialogue: 0,0:17:23.30,0:17:25.58,Default,,0,0,0,,Ичиго Синридің баласының қышуы басталды!
Dialogue: 0,0:17:33.07,0:17:34.36,Default,,0,0,0,,Ашық көк әшекей!
Dialogue: 0,0:17:33.07,0:17:34.36,Default,,0,0,0,,Блайт сапфир!
Dialogue: 0,0:17:36.59,0:17:39.88,Default,,0,0,0,,Шыны түсті орауыш корпус
Dialogue: 0,0:17:40.40,0:17:41.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:47.43,0:17:48.90,Default,,0,0,0,,Ашық қызыл әшекей!
Dialogue: 0,0:17:47.43,0:17:48.90,Default,,0,0,0,,Жылтыр рубин!
Dialogue: 0,0:17:50.85,0:17:53.90,Default,,0,0,0,,Махаббатқа боялған тереңірек қызыл жалын
Dialogue: 0,0:17:57.27,0:17:58.41,Default,,0,0,0,,...
Dialogue: 0,0:18:21.65,0:18:23.14,Default,,0,0,0,,Ду Хуан Цянь!
Dialogue: 0,0:18:21.65,0:18:23.14,Default,,0,0,0,,Люкс раушан!
Dialogue: 0,0:18:25.12,0:18:26.48,Default,,0,0,0,,Ашулы махаббат
Dialogue: 0,0:18:26.65,0:18:28.35,Default,,0,0,0,,Сіздің күшіңіз керемет!
Dialogue: 0,0:18:28.53,0:18:29.35,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:35.73,0:18:37.15,Default,,0,0,0,,Күнбағыс!
Dialogue: 0,0:18:35.73,0:18:37.15,Default,,0,0,0,,Люксу күн гүлі！
Dialogue: 0,0:18:39.28,0:18:41.76,Default,,0,0,0,,Сахнадағы үлкен гүл!
Dialogue: 0,0:18:45.13,0:18:45.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:05.42,0:19:07.90,Default,,0,0,0,,(соғыс айқайы)
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Тікелей эфир
Dialogue: 0,0:21:19.98,0:21:22.41,Default,,0,0,0,,(соғыс айқайы)
Dialogue: 0,0:21:23.35,0:21:27.38,Default,,0,0,0,,Бас сахнада жеңіске жетудің басты себебі...
Dialogue: 0,0:21:27.95,0:21:29.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:29.57,0:21:31.14,Default,,0,0,0,,Келетініңізге сенімдімін...
Dialogue: 0,0:21:31.34,0:21:35.17,Default,,0,0,0,,Керемет орындау!
Dialogue: 0,0:21:35.94,0:21:39.18,Default,,0,0,0,,Үй иесінің бірінші көрінісі Мен осындамын!
Dialogue: 0,0:21:39.51,0:21:41.83,Default,,0,0,0,,Үй иесінің жүрегі қышиды ма?
Dialogue: 0,0:21:42.67,0:21:44.04,Default,,0,0,0,,Йошихиса Фьюси
Dialogue: 0,0:21:44.20,0:21:44.64,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:21:45.00,0:21:47.13,Default,,0,0,0,,Мен Янминсакимін!
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Драма
Dialogue: 0,0:21:47.81,0:21:49.99,Default,,0,0,0,,Басты бейненің басты бейнесі Мейсаки ме!?
Dialogue: 0,0:21:50.18,0:21:51.55,Default,,0,0,0,,Нашиноны қабылдау аяқталды!
Dialogue: 0,0:21:51.83,0:21:54.20,Default,,0,0,0,,Ең табысты шайқас
Dialogue: 0,0:21:54.83,0:21:57.03,Default,,0,0,0,,...
Dialogue: 0,0:21:58.58,0:22:00.50,Default,,0,0,0,,...
Dialogue: 0,0:22:03.98,0:22:06.38,Default,,0,0,0,,Менің алымдарымнан асып кету
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Аниме
Dialogue: 0,0:22:09.55,0:22:11.16,Default,,0,0,0,,Ешбір бақылау бірінші емес, бұл екінші...
Dialogue: 0,0:22:11.62,0:22:16.53,Default,,0,0,0,,...
Dialogue: 0,0:22:18.82,0:22:21.35,Default,,0,0,0,,Сәттілік, желім келді!
Dialogue: 0,0:22:21.57,0:22:23.98,Default,,0,0,0,,Мен оны асыға күтемін, кішкентай гүлдер!
Dialogue: 0,0:22:24.14,0:22:24.86,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:23:56.83,0:23:57.47,Default,,0,0,0,,Сіз не сезінесіз?
Dialogue: 0,0:23:57.64,0:23:59.14,Default,,0,0,0,,Гадоту император сарайы
Dialogue: 0,0:23:59.36,0:24:01.95,Default,,0,0,0,,Әрине, адамның ақыл-ойы бір!
Dialogue: 0,0:24:02.12,0:24:02.71,Default,,0,0,0,,Уф!
Dialogue: 0,0:24:02.95,0:24:04.31,Default,,0,0,0,,Оушин Курико!
Dialogue: 0,0:24:04.49,0:24:06.06,Default,,0,0,0,,Орындадыңыз!
Dialogue: 0,0:24:06.98,0:24:08.06,Default,,0,0,0,,Кадзуки Ойкея
Dialogue: 0,0:24:08.22,0:24:09.23,Default,,0,0,0,,Айнаға кіріңіз!
Dialogue: 0,0:24:11.60,0:24:14.23,Default,,0,0,0,,Сахнадағы шайқас кенеттен келеді!
Dialogue: 0,0:24:14.40,0:24:15.32,Default,,0,0,0,,...
Dialogue: 0,0:24:15.49,0:24:16.20,Default,,0,0,0,,Сүйемін!
Dialogue: 0,0:24:16.38,0:24:17.57,Default,,0,0,0,,Сіз үйде отырғанда не күтесіз?
Dialogue: 0,0:24:17.74,0:24:19.41,Default,,0,0,0,,Бұл сөздердің тіркесі ғана.
Dialogue: 0,0:24:19.71,0:24:21.68,Default,,0,0,0,,...
Dialogue: 0,0:24:22.19,0:24:23.83,Default,,0,0,0,,Жұп жұлдызды шарлардың жинағы!
Dialogue: 0,0:24:24.01,0:24:25.24,Default,,0,0,0,,Ұйқы, киім, түн
Dialogue: 0,0:00:03.29,0:00:05.18,Default,,0,0,0,,Өзіңіз қалаған адам бола алатын орын
Dialogue: 0,0:00:05.33,0:00:06.49,Default,,0,0,0,,『ｱｲｶﾂﾌﾟﾗﾈｯﾄ！』
Dialogue: 0,0:00:06.67,0:00:07.70,Default,,0,0,0,,басталады
Dialogue: 0,0:00:08.99,0:00:10.06,Default,,0,0,0,,Хэхе~
Dialogue: 0,0:00:11.13,0:00:12.55,Default,,0,0,0,,Әзірге «Икатсу!»
Dialogue: 0,0:00:12.86,0:00:15.48,Default,,0,0,0,,Мен, Отова Майсакура, орта мектептің 1 курс оқушысы!
Dialogue: 0,0:00:15.93,0:00:19.00,Default,,0,0,0,,Мен Хананы Айкату планетасындағы ең жақсы кумир ретінде орындаймын!
Dialogue: 0,0:00:19.35,0:00:23.67,Default,,0,0,0,,Айкацуды меңгеру үшін шетелде білім алған Йомейсаки-чан қайтып келді!
Dialogue: 0,0:00:23.98,0:00:25.09,Default,,0,0,0,,Себебі таң қалдырады!
Dialogue: 0,0:00:25.25,0:00:27.14,Default,,0,0,0,,Өйткені менің Хана мені шабыттандырды!
Dialogue: 0,0:00:27.62,0:00:31.48,Default,,0,0,0,,Сонымен қатар, жаңа аватар арқылы мен Ikats ойынын тағы бір рет нөлден бастаймын!
Dialogue: 0,0:00:32.37,0:00:35.64,Default,,0,0,0,,Акисаки-чанның ең жақсы қарсыласы Айю-чан да қызып кетті
Dialogue: 0,0:00:35.80,0:00:39.74,Default,,0,0,0,,Олар Икатацу әлеміндегі ең қиын планета марафонында таңғажайып сахнаға шықты!
Dialogue: 0,0:00:42.86,0:00:44.37,Default,,0,0,0,,Міне, мәселе.
Dialogue: 0,0:00:44.70,0:00:46.09,Default,,0,0,0,,Бүгін аптаның қай күні?
Dialogue: 0,0:00:46.23,0:00:46.94,Default,,0,0,0,,жексенбі
Dialogue: 0,0:00:47.11,0:00:49.01,Default,,0,0,0,,Бірақ форма неге?
Dialogue: 0,0:00:49.16,0:00:51.66,Default,,0,0,0,,Мен жаттығу залында котлет жаттығуларын жасауды ойлап жүрмін!
Dialogue: 0,0:00:51.94,0:00:54.15,Default,,0,0,0,,Шиори мен басқаларға қарағанда, мен кеттім!
Dialogue: 0,0:00:54.41,0:00:55.23,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:00:55.40,0:00:59.93,Default,,0,0,0,,Неліктен таңғы ас ішіп отырып, бөлмеңде қыдырып жүрсің?
Dialogue: 0,0:01:00.08,0:01:01.85,Default,,0,0,0,,Мен бір орында тұра алмайтын сияқтымын!
Dialogue: 0,0:01:02.17,0:01:05.43,Default,,0,0,0,,Өйткені бұл Акацуки-чан өзінің Айкацу Planet-те қайтадан дебют жасауда!
Dialogue: 0,0:01:05.70,0:01:07.78,Default,,0,0,0,,Бүкіл әлем дүр сілкіндіреді!
Dialogue: 0,0:01:07.96,0:01:09.93,Default,,0,0,0,,Мен де қатты толқыдым.
Dialogue: 0,0:01:10.59,0:01:11.70,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:01:12.23,0:01:16.10,Default,,0,0,0,,ｱｲｶﾂ ｱｲｶﾂ ｱｲｶﾂ…
Dialogue: 0,0:01:18.50,0:01:19.55,Default,,0,0,0,,Акисаки-чан?
Dialogue: 0,0:01:22.09,0:01:23.05,Default,,0,0,0,,(Хироко) Һм? О…
Dialogue: 0,0:01:24.22,0:01:29.54,Default,,0,0,0,,Иә, мен бұл бұлттар таза Феникске ұқсайды деп ойладым.
Dialogue: 0,0:01:33.28,0:01:36.90,Default,,0,0,0,,Қараңдаршы, анау кішкентай нәрсе қауырсын.
Dialogue: 0,0:01:37.08,0:01:39.18,Default,,0,0,0,,Қауырсындар мен құйрықтар
Dialogue: 0,0:01:40.00,0:01:41.55,Default,,0,0,0,,Бірақ мен осы тасбақамен денемізді алмастырдым
Dialogue: 0,0:01:41.96,0:01:44.86,Default,,0,0,0,,Мм, мұны қалай айта аламын...
Dialogue: 0,0:01:44.99,0:01:46.18,Default,,0,0,0,,Маған бірдеңеде сенің көмегің керек!
Dialogue: 0,0:01:46.36,0:01:47.07,Default,,0,0,0,,Майзакура
Dialogue: 0,0:01:47.45,0:01:48.35,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:26.13,0:03:27.69,Default,,0,0,0,,Бұл көп жүк.
Dialogue: 0,0:03:28.87,0:03:30.54,Default,,0,0,0,,Жабдықтауды салыстыратын тарап?
Dialogue: 0,0:03:31.08,0:03:32.20,Default,,0,0,0,,Изумимен бе?
Dialogue: 0,0:03:32.54,0:03:35.68,Default,,0,0,0,,Мен хатты ғана қалдырып, кабинеттен жүгіріп шықтым.
Dialogue: 0,0:03:36.35,0:03:40.55,Default,,0,0,0,,Изуми-сан да менің сыртқы келбетіме жауапкершілікті сезінгендей.
Dialogue: 0,0:03:41.69,0:03:43.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:44.63,0:03:46.90,Default,,0,0,0,,Изуми-сан, сен бақытты боласың ба?
Dialogue: 0,0:03:47.73,0:03:49.87,Default,,0,0,0,,Бақытты болатыныңызға сенімдімін.
Dialogue: 0,0:03:50.02,0:03:50.80,Default,,0,0,0,,Шынымен!?
Dialogue: 0,0:03:50.96,0:03:51.58,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:03:52.23,0:03:53.00,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:03:53.16,0:03:53.75,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:54.69,0:03:57.51,Default,,0,0,0,,Бүгін Изуми-сан кешке дейін жоқ, солай ма?
Dialogue: 0,0:03:57.78,0:04:00.62,Default,,0,0,0,,Иә! Шиори және басқалармен сұхбаттасу үшін
Dialogue: 0,0:04:03.11,0:04:05.47,Default,,0,0,0,,Олай болса, кеңсеге оралмас бұрын дайындал.
Dialogue: 0,0:04:05.63,0:04:07.58,Default,,0,0,0,,Сонда сен мені таң қалдырғың келіп тұр ғой!?
Dialogue: 0,0:04:09.57,0:04:10.65,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:04:10.85,0:04:12.57,Default,,0,0,0,,Біз сізге көмектесу үшін бар күшімізді саламыз!
Dialogue: 0,0:04:13.16,0:04:14.78,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:04:20.88,0:04:24.62,Default,,0,0,0,,Шетелде оқу кезінде тапқан сүйікті әртүрлі тауарлар немесе кәдесыйлар
Dialogue: 0,0:04:24.76,0:04:26.46,Default,,0,0,0,,Әдемі безендіріңіз
Dialogue: 0,0:04:27.77,0:04:30.37,Default,,0,0,0,,Дүние жүзінен ерекше тағамдар дайындаңыз
Dialogue: 0,0:04:31.44,0:04:35.16,Default,,0,0,0,,Соңында мен Изуми-санға жаңа аватарымды көрсеттім.
Dialogue: 0,0:04:35.70,0:04:37.11,Default,,0,0,0,,Аватар аяқталды!
Dialogue: 0,0:04:37.27,0:04:38.04,Default,,0,0,0,,Жоқ, әлі жоқ.
Dialogue: 0,0:04:38.57,0:04:39.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:39.63,0:04:41.33,Default,,0,0,0,,Ол дайын.
Dialogue: 0,0:04:41.50,0:04:43.85,Default,,0,0,0,,Жарайды, мұнымен барайық, бірақ мен шыдай алмаймын.
Dialogue: 0,0:04:44.24,0:04:47.84,Default,,0,0,0,,Дегенмен, сіз Хана сияқты керемет аватарды жасадыңыз.
Dialogue: 0,0:04:48.00,0:04:50.33,Default,,0,0,0,,Мен ең бірінші оны Изумиге көрсетемін.
Dialogue: 0,0:04:50.51,0:04:54.87,Default,,0,0,0,,Менің ойымша, бұл біз үшін татуласу үшін ең жақсы мүмкіндік болады.
Dialogue: 0,0:04:55.59,0:04:57.13,Default,,0,0,0,,Хабарды жеткізетініңізге сенімдімін!
Dialogue: 0,0:04:59.26,0:05:02.15,Default,,0,0,0,,Асықпасақ, Изуми-сан қайтып келгенше уақытында дайындала алмауымыз мүмкін!
Dialogue: 0,0:05:02.30,0:05:03.18,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:05:03.55,0:05:05.95,Default,,0,0,0,,Тек сенімді болу үшін мен Шиоримен және басқалармен хабарласамын!
Dialogue: 0,0:05:06.30,0:05:08.82,Default,,0,0,0,,Сұхбаттың мазмұнын алдын ала растай аламын ба?
Dialogue: 0,0:05:08.98,0:05:11.28,Default,,0,0,0,,Иә Мына жерден қараңыз
Dialogue: 0,0:05:11.44,0:05:12.24,Default,,0,0,0,,үшін осы, Құрметпен
Dialogue: 0,0:05:12.40,0:05:12.92,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:13.23,0:05:16.17,Default,,0,0,0,,Әңгімелесу аяқталғаннан кейін біз дереу есеп береміз!
Dialogue: 0,0:05:16.33,0:05:17.29,Default,,0,0,0,,ｵｰﾊﾞｰ
Dialogue: 0,0:05:25.59,0:05:26.55,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:05:27.32,0:05:30.91,Default,,0,0,0,,Мен алғаш рет шетелде білім алған кезімде тау етегіндегі шағын ауылда кездестік!
Dialogue: 0,0:05:31.07,0:05:33.42,Default,,0,0,0,,Неке қию рәсімдерінде қолданылған көне сандалдар!
Dialogue: 0,0:05:33.59,0:05:34.94,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:05:35.79,0:05:37.77,Default,,0,0,0,,Оны аспанға көтеріп жатқанда
Dialogue: 0,0:05:37.92,0:05:40.62,Default,,0,0,0,,Күйеу жігіт қалыңдыққа махаббат биін ұсынады!
Dialogue: 0,0:05:40.77,0:05:44.26,Default,,0,0,0,,Мен сол бидің шабытын шынымен сезінемін!
Dialogue: 0,0:05:44.66,0:05:46.46,Default,,0,0,0,,Әй, бұл қандай би деп ойлайсыңдар?
Dialogue: 0,0:05:46.78,0:05:47.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:48.57,0:05:50.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:54.97,0:05:55.94,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:05:56.10,0:05:57.68,Default,,0,0,0,,Ғажайып, ежелгі сезім!
Dialogue: 0,0:05:57.81,0:05:59.93,Default,,0,0,0,,Солай ма? Хехе...
Dialogue: 0,0:06:00.65,0:06:01.73,Default,,0,0,0,,(Сүзүне)
Dialogue: 0,0:06:02.28,0:06:04.87,Default,,0,0,0,,Жарайды... Осындай жақсы әңгіме естігеніме қуаныштымын.
Dialogue: 0,0:06:05.06,0:06:07.07,Default,,0,0,0,,Мүмкін болса, бір уақытта безендіріңіз.
Dialogue: 0,0:06:07.32,0:06:09.30,Default,,0,0,0,,Изуми-санның қайтатын уақыты жақындап қалды.
Dialogue: 0,0:06:09.45,0:06:10.72,Default,,0,0,0,,Тағы, тағы!
Dialogue: 0,0:06:16.92,0:06:17.69,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:06:17.84,0:06:19.62,Default,,0,0,0,,Оңтүстік Америкада табылған жұмбақ арқан!
Dialogue: 0,0:06:20.48,0:06:23.58,Default,,0,0,0,,Бұл тіпті ежелгі өркениеттерде де тәттілер болғанының дәлелі.
Dialogue: 0,0:06:23.75,0:06:25.22,Default,,0,0,0,,Бұл Римдікі, солай емес пе?
Dialogue: 0,0:06:25.37,0:06:29.86,Default,,0,0,0,,Жарайды...олай болса,оның ұстағанын Майкқа ұқсайды деп айта алмаймын...
Dialogue: 0,0:06:30.02,0:06:31.36,Default,,0,0,0,,Әй, ән айтып көріңіз!
Dialogue: 0,0:06:32.19,0:06:32.79,Default,,0,0,0,,Се-жоқ...
Dialogue: 0,0:06:32.93,0:06:33.58,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,0:06:33.73,0:06:34.93,Default,,0,0,0,,Қолдарыңызды жылжытыңыз!
Dialogue: 0,0:06:36.04,0:06:37.85,Default,,0,0,0,,Тамақты дайындау уақыты келді!
Dialogue: 0,0:06:38.57,0:06:39.80,Default,,0,0,0,,Мен мұнымен айналысамын.
Dialogue: 0,0:06:39.98,0:06:41.70,Default,,0,0,0,,Акесаки-чан, оны безендіріңіз!
Dialogue: 0,0:06:43.13,0:06:48.98,Default,,0,0,0,,Материал манок, қаражидек немесе нан жемісі ме?
Dialogue: 0,0:06:49.57,0:06:53.30,Default,,0,0,0,,Бұл туралы мен оңтүстік аралдағы елге тоқтаған кезде білдім!
Dialogue: 0,0:06:53.53,0:06:55.19,Default,,0,0,0,,Оны дәмді етудің сыры
Dialogue: 0,0:06:56.83,0:07:01.27,Default,,0,0,0,,Ән айтып, би билеп тамақ пісіру!
Dialogue: 0,0:07:02.57,0:07:03.90,Default,,0,0,0,,Сол себепті!
Dialogue: 0,0:07:04.58,0:07:07.55,Default,,0,0,0,,Дұрыс, Акесаки-чанның аватары дайын ба?
Dialogue: 0,0:07:08.96,0:07:10.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:11.13,0:07:13.11,Default,,0,0,0,,Қалғанының бәрін жасаймын!
Dialogue: 0,0:07:14.05,0:07:16.60,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:07:17.96,0:07:18.75,Default,,0,0,0,,Бетбелгі?
Dialogue: 0,0:07:18.24,0:07:19.29,Default,,0,0,0,,Майзакура қорқынышты!
Dialogue: 0,0:07:19.45,0:07:21.80,Default,,0,0,0,,Сұхбаттың жақсы өтіп жатқаны сонша, жоспарланған уақыттан ерте аяқталатын сияқты!
Dialogue: 0,0:07:23.77,0:07:24.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:25.57,0:07:27.15,Default,,0,0,0,,Бәрі жақсы, тек соған жол беріңіз.
Dialogue: 0,0:07:27.29,0:07:28.62,Default,,0,0,0,,Изуми-сан, ұстаныңыз!
Dialogue: 0,0:07:28.78,0:07:30.55,Default,,0,0,0,,Жарайды, мен бірдеңе жасап көрейін.
Dialogue: 0,0:07:32.12,0:07:33.69,Default,,0,0,0,,Мен қатты дайындалып жатырмын
Dialogue: 0,0:07:34.41,0:07:36.27,Default,,0,0,0,,Мен еш өкінгім келмейді.
Dialogue: 0,0:07:36.57,0:07:37.44,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:37.61,0:07:39.47,Default,,0,0,0,,Осымен сұхбат аяқталады.
Dialogue: 0,0:07:39.94,0:07:41.13,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:46.03,0:07:49.35,Default,,0,0,0,,Не? Оны созу керек пе?
Dialogue: 0,0:07:50.53,0:07:52.30,Default,,0,0,0,,Ал...
Dialogue: 0,0:07:53.17,0:07:55.45,Default,,0,0,0,,Мүмкін болса...
Dialogue: 0,0:07:55.63,0:08:02.58,Default,,0,0,0,,Біз туралы көбірек білгеніңізді қалаймыз!
Dialogue: 0,0:08:02.96,0:08:03.91,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:05.71,0:08:06.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:23.46,0:08:25.58,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:08:25.94,0:08:26.79,Default,,0,0,0,,Сәлеметсіз бе Шиори?
Dialogue: 0,0:08:26.95,0:08:28.29,Default,,0,0,0,,Артық емес, шектеу!
Dialogue: 0,0:08:29.12,0:08:32.60,Default,,0,0,0,,Мен қораптың бір қадам ғана секіре алатынын білемін.
Dialogue: 0,0:08:32.94,0:08:36.01,Default,,0,0,0,,Менің тестілеудегі ең төменгі ұпайым!
Dialogue: 0,0:08:36.34,0:08:39.61,Default,,0,0,0,,Мен елес сарайда қозғалуға қатты қорықтым.
Dialogue: 0,0:08:39.82,0:08:43.38,Default,,0,0,0,,Аруақ мені жігерлендіргенде өткенге шығу...
Dialogue: 0,0:08:44.04,0:08:47.28,Default,,0,0,0,,Сіз енді біз туралы ештеңе аша алмайсыз!
Dialogue: 0,0:08:48.02,0:08:50.08,Default,,0,0,0,,Акесаки-чан, бұл қиын! Жақында...
Dialogue: 0,0:08:50.24,0:08:51.30,Default,,0,0,0,,Шаш түсі...
Dialogue: 0,0:08:51.64,0:08:54.13,Default,,0,0,0,,Ақыр соңында, ол сәл жарық болуы керек
Dialogue: 0,0:08:54.87,0:08:58.98,Default,,0,0,0,,Ұзындығы... қысқа сезіну.
Dialogue: 0,0:08:59.45,0:09:01.37,Default,,0,0,0,,Үлкен концентрация
Dialogue: 0,0:09:03.09,0:09:05.44,Default,,0,0,0,,Бұл таңданатын уақыт емес!
Dialogue: 0,0:09:06.33,0:09:09.59,Default,,0,0,0,,Егер бұлай болса, менде Изуми-санды тоқтату үшін күшімді пайдаланудан басқа амалым жоқ!
Dialogue: 0,0:09:11.35,0:09:13.05,Default,,0,0,0,,Ум, станция...
Dialogue: 0,0:09:14.19,0:09:15.31,Default,,0,0,0,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,0:09:22.62,0:09:23.85,Default,,0,0,0,,Олар байқамайды
Dialogue: 0,0:09:28.23,0:09:28.68,Default,,0,0,0,,Майзакура!
Dialogue: 0,0:09:28.86,0:09:30.62,Default,,0,0,0,,Иә? Изуми ше?
Dialogue: 0,0:09:30.78,0:09:34.02,Default,,0,0,0,,Мен сізбен біраз уақыт бұрын болдым, бірақ сіз шұғыл жұмыс есіңде қалғанын айттыңыз.
Dialogue: 0,0:09:34.18,0:09:35.91,Default,,0,0,0,,Пойыздан түсіп, таксиге отырыңыз!
Dialogue: 0,0:09:36.22,0:09:40.08,Default,,0,0,0,,Егер бәрі осылай жалғаса берсе, Акисаки жоспарлаған жеткізуді татуластыру партиясы үлкен сәтсіздікке ұшырайды!
Dialogue: 0,0:09:40.24,0:09:41.95,Default,,0,0,0,,Тезірек Изумиді тоқтатуымыз керек.
Dialogue: 0,0:09:45.90,0:09:47.99,Default,,0,0,0,,Изуми осылай деді.
Dialogue: 0,0:09:48.67,0:09:51.22,Default,,0,0,0,,Иә, мен мұнымен барамын.
Dialogue: 0,0:09:52.06,0:09:55.07,Default,,0,0,0,,Бүкіл әлемге әйгілі Йомейсакидің сеніміне ие болу.
Dialogue: 0,0:09:55.23,0:09:56.60,Default,,0,0,0,,Қандай құрмет
Dialogue: 0,0:09:58.65,0:10:00.50,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:02.98,0:10:04.32,Default,,0,0,0,,Неге ол бізді өзінен алыстатқысы келеді?
Dialogue: 0,0:10:04.48,0:10:07.84,Default,,0,0,0,,Майо Мен жаңа аватарды таңдауда қиындықтарға тап болдым.
Dialogue: 0,0:10:08.10,0:10:10.41,Default,,0,0,0,,Изуми-сан жаңа ғана қайтып келіп, менімен кеңесіп отырды.
Dialogue: 0,0:10:10.65,0:10:12.44,Default,,0,0,0,,Сізге рахмет, ол аяқталды!
Dialogue: 0,0:10:13.12,0:10:14.34,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:10:14.51,0:10:16.89,Default,,0,0,0,,Рури Киоко Қалайсың?
Dialogue: 0,0:10:17.05,0:10:17.73,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:17.88,0:10:19.85,Default,,0,0,0,,Акесаки-санның да жағдайы жақсы сияқты.
Dialogue: 0,0:10:20.35,0:10:21.30,Default,,0,0,0,,Шиори!
Dialogue: 0,0:10:21.72,0:10:22.95,Default,,0,0,0,,ﾅｲｽ ﾄｩｰ ﾐｰﾄ ﾕｰ！
Dialogue: 0,0:10:23.36,0:10:24.65,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:10:24.82,0:10:25.95,Default,,0,0,0,,Мен дебюттік кезеңді көрдім!
Dialogue: 0,0:10:26.12,0:10:26.81,Default,,0,0,0,,Керемет!
Dialogue: 0,0:10:27.19,0:10:30.26,Default,,0,0,0,,Уау! Кірпіктер ұзын!
Dialogue: 0,0:10:30.75,0:10:32.01,Default,,0,0,0,,Акисаки-чан
Dialogue: 0,0:10:32.90,0:10:36.76,Default,,0,0,0,,Изуми үшін жеткізуді келісу партиясы туралы не деуге болады?
Dialogue: 0,0:10:39.34,0:10:41.32,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Көз
Dialogue: 0,0:10:53.98,0:10:58.24,Default,,0,0,0,,Мен де оны дұрыс қарсы алғым келді.
Dialogue: 0,0:10:59.70,0:11:01.34,Default,,0,0,0,,Кешіріңіз Акесаки
Dialogue: 0,0:11:02.37,0:11:06.43,Default,,0,0,0,,Сезімдеріңнен бұрыла бердім
Dialogue: 0,0:11:07.62,0:11:09.84,Default,,0,0,0,,Татуласушы партиямыз болмаса да
Dialogue: 0,0:11:10.01,0:11:13.08,Default,,0,0,0,,Екеуі өздерінің аватарлары туралы әңгімелесіп, дауыстары қуанышты естілді.
Dialogue: 0,0:11:13.25,0:11:14.91,Default,,0,0,0,,Ол кездегідей болды ма?
Dialogue: 0,0:11:15.27,0:11:16.60,Default,,0,0,0,,Онда болды ма?
Dialogue: 0,0:11:16.85,0:11:19.06,Default,,0,0,0,,Бөлмеме күлкі жетті.
Dialogue: 0,0:11:25.01,0:11:26.84,Default,,0,0,0,,Изюмин меннен сұрады
Dialogue: 0,0:11:32.12,0:11:33.40,Default,,0,0,0,,Бұл көйлек...
Dialogue: 0,0:11:43.17,0:11:44.85,Default,,0,0,0,,Раушан суреті
Dialogue: 0,0:11:48.17,0:11:51.30,Default,,0,0,0,,Бұл жанкүйерден алған алғашқы сыйлық болды.
Dialogue: 0,0:11:52.84,0:11:54.79,Default,,0,0,0,,Бір қыз
Dialogue: 0,0:11:55.43,0:11:59.20,Default,,0,0,0,,Қалтасының ақшасын қатты жинап, маған сыйлық берді.
Dialogue: 0,0:12:01.18,0:12:03.24,Default,,0,0,0,,Бұл бір ғана раушан гүлі еді.
Dialogue: 0,0:12:06.76,0:12:08.64,Default,,0,0,0,,Сол кезден асыл раушан
Dialogue: 0,0:12:08.95,0:12:12.68,Default,,0,0,0,,Мен оны жаңа аватарыңызда да алғыңыз келеді деп ойладым.
Dialogue: 0,0:12:14.00,0:12:15.88,Default,,0,0,0,,Ханадан кеткен кезде
Dialogue: 0,0:12:16.45,0:12:18.96,Default,,0,0,0,,Өзіңіз ретінде дебют жасағанда
Dialogue: 0,0:12:32.88,0:12:34.60,Default,,0,0,0,,Рахмет, Изуми-сан
Dialogue: 0,0:12:40.21,0:12:47.71,Default,,0,0,0,,Сүйікті Хананы Майоға сеніп тапсырғаның үшін рахмет.
Dialogue: 0,0:13:00.19,0:13:02.41,Default,,0,0,0,,Татуласу жақсы өткен сияқты.
Dialogue: 0,0:13:02.75,0:13:05.64,Default,,0,0,0,,Жеткізу сәтті болмады.
Dialogue: 0,0:13:05.98,0:13:10.37,Default,,0,0,0,,Егер солай болса, неге Акисаки-чанның Aikatsuplanet қайта дебютін бермейсіз?
Dialogue: 0,0:13:10.87,0:13:12.36,Default,,0,0,0,,Барлық жанкүйерлер үшін!
Dialogue: 0,0:13:12.51,0:13:14.19,Default,,0,0,0,,Иә, бұл жақсы!
Dialogue: 0,0:13:24.54,0:13:27.10,Default,,0,0,0,,Уф! Шайқаймыз!
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Драма
Dialogue: 0,0:16:46.08,0:16:47.83,Default,,0,0,0,,Эй, сен мұны естідің бе?
Dialogue: 0,0:16:47.99,0:16:49.98,Default,,0,0,0,,Бүгінгі Рури шайқас кезеңіндегі қарсылас
Dialogue: 0,0:16:50.15,0:16:51.67,Default,,0,0,0,,Бұл жаңа пұт!
Dialogue: 0,0:16:51.87,0:16:53.62,Default,,0,0,0,,Мм... Роза?
Dialogue: 0,0:16:54.29,0:16:55.21,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:16:53.64,0:16:55.90,Default,,0,0,0,,ﾛ… ﾛｰｽﾞ？
Dialogue: 0,0:16:56.43,0:17:01.11,Default,,0,0,0,,Қызық, осындай жаңадан шыққан кумир Рури-санның серіктесі бола ма?
Dialogue: 0,0:17:01.38,0:17:05.34,Default,,0,0,0,,Бұл ең әсерлі кезең болуы мүмкін.
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Драма
Dialogue: 0,0:21:47.81,0:21:49.99,Default,,0,0,0,,Роуздың шынайы тұлғасы - Акисаки!?
Dialogue: 0,0:21:50.18,0:21:51.55,Default,,0,0,0,,Бұл мағынасы бар!
Dialogue: 0,0:21:51.83,0:21:54.20,Default,,0,0,0,,Ең әсерлі кезең
Dialogue: 0,0:21:54.83,0:21:57.03,Default,,0,0,0,,Дәл Айю болжағандай...
Dialogue: 0,0:21:58.58,0:22:00.50,Default,,0,0,0,,Менің болжам қате болды.
Dialogue: 0,0:22:03.98,0:22:06.38,Default,,0,0,0,,әлдеқайда асып кетті
Dialogue: 0,0:23:56.83,0:23:57.47,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:23:57.64,0:23:59.14,Default,,0,0,0,,Менің сәнді раушаным
Dialogue: 0,0:23:59.36,0:24:01.95,Default,,0,0,0,,Міне, енді бәрі бітті!
Dialogue: 0,0:24:02.12,0:24:02.71,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:24:02.95,0:24:04.31,Default,,0,0,0,,Бұл өте керемет!
Dialogue: 0,0:24:04.49,0:24:06.06,Default,,0,0,0,,Сіз түсінесіз!
Dialogue: 0,0:24:06.98,0:24:08.06,Default,,0,0,0,,үшін бірге
Dialogue: 0,0:24:08.22,0:24:09.23,Default,,0,0,0,,ﾐﾗｰｲﾝ！
Dialogue: 0,0:19:38.01,0:19:44.98,Default,,0,0,0,,Аспанға қарап, басталуын хабарлаған таңның кобальт көкі
Dialogue: 0,0:19:45.49,0:19:52.43,Default,,0,0,0,,Жер-Анаға қадам басу Иночи толқынын сезіну
Dialogue: 0,0:19:53.10,0:19:55.81,Default,,0,0,0,,Күн мен жел ырғағы
Dialogue: 0,0:19:55.96,0:20:00.17,Default,,0,0,0,,Жан соғуын үндестіргеннен кейін
Dialogue: 0,0:20:00.64,0:20:07.37,Default,,0,0,0,,Бүгінгі беймәлімге ұшқан қанаттардың әні шырқалады
Dialogue: 0,0:20:07.66,0:20:10.79,Default,,0,0,0,,Мүмкін, Мүмкін Бұл біреудің дауысы емес
Dialogue: 0,0:20:11.40,0:20:14.79,Default,,0,0,0,,Тек менің ішкі дауысыма
Dialogue: 0,0:20:15.15,0:20:22.29,Default,,0,0,0,,Мен таза ақылмен өмір сүргім келеді.
Dialogue: 0,0:20:24.47,0:20:26.25,Default,,0,0,0,,Сіз өзіңіздің ішкі дауысыңызды сезіне аласыз ба?
Dialogue: 0,0:20:26.40,0:20:28.16,Default,,0,0,0,,Құштарлықпен адал
Dialogue: 0,0:20:28.33,0:20:29.85,Default,,0,0,0,,Қазір билеймін ＆ Қазір ән айтамын
Dialogue: 0,0:20:30.02,0:20:31.79,Default,,0,0,0,,Би билейік
Dialogue: 0,0:20:32.08,0:20:35.66,Default,,0,0,0,,Әркім өз тағдырының басты тұлғасы
Dialogue: 0,0:20:35.83,0:20:39.29,Default,,0,0,0,,Жарқыраған әуенді киіп
Dialogue: 0,0:20:39.54,0:20:41.31,Default,,0,0,0,,Мен өзімнің ішкі дауысымды сезінемін
Dialogue: 0,0:20:41.48,0:20:43.18,Default,,0,0,0,,Гүлдер жайнаған
Dialogue: 0,0:20:43.34,0:20:48.72,Default,,0,0,0,,Төгілген жаңа тамшылар жеңіл секіреді.
Dialogue: 0,0:20:48.89,0:20:54.25,Default,,0,0,0,,Бұрын-соңды болмаған ұлы мұхитқа қосылу
Dialogue: 0,0:20:54.83,0:20:58.27,Default,,0,0,0,,Кикоэру Кикоэруё Кибо Джиюу Мираи
Dialogue: 0,0:20:58.46,0:21:01.74,Default,,0,0,0,,Мен не нәрсеге сенсем де…
Dialogue: 0,0:21:02.19,0:21:05.83,Default,,0,0,0,,Жалғыздық пен оның бәрінен асып түсетін жарқырау
Dialogue: 0,0:21:06.03,0:21:07.41,Default,,0,0,0,,Білетініңізге сенімдімін.
Dialogue: 0,0:21:07.59,0:21:09.30,Default,,0,0,0,,Мен арманды орындаймын
Dialogue: 0,0:19:38.01,0:19:44.98,Default,,0,0,0,,Декларацияның таңында аспан шатырға көтеріледі.
Dialogue: 0,0:19:45.49,0:19:52.43,Default,,0,0,0,,Жердегі тіршілік толқындары ана
Dialogue: 0,0:19:53.10,0:19:55.81,Default,,0,0,0,,Күн мен жел әуені
Dialogue: 0,0:19:55.96,0:20:00.17,Default,,0,0,0,,Барлық жан бірге соқты
Dialogue: 0,0:20:00.64,0:20:07.37,Default,,0,0,0,,Ұшып барады бүгін белгісізге, Қанат қағып
Dialogue: 0,0:20:07.66,0:20:10.79,Default,,0,0,0,,Нами - басқа адамның ән айтатын дауысы
Dialogue: 0,0:20:11.40,0:20:14.79,Default,,0,0,0,,Жай ғана өз-өзіне интроверт дауыс
Dialogue: 0,0:20:15.15,0:20:22.29,Default,,0,0,0,,Менің ойым анық
Dialogue: 0,0:20:24.47,0:20:26.25,Default,,0,0,0,,Жүрегіңізге жете аласыз ба?
Dialogue: 0,0:20:26.40,0:20:28.16,Default,,0,0,0,,Құмарлы жер
Dialogue: 0,0:20:28.33,0:20:29.85,Default,,0,0,0,,Секіру, ән айту
Dialogue: 0,0:20:30.02,0:20:31.79,Default,,0,0,0,,Оян
Dialogue: 0,0:20:32.08,0:20:35.66,Default,,0,0,0,,Әр адамның өз өмірін басқару жоспары бар.
Dialogue: 0,0:20:35.83,0:20:39.29,Default,,0,0,0,,Жарқыраған әуенді сүйемелдеу
Dialogue: 0,0:20:39.54,0:20:41.31,Default,,0,0,0,,Жүрегімнің үні
Dialogue: 0,0:20:41.48,0:20:43.18,Default,,0,0,0,,Ашулы ашу
Dialogue: 0,0:20:43.34,0:20:48.72,Default,,0,0,0,,Су тамшылары қайтадан басталады
Dialogue: 0,0:20:48.89,0:20:54.25,Default,,0,0,0,,Бұрын-соңды болмаған жаңбыр суы бар мұхит
Dialogue: 0,0:20:54.83,0:20:58.27,Default,,0,0,0,,Бостандыққа үміттенеміз
Dialogue: 0,0:20:58.46,0:21:01.74,Default,,0,0,0,,Мен қашан бастадым?
Dialogue: 0,0:21:02.19,0:21:05.83,Default,,0,0,0,,Жалғыздық және жақсы жарық
Dialogue: 0,0:21:06.03,0:21:07.41,Default,,0,0,0,,Жеткен бойда жүрегімді білдім.
Dialogue: 0,0:21:07.59,0:21:09.30,Default,,0,0,0,,Гааи Аокидің арманы
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,---------------------------------------------------------------------------------------------------------------------
