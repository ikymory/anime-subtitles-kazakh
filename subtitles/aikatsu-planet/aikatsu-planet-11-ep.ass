Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.24,0:00:05.13,Default,,0,0,0,,Табыстың өзін-өзі орталықтандыру аймағы
Dialogue: 0,0:00:05.34,0:00:06.44,Default,,0,0,0,,Идол белсендіруші жұлдыз сферасы!
Dialogue: 0,0:00:06.60,0:00:07.61,Default,,0,0,0,,Бастапқы нүкте
Dialogue: 0,0:00:08.95,0:00:09.99,Default,,0,0,0,,...
Dialogue: 0,0:00:11.18,0:00:12.63,Default,,0,0,0,,Жоғарғы шеңбер оқиғасы!
Dialogue: 0,0:00:13.10,0:00:15.77,Default,,0,0,0,,Күннің шығуы, Сакина, кішкентай гүлдерім оқиғасы
Dialogue: 0,0:00:15.96,0:00:17.91,Default,,0,0,0,,Әңгіменің соңы түсінікті.
Dialogue: 0,0:00:18.74,0:00:22.06,Default,,0,0,0,,Қожайынның қазіргі гүл туралы түсінігі туралы ойлана отырып, менің сезімдерім жетті.
Dialogue: 0,0:00:22.81,0:00:25.04,Default,,0,0,0,,Ұйымдастыруға, күш-жігерді қайта бастауға және кездейсоқ әрекеттерге деген сүйіспеншілік.
Dialogue: 0,0:00:31.22,0:00:32.22,Default,,0,0,0,,Хаян
Dialogue: 0,0:00:32.39,0:00:33.60,Default,,0,0,0,,Хаян
Dialogue: 0,0:00:35.11,0:00:36.77,Default,,0,0,0,,...
Dialogue: 0,0:00:39.89,0:00:41.80,Default,,0,0,0,,Будданың махаббат пен шай әңгімесіне қатысуы
Dialogue: 0,0:00:42.70,0:00:44.72,Default,,0,0,0,,Бүгін тірі кім?
Dialogue: 0,0:00:45.05,0:00:47.70,Default,,0,0,0,,Шайқас аяқталды.
Dialogue: 0,0:00:48.29,0:00:49.68,Default,,0,0,0,,An!
Dialogue: 0,0:00:50.19,0:00:51.50,Default,,0,0,0,,Мен сізге кенеттен келдім.
Dialogue: 0,0:00:53.01,0:00:55.52,Default,,0,0,0,,Жақсы бейне – төтенше жағдай туралы әңгіме.
Dialogue: 0,0:00:56.51,0:00:57.63,Default,,0,0,0,,Мен не істеймін?
Dialogue: 0,0:00:57.80,0:01:00.72,Default,,0,0,0,,Кішкентай апа шығарған
Dialogue: 0,0:01:01.07,0:01:03.42,Default,,0,0,0,,...
Dialogue: 0,0:01:03.60,0:01:04.63,Default,,0,0,0,,Жойылған ба?
Dialogue: 0,0:01:04.89,0:01:07.64,Default,,0,0,0,,Махаббат деген не?
Dialogue: 0,0:01:07.80,0:01:11.77,Default,,0,0,0,,...
Dialogue: 0,0:02:43.03,0:02:48.02,Default,,0,0,0,,Жұмсақ жүрек
Dialogue: 0,0:02:49.61,0:02:52.23,Default,,0,0,0,,Менің кім екенімді айтуға болады.
Dialogue: 0,0:02:52.43,0:02:56.64,Default,,0,0,0,,Өріктің уақыт пен энергияны қарызға алу қабілеті
Dialogue: 0,0:02:56.89,0:02:58.34,Default,,0,0,0,,...
Dialogue: 0,0:02:58.66,0:03:01.74,Default,,0,0,0,,Киіміңді киюге дайынсың ба?
Dialogue: 0,0:03:02.61,0:03:05.40,Default,,0,0,0,,Махаббат - махаббат хикаясы
Dialogue: 0,0:03:05.57,0:03:08.93,Default,,0,0,0,,Бұл үлкен жүрек соғысы!
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Аниме
Dialogue: 0,0:03:10.48,0:03:13.11,Default,,0,0,0,,Сүйкімді тәтті жұмыртқа мұнарасы кішкентай әпке
Dialogue: 0,0:03:14.40,0:03:17.02,Default,,0,0,0,,Сіздің несие сатып алу мүмкіндігіңіз
Dialogue: 0,0:03:17.39,0:03:19.80,Default,,0,0,0,,Махаббат? Жұмысқа қалай жетуге болады?
Dialogue: 0,0:03:20.04,0:03:20.77,Default,,0,0,0,,...
Dialogue: 0,0:03:20.92,0:03:22.61,Default,,0,0,0,,Маңыздысы ғана!
Dialogue: 0,0:03:22.84,0:03:24.76,Default,,0,0,0,,Сәлем мен!
Dialogue: 0,0:03:24.92,0:03:30.17,Default,,0,0,0,,Менің ойларым өте сәнді.
Dialogue: 0,0:03:30.36,0:03:32.18,Default,,0,0,0,,Бұл үлкен қала...
Dialogue: 0,0:03:32.35,0:03:33.06,Default,,0,0,0,,Теншин
Dialogue: 0,0:03:33.23,0:03:33.80,Default,,0,0,0,,...
Dialogue: 0,0:03:34.17,0:03:36.68,Default,,0,0,0,,Теншиннің сөзін бір жолдан оқуға болады.
Dialogue: 0,0:03:36.85,0:03:38.89,Default,,0,0,0,,Сіз жұмыс істеуге дайынсыз ба?
Dialogue: 0,0:03:39.34,0:03:39.93,Default,,0,0,0,,...
Dialogue: 0,0:03:40.09,0:03:42.72,Default,,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:03:43.01,0:03:44.29,Default,,0,0,0,,Жақсы жүгіру
Dialogue: 0,0:03:44.50,0:03:45.75,Default,,0,0,0,,...
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Драма
Dialogue: 0,0:03:49.74,0:03:53.23,Default,,0,0,0,,...
Dialogue: 0,0:03:53.40,0:03:56.91,Default,,0,0,0,,Егер сізде кездесу болмаса, біраз күтіңіз.
Dialogue: 0,0:03:57.52,0:03:59.81,Default,,0,0,0,,Заңның бұзылуының шығу тегі
Dialogue: 0,0:04:00.56,0:04:02.12,Default,,0,0,0,,Пісірілген дим сом
Dialogue: 0,0:04:02.44,0:04:04.30,Default,,0,0,0,,...
Dialogue: 0,0:04:04.45,0:04:07.57,Default,,0,0,0,,Қоспаны араластыру
Dialogue: 0,0:04:07.76,0:04:09.59,Default,,0,0,0,,Жағдайдың тыныштығы
Dialogue: 0,0:04:10.04,0:04:13.61,Default,,0,0,0,,Ойды ойлап тапқаннан кейін мен ойға келдім.
Dialogue: 0,0:04:14.44,0:04:20.48,Default,,0,0,0,,Бір жерде жүргенде таудың алдыңғы жағы туралы не ойлайсың?
Dialogue: 0,0:04:20.68,0:04:23.24,Default,,0,0,0,,Бұл сәтсіздіктің себептері келесідей:
Dialogue: 0,0:04:24.39,0:04:27.34,Default,,0,0,0,,Мен не істерімді білмеймін...
Dialogue: 0,0:04:29.20,0:04:34.00,Default,,0,0,0,,т.б. Қазіргі кезеңдегі шайқас сәтті емес.
Dialogue: 0,0:04:34.39,0:04:35.36,Default,,0,0,0,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:04:35.52,0:04:36.55,Default,,0,0,0,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:04:36.83,0:04:42.28,Default,,0,0,0,,Сондықтан қауіпсіз және бар болу үшін тәтті жұмыртқаларды алу үшін белгілі бір қабілет қажет.
Dialogue: 0,0:04:42.61,0:04:45.68,Default,,0,0,0,,Мен спектакльдің костюмдерін көрдім.
Dialogue: 0,0:04:45.96,0:04:48.49,Default,,0,0,0,,Бұл үлкен мәселе ме?
Dialogue: 0,0:04:48.85,0:04:50.82,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:51.05,0:04:56.57,Default,,0,0,0,,Дегенмен, маған бұлай істеуге рұқсат жоқ екенін түсініңіз.
Dialogue: 0,0:04:57.14,0:05:01.82,Default,,0,0,0,,Гава Шоқанның күтпеген оқиғасы Йохи Анзу түні дедо
Dialogue: 0,0:05:06.19,0:05:07.27,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:05:09.16,0:05:10.62,Default,,0,0,0,,Оларды таба аламыз ба, Мелони?
Dialogue: 0,0:05:10.78,0:05:14.79,Default,,0,0,0,,Тәтті жұмыртқа құрылыс мұнарасының сұлулығын Аспан тау деп айтуға болады
Dialogue: 0,0:05:14.97,0:05:17.12,Default,,0,0,0,,Жалғыздық туралы ойлау
Dialogue: 0,0:05:17.45,0:05:19.99,Default,,0,0,0,,Жалғыз тәкаппарлық іс емес
Dialogue: 0,0:05:20.35,0:05:23.45,Default,,0,0,0,,...
Dialogue: 0,0:05:23.62,0:05:25.00,Default,,0,0,0,,Сатып алудың мүмкін бағасы
Dialogue: 0,0:05:25.18,0:05:27.08,Default,,0,0,0,,Пұт та екеуінің бірі ме?
Dialogue: 0,0:05:27.89,0:05:29.50,Default,,0,0,0,,Егер сіз білмесеңіз...
Dialogue: 0,0:05:30.11,0:05:32.92,Default,,0,0,0,,Уақыт пен энергияны өзін-өзі тану
Dialogue: 0,0:05:33.12,0:05:34.78,Default,,0,0,0,,Дәстүрлі емес таңдау
Dialogue: 0,0:05:35.22,0:05:39.74,Default,,0,0,0,,Мен де өзім жасаған костюмдерді кигім келеді.
Dialogue: 0,0:05:39.98,0:05:42.97,Default,,0,0,0,,Затты қайдан сатып алуға болады
Dialogue: 0,0:05:43.21,0:05:44.87,Default,,0,0,0,,“”...
Dialogue: 0,0:05:45.51,0:05:49.27,Default,,0,0,0,,Сіз аузыңызға медитация жасауды білесіз бе?
Dialogue: 0,0:05:49.82,0:05:51.72,Default,,0,0,0,,...
Dialogue: 0,0:05:52.71,0:05:56.23,Default,,0,0,0,,«Мен әлемдегі ең тәттімін».
Dialogue: 0,0:05:56.52,0:05:58.81,Default,,0,0,0,,Әлемдегі бірінші тәтті?
Dialogue: 0,0:05:59.56,0:06:04.83,Default,,0,0,0,,...
Dialogue: 0,0:06:05.10,0:06:08.51,Default,,0,0,0,,Ағылшын тілінің тәттісі мынау ма?
Dialogue: 0,0:06:09.15,0:06:12.11,Default,,0,0,0,,Дим қосындысы күңгірт қосынды...
Dialogue: 0,0:06:12.29,0:06:13.01,Default,,0,0,0,,Тәтті?
Dialogue: 0,0:06:13.40,0:06:15.82,Default,,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:06:15.99,0:06:18.35,Default,,0,0,0,,Бөлек? Менің ойларым...
Dialogue: 0,0:06:19.02,0:06:22.68,Default,,0,0,0,,Сұлулық, сүйіспеншілік, жұмсақтық, жұмсақтық
Dialogue: 0,0:06:23.57,0:06:25.84,Default,,0,0,0,,Қалада адасу оңай.
Dialogue: 0,0:06:26.53,0:06:29.68,Default,,0,0,0,,Ол жылы және жұмсақ, бірақ ол жерде жоқ.
Dialogue: 0,0:06:30.09,0:06:31.92,Default,,0,0,0,,НАСА кездесуі
Dialogue: 0,0:06:33.27,0:06:36.42,Default,,0,0,0,,Бірінші нұсқаны қолданып көрдіңіз бе?
Dialogue: 0,0:06:37.25,0:06:41.65,Default,,0,0,0,,Себебі, біз қазір шикізатпен жұмыс істеп жатырмыз.
Dialogue: 0,0:06:41.81,0:06:42.62,Default,,0,0,0,,Қазіргі уақытта зейнеткер ме?
Dialogue: 0,0:06:42.93,0:06:44.04,Default,,0,0,0,,Өнімділікті көрсету?\N10-бөлім
Dialogue: 0,0:06:44.21,0:06:48.43,Default,,0,0,0,,...
Dialogue: 0,0:06:48.97,0:06:51.25,Default,,0,0,0,,Үш адам да есептерін аяқтады ма?
Dialogue: 0,0:06:51.79,0:06:53.78,Default,,0,0,0,,Дим сомға дайынсыз ба?
Dialogue: 0,0:06:57.95,0:06:58.94,Default,,0,0,0,,...
Dialogue: 0,0:06:59.36,0:07:00.56,Default,,0,0,0,,Өсу әлеуеті
Dialogue: 0,0:07:03.16,0:07:07.18,Default,,0,0,0,,...
Dialogue: 0,0:07:08.51,0:07:12.07,Default,,0,0,0,,...
Dialogue: 0,0:07:22.31,0:07:25.09,Default,,0,0,0,,Кожи баспасы
Dialogue: 0,0:07:25.25,0:07:26.24,Default,,0,0,0,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:07:26.83,0:07:29.66,Default,,0,0,0,,Ұн
Dialogue: 0,0:07:35.67,0:07:37.60,Default,,0,0,0,,Токай Йодай аяқталды...
Dialogue: 0,0:07:37.88,0:07:39.74,Default,,0,0,0,,Жобаның уақыты келді ме?
Dialogue: 0,0:07:40.25,0:07:43.68,Default,,0,0,0,,Өріктің күңгірт соммасы
Dialogue: 0,0:07:43.96,0:07:47.33,Default,,0,0,0,,Мен ұсынған жарқын спектакльден кейін
Dialogue: 0,0:07:48.41,0:07:50.78,Default,,0,0,0,,Сүйікті Дим Сам...
Dialogue: 0,0:07:51.21,0:07:52.60,Default,,0,0,0,,Әрекет жоқ
Dialogue: 0,0:08:01.14,0:08:02.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:02.60,0:08:03.60,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:08:03.76,0:08:05.24,Default,,0,0,0,,Бұл өзімшілдік пе?
Dialogue: 0,0:08:05.67,0:08:06.54,Default,,0,0,0,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:08:06.71,0:08:08.73,Default,,0,0,0,,...
Dialogue: 0,0:08:08.90,0:08:11.04,Default,,0,0,0,,Минокава мырза, сіз бос па?
Dialogue: 0,0:08:12.53,0:08:13.30,Default,,0,0,0,,...
Dialogue: 0,0:08:13.54,0:08:16.52,Default,,0,0,0,,Сізге дим сом ұнай ма?
Dialogue: 0,0:08:22.84,0:08:27.33,Default,,0,0,0,,Шартты жағдай...
Dialogue: 0,0:08:29.26,0:08:32.48,Default,,0,0,0,,...
Dialogue: 0,0:08:33.39,0:08:35.22,Default,,0,0,0,,Қатысу қажет
Dialogue: 0,0:08:36.06,0:08:38.17,Default,,0,0,0,,Майка Сяодзи Цяогу №.
Dialogue: 0,0:08:38.33,0:08:40.06,Default,,0,0,0,,Төтенше жағдай
Dialogue: 0,0:08:41.84,0:08:45.08,Default,,0,0,0,,Шартты жағдай...
Dialogue: 0,0:08:46.19,0:08:49.50,Default,,0,0,0,,Шартты жағдай...
Dialogue: 0,0:09:02.04,0:09:03.48,Default,,0,0,0,,Қолдан жасалған
Dialogue: 0,0:09:06.37,0:09:07.71,Default,,0,0,0,,Қосылған май
Dialogue: 0,0:09:07.92,0:09:08.49,Default,,0,0,0,,Қосылған май
Dialogue: 0,0:09:09.13,0:09:10.42,Default,,0,0,0,,...
Dialogue: 0,0:09:10.54,0:09:11.56,Default,,0,0,0,,жақсы мінезді
Dialogue: 0,0:09:21.01,0:09:22.27,Default,,0,0,0,,Менің біртүрлі жемісім
Dialogue: 0,0:09:22.43,0:09:23.15,Default,,0,0,0,,Біртүрлі нәтижелер?
Dialogue: 0,0:09:31.86,0:09:32.78,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:09:32.94,0:09:33.75,Default,,0,0,0,,Жақсы таяқ
Dialogue: 0,0:09:50.26,0:09:51.69,Default,,0,0,0,,...
Dialogue: 0,0:09:51.95,0:09:52.73,Default,,0,0,0,,және интернатта тұратын оқушылар мен күндізгі бөлімде оқитындар арасында шиеленіс бар.
Dialogue: 0,0:09:52.88,0:09:53.62,Default,,0,0,0,,Аняның үйіне қош келдіңіз
Dialogue: 0,0:09:53.79,0:09:54.90,Default,,0,0,0,,Жақсы таяқша сезімі
Dialogue: 0,0:09:57.08,0:09:57.99,Default,,0,0,0,,Жақында
Dialogue: 0,0:09:58.47,0:10:01.15,Default,,0,0,0,,Идол әрекеті!
Dialogue: 0,0:10:04.35,0:10:05.57,Default,,0,0,0,,Пайдалы таяқ
Dialogue: 0,0:10:05.74,0:10:07.61,Default,,0,0,0,,...
Dialogue: 0,0:10:07.76,0:10:08.82,Default,,0,0,0,,Хош иіс
Dialogue: 0,0:10:13.32,0:10:15.27,Default,,0,0,0,,...
Dialogue: 0,0:10:15.42,0:10:17.08,Default,,0,0,0,,Оны қалай көрдіңіз?
Dialogue: 0,0:10:17.26,0:10:19.19,Default,,0,0,0,,Тәтті жұмыртқа мұнарасының тәттілігі
Dialogue: 0,0:10:19.51,0:10:21.63,Default,,0,0,0,,...
Dialogue: 0,0:10:22.72,0:10:24.78,Default,,0,0,0,,Майкава шағын басылымы?
Dialogue: 0,0:10:24.93,0:10:26.43,Default,,0,0,0,,Сіз нысанды қашан кездестірдіңіз?
Dialogue: 0,0:10:27.38,0:10:28.94,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:10:30.77,0:10:35.21,Default,,0,0,0,,...
Dialogue: 0,0:10:35.40,0:10:38.44,Default,,0,0,0,,Хуа Лян
Dialogue: 0,0:10:39.16,0:10:41.16,Default,,0,0,0,,Қол жетпейтін жерде
Dialogue: 0,0:10:41.34,0:10:43.16,Default,,0,0,0,,Будда мүсіні - Циу Бидің ерекше апасы.
Dialogue: 0,0:10:43.94,0:10:49.18,Default,,0,0,0,,Окухи халқы көре алмаған сегунат императрица тікелей шұғыл әрекет жасады.
Dialogue: 0,0:10:49.97,0:10:51.58,Default,,0,0,0,,Окахитоку жолы...
Dialogue: 0,0:10:51.98,0:10:53.85,Default,,0,0,0,,Еңбекқор данышпан
Dialogue: 0,0:10:55.26,0:10:58.83,Default,,0,0,0,,Тек үстірт жарық болуы мүмкін
Dialogue: 0,0:10:59.00,0:11:01.42,Default,,0,0,0,,Дененің шынайы келбеті
Dialogue: 0,0:11:02.18,0:11:04.56,Default,,0,0,0,,Барлық пұттар бірдей.
Dialogue: 0,0:11:06.59,0:11:08.29,Default,,0,0,0,,Мен оны көрген сәтте мен оны көрдім.
Dialogue: 0,0:11:08.46,0:11:10.91,Default,,0,0,0,,Тәтті картоп торт мұнарасы кішкентай ханым шынайы жұмсақтық
Dialogue: 0,0:11:11.33,0:11:13.02,Default,,0,0,0,,Өте ризашылықпен үй иесі
Dialogue: 0,0:11:13.39,0:11:15.66,Default,,0,0,0,,«Менің әпкем» баспасы
Dialogue: 0,0:11:17.12,0:11:18.40,Default,,0,0,0,,Сіз және т.б.
Dialogue: 0,0:11:18.72,0:11:20.64,Default,,0,0,0,,Төлем талап етілмейді.
Dialogue: 0,0:11:22.23,0:11:25.41,Default,,0,0,0,,Қаланың аты осында.
Dialogue: 0,0:11:29.18,0:11:31.47,Default,,0,0,0,,Алынған төлемдер
Dialogue: 0,0:11:31.64,0:11:33.44,Default,,0,0,0,,Өткізіп алмау керек
Dialogue: 0,0:11:33.75,0:11:36.00,Default,,0,0,0,,Менде пакеттің үш данасы бар.
Dialogue: 0,0:11:36.53,0:11:38.76,Default,,0,0,0,,Сумите Кумикава
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Аниме
Dialogue: 0,0:12:05.61,0:12:07.89,Default,,0,0,0,,Бұл гүлдегі кішкентай гүл
Dialogue: 0,0:12:08.11,0:12:08.92,Default,,0,0,0,,...
Dialogue: 0,0:12:09.09,0:12:10.99,Default,,0,0,0,,Кішкентай гүл әпке Әпкесі шығарған
Dialogue: 0,0:12:11.17,0:12:14.12,Default,,0,0,0,,Нова Ясуичи оянып, орманнан кетіп бара жатыр ма?
Dialogue: 0,0:12:14.33,0:12:15.46,Default,,0,0,0,,Орнымнан тұрып кеттім бе?
Dialogue: 0,0:12:15.85,0:12:17.99,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:12:18.31,0:12:22.06,Default,,0,0,0,,Тәтті және тәтті жұмыртқа мұнарасының жұмсақтығы
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Көз
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Аниме
Dialogue: 0,0:12:35.70,0:12:36.72,Default,,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:12:39.34,0:12:41.20,Default,,0,0,0,,Тәтті картоп торты!
Dialogue: 0,0:12:41.37,0:12:42.34,Default,,0,0,0,,Сіз тағы да осындасыз ба?
Dialogue: 0,0:12:42.51,0:12:43.33,Default,,0,0,0,,...
Dialogue: 0,0:12:43.50,0:12:45.32,Default,,0,0,0,,Бұл өнім туралы не ойлайсыз?
Dialogue: 0,0:12:45.61,0:12:47.72,Default,,0,0,0,,Тамақты ұнатасыз ба?
Dialogue: 0,0:12:48.18,0:12:49.23,Default,,0,0,0,,Тайтен Шинрё
Dialogue: 0,0:12:53.22,0:12:54.47,Default,,0,0,0,,Біраз уақытқа?
Dialogue: 0,0:12:54.68,0:12:56.64,Default,,0,0,0,,Сіз гүлдерді киюге дайынсыз ба?
Dialogue: 0,0:12:56.90,0:12:57.91,Default,,0,0,0,,Мама…
Dialogue: 0,0:12:58.29,0:12:59.60,Default,,0,0,0,,Бұл жұмыртқа эмбрионы.
Dialogue: 0,0:12:59.96,0:13:01.60,Default,,0,0,0,,Қайдан келдің?
Dialogue: 0,0:13:02.00,0:13:05.82,Default,,0,0,0,,Тәтті картоппен қиналған жас келіншектің жұмсақтығы
Dialogue: 0,0:13:06.01,0:13:06.74,Default,,0,0,0,,...
Dialogue: 0,0:13:08.92,0:13:13.35,Default,,0,0,0,,Арзан фарфордан жасалған әдемі сыртқы безендіру
Dialogue: 0,0:13:13.64,0:13:18.05,Default,,0,0,0,,Маңызды деген дұрыс емес.
Dialogue: 0,0:13:18.48,0:13:23.43,Default,,0,0,0,,Бұл төтенше жағдайдағы кішкентай әпке, қарындас және үй иесі.
Dialogue: 0,0:13:23.79,0:13:28.35,Default,,0,0,0,,...
Dialogue: 0,0:13:28.77,0:13:34.07,Default,,0,0,0,,Мен дарынды, дарындымын.
Dialogue: 0,0:13:34.87,0:13:38.13,Default,,0,0,0,,Дүкен қоймасы
Dialogue: 0,0:13:38.49,0:13:40.84,Default,,0,0,0,,Материалдық-техникалық қамтамасыз ету персоналы
Dialogue: 0,0:13:41.35,0:13:44.12,Default,,0,0,0,,Даладағы егіншілер
Dialogue: 0,0:13:44.54,0:13:47.41,Default,,0,0,0,,Есімі белгісіз көптеген адамдар
Dialogue: 0,0:13:47.72,0:13:49.96,Default,,0,0,0,,Дарынды талант
Dialogue: 0,0:13:50.82,0:13:51.78,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:13:52.41,0:13:54.73,Default,,0,0,0,,Тәтті және тәтті жұмыртқа мұнарасы кішкентай апаның аузы медитациясы
Dialogue: 0,0:13:54.99,0:13:57.37,Default,,0,0,0,,«Әлемдегі ең жақсы тәтті жер»
Dialogue: 0,0:13:57.53,0:14:01.70,Default,,0,0,0,,Бұл «әлемдегі ең қиын дим сом» ма?
Dialogue: 0,0:14:02.04,0:14:06.10,Default,,0,0,0,,Мен жұмсақ, жұмсақ, ақылды адаммын.
Dialogue: 0,0:14:06.27,0:14:08.71,Default,,0,0,0,,...
Dialogue: 0,0:14:08.99,0:14:10.58,Default,,0,0,0,,...
Dialogue: 0,0:14:15.83,0:14:17.46,Default,,0,0,0,,...
Dialogue: 0,0:14:18.92,0:14:23.21,Default,,0,0,0,,Маған ұнайтыны анық!
Dialogue: 0,0:14:23.80,0:14:25.51,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:14:25.69,0:14:30.14,Default,,0,0,0,,Мен сені қатты жақсы көремін, мен сені қатты жақсы көремін.
Dialogue: 0,0:14:30.31,0:14:33.75,Default,,0,0,0,,Алайда, мен үй иесінің ойын өзгерткенін түсінемін.
Dialogue: 0,0:14:34.12,0:14:35.32,Default,,0,0,0,,Кішкентай тәтті?
Dialogue: 0,0:14:35.92,0:14:37.97,Default,,0,0,0,,Қойылым қашан басталды?
Dialogue: 0,0:14:38.15,0:14:38.81,Default,,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:14:39.00,0:14:39.56,Default,,0,0,0,,Қазір жасаңыз!
Dialogue: 0,0:14:39.71,0:14:40.56,Default,,0,0,0,,Өлім уақыты аяқталды
Dialogue: 0,0:14:41.26,0:14:42.16,Default,,0,0,0,,Мен жүгіруді аяқтадым
Dialogue: 0,0:14:42.58,0:14:44.66,Default,,0,0,0,,Костюмдер
Dialogue: 0,0:14:44.82,0:14:45.44,Default,,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:14:45.82,0:14:47.08,Default,,0,0,0,,Бұл себеп
Dialogue: 0,0:14:49.63,0:14:51.45,Default,,0,0,0,,Тәтті картоп торты
Dialogue: 0,0:14:51.75,0:14:53.89,Default,,0,0,0,,Сізде қаншалықты қабілет бар?
Dialogue: 0,0:14:54.15,0:14:55.60,Default,,0,0,0,,Менің ниетім
Dialogue: 0,0:15:07.92,0:15:10.41,Default,,0,0,0,,(соғыс айқайы)
Dialogue: 0,0:15:17.33,0:15:19.03,Default,,0,0,0,,Сенкио Оба
Dialogue: 0,0:15:17.33,0:15:19.03,Default,,0,0,0,,Ғажайыптар әлемінің құйрығы
Dialogue: 0,0:15:20.81,0:15:22.75,Default,,0,0,0,,Біз қалай бастағанымыз туралы әңгіме
Dialogue: 0,0:15:23.01,0:15:25.07,Default,,0,0,0,,Мен сұлулық кезінде осындамын.
Dialogue: 0,0:15:25.70,0:15:26.74,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:15:32.85,0:15:34.43,Default,,0,0,0,,Токохару Вистерия Ұйқыдағы ару
Dialogue: 0,0:15:32.85,0:15:34.43,Default,,0,0,0,,Ұйқыдағы шырмауық
Dialogue: 0,0:15:35.96,0:15:38.90,Default,,0,0,0,,Ұйқы кезінде оянғаннан кейін
Dialogue: 0,0:15:42.96,0:15:44.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:07.25,0:16:08.75,Default,,0,0,0,,Тәтті жұмыртқа мұнарасы
Dialogue: 0,0:16:07.25,0:16:08.75,Default,,0,0,0,,Sweet Hall торты
Dialogue: 0,0:16:10.88,0:16:14.76,Default,,0,0,0,,Әлемдегі алғашқы тәтті сиқырдың келу нүктесі
Dialogue: 0,0:16:14.94,0:16:15.82,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:16:22.05,0:16:23.72,Default,,0,0,0,,Бал қауын сорпасы
Dialogue: 0,0:16:22.05,0:16:23.72,Default,,0,0,0,,Поп қауыннан жасалған креп
Dialogue: 0,0:16:25.54,0:16:28.07,Default,,0,0,0,,Махаббат пен бақытты пайдаланыңыз
Dialogue: 0,0:16:28.23,0:16:29.67,Default,,0,0,0,,...
Dialogue: 0,0:16:34.01,0:16:34.72,Default,,0,0,0,,Гай!
Dialogue: 0,0:16:55.16,0:17:02.56,Default,,0,0,0,,(соғыс айқайы)
Dialogue: 0,0:19:11.29,0:19:14.31,Default,,0,0,0,,(соғыс айқайы)
Dialogue: 0,0:19:14.46,0:19:19.50,Default,,0,0,0,,Кездесуде кім жеңеді?
Dialogue: 0,0:19:20.75,0:19:21.91,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:19:22.07,0:19:24.17,Default,,0,0,0,,Бұл тәтті жеңіс!
Dialogue: 0,0:19:26.11,0:19:30.96,Default,,0,0,0,,Үй иесінің қаншалықты арзан екенін және тәттілерді қалай жасау керектігін көру жақсы ма?
Dialogue: 0,0:19:31.15,0:19:32.61,Default,,0,0,0,,Жақсы махаббат!
Dialogue: 0,0:19:32.81,0:19:34.98,Default,,0,0,0,,Өндіріс процесіне шолу.
Dialogue: 0,0:19:35.18,0:19:39.98,Default,,0,0,0,,Жалғыз сахна – мүсін.
Dialogue: 0,0:19:40.58,0:19:42.44,Default,,0,0,0,,Шамдар қараңғыланған аймақтар
Dialogue: 0,0:19:42.60,0:19:45.05,Default,,0,0,0,,Көптеген адамдардың уақыты мен жан тыныштығын да ескеріңіз
Dialogue: 0,0:19:45.72,0:19:48.51,Default,,0,0,0,,Әрине, қосымша қолдаудың қажеті жоқ.
Dialogue: 0,0:19:48.82,0:19:50.27,Default,,0,0,0,,Ең арзан!
Dialogue: 0,0:19:50.44,0:19:52.15,Default,,0,0,0,,Қаланы мәңгі қолда!
Dialogue: 0,0:19:52.30,0:19:53.77,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:54.06,0:19:57.63,Default,,0,0,0,,(соғыс айқайы)
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Драма
Dialogue: 0,0:20:02.26,0:20:07.28,Default,,0,0,0,,Талантым көп, қарызға алатын талантым бар, ал кішкентай ханымның тәтті жұмыртқа жасау қабілеті бар.
Dialogue: 0,0:20:07.56,0:20:09.25,Default,,0,0,0,,Шынайы риза үй иесі
Dialogue: 0,0:20:13.05,0:20:15.21,Default,,0,0,0,,Менің жұмысымды оқып шығыңыз.
Dialogue: 0,0:20:16.38,0:20:17.43,Default,,0,0,0,,Шығыста Остания, соғыс жоспарлап жатыр
Dialogue: 0,0:20:17.59,0:20:19.23,Default,,0,0,0,,Мен біттім!
Dialogue: 0,0:20:23.52,0:20:24.74,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:25.17,0:20:26.28,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:20:26.42,0:20:27.61,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:20:28.13,0:20:31.26,Default,,0,0,0,,Бұл ең жақсы өнімділік!
Dialogue: 0,0:20:31.73,0:20:33.86,Default,,0,0,0,,Шокан Каваясуя Кобо
Dialogue: 0,0:20:34.88,0:20:38.75,Default,,0,0,0,,Бұл тұрарлық емес.
Dialogue: 0,0:20:38.97,0:20:42.11,Default,,0,0,0,,...
Dialogue: 0,0:20:42.27,0:20:44.43,Default,,0,0,0,,Жүрек машинасының махаббаты - ең жақсы!
Dialogue: 0,0:20:45.91,0:20:48.33,Default,,0,0,0,,Нацу өндірісінің киімдері
Dialogue: 0,0:20:48.51,0:20:50.66,Default,,0,0,0,,...
Dialogue: 0,0:20:51.68,0:20:55.92,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:20:56.08,0:20:57.69,Default,,0,0,0,,...
Dialogue: 0,0:20:58.43,0:21:02.60,Default,,0,0,0,,Менің түсінгенім және маңыздысы осы.
Dialogue: 0,0:21:04.11,0:21:06.74,Default,,0,0,0,,Жарықтың астындағы жарық қызады
Dialogue: 0,0:21:07.04,0:21:10.47,Default,,0,0,0,,Шогунаттан кейін сахнада көп адамдар болды.
Dialogue: 0,0:21:11.23,0:21:12.67,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:21:13.08,0:21:17.44,Default,,0,0,0,,Жарқын спектакльдің үздіксіз көрсетілімі. Бұл менің шолуым.
Dialogue: 0,0:21:18.37,0:21:19.34,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:21:20.04,0:21:20.86,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:21:21.29,0:21:22.37,Default,,0,0,0,,Жақсы таяқ
Dialogue: 0,0:21:23.03,0:21:25.18,Default,,0,0,0,,...
Dialogue: 0,0:21:26.02,0:21:27.36,Default,,0,0,0,,Эмоция жоқ
Dialogue: 0,0:21:29.20,0:21:30.72,Default,,0,0,0,,Жылағыңыз келе ме?
Dialogue: 0,0:21:34.21,0:21:36.63,Default,,0,0,0,,Иә? Дәмді көрудің жолы осы
Dialogue: 0,0:21:41.61,0:21:42.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:41.61,0:21:43.27,Default,,0,0,0,,(Hotbox қоңырауының дауысы)
Dialogue: 0,0:21:49.68,0:21:51.86,Default,,0,0,0,,Қолда бар шикізат санына байланысты
Dialogue: 0,0:21:52.16,0:21:55.50,Default,,0,0,0,,Мен де өз ойымды көруге тырыстым...
Dialogue: 0,0:21:56.83,0:21:59.98,Default,,0,0,0,,Талантың астанаға жеткенде киімді тастап кетесің.
Dialogue: 0,0:22:00.32,0:22:03.92,Default,,0,0,0,,...
Dialogue: 0,0:22:04.27,0:22:05.91,Default,,0,0,0,,Біздің бірлестік
Dialogue: 0,0:22:07.61,0:22:08.82,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:22:11.86,0:22:15.36,Default,,0,0,0,,Нана Анзукайдың Дим Сам
Dialogue: 0,0:23:56.51,0:23:59.37,Default,,0,0,0,,Тәтті жұмыртқа мұнарасы өте сүйкімді ме?
Dialogue: 0,0:23:59.55,0:24:02.36,Default,,0,0,0,,...
Dialogue: 0,0:24:02.51,0:24:04.79,Default,,0,0,0,,Дегенмен, дәмі өте жақсы
Dialogue: 0,0:24:05.06,0:24:07.52,Default,,0,0,0,,...
Dialogue: 0,0:24:07.97,0:24:08.98,Default,,0,0,0,,Кадзуки Ойкея
Dialogue: 0,0:24:09.18,0:24:10.29,Default,,0,0,0,,Айнаға кіріңіз!
Dialogue: 0,0:24:11.77,0:24:14.96,Default,,0,0,0,,Тек шыңның кумирі, талантты жұлдызды доп ханшайымы және керемет сыйлық болсын.
Dialogue: 0,0:24:11.77,0:24:14.96,Default,,0,0,0,,Ғаламшар ханшайымы GP
Dialogue: 0,0:24:15.11,0:24:17.04,Default,,0,0,0,,Дауға қатысу күш-жігерді қажет етеді!
Dialogue: 0,0:24:17.20,0:24:18.70,Default,,0,0,0,,Сіз дәл осы уақытта жоқсыз!
Dialogue: 0,0:24:19.04,0:24:20.53,Default,,0,0,0,,...
Dialogue: 0,0:24:20.85,0:24:22.71,Default,,0,0,0,,Оқиғаға толы жұлдыз шарларының жинағы!
Dialogue: 0,0:24:22.86,0:24:24.07,Default,,0,0,0,,Орта мектеп гипноз әні
Dialogue: 0,0:24:22.86,0:24:24.07,Default,,0,0,0,,Орта мектептің бесік жыры
Dialogue: 0,0:00:03.24,0:00:05.13,Default,,0,0,0,,Өзіңіз қалаған адам бола алатын орын
Dialogue: 0,0:00:05.34,0:00:06.44,Default,,0,0,0,,『ｱｲｶﾂﾌﾟﾗﾈｯﾄ！』
Dialogue: 0,0:00:06.60,0:00:07.61,Default,,0,0,0,,басталады
Dialogue: 0,0:00:08.95,0:00:09.99,Default,,0,0,0,,Хэхе~
Dialogue: 0,0:00:11.18,0:00:12.63,Default,,0,0,0,,Әзірге «Икатсу!»
Dialogue: 0,0:00:13.10,0:00:15.77,Default,,0,0,0,,Мен Хананы Йомейсаки-чаннан алғаным
Dialogue: 0,0:00:15.96,0:00:17.91,Default,,0,0,0,,Мен жанкүйерлеріме айтуды жөн көрдім.
Dialogue: 0,0:00:18.74,0:00:22.06,Default,,0,0,0,,Мен адамдарға менің қазір кім екенімді білуге ​​деген тілегімді жеткізе алғанымды сезінемін.
Dialogue: 0,0:00:22.81,0:00:25.04,Default,,0,0,0,,Жаңарған рухпен бар күшімді саламын
Dialogue: 0,0:00:31.22,0:00:32.22,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:32.39,0:00:33.60,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:35.11,0:00:36.77,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:00:39.89,0:00:41.80,Default,,0,0,0,,Бұл Алисаның шай ішкені сияқты
Dialogue: 0,0:00:42.70,0:00:44.72,Default,,0,0,0,,Бүгін біреудің туған күні ме?
Dialogue: 0,0:00:45.05,0:00:47.70,Default,,0,0,0,,Мен сені мазалап жүрмін.
Dialogue: 0,0:00:48.29,0:00:49.68,Default,,0,0,0,,Анзу-чан!
Dialogue: 0,0:00:50.19,0:00:51.50,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:00:53.01,0:00:55.52,Default,,0,0,0,,Мен сізбен бір нәрсені талқылағым келеді.
Dialogue: 0,0:00:56.51,0:00:57.63,Default,,0,0,0,,Бізге?
Dialogue: 0,0:00:57.80,0:01:00.72,Default,,0,0,0,,Майо-сан, Шиори-сан, тыңдаңыз.
Dialogue: 0,0:01:01.07,0:01:03.42,Default,,0,0,0,,Энн, мені тастап кетті.
Dialogue: 0,0:01:03.60,0:01:04.63,Default,,0,0,0,,Сізді тастап кетті ме?
Dialogue: 0,0:01:04.89,0:01:07.64,Default,,0,0,0,,Кеңес беру махаббат проблемалары туралы ма?
Dialogue: 0,0:01:07.80,0:01:11.77,Default,,0,0,0,,Энн мен сені айналдырғым келеді.
Dialogue: 0,0:02:49.61,0:02:52.23,Default,,0,0,0,,Аннаның лақтырылуы туралы әңгімені тыңдаңыз.
Dialogue: 0,0:02:52.43,0:02:56.64,Default,,0,0,0,,Мен тәтті саңылау тортындағы Дрешиа мырзаның маған көмектескенін қалаймын.
Dialogue: 0,0:02:56.89,0:02:58.34,Default,,0,0,0,,Мен жақсылық сұрауға бардым.
Dialogue: 0,0:02:58.66,0:03:01.74,Default,,0,0,0,,Иә, лақтырып жіберген адам Дорешия болды ма?
Dialogue: 0,0:03:02.61,0:03:05.40,Default,,0,0,0,,Не, бұл махаббат мәселесі екеніне сенімдімін.
Dialogue: 0,0:03:05.57,0:03:08.93,Default,,0,0,0,,Жүрегім ауырды, жүрегім сыздады!
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Драма
Dialogue: 0,0:03:49.74,0:03:53.23,Default,,0,0,0,,Анзу-чан, сен неге тұрсың?
Dialogue: 0,0:03:53.40,0:03:56.91,Default,,0,0,0,,Анзу, саған суық тиюге үйренбегенсің ғой?
Dialogue: 0,0:03:57.52,0:03:59.81,Default,,0,0,0,,Мен енді келтірілген залалды өтей алмаймын.
Dialogue: 0,0:04:00.56,0:04:02.12,Default,,0,0,0,,Мен тәттілер пісірдім.
Dialogue: 0,0:04:02.44,0:04:04.30,Default,,0,0,0,,Мен тәттілер пісірдім.
Dialogue: 0,0:04:04.45,0:04:07.57,Default,,0,0,0,,Жұмыртқаны көпірту немесе қамырды араластыру кезінде,
Dialogue: 0,0:04:07.76,0:04:09.59,Default,,0,0,0,,Бұл мені тыныштандырады.
Dialogue: 0,0:04:10.04,0:04:13.61,Default,,0,0,0,,Сондықтан мен осы тіскебасарды алып, кеңеске барайын деп ойладым.
Dialogue: 0,0:04:14.44,0:04:20.48,Default,,0,0,0,,Сіз сол агенттікте жұмыс істейтін менің аға Купидан Цукиширо Аюмиден кеңес сұрай алмайсыз ба?
Dialogue: 0,0:04:20.68,0:04:23.24,Default,,0,0,0,,Мен мұны бос емес Айю-санға сұрай алмаймын.
Dialogue: 0,0:04:24.39,0:04:27.34,Default,,0,0,0,,Бізде де бос уақыт жоқ...
Dialogue: 0,0:04:29.20,0:04:34.00,Default,,0,0,0,,Бір минут күтіңіз, бүгінгі шайқас кезеңі Скиори мен Энн емес.
Dialogue: 0,0:04:34.39,0:04:35.36,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:35.52,0:04:36.55,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:36.83,0:04:42.28,Default,,0,0,0,,Сондықтан бүгінгі сахнада маған Sweet Hole Cake-тің көмегі өте қажет.
Dialogue: 0,0:04:42.61,0:04:45.68,Default,,0,0,0,,Менің ойымша, бұл көйлек Аннаға сөзсіз жарасады.
Dialogue: 0,0:04:45.96,0:04:48.49,Default,,0,0,0,,Оны бәріңіз де көргіңіз келеді, солай ма?
Dialogue: 0,0:04:48.85,0:04:50.82,Default,,0,0,0,,Сонымен келе жатырсыз ба?
Dialogue: 0,0:04:51.05,0:04:56.57,Default,,0,0,0,,Бірақ біз әлі күнге дейін Дорешия туралы көп білмейміз.
Dialogue: 0,0:04:57.14,0:05:01.82,Default,,0,0,0,,Шиори екеуіміз де Ан Чаннан кейін Айкацумен дебют жасадық.
Dialogue: 0,0:05:06.19,0:05:07.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:09.16,0:05:10.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:10.78,0:05:14.79,Default,,0,0,0,,Тәтті holcake's Dreshia - Такамин гүлі.
Dialogue: 0,0:05:14.97,0:05:17.12,Default,,0,0,0,,Бірақ мен мақтанышымның соншалықты биік екеніне сене алмаймын.
Dialogue: 0,0:05:17.45,0:05:19.99,Default,,0,0,0,,Жоғары мақтаныш жаман емес.
Dialogue: 0,0:05:20.35,0:05:23.45,Default,,0,0,0,,Ерекше екеніңді мақтан тұт
Dialogue: 0,0:05:23.62,0:05:25.00,Default,,0,0,0,,Арзан сатпаңыз
Dialogue: 0,0:05:25.18,0:05:27.08,Default,,0,0,0,,Пұттар бірдей, солай емес пе?
Dialogue: 0,0:05:27.89,0:05:29.50,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:05:30.11,0:05:32.92,Default,,0,0,0,,Дорешия көмекке мұқтаж.
Dialogue: 0,0:05:33.12,0:05:34.78,Default,,0,0,0,,Бірақ сіз серіктесіңізді таңдайсыз.
Dialogue: 0,0:05:35.22,0:05:39.74,Default,,0,0,0,,Мен де өзім құрастырған көйлекті дұрыс білетін адам кигенін қалаймын.
Dialogue: 0,0:05:39.98,0:05:42.97,Default,,0,0,0,,Мен Энн Торт туралы басқаларға қарағанда көбірек білемін деп ойлаймын.
Dialogue: 0,0:05:43.21,0:05:44.87,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:05:45.51,0:05:49.27,Default,,0,0,0,,Сонымен, сіз Дрешияның «Тәтті Холкейк» фильміндегі ең жақсы көретін фразасын білесіз бе?
Dialogue: 0,0:05:49.82,0:05:51.72,Default,,0,0,0,,Аа, білмеймін.
Dialogue: 0,0:05:52.71,0:05:56.23,Default,,0,0,0,,Мен әлемдегі ең тәтті тәттімін
Dialogue: 0,0:05:56.52,0:05:58.81,Default,,0,0,0,,Бұл әлемдегі ең тәтті ме?
Dialogue: 0,0:05:59.56,0:06:04.83,Default,,0,0,0,,Мінез, ... мәселесі
Dialogue: 0,0:06:05.10,0:06:08.51,Default,,0,0,0,,Ағылшынша тәтті сөзі нені білдіреді?
Dialogue: 0,0:06:09.15,0:06:12.11,Default,,0,0,0,,Өйткені тәттілер тәтті...
Dialogue: 0,0:06:12.29,0:06:13.01,Default,,0,0,0,,Тәтті?
Dialogue: 0,0:06:13.40,0:06:15.82,Default,,0,0,0,,Дұрыс Басқа не?
Dialogue: 0,0:06:15.99,0:06:18.35,Default,,0,0,0,,Тағы бірдеңе бар ма? Ал...
Dialogue: 0,0:06:19.02,0:06:22.68,Default,,0,0,0,,Әдемі сүйкімді ыңғайлы нәзік
Dialogue: 0,0:06:23.57,0:06:25.84,Default,,0,0,0,,Ол Аннаға мүлдем мейірімді болмады.
Dialogue: 0,0:06:26.53,0:06:29.68,Default,,0,0,0,,Бірақ Ан Чан байқамайтын бір мейірімділік бар шығар.
Dialogue: 0,0:06:30.09,0:06:31.92,Default,,0,0,0,,Ондай нәрсе бар ма?
Dialogue: 0,0:06:33.27,0:06:36.42,Default,,0,0,0,,Торт жасап көрсең, бірдеңе үйренерсің?
Dialogue: 0,0:06:37.25,0:06:41.65,Default,,0,0,0,,Ал, қазір үшеуміз ингредиенттерді сатып алайық.
Dialogue: 0,0:06:41.81,0:06:42.62,Default,,0,0,0,,Бұдан былай?
Dialogue: 0,0:06:42.93,0:06:44.04,Default,,0,0,0,,Сахна дегеніміз не?
Dialogue: 0,0:06:44.21,0:06:48.43,Default,,0,0,0,,Сондықтан үшеуміз бірігіп бүгінгі кезеңге уақытында жетеміз.
Dialogue: 0,0:06:48.97,0:06:51.25,Default,,0,0,0,,Үш адам, соның ішінде мені?
Dialogue: 0,0:06:51.79,0:06:53.78,Default,,0,0,0,,Сен тәтті жедің, солай ма?
Dialogue: 0,0:06:57.95,0:06:58.94,Default,,0,0,0,,Фуфу
Dialogue: 0,0:06:59.36,0:07:00.56,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:07:03.16,0:07:07.18,Default,,0,0,0,,Қорқынышты, бірақ сүйкімді
Dialogue: 0,0:07:08.51,0:07:12.07,Default,,0,0,0,,Хмм, бұл тоқтамайды.
Dialogue: 0,0:07:22.31,0:07:25.09,Default,,0,0,0,,Шиори мырза, сары майды бөлме температурасында суытыңыз.
Dialogue: 0,0:07:25.25,0:07:26.24,Default,,0,0,0,,Иә
Dialogue: 0,0:07:26.83,0:07:29.66,Default,,0,0,0,,Майо-сан, ұнды електен өткіз.
Dialogue: 0,0:07:35.67,0:07:37.60,Default,,0,0,0,,Сахна алдында...
Dialogue: 0,0:07:37.88,0:07:39.74,Default,,0,0,0,,Торт жасап жатсаңыз ше?
Dialogue: 0,0:07:40.25,0:07:43.68,Default,,0,0,0,,Анзу жасайтын тәттілер өте дәмді.
Dialogue: 0,0:07:43.96,0:07:47.33,Default,,0,0,0,,Ең жақсы сахнаға қойып, кейін бірге жеп көрейік.
Dialogue: 0,0:07:48.41,0:07:50.78,Default,,0,0,0,,Сүйкімділік пен тәттілер жеткілікті...
Dialogue: 0,0:07:51.21,0:07:52.60,Default,,0,0,0,,Жеңілмейтіндік
Dialogue: 0,0:08:01.14,0:08:02.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:02.60,0:08:03.60,Default,,0,0,0,,Миллионың костюмі сол жігіттің шашынан алынған арнайы талшықтан жасалған.
Dialogue: 0,0:08:03.76,0:08:05.24,Default,,0,0,0,,Бұл қолдан жасалған ба?
Dialogue: 0,0:08:05.67,0:08:06.54,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:06.71,0:08:08.73,Default,,0,0,0,,Уау Ан-Чан
Dialogue: 0,0:08:08.90,0:08:11.04,Default,,0,0,0,,Сегава мырза, қолдарыңыз бос па?
Dialogue: 0,0:08:12.53,0:08:13.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:13.54,0:08:16.52,Default,,0,0,0,,Тәттілер дәмді болды ма?
Dialogue: 0,0:08:22.84,0:08:27.33,Default,,0,0,0,,ｱｲｶﾂ ｱｲｶﾂ…
Dialogue: 0,0:08:29.26,0:08:32.48,Default,,0,0,0,,Менің қолым тартылып бара жатқандай сезінемін.
Dialogue: 0,0:08:33.39,0:08:35.22,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:08:36.06,0:08:38.17,Default,,0,0,0,,Майо-санның айқайы
Dialogue: 0,0:08:38.33,0:08:40.06,Default,,0,0,0,,ｱｲｶﾂ ｱｲｶﾂ
Dialogue: 0,0:08:41.84,0:08:45.08,Default,,0,0,0,,ｱｲｶﾂ ｱｲｶﾂ…
Dialogue: 0,0:08:46.19,0:08:49.50,Default,,0,0,0,,ｱｲｶﾂ ｱｲｶﾂ…
Dialogue: 0,0:09:02.04,0:09:03.48,Default,,0,0,0,,О, ол ояныпты!
Dialogue: 0,0:09:06.37,0:09:07.71,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:09:07.92,0:09:08.49,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:09:09.13,0:09:10.42,Default,,0,0,0,,О, жақсы жұмыс!
Dialogue: 0,0:09:10.54,0:09:11.56,Default,,0,0,0,,Өзін жақсы сезінеді
Dialogue: 0,0:09:21.01,0:09:22.27,Default,,0,0,0,,Маған кілтті беріңіз
Dialogue: 0,0:09:22.43,0:09:23.15,Default,,0,0,0,,ｷｳｲ？
Dialogue: 0,0:09:31.86,0:09:32.78,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:09:32.94,0:09:33.75,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:09:50.26,0:09:51.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:51.95,0:09:52.73,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:09:52.88,0:09:53.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:53.79,0:09:54.90,Default,,0,0,0,,Өзін жақсы сезінеді
Dialogue: 0,0:09:57.08,0:09:57.99,Default,,0,0,0,,Олай болса, кеттік.
Dialogue: 0,0:09:58.47,0:10:01.15,Default,,0,0,0,,ｱｲｶﾂ！
Dialogue: 0,0:10:04.35,0:10:05.57,Default,,0,0,0,,Жарайсыңдар
Dialogue: 0,0:10:05.74,0:10:07.61,Default,,0,0,0,,Иә, бұл тамақ ысырап.
Dialogue: 0,0:10:07.76,0:10:08.82,Default,,0,0,0,,Дәмді көрінеді.
Dialogue: 0,0:10:13.32,0:10:15.27,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:10:15.42,0:10:17.08,Default,,0,0,0,,Бұл қалай көрінді?
Dialogue: 0,0:10:17.26,0:10:19.19,Default,,0,0,0,,Тәтті торттың мейірімділігі
Dialogue: 0,0:10:19.51,0:10:21.63,Default,,0,0,0,,Хмм... бұл...
Dialogue: 0,0:10:22.72,0:10:24.78,Default,,0,0,0,,Майо-чан мен Шиори-чан ше?
Dialogue: 0,0:10:24.93,0:10:26.43,Default,,0,0,0,,Сіз бірдеңе байқадыңыз ба?
Dialogue: 0,0:10:27.38,0:10:28.94,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:30.77,0:10:35.21,Default,,0,0,0,,Декорация торты кәмпиттердің жоғарғы кумиріне ұқсайды
Dialogue: 0,0:10:35.40,0:10:38.44,Default,,0,0,0,,Керемет және жарқыраған
Dialogue: 0,0:10:39.16,0:10:41.16,Default,,0,0,0,,Қолжетімсіз
Dialogue: 0,0:10:41.34,0:10:43.16,Default,,0,0,0,,Тура Купида сияқты
Dialogue: 0,0:10:43.94,0:10:49.18,Default,,0,0,0,,Ешкім қарамаған кезде Купида өте қатты жұмыс істейді.
Dialogue: 0,0:10:49.97,0:10:51.58,Default,,0,0,0,,ｷｭｰﾋﾟｯﾄﾛｰﾄﾞ…
Dialogue: 0,0:10:51.98,0:10:53.85,Default,,0,0,0,,Күш данышпандығы
Dialogue: 0,0:10:55.26,0:10:58.83,Default,,0,0,0,,Мүмкін сіз тек жарқырауға назар аударатын шығарсыз.
Dialogue: 0,0:10:59.00,0:11:01.42,Default,,0,0,0,,Мүмкін мен өзімнің шынайы болмысымды жоғалтқан шығармын
Dialogue: 0,0:11:02.18,0:11:04.56,Default,,0,0,0,,Торт және пұттар да
Dialogue: 0,0:11:06.59,0:11:08.29,Default,,0,0,0,,көремін.
Dialogue: 0,0:11:08.46,0:11:10.91,Default,,0,0,0,,Тәтті Холкейктің шынайы мейірімділігі
Dialogue: 0,0:11:11.33,0:11:13.02,Default,,0,0,0,,үшінңызға рахмет
Dialogue: 0,0:11:13.39,0:11:15.66,Default,,0,0,0,,Майо-сан, Шиори-сан, кеттік.
Dialogue: 0,0:11:17.12,0:11:18.40,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:11:18.72,0:11:20.64,Default,,0,0,0,,Асығыңыз, әйтпесе үлгермейміз
Dialogue: 0,0:11:22.23,0:11:25.41,Default,,0,0,0,,Менің осыншама уақыт алуымның себебі, мен торт жасап жатырмын.
Dialogue: 0,0:11:29.18,0:11:31.47,Default,,0,0,0,,Мен толығымен теңселіп кеттім
Dialogue: 0,0:11:31.64,0:11:33.44,Default,,0,0,0,,Бірақ егер бұл Ан-чан болса, мен оны кешіре аламын.
Dialogue: 0,0:11:33.75,0:11:36.00,Default,,0,0,0,,Сонымен, торт үш тең ​​бөлікке бөлінген.
Dialogue: 0,0:11:36.53,0:11:38.76,Default,,0,0,0,,...
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Көз
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Драма
Dialogue: 0,0:20:02.26,0:20:07.28,Default,,0,0,0,,үшінна рахмет, мен Sweet Holcake-тен Дрешианың көмегін алдым.
Dialogue: 0,0:20:07.56,0:20:09.25,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:20:13.05,0:20:15.21,Default,,0,0,0,,Сіз оны алғыңыз келе ме?
Dialogue: 0,0:20:16.38,0:20:17.43,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:20:17.59,0:20:19.23,Default,,0,0,0,,Итадакимасу!
Dialogue: 0,0:20:23.52,0:20:24.74,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:20:25.17,0:20:26.28,Default,,0,0,0,,Дәмді
Dialogue: 0,0:20:26.42,0:20:27.61,Default,,0,0,0,,Дәмді
Dialogue: 0,0:20:28.13,0:20:31.26,Default,,0,0,0,,Бұл торт пен бүгінгі кезең ең керемет!
Dialogue: 0,0:20:31.73,0:20:33.86,Default,,0,0,0,,Скиори де, Энн де жақсы болды.
Dialogue: 0,0:20:34.88,0:20:38.75,Default,,0,0,0,,Бірақ торт көйлегі - бұл заң бұзушылық. Бұл тым сүйкімді.
Dialogue: 0,0:20:38.97,0:20:42.11,Default,,0,0,0,,Рахмет, көбірек айтыңызшы.
Dialogue: 0,0:20:42.27,0:20:44.43,Default,,0,0,0,,Толық көріністе қатыгездік пен сүйкімділік
Dialogue: 0,0:20:45.91,0:20:48.33,Default,,0,0,0,,Бұл көйлекті тек Энн кие алады, солай ма?
Dialogue: 0,0:20:48.51,0:20:50.66,Default,,0,0,0,,Иә, бұл сізге керемет көрінді.
Dialogue: 0,0:20:51.68,0:20:55.92,Default,,0,0,0,,Мен шайқаста жеңілсем де, Анне-чанға ризамын.
Dialogue: 0,0:20:56.08,0:20:57.69,Default,,0,0,0,,Мен үшін не?
Dialogue: 0,0:20:58.43,0:21:02.60,Default,,0,0,0,,Өйткені бұл маған Айкацу ойнаған кезде не маңызды екенін түсінді.
Dialogue: 0,0:21:04.11,0:21:06.74,Default,,0,0,0,,Біз нұрға шомылғанда жарқырай аламыз.
Dialogue: 0,0:21:07.04,0:21:10.47,Default,,0,0,0,,Мұның бәрі сахнаға қолдау білдірген көпшіліктің арқасы.
Dialogue: 0,0:21:11.23,0:21:12.67,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:21:13.08,0:21:17.44,Default,,0,0,0,,Біздің ризашылығымыз - одан да жақсы кезеңді жеткізу.
Dialogue: 0,0:21:18.37,0:21:19.34,Default,,0,0,0,,Иә
Dialogue: 0,0:21:20.04,0:21:20.86,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:21.29,0:21:22.37,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:23.03,0:21:25.18,Default,,0,0,0,,Екеуің де есейдіңдер.
Dialogue: 0,0:21:26.02,0:21:27.36,Default,,0,0,0,,Сезім басым
Dialogue: 0,0:21:29.20,0:21:30.72,Default,,0,0,0,,Сегава неге жылап жатыр?
Dialogue: 0,0:21:34.21,0:21:36.63,Default,,0,0,0,,Иә? бұл не иіс
Dialogue: 0,0:21:41.61,0:21:42.51,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:41.61,0:21:43.27,Default,,0,0,0,,(Диапазонның дауысы)
Dialogue: 0,0:21:49.68,0:21:51.86,Default,,0,0,0,,Менде тортқа біраз ингредиенттер қалды.
Dialogue: 0,0:21:52.16,0:21:55.50,Default,,0,0,0,,Мен де жасап көрейін деп ойладым...
Dialogue: 0,0:21:56.83,0:21:59.98,Default,,0,0,0,,Сіз өзіңіздің талантыңызды жұмсадыңыз, солай емес пе?
Dialogue: 0,0:22:00.32,0:22:03.92,Default,,0,0,0,,Сара-сан, тәттінің орнына көйлек тігіп берші.
Dialogue: 0,0:22:04.27,0:22:05.91,Default,,0,0,0,,Біз оны киеміз.
Dialogue: 0,0:22:07.61,0:22:08.82,Default,,0,0,0,,Иә...
Dialogue: 0,0:22:11.86,0:22:15.36,Default,,0,0,0,,Жарайды, Анзу мен тәттілер жасап, саған тағы қонаққа келемін.
Dialogue: 0,0:23:56.51,0:23:59.37,Default,,0,0,0,,Тәтті торт өте сүйкімді емес пе?
Dialogue: 0,0:23:59.55,0:24:02.36,Default,,0,0,0,,Иә, саған жарасады, ол Ан-Чанға ұқсайды.
Dialogue: 0,0:24:02.51,0:24:04.79,Default,,0,0,0,,Және өте дәмді көрінеді.
Dialogue: 0,0:24:05.06,0:24:07.52,Default,,0,0,0,,Иә, дәмді көрінеді ме?
Dialogue: 0,0:24:07.97,0:24:08.98,Default,,0,0,0,,үшін бірге
Dialogue: 0,0:24:09.18,0:24:10.29,Default,,0,0,0,,ﾐﾗｰｲﾝ！
Dialogue: 0,0:17:10.07,0:17:15.22,Default,,0,0,0,,Осыны оқығанда мен кенет жерді сезіндім, оны көргенде оның қайтып оралғанын байқадым.
Dialogue: 0,0:17:15.62,0:17:20.41,Default,,0,0,0,,Мен сені тағы көргеніме таң қалдым.
Dialogue: 0,0:17:20.56,0:17:30.85,Default,,0,0,0,,Мектепті бітіргеннен кейін университеттің дамуы мен қызметі екі жаққа да тиімді.
Dialogue: 0,0:17:32.55,0:17:37.52,Default,,0,0,0,,10 миллион қажетсіз түсініктемелер, олардың барлығы менікі емес
Dialogue: 0,0:17:38.41,0:17:40.71,Default,,0,0,0,,Студент қыз, студент қыз, студент қыз
Dialogue: 0,0:17:40.88,0:17:43.60,Default,,0,0,0,,Аптаның соңында
Dialogue: 0,0:17:43.89,0:17:46.38,Default,,0,0,0,,Студент қыз, студент қыз, студент қыз
Dialogue: 0,0:17:46.54,0:17:49.20,Default,,0,0,0,,Арамыздағы қашықтық
Dialogue: 0,0:17:49.69,0:17:55.10,Default,,0,0,0,,Егер сіз басқа нұсқаны таңдасаңыз, ойылған табақтағы әсерді сезініңіз.
Dialogue: 0,0:17:55.31,0:17:58.49,Default,,0,0,0,,Қосымша ақпарат қажет екенін түсінемін.
Dialogue: 0,0:18:00.24,0:18:01.29,Default,,0,0,0,,...
Dialogue: 0,0:18:23.65,0:18:33.43,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:18:34.42,0:18:37.15,Default,,0,0,0,,Демек, студент қыз, студент қыз, студент қыз
Dialogue: 0,0:18:37.31,0:18:39.87,Default,,0,0,0,,Жазғы фестиваль концерті
Dialogue: 0,0:18:40.22,0:18:42.64,Default,,0,0,0,,Студент қыз, студент қыз, студент қыз
Dialogue: 0,0:18:42.81,0:18:45.58,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:18:45.91,0:18:51.47,Default,,0,0,0,,Егер сіз басқа опцияны таңдасаңыз, ойылған табақтағы әсерді сезініңіз
Dialogue: 0,0:18:51.64,0:18:54.96,Default,,0,0,0,,Қосымша ақпарат қажет екенін түсінемін.
Dialogue: 0,0:18:57.17,0:19:00.58,Default,,0,0,0,,Сізге көбірек жер керек.
Dialogue: 0,0:17:10.07,0:17:15.22,Default,,0,0,0,,Сабақ үстінде мен сенің арқаңа қарап қалдым.
Dialogue: 0,0:17:15.62,0:17:20.41,Default,,0,0,0,,Мен бірден алданып қалдым, бірақ мен оны түсіндім.
Dialogue: 0,0:17:20.56,0:17:30.85,Default,,0,0,0,,Сабақтан кейінгі оркестр, достарымен қыдырсу, т.б.
Dialogue: 0,0:17:32.55,0:17:37.52,Default,,0,0,0,,Мұның бәрі мен туралы деп қателеспеңіз.
Dialogue: 0,0:17:38.41,0:17:40.71,Default,,0,0,0,,Леди Леди Леди
Dialogue: 0,0:17:40.88,0:17:43.60,Default,,0,0,0,,Демалыс күндері кафеде сөйлесу
Dialogue: 0,0:17:43.89,0:17:46.38,Default,,0,0,0,,Леди Леди Леди
Dialogue: 0,0:17:46.54,0:17:49.20,Default,,0,0,0,,Екеуіңіздің ара қашықтықты қысқартуға тырысыңыз.
Dialogue: 0,0:17:49.69,0:17:55.10,Default,,0,0,0,,Өз ойыңды ойлап қалма, Жүрекке айналдыр
Dialogue: 0,0:17:55.31,0:17:58.49,Default,,0,0,0,,Менімен жақынырақ танысыңыз
Dialogue: 0,0:18:00.24,0:18:01.29,Default,,0,0,0,,Хуэй
Dialogue: 0,0:18:23.65,0:18:33.43,Default,,0,0,0,,Мүмкін мен де сені дұрыс түсінбеген шығармын.
Dialogue: 0,0:18:34.42,0:18:37.15,Default,,0,0,0,,Сонымен, ханым ханым
Dialogue: 0,0:18:37.31,0:18:39.87,Default,,0,0,0,,Жазғы демалыс Сол тікелей шоуды көріңіз
Dialogue: 0,0:18:40.22,0:18:42.64,Default,,0,0,0,,Леди Леди Леди
Dialogue: 0,0:18:42.81,0:18:45.58,Default,,0,0,0,,Екі жүрек бір болады
Dialogue: 0,0:18:45.91,0:18:51.47,Default,,0,0,0,,Өз ойыңды ойлап қалма, Жүрекке айналдыр
Dialogue: 0,0:18:51.64,0:18:54.96,Default,,0,0,0,,Менімен жақынырақ танысыңыз
Dialogue: 0,0:18:57.17,0:19:00.58,Default,,0,0,0,,Өзіңіз туралы да айтып беріңізші.
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,---------------------------------------------------------------------------------------------------------------------
Dialogue: 0,0:01:29.25,0:01:34.32,Default,,0,0,0,,Көрген сайын күлімсіреу, пайда болатын тірлік
Dialogue: 0,0:01:29.25,0:01:34.32,Default,,0,0,0,,Көрген сайын күлімсіреу, пайда болатын тірлік
