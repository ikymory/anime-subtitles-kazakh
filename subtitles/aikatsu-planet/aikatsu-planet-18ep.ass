Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.22,0:00:05.08,Default,,0,0,0,,Табыстың өзін-өзі орталықтандыру аймағы
Dialogue: 0,0:00:05.30,0:00:06.43,Default,,0,0,0,,Идол белсендіруші жұлдыз сферасы!
Dialogue: 0,0:00:06.63,0:00:07.61,Default,,0,0,0,,Бастапқы нүкте
Dialogue: 0,0:00:09.01,0:00:10.01,Default,,0,0,0,,...
Dialogue: 0,0:00:11.09,0:00:12.52,Default,,0,0,0,,Жоғарғы шеңбер оқиғасы!
Dialogue: 0,0:00:12.88,0:00:15.39,Default,,0,0,0,,Мен Otowa Maiaki жоғарғы орта мектебінің кіші орта мектебінің сыныбын айқайлаймын!
Dialogue: 0,0:00:15.79,0:00:18.78,Default,,0,0,0,,Тірі жұлдыз шарында, кішкентай ұшты пұт, кішкентай гүл!
Dialogue: 0,0:00:19.40,0:00:23.00,Default,,0,0,0,,Тікелей продюсерім, киім дизайнері және дизайнері
Dialogue: 0,0:00:23.27,0:00:26.96,Default,,0,0,0,,Ол бұрын кумир болған!
Dialogue: 0,0:00:27.33,0:00:30.28,Default,,0,0,0,,Қорытынды кезеңнің мақсаты келесі кезеңге оралу.
Dialogue: 0,0:00:30.45,0:00:31.90,Default,,0,0,0,,Жарықтың қайта тірілуі
Dialogue: 0,0:00:32.35,0:00:35.73,Default,,0,0,0,,Костюмімді киюіме біраз уақыт кетті, бірақ кумир әлі сол жерде еді.
Dialogue: 0,0:00:36.06,0:00:38.68,Default,,0,0,0,,Станциядағы сахнаның уақыты
Dialogue: 0,0:00:40.03,0:00:41.92,Default,,0,0,0,,...
Dialogue: 0,0:00:43.54,0:00:49.27,Default,,0,0,0,,Жақсы... жақсы нүкте Гачидорё
Dialogue: 0,0:00:53.75,0:00:57.52,Default,,0,0,0,,Соңы... Соңы осында!
Dialogue: 0,0:00:57.79,0:00:59.87,Default,,0,0,0,,Иә? Сіз қызғанасыз ба?
Dialogue: 0,0:01:02.11,0:01:04.64,Default,,0,0,0,,Заман жолын білесің бе?
Dialogue: 0,0:01:04.93,0:01:07.82,Default,,0,0,0,,Ол кезде сферадағы тірі жұлдыздар өте танымал болды.
Dialogue: 0,0:01:07.98,0:01:11.09,Default,,0,0,0,,Жобалық күш дегеніміз не?
Dialogue: 0,0:01:11.44,0:01:13.87,Default,,0,0,0,,Себебі, әрбір жылыту есігіне жоба жетекшісі жауапты
Dialogue: 0,0:01:14.04,0:01:17.53,Default,,0,0,0,,Ағымдағы жанасу күші осында!
Dialogue: 0,0:01:17.72,0:01:19.89,Default,,0,0,0,,Шынайы оқиға!? Кьюки!
Dialogue: 0,0:01:20.08,0:01:20.91,Default,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:01:22.53,0:01:26.32,Default,,0,0,0,,Менің отбасымда кумир болуы немесе оған қатысу мүмкін бе?
Dialogue: 0,0:01:26.97,0:01:30.85,Default,,0,0,0,,Жақында Қытайдың Ұлы Ханзадасының астанасы Жұлдызды бал ханшайымы, Ұлы сылтау ма?
Dialogue: 0,0:01:31.05,0:01:32.94,Default,,0,0,0,,Ене мен келін туралы ойлар
Dialogue: 0,0:01:33.54,0:01:34.83,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:01:35.10,0:01:36.36,Default,,0,0,0,,Кейбір талаптар
Dialogue: 0,0:01:36.54,0:01:37.66,Default,,0,0,0,,ха ха ха
Dialogue: 0,0:01:38.51,0:01:42.06,Default,,0,0,0,,Ойын кезінде келесі кездейсоқ әрекеттерді оқу қажет.
Dialogue: 0,0:03:12.98,0:03:17.98,Default,,0,0,0,,Уақыт!
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Тікелей эфирде Роуз Хана
Dialogue: 0,0:03:28.64,0:03:33.28,Default,,0,0,0,,...
Dialogue: 0,0:03:33.83,0:03:35.57,Default,,0,0,0,,Тайрин зиян келтірілді...
Dialogue: 0,0:03:36.20,0:03:36.91,Default,,0,0,0,,Гай!
Dialogue: 0,0:03:37.57,0:03:38.47,Default,,0,0,0,,Менің алдын ала сезімім айқын көрсетті, мен жеңетінімді
Dialogue: 0,0:03:41.59,0:03:43.29,Default,,0,0,0,,Бірлескен әрекеттен аулақ болу ғанибет.
Dialogue: 0,0:03:43.47,0:03:44.78,Default,,0,0,0,,1
Dialogue: 0,0:03:44.91,0:03:47.56,Default,,0,0,0,,2-төбе нақты 3-ерекше
Dialogue: 0,0:03:44.91,0:03:47.56,Default,,0,0,0,,...
Dialogue: 0,0:03:47.96,0:03:51.83,Default,,0,0,0,,...
Dialogue: 0,0:03:52.85,0:03:58.42,Default,,0,0,0,,Бұл өте күшті және күшті талант... Жағдайлар
Dialogue: 0,0:04:03.31,0:04:05.78,Default,,0,0,0,,Мен... 14-тарау
Dialogue: 0,0:04:06.18,0:04:07.55,Default,,0,0,0,,15-жылдық
Dialogue: 0,0:04:06.18,0:04:07.55,Default,,0,0,0,,Мен мұнда 10-шымын
Dialogue: 0,0:04:08.48,0:04:10.18,Default,,0,0,0,,Алыс
Dialogue: 0,0:04:10.92,0:04:14.58,Default,,0,0,0,,Қашықтық жұлдызды шар ханшайымының уақыты көп
Dialogue: 0,0:04:15.29,0:04:18.96,Default,,0,0,0,,Маған қызметті пайдаланудың қажеті жоқ, бірақ мен де бар күшімді саламын.
Dialogue: 0,0:04:19.96,0:04:20.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:22.52,0:04:23.94,Default,,0,0,0,,Жақсы көр! сенімді
Dialogue: 0,0:04:24.15,0:04:24.74,Default,,0,0,0,,Шыны
Dialogue: 0,0:04:24.89,0:04:25.46,Default,,0,0,0,,Неаполь, таңғы 11:26
Dialogue: 0,0:04:26.23,0:04:27.37,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:04:27.97,0:04:29.02,Default,,0,0,0,,Мама…
Dialogue: 0,0:04:30.51,0:04:34.27,Default,,0,0,0,,Патша қарсы алатын уақыттың тосындығы
Dialogue: 0,0:04:31.47,0:04:32.88,Default,,0,0,0,,Тайм-шо фракциясы?
Dialogue: 0,0:04:35.22,0:04:36.23,Default,,0,0,0,,(дауыс)
Dialogue: 0,0:04:36.81,0:04:37.96,Default,,0,0,0,,Жалғасы
Dialogue: 0,0:04:38.28,0:04:39.18,Default,,0,0,0,,Қайра ханым
Dialogue: 0,0:04:41.90,0:04:44.17,Default,,0,0,0,,Мен оқиға кезеңіне қатысуым керек.
Dialogue: 0,0:04:44.37,0:04:46.84,Default,,0,0,0,,Жұмысқа қабылдау процесіне қатысу
Dialogue: 0,0:04:48.70,0:04:50.88,Default,,0,0,0,,Бұл бірінші сұрақ па?
Dialogue: 0,0:04:51.19,0:04:54.10,Default,,0,0,0,,Көбінесе қала ағымдағы жеткізуші болып табылады.
Dialogue: 0,0:04:54.72,0:04:56.89,Default,,0,0,0,,Менің дизайнерлік менеджерім Томоя келді.
Dialogue: 0,0:04:57.08,0:04:58.95,Default,,0,0,0,,Зерттеуге қатысу
Dialogue: 0,0:04:59.78,0:05:01.33,Default,,0,0,0,,...
Dialogue: 0,0:05:01.80,0:05:03.99,Default,,0,0,0,,Сезімтал және зиянды
Dialogue: 0,0:05:06.72,0:05:09.18,Default,,0,0,0,,★  ·
Dialogue: 0,0:05:08.22,0:05:10.73,Default,,0,0,0,,Бұл киюді қажет ететін жұлдыз...
Dialogue: 0,0:05:10.90,0:05:13.30,Default,,0,0,0,,Кілтті қараңыз
Dialogue: 0,0:05:14.09,0:05:15.36,Default,,0,0,0,,Біреуін кию керек пе?
Dialogue: 0,0:05:15.74,0:05:22.25,Default,,0,0,0,,Мысалы, ішімдік сататын дүкен мен мейрамханаға қатысқанда, үйлесімді киім киген кезде...?
Dialogue: 0,0:05:22.40,0:05:26.52,Default,,0,0,0,,Бұл бұзылу болмаған жағдайда.
Dialogue: 0,0:05:26.94,0:05:27.93,Default,,0,0,0,,Гай
Dialogue: 0,0:05:28.26,0:05:29.86,Default,,0,0,0,,Ересектер әлемі...
Dialogue: 0,0:05:30.54,0:05:34.41,Default,,0,0,0,,Жақында қол жеткізілмеген немесе басқа жолмен ләззат алған жоқ
Dialogue: 0,0:05:35.07,0:05:39.64,Default,,0,0,0,,Қазіргі қаланың келбетін әр уақытта өзгерту қажет.
Dialogue: 0,0:05:40.02,0:05:42.09,Default,,0,0,0,,Уэдзи Йошизо – көбелек тізбегі
Dialogue: 0,0:05:42.27,0:05:44.72,Default,,0,0,0,,Алдыңғы бірінші жақсы сурет толық қызыл ұнтақ пальто ма?
Dialogue: 0,0:05:44.95,0:05:46.25,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:05:46.44,0:05:47.69,Default,,0,0,0,,Мен өте бақыттымын!
Dialogue: 0,0:05:48.27,0:05:51.45,Default,,0,0,0,,Демек, бұл келесі жұлдыз
Dialogue: 0,0:05:51.85,0:05:56.03,Default,,0,0,0,,...
Dialogue: 0,0:05:56.37,0:05:58.02,Default,,0,0,0,,...
Dialogue: 0,0:05:58.54,0:06:01.86,Default,,0,0,0,,Жұлдызша элементі пайда болғаннан кейін мүмкін болады.
Dialogue: 0,0:06:02.76,0:06:04.69,Default,,0,0,0,,Белгілі бір дағды көлемі қажет
Dialogue: 0,0:06:06.24,0:06:08.54,Default,,0,0,0,,...
Dialogue: 0,0:06:09.51,0:06:10.63,Default,,0,0,0,,...
Dialogue: 0,0:06:10.78,0:06:13.07,Default,,0,0,0,,Уақытымды жоғалтқан кезде мен сізге көмектесе алдым.
Dialogue: 0,0:06:13.22,0:06:14.06,Default,,0,0,0,,!?
Dialogue: 0,0:06:14.36,0:06:19.14,Default,,0,0,0,,Фьюжн саятшылықтың жаңа нұсқасына дайындық.
Dialogue: 0,0:06:19.37,0:06:20.58,Default,,0,0,0,,Шынайы амбиция
Dialogue: 0,0:06:20.76,0:06:21.93,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:23.69,0:06:27.78,Default,,0,0,0,,Ой...
Dialogue: 0,0:06:32.93,0:06:35.38,Default,,0,0,0,,Шағын басылым Norai Bosy?
Dialogue: 0,0:06:35.83,0:06:36.67,Default,,0,0,0,,...
Dialogue: 0,0:06:42.07,0:06:44.66,Default,,0,0,0,,Ағынның бағыты бойынша есептер
Dialogue: 0,0:06:45.16,0:06:49.06,Default,,0,0,0,,Банкеттен тыс киім Тамақты жіберу уақыты мен орны...
Dialogue: 0,0:06:51.11,0:06:54.58,Default,,0,0,0,,...
Dialogue: 0,0:06:57.01,0:06:59.63,Default,,0,0,0,,Мен не көргім келеді?
Dialogue: 0,0:07:00.03,0:07:02.27,Default,,0,0,0,,Осы мектеп залының ішкі көрінісі
Dialogue: 0,0:07:02.45,0:07:04.52,Default,,0,0,0,,Қатысу да шақырудың бір түрі.
Dialogue: 0,0:07:04.70,0:07:08.49,Default,,0,0,0,,Дарындылық ең маңыздысы ма?
Dialogue: 0,0:07:09.99,0:07:13.33,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:07:13.77,0:07:14.78,Default,,0,0,0,,Ой...
Dialogue: 0,0:07:14.95,0:07:20.11,Default,,0,0,0,,Қажетті әсер Токиоға күтпеген жерден келуге болады.
Dialogue: 0,0:07:22.12,0:07:23.44,Default,,0,0,0,,Қайырлы түн
Dialogue: 0,0:07:31.82,0:07:33.97,Default,,0,0,0,,...
Dialogue: 0,0:07:37.52,0:07:42.39,Default,,0,0,0,,Ол жерге қалай жетуге болады
Dialogue: 0,0:07:42.73,0:07:43.98,Default,,0,0,0,,Бұған қалай қарайсыз?
Dialogue: 0,0:07:44.18,0:07:47.89,Default,,0,0,0,,...
Dialogue: 0,0:07:48.14,0:07:49.77,Default,,0,0,0,,Шағын басылым Сіздің қолыңыздан келеді!
Dialogue: 0,0:07:50.11,0:07:53.17,Default,,0,0,0,,Сіз қандай бұрыштардан шығасыз?
Dialogue: 0,0:07:53.82,0:07:55.77,Default,,0,0,0,,Қалаған үй иесі Тоно Тойобокушин
Dialogue: 0,0:07:55.93,0:07:56.67,Default,,0,0,0,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:08:00.70,0:08:05.11,Default,,0,0,0,,Бұл қағазға қатысу дұрыс емес пе?
Dialogue: 0,0:08:05.49,0:08:10.52,Default,,0,0,0,,... ...
Dialogue: 0,0:08:11.31,0:08:12.47,Default,,0,0,0,,Менің алдын ала сезімім айқын көрсетті, мен жеңетінімді
Dialogue: 0,0:08:13.00,0:08:18.97,Default,,0,0,0,,...
Dialogue: 0,0:08:19.61,0:08:23.58,Default,,0,0,0,,Бейбіт уақыттағы шабуылдар мен айырмашылық нүктелері
Dialogue: 0,0:08:23.75,0:08:26.85,Default,,0,0,0,,Бірақ адамдар қанша рет қатысты?
Dialogue: 0,0:08:28.01,0:08:30.38,Default,,0,0,0,,Әңгіме мынада: мен сенімдімін...
Dialogue: 0,0:08:31.43,0:08:33.86,Default,,0,0,0,,Бұл жол...
Dialogue: 0,0:08:34.01,0:08:36.26,Default,,0,0,0,,Сондықтан, Натенга сегунаттан кейінгі жедел уәкілдерге жұмысқа алынды...
Dialogue: 0,0:08:36.42,0:08:40.16,Default,,0,0,0,,Егер сіз бізге қосылғыңыз келсе, біздің мектепке келіңіз және мүмкіндікті пайдаланыңыз.
Dialogue: 0,0:08:40.33,0:08:41.08,Default,,0,0,0,,...
Dialogue: 0,0:08:41.26,0:08:43.87,Default,,0,0,0,,Тұрақты түрде ойнау
Dialogue: 0,0:08:44.02,0:08:45.16,Default,,0,0,0,,Бұл тиімді мүмкіндік.
Dialogue: 0,0:08:45.50,0:08:47.98,Default,,0,0,0,,Өте қызық!
Dialogue: 0,0:08:48.16,0:08:48.76,Default,,0,0,0,,...
Dialogue: 0,0:08:48.94,0:08:50.64,Default,,0,0,0,,Алға жүгір!
Dialogue: 0,0:08:50.80,0:08:54.36,Default,,0,0,0,,Жүрегіңді тастасаң, ерекше орынға жетесің!!
Dialogue: 0,0:09:04.43,0:09:07.13,Default,,0,0,0,,... ...
Dialogue: 0,0:09:07.32,0:09:09.91,Default,,0,0,0,,Сіз шағын басылымды оқыдыңыз ба?
Dialogue: 0,0:09:10.39,0:09:12.94,Default,,0,0,0,,Өлім... Өлім...
Dialogue: 0,0:09:13.13,0:09:15.20,Default,,0,0,0,,Бұл бірінші тапсырма ма?
Dialogue: 0,0:09:15.39,0:09:15.90,Default,,0,0,0,,т.б. т.б. т.б.
Dialogue: 0,0:09:16.08,0:09:17.77,Default,,0,0,0,,Мұндағы жағдай қандай?
Dialogue: 0,0:09:17.95,0:09:18.59,Default,,0,0,0,,Мен не айтамын?
Dialogue: 0,0:09:18.79,0:09:21.81,Default,,0,0,0,,Шіркеуге келу және тәжірибеден ләззат алу мүмкіндігі
Dialogue: 0,0:09:22.46,0:09:25.84,Default,,0,0,0,,Бұл ағымдағы бағдарламаның басы.
Dialogue: 0,0:09:26.21,0:09:29.90,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:09:31.02,0:09:32.96,Default,,0,0,0,,Бұл жерде болудың қажеті жоқ...
Dialogue: 0,0:09:33.16,0:09:34.78,Default,,0,0,0,,Кішігірім мәліметтер қажет емес
Dialogue: 0,0:09:35.04,0:09:36.82,Default,,0,0,0,,Қабілеттен ләззат алу – хобби
Dialogue: 0,0:09:37.89,0:09:39.15,Default,,0,0,0,,...
Dialogue: 0,0:09:41.14,0:09:42.98,Default,,0,0,0,,Бірінші түбі
Dialogue: 0,0:09:43.64,0:09:47.75,Default,,0,0,0,,Теріге табиғи ұнтақты ұстауды талап етеді, қажетті дозаның төменгі шегі
Dialogue: 0,0:09:48.08,0:09:50.21,Default,,0,0,0,,Қандай түсті көргілеріңіз келеді?
Dialogue: 0,0:09:50.36,0:09:51.78,Default,,0,0,0,,Бұл сергітетін ашық жасыл
Dialogue: 0,0:09:51.92,0:09:53.60,Default,,0,0,0,,... ...
Dialogue: 0,0:09:54.04,0:09:58.80,Default,,0,0,0,,Көздің анық болуы шарт емес.
Dialogue: 0,0:09:59.40,0:10:02.91,Default,,0,0,0,,Түстің түсі ме, әлде жарықтың түсі ме?
Dialogue: 0,0:10:04.00,0:10:05.05,Default,,0,0,0,,Рас
Dialogue: 0,0:10:06.71,0:10:09.03,Default,,0,0,0,,Бас сүйегінің төбесінің қызыл түсті ізі
Dialogue: 0,0:10:09.35,0:10:11.51,Default,,0,0,0,,Үлкен жетілгендік Үлкен зерделілік
Dialogue: 0,0:10:15.04,0:10:17.81,Default,,0,0,0,,Зайкучи Каге Учиаже Мицунори
Dialogue: 0,0:10:18.37,0:10:21.27,Default,,0,0,0,,Дененің әйелдік сүйкімділігін көрсететін ерін бояуы.
Dialogue: 0,0:10:23.16,0:10:25.84,Default,,0,0,0,,Керемет әсер
Dialogue: 0,0:10:26.01,0:10:28.78,Default,,0,0,0,,Тек оны байқап көріңіз және оны ұстаңыз.
Dialogue: 0,0:10:37.85,0:10:38.95,Default,,0,0,0,,Сәттілік Кудо Рё
Dialogue: 0,0:10:39.11,0:10:40.60,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:10:44.88,0:10:47.37,Default,,0,0,0,,Мен не істеуім керек...?
Dialogue: 0,0:10:48.28,0:10:50.03,Default,,0,0,0,,Астананы сезіну өзін-өзі қабылдамайды...
Dialogue: 0,0:10:51.15,0:10:52.32,Default,,0,0,0,,Жақсы немесе жаман!
Dialogue: 0,0:10:52.77,0:10:56.57,Default,,0,0,0,,...
Dialogue: 0,0:10:56.96,0:10:58.87,Default,,0,0,0,,Иә! сәттілік
Dialogue: 0,0:10:59.31,0:11:01.95,Default,,0,0,0,,Жолдан шығу мүмкін емес пе?
Dialogue: 0,0:11:02.48,0:11:03.34,Default,,0,0,0,,...
Dialogue: 0,0:11:16.54,0:11:19.32,Default,,0,0,0,,Жақсы жылжымалы шамның шағын басылымы
Dialogue: 0,0:11:20.12,0:11:22.81,Default,,0,0,0,,Сыртта жарық жанып тұр және сезім өте қызықты.
Dialogue: 0,0:11:23.81,0:11:26.82,Default,,0,0,0,,Әрбір аспан астанасының көрінісі
Dialogue: 0,0:11:27.21,0:11:28.48,Default,,0,0,0,,Толық сипаттама...
Dialogue: 0,0:11:28.82,0:11:33.19,Default,,0,0,0,,Өзін өзі жасаған орындаушы әйелдің әсері
Dialogue: 0,0:11:34.17,0:11:38.32,Default,,0,0,0,,Қойылым көрмеден өзгеше.
Dialogue: 0,0:11:38.95,0:11:42.07,Default,,0,0,0,,Демек, бұл өзін-өзі жандандыру және өзіне деген сенімділік.
Dialogue: 0,0:11:42.79,0:11:45.12,Default,,0,0,0,,Учикари Сайбо Рё
Dialogue: 0,0:11:45.35,0:11:46.17,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:11:46.33,0:11:47.53,Default,,0,0,0,,Жоғарыдағы сұрау
Dialogue: 0,0:11:49.04,0:11:50.64,Default,,0,0,0,,Мен не білдім
Dialogue: 0,0:11:50.80,0:11:53.17,Default,,0,0,0,,Сіз ұстанатын қазіргі көңіл-күй
Dialogue: 0,0:11:53.80,0:11:56.07,Default,,0,0,0,,Қажетсіз ұмытшақтықтан ләззат алу
Dialogue: 0,0:11:56.91,0:11:57.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Көз
Dialogue: 0,0:12:18.61,0:12:20.37,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:12:20.70,0:12:21.53,Default,,0,0,0,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:12:21.70,0:12:23.27,Default,,0,0,0,,...
Dialogue: 0,0:12:23.80,0:12:25.29,Default,,0,0,0,,жоқ Мұнда емес
Dialogue: 0,0:12:25.57,0:12:27.21,Default,,0,0,0,,Менің сұрағым ләззат алу сезімі.
Dialogue: 0,0:12:27.39,0:12:30.28,Default,,0,0,0,,...
Dialogue: 0,0:12:30.45,0:12:32.09,Default,,0,0,0,,Жақсы мен жүгірдім
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Аниме
Dialogue: 0,0:13:02.50,0:13:03.70,Default,,0,0,0,,Гай!
Dialogue: 0,0:13:04.00,0:13:05.07,Default,,0,0,0,,Жақсы немесе жаман!
Dialogue: 0,0:13:05.22,0:13:07.41,Default,,0,0,0,,Үлкен астана киетін жұлдызды элементар киім
Dialogue: 0,0:13:07.72,0:13:08.82,Default,,0,0,0,,Нағыз фигура!
Dialogue: 0,0:13:09.00,0:13:11.89,Default,,0,0,0,,Үй иесінен алған керемет әсер!
Dialogue: 0,0:13:12.13,0:13:16.04,Default,,0,0,0,,...
Dialogue: 0,0:13:16.28,0:13:19.71,Default,,0,0,0,,Киімге қойылатын талаптардың толықтығы, адамдардың қабілетін біріктіру барысы.
Dialogue: 0,0:13:19.88,0:13:20.72,Default,,0,0,0,,...
Dialogue: 0,0:13:21.26,0:13:22.05,Default,,0,0,0,,Дайсуке
Dialogue: 0,0:13:22.57,0:13:23.44,Default,,0,0,0,,...
Dialogue: 0,0:13:23.83,0:13:26.45,Default,,0,0,0,,...
Dialogue: 0,0:13:26.79,0:13:28.11,Default,,0,0,0,,Шағын басылым!
Dialogue: 0,0:13:28.29,0:13:30.39,Default,,0,0,0,,Гай! Шағын шығарылым Koka Love!
Dialogue: 0,0:13:30.61,0:13:32.58,Default,,0,0,0,,Мына қалпақ сізге жарасады.
Dialogue: 0,0:13:33.01,0:13:34.01,Default,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:13:34.22,0:13:36.24,Default,,0,0,0,,Ұлы жұлдызды жадағай мен таяқ
Dialogue: 0,0:13:36.50,0:13:37.72,Default,,0,0,0,,...
Dialogue: 0,0:13:38.45,0:13:40.66,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:13:49.36,0:13:50.72,Default,,0,0,0,,...
Dialogue: 0,0:13:51.24,0:13:52.56,Default,,0,0,0,,Жақсы тамақ!
Dialogue: 0,0:13:52.77,0:13:55.76,Default,,0,0,0,,Мектеп өлімінің басы ма?
Dialogue: 0,0:13:56.11,0:13:57.23,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:13:57.41,0:14:00.16,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:14:00.56,0:14:01.33,Default,,0,0,0,,...
Dialogue: 0,0:14:03.66,0:14:04.54,Default,,0,0,0,,Теңіз жұлдызы?
Dialogue: 0,0:14:04.72,0:14:05.32,Default,,0,0,0,,...
Dialogue: 0,0:14:05.57,0:14:08.04,Default,,0,0,0,,Негізсіз! Міне жұлдыз!
Dialogue: 0,0:14:08.26,0:14:11.04,Default,,0,0,0,,...
Dialogue: 0,0:14:11.35,0:14:15.19,Default,,0,0,0,,Оқып, түсінуге болатын пұттар
Dialogue: 0,0:14:15.46,0:14:18.13,Default,,0,0,0,,үшін? Нанаку деген сөз...
Dialogue: 0,0:14:18.65,0:14:20.79,Default,,0,0,0,,Жақсы көрініс Жақсы көрініс
Dialogue: 0,0:14:22.48,0:14:24.86,Default,,0,0,0,,Гай! Керемет махаббат!
Dialogue: 0,0:14:25.11,0:14:26.24,Default,,0,0,0,,...
Dialogue: 0,0:14:28.55,0:14:31.70,Default,,0,0,0,,Мен үшін бірінші ойынды ойнау өте қызықты!
Dialogue: 0,0:14:31.93,0:14:33.71,Default,,0,0,0,,қолайлы белгілі бір маңызды!
Dialogue: 0,0:14:34.09,0:14:36.81,Default,,0,0,0,,1
Dialogue: 0,0:14:37.06,0:14:39.38,Default,,0,0,0,,1
Dialogue: 0,0:14:40.11,0:14:44.13,Default,,0,0,0,,Бұл ескі атау.
Dialogue: 0,0:14:44.33,0:14:46.33,Default,,0,0,0,,...
Dialogue: 0,0:14:46.72,0:14:48.76,Default,,0,0,0,,...
Dialogue: 0,0:14:48.98,0:14:51.19,Default,,0,0,0,,Гатокай анти-супер-сіз
Dialogue: 0,0:14:51.72,0:14:53.20,Default,,0,0,0,,...
Dialogue: 0,0:14:53.65,0:14:55.67,Default,,0,0,0,,Сіздің осында болғаныма қуаныштымын.
Dialogue: 0,0:14:55.88,0:14:58.55,Default,,0,0,0,,Ең алдымен тікелей болу керек.
Dialogue: 0,0:14:58.75,0:14:59.92,Default,,0,0,0,,Мустификация
Dialogue: 0,0:15:00.08,0:15:01.62,Default,,0,0,0,,...
Dialogue: 0,0:15:01.85,0:15:04.29,Default,,0,0,0,,Енді кететін уақыт келді!
Dialogue: 0,0:15:04.62,0:15:07.84,Default,,0,0,0,,Өндірістік киімдердің сапасы жақсы.
Dialogue: 0,0:15:08.06,0:15:11.05,Default,,0,0,0,,Міне, біз мұны істеуге тырысамыз.
Dialogue: 0,0:15:11.32,0:15:13.73,Default,,0,0,0,,Жағдаяттан туындайтын күтулер
Dialogue: 0,0:15:13.88,0:15:15.13,Default,,0,0,0,,Елордада екінші орын?
Dialogue: 0,0:15:15.36,0:15:17.10,Default,,0,0,0,,...
Dialogue: 0,0:15:17.27,0:15:19.87,Default,,0,0,0,,Түсінгеніңізге рахмет.
Dialogue: 0,0:15:20.06,0:15:21.80,Default,,0,0,0,,...
Dialogue: 0,0:15:22.20,0:15:25.39,Default,,0,0,0,,Жақсы! Менің жүрегім сенімен бірге.
Dialogue: 0,0:15:25.86,0:15:28.24,Default,,0,0,0,,Шын жүректен ләззат алыңыз!
Dialogue: 0,0:15:30.56,0:15:33.57,Default,,0,0,0,,...
Dialogue: 0,0:15:33.74,0:15:35.78,Default,,0,0,0,,(соғыс айқайы)
Dialogue: 0,0:15:36.08,0:15:38.60,Default,,0,0,0,,Жерден толық ләззат алу
Dialogue: 0,0:15:38.79,0:15:40.86,Default,,0,0,0,,Менің ескертуім келесі тармаққа дайын.
Dialogue: 0,0:15:41.19,0:15:44.52,Default,,0,0,0,,Мен өзім екенмін деген рас па?
Dialogue: 0,0:15:44.69,0:15:46.06,Default,,0,0,0,,(күлді)
Dialogue: 0,0:15:46.68,0:15:49.58,Default,,0,0,0,,Өндіріске арналған сигнал
Dialogue: 0,0:15:49.76,0:15:51.79,Default,,0,0,0,,Мен сыйлықты жеткізу қызметімін!
Dialogue: 0,0:15:52.26,0:15:53.89,Default,,0,0,0,,Туған жұлдыздарға бата
Dialogue: 0,0:15:54.07,0:15:57.13,Default,,0,0,0,,...
Dialogue: 0,0:15:59.48,0:16:00.89,Default,,0,0,0,,Рио Коуки...
Dialogue: 0,0:16:01.46,0:16:05.20,Default,,0,0,0,,Бұл көрініс туралы естеліктер - менің көмекшім/шағын басылым
Dialogue: 0,0:16:05.41,0:16:06.70,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:16:06.94,0:16:09.51,Default,,0,0,0,,(соғыс айқайы)
Dialogue: 0,0:16:09.72,0:16:11.64,Default,,0,0,0,,...
Dialogue: 0,0:16:11.92,0:16:13.43,Default,,0,0,0,,Бұл ең жақсы нәрсе!
Dialogue: 0,0:16:14.02,0:16:18.80,Default,,0,0,0,,Иә, бұл менің өмірімдегі ең ыстық сәт!
Dialogue: 0,0:16:19.14,0:16:20.71,Default,,0,0,0,,Ганпай
Dialogue: 0,0:16:20.87,0:16:22.78,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:16:33.86,0:16:34.99,Default,,0,0,0,,Шағын басылым
Dialogue: 0,0:16:35.60,0:16:36.46,Default,,0,0,0,,Келесі аялдама!
Dialogue: 0,0:16:36.61,0:16:37.40,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:16:48.32,0:16:49.20,Default,,0,0,0,,Шағын басылым
Dialogue: 0,0:16:49.37,0:16:50.13,Default,,0,0,0,,...
Dialogue: 0,0:16:50.39,0:16:51.20,Default,,0,0,0,,Қайра ханым
Dialogue: 0,0:16:51.43,0:16:53.58,Default,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,0:16:53.83,0:16:58.49,Default,,0,0,0,,Бұл үй иесінің ашық пікірі.
Dialogue: 0,0:16:58.70,0:16:59.74,Default,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:16:59.89,0:17:01.61,Default,,0,0,0,,Бір рет орындаудың қажеті жоқ па?
Dialogue: 0,0:17:01.79,0:17:02.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:02.85,0:17:06.01,Default,,0,0,0,,Таң қалдыратын өнімділік
Dialogue: 0,0:17:06.18,0:17:07.02,Default,,0,0,0,,...
Dialogue: 0,0:17:07.56,0:17:09.81,Default,,0,0,0,,Қарқынның шарықтау шегі!
Dialogue: 0,0:17:10.00,0:17:14.04,Default,,0,0,0,,Сіз не істей алатыныңыз туралы көбірек білгіңіз келе ме?
Dialogue: 0,0:17:15.36,0:17:16.39,Default,,0,0,0,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:17:24.53,0:17:26.11,Default,,0,0,0,,Сенкио Оба
Dialogue: 0,0:17:24.53,0:17:26.11,Default,,0,0,0,,Ғажайыптар әлемінің құйрығы
Dialogue: 0,0:17:28.12,0:17:29.92,Default,,0,0,0,,Біз қалай бастағанымыз туралы әңгіме
Dialogue: 0,0:17:30.30,0:17:32.34,Default,,0,0,0,,Мен осы уақытта осындамын.
Dialogue: 0,0:17:32.83,0:17:33.82,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:17:40.23,0:17:41.67,Default,,0,0,0,,Цунехару Вистерия Ұйқыдағы ару
Dialogue: 0,0:17:40.23,0:17:41.67,Default,,0,0,0,,Ұйқыдағы шырмауық
Dialogue: 0,0:17:43.51,0:17:46.13,Default,,0,0,0,,Ұйықтап жатқанда оянғаннан кейін
Dialogue: 0,0:17:50.22,0:17:51.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:14.60,0:18:16.00,Default,,0,0,0,,Құрама иллюзия айнасы
Dialogue: 0,0:18:14.60,0:18:16.00,Default,,0,0,0,,Жоғары сән айнасы
Dialogue: 0,0:18:18.01,0:18:19.65,Default,,0,0,0,,Вокзал алдында
Dialogue: 0,0:18:19.80,0:18:23.27,Default,,0,0,0,,Жарықтан нұрын шашқан кербез нұр
Dialogue: 0,0:18:23.42,0:18:24.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:30.35,0:18:31.99,Default,,0,0,0,,Толқынды иіссу
Dialogue: 0,0:18:30.35,0:18:31.99,Default,,0,0,0,,Қазіргі заманғы хош иіс суы
Dialogue: 0,0:18:33.75,0:18:37.16,Default,,0,0,0,,Хуами жұпары үшінның мастығы
Dialogue: 0,0:19:01.39,0:19:06.46,Default,,0,0,0,,(соғыс айқайы)
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Тікелей эфир
Dialogue: 0,0:21:18.28,0:21:21.53,Default,,0,0,0,,(соғыс айқайы)
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Драма
Dialogue: 0,0:21:22.62,0:21:23.96,Default,,0,0,0,,Ганпай
Dialogue: 0,0:21:30.11,0:21:31.79,Default,,0,0,0,,Қазір қиын
Dialogue: 0,0:21:32.08,0:21:35.37,Default,,0,0,0,,Шағын басылым жоқ Заңның сәтті шыққаны.
Dialogue: 0,0:21:35.79,0:21:36.88,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:21:37.17,0:21:39.56,Default,,0,0,0,,Тұтынушы емес... Сізді аяймын.
Dialogue: 0,0:21:39.99,0:21:42.80,Default,,0,0,0,,Қарбалас жұмыс барысында мен көп нәрсені үйрендім.
Dialogue: 0,0:21:43.61,0:21:44.74,Default,,0,0,0,,Аняның үйіне қош келдіңіз
Dialogue: 0,0:21:45.13,0:21:48.10,Default,,0,0,0,,Үй иесінің орындауы
Dialogue: 0,0:21:48.39,0:21:50.02,Default,,0,0,0,,Жүректі жақсы ашады
Dialogue: 0,0:21:50.32,0:21:52.05,Default,,0,0,0,,Сабырлық жүректен түседі
Dialogue: 0,0:21:52.56,0:21:54.81,Default,,0,0,0,,Үй иесінің күлкісіне қараңыз.
Dialogue: 0,0:21:55.15,0:21:57.92,Default,,0,0,0,,Көптеген үлкен күш-жігер
Dialogue: 0,0:21:58.25,0:21:59.38,Default,,0,0,0,,Тек тырысып ба?
Dialogue: 0,0:22:02.28,0:22:05.08,Default,,0,0,0,,Ұмытылмас естеліктерден ләззат алу
Dialogue: 0,0:22:05.21,0:22:06.05,Default,,0,0,0,,...
Dialogue: 0,0:22:06.20,0:22:08.37,Default,,0,0,0,,Бұл бірлескен іс-әрекет! артқа
Dialogue: 0,0:22:08.98,0:22:09.98,Default,,0,0,0,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:22:11.19,0:22:12.60,Default,,0,0,0,,Мен жүгірген кезде
Dialogue: 0,0:22:12.95,0:22:14.07,Default,,0,0,0,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:23:56.63,0:23:59.69,Default,,0,0,0,,Заманауи хош иіс суы уақыттың мәні ме?
Dialogue: 0,0:23:59.88,0:24:01.71,Default,,0,0,0,,Парфюмерия
Dialogue: 0,0:24:01.89,0:24:02.75,Default,,0,0,0,,Парфюмерия?
Dialogue: 0,0:24:02.88,0:24:05.45,Default,,0,0,0,,Осыған байланысты үлкен апа үлкенірек және хош иісті.
Dialogue: 0,0:24:05.63,0:24:06.68,Default,,0,0,0,,Жапон стилі ше?
Dialogue: 0,0:24:06.87,0:24:07.80,Default,,0,0,0,,...
Dialogue: 0,0:24:08.37,0:24:09.42,Default,,0,0,0,,Кадзуки Ойкея
Dialogue: 0,0:24:09.59,0:24:10.53,Default,,0,0,0,,Айнаға кіріңіз!
Dialogue: 0,0:24:11.71,0:24:14.47,Default,,0,0,0,,Жұлдызды доп ханшайымының ұлы шайқасының кезеңі
Dialogue: 0,0:24:14.77,0:24:17.19,Default,,0,0,0,,Шокан
Dialogue: 0,0:24:17.50,0:24:19.02,Default,,0,0,0,,Бимен кездестім.
Dialogue: 0,0:24:19.29,0:24:21.34,Default,,0,0,0,,Өйткені бұл дос, қабілетсіз бағыныңқы.
Dialogue: 0,0:24:21.63,0:24:23.29,Default,,0,0,0,,Жұп жұлдызды шарлардың жинағы!
Dialogue: 0,0:24:23.47,0:24:24.72,Default,,0,0,0,,Өзіңіздің жеке заттарыңыз болсын.
Dialogue: 0,0:00:03.22,0:00:05.08,Default,,0,0,0,,Өзіңіз қалаған адам бола алатын орын
Dialogue: 0,0:00:05.30,0:00:06.43,Default,,0,0,0,,『ｱｲｶﾂﾌﾟﾗﾈｯﾄ！』
Dialogue: 0,0:00:06.63,0:00:07.61,Default,,0,0,0,,басталады
Dialogue: 0,0:00:09.01,0:00:10.01,Default,,0,0,0,,Хэхе~
Dialogue: 0,0:00:11.09,0:00:12.52,Default,,0,0,0,,Әзірге «Икатсу!»
Dialogue: 0,0:00:12.88,0:00:15.39,Default,,0,0,0,,Мен, Май Сакура Отова, орта мектептің 1 курс студенті!
Dialogue: 0,0:00:15.79,0:00:18.78,Default,,0,0,0,,Мен Хананы Айкацу Planet-тегі басты кумир ретінде атқарып жатырмын!
Dialogue: 0,0:00:19.40,0:00:23.00,Default,,0,0,0,,Біздің көйлектерді үнемі тігетін көйлек дизайнері Сара
Dialogue: 0,0:00:23.27,0:00:26.96,Default,,0,0,0,,Мұндай сенімді әпке бұрындары пұт болған екен!
Dialogue: 0,0:00:27.33,0:00:30.28,Default,,0,0,0,,Бағдарламадан ұсыныс ретінде қайтадан сахнаға шыққан Сара.
Dialogue: 0,0:00:30.45,0:00:31.90,Default,,0,0,0,,Керемет қайтып келді
Dialogue: 0,0:00:32.35,0:00:35.73,Default,,0,0,0,,Сіз үшін пұт нені білдіреді деп ойлаған сияқтысыз.
Dialogue: 0,0:00:36.06,0:00:38.68,Default,,0,0,0,,Сахнада тұру арқылы жауабын таптым деп ойлаймын.
Dialogue: 0,0:00:40.03,0:00:41.92,Default,,0,0,0,,Не? Маған?
Dialogue: 0,0:00:43.54,0:00:49.27,Default,,0,0,0,,Иә... Иә, түсіндім.
Dialogue: 0,0:00:53.75,0:00:57.52,Default,,0,0,0,,Ақырында... бұл келді!
Dialogue: 0,0:00:57.79,0:00:59.87,Default,,0,0,0,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,0:01:02.11,0:01:04.64,Default,,0,0,0,,Aikats Fashion Party туралы білесіз бе?
Dialogue: 0,0:01:04.93,0:01:07.82,Default,,0,0,0,,А, біз оны қазір Айкатсу планетасында жасап жатырмыз.
Dialogue: 0,0:01:07.98,0:01:11.09,Default,,0,0,0,,Конструктор эстафеталық кеш өткізеді, солай ма?
Dialogue: 0,0:01:11.44,0:01:13.87,Default,,0,0,0,,Әр жолы оны үздік дизайнер жүргізетіні туралы айтылады.
Dialogue: 0,0:01:14.04,0:01:17.53,Default,,0,0,0,,Дұрыс, сол асу маған келді!
Dialogue: 0,0:01:17.72,0:01:19.89,Default,,0,0,0,,Шынымен!? Құттықтаймыз!
Dialogue: 0,0:01:20.08,0:01:20.91,Default,,0,0,0,,Рахмет
Dialogue: 0,0:01:22.53,0:01:26.32,Default,,0,0,0,,Эй, мен де өз кумирлерімді кешке шақыра аламын ба?
Dialogue: 0,0:01:26.97,0:01:30.85,Default,,0,0,0,,Соңғы кездері бәрі «Планета ханшайымы» Гран-приімен айналысады, солай емес пе?
Dialogue: 0,0:01:31.05,0:01:32.94,Default,,0,0,0,,Мен сізге үзіліс бергім келеді.
Dialogue: 0,0:01:33.54,0:01:34.83,Default,,0,0,0,,Рахмет
Dialogue: 0,0:01:35.10,0:01:36.36,Default,,0,0,0,,Мені шақырыңыз.
Dialogue: 0,0:01:36.54,0:01:37.66,Default,,0,0,0,,ﾌﾌﾌ
Dialogue: 0,0:01:38.51,0:01:42.06,Default,,0,0,0,,Aikats Fashion Party Бұл қызықты болатын сияқты
Dialogue: 0,0:03:28.64,0:03:33.28,Default,,0,0,0,,Қарғыс атсын... Қанша көрсем де, Роз Чан керемет.
Dialogue: 0,0:03:33.83,0:03:35.57,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,0:03:36.20,0:03:36.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:37.57,0:03:38.47,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:41.59,0:03:43.29,Default,,0,0,0,,Айкацу рейтингіндегі соңғы жаңалықтар
Dialogue: 0,0:03:43.47,0:03:44.78,Default,,0,0,0,,Роза бірінші орында
Dialogue: 0,0:03:44.91,0:03:47.56,Default,,0,0,0,,Не? Купиидпен соққыны кесіңіз бе?
Dialogue: 0,0:03:47.96,0:03:51.83,Default,,0,0,0,,Біз осында болған қысқа уақыт ішінде көптеген жеңістерге қол жеткіздік...
Dialogue: 0,0:03:52.85,0:03:58.42,Default,,0,0,0,,Оның күшті күші бар, сондықтан ол мұны істей алады... Менің ойымша.
Dialogue: 0,0:04:03.31,0:04:05.78,Default,,0,0,0,,I… 14 орын
Dialogue: 0,0:04:06.18,0:04:07.55,Default,,0,0,0,,Мен 10-шымын
Dialogue: 0,0:04:08.48,0:04:10.18,Default,,0,0,0,,Бұл әлі алыс
Dialogue: 0,0:04:10.92,0:04:14.58,Default,,0,0,0,,Planet Princes Гран-приіне әлі уақыт бар
Dialogue: 0,0:04:15.29,0:04:18.96,Default,,0,0,0,,Раушанның екпінін жоғалтпау үшін барымызды салайық.
Dialogue: 0,0:04:19.96,0:04:20.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:22.52,0:04:23.94,Default,,0,0,0,,Yahoo! Бұл пошта
Dialogue: 0,0:04:24.15,0:04:24.74,Default,,0,0,0,,Рури-чан
Dialogue: 0,0:04:24.89,0:04:25.46,Default,,0,0,0,,Иә
Dialogue: 0,0:04:26.23,0:04:27.37,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:04:27.97,0:04:29.02,Default,,0,0,0,,Не?Бұл
Dialogue: 0,0:04:31.47,0:04:32.88,Default,,0,0,0,,ﾌｧｯｼｮﾝﾊﾟｰﾃｨｰ？
Dialogue: 0,0:04:35.22,0:04:36.23,Default,,0,0,0,,（ﾉｯｸ）
Dialogue: 0,0:04:36.81,0:04:37.96,Default,,0,0,0,,Иә
Dialogue: 0,0:04:38.28,0:04:39.18,Default,,0,0,0,,Сара-сан
Dialogue: 0,0:04:41.90,0:04:44.17,Default,,0,0,0,,Aikats Fashion Party-ге қатыстыңыз
Dialogue: 0,0:04:44.37,0:04:46.84,Default,,0,0,0,,Хехехе, мен мұны істеуім керек.
Dialogue: 0,0:04:48.70,0:04:50.88,Default,,0,0,0,,Айтпақшы, бұл қандай партия?
Dialogue: 0,0:04:51.19,0:04:54.10,Default,,0,0,0,,Қонақтардың көпшілігі сән индустриясының өкілдері.
Dialogue: 0,0:04:54.72,0:04:56.89,Default,,0,0,0,,Менің дизайнер достарым да келеді.
Dialogue: 0,0:04:57.08,0:04:58.95,Default,,0,0,0,,Қызықты кеш болады деп ойлаймын.
Dialogue: 0,0:04:59.78,0:05:01.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:01.80,0:05:03.99,Default,,0,0,0,,Бұл таңқаларлық көрінеді.
Dialogue: 0,0:05:08.22,0:05:10.73,Default,,0,0,0,,Бұл дресс-кодтың жұлдызы...
Dialogue: 0,0:05:10.90,0:05:13.30,Default,,0,0,0,,Ой, жақсы жерді байқадың.
Dialogue: 0,0:05:14.09,0:05:15.36,Default,,0,0,0,,ﾄﾞﾚｽｺｰﾄﾞ？
Dialogue: 0,0:05:15.74,0:05:22.25,Default,,0,0,0,,Қонақ үй мейрамханасы немесе кеш сияқты орынға лайық деп саналатын киім... солай ма?
Dialogue: 0,0:05:22.40,0:05:26.52,Default,,0,0,0,,Иә, бұл жердің атмосферасын бұзбау үшін белгіленген тәртіп.
Dialogue: 0,0:05:26.94,0:05:27.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:28.26,0:05:29.86,Default,,0,0,0,,Бұл ересектер әлемі сияқты...
Dialogue: 0,0:05:30.54,0:05:34.41,Default,,0,0,0,,Бірақ соңғы уақытта бұл кештерден ләззат алудың бір жолы болды.
Dialogue: 0,0:05:35.07,0:05:39.64,Default,,0,0,0,,Тіпті Ikats сән кештерінде де мен дресс-кодымды әр уақытта өзгертуді ережеге айналдырамын.
Dialogue: 0,0:05:40.02,0:05:42.09,Default,,0,0,0,,Соңғы рет бұл таспа болды.
Dialogue: 0,0:05:42.27,0:05:44.72,Default,,0,0,0,,Бұған дейін бүкіл денең қызғылт түсті ме?
Dialogue: 0,0:05:44.95,0:05:46.25,Default,,0,0,0,,Қызықты.
Dialogue: 0,0:05:46.44,0:05:47.69,Default,,0,0,0,,Мен мұны жақсы көремін!
Dialogue: 0,0:05:48.27,0:05:51.45,Default,,0,0,0,,Ендеше бұл жолы жұлдыздарға тоқталамыз.
Dialogue: 0,0:05:51.85,0:05:56.03,Default,,0,0,0,,Әр адам ғаламшар, жарқыраған жұлдыз деген мағынамен
Dialogue: 0,0:05:56.37,0:05:58.02,Default,,0,0,0,,Уау... бұл керемет!
Dialogue: 0,0:05:58.54,0:06:01.86,Default,,0,0,0,,Жұлдыздарды біріктіретін кез келген сән жарайды.
Dialogue: 0,0:06:02.76,0:06:04.69,Default,,0,0,0,,Мен көзім толы киінуім керек.
Dialogue: 0,0:06:06.24,0:06:08.54,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:06:09.51,0:06:10.63,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:06:10.78,0:06:13.07,Default,,0,0,0,,Мен енді кешке көмектесе алмаймын.
Dialogue: 0,0:06:13.22,0:06:14.06,Default,,0,0,0,,Иә!?
Dialogue: 0,0:06:14.36,0:06:19.14,Default,,0,0,0,,MELTY HOUSE-тың жаңа жұмысына дайындық қызу жүріп жатыр...
Dialogue: 0,0:06:19.37,0:06:20.58,Default,,0,0,0,,Шынымды айтсам, кешіріңіз.
Dialogue: 0,0:06:20.76,0:06:21.93,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:23.69,0:06:27.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:32.93,0:06:35.38,Default,,0,0,0,,Шиори-чан, сен маған көмектесе аласың ба?
Dialogue: 0,0:06:35.83,0:06:36.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:42.07,0:06:44.66,Default,,0,0,0,,Кестеде проблема жоқ.
Dialogue: 0,0:06:45.16,0:06:49.06,Default,,0,0,0,,Мен мұнда тамақтандыруға тапсырыс бергім келеді...
Dialogue: 0,0:06:51.11,0:06:54.58,Default,,0,0,0,,Шиори-чан күткендей, сен маған сене аласың.
Dialogue: 0,0:06:57.01,0:06:59.63,Default,,0,0,0,,Айтпақшы, бұл туралы не ойлайсыз?
Dialogue: 0,0:07:00.03,0:07:02.27,Default,,0,0,0,,Бұл кеш өтетін орынның ішкі көрінісі.
Dialogue: 0,0:07:02.45,0:07:04.52,Default,,0,0,0,,Кеш қонақжайлылық деп аталады.
Dialogue: 0,0:07:04.70,0:07:08.49,Default,,0,0,0,,Ең жақсысы келгендердің көңілді болғаны ғой, солай ма?
Dialogue: 0,0:07:09.99,0:07:13.33,Default,,0,0,0,,Мен бұл үшін не істеуім керек деп ойлаймын.
Dialogue: 0,0:07:13.77,0:07:14.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:14.95,0:07:20.11,Default,,0,0,0,,Егер мен бірдеңені алғым келсе, мен қонақтарды таң қалдыратын нәрсе алғым келеді.
Dialogue: 0,0:07:22.12,0:07:23.44,Default,,0,0,0,,Бұл қиын ба?
Dialogue: 0,0:07:31.82,0:07:33.97,Default,,0,0,0,,Жай ғана ой... Ах.
Dialogue: 0,0:07:37.52,0:07:42.39,Default,,0,0,0,,Мұны осында енгізіңіз
Dialogue: 0,0:07:42.73,0:07:43.98,Default,,0,0,0,,Осындай нәрсе туралы не деуге болады?
Dialogue: 0,0:07:44.18,0:07:47.89,Default,,0,0,0,,Эй... Өте жақсы!
Dialogue: 0,0:07:48.14,0:07:49.77,Default,,0,0,0,,Жасайық, Шиори-чан!
Dialogue: 0,0:07:50.11,0:07:53.17,Default,,0,0,0,,Қонақтың сезімдері Менің ойымша, сіз бұл туралы дұрыс ойлап отырсыз.
Dialogue: 0,0:07:53.82,0:07:55.77,Default,,0,0,0,,үшінна ұнайды деп сенемін.
Dialogue: 0,0:07:55.93,0:07:56.67,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:08:00.70,0:08:05.11,Default,,0,0,0,,Бірақ сол күні Шиори-чан да кешке қонақ ретінде қатысады, солай ма?
Dialogue: 0,0:08:05.49,0:08:10.52,Default,,0,0,0,,Аа...шынымен, мен осыны айтып отырмын...
Dialogue: 0,0:08:11.31,0:08:12.47,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:08:13.00,0:08:18.97,Default,,0,0,0,,Мм... Мен қандай көйлек киерімді білмеймін.
Dialogue: 0,0:08:19.61,0:08:23.58,Default,,0,0,0,,Менің ойымша, кештер кәдімгі кездейсоқ кештерден біршама ерекшеленеді.
Dialogue: 0,0:08:23.75,0:08:26.85,Default,,0,0,0,,Оның үстіне мұнда келетін сәнді адамдар өте көп, солай емес пе?
Dialogue: 0,0:08:28.01,0:08:30.38,Default,,0,0,0,,Мен өзіме сенімді емеспін...
Dialogue: 0,0:08:31.43,0:08:33.86,Default,,0,0,0,,Мен көремін... түсінемін.
Dialogue: 0,0:08:34.01,0:08:36.26,Default,,0,0,0,,Сол күні мен қызметкер болып жұмыс істеймін...
Dialogue: 0,0:08:36.42,0:08:40.16,Default,,0,0,0,,Осы Сара апамызбен кеште киінудің қандай қызық екенін көрсетейін.
Dialogue: 0,0:08:40.33,0:08:41.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:41.26,0:08:43.87,Default,,0,0,0,,Тараптар сізге әдетте жасай алмайтын нәрселерді жасауға мүмкіндік береді.
Dialogue: 0,0:08:44.02,0:08:45.16,Default,,0,0,0,,Бұл қымбат жер.
Dialogue: 0,0:08:45.50,0:08:47.98,Default,,0,0,0,,Киіну өте қызықты!
Dialogue: 0,0:08:48.16,0:08:48.76,Default,,0,0,0,,А...
Dialogue: 0,0:08:48.94,0:08:50.64,Default,,0,0,0,,Енді кеттік!
Dialogue: 0,0:08:50.80,0:08:54.36,Default,,0,0,0,,Мен сізді шиеленіс ең жоғары болатын жерге апарамын!!
Dialogue: 0,0:09:04.43,0:09:07.13,Default,,0,0,0,,Мм... бұл...
Dialogue: 0,0:09:07.32,0:09:09.91,Default,,0,0,0,,Шиори-чан, сіз партиялық ремейк жасадыңыз ба?
Dialogue: 0,0:09:10.39,0:09:12.94,Default,,0,0,0,,Жоқ... жоқ...
Dialogue: 0,0:09:13.13,0:09:15.20,Default,,0,0,0,,Сонымен бүгін сенің бірінші тапсырмаң?
Dialogue: 0,0:09:15.39,0:09:15.90,Default,,0,0,0,,Эй… эй…
Dialogue: 0,0:09:16.08,0:09:17.77,Default,,0,0,0,,Мен жағдайды түсінбеймін.
Dialogue: 0,0:09:17.95,0:09:18.59,Default,,0,0,0,,Мен саған айттым ғой, солай ма?
Dialogue: 0,0:09:18.79,0:09:21.81,Default,,0,0,0,,Мен саған кештерде киінудің қызығын көрсетемін.
Dialogue: 0,0:09:22.46,0:09:25.84,Default,,0,0,0,,Ендеше мен қазір киіну курсын бастаймын.
Dialogue: 0,0:09:26.21,0:09:29.90,Default,,0,0,0,,Бірақ кеш Ikats Planet-те өтеді, солай ма?
Dialogue: 0,0:09:31.02,0:09:32.96,Default,,0,0,0,,Мұны істеу менің міндетім емес...
Dialogue: 0,0:09:33.16,0:09:34.78,Default,,0,0,0,,Мәліметтерге алаңдамаңыз
Dialogue: 0,0:09:35.04,0:09:36.82,Default,,0,0,0,,үшін бірге қызық
Dialogue: 0,0:09:37.89,0:09:39.15,Default,,0,0,0,,Бетіңізді көтеріңіз
Dialogue: 0,0:09:41.14,0:09:42.98,Default,,0,0,0,,Алдымен, негізгі жасаудан бастаңыз.
Dialogue: 0,0:09:43.64,0:09:47.75,Default,,0,0,0,,Терінің жалаңаш сезімін есте сақтай отырып, тоналды негізді ең аз қажетті деңгейде ұстаңыз
Dialogue: 0,0:09:48.08,0:09:50.21,Default,,0,0,0,,Қабақ бояуы Бұл түс туралы не ойлайсыз?
Dialogue: 0,0:09:50.36,0:09:51.78,Default,,0,0,0,,Жасыл жалбызды сергітеді
Dialogue: 0,0:09:51.92,0:09:53.60,Default,,0,0,0,,Уф... жарқыраған...
Dialogue: 0,0:09:54.04,0:09:58.80,Default,,0,0,0,,Оны қабақтарыңызға жағуға болмайды, оны көздің бұрышына екпін ретінде қолданыңыз.
Dialogue: 0,0:09:59.40,0:10:02.91,Default,,0,0,0,,Сіздің өңіңіз ашылып, попыңыз сүйкімді көрінеді, солай ма?
Dialogue: 0,0:10:04.00,0:10:05.05,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:06.71,0:10:09.03,Default,,0,0,0,,Бет сүйектеріне бетті қатты жағыңыз.
Dialogue: 0,0:10:09.35,0:10:11.51,Default,,0,0,0,,Жетілген және зерделі
Dialogue: 0,0:10:15.04,0:10:17.81,Default,,0,0,0,,Ерін далабы үстіне жылтырды қосыңыз
Dialogue: 0,0:10:18.37,0:10:21.27,Default,,0,0,0,,Толық ерінмен сіз бірден әйелдікке айналасыз.
Dialogue: 0,0:10:23.16,0:10:25.84,Default,,0,0,0,,Шашты орналастыру қиын бейне.
Dialogue: 0,0:10:26.01,0:10:28.78,Default,,0,0,0,,Сіз оны үйренгеннен кейін оны оңай сүйкімді ете аласыз.
Dialogue: 0,0:10:37.85,0:10:38.95,Default,,0,0,0,,Енді күте тұрыңыз.
Dialogue: 0,0:10:39.11,0:10:40.60,Default,,0,0,0,,Бәрің де киіндіңдер.
Dialogue: 0,0:10:44.88,0:10:47.37,Default,,0,0,0,,Бұл... мен бе?
Dialogue: 0,0:10:48.28,0:10:50.03,Default,,0,0,0,,Бұл мен емес сияқты...
Dialogue: 0,0:10:51.15,0:10:52.32,Default,,0,0,0,,Керемет!
Dialogue: 0,0:10:52.77,0:10:56.57,Default,,0,0,0,,Сіздің шиеленісіңіз көтерілді ме?
Dialogue: 0,0:10:56.96,0:10:58.87,Default,,0,0,0,,Иә! Батчили
Dialogue: 0,0:10:59.31,0:11:01.95,Default,,0,0,0,,Олай болса, осылай шығамыз ба?
Dialogue: 0,0:11:02.48,0:11:03.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:16.54,0:11:19.32,Default,,0,0,0,,Шиори-чан өте әдемі
Dialogue: 0,0:11:20.12,0:11:22.81,Default,,0,0,0,,Осылай жүрудің өзі мені толқытады
Dialogue: 0,0:11:23.81,0:11:26.82,Default,,0,0,0,,Әдеттегідей бір декорация басқаша көрінеді
Dialogue: 0,0:11:27.21,0:11:28.48,Default,,0,0,0,,Қалай айта аламын...
Dialogue: 0,0:11:28.82,0:11:33.19,Default,,0,0,0,,Мен өзімді актриса болғандай сезінемін.
Dialogue: 0,0:11:34.17,0:11:38.32,Default,,0,0,0,,Киіну басқаларға көріну үшін жасайтын нәрсе емес.
Dialogue: 0,0:11:38.95,0:11:42.07,Default,,0,0,0,,Бұл маған қуат пен сенімділік береді.
Dialogue: 0,0:11:42.79,0:11:45.12,Default,,0,0,0,,Киіну керемет.
Dialogue: 0,0:11:45.35,0:11:46.17,Default,,0,0,0,,Иә
Dialogue: 0,0:11:46.33,0:11:47.53,Default,,0,0,0,,Сондықтан жиіркенішті
Dialogue: 0,0:11:49.04,0:11:50.64,Default,,0,0,0,,Бұл тәуелділік тудыратын сияқты
Dialogue: 0,0:11:50.80,0:11:53.17,Default,,0,0,0,,Сол рухпен мен де кеш өткізгім келеді.
Dialogue: 0,0:11:53.80,0:11:56.07,Default,,0,0,0,,Көңілді болуды ұмытпаңыз
Dialogue: 0,0:11:56.91,0:11:57.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Көз
Dialogue: 0,0:12:18.61,0:12:20.37,Default,,0,0,0,,Енді дайынсың ба?
Dialogue: 0,0:12:20.70,0:12:21.53,Default,,0,0,0,,Иә
Dialogue: 0,0:12:21.70,0:12:23.27,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:12:23.80,0:12:25.29,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:12:25.57,0:12:27.21,Default,,0,0,0,,Ләззат алуға дайындық
Dialogue: 0,0:12:27.39,0:12:30.28,Default,,0,0,0,,А... Иә, бәрі жақсы.
Dialogue: 0,0:12:30.45,0:12:32.09,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,Драма
Dialogue: 0,0:21:22.62,0:21:23.96,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:21:30.11,0:21:31.79,Default,,0,0,0,,Бүгінгі қажырлы еңбектеріңізге рахмет.
Dialogue: 0,0:21:32.08,0:21:35.37,Default,,0,0,0,,Егер Шиори-чан болмағанда, партия сәтті болмас еді.
Dialogue: 0,0:21:35.79,0:21:36.88,Default,,0,0,0,,Еңбек тәжірибесі бағдарламасына оралды
Dialogue: 0,0:21:37.17,0:21:39.56,Default,,0,0,0,,Болды... жарайсыңдар.
Dialogue: 0,0:21:39.99,0:21:42.80,Default,,0,0,0,,Көмек Мен көп нәрсені білдім
Dialogue: 0,0:21:43.61,0:21:44.74,Default,,0,0,0,,Жақсы
Dialogue: 0,0:21:45.13,0:21:48.10,Default,,0,0,0,,Сахна барлығына да ұнаған сияқты.
Dialogue: 0,0:21:48.39,0:21:50.02,Default,,0,0,0,,Көңілді болды
Dialogue: 0,0:21:50.32,0:21:52.05,Default,,0,0,0,,Менің жүрегім әлі толы
Dialogue: 0,0:21:52.56,0:21:54.81,Default,,0,0,0,,үшінның күлкісін көріп қуанамын
Dialogue: 0,0:21:55.15,0:21:57.92,Default,,0,0,0,,Сізге рахмет, мен ертеңнен бастап бар күшімді саламын деп ойлаймын.
Dialogue: 0,0:21:58.25,0:21:59.38,Default,,0,0,0,,Бар күшіңізді салып көріңіз бе?
Dialogue: 0,0:22:02.28,0:22:05.08,Default,,0,0,0,,Көңіл көтеруді ұмытпаңыз
Dialogue: 0,0:22:05.21,0:22:06.05,Default,,0,0,0,,Иә
Dialogue: 0,0:22:06.20,0:22:08.37,Default,,0,0,0,,Керемет! Бұл дұрыс
Dialogue: 0,0:22:08.98,0:22:09.98,Default,,0,0,0,,Иә
Dialogue: 0,0:22:11.19,0:22:12.60,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:22:12.95,0:22:14.07,Default,,0,0,0,,Иә
Dialogue: 0,0:23:56.63,0:23:59.69,Default,,0,0,0,,Заманауи Одепал фирмасы қандай шкаф?
Dialogue: 0,0:23:59.88,0:24:01.71,Default,,0,0,0,,Бұл парфюмерия, демек бұл парфюмерия.
Dialogue: 0,0:24:01.89,0:24:02.75,Default,,0,0,0,,Парфюмерия?
Dialogue: 0,0:24:02.88,0:24:05.45,Default,,0,0,0,,Сондықтан Сараның иісі әрқашан жақсы.
Dialogue: 0,0:24:05.63,0:24:06.68,Default,,0,0,0,,Дорешия маңызды емес пе?
Dialogue: 0,0:24:06.87,0:24:07.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:08.37,0:24:09.42,Default,,0,0,0,,үшін бірге
Dialogue: 0,0:24:09.59,0:24:10.53,Default,,0,0,0,,ﾐﾗｰｲﾝ！
Dialogue: 0,0:03:18.21,0:03:27.81,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:03:18.21,0:03:27.81,Default,,0,0,0,,Мүмкін мен де сені дұрыс түсінбеген шығармын.
Dialogue: 0,0:19:27.51,0:19:31.75,Default,,0,0,0,,«Сізге қай түс көбірек жарасады?»
Dialogue: 0,0:19:31.89,0:19:37.88,Default,,0,0,0,,``Мүмкін екеуміз оны біріктіріп, оны қамтамасыз еткеніміз дұрыс болар!'' ”
Dialogue: 0,0:19:38.03,0:19:42.01,Default,,0,0,0,,``Тырнақтарыңыз сәл жалаңаш болса жақсы емес пе? »
Dialogue: 0,0:19:42.22,0:19:50.99,Default,,0,0,0,,"Таң қаларлықтай! Бұл шын мәнінде ерекшеленетін нәрсе.''
Dialogue: 0,0:19:51.37,0:19:57.83,Default,,0,0,0,,Күн сайын қыздарға арналған шоу уақыты
Dialogue: 0,0:19:58.10,0:20:03.13,Default,,0,0,0,,Сәнді түстер міндетті түрде таңдау болып табылады.
Dialogue: 0,0:20:03.30,0:20:08.07,Default,,0,0,0,,Хаппикир және көпіршікті орау Күн сайын
Dialogue: 0,0:20:09.14,0:20:14.75,Default,,0,0,0,,КӨҢІЛ☆ҚЫЗЫҚ☆Егер біз де бүгін поп және ерекше күлкі жинай алсақ
Dialogue: 0,0:20:14.92,0:20:19.17,Default,,0,0,0,,Сүйкімді де түрлі-түсті гүлдер гүлдейді Бақытты әңгіме
Dialogue: 0,0:20:19.36,0:20:22.42,Default,,0,0,0,,ДАН☆ДАН☆Қызығушылығы өсіп келеді
Dialogue: 0,0:20:22.59,0:20:29.27,Default,,0,0,0,,Мені қызықтыратын осы және осылар.
Dialogue: 0,0:20:29.41,0:20:33.53,Default,,0,0,0,,Тек қазір ғана бар сезіммен жүрегіңізді елжіретіңіз
Dialogue: 0,0:20:33.67,0:20:37.40,Default,,0,0,0,,Жыпылдаған кішкентай жүрек
Dialogue: 0,0:20:40.13,0:20:45.87,Default,,0,0,0,,КӨҢІЛ☆ҚЫЗЫҚ☆Егер біз де бүгін поп және ерекше күлкі жинай алсақ
Dialogue: 0,0:20:46.03,0:20:50.30,Default,,0,0,0,,Сүйкімді де түрлі-түсті гүлдер гүлдейді Бақытты әңгіме
Dialogue: 0,0:20:50.54,0:20:53.65,Default,,0,0,0,,ДАН☆ДАН☆Қызығушылығы өседі
Dialogue: 0,0:20:53.80,0:21:00.48,Default,,0,0,0,,Мені қызықтыратын осы және осылар.
Dialogue: 0,0:21:00.62,0:21:04.75,Default,,0,0,0,,Қазір ғана бар сезіммен жүрегіңді елжіретейік
Dialogue: 0,0:21:04.89,0:21:08.72,Default,,0,0,0,,Жыпылдаған кішкентай жүрек
Dialogue: 0,0:21:09.94,0:21:15.55,Default,,0,0,0,,Жарқыраған жұлдыз
Dialogue: 0,0:19:27.51,0:19:31.75,Default,,0,0,0,,«Сіз сыртқы түріңізді өзгерткіңіз келе ме?»
Dialogue: 0,0:19:31.89,0:19:37.88,Default,,0,0,0,,«Әңгімеге бірінші рет қосылатын екі адам!»
Dialogue: 0,0:19:38.03,0:19:42.01,Default,,0,0,0,,«Сұлулықтың көркі неде?»
Dialogue: 0,0:19:42.22,0:19:50.99,Default,,0,0,0,,«Күтпеген жерден солай! үшін ойдығыдай!»
Dialogue: 0,0:19:51.37,0:19:57.83,Default,,0,0,0,,Әйел балаларының балалары, әрбір көктегі қала
Dialogue: 0,0:19:58.10,0:20:03.13,Default,,0,0,0,,Сәнді түстер қажет.
Dialogue: 0,0:20:03.30,0:20:08.07,Default,,0,0,0,,Бұл жерге барған сайын
Dialogue: 0,0:20:09.14,0:20:14.75,Default,,0,0,0,,Ашық ☆ Жүрек ☆ Hope Kontenya Noh Fun Land Collection Ерекше күлкі
Dialogue: 0,0:20:14.92,0:20:19.17,Default,,0,0,0,,...
Dialogue: 0,0:20:19.36,0:20:22.42,Default,,0,0,0,,Қызығу ☆ Үзіліс ☆ Жердің өсуі
Dialogue: 0,0:20:22.59,0:20:29.27,Default,,0,0,0,,Нені дұрыс, нені шындық?
Dialogue: 0,0:20:29.41,0:20:33.53,Default,,0,0,0,,Бостандық сезімі және дарындылық сезімі
Dialogue: 0,0:20:33.67,0:20:37.40,Default,,0,0,0,,Жүрегімнің нұры
Dialogue: 0,0:20:40.13,0:20:45.87,Default,,0,0,0,,Ашық ☆ Жүрек ☆ Hope Now Tenya Noh Fun Land Collection Ерекше күлкі
Dialogue: 0,0:20:46.03,0:20:50.30,Default,,0,0,0,,...
Dialogue: 0,0:20:50.54,0:20:53.65,Default,,0,0,0,,Қызығу ☆ Үзіліс ☆ Жердің өсуі
Dialogue: 0,0:20:53.80,0:21:00.48,Default,,0,0,0,,Нені дұрыс, нені дұрыс?
Dialogue: 0,0:21:00.62,0:21:04.75,Default,,0,0,0,,Бостандық сезімі және дарындылық сезімі
Dialogue: 0,0:21:04.89,0:21:08.72,Default,,0,0,0,,Жүрегімнің нұры
Dialogue: 0,0:21:09.94,0:21:15.55,Default,,0,0,0,,Жарықтың ортасында жұлдызды аспан
Dialogue: 0,0:00:00.00,0:00:02.50,Default,,0,0,0,,---------------------------------------------------------------------------------------------------------------------
