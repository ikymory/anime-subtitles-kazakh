Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.77,0:00:18.16,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.16,0:00:27.29,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.29,0:00:38.55,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.55,0:00:49.15,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.15,0:01:02.24,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.62,0:01:13.71,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.71,0:01:28.31,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:44.56,0:01:46.24,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:01:57.24,0:01:58.00,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:01:58.24,0:02:01.77,Default,,0,0,0,,Нысана 2 метрге жететін белгісіз қаруды дайындауда.
Dialogue: 0,0:02:01.88,0:02:03.01,Default,,0,0,0,,Расталмаған?
Dialogue: 0,0:02:03.08,0:02:04.13,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:04.48,0:02:05.89,Default,,0,0,0,,Қай жерде екені белгісіз.
Dialogue: 0,0:02:11.76,0:02:14.57,Default,,0,0,0,,Полиция қазірдің өзінде қалада іздеу жұмыстарын жүргізіп жатыр.
Dialogue: 0,0:02:15.04,0:02:18.17,Default,,0,0,0,,Ақпарат түскен бойда дереу оқиға орнына барамыз. . .
Dialogue: 0,0:02:19.80,0:02:20.69,Default,,0,0,0,,Bando
Dialogue: 0,0:02:20.92,0:02:21.81,Default,,0,0,0,,Идиот
Dialogue: 0,0:02:26.92,0:02:27.89,Default,,0,0,0,,Не істеу керек
Dialogue: 0,0:02:28.04,0:02:30.93,Default,,0,0,0,,Ол жоспарсыз біреуді атып алатындай жақсы болуы керек.
Dialogue: 0,0:02:31.20,0:02:33.41,Default,,0,0,0,,Аңға түссең, аңдыласың.
Dialogue: 0,0:02:33.96,0:02:35.45,Default,,0,0,0,,Екінің бірі шығар
Dialogue: 0,0:02:36.68,0:02:38.21,Default,,0,0,0,,Оны түсіріңіз
Dialogue: 0,0:03:19.12,0:03:20.77,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:03:21.60,0:03:23.89,Default,,0,0,0,,Кота мұңайып көрінеді.
Dialogue: 0,0:03:24.72,0:03:28.25,Default,,0,0,0,,Менің ойымша, бұл қабық жаман адамдарды көргісі келеді.
Dialogue: 0,0:03:37.88,0:03:38.77,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:03:39.00,0:03:40.89,Default,,0,0,0,,Есікті құлыптамаңыз
Dialogue: 0,0:03:42.76,0:03:45.00,Default,,0,0,0,,Мен бұл бос үй деп ойладым.
Dialogue: 0,0:03:48.64,0:03:50.88,Default,,0,0,0,,Бүгін. . . Мен бүгін көштім
Dialogue: 0,0:03:51.36,0:03:52.04,Default,,0,0,0,,Бұл. . .
Dialogue: 0,0:03:53.40,0:03:54.37,Default,,0,0,0,,Полиция.
Dialogue: 0,0:03:55.72,0:03:58.64,Default,,0,0,0,,Мен тергеумен аздап ынтымақтасқым келеді.
Dialogue: 0,0:04:00.24,0:04:01.65,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:02.36,0:04:04.41,Default,,0,0,0,,Мен мұндай қызды ешқашан көрген емеспін.
Dialogue: 0,0:04:08.80,0:04:11.17,Default,,0,0,0,,Мына балаға не болды?
Dialogue: 0,0:04:12.12,0:04:13.57,Default,,0,0,0,,Мен сұрақ қоямын.
Dialogue: 0,0:04:14.00,0:04:15.68,Default,,0,0,0,,Көрдің бе, көрмедің бе?
Dialogue: 0,0:04:17.36,0:04:18.12,Default,,0,0,0,,Тоқта
Dialogue: 0,0:04:18.72,0:04:20.48,Default,,0,0,0,,Хабарсыз кеткен адам.
Dialogue: 0,0:04:21.72,0:04:23.64,Default,,0,0,0,,Тұрған жері. . . белгісіз
Dialogue: 0,0:04:30.76,0:04:31.76,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:04:32.12,0:04:33.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:33.24,0:04:36.24,Default,,0,0,0,,Егер сіз жоғары қарасаңыз, полицияға хабарласыңыз.
Dialogue: 0,0:04:37.00,0:04:37.76,Default,,0,0,0,,Кешіріңіз, мазаладым.
Dialogue: 0,0:04:38.40,0:04:39.16,Default,,0,0,0,,Кеттік
Dialogue: 0,0:04:39.16,0:04:39.52,Default,,0,0,0,,Иә
Dialogue: 0,0:04:56.44,0:04:57.17,Default,,0,0,0,,Ах, кілт
Dialogue: 0,0:05:04.16,0:05:05.57,Default,,0,0,0,,Бұл Бандо командасы, Сато.
Dialogue: 0,0:05:06.00,0:05:07.29,Default,,0,0,0,,Ирига жағажайға келді.
Dialogue: 0,0:05:07.68,0:05:09.21,Default,,0,0,0,,Іздеуді жалғастыру
Dialogue: 0,0:05:09.56,0:05:11.88,Default,,0,0,0,,Іздеу рұқсаты шайтан және тек жағалау сызығы.
Dialogue: 0,0:05:12.68,0:05:14.21,Default,,0,0,0,,Бұл өте танымал орын.
Dialogue: 0,0:05:15.40,0:05:16.53,Default,,0,0,0,,Well, it depends on the other person.
Dialogue: 0,0:05:18.20,0:05:21.04,Default,,0,0,0,,Екінші тарап арнайы қару алып жүр.
Dialogue: 0,0:05:21.16,0:05:22.08,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:22.80,0:05:25.96,Default,,0,0,0,,Қарудың қайда екені белгісіз болғандықтан, онымен қалай әрекет етуіміз керек?
Dialogue: 0,0:05:26.08,0:05:26.97,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:05:27.20,0:05:28.93,Default,,0,0,0,,Why don't you just shut up a little?
Dialogue: 0,0:05:30.32,0:05:33.72,Default,,0,0,0,,Егер сіз алаңға тым көп үйренбеген болсаңыз, біріншіден бастаңыз.
Dialogue: 0,0:05:37.32,0:05:38.05,Default,,0,0,0,,Одан ары – толықтай Титан аумағы
Dialogue: 0,0:05:44.48,0:05:45.69,Default,,0,0,0,,Бинго
Dialogue: 0,0:05:48.20,0:05:49.25,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:05:55.12,0:05:55.72,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:06:06.48,0:06:07.37,Default,,0,0,0,,Бұл
Dialogue: 0,0:06:10.44,0:06:12.73,Default,,0,0,0,,Сәл адасып қалған бала болды.
Dialogue: 0,0:06:22.12,0:06:23.36,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:23.60,0:06:24.36,Default,,0,0,0,,Бұл қай жерде?
Dialogue: 0,0:06:25.76,0:06:26.52,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:06:30.84,0:06:32.13,Default,,0,0,0,,You're trembling, aren't you?
Dialogue: 0,0:06:34.00,0:06:35.29,Default,,0,0,0,,Менің қолымнан келетіні осы
Dialogue: 0,0:06:35.40,0:06:36.05,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:06:36.04,0:06:36.72,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:06:36.72,0:06:37.64,Default,,0,0,0,,Come on, stand up.
Dialogue: 0,0:06:38.04,0:06:38.77,Default,,0,0,0,,тұр
Dialogue: 0,0:06:41.28,0:06:43.25,Default,,0,0,0,,Жаңа ~ Жаңа ~ Жаңа ~
Dialogue: 0,0:06:44.16,0:06:46.24,Default,,0,0,0,,Әй, өседі, өседі
Dialogue: 0,0:06:46.48,0:06:48.53,Default,,0,0,0,,Оның мүйіздері бар.
Dialogue: 0,0:06:49.28,0:06:50.93,Default,,0,0,0,,Better not to get too close
Dialogue: 0,0:06:51.40,0:06:52.93,Default,,0,0,0,,Шулы, үндеме.
Dialogue: 0,0:06:53.40,0:06:55.93,Default,,0,0,0,,. . . Бұл не, балалар?
Dialogue: 0,0:06:59.80,0:07:03.28,Default,,0,0,0,,Hmm, you can kill the witnesses too.
Dialogue: 0,0:07:03.80,0:07:05.17,Default,,0,0,0,,Сәлем Сато
Dialogue: 0,0:07:06.04,0:07:08.04,Default,,0,0,0,,Hey, that's an order.
Dialogue: 0,0:07:08.44,0:07:09.57,Default,,0,0,0,,First, go to the headquarters.
Dialogue: 0,0:07:09.92,0:07:11.41,Default,,0,0,0,,Өлтіру?
Dialogue: 0,0:07:12.04,0:07:14.44,Default,,0,0,0,,Don't you understand, you idiot?
Dialogue: 0,0:07:14.80,0:07:16.21,Default,,0,0,0,,Мені өлтірме. . .
Dialogue: 0,0:07:16.56,0:07:19.21,Default,,0,0,0,,Just pull the trigger and say it.
Dialogue: 0,0:07:19.44,0:07:22.41,Default,,0,0,0,,Then Temee scatters her brains and dies.
Dialogue: 0,0:07:23.80,0:07:25.16,Default,,0,0,0,,Қаш!
Dialogue: 0,0:07:28.44,0:07:30.72,Default,,0,0,0,,Бұл менің олжам.
Dialogue: 0,0:07:39.04,0:07:40.72,Default,,0,0,0,,Мазалама
Dialogue: 0,0:07:41.96,0:07:43.61,Default,,0,0,0,,Жаңа ~ Жаңа ~
Dialogue: 0,0:07:44.72,0:07:46.05,Default,,0,0,0,,Енді. . .
Dialogue: 0,0:07:46.80,0:07:49.84,Default,,0,0,0,,Көңілді боласыз, солай ма?
Dialogue: 0,0:07:51.84,0:07:52.72,Default,,0,0,0,,Жоғалдың ба?
Dialogue: 0,0:07:53.96,0:07:54.96,Default,,0,0,0,,Қанша?
Dialogue: 0,0:07:55.72,0:07:56.84,Default,,0,0,0,,Жақсы. . .
Dialogue: 0,0:07:56.84,0:07:58.08,Default,,0,0,0,,Иә. . . иә. . .
Dialogue: 0,0:07:58.48,0:07:59.20,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:01.00,0:08:01.92,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:02.60,0:08:05.60,Default,,0,0,0,,Жоқ. Таныс жер есіңізде ме?
Dialogue: 0,0:08:06.24,0:08:07.57,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:08:11.76,0:08:14.49,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:08:14.88,0:08:15.88,Default,,0,0,0,,Жоқ, не?
Dialogue: 0,0:08:16.64,0:08:19.12,Default,,0,0,0,,Бұл жоғалған бала өте қиын сияқты.
Dialogue: 0,0:08:19.64,0:08:22.88,Default,,0,0,0,,SAT жағалауды өз қалауы бойынша зерттейді.
Dialogue: 0,0:08:23.32,0:08:25.76,Default,,0,0,0,,Олар не ойлайды?
Dialogue: 0,0:08:26.32,0:08:29.13,Default,,0,0,0,,Мен оны көп көшіргім келмейді.
Dialogue: 0,0:08:29.40,0:08:30.97,Default,,0,0,0,,Сосын мен оны сұрадым.
Dialogue: 0,0:08:31.28,0:08:31.96,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:08:38.28,0:08:39.56,Default,,0,0,0,,Қатты қашқын. . .
Dialogue: 0,0:08:40.68,0:08:41.80,Default,,0,0,0,,Осындай бала
Dialogue: 0,0:09:02.92,0:09:03.56,Default,,0,0,0,,Кота
Dialogue: 0,0:09:05.32,0:09:06.16,Default,,0,0,0,,Кота
Dialogue: 0,0:09:06.96,0:09:07.84,Default,,0,0,0,,Коута Дева
Dialogue: 0,0:09:11.36,0:09:13.68,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:09:14.84,0:09:16.36,Default,,0,0,0,,Қазір жедел жәрдем шақырыңыз.
Dialogue: 0,0:09:16.44,0:09:17.60,Default,,0,0,0,,Нюу Нюуха
Dialogue: 0,0:09:25.68,0:09:27.48,Default,,0,0,0,,Кота, мықты бол.
Dialogue: 0,0:09:27.84,0:09:28.72,Default,,0,0,0,,Кота
Dialogue: 0,0:09:54.52,0:09:55.64,Default,,0,0,0,,Мүмкін бұл дұрыс емес адам шығар
Dialogue: 0,0:09:56.64,0:09:58.40,Default,,0,0,0,,Ұсталған адамдармен тым көп. . .
Dialogue: 0,0:09:59.28,0:10:00.00,Default,,0,0,0,,Одан ары – толықтай Титан аумағы
Dialogue: 0,0:10:00.84,0:10:05.36,Default,,0,0,0,,Әй, сен мүйізді адамсың, басқасын көрдің бе?
Dialogue: 0,0:10:05.88,0:10:07.29,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:10:09.76,0:10:11.41,Default,,0,0,0,,Бұл Бандо командасы, Сато.
Dialogue: 0,0:10:11.64,0:10:14.04,Default,,0,0,0,,Люси және басқа біреу қорғады
Dialogue: 0,0:10:14.80,0:10:16.04,Default,,0,0,0,,Орналасқан жері: Иригахама
Dialogue: 0,0:10:20.36,0:10:21.64,Default,,0,0,0,,Рұқсатсыз көшірмеңіз
Dialogue: 0,0:10:22.80,0:10:24.56,Default,,0,0,0,,Қызық енді басталады!
Dialogue: 0,0:10:26.56,0:10:28.92,Default,,0,0,0,,Осы уақытқа дейін көп өлтірдің, солай емес пе?
Dialogue: 0,0:10:29.28,0:10:31.04,Default,,0,0,0,,Дуэльге шығайық
Dialogue: 0,0:10:31.68,0:10:32.16,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:10:32.28,0:10:33.00,Default,,0,0,0,,Мұнда
Dialogue: 0,0:10:43.40,0:10:44.92,Default,,0,0,0,,Бұл не, сен?
Dialogue: 0,0:10:45.28,0:10:46.56,Default,,0,0,0,,Ол кісі өлтіруші, солай ма?
Dialogue: 0,0:10:47.20,0:10:49.20,Default,,0,0,0,,Менімен кел, менімен кел, менімен бірге жүр.
Dialogue: 0,0:10:50.16,0:10:51.68,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:10:52.20,0:10:53.08,Default,,0,0,0,,Сіз нені жасырдыңыз?
Dialogue: 0,0:10:53.56,0:10:54.52,Default,,0,0,0,,Маған көрсетші, эй.
Dialogue: 0,0:10:56.08,0:10:58.08,Default,,0,0,0,,Жоқ, бұл тағы бір өлімші қару.
Dialogue: 0,0:10:58.56,0:11:00.21,Default,,0,0,0,,Мұны жай ғана айтпаңыз
Dialogue: 0,0:11:00.68,0:11:02.84,Default,,0,0,0,,Осындай қаруың болса, маған кел.
Dialogue: 0,0:11:03.32,0:11:04.20,Default,,0,0,0,,О.
Dialogue: 0,0:11:17.72,0:11:18.84,Default,,0,0,0,,Енді жоқ
Dialogue: 0,0:11:19.08,0:11:21.48,Default,,0,0,0,,А, анау бөлім басшысы?
Dialogue: 0,0:11:21.92,0:11:24.12,Default,,0,0,0,,Сато, сен мені өлтіре аласың.
Dialogue: 0,0:11:25.44,0:11:26.56,Default,,0,0,0,,Мені өлтірме
Dialogue: 0,0:11:26.84,0:11:27.72,Default,,0,0,0,,Бұл жұмыс.
Dialogue: 0,0:11:28.12,0:11:28.84,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:11:30.08,0:11:32.00,Default,,0,0,0,,Жарайды, ат. Бұл тапсырыс.
Dialogue: 0,0:11:33.08,0:11:33.80,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:39.88,0:11:40.60,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:11:40.96,0:11:42.24,Default,,0,0,0,,Бұл да жұмыс ғой.
Dialogue: 0,0:11:47.20,0:11:48.12,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:07.52,0:12:08.28,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:12:08.76,0:12:09.96,Default,,0,0,0,,Одан ары – толықтай Титан аумағы
Dialogue: 0,0:12:35.64,0:12:37.13,Default,,0,0,0,,Шоичи-куннан күткендей, сен өте сенімдісің!
Dialogue: 0,0:12:40.24,0:12:41.40,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:13:06.84,0:13:09.04,Default,,0,0,0,,Қолыңызды лақтырмаңыз
Dialogue: 0,0:13:10.92,0:13:15.60,Default,,0,0,0,,Нысана радиусы 2 метр болатын абсолютті өлімге әкелетін қаруды дайындады.
Dialogue: 0,0:13:21.36,0:13:22.60,Default,,0,0,0,,Сіз осылай айтасыз
Dialogue: 0,0:13:22.80,0:13:24.45,Default,,0,0,0,,2 метрден көрінбейтін қол
Dialogue: 0,0:13:24.84,0:13:26.04,Default,,0,0,0,,Бұл сіздікі. . .
Dialogue: 0,0:13:37.56,0:13:39.48,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:13:45.88,0:13:46.60,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:14:01.52,0:14:02.36,Default,,0,0,0,,Тапсырма
Dialogue: 0,0:14:02.88,0:14:04.00,Default,,0,0,0,,Мен шыдай алмаймын
Dialogue: 0,0:14:13.84,0:14:16.49,Default,,0,0,0,,Алға, мұны істе!
Dialogue: 0,0:14:16.60,0:14:17.24,Default,,0,0,0,,О!
Dialogue: 0,0:14:22.40,0:14:25.40,Default,,0,0,0,,Менің ойымша, бұл дұрыс емес.
Dialogue: 0,0:14:38.56,0:14:40.16,Default,,0,0,0,,Көңілді отырсың ба?
Dialogue: 0,0:14:41.80,0:14:42.56,Default,,0,0,0,,Кону
Dialogue: 0,0:14:48.32,0:14:49.81,Default,,0,0,0,,Теме
Dialogue: 0,0:14:50.44,0:14:52.92,Default,,0,0,0,,Жарайды, менің қолым
Dialogue: 0,0:14:56.88,0:14:58.45,Default,,0,0,0,,Теме
Dialogue: 0,0:14:58.80,0:15:03.08,Default,,0,0,0,,Есіңізде болсын, сіз оларды ешқашан ұмытпайсыз.
Dialogue: 0,0:15:10.84,0:15:14.28,Default,,0,0,0,,өлтіру, өлтіру, өлтіру
Dialogue: 0,0:15:14.96,0:15:15.84,Default,,0,0,0,,Жалықу
Dialogue: 0,0:15:50.36,0:15:51.12,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:15:51.24,0:15:53.36,Default,,0,0,0,,Сен қайда бардың? Өлтір
Dialogue: 0,0:15:53.60,0:15:55.96,Default,,0,0,0,,Әй, қайда бардың?
Dialogue: 0,0:15:56.24,0:15:57.65,Default,,0,0,0,,Қайтып кел
Dialogue: 0,0:16:24.40,0:16:29.64,Default,,0,0,0,,Әй, қайдасың? Қайда бардыңыз?
Dialogue: 0,0:16:30.24,0:16:32.12,Default,,0,0,0,,Сіз мұны сол жолы істедіңіз бе?
Dialogue: 0,0:16:32.48,0:16:32.92,Default,,0,0,0,,Мен сені өлтіремін, мен сені өлтіремін, сені өлтіремін, қайт.
Dialogue: 0,0:16:33.48,0:16:36.16,Default,,0,0,0,,Мен сені өлтіремін, мен сені өлтіремін, сені өлтіремін, қайт.
Dialogue: 0,0:16:36.16,0:16:37.40,Default,,0,0,0,,Ал қазір, шын мәнінде, өте жақсы сезімдемін
Dialogue: 0,0:16:40.40,0:16:42.12,Default,,0,0,0,,Не? . . Сіз
Dialogue: 0,0:16:44.92,0:16:47.92,Default,,0,0,0,,Мен қазір жедел жәрдем шақырамын.
Dialogue: 0,0:16:48.28,0:16:49.80,Default,,0,0,0,,Ашуланба
Dialogue: 0,0:16:54.88,0:16:55.80,Default,,0,0,0,,Кира мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:17:06.04,0:17:06.84,Default,,0,0,0,,Кота
Dialogue: 0,0:17:10.40,0:17:11.12,Default,,0,0,0,,Кота
Dialogue: 0,0:17:13.64,0:17:15.40,Default,,0,0,0,,Сол Юка
Dialogue: 0,0:17:16.92,0:17:18.41,Default,,0,0,0,,осы жерде
Dialogue: 0,0:17:19.04,0:17:19.68,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:17:20.12,0:17:20.80,Default,,0,0,0,,Шаян болды
Dialogue: 0,0:17:21.48,0:17:22.28,Default,,0,0,0,,Жарайды
Dialogue: 0,0:17:27.04,0:17:28.04,Default,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:17:30.16,0:17:32.24,Default,,0,0,0,,Біз қайтадан кездестік.
Dialogue: 0,0:17:32.92,0:17:34.33,Default,,0,0,0,,Тек оны шешіп алыңыз.
Dialogue: 0,0:17:44.52,0:17:46.68,Default,,0,0,0,,Пулемет ұстаған солдат.
Dialogue: 0,0:17:47.44,0:17:51.41,Default,,0,0,0,,Сорақысы үшін, мотоциклшілер тобына ұқсайтын адамдар маған мылтық үлгісімен шабуыл жасады.
Dialogue: 0,0:17:51.92,0:17:52.56,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:17:52.92,0:17:53.92,Default,,0,0,0,,Бұл рас. . .
Dialogue: 0,0:17:54.04,0:17:56.93,Default,,0,0,0,,Бүгінгі қыз бұған қарамай айтты.
Dialogue: 0,0:17:57.84,0:17:59.52,Default,,0,0,0,,Басқа куәгерлер болуы керек.
Dialogue: 0,0:18:00.84,0:18:02.68,Default,,0,0,0,,Көру. . . Жаңа
Dialogue: 0,0:18:03.16,0:18:05.60,Default,,0,0,0,,Жағада бір қыз болды.
Dialogue: 0,0:18:05.92,0:18:07.28,Default,,0,0,0,,Бұл бала қауіпсіз бе?
Dialogue: 0,0:18:10.56,0:18:12.08,Default,,0,0,0,,Мына бала қандай бала?
Dialogue: 0,0:18:12.36,0:18:13.20,Default,,0,0,0,,Келіңіздер. . .
Dialogue: 0,0:18:13.72,0:18:15.84,Default,,0,0,0,,Мен оны кездейсоқ көрдім.
Dialogue: 0,0:18:15.96,0:18:17.08,Default,,0,0,0,,Физикалық сипаттамалар қандай?
Dialogue: 0,0:18:17.80,0:18:19.68,Default,,0,0,0,,Әсіресе мінездемелері бойынша
Dialogue: 0,0:18:19.92,0:18:21.84,Default,,0,0,0,,Шаш үлгісі мен жасы сияқты нәрселер бар, солай ма?
Dialogue: 0,0:18:22.36,0:18:24.96,Default,,0,0,0,,Әсіресе бас аймағында бір нәрсе болды.
Dialogue: 0,0:18:26.36,0:18:30.08,Default,,0,0,0,,Бәрі жақсы, өз ойыңды айт.
Dialogue: 0,0:18:32.20,0:18:33.85,Default,,0,0,0,,Қыз болса да
Dialogue: 0,0:18:34.24,0:18:35.48,Default,,0,0,0,,ЖОО студенттері туралы
Dialogue: 0,0:18:36.12,0:18:39.44,Default,,0,0,0,,Жарлықпен, аздап
Dialogue: 0,0:18:39.84,0:18:41.20,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:18:41.48,0:18:42.89,Default,,0,0,0,,Жарақат алғаныңыз өкінішті.
Dialogue: 0,0:18:46.36,0:18:47.77,Default,,0,0,0,,Мен бұрынғы дәрігерімнен сұрадым.
Dialogue: 0,0:18:48.12,0:18:49.77,Default,,0,0,0,,Жарақат ауыр емес сияқты.
Dialogue: 0,0:18:49.88,0:18:51.24,Default,,0,0,0,,Үйге қайтқанда сақ болыңыз
Dialogue: 0,0:18:51.64,0:18:54.40,Default,,0,0,0,,Бірақ оның шынымен де автоматы болды.
Dialogue: 0,0:18:54.64,0:18:56.96,Default,,0,0,0,,Бұл жерде байкерлер тобы көп.
Dialogue: 0,0:18:57.76,0:19:00.00,Default,,0,0,0,,Зақым бар болса, оны дұрыс күтіңіз
Dialogue: 0,0:19:00.84,0:19:02.76,Default,,0,0,0,,Ұмытқаның жақсы.
Dialogue: 0,0:19:22.24,0:19:23.92,Default,,0,0,0,,Мен оны өлтірмеген деп үміттенемін.
Dialogue: 0,0:19:24.16,0:19:25.16,Default,,0,0,0,,Не?
Dialogue: 0,0:19:28.80,0:19:29.80,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:19:31.68,0:19:33.68,Default,,0,0,0,,Жарайды, ертең қайтамын.
Dialogue: 0,0:19:34.04,0:19:35.16,Default,,0,0,0,,Сол қол
Dialogue: 0,0:19:35.80,0:19:37.32,Default,,0,0,0,,Уайымдама, уайымдама.
Dialogue: 0,0:20:07.80,0:20:08.56,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:20:17.08,0:20:17.68,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:18.04,0:20:18.45,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:20:24.20,0:20:24.84,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:25.04,0:20:25.84,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:20:30.48,0:20:33.37,Default,,0,0,0,,Котта, келесі жылы тағы келші~
Dialogue: 0,0:20:33.84,0:20:36.24,Default,,0,0,0,,Мен туралы ұмытпа
Dialogue: 0,0:20:36.56,0:20:39.21,Default,,0,0,0,,Иә, өйткені маған Юка-чан ұнайды.
Dialogue: 0,0:20:39.60,0:20:40.88,Default,,0,0,0,,Мен келесі жылы қайтамын.
Dialogue: 0,0:20:47.24,0:20:49.44,Default,,0,0,0,,Содан бері сегіз жыл өтті. . . Немесе
Dialogue: 0,0:20:49.88,0:20:50.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:51.24,0:20:53.00,Default,,0,0,0,,Сәлем, кез келген нәрсе
Dialogue: 0,0:20:55.36,0:20:56.12,Default,,0,0,0,,Кілт?
Dialogue: 0,0:20:57.60,0:20:58.52,Default,,0,0,0,,Жүргізуші
Dialogue: 0,0:21:00.76,0:21:03.65,Default,,0,0,0,,Эй, сен кімсің?
Dialogue: 0,0:21:04.12,0:21:06.40,Default,,0,0,0,,Сол жігіттер, әскерилер де.
Dialogue: 0,0:21:06.76,0:21:08.96,Default,,0,0,0,,Полиция да біртүрлі екен.
Dialogue: 0,0:21:09.76,0:21:10.24,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:21:11.00,0:21:12.65,Default,,0,0,0,,Менің айтқанымды түсінбейсің бе?
Dialogue: 0,0:21:13.04,0:21:18.41,Default,,0,0,0,,But I've made up my mind that I will never give you up to them.
Dialogue: 0,0:21:19.92,0:21:21.80,Default,,0,0,0,,Содан кейін оны өзгертіңіз.
Dialogue: 0,0:21:22.24,0:21:22.80,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:21:26.28,0:21:28.16,Default,,0,0,0,,Мен мүлде білмеймін.
Dialogue: 0,0:21:29.04,0:21:31.16,Default,,0,0,0,,I have no choice but to let you change your clothes.
Dialogue: 0,0:21:40.76,0:21:43.16,Default,,0,0,0,,Ум жейде жейде
Dialogue: 0,0:21:43.44,0:21:44.04,Default,,0,0,0,,болды
Dialogue: 0,0:21:44.68,0:21:46.17,Default,,0,0,0,,Содан кейін қолыңызды көтеріңіз.
Dialogue: 0,0:21:46.68,0:21:47.44,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:21:47.64,0:21:48.20,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:21:48.52,0:21:52.20,Default,,0,0,0,,It's okay, I keep my eyes covered the whole time.
Dialogue: 0,0:21:53.16,0:21:53.64,Default,,0,0,0,,Уню~
Dialogue: 0,0:21:53.68,0:21:56.20,Default,,0,0,0,,Ууго. . . Кешіріңіз
Dialogue: 0,0:21:58.68,0:22:00.28,Default,,0,0,0,,Келесі кезекте шалбар келеді.
Dialogue: 0,0:22:01.56,0:22:02.97,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:22:04.28,0:22:07.20,Default,,0,0,0,,Тыңда, мен бір орында тұрамын.
Dialogue: 0,0:22:19.04,0:22:19.84,Default,,0,0,0,,Жебенің жеңілуі?
Dialogue: 0,0:22:20.84,0:22:21.68,Default,,0,0,0,,Иә
Dialogue: 0,0:22:22.08,0:22:26.36,Default,,0,0,0,,Lucy's landing was confirmed from the damage situation of Sato's team.
Dialogue: 0,0:22:26.72,0:22:28.56,Default,,0,0,0,,Мен оны әлі анықтауға тырысамын. . .
Dialogue: 0,0:22:28.96,0:22:34.09,Default,,0,0,0,,It's hard to believe that that murderous weapon is calmly conquering things like this. . . Мен олай ойламаймын
Dialogue: 0,0:22:34.60,0:22:38.00,Default,,0,0,0,,Алайда 7 санына дейін ештеңе болған жоқ.
Dialogue: 0,0:22:42.88,0:22:43.88,Default,,0,0,0,,Жағдайыңыз қалай?
Dialogue: 0,0:22:44.36,0:22:46.60,Default,,0,0,0,,A series of extremely harsh experiments ensued. . . .
Dialogue: 0,0:22:47.12,0:22:48.45,Default,,0,0,0,,Оны қолдануға бола ма? . .
Dialogue: 0,0:22:59.64,0:23:00.84,Default,,0,0,0,,Pa. . . Па. .
Dialogue: 0,0:24:34.92,0:24:39.96,Default,,0,0,0,,Махаббат сөзін қолдануға кеш. . . Бұл тым қатыгез
Dialogue: 0,0:24:41.80,0:24:43.60,Default,,0,0,0,,Аспан – мәңгілік азап
Dialogue: 0,0:24:45.44,0:24:47.48,Default,,0,0,0,,Тек үмітсіздік билеген әлемде
Dialogue: 0,0:24:48.12,0:24:50.69,Default,,0,0,0,,Бір назарды ескере отырып жасалған
Dialogue: 0,0:24:51.36,0:24:52.88,Default,,0,0,0,,Қайғылы еліктеу
Dialogue: 0,0:24:55.24,0:24:55.60,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:24:55.60,0:24:57.09,Default,,0,0,0,,Elfen Lied 3-бөлім
Dialogue: 0,0:24:57.64,0:24:58.64,Default,,0,0,0,,Кеуденің артқы жағы
Dialogue: 0,0:25:00.14,0:25:06.14,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory