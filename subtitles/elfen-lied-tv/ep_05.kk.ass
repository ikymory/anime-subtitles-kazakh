Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.77,0:00:18.16,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.16,0:00:27.29,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.29,0:00:38.55,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.55,0:00:49.15,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.15,0:01:02.24,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.62,0:01:13.71,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.71,0:01:28.31,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:40.12,0:01:41.96,Default,,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:01:43.68,0:01:47.13,Default,,0,0,0,,№7 мәселе бойынша басшыға хабарладым.
Dialogue: 0,0:01:50.32,0:01:53.01,Default,,0,0,0,,Мен өкінемін.
Dialogue: 0,0:01:53.12,0:01:58.49,Default,,0,0,0,,Өкініш, т.б. тек өткенге қайта қарауға құқығы бар адамдарға ғана рұқсат етіледі.
Dialogue: 0,0:01:59.36,0:02:00.44,Default,,0,0,0,,Директор
Dialogue: 0,0:02:13.76,0:02:15.44,Default,,0,0,0,,Кота Кота
Dialogue: 0,0:02:16.80,0:02:18.69,Default,,0,0,0,,Барлық көмектеріңіз үшін рахмет.
Dialogue: 0,0:02:18.88,0:02:20.69,Default,,0,0,0,,Күріш өте дәмді болды.
Dialogue: 0,0:02:21.32,0:02:23.77,Default,,0,0,0,,Менің қатысуым қиыншылық туғызатыны сөзсіз.
Dialogue: 0,0:02:24.52,0:02:27.89,Default,,0,0,0,,Мен қарызға алған аурухана шотымды бір күні міндетті түрде қайтарамын.
Dialogue: 0,0:02:28.44,0:02:30.57,Default,,0,0,0,,Үндемей қалғаным үшін кешіріңіз.
Dialogue: 0,0:02:31.32,0:02:32.21,Default,,0,0,0,,Маю
Dialogue: 0,0:02:33.96,0:02:35.85,Default,,0,0,0,,Мен оны оятуға барсам, сол жерде екен.
Dialogue: 0,0:02:37.20,0:02:40.44,Default,,0,0,0,,Менің ойымша, бірдеңе болып жатқан болуы керек.
Dialogue: 0,0:02:40.84,0:02:42.29,Default,,0,0,0,,Эй, біз не істеуіміз керек?
Dialogue: 0,0:02:45.32,0:02:47.72,Default,,0,0,0,,Маю-чан, мен оны осы жерден аламын ба?
Dialogue: 0,0:02:47.84,0:02:48.97,Default,,0,0,0,,Алу керек пе?
Dialogue: 0,0:02:52.20,0:02:53.17,Default,,0,0,0,,Жаңа
Dialogue: 0,0:02:56.56,0:02:57.21,Default,,0,0,0,,Жаңа
Dialogue: 0,0:02:58.04,0:03:02.57,Default,,0,0,0,,Себебі сен мені жалғыз қалдырмас едің. Тіпті Юка да уайымдады, солай ма?
Dialogue: 0,0:03:02.72,0:03:04.25,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:03:04.56,0:03:07.48,Default,,0,0,0,,Ондай қыздың жалғыз қалуы қауіпті.
Dialogue: 0,0:03:08.56,0:03:11.85,Default,,0,0,0,,Бірақ оны қайтару әлі де қиын деп ойлаймын.
Dialogue: 0,0:03:12.60,0:03:15.73,Default,,0,0,0,,Үйге дұрыстап оралсаңыз жақсы болар еді.
Dialogue: 0,0:03:17.08,0:03:18.13,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:03:18.36,0:03:20.89,Default,,0,0,0,,Үйге барғыңыз келмегендіктен үйде істеп жатырсыз ба?
Dialogue: 0,0:03:21.72,0:03:23.64,Default,,0,0,0,,Алдымен мен Маю-чанды табуым керек.
Dialogue: 0,0:03:23.84,0:03:25.21,Default,,0,0,0,,Жүр, тезірек киіміңді ауыстыр.
Dialogue: 0,0:03:26.12,0:03:27.65,Default,,0,0,0,,Ню-чан, сыртқа шығайық.
Dialogue: 0,0:03:28.96,0:03:31.36,Default,,0,0,0,,Әдеттегідей, мен шынымен түсінбеймін.
Dialogue: 0,0:03:36.48,0:03:39.01,Default,,0,0,0,,Жоқ, бұл ойыншық емес.
Dialogue: 0,0:03:39.28,0:03:39.96,Default,,0,0,0,,Жаңа
Dialogue: 0,0:03:44.40,0:03:45.85,Default,,0,0,0,,Ол бүгін жоқ.
Dialogue: 0,0:03:47.00,0:03:48.00,Default,,0,0,0,,Мен ол адамды білемін.
Dialogue: 0,0:03:48.24,0:03:50.13,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:03:50.36,0:03:51.12,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:03:51.28,0:03:54.17,Default,,0,0,0,,Егер мен ол қызды кездестірсем, маған бір нәрсе беруіңізді қалаймын.
Dialogue: 0,0:03:55.28,0:03:55.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:00.12,0:04:01.61,Default,,0,0,0,,Жаңа әке
Dialogue: 0,0:04:01.92,0:04:03.81,Default,,0,0,0,,Құрметпен, Маю-чан
Dialogue: 0,0:04:05.40,0:04:06.29,Default,,0,0,0,,Жақсы бала
Dialogue: 0,0:04:11.24,0:04:12.37,Default,,0,0,0,,Киіміңді алыс жерде шеш
Dialogue: 0,0:04:19.12,0:04:19.96,Default,,0,0,0,,Жақсы бала
Dialogue: 0,0:04:21.40,0:04:23.64,Default,,0,0,0,,Енді әдеттегідей.
Dialogue: 0,0:04:35.04,0:04:37.65,Default,,0,0,0,,Мама, мен оны енді қаламаймын.
Dialogue: 0,0:04:39.24,0:04:40.92,Default,,0,0,0,,Мен ол адамды жек көремін.
Dialogue: 0,0:04:41.04,0:04:42.77,Default,,0,0,0,,О, неге?
Dialogue: 0,0:04:43.24,0:04:46.93,Default,,0,0,0,,Өйткені анам жоқта,
Dialogue: 0,0:04:50.04,0:04:51.93,Default,,0,0,0,,Сен маған керек емессің
Dialogue: 0,0:04:52.92,0:04:56.29,Default,,0,0,0,,Сенің кесіріңнен, сенің кесіріңнен, ол адам
Dialogue: 0,0:05:07.40,0:05:10.05,Default,,0,0,0,,Не болды? Барлығын алып тастаңыз.
Dialogue: 0,0:05:10.76,0:05:11.65,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:05:13.68,0:05:16.08,Default,,0,0,0,,Маған бұл енді ұнамайды.
Dialogue: 0,0:06:32.88,0:06:33.77,Default,,0,0,0,,Бұл теңіз.
Dialogue: 0,0:07:11.88,0:07:13.29,Default,,0,0,0,,Сен де жалғызсың ба?
Dialogue: 0,0:07:14.68,0:07:16.33,Default,,0,0,0,,Сізді лақтырып жібердіңіз бе?
Dialogue: 0,0:07:21.04,0:07:22.57,Default,,0,0,0,,Сіз менімен біргесіз.
Dialogue: 0,0:07:27.04,0:07:28.93,Default,,0,0,0,,Олар жақсы адамдар еді.
Dialogue: 0,0:07:29.16,0:07:31.73,Default,,0,0,0,,Барлығы жақсы адамдар болса екен
Dialogue: 0,0:07:33.08,0:07:36.16,Default,,0,0,0,,Кешіріңіз, менің итім бар.
Dialogue: 0,0:07:38.72,0:07:39.72,Default,,0,0,0,,Асыл тастар?
Dialogue: 0,0:07:41.48,0:07:42.32,Default,,0,0,0,,Асыл тастар?
Dialogue: 0,0:07:43.96,0:07:46.96,Default,,0,0,0,,Жақсы, Джеймс, мен сені іздедім.
Dialogue: 0,0:07:46.96,0:07:50.97,Default,,0,0,0,,А, бұл иесі?
Dialogue: 0,0:07:50.96,0:07:51.72,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:07:52.08,0:07:58.09,Default,,0,0,0,,Ым, мен сені сонда көруге болады ма?
Dialogue: 0,0:07:59.44,0:08:00.60,Default,,0,0,0,,Лас көрініс
Dialogue: 0,0:08:02.00,0:08:03.45,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,0:08:03.84,0:08:05.33,Default,,0,0,0,,Кеттік, Джеймс.
Dialogue: 0,0:08:06.20,0:08:08.36,Default,,0,0,0,,Мен оны тапқаныма өте қуаныштымын.
Dialogue: 0,0:08:12.44,0:08:18.45,Default,,0,0,0,,Бұл жақсы. Бұдан былай сіз көптеген дәмді тағамдарды жей аласыз.
Dialogue: 0,0:08:19.60,0:08:22.89,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:08:27.00,0:08:28.84,Default,,0,0,0,,Бүгін менің туған күнім еді.
Dialogue: 0,0:08:31.36,0:08:36.32,Default,,0,0,0,,Ит алған кезде мен өзімді 14 жасқа толғандай сезіндім және оны мақтан тұттым.
Dialogue: 0,0:08:41.44,0:08:43.04,Default,,0,0,0,,Жоқ, жылама
Dialogue: 0,0:08:43.44,0:08:45.97,Default,,0,0,0,,Мен жыламаймын деп шештім.
Dialogue: 0,0:08:52.08,0:08:54.92,Default,,0,0,0,,Суық Суық
Dialogue: 0,0:08:57.56,0:08:59.16,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:08:59.60,0:09:02.40,Default,,0,0,0,,О, мен
Dialogue: 0,0:09:02.40,0:09:02.41,Default,,0,0,0,,Бұл жерде бір қыз бар деп бұрын хабар келген.
Dialogue: 0,0:09:02.41,0:09:05.29,Default,,0,0,0,,Бұл жерде бір қыз бар деп бұрын хабар келген.
Dialogue: 0,0:09:05.84,0:09:07.05,Default,,0,0,0,,Жай ғана шық
Dialogue: 0,0:09:08.32,0:09:09.97,Default,,0,0,0,,А, күте тұр, сен.
Dialogue: 0,0:09:10.60,0:09:11.36,Default,,0,0,0,,Белсенді болыңыз
Dialogue: 0,0:09:11.36,0:09:11.80,Default,,0,0,0,,болып табылады
Dialogue: 0,0:09:20.60,0:09:23.13,Default,,0,0,0,,Менің үйге барғым келмейді.
Dialogue: 0,0:09:24.24,0:09:25.08,Default,,0,0,0,,Маю-чан
Dialogue: 0,0:09:27.72,0:09:31.09,Default,,0,0,0,,Жақсы, мен оны көптен бері іздеп жүрмін.
Dialogue: 0,0:09:31.56,0:09:34.48,Default,,0,0,0,,Мен? неге
Dialogue: 0,0:09:34.96,0:09:37.36,Default,,0,0,0,,Балалар сендер бұл қызды танисыңдар ма?
Dialogue: 0,0:09:37.56,0:09:38.21,Default,,0,0,0,,Иә
Dialogue: 0,0:09:40.24,0:09:41.97,Default,,0,0,0,,Біздің отбасы
Dialogue: 0,0:09:42.24,0:09:43.00,Default,,0,0,0,,Екі қолым... сынғалы тұрғандай.
Dialogue: 0,0:09:43.44,0:09:44.09,Default,,0,0,0,,Иә
Dialogue: 0,0:09:44.36,0:09:46.01,Default,,0,0,0,,We had a little fight.
Dialogue: 0,0:09:46.64,0:09:50.01,Default,,0,0,0,,Менің отбасымдағылардың бәрі ашуланған кезде секіретін әдеті бар.
Dialogue: 0,0:09:50.88,0:09:52.64,Default,,0,0,0,,Come on, let's go home.
Dialogue: 0,0:09:59.64,0:10:03.01,Default,,0,0,0,,The police officer was shocked.
Dialogue: 0,0:10:03.76,0:10:05.49,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:05.88,0:10:08.72,Default,,0,0,0,,Сіздің түнде жағажайға барғаныңыз есімде.
Dialogue: 0,0:10:09.92,0:10:11.25,Default,,0,0,0,,It's not about that.
Dialogue: 0,0:10:12.72,0:10:15.41,Default,,0,0,0,,Why are you looking for me?
Dialogue: 0,0:10:15.60,0:10:18.25,Default,,0,0,0,,Енді алысқа бармасаң, суық тиіп қаласың.
Dialogue: 0,0:10:18.60,0:10:19.68,Default,,0,0,0,,Бір қолымда оқталған винтовка ұстап
Dialogue: 0,0:10:21.40,0:10:22.93,Default,,0,0,0,,Мен мән-жайды білмеймін, бірақ
Dialogue: 0,0:10:23.24,0:10:25.16,Default,,0,0,0,,Өзіңізді жақсы сезінгенше осында болыңыз.
Dialogue: 0,0:10:25.48,0:10:26.93,Default,,0,0,0,,Мұнда?
Dialogue: 0,0:10:27.24,0:10:29.69,Default,,0,0,0,,That way, we'll feel safer too.
Dialogue: 0,0:10:35.44,0:10:36.93,Default,,0,0,0,,Бүгін сенің туған күнің еді деп ойлаймын.
Dialogue: 0,0:10:37.68,0:10:39.92,Default,,0,0,0,,Наубайхана қоймада жоқ.
Dialogue: 0,0:10:41.64,0:10:42.53,Default,,0,0,0,,Наубайхана
Dialogue: 0,0:10:43.04,0:10:45.41,Default,,0,0,0,,Anyway, happy birthday
Dialogue: 0,0:10:47.44,0:10:48.28,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:10:57.16,0:10:58.84,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:59.72,0:11:02.69,Default,,0,0,0,,Маю-чан кеше тамақтанып отырғанда бақытты көрінді.
Dialogue: 0,0:11:05.72,0:11:08.69,Default,,0,0,0,,Бұл жігіт өзінше зейін қойып отыр.
Dialogue: 0,0:11:09.56,0:11:10.08,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:11:11.08,0:11:12.08,Default,,0,0,0,,Жаңа
Dialogue: 0,0:11:12.72,0:11:13.48,Default,,0,0,0,,Маю-чан?
Dialogue: 0,0:11:17.04,0:11:18.09,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:11:18.60,0:11:22.08,Default,,0,0,0,,Yes, I'm a nuisance.
Dialogue: 0,0:11:26.08,0:11:31.37,Default,,0,0,0,,Мұңсыз болсаң да, жылай аласың.
Dialogue: 0,0:11:46.60,0:11:47.65,Default,,0,0,0,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:11:49.20,0:11:50.65,Default,,0,0,0,,Нюунюу
Dialogue: 0,0:11:55.00,0:11:56.53,Default,,0,0,0,,Маю-чан, бұл керемет болды.
Dialogue: 0,0:11:57.08,0:11:59.65,Default,,0,0,0,,Мектепке бара бастағанда нұрлы болдым.
Dialogue: 0,0:12:02.24,0:12:05.24,Default,,0,0,0,,Өкінішпен қанша ұйықтайсың?
Dialogue: 0,0:12:05.84,0:12:08.64,Default,,0,0,0,,Мен тұрамын, тұрсам
Dialogue: 0,0:12:08.64,0:12:08.65,Default,,0,0,0,,Ah, I have to close the back door.
Dialogue: 0,0:12:08.65,0:12:10.40,Default,,0,0,0,,Ah, I have to close the back door.
Dialogue: 0,0:12:10.72,0:12:12.53,Default,,0,0,0,,Маған есікті жабуға көмектесіңізші.
Dialogue: 0,0:12:14.76,0:12:17.53,Default,,0,0,0,,Бірақ сіз мұны оңай мойындадыңыз.
Dialogue: 0,0:12:18.00,0:12:18.76,Default,,0,0,0,,Не
Dialogue: 0,0:12:19.28,0:12:20.88,Default,,0,0,0,,Маю-чанның анасы
Dialogue: 0,0:12:21.40,0:12:23.64,Default,,0,0,0,,Менің ойымша, бұл көбірек қиындық тудырады деп ойладым.
Dialogue: 0,0:12:26.40,0:12:30.04,Default,,0,0,0,,Қызымды бейтаныс адамға оңай сеніп тапсырар ма едім?
Dialogue: 0,0:12:30.48,0:12:33.05,Default,,0,0,0,,Ол да полицияға хабар бермеген сияқты.
Dialogue: 0,0:12:33.92,0:12:34.92,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:12:35.76,0:12:38.16,Default,,0,0,0,,Қоймауды шешкен Кота болды.
Dialogue: 0,0:12:38.88,0:12:40.04,Default,,0,0,0,,Жақсы, жақсы.
Dialogue: 0,0:12:40.80,0:12:43.04,Default,,0,0,0,,Қыздарды көп қоспаңыз
Dialogue: 0,0:12:43.04,0:12:45.93,Default,,0,0,0,,Менің ойымша, олар оны ұнатқандықтан мұнда әкелген жоқ.
Dialogue: 0,0:12:46.04,0:12:47.80,Default,,0,0,0,,Қараңдар, қараңдар, мен мектепке барамын.
Dialogue: 0,0:12:48.16,0:12:49.32,Default,,0,0,0,,Тез дайындал
Dialogue: 0,0:12:54.20,0:12:57.68,Default,,0,0,0,,Әй, тез оян.
Dialogue: 0,0:13:01.52,0:13:04.21,Default,,0,0,0,,Тыңдаңыз, сіз оны ешқашан қабылдамауыңыз керек.
Dialogue: 0,0:13:04.72,0:13:05.45,Default,,0,0,0,,Жаңа
Dialogue: 0,0:13:05.72,0:13:07.09,Default,,0,0,0,,Бұл Нюу емес.
Dialogue: 0,0:13:07.28,0:13:07.80,Default,,0,0,0,,Иә
Dialogue: 0,0:13:07.96,0:13:11.41,Default,,0,0,0,,Ню-чан, сен сөздерді біртіндеп үйреніп жатырсың.
Dialogue: 0,0:13:11.96,0:13:14.69,Default,,0,0,0,,Мені қазірдің өзінде атыммен атасаңыз екен.
Dialogue: 0,0:13:15.20,0:13:16.73,Default,,0,0,0,,Жақында бір күні
Dialogue: 0,0:13:20.48,0:13:23.32,Default,,0,0,0,,Келесі мұғалім өте эксцентрик деген қауесет бар.
Dialogue: 0,0:13:24.08,0:13:26.56,Default,,0,0,0,,Соққыға тез келетін атағы бар.
Dialogue: 0,0:13:26.72,0:13:28.45,Default,,0,0,0,,Егер сіз солай көрінсеңіз
Dialogue: 0,0:13:28.44,0:13:29.09,Default,,0,0,0,,Иә
Dialogue: 0,0:13:31.32,0:13:34.24,Default,,0,0,0,,Ню-чанды болжасаң, бәлеге қаласың.
Dialogue: 0,0:13:34.24,0:13:35.73,Default,,0,0,0,,Юка дегеніміз не?
Dialogue: 0,0:13:36.84,0:13:39.37,Default,,0,0,0,,Юка соншалықты ақылды емес.
Dialogue: 0,0:13:41.56,0:13:43.37,Default,,0,0,0,,Сіз кенеттен не туралы айтып отырсыз?
Dialogue: 0,0:13:43.56,0:13:47.20,Default,,0,0,0,,Мұнда, медициналық мектептен басқа, ауытқу баллы соншалықты жоғары емес.
Dialogue: 0,0:13:48.00,0:13:50.48,Default,,0,0,0,,Әйтеуір, аузымнан бар болғаны, ақыры ұстадым.
Dialogue: 0,0:13:51.64,0:13:53.77,Default,,0,0,0,,Қабылдауға қатысты барлық нәрсе жоғалып кетті.
Dialogue: 0,0:13:54.00,0:13:55.13,Default,,0,0,0,,Мен де бұның ықтимал еместігіне сенемін
Dialogue: 0,0:13:55.72,0:13:57.21,Default,,0,0,0,,Иә, иә, дұрыс.
Dialogue: 0,0:13:57.36,0:13:59.89,Default,,0,0,0,,Мен де Кота сияқты ақымақпын.
Dialogue: 0,0:14:00.20,0:14:01.53,Default,,0,0,0,,О. . . Эй
Dialogue: 0,0:14:02.20,0:14:03.09,Default,,0,0,0,,Иә
Dialogue: 0,0:14:06.88,0:14:12.01,Default,,0,0,0,,1952 жылы Миллер суда еритін органикалық қосылыс жасады.
Dialogue: 0,0:14:13.12,0:14:13.64,Default,,0,0,0,,Сен
Dialogue: 0,0:14:14.00,0:14:15.05,Default,,0,0,0,,. . иә
Dialogue: 0,0:14:15.28,0:14:18.01,Default,,0,0,0,,Айна неліктен вольфрам электродтарын пайдаланды?
Dialogue: 0,0:14:19.60,0:14:20.52,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:14:21.16,0:14:22.29,Default,,0,0,0,,Басқа адамдарда
Dialogue: 0,0:14:23.36,0:14:24.49,Default,,0,0,0,,Тағы кім біледі?
Dialogue: 0,0:14:25.92,0:14:26.60,Default,,0,0,0,,Иә
Dialogue: 0,0:14:26.60,0:14:28.05,Default,,0,0,0,,Ах. . . ақымақ
Dialogue: 0,0:14:37.68,0:14:38.36,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:14:40.36,0:14:41.57,Default,,0,0,0,,Профессорға не болды?
Dialogue: 0,0:14:42.68,0:14:43.81,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:14:45.12,0:14:45.88,Default,,0,0,0,,Неге мұнда?
Dialogue: 0,0:14:47.00,0:14:50.00,Default,,0,0,0,,Кешіріңіз, бұл баланың жағдайы нашар сияқты.
Dialogue: 0,0:14:50.04,0:14:52.44,Default,,0,0,0,,Біз сені сонда апарамыз.
Dialogue: 0,0:14:54.04,0:14:54.93,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:14:56.76,0:14:58.17,Default,,0,0,0,,Бүгін сабақ тоқтатылады.
Dialogue: 0,0:14:58.88,0:15:00.41,Default,,0,0,0,,Балалар сендер жиналыңдар.
Dialogue: 0,0:15:01.80,0:15:06.04,Default,,0,0,0,,Әлгі қыз Люси менің інімнің баласы.
Dialogue: 0,0:15:07.84,0:15:10.84,Default,,0,0,0,,Маған қандай нәрселер айта аласыз?
Dialogue: 0,0:15:13.08,0:15:16.61,Default,,0,0,0,,Мен жағада қаңғып жүрген баланы полицияға хабарлаған жоқпын.
Dialogue: 0,0:15:16.84,0:15:18.73,Default,,0,0,0,,Ол оны үйіне алып кеткенін айтты.
Dialogue: 0,0:15:19.48,0:15:22.48,Default,,0,0,0,,Бірдеңе қуғандай болды.
Dialogue: 0,0:15:22.72,0:15:24.21,Default,,0,0,0,,Оны жасыру үшін
Dialogue: 0,0:15:25.04,0:15:27.57,Default,,0,0,0,,Балалар сендер не істегендеріңді білесіңдер ме?
Dialogue: 0,0:15:28.36,0:15:30.84,Default,,0,0,0,,Кәмелетке толмағандарды ұрлау және ұрлау
Dialogue: 0,0:15:31.48,0:15:32.85,Default,,0,0,0,,Бұл ауыр қылмыстық әрекет.
Dialogue: 0,0:15:33.36,0:15:35.49,Default,,0,0,0,,Бізде солай
Dialogue: 0,0:15:36.24,0:15:37.57,Default,,0,0,0,,Мен бұл балаға қамқор боламын.
Dialogue: 0,0:15:38.56,0:15:39.21,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:40.32,0:15:41.32,Default,,0,0,0,,Әрине
Dialogue: 0,0:15:41.72,0:15:45.33,Default,,0,0,0,,Бұл баланың отбасының қаншалықты алаңдайтынын білесіз бе?
Dialogue: 0,0:15:45.72,0:15:47.56,Default,,0,0,0,,Сондықтан мені тыңдаңыз.
Dialogue: 0,0:15:48.12,0:15:51.88,Default,,0,0,0,,Есте сақтау қабілетінен айырылып, тіпті сөйлеу қабілеті бұзылған.
Dialogue: 0,0:15:54.72,0:15:58.00,Default,,0,0,0,,Кім емделу үшін ата-анасына қайтарылуы керек?
Dialogue: 0,0:15:58.44,0:15:59.96,Default,,0,0,0,,Тіпті сендер де түсінесіңдер.
Dialogue: 0,0:16:01.32,0:16:03.89,Default,,0,0,0,,Мен сенің істеген ісіңмен айналысамын.
Dialogue: 0,0:16:05.12,0:16:08.20,Default,,0,0,0,,Болашақты маған қалдыр, бәрің үйге қайтыңдар.
Dialogue: 0,0:16:08.96,0:16:11.64,Default,,0,0,0,,Бұл тым біржақты.
Dialogue: 0,0:16:13.52,0:16:14.40,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:16:14.72,0:16:15.76,Default,,0,0,0,,Кота
Dialogue: 0,0:16:15.76,0:16:19.52,Default,,0,0,0,,Жаңа, жоқ, сол қыз туралы.
Dialogue: 0,0:16:20.64,0:16:22.05,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:16:26.76,0:16:27.64,Default,,0,0,0,,Кота
Dialogue: 0,0:16:28.64,0:16:29.40,Default,,0,0,0,,Жаңа
Dialogue: 0,0:16:32.80,0:16:33.40,Default,,0,0,0,,Жаңа ма?
Dialogue: 0,0:16:36.36,0:16:38.16,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:16:45.68,0:16:46.80,Default,,0,0,0,,Кота
Dialogue: 0,0:16:48.64,0:16:54.40,Default,,0,0,0,,Кота Кота Кота Кота Кота
Dialogue: 0,0:16:55.04,0:16:57.20,Default,,0,0,0,,Кота Кота
Dialogue: 0,0:16:58.20,0:17:00.28,Default,,0,0,0,,Кота. . .
Dialogue: 0,0:17:06.36,0:17:08.36,Default,,0,0,0,,Сізбен кездесе бастағаным үшін кешіріңіз.
Dialogue: 0,0:17:09.00,0:17:09.88,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:10.36,0:17:13.28,Default,,0,0,0,,Мен кенет осы жерден көріністі көргім келді.
Dialogue: 0,0:17:14.64,0:17:18.12,Default,,0,0,0,,Кота Бұл жер маған әрқашан ұнайтын.
Dialogue: 0,0:17:19.16,0:17:19.88,Default,,0,0,0,,Мен
Dialogue: 0,0:17:21.16,0:17:22.88,Default,,0,0,0,,Мен ештеңе айтқан жоқпын.
Dialogue: 0,0:17:24.40,0:17:27.68,Default,,0,0,0,,Мен оны рұқсатсыз үйіне апару жаман ой болатынына сенімдімін.
Dialogue: 0,0:17:28.68,0:17:30.80,Default,,0,0,0,,Маю-чаннан өзгеше.
Dialogue: 0,0:17:31.68,0:17:36.44,Default,,0,0,0,,Енді сіз өз үйіңізге қайтып, мәңгілік бақытты өмір сүре аласыз.
Dialogue: 0,0:17:37.20,0:17:38.00,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:39.56,0:17:43.32,Default,,0,0,0,,Ню-чанмен біраз уақыт жүргені қызық болды.
Dialogue: 0,0:17:48.32,0:17:48.92,Default,,0,0,0,,Кота
Dialogue: 0,0:17:50.32,0:17:53.56,Default,,0,0,0,,Идиот, сен неге жылайсың? Бұл ұл болуы керек.
Dialogue: 0,0:17:54.08,0:17:55.65,Default,,0,0,0,,Бұлай жылама
Dialogue: 0,0:17:56.56,0:17:58.72,Default,,0,0,0,,Мен осылай жыласам, тіпті жылаймын
Dialogue: 0,0:18:07.20,0:18:10.72,Default,,0,0,0,,Диклониустың маңдай бөлігін алып жатқан адамның эпифизі
Dialogue: 0,0:18:11.36,0:18:13.08,Default,,0,0,0,,Векторларды манипуляциялау негізі
Dialogue: 0,0:18:14.08,0:18:15.20,Default,,0,0,0,,Бұл мүмкін
Dialogue: 0,0:18:16.96,0:18:20.36,Default,,0,0,0,,Мен интеллект бөліну тудыратынын білмедім.
Dialogue: 0,0:18:21.80,0:18:23.72,Default,,0,0,0,,Нюу Нюу
Dialogue: 0,0:18:23.72,0:18:25.24,Default,,0,0,0,,Мен оны таба алмаймын.
Dialogue: 0,0:18:25.60,0:18:30.08,Default,,0,0,0,,Сіз өзіңіздің бар екеніңізді адамдарды өлтіру арқылы ғана дәлелдей аласыз.
Dialogue: 0,0:18:31.56,0:18:34.13,Default,,0,0,0,,Люси, бұл керемет емес деп ойлайсың ба?
Dialogue: 0,0:18:34.68,0:18:39.76,Default,,0,0,0,,Біз Хома Сапиенстің 150 000 жылдық тарихын аяқтай аламыз.
Dialogue: 0,0:18:41.08,0:18:42.49,Default,,0,0,0,,Маған ұйықтайыншы.
Dialogue: 0,0:18:43.88,0:18:45.72,Default,,0,0,0,,Ал сіз оянғанда
Dialogue: 0,0:18:46.44,0:18:49.52,Default,,0,0,0,,Біз адамзаттың жаңа Адам ата мен Хауа анамыз.
Dialogue: 0,0:18:50.52,0:18:53.36,Default,,0,0,0,,Сіз менің баламды жасап жатырсыз
Dialogue: 0,0:18:55.52,0:18:56.52,Default,,0,0,0,,Қош келдің үйге.
Dialogue: 0,0:18:58.12,0:18:59.84,Default,,0,0,0,,Бұл жаңадан келген
Dialogue: 0,0:19:01.40,0:19:02.24,Default,,0,0,0,,Бұл
Dialogue: 0,0:19:04.36,0:19:05.40,Default,,0,0,0,,Кешіріңіз Маю Чан
Dialogue: 0,0:19:05.76,0:19:07.04,Default,,0,0,0,,Мен сенімен кейінірек сөйлесемін.
Dialogue: 0,0:19:11.60,0:19:13.17,Default,,0,0,0,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:19:15.04,0:19:17.36,Default,,0,0,0,,Мен Ню-санмен қоштасқым келді.
Dialogue: 0,0:19:18.92,0:19:21.81,Default,,0,0,0,,Бірақ анда-санда кездессек жақсы болмай ма?
Dialogue: 0,0:19:22.28,0:19:24.36,Default,,0,0,0,,Сізді ұрлаушы деп атайды.
Dialogue: 0,0:19:29.40,0:19:31.88,Default,,0,0,0,,Бірақ бұл рас па?
Dialogue: 0,0:19:35.56,0:19:37.32,Default,,0,0,0,,Ah. . . Бұл
Dialogue: 0,0:19:37.52,0:19:42.04,Default,,0,0,0,,Мен отбасына сенбеймін.
Dialogue: 0,0:19:46.64,0:19:49.68,Default,,0,0,0,,Қазір ойлап қарасам, біртүрлі болып қалды.
Dialogue: 0,0:19:50.20,0:19:53.20,Default,,0,0,0,,Мен Кадозава мырза туралы жақсы қауесеттерді көп естімедім.
Dialogue: 0,0:19:53.56,0:19:56.96,Default,,0,0,0,,Өйткені, мен Кадозава мырзамен қайта кездесіп, оның әңгімесін тыңдауым керек.
Dialogue: 0,0:19:59.08,0:19:59.92,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:07.44,0:20:09.40,Default,,0,0,0,,бастайық
Dialogue: 0,0:20:10.32,0:20:12.28,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:20:12.28,0:20:13.56,Default,,0,0,0,,Қайырлы түн Маю-чан
Dialogue: 0,0:20:13.84,0:20:14.60,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:20:25.48,0:20:31.84,Default,,0,0,0,,Эй, Кота, егер мен жоғалып кетсем
Dialogue: 0,0:20:33.36,0:20:35.12,Default,,0,0,0,,Бұрынғыдай жылайсың ба?
Dialogue: 0,0:20:38.60,0:20:40.48,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:20:41.84,0:20:44.49,Default,,0,0,0,,Мен жылағым келгендіктен жыламадым.
Dialogue: 0,0:20:46.76,0:20:47.76,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:48.88,0:20:50.48,Default,,0,0,0,,Мен ұйықтайын деп жатырмын
Dialogue: 0,0:20:51.72,0:20:53.24,Default,,0,0,0,,Ваннаға түскеннен кейін
Dialogue: 0,0:20:53.64,0:20:54.84,Default,,0,0,0,,Қайырлы түн
Dialogue: 0,0:20:55.32,0:20:56.73,Default,,0,0,0,,​​Иә, қайырлы түн.
Dialogue: 0,0:21:03.88,0:21:06.00,Default,,0,0,0,,Идиот Котаның Идиоты
Dialogue: 0,0:21:06.40,0:21:09.24,Default,,0,0,0,,Оны менен сұрама, ақымақ.
Dialogue: 0,0:21:15.24,0:21:17.28,Default,,0,0,0,,Мен оны бір күні жинап аламын деп ойладым, бірақ
Dialogue: 0,0:21:17.52,0:21:19.52,Default,,0,0,0,,Мен мұндай жерде болады деп ешқашан ойламадым.
Dialogue: 0,0:21:21.16,0:21:24.92,Default,,0,0,0,,Аспан мені таңдады, әкемді емес.
Dialogue: 0,0:21:40.68,0:21:42.04,Default,,0,0,0,,Сіз ұйықтап жатқан жоқсыз ба?
Dialogue: 0,0:21:42.44,0:21:43.56,Default,,0,0,0,,Ұйқы
Dialogue: 0,0:21:44.04,0:21:45.32,Default,,0,0,0,,Басқа адам
Dialogue: 0,0:21:46.52,0:21:47.68,Default,,0,0,0,,Ол дәл қазір осында—
Dialogue: 0,0:21:47.92,0:21:50.92,Default,,0,0,0,,Күте тұрыңыз, мен сіздің серіктесіңізмін.
Dialogue: 0,0:21:51.68,0:21:53.44,Default,,0,0,0,,Сені азат еткен менмін.
Dialogue: 0,0:21:54.68,0:21:56.64,Default,,0,0,0,,Менің әкем де мен сияқты ойлайды.
Dialogue: 0,0:21:58.04,0:22:01.32,Default,,0,0,0,,Бірақ менің әкем сияқты сені тежеу ​​ойым жоқ.
Dialogue: 0,0:22:02.04,0:22:04.44,Default,,0,0,0,,Сондықтан мен оған бұл жағдай болмай тұрып қашып кетуге рұқсат бердім.
Dialogue: 0,0:22:05.08,0:22:07.44,Default,,0,0,0,,Сіз ДНҚ-ның бұйрықтарына адалсыз.
Dialogue: 0,0:22:07.92,0:22:11.72,Default,,0,0,0,,Сіз ақымақ адам баласын жойып, өркендеуіміз керек дейсіз.
Dialogue: 0,0:22:12.32,0:22:18.08,Default,,0,0,0,,Сондықтан менімен бірге ескі адамдарды жойып, тек Диклониус үшін ғана дүние саламыз.
Dialogue: 0,0:22:19.20,0:22:19.96,Default,,0,0,0,,Қалайсың, Люси?
Dialogue: 0,0:22:20.44,0:22:22.09,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:22:24.96,0:22:25.68,Default,,0,0,0,,Артқа қайту
Dialogue: 0,0:22:26.80,0:22:27.84,Default,,0,0,0,,Люсиді тыңда
Dialogue: 0,0:22:28.48,0:22:30.84,Default,,0,0,0,,Сен екеуміз жау емеспіз, доспыз.
Dialogue: 0,0:22:31.92,0:22:33.80,Default,,0,0,0,,Мицугу да ақымақ маймыл.
Dialogue: 0,0:22:34.12,0:22:35.08,Default,,0,0,0,,Жоқ
Dialogue: 0,0:22:38.08,0:22:40.32,Default,,0,0,0,,Мен де сізбен бір нәсілденмін.
Dialogue: 0,0:22:40.96,0:22:41.72,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:22:43.36,0:22:46.88,Default,,0,0,0,,Бұл мүйіз менің қалдырған жалғыз ізім.
Dialogue: 0,0:22:47.20,0:22:49.85,Default,,0,0,0,,Люси, сен басқашасың.
Dialogue: 0,0:22:50.36,0:22:52.08,Default,,0,0,0,,Біз аңсаған тазалық. . .
Dialogue: 0,0:22:56.52,0:23:00.52,Default,,0,0,0,,Сен маған керек емессің
Dialogue: 0,0:24:34.44,0:24:35.56,Default,,0,0,0,,Мазасыздық пен жеңілдік
Dialogue: 0,0:24:35.84,0:24:37.49,Default,,0,0,0,,Қайғы мен мейірімділік
Dialogue: 0,0:24:37.96,0:24:40.48,Default,,0,0,0,,Төгілмейтін түрлі ойлар
Dialogue: 0,0:24:41.48,0:24:42.60,Default,,0,0,0,,Қарама-қайшылық болмаса да
Dialogue: 0,0:24:43.08,0:24:45.32,Default,,0,0,0,,Бұл бір ғана нәрсені білдіреді
Dialogue: 0,0:24:46.72,0:24:48.60,Default,,0,0,0,,Тұйықталған ескі күндердің ойлары
Dialogue: 0,0:24:48.72,0:24:50.48,Default,,0,0,0,,Жаңбыр жауып кінәлі
Dialogue: 0,0:24:51.12,0:24:53.77,Default,,0,0,0,,Ақырында ол тыныш ағып кетеді
Dialogue: 0,0:24:55.00,0:24:57.48,Default,,0,0,0,,Келесі жолы Эльфен өтірік айтты 6-бөлім
Dialogue: 0,0:24:57.48,0:24:58.60,Default,,0,0,0,,Жанашырлық
Dialogue: 0,0:25:00.10,0:25:06.10,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory