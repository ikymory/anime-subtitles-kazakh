Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.77,0:00:18.16,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.16,0:00:27.29,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.29,0:00:38.55,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.55,0:00:49.15,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.15,0:01:02.24,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.62,0:01:13.71,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.71,0:01:28.31,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:48.72,0:01:49.61,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:01:50.88,0:01:52.56,Default,,0,0,0,,Өйткені мен оны үнемі қарап отырдым
Dialogue: 0,0:01:53.56,0:01:57.25,Default,,0,0,0,,Әдемі ән екен деп ойладым.
Dialogue: 0,0:01:57.76,0:01:58.44,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:02:06.00,0:02:07.13,Default,,0,0,0,,А, өсіп жатыр ма? ол
Dialogue: 0,0:02:08.28,0:02:09.81,Default,,0,0,0,,Мүйізге ұқсайды
Dialogue: 0,0:02:11.28,0:02:13.68,Default,,0,0,0,,Осындай өсіп келе жатқанын көру жиіркенішті ме?
Dialogue: 0,0:02:15.28,0:02:19.13,Default,,0,0,0,,Қазір бәрі әбігерге түседі.
Dialogue: 0,0:02:21.44,0:02:22.68,Default,,0,0,0,,Салқын
Dialogue: 0,0:02:23.56,0:02:25.40,Default,,0,0,0,,Бұл өте керемет.
Dialogue: 0,0:02:28.76,0:02:31.21,Default,,0,0,0,,Иә, бұл таңқаларлық.
Dialogue: 0,0:02:38.28,0:02:41.81,Default,,0,0,0,,Бұл мені қаншалықты ауыртты?
Dialogue: 0,0:02:43.20,0:02:44.53,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:02:44.92,0:02:47.45,Default,,0,0,0,,Менің ойымша, бұл тамаша.
Dialogue: 0,0:02:47.84,0:02:49.33,Default,,0,0,0,,Бұл рас, өтірік емес.
Dialogue: 0,0:02:49.68,0:02:51.57,Default,,0,0,0,,Мен үшін алаңдама
Dialogue: 0,0:02:52.08,0:02:54.48,Default,,0,0,0,,Ей, менімен дос бол.
Dialogue: 0,0:02:55.16,0:02:59.32,Default,,0,0,0,,Мен қазір туысымның үйіндемін, бірақ тезірек үйге баруым керек.
Dialogue: 0,0:02:59.96,0:03:01.72,Default,,0,0,0,,Оған дейін бірге ойнайық.
Dialogue: 0,0:03:02.48,0:03:05.84,Default,,0,0,0,,Егер қиналсаңыз, маған бірдеңе айтыңыз.
Dialogue: 0,0:03:06.24,0:03:08.12,Default,,0,0,0,,Бұл сізге көмектесетініне сенімдімін
Dialogue: 0,0:03:09.84,0:03:10.96,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,0:03:12.48,0:03:13.12,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:14.00,0:03:16.12,Default,,0,0,0,,Себебі мен сендерді жек көремін.
Dialogue: 0,0:03:20.24,0:03:21.36,Default,,0,0,0,,Балалар
Dialogue: 0,0:03:22.76,0:03:26.48,Default,,0,0,0,,Аа, күте тұрыңыз, менің атым Кота.
Dialogue: 0,0:03:27.00,0:03:29.65,Default,,0,0,0,,Мен ертең осы уақытта осында күтемін.
Dialogue: 0,0:03:29.84,0:03:31.33,Default,,0,0,0,,Міндетті түрде келіңіз
Dialogue: 0,0:03:31.88,0:03:33.00,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:03:37.84,0:03:43.08,Default,,0,0,0,,Бүгін таңғы уақытта Кобори балалар үйіндегі ұлдар мен қыздарды өлтіруге қатысты қандай мәліметтер бар?
Dialogue: 0,0:03:43.28,0:03:44.64,Default,,0,0,0,,Мен оны әлі түсінген жоқпын.
Dialogue: 0,0:03:44.88,0:03:47.53,Default,,0,0,0,,Айналадағы тұрғындар да мазасыздануда.
Dialogue: 0,0:03:48.40,0:03:52.24,Default,,0,0,0,,Сондай-ақ мекемедегі бір бала әлі із-түзсіз жоғалып кеткені туралы ақпарат бар.
Dialogue: 0,0:03:52.40,0:03:54.72,Default,,0,0,0,,Полиция тергеу ауқымын кеңейтті
Dialogue: 0,0:04:16.76,0:04:19.76,Default,,0,0,0,,Мен ертең осы уақытта осында күтемін.
Dialogue: 0,0:04:34.16,0:04:37.40,Default,,0,0,0,,Мен сенің жаныңда болғым келеді.
Dialogue: 0,0:04:39.60,0:04:41.80,Default,,0,0,0,,Адо-са отбасылық еретик Кувамуги Шига
Dialogue: 0,0:04:43.16,0:04:45.00,Default,,0,0,0,,Екі аспап бірдей сияқты.
Dialogue: 0,0:04:45.16,0:04:46.92,Default,,0,0,0,,Нағыз кісі өлтіруші
Dialogue: 0,0:04:47.16,0:04:48.52,Default,,0,0,0,,Префектуралық полиция да үлкен.
Dialogue: 0,0:04:49.52,0:04:52.64,Default,,0,0,0,,Жоғалған қызды табудың жолы жоқ.
Dialogue: 0,0:04:55.16,0:04:55.80,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:00.80,0:05:01.52,Default,,0,0,0,,Жаңбыр жауып тұр
Dialogue: 0,0:05:02.68,0:05:03.76,Default,,0,0,0,,Сіз оны бір рет сала аласыз ба?
Dialogue: 0,0:05:21.52,0:05:22.32,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:05:22.80,0:05:23.96,Default,,0,0,0,,Оның келуі мүмкін емес.
Dialogue: 0,0:05:24.44,0:05:26.56,Default,,0,0,0,,Менің баратын жерім жоқ
Dialogue: 0,0:05:29.20,0:05:30.08,Default,,0,0,0,,(Роко) Һм? (Масато) Хехехе
Dialogue: 0,0:05:31.20,0:05:33.85,Default,,0,0,0,,Егер бұл мүйізді ұнатпасаңыз, оны жасырыңыз.
Dialogue: 0,0:05:36.60,0:05:37.56,Default,,0,0,0,,Сол тізе
Dialogue: 0,0:05:38.32,0:05:40.84,Default,,0,0,0,,Үйден жасырын шығып бара жатқанда ұстадым.
Dialogue: 0,0:05:42.04,0:05:42.84,Default,,0,0,0,,Шығу керек пе?
Dialogue: 0,0:05:43.48,0:05:45.80,Default,,0,0,0,,Мен екінші қабаттан ағашқа секірмек болдым.
Dialogue: 0,0:05:46.48,0:05:48.60,Default,,0,0,0,,Әкем маған көшеге шықпа деп айтады.
Dialogue: 0,0:05:48.84,0:05:51.24,Default,,0,0,0,,Бір қорқынышты кісі өлтіруші аңдып жүр.
Dialogue: 0,0:05:59.44,0:06:01.88,Default,,0,0,0,,Жаңбыр тоқтамайды
Dialogue: 0,0:06:03.48,0:06:05.48,Default,,0,0,0,,Эй, сен неге сонда болдың?
Dialogue: 0,0:06:05.88,0:06:06.88,Default,,0,0,0,,Бөлек
Dialogue: 0,0:06:08.12,0:06:08.76,Default,,0,0,0,,Иә
Dialogue: 0,0:06:09.20,0:06:10.12,Default,,0,0,0,,Бұл сізсіз
Dialogue: 0,0:06:12.08,0:06:13.88,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:06:14.44,0:06:15.20,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:06:15.60,0:06:18.20,Default,,0,0,0,,Сол достар
Dialogue: 0,0:06:21.64,0:06:22.24,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:06:26.64,0:06:28.76,Default,,0,0,0,,Мен сурет салғанды ұнатамын.
Dialogue: 0,0:06:28.96,0:06:30.96,Default,,0,0,0,,Мен де кеше тауға шықтым.
Dialogue: 0,0:06:31.64,0:06:36.40,Default,,0,0,0,,Сол кезде сіз осында болдыңыз, сәл жалғызсырап көріндіңіз.
Dialogue: 0,0:06:38.16,0:06:39.16,Default,,0,0,0,,Жанашырлық?
Dialogue: 0,0:06:39.52,0:06:40.60,Default,,0,0,0,,Және бұл
Dialogue: 0,0:06:45.40,0:06:47.28,Default,,0,0,0,,Мен де бұл әнді жақсы көремін
Dialogue: 0,0:06:48.04,0:06:50.04,Default,,0,0,0,,Сондықтан да мен бақыттымын
Dialogue: 0,0:07:05.56,0:07:06.56,Default,,0,0,0,,Суық, солай емес пе?
Dialogue: 0,0:07:07.00,0:07:07.88,Default,,0,0,0,,Иә
Dialogue: 0,0:07:11.68,0:07:12.56,Default,,0,0,0,,Не?
Dialogue: 0,0:07:13.28,0:07:14.93,Default,,0,0,0,,Бұл сізді жылытады
Dialogue: 0,0:07:15.92,0:07:17.41,Default,,0,0,0,,Мен суық тигіземін.
Dialogue: 0,0:07:28.04,0:07:30.44,Default,,0,0,0,,Шляпа Рахмет
Dialogue: 0,0:07:35.84,0:07:37.68,Default,,0,0,0,,Менімен тағы да ойнайсың ба?
Dialogue: 0,0:07:39.20,0:07:39.80,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:40.84,0:07:41.56,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:07:44.68,0:07:45.20,Default,,0,0,0,,Сен
Dialogue: 0,0:07:47.08,0:07:49.08,Default,,0,0,0,,Осылай ұзақ ойнамаңыз.
Dialogue: 0,0:07:49.56,0:07:51.92,Default,,0,0,0,,Мұғалім саған сыртқа шықпа деп айтқан шығар.
Dialogue: 0,0:07:52.36,0:07:54.08,Default,,0,0,0,,Бұл қауіпті, сондықтан тез арада үйге барыңыз.
Dialogue: 0,0:08:02.32,0:08:04.12,Default,,0,0,0,,Мамико, сен ақымақ
Dialogue: 0,0:08:04.12,0:08:05.88,Default,,0,0,0,,Мен ағамды уайымдап жүрмін.
Dialogue: 0,0:08:06.72,0:08:09.68,Default,,0,0,0,,Сәлем анашым, сіз әлі тамақтанып алдыңыз ба?
Dialogue: 0,0:08:09.68,0:08:09.69,Default,,0,0,0,,Сәл ұзағырақ ұстаңыз
Dialogue: 0,0:08:09.69,0:08:10.76,Default,,0,0,0,,Сәл ұзағырақ ұстаңыз
Dialogue: 0,0:08:10.76,0:08:12.12,Default,,0,0,0,,Әкем жақында келеді.
Dialogue: 0,0:08:16.00,0:08:16.76,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:08:20.12,0:08:21.61,Default,,0,0,0,,Біреу жоғалып кетті ме?
Dialogue: 0,0:08:22.88,0:08:23.64,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,0:08:24.52,0:08:25.36,Default,,0,0,0,,Мамико?
Dialogue: 0,0:08:26.00,0:08:27.52,Default,,0,0,0,,Не? Мен тіпті жарықты да қоса алмаймын.
Dialogue: 0,0:08:33.80,0:08:35.68,Default,,0,0,0,,Бұл жерде біраз уақытқа созылады ма?
Dialogue: 0,0:08:46.20,0:08:49.56,Default,,0,0,0,,Үш күн болды, келмейсің бе?
Dialogue: 0,0:08:55.92,0:08:57.57,Default,,0,0,0,,Сіз мені күтіп жүрсіз бе?
Dialogue: 0,0:08:58.44,0:08:59.96,Default,,0,0,0,,Мен емес
Dialogue: 0,0:09:00.44,0:09:02.60,Default,,0,0,0,,Мен мұнда келсем, сені көремін деп ойладым.
Dialogue: 0,0:09:04.92,0:09:07.20,Default,,0,0,0,,Бүгін мен қоштасуға келдім.
Dialogue: 0,0:09:10.56,0:09:11.44,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:11.72,0:09:14.96,Default,,0,0,0,,Ендеше бүгін сыртқа шығып көңілді болайық.
Dialogue: 0,0:09:16.56,0:09:17.48,Default,,0,0,0,,Көңіл көтеру үшін бе?
Dialogue: 0,0:09:20.60,0:09:22.60,Default,,0,0,0,,Сіз ешқашан хайуанаттар бағында болған жоқсыз ба?
Dialogue: 0,0:09:23.20,0:09:25.48,Default,,0,0,0,,Жануарларды қарау қызықты ма?
Dialogue: 0,0:09:26.08,0:09:27.00,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:09:27.36,0:09:29.24,Default,,0,0,0,,Біртүрлі жануар бар
Dialogue: 0,0:09:29.60,0:09:32.12,Default,,0,0,0,,Мен бейтаныс жануарларды жақсы көремін.
Dialogue: 0,0:09:33.24,0:09:34.76,Default,,0,0,0,,Мен адам болмасам да
Dialogue: 0,0:09:36.76,0:09:39.76,Default,,0,0,0,,Мен монахтарға қызықпаймын.
Dialogue: 0,0:09:44.24,0:09:46.24,Default,,0,0,0,,Ой, бұл не?
Dialogue: 0,0:09:46.52,0:09:48.36,Default,,0,0,0,,үлкен үлкен үлкен
Dialogue: 0,0:09:48.84,0:09:50.96,Default,,0,0,0,,Бұл өте үлкен.
Dialogue: 0,0:09:59.76,0:10:01.48,Default,,0,0,0,,Мен бұған аса риза емеспін.
Dialogue: 0,0:10:01.48,0:10:03.40,Default,,0,0,0,,Сәл таң қалдым
Dialogue: 0,0:10:03.84,0:10:06.88,Default,,0,0,0,,Уау, мойын ұзын, мойын ұзын
Dialogue: 0,0:10:07.16,0:10:09.28,Default,,0,0,0,,Әй, сенің мойның сәл ұзын екен.
Dialogue: 0,0:10:09.28,0:10:10.88,Default,,0,0,0,,Керемет
Dialogue: 0,0:10:11.48,0:10:13.76,Default,,0,0,0,,Пілдер мен жирафтар сізді соншалықты бақытты ете ме?
Dialogue: 0,0:10:14.40,0:10:15.52,Default,,0,0,0,,бәлкім, осы ғана шығар
Dialogue: 0,0:10:17.04,0:10:17.88,Default,,0,0,0,,Иә
Dialogue: 0,0:10:19.04,0:10:21.36,Default,,0,0,0,,Бүгін әкем маған көп қалталы ақша берді.
Dialogue: 0,0:10:21.64,0:10:22.64,Default,,0,0,0,,Кездесе алмағаныма өкінішті—жоқ, бәріңмен… деп ойлаймын.
Dialogue: 0,0:10:29.68,0:10:30.28,Default,,0,0,0,,Дәмді
Dialogue: 0,0:10:35.92,0:10:37.80,Default,,0,0,0,,Бірақ сәл салқын
Dialogue: 0,0:10:37.92,0:10:39.68,Default,,0,0,0,,Өйткені бұл қырынған су
Dialogue: 0,0:10:43.56,0:10:45.44,Default,,0,0,0,,Әй, тағы да айналайын.
Dialogue: 0,0:11:01.72,0:11:02.84,Default,,0,0,0,,. . . не
Dialogue: 0,0:11:09.48,0:11:11.60,Default,,0,0,0,,Ертең үйге сағат нешеде барасың?
Dialogue: 0,0:11:12.32,0:11:13.32,Default,,0,0,0,,Менің ойымша, түн
Dialogue: 0,0:11:13.96,0:11:16.96,Default,,0,0,0,,Нағашыммен фестивальге барған соң, мен түнде үйге қайтамын.
Dialogue: 0,0:11:18.08,0:11:18.84,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:22.68,0:11:24.44,Default,,0,0,0,,Әрі қарай қайда баруым керек?
Dialogue: 0,0:11:25.04,0:11:26.56,Default,,0,0,0,,Оның кеңдігі сонша, мен оны түсінбеймін.
Dialogue: 0,0:11:27.92,0:11:30.49,Default,,0,0,0,,Иә, көп қырғын болған болуы керек.
Dialogue: 0,0:11:30.84,0:11:32.44,Default,,0,0,0,,Бұл үшінші болуы керек.
Dialogue: 0,0:11:32.84,0:11:34.00,Default,,0,0,0,,Бұл қорқынышты, солай емес пе?
Dialogue: 0,0:11:34.24,0:11:37.13,Default,,0,0,0,,Полицейлер не істеп жатыр?
Dialogue: 0,0:11:38.48,0:11:39.97,Default,,0,0,0,,Қосымша
Dialogue: 0,0:11:41.24,0:11:43.97,Default,,0,0,0,,Мен тағы біреуді өлтіріп, қонатын жер табуым керек.
Dialogue: 0,0:11:45.36,0:11:48.44,Default,,0,0,0,,Өлтіру? Мені өлтіресің бе?
Dialogue: 0,0:11:49.52,0:11:50.52,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:11:51.12,0:11:53.00,Default,,0,0,0,,Неліктен мен тек өлтіремін?
Dialogue: 0,0:11:53.12,0:11:55.88,Default,,0,0,0,,Адам өлтіргенді ұнататындықтан болар.
Dialogue: 0,0:11:55.88,0:11:56.64,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:57.00,0:12:00.52,Default,,0,0,0,,Өлтірмесек, адамдар бір күні қырылады.
Dialogue: 0,0:12:00.84,0:12:04.84,Default,,0,0,0,,Бұл сізге қатысы жоқ адамдарды өлтіруге болмайды дегенді білдірмейді.
Dialogue: 0,0:12:05.16,0:12:07.12,Default,,0,0,0,,Сіз бұрыннан білуіңіз керек.
Dialogue: 0,0:12:07.76,0:12:11.04,Default,,0,0,0,,Мен де адамдарды жою үшін дүниеге келдім.
Dialogue: 0,0:12:11.04,0:12:12.12,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:12:13.72,0:12:14.72,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:12:15.64,0:12:17.88,Default,,0,0,0,,Күн ыстық, мен аздап шаршадым.
Dialogue: 0,0:12:18.16,0:12:19.88,Default,,0,0,0,,Мен салқын жер таптым
Dialogue: 0,0:12:26.12,0:12:28.69,Default,,0,0,0,,Су салқын, өзін жақсы сезінеді
Dialogue: 0,0:12:32.52,0:12:33.16,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:12:34.80,0:12:36.40,Default,,0,0,0,,Бетіңіз лас.
Dialogue: 0,0:12:51.56,0:12:53.56,Default,,0,0,0,,Енді әдемірек емес пе?
Dialogue: 0,0:12:57.32,0:12:58.44,Default,,0,0,0,,Өз кезегінде
Dialogue: 0,0:12:58.80,0:13:00.45,Default,,0,0,0,,Менің ойымша, бұл бірінші орында.
Dialogue: 0,0:13:19.84,0:13:22.44,Default,,0,0,0,,Киім кепкенше автобусқа отыра алмаймын.
Dialogue: 0,0:13:29.80,0:13:33.32,Default,,0,0,0,,Бүгін қоштасады.
Dialogue: 0,0:13:34.60,0:13:35.48,Default,,0,0,0,,Иә
Dialogue: 0,0:13:54.64,0:13:55.36,Default,,0,0,0,,Кота
Dialogue: 0,0:13:57.08,0:13:57.76,Default,,0,0,0,,Осы уақытқа дейін
Dialogue: 0,0:13:59.08,0:14:03.21,Default,,0,0,0,,Өмір бойы
Dialogue: 0,0:14:04.40,0:14:08.88,Default,,0,0,0,,Бүгінгі күн ең қызықты болды.
Dialogue: 0,0:14:10.64,0:14:12.00,Default,,0,0,0,,Бұл асыра сілтеу.
Dialogue: 0,0:14:12.64,0:14:16.72,Default,,0,0,0,,Бүгінгі күнді ешқашан ұмытпаймын.
Dialogue: 0,0:14:38.64,0:14:39.16,Default,,0,0,0,,Кота
Dialogue: 0,0:14:40.28,0:14:43.28,Default,,0,0,0,,Бұл. . Фестиваль ертең
Dialogue: 0,0:14:44.32,0:14:48.12,Default,,0,0,0,,Мен неге сенімен бармаймын?
Dialogue: 0,0:14:48.44,0:14:51.17,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:14:52.32,0:14:54.92,Default,,0,0,0,,Мен немере ағама ертең уәде беріп қойғанмын.
Dialogue: 0,0:14:55.64,0:14:56.56,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:57.32,0:14:58.68,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:14:59.04,0:15:00.04,Default,,0,0,0,,Нацуки, ояндың ба әлі?
Dialogue: 0,0:15:00.32,0:15:01.76,Default,,0,0,0,,Егер уәде болмаса
Dialogue: 0,0:15:01.76,0:15:02.96,Default,,0,0,0,,Уайымдама, Кота.
Dialogue: 0,0:15:03.76,0:15:07.65,Default,,0,0,0,,Котаның немере ағасы. . Әйел бе?
Dialogue: 0,0:15:12.08,0:15:12.80,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:15:15.40,0:15:17.08,Default,,0,0,0,,Эй, енді ше?
Dialogue: 0,0:15:17.08,0:15:18.20,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:15:19.48,0:15:23.16,Default,,0,0,0,,Кота қыздармен көбірек фестивальдерге барады.
Dialogue: 0,0:15:25.36,0:15:26.85,Default,,0,0,0,,Егер бұлай болса, маған ұнамас еді.
Dialogue: 0,0:15:27.36,0:15:28.44,Default,,0,0,0,,Ауыруы керек
Dialogue: 0,0:15:28.72,0:15:29.80,Default,,0,0,0,,Бұл ауыр болады
Dialogue: 0,0:15:30.48,0:15:31.80,Default,,0,0,0,,Ақымақ нәрсе жасаңыз
Dialogue: 0,0:15:31.80,0:15:31.81,Default,,0,0,0,,Мен өзімді осылай жаман сезінгенім жөн.
Dialogue: 0,0:15:31.81,0:15:34.84,Default,,0,0,0,,Мен өзімді осылай жаман сезінгенім жөн.
Dialogue: 0,0:15:35.12,0:15:36.72,Default,,0,0,0,,Сіз мені өлтіре аласыз.
Dialogue: 0,0:15:36.96,0:15:38.12,Default,,0,0,0,,Ол қайда еді?
Dialogue: 0,0:15:38.60,0:15:40.44,Default,,0,0,0,,Мен сені қазір өлтірсем
Dialogue: 0,0:15:40.60,0:15:44.36,Default,,0,0,0,,Осындай сезімнен құтылу оңай емес пе?
Dialogue: 0,0:15:44.60,0:15:45.36,Default,,0,0,0,,Қараңғылық
Dialogue: 0,0:15:46.00,0:15:47.72,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:15:48.96,0:15:50.61,Default,,0,0,0,,Мен білсем де
Dialogue: 0,0:15:54.12,0:15:56.12,Default,,0,0,0,,. . ауыртады
Dialogue: 0,0:15:58.20,0:16:00.12,Default,,0,0,0,,Аа, кешіріңіз, жақсысыз ба?
Dialogue: 0,0:16:02.12,0:16:03.84,Default,,0,0,0,,А, мен таң қалдым.
Dialogue: 0,0:16:04.48,0:16:05.84,Default,,0,0,0,,Бұл менің кесірім.
Dialogue: 0,0:16:08.12,0:16:08.72,Default,,0,0,0,,Кота
Dialogue: 0,0:16:10.12,0:16:11.53,Default,,0,0,0,,Сұранысыңыз бар ма?
Dialogue: 0,0:16:12.00,0:16:16.24,Default,,0,0,0,,Егер мен көп адамдарды өлтіре бастасам
Dialogue: 0,0:16:17.52,0:16:18.60,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:19.52,0:16:24.48,Default,,0,0,0,,Кота, Кота мені өлтірді.
Dialogue: 0,0:16:26.60,0:16:27.64,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:16:35.88,0:16:38.28,Default,,0,0,0,,Мен осы жерден теңізді көргенді жақсы көремін.
Dialogue: 0,0:16:38.92,0:16:40.28,Default,,0,0,0,,Бүгінгі күн үшін рахмет
Dialogue: 0,0:16:40.88,0:16:45.04,Default,,0,0,0,,Жоқ, бірақ бүгін өте көңілді күн болды.
Dialogue: 0,0:17:11.40,0:17:12.04,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:17:13.52,0:17:15.16,Default,,0,0,0,,Келесі жылы да келуді жоспарлап отырмын.
Dialogue: 0,0:17:15.16,0:17:15.17,Default,,0,0,0,,Содан кейін қайтадан
Dialogue: 0,0:17:15.17,0:17:16.40,Default,,0,0,0,,Содан кейін қайтадан
Dialogue: 0,0:17:16.40,0:17:17.52,Default,,0,0,0,,Сәлем Кота
Dialogue: 0,0:17:17.88,0:17:18.52,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:17:20.04,0:17:22.40,Default,,0,0,0,,Ертең менімен Котаның немере ағасы барады.
Dialogue: 0,0:17:22.40,0:17:25.24,Default,,0,0,0,,Бала? қыз?
Dialogue: 0,0:17:30.16,0:17:31.04,Default,,0,0,0,,Бұл ұл бала
Dialogue: 0,0:17:32.16,0:17:33.68,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:35.40,0:17:39.80,Default,,0,0,0,,Ертең Ертең түнде мен Котаны вокзалдан шығарып салуға барамын.
Dialogue: 0,0:17:40.92,0:17:41.52,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:17:46.08,0:17:51.96,Default,,0,0,0,,Бұдан былай тек сенімен бірге болған естеліктерім қалады деп ойладым.
Dialogue: 0,0:17:55.44,0:17:56.28,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:59.52,0:18:00.56,Default,,0,0,0,,Бүгін болса
Dialogue: 0,0:18:03.68,0:18:07.16,Default,,0,0,0,,Бүгін болса, Котаға айтамын.
Dialogue: 0,0:18:08.32,0:18:09.97,Default,,0,0,0,,Менің шынайы сезімдерім
Dialogue: 0,0:18:14.84,0:18:16.36,Default,,0,0,0,,Маған ұнамайды, маған ұнамайды, маған ұнамайды.
Dialogue: 0,0:18:16.36,0:18:18.60,Default,,0,0,0,,Осындай жерде ақымақ
Dialogue: 0,0:18:18.84,0:18:22.36,Default,,0,0,0,,Себебі келесі жазға дейін сені көргім келмейді.
Dialogue: 0,0:18:23.36,0:18:25.84,Default,,0,0,0,,Қарашы, мен жылауымды тоқтата алмаймын.
Dialogue: 0,0:18:28.84,0:18:29.96,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:31.72,0:18:33.37,Default,,0,0,0,,Не істеп жатырсың, ақымақ?
Dialogue: 0,0:18:38.36,0:18:41.76,Default,,0,0,0,,Қарасам, Котаның өзіне ұнайтын қызы бар еді.
Dialogue: 0,0:18:42.20,0:18:43.12,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:46.32,0:18:48.24,Default,,0,0,0,,Сол біртүрлі мүйізді қыз
Dialogue: 0,0:18:49.24,0:18:50.65,Default,,0,0,0,,Саған ғашық болып қалуым мүмкін емес
Dialogue: 0,0:18:51.52,0:18:53.24,Default,,0,0,0,,Онда неге мен?
Dialogue: 0,0:18:53.64,0:18:54.88,Default,,0,0,0,,Мен дәл осы жерде болжам жасаймын.
Dialogue: 0,0:18:55.24,0:18:58.52,Default,,0,0,0,,Мен бейтаныс жануарларды жақсы көремін.
Dialogue: 0,0:19:04.64,0:19:10.40,Default,,0,0,0,,Эй, сен адам емессің.
Dialogue: 0,0:19:11.16,0:19:13.28,Default,,0,0,0,,Бұл адамдар өмір сүретін әлем.
Dialogue: 0,0:19:21.68,0:19:23.12,Default,,0,0,0,,Сен ақымақ баласың.
Dialogue: 0,0:19:24.24,0:19:25.89,Default,,0,0,0,,Өйткені мен адамдарға сенемін
Dialogue: 0,0:19:26.76,0:19:28.76,Default,,0,0,0,,Ол тіпті адам емес.
Dialogue: 0,0:19:34.12,0:19:35.04,Default,,0,0,0,,Маған бұл енді ұнамайды
Dialogue: 0,0:19:35.80,0:19:37.24,Default,,0,0,0,,Мен енді шыдай алмаймын
Dialogue: 0,0:19:37.76,0:19:39.56,Default,,0,0,0,,Достар және орын
Dialogue: 0,0:19:40.16,0:19:43.40,Default,,0,0,0,,Менде ештеңе қалмады
Dialogue: 0,0:20:00.28,0:20:01.96,Default,,0,0,0,,Сіз бұрыннан білуіңіз керек.
Dialogue: 0,0:20:02.52,0:20:06.08,Default,,0,0,0,,Бұл дүние мен болуым керек дүние емес.
Dialogue: 0,0:20:06.28,0:20:08.85,Default,,0,0,0,,Сонымен не істеуім керек?
Dialogue: 0,0:20:09.32,0:20:10.81,Default,,0,0,0,,Жарайды, міне.
Dialogue: 0,0:20:13.72,0:20:16.84,Default,,0,0,0,,Әлемді менің әлемім етіңіз
Dialogue: 0,0:20:17.84,0:20:21.44,Default,,0,0,0,,Себебі менде мұны істеуге күшім жетеді.
Dialogue: 0,0:20:22.36,0:20:23.20,Default,,0,0,0,,Таңдау
Dialogue: 0,0:20:23.92,0:20:27.72,Default,,0,0,0,,Қауып, менсінбей, осылай өлемін бе?
Dialogue: 0,0:20:27.96,0:20:28.68,Default,,0,0,0,,Әлде…
Dialogue: 0,0:20:30.24,0:20:33.36,Default,,0,0,0,,Бұл баланың жолын кеспеңіз.
Dialogue: 0,0:20:33.60,0:20:35.48,Default,,0,0,0,,Жолда жатпа
Dialogue: 0,0:20:35.68,0:20:37.24,Default,,0,0,0,,Бұл қандай бала?
Dialogue: 0,0:20:37.24,0:20:37.25,Default,,0,0,0,,Әлі жатып, бірдеңе деп күбірледі.
Dialogue: 0,0:20:37.25,0:20:40.00,Default,,0,0,0,,Әлі жатып, бірдеңе деп күбірледі.
Dialogue: 0,0:20:40.44,0:20:43.25,Default,,0,0,0,,Өз жеріңізді жасағыңыз келе ме?
Dialogue: 0,0:20:47.48,0:20:48.12,Default,,0,0,0,,Кота
Dialogue: 0,0:20:48.48,0:20:50.36,Default,,0,0,0,,Кет, ақымақ.
Dialogue: 0,0:20:55.72,0:20:56.76,Default,,0,0,0,,Олар сол таңертең ғана қабырғалардың ар жағына барлау миссиясына аттанған еді.
Dialogue: 0,0:20:56.96,0:20:57.84,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:20:58.40,0:20:59.97,Default,,0,0,0,,Маған қатты ұнады
Dialogue: 0,0:21:14.84,0:21:17.04,Default,,0,0,0,,Не, бомба?
Dialogue: 0,0:21:18.04,0:21:20.04,Default,,0,0,0,,Полицияны шақырыңыз
Dialogue: 0,0:21:28.40,0:21:29.52,Default,,0,0,0,,Ах. . сен
Dialogue: 0,0:21:30.92,0:21:32.04,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:21:32.36,0:21:33.56,Default,,0,0,0,,Бұл қанды
Dialogue: 0,0:21:40.00,0:21:41.16,Default,,0,0,0,,Мен сені құртамын
Dialogue: 0,0:21:42.12,0:21:43.56,Default,,0,0,0,,Барлығыңыз
Dialogue: 0,0:21:50.76,0:21:53.16,Default,,0,0,0,,Бұл дұрыс, себебі мен Канайды көрдім.
Dialogue: 0,0:21:53.56,0:21:57.16,Default,,0,0,0,,Бір мүйізді адам бар еді, оның айналасында көп адамдар құлап жатты.
Dialogue: 0,0:22:07.44,0:22:08.32,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:22:10.84,0:22:12.84,Default,,0,0,0,,Сіз ботқа дайындайтын шығарсыз.
Dialogue: 0,0:22:15.28,0:22:16.32,Default,,0,0,0,,Таң қалды
Dialogue: 0,0:22:17.32,0:22:20.68,Default,,0,0,0,,Ботқаны оңай жасай алады.
Dialogue: 0,0:22:24.08,0:22:24.96,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:22:25.48,0:22:26.44,Default,,0,0,0,,Бұл Люси.
Dialogue: 0,0:22:26.84,0:22:28.56,Default,,0,0,0,,Люси ішінде.
Dialogue: 0,0:22:29.80,0:22:30.80,Default,,0,0,0,,. . . Бірақ
Dialogue: 0,0:22:31.24,0:22:34.13,Default,,0,0,0,,Ню-сан шынымен де
Dialogue: 0,0:22:34.48,0:22:35.24,Default,,0,0,0,,Күлкілі
Dialogue: 0,0:22:36.36,0:22:37.36,Default,,0,0,0,,Өкінішке орай, мен көмектесе алмаймын. Кешіріңіз.
Dialogue: 0,0:22:38.20,0:22:40.60,Default,,0,0,0,,Мүмкін қалған екеуі
Dialogue: 0,0:22:41.12,0:22:42.61,Default,,0,0,0,,Иә. . . Мұндай нәрсе
Dialogue: 0,0:22:43.08,0:22:44.12,Default,,0,0,0,,Маю Дам
Dialogue: 0,0:22:46.24,0:22:47.12,Default,,0,0,0,,Ню-сан
Dialogue: 0,0:22:48.72,0:22:51.24,Default,,0,0,0,,Күтілгендей, сіз
Dialogue: 0,0:24:34.96,0:24:35.96,Default,,0,0,0,,Ер адам
Dialogue: 0,0:24:36.60,0:24:38.44,Default,,0,0,0,,Адам еместер үшін
Dialogue: 0,0:24:38.44,0:24:39.96,Default,,0,0,0,,Адам болудан бас тартты
Dialogue: 0,0:24:41.60,0:24:43.08,Default,,0,0,0,,Әрекеттің салдары
Dialogue: 0,0:24:43.08,0:24:43.09,Default,,0,0,0,,Адамнан не қалды
Dialogue: 0,0:24:43.09,0:24:44.84,Default,,0,0,0,,Адамнан не қалды
Dialogue: 0,0:24:46.12,0:24:48.12,Default,,0,0,0,,Өлімге әкелетін ауру болса да
