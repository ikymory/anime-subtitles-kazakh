Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.77,0:00:18.16,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.16,0:00:27.29,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.29,0:00:38.55,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.55,0:00:49.15,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.15,0:01:02.24,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.62,0:01:13.71,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.71,0:01:28.31,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:35.84,0:01:37.08,Default,,0,0,0,,Чи. . . Бұл дұрыс емес
Dialogue: 0,0:01:37.08,0:01:39.85,Default,,0,0,0,,Киім дымқыл болды, өзімді ұстай алмадым.
Dialogue: 0,0:01:41.96,0:01:42.85,Default,,0,0,0,,Сонымен. . .
Dialogue: 0,0:01:44.20,0:01:45.20,Default,,0,0,0,,Бұл үйдің кілті
Dialogue: 0,0:01:46.00,0:01:47.08,Default,,0,0,0,,Мен оны осында қалдырамын.
Dialogue: 0,0:01:50.24,0:01:53.01,Default,,0,0,0,,Ню-чанның жақсы көрінгеніне қуаныштымын.
Dialogue: 0,0:01:53.36,0:01:55.12,Default,,0,0,0,,Юка Тэт. . . Мынау
Dialogue: 0,0:01:55.32,0:01:57.45,Default,,0,0,0,,Мен оны көргім келгендіктен сөзіңізді бөлдім.
Dialogue: 0,0:01:57.44,0:01:58.01,Default,,0,0,0,,Қайтару
Dialogue: 0,0:01:58.24,0:01:59.61,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:01:59.76,0:02:00.36,Default,,0,0,0,,Күте тұрыңыз, эй.
Dialogue: 0,0:02:00.84,0:02:02.65,Default,,0,0,0,,Мені тыңда.
Dialogue: 0,0:02:04.08,0:02:06.08,Default,,0,0,0,,Демек, бұл түсінбеушілік.
Dialogue: 0,0:02:09.56,0:02:10.40,Default,,0,0,0,,Hey Kota
Dialogue: 0,0:02:10.92,0:02:11.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:12.56,0:02:17.33,Default,,0,0,0,,Кішкентай кезімде фестивальдерге бірге баратынбыз.
Dialogue: 0,0:02:17.56,0:02:18.45,Default,,0,0,0,,Есіңізде ме?
Dialogue: 0,0:02:18.88,0:02:19.88,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:02:20.64,0:02:22.05,Default,,0,0,0,,Бұл кенеттен не болды?
Dialogue: 0,0:02:22.52,0:02:24.68,Default,,0,0,0,,Қазір маңызды емес.
Dialogue: 0,0:02:26.16,0:02:27.08,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:02:29.32,0:02:29.97,Default,,0,0,0,,Юка
Dialogue: 0,0:02:30.64,0:02:32.29,Default,,0,0,0,,Мен үнемі. . .
Dialogue: 0,0:02:33.76,0:02:34.44,Default,,0,0,0,,Мәңгі. . .
Dialogue: 0,0:02:35.68,0:02:36.33,Default,,0,0,0,,Юка
Dialogue: 0,0:02:36.92,0:02:38.08,Default,,0,0,0,,Котаның ақымақ
Dialogue: 0,0:02:39.44,0:02:40.73,Default,,0,0,0,,Күте тұрыңыз, Юка.
Dialogue: 0,0:02:45.84,0:02:47.29,Default,,0,0,0,,Неге олай дейсің?
Dialogue: 0,0:02:51.84,0:02:53.97,Default,,0,0,0,,Мен омыртқамның дірілдегенін сеземін.
Dialogue: 0,0:02:54.72,0:02:55.96,Default,,0,0,0,,Суық па?
Dialogue: 0,0:02:57.96,0:02:58.96,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:03:02.56,0:03:04.85,Default,,0,0,0,,Бұл әке, бұл әке
Dialogue: 0,0:03:19.60,0:03:20.49,Default,,0,0,0,,Нана
Dialogue: 0,0:03:20.60,0:03:22.25,Default,,0,0,0,,Менің сенен бір жақсылығым бар.
Dialogue: 0,0:03:44.28,0:03:45.41,Default,,0,0,0,,Ах, бұзылды.
Dialogue: 0,0:03:46.12,0:03:48.49,Default,,0,0,0,,Әй, сен мұны жақсы білмейсің.
Dialogue: 0,0:03:50.04,0:03:52.17,Default,,0,0,0,,Содан кейін Kota ойнап көріңіз.
Dialogue: 0,0:03:52.28,0:03:53.17,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:00.16,0:04:01.49,Default,,0,0,0,,Иә, орындалды.
Dialogue: 0,0:04:06.36,0:04:07.41,Default,,0,0,0,,Жарайды, енді іске кірісейік.
Dialogue: 0,0:04:08.92,0:04:10.13,Default,,0,0,0,,Жарайды, енді іске кірісейік.
Dialogue: 0,0:04:10.40,0:04:11.64,Default,,0,0,0,,Бөлек
Dialogue: 0,0:04:11.64,0:04:13.29,Default,,0,0,0,,Бұл қалыпты жағдай.
Dialogue: 0,0:04:14.44,0:04:15.93,Default,,0,0,0,,Әй, ол қайтадан бұзылды.
Dialogue: 0,0:04:16.52,0:04:17.52,Default,,0,0,0,,Ақылға қонымсыз
Dialogue: 0,0:04:18.36,0:04:20.76,Default,,0,0,0,,Қолымнан келсе не айтсаң да тыңдаймын.
Dialogue: 0,0:04:21.08,0:04:22.84,Default,,0,0,0,,Өте бастық Өте бастық
Dialogue: 0,0:04:23.24,0:04:24.48,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:04:24.52,0:04:28.29,Default,,0,0,0,,Келесі жолы бір-бірімізге тигенімізде, бір-бірімізден таза өту үшін бір-бірімізді сипалаймыз.
Dialogue: 0,0:04:28.60,0:04:31.89,Default,,0,0,0,,Ендеше, жаттығудың уақыты келді.
Dialogue: 0,0:04:32.28,0:04:35.52,Default,,0,0,0,,If possible, I'll make you listen to whatever I have to say.
Dialogue: 0,0:04:35.84,0:04:36.76,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:04:36.76,0:04:38.52,Default,,0,0,0,,Мұқият есте сақтаңыз
Dialogue: 0,0:04:53.68,0:04:54.36,Default,,0,0,0,,Бұл ақымақ.
Dialogue: 0,0:04:55.16,0:04:55.89,Default,,0,0,0,,Кенже
Dialogue: 0,0:04:57.04,0:04:58.01,Default,,0,0,0,,Өтініш дегеніміз не?
Dialogue: 0,0:04:58.44,0:05:00.68,Default,,0,0,0,,Әкем не сұраса, тыңдаймын.
Dialogue: 0,0:05:01.76,0:05:03.05,Default,,0,0,0,,Әке сөзі нені білдіреді?
Dialogue: 0,0:05:03.68,0:05:07.21,Default,,0,0,0,,Бұл шын мәнінде Құрама бастықтың қызы дегенді білдіреді. . .
Dialogue: 0,0:05:07.40,0:05:08.29,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:05:09.20,0:05:11.68,Default,,0,0,0,,Туғаннан бері осында оқшауланған.
Dialogue: 0,0:05:12.32,0:05:14.45,Default,,0,0,0,,Мен азаптауға жақын эксперименттерге ұшырадым.
Dialogue: 0,0:05:15.96,0:05:17.69,Default,,0,0,0,,Сол жағдайда аман қалу үшін
Dialogue: 0,0:05:18.44,0:05:20.41,Default,,0,0,0,,Оған Ранраканың қолдауы керек шығар.
Dialogue: 0,0:05:21.68,0:05:24.68,Default,,0,0,0,,Бұл қолдау - Курама басшысы
Dialogue: 0,0:05:25.72,0:05:27.72,Default,,0,0,0,,Бастықты әкесі деп ойлау
Dialogue: 0,0:05:28.32,0:05:30.85,Default,,0,0,0,,By trying to meet his father's expectations
Dialogue: 0,0:05:31.72,0:05:33.61,Default,,0,0,0,,Ол осы уақытқа дейін шыдап келді
Dialogue: 0,0:05:34.44,0:05:35.49,Default,,0,0,0,,болмаса
Dialogue: 0,0:05:36.20,0:05:38.60,Default,,0,0,0,,Оның психикасы бұзылған болуы керек.
Dialogue: 0,0:05:40.84,0:05:44.81,Default,,0,0,0,,Number 7 has a meek personality and has never had a problem pointing his "hands" at others.
Dialogue: 0,0:05:46.24,0:05:48.37,Default,,0,0,0,,Бұл ерекше жағдай.
Dialogue: 0,0:05:50.08,0:05:51.97,Default,,0,0,0,,Мен сенің бір адамды өлтіруіңді қалаймын.
Dialogue: 0,0:05:56.24,0:05:57.08,Default,,0,0,0,,Нана
Dialogue: 0,0:05:57.68,0:05:59.36,Default,,0,0,0,,Сіз оны өлтіре алмайсыз, өйткені ол адам.
Dialogue: 0,0:06:00.56,0:06:02.85,Default,,0,0,0,,Қарсылас – Нана сияқты Диклониус.
Dialogue: 0,0:06:04.24,0:06:06.08,Default,,0,0,0,,Диклоний жалғыз қашып құтылды.
Dialogue: 0,0:06:07.20,0:06:10.33,Default,,0,0,0,,Диклоний бір-бірін сезіну күші бар.
Dialogue: 0,0:06:11.24,0:06:13.13,Default,,0,0,0,,Сіз оны таба білуіңіз керек.
Dialogue: 0,0:06:15.00,0:06:16.53,Default,,0,0,0,,Менің ойымша, бұл мүмкін.
Dialogue: 0,0:06:18.12,0:06:19.76,Default,,0,0,0,,Бірақ мен сені өлтіре алмаймын
Dialogue: 0,0:06:19.76,0:06:19.77,Default,,0,0,0,,Бұл жай ғана аялдама болса, онда жақсы.
Dialogue: 0,0:06:19.77,0:06:21.52,Default,,0,0,0,,Бұл жай ғана аялдама болса, онда жақсы.
Dialogue: 0,0:06:22.40,0:06:25.24,Default,,0,0,0,,Егер сіз оны тапсаңыз, бізбен байланысуға дайын болыңыз.
Dialogue: 0,0:06:26.12,0:06:27.01,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:06:28.72,0:06:32.73,Default,,0,0,0,,Әкемді мазалайтын адам сол.
Dialogue: 0,0:06:34.00,0:06:36.73,Default,,0,0,0,,Аа, мен енді Нанаға ғана сене аламын.
Dialogue: 0,0:06:44.24,0:06:46.37,Default,,0,0,0,,Шынымен де
Dialogue: 0,0:06:50.92,0:06:52.81,Default,,0,0,0,,Жарайды, Нана, мен бар күшімді саламын.
Dialogue: 0,0:06:55.40,0:06:58.17,Default,,0,0,0,,Мен 7 нөмірі ертеңге дейін шығуға дайын болғанын қалаймын.
Dialogue: 0,0:07:02.44,0:07:05.57,Default,,0,0,0,,39 градус
Dialogue: 0,0:07:06.04,0:07:07.04,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:07:07.64,0:07:08.69,Default,,0,0,0,,Тыныш тыныш
Dialogue: 0,0:07:08.76,0:07:09.92,Default,,0,0,0,,Ұйқы сізді емдейді.
Dialogue: 0,0:07:11.00,0:07:13.57,Default,,0,0,0,,Оның орнына шалбар киіңіз.
Dialogue: 0,0:07:13.68,0:07:14.33,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:07:16.68,0:07:19.65,Default,,0,0,0,,Таңертең болды. Қазір сағат қанша?
Dialogue: 0,0:07:25.04,0:07:26.85,Default,,0,0,0,,Жаңа~ Жаңа~
Dialogue: 0,0:07:27.56,0:07:28.56,Default,,0,0,0,,Су
Dialogue: 0,0:07:29.68,0:07:30.44,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:07:30.72,0:07:32.53,Default,,0,0,0,,Келіп су күте аласыз ба?
Dialogue: 0,0:07:33.32,0:07:34.05,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:07:34.04,0:07:35.61,Default,,0,0,0,,Бұл су, ханым.
Dialogue: 0,0:07:37.80,0:07:39.61,Default,,0,0,0,,Бұл жақсы емес
Dialogue: 0,0:07:40.40,0:07:42.05,Default,,0,0,0,,Миз?
Dialogue: 0,0:07:42.72,0:07:43.61,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:44.16,0:07:45.84,Default,,0,0,0,,Су, осында келіп күте аласың ба?
Dialogue: 0,0:07:47.08,0:07:47.84,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:07:57.56,0:07:58.08,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:08:01.32,0:08:02.48,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:03.00,0:08:05.21,Default,,0,0,0,,Өз сезімдеріңізді ғана қабылдаңыз.
Dialogue: 0,0:08:23.24,0:08:24.13,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:08:24.52,0:08:27.13,Default,,0,0,0,,Мен мұнда Коутамен кездесуге келген жоқпын.
Dialogue: 0,0:08:27.48,0:08:29.53,Default,,0,0,0,,Мен Ню-чанның киімдерін әкелдім.
Dialogue: 0,0:08:30.08,0:08:31.53,Default,,0,0,0,,Су Су
Dialogue: 0,0:08:32.28,0:08:33.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:39.16,0:08:40.32,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:40.44,0:08:41.68,Default,,0,0,0,,Мен ауруханаға баруым керек.
Dialogue: 0,0:08:42.16,0:08:44.21,Default,,0,0,0,,Жарайды, мен ауруханаға бармаймын.
Dialogue: 0,0:08:44.88,0:08:45.80,Default,,0,0,0,,Кота
Dialogue: 0,0:08:48.32,0:08:49.85,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:08:50.08,0:08:52.29,Default,,0,0,0,,Бұл не? Қарғыстың бір түрі
Dialogue: 0,0:08:55.72,0:08:56.53,Default,,0,0,0,,Юка
Dialogue: 0,0:08:56.68,0:08:57.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:57.40,0:08:59.61,Default,,0,0,0,,Сіз кеше фестиваль туралы айттыңыз.
Dialogue: 0,0:09:00.84,0:09:02.60,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:09:04.56,0:09:05.21,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:09:05.96,0:09:07.29,Default,,0,0,0,,Сол мереке күні
Dialogue: 0,0:09:08.56,0:09:10.93,Default,,0,0,0,,Соңғы күні мен Юкамен қоштастым
Dialogue: 0,0:09:11.48,0:09:13.37,Default,,0,0,0,,Жақсы есімде жоқ
Dialogue: 0,0:09:14.96,0:09:18.97,Default,,0,0,0,,Around that time, my father died in a traffic accident.
Dialogue: 0,0:09:20.36,0:09:22.20,Default,,0,0,0,,Кана да ауырып қалды.
Dialogue: 0,0:09:22.84,0:09:27.61,Default,,0,0,0,,I guess it's because of the fact that the Shoke thing happened one after the other.
Dialogue: 0,0:09:30.60,0:09:32.36,Default,,0,0,0,,Әй, не болды?
Dialogue: 0,0:09:33.12,0:09:34.01,Default,,0,0,0,,Өйткені
Dialogue: 0,0:09:35.32,0:09:37.08,Default,,0,0,0,,Ағай мен Кана Чан
Dialogue: 0,0:09:38.60,0:09:41.84,Default,,0,0,0,,Сол күні үйге пойызда
Dialogue: 0,0:09:42.76,0:09:44.44,Default,,0,0,0,,Я, мен сізді жақсы естімеймін.
Dialogue: 0,0:09:45.52,0:09:46.36,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:09:47.52,0:09:48.52,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:09:49.08,0:09:49.89,Default,,0,0,0,,Юка
Dialogue: 0,0:09:50.76,0:09:51.52,Default,,0,0,0,,Жаңа ма?
Dialogue: 0,0:09:52.12,0:09:53.53,Default,,0,0,0,,Мен суды ауыстырамын.
Dialogue: 0,0:09:59.64,0:10:00.97,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:01.40,0:10:04.40,Default,,0,0,0,,Сол күн туралы, Коута және басқалар. . .
Dialogue: 0,0:10:05.16,0:10:06.05,Default,,0,0,0,,Сонымен. . .
Dialogue: 0,0:10:13.28,0:10:14.52,Default,,0,0,0,,Тітіркендірмеңіз
Dialogue: 0,0:10:15.12,0:10:17.12,Default,,0,0,0,,Ота жасатқандар бар ма?
Dialogue: 0,0:10:17.28,0:10:18.52,Default,,0,0,0,,Бұл кітап
Dialogue: 0,0:10:18.92,0:10:21.05,Default,,0,0,0,,Үлкен қарны бар мысық
Dialogue: 0,0:10:21.92,0:10:23.29,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,0:10:23.92,0:10:27.16,Default,,0,0,0,,Бұл ұнамаса, мұнда өлуден басқа амалың жоқ.
Dialogue: 0,0:10:30.00,0:10:31.68,Default,,0,0,0,,...
Dialogue: 0,0:10:32.16,0:10:35.32,Default,,0,0,0,,Өмірден қайтқанда осы емді көрдім.
Dialogue: 0,0:10:36.56,0:10:38.32,Default,,0,0,0,,Әйтпесе, адамзат жойылады.
Dialogue: 0,0:10:44.44,0:10:45.28,Default,,0,0,0,,Ахога сен
Dialogue: 0,0:10:45.68,0:10:49.77,Default,,0,0,0,,Адамзаттың жойылып кетуіне менің жанымның қандай қатысы бар?
Dialogue: 0,0:10:50.20,0:10:52.52,Default,,0,0,0,,Бұрыштағы анау қандай әйел?
Dialogue: 0,0:10:52.52,0:10:53.76,Default,,0,0,0,,Бұл қандай қозғалыс?
Dialogue: 0,0:10:59.56,0:11:03.96,Default,,0,0,0,,Айтшы, мен не жоғалттым?
Dialogue: 0,0:11:08.08,0:11:10.05,Default,,0,0,0,,Біз Диклониус деп атаймыз
Dialogue: 0,0:11:10.72,0:11:11.32,Default,,0,0,0,,Дик
Dialogue: 0,0:11:11.72,0:11:13.72,Default,,0,0,0,,Адам мутанты Меутент.
Dialogue: 0,0:11:14.68,0:11:15.97,Default,,0,0,0,,Адамдар Бұл не?
Dialogue: 0,0:11:19.16,0:11:20.84,Default,,0,0,0,,Сипаттамаларды білетіндей
Dialogue: 0,0:11:21.60,0:11:24.36,Default,,0,0,0,,Бүйірлік мидағы жұп проекциялар
Dialogue: 0,0:11:25.24,0:11:26.81,Default,,0,0,0,,Ең бастысы
Dialogue: 0,0:11:27.60,0:11:29.48,Default,,0,0,0,,Екі қол жоқ.
Dialogue: 0,0:11:30.44,0:11:31.48,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:11:32.24,0:11:36.13,Default,,0,0,0,,Сіз сол қарғыс атқыр қарумен туылғанмын дейсіз бе?
Dialogue: 0,0:11:36.72,0:11:40.32,Default,,0,0,0,,Бұл «қол» және рецепторлар тегістелген.
Dialogue: 0,0:11:40.84,0:11:43.36,Default,,0,0,0,,Егжей-тегжейлі талдау әлі жоқ
Dialogue: 0,0:11:44.36,0:11:47.76,Default,,0,0,0,,Жоғары жылдамдықты қозғалыс пен жоғары арпа діріліне байланысты кесу қабілеті және т.б.
Dialogue: 0,0:11:48.00,0:11:49.84,Default,,0,0,0,,Ол ерекше күш көрсетеді, бірақ
Dialogue: 0,0:11:51.12,0:11:54.96,Default,,0,0,0,,Негізгі пән қару емес, мақсаты басқа нәрсе.
Dialogue: 0,0:11:56.64,0:11:57.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:58.08,0:12:01.72,Default,,0,0,0,,Әдетте мұндай қалыптан тыс гендері бар адамдар болады
Dialogue: 0,0:12:02.12,0:12:07.88,Default,,0,0,0,,Олар әдетте туғаннан кейін көп ұзамай өледі немесе тек бір ұрпаққа жетеді.
Dialogue: 0,0:12:08.28,0:12:11.76,Default,,0,0,0,,Қоршаған ортаға сәйкес көбею қабілеті
Dialogue: 0,0:12:13.88,0:12:15.72,Default,,0,0,0,,Оның ешбір қатесі жоқ.
Dialogue: 0,0:12:16.28,0:12:23.12,Default,,0,0,0,,Және олар қарапайым адамдарға қарағанда басқа жолмен көбейе алады.
Dialogue: 0,0:12:23.64,0:12:25.00,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:12:34.00,0:12:37.44,Default,,0,0,0,,Оның гендері адамға сол «қолдар» арқылы беріледі.
Dialogue: 0,0:12:37.56,0:12:39.68,Default,,0,0,0,,А, онда бұл. . ?
Dialogue: 0,0:12:39.68,0:12:39.69,Default,,0,0,0,,Ол адамзатты дамыту үшін бар барлық адамдарды жояды.
Dialogue: 0,0:12:39.69,0:12:45.92,Default,,0,0,0,,Ол адамзатты дамыту үшін бар барлық адамдарды жояды.
Dialogue: 0,0:12:56.32,0:12:57.65,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:12:58.64,0:13:01.32,Default,,0,0,0,,Жарайды, мен оны көргім келеді.
Dialogue: 0,0:13:04.92,0:13:06.96,Default,,0,0,0,,It looks like your fever has gone down.
Dialogue: 0,0:13:07.56,0:13:09.72,Default,,0,0,0,,Нюу Нюу?
Dialogue: 0,0:13:16.08,0:13:16.84,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:13:17.32,0:13:19.04,Default,,0,0,0,,Сіз мені киіндірдіңіз
Dialogue: 0,0:13:20.72,0:13:22.56,Default,,0,0,0,,Сонда Ню-чан не істейді?
Dialogue: 0,0:13:22.92,0:13:24.33,Default,,0,0,0,,Өйткені, бұл полиция. . .
Dialogue: 0,0:13:24.36,0:13:25.72,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:13:26.04,0:13:26.72,Default,,0,0,0,,Кота?
Dialogue: 0,0:13:26.92,0:13:29.49,Default,,0,0,0,,Жоқ, мен онымен айналыса алмаймын.
Dialogue: 0,0:13:29.56,0:13:33.72,Default,,0,0,0,,Егер Ню осында қалғысы келсе, оны күштеп шығармаңыз.
Dialogue: 0,0:13:33.96,0:13:35.20,Default,,0,0,0,,Неліктен деп ойлайсыңдар?
Dialogue: 0,0:13:35.84,0:13:36.44,Default,,0,0,0,,Иә
Dialogue: 0,0:13:36.56,0:13:38.72,Default,,0,0,0,,Бірақ айтайын, бұл біртүрлі сезім. . .
Dialogue: 0,0:13:40.44,0:13:43.36,Default,,0,0,0,,You know, I have a lot of thoughts.
Dialogue: 0,0:13:44.12,0:13:48.48,Default,,0,0,0,,Неге десеңіз, Ню мен Коутаның жалғыз тұрғаны жақсы емес деп ойлаймын.
Dialogue: 0,0:13:49.96,0:13:51.48,Default,,0,0,0,,Міне, солай. . .
Dialogue: 0,0:13:52.12,0:13:54.36,Default,,0,0,0,,Сондықтан мен де сонда тұруды шештім.
Dialogue: 0,0:13:54.88,0:13:55.76,Default,,0,0,0,,Мұнда
Dialogue: 0,0:13:56.00,0:13:56.88,Default,,0,0,0,,Иә~
Dialogue: 0,0:13:58.24,0:14:00.00,Default,,0,0,0,,Бөлмелер өте көп.
Dialogue: 0,0:14:08.40,0:14:10.52,Default,,0,0,0,,Аа, мен мұндай киімді бірінші рет киіп отырмын.
Dialogue: 0,0:14:11.12,0:14:12.64,Default,,0,0,0,,Әке сізге жақсы көрінеді.
Dialogue: 0,0:14:13.28,0:14:14.88,Default,,0,0,0,,Nana, I asked for it.
Dialogue: 0,0:14:17.88,0:14:20.40,Default,,0,0,0,,Nana, I'll do my best for daddy.
Dialogue: 0,0:14:20.52,0:14:23.49,Default,,0,0,0,,Жұмысымды жақсы орындай алсам, басымнан сипап қойыңыз.
Dialogue: 0,0:14:23.76,0:14:26.92,Default,,0,0,0,,А, мүмкін емес, бірақ қаласаң қашып кете аласың.
Dialogue: 0,0:14:27.12,0:14:29.69,Default,,0,0,0,,Бірақ қайтып оралуыңызды өтінемін.
Dialogue: 0,0:14:29.92,0:14:30.40,Default,,0,0,0,,Ммм
Dialogue: 0,0:14:30.80,0:14:31.80,Default,,0,0,0,,Сәлем әке
Dialogue: 0,0:14:32.48,0:14:34.05,Default,,0,0,0,,Нана, сенен бір өтінішім бар.
Dialogue: 0,0:14:36.00,0:14:36.80,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:14:45.16,0:14:50.45,Default,,0,0,0,,Егер Люси әлі де Камакурада болса, ол оны іздеуі керек.
Dialogue: 0,0:14:51.32,0:14:54.44,Default,,0,0,0,,Бірақ Люсиге қарсы. . . №7 жеңімпаз. . .
Dialogue: 0,0:14:55.08,0:14:59.21,Default,,0,0,0,,Мақсатсыз көшіп жүрген өлгендердің санын көбейте алмаймыз.
Dialogue: 0,0:15:05.68,0:15:07.80,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:15:13.56,0:15:15.96,Default,,0,0,0,,Yuka is rough with people.
Dialogue: 0,0:15:15.96,0:15:17.72,Default,,0,0,0,,Бұл жерде қараңғы болса да
Dialogue: 0,0:15:19.40,0:15:23.08,Default,,0,0,0,,Бірақ қызбен тұру аздап қызық болуы мүмкін.
Dialogue: 0,0:15:23.96,0:15:24.84,Default,,0,0,0,,Кота
Dialogue: 0,0:15:26.92,0:15:28.60,Default,,0,0,0,,I don't have any strange expectations.
Dialogue: 0,0:15:29.48,0:15:30.97,Default,,0,0,0,,Жоқ, ондай ештеңе жоқ.
Dialogue: 0,0:15:31.24,0:15:32.48,Default,,0,0,0,,Жаңа~ Жаңа~
Dialogue: 0,0:15:33.60,0:15:36.12,Default,,0,0,0,,Will Nyu-chan help me clean too?
Dialogue: 0,0:15:37.36,0:15:38.24,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:15:38.36,0:15:39.36,Default,,0,0,0,,Ал, сәл күте тұрыңыз.
Dialogue: 0,0:15:39.60,0:15:40.84,Default,,0,0,0,,Мен шүберек алып келейін.
Dialogue: 0,0:15:47.48,0:15:50.45,Default,,0,0,0,,Хм, Юка қазір шүберек әкеледі.
Dialogue: 0,0:15:53.24,0:15:54.12,Default,,0,0,0,,Жаңа!
Dialogue: 0,0:15:54.56,0:15:56.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:59.64,0:16:00.88,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:16:02.52,0:16:04.09,Default,,0,0,0,,Не?
Dialogue: 0,0:16:07.24,0:16:08.52,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:16:10.28,0:16:10.88,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:16:11.24,0:16:14.13,Default,,0,0,0,,Жаңа ~ Жаңа ~ Жаңа ~
Dialogue: 0,0:16:15.36,0:16:16.72,Default,,0,0,0,,Сіз оны жылжыта аласыз ба?
Dialogue: 0,0:16:18.36,0:16:19.40,Default,,0,0,0,,Жаңа ~ Жаңа ~
Dialogue: 0,0:16:19.88,0:16:22.61,Default,,0,0,0,,Біртүрлі нәрсені есіме түсіруге не себеп болды?
Dialogue: 0,0:16:23.12,0:16:24.00,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:16:24.92,0:16:27.76,Default,,0,0,0,,Бұл махаббаттың қандай түрі?
Dialogue: 0,0:16:28.36,0:16:29.16,Default,,0,0,0,,Аоса
Dialogue: 0,0:16:29.28,0:16:30.88,Default,,0,0,0,,Бұл Ньюга. . .
Dialogue: 0,0:16:36.16,0:16:37.24,Default,,0,0,0,,Мен дүкенге барамын
Dialogue: 0,0:16:39.12,0:16:41.69,Default,,0,0,0,,А, мен оның тең болғанына қуаныштымын.
Dialogue: 0,0:16:42.28,0:16:44.44,Default,,0,0,0,,Ню-чанға оғаш ештеңе жасама
Dialogue: 0,0:16:44.56,0:16:45.36,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:51.88,0:16:54.53,Default,,0,0,0,,Шынымен. . . Тіпті осы жерде
Dialogue: 0,0:17:02.80,0:17:04.08,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:07.76,0:17:08.40,Default,,0,0,0,,Бұл. . .
Dialogue: 0,0:17:09.48,0:17:09.92,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:17:09.92,0:17:11.12,Default,,0,0,0,,Бұл үшін кешіріңіз.
Dialogue: 0,0:17:13.64,0:17:14.64,Default,,0,0,0,,Жақсы
Dialogue: 0,0:17:14.88,0:17:16.40,Default,,0,0,0,,Нені ұмыттыңыз?
Dialogue: 0,0:17:17.76,0:17:18.28,Default,,0,0,0,,О~
Dialogue: 0,0:17:18.80,0:17:21.80,Default,,0,0,0,,Қолшатырды ал
Dialogue: 0,0:17:22.36,0:17:24.88,Default,,0,0,0,,Онда осы дүкеннің аты жазылған.
Dialogue: 0,0:17:25.80,0:17:27.92,Default,,0,0,0,,Аа, жолыңыздан шыққаныңызға рахмет.
Dialogue: 0,0:17:28.40,0:17:31.16,Default,,0,0,0,,Өткен түні мен Юихамаға құладым.
Dialogue: 0,0:17:31.92,0:17:33.00,Default,,0,0,0,,Келесі түн?
Dialogue: 0,0:17:33.32,0:17:34.32,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:17:34.32,0:17:35.76,Default,,0,0,0,,Ол кезде кім болған жоқ?
Dialogue: 0,0:17:36.04,0:17:39.04,Default,,0,0,0,,Әлгі солдатты біреу көргісі келеді. . .
Dialogue: 0,0:17:40.28,0:17:43.32,Default,,0,0,0,,Толығырақ айтып бере аласыз ба?
Dialogue: 0,0:17:43.92,0:17:44.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:54.96,0:17:55.52,Default,,0,0,0,,Кім?
Dialogue: 0,0:18:00.20,0:18:01.32,Default,,0,0,0,,Ол өсуде.
Dialogue: 0,0:18:01.80,0:18:02.44,Default,,0,0,0,,Юка
Dialogue: 0,0:18:02.72,0:18:04.84,Default,,0,0,0,,Сол түнді бір бала қарап тұрды.
Dialogue: 0,0:18:05.40,0:18:06.32,Default,,0,0,0,,Сол түн?
Dialogue: 0,0:18:06.92,0:18:08.16,Default,,0,0,0,,Жаңа ~ Жаңа ~ Жаңа ~
Dialogue: 0,0:18:08.56,0:18:09.84,Default,,0,0,0,,Жаңа ~ Жаңа ~ Жаңа ~
Dialogue: 0,0:18:10.20,0:18:10.56,Default,,0,0,0,,Жаңа!
Dialogue: 0,0:18:19.96,0:18:21.24,Default,,0,0,0,,Мен ойлағандай.
Dialogue: 0,0:18:21.56,0:18:24.24,Default,,0,0,0,,Солдаттар туралы сырқаттанған тергеуші де білетін.
Dialogue: 0,0:18:24.96,0:18:26.48,Default,,0,0,0,,Неліктен бізге солдаттар шабуыл жасады?
Dialogue: 0,0:18:27.44,0:18:29.24,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:18:29.24,0:18:30.24,Default,,0,0,0,,Жаңа!
Dialogue: 0,0:18:31.60,0:18:32.60,Default,,0,0,0,,А, не?
Dialogue: 0,0:18:37.32,0:18:39.32,Default,,0,0,0,,Әй, су басқан жоқ па?
Dialogue: 0,0:18:40.00,0:18:42.36,Default,,0,0,0,,Не болды? Оны қайда түсірдің?
Dialogue: 0,0:18:42.64,0:18:43.44,Default,,0,0,0,,Не?
Dialogue: 0,0:18:44.76,0:18:45.76,Default,,0,0,0,,Мені қорқытпа
Dialogue: 0,0:18:46.84,0:18:47.64,Default,,0,0,0,,Бұл ән
Dialogue: 0,0:18:48.76,0:18:50.12,Default,,0,0,0,,А, мен ұмытып қалдым.
Dialogue: 0,0:18:52.84,0:18:53.76,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:19:02.00,0:19:02.72,Default,,0,0,0,,Кота
Dialogue: 0,0:19:07.52,0:19:08.64,Default,,0,0,0,,Сәлем, жаңа
Dialogue: 0,0:19:10.52,0:19:12.12,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:19:12.72,0:19:13.52,Default,,0,0,0,,Мұны түсініңіз
Dialogue: 0,0:19:14.92,0:19:15.72,Default,,0,0,0,,Есіңізде ме?
Dialogue: 0,0:19:16.88,0:19:18.53,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:20.80,0:19:22.40,Default,,0,0,0,,Әдемі ән екен.
Dialogue: 0,0:19:24.68,0:19:26.12,Default,,0,0,0,,Көптен бері саған берейін деп жүр едім.
Dialogue: 0,0:19:26.40,0:19:27.00,Default,,0,0,0,,Мен үшін?
Dialogue: 0,0:19:27.28,0:19:29.56,Default,,0,0,0,,Кота үйге бірдеңе қалдырды.
Dialogue: 0,0:19:30.36,0:19:31.56,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:19:31.80,0:19:32.64,Default,,0,0,0,,мені тістемек болғанда Розваал мені құтқарды…
Dialogue: 0,0:19:34.04,0:19:36.64,Default,,0,0,0,,Хмм, жоқ, әйтеуір.
Dialogue: 0,0:19:45.92,0:19:48.08,Default,,0,0,0,,Бұл ит сенікі ме?
Dialogue: 0,0:19:48.28,0:19:50.93,Default,,0,0,0,,иә, менің достарым
Dialogue: 0,0:19:51.56,0:19:52.44,Default,,0,0,0,,Достар?
Dialogue: 0,0:19:52.64,0:19:55.29,Default,,0,0,0,,А, мен оны сатып алмаймын.
Dialogue: 0,0:19:55.44,0:19:58.09,Default,,0,0,0,,Біз әрқашан біргеміз, сондықтан біз доспыз.
Dialogue: 0,0:20:11.32,0:20:13.56,Default,,0,0,0,,Мен Ню-чанның шыққанын көргім келеді.
Dialogue: 0,0:20:13.84,0:20:16.96,Default,,0,0,0,,Мен кеше ғана жағажайдан оралдым, сондықтан бәрі жақсы деп ойлаймын.
Dialogue: 0,0:20:17.48,0:20:18.72,Default,,0,0,0,,Мүйіздер жасырылған
Dialogue: 0,0:20:18.96,0:20:19.56,Default,,0,0,0,,Бұрыш?
Dialogue: 0,0:20:19.68,0:20:21.36,Default,,0,0,0,,Иә, бұл ештеңе емес.
Dialogue: 0,0:20:27.96,0:20:29.96,Default,,0,0,0,,Олай болса, кешіріңіз.
Dialogue: 0,0:20:31.12,0:20:32.08,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:20:32.84,0:20:34.00,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:20:35.60,0:20:37.56,Default,,0,0,0,,Бұл Маю.
Dialogue: 0,0:20:37.72,0:20:38.60,Default,,0,0,0,,Қаласаңыз
Dialogue: 0,0:20:38.60,0:20:41.88,Default,,0,0,0,,Маған мекен-жайыңызды және байланыс ақпаратыңызды айта аласыз ба?
Dialogue: 0,0:20:42.36,0:20:45.01,Default,,0,0,0,,Мүмкін сіз сұрағыңыз келетін тағы бір нәрсе бар шығар.
Dialogue: 0,0:20:45.36,0:20:48.88,Default,,0,0,0,,Бұл мен. . .
Dialogue: 0,0:20:53.12,0:20:54.24,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:59.00,0:21:01.97,Default,,0,0,0,,Маған ұнамайды, ұнамайды, ит. .
Dialogue: 0,0:21:03.08,0:21:05.60,Default,,0,0,0,,One dog One dog
Dialogue: 0,0:21:06.24,0:21:08.28,Default,,0,0,0,,One dog One dog
Dialogue: 0,0:21:10.64,0:21:15.00,Default,,0,0,0,,Бір ит Бір ит Жақсы
Dialogue: 0,0:21:15.24,0:21:17.92,Default,,0,0,0,,Мені ит тастап кетті деп ойладым.
Dialogue: 0,0:21:21.16,0:21:24.80,Default,,0,0,0,,Иттер мені тастамайды, солай ма?
Dialogue: 0,0:21:29.68,0:21:31.40,Default,,0,0,0,,New, it's late.
Dialogue: 0,0:21:40.16,0:21:42.68,Default,,0,0,0,,Келіп көрейін бе?
Dialogue: 0,0:21:45.00,0:21:46.52,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:47.40,0:21:48.20,Default,,0,0,0,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,0:21:48.44,0:21:48.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:49.32,0:21:54.69,Default,,0,0,0,,Мен келесі жолы келгенде оны қайтарып берейін деп жүр едім.
Dialogue: 0,0:21:55.28,0:21:57.88,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:21:58.08,0:21:59.44,Default,,0,0,0,,More than that?
Dialogue: 0,0:22:00.20,0:22:03.64,Default,,0,0,0,,Everyone forgot.
Dialogue: 0,0:22:03.96,0:22:04.56,Default,,0,0,0,,Әй?
Dialogue: 0,0:22:05.32,0:22:07.44,Default,,0,0,0,,Hey Kota
Dialogue: 0,0:22:07.56,0:22:08.56,Default,,0,0,0,,Не?
Dialogue: 0,0:22:08.92,0:22:12.60,Default,,0,0,0,,Ішіп, төсімді көргім келеді.
Dialogue: 0,0:22:12.92,0:22:13.72,Default,,0,0,0,,Мен – Шығыс Одақтың Элькияға тағайындаған екінші елшісі Ино Хацусе.
Dialogue: 0,0:22:19.08,0:22:20.68,Default,,0,0,0,,Менің әкемнен өтінішім бар.
Dialogue: 0,0:22:21.16,0:22:23.48,Default,,0,0,0,,Әке, мына жіпті маған берші.
Dialogue: 0,0:22:24.36,0:22:26.68,Default,,0,0,0,,Нана, мен мұны әрқашан қалағанмын.
Dialogue: 0,0:22:29.48,0:22:31.84,Default,,0,0,0,,Yay thank you
Dialogue: 0,0:22:32.24,0:22:33.84,Default,,0,0,0,,Нана, мен бар күшімді саламын.
Dialogue: 0,0:22:46.44,0:22:47.24,Default,,0,0,0,,Бұл
Dialogue: 0,0:22:48.84,0:22:52.89,Default,,0,0,0,,Менің келетінімді анық білдің, солай ма?
Dialogue: 0,0:22:54.36,0:22:58.00,Default,,0,0,0,,Мен сені үйге апарамын
Dialogue: 0,0:24:35.96,0:24:36.92,Default,,0,0,0,,Лестер, Джованни және Миками
Dialogue: 0,0:24:37.12,0:24:38.92,Default,,0,0,0,,Себеп те, мән де, қажеттілік те болған жоқ.
Dialogue: 0,0:24:41.08,0:24:44.72,Default,,0,0,0,,Тістеу мен жеудің және түрдің еріксіздігі бар.
Dialogue: 0,0:24:46.68,0:24:50.12,Default,,0,0,0,,Тыныштық жанға демалыс орнында өрнегі
Dialogue: 0,0:24:50.68,0:24:53.60,Default,,0,0,0,,Көз жасында бейнеленген жарқын ән
Dialogue: 0,0:24:55.00,0:24:57.00,Default,,0,0,0,,Келесі жолы Эльфен «4-эпизодты» өтірік айтты
Dialogue: 0,0:24:57.76,0:24:58.64,Default,,0,0,0,,Touching
Dialogue: 0,0:25:00.14,0:25:06.14,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory