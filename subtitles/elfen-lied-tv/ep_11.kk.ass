Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.77,0:00:18.16,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.16,0:00:27.29,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.29,0:00:38.55,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.55,0:00:49.15,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.15,0:01:02.24,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.62,0:01:13.71,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.71,0:01:28.31,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:31.04,0:01:35.05,Default,,0,0,0,,Мен олардың мұндай әсіреленген ыдысқа қашан және не үшін түскенін білемін.
Dialogue: 0,0:01:36.24,0:01:39.85,Default,,0,0,0,,35 санының векторлық белсенділік диапазоны 11 метр
Dialogue: 0,0:01:42.24,0:01:44.85,Default,,0,0,0,,35 саны болуы мүмкін
Dialogue: 0,0:01:44.84,0:01:46.25,Default,,0,0,0,,Люсиді ұрыңыз
Dialogue: 0,0:01:46.80,0:01:50.96,Default,,0,0,0,,Бірақ бұл жігіт адамды инстинктивті түрде өлтіретін құбыжық.
Dialogue: 0,0:01:52.12,0:01:54.01,Default,,0,0,0,,Адамдарды ынтымақтастыққа қалай тартуға болады
Dialogue: 0,0:01:54.96,0:01:58.20,Default,,0,0,0,,Оның үстіне бостандыққа шыққан соң оны қалай ұстайсың?
Dialogue: 0,0:02:00.76,0:02:02.89,Default,,0,0,0,,Сіз отырып қайыр сұрауды жоспарлап отырсыз ба?
Dialogue: 0,0:02:04.08,0:02:05.53,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:02:06.88,0:02:07.77,Default,,0,0,0,,Сіз?
Dialogue: 0,0:02:10.04,0:02:11.93,Default,,0,0,0,,Иә, мен Саитомын, алмастырушы ата-ана ретінде әрекет етемін.
Dialogue: 0,0:02:17.44,0:02:19.68,Default,,0,0,0,,Мониторда ақау жоқ, бірақ
Dialogue: 0,0:02:20.44,0:02:22.92,Default,,0,0,0,,Мүмкін мен аяғымды көтере алмаймын.
Dialogue: 0,0:02:23.92,0:02:27.77,Default,,0,0,0,,Мен туылғаннан бері осында оқшауланғанмын.
Dialogue: 0,0:02:29.16,0:02:31.45,Default,,0,0,0,,Мм, шынымен де осы жерден. . .
Dialogue: 0,0:02:31.92,0:02:32.65,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:02:33.96,0:02:38.09,Default,,0,0,0,,Сайтоның бес жыл ішінде тек 35 санына тағайындалғаны рас.
Dialogue: 0,0:02:38.64,0:02:41.45,Default,,0,0,0,,Мен күн сайын сөйлеушімен сөйлесемін.
Dialogue: 0,0:02:43.32,0:02:44.96,Default,,0,0,0,,Мен солай айтсам
Dialogue: 0,0:02:44.96,0:02:44.97,Default,,0,0,0,,Тыңдайсыңдар деген үміттемін.
Dialogue: 0,0:02:44.97,0:02:46.33,Default,,0,0,0,,Тыңдайсыңдар деген үміттемін.
Dialogue: 0,0:02:46.96,0:02:49.93,Default,,0,0,0,,Ол мені ана деп атайды.
Dialogue: 0,0:02:51.68,0:02:53.09,Default,,0,0,0,,Біртүрлі сезіледі.
Dialogue: 0,0:02:53.48,0:02:56.09,Default,,0,0,0,,Жүзіңді көрмесем де
Dialogue: 0,0:02:56.56,0:02:58.69,Default,,0,0,0,,Бөлінген қызыммен көңіл-күйім жақсы сияқты.
Dialogue: 0,0:02:59.48,0:03:00.21,Default,,0,0,0,,Дайын бол
Dialogue: 0,0:03:00.48,0:03:00.97,Default,,0,0,0,,Иә
Dialogue: 0,0:03:02.44,0:03:05.05,Default,,0,0,0,,Сіз оны сендіруге тырысасыз ба?
Dialogue: 0,0:03:05.92,0:03:07.84,Default,,0,0,0,,Ең күшті Диклониус шығар
Dialogue: 0,0:03:08.32,0:03:10.32,Default,,0,0,0,,35 саны әлі бала.
Dialogue: 0,0:03:11.32,0:03:14.45,Default,,0,0,0,,Ол менің ата-анам және жалғыз адам
Dialogue: 0,0:03:15.88,0:03:19.36,Default,,0,0,0,,Мен де 35 санының оны жоғалтуына жол бере алмаймын.
Dialogue: 0,0:03:20.48,0:03:23.85,Default,,0,0,0,,Бірақ оны тыңдау кепілдігі
Dialogue: 0,0:03:24.20,0:03:26.01,Default,,0,0,0,,Егер мені тыңдамасаң
Dialogue: 0,0:03:26.24,0:03:27.37,Default,,0,0,0,,Тек мені қорқыт.
Dialogue: 0,0:03:28.76,0:03:29.84,Default,,0,0,0,,35 саны
Dialogue: 0,0:03:30.36,0:03:34.13,Default,,0,0,0,,Сіз дүниеге келген бойда денеңізге бомба қондырылды.
Dialogue: 0,0:03:34.40,0:03:36.40,Default,,0,0,0,,Ба. . . Мен оны бірінші рет естідім
Dialogue: 0,0:03:36.96,0:03:38.25,Default,,0,0,0,,Неліктен мұндай еліктеу керек?
Dialogue: 0,0:03:39.00,0:03:40.37,Default,,0,0,0,,Қандай себеп болса да
Dialogue: 0,0:03:40.36,0:03:43.01,Default,,0,0,0,,Бұл сөзсіз қазір пайдалы.
Dialogue: 0,0:03:44.40,0:03:46.64,Default,,0,0,0,,35 санының айтқанын тыңдамасаңыз
Dialogue: 0,0:03:47.76,0:03:49.60,Default,,0,0,0,,Жару арқылы жою
Dialogue: 0,0:03:50.72,0:03:51.40,Default,,0,0,0,,Бомба?
Dialogue: 0,0:03:52.16,0:03:53.65,Default,,0,0,0,,Директор осылай деді
Dialogue: 0,0:03:54.28,0:03:56.12,Default,,0,0,0,,Курама түсінеді.
Dialogue: 0,0:03:56.88,0:04:01.01,Default,,0,0,0,,Қызының адамға зиянын тигізбеу үшін әкенің міндетінен.
Dialogue: 0,0:04:03.60,0:04:05.24,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:04:05.24,0:04:05.25,Default,,0,0,0,,Ол маған ешқашан опасыздық жасамас үшін шынжыр болды.
Dialogue: 0,0:04:05.25,0:04:08.77,Default,,0,0,0,,Ол маған ешқашан опасыздық жасамас үшін шынжыр болды.
Dialogue: 0,0:04:09.56,0:04:11.05,Default,,0,0,0,,Екі қолда да даңқ; жеңіс – біздің әніміз
Dialogue: 0,0:04:11.88,0:04:15.12,Default,,0,0,0,,Ол маған бағынбай, Гилперитті қашып жіберді.
Dialogue: 0,0:04:16.84,0:04:18.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:18.24,0:04:21.72,Default,,0,0,0,,Олар бюджетті барынша тиімді пайдалану үшін жұмыс істесін.
Dialogue: 0,0:04:22.40,0:04:24.53,Default,,0,0,0,,Бөлшектерді шығару
Dialogue: 0,0:04:41.12,0:04:43.01,Default,,0,0,0,,Марико-чан, қош келдіңіз
Dialogue: 0,0:04:43.92,0:04:45.29,Default,,0,0,0,,Шығу уақыты жақындап қалды.
Dialogue: 0,0:04:55.00,0:04:55.81,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:05:03.00,0:05:03.81,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:05:16.80,0:05:18.56,Default,,0,0,0,,Сізге жақындауға рұқсат бергенім дұрыс па?
Dialogue: 0,0:05:19.16,0:05:21.69,Default,,0,0,0,,Сіз сигнал жіберуге дайындалып жатырсыз ба?
Dialogue: 0,0:05:26.72,0:05:29.33,Default,,0,0,0,,Бейшара, сондай жұқа.
Dialogue: 0,0:05:38.32,0:05:40.97,Default,,0,0,0,,Сіз мені түсінесіз бе?
Dialogue: 0,0:05:42.72,0:05:43.96,Default,,0,0,0,,О. . . ана?
Dialogue: 0,0:05:49.44,0:05:50.04,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:56.08,0:05:56.84,Default,,0,0,0,,Ширакава
Dialogue: 0,0:06:06.00,0:06:07.13,Default,,0,0,0,,Бомба туралы сигнал
Dialogue: 0,0:06:07.12,0:06:07.88,Default,,0,0,0,,Ерте
Dialogue: 0,0:06:10.48,0:06:12.24,Default,,0,0,0,,Сондықтан мен ештеңе айтпаймын
Dialogue: 0,0:06:14.64,0:06:16.72,Default,,0,0,0,,Ширакава Қашайық
Dialogue: 0,0:06:44.28,0:06:46.52,Default,,0,0,0,,Ауырған кезде асығыңыз
Dialogue: 0,0:06:46.52,0:06:47.93,Default,,0,0,0,,Векторларды қолдануға болмайды
Dialogue: 0,0:06:53.64,0:06:54.77,Default,,0,0,0,,Түсіндіңіз.
Dialogue: 0,0:06:55.04,0:06:57.25,Default,,0,0,0,,Сіз бізді тыңдауыңыз керек
Dialogue: 0,0:06:57.56,0:06:59.05,Default,,0,0,0,,Сіз одан бетер ауырасыз.
Dialogue: 0,0:07:07.44,0:07:09.41,Default,,0,0,0,,Балмұздақ дәмді
Dialogue: 0,0:07:09.40,0:07:11.32,Default,,0,0,0,,Неге, Маю, мен тоқтай алмаймын.
Dialogue: 0,0:07:12.56,0:07:14.69,Default,,0,0,0,,Кенеттен тамақ ішу
Dialogue: 0,0:07:14.68,0:07:15.76,Default,,0,0,0,,Итатата
Dialogue: 0,0:07:16.32,0:07:18.93,Default,,0,0,0,,Басым ауырып тұр ғой деймін.
Dialogue: 0,0:07:19.92,0:07:21.68,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:25.32,0:07:27.85,Default,,0,0,0,,О, мен оны жыртып алдым.
Dialogue: 0,0:07:28.96,0:07:29.64,Default,,0,0,0,,Жаңа
Dialogue: 0,0:07:32.56,0:07:36.09,Default,,0,0,0,,Нана, бір сәт.
Dialogue: 0,0:07:39.32,0:07:42.09,Default,,0,0,0,,Ал, бұл қайда?
Dialogue: 0,0:07:45.56,0:07:47.45,Default,,0,0,0,,Ол қалыпты жағдайға орала ма?
Dialogue: 0,0:07:58.92,0:08:01.08,Default,,0,0,0,,Менен сұрасаң да, мен ештеңе айтпаймын.
Dialogue: 0,0:08:04.36,0:08:06.36,Default,,0,0,0,,Ню-чанмен қандай қарым-қатынастасың?
Dialogue: 0,0:08:06.68,0:08:07.57,Default,,0,0,0,,Бұл туралы
Dialogue: 0,0:08:10.20,0:08:12.49,Default,,0,0,0,,Егер сіз сөйлескіңіз келмесе, өзіңізді сұрауға мәжбүрлемеңіз.
Dialogue: 0,0:08:13.76,0:08:16.97,Default,,0,0,0,,Бірақ сіз мені қанша қонақ ретінде қабылдасаңыз да,
Dialogue: 0,0:08:16.96,0:08:17.64,Default,,0,0,0,,Мен қиындыққа тап болдым
Dialogue: 0,0:08:18.08,0:08:18.65,Default,,0,0,0,,Кота
Dialogue: 0,0:08:22.64,0:08:24.01,Default,,0,0,0,,Ә? Жоқ, мен ештеңе істеген жоқпын…
Dialogue: 0,0:08:25.88,0:08:27.61,Default,,0,0,0,,Бірден осылай
Dialogue: 0,0:08:28.00,0:08:29.76,Default,,0,0,0,,Маған үй жұмыстарына көмек керек.
Dialogue: 0,0:08:30.20,0:08:31.20,Default,,0,0,0,,Оны мұнда қоюға болмайды.
Dialogue: 0,0:08:32.68,0:08:34.57,Default,,0,0,0,,Мұнда барлығы осылай істейді.
Dialogue: 0,0:08:35.20,0:08:36.17,Default,,0,0,0,,Мен және Юка
Dialogue: 0,0:08:36.64,0:08:37.77,Default,,0,0,0,,Тіпті Маю-чан
Dialogue: 0,0:08:38.64,0:08:41.04,Default,,0,0,0,,Нана, мен осында тұра аламын ба?
Dialogue: 0,0:08:42.56,0:08:43.97,Default,,0,0,0,,Сіз қайда баруды жоспарладыңыз?
Dialogue: 0,0:08:45.40,0:08:46.21,Default,,0,0,0,,Өйткені
Dialogue: 0,0:08:47.56,0:08:50.09,Default,,0,0,0,,Әйтеуір қалыпты жағдайға оралды.
Dialogue: 0,0:08:54.32,0:08:57.29,Default,,0,0,0,,Жаңа ма? Жаңа
Dialogue: 0,0:09:00.44,0:09:01.68,Default,,0,0,0,,Ах. . Бұл
Dialogue: 0,0:09:01.68,0:09:03.68,Default,,0,0,0,,Себебі мен қорықтым.
Dialogue: 0,0:09:03.84,0:09:07.61,Default,,0,0,0,,Бұдан былай жалғыз өзім не істерімді білмеймін.
Dialogue: 0,0:09:07.84,0:09:10.61,Default,,0,0,0,,Мен әрқашан қорқатынмын
Dialogue: 0,0:09:11.16,0:09:12.05,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:09:12.48,0:09:13.48,Default,,0,0,0,,Сәлем Маю-чан
Dialogue: 0,0:09:14.04,0:09:14.61,Default,,0,0,0,,Иә
Dialogue: 0,0:09:15.24,0:09:17.05,Default,,0,0,0,,Егер бұл бала жасай алатын бірдеңе болса ше?
Dialogue: 0,0:09:17.32,0:09:18.32,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:09:19.48,0:09:20.05,Default,,0,0,0,,Иә
Dialogue: 0,0:09:24.80,0:09:25.69,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:09:41.76,0:09:43.00,Default,,0,0,0,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 0,0:09:43.60,0:09:46.60,Default,,0,0,0,,Сіз мына ыстық суға шомыласыз ба?
Dialogue: 0,0:09:47.12,0:09:48.36,Default,,0,0,0,,. . иә
Dialogue: 0,0:09:50.24,0:09:52.64,Default,,0,0,0,,Жоқ, ыстық су жақсы сезінеді.
Dialogue: 0,0:09:53.52,0:09:59.16,Default,,0,0,0,,Денеңіз кірленсе, оны сумен төгіп тастауға болады.
Dialogue: 0,0:09:59.64,0:10:00.48,Default,,0,0,0,,Шланг?
Dialogue: 0,0:10:03.52,0:10:04.17,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:10:04.28,0:10:06.60,Default,,0,0,0,,Маю Мен мұны бұрын айттым.
Dialogue: 0,0:10:07.40,0:10:11.29,Default,,0,0,0,,Бірақ мен білетін Ню-сан өте жақсы адам.
Dialogue: 0,0:10:11.76,0:10:14.16,Default,,0,0,0,,Бұл адам Люси-санға қайта оралды.
Dialogue: 0,0:10:14.16,0:10:15.29,Default,,0,0,0,,Бұл жағдайда
Dialogue: 0,0:10:18.40,0:10:20.77,Default,,0,0,0,,Мен сенің мәңгілік Ню-сан сияқты болғаныңды қалаймын.
Dialogue: 0,0:10:22.36,0:10:26.29,Default,,0,0,0,,Сонда Нана да осында бақытты өмір сүре алады.
Dialogue: 0,0:10:40.28,0:10:42.44,Default,,0,0,0,,Камакурада 7 саны көрінген сияқты.
Dialogue: 0,0:10:43.20,0:10:43.93,Default,,0,0,0,,"Бүгін түнде біз батырды құрметтейміз!!"
Dialogue: 0,0:10:45.28,0:10:46.81,Default,,0,0,0,,Кимоно және т.б. № 35.
Dialogue: 0,0:10:47.28,0:10:49.17,Default,,0,0,0,,Бомба өте тиімді болған сияқты.
Dialogue: 0,0:10:49.44,0:10:51.33,Default,,0,0,0,,Мен қазір тынышпын.
Dialogue: 0,0:10:52.44,0:10:54.68,Default,,0,0,0,,Директор Курамаға не болды?
Dialogue: 0,0:10:55.40,0:10:56.97,Default,,0,0,0,,Ол мүлдем көрінбейді.
Dialogue: 0,0:10:58.40,0:11:01.56,Default,,0,0,0,,35 нөмірі маған қалды.
Dialogue: 0,0:11:02.32,0:11:04.29,Default,,0,0,0,,Бірақ. . . Эй
Dialogue: 0,0:11:04.32,0:11:06.16,Default,,0,0,0,,Кеңсе меңгерушісіне есеп беру.
Dialogue: 0,0:11:06.72,0:11:09.04,Default,,0,0,0,,Өйткені бұл менің рөлім
Dialogue: 0,0:11:14.48,0:11:15.08,Default,,0,0,0,,Директор
Dialogue: 0,0:11:17.48,0:11:18.48,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:32.48,0:11:33.21,Default,,0,0,0,,Өткен түн
Dialogue: 0,0:11:33.84,0:11:36.56,Default,,0,0,0,,Иә, бұл шұғыл байланыс жиналысы болды.
Dialogue: 0,0:11:36.56,0:11:36.57,Default,,0,0,0,,Ол арнайы рейспен кетті.
Dialogue: 0,0:11:36.57,0:11:39.37,Default,,0,0,0,,Ол арнайы рейспен кетті.
Dialogue: 0,0:11:40.88,0:11:43.01,Default,,0,0,0,,Иә, жоқ па?
Dialogue: 0,0:11:46.72,0:11:47.24,Default,,0,0,0,,Ширакава мырза
Dialogue: 0,0:11:47.76,0:11:50.65,Default,,0,0,0,,No35 тасымалдауға дайын.
Dialogue: 0,0:11:51.08,0:11:52.24,Default,,0,0,0,,Кез келген уақытта тұрыңыз
Dialogue: 0,0:11:54.76,0:11:56.89,Default,,0,0,0,,Директор, сіз бе?
Dialogue: 0,0:12:01.24,0:12:02.89,Default,,0,0,0,,Осы жолы «өлім шеңберінен» аман қалған сияқтымын.
Dialogue: 0,0:12:03.40,0:12:06.37,Default,,0,0,0,,Жуынбағаныма неше күн болды?
Dialogue: 0,0:12:12.48,0:12:15.88,Default,,0,0,0,,Менің университетімде аспиранттарды қосқанда 3000-ға жуық студент бар.
Dialogue: 0,0:12:16.36,0:12:17.65,Default,,0,0,0,,Мен бір рет қана кездестірген бала
Dialogue: 0,0:12:17.64,0:12:19.17,Default,,0,0,0,,Тек оны іздеңіз.
Dialogue: 0,0:12:20.04,0:12:22.52,Default,,0,0,0,,Бұдан басқа, олар маған java-мен душ қабылдауға рұқсат бермейді.
Dialogue: 0,0:12:22.92,0:12:24.92,Default,,0,0,0,,Мен көптен бері іш киімімді ауыстырмадым.
Dialogue: 0,0:12:25.28,0:12:27.04,Default,,0,0,0,,Солай болатын сияқты.
Dialogue: 0,0:12:27.16,0:12:28.05,Default,,0,0,0,,Мүмкін емес. . .
Dialogue: 0,0:12:29.28,0:12:31.41,Default,,0,0,0,,Иә, иә, мен асығамын.
Dialogue: 0,0:12:41.92,0:12:42.65,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:43.12,0:12:44.33,Default,,0,0,0,,Бұл қолға не болды?
Dialogue: 0,0:12:45.12,0:12:48.41,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:12:49.20,0:12:51.68,Default,,0,0,0,,Қосылымдар мен басқару элементтері зақымдалмаса.
Dialogue: 0,0:12:52.92,0:12:55.16,Default,,0,0,0,,Мүмкін қарапайым бөлшектерді ауыстыру
Dialogue: 0,0:12:55.56,0:12:56.53,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:12:56.68,0:13:00.57,Default,,0,0,0,,Мен бөлшектерді ешкім білмей-ақ сатып аламын.
Dialogue: 0,0:13:01.40,0:13:03.32,Default,,0,0,0,,Сіз мені не істеуге мәжбүрлейсіз?
Dialogue: 0,0:13:04.96,0:13:07.33,Default,,0,0,0,,Диклониус, сізді жақын арада осында қарсы алатын адам.
Dialogue: 0,0:13:08.08,0:13:09.81,Default,,0,0,0,,Мені өлтіргеніңді қалаймын
Dialogue: 0,0:13:12.20,0:13:13.96,Default,,0,0,0,,Ма. . . Шынайы ма?
Dialogue: 0,0:13:15.60,0:13:17.20,Default,,0,0,0,,Вантаның фидері?
Dialogue: 0,0:13:17.44,0:13:18.08,Default,,0,0,0,,Иә
Dialogue: 0,0:13:18.32,0:13:20.60,Default,,0,0,0,,Нана, мен қазір ештеңе істей алмаймын.
Dialogue: 0,0:13:20.72,0:13:22.84,Default,,0,0,0,,Маю маған көп нәрсені үйретеді.
Dialogue: 0,0:13:23.68,0:13:25.44,Default,,0,0,0,,Иә, бұл жақсы деп ойлаймын.
Dialogue: 0,0:13:27.96,0:13:30.48,Default,,0,0,0,,Қолыңыздан келгенін жасаңыз.
Dialogue: 0,0:13:35.84,0:13:38.32,Default,,0,0,0,,Бұл бала кім?
Dialogue: 0,0:13:42.72,0:13:43.60,Default,,0,0,0,,Әпке
Dialogue: 0,0:13:44.36,0:13:45.60,Default,,0,0,0,,Ол қайтыс болды.
Dialogue: 0,0:13:47.00,0:13:48.20,Default,,0,0,0,,Сіз өлдіңіз бе?
Dialogue: 0,0:13:50.44,0:13:53.60,Default,,0,0,0,,Өлер алдында бір сұмдық айттың.
Dialogue: 0,0:13:54.64,0:13:56.13,Default,,0,0,0,,Мен жақсы есімде жоқ.
Dialogue: 0,0:13:56.48,0:13:58.00,Default,,0,0,0,,Мен әрқашан өкінетінмін
Dialogue: 0,0:13:59.40,0:14:01.97,Default,,0,0,0,,Кешірім сұрайын десем де, Кана кетіп қалды. . .
Dialogue: 0,0:14:02.88,0:14:07.72,Default,,0,0,0,,. . . Нана на на. . . Кота жылама
Dialogue: 0,0:14:10.24,0:14:11.12,Default,,0,0,0,,Жылама
Dialogue: 0,0:14:11.36,0:14:13.01,Default,,0,0,0,,Сондықтан жылама
Dialogue: 0,0:14:19.76,0:14:20.76,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:14:22.12,0:14:24.88,Default,,0,0,0,,Жоқ, бір сәтке солай болды.
Dialogue: 0,0:14:28.88,0:14:30.88,Default,,0,0,0,,Қайшымен не істейсің?
Dialogue: 0,0:14:36.24,0:14:37.81,Default,,0,0,0,,Ол қайда кетті?
Dialogue: 0,0:14:38.16,0:14:39.56,Default,,0,0,0,,Мен екінші қабатқа қараймын.
Dialogue: 0,0:14:39.56,0:14:39.57,Default,,0,0,0,,Нана да барады
Dialogue: 0,0:14:39.57,0:14:40.68,Default,,0,0,0,,Нана да барады
Dialogue: 0,0:14:40.68,0:14:42.04,Default,,0,0,0,,Ню-сан?
Dialogue: 0,0:14:54.52,0:14:55.32,Default,,0,0,0,,Жаңа
Dialogue: 0,0:14:58.16,0:14:58.92,Default,,0,0,0,,Жаңа
Dialogue: 0,0:14:59.64,0:15:00.97,Default,,0,0,0,,Жаңа емес
Dialogue: 0,0:15:08.20,0:15:12.20,Default,,0,0,0,,Канае кешіреді Кота кешірші кешір
Dialogue: 0,0:15:15.20,0:15:20.49,Default,,0,0,0,,Усан, мен сенің қарындасың болып, Кота-санды кешіремін.
Dialogue: 0,0:15:22.32,0:15:23.60,Default,,0,0,0,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 0,0:15:23.96,0:15:25.80,Default,,0,0,0,,Маю айтқандай.
Dialogue: 0,0:15:26.08,0:15:27.84,Default,,0,0,0,,Ол өте жақсы адам.
Dialogue: 0,0:15:29.20,0:15:30.72,Default,,0,0,0,,Кеттік
Dialogue: 0,0:15:32.36,0:15:35.68,Default,,0,0,0,,Кота мұңды түрі Маған ұнамайды
Dialogue: 0,0:15:38.12,0:15:39.92,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:42.36,0:15:44.68,Default,,0,0,0,,Сіз алғаш келген кезде
Dialogue: 0,0:15:46.32,0:15:47.08,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:47.48,0:15:49.08,Default,,0,0,0,,Сіз әлі де бұл туралы алаңдайсыз ба?
Dialogue: 0,0:15:49.84,0:15:53.24,Default,,0,0,0,,'Otoishi-kun' деп жазып қойыңызшы
Dialogue: 0,0:15:54.96,0:15:56.76,Default,,0,0,0,,Кешіріңіз. . . Айт
Dialogue: 0,0:16:01.64,0:16:03.36,Default,,0,0,0,,Мен оның не екенін білмеймін
Dialogue: 0,0:16:03.88,0:16:06.40,Default,,0,0,0,,Мен Ню туралы бұрыннан білемін.
Dialogue: 0,0:16:08.24,0:16:09.24,Default,,0,0,0,,Кота
Dialogue: 0,0:16:11.00,0:16:11.88,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:12.48,0:16:13.76,Default,,0,0,0,,Маған да Ню ұнайды
Dialogue: 0,0:16:24.72,0:16:28.40,Default,,0,0,0,,Сіз қоңырау шалып жатқан телефон сигнал жоқ жерде ме?
Dialogue: 0,0:16:29.80,0:16:31.48,Default,,0,0,0,,Директор Қайда?
Dialogue: 0,0:16:33.80,0:16:34.48,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:16:36.52,0:16:38.17,Default,,0,0,0,,Сіз мұны әлі істеп жатырсыз ба?
Dialogue: 0,0:16:38.40,0:16:40.92,Default,,0,0,0,,Бастапқыда ол бұзылған, сондықтан жақсы.
Dialogue: 0,0:16:42.04,0:16:43.92,Default,,0,0,0,,Юка, кеш болды.
Dialogue: 0,0:16:45.68,0:16:47.88,Default,,0,0,0,,Өйткені Нана тамаққа жауапты.
Dialogue: 0,0:16:48.24,0:16:49.57,Default,,0,0,0,,Көп тамақтаныңыз
Dialogue: 0,0:16:49.80,0:16:52.04,Default,,0,0,0,,А, жеткілікті.
Dialogue: 0,0:16:54.16,0:16:57.05,Default,,0,0,0,,Бұл тірі зат, солай емес пе?
Dialogue: 0,0:16:57.28,0:17:00.52,Default,,0,0,0,,Менің атым Ванта.
Dialogue: 0,0:17:02.08,0:17:03.20,Default,,0,0,0,,Сәлем Маю
Dialogue: 0,0:17:03.64,0:17:04.56,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:05.76,0:17:08.16,Default,,0,0,0,,Осындай нәрсе жақсы, солай емес пе?
Dialogue: 0,0:17:08.92,0:17:09.36,Default,,0,0,0,,Иә
Dialogue: 0,0:17:13.80,0:17:14.64,Default,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 0,0:17:16.36,0:17:19.17,Default,,0,0,0,,Басқа Люси болмағаны жақсы болар еді.
Dialogue: 0,0:17:19.80,0:17:21.56,Default,,0,0,0,,Сіз мені өлтіре аласыз, солай ма?
Dialogue: 0,0:17:23.28,0:17:24.40,Default,,0,0,0,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 0,0:17:25.68,0:17:27.56,Default,,0,0,0,,Мен Нананы өлтіруге келдім.
Dialogue: 0,0:17:29.04,0:17:31.64,Default,,0,0,0,,Диклониус Нана сияқты
Dialogue: 0,0:17:32.16,0:17:34.16,Default,,0,0,0,,зор зұлымдық
Dialogue: 0,0:17:35.04,0:17:36.64,Default,,0,0,0,,Жабық
Dialogue: 0,0:17:44.68,0:17:46.68,Default,,0,0,0,,Бұл бала екеніне күмән жоқ.
Dialogue: 0,0:17:51.44,0:17:53.92,Default,,0,0,0,,Нана-сан, сабыр етші.
Dialogue: 0,0:17:54.08,0:17:55.96,Default,,0,0,0,,Мен Нананы білетінмін.
Dialogue: 0,0:17:56.44,0:18:00.08,Default,,0,0,0,,Мен міндетті түрде келіп Нананы өлтіремін. Мүлдем.
Dialogue: 0,0:18:01.52,0:18:04.04,Default,,0,0,0,,Маю-чан, сен Юканың қайда екенін білмейсің бе?
Dialogue: 0,0:18:04.56,0:18:06.72,Default,,0,0,0,,Жоқ, мен ол туралы естіген жоқпын.
Dialogue: 0,0:18:07.28,0:18:10.09,Default,,0,0,0,,Ол кеспе алатынын айтты.
Dialogue: 0,0:18:10.96,0:18:12.56,Default,,0,0,0,,тым кеш.
Dialogue: 0,0:18:12.96,0:18:14.37,Default,,0,0,0,,Бұл біреу ме?
Dialogue: 0,0:18:14.96,0:18:16.84,Default,,0,0,0,,Бұл мен және Юканың сүйікті тамағы.
Dialogue: 0,0:18:17.32,0:18:19.60,Default,,0,0,0,,Сондықтан мен Нананың да жегенін қалаймын.
Dialogue: 0,0:18:26.24,0:18:27.20,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:18:30.36,0:18:31.60,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:18:32.00,0:18:33.36,Default,,0,0,0,,Мен біраз уақытқа шығамын.
Dialogue: 0,0:18:34.00,0:18:34.96,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:18:35.24,0:18:37.97,Default,,0,0,0,,Жарайды, мен міндетті түрде қайтамын.
Dialogue: 0,0:18:38.48,0:18:41.37,Default,,0,0,0,,Себебі Нана, мен тамақ жегім келеді.
Dialogue: 0,0:18:42.48,0:18:43.12,Default,,0,0,0,,Нана?
Dialogue: 0,0:19:00.40,0:19:02.52,Default,,0,0,0,,Кота бұл бетті жасайды.
Dialogue: 0,0:19:08.76,0:19:13.00,Default,,0,0,0,,Өйткені, Ню-чан басынан бері сонда.
Dialogue: 0,0:19:14.04,0:19:15.53,Default,,0,0,0,,Мен ақымақпын.
Dialogue: 0,0:19:22.92,0:19:23.64,Default,,0,0,0,,Құлыптау?
Dialogue: 0,0:19:27.28,0:19:30.40,Default,,0,0,0,,Сол адамдар Кота жараланған кезде келді.
Dialogue: 0,0:19:36.56,0:19:38.05,Default,,0,0,0,,Эносиманы толық блокадалау
Dialogue: 0,0:19:39.32,0:19:41.40,Default,,0,0,0,,Менің жасайтын істерім жылтырақ болып барады.
Dialogue: 0,0:19:42.32,0:19:44.52,Default,,0,0,0,,Биптің қандай түрі?
Dialogue: 0,0:19:58.08,0:19:59.20,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:19:59.84,0:20:03.32,Default,,0,0,0,,PIN кодты әр 30 минут сайын енгізу керек.
Dialogue: 0,0:20:03.72,0:20:05.29,Default,,0,0,0,,Денең желге ұшып кетеді.
Dialogue: 0,0:20:06.08,0:20:07.60,Default,,0,0,0,,Біртүрлі әрекет жасасаңыз
Dialogue: 0,0:20:07.96,0:20:09.20,Default,,0,0,0,,Мен оны бірден жарып жіберемін.
Dialogue: 0,0:20:11.96,0:20:13.29,Default,,0,0,0,,Блокада аяқталды
Dialogue: 0,0:20:13.84,0:20:15.84,Default,,0,0,0,,7 санының қозғалысы туралы не айтасыз?
Dialogue: 0,0:20:16.20,0:20:17.04,Default,,0,0,0,,Міне. . .
Dialogue: 0,0:20:17.16,0:20:19.04,Default,,0,0,0,,Мына жолмен келе жатыр.
Dialogue: 0,0:20:19.20,0:20:22.96,Default,,0,0,0,,Мен сенен қашсам түсінесің бе, ақымақ?
Dialogue: 0,0:20:24.24,0:20:25.44,Default,,0,0,0,,Бұл көңілді болатын сияқты
Dialogue: 0,0:20:28.84,0:20:30.96,Default,,0,0,0,,Маю-чан, сен бірдеңе білесің деп ойлаймын.
Dialogue: 0,0:20:31.84,0:20:33.25,Default,,0,0,0,,Осымен. . .
Dialogue: 0,0:20:35.36,0:20:37.24,Default,,0,0,0,,Мен егжей-тегжейлі білмеймін, бірақ
Dialogue: 0,0:20:37.60,0:20:41.36,Default,,0,0,0,,Бірақ Нана, мені өлтіруге біреу келді.
Dialogue: 0,0:20:41.88,0:20:42.76,Default,,0,0,0,,Өлтіру?
Dialogue: 0,0:20:43.88,0:20:48.88,Default,,0,0,0,,Меніңше, ол бізге қиындық туғызады деп кетіп қалды.
Dialogue: 0,0:20:49.84,0:20:53.84,Default,,0,0,0,,Мен әрқашан өз үйімде бақытты өмір сүргім келетінін айтатынмын.
Dialogue: 0,0:20:58.84,0:21:00.84,Default,,0,0,0,,Маю-чан, үй күтуші сұра
Dialogue: 0,0:21:05.88,0:21:08.96,Default,,0,0,0,,Юкаға қайтып келгенде осында күтуін айт.
Dialogue: 0,0:21:09.52,0:21:12.25,Default,,0,0,0,,Иә, бірақ жақсы ма?
Dialogue: 0,0:21:12.52,0:21:14.40,Default,,0,0,0,,Мұнда тіпті Нана да отбасы.
Dialogue: 0,0:21:14.88,0:21:15.88,Default,,0,0,0,,Мені жалғыз қалдырмаңыз
Dialogue: 0,0:21:16.72,0:21:17.40,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:21:19.28,0:21:20.16,Default,,0,0,0,,Кота
Dialogue: 0,0:21:20.16,0:21:21.48,Default,,0,0,0,,Сіз қаласыз.
Dialogue: 0,0:21:21.48,0:21:21.49,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:21:21.49,0:21:22.36,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:21:22.36,0:21:23.04,Default,,0,0,0,,Келме
Dialogue: 0,0:21:23.04,0:21:23.76,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:21:23.76,0:21:24.36,Default,,0,0,0,,Куруна
Dialogue: 0,0:21:24.36,0:21:25.16,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:21:30.04,0:21:30.92,Default,,0,0,0,,Кота?
Dialogue: 0,0:21:31.76,0:21:32.92,Default,,0,0,0,,Қош келдің үйге.
Dialogue: 0,0:21:33.64,0:21:34.36,Default,,0,0,0,,Кота ше?
Dialogue: 0,0:21:35.80,0:21:36.76,Default,,0,0,0,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:21:37.36,0:21:38.93,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:21:46.04,0:21:47.45,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,0:21:48.28,0:21:48.92,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:21:49.04,0:21:50.45,Default,,0,0,0,,Бұйрық бермеу
Dialogue: 0,0:21:50.80,0:21:52.52,Default,,0,0,0,,Мен бұрын жақсылықты қайтаратынмын.
Dialogue: 0,0:21:54.08,0:21:55.20,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:21:58.76,0:22:02.08,Default,,0,0,0,,Елордалық полиция департаментінің арнайы бөлімшесін уақытша арнайы дайындықтан өткізу үшін
Dialogue: 0,0:22:02.08,0:22:02.68,Default,,0,0,0,,Эносима аймағы толығымен жабылған сияқты.
Dialogue: 0,0:22:02.68,0:22:04.52,Default,,0,0,0,,Эносима аймағы толығымен жабылған сияқты.
Dialogue: 0,0:22:04.52,0:22:04.64,Default,,0,0,0,,Эносима аймағы толығымен жабылған сияқты.
Dialogue: 0,0:22:13.60,0:22:15.60,Default,,0,0,0,,Бұл шынымен де келді
Dialogue: 0,0:22:25.48,0:22:27.16,Default,,0,0,0,,Бұл. . . Ол сондай кішкентай бала
Dialogue: 0,0:22:28.48,0:22:31.84,Default,,0,0,0,,Эй, сен анау апаны өлтіре аласың, солай ма?
Dialogue: 0,0:22:35.48,0:22:38.45,Default,,0,0,0,,Қарауылды жалаң қолмен түсіріп, қолдарың ұшып кетсе
Dialogue: 0,0:22:44.12,0:22:45.69,Default,,0,0,0,,Алыста болса да
Dialogue: 0,0:22:50.88,0:22:53.88,Default,,0,0,0,,Маған бұл ұнамайды. Маған бұл ұнамайды.
Dialogue: 0,0:22:56.08,0:22:57.36,Default,,0,0,0,,Қызықты
Dialogue: 0,0:24:33.56,0:24:37.84,Default,,0,0,0,,Баланың өзі жапқан өткеннің мөрін бұзу ырымы
Dialogue: 0,0:24:38.60,0:24:40.12,Default,,0,0,0,,Қан шашырандыларымен безендірілген
Dialogue: 0,0:24:40.56,0:24:42.56,Default,,0,0,0,,Адамдардың соңғы сәттерінің музыкасын жасау
Dialogue: 0,0:24:42.56,0:24:44.56,Default,,0,0,0,,Бұл тозақ доп болды
Dialogue: 0,0:24:45.24,0:24:46.89,Default,,0,0,0,,Би билеу
Dialogue: 0,0:24:47.12,0:24:49.44,Default,,0,0,0,,Кек, қарғыс, қайғы
Dialogue: 0,0:24:49.84,0:24:53.84,Default,,0,0,0,,Махаббаттарын жасырған оғаш би ханшайымдары
Dialogue: 0,0:24:54.48,0:24:57.13,Default,,0,0,0,,Келесі жолы Эльфен өтірік айтты 12-бөлім
Dialogue: 0,0:24:57.72,0:24:58.72,Default,,0,0,0,,Балшық
Dialogue: 0,0:25:00.22,0:25:06.22,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory