Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.77,0:00:18.16,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.16,0:00:27.29,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.29,0:00:38.55,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.55,0:00:49.15,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.15,0:01:02.24,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.62,0:01:13.71,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.71,0:01:28.31,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:38.48,0:01:39.97,Default,,0,0,0,,Ню-сан, болды. . .
Dialogue: 0,0:01:42.60,0:01:43.49,Default,,0,0,0,,Ню-сан
Dialogue: 0,0:01:43.72,0:01:45.72,Default,,0,0,0,,Маюға тиіспе
Dialogue: 0,0:01:47.80,0:01:49.13,Default,,0,0,0,,Сіз әлі де кетуді жоспарлап жүрсіз бе?
Dialogue: 0,0:01:50.36,0:01:51.73,Default,,0,0,0,,Ән тұрмаса да
Dialogue: 0,0:01:54.12,0:01:55.49,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:02:01.00,0:02:01.76,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:02:03.32,0:02:03.89,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:04.12,0:02:05.01,Default,,0,0,0,,Маған көрсет
Dialogue: 0,0:02:05.24,0:02:06.45,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:02:06.52,0:02:08.89,Default,,0,0,0,,Жоқ, мен Басонконы қоюым керек.
Dialogue: 0,0:02:09.64,0:02:12.41,Default,,0,0,0,,Мен пиязды өзімнің көңілімнен шығатындай етіп турай алмаймын.
Dialogue: 0,0:02:12.92,0:02:13.68,Default,,0,0,0,,Масқара
Dialogue: 0,0:02:14.32,0:02:15.53,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:02:18.44,0:02:20.41,Default,,0,0,0,,Сондықтан мен мұны істей алмаймын дедім.
Dialogue: 0,0:02:22.20,0:02:23.17,Default,,0,0,0,,Не?
Dialogue: 0,0:02:35.68,0:02:37.09,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:43.72,0:02:46.33,Default,,0,0,0,,Мені өлтірмек ойың соншама?
Dialogue: 0,0:02:47.04,0:02:48.20,Default,,0,0,0,,Маю қашып кетеді
Dialogue: 0,0:02:52.96,0:02:53.72,Default,,0,0,0,,Баруға болады
Dialogue: 0,0:02:56.16,0:02:57.37,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:03:03.20,0:03:03.61,Default,,0,0,0,,Бұл
Dialogue: 0,0:03:05.44,0:03:07.44,Default,,0,0,0,,Сәлем Кота
Dialogue: 0,0:03:07.96,0:03:09.25,Default,,0,0,0,,Ню-чан мұнда жоқ.
Dialogue: 0,0:03:10.00,0:03:10.84,Default,,0,0,0,,Не болса да
Dialogue: 0,0:03:18.00,0:03:18.97,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:03:19.44,0:03:22.60,Default,,0,0,0,,Мұндай нәрсе Мұндай нәрсе
Dialogue: 0,0:03:24.20,0:03:25.33,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:03:25.60,0:03:27.84,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:03:28.84,0:03:31.37,Default,,0,0,0,,Ню-сан, қазір әдейі.
Dialogue: 0,0:03:38.08,0:03:39.73,Default,,0,0,0,,Бәсекелестік жоқ
Dialogue: 0,0:03:40.96,0:03:41.88,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:03:42.88,0:03:45.53,Default,,0,0,0,,Ню-сан, доғар енді.
Dialogue: 0,0:03:47.40,0:03:48.89,Default,,0,0,0,,Юкине, сонда ісіңді бітірген соң дүкенге бар.
Dialogue: 0,0:03:51.28,0:03:52.25,Default,,0,0,0,,Ню-сан
Dialogue: 0,0:03:52.52,0:03:53.60,Default,,0,0,0,,. . . не
Dialogue: 0,0:03:53.76,0:03:54.73,Default,,0,0,0,,Ню-чан
Dialogue: 0,0:03:55.36,0:03:56.28,Default,,0,0,0,,Сіз не істеп жүрсіз?
Dialogue: 0,0:03:56.60,0:03:57.52,Default,,0,0,0,,Осындай жерде
Dialogue: 0,0:03:58.80,0:03:59.61,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:04:01.92,0:04:02.81,Default,,0,0,0,,Кота
Dialogue: 0,0:04:02.80,0:04:04.69,Default,,0,0,0,,Менің де қызуым төмендеген жоқ.
Dialogue: 0,0:04:06.04,0:04:08.77,Default,,0,0,0,,Кота Маған Кота ұнайды
Dialogue: 0,0:04:09.00,0:04:10.16,Default,,0,0,0,,Маған Кота ұнайды
Dialogue: 0,0:04:10.64,0:04:13.04,Default,,0,0,0,,Кота Кота
Dialogue: 0,0:04:15.76,0:04:17.84,Default,,0,0,0,,Міне, дәл қазір. . .
Dialogue: 0,0:04:18.12,0:04:20.65,Default,,0,0,0,,Кота-сан және басқалары таң қалады.
Dialogue: 0,0:04:24.28,0:04:26.97,Default,,0,0,0,,Бұл енді Люси емес.
Dialogue: 0,0:04:32.84,0:04:34.25,Default,,0,0,0,,Менде тек ботқа бар.
Dialogue: 0,0:04:38.40,0:04:41.05,Default,,0,0,0,,Ұялма, көптен бері тамақ ішкен жоқсың.
Dialogue: 0,0:04:41.16,0:04:42.05,Default,,0,0,0,,Жаңа
Dialogue: 0,0:04:44.40,0:04:47.53,Default,,0,0,0,,Аз ғана.
Dialogue: 0,0:04:54.76,0:04:56.17,Default,,0,0,0,,Маю-чанның досы?
Dialogue: 0,0:04:56.68,0:04:57.92,Default,,0,0,0,,. . . иә
Dialogue: 0,0:04:58.44,0:05:00.57,Default,,0,0,0,,Нана-сан менің досым
Dialogue: 0,0:05:01.32,0:05:04.05,Default,,0,0,0,,Мен сияқты менің де қайтатын жерім жоқ.
Dialogue: 0,0:05:04.68,0:05:07.21,Default,,0,0,0,,Одан гөрі неге бірінші Нюу туралы айттыңыз?
Dialogue: 0,0:05:07.32,0:05:10.80,Default,,0,0,0,,Мм, Нана-санның қарны ашып, уайымдады.
Dialogue: 0,0:05:11.80,0:05:14.57,Default,,0,0,0,,Нана-сан тамақ ішкенде жақсы қыз.
Dialogue: 0,0:05:14.68,0:05:18.65,Default,,0,0,0,,Мен жаңа ғана кешкі ас әзірлеп жатыр едім.
Dialogue: 0,0:05:20.56,0:05:22.64,Default,,0,0,0,,Жарайды, бір адам өссе де
Dialogue: 0,0:05:23.16,0:05:24.81,Default,,0,0,0,,Нана. . .
Dialogue: 0,0:05:29.96,0:05:30.96,Default,,0,0,0,,Ауыстыру
Dialogue: 0,0:05:42.16,0:05:43.08,Default,,0,0,0,,Жаңа
Dialogue: 0,0:05:44.84,0:05:46.92,Default,,0,0,0,,Сіз шынымен аш болған шығарсыз.
Dialogue: 0,0:05:48.04,0:05:48.93,Default,,0,0,0,,ұқсайды
Dialogue: 0,0:05:49.80,0:05:50.69,Default,,0,0,0,,Ауыстыру
Dialogue: 0,0:05:51.72,0:05:53.61,Default,,0,0,0,,Кешіріңіз, ол жоғалды.
Dialogue: 0,0:05:57.08,0:06:00.97,Default,,0,0,0,,Нана-сан, менің қазір тұратын жерім жоқ.
Dialogue: 0,0:06:01.08,0:06:03.24,Default,,0,0,0,,Бүгін түнде қалуыма рұқсат беруімді қалайсыз ба?
Dialogue: 0,0:06:03.60,0:06:05.20,Default,,0,0,0,,Тұратын жеріңіз жоқ па?
Dialogue: 0,0:06:05.48,0:06:09.09,Default,,0,0,0,,Мүйізді адамға қайтатын жер жоқ.
Dialogue: 0,0:06:12.24,0:06:13.00,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:06:14.12,0:06:16.12,Default,,0,0,0,,Менің сізден сұрайын дегенім көп.
Dialogue: 0,0:06:17.24,0:06:19.85,Default,,0,0,0,,Ал, менің үйімде біраз тұрайық.
Dialogue: 0,0:06:19.96,0:06:20.77,Default,,0,0,0,,жақында жолымыз қиылысар.
Dialogue: 0,0:06:22.24,0:06:23.24,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:06:23.48,0:06:26.28,Default,,0,0,0,,Нанаға бәрі жаман адам ретінде қараса да.
Dialogue: 0,0:06:26.28,0:06:26.29,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:06:26.29,0:06:27.28,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:06:27.76,0:06:29.84,Default,,0,0,0,,Сен күтпеген жерден Нюуды соғып кеткен шығарсың.
Dialogue: 0,0:06:29.84,0:06:31.29,Default,,0,0,0,,Себебі
Dialogue: 0,0:06:31.28,0:06:32.41,Default,,0,0,0,,Жаңа
Dialogue: 0,0:06:39.60,0:06:40.65,Default,,0,0,0,,Нанаға?
Dialogue: 0,0:06:41.52,0:06:42.36,Default,,0,0,0,,Жаңа
Dialogue: 0,0:06:44.52,0:06:46.28,Default,,0,0,0,,Жаңа сіз
Dialogue: 0,0:06:47.12,0:06:50.28,Default,,0,0,0,,Маю-чан аш болғандықтан ашуланғанын айтты.
Dialogue: 0,0:06:52.36,0:06:55.05,Default,,0,0,0,,Бірақ сіз жеуіңіз керек.
Dialogue: 0,0:06:55.16,0:06:55.92,Default,,0,0,0,,Жаңа ма?
Dialogue: 0,0:06:57.88,0:06:59.40,Default,,0,0,0,,Мен таяқшаларды әлі қойған жоқпын.
Dialogue: 0,0:06:59.68,0:07:00.68,Default,,0,0,0,,Ал ше?
Dialogue: 0,0:07:06.00,0:07:06.76,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:07.76,0:07:08.92,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:11.56,0:07:14.04,Default,,0,0,0,,Кенеттен маған шабуыл жасағанына Нана кінәлі.
Dialogue: 0,0:07:15.04,0:07:16.28,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:20.20,0:07:24.41,Default,,0,0,0,,Мен сенің мейірімділігіңмен мойынсұнбаған күнәларды өтеймін бе?
Dialogue: 0,0:07:29.52,0:07:31.92,Default,,0,0,0,,Сіз оқуды бітіргеннен кейін де осында қаласыз ба?
Dialogue: 0,0:07:32.20,0:07:36.17,Default,,0,0,0,,Аа, мен өз зерттеуімді осында жалғастыра аламын.
Dialogue: 0,0:07:38.20,0:07:40.72,Default,,0,0,0,,Мен басқалардың үндемегенін қалаймын.
Dialogue: 0,0:07:45.60,0:07:46.96,Default,,0,0,0,,Әкемнің зертханасы?
Dialogue: 0,0:07:46.96,0:07:51.09,Default,,0,0,0,,А, мен ұлттық жоба бойынша өте құпия зерттеуді жалғастырып жатырмын.
Dialogue: 0,0:07:51.96,0:07:55.85,Default,,0,0,0,,Бұл өте құпия сияқты және оны тек сенімді адамдар пайдалана алады.
Dialogue: 0,0:07:56.84,0:07:58.25,Default,,0,0,0,,Бұл өте құпия ма? Бұл құпия ма?
Dialogue: 0,0:07:59.20,0:08:01.32,Default,,0,0,0,,Басқа күмәнді оқиғалар жоқ.
Dialogue: 0,0:08:02.00,0:08:03.96,Default,,0,0,0,,Мен сенің күшіңді қалаймын
Dialogue: 0,0:08:04.56,0:08:07.00,Default,,0,0,0,,Кешіріңіз, бірақ менен басқа нәрсе сұраңыз, Кадозава.
Dialogue: 0,0:08:07.60,0:08:08.36,Default,,0,0,0,,Сәлем Курама
Dialogue: 0,0:08:08.84,0:08:11.44,Default,,0,0,0,,Адамзаттың бастауын көргің келмей ме?
Dialogue: 0,0:08:26.64,0:08:27.76,Default,,0,0,0,,Полиция.
Dialogue: 0,0:08:27.76,0:08:29.12,Default,,0,0,0,,Қоршалған
Dialogue: 0,0:08:37.16,0:08:37.92,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:08:45.56,0:08:46.40,Default,,0,0,0,,Қорғау
Dialogue: 0,0:08:47.52,0:08:49.32,Default,,0,0,0,,Жарайды, мен енді қорықпаймын.
Dialogue: 0,0:08:50.68,0:08:52.40,Default,,0,0,0,,Әлі де қорқатын адамдар бар ма?
Dialogue: 0,0:08:55.32,0:08:56.04,Default,,0,0,0,,Интрузия
Dialogue: 0,0:09:00.28,0:09:01.32,Default,,0,0,0,,Ешкім
Dialogue: 0,0:09:02.28,0:09:04.60,Default,,0,0,0,,Не? Басқа жол болмауы керек.
Dialogue: 0,0:09:05.72,0:09:07.60,Default,,0,0,0,,Қорқынышты адамдар қайда болды?
Dialogue: 0,0:09:23.36,0:09:24.36,Default,,0,0,0,,Ату, ату
Dialogue: 0,0:09:36.00,0:09:41.64,Default,,0,0,0,,Осыдан төрт жыл бұрын, негізінен, Канагавада, басының бүйірінде шығыңқы бар әйел дүниеге келген.
Dialogue: 0,0:09:42.60,0:09:44.25,Default,,0,0,0,,Бұл біртүрлі ауру екен, бірақ
Dialogue: 0,0:09:44.52,0:09:47.25,Default,,0,0,0,,Шындығында, бұл оңай болған жоқ.
Dialogue: 0,0:10:02.88,0:10:04.04,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:10:05.36,0:10:06.00,Default,,0,0,0,,Қане — бұл тіпті шамамен есеп те емес, жай ғана ойым
Dialogue: 0,0:10:09.64,0:10:10.92,Default,,0,0,0,,270 Джоуль
Dialogue: 0,0:10:10.92,0:10:11.64,Default,,0,0,0,,Таза
Dialogue: 0,0:10:12.28,0:10:14.04,Default,,0,0,0,,300 джоуль кетеді
Dialogue: 0,0:10:14.72,0:10:17.16,Default,,0,0,0,,Маған ұнамайды Маған ұнамайды
Dialogue: 0,0:10:17.52,0:10:19.12,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:10:20.28,0:10:21.24,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:10:21.40,0:10:23.76,Default,,0,0,0,,Енді оны қаламаймын, тоқтат.
Dialogue: 0,0:10:24.04,0:10:25.80,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:10:28.68,0:10:30.44,Default,,0,0,0,,270-де тоқтайсыз ба?
Dialogue: 0,0:10:31.12,0:10:32.92,Default,,0,0,0,,Соңғы айда ешқандай өзгеріс болған жоқ.
Dialogue: 0,0:10:34.32,0:10:37.80,Default,,0,0,0,,Денеңіз өскен сайын күшіңіз де күшейе түсуі керек.
Dialogue: 0,0:10:38.76,0:10:40.04,Default,,0,0,0,,Жеке айырмашылықтар да үлкен.
Dialogue: 0,0:10:40.44,0:10:43.20,Default,,0,0,0,,Векторларды зерттеуге әлі де орын бар.
Dialogue: 0,0:10:55.40,0:10:56.44,Default,,0,0,0,,Не болды, Курама?
Dialogue: 0,0:10:58.56,0:10:59.97,Default,,0,0,0,,Көңіл-күйіңіз нашар сияқты.
Dialogue: 0,0:11:00.96,0:11:02.04,Default,,0,0,0,,Мен өкінемін.
Dialogue: 0,0:11:02.84,0:11:04.33,Default,,0,0,0,,Сіздің кеңесіңізді пайдаланғаным үшін кешіріңіз.
Dialogue: 0,0:11:06.20,0:11:10.20,Default,,0,0,0,,Біз әлемде теңдесі жоқ үлгілерді пайдаланып зерттеу жүргіземіз.
Dialogue: 0,0:11:10.32,0:11:13.96,Default,,0,0,0,,Біздің істеген ісіміз әрқашан әділ бағаланады
Dialogue: 0,0:11:14.36,0:11:16.04,Default,,0,0,0,,Маған сенші Курама
Dialogue: 0,0:11:17.36,0:11:20.17,Default,,0,0,0,,Неліктен ол бір уақытта және бір аймақта болды?
Dialogue: 0,0:11:21.20,0:11:22.61,Default,,0,0,0,,Менің ойымша, бұл маңыздырақ
Dialogue: 0,0:11:23.48,0:11:26.08,Default,,0,0,0,,Мұндай адамгершілікке жатпайтын еліктеудің қажеті жоқ.
Dialogue: 0,0:11:26.56,0:11:28.72,Default,,0,0,0,,Оларды адам деп ойлайсың ба?
Dialogue: 0,0:11:29.08,0:11:29.68,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:11:31.96,0:11:34.24,Default,,0,0,0,,Диклоний үш жаста болғанда
Dialogue: 0,0:11:34.60,0:11:36.25,Default,,0,0,0,,Оның шынайы табиғаты ашылады
Dialogue: 0,0:11:39.08,0:11:41.89,Default,,0,0,0,,Вектор кісі өлтіру әрекеттерін көрсетеді және қайталайды
Dialogue: 0,0:11:43.76,0:11:45.48,Default,,0,0,0,,Осы уақытқа дейін болған істердің негізінде,
Dialogue: 0,0:11:45.84,0:11:48.65,Default,,0,0,0,,Диклоний тіпті ата-анасын да ойланбастан өлтіреді.
Dialogue: 0,0:11:49.24,0:11:52.48,Default,,0,0,0,,Дегенмен, векторларыңызды бағыттай алатын жалғыз адамдар - 100% адамдар.
Dialogue: 0,0:11:53.12,0:11:54.32,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:11:59.88,0:12:03.24,Default,,0,0,0,,Диклоний – адамзаттың жауы.
Dialogue: 0,0:12:06.28,0:12:07.64,Default,,0,0,0,,Мен сені бүгін үйге жіберемін.
Dialogue: 0,0:12:08.16,0:12:10.52,Default,,0,0,0,,Әйеліңізге, жас жұбайларға сәлем айтыңыз
Dialogue: 0,0:12:10.52,0:12:11.52,Default,,0,0,0,,Басшы Кадозава
Dialogue: 0,0:12:11.88,0:12:12.52,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:13.16,0:12:14.92,Default,,0,0,0,,Үшінші тамақтың уақыты келді.
Dialogue: 0,0:12:14.92,0:12:16.25,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:12:16.76,0:12:18.25,Default,,0,0,0,,Тұрақты байланыс жоқ.
Dialogue: 0,0:12:18.36,0:12:20.04,Default,,0,0,0,,Құлыптан ашық болыңыз
Dialogue: 0,0:12:26.64,0:12:27.80,Default,,0,0,0,,Жақсы мақсат қойыңыз
Dialogue: 0,0:12:28.16,0:12:29.76,Default,,0,0,0,,Оқ мені жіберіп алды.
Dialogue: 0,0:12:33.04,0:12:35.04,Default,,0,0,0,,Нағашыларға да солай істе.
Dialogue: 0,0:12:38.00,0:12:39.00,Default,,0,0,0,,Негізгі люкті жабыңыз
Dialogue: 0,0:12:39.12,0:12:40.32,Default,,0,0,0,,Күзетшілер толық жабдықта
Dialogue: 0,0:12:40.32,0:12:41.92,Default,,0,0,0,,Үшінші қабатта қатаң қауіпсіздік
Dialogue: 0,0:12:42.56,0:12:44.40,Default,,0,0,0,,Омори Басқа қабаттарды тексеріңіз
Dialogue: 0,0:12:44.68,0:12:45.80,Default,,0,0,0,,. . . иә
Dialogue: 0,0:12:53.16,0:12:54.04,Default,,0,0,0,,Мұндай жағдайға жол беруге болмайды!
Dialogue: 0,0:13:02.96,0:13:04.32,Default,,0,0,0,,Біз ақыры кездестік.
Dialogue: 0,0:13:05.64,0:13:07.05,Default,,0,0,0,,Шыны артында тұрған адам
Dialogue: 0,0:13:12.68,0:13:15.41,Default,,0,0,0,,Мен сізге алғыс айтқым келді.
Dialogue: 0,0:13:17.08,0:13:17.92,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:29.72,0:13:31.44,Default,,0,0,0,,Мылтықтан шыққан оқ ауытқып кетсе де
Dialogue: 0,0:13:31.60,0:13:33.36,Default,,0,0,0,,Құрыш тесіп өтетін оқтар әлі де мүмкін емес.
Dialogue: 0,0:13:33.96,0:13:36.61,Default,,0,0,0,,Курама, сен менің өмірімді сақтап қалдың.
Dialogue: 0,0:13:37.44,0:13:39.88,Default,,0,0,0,,Бұл жігіттің өсуі жақында тоқтап қалды деп ойладым.
Dialogue: 0,0:13:40.12,0:13:41.12,Default,,0,0,0,,Бұл жалған болды
Dialogue: 0,0:13:41.96,0:13:44.24,Default,,0,0,0,,. . Оның оқ жаудыратын күші әлдеқашан болған.
Dialogue: 0,0:13:44.44,0:13:45.96,Default,,0,0,0,,Эмоционалды, тіпті сәбилер
Dialogue: 0,0:13:46.36,0:13:48.08,Default,,0,0,0,,Диклоний жоғары интеллектке ие.
Dialogue: 0,0:13:48.36,0:13:49.36,Default,,0,0,0,,Мен күзетімді түсірдім.
Dialogue: 0,0:13:57.08,0:13:58.60,Default,,0,0,0,,Мен сізге алғыс айтқым келді.
Dialogue: 0,0:14:00.96,0:14:02.24,Default,,0,0,0,,Мен есімде сақтамасам да,
Dialogue: 0,0:14:07.28,0:14:10.64,Default,,0,0,0,,Туылу себебі әлі анықталмағанымен
Dialogue: 0,0:14:11.00,0:14:13.76,Default,,0,0,0,,Диклониус түрмеге қамалған сайын көбейіп барады.
Dialogue: 0,0:14:14.52,0:14:16.40,Default,,0,0,0,,Нысандардың да өз шегі бар.
Dialogue: 0,0:14:16.72,0:14:20.40,Default,,0,0,0,,Мен қазірден бастап туатын барлық балалардан құтылғым келеді.
Dialogue: 0,0:14:21.04,0:14:27.36,Default,,0,0,0,,Туа біткен хромосомалық аномалияға байланысты кенеттен нәресте өлімі синдромы ретінде қарастырылуы керек.
Dialogue: 0,0:14:27.92,0:14:31.89,Default,,0,0,0,,Негізінен бұл жер осындай нысан.
Dialogue: 0,0:14:34.28,0:14:35.16,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:36.04,0:14:37.24,Default,,0,0,0,,Келмеңіз
Dialogue: 0,0:14:37.76,0:14:38.88,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:14:39.24,0:14:40.80,Default,,0,0,0,,Мүйіз өсірсең де
Dialogue: 0,0:14:40.80,0:14:40.81,Default,,0,0,0,,Ол менің қызым.
Dialogue: 0,0:14:40.81,0:14:42.04,Default,,0,0,0,,Ол менің қызым.
Dialogue: 0,0:14:42.04,0:14:45.44,Default,,0,0,0,,Омори Диклониус өссе не болады?
Dialogue: 0,0:14:45.68,0:14:47.12,Default,,0,0,0,,Сіз жақсырақ білуіңіз керек
Dialogue: 0,0:14:47.28,0:14:49.16,Default,,0,0,0,,Бірақ ол менің қызым.
Dialogue: 0,0:14:49.16,0:14:52.28,Default,,0,0,0,,Бірақ Мэй үш жылдан кейін бірінші болып өлтіріледі.
Dialogue: 0,0:14:55.52,0:14:58.20,Default,,0,0,0,,Ұмытшы, менің жолым болмады.
Dialogue: 0,0:14:59.68,0:15:02.68,Default,,0,0,0,,Сіз де солай ойлайсыз ба, Курама мырза?
Dialogue: 0,0:15:03.56,0:15:05.52,Default,,0,0,0,,Алда тұрған қиын тағдырды қарастыру
Dialogue: 0,0:15:06.04,0:15:07.84,Default,,0,0,0,,Бала есін жиғанға дейін
Dialogue: 0,0:15:08.80,0:15:10.56,Default,,0,0,0,,Мен саған ғашық болмас бұрын
Dialogue: 0,0:15:12.08,0:15:13.44,Default,,0,0,0,,Оны өлтірген дұрыс.
Dialogue: 0,0:15:14.16,0:15:16.84,Default,,0,0,0,,Менің мұндай шешім қабылдауға мүмкіндігім жоқ.
Dialogue: 0,0:15:17.32,0:15:18.40,Default,,0,0,0,,Мен шешемін
Dialogue: 0,0:15:20.56,0:15:21.84,Default,,0,0,0,,Бұл менің шешімім
Dialogue: 0,0:15:22.60,0:15:23.72,Default,,0,0,0,,Сіз маған көмектесе аласыз
Dialogue: 0,0:15:29.68,0:15:31.84,Default,,0,0,0,,Ештеңе жасамасаңыз да
Dialogue: 0,0:15:32.24,0:15:34.36,Default,,0,0,0,,Мен оннан астам адамды өлтірдім.
Dialogue: 0,0:15:35.60,0:15:38.33,Default,,0,0,0,,Енді қолыңызды басқа нәрсемен ластаудың қажеті жоқ.
Dialogue: 0,0:15:39.12,0:15:42.36,Default,,0,0,0,,Жарайды, жаза сенікі, сондықтан мен ештеңе айтпаймын.
Dialogue: 0,0:15:43.08,0:15:45.81,Default,,0,0,0,,Әйеліңіздің жақын мерзімі сізге қиын болғанына сенімдімін.
Dialogue: 0,0:15:48.48,0:15:49.48,Default,,0,0,0,,Kisaragi
Dialogue: 0,0:15:50.84,0:15:52.36,Default,,0,0,0,,. . Кешіріңіз
Dialogue: 0,0:15:53.36,0:15:55.08,Default,,0,0,0,,Мен қазір шүберек әкелемін.
Dialogue: 0,0:16:00.12,0:16:01.12,Default,,0,0,0,,Жаңадан келген адам?
Dialogue: 0,0:16:01.84,0:16:03.84,Default,,0,0,0,,Токио университетінде оқитын талантты қыз сияқты.
Dialogue: 0,0:16:04.76,0:16:05.76,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:09.00,0:16:11.00,Default,,0,0,0,,Иә, бұл директордың кабинеті.
Dialogue: 0,0:16:11.64,0:16:13.52,Default,,0,0,0,,Бұл жерде сондай адамдар болғандықтан
Dialogue: 0,0:16:13.52,0:16:14.52,Default,,0,0,0,,Сіз құтқарыласыз
Dialogue: 0,0:16:15.52,0:16:16.64,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:16:16.96,0:16:17.88,Default,,0,0,0,,Курама мырза
Dialogue: 0,0:16:20.40,0:16:22.40,Default,,0,0,0,,Жатыр мойны обыры анықталды.
Dialogue: 0,0:16:22.88,0:16:24.48,Default,,0,0,0,,Жатырды асығыс алып тастады.
Dialogue: 0,0:16:24.48,0:16:25.84,Default,,0,0,0,,Мен қолымды кесіп аштым
Dialogue: 0,0:16:26.60,0:16:27.40,Default,,0,0,0,,Менің әйелім
Dialogue: 0,0:16:27.64,0:16:28.64,Default,,0,0,0,,Балалар
Dialogue: 0,0:16:28.92,0:16:31.92,Default,,0,0,0,,Ана мен баланың өміріне қауіп төндіретін жарақаттары жоқ.
Dialogue: 0,0:16:34.76,0:16:36.80,Default,,0,0,0,,Қарашы, қыз.
Dialogue: 0,0:16:37.76,0:16:39.17,Default,,0,0,0,,Маған есім ойлап табу керек.
Dialogue: 0,0:16:41.28,0:16:42.88,Default,,0,0,0,,Мүйіз өсірсең де
Dialogue: 0,0:16:42.88,0:16:44.37,Default,,0,0,0,,Ол менің қызым.
Dialogue: 0,0:16:47.16,0:16:48.81,Default,,0,0,0,,Оны өлтірген дұрыс.
Dialogue: 0,0:16:49.16,0:16:51.16,Default,,0,0,0,,Бірақ ол менің қызым.
Dialogue: 0,0:16:51.16,0:16:54.13,Default,,0,0,0,,Бірақ сіз үш жылдан кейін бірінші болып өлтірілесіздер.
Dialogue: 0,0:16:54.80,0:16:56.29,Default,,0,0,0,,Оны өлтірген дұрыс.
Dialogue: 0,0:16:56.80,0:16:59.64,Default,,0,0,0,,Менің мұндай шешім қабылдауға мүмкіндігім жоқ.
Dialogue: 0,0:16:59.80,0:17:01.21,Default,,0,0,0,,Мен шешемін
Dialogue: 0,0:17:01.68,0:17:02.80,Default,,0,0,0,,Бұл менің шешімім
Dialogue: 0,0:17:03.92,0:17:04.88,Default,,0,0,0,,Сіз мені кінәлай аласыз.
Dialogue: 0,0:17:11.40,0:17:12.52,Default,,0,0,0,,Бэбифейс: Американдық супержұлдыз Кеннет Брайан Эдмундтің сахналық лақап атынан алынған.
Dialogue: 0,0:17:12.52,0:17:13.52,Default,,0,0,0,,Шық!
Dialogue: 0,0:17:14.48,0:17:17.24,Default,,0,0,0,,Бұндай нәрсені есту мүмкін емес.
Dialogue: 0,0:17:17.24,0:17:18.16,Default,,0,0,0,,Түсініңіз
Dialogue: 0,0:17:18.16,0:17:20.40,Default,,0,0,0,,Маған да қиын, бірақ
Dialogue: 0,0:17:20.40,0:17:23.24,Default,,0,0,0,,Неліктен бұл баланы өлтіру керек болды?
Dialogue: 0,0:17:23.24,0:17:24.92,Default,,0,0,0,,Курама мырза, не болды?
Dialogue: 0,0:17:27.56,0:17:28.56,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:17:29.28,0:17:30.12,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:17:30.68,0:17:33.00,Default,,0,0,0,,Операциядан бері бірнеше сағат өтті.
Dialogue: 0,0:17:33.88,0:17:34.68,Default,,0,0,0,,Менің әйелім
Dialogue: 0,0:17:35.16,0:17:36.68,Default,,0,0,0,,Бұл абсолютті демалыс болса да
Dialogue: 0,0:17:36.68,0:17:38.44,Default,,0,0,0,,Көңілі көтеріліп, жабайы кетті.
Dialogue: 0,0:17:39.04,0:17:41.56,Default,,0,0,0,,Жағдайы ауыр, көп қан кетуге байланысты ес-түссіз.
Dialogue: 0,0:17:42.68,0:17:45.44,Default,,0,0,0,,Әрі қарай қан кету өмірге қауіп төндіреді.
Dialogue: 0,0:17:46.28,0:17:49.64,Default,,0,0,0,,Менің қызым қайда?
Dialogue: 0,0:17:50.28,0:17:51.20,Default,,0,0,0,,Балабақша бөлмесі
Dialogue: 0,0:17:51.76,0:17:53.44,Default,,0,0,0,,Ертең барып көріңіз.
Dialogue: 0,0:17:58.32,0:18:00.92,Default,,0,0,0,,Мен сізге алғыс айтқым келді.
Dialogue: 0,0:18:03.08,0:18:03.92,Default,,0,0,0,,At that time
Dialogue: 0,0:18:04.68,0:18:06.04,Default,,0,0,0,,Дарака Омори да
Dialogue: 0,0:18:06.84,0:18:09.04,Default,,0,0,0,,Мен көремін. Солай ма?
Dialogue: 0,0:18:12.96,0:18:16.24,Default,,0,0,0,,Бұл менің көзіме түскенде, мен мұны түсінемін
Dialogue: 0,0:18:21.72,0:18:22.60,Default,,0,0,0,,Мені кешір
Dialogue: 0,0:18:25.72,0:18:26.48,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:28.12,0:18:30.36,Default,,0,0,0,,Мына баланы неге өлтірмексің?
Dialogue: 0,0:18:31.88,0:18:33.96,Default,,0,0,0,,Мен оны қатты күттім.
Dialogue: 0,0:18:35.24,0:18:37.84,Default,,0,0,0,,Мен бұдан былай балалы бола алмаймын.
Dialogue: 0,0:18:38.32,0:18:41.88,Default,,0,0,0,,Неліктен оның басында мүйізі бар?
Dialogue: 0,0:18:43.44,0:18:44.88,Default,,0,0,0,,Ол жаман бала емес.
Dialogue: 0,0:18:45.36,0:18:50.76,Default,,0,0,0,,Балаға көмектесіңізші. . . Маған беріңізші
Dialogue: 0,0:18:57.28,0:18:58.28,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:19:00.08,0:19:01.96,Default,,0,0,0,,Жарайды, тұрайық.
Dialogue: 0,0:19:09.52,0:19:14.04,Default,,0,0,0,,Жарайды, оян.
Dialogue: 0,0:19:17.28,0:19:19.40,Default,,0,0,0,,Кейінгі тергеу нәтижелері қолжетімді.
Dialogue: 0,0:19:20.16,0:19:23.80,Default,,0,0,0,,Күтілгендей, барлық әкелердің реакциясы Курама сияқты болды.
Dialogue: 0,0:19:25.40,0:19:29.76,Default,,0,0,0,,Вектор арқылы таралатын вирус себепші екені күмәнсіз.
Dialogue: 0,0:19:30.88,0:19:31.92,Default,,0,0,0,,Бұл ирониялық.
Dialogue: 0,0:19:32.12,0:19:35.44,Default,,0,0,0,,Сіздің арқаңызда Диклониус індетінің жұмбағы шешілді.
Dialogue: 0,0:19:37.32,0:19:39.80,Default,,0,0,0,,Мен осы жерден кетіп, өзімді вирустарды зерттеуге арнаймын.
Dialogue: 0,0:19:40.32,0:19:42.12,Default,,0,0,0,,Бұл менің бастапқыда маманданғаным.
Dialogue: 0,0:19:42.52,0:19:43.20,Default,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,0:19:43.64,0:19:45.44,Default,,0,0,0,,Курама зертхана меңгерушісі болып ауыстырылды.
Dialogue: 0,0:19:45.68,0:19:46.28,Default,,0,0,0,,Иә
Dialogue: 0,0:19:46.68,0:19:48.44,Default,,0,0,0,,Ал, менде біраз дайындық бар, мінекей.
Dialogue: 0,0:19:55.28,0:19:57.08,Default,,0,0,0,,Патшайым болуы керек
Dialogue: 0,0:19:57.20,0:19:58.04,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:19:58.96,0:20:02.56,Default,,0,0,0,,Вирусты алғаш таратқан әрқашан Диклониус бар.
Dialogue: 0,0:20:03.32,0:20:05.56,Default,,0,0,0,,Өткен оқиғаларды мұқият анықтаңыз
Dialogue: 0,0:20:05.56,0:20:06.97,Default,,0,0,0,,Түпнұсқаны іздеңіз
Dialogue: 0,0:20:07.32,0:20:08.08,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:20:08.92,0:20:11.81,Default,,0,0,0,,Қызыңның өмірі менің қолымда.
Dialogue: 0,0:20:12.92,0:20:15.49,Default,,0,0,0,,Бұл бастапқыда жойылуы керек нәрсе.
Dialogue: 0,0:20:16.44,0:20:18.09,Default,,0,0,0,,Сізге маған бағынбауға рұқсат жоқ.
Dialogue: 0,0:20:30.20,0:20:32.08,Default,,0,0,0,,Тек сіз қашып ойнай аласыз.
Dialogue: 0,0:20:44.60,0:20:48.76,Default,,0,0,0,,Екеумізді де өртеп жібере алдың.
Dialogue: 0,0:20:48.84,0:20:51.73,Default,,0,0,0,,Сондықтан мен жалаңаш денеме ине саламын.
Dialogue: 0,0:20:56.64,0:20:58.40,Default,,0,0,0,,Нана-сан Нана-сан
Dialogue: 0,0:21:03.84,0:21:05.84,Default,,0,0,0,,Көрдім, кеше
Dialogue: 0,0:21:06.36,0:21:08.40,Default,,0,0,0,,Таңғы ас дайын.
Dialogue: 0,0:21:09.52,0:21:10.76,Default,,0,0,0,,Маю кінәлі
Dialogue: 0,0:21:12.40,0:21:16.24,Default,,0,0,0,,Бұл не? Бұл өте дәмді.
Dialogue: 0,0:21:16.28,0:21:17.93,Default,,0,0,0,,Маю мұны жасады.
Dialogue: 0,0:21:18.12,0:21:19.04,Default,,0,0,0,,Иә
Dialogue: 0,0:21:19.28,0:21:21.04,Default,,0,0,0,,Ғажайып Майу Гений
Dialogue: 0,0:21:21.40,0:21:23.40,Default,,0,0,0,,Осы суретте олар мінсіз жұп сияқты көрінеді, иә?
Dialogue: 0,0:21:23.40,0:21:25.28,Default,,0,0,0,,Екеуіңнен әлі ерініп жүрмін.
Dialogue: 0,0:21:25.76,0:21:26.76,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:21:26.92,0:21:29.40,Default,,0,0,0,,Егер ол осы дәрежеге дейін өссе, ол бірдей болады.
Dialogue: 0,0:21:29.52,0:21:32.17,Default,,0,0,0,,Иә, солай деп ойлаймын.
Dialogue: 0,0:21:32.28,0:21:33.40,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:21:33.40,0:21:35.56,Default,,0,0,0,,Адамдар көбейді, еносимаға барайық.
Dialogue: 0,0:21:35.92,0:21:37.44,Default,,0,0,0,,Сонда адам саны көбейді?
Dialogue: 0,0:21:37.68,0:21:38.68,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:21:38.80,0:21:40.44,Default,,0,0,0,,Wanta да бақытты болады
Dialogue: 0,0:21:40.44,0:21:40.45,Default,,0,0,0,,Жаңа
Dialogue: 0,0:21:40.45,0:21:41.44,Default,,0,0,0,,Жаңа
Dialogue: 0,0:21:45.52,0:21:47.92,Default,,0,0,0,,Неге бұлай айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:21:48.28,0:21:50.52,Default,,0,0,0,,Жақсы нәрсе
Dialogue: 0,0:21:59.32,0:22:01.68,Default,,0,0,0,,№35 жай ғана Зилпелит емес.
Dialogue: 0,0:22:02.28,0:22:04.56,Default,,0,0,0,,Олардың бар екенін білетін адамдар көп.
Dialogue: 0,0:22:05.28,0:22:06.85,Default,,0,0,0,,Мен тіпті білмедім
Dialogue: 0,0:22:07.72,0:22:09.21,Default,,0,0,0,,Бірақ директордың бұйрығы.
Dialogue: 0,0:22:09.84,0:22:13.08,Default,,0,0,0,,Қазірдің өзінде мен сені осы қабірде қамауда ұстау үшін істей аламын.
Dialogue: 0,0:22:15.20,0:22:19.33,Default,,0,0,0,,35 саны - көрген әрбір адамды өлтіретін ең жаман Зилперит.
Dialogue: 0,0:22:20.28,0:22:23.48,Default,,0,0,0,,Бұл жалғыз расталған үшінші алгебра, сондықтан мен оны пайдаланамын.
Dialogue: 0,0:22:23.96,0:22:25.08,Default,,0,0,0,,Әйтпесе
Dialogue: 0,0:22:44.56,0:22:46.56,Default,,0,0,0,,Иә, оны мына жерден көре аласыз.
Dialogue: 0,0:22:46.88,0:22:48.96,Default,,0,0,0,,Толқындар тым күшті.
Dialogue: 0,0:22:49.60,0:22:50.60,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:22:51.64,0:22:53.32,Default,,0,0,0,,саны 26
Dialogue: 0,0:22:54.08,0:22:55.88,Default,,0,0,0,,Бұл адам Люсиден де құбыжық.
Dialogue: 0,0:22:57.12,0:22:58.88,Default,,0,0,0,,Ең күшті Диклониус
Dialogue: 0,0:24:33.84,0:24:37.68,Default,,0,0,0,,Жас шайтан қарғыс атқан дауыспен түседі
Dialogue: 0,0:24:38.24,0:24:41.84,Default,,0,0,0,,Бақыттың мәнін біліп, оны қорғайтын қыз.
Dialogue: 0,0:24:43.00,0:24:44.84,Default,,0,0,0,,Барлық жерде шынжырларды үзуге тырысу
Dialogue: 0,0:24:44.84,0:24:46.80,Default,,0,0,0,,Аңмен қол ұстасып тұрған адам
Dialogue: 0,0:24:47.72,0:24:49.13,Default,,0,0,0,,Әр жерде
Dialogue: 0,0:24:49.60,0:24:51.12,Default,,0,0,0,,Қанды ән мерекесіне дайындық
Dialogue: 0,0:24:51.12,0:24:53.36,Default,,0,0,0,,Тұрақты прогреске қол жеткізілді
Dialogue: 0,0:24:54.48,0:24:57.24,Default,,0,0,0,,Келесі жолы Эльфен өтірік айтты 11-бөлім
Dialogue: 0,0:24:57.56,0:24:58.76,Default,,0,0,0,,Шатасу
Dialogue: 0,0:25:00.26,0:25:06.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory