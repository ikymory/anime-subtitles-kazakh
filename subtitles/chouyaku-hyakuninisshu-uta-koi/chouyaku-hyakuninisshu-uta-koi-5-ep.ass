Dialogue: 0,0:02:46.01,0:02:55.94,LOGO,,0000,0000,0000,,Бұл субтитр көзін God Subtitles Group (kamigami.org) жасаған, пайдаланушы ұсынған және коммерциялық пайдалануға тыйым салынған.
Dialogue: 0,0:02:46.01,0:02:55.94,,,0000,0000,0000,,: &  :Thomasday :apollius & Syura : : :
Dialogue: 0,0:00:04.73,0:00:08.28,JP2,,0000,0000,0000,,Бұл...Ираго теңізі
Dialogue: 0,0:00:09.39,0:00:14.51,JP2,,0000,0000,0000,,Бұл Маньо дәуірінде Асацугу патша жер аударылған колония болатын.
Dialogue: 0,0:00:25.43,0:00:29.83,JP2,,0000,0000,0000,,Міне, қазір тұрған жерімізде мұңды өлең шығарған.
Dialogue: 0,0:00:30.09,0:00:32.07,JP2,,0000,0000,0000,,Әй, жүрегім жарылып кететін сияқты.
Dialogue: 0,0:00:32.88,0:00:36.11,JP2,,0000,0000,0000,,Комачи мен күткеннен де қатты толқыды.
Dialogue: 0,0:00:36.39,0:00:39.60,JP2,,0000,0000,0000,,Ақындар негізінен гектерді ән салады.
Dialogue: 0,0:00:40.34,0:00:42.83,JP2,,0000,0000,0000,,Мен үшін Утамакураға саяхат қолайлы.
Dialogue: 0,0:00:43.15,0:00:45.14,JP2,,0000,0000,0000,,Киелі жерге зиярат ету, былайша айтқанда.
Dialogue: 0,0:00:46.47,0:00:50.00,JP2,,0000,0000,0000,,Фудзи тауы ше? Акато Ямабе де көрген Фудзи тауы қайда?
Dialogue: 0,0:00:51.54,0:00:53.38,JP2,,0000,0000,0000,,Фудзи тауы одан әрі шығыста.
Dialogue: 0,0:00:53.57,0:00:56.20,JP2,,0000,0000,0000,,Дұрыс, мен оны тезірек көргім келеді.
Dialogue: 0,0:00:57.23,0:01:00.65,JP2,,0000,0000,0000,,Фудзи тауын көргенде үшеуміз бірге ән айтайық.
Dialogue: 0,0:01:01.53,0:01:05.10,JP2,,0000,0000,0000,,Қызыл адаммен бірдей декорация алдында өлең шығару
Dialogue: 0,0:01:05.98,0:01:08.63,JP2,,0000,0000,0000,,А, бұл тамаша.
Dialogue: 0,0:01:09.47,0:01:10.46,JP2,,0000,0000,0000,,Отаку…
Dialogue: 0,0:01:12.26,0:01:15.39,JP2,,0000,0000,0000,,Біз не үшін келдік?
Dialogue: 0,0:03:03.60,0:03:04.31,JP2,,0000,0000,0000,,Йошико-сама
Dialogue: 0,0:03:05.94,0:03:08.44,JP2,,0000,0000,0000,,Ясухиде мырзадан хат алдық.
Dialogue: 0,0:03:09.17,0:03:09.89,JP2,,0000,0000,0000,,Рахмет
Dialogue: 0,0:03:10.51,0:03:12.29,JP2,,0000,0000,0000,,Бұл жаңа жылдық құттықтау, солай ма?
Dialogue: 0,0:03:12.60,0:03:15.49,JP2,,0000,0000,0000,,Салиқалы адам болғандықтан шығар.
Dialogue: 0,0:03:17.16,0:03:20.64,JP2,,0000,0000,0000,,Біз бірінші рет киім ауыстырып жатқанда кездестік.
Dialogue: 0,0:03:21.69,0:03:24.14,JP2,,0000,0000,0000,,Ясухиде-сама, мен және Нарихира-сама
Dialogue: 0,0:03:24.95,0:03:27.27,JP2,,0000,0000,0000,,Үшеуміз айға қарап әңгімелестік.
Dialogue: 0,0:03:28.04,0:03:30.36,JP2,,0000,0000,0000,,Анда-санда хат алмасу
Dialogue: 0,0:03:32.07,0:03:35.64,JP2,,0000,0000,0000,,Мен әлі де араласатын достарым аз
Dialogue: 0,0:03:36.78,0:03:38.38,JP2,,0000,0000,0000,,Жаңа жыл құтты болсын
Dialogue: 0,0:03:39.09,0:03:42.74,JP2,,0000,0000,0000,,Комачи мырза көктемнің басын аман-сау қарсы алады деп сенемін.
Dialogue: 0,0:03:43.91,0:03:47.32,JP2,,0000,0000,0000,,Жақында мені Микаваға ауыстырады деп шешті.
Dialogue: 0,0:03:48.25,0:03:51.54,JP2,,0000,0000,0000,,Лорд Ясухиде қазірдің өзінде Микава елінде...
Dialogue: 0,0:03:52.20,0:03:55.71,JP2,,0000,0000,0000,,Алайда көрші елге жалғыз саяхаттауды ойлап, көңілім күйзеледі.
Dialogue: 0,0:03:55.89,0:03:57.68,JP2,,0000,0000,0000,,Мен мұны істегім келмейді.
Dialogue: 0,0:03:58.55,0:04:00.28,JP2,,0000,0000,0000,,Бұл лақтырудың бір түрі.
Dialogue: 0,0:04:01.33,0:04:05.97,JP2,,0000,0000,0000,,Бос уақытыңыз болса, менімен бірге Микаваға ауылды көріп, көңіл көтергіңіз келе ме?
Dialogue: 0,0:04:06.53,0:04:07.31,JP2,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:04:07.82,0:04:08.65,JP2,,0000,0000,0000,,Биылғы жылы да сәттілік
Dialogue: 0,0:04:11.33,0:04:13.47,JP2,,0000,0000,0000,,Сен әлі бұзық адамсың.
Dialogue: 0,0:04:14.00,0:04:16.57,JP2,,0000,0000,0000,,Енді күдікті азғырулар үшін
Dialogue: 0,0:04:16.89,0:04:19.53,JP2,,0000,0000,0000,,Жауап ретінде не айтуым керек?
Dialogue: 0,0:04:36.56,0:04:38.59,JP2,,0000,0000,0000,,Мен сол сөйлемді жаздым.
Dialogue: 0,0:04:38.89,0:04:41.09,JP2,,0000,0000,0000,,Комачи-доно, сен маған қандай жауап бересің?
Dialogue: 0,0:04:42.04,0:04:44.27,JP2,,0000,0000,0000,,Менің ойымша, бұл еленбейді.
Dialogue: 0,0:04:44.66,0:04:47.27,JP2,,0000,0000,0000,,Бірақ мүмкін, мүмкін
Dialogue: 0,0:04:48.81,0:04:53.04,JP2,,0000,0000,0000,,Жауап пернесі
Dialogue: 0,0:04:55.68,0:04:56.94,JP2,,0000,0000,0000,,Жаңа жылыңызбен～
Dialogue: 0,0:04:57.25,0:04:59.11,JP2,,0000,0000,0000,,Нарихира-доно
Dialogue: 0,0:05:00.04,0:05:01.82,JP2,,0000,0000,0000,,Бұл басқа не болды?
Dialogue: 0,0:05:03.61,0:05:04.74,JP2,,0000,0000,0000,,Оның сізге қатысы жоқ.
Dialogue: 0,0:05:05.00,0:05:07.26,JP2,,0000,0000,0000,,Жоқ, бұл маңызды емес.
Dialogue: 0,0:05:07.71,0:05:08.69,JP2,,0000,0000,0000,,Айтпақшы, сіз
Dialogue: 0,0:05:10.49,0:05:12.49,JP2,,0000,0000,0000,,Оны Микаваға жіберетін сияқты.
Dialogue: 0,0:05:12.68,0:05:15.17,JP2,,0000,0000,0000,,Пожалуйста, төмендетіліп жатқандай сөйлемеңіз.
Dialogue: 0,0:05:15.37,0:05:16.54,JP2,,0000,0000,0000,,Осыған ұқсас нәрсе болуы мүмкін
Dialogue: 0,0:05:16.67,0:05:17.89,JP2,,0000,0000,0000,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:05:18.05,0:05:20.81,JP2,,0000,0000,0000,,Жарайды, не қаласаң, жарты жолда мін.
Dialogue: 0,0:05:21.25,0:05:22.02,JP2,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:22.56,0:05:25.58,JP2,,0000,0000,0000,,Мен де Шығысты аралауды ойладым.
Dialogue: 0,0:05:26.35,0:05:29.94,JP2,,0000,0000,0000,,Менің ойымша, сенің соңынан еретін әйел жоқ.
Dialogue: 0,0:05:30.09,0:05:30.64,JP2,,0000,0000,0000,,Тітіркендіргіш
Dialogue: 0,0:05:30.76,0:05:34.65,JP2,,0000,0000,0000,,Жалғыз жолыңда, Мен саған серік боламын.
Dialogue: 0,0:05:34.89,0:05:36.01,JP2,,0000,0000,0000,,Құрметті болыңыз
Dialogue: 0,0:05:37.31,0:05:38.90,JP2,,0000,0000,0000,,Өкінішке орай,
Dialogue: 0,0:05:39.83,0:05:43.61,JP2,,0000,0000,0000,,Менімен қоштасқанда мұңаятын бір-екі әйел бар.
Dialogue: 0,0:05:44.00,0:05:45.32,JP2,,0000,0000,0000,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:05:45.34,0:05:46.84,JP2,,0000,0000,0000,,А...өтірік емес
Dialogue: 0,0:05:47.19,0:05:47.91,JP2,,0000,0000,0000,,(Узуи) Онда мен оның басын керемет шоумендей кесіп тастаймын.
Dialogue: 0,0:05:49.30,0:05:52.63,JP2,,0000,0000,0000,,Біз Комачи мырзадан жауап алдық.
Dialogue: 0,0:05:54.28,0:05:56.00,JP2,,0000,0000,0000,,Рахмет
Dialogue: 0,0:05:56.54,0:06:00.39,JP2,,0000,0000,0000,,Сен несің, өкінбей әлі де оның қамын ойлап жүрсің бе?
Dialogue: 0,0:06:00.56,0:06:02.09,JP2,,0000,0000,0000,,Бұл емес.
Dialogue: 0,0:06:02.09,0:06:02.88,JP2,,0000,0000,0000,,Хун
Dialogue: 0,0:06:02.93,0:06:04.59,JP2,,0000,0000,0000,,Сондықтан
Dialogue: 0,0:06:04.61,0:06:05.37,JP2-,,0000,0000,0000,,(Узуи) Онда мен оның басын керемет шоумендей кесіп тастаймын.
Dialogue: 0,0:06:05.03,0:06:05.92,JP2,,0000,0000,0000,,Жоқ, орындаңыз
Dialogue: 0,0:06:07.22,0:06:09.71,JP2,,0000,0000,0000,,Бір ілгерілеушілік бар ма деп ойлаймын.
Dialogue: 0,0:06:24.54,0:06:27.91,JP2,,0000,0000,0000,,Себебі мен күйзелдім, баратын адамым жоқ.
Dialogue: 0,0:06:28.07,0:06:31.35,JP2,,0000,0000,0000,,Мені кім шақырса, соңынан еремін.
Dialogue: 0,0:06:33.73,0:06:36.94,JP2,,0000,0000,0000,,Бұл кез келген адам жақсы дегенді білдіреді, солай ма?
Dialogue: 0,0:06:37.25,0:06:38.27,JP2,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:06:38.78,0:06:40.27,JP2,,0000,0000,0000,,Қалай ұшу керек
Dialogue: 0,0:06:40.43,0:06:43.24,JP2,,0000,0000,0000,,Мен олай ойламаймын. Бұл жай ғана әзіл.
Dialogue: 0,0:06:43.70,0:06:44.60,JP2,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:06:45.18,0:06:46.78,JP2,,0000,0000,0000,,Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,0:06:48.12,0:06:50.37,JP2,,0000,0000,0000,,Бірақ бұл жай ғана әзіл болса да
Dialogue: 0,0:06:50.63,0:06:53.54,JP2,,0000,0000,0000,,Комачи-доно, осындай ойға толы ән шығарғың келе ме?
Dialogue: 0,0:06:54.81,0:06:58.70,JP2,,0000,0000,0000,,Бұл шынымен де оған ұқсамайды ма?
Dialogue: 0,0:06:59.64,0:07:00.44,JP2,,0000,0000,0000,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,0:07:04.67,0:07:06.68,JP2,,0000,0000,0000,,Лорд Ясухиде Микава еліне барады
Dialogue: 0,0:07:08.10,0:07:10.56,JP2,,0000,0000,0000,,Менің жастық шағымның серіктері кеткенде,
Dialogue: 0,0:07:11.54,0:07:14.52,JP2,,0000,0000,0000,,Әдетте кеудемде терең сақталатын уайым-қайғы көтеріледі.
Dialogue: 0,0:07:16.91,0:07:21.36,JP2,,0000,0000,0000,,Қызық, мен қазір шынымен жалғыз қаламын ба?
Dialogue: 0,0:07:25.30,0:07:30.12,JP2,,0000,0000,0000,,Ән мен сұлулықпен қаруланған Оно но Комачи сарайдың назарын аударды.
Dialogue: 0,0:07:31.61,0:07:35.42,JP2,,0000,0000,0000,,Қазір жайнап тұрған үлкен гүлдердің әуені де
Dialogue: 0,0:07:36.29,0:07:38.40,JP2,,0000,0000,0000,,Қазір ойлап қарасам, бұл өткінші нәрсе еді.
Dialogue: 0,0:07:42.04,0:07:46.24,JP2,,0000,0000,0000,,Императордан ұл болу мүмкін болмады.
Dialogue: 0,0:07:47.21,0:07:52.19,JP2,,0000,0000,0000,,Енді қалған өмірімді ұмытып кеткендей тыныш өткіземін.
Dialogue: 0,0:07:54.98,0:07:58.41,JP2,,0000,0000,0000,,Сол кезде ағамды қабылдаған болсам.
Dialogue: 0,0:08:00.53,0:08:02.86,JP2,,0000,0000,0000,,Егер мен өмірімді қайта бастасам
Dialogue: 0,0:08:03.29,0:08:05.77,JP2,,0000,0000,0000,,Мен басқаша таңдар ма едім?
Dialogue: 0,0:08:06.59,0:08:08.77,JP2,,0000,0000,0000,,Жоқ Сен немене ақымақсың?
Dialogue: 0,0:08:09.36,0:08:10.61,JP2,,0000,0000,0000,,Барлығына дайын болыңыз
Dialogue: 0,0:08:11.05,0:08:13.50,JP2,,0000,0000,0000,,Мен өзім үшін таңдаған жол
Dialogue: 0,0:08:13.70,0:08:14.84,JP2,,0000,0000,0000,,Мен еш өкінбеймін
Dialogue: 0,0:08:17.08,0:08:19.35,JP2,,0000,0000,0000,,Бірақ мен осы уақытқа дейін өмір сүрдім
Dialogue: 0,0:08:19.93,0:08:22.04,JP2,,0000,0000,0000,,Мен не қалдырдым?
Dialogue: 0,0:08:23.04,0:08:26.12,JP2,,0000,0000,0000,,Ол трюк ойнап уақытын босқа өткізіп жатқан жоқ па?
Dialogue: 0,0:08:27.96,0:08:31.04,JP2,,0000,0000,0000,,Дәл осылай мен жалғыз, жалғыз өлемін
Dialogue: 0,0:08:31.88,0:08:34.24,JP2,,0000,0000,0000,,Ол ешкімнің есінде қалмауы мүмкін.
Dialogue: 0,0:08:38.66,0:08:39.38,JP2,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:08:40.21,0:08:42.86,JP2,,0000,0000,0000,,Аға, аға, не істеуіміз керек?
Dialogue: 0,0:08:43.42,0:08:45.92,JP2,,0000,0000,0000,,Мен бұлай болмауым керек еді.
Dialogue: 0,0:08:46.78,0:08:49.13,JP2,,0000,0000,0000,,Бауырым, түсінбедім.
Dialogue: 0,0:08:49.71,0:08:52.61,JP2,,0000,0000,0000,,Менің айтқаным дұрыс па, бұрыс па?
Dialogue: 0,0:08:53.31,0:08:54.34,JP2,,0000,0000,0000,,Аға
Dialogue: 0,0:08:59.33,0:09:03.37,JP2,,0000,0000,0000,,Иә, бұл сенің ағаң.
Dialogue: 0,0:09:04.05,0:09:05.34,JP2,,0000,0000,0000,,Кім?
Dialogue: 0,0:09:06.52,0:09:07.91,JP2,,0000,0000,0000,,Сенің жанасыңды күтемін
Dialogue: 0,0:09:06.10,0:09:10.85,JP2-,,0000,0000,0000,,Ежелгі әлемге сыйлық
Dialogue: 0,0:09:08.26,0:09:09.89,JP2,,0000,0000,0000,,Кім шынымен?
Dialogue: 0,0:09:10.84,0:09:11.92,JP2,,0000,0000,0000,,Жаға
Dialogue: 0,0:09:12.05,0:09:14.27,JP2,,0000,0000,0000,,Мен саған қарамасам, сен не істеп жүрсің?
Dialogue: 0,0:09:15.61,0:09:17.25,JP2,,0000,0000,0000,,Бұл жай ғана сәлемдесу емес пе?
Dialogue: 0,0:09:17.69,0:09:19.47,JP2,,0000,0000,0000,,Не болды, Йошико-сама?
Dialogue: 0,0:09:20.07,0:09:22.27,JP2,,0000,0000,0000,,Жарық Маған жарық беріңіз
Dialogue: 0,0:09:24.84,0:09:27.93,JP2,,0000,0000,0000,,Лорд Ясухиде және Лорд Нарихира
Dialogue: 0,0:09:28.63,0:09:30.23,JP2,,0000,0000,0000,,Иә, қайырлы кеш.
Dialogue: 0,0:09:30.42,0:09:31.82,JP2,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:09:32.27,0:09:34.18,JP2,,0000,0000,0000,,Мен сенен мұндай болады деп күтпеп едім...
Dialogue: 0,0:09:34.23,0:09:37.83,JP2,,0000,0000,0000,,Бұл түсінбеушілік. Біз жай ғана сені көруге келдік.
Dialogue: 0,0:09:37.91,0:09:40.44,JP2,,0000,0000,0000,,Осы кеште көпшілік назарынан жасырылған
Dialogue: 0,0:09:40.47,0:09:41.44,JP2,,0000,0000,0000,,Бұл...
Dialogue: 0,0:09:42.25,0:09:43.49,JP2,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:09:45.97,0:09:49.72,JP2,,0000,0000,0000,,Демек, мен сізге бір ән жібердім.
Dialogue: 0,0:09:50.03,0:09:52.72,JP2,,0000,0000,0000,,Ясухиде-сама менің жағдайыма алаңдады.
Dialogue: 0,0:09:53.05,0:09:56.86,JP2,,0000,0000,0000,,Мен сол жерде болған Нарихира-самаға бармақшы болдым.
Dialogue: 0,0:09:57.53,0:09:59.21,JP2,,0000,0000,0000,,Лорд Нарихира мініп нашар жүрді
Dialogue: 0,0:10:00.51,0:10:02.01,JP2,,0000,0000,0000,,…Бұл дұрыс па?
Dialogue: 0,0:10:02.51,0:10:03.23,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:10:03.81,0:10:06.42,JP2,,0000,0000,0000,,Мазалағаныңыз үшін кешіріңіз, бірақ бұл менің ойымда жоқ.
Dialogue: 0,0:10:06.86,0:10:08.63,JP2,,0000,0000,0000,,Бұл ән жай ғана қалжың еді
Dialogue: 0,0:10:08.80,0:10:12.25,JP2,,0000,0000,0000,,Ясухиде-сама түсінеді.
Dialogue: 0,0:10:13.64,0:10:15.34,JP2,,0000,0000,0000,,Дәлірек айтсақ, Нарихира мырза.
Dialogue: 0,0:10:15.90,0:10:16.58,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:10:17.25,0:10:19.55,JP2,,0000,0000,0000,,Сіздің шашыңыз өте қысқа сияқты.
Dialogue: 0,0:10:20.47,0:10:21.84,JP2,,0000,0000,0000,,Сіз қашан монах болдыңыз?
Dialogue: 0,0:10:23.18,0:10:24.72,JP2,,0000,0000,0000,,Бұл жай ғана косплей
Dialogue: 0,0:10:24.94,0:10:28.26,JP2,,0000,0000,0000,,Үйкеу...Бұл жарты бас.
Dialogue: 0,0:10:28.58,0:10:29.73,JP2,,0000,0000,0000,,Жоқ, шынымен
Dialogue: 0,0:10:30.33,0:10:32.03,JP2,,0000,0000,0000,,Нақты не болды?
Dialogue: 0,0:10:32.77,0:10:35.93,JP2,,0000,0000,0000,,Жарайды, бұл ұзақ әңгіме.
Dialogue: 0,0:10:37.56,0:10:40.70,JP2,,0000,0000,0000,,Жынды жоя алмай, шашын жеп тастады
Dialogue: 0,0:10:42.68,0:10:43.80,JP2,,0000,0000,0000,,өтірік.
Dialogue: 0,0:10:44.19,0:10:45.52,JP2,,0000,0000,0000,,Иә, бұл өтірік деп ойлаймын.
Dialogue: 0,0:10:46.05,0:10:48.76,JP2,,0000,0000,0000,,Мен ғашық болмау керек болған ханшайымға қолымды қойдым.
Dialogue: 0,0:10:49.11,0:10:50.99,JP2,,0000,0000,0000,,Мені ашулы ағам жазалады.
Dialogue: 0,0:10:51.21,0:10:53.80,JP2,,0000,0000,0000,,Менің Такакома не істедің?
Dialogue: 0,0:10:52.73,0:10:53.53,JP2-,,0000,0000,0000,,Итататата
Dialogue: 0,0:10:53.53,0:10:56.11,JP2-,,0000,0000,0000,,Тоқта, аға, Нарихира, қаш.
Dialogue: 0,0:10:56.29,0:10:57.58,JP2,,0000,0000,0000,,Нари Нари
Dialogue: 0,0:10:59.09,0:11:01.15,JP2,,0000,0000,0000,,Бұл апат болды.
Dialogue: 0,0:11:01.93,0:11:02.53,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:11:03.20,0:11:05.70,JP2,,0000,0000,0000,,Сенің жаралы жүрегіңнің күйрегенін түсіндім.
Dialogue: 0,0:11:06.32,0:11:10.10,JP2,,0000,0000,0000,,Қайғыңды шығару үшін ұйықтап жатқанда оларға шабуыл жасау пісіп-жетілмегендік емес пе?
Dialogue: 0,0:11:11.03,0:11:15.59,JP2,,0000,0000,0000,,Мұңымды басу үшін өсіп келе жатқан махаббат сезімін баса алмадым.
Dialogue: 0,0:11:16.21,0:11:17.16,JP2,,0000,0000,0000,,Тағдырымыз өріліп-үйлессін
Dialogue: 0,0:11:18.72,0:11:22.18,JP2,,0000,0000,0000,,Әй, сен маған қашан ғашық болдың?
Dialogue: 0,0:11:22.33,0:11:24.03,JP2,,0000,0000,0000,,Біз алғаш танысқан кезден бері
Dialogue: 0,0:11:24.83,0:11:27.37,JP2,,0000,0000,0000,,Тіпті барудың өзі тек формальдылық.
Dialogue: 0,0:11:27.96,0:11:31.14,JP2,,0000,0000,0000,,Бүгін түнде мен көп жылдар бойы менің сезімімді түсінгеніңізді қалаймын.
Dialogue: 0,0:11:33.82,0:11:35.01,JP2,,0000,0000,0000,,Нарихира-сама
Dialogue: 0,0:11:36.26,0:11:39.27,JP2,,0000,0000,0000,,Жарылған жүрегіңе жұбаныш керек болса, басқа жерден ізде.
Dialogue: 0,0:11:39.43,0:11:40.88,JP2,,0000,0000,0000,,Мен сенімен айналыса алмаймын.
Dialogue: 0,0:11:42.89,0:11:44.53,JP2,,0000,0000,0000,,Қандай суық дос!
Dialogue: 0,0:11:46.85,0:11:48.81,JP2,,0000,0000,0000,,Ал, әзілдер былай тұрсын.
Dialogue: 0,0:11:49.60,0:11:52.17,JP2,,0000,0000,0000,,Мен сені жаңа махаббатпен шатастырып алайын деген ойым жоқ.
Dialogue: 0,0:11:53.56,0:11:55.02,JP2,,0000,0000,0000,,Әйел өз жазасын алды.
Dialogue: 0,0:11:56.13,0:11:59.35,JP2,,0000,0000,0000,,Әй, мен қатты жақсы көрген әйел болды ма деп ойлаймын.
Dialogue: 0,0:12:00.69,0:12:04.21,JP2,,0000,0000,0000,,Сондықтан мен шығыс елдеріне саяхат жасауды ойладым.
Dialogue: 0,0:12:05.07,0:12:07.70,JP2,,0000,0000,0000,,Ясухиде дер кезінде ауылға жіберілетін сияқты.
Dialogue: 0,0:12:08.00,0:12:10.41,JP2,,0000,0000,0000,,Мен сенімен Микава еліне баруды шештім.
Dialogue: 0,0:12:10.71,0:12:11.90,JP2,,0000,0000,0000,,Сіз әлі де айтасыз ба?
Dialogue: 0,0:12:12.23,0:12:14.27,JP2,,0000,0000,0000,,Мен қашан сіздің көлігіңіз болдым?
Dialogue: 0,0:12:14.52,0:12:15.19,JP2,,0000,0000,0000,,Қанағаттанбады ма?
Dialogue: 0,0:12:15.32,0:12:16.47,JP2,,0000,0000,0000,,Мен қанағаттанбаймын.
Dialogue: 0,0:12:16.63,0:12:19.89,JP2,,0000,0000,0000,,Микаваның сіздің қиыншылықтарыңызды тыңдауы неге соншалықты қайғылы?
Dialogue: 0,0:12:19.89,0:12:20.90,JP2,,0000,0000,0000,,Сіз бақыттысыз ба?
Dialogue: 0,0:12:20.91,0:12:21.63,JP2,,0000,0000,0000,,Бақытты емес
Dialogue: 0,0:12:24.01,0:12:26.32,JP2,,0000,0000,0000,,Екеуің мүлде өзгерген жоқсыңдар.
Dialogue: 0,0:12:26.76,0:12:29.65,JP2,,0000,0000,0000,,Кішкентай кезіме қайта оралғандай сезіну қызық.
Dialogue: 0,0:12:31.58,0:12:36.18,JP2,,0000,0000,0000,,Өтінемін, бүгін түн де ​​сол түн.
Dialogue: 0,0:12:37.36,0:12:40.02,JP2,,0000,0000,0000,,Айды тамашалауға арналған сағыныштан ләззат алайық
Dialogue: 0,0:12:46.33,0:12:51.16,JP2,,0000,0000,0000,,Енді бәрі, айды көргенде қалай ойлайсыңдар?
Dialogue: 0,0:12:51.97,0:12:55.26,JP2,,0000,0000,0000,,Балауыздың көбеюі мен азаюы менің жасымды түсінеді.
Dialogue: 0,0:12:55.71,0:12:58.63,JP2,,0000,0000,0000,,Қандай кездейсоқтық, мен де солай ойладым.
Dialogue: 0,0:12:59.15,0:13:01.10,JP2,,0000,0000,0000,,Менің де ойыма осындай нәрсе келді.
Dialogue: 0,0:13:01.97,0:13:05.34,JP2,,0000,0000,0000,,Менің ойымша, бұл менің қиялым болса керек, мен жас көрінеді деп ойладым.
Dialogue: 0,0:13:06.10,0:13:08.03,JP2,,0000,0000,0000,,Ай ғана өзгеріссіз қалады
Dialogue: 0,0:13:08.99,0:13:10.17,JP2,,0000,0000,0000,,Адамдар қозғалады
Dialogue: 0,0:13:11.89,0:13:14.72,JP2,,0000,0000,0000,,Ай бос болса, бақшаға қара
Dialogue: 0,0:13:15.00,0:13:17.42,JP2,,0000,0000,0000,,Қараңдаршы, түйегүлдер әдемі екен.
Dialogue: 0,0:13:17.89,0:13:20.34,JP2,,0000,0000,0000,,Рас, бірақ...
Dialogue: 0,0:13:21.39,0:13:25.88,JP2,,0000,0000,0000,,Түйегүлдердің жанындағы өрік гүлі ұзақ жауған жаңбырдан аянышты көрінеді.
Dialogue: 0,0:13:26.04,0:13:28.93,JP2,,0000,0000,0000,,Қандай жағдай болмасын, сіз істі бос бағытқа алып барасыз.
Dialogue: 0,0:13:29.89,0:13:31.40,JP2,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:13:34.10,0:13:35.81,JP2,,0000,0000,0000,,Айға қарау бос
Dialogue: 0,0:13:36.74,0:13:38.39,JP2,,0000,0000,0000,,Гүл көргенде мұңаямын.
Dialogue: 0,0:13:39.56,0:13:42.47,JP2,,0000,0000,0000,,Бұл сіздің өміріңіз өткеннен кейін көңіл көтерудің адамдық тәсілі.
Dialogue: 0,0:13:42.97,0:13:46.82,JP2,,0000,0000,0000,,Әй, мен сені кәріліктен иммунитет деп ойладым.
Dialogue: 0,0:13:47.06,0:13:51.00,JP2,,0000,0000,0000,,Мұның бәрі жақсы ойластырылған және күткендей, менің жараланған жүрегім маған жауап береді.
Dialogue: 0,0:13:51.33,0:13:52.78,JP2,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:13:53.22,0:13:56.88,JP2,,0000,0000,0000,,Махаббаттан айырылдым деуден гөрі, өмірде жоғалғандай сезінемін.
Dialogue: 0,0:13:57.15,0:14:00.43,JP2,,0000,0000,0000,,Бұл асқақ өмір емес пе?
Dialogue: 0,0:14:00.91,0:14:02.25,JP2,,0000,0000,0000,,Иә, бірақ
Dialogue: 0,0:14:03.21,0:14:06.06,JP2,,0000,0000,0000,,Мен енді еркін сүюге жасым жетпейді.
Dialogue: 0,0:14:08.60,0:14:11.70,JP2,,0000,0000,0000,,Мен өзімді осы адамдай сезінетін әйелмен танысқым келеді.
Dialogue: 0,0:14:11.98,0:14:13.78,JP2,,0000,0000,0000,,Осы уақытқа дейін қаңғып жүрдім.
Dialogue: 0,0:14:14.83,0:14:16.44,JP2,,0000,0000,0000,,Ондай адамды кездестіргенде
Dialogue: 0,0:14:16.89,0:14:19.86,JP2,,0000,0000,0000,,Ол әйел маған тым көп болған кезде
Dialogue: 0,0:14:21.06,0:14:25.06,JP2,,0000,0000,0000,,Мен енді кедергілерді жеңетіндей жас емеспін.
Dialogue: 0,0:14:26.69,0:14:29.55,JP2,,0000,0000,0000,,Бұл мәңгі және мәңгі уәде беретін жыл емес.
Dialogue: 0,0:14:30.23,0:14:32.42,JP2,,0000,0000,0000,,Бұл асыға күтетін жыл емес.
Dialogue: 0,0:14:33.52,0:14:35.64,JP2,,0000,0000,0000,,Адасып, адасып жүрген жерім
Dialogue: 0,0:14:35.68,0:14:39.95,JP2,,0000,0000,0000,,Менің жасымнан өткенім ұят.
Dialogue: 0,0:14:41.19,0:14:44.77,JP2,,0000,0000,0000,,Шынымен, артыңа қарасаң, білмей тұрып,
Dialogue: 0,0:14:45.11,0:14:47.30,JP2,,0000,0000,0000,,Бекер қартаясың.
Dialogue: 0,0:15:06.83,0:15:09.74,JP2,,0000,0000,0000,,Тіпті әдемі гүлдер гүлдеп тұра алмайды.
Dialogue: 0,0:15:10.38,0:15:12.20,JP2,,0000,0000,0000,,Ойланып жүрген кезім
Dialogue: 0,0:15:12.61,0:15:15.74,JP2,,0000,0000,0000,,Мен де аз уақытта кемпір атандым.
Dialogue: 0,0:15:17.85,0:15:20.05,JP2,,0000,0000,0000,,Өткір өлең шығарады.
Dialogue: 0,0:15:21.65,0:15:23.93,JP2,,0000,0000,0000,,Мен де арман қуып өмір сүрдім.
Dialogue: 0,0:15:24.26,0:15:25.21,JP2,,0000,0000,0000,,Адамның денесінде жинақталған
Dialogue: 0,0:15:25.92,0:15:28.35,JP2,,0000,0000,0000,,Егер мен көп адамдар сияқты үйленген болсам, қазірге дейін болар едім.
Dialogue: 0,0:15:37.10,0:15:40.07,JP2,,0000,0000,0000,,Ендеше, енді аяқтайық.
Dialogue: 0,0:15:40.96,0:15:42.95,JP2,,0000,0000,0000,,Келесі жолы ертерек келіңіз.
Dialogue: 0,0:15:43.93,0:15:46.41,JP2,,0000,0000,0000,,Осылайша біз баяу сөйлесе аламыз.
Dialogue: 0,0:15:47.53,0:15:51.19,JP2,,0000,0000,0000,,Микаваға дейін екеуіңмен жақсы қарым-қатынаста болыңдар. Ұрыспа.
Dialogue: 0,0:15:56.97,0:15:57.70,JP2,,0000,0000,0000,,Комачи-доно
Dialogue: 0,0:15:59.00,0:16:03.44,JP2,,0000,0000,0000,,Бұрынғы ән: Басқалар сияқты үйленіп, балалардың ортасында болсам ше?
Dialogue: 0,0:16:04.01,0:16:04.73,JP2,,0000,0000,0000,,Сіз ән айттыңыз ба?
Dialogue: 0,0:16:07.30,0:16:08.88,JP2,,0000,0000,0000,,Мен оны ән айта алмадым деп ойлаймын.
Dialogue: 0,0:16:10.05,0:16:14.31,JP2,,0000,0000,0000,,Көп нәрсеге уайымдап, уақытыңды барар жерім жоқ өткізіп жүрген сен екенсің ғой, оқып үлгердім.
Dialogue: 0,0:16:16.48,0:16:19.04,JP2,,0000,0000,0000,,Ал сіз кімді тыңдайтыныңызды да таңдамайсыз.
Dialogue: 0,0:16:20.21,0:16:23.62,JP2,,0000,0000,0000,,Әр адамның үлкен-кіші өкініші болады.
Dialogue: 0,0:16:24.68,0:16:25.99,JP2,,0000,0000,0000,,Сол жүректі түртіңіз
Dialogue: 0,0:16:26.92,0:16:29.56,JP2,,0000,0000,0000,,Сіздің әніңіз сондай жақсы ән.
Dialogue: 0,0:16:30.61,0:16:32.36,JP2,,0000,0000,0000,,Ән – біздің мекен
Dialogue: 0,0:16:33.45,0:16:35.31,JP2,,0000,0000,0000,,Сіз мұны баяғыда айттыңыз.
Dialogue: 0,0:16:36.16,0:16:36.82,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:16:37.39,0:16:39.46,JP2,,0000,0000,0000,,Ясухиде де осыған ұқсас нәрсені айтқан.
Dialogue: 0,0:16:40.55,0:16:44.11,JP2,,0000,0000,0000,,Мен де соңғы кездері бұл туралы көп ойлап жүрмін.
Dialogue: 0,0:16:45.15,0:16:48.09,JP2,,0000,0000,0000,,Мен абайсызда көп қиыншылық туғыздым.
Dialogue: 0,0:16:48.77,0:16:51.49,JP2,,0000,0000,0000,,Өткенге қарасам, өмірімде өкініштен басқа ештеңе жоқ.
Dialogue: 0,0:16:51.99,0:16:55.31,JP2,,0000,0000,0000,,Осының өзінде де артта бірдеңе қалды.
Dialogue: 0,0:16:55.49,0:16:56.59,JP2,,0000,0000,0000,,Бұл өте жақсы.
Dialogue: 0,0:16:57.64,0:16:59.02,JP2,,0000,0000,0000,,Балалар сендер де солай.
Dialogue: 0,0:17:01.13,0:17:03.58,JP2,,0000,0000,0000,,Артымызға ән қалдырдық
Dialogue: 0,0:17:05.28,0:17:10.39,JP2,,0000,0000,0000,,Жоғары көтерілу немесе балалы болу - өзін артта қалдырудың жалғыз жолы емес.
Dialogue: 0,0:17:10.90,0:17:11.82,JP2,,0000,0000,0000,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,0:17:12.58,0:17:16.47,JP2,,0000,0000,0000,,Ақын болғандықтан, өміріміздің дәлелін жырлаймыз.
Dialogue: 0,0:17:16.85,0:17:18.52,JP2,,0000,0000,0000,,Адамдардың жүрегінде қалуы мүмкін
Dialogue: 0,0:17:18.86,0:17:21.35,JP2,,0000,0000,0000,,Ендеше, қиын кезде де жүрегімізді ұстайық.
Dialogue: 0,0:17:21.92,0:17:24.21,JP2,,0000,0000,0000,,Ал мен көп уайымдайтын боламын
Dialogue: 0,0:17:24.50,0:17:26.51,JP2,,0000,0000,0000,,Артымызда өз әндерімізді қалдырайық
Dialogue: 0,0:17:30.32,0:17:30.99,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:17:35.44,0:17:36.63,JP2,,0000,0000,0000,,Сонымен Комачи
Dialogue: 0,0:17:37.71,0:17:39.07,JP2,,0000,0000,0000,,Микаваға бірге барайық
Dialogue: 0,0:17:42.07,0:17:42.96,JP2,,0000,0000,0000,,Босанғаннан кейінгі
Dialogue: 0,0:17:43.13,0:17:46.09,JP2,,0000,0000,0000,,Е...шақырудың маңызды екенін білмедім.
Dialogue: 0,0:17:46.41,0:17:48.23,JP2,,0000,0000,0000,,Жоқ, әрине қалжыңдадым.
Dialogue: 0,0:17:48.31,0:17:51.09,JP2,,0000,0000,0000,,Нарихира-доно екеуміз сирек сапарға шыққанымыз үшін кешірім сұраймын.
Dialogue: 0,0:17:51.80,0:17:53.26,JP2,,0000,0000,0000,,Бұл менің жолым
Dialogue: 0,0:17:53.70,0:17:57.38,JP2,,0000,0000,0000,,Бірақ мен қалада өстім, сондықтан ауыл аздап
Dialogue: 0,0:17:57.61,0:17:59.85,JP2,,0000,0000,0000,,Жапон ұлттық құрамасы жеңіске жетті ғой, иә?
Dialogue: 0,0:18:00.36,0:18:03.53,JP2,,0000,0000,0000,,Мен кейінгі ұрпақпын, Комачи-доно, өтінемін.
Dialogue: 0,0:18:04.50,0:18:05.18,JP2,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:18:06.96,0:18:10.86,JP2,,0000,0000,0000,,Мені шақырған гүл тұқымын қалдыра алмады.
Dialogue: 0,0:18:11.53,0:18:13.53,JP2,,0000,0000,0000,,Бірақ бұл көрініс жырға айналды
Dialogue: 0,0:18:13.81,0:18:17.18,JP2,,0000,0000,0000,,Сөнбей мәңгі қала ма?
Dialogue: 0,0:18:18.49,0:18:22.67,JP2,,0000,0000,0000,,Өмірімнің мәні сонда болды деп ойлағаным дұрыс па?
Dialogue: 0,0:18:23.70,0:18:27.13,JP2,,0000,0000,0000,,Мен мұны болашақта көп рет еске алатыныма сенімдімін.
Dialogue: 0,0:18:27.96,0:18:32.70,JP2,,0000,0000,0000,,Егер мен өмірімді қайта өмір сүре алсам, мен әртүрлі таңдаулар жасай аламын ба?
Dialogue: 0,0:18:33.53,0:18:37.60,JP2,,0000,0000,0000,,Жауабы уайым мен табандылықтың барар жерінде
Dialogue: 0,0:18:38.67,0:18:41.23,JP2,,0000,0000,0000,,Енді шешейік.
Dialogue: 0,0:18:47.59,0:18:48.73,JP2,,0000,0000,0000,,Осылайша
Dialogue: 0,0:18:49.09,0:18:55.77,JP2,,0000,0000,0000,,Ясухиде, Комачи және Нарихира Жапонияның шығыс бөлігін кезіп жүрген дейді.
Dialogue: 0,0:18:56.33,0:19:00.77,JP2,,0000,0000,0000,,О, Кисенбоши-доно, мен бұл әңгімені бірінші рет естіп тұрмын.
Dialogue: 0,0:19:01.34,0:19:04.71,JP2,,0000,0000,0000,,Жарайды, бұл кейін Ясухидеден естіген әңгіме.
Dialogue: 0,0:19:05.16,0:19:07.14,JP2,,0000,0000,0000,,Шындықты білудің жолы жоқ
Dialogue: 0,0:19:08.33,0:19:09.32,JP2,,0000,0000,0000,,На Цураюки
Dialogue: 0,0:19:09.70,0:19:10.53,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:19:11.02,0:19:13.44,JP2,,0000,0000,0000,,Мен біраз уақыттан бері мұқият жазып жүрмін.
Dialogue: 0,0:19:14.19,0:19:17.84,JP2,,0000,0000,0000,,Бұл оқиға императорлық вака өлеңдер жинағының алғы сөзіне қосылмақ па?
Dialogue: 0,0:19:19.22,0:19:20.94,JP2,,0000,0000,0000,,Жоқ, бұл бөлек мәселе.
Dialogue: 0,0:19:21.29,0:19:25.27,JP2,,0000,0000,0000,,Нарихираның ғашықтық өмірін баяндау жоспары бар.
Dialogue: 0,0:19:25.69,0:19:28.36,JP2,,0000,0000,0000,,Бес генерал-лейтенант туралы әңгімені ата
Dialogue: 0,0:19:28.52,0:19:31.34,JP2,,0000,0000,0000,,Ах, Исе Моногатари жақсы атау болуы мүмкін.
Dialogue: 0,0:19:31.67,0:19:33.51,JP2,,0000,0000,0000,,Әңгіме
Dialogue: 0,0:19:34.18,0:19:37.34,JP2,,0000,0000,0000,,Қазіргі уақытта лақап атпен жазылған әңгімелер танымал.
Dialogue: 0,0:19:37.91,0:19:41.04,JP2,,0000,0000,0000,,Мен мұны Нарихираның үлгісіне негізделген туынды ретінде жазып отырмын.
Dialogue: 0,0:19:41.38,0:19:43.27,JP2,,0000,0000,0000,,Әйелдер арасында да танымал
Dialogue: 0,0:19:43.86,0:19:47.75,JP2,,0000,0000,0000,,Байқадым, бүркеншік атпен жазылған әңгімелер ел аузында.
Dialogue: 0,0:19:48.56,0:19:50.69,JP2,,0000,0000,0000,,Бұл жақсы уақыт.
Dialogue: 0,0:19:52.07,0:19:55.36,JP2,,0000,0000,0000,,Әңгіме немесе вака өлеңдерінің империялық жинағы.
Dialogue: 0,0:19:55.95,0:19:59.44,JP2,,0000,0000,0000,,Енді ән патша сарайына толығымен еніп кетті,
Dialogue: 0,0:19:59.55,0:20:00.81,JP2,,0000,0000,0000,,Бұл болды.
Dialogue: 0,0:20:01.42,0:20:05.25,JP2,,0000,0000,0000,,Жас кезімде ән айту тек хобби болатын.
Dialogue: 0,0:20:05.57,0:20:08.05,JP2,,0000,0000,0000,,Ақындардың жай ғана әуесқой болған кездері болды.
Dialogue: 0,0:20:08.81,0:20:11.82,JP2,,0000,0000,0000,,Алайда Ясухиде және басқалардың ойы басқаша болды.
Dialogue: 0,0:20:12.51,0:20:14.90,JP2,,0000,0000,0000,,Мен осында тұра бастағаннан кейін көп ұзамай
Dialogue: 0,0:20:15.64,0:20:18.43,JP2,,0000,0000,0000,,Ясухиде осы эрмитажды көруге келді.
Dialogue: 0,0:20:19.44,0:20:21.43,JP2,,0000,0000,0000,,Бұл өте әдемі үй.
Dialogue: 0,0:20:21.75,0:20:23.74,JP2,,0000,0000,0000,,Хаха, ыңғайсыздықтар көп болса да.
Dialogue: 0,0:20:24.50,0:20:28.41,JP2,,0000,0000,0000,,Елорданың күйбең тірлігі бұл жерде саған жетпейді, сондықтан оны дүниелік адамдарға жеткізесің.
Dialogue: 0,0:20:28.74,0:20:31.78,JP2,,0000,0000,0000,,Не, сен маған жабық адам сияқты қарайсың ба?
Dialogue: 0,0:20:32.41,0:20:35.26,JP2,,0000,0000,0000,,Жоқ, астанада солай болды.
Dialogue: 0,0:20:35.96,0:20:38.59,JP2,,0000,0000,0000,,Мен мұнда өз таңдауыммен келдім.
Dialogue: 0,0:20:39.52,0:20:43.13,JP2,,0000,0000,0000,,Елордадан қашқысы келетіндер соны айтып жатқан шығар.
Dialogue: 0,0:20:53.42,0:20:57.01,JP2,,0000,0000,0000,,Маған бұл жерде тұру ұнайды, өйткені ол тыныш және босаңсытады.
Dialogue: 0,0:20:57.18,0:21:00.59,JP2,,0000,0000,0000,,«Қалада тұрудан шаршап, қашып кетті» деген бос әңгіме бар сияқты.
Dialogue: 0,0:21:02.18,0:21:04.91,JP2,,0000,0000,0000,,Мен сені қызғанатын шығармын.
Dialogue: 0,0:21:05.61,0:21:10.67,JP2,,0000,0000,0000,,Ол қашып кетті, бірақ мен қиын заманда қолымнан келгенді істеп жатырмын деп өзімді жұбатқым келеді.
Dialogue: 0,0:21:11.09,0:21:13.76,JP2,,0000,0000,0000,,Онда неге үйден шығып тауға келмейсің?
Dialogue: 0,0:21:14.73,0:21:17.36,JP2,,0000,0000,0000,,Өзіңіз қалағандай ән айтыңыз.
Dialogue: 0,0:21:20.69,0:21:25.03,JP2,,0000,0000,0000,,Мунесада монах болғаннан кейін де ақын ретінде үлкен еңбек етті.
Dialogue: 0,0:21:25.87,0:21:30.43,JP2,,0000,0000,0000,,Мен ән айтуды хобби деп ойламаймын, оны өмірде алға басу үшін пайдаланғым келеді.
Dialogue: 0,0:21:30.94,0:21:31.47,JP2,,0000,0000,0000,,Хо
Dialogue: 0,0:21:32.06,0:21:34.77,JP2,,0000,0000,0000,,Міне, сіз осы жерді таңдаған сияқтысыз.
Dialogue: 0,0:21:35.18,0:21:37.32,JP2,,0000,0000,0000,,Мен де астанада болуды таңдаймын.
Dialogue: 0,0:21:39.21,0:21:44.13,JP2,,0000,0000,0000,,Енді ойлап қарасам, Ясухиде патша сарайында поэзияның орын алатын кезі келетініне сенген.
Dialogue: 0,0:21:44.21,0:21:46.11,JP2,,0000,0000,0000,,Мүмкін мен оны күткен шығармын.
Dialogue: 0,0:21:46.23,0:21:46.87,JP2,,0000,0000,0000,,Иә
Dialogue: 0,0:21:47.15,0:21:49.67,JP2,,0000,0000,0000,,Мен ол болмай тұрып өлдім, қазірге дейін.
Dialogue: 0,0:21:49.98,0:21:51.58,JP2,,0000,0000,0000,,О дүниеде қызғаныш болады.
Dialogue: 0,0:21:51.65,0:21:54.30,JP2,,0000,0000,0000,,Дүние дүние болса, мен де таңдаушы бола аламын...
Dialogue: 0,0:21:57.08,0:22:01.65,JP2,,0000,0000,0000,,Бірақ бұл қазіргі ақындардың өмір сүруінің үлкен мәні болды емес пе?
Dialogue: 0,0:22:03.85,0:22:07.56,JP2,,0000,0000,0000,,Солардың кесірінен императордың бұйрығымен өлеңдер жинағын құрастыратын кез келді.
Dialogue: 0,0:22:08.26,0:22:11.47,JP2,,0000,0000,0000,,Олардың әндері мен ойлары бүгінгі күнмен байланысты.
Dialogue: 0,0:22:12.04,0:22:16.10,JP2,,0000,0000,0000,,Сондықтан алғысөзде олардың есімдерін атап өткім келеді.
Dialogue: 0,0:22:17.36,0:22:19.89,JP2,,0000,0000,0000,,Мұны естігеніме қуаныштымын.
Dialogue: 0,0:22:21.43,0:22:23.33,JP2,,0000,0000,0000,,Олар Рокукасен деп аталады.
Dialogue: 0,0:22:23.71,0:22:28.48,JP2,,0000,0000,0000,,Әншіліктің әлеуметтік жағдайы аса жоғары болмаған кезде де кім ән шығаруды жалғастырды?
Dialogue: 0,0:22:29.07,0:22:32.15,JP2,,0000,0000,0000,,Себебі мен әнге деген сүйіспеншілігімді мақтан тұттым
Dialogue: 0,0:22:33.81,0:22:35.97,JP2,,0000,0000,0000,,Мен не қалдыра аламын?
Dialogue: 0,0:22:36.38,0:22:37.86,JP2,,0000,0000,0000,,Өйткені мен әнге салынғанмын
Dialogue: 0,0:22:38.60,0:22:41.38,JP2,,0000,0000,0000,,Дұрыс, Цураюки-сенпай.
Dialogue: 0,0:22:41.58,0:22:42.67,JP2,,0000,0000,0000,,С… Сол әйел
Dialogue: 0,0:24:17.03,0:24:22.18,JP2,,0000,0000,0000,,Түнде болса да ұзақ жарқыраған кесе
Dialogue: 0,0:24:23.13,0:24:27.10,JP2,,0000,0000,0000,,Дондон қызғылт Пери Перишауся
Dialogue: 0,0:00:04.73,0:00:08.28,CN,,0000,0000,0000,,Бұл Ираго Рио.
Dialogue: 0,0:00:09.39,0:00:14.51,CN,,0000,0000,0000,,Бұл шалғай жерде көп жапырақ жиналған кез.
Dialogue: 0,0:00:15.86,0:00:24.83,&,,0000,0000,0000,,Эйкё өміріндегі өкініш
Dialogue: 0,0:00:17.49,0:00:24.83,&,,0000,0000,0000,,Көлдің дымқыл киімдері
Dialogue: 0,0:00:18.53,0:00:24.83,&,,0000,0000,0000,,Ираго жағалауы
Dialogue: 0,0:00:20.16,0:00:24.83,&,,0000,0000,0000,,Тамамо жеміс-жидек қарын тойы
Dialogue: 0,0:00:25.43,0:00:29.83,CN,,0000,0000,0000,,Басқа әндер осында
Dialogue: 0,0:00:30.09,0:00:32.07,CN,,0000,0000,0000,,Мен ештеңе істеп жатқан жоқпын.
Dialogue: 0,0:00:32.88,0:00:36.11,CN,,0000,0000,0000,,Комачи аллегориясы
Dialogue: 0,0:00:36.39,0:00:39.60,CN,,0000,0000,0000,,Бұл ақын Дайтоның вака үйіне байланысты.
Dialogue: 0,0:00:40.34,0:00:42.83,CN,,0000,0000,0000,,Әннің ең қолайлы түрін төбеге саяхат жасады
Dialogue: 0,0:00:40.34,0:00:42.83,,,0000,0000,0000,,Ескерту: Өлеңнің басы: Вакамакура дикциясындағы жер атауы, Цукуба таудың екінші шоғырланған жері.
Dialogue: 0,0:00:43.15,0:00:45.14,CN,,0000,0000,0000,,Қасиетті жерге зиярат ету де.
Dialogue: 0,0:00:46.47,0:00:50.00,CN,,0000,0000,0000,,Фудзи тауы.
Dialogue: 0,0:00:51.54,0:00:53.38,CN,,0000,0000,0000,,Фудзи тауы шығыста орналасқан
Dialogue: 0,0:00:53.57,0:00:56.20,CN,,0000,0000,0000,,Бұл менің сүйікті ерте көруім.
Dialogue: 0,0:00:57.23,0:01:00.65,CN,,0000,0000,0000,,Мен көргендегі Фудзи тауының оқиғасы.
Dialogue: 0,0:01:01.53,0:01:05.10,CN,,0000,0000,0000,,Жапондық қызыл адамдар Джинрен Ваканың сол әдемі пейзажы
Dialogue: 0,0:01:05.98,0:01:08.63,CN,,0000,0000,0000,,Маған қатты әсер қалдырды.
Dialogue: 0,0:01:09.47,0:01:10.46,CN,,0000,0000,0000,,Үй қызметшісі
Dialogue: 0,0:01:12.26,0:01:15.39,CN,,0000,0000,0000,,Менің қайда екенімді және тұратын жерім туралы қысқаша мәлімет...
Dialogue: 0,0:03:03.60,0:03:04.31,CN,,0000,0000,0000,,Ересек Йошико
Dialogue: 0,0:03:05.94,0:03:08.44,CN,,0000,0000,0000,,Ясухиденің кәмелеттік жасқа толуы
Dialogue: 0,0:03:09.17,0:03:09.89,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:10.51,0:03:12.29,CN,,0000,0000,0000,,Бұл жаңа жылдық сұрақ.
Dialogue: 0,0:03:12.60,0:03:15.49,CN,,0000,0000,0000,,Мені сыйлайтын тағы бір адам
Dialogue: 0,0:03:17.16,0:03:20.64,CN,,0000,0000,0000,,Басқалармен бірінші кездескен кезде мен императордың киімін ауыстырып жатқан адаммын.
Dialogue: 0,0:03:21.69,0:03:24.14,CN,,0000,0000,0000,,Ясухиде ересек Мен жұмыс істейтін ересек адаммын
Dialogue: 0,0:03:24.95,0:03:27.27,CN,,0000,0000,0000,,Үш адам, бір тегі, ай рухы
Dialogue: 0,0:03:28.04,0:03:30.36,CN,,0000,0000,0000,,Одан кейін келіп-кететін кітап та бар.
Dialogue: 0,0:03:32.07,0:03:35.64,CN,,0000,0000,0000,,Қазіргі уақытта оның сансыз достары бар.
Dialogue: 0,0:03:36.78,0:03:38.38,CN,,0000,0000,0000,,Жаңа жыл құтты болсын
Dialogue: 0,0:03:39.09,0:03:42.74,CN,,0000,0000,0000,,Дене саулығыңызды атап өтіп, жаңа жылдан ләззат алыңыз
Dialogue: 0,0:03:43.91,0:03:47.32,CN,,0000,0000,0000,,Содан кейін мені Микаваға ауыстырды.
Dialogue: 0,0:03:48.25,0:03:51.54,CN,,0000,0000,0000,,Ересек Ясухиде Микава елінен кетуі керек.
Dialogue: 0,0:03:52.20,0:03:55.71,CN,,0000,0000,0000,,Өзін ойлап, жұмысқа жалғыз баруға болады.
Dialogue: 0,0:03:55.89,0:03:57.68,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:58.55,0:04:00.28,CN,,0000,0000,0000,,Сынған консервілері сынған басқа жақсы суреттер.
Dialogue: 0,0:04:01.33,0:04:05.97,CN,,0000,0000,0000,,Жас бос уақыт, қабілет, қабілет және Ичики Микавата бағы жел мен жарықпен бірге
Dialogue: 0,0:04:06.53,0:04:07.31,CN,,0000,0000,0000,,Күлкі ойнау~
Dialogue: 0,0:04:07.82,0:04:08.65,CN,,0000,0000,0000,,Биыл да
Dialogue: 0,0:04:11.33,0:04:13.47,CN,,0000,0000,0000,,Махаббатпен ойнау қызық
Dialogue: 0,0:04:14.00,0:04:16.57,CN,,0000,0000,0000,,Басқа жұмыстармен жалпы таныстыру
Dialogue: 0,0:04:16.89,0:04:19.53,CN,,0000,0000,0000,,Сізге неше рет қажет?
Dialogue: 0,0:04:19.86,0:04:23.86,&,,0000,0000,0000,,Төменгі Шығыс
Dialogue: 0,0:04:19.86,0:04:23.86,,,0000,0000,0000,,Оно Комачи
Dialogue: 0,0:04:36.56,0:04:38.59,CN,,0000,0000,0000,,Ерлікке, берілгендікке баулу
Dialogue: 0,0:04:38.89,0:04:41.09,CN,,0000,0000,0000,,Комачи ересектер қауымдастығы неше рет кездесті?
Dialogue: 0,0:04:42.04,0:04:44.27,CN,,0000,0000,0000,,Байқаусыз, әдетте байқалмайды
Dialogue: 0,0:04:44.66,0:04:47.27,CN,,0000,0000,0000,,Дегенмен, бұл жағдай.
Dialogue: 0,0:04:48.81,0:04:53.04,CN,,0000,0000,0000,,Келу━(ﾟ∀ﾟ)━! ! !
Dialogue: 0,0:04:55.68,0:04:56.94,CN,,0000,0000,0000,,Жаңа жылыңызбен～
Dialogue: 0,0:04:57.25,0:04:59.11,CN,,0000,0000,0000,,Жұмыс…Ересектер
Dialogue: 0,0:05:00.04,0:05:01.82,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:03.61,0:05:04.74,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:05.00,0:05:07.26,CN,,0000,0000,0000,,Бұл бастапқы оқиғаға негізделген әңгіме.
Dialogue: 0,0:05:07.71,0:05:08.69,CN,,0000,0000,0000,,Сөйлесу циклі
Dialogue: 0,0:05:10.49,0:05:12.49,CN,,0000,0000,0000,,Әдемі әйелге ұқсайтын Микава Рёку
Dialogue: 0,0:05:12.68,0:05:15.17,CN,,0000,0000,0000,,Жақсы бейненің тағы бір мысалы
Dialogue: 0,0:05:15.37,0:05:16.54,CN,,0000,0000,0000,,Ниет түзеуге қарсы
Dialogue: 0,0:05:16.67,0:05:17.89,CN,,0000,0000,0000,,Дарынсыз
Dialogue: 0,0:05:18.05,0:05:20.81,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:21.25,0:05:22.02,CN,,0000,0000,0000,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:05:22.56,0:05:25.58,CN,,0000,0000,0000,,Шығысқа баруды бірінші рет ойлап отырмын.
Dialogue: 0,0:05:26.35,0:05:29.94,CN,,0000,0000,0000,,Меншікке қарсы тұру және аяғын киген әйелді кездестірмеу.
Dialogue: 0,0:05:30.09,0:05:30.64,CN,,0000,0000,0000,,Менің ашуым
Dialogue: 0,0:05:30.76,0:05:34.65,CN,,0000,0000,0000,,Жалғыздық жолында
Dialogue: 0,0:05:34.89,0:05:36.01,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:37.31,0:05:38.90,CN,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз
Dialogue: 0,0:05:39.83,0:05:43.61,CN,,0000,0000,0000,,Мен де әйелмін, мен де әйелмін.
Dialogue: 0,0:05:44.00,0:05:45.32,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:45.34,0:05:46.84,CN,,0000,0000,0000,,Айтты... дарынды, талантты емес.
Dialogue: 0,0:05:47.19,0:05:47.91,CN,,0000,0000,0000,,Шайқас аяқталды…
Dialogue: 0,0:05:49.30,0:05:52.63,CN,,0000,0000,0000,,Комачи ересек адамның хабары келді
Dialogue: 0,0:05:54.28,0:05:56.00,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:56.54,0:06:00.39,CN,,0000,0000,0000,,Шындық мынада, сіз табыт материалын көрмейсіз.
Dialogue: 0,0:06:00.56,0:06:02.09,CN,,0000,0000,0000,,Жауапсыздық
Dialogue: 0,0:06:02.09,0:06:02.88,CN,,0000,0000,0000,,О?
Dialogue: 0,0:06:02.93,0:06:04.59,CN,,0000,0000,0000,,Бұл менмін...
Dialogue: 0,0:06:04.61,0:06:05.37,,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:06:05.03,0:06:05.92,CN,,0000,0000,0000,,Бұл сіздің өрнек.
Dialogue: 0,0:06:07.22,0:06:09.71,CN,,0000,0000,0000,,Мен көрген көрме
Dialogue: 0,0:06:14.72,0:06:31.87,&,,0000,0000,0000,,Жалғыз тұру мерзімсіз
Dialogue: 0,0:06:16.27,0:06:31.87,&,,0000,0000,0000,,Өзін-өзі жою
Dialogue: 0,0:06:17.85,0:06:31.87,&,,0000,0000,0000,,Жастар кімдер?
Dialogue: 0,0:06:19.85,0:06:31.87,&,,0000,0000,0000,,Өзін-өзі тағайындаған лорд
Dialogue: 0,0:06:24.54,0:06:27.91,CN,,0000,0000,0000,,Өзімнен көңілім қалды
Dialogue: 0,0:06:28.07,0:06:31.35,CN,,0000,0000,0000,,Жас тәжірибесі
Dialogue: 0,0:06:33.73,0:06:36.94,CN,,0000,0000,0000,,Бұл нені білдіреді? Жәй адам. Кім жасай алады?
Dialogue: 0,0:06:37.25,0:06:38.27,CN,,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:06:38.78,0:06:40.27,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:40.43,0:06:43.24,CN,,0000,0000,0000,,Ойнауға болады, бірақ ойнауға болмайды.
Dialogue: 0,0:06:43.70,0:06:44.60,CN,,0000,0000,0000,,Тортты да жей алмай ма?
Dialogue: 0,0:06:45.18,0:06:46.78,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:48.12,0:06:50.37,CN,,0000,0000,0000,,Бұл тұрарлық емес
Dialogue: 0,0:06:50.63,0:06:53.54,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:54.81,0:06:58.70,CN,,0000,0000,0000,,Суреттің нақты стилі
Dialogue: 0,0:06:59.64,0:07:00.44,CN,,0000,0000,0000,,Ауырды! Өте қатты ауырды! Тоқта, тоқта! Қол тигізбе!
Dialogue: 0,0:07:04.67,0:07:06.68,CN,,0000,0000,0000,,Ясухиденің Микаваға көшуі
Dialogue: 0,0:07:08.10,0:07:10.56,CN,,0000,0000,0000,,Достық жылдар өтті
Dialogue: 0,0:07:11.54,0:07:14.52,CN,,0000,0000,0000,,Мен қатты уайымдап, су ағып жатыр
Dialogue: 0,0:07:16.91,0:07:21.36,CN,,0000,0000,0000,,Қазіргі уақытта мен нақты адам емеспін.
Dialogue: 0,0:07:25.30,0:07:30.12,CN,,0000,0000,0000,,Жапон поэзиясының автопортрет сұлулығының техникасы және Оно Комачидің ғибадатханадағы денесінің жарқырауы.
Dialogue: 0,0:07:31.61,0:07:35.42,CN,,0000,0000,0000,,Алушының аты-жөні
Dialogue: 0,0:07:36.29,0:07:38.40,CN,,0000,0000,0000,,Енді мен оны елестетсем, бұрын ешқашан көрген емеспін.
Dialogue: 0,0:07:42.04,0:07:46.24,CN,,0000,0000,0000,,Император Гаваның тұсында қайтыс болған князь
Dialogue: 0,0:07:47.21,0:07:52.19,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:54.98,0:07:58.41,CN,,0000,0000,0000,,Қабылдауды қалай қабылдадыңыз?
Dialogue: 0,0:08:00.53,0:08:02.86,CN,,0000,0000,0000,,Өмірдің мүмкін болатыны және жаңа қайта тірілу туралы әңгіме
Dialogue: 0,0:08:03.29,0:08:05.77,CN,,0000,0000,0000,,Мен басқа жолды таңдаймын.
Dialogue: 0,0:08:06.59,0:08:08.77,CN,,0000,0000,0000,,Мен сенімен сөйлесу үшін келген жоқпын
Dialogue: 0,0:08:09.36,0:08:10.61,CN,,0000,0000,0000,,Мен қазір қайда екенімді қалай білемін?
Dialogue: 0,0:08:11.05,0:08:13.50,CN,,0000,0000,0000,,Бұл жол менің өз таңдауым.
Dialogue: 0,0:08:13.70,0:08:14.84,CN,,0000,0000,0000,,Мен өкінемін
Dialogue: 0,0:08:17.08,0:08:19.35,CN,,0000,0000,0000,,Дегенмен, өмір қазір
Dialogue: 0,0:08:19.93,0:08:22.04,CN,,0000,0000,0000,,Мен оқуымды аяқтадым.
Dialogue: 0,0:08:23.04,0:08:26.12,CN,,0000,0000,0000,,Соққыға қолайлы уақыт емес.
Dialogue: 0,0:08:27.96,0:08:31.04,CN,,0000,0000,0000,,Адам жалғыз жерде қайтыс болды
Dialogue: 0,0:08:31.88,0:08:34.24,CN,,0000,0000,0000,,Ол жерде ешқашан болмаған адамдардың естеліктерінің ізі де бар.
Dialogue: 0,0:08:38.66,0:08:39.38,CN,,0000,0000,0000,,Сол сәтте менің өмірімнің соңы келген еді
Dialogue: 0,0:08:40.21,0:08:42.86,CN,,0000,0000,0000,,Гор Гор Гор Кешіріңіз
Dialogue: 0,0:08:43.42,0:08:45.92,CN,,0000,0000,0000,,Мен не істерімді білмеймін.
Dialogue: 0,0:08:46.78,0:08:49.13,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:49.71,0:08:52.61,CN,,0000,0000,0000,,Менің таңдауым – түпкі мақсат.
Dialogue: 0,0:08:53.31,0:08:54.34,CN,,0000,0000,0000,,Гор
Dialogue: 0,0:08:59.33,0:09:03.37,CN,,0000,0000,0000,,Мен осындамын
Dialogue: 0,0:09:04.05,0:09:05.34,CN,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:09:06.52,0:09:07.91,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:06.10,0:09:10.85,,,0000,0000,0000,,Ежелгі жапон халқы, сызық өзгермейді, бірақ жарық ағыны ежелгі уақытта бірнеше рет қайтады.
Dialogue: 0,0:09:08.26,0:09:09.89,CN,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:09:10.84,0:09:11.92,CN,,0000,0000,0000,,Яғни, сіз полиция қызметкерісіз ғой, иә? Не істеп отырсыз өзі?
Dialogue: 0,0:09:12.05,0:09:14.27,CN,,0000,0000,0000,,Жоспар жазуға ақшам жетпей қалды.
Dialogue: 0,0:09:15.61,0:09:17.25,CN,,0000,0000,0000,,Егер олай болмаса, командаға қоңырау шалыңыз.
Dialogue: 0,0:09:17.69,0:09:19.47,CN,,0000,0000,0000,,Ересек Йошико
Dialogue: 0,0:09:20.07,0:09:22.27,CN,,0000,0000,0000,,Жарық
Dialogue: 0,0:09:24.84,0:09:27.93,CN,,0000,0000,0000,,Ясухиде ересек Казухэй ересек
Dialogue: 0,0:09:28.63,0:09:30.23,CN,,0000,0000,0000,,Йошитака Йосуке~
Dialogue: 0,0:09:30.42,0:09:31.82,CN,,0000,0000,0000,,Сіздің ойларыңыз бен тілектеріңіз
Dialogue: 0,0:09:32.27,0:09:34.18,CN,,0000,0000,0000,,Ойлағанда не болды...
Dialogue: 0,0:09:34.23,0:09:37.83,CN,,0000,0000,0000,,Жиналыс аяқталды.
Dialogue: 0,0:09:37.91,0:09:40.44,CN,,0000,0000,0000,,Сіз осында болсаңыз, түн батып кетті.
Dialogue: 0,0:09:40.47,0:09:41.44,CN,,0000,0000,0000,,Жоқ
Dialogue: 0,0:09:42.25,0:09:43.49,CN,,0000,0000,0000,,Жәрдемақы түрлері....
Dialogue: 0,0:09:45.97,0:09:49.72,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:50.03,0:09:52.72,CN,,0000,0000,0000,,Ясухиде ересек мұғалім Шинга
Dialogue: 0,0:09:53.05,0:09:56.86,CN,,0000,0000,0000,,Мен қазіргі бизнесімде ыңғайлылық пен шеберлікті іздеймін
Dialogue: 0,0:09:57.53,0:09:59.21,CN,,0000,0000,0000,,Ересек адамның әңгімесі
Dialogue: 0,0:10:00.51,0:10:02.01,CN,,0000,0000,0000,,…Бұл келесі эпизод
Dialogue: 0,0:10:02.51,0:10:03.23,CN,,0000,0000,0000,,Дұрыс және бұрыс
Dialogue: 0,0:10:03.81,0:10:06.42,CN,,0000,0000,0000,,Жеңістен қорықпайтыныңыз рас, бірақ жеңілу керек.
Dialogue: 0,0:10:06.86,0:10:08.63,CN,,0000,0000,0000,,Накубу Вака күлкілі емес
Dialogue: 0,0:10:08.80,0:10:12.25,CN,,0000,0000,0000,,Менің ересек адам екенім анық.
Dialogue: 0,0:10:13.64,0:10:15.34,CN,,0000,0000,0000,,Ересектерге арналған сөйлесу уақыты
Dialogue: 0,0:10:15.90,0:10:16.58,CN,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:10:17.25,0:10:19.55,CN,,0000,0000,0000,,Сіздің басыңыз қысқа.
Dialogue: 0,0:10:20.47,0:10:21.84,CN,,0000,0000,0000,,Кездейсоқ тұрғын үй
Dialogue: 0,0:10:23.18,0:10:24.72,CN,,0000,0000,0000,,Бұл жай Косплей~
Dialogue: 0,0:10:24.94,0:10:28.26,CN,,0000,0000,0000,,Cos... cos
Dialogue: 0,0:10:28.58,0:10:29.73,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:30.33,0:10:32.03,CN,,0000,0000,0000,,Өмірдің соңғы кезеңі
Dialogue: 0,0:10:32.77,0:10:35.93,CN,,0000,0000,0000,,Қоңырау соғылғанына қанша уақыт болды?
Dialogue: 0,0:10:37.56,0:10:40.70,CN,,0000,0000,0000,,Қарғаның әрекеті сәтсіз болды.
Dialogue: 0,0:10:42.68,0:10:43.80,CN,,0000,0000,0000,,Ойнап жатырмыз
Dialogue: 0,0:10:44.19,0:10:45.52,CN,,0000,0000,0000,,Менің білгенім күлкілі әңгіме
Dialogue: 0,0:10:46.05,0:10:48.76,CN,,0000,0000,0000,,Себебі мен бірінші орынға бояуды аяқтай алмаймын.
Dialogue: 0,0:10:49.11,0:10:50.99,CN,,0000,0000,0000,,Нәтижесінде Гананың басы сәтті болып, оттың ортасындағы от сөндірілді.
Dialogue: 0,0:10:51.21,0:10:53.80,CN,,0000,0000,0000,,Сіз менің отбасымның орта мектебіне келдіңіз! ! !
Dialogue: 0,0:10:52.73,0:10:53.53,,,0000,0000,0000,,Жақсы ауырсыну~
Dialogue: 0,0:10:53.53,0:10:56.11,,,0000,0000,0000,,Қажетсіз күлкі, жан тыныштығы
Dialogue: 0,0:10:56.29,0:10:57.58,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:59.09,0:11:01.15,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:01.93,0:11:02.53,CN,,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:11:03.20,0:11:05.70,CN,,0000,0000,0000,,Жарылған жүректен кейін өзін жайсыз және анық сезіну сезімі
Dialogue: 0,0:11:06.32,0:11:10.10,CN,,0000,0000,0000,,Сіз ұйықтап жатқанда түсіне аласыз.
Dialogue: 0,0:11:11.03,0:11:15.59,CN,,0000,0000,0000,,Мен сені сүйемін, бірақ мен сені сүйемін.
Dialogue: 0,0:11:16.21,0:11:17.16,CN,,0000,0000,0000,,Дегенмен, бұл
Dialogue: 0,0:11:18.72,0:11:22.18,CN,,0000,0000,0000,,Мен сен үшін сол кезде қуаныштымын.
Dialogue: 0,0:11:22.33,0:11:24.03,CN,,0000,0000,0000,,Бірінші кездесу болған кезде
Dialogue: 0,0:11:24.83,0:11:27.37,CN,,0000,0000,0000,,Бұл келесі әңгіме барлау, сонымен қатар бетпе-бет әңгіме.
Dialogue: 0,0:11:27.96,0:11:31.14,CN,,0000,0000,0000,,Осы кеште мен Ноичироның ұзақ жылдар бойына өзімшіл сағынышын түсінгім келеді.
Dialogue: 0,0:11:33.82,0:11:35.01,CN,,0000,0000,0000,,Ересек\N26-бөлім
Dialogue: 0,0:11:36.26,0:11:39.27,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:39.43,0:11:40.88,CN,,0000,0000,0000,,Вакафухоби
Dialogue: 0,0:11:42.89,0:11:44.53,CN,,0000,0000,0000,,Шындық – суық дос
Dialogue: 0,0:11:46.85,0:11:48.81,CN,,0000,0000,0000,,Сәттілік.
Dialogue: 0,0:11:49.60,0:11:52.17,CN,,0000,0000,0000,,Махаббаттың жаңа түрі келеді және кетеді
Dialogue: 0,0:11:53.56,0:11:55.02,CN,,0000,0000,0000,,Мен әйелмін.
Dialogue: 0,0:11:56.13,0:11:59.35,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:00.69,0:12:04.21,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:05.07,0:12:07.70,CN,,0000,0000,0000,,Масатака Ясухиде жеңіліске ұшырап, Микавадан кетіп қалды.
Dialogue: 0,0:12:08.00,0:12:10.41,CN,,0000,0000,0000,,Басқа адамдарға еріп жүру
Dialogue: 0,0:12:10.71,0:12:11.90,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:12.23,0:12:14.27,CN,,0000,0000,0000,,Мен сіздің тапсырысыңызды сол уақытта орындай аламын.
Dialogue: 0,0:12:14.52,0:12:15.19,CN,,0000,0000,0000,,Қанағаттанбады
Dialogue: 0,0:12:15.32,0:12:16.47,CN,,0000,0000,0000,,Табиғи толық емес
Dialogue: 0,0:12:16.63,0:12:19.89,CN,,0000,0000,0000,,Жолдағы өмірімдегі трагедиялық үрдістердің тарихы
Dialogue: 0,0:12:19.89,0:12:20.90,CN,,0000,0000,0000,,Жүрегіңді ашуға болады
Dialogue: 0,0:12:20.91,0:12:21.63,CN,,0000,0000,0000,,Ашық жүрек апа
Dialogue: 0,0:12:24.01,0:12:26.32,CN,,0000,0000,0000,,Егер сіз ұшатын болсаңыз, бұл бір ұпай.
Dialogue: 0,0:12:26.76,0:12:29.65,CN,,0000,0000,0000,,Жылдың жақсы бейнесіне жеткенде
Dialogue: 0,0:12:31.58,0:12:36.18,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:37.36,0:12:40.02,CN,,0000,0000,0000,,Ішу мен ішудің басы мен өткені
Dialogue: 0,0:12:46.33,0:12:51.16,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:51.97,0:12:55.26,CN,,0000,0000,0000,,Айлы әлем жай ғана өзін-өзі нашарлататын терең сезім
Dialogue: 0,0:12:55.71,0:12:58.63,CN,,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:12:59.15,0:13:01.10,CN,,0000,0000,0000,,Мен сізбен келісемін.
Dialogue: 0,0:13:01.97,0:13:05.34,CN,,0000,0000,0000,,Жастық шағыма оралу менің тәжірибем емес.
Dialogue: 0,0:13:06.10,0:13:08.03,CN,,0000,0000,0000,,Айдың жарығы өзгермейді
Dialogue: 0,0:13:08.99,0:13:10.17,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:11.89,0:13:14.72,CN,,0000,0000,0000,,Бақ көркі мен бақ көркі
Dialogue: 0,0:13:15.00,0:13:17.42,CN,,0000,0000,0000,,Сасанква гүлінің дамуын қараңыз
Dialogue: 0,0:13:17.89,0:13:20.34,CN,,0000,0000,0000,,Бұл рас…
Dialogue: 0,0:13:21.39,0:13:25.88,CN,,0000,0000,0000,,Сасанква гүлі жаңбырда гүлдейді, алдыңғы күнгі жаңбыр, нөлдің қорқынышты құлауы
Dialogue: 0,0:13:26.04,0:13:28.93,CN,,0000,0000,0000,,Осында болсаң, қайғыдан түңіліп қаласың.
Dialogue: 0,0:13:29.89,0:13:31.40,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:34.10,0:13:35.81,CN,,0000,0000,0000,,Жарамсыздығы
Dialogue: 0,0:13:36.74,0:13:38.39,CN,,0000,0000,0000,,Гүл өмірінің мұңы
Dialogue: 0,0:13:39.56,0:13:42.47,CN,,0000,0000,0000,,Бұл берекелі жылы өмір сүрген адамның әңгімесі.
Dialogue: 0,0:13:42.97,0:13:46.82,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:47.06,0:13:51.00,CN,,0000,0000,0000,,Жаралы жүректе жатқанда терең сезім бар.
Dialogue: 0,0:13:51.33,0:13:52.78,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:53.22,0:13:56.88,CN,,0000,0000,0000,,Жүректің жаралы екенін айту – жаралы жүректің әңгімесі.
Dialogue: 0,0:13:57.15,0:14:00.43,CN,,0000,0000,0000,,Одан кейін өмір жолы онша жақсы емес.
Dialogue: 0,0:14:00.91,0:14:02.25,CN,,0000,0000,0000,,…
Dialogue: 0,0:14:03.21,0:14:06.06,CN,,0000,0000,0000,,Қазіргі уақытта қолымнан келмейді, бірақ тегін махаббат жылы аяқталды.
Dialogue: 0,0:14:08.60,0:14:11.70,CN,,0000,0000,0000,,Егер сіз белгілі бір адамға тап болсаңыз
Dialogue: 0,0:14:11.98,0:14:13.78,CN,,0000,0000,0000,,Мен тікелей позициядамын.
Dialogue: 0,0:14:14.83,0:14:16.44,CN,,0000,0000,0000,,Менің өмірімде кенеттен пайда болуым мүмкін бе?
Dialogue: 0,0:14:16.89,0:14:19.86,CN,,0000,0000,0000,,Біздің жеке күтім жоспарларымыз кезінде
Dialogue: 0,0:14:21.06,0:14:25.06,CN,,0000,0000,0000,,Заңды енді қайталамаймын, барлық кедергілерді жеңемін.
Dialogue: 0,0:14:26.69,0:14:29.55,CN,,0000,0000,0000,,Көп уақыттың ортасында жүргеніме көп болды.
Dialogue: 0,0:14:30.23,0:14:32.42,CN,,0000,0000,0000,,Сондай-ақ күтілетін жыл болуы мүмкін емес.
Dialogue: 0,0:14:33.52,0:14:35.64,CN,,0000,0000,0000,,Адасып, адасып, соңына дейін жүгіріп
Dialogue: 0,0:14:35.68,0:14:39.95,CN,,0000,0000,0000,,Өзін-өзі жетілдіру – бұл жай өтірік
Dialogue: 0,0:14:41.19,0:14:44.77,CN,,0000,0000,0000,,Үзінді
Dialogue: 0,0:14:45.11,0:14:47.30,CN,,0000,0000,0000,,Надандық надандық
Dialogue: 0,0:14:56.54,0:15:15.47,&,,0000,0000,0000,,Гүл түсінің соңы
Dialogue: 0,0:14:58.20,0:15:15.47,&,,0000,0000,0000,,Қызыл түстен ләззат алу
Dialogue: 0,0:14:59.58,0:15:15.47,&,,0000,0000,0000,,Жаңбырлы ауа райы
Dialogue: 0,0:15:01.37,0:15:15.47,&,,0000,0000,0000,,Өз бетінше жұмыс істеу
Dialogue: 0,0:15:06.83,0:15:09.74,CN,,0000,0000,0000,,Қайтадан ағып жатқан гүл бақшасы және шексіз гүлдену
Dialogue: 0,0:15:10.38,0:15:12.20,CN,,0000,0000,0000,,Мұң мен қасірет бар
Dialogue: 0,0:15:12.61,0:15:15.74,CN,,0000,0000,0000,,Өлімнен аман қалу
Dialogue: 0,0:15:17.85,0:15:20.05,CN,,0000,0000,0000,,Бастың уақасы – трагедиялық оқиға
Dialogue: 0,0:15:21.65,0:15:23.93,CN,,0000,0000,0000,,Мен де өз армандарымды орындаймын.
Dialogue: 0,0:15:24.26,0:15:25.21,CN,,0000,0000,0000,,Көп ақпарат алып, жұмысты аяқтады.
Dialogue: 0,0:15:25.92,0:15:28.35,CN,,0000,0000,0000,,Қарапайым адамдардың үйлену тарихы да қазіргі уақытта қолжетімді...
Dialogue: 0,0:15:37.10,0:15:40.07,CN,,0000,0000,0000,,Сәттілік!
Dialogue: 0,0:15:40.96,0:15:42.95,CN,,0000,0000,0000,,Төменгі келесі нүкте ерте
Dialogue: 0,0:15:43.93,0:15:46.41,CN,,0000,0000,0000,,Жұмыс істеуге дайын болған кезде
Dialogue: 0,0:15:47.53,0:15:51.19,CN,,0000,0000,0000,,Микаваны екі позицияның ортасында кездестіруге болады, бірақ бұл қажет емес.
Dialogue: 0,0:15:56.97,0:15:57.70,CN,,0000,0000,0000,,Ересек Комачи
Dialogue: 0,0:15:59.00,0:16:03.44,CN,,0000,0000,0000,,Жас, қарапайым адам, жалпы неке баласы
Dialogue: 0,0:16:04.01,0:16:04.73,CN,,0000,0000,0000,,Сондай-ақ өлең жазу мүмкін емес
Dialogue: 0,0:16:07.30,0:16:08.88,CN,,0000,0000,0000,,Мен оны көре алмаймын
Dialogue: 0,0:16:10.05,0:16:14.31,CN,,0000,0000,0000,,Жалғыз дүниеде талантыңды баурап алған өлең.
Dialogue: 0,0:16:16.48,0:16:19.04,CN,,0000,0000,0000,,Дегенмен, қанша адам кінәлі емес?
Dialogue: 0,0:16:20.21,0:16:23.62,CN,,0000,0000,0000,,Үлкен-кіші әр адамға тәубе
Dialogue: 0,0:16:24.68,0:16:25.99,CN,,0000,0000,0000,,Біреудің жүрегіне әсер ету
Dialogue: 0,0:16:26.92,0:16:29.56,CN,,0000,0000,0000,,Жақсы адамның жақсы әні.
Dialogue: 0,0:16:30.61,0:16:32.36,CN,,0000,0000,0000,,Вакашу – менің өмір сүрген жерім.
Dialogue: 0,0:16:33.45,0:16:35.31,CN,,0000,0000,0000,,Бұрын сізге айтылған болатын
Dialogue: 0,0:16:36.16,0:16:36.82,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:37.39,0:16:39.46,CN,,0000,0000,0000,,Кан Хидеяның әңгімесі
Dialogue: 0,0:16:40.55,0:16:44.11,CN,,0000,0000,0000,,Жақында жұмысқа орналасқанымда мен де көп нәрсені есіме түсірдім.
Dialogue: 0,0:16:45.15,0:16:48.09,CN,,0000,0000,0000,,Қаңғыбас, қаңғыбас өмір.
Dialogue: 0,0:16:48.77,0:16:51.49,CN,,0000,0000,0000,,Өткенді еске түсіру, Өкінішке толы өмір
Dialogue: 0,0:16:51.99,0:16:55.31,CN,,0000,0000,0000,,Дүниенің шығысы мен батысында екені рас.
Dialogue: 0,0:16:55.49,0:16:56.59,CN,,0000,0000,0000,,Ойлар мен ойлар тривиальды.
Dialogue: 0,0:16:57.64,0:16:59.02,CN,,0000,0000,0000,,Сіз де осындасыз.
Dialogue: 0,0:17:01.13,0:17:03.58,CN,,0000,0000,0000,,Вака Мен қалуға келдім
Dialogue: 0,0:17:05.28,0:17:10.39,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:10.90,0:17:11.82,CN,,0000,0000,0000,,Дұрыс және бұрыс
Dialogue: 0,0:17:12.58,0:17:16.47,CN,,0000,0000,0000,,Дұрыс себеп, мен ақынмын, талантты генералмын, өз-өзім мен уақамын.
Dialogue: 0,0:17:16.85,0:17:18.52,CN,,0000,0000,0000,,Шетелдіктердің өз-өзіне қол жұмсауы
Dialogue: 0,0:17:18.86,0:17:21.35,CN,,0000,0000,0000,,Осыған байланысты
Dialogue: 0,0:17:21.92,0:17:24.21,CN,,0000,0000,0000,,Осыдан кейін сіз 3000-ға келесіз
Dialogue: 0,0:17:24.50,0:17:26.51,CN,,0000,0000,0000,,Өзінің вака мөрі
Dialogue: 0,0:17:30.32,0:17:30.99,CN,,0000,0000,0000,,Қазірге дейін
Dialogue: 0,0:17:35.44,0:17:36.63,CN,,0000,0000,0000,,Комачи үшін
Dialogue: 0,0:17:37.71,0:17:39.07,CN,,0000,0000,0000,,Мен алғаш рет тұрып, Микавадан шыққан кезде
Dialogue: 0,0:17:42.07,0:17:42.96,CN,,0000,0000,0000,,Жауаптар
Dialogue: 0,0:17:43.13,0:17:46.09,CN,,0000,0000,0000,,Басқаша айтқанда, оның рас екені рас.
Dialogue: 0,0:17:46.41,0:17:48.23,CN,,0000,0000,0000,,Табиғи емес табиғат жай ғана ойнап тұр
Dialogue: 0,0:17:48.31,0:17:51.09,CN,,0000,0000,0000,,Алайда ересек адамның баспалдақпен көтерілуі мүмкін емес.
Dialogue: 0,0:17:51.80,0:17:53.26,CN,,0000,0000,0000,,Жеке жазғаным
Dialogue: 0,0:17:53.70,0:17:57.38,CN,,0000,0000,0000,,Алайда мен астанадамын, мен сарайдамын, мен сарайдамын ...\N7-тарау
Dialogue: 0,0:17:57.61,0:17:59.85,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:00.36,0:18:03.53,CN,,0000,0000,0000,,Комачи ересек адамның сұраққа жауабы
Dialogue: 0,0:18:04.50,0:18:05.18,CN,,0000,0000,0000,,Қалай өлетінің рас
Dialogue: 0,0:18:06.96,0:18:10.86,CN,,0000,0000,0000,,Менде бар гүлдердің түрлері
Dialogue: 0,0:18:11.53,0:18:13.53,CN,,0000,0000,0000,,Дегенмен, бұл менің жалпы жиналысыммен жасалған уақ.
Dialogue: 0,0:18:13.81,0:18:17.18,CN,,0000,0000,0000,,Дүние ағыны мәңгілік және ешқашан сөнбейді.
Dialogue: 0,0:18:18.49,0:18:22.67,CN,,0000,0000,0000,,Менің аман қалу ниетім осында.
Dialogue: 0,0:18:23.70,0:18:27.13,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:27.96,0:18:32.70,CN,,0000,0000,0000,,Жас өмір сүруге болады, бірақ менің амалым жоқ.
Dialogue: 0,0:18:33.53,0:18:37.60,CN,,0000,0000,0000,,Бұл мәселе.
Dialogue: 0,0:18:38.67,0:18:41.23,CN,,0000,0000,0000,,Пайдаланушының өміріне қайта жауап беру
Dialogue: 0,0:18:45.72,0:18:48.73,&,,0000,0000,0000,,Сатып алу арқылы таңдалады
Dialogue: 0,0:18:45.72,0:18:48.73,,,0000,0000,0000,,Кисен заңгері
Dialogue: 0,0:18:47.59,0:18:48.73,CN,,0000,0000,0000,,Жұмыс орны
Dialogue: 0,0:18:49.09,0:18:55.77,CN,,0000,0000,0000,,Ясухиде Комачи Казухей Санниннің Шығыс еліне саяхаты
Dialogue: 0,0:18:56.33,0:19:00.77,CN,,0000,0000,0000,,Иә, бұл әңгімені әңгіменің бірінші нұсқасы бойынша жазуға болады.
Dialogue: 0,0:19:01.34,0:19:04.71,CN,,0000,0000,0000,,Бұл орындалмады.
Dialogue: 0,0:19:05.16,0:19:07.14,CN,,0000,0000,0000,,Бұл рас, маңызды емес.
Dialogue: 0,0:19:08.33,0:19:09.32,CN,,0000,0000,0000,,Сатып алуды растау
Dialogue: 0,0:19:09.70,0:19:10.53,CN,,0000,0000,0000,,Ондық
Dialogue: 0,0:19:11.02,0:19:13.44,CN,,0000,0000,0000,,Жазбаны бір жерден қарау
Dialogue: 0,0:19:14.19,0:19:17.84,CN,,0000,0000,0000,,Осы әңгіменің транскрипциясының алғысөз бөлігі
Dialogue: 0,0:19:19.22,0:19:20.94,CN,,0000,0000,0000,,Жеке пайдалануға арналмаған
Dialogue: 0,0:19:21.29,0:19:25.27,CN,,0000,0000,0000,,Сізде ересектерге арналған жалпы махаббат хикаясы болғандықтан, тіл жоспарын қайта қарауға болады.
Dialogue: 0,0:19:25.69,0:19:28.36,CN,,0000,0000,0000,,Торияма Зайго Чуджо Моногатари
Dialogue: 0,0:19:28.52,0:19:31.34,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:31.67,0:19:33.51,CN,,0000,0000,0000,,Әңгіме?
Dialogue: 0,0:19:34.18,0:19:37.34,CN,,0000,0000,0000,,Қазіргі уақытта танымал әңгіме
Dialogue: 0,0:19:37.91,0:19:41.04,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:41.38,0:19:43.27,CN,,0000,0000,0000,,Алайда орта мектепте әйелдер жоқ.
Dialogue: 0,0:19:43.86,0:19:47.75,CN,,0000,0000,0000,,Әңгіменің бастапқы шығу тегі басталып, кең тараған.
Dialogue: 0,0:19:48.56,0:19:50.69,CN,,0000,0000,0000,,Қазір не шындық?
Dialogue: 0,0:19:52.07,0:19:55.36,CN,,0000,0000,0000,,Жапон тілі және жапон өлеңдер жинағы
Dialogue: 0,0:19:55.95,0:19:59.44,CN,,0000,0000,0000,,Дұрыс - сарайдың себебі
Dialogue: 0,0:19:59.55,0:20:00.81,CN,,0000,0000,0000,,Бұл кішкентай талант жүзеге асты.
Dialogue: 0,0:20:01.42,0:20:05.25,CN,,0000,0000,0000,,Вака поэзиясы менің сүйікті емес.
Dialogue: 0,0:20:05.57,0:20:08.05,CN,,0000,0000,0000,,Ақын да ақыннан бөлек.
Dialogue: 0,0:20:08.81,0:20:11.82,CN,,0000,0000,0000,,Алайда Ясухиде және басқалардың ойлары әртүрлі.
Dialogue: 0,0:20:12.51,0:20:14.90,CN,,0000,0000,0000,,Мен мұндамын, мен осындамын, мен мұндамын
Dialogue: 0,0:20:15.64,0:20:18.43,CN,,0000,0000,0000,,Кан Сюй Цзэн осы ауылға келді
Dialogue: 0,0:20:19.44,0:20:21.43,CN,,0000,0000,0000,,Жергілікті табиғат көрінісі
Dialogue: 0,0:20:21.75,0:20:23.74,CN,,0000,0000,0000,,Көптеген қолайсыздықтар бар.
Dialogue: 0,0:20:24.50,0:20:28.41,CN,,0000,0000,0000,,Дүние астанадан алыс, Дүниеден бөлек дүние.
Dialogue: 0,0:20:28.74,0:20:31.78,CN,,0000,0000,0000,,Мен қашып кетсем екен.
Dialogue: 0,0:20:32.41,0:20:35.26,CN,,0000,0000,0000,,Мұнда емес.
Dialogue: 0,0:20:35.96,0:20:38.59,CN,,0000,0000,0000,,Мен өзімнің дарындылығымның арқасында өз-өзімнен ләззат алуға ғана қызығамын.
Dialogue: 0,0:20:39.52,0:20:43.13,CN,,0000,0000,0000,,Ойы астанадан қашу.
Dialogue: 0,0:20:45.30,0:20:54.19,&,,0000,0000,0000,,Соңында Шығыс Оңтүстікте орналасқан
Dialogue: 0,0:20:46.84,0:20:54.19,&,,0000,0000,0000,,Уджияма
Dialogue: 0,0:20:48.01,0:20:54.19,&,,0000,0000,0000,,Мен кеттім
Dialogue: 0,0:20:49.51,0:20:54.19,&,,0000,0000,0000,,Сөздер мен дүние шулары
Dialogue: 0,0:20:53.42,0:20:57.01,CN,,0000,0000,0000,,Мен мұнда болғаныма қуаныштымын.
Dialogue: 0,0:20:57.18,0:21:00.59,CN,,0000,0000,0000,,Дүниеші болудан шаршасаң, осындасың.
Dialogue: 0,0:21:02.18,0:21:04.91,CN,,0000,0000,0000,,Басқалардың қалауы осында.
Dialogue: 0,0:21:05.61,0:21:10.67,CN,,0000,0000,0000,,Өзін-өзі жұбататын әңгіме: ``Мен өзіме қарамастан қашып кеттім, мен бұл дүниеде әлі де тырыстым.''
Dialogue: 0,0:21:11.09,0:21:13.76,CN,,0000,0000,0000,,Накая үйді тағайындады
Dialogue: 0,0:21:14.73,0:21:17.36,CN,,0000,0000,0000,,Вакаяны ұстауға рұқсат етілмейді.
Dialogue: 0,0:21:20.69,0:21:25.03,CN,,0000,0000,0000,,Атақты, дарынды ақын
Dialogue: 0,0:21:25.87,0:21:30.43,CN,,0000,0000,0000,,Кагашавака сіздің қызығушылықтарыңыздың себебі емес, бірақ бұл туралы ойлаудың жолы.
Dialogue: 0,0:21:30.94,0:21:31.47,CN,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:21:32.06,0:21:34.77,CN,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:21:35.18,0:21:37.32,CN,,0000,0000,0000,,Мен де өз басым тұрғынмын.
Dialogue: 0,0:21:39.21,0:21:44.13,CN,,0000,0000,0000,,Қазіргі уақытта мен Кан Хидеяның қазіргі жағдайын көрдім.
Dialogue: 0,0:21:44.21,0:21:46.11,CN,,0000,0000,0000,,Вака ғибадатхананың ортасында болған кезеңде.
Dialogue: 0,0:21:46.23,0:21:46.87,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:47.15,0:21:49.67,CN,,0000,0000,0000,,Басқа адамның өлімі үшін кешірім сұраймыз.
Dialogue: 0,0:21:49.98,0:21:51.58,CN,,0000,0000,0000,,Қазіргі уақытта әлемде кек жоқ.
Dialogue: 0,0:21:51.65,0:21:54.30,CN,,0000,0000,0000,,Мен де табысты адам болған жақсы уақыт туралы әңгіме...
Dialogue: 0,0:21:57.08,0:22:01.65,CN,,0000,0000,0000,,Алайда басқа қазіргі ақындардың болуы маңызды емес.
Dialogue: 0,0:22:03.85,0:22:07.56,CN,,0000,0000,0000,,Шынайы себеп бар және басқалары Фэнтян императорының мандаты мезгіл-мезгіл жапон өлеңдер жинағында жинақталған.
Dialogue: 0,0:22:08.26,0:22:11.47,CN,,0000,0000,0000,,...
Dialogue: 0,0:22:12.04,0:22:16.10,CN,,0000,0000,0000,,...
Dialogue: 0,0:22:17.36,0:22:19.89,CN,,0000,0000,0000,,Қарияға алғысым шексіз.
Dialogue: 0,0:22:21.43,0:22:23.33,CN,,0000,0000,0000,,Рокукасен және т.б
Dialogue: 0,0:22:23.71,0:22:28.48,CN,,0000,0000,0000,,...
Dialogue: 0,0:22:29.07,0:22:32.15,CN,,0000,0000,0000,,Әр адам қатты жақсы көреді және өзін-өзі мақтан тұтады.
Dialogue: 0,0:22:33.81,0:22:35.97,CN,,0000,0000,0000,,Өзін-өзі қосу
Dialogue: 0,0:22:36.38,0:22:37.86,CN,,0000,0000,0000,,Зенто Йорию Вакано орта мектебі
Dialogue: 0,0:22:38.60,0:22:41.38,CN,,0000,0000,0000,,Бұл сатып алудың алдыңғы бөлігі.
Dialogue: 0,0:22:41.58,0:22:42.67,CN,,0000,0000,0000,,...
Dialogue: 0,0:24:14.93,0:24:29.90,&,,0000,0000,0000,,Вакаджо +
Dialogue: 0,0:24:17.03,0:24:22.18,CN,,0000,0000,0000,,...
Dialogue: 0,0:24:23.13,0:24:27.10,CN,,0000,0000,0000,,...
