Dialogue: 0,0:00:03.88,0:00:07.91,JP,,0000,0000,0000,,Хейанкиодағы G1 ГРАН-ПРИ
Dialogue: 0,0:00:08.66,0:00:10.55,JP,,0000,0000,0000,,Күн де жетті
Dialogue: 0,0:00:11.04,0:00:13.05,JP,,0000,0000,0000,,Тарихтағы жаңа есікті ашу
Dialogue: 0,0:00:13.15,0:00:16.26,JP,,0000,0000,0000,,1-ші Өгіз арба Хейанкиодағы БІР ГРАН-ПРИ
Dialogue: 0,0:00:16.89,0:00:19.03,JP,,0000,0000,0000,,Мен тікелей эфирдегі комментатор Тейка Фудзиварамын
Dialogue: 0,0:00:19.29,0:00:21.67,JP,,0000,0000,0000,,Йорицуна Уцуномияның түсіндірмесі
Dialogue: 0,0:00:21.92,0:00:22.99,JP,,0000,0000,0000,,Алдын ала рахмет
Dialogue: 0,0:00:23.44,0:00:25.10,JP,,0000,0000,0000,,Йорицуна-сан, ақыры келді.
Dialogue: 0,0:00:25.29,0:00:26.26,JP,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:00:26.33,0:00:30.59,JP,,0000,0000,0000,,Бейбітшілік әлеміне жаңа жел соғатын маңызды оқиға. Оған назар аударған жөн.
Dialogue: 0,0:00:31.24,0:00:33.83,JP,,0000,0000,0000,,Енді мен сізді қызықтыратын курстармен таныстыруға рұқсат етіңіздер.
Dialogue: 0,0:00:34.48,0:00:36.36,JP,,0000,0000,0000,,Созақүйдің жанындағы бастапқы сызықтан
Dialogue: 0,0:00:36.45,0:00:37.63,JP,,0000,0000,0000,,Сузакудзи арқылы оңтүстікке қарай жүріңіз
Dialogue: 0,0:00:37.74,0:00:39.39,JP,,0000,0000,0000,,Рашомоннан шығып, шығысқа қарай жүріңіз.
Dialogue: 0,0:00:39.53,0:00:42.49,JP,,0000,0000,0000,,Солтүстікке бір рет барып, Камогава өзенінен өтіп, Киёмизу-дера храмына барыңыз.
Dialogue: 0,0:00:42.55,0:00:43.82,JP,,0000,0000,0000,,Шұңқыр осында болады
Dialogue: 0,0:00:43.85,0:00:45.77,JP,,0000,0000,0000,,Камогава өзенінен қайта өтіп, солтүстікке қарай жүріңіз
Dialogue: 0,0:00:45.82,0:00:48.86,JP,,0000,0000,0000,,Ичиджо-оджи бойымен батысқа қарай жүріп, Дайдери бойымен солға бұрылыңыз.
Dialogue: 0,0:00:49.05,0:00:51.35,JP,,0000,0000,0000,,Сузакудзиге қайтатын қалалық курс
Dialogue: 0,0:00:51.54,0:00:53.54,JP,,0000,0000,0000,,Йорицуна мырза, оның мәні неде?
Dialogue: 0,0:00:53.90,0:00:56.59,JP,,0000,0000,0000,,Бұл Киёмизу-дера храмының жанындағы еңіс болуы керек.
Dialogue: 0,0:00:56.77,0:00:58.60,JP,,0000,0000,0000,,Жоғары да, төмен де өте тік.
Dialogue: 0,0:00:59.01,0:01:01.24,JP,,0000,0000,0000,,Жетілдірілген малды бақылау қажет
Dialogue: 0,0:01:01.89,0:01:03.85,JP,,0000,0000,0000,,Әрі қарай - бастапқы тұтқа.
Dialogue: 0,0:01:04.54,0:01:07.45,JP,,0000,0000,0000,,Полюс орны дыбыс жылдамдығының түсіне байланысты Нарихира Аривара
Dialogue: 0,0:01:07.86,0:01:10.70,JP,,0000,0000,0000,,Алдыңғы қатардағы жас шабандоз ат, Садааки Йосейин
Dialogue: 0,0:01:11.12,0:01:14.38,JP,,0000,0000,0000,,Үшінші орында техникалар дүкені Ясухиде Буня.
Dialogue: 0,0:01:14.75,0:01:17.34,JP,,0000,0000,0000,,Төртінші Inaba Hawk Нарихира Аривара
Dialogue: 0,0:01:17.72,0:01:20.43,JP,,0000,0000,0000,,5-ші 100 Баллок арбасының шайқасы Риошиму Мунесада
Dialogue: 0,0:01:20.80,0:01:23.70,JP,,0000,0000,0000,,Ал соңғысы Уджидің жұмбақ монахы Кисенбоши.
Dialogue: 0,0:01:23.99,0:01:26.12,JP,,0000,0000,0000,,Алдын ала турда сәтсіздікке ұшыраған адам - ​​Отомо Куронуши.
Dialogue: 0,0:01:26.75,0:01:29.94,JP,,0000,0000,0000,,Енді даңқты бірінші тағына кім отырады?
Dialogue: 0,0:01:30.28,0:01:32.28,JP,,0000,0000,0000,,Тарихи бастауға аз ғана уақыт қалды
Dialogue: 0,0:03:23.82,0:03:26.72,JP,,0000,0000,0000,,Сәлем, Тейканың бөлмесі уақыты.
Dialogue: 0,0:03:27.01,0:03:30.21,JP,,0000,0000,0000,,Бүгінгі қонақтар ерте Хэйан кезеңін бояған үш адам.
Dialogue: 0,0:03:30.39,0:03:35.50,JP,,0000,0000,0000,,Нарихира Аривара мырза, Комачи Оно мырза және Ясухиде Фумия мырза.
Dialogue: 0,0:03:35.78,0:03:36.40,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:03:36.72,0:03:37.31,JP,,0000,0000,0000,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:03:37.74,0:03:40.58,JP,,0000,0000,0000,,Бәрің де Рокукасен болып сайланған ақынсыңдар.
Dialogue: 0,0:03:41.01,0:03:45.22,JP,,0000,0000,0000,,Сондай-ақ, Нарихира - Хикару Генджиге үлгі болғандардың бірі деп айтылатын әдемі жігіт.
Dialogue: 0,0:03:46.02,0:03:47.99,JP,,0000,0000,0000,,Комачи ханым әлемдегі ең әдемі үш әйелдің бірі
Dialogue: 0,0:03:48.53,0:03:50.89,JP,,0000,0000,0000,,Және уһ
Dialogue: 0,0:03:51.63,0:03:53.44,JP,,0000,0000,0000,,Сөздердің шебері Ясухиде
Dialogue: 0,0:03:53.89,0:03:55.03,JP,,0000,0000,0000,,Назар аударғаныңызға рахмет
Dialogue: 0,0:03:56.04,0:04:00.19,JP,,0000,0000,0000,,Оның үстіне бұл екі ұл мен бір қыздың қиын комбинациясы.
Dialogue: 0,0:04:00.44,0:04:03.09,JP,,0000,0000,0000,,Шынымды айтсам, махаббат қиындығы болған жоқ па?
Dialogue: 0,0:04:03.14,0:04:03.98,JP,,0000,0000,0000,,Маған біртіндеп орал
Dialogue: 0,0:04:05.26,0:04:06.80,JP,,0000,0000,0000,,Сіз анық айттыңыз.
Dialogue: 0,0:04:07.00,0:04:11.03,JP,,0000,0000,0000,,Өйткені Нарихира-саманың әйелдермен қарым-қатынасы тым қауіпті.
Dialogue: 0,0:04:11.13,0:04:11.81,JP,,0000,0000,0000,,Оған не болды?
Dialogue: 0,0:04:12.36,0:04:15.85,JP,,0000,0000,0000,,Императордың әйеліне үміткерге, сондай-ақ сайғуларға араласу.
Dialogue: 0,0:04:16.21,0:04:16.95,JP,,0000,0000,0000,,Сайгу
Dialogue: 0,0:04:17.67,0:04:22.86,JP,,0000,0000,0000,,Бұл үйленбеген император ханзадаларының арасынан таңдалған ерекше қасиетті баланың Сайгуы ма?
Dialogue: 0,0:04:23.41,0:04:24.48,JP,,0000,0000,0000,,Бұл таңқаларлық
Dialogue: 0,0:04:24.95,0:04:26.79,JP,,0000,0000,0000,,Махаббатта кедергілер болмай қоймайды
Dialogue: 0,0:04:27.26,0:04:29.12,JP,,0000,0000,0000,,Қорықсаң, ғашық бола алмайсың.
Dialogue: 0,0:04:29.61,0:04:33.32,JP,,0000,0000,0000,,Сен маған бірдеңе айтып тұрсаң, жәй ғана жыртқыш шығарсың.
Dialogue: 0,0:04:33.75,0:04:35.54,JP,,0000,0000,0000,,Иә, ол да өте жыртқыш.
Dialogue: 0,0:04:36.00,0:04:37.47,JP,,0000,0000,0000,,Сіз өте жыртқышсыз ба?
Dialogue: 0,0:04:37.86,0:04:41.33,JP,,0000,0000,0000,,21 ғасырда жойылып бара жатқан түрге айналатын сияқты.
Dialogue: 0,0:04:41.63,0:04:43.93,JP,,0000,0000,0000,,Дәлірек айтсақ, бұл жойылып кеткісі келетін түр.
Dialogue: 0,0:04:44.44,0:04:48.32,JP,,0000,0000,0000,,Бірақ бұл Комачи мырзаны одан бетер нысанаға айналдырмай ма?
Dialogue: 0,0:04:48.66,0:04:53.08,JP,,0000,0000,0000,,Шынымды айтсам, маған үлкен кеуделер ұнайды.
Dialogue: 0,0:04:53.24,0:04:54.84,JP,,0000,0000,0000,,Не айтпақшысың өзің?
Dialogue: 0,0:04:55.30,0:04:58.40,JP,,0000,0000,0000,,Бірақ өмір өткінші
Dialogue: 0,0:04:59.14,0:05:04.36,JP,,0000,0000,0000,,Мен ойлаған әйел АА, А кесеге жетпейді.
Dialogue: 0,0:05:04.75,0:05:05.95,JP,,0000,0000,0000,,Не болды?
Dialogue: 0,0:05:06.47,0:05:09.93,JP,,0000,0000,0000,,Анықтама үшін, Хироко-доно, менің ағам Юкихираның әйелі,
Dialogue: 0,0:05:10.53,0:05:11.61,JP,,0000,0000,0000,,G шыныаяқ
Dialogue: 0,0:05:11.75,0:05:13.17,JP,,0000,0000,0000,,Сіз қайдан білесіз?
Dialogue: 0,0:05:13.62,0:05:14.75,JP,,0000,0000,0000,,Айтпақшы, Комачи
Dialogue: 0,0:05:19.94,0:05:22.60,JP,,0000,0000,0000,,Соңында біз де жеттік. Бұл Цукуба тауы.
Dialogue: 0,0:05:22.97,0:05:25.28,JP,,0000,0000,0000,,Цукуба Утагаки тауы кезеңі
Dialogue: 0,0:05:25.82,0:05:29.04,JP,,0000,0000,0000,,Ежелден ер мен әйел бір-біріне өлең оқып келген.
Dialogue: 0,0:05:29.35,0:05:33.67,JP,,0000,0000,0000,,Махаббат түнін өткізген атақты жерге де жеттік.
Dialogue: 0,0:05:33.73,0:05:36.29,JP,,0000,0000,0000,,Мен әдеттегідей қатты толқып тұрмын
Dialogue: 0,0:05:36.31,0:05:37.80,JP,,0000,0000,0000,,Мен әрқашан келгім келді
Dialogue: 0,0:05:38.12,0:05:42.30,JP-,,0000,0000,0000,,Өйткені Цукуба тауы - Утагаки үшін сахна.
Dialogue: 0,0:05:37.98,0:05:42.30,JP,,0000,0000,0000,,Мен өзімді орналастырған Микавадан өтіп, сонау шығысқа келдім.
Dialogue: 0,0:05:44.09,0:05:46.61,JP,,0000,0000,0000,,Менің жұмысым бар, сондықтан
Dialogue: 0,0:05:46.77,0:05:47.88,JP,,0000,0000,0000,,Минерва біз үшін осындай қауіпсіз орын дайындап қойған еді
Dialogue: 0,0:05:49.38,0:05:51.42,JP,,0000,0000,0000,,Біз ақыры бірге жалғыз қала аламыз.
Dialogue: 0,0:05:54.06,0:05:56.40,JP,,0000,0000,0000,,Қазір мұндай нәрсені жасайтын уақыт емес.
Dialogue: 0,0:05:57.09,0:06:00.32,JP,,0000,0000,0000,,Мен Комачиді Нарихирамен жалғыз қалдыра алмаймын.
Dialogue: 0,0:06:01.03,0:06:03.30,JP,,0000,0000,0000,,Осынша жолмен қалай келдіңіз?
Dialogue: 0,0:06:03.78,0:06:05.85,JP,,0000,0000,0000,,Утагакиді ашамыз ба?
Dialogue: 0,0:06:07.44,0:06:09.15,JP,,0000,0000,0000,,Осы бетпен топтық кездесу?
Dialogue: 0,0:06:10.07,0:06:13.08,JP,,0000,0000,0000,,Көрдім, бір әйел анық жоғалып кетті.
Dialogue: 0,0:06:13.19,0:06:15.00,JP,,0000,0000,0000,,Мәселе бұл емес.
Dialogue: 0,0:06:15.15,0:06:17.53,JP,,0000,0000,0000,,Кездейсоқ адамды осы жерде, бір жерде тіркеймін.
Dialogue: 0,0:06:18.02,0:06:20.01,JP,,0000,0000,0000,,Қалғанын өз қалауыңыз бойынша жасайсыз.
Dialogue: 0,0:06:20.72,0:06:21.31,JP,,0000,0000,0000,,Біраз
Dialogue: 0,0:06:21.59,0:06:22.22,JP,,0000,0000,0000,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:06:22.41,0:06:24.51,JP,,0000,0000,0000,,Сіз енді жақсы емессіз.
Dialogue: 0,0:06:24.87,0:06:27.28,JP,,0000,0000,0000,,Мен монах ретінде косплеймін.
Dialogue: 0,0:06:27.30,0:06:29.38,JP,,0000,0000,0000,,Дүниеліктен аздап бас тартсам ғой.
Dialogue: 0,0:06:29.54,0:06:31.93,JP,,0000,0000,0000,,Жоқ, шынымен.
Dialogue: 0,0:06:32.14,0:06:34.96,JP,,0000,0000,0000,,Әлгі бейбақ тым бейқам.
Dialogue: 0,0:06:35.94,0:06:38.02,JP,,0000,0000,0000,,Жоқ, бірақ осы жерден кірісіңіз.
Dialogue: 0,0:06:38.60,0:06:39.50,JP,,0000,0000,0000,,Ко Комачи
Dialogue: 0,0:06:40.74,0:06:41.23,JP,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:06:41.90,0:06:44.14,JP,,0000,0000,0000,,Шын мәнінде, бұл
Dialogue: 0,0:06:45.05,0:06:47.43,JP,,0000,0000,0000,,Мен, мен, барлық уақытта.
Dialogue: 0,0:06:47.74,0:06:51.78,JP,,0000,0000,0000,,Мен сені сүйдім.
Dialogue: 0,0:06:52.29,0:06:52.74,JP,,0000,0000,0000,,Бұл
Dialogue: 0,0:06:53.10,0:06:53.59,JP,,0000,0000,0000,,Бұл?
Dialogue: 0,0:06:56.20,0:07:00.23,JP,,0000,0000,0000,,Ясухиде-сама шынымен де жақсы көңіл-күйде.
Dialogue: 0,0:07:00.69,0:07:02.47,JP,,0000,0000,0000,,Әзіл аяқталды
Dialogue: 0,0:07:02.96,0:07:04.68,JP,,0000,0000,0000,,Менің көңілім қалды.
Dialogue: 0,0:07:05.66,0:07:08.54,JP,,0000,0000,0000,,Жарайды. Бірге Утагаки ойнаймыз.
Dialogue: 0,0:07:09.38,0:07:12.60,JP,,0000,0000,0000,,Егер мұны бәрібір орындайтын болсаңыз, параметрлер туралы дұрыс ойлануыңыз керек.
Dialogue: 0,0:07:12.68,0:07:15.12,JP,,0000,0000,0000,,Өйткені, біз бір-бірімізге махаббат жырларын жіберуіміз керек
Dialogue: 0,0:07:15.81,0:07:17.03,JP,,0000,0000,0000,,Мен тұрмыстағы әйелдің рөлін сомдаймын.
Dialogue: 0,0:07:17.41,0:07:21.13,JP,,0000,0000,0000,,Ясухиде – күйелі әйелге ғашық болған мұңлы адам.
Dialogue: 0,0:07:22.67,0:07:25.19,JP,,0000,0000,0000,,Бұл рас, өкінішті
Dialogue: 0,0:07:25.83,0:07:27.64,JP,,0000,0000,0000,,Маған ән айтып беріңізші.
Dialogue: 0,0:07:28.02,0:07:30.21,JP,,0000,0000,0000,,Утамакурадан Цукуба тауы қосылыңыз.
Dialogue: 0,0:07:30.65,0:07:31.88,JP,,0000,0000,0000,,Цукуба
Dialogue: 0,0:07:39.04,0:07:41.53,JP,,0000,0000,0000,,Мен бұл нені білдіретінін білмеймін.
Dialogue: 0,0:07:43.54,0:07:45.07,JP,,0000,0000,0000,,Төмендегі сөз тіркесін қосыңыз
Dialogue: 0,0:07:45.39,0:07:46.08,JP,,0000,0000,0000,,Оның қуыршаққа айналдырған рухтары да керемет екенін естідім.
Dialogue: 0,0:07:47.75,0:07:48.56,JP,,0000,0000,0000,,Жалықтырғыш
Dialogue: 0,0:07:49.88,0:07:53.31,JP,,0000,0000,0000,,Хейанкиодағы G1 ГРАН-ПРИ
Dialogue: 0,0:07:53.73,0:07:56.50,JP,,0000,0000,0000,,Йорицуна-сан кім деп болжауға болады?
Dialogue: 0,0:07:56.65,0:07:58.82,JP,,0000,0000,0000,,Мен Нарихира айтқым келеді.
Dialogue: 0,0:07:58.97,0:08:01.00,JP,,0000,0000,0000,,Мен інім Юкихираны итеруге батылым барамын
Dialogue: 0,0:08:01.20,0:08:03.01,JP,,0000,0000,0000,,Йорицунаның болжамы - Юкихира
Dialogue: 0,0:08:03.21,0:08:04.87,JP,,0000,0000,0000,,Менің арманым - Кисен Хоши
Dialogue: 0,0:08:05.15,0:08:06.73,JP,,0000,0000,0000,,Сіздің арманыңыз кім?
Dialogue: 0,0:08:07.75,0:08:09.21,JP,,0000,0000,0000,,Қызыл сигнал жанады
Dialogue: 0,0:08:13.53,0:08:14.92,JP,,0000,0000,0000,,Қазір бастаңыз
Dialogue: 0,0:08:28.42,0:08:29.97,JP,,0000,0000,0000,,Тейканың бөлме уақыты.
Dialogue: 0,0:08:30.44,0:08:35.87,JP,,0000,0000,0000,,Біздің келесі тұтынушымыз Хеншо Соджо мырза, жақсы генерал ретінде танымал тұлға.
Dialogue: 0,0:08:36.48,0:08:39.92,JP,,0000,0000,0000,,Император Нинмио қайтыс болғаннан кейін Соджо мырза
Dialogue: 0,0:08:40.06,0:08:41.98,JP,,0000,0000,0000,,Адал болыңыз және монах болыңыз
Dialogue: 0,0:08:42.11,0:08:45.59,JP,,0000,0000,0000,,Рёсиму Мунесада деген есімнен бас тартып, Хеншо есімін алды.
Dialogue: 0,0:08:45.59,0:08:46.24,JP,,0000,0000,0000,,Тейкаден
Dialogue: 0,0:08:46.56,0:08:47.04,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:47.40,0:08:51.04,JP,,0000,0000,0000,,Бүгін Хеншоның орнына мені Мунесада деп атай аласыз ба?
Dialogue: 0,0:08:51.44,0:08:53.21,JP,,0000,0000,0000,,дегеніміз не?
Dialogue: 0,0:08:53.74,0:08:57.34,JP,,0000,0000,0000,,Дүниеде Хеншо эротикалық монах ретінде қарастырылады.
Dialogue: 0,0:08:57.85,0:08:59.14,JP,,0000,0000,0000,,Эротикалық қырылған бас?
Dialogue: 0,0:08:59.68,0:09:02.05,JP,,0000,0000,0000,,Нене Соджо Хенаки эротикалық емес~
Dialogue: 0,0:09:02.08,0:09:04.68,JP,,0000,0000,0000,,Иә, иә, сіз қыз фигурасы сияқты бірдеңе айттыңыз.
Dialogue: 0,0:09:04.68,0:09:06.70,JP,,0000,0000,0000,,Сіз ағартушылыққа мүлде қол жеткізген жоқсыз.
Dialogue: 0,0:09:06.72,0:09:08.30,JP,,0000,0000,0000,,Эротикалық бала емес
Dialogue: 0,0:09:08.34,0:09:09.31,JP,,0000,0000,0000,,Эротикалық бала
Dialogue: 0,0:09:09.47,0:09:10.15,JP,,0000,0000,0000,,Эротикалық бала
Dialogue: 0,0:09:10.15,0:09:14.00,JP,,0000,0000,0000,,Өйткені сіз бұл әнді Хякунин Исшуде Хеншо деген атпен алдыңыз.
Dialogue: 0,0:09:14.34,0:09:15.73,JP,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:09:15.73,0:09:19.29,JP,,0000,0000,0000,,Бұл дегеніңіз монах болғаннан кейін көп жұмыс істеу керек деген сөз.
Dialogue: 0,0:09:19.29,0:09:21.14,JP,,0000,0000,0000,,Монах дәрежесіне дейін көтерілген
Dialogue: 0,0:09:21.97,0:09:24.72,JP,,0000,0000,0000,,Мен мұны құрметтеймін.
Dialogue: 0,0:09:26.70,0:09:30.56,JP,,0000,0000,0000,,Ей... көп есімді адамдар қиын ғой, солай емес пе?
Dialogue: 0,0:09:30.66,0:09:33.77,JP,,0000,0000,0000,,Лорд Саданобу мен Кентоку мырзаға да солай.
Dialogue: 0,0:09:34.32,0:09:36.75,JP,,0000,0000,0000,,Шын есімі белгісіз әйелдер көп.
Dialogue: 0,0:09:37.08,0:09:39.40,JP,,0000,0000,0000,,Олар лақап атын сақтайды.
Dialogue: 0,0:09:39.72,0:09:43.67,JP,,0000,0000,0000,,Сей Шонагон, Мурасаки Шикибу, Оно Комачи-доно және т.б.
Dialogue: 0,0:09:43.99,0:09:47.70,JP,,0000,0000,0000,,Удайшо Мичицунаның анасы Мичицунаның анасы сияқты...
Dialogue: 0,0:09:45.74,0:09:48.46,JP-,,0000,0000,0000,,Йошико Комачи
Dialogue: 0,0:09:50.36,0:09:53.24,JP,,0000,0000,0000,,Йошиконың үйінде тек қыздар бар.
Dialogue: 0,0:09:53.49,0:09:57.18,JP,,0000,0000,0000,,Иә, сондықтан мен Мунесада-чанмен ойнағанды ​​жақсы көремін.
Dialogue: 0,0:09:58.00,0:10:00.90,JP,,0000,0000,0000,,Үйде мен тек қуыршақ ойнаймын.
Dialogue: 0,0:10:01.63,0:10:04.72,JP,,0000,0000,0000,,Мунесада Чамамен сыртта ойнау қызық.
Dialogue: 0,0:10:05.00,0:10:08.67,JP,,0000,0000,0000,,Иә, менің де қарындасым бар сияқты, сондықтан бұл қызық.
Dialogue: 0,0:10:09.18,0:10:10.00,JP,,0000,0000,0000,,Әпке
Dialogue: 0,0:10:11.17,0:10:12.97,JP,,0000,0000,0000,,Жоқ, жоқ, жоқ
Dialogue: 0,0:10:13.53,0:10:18.14,JP,,0000,0000,0000,,Сіз мені Онии-ча-ма, Мунесада-чан деп атай аласыз.
Dialogue: 0,0:10:19.20,0:10:23.50,JP,,0000,0000,0000,,Содан бері Йошико екеуміз аға мен әпкедей болып өстік.
Dialogue: 0,0:10:23.73,0:10:24.79,JP,,0000,0000,0000,,...
Dialogue: 0,0:10:25.26,0:10:29.25,JP,,0000,0000,0000,,Мен көремін. Сондықтан ол романтикаға айналмады.
Dialogue: 0,0:10:29.65,0:10:32.08,JP,,0000,0000,0000,,Йошико да мені Онии-сама деп атайды.
Dialogue: 0,0:10:32.35,0:10:34.48,JP,,0000,0000,0000,,Мен де бұл жақсы деп ойладым.
Dialogue: 0,0:10:34.89,0:10:37.69,JP,,0000,0000,0000,,Олай болса, ағаң да оқуын бітіріпті.
Dialogue: 0,0:10:38.34,0:10:42.31,JP,,0000,0000,0000,,100 түнге жетсең, үйленесің.
Dialogue: 0,0:10:42.37,0:10:44.88,JP,,0000,0000,0000,,Бір-бірін атын атап шақыру қалыпты емес пе?
Dialogue: 0,0:10:47.92,0:10:48.88,JP,,0000,0000,0000,,Лорд Мунесада
Dialogue: 0,0:10:50.24,0:10:51.31,JP,,0000,0000,0000,,Аға
Dialogue: 0,0:10:52.59,0:10:53.62,JP,,0000,0000,0000,,Мунесада мырза
Dialogue: 0,0:10:54.27,0:10:56.81,JP,,0000,0000,0000,,Ақыр соңында, олар «аға» мен «қарындас» болғандықтан, бәрі жақсы.
Dialogue: 0,0:10:58.58,0:10:59.99,JP,,0000,0000,0000,,Бұл өте азғындық.
Dialogue: 0,0:11:01.28,0:11:01.72,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:04.31,0:11:05.78,JP,,0000,0000,0000,,Бүгін кешке жіберемін
Dialogue: 0,0:11:06.25,0:11:08.67,JP,,0000,0000,0000,,Әр түнде арманда Махаббат әр түнде
Dialogue: 0,0:11:09.92,0:11:11.64,JP,,0000,0000,0000,,Хост клубы Хейанға қош келдіңіз
Dialogue: 0,0:11:12.02,0:11:14.82,JP,,0000,0000,0000,,Мен Юкихира Ариварамын, иесімін.
Dialogue: 0,0:11:15.52,0:11:18.76,JP,,0000,0000,0000,,Мақтаншақ, сымбатты үй иелерін таныстырайық.
Dialogue: 0,0:11:19.49,0:11:23.70,JP,,0000,0000,0000,,No5 ініміз әдеби жас жүргізуші Садай
Dialogue: 0,0:11:24.24,0:11:25.56,JP,,0000,0000,0000,,Өлімге әкелетін спойлер
Dialogue: 0,0:11:26.09,0:11:29.31,JP,,0000,0000,0000,,Маған біраз нәрсе айтыңызшы, ханымдар мен мырзалар.
Dialogue: 0,0:11:29.50,0:11:31.21,JP,,0000,0000,0000,,Әй, сүйкімді
Dialogue: 0,0:11:31.45,0:11:34.70,JP,,0000,0000,0000,,Біздің №4 көңіл көтеруші жүргізуші Ясухиде
Dialogue: 0,0:11:35.10,0:11:36.36,JP,,0000,0000,0000,,Оның мамандығы – сөз тіркестерін айту
Dialogue: 0,0:11:36.85,0:11:39.02,JP,,0000,0000,0000,,Қабылдаушы клубта демалыңыз
Dialogue: 0,0:11:39.04,0:11:40.74,JP,,0000,0000,0000,,Ауа, суық.
Dialogue: 0,0:11:40.94,0:11:44.96,JP,,0000,0000,0000,,Біздің №3 Руда стиліндегі «Цунгире» тобының жүргізушісі Садааки
Dialogue: 0,0:11:45.79,0:11:47.66,JP,,0000,0000,0000,,Зорлық-зомбылық көргісі келетін әйелдердің саны тез өсуде
Dialogue: 0,0:11:47.92,0:11:50.90,JP,,0000,0000,0000,,Не қарап тұрсың, кел, егесің бе?
Dialogue: 0,0:11:51.03,0:11:53.15,JP,,0000,0000,0000,,О, маған көбірек айт
Dialogue: 0,0:11:53.23,0:11:56.75,JP,,0000,0000,0000,,№2 Сергіту сәті Үлкен ағамыз жүргізуші Мунесада
Dialogue: 0,0:11:57.34,0:11:59.47,JP,,0000,0000,0000,,Хякуяның қатысуына назар аудару
Dialogue: 0,0:12:00.13,0:12:02.21,JP,,0000,0000,0000,,Мен сіздің үйіңізге келе аламын ба?
Dialogue: 0,0:12:02.36,0:12:04.01,JP,,0000,0000,0000,,Толық және толық
Dialogue: 0,0:12:04.29,0:12:09.83,JP,,0000,0000,0000,,Ал біздің No1 жүргізуші Нарихира саған тәтті махаббатын сыбырлайды.
Dialogue: 0,0:12:10.89,0:12:13.65,JP,,0000,0000,0000,,Ханшайым, саған деген махаббатқа толы жүрегім
Dialogue: 0,0:12:14.74,0:12:18.54,JP,,0000,0000,0000,,Сүйікті адам, мен сені түсімде де сүйгім келеді
Dialogue: 0,0:12:20.40,0:12:22.25,JP,,0000,0000,0000,,Сәттілік, Нарихира.
Dialogue: 0,0:12:23.83,0:12:25.90,JP,,0000,0000,0000,,Эй Такако, мен сені күттім.
Dialogue: 0,0:12:26.60,0:12:29.31,JP,,0000,0000,0000,,Бүгін де сарғылт көйлекпен жақсы көрінесің.
Dialogue: 0,0:12:29.81,0:12:30.54,JP,,0000,0000,0000,,Бұл әдемі.
Dialogue: 0,0:12:33.22,0:12:35.01,JP,,0000,0000,0000,,Мен он диң донг қоямын.
Dialogue: 0,0:12:35.20,0:12:37.64,JP,,0000,0000,0000,,Мен қызғылт шампан алдым.
Dialogue: 0,0:12:35.40,0:12:39.31,JP-,,0000,0000,0000,,Түнде болса да күн астында жарқыраған кесе
Dialogue: 0,0:12:39.66,0:12:45.26,JP-,,0000,0000,0000,,Дон Дон Пинк Пери Пери Шань Шан
Dialogue: 0,0:12:38.54,0:12:44.30,JP,,0000,0000,0000,,Хост клубы Хайан Біз сіздерді түрлі-түсті махаббатпен күтеміз.
Dialogue: 0,0:12:45.59,0:12:49.09,JP,,0000,0000,0000,,Хейанкиодағы G1 ГРАН-ПРИ
Dialogue: 0,0:13:01.56,0:13:04.09,JP,,0000,0000,0000,,Сәлеметсіз бе, мен Тейка Фудзивара, модератормын.
Dialogue: 0,0:13:04.39,0:13:07.01,JP,,0000,0000,0000,,Менің көмекшім - Йорицуна Уцуномия.
Dialogue: 0,0:13:07.24,0:13:09.43,JP,,0000,0000,0000,,Бұл жолғы қонақтар ерлі-зайыптылар.
Dialogue: 0,0:13:09.73,0:13:10.82,JP,,0000,0000,0000,,Және жаңадан үйленген
Dialogue: 0,0:13:11.19,0:13:14.07,JP,,0000,0000,0000,,Ойбай-ау, бұл туралы қандай махаббат естимін деп ойлаймын.
Dialogue: 0,0:13:14.42,0:13:16.09,JP,,0000,0000,0000,,Олай болса сізге хабарласайық.
Dialogue: 0,0:13:16.62,0:13:19.20,JP,,0000,0000,0000,,Қош келдіңіз, Имосе-сан
Dialogue: 0,0:13:20.60,0:13:24.22,JP,,0000,0000,0000,,Йосейин, Садааки және Суико деген атпен де белгілі.
Dialogue: 0,0:13:24.65,0:13:25.56,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:13:26.01,0:13:29.04,JP,,0000,0000,0000,,Екеуің бір-біріңді бала кезден білетін сияқтысыңдар.
Dialogue: 0,0:13:29.66,0:13:30.18,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:13:30.40,0:13:32.90,JP,,0000,0000,0000,,Сіз бұл туралы содан кейін хабардар болдыңыз ба?
Dialogue: 0,0:13:33.07,0:13:33.78,JP,,0000,0000,0000,,О… Ах…
Dialogue: 0,0:13:34.35,0:13:36.84,JP,,0000,0000,0000,,Артынан қарасақ, солай болуы мүмкін.
Dialogue: 0,0:13:37.12,0:13:39.16,JP,,0000,0000,0000,,Тыныш, мұңайған бақа әйел
Dialogue: 0,0:13:40.66,0:13:43.43,JP,,0000,0000,0000,,Енді мен сені жақсы көремін деген сөз.
Dialogue: 0,0:13:44.32,0:13:45.13,JP,,0000,0000,0000,,Юкине-кун, бұл адамды танисың ба?
Dialogue: 0,0:13:45.47,0:13:46.02,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:13:46.16,0:13:48.30,JP,,0000,0000,0000,,Өзімшіл болма, бұл сеп
Dialogue: 0,0:13:48.45,0:13:49.52,JP,,0000,0000,0000,,Шабу-шабу болсын
Dialogue: 0,0:13:49.96,0:13:53.03,JP,,0000,0000,0000,,Енді оның сүйкімділігі соншалықты, жегің келетінін білдіреді.
Dialogue: 0,0:13:54.64,0:13:58.14,JP,,0000,0000,0000,,Ей, шіркін, бұдан былай сөйлесең, түні бойы тоғанға іліп қоямын.
Dialogue: 0,0:13:59.86,0:14:03.93,JP,,0000,0000,0000,,Енді айтайын дегенім, мен сені бүгін кешке жібермеймін.
Dialogue: 0,0:14:04.75,0:14:05.23,JP,,0000,0000,0000,,Кумия Нурезо — біз сол жігітті артта қалдыра саламыз.
Dialogue: 0,0:14:06.10,0:14:07.41,JP,,0000,0000,0000,,Мен қазірдің өзінде ұйықтап жатырмын
Dialogue: 0,0:14:07.68,0:14:09.01,JP,,0000,0000,0000,,...
Dialogue: 0,0:14:09.48,0:14:10.56,JP,,0000,0000,0000,,Жаңа ғана оралдым.
Dialogue: 0,0:14:10.68,0:14:12.58,JP,,0000,0000,0000,,Сөйлеме Ауыздың жабылғанын қалайсыз ба?
Dialogue: 0,0:14:12.65,0:14:13.93,JP,,0000,0000,0000,,Бүгінгі жағдайыңыз қалай?
Dialogue: 0,0:14:13.93,0:14:14.55,JP,,0000,0000,0000,,Үндетпе
Dialogue: 0,0:14:14.99,0:14:17.37,JP,,0000,0000,0000,,G1 ГРАН-ПРИ
Dialogue: 0,0:14:17.59,0:14:18.83,JP,,0000,0000,0000,,Бұл Тейка, тікелей хабар таратушы.
Dialogue: 0,0:14:19.29,0:14:22.74,JP,,0000,0000,0000,,Жарыс жарты жолға жақындап қалды және әр көлік пит-стоп жасаған сияқты.
Dialogue: 0,0:14:23.10,0:14:24.23,JP,,0000,0000,0000,,Йорицуна мырза оқиға орнында
Dialogue: 0,0:14:25.32,0:14:26.39,JP,,0000,0000,0000,,Йорицуна мырза
Dialogue: 0,0:14:26.91,0:14:29.38,JP,,0000,0000,0000,,Иә, бұл Киёмизу-дера храмынан келген Йорицуна.
Dialogue: 0,0:14:29.64,0:14:31.52,JP,,0000,0000,0000,,Сіздің жағдайыңыз ше?
Dialogue: 0,0:14:32.24,0:14:35.21,JP,,0000,0000,0000,,Иә, әр вагон бригадасы жұмыстан бос емес.
Dialogue: 0,0:14:35.53,0:14:38.13,JP,,0000,0000,0000,,Мунесада мырза, дөңгелекті ауыстыру аяқталды.
Dialogue: 0,0:14:39.18,0:14:41.23,JP,,0000,0000,0000,,Нарихира мырза, су ішіңіз.
Dialogue: 0,0:14:41.37,0:14:43.34,JP,,0000,0000,0000,,Тәттілерден де рахат алыңыз.
Dialogue: 0,0:14:43.54,0:14:45.57,JP,,0000,0000,0000,,Боқ Нарихира
Dialogue: 0,0:14:45.91,0:14:48.34,JP,,0000,0000,0000,,Сіз генерал-лейтенант болсаңыз да, алдымнан жүгіріп келе жатырсыз.
Dialogue: 0,0:14:49.14,0:14:50.37,JP,,0000,0000,0000,,Оның артында қандай себеп тұрса да,
Dialogue: 0,0:14:50.73,0:14:51.50,JP,,0000,0000,0000,,Сәлем Суико
Dialogue: 0,0:14:51.85,0:14:53.37,JP,,0000,0000,0000,,Бұл не, Садааки-сама?
Dialogue: 0,0:14:53.63,0:14:54.55,JP,,0000,0000,0000,,Маған ішімдік әкеліңіз
Dialogue: 0,0:14:54.80,0:14:56.26,JP,,0000,0000,0000,,Сіз алкогольді ішесіз бе?
Dialogue: 0,0:14:56.52,0:14:58.44,JP,,0000,0000,0000,,Сиырларға сусын беріңіз.
Dialogue: 0,0:14:59.50,0:15:01.37,JP,,0000,0000,0000,,Мұны істеу дұрыс па?
Dialogue: 0,0:15:08.98,0:15:09.42,JP,,0000,0000,0000,,Не?
Dialogue: 0,0:15:11.41,0:15:12.66,JP,,0000,0000,0000,,А, апат.
Dialogue: 0,0:15:12.71,0:15:15.34,JP,,0000,0000,0000,,Шұңқырда хаос. Жағдай күрделі болып барады.
Dialogue: 0,0:15:26.27,0:15:27.30,JP,,0000,0000,0000,,Тейканың бөлмесі
Dialogue: 0,0:15:27.68,0:15:32.41,JP,,0000,0000,0000,,Соңғы тапсырыс беруші Хейан дәуірінің ортасындағы ұлы ақын Фудзивара Кимито болды.
Dialogue: 0,0:15:32.98,0:15:34.29,JP,,0000,0000,0000,,Міне, Тейка-кун.
Dialogue: 0,0:15:34.84,0:15:36.39,JP,,0000,0000,0000,,Иә, бұл не?
Dialogue: 0,0:15:36.69,0:15:39.07,JP,,0000,0000,0000,,Мені мұнда не үшін шақырды?
Dialogue: 0,0:15:40.01,0:15:44.91,JP,,0000,0000,0000,,Осы уақытқа дейін барлығы өз кезегін аяқтады, бірақ бұл мен бірінші рет.
Dialogue: 0,0:15:45.49,0:15:48.54,JP,,0000,0000,0000,,Мен бұл бірінші рет пайда болғанына біраз алаңдаймын.
Dialogue: 0,0:15:49.08,0:15:50.87,JP,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:15:51.35,0:15:54.23,JP,,0000,0000,0000,,Біз енді Хэйан кезеңінің ортасы туралы сөйлесетін боламыз.
Dialogue: 0,0:15:54.48,0:15:59.31,JP,,0000,0000,0000,,Сондықтан мен Конин Сенпайды сол дәуірдің өкілі ретінде шақырдым.
Dialogue: 0,0:16:01.30,0:16:06.38,JP,,0000,0000,0000,,Бұл жағдайда сол кездегі Дажо министрі Мичинага Фудзивара жақсырақ емес пе еді?
Dialogue: 0,0:16:07.26,0:16:10.50,JP,,0000,0000,0000,,Коин-сенпай бастапқыда Фуджишикибу деп аталды
Dialogue: 0,0:16:10.74,0:16:13.23,JP,,0000,0000,0000,,Мурасаки Шикибуға атын өзгертуге көмектесті
Dialogue: 0,0:16:13.56,0:16:17.05,JP,,0000,0000,0000,,Ол сонымен қатар «Жастық кітабындағы» Сей Шонагонмен байланыста болды.
Dialogue: 0,0:16:17.86,0:16:23.47,JP,,0000,0000,0000,,Осы дәуірдегі мәдениет қайраткерлерінің көсемі Қойын-сенпай бұл қызметке ең лайықты адам деп есептеймін.
Dialogue: 0,0:16:24.85,0:16:27.89,JP,,0000,0000,0000,,Көшбасшы деп атағанды ​​ұнатпаймын, өйткені ол бастық болып көрінеді.
Dialogue: 0,0:16:28.56,0:16:30.09,JP,,0000,0000,0000,,Мен солай деп ойлаймын.
Dialogue: 0,0:16:30.64,0:16:33.86,JP-,,0000,0000,0000,,Мен ән айта аламын, қытай поэзиясын шығара аламын, оркестрде ойнай аламын.
Dialogue: 0,0:16:32.34,0:16:35.27,JP,,0000,0000,0000,,Жақсы, мен өзімді сәл жақсы сезінемін.
Dialogue: 0,0:16:34.29,0:16:36.84,JP-,,0000,0000,0000,,Бәлкім, мені басшы деп атағандары да жоқ шығар.
Dialogue: 0,0:16:37.50,0:16:38.51,JP,,0000,0000,0000,,Айтпақшы, Тейка-кун
Dialogue: 0,0:16:39.23,0:16:39.64,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:16:40.22,0:16:45.58,JP,,0000,0000,0000,,Сіз Hyakunin Isshu таңдадыңыз, бірақ ән таңдау критерийлері сәл бос емес пе?
Dialogue: 0,0:16:46.26,0:16:47.14,JP,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:16:47.48,0:16:50.64,JP,,0000,0000,0000,,Егер мен үй иесі болсам, мен «сасаған» опциясын қабылдамас едім.
Dialogue: 0,0:16:51.09,0:16:57.49,JP,,0000,0000,0000,,Кейінгі Чушо патшасы атанған император князі Гухейді таңдамауы мүмкін емес.
Dialogue: 0,0:16:58.00,0:17:02.53,JP,,0000,0000,0000,,100 өлеңнің 43-і махаббат туралы болуы теңгерімсіздік емес пе?
Dialogue: 0,0:17:02.87,0:17:06.23,JP,,0000,0000,0000,,Алыстағы ағайынның өтініші сияқты.
Dialogue: 0,0:17:06.47,0:17:10.30,JP,,0000,0000,0000,,Махаббат жырларына толы монахқа айналған адамның үйін безендірудің несі айып?
Dialogue: 0,0:17:10.75,0:17:13.18,JP,,0000,0000,0000,,Мен біртүрлі адам екенмін деп қалжыңдаймын.
Dialogue: 0,0:17:16.49,0:17:17.27,JP,,0000,0000,0000,,Не істеу керек
Dialogue: 0,0:17:18.87,0:17:19.53,JP,,0000,0000,0000,,Техеперо
Dialogue: 0,0:17:19.71,0:17:21.69,JP,,0000,0000,0000,,Бұл қандай шірік көзқарас?
Dialogue: 0,0:17:22.09,0:17:25.52,JP,,0000,0000,0000,,Бұл Шиджо Дайнагон шенеунігіне шабуыл жасау құрметсіздік.
Dialogue: 0,0:17:25.93,0:17:31.68,JP,,0000,0000,0000,,Оның үстіне менің 36 адамым сенің Хякунин Исшуыңды басып тастайды.
Dialogue: 0,0:17:33.06,0:17:35.39,JP,,0000,0000,0000,,Хейан ақынының карта шайқасы
Dialogue: 0,0:17:35.74,0:17:37.57,JP,,0000,0000,0000,,Тейка В.С. Конин
Dialogue: 0,0:17:38.53,0:17:40.12,JP,,0000,0000,0000,,Хейан ақынының карта шайқасы дегеніміз не?
Dialogue: 0,0:17:40.57,0:17:44.39,JP,,0000,0000,0000,,Бұл қабілет мәндері орнатылған әнші карталарын пайдаланатын карта шайқасы.
Dialogue: 0,0:17:45.04,0:17:46.36,JP,,0000,0000,0000,,Жан – 30000 ұпай
Dialogue: 0,0:17:46.69,0:17:49.77,JP,,0000,0000,0000,,Жеңіс шарты - алдымен қарсыластың жанын 0-ге дейін төмендету.
Dialogue: 0,0:17:50.39,0:17:53.49,JP,,0000,0000,0000,,Қарсыласыңыздың палубасындағы карталары таусылып қалса, сіз жеңесіз.
Dialogue: 0,0:17:54.01,0:17:57.21,JP,,0000,0000,0000,,Ұрыс алаңында шабуыл аймағы мен қорғаныс аймағы бар.
Dialogue: 0,0:17:57.56,0:18:02.22,JP,,0000,0000,0000,,Шабуыл аймағына шақырылған әнші келесі айналымнан қарсыласының шабуыл аймағының әншісін шақырады.
Dialogue: 0,0:18:02.50,0:18:05.17,JP,,0000,0000,0000,,Немесе сіз басқа ойыншыға шабуыл жасай аласыз.
Dialogue: 0,0:18:05.74,0:18:08.67,JP,,0000,0000,0000,,Қорғаныс аймағына шақырылған әнші шабуыл жасай алмайды, бірақ
Dialogue: 0,0:18:09.10,0:18:11.91,JP,,0000,0000,0000,,Ойыншылар шабуыл жасаған кезде блоктай алады
Dialogue: 0,0:18:12.40,0:18:14.61,JP,,0000,0000,0000,,Сондай-ақ тілдің әр басында
Dialogue: 0,0:18:14.88,0:18:19.25,JP,,0000,0000,0000,,Әрбір әнші 100 жан ұпайын тұтыну арқылы Зонды жылжыта алады.
Dialogue: 0,0:18:19.96,0:18:21.77,JP,,0000,0000,0000,,Ақынның қабілет бағасы – күш деп аталады.
Dialogue: 0,0:18:22.01,0:18:24.95,JP,,0000,0000,0000,,Ақындар айтысында күші көп жеңеді.
Dialogue: 0,0:18:25.25,0:18:27.53,JP,,0000,0000,0000,,Жоғалған әншілерді зиратқа жібереді
Dialogue: 0,0:18:27.78,0:18:29.68,JP,,0000,0000,0000,,Егер өкілеттіктер бірдей болса, олар бір-бірімен сауда жасайды.
Dialogue: 0,0:18:30.02,0:18:31.89,JP,,0000,0000,0000,,Екеуі де зиратқа жіберілді
Dialogue: 0,0:18:32.47,0:18:35.82,JP,,0000,0000,0000,,Әншіні шақыру күштің жарты жанын жейді.
Dialogue: 0,0:18:36.20,0:18:39.62,JP,,0000,0000,0000,,Әнші неғұрлым күшті болса, соғұрлым шақыру қаупі артады.
Dialogue: 0,0:18:39.97,0:18:43.61,JP,,0000,0000,0000,,Жан келесі тіл ұтысынан кейін 1000 ұпайды қалпына келтіреді
Dialogue: 0,0:18:43.83,0:18:45.72,JP,,0000,0000,0000,,Бірақ бұл сан 30 000 ұпайдан аспайды.
Dialogue: 0,0:18:46.10,0:18:48.82,JP,,0000,0000,0000,,Ерекше қабілеті бар әншілер де бар.
Dialogue: 0,0:18:49.60,0:18:51.78,JP,,0000,0000,0000,,Палубаны салу үшін қандай әншіні таңдау керек?
Dialogue: 0,0:18:52.07,0:18:53.35,JP,,0000,0000,0000,,Жеңіс кілті
Dialogue: 0,0:18:53.89,0:18:55.29,JP,,0000,0000,0000,,Бірінші Тан шенеунігі
Dialogue: 0,0:18:55.84,0:18:56.45,JP,,0000,0000,0000,,Сурет салу
Dialogue: 0,0:18:57.29,0:19:00.84,JP,,0000,0000,0000,,Накацуканы Тан қорғаныс аймағына шақыру аяқталады
Dialogue: 0,0:19:01.34,0:19:02.81,JP,,0000,0000,0000,,Екінші Тан Тейка
Dialogue: 0,0:19:02.99,0:19:03.74,JP,,0000,0000,0000,,Сурет салу
Dialogue: 0,0:19:04.60,0:19:08.23,JP,,0000,0000,0000,,Таң аймағына шабуыл жасау үшін Ясухиде Фумияны шақырыңыз
Dialogue: 0,0:19:08.93,0:19:10.40,JP,,0000,0000,0000,,Үшінші Тан шенеунігі
Dialogue: 0,0:19:10.60,0:19:11.25,JP,,0000,0000,0000,,Сурет салу
Dialogue: 0,0:19:12.37,0:19:13.37,JP,,0000,0000,0000,,Тілдің соңы
Dialogue: 0,0:19:13.62,0:19:15.00,JP,,0000,0000,0000,,Ештеңе жасамаңыз
Dialogue: 0,0:19:13.63,0:19:15.12,JP-,,0000,0000,0000,,Төртінші Тан Тейка
Dialogue: 0,0:19:15.46,0:19:16.04,JP,,0000,0000,0000,,Сурет салу
Dialogue: 0,0:19:16.91,0:19:19.25,JP,,0000,0000,0000,,Рецуджу Харумичиді қорғаныс аймағына шақыру
Dialogue: 0,0:19:19.56,0:19:21.46,JP,,0000,0000,0000,,Ойыншыға Ясухидемен шабуыл жасаңыз
Dialogue: 0,0:19:21.87,0:19:23.06,JP,,0000,0000,0000,,Сеулде қабылдау
Dialogue: 0,0:19:23.78,0:19:25.01,JP,,0000,0000,0000,,Егер сіз бұғаттамасаңыз
Dialogue: 0,0:19:23.99,0:19:25.70,JP-,,0000,0000,0000,,Бесінші Тан шенеунігі
Dialogue: 0,0:19:26.06,0:19:26.56,JP,,0000,0000,0000,,Сурет салу
Dialogue: 0,0:19:27.73,0:19:28.82,JP,,0000,0000,0000,,Тілдің соңы
Dialogue: 0,0:19:29.13,0:19:30.04,JP,,0000,0000,0000,,Жалап жатқан
Dialogue: 0,0:19:29.15,0:19:30.86,JP-,,0000,0000,0000,,Алтыншы Тан Тейка
Dialogue: 0,0:19:31.07,0:19:31.83,JP,,0000,0000,0000,,Сурет салу
Dialogue: 0,0:19:32.29,0:19:33.99,JP,,0000,0000,0000,,Ағашты шабуыл аймағына жылжытыңыз
Dialogue: 0,0:19:34.39,0:19:36.60,JP,,0000,0000,0000,,Кеңесші Такамураны қорғаныс аймағына шақырыңыз
Dialogue: 0,0:19:37.00,0:19:39.74,JP,,0000,0000,0000,,Сонымен қатар, Ясухиде мен Рецуки ойыншыға шабуыл жасайды.
Dialogue: 0,0:19:40.66,0:19:41.93,JP,,0000,0000,0000,,Сеулде қабылдау
Dialogue: 0,0:19:42.04,0:19:43.74,JP,,0000,0000,0000,,Жетінші Тан шенеунігі
Dialogue: 0,0:19:44.06,0:19:44.66,JP,,0000,0000,0000,,Сурет салу
Dialogue: 0,0:19:46.19,0:19:47.89,JP,,0000,0000,0000,,Тейка-кун, сен жеңілдің.
Dialogue: 0,0:19:48.31,0:19:50.45,JP,,0000,0000,0000,,Орташа басқаруды шабуыл аймағына жылжытыңыз
Dialogue: 0,0:19:51.19,0:19:52.72,JP,,0000,0000,0000,,Және спецификацияны белсендіру
Dialogue: 0,0:19:53.06,0:19:57.76,JP,,0000,0000,0000,,Жан 10 000-нан аз болса, Маньо Утаның шақыру құны 1/10 құрайды.
Dialogue: 0,0:19:58.18,0:20:03.26,JP,,0000,0000,0000,,Қорғаныс аймағына Акато Ямабе, Иеямочи Отомоны, Хитомаро Какимотоны шақыру
Dialogue: 0,0:20:03.70,0:20:05.23,JP,,0000,0000,0000,,Түсіндім, соны мақсат ет.
Dialogue: 0,0:20:05.24,0:20:08.60,JP,,0000,0000,0000,,36 адам таңдаған қосымша сипаттамалар
Dialogue: 0,0:20:08.91,0:20:11.90,JP,,0000,0000,0000,,Әрбір қосымша адам үшін 1000 қуат қосыңыз.
Dialogue: 0,0:20:12.07,0:20:14.20,JP,,0000,0000,0000,,Накацукасаның күші 10000-ға дейін өсті
Dialogue: 0,0:20:14.36,0:20:15.95,JP,,0000,0000,0000,,Ойыншыға шабуыл жасаңыз
Dialogue: 0,0:20:16.75,0:20:17.83,JP,,0000,0000,0000,,Такамурамен блоктау
Dialogue: 0,0:20:19.17,0:20:20.63,JP,,0000,0000,0000,,Қорғамасаң, ұтыласың.
Dialogue: 0,0:20:19.02,0:20:20.78,JP-,,0000,0000,0000,,Сегізінші Тан Тейка
Dialogue: 0,0:20:21.49,0:20:22.06,JP,,0000,0000,0000,,Сурет салу
Dialogue: 0,0:20:22.98,0:20:24.69,JP,,0000,0000,0000,,Ясухидені қорғаныс аймағына жылжытыңыз
Dialogue: 0,0:20:25.47,0:20:27.90,JP,,0000,0000,0000,,Ал монахтың ерекшеліктерімен зиратқа барыңыз
Dialogue: 0,0:20:28.42,0:20:30.23,JP,,0000,0000,0000,,Кисен Хошиді нөлдік құнына шақырыңыз
Dialogue: 0,0:20:30.70,0:20:33.48,JP,,0000,0000,0000,,Роккасеннің ерекшеліктерімен бір адамға 2000-ға өсу
Dialogue: 0,0:20:34.02,0:20:35.87,JP,,0000,0000,0000,,Енді Нарихираны шақыр.
Dialogue: 0,0:20:36.31,0:20:37.58,JP,,0000,0000,0000,,Қуатты 2000 жылға дейін қосу
Dialogue: 0,0:20:38.08,0:20:41.63,JP,,0000,0000,0000,,Нарихира 36 адам таңдаған ерекшеліктер негізінде қосымша 4000 ұпай алады.
Dialogue: 0,0:20:41.76,0:20:44.50,JP,,0000,0000,0000,,Соңында мені шақырып, Таңды аяқта.
Dialogue: 0,0:20:44.86,0:20:46.41,JP,,0000,0000,0000,,Сіз оны қатайтыңыз ба?
Dialogue: 0,0:20:45.15,0:20:46.68,JP-,,0000,0000,0000,,Тоғызыншы Тан шенеунігі
Dialogue: 0,0:20:46.76,0:20:49.70,JP,,0000,0000,0000,,Бірақ менің барлық палубаларымды отыз алты адам салған.
Dialogue: 0,0:20:50.19,0:20:52.09,JP,,0000,0000,0000,,Қуат арта береді
Dialogue: 0,0:20:52.62,0:20:53.25,JP,,0000,0000,0000,,Сурет салу
Dialogue: 0,0:20:53.98,0:20:55.84,JP,,0000,0000,0000,,Накатсуканы қорғаныс аймағына айналдырыңыз
Dialogue: 0,0:20:56.10,0:20:59.50,JP,,0000,0000,0000,,Сонымен қатар, Минамотоны шақырып, аяқтаңыз.
Dialogue: 0,0:21:00.12,0:21:01.65,JP,,0000,0000,0000,,Сіздің кезегіңіз.
Dialogue: 0,0:21:02.04,0:21:03.69,JP,,0000,0000,0000,,Бұлай жалғаса берсе, мен жеңілемін.
Dialogue: 0,0:21:02.90,0:21:04.45,JP-,,0000,0000,0000,,Оныншы Тан Тейка
Dialogue: 0,0:21:04.33,0:21:05.04,JP,,0000,0000,0000,,Моги мырзадан Цукидің қозғалысын бақылап отыруды сұраңызшы.
Dialogue: 0,0:21:05.53,0:21:10.38,JP,,0000,0000,0000,,Тейка Синг Тейка
Dialogue: 0,0:21:12.14,0:21:12.77,JP,,0000,0000,0000,,Сурет салу
Dialogue: 0,0:21:13.96,0:21:16.38,JP,,0000,0000,0000,,Коин Сенпай, бұл сенің шығының.
Dialogue: 0,0:21:16.93,0:21:17.48,JP,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:21:17.77,0:21:19.25,JP,,0000,0000,0000,,Мені шабуыл аймағына апарыңыз
Dialogue: 0,0:21:19.82,0:21:23.48,JP,,0000,0000,0000,,Император ханшайымы Шикиконы қорғаныс аймағына шақырыңыз
Dialogue: 0,0:21:23.82,0:21:25.89,JP,,0000,0000,0000,,Spec Kazura Teika іске қосылды
Dialogue: 0,0:21:26.34,0:21:28.85,JP,,0000,0000,0000,,Менен басқа ақындардың бәрі қабілетсіз.
Dialogue: 0,0:21:29.17,0:21:31.65,JP,,0000,0000,0000,,Мұнымен сені ешбір ақын қорғамайды.
Dialogue: 0,0:21:31.97,0:21:32.61,JP,,0000,0000,0000,,Келесі шайқас!
Dialogue: 0,0:21:32.80,0:21:36.70,JP,,0000,0000,0000,,«Конухито» қарары
Dialogue: 0,0:21:36.70,0:21:37.34,JP,,0000,0000,0000,,Оған дейін
Dialogue: 0,0:21:39.36,0:21:40.32,JP,,0000,0000,0000,,Цураюки Сенпай
Dialogue: 0,0:21:40.71,0:21:42.01,JP,,0000,0000,0000,,Ұрыс жоқ
Dialogue: 0,0:21:42.45,0:21:44.54,JP,,0000,0000,0000,,Екеуі де тамаша ақындар.
Dialogue: 0,0:21:44.66,0:21:46.60,JP,,0000,0000,0000,,Біз тіл табысуымыз керек.
Dialogue: 0,0:21:47.46,0:21:48.70,JP,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:21:49.02,0:21:51.51,JP,,0000,0000,0000,,Тейка-кун, сенің Хякунин Исшуың керемет.
Dialogue: 0,0:21:51.71,0:21:53.35,JP,,0000,0000,0000,,Тағы да әндер туралы айтайық
Dialogue: 0,0:21:53.83,0:21:54.42,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:21:54.43,0:21:57.74,JP,,0000,0000,0000,,Айтпақшы, Цураюки-сенпай, мен сіздің қолтаңбаңызды ала алмаймын.
Dialogue: 0,0:21:59.28,0:22:02.16,JP,,0000,0000,0000,,G1 ГРАН-ПРИ ФИНАЛ
Dialogue: 0,0:22:02.46,0:22:05.10,JP,,0000,0000,0000,,Көптеген апаттар. Шұңқырда хаос бар.
Dialogue: 0,0:22:06.68,0:22:08.16,JP,,0000,0000,0000,,Йорицуна-сан, жағдай
Dialogue: 0,0:22:08.67,0:22:09.87,JP,,0000,0000,0000,,Бір көлік тайып кетті.
Dialogue: 0,0:22:10.38,0:22:11.79,JP,,0000,0000,0000,,Бұл Мунесаданың өгіз арбасы.
Dialogue: 0,0:22:12.25,0:22:16.64,JP,,0000,0000,0000,,Бұл жүз түнмен салыстырғанда ештеңе емес.
Dialogue: 0,0:22:17.86,0:22:20.53,JP,,0000,0000,0000,,Йошико, мен саған жеңіс ұсынамын.
Dialogue: 0,0:22:20.91,0:22:22.99,JP,,0000,0000,0000,,Риошиму Мунесада шатасудан шығады
Dialogue: 0,0:22:23.21,0:22:25.79,JP,,0000,0000,0000,,Үлкен күшпен Камогава өзеніне қарай бет алу
Dialogue: 0,0:22:26.16,0:22:28.30,JP,,0000,0000,0000,,Жеңіс те, Йошико да менікі.
Dialogue: 0,0:22:31.94,0:22:33.90,JP,,0000,0000,0000,,Барлық автомобильдердің күтпеген жерден шығуы
Dialogue: 0,0:22:34.46,0:22:36.69,JP,,0000,0000,0000,,100 түндік сапар да босқа кеткен.
Dialogue: 0,0:22:36.81,0:22:40.15,JP,,0000,0000,0000,,Келесі жолы біз Дазайфуда ONE GRAND PRIX арбасын таныстырамыз
Dialogue: 0,0:22:40.43,0:22:42.99,JP,,0000,0000,0000,,Бәріңе сау болыңдар.
Dialogue: 0,0:24:17.63,0:24:22.08,JP,,0000,0000,0000,,Сен үшін, мен өмірімді де аямаймын.
Dialogue: 0,0:24:23.22,0:24:26.25,JP,,0000,0000,0000,,Ұзын өрмекшіні елестете аласыз ба?
Dialogue: 0,0:00:03.88,0:00:07.91,CN,,0000,0000,0000,,G1 Дайшу Хэянкио станциясы
Dialogue: 0,0:00:08.66,0:00:10.55,CN,,0000,0000,0000,,Жапонияның күтілетін келуі
Dialogue: 0,0:00:11.04,0:00:13.05,CN,,0000,0000,0000,,Тарих тарихындағы жаңа тарау
Dialogue: 0,0:00:13.15,0:00:16.26,CN,,0000,0000,0000,,Бірінші хабарландыру Ушико Дайкан Хэянкио станциясы
Dialogue: 0,0:00:16.89,0:00:19.03,CN,,0000,0000,0000,,Құны оған тұрарлық Фудзивара Садаи
Dialogue: 0,0:00:19.29,0:00:21.67,CN,,0000,0000,0000,,Уцуномия Сенсейдің түсіндірмесі
Dialogue: 0,0:00:21.92,0:00:22.99,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:23.44,0:00:25.10,CN,,0000,0000,0000,,Чжао мырзаның соңы
Dialogue: 0,0:00:25.29,0:00:26.26,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:26.33,0:00:30.59,CN,,0000,0000,0000,,Бұл Хэйан дәуірінде енгізілген жаңа желдерге сәйкес ауқымды кәсіпорын.
Dialogue: 0,0:00:31.24,0:00:33.83,CN,,0000,0000,0000,,Барлығыңызға келесі қадамдарды орындаңыз:
Dialogue: 0,0:00:34.48,0:00:36.36,CN,,0000,0000,0000,,Созаку-ин храмының жанындағы сызықтың басы
Dialogue: 0,0:00:36.45,0:00:37.63,CN,,0000,0000,0000,,Оңтүстікке қарай Созаку даңғылы
Dialogue: 0,0:00:37.74,0:00:39.39,CN,,0000,0000,0000,,Қамал қақпасынан өткеннен кейін шығысқа қарай жүріңіз.
Dialogue: 0,0:00:39.53,0:00:42.49,CN,,0000,0000,0000,,Сабан Китаками Ватарикава өзені Маэу Киёмизу храмы
Dialogue: 0,0:00:42.55,0:00:43.82,CN,,0000,0000,0000,,Жөндеу станциясы қайда орналасқан?
Dialogue: 0,0:00:43.85,0:00:45.77,CN,,0000,0000,0000,,Желімді қайта солтүстік өзенге ауыстыру
Dialogue: 0,0:00:45.82,0:00:48.86,CN,,0000,0000,0000,,Оучидегі Ичижо Оджи станциясына батысқа қарай саяхаттау
Dialogue: 0,0:00:49.05,0:00:51.35,CN,,0000,0000,0000,,Созақу даңғылына соңғы бару.
Dialogue: 0,0:00:51.54,0:00:53.54,CN,,0000,0000,0000,,Сіз үшін ең маңыздысы, мырза.
Dialogue: 0,0:00:53.90,0:00:56.59,CN,,0000,0000,0000,,Кийомизу-дера храмының жанында тау бар екені рас.
Dialogue: 0,0:00:56.77,0:00:58.60,CN,,0000,0000,0000,,Жоғарыда айтылғандардың қомақты сома екені даусыз.
Dialogue: 0,0:00:59.01,0:01:01.24,CN,,0000,0000,0000,,Көлік құралдарының озық технологиясы талаптарын ұсыну
Dialogue: 0,0:01:01.89,0:01:03.85,CN,,0000,0000,0000,,Кіріспеге кіріспе
Dialogue: 0,0:01:04.54,0:01:07.45,CN,,0000,0000,0000,,Аривара Джахеидің азғын дыбысының жылдамдығы
Dialogue: 0,0:01:07.86,0:01:10.70,CN,,0000,0000,0000,,Екінші атау – жыл жылы.
Dialogue: 0,0:01:11.12,0:01:14.38,CN,,0000,0000,0000,,No3 позициядан жоғары технология шебері Буня Ясухиде және одан кейін
Dialogue: 0,0:01:14.75,0:01:17.34,CN,,0000,0000,0000,,№4 - Инаба но Юкихира Аривара
Dialogue: 0,0:01:17.72,0:01:20.43,CN,,0000,0000,0000,,№5 Коукар 100 шайқас
Dialogue: 0,0:01:20.80,0:01:23.70,CN,,0000,0000,0000,,Бұдан кейін соңғы позиция алынып тасталады.
Dialogue: 0,0:01:23.99,0:01:26.12,CN,,0000,0000,0000,,Отомо Курошу сайлаудың ортасында.
Dialogue: 0,0:01:26.75,0:01:29.94,CN,,0000,0000,0000,,Нана Бірінші тағының нұрына ешкім көтеріле алмайды.
Dialogue: 0,0:01:30.28,0:01:32.28,CN,,0000,0000,0000,,Жаңа тарихтың алғашқы беті
Dialogue: 0,0:03:13.00,0:03:18.30,&,,0000,0000,0000,,Тұрақты бөлме
Dialogue: 0,0:03:13.00,0:03:18.30,,,0000,0000,0000,,Ескертпе: Бұл `` Йоко бөлмесі '' туралы әйгілі жапондық шолу.
Dialogue: 0,0:03:23.82,0:03:26.72,CN,,0000,0000,0000,,Ояёси Корисатоның бөлмесі
Dialogue: 0,0:03:27.01,0:03:30.21,CN,,0000,0000,0000,,Енді аспан ерте Хэйан кезеңінің ұлы сәулесі.
Dialogue: 0,0:03:30.39,0:03:35.50,CN,,0000,0000,0000,,Аривара Джахеи мырза, Ононокомачи Косуке, Ясухиде Фумия мырза
Dialogue: 0,0:03:35.78,0:03:36.40,CN,,0000,0000,0000,,Сәлем
Dialogue: 0,0:03:36.72,0:03:37.31,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:37.74,0:03:40.58,CN,,0000,0000,0000,,Таңдаулы алты өлмес ақынсыңдар.
Dialogue: 0,0:03:41.01,0:03:45.22,CN,,0000,0000,0000,,Дегенмен, бұл Гендзи прототипінің атауы.
Dialogue: 0,0:03:46.02,0:03:47.99,CN,,0000,0000,0000,,Комачи әлемдегі ең әдемі үш әйелдің бірі.
Dialogue: 0,0:03:48.53,0:03:50.89,CN,,0000,0000,0000,,Осыдан кейін...
Dialogue: 0,0:03:51.63,0:03:53.44,CN,,0000,0000,0000,,Сынақ әңгіме мұғалімі Ясухиде
Dialogue: 0,0:03:53.89,0:03:55.03,CN,,0000,0000,0000,,Маған не істей алатыныңызды айтыңыз.
Dialogue: 0,0:03:56.04,0:04:00.19,CN,,0000,0000,0000,,Әйтсе де ер де, әйел десің.
Dialogue: 0,0:04:00.44,0:04:03.09,CN,,0000,0000,0000,,Өз махаббатыңыз туралы не ойлайсыз?
Dialogue: 0,0:04:03.14,0:04:03.98,CN,,0000,0000,0000,,Киариджи
Dialogue: 0,0:04:05.26,0:04:06.80,CN,,0000,0000,0000,,Жауабын алыңыз
Dialogue: 0,0:04:07.00,0:04:11.03,CN,,0000,0000,0000,,Өйткені ересек әйел жыныс жүйесі қауіп төніп тұр.
Dialogue: 0,0:04:11.13,0:04:11.81,CN,,0000,0000,0000,,Өлгендер арасында жоғалған
Dialogue: 0,0:04:12.36,0:04:15.85,CN,,0000,0000,0000,,Император Коудың мұрагері
Dialogue: 0,0:04:16.21,0:04:16.95,CN,,0000,0000,0000,,Хигучи
Dialogue: 0,0:04:17.06,0:04:22.99,&,,0000,0000,0000,,Қайын жұрты = Императордың әйелі, әпкесі, т.б.
Dialogue: 0,0:04:17.67,0:04:22.86,CN,,0000,0000,0000,,Егер сіз үйленбеген, корольдік және ерекше король ханшайымын таңдағыңыз келсе,
Dialogue: 0,0:04:23.41,0:04:24.48,CN,,0000,0000,0000,,Нағыз батылдық
Dialogue: 0,0:04:24.95,0:04:26.79,CN,,0000,0000,0000,,Қалада қандай махаббат бар?
Dialogue: 0,0:04:27.26,0:04:29.12,CN,,0000,0000,0000,,Үлкен зиян мен заңсыз махаббат аяқталады
Dialogue: 0,0:04:29.61,0:04:33.32,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:33.75,0:04:35.54,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:36.00,0:04:37.47,CN,,0000,0000,0000,,Өте жыртқыш тип
Dialogue: 0,0:04:37.86,0:04:41.33,CN,,0000,0000,0000,,21-ші буын туралы айту
Dialogue: 0,0:04:41.63,0:04:43.93,CN,,0000,0000,0000,,Әңгімелесу
Dialogue: 0,0:04:44.44,0:04:48.32,CN,,0000,0000,0000,,Комачи ересектерінің мақсаты өзгермеді.
Dialogue: 0,0:04:48.66,0:04:53.08,CN,,0000,0000,0000,,Бұл кісінің әңгімесі Мен үлкен кеуделерді жақсы көремін
Dialogue: 0,0:04:53.24,0:04:54.84,CN,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:04:55.30,0:04:58.40,CN,,0000,0000,0000,,Алайда, өмір сүру мүмкін болмаса
Dialogue: 0,0:04:59.14,0:05:04.36,CN,,0000,0000,0000,,Мен белгілі бір адамдар санына ие болуға бел байладым.
Dialogue: 0,0:05:04.75,0:05:05.95,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:06.47,0:05:09.93,CN,,0000,0000,0000,,Жұмыс анықтамасы Юкихира Гадайдың әйелі мен баласы ересек Хироко
Dialogue: 0,0:05:10.53,0:05:11.61,CN,,0000,0000,0000,,G
Dialogue: 0,0:05:11.75,0:05:13.17,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:13.62,0:05:14.75,CN,,0000,0000,0000,,Жариялаған Комачи…
Dialogue: 0,0:05:19.94,0:05:22.60,CN,,0000,0000,0000,,Соңы келді. Бұл Цукуба таудың соңы.
Dialogue: 0,0:05:22.97,0:05:25.28,CN,,0000,0000,0000,,Цукуба Вакакай тауы кезеңі
Dialogue: 0,0:05:25.82,0:05:29.04,CN,,0000,0000,0000,,1970 жылдары құрылған, ерлер мен әйелдер арасындағы махаббат әні.
Dialogue: 0,0:05:29.35,0:05:33.67,CN,,0000,0000,0000,,Жетістік: Бір түнде Ресей мен Су тарихындағы әйгілі жеңіс.
Dialogue: 0,0:05:33.73,0:05:36.29,CN,,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:05:36.31,0:05:37.80,CN,,0000,0000,0000,,Мен сені жақын арада көремін деп күтемін.
Dialogue: 0,0:05:38.12,0:05:42.30,,,0000,0000,0000,,Бұл Цукуба тауы, бұл Вакакай кезеңі.
Dialogue: 0,0:05:37.98,0:05:42.30,CN,,0000,0000,0000,,Елдің шығыс бөлігіне басқа адамдар келді.
Dialogue: 0,0:05:44.09,0:05:46.61,CN,,0000,0000,0000,,Мен өз жұмысыммен айналысамын.
Dialogue: 0,0:05:46.77,0:05:47.88,CN,,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:05:49.38,0:05:51.42,CN,,0000,0000,0000,,Күннің соңында
Dialogue: 0,0:05:54.06,0:05:56.40,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:57.09,0:06:00.32,CN,,0000,0000,0000,,Комачи Казуяны және оның жалғыз адам мен жесір ретіндегі өмірін түсіндіру мүмкін және мүмкін емес.
Dialogue: 0,0:06:01.03,0:06:03.30,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:03.78,0:06:05.85,CN,,0000,0000,0000,,Менің алғашқы поэзиялық кездесуімнен кейін
Dialogue: 0,0:06:07.44,0:06:09.15,CN,,0000,0000,0000,,Бағдарламаны ашу керек пе?
Dialogue: 0,0:06:10.07,0:06:13.08,CN,,0000,0000,0000,,Бұл бірінші әйел екені рас.
Dialogue: 0,0:06:13.19,0:06:15.00,CN,,0000,0000,0000,,Бұл мәселе емес
Dialogue: 0,0:06:15.15,0:06:17.53,CN,,0000,0000,0000,,Мен рейстен шыққанда, адам келді.
Dialogue: 0,0:06:18.02,0:06:20.01,CN,,0000,0000,0000,,Алдымен не киесің
Dialogue: 0,0:06:20.72,0:06:21.31,CN,,0000,0000,0000,,Уолтер Эванс (59)
Dialogue: 0,0:06:21.59,0:06:22.22,CN,,0000,0000,0000,,Хобо
Dialogue: 0,0:06:22.41,0:06:24.51,CN,,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:06:24.87,0:06:27.28,CN,,0000,0000,0000,,COS алу бойынша кеңес
Dialogue: 0,0:06:27.30,0:06:29.38,CN,,0000,0000,0000,,Ең аз ақпарат қажет.
Dialogue: 0,0:06:29.54,0:06:31.93,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:32.14,0:06:34.96,CN,,0000,0000,0000,,Екі аралас жұмыртқа
Dialogue: 0,0:06:35.94,0:06:38.02,CN,,0000,0000,0000,,Мен де көтермелеу үшін ризамын...
Dialogue: 0,0:06:38.60,0:06:39.50,CN,,0000,0000,0000,,Ко Комачи
Dialogue: 0,0:06:40.74,0:06:41.23,CN,,0000,0000,0000,,Ондық
Dialogue: 0,0:06:41.90,0:06:44.14,CN,,0000,0000,0000,,Іс жүзінде
Dialogue: 0,0:06:45.05,0:06:47.43,CN,,0000,0000,0000,,I
Dialogue: 0,0:06:47.74,0:06:51.78,CN,,0000,0000,0000,,Қуаныш, ләззат, ләззат.
Dialogue: 0,0:06:52.29,0:06:52.74,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:53.10,0:06:53.59,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:56.20,0:07:00.23,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:00.69,0:07:02.47,CN,,0000,0000,0000,,Күлкі ойнау~
Dialogue: 0,0:07:02.96,0:07:04.68,CN,,0000,0000,0000,,Әйтсе де, мен жүзден қорқамын.
Dialogue: 0,0:07:05.66,0:07:08.54,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:08.40,0:07:15.40,,,0000,0000,0000,,Ойын
Dialogue: 0,0:07:09.38,0:07:12.60,CN,,0000,0000,0000,,Елордаға қарсы ойнау үшін қажет қолайсыз жер
Dialogue: 0,0:07:12.68,0:07:15.12,CN,,0000,0000,0000,,Сіз қайдасыз?
Dialogue: 0,0:07:15.81,0:07:17.03,CN,,0000,0000,0000,,Гакуэн үйленген әйел
Dialogue: 0,0:07:17.41,0:07:21.13,CN,,0000,0000,0000,,Ясухиденің ерлі-зайыпты әйелдің трагедиялық оқиғасын ересектерге арналған драмалық қойылымы
Dialogue: 0,0:07:22.67,0:07:25.19,CN,,0000,0000,0000,,Бұл міндетті түрде болуы керек.
Dialogue: 0,0:07:25.83,0:07:27.64,CN,,0000,0000,0000,,Келесі жолы ән
Dialogue: 0,0:07:28.02,0:07:30.21,CN,,0000,0000,0000,,Цукуба Саньяның өлең ретіндегі шығармасы
Dialogue: 0,0:07:30.65,0:07:31.88,CN,,0000,0000,0000,,Цукуба Цукуба
Dialogue: 0,0:07:33.14,0:07:36.68,&,,0000,0000,0000,,Коичико Тарубане
Dialogue: 0,0:07:34.85,0:07:36.68,&,,0000,0000,0000,,Егер сізде балық жоқ болса, оны қолданыңыз.
Dialogue: 0,0:07:36.10,0:07:36.68,&,,0000,0000,0000,,Тапсырысыңыздың екі данасы
Dialogue: 0,0:07:33.14,0:07:36.68,,,0000,0000,0000,,Ескерту: Үш сөз тіркесінің бірінші таңбасы «Цукуба».
Dialogue: 0,0:07:39.04,0:07:41.53,CN,,0000,0000,0000,,Әңгімені оқу оңай
Dialogue: 0,0:07:43.54,0:07:45.07,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:45.39,0:07:46.08,CN,,0000,0000,0000,,Қосылым жоқ
Dialogue: 0,0:07:47.75,0:07:48.56,CN,,0000,0000,0000,,Лайк қой және тыңдама
Dialogue: 0,0:07:49.88,0:07:53.31,CN,,0000,0000,0000,,G1 Дайшу Хэянкио станциясы
Dialogue: 0,0:07:53.73,0:07:56.50,CN,,0000,0000,0000,,Кездесудің жеңімпазы.
Dialogue: 0,0:07:56.65,0:07:58.82,CN,,0000,0000,0000,,Толық бақылау менің ойымша.
Dialogue: 0,0:07:58.97,0:08:01.00,CN,,0000,0000,0000,,Дегенмен, бұл қазына.
Dialogue: 0,0:08:01.20,0:08:03.01,CN,,0000,0000,0000,,Юкихира - мырзаның шебері.
Dialogue: 0,0:08:03.21,0:08:04.87,CN,,0000,0000,0000,,Жүрегім су адамдар, Құқық пәнінің мұғалімі болғаныма қуанамын.
Dialogue: 0,0:08:05.15,0:08:06.73,CN,,0000,0000,0000,,Сен кімді жақсы көресің?
Dialogue: 0,0:08:07.75,0:08:09.21,CN,,0000,0000,0000,,Қызыл сигналды қосу
Dialogue: 0,0:08:13.53,0:08:14.92,CN,,0000,0000,0000,,Салыстырудың басталуы
Dialogue: 0,0:08:17.68,0:08:23.44,&,,0000,0000,0000,,Тұрақты бөлме
Dialogue: 0,0:08:28.42,0:08:29.97,CN,,0000,0000,0000,,Қабылдау бөлмесі және қарттар үйі
Dialogue: 0,0:08:30.44,0:08:35.87,CN,,0000,0000,0000,,Келесі қонақ – жоғары шенді генерал-майор А.
Dialogue: 0,0:08:36.48,0:08:39.92,CN,,0000,0000,0000,,Император Нинмей қайтыс болғаннан кейін
Dialogue: 0,0:08:40.06,0:08:41.98,CN,,0000,0000,0000,,Тағайындалған монах адал
Dialogue: 0,0:08:42.11,0:08:45.59,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:45.59,0:08:46.24,CN,,0000,0000,0000,,Тейка ересек
Dialogue: 0,0:08:46.56,0:08:47.04,CN,,0000,0000,0000,,Ондық
Dialogue: 0,0:08:47.40,0:08:51.04,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:51.44,0:08:53.21,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:53.74,0:08:57.34,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:57.85,0:08:59.14,CN,,0000,0000,0000,,Нәпсіқұмар діни қызметкер?
Dialogue: 0,0:08:59.68,0:09:02.05,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:02.08,0:09:04.68,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:04.68,0:09:06.70,CN,,0000,0000,0000,,Заңдар мен ережелерден толығымен бос
Dialogue: 0,0:09:06.72,0:09:08.30,CN,,0000,0000,0000,,Азғын діни қызметкер бол
Dialogue: 0,0:09:08.34,0:09:09.31,CN,,0000,0000,0000,,Азғын діни қызметкер
Dialogue: 0,0:09:09.47,0:09:10.15,CN,,0000,0000,0000,,Азғын монах
Dialogue: 0,0:09:10.15,0:09:14.00,CN,,0000,0000,0000,,Астанасы 100 адам, Исшури.
Dialogue: 0,0:09:14.34,0:09:15.73,CN,,0000,0000,0000,,…
Dialogue: 0,0:09:15.73,0:09:19.29,CN,,0000,0000,0000,,Орын алған соң Ишинді оқыту
Dialogue: 0,0:09:19.29,0:09:21.14,CN,,0000,0000,0000,,Монах дәрежесіне көтерілудің соңы
Dialogue: 0,0:09:19.29,0:09:21.14,,,0000,0000,0000,,Ескерту: Монах: Монахтардың ең жоғарғы деңгейін басқаратын ұлттық монах.
Dialogue: 0,0:09:21.97,0:09:24.72,CN,,0000,0000,0000,,Мен сізді жеткілікті құрметтеймін.
Dialogue: 0,0:09:26.70,0:09:30.56,CN,,0000,0000,0000,,Иә...Көп аты бар адамның жазылатын кездері болады.
Dialogue: 0,0:09:30.66,0:09:33.77,CN,,0000,0000,0000,,Сенім мен халықтың сенімі осында.
Dialogue: 0,0:09:34.32,0:09:36.75,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:37.08,0:09:39.40,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:39.72,0:09:43.67,CN,,0000,0000,0000,,Сейшо Шикибу Мурасаки Шикибу Ононокомачи Юйато - осылай
Dialogue: 0,0:09:43.99,0:09:47.70,CN,,0000,0000,0000,,Дұрыс генерал – заңның анасы, ниет – заңның анасы...
Dialogue: 0,0:09:45.74,0:09:48.46,,,0000,0000,0000,,Йошико Комачи…
Dialogue: 0,0:09:50.36,0:09:53.24,CN,,0000,0000,0000,,Йошико отбасының қыз баласы
Dialogue: 0,0:09:53.49,0:09:57.18,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:58.00,0:10:00.90,CN,,0000,0000,0000,,Отбасы мүшелерінің болуына байланысты
Dialogue: 0,0:10:01.63,0:10:04.72,CN,,0000,0000,0000,,Ересектерге арналған жан-жақты ойын-сауық және сыртқы әлемге арналған ойын-сауық.
Dialogue: 0,0:10:05.00,0:10:08.67,CN,,0000,0000,0000,,Бұл менің әпкем.
Dialogue: 0,0:10:09.18,0:10:10.00,CN,,0000,0000,0000,,Әпке
Dialogue: 0,0:10:11.17,0:10:12.97,CN,,0000,0000,0000,,На…на…
Dialogue: 0,0:10:13.53,0:10:18.14,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:19.20,0:10:23.50,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:23.73,0:10:24.79,CN,,0000,0000,0000,,Мынау болатын жер.
Dialogue: 0,0:10:25.26,0:10:29.25,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:29.65,0:10:32.08,CN,,0000,0000,0000,,Йошико айқайлайды
Dialogue: 0,0:10:32.35,0:10:34.48,CN,,0000,0000,0000,,Мен де осыны алғым келеді.
Dialogue: 0,0:10:34.89,0:10:37.69,CN,,0000,0000,0000,,Бұлай емес.
Dialogue: 0,0:10:38.34,0:10:42.31,CN,,0000,0000,0000,,Өйткені аяқталғаннан кейін, 100 күн мен түн өтіп, неке аяқталуы керек.
Dialogue: 0,0:10:42.37,0:10:44.88,CN,,0000,0000,0000,,Казурай Нагата
Dialogue: 0,0:10:47.92,0:10:48.88,CN,,0000,0000,0000,,Заңды тұлға
Dialogue: 0,0:10:50.24,0:10:51.31,CN,,0000,0000,0000,,Гор
Dialogue: 0,0:10:52.59,0:10:53.62,CN,,0000,0000,0000,,Суэй мырза
Dialogue: 0,0:10:54.27,0:10:56.81,CN,,0000,0000,0000,,Какунен «Шатқал» мен «Әпке апа» рас.
Dialogue: 0,0:10:58.58,0:10:59.99,CN,,0000,0000,0000,,Тереңдік сезіміне ие болу
Dialogue: 0,0:11:01.28,0:11:01.72,CN,,0000,0000,0000,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:11:00.05,0:11:03.01,,,0000,0000,0000,,Чохьякунин Исшу Вакаджо
Dialogue: 0,0:11:04.31,0:11:05.78,CN,,0000,0000,0000,,Бүгін кешті сіздерге ұсынамын
Dialogue: 0,0:11:06.25,0:11:08.67,CN,,0000,0000,0000,,Түнгі сұлу арман Түнгі түнгі махаббат
Dialogue: 0,0:11:09.92,0:11:11.64,CN,,0000,0000,0000,,Хейан Уширо клубы
Dialogue: 0,0:11:12.02,0:11:14.82,CN,,0000,0000,0000,,Мен ескі тақта Юкихира Ариварамын
Dialogue: 0,0:11:15.52,0:11:18.76,CN,,0000,0000,0000,,Қазіргі уақытта мен бас дүкендегі сымбатты жігітпін.
Dialogue: 0,0:11:19.49,0:11:23.70,CN,,0000,0000,0000,,№5 бас дүкен Кіші інісінің әдеби жасы Тейка
Dialogue: 0,0:11:24.24,0:11:25.56,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:26.09,0:11:29.31,CN,,0000,0000,0000,,Ханымдар мен мырзалар, маған көп нәрсені үйретіңіз.
Dialogue: 0,0:11:29.50,0:11:31.21,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:31.45,0:11:34.70,CN,,0000,0000,0000,,Бас кеңсе №4 Ясухиде
Dialogue: 0,0:11:35.10,0:11:36.36,CN,,0000,0000,0000,,Ең танымал шолу
Dialogue: 0,0:11:36.85,0:11:39.02,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:39.04,0:11:40.74,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:40.94,0:11:44.96,CN,,0000,0000,0000,,Негізгі дүкен №3 Ақылсыздық, менмендік және мания
Dialogue: 0,0:11:45.79,0:11:47.66,CN,,0000,0000,0000,,Басқаларды қорлауды күтетін әйел тез өседі.
Dialogue: 0,0:11:47.92,0:11:50.90,CN,,0000,0000,0000,,Маған қара, маған қара.
Dialogue: 0,0:11:51.03,0:11:53.15,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:53.23,0:11:56.75,CN,,0000,0000,0000,,№2 бас дүкен
Dialogue: 0,0:11:57.34,0:11:59.47,CN,,0000,0000,0000,,Ұқыпты 100 күн мен түн
Dialogue: 0,0:12:00.13,0:12:02.21,CN,,0000,0000,0000,,Мен сізге хабарласа алмаймын
Dialogue: 0,0:12:02.36,0:12:04.01,CN,,0000,0000,0000,,Келесі
Dialogue: 0,0:12:04.29,0:12:09.83,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:10.89,0:12:13.65,CN,,0000,0000,0000,,Ересек ханшайым Мен сені тез сүйемін
Dialogue: 0,0:12:14.74,0:12:18.54,CN,,0000,0000,0000,,Сүйген адамыңды сүй.
Dialogue: 0,0:12:20.40,0:12:22.25,CN,,0000,0000,0000,,Нені шын, нені көңілді?
Dialogue: 0,0:12:23.83,0:12:25.90,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:26.60,0:12:29.31,CN,,0000,0000,0000,,Сізге аспанның қызыл түсі де жарасады.
Dialogue: 0,0:12:29.81,0:12:30.54,CN,,0000,0000,0000,,Тайми Рио
Dialogue: 0,0:12:33.22,0:12:35.01,CN,,0000,0000,0000,,Рай Джубей Когио Кинг
Dialogue: 0,0:12:35.20,0:12:37.64,CN,,0000,0000,0000,,Жоғарғы ұнтақ түсті патша
Dialogue: 0,0:12:35.40,0:12:39.31,,,0000,0000,0000,,Ай ағыны тоғыз айдаһар тостаған түнгі түс ағыны жарық таң оқиғасы
Dialogue: 0,0:12:39.66,0:12:45.26,,,0000,0000,0000,,Хош иісті таяқшалар, хош иісті заттар, хош иісті заттар.
Dialogue: 0,0:12:38.54,0:12:44.30,CN,,0000,0000,0000,,Хейан Уширо клубы, сіз махаббаттың әрбір түріне дайынсыз және нұр шашып тұр.
Dialogue: 0,0:12:45.59,0:12:49.09,CN,,0000,0000,0000,,G1 Дайшу Хэянкио станциясы
Dialogue: 0,0:12:50.95,0:12:56.96,&,,0000,0000,0000,,Үй тәрізді бөлме
Dialogue: 0,0:13:01.56,0:13:04.09,CN,,0000,0000,0000,,Сәттілік, мен Fujiwara no Sadaie иесімін.
Dialogue: 0,0:13:04.39,0:13:07.01,CN,,0000,0000,0000,,Мен Уцуномия желісін жақтаймын.
Dialogue: 0,0:13:07.24,0:13:09.43,CN,,0000,0000,0000,,Бұл бірінші неке
Dialogue: 0,0:13:09.73,0:13:10.82,CN,,0000,0000,0000,,Дегенмен біз жас жұбайлармыз.
Dialogue: 0,0:13:11.19,0:13:14.07,CN,,0000,0000,0000,,...
