Dialogue: 0,0:00:02.32,0:00:05.03,JP,,0000,0000,0000,,Не йите Тейка
Dialogue: 0,0:00:09.27,0:00:13.04,JP,,0000,0000,0000,,Танысқаныма қуаныштымын, менің атым Тейка Фудзивара.
Dialogue: 0,0:00:14.59,0:00:17.37,JP,,0000,0000,0000,,Сіз Хякунин Исшуды білесіз бе?
Dialogue: 0,0:00:19.13,0:00:20.10,JP,,0000,0000,0000,,Карута ойыншысы
Dialogue: 0,0:00:22.18,0:00:25.19,JP,,0000,0000,0000,,Біреулер «Бозу-мекури» сияқты бірдеңемен ойнады ма деп ойлаймын.
Dialogue: 0,0:00:25.90,0:00:26.33,JP,,0000,0000,0000,,Бірақ
Dialogue: 0,0:00:26.82,0:00:31.39,JP,,0000,0000,0000,,Бұл бастапқыда таулы вилланың жылжымалы есіктерін безендіру үшін қолданылатын түсті қағаз пішіні болды.
Dialogue: 0,0:00:32.44,0:00:35.36,JP,,0000,0000,0000,,Барлық уақыттағы 100 ұлы ақынның әрқайсысынан бір өлең
Dialogue: 0,0:00:35.98,0:00:37.08,JP,,0000,0000,0000,,Барлығы 100 өлең
Dialogue: 0,0:00:38.24,0:00:39.29,JP,,0000,0000,0000,,Мен таңдадым
Dialogue: 0,0:00:42.09,0:00:43.59,JP,,0000,0000,0000,,Өйткені мен өз қалауым бойынша таңдадым.
Dialogue: 0,0:00:43.79,0:00:45.45,JP,,0000,0000,0000,,Менің хоббиім шықты
Dialogue: 0,0:00:45.97,0:00:49.04,JP,,0000,0000,0000,,43 махаббат әні бар!
Dialogue: 0,0:00:49.71,0:00:52.20,JP,,0000,0000,0000,,Иә, маған ұнайтын нәрсе
Dialogue: 0,0:00:53.74,0:00:54.43,JP,,0000,0000,0000,,Махаббат әні
Dialogue: 0,0:02:55.61,0:02:56.45,JP,,0000,0000,0000,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:02:56.88,0:02:58.44,JP,,0000,0000,0000,,Оя Нарихира-доно
Dialogue: 0,0:02:59.54,0:03:01.15,JP,,0000,0000,0000,,Сізді жақсы көретін ханшайым болды ма?
Dialogue: 0,0:03:01.83,0:03:04.24,JP,,0000,0000,0000,,Бүгінгі таңдағы ең көп түс таңдауы нені қызықтырды?
Dialogue: 0,0:03:04.42,0:03:05.91,JP,,0000,0000,0000,,Бұл аянышты ханшайым.
Dialogue: 0,0:03:07.59,0:03:08.69,JP,,0000,0000,0000,,Бұл қорқынышты естіледі.
Dialogue: 0,0:03:09.64,0:03:11.10,JP,,0000,0000,0000,,Әй, қай ханшайым?
Dialogue: 0,0:03:11.76,0:03:13.40,JP,,0000,0000,0000,,Сол орта
Dialogue: 0,0:03:14.20,0:03:17.01,JP,,0000,0000,0000,,О, бұл Такако Фудзивара.
Dialogue: 0,0:03:17.79,0:03:21.07,JP,,0000,0000,0000,,Нагараның қызы, Фудзивара Кита отбасының тікелей ұрпағы.
Dialogue: 0,0:03:22.22,0:03:23.15,JP,,0000,0000,0000,,Лорд Нагараның
Dialogue: 0,0:03:39.96,0:03:42.37,JP,,0000,0000,0000,,Құрметті Такако Құрметті Такако
Dialogue: 0,0:03:43.26,0:03:45.19,JP,,0000,0000,0000,,Мен ол кісіден хат алдым.
Dialogue: 0,0:03:45.73,0:03:46.69,JP,,0000,0000,0000,,Матанано
Dialogue: 0,0:03:47.40,0:03:50.55,JP,,0000,0000,0000,,Мен бес бөлімді биден бері ештеңе үйренген жоқпын.
Dialogue: 0,0:03:51.05,0:03:53.11,JP,,0000,0000,0000,,Сіз де араша болуға тырыспаңыз.
Dialogue: 0,0:03:53.63,0:03:57.46,JP,,0000,0000,0000,,Өйткені бұл Аривара Нарихираның мәтіні.
Dialogue: 0,0:03:57.94,0:03:59.48,JP,,0000,0000,0000,,Мен бас тарта алмаймын.
Dialogue: 0,0:04:00.01,0:04:02.54,JP,,0000,0000,0000,,Енді бүгін маған қандай ән сыйладың?
Dialogue: 0,0:04:02.81,0:04:03.90,JP,,0000,0000,0000,,Эбисудың хаос тудыратын сиқыршы екенін ойласаң...
Dialogue: 0,0:04:16.32,0:04:17.96,JP,,0000,0000,0000,,Егер мен жел болсам
Dialogue: 0,0:04:18.32,0:04:20.36,JP,,0000,0000,0000,,Сізге жалюзи арасындағы саңылау арқылы
Dialogue: 0,0:04:20.71,0:04:22.01,JP,,0000,0000,0000,,Мен кіре аламын.
Dialogue: 0,0:04:24.33,0:04:28.23,JP,,0000,0000,0000,,Ей, сен неге Раббысыз таң қалдың?
Dialogue: 0,0:04:29.15,0:04:32.97,JP,,0000,0000,0000,,Өйткені Нарихира біздің заманымыздың ең сымбатты адамы.
Dialogue: 0,0:04:33.14,0:04:38.39,JP,,0000,0000,0000,,Мұндай адам мен Такако-сама арасындағы махаббатқа делдал болу арман сияқты болар еді.
Dialogue: 0,0:04:38.69,0:04:41.23,JP,,0000,0000,0000,,Мен Такако-самаға дәл қазір қызмет еттім...
Dialogue: 0,0:04:41.23,0:04:43.19,JP,,0000,0000,0000,,Жарайды, мұны маған қайтарыңыз.
Dialogue: 0,0:04:52.78,0:04:54.63,JP,,0000,0000,0000,,Сен желдің орнында болсаң қандай болар едің?
Dialogue: 0,0:04:55.10,0:04:57.52,JP,,0000,0000,0000,,Жарық арқылы біреудің кіруіне кім рұқсат береді?
Dialogue: 0,0:04:57.77,0:04:58.69,JP,,0000,0000,0000,,Иә, кешіріңіз
Dialogue: 0,0:04:59.10,0:05:01.51,JP,,0000,0000,0000,,Ой, қандай қызықсыз ән
Dialogue: 0,0:05:02.21,0:05:05.10,JP,,0000,0000,0000,,Мен сізге жылы сөздер айтсам да...
Dialogue: 0,0:05:05.10,0:05:07.95,JP,,0000,0000,0000,,Сен мені мазақ етіп тұрсың
Dialogue: 0,0:05:10.10,0:05:13.96,JP,,0000,0000,0000,,Менің ойымша, ол тартымды мемлекеттік қызметкер, өйткені бұл туралы көп айтылды.
Dialogue: 0,0:05:14.77,0:05:17.48,JP,,0000,0000,0000,,Әйтеуір, анау-мынау қыдырып жүрген жүзі бар жігіт.
Dialogue: 0,0:05:18.97,0:05:20.88,JP,,0000,0000,0000,,Бір түндік қарым-қатынас болса да
Dialogue: 0,0:05:21.24,0:05:22.94,JP,,0000,0000,0000,,Маған сәйкес емес
Dialogue: 0,0:05:24.59,0:05:29.78,JP,,0000,0000,0000,,Иә, мен Фудзивара Кита әулетінің тікелей ұрпағы Нагараның қызымын.
Dialogue: 0,0:05:30.48,0:05:36.71,JP,,0000,0000,0000,,Императордың жаңа жылдық мерекесінен кейін ол ортаңғы сарайда жұбай болады.
Dialogue: 0,0:05:40.75,0:05:42.97,JP,,0000,0000,0000,,Әй, әдемі ай болды.
Dialogue: 0,0:05:45.24,0:05:46.07,JP,,0000,0000,0000,,Қайырлы кеш
Dialogue: 0,0:05:51.22,0:05:51.89,JP,,0000,0000,0000,,Тыныш болыңыз
Dialogue: 0,0:05:52.74,0:05:53.31,JP,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:05:54.28,0:05:54.90,JP,,0000,0000,0000,,Бұл жел
Dialogue: 0,0:05:55.90,0:05:56.37,JP,,0000,0000,0000,,Жел
Dialogue: 0,0:05:57.72,0:05:59.68,JP,,0000,0000,0000,,Махаббат отына күйгенше
Dialogue: 0,0:06:00.67,0:06:03.58,JP,,0000,0000,0000,,Мен желге айналып, саған жасырын барғым келеді дедім.
Dialogue: 0,0:06:04.79,0:06:07.55,JP,,0000,0000,0000,,Сіз ақымақ адамның атын ұмыттыңыз ба?
Dialogue: 0,0:06:10.58,0:06:11.69,JP,,0000,0000,0000,,Нарихираден
Dialogue: 0,0:06:11.90,0:06:12.22,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:06:13.03,0:06:13.81,JP,,0000,0000,0000,,Неге мұнда?
Dialogue: 0,0:06:14.51,0:06:16.60,JP,,0000,0000,0000,,Мен сатылған жекпе-жекті сатып алуға келдім.
Dialogue: 0,0:06:17.01,0:06:18.55,JP,,0000,0000,0000,,Не... қандай ақымақ
Dialogue: 0,0:06:19.05,0:06:20.47,JP,,0000,0000,0000,,Сіз бұл жердің қай жерде екенін білесіз бе?
Dialogue: 0,0:06:20.91,0:06:24.34,JP,,0000,0000,0000,,Егер сіз орынды таңдасаңыз, мен сізді сыртқа апара аламын ба?
Dialogue: 0,0:06:24.61,0:06:25.37,JP,,0000,0000,0000,,Алданбаңыз
Dialogue: 0,0:06:26.50,0:06:28.56,JP,,0000,0000,0000,,Мен... Мен кіммін?
Dialogue: 0,0:06:30.40,0:06:31.90,JP,,0000,0000,0000,,...
Dialogue: 0,0:06:32.88,0:06:37.71,JP,,0000,0000,0000,,…
Dialogue: 0,0:06:42.15,0:06:45.18,JP,,0000,0000,0000,,Сен олай қорықпасаң да, мен ештеңе істемеймін.
Dialogue: 0,0:06:46.00,0:06:47.47,JP,,0000,0000,0000,,Өйткені көп нәрсені қажет етпейді.
Dialogue: 0,0:06:47.85,0:06:49.97,JP,,0000,0000,0000,,Мен аздап тым нашар міндім.
Dialogue: 0,0:06:52.38,0:06:54.80,JP,,0000,0000,0000,,Көптеген ұятсыз дауыстар көтерілді.
Dialogue: 0,0:06:57.33,0:06:59.68,JP,,0000,0000,0000,,Онымен қарама-қарсы жыныстың жүрегін жаулай алмайсың.
Dialogue: 0,0:06:59.98,0:07:02.80,JP,,0000,0000,0000,,Аа, сіз кенеттен пайда болғаныңыз үшін.
Dialogue: 0,0:07:03.03,0:07:04.81,JP,,0000,0000,0000,,Менің ойымша, бұл қажетсіз алаңдаушылық.
Dialogue: 0,0:07:08.37,0:07:11.82,JP,,0000,0000,0000,,Жағаның қып-қызыл түсі сенің асыл жүзіңнен көзге түседі.
Dialogue: 0,0:07:13.23,0:07:14.19,JP,,0000,0000,0000,,Әдемі
Dialogue: 0,0:07:16.41,0:07:18.65,JP,,0000,0000,0000,,Тіпті құдайлардың сонау ежелгі дәуірінде.
Dialogue: 0,0:07:19.24,0:07:21.84,JP,,0000,0000,0000,,Мұндай ерекше кейіпкер ешқашан туған емес.
Dialogue: 0,0:07:23.31,0:07:25.01,JP,,0000,0000,0000,,Мен сені алғаш көргенде де
Dialogue: 0,0:07:25.50,0:07:27.37,JP,,0000,0000,0000,,Сізге қызыл халат жарасады.
Dialogue: 0,0:07:27.53,0:07:28.51,JP,,0000,0000,0000,,Таң қалды
Dialogue: 0,0:07:29.76,0:07:31.18,JP,,0000,0000,0000,,Енді біз жақыннан кездестік
Dialogue: 0,0:07:32.05,0:07:33.37,JP,,0000,0000,0000,,Мен сені сүймеймін
Dialogue: 0,0:07:36.24,0:07:38.57,JP,,0000,0000,0000,,Бұл өте жақсы көрінеді.
Dialogue: 0,0:07:39.18,0:07:40.58,JP,,0000,0000,0000,,Ішінде не бар?
Dialogue: 0,0:07:42.17,0:07:44.86,JP,,0000,0000,0000,,Сырт келбетіңіз ішкі жан дүниеңізге сәйкес келмейтін сіз туралы.
Dialogue: 0,0:07:45.78,0:07:49.52,JP,,0000,0000,0000,,Шапанның іші өте нашар дене болуы керек.
Dialogue: 0,0:07:51.49,0:07:52.62,JP,,0000,0000,0000,,Тек беті бар қыз
Dialogue: 0,0:07:54.33,0:07:55.56,JP,,0000,0000,0000,,Қош бол
Dialogue: 0,0:07:56.80,0:07:58.41,JP,,0000,0000,0000,,Бұл кешті құпия сақтаңыз.
Dialogue: 0,0:07:59.02,0:08:01.64,JP,,0000,0000,0000,,Күте тұрыңыз.
Dialogue: 0,0:08:02.86,0:08:04.92,JP,,0000,0000,0000,,Менде тек ер адам болса да
Dialogue: 0,0:08:05.32,0:08:07.96,JP,,0000,0000,0000,,Мен жай ғана жүзім бар қыз емеспін.
Dialogue: 0,0:08:08.21,0:08:09.90,JP,,0000,0000,0000,,Олай болса, тек сөйлейтін қыз.
Dialogue: 0,0:08:10.33,0:08:12.55,JP,,0000,0000,0000,,Бұл не... жеңілген?
Dialogue: 0,0:08:13.33,0:08:15.14,JP,,0000,0000,0000,,Менің тәнім кедей ме, жоқ па.
Dialogue: 0,0:08:15.49,0:08:17.43,JP,,0000,0000,0000,,Өзіңіз қараңыз
Dialogue: 0,0:08:23.33,0:08:25.56,JP,,0000,0000,0000,,Сіз күтпеген сүйкімді адамсыз.
Dialogue: 0,0:08:26.37,0:08:28.74,JP,,0000,0000,0000,,Бірақ мұны басқа уақытқа қалдырайық.
Dialogue: 0,0:08:30.16,0:08:31.00,JP,,0000,0000,0000,,(Теледидарды өшіру дыбысы)
Dialogue: 0,0:08:53.22,0:08:53.79,JP,,0000,0000,0000,,Жақсы нәрсе
Dialogue: 0,0:08:54.69,0:08:56.83,JP,,0000,0000,0000,,Сіз менімен ойнамайсыз.
Dialogue: 0,0:08:57.71,0:09:00.04,JP,,0000,0000,0000,,Себебі мен сенімен ойнап жатырмын.
Dialogue: 0,0:09:00.54,0:09:01.59,JP,,0000,0000,0000,,Тағы да?
Dialogue: 0,0:09:02.45,0:09:04.42,JP,,0000,0000,0000,,Біз кездескен сайын солай айтасың.
Dialogue: 0,0:09:04.99,0:09:06.78,JP,,0000,0000,0000,,Адамдар мені қате түсінгенін қаламаймын.
Dialogue: 0,0:09:07.50,0:09:08.42,JP,,0000,0000,0000,,Бұл өкінішті.
Dialogue: 0,0:09:09.67,0:09:11.03,JP,,0000,0000,0000,,Мен байыпты болсам да
Dialogue: 0,0:09:13.59,0:09:14.66,JP,,0000,0000,0000,,Шынымен... шындап
Dialogue: 0,0:09:14.81,0:09:16.84,JP,,0000,0000,0000,,А, не, неге, сен?
Dialogue: 0,0:09:16.84,0:09:20.84,JP,,0000,0000,0000,,Әлде сіз ермек үшін осындай нәрсені жасай алатын адамсыз ба?
Dialogue: 0,0:09:21.32,0:09:23.23,JP,,0000,0000,0000,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:09:23.61,0:09:28.60,JP,,0000,0000,0000,,Олай болса ойыңызда жоқ нәрселерді айтып, өзіңізді төмен түсірмеңіз.
Dialogue: 0,0:09:31.70,0:09:32.08,JP,,0000,0000,0000,,Келіңіздер
Dialogue: 0,0:09:37.71,0:09:39.39,JP,,0000,0000,0000,,Бұл жігіттің қарқыны неліктен?
Dialogue: 0,0:09:40.00,0:09:40.29,JP,,0000,0000,0000,,Мұнда
Dialogue: 0,0:09:42.01,0:09:42.59,JP,,0000,0000,0000,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:09:43.14,0:09:44.36,JP,,0000,0000,0000,,Түсіндің бе?
Dialogue: 0,0:09:45.01,0:09:47.08,JP,,0000,0000,0000,,Мен бір күні императордың әйелі боламын.
Dialogue: 0,0:09:47.66,0:09:50.58,JP,,0000,0000,0000,,Егер бұлай болса, мен сенімен тіпті кездесе де алмаймын.
Dialogue: 0,0:09:51.57,0:09:54.44,JP,,0000,0000,0000,,Сіз байсалды екеніңізді айтасыз, бірақ бұл туралы ештеңе істей алмайсыз.
Dialogue: 0,0:09:55.76,0:09:56.59,JP,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:09:59.17,0:10:00.28,JP,,0000,0000,0000,,Фудзивара отбасы үшін
Dialogue: 0,0:10:00.78,0:10:03.90,JP,,0000,0000,0000,,Сіздің қабылдауыңыздың саяси маңызы зор.
Dialogue: 0,0:10:04.27,0:10:07.87,JP,,0000,0000,0000,,Мен оны тоқтата алмаймын.
Dialogue: 0,0:10:09.66,0:10:11.20,JP,,0000,0000,0000,,Сондықтан мен мұны ермек үшін дедім.
Dialogue: 0,0:10:13.25,0:10:15.62,JP,,0000,0000,0000,,Иә, сарайға кіру – менің міндетім.
Dialogue: 0,0:10:16.34,0:10:17.85,JP,,0000,0000,0000,,Мен мұны мақтан тұттым.
Dialogue: 0,0:10:18.48,0:10:19.80,JP,,0000,0000,0000,,Бірақ неге?
Dialogue: 0,0:10:22.19,0:10:23.39,JP,,0000,0000,0000,,Қашып кетеміз бе?
Dialogue: 0,0:10:25.08,0:10:26.04,JP,,0000,0000,0000,,Шығу
Dialogue: 0,0:10:40.69,0:10:41.79,JP,,0000,0000,0000,,Такако
Dialogue: 0,0:10:42.60,0:10:42.95,JP,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:10:43.52,0:10:44.64,JP,,0000,0000,0000,,Неге киіміңді шешпейсің?
Dialogue: 0,0:10:46.27,0:10:48.36,JP,,0000,0000,0000,,Эй, сен не ойлап тұрсың?
Dialogue: 0,0:10:49.27,0:10:50.93,JP,,0000,0000,0000,,Маған бұл жер ұнамайды.
Dialogue: 0,0:10:51.00,0:10:52.26,JP,,0000,0000,0000,,Менің айтқым келгені бұл емес.
Dialogue: 0,0:10:52.67,0:10:53.56,JP,,0000,0000,0000,,Бұл ауыр.
Dialogue: 0,0:10:53.56,0:10:55.36,JP,,0000,0000,0000,,Әйелдерге бұлай ауырлау дөрекі.
Dialogue: 0,0:10:55.36,0:10:56.37,JP,,0000,0000,0000,,Сондықтан киім
Dialogue: 0,0:10:57.64,0:10:59.50,JP,,0000,0000,0000,,Жарайды, мен өзім жүремін.
Dialogue: 0,0:11:01.57,0:11:04.30,JP,,0000,0000,0000,,Иә, ыңғайсыз, бірақ жаман емес.
Dialogue: 0,0:11:04.90,0:11:07.00,JP,,0000,0000,0000,,Учигиді шешу оңайырақ.
Dialogue: 0,0:11:07.41,0:11:08.09,JP,,0000,0000,0000,,Маған ұнамайды
Dialogue: 0,0:11:09.21,0:11:12.38,JP,,0000,0000,0000,,Өйткені қызыл түс көзге түседі, солай ма?
Dialogue: 0,0:11:16.15,0:11:18.01,JP,,0000,0000,0000,,Әдемі Бұл не?
Dialogue: 0,0:11:18.50,0:11:19.42,JP,,0000,0000,0000,,Бұл шөпте шық.
Dialogue: 0,0:11:20.18,0:11:20.57,JP,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:11:20.96,0:11:21.86,JP,,0000,0000,0000,,Күлкі саңырауқұлақ
Dialogue: 0,0:11:22.81,0:11:24.62,JP,,0000,0000,0000,,Оны жеуге болмайды, себебі бұл улы саңырауқұлақ.
Dialogue: 0,0:11:25.47,0:11:26.49,JP,,0000,0000,0000,,Оны жегенде не болады?
Dialogue: 0,0:11:26.99,0:11:29.24,JP,,0000,0000,0000,,Кейбір жағдайларда өміріңізді жоғалтуыңыз мүмкін.
Dialogue: 0,0:11:29.48,0:11:30.78,JP,,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:11:31.53,0:11:33.65,JP,,0000,0000,0000,,Бірақ сіз осында болсаңыз, мен өзімді қауіпсіз сезінемін.
Dialogue: 0,0:11:38.83,0:11:41.36,JP,,0000,0000,0000,,Мен сені сүйемін, Такако-сама.
Dialogue: 0,0:11:42.32,0:11:42.85,JP,,0000,0000,0000,,Мен де
Dialogue: 0,0:11:45.06,0:11:47.15,JP,,0000,0000,0000,,Мотоцунэ-сама сәлем беруге келген сияқты.
Dialogue: 0,0:11:48.53,0:11:49.25,JP,,0000,0000,0000,,Менің ағам
Dialogue: 0,0:11:50.08,0:11:51.60,JP,,0000,0000,0000,,Тез қашу керек.
Dialogue: 0,0:11:55.31,0:11:55.81,JP,,0000,0000,0000,,Нарихира
Dialogue: 0,0:12:00.40,0:12:00.99,JP,,0000,0000,0000,,Қош келдің үйге.
Dialogue: 0,0:12:08.64,0:12:09.56,JP,,0000,0000,0000,,Қалаусыздық
Dialogue: 0,0:12:10.53,0:12:11.45,JP,,0000,0000,0000,,Қалаусыздық
Dialogue: 0,0:12:18.24,0:12:20.86,JP,,0000,0000,0000,,Содан бері неше жыл өтті?
Dialogue: 0,0:12:22.00,0:12:24.52,JP,,0000,0000,0000,,Және сол күннен бергі кездесу
Dialogue: 0,0:12:26.17,0:12:27.84,JP,,0000,0000,0000,,Мен императордың анасымын
Dialogue: 0,0:12:28.91,0:12:32.18,JP,,0000,0000,0000,,Сіз императорға қызмет ететін генерал-лейтенантсыз.
Dialogue: 0,0:12:35.21,0:12:37.30,JP,,0000,0000,0000,,Көз жасыма ерік берген кездер болды.
Dialogue: 0,0:12:38.04,0:12:39.59,JP,,0000,0000,0000,,Барлығы алыс күн туралы
Dialogue: 0,0:12:40.68,0:12:43.41,JP,,0000,0000,0000,,Енді менің жүрегім дірілмейді
Dialogue: 0,0:12:44.63,0:12:46.61,JP,,0000,0000,0000,,Осындай сабырлы сезімдермен
Dialogue: 0,0:12:47.26,0:12:49.61,JP,,0000,0000,0000,,Бұрынғыдай ойнау жаман емес.
Dialogue: 0,0:12:50.91,0:12:55.95,JP,,0000,0000,0000,,Естуімше, генерал-лейтенант болып тағайындалған кейбір ақымақтардың әнге ғана қабілеті бар екен.
Dialogue: 0,0:12:56.64,0:12:57.69,JP,,0000,0000,0000,,Такако-сан
Dialogue: 0,0:12:57.75,0:13:00.67,JP,,0000,0000,0000,,Осы жерде ән айтып бере аласыз ба?
Dialogue: 0,0:13:02.83,0:13:05.86,JP,,0000,0000,0000,,Енді қандай ән шығарасыңдар?
Dialogue: 0,0:13:06.74,0:13:09.06,JP,,0000,0000,0000,,Енді сол жиналмалы экранда өлеңді оқы.
Dialogue: 0,0:13:25.28,0:13:27.72,JP,,0000,0000,0000,,Жиналмалы экранның керемет көрінісі
Dialogue: 0,0:13:28.24,0:13:29.73,JP,,0000,0000,0000,,Нарихира-доно күткендей
Dialogue: 0,0:13:30.29,0:13:32.68,JP,,0000,0000,0000,,Өзен бетіндегі күзгі жапырақтар қандай?
Dialogue: 0,0:13:32.99,0:13:34.75,JP,,0000,0000,0000,,Бұл тамаша.
Dialogue: 0,0:13:35.87,0:13:36.81,JP,,0000,0000,0000,,Таң қызыл
Dialogue: 0,0:13:42.56,0:13:45.38,JP,,0000,0000,0000,,Барлығы мені декорация туралы ән айтып жатырмын деп ойласын
Dialogue: 0,0:13:46.71,0:13:48.72,JP,,0000,0000,0000,,Бұл кісі де жетілді.
Dialogue: 0,0:13:49.33,0:13:51.20,JP,,0000,0000,0000,,Қаракүренай ни ни құры су
Dialogue: 0,0:13:53.06,0:13:53.42,JP,,0000,0000,0000,,Кукуру
Dialogue: 0,0:13:56.00,0:13:57.92,JP,,0000,0000,0000,,Құдай да білмейтін шығар.
Dialogue: 0,0:13:58.64,0:14:04.11,JP,,0000,0000,0000,,Қызыл халаттың ішіндегі ең жақсы әйел болатын.
Dialogue: 0,0:14:05.84,0:14:06.84,JP,,0000,0000,0000,,Бұл жігіт
Dialogue: 0,0:14:09.42,0:14:10.11,JP,,0000,0000,0000,,Екінші бомба!
Dialogue: 0,0:14:12.18,0:14:12.75,JP,,0000,0000,0000,,Иә.
Dialogue: 0,0:14:14.17,0:14:18.97,JP,,0000,0000,0000,,Сол кездегі сезімдерімізді ұмытпайық.
Dialogue: 0,0:14:25.41,0:14:28.65,JP,,0000,0000,0000,,Аривара Нарихира Хэйан дәуірінде ойыншы болған
Dialogue: 0,0:14:29.29,0:14:32.68,JP,,0000,0000,0000,,Ол кезде махаббат ақсүйектер арасында сәнді спорт болатын.
Dialogue: 0,0:14:33.35,0:14:35.18,JP,,0000,0000,0000,,Танта мәдениет болып гүлдейді
Dialogue: 0,0:14:35.91,0:14:40.40,JP,,0000,0000,0000,,Бірақ Нарихираның өзіне қарама-қарсы ағасы бар еді.
Dialogue: 0,0:14:49.96,0:14:50.30,JP,,0000,0000,0000,,Хироко
Dialogue: 0,0:14:51.88,0:14:54.19,JP,,0000,0000,0000,,Бұл не, Юкихира-сама?
Dialogue: 0,0:14:54.83,0:14:55.60,JP,,0000,0000,0000,,Сіз шаршаған болуыңыз керек.
Dialogue: 0,0:14:56.18,0:14:59.30,JP,,0000,0000,0000,,Қалғанын басқаларға қалдырып, біраз демалыңыз.
Dialogue: 0,0:15:00.07,0:15:01.41,JP,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:15:02.11,0:15:07.22,JP,,0000,0000,0000,,Ханымдар мен мырзалар, біз сізді Inaba no kami дәрежесіне көтерілуіңізбен құттықтаймыз.
Dialogue: 0,0:15:08.02,0:15:08.55,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:15:09.38,0:15:11.73,JP,,0000,0000,0000,,Кешіріңіз, мен біраз уақытқа шығамын.
Dialogue: 0,0:15:12.46,0:15:13.83,JP,,0000,0000,0000,,О, қай жолмен?
Dialogue: 0,0:15:15.41,0:15:16.70,JP,,0000,0000,0000,,Нарихираның орнында.
Dialogue: 0,0:15:21.34,0:15:23.29,JP,,0000,0000,0000,,Жыл басынан бері жатқан сияқты.
Dialogue: 0,0:15:24.05,0:15:24.76,JP,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:15:25.38,0:15:27.16,JP,,0000,0000,0000,,Бұл мейірімді мінез.
Dialogue: 0,0:15:28.40,0:15:30.58,JP,,0000,0000,0000,,Сіз уағыз айту үшін келдіңіз.
Dialogue: 0,0:15:30.88,0:15:32.57,JP,,0000,0000,0000,,О, қымбаттым?
Dialogue: 0,0:15:33.10,0:15:37.49,JP,,0000,0000,0000,,Ки Арицунэ сәлем беруге ертерек келді.
Dialogue: 0,0:15:38.20,0:15:40.27,JP,,0000,0000,0000,,Соңғы кезде біз кездескен сайын,
Dialogue: 0,0:15:40.77,0:15:45.45,JP,,0000,0000,0000,,Бір айтарым, қызымды мұндай жүрексіз адамға бермеуім керек еді.
Dialogue: 0,0:15:46.44,0:15:48.14,JP,,0000,0000,0000,,Осындай әңгімелерді естігенде
Dialogue: 0,0:15:48.92,0:15:52.14,JP,,0000,0000,0000,,Мен ер адам ретінде қаншалықты бақыттымын деп ойлаймын.
Dialogue: 0,0:15:52.83,0:15:53.25,JP,,0000,0000,0000,,23-бөлім: «Impact» және «Close-up»
Dialogue: 0,0:15:53.86,0:15:57.48,JP,,0000,0000,0000,,Біздің жарасымды болу себебіміз бір-біріміздің күш-жігерімізде.
Dialogue: 0,0:15:58.70,0:16:00.50,JP,,0000,0000,0000,,Менің інім мен оның әйелі бұған жетпейді.
Dialogue: 0,0:16:01.57,0:16:02.43,JP,,0000,0000,0000,,Бірақ бәрібір
Dialogue: 0,0:16:04.17,0:16:08.20,JP,,0000,0000,0000,,Мен бірге жұмыс істей алатындай қамқорлық жасайтын адамды кездестірдім.
Dialogue: 0,0:16:09.11,0:16:10.19,JP,,0000,0000,0000,,Сізге сәттілік.
Dialogue: 0,0:16:12.42,0:16:15.05,JP,,0000,0000,0000,,Күйеуі алыстағы Инабаға кетсе де
Dialogue: 0,0:16:15.44,0:16:20.29,JP,,0000,0000,0000,,Иә, тез көтерілетін адал күйеуімнің барына қуанамын.
Dialogue: 0,0:16:21.73,0:16:24.48,JP,,0000,0000,0000,,Күйеуіңіздің жалғыз кеткеніне өкінбейсіз бе?
Dialogue: 0,0:16:25.58,0:16:28.41,JP,,0000,0000,0000,,Мен нәрселерді жақсы білетіндіктен, кейде мен алаңдаймын
Dialogue: 0,0:16:29.00,0:16:30.53,JP,,0000,0000,0000,,Мен өзімді мәжбүрлеп отырмын ба деп ойлаймын.
Dialogue: 0,0:16:32.90,0:16:34.87,JP,,0000,0000,0000,,Бірақ қазір бұл Нарихира.
Dialogue: 0,0:16:35.91,0:16:38.94,JP,,0000,0000,0000,,Жылдар бойынша бөлінген туған ағасы
Dialogue: 0,0:16:41.18,0:16:42.92,JP,,0000,0000,0000,,Денсаулық жақсы немесе Юкихира
Dialogue: 0,0:16:43.22,0:16:45.53,JP,,0000,0000,0000,,Иә, әке, бала
Dialogue: 0,0:16:46.17,0:16:48.08,JP,,0000,0000,0000,,Бұл сенің кіші ағаң Нарихира.
Dialogue: 0,0:16:48.51,0:16:50.90,JP,,0000,0000,0000,,Мен сенен ағаммен кездескің келе ме деп сұрамадым.
Dialogue: 0,0:16:51.70,0:16:52.96,JP,,0000,0000,0000,,Сәлем аға
Dialogue: 0,0:16:53.44,0:16:54.11,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:16:54.56,0:16:56.17,JP,,0000,0000,0000,,Бақшада кемари ойнағың келе ме?
Dialogue: 0,0:16:56.60,0:16:59.45,JP,,0000,0000,0000,,Жоқ, мен сенің ағаңның бөлмесін көргім келеді.
Dialogue: 0,0:16:59.73,0:17:00.70,JP,,0000,0000,0000,,бөлмеге
Dialogue: 0,0:17:01.24,0:17:03.44,JP,,0000,0000,0000,,Менің жеке бөлмем жоқ
Dialogue: 0,0:17:04.11,0:17:04.69,JP,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:17:05.05,0:17:07.64,JP,,0000,0000,0000,,Жоқ, бұл соншалықты үлкен үй емес.
Dialogue: 0,0:17:08.44,0:17:09.60,JP,,0000,0000,0000,,Бөлмені отбасымен бөлісу
Dialogue: 0,0:17:10.32,0:17:11.15,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:17:11.89,0:17:14.61,JP,,0000,0000,0000,,Өйткені, ананың әлеуметтік жағдайы төмен болса, қызықсыз.
Dialogue: 0,0:17:14.99,0:17:16.97,JP,,0000,0000,0000,,Менің отбасымда дүниеге келгеніңді қалаймын
Dialogue: 0,0:17:21.01,0:17:24.07,JP,,0000,0000,0000,,Қазір ойлап қарасам, біз кездескен сәттен бастап бұл апат болды.
Dialogue: 0,0:17:24.80,0:17:27.01,JP,,0000,0000,0000,,Бұл сәл кенеттен шығар, бірақ менде сұрақ бар.
Dialogue: 0,0:17:32.42,0:17:32.93,JP,,0000,0000,0000,,Нарихира
Dialogue: 0,0:17:33.73,0:17:36.29,JP,,0000,0000,0000,,Иә, иә, аға, менің көңіл-күйім жақсы.
Dialogue: 0,0:17:36.69,0:17:38.79,JP,,0000,0000,0000,,Мен оның ауырып жатқанын естідім.
Dialogue: 0,0:17:39.31,0:17:40.71,JP,,0000,0000,0000,,Сіз өте сау көрінесіз, солай емес пе?
Dialogue: 0,0:17:41.08,0:17:43.01,JP,,0000,0000,0000,,Жоқ, мен ауырып тұрмын.
Dialogue: 0,0:17:43.85,0:17:45.23,JP,,0000,0000,0000,,Психикалық ауру
Dialogue: 0,0:17:47.90,0:17:50.65,JP,,0000,0000,0000,,Мені мемлекеттік қызметке бұйырмағанына қынжыламын.
Dialogue: 0,0:17:51.10,0:17:52.52,JP,,0000,0000,0000,,Менің ойымда да жоқ нәрсе
Dialogue: 0,0:17:53.09,0:17:55.17,JP,,0000,0000,0000,,Сіз жоғарылатуға мүдделі емессіз, солай ма?
Dialogue: 0,0:17:55.76,0:17:57.56,JP,,0000,0000,0000,,Иә, адамдар сияқты.
Dialogue: 0,0:17:58.20,0:18:03.12,JP,,0000,0000,0000,,Дегенмен, менің жұмыстан гөрі маңыздырақ жұмысым бар.
Dialogue: 0,0:18:03.67,0:18:04.76,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:18:05.61,0:18:06.94,JP,,0000,0000,0000,,Одан да көп, ағайын.
Dialogue: 0,0:18:07.50,0:18:10.85,JP,,0000,0000,0000,,Биылғы рейтингте сізді Inaba no kami дәрежесіне көтергеніңізді естідім.
Dialogue: 0,0:18:11.48,0:18:11.84,JP,,0000,0000,0000,,О
Dialogue: 0,0:18:12.21,0:18:13.78,JP,,0000,0000,0000,,Осымен құттықтаймыз
Dialogue: 0,0:18:14.82,0:18:16.84,JP,,0000,0000,0000,,Әпкем менімен Инабада болады.
Dialogue: 0,0:18:17.31,0:18:19.98,JP,,0000,0000,0000,,Жоқ, менің әпкем Киотодағы үйді қорғайды.
Dialogue: 0,0:18:20.31,0:18:21.70,JP,,0000,0000,0000,,Өкінішті.
Dialogue: 0,0:18:22.36,0:18:26.77,JP,,0000,0000,0000,,Уайымдама, мен міндетті түрде апаңды жұбатамын.
Dialogue: 0,0:18:27.25,0:18:31.42,JP,,0000,0000,0000,,Біреудің әйелін уайымдамай, өз әйеліңе жақсырақ көңіл бөл.
Dialogue: 0,0:18:32.49,0:18:35.73,JP,,0000,0000,0000,,Тыңдаңыздар, кеменің қайтып келетін порты бар.
Dialogue: 0,0:18:35.94,0:18:36.89,JP,,0000,0000,0000,,Мен саяхаттай аламын
Dialogue: 0,0:18:37.32,0:18:38.89,JP,,0000,0000,0000,,Сіз кеме апатына ұшырадыңыз.
Dialogue: 0,0:18:39.50,0:18:41.06,JP,,0000,0000,0000,,Ерлі-зайыптылар ретінде көбірек күш салыңыз...
Dialogue: 0,0:18:41.06,0:18:41.69,JP,,0000,0000,0000,,Аға
Dialogue: 0,0:18:43.31,0:18:45.45,JP,,0000,0000,0000,,Бақыттың пішіні әр адамда әртүрлі
Dialogue: 0,0:18:46.01,0:18:49.38,JP,,0000,0000,0000,,Ағамның бақыты менің бақытым емес.
Dialogue: 0,0:18:49.65,0:18:50.98,JP,,0000,0000,0000,,Керісінше
Dialogue: 0,0:18:52.32,0:18:54.92,JP,,0000,0000,0000,,Өтінемін, өз өмір жолыңызды басқаларға таңбаңыз.
Dialogue: 0,0:18:57.99,0:19:00.28,JP,,0000,0000,0000,,Менің әкем Або ханзада қайтыс болғанда
Dialogue: 0,0:19:00.86,0:19:04.38,JP,,0000,0000,0000,,Мен 25 жаста, ал Нарихира 18 жаста болатын.
Dialogue: 0,0:19:05.87,0:19:08.10,JP,,0000,0000,0000,,Менің әкем император Хейджоның ұлы болып дүниеге келген.
Dialogue: 0,0:19:08.86,0:19:10.58,JP,,0000,0000,0000,,Саясаттың мейіріміне бөленді
Dialogue: 0,0:19:11.13,0:19:13.29,JP,,0000,0000,0000,,Азаптан соң дүниеден өтті
Dialogue: 0,0:19:14.82,0:19:16.15,JP,,0000,0000,0000,,Өйткені ол адал адам болатын
Dialogue: 0,0:19:18.01,0:19:21.39,JP,,0000,0000,0000,,Әкесін осылай көріп, Нарихира ойлаған болар
Dialogue: 0,0:19:22.88,0:19:25.30,JP,,0000,0000,0000,,Адал өмір сүру міндетті түрде нәтиже бермейді.
Dialogue: 0,0:19:26.49,0:19:28.12,JP,,0000,0000,0000,,Онда еркін өмір сүр
Dialogue: 0,0:19:29.66,0:19:32.97,JP,,0000,0000,0000,,Бірақ менің әкем қателескен жоқ деп ойлаймын.
Dialogue: 0,0:19:34.21,0:19:38.61,JP,,0000,0000,0000,,Адалдығыңызды сақтай отырып, айналаңыздағылардың ойыншығы болмай, күшті өмір сүріңіз.
Dialogue: 0,0:19:39.52,0:19:41.27,JP,,0000,0000,0000,,Бұл менің әкеме деген мақтау сөзім.
Dialogue: 0,0:19:44.91,0:19:46.89,JP,,0000,0000,0000,,...Мыр. Юкихира
Dialogue: 0,0:19:48.42,0:19:49.35,JP,,0000,0000,0000,,Юкихира-сама
Dialogue: 0,0:19:51.84,0:19:54.88,JP,,0000,0000,0000,,Кетуге дайындалатын уақыт келді.
Dialogue: 0,0:19:58.51,0:20:01.78,JP,,0000,0000,0000,,Ойланып қарасам, Нарихира саған қонаққа барамын деді.
Dialogue: 0,0:20:02.31,0:20:02.70,JP,,0000,0000,0000,,О.
Dialogue: 0,0:20:03.15,0:20:04.48,JP,,0000,0000,0000,,Менің ойымша, бұл әзіл.
Dialogue: 0,0:20:05.14,0:20:07.96,JP,,0000,0000,0000,,Егер олар келсе, оларға тиісті емдетіп, үйлеріне жіберіңіз.
Dialogue: 0,0:20:08.83,0:20:11.13,JP,,0000,0000,0000,,Қайсысы орынды?
Dialogue: 0,0:20:11.62,0:20:14.13,JP,,0000,0000,0000,,Тиісті... Тиісті.
Dialogue: 0,0:20:15.66,0:20:17.75,JP,,0000,0000,0000,,Бірдеңе болса маған хабарлаңыз.
Dialogue: 0,0:20:18.75,0:20:19.61,JP,,0000,0000,0000,,Дереу асығыңыз
Dialogue: 0,0:20:20.39,0:20:23.77,JP,,0000,0000,0000,,Сізді тұншықтыратын уәде бермеңіз.
Dialogue: 0,0:20:25.34,0:20:26.84,JP,,0000,0000,0000,,Инаба алыста
Dialogue: 0,0:20:27.62,0:20:29.05,JP,,0000,0000,0000,,Жұмыс бірінші орында
Dialogue: 0,0:20:29.48,0:20:31.48,JP,,0000,0000,0000,,Мен үшін алаңдама
Dialogue: 0,0:20:33.38,0:20:33.88,JP,,0000,0000,0000,,Хироко
Dialogue: 0,0:20:34.65,0:20:34.96,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:20:35.54,0:20:36.93,JP,,0000,0000,0000,,Мені қате түсінбеңіз.
Dialogue: 0,0:20:39.17,0:20:43.26,JP,,0000,0000,0000,,Мен өзім үшін ненің маңызды екенін білемін деп ойлаймын.
Dialogue: 0,0:20:44.07,0:20:47.45,JP,,0000,0000,0000,,Инабадан Киотоға өте жақын, мені бағалама.
Dialogue: 0,0:20:49.31,0:20:51.70,JP,,0000,0000,0000,,Олай болса осында қалуыңызды өтінемін.
Dialogue: 0,0:20:52.63,0:20:54.48,JP,,0000,0000,0000,,Егер сіз мені маңызды деп санасаңыз
Dialogue: 0,0:20:55.71,0:20:57.31,JP,,0000,0000,0000,,Қайнауға айналды.
Dialogue: 0,0:20:58.92,0:20:59.63,JP,,0000,0000,0000,,...
Dialogue: 0,0:21:03.30,0:21:04.12,JP,,0000,0000,0000,,Жан-Пьер Польнарефф
Dialogue: 0,0:21:04.62,0:21:05.65,JP,,0000,0000,0000,,Юкихира-сама
Dialogue: 0,0:21:06.42,0:21:09.02,JP,,0000,0000,0000,,Жұмысымнан босатылған соң өзімді жеңіл сезіндім.
Dialogue: 0,0:21:10.40,0:21:13.51,JP,,0000,0000,0000,,Бұдан былай бірге қалай өмір сүру керектігін талқылайық па?
Dialogue: 0,0:21:14.88,0:21:16.19,JP,,0000,0000,0000,,Немесе екі рет ұйықтаңыз
Dialogue: 0,0:21:18.08,0:21:21.29,JP,,0000,0000,0000,,Юкихира-сама, дөрекі болуды доғар.
Dialogue: 0,0:21:23.09,0:21:25.25,JP,,0000,0000,0000,,Келіңіздер, қайсысы дөрекі?
Dialogue: 0,0:21:25.82,0:21:28.20,JP,,0000,0000,0000,,Назар аударғаныңызға рахмет.
Dialogue: 0,0:21:28.93,0:21:30.51,JP,,0000,0000,0000,,Бірақ уайымдамаңыз
Dialogue: 0,0:21:31.57,0:21:37.11,JP,,0000,0000,0000,,Мен сені не болса да қолдайтынымды біле тұра үйлендім.
Dialogue: 0,0:21:38.63,0:21:39.68,JP,,0000,0000,0000,,Сен мықтысың.
Dialogue: 0,0:21:40.80,0:21:46.17,JP,,0000,0000,0000,,Сондықтан мен сені жақсы көремін.
Dialogue: 0,0:21:47.25,0:21:49.30,JP,,0000,0000,0000,,Мен күшті емеспін
Dialogue: 0,0:21:49.97,0:21:53.35,JP,,0000,0000,0000,,Мен сенің арқаңда күшті бола аламын
Dialogue: 0,0:21:54.16,0:21:55.28,JP,,0000,0000,0000,,Мен де солаймын.
Dialogue: 0,0:21:56.51,0:21:58.09,JP,,0000,0000,0000,,Өйткені сен мені күтесің
Dialogue: 0,0:21:59.09,0:22:00.07,JP,,0000,0000,0000,,Мен ештеңеден қорықпаймын
Dialogue: 0,0:22:12.89,0:22:14.06,JP,,0000,0000,0000,,Менің кетуім керек
Dialogue: 0,0:22:14.94,0:22:17.58,JP,,0000,0000,0000,,Бірақ маған қоңырау шалсаңыз, мен міндетті түрде қайтамын
Dialogue: 0,0:22:18.99,0:22:19.47,JP,,0000,0000,0000,,Міндетті түрде.
Dialogue: 0,0:22:22.29,0:22:24.22,JP,,0000,0000,0000,,Әкем саяси өзгерістерді күтпеуі керек.
Dialogue: 0,0:22:24.84,0:22:27.12,JP,,0000,0000,0000,,Мені және Нарихираны вассал дәрежесіне түсірді.
Dialogue: 0,0:22:28.72,0:22:30.36,JP,,0000,0000,0000,,Мен үшін маңызды нәрселер
Dialogue: 0,0:22:31.50,0:22:35.00,JP,,0000,0000,0000,,Мен оны бір күні Нарихирамен кездестіремін деп үміттенемін
Dialogue: 0,0:22:37.75,0:22:42.36,JP,,0000,0000,0000,,Бес жылдан кейін Нарихира Такакомен кездесті.
Dialogue: 0,0:24:16.84,0:24:22.25,JP,,0000,0000,0000,,Цукуба жотасының шахтасынан ағып жатқан Минано өзені
Dialogue: 0,0:24:24.31,0:24:28.36,JP,,0000,0000,0000,,Ғашық боламын деген ниетпен, Қырдың қасында нұру
Dialogue: 0,0:00:02.32,0:00:05.03,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:09.27,0:00:13.04,CN,,0000,0000,0000,,Алғашқы пайда болуы Фудзивара Тейка
Dialogue: 0,0:00:14.59,0:00:17.37,CN,,0000,0000,0000,,Құрметті Качи «Хьякунин Исшу»
Dialogue: 0,0:00:19.13,0:00:20.10,CN,,0000,0000,0000,,Адам басқарылатын гүл ойыны
Dialogue: 0,0:00:19.13,0:00:20.10,,,0000,0000,0000,,Ескерту: Гүлмен ойнау: Хайкудағы хайку көшірмесі, жалғыз адам жазған хайку, хайкудағы хайку, хайкудағы хайку және хайкудағы хайку. Ең көп тақтайшасы бар жеңеді.
Dialogue: 0,0:00:22.18,0:00:25.19,CN,,0000,0000,0000,,Сондай-ақ басқарылатын лотерея ойыны
Dialogue: 0,0:00:22.18,0:00:25.19,,,0000,0000,0000,,Ескерту: Лотерея ойыны: Плиткаларға жазылған хякунин исшу өлеңі. Әр адамның лотереясы бірдей, ал негізгі лотерея - ер спикер, әйел спикер, император және діни қызметкердің әртүрлі шешімдері. Аяқтағаннан кейін ең көп тақтайша жинаған адам жеңеді.
Dialogue: 0,0:00:25.90,0:00:26.33,CN,,0000,0000,0000,,Бұл рөл де біраз қиын екен…
Dialogue: 0,0:00:26.82,0:00:31.39,CN,,0000,0000,0000,,Бұл тривиальды түпнұсқа жапон өлеңі.
Dialogue: 0,0:00:32.44,0:00:35.36,CN,,0000,0000,0000,,Барлық уақыттағы үздік 100 ақынның ішінен таңдалған өлеңдер
Dialogue: 0,0:00:35.98,0:00:37.08,CN,,0000,0000,0000,,Хякушу Хякушю
Dialogue: 0,0:00:38.24,0:00:39.29,CN,,0000,0000,0000,,Менің таңдағаным осы.
Dialogue: 0,0:00:42.09,0:00:43.59,CN,,0000,0000,0000,,Өйткені бүкіл қала менің жеке қалауыма негізделген
Dialogue: 0,0:00:43.79,0:00:45.45,CN,,0000,0000,0000,,Менің көзқарасым әшкере болды
Dialogue: 0,0:00:45.97,0:00:49.04,CN,,0000,0000,0000,,Нәтижесінде романтикалық махаббаттың 43 өлеңі
Dialogue: 0,0:00:49.71,0:00:52.20,CN,,0000,0000,0000,,Мен бақыттымын
Dialogue: 0,0:00:53.74,0:00:54.43,CN,,0000,0000,0000,,Шүкүре махаббат жыры
Dialogue: 0,0:02:55.61,0:02:56.45,CN,,0000,0000,0000,,Мен саған салған жара ақыры әсер етті
Dialogue: 0,0:02:56.88,0:02:58.44,CN,,0000,0000,0000,,Мәртебелі Яхай
Dialogue: 0,0:02:59.54,0:03:01.15,CN,,0000,0000,0000,,Ортаңғы қалыпта билеу
Dialogue: 0,0:03:01.83,0:03:04.24,CN,,0000,0000,0000,,Дүние жүзіндегі ең атақты гүл ханзадаларының біріне күтім жасау
Dialogue: 0,0:03:04.42,0:03:05.91,CN,,0000,0000,0000,,Бидің әдемі екені рас.
Dialogue: 0,0:03:07.59,0:03:08.69,CN,,0000,0000,0000,,Оқиға шындық.
Dialogue: 0,0:03:09.64,0:03:11.10,CN,,0000,0000,0000,,Түпкі мақсат – бидің позициясы.
Dialogue: 0,0:03:11.76,0:03:13.40,CN,,0000,0000,0000,,Медиандық позиция
Dialogue: 0,0:03:14.20,0:03:17.01,CN,,0000,0000,0000,,Бұл Фудзивара Такаконың әпкесі.
Dialogue: 0,0:03:17.79,0:03:21.07,CN,,0000,0000,0000,,Фудзивара Кита отбасының тікелей тегі.
Dialogue: 0,0:03:22.22,0:03:23.15,CN,,0000,0000,0000,,Ұзын және жетілген...
Dialogue: 0,0:03:36.48,0:03:39.03,&,,0000,0000,0000,,Такако Йохеи
Dialogue: 0,0:03:36.48,0:03:39.03,,,0000,0000,0000,,Аривара Нагахира Асон
Dialogue: 0,0:03:39.96,0:03:42.37,CN,,0000,0000,0000,,Кіші әпке Гаози Кіші әпке Гаози
Dialogue: 0,0:03:43.26,0:03:45.19,CN,,0000,0000,0000,,Наи ересектерге арналған жіберу кітабы келді
Dialogue: 0,0:03:45.73,0:03:46.69,CN,,0000,0000,0000,,Қайта жөнелту?
Dialogue: 0,0:03:47.40,0:03:50.55,CN,,0000,0000,0000,,Бес биден кейін шындық көрінбейді, табыт материалы жыламайды.
Dialogue: 0,0:03:51.05,0:03:53.11,CN,,0000,0000,0000,,Сіз де астанадан бөлексіз.
Dialogue: 0,0:03:53.63,0:03:57.46,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:57.94,0:03:59.48,CN,,0000,0000,0000,,Құлды қорлаудан бас тарту
Dialogue: 0,0:04:00.01,0:04:02.54,CN,,0000,0000,0000,,Қазір көкке жіберілген қыздың жазған өлеңі.
Dialogue: 0,0:04:02.81,0:04:03.90,CN,,0000,0000,0000,,Өзін жақсы сезіну
Dialogue: 0,0:04:07.22,0:04:17.15,&,,0000,0000,0000,,Алыстағы жарамсыздық
Dialogue: 0,0:04:09.06,0:04:17.15,&,,0000,0000,0000,,Сіз туралы ойлау
Dialogue: 0,0:04:10.10,0:04:17.15,&,,0000,0000,0000,,...
Dialogue: 0,0:04:11.64,0:04:17.15,&,,0000,0000,0000,,Бал залына кіру
Dialogue: 0,0:04:16.32,0:04:17.96,CN,,0000,0000,0000,,Вакага Нокасаку Сейказэ
Dialogue: 0,0:04:18.32,0:04:20.36,CN,,0000,0000,0000,,Допты тесіп өту үшін қолдануға болады
Dialogue: 0,0:04:20.71,0:04:22.01,CN,,0000,0000,0000,,Сіз келген кезде
Dialogue: 0,0:04:24.33,0:04:28.23,CN,,0000,0000,0000,,Менің әңгімем – мен өзім ішімдік ішетін адаммын.
Dialogue: 0,0:04:29.15,0:04:32.97,CN,,0000,0000,0000,,Өйткені ол дәл қазір саладағы ең әдемі ерлердің бірі.
Dialogue: 0,0:04:33.14,0:04:38.39,CN,,0000,0000,0000,,Құлдың табиғи, қабілетті және жарамды қызыл қызында өмір сүру - бұл жай ғана арман.
Dialogue: 0,0:04:38.69,0:04:41.23,CN,,0000,0000,0000,,Құл әлі болған жоқ, ал қызметші әлі болды...
Dialogue: 0,0:04:41.23,0:04:43.19,CN,,0000,0000,0000,,Сәттілік, жеңіл жеткізу және т.б.
Dialogue: 0,0:04:44.68,0:04:54.56,&,,0000,0000,0000,,Ашық жел мен көлеңке жоқ
Dialogue: 0,0:04:46.55,0:04:54.56,&,,0000,0000,0000,,Шатырлар жоқ
Dialogue: 0,0:04:47.51,0:04:54.56,&,,0000,0000,0000,,Сен жеңілмейтінсің
Dialogue: 0,0:04:48.93,0:04:54.56,&,,0000,0000,0000,,Допқа не үшін кірдің?
Dialogue: 0,0:04:52.78,0:04:54.63,CN,,0000,0000,0000,,Ашық жел болуы мүмкін.
Dialogue: 0,0:04:55.10,0:04:57.52,CN,,0000,0000,0000,,Саңылаудан кім өтуге рұқсат етіледі?
Dialogue: 0,0:04:57.77,0:04:58.69,CN,,0000,0000,0000,,Өлгеннен кейінгі өлім
Dialogue: 0,0:04:59.10,0:05:01.51,CN,,0000,0000,0000,,Суық жүрек уақа әні
Dialogue: 0,0:05:02.21,0:05:05.10,CN,,0000,0000,0000,,Айтылымда қолданылған сөз тіркесі жылы және икемді болуы мүмкін...
Dialogue: 0,0:05:05.10,0:05:07.95,CN,,0000,0000,0000,,Сен және мен
Dialogue: 0,0:05:10.10,0:05:13.96,CN,,0000,0000,0000,,Бұрынғы атақ-даңқы алыста, бірақ ол да тартымды асылдың баласы.
Dialogue: 0,0:05:14.77,0:05:17.48,CN,,0000,0000,0000,,Дегенмен, түсініктеме ойыншылар арасындағы гүл аяқталды.
Dialogue: 0,0:05:18.97,0:05:20.88,CN,,0000,0000,0000,,Бұл тек уақыт мәселесі
Dialogue: 0,0:05:21.24,0:05:22.94,CN,,0000,0000,0000,,Басқа адамдар менен жоғары емес.
Dialogue: 0,0:05:24.59,0:05:29.78,CN,,0000,0000,0000,,Мен Фудзивара Кита отбасының ұзақ мерзімді әйел мүшесімін.
Dialogue: 0,0:05:30.48,0:05:36.71,CN,,0000,0000,0000,,Жаңа жылды қарсы алу рәсімі кезінде бұл Таяу Шығыс патшайымының қайтыс болған күні болды.
Dialogue: 0,0:05:30.48,0:05:36.71,,,0000,0000,0000,,Ескертпе: Генпуку ежелгі Жапонияда ерлердің кәмелетке толу рәсімі болды. Түрі өзгерді, ересектерге арналған киім, тәж, өзгертілген балалық есім.
Dialogue: 0,0:05:40.75,0:05:42.97,CN,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз...
Dialogue: 0,0:05:45.24,0:05:46.07,CN,,0000,0000,0000,,Қайырлы кеш
Dialogue: 0,0:05:51.22,0:05:51.89,CN,,0000,0000,0000,,Демалыс орны
Dialogue: 0,0:05:52.74,0:05:53.31,CN,,0000,0000,0000,,Брошьтан гөрі, ол жігіт алдымен қозғалмалы орындыққа шабуыл жасайды
Dialogue: 0,0:05:54.28,0:05:54.90,CN,,0000,0000,0000,,Мен таза желмін
Dialogue: 0,0:05:55.90,0:05:56.37,CN,,0000,0000,0000,,Ашық жел?
Dialogue: 0,0:05:57.72,0:05:59.68,CN,,0000,0000,0000,,Өзін-өзі тану туралы әңгіме жүргізу
Dialogue: 0,0:06:00.67,0:06:03.58,CN,,0000,0000,0000,,Ойға таза желді жібергім келді, ақымақ бала
Dialogue: 0,0:06:04.79,0:06:07.55,CN,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:06:10.58,0:06:11.69,CN,,0000,0000,0000,,Ересек адам ретінде жұмыс істейсіз бе?
Dialogue: 0,0:06:11.90,0:06:12.22,CN,,0000,0000,0000,,Дұрыс және бұрыс
Dialogue: 0,0:06:13.03,0:06:13.81,CN,,0000,0000,0000,,Қайдасың?
Dialogue: 0,0:06:14.51,0:06:16.60,CN,,0000,0000,0000,,Мен жай ғана алдыңғы қабылдауға шақырамын.
Dialogue: 0,0:06:17.01,0:06:18.55,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:19.05,0:06:20.47,CN,,0000,0000,0000,,Сіз не айтып тұрсыз?
Dialogue: 0,0:06:20.91,0:06:24.34,CN,,0000,0000,0000,,Қуанбаған жердің оқиғасы.
Dialogue: 0,0:06:24.61,0:06:25.37,CN,,0000,0000,0000,,Тағы бір ойын
Dialogue: 0,0:06:26.50,0:06:28.56,CN,,0000,0000,0000,,Бұл кішкентай қыз кім?
Dialogue: 0,0:06:30.40,0:06:31.90,CN,,0000,0000,0000,,Қауымдастық
Dialogue: 0,0:06:32.88,0:06:37.71,CN,,0000,0000,0000,,Нанму Амида Будда…
Dialogue: 0,0:06:42.15,0:06:45.18,CN,,0000,0000,0000,,Мен бұл дүрбелеңді пайдаланғым келмейді.
Dialogue: 0,0:06:46.00,0:06:47.47,CN,,0000,0000,0000,,Ол өте суық.
Dialogue: 0,0:06:47.85,0:06:49.97,CN,,0000,0000,0000,,Мен кішігірім қылмыс жасадым.
Dialogue: 0,0:06:52.38,0:06:54.80,CN,,0000,0000,0000,,Бөлек дауыстың дыбысы рас па, жоқ па.
Dialogue: 0,0:06:57.33,0:06:59.68,CN,,0000,0000,0000,,Өмір сүруге рұқсат етілмеген адамның жүрегі.
Dialogue: 0,0:06:59.98,0:07:02.80,CN,,0000,0000,0000,,Кенеттен Нацу пайда болғанда мен секіремін.
Dialogue: 0,0:07:03.03,0:07:04.81,CN,,0000,0000,0000,,Бұл менің кінәм емес.
Dialogue: 0,0:07:08.37,0:07:11.82,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:13.23,0:07:14.19,CN,,0000,0000,0000,,Мына сұлуды ұнатыңыз
Dialogue: 0,0:07:16.41,0:07:18.65,CN,,0000,0000,0000,,Шығарма сонау ерте заманда болған.
Dialogue: 0,0:07:19.24,0:07:21.84,CN,,0000,0000,0000,,Жалпы эстетиканың да түрлі бояулары бар.
Dialogue: 0,0:07:23.31,0:07:25.01,CN,,0000,0000,0000,,Бірінші кездесу уақыты
Dialogue: 0,0:07:25.50,0:07:27.37,CN,,0000,0000,0000,,Терең қызыл би және йое
Dialogue: 0,0:07:27.53,0:07:28.51,CN,,0000,0000,0000,,Маған заңды жылжытуға рұқсат жоқ.
Dialogue: 0,0:07:29.76,0:07:31.18,CN,,0000,0000,0000,,Дүниенің ақырын қалай көруге болады
Dialogue: 0,0:07:32.05,0:07:33.37,CN,,0000,0000,0000,,Мен сені сүйе алмаймын
Dialogue: 0,0:07:36.24,0:07:38.57,CN,,0000,0000,0000,,Бұл жай ғана.
Dialogue: 0,0:07:39.18,0:07:40.58,CN,,0000,0000,0000,,Ішкі жұмыс орындалмайды.
Dialogue: 0,0:07:42.17,0:07:44.86,CN,,0000,0000,0000,,Менің ниетім анық емес.
Dialogue: 0,0:07:45.78,0:07:49.52,CN,,0000,0000,0000,,Ұзын денелі әдемі қабат киім.
Dialogue: 0,0:07:51.49,0:07:52.62,CN,,0000,0000,0000,,Ваза кішкентай ханым сізге ұнайды
Dialogue: 0,0:07:54.33,0:07:55.56,CN,,0000,0000,0000,,Ваза қызды қайта қарау
Dialogue: 0,0:07:56.80,0:07:58.41,CN,,0000,0000,0000,,Бүгін түнгі кезекшіліктегі менің құпиям
Dialogue: 0,0:07:59.02,0:08:01.64,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:02.86,0:08:04.92,CN,,0000,0000,0000,,Сіз ваза адамсыз.
Dialogue: 0,0:08:05.32,0:08:07.96,CN,,0000,0000,0000,,Мен ваза әйелмін
Dialogue: 0,0:08:08.21,0:08:09.90,CN,,0000,0000,0000,,Бұл ең жақсысы ма?
Dialogue: 0,0:08:10.33,0:08:12.55,CN,,0000,0000,0000,,Не істегіңіз келеді
Dialogue: 0,0:08:13.33,0:08:15.14,CN,,0000,0000,0000,,Менің денемнің түпкі мақсаты қандай?
Dialogue: 0,0:08:15.49,0:08:17.43,CN,,0000,0000,0000,,бинокулярлық өзін-өзі растауды қолдану
Dialogue: 0,0:08:23.33,0:08:25.56,CN,,0000,0000,0000,,Махаббат туралы ой толғау
Dialogue: 0,0:08:26.37,0:08:28.74,CN,,0000,0000,0000,,Дегенмен келесі кездесуді күтіңіз.
Dialogue: 0,0:08:30.16,0:08:31.00,CN,,0000,0000,0000,,Гатокайдың жауап сапары
Dialogue: 0,0:08:53.22,0:08:53.79,CN,,0000,0000,0000,,Не деген сұмдық…
Dialogue: 0,0:08:54.69,0:08:56.83,CN,,0000,0000,0000,,Менімен ойнама.
Dialogue: 0,0:08:57.71,0:09:00.04,CN,,0000,0000,0000,,Менің ойнайтыным осы.
Dialogue: 0,0:09:00.54,0:09:01.59,CN,,0000,0000,0000,,Әрі қарай талқылау
Dialogue: 0,0:09:02.45,0:09:04.42,CN,,0000,0000,0000,,Әр келесі кездесуде астанаға барасыз
Dialogue: 0,0:09:04.99,0:09:06.78,CN,,0000,0000,0000,,Мен сенің түсінгеніңді қаламаймын
Dialogue: 0,0:09:07.50,0:09:08.42,CN,,0000,0000,0000,,Шиншоудзиннің жүрегін ауыртады
Dialogue: 0,0:09:09.67,0:09:11.03,CN,,0000,0000,0000,,Оның рас екенін растай аламын.
Dialogue: 0,0:09:13.59,0:09:14.66,CN,,0000,0000,0000,,…
Dialogue: 0,0:09:14.81,0:09:16.84,CN,,0000,0000,0000,,………
Dialogue: 0,0:09:16.84,0:09:20.84,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:21.32,0:09:23.23,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:23.61,0:09:28.60,CN,,0000,0000,0000,,Осыған байланысты қажетсіз сөздер тривиальды және маңызды емес.
Dialogue: 0,0:09:31.70,0:09:32.08,CN,,0000,0000,0000,,Кейін келеді
Dialogue: 0,0:09:37.71,0:09:39.39,CN,,0000,0000,0000,,Мен басқа киімдерді жүгіртуден шаршадым.
Dialogue: 0,0:09:40.00,0:09:40.29,CN,,0000,0000,0000,,Әрине, мен ашуланамын — мен сонша…
Dialogue: 0,0:09:42.01,0:09:42.59,CN,,0000,0000,0000,,Ауырсыну...
Dialogue: 0,0:09:43.14,0:09:44.36,CN,,0000,0000,0000,,Сіз жолды білмейсіз
Dialogue: 0,0:09:45.01,0:09:47.08,CN,,0000,0000,0000,,Аспан қоғамының кәнизаты
Dialogue: 0,0:09:47.66,0:09:50.58,CN,,0000,0000,0000,,Мен Нагатаға келгеннен бері бірде-бір рет адвокатты көрген емеспін.
Dialogue: 0,0:09:51.57,0:09:54.44,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:55.76,0:09:56.59,CN,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:09:59.17,0:10:00.28,CN,,0000,0000,0000,,Фудзивара руының шығу тегі
Dialogue: 0,0:10:00.78,0:10:03.90,CN,,0000,0000,0000,,Сізге сарайға кіріп, император үкіметін басқару маңызды.
Dialogue: 0,0:10:04.27,0:10:07.87,CN,,0000,0000,0000,,Бірақ мен қауқарсызмын.
Dialogue: 0,0:10:09.66,0:10:11.20,CN,,0000,0000,0000,,Мен талантты болғандықтан, мен жай ғана ойнаймын.
Dialogue: 0,0:10:13.25,0:10:15.62,CN,,0000,0000,0000,,Сарайға кіру менің тағдырым.
Dialogue: 0,0:10:16.34,0:10:17.85,CN,,0000,0000,0000,,Дегенмен, бұл да түзу сызық.
Dialogue: 0,0:10:18.48,0:10:19.80,CN,,0000,0000,0000,,Дегенмен, мен қазір осындамын...
Dialogue: 0,0:10:22.19,0:10:23.39,CN,,0000,0000,0000,,Мен не істеймін?
Dialogue: 0,0:10:25.08,0:10:26.04,CN,,0000,0000,0000,,Жеке мінез-құлық
Dialogue: 0,0:10:40.69,0:10:41.79,CN,,0000,0000,0000,,Така Такако
Dialogue: 0,0:10:42.60,0:10:42.95,CN,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:10:43.52,0:10:44.64,CN,,0000,0000,0000,,Киіміңді шеш
Dialogue: 0,0:10:46.27,0:10:48.36,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:49.27,0:10:50.93,CN,,0000,0000,0000,,Мен қайда екенімді елестете алмаймын
Dialogue: 0,0:10:51.00,0:10:52.26,CN,,0000,0000,0000,,Менің ниетім өзімдікі емес.
Dialogue: 0,0:10:52.67,0:10:53.56,CN,,0000,0000,0000,,Тайжурёкюя
Dialogue: 0,0:10:53.00,0:10:56.60,,,0000,0000,0000,,Такаконың киімі шамамен 10 кг
Dialogue: 0,0:10:53.56,0:10:55.36,CN,,0000,0000,0000,,Марқұм қайтыс болғаннан кейін
Dialogue: 0,0:10:55.36,0:10:56.37,CN,,0000,0000,0000,,Мен киім туралы айтып отырмын.
Dialogue: 0,0:10:57.64,0:10:59.50,CN,,0000,0000,0000,,Менің өзім жүгіргенім сияқты
Dialogue: 0,0:11:01.57,0:11:04.30,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:04.90,0:11:07.00,CN,,0000,0000,0000,,Киіміңді шешсең, киіміңді ауыстыр.
Dialogue: 0,0:11:07.41,0:11:08.09,CN,,0000,0000,0000,,Ешқандай талант қажет емес
Dialogue: 0,0:11:09.21,0:11:12.38,CN,,0000,0000,0000,,Қызыл түсті болғандықтан, бұл мен үшін синоним.
Dialogue: 0,0:11:16.15,0:11:18.01,CN,,0000,0000,0000,,Жақсы жылжымалы жарық
Dialogue: 0,0:11:18.50,0:11:19.42,CN,,0000,0000,0000,,Шөптен жасалған шық моншақтар
Dialogue: 0,0:11:20.18,0:11:20.57,CN,,0000,0000,0000,,Бұл адам
Dialogue: 0,0:11:20.96,0:11:21.86,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:20.96,0:11:21.86,,,0000,0000,0000,,Ескертпе: Жапонша атауы: Даишоджо, ғылыми атауы: Дайхохана
Dialogue: 0,0:11:22.81,0:11:24.62,CN,,0000,0000,0000,,Улы болғандықтан оны пайдалану мүмкін емес.
Dialogue: 0,0:11:25.47,0:11:26.49,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:26.99,0:11:29.24,CN,,0000,0000,0000,,Белгілі бір уақытта сабаққа қатысу
Dialogue: 0,0:11:29.48,0:11:30.78,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:31.53,0:11:33.65,CN,,0000,0000,0000,,Дегенмен, сіз осындасыз, мен толығымен боспын.
Dialogue: 0,0:11:38.83,0:11:41.36,CN,,0000,0000,0000,,Мен сені жақсы көремін, Гаоци Сяоцзи
Dialogue: 0,0:11:42.32,0:11:42.85,CN,,0000,0000,0000,,Мен де
Dialogue: 0,0:11:45.06,0:11:47.15,CN,,0000,0000,0000,,Ересектердің негізгі жақсы бейнесі келді.
Dialogue: 0,0:11:48.53,0:11:49.25,CN,,0000,0000,0000,,Гор…
Dialogue: 0,0:11:50.08,0:11:51.60,CN,,0000,0000,0000,,Ләззат қашады Ләззат
Dialogue: 0,0:11:55.31,0:11:55.81,CN,,0000,0000,0000,,?
Dialogue: 0,0:12:00.40,0:12:00.99,CN,,0000,0000,0000,,Қайтару
Dialogue: 0,0:12:08.64,0:12:09.56,CN,,0000,0000,0000,,Атсуо
Dialogue: 0,0:12:10.53,0:12:11.45,CN,,0000,0000,0000,,Атсуо
Dialogue: 0,0:12:18.24,0:12:20.86,CN,,0000,0000,0000,,Юна императрица
Dialogue: 0,0:12:22.00,0:12:24.52,CN,,0000,0000,0000,,Көп жылдар бойы бас қосқаннан кейін
Dialogue: 0,0:12:26.17,0:12:27.84,CN,,0000,0000,0000,,Император Гамимидің анасы
Dialogue: 0,0:12:28.91,0:12:32.18,CN,,0000,0000,0000,,Масаюки Ичу дәрежесі
Dialogue: 0,0:12:35.21,0:12:37.30,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:38.04,0:12:39.59,CN,,0000,0000,0000,,Дегенмен өткеннің өткені
Dialogue: 0,0:12:40.68,0:12:43.41,CN,,0000,0000,0000,,Қазіргі уақытта менің ішкі сезімдерім қалай тез келеді.
Dialogue: 0,0:12:44.63,0:12:46.61,CN,,0000,0000,0000,,Қазіргі уақытта жастардың көңіл-күйі тыныш
Dialogue: 0,0:12:47.26,0:12:49.61,CN,,0000,0000,0000,,Суреттерді жоюға немесе жоюға болмайды.
Dialogue: 0,0:12:50.91,0:12:55.95,CN,,0000,0000,0000,,Генерал-лейтенант - өлеңді алатын жалғыз ақымақ.
Dialogue: 0,0:12:56.64,0:12:57.69,CN,,0000,0000,0000,,Такако ханым
Dialogue: 0,0:12:57.75,0:13:00.67,CN,,0000,0000,0000,,Осы кітапты оқи алады.
Dialogue: 0,0:13:02.83,0:13:05.86,CN,,0000,0000,0000,,Нана жиналысы – өлеңнің басы.
Dialogue: 0,0:13:06.74,0:13:09.06,CN,,0000,0000,0000,,Министрдің скриншотында көрсетілгендей
Dialogue: 0,0:13:17.06,0:13:24.30,&,,0000,0000,0000,,Қызыл жапырақты күзгі жел
Dialogue: 0,0:13:18.65,0:13:24.30,&,,0000,0000,0000,,Лонгтиан өзені Су Өзен қызыл
Dialogue: 0,0:13:19.77,0:13:24.30,&,,0000,0000,0000,,Бұл жағдай осы көзқарас
Dialogue: 0,0:13:21.32,0:13:24.30,&,,0000,0000,0000,,Жоғарғы ежелгі дәуір
Dialogue: 0,0:13:25.28,0:13:27.72,CN,,0000,0000,0000,,Панорамалық экранның арманға ұқсас көрінісі
Dialogue: 0,0:13:28.24,0:13:29.73,CN,,0000,0000,0000,,Ересек жұмыс істеуден қорықпайды
Dialogue: 0,0:13:30.29,0:13:32.68,CN,,0000,0000,0000,,Шосуймен қызыл жапырақ қатынасы қою қызыл темір
Dialogue: 0,0:13:32.99,0:13:34.75,CN,,0000,0000,0000,,Шинзекуби Коука
Dialogue: 0,0:13:35.87,0:13:36.81,CN,,0000,0000,0000,,Қою қызыл болат
Dialogue: 0,0:13:42.56,0:13:45.38,CN,,0000,0000,0000,,Шеберлерден басқа елдің әдемі көріністері бар.
Dialogue: 0,0:13:46.71,0:13:48.72,CN,,0000,0000,0000,,Бұл кісі де кәмелетке толған.
Dialogue: 0,0:13:49.33,0:13:51.20,CN,,0000,0000,0000,,Қызыл жапырақтарды қызыл бояу
Dialogue: 0,0:13:53.06,0:13:53.42,CN,,0000,0000,0000,,Қызыл бояу
Dialogue: 0,0:13:56.00,0:13:57.92,CN,,0000,0000,0000,,Есеп - Тенжинья Шираничидо
Dialogue: 0,0:13:58.64,0:14:04.11,CN,,0000,0000,0000,,Қызыл киімге оранған әлемдегі ең сұлу әйел.
Dialogue: 0,0:14:05.84,0:14:06.84,CN,,0000,0000,0000,,Қайшының тамағыма сұғылып жатқан бейнесі
Dialogue: 0,0:14:09.42,0:14:10.11,CN,,0000,0000,0000,,Ана, ата-ана, ересек
Dialogue: 0,0:14:12.18,0:14:12.75,CN,,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:14:14.17,0:14:18.97,CN,,0000,0000,0000,,Мен оған махаббат хикаясын жаздым, біз махаббат хикаяларын алмасамыз.
Dialogue: 0,0:14:25.41,0:14:28.65,CN,,0000,0000,0000,,Хейан кезеңіндегі ең танымал гүл ханзадасы Аривара Джахеи
Dialogue: 0,0:14:29.29,0:14:32.68,CN,,0000,0000,0000,,Сол уақытта сіздің отбасыңыздың арасындағы махаббат, махаббат, жарық және жеңіл ойын.
Dialogue: 0,0:14:33.35,0:14:35.18,CN,,0000,0000,0000,,Ақырында жемісті болған әртүрлі мәдени көріністер
Dialogue: 0,0:14:35.91,0:14:40.40,CN,,0000,0000,0000,,Өнеркәсіптің стилі басқа ағайынмен бірдей кісіліктен ерекшеленеді.
Dialogue: 0,0:14:49.96,0:14:50.30,CN,,0000,0000,0000,,Хироко
Dialogue: 0,0:14:51.88,0:14:54.19,CN,,0000,0000,0000,,Ондық Юкихира Ересек
Dialogue: 0,0:14:54.83,0:14:55.60,CN,,0000,0000,0000,,Аяқтағаннан кейін
Dialogue: 0,0:14:56.18,0:14:59.30,CN,,0000,0000,0000,,Басқалармен қарым-қатынас жасау Сізге демалу керек
Dialogue: 0,0:15:00.07,0:15:01.41,CN,,0000,0000,0000,,Нака жаман мінез-құлық
Dialogue: 0,0:15:02.11,0:15:07.22,CN,,0000,0000,0000,,Үй иесі астанада бар
Dialogue: 0,0:15:08.02,0:15:08.55,CN,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:15:09.38,0:15:11.73,CN,,0000,0000,0000,,Қолайсыз ниет Мен кеткім келеді
Dialogue: 0,0:15:12.46,0:15:13.83,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:15.41,0:15:16.70,CN,,0000,0000,0000,,Хиранари Хиранари
Dialogue: 0,0:15:17.10,0:15:20.10,&,,0000,0000,0000,,Хироко Юкихэйва
Dialogue: 0,0:15:17.10,0:15:20.10,,,0000,0000,0000,,Юкихира Чукюгон
Dialogue: 0,0:15:21.34,0:15:23.29,CN,,0000,0000,0000,,Мен жыл басынан бері ауырдым.
Dialogue: 0,0:15:24.05,0:15:24.76,CN,,0000,0000,0000,,Мен ауруды іздеймін
Dialogue: 0,0:15:25.38,0:15:27.16,CN,,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:15:28.40,0:15:30.58,CN,,0000,0000,0000,,Мен ілімді тастап кетуден қорқамын.
Dialogue: 0,0:15:30.88,0:15:32.57,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:33.10,0:15:37.49,CN,,0000,0000,0000,,Мұнда келушілер санының үнемі көп болуына байланысты
Dialogue: 0,0:15:33.10,0:15:37.49,,,0000,0000,0000,,：：
Dialogue: 0,0:15:38.20,0:15:40.27,CN,,0000,0000,0000,,Жақында мен бір-бірімізді көрдім
Dialogue: 0,0:15:40.77,0:15:45.45,CN,,0000,0000,0000,,Қалада кек сақтамайтын, әйелі жүрексіз еркек.
Dialogue: 0,0:15:46.44,0:15:48.14,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:48.92,0:15:52.14,CN,,0000,0000,0000,,Мен өзімді жақсы адаммын деп есептеймін.
Dialogue: 0,0:15:52.83,0:15:53.25,CN,,0000,0000,0000,,Fortune?
Dialogue: 0,0:15:53.86,0:15:57.48,CN,,0000,0000,0000,,Біздің бірлестігіміз де осындай әдемі.
Dialogue: 0,0:15:58.70,0:16:00.50,CN,,0000,0000,0000,,Еңбек – ауыр жұмыс.
Dialogue: 0,0:16:01.57,0:16:02.43,CN,,0000,0000,0000,,Қателік
Dialogue: 0,0:16:04.17,0:16:08.20,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:09.11,0:16:10.19,CN,,0000,0000,0000,,Мен сізге қызмет етуге қуаныштымын.
Dialogue: 0,0:16:12.42,0:16:15.05,CN,,0000,0000,0000,,Келесі постқа өтуім дұрыс па?
Dialogue: 0,0:16:15.44,0:16:20.29,CN,,0000,0000,0000,,Әрине, мен қазіргі өмірімде немен айналысқым келеді?
Dialogue: 0,0:16:21.73,0:16:24.48,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:25.58,0:16:28.41,CN,,0000,0000,0000,,Мен шындықты естігенде мазасызданамын.
Dialogue: 0,0:16:29.00,0:16:30.53,CN,,0000,0000,0000,,Бұл рас па, жоқ па?
Dialogue: 0,0:16:32.90,0:16:34.87,CN,,0000,0000,0000,,Өнеркәсіпке бұрын-соңды болмаған екпін
Dialogue: 0,0:16:35.91,0:16:38.94,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:41.18,0:16:42.92,CN,,0000,0000,0000,,Физикалық тұрақты Юкихира
Dialogue: 0,0:16:43.22,0:16:45.53,CN,,0000,0000,0000,,Әке, әке, ересек және бала балалар.
Dialogue: 0,0:16:46.17,0:16:48.08,CN,,0000,0000,0000,,Сіз інісіз
Dialogue: 0,0:16:48.51,0:16:50.90,CN,,0000,0000,0000,,Басқа тікелей идеяларды қараңыз
Dialogue: 0,0:16:51.70,0:16:52.96,CN,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:16:53.44,0:16:54.11,CN,,0000,0000,0000,,Сәлем
Dialogue: 0,0:16:54.56,0:16:56.17,CN,,0000,0000,0000,,Бала күтімі үшін ауруханаға жатқызуды талап ету
Dialogue: 0,0:16:56.60,0:16:59.45,CN,,0000,0000,0000,,Менің ойым емес
Dialogue: 0,0:16:59.73,0:17:00.70,CN,,0000,0000,0000,,Топтама
Dialogue: 0,0:17:01.24,0:17:03.44,CN,,0000,0000,0000,,Өзін-өзі сіңіретін бөлме
Dialogue: 0,0:17:04.11,0:17:04.69,CN,,0000,0000,0000,,Жылдамдық
Dialogue: 0,0:17:05.05,0:17:07.64,CN,,0000,0000,0000,,Отбасы үйінің қайтыс болуы
Dialogue: 0,0:17:08.44,0:17:09.60,CN,,0000,0000,0000,,Жапон тұрғындары ортақ бір бөлме
Dialogue: 0,0:17:10.32,0:17:11.15,CN,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:17:11.89,0:17:14.61,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:14.99,0:17:16.97,CN,,0000,0000,0000,,Үйде отырып, жұмыс табу керек.
Dialogue: 0,0:17:21.01,0:17:24.07,CN,,0000,0000,0000,,Бұл бір ой, бірінші қарау басталады.
Dialogue: 0,0:17:24.80,0:17:27.01,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:32.42,0:17:32.93,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:33.73,0:17:36.29,CN,,0000,0000,0000,,Міне.
Dialogue: 0,0:17:36.69,0:17:38.79,CN,,0000,0000,0000,,Сіз төсекте ауырып жатырсыз
Dialogue: 0,0:17:39.31,0:17:40.71,CN,,0000,0000,0000,,Бұл жақсы идея емес.
Dialogue: 0,0:17:41.08,0:17:43.01,CN,,0000,0000,0000,,Мен ауырып қалғаныма сенімді емеспін.
Dialogue: 0,0:17:43.85,0:17:45.23,CN,,0000,0000,0000,,Жүрек ауруы
Dialogue: 0,0:17:47.90,0:17:50.65,CN,,0000,0000,0000,,Мемлекеттік қызметкерлерден бос болғаным өкінішті.
Dialogue: 0,0:17:51.10,0:17:52.52,CN,,0000,0000,0000,,Жалған жүректің сөздері
Dialogue: 0,0:17:53.09,0:17:55.17,CN,,0000,0000,0000,,Егер сіз оны төлегіңіз келмесе, төлеңіз.
Dialogue: 0,0:17:55.76,0:17:57.56,CN,,0000,0000,0000,,Әрине, маған ұнайды.
Dialogue: 0,0:17:58.20,0:18:03.12,CN,,0000,0000,0000,,Бұл тек маңызды жағдайларға қатысты.
Dialogue: 0,0:18:03.67,0:18:04.76,CN,,0000,0000,0000,,Бастықтың қылмыстық жазбасы болса да, оны өшіртіп тастаған болар, иә?
Dialogue: 0,0:18:05.61,0:18:06.94,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:07.50,0:18:10.85,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:07.50,0:18:10.85,,,0000,0000,0000,,Ескертпе: Алып тастау: Ресми тағайындау рәсімі, Жаңа жылдық негізгі тағайындау Кокушива ауданының шенеунігі
Dialogue: 0,0:18:11.48,0:18:11.84,CN,,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:18:12.21,0:18:13.78,CN,,0000,0000,0000,,Кьюкирё
Dialogue: 0,0:18:14.82,0:18:16.84,CN,,0000,0000,0000,,Қызы немесе қызы кетіп бара жатқанда
Dialogue: 0,0:18:17.31,0:18:19.98,CN,,0000,0000,0000,,Аяқталмаған Мен Киотода тұрамын
Dialogue: 0,0:18:20.31,0:18:21.70,CN,,0000,0000,0000,,Накама - Карей
Dialogue: 0,0:18:22.36,0:18:26.77,CN,,0000,0000,0000,,Менің бірлестігімнің күш-жігері жақсы қыздың арманы сияқты «төмендеді».
Dialogue: 0,0:18:27.25,0:18:31.42,CN,,0000,0000,0000,,Жігерлі, мінезі бөлек әйел мен бала.
Dialogue: 0,0:18:32.49,0:18:35.73,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:35.94,0:18:36.89,CN,,0000,0000,0000,,Кеменің ары қарай жүру мүмкіндігі
Dialogue: 0,0:18:37.32,0:18:38.89,CN,,0000,0000,0000,,Сіз тапсырманы толығымен орындадыңыз.
Dialogue: 0,0:18:39.50,0:18:41.06,CN,,0000,0000,0000,,Күйеуіңіз бен күйеуіңіздің күш-жігері туралы айту
Dialogue: 0,0:18:41.06,0:18:41.69,CN,,0000,0000,0000,,Гор
Dialogue: 0,0:18:43.31,0:18:45.45,CN,,0000,0000,0000,,Бақыт әр түрлі
Dialogue: 0,0:18:46.01,0:18:49.38,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:49.65,0:18:50.98,CN,,0000,0000,0000,,Көтеріліс
Dialogue: 0,0:18:52.32,0:18:54.92,CN,,0000,0000,0000,,Өзін-өзі сақтаудың жолы күшті.
Dialogue: 0,0:18:57.99,0:19:00.28,CN,,0000,0000,0000,,Менің әкем Або патша қайтыс болған кезде
Dialogue: 0,0:19:00.86,0:19:04.38,CN,,0000,0000,0000,,25 18
Dialogue: 0,0:19:05.87,0:19:08.10,CN,,0000,0000,0000,,Император Хейджоның әкесі мен ұлы
Dialogue: 0,0:19:08.86,0:19:10.58,CN,,0000,0000,0000,,Сайыс барысында
Dialogue: 0,0:19:11.13,0:19:13.29,CN,,0000,0000,0000,,Азаптың соңы, бұл дүниенің ақыры
Dialogue: 0,0:19:14.82,0:19:16.15,CN,,0000,0000,0000,,Әкесінің туғанына байланысты Ю Гэнжы
Dialogue: 0,0:19:18.01,0:19:21.39,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:22.88,0:19:25.30,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:26.49,0:19:28.12,CN,,0000,0000,0000,,Мұнда көрсетілгендей
Dialogue: 0,0:19:29.66,0:19:32.97,CN,,0000,0000,0000,,Алайда әкемнің электрик екенін түсінбеймін.
Dialogue: 0,0:19:34.21,0:19:38.61,CN,,0000,0000,0000,,Сенімімді қорғауды таңдадым, Азғын дүниені мазақ етемін, Күш-қуатымды жоғалтамын.
Dialogue: 0,0:19:39.52,0:19:41.27,CN,,0000,0000,0000,,Бұл әкемнің жоқтауы.
Dialogue: 0,0:19:44.91,0:19:46.89,CN,,0000,0000,0000,,…Ересек Юкихира Ересек
Dialogue: 0,0:19:48.42,0:19:49.35,CN,,0000,0000,0000,,Ересек Юкихира
Dialogue: 0,0:19:51.84,0:19:54.88,CN,,0000,0000,0000,,Ұшуға дайындалу уақыты қашан?
Dialogue: 0,0:19:58.51,0:20:01.78,CN,,0000,0000,0000,,Әңгіменің шығу тегі.
Dialogue: 0,0:20:02.31,0:20:02.70,CN,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:20:03.15,0:20:04.48,CN,,0000,0000,0000,,Әңгіме күлкілі оқиға
Dialogue: 0,0:20:05.14,0:20:07.96,CN,,0000,0000,0000,,Басқаларды шақыру керек.
Dialogue: 0,0:20:08.83,0:20:11.13,CN,,0000,0000,0000,,Бұл қосымша әдіс.
Dialogue: 0,0:20:11.62,0:20:14.13,CN,,0000,0000,0000,,Ерікті...ерікті ме?
Dialogue: 0,0:20:15.66,0:20:17.75,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:18.75,0:20:19.61,CN,,0000,0000,0000,,Мен сені бірден кездестірдім.
Dialogue: 0,0:20:20.39,0:20:23.77,CN,,0000,0000,0000,,Бұл жұмыс түрі өздігінен жазылады.
Dialogue: 0,0:20:25.34,0:20:26.84,CN,,0000,0000,0000,,Инаба алыста.
Dialogue: 0,0:20:27.62,0:20:29.05,CN,,0000,0000,0000,,Алдымен саяси мәселелер
Dialogue: 0,0:20:29.48,0:20:31.48,CN,,0000,0000,0000,,Міндетті емес
Dialogue: 0,0:20:33.38,0:20:33.88,CN,,0000,0000,0000,,Хироко
Dialogue: 0,0:20:34.65,0:20:34.96,CN,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:20:35.54,0:20:36.93,CN,,0000,0000,0000,,Менің ниетімді қажетсіз түсіндіру
Dialogue: 0,0:20:39.17,0:20:43.26,CN,,0000,0000,0000,,Ең бастысы, мен мұнда келгенде түсінікті болу керек.
Dialogue: 0,0:20:44.07,0:20:47.45,CN,,0000,0000,0000,,Инабадан Киотоға дейін Тадаюки Катакоку Қажетсіз шағын бақылау.
Dialogue: 0,0:20:49.31,0:20:51.70,CN,,0000,0000,0000,,Мен сізге көмектесуге келдім
Dialogue: 0,0:20:52.63,0:20:54.48,CN,,0000,0000,0000,,Ньюова Гашоның маңыздылығы
Dialogue: 0,0:20:55.71,0:20:57.31,CN,,0000,0000,0000,,Жұмысқа қабылдау және кету әрекеттері
Dialogue: 0,0:20:58.92,0:20:59.63,CN,,0000,0000,0000,,Иә немесе жоқ
Dialogue: 0,0:21:03.30,0:21:04.12,CN,,0000,0000,0000,,Бұл туралы не деуге болады?
Dialogue: 0,0:21:04.62,0:21:05.65,CN,,0000,0000,0000,,Ересек Юкихира
Dialogue: 0,0:21:06.42,0:21:09.02,CN,,0000,0000,0000,,Түрлі дәстүрлі әдеби шығармалар да шығарылуы мүмкін.
Dialogue: 0,0:21:10.40,0:21:13.51,CN,,0000,0000,0000,,Менімен байланысқыңыз келсе, маған хабарласыңыз.
Dialogue: 0,0:21:14.88,0:21:16.19,CN,,0000,0000,0000,,Бұл ұйқының бірінші кезеңі.
Dialogue: 0,0:21:18.08,0:21:21.29,CN,,0000,0000,0000,,Ересек Юкихира Мен жасаған бөлек
Dialogue: 0,0:21:23.09,0:21:25.25,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:25.82,0:21:28.20,CN,,0000,0000,0000,,Ересек адамның жүрегі сезімге толы
Dialogue: 0,0:21:28.93,0:21:30.51,CN,,0000,0000,0000,,Алайда бұл қажет емес.
Dialogue: 0,0:21:31.57,0:21:37.11,CN,,0000,0000,0000,,Алғашқы некеде мен оны мәңгілікке қолдауды шештім.
Dialogue: 0,0:21:38.63,0:21:39.68,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:40.80,0:21:46.17,CN,,0000,0000,0000,,Шынайы себеп осындай.
Dialogue: 0,0:21:47.25,0:21:49.30,CN,,0000,0000,0000,,Мен бір ұпаймын, мен күштімін.
Dialogue: 0,0:21:49.97,0:21:53.35,CN,,0000,0000,0000,,Соның арқасында менің талантымды өзгерту мүмкіндігі бар.
Dialogue: 0,0:21:54.16,0:21:55.28,CN,,0000,0000,0000,,Мен де
Dialogue: 0,0:21:56.51,0:21:58.09,CN,,0000,0000,0000,,Себебі сіз сондасыз және т.б.
Dialogue: 0,0:21:59.09,0:22:00.07,CN,,0000,0000,0000,,Ыңғайлылығым жоқ па деп қорқамын.
Dialogue: 0,0:22:02.71,0:22:14.93,&,,0000,0000,0000,,Инабаро Манман
Dialogue: 0,0:22:04.42,0:22:14.93,&,,0000,0000,0000,,Шикана Мацукашиге
Dialogue: 0,0:22:05.80,0:22:14.93,&,,0000,0000,0000,,Вакамен-кунның емі
Dialogue: 0,0:22:08.01,0:22:14.93,&,,0000,0000,0000,,Жүгіру тұтқасы
Dialogue: 0,0:22:12.89,0:22:14.06,CN,,0000,0000,0000,,Мен жүгіруді аяқтадым
Dialogue: 0,0:22:14.94,0:22:17.58,CN,,0000,0000,0000,,Дегенмен, сізге шақыру - сіздің денеңіздің шыңына жету.
Dialogue: 0,0:22:18.99,0:22:19.47,CN,,0000,0000,0000,,Бекітілген
Dialogue: 0,0:22:22.29,0:22:24.22,CN,,0000,0000,0000,,Үкіметке әкем, ағам, ағам келді.
Dialogue: 0,0:22:24.84,0:22:27.12,CN,,0000,0000,0000,,Мен жан тыныштығын сақтаймын.
Dialogue: 0,0:22:28.72,0:22:30.36,CN,,0000,0000,0000,,Баруға болатын ең маңызды жер – Шығыс пен Батыс.
Dialogue: 0,0:22:31.50,0:22:35.00,CN,,0000,0000,0000,,...
Dialogue: 0,0:22:37.75,0:22:42.36,CN,,0000,0000,0000,,Алайда мен баланы бес жылдан кейін көрдім.
Dialogue: 0,0:24:14.83,0:24:29.88,&,,0000,0000,0000,,...
Dialogue: 0,0:24:14.83,0:24:29.88,,,0000,0000,0000,,Йосеи-ин
Dialogue: 0,0:24:16.84,0:24:22.25,CN,,0000,0000,0000,,Цукуба шыңындағы су
Dialogue: 0,0:24:24.31,0:24:28.36,CN,,0000,0000,0000,,Махаббат пен махаббаттың жанашырлық бөлшектері
Dialogue: 0,0:24:31.38,0:24:37.38,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory