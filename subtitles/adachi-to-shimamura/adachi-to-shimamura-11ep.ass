Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.47,0:00:10.47,Default,,0,0,0,,Шимамура
Dialogue: 0,0:00:20.82,0:00:25.16,Default,,0,0,0,,＜Мен бұл жерге қайта оралдым＞
Dialogue: 0,0:00:25.16,0:00:28.66,Default,,0,0,0,,<Мен неге екінші курс студенті болдым?>
Dialogue: 0,0:00:28.66,0:00:32.33,Default,,0,0,0,,<Төменде, Шимамура және оның жаңа сыныптастары>
Dialogue: 0,0:00:32.33,0:00:34.83,Default,,0,0,0,,<Дене шынықтыру сабағын оқыту>
Dialogue: 0,0:00:36.40,0:00:41.41,Default,,0,0,0,,<Симамура менің осында екенімді түсінді ме?>
Dialogue: 0,0:00:41.41,0:00:45.41,Default,,0,0,0,,<Сіз білмей тұрып, адамдар Шимамураның айналасына жиналды>
Dialogue: 0,0:00:45.41,0:00:49.35,Default,,0,0,0,,<Шимамура жақсы жүр, ал мен емес.>
Dialogue: 0,0:00:49.35,0:00:52.55,Default,,0,0,0,,<Қарапайым сөзбен айтқанда, бар болғаны>
Dialogue: 0,0:00:53.42,0:00:56.02,Default,,0,0,0,,<Симамура күлді>
Dialogue: 0,0:00:56.02,0:00:59.36,Default,,0,0,0,,<Жақсы танымайтын адамға>
Dialogue: 0,0:00:59.36,0:01:03.79,Default,,0,0,0,,<Мен бұл мен маған бағытталған нәрсенің айырмашылығын көре алмадым.>
Dialogue: 0,0:01:03.79,0:01:08.13,Default,,0,0,0,,<Тітіркеніп кеттім, кеудем қысылып, жылағым келеді>
Dialogue: 0,0:01:08.13,0:01:12.80,Default,,0,0,0,,<Симамура мен мен арасындағы драмалық немесе ерекше бірдеңе>
Dialogue: 0,0:01:12.80,0:01:16.31,Default,,0,0,0,,<Осындай бірде-бір зат туылмас па еді?>
Dialogue: 0,0:01:16.31,0:01:18.81,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:01:28.99,0:01:30.99,Default,,0,0,0,,<Симамура…>
Dialogue: 0,0:01:32.54,0:02:58.52,Default,,0,0,0,,Сен
Dialogue: 0,0:03:02.78,0:03:04.78,Default,,0,0,0,,Ах
Dialogue: 0,0:03:06.85,0:03:09.05,Default,,0,0,0,,А...
Dialogue: 0,0:03:21.14,0:03:23.97,Default,,0,0,0,,<Жоғарғы сынып оқушысы болуы мүмкін>
Dialogue: 0,0:03:23.97,0:03:26.81,Default,,0,0,0,,<Менен сәл алысырақ отырсаңыз>
Dialogue: 0,0:03:26.81,0:03:31.15,Default,,0,0,0,,<Қолымдағы қағаз мұқабалы кітапты ашып, үнсіз оқи бастадым>
Dialogue: 0,0:03:31.15,0:03:34.98,Default,,0,0,0,,<Тыныштық атмосфера кенеттен өзгереді>
Dialogue: 0,0:03:34.98,0:03:38.28,Default,,0,0,0,,<Бұл енді менің орным емес>
Dialogue: 0,0:03:41.32,0:03:44.32,Default,,0,0,0,,...
Dialogue: 0,0:03:44.32,0:03:48.32,Default,,0,0,0,,Өте өкінішті, олар маған орын берді.
Dialogue: 0,0:03:50.00,0:03:52.00,Default,,0,0,0,,Бөлек
Dialogue: 0,0:03:53.00,0:03:57.77,Default,,0,0,0,,<Мен Шимамураның бұл жерге ешқашан келмейтінін білдім>
Dialogue: 0,0:03:57.77,0:03:59.84,Default,,0,0,0,,<Мен және Шимамура ұқсас емес>
Dialogue: 0,0:03:59.84,0:04:04.61,Default,,0,0,0,,<Мен жалғыз болғандықтан спортзалда кездестік>
Dialogue: 0,0:04:04.61,0:04:08.28,Default,,0,0,0,,<Шимамура зеріккендіктен сабақтан шығып кетті>
Dialogue: 0,0:04:08.28,0:04:11.18,Default,,0,0,0,,<үшін осы>
Dialogue: 0,0:04:14.96,0:04:18.63,Default,,0,0,0,,<Мен бұл жерге білмей тұрып келдім>
Dialogue: 0,0:04:18.63,0:04:22.93,Default,,0,0,0,,<Есімде қалғаны - Шимамурамен өткізген құнды уақыт>
Dialogue: 0,0:04:25.97,0:04:28.64,Default,,0,0,0,,<қызыл скучно>
Dialogue: 0,0:04:28.64,0:04:32.14,Default,,0,0,0,,<Симамурасыз қандай қызықсыз болар еді>
Dialogue: 0,0:04:32.14,0:04:35.24,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:04:44.22,0:04:47.72,Default,,0,0,0,,<Симамура, маған мұндай нәрсе ұнайтын шығар>
Dialogue: 0,0:04:49.49,0:04:51.49,Default,,0,0,0,,<Мен ақымақпын>
Dialogue: 0,0:04:51.49,0:04:53.43,Default,,0,0,0,,<Осындай уақытта да>
Dialogue: 0,0:04:53.43,0:04:56.76,Default,,0,0,0,,<Симамураны бақытты ететін нәрсені іздеу>
Dialogue: 0,0:04:56.76,0:04:58.76,Default,,0,0,0,,Уау
Dialogue: 0,0:05:00.10,0:05:03.10,Default,,0,0,0,,Кешіріңіз... Кешіріңіз (Таруми) Кешіріңіз.
Dialogue: 0,0:05:06.11,0:05:08.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:10.78,0:05:12.78,Default,,0,0,0,,Бұл аз
Dialogue: 0,0:05:12.78,0:05:15.62,Default,,0,0,0,,Сіз мұны тастаған жоқсыз ба? Ах...
Dialogue: 0,0:05:15.62,0:05:19.22,Default,,0,0,0,,Уа, ау, мынау, иә, иә!
Dialogue: 0,0:05:22.46,0:05:26.46,Default,,0,0,0,,Рахмет Сізге көп рахмет!
Dialogue: 0,0:05:26.46,0:05:30.46,Default,,0,0,0,,<Бұл шынымен маңызды ма деп ойлаймын, бірақ...>
Dialogue: 0,0:05:30.46,0:05:35.46,Default,,0,0,0,,<Мені мұндай нәрсе қызықтырмады, бірақ егер ол Шимамураға сәйкес келсе>
Dialogue: 0,0:05:36.80,0:05:39.00,Default,,0,0,0,,<Тағы да…>
Dialogue: 0,0:06:01.83,0:06:06.33,Default,,0,0,0,,<Неге, мен неге жылап отырмын?>
Dialogue: 0,0:06:07.43,0:06:10.27,Default,,0,0,0,,<Бұл айна болды>
Dialogue: 0,0:06:10.27,0:06:12.77,Default,,0,0,0,,<Мұнда жоқ>
Dialogue: 0,0:06:12.77,0:06:16.78,Default,,0,0,0,,<Мен сол витринадағы итпен бірдеймін>
Dialogue: 0,0:06:16.78,0:06:20.85,Default,,0,0,0,,<Керісінше, ол іске өзі кірісті>
Dialogue: 0,0:06:20.85,0:06:23.12,Default,,0,0,0,,<Тіпті сатуға тырыспаймын>
Dialogue: 0,0:06:23.12,0:06:25.79,Default,,0,0,0,,<Мен сол жерде отырғанмын>
Dialogue: 0,0:06:25.79,0:06:28.29,Default,,0,0,0,,...
Dialogue: 0,0:06:32.29,0:06:34.69,Default,,0,0,0,,Ақыры оларға бақыт келді
Dialogue: 0,0:06:35.63,0:06:37.70,Default,,0,0,0,,...
Dialogue: 0,0:06:37.70,0:06:41.30,Default,,0,0,0,,Уайымдап үйге барсам да →
Dialogue: 0,0:06:41.30,0:06:45.64,Default,,0,0,0,,Ертеңгі күнді көре алмаймын →
Dialogue: 0,0:06:45.64,0:06:48.31,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:06:48.31,0:06:51.98,Default,,0,0,0,,Мм, сен оңай адамсың ба?
Dialogue: 0,0:06:51.98,0:06:55.75,Default,,0,0,0,,Иә, бұл Эксшаман сияқты нәрсе.
Dialogue: 0,0:06:55.75,0:06:57.75,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:06:57.75,0:07:00.59,Default,,0,0,0,,Мен сізге бәрін айта аламын, мысалы
Dialogue: 0,0:07:00.59,0:07:03.69,Default,,0,0,0,,Сол көз жасы аққан жер
Dialogue: 0,0:07:04.66,0:07:08.26,Default,,0,0,0,,Бұл сөзсіз махаббат оқиғасы.
Dialogue: 0,0:07:08.26,0:07:10.60,Default,,0,0,0,,Әй, иә! ? 1000 иен
Dialogue: 0,0:07:10.60,0:07:12.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:14.94,0:07:18.01,Default,,0,0,0,,Сонда 1000... Эх!
Dialogue: 0,0:07:18.01,0:07:20.44,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:20.44,0:07:24.11,Default,,0,0,0,,Енді бір нәрсе сұрайын.
Dialogue: 0,0:07:24.11,0:07:28.45,Default,,0,0,0,,Бұл адамның шашы сізден ұзынырақ па?
Dialogue: 0,0:07:28.45,0:07:32.75,Default,,0,0,0,,...
Dialogue: 0,0:07:34.12,0:07:36.12,Default,,0,0,0,,<Симамураның шашы>
Dialogue: 0,0:07:36.12,0:07:38.19,Default,,0,0,0,,<Тегіс және таза>
Dialogue: 0,0:07:38.19,0:07:40.19,Default,,0,0,0,,<Жұмсақ>
Dialogue: 0,0:07:41.19,0:07:43.20,Default,,0,0,0,,...
Dialogue: 0,0:07:43.20,0:07:47.13,Default,,0,0,0,,Ойланып қарасаңыз, мен басқа адамды түсінемін.
Dialogue: 0,0:07:47.13,0:07:49.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:49.14,0:07:51.47,Default,,0,0,0,,Дәл! саған не жетіспейді
Dialogue: 0,0:07:51.47,0:07:53.64,Default,,0,0,0,,Шығарыңыз!
Dialogue: 0,0:07:53.64,0:07:56.41,Default,,0,0,0,,Басқалар сен туралы не ойлады деп уайымдап қашып кеткен саған.
Dialogue: 0,0:07:56.41,0:07:59.91,Default,,0,0,0,,Жетіспейтіні бір қарағанда анық көрінеді
Dialogue: 0,0:07:59.91,0:08:03.58,Default,,0,0,0,,Сол батылдыққа жетудің оңай жолы →
Dialogue: 0,0:08:03.58,0:08:05.59,Default,,0,0,0,,Оқыту
Dialogue: 0,0:08:05.59,0:08:09.69,Default,,0,0,0,,Мына жерде, дәл қазір, дәл қазір айқайлаңыз.
Dialogue: 0,0:08:11.09,0:08:13.59,Default,,0,0,0,,Ха! ? Егер сіз мұны жасамасаңыз
Dialogue: 0,0:08:13.59,0:08:16.43,Default,,0,0,0,,Сіз тек 1000 иен жоғалтасыз→
Dialogue: 0,0:08:16.43,0:08:19.43,Default,,0,0,0,,Жарайды, егер қаласаңыз, жақсы.
Dialogue: 0,0:08:19.43,0:08:22.77,Default,,0,0,0,,Бірақ мұнда және қазір...
Dialogue: 0,0:08:22.77,0:08:26.44,Default,,0,0,0,,Өкінгіңіз келмесе, жасаңыз.
Dialogue: 0,0:08:26.44,0:08:31.74,Default,,0,0,0,,Жүр, айқайла! Не ойлайтыныңызды мүмкіндігінше айтыңыз!
Dialogue: 0,0:08:34.11,0:08:37.18,Default,,0,0,0,,Қолдарыңызды көтеріп, мәлімдеңіздер
Dialogue: 0,0:08:37.18,0:08:41.58,Default,,0,0,0,,Бұл жүрегіңді ұстап тұрудың және оны қатал етудің жалғыз жолы
Dialogue: 0,0:08:43.46,0:08:45.96,Default,,0,0,0,,Иә... Мен мұны істеймін...
Dialogue: 0,0:08:45.96,0:08:49.03,Default,,0,0,0,,Дауысы кішкентай, сызықтары жақсы емес.→
Dialogue: 0,0:08:49.03,0:08:51.33,Default,,0,0,0,,Қолын да көтермеді.
Dialogue: 0,0:08:52.97,0:08:57.64,Default,,0,0,0,,Егер сізде мұндай батылдық болса, сіз уайымдамайтындай көрінуіңіз керек.
Dialogue: 0,0:08:57.64,0:09:00.47,Default,,0,0,0,,Бір жағынан батыл болсаң
Dialogue: 0,0:09:00.47,0:09:04.14,Default,,0,0,0,,Бұл толығымен шешілетін мәселе.
Dialogue: 0,0:09:04.14,0:09:06.14,Default,,0,0,0,,Рахмет, екеуіңе. Мен кеттім!
Dialogue: 0,0:09:07.15,0:09:09.98,Default,,0,0,0,,Бірақ... мен бар күшімді саламын.
Dialogue: 0,0:09:09.98,0:09:12.65,Default,,0,0,0,,Мен қайтадан қатты тырыспаймын.
Dialogue: 0,0:09:12.65,0:09:14.99,Default,,0,0,0,,Иә, у...
Dialogue: 0,0:09:14.99,0:09:19.83,Default,,0,0,0,,Өкінгің келмейді, сондықтан қашпа.
Dialogue: 0,0:09:19.83,0:09:21.83,Default,,0,0,0,,Қаш
Dialogue: 0,0:09:21.83,0:09:24.33,Default,,0,0,0,,<Кейде өзімді кішкентай сезінемін>
Dialogue: 0,0:09:24.33,0:09:28.67,Default,,0,0,0,,＜Әу бастан бәрін жоққа шығарып, қашып кеттім＞
Dialogue: 0,0:09:28.67,0:09:30.67,Default,,0,0,0,,<Сол сәтте мен тоқтадым>
Dialogue: 0,0:09:30.67,0:09:33.51,Default,,0,0,0,,<Егер мен Шимамурамен дұрыс сөйлессем>
Dialogue: 0,0:09:33.51,0:09:35.58,Default,,0,0,0,,<Нәтиже бұлай болмағанын қалаймын>
Dialogue: 0,0:09:35.58,0:09:37.68,Default,,0,0,0,,<Өкінетін бір бөлігім болды>
Dialogue: 0,0:09:39.18,0:09:41.28,Default,,0,0,0,,Қашпа
Dialogue: 0,0:09:43.68,0:09:46.75,Default,,0,0,0,,Мен қашпаймын!
Dialogue: 0,0:09:46.75,0:09:49.65,Default,,0,0,0,,О, тағы да тамаша.
Dialogue: 0,0:09:53.63,0:09:58.23,Default,,0,0,0,,Бұл біртүрлі!
Dialogue: 0,0:09:59.30,0:10:02.80,Default,,0,0,0,,Мен мұны істеймін деп ешқашан ойламаппын, иә?
Dialogue: 0,0:10:02.80,0:10:06.64,Default,,0,0,0,,Адамдарға керегі – болашақты білмеу
Dialogue: 0,0:10:06.64,0:10:09.48,Default,,0,0,0,,Болашағынан үлкен үміт күт
Dialogue: 0,0:10:09.48,0:10:11.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:13.15,0:10:15.15,Default,,0,0,0,,Соның арқасында...
Dialogue: 0,0:10:15.15,0:10:18.99,Default,,0,0,0,,Олай болса, өз болашағыңның қамын ойла~
Dialogue: 0,0:10:18.99,0:10:21.66,Default,,0,0,0,,Бұл қайтадан сенсің!
Dialogue: 0,0:10:21.66,0:10:24.46,Default,,0,0,0,,...
Dialogue: 0,0:10:27.49,0:10:31.00,Default,,0,0,0,,<Апта аяқталды, бүгін Шимамура>
Dialogue: 0,0:10:31.00,0:10:36.00,Default,,0,0,0,,<Мен мектепке бел байладым, бірақ міне, тағы...>
Dialogue: 0,0:10:36.00,0:10:38.00,Default,,0,0,0,,<Осы кітап>
Dialogue: 0,0:10:39.01,0:10:42.31,Default,,0,0,0,,《Бұл өте жаман болды, олар маған орын берді》
Dialogue: 0,0:10:47.51,0:10:50.58,Default,,0,0,0,,<«Мен неге жүгіремін?»>
Dialogue: 0,0:10:50.58,0:10:53.19,Default,,0,0,0,,<“Бұл қорқынышты болғандықтан шешілді”>
Dialogue: 0,0:10:53.19,0:10:56.62,Default,,0,0,0,,＜«Мен ұялып жүргенде, ертеңгі күнімді түсіндім»＞
Dialogue: 0,0:10:56.62,0:11:00.96,Default,,0,0,0,,<“Күн сайын мен кешегі дүние боламын деп қорқамын.”>
Dialogue: 0,0:11:00.96,0:11:02.96,Default,,0,0,0,,<«Бұл мен білмейтін жерде болды»>
Dialogue: 0,0:11:02.96,0:11:05.63,Default,,0,0,0,,<“Үлкен өзгерістерден артта қалғаным дұрыс”>
Dialogue: 0,0:11:05.63,0:11:10.23,Default,,0,0,0,,<«Алдыңғы қатарда болу және өзгерісті өзіңіз жасау жолын таңдаңыз»>
Dialogue: 0,0:11:13.97,0:11:16.48,Default,,0,0,0,,Артында қалды
Dialogue: 0,0:11:16.48,0:11:18.98,Default,,0,0,0,,<Мен екінші курс студенті емеспін>
Dialogue: 0,0:11:18.98,0:11:22.32,Default,,0,0,0,,<Тек Шимамура мектептің екінші курс студенті>
Dialogue: 0,0:11:22.32,0:11:24.82,Default,,0,0,0,,<Қазір Шимамура сыныпта>
Dialogue: 0,0:11:24.82,0:11:26.89,Default,,0,0,0,,<Түскі ас>
Dialogue: 0,0:11:26.89,0:11:29.16,Default,,0,0,0,,<Олар мұнда келмейді>
Dialogue: 0,0:11:29.16,0:11:33.46,Default,,0,0,0,,<Ол келер жол жоқ, дұрыс, біз мұны істеуіміз керек>
Dialogue: 0,0:11:38.23,0:11:42.00,Default,,0,0,0,,Мен қашпаймын!
Dialogue: 0,0:11:42.00,0:11:45.51,Default,,0,0,0,,Иә, Ямада, үйірме жұмыстары қиын емес пе?
Dialogue: 0,0:11:45.51,0:11:48.01,Default,,0,0,0,,<Іздеген жерде саңылау жоқ>
Dialogue: 0,0:11:48.01,0:11:50.01,Default,,0,0,0,,<Бірақ...>
Dialogue: 0,0:11:51.85,0:11:54.85,Default,,0,0,0,,<Егер ол жоқ болса, сіз оны жасағанша.>
Dialogue: 0,0:11:54.85,0:11:58.02,Default,,0,0,0,,Келісемін! Мен қызық...
Dialogue: 0,0:11:58.02,0:12:00.02,Default,,0,0,0,,Шимамура
Dialogue: 0,0:12:14.30,0:12:17.50,Default,,0,0,0,,<Бұл менің екінші курсымның басы еді>
Dialogue: 0,0:12:20.80,0:12:23.87,Default,,0,0,0,,<Адачидің дауысын естігеніңізге қанша уақыт болды?>
Dialogue: 0,0:12:23.87,0:12:26.14,Default,,0,0,0,,<2-сыныпта не тыңдау керек>
Dialogue: 0,0:12:26.14,0:12:28.98,Default,,0,0,0,,<Менің ойымша, бұл бірінші рет>
Dialogue: 0,0:12:28.98,0:12:31.48,Default,,0,0,0,,Қасыңа отырсам бола ма?
Dialogue: 0,0:12:31.48,0:12:34.78,Default,,0,0,0,,Е, а... е, орындық...
Dialogue: 0,0:12:37.32,0:12:39.99,Default,,0,0,0,,Иә? Мұнда бәрі жақсы
Dialogue: 0,0:12:39.99,0:12:42.32,Default,,0,0,0,,Иә
Dialogue: 0,0:12:42.32,0:12:45.33,Default,,0,0,0,,А, Шимамура, мен нан сатып алдым.
Dialogue: 0,0:12:45.33,0:12:48.40,Default,,0,0,0,,Иә? Е, осыншама?
Dialogue: 0,0:12:48.40,0:12:50.40,Default,,0,0,0,,Сома көп емес пе?
Dialogue: 0,0:12:50.40,0:12:53.77,Default,,0,0,0,,Шимамураны қаласаң, мен саған беремін.
Dialogue: 0,0:12:53.77,0:12:56.97,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:13:03.28,0:13:05.28,Default,,0,0,0,,Бір нәрсе.
Dialogue: 0,0:13:05.28,0:13:08.62,Default,,0,0,0,,Тосап нан алғыңыз келе ме?
Dialogue: 0,0:13:08.62,0:13:13.92,Default,,0,0,0,,Сізде тағы біреуі бар ма? Жоқ, мен оны жей алмаймын.
Dialogue: 0,0:13:15.12,0:13:18.19,Default,,0,0,0,,<Адачи сәл тітіркендіргіш болса да>
Dialogue: 0,0:13:18.19,0:13:22.13,Default,,0,0,0,,<Ол мені жеткілікті деп шешті.>
Dialogue: 0,0:13:22.13,0:13:24.20,Default,,0,0,0,,<Мен ше?>
Dialogue: 0,0:13:24.20,0:13:27.20,Default,,0,0,0,,<Кейде тіпті бір адам керек пе деп ойлаймын>
Dialogue: 0,0:13:27.20,0:13:29.80,Default,,0,0,0,,<Жауап әлі қол жетімді емес>
Dialogue: 0,0:13:29.80,0:13:33.31,Default,,0,0,0,,<Менің білетінім, орын ауыстыру үшін күтудің қажеті жоқ>
Dialogue: 0,0:13:33.31,0:13:38.31,Default,,0,0,0,,<Санчомен және басқалармен нашар қарым-қатынас үзіледі деп айтылды.>
Dialogue: 0,0:13:41.65,0:13:43.72,Default,,0,0,0,,Шимамура Иә?
Dialogue: 0,0:13:43.72,0:13:46.92,Default,,0,0,0,,Ал, үйге бірге барайық.
Dialogue: 0,0:13:50.49,0:13:53.43,Default,,0,0,0,,А...
Dialogue: 0,0:13:53.43,0:13:56.26,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:13:56.26,0:14:00.26,Default,,0,0,0,,Сіз қазір айтып тұрсыз ба? Ондай нәрсе жоқ
Dialogue: 0,0:14:01.94,0:14:03.94,Default,,0,0,0,,Ах
Dialogue: 0,0:14:05.61,0:14:07.91,Default,,0,0,0,,Сол бау
Dialogue: 0,0:14:11.44,0:14:13.45,Default,,0,0,0,,Сіз мұны істеп жатырсыз ба?
Dialogue: 0,0:14:13.45,0:14:16.28,Default,,0,0,0,,Менің ойымша, бұл тұрақты және танымал.
Dialogue: 0,0:14:16.28,0:14:19.35,Default,,0,0,0,,Оны қайдан сатып алдыңыз? оны қалайсың ба?
Dialogue: 0,0:14:19.35,0:14:22.62,Default,,0,0,0,,Иә, мен оны да қосамын деп ойлаймын.
Dialogue: 0,0:14:22.62,0:14:25.46,Default,,0,0,0,,Олар сәйкес келеді...
Dialogue: 0,0:14:25.46,0:14:27.79,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:27.79,0:14:29.80,Default,,0,0,0,,<Егер Адачи сатып алса>
Dialogue: 0,0:14:29.80,0:14:32.63,Default,,0,0,0,,<Сонымен Таруми екеуміз бір жұппыз ба?>
Dialogue: 0,0:14:32.63,0:14:35.93,Default,,0,0,0,,Мүмкін, иә?
Dialogue: 0,0:14:36.97,0:14:39.47,Default,,0,0,0,,О, мен оны ұстай аламын ба?
Dialogue: 0,0:14:39.47,0:14:41.98,Default,,0,0,0,,Иә?О
Dialogue: 0,0:14:41.98,0:14:44.48,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:14:45.48,0:14:49.55,Default,,0,0,0,,<Неге бәрі менімен қол ұстағысы келеді?>
Dialogue: 0,0:14:49.55,0:14:54.25,Default,,0,0,0,,<Олар мені бір жерге барамын деп ойлай ма?>
Dialogue: 0,0:14:54.25,0:14:57.76,Default,,0,0,0,,<Енді ойлап қарасам, Таруми сол қолымды алды.>
Dialogue: 0,0:14:57.76,0:14:59.96,Default,,0,0,0,,<Адачи оң жақта ма?>
Dialogue: 0,0:15:01.09,0:15:03.76,Default,,0,0,0,,Ал, Адачи, міне.
Dialogue: 0,0:15:03.76,0:15:08.10,Default,,0,0,0,,Велосипед, солай ма? Иә
Dialogue: 0,0:15:08.10,0:15:10.94,Default,,0,0,0,,Мен де ертең кездесеміз, иә.
Dialogue: 0,0:15:10.94,0:15:14.27,Default,,0,0,0,,Мектеп, келе жатырсың, солай ма? Иә
Dialogue: 0,0:15:14.27,0:15:17.11,Default,,0,0,0,,Себебі мен Шимамурамен кездескім келеді
Dialogue: 0,0:15:17.11,0:15:20.61,Default,,0,0,0,,Не? Жоқ, ештеңе...
Dialogue: 0,0:15:20.61,0:15:23.12,Default,,0,0,0,,Сол Адачи-сан
Dialogue: 0,0:15:23.12,0:15:25.95,Default,,0,0,0,,Қолымды жібермейінше мен үйге бара алмаймын.
Dialogue: 0,0:15:25.95,0:15:28.29,Default,,0,0,0,,Ах
Dialogue: 0,0:15:28.29,0:15:32.13,Default,,0,0,0,,Мен... мен сені үйге жібермеймін... А?
Dialogue: 0,0:15:32.13,0:15:38.46,Default,,0,0,0,,Мен сені үйге жібермеймін.
Dialogue: 0,0:15:38.46,0:15:42.30,Default,,0,0,0,,<Мм, жүгірген итке ұқсайды>
Dialogue: 0,0:15:42.30,0:15:44.30,Default,,0,0,0,,Менің тамырларым жарылып кетеді?
Dialogue: 0,0:15:45.64,0:15:47.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:47.64,0:15:50.14,Default,,0,0,0,,Эй, бір секундқа осында келші, иә?
Dialogue: 0,0:15:50.14,0:15:53.24,Default,,0,0,0,,Эй, эй, Адачи?
Dialogue: 0,0:15:56.92,0:15:59.72,Default,,0,0,0,,Мен үшін алғаш рет!
Dialogue: 0,0:16:02.92,0:16:06.12,Default,,0,0,0,,...
Dialogue: 0,0:16:07.99,0:16:11.79,Default,,0,0,0,,Мен...Менің ойымша, Шимамура жақсы.
Dialogue: 0,0:16:15.27,0:16:20.61,Default,,0,0,0,,Мм, неге кенет мені құшақтап алдың?
Dialogue: 0,0:16:20.61,0:16:25.45,Default,,0,0,0,,Ұзақ уақыт ештеңе болған жоқ, сондықтан ештеңе жоқ па?
Dialogue: 0,0:16:25.45,0:16:29.15,Default,,0,0,0,,Өйткені Шимамура басқа баламен бірге болды.
Dialogue: 0,0:16:30.78,0:16:35.18,Default,,0,0,0,,Гррр... Әй, қызғаншақ па?
Dialogue: 0,0:16:36.12,0:16:38.42,Default,,0,0,0,,Қандай қиналған бала.
Dialogue: 0,0:16:41.19,0:16:44.63,Default,,0,0,0,,<Адачи менің үлкен апамнан алыс>
Dialogue: 0,0:16:44.63,0:16:47.97,Default,,0,0,0,,<Сен тіпті ананың рөлін іздеп жүрсің бе?>
Dialogue: 0,0:16:47.97,0:16:50.80,Default,,0,0,0,,<Егер Санчо мен оның достары бұл жерді көрсе ше>
Dialogue: 0,0:16:50.80,0:16:53.80,Default,,0,0,0,,＜Бұл үлкен түсінбеушілік тудыруы мүмкін＞
Dialogue: 0,0:17:01.75,0:17:06.82,Default,,0,0,0,,Онда мен үйге баруым керек, Сакура-чан.
Dialogue: 0,0:17:06.82,0:17:09.12,Default,,0,0,0,,Неліктен саған бала сияқты қарайды?
Dialogue: 0,0:17:10.42,0:17:15.09,Default,,0,0,0,,Мм, мен сізге кейінірек қоңырау шалсам болады ма?
Dialogue: 0,0:17:15.09,0:17:17.93,Default,,0,0,0,,Телефон? Бұл жақсы болса да
Dialogue: 0,0:17:17.93,0:17:19.93,Default,,0,0,0,,Сағат 7 шамасында
Dialogue: 0,0:17:19.93,0:17:23.00,Default,,0,0,0,,Мен сені шақырамын, жарай ма?
Dialogue: 0,0:17:23.00,0:17:27.27,Default,,0,0,0,,7 сағат тамақ ішетін уақыт.
Dialogue: 0,0:17:27.27,0:17:29.67,Default,,0,0,0,,Эй
Dialogue: 0,0:17:31.11,0:17:34.45,Default,,0,0,0,,Аа, сіз Шимамура мырза емессіз бе?
Dialogue: 0,0:17:34.45,0:17:38.15,Default,,0,0,0,,Шимамура-сан (Симамура әпкесі) Әпке
Dialogue: 0,0:17:41.29,0:17:43.79,Default,,0,0,0,,Эчиго тортын жегіңіз келе ме?
Dialogue: 0,0:17:43.79,0:17:45.79,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:17:45.79,0:17:48.13,Default,,0,0,0,,Балалар, ақшаны не істедіңдер?
Dialogue: 0,0:17:48.13,0:17:50.20,Default,,0,0,0,,Мына торт
Dialogue: 0,0:17:50.20,0:17:53.20,Default,,0,0,0,,Ячи қалтасынан шығарған шығар.
Dialogue: 0,0:17:53.20,0:17:56.14,Default,,0,0,0,,Иә? Ахем!
Dialogue: 0,0:17:56.14,0:18:00.97,Default,,0,0,0,,Фуфуфуфуфуфу Мен Яшиемон болуды шештім.
Dialogue: 0,0:18:00.97,0:18:03.48,Default,,0,0,0,,Яшиемон?
Dialogue: 0,0:18:03.48,0:18:06.31,Default,,0,0,0,,Шимамура-сан, егер сенің де қалаған нәрсең болса.
Dialogue: 0,0:18:06.31,0:18:08.98,Default,,0,0,0,,Иә, иә, мен үйге бара жатырмын~
Dialogue: 0,0:18:08.98,0:18:12.05,Default,,0,0,0,,Мен үйдемін~ Эй
Dialogue: 0,0:18:12.05,0:18:15.66,Default,,0,0,0,,Аздап ерте тамақ ішкен соң қарным ашты.
Dialogue: 0,0:18:15.66,0:18:18.49,Default,,0,0,0,,А, мен қазір жасап жатырмын.
Dialogue: 0,0:18:18.49,0:18:22.16,Default,,0,0,0,,Хмм, жұмыртқа шарларын жегің келе ме?
Dialogue: 0,0:18:22.16,0:18:24.50,Default,,0,0,0,,Мұны қайдан алдың?
Dialogue: 0,0:18:24.50,0:18:27.50,Default,,0,0,0,,Хехехе, бұл Яшиемон.
Dialogue: 0,0:18:27.50,0:18:30.00,Default,,0,0,0,,Сонда сіз бірінші жейтін жалғыз адамсыз ба?
Dialogue: 0,0:18:30.00,0:18:33.51,Default,,0,0,0,,Иә, а, бүгін кешкі асқа не бар?
Dialogue: 0,0:18:33.51,0:18:36.84,Default,,0,0,0,,Мен сатып алған якитори, иә?
Dialogue: 0,0:18:36.84,0:18:39.68,Default,,0,0,0,,Сіз нені кесіп жатырсыз?
Dialogue: 0,0:18:39.68,0:18:43.75,Default,,0,0,0,,Мен оны асыға күтемін! иә?
Dialogue: 0,0:18:43.75,0:18:46.02,Default,,0,0,0,,<Уақытында>
Dialogue: 0,0:18:46.02,0:18:49.86,Default,,0,0,0,,<Әңгіме Адачи туралы болғандықтан, ол сағат 7-де шұғыл қоңырау шалады деп ойлаймын.>
Dialogue: 0,0:18:49.86,0:18:54.29,Default,,0,0,0,,<Ол қазір телефонның алдында тік тұрып, күтіп отыр ма деп ойлаймын.>
Dialogue: 0,0:18:54.29,0:18:56.29,Default,,0,0,0,,<Хмм…>
Dialogue: 0,0:19:01.80,0:19:03.80,Default,,0,0,0,,(Кіріс ұялы қоңырау)
Dialogue: 0,0:19:03.80,0:19:06.47,Default,,0,0,0,,Бұл жерде.
Dialogue: 0,0:19:06.47,0:19:09.48,Default,,0,0,0,,...
Dialogue: 0,0:19:09.48,0:19:13.81,Default,,0,0,0,,Қайырлы кеш, аяқтарыңыз ұйып тұрған жоқ па? ·Не? Не?
Dialogue: 0,0:19:13.81,0:19:17.15,Default,,0,0,0,,… …
Dialogue: 0,0:19:17.15,0:19:20.65,Default,,0,0,0,,Мен жай ғана кездейсоқ айттым Иә, солай ма?
Dialogue: 0,0:19:20.65,0:19:22.66,Default,,0,0,0,,...
Dialogue: 0,0:19:22.66,0:19:27.49,Default,,0,0,0,,...
Dialogue: 0,0:19:27.49,0:19:31.33,Default,,0,0,0,,Бірақ мен соңғы кездері Шимамурамен телефонмен сөйлескен емеспін.
Dialogue: 0,0:19:31.33,0:19:33.33,Default,,0,0,0,,...
Dialogue: 0,0:19:33.33,0:19:35.84,Default,,0,0,0,,...
Dialogue: 0,0:19:35.84,0:19:38.34,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:19:38.34,0:19:41.24,Default,,0,0,0,,Менде ерекше қызығушылық жоқ.
Dialogue: 0,0:19:42.41,0:19:45.01,Default,,0,0,0,,...
Dialogue: 0,0:19:45.01,0:19:47.71,Default,,0,0,0,,Шимамура осында
Dialogue: 0,0:19:49.08,0:19:52.09,Default,,0,0,0,,<Адачи осылай айтты ма деп ойлаймын>
Dialogue: 0,0:19:52.09,0:19:56.02,Default,,0,0,0,,...
Dialogue: 0,0:19:56.02,0:19:58.96,Default,,0,0,0,,Мен мұны кейде жасаймын.
Dialogue: 0,0:19:58.96,0:20:02.80,Default,,0,0,0,,...
Dialogue: 0,0:20:02.80,0:20:06.80,Default,,0,0,0,,...
Dialogue: 0,0:20:06.80,0:20:11.47,Default,,0,0,0,,Болды, мен тек Шимамурадамын.
Dialogue: 0,0:20:11.47,0:20:13.67,Default,,0,0,0,,...
Dialogue: 0,0:20:21.55,0:20:25.32,Default,,0,0,0,,...
Dialogue: 0,0:20:25.32,0:20:28.65,Default,,0,0,0,,...
Dialogue: 0,0:20:28.65,0:20:31.72,Default,,0,0,0,,Зе... Мүлдем емес! Өйткені
Dialogue: 0,0:20:31.72,0:20:36.16,Default,,0,0,0,,Ум, Шимамураныкі/Менікі ме?
Dialogue: 0,0:20:36.16,0:20:38.16,Default,,0,0,0,,Телефонмен сөйлескенде
Dialogue: 0,0:20:38.16,0:20:42.26,Default,,0,0,0,,Шимамура уақытын өзіңізге арнай аласыз...
Dialogue: 0,0:20:43.50,0:20:48.57,Default,,0,0,0,,Адачи өте иемденуші адам.
Dialogue: 0,0:20:48.57,0:20:52.18,Default,,0,0,0,,Не? Ахх... қалыпты қалыпты
Dialogue: 0,0:20:52.18,0:20:55.18,Default,,0,0,0,,...
Dialogue: 0,0:20:55.18,0:20:57.35,Default,,0,0,0,,Кәдімгі Даттеба
Dialogue: 0,0:20:57.35,0:21:00.62,Default,,0,0,0,,...
Dialogue: 0,0:21:00.62,0:21:02.62,Default,,0,0,0,,Ал не?
Dialogue: 0,0:21:02.62,0:21:05.12,Default,,0,0,0,,Қандай да бір жолмен біреуге маңызды сезіну
Dialogue: 0,0:21:05.12,0:21:07.12,Default,,0,0,0,,Мен өзімді жаман сезінбеймін.
Dialogue: 0,0:21:19.81,0:21:22.88,Default,,0,0,0,,(Адачи жылайды)
Dialogue: 0,0:21:22.88,0:21:26.48,Default,,0,0,0,,Адачи?
Dialogue: 0,0:21:26.48,0:21:31.32,Default,,0,0,0,,(Адачи жылайды)
Dialogue: 0,0:21:31.32,0:21:33.32,Default,,0,0,0,,...
Dialogue: 0,0:21:35.66,0:21:38.66,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:21:38.66,0:21:42.46,Default,,0,0,0,,Шимамура - Шимамура - бұл...
Dialogue: 0,0:21:44.66,0:21:50.00,Default,,0,0,0,,<Мен Адачимен бірге болғанда, менің потенциалым бекітілген>
Dialogue: 0,0:21:50.00,0:21:54.70,Default,,0,0,0,,<Егер сіз бірге жүрген адамдарды шектесеңіз, онда сізде таңдау бар>
Dialogue: 0,0:21:58.18,0:22:01.08,Default,,0,0,0,,<Ара шөптерден арылу>
Dialogue: 0,0:22:06.02,0:22:10.12,Default,,0,0,0,,<Мен үшін ең жақсысын таңдау керек>
Dialogue: 0,0:22:11.96,0:22:16.26,Default,,0,0,0,,<Адачи басқаларға мұқтаж емес жолды таңдаған сияқты.>
Dialogue: 0,0:22:26.04,0:22:28.04,Default,,0,0,0,,<Мен...>
Dialogue: 0,0:22:28.76,0:23:57.55,Default,,0,0,0,,Сен
Dialogue: 0,0:23:58.37,0:24:02.16,Default,,0,0,0,,Адашимапедияның соңғы эпизоды (Нагафуджи) Сенгісіз →
Dialogue: 0,0:24:02.16,0:24:03.73,Default,,0,0,0,,Мен жаңа ғана байқадым (Хино) Не?
Dialogue: 0,0:24:03.73,0:24:07.36,Default,,0,0,0,,Келесі аптаның эфирі шықпаса, соңғы бөлім келмейді. Басқаша айтқанда →
Dialogue: 0,0:24:07.36,0:24:10.02,Default,,0,0,0,,Бұл аниме ешқашан аяқталмайды! ?
Dialogue: 0,0:24:10.02,0:24:12.66,Default,,0,0,0,,Бұл жай ғана бас тарту болып саналмай ма?
Dialogue: 0,0:24:14.16,0:24:20.16,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
