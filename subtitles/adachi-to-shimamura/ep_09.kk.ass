Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.30,0:00:13.18,Default,,0,0,0,,Мен шоколад алуға келдім.
Dialogue: 0,0:00:13.72,0:00:15.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:17.56,0:00:20.97,Default,,0,0,0,,Шоколад алуға болатынын естідім!
Dialogue: 0,0:00:21.49,0:00:24.10,Default,,0,0,0,,Әй, Валентин күні туралы.
Dialogue: 0,0:00:24.45,0:00:26.01,Default,,0,0,0,,Міне.
Dialogue: 0,0:00:26.76,0:00:28.69,Default,,0,0,0,,Оны кімнен естідің?
Dialogue: 0,0:00:28.69,0:00:30.79,Default,,0,0,0,,Қызық, шоколад болды ма?
Dialogue: 0,0:00:31.33,0:00:32.91,Default,,0,0,0,,Шоу-сан, маған да шоколад берші.
Dialogue: 0,0:00:32.91,0:00:33.89,Default,,0,0,0,,Нану
Dialogue: 0,0:00:35.79,0:00:38.77,Default,,0,0,0,,Ух... жарайды, маған Ячи бере алсаңыз, жақсы.
Dialogue: 0,0:00:39.83,0:00:41.29,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:00:42.93,0:00:45.25,Default,,0,0,0,,Ғашықтар күні осындай.
Dialogue: 0,0:00:45.60,0:00:46.85,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:00:47.17,0:00:48.78,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:00:49.25,0:00:53.45,Default,,0,0,0,,Ал, келесі кездескен кезде дайындап алайық.
Dialogue: 0,0:00:53.45,0:00:54.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:55.52,0:00:56.88,Default,,0,0,0,,<Мен ұйықтай алмадым>
Dialogue: 0,0:00:57.57,0:01:02.13,Default,,0,0,0,,<Мен үйреніп бара жатқандай сезінемін, сондықтан мен сені әр кезде қайта көремін.>
Dialogue: 0,0:01:03.20,0:01:04.45,Default,,0,0,0,,<Прогресс жоқ>
Dialogue: 0,0:01:12.00,0:01:14.34,Default,,0,0,0,,<Жақсысың ба? Шимамура>
Dialogue: 0,0:01:14.52,0:01:17.94,Default,,0,0,0,,<Мүмкін ол котацуда ұйықтап, шықпайтын шығар>
Dialogue: 0,0:01:32.92,0:01:33.54,Default,,0,0,0,,《Жарайды》
Dialogue: 0,0:03:16.93,0:03:17.81,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:21.12,0:03:24.69,Default,,0,0,0,,<Симамураға бір қарау жүрегімді жылытады>
Dialogue: 0,0:03:25.29,0:03:27.07,Default,,0,0,0,,<Менің күнімді күткендей>
Dialogue: 0,0:03:28.74,0:03:29.38,Default,,0,0,0,,<Күн>
Dialogue: 0,0:03:30.28,0:03:34.45,Default,,0,0,0,,<Бірнеше рет қолдансам, ұяттан құтыла аламын деп ойладым.>
Dialogue: 0,0:03:35.06,0:03:35.71,Default,,0,0,0,,<Мүмкін емес>
Dialogue: 0,0:03:41.01,0:03:46.16,Default,,0,0,0,,<Не? Эй, шоколад қазірдің өзінде! ? ＞
Dialogue: 0,0:03:50.24,0:03:52.94,Default,,0,0,0,,Уайымдама, мен оны дұрыстап әкелдім.
Dialogue: 0,0:03:56.75,0:04:00.93,Default,,0,0,0,,<Иә, мен мұны білдім, бірақ мен артта қалғандай сезінемін.>
Dialogue: 0,0:04:02.10,0:04:05.29,Default,,0,0,0,,<Мен Шимамурадан шыққан ит сияқтымын>
Dialogue: 0,0:04:06.00,0:04:09.99,Default,,0,0,0,,＜Бірақ бұл ит болса, оны Шимамурада алуға болады＞
Dialogue: 0,0:04:10.85,0:04:12.66,Default,,0,0,0,,＜Тізеңізде бүгілу＞
Dialogue: 0,0:04:13.25,0:04:15.68,Default,,0,0,0,,<Сенің қолыңнан келетініне сенімдімін>
Dialogue: 0,0:04:16.98,0:04:20.15,Default,,0,0,0,,<Мен Шимамурадан шыққан ит ыңғайсыз деп ойлаймын.>
Dialogue: 0,0:04:22.62,0:04:23.82,Default,,0,0,0,,<Жоқ, жоқ, жоқ>
Dialogue: 0,0:04:25.88,0:04:29.52,Default,,0,0,0,,<Осы уақытқа дейін көңілім қалды, бірақ қазір анық түсіндім>
Dialogue: 0,0:04:30.61,0:04:33.07,Default,,0,0,0,,<Мен соңғы кездері ақымақ болдым>
Dialogue: 0,0:04:37.07,0:04:40.64,Default,,0,0,0,,Ал, біз қазір ойынға шығамыз, солай емес пе?
Dialogue: 0,0:04:41.12,0:04:41.88,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:04:42.58,0:04:44.21,Default,,0,0,0,,Бір жерге барғыңыз келе ме?
Dialogue: 0,0:04:45.83,0:04:50.36,Default,,0,0,0,,Жоқ...Мен Нагояға барамын! Немесе бірдеңе...
Dialogue: 0,0:04:51.31,0:04:53.47,Default,,0,0,0,,Алыс па?
Dialogue: 0,0:04:54.49,0:04:55.31,Default,,0,0,0,,Нагоя…
Dialogue: 0,0:04:56.63,0:04:59.22,Default,,0,0,0,,Ахахахаха
Dialogue: 0,0:04:59.22,0:05:00.29,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:00.29,0:05:02.56,Default,,0,0,0,,Ол осылай жасалған.
Dialogue: 0,0:05:03.20,0:05:04.22,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:05:04.60,0:05:06.51,Default,,0,0,0,,Жарайды, кеттік, кеттік.
Dialogue: 0,0:05:07.19,0:05:09.32,Default,,0,0,0,,Мен де баруды ойладым.
Dialogue: 0,0:05:11.22,0:05:13.42,Default,,0,0,0,,Айтпақшы, сіз Нагояда не істемексіз?
Dialogue: 0,0:05:13.76,0:05:16.11,Default,,0,0,0,,Мм... Мен шоколад алайын деп жатырмын.
Dialogue: 0,0:05:16.50,0:05:18.61,Default,,0,0,0,,Мен оны әлі сатып алған жоқпын.
Dialogue: 0,0:05:19.04,0:05:22.34,Default,,0,0,0,,А... Дәл сол күні сатып алсам жаңарақ болар еді деп ойлаймын.
Dialogue: 0,0:05:22.95,0:05:25.13,Default,,0,0,0,,Ахахахаха...
Dialogue: 0,0:05:25.13,0:05:28.35,Default,,0,0,0,,Көремін, көремін. Күшті.
Dialogue: 0,0:05:28.40,0:05:29.67,Default,,0,0,0,,<Не болды>
Dialogue: 0,0:05:30.22,0:05:32.58,Default,,0,0,0,,<Симамура да таң қаларлықтай бақытты ма? ＞
Dialogue: 0,0:05:33.35,0:05:36.83,Default,,0,0,0,,＜Бірақ мен бұл күлкіні көрген сайын мен...＞
Dialogue: 0,0:05:38.35,0:05:40.56,Default,,0,0,0,,Мм... А, шоколад.
Dialogue: 0,0:05:41.85,0:05:42.84,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:05:43.85,0:05:48.02,Default,,0,0,0,,Адачи сатып алғанша біреуге жасырын берсең, бұл айырбас емес, солай ма?
Dialogue: 0,0:05:50.93,0:05:51.56,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:05:51.93,0:05:56.05,Default,,0,0,0,,<Мен Шимамураның итімін деп ойлаймын>
Dialogue: 0,0:05:59.61,0:06:01.46,Default,,0,0,0,,Әй, енді ойлап қарасам, Адачи
Dialogue: 0,0:06:02.08,0:06:04.76,Default,,0,0,0,,Бүгін қытай көйлегін өзгерту керек пе?
Dialogue: 0,0:06:06.45,0:06:09.85,Default,,0,0,0,,Қытай...Иә, Рождестводағы сияқты.
Dialogue: 0,0:06:15.11,0:06:19.12,Default,,0,0,0,,《Егер Шимамураны көргің келсе, киіміңді ауыстыра аласың》
Dialogue: 0,0:06:21.46,0:06:24.83,Default,,0,0,0,,Шимамура жақсы десең...
Dialogue: 0,0:06:25.23,0:06:28.74,Default,,0,0,0,,А, жоқ, әлі де кеш емес.
Dialogue: 0,0:06:30.05,0:06:32.48,Default,,0,0,0,,Егер сіз осылай жүгірсеңіз, пойызды қуып жете аласыз.
Dialogue: 0,0:06:32.48,0:06:32.90,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,0:06:33.54,0:06:35.33,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:06:37.09,0:06:39.11,Default,,0,0,0,,Үзіліс
Dialogue: 0,0:06:39.70,0:06:42.15,Default,,0,0,0,,Тасымалдау уақыты келгенін білдіңіз.
Dialogue: 0,0:06:42.50,0:06:43.36,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:06:44.45,0:06:47.66,Default,,0,0,0,,Тойохашиге бара жатқан пойыз 4-платформадан шығады.
Dialogue: 0,0:06:46.30,0:06:47.97,Default,,0,0,0,,Тезірек, Адачи!
Dialogue: 0,0:06:48.00,0:06:50.23,Default,,0,0,0,,Есіктерді жабудан сақ болыңыз
Dialogue: 0,0:06:55.60,0:06:58.36,Default,,0,0,0,,Сіз оны уақытында орындадыңыз, бірақ әрең.
Dialogue: 0,0:06:59.62,0:07:00.28,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:01.81,0:07:05.25,Default,,0,0,0,,О, бір ғана бос орын бар.
Dialogue: 0,0:07:08.78,0:07:11.12,Default,,0,0,0,,А, Адачи, неге отырмайсың?
Dialogue: 0,0:07:11.32,0:07:12.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:12.26,0:07:14.53,Default,,0,0,0,,Жақсы, мен оны Шимамураға беремін.
Dialogue: 0,0:07:14.93,0:07:17.36,Default,,0,0,0,,Жоқ, Адачи жақсырақ.
Dialogue: 0,0:07:18.12,0:07:19.70,Default,,0,0,0,,Мен сабақ кезінде ұйықтадым.
Dialogue: 0,0:07:20.13,0:07:23.54,Default,,0,0,0,,Иә, бұл...
Dialogue: 0,0:07:24.00,0:07:26.78,Default,,0,0,0,,Аа, мен шынымен ұйықтап қалдым.
Dialogue: 0,0:07:26.86,0:07:27.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:28.06,0:07:31.22,Default,,0,0,0,,Жарайды... онда отыруға рұқсат етіңіз.
Dialogue: 0,0:07:33.67,0:07:34.29,Default,,0,0,0,,Осымен
Dialogue: 0,0:07:34.63,0:07:35.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:35.39,0:07:39.16,Default,,0,0,0,,Мен кездейсоқ күлкілі болып көрінемін бе?
Dialogue: 0,0:07:39.77,0:07:40.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:42.02,0:07:44.71,Default,,0,0,0,,Ахахахаха
Dialogue: 0,0:07:44.71,0:07:46.61,Default,,0,0,0,,Эй, эй, Шимамура?
Dialogue: 0,0:07:46.61,0:07:48.31,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,0:07:48.77,0:07:51.69,Default,,0,0,0,,Нагояға жету үшін шамамен 20 минут кетеді, солай ма?
Dialogue: 0,0:07:52.08,0:07:54.45,Default,,0,0,0,,Осы уақыт ішінде қызықсыз деп ойламайсыз ба?
Dialogue: 0,0:07:54.90,0:07:57.10,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:07:57.33,0:08:00.13,Default,,0,0,0,,Олай болса, шириторимен айналысқыңыз келе ме?
Dialogue: 0,0:08:00.69,0:08:02.61,Default,,0,0,0,,Ширитори... Жақсы
Dialogue: 0,0:08:02.82,0:08:04.94,Default,,0,0,0,,Олай болса, алма!
Dialogue: 0,0:08:05.58,0:08:09.09,Default,,0,0,0,,Бар... жүр... Гомоку соба
Dialogue: 0,0:08:09.71,0:08:11.06,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:08:11.70,0:08:14.49,Default,,0,0,0,,Ба…ба…баскетбол
Dialogue: 0,0:08:15.33,0:08:18.04,Default,,0,0,0,,...
Dialogue: 0,0:08:18.40,0:08:22.03,Default,,0,0,0,,Луи... сондықтан ащы Адачи
Dialogue: 0,0:08:25.78,0:08:27.39,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:08:28.11,0:08:29.29,Default,,0,0,0,,Олай болса, балмұздақ.
Dialogue: 0,0:08:29.96,0:08:33.86,Default,,0,0,0,,Су… Су… Су…
Dialogue: 0,0:08:33.86,0:08:36.72,Default,,0,0,0,,５ ４
Dialogue: 0,0:08:36.72,0:08:37.23,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:08:44.56,0:08:45.44,Default,,0,0,0,,<Like>
Dialogue: 0,0:08:46.67,0:08:49.20,Default,,0,0,0,,２ １
Dialogue: 0,0:08:48.28,0:08:50.26,Default,,0,0,0,,Су... Су... Өте өкінішті!
Dialogue: 0,0:08:54.36,0:08:55.75,Default,,0,0,0,,Не? Яғни
Dialogue: 0,0:08:55.89,0:09:00.23,Default,,0,0,0,,Су... Су... Су... Суғақия
Dialogue: 0,0:09:00.67,0:09:01.92,Default,,0,0,0,,Әй, сен мені тістеп алдың ба?
Dialogue: 0,0:09:03.57,0:09:05.49,Default,,0,0,0,,<Сугакияға рахмет>
Dialogue: 0,0:09:05.81,0:09:07.97,Default,,0,0,0,,Нагоя Нагоя
Dialogue: 0,0:09:08.49,0:09:10.67,Default,,0,0,0,,Көлікте жүктеріңізді ұмытпаңыз...
Dialogue: 0,0:09:11.39,0:09:14.30,Default,,0,0,0,,О~ Сызық бар~
Dialogue: 0,0:09:15.43,0:09:17.05,Default,,0,0,0,,Ол жерде жақсы емес пе?
Dialogue: 0,0:09:17.05,0:09:17.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:18.13,0:09:20.60,Default,,0,0,0,,Сапқа тұрсаңыз, Шимамура сізді күтуге мәжбүр етеді.
Dialogue: 0,0:09:20.66,0:09:22.01,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:23.54,0:09:25.54,Default,,0,0,0,,Жақсы, бәрібір.
Dialogue: 0,0:09:26.64,0:09:30.35,Default,,0,0,0,,Келесі жолы Ширитори ойнаудың орнына уақытты өлтіру үшін не істеуім керек?
Dialogue: 0,0:09:30.53,0:09:35.40,Default,,0,0,0,,Әй, анау... ю... саусақ күресі ме, әлде бірдеңе.
Dialogue: 0,0:09:36.14,0:09:37.70,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:09:38.34,0:09:39.25,Default,,0,0,0,,Иә
Dialogue: 0,0:09:46.79,0:09:50.40,Default,,0,0,0,,11 жеңіс, 3 жеңіліс, менің жеңісім~
Dialogue: 0,0:09:50.88,0:09:54.56,Default,,0,0,0,,Жарайды, бұл таң қаларлықтай отты, солай емес пе? Саусақ күресі
Dialogue: 0,0:09:55.03,0:09:55.49,Default,,0,0,0,,Иә
Dialogue: 0,0:09:57.99,0:10:01.04,Default,,0,0,0,,<Бір себептермен Шимамура бүгін үнемі күліп отырды>
Dialogue: 0,0:10:01.43,0:10:03.28,Default,,0,0,0,,<Бұл әр кезде қиын>
Dialogue: 0,0:10:04.12,0:10:05.57,Default,,0,0,0,,<Сол күлкіні көргенде>
Dialogue: 0,0:10:05.75,0:10:09.25,Default,,0,0,0,,<Себебі мен щектерім жалаңаш және босаңсуды тоқтатуым керек>
Dialogue: 0,0:10:10.69,0:10:11.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:12.12,0:10:13.92,Default,,0,0,0,,Содан кейін мен егжей-тегжейлерді ашамын.
Dialogue: 0,0:10:18.38,0:10:21.15,Default,,0,0,0,,Иә, бұл Валентин шоколады.
Dialogue: 0,0:10:23.72,0:10:26.88,Default,,0,0,0,,Мен де кеше осы жерден сатып алдым.
Dialogue: 0,0:10:35.70,0:10:36.21,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:37.36,0:10:38.44,Default,,0,0,0,,Өл, қарт жезөкше!
Dialogue: 0,0:10:38.96,0:10:40.82,Default,,0,0,0,,Ah, hello?
Dialogue: 0,0:10:42.19,0:10:43.43,Default,,0,0,0,,Қайсысы да жақсы.
Dialogue: 0,0:10:44.12,0:10:44.74,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:45.24,0:10:47.27,Default,,0,0,0,,арқылы сатып алу бар ма?
Dialogue: 0,0:10:47.80,0:10:48.49,Default,,0,0,0,,Шоколад
Dialogue: 0,0:10:48.87,0:10:49.57,Default,,0,0,0,,Иә
Dialogue: 0,0:10:49.77,0:10:51.49,Default,,0,0,0,,Шима-чан, сенің жігітің бар ма?
Dialogue: 0,0:10:51.78,0:10:55.45,Default,,0,0,0,,Жоқ, мен жай ғана досыма бір нәрсе сатып алайын деп жатырмын.
Dialogue: 0,0:10:56.80,0:10:57.68,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:59.41,0:11:00.07,Default,,0,0,0,,Иә
Dialogue: 0,0:11:02.26,0:11:03.28,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:11:05.49,0:11:09.98,Default,,0,0,0,,Тойохашиге бара жатқан пойыз жақында 4-платформадан шығады.
Dialogue: 0,0:11:09.98,0:11:13.08,Default,,0,0,0,,Есіктерді жабудан сақ болыңыз
Dialogue: 0,0:11:19.53,0:11:20.97,Default,,0,0,0,,Жақын болды.
Dialogue: 0,0:11:21.54,0:11:23.09,Default,,0,0,0,,Иә, әрең.
Dialogue: 0,0:11:24.09,0:11:25.68,Default,,0,0,0,,Бір орын бар.
Dialogue: 0,0:11:26.24,0:11:27.41,Default,,0,0,0,,А... иә
Dialogue: 0,0:11:29.41,0:11:30.69,Default,,0,0,0,,Отырсам ше? Шима-чан, неге отырмайсың?
Dialogue: 0,0:11:31.06,0:11:31.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:33.57,0:11:35.16,Default,,0,0,0,,Олай болса отырайын ба?
Dialogue: 0,0:11:35.60,0:11:35.94,Default,,0,0,0,,Иә
Dialogue: 0,0:11:46.53,0:11:49.49,Default,,0,0,0,,Мм, жоғары сынып оқушылары... солай ма?
Dialogue: 0,0:11:50.59,0:11:50.94,Default,,0,0,0,,Не? Күшік…
Dialogue: 0,0:11:53.69,0:11:56.22,Default,,0,0,0,,Әй, біркелкі сөмке
Dialogue: 0,0:11:56.84,0:11:57.74,Default,,0,0,0,,Бірақ
Dialogue: 0,0:11:58.12,0:12:00.68,Default,,0,0,0,,Шима-чан да орта мектеп оқушысы ма?
Dialogue: 0,0:12:01.13,0:12:04.53,Default,,0,0,0,,Солай ма? Сіз мектепке дұрыс барасыз ба?
Dialogue: 0,0:12:05.22,0:12:09.51,Default,,0,0,0,,Әділ, Шима-чанның ақыл-ойы жартыкеш сияқты.
Dialogue: 0,0:12:09.89,0:12:13.26,Default,,0,0,0,,Ал, мен не істеймін деп ойлаймын.
Dialogue: 0,0:12:16.98,0:12:18.84,Default,,0,0,0,,Айтпақшы, Сашима-чан
Dialogue: 0,0:12:19.38,0:12:19.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:20.09,0:12:23.22,Default,,0,0,0,,Кішкентай кезіңде мені қалай атадың?
Dialogue: 0,0:12:24.00,0:12:24.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:25.68,0:12:29.32,Default,,0,0,0,,《Күте~ Шима-чан》
Dialogue: 0,0:12:29.66,0:12:31.73,Default,,0,0,0,,《Шимачан》
Dialogue: 0,0:12:42.65,0:12:45.09,Default,,0,0,0,,Жүр, ұмытып кетіппін.
Dialogue: 0,0:12:48.76,0:12:49.54,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:51.63,0:12:54.50,Default,,0,0,0,,Шима-чан бұрынғыдан көп өзгерді.
Dialogue: 0,0:12:58.59,0:12:59.82,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:13:02.50,0:13:05.47,Default,,0,0,0,,<Мен өзгеріп қана қойған жоқпын, бұрынғыдаймын>
Dialogue: 0,0:13:05.78,0:13:07.47,Default,,0,0,0,,...
Dialogue: 0,0:13:08.53,0:13:11.17,Default,,0,0,0,,＜Таңғажайып жарқын және мейірімді＞
Dialogue: 0,0:13:11.72,0:13:12.89,Default,,0,0,0,,<Ақымақ және еркін>
Dialogue: 0,0:13:13.76,0:13:17.22,Default,,0,0,0,,<Таруми менің осындай болатынымды күтті ме?>
Dialogue: 0,0:13:17.99,0:13:21.48,Default,,0,0,0,,Әй, мұнда кісі өлтіру болғаны есіңде ме?
Dialogue: 0,0:13:21.80,0:13:23.55,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,0:13:24.15,0:13:25.51,Default,,0,0,0,,Иә, болды.
Dialogue: 0,0:13:26.27,0:13:27.65,Default,,0,0,0,,Қала қорқынышты
Dialogue: 0,0:13:27.69,0:13:28.90,Default,,0,0,0,,Күміс шашты жарты эльф
Dialogue: 0,0:13:31.22,0:13:35.20,Default,,0,0,0,,<Сондықтан Тарумимен бұлай болу ыңғайсыз.>
Dialogue: 0,0:13:35.97,0:13:38.90,Default,,0,0,0,,<Бұл сәл басқаша, бірақ мен өзімді Адачи сияқты сезінемін.>
Dialogue: 0,0:13:39.89,0:13:44.64,Default,,0,0,0,,＜Иә, шындық естеліктер сияқты оңай өзгермейді＞
Dialogue: 0,0:13:48.10,0:13:50.84,Default,,0,0,0,,Мен де кеше осы жерден сатып алдым.
Dialogue: 0,0:13:51.45,0:13:52.88,Default,,0,0,0,,Аа, дұрыс...
Dialogue: 0,0:13:53.75,0:13:55.27,Default,,0,0,0,,Иә? иә? ?
Dialogue: 0,0:13:56.26,0:13:57.97,Default,,0,0,0,,Ендеше, алмасайық.
Dialogue: 0,0:13:58.85,0:14:00.85,Default,,0,0,0,,Иә, құттықтаймын
Dialogue: 0,0:14:01.95,0:14:03.09,Default,,0,0,0,,Құттықтаймыз ба?
Dialogue: 0,0:14:03.74,0:14:06.20,Default,,0,0,0,,Олай болса... онда құттықтаймын.
Dialogue: 0,0:14:07.53,0:14:10.18,Default,,0,0,0,,Үйде көрме, ерте же.
Dialogue: 0,0:14:15.28,0:14:18.08,Default,,0,0,0,,А, қазір тамақтанайық!
Dialogue: 0,0:14:18.18,0:14:18.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:19.15,0:14:20.24,Default,,0,0,0,,Енді осындасыз ба?
Dialogue: 0,0:14:20.37,0:14:21.91,Default,,0,0,0,,Иә, қазір
Dialogue: 0,0:14:22.84,0:14:25.05,Default,,0,0,0,,Бұл өте жылдам.
Dialogue: 0,0:14:34.84,0:14:36.24,Default,,0,0,0,,Иә, өте дәмді!
Dialogue: 0,0:14:37.57,0:14:39.03,Default,,0,0,0,,Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,0:14:39.94,0:14:42.11,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:14:42.54,0:14:43.84,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:54.63,0:14:55.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:56.61,0:14:58.66,Default,,0,0,0,,Жарайды, мен солай ойлаймын.
Dialogue: 0,0:15:03.68,0:15:06.20,Default,,0,0,0,,<Күдік тудырудың басқа жолы бар ма?>
Dialogue: 0,0:15:10.16,0:15:12.82,Default,,0,0,0,,Сіз де Шимамураның біреуін жеп көргіңіз келе ме?
Dialogue: 0,0:15:13.42,0:15:15.33,Default,,0,0,0,,Жарайды, мен біреуін аламын деп ойлаймын.
Dialogue: 0,0:15:20.96,0:15:23.17,Default,,0,0,0,,Иә, а... а...
Dialogue: 0,0:15:30.48,0:15:31.73,Default,,0,0,0,,А, онда...
Dialogue: 0,0:15:44.50,0:15:46.82,Default,,0,0,0,,Иә, бұл дәмді.
Dialogue: 0,0:15:47.55,0:15:48.17,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:15:49.13,0:15:49.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:51.90,0:15:53.20,Default,,0,0,0,,(Сувенир дүкенінің иесі) Хмм… (Турист 1) Ә?
Dialogue: 0,0:15:54.18,0:15:54.93,Default,,0,0,0,,Не?
Dialogue: 0,0:15:55.78,0:15:57.68,Default,,0,0,0,,Бәрібір барайық.
Dialogue: 0,0:16:03.15,0:16:05.31,Default,,0,0,0,,Жарайды, бар.
Dialogue: 0,0:16:06.10,0:16:07.94,Default,,0,0,0,,Ол сағат 6-да басталуы керек.
Dialogue: 0,0:16:08.33,0:16:09.06,Default,,0,0,0,,Не?
Dialogue: 0,0:16:09.62,0:16:09.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:10.91,0:16:13.34,Default,,0,0,0,,Басталды, кеттік! Адачи
Dialogue: 0,0:16:13.54,0:16:14.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:18.42,0:16:20.19,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:16:39.51,0:16:40.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:48.99,0:16:49.81,Default,,0,0,0,,Шима-чан?
Dialogue: 0,0:16:50.82,0:16:52.74,Default,,0,0,0,,Аа, кешіріңіз. Сонда мен үйге барайын ба?
Dialogue: 0,0:16:54.39,0:16:54.77,Default,,0,0,0,,Иә
Dialogue: 0,0:16:56.33,0:17:00.33,Default,,0,0,0,,<Менің ойымша, ол шын мәнінде көп нәрсені асыға күтті>
Dialogue: 0,0:17:01.17,0:17:04.07,Default,,0,0,0,,<Менің ойымша, бірдеңе болуы керек еді>
Dialogue: 0,0:17:05.15,0:17:10.44,Default,,0,0,0,,<Алайда, шын мәнінде, сізді жайсыз сезінетін ауыр атмосфера ғана бар.>
Dialogue: 0,0:17:11.52,0:17:13.97,Default,,0,0,0,,<Мүмкін мен кінәлі шығармын>
Dialogue: 0,0:17:23.27,0:17:24.07,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:24.85,0:17:26.58,Default,,0,0,0,,Иә? Жоқ... иә
Dialogue: 0,0:17:31.31,0:17:32.96,Default,,0,0,0,,Содан кейін мұнда
Dialogue: 0,0:17:33.69,0:17:35.44,Default,,0,0,0,,Бүгін кездеспегенім үшін кешіріңіз.
Dialogue: 0,0:17:36.32,0:17:37.67,Default,,0,0,0,,А... иә
Dialogue: 0,0:17:39.19,0:17:41.08,Default,,0,0,0,,Сонда кездескенше.
Dialogue: 0,0:17:42.64,0:17:44.32,Default,,0,0,0,,<Қайнауға болмайтын нәрселер бар>
Dialogue: 0,0:17:45.93,0:17:47.43,Default,,0,0,0,,＜＞
Dialogue: 0,0:17:48.95,0:17:51.55,Default,,0,0,0,,<Мұндай жағдайда не істеу керек>
Dialogue: 0,0:17:52.37,0:17:55.70,Default,,0,0,0,,《Кішкентай кезіңде мені қалай атадың? 》
Dialogue: 0,0:17:56.74,0:17:58.19,Default,,0,0,0,,Ммм мммммм
Dialogue: 0,0:18:03.88,0:18:05.30,Default,,0,0,0,,Таручан
Dialogue: 0,0:18:13.24,0:18:17.06,Default,,0,0,0,,～
Dialogue: 0,0:18:19.17,0:18:20.53,Default,,0,0,0,,Жақында кездескенше~
Dialogue: 0,0:18:22.73,0:18:25.31,Default,,0,0,0,,<Мен сыйлықты лақтыра алмаймын>
Dialogue: 0,0:18:25.85,0:18:28.74,Default,,0,0,0,,<Адам өзін оңай өзгерте алмайды>
Dialogue: 0,0:18:29.86,0:18:34.10,Default,,0,0,0,,Жақында кездескенше! Шима-чан
Dialogue: 0,0:18:35.37,0:18:38.48,Default,,0,0,0,,<Өйткені менің өткен өмірім тікенмен байланысты>
Dialogue: 0,0:18:39.41,0:18:43.68,Default,,0,0,0,,<Егер мен саған тиіп кетсем, сол кездегі пісіп-жетілмеген мінезім мені ренжітеді.>
Dialogue: 0,0:18:44.40,0:18:45.12,Default,,0,0,0,,<Әлі>
Dialogue: 0,0:18:46.04,0:18:49.52,Default,,0,0,0,,＜＞
Dialogue: 0,0:18:50.80,0:18:53.81,Default,,0,0,0,,<Тікен тесіп, қан төксе де>
Dialogue: 0,0:19:03.38,0:19:05.52,Default,,0,0,0,,Шимамура Шимамура ма?
Dialogue: 0,0:19:05.89,0:19:10.21,Default,,0,0,0,,...
Dialogue: 0,0:19:10.85,0:19:13.35,Default,,0,0,0,,Мен оны сол науқанда жібердім.
Dialogue: 0,0:19:14.85,0:19:18.08,Default,,0,0,0,,《Бүгінгі кілт сөзі – D~! 》
Dialogue: 0,0:19:18.61,0:19:21.04,Default,,0,0,0,,...
Dialogue: 0,0:19:21.04,0:19:23.40,Default,,0,0,0,,Қауіпсіз мазмұнға Ah...
Dialogue: 0,0:19:23.82,0:19:26.72,Default,,0,0,0,,Бітті ме? Мен асығып тұрмын.
Dialogue: 0,0:19:27.30,0:19:27.95,Default,,0,0,0,,Ум...
Dialogue: 0,0:19:28.29,0:19:28.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:29.29,0:19:32.50,Default,,0,0,0,,Дос болу қандай сезімде болады?
Dialogue: 0,0:19:33.06,0:19:37.34,Default,,0,0,0,,Не? Қандай сезімде болсақ та, біз жақсы араласамыз.
Dialogue: 0,0:19:37.70,0:19:39.99,Default,,0,0,0,,Нақты мысал...
Dialogue: 0,0:19:40.71,0:19:45.00,Default,,0,0,0,,Бағыт, дәлірек айтсақ... достық.
Dialogue: 0,0:19:47.57,0:19:48.39,Default,,0,0,0,,Уау, олар керемет көрінеді!
Dialogue: 0,0:19:50.36,0:19:51.36,Default,,0,0,0,,Бұл ұнайды ма?
Dialogue: 0,0:19:52.91,0:19:55.98,Default,,0,0,0,,А... Иә, солай.
Dialogue: 0,0:19:57.83,0:19:58.85,Default,,0,0,0,,Хаха... Ия
Dialogue: 0,0:19:59.35,0:20:02.33,Default,,0,0,0,,Бірақ оны Адачи ретінде қарастырсақ, бұл жақсы сәйкес болуы мүмкін.
Dialogue: 0,0:20:03.03,0:20:03.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:04.51,0:20:06.43,Default,,0,0,0,,Науқанға өтініш бергенде
Dialogue: 0,0:20:07.01,0:20:09.33,Default,,0,0,0,,Ойымда кенет Адачидің жүзі пайда болды.
Dialogue: 0,0:20:09.68,0:20:11.60,Default,,0,0,0,,Мен осылай хабарлама жасауға тырыстым.
Dialogue: 0,0:20:17.87,0:20:21.45,Default,,0,0,0,,Иә? ше?
Dialogue: 0,0:20:31.48,0:20:32.26,Default,,0,0,0,,Адачи?
Dialogue: 0,0:20:43.46,0:20:45.22,Default,,0,0,0,,Не... кенеттен?
Dialogue: 0,0:20:46.11,0:20:49.57,Default,,0,0,0,,Кешіріңіз... Кешіріңіз, таң қалдым.
Dialogue: 0,0:20:50.03,0:20:51.89,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:52.48,0:20:54.77,Default,,0,0,0,,Біреуді үндеместен кенет құшақтауға тыйым салынады!
Dialogue: 0,0:20:55.60,0:20:56.88,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:20:58.19,0:21:00.21,Default,,0,0,0,,Иә? Бұл жақсы ма?
Dialogue: 0,0:21:01.02,0:21:01.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:01.89,0:21:05.95,Default,,0,0,0,,Жарайды, рұқсат алсаң, онда...
Dialogue: 0,0:21:06.70,0:21:08.71,Default,,0,0,0,,Не, мені құшақтағың келе ме?
Dialogue: 0,0:21:12.03,0:21:12.58,Default,,0,0,0,,Иә
Dialogue: 0,0:21:14.21,0:21:16.72,Default,,0,0,0,,Неге?
Dialogue: 0,0:21:17.31,0:21:19.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:20.28,0:21:23.17,Default,,0,0,0,,Ум, бұл...
Dialogue: 0,0:21:23.73,0:21:25.91,Default,,0,0,0,,Жылы...
Dialogue: 0,0:21:28.29,0:21:29.64,Default,,0,0,0,,А... Жылы болайық!
Dialogue: 0,0:21:30.69,0:21:31.91,Default,,0,0,0,,Хмм.
Dialogue: 0,0:21:35.93,0:21:37.12,Default,,0,0,0,,Әй, қой, маңызды емес.
Dialogue: 0,0:21:37.85,0:21:39.81,Default,,0,0,0,,Жарайды, келіңдер! Алақай!
Dialogue: 0,0:21:52.27,0:21:54.42,Default,,0,0,0,,тармақ～
Dialogue: 0,0:21:55.97,0:22:02.05,Default,,0,0,0,,Жарайды... жарайды, менің ойымша, біз жақсы араласамыз.
Dialogue: 0,0:22:03.01,0:22:06.96,Default,,0,0,0,,Адачи арық, сондықтан ол жылынбайды.
Dialogue: 0,0:22:10.00,0:22:13.33,Default,,0,0,0,,<Айналаңыздағылар сізді біртүрлі деп ойлай ма?>
Dialogue: 0,0:22:14.04,0:22:15.48,Default,,0,0,0,,<Маған күлесің бе?>
Dialogue: 0,0:22:16.34,0:22:18.93,Default,,0,0,0,,<Мен Шимамураны ғана көремін>
Dialogue: 0,0:22:19.60,0:22:22.77,Default,,0,0,0,,<Рұқсат етілген жер ең жақсы болды>
Dialogue: 0,0:22:23.66,0:22:26.37,Default,,0,0,0,,<Мен іздегенім осы болды>
Dialogue: 0,0:23:58.68,0:24:00.63,Default,,0,0,0,,Адашимапедия Валентин
Dialogue: 0,0:24:00.85,0:24:03.59,Default,,0,0,0,,Біз Онику но Нагатода Әулие Валентин күні жәрмеңкесін де бастадық.
Dialogue: 0,0:24:03.59,0:24:04.87,Default,,0,0,0,,Шоколад қосылған крокеттерді де сатасыз ба?
Dialogue: 0,0:24:04.87,0:24:06.38,Default,,0,0,0,,Мен ондай ақымақтық жасамаймын.
Dialogue: 0,0:24:06.38,0:24:09.26,Default,,0,0,0,,Өзіңізді қызықтыратын жігіттің жүрегін жаулап алыңыз. Хатсуда үлкен сатылым!
Dialogue: 0,0:24:09.26,0:24:11.37,Default,,0,0,0,,Егер қыз кенеттен сізге гормон берсе, сіз қалай сезінер едіңіз?
Dialogue: 0,0:24:11.37,0:24:12.58,Default,,0,0,0,,Бүгін түнде гриль ет!
Dialogue: 0,0:24:14.08,0:24:20.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
