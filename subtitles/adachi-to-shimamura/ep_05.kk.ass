Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:25.71,0:01:32.74,Default,,0,0,0,,Бұл дүниеде сені кездестірген күннен бастап мен нұрлана бастадым.
Dialogue: 0,0:01:32.74,0:01:40.39,Default,,0,0,0,,Әрқайсысын орындай аламын ба деп ойлаймын, қасымда бол
Dialogue: 0,0:01:49.87,0:01:57.47,Default,,0,0,0,,Қайда жүрсем де, болашақты көре алмаймын, бұл одан да қызықсыз жарық
Dialogue: 0,0:01:57.60,0:02:04.88,Default,,0,0,0,,Күн сәулесінде тербеліп, ерекше жерге бірге тығылдық.
Dialogue: 0,0:02:04.96,0:02:12.41,Default,,0,0,0,,Сіз біршама қашықтықты күтесіз бе?
Dialogue: 0,0:02:12.41,0:02:19.49,Default,,0,0,0,,Әрқашан ренжітеді, мені тастамашы
Dialogue: 0,0:02:19.49,0:02:26.88,Default,,0,0,0,,Сенің бұл дүниеде жүргенің мені біртүрлі ғашық етеді.
Dialogue: 0,0:02:26.88,0:02:35.44,Default,,0,0,0,,Мен әрқайсысын орындай аламын ба? Жаңа жел соққан сайын
Dialogue: 0,0:02:35.44,0:02:41.68,Default,,0,0,0,,Мен қатты құлап кетсем де, ұйықтай алмаймын, мен сенімдімін
Dialogue: 0,0:02:41.68,0:02:51.43,Default,,0,0,0,,Бір қадам бастым, Түзу аспаннан жүгіргім келеді, екеуміз.
Dialogue: 0,0:01:25.71,0:01:32.74,Default,,0,0,0,,...
Dialogue: 0,0:01:32.74,0:01:40.39,Default,,0,0,0,,Жеке тілектер мүмкін немесе мүмкін емес.
Dialogue: 0,0:01:49.87,0:01:57.47,Default,,0,0,0,,Болашақ көрінбейді.
Dialogue: 0,0:01:57.60,0:02:04.88,Default,,0,0,0,,Күн сәулесін сезінетін сирек кездесетін және сирек кездесетін жер
Dialogue: 0,0:02:04.96,0:02:12.41,Default,,0,0,0,,Сіз жолдан бір нүкте қашықтықтасыз ба?
Dialogue: 0,0:02:12.41,0:02:19.49,Default,,0,0,0,,Кез келген уақытта оқудың қажеті жоқ.
Dialogue: 0,0:02:19.49,0:02:26.88,Default,,0,0,0,,Дүниеде сен түсіне алмайтын жол бар.
Dialogue: 0,0:02:26.88,0:02:35.44,Default,,0,0,0,,Әрбір жеке тілектің мүмкіндігі немесе сәтсіздігі Бұл жаңа микро жел соғады
Dialogue: 0,0:02:35.44,0:02:41.68,Default,,0,0,0,,Экспозицияға жол берілмейді
Dialogue: 0,0:02:41.68,0:02:51.43,Default,,0,0,0,,Аспанға қарай жүргенде ойлану
Dialogue: 0,0:00:14.26,0:00:15.22,Default,,0,0,0,,Шимамура
Dialogue: 0,0:00:19.42,0:00:20.25,Default,,0,0,0,,Шимаму…
Dialogue: 0,0:00:20.25,0:00:22.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:30.06,0:00:32.70,Default,,0,0,0,,＜Рождествода Шимамурамен бірге сыртта серуендеу＞
Dialogue: 0,0:00:33.04,0:00:34.18,Default,,0,0,0,,<Бұл біртүрлі ме?>
Dialogue: 0,0:00:35.86,0:00:37.37,Default,,0,0,0,,<Симуляцияланған болса да>
Dialogue: 0,0:00:37.86,0:00:40.30,Default,,0,0,0,,<Менің ойыма біртүрлі көріністер ғана келеді>
Dialogue: 0,0:00:41.32,0:00:44.30,Default,,0,0,0,,<Соңғы уақытта гимназияның екінші қабаты суық болды>
Dialogue: 0,0:00:44.57,0:00:46.38,Default,,0,0,0,,<Мен енді аяғымды айналдыра алмаймын>
Dialogue: 0,0:00:47.32,0:00:48.84,Default,,0,0,0,,<Мен Шимамурамен кездескім келеді>
Dialogue: 0,0:00:49.87,0:00:53.28,Default,,0,0,0,,<Мен Шимамурамен ерекше уақыт өткізгім келеді>
Dialogue: 0,0:00:54.63,0:00:58.49,Default,,0,0,0,,<Егер мен оны орындайтын болсам, бұл Рождествоға болар еді деп ойлаймын.>
Dialogue: 0,0:00:59.58,0:01:03.41,Default,,0,0,0,,<Мәселе олардың Рождествоны шақыру үшін барын салуында болды.>
Dialogue: 0,0:01:10.36,0:01:12.27,Default,,0,0,0,,<Қаламның қысымы тым күшті болды ма?>
Dialogue: 0,0:01:12.98,0:01:15.15,Default,,0,0,0,,<Оны өшіргеннен кейін де аты әлсіз қалды>
Dialogue: 0,0:01:16.11,0:01:19.10,Default,,0,0,0,,<Қабағымды жұмып, ұйықтасам ертең келсе де>
Dialogue: 0,0:01:19.63,0:01:21.74,Default,,0,0,0,,<Мен кешегі Шимамураны ешқашан ұмытпаймын>
Dialogue: 0,0:01:22.09,0:01:23.13,Default,,0,0,0,,<Біраз ұқсас>
Dialogue: 0,0:02:56.23,0:02:58.54,Default,,0,0,0,,＜Егер Шимамура маған мұны сұраса＞
Dialogue: 0,0:02:58.89,0:03:00.90,Default,,0,0,0,,<Ол қанша уақытқа созылады деп ойлаймын>
Dialogue: 0,0:03:03.63,0:03:04.65,Default,,0,0,0,,《Сөмкені ұста》
Dialogue: 0,0:03:06.04,0:03:08.29,Default,,0,0,0,,<Жоқ, бұл бағыт емес>
Dialogue: 0,0:03:09.72,0:03:11.10,Default,,0,0,0,,《Құшақтау》
Dialogue: 0,0:03:12.39,0:03:14.51,Default,,0,0,0,,<Сіз барынша тырысасыз ба? Мен бар күшімді салатын шығармын>
Dialogue: 0,0:03:16.17,0:03:18.14,Default,,0,0,0,,《Бірге ұйықтап алайық》
Dialogue: 0,0:03:22.47,0:03:24.47,Default,,0,0,0,,＜Не? I>
Dialogue: 0,0:03:24.98,0:03:27.91,Default,,0,0,0,,<Шимамураны Рождествоға шақырғым келгені үшін қатты уайымдадым>
Dialogue: 0,0:03:28.42,0:03:30.27,Default,,0,0,0,,<Шетіне қарай ағашқа өрмелеу>
Dialogue: 0,0:03:30.44,0:03:33.18,Default,,0,0,0,,<Осылай түсе алмайтын сияқтымын>
Dialogue: 0,0:03:45.53,0:03:47.02,Default,,0,0,0,,Эй, Шимако-чан
Dialogue: 0,0:03:47.82,0:03:49.58,Default,,0,0,0,,Иә? Бірдеңе істеу керек пе?
Dialogue: 0,0:03:49.90,0:03:53.63,Default,,0,0,0,,Маған пайда жоқ, мен мұны істеуім керек пе?
Dialogue: 0,0:03:53.77,0:03:55.34,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:03:55.51,0:03:56.62,Default,,0,0,0,,Дана Дана
Dialogue: 0,0:03:58.28,0:03:59.75,Default,,0,0,0,,О, Адачий
Dialogue: 0,0:03:59.75,0:04:00.77,Default,,0,0,0,,Сіз оқисыз ба?
Dialogue: 0,0:04:01.11,0:04:02.71,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:02.94,0:04:04.60,Default,,0,0,0,,Не, істеп жатырсың ба?
Dialogue: 0,0:04:05.08,0:04:06.45,Default,,0,0,0,,Мен байсалдымын.
Dialogue: 0,0:04:07.57,0:04:09.24,Default,,0,0,0,,Е, а... бұл
Dialogue: 0,0:04:09.73,0:04:10.65,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:10.83,0:04:13.38,Default,,0,0,0,,Бүгін Нагато-нчиге тоқтаймыз ба?
Dialogue: 0,0:04:13.56,0:04:17.70,Default,,0,0,0,,Неге екені белгісіз, мен оны күнде котацудың қасынан көргендей боламын.
Dialogue: 0,0:04:17.70,0:04:19.22,Default,,0,0,0,,Ақылымның арқасында Менің ақылымның арқасында
Dialogue: 0,0:04:25.64,0:04:26.77,Default,,0,0,0,,Бір нәрсе үшін бе?
Dialogue: 0,0:04:27.57,0:04:28.60,Default,,0,0,0,,Жоқ Жоқ Жоқ
Dialogue: 0,0:04:29.06,0:04:30.55,Default,,0,0,0,,Иә, рефлексия
Dialogue: 0,0:04:30.98,0:04:33.27,Default,,0,0,0,,Хмм, не болды?
Dialogue: 0,0:04:33.73,0:04:36.05,Default,,0,0,0,,А, бұл ұқсас нәрсе ме?
Dialogue: 0,0:04:36.58,0:04:37.40,Default,,0,0,0,,Мен не айтайын?
Dialogue: 0,0:04:37.40,0:04:37.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:38.21,0:04:40.23,Default,,0,0,0,,Менен сұрасаң да...
Dialogue: 0,0:04:40.23,0:04:43.26,Default,,0,0,0,,Ал, мұны алдағы жұмысқа қалдырайық.
Dialogue: 0,0:04:44.17,0:04:46.34,Default,,0,0,0,,Адачи немен айналысады?
Dialogue: 0,0:04:46.54,0:04:48.44,Default,,0,0,0,,О, мм...
Dialogue: 0,0:04:53.05,0:04:54.06,Default,,0,0,0,,…
Dialogue: 0,0:04:54.24,0:04:54.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:56.20,0:04:57.25,Default,,0,0,0,,бірге
Dialogue: 0,0:04:57.96,0:04:59.93,Default,,0,0,0,,Оқу...
Dialogue: 0,0:05:00.49,0:05:01.53,Default,,0,0,0,,Оқу?
Dialogue: 0,0:05:01.95,0:05:03.42,Default,,0,0,0,,Олай болса, Хино және басқалар да сонда болады.
Dialogue: 0,0:05:03.85,0:05:05.26,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:05:05.66,0:05:08.30,Default,,0,0,0,,Өйткені олар бізге қарағанда жақсы баға алады.
Dialogue: 0,0:05:08.78,0:05:10.15,Default,,0,0,0,,Жақсы баға алсаңыз
Dialogue: 0,0:05:10.33,0:05:13.72,Default,,0,0,0,,Бірге оқудың пайдасы жоқ.
Dialogue: 0,0:05:14.24,0:05:15.04,Default,,0,0,0,,Ах~
Dialogue: 0,0:05:15.24,0:05:21.89,Default,,0,0,0,,Егер сіз Адачи болсаңыз, мені орташа ақымақ деп ойлайсыз, өйткені менің бағаларым Адачидікімен бірдей.
Dialogue: 0,0:05:23.00,0:05:24.37,Default,,0,0,0,,Аа...
Dialogue: 0,0:05:27.32,0:05:28.19,Default,,0,0,0,,Әзіл
Dialogue: 0,0:05:28.61,0:05:30.33,Default,,0,0,0,,Ендеше, екі адаммен жасайық.
Dialogue: 0,0:05:31.29,0:05:33.19,Default,,0,0,0,,Қайда? кітапхана?
Dialogue: 0,0:05:33.69,0:05:35.34,Default,,0,0,0,,Әлде отбасылық мейрамхана ма?
Dialogue: 0,0:05:35.90,0:05:37.23,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,0:05:37.50,0:05:39.51,Default,,0,0,0,,Үйге! Шимамураның үйі!
Dialogue: 0,0:05:41.22,0:05:42.52,Default,,0,0,0,,сияқты нәрсе дұрыс емес пе?
Dialogue: 0,0:05:42.85,0:05:45.13,Default,,0,0,0,,Иә, шаң басқан, солай емес пе?
Dialogue: 0,0:05:45.39,0:05:45.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:46.25,0:05:47.38,Default,,0,0,0,,Адачидің бөлмесі ше?
Dialogue: 0,0:05:47.95,0:05:49.25,Default,,0,0,0,,Менің бөлмем?
Dialogue: 0,0:05:52.36,0:05:53.85,Default,,0,0,0,,Мен кішкентаймын...
Dialogue: 0,0:05:53.85,0:05:56.60,Default,,0,0,0,,Мүмкін мен де жаман шығармын?
Dialogue: 0,0:05:57.05,0:05:57.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:57.97,0:05:58.46,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:59.02,0:06:00.29,Default,,0,0,0,,Менің үйімде де.
Dialogue: 0,0:06:00.56,0:06:02.42,Default,,0,0,0,,Бірақ шаң басқан
Dialogue: 0,0:06:04.33,0:06:05.26,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:05.45,0:06:06.97,Default,,0,0,0,,Мен... Мен қазір барамын.
Dialogue: 0,0:06:08.63,0:06:09.70,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:06:09.93,0:06:11.01,Default,,0,0,0,,Қайтадан қош келдіңіз~
Dialogue: 0,0:06:11.66,0:06:14.74,Default,,0,0,0,,Ой, достар? Ой үй...
Dialogue: 0,0:06:15.35,0:06:16.67,Default,,0,0,0,,Иә? Ой?
Dialogue: 0,0:06:17.50,0:06:18.92,Default,,0,0,0,,Бұл Адачи-чан ба?
Dialogue: 0,0:06:19.05,0:06:19.80,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:06:20.48,0:06:21.16,Default,,0,0,0,,Сәлем
Dialogue: 0,0:06:22.14,0:06:23.90,Default,,0,0,0,,Жүр, бөлмеге барайық.
Dialogue: 0,0:06:25.08,0:06:26.36,Default,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:06:28.33,0:06:30.38,Default,,0,0,0,,Е, бұл бөлме...
Dialogue: 0,0:06:34.43,0:06:35.59,Default,,0,0,0,,Адачи~
Dialogue: 0,0:06:37.43,0:06:38.22,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:06:38.58,0:06:40.30,Default,,0,0,0,,Оқу бөлмесі екінші қабатта.
Dialogue: 0,0:06:42.22,0:06:45.12,Default,,0,0,0,,Олардың ешқайсысы таң қалдырмайды.
Dialogue: 0,0:06:46.57,0:06:48.99,Default,,0,0,0,,Айтыңызшы!
Dialogue: 0,0:06:49.61,0:06:51.72,Default,,0,0,0,,Жарайды, бұл туралы не айтасыз!
Dialogue: 0,0:06:51.72,0:06:54.91,Default,,0,0,0,,Жаңа ет тұмарының кейіпкері Нагато!
Dialogue: 0,0:06:56.33,0:06:58.20,Default,,0,0,0,,Крокет-чан?
Dialogue: 0,0:06:58.99,0:07:00.20,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:07:01.39,0:07:03.24,Default,,0,0,0,,Оо, бұл жақсы емес пе?
Dialogue: 0,0:07:03.77,0:07:05.58,Default,,0,0,0,,Оны ерікті түрде атамаңыз.
Dialogue: 0,0:07:06.22,0:07:08.82,Default,,0,0,0,,Олай болса Хиноға сыйлық берейік.
Dialogue: 0,0:07:09.08,0:07:10.19,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:07:10.93,0:07:13.70,Default,,0,0,0,,Жоқ, Деко мен Шайнау тағы да?
Dialogue: 0,0:07:14.49,0:07:15.37,Default,,0,0,0,,Бұл сізге керек емес пе?
Dialogue: 0,0:07:18.06,0:07:20.82,Default,,0,0,0,,Жарайды, алайық.
Dialogue: 0,0:07:34.14,0:07:37.04,Default,,0,0,0,,Балалар сендер шынымен жақсы достарсыңдар.
Dialogue: 0,0:07:41.00,0:07:41.66,Default,,0,0,0,,Апай
Dialogue: 0,0:07:42.20,0:07:43.86,Default,,0,0,0,,Сіз апельсин жейсіз, солай ма?
Dialogue: 0,0:07:45.88,0:07:48.53,Default,,0,0,0,,Біз жақсы доспыз ба?
Dialogue: 0,0:07:49.43,0:07:50.74,Default,,0,0,0,,Бұл қалыпты жағдай емес пе?
Dialogue: 0,0:07:53.69,0:07:56.81,Default,,0,0,0,,Ал, кәдімгі, кәдімгі жақсы достар
Dialogue: 0,0:07:58.60,0:08:00.55,Default,,0,0,0,,Ух~ Саби Саби
Dialogue: 0,0:08:01.42,0:08:04.38,Default,,0,0,0,,Әй, шаң басып қалды дедің ғой.
Dialogue: 0,0:08:04.50,0:08:06.06,Default,,0,0,0,,Оқу бөлмесі
Dialogue: 0,0:08:07.97,0:08:12.41,Default,,0,0,0,,Мм, күн жылынғанша үзіліс жасаймын.
Dialogue: 0,0:08:13.55,0:08:17.00,Default,,0,0,0,,Адачи оқу кезінде музыка тыңдай ма?
Dialogue: 0,0:08:18.02,0:08:19.95,Default,,0,0,0,,Мм... Иә, мен оны біраз тыңдаймын.
Dialogue: 0,0:08:20.52,0:08:21.61,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:08:22.81,0:08:24.86,Default,,0,0,0,,Ум, бұл...
Dialogue: 0,0:08:25.22,0:08:25.80,Default,,0,0,0,,Хмм?
Dialogue: 0,0:08:27.05,0:08:28.53,Default,,0,0,0,,Кури Кури…
Dialogue: 0,0:08:30.78,0:08:33.91,Default,,0,0,0,,Шимамура қандай бала болды?
Dialogue: 0,0:08:34.33,0:08:35.78,Default,,0,0,0,,Хмм, қалыпты ма?
Dialogue: 0,0:08:36.65,0:08:40.05,Default,,0,0,0,,Мен өзімді үнемі мектептегі түскі ас комитетінде болғандай сезінемін...
Dialogue: 0,0:08:41.58,0:08:45.00,Default,,0,0,0,,А, менің шашым қазіргіден қысқарақ болған шығар.
Dialogue: 0,0:08:45.32,0:08:46.48,Default,,0,0,0,,Мен оны бояған жоқпын.
Dialogue: 0,0:08:47.98,0:08:51.35,Default,,0,0,0,,<Қысқа шаш жолақ, қара шаш>
Dialogue: 0,0:08:52.26,0:08:53.39,Default,,0,0,0,,Мен оны көргім келеді
Dialogue: 0,0:08:55.00,0:08:57.45,Default,,0,0,0,,Адачи ше? Ол қандай болды?
Dialogue: 0,0:08:57.89,0:08:59.61,Default,,0,0,0,,Ой...
Dialogue: 0,0:09:00.77,0:09:02.27,Default,,0,0,0,,Оның қазіргіден еш айырмашылығы болмауы мүмкін.
Dialogue: 0,0:09:02.76,0:09:04.88,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:04.88,0:09:08.01,Default,,0,0,0,,Мүмкін сіздің қолыңызды балабақша қызметкері немесе бірдеңе ұстаған шығар?
Dialogue: 0,0:09:09.58,0:09:12.09,Default,,0,0,0,,Мен олай айтқым келмейді.
Dialogue: 0,0:09:12.88,0:09:14.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:14.70,0:09:16.55,Default,,0,0,0,,Сонымен, ...
Dialogue: 0,0:09:16.83,0:09:18.93,Default,,0,0,0,,Өз серіктесіңізді мұқият таңдаңыз.
Dialogue: 0,0:09:21.45,0:09:23.29,Default,,0,0,0,,<Не айтып тұрсың?>
Dialogue: 0,0:09:23.40,0:09:25.98,Default,,0,0,0,,<Бұл дерлік мойындау сияқты, солай емес пе?>
Dialogue: 0,0:09:27.70,0:09:31.82,Default,,0,0,0,,Хмм, неге мен?
Dialogue: 0,0:09:45.02,0:09:47.10,Default,,0,0,0,,Мм, бұл туралы... а.
Dialogue: 0,0:09:52.82,0:09:56.39,Default,,0,0,0,,<Симамура, неге мен?> деді
Dialogue: 0,0:09:57.42,0:09:59.73,Default,,0,0,0,,<Неге не?>
Dialogue: 0,0:10:00.21,0:10:01.53,Default,,0,0,0,,<Бұл оңай>
Dialogue: 0,0:10:02.46,0:10:04.91,Default,,0,0,0,,<Себебі мен Шимамурамын>
Dialogue: 0,0:10:05.96,0:10:07.41,Default,,0,0,0,,<Егер сіз бұған жауап берсеңіз>
Dialogue: 0,0:10:07.82,0:10:12.95,Default,,0,0,0,,＜Мен Шимамураны қатты жақсы көретінімді айтамын＞
Dialogue: 0,0:10:13.85,0:10:14.36,Default,,0,0,0,,<Сонымен...>
Dialogue: 0,0:10:26.21,0:10:28.05,Default,,0,0,0,,<Жоқ, жоқ, сабыр сақта>
Dialogue: 0,0:10:28.33,0:10:29.77,Default,,0,0,0,,<Сүйіп тұрып оянсаң ше>
Dialogue: 0,0:10:31.01,0:10:33.05,Default,,0,0,0,,<Шынымен бітті>
Dialogue: 0,0:10:33.64,0:10:37.36,Default,,0,0,0,,<Оған қоса, мен сені сүйгім келмейді>
Dialogue: 0,0:10:38.18,0:10:42.20,Default,,0,0,0,,<Симамура маған жалынса, бұл өте мағыналы болар еді>
Dialogue: 0,0:10:42.44,0:10:43.51,Default,,0,0,0,,<Олай емес...>
Dialogue: 0,0:10:43.98,0:10:44.50,Default,,0,0,0,,Хмм?
Dialogue: 0,0:10:46.52,0:10:47.80,Default,,0,0,0,,Мені атыммен атап тұрсың ба?
Dialogue: 0,0:11:02.34,0:11:05.45,Default,,0,0,0,,Бұл жұмсақ және жақсырақ.
Dialogue: 0,0:11:07.97,0:11:09.93,Default,,0,0,0,,Сонымен... міне, солай.
Dialogue: 0,0:11:10.70,0:11:12.23,Default,,0,0,0,,Эй... ұйықтап жатырсың ба?
Dialogue: 0,0:11:13.34,0:11:15.04,Default,,0,0,0,,Мен ұйықтамаймын~
Dialogue: 0,0:11:17.64,0:11:19.41,Default,,0,0,0,,Иә, суық, солай емес пе?
Dialogue: 0,0:11:20.28,0:11:22.04,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:11:25.22,0:11:26.41,Default,,0,0,0,,Сәлем Шимамура
Dialogue: 0,0:11:27.20,0:11:27.74,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:28.48,0:11:31.08,Default,,0,0,0,,Шимамура...
Dialogue: 0,0:11:33.71,0:11:34.20,Default,,0,0,0,,Cre...
Dialogue: 0,0:11:36.70,0:11:38.59,Default,,0,0,0,,Рождествода не істеп жатырсың?
Dialogue: 0,0:11:39.60,0:11:41.90,Default,,0,0,0,,Кешкі асқа қуырылған тауық еті беріледі.
Dialogue: 0,0:11:42.94,0:11:44.24,Default,,0,0,0,,Және торт
Dialogue: 0,0:11:44.61,0:11:46.56,Default,,0,0,0,,Ал... олай емес.
Dialogue: 0,0:11:46.13,0:11:48.55,Default,,0,0,0,,Менің әпкем әлі күнге дейін Аяз атаға сенеді.
Dialogue: 0,0:11:50.19,0:11:51.52,Default,,0,0,0,,Аяз ата
Dialogue: 0,0:11:52.58,0:11:55.32,Default,,0,0,0,,Шимамура қанша жаста сенді?
Dialogue: 0,0:11:55.98,0:11:56.72,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:57.12,0:11:58.62,Default,,0,0,0,,Мен сенбеймін.
Dialogue: 0,0:11:59.29,0:12:02.16,Default,,0,0,0,,Жақсы аға деген адам жоқ емес пе?
Dialogue: 0,0:12:02.66,0:12:03.42,Default,,0,0,0,,Адачи ше?
Dialogue: 0,0:12:04.36,0:12:07.53,Default,,0,0,0,,Мен бұл балабақшадан біреу деп ойладым.
Dialogue: 0,0:12:08.31,0:12:09.34,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:09.58,0:12:14.01,Default,,0,0,0,,Менің ойымша, бұл Аяз ата туралы балабақшадағы ересектер ғана айтқан.
Dialogue: 0,0:12:14.57,0:12:17.50,Default,,0,0,0,,Бізде шынымен бірге балалар жоқ.
Dialogue: 0,0:12:17.85,0:12:18.51,Default,,0,0,0,,(Барлығы төрт адам) Һмм? (JoJo) Дерби?
Dialogue: 0,0:12:19.42,0:12:20.30,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:20.64,0:12:23.94,Default,,0,0,0,,Кішкентай кезімде мен одан бетер ақымақ, еркін болдым.
Dialogue: 0,0:12:24.22,0:12:26.88,Default,,0,0,0,,Мен осындай нәрселердің арқасында жақсы өмір сүрсем деп тілеймін.
Dialogue: 0,0:12:27.69,0:12:28.90,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:12:29.53,0:12:32.61,Default,,0,0,0,,Менің ойымша, оның иықтың қатаюына еш қатысы жоқ.
Dialogue: 0,0:12:34.84,0:12:35.93,Default,,0,0,0,,Шығу
Dialogue: 0,0:12:39.08,0:12:42.10,Default,,0,0,0,,<Мен әзірге Шимамурамен осылай қалғым келеді>
Dialogue: 0,0:12:42.81,0:12:45.71,Default,,0,0,0,,<Сүйікті баланы қорғаймын деп мамыққа орап алғандай>
Dialogue: 0,0:12:47.34,0:12:48.08,Default,,0,0,0,,<Болғанша>
Dialogue: 0,0:12:50.38,0:12:53.05,Default,,0,0,0,,<Адачи соңғы кездері біртүрлі әрекет етіп жүр>
Dialogue: 0,0:12:53.61,0:12:56.47,Default,,0,0,0,,<Біріншіден, біреудің көзқарасын сезіну саны артты>
Dialogue: 0,0:12:56.79,0:12:58.57,Default,,0,0,0,,<Ол бірінші қызық>
Dialogue: 0,0:12:59.95,0:13:00.89,Default,,0,0,0,,<Екіншіден>
Dialogue: 0,0:13:01.46,0:13:05.72,Default,,0,0,0,,<Сөйлесе отырып, мен бірдеңені ұстап тұрғандай сезінемін>
Dialogue: 0,0:13:06.17,0:13:08.88,Default,,0,0,0,,<Ернім бұлшықет ауырады ма?>
Dialogue: 0,0:13:11.21,0:13:12.15,Default,,0,0,0,,<3-ші>
Dialogue: 0,0:13:12.34,0:13:13.80,Default,,0,0,0,,Ши... Шимамура!
Dialogue: 0,0:13:15.09,0:13:17.29,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:17.93,0:13:18.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:19.21,0:13:20.61,Default,,0,0,0,,Дәретхана
Dialogue: 0,0:13:22.64,0:13:26.28,Default,,0,0,0,,<Оның тестілеудегі ағылшын тілі баллы менікінен жоғары болды>
Dialogue: 0,0:13:27.69,0:13:30.18,Default,,0,0,0,,<Үшіншісі маңызды емес болса да>
Dialogue: 0,0:13:31.03,0:13:32.03,Default,,0,0,0,,<Бірақ>
Dialogue: 0,0:13:42.64,0:13:44.25,Default,,0,0,0,,Айтатататата...
Dialogue: 0,0:13:44.25,0:13:45.22,Default,,0,0,0,,А, Шимамура?
Dialogue: 0,0:13:45.50,0:13:46.55,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,0:13:46.69,0:13:48.11,Default,,0,0,0,,Мен не істеп жатырсың?
Dialogue: 0,0:13:49.61,0:13:51.68,Default,,0,0,0,,Аздап көңіл көтеру
Dialogue: 0,0:13:51.68,0:13:52.94,Default,,0,0,0,,Одан да көп
Dialogue: 0,0:13:59.70,0:14:01.09,Default,,0,0,0,,А, бұл Шимамура?
Dialogue: 0,0:14:01.89,0:14:03.62,Default,,0,0,0,,Иә, терең тыныс ал.
Dialogue: 0,0:14:04.83,0:14:05.41,Default,,0,0,0,,Иә
Dialogue: 0,0:14:09.34,0:14:12.29,Default,,0,0,0,,Фуми Йо Адачи
Dialogue: 0,0:14:13.62,0:14:16.69,Default,,0,0,0,,Шимамураның маған қалыпты қоңырау шалғанын қалаймын.
Dialogue: 0,0:14:17.26,0:14:18.63,Default,,0,0,0,,Өзіңіз жайлы болыңыз
Dialogue: 0,0:14:19.08,0:14:21.62,Default,,0,0,0,,Бәлкім, бұл бүркеншік ат болғандықтан, мен енді ешқашан қолданбаймын.
Dialogue: 0,0:14:22.17,0:14:25.56,Default,,0,0,0,,-де? Мен соңғы уақытта бір нәрсені ойлап жүрмін.
Dialogue: 0,0:14:25.74,0:14:27.08,Default,,0,0,0,,Не?
Dialogue: 0,0:14:27.16,0:14:29.11,Default,,0,0,0,,Маған көп қарап тұрған сияқтысың.
Dialogue: 0,0:14:29.11,0:14:31.16,Default,,0,0,0,,Бұл болды ма?
Dialogue: 0,0:14:31.16,0:14:31.94,Default,,0,0,0,,Бар ма?
Dialogue: 0,0:14:33.55,0:14:35.43,Default,,0,0,0,,Айтқыңыз келетін нәрсе бар ма?
Dialogue: 0,0:14:37.46,0:14:39.05,Default,,0,0,0,,Болу керек
Dialogue: 0,0:14:39.63,0:14:41.75,Default,,0,0,0,,Хмм, сосын айтыңыз.
Dialogue: 0,0:14:41.75,0:14:46.57,Default,,0,0,0,,Мм... қыс немесе келесі аптада?
Dialogue: 0,0:14:46.98,0:14:49.15,Default,,0,0,0,,А... 10 күннен кейін?
Dialogue: 0,0:14:49.43,0:14:50.17,Default,,0,0,0,,10 күннен кейін?
Dialogue: 0,0:14:50.64,0:14:53.05,Default,,0,0,0,,А, анау, анау...
Dialogue: 0,0:14:56.64,0:14:58.30,Default,,0,0,0,,Кішкене батылдық
Dialogue: 0,0:14:59.71,0:15:00.89,Default,,0,0,0,,А... Айтпас бұрын ойланып көрейін.
Dialogue: 0,0:15:02.20,0:15:02.95,Default,,0,0,0,,Иә
Dialogue: 0,0:15:04.45,0:15:07.97,Default,,0,0,0,,<Балабақшада мен ерекше жақын жүретін бір қыз бар еді>
Dialogue: 0,0:15:09.32,0:15:11.63,Default,,0,0,0,,<Әрқашан менің артыма жасырынып жүр>
Dialogue: 0,0:15:11.99,0:15:15.02,Default,,0,0,0,,<Қарапайым сөзбен айтқанда, ол Адачи сияқты бала еді.>
Dialogue: 0,0:15:15.79,0:15:17.36,Default,,0,0,0,,<Мен әлі де қорғансызмын>
Dialogue: 0,0:15:17.80,0:15:19.79,Default,,0,0,0,,＜Кез келген нәрсеге қызығушылық таныту＞
Dialogue: 0,0:15:20.08,0:15:21.93,Default,,0,0,0,,<Бұл менің саған қарай жүгірген кезім>
Dialogue: 0,0:15:22.72,0:15:27.20,Default,,0,0,0,,<Балаға мәрмәр, жел қоңырауы сияқты жылтыр заттар ұнады>
Dialogue: 0,0:15:28.04,0:15:30.18,Default,,0,0,0,,<Мұндай затты тапқанда ғана>
Dialogue: 0,0:15:31.39,0:15:35.05,Default,,0,0,0,,<Ол мені қалдырып, маған қарай жүгірді>
Dialogue: 0,0:15:42.78,0:15:46.05,Default,,0,0,0,,Бүгін SNS желісіндегі танымал суретті қараңыз.
Dialogue: 0,0:15:46.89,0:15:48.47,Default,,0,0,0,,Мектепке түскі асқа арналған сөмке әкелдің бе?
Dialogue: 0,0:15:48.47,0:15:50.37,Default,,0,0,0,,Иә, мен барамын.
Dialogue: 0,0:15:50.64,0:15:53.16,Default,,0,0,0,,Әпке, тезірек мектепке барыңыз~
Dialogue: 0,0:15:53.66,0:15:54.84,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:15:55.31,0:15:59.71,Default,,0,0,0,,Жоғары сынып оқушылары мектепке күн шыққанша келуі керек.
Dialogue: 0,0:16:00.06,0:16:02.59,Default,,0,0,0,,Бұл ақымақ ережені кім үйретті?
Dialogue: 0,0:16:02.89,0:16:04.05,Default,,0,0,0,,Иә, тамақ ішейік!
Dialogue: 0,0:16:05.82,0:16:07.68,Default,,0,0,0,,Әпке!
Dialogue: 0,0:16:08.25,0:16:10.20,Default,,0,0,0,,Менің әпкемнің досы келе жатыр.
Dialogue: 0,0:16:10.62,0:16:11.60,Default,,0,0,0,,Достар!
Dialogue: 0,0:16:12.29,0:16:15.25,Default,,0,0,0,,Иә? Ум, достар?
Dialogue: 0,0:16:15.38,0:16:16.63,Default,,0,0,0,,Өткенде келген адам!
Dialogue: 0,0:16:45.54,0:16:46.39,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:16:47.61,0:16:49.09,Default,,0,0,0,,Сәлем Сәлем Адачи
Dialogue: 0,0:16:50.66,0:16:51.48,Default,,0,0,0,,Чи... шісс
Dialogue: 0,0:16:52.14,0:16:53.09,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:16:53.64,0:16:55.64,Default,,0,0,0,,Неліктен өзіңізді спортшымын деп көрсетесіз?
Dialogue: 0,0:16:56.47,0:16:57.40,Default,,0,0,0,,Мен оны баса алмаспын.
Dialogue: 0,0:16:58.17,0:16:59.94,Default,,0,0,0,,Дұрысы, таң ерте емес пе?
Dialogue: 0,0:17:00.49,0:17:02.53,Default,,0,0,0,,Иә? Сіз нешеде келдіңіз?
Dialogue: 0,0:17:03.41,0:17:05.36,Default,,0,0,0,,Менің біраз шаруам бар.
Dialogue: 0,0:17:05.36,0:17:07.42,Default,,0,0,0,,Таңертең бұл қалыпты деп ойлаймын.
Dialogue: 0,0:17:07.51,0:17:08.64,Default,,0,0,0,,Жаңа ғана келді
Dialogue: 0,0:17:13.20,0:17:13.85,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:19.83,0:17:20.73,Default,,0,0,0,,Суық.
Dialogue: 0,0:17:21.92,0:17:23.71,Default,,0,0,0,,Күн суық, іштей сөйлесейік.
Dialogue: 0,0:17:23.84,0:17:24.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:25.34,0:17:27.23,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:17:27.91,0:17:30.43,Default,,0,0,0,,Адачи-чан, маған тамақ ішуге көмектес.
Dialogue: 0,0:17:30.98,0:17:32.98,Default,,0,0,0,,Менің балам баяу, бұл мені мазалайды.
Dialogue: 0,0:17:32.98,0:17:35.20,Default,,0,0,0,,Қажетсіз ештеңе айтпаңыз.
Dialogue: 0,0:17:36.00,0:17:39.41,Default,,0,0,0,,Мм...Мен оны үйде жедім.
Dialogue: 0,0:17:39.77,0:17:40.78,Default,,0,0,0,,Сіз не жедіңіз?
Dialogue: 0,0:17:41.96,0:17:43.10,Default,,0,0,0,,Ах... бір үзім нан.
Dialogue: 0,0:17:43.61,0:17:46.98,Default,,0,0,0,,Анаң саған көбірек жеу керек дейді ме?
Dialogue: 0,0:17:47.34,0:17:48.66,Default,,0,0,0,,Сонымен~
Dialogue: 0,0:17:49.10,0:17:50.46,Default,,0,0,0,,Ата-аналар
Dialogue: 0,0:17:50.46,0:17:54.11,Default,,0,0,0,,Менің қызым белін бекер уайымдап, арық жегеннен гөрі.
Dialogue: 0,0:17:54.11,0:17:56.05,Default,,0,0,0,,Кішкене қалыңдау қауіпсіз
Dialogue: 0,0:17:57.01,0:17:58.43,Default,,0,0,0,,Айтпаған
Dialogue: 0,0:17:58.43,0:18:01.42,Default,,0,0,0,,Біз көп сөйлеспейміз, мен үйде жоқпын.
Dialogue: 0,0:18:01.90,0:18:02.95,Default,,0,0,0,,Иә
Dialogue: 0,0:18:05.78,0:18:06.95,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:18:08.92,0:18:10.95,Default,,0,0,0,,Жарайды! Бөлмеде сөйлесейік
Dialogue: 0,0:18:13.96,0:18:15.94,Default,,0,0,0,,Ух~ Саби Саби
Dialogue: 0,0:18:16.81,0:18:18.38,Default,,0,0,0,,Мен жаңа ғана жылытуды қостым.
Dialogue: 0,0:18:19.33,0:18:20.73,Default,,0,0,0,,А, бұл туралы.
Dialogue: 0,0:18:21.35,0:18:22.82,Default,,0,0,0,,ойлағанымдай жақсы жүрмей тұр. Алғашында бәрі жақсы еді.
Dialogue: 0,0:18:23.40,0:18:24.92,Default,,0,0,0,,Мен оны кеше де естідім.
Dialogue: 0,0:18:27.52,0:18:29.92,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:32.36,0:18:34.90,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:38.17,0:18:38.95,Default,,0,0,0,,Шимамура!
Dialogue: 0,0:18:39.11,0:18:40.44,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:18:41.75,0:18:43.40,Default,,0,0,0,,Бір жерге барғыңыз келе ме?
Dialogue: 0,0:18:43.70,0:18:44.38,Default,,0,0,0,,Бір нәрсе сияқты
Dialogue: 0,0:18:45.22,0:18:46.57,Default,,0,0,0,,ХХ ғасырдың осы кезеңінде қала халқы 11 миллион адамды құрады.
Dialogue: 0,0:18:47.30,0:18:48.24,Default,,0,0,0,,Иә? Бар болғаны?
Dialogue: 0,0:18:49.13,0:18:50.53,Default,,0,0,0,,Жарайды, бірақ мектептен кейін?
Dialogue: 0,0:18:51.23,0:18:53.16,Default,,0,0,0,,Мектепті тастайтыныңызға сенімдісіз бе?
Dialogue: 0,0:18:53.72,0:18:56.60,Default,,0,0,0,,А... бүгін емес, солай ма?
Dialogue: 0,0:18:57.31,0:18:59.02,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:02.50,0:19:07.90,Default,,0,0,0,,Мынау... мынау... осы айдың 25-і не болып жатыр?
Dialogue: 0,0:19:08.78,0:19:12.25,Default,,0,0,0,,25? 25-і...
Dialogue: 0,0:19:12.51,0:19:14.83,Default,,0,0,0,,25 желтоқсанда... А!
Dialogue: 0,0:19:16.22,0:19:17.64,Default,,0,0,0,,25
Dialogue: 0,0:19:20.92,0:19:22.68,Default,,0,0,0,,Бұл Рождество, солай ма?
Dialogue: 0,0:19:23.74,0:19:24.30,Default,,0,0,0,,Иә
Dialogue: 0,0:19:26.81,0:19:29.59,Default,,0,0,0,,<Сіз неге екенін айтқыңыз келеді, бірақ сөзіңізді тоқтатыңыз>
Dialogue: 0,0:19:30.66,0:19:33.25,Default,,0,0,0,,<Неге Рождество, неге мен>
Dialogue: 0,0:19:33.96,0:19:40.92,Default,,0,0,0,,<Егер мен одан себебін сұрасам, қарым-қатынасымыздың жұлыны бұралып қалатындай сезіндім.>
Dialogue: 0,0:19:41.95,0:19:45.93,Default,,0,0,0,,<Емдеу үшін көп күш пен уақыт қажет>
Dialogue: 0,0:19:47.01,0:19:49.40,Default,,0,0,0,,<Осындай жерге барар ма едім деп ойласам>
Dialogue: 0,0:19:50.06,0:19:52.74,Default,,0,0,0,,<Мен суық жауапты бірден көремін>
Dialogue: 0,0:19:55.22,0:19:55.70,Default,,0,0,0,,<Себебі>
Dialogue: 0,0:19:59.42,0:20:00.62,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:20:00.62,0:20:02.88,Default,,0,0,0,,Мен әлі ештеңе туралы ойлаған жоқпын.
Dialogue: 0,0:20:04.30,0:20:05.18,Default,,0,0,0,,Бірақ оны қазір анаға көрсетпе.
Dialogue: 0,0:20:05.18,0:20:07.48,Default,,0,0,0,,Мен әлі ештеңе туралы ойлаған жоқпын.
Dialogue: 0,0:20:09.26,0:20:10.84,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:20:12.30,0:20:16.58,Default,,0,0,0,,<Себебі Адачи үйде қалды және Рождество рухын ешқашан сезінбеді>
Dialogue: 0,0:20:16.84,0:20:18.50,Default,,0,0,0,,<Сонымен ол менен сұрады>
Dialogue: 0,0:20:19.20,0:20:22.00,Default,,0,0,0,,<Мені сендіргім келеді>
Dialogue: 0,0:20:22.83,0:20:25.04,Default,,0,0,0,,<Көңіл-күй жақсы болғандықтан, қызару жақсы>
Dialogue: 0,0:20:25.49,0:20:26.84,Default,,0,0,0,,<Бұл дерлік>
Dialogue: 0,0:20:27.96,0:20:29.88,Default,,0,0,0,,<Мойындаумен бірдей емес пе?>
Dialogue: 0,0:20:32.83,0:20:35.64,Default,,0,0,0,,Аа, бұл көп нәрсені білдірмейді.
Dialogue: 0,0:20:35.85,0:20:37.85,Default,,0,0,0,,Сол Рождество
Dialogue: 0,0:20:37.85,0:20:40.20,Default,,0,0,0,,Сіз қызықты күнде біреумен араласқыңыз келе ме?
Dialogue: 0,0:20:40.70,0:20:42.94,Default,,0,0,0,,Мен білмеймін, бірақ мен оны сынап көргім келді.
Dialogue: 0,0:20:45.61,0:20:46.49,Default,,0,0,0,,<Не?>
Dialogue: 0,0:20:47.58,0:20:49.31,Default,,0,0,0,,<Мен біреумен бірге болғым келеді>
Dialogue: 0,0:20:49.89,0:20:54.28,Default,,0,0,0,,＜Бірақ менің басқа достарым болмағандықтан, тостаған маған берілді＞
Dialogue: 0,0:20:55.65,0:20:57.56,Default,,0,0,0,,<Менімен емес, біреумен>
Dialogue: 0,0:20:58.55,0:21:01.51,Default,,0,0,0,,<Түсіндім, онда жақсы...>
Dialogue: 0,0:21:03.05,0:21:06.44,Default,,0,0,0,,Мен сені кешкі асқа дейін үйге жіберемін, бірақ жақсы болса.
Dialogue: 0,0:21:07.21,0:21:07.99,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:21:08.83,0:21:11.77,Default,,0,0,0,,Адачи баратын жерін, бәрін ойласа.
Dialogue: 0,0:21:24.25,0:21:25.05,Default,,0,0,0,,Адачи?
Dialogue: 0,0:21:26.81,0:21:28.36,Default,,0,0,0,,Адачи иті
Dialogue: 0,0:21:30.54,0:21:32.35,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:21:37.90,0:21:39.89,Default,,0,0,0,,Бірақ... мен мектепке баруым керек.
Dialogue: 0,0:21:40.25,0:21:43.24,Default,,0,0,0,,Иә, иә, онда бірге барайық.
Dialogue: 0,0:21:43.65,0:21:44.75,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:21:45.13,0:21:47.40,Default,,0,0,0,,Эй... біз асығуымыз керек.
Dialogue: 0,0:21:47.47,0:21:49.29,Default,,0,0,0,,А, асығыңыз, асығыңыз!
Dialogue: 0,0:21:49.52,0:21:51.02,Default,,0,0,0,,Ах... Адачи! ?
Dialogue: 0,0:21:51.64,0:21:53.13,Default,,0,0,0,,Асығыңыз Асығыңыз
Dialogue: 0,0:21:54.35,0:21:55.87,Default,,0,0,0,,Ал... күте тұрыңыз
Dialogue: 0,0:21:57.58,0:21:59.01,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:22:02.58,0:22:04.86,Default,,0,0,0,,Неліктен тарихи драмаға ұқсайды?
Dialogue: 0,0:22:05.74,0:22:09.34,Default,,0,0,0,,Артқы жағына мінуге рұқсат етіңіз~ Мм~
Dialogue: 0,0:22:12.56,0:22:13.48,Default,,0,0,0,,Әй, қой, маңызды емес.
Dialogue: 0,0:22:15.03,0:22:20.23,Default,,0,0,0,,<Сондықтан мен осы Рождествода Адачимен бірге шығуды шештім>
Dialogue: 0,0:22:21.17,0:22:25.54,Default,,0,0,0,,<Жарайды, мен бәрібір үйде отырсам да Аяз ата келмейді>
Dialogue: 0,0:23:59.26,0:24:01.07,Default,,0,0,0,,Адашимапедия Котацу
Dialogue: 0,0:24:01.07,0:24:03.07,Default,,0,0,0,,Котацу адамдарға зиян тигізбейді.
Dialogue: 0,0:24:03.61,0:24:04.74,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:24:04.74,0:24:06.14,Default,,0,0,0,,Шай құйыңыз~
Dialogue: 0,0:24:06.17,0:24:07.77,Default,,0,0,0,,Жоқ, мен сыртқа шыққым келмейді.
Dialogue: 0,0:24:07.77,0:24:08.89,Default,,0,0,0,,Алдын ала ескерту~
Dialogue: 0,0:24:08.89,0:24:10.17,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:24:10.47,0:24:11.40,Default,,0,0,0,,Әй, қой, маңызды емес.
Dialogue: 0,0:24:11.40,0:24:13.08,Default,,0,0,0,,Жақсы ма? Жақсы ма?
Dialogue: 0,0:24:14.58,0:24:20.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
