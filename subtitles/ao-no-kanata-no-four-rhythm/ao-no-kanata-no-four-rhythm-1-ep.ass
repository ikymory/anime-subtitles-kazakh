Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.29,0:00:07.69,Default,,0,0,0,,қайғыру
Dialogue: 0,0:00:08.24,0:00:13.92,Default,,0,0,0,,Уақыт – күшті тілек
Dialogue: 0,0:00:14.87,0:00:21.34,Default,,0,0,0,,Жоғары қарау
Dialogue: 0,0:00:29.43,0:00:41.69,Default,,0,0,0,,Өзіңіздің жақсы емес өзіңізді қазір босатыңыз
Dialogue: 0,0:00:55.31,0:00:57.93,Default,,0,0,0,,Мына аспанды көргеніме он жыл болды.
Dialogue: 0,0:00:58.24,0:00:59.61,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:01:00.27,0:01:02.86,Default,,0,0,0,,Қанатымды қызғанамын.
Dialogue: 0,0:01:24.40,0:01:25.90,Default,,0,0,0,,Бұл Тохохо
Dialogue: 0,0:01:30.77,0:01:32.09,Default,,0,0,0,,Сегізден он минут өтті
Dialogue: 0,0:01:32.67,0:01:33.79,Default,,0,0,0,,Жай ғана?
Dialogue: 0,0:01:33.79,0:01:34.52,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:01:36.19,0:01:37.90,Default,,0,0,0,,Маған біртіндеп орал
Dialogue: 0,0:01:39.46,0:01:42.40,Default,,0,0,0,,Жоқ, таң қалдым, мазасыздандым.
Dialogue: 0,0:01:42.48,0:01:44.35,Default,,0,0,0,,Бұлай жалғаса берсе, мен үйге кіре алмаймын.
Dialogue: 0,0:01:44.35,0:01:46.63,Default,,0,0,0,,Ауыстырудан кейінгі бірінші күні кілтті жоғалтып алдыңыз ба?
Dialogue: 0,0:01:46.63,0:01:48.49,Default,,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:01:48.74,0:01:51.15,Default,,0,0,0,,Жоқ, жоқ, бұл өте жаман.
Dialogue: 0,0:01:52.32,0:01:53.69,Default,,0,0,0,,Маған біртіндеп орал
Dialogue: 0,0:01:57.75,0:01:59.95,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:00.40,0:02:01.37,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:02.02,0:02:03.60,Default,,0,0,0,,Мен кілтімді жоғалтып алдым.
Dialogue: 0,0:02:04.58,0:02:05.90,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:02:05.97,0:02:08.81,Default,,0,0,0,,Жоқ, күңкілдегеніңізді естіп тұрмын.
Dialogue: 0,0:02:09.65,0:02:10.32,Default,,0,0,0,,Қаласаңыз
Dialogue: 0,0:02:10.32,0:02:12.84,Default,,0,0,0,,Сіз маған оны табуға көмектесесіз бе?
Dialogue: 0,0:02:14.19,0:02:15.76,Default,,0,0,0,,Рахмет
Dialogue: 0,0:02:16.95,0:02:19.36,Default,,0,0,0,,Өйткені, аралдың адамдары мейірімді.
Dialogue: 0,0:02:19.49,0:02:23.12,Default,,0,0,0,,Төрт арал адамзат аралы деп алаңдамаңыз.
Dialogue: 0,0:02:23.12,0:02:25.23,Default,,0,0,0,,Кемпір айтқандай болды.
Dialogue: 0,0:02:25.38,0:02:28.58,Default,,0,0,0,,Мен кеше ғана Кунашимаға көшіп келдім.
Dialogue: 0,0:02:28.58,0:02:29.77,Default,,0,0,0,,Менің іздеп жүргенім осы ма?
Dialogue: 0,0:02:31.43,0:02:33.36,Default,,0,0,0,,Рахмет Рахмет
Dialogue: 0,0:02:32.83,0:02:34.24,Default,,0,0,0,,Ақия
Dialogue: 0,0:02:34.45,0:02:34.97,Default,,0,0,0,,Мен оның қоректік тұрғыдан теңдестірілгеніне көз жеткіздім — тіпті ішіне сенің сүйікті раковиналарыңды да қостым.
Dialogue: 0,0:02:37.03,0:02:39.42,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:02:39.73,0:02:41.88,Default,,0,0,0,,H... адамдар ұшып жатыр.
Dialogue: 0,0:02:44.72,0:02:47.37,Default,,0,0,0,,Эй, аялдамадан түс.
Dialogue: 0,0:02:47.39,0:02:49.27,Default,,0,0,0,,Керемет Керемет
Dialogue: 0,0:02:49.27,0:02:50.99,Default,,0,0,0,,Аспанға адам ұшты
Dialogue: 0,0:02:51.17,0:02:51.84,Default,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 0,0:02:52.03,0:02:54.28,Default,,0,0,0,,Менің атым Асука Курашина.
Dialogue: 0,0:02:56.69,0:02:58.01,Default,,0,0,0,,Тіпті ауысатын студент
Dialogue: 0,0:02:58.47,0:02:59.87,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:03:00.23,0:03:03.94,Default,,0,0,0,,Бұл сөзді Курашина мырза кілтін іздеп жүріп өзіне айтты.
Dialogue: 0,0:03:03.94,0:03:05.37,Default,,0,0,0,,Мен сенің атыңды да білемін.
Dialogue: 0,0:03:07.04,0:03:09.45,Default,,0,0,0,,Мен өзімді таныстырдым.
Dialogue: 0,0:03:09.99,0:03:13.21,Default,,0,0,0,,Бұл шиеленіс таңертеңнен бері қатты болды.
Dialogue: 0,0:03:14.77,0:03:16.01,Default,,0,0,0,,Мен Акия Хинатамын
Dialogue: 0,0:03:16.42,0:03:18.22,Default,,0,0,0,,Бұл Мисаки Тобисава
Dialogue: 0,0:03:20.29,0:03:23.45,Default,,0,0,0,,Екеуі де Кунахама Гакуин орта мектебінің екінші курс студенттері.
Dialogue: 0,0:03:24.00,0:03:25.58,Default,,0,0,0,,Иә, мен де.
Dialogue: 0,0:03:25.83,0:03:29.50,Default,,0,0,0,,Жүр, мектепке ерте бару жақсы емес.
Dialogue: 0,0:03:29.94,0:03:32.62,Default,,0,0,0,,Кагами-сенсей осы аптада кезекшілікте.
Dialogue: 0,0:03:32.96,0:03:33.95,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:03:33.11,0:03:34.62,Default,,0,0,0,,Кагами-сенсей?
Dialogue: 0,0:03:35.19,0:03:36.97,Default,,0,0,0,,Мен денсаулық және дене шынықтыру пәнінің мұғалімімін.
Dialogue: 0,0:03:37.41,0:03:38.72,Default,,0,0,0,,Мен сонымен қатар өмір салтын ұсынамын.
Dialogue: 0,0:03:39.11,0:03:41.74,Default,,0,0,0,,Кешігіп қалсаңыз, сізді қорқынышты жаза күтіп тұр.
Dialogue: 0,0:03:41.83,0:03:42.84,Default,,0,0,0,,Бұл жаза ма?
Dialogue: 0,0:03:43.38,0:03:47.78,Default,,0,0,0,,Ұстаздың өз желісі арқылы жиналған шәкірттердің қаралы тарихы ашылатын сияқты.
Dialogue: 0,0:03:47.78,0:03:48.43,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:48.47,0:03:50.90,Default,,0,0,0,,Бұл адам үшін нені білдіреді?
Dialogue: 0,0:03:50.90,0:03:54.17,Default,,0,0,0,,Қараңдар, мен тез ұшып кетемін.
Dialogue: 0,0:03:54.35,0:03:55.80,Default,,0,0,0,,Аялдама сол жақта
Dialogue: 0,0:03:55.89,0:03:58.12,Default,,0,0,0,,Жарайды, ұшайық.
Dialogue: 0,0:03:58.32,0:03:59.44,Default,,0,0,0,,Ақия ше?
Dialogue: 0,0:03:59.49,0:04:00.83,Default,,0,0,0,,Мен қашып кетемін
Dialogue: 0,0:04:01.49,0:04:03.71,Default,,0,0,0,,Сонымен, сіз қалай ұшасыз?
Dialogue: 0,0:04:06.83,0:04:09.10,Default,,0,0,0,,Бұл менің формамды кигеніңді білдіре ме?
Dialogue: 0,0:04:09.23,0:04:11.88,Default,,0,0,0,,Гураштың түсіндірмесін алуыңыз керек еді.
Dialogue: 0,0:04:12.15,0:04:13.45,Default,,0,0,0,,Шөп
Dialogue: 0,0:04:14.48,0:04:16.16,Default,,0,0,0,,Сіз бұл аяқ киімді айтасыз ба?
Dialogue: 0,0:04:16.16,0:04:18.96,Default,,0,0,0,,Сіз оны ешқашан пайдаланбағансыз, солай ма?
Dialogue: 0,0:04:18.96,0:04:19.68,Default,,0,0,0,,Иә
Dialogue: 0,0:04:19.99,0:04:21.04,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:04:21.25,0:04:23.13,Default,,0,0,0,,Олай болса менімен жұптас.
Dialogue: 0,0:04:23.92,0:04:25.04,Default,,0,0,0,,Сәлем Мисаки
Dialogue: 0,0:04:25.17,0:04:26.73,Default,,0,0,0,,Айналаңыздың бәрі жақсы.
Dialogue: 0,0:04:27.06,0:04:29.21,Default,,0,0,0,,Ұшуға тыйым салу шамы да қосылмаған.
Dialogue: 0,0:04:29.41,0:04:31.02,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:04:36.96,0:04:38.97,Default,,0,0,0,,Әй, тездетіп ал!
Dialogue: 0,0:04:39.36,0:04:40.03,Default,,0,0,0,,Иә
Dialogue: 0,0:04:42.42,0:04:43.66,Default,,0,0,0,,Ақия да
Dialogue: 0,0:04:44.02,0:04:45.28,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:04:45.51,0:04:46.30,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:04:46.40,0:04:46.94,Default,,0,0,0,,Иә
Dialogue: 0,0:04:47.55,0:04:51.26,Default,,0,0,0,,Бір екі ұшатын Нян
Dialogue: 0,0:04:57.46,0:04:58.11,Default,,0,0,0,,Ұшу
Dialogue: 0,0:05:00.39,0:05:03.33,Default,,0,0,0,,Бұл не? Бұл жақсы емес. Ол мүлде құламайды.
Dialogue: 0,0:05:03.33,0:05:05.93,Default,,0,0,0,,Құлайды. Құлайды.
Dialogue: 0,0:05:06.69,0:05:08.20,Default,,0,0,0,,Ұйықтама
Dialogue: 0,0:05:08.45,0:05:09.76,Default,,0,0,0,,Мен ояумын
Dialogue: 0,0:05:10.15,0:05:13.21,Default,,0,0,0,,Егер Glash қосулы болса, ол ешқашан құламайды.
Dialogue: 0,0:05:15.36,0:05:16.65,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:05:17.76,0:05:18.99,Default,,0,0,0,,Сондықтан уайымдамаңыз
Dialogue: 0,0:05:19.36,0:05:21.24,Default,,0,0,0,,Аспанда серуендеу
Dialogue: 0,0:05:30.23,0:05:31.32,Default,,0,0,0,,Керемет
Dialogue: 0,0:05:34.55,0:05:36.51,Default,,0,0,0,,Мен ұшамын
Dialogue: 0,0:05:37.43,0:05:41.55,Default,,0,0,0,,Осы аяқ киіммен өзімді кез келген жерге ұша алатындай сезінемін.
Dialogue: 0,0:05:44.31,0:05:46.20,Default,,0,0,0,,Қайда?
Dialogue: 0,0:06:00.79,0:06:02.08,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:03.06,0:06:04.35,Default,,0,0,0,,Үш минуттан кейін
Dialogue: 0,0:06:08.35,0:06:11.37,Default,,0,0,0,,Оның аспаннан келуі сирек.
Dialogue: 0,0:06:11.71,0:06:14.57,Default,,0,0,0,,Неліктен бұл төбе жүгіреді?
Dialogue: 0,0:06:14.59,0:06:15.44,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:06:15.44,0:06:17.62,Default,,0,0,0,,Оған көмектесу мүмкін емес, себебі бұл ереже.
Dialogue: 0,0:06:17.62,0:06:23.74,Default,,0,0,0,,5 4 3 2 1
Dialogue: 0,0:06:25.06,0:06:27.21,Default,,0,0,0,,Жарайды, бүгін де ешкім кешікпейді.
Dialogue: 0,0:06:27.57,0:06:28.48,Default,,0,0,0,,Өте жақсы өттің
Dialogue: 0,0:06:28.48,0:06:29.61,Default,,0,0,0,,Қауіпсіз
Dialogue: 0,0:06:30.93,0:06:32.01,Default,,0,0,0,,Егер қаласаңыз, мен оны сіздің атыңыздан жеткізе аламын.
Dialogue: 0,0:06:32.64,0:06:35.02,Default,,0,0,0,,Қайырлы таң, Кагами мырза
Dialogue: 0,0:06:35.11,0:06:35.74,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:36.98,0:06:39.62,Default,,0,0,0,,Бұл қатал және қорқынышты мұғалім ме?
Dialogue: 0,0:06:39.97,0:06:42.40,Default,,0,0,0,,Бұл сөзді адамның көзінше айту қалыпты жағдай ма?
Dialogue: 0,0:06:42.74,0:06:44.70,Default,,0,0,0,,Бұл Курашина, ауыспалы студент.
Dialogue: 0,0:06:45.46,0:06:48.16,Default,,0,0,0,,Мен қатал және қорқынышты Аои Кагамимін.
Dialogue: 0,0:06:48.79,0:06:51.56,Default,,0,0,0,,Сіз менімен бірге қызметкерлер бөлмесіне бара аласыз ба?
Dialogue: 0,0:06:51.95,0:06:53.23,Default,,0,0,0,,Ой, әкеміз келген сияқты.
Dialogue: 0,0:07:00.40,0:07:02.20,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:07:02.63,0:07:04.99,Default,,0,0,0,,Бұл менің сыныбым ғой.
Dialogue: 0,0:07:05.27,0:07:07.17,Default,,0,0,0,,Кунашима – әкемнің туған қаласы
Dialogue: 0,0:07:07.17,0:07:09.77,Default,,0,0,0,,Мен кішкентай кезімде бірнеше рет болдым.
Dialogue: 0,0:07:09.92,0:07:12.06,Default,,0,0,0,,Мен әкемнің жұмысына байланысты көшіп келдім.
Dialogue: 0,0:07:12.16,0:07:15.82,Default,,0,0,0,,Теңіз әдемі, аспан биік деп ойладым.
Dialogue: 0,0:07:15.95,0:07:17.38,Default,,0,0,0,,Мен құлап, кілттерімді түсіріп алдым...
Dialogue: 0,0:07:16.45,0:07:17.60,Default,,0,0,0,,Әзірге
Dialogue: 0,0:07:17.60,0:07:18.94,Default,,0,0,0,,Орынға отыра аласыз ба?
Dialogue: 0,0:07:18.99,0:07:20.19,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:22.05,0:07:24.49,Default,,0,0,0,,Сыныптан теңіз бен аспанды көруге болады.
Dialogue: 0,0:07:24.55,0:07:26.24,Default,,0,0,0,,Жарайды, орнымызға отырайық.
Dialogue: 0,0:07:26.85,0:07:29.99,Default,,0,0,0,,Мисаки Тобисава Сізге көп рахмет.
Dialogue: 0,0:07:29.14,0:07:29.79,Default,,0,0,0,,Жақын
Dialogue: 0,0:07:31.23,0:07:34.04,Default,,0,0,0,,Акия Хината да сол сыныпта оқиды.
Dialogue: 0,0:07:35.23,0:07:35.88,Default,,0,0,0,,Бұл сәл ақымақтық емес пе?
Dialogue: 0,0:07:36.21,0:07:39.48,Default,,0,0,0,,Тобисава мен Хината, Курашинадан нұсқаушы болуын сұраңыз.
Dialogue: 0,0:07:39.51,0:07:40.56,Default,,0,0,0,,Не?
Dialogue: 0,0:07:45.23,0:07:48.23,Default,,0,0,0,,Ақия Бүгін ерте бітірдім.
Dialogue: 0,0:07:48.23,0:07:49.78,Default,,0,0,0,,Мектеп бітті.
Dialogue: 0,0:07:49.78,0:07:50.81,Default,,0,0,0,,Мені сүюге тиіс еді! Мені сүюге тиіс!
Dialogue: 0,0:07:51.43,0:07:53.22,Default,,0,0,0,,Бүгін ақыры басталды.
Dialogue: 0,0:07:53.22,0:07:54.95,Default,,0,0,0,,Біз не істейміз? Не жейміз?
Dialogue: 0,0:07:54.95,0:07:57.90,Default,,0,0,0,,Шексіз мүмкіндіктер маған шабуыл жасайды
Dialogue: 0,0:07:57.92,0:08:01.44,Default,,0,0,0,,Тобиззава-сан, сенің көңіл-күйің таңғыдан ерекше.
Dialogue: 0,0:08:01.68,0:08:03.31,Default,,0,0,0,,Мисакидің қан қысымы төмен.
Dialogue: 0,0:08:03.31,0:08:05.34,Default,,0,0,0,,Өйткені мен әрқашан таңертең жартылай ұйықтаймын
Dialogue: 0,0:08:05.38,0:08:08.08,Default,,0,0,0,,Таңертең мен түстен кейін өзімді басқа адамдай сезінемін.
Dialogue: 0,0:08:08.29,0:08:10.96,Default,,0,0,0,,Дос болудан аздап мазасызданатын деңгей
Dialogue: 0,0:08:11.23,0:08:14.36,Default,,0,0,0,,Мен тек өзіме адал өмір сүріп жатырмын
Dialogue: 0,0:08:14.55,0:08:16.75,Default,,0,0,0,,Мен сені үнемі қызғанамын.
Dialogue: 0,0:08:17.52,0:08:19.21,Default,,0,0,0,,I, Мадока Аояги
Dialogue: 0,0:08:19.35,0:08:20.94,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:08:21.28,0:08:23.92,Default,,0,0,0,,Курашина мырза, бұдан кейін менің жоспарым болмаса.
Dialogue: 0,0:08:24.24,0:08:25.64,Default,,0,0,0,,Гураш жаттығуын жасаймыз ба?
Dialogue: 0,0:08:25.81,0:08:26.52,Default,,0,0,0,,Иә
Dialogue: 0,0:08:26.98,0:08:29.21,Default,,0,0,0,,Мисаки де нұсқаушы, сондықтан келіңіз.
Dialogue: 0,0:08:29.55,0:08:31.12,Default,,0,0,0,,Түсіндім, Ику-нян.
Dialogue: 0,0:08:31.35,0:08:34.14,Default,,0,0,0,,Бұл нұсқаушы кім?
Dialogue: 0,0:08:34.48,0:08:36.24,Default,,0,0,0,,Гурашты жаңадан бастағандар үшін міндетті
Dialogue: 0,0:08:36.51,0:08:38.80,Default,,0,0,0,,Оқыту үшін нұсқаушы қатысады.
Dialogue: 0,0:08:39.11,0:08:41.85,Default,,0,0,0,,Мисаки мен маған нұсқаушы біліктілігін беруден бас тартты.
Dialogue: 0,0:08:42.03,0:08:44.87,Default,,0,0,0,,Олай болса, сіз жаттықтырушысыз.
Dialogue: 0,0:08:44.87,0:08:47.00,Default,,0,0,0,,Құрметпен, жаттықтырушы
Dialogue: 0,0:08:48.42,0:08:49.60,Default,,0,0,0,,Мисаки Сенпай
Dialogue: 0,0:08:50.19,0:08:51.13,Default,,0,0,0,,таза ақ
Dialogue: 0,0:08:53.44,0:08:56.07,Default,,0,0,0,,Мен бүгін кезекшілікте болғандықтан сенімен сабаққа бара алмадым.
Dialogue: 0,0:08:56.07,0:08:57.68,Default,,0,0,0,,Мен жалғыз болдым.
Dialogue: 0,0:08:57.79,0:09:01.49,Default,,0,0,0,,Үйге барар жолда Мисаки-сенпайдың ингредиенттерін мүмкіндігінше толықтыруға рұқсат етіңіз.
Dialogue: 0,0:09:01.49,0:09:02.54,Default,,0,0,0,,Бүгін аз...
Dialogue: 0,0:09:02.69,0:09:04.68,Default,,0,0,0,,Мен осы баланың нұсқаушысы болдым.
Dialogue: 0,0:09:08.43,0:09:09.58,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:09:09.81,0:09:11.24,Default,,0,0,0,,Мен де сізге қосыламын.
Dialogue: 0,0:09:15.03,0:09:17.34,Default,,0,0,0,,Бұл 1А сыныбының оқушысы Маширо Арисака.
Dialogue: 0,0:09:17.62,0:09:21.41,Default,,0,0,0,,Мисаки-сенпайдың бағыныштысы ма, әлде қызметшісі ме?
Dialogue: 0,0:09:21.41,0:09:22.51,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:09:24.15,0:09:27.45,Default,,0,0,0,,Айтпақшы, Курашина-сенпай ойын ойнай ма?
Dialogue: 0,0:09:27.65,0:09:29.60,Default,,0,0,0,,PSQ？ 4DS？
Dialogue: 0,0:09:30.00,0:09:31.85,Default,,0,0,0,,Бұл планшет немесе смартфон ба?
Dialogue: 0,0:09:32.07,0:09:34.44,Default,,0,0,0,,Айтпақшы, мен екеуіне де бара аламын.
Dialogue: 0,0:09:34.55,0:09:35.76,Default,,0,0,0,,Сіз не үшін жарысасыз?
Dialogue: 0,0:09:35.23,0:09:36.13,Default,,0,0,0,,Әзірге
Dialogue: 0,0:09:36.13,0:09:38.03,Default,,0,0,0,,Гурашты түсіндіруге бола ма?
Dialogue: 0,0:09:38.66,0:09:39.82,Default,,0,0,0,,Қалағаныңызды жасаңыз.
Dialogue: 0,0:09:40.13,0:09:41.21,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:09:42.21,0:09:44.78,Default,,0,0,0,,Грасш «Гравитонға қарсы аяқ киім»
Dialogue: 0,0:09:45.22,0:09:48.36,Default,,0,0,0,,Ауырлық күшін тежейтін жұмбақ бөлшектердің ашылуы арқылы жасалған
Dialogue: 0,0:09:48.47,0:09:49.76,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,0:09:50.10,0:09:51.18,Default,,0,0,0,,Иә жаттықтырушы
Dialogue: 0,0:09:51.43,0:09:52.72,Default,,0,0,0,,Бұл төрт арал
Dialogue: 0,0:09:52.93,0:09:57.04,Default,,0,0,0,,Бұл грас ресми түрде көлік құралы ретінде танылған ерекше аймақ.
Dialogue: 0,0:09:57.41,0:10:01.28,Default,,0,0,0,,Бірнеше жыл бұрын ол мектепке бару құралы ретінде қабылданды.
Dialogue: 0,0:10:01.79,0:10:04.13,Default,,0,0,0,,Ня, мен шаршадым.
Dialogue: 0,0:10:04.13,0:10:06.36,Default,,0,0,0,,Бұл жеткілікті түсініктеме емес пе?
Dialogue: 0,0:10:06.72,0:10:07.96,Default,,0,0,0,,Иә жаттықтырушы
Dialogue: 0,0:10:09.39,0:10:11.88,Default,,0,0,0,,Содан кейін екі аяқтың өкшесін сәл көтеріңіз.
Dialogue: 0,0:10:12.32,0:10:13.50,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:10:13.65,0:10:14.19,Default,,0,0,0,,Иә
Dialogue: 0,0:10:14.83,0:10:16.32,Default,,0,0,0,,Қалғаны өз уақытында.
Dialogue: 0,0:10:16.56,0:10:18.25,Default,,0,0,0,,Аяқ киімдегі шыбындар туралы айту
Dialogue: 0,0:10:18.27,0:10:19.96,Default,,0,0,0,,Ол іске қосылады және баяу жоғары көтеріледі.
Dialogue: 0,0:10:20.99,0:10:21.60,Default,,0,0,0,,Иә
Dialogue: 0,0:10:25.67,0:10:28.86,Default,,0,0,0,,Ұшу
Dialogue: 0,0:10:34.98,0:10:37.02,Default,,0,0,0,,Ол қалқып кетті Ол қозғалды
Dialogue: 0,0:10:40.13,0:10:43.18,Default,,0,0,0,,Мен ұшамын
Dialogue: 0,0:10:43.36,0:10:44.78,Default,,0,0,0,,Ол ұшып келеді
Dialogue: 0,0:10:47.70,0:10:50.24,Default,,0,0,0,,Курашина-сенпай көңілді жүрген сияқты.
Dialogue: 0,0:10:50.83,0:10:53.87,Default,,0,0,0,,Бірақ қолдарыңды осылай қағып отыра берсеңдер
Dialogue: 0,0:10:53.87,0:10:55.09,Default,,0,0,0,,Бірден басы айналады
Dialogue: 0,0:10:55.09,0:10:56.56,Default,,0,0,0,,Кенеттен теңгерімсіздік
Dialogue: 0,0:10:56.56,0:10:57.21,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:11:00.32,0:11:01.04,Default,,0,0,0,,Бұл
Dialogue: 0,0:11:02.11,0:11:03.21,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:03.59,0:11:06.76,Default,,0,0,0,,Қауіпсіз қону - Glash функцияларының бірі.
Dialogue: 0,0:11:08.87,0:11:10.28,Default,,0,0,0,,Алғашында осылай болады
Dialogue: 0,0:11:10.93,0:11:12.94,Default,,0,0,0,,Бұл мүлдем жақсы болмады.
Dialogue: 0,0:11:13.25,0:11:15.44,Default,,0,0,0,,Сонымен, бүгінгі күн осымен бітті.
Dialogue: 0,0:11:15.60,0:11:16.91,Default,,0,0,0,,Мен удон жеймін.
Dialogue: 0,0:11:16.91,0:11:17.55,Default,,0,0,0,,Эй...
Dialogue: 0,0:11:17.67,0:11:19.39,Default,,0,0,0,,Бұл удон ба?
Dialogue: 0,0:11:19.55,0:11:21.66,Default,,0,0,0,,Иә, атақты Шишима Удон
Dialogue: 0,0:11:21.83,0:11:23.70,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:11:23.70,0:11:24.75,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:11:24.75,0:11:26.80,Default,,0,0,0,,Бүгін сізде қандай қоспалар болады?
Dialogue: 0,0:11:27.47,0:11:28.55,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:28.55,0:11:29.61,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:11:29.95,0:11:31.94,Default,,0,0,0,,Алдымен біз ұшып барамыз.
Dialogue: 0,0:11:31.94,0:11:33.55,Default,,0,0,0,,Жақында маған жазылыңыз.
Dialogue: 0,0:11:33.70,0:11:34.78,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:11:36.03,0:11:37.04,Default,,0,0,0,,Ұшатын нян
Dialogue: 0,0:11:37.09,0:11:37.96,Default,,0,0,0,,Go nyan
Dialogue: 0,0:11:44.74,0:11:48.03,Default,,0,0,0,,Бұл Арисака мырзаның үйі, мұндағы удон мейрамханасы.
Dialogue: 0,0:11:48.95,0:11:52.24,Default,,0,0,0,,Бұл Тобио-сан. Мен оны жақсы көремін.
Dialogue: 0,0:11:52.32,0:11:55.52,Default,,0,0,0,,Мұндағы удон иек сорпасымен дәмді.
Dialogue: 0,0:11:56.15,0:11:56.89,Default,,0,0,0,,Чин?
Dialogue: 0,0:11:57.67,0:11:59.28,Default,,0,0,0,,Содан кейін удон келгенше
Dialogue: 0,0:11:59.28,0:12:02.08,Default,,0,0,0,,Мисаки-сенпай викторинасын Кунашима арқылы өткізейік
Dialogue: 0,0:12:02.24,0:12:03.04,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:03.04,0:12:04.22,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:12:04.27,0:12:05.23,Default,,0,0,0,,Жасайық
Dialogue: 0,0:12:05.23,0:12:07.53,Default,,0,0,0,,Мен бәріңіз туралы көбірек білгім келеді.
Dialogue: 0,0:12:07.63,0:12:09.07,Default,,0,0,0,,Енді бірінші сұрақ
Dialogue: 0,0:12:10.21,0:12:11.87,Default,,0,0,0,,Мисаки-сенпайдың хоббиі
Dialogue: 0,0:12:13.38,0:12:14.38,Default,,0,0,0,,Тұр, мен өзі қандай ұлтпын? Хехехе
Dialogue: 0,0:12:15.78,0:12:18.84,Default,,0,0,0,,Дұрыс жауап нукадко жасау болды, оны тікелей әжем үйреткен.
Dialogue: 0,0:12:19.59,0:12:23.05,Default,,0,0,0,,Сонымен, екінші сұрақ: Мисаки-сенпайдың үш өлшемі қандай?
Dialogue: 0,0:12:24.02,0:12:27.36,Default,,0,0,0,,Мен плюс 11/7/12
Dialogue: 0,0:12:27.36,0:12:28.99,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:12:28.99,0:12:30.72,Default,,0,0,0,,Тек бір-екі жастағы бала үшін
Dialogue: 0,0:12:31.12,0:12:32.68,Default,,0,0,0,,Әдеттегідей рахмет
Dialogue: 0,0:12:32.82,0:12:34.00,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:12:35.17,0:12:36.47,Default,,0,0,0,,Дәмді көрінеді
Dialogue: 0,0:12:36.47,0:12:38.65,Default,,0,0,0,,Абайлаңыз.
Dialogue: 0,0:12:38.96,0:12:42.92,Default,,0,0,0,,Мисаки-сенпай, ертең мектепке бірге барайық.
Dialogue: 0,0:12:42.95,0:12:43.78,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:12:43.78,0:12:46.41,Default,,0,0,0,,Сіз екі жақсы доссыз ба?
Dialogue: 0,0:12:47.25,0:12:48.78,Default,,0,0,0,,Сіз, Басшының орынбасары, қазір тергеу штабында қанша адам қалғанын білесіз ғой.
Dialogue: 0,0:12:49.12,0:12:51.37,Default,,0,0,0,,Бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:12:53.19,0:12:56.24,Default,,0,0,0,,Тобисава-сан, өте әдемі ұшады.
Dialogue: 0,0:12:56.64,0:12:58.92,Default,,0,0,0,,Бірақ мен алмаймын.
Dialogue: 0,0:12:59.44,0:13:01.10,Default,,0,0,0,,Уайымдайтын ештеңе жоқ.
Dialogue: 0,0:13:01.81,0:13:04.12,Default,,0,0,0,,Енді бірте-бірте жаттығыңыз.
Dialogue: 0,0:13:05.79,0:13:07.45,Default,,0,0,0,,Сол Курашина-сан
Dialogue: 0,0:13:07.89,0:13:09.23,Default,,0,0,0,,Өзіңізді соншалықты күйзеліске ұшыратпасаңыз да
Dialogue: 0,0:13:09.36,0:13:10.38,Default,,0,0,0,,Бұл қынжылтады
Dialogue: 0,0:13:11.27,0:13:12.28,Default,,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,0:13:12.79,0:13:17.36,Default,,0,0,0,,Дәл қазір мен өзім ұшып өте қызық болдым.
Dialogue: 0,0:13:17.84,0:13:21.98,Default,,0,0,0,,Бірақ менің басым тез айналып, бірден құлап қалдым.
Dialogue: 0,0:13:22.61,0:13:23.79,Default,,0,0,0,,Бұл аянышты
Dialogue: 0,0:13:25.76,0:13:29.63,Default,,0,0,0,,Олай болса, ертеңнен бастап жаттығуды бастаңыз, жаттықтырушы.
Dialogue: 0,0:13:29.81,0:13:31.34,Default,,0,0,0,,Ааа
Dialogue: 0,0:13:31.46,0:13:32.86,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:34.98,0:13:35.92,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:13:40.18,0:13:43.18,Default,,0,0,0,,Жақсы емес. Жоқ, жоқ.
Dialogue: 0,0:13:45.27,0:13:45.88,Default,,0,0,0,,Бірақ
Dialogue: 0,0:13:49.15,0:13:51.44,Default,,0,0,0,,Аспанда ұшу жақсы сезінеді
Dialogue: 0,0:13:52.02,0:13:53.66,Default,,0,0,0,,Мен де ертеңгі күнді асыға күтемін.
Dialogue: 0,0:13:55.11,0:13:56.36,Default,,0,0,0,,Жаттықтырушы Тобисава
Dialogue: 0,0:13:56.87,0:13:57.95,Default,,0,0,0,,Жаттықтырушы Хината
Dialogue: 0,0:13:58.37,0:14:00.41,Default,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:14:01.92,0:14:03.58,Default,,0,0,0,,Көрші үйге көшіп келген...
Dialogue: 0,0:14:28.50,0:14:31.44,Default,,0,0,0,,Мен мұндай қорқынышты бастаушыны ешқашан көрген емеспін.
Dialogue: 0,0:14:31.59,0:14:34.03,Default,,0,0,0,,Курашина-сан, сабыр ет.
Dialogue: 0,0:14:34.58,0:14:36.38,Default,,0,0,0,,Қараңдар, мен жол бермеймін.
Dialogue: 0,0:14:36.56,0:14:38.40,Default,,0,0,0,,Иә, демалыңыз
Dialogue: 0,0:14:38.40,0:14:40.33,Default,,0,0,0,,Керісінше, ол енгізілген.
Dialogue: 0,0:14:41.71,0:14:43.13,Default,,0,0,0,,Сонда не істеуіміз керек?
Dialogue: 0,0:14:43.65,0:14:44.48,Default,,0,0,0,,ұшып кетті
Dialogue: 0,0:14:44.48,0:14:45.16,Default,,0,0,0,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:14:45.35,0:14:46.34,Default,,0,0,0,,Мен қуып жетуім керек
Dialogue: 0,0:14:46.34,0:14:47.94,Default,,0,0,0,,Мен қазір саған қамқорлық жасай аламын.
Dialogue: 0,0:14:47.94,0:14:49.71,Default,,0,0,0,,Аяқтауға жақын.
Dialogue: 0,0:14:52.07,0:14:53.93,Default,,0,0,0,,Мен енді мұны істей алмаймын.
Dialogue: 0,0:14:54.18,0:14:56.49,Default,,0,0,0,,Бұл қандай көрініс?
Dialogue: 0,0:14:56.59,0:14:58.96,Default,,0,0,0,,Бұл қандай да бір себептермен оны тұрақтырақ етеді.
Dialogue: 0,0:15:00.02,0:15:02.06,Default,,0,0,0,,Бұл өте сирек кездесетін кейіпкер болуы мүмкін.
Dialogue: 0,0:15:04.71,0:15:05.53,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:05.95,0:15:07.44,Default,,0,0,0,,Көшедегі төбелес пе?
Dialogue: 0,0:15:07.44,0:15:09.24,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:15:09.39,0:15:10.60,Default,,0,0,0,,Қарап көрейік
Dialogue: 0,0:15:11.79,0:15:13.61,Default,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:15:13.81,0:15:18.16,Default,,0,0,0,,Бір матчқа қарсы шығу үшін өз жолыңыздан шығып, содан кейін жеңіліске ұшырағаныңыз өкінішті.
Dialogue: 0,0:15:18.66,0:15:20.56,Default,,0,0,0,,Сондықтан да айттым.
Dialogue: 0,0:15:20.82,0:15:23.68,Default,,0,0,0,,Мен бұл Сатоин Рейкоға қалай қарсы шыға аламын?
Dialogue: 0,0:15:24.05,0:15:27.29,Default,,0,0,0,,Тынық мұхитында акуламен соғысқан сияқты.
Dialogue: 0,0:15:27.62,0:15:29.74,Default,,0,0,0,,Мен түсінбеймін, бірақ бұл көңілсіз.
Dialogue: 0,0:15:30.87,0:15:32.64,Default,,0,0,0,,Сол адам, Мадоканың ағасы
Dialogue: 0,0:15:32.95,0:15:35.34,Default,,0,0,0,,Бұл не? Бұл галстук па?
Dialogue: 0,0:15:35.51,0:15:38.92,Default,,0,0,0,,Ұшатын циркте бұл Сатоинмен кім бәсекелесе алады?
Dialogue: 0,0:15:39.27,0:15:42.11,Default,,0,0,0,,Бұл Кунахама академиясында жоқ.
Dialogue: 0,0:15:43.49,0:15:45.32,Default,,0,0,0,,Ұшатын цирк?
Dialogue: 0,0:15:45.49,0:15:47.47,Default,,0,0,0,,Шөпті пайдаланатын спорт түрлері
Dialogue: 0,0:15:48.07,0:15:49.37,Default,,0,0,0,,Бұны бірінші рет естіп тұрсыз ба?
Dialogue: 0,0:15:50.71,0:15:56.17,Default,,0,0,0,,Олай болса, уәде еткендей мен сені Кунахама академиясына апарамын.
Dialogue: 0,0:15:56.71,0:16:01.07,Default,,0,0,0,,Бүгіннен бастап өзіңізді Ин кейіпкерінен айырылған Манабу Кунахама деп атаңыз.
Dialogue: 0,0:16:01.92,0:16:04.59,Default,,0,0,0,,Барлығы ...
Dialogue: 0,0:16:04.98,0:16:07.04,Default,,0,0,0,,Мектеп атауы өзгере ме?
Dialogue: 0,0:16:07.04,0:16:08.03,Default,,0,0,0,,Жоқ, сәл күте тұрыңыз.
Dialogue: 0,0:16:08.03,0:16:09.13,Default,,0,0,0,,Курашина Сенпай
Dialogue: 0,0:16:09.19,0:16:10.19,Default,,0,0,0,,Бұл қиын
Dialogue: 0,0:16:10.53,0:16:12.19,Default,,0,0,0,,Мен Манабу Кунахаманы жек көремін.
Dialogue: 0,0:16:12.19,0:16:13.23,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:16:13.28,0:16:14.48,Default,,0,0,0,,Қайта оралу…
Dialogue: 0,0:16:14.48,0:16:16.28,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:16:16.39,0:16:16.96,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:16:16.96,0:16:18.30,Default,,0,0,0,,Оны таптым
Dialogue: 0,0:16:18.34,0:16:20.78,Default,,0,0,0,,Мм, мен шынымен түсінбеймін.
Dialogue: 0,0:16:20.90,0:16:23.84,Default,,0,0,0,,Егер мен сол ұшатын циркті жеңіп алсам
Dialogue: 0,0:16:24.16,0:16:26.17,Default,,0,0,0,,Қонақ үйдің атын қайтара аласыз ба?
Dialogue: 0,0:16:27.54,0:16:28.20,Default,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,0:16:28.96,0:16:32.29,Default,,0,0,0,,Бұл кеше Кунахама академиясына ауысқан Асука Курашина.
Dialogue: 0,0:16:28.50,0:16:30.62,Default,,0,0,0,,Мен неге жасырынып жүрмін?
Dialogue: 0,0:16:30.82,0:16:33.12,Default,,0,0,0,,Бұл алаңнан тыс төбелес. Қызықты.
Dialogue: 0,0:16:33.52,0:16:36.27,Default,,0,0,0,,Сонда мені матчқа шақырғың келе ме?
Dialogue: 0,0:16:37.03,0:16:40.11,Default,,0,0,0,,Ұшатын циркке сенімдісіз бе?
Dialogue: 0,0:16:40.34,0:16:42.48,Default,,0,0,0,,Жоқ, мен жаңа білдім.
Dialogue: 0,0:16:43.47,0:16:46.70,Default,,0,0,0,,Бүгін мен Гураш туфлиімді киіп бірінші рет жалғыз ұшып отырмын.
Dialogue: 0,0:16:47.41,0:16:49.87,Default,,0,0,0,,Сіз алдауды тоқтата аласыз ба?
Dialogue: 0,0:16:50.08,0:16:52.03,Default,,0,0,0,,Мен қалжыңдаған жоқпын, мен байыптымын.
Dialogue: 0,0:16:53.94,0:16:57.08,Default,,0,0,0,,Жарайды, егер солай десеңіз.
Dialogue: 0,0:16:57.23,0:16:58.90,Default,,0,0,0,,Мен оны саған беремін.
Dialogue: 0,0:16:58.90,0:16:59.27,Default,,0,0,0,,Не...
Dialogue: 0,0:16:59.27,0:17:00.77,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:00.77,0:17:02.09,Default,,0,0,0,,Сәлем, Тамма
Dialogue: 0,0:17:02.83,0:17:05.28,Default,,0,0,0,,Бұл адам Такафуджи академиясының студенті.
Dialogue: 0,0:17:05.28,0:17:08.89,Default,,0,0,0,,Такато Гакуэн туралы айтатын болсақ, бұл ұшатын цирктің беделді мектебі.
Dialogue: 0,0:17:09.01,0:17:10.94,Default,,0,0,0,,Қазір бәрі қызық бола бастады.
Dialogue: 0,0:17:10.95,0:17:12.17,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:17:12.40,0:17:14.92,Default,,0,0,0,,Жаттықтырушы, маған Ұшатын цирк туралы айтып беріңізші.
Dialogue: 0,0:17:15.84,0:17:17.10,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:17:19.09,0:17:20.41,Default,,0,0,0,,Ұшатын цирк
Dialogue: 0,0:17:20.47,0:17:25.21,Default,,0,0,0,,Ол әдетте қалқымалармен қоршалған 300 шаршы метр су алаңында ұсталады.
Dialogue: 0,0:17:25.47,0:17:29.87,Default,,0,0,0,,Жеке шайқаста 10 минут ішінде кім көп ұпай жинаса, сол жеңеді.
Dialogue: 0,0:17:30.27,0:17:31.84,Default,,0,0,0,,Ұпай жинаудың екі жолы бар.
Dialogue: 0,0:17:32.16,0:17:33.71,Default,,0,0,0,,Сіз басқа адамның арқасын ұстайсыз ба?
Dialogue: 0,0:17:33.71,0:17:36.35,Default,,0,0,0,,Төрт қалтаны ретімен түртіңіз?
Dialogue: 0,0:17:37.39,0:17:38.99,Default,,0,0,0,,Бұл шынымен бірінші рет пе?
Dialogue: 0,0:17:39.92,0:17:43.36,Default,,0,0,0,,Олай болса, жаңадан бастағандар үшін екі қалтқы жасайық.
Dialogue: 0,0:17:43.70,0:17:45.87,Default,,0,0,0,,Ойын уақыты 5 минутқа екі есе қысқарады.
Dialogue: 0,0:17:46.34,0:17:49.39,Default,,0,0,0,,Егер сіз тіпті бір ұпай ала алсаңыз, бұл сіздің жеңісіңіз.
Dialogue: 0,0:17:49.97,0:17:50.97,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:17:51.19,0:17:53.31,Default,,0,0,0,,Ал, Шион төреші.
Dialogue: 0,0:17:54.31,0:17:57.56,Default,,0,0,0,,Ал сен маған екіншісін беруің керек.
Dialogue: 0,0:17:57.63,0:17:58.70,Default,,0,0,0,,Эй, мен?
Dialogue: 0,0:17:59.12,0:18:00.78,Default,,0,0,0,,Секунд дегеніміз не?
Dialogue: 0,0:18:00.93,0:18:03.04,Default,,0,0,0,,Жерде нұсқау беретін адам.
Dialogue: 0,0:18:03.04,0:18:03.95,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:04.19,0:18:06.62,Default,,0,0,0,,Жаттықтырушы, маған нұсқаулар беріңізші.
Dialogue: 0,0:18:09.33,0:18:12.16,Default,,0,0,0,,Қанаттарыма көк бата
Dialogue: 0,0:18:14.34,0:18:16.06,Default,,0,0,0,,Ей, ақымақ болма.
Dialogue: 0,0:18:16.27,0:18:19.28,Default,,0,0,0,,Аспандағы бірінші қалқымадан бастаңыз
Dialogue: 0,0:18:20.34,0:18:21.18,Default,,0,0,0,,Иә
Dialogue: 0,0:18:21.92,0:18:23.52,Default,,0,0,0,,Шыбында
Dialogue: 0,0:18:26.67,0:18:28.54,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:18:28.85,0:18:29.69,Default,,0,0,0,,Цукуёми, тез бол, тез бол
Dialogue: 0,0:18:30.72,0:18:32.03,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:18:32.79,0:18:33.96,Default,,0,0,0,,бастайық
Dialogue: 0,0:18:34.74,0:18:35.77,Default,,0,0,0,,Орналасуға қатысты
Dialogue: 0,0:18:37.86,0:18:38.49,Default,,0,0,0,,Жиын
Dialogue: 0,0:18:46.91,0:18:49.53,Default,,0,0,0,,Ең алдымен мен бір зат алдым.
Dialogue: 0,0:18:50.59,0:18:52.12,Default,,0,0,0,,Сатоин нүктесі
Dialogue: 0,0:18:52.99,0:18:53.64,Default,,0,0,0,,Бұл
Dialogue: 0,0:18:57.15,0:18:58.89,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:18:59.11,0:19:00.84,Default,,0,0,0,,Көріп отырғаныңыздай, сәйкестік
Dialogue: 0,0:19:04.74,0:19:06.09,Default,,0,0,0,,Курашина мырза
Dialogue: 0,0:19:06.75,0:19:08.56,Default,,0,0,0,,Бұл Такафуджи академиясының студенті
Dialogue: 0,0:19:09.70,0:19:10.89,Default,,0,0,0,,Жарыс үшін жарқыраңыз…
Dialogue: 0,0:19:11.41,0:19:13.23,Default,,0,0,0,,Неліктен мұндай адаммен матч ойнайсың?
Dialogue: 0,0:19:13.31,0:19:16.24,Default,,0,0,0,,Мен сатылмаған жекпе-жекті сатып алдым.
Dialogue: 0,0:19:17.28,0:19:18.48,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:19:18.55,0:19:19.87,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:19:23.30,0:19:25.21,Default,,0,0,0,,Мисаки екіншісін өзгертті
Dialogue: 0,0:19:25.23,0:19:26.24,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:19:28.18,0:19:29.84,Default,,0,0,0,,Курашина-сан, естіп тұрмын.
Dialogue: 0,0:19:29.89,0:19:31.18,Default,,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,0:19:31.91,0:19:33.20,Default,,0,0,0,,Жаттықтырушы Хината
Dialogue: 0,0:19:33.36,0:19:35.28,Default,,0,0,0,,Алдымен қарсыластың жолын жауып тастаңыз.
Dialogue: 0,0:19:36.39,0:19:39.76,Default,,0,0,0,,Қолдарыңызды футбол қақпашысы сияқты жайыңыз.
Dialogue: 0,0:19:40.21,0:19:42.19,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:19:42.31,0:19:45.61,Default,,0,0,0,,Сен мені осындай күзетшімен тоқтата аласың ба?
Dialogue: 0,0:19:47.12,0:19:48.36,Default,,0,0,0,,Мен...келдім.
Dialogue: 0,0:19:48.51,0:19:51.00,Default,,0,0,0,,Содан кейін финт жасап, оның арқасына тигізіңіз.
Dialogue: 0,0:19:51.71,0:19:53.42,Default,,0,0,0,,Қалай болғанда да, оны арқаңызға айналдырып, тигізіңіз.
Dialogue: 0,0:19:53.65,0:19:54.68,Default,,0,0,0,,Ой! Рохан профессор.
Dialogue: 0,0:20:00.29,0:20:01.80,Default,,0,0,0,,Сатоин 2 ұпай
Dialogue: 0,0:20:02.90,0:20:05.58,Default,,0,0,0,,Ұшатын цирк туралы мен білмеймін.
Dialogue: 0,0:20:05.84,0:20:09.39,Default,,0,0,0,,Аспанда да ұша алмаймын
Dialogue: 0,0:20:10.35,0:20:12.60,Default,,0,0,0,,Мені де жалап жіберді.
Dialogue: 0,0:20:23.75,0:20:25.13,Default,,0,0,0,,Сатоин 9 ұпай
Dialogue: 0,0:20:25.23,0:20:26.20,Default,,0,0,0,,9-0
Dialogue: 0,0:20:30.98,0:20:32.26,Default,,0,0,0,,Бұл әлі де жақсы емес пе?
Dialogue: 0,0:20:32.26,0:20:35.56,Default,,0,0,0,,1 ұпай алуыңыз екіталай.
Dialogue: 0,0:20:35.78,0:20:39.00,Default,,0,0,0,,Олай болса мен 10-шы ұпайды беремін.
Dialogue: 0,0:20:39.62,0:20:42.00,Default,,0,0,0,,Неге берілмейсің?
Dialogue: 0,0:20:42.35,0:20:43.82,Default,,0,0,0,,Мен берілмеймін.
Dialogue: 0,0:20:44.16,0:20:47.48,Default,,0,0,0,,Мен Кунахама Гакуиндегі «in» кейіпкерін қорғаймын.
Dialogue: 0,0:20:47.83,0:20:49.90,Default,,0,0,0,,Мен міндетті түрде 1 ұпай аламын және оны сізге көрсетемін.
Dialogue: 0,0:20:52.16,0:20:53.76,Default,,0,0,0,,Мен жеңілгенді жек көремін.
Dialogue: 0,0:20:54.07,0:20:54.78,Default,,0,0,0,,Курашина мырза
Dialogue: 0,0:20:55.23,0:20:55.90,Default,,0,0,0,,Иә
Dialogue: 0,0:20:56.13,0:20:58.62,Default,,0,0,0,,Бұдан былай менің айтқанымды орында.
Dialogue: 0,0:20:58.85,0:21:00.28,Default,,0,0,0,,Әр бұрылыста сезімдеріңе ерік беріп жүру ме?
Dialogue: 0,0:21:00.79,0:21:03.15,Default,,0,0,0,,Сіз жасырын не істеп жатырсыз?
Dialogue: 0,0:21:04.00,0:21:05.98,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:21:06.05,0:21:07.69,Default,,0,0,0,,Менің аяғым әлі жабық
Dialogue: 0,0:21:08.31,0:21:10.19,Default,,0,0,0,,Шалқаңызбен жатып, жоғары көтеріліңіз.
Dialogue: 0,0:21:10.35,0:21:14.73,Default,,0,0,0,,Әй, менің жеңіспен оралуыма арка жасайсың ба?
Dialogue: 0,0:21:15.04,0:21:16.52,Default,,0,0,0,,Міне, кеттіңіз.
Dialogue: 0,0:21:16.99,0:21:19.50,Default,,0,0,0,,Артқа Itadadakimasu
Dialogue: 0,0:21:20.10,0:21:22.20,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:21:25.25,0:21:26.17,Default,,0,0,0,,болдырмайды
Dialogue: 0,0:21:29.47,0:21:30.60,Default,,0,0,0,,10 секундтан кейін
Dialogue: 0,0:21:33.63,0:21:34.67,Default,,0,0,0,,Осы уақытқа дейін?
Dialogue: 0,0:21:36.88,0:21:50.73,Default,,0,0,0,,Өзіңіздің жақсы емес өзіңізді қазір босатыңыз
Dialogue: 0,0:21:55.11,0:21:57.00,Default,,0,0,0,,Ауа соққысы
Dialogue: 0,0:21:57.31,0:21:59.07,Default,,0,0,0,,Мен оны Моулд Колизейге жетпей тұрып жоюым керек
Dialogue: 0,0:21:59.41,0:22:01.96,Default,,0,0,0,,Жарайды... мен жасадым.
Dialogue: 0,0:22:02.42,0:22:04.81,Default,,0,0,0,,Мен 1 ұпай алдым
Dialogue: 0,0:22:07.17,0:22:08.36,Default,,0,0,0,,Нүкте
Dialogue: 0,0:22:11.47,0:22:12.81,Default,,0,0,0,,Бұл Асука Курашина.
Dialogue: 0,0:23:45.78,0:23:47.23,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:23:47.23,0:23:50.63,Default,,0,0,0,,Мен мұны қайталаймын деп ойламадым.
Dialogue: 0,0:23:50.63,0:23:51.44,Default,,0,0,0,,Мен...
Dialogue: 0,0:23:51.57,0:23:53.47,Default,,0,0,0,,Ммм… мм…
Dialogue: 0,0:23:53.95,0:23:55.12,Default,,0,0,0,,Арнайы...
Dialogue: 0,0:23:56.62,0:24:02.62,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory