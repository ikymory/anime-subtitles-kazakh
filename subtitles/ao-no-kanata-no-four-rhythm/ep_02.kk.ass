Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.02,0:00:06.00,Default,,0,0,0,,Әуе соққысымен бұрылыс?
Dialogue: 0,0:00:06.03,0:00:08.04,Default,,0,0,0,,Мен оны Моулд Колизейге жетпей тұрып жоюым керек
Dialogue: 0,0:00:09.38,0:00:10.73,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:00:10.91,0:00:13.28,Default,,0,0,0,,Мен 1 ұпай алдым
Dialogue: 0,0:00:15.83,0:00:18.93,Default,,0,0,0,,Әуе соққысы шынымен де ғажайып па?
Dialogue: 0,0:00:18.93,0:00:22.97,Default,,0,0,0,,Бұл ұшатын цирктегі ең қиын трюктердің бірі.
Dialogue: 0,0:00:24.00,0:00:26.46,Default,,0,0,0,,Ауаны тепкендей қарама-қарсы бағытта ұшу
Dialogue: 0,0:00:26.95,0:00:29.34,Default,,0,0,0,,Мембрананы еркін басқару мүмкін емес
Dialogue: 0,0:00:30.50,0:00:32.17,Default,,0,0,0,,Ерлер... Брен?
Dialogue: 0,0:00:32.45,0:00:34.33,Default,,0,0,0,,Бұл гравитацияға қарсы мембрана туралы.
Dialogue: 0,0:00:34.79,0:00:38.18,Default,,0,0,0,,Қалай болғанда да, әуе соққысы мектеп бақтарында айналады.
Dialogue: 0,0:00:38.18,0:00:39.59,Default,,0,0,0,,Қалыпты нәрсе жоқ.
Dialogue: 0,0:00:39.59,0:00:42.91,Default,,0,0,0,,Жаңадан бастаушылар шынтақты қалай қолданатынына ұқсас
Dialogue: 0,0:00:45.07,0:00:46.08,Default,,0,0,0,,Матчтың соңы
Dialogue: 0,0:00:46.64,0:00:49.00,Default,,0,0,0,,Бұл кездесуде Асука Курашина жеңеді
Dialogue: 0,0:00:49.52,0:00:51.80,Default,,0,0,0,,Жаттықтырушы жеңді
Dialogue: 0,0:00:52.69,0:00:54.20,Default,,0,0,0,,Мұндай жағдайларды алдын ала болжайтын сен — нағыз кереметсің.
Dialogue: 0,0:00:54.58,0:00:56.46,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:00:56.59,0:00:58.89,Default,,0,0,0,,Flying Succulent қызықты болды
Dialogue: 0,0:00:59.04,0:01:00.40,Default,,0,0,0,,Құттықтаймыз Курашина...
Dialogue: 0,0:01:01.59,0:01:02.51,Default,,0,0,0,,Рахмет
Dialogue: 0,0:01:02.85,0:01:06.03,Default,,0,0,0,,Сіздің арқаңызда Кунахама академиясының сипаты сақталды.
Dialogue: 0,0:01:06.75,0:01:07.93,Default,,0,0,0,,Мен осындамын.
Dialogue: 0,0:01:09.89,0:01:12.59,Default,,0,0,0,,Сенің маған не істегеніңді білмедім.
Dialogue: 0,0:01:12.72,0:01:13.74,Default,,0,0,0,,Сатоин мырза
Dialogue: 0,0:01:13.81,0:01:15.23,Default,,0,0,0,,Не...не?
Dialogue: 0,0:01:15.31,0:01:18.75,Default,,0,0,0,,Менімен ойнағандарыңызға рахмет.
Dialogue: 0,0:01:19.70,0:01:23.68,Default,,0,0,0,,Жарайды, сен ақылсызсың, бірақ қызық екен.
Dialogue: 0,0:01:24.05,0:01:25.95,Default,,0,0,0,,Менімен тағы ұрыс
Dialogue: 0,0:01:26.59,0:01:27.24,Default,,0,0,0,,Иә
Dialogue: 0,0:01:28.03,0:01:30.91,Default,,0,0,0,,Қанатымда көк бата
Dialogue: 0,0:01:36.58,0:01:38.71,Default,,0,0,0,,Жаттықтырушы Хината, рахмет...
Dialogue: 0,0:01:38.71,0:01:40.11,Default,,0,0,0,,Сіз Хината-кун айттыңыз.
Dialogue: 0,0:01:41.60,0:01:43.76,Default,,0,0,0,,Ұшатын циркте тәжірибеңіз болуы керек.
Dialogue: 0,0:01:43.76,0:01:45.87,Default,,0,0,0,,Бұл тамаша стратегия мен нұсқаулар болды.
Dialogue: 0,0:01:45.99,0:01:47.21,Default,,0,0,0,,Тәжірибелі...
Dialogue: 0,0:01:47.73,0:01:49.31,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:01:49.79,0:01:53.58,Default,,0,0,0,,Алайда, Сатоин мырзаның қозғалыстары негізінен көлденең осьте болды.
Dialogue: 0,0:01:53.83,0:01:57.39,Default,,0,0,0,,Мен кенет тік осьте қозғалысқа қарсы әлсіз шығар деп ойладым.
Dialogue: 0,0:01:57.39,0:01:58.48,Default,,0,0,0,,(Отокоцудың дауысы)
Dialogue: 0,0:01:58.61,0:02:00.58,Default,,0,0,0,,Біздің осы жерде танысуымыз кездейсоқ болды.
Dialogue: 0,0:02:00.58,0:02:02.08,Default,,0,0,0,,Жоқ, бұл тағдыр.
Dialogue: 0,0:02:02.08,0:02:06.89,Default,,0,0,0,,Сіз Кунахама академиясының ұшатын цирк клубының құтқарушыларысыз.
Dialogue: 0,0:02:06.91,0:02:09.35,Default,,0,0,0,,Енді қолымыздан келгеннің бәрін бірге жасайық...
Dialogue: 0,0:02:09.35,0:02:10.88,Default,,0,0,0,,Эй
Dialogue: 0,0:03:42.64,0:03:48.08,Default,,0,0,0,,Мисаки Сенпай Мисаки Сенпай
Dialogue: 0,0:03:48.27,0:03:53.07,Default,,0,0,0,,Мен сені сағындым, Мисаки.
Dialogue: 0,0:03:54.85,0:03:56.38,Default,,0,0,0,,Сенпай Сенпай
Dialogue: 0,0:03:57.19,0:03:58.92,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:59.65,0:04:01.47,Default,,0,0,0,,Қайырлы таң Маширо-чан
Dialogue: 0,0:04:01.71,0:04:02.99,Default,,0,0,0,,Бүгінгі қолдауыңыз үшін рахмет.
Dialogue: 0,0:04:03.11,0:04:03.84,Default,,0,0,0,,Иә
Dialogue: 0,0:04:09.23,0:04:11.00,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:04:11.11,0:04:14.20,Default,,0,0,0,,Мисаки-сенпай, бүгін төсекте де керемет көрінесің.
Dialogue: 0,0:04:14.48,0:04:15.79,Default,,0,0,0,,Ояныңыз
Dialogue: 0,0:04:15.92,0:04:19.48,Default,,0,0,0,,Мисаки-сенпай, бұл удон.
Dialogue: 0,0:04:21.23,0:04:22.51,Default,,0,0,0,,Ум...дон?
Dialogue: 0,0:04:23.19,0:04:24.75,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:04:25.31,0:04:27.44,Default,,0,0,0,,Күн сайын таңертең көп жұмыс қажет.
Dialogue: 0,0:04:27.44,0:04:29.47,Default,,0,0,0,,Бұл да жақсы.
Dialogue: 0,0:04:29.47,0:04:31.61,Default,,0,0,0,,Су асты сүңгуіршілердің бәрі бір ауыздан келіседі:
Dialogue: 0,0:04:31.97,0:04:33.42,Default,,0,0,0,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:04:33.43,0:04:34.57,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:04:36.39,0:04:40.66,Default,,0,0,0,,Неліктен мен күнде таңертең мектепке баруым керек?
Dialogue: 0,0:04:40.66,0:04:43.05,Default,,0,0,0,,Сенпай, күнде айтамын.
Dialogue: 0,0:04:44.42,0:04:45.52,Default,,0,0,0,,Не
Dialogue: 0,0:04:49.55,0:04:51.36,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:04:52.43,0:04:55.76,Default,,0,0,0,,Өйткені, сол қалпыңыз болмаса, тепе-теңдікті сақтай алмайсыз.
Dialogue: 0,0:04:56.07,0:04:57.39,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:04:57.54,0:05:00.94,Default,,0,0,0,,Менің ойымша, бұл жаңадан бастағандар үшін сәттілік. Кешегісі
Dialogue: 0,0:05:03.84,0:05:05.69,Default,,0,0,0,,Мен естідім, Курашина-сан.
Dialogue: 0,0:05:05.83,0:05:10.32,Default,,0,0,0,,Мен кеше Такато Гакуеннен Сатоин мырзаға қарсы 1 ұпай алғаныңызды естідім.
Dialogue: 0,0:05:10.64,0:05:13.92,Default,,0,0,0,,Біз Куахама Гакуиннің мінезін сақтап қалдық.
Dialogue: 0,0:05:14.10,0:05:16.48,Default,,0,0,0,,Бүкіл мектеп біледі ме?
Dialogue: 0,0:05:16.98,0:05:17.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:18.13,0:05:21.91,Default,,0,0,0,,Әйтеуір, Сатоин мырза ұшатын цирктің әйгілі мүшесі.
Dialogue: 0,0:05:21.91,0:05:24.96,Default,,0,0,0,,Ол Такафуджи академиясының вице-президенті, солай ма?
Dialogue: 0,0:05:26.45,0:05:28.20,Default,,0,0,0,,Бұл киім керемет
Dialogue: 0,0:05:28.48,0:05:30.32,Default,,0,0,0,,Бұл ұшатын костюм.
Dialogue: 0,0:05:30.34,0:05:33.29,Default,,0,0,0,,Ал, салқыны Курашина-сан.
Dialogue: 0,0:05:34.13,0:05:38.05,Default,,0,0,0,,Неліктен мұндай әуесқой Сатоин мырзадан ұпай алады?
Dialogue: 0,0:05:38.05,0:05:40.97,Default,,0,0,0,,Ғасырдың күйзелісі сияқты.
Dialogue: 0,0:05:41.03,0:05:45.25,Default,,0,0,0,,Иә, бұл Америка мен Англия арасындағы кездесу болды, бұл турнир тарихындағы ең үлкен реніш.
Dialogue: 0,0:05:45.25,0:05:47.43,Default,,0,0,0,,Кәсіби лига 36 жылдан бері тоқтатылды.
Dialogue: 0,0:05:47.43,0:05:49.22,Default,,0,0,0,,Америка Құрама Штаттары, онда барлық спортшылар әуесқой болды.
Dialogue: 0,0:05:49.22,0:05:53.60,Default,,0,0,0,,Англияға қарсы матч, ол 22 жеңіс пен 4 жеңілістің керемет рекордына ие болды.
Dialogue: 0,0:05:54.48,0:05:55.74,Default,,0,0,0,,күйіп қалу
Dialogue: 0,0:05:56.37,0:05:57.55,Default,,0,0,0,,Мен саған сол журналды беремін.
Dialogue: 0,0:05:57.91,0:05:59.48,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:59.87,0:06:03.43,Default,,0,0,0,,Аояги мырзаның ұшатын циркі бар ма?
Dialogue: 0,0:06:03.43,0:06:04.83,Default,,0,0,0,,Мен менеджермін
Dialogue: 0,0:06:04.90,0:06:07.55,Default,,0,0,0,,Мен кеше ғана осында келдім, себебі ағам өтінді.
Dialogue: 0,0:06:08.00,0:06:09.94,Default,,0,0,0,,Менің жоғары сынып оқушыларымның барлығы бітірді.
Dialogue: 0,0:06:09.94,0:06:12.27,Default,,0,0,0,,Енді тек менеджердің ағасы екеуміз ғана қалдық.
Dialogue: 0,0:06:12.45,0:06:13.96,Default,,0,0,0,,Қаласаңыз, клубқа қосылыңыз.
Dialogue: 0,0:06:14.16,0:06:14.89,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:15.30,0:06:17.17,Default,,0,0,0,,Қайырлы таң жаттықтырушы
Dialogue: 0,0:06:17.17,0:06:20.59,Default,,0,0,0,,Естідім, естідім, кешегі жарқыраған секунд.
Dialogue: 0,0:06:20.67,0:06:22.88,Default,,0,0,0,,Хината-кун ФК ойнады.
Dialogue: 0,0:06:23.12,0:06:26.30,Default,,0,0,0,,Кішкентай кезімде.
Dialogue: 0,0:06:26.50,0:06:28.75,Default,,0,0,0,,Тәжірибелі адамдар қабылданады
Dialogue: 0,0:06:28.75,0:06:30.75,Default,,0,0,0,,Хината-кун да біздің ФК клубына қосылуы керек...
Dialogue: 0,0:06:30.42,0:06:31.37,Default,,0,0,0,,Мен кірмеймін
Dialogue: 0,0:06:34.55,0:06:36.57,Default,,0,0,0,,Сабақ Аояги басталады
Dialogue: 0,0:06:37.44,0:06:38.08,Default,,0,0,0,,Иә
Dialogue: 0,0:06:41.94,0:06:45.02,Default,,0,0,0,,Сыртта жеген Цуке удон кеспесі ең жақсы!
Dialogue: 0,0:06:45.17,0:06:48.67,Default,,0,0,0,,Мисаки-сенпайдың маринадталған күріш кебегі де өте дәмді.
Dialogue: 0,0:06:49.36,0:06:50.30,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:06:51.73,0:06:53.15,Default,,0,0,0,,Бұл... мынау ма?
Dialogue: 0,0:06:53.70,0:06:56.38,Default,,0,0,0,,Мен бәрін жаздым, сондықтан мен оны тапсыруым керек.
Dialogue: 0,0:06:56.63,0:06:58.12,Default,,0,0,0,,Екі адамға да жетеді.
Dialogue: 0,0:06:58.15,0:06:59.72,Default,,0,0,0,,Сіз өте шеберсіз
Dialogue: 0,0:06:59.76,0:07:01.39,Default,,0,0,0,,Жоқ, бұл жалған құжат шығар.
Dialogue: 0,0:07:01.79,0:07:04.82,Default,,0,0,0,,Жоқ, бұл менің қолжазбама қатты ұқсайды.
Dialogue: 0,0:07:04.82,0:07:07.28,Default,,0,0,0,,Енді сәлемдесу кешіне сусын қызметі кіреді.
Dialogue: 0,0:07:07.28,0:07:09.20,Default,,0,0,0,,Бұл науқан емес.
Dialogue: 0,0:07:09.20,0:07:10.24,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:07:10.24,0:07:12.86,Default,,0,0,0,,Аояги-сенпай тым дарынды барлаушы.
Dialogue: 0,0:07:13.63,0:07:15.04,Default,,0,0,0,,Мен қосыламын
Dialogue: 0,0:07:15.51,0:07:18.86,Default,,0,0,0,,Мен жақсы емеспін, бірақ мен сіздің көмегіңізді бағалаймын.
Dialogue: 0,0:07:18.98,0:07:22.24,Default,,0,0,0,,Мен мұны істедім. Рахмет, Курашина-сан.
Dialogue: 0,0:07:19.46,0:07:21.75,Default,,0,0,0,,Шешуші фактор сусын қызметі болып табылады.
Dialogue: 0,0:07:21.75,0:07:23.31,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:07:23.33,0:07:25.12,Default,,0,0,0,,Мисаки менімен де олай істемейді.
Dialogue: 0,0:07:25.17,0:07:26.62,Default,,0,0,0,,Сіз мұны бұрын жасаған болуыңыз керек.
Dialogue: 0,0:07:28.02,0:07:29.82,Default,,0,0,0,,Мен не істеуім керек, Канян?
Dialogue: 0,0:07:31.25,0:07:34.20,Default,,0,0,0,,Сенпай, таңғы жаттығуға міндетті түрде қатыса алмайсың.
Dialogue: 0,0:07:34.23,0:07:37.31,Default,,0,0,0,,Мен өз қарқыныммен жүрмін, сондықтан мен үшін спортшы болуы мүмкін емес.
Dialogue: 0,0:07:37.67,0:07:39.45,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:39.67,0:07:41.74,Default,,0,0,0,,Тобисава-сан, жасайық.
Dialogue: 0,0:07:43.55,0:07:45.52,Default,,0,0,0,,Мен бұл туралы ойланамын.
Dialogue: 0,0:07:48.58,0:07:52.15,Default,,0,0,0,,Өмір бойы денсаулықты қалай сақтауға болады?
Dialogue: 0,0:07:50.34,0:07:51.87,Default,,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:07:52.72,0:07:57.37,Default,,0,0,0,,Мен мұны қайталаймын деп ойламадым.
Dialogue: 0,0:07:59.63,0:08:00.68,Default,,0,0,0,,Курашина
Dialogue: 0,0:08:02.10,0:08:03.08,Default,,0,0,0,,Бұл жасырын емес.
Dialogue: 0,0:08:05.19,0:08:08.04,Default,,0,0,0,,Мен...кешіріңіз...кешіріңіз.
Dialogue: 0,0:08:16.90,0:08:19.80,Default,,0,0,0,,Ұшатын цирк клубына қош келдіңіз
Dialogue: 0,0:08:20.85,0:08:22.09,Default,,0,0,0,,Хаа, міне
Dialogue: 0,0:08:23.83,0:08:24.65,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:08:25.52,0:08:26.88,Default,,0,0,0,,Бұл клуб бөлмесі ме?
Dialogue: 0,0:08:26.88,0:08:29.32,Default,,0,0,0,,Дұрыс, кіріңіз, кіріңіз.
Dialogue: 0,0:08:30.08,0:08:31.95,Default,,0,0,0,,Кешіріңіз, бұл кішкентай
Dialogue: 0,0:08:32.21,0:08:35.62,Default,,0,0,0,,Әй, аға, мен саған дұрыстап жинап ал дедім ғой.
Dialogue: 0,0:08:35.62,0:08:37.28,Default,,0,0,0,,Менің бұған уақытым болмады.
Dialogue: 0,0:08:37.33,0:08:38.30,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:08:39.28,0:08:41.63,Default,,0,0,0,,Эй, бұл клуб бөлмесі.
Dialogue: 0,0:08:43.28,0:08:45.63,Default,,0,0,0,,Тобисава-сан мен Арисака-сан да
Dialogue: 0,0:08:45.65,0:08:48.81,Default,,0,0,0,,Неліктен мен клубқа қосылмауым керек?
Dialogue: 0,0:08:48.85,0:08:49.64,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:08:49.65,0:08:53.20,Default,,0,0,0,,Мисаки-сенпай клубқа кіргенде, мен міндетті түрде оның соңынан еремін.
Dialogue: 0,0:08:54.67,0:08:57.64,Default,,0,0,0,,Үйірме мүшелерінің саны бірден үшке көбейді.
Dialogue: 0,0:08:57.75,0:08:59.00,Default,,0,0,0,,Жарайсың, ағайын.
Dialogue: 0,0:08:59.22,0:09:02.40,Default,,0,0,0,,Жарайды, ертеңнен бастап бірден жаттығу жасайық.
Dialogue: 0,0:09:03.17,0:09:04.24,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:09:05.22,0:09:06.75,Default,,0,0,0,,Күндізгі ауысымдағы қажырлы еңбегіңіз үшін рахмет.
Dialogue: 0,0:09:08.16,0:09:09.53,Default,,0,0,0,,Ақия не ойлайды?
Dialogue: 0,0:09:11.86,0:09:15.56,Default,,0,0,0,,Курашина мен Тобисава Арисаканың тағы бір жылға қосылу есебі
Dialogue: 0,0:09:16.23,0:09:18.84,Default,,0,0,0,,Кунахама ФК клубы клубтық күйде болды.
Dialogue: 0,0:09:19.09,0:09:21.32,Default,,0,0,0,,Бірден үш жаңа мүше
Dialogue: 0,0:09:22.16,0:09:23.45,Default,,0,0,0,,Колизейдің кіреберісі ғой?
Dialogue: 0,0:09:24.75,0:09:28.25,Default,,0,0,0,,Енді мен ерекше ештеңе жоқ деп ойлаймын.
Dialogue: 0,0:09:30.47,0:09:31.20,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:31.87,0:09:36.11,Default,,0,0,0,,Курашина нұсқаушысы туралы жеткілікті.
Dialogue: 0,0:09:36.63,0:09:37.96,Default,,0,0,0,,ФК клубына қосылғыңыз келсе
Dialogue: 0,0:09:38.83,0:09:40.16,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз
Dialogue: 0,0:09:41.75,0:09:44.09,Default,,0,0,0,,Құрметпен, жаттықтырушы
Dialogue: 0,0:09:44.96,0:09:49.79,Default,,0,0,0,,Мен ұшамын Мен ұшамын
Dialogue: 0,0:10:34.34,0:10:36.84,Default,,0,0,0,,Не болды, жаттықтырушы Хината?
Dialogue: 0,0:10:37.11,0:10:38.67,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:10:41.07,0:10:44.33,Default,,0,0,0,,Курашина мырза, мен енді сіздің бапкеріңіз емеспін.
Dialogue: 0,0:10:45.71,0:10:46.83,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:10:47.30,0:10:50.05,Default,,0,0,0,,Егер сіз FC клубына қосылсаңыз, ол сізге енді қажет болмайды.
Dialogue: 0,0:10:50.05,0:10:51.88,Default,,0,0,0,,Мен Кагами-сенсейге айттым
Dialogue: 0,0:10:52.63,0:10:54.27,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:56.55,0:10:59.21,Default,,0,0,0,,Жарайды, жаттығуды бастайық.
Dialogue: 0,0:10:59.60,0:11:02.17,Default,,0,0,0,,Мен күйіп қалдым
Dialogue: 0,0:11:04.31,0:11:07.39,Default,,0,0,0,,Ал, әуелі қалқымалардың арасында ұшуға жаттығып алайық.
Dialogue: 0,0:11:07.62,0:11:08.22,Default,,0,0,0,,Иә
Dialogue: 0,0:11:08.29,0:11:09.66,Default,,0,0,0,,Әр сынып үшін түрлі жарыстарға іріктеу кезеңдері өткізіледі—
Dialogue: 0,0:11:11.44,0:11:13.42,Default,,0,0,0,,Бір ойнағаныма біраз болды.
Dialogue: 0,0:11:13.59,0:11:15.95,Default,,0,0,0,,Мисаки-сенпайдың ынтасы сондай
Dialogue: 0,0:11:18.31,0:11:20.01,Default,,0,0,0,,Ақия, үйге барасың ба?
Dialogue: 0,0:11:22.24,0:11:22.89,Default,,0,0,0,,Иә
Dialogue: 0,0:11:23.75,0:11:26.28,Default,,0,0,0,,Неге қарамайсың? Біраз уақыт өтті.
Dialogue: 0,0:11:33.94,0:11:37.44,Default,,0,0,0,,Мисаки-сенпай, күте тұрыңыз.
Dialogue: 0,0:11:41.87,0:11:44.88,Default,,0,0,0,,Ол жаңадан келген, болашағы жақсы.
Dialogue: 0,0:11:45.25,0:11:47.44,Default,,0,0,0,,Егер сіз өзіңіздің негізгі физикалық күшіңізді жинамасаңыз, бұл жақсы емес.
Dialogue: 0,0:11:47.73,0:11:50.57,Default,,0,0,0,,Алдымен жүгіру арқылы өзегіңізді жаттықтырыңыз.
Dialogue: 0,0:11:50.83,0:11:53.04,Default,,0,0,0,,Реакция жылдамдығын арттыруға жаттықтыру
Dialogue: 0,0:11:53.28,0:11:55.85,Default,,0,0,0,,Егер солай ойласаңыз, маған кеңес беріңіз.
Dialogue: 0,0:11:56.53,0:11:58.27,Default,,0,0,0,,Мен бөгде адаммын
Dialogue: 0,0:12:01.91,0:12:03.95,Default,,0,0,0,,Мисаки Сенпай
Dialogue: 0,0:12:04.91,0:12:08.91,Default,,0,0,0,,Артық емес, артық емес
Dialogue: 0,0:12:08.98,0:12:12.32,Default,,0,0,0,,Менің HP нөлге тең.
Dialogue: 0,0:12:13.11,0:12:14.48,Default,,0,0,0,,Рух жеткіліксіз
Dialogue: 0,0:12:14.59,0:12:16.78,Default,,0,0,0,,Онда сіз жазғы турнирге уақытында үлгере алмайсыз.
Dialogue: 0,0:12:16.93,0:12:19.55,Default,,0,0,0,,Жарайды, бүгін бірінші күн.
Dialogue: 0,0:12:19.73,0:12:23.82,Default,,0,0,0,,Мен қазірден бастап жарыс гуляш пен ұшатын костюмді дайындауым керек.
Dialogue: 0,0:12:24.02,0:12:27.80,Default,,0,0,0,,Дұрыс. Барлық құрал-жабдық тек менеджерде болатыны қулық.
Dialogue: 0,0:12:29.17,0:12:30.06,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:12:30.34,0:12:32.94,Default,,0,0,0,,Ертең сенбі, ендеше бәріміз дүкен аралауға бармаймыз ба?
Dialogue: 0,0:12:33.22,0:12:36.75,Default,,0,0,0,,Менің стақанымды қолданбағаныма біраз болды.
Dialogue: 0,0:12:36.75,0:12:37.96,Default,,0,0,0,,Мен де техникалық қызмет көрсеткім келеді
Dialogue: 0,0:12:38.47,0:12:39.39,Default,,0,0,0,,Курашина-сан ше?
Dialogue: 0,0:12:39.68,0:12:41.47,Default,,0,0,0,,Иә, барамын.
Dialogue: 0,0:12:41.68,0:12:44.40,Default,,0,0,0,,Ал бәріміз жазғы турнирге барайық
Dialogue: 0,0:12:44.53,0:12:45.93,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:12:45.99,0:12:48.37,Default,,0,0,0,,Менің ойымша, мен оған көбірек күш салуым керек.
Dialogue: 0,0:12:48.37,0:12:48.88,Default,,0,0,0,,Иә
Dialogue: 0,0:12:53.19,0:12:54.86,Default,,0,0,0,,Кокчи Кокчи
Dialogue: 0,0:12:55.14,0:12:56.66,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:12:56.66,0:12:57.35,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:12:57.35,0:12:58.71,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:12:58.71,0:13:01.20,Default,,0,0,0,,Қайырлы таң, осылай.
Dialogue: 0,0:13:01.38,0:13:01.96,Default,,0,0,0,,Иә
Dialogue: 0,0:13:05.12,0:13:06.89,Default,,0,0,0,,Төбесі биік
Dialogue: 0,0:13:07.47,0:13:10.14,Default,,0,0,0,,Дүкенде сынақ рейстерін жасауға болады ма?
Dialogue: 0,0:13:10.85,0:13:12.65,Default,,0,0,0,,Сәлем Ширасе-сан
Dialogue: 0,0:13:12.98,0:13:13.87,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:13:14.26,0:13:15.66,Default,,0,0,0,,Хоу Мадока-чан
Dialogue: 0,0:13:15.94,0:13:17.66,Default,,0,0,0,,Бүгін ағаңның қасында емессің бе?
Dialogue: 0,0:13:17.97,0:13:22.33,Default,,0,0,0,,Бүгін мен Кунахама Гакуин ФК клубының жаңа мүшесін әкелдім.
Dialogue: 0,0:13:23.33,0:13:24.92,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:13:29.70,0:13:31.63,Default,,0,0,0,,Зашикивараши...?
Dialogue: 0,0:13:32.11,0:13:33.60,Default,,0,0,0,,Бұл менің әпкем Минамо.
Dialogue: 0,0:13:34.15,0:13:35.02,Default,,0,0,0,,Жоғарыға шығыңыз
Dialogue: 0,0:13:35.54,0:13:37.44,Default,,0,0,0,,Барлығына жарасатын стақан тауып беремін.
Dialogue: 0,0:13:37.79,0:13:39.37,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:42.31,0:13:44.59,Default,,0,0,0,,Гураштың қандай түрлері бар...
Dialogue: 0,0:13:44.79,0:13:45.66,Default,,0,0,0,,Манекен...
Dialogue: 0,0:13:46.72,0:13:48.28,Default,,0,0,0,,Түрі?
Dialogue: 0,0:13:48.59,0:13:49.77,Default,,0,0,0,,Гүлаштың...
Dialogue: 0,0:13:49.97,0:13:54.16,Default,,0,0,0,,Үш түрі бар: жүйрік, жекпе-жек және көпсайыс.
Dialogue: 0,0:13:55.57,0:13:58.30,Default,,0,0,0,,Аяқ киім әр ойын стиліне байланысты әртүрлі.
Dialogue: 0,0:13:59.03,0:14:02.46,Default,,0,0,0,,Қалқымаларды тез тигізу арқылы ұпайларды көбейтетін жылдамдық түрі
Dialogue: 0,0:14:03.33,0:14:06.51,Default,,0,0,0,,Арқаны түртіп ұпай жинайтын жауынгер түрі
Dialogue: 0,0:14:07.22,0:14:09.36,Default,,0,0,0,,Екеуіне де шебер жан-жақты
Dialogue: 0,0:14:10.18,0:14:11.69,Default,,0,0,0,,Әр түрі бойынша
Dialogue: 0,0:14:11.78,0:14:14.17,Default,,0,0,0,,Гүләш қабықшасының созылу тәсілі өзгереді.
Dialogue: 0,0:14:14.39,0:14:17.77,Default,,0,0,0,,Мембрана Сіз гравитацияға қарсы мембрананы айтасыз ба?
Dialogue: 0,0:14:17.87,0:14:18.78,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:14:19.43,0:14:21.34,Default,,0,0,0,,Гураш гравитацияға қарсы әсерінен қалқып шығады.
Dialogue: 0,0:14:21.49,0:14:23.81,Default,,0,0,0,,Жердің тартылыс күшінің әсерінен қозғалады.
Dialogue: 0,0:14:23.81,0:14:25.26,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,0:14:25.47,0:14:28.74,Default,,0,0,0,,-де мембрананы қалыңдату немесе жұқа ету арқылы
Dialogue: 0,0:14:28.74,0:14:30.16,Default,,0,0,0,,Мен алға жылжамын
Dialogue: 0,0:14:30.72,0:14:33.98,Default,,0,0,0,,Жылдамдықты арттырғыш жылдамдыққа кедергі келтірмейтіндей етіп реттеледі.
Dialogue: 0,0:14:34.35,0:14:38.80,Default,,0,0,0,,Жауынгерлердің жылдамдығы төмендейді, бірақ ептіліктері артады.
Dialogue: 0,0:14:38.80,0:14:40.84,Default,,0,0,0,,Мен ағамның айтқанын түсінемін.
Dialogue: 0,0:14:41.04,0:14:43.08,Default,,0,0,0,,Бірақ қай түрі жақсы?
Dialogue: 0,0:14:43.28,0:14:45.05,Default,,0,0,0,,Мен толық бастаушымын, сондықтан
Dialogue: 0,0:14:45.41,0:14:49.69,Default,,0,0,0,,Ең алдымен, мен жан-жақты түрін ұсынамын.
Dialogue: 0,0:14:50.00,0:14:54.59,Default,,0,0,0,,Аяқ киімде ұқыпты реттеуге мүмкіндік беретін теңгергіш бар.
Dialogue: 0,0:14:54.67,0:14:56.76,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:14:57.23,0:14:59.81,Default,,0,0,0,,Мисаки-сенпай қандай түрге жатады?
Dialogue: 0,0:14:59.81,0:15:02.24,Default,,0,0,0,,Е, мен күрескермін.
Dialogue: 0,0:15:02.39,0:15:05.42,Default,,0,0,0,,Сонда мен де күрескермін.
Dialogue: 0,0:15:05.43,0:15:07.72,Default,,0,0,0,,Онда мен мұны істеймін
Dialogue: 0,0:15:08.75,0:15:10.16,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:15:10.23,0:15:14.06,Default,,0,0,0,,Мен өзімнің сүйкімділігімді Мисаки-сенпайға жүгіну үшін қару ретінде пайдалануды шештім.
Dialogue: 0,0:15:14.26,0:15:15.88,Default,,0,0,0,,Бұл жылдамдықты арттыратындарға арналған.
Dialogue: 0,0:15:16.11,0:15:18.96,Default,,0,0,0,,Мен Гурашты сатып алудың мақсаты туралы білмеймін.
Dialogue: 0,0:15:19.91,0:15:22.91,Default,,0,0,0,,Енді оны жауынгерге ұқсайтын етіп реттейік.
Dialogue: 0,0:15:22.95,0:15:24.60,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:15:27.36,0:15:28.32,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:15:29.33,0:15:30.75,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:31.73,0:15:35.50,Default,,0,0,0,,Ұшатын костюмнің аяқталуына шамамен бір ай қажет сияқты.
Dialogue: 0,0:15:36.58,0:15:38.00,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:15:38.05,0:15:41.58,Default,,0,0,0,,Бұған дейін мен бәсекелесу үшін жеткілікті түрде жетілуім керек.
Dialogue: 0,0:15:41.59,0:15:44.62,Default,,0,0,0,,Иә, бәрібір жаман.
Dialogue: 0,0:15:46.00,0:15:46.83,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:46.85,0:15:50.18,Default,,0,0,0,,Мүмкін фантомдық электромеханикалық аркада ойыны шығар?
Dialogue: 0,0:15:50.18,0:15:52.27,Default,,0,0,0,,Тауға түсу ойынының қайта басылған нұсқасында...
Dialogue: 0,0:15:53.01,0:15:55.74,Default,,0,0,0,,Жарайды, мен қазір үйге қайтатын шығармын.
Dialogue: 0,0:15:56.96,0:15:57.55,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:57.28,0:15:59.00,Default,,0,0,0,,Жасайық
Dialogue: 0,0:15:59.41,0:16:00.91,Default,,0,0,0,,Маған ұнамайды, әбігер
Dialogue: 0,0:16:00.55,0:16:01.60,Default,,0,0,0,,Жасайық
Dialogue: 0,0:16:01.60,0:16:03.04,Default,,0,0,0,,Маған ұнамайды, әбігер.
Dialogue: 0,0:16:01.89,0:16:03.45,Default,,0,0,0,,Мисаки Сенпай...
Dialogue: 0,0:16:04.40,0:16:05.89,Default,,0,0,0,,Маған ұнамайды, қиыншылық тудырады.
Dialogue: 0,0:16:01.59,0:16:03.77,Default,,0,0,0,,Біз әлі де жақсы доспыз
Dialogue: 0,0:16:03.86,0:16:05.00,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:16:06.02,0:16:07.71,Default,,0,0,0,,Сондықтан мен де солай істеймін.
Dialogue: 0,0:16:07.73,0:16:09.60,Default,,0,0,0,,Ал, дүйсенбі мектепте.
Dialogue: 0,0:16:09.60,0:16:11.69,Default,,0,0,0,,Құрашина-сенпай, оны да жасайық.
Dialogue: 0,0:16:12.34,0:16:15.07,Default,,0,0,0,,Мен ойындарда жақсы емеспін т.б.
Dialogue: 0,0:16:31.70,0:16:33.98,Default,,0,0,0,,Жамбасымызды көбірек босаңсайық.
Dialogue: 0,0:16:41.68,0:16:44.06,Default,,0,0,0,,Соңында, бәсекеге қабілетті Glash
Dialogue: 0,0:16:44.26,0:16:46.25,Default,,0,0,0,,Курашина, аяғыңызды төмен түсіріңіз.
Dialogue: 0,0:16:46.83,0:16:47.82,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:48.15,0:16:50.31,Default,,0,0,0,,Ал, мен де бүгін көңіл-күйімді көтеремін...
Dialogue: 0,0:16:50.31,0:16:52.83,Default,,0,0,0,,Директор, менің сізден бір өтінішім бар.
Dialogue: 0,0:16:52.83,0:16:53.60,Default,,0,0,0,,Не?
Dialogue: 0,0:16:53.75,0:16:55.74,Default,,0,0,0,,Мен сіріңке ойнағым келеді.
Dialogue: 0,0:16:56.55,0:16:59.31,Default,,0,0,0,,Күтілгендей, тек нақты ұрыс бар.
Dialogue: 0,0:16:59.39,0:17:00.49,Default,,0,0,0,,Мен ұнайсың ба?
Dialogue: 0,0:17:00.53,0:17:02.60,Default,,0,0,0,,Жоқ Курашина мырза
Dialogue: 0,0:17:03.67,0:17:04.88,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:17:04.95,0:17:06.99,Default,,0,0,0,,О, бұл жақсы.
Dialogue: 0,0:17:07.06,0:17:10.35,Default,,0,0,0,,Курашина, маған ауа соққысының бұрылуын көрсет.
Dialogue: 0,0:17:10.35,0:17:11.84,Default,,0,0,0,,бірақ газ бітті, қабырғаға өре алмаймыз.
Dialogue: 0,0:17:12.39,0:17:14.51,Default,,0,0,0,,Ендеше бірге шырылдаймыз
Dialogue: 0,0:17:16.08,0:17:17.77,Default,,0,0,0,,Минут...Түсіндім.
Dialogue: 0,0:17:23.14,0:17:24.89,Default,,0,0,0,,О, сіріңке ме?
Dialogue: 0,0:17:24.95,0:17:28.32,Default,,0,0,0,,Мұғалім, бұл дұрыс болды. Маған бір секунд беріңізші.
Dialogue: 0,0:17:29.01,0:17:31.34,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:17:32.13,0:17:35.53,Default,,0,0,0,,Менен де білікті адам бар деп ойлаймын.
Dialogue: 0,0:17:38.77,0:17:39.68,Default,,0,0,0,,Бұл жаман
Dialogue: 0,0:17:40.39,0:17:43.07,Default,,0,0,0,,Жоқ, дәл осы жолы.
Dialogue: 0,0:17:43.36,0:17:46.65,Default,,0,0,0,,Тағы да рахмет, Хината-сан.
Dialogue: 0,0:17:46.98,0:17:48.35,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:17:48.59,0:17:50.61,Default,,0,0,0,,Тобиззава Сіз дайынсыз ба?
Dialogue: 0,0:17:50.61,0:17:51.69,Default,,0,0,0,,Қатты дауыс
Dialogue: 0,0:17:52.58,0:17:55.88,Default,,0,0,0,,Мм, төрт қалтқыларды ретімен түртіңіз бе?
Dialogue: 0,0:17:56.19,0:17:58.36,Default,,0,0,0,,Тек арқаңызды түртіңіз, солай ма?
Dialogue: 0,0:17:58.75,0:18:02.54,Default,,0,0,0,,Иә, бірақ мен саған оңай қол тигізуге рұқсат бермеймін.
Dialogue: 0,0:18:02.91,0:18:03.92,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын
Dialogue: 0,0:18:04.05,0:18:05.39,Default,,0,0,0,,Орналасуға қатысты
Dialogue: 0,0:18:07.22,0:18:07.90,Default,,0,0,0,,Жиын
Dialogue: 0,0:18:14.05,0:18:15.08,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:18:15.47,0:18:16.86,Default,,0,0,0,,Жауынгер, бірақ жылдам
Dialogue: 0,0:18:19.15,0:18:21.23,Default,,0,0,0,,Мисаки 1-ден 0-ге дейін
Dialogue: 0,0:18:21.23,0:18:23.07,Default,,0,0,0,,Мисаки-сенпай керемет
Dialogue: 0,0:18:26.71,0:18:28.99,Default,,0,0,0,,Курашина мырза, денеңізді көбірек бүгіңіз.
Dialogue: 0,0:18:29.46,0:18:30.04,Default,,0,0,0,,Иә
Dialogue: 0,0:18:33.86,0:18:35.00,Default,,0,0,0,,2-ден 0-ге дейін
Dialogue: 0,0:18:36.03,0:18:39.10,Default,,0,0,0,,Бұлай жалғаса берсе, үшінші нүкте де алынып тасталады.
Dialogue: 0,0:18:39.73,0:18:42.12,Default,,0,0,0,,Үшінші нүктені лақтыр, ол жарлық.
Dialogue: 0,0:18:42.74,0:18:44.00,Default,,0,0,0,,Бірден төртінші жолға
Dialogue: 0,0:18:44.37,0:18:46.57,Default,,0,0,0,,Жарлық дегеніміз не?
Dialogue: 0,0:18:46.80,0:18:48.36,Default,,0,0,0,,Келесі қалқымалы түртуден бас тартыңыз
Dialogue: 0,0:18:48.48,0:18:50.99,Default,,0,0,0,,Бұл озық болу туралы.
Dialogue: 0,0:18:55.59,0:18:58.52,Default,,0,0,0,,Курашина-сан, қайталап көрейік.
Dialogue: 0,0:19:00.27,0:19:02.28,Default,,0,0,0,,Мисаки 3-тен 0-ге дейін
Dialogue: 0,0:19:03.38,0:19:04.44,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:19:10.27,0:19:10.88,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,0:19:10.96,0:19:11.53,Default,,0,0,0,,Иә
Dialogue: 0,0:19:17.03,0:19:18.76,Default,,0,0,0,,Әуе соққысы
Dialogue: 0,0:19:24.29,0:19:25.84,Default,,0,0,0,,Аяғыңызды жайып, тоқтаңыз
Dialogue: 0,0:19:29.27,0:19:30.56,Default,,0,0,0,,Итадаки
Dialogue: 0,0:19:32.35,0:19:34.40,Default,,0,0,0,,Мисаки 4-тен 0-ге дейін
Dialogue: 0,0:19:34.40,0:19:36.67,Default,,0,0,0,,Тамаша Мисаки
Dialogue: 0,0:19:36.90,0:19:38.79,Default,,0,0,0,,Бір ұпай алынып тасталды.
Dialogue: 0,0:19:38.79,0:19:41.34,Default,,0,0,0,,Бұл жаңадан бастағанның жолы болды ма?
Dialogue: 0,0:19:43.06,0:19:44.80,Default,,0,0,0,,Тағы бір мылтық.
Dialogue: 0,0:19:45.68,0:19:47.82,Default,,0,0,0,,Мисаки 5-тен 0-ге дейін
Dialogue: 0,0:19:51.03,0:19:52.48,Default,,0,0,0,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,0:19:53.41,0:19:54.52,Default,,0,0,0,,6-0
Dialogue: 0,0:19:55.41,0:19:59.68,Default,,0,0,0,,Курашина-сенпай, мен өзімді жылан жалт қараған бақадай сезінемін.
Dialogue: 0,0:20:03.27,0:20:04.06,Default,,0,0,0,,баяу
Dialogue: 0,0:20:05.39,0:20:06.46,Default,,0,0,0,,7-ден 0-ге дейін
Dialogue: 0,0:20:08.15,0:20:10.41,Default,,0,0,0,,8-ге қарсы 9-ға қарсы
Dialogue: 0,0:20:10.80,0:20:12.65,Default,,0,0,0,,Оны шайқау үшін бүкіл денеңізді пайдаланыңыз.
Dialogue: 0,0:20:13.06,0:20:14.22,Default,,0,0,0,,Ағынды өзгерту
Dialogue: 0,0:20:15.75,0:20:17.71,Default,,0,0,0,,Кемінде 1 ұпай
Dialogue: 0,0:20:25.59,0:20:27.47,Default,,0,0,0,,Кемінде 1 ұпай
Dialogue: 0,0:20:31.04,0:20:34.23,Default,,0,0,0,,Ойын 9:0 есебімен аяқталды
Dialogue: 0,0:20:34.23,0:20:36.11,Default,,0,0,0,,Мисаки Тобисава жеңді
Dialogue: 0,0:20:43.67,0:20:44.43,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:20:45.60,0:20:49.02,Default,,0,0,0,,Мен тіпті әуе соққысын жасай алмадым.
Dialogue: 0,0:20:49.84,0:20:51.77,Default,,0,0,0,,Мен бір ұпай да алмадым.
Dialogue: 0,0:20:53.01,0:20:54.20,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:20:54.50,0:20:56.22,Default,,0,0,0,,Мисаки тәжірибелі адам.
Dialogue: 0,0:20:56.43,0:20:58.63,Default,,0,0,0,,Курашина-сан, біз енді ғана бастадық...
Dialogue: 0,0:20:58.32,0:20:59.69,Default,,0,0,0,,Мен жақсарғым келеді
Dialogue: 0,0:21:00.11,0:21:01.52,Default,,0,0,0,,Мен күштірек болғым келеді
Dialogue: 0,0:21:02.19,0:21:05.23,Default,,0,0,0,,Хината-сан, сен тағы да менің жаттықтырушым боласың ба?
Dialogue: 0,0:21:06.71,0:21:07.61,Default,,0,0,0,,Мен...
Dialogue: 0,0:21:08.10,0:21:10.67,Default,,0,0,0,,Мына сүйкімді қыз сұрап тұр.
Dialogue: 0,0:21:10.96,0:21:12.31,Default,,0,0,0,,Маған көмектесейін.
Dialogue: 0,0:21:12.31,0:21:13.39,Default,,0,0,0,,...
Dialogue: 0,0:21:13.75,0:21:16.54,Default,,0,0,0,,Әзірше жазғы турнирді күткен дұрыс шығар.
Dialogue: 0,0:21:17.49,0:21:20.19,Default,,0,0,0,,Бұл жақсы емес, бірақ көп рахмет.
Dialogue: 0,0:21:23.95,0:21:24.84,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:21:25.35,0:21:27.32,Default,,0,0,0,,Жазғы турнирге дейін болса
Dialogue: 0,0:21:28.10,0:21:29.43,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:29.43,0:21:31.01,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:31.01,0:21:32.69,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:32.05,0:21:33.29,Default,,0,0,0,,Аня нәжіске батты.
Dialogue: 0,0:21:34.11,0:21:35.08,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:21:36.03,0:21:38.06,Default,,0,0,0,,Бұл қандай сезім деп ойлаймын.
Dialogue: 0,0:21:38.58,0:21:40.81,Default,,0,0,0,,Бірақ бұл жаман болмауы мүмкін.
Dialogue: 0,0:21:41.25,0:21:43.82,Default,,0,0,0,,Мисаки-сенпайға тағы ғашық болдым.
Dialogue: 0,0:21:43.97,0:21:46.24,Default,,0,0,0,,Жемтігін көздеген аналық барыстай болды.
Dialogue: 0,0:21:46.27,0:21:47.55,Default,,0,0,0,,Барыс аналығы
Dialogue: 0,0:21:48.10,0:21:50.00,Default,,0,0,0,,Алдымен жеңісті тойлайық.
Dialogue: 0,0:21:50.11,0:21:51.96,Default,,0,0,0,,Мен сізге арнайы ыдысқа удон кеспесін сыйлаймын.
Dialogue: 0,0:21:52.13,0:21:54.01,Default,,0,0,0,,Мм... иә?
Dialogue: 0,0:21:54.29,0:21:55.68,Default,,0,0,0,,Арнайы...
Dialogue: 0,0:21:56.02,0:21:56.83,Default,,0,0,0,,күлімсіреу
Dialogue: 0,0:21:57.68,0:21:58.49,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:21:58.80,0:22:00.64,Default,,0,0,0,,Бұл Куахама Гакуиннің әртүрлі істері.
Dialogue: 0,0:22:01.20,0:22:03.32,Default,,0,0,0,,Иә, мүшелер де көбейді.
Dialogue: 0,0:22:03.75,0:22:07.71,Default,,0,0,0,,Мүмкін болса, мен беделді Такафуджи академиясының жүрегін алғым келеді.
Dialogue: 0,0:22:08.29,0:22:11.79,Default,,0,0,0,,Қарсы болмасаңыз, бірлескен оқу-жаттығу жиынына қосылыңыз.
Dialogue: 0,0:23:46.72,0:23:48.91,Default,,0,0,0,,Бұл керемет, мен қатты толқып тұрмын
Dialogue: 0,0:23:47.92,0:23:50.73,Default,,0,0,0,,Сондықтан жаттығу өте қиын.
Dialogue: 0,0:23:51.28,0:23:52.35,Default,,0,0,0,,Жарайды
Dialogue: 0,0:23:52.35,0:23:54.24,Default,,0,0,0,,Аздап күйіп қалдым.
Dialogue: 0,0:23:55.74,0:24:01.74,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory