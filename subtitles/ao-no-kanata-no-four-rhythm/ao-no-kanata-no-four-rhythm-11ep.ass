Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.77,0:00:05.24,Default,,0,0,0,,Міне, ақыры басталды.
Dialogue: 0,0:00:05.29,0:00:08.32,Default,,0,0,0,,Ұшатын цирк бойынша барлық Жапония чемпионатының күзгі турнирі
Dialogue: 0,0:00:08.37,0:00:10.03,Default,,0,0,0,,Цзичжоу Батыс округі алдын ала
Dialogue: 0,0:00:10.34,0:00:14.11,Default,,0,0,0,,Маширо Арисакамен, Маширо Удонның қазіргі постер қызы
Dialogue: 0,0:00:14.13,0:00:19.12,Default,,0,0,0,,Беделді Такафуджи мен тамаша жаңа ойыншы Рика Ичиноза арасындағы матч өтуде.
Dialogue: 0,0:00:19.72,0:00:23.53,Default,,0,0,0,,Екі ойыншы да, екеуі де бірінші курс студенттері, А блогының бірінші раундынан өтті.
Dialogue: 0,0:00:23.53,0:00:25.22,Default,,0,0,0,,Екінші турға өту
Dialogue: 0,0:00:25.40,0:00:28.66,Default,,0,0,0,,Үшінші турға кім өтеді?
Dialogue: 0,0:00:30.21,0:00:31.23,Default,,0,0,0,,Мен бірінші барамын.
Dialogue: 0,0:00:33.35,0:00:34.62,Default,,0,0,0,,Ихиноза нүктесі
Dialogue: 0,0:00:34.67,0:00:35.80,Default,,0,0,0,,Мен оны алдым.
Dialogue: 0,0:00:39.17,0:00:41.50,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:00:47.22,0:00:49.47,Default,,0,0,0,,Бұл ескірген сіріңке.
Dialogue: 0,0:00:50.61,0:00:55.09,Default,,0,0,0,,Біздің ФК-да әдемі тыныштық орнайды
Dialogue: 0,0:00:55.86,0:00:58.56,Default,,0,0,0,,Егер сіз қатарынан екі турнирде жеңіске жетсеңіз
Dialogue: 0,0:00:58.96,0:01:01.39,Default,,0,0,0,,Оны тіпті FC әлемі де мойындауы керек.
Dialogue: 0,0:01:02.02,0:01:04.30,Default,,0,0,0,,Ирина екеуміз...
Dialogue: 0,0:01:05.03,0:01:08.46,Default,,0,0,0,,Әдемі және мінсіз ФК
Dialogue: 0,0:02:42.20,0:02:44.74,Default,,0,0,0,,А блогының екінші раундындағы спидерлік кездесу
Dialogue: 0,0:02:44.75,0:02:47.30,Default,,0,0,0,,Бірінші болып Ичиноза ұпай жинады
Dialogue: 0,0:02:49.69,0:02:50.85,Default,,0,0,0,,Бөліну
Dialogue: 0,0:02:51.23,0:02:53.65,Default,,0,0,0,,Жарайды... Маширо-чан отты.
Dialogue: 0,0:02:53.65,0:02:55.73,Default,,0,0,0,,Асука неге сонша қобалжыды?
Dialogue: 0,0:02:55.93,0:02:57.69,Default,,0,0,0,,Таза ақ Мүмкіндігінше тездетіңіз
Dialogue: 0,0:02:58.11,0:03:00.77,Default,,0,0,0,,Маширо ойлап тапқан стратегияға тура өтіңіз. Тамаша.
Dialogue: 0,0:03:00.83,0:03:01.90,Default,,0,0,0,,Ой, әкеміз келген сияқты.
Dialogue: 0,0:03:05.04,0:03:05.88,Default,,0,0,0,,таза ақ
Dialogue: 0,0:03:06.87,0:03:09.60,Default,,0,0,0,,Бүгінгі ойында бар күшімізді салайық.
Dialogue: 0,0:03:09.77,0:03:12.58,Default,,0,0,0,,Әрине бар күш-қуатымды жұмсаймын.
Dialogue: 0,0:03:14.63,0:03:15.90,Default,,0,0,0,,Рахмет Рика
Dialogue: 0,0:03:16.72,0:03:20.81,Default,,0,0,0,,Мен Риканың арқасында ФК-ны таба алдым.
Dialogue: 0,0:03:21.00,0:03:22.29,Default,,0,0,0,,Мен осы уақытқа дейін келдім
Dialogue: 0,0:03:23.14,0:03:25.06,Default,,0,0,0,,Мен ештеңе істеген жоқпын
Dialogue: 0,0:03:25.22,0:03:27.31,Default,,0,0,0,,Маширо осы уақытқа дейін көп еңбек етті
Dialogue: 0,0:03:27.31,0:03:30.29,Default,,0,0,0,,Әлі де Риканың еңбекқорлығымен салыстырылады
Dialogue: 0,0:03:31.11,0:03:35.06,Default,,0,0,0,,Бірақ мен жеңілмеймін, бүгін жеңемін.
Dialogue: 0,0:03:35.13,0:03:37.44,Default,,0,0,0,,Иә, мен оны қабылдаймын.
Dialogue: 0,0:03:43.29,0:03:44.96,Default,,0,0,0,,Маширо-чан қозғала бастады
Dialogue: 0,0:03:44.97,0:03:45.81,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:03:47.67,0:03:49.99,Default,,0,0,0,,Ичиноза нүктесі 0 және 2
Dialogue: 0,0:03:49.99,0:03:52.93,Default,,0,0,0,,Енді Ичиноза 2 ұпаймен алда.
Dialogue: 0,0:03:52.93,0:03:55.00,Default,,0,0,0,,Арисака қайтып орала ма?
Dialogue: 0,0:03:55.04,0:03:57.44,Default,,0,0,0,,Маширо Мен төте жолды таңдадым деп ойладым.
Dialogue: 0,0:03:57.44,0:03:58.42,Default,,0,0,0,,Жоғарыда.
Dialogue: 0,0:04:00.12,0:04:00.85,Default,,0,0,0,,таза ақ
Dialogue: 0,0:04:00.92,0:04:03.68,Default,,0,0,0,,Мұны «Маринадталған тас операциясы» деп атаймыз.
Dialogue: 0,0:04:03.78,0:04:05.09,Default,,0,0,0,,Орындауды бастау
Dialogue: 0,0:04:05.24,0:04:06.73,Default,,0,0,0,,Маринадталған тас дегеніміз не?
Dialogue: 0,0:04:06.96,0:04:11.33,Default,,0,0,0,,Жоғарыға көтеріліп, қарсыласыңыздың арқасы келесі қалқыманы көздеген кезде қысым көрсетіңіз
Dialogue: 0,0:04:11.59,0:04:13.60,Default,,0,0,0,,Бұл дәл Инуидің стратегиясы.
Dialogue: 0,0:04:15.27,0:04:16.86,Default,,0,0,0,,Сіз мұны жасайсыз.
Dialogue: 0,0:04:17.08,0:04:19.67,Default,,0,0,0,,Қарғыс атқыр, мен төбелескім келді.
Dialogue: 0,0:04:19.67,0:04:21.81,Default,,0,0,0,,Мұндай сөздерді қолданбаңыз.
Dialogue: 0,0:04:21.81,0:04:23.70,Default,,0,0,0,,Мен...Кешіріңіз, апа.
Dialogue: 0,0:04:24.68,0:04:27.96,Default,,0,0,0,,Қарсыласыңыздың қимылдарын жақсы оқып, сол күйге түстіңіз.
Dialogue: 0,0:04:29.15,0:04:29.97,Default,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:04:38.74,0:04:39.79,Default,,0,0,0,,Itadaki...
Dialogue: 0,0:04:40.48,0:04:42.51,Default,,0,0,0,,Арисака 1 және 2 нүктесі
Dialogue: 0,0:04:44.33,0:04:45.69,Default,,0,0,0,,Арисака нүктесі
Dialogue: 0,0:04:46.04,0:04:49.60,Default,,0,0,0,,Бұл галстук. Арисака қатарынан 2 ұпай алды.
Dialogue: 0,0:04:49.60,0:04:51.43,Default,,0,0,0,,Мен Ичинозаны қуып жеттім
Dialogue: 0,0:04:51.51,0:04:54.53,Default,,0,0,0,,Әй, бұл күш, Арисака.
Dialogue: 0,0:04:54.61,0:04:58.15,Default,,0,0,0,,Үлкен аға, тек ойыншылар артқы жағынан кіруге рұқсат етіледі.
Dialogue: 0,0:04:58.23,0:05:01.32,Default,,0,0,0,,Ичиноза-сан Нао-сама күш сызығына арналған төте жол
Dialogue: 0,0:05:01.44,0:05:02.03,Default,,0,0,0,,Иә
Dialogue: 0,0:05:03.60,0:05:04.57,Default,,0,0,0,,Мені жіберме
Dialogue: 0,0:05:04.69,0:05:07.37,Default,,0,0,0,,Тоқтауды ұмытпаңыз, жіберіп алмаңыз
Dialogue: 0,0:05:07.40,0:05:08.00,Default,,0,0,0,,Иә
Dialogue: 0,0:05:12.65,0:05:13.45,Default,,0,0,0,,Артқы жұдырық
Dialogue: 0,0:05:13.63,0:05:14.83,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:05:18.15,0:05:19.47,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:05:21.07,0:05:23.45,Default,,0,0,0,,Ичиноза 2 нүктесі 3-ке қарсы
Dialogue: 0,0:05:31.39,0:05:33.54,Default,,0,0,0,,Арнайы ақ жұдырық
Dialogue: 0,0:05:35.68,0:05:38.05,Default,,0,0,0,,Арисака 3 нүктесі 3-ке қарсы
Dialogue: 0,0:05:38.11,0:05:39.60,Default,,0,0,0,,Маширо керемет
Dialogue: 0,0:05:39.60,0:05:40.72,Default,,0,0,0,,Бұл жақын жарыс.
Dialogue: 0,0:05:40.72,0:05:44.54,Default,,0,0,0,,Мен Мисаки-сенпаймен немесе Асука-сенпаймен кездеспеймін.
Dialogue: 0,0:05:44.73,0:05:46.27,Default,,0,0,0,,Бүгін біз жеңдік
Dialogue: 0,0:05:46.27,0:05:47.93,Default,,0,0,0,,Менің де жеңгім келеді
Dialogue: 0,0:05:48.43,0:05:52.44,Default,,0,0,0,,Ичиноза-чан да жазғы турнирден бері ит төбелесу дағдыларын жетілдірді.
Dialogue: 0,0:05:52.72,0:05:55.65,Default,,0,0,0,,Мисакиден жеңілгеннен кейін де көп жаттығу жасадың.
Dialogue: 0,0:05:55.69,0:05:57.21,Default,,0,0,0,,Керемет, екеуің де.
Dialogue: 0,0:05:57.28,0:06:00.29,Default,,0,0,0,,Жеңілуден көбірек үйренуім керек пе еді?
Dialogue: 0,0:06:00.29,0:06:01.50,Default,,0,0,0,,Қараңызшы, ағайын.
Dialogue: 0,0:06:03.13,0:06:05.16,Default,,0,0,0,,Біз де ұтыла алмаймыз.
Dialogue: 0,0:06:05.21,0:06:06.17,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:06:11.29,0:06:14.09,Default,,0,0,0,,Жүр, аз ғана уақыт қалды.
Dialogue: 0,0:06:14.52,0:06:16.51,Default,,0,0,0,,Әлі біткен жоқ.
Dialogue: 0,0:06:17.43,0:06:18.15,Default,,0,0,0,,Кунахама
Dialogue: 0,0:06:14.09,0:06:17.40,Default,,0,0,0,,Такафуджидің Ичиноза ойыншысы Кунахаманың Арисака ойыншысы
Dialogue: 0,0:06:17.40,0:06:20.10,Default,,0,0,0,,Кім жеңіске жетеді?
Dialogue: 0,0:06:21.68,0:06:24.66,Default,,0,0,0,,Бұл жолы Инуи мырзамен қызықты матч өткіземіз деп үміттенемін.
Dialogue: 0,0:06:24.80,0:06:27.93,Default,,0,0,0,,Мен қатты дайындалып жатырмын, сондықтан күзгі турнир сендерге ұнайды деп сенемін...
Dialogue: 0,0:06:27.93,0:06:28.89,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:06:31.36,0:06:33.13,Default,,0,0,0,,Саки, не болды?
Dialogue: 0,0:06:33.38,0:06:34.30,Default,,0,0,0,,Кеттік
Dialogue: 0,0:06:37.93,0:06:40.43,Default,,0,0,0,,Маширо Бірінші қалқымаға барыңыз.
Dialogue: 0,0:06:40.80,0:06:41.62,Default,,0,0,0,,Иә
Dialogue: 0,0:06:42.34,0:06:43.54,Default,,0,0,0,,Рұқсат етпеңіз
Dialogue: 0,0:06:47.06,0:06:48.21,Default,,0,0,0,,Маширочи
Dialogue: 0,0:06:56.05,0:06:59.15,Default,,0,0,0,,Арисака 4 және 3 нүктесі
Dialogue: 0,0:07:00.64,0:07:03.29,Default,,0,0,0,,Ойын жинағы Жеңімпаз Арисака
Dialogue: 0,0:07:03.47,0:07:04.39,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:07:04.39,0:07:05.22,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:05.80,0:07:08.82,Default,,0,0,0,,Маширо, сен қолыңнан келгеннің бәрін жасадың.
Dialogue: 0,0:07:09.36,0:07:12.76,Default,,0,0,0,,Арисаканың тамаша өнері үшінші турға өтеді
Dialogue: 0,0:07:14.80,0:07:17.21,Default,,0,0,0,,Маширо Бұл керемет болды
Dialogue: 0,0:07:17.28,0:07:18.09,Default,,0,0,0,,Рика
Dialogue: 0,0:07:20.69,0:07:21.50,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:21.70,0:07:23.63,Default,,0,0,0,,Құттықтаймыз Маширо
Dialogue: 0,0:07:24.12,0:07:26.67,Default,,0,0,0,,Бірақ келесі жолы мен жеңемін
Dialogue: 0,0:07:30.58,0:07:32.29,Default,,0,0,0,,Бұл болмайды Рика
Dialogue: 0,0:07:32.64,0:07:34.68,Default,,0,0,0,,Келесі жолы мен де жеңемін.
Dialogue: 0,0:07:38.29,0:07:40.35,Default,,0,0,0,,Маширо-чан керемет болды
Dialogue: 0,0:07:40.37,0:07:43.31,Default,,0,0,0,,Жарайды, мен де істеймін.
Dialogue: 0,0:07:43.45,0:07:45.00,Default,,0,0,0,,Мен міндетті түрде жеңемін
Dialogue: 0,0:07:45.03,0:07:45.84,Default,,0,0,0,,Иә
Dialogue: 0,0:07:47.12,0:07:49.57,Default,,0,0,0,,Иә, шыдамдылығыңызға рахмет.
Dialogue: 0,0:07:49.61,0:07:52.17,Default,,0,0,0,,Тамақтану кезінде қызып кетпеу үшін абайлаңыз.
Dialogue: 0,0:07:53.13,0:07:54.78,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:07:58.27,0:08:00.89,Default,,0,0,0,,Жеңіс Удонның дәмі қандай?
Dialogue: 0,0:08:00.89,0:08:01.92,Default,,0,0,0,,Бұл дәмді
Dialogue: 0,0:08:01.92,0:08:04.27,Default,,0,0,0,,Әй, маған ұнамайды, сен адал қызсың.
Dialogue: 0,0:08:04.27,0:08:05.74,Default,,0,0,0,,Мен анама айтқан жоқпын.
Dialogue: 0,0:08:07.19,0:08:08.88,Default,,0,0,0,,Маширо Құттықтаймыз
Dialogue: 0,0:08:08.88,0:08:11.27,Default,,0,0,0,,Маған тойлау үшін удон кеспесін сатып алыңыз.
Dialogue: 0,0:08:11.27,0:08:12.28,Default,,0,0,0,,Қарашы, Юрика
Dialogue: 0,0:08:12.28,0:08:13.30,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:13.37,0:08:18.20,Default,,0,0,0,,Жарайды, Машироны қолдағандардың барлығына қызмет көрсетіледі.
Dialogue: 0,0:08:18.29,0:08:20.35,Default,,0,0,0,,Қазірдің өзінде ана
Dialogue: 0,0:08:20.61,0:08:23.07,Default,,0,0,0,,Біз де соны алу үшін келдік.
Dialogue: 0,0:08:23.20,0:08:26.69,Default,,0,0,0,,Мен оларға таза ақ удонның дәмді екенін айтқанда, бәрі оны жеп көргісі келді.
Dialogue: 0,0:08:26.92,0:08:29.65,Default,,0,0,0,,Синдо мырза, сіз оны көруге келдіңіз.
Dialogue: 0,0:08:29.81,0:08:32.70,Default,,0,0,0,,Иә, мен де кіші балаларымның қолдауына ие болдым.
Dialogue: 0,0:08:32.80,0:08:35.24,Default,,0,0,0,,Мен де Инуидің матчына қызығамын.
Dialogue: 0,0:08:35.84,0:08:37.16,Default,,0,0,0,,Хината-кун, жағдайың қалай?
Dialogue: 0,0:08:37.53,0:08:39.65,Default,,0,0,0,,Мен барынша дайындалдым деп ойладым.
Dialogue: 0,0:08:40.08,0:08:42.93,Default,,0,0,0,,Үшінші айналымда мен Инуимен кездеседі.
Dialogue: 0,0:08:43.19,0:08:46.69,Default,,0,0,0,,Мен удон жеп, оттаймын.
Dialogue: 0,0:08:47.08,0:08:50.26,Default,,0,0,0,,Олай болса барлығына бірден бірдеңе дайындап алайық.
Dialogue: 0,0:08:50.37,0:08:53.75,Default,,0,0,0,,Ах, Асука-чан, келесі матчқа дайындалатын кез келді.
Dialogue: 0,0:08:53.75,0:08:55.47,Default,,0,0,0,,А, иә, асығуымыз керек.
Dialogue: 0,0:08:55.47,0:08:56.88,Default,,0,0,0,,Мен әлі тамақтанып жатырмын.
Dialogue: 0,0:08:56.88,0:08:58.40,Default,,0,0,0,,Мен бос емеспін.
Dialogue: 0,0:09:00.99,0:09:02.82,Default,,0,0,0,,Аой, абай бол
Dialogue: 0,0:09:03.04,0:09:04.59,Default,,0,0,0,,Маған қашан қоңырау шаласың?
Dialogue: 0,0:09:05.06,0:09:09.29,Default,,0,0,0,,Кайрио академиясының Саки Инуи және екіншіден Ирина Авалон
Dialogue: 0,0:09:09.59,0:09:11.77,Default,,0,0,0,,Бұл екеуі қарапайым адамдар емес.
Dialogue: 0,0:09:12.36,0:09:16.03,Default,,0,0,0,,Мен мұны жазғы турнирден білетінмін.
Dialogue: 0,0:09:16.59,0:09:20.14,Default,,0,0,0,,Жоқ, бұл бәрі емес. Бұдан да көп нәрсе бар.
Dialogue: 0,0:09:20.49,0:09:22.29,Default,,0,0,0,,Бұл өндіруші Avalon деп атады
Dialogue: 0,0:09:23.62,0:09:26.49,Default,,0,0,0,,Бұрынғы интуиция
Dialogue: 0,0:09:28.07,0:09:30.86,Default,,0,0,0,,Бұл әйнек қорқынышты.
Dialogue: 0,0:09:32.00,0:09:33.26,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:09:36.74,0:09:38.27,Default,,0,0,0,,Жеңімпаз Курашина
Dialogue: 0,0:09:39.53,0:09:40.50,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:09:40.50,0:09:41.21,Default,,0,0,0,,Иә
Dialogue: 0,0:09:41.70,0:09:44.35,Default,,0,0,0,,Ұшқан балықтай бөшке орамы әдемі болды.
Dialogue: 0,0:09:46.12,0:09:47.23,Default,,0,0,0,,Мисаки-чан ше?
Dialogue: 0,0:09:47.54,0:09:50.74,Default,,0,0,0,,Келесі ойын басталғалы жатыр, сондықтан мен В блогына бет алдым.
Dialogue: 0,0:09:50.84,0:09:53.29,Default,,0,0,0,,Бұл жай ғана удон турнирі болды.
Dialogue: 0,0:09:53.35,0:09:55.24,Default,,0,0,0,,Асқазаныңыз жақсы ма?
Dialogue: 0,0:09:55.37,0:09:57.84,Default,,0,0,0,,Бірақ Синдо-сан одан да керемет болды.
Dialogue: 0,0:09:57.84,0:10:01.22,Default,,0,0,0,,Кобраға ұқсап, бет-жүзі құлады...
Dialogue: 0,0:10:01.64,0:10:02.69,Default,,0,0,0,,Матчтың соңы
Dialogue: 0,0:10:03.21,0:10:05.80,Default,,0,0,0,,0 және 8 жеңімпаз Инуи
Dialogue: 0,0:10:07.93,0:10:10.02,Default,,0,0,0,,Ей, күшті, тым күшті.
Dialogue: 0,0:10:10.07,0:10:13.68,Default,,0,0,0,,Инуи құс торында чемпион Шиндоны тағы да жеңді
Dialogue: 0,0:10:13.68,0:10:16.16,Default,,0,0,0,,Мен Ин Сатодан басым түстім.
Dialogue: 0,0:10:17.24,0:10:18.92,Default,,0,0,0,,Саки мінсіз болды
Dialogue: 0,0:10:18.98,0:10:19.57,Default,,0,0,0,,Иә
Dialogue: 0,0:10:23.99,0:10:25.76,Default,,0,0,0,,Күзгі конференцияның бірінші күні
Dialogue: 0,0:10:25.88,0:10:28.74,Default,,0,0,0,,Үшінші айналымға дейінгі барлық матчтар аяқталды.
Dialogue: 0,0:10:29.12,0:10:32.51,Default,,0,0,0,,Блок жеңіске жеткен кандидаттардың бірі Гаджокомен бірге.
Dialogue: 0,0:10:32.59,0:10:37.15,Default,,0,0,0,,Жазғы турнирде Шиндоны бұрыштамаға салған Курашина жартылай финалға өтті
Dialogue: 0,0:10:37.60,0:10:41.16,Default,,0,0,0,,B блогы - Сатоинді көшкінмен жеңген Инуи.
Dialogue: 0,0:10:41.35,0:10:47.54,Default,,0,0,0,,Ал озық Кунахама академиясының тағы бір Тобисава ойыншысы жартылай финалға өтті.
Dialogue: 0,0:10:50.18,0:10:54.04,Default,,0,0,0,,Кешіріңіз, мен жалғыз үшінші айналымнан өте алмадым.
Dialogue: 0,0:10:54.04,0:10:56.72,Default,,0,0,0,,Маширо керемет болды, мен бар күшімді салдым
Dialogue: 0,0:10:56.72,0:10:58.32,Default,,0,0,0,,Дұрыс, Маширо-чан.
Dialogue: 0,0:10:58.48,0:11:01.47,Default,,0,0,0,,Өткен жолы үшінші орын алған Гаджоко-санмен жақсы күрестім.
Dialogue: 0,0:11:01.73,0:11:04.32,Default,,0,0,0,,Мисаки Ертең мен Инуиден бастаймын.
Dialogue: 0,0:11:04.50,0:11:08.06,Default,,0,0,0,,Осы уақытқа дейінгі арнайы жаттығуларымның нәтижесін көрсетіп, жеңіске жетемін.
Dialogue: 0,0:11:08.24,0:11:11.01,Default,,0,0,0,,Ал финалда Асукамен жекпе-жек
Dialogue: 0,0:11:11.95,0:11:14.00,Default,,0,0,0,,Иә, мен де бар күшімді саламын.
Dialogue: 0,0:11:17.94,0:11:19.17,Default,,0,0,0,,Керемет
Dialogue: 0,0:11:19.17,0:11:20.74,Default,,0,0,0,,Сондықтан сіз үйге барасыз
Dialogue: 0,0:11:23.81,0:11:24.70,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:25.09,0:11:26.28,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:11:28.21,0:11:30.21,Default,,0,0,0,,О, сәлем
Dialogue: 0,0:11:30.66,0:11:33.33,Default,,0,0,0,,Еңбегіңізге рахмет, Инуи мырза.
Dialogue: 0,0:11:33.76,0:11:35.96,Default,,0,0,0,,Саки шаршаған жоқ.
Dialogue: 0,0:11:36.29,0:11:40.12,Default,,0,0,0,,Барлығы шаршаған болуы керек, сондықтан жақсылап демалыңыз.
Dialogue: 0,0:11:40.77,0:11:42.20,Default,,0,0,0,,Әйтпесе
Dialogue: 0,0:11:42.58,0:11:45.97,Default,,0,0,0,,Өйткені Саки өзінің тамаша жеңісін көрсете алмайды.
Dialogue: 0,0:11:45.99,0:11:47.31,Default,,0,0,0,,Жеңіске дайын
Dialogue: 0,0:11:47.43,0:11:51.06,Default,,0,0,0,,Екеуміз де ертеңгі күнімізге барымызды салайық.
Dialogue: 0,0:12:24.11,0:12:28.35,Default,,0,0,0,,Жарайды, мен бүгін сені шын жүректен қуантамын, Мисаки-сенпай.
Dialogue: 0,0:12:28.43,0:12:30.11,Default,,0,0,0,,Бұл тікелей эфир емес...
Dialogue: 0,0:12:30.11,0:12:34.65,Default,,0,0,0,,Маширо-чан үшін бұл «Ұшатын Мисаки Сенпай» шоуы болуы мүмкін.
Dialogue: 0,0:12:35.09,0:12:38.52,Default,,0,0,0,,-да Маширо Арисака көңіл көтеру әнін айтады.
Dialogue: 0,0:12:38.72,0:12:44.60,Default,,0,0,0,,Жеңілмейтін қанаттар Жұлдыздарды айналып жүгіреді
Dialogue: 0,0:12:40.66,0:12:43.13,Default,,0,0,0,,Уау, мен шынымен мотивация алдым.
Dialogue: 0,0:12:43.13,0:12:47.11,Default,,0,0,0,,Бұл алаңдатады, сондықтан мен сонда болған кезде мен көзден таса болдым.
Dialogue: 0,0:12:45.36,0:12:47.13,Default,,0,0,0,,Жауабы...
Dialogue: 0,0:12:47.13,0:12:51.05,Default,,0,0,0,,Е, бұл қорқынышты. Мен Мисаки-сенпайды осыншама ойлап жүрмін.
Dialogue: 0,0:12:51.05,0:12:51.97,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:12:52.12,0:12:54.26,Default,,0,0,0,,Таңертеңнен бері өзімді жігерлі сезінемін.
Dialogue: 0,0:12:55.31,0:12:56.28,Default,,0,0,0,,Сәлем
Dialogue: 0,0:12:57.56,0:12:58.53,Default,,0,0,0,,Инуи мырза
Dialogue: 0,0:12:58.89,0:13:01.37,Default,,0,0,0,,Әзірше көңіл көтеріңіз.
Dialogue: 0,0:13:01.40,0:13:04.97,Default,,0,0,0,,Матч басталған кезде олар үнсіз қалады.
Dialogue: 0,0:13:06.19,0:13:08.74,Default,,0,0,0,,Енді бұл туралы не деуге болады?
Dialogue: 0,0:13:09.16,0:13:11.64,Default,,0,0,0,,Сіз оны қолданып көрмейінше, айырмашылықты білмейсіз.
Dialogue: 0,0:13:12.09,0:13:13.96,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:13:14.51,0:13:15.28,Default,,0,0,0,,Сонымен
Dialogue: 0,0:13:21.78,0:13:24.18,Default,,0,0,0,,Енді күзгі турнирдің екінші күні
Dialogue: 0,0:13:24.29,0:13:27.98,Default,,0,0,0,,Қазіргі уақытта Курашина Гаджокодан басым түсуде.
Dialogue: 0,0:13:29.65,0:13:30.61,Default,,0,0,0,,Әпке
Dialogue: 0,0:13:37.57,0:13:39.80,Default,,0,0,0,,Курашина 2 және 5 нүктесі
Dialogue: 0,0:13:39.91,0:13:42.03,Default,,0,0,0,,Бар, Асука-сенпай.
Dialogue: 0,0:13:43.99,0:13:46.21,Default,,0,0,0,,Қауіпсіздікті төмендетіңіз... бұл сіздің үлкен жауыңыз
Dialogue: 0,0:13:50.40,0:13:53.54,Default,,0,0,0,,Тобисава-кун, сенің отыңды алған сияқтысың.
Dialogue: 0,0:13:55.04,0:13:56.18,Default,,0,0,0,,Синдо мырза...
Dialogue: 0,0:13:57.31,0:14:00.03,Default,,0,0,0,,Мен сіздің толқуларыңызды күтемін.
Dialogue: 0,0:14:02.25,0:14:02.84,Default,,0,0,0,,Иә
Dialogue: 0,0:14:06.67,0:14:12.42,Default,,0,0,0,,Бірақ мен Шиндо мырзамен түскі ас кезінде удон жеу сайысында жеңгім келді.
Dialogue: 0,0:14:14.04,0:14:16.29,Default,,0,0,0,,Мен әрқашан шақыруды қабылдаймын
Dialogue: 0,0:14:16.63,0:14:20.14,Default,,0,0,0,,Егер мен Инуи-санның кездесуін жеңсем, мен кек аламын.
Dialogue: 0,0:14:29.20,0:14:30.64,Default,,0,0,0,,Курашина нүктесі
Dialogue: 0,0:14:34.34,0:14:37.87,Default,,0,0,0,,Матч аяқталды Жеңімпаз Курашина
Dialogue: 0,0:14:38.03,0:14:43.56,Default,,0,0,0,,Блоктық жартылай финалдық матчта Курашина соңғы рет үшінші орын алған Гаджоконы жеңді.
Dialogue: 0,0:14:43.56,0:14:45.69,Default,,0,0,0,,Бұл менің финалға бірінші рет өтуім.
Dialogue: 0,0:14:45.85,0:14:49.23,Default,,0,0,0,,Енді B блогының жартылай финалы.
Dialogue: 0,0:14:49.31,0:14:51.89,Default,,0,0,0,,Финалда Курашинамен кім күш сынасады?
Dialogue: 0,0:14:51.96,0:14:54.50,Default,,0,0,0,,Бұл әуе кеңістігін билеуші ​​Саки Инуи ме?
Dialogue: 0,0:14:54.50,0:14:57.32,Default,,0,0,0,,Ең жақсы жауынгерлердің бірі Мисаки Тобисава?
Dialogue: 0,0:14:57.59,0:14:59.99,Default,,0,0,0,,Мисаки-сенпай төбелесіп жатыр.
Dialogue: 0,0:14:59.99,0:15:02.57,Default,,0,0,0,,Жеңіске жетсең, бір жылдық удон кеспесін аласың.
Dialogue: 0,0:15:02.60,0:15:04.00,Default,,0,0,0,,Фрей Фрей
Dialogue: 0,0:15:01.94,0:15:04.08,Default,,0,0,0,,Маширочиді тыныштандырыңыз
Dialogue: 0,0:15:04.17,0:15:06.86,Default,,0,0,0,,Мисаки Сенпай
Dialogue: 0,0:15:07.72,0:15:08.51,Default,,0,0,0,,Мисаки
Dialogue: 0,0:15:10.12,0:15:11.02,Default,,0,0,0,,Қарақұрым қоңырау белгісі мұнараның шыңынан алыстап барады. Мен оны сеземін.
Dialogue: 0,0:15:13.33,0:15:14.40,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:15:14.76,0:15:18.89,Default,,0,0,0,,Инуи мырза да Сатоин мырзаны жеңіп алды.
Dialogue: 0,0:15:19.09,0:15:21.53,Default,,0,0,0,,Мен де осылай жеңіліп қалуым мүмкін.
Dialogue: 0,0:15:22.03,0:15:25.30,Default,,0,0,0,,Ойлап қарасам, бәрі қорқынышты.
Dialogue: 0,0:15:26.55,0:15:27.47,Default,,0,0,0,,Мисаки…
Dialogue: 0,0:15:28.27,0:15:31.40,Default,,0,0,0,,Бірақ мен жеңілгендіктен
Dialogue: 0,0:15:31.53,0:15:33.76,Default,,0,0,0,,Мен өзімді қайта қарастыра алдым.
Dialogue: 0,0:15:34.28,0:15:37.00,Default,,0,0,0,,Мен жеңілгендіктен байсалды болдым.
Dialogue: 0,0:15:38.93,0:15:41.69,Default,,0,0,0,,Әйтеуір, шабуыл, шабуыл, шабуыл.
Dialogue: 0,0:15:42.04,0:15:44.61,Default,,0,0,0,,Өйткені бұл менің FC
Dialogue: 0,0:15:54.60,0:15:55.57,Default,,0,0,0,,Инуи мырза
Dialogue: 0,0:15:57.39,0:15:59.93,Default,,0,0,0,,Мен сенің құс торыңды сындырамын
Dialogue: 0,0:16:00.31,0:16:01.71,Default,,0,0,0,,Мен жынды болып бара жатырмын
Dialogue: 0,0:16:02.64,0:16:03.89,Default,,0,0,0,,Орналасқан жеріне қатысты
Dialogue: 0,0:16:14.27,0:16:14.97,Default,,0,0,0,,Жиын
Dialogue: 0,0:16:18.82,0:16:20.30,Default,,0,0,0,,Енді басталды
Dialogue: 0,0:16:20.40,0:16:21.65,Default,,0,0,0,,Инуи қалқыманы көздеп отыр
Dialogue: 0,0:16:21.65,0:16:24.21,Default,,0,0,0,,Тобиззава еш ойланбастан төте жолды алады.
Dialogue: 0,0:16:27.37,0:16:28.74,Default,,0,0,0,,Құрғақ нүкте
Dialogue: 0,0:16:36.90,0:16:38.97,Default,,0,0,0,,Бұл осылай аяқталды.
Dialogue: 0,0:16:39.55,0:16:43.25,Default,,0,0,0,,Енді осы жерден не істейміз? Тобисава-кун
Dialogue: 0,0:16:44.19,0:16:49.18,Default,,0,0,0,,Мисаки Инуи құс торымен осы турнирдегі әрбір матчта жеңіске жетуге тырысады.
Dialogue: 0,0:16:49.97,0:16:52.29,Default,,0,0,0,,Сондықтан төменнен жақындауға мүмкіндік болуы керек.
Dialogue: 0,0:16:52.68,0:16:53.64,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:16:53.70,0:16:56.57,Default,,0,0,0,,Мен өз жолыммен лайлы ит төбелесін мақсат етіп отырмын.
Dialogue: 0,0:16:56.72,0:16:58.96,Default,,0,0,0,,Иә, жақындаған кезде
Dialogue: 0,0:16:58.96,0:17:00.75,Default,,0,0,0,,Ешқашан соңына дейін кетпеңіз
Dialogue: 0,0:17:01.11,0:17:02.37,Default,,0,0,0,,Оған жабысып, оны бөлшектеңіз.
Dialogue: 0,0:17:02.37,0:17:05.39,Default,,0,0,0,,Мәңгі? Бұл ауыртады.
Dialogue: 0,0:17:06.01,0:17:08.93,Default,,0,0,0,,Бірақ одан бас тарту қиынырақ шығар.
Dialogue: 0,0:17:10.80,0:17:13.18,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:17:17.31,0:17:20.21,Default,,0,0,0,,Ой, Тобиззава өте жылдам.
Dialogue: 0,0:17:26.31,0:17:29.60,Default,,0,0,0,,Кәне, шырылдап көрейік, Инуи мырза.
Dialogue: 0,0:17:30.82,0:17:32.68,Default,,0,0,0,,Мисаки, қашып кетуіме жол берме.
Dialogue: 0,0:17:32.68,0:17:33.71,Default,,0,0,0,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:17:35.15,0:17:39.44,Default,,0,0,0,,Sonic Boost Сіз қатты жаттығу жасаған болуыңыз керек.
Dialogue: 0,0:17:40.03,0:17:40.87,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:17:41.46,0:17:43.47,Default,,0,0,0,,Саки Стратегия өзгеріссіз қалады.
Dialogue: 0,0:17:43.80,0:17:45.44,Default,,0,0,0,,Мені жер бетіне шығар
Dialogue: 0,0:17:45.57,0:17:46.94,Default,,0,0,0,,Иә Ирина
Dialogue: 0,0:17:50.12,0:17:54.08,Default,,0,0,0,,Тобисаваны Инуи итеріп жіберді, ол кенет тоқтап, құлап кетті.
Dialogue: 0,0:17:56.83,0:17:59.40,Default,,0,0,0,,Шырылдап көрейік
Dialogue: 0,0:18:02.24,0:18:03.40,Default,,0,0,0,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,0:18:08.60,0:18:09.57,Default,,0,0,0,,Тағы бір пышақ
Dialogue: 0,0:18:19.73,0:18:21.78,Default,,0,0,0,,Ол қалай жанды?
Dialogue: 0,0:18:24.24,0:18:26.78,Default,,0,0,0,,Саки Итермеңіз
Dialogue: 0,0:18:26.99,0:18:27.70,Default,,0,0,0,,Иә
Dialogue: 0,0:18:28.15,0:18:30.38,Default,,0,0,0,,Бұл Мисаки-сенпайдың ФК.
Dialogue: 0,0:18:30.38,0:18:31.09,Default,,0,0,0,,Иә
Dialogue: 0,0:18:31.85,0:18:35.79,Default,,0,0,0,,А, Тобисава ақыры жер бетіне қуылды.
Dialogue: 0,0:18:43.08,0:18:44.67,Default,,0,0,0,,Судан шықты
Dialogue: 0,0:18:44.67,0:18:48.19,Default,,0,0,0,,Әлі жоқ. Құстың торы әлі бұзылған жоқ.
Dialogue: 0,0:18:49.68,0:18:53.66,Default,,0,0,0,,Екі жақ басымдық алу үшін қызу шайқасқа түседі.
Dialogue: 0,0:18:54.43,0:18:56.86,Default,,0,0,0,,Құс торынан шығу қиын.
Dialogue: 0,0:18:59.67,0:19:02.45,Default,,0,0,0,,Жоғары Сіз енді менің артымнан келмейсіз бе?
Dialogue: 0,0:19:02.60,0:19:06.37,Default,,0,0,0,,Бұл... сіз мұнымен өзіңізді қайтара алмайсыз.
Dialogue: 0,0:19:06.81,0:19:09.60,Default,,0,0,0,,Көрдім, төңкерілген ұшу?
Dialogue: 0,0:19:09.75,0:19:14.04,Default,,0,0,0,,Егер бұл рас болса, сіз ит төбелесінде қолайсыз жағдайға тап болмайсыз, себебі сіздің арқаңыз бұрылмайтын болады.
Dialogue: 0,0:19:14.32,0:19:16.25,Default,,0,0,0,,Мен мұндай әдіс бар деп ешқашан ойламадым.
Dialogue: 0,0:19:16.26,0:19:19.33,Default,,0,0,0,,Бірақ аспан мен жердің сезімі қарама-қарсы болатын позада.
Dialogue: 0,0:19:19.36,0:19:21.41,Default,,0,0,0,,Ұшуды жалғастыру қиын болуы керек
Dialogue: 0,0:19:21.48,0:19:24.64,Default,,0,0,0,,Дұрыс, енді жеңіске жету уақыты келді.
Dialogue: 0,0:19:24.80,0:19:25.95,Default,,0,0,0,,Мисаки-чан...
Dialogue: 0,0:19:26.51,0:19:27.70,Default,,0,0,0,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,0:19:29.57,0:19:31.88,Default,,0,0,0,,Иизомисаки, шабуылды жалғастыр.
Dialogue: 0,0:19:32.01,0:19:34.61,Default,,0,0,0,,Сіз маған оңай айта аласыз.
Dialogue: 0,0:19:37.73,0:19:40.09,Default,,0,0,0,,Төңкерілген ұшуды сақтай отырып, таңқаларлық
Dialogue: 0,0:19:40.09,0:19:42.41,Default,,0,0,0,,Қайталанатын шабуылдар
Dialogue: 0,0:19:43.96,0:19:46.92,Default,,0,0,0,,Шабуыл, шабуыл, шабуыл
Dialogue: 0,0:19:49.27,0:19:50.04,Default,,0,0,0,,Саки…
Dialogue: 0,0:19:56.64,0:19:57.52,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:02.60,0:20:05.06,Default,,0,0,0,,Тобисава 1-ден 1-ге дейін
Dialogue: 0,0:20:06.11,0:20:08.35,Default,,0,0,0,,Ғажайып Мисаки-сенпай
Dialogue: 0,0:20:08.35,0:20:09.57,Default,,0,0,0,,Галстук
Dialogue: 0,0:20:09.57,0:20:10.76,Default,,0,0,0,,Кобра
Dialogue: 0,0:20:10.77,0:20:14.67,Default,,0,0,0,,Тобисава төңкерілген ұшудан кобрамен 1 ұпай алды.
Dialogue: 0,0:20:15.19,0:20:17.36,Default,,0,0,0,,Саки, сен не істеп жатырсың?
Dialogue: 0,0:20:17.88,0:20:20.13,Default,,0,0,0,,Бұндай ұсқынсыз ойынның қажеті жоқ.
Dialogue: 0,0:20:20.90,0:20:22.57,Default,,0,0,0,,Иә Ирина
Dialogue: 0,0:20:23.79,0:20:28.89,Default,,0,0,0,,Менде бар нәрсемен күресемін.
Dialogue: 0,0:20:29.51,0:20:32.36,Default,,0,0,0,,Сіз ше? Инуи мырза
Dialogue: 0,0:20:34.04,0:20:35.10,Default,,0,0,0,,Барлығы...
Dialogue: 0,0:20:43.64,0:20:44.52,Default,,0,0,0,,Бұл тест
Dialogue: 0,0:20:46.57,0:20:48.57,Default,,0,0,0,,Мәңгілікке қашпа, маған қарай кел
Dialogue: 0,0:20:50.37,0:20:52.58,Default,,0,0,0,,Менің денем ыстық
Dialogue: 0,0:20:53.67,0:20:56.45,Default,,0,0,0,,Мен бұл қызды жеңгім келеді.
Dialogue: 0,0:20:57.27,0:20:58.84,Default,,0,0,0,,Мен ит төбелесінде жеңгім келеді
Dialogue: 0,0:21:01.60,0:21:02.99,Default,,0,0,0,,Ирина, кешіріңіз.
Dialogue: 0,0:21:09.78,0:21:11.05,Default,,0,0,0,,Құрғақ нүкте
Dialogue: 0,0:21:15.12,0:21:16.57,Default,,0,0,0,,Ит төбелесінде де күшті
Dialogue: 0,0:21:17.23,0:21:18.42,Default,,0,0,0,,10 секунд қалды
Dialogue: 0,0:21:19.36,0:21:20.09,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:21:20.95,0:21:21.60,Default,,0,0,0,,Бірақ
Dialogue: 0,0:21:27.54,0:21:28.41,Default,,0,0,0,,плюс отбасылық әулеттік қорқыныш, деп ойлаймын
Dialogue: 0,0:21:32.41,0:21:33.68,Default,,0,0,0,,Матчтың соңы
Dialogue: 0,0:21:37.80,0:21:40.41,Default,,0,0,0,,Мисаки-чан керемет
Dialogue: 0,0:21:48.64,0:21:50.12,Default,,0,0,0,,Мен жеңе алмадым...
Dialogue: 0,0:21:52.88,0:21:53.70,Default,,0,0,0,,Мисаки
Dialogue: 0,0:22:00.53,0:22:04.81,Default,,0,0,0,,Мен мұндай әдемі жеңісті бірінші рет сезініп тұрмын.
Dialogue: 0,0:23:46.47,0:23:47.09,Default,,0,0,0,,Ұшу
Dialogue: 0,0:23:47.09,0:23:48.17,Default,,0,0,0,,«Мен… мен адаммын.»
Dialogue: 0,0:23:48.17,0:23:51.76,Default,,0,0,0,,Енді, тыныштық сәті... басталады.
Dialogue: 0,0:23:52.01,0:23:54.17,Default,,0,0,0,,Көбірек ұшайық... бірге.
Dialogue: 0,0:23:55.67,0:24:01.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory