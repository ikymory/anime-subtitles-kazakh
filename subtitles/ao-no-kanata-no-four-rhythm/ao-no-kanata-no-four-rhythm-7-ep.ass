Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.57,0:00:04.96,Default,,0,0,0,,Енді жазғы Личжоу Батыс округінің турнирінің екінші күні
Dialogue: 0,0:00:04.99,0:00:07.60,Default,,0,0,0,,Жаңа ғана 31-ойын аяқталды.
Dialogue: 0,0:00:08.05,0:00:11.87,Default,,0,0,0,,Күшті Шишима Суйсан, Майу Ганоко.
Dialogue: 0,0:00:11.87,0:00:16.70,Default,,0,0,0,,Бір қызығы, бірінші рет қатысқан Инуи Кайрё Гакуен оны жеңді.
Dialogue: 0,0:00:16.93,0:00:21.41,Default,,0,0,0,,Енді финалда турнирдің ең жылдам жүгірушісі Инуи болады.
Dialogue: 0,0:00:21.41,0:00:24.80,Default,,0,0,0,,Бұл абсолютті чемпион Синдоға қарсы матч болды.
Dialogue: 0,0:00:24.83,0:00:29.76,Default,,0,0,0,,Инуидің жылдамдығы Шиндоның жылдамдығына сәйкес келе ме?
Dialogue: 0,0:00:37.65,0:00:40.14,Default,,0,0,0,,Асука-сенпай таң қалдырды.
Dialogue: 0,0:00:40.19,0:00:43.50,Default,,0,0,0,,Мен шынымен жеңемін бе деп ойладым.
Dialogue: 0,0:00:43.57,0:00:45.24,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:00:46.31,0:00:49.08,Default,,0,0,0,,Мисаки-сенпайды да жіберіп алды.
Dialogue: 0,0:00:49.27,0:00:52.16,Default,,0,0,0,,Екеуі де керемет болды.
Dialogue: 0,0:00:54.27,0:00:57.20,Default,,0,0,0,,Дұрыс, солай емес пе?
Dialogue: 0,0:00:57.55,0:00:59.78,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:01:00.15,0:01:02.20,Default,,0,0,0,,Синдо мырзаға қарсы
Dialogue: 0,0:01:03.47,0:01:04.98,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасадыңыз, солай ма?
Dialogue: 0,0:02:44.83,0:02:47.28,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:02:48.49,0:02:54.10,Default,,0,0,0,,Танысқаныма қуаныштымын. Менің атым Ирина Авалон.
Dialogue: 0,0:02:54.37,0:02:55.91,Default,,0,0,0,,Мен Кай Линг екеніне сенімдімін...
Dialogue: 0,0:02:55.91,0:02:59.48,Default,,0,0,0,,Иә, мен Саки Инуидің екінші ойынын ойнап жатырмын.
Dialogue: 0,0:03:00.13,0:03:02.42,Default,,0,0,0,,Сіз оны тәрбиеледіңіз бе?
Dialogue: 0,0:03:02.69,0:03:10.52,Default,,0,0,0,,Иә, Саки екеуміз футбол клубын бастадық, өйткені біз Аои Кагамиге тәнті болдық.
Dialogue: 0,0:03:11.91,0:03:14.32,Default,,0,0,0,,Келесі матчты көріңіз
Dialogue: 0,0:03:14.63,0:03:17.48,Default,,0,0,0,,Мен саған бір қызық көрсетемін
Dialogue: 0,0:03:23.95,0:03:26.49,Default,,0,0,0,,Бұл матч керемет болды.
Dialogue: 0,0:03:26.49,0:03:29.43,Default,,0,0,0,,Бұл мен әуе соққыларының сериясын бірінші рет көруім.
Dialogue: 0,0:03:29.43,0:03:31.77,Default,,0,0,0,,Сонымен, сіз уақытты қалай жасайсыз?
Dialogue: 0,0:03:31.77,0:03:33.67,Default,,0,0,0,,Сіз әдетте қандай жаттығу жасайсыз?
Dialogue: 0,0:03:33.43,0:03:35.13,Default,,0,0,0,,Мм...м...
Dialogue: 0,0:03:33.69,0:03:35.92,Default,,0,0,0,,Сіз шынымен бастаушысыз ба?
Dialogue: 0,0:03:36.49,0:03:40.41,Default,,0,0,0,,Уау, сен білмей тұрып өте танымал ойыншыға айналдың.
Dialogue: 0,0:03:40.41,0:03:43.43,Default,,0,0,0,,Себебі сіз директор Синдоны бір сәтке болса да байсалды етіп жібердіңіз.
Dialogue: 0,0:03:43.43,0:03:44.74,Default,,0,0,0,,Бір уақытта шамамен 30 дана шығара алады.
Dialogue: 0,0:03:45.81,0:03:47.15,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:47.15,0:03:50.00,Default,,0,0,0,,Маширочи неге ол жерде мақтаншақ екен деп ойлаймын.
Dialogue: 0,0:03:55.13,0:03:56.80,Default,,0,0,0,,Мисаки де ұят болды.
Dialogue: 0,0:03:59.25,0:04:01.80,Default,,0,0,0,,Оны ит төбелеске әкелген дұрыс болды.
Dialogue: 0,0:04:02.07,0:04:05.10,Default,,0,0,0,,Мен мұны тағы бір рет істегенімде басқаша болар еді.
Dialogue: 0,0:04:07.91,0:04:09.66,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:04:15.17,0:04:18.34,Default,,0,0,0,,Финалдық сайыстар қазір өтеді.
Dialogue: 0,0:04:32.39,0:04:34.26,Default,,0,0,0,,Орналасқан жеріне қатысты
Dialogue: 0,0:04:36.39,0:04:37.08,Default,,0,0,0,,Жиын
Dialogue: 0,0:04:40.05,0:04:42.43,Default,,0,0,0,,Енді финалдық сайыстар басталды.
Dialogue: 0,0:04:42.43,0:04:44.45,Default,,0,0,0,,Әдеттегідей Инуи қалқымаға барады.
Dialogue: 0,0:04:44.45,0:04:47.53,Default,,0,0,0,,Ал Синдо екінші жолға төте жолды алады.
Dialogue: 0,0:04:47.53,0:04:49.71,Default,,0,0,0,,Инуи-сан өте жылдам.
Dialogue: 0,0:04:49.71,0:04:52.12,Default,,0,0,0,,Біз шайқастың қалай болатынын білмеуіміз мүмкін.
Dialogue: 0,0:04:52.23,0:04:55.57,Default,,0,0,0,,Мен бұл бір жақты шайқас болатындай сезінемін.
Dialogue: 0,0:04:55.57,0:04:57.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:57.05,0:05:00.44,Default,,0,0,0,,Себебі қарсылас жай ғана жылдам.
Dialogue: 0,0:05:00.57,0:05:03.96,Default,,0,0,0,,Егер бұл Синдо мырза болса, мен оны жеңіл қабылдайтынына сенімдімін.
Dialogue: 0,0:05:05.09,0:05:07.80,Default,,0,0,0,,Құрғақ нүкте 0-ден 1-ге дейін
Dialogue: 0,0:05:08.15,0:05:10.64,Default,,0,0,0,,Біріншіден, Инуи жетекшілік етеді.
Dialogue: 0,0:05:10.67,0:05:14.70,Default,,0,0,0,,Енді чемпион Шиндо бұдан қалай шығады?
Dialogue: 0,0:05:21.63,0:05:22.89,Default,,0,0,0,,Тез бол
Dialogue: 0,0:05:22.89,0:05:26.40,Default,,0,0,0,,Сол жылдам өсу маған да әсер етті.
Dialogue: 0,0:05:33.23,0:05:34.88,Default,,0,0,0,,Синдо нүктесі
Dialogue: 0,0:05:35.25,0:05:37.82,Default,,0,0,0,,Синдо ойыншысы Бұл қазірдің өзінде тең
Dialogue: 0,0:05:40.97,0:05:43.37,Default,,0,0,0,,Синдо 2-ден 1-ге дейінгі нүкте
Dialogue: 0,0:05:43.37,0:05:46.45,Default,,0,0,0,,Синдо күткендей, оның ең жақсы рухы мен бұлшықеттері бар.
Dialogue: 0,0:05:46.45,0:05:47.86,Default,,0,0,0,,Бұл кері қайтару.
Dialogue: 0,0:05:49.13,0:05:50.71,Default,,0,0,0,,Күтілгендей, директор.
Dialogue: 0,0:05:50.71,0:05:55.20,Default,,0,0,0,,Бірден барлығына чемпион Такафуджидің керемет күшін еске түсірейік.
Dialogue: 0,0:05:57.05,0:05:58.83,Default,,0,0,0,,жоғары жоғары
Dialogue: 0,0:05:58.83,0:06:03.10,Default,,0,0,0,,Екеуіміз де бір-бірімізді ұстай алмай үлкен белестерге жеттік.
Dialogue: 0,0:06:03.69,0:06:05.95,Default,,0,0,0,,Биіктігі 200 метрден асты.
Dialogue: 0,0:06:05.95,0:06:08.17,Default,,0,0,0,,Сіз ғарышқа қашуды жоспарлап отырсыз ба?
Dialogue: 0,0:06:08.17,0:06:09.36,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:12.29,0:06:13.75,Default,,0,0,0,,Саки Қазір
Dialogue: 0,0:06:13.75,0:06:15.32,Default,,0,0,0,,Иә Ирина
Dialogue: 0,0:06:25.55,0:06:28.17,Default,,0,0,0,,Инуи үшінші жүзуді көздеп отыр.
Dialogue: 0,0:06:28.17,0:06:30.30,Default,,0,0,0,,Синдо блоктауды жалғастыруда
Dialogue: 0,0:06:30.35,0:06:32.45,Default,,0,0,0,,Инуи суырып алып, қалқыманы алады ма?
Dialogue: 0,0:06:32.45,0:06:35.52,Default,,0,0,0,,Әлде Синдо оны ит төбелесіне әкеледі ме?
Dialogue: 0,0:06:36.09,0:06:39.26,Default,,0,0,0,,Әзірге Синдо мырзаның қолы басым.
Dialogue: 0,0:06:39.41,0:06:42.66,Default,,0,0,0,,Иә, Синдо-сан менің айналамда тамаша жұмыс істейді.
Dialogue: 0,0:06:43.01,0:06:44.66,Default,,0,0,0,,оның қазір қайда екенін немесе не істеп жатқанын білуге рұқсат жоқ па? Тіпті соны да білмейміз бе?
Dialogue: 0,0:06:44.95,0:06:47.59,Default,,0,0,0,,Дұрыс. Синдо мырза күткендей.
Dialogue: 0,0:06:47.59,0:06:48.78,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:06:49.35,0:06:50.89,Default,,0,0,0,,Қандай айырмашылығы бар?
Dialogue: 0,0:06:50.89,0:06:53.22,Default,,0,0,0,,Таңғажайып - Инуи мырза.
Dialogue: 0,0:06:53.95,0:06:57.19,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес, олар ұпай саны бойынша да көш бастады.
Dialogue: 0,0:06:57.19,0:07:00.90,Default,,0,0,0,,Ол белсенділік танытып, Инуидің қалқымаға баруына жол бермеді.
Dialogue: 0,0:07:00.91,0:07:04.46,Default,,0,0,0,,Инуи мырзаға осылай айтылып жатыр.
Dialogue: 0,0:07:04.47,0:07:06.48,Default,,0,0,0,,Иә, бұл не?
Dialogue: 0,0:07:06.59,0:07:08.32,Default,,0,0,0,,Курашина дұрыс айтады.
Dialogue: 0,0:07:09.37,0:07:11.80,Default,,0,0,0,,Синдо мырза мінсіз алда.
Dialogue: 0,0:07:11.83,0:07:14.80,Default,,0,0,0,,Инуи, керісінше, бірте-бірте азайып келеді.
Dialogue: 0,0:07:15.09,0:07:18.53,Default,,0,0,0,,Егер Инуи қайта-қайта басын басуға тырысса,
Dialogue: 0,0:07:18.53,0:07:20.54,Default,,0,0,0,,Жер бетіне шығарылды
Dialogue: 0,0:07:21.01,0:07:23.54,Default,,0,0,0,,Егер бұл орын алса, ол өте тиімсіз болады.
Dialogue: 0,0:07:23.89,0:07:25.71,Default,,0,0,0,,Ой... бұл кездейсоқтық емес.
Dialogue: 0,0:07:25.71,0:07:29.56,Default,,0,0,0,,Бұл басқа адамды қуып бара жатқанда табиғи түрде болды.
Dialogue: 0,0:07:29.73,0:07:32.94,Default,,0,0,0,,Бұл Синдо мырза. Бұлай болуы мүмкін емес.
Dialogue: 0,0:07:34.13,0:07:36.84,Default,,0,0,0,,Шин...мырза. Синдо...
Dialogue: 0,0:07:36.89,0:07:38.68,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:42.55,0:07:43.99,Default,,0,0,0,,Бу…Директор
Dialogue: 0,0:07:43.99,0:07:47.63,Default,,0,0,0,,Синдо Инуиді ұстап тұрған сияқты.
Dialogue: 0,0:07:47.63,0:07:49.95,Default,,0,0,0,,Тастап, келесі жолға көшті
Dialogue: 0,0:07:49.95,0:07:52.50,Default,,0,0,0,,Синдо мырза кетіп қалды.
Dialogue: 0,0:07:53.35,0:07:55.68,Default,,0,0,0,,Құрғақ нүкте 2 қарсы 2
Dialogue: 0,0:07:56.31,0:07:58.20,Default,,0,0,0,,Бұл теңдік.
Dialogue: 0,0:08:00.85,0:08:05.18,Default,,0,0,0,,Ой, екінші жол сияқты жоғарғы жағында тағы бір шайқас?
Dialogue: 0,0:08:05.37,0:08:07.06,Default,,0,0,0,,Бірдей кеңейту
Dialogue: 0,0:08:07.37,0:08:08.26,Default,,0,0,0,,Саки
Dialogue: 0,0:08:08.37,0:08:09.78,Default,,0,0,0,,Иә Ирина
Dialogue: 0,0:08:17.55,0:08:19.43,Default,,0,0,0,,Екінші жол сияқты
Dialogue: 0,0:08:19.43,0:08:21.88,Default,,0,0,0,,Мені төмен бағыттап жатқан сияқты.
Dialogue: 0,0:08:22.07,0:08:25.50,Default,,0,0,0,,Жоқ, ол толығымен басқарылады.
Dialogue: 0,0:08:25.55,0:08:27.02,Default,,0,0,0,,Бақылау?
Dialogue: 0,0:08:27.15,0:08:31.22,Default,,0,0,0,,Басынан бастап Инуи қалқыма алуға немесе ит төбелесіне қатысуға ниеті болған жоқ.
Dialogue: 0,0:08:31.41,0:08:35.24,Default,,0,0,0,,Мен тек басқа адамды бақылау және үстемдік ету туралы ойладым.
Dialogue: 0,0:08:35.33,0:08:37.30,Default,,0,0,0,,Бақылау дегеніміз не?
Dialogue: 0,0:08:37.39,0:08:42.14,Default,,0,0,0,,Бұл қалқыманы ұстап, арқасын тигізетін ұшатын цирк.
Dialogue: 0,0:08:46.45,0:08:50.78,Default,,0,0,0,,Директор, егер жағдай осылай жалғаса берсе, біз енді ештеңе істей алмаймыз.
Dialogue: 0,0:08:57.33,0:09:00.27,Default,,0,0,0,,Ауа соққысының тік бұрылысы
Dialogue: 0,0:09:00.27,0:09:01.50,Default,,0,0,0,,Енді жоғарыда...
Dialogue: 0,0:09:06.69,0:09:09.54,Default,,0,0,0,,Егер стандартты емес заттар қоршап алып, жойылса
Dialogue: 0,0:09:09.85,0:09:12.68,Default,,0,0,0,,FC эволюциялық тұйыққа түседі
Dialogue: 0,0:09:13.09,0:09:16.28,Default,,0,0,0,,Ақырында біз жойылу жолымен жүреміз.
Dialogue: 0,0:09:17.21,0:09:21.20,Default,,0,0,0,,Сондықтан мен бұл техниканы мәңгілікке мөрмен бекіттім.
Dialogue: 0,0:09:35.63,0:09:38.70,Default,,0,0,0,,Ату күшімен қалқыманы көздеу. Егер бұлай болса...
Dialogue: 0,0:09:39.03,0:09:40.97,Default,,0,0,0,,Саки оны аяқта.
Dialogue: 0,0:09:40.97,0:09:42.34,Default,,0,0,0,,Иә Ирина
Dialogue: 0,0:09:57.21,0:10:00.46,Default,,0,0,0,,Ойын жинағы Жеңімпаз Инуи
Dialogue: 0,0:10:02.49,0:10:05.55,Default,,0,0,0,,Финалдық кездесу біртүрлі көңіл-күймен аяқталды
Dialogue: 0,0:10:05.55,0:10:08.07,Default,,0,0,0,,Жеңімпаз - Саки Инуи
Dialogue: 0,0:10:08.07,0:10:12.66,Default,,0,0,0,,Чемпион Синдоны қатты күйзеліспен жеңді
Dialogue: 0,0:10:16.45,0:10:19.27,Default,,0,0,0,,Синдо мырза, солай...
Dialogue: 0,0:10:19.27,0:10:20.66,Default,,0,0,0,,Керемет
Dialogue: 0,0:10:22.19,0:10:23.42,Default,,0,0,0,,Асука
Dialogue: 0,0:10:23.65,0:10:25.46,Default,,0,0,0,,оның қазір қайда екенін немесе не істеп жатқанын білуге рұқсат жоқ па? Тіпті соны да білмейміз бе?
Dialogue: 0,0:10:27.47,0:10:30.14,Default,,0,0,0,,Бұл да ұшатын цирк.
Dialogue: 0,0:10:30.79,0:10:35.32,Default,,0,0,0,,Мынаны қарашы, бұл бетті қалай жасауға болады?
Dialogue: 0,0:10:37.89,0:10:41.92,Default,,0,0,0,,Мен... білмеймін.
Dialogue: 0,0:10:48.93,0:10:50.57,Default,,0,0,0,,Эй, Мисаки ше?
Dialogue: 0,0:10:50.57,0:10:53.73,Default,,0,0,0,,Шаршағандықтан алдымен үйге баратынын айтады.
Dialogue: 0,0:10:53.73,0:10:57.02,Default,,0,0,0,,Сіз шынымен де қазір өз қарқыныңыздасыз.
Dialogue: 0,0:11:00.81,0:11:02.36,Default,,0,0,0,,Құс торы
Dialogue: 0,0:11:03.51,0:11:08.62,Default,,0,0,0,,Бұл біз ойлап тапқан әдемі FC техникасының атауы.
Dialogue: 0,0:11:08.95,0:11:10.50,Default,,0,0,0,,Әдемі?
Dialogue: 0,0:11:11.03,0:11:12.96,Default,,0,0,0,,Балалар, сендер ойнадыңдар ма?
Dialogue: 0,0:11:13.23,0:11:16.18,Default,,0,0,0,,Қарсыласыңызды тамаша басқару әдістері
Dialogue: 0,0:11:16.77,0:11:20.66,Default,,0,0,0,,Бұл сіз жасаған әдемі FC.
Dialogue: 0,0:11:22.65,0:11:24.14,Default,,0,0,0,,Қайта кездескенше
Dialogue: 0,0:11:24.49,0:11:25.46,Default,,0,0,0,,Сонымен
Dialogue: 0,0:11:28.73,0:11:33.86,Default,,0,0,0,,Сіз өз қылмысыңыз үшін әлі төлеген жоқсыз ба?
Dialogue: 0,0:11:44.25,0:11:45.70,Default,,0,0,0,,Мисаки
Dialogue: 0,0:11:45.91,0:11:48.28,Default,,0,0,0,,Сіз үй тапсырмасын орындап үлгердіңіз.
Dialogue: 0,0:11:49.37,0:11:50.57,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:11:50.57,0:11:53.52,Default,,0,0,0,,Мен сіздің көмегіңізді бағалаймын.
Dialogue: 0,0:11:54.11,0:11:58.66,Default,,0,0,0,,Жазғы демалыс аяқталуға жақын, мен мектепке дайындалуым керек.
Dialogue: 0,0:11:59.05,0:12:00.81,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:12:00.81,0:12:04.60,Default,,0,0,0,,Осыны айтып, бүгін мектепте бірдеңе болған жоқ па?
Dialogue: 0,0:12:05.51,0:12:08.23,Default,,0,0,0,,Иә, ештеңе жоқ.
Dialogue: 0,0:12:08.23,0:12:11.90,Default,,0,0,0,,Мен солай деп үміттенемін.
Dialogue: 0,0:12:18.05,0:12:21.58,Default,,0,0,0,,Асука Курашина кеттік
Dialogue: 0,0:12:24.95,0:12:28.01,Default,,0,0,0,,Жарайсың, Курашина, көңіл-күйің жақсы.
Dialogue: 0,0:12:28.01,0:12:31.18,Default,,0,0,0,,Мен де барамын, бекінемін.
Dialogue: 0,0:12:34.13,0:12:37.17,Default,,0,0,0,,Бұл медуза. Менің аяғымда медуза бар.
Dialogue: 0,0:12:37.17,0:12:39.74,Default,,0,0,0,,Оның шырышты болғаны сонша, қорқынышты
Dialogue: 0,0:12:39.85,0:12:42.40,Default,,0,0,0,,Медузаның уын табандылықпен емдеуге болады.
Dialogue: 0,0:12:42.47,0:12:45.66,Default,,0,0,0,,Керісінше, пышақталғанша пышақ сал.
Dialogue: 0,0:12:46.05,0:12:49.52,Default,,0,0,0,,Ешқайсыңды да ренжітпеу үшін абай бол.
Dialogue: 0,0:12:51.65,0:12:54.48,Default,,0,0,0,,Мисаки-сенпай да келсе екен.
Dialogue: 0,0:12:56.31,0:13:00.18,Default,,0,0,0,,Егер мен мұны істесем, мен оны купальникте көре алар едім.
Dialogue: 0,0:13:01.67,0:13:03.92,Default,,0,0,0,,Таза ақ
Dialogue: 0,0:13:05.19,0:13:07.44,Default,,0,0,0,,Мисаки Сенпай
Dialogue: 0,0:13:07.45,0:13:10.80,Default,,0,0,0,,Егер кенеттен біреу маған жоспарлары бар екенін айтса, көмектесу мүмкін емес.
Dialogue: 0,0:13:14.05,0:13:16.03,Default,,0,0,0,,Менің ойымша, уақыт келді
Dialogue: 0,0:13:16.03,0:13:17.50,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:13:17.97,0:13:20.02,Default,,0,0,0,,Мадока, бәріне қоңырау шалыңыз.
Dialogue: 0,0:13:20.07,0:13:20.97,Default,,0,0,0,,Иә
Dialogue: 0,0:13:20.97,0:13:22.55,Default,,0,0,0,,Етті күту
Dialogue: 0,0:13:22.55,0:13:24.12,Default,,0,0,0,,Тағы біраз күтіңіз.
Dialogue: 0,0:13:26.21,0:13:30.55,Default,,0,0,0,,Ет дәмді, бірақ асшаян мен кальмар да өте дәмді.
Dialogue: 0,0:13:30.55,0:13:32.95,Default,,0,0,0,,Сатоин мырзаға рахмет.
Dialogue: 0,0:13:32.95,0:13:36.17,Default,,0,0,0,,Иә, менің бара алмағанымның орнына.
Dialogue: 0,0:13:36.17,0:13:40.14,Default,,0,0,0,,Сато тобының беделі дәмді теңіз өнімдерін дайындауға жұмсалған сияқты.
Dialogue: 0,0:13:40.33,0:13:42.24,Default,,0,0,0,,Сато тобы?
Dialogue: 0,0:13:42.27,0:13:45.11,Default,,0,0,0,,Сатоин мырза туралы тағы да жұмбақ бар.
Dialogue: 0,0:13:45.11,0:13:48.54,Default,,0,0,0,,Ет берген Ширасе мырзаға да рахмет.
Dialogue: 0,0:13:48.73,0:13:51.66,Default,,0,0,0,,Жазғы турнир өте сәтті өтті.
Dialogue: 0,0:13:51.69,0:13:54.94,Default,,0,0,0,,Бұл соншалықты үлкен мәміле емес, және
Dialogue: 0,0:13:54.95,0:13:59.85,Default,,0,0,0,,Бүгін маңызды күн деп естідім.
Dialogue: 0,0:13:59.85,0:14:02.08,Default,,0,0,0,,Маңызды ма? күні?
Dialogue: 0,0:14:02.43,0:14:03.56,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:03.99,0:14:08.27,Default,,0,0,0,,Бүгін мен Kunahama Academy FC клубы үшін үлкен шешім қабылдадым.
Dialogue: 0,0:14:08.27,0:14:09.82,Default,,0,0,0,,Мен бәріне айтамын
Dialogue: 0,0:14:10.17,0:14:11.87,Default,,0,0,0,,Мен бақытты адаммын
Dialogue: 0,0:14:11.87,0:14:13.49,Default,,0,0,0,,Мен әрқашан жалғыз болдым
Dialogue: 0,0:14:13.49,0:14:16.58,Default,,0,0,0,,Барлығымен бірге турнирлерге қатысып, жақсы өнер көрсетті.
Dialogue: 0,0:14:16.63,0:14:20.98,Default,,0,0,0,,Алайда облыстық турнирде жеңіске жету арманы әлі орындалған жоқ.
Dialogue: 0,0:14:21.09,0:14:24.54,Default,,0,0,0,,Сондықтан бәріңіз сол арманыңызды жүзеге асырғаныңызды қалаймын.
Dialogue: 0,0:14:27.17,0:14:28.60,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:29.33,0:14:31.81,Default,,0,0,0,,Мен менеджер болу арманымды жүзеге асырғым келеді.
Dialogue: 0,0:14:31.81,0:14:35.98,Default,,0,0,0,,Бірақ Асука-сенпай шынымен жеңуі мүмкін.
Dialogue: 0,0:14:36.15,0:14:41.16,Default,,0,0,0,,Жазғы турнирдің сәттілігіне қарап, бұл арман емес шығар.
Dialogue: 0,0:14:41.35,0:14:43.05,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:14:43.05,0:14:47.04,Default,,0,0,0,,Сонымен, жаттықтырушы лауазымы күзгі турнир аяқталғанша ұзартылады.
Dialogue: 0,0:14:47.45,0:14:48.19,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:48.19,0:14:51.84,Default,,0,0,0,,Иә, бәріміз және жаттықтырушы, бірге жеңейік.
Dialogue: 0,0:14:52.91,0:14:58.12,Default,,0,0,0,,Барлығы, менің ойымша, біз күзгі турнирге дайындалғандықтан, қазірден бастап жаттығу қиын болады.
Dialogue: 0,0:14:58.19,0:15:01.80,Default,,0,0,0,,Ұшуды көңілді өткізуді ұмытпаңыз.
Dialogue: 0,0:15:02.75,0:15:03.56,Default,,0,0,0,,Иә
Dialogue: 0,0:15:03.81,0:15:07.19,Default,,0,0,0,,Сонда Курашина келесі менеджер болуы керек пе?
Dialogue: 0,0:15:07.19,0:15:09.04,Default,,0,0,0,,Иә, менің сұрағым бар
Dialogue: 0,0:15:09.41,0:15:10.21,Default,,0,0,0,,Не?
Dialogue: 0,0:15:10.21,0:15:12.24,Default,,0,0,0,,Менеджер не істейді?
Dialogue: 0,0:15:14.57,0:15:16.66,Default,,0,0,0,,Басқа біреу бар ма?
Dialogue: 0,0:15:18.65,0:15:24.58,Default,,0,0,0,,Жарайды, мен көмектесе алмаймын. Бір нәрсе, мен жаңа менеджер лауазымына үміткермін.
Dialogue: 0,0:15:25.89,0:15:28.28,Default,,0,0,0,,Мадока-чан Сергек бас кейіпкер
Dialogue: 0,0:15:29.77,0:15:32.26,Default,,0,0,0,,Сонда жаңа менеджер Мадока болуы керек пе?
Dialogue: 0,0:15:32.51,0:15:33.91,Default,,0,0,0,,Келісіңіз
Dialogue: 0,0:15:33.91,0:15:36.67,Default,,0,0,0,,Әй, балалар, бұл жарық емес.
Dialogue: 0,0:15:36.67,0:15:39.29,Default,,0,0,0,,Мен бұл әдеттегідей қызықтырақ болар ма деп ойлаймын.
Dialogue: 0,0:15:39.29,0:15:41.31,Default,,0,0,0,,Жаңа менеджер, ет алыңыз.
Dialogue: 0,0:15:41.31,0:15:42.79,Default,,0,0,0,,Мен де, өтінемін.
Dialogue: 0,0:15:42.79,0:15:44.97,Default,,0,0,0,,Жарық Бұл өте жеңіл
Dialogue: 0,0:15:44.97,0:15:46.49,Default,,0,0,0,,Тезірек алыңыз.
Dialogue: 0,0:15:46.49,0:15:48.96,Default,,0,0,0,,Иә, өтінемін, бұл дұрыс емес.
Dialogue: 0,0:16:34.45,0:16:37.01,Default,,0,0,0,,Мисаки-сенпай сыртқа шықты ма?
Dialogue: 0,0:16:37.01,0:16:39.14,Default,,0,0,0,,О, сен тыңдамадың.
Dialogue: 0,0:16:39.67,0:16:43.26,Default,,0,0,0,,Таңертең Фукуру аралына баратынын айтты.
Dialogue: 0,0:16:43.49,0:16:45.28,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:45.33,0:16:48.58,Default,,0,0,0,,Мен күтпеген удонды жеткізуге тырыстым.
Dialogue: 0,0:16:54.87,0:16:55.75,Default,,0,0,0,,Бұл Йоцушима-кун.
Dialogue: 0,0:16:55.75,0:16:57.84,Default,,0,0,0,,Жоқ, бұл қорқынышты
Dialogue: 0,0:16:58.01,0:17:00.00,Default,,0,0,0,,Мен мүлде қорықпаймын
Dialogue: 0,0:17:02.29,0:17:05.30,Default,,0,0,0,,Жылама, кел!
Dialogue: 0,0:17:05.87,0:17:07.27,Default,,0,0,0,,Жоқ, бұл қорқынышты
Dialogue: 0,0:17:07.27,0:17:08.09,Default,,0,0,0,,Жылама
Dialogue: 0,0:17:08.09,0:17:09.51,Default,,0,0,0,,Тоқта, аға...
Dialogue: 0,0:17:09.51,0:17:11.10,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:17:12.29,0:17:17.02,Default,,0,0,0,,Мен не істеп жатырмын? Менде бұл бар.
Dialogue: 0,0:17:29.75,0:17:31.04,Default,,0,0,0,,Соба кеспесі
Dialogue: 0,0:17:31.63,0:17:33.27,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:17:31.91,0:17:35.68,Default,,0,0,0,,Осы аптадағы төрт арал арнасының жаңалықтары
Dialogue: 0,0:17:35.77,0:17:38.21,Default,,0,0,0,,Биылғы ұшатын цирк бойынша аймақтық іріктеу турнирі
Dialogue: 0,0:17:38.21,0:17:43.49,Default,,0,0,0,,Өткен жылғы чемпионның бірінші рет бәсекеге түсіп жатқан ойыншыдан жеңілуі үлкен реніш болды.
Dialogue: 0,0:17:43.49,0:17:47.81,Default,,0,0,0,,Дәл осындай қарқынмен олар республикалық турнирде жеңіске жетіп, көпшіліктің назарын өзіне аударуда.
Dialogue: 0,0:17:47.81,0:17:48.75,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:17:48.75,0:17:52.45,Default,,0,0,0,,Шиндо-сенпай жаңа келген жігіттен жеңіліп қалды.
Dialogue: 0,0:17:52.45,0:17:54.81,Default,,0,0,0,,Қатты таң қалды
Dialogue: 0,0:17:54.81,0:17:57.48,Default,,0,0,0,,Екінші адам - Kairyo академиясының студенті.
Dialogue: 0,0:17:58.41,0:18:00.90,Default,,0,0,0,,Хай Лингте осындай данышпан бар.
Dialogue: 0,0:18:07.07,0:18:10.96,Default,,0,0,0,,Жаңбыр жауып тұр. Мен үйге бұлай ұша алмаймын.
Dialogue: 0,0:18:11.29,0:18:13.52,Default,,0,0,0,,Мен үйге паромды тыныш апаруым керек пе?
Dialogue: 0,0:18:21.55,0:18:23.38,Default,,0,0,0,,Жаңбыр жауып тұр.
Dialogue: 0,0:18:32.73,0:18:33.78,Default,,0,0,0,,Сен…
Dialogue: 0,0:18:42.39,0:18:44.58,Default,,0,0,0,,Бұл жазғы турнирден бері болды.
Dialogue: 0,0:18:45.25,0:18:46.20,Default,,0,0,0,,Иә
Dialogue: 0,0:18:47.57,0:18:49.18,Default,,0,0,0,,Дүкенге келдің бе?
Dialogue: 0,0:18:49.91,0:18:52.04,Default,,0,0,0,,Жазғы каникул да соңғысы
Dialogue: 0,0:18:52.07,0:18:56.42,Default,,0,0,0,,Жазғы демалыс Қарасам, қазір жазғы демалыс болатын.
Dialogue: 0,0:18:57.07,0:18:59.76,Default,,0,0,0,,Синдо мырза да дүкен аралауға келді ме?
Dialogue: 0,0:19:00.95,0:19:03.47,Default,,0,0,0,,Жүгіруге арналған киімдер мен қосымша заттарды сатып алыңыз.
Dialogue: 0,0:19:03.47,0:19:08.10,Default,,0,0,0,,Жүгіруге келетін болсақ, Синдо мырза, сіз жеңіл атлет болуды мақсат етесіз бе?
Dialogue: 0,0:19:09.07,0:19:11.72,Default,,0,0,0,,Жоқ, әрине бұл FC үшін.
Dialogue: 0,0:19:11.85,0:19:14.20,Default,,0,0,0,,Бұл FC ма?
Dialogue: 0,0:19:14.51,0:19:18.90,Default,,0,0,0,,Университет студенттері физикалық жағынан бізден мүлде бөлек.
Dialogue: 0,0:19:19.19,0:19:23.00,Default,,0,0,0,,Оқуымды бітірер алдында қатты дайындаламын деп ойладым.
Dialogue: 0,0:19:30.85,0:19:32.12,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:34.01,0:19:37.00,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:19:37.23,0:19:39.16,Default,,0,0,0,,Мен осылай жеңіліп қалсам да
Dialogue: 0,0:19:41.79,0:19:44.44,Default,,0,0,0,,Кешіріңіз, мен дөрекі сөз айттым.
Dialogue: 0,0:19:44.95,0:19:46.84,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:19:47.37,0:19:50.86,Default,,0,0,0,,Бұл матч мен үшін де таң қалдырды.
Dialogue: 0,0:19:51.17,0:19:54.47,Default,,0,0,0,,Мен қорқынышты сезіндім, өйткені мен өзімнің бұрынғы болмысымнан бас тартқандай сезіндім.
Dialogue: 0,0:19:54.47,0:19:56.74,Default,,0,0,0,,Мен неге қорқып кеттім?
Dialogue: 0,0:19:57.11,0:20:00.06,Default,,0,0,0,,Себебі қорқу қызық.
Dialogue: 0,0:20:03.19,0:20:06.68,Default,,0,0,0,,Өткен жылға дейін танымал болған стильдер енді қолданылмайды.
Dialogue: 0,0:20:07.15,0:20:11.57,Default,,0,0,0,,FC – бұл бір күнде бәрі өзгеретін спорт түрі.
Dialogue: 0,0:20:11.57,0:20:13.32,Default,,0,0,0,,Мен мұны сол ойыннан білдім.
Dialogue: 0,0:20:13.75,0:20:16.22,Default,,0,0,0,,Ең бастысы, сол сәттің куәсі болу
Dialogue: 0,0:20:16.29,0:20:18.36,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:20:19.71,0:20:21.36,Default,,0,0,0,,Өзгеріс қорқынышты
Dialogue: 0,0:20:21.43,0:20:24.06,Default,,0,0,0,,Бірақ оны жеңгеннен кейін ол қызық болады
Dialogue: 0,0:20:24.45,0:20:27.68,Default,,0,0,0,,Бұл қызық па?
Dialogue: 0,0:20:27.99,0:20:31.76,Default,,0,0,0,,Егер мен оны бұдан былай қызық көрмесем, мен жұмыстан шығамын.
Dialogue: 0,0:20:34.33,0:20:36.24,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:20:50.91,0:20:52.83,Default,,0,0,0,,Иә? Сіз атқа мінбейсіз бе?
Dialogue: 0,0:20:52.83,0:20:56.17,Default,,0,0,0,,А... Әлі де сауда жасауым керек екені есіме түсті.
Dialogue: 0,0:20:56.17,0:20:57.54,Default,,0,0,0,,Мен келесіде қайтамын
Dialogue: 0,0:20:57.71,0:20:59.30,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:21:20.61,0:21:22.78,Default,,0,0,0,,Міне жаңа семестр.
Dialogue: 0,0:21:22.87,0:21:24.43,Default,,0,0,0,,Практика
Dialogue: 0,0:21:24.43,0:21:26.49,Default,,0,0,0,,Жанып тұрсың, Асука.
Dialogue: 0,0:21:26.49,0:21:29.47,Default,,0,0,0,,Иә, мен ұшуға шыдамаймын.
Dialogue: 0,0:21:29.47,0:21:31.52,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:21:31.55,0:21:34.81,Default,,0,0,0,,Сонда Мисаки-сенпай әлі осында ма?
Dialogue: 0,0:21:34.81,0:21:36.43,Default,,0,0,0,,Сіз бірге болмадыңыз ба?
Dialogue: 0,0:21:36.43,0:21:41.10,Default,,0,0,0,,Ол маған бүгін ерте кеткенін айтты, сондықтан ол қазірдің өзінде осында деп ойлаймын.
Dialogue: 0,0:21:42.45,0:21:46.10,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:21:47.43,0:21:48.55,Default,,0,0,0,,Не болды, Мадока?
Dialogue: 0,0:21:48.55,0:21:50.82,Default,,0,0,0,,Жоқ, бұл қиын.
Dialogue: 0,0:21:50.95,0:21:52.65,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:52.65,0:21:53.66,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:56.73,0:21:58.19,Default,,0,0,0,,Мен оны Моулд Колизейге жетпей тұрып жоюым керек
Dialogue: 0,0:21:58.19,0:22:03.68,Default,,0,0,0,,Мм...сіз қалжыңдап тұрсыз, солай ма?
Dialogue: 0,0:22:04.53,0:22:06.28,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:22:09.27,0:22:10.94,Default,,0,0,0,,Мисаки-чан
Dialogue: 0,0:23:46.79,0:23:48.03,Default,,0,0,0,,Асука
Dialogue: 0,0:23:47.85,0:23:48.41,Default,,0,0,0,,Мисаки-чан
Dialogue: 0,0:23:48.41,0:23:50.38,Default,,0,0,0,,Мисаки Сенпай
Dialogue: 0,0:23:50.51,0:23:54.30,Default,,0,0,0,,Мен енді ұша алмаймын...
Dialogue: 0,0:23:55.80,0:24:01.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory