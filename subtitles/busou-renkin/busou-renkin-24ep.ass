Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.66,0:00:16.66,Default,,0,0,0,,Алхимияның мәнін жинақтау арқылы пысықталады
Dialogue: 0,0:00:17.00,0:00:19.66,Default,,0,0,0,,Табиғаттан тыс қорытпалы негізгі темір
Dialogue: 0,0:00:20.80,0:00:23.83,Default,,0,0,0,,Ол адамның жауынгерлік инстинкті арқылы белсендіріледі.
Dialogue: 0,0:00:24.16,0:00:27.06,Default,,0,0,0,,Оған ие болған адам оның жасырын күшін формаға айналдырады.
Dialogue: 0,0:00:27.66,0:00:30.13,Default,,0,0,0,,Бірегей қару жасаңыз
Dialogue: 0,0:00:31.40,0:00:34.30,Default,,0,0,0,,Бұл Бусу Рекин.
Dialogue: 0,0:00:37.43,0:00:42.23,Default,,0,0,0,,Oh…Oh…Da…
Dialogue: 0,0:00:42.63,0:00:49.03,Default,,0,0,0,,О... О... Да... сенімен
Dialogue: 0,0:00:49.36,0:00:58.30,Default,,0,0,0,,Тоқтауға уақытым жоқ, Ойлануға уақытым жоқ.
Dialogue: 0,0:00:59.70,0:01:09.10,Default,,0,0,0,,Жүрегімде бар сезіммен, Қайнаған шайқасқа аттанамын
Dialogue: 0,0:01:11.20,0:01:15.73,Default,,0,0,0,,Биліктің тым үлкен қабырғасы, дүниенің қараңғылығы
Dialogue: 0,0:01:16.33,0:01:21.43,Default,,0,0,0,,Мен міндетті түрде жеңілемін, шектен тыс
Dialogue: 0,0:01:22.06,0:01:26.70,Default,,0,0,0,,Дәл қазір түсінбейтін нәрселерім көп.
Dialogue: 0,0:01:27.16,0:01:31.93,Default,,0,0,0,,Өзіңіз сенетін осы жолмен жүріңіз
Dialogue: 0,0:01:32.40,0:01:37.46,Default,,0,0,0,,Қандай жау, қандай одақтас болғаның маңызды емес.
Dialogue: 0,0:01:37.80,0:01:44.00,Default,,0,0,0,,Қолымды жібересің бе? Қып-қызыл ант
Dialogue: 0,0:01:46.13,0:01:50.90,Default,,0,0,0,,Мен сені мәңгілікке қуамын
Dialogue: 0,0:01:51.40,0:01:56.20,Default,,0,0,0,,Бүкіл жол, барлық жол, Ертеңгі күнге батылдық
Dialogue: 0,0:01:56.56,0:02:02.63,Default,,0,0,0,,Мәңгілік өзіңмен бірге оттайтын жүрегім
Dialogue: 0,0:02:12.73,0:02:13.60,Default,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:02:14.30,0:02:15.56,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:02:15.86,0:02:18.93,Default,,0,0,0,,Аа, бұл мен ойлаған нұсқа болды.
Dialogue: 0,0:02:19.86,0:02:24.13,Default,,0,0,0,,Мен, сен және Токико-сан аздап кідіруге тура келеді.
Dialogue: 0,0:02:25.96,0:02:27.73,Default,,0,0,0,,Жақсы орындасақ, бәрі құтқарылады.
Dialogue: 0,0:02:28.63,0:02:30.00,Default,,0,0,0,,Ынтымақтастық жасашы, Чоно.
Dialogue: 0,0:02:30.63,0:02:32.60,Default,,0,0,0,,Сыйақы менімен есеп айырысу.
Dialogue: 0,0:02:33.43,0:02:38.70,Default,,0,0,0,,Қалаған уақыт, орын және шарттар туралы не айтасыз?
Dialogue: 0,0:02:39.66,0:02:40.63,Default,,0,0,0,,Муто мырза
Dialogue: 0,0:02:42.70,0:02:43.36,Default,,0,0,0,,Тек осы екі қарапайым белгіні есте сақта.
Dialogue: 0,0:02:44.63,0:02:49.66,Default,,0,0,0,,Менің нұсқаларыма қарағанда жағдайлар жақсырақ көрінеді.
Dialogue: 0,0:02:51.60,0:02:53.16,Default,,0,0,0,,Шатаспаңыз
Dialogue: 0,0:03:12.30,0:03:14.66,Default,,0,0,0,,Бастер Барон жауынгерлік күйде қалады
Dialogue: 0,0:03:15.23,0:03:18.60,Default,,0,0,0,,Қолдау әр блоктан толқындық шабуылдар арқылы жалғасады.
Dialogue: 0,0:03:19.06,0:03:21.23,Default,,0,0,0,,Әскерлердің көпшілігі жойылды
Dialogue: 0,0:03:22.03,0:03:26.26,Default,,0,0,0,,Қалған күш-қуатты ескерсек, шешуші шайқастың уақыты таяп қалған шығар.
Dialogue: 0,0:03:27.70,0:03:30.86,Default,,0,0,0,,Сенім сызығы – Бастер Барон, ұлы жауынгер басшы.
Dialogue: 0,0:03:31.60,0:03:33.73,Default,,0,0,0,,Кадзуки Мутоның ақ өзегі темір
Dialogue: 0,0:03:35.96,0:03:36.40,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:03:38.70,0:03:39.96,Default,,0,0,0,,Виктор қозғалды
Dialogue: 0,0:03:40.23,0:03:41.90,Default,,0,0,0,,Бастер Баронға тез жақындап келеді
Dialogue: 0,0:03:42.53,0:03:44.00,Default,,0,0,0,,Қатысу басталады
Dialogue: 0,0:03:44.63,0:03:45.90,Default,,0,0,0,,Соңында
Dialogue: 0,0:03:46.23,0:03:46.66,Default,,0,0,0,,О
Dialogue: 0,0:03:47.36,0:03:48.20,Default,,0,0,0,,Бұл да
Dialogue: 0,0:03:49.63,0:03:51.30,Default,,0,0,0,,Ақ ядролық темір аяқталды
Dialogue: 0,0:03:52.00,0:03:52.50,Default,,0,0,0,,Кеттік
Dialogue: 0,0:03:57.13,0:03:57.90,Default,,0,0,0,,Токико-сан
Dialogue: 0,0:03:58.73,0:03:59.46,Default,,0,0,0,,баяу
Dialogue: 0,0:03:59.86,0:04:01.96,Default,,0,0,0,,Кездесу уақыты өтіп кетті.
Dialogue: 0,0:04:02.26,0:04:04.40,Default,,0,0,0,,Кешіріңіз, мен такояки сатып алған едім.
Dialogue: 0,0:04:05.20,0:04:05.70,Default,,0,0,0,,Барлығы ше?
Dialogue: 0,0:04:06.43,0:04:07.70,Default,,0,0,0,,Одан да баяу
Dialogue: 0,0:04:08.06,0:04:10.63,Default,,0,0,0,,Жазғы фестиваль болса да, бәрі тым толқыды.
Dialogue: 0,0:04:10.96,0:04:11.86,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:04:12.50,0:04:16.16,Default,,0,0,0,,Бұл жылына бір рет қана болады, ал отшашуға әлі уақыт бар.
Dialogue: 0,0:04:16.76,0:04:17.20,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:04:18.86,0:04:19.70,Default,,0,0,0,,Сіз
Dialogue: 0,0:04:19.83,0:04:20.26,Default,,0,0,0,,Хуг Хагу
Dialogue: 0,0:04:20.33,0:04:21.30,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:04:21.86,0:04:22.30,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:04:25.26,0:04:26.66,Default,,0,0,0,,Жаз аяқталуға жақын
Dialogue: 0,0:04:27.70,0:04:32.70,Default,,0,0,0,,Бұған дейін Виктор және ақ ядролық темір туралы.
Dialogue: 0,0:04:34.06,0:04:38.13,Default,,0,0,0,,Өткен күні Токико-сан менімен біраз батылдық танытты.
Dialogue: 0,0:04:38.63,0:04:39.10,Default,,0,0,0,,На
Dialogue: 0,0:04:48.33,0:04:49.43,Default,,0,0,0,,А га
Dialogue: 0,0:04:49.96,0:04:51.80,Default,,0,0,0,,Кез келген кездейсоқ мазасыздық?
Dialogue: 0,0:04:52.63,0:04:55.10,Default,,0,0,0,,Шынымды айтсам, аздап
Dialogue: 0,0:04:56.00,0:04:57.66,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,0:04:59.80,0:05:02.83,Default,,0,0,0,,Ақ ядролық темірді қалай пайдаланасыз?
Dialogue: 0,0:05:03.96,0:05:04.90,Default,,0,0,0,,Маған
Dialogue: 0,0:05:08.13,0:05:11.10,Default,,0,0,0,,Олай болса, өткен күні менімен бөліскен батылдығыңыз.
Dialogue: 0,0:05:11.76,0:05:12.76,Default,,0,0,0,,Саған қайтарып берейін бе?
Dialogue: 0,0:05:12.93,0:05:13.43,Default,,0,0,0,,Ах
Dialogue: 0,0:05:15.70,0:05:16.13,Default,,0,0,0,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:05:18.86,0:05:19.56,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:05:26.70,0:05:29.50,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:05:29.83,0:05:31.33,Default,,0,0,0,,-Кяааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:05:31.73,0:05:36.70,Default,,0,0,0,,-Ей, эй, мен кеше қайтып келгеннен бері атмосфера өзгерді деп ойладым--Аа аааааааааааааа
Dialogue: 0,0:05:37.10,0:05:38.46,Default,,0,0,0,,-Аа, жалғастыр, жалғастыр -А, а, а, а, а
Dialogue: 0,0:05:38.53,0:05:39.70,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:05:39.86,0:05:43.10,Default,,0,0,0,,-Сен мұны істей аласың ба? А-а, білесің бе, мынау, мынау.
Dialogue: 0,0:05:43.46,0:05:46.66,Default,,0,0,0,,Жасыратын ештеңе жоқ, бәрі міндетті түрде бақытты болады.
Dialogue: 0,0:05:47.10,0:05:47.83,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:05:48.66,0:05:49.33,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:49.76,0:05:50.20,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:05:50.76,0:05:51.60,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:52.80,0:05:53.60,Default,,0,0,0,,Ах
Dialogue: 0,0:05:53.93,0:05:54.36,Default,,0,0,0,,Уф
Dialogue: 0,0:05:55.93,0:05:57.53,Default,,0,0,0,,Сенпай Муто
Dialogue: 0,0:05:58.30,0:05:58.73,Default,,0,0,0,,Ах
Dialogue: 0,0:06:02.66,0:06:03.33,Default,,0,0,0,,Токико-сан
Dialogue: 0,0:06:03.93,0:06:04.36,Default,,0,0,0,,О
Dialogue: 0,0:06:05.73,0:06:06.83,Default,,0,0,0,,Басқа тапсырма?
Dialogue: 0,0:06:07.46,0:06:08.40,Default,,0,0,0,,Сонымен кенеттен?
Dialogue: 0,0:06:09.66,0:06:13.80,Default,,0,0,0,,Күрсін, бірақ көмектесу мүмкін емес. Үлкен аға бәрінің жағында.
Dialogue: 0,0:06:15.13,0:06:16.26,Default,,0,0,0,,Махиро-чан
Dialogue: 0,0:06:17.20,0:06:19.46,Default,,0,0,0,,Бізде уақыт жоқ. Асығыңыз.
Dialogue: 0,0:06:20.53,0:06:21.06,Default,,0,0,0,,Махиро
Dialogue: 0,0:06:22.13,0:06:24.50,Default,,0,0,0,,Бұл жолы мен сәл ұзағырақ қоштасамын.
Dialogue: 0,0:06:26.63,0:06:27.93,Default,,0,0,0,,Мен міндетті түрде қайтамын
Dialogue: 0,0:06:29.03,0:06:29.80,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:06:31.53,0:06:31.96,Default,,0,0,0,,Иә
Dialogue: 0,0:06:33.20,0:06:35.33,Default,,0,0,0,,Ұзақ қоштасу?
Dialogue: 0,0:06:36.63,0:06:39.00,Default,,0,0,0,,Баршаңызға сәлем
Dialogue: 0,0:06:44.40,0:06:45.46,Default,,0,0,0,,Тікұшақ?
Dialogue: 0,0:06:45.93,0:06:48.20,Default,,0,0,0,,Mappy Енді ше?
Dialogue: 0,0:06:48.80,0:06:51.10,Default,,0,0,0,,Кадзуки мен Токико кездейсоқ па?
Dialogue: 0,0:06:51.56,0:06:52.16,Default,,0,0,0,,Иә
Dialogue: 0,0:06:53.90,0:06:58.53,Default,,0,0,0,,Иә, бұл жолы сәл ұзағырақ миссия болады.
Dialogue: 0,0:07:00.20,0:07:01.93,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:07:03.10,0:07:04.00,Default,,0,0,0,,Mappy
Dialogue: 0,0:07:04.56,0:07:05.33,Default,,0,0,0,,Махиро
Dialogue: 0,0:07:07.16,0:07:08.33,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:07:09.30,0:07:12.23,Default,,0,0,0,,Үлкен аға бәрінің жағында.
Dialogue: 0,0:07:13.10,0:07:17.20,Default,,0,0,0,,Бірақ егер мен Токиконы жылататын бірдеңе жасасам,
Dialogue: 0,0:07:17.53,0:07:19.96,Default,,0,0,0,,Сол кезде мен ашуланамын.
Dialogue: 0,0:07:22.46,0:07:23.00,Default,,0,0,0,,Казуки
Dialogue: 0,0:07:24.40,0:07:27.86,Default,,0,0,0,,Ұзақ қоштасу деген нені білдіреді?
Dialogue: 0,0:07:30.10,0:07:33.36,Default,,0,0,0,,Муто Оң жақ терезенің астына қараңыз
Dialogue: 0,0:07:51.16,0:07:54.86,Default,,0,0,0,,Жауынгер бастық ретінде менің сізге үйрететін ештеңем жоқ.
Dialogue: 0,0:07:56.06,0:07:59.63,Default,,0,0,0,,Мен бәрін сіздің таңдауыңызға қалдырдым.
Dialogue: 0,0:08:00.73,0:08:02.23,Default,,0,0,0,,Жауынгер Кадзуки
Dialogue: 0,0:08:06.83,0:08:09.16,Default,,0,0,0,,Ақ ядролық темір аяқталды
Dialogue: 0,0:08:10.06,0:08:13.76,Default,,0,0,0,,Қара өзек үтікпен қабаттасатындай етіп оны кеудеге итеріңіз
Dialogue: 0,0:08:14.26,0:08:18.20,Default,,0,0,0,,Осылайша қара ядролық темірдің күші жойылып, қуатсыз күйге айналды.
Dialogue: 0,0:08:19.23,0:08:21.73,Default,,0,0,0,,Сіз оны қалай қолдану керектігін шештіңіз бе? Муто мырза
Dialogue: 0,0:08:22.73,0:08:23.20,Default,,0,0,0,,Иә
Dialogue: 0,0:08:24.63,0:08:28.00,Default,,0,0,0,,Иә, қабылдаңыз.
Dialogue: 0,0:08:35.80,0:08:36.53,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:36.96,0:08:38.40,Default,,0,0,0,,Жақсы, енді мен дайынмын
Dialogue: 0,0:08:38.56,0:08:39.13,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:08:39.90,0:08:41.73,Default,,0,0,0,,Муто мырза
Dialogue: 0,0:08:43.46,0:08:47.83,Default,,0,0,0,,Мен сондай үлкен іске араластым.
Dialogue: 0,0:08:49.26,0:08:52.80,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:53.56,0:08:54.50,Default,,0,0,0,,-Ааааааааааааааааааааааааааааааааааааа -Мырза. Александрия
Dialogue: 0,0:08:55.30,0:08:56.76,Default,,0,0,0,,Ұяшықтардың шектері
Dialogue: 0,0:08:57.26,0:09:02.10,Default,,0,0,0,,Сіз оны клон деп қанша атасаңыз да, түпнұсқаның жасы 100-ден асқан.
Dialogue: 0,0:09:05.13,0:09:06.43,Default,,0,0,0,,Сіз өз ісіңізді аяқтадыңыз ба?
Dialogue: 0,0:09:07.23,0:09:08.60,Default,,0,0,0,,Қазір кет.
Dialogue: 0,0:09:08.90,0:09:09.33,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:09:09.96,0:09:12.60,Default,,0,0,0,,Сіз ұрыс алаңына жеткенше
Dialogue: 0,0:09:13.23,0:09:16.96,Default,,0,0,0,,Әлі біраз уақыт қалды.
Dialogue: 0,0:09:17.73,0:09:21.60,Default,,0,0,0,,Бұл туралы қайтадан ойланыңыз.
Dialogue: 0,0:09:26.90,0:09:27.40,Default,,0,0,0,,Ой
Dialogue: 0,0:09:30.26,0:09:31.00,Default,,0,0,0,,Ооо
Dialogue: 0,0:09:31.56,0:09:32.16,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:09:32.96,0:09:33.50,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:34.66,0:09:38.50,Default,,0,0,0,,Нууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:09:41.73,0:09:43.96,Default,,0,0,0,,Сіздің емдік күшіңізді кескілескен шайқаспен салыстыруға болады.
Dialogue: 0,0:09:44.96,0:09:48.70,Default,,0,0,0,,Дегенмен, тұтынылатын энергияның мөлшері әртүрлі.
Dialogue: 0,0:09:49.53,0:09:51.10,Default,,0,0,0,,Бұл энергия қайдан келеді?
Dialogue: 0,0:09:52.00,0:09:56.40,Default,,0,0,0,,Теңіз өмірінің барлық түрінен энергияны ағызу
Dialogue: 0,0:09:58.03,0:09:59.63,Default,,0,0,0,,Қазір осы жер бетінде
Dialogue: 0,0:10:00.43,0:10:03.23,Default,,0,0,0,,-Виктордың пайдалы энергиясы сарқылмас -Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:10:03.63,0:10:05.10,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:06.56,0:10:07.16,Default,,0,0,0,,Үлкен
Dialogue: 0,0:10:07.26,0:10:08.26,Default,,0,0,0,,Ұлы жауынгер қолбасшы
Dialogue: 0,0:10:08.50,0:10:09.30,Default,,0,0,0,,Бастер Барон
Dialogue: 0,0:10:09.83,0:10:10.76,Default,,0,0,0,,Жеңіл қару қосулы
Dialogue: 0,0:10:11.83,0:10:15.63,Default,,0,0,0,,Жапон қылышы брондалған алхимия Қылыш Самурай X
Dialogue: 0,0:10:16.13,0:10:16.60,Default,,0,0,0,,Га
Dialogue: 0,0:10:17.26,0:10:18.66,Default,,0,0,0,,Бастер Баронның құшағынан
Dialogue: 0,0:10:19.26,0:10:20.53,Default,,0,0,0,,Тағы бір Бусо Рекин
Dialogue: 0,0:10:21.10,0:10:22.43,Default,,0,0,0,,Таң қалмаңыз
Dialogue: 0,0:10:23.10,0:10:25.13,Default,,0,0,0,,Бұл Бастер Баронға тән қасиет.
Dialogue: 0,0:10:26.06,0:10:29.96,Default,,0,0,0,,Бастер Баронның қосалқы кабинасындағы жауынгер алхимиясы
Dialogue: 0,0:10:30.46,0:10:33.43,Default,,0,0,0,,Пішіннен бастап сипаттамаларға дейін барлығын қуаттандырыңыз
Dialogue: 0,0:10:34.96,0:10:39.83,Default,,0,0,0,,Бастапқыда мен оны қорғаушыға күміс тері жасау үшін пайдалануды жоспарладым.
Dialogue: 0,0:10:41.26,0:10:42.86,Default,,0,0,0,,Жақсы Бусо Рекин
Dialogue: 0,0:10:43.36,0:10:44.33,Default,,0,0,0,,Жауынгер Шусуи
Dialogue: 0,0:10:45.33,0:10:46.70,Default,,0,0,0,,Олар ұрыстан қашады деп ойлаймын, бірақ—
Dialogue: 0,0:10:48.13,0:10:51.86,Default,,0,0,0,,Барлық энергетикалық шабуылдар тұман сияқты таралады.
Dialogue: 0,0:10:52.80,0:10:54.40,Default,,0,0,0,,Жарайды, мен орнатамын.
Dialogue: 0,0:10:54.90,0:10:57.16,Default,,0,0,0,,Кеттік! Сіздің кезегіңіз.
Dialogue: 0,0:10:57.53,0:10:58.46,Default,,0,0,0,,Ой
Dialogue: 0,0:11:01.83,0:11:03.06,Default,,0,0,0,,Киллер сәулесінің моншақтары
Dialogue: 0,0:11:03.20,0:11:04.60,Default,,0,0,0,,Құпия жол
Dialogue: 0,0:11:04.70,0:11:05.76,Default,,0,0,0,,Көпіршікті тор
Dialogue: 0,0:11:05.93,0:11:06.50,Default,,0,0,0,,Қиян-кескі ұрыс
Dialogue: 0,0:11:07.00,0:11:08.86,Default,,0,0,0,,Ууууууу
Dialogue: 0,0:11:09.20,0:11:10.03,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:11:12.00,0:11:15.03,Default,,0,0,0,,Жеңдер, 5100 градус жалын
Dialogue: 0,0:11:15.66,0:11:18.03,Default,,0,0,0,,Даңқ жалыны
Dialogue: 0,0:11:20.03,0:11:25.63,Default,,0,0,0,,Увааааааааааааааааааааааааа
Dialogue: 0,0:11:31.46,0:11:33.33,Default,,0,0,0,,Түйіндерді қорғау жиынтығы
Dialogue: 0,0:11:36.16,0:11:38.93,Default,,0,0,0,,Алхимия жын, шаңға оралу
Dialogue: 0,0:11:39.10,0:11:39.63,Default,,0,0,0,,Гуа
Dialogue: 0,0:11:40.93,0:11:41.63,Default,,0,0,0,,…ол үстем болатынына сенді.
Dialogue: 0,0:11:51.70,0:11:54.96,Default,,0,0,0,,Бұл бәрінің соңы.
Dialogue: 0,0:11:55.90,0:11:56.33,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:56.56,0:11:57.20,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:11:57.36,0:11:58.76,Default,,0,0,0,,Бұл сенің соңың.
Dialogue: 0,0:12:04.36,0:12:06.63,Default,,0,0,0,,Виктор үшінші кезеңнің негізгі бөлігі?
Dialogue: 0,0:12:07.30,0:12:09.53,Default,,0,0,0,,Сонда алыптың денесі бұрын қандай болған?
Dialogue: 0,0:12:09.70,0:12:13.66,Default,,0,0,0,,Энергиясын пайдаланатын теңіз тіршілік иелерінің қалдықтарынан жасалған дене.
Dialogue: 0,0:12:14.10,0:12:16.26,Default,,0,0,0,,Greataxe алхимиясы
Dialogue: 0,0:12:16.66,0:12:17.76,Default,,0,0,0,,Жалпы эвакуация
Dialogue: 0,0:12:18.56,0:12:20.00,Default,,0,0,0,,Өлімге әкелетін тартымдылық
Dialogue: 0,0:12:20.53,0:12:22.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:30.70,0:12:32.13,Default,,0,0,0,,Мен жақындап қалдым
Dialogue: 0,0:12:32.40,0:12:35.20,Default,,0,0,0,,Кез келген уақытта әрекет етуге дайын болыңыз.
Dialogue: 0,0:12:35.70,0:12:36.13,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:36.83,0:12:37.93,Default,,0,0,0,,(Серо) «Өте жылдам адам» деген лақап ат тек сән үшін ғана емес қой?
Dialogue: 0,0:12:38.16,0:12:38.60,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:12:38.66,0:12:39.90,Default,,0,0,0,,Күтуден шаршадым.
Dialogue: 0,0:12:41.96,0:12:42.53,Default,,0,0,0,,Папиллон
Dialogue: 0,0:12:43.30,0:12:46.30,Default,,0,0,0,,Ей, мен ойланбастан мұны істей алдым, Муто.
Dialogue: 0,0:12:47.13,0:12:50.00,Default,,0,0,0,,Сіз тапсырыс берген екінің бірі
Dialogue: 0,0:12:57.43,0:12:58.63,Default,,0,0,0,,Рахмет Чоно
Dialogue: 0,0:12:59.26,0:13:01.46,Default,,0,0,0,,Біріншіден, қазір бәрі дайын.
Dialogue: 0,0:13:02.40,0:13:03.53,Default,,0,0,0,,Жоқ Казуки
Dialogue: 0,0:13:04.16,0:13:08.50,Default,,0,0,0,,Виктор екеуіңнің арасында басқа таңдау бар ма?
Dialogue: 0,0:13:09.43,0:13:11.56,Default,,0,0,0,,Менде жоқ, мен бір жасаймын.
Dialogue: 0,0:13:12.36,0:13:14.03,Default,,0,0,0,,Біріншіден, бұл ақ ядролық темір
Dialogue: 0,0:13:14.46,0:13:19.10,Default,,0,0,0,,Мұны Викторды қайтадан адамға айналдыру және оның еркі мен күшін бақылаудан шығаруды тоқтату үшін пайдаланыңыз.
Dialogue: 0,0:13:19.70,0:13:20.86,Default,,0,0,0,,Содан кейін сіз
Dialogue: 0,0:13:21.43,0:13:24.23,Default,,0,0,0,,Осы Муто бұйырды
Dialogue: 0,0:13:24.36,0:13:27.00,Default,,0,0,0,,Папиллон жасаған жаңа колба ойнайды
Dialogue: 0,0:13:28.10,0:13:33.93,Default,,0,0,0,,Бұл Мутоны тоқтатылған анимацияға енгізеді және Мутоның Викторға айналуын уақытша тоқтатады.
Dialogue: 0,0:13:34.83,0:13:35.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:35.93,0:13:36.40,Default,,0,0,0,,Ах
Dialogue: 0,0:13:37.36,0:13:41.83,Default,,0,0,0,,Осыдан кейін мен екінші ақ ядролық темірді аяқтадым.
Dialogue: 0,0:13:42.26,0:13:44.60,Default,,0,0,0,,Мутоны қайтадан адамға айналдыр
Dialogue: 0,0:13:45.33,0:13:47.73,Default,,0,0,0,,Міне, сол кезде шешім қабылданады
Dialogue: 0,0:13:48.90,0:13:50.73,Default,,0,0,0,,Уәдені ұмытпа
Dialogue: 0,0:13:51.30,0:13:52.33,Default,,0,0,0,,Ұмытпа
Dialogue: 0,0:13:53.06,0:13:54.40,Default,,0,0,0,,Мені ерте оятуыңызды өтінемін.
Dialogue: 0,0:13:55.83,0:13:56.30,Default,,0,0,0,,Гота
Dialogue: 0,0:13:57.13,0:13:59.66,Default,,0,0,0,,Токико-сан туралы сұраңыз
Dialogue: 0,0:14:01.83,0:14:02.26,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:14:04.50,0:14:07.76,Default,,0,0,0,,Мен сенен менің махаббатыммен қарсылас емес, жолдасым болуыңды сұраймын.
Dialogue: 0,0:14:08.60,0:14:10.40,Default,,0,0,0,,Үлкен істеріңізді маған қалдырыңыз.
Dialogue: 0,0:14:11.40,0:14:13.86,Default,,0,0,0,,Тыныштықпен күресіп, ұйықтай аласыз.
Dialogue: 0,0:14:14.10,0:14:15.70,Default,,0,0,0,,Және міндетті түрде оралыңыз
Dialogue: 0,0:14:16.06,0:14:16.66,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:14:18.80,0:14:19.23,Default,,0,0,0,,О
Dialogue: 0,0:14:22.00,0:14:22.73,Default,,0,0,0,,Токико-сан
Dialogue: 0,0:14:24.06,0:14:27.00,Default,,0,0,0,,Сәл ұзақ қоштасу
Dialogue: 0,0:14:28.16,0:14:30.36,Default,,0,0,0,,Бірақ бұл мәңгілік емес
Dialogue: 0,0:14:31.93,0:14:32.70,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:14:33.83,0:14:36.46,Default,,0,0,0,,Біріншіден, ақ ядролық темірдің атысы
Dialogue: 0,0:14:36.90,0:14:38.60,Default,,0,0,0,,Сәтті болуы керек
Dialogue: 0,0:14:40.36,0:14:42.70,Default,,0,0,0,,ешқашан мәңгілік емес
Dialogue: 0,0:14:43.76,0:14:47.26,Default,,0,0,0,,Казуки, сол соққы, мен де сенімен біргемін.
Dialogue: 0,0:14:47.90,0:14:51.73,Default,,0,0,0,,А, Виктор растау, мен бір минуттан кейін келемін.
Dialogue: 0,0:15:02.76,0:15:05.96,Default,,0,0,0,,Мен бұл операция үшін толық жауапкершілікті аламын.
Dialogue: 0,0:15:07.20,0:15:09.53,Default,,0,0,0,,Мен сені осы жерден тоқтатамын.
Dialogue: 0,0:15:10.23,0:15:12.50,Default,,0,0,0,,Мүмкіндігінше қашыңыз.
Dialogue: 0,0:15:12.93,0:15:13.46,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:13.53,0:15:14.13,Default,,0,0,0,,Ку га
Dialogue: 0,0:15:15.23,0:15:17.30,Default,,0,0,0,,Алхимияға қатысты барлығы
Dialogue: 0,0:15:18.10,0:15:19.96,Default,,0,0,0,,Осы жерден жерле
Dialogue: 0,0:15:20.86,0:15:22.06,Default,,0,0,0,,Алхимия
Dialogue: 0,0:15:22.83,0:15:24.70,Default,,0,0,0,,Ядролық темір және гомункул
Dialogue: 0,0:15:25.23,0:15:26.86,Default,,0,0,0,,Сондай-ақ Бусу Рекин
Dialogue: 0,0:15:27.60,0:15:29.16,Default,,0,0,0,,Мен сені ешқашан кешірмеймін
Dialogue: 0,0:15:30.33,0:15:32.76,Default,,0,0,0,,Хаха хаха
Dialogue: 0,0:15:33.90,0:15:38.96,Default,,0,0,0,,Ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха
Dialogue: 0,0:15:41.90,0:15:42.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:45.10,0:15:45.83,Default,,0,0,0,,болып табылады
Dialogue: 0,0:15:53.23,0:15:54.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:55.23,0:15:58.46,Default,,0,0,0,,Жас қыздың жауапкершілігін алып, оны құбыжыққа айналдыру.
Dialogue: 0,0:15:59.53,0:16:04.56,Default,,0,0,0,,Құбыжық болып кеткен әкеңді өлтіргісі келетін адамдарсың.
Dialogue: 0,0:16:07.36,0:16:12.00,Default,,0,0,0,,Сол уақыттан бері мен барлық алхимияны жоюға тырыстым, бірақ нәтиже болмады.
Dialogue: 0,0:16:13.06,0:16:15.06,Default,,0,0,0,,Енді, жүз жылдан кейін мен оянсам,
Dialogue: 0,0:16:16.33,0:16:19.63,Default,,0,0,0,,Сіз мен жасаған қателікті қайталап отырсыз.
Dialogue: 0,0:16:20.76,0:16:21.96,Default,,0,0,0,,Ол жоқ
Dialogue: 0,0:16:22.46,0:16:23.50,Default,,0,0,0,,Ол кездейсоқ болды
Dialogue: 0,0:16:24.13,0:16:25.50,Default,,0,0,0,,Бұл балаға не болды?
Dialogue: 0,0:16:26.53,0:16:30.36,Default,,0,0,0,,Мүмкін ол да мен сияқты сені өлтірмекші болған шығар.
Dialogue: 0,0:16:31.43,0:16:33.40,Default,,0,0,0,,Қайта өлтіру сіз үшін сөзсіз
Dialogue: 0,0:16:34.96,0:16:37.63,Default,,0,0,0,,Мен ашуландым. Менде ашудан басқа ештеңе жоқ.
Dialogue: 0,0:16:38.53,0:16:40.30,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,0:16:40.86,0:16:42.60,Default,,0,0,0,,Хмм, жаңадан келген адам?
Dialogue: 0,0:16:49.80,0:16:50.93,Default,,0,0,0,,Босатпаңыз
Dialogue: 0,0:16:51.60,0:16:52.40,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:16:53.20,0:16:54.10,Default,,0,0,0,,Сіз үнемі осылай айтасыз.
Dialogue: 0,0:16:55.46,0:16:56.50,Default,,0,0,0,,Сіз және мен
Dialogue: 0,0:16:59.06,0:17:00.23,Default,,0,0,0,,Бірлік
Dialogue: 0,0:17:02.60,0:17:03.16,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:17:03.76,0:17:04.93,Default,,0,0,0,,Өлімге жақын бақыт
Dialogue: 0,0:17:07.40,0:17:08.40,Default,,0,0,0,,Мазасыз, құтылыңыз.
Dialogue: 0,0:17:08.60,0:17:09.53,Default,,0,0,0,,Қозғалтқыш беріліс
Dialogue: 0,0:17:11.50,0:17:14.53,Default,,0,0,0,,Біздің брондалған алхимиямызға еніңіз
Dialogue: 0,0:17:16.76,0:17:17.56,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:17:17.86,0:17:19.03,Default,,0,0,0,,Уф хаа
Dialogue: 0,0:17:26.16,0:17:27.10,Default,,0,0,0,,Энергия
Dialogue: 0,0:17:28.06,0:17:29.10,Default,,0,0,0,,Шығарылым
Dialogue: 0,0:17:29.30,0:17:30.10,Default,,0,0,0,,Аххххх
Dialogue: 0,0:17:30.20,0:17:31.70,Default,,0,0,0,,-Ааааааааааааааааааааааааааааааааааааааааааа -Виктор өзінің бастапқы түріне қайтады
Dialogue: 0,0:17:32.43,0:17:33.50,Default,,0,0,0,,-Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:17:35.23,0:17:35.66,Default,,0,0,0,,Ах
Dialogue: 0,0:17:36.30,0:17:36.86,Default,,0,0,0,,Құт
Dialogue: 0,0:17:40.06,0:17:41.16,Default,,0,0,0,,Сәтсіздік
Dialogue: 0,0:17:41.40,0:17:41.93,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:42.23,0:17:44.36,Default,,0,0,0,,Ха ха
Dialogue: 0,0:17:44.96,0:17:46.73,Default,,0,0,0,,Тері бастапқы мыс түсіне оралады
Dialogue: 0,0:17:47.10,0:17:49.50,Default,,0,0,0,,Ақ ядролық темір тиімді.
Dialogue: 0,0:17:52.90,0:17:56.86,Default,,0,0,0,,Үшінші кезеңге өткен қара ядролық темірімді қалай өтеуге болады
Dialogue: 0,0:17:57.63,0:17:59.20,Default,,0,0,0,,Шығарылым жеткіліксіз болған сияқты.
Dialogue: 0,0:18:00.70,0:18:01.43,Default,,0,0,0,,(Айзава) Егер ол тағы да солай болса, мен дереу тоқтатып, Мидорияны шетке шығарамын
Dialogue: 0,0:18:02.40,0:18:04.56,Default,,0,0,0,,Сені мен сияқты топ қуды.
Dialogue: 0,0:18:04.76,0:18:06.93,Default,,0,0,0,,Оны жақын адам өлтірген болуы керек.
Dialogue: 0,0:18:08.06,0:18:11.86,Default,,0,0,0,,Оның үстіне менімен төбелескіңіз келсе, бұл да жақсы.
Dialogue: 0,0:18:12.93,0:18:14.83,Default,,0,0,0,,Мен келемін, Казуки, қолымды жіберме.
Dialogue: 0,0:18:15.83,0:18:17.46,Default,,0,0,0,,Сен екеуміз бір адамбыз.
Dialogue: 0,0:18:18.06,0:18:20.60,Default,,0,0,0,,When you die, it's time I die.
Dialogue: 0,0:18:23.13,0:18:23.63,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:24.00,0:18:24.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:25.50,0:18:27.10,Default,,0,0,0,,Кешіріңіз, Токико-сан.
Dialogue: 0,0:18:27.93,0:18:30.40,Default,,0,0,0,,Мен бұл уәдені орындай алмаймын.
Dialogue: 0,0:18:39.80,0:18:42.40,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:46.36,0:18:48.03,Default,,0,0,0,,Казуки
Dialogue: 0,0:18:48.26,0:18:49.46,Default,,0,0,0,,Муто
Dialogue: 0,0:18:49.53,0:18:52.03,Default,,0,0,0,,Кадзуки Муто
Dialogue: 0,0:18:52.86,0:18:55.43,Default,,0,0,0,,Увааааааааааааааааааааааааааа
Dialogue: 0,0:18:55.90,0:18:58.60,Default,,0,0,0,,Энергияның толық дроссельі
Dialogue: 0,0:19:00.93,0:19:02.93,Default,,0,0,0,,Сәлем Виктория
Dialogue: 0,0:19:03.93,0:19:05.50,Default,,0,0,0,,Сәлем анашым
Dialogue: 0,0:19:06.40,0:19:10.40,Default,,0,0,0,,Әкеңді көрсең, айт.
Dialogue: 0,0:19:11.86,0:19:17.56,Default,,0,0,0,,Анам әкемді мәңгі жақсы көретінін айтты.
Dialogue: 0,0:19:19.40,0:19:23.20,Default,,0,0,0,,Иә, егер анам әкемді кездестірсе.
Dialogue: 0,0:19:24.10,0:19:25.60,Default,,0,0,0,,Tell me then
Dialogue: 0,0:19:27.56,0:19:31.46,Default,,0,0,0,,Мен жалғыз өмір сүре аламын
Dialogue: 0,0:19:50.76,0:19:51.40,Default,,0,0,0,,Казуки
Dialogue: 0,0:19:52.23,0:19:53.13,Default,,0,0,0,,Кадзуки-кун
Dialogue: 0,0:19:53.36,0:19:54.30,Default,,0,0,0,,Kazukin
Dialogue: 0,0:19:54.83,0:19:55.73,Default,,0,0,0,,Сол адам
Dialogue: 0,0:19:56.30,0:19:57.06,Default,,0,0,0,,Ә? Мүмкін емес! Не болып жатыр?!
Dialogue: 0,0:19:57.56,0:19:58.30,Default,,0,0,0,,Сол жігіт
Dialogue: 0,0:19:58.70,0:19:59.86,Default,,0,0,0,,Kazuki Muto
Dialogue: 0,0:20:00.40,0:20:01.20,Default,,0,0,0,,Тәтті бала
Dialogue: 0,0:20:01.73,0:20:02.66,Default,,0,0,0,,Муто мырза
Dialogue: 0,0:20:03.06,0:20:04.33,Default,,0,0,0,,Жауынгер Муто
Dialogue: 0,0:20:04.80,0:20:06.03,Default,,0,0,0,,Кадзуки Муто
Dialogue: 0,0:20:06.53,0:20:07.23,Default,,0,0,0,,Muto
Dialogue: 0,0:20:07.93,0:20:08.80,Default,,0,0,0,,Муто мырза
Dialogue: 0,0:20:09.33,0:20:10.13,Default,,0,0,0,,Kazuki-kun
Dialogue: 0,0:20:10.66,0:20:11.26,Default,,0,0,0,,Казуки
Dialogue: 0,0:20:11.96,0:20:12.63,Default,,0,0,0,,Кадзуки
Dialogue: 0,0:20:13.20,0:20:14.33,Default,,0,0,0,,Muto Senpai
Dialogue: 0,0:20:14.80,0:20:16.03,Default,,0,0,0,,Kazuki Senpai
Dialogue: 0,0:20:22.50,0:20:23.63,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:20:24.53,0:20:33.13,Default,,0,0,0,,Ха ха ха ха ха ха ха ха ха ха ха ха ха
Dialogue: 0,0:20:33.20,0:20:34.93,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:20:35.26,0:20:35.93,Default,,0,0,0,,Мен бұл туралы ойладым.
Dialogue: 0,0:20:36.16,0:20:37.00,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:20:37.10,0:20:38.70,Default,,0,0,0,,Айдың жансыз әлемінде
Dialogue: 0,0:20:39.76,0:20:42.13,Default,,0,0,0,,Энергияны ағызу мүлдем мағынасы жоқ
Dialogue: 0,0:20:43.43,0:20:45.70,Default,,0,0,0,,Бір-бірінің қабілетінің таза бәсекесі
Dialogue: 0,0:20:46.60,0:20:49.33,Default,,0,0,0,,Бірақ жеңіңіз немесе жеңіліңіз
Dialogue: 0,0:20:50.40,0:20:52.70,Default,,0,0,0,,Үйге тірі орала алмайсың.
Dialogue: 0,0:20:53.53,0:20:56.36,Default,,0,0,0,,күрсіну
Dialogue: 0,0:20:56.96,0:20:58.20,Default,,0,0,0,,Ол оны шынымен лақтыруға ниетті
Dialogue: 0,0:20:59.16,0:21:00.23,Default,,0,0,0,,Ол қайдан пайда болды?
Dialogue: 0,0:21:01.10,0:21:01.66,Default,,0,0,0,,Әрине
Dialogue: 0,0:21:05.06,0:21:05.96,Default,,0,0,0,,Сол жұлдыздан
Dialogue: 0,0:21:09.83,0:21:14.40,Default,,0,0,0,,Бұл жерде мен қорғағым келетін көптеген адамдар бар.
Dialogue: 0,0:21:16.70,0:21:19.90,Default,,0,0,0,,Мен қатты қорғағым келетін адам бар.
Dialogue: 0,0:21:23.80,0:21:24.46,Default,,0,0,0,,Сол күннен бастап
Dialogue: 0,0:21:26.80,0:21:30.33,Default,,0,0,0,,Сол күннен бүгінге дейін қаншама оқиғалар болды.
Dialogue: 0,0:21:32.33,0:21:33.56,Default,,0,0,0,,Қазір
Dialogue: 0,0:21:34.60,0:21:36.60,Default,,0,0,0,,Мен тек көңілді болған нәрселерді есімде сақтаймын.
Dialogue: 0,0:21:46.90,0:21:49.63,Default,,0,0,0,,Fufu Kazuki
Dialogue: 0,0:21:50.10,0:21:54.40,Default,,0,0,0,,Фу Казуки Кадзуки Казуки
Dialogue: 0,0:21:54.73,0:21:56.13,Default,,0,0,0,,Ха Казуки
Dialogue: 0,0:21:56.73,0:21:59.76,Default,,0,0,0,,Идиот, мен сені кешірмеймін, Муто.
Dialogue: 0,0:22:00.10,0:22:02.70,Default,,0,0,0,,Сіз ағаңызды жылатуға қалай батылыңыз бар?
Dialogue: 0,0:22:03.00,0:22:06.33,Default,,0,0,0,,Осымен, осымен, менің атым
Dialogue: 0,0:22:06.86,0:22:11.30,Default,,0,0,0,,Сенің атыңды айтатын ешкім қалмады
Dialogue: 0,0:22:11.96,0:22:15.36,Default,,0,0,0,,Фуфу Казуки
Dialogue: 0,0:22:18.03,0:22:22.86,Default,,0,0,0,,Тереңдеген, тәтті әлемге
Dialogue: 0,0:22:22.96,0:22:29.56,Default,,0,0,0,,Енді ұшайық, қанатымызды жайайық
Dialogue: 0,0:22:40.26,0:22:49.43,Default,,0,0,0,,Қара аспан, ойылған күміс ай
Dialogue: 0,0:22:50.80,0:23:00.36,Default,,0,0,0,,Үздіктердің назарында
Dialogue: 0,0:23:00.96,0:23:09.13,Default,,0,0,0,,Дыбыссыз жорғалайтын сол қорқынышты түс
Dialogue: 0,0:23:09.30,0:23:17.06,Default,,0,0,0,,Маскамен жасырылған
Dialogue: 0,0:23:18.00,0:23:22.73,Default,,0,0,0,,Қалағаныңызша жоғары ұшыңыз
Dialogue: 0,0:23:22.96,0:23:28.30,Default,,0,0,0,,Осы әдемі қауырсындарым болса
Dialogue: 0,0:23:28.63,0:23:33.46,Default,,0,0,0,,Жарқыраған, жарқыраған дүние
Dialogue: 0,0:23:33.56,0:23:38.56,Default,,0,0,0,,Барлығы менің қолымда
Dialogue: 0,0:23:48.16,0:23:50.76,Default,,0,0,0,,Бұл планетаның жерінде не бар?
Dialogue: 0,0:23:51.46,0:23:53.93,Default,,0,0,0,,Сіз кеткен бұл планетада
Dialogue: 0,0:23:54.90,0:23:58.83,Default,,0,0,0,,Десе де, бұл планета сіз қорғаған әлем.
Dialogue: 0,0:23:59.76,0:24:01.70,Default,,0,0,0,,Келесі жолы «Ешқандай алмастырушы жоқ»
Dialogue: 0,0:24:03.20,0:24:09.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory