Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.12,0:00:05.38,Default,,0,0,0,,Бейблейд!
Dialogue: 0,0:00:07.00,0:00:09.55,Default,,0,0,0,,Бұл баланың арманы
Dialogue: 0,0:00:09.75,0:00:14.63,Default,,0,0,0,,Дүние жүзінің түкпір-түкпірінен келген пышақшылар шыңға жету үшін жарысады және бір-біріне қарсы жанын салады.
Dialogue: 0,0:00:15.47,0:00:20.47,Default,,0,0,0,,Айналсын, жарылып, жарылсын!
Dialogue: 0,0:00:20.56,0:00:24.10,Default,,0,0,0,,Даңқты жеңіске қол жеткізіңіз!
Dialogue: 0,0:00:24.69,0:00:27.81,Default,,0,0,0,,Шайқастан кейін оны міндетті түрде табасыз.
Dialogue: 0,0:00:27.90,0:00:30.19,Default,,0,0,0,,Жарқын болашақ!
Dialogue: 0,0:00:33.78,0:00:35.53,Default,,0,0,0,,Балта ату!
Dialogue: 0,0:00:35.66,0:00:38.41,Default,,0,0,0,,Мен саған қорқынышты түс көремін
Dialogue: 0,0:00:42.79,0:00:45.58,Default,,0,0,0,,Луи мен Қызыл Көз арасындағы жеке жекпе-жек
Dialogue: 0,0:00:45.67,0:00:48.67,Default,,0,0,0,,Бұл шайқаста Луи жеңді және...
Dialogue: 0,0:00:50.46,0:00:51.88,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:00:52.59,0:00:54.51,Default,,0,0,0,,Менің көз алдымнан кет!
Dialogue: 0,0:00:56.30,0:00:57.30,Default,,0,0,0,,Шу?
Dialogue: 0,0:00:57.84,0:01:01.77,Default,,0,0,0,,Мен Луиді Шудың пайдасына шайқасқа шақырдым.
Dialogue: 0,0:01:03.43,0:01:05.02,Default,,0,0,0,,Бірақ мен жеңілдім
Dialogue: 0,0:01:05.39,0:01:09.36,Default,,0,0,0,,Луи Жапонияда болған кезден де күштірек болды.
Dialogue: 0,0:01:10.19,0:01:12.86,Default,,0,0,0,,Жоғалту орнының мәні жоқ.
Dialogue: 0,0:01:13.40,0:01:15.49,Default,,0,0,0,,Аңызға айналған Спригганды лақтырыңыз
Dialogue: 0,0:01:19.91,0:01:22.45,Default,,0,0,0,,Реквием жобасын бастау
Dialogue: 0,0:01:33.13,0:01:34.92,Default,,0,0,0,,Менің атым Спригган
Dialogue: 0,0:01:35.92,0:01:37.47,Default,,0,0,0,,Спригган?
Dialogue: 0,0:01:38.64,0:01:41.72,Default,,0,0,0,,Сіз шешесіз.
Dialogue: 0,0:01:53.15,0:01:55.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:55.44,0:01:59.78,Default,,0,0,0,,Уф! Ай!
Dialogue: 0,0:02:01.41,0:02:04.20,Default,,0,0,0,,♪~
Dialogue: 0,0:02:04.29,0:02:06.75,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:06.83,0:02:09.29,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:09.37,0:02:11.75,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:11.84,0:02:14.13,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:14.21,0:02:15.88,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:02:15.96,0:02:20.18,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:21.09,0:02:25.85,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:25.93,0:02:30.81,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:30.90,0:02:35.69,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:35.78,0:02:40.70,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:40.78,0:02:45.66,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:45.74,0:02:50.71,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:50.79,0:02:54.13,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:54.21,0:02:55.71,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:55.80,0:02:58.26,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:58.34,0:03:00.55,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:03:00.63,0:03:02.93,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:03:03.01,0:03:04.26,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:03:04.35,0:03:05.85,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:03:05.93,0:03:08.35,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:03:08.43,0:03:14.61,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:03:14.69,0:03:18.99,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:03:19.07,0:03:21.86,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:21.95,0:03:24.20,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:24.28,0:03:26.74,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:26.83,0:03:30.08,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:32.17,0:03:35.42,Default,,0,0,0,,Кеттік! Құдай Бладерс Кубогы!
Dialogue: 0,0:03:37.42,0:03:40.34,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:40.42,0:03:41.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:43.68,0:03:45.80,Default,,0,0,0,,Бос Де Ла Хойя, солай ма?
Dialogue: 0,0:03:46.22,0:03:49.31,Default,,0,0,0,,Уау, арқамда көз бар сияқты
Dialogue: 0,0:03:49.68,0:03:51.64,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:03:55.81,0:03:58.78,Default,,0,0,0,,Қызыл көз деген жігітті жеңгеніңді естідім.
Dialogue: 0,0:04:02.28,0:04:03.24,Default,,0,0,0,,Иә
Dialogue: 0,0:04:03.74,0:04:07.24,Default,,0,0,0,,Хахахахаха Бұл соншалықты үлкен мәміле емес еді.
Dialogue: 0,0:04:07.62,0:04:11.37,Default,,0,0,0,,Хмм, мен аздап күшейіп кеттім.
Dialogue: 0,0:04:11.87,0:04:14.71,Default,,0,0,0,,Хмф, сіз ше?
Dialogue: 0,0:04:15.25,0:04:16.79,Default,,0,0,0,,Оны көргенде білесің
Dialogue: 0,0:04:17.59,0:04:18.96,Default,,0,0,0,,Өйткені бұл таңқаларлық
Dialogue: 0,0:04:22.17,0:04:24.80,Default,,0,0,0,,Сіз бұл алдыңғы турнирден ерекше деп айтасыз ба?
Dialogue: 0,0:04:25.26,0:04:28.81,Default,,0,0,0,,Бұл өте қызық болды.
Dialogue: 0,0:04:32.18,0:04:33.35,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:04:33.77,0:04:37.06,Default,,0,0,0,,Көңілді ме? Мен түсінбедім.
Dialogue: 0,0:04:37.48,0:04:39.11,Default,,0,0,0,,Білмесеңіз жақсы
Dialogue: 0,0:04:40.40,0:04:43.11,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:43.65,0:04:45.95,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:52.45,0:04:55.87,Default,,0,0,0,,Бұл әлі де баяу шабуыл, Фафнир.
Dialogue: 0,0:04:55.96,0:04:58.21,Default,,0,0,0,,Лонгинустан қашып құтыла алмайсың.
Dialogue: 0,0:05:06.26,0:05:08.68,Default,,0,0,0,,Go Nightmare Longinus
Dialogue: 0,0:05:08.76,0:05:10.72,Default,,0,0,0,,Металл айдаһардың қақтығысы!
Dialogue: 0,0:05:16.56,0:05:18.77,Default,,0,0,0,,Рас, сен күшейдің.
Dialogue: 0,0:05:19.36,0:05:21.48,Default,,0,0,0,,Олай болса, Кибаға да барайық.
Dialogue: 0,0:05:26.53,0:05:27.99,Default,,0,0,0,,(үру)
Dialogue: 0,0:05:29.07,0:05:30.53,Default,,0,0,0,,Келесімен аяқтаңыз
Dialogue: 0,0:05:44.26,0:05:45.47,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:05:46.63,0:05:48.72,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:05:51.39,0:05:52.35,Default,,0,0,0,,Tsk
Dialogue: 0,0:05:52.81,0:05:55.10,Default,,0,0,0,,Ғажайып металл айдаһар
Dialogue: 0,0:05:55.93,0:05:56.85,Default,,0,0,0,,Хун
Dialogue: 0,0:05:58.94,0:06:00.40,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:06:00.48,0:06:01.61,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:06:01.69,0:06:02.69,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:06:03.90,0:06:07.15,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:07.78,0:06:10.32,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:06:16.75,0:06:18.79,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:21.54,0:06:22.67,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:06:27.22,0:06:31.59,Default,,0,0,0,,Бұл мүлдем аяқталмайды. Мүмкін біз күткеннен де жақсы араласатын шығармыз.
Dialogue: 0,0:06:32.89,0:06:36.31,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:36.64,0:06:38.85,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:45.78,0:06:47.57,Default,,0,0,0,,Аники Сіз білмейсіз бе?
Dialogue: 0,0:06:47.65,0:06:50.49,Default,,0,0,0,,Иә? Сіз жаттығу жасап жатқан жоқсыз ба?
Dialogue: 0,0:06:50.57,0:06:52.74,Default,,0,0,0,,Еш жерде емес.
Dialogue: 0,0:06:52.82,0:06:54.83,Default,,0,0,0,,Кумичодан сұраңыз.
Dialogue: 0,0:06:55.37,0:06:59.00,Default,,0,0,0,,Бұл жерде емес пе? Тегіннен алған жерім
Dialogue: 0,0:06:59.62,0:07:01.54,Default,,0,0,0,,Ол тіпті жоқ еді.
Dialogue: 0,0:07:01.62,0:07:03.29,Default,,0,0,0,,Сіз тамақ жемейсіз бе?
Dialogue: 0,0:07:03.38,0:07:05.00,Default,,0,0,0,,Андж оны да көрмеді.
Dialogue: 0,0:07:05.34,0:07:07.05,Default,,0,0,0,,Ол, о, мен оны көріп тұрмын.
Dialogue: 0,0:07:07.13,0:07:09.42,Default,,0,0,0,,Шұңқыр болса, қатты қисайды.
Dialogue: 0,0:07:09.72,0:07:10.72,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:07:11.01,0:07:12.72,Default,,0,0,0,,Эй, мен уайымдап тұрмын.
Dialogue: 0,0:07:13.43,0:07:16.76,Default,,0,0,0,,Аники: Мен Канададан келгеннен бері...
Dialogue: 0,0:07:17.35,0:07:21.19,Default,,0,0,0,,Ах... неге...
Dialogue: 0,0:07:21.73,0:07:23.60,Default,,0,0,0,,Бұл зомби сияқты...
Dialogue: 0,0:07:23.69,0:07:25.06,Default,,0,0,0,,(Рем) Бірдеңе болды ма, мырза? Өзіңізді жаман сезінесіз бе?
Dialogue: 0,0:07:25.31,0:07:27.53,Default,,0,0,0,,Мен оны көрмегеніме сенімдімін.
Dialogue: 0,0:07:28.19,0:07:30.36,Default,,0,0,0,,Ол тамақты көп жемейтін сияқты.
Dialogue: 0,0:07:33.57,0:07:36.03,Default,,0,0,0,,Балтоға әлі көп жол бар
Dialogue: 0,0:07:36.66,0:07:38.70,Default,,0,0,0,,Атаң үшін уайымдамайсың ба?
Dialogue: 0,0:07:38.79,0:07:42.17,Default,,0,0,0,,Егер сіз Blader ретінде шыңға ұмтылғыңыз келсе
Dialogue: 0,0:07:42.25,0:07:45.92,Default,,0,0,0,,Жеңетін де, жеңілетін де бәсеке әлемі бар.
Dialogue: 0,0:07:46.50,0:07:49.71,Default,,0,0,0,,Дұрыс, әлем чемпионаттары, т.б.
Dialogue: 0,0:07:50.05,0:07:51.80,Default,,0,0,0,,Иә, сонымен қатар...
Dialogue: 0,0:07:51.88,0:07:55.51,Default,,0,0,0,,Бұрын осында болған фрилансер осылай айтатын емес пе?
Dialogue: 0,0:07:55.76,0:07:58.22,Default,,0,0,0,,Жарыс қызықты, өйткені сіз жеңесіз.
Dialogue: 0,0:07:58.60,0:08:01.56,Default,,0,0,0,,Мен әрқашан жеңемін, Мен әрқашан көңілдімін
Dialogue: 0,0:08:02.81,0:08:08.44,Default,,0,0,0,,Менің ойымша, бұл да бәсекелестік әлемінің ақиқаты.
Dialogue: 0,0:08:10.74,0:08:15.24,Default,,0,0,0,,Жеңіске жетуді жалғастыру үшін бұрын не маңызды деп ойлағаныңызды ескеру қажет.
Dialogue: 0,0:08:15.57,0:08:19.12,Default,,0,0,0,,Кейде заттарды тастауға тура келеді, ал...
Dialogue: 0,0:08:20.12,0:08:25.75,Default,,0,0,0,,Сенген жолға түсу үшін мейірімсіз болуды таңдау.
Dialogue: 0,0:08:27.59,0:08:30.71,Default,,0,0,0,,Барто ақыры бәсеке әлеміне енді.
Dialogue: 0,0:08:30.80,0:08:32.51,Default,,0,0,0,,Мүмкін мен тигізген шығармын.
Dialogue: 0,0:08:33.55,0:08:37.35,Default,,0,0,0,,Мұның оған қалай әсер ететінін көру қызықты болады.
Dialogue: 0,0:08:37.68,0:08:39.06,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:08:39.14,0:08:40.77,Default,,0,0,0,,Бұл қиын, ата.
Dialogue: 0,0:08:41.02,0:08:43.43,Default,,0,0,0,,Жарайды, есейгенде түсінерсің.
Dialogue: 0,0:08:43.89,0:08:46.35,Default,,0,0,0,,Мен Балтоның болашағын асыға күтемін.
Dialogue: 0,0:08:46.73,0:08:49.36,Default,,0,0,0,,Балто бірдеңені лақтырып жатыр ма?
Dialogue: 0,0:08:50.11,0:08:52.11,Default,,0,0,0,,Бұл Бартқа байланысты.
Dialogue: 0,0:08:55.28,0:08:57.03,Default,,0,0,0,,Менің көз алдымнан кет!
Dialogue: 0,0:09:01.95,0:09:03.16,Default,,0,0,0,,Ах
Dialogue: 0,0:09:12.76,0:09:15.59,Default,,0,0,0,,Сіз қызықсыз.
Dialogue: 0,0:09:16.97,0:09:19.55,Default,,0,0,0,,Жарайды, пайдалана алмасаң, бітті.
Dialogue: 0,0:09:20.14,0:09:22.27,Default,,0,0,0,,Мен Шуды түсінбеймін.
Dialogue: 0,0:09:23.02,0:09:24.73,Default,,0,0,0,,Маған білу керек пе?
Dialogue: 0,0:09:25.27,0:09:26.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.73,0:09:29.40,Default,,0,0,0,,Маған ешкімнің не ойлайтыны маңызды емес.
Dialogue: 0,0:09:29.65,0:09:31.65,Default,,0,0,0,,Мен тек жеңіс туралы ойлаймын
Dialogue: 0,0:09:33.61,0:09:34.53,Default,,0,0,0,,Неапольдың ең үздік жиһаз шебері Марионың ұлы болып дүниеге келген
Dialogue: 0,0:09:35.57,0:09:36.53,Default,,0,0,0,,Жеңіс пе?
Dialogue: 0,0:09:37.70,0:09:40.03,Default,,0,0,0,,Мен саған қорқынышты түс көремін
Dialogue: 0,0:09:40.70,0:09:43.41,Default,,0,0,0,,Металл айдаһардың қақтығысы!
Dialogue: 0,0:09:51.63,0:09:52.67,Default,,0,0,0,,Жеңіс!
Dialogue: 0,0:09:55.59,0:09:56.92,Default,,0,0,0,,Сіз Балто бар дейсіз бе?
Dialogue: 0,0:09:57.68,0:09:59.59,Default,,0,0,0,,Маған бірдеңе дұрыс емес.
Dialogue: 0,0:09:59.68,0:10:01.01,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:10:01.10,0:10:03.14,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:09.23,0:10:12.15,Default,,0,0,0,,Әлі жоқ! Бұл күштірек шабуыл.
Dialogue: 0,0:10:12.61,0:10:13.61,Default,,0,0,0,,Жүр!
Dialogue: 0,0:10:14.03,0:10:15.36,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:10:15.74,0:10:19.07,Default,,0,0,0,,Бұл байланған қабатты таратуға арналған шұңқыр.
Dialogue: 0,0:10:19.70,0:10:22.41,Default,,0,0,0,,Егер байланысқан қабат бұрынғыдан да кеңейсе
Dialogue: 0,0:10:22.58,0:10:25.08,Default,,0,0,0,,Қайтарылған қозғалыс одан әрі жылдамдады.
Dialogue: 0,0:10:25.33,0:10:27.87,Default,,0,0,0,,Қарсыласқа келтірілген зиян күштірек болады.
Dialogue: 0,0:10:30.08,0:10:30.96,Default,,0,0,0,,Кук
Dialogue: 0,0:10:32.00,0:10:33.17,Default,,0,0,0,,Балто!
Dialogue: 0,0:10:33.75,0:10:35.17,Default,,0,0,0,,Оның ұшып кетуіне жол бермеңіз
Dialogue: 0,0:10:35.46,0:10:36.67,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:10:37.09,0:10:39.43,Default,,0,0,0,,Мен жоғалтқым келмейді
Dialogue: 0,0:10:39.84,0:10:43.05,Default,,0,0,0,,Шуға да, Луиге де, ешкімге де емес!
Dialogue: 0,0:10:43.39,0:10:44.60,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:10:45.72,0:10:46.81,Default,,0,0,0,,Барт…
Dialogue: 0,0:10:47.64,0:10:48.68,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:10:48.81,0:10:50.06,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:10:50.14,0:10:51.52,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:10:51.73,0:10:54.32,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:10:54.90,0:10:57.36,Default,,0,0,0,,Кеттік, Шу Руи!
Dialogue: 0,0:10:59.15,0:11:00.36,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:11:11.00,0:11:13.42,Default,,0,0,0,,Не болды? Маған берші, Кумичо.
Dialogue: 0,0:11:15.84,0:11:17.17,Default,,0,0,0,,Кумичо!
Dialogue: 0,0:11:17.30,0:11:18.92,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:11:19.09,0:11:20.59,Default,,0,0,0,,Мен жаттығып жатырмын.
Dialogue: 0,0:11:20.88,0:11:23.05,Default,,0,0,0,,Бұл жаттығуға мүлдем ұқсамады.
Dialogue: 0,0:11:23.14,0:11:25.68,Default,,0,0,0,,Асықсаң да жұмыс істемейді.
Dialogue: 0,0:11:25.76,0:11:26.93,Default,,0,0,0,,Асықпа
Dialogue: 0,0:11:27.35,0:11:28.47,Default,,0,0,0,,Сіз асығыссыз ба?
Dialogue: 0,0:11:28.56,0:11:30.18,Default,,0,0,0,,Асықпа!
Dialogue: 0,0:11:30.27,0:11:33.69,Default,,0,0,0,,Мен Шу мен Луиді жеңу қалай болатынын түсінемін, бірақ қазіргі ұсыныспен...
Dialogue: 0,0:11:33.85,0:11:34.94,Default,,0,0,0,,Жеңіс!
Dialogue: 0,0:11:35.19,0:11:38.19,Default,,0,0,0,,Мен Шумен тағы да лайықты айқасқым келеді.
Dialogue: 0,0:11:38.48,0:11:40.40,Default,,0,0,0,,Шу – әлсіз адам...
Dialogue: 0,0:11:40.61,0:11:42.57,Default,,0,0,0,,Мен жеңілгендерді жек көремін
Dialogue: 0,0:11:42.78,0:11:45.03,Default,,0,0,0,,Сондықтан біз жеңуіміз керек
Dialogue: 0,0:11:45.91,0:11:46.95,Default,,0,0,0,,Үлкен аға Геко!
Dialogue: 0,0:11:47.33,0:11:50.45,Default,,0,0,0,,Мүмкін Зоро айтқандай шығар.
Dialogue: 0,0:11:51.91,0:11:53.42,Default,,0,0,0,,Кумичо, шық!
Dialogue: 0,0:11:54.17,0:11:55.50,Default,,0,0,0,,Не деген сұмдық!
Dialogue: 0,0:11:55.58,0:11:56.84,Default,,0,0,0,,Бұл кедергі!
Dialogue: 0,0:11:56.92,0:11:59.76,Default,,0,0,0,,Қарғыс атсын! Мен уайымдап тұрмын, бәрі.
Dialogue: 0,0:12:00.09,0:12:02.59,Default,,0,0,0,,Олай болса барлығыңыз шығыңыздар.
Dialogue: 0,0:12:02.84,0:12:03.76,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:04.18,0:12:05.34,Default,,0,0,0,,Барт?
Dialogue: 0,0:12:05.43,0:12:07.05,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:07.14,0:12:08.06,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:12:08.43,0:12:09.72,Default,,0,0,0,,Не? антон
Dialogue: 0,0:12:10.10,0:12:12.02,Default,,0,0,0,,Крис маған жиналуымды өтінді.
Dialogue: 0,0:12:12.48,0:12:14.35,Default,,0,0,0,,Үлкен жаңалық бар сияқты.
Dialogue: 0,0:12:16.81,0:12:19.86,Default,,0,0,0,,Нью-Йорк Буллз өкілі Гилтеннің шақыруымен.
Dialogue: 0,0:12:20.48,0:12:23.74,Default,,0,0,0,,Мүлде жаңа турнир өткізілуде.
Dialogue: 0,0:12:24.36,0:12:27.16,Default,,0,0,0,,Ең күшті Blader анықтау үшін жеке шайқас.
Dialogue: 0,0:12:27.74,0:12:28.95,Default,,0,0,0,,Жеке жарыс?
Dialogue: 0,0:12:29.29,0:12:31.08,Default,,0,0,0,,Мен мұны күттім!
Dialogue: 0,0:12:31.54,0:12:32.33,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:12:32.75,0:12:35.37,Default,,0,0,0,,«Кел, шешейік, ең күшті Бладер кім?»
Dialogue: 0,0:12:35.46,0:12:36.50,Default,,0,0,0,,Оны—
Dialogue: 0,0:12:36.58,0:12:40.76,Default,,0,0,0,,God Bladers кубогы өтеді!
Dialogue: 0,0:12:40.84,0:12:44.59,Default,,0,0,0,,Әлемдік рейтингтер және қуатты ұшқыштардың бірегей деректері
Dialogue: 0,0:12:44.68,0:12:50.39,Default,,0,0,0,,Талдаудан кейін таңдалған 12 адам арасында тарихтағы ең жақсы шайқас басталады!
Dialogue: 0,0:12:50.47,0:12:56.52,Default,,0,0,0,,Шешуші шайқастың кезеңі американдық Гранд Арена болды.
Dialogue: 0,0:12:56.60,0:13:01.86,Default,,0,0,0,,12 адам екі AB тобына бөлініп, үлкен айналымда шайқасқа шықты!
Dialogue: 0,0:13:01.94,0:13:04.40,Default,,0,0,0,,Сол жерден жеңіске жеткен бірінші және екінші орынды иеленген жүзгіштер
Dialogue: 0,0:13:04.49,0:13:06.95,Default,,0,0,0,,Барлығы 4 адам қатысатын финалдық турнир
Dialogue: 0,0:13:07.03,0:13:08.53,Default,,0,0,0,,Ең күштінің күштісі -
Dialogue: 0,0:13:08.62,0:13:11.70,Default,,0,0,0,,Ең күшті Blader анықталды!
Dialogue: 0,0:13:13.08,0:13:14.83,Default,,0,0,0,,Ең күшті Blader?
Dialogue: 0,0:13:16.00,0:13:17.71,Default,,0,0,0,,Луи міндетті түрде келеді.
Dialogue: 0,0:13:18.42,0:13:19.88,Default,,0,0,0,,Мен оның Шу екеніне сенімдімін...
Dialogue: 0,0:13:21.42,0:13:24.05,Default,,0,0,0,,Міне, сол екеуімен айқасасың!
Dialogue: 0,0:13:24.80,0:13:28.43,Default,,0,0,0,,Эй Крис, сен әлі 12 адам туралы шешім қабылдадың ба?
Dialogue: 0,0:13:28.84,0:13:31.31,Default,,0,0,0,,Иә, жаңа ғана шақыру алдым.
Dialogue: 0,0:13:31.81,0:13:34.14,Default,,0,0,0,,Қатысқыңыз келе ме, жоқ па деген сұраққа жауап алғым келеді.
Dialogue: 0,0:13:34.52,0:13:35.56,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:13:36.19,0:13:37.44,Default,,0,0,0,,Мен хабарландыру жасаймын.
Dialogue: 0,0:13:37.94,0:13:40.77,Default,,0,0,0,,Сол Сиско Карлайлдан BC
Dialogue: 0,0:13:41.52,0:13:42.73,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:13:43.40,0:13:44.82,Default,,0,0,0,,Куса Акерман
Dialogue: 0,0:13:45.11,0:13:47.07,Default,,0,0,0,,Иә? Шынымен бе? О?
Dialogue: 0,0:13:47.15,0:13:49.07,Default,,0,0,0,,Иә! бақытты!
Dialogue: 0,0:13:50.24,0:13:51.45,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:13:51.78,0:13:55.91,Default,,0,0,0,,А, жарайды! Қанекей мынаны істейік!
Dialogue: 0,0:13:56.50,0:13:57.96,Default,,0,0,0,,Жарайсың Аники
Dialogue: 0,0:13:58.04,0:13:59.46,Default,,0,0,0,,Балто керемет!
Dialogue: 0,0:13:59.54,0:14:01.38,Default,,0,0,0,,А... тағы не? Тағы не?
Dialogue: 0,0:14:01.96,0:14:04.38,Default,,0,0,0,,Бұл BC Солдан шыққан үш адам.
Dialogue: 0,0:14:04.80,0:14:08.09,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:14:08.18,0:14:10.26,Default,,0,0,0,,Басқа Блейдер кім?
Dialogue: 0,0:14:10.59,0:14:12.43,Default,,0,0,0,,Құдай Блейдерс кубогы
Dialogue: 0,0:14:12.51,0:14:16.23,Default,,0,0,0,,Біз таңдалған Бладерлерді таныстыруды жалғастырамыз!
Dialogue: 0,0:14:18.39,0:14:22.48,Default,,0,0,0,,«Нью-Йорк Буллздан» тегін Де Ла Хойя
Dialogue: 0,0:14:22.57,0:14:25.23,Default,,0,0,0,,Және Джошуа Бун
Dialogue: 0,0:14:28.20,0:14:33.78,Default,,0,0,0,,Бразилия Риосынан: жанып жатқан Кайза храмы және Сонг Лувей
Dialogue: 0,0:14:34.62,0:14:38.16,Default,,0,0,0,,Басқа жаңадан келгендер кометалар сияқты пайда болды!
Dialogue: 0,0:14:38.25,0:14:41.92,Default,,0,0,0,,Арч Бахамут Боа Алькасерді пайдалану
Dialogue: 0,0:14:42.00,0:14:43.00,Default,,0,0,0,,Ах
Dialogue: 0,0:14:43.38,0:14:46.26,Default,,0,0,0,,Боа... Жылан шұңқыры?
Dialogue: 0,0:14:51.72,0:14:54.05,Default,,0,0,0,,Ол кездегіден өзгеше.
Dialogue: 0,0:14:54.47,0:14:55.89,Default,,0,0,0,,Cigatterna
Dialogue: 0,0:14:56.39,0:15:00.60,Default,,0,0,0,,Nightmare Longinus пайдаланушысы Shirasagijo Louis!
Dialogue: 0,0:15:00.69,0:15:04.73,Default,,0,0,0,,Луис өзінің шынайы болмысын ашқанда Қызыл көз таң қалды.
Dialogue: 0,0:15:04.82,0:15:07.99,Default,,0,0,0,,Аңшы ретінде танымал болған Қызыл көздің шын тұлғасы қандай?
Dialogue: 0,0:15:08.07,0:15:12.62,Default,,0,0,0,,Бұл бұрын Нью-Йорк Буллзға тиесілі Шу Бени болып шықты!
Dialogue: 0,0:15:13.16,0:15:14.37,Default,,0,0,0,,Шу…
Dialogue: 0,0:15:14.78,0:15:19.04,Default,,0,0,0,,Біз сондай-ақ қатысу үшін күшті қылшықтармен келіссөздер жүргізіп жатырмыз!
Dialogue: 0,0:15:19.12,0:15:24.29,Default,,0,0,0,,Қандай пышақтардың қолжетімді болатынын асыға күтеміз!
Dialogue: 0,0:15:25.09,0:15:26.30,Default,,0,0,0,,Шу…
Dialogue: 0,0:15:26.55,0:15:29.72,Default,,0,0,0,,Енді бізден жасыратын ештеңе қалмады.
Dialogue: 0,0:15:29.80,0:15:31.68,Default,,0,0,0,,Неліктен қызыл көз?
Dialogue: 0,0:15:32.30,0:15:34.72,Default,,0,0,0,,Куришу өлді...
Dialogue: 0,0:15:35.39,0:15:36.72,Default,,0,0,0,,Сондықтан ма?
Dialogue: 0,0:15:36.81,0:15:38.14,Default,,0,0,0,,Балто!
Dialogue: 0,0:15:38.56,0:15:39.73,Default,,0,0,0,,Кумичо
Dialogue: 0,0:15:40.68,0:15:42.23,Default,,0,0,0,,Бұл үшін кешіріңіз!
Dialogue: 0,0:15:42.31,0:15:44.90,Default,,0,0,0,,Жарайды, жарайды, маған бәрібір.
Dialogue: 0,0:15:45.23,0:15:46.07,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:15:46.15,0:15:48.36,Default,,0,0,0,,Егер сіз God Bladers кубогына қатыса алмасаңыз
Dialogue: 0,0:15:48.44,0:15:50.74,Default,,0,0,0,,Мен сені қолдауға бар күшімді саламын!
Dialogue: 0,0:15:51.11,0:15:52.78,Default,,0,0,0,,Рахмет сізге Кумичо
Dialogue: 0,0:15:53.16,0:15:55.95,Default,,0,0,0,,Кедо Мен таң қалдым, Шудың мыңжыры.
Dialogue: 0,0:15:57.33,0:15:58.45,Default,,0,0,0,,Ол қазірдің өзінде...
Dialogue: 0,0:15:58.54,0:16:00.66,Default,,0,0,0,,Бұл біз білетін Шу емес.
Dialogue: 0,0:16:01.62,0:16:03.71,Default,,0,0,0,,Әй, Шу – жау.
Dialogue: 0,0:16:03.87,0:16:05.38,Default,,0,0,0,,Жау?
Dialogue: 0,0:16:06.79,0:16:08.92,Default,,0,0,0,,Аники... Жау деген не?
Dialogue: 0,0:16:09.46,0:16:11.55,Default,,0,0,0,,Олар тамаша достар емес пе еді?
Dialogue: 0,0:16:12.05,0:16:16.14,Default,,0,0,0,,Әй, Шуу – жау... бастапқыда дос емес пе еді?
Dialogue: 0,0:16:16.55,0:16:18.76,Default,,0,0,0,,Бұл мықтыны анықтайтын турнир.
Dialogue: 0,0:16:18.85,0:16:23.39,Default,,0,0,0,,Куза да, Сиско да BC Sol, бірақ олар маған жау.
Dialogue: 0,0:16:24.48,0:16:26.36,Default,,0,0,0,,Уау, жау?
Dialogue: 0,0:16:26.77,0:16:28.36,Default,,0,0,0,,Шуды жеңемін
Dialogue: 0,0:16:28.44,0:16:30.19,Default,,0,0,0,,Луис пен Фриді жеңіңіз
Dialogue: 0,0:16:30.44,0:16:32.07,Default,,0,0,0,,Мен жеңімпазмын
Dialogue: 0,0:16:32.74,0:16:34.99,Default,,0,0,0,,Жақсы! Жақсы айтылған!
Dialogue: 0,0:16:35.07,0:16:37.32,Default,,0,0,0,,Мен сіздің тәжірибелік серіктесіңіз боламын.
Dialogue: 0,0:16:37.57,0:16:39.54,Default,,0,0,0,,Менен асып кет, Балто!
Dialogue: 0,0:16:39.83,0:16:40.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:41.00,0:16:44.79,Default,,0,0,0,,Ол қазірдің өзінде қатты, сондықтан ол шығып жатыр, солай ма? құдай пышақ кесе
Dialogue: 0,0:16:44.87,0:16:47.04,Default,,0,0,0,,Мен түсіндім деп жатырмын.
Dialogue: 0,0:16:47.13,0:16:49.09,Default,,0,0,0,,Аха, мен де істеймін. Жаттығу
Dialogue: 0,0:16:49.50,0:16:51.34,Default,,0,0,0,,Ал, үш адаммен бірге жасайық!
Dialogue: 0,0:16:51.76,0:16:52.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:53.59,0:16:56.34,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:56.68,0:16:58.51,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:17:00.81,0:17:02.56,Default,,0,0,0,,Бұл қызықты бола бастады
Dialogue: 0,0:17:02.64,0:17:04.69,Default,,0,0,0,,Көрдім, жау
Dialogue: 0,0:17:04.77,0:17:07.19,Default,,0,0,0,,Бұл Барттың шешуші сөздері еді.
Dialogue: 0,0:17:11.03,0:17:13.24,Default,,0,0,0,,Сіз мұны істемейсіз бе?
Dialogue: 0,0:17:13.99,0:17:16.45,Default,,0,0,0,,Бұл әзіл емес.
Dialogue: 0,0:17:16.86,0:17:18.95,Default,,0,0,0,,Сіз шыншыл емессіз бе?
Dialogue: 0,0:17:23.08,0:17:24.50,Default,,0,0,0,,Ешуа
Dialogue: 0,0:17:24.91,0:17:28.33,Default,,0,0,0,,Құдай Блейдерс кубогына таңдалуыңызбен құттықтаймыз
Dialogue: 0,0:17:28.42,0:17:30.38,Default,,0,0,0,,Таңдалған соң өзіңізді қалай сезінесіз?
Dialogue: 0,0:17:30.67,0:17:33.80,Default,,0,0,0,,Ешуаны құттықтаймын
Dialogue: 0,0:17:34.26,0:17:36.76,Default,,0,0,0,,Бәріңіз де сізді таңдайды деп ойладыңыз, солай ма?
Dialogue: 0,0:17:37.13,0:17:40.55,Default,,0,0,0,,Таңдалған командаластар туралы не деуге болады?
Dialogue: 0,0:17:40.72,0:17:42.22,Default,,0,0,0,,Бұл тегін.
Dialogue: 0,0:17:42.31,0:17:44.48,Default,,0,0,0,,А, маған бәрібір. Маған бәрі бір.
Dialogue: 0,0:17:44.56,0:17:47.52,Default,,0,0,0,,Барлығы Джошуаға қарайды деп үміттенемін.
Dialogue: 0,0:17:48.10,0:17:51.27,Default,,0,0,0,,Кімнің мықты екенін бәрі біледі, солай ма?
Dialogue: 0,0:17:51.73,0:17:55.19,Default,,0,0,0,,Джошуа Я!
Dialogue: 0,0:17:55.36,0:17:58.99,Default,,0,0,0,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,0:17:59.07,0:18:00.20,Default,,0,0,0,,Егер біз сол жүк көлігінің кетуіне жол берсек, апат болар еді
Dialogue: 0,0:18:01.49,0:18:05.16,Default,,0,0,0,,Сәлем, сіз Боа Алькасер емессіз бе?
Dialogue: 0,0:18:05.58,0:18:07.25,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:18:08.62,0:18:09.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:09.96,0:18:14.09,Default,,0,0,0,,Барлығы, бұл рас. Бұл шынайы. Бұл Боа Алькасер.
Dialogue: 0,0:18:14.96,0:18:17.34,Default,,0,0,0,,Мұнда болу керемет!
Dialogue: 0,0:18:17.42,0:18:18.93,Default,,0,0,0,,Бұл шынымен де күшті, солай емес пе?
Dialogue: 0,0:18:19.01,0:18:22.05,Default,,0,0,0,,Сондықтан мені Құдай Блейдерс Кубогы таңдады
Dialogue: 0,0:18:22.14,0:18:25.02,Default,,0,0,0,,Эй Боа, сен жалғыз жаттығасың ба?
Dialogue: 0,0:18:25.10,0:18:25.93,Default,,0,0,0,,О
Dialogue: 0,0:18:26.35,0:18:28.77,Default,,0,0,0,,Бұл жағдайда бізбен бірге орындаңыз.
Dialogue: 0,0:18:28.85,0:18:31.44,Default,,0,0,0,,Бахамут Оның қаншалықты күшті екенін көргім келеді!
Dialogue: 0,0:18:32.06,0:18:33.82,Default,,0,0,0,,Мен ең жақсымын!
Dialogue: 0,0:18:33.90,0:18:35.23,Default,,0,0,0,,Э~?
Dialogue: 0,0:18:35.32,0:18:37.78,Default,,0,0,0,,Жарайсың ба? Мен мұны істеуді сұрадым.
Dialogue: 0,0:18:37.86,0:18:39.53,Default,,0,0,0,,Эй, бұл жақсы емес пе, Боа?
Dialogue: 0,0:18:39.61,0:18:40.78,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:18:41.62,0:18:42.62,Default,,0,0,0,,Хмм!
Dialogue: 0,0:18:42.87,0:18:44.95,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:45.04,0:18:47.00,Default,,0,0,0,,О, сен көп жейсің.
Dialogue: 0,0:18:47.70,0:18:49.25,Default,,0,0,0,,Тағамның таңғажайып мөлшері
Dialogue: 0,0:18:49.33,0:18:51.79,Default,,0,0,0,,Қарап тұрсам тоқпын...
Dialogue: 0,0:18:51.88,0:18:55.50,Default,,0,0,0,,Жақсы, Балто. Сіздің энергияңыз қайта оралды.
Dialogue: 0,0:18:56.05,0:18:58.47,Default,,0,0,0,,Аники, жаттығуың қалай өтіп жатыр?
Dialogue: 0,0:18:58.63,0:19:01.14,Default,,0,0,0,,Сіз тамақ ішесіз бе, әлде жаттығу жасайсыз ба?
Dialogue: 0,0:19:01.47,0:19:04.39,Default,,0,0,0,,Әлемнің түкпір-түкпірінен мықты адамдар жиналады.
Dialogue: 0,0:19:06.35,0:19:09.06,Default,,0,0,0,,Қанша жаттығу жасасаң да, ол ешқашан жетпейді
Dialogue: 0,0:19:10.60,0:19:13.61,Default,,0,0,0,,Сіз бәрібір таңдалғандықтан, сіз жеңесіз.
Dialogue: 0,0:19:15.32,0:19:17.19,Default,,0,0,0,,Жарайды, бұл ниет.
Dialogue: 0,0:19:17.28,0:19:21.20,Default,,0,0,0,,Барлық Bladers жиналыс бөлмесіне жиналыңыз.
Dialogue: 0,0:19:21.36,0:19:22.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:22.66,0:19:23.95,Default,,0,0,0,,Қайталау
Dialogue: 0,0:19:24.03,0:19:27.79,Default,,0,0,0,,Барлық Bladers жиналыс бөлмесіне жиналыңыз.
Dialogue: 0,0:19:28.25,0:19:29.58,Default,,0,0,0,,Тағы бір қоңырау
Dialogue: 0,0:19:29.91,0:19:31.29,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:19:32.25,0:19:35.21,Default,,0,0,0,,Мен барлығының көргісі келетін нәрсе бар.
Dialogue: 0,0:19:35.71,0:19:36.67,Default,,0,0,0,,Міне
Dialogue: 0,0:19:37.17,0:19:38.38,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:39.17,0:19:40.76,Default,,0,0,0,,Ол осында келді.
Dialogue: 0,0:19:41.09,0:19:42.93,Default,,0,0,0,,Сіз таңғажайып нәрселерді көре аласыз
Dialogue: 0,0:19:43.05,0:19:44.93,Default,,0,0,0,,Оны атам әлі көрді ме?
Dialogue: 0,0:19:45.01,0:19:45.97,Default,,0,0,0,,Аралау
Dialogue: 0,0:19:46.05,0:19:49.10,Default,,0,0,0,,Таңқаларлық, таң қалдыратын бейне.
Dialogue: 0,0:19:52.02,0:19:53.52,Default,,0,0,0,,Луис және Фри
Dialogue: 0,0:19:53.60,0:19:54.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:59.03,0:20:00.44,Default,,0,0,0,,Бұл Сенбус шайқасы.
Dialogue: 0,0:20:01.24,0:20:02.99,Default,,0,0,0,,Менің ойымша, сенің мені сүйетін уақыт келді.
Dialogue: 0,0:20:03.61,0:20:05.74,Default,,0,0,0,,Ғұндар бір-бірімен
Dialogue: 0,0:20:07.99,0:20:09.75,Default,,0,0,0,,Түнгі түсірілім
Dialogue: 0,0:20:10.16,0:20:13.00,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:20:13.58,0:20:15.83,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:31.89,0:20:33.98,Default,,0,0,0,,Оны құлат! longinus
Dialogue: 0,0:20:34.60,0:20:35.52,Default,,0,0,0,,Иә
Dialogue: 0,0:20:41.03,0:20:43.53,Default,,0,0,0,,Жақында шешілетін сияқты.
Dialogue: 0,0:20:48.24,0:20:51.87,Default,,0,0,0,,Хахахаха Лонгинус, шайнап ал!
Dialogue: 0,0:20:53.62,0:20:56.88,Default,,0,0,0,,Go Metal Dragon Clash
Dialogue: 0,0:21:09.72,0:21:10.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:16.19,0:21:17.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:17.90,0:21:19.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:19.90,0:21:21.98,Default,,0,0,0,,Бейне осы жерде аяқталады.
Dialogue: 0,0:21:22.78,0:21:25.11,Default,,0,0,0,,Тегін жоғалтты ма?
Dialogue: 0,0:21:25.99,0:21:27.36,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:21:27.78,0:21:30.28,Default,,0,0,0,,Крис, мұны кім жіберді?
Dialogue: 0,0:21:31.49,0:21:32.58,Default,,0,0,0,,Сауда.
Dialogue: 0,0:21:33.08,0:21:34.25,Default,,0,0,0,,Сауда?
Dialogue: 0,0:21:34.75,0:21:36.25,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:21:36.33,0:21:38.08,Default,,0,0,0,,Иә? …а!
Dialogue: 0,0:21:42.71,0:21:43.76,Default,,0,0,0,,Тегін?
Dialogue: 0,0:21:43.84,0:21:45.92,Default,,0,0,0,,Неге?
Dialogue: 0,0:21:46.55,0:21:48.39,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:21:55.93,0:21:56.39,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.39,0:22:00.02,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.39,0:22:00.02,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, бұлшық еттеріңді жаттығып жатырсыңдар ма?
Dialogue: 0,0:22:00.11,0:22:03.03,Default,,0,0,0,,Енді, күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:03.11,0:22:06.99,Default,,0,0,0,,Қозғалыс 1-нұсқаға қарағанда қарқындырақ. Алдымен алдыңғы эпизодты және көрсетілім уақытын қарастырайық.
Dialogue: 0,0:22:07.07,0:22:10.66,Default,,0,0,0,,GO Shoot GO Shoot Great Shoot!
Dialogue: 0,0:22:10.74,0:22:14.33,Default,,0,0,0,,GO Shoot GO Shoot Жылдамдату!
Dialogue: 0,0:22:14.41,0:22:17.96,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:18.04,0:22:21.46,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:21.54,0:22:24.84,Default,,0,0,0,,Хахахаха Бұл жақсы емес пе? Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.92,0:22:28.84,Default,,0,0,0,,Бірақ бұл жерден күшейе түседі, мен қолдарымды және кернеуімді күшейтемін.
Dialogue: 0,0:22:28.93,0:22:32.72,Default,,0,0,0,,GO ату GO ату Бей бұлшық ет поезы Моримори
Dialogue: 0,0:22:32.80,0:22:36.43,Default,,0,0,0,,GO АТТЫ БАР АТТЫ Менің атысым - құдайдың атысы
Dialogue: 0,0:22:36.52,0:22:40.15,Default,,0,0,0,,Оңға ату Солға ату Оңға ату
Dialogue: 0,0:22:40.23,0:22:43.86,Default,,0,0,0,,Сол жақ ату Оң жақ ату Сол жақта ату
Dialogue: 0,0:22:43.94,0:22:47.53,Default,,0,0,0,,Өткен аптада Осы аптада GO түсірілімін жасап жатырмыз
Dialogue: 0,0:22:47.61,0:22:51.24,Default,,0,0,0,,Осы аптада келесі аптада GO түсіру, ол да жасайды
Dialogue: 0,0:22:51.32,0:22:54.95,Default,,0,0,0,,Күн сайын барлығы жасайтын GO ату жаттығуларын жасаңыз
Dialogue: 0,0:22:55.04,0:22:58.50,Default,,0,0,0,,Жыл бойы көктемде, жазда, күзде және қыста GO түсіреді
Dialogue: 0,0:22:58.58,0:23:00.12,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:23:00.21,0:23:02.75,Default,,0,0,0,,Шығанақ бұлшықеттерін жаттықтыру үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.83,0:23:05.92,Default,,0,0,0,,Сол шиеленіспен шарықтау шегіне жетейік!
Dialogue: 0,0:23:06.00,0:23:09.72,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Келіңіздер!
Dialogue: 0,0:23:09.80,0:23:13.22,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Let's Go!
Dialogue: 0,0:23:13.30,0:23:17.10,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Кеттік!
Dialogue: 0,0:23:17.18,0:23:19.98,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:19.98,0:23:21.98,Default,,0,0,0,,Үш екі бір GO Shoot Burst Finish!
Dialogue: 0,0:23:19.98,0:23:21.98,Default,,0,0,0,,~♪
Dialogue: 0,0:23:21.98,0:23:22.06,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.06,0:23:24.94,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.06,0:23:24.94,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:24.94,0:23:25.48,Default,,0,0,0,,~♪
Dialogue: 0,0:23:27.07,0:23:29.74,Default,,0,0,0,,Шаса шынымен ашулы
Dialogue: 0,0:23:29.82,0:23:32.24,Default,,0,0,0,,Осындай кездері Кузаға келеді.
Dialogue: 0,0:23:32.32,0:23:36.20,Default,,0,0,0,,Әй, одан да нашарлап кетті!
Dialogue: 0,0:23:36.28,0:23:40.50,Default,,0,0,0,,Шамамен осы уақытта Жылан шұңқырында қорқынышты нәрсе болды.
Dialogue: 0,0:23:41.00,0:23:42.87,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:42.96,0:23:45.59,Default,,0,0,0,,Жаман машина! Спригган реквиемі!
Dialogue: 0,0:23:45.67,0:23:49.88,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.38,0:23:57.38,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory