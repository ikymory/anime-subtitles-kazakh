Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.33,0:00:05.46,Default,,0,0,0,,Бейблейд!
Dialogue: 0,0:00:07.00,0:00:09.17,Default,,0,0,0,,Бұл баланың арманы
Dialogue: 0,0:00:09.75,0:00:14.47,Default,,0,0,0,,Дүние жүзінің түкпір-түкпірінен келген пышақшылар шыңға жету үшін жарысады және бір-біріне қарсы жанын салады.
Dialogue: 0,0:00:15.47,0:00:20.10,Default,,0,0,0,,Айналсын, жарылып, жарылсын!
Dialogue: 0,0:00:20.77,0:00:23.85,Default,,0,0,0,,Даңқты жеңіске қол жеткізіңіз!
Dialogue: 0,0:00:24.56,0:00:27.56,Default,,0,0,0,,Шайқастан кейін оны міндетті түрде табасыз.
Dialogue: 0,0:00:27.94,0:00:30.03,Default,,0,0,0,,Жарқын болашақ!
Dialogue: 0,0:00:32.28,0:00:34.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:35.20,0:00:37.53,Default,,0,0,0,,God Bladers кубогының екінші кезеңі
Dialogue: 0,0:00:37.62,0:00:40.62,Default,,0,0,0,,Керемет жігіттер бірінен соң бірі соқтығысады.
Dialogue: 0,0:00:42.41,0:00:43.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:43.91,0:00:45.17,Default,,0,0,0,,Иә
Dialogue: 0,0:00:45.25,0:00:47.83,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:00:48.17,0:00:51.09,Default,,0,0,0,,Иә! Берри керемет
Dialogue: 0,0:00:51.17,0:00:52.34,Default,,0,0,0,,Не!
Dialogue: 0,0:00:54.17,0:00:56.05,Default,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,0:01:00.06,0:01:02.47,Default,,0,0,0,,Егер қолыңнан келсе, істе
Dialogue: 0,0:01:02.85,0:01:05.27,Default,,0,0,0,,Мен сені нағыз қорқынышты түс көремін
Dialogue: 0,0:01:08.56,0:01:09.86,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:10.40,0:01:11.40,Default,,0,0,0,,Не!
Dialogue: 0,0:01:12.48,0:01:14.36,Default,,0,0,0,,Соңғы апат!
Dialogue: 0,0:01:14.61,0:01:16.86,Default,,0,0,0,,Smash Hammer!
Dialogue: 0,0:01:21.08,0:01:22.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:23.91,0:01:25.71,Default,,0,0,0,,Келесі үшінші тур
Dialogue: 0,0:01:25.79,0:01:28.71,Default,,0,0,0,,Кім келсе де, үрлеймін!
Dialogue: 0,0:01:31.42,0:01:34.17,Default,,0,0,0,,♪~
Dialogue: 0,0:01:34.26,0:01:36.59,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:36.67,0:01:39.14,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:39.22,0:01:41.51,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:41.60,0:01:44.06,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:44.14,0:01:45.85,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:45.93,0:01:50.15,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:51.11,0:01:55.86,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:55.94,0:02:00.87,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:00.95,0:02:05.66,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:05.75,0:02:10.67,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:10.75,0:02:15.59,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:15.67,0:02:20.76,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:20.93,0:02:24.06,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:24.14,0:02:25.60,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:25.68,0:02:28.18,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:28.27,0:02:30.56,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:30.65,0:02:32.73,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:32.81,0:02:34.07,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:34.15,0:02:35.73,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:35.82,0:02:38.24,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:38.32,0:02:44.49,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:44.58,0:02:48.75,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:48.83,0:02:51.62,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:51.71,0:02:54.21,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:54.29,0:02:56.71,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:56.80,0:03:00.18,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:02.14,0:03:05.26,Default,,0,0,0,,Супер эволюция! Құдай Валькириге шабуыл жасаңыз!
Dialogue: 0,0:03:07.39,0:03:11.52,Default,,0,0,0,,Еркін конькиші 2 кездесуде жеңіске жетті, Балт пен Сиско 1 кездесуде жеңіске жетіп, 1 кездесуде жеңілді.
Dialogue: 0,0:03:11.85,0:03:13.69,Default,,0,0,0,,Ал Куза екі рет жеңілді.
Dialogue: 0,0:03:13.77,0:03:16.82,Default,,0,0,0,,Финалдық турнирге кім өте алады?
Dialogue: 0,0:03:16.90,0:03:19.19,Default,,0,0,0,,Әр топта 2 орынға дейін
Dialogue: 0,0:03:19.28,0:03:21.36,Default,,0,0,0,,Куза Берілме
Dialogue: 0,0:03:21.65,0:03:23.20,Default,,0,0,0,,Бір шымшым - бұл мүмкіндік!
Dialogue: 0,0:03:23.28,0:03:25.91,Default,,0,0,0,,Эй, мен оны дереу қайтарып аламын.
Dialogue: 0,0:03:25.99,0:03:27.20,Default,,0,0,0,,Монне!
Dialogue: 0,0:03:27.29,0:03:28.79,Default,,0,0,0,,Сондықтан бұл Куза.
Dialogue: 0,0:03:28.87,0:03:29.91,Default,,0,0,0,,О!
Dialogue: 0,0:03:30.41,0:03:31.87,Default,,0,0,0,,Бұл ниет
Dialogue: 0,0:03:31.96,0:03:34.50,Default,,0,0,0,,Барлығының келесі қарсыласы анықталды.
Dialogue: 0,0:03:34.92,0:03:37.67,Default,,0,0,0,,А тобы Барт Норман Тарвер деп аталады.
Dialogue: 0,0:03:38.46,0:03:39.71,Default,,0,0,0,,Норман?
Dialogue: 0,0:03:39.80,0:03:42.47,Default,,0,0,0,,Ол Жылан шұңқырының жоғарғы класында болды.
Dialogue: 0,0:03:42.55,0:03:43.68,Default,,0,0,0,,Сіз сақтықты түсіре алмайсыз.
Dialogue: 0,0:03:43.80,0:03:45.39,Default,,0,0,0,,А, мен білемін.
Dialogue: 0,0:03:46.01,0:03:47.68,Default,,0,0,0,,Куза – қызыл көз
Dialogue: 0,0:03:47.76,0:03:50.14,Default,,0,0,0,,Міне! Қызыл көз!
Dialogue: 0,0:03:50.23,0:03:51.94,Default,,0,0,0,,Қызыл көз!
Dialogue: 0,0:03:52.02,0:03:53.98,Default,,0,0,0,,Екінші тарап үшін кемшілік жоқ
Dialogue: 0,0:03:54.10,0:03:57.44,Default,,0,0,0,,Балт: Мен алдымен Қызыл көзді жеңемін!
Dialogue: 0,0:03:57.52,0:03:58.48,Default,,0,0,0,,Иә
Dialogue: 0,0:03:58.57,0:04:02.20,Default,,0,0,0,,Ал В тобындағы Cisco тегін.
Dialogue: 0,0:04:02.49,0:04:06.24,Default,,0,0,0,,Хмм... Хмф, бұл таңқаларлық жылдам болды.
Dialogue: 0,0:04:06.32,0:04:08.58,Default,,0,0,0,,Үшінші айналым болғандықтан әлі ерте емес.
Dialogue: 0,0:04:08.66,0:04:11.50,Default,,0,0,0,,Топтық кезең бес рет ойналады.
Dialogue: 0,0:04:11.58,0:04:15.21,Default,,0,0,0,,Олай деме, сен міндетті түрде жеңесің!
Dialogue: 0,0:04:15.29,0:04:16.29,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:04:16.38,0:04:17.34,Default,,0,0,0,,Тақырып...
Dialogue: 0,0:04:17.42,0:04:19.63,Default,,0,0,0,,Сабыр ет, ұрыс ертең.
Dialogue: 0,0:04:19.71,0:04:21.13,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:04:21.21,0:04:24.05,Default,,0,0,0,,Кух... Ух-ну-ну-ну-ну
Dialogue: 0,0:04:25.76,0:04:27.30,Default,,0,0,0,,Анно Яроу
Dialogue: 0,0:04:27.76,0:04:30.43,Default,,0,0,0,,Эй, Риксон, жаттығу жасайық. Бізге қосылыңыздар!
Dialogue: 0,0:04:30.52,0:04:32.64,Default,,0,0,0,,О, мен дайынмын!
Dialogue: 0,0:04:33.18,0:04:35.35,Default,,0,0,0,,Cisco, оны өртеп жіберіңіз
Dialogue: 0,0:04:35.44,0:04:37.02,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:04:37.52,0:04:40.19,Default,,0,0,0,,Мен екеуінің де жеңіске жеткенін қалаймын.
Dialogue: 0,0:04:40.65,0:04:42.53,Default,,0,0,0,,Біз мұнайшыларға қарсы шараларды да ойластыруымыз керек.
Dialogue: 0,0:04:42.94,0:04:44.20,Default,,0,0,0,,Қарсы шаралар?
Dialogue: 0,0:04:44.95,0:04:46.16,Default,,0,0,0,,Барт
Dialogue: 0,0:04:46.61,0:04:49.70,Default,,0,0,0,,Мен де дайынмын.
Dialogue: 0,0:04:50.37,0:04:51.66,Default,,0,0,0,,Хамемии
Dialogue: 0,0:04:51.91,0:04:54.83,Default,,0,0,0,,О, Strike God Chip!
Dialogue: 0,0:04:56.83,0:04:57.92,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:58.84,0:05:00.96,Default,,0,0,0,,Сіз мұны ақырында орындадыңыз, Балто.
Dialogue: 0,0:05:01.05,0:05:01.88,Default,,0,0,0,,О!
Dialogue: 0,0:05:01.96,0:05:03.72,Default,,0,0,0,,Сіз Норман шайқасына уақытында жеттіңіз.
Dialogue: 0,0:05:03.80,0:05:05.68,Default,,0,0,0,,Хэхэ~ Джажан~н
Dialogue: 0,0:05:06.59,0:05:09.18,Default,,0,0,0,,Құдай Валькирия дүниеге келді!
Dialogue: 0,0:05:09.26,0:05:12.14,Default,,0,0,0,,Сонымен? Ереуіл болса не болады?
Dialogue: 0,0:05:12.22,0:05:14.23,Default,,0,0,0,,Енді?
Dialogue: 0,0:05:14.31,0:05:15.64,Default,,0,0,0,,«Келіңіздер»…
Dialogue: 0,0:05:15.73,0:05:17.10,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:05:17.19,0:05:19.94,Default,,0,0,0,,Сіз шынымен күшті боласыз, солай ма? Ата!
Dialogue: 0,0:05:20.57,0:05:22.94,Default,,0,0,0,,О! Мен күшейемін
Dialogue: 0,0:05:23.03,0:05:24.94,Default,,0,0,0,,Өте күшті болады
Dialogue: 0,0:05:25.19,0:05:26.32,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:05:26.40,0:05:27.41,Default,,0,0,0,,Жоқ, бұл жарамайды. Қаш! Жылдам!
Dialogue: 0,0:05:27.74,0:05:28.78,Default,,0,0,0,,«Жага»?
Dialogue: 0,0:05:29.45,0:05:31.78,Default,,0,0,0,,Сіз байланыстырылған шабуылдарды мүлде пайдалана алмайсыз.
Dialogue: 0,0:05:31.87,0:05:32.87,Default,,0,0,0,,Не!
Dialogue: 0,0:05:32.95,0:05:34.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:35.33,0:05:36.79,Default,,0,0,0,,Бұл дұрыс, қозғалма.
Dialogue: 0,0:05:37.17,0:05:39.75,Default,,0,0,0,,Бұл әлсіздік болуы мүмкін.
Dialogue: 0,0:05:39.83,0:05:41.29,Default,,0,0,0,,Фофофу~
Dialogue: 0,0:05:41.38,0:05:43.25,Default,,0,0,0,,Олай болса, жасап көрейік.
Dialogue: 0,0:05:44.34,0:05:45.63,Default,,0,0,0,,Бейбаттл
Dialogue: 0,0:05:46.30,0:05:49.30,Default,,0,0,0,,О, жасайық! Арнайы дайындық!
Dialogue: 0,0:05:56.98,0:05:57.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:58.39,0:06:00.90,Default,,0,0,0,,Burst Finish Куза жеңеді!
Dialogue: 0,0:06:01.61,0:06:06.15,Default,,0,0,0,,Мен Валькирия құдайы болсам да, жеңе алмаймын.
Dialogue: 0,0:06:06.61,0:06:08.28,Default,,0,0,0,,Сіз күшеймейсіз.
Dialogue: 0,0:06:08.61,0:06:12.49,Default,,0,0,0,,Bound қолданбасын пайдалана алмағандықтан, сіз көбірек зиян келтіресіз.
Dialogue: 0,0:06:12.78,0:06:15.66,Default,,0,0,0,,Бұл Зоро айтқан әлсіздік пе?
Dialogue: 0,0:06:16.29,0:06:19.33,Default,,0,0,0,,Оның орнына сәтті соққының күші
Dialogue: 0,0:06:19.42,0:06:20.96,Default,,0,0,0,,Ол күшті болуы керек.
Dialogue: 0,0:06:21.54,0:06:24.71,Default,,0,0,0,,Спригганның «Реквиемі» ойынын да жеңе алмаймын деп ойлаймын.
Dialogue: 0,0:06:25.38,0:06:28.01,Default,,0,0,0,,Сіз Requiem Slash ойынында жеңілмейсіз бе?
Dialogue: 0,0:06:29.43,0:06:31.43,Default,,0,0,0,,Жасайық! Жаттығуды жалғастырыңыз!
Dialogue: 0,0:06:31.80,0:06:34.85,Default,,0,0,0,,Құдай Валькиридің соққысы тиетініне көз жеткізіңіз!
Dialogue: 0,0:06:35.31,0:06:37.27,Default,,0,0,0,,О, мен сені өлтіремін!
Dialogue: 0,0:06:40.23,0:06:41.10,Default,,0,0,0,,Егер біз сол жүк көлігінің кетуіне жол берсек, апат болар еді
Dialogue: 0,0:06:41.40,0:06:42.44,Default,,0,0,0,,Егер біз сол жүк көлігінің кетуіне жол берсек, апат болар еді
Dialogue: 0,0:06:47.94,0:06:49.82,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:53.03,0:06:54.91,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:55.08,0:06:56.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:57.08,0:06:58.08,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:06:58.75,0:06:59.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:01.25,0:07:02.29,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:02.88,0:07:03.88,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:07:03.96,0:07:05.00,Default,,0,0,0,,Күш
Dialogue: 0,0:07:05.09,0:07:06.17,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:06.34,0:07:09.72,Default,,0,0,0,,Аники Қазіргі техника... Оған ат қоймаңыз!
Dialogue: 0,0:07:09.80,0:07:11.93,Default,,0,0,0,,Аты-жөні? (Жаным) Керемет жігіт!
Dialogue: 0,0:07:12.30,0:07:13.97,Default,,0,0,0,,Керемет жігіт пе?
Dialogue: 0,0:07:15.01,0:07:16.01,Default,,0,0,0,,Құдай…
Dialogue: 0,0:07:16.39,0:07:18.14,Default,,0,0,0,,God Slash
Dialogue: 0,0:07:18.22,0:07:20.64,Default,,0,0,0,,Иә, Құдай жарсын!
Dialogue: 0,0:07:22.35,0:07:24.48,Default,,0,0,0,,God Slash аяқталды.
Dialogue: 0,0:07:27.86,0:07:30.57,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар!
Dialogue: 0,0:07:30.65,0:07:33.66,Default,,0,0,0,,God Bladers кубогына қош келдіңіз
Dialogue: 0,0:07:33.78,0:07:36.24,Default,,0,0,0,,Үшінші тур басталады!
Dialogue: 0,0:07:36.53,0:07:39.12,Default,,0,0,0,,Алдымен А тобындағы бірінші ойын
Dialogue: 0,0:07:41.41,0:07:42.62,Default,,0,0,0,,Куза
Dialogue: 0,0:07:43.25,0:07:47.38,Default,,0,0,0,,Жұмбақ пердеге оранған жалынға оранған қызыл жын
Dialogue: 0,0:07:47.46,0:07:48.84,Default,,0,0,0,,Қызыл көз!
Dialogue: 0,0:07:49.21,0:07:53.80,Default,,0,0,0,,Ал стадион жонглері Куса Акерман!
Dialogue: 0,0:07:59.06,0:08:01.77,Default,,0,0,0,,Қызыл көз, ұлы рух.
Dialogue: 0,0:08:02.56,0:08:04.56,Default,,0,0,0,,Бұл жыланның шұңқырында кездескенімізден басқаша.
Dialogue: 0,0:08:06.90,0:08:07.94,Default,,0,0,0,,Ха...
Dialogue: 0,0:08:12.57,0:08:13.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:15.91,0:08:17.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:17.33,0:08:20.70,Default,,0,0,0,,Олай емес сияқты, Куза! Неден сонша қорқасың?
Dialogue: 0,0:08:21.08,0:08:22.41,Default,,0,0,0,,Қалып құйылды
Dialogue: 0,0:08:22.62,0:08:24.62,Default,,0,0,0,,Куза мықтап!
Dialogue: 0,0:08:24.71,0:08:25.96,Default,,0,0,0,,Сабыр ет!
Dialogue: 0,0:08:26.50,0:08:28.09,Default,,0,0,0,,Сезіміңіздің сізді жеңуіне жол бермеңіз!
Dialogue: 0,0:08:33.34,0:08:35.97,Default,,0,0,0,,God Slash аяқталды.
Dialogue: 0,0:08:36.97,0:08:38.05,Default,,0,0,0,,О
Dialogue: 0,0:08:38.55,0:08:40.97,Default,,0,0,0,,Валькири шынымен бақытты.
Dialogue: 0,0:08:41.06,0:08:43.52,Default,,0,0,0,,Кроноспен шайқаса алатыныма қуаныштымын!
Dialogue: 0,0:08:43.60,0:08:44.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:45.06,0:08:48.15,Default,,0,0,0,,Кузалық Кронос та өте бақытты.
Dialogue: 0,0:08:48.48,0:08:50.15,Default,,0,0,0,,Ойра Кроностары?
Dialogue: 0,0:08:50.73,0:08:53.44,Default,,0,0,0,,Мен Бейдің дауысын естіп тұрмын!
Dialogue: 0,0:08:54.82,0:08:56.82,Default,,0,0,0,,Кронос не дейді?
Dialogue: 0,0:08:57.49,0:09:00.12,Default,,0,0,0,,Уау, бұл қызықты.
Dialogue: 0,0:09:01.99,0:09:05.83,Default,,0,0,0,,Кронос Ойра да толқыды.
Dialogue: 0,0:09:06.71,0:09:10.46,Default,,0,0,0,,Қызыл көз, сенің рухың зор екенін мойындаймын.
Dialogue: 0,0:09:11.17,0:09:14.17,Default,,0,0,0,,Сізбен шайқасқа шыққаныма қуаныштымын!
Dialogue: 0,0:09:15.01,0:09:17.64,Default,,0,0,0,,Мотивация қосқышы қосылды!
Dialogue: 0,0:09:23.85,0:09:26.06,Default,,0,0,0,,Рух Кусаға оралды!
Dialogue: 0,0:09:26.14,0:09:27.77,Default,,0,0,0,,Менің келуім керек.
Dialogue: 0,0:09:27.85,0:09:29.77,Default,,0,0,0,,Бар, жүр, Куза!
Dialogue: 0,0:09:30.57,0:09:31.98,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:09:33.82,0:09:35.53,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:09:35.90,0:09:38.74,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:39.24,0:09:40.87,Default,,0,0,0,,Бару…
Dialogue: 0,0:09:42.08,0:09:43.12,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:09:46.75,0:09:49.88,Default,,0,0,0,,Спригганның сағат тіліне қарсы шабуыл режимі бар!
Dialogue: 0,0:09:49.96,0:09:53.63,Default,,0,0,0,,Тіпті солға айналу болса да, оның менің Хроносыма еш қатысы жоқ!
Dialogue: 0,0:09:54.30,0:09:56.17,Default,,0,0,0,,Түсірілімнен сырғыңыз!
Dialogue: 0,0:09:56.63,0:09:59.43,Default,,0,0,0,,Wow~ Alter Kronos
Dialogue: 0,0:09:59.72,0:10:04.14,Default,,0,0,0,,Спригганмен соқтығыспау үшін стадионның қабырғасына көтерілді.
Dialogue: 0,0:10:04.47,0:10:05.43,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,0:10:09.81,0:10:10.73,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:11.81,0:10:14.78,Default,,0,0,0,,Уау! Теңдестірілген түрлер арасындағы есеп ...
Dialogue: 0,0:10:14.86,0:10:17.24,Default,,0,0,0,,Бұл төзімділік шайқасы болды!
Dialogue: 0,0:10:17.32,0:10:21.91,Default,,0,0,0,,Ой, спригганның жылдамдығы сәл әлсіреді.
Dialogue: 0,0:10:22.66,0:10:23.95,Default,,0,0,0,,Мен мұны күттім.
Dialogue: 0,0:10:24.37,0:10:25.87,Default,,0,0,0,,Тар арқанмен секіру!
Dialogue: 0,0:10:28.96,0:10:30.37,Default,,0,0,0,,Кронос!
Dialogue: 0,0:10:43.97,0:10:44.89,Default,,0,0,0,,Хмм? Бұл не…
Dialogue: 0,0:10:45.51,0:10:46.39,Default,,0,0,0,,Иә
Dialogue: 0,0:10:46.47,0:10:49.19,Default,,0,0,0,,Бұл Спригган Кроностың күші.
Dialogue: 0,0:10:49.27,0:10:50.65,Default,,0,0,0,,Оны резеңке сіңіреді.
Dialogue: 0,0:10:52.94,0:10:54.15,Default,,0,0,0,,Спригган!
Dialogue: 0,0:10:59.74,0:11:01.41,Default,,0,0,0,,Слеш реквиемі!
Dialogue: 0,0:11:02.62,0:11:03.74,Default,,0,0,0,,(Айналмалы дыбыс)
Dialogue: 0,0:11:03.82,0:11:04.83,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:11:06.37,0:11:07.45,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:11:08.83,0:11:09.91,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:10.92,0:11:13.50,Default,,0,0,0,,Спригган реквиемінің жарқырауы
Dialogue: 0,0:11:13.83,0:11:15.42,Default,,0,0,0,,Жеңімпаз қызыл көз!
Dialogue: 0,0:11:15.50,0:11:17.25,Default,,0,0,0,,
Dialogue: 0,0:11:17.38,0:11:19.76,Default,,0,0,0,,Не! О құдайым-ай!
Dialogue: 0,0:11:19.84,0:11:24.68,Default,,0,0,0,,Қолайсыз деп есептелген Спригган керемет қайтып келді!
Dialogue: 0,0:11:24.76,0:11:28.47,Default,,0,0,0,,Қызыл көздің қабілеті әлі күнге дейін түсініксіз!
Dialogue: 0,0:11:28.56,0:11:29.52,Default,,0,0,0,,Cuza…
Dialogue: 0,0:11:35.31,0:11:37.07,Default,,0,0,0,,Ку… жиіркенішті…
Dialogue: 0,0:11:37.61,0:11:40.11,Default,,0,0,0,,Қарғыс атсын... бұл жиіркенішті
Dialogue: 0,0:11:40.28,0:11:42.20,Default,,0,0,0,,Жиренішті Жиренішті
Dialogue: 0,0:11:42.28,0:11:43.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:43.66,0:11:45.87,Default,,0,0,0,,Жиренішті Жиренішті Жиренішті!
Dialogue: 0,0:11:46.53,0:11:48.37,Default,,0,0,0,,Куяши!
Dialogue: 0,0:11:48.66,0:11:51.37,Default,,0,0,0,,Бұл жиіркенішті Бұл жиіркенішті
Dialogue: 0,0:11:52.04,0:11:54.08,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:11:57.50,0:11:58.38,Default,,0,0,0,,Cuza…
Dialogue: 0,0:12:00.46,0:12:03.59,Default,,0,0,0,,Балтомен шайқас Өкінішті, мен үлгере алмадым.
Dialogue: 0,0:12:04.47,0:12:06.39,Default,,0,0,0,,Спригган күшті болды
Dialogue: 0,0:12:07.47,0:12:11.10,Default,,0,0,0,,Бірақ адам, бұл шынымен де қызықты және қызықты болды.
Dialogue: 0,0:12:11.73,0:12:14.31,Default,,0,0,0,,Барто Келесі жолы Норманмен бірге.
Dialogue: 0,0:12:14.44,0:12:15.40,Default,,0,0,0,,О
Dialogue: 0,0:12:16.11,0:12:17.77,Default,,0,0,0,,Ой, ойланып қалдым.
Dialogue: 0,0:12:17.86,0:12:19.86,Default,,0,0,0,,Өйткені Валькирияның қанаттары жоғары бағытталған
Dialogue: 0,0:12:19.94,0:12:23.32,Default,,0,0,0,,Мен Nemesis жоғарғы режимде келетініне сенімдімін.
Dialogue: 0,0:12:24.03,0:12:24.95,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:12:26.45,0:12:27.24,Default,,0,0,0,,Эххе
Dialogue: 0,0:12:28.66,0:12:30.54,Default,,0,0,0,,Жеңіске жет! аа!
Dialogue: 0,0:12:37.33,0:12:40.09,Default,,0,0,0,,Куяшии!
Dialogue: 0,0:12:44.34,0:12:47.93,Default,,0,0,0,,A блок Екінші ойын басталғалы жатыр!
Dialogue: 0,0:12:48.01,0:12:52.22,Default,,0,0,0,,Бірінші пайда болған адам - ​​Wonder Boy Balt Aoi!
Dialogue: 0,0:12:52.35,0:12:57.35,Default,,0,0,0,,Ал Норман Тарвер, жылан шұңқырынан шыққан өлтіруші!
Dialogue: 0,0:13:04.20,0:13:06.95,Default,,0,0,0,,Бұл Гекигод Валькири
Dialogue: 0,0:13:07.45,0:13:09.83,Default,,0,0,0,,Байланысты қабат бекітілді ме?
Dialogue: 0,0:13:10.49,0:13:12.12,Default,,0,0,0,,Заттардың қалай өзгергенін көрейік.
Dialogue: 0,0:13:13.25,0:13:14.50,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:13:14.83,0:13:16.58,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:13:17.04,0:13:19.75,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:20.63,0:13:22.63,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:13:24.63,0:13:26.59,Default,,0,0,0,,Екеуі бір уақытта атады!
Dialogue: 0,0:13:26.68,0:13:29.47,Default,,0,0,0,,Twin Nemesis - жоғарғы режим
Dialogue: 0,0:13:30.05,0:13:31.76,Default,,0,0,0,,Дәл Куза болжағандай.
Dialogue: 0,0:13:31.85,0:13:34.31,Default,,0,0,0,,Құдайға шабуыл жасаңыз Валькири таңғажайып жылдамдық!
Dialogue: 0,0:13:34.56,0:13:37.06,Default,,0,0,0,,Валькири Кеттік!
Dialogue: 0,0:13:38.35,0:13:40.02,Default,,0,0,0,,Немесс Додж!
Dialogue: 0,0:13:44.11,0:13:44.99,Default,,0,0,0,,Ах
Dialogue: 0,0:13:45.07,0:13:45.95,Default,,0,0,0,,Ах
Dialogue: 0,0:13:47.95,0:13:49.74,Default,,0,0,0,,Тек күш жақсы көрінеді.
Dialogue: 0,0:13:49.99,0:13:53.20,Default,,0,0,0,,Валькири шабуылдары, Немесис қашуды жалғастыруда
Dialogue: 0,0:13:54.25,0:13:59.12,Default,,0,0,0,,Бұл адам Құдай Валькиридің әлсіз жақтарын көре алады.
Dialogue: 0,0:13:59.21,0:14:00.38,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:00.92,0:14:02.63,Default,,0,0,0,,Мен оны тез аяқтауым керек.
Dialogue: 0,0:14:02.71,0:14:04.21,Default,,0,0,0,,Валькирияның күші...
Dialogue: 0,0:14:05.80,0:14:07.42,Default,,0,0,0,,Енді, Немесис!
Dialogue: 0,0:14:07.68,0:14:09.47,Default,,0,0,0,,Үстіңгі қисық!
Dialogue: 0,0:14:12.30,0:14:13.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:15.85,0:14:19.19,Default,,0,0,0,,Егіз жаудан жоғары Финиш 1 ұпай
Dialogue: 0,0:14:19.44,0:14:22.06,Default,,0,0,0,,Валькирия құдайы дегеніміз не?
Dialogue: 0,0:14:22.77,0:14:25.61,Default,,0,0,0,,Ол әлсіз жақтарға толы емес пе?
Dialogue: 0,0:14:25.69,0:14:28.40,Default,,0,0,0,,Қарғыс атқыр... Келесі жолы міндетті түрде жеңемін!
Dialogue: 0,0:14:29.03,0:14:31.24,Default,,0,0,0,,Бірақ күшті бағаламауға болмайды.
Dialogue: 0,0:14:31.37,0:14:33.74,Default,,0,0,0,,Мен абай боламын, иә?
Dialogue: 0,0:14:34.12,0:14:35.87,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:14:39.54,0:14:41.83,Default,,0,0,0,,Содан кейін Smash режиміне көшейік
Dialogue: 0,0:14:42.75,0:14:43.79,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:14:44.38,0:14:46.96,Default,,0,0,0,,Валькири Бұл жолы жасайық
Dialogue: 0,0:14:47.46,0:14:48.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:49.43,0:14:52.30,Default,,0,0,0,,Мен Байдың дауысын естимін.
Dialogue: 0,0:14:53.10,0:14:56.14,Default,,0,0,0,,Балто Валькиридің дауысын тыңдап тұр
Dialogue: 0,0:14:57.39,0:14:58.93,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:14:59.39,0:15:02.19,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:02.94,0:15:05.02,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:07.23,0:15:11.45,Default,,0,0,0,,Құдай Валькири бірінші шайқасы сияқты траектория
Dialogue: 0,0:15:11.53,0:15:14.83,Default,,0,0,0,,Twin Nemesis қайтадан қашуды жалғастыруда!
Dialogue: 0,0:15:15.28,0:15:16.99,Default,,0,0,0,,Қанша талпынсам да пайдасы жоқ.
Dialogue: 0,0:15:17.12,0:15:18.29,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:18.62,0:15:19.96,Default,,0,0,0,,Бұрынғыдай
Dialogue: 0,0:15:20.04,0:15:21.87,Default,,0,0,0,,Импульсті жоғалту
Dialogue: 0,0:15:25.75,0:15:28.17,Default,,0,0,0,,Немесисті аяқтаңыз!
Dialogue: 0,0:15:31.22,0:15:33.80,Default,,0,0,0,,Құдай қайта жүктесін!
Dialogue: 0,0:15:37.01,0:15:38.27,Default,,0,0,0,,шықты!
Dialogue: 0,0:15:38.35,0:15:39.68,Default,,0,0,0,,Құдай қайта жүктесін!
Dialogue: 0,0:15:39.98,0:15:41.39,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,0:15:42.14,0:15:43.94,Default,,0,0,0,,Егіз жау!
Dialogue: 0,0:15:51.74,0:15:53.70,Default,,0,0,0,,Оны лақтырып жіберді!
Dialogue: 0,0:15:54.70,0:15:56.37,Default,,0,0,0,,Балғаны ұрыңыз!
Dialogue: 0,0:15:56.74,0:15:58.20,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:15:59.37,0:16:01.08,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:16:05.08,0:16:07.34,Default,,0,0,0,,Бұл соққы сізді өлтіреді.
Dialogue: 0,0:16:07.75,0:16:10.38,Default,,0,0,0,,Құдай жарсын!
Dialogue: 0,0:16:10.51,0:16:12.34,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:16:20.10,0:16:21.56,Default,,0,0,0,,Не... сонда...
Dialogue: 0,0:16:22.73,0:16:25.23,Default,,0,0,0,,God Valkyrie Burst Finish
Dialogue: 0,0:16:25.69,0:16:29.27,Default,,0,0,0,,2-ден 1 ұпайға дейінгі жеңімпаз: Барто Аои!
Dialogue: 0,0:16:29.36,0:16:31.65,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:32.19,0:16:34.11,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:16:34.20,0:16:37.66,Default,,0,0,0,,God Slash Бұл күшті қадам!
Dialogue: 0,0:16:37.74,0:16:40.37,Default,,0,0,0,,Валькири жаңа күшке ие болды.
Dialogue: 0,0:16:41.12,0:16:42.83,Default,,0,0,0,,Құдайдың кесу
Dialogue: 0,0:16:42.91,0:16:45.58,Default,,0,0,0,,Валькири күшейе түсуде.
Dialogue: 0,0:16:47.54,0:16:48.84,Default,,0,0,0,,Балто!
Dialogue: 0,0:16:49.17,0:16:50.09,Default,,0,0,0,,Ах
Dialogue: 0,0:16:51.05,0:16:52.51,Default,,0,0,0,,Балто Сіз жасадыңыз!
Dialogue: 0,0:16:52.92,0:16:55.26,Default,,0,0,0,,Арттағы жеңіс керемет болды!
Dialogue: 0,0:16:55.97,0:16:57.89,Default,,0,0,0,,Мұның бәрі Кузамен арнайы дайындықтың арқасында.
Dialogue: 0,0:16:58.51,0:16:59.51,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:16:59.60,0:17:00.93,Default,,0,0,0,,(Иида) Ол тым жылдам — ілесе алмаймын!
Dialogue: 0,0:17:01.35,0:17:02.73,Default,,0,0,0,,Иә? хехехе
Dialogue: 0,0:17:02.81,0:17:06.44,Default,,0,0,0,,Ах Какко Йо Катта Какко Йо Катта!
Dialogue: 0,0:17:09.06,0:17:11.94,Default,,0,0,0,,Қызылша Кукулканның жарылуы
Dialogue: 0,0:17:12.03,0:17:14.32,Default,,0,0,0,,Курц Баратьенің жеңісі!
Dialogue: 0,0:17:14.40,0:17:16.82,Default,,0,0,0,,Жер асты әлемінің императоры тірі және аман!
Dialogue: 0,0:17:16.91,0:17:18.03,Default,,0,0,0,,Керемет
Dialogue: 0,0:17:21.37,0:17:23.29,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:17:23.37,0:17:26.25,Default,,0,0,0,,Экскалибур айуандықпен жарылды
Dialogue: 0,0:17:26.33,0:17:29.21,Default,,0,0,0,,Тым күшті, Ширасаги қамал Руи
Dialogue: 0,0:17:30.79,0:17:33.05,Default,,0,0,0,,Гений аяқтайды
Dialogue: 0,0:17:33.13,0:17:34.84,Default,,0,0,0,,Бұл супер жұлдыз
Dialogue: 0,0:17:34.92,0:17:38.05,Default,,0,0,0,,Джошуа Бунның шынайы қабілеті.
Dialogue: 0,0:17:38.39,0:17:41.47,Default,,0,0,0,,Енді бүгінгі соңғы шайқас...
Dialogue: 0,0:17:41.56,0:17:44.14,Default,,0,0,0,,BC Sol командаластарының қарсыласуы
Dialogue: 0,0:17:44.22,0:17:48.35,Default,,0,0,0,,Cisco Carlyle қарсы. Тегін Де Ла Хойя!
Dialogue: 0,0:17:48.65,0:17:52.07,Default,,0,0,0,,Тегін Cisco, бар күшіңізді салыңыз!
Dialogue: 0,0:17:52.44,0:17:55.32,Default,,0,0,0,,Тегін Бүгін мен сені жылатамын
Dialogue: 0,0:17:55.57,0:17:56.74,Default,,0,0,0,,Жыламайтын шығар
Dialogue: 0,0:17:56.82,0:17:58.61,Default,,0,0,0,,Жылау (еркін) Жылама
Dialogue: 0,0:17:59.20,0:18:00.62,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:18:00.82,0:18:02.53,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:03.24,0:18:06.08,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:06.71,0:18:08.83,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:10.50,0:18:13.13,Default,,0,0,0,,Екеуі де стадионға секірді!
Dialogue: 0,0:18:13.21,0:18:17.13,Default,,0,0,0,,О! ? Жыла, Шайтан, сенде әдеттегідей серпін жоқ.
Dialogue: 0,0:18:17.22,0:18:18.80,Default,,0,0,0,,Бұл қате атылды ма?
Dialogue: 0,0:18:19.47,0:18:20.30,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:18:22.93,0:18:25.39,Default,,0,0,0,,Қате түсті ме? Шынайы!
Dialogue: 0,0:18:25.47,0:18:27.10,Default,,0,0,0,,Фофофу~
Dialogue: 0,0:18:27.48,0:18:29.60,Default,,0,0,0,,Ол осыны ойлап отырды.
Dialogue: 0,0:18:29.69,0:18:30.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:30.98,0:18:32.69,Default,,0,0,0,,Бұл Cisco жоспары.
Dialogue: 0,0:18:32.77,0:18:34.07,Default,,0,0,0,,Саксендайо
Dialogue: 0,0:18:34.40,0:18:36.69,Default,,0,0,0,,Шайтанның айналуы тым баяу
Dialogue: 0,0:18:36.78,0:18:38.90,Default,,0,0,0,,Фафнир энергияны сіңіре алмайды.
Dialogue: 0,0:18:38.99,0:18:41.45,Default,,0,0,0,,Керісінше, шайтан оны сіңіріп жатыр!
Dialogue: 0,0:18:41.53,0:18:44.33,Default,,0,0,0,,Сіз әдейі әлсіз соққы жасадыңыз.
Dialogue: 0,0:18:45.16,0:18:47.16,Default,,0,0,0,,Ғажайып ғажайып!
Dialogue: 0,0:18:47.25,0:18:50.33,Default,,0,0,0,,Бұл төзімділік шайқасына айналды!
Dialogue: 0,0:18:50.83,0:18:52.96,Default,,0,0,0,,Бұл күресудің қызықты тәсілі.
Dialogue: 0,0:18:53.63,0:18:56.26,Default,,0,0,0,,Теме жан-жақты зерттелген.
Dialogue: 0,0:18:56.71,0:18:57.76,Default,,0,0,0,,Хмм.
Dialogue: 0,0:18:58.17,0:18:59.76,Default,,0,0,0,,Жақсы оқыдың ба?
Dialogue: 0,0:19:00.22,0:19:03.39,Default,,0,0,0,,Шайтанның да, Фафнирдің де айналуы әлсірейді.
Dialogue: 0,0:19:03.47,0:19:05.10,Default,,0,0,0,,Не болады!
Dialogue: 0,0:19:08.43,0:19:10.19,Default,,0,0,0,,Ал, не болады? Не болады?
Dialogue: 0,0:19:10.27,0:19:13.11,Default,,0,0,0,,Ой! Шайтан сәл ертерек тоқтайды!
Dialogue: 0,0:19:13.19,0:19:13.90,Default,,0,0,0,,На
Dialogue: 0,0:19:14.52,0:19:18.24,Default,,0,0,0,,Ағызу Fafnir Spin Finish 1 ұпай
Dialogue: 0,0:19:19.36,0:19:23.20,Default,,0,0,0,,Тегін Де Ла Хойя 1 ұпаймен жеңеді!
Dialogue: 0,0:19:23.78,0:19:26.91,Default,,0,0,0,,Зерттеу жеткіліксіз болған сияқты.
Dialogue: 0,0:19:27.37,0:19:29.96,Default,,0,0,0,,Cisco стратегиясы жақсы болды.
Dialogue: 0,0:19:30.21,0:19:31.79,Default,,0,0,0,,Бұл тегін бе?
Dialogue: 0,0:19:31.87,0:19:32.79,Default,,0,0,0,,
Dialogue: 0,0:19:33.29,0:19:35.54,Default,,0,0,0,,Шулы сары тау! Ауызыңды жап!
Dialogue: 0,0:19:36.09,0:19:37.05,Default,,0,0,0,,Не!
Dialogue: 0,0:19:37.13,0:19:38.51,Default,,0,0,0,,Неліктен естідің?
Dialogue: 0,0:19:38.59,0:19:40.01,Default,,0,0,0,,Джигоку құлақтары
Dialogue: 0,0:19:41.01,0:19:42.05,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:19:42.47,0:19:44.72,Default,,0,0,0,,Менің стратегиям дұрыс емес.
Dialogue: 0,0:19:45.64,0:19:48.10,Default,,0,0,0,,Бұл оны жеңудің жалғыз жолы
Dialogue: 0,0:19:49.27,0:19:50.77,Default,,0,0,0,,Біз оны еңсереміз!
Dialogue: 0,0:19:51.02,0:19:52.73,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:19:53.27,0:19:55.94,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:56.65,0:19:58.61,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:59.03,0:20:00.03,Default,,0,0,0,,Жылайды!
Dialogue: 0,0:20:01.11,0:20:04.41,Default,,0,0,0,,Енді Шайтан бұрынғыдай стратегияны қолдана ма?
Dialogue: 0,0:20:04.66,0:20:08.91,Default,,0,0,0,,Екінші жағынан, Фафнир соқпайды!
Dialogue: 0,0:20:09.41,0:20:10.20,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:20:10.75,0:20:15.17,Default,,0,0,0,,Фафнир Шайтаннан жалтарып, баяу қарқынмен айналамын.
Dialogue: 0,0:20:15.67,0:20:17.63,Default,,0,0,0,,Иә, бұл туралы не деуге болады?
Dialogue: 0,0:20:17.96,0:20:22.17,Default,,0,0,0,,Шайтан Фафнирден айналу күшін ұрлау стратегиясын пайдалана алмайды.
Dialogue: 0,0:20:22.51,0:20:24.76,Default,,0,0,0,,Күтілгендей, бұл тегін.
Dialogue: 0,0:20:24.84,0:20:26.39,Default,,0,0,0,,Жауап жылдам.
Dialogue: 0,0:20:26.55,0:20:28.26,Default,,0,0,0,,О, не!
Dialogue: 0,0:20:28.35,0:20:32.06,Default,,0,0,0,,Мен Фафнирге соқтығыспайтын сияқтымын!
Dialogue: 0,0:20:32.48,0:20:33.77,Default,,0,0,0,,Оу, бұ да керемет екен. Сендер тез жеп қойыңдар.
Dialogue: 0,0:20:34.19,0:20:36.48,Default,,0,0,0,,Қазір тегін қоңырау шалыңыз!
Dialogue: 0,0:20:36.86,0:20:37.73,Default,,0,0,0,,Иә
Dialogue: 0,0:20:38.11,0:20:41.15,Default,,0,0,0,,Ах! Бұл тағы да төзімділік шайқасы.
Dialogue: 0,0:20:41.36,0:20:45.66,Default,,0,0,0,,Мм... Бұл... Мм... Мен қазірдің өзінде шағып жатырмын!
Dialogue: 0,0:20:45.74,0:20:46.78,Default,,0,0,0,,Мм!
Dialogue: 0,0:20:47.24,0:20:49.33,Default,,0,0,0,,Уау! (сыбырлаған дыбыс)
Dialogue: 0,0:20:49.62,0:20:51.70,Default,,0,0,0,,Бұл тітіркендіргіш.
Dialogue: 0,0:20:51.79,0:20:52.83,Default,,0,0,0,,Мен де
Dialogue: 0,0:20:53.04,0:20:54.16,Default,,0,0,0,,Не болады?
Dialogue: 0,0:20:54.67,0:20:56.00,Default,,0,0,0,,Фуфу~
Dialogue: 0,0:20:56.54,0:21:01.80,Default,,0,0,0,,Енді екеуіміз де серпін жоғалттық. Осылай аяқтала ма?
Dialogue: 0,0:21:01.88,0:21:04.84,Default,,0,0,0,,Сәлем Корра! Мәңгілікке қашпа!
Dialogue: 0,0:21:05.13,0:21:06.76,Default,,0,0,0,,Онда барамыз ба?
Dialogue: 0,0:21:07.22,0:21:08.35,Default,,0,0,0,,Не?
Dialogue: 0,0:21:10.26,0:21:11.22,Default,,0,0,0,,
Dialogue: 0,0:21:24.57,0:21:26.15,Default,,0,0,0,,А... күте тұрыңыз.
Dialogue: 0,0:21:26.41,0:21:27.57,Default,,0,0,0,,Қазір не болды?
Dialogue: 0,0:21:28.20,0:21:29.24,Default,,0,0,0,,Мен оны аяқтадым.
Dialogue: 0,0:21:30.33,0:21:33.25,Default,,0,0,0,,Ағызу Fafnir Spin Finish
Dialogue: 0,0:21:33.70,0:21:35.41,Default,,0,0,0,,Жеңімпаз тегін Де Ла Хойя
Dialogue: 0,0:21:37.71,0:21:42.55,Default,,0,0,0,,Тегін Де Ла Хойя Жеңілсіз қатарынан үш жеңіс!
Dialogue: 0,0:21:43.17,0:21:44.42,Default,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,0:21:47.55,0:21:50.97,Default,,0,0,0,,Уф... фуууууууууу...
Dialogue: 0,0:21:51.26,0:21:54.89,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:21:55.60,0:21:56.60,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.60,0:22:00.11,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.60,0:22:00.11,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, бұлшық еттеріңді жаттығып жатырсыңдар ма?
Dialogue: 0,0:22:00.19,0:22:03.07,Default,,0,0,0,,Енді, күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:03.15,0:22:07.03,Default,,0,0,0,,Қозғалыс 1-нұсқаға қарағанда қарқындырақ. Алдымен алдыңғы эпизодты және көрсетілім уақытын қарастырайық.
Dialogue: 0,0:22:07.11,0:22:10.74,Default,,0,0,0,,GO Shoot GO Shoot Great Shoot!
Dialogue: 0,0:22:10.82,0:22:14.37,Default,,0,0,0,,GO Shoot GO Shoot Жылдамдату!
Dialogue: 0,0:22:14.45,0:22:18.08,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:18.17,0:22:21.59,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:21.67,0:22:24.92,Default,,0,0,0,,Хахахаха Бұл жақсы емес пе? Негізгі түсірілім тамаша.
Dialogue: 0,0:22:25.01,0:22:28.93,Default,,0,0,0,,Бірақ бұл жерден күшейе түседі, мен қолдарымды және кернеуімді күшейтемін.
Dialogue: 0,0:22:29.01,0:22:32.85,Default,,0,0,0,,GO ату GO ату Бей бұлшық еттерінің жаттықтырушысы Моримори
Dialogue: 0,0:22:32.93,0:22:36.56,Default,,0,0,0,,АЛДЫМ АТТЫ БАР АТТЫ Менің атысым – құдайдың атысы
Dialogue: 0,0:22:36.64,0:22:40.27,Default,,0,0,0,,Оңға ату Солға ату Оңға ату
Dialogue: 0,0:22:40.35,0:22:43.90,Default,,0,0,0,,Сол жақ ату Оң жақ ату Сол жақта ату
Dialogue: 0,0:22:43.98,0:22:47.61,Default,,0,0,0,,Өткен аптада Осы аптада GO түсірілімін жасап жатырмыз
Dialogue: 0,0:22:47.69,0:22:51.49,Default,,0,0,0,,Осы аптада келесі аптада GO түсіру, ол да жасайды
Dialogue: 0,0:22:51.57,0:22:55.33,Default,,0,0,0,,Күнделікті барлығы жасайтын GO ату жаттығуларын жасаңыз
Dialogue: 0,0:22:55.41,0:22:58.58,Default,,0,0,0,,Көктем/жаз/күз/қыс GO түсіру жыл бойы
Dialogue: 0,0:22:58.66,0:23:00.25,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:23:00.33,0:23:02.83,Default,,0,0,0,,Шығанақ бұлшықеттерін жаттықтыру үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.92,0:23:06.00,Default,,0,0,0,,Сол шиеленіспен шарықтау шегіне жетейік!
Dialogue: 0,0:23:06.09,0:23:09.76,Default,,0,0,0,,Ичи Ни Сан Ши GO түсіріліміне кірісіңіз!
Dialogue: 0,0:23:09.88,0:23:13.30,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Let's Go!
Dialogue: 0,0:23:13.51,0:23:17.18,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Кеттік!
Dialogue: 0,0:23:17.27,0:23:20.06,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:20.06,0:23:22.06,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:20.06,0:23:22.06,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.06,0:23:22.15,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.15,0:23:24.98,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.15,0:23:24.98,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:24.98,0:23:25.57,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.44,0:23:29.11,Default,,0,0,0,,Төртінші раундтағы қарсыластар анықталды
Dialogue: 0,0:23:29.44,0:23:33.41,Default,,0,0,0,,Финалдық турнирге өту үшін біз мұнда жеңіске жетуіміз керек.
Dialogue: 0,0:23:33.99,0:23:36.03,Default,,0,0,0,,Сезіммен жеңілсең, бітті.
Dialogue: 0,0:23:36.45,0:23:40.54,Default,,0,0,0,,Не! Менің Валькириім! Солай~
Dialogue: 0,0:23:41.25,0:23:43.67,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.83,0:23:45.34,Default,,0,0,0,,Жою құдайы Спригган!
Dialogue: 0,0:23:45.75,0:23:49.46,Default,,0,0,0,,Үш екі бір ату!
