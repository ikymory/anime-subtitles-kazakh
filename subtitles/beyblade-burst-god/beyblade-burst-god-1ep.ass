Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.08,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.13,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.39,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:19.93,0:00:24.44,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.02,0:00:29.90,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:32.53,0:00:35.91,Default,,0,0,0,,Уау~ Бұл керемет~
Dialogue: 0,0:00:35.99,0:00:38.53,Default,,0,0,0,,Аспан мен бұлттан басқа ештеңе жоқ~
Dialogue: 0,0:00:38.62,0:00:39.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:00:40.08,0:00:42.20,Default,,0,0,0,,Уау~ Бұл не?
Dialogue: 0,0:00:42.29,0:00:43.50,Default,,0,0,0,,Бұл НЛО емес!
Dialogue: 0,0:00:46.62,0:00:47.79,Default,,0,0,0,,…Бай?
Dialogue: 0,0:00:48.21,0:00:49.25,Default,,0,0,0,,Керемет
Dialogue: 0,0:00:49.75,0:00:52.26,Default,,0,0,0,,Қараңызшы, Валькири Бей ұшып келеді!
Dialogue: 0,0:00:52.55,0:00:54.88,Default,,0,0,0,,шығанақ ұшып келеді!
Dialogue: 0,0:00:57.72,0:00:59.26,Default,,0,0,0,,шығанақ...
Dialogue: 0,0:01:01.47,0:01:03.02,Default,,0,0,0,,Өте сүйкімді!
Dialogue: 0,0:01:03.85,0:01:06.94,Default,,0,0,0,,Мен және Валькири әлемге секірдік
Dialogue: 0,0:01:07.73,0:01:10.90,Default,,0,0,0,,Біздің жаңа маусым басталды!
Dialogue: 0,0:01:11.40,0:01:14.07,Default,,0,0,0,,♪~
Dialogue: 0,0:01:14.15,0:01:16.65,Default,,0,0,0,,ЖАРЫЛДЫҚ ЖАРЫЛДЫҚ ЖАРЫЛДЫҚ ЖАРЫЛДЫРУ! )
Dialogue: 0,0:01:16.74,0:01:19.12,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:19.20,0:01:21.74,Default,,0,0,0,,ЖАРЫЛДЫҚ ЖАРЫЛДЫҚ ЖАРЫЛДЫҚ БЕРІСТІК ФИНИШ! )
Dialogue: 0,0:01:21.83,0:01:24.16,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:24.25,0:01:25.83,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:25.91,0:01:30.09,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:31.04,0:01:35.80,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:35.88,0:01:40.39,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:40.89,0:01:45.64,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:01:45.73,0:01:50.65,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:01:50.73,0:01:55.61,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:01:55.69,0:02:00.62,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:00.70,0:02:04.04,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:04.12,0:02:06.16,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:06.25,0:02:08.29,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:08.37,0:02:10.67,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:10.75,0:02:12.96,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:13.04,0:02:14.21,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:14.30,0:02:15.71,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:15.80,0:02:18.34,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:18.42,0:02:24.47,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:24.56,0:02:28.81,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:28.89,0:02:31.77,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:31.86,0:02:34.23,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:34.32,0:02:36.61,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:36.69,0:02:38.74,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:38.74,0:02:40.66,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:38.74,0:02:40.66,Default,,0,0,0,,~♪
Dialogue: 0,0:02:41.66,0:02:44.99,Default,,0,0,0,,Әлемге! Валькирияның эволюциясы!
Dialogue: 0,0:02:48.37,0:02:51.67,Default,,0,0,0,,Осы уақытқа дейін келдіңіз!
Dialogue: 0,0:02:59.88,0:03:01.51,Default,,0,0,0,,Бірақ мұнда...
Dialogue: 0,0:03:01.84,0:03:05.85,Default,,0,0,0,,Қай жерде?
Dialogue: 0,0:03:09.89,0:03:13.73,Default,,0,0,0,,Валькирия Біз қайдамыз?
Dialogue: 0,0:03:15.06,0:03:17.69,Default,,0,0,0,,Эй, мына шығанақты көрсетші.
Dialogue: 0,0:03:20.28,0:03:22.16,Default,,0,0,0,,Уау! Бұл не?
Dialogue: 0,0:03:22.78,0:03:25.66,Default,,0,0,0,,Уау, сіз оны көп қолдандыңыз.
Dialogue: 0,0:03:26.08,0:03:26.95,Default,,0,0,0,,Ол күшті ме?
Dialogue: 0,0:03:27.04,0:03:29.66,Default,,0,0,0,,Әй, бұл күшті. Ол Валькирия деп аталады.
Dialogue: 0,0:03:30.41,0:03:32.00,Default,,0,0,0,,I Барто Аои
Dialogue: 0,0:03:32.08,0:03:34.88,Default,,0,0,0,,Б.э.д. Сольді Бей Клуб зерттеді.
Dialogue: 0,0:03:35.29,0:03:38.00,Default,,0,0,0,,Шынымен бе? Бұл өтірік емес пе?
Dialogue: 0,0:03:38.34,0:03:39.71,Default,,0,0,0,,Бұл өтірік емес
Dialogue: 0,0:03:39.80,0:03:43.55,Default,,0,0,0,,BC Sol оңай қосылатын команда емес.
Dialogue: 0,0:03:43.64,0:03:45.72,Default,,0,0,0,,Өйткені мен өте күштімін
Dialogue: 0,0:03:46.72,0:03:49.47,Default,,0,0,0,,Ммм, онда...
Dialogue: 0,0:03:49.56,0:03:50.85,Default,,0,0,0,,Мен жасап көремін!
Dialogue: 0,0:03:50.93,0:03:53.06,Default,,0,0,0,,Не? а! Эй!
Dialogue: 0,0:03:54.44,0:03:57.07,Default,,0,0,0,,Маған Валькириімді қайтарыңыз!
Dialogue: 0,0:03:57.15,0:03:58.69,Default,,0,0,0,,Күте алсаңыз!
Dialogue: 0,0:03:59.03,0:04:01.69,Default,,0,0,0,,Менің атым Кит. Сізбен танысқаныма қуаныштымын!
Dialogue: 0,0:04:03.20,0:04:05.45,Default,,0,0,0,,Міне, міне!
Dialogue: 0,0:04:08.03,0:04:09.66,Default,,0,0,0,,Ах! О!
Dialogue: 0,0:04:13.25,0:04:15.67,Default,,0,0,0,,(шығақтардың соқтығысқан дыбысы)
Dialogue: 0,0:04:16.17,0:04:19.75,Default,,0,0,0,,Бұл қаладағы қанаттылар әрқашан осында шайқасады.
Dialogue: 0,0:04:19.84,0:04:21.34,Default,,0,0,0,,Мұнда жоқ! Қайда ол?!
Dialogue: 0,0:04:21.42,0:04:23.17,Default,,0,0,0,,Пабло, сен тым күштісің.
Dialogue: 0,0:04:23.47,0:04:27.18,Default,,0,0,0,,Бұл Пабло, ол осы жерде ең күшті деп айтылады.
Dialogue: 0,0:04:27.89,0:04:30.39,Default,,0,0,0,,Әй, өнеріңді көрсетші, Аники.
Dialogue: 0,0:04:30.47,0:04:33.10,Default,,0,0,0,,Жарайды! Мен саған көрсетемін
Dialogue: 0,0:04:33.18,0:04:35.02,Default,,0,0,0,,Мен сенің қарсыласыңмын.
Dialogue: 0,0:04:36.77,0:04:41.44,Default,,0,0,0,,
Dialogue: 0,0:04:41.78,0:04:44.70,Default,,0,0,0,,Мен оны бұрын-соңды көрмегенмін, сондықтан ол бөтен адам шығар.
Dialogue: 0,0:04:45.99,0:04:47.74,Default,,0,0,0,,Осы Cisco
Dialogue: 0,0:04:47.82,0:04:50.79,Default,,0,0,0,,Мен бұл қалаға соғысуға келдім.
Dialogue: 0,0:04:50.87,0:04:55.16,Default,,0,0,0,,Осы Cry Шайтанның кереметтігін қадағалаңыз!
Dialogue: 0,0:04:55.54,0:04:57.08,Default,,0,0,0,,Күшті көрінеді...
Dialogue: 0,0:04:57.17,0:05:00.46,Default,,0,0,0,,Шайтан жылайды ма? Мен Бейді бірінші рет көріп тұрмын.
Dialogue: 0,0:05:01.00,0:05:03.80,Default,,0,0,0,,Үлкен аузыңды бейтаныс адам ұрмайды ма?
Dialogue: 0,0:05:03.88,0:05:06.47,Default,,0,0,0,,Менің ойымша, ол біраз қарсылық көрсетеді.
Dialogue: 0,0:05:06.63,0:05:09.18,Default,,0,0,0,,Көріп көрсеңіз түсінесіз
Dialogue: 0,0:05:09.64,0:05:11.14,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:05:11.22,0:05:14.85,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:14.93,0:05:17.15,Default,,0,0,0,,Барып ат!
Dialogue: 0,0:05:17.23,0:05:18.15,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:05:22.78,0:05:25.95,Default,,0,0,0,,Шабуыл! Шабуыл шабуыл шабуыл!
Dialogue: 0,0:05:26.20,0:05:28.36,Default,,0,0,0,,Сіз әлі де шабуылдауға тырысып жатырсыз ба?
Dialogue: 0,0:05:28.45,0:05:29.49,Default,,0,0,0,,Сатып алуға алданған адам – нағыз ақымақ
Dialogue: 0,0:05:30.07,0:05:33.37,Default,,0,0,0,,Сіз мүлдем жауап бермейсіз. Бұл бек күшті!
Dialogue: 0,0:05:33.45,0:05:35.00,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:05:35.29,0:05:38.46,Default,,0,0,0,,Crys Satan Defence түрі-
Dialogue: 0,0:05:38.54,0:05:41.25,Default,,0,0,0,,Қабатта 3 ролик бар
Dialogue: 0,0:05:43.17,0:05:46.38,Default,,0,0,0,,Түсіндім, сіз бұл роликті шабуылдарды болдырмау үшін пайдаланасыз ба?
Dialogue: 0,0:05:46.47,0:05:47.76,Default,,0,0,0,,Керемет!
Dialogue: 0,0:05:48.30,0:05:52.01,Default,,0,0,0,,Оны аяқтайтын кез келді, жыла Шайтан!
Dialogue: 0,0:05:52.10,0:05:53.72,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:05:54.10,0:05:55.22,Default,,0,0,0,,Уф…
Dialogue: 0,0:05:56.93,0:06:00.27,Default,,0,0,0,,Дағдарыс Шайтан жарылып жеңеді!
Dialogue: 0,0:06:01.31,0:06:04.11,Default,,0,0,0,,Ха! Бұдан күштісі бар емес пе?
Dialogue: 0,0:06:05.28,0:06:08.95,Default,,0,0,0,,Бұл қызықсыз. Мен жол бойы келдім.
Dialogue: 0,0:06:09.03,0:06:12.12,Default,,0,0,0,,Сәлем, сәлем! Мен, істе!
Dialogue: 0,0:06:13.49,0:06:16.62,Default,,0,0,0,,Сізбен шайқасқа, Cisco?
Dialogue: 0,0:06:17.16,0:06:18.50,Default,,0,0,0,,I Барто Аои
Dialogue: 0,0:06:18.58,0:06:21.50,Default,,0,0,0,,Мен бүгін Жапониядан осы қалаға келдім.
Dialogue: 0,0:06:21.75,0:06:24.00,Default,,0,0,0,,Бұл аниме өте күшті сияқты.
Dialogue: 0,0:06:24.09,0:06:26.51,Default,,0,0,0,,Оны В.С. Соль барлады.
Dialogue: 0,0:06:27.51,0:06:29.68,Default,,0,0,0,,BC Sol? Шынайы ма?
Dialogue: 0,0:06:29.76,0:06:31.18,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:06:32.05,0:06:35.35,Default,,0,0,0,,Жарайды, жасайық.
Dialogue: 0,0:06:35.52,0:06:36.52,Default,,0,0,0,,О!
Dialogue: 0,0:06:38.60,0:06:42.86,Default,,0,0,0,,Жүр, мен саған мына Crys Шайтанның олжасын көрсетейін.
Dialogue: 0,0:06:43.36,0:06:45.48,Default,,0,0,0,,Менің серіктесім - Валькири!
Dialogue: 0,0:06:45.57,0:06:46.86,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:06:48.95,0:06:52.62,Default,,0,0,0,,Уау, бұл өте жарқын.
Dialogue: 0,0:06:52.91,0:06:53.87,Default,,0,0,0,,Қайсысы...
Dialogue: 0,0:06:53.95,0:06:55.24,Default,,0,0,0,,Ой, мына шығанақ!
Dialogue: 0,0:06:56.29,0:06:58.25,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:58.50,0:07:02.25,Default,,0,0,0,,Ухахаха~ Хохохохо~
Dialogue: 0,0:07:02.33,0:07:06.17,Default,,0,0,0,,Аяқтау Айналдыру 1 ұпайға тең
Dialogue: 0,0:07:06.25,0:07:10.26,Default,,0,0,0,,Жедел мәре – 2 ұпай. Бірінші 2 ұпай алған жеңеді.
Dialogue: 0,0:07:10.93,0:07:13.72,Default,,0,0,0,,Б.С. Соль барлау үшін жеткілікті қуат.
Dialogue: 0,0:07:13.80,0:07:15.76,Default,,0,0,0,,Оның қанша екенін көрсетіңіз
Dialogue: 0,0:07:16.18,0:07:16.93,Default,,0,0,0,,О
Dialogue: 0,0:07:17.31,0:07:19.77,Default,,0,0,0,,Егер бұл хина шоколады болса, мен оны үрлеп жіберер едім!
Dialogue: 0,0:07:19.85,0:07:21.39,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:07:21.48,0:07:23.10,Default,,0,0,0,,Бірінші шайқас?
Dialogue: 0,0:07:23.19,0:07:24.27,Default,,0,0,0,,А... иә
Dialogue: 0,0:07:24.77,0:07:27.32,Default,,0,0,0,,Хехехе... көрсем болады ма?
Dialogue: 0,0:07:27.82,0:07:28.78,Default,,0,0,0,,Кім?
Dialogue: 0,0:07:29.44,0:07:30.74,Default,,0,0,0,,Бірінші шайқас!
Dialogue: 0,0:07:31.57,0:07:34.28,Default,,0,0,0,,Жарайды, Бакусу Шотпен барайық.
Dialogue: 0,0:07:37.24,0:07:38.79,Default,,0,0,0,,Бакусу атылды ма?
Dialogue: 0,0:07:45.04,0:07:46.13,Default,,0,0,0,,Жұмысты бастаңыз!
Dialogue: 0,0:07:46.42,0:07:47.63,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:07:48.30,0:07:51.17,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:52.34,0:07:54.97,Default,,0,0,0,,Барып ат!
Dialogue: 0,0:07:55.05,0:07:56.18,Default,,0,0,0,,Жылайды!
Dialogue: 0,0:08:02.39,0:08:04.69,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:08:04.81,0:08:06.56,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:08:07.77,0:08:12.24,Default,,0,0,0,,Ха! Мұндай ату Шайтанның роликтеріне қарсы жұмыс істемейді.
Dialogue: 0,0:08:14.95,0:08:17.41,Default,,0,0,0,,Сіз бұл дауысты естігіңіз келді
Dialogue: 0,0:08:19.54,0:08:21.20,Default,,0,0,0,,Біраз уақыт өтті!
Dialogue: 0,0:08:21.29,0:08:24.75,Default,,0,0,0,,Бейдің даусын осылай естідім! Хохохохо
Dialogue: 0,0:08:24.83,0:08:26.21,Default,,0,0,0,,Біртүрлі қарт
Dialogue: 0,0:08:29.42,0:08:33.01,Default,,0,0,0,,Сол көгілдір шығанақты бастаған кез келді.
Dialogue: 0,0:08:34.88,0:08:37.26,Default,,0,0,0,,Алға!
Dialogue: 0,0:08:42.23,0:08:43.56,Default,,0,0,0,,Жасайық
Dialogue: 0,0:08:44.14,0:08:47.65,Default,,0,0,0,,Олай болса, біз де осы жолмен жүрейік, Roller Drift!
Dialogue: 0,0:08:49.82,0:08:52.03,Default,,0,0,0,,Не! Әй, келдің бе?
Dialogue: 0,0:08:52.82,0:08:55.45,Default,,0,0,0,,Ал, роликтің жерге тиюі
Dialogue: 0,0:08:55.53,0:08:59.49,Default,,0,0,0,,Бір уақытта құлаудың алдын алады және қуат жоғалуын азайтады
Dialogue: 0,0:08:59.78,0:09:01.79,Default,,0,0,0,,Цикл драйвері керемет
Dialogue: 0,0:09:01.99,0:09:05.25,Default,,0,0,0,,Басқа адам да солай істейді! Фофофо
Dialogue: 0,0:09:05.58,0:09:07.92,Default,,0,0,0,,Шамамен! валкири
Dialogue: 0,0:09:10.59,0:09:13.92,Default,,0,0,0,,Сәлем! Оны доғар, Шайтан!
Dialogue: 0,0:09:20.01,0:09:21.47,Default,,0,0,0,,(Шайтанның айқайы)
Dialogue: 0,0:09:26.60,0:09:28.23,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:09:28.35,0:09:29.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:29.94,0:09:31.27,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:09:34.86,0:09:37.86,Default,,0,0,0,,Дағдарыс Шайтан жарылып аяқталды!
Dialogue: 0,0:09:37.95,0:09:39.95,Default,,0,0,0,,
Dialogue: 0,0:09:40.16,0:09:42.45,Default,,0,0,0,,BC Сольдің де осындай жүзі бар...
Dialogue: 0,0:09:42.54,0:09:45.16,Default,,0,0,0,,Барлаушы болу ұят.
Dialogue: 0,0:09:45.33,0:09:49.00,Default,,0,0,0,,Тағы да шайқасайық! Келесі жолы міндетті түрде жеңеміз!
Dialogue: 0,0:09:49.25,0:09:52.50,Default,,0,0,0,,Күшті болуға уақыт болса, Бейді уайымда.
Dialogue: 0,0:09:53.46,0:09:56.84,Default,,0,0,0,,Бағанаға соғылған кезде қатты шу шықты, солай ма?
Dialogue: 0,0:09:56.92,0:09:58.93,Default,,0,0,0,,Иә! Валькири?
Dialogue: 0,0:10:00.22,0:10:01.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:01.85,0:10:03.18,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:04.02,0:10:07.35,Default,,0,0,0,,Аа, енді төбелесудің қажеті жоқ.
Dialogue: 0,0:10:07.44,0:10:08.35,Default,,0,0,0,,Сатып алуға алданған адам – нағыз ақымақ
Dialogue: 0,0:10:08.44,0:10:11.27,Default,,0,0,0,,Мен тек шындықты айттым. Сонда кездескенше!
Dialogue: 0,0:10:11.61,0:10:14.19,Default,,0,0,0,,Қарғыс атсын... Валькири...
Dialogue: 0,0:10:14.28,0:10:15.15,Default,,0,0,0,,(Ходжинс) Бүгіннен бастап мен Автоматты жазу қуыршағының шәкірті болып жұмыс істеймін.
Dialogue: 0,0:10:15.99,0:10:19.49,Default,,0,0,0,,Осыншама қатты жерге тиіп кетсе, ауырған болуы керек...
Dialogue: 0,0:10:19.57,0:10:21.12,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:10:21.78,0:10:22.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:22.78,0:10:25.45,Default,,0,0,0,,Әй, ата, бұл менікі!
Dialogue: 0,0:10:25.54,0:10:26.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:26.87,0:10:28.87,Default,,0,0,0,,Джикча~н!
Dialogue: 0,0:10:29.96,0:10:32.88,Default,,0,0,0,,Ғажайып шығанақ Мен оны таптым
Dialogue: 0,0:10:32.96,0:10:34.84,Default,,0,0,0,,Fohohohonoho~
Dialogue: 0,0:10:34.92,0:10:36.13,Default,,0,0,0,,Бұл жақсы емес...
Dialogue: 0,0:10:38.51,0:10:40.34,Default,,0,0,0,,Ата, күте тұрыңыз!
Dialogue: 0,0:10:40.43,0:10:42.35,Default,,0,0,0,,Уау! Ой және тотто
Dialogue: 0,0:10:42.43,0:10:44.18,Default,,0,0,0,,Менің Валькириям!
Dialogue: 0,0:10:44.72,0:10:46.60,Default,,0,0,0,,Джичаан! а!
Dialogue: 0,0:10:47.14,0:10:50.98,Default,,0,0,0,,Аа, қайда бардың?
Dialogue: 0,0:10:51.19,0:10:52.86,Default,,0,0,0,,♪~
Dialogue: 0,0:11:06.16,0:11:08.16,Default,,0,0,0,,~♪
Dialogue: 0,0:11:08.87,0:11:10.96,Default,,0,0,0,,Жоқ, мен оны таба алмаймын.
Dialogue: 0,0:11:13.46,0:11:14.84,Default,,0,0,0,,Валькирия…
Dialogue: 0,0:11:16.59,0:11:19.84,Default,,0,0,0,,Балт, міндетті түрде үздік командаға қосыл!
Dialogue: 0,0:11:20.55,0:11:22.22,Default,,0,0,0,,Сіз міндетті түрде кіре аласыз.
Dialogue: 0,0:11:22.47,0:11:24.97,Default,,0,0,0,,Ах! Мен қатты жұмыс істеймін
Dialogue: 0,0:11:25.30,0:11:28.89,Default,,0,0,0,,Шу Нью-Йоркте командада қатты күресуде.
Dialogue: 0,0:11:29.02,0:11:30.35,Default,,0,0,0,,Жоғалту мүмкін емес
Dialogue: 0,0:11:30.43,0:11:31.39,Default,,0,0,0,,Жоғарыдағылар не ойлап отыр екен? Трост ауданына кіру – тек бекер өлімге апарады.
Dialogue: 0,0:11:31.81,0:11:32.56,Default,,0,0,0,,О!
Dialogue: 0,0:11:32.81,0:11:34.61,Default,,0,0,0,,А... Кумичо?
Dialogue: 0,0:11:36.52,0:11:39.15,Default,,0,0,0,,Кумичо жалғыз, солай емес пе?
Dialogue: 0,0:11:39.49,0:11:43.28,Default,,0,0,0,,Испанияға жеткенде саған хат жазамын.
Dialogue: 0,0:11:43.57,0:11:44.45,Default,,0,0,0,,Иә
Dialogue: 0,0:11:45.12,0:11:46.74,Default,,0,0,0,,Сіз маған электрондық пошта арқылы да жібере аласыз.
Dialogue: 0,0:11:46.83,0:11:48.54,Default,,0,0,0,,Маған күн сайын электрондық хат жіберіңіз.
Dialogue: 0,0:11:48.91,0:11:52.92,Default,,0,0,0,,Бұл өте қиын, мен мұны күнде істей алмаймын.
Dialogue: 0,0:11:53.33,0:11:55.00,Default,,0,0,0,,Сәлем? Кумичо
Dialogue: 0,0:11:55.96,0:11:57.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:58.84,0:12:00.09,Default,,0,0,0,,Маған электрондық хат жіберіңіз...
Dialogue: 0,0:12:00.88,0:12:02.68,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:12:04.30,0:12:05.47,Default,,0,0,0,,Кумичо
Dialogue: 0,0:12:06.05,0:12:07.68,Default,,0,0,0,,Келесі шайқасыңызда...
Dialogue: 0,0:12:08.22,0:12:10.43,Default,,0,0,0,,Кумичо оған мүлдем сәйкес келмейді.
Dialogue: 0,0:12:10.52,0:12:12.77,Default,,0,0,0,,Мен қатты күшейіп келемін!
Dialogue: 0,0:12:12.85,0:12:15.98,Default,,0,0,0,,Ақымақ болма! Мен күштірек болғанымды қалаймын
Dialogue: 0,0:12:16.48,0:12:19.48,Default,,0,0,0,,Бұл жолы сіз бөліктерге бөлінесіз.
Dialogue: 0,0:12:19.57,0:12:21.19,Default,,0,0,0,,Мен оны жұлып аламын
Dialogue: 0,0:12:21.74,0:12:23.07,Default,,0,0,0,,Кумичо…
Dialogue: 0,0:12:24.53,0:12:25.45,Default,,0,0,0,,Барт…
Dialogue: 0,0:12:28.03,0:12:30.45,Default,,0,0,0,,Мен жеңілмеймін!
Dialogue: 0,0:12:30.54,0:12:31.70,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:12:32.00,0:12:33.87,Default,,0,0,0,,Мен келемін!
Dialogue: 0,0:12:38.46,0:12:39.88,Default,,0,0,0,,(күлді)
Dialogue: 0,0:12:41.13,0:12:43.17,Default,,0,0,0,,Мен бәріне уәде берсем де
Dialogue: 0,0:12:43.92,0:12:44.93,Default,,0,0,0,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:12:45.63,0:12:46.59,Default,,0,0,0,,Му!
Dialogue: 0,0:12:46.80,0:12:49.14,Default,,0,0,0,,Бұл күйзеліске түсетін уақыт емес.
Dialogue: 0,0:12:49.39,0:12:51.14,Default,,0,0,0,,Аники!
Dialogue: 0,0:12:51.52,0:12:52.64,Default,,0,0,0,,Аники!
Dialogue: 0,0:12:52.73,0:12:53.52,Default,,0,0,0,,Жинақ?
Dialogue: 0,0:12:53.60,0:12:55.02,Default,,0,0,0,,Таптым! Таптым!
Dialogue: 0,0:12:55.39,0:12:56.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:56.31,0:12:57.69,Default,,0,0,0,,Мен атамды таптым
Dialogue: 0,0:12:58.02,0:12:59.36,Default,,0,0,0,,Дегенмен, мен әлі күн бойы Толық шоғырланған тыныс алуды ұстап тұра алмаймын.
Dialogue: 0,0:13:02.65,0:13:03.82,Default,,0,0,0,,Ішінде.
Dialogue: 0,0:13:03.90,0:13:04.78,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:13:09.20,0:13:11.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:12.87,0:13:14.16,Default,,0,0,0,,Сіз кешіктіңіз!
Dialogue: 0,0:13:14.75,0:13:17.42,Default,,0,0,0,,Бұл не? Валькири рұқсатсыз...
Dialogue: 0,0:13:17.50,0:13:19.92,Default,,0,0,0,,Иә? «Сіз кешіктіңіз»?
Dialogue: 0,0:13:20.29,0:13:22.92,Default,,0,0,0,,Мен жаңа ғана медициналық тексеруден өттім.
Dialogue: 0,0:13:23.63,0:13:24.88,Default,,0,0,0,,Шинсацу?
Dialogue: 0,0:13:24.97,0:13:27.43,Default,,0,0,0,,Мүмкін атам Бэй жаттықтырушы шығар?
Dialogue: 0,0:13:27.84,0:13:28.97,Default,,0,0,0,,Мен Зоромын
Dialogue: 0,0:13:29.05,0:13:32.43,Default,,0,0,0,,Сіз қалай қарасаңыз да, бұл таңғажайып дағдылары бар Bay Trainer болуы мүмкін.
Dialogue: 0,0:13:32.64,0:13:34.35,Default,,0,0,0,,Мүлдем көрінбейді
Dialogue: 0,0:13:34.85,0:13:36.64,Default,,0,0,0,,Бүйір жаттықтырушы дегеніміз не?
Dialogue: 0,0:13:36.73,0:13:41.02,Default,,0,0,0,,Шығанақты жөндейтін шығанақ дәрігері сияқты біреу.
Dialogue: 0,0:13:41.90,0:13:44.19,Default,,0,0,0,,Ах! Валькирия!
Dialogue: 0,0:13:44.28,0:13:45.95,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:13:46.32,0:13:48.41,Default,,0,0,0,,шығанақ зақымдалған.
Dialogue: 0,0:13:48.86,0:13:52.20,Default,,0,0,0,,Картопты үлкен эволюция кезеңі күтіп тұр деп айтуға болады.
Dialogue: 0,0:13:52.70,0:13:54.37,Default,,0,0,0,,«Эволюция уақыты»?
Dialogue: 0,0:13:54.45,0:13:55.83,Default,,0,0,0,,Фохохохо~
Dialogue: 0,0:13:55.91,0:13:58.33,Default,,0,0,0,,Бейдің дауысын естімей тұрсың ба?
Dialogue: 0,0:13:58.42,0:13:59.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:59.33,0:14:01.00,Default,,0,0,0,,Құлағыңызды жабыңыз!
Dialogue: 0,0:14:04.59,0:14:06.84,Default,,0,0,0,,Мен ештеңе естімеймін
Dialogue: 0,0:14:07.80,0:14:08.84,Default,,0,0,0,,Валькирия?
Dialogue: 0,0:14:09.59,0:14:11.05,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:14:11.60,0:14:13.56,Default,,0,0,0,,Көріп тұрмын, естимін.
Dialogue: 0,0:14:13.64,0:14:15.31,Default,,0,0,0,,Сіз өзіңізді дамытқыңыз келетінін айтасыз.
Dialogue: 0,0:14:15.72,0:14:18.52,Default,,0,0,0,,Фохохо~ Бір шымшым - бұл мүмкіндік
Dialogue: 0,0:14:18.60,0:14:21.40,Default,,0,0,0,,Енді бұл шығанақты дамытатын уақыт.
Dialogue: 0,0:14:21.94,0:14:23.61,Default,,0,0,0,,«Шымшу – бұл мүмкіндік»…
Dialogue: 0,0:14:24.11,0:14:26.49,Default,,0,0,0,,Жарайды, жасайық.
Dialogue: 0,0:14:27.82,0:14:31.74,Default,,0,0,0,,Хмм, ең жақсы эволюция...
Dialogue: 0,0:14:31.91,0:14:34.08,Default,,0,0,0,,Хмм, бұл басқаша...
Dialogue: 0,0:14:34.54,0:14:36.83,Default,,0,0,0,,Шеше алмайсыз ба? жаңа пішін
Dialogue: 0,0:14:37.25,0:14:41.71,Default,,0,0,0,,Ах! Мынадай нәрсе...
Dialogue: 0,0:14:45.42,0:14:49.13,Default,,0,0,0,,Гагагагага! Міне осы!
Dialogue: 0,0:14:49.55,0:14:51.89,Default,,0,0,0,,Не, бұл өте жаман!
Dialogue: 0,0:14:51.97,0:14:53.01,Default,,0,0,0,,Күлме!
Dialogue: 0,0:14:53.10,0:14:55.56,Default,,0,0,0,,Себебі~ хахахаха
Dialogue: 0,0:14:55.64,0:14:56.64,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:14:56.97,0:14:59.02,Default,,0,0,0,,Қызық екен
Dialogue: 0,0:14:59.10,0:15:00.39,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:15:00.69,0:15:01.81,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:15:01.90,0:15:02.69,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:15:03.19,0:15:05.07,Default,,0,0,0,,Мынаны сканерлеу...
Dialogue: 0,0:15:05.15,0:15:05.94,Default,,0,0,0,,Йошито
Dialogue: 0,0:15:07.69,0:15:10.95,Default,,0,0,0,,Енді ол қандай пішінге ие болады?
Dialogue: 0,0:15:11.82,0:15:14.20,Default,,0,0,0,,Китар! о!
Dialogue: 0,0:15:14.45,0:15:16.45,Default,,0,0,0,,Мынау! Мінеки біз!
Dialogue: 0,0:15:16.62,0:15:17.66,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:15:18.62,0:15:19.83,Default,,0,0,0,,Міне
Dialogue: 0,0:15:19.91,0:15:22.25,Default,,0,0,0,,Мен іздеген шығанақ!
Dialogue: 0,0:15:22.75,0:15:24.75,Default,,0,0,0,,♪~
Dialogue: 0,0:15:28.59,0:15:30.59,Default,,0,0,0,,(Йосецу дыбысы)
Dialogue: 0,0:15:49.61,0:15:51.61,Default,,0,0,0,,~♪
Dialogue: 0,0:15:51.70,0:15:53.41,Default,,0,0,0,,Дайын!
Dialogue: 0,0:15:53.49,0:15:55.74,Default,,0,0,0,,Иә? Сіз оны жасадыңыз ба?
Dialogue: 0,0:15:56.08,0:15:57.83,Default,,0,0,0,,А, мен жасадым!
Dialogue: 0,0:15:58.04,0:15:59.70,Default,,0,0,0,,Бұл қабат
Dialogue: 0,0:15:59.87,0:16:02.25,Default,,0,0,0,,Бұл диск және драйвер
Dialogue: 0,0:16:02.71,0:16:05.38,Default,,0,0,0,,6V дискі және драйверді қайта жүктеңіз
Dialogue: 0,0:16:05.46,0:16:10.01,Default,,0,0,0,,Мен оны қосу үшін көптен бері қабат іздеп жүрмін.
Dialogue: 0,0:16:11.88,0:16:13.59,Default,,0,0,0,,Рахмет, ата!
Dialogue: 0,0:16:13.76,0:16:17.51,Default,,0,0,0,,Қайта туған биге жаңа есім бер.
Dialogue: 0,0:16:18.10,0:16:19.89,Default,,0,0,0,,Жаңа есім?
Dialogue: 0,0:16:20.18,0:16:21.60,Default,,0,0,0,,Не істеу керек? Аники
Dialogue: 0,0:16:22.10,0:16:22.98,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:23.39,0:16:25.02,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:16:25.48,0:16:26.44,Default,,0,0,0,,Құдай…
Dialogue: 0,0:16:28.19,0:16:29.90,Default,,0,0,0,,Құдай Валькирия!
Dialogue: 0,0:16:34.82,0:16:36.95,Default,,0,0,0,,Cisco күтіңіз!
Dialogue: 0,0:16:37.95,0:16:39.45,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:39.54,0:16:40.95,Default,,0,0,0,,Тағы да жарысайық!
Dialogue: 0,0:16:41.37,0:16:43.91,Default,,0,0,0,,Иә? Сіз тағы соққы алу үшін келдіңіз бе?
Dialogue: 0,0:16:44.29,0:16:46.29,Default,,0,0,0,,Бұл жолы бұрынғыдай болмайды
Dialogue: 0,0:16:46.38,0:16:48.29,Default,,0,0,0,,Менің Валькириям дамыды.
Dialogue: 0,0:16:49.13,0:16:50.30,Default,,0,0,0,,Эволюция?
Dialogue: 0,0:16:51.05,0:16:53.26,Default,,0,0,0,,Жарайды, мен істеймін.
Dialogue: 0,0:16:56.09,0:16:57.80,Default,,0,0,0,,Қарсыласыңыздың шығанағын тексеріңіз
Dialogue: 0,0:16:59.76,0:17:01.47,Default,,0,0,0,,Екі қабат
Dialogue: 0,0:17:01.93,0:17:03.98,Default,,0,0,0,,Ол қозғалады ма? Және-
Dialogue: 0,0:17:04.94,0:17:07.69,Default,,0,0,0,,6 жүзді диск... Мына бұрағыш ше?
Dialogue: 0,0:17:08.61,0:17:10.27,Default,,0,0,0,,Шайтан жылайды
Dialogue: 0,0:17:10.36,0:17:12.48,Default,,0,0,0,,Роликтен қорғаныстың қорғаныс түрі
Dialogue: 0,0:17:13.49,0:17:14.57,Default,,0,0,0,,Оны қалай бұзуға болады?
Dialogue: 0,0:17:15.03,0:17:16.16,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,0:17:16.24,0:17:17.53,Default,,0,0,0,,А, бұл да.
Dialogue: 0,0:17:17.95,0:17:20.12,Default,,0,0,0,,Мен оның қандай эволюция жасайтынын асыға күтемін.
Dialogue: 0,0:17:20.20,0:17:20.99,Default,,0,0,0,,Иә
Dialogue: 0,0:17:21.08,0:17:23.00,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:17:23.58,0:17:24.71,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:17:27.42,0:17:29.96,Default,,0,0,0,,Иә! Бұл жолы неге жүгірмейсің?
Dialogue: 0,0:17:32.00,0:17:35.22,Default,,0,0,0,,Құдай Валькириді меңгергенше
Dialogue: 0,0:17:35.30,0:17:37.51,Default,,0,0,0,,Алдымен шығанақтың ерекшеліктерін түсініңіз.
Dialogue: 0,0:17:37.59,0:17:40.22,Default,,0,0,0,,Беймен бір болу маңызды.
Dialogue: 0,0:17:40.80,0:17:44.22,Default,,0,0,0,,Валькирия Мен сенімен жақсы танысқанша.
Dialogue: 0,0:17:44.31,0:17:46.73,Default,,0,0,0,,Бакусу атыпты Мен жарып жіберемін
Dialogue: 0,0:17:47.14,0:17:48.77,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:17:49.19,0:17:52.36,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:52.48,0:17:54.36,Default,,0,0,0,,Барып ат!
Dialogue: 0,0:17:54.44,0:17:55.49,Default,,0,0,0,,Жылайды!
Dialogue: 0,0:17:58.99,0:18:00.99,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:18:07.37,0:18:09.50,Default,,0,0,0,,Валькири шынымен ашуланып жатыр
Dialogue: 0,0:18:09.75,0:18:11.34,Default,,0,0,0,,Бұл бақылаудан тыс.
Dialogue: 0,0:18:11.79,0:18:13.84,Default,,0,0,0,,Ораора, қайтып орал!
Dialogue: 0,0:18:13.92,0:18:16.13,Default,,0,0,0,,Роликтен қорғаныс
Dialogue: 0,0:18:20.30,0:18:23.47,Default,,0,0,0,,Шайтанның роликтері барлық шабуылдарды жоққа шығарады.
Dialogue: 0,0:18:23.56,0:18:25.39,Default,,0,0,0,,Бұған шыдамыңыз жетпейді.
Dialogue: 0,0:18:32.02,0:18:35.86,Default,,0,0,0,,Аяқтау Crys Satan 1 ұпай
Dialogue: 0,0:18:37.57,0:18:40.91,Default,,0,0,0,,Бұл эволюция ма? Бұл үлкен мәселе емес
Dialogue: 0,0:18:41.12,0:18:43.12,Default,,0,0,0,,Шайқас әлі аяқталған жоқ.
Dialogue: 0,0:18:44.08,0:18:45.12,Default,,0,0,0,,Екінші шайқас!
Dialogue: 0,0:18:45.66,0:18:46.66,Default,,0,0,0,,Валькирия
Dialogue: 0,0:18:46.75,0:18:49.62,Default,,0,0,0,,Не істегіңіз келетіні туралы көбірек айтыңыз.
Dialogue: 0,0:18:50.12,0:18:53.34,Default,,0,0,0,,Олай болса Байдың даусын тыңда.
Dialogue: 0,0:18:57.71,0:19:01.64,Default,,0,0,0,,Құдай Валькири жақсы! Қаттырақ болыңыз!
Dialogue: 0,0:19:01.89,0:19:03.55,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:19:05.85,0:19:09.06,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:09.60,0:19:11.60,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:11.69,0:19:12.60,Default,,0,0,0,,Жылайды!
Dialogue: 0,0:19:21.86,0:19:23.82,Default,,0,0,0,,Жабайы жүр, Валькири!
Dialogue: 0,0:19:28.87,0:19:30.71,Default,,0,0,0,,Жақсы, көбірек!
Dialogue: 0,0:19:34.00,0:19:35.84,Default,,0,0,0,,Валькири итеріп жатыр
Dialogue: 0,0:19:38.76,0:19:41.47,Default,,0,0,0,,Уау! Байланысты қабат күшті
Dialogue: 0,0:19:41.80,0:19:45.43,Default,,0,0,0,,(сықырған дыбыс)
Dialogue: 0,0:19:46.35,0:19:50.27,Default,,0,0,0,,Қарғыс атсын... Алып кетпе!
Dialogue: 0,0:19:51.27,0:19:53.98,Default,,0,0,0,,Қарғыс атсын, Шайтан!
Dialogue: 0,0:19:54.90,0:19:56.23,Default,,0,0,0,,(Шайтанның айқайы)
Dialogue: 0,0:19:56.52,0:19:59.90,Default,,0,0,0,,Қарсы шабуыл!
Dialogue: 0,0:20:02.15,0:20:03.99,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:20:14.92,0:20:16.42,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:20:19.96,0:20:21.05,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:22.13,0:20:24.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:24.47,0:20:27.47,Default,,0,0,0,,Құдай Валькири жеңіске жетті!
Dialogue: 0,0:20:27.93,0:20:30.64,Default,,0,0,0,,Мұны бірінші шайқаста жасаңыз.
Dialogue: 0,0:20:31.48,0:20:33.39,Default,,0,0,0,,Шектелген шабуыл туралы не деуге болады?
Dialogue: 0,0:20:33.73,0:20:34.85,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:20:35.60,0:20:38.98,Default,,0,0,0,,Құдай Валькири, сіз өте кереметсіз
Dialogue: 0,0:20:39.48,0:20:42.32,Default,,0,0,0,,Ата! Біз жеңдік... Иә?
Dialogue: 0,0:20:42.40,0:20:43.32,Default,,0,0,0,,(жоғалған дыбыс)
Dialogue: 0,0:20:44.03,0:20:46.07,Default,,0,0,0,,Зоро бір жерге кетті
Dialogue: 0,0:20:46.66,0:20:47.78,Default,,0,0,0,,Ата!
Dialogue: 0,0:20:47.87,0:20:49.20,Default,,0,0,0,,Ах... Аники
Dialogue: 0,0:20:49.87,0:20:51.45,Default,,0,0,0,,Сол мыңжапырақ
Dialogue: 0,0:20:51.58,0:20:52.70,Default,,0,0,0,,(мойынның сықырлаған дыбысы)
Dialogue: 0,0:20:56.63,0:20:58.29,Default,,0,0,0,,Күтіңіз~
Dialogue: 0,0:21:00.50,0:21:03.51,Default,,0,0,0,,Менің ойымша, балалар қазір өз істеріңді аяқтадыңдар.
Dialogue: 0,0:21:03.92,0:21:04.97,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:21:06.55,0:21:07.43,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:07.68,0:21:11.27,Default,,0,0,0,,Менің Валькирияға айналуым атамның арқасында.
Dialogue: 0,0:21:11.35,0:21:12.31,Default,,0,0,0,,Рақмет.
Dialogue: 0,0:21:12.89,0:21:16.06,Default,,0,0,0,,Бірақ сізде әлі талай жол бар.
Dialogue: 0,0:21:16.19,0:21:17.48,Default,,0,0,0,,Қосымша жаттығулар!
Dialogue: 0,0:21:17.77,0:21:20.44,Default,,0,0,0,,А, мен көбірек тырысамын!
Dialogue: 0,0:21:20.65,0:21:22.94,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:21:24.07,0:21:25.57,Default,,0,0,0,,Өтінемін, байлау құралдарын әкеліңдер!
Dialogue: 0,0:21:27.78,0:21:28.99,Default,,0,0,0,,Сәлем балалар
Dialogue: 0,0:21:29.83,0:21:31.91,Default,,0,0,0,,Мені БК Сольге апарыңыз.
Dialogue: 0,0:21:31.99,0:21:33.00,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:21:34.45,0:21:36.12,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:21:36.50,0:21:38.96,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:21:39.54,0:21:41.88,Default,,0,0,0,,Барыңыз Шуппа~цу!
Dialogue: 0,0:21:46.51,0:21:49.05,Default,,0,0,0,,Құдай Валькири менімен бірге
Dialogue: 0,0:21:49.76,0:21:51.93,Default,,0,0,0,,Әлемдегі ең жақсы болуды мақсат етейік!
Dialogue: 0,0:21:55.56,0:21:57.44,Default,,0,0,0,,♪~
Dialogue: 0,0:21:57.85,0:22:01.52,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:01.61,0:22:04.32,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.40,0:22:06.53,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:06.61,0:22:10.20,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.28,0:22:13.91,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:13.99,0:22:15.79,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:15.87,0:22:17.58,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:17.66,0:22:19.42,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.50,0:22:21.08,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.17,0:22:23.34,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.42,0:22:25.63,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:25.71,0:22:28.63,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:28.72,0:22:32.35,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.43,0:22:36.10,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.18,0:22:37.89,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:37.98,0:22:41.19,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.27,0:22:43.52,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:43.61,0:22:47.11,Default,,0,0,0,,БАРДЫҒА атыңыз БАРДЫҚ атыңыз
Dialogue: 0,0:22:47.19,0:22:50.74,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:50.82,0:22:52.91,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:52.99,0:22:54.58,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:54.66,0:22:58.04,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.12,0:23:00.37,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.46,0:23:03.13,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.21,0:23:05.42,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:05.50,0:23:09.42,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.51,0:23:13.10,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.18,0:23:16.72,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:16.81,0:23:20.02,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.10,0:23:22.19,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.27,0:23:24.65,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:22.27,0:23:24.65,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.98,0:23:29.03,Default,,0,0,0,,Кумичо, сен мұнда неге келдің?
Dialogue: 0,0:23:29.24,0:23:30.57,Default,,0,0,0,,Мен және Кумичо...
Dialogue: 0,0:23:30.65,0:23:33.32,Default,,0,0,0,,Мен BC Sol тобына қосылу үшін тест тапсырамын.
Dialogue: 0,0:23:33.53,0:23:36.70,Default,,0,0,0,,Өту үшін таңғажайып жігіттерді жеңу керек.
Dialogue: 0,0:23:37.12,0:23:40.08,Default,,0,0,0,,Бір ғана адам аман қалады, сіз жеңуіңіз керек!
Dialogue: 0,0:23:40.58,0:23:42.92,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.13,0:23:45.29,Default,,0,0,0,,Еркек жан! Блэз Рагнарук!
Dialogue: 0,0:23:45.92,0:23:49.09,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:50.59,0:23:56.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory