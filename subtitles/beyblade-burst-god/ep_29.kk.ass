Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.54,0:00:07.17,Default,,0,0,0,,wbba әлемдік лигасы
Dialogue: 0,0:00:07.71,0:00:09.88,Default,,0,0,0,,Әр лигада жеңіске жеткен клубтар...
Dialogue: 0,0:00:10.17,0:00:12.84,Default,,0,0,0,,Әлемнің шыңына қарай шайқас
Dialogue: 0,0:00:13.09,0:00:14.55,Default,,0,0,0,,Чемпион болуды мақсат етіңіз
Dialogue: 0,0:00:14.84,0:00:16.51,Default,,0,0,0,,Қолға алу үшін бірінші нөмір
Dialogue: 0,0:00:16.97,0:00:18.51,Default,,0,0,0,,Жауынгерлік рухыңызды өртеп жіберіңіз
Dialogue: 0,0:00:18.60,0:00:20.27,Default,,0,0,0,,Және шектен шығу
Dialogue: 0,0:00:20.97,0:00:22.43,Default,,0,0,0,,Жалынды жандардың шайқасы
Dialogue: 0,0:00:22.81,0:00:24.98,Default,,0,0,0,,Дүниені отқа сал
Dialogue: 0,0:00:25.81,0:00:27.27,Default,,0,0,0,,Даңққа кім ие болады?
Dialogue: 0,0:00:27.94,0:00:29.19,Default,,0,0,0,,Бұл – тура қызыл карта. (Бакуго) Тс.
Dialogue: 0,0:00:33.57,0:00:34.70,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:00:35.24,0:00:36.70,Default,,0,0,0,,иә
Dialogue: 0,0:00:36.78,0:00:38.28,Default,,0,0,0,,Мен қараңғылық періштесімін
Dialogue: 0,0:00:38.95,0:00:40.20,Default,,0,0,0,,Сіздің өмірлік қаныңыз -
Dialogue: 0,0:00:41.24,0:00:43.12,Default,,0,0,0,,Мен итадаки жеуге келдім.
Dialogue: 0,0:00:44.46,0:00:45.92,Default,,0,0,0,,Динаның командасына
Dialogue: 0,0:00:46.42,0:00:48.42,Default,,0,0,0,,Blader of Fear терең хаосты пайдаланады
Dialogue: 0,0:00:49.63,0:00:51.34,Default,,0,0,0,,Клио Дорон қосылды
Dialogue: 0,0:00:51.42,0:00:54.09,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:54.38,0:00:55.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:55.68,0:00:56.89,Default,,0,0,0,,Ой!
Dialogue: 0,0:00:56.97,0:01:00.18,Default,,0,0,0,,Терең хаос орталығы Юдзу Юдзу...
Dialogue: 0,0:01:00.26,0:01:01.31,Default,,0,0,0,,Берілме!
Dialogue: 0,0:01:01.77,0:01:02.27,Default,,0,0,0,,Иә
Dialogue: 0,0:01:03.06,0:01:05.56,Default,,0,0,0,,Менің хаосымның қарғысын ал!
Dialogue: 0,0:01:06.60,0:01:08.40,Default,,0,0,0,,Хаос рифті қабаты
Dialogue: 0,0:01:08.73,0:01:10.15,Default,,0,0,0,,Өте керемет!
Dialogue: 0,0:01:10.73,0:01:13.19,Default,,0,0,0,,Ал Дина және басқалары жеңіске жетті.
Dialogue: 0,0:01:13.86,0:01:14.90,Default,,0,0,0,,Барт
Dialogue: 0,0:01:14.99,0:01:15.53,Default,,0,0,0,,Әй?
Dialogue: 0,0:01:15.78,0:01:16.91,Default,,0,0,0,,Дина!
Dialogue: 0,0:01:17.57,0:01:19.20,Default,,0,0,0,,Финалда кездескенше
Dialogue: 0,0:01:19.78,0:01:22.66,Default,,0,0,0,,Міне, Нью-Йорктен соңғы жаңалықтар.
Dialogue: 0,0:01:22.74,0:01:24.20,Default,,0,0,0,,Нью-Йорк Буллз және
Dialogue: 0,0:01:24.29,0:01:26.41,Default,,0,0,0,,Korean Fire Seoul матчы -
Dialogue: 0,0:01:26.50,0:01:30.96,Default,,0,0,0,,Бұқалар басым күшпен жартылай финалға шықты.
Dialogue: 0,0:01:31.42,0:01:33.96,Default,,0,0,0,,Paris Blades-тің жартылай финалдағы қарсыласы -
Dialogue: 0,0:01:34.05,0:01:39.43,Default,,0,0,0,,Әлемнің ең күшті чемпионы Кохо - Нью-Йорк Буллз.
Dialogue: 0,0:01:39.51,0:01:41.51,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:41.60,0:01:42.81,Default,,0,0,0,,мен зұлымдарды әділ сотқа тартуға тырысар ма едім?
Dialogue: 0,0:01:59.45,0:02:03.12,Default,,0,0,0,,Тіпті таңғы жарқылмен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:04.08,0:02:06.41,Default,,0,0,0,,Бір жерден естілген дыбыс
Dialogue: 0,0:02:06.50,0:02:08.83,Default,,0,0,0,,Бұл шығанақтың соқтығысуы.
Dialogue: 0,0:02:08.92,0:02:13.25,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:13.92,0:02:18.68,Default,,0,0,0,,Жалынды жүрек ұйықтамайды, Майданға құмар.
Dialogue: 0,0:02:18.76,0:02:23.68,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:23.76,0:02:28.64,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:28.73,0:02:33.77,Default,,0,0,0,,Ең жақсы сахнада шыңды көздеу
Dialogue: 0,0:02:33.86,0:02:37.07,Default,,0,0,0,,Қазір ат!
Dialogue: 0,0:02:37.15,0:02:39.20,Default,,0,0,0,,(Үш екі бір ату!)
Dialogue: 0,0:02:39.28,0:02:41.20,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:41.28,0:02:43.45,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:43.53,0:02:48.45,Default,,0,0,0,,Маған бұрын ешқашан көрмеген шайқасты көрсетіңіз
Dialogue: 0,0:02:48.54,0:02:51.29,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:51.37,0:02:57.30,Default,,0,0,0,,Әріптесіңізбен үнемі дамып келе жатқан байланыс және дірілдеген жүрек соғысы
Dialogue: 0,0:02:57.38,0:03:01.89,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз.
Dialogue: 0,0:03:01.97,0:03:03.97,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:15.06,0:03:17.86,Default,,0,0,0,,Бекініс! Regulus баспанасы! !
Dialogue: 0,0:03:20.03,0:03:23.28,Default,,0,0,0,,Ооо, иә!
Dialogue: 0,0:03:23.36,0:03:24.37,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:24.57,0:03:26.58,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:03:26.66,0:03:28.75,Default,,0,0,0,,Сенор Сенорита
Dialogue: 0,0:03:28.83,0:03:31.21,Default,,0,0,0,,Бұл Бразилиядағы Риостың нағыз үйі...
Dialogue: 0,0:03:31.29,0:03:33.54,Default,,0,0,0,,Бей карнавалы қызу жүріп жатыр.
Dialogue: 0,0:03:33.63,0:03:37.25,Default,,0,0,0,,Эй, хо! Viva Samba!
Dialogue: 0,0:03:37.34,0:03:40.26,Default,,0,0,0,,(самба музыкасы)
Dialogue: 0,0:03:40.59,0:03:43.64,Default,,0,0,0,,Уау, бұл керемет!
Dialogue: 0,0:03:43.72,0:03:45.09,Default,,0,0,0,,Бұл фестиваль!
Dialogue: 0,0:03:45.18,0:03:47.60,Default,,0,0,0,,Бұл шығанақ... Мұның бәрі шығанақ!
Dialogue: 0,0:03:47.68,0:03:50.77,Default,,0,0,0,,Олар біздің ойынымызды бүкіл қалада тойлап жатыр.
Dialogue: 0,0:03:50.98,0:03:52.48,Default,,0,0,0,,Барка
Dialogue: 0,0:03:52.56,0:03:54.10,Default,,0,0,0,,Бей карнавалына сәйкес-
Dialogue: 0,0:03:54.19,0:03:56.27,Default,,0,0,0,,Біздің матч жоспарланған болатын.
Dialogue: 0,0:03:56.65,0:03:59.57,Default,,0,0,0,,Қайсысы маңызды емес, бұл тамаша фестиваль!
Dialogue: 0,0:03:59.65,0:04:01.65,Default,,0,0,0,,Бұл фестиваль! Бұл фестиваль!
Dialogue: 0,0:04:01.74,0:04:02.78,Default,,0,0,0,,Уф Самба!
Dialogue: 0,0:04:02.86,0:04:04.99,Default,,0,0,0,,Тек орындаңыз...
Dialogue: 0,0:04:05.07,0:04:06.87,Default,,0,0,0,,3 Идиот Самба...
Dialogue: 0,0:04:07.08,0:04:09.29,Default,,0,0,0,,Иә? Не болды, Хиксон?
Dialogue: 0,0:04:09.70,0:04:12.33,Default,,0,0,0,,Мен бұлай сезінбегеніме көп болды...
Dialogue: 0,0:04:12.87,0:04:16.63,Default,,0,0,0,,Көремін, Хиксон осы қаладан болған.
Dialogue: 0,0:04:16.83,0:04:17.42,Default,,0,0,0,,О
Dialogue: 0,0:04:17.63,0:04:19.55,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:20.00,0:04:20.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:21.30,0:04:24.05,Default,,0,0,0,,Келіңіздер! Бүгінгі басты оқиға
Dialogue: 0,0:04:24.13,0:04:27.55,Default,,0,0,0,,Brasil Rios Bladers кіреді!
Dialogue: 0,0:04:28.01,0:04:29.76,Default,,0,0,0,,О, бұл Шақа!
Dialogue: 0,0:04:29.93,0:04:32.48,Default,,0,0,0,,Ruway! Стэн де осында!
Dialogue: 0,0:04:32.56,0:04:37.23,Default,,0,0,0,,Рио! Рио!
Dialogue: 0,0:04:37.56,0:04:39.57,Default,,0,0,0,,Барлығы Риосқа ұмтылады.
Dialogue: 0,0:04:40.11,0:04:43.07,Default,,0,0,0,,Жігіттерден мүлдем алшақ.
Dialogue: 0,0:04:43.15,0:04:44.70,Default,,0,0,0,,Керісінше жанып кетеді
Dialogue: 0,0:04:45.07,0:04:46.45,Default,,0,0,0,,Шака~!
Dialogue: 0,0:04:47.07,0:04:49.74,Default,,0,0,0,,Біз Бразилияға келдік.
Dialogue: 0,0:04:49.99,0:04:52.50,Default,,0,0,0,,Балт~ Сен келдің!
Dialogue: 0,0:04:52.58,0:04:54.50,Default,,0,0,0,,(микрофонның қатты шуы)
Dialogue: 0,0:04:54.66,0:04:55.96,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:04:56.04,0:04:58.58,Default,,0,0,0,,Бразилия Риос пен BC Сол матч алдында-
Dialogue: 0,0:04:59.04,0:05:01.25,Default,,0,0,0,,Міне, біз күтпеген жерден кездестік!
Dialogue: 0,0:05:01.42,0:05:05.51,Default,,0,0,0,,Шака! Бұл шығанақ фестивалі өте қызықты!
Dialogue: 0,0:05:05.80,0:05:08.89,Default,,0,0,0,,Гаххаха! Бұл дұрыс, дұрыс
Dialogue: 0,0:05:09.26,0:05:12.72,Default,,0,0,0,,Біз қаладағы ең үлкен командамыз.
Dialogue: 0,0:05:12.81,0:05:14.89,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:15.60,0:05:18.40,Default,,0,0,0,,Бразилия Рио - ең күшті...жеңілмейтін!
Dialogue: 0,0:05:18.86,0:05:19.65,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:05:20.23,0:05:23.32,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:23.57,0:05:26.15,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:26.45,0:05:29.82,Default,,0,0,0,,Жарайды, менің мотивация қосқышым қосылды!
Dialogue: 0,0:05:29.91,0:05:31.03,Default,,0,0,0,,Хайтта!
Dialogue: 0,0:05:31.37,0:05:32.16,Default,,0,0,0,,Куза?
Dialogue: 0,0:05:32.41,0:05:33.66,Default,,0,0,0,,кеттік~
Dialogue: 0,0:05:33.75,0:05:34.25,Default,,0,0,0,,Әй
Dialogue: 0,0:05:34.33,0:05:34.83,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:05:35.20,0:05:35.71,Default,,0,0,0,,Кімге
Dialogue: 0,0:05:36.08,0:05:36.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:36.91,0:05:37.42,Default,,0,0,0,,Әй
Dialogue: 0,0:05:37.79,0:05:38.29,Default,,0,0,0,,Таа
Dialogue: 0,0:05:38.71,0:05:41.63,Default,,0,0,0,,Олай болса, екі топқа да сәттілік тілеймін.
Dialogue: 0,0:05:42.34,0:05:42.84,Default,,0,0,0,,Уф
Dialogue: 0,0:05:42.92,0:05:46.17,Default,,0,0,0,,Мен әдеттегіден көп айналдырып жатырмын!
Dialogue: 0,0:05:46.26,0:05:46.80,Default,,0,0,0,,(қону)
Dialogue: 0,0:05:47.34,0:05:49.01,Default,,0,0,0,,Үлкен жетістік!
Dialogue: 0,0:05:49.34,0:05:50.51,Default,,0,0,0,,(дыбыс)
Dialogue: 0,0:05:53.26,0:05:53.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:54.10,0:05:55.77,Default,,0,0,0,,О, не? Не?
Dialogue: 0,0:05:58.73,0:05:59.77,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:59.85,0:06:00.77,Default,,0,0,0,,Мен саған ешқашан осы туралы сұрастырамын деп айтқан жоқпын
Dialogue: 0,0:06:01.06,0:06:02.77,Default,,0,0,0,,(дыбысты дауыс)
Dialogue: 0,0:06:03.32,0:06:03.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:04.28,0:06:05.65,Default,,0,0,0,,Куза!
Dialogue: 0,0:06:05.90,0:06:07.11,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:06:07.40,0:06:08.78,Default,,0,0,0,,Алыс кет, алыста!
Dialogue: 0,0:06:09.57,0:06:10.57,Default,,0,0,0,,Уау
Dialogue: 0,0:06:13.08,0:06:14.49,Default,,0,0,0,,Кя!
Dialogue: 0,0:06:16.83,0:06:17.50,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:06:17.58,0:06:18.62,Default,,0,0,0,,(дыбысты дауыс)
Dialogue: 0,0:06:21.33,0:06:22.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:23.50,0:06:24.00,Default,,0,0,0,,​​О?
Dialogue: 0,0:06:24.34,0:06:26.21,Default,,0,0,0,,Шака! Ruway!
Dialogue: 0,0:06:26.34,0:06:29.51,Default,,0,0,0,,Яхаха~! Бұл жақын қоңырау болды
Dialogue: 0,0:06:31.01,0:06:33.01,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:33.10,0:06:33.76,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:06:33.85,0:06:35.77,Default,,0,0,0,,(дыбысты дауыс)
Dialogue: 0,0:06:36.89,0:06:39.64,Default,,0,0,0,,Сол Б.С. Сол жігіт... Ол солай істеп жатыр!
Dialogue: 0,0:06:40.06,0:06:41.48,Default,,0,0,0,,Сіз мұны әдейі істедіңіз!
Dialogue: 0,0:06:41.56,0:06:42.65,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:06:43.02,0:06:45.65,Default,,0,0,0,,Е, бұл әдейі емес!
Dialogue: 0,0:06:45.90,0:06:47.94,Default,,0,0,0,,Оны кешірме!
Dialogue: 0,0:06:48.03,0:06:49.90,Default,,0,0,0,,BC Solды ұстаңыз!
Dialogue: 0,0:06:49.99,0:06:51.61,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:51.86,0:06:54.78,Default,,0,0,0,,(Айыптау дауысы)
Dialogue: 0,0:06:54.87,0:06:57.25,Default,,0,0,0,,Жек көру... бұл сергітеді.
Dialogue: 0,0:06:57.33,0:06:59.50,Default,,0,0,0,,Бірдеңе болды ма деп ойлаймын.
Dialogue: 0,0:06:59.79,0:07:01.75,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:07:01.96,0:07:02.71,Default,,0,0,0,,(Итеру дыбысы)
Dialogue: 0,0:07:03.04,0:07:04.71,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:07:10.30,0:07:11.05,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:12.14,0:07:12.72,Default,,0,0,0,,(Итеру дыбысы)
Dialogue: 0,0:07:12.97,0:07:14.97,Default,,0,0,0,,Ооо!
Dialogue: 0,0:07:15.30,0:07:16.22,Default,,0,0,0,,«Меро-Меро Ганнан» атылатын нәрсе – «махаббат күші»
Dialogue: 0,0:07:16.39,0:07:16.97,Default,,0,0,0,,(қону)
Dialogue: 0,0:07:17.43,0:07:18.43,Default,,0,0,0,,Мен қайықты тексеріп бітірдім.
Dialogue: 0,0:07:18.56,0:07:19.85,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:19.93,0:07:22.23,Default,,0,0,0,,Мұны тіпті жігіт жасай алады.
Dialogue: 0,0:07:22.85,0:07:24.23,Default,,0,0,0,,Мұны істеудің қажеті жоқ
Dialogue: 0,0:07:25.27,0:07:27.98,Default,,0,0,0,,(қуаныш пен күлкі)
Dialogue: 0,0:07:28.36,0:07:30.82,Default,,0,0,0,,Хиксон, бірдеңе айтайын.
Dialogue: 0,0:07:30.90,0:07:32.66,Default,,0,0,0,,Анна, тоқтайық.
Dialogue: 0,0:07:32.74,0:07:34.37,Default,,0,0,0,,Тоқтамаңыз
Dialogue: 0,0:07:34.70,0:07:37.08,Default,,0,0,0,,Сіз бұл қалаға қаншалықты жиі қайтасыз?
Dialogue: 0,0:07:37.49,0:07:39.87,Default,,0,0,0,,Менің командамды тастап кетіп қалсаң да.
Dialogue: 0,0:07:40.50,0:07:41.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:42.17,0:07:44.63,Default,,0,0,0,,Сәлем! Бұлай айту мүмкін емес.
Dialogue: 0,0:07:44.71,0:07:45.71,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:07:45.79,0:07:48.46,Default,,0,0,0,,Жарайды, бәрі дұрыс айтады.
Dialogue: 0,0:07:48.96,0:07:51.67,Default,,0,0,0,,Түсінемін, бұл адамдар Риксон...
Dialogue: 0,0:07:51.84,0:07:53.89,Default,,0,0,0,,Ол бұрынғы командалас.
Dialogue: 0,0:07:54.30,0:07:57.18,Default,,0,0,0,,Фуриос үшін де, қолдаушылар үшін -
Dialogue: 0,0:07:57.26,0:07:58.81,Default,,0,0,0,,Бұл өте жақсы емес.
Dialogue: 0,0:07:58.97,0:08:01.27,Default,,0,0,0,,Bay Carnival - маңызды фестиваль.
Dialogue: 0,0:08:01.60,0:08:03.85,Default,,0,0,0,,Біз оны жойдық.
Dialogue: 0,0:08:04.23,0:08:06.27,Default,,0,0,0,,Қала тұрғындарының ренжігені таңқаларлық емес.
Dialogue: 0,0:08:06.44,0:08:09.11,Default,,0,0,0,,(Геклердің дауысы)
Dialogue: 0,0:08:09.94,0:08:11.86,Default,,0,0,0,,Бұлай кетпейді.
Dialogue: 0,0:08:12.86,0:08:13.61,Default,,0,0,0,,(Итеру дыбысы)
Dialogue: 0,0:08:17.12,0:08:19.24,Default,,0,0,0,,Мен барлығының сезімін қабылдадым.
Dialogue: 0,0:08:19.54,0:08:22.00,Default,,0,0,0,,Бұдан былай мен мұны барлығына жасаймын...
Dialogue: 0,0:08:22.08,0:08:24.12,Default,,0,0,0,,Мына жігіттерді шығанақта жеңіңіз!
Dialogue: 0,0:08:24.21,0:08:27.13,Default,,0,0,0,,(Бұрынғы Патша) Біз, Имантия, осы Дисбордта ең әлсізбіз.
Dialogue: 0,0:08:27.75,0:08:30.34,Default,,0,0,0,,Регент және бастары ұшты екі адам.
Dialogue: 0,0:08:30.59,0:08:33.59,Default,,0,0,0,,Бұл ойын! Бірден үшеуің хабарласыңдар.
Dialogue: 0,0:08:33.67,0:08:35.51,Default,,0,0,0,,Е!
Dialogue: 0,0:08:35.59,0:08:39.10,Default,,0,0,0,,Рувей BC Солдың үш мүшесіне соғыс жариялады!
Dialogue: 0,0:08:39.43,0:08:42.68,Default,,0,0,0,,Бір минут күтіңіз! 3-1 деген нені білдіреді?
Dialogue: 0,0:08:42.77,0:08:44.06,Default,,0,0,0,,Гандикап дегеніміз не?
Dialogue: 0,0:08:44.14,0:08:46.35,Default,,0,0,0,,Хмм, маған керегі жоқ!
Dialogue: 0,0:08:46.44,0:08:47.77,Default,,0,0,0,,Мен шыдай алмаймын!
Dialogue: 0,0:08:47.86,0:08:49.69,Default,,0,0,0,,Мен Рувейге тең келе алмаймын!
Dialogue: 0,0:08:49.77,0:08:52.24,Default,,0,0,0,,Балалар, сендер қатты ұрып қалдыңдар!
Dialogue: 0,0:08:52.78,0:08:56.36,Default,,0,0,0,,Мазасыз, жарайды, мен істеймін!
Dialogue: 0,0:08:56.45,0:08:58.99,Default,,0,0,0,,Құлап кетсе де, уайымдамаймын!
Dialogue: 0,0:08:59.28,0:09:03.00,Default,,0,0,0,,Ех! Мен де BC Solды қабылдадым!
Dialogue: 0,0:09:03.08,0:09:04.00,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:04.54,0:09:06.46,Default,,0,0,0,,Барлығының көңіл-күйі өзгерді.
Dialogue: 0,0:09:06.87,0:09:10.75,Default,,0,0,0,,Сіз күткендей Рувей Гахаха!
Dialogue: 0,0:09:10.84,0:09:12.96,Default,,0,0,0,,Ол балалар... не қаласа, соны істейді!
Dialogue: 0,0:09:13.17,0:09:14.67,Default,,0,0,0,,иә, иә.
Dialogue: 0,0:09:14.84,0:09:16.84,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:09:20.68,0:09:23.02,Default,,0,0,0,,Барлығы міндетті түрде жеңеді.
Dialogue: 0,0:09:23.22,0:09:25.02,Default,,0,0,0,,О! Мен жеңуім керек!
Dialogue: 0,0:09:25.35,0:09:26.60,Default,,0,0,0,,Сіздің стратегияңыз қандай?
Dialogue: 0,0:09:26.73,0:09:27.40,Default,,0,0,0,,«Мен бірде сенімен жақсылап сөйлескім келеді.»
Dialogue: 0,0:09:27.77,0:09:29.86,Default,,0,0,0,,Бір адам қалса, біз жеңеміз.
Dialogue: 0,0:09:29.94,0:09:31.40,Default,,0,0,0,,Топтық жұмыс маңызды!
Dialogue: 0,0:09:31.48,0:09:33.19,Default,,0,0,0,,Олай болса, кумичоны ортаға қойыңыз.
Dialogue: 0,0:09:33.82,0:09:35.36,Default,,0,0,0,,Оның айналасында
Dialogue: 0,0:09:35.44,0:09:38.11,Default,,0,0,0,,Балтоның ең шеткі аймаққа шабуылы туралы не деуге болады?
Dialogue: 0,0:09:39.03,0:09:40.45,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:09:40.53,0:09:42.54,Default,,0,0,0,,Мен жеңілуге ​​себеп таба алмаймын.
Dialogue: 0,0:09:42.62,0:09:44.04,Default,,0,0,0,,Оңай жеңіс!
Dialogue: 0,0:09:44.12,0:09:44.95,Default,,0,0,0,,Ендеше кеттік!
Dialogue: 0,0:09:45.41,0:09:46.71,Default,,0,0,0,,О!
Dialogue: 0,0:09:46.91,0:09:47.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:50.04,0:09:51.71,Default,,0,0,0,,Олардың шығанағы -
Dialogue: 0,0:09:51.96,0:09:54.59,Default,,0,0,0,,Шабуыл түрі Төзімділік түрі
Dialogue: 0,0:09:54.67,0:09:56.13,Default,,0,0,0,,Бұл теңдестірілген тип пе?
Dialogue: 0,0:09:56.47,0:09:57.38,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:59.34,0:10:01.43,Default,,0,0,0,,Маған көңіл көтеруге рұқсат етіңіз
Dialogue: 0,0:10:01.68,0:10:03.68,Default,,0,0,0,,Осы баспананы алыңыз Regulus!
Dialogue: 0,0:10:03.85,0:10:06.43,Default,,0,0,0,,(жанкүйерлер қолдайды)
Dialogue: 0,0:10:06.68,0:10:08.85,Default,,0,0,0,,Бұл Shelter Regulus...
Dialogue: 0,0:10:09.27,0:10:10.98,Default,,0,0,0,,Ол ақырында пайда болды ма?
Dialogue: 0,0:10:11.73,0:10:13.19,Default,,0,0,0,,Баланс түрі-
Dialogue: 0,0:10:13.27,0:10:16.07,Default,,0,0,0,,Сырғымалы қабатпен және мұнара драйверімен
Dialogue: 0,0:10:16.49,0:10:18.86,Default,,0,0,0,,Уау, қандай әдемі шығанақ!
Dialogue: 0,0:10:19.20,0:10:22.91,Default,,0,0,0,,Әдемі, бірақ қорқынышты тырнақтары мен азу тістерін жасырады.
Dialogue: 0,0:10:23.20,0:10:25.41,Default,,0,0,0,,Ах, Регул баспанасы...
Dialogue: 0,0:10:25.49,0:10:28.46,Default,,0,0,0,,Бірінші жарты мен екінші тайм арасында күресу тәсілі өзгереді.
Dialogue: 0,0:10:28.79,0:10:29.54,Default,,0,0,0,,(Баяндаушы) Цезарь не болып жатқанын мүлде түсінбеді.
Dialogue: 0,0:10:30.04,0:10:32.13,Default,,0,0,0,,Бірінші жартыжылдықта шабуылдың күші жоғары
Dialogue: 0,0:10:32.21,0:10:34.42,Default,,0,0,0,,Екінші жартысында қорғаныс күші артады
Dialogue: 0,0:10:35.00,0:10:38.17,Default,,0,0,0,,Бұл қызық. Мен сізге көрсетейін.
Dialogue: 0,0:10:38.72,0:10:40.72,Default,,0,0,0,,4 адам бір уақытта атады
Dialogue: 0,0:10:40.84,0:10:42.64,Default,,0,0,0,,Тірі қалған шығанақ жеңеді.
Dialogue: 0,0:10:42.72,0:10:43.72,Default,,0,0,0,,О
Dialogue: 0,0:10:48.68,0:10:51.81,Default,,0,0,0,,Шақа қарап тұр...Мен жеңіліп қалатын шығармын.
Dialogue: 0,0:10:52.44,0:10:55.02,Default,,0,0,0,,Үшеуі де тым көп күш қолдануда.
Dialogue: 0,0:11:09.71,0:11:11.96,Default,,0,0,0,,Балалар, сендер не істемексіңдер...
Dialogue: 0,0:11:12.04,0:11:13.50,Default,,0,0,0,,Мен ағымға беріліп, жай ғана айтып жібердім
Dialogue: 0,0:11:18.63,0:11:19.55,Default,,0,0,0,,Барт
Dialogue: 0,0:11:19.88,0:11:22.76,Default,,0,0,0,,Қалай өстіңіз?
Dialogue: 0,0:11:23.64,0:11:26.85,Default,,0,0,0,,Шака Сізге қарсылас болған адам...
Dialogue: 0,0:11:27.14,0:11:28.68,Default,,0,0,0,,Қанша?
Dialogue: 0,0:11:28.93,0:11:30.77,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:11:30.89,0:11:31.89,Default,,0,0,0,,Үш
Dialogue: 0,0:11:31.98,0:11:32.98,Default,,0,0,0,,Екі
Dialogue: 0,0:11:33.06,0:11:34.06,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:11:34.44,0:11:36.73,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:36.82,0:11:37.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:37.98,0:11:40.74,Default,,0,0,0,,Төрт шығанақ бірден босатылды!
Dialogue: 0,0:11:40.99,0:11:41.90,Default,,0,0,0,,Регул!
Dialogue: 0,0:11:41.99,0:11:43.45,Default,,0,0,0,,Слайд қабаты
Dialogue: 0,0:11:47.41,0:11:49.58,Default,,0,0,0,,Бірінші пайда болатын нәрсе ...
Dialogue: 0,0:11:49.66,0:11:51.00,Default,,0,0,0,,Альтер Кронос
Dialogue: 0,0:11:54.96,0:11:56.25,Default,,0,0,0,,Мен сенің қарсыласыңмын!
Dialogue: 0,0:12:02.51,0:12:03.59,Default,,0,0,0,,Азу тістерінің шабуылы!
Dialogue: 0,0:12:05.97,0:12:07.60,Default,,0,0,0,,(шығанақ соқтығысқан дыбыс)
Dialogue: 0,0:12:07.68,0:12:08.51,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:12:08.60,0:12:11.52,Default,,0,0,0,,Жарылыс! Хронос жарылып кетті!
Dialogue: 0,0:12:11.73,0:12:13.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:13.35,0:12:13.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:14.06,0:12:15.90,Default,,0,0,0,,Фу Фу
Dialogue: 0,0:12:16.56,0:12:18.32,Default,,0,0,0,,Сол кунг-фу бала-
Dialogue: 0,0:12:18.40,0:12:20.94,Default,,0,0,0,,Оның көздері өте жақсы.
Dialogue: 0,0:12:21.94,0:12:23.45,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,0:12:23.53,0:12:25.99,Default,,0,0,0,,Регул Кроносты жарып жіберді
Dialogue: 0,0:12:26.07,0:12:28.87,Default,,0,0,0,,Бірақ әлі екі қарсылас қалды.
Dialogue: 0,0:12:28.95,0:12:32.12,Default,,0,0,0,,Лу Вэй қашықтықты өлшеудегі данышпан.
Dialogue: 0,0:12:32.33,0:12:33.04,Default,,0,0,0,,Қашықтық?
Dialogue: 0,0:12:33.21,0:12:36.88,Default,,0,0,0,,Басқа адам қозғалса да, сіз бен басқа адам арасындағы қашықтықты өлшеңіз.
Dialogue: 0,0:12:36.96,0:12:38.88,Default,,0,0,0,,Оны бірден анықтауға болады.
Dialogue: 0,0:12:39.25,0:12:41.26,Default,,0,0,0,,Келесі - Рагнарук
Dialogue: 0,0:12:41.63,0:12:42.38,Default,,0,0,0,,Кумичо
Dialogue: 0,0:12:42.59,0:12:43.26,Default,,0,0,0,,О
Dialogue: 0,0:12:43.34,0:12:46.80,Default,,0,0,0,,Валькирия бұрылысы Регулы!
Dialogue: 0,0:12:46.89,0:12:50.26,Default,,0,0,0,,Енді, бұл Рагнарукпен шымшу шабуылы ма?
Dialogue: 0,0:12:50.85,0:12:51.77,Default,,0,0,0,,(Stephanie Dora) Сонымен… неге бізді осында жинадыңдар?
Dialogue: 0,0:12:51.85,0:12:53.89,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:12:53.98,0:12:56.02,Default,,0,0,0,,Баспананы қорғау!
Dialogue: 0,0:12:57.31,0:12:57.86,Default,,0,0,0,,Ммммм!
Dialogue: 0,0:12:57.94,0:13:01.32,Default,,0,0,0,,Ой, бұл Regulus мұнарасының жүргізушісі...
Dialogue: 0,0:13:01.48,0:13:03.53,Default,,0,0,0,,Ол өсті!
Dialogue: 0,0:13:04.11,0:13:06.57,Default,,0,0,0,,Екінші жартысында жүргізушінің бойы өседі.
Dialogue: 0,0:13:06.66,0:13:08.53,Default,,0,0,0,,Қорғаныс күшін бірден арттырады
Dialogue: 0,0:13:09.12,0:13:13.04,Default,,0,0,0,,Бойыңыз үлкен болса, қарсыласыңыздың шабуылы сізге жетпейді.
Dialogue: 0,0:13:13.58,0:13:16.54,Default,,0,0,0,,Енді қалай шығасың? Балто
Dialogue: 0,0:13:18.46,0:13:20.42,Default,,0,0,0,,Даа!
Dialogue: 0,0:13:20.75,0:13:21.42,Default,,0,0,0,,Тәтті!
Dialogue: 0,0:13:21.55,0:13:22.42,Default,,0,0,0,,(Жер дыбысы)
Dialogue: 0,0:13:23.38,0:13:24.80,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:13:25.42,0:13:25.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:26.22,0:13:26.80,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:27.84,0:13:29.47,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:13:29.55,0:13:31.56,Default,,0,0,0,,Рагнарук жарылды!
Dialogue: 0,0:13:31.64,0:13:33.60,Default,,0,0,0,,Валькири әлі айналуда
Dialogue: 0,0:13:33.81,0:13:35.85,Default,,0,0,0,,Алда көп нәрсе бар!
Dialogue: 0,0:13:36.23,0:13:37.23,Default,,0,0,0,,Балто!
Dialogue: 0,0:13:37.90,0:13:39.65,Default,,0,0,0,,Кеттік, Валькири
Dialogue: 0,0:13:39.73,0:13:41.36,Default,,0,0,0,,Құдай қайта жүктесін!
Dialogue: 0,0:13:43.36,0:13:44.36,Default,,0,0,0,,(Тоқтау дыбысы)
Dialogue: 0,0:13:44.69,0:13:45.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:45.78,0:13:48.70,Default,,0,0,0,,О? Валькири қалқып тұр...
Dialogue: 0,0:13:48.78,0:13:50.16,Default,,0,0,0,,Уа!
Dialogue: 0,0:13:50.24,0:13:52.24,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:13:52.87,0:13:53.66,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:13:53.74,0:13:56.54,Default,,0,0,0,,Қандай жарылыс! Валькири -
Dialogue: 0,0:13:57.00,0:13:58.42,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:13:59.50,0:14:00.08,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:14:01.17,0:14:02.71,Default,,0,0,0,,Рувей
Dialogue: 0,0:14:02.80,0:14:04.84,Default,,0,0,0,,Барлық шығанақтар үшін жылдам жеңіс
Dialogue: 0,0:14:05.09,0:14:06.55,Default,,0,0,0,,Керемет!
Dialogue: 0,0:14:06.97,0:14:08.47,Default,,0,0,0,,Көрме матчы -
Dialogue: 0,0:14:08.55,0:14:10.05,Default,,0,0,0,,Бразилия Рио жеңді!
Dialogue: 0,0:14:10.14,0:14:12.56,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:12.64,0:14:19.56,Default,,0,0,0,,Рио! Рио!
Dialogue: 0,0:14:19.90,0:14:21.06,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:14:21.40,0:14:23.32,Default,,0,0,0,,Tsk...сақтап алыңыз
Dialogue: 0,0:14:23.77,0:14:26.57,Default,,0,0,0,,Қайта жүктелді Мен оны шығара алмадым...
Dialogue: 0,0:14:26.90,0:14:27.86,Default,,0,0,0,,Пә!
Dialogue: 0,0:14:28.74,0:14:30.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:31.45,0:14:34.45,Default,,0,0,0,,1-ден 3-ке дейінгі жағдайға қарамастан...
Dialogue: 0,0:14:34.54,0:14:37.62,Default,,0,0,0,,Үлкен 5-тің қабырғалары әлі де биік болатын.
Dialogue: 0,0:14:37.91,0:14:39.29,Default,,0,0,0,,Бұл оңай жеңіс болды.
Dialogue: 0,0:14:39.67,0:14:41.21,Default,,0,0,0,,Лувейден күткендей.
Dialogue: 0,0:14:41.33,0:14:43.59,Default,,0,0,0,,Аа, деңгейі басқаша.
Dialogue: 0,0:14:43.96,0:14:44.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:46.51,0:14:47.72,Default,,0,0,0,,Балто~
Dialogue: 0,0:14:49.88,0:14:50.76,Default,,0,0,0,,Шака?
Dialogue: 0,0:14:51.43,0:14:55.35,Default,,0,0,0,,Баккааро!
Dialogue: 0,0:14:56.97,0:14:58.68,Default,,0,0,0,,Coo~
Dialogue: 0,0:14:59.06,0:14:59.64,Default,,0,0,0,,Нан!
Dialogue: 0,0:15:01.44,0:15:02.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:03.11,0:15:05.69,Default,,0,0,0,,Шайқаста абсолютті болмайды.
Dialogue: 0,0:15:06.23,0:15:06.94,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:07.61,0:15:10.91,Default,,0,0,0,,Бірақ бұл жоғалтудың соққысы өте үлкен.
Dialogue: 0,0:15:11.11,0:15:13.53,Default,,0,0,0,,Крис, сенің кезегің.
Dialogue: 0,0:15:14.45,0:15:15.37,Default,,0,0,0,,Иә
Dialogue: 0,0:15:26.80,0:15:28.76,Default,,0,0,0,,Шақаның ашулы жүзі
Dialogue: 0,0:15:29.42,0:15:30.80,Default,,0,0,0,,бәлкім, осы ғана шығар
Dialogue: 0,0:15:31.09,0:15:33.51,Default,,0,0,0,,Бүгін көңілім қалды.
Dialogue: 0,0:15:33.72,0:15:34.51,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:35.01,0:15:36.60,Default,,0,0,0,,Барт Рантаро
Dialogue: 0,0:15:37.14,0:15:40.02,Default,,0,0,0,,Бірінші кездескен күн есіңде ме?
Dialogue: 0,0:15:41.06,0:15:44.31,Default,,0,0,0,,Мен сені осы командаға қарсы алған күнім
Dialogue: 0,0:15:45.06,0:15:48.94,Default,,0,0,0,,Сіздің шайқасыңыз мені толқытты.
Dialogue: 0,0:15:50.40,0:15:53.86,Default,,0,0,0,,Сондықтан қосылуға рұқсат бердім.
Dialogue: 0,0:15:56.41,0:15:57.99,Default,,0,0,0,,Бірақ бүгінгі шайқас-
Dialogue: 0,0:15:58.20,0:16:00.45,Default,,0,0,0,,Мен мүлде қобалжымадым.
Dialogue: 0,0:16:01.37,0:16:02.71,Default,,0,0,0,,Жоғалтудан да көп...
Dialogue: 0,0:16:02.83,0:16:04.96,Default,,0,0,0,,Бұл көңілсіз және төзгісіз.
Dialogue: 0,0:16:05.42,0:16:07.80,Default,,0,0,0,,Әлбетте, сендер сақтықыңды түсірдіңдер.
Dialogue: 0,0:16:08.21,0:16:10.97,Default,,0,0,0,,Осыған байланысты мен қолымнан келгеннің бәрін жасай алмадым.
Dialogue: 0,0:16:11.67,0:16:12.42,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:13.34,0:16:14.89,Default,,0,0,0,,Мен BC Сол-
Dialogue: 0,0:16:15.14,0:16:18.43,Default,,0,0,0,,Біздің клуб әлемді дүр сілкіндіретін клуб болғанын қалаймын.
Dialogue: 0,0:16:19.06,0:16:22.35,Default,,0,0,0,,Бүкіл әлем балалары тамсанатын клуб!
Dialogue: 0,0:16:22.98,0:16:24.48,Default,,0,0,0,,Мен сенемін
Dialogue: 0,0:16:24.90,0:16:27.11,Default,,0,0,0,,Мен сендердің қолдарыңнан келетініне сенімдімін!
Dialogue: 0,0:16:31.40,0:16:32.57,Default,,0,0,0,,(сығу дыбысы)
Dialogue: 0,0:16:33.28,0:16:33.86,Default,,0,0,0,,Эй!
Dialogue: 0,0:16:38.58,0:16:40.33,Default,,0,0,0,,Шака!
Dialogue: 0,0:16:45.00,0:16:47.58,Default,,0,0,0,,Шака!
Dialogue: 0,0:16:49.38,0:16:51.92,Default,,0,0,0,,Шака! (Лувей) Шулы.
Dialogue: 0,0:16:52.01,0:16:52.55,Default,,0,0,0,,О!
Dialogue: 0,0:16:52.84,0:16:53.84,Default,,0,0,0,,Ruway!
Dialogue: 0,0:16:54.76,0:16:55.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:57.09,0:17:00.22,Default,,0,0,0,,Шақа хатта осылай деп жазыпты...
Dialogue: 0,0:17:00.35,0:17:02.14,Default,,0,0,0,,100 адам соғысқан жер...
Dialogue: 0,0:17:02.77,0:17:04.85,Default,,0,0,0,,А, бұл стадион...
Dialogue: 0,0:17:05.02,0:17:07.31,Default,,0,0,0,,Шақаның қаны мен тері боялған.
Dialogue: 0,0:17:07.52,0:17:09.90,Default,,0,0,0,,Ол ешқашан әлсіз дыбыс шығармайды.
Dialogue: 0,0:17:09.98,0:17:11.61,Default,,0,0,0,,Бәрін жеңді
Dialogue: 0,0:17:11.86,0:17:14.32,Default,,0,0,0,,Зи зе зе
Dialogue: 0,0:17:14.65,0:17:16.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:17.53,0:17:19.41,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:17:19.49,0:17:22.49,Default,,0,0,0,,Шака...неге сонша?
Dialogue: 0,0:17:22.75,0:17:24.46,Default,,0,0,0,,Ааа хе
Dialogue: 0,0:17:25.04,0:17:28.58,Default,,0,0,0,,Мен оны осы жолы жеңе аламын деп үміттенемін!
Dialogue: 0,0:17:29.33,0:17:31.59,Default,,0,0,0,,Қатаң жаттығуға кім шыдады...
Dialogue: 0,0:17:31.71,0:17:33.38,Default,,0,0,0,,Мұның бәрі сіз үшін жеңіске жету.
Dialogue: 0,0:17:33.71,0:17:36.22,Default,,0,0,0,,Бірақ сен Шақаға опасыздық жасадың
Dialogue: 0,0:17:36.47,0:17:38.26,Default,,0,0,0,,Дөрекі түріңді көрсет!
Dialogue: 0,0:17:40.55,0:17:41.22,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:42.72,0:17:44.98,Default,,0,0,0,,Ол сенен көңілі қалды.
Dialogue: 0,0:17:46.10,0:17:47.52,Default,,0,0,0,,Маған да істеуге рұқсат етіңіз!
Dialogue: 0,0:17:48.06,0:17:48.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:49.06,0:17:52.11,Default,,0,0,0,,100 адамның шайқасы... Маған да рұқсат етіңіз!
Dialogue: 0,0:17:55.53,0:17:56.49,Default,,0,0,0,,Күтілгендей-
Dialogue: 0,0:17:56.61,0:17:58.86,Default,,0,0,0,,Мен мұнда әлі келмеуім керек еді.
Dialogue: 0,0:18:00.32,0:18:01.78,Default,,0,0,0,,Хиксон!
Dialogue: 0,0:18:02.28,0:18:04.87,Default,,0,0,0,,Бұл үлкен мәселе! Нағашы ағаңның өрушісі...
Dialogue: 0,0:18:04.95,0:18:06.12,Default,,0,0,0,,Жүз адам соғысып жатыр!
Dialogue: 0,0:18:06.46,0:18:07.29,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:18:07.79,0:18:09.08,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:18:10.17,0:18:15.09,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:18:15.17,0:18:16.51,Default,,0,0,0,,Балто!
Dialogue: 0,0:18:16.67,0:18:18.88,Default,,0,0,0,,Бұл 91-ші ойын.
Dialogue: 0,0:18:18.97,0:18:20.64,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:18:21.05,0:18:23.10,Default,,0,0,0,,Ол қазірдің өзінде... тоз-тоз болып қалды.
Dialogue: 0,0:18:23.39,0:18:24.81,Default,,0,0,0,,Сіз мұны әлі істеп жатырсыз ба?
Dialogue: 0,0:18:25.10,0:18:25.93,Default,,0,0,0,,Өзінің өліміне әкелсе де.
Dialogue: 0,0:18:26.23,0:18:27.89,Default,,0,0,0,,92-ойын
Dialogue: 0,0:18:27.98,0:18:29.65,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:18:30.23,0:18:31.44,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:18:31.52,0:18:32.36,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:18:32.44,0:18:33.19,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:18:33.27,0:18:34.27,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:18:35.28,0:18:36.19,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:18:36.28,0:18:37.28,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:18:37.78,0:18:38.78,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:18:39.82,0:18:41.62,Default,,0,0,0,,95-ойын
Dialogue: 0,0:18:42.41,0:18:43.58,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:43.99,0:18:46.08,Default,,0,0,0,,Бұл енді мүмкін емес! Тоқта!
Dialogue: 0,0:18:46.45,0:18:47.79,Default,,0,0,0,,Тоқтамаңыз!
Dialogue: 0,0:18:52.96,0:18:55.92,Default,,0,0,0,,Шака! Менің толық күшім -
Dialogue: 0,0:18:56.05,0:18:57.09,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:18:58.30,0:18:59.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:59.59,0:19:01.14,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:19:01.59,0:19:04.89,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:05.22,0:19:06.14,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:19:06.68,0:19:07.47,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:19:13.86,0:19:14.61,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:19:15.65,0:19:16.40,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:19:18.03,0:19:19.44,Default,,0,0,0,,Үлкен зиян!
Dialogue: 0,0:19:19.95,0:19:21.07,Default,,0,0,0,,Бар болғаны...
Dialogue: 0,0:19:25.95,0:19:27.12,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:19:30.46,0:19:32.62,Default,,0,0,0,,Құдай қайта жүктесін!
Dialogue: 0,0:19:36.09,0:19:38.34,Default,,0,0,0,,Шака! Бұл менікі -
Dialogue: 0,0:19:38.84,0:19:40.13,Default,,0,0,0,,Менің бар күшім!
Dialogue: 0,0:19:40.47,0:19:41.88,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:41.97,0:19:42.97,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:19:45.01,0:19:46.60,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:19:46.68,0:19:48.68,Default,,0,0,0,,Аои Балттың жеңісі!
Dialogue: 0,0:19:49.39,0:19:51.23,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:19:51.31,0:19:51.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:52.02,0:19:53.06,Default,,0,0,0,,Балто!
Dialogue: 0,0:19:54.31,0:19:57.44,Default,,0,0,0,,Орындалды! Құдай қайта жүктеп алды!
Dialogue: 0,0:19:57.86,0:19:59.32,Default,,0,0,0,,Тағы не? Уф...
Dialogue: 0,0:19:59.40,0:20:00.07,Default,,0,0,0,,Балто!
Dialogue: 0,0:20:01.40,0:20:03.07,Default,,0,0,0,,Мен бұл жігітті үйіне апарамын.
Dialogue: 0,0:20:03.66,0:20:04.70,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:20:05.20,0:20:07.08,Default,,0,0,0,,Сіз әлі де...
Dialogue: 0,0:20:08.29,0:20:09.08,Default,,0,0,0,,Шака…
Dialogue: 0,0:20:09.41,0:20:11.16,Default,,0,0,0,,Нуу
Dialogue: 0,0:20:11.41,0:20:12.33,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:20:12.71,0:20:13.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:13.79,0:20:14.83,Default,,0,0,0,,Шака…
Dialogue: 0,0:20:15.21,0:20:17.13,Default,,0,0,0,,Матч ертең!
Dialogue: 0,0:20:17.84,0:20:18.84,Default,,0,0,0,,Ойлағанымдай, жұдырығыммен тиіп,
Dialogue: 0,0:20:19.63,0:20:20.42,Default,,0,0,0,,Хи хи
Dialogue: 0,0:20:22.01,0:20:25.14,Default,,0,0,0,,Аура! Көптен күткен басты оқиға!
Dialogue: 0,0:20:25.22,0:20:27.93,Default,,0,0,0,,Бұл Дүниежүзілік лиганың жартылай финалы.
Dialogue: 0,0:20:28.01,0:20:30.93,Default,,0,0,0,,Бразилия Риос пен БК Сол
Dialogue: 0,0:20:31.02,0:20:34.69,Default,,0,0,0,,Мұнда жеңген команда финалға өтеді.
Dialogue: 0,0:20:34.98,0:20:36.65,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:20:36.94,0:20:39.98,Default,,0,0,0,,Уау, бүкіл денем ауырады.
Dialogue: 0,0:20:40.07,0:20:41.24,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:20:41.32,0:20:44.36,Default,,0,0,0,,Жартылай финалға дейін бұлшық еттерім ауырса, мені қалжыңдайсыз ба?
Dialogue: 0,0:20:44.45,0:20:46.32,Default,,0,0,0,,Осылай күресуге болмайды ма?
Dialogue: 0,0:20:46.41,0:20:47.74,Default,,0,0,0,,Мен бара аламын! Мен бара аламын!
Dialogue: 0,0:20:47.82,0:20:50.66,Default,,0,0,0,,Бұл өте салқын... Өте ыстық...
Dialogue: 0,0:20:50.74,0:20:51.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:52.58,0:20:53.71,Default,,0,0,0,,Мен бірінші барамын!
Dialogue: 0,0:20:56.25,0:20:59.50,Default,,0,0,0,,Сол пайдасыз денеге бірдеңе жасаңыз!
Dialogue: 0,0:20:59.67,0:21:00.63,Default,,0,0,0,,О...
Dialogue: 0,0:21:01.92,0:21:04.63,Default,,0,0,0,,Енді бірінші ойындағы пышақ...
Dialogue: 0,0:21:05.05,0:21:06.01,Default,,0,0,0,,Қызыл бұрыш
Dialogue: 0,0:21:06.22,0:21:09.10,Default,,0,0,0,,BC Sol - Cisco Carlyle!
Dialogue: 0,0:21:10.35,0:21:13.89,Default,,0,0,0,,Ей, мен кешегі үш тентектен бөлекпін.
Dialogue: 0,0:21:13.98,0:21:15.31,Default,,0,0,0,,Көк бұрыш
Dialogue: 0,0:21:15.39,0:21:17.52,Default,,0,0,0,,Бразилия Риос – капитан
Dialogue: 0,0:21:17.60,0:21:19.40,Default,,0,0,0,,Жанып жатқан ғибадатхана Кайза!
Dialogue: 0,0:21:19.48,0:21:22.40,Default,,0,0,0,,(жанкүйерлер қолдайды)
Dialogue: 0,0:21:22.94,0:21:25.36,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:28.95,0:21:33.16,Default,,0,0,0,,Кайза жанып тұрған ғибадатхана Жаңа Үлкен 5-тің бірі
Dialogue: 0,0:21:34.04,0:21:36.00,Default,,0,0,0,,Мен сенің орныңды аламын!
Dialogue: 0,0:21:36.16,0:21:37.71,Default,,0,0,0,,1-ойын
Dialogue: 0,0:21:38.04,0:21:39.33,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:21:40.92,0:21:42.84,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:21:42.92,0:21:44.05,Default,,0,0,0,,Үш
Dialogue: 0,0:21:44.13,0:21:45.26,Default,,0,0,0,,Екі
Dialogue: 0,0:21:45.34,0:21:46.47,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:21:46.55,0:21:47.88,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:21:47.97,0:21:49.30,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:21:49.39,0:21:50.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:55.98,0:21:57.77,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:21:58.19,0:22:00.02,Default,,0,0,0,,Негіздерге дайынсыз ба?
Dialogue: 0,0:22:00.11,0:22:02.86,Default,,0,0,0,,Енді күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:02.94,0:22:04.82,Default,,0,0,0,,Қозғалыс 1 нұсқаға қарағанда жылдамырақ.
Dialogue: 0,0:22:04.90,0:22:06.99,Default,,0,0,0,,Алдымен, Showtime бағдарламасының алдыңғы бөліміне шолу жасаңыз
Dialogue: 0,0:22:07.07,0:22:10.62,Default,,0,0,0,,Бар! Шүкір! үлкен
Dialogue: 0,0:22:10.70,0:22:13.45,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:13.54,0:22:14.37,Default,,0,0,0,,Жылдамдату
Dialogue: 0,0:22:14.45,0:22:16.20,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:16.29,0:22:18.04,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:18.12,0:22:19.88,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:19.96,0:22:21.46,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:21.54,0:22:23.17,Default,,0,0,0,,Хахаха, бұл жақсы емес пе?
Dialogue: 0,0:22:23.25,0:22:24.84,Default,,0,0,0,,Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.92,0:22:26.67,Default,,0,0,0,,Бұл жерден нашарлай түседі.
Dialogue: 0,0:22:26.76,0:22:28.84,Default,,0,0,0,,Шиеленісті көтерейік!
Dialogue: 0,0:22:28.93,0:22:30.89,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:30.97,0:22:32.85,Default,,0,0,0,,Моримори күшейе түсуде
Dialogue: 0,0:22:32.93,0:22:34.68,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:34.77,0:22:36.52,Default,,0,0,0,,Менің атқаным – құдайдың атысы
Dialogue: 0,0:22:36.60,0:22:40.15,Default,,0,0,0,,Оң аяқ киім Сол аяқ киім Оң жақтағы аяқ киім
Dialogue: 0,0:22:40.23,0:22:43.82,Default,,0,0,0,,Сол аяқ киім Оң аяқ киім Сол жақтағы аяқ киім
Dialogue: 0,0:22:43.90,0:22:45.73,Default,,0,0,0,,Өткен апта Осы аптада
Dialogue: 0,0:22:45.82,0:22:47.61,Default,,0,0,0,,Барып, түсіріп жатырмыз
Dialogue: 0,0:22:47.69,0:22:49.40,Default,,0,0,0,,Осы апта Келесі аптада
Dialogue: 0,0:22:49.49,0:22:51.45,Default,,0,0,0,,Ол сондай-ақ Go Shoot ойнайды
Dialogue: 0,0:22:51.53,0:22:53.12,Default,,0,0,0,,Күнделікті жаттығу
Dialogue: 0,0:22:53.20,0:22:55.04,Default,,0,0,0,,Барлығы істеп жатқан түсірілімге барыңыз
Dialogue: 0,0:22:55.12,0:22:56.83,Default,,0,0,0,,Көктем/жаз күз/қыс
Dialogue: 0,0:22:56.91,0:22:58.50,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:22:58.58,0:23:00.00,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:23:00.08,0:23:02.71,Default,,0,0,0,,Негізгі бұлшықеттерді дамыту үшін күнделікті жаттығулар қажет.
Dialogue: 0,0:23:02.79,0:23:05.92,Default,,0,0,0,,Осы шиеленіспен біз шарықтау шегіне жетеміз.
Dialogue: 0,0:23:06.00,0:23:08.97,Default,,0,0,0,,1 2 3 4 Бар!
Dialogue: 0,0:23:09.05,0:23:09.72,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:23:09.80,0:23:12.43,Default,,0,0,0,,1 2 3 4 Бар!
Dialogue: 0,0:23:12.51,0:23:13.22,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:23:13.30,0:23:17.10,Default,,0,0,0,,1 2 3 4 Бар! кеттік
Dialogue: 0,0:23:17.18,0:23:17.77,Default,,0,0,0,,Үш
Dialogue: 0,0:23:18.02,0:23:18.64,Default,,0,0,0,,Екі
Dialogue: 0,0:23:18.85,0:23:20.64,Default,,0,0,0,,One Go аяқ киім!
Dialogue: 0,0:23:20.73,0:23:21.98,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.06,0:23:25.15,Default,,0,0,0,,Керемет түсіріңіз! Керемет негіз!
Dialogue: 0,0:23:26.15,0:23:29.19,Default,,0,0,0,,Біз Бразилия Риосымен күресіп жатқанда...
Dialogue: 0,0:23:29.28,0:23:32.82,Default,,0,0,0,,Дина және басқалары Нью-Йоркте Bulls командасымен шайқасты.
Dialogue: 0,0:23:32.91,0:23:34.16,Default,,0,0,0,,Жыласаң да, күлсең де...
Dialogue: 0,0:23:34.24,0:23:36.12,Default,,0,0,0,,Финалға тек 2 команда шығады
Dialogue: 0,0:23:37.33,0:23:39.12,Default,,0,0,0,,Біз міндетті түрде жеңеміз!
Dialogue: 0,0:23:39.20,0:23:41.37,Default,,0,0,0,,Cisco! Бар!
Dialogue: 0,0:23:41.46,0:23:43.21,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.79,0:23:46.17,Default,,0,0,0,,Қақтығыс! Финалға ат салыңыз! !
Dialogue: 0,0:23:46.42,0:23:49.92,Default,,0,0,0,,Үш екі бір ату!
