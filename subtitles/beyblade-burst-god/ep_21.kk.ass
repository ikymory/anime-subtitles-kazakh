Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.21,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.13,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.26,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.39,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:19.97,0:00:24.35,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.10,0:00:29.40,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:31.03,0:00:33.78,Default,,0,0,0,,Крис, маған аударуға рұқсат етіңіз.
Dialogue: 0,0:00:33.86,0:00:35.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:35.20,0:00:36.82,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:00:37.07,0:00:40.49,Default,,0,0,0,,Мен өзімді басқа жерде тағы да жаттықтырамын.
Dialogue: 0,0:00:40.58,0:00:43.12,Default,,0,0,0,,Ал біз бұл жігіттерді жеңеміз!
Dialogue: 0,0:00:44.25,0:00:47.25,Default,,0,0,0,,BC Соль күрт өзгеретін болды.
Dialogue: 0,0:00:48.42,0:00:50.59,Default,,0,0,0,,Мен Нью-Йоркке көшемін
Dialogue: 0,0:00:50.80,0:00:53.88,Default,,0,0,0,,Келесі кездескенде мен саған жау боламын.
Dialogue: 0,0:00:55.30,0:01:00.56,Default,,0,0,0,,Стэн және тіпті Тред клубты тастап кетті.
Dialogue: 0,0:01:04.89,0:01:06.94,Default,,0,0,0,,Жасайық, Куза.
Dialogue: 0,0:01:07.02,0:01:09.19,Default,,0,0,0,,Оме! Cisco
Dialogue: 0,0:01:09.73,0:01:12.65,Default,,0,0,0,,Бірақ Куза жаңа дос болды.
Dialogue: 0,0:01:13.11,0:01:16.53,Default,,0,0,0,,BC Sol одан да күшті болады.
Dialogue: 0,0:01:17.45,0:01:20.08,Default,,0,0,0,,♪~
Dialogue: 0,0:01:20.16,0:01:22.62,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:22.70,0:01:25.04,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:25.12,0:01:27.54,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:27.62,0:01:29.92,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:30.00,0:01:31.84,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:31.92,0:01:36.09,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:37.05,0:01:41.81,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:41.89,0:01:46.81,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:46.94,0:01:51.65,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:01:51.73,0:01:56.65,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:01:56.74,0:02:01.62,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:01.70,0:02:06.62,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:06.70,0:02:10.04,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:10.13,0:02:11.71,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:11.79,0:02:14.13,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:14.21,0:02:16.63,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:16.71,0:02:18.84,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:18.93,0:02:20.18,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:20.26,0:02:21.85,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:21.93,0:02:24.22,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:24.31,0:02:30.44,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:30.52,0:02:34.90,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:34.98,0:02:37.53,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:37.61,0:02:40.16,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:40.24,0:02:42.20,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:42.20,0:02:42.57,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:42.20,0:02:42.57,Default,,0,0,0,,~♪
Dialogue: 0,0:02:42.57,0:02:42.66,Default,,0,0,0,,~♪
Dialogue: 0,0:02:42.66,0:02:46.12,Default,,0,0,0,,~♪
Dialogue: 0,0:02:42.66,0:02:46.12,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:46.12,0:02:46.95,Default,,0,0,0,,~♪
Dialogue: 0,0:02:48.04,0:02:51.00,Default,,0,0,0,,Джошуа ғарыштық ниндзяға қарсы!
Dialogue: 0,0:02:54.50,0:02:56.05,Default,,0,0,0,,Қарғыс атсын... Қарғыс атсын!
Dialogue: 0,0:02:56.25,0:02:59.30,Default,,0,0,0,,Сіз кімсіз? Маған атыңды айт!
Dialogue: 0,0:03:00.18,0:03:02.14,Default,,0,0,0,,Ешуа…
Dialogue: 0,0:03:03.47,0:03:05.47,Default,,0,0,0,,Джошуа Бун!
Dialogue: 0,0:03:05.56,0:03:07.22,Default,,0,0,0,,Курт!
Dialogue: 0,0:03:07.31,0:03:08.73,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:03:09.31,0:03:11.90,Default,,0,0,0,,Жақсы, Джошуа, бұл тамаша.
Dialogue: 0,0:03:14.06,0:03:16.77,Default,,0,0,0,,Иә! Керемет!
Dialogue: 0,0:03:17.48,0:03:18.99,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:03:19.24,0:03:21.78,Default,,0,0,0,,Қалаға Джошуа Бун келе жатқан сияқты.
Dialogue: 0,0:03:21.95,0:03:23.11,Default,,0,0,0,,Бұл құрылғы түрленіп, көптеген табақшалармен резонансқа түсіп
Dialogue: 0,0:03:23.20,0:03:26.16,Default,,0,0,0,,Ешуа деген кім? Сол Голливуд жұлдызы ма?
Dialogue: 0,0:03:26.24,0:03:28.33,Default,,0,0,0,,А... Анашым?
Dialogue: 0,0:03:28.41,0:03:31.46,Default,,0,0,0,,Мен Джошуа мырзаның жанкүйерімін.
Dialogue: 0,0:03:31.54,0:03:34.58,Default,,0,0,0,,Мен Джошуаның барлық фильмдерін көремін.
Dialogue: 0,0:03:35.71,0:03:37.55,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:03:37.63,0:03:40.22,Default,,0,0,0,,Мен бірінші көргенім -
Dialogue: 0,0:03:40.30,0:03:42.93,Default,,0,0,0,,«Джошуа Бунның ұлы шабуылы»
Dialogue: 0,0:03:47.35,0:03:49.56,Default,,0,0,0,,Мені қатты жылатқаны...
Dialogue: 0,0:03:49.64,0:03:52.19,Default,,0,0,0,,«Джошуа Бун және қарақшы патшаның қызы»
Dialogue: 0,0:03:52.27,0:03:53.94,Default,,0,0,0,,(шинаның сықырлаған дыбысы)
Dialogue: 0,0:03:54.23,0:03:56.19,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:03:56.27,0:04:00.53,Default,,0,0,0,,«Джошуа Бунның қашқан дүрбелең қақтығысы» - ең жақсы~
Dialogue: 0,0:04:01.99,0:04:04.61,Default,,0,0,0,,Ах, Джошуа-сама.
Dialogue: 0,0:04:04.70,0:04:06.74,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:04:06.82,0:04:09.20,Default,,0,0,0,,Фильмдер жақсы, бірақ Джошуа туралы айтсақ...
Dialogue: 0,0:04:09.29,0:04:11.62,Default,,0,0,0,,Ол әлемдік деңгейдегі жүзгіш.
Dialogue: 0,0:04:11.87,0:04:15.88,Default,,0,0,0,,Иә, Джошуа қазір әлемде 3-ші орында.
Dialogue: 0,0:04:15.96,0:04:18.09,Default,,0,0,0,,Ең жақсы 5 адамға ғана беріледі.
Dialogue: 0,0:04:18.17,0:04:21.42,Default,,0,0,0,,Оларда үлкен 5 деген арнайы атақ бар.
Dialogue: 0,0:04:21.80,0:04:22.97,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:23.05,0:04:26.22,Default,,0,0,0,,Фильмнің шарықтау шегі әрқашан бейблейд шоуы болып табылады.
Dialogue: 0,0:04:26.30,0:04:30.10,Default,,0,0,0,,Жауды бірінен соң бірін жеңу.
Dialogue: 0,0:04:33.10,0:04:36.90,Default,,0,0,0,,Joshua-sama at that time was also the coolest.
Dialogue: 0,0:04:36.98,0:04:39.52,Default,,0,0,0,,Bay showdown is amazing!
Dialogue: 0,0:04:39.61,0:04:42.28,Default,,0,0,0,,If that's the case, shouldn't we be able to appear in the movie too?
Dialogue: 0,0:04:42.36,0:04:43.95,Default,,0,0,0,,I want to see you too
Dialogue: 0,0:04:44.03,0:04:45.57,Default,,0,0,0,,Ұстаушы
Dialogue: 0,0:04:45.74,0:04:46.70,Default,,0,0,0,,Ha
Dialogue: 0,0:04:46.78,0:04:49.78,Default,,0,0,0,,There's no way amateurs like you can appear.
Dialogue: 0,0:04:49.87,0:04:51.62,Default,,0,0,0,,«Иллюстрацияланған мочи»
Dialogue: 0,0:04:51.70,0:04:52.62,Default,,0,0,0,,Не?
Dialogue: 0,0:04:52.70,0:04:54.71,Default,,0,0,0,,Сәлем! Something amazing happened.
Dialogue: 0,0:04:55.50,0:04:57.08,Default,,0,0,0,,БК мүшелеріне Сол-
Dialogue: 0,0:04:57.17,0:05:00.00,Default,,0,0,0,,I got an offer to star in Joshua's movie.
Dialogue: 0,0:05:00.13,0:05:02.76,Default,,0,0,0,,What, can we be in the movie?
Dialogue: 0,0:05:02.84,0:05:05.68,Default,,0,0,0,,Иә, олар сенің көрінгеніңді қалайды.
Dialogue: 0,0:05:05.93,0:05:07.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:07.26,0:05:09.10,Default,,0,0,0,,Even if it's just a role
Dialogue: 0,0:05:09.18,0:05:11.39,Default,,0,0,0,,Can I have a showdown with Joshua?
Dialogue: 0,0:05:11.72,0:05:12.97,Default,,0,0,0,,Әрине.
Dialogue: 0,0:05:13.06,0:05:16.52,Default,,0,0,0,,This time they want to show us a real Bey showdown.
Dialogue: 0,0:05:16.81,0:05:20.94,Default,,0,0,0,,I'm looking forward to competing against the Big 5.
Dialogue: 0,0:05:21.02,0:05:25.32,Default,,0,0,0,,Үлкен 5 шынымен күшті болуы керек.
Dialogue: 0,0:05:25.40,0:05:28.07,Default,,0,0,0,,Coo~ It's burning!
Dialogue: 0,0:05:33.29,0:05:36.87,Default,,0,0,0,,Wow~ It feels like a festival.
Dialogue: 0,0:05:36.96,0:05:39.67,Default,,0,0,0,,After all, Hollywood movies are different.
Dialogue: 0,0:05:39.75,0:05:42.00,Default,,0,0,0,,Ешуа қайда?
Dialogue: 0,0:05:42.09,0:05:44.46,Default,,0,0,0,,Сіз BC Sol компаниясының иесісіз бе?
Dialogue: 0,0:05:44.55,0:05:45.59,Default,,0,0,0,,Иә
Dialogue: 0,0:05:47.76,0:05:50.47,Default,,0,0,0,,Продюсер Дебора Мерфи.
Dialogue: 0,0:05:50.89,0:05:53.43,Default,,0,0,0,,Мен Крис. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:05:53.51,0:05:56.06,Default,,0,0,0,,Thank you for accepting the offer to perform.
Dialogue: 0,0:05:56.14,0:05:59.31,Default,,0,0,0,,Бұл керемет мүмкіндік.
Dialogue: 0,0:05:59.40,0:06:01.52,Default,,0,0,0,,Джошуа Бунмен шайқас...
Dialogue: 0,0:06:01.61,0:06:06.49,Default,,0,0,0,,It will be a very valuable experience for BC Sol as they prepare for the World League.
Dialogue: 0,0:06:07.03,0:06:08.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:09.16,0:06:11.53,Default,,0,0,0,,Сен сүйкімдісің.
Dialogue: 0,0:06:11.66,0:06:13.83,Default,,0,0,0,,Не? Жоқ, солай...
Dialogue: 0,0:06:13.95,0:06:16.62,Default,,0,0,0,,Даусың да керемет. Бір сәт осында кел.
Dialogue: 0,0:06:16.70,0:06:17.87,Default,,0,0,0,,Тору, менімен бірге жүр. (Ишикава) Ээ…
Dialogue: 0,0:06:17.96,0:06:20.38,Default,,0,0,0,,Иә? Біз ше?
Dialogue: 0,0:06:20.46,0:06:22.09,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:06:22.17,0:06:24.21,Default,,0,0,0,,Балалар, осындасыңдар.
Dialogue: 0,0:06:24.30,0:06:25.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:25.34,0:06:28.42,Default,,0,0,0,,I'm Terry Trunk, the director of this movie!
Dialogue: 0,0:06:28.51,0:06:30.68,Default,,0,0,0,,Білсең, тез дайындал.
Dialogue: 0,0:06:30.76,0:06:33.18,Default,,0,0,0,,Асығыңыз, асығыңыз, асығыңыз!
Dialogue: 0,0:06:33.51,0:06:35.60,Default,,0,0,0,,А, сен не істеп жатырсың?
Dialogue: 0,0:06:36.06,0:06:39.10,Default,,0,0,0,,Тоқта! Эй, тоқта!
Dialogue: 0,0:06:39.19,0:06:40.90,Default,,0,0,0,,Міне, сценарий.
Dialogue: 0,0:06:41.60,0:06:43.86,Default,,0,0,0,,Жолдарыңызды дұрыс есте сақтаңыз.
Dialogue: 0,0:06:46.90,0:06:50.03,Default,,0,0,0,,"Joshua Boone and Space Ninja"
Dialogue: 0,0:06:50.28,0:06:53.87,Default,,0,0,0,,Уау! Бұл ниндзя! Қызық көрінеді!
Dialogue: 0,0:06:53.95,0:06:56.16,Default,,0,0,0,,Besides, where is Joshua?
Dialogue: 0,0:06:56.24,0:06:57.25,Default,,0,0,0,,Ите!
Dialogue: 0,0:06:57.33,0:06:58.54,Default,,0,0,0,,Сәлем сен!
Dialogue: 0,0:06:58.62,0:07:02.13,Default,,0,0,0,,Сізге айта кетейін, Джошуа - Голливуд жұлдызы.
Dialogue: 0,0:07:02.21,0:07:05.21,Default,,0,0,0,,Don't just talk to me casually. Бұл тамаша!
Dialogue: 0,0:07:05.59,0:07:09.72,Default,,0,0,0,,Hey, you think I'm just a fan, don't you?
Dialogue: 0,0:07:10.05,0:07:11.43,Default,,0,0,0,,Сондықтан ауырады...
Dialogue: 0,0:07:14.55,0:07:15.97,Default,,0,0,0,,Не болды? Балтық
Dialogue: 0,0:07:16.06,0:07:18.64,Default,,0,0,0,,Oh no, you must not be nervous.
Dialogue: 0,0:07:18.77,0:07:21.39,Default,,0,0,0,,Listen, don't be nervous.
Dialogue: 0,0:07:21.48,0:07:23.02,Default,,0,0,0,,А... бұл рас.
Dialogue: 0,0:07:23.19,0:07:24.19,Default,,0,0,0,,Ессіз Патшаның зорлық-зомбылығына соңына нүкте қоятын – дәл сіздерсіздер!
Dialogue: 0,0:07:24.27,0:07:25.44,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:29.90,0:07:33.16,Default,,0,0,0,,Сіздің рөліңіз - ғарыш ниндзяларының әйел бастықтары.
Dialogue: 0,0:07:33.24,0:07:35.32,Default,,0,0,0,,Oh... a female boss...
Dialogue: 0,0:07:35.41,0:07:38.41,Default,,0,0,0,,Мен әрекет ете аламын ба?
Dialogue: 0,0:07:38.49,0:07:40.75,Default,,0,0,0,,Be confident Chris
Dialogue: 0,0:07:40.83,0:07:41.83,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:41.91,0:07:45.13,Default,,0,0,0,,Сізде Голливуд актрисасы сияқты аура бар.
Dialogue: 0,0:07:45.42,0:07:47.84,Default,,0,0,0,,Look, try saying this line.
Dialogue: 0,0:07:48.00,0:07:51.01,Default,,0,0,0,,А... у...
Dialogue: 0,0:07:52.93,0:07:55.30,Default,,0,0,0,,«Бәрі мұны істеуі керек!»
Dialogue: 0,0:07:55.39,0:07:59.14,Default,,0,0,0,,Ахаха, сенің қолыңнан келеді, жақсы!
Dialogue: 0,0:07:59.68,0:08:02.52,Default,,0,0,0,,Wow... is that true?
Dialogue: 0,0:08:03.77,0:08:06.81,Default,,0,0,0,,Ahaha, is this a space ninja?
Dialogue: 0,0:08:06.90,0:08:08.40,Default,,0,0,0,,Нинджака Нинджака
Dialogue: 0,0:08:08.69,0:08:11.28,Default,,0,0,0,,О! Нағыз ниндзяны қараңыз
Dialogue: 0,0:08:11.36,0:08:13.53,Default,,0,0,0,,Керемет көрінесің, Куза.
Dialogue: 0,0:08:13.61,0:08:16.12,Default,,0,0,0,,Эхехехе, саған шынымен жараса ма?
Dialogue: 0,0:08:16.45,0:08:19.08,Default,,0,0,0,,«Ғарыштық ниндзя сапары»
Dialogue: 0,0:08:21.66,0:08:23.92,Default,,0,0,0,,Куза Мен де жеңілмеймін.
Dialogue: 0,0:08:24.00,0:08:25.08,Default,,0,0,0,,Мен де!
Dialogue: 0,0:08:25.67,0:08:27.84,Default,,0,0,0,,Check out Space Ninja!
Dialogue: 0,0:08:27.92,0:08:29.67,Default,,0,0,0,,Нин нин нин... Уау!
Dialogue: 0,0:08:32.38,0:08:33.51,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:08:33.59,0:08:36.47,Default,,0,0,0,,Шұңқырды кім орнатты!
Dialogue: 0,0:08:36.55,0:08:38.51,Default,,0,0,0,,Сәлем Кат!
Dialogue: 0,0:08:39.01,0:08:42.93,Default,,0,0,0,,Ахаха Жарайды, жарайды, жақсы көрініс алдық.
Dialogue: 0,0:08:43.02,0:08:44.56,Default,,0,0,0,,Ешуа!
Dialogue: 0,0:08:44.64,0:08:47.69,Default,,0,0,0,,Не, түсірілім басталды ма?
Dialogue: 0,0:08:48.27,0:08:50.73,Default,,0,0,0,,Сізден керемет реакциялар!
Dialogue: 0,0:08:50.82,0:08:54.82,Default,,0,0,0,,Жергілікті қуық, солай ма? Мен бұл BC Sol екеніне сенімдімін!
Dialogue: 0,0:08:54.90,0:08:56.45,Default,,0,0,0,,Оле Балто
Dialogue: 0,0:08:56.53,0:08:57.78,Default,,0,0,0,,Мен Кумичомын
Dialogue: 0,0:08:57.87,0:08:59.20,Default,,0,0,0,,Мен Кусамын
Dialogue: 0,0:08:59.53,0:09:02.95,Default,,0,0,0,,Құрметпен, Б.С.Сол! Алақай!
Dialogue: 0,0:09:03.16,0:09:05.29,Default,,0,0,0,,Ия... ой!
Dialogue: 0,0:09:05.92,0:09:07.79,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:09:07.88,0:09:11.09,Default,,0,0,0,,сияқты, иә, бұл керемет
Dialogue: 0,0:09:11.17,0:09:14.22,Default,,0,0,0,,Ақымақ ниндзялар үшін өте қолайлы!
Dialogue: 0,0:09:15.97,0:09:20.43,Default,,0,0,0,,Мен Джошуаның үйдегі түскі асымды жегенін қалаймын.
Dialogue: 0,0:09:20.51,0:09:22.85,Default,,0,0,0,,Мен сіздің қолтаңбаңызды алғым келеді.
Dialogue: 0,0:09:28.73,0:09:30.98,Default,,0,0,0,,Не, Cisco да осында болды ма?
Dialogue: 0,0:09:31.36,0:09:33.65,Default,,0,0,0,,Джошуаны көргің келеді ғой, солай ма?
Dialogue: 0,0:09:33.73,0:09:37.15,Default,,0,0,0,,Жарайды... бұл үлкен бестік.
Dialogue: 0,0:09:37.24,0:09:38.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:42.62,0:09:44.75,Default,,0,0,0,,Бұл... қазір...
Dialogue: 0,0:09:45.50,0:09:48.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:48.71,0:09:51.71,Default,,0,0,0,,Хахахахаха Дайындық жақсы!
Dialogue: 0,0:09:51.79,0:09:54.92,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:09:55.34,0:09:57.63,Default,,0,0,0,,13-көрініс 6-қиық
Dialogue: 0,0:09:57.72,0:09:59.76,Default,,0,0,0,,Кеттік, жарайды.
Dialogue: 0,0:09:59.84,0:10:01.30,Default,,0,0,0,,Әрекет!
Dialogue: 0,0:10:02.81,0:10:04.18,Default,,0,0,0,,Сізді күттіргенім үшін кешіріңіз, балақай.
Dialogue: 0,0:10:05.02,0:10:07.60,Default,,0,0,0,,Сенің әдемі күлкіңді ұрлағандар
Dialogue: 0,0:10:07.69,0:10:12.19,Default,,0,0,0,,Бұл Джошуа Бун мен Бластогениус маған рұқсат бермейді.
Dialogue: 0,0:10:12.57,0:10:15.19,Default,,0,0,0,,Ах, бұл Бластогениус!
Dialogue: 0,0:10:15.78,0:10:18.40,Default,,0,0,0,,Бүкіл дүние саған жау болса да
Dialogue: 0,0:10:18.49,0:10:21.41,Default,,0,0,0,,Мына Джошуа Бун сенің жаныңда.
Dialogue: 0,0:10:22.24,0:10:25.70,Default,,0,0,0,,Хм... Жоқ, жоқ, тоқта, тоқта!
Dialogue: 0,0:10:25.95,0:10:27.50,Default,,0,0,0,,Ка... Кесу!
Dialogue: 0,0:10:28.04,0:10:30.04,Default,,0,0,0,,Демалыңыз Магистраль!
Dialogue: 0,0:10:30.21,0:10:31.54,Default,,0,0,0,,А... иә!
Dialogue: 0,0:10:31.92,0:10:34.88,Default,,0,0,0,,Ешуа мұндай ақсақ сөз айтпас еді.
Dialogue: 0,0:10:34.96,0:10:36.92,Default,,0,0,0,,Осыны жазған адамды тез арада жұмыстан шығару керек!
Dialogue: 0,0:10:37.34,0:10:40.26,Default,,0,0,0,,Джошуа өз жолын жақсы деп шешеді.
Dialogue: 0,0:10:41.76,0:10:42.60,Default,,0,0,0,,Иә...
Dialogue: 0,0:10:44.14,0:10:46.02,Default,,0,0,0,,Жарайды, мен бірінші барамын.
Dialogue: 0,0:10:47.06,0:10:50.23,Default,,0,0,0,,S... Мен Рантаро Кумичо Марумын.
Dialogue: 0,0:10:50.31,0:10:52.10,Default,,0,0,0,,Ум... Джошуа!
Dialogue: 0,0:10:52.19,0:10:54.36,Default,,0,0,0,,Сізге өмір берілді. Өзіңізді дайындаңыз!
Dialogue: 0,0:10:54.44,0:10:56.69,Default,,0,0,0,,Кумичо, сұмдық!
Dialogue: 0,0:10:56.78,0:10:57.90,Default,,0,0,0,,Ахаха
Dialogue: 0,0:10:58.15,0:11:00.66,Default,,0,0,0,,Ой! Ал...
Dialogue: 0,0:11:00.74,0:11:02.82,Default,,0,0,0,,Я... Мен жеңілдім.
Dialogue: 0,0:11:02.91,0:11:05.16,Default,,0,0,0,,Жошуа күткендей... күшті...
Dialogue: 0,0:11:05.24,0:11:06.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:06.74,0:11:10.50,Default,,0,0,0,,Бұл не? Ақырында біз жеңілеміз, солай ма?
Dialogue: 0,0:11:10.58,0:11:12.71,Default,,0,0,0,,Иә? Неге!
Dialogue: 0,0:11:12.79,0:11:14.50,Default,,0,0,0,,Әрине
Dialogue: 0,0:11:14.59,0:11:16.96,Default,,0,0,0,,Джошуа – фильмдегі басты кейіпкер.
Dialogue: 0,0:11:17.05,0:11:21.05,Default,,0,0,0,,Бірақ сіз нағыз Blader пайда болғанын айттыңыз, солай емес пе?
Dialogue: 0,0:11:21.13,0:11:23.64,Default,,0,0,0,,Бейдің ойыны ауыр емес пе?
Dialogue: 0,0:11:23.72,0:11:25.30,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:11:25.39,0:11:29.39,Default,,0,0,0,,Бұл Джошуа туралы фильм болмас еді, егер ол соңында стильде жеңіске жетпесе, солай емес пе?
Dialogue: 0,0:11:29.48,0:11:31.39,Default,,0,0,0,,Әрине, дәмді болмауы мүмкін емес — рецептіні дәлме-дәл орындадым. Бұл дәл бір тәжірибе сияқты.
Dialogue: 0,0:11:31.48,0:11:35.48,Default,,0,0,0,,Былайша айтқанда, жан аямай күресіп, жеңсек...
Dialogue: 0,0:11:35.56,0:11:38.03,Default,,0,0,0,,Менің ойымша, бұл Джошуаның жақсы емес екенін білдіреді.
Dialogue: 0,0:11:38.11,0:11:39.78,Default,,0,0,0,,Ешуаға не болды?
Dialogue: 0,0:11:40.49,0:11:41.65,Default,,0,0,0,,Ешуа!
Dialogue: 0,0:11:42.11,0:11:45.66,Default,,0,0,0,,Нағыз төбелессек, жеңеміз дедім.
Dialogue: 0,0:11:46.16,0:11:48.58,Default,,0,0,0,,Балалар!
Dialogue: 0,0:11:48.66,0:11:51.41,Default,,0,0,0,,Ешуаға не дедің, ақымақ?
Dialogue: 0,0:11:51.54,0:11:52.92,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:11:53.62,0:11:55.38,Default,,0,0,0,,Балалар, бұл қызық екен.
Dialogue: 0,0:11:56.21,0:11:58.55,Default,,0,0,0,,Джошуамен нағыз шайқас.
Dialogue: 0,0:11:59.26,0:12:01.26,Default,,0,0,0,,Сіз шынымен жеңемін деп ойлайсыз ба?
Dialogue: 0,0:12:02.17,0:12:05.14,Default,,0,0,0,,Бұл өте керемет! Қалай болғанда да, біз жеңеміз!
Dialogue: 0,0:12:05.76,0:12:07.60,Default,,0,0,0,,Осы қарқынмен, Хамон…
Dialogue: 0,0:12:07.68,0:12:10.27,Default,,0,0,0,,Мен сенімен және басқалармен шынымен ұрысамын.
Dialogue: 0,0:12:10.35,0:12:12.14,Default,,0,0,0,,Иә? Шынымен бе?
Dialogue: 0,0:12:12.48,0:12:18.48,Default,,0,0,0,,Егер сіз оған шындап қарамасаңыз, фильм ешқандай әсер етпейді.
Dialogue: 0,0:12:19.90,0:12:21.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:21.24,0:12:25.28,Default,,0,0,0,,Магистраль кестесін өзгерту Ұрыс сахнасынан түсіру!
Dialogue: 0,0:12:25.36,0:12:27.24,Default,,0,0,0,,Бірақ... Дайындық...
Dialogue: 0,0:12:27.45,0:12:29.87,Default,,0,0,0,,Жарайды, өзгер! Өзгеріс орнатыңыз!
Dialogue: 0,0:12:30.04,0:12:31.41,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің.
Dialogue: 0,0:12:31.50,0:12:34.54,Default,,0,0,0,,Жұмыс кестесін өзгерту! Ұрыс алаңына дайындық
Dialogue: 0,0:12:34.62,0:12:36.25,Default,,0,0,0,,Тезірек жүр, ақымақ!
Dialogue: 0,0:12:36.33,0:12:38.25,Default,,0,0,0,,Хе, жақсы, жақсы
Dialogue: 0,0:12:39.04,0:12:42.67,Default,,0,0,0,,Бұл қызықты жұмыс болады.
Dialogue: 0,0:12:42.84,0:12:44.05,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:44.13,0:12:47.64,Default,,0,0,0,,Жоспарлар өзгерді. Ұрыс сахнасын түсіру.
Dialogue: 0,0:12:47.72,0:12:49.51,Default,,0,0,0,,Иә?Бірақ...
Dialogue: 0,0:12:49.60,0:12:51.68,Default,,0,0,0,,Бұл Ешуаның жолы
Dialogue: 0,0:12:51.77,0:12:54.02,Default,,0,0,0,,Тезірек дайындалыңыз.
Dialogue: 0,0:12:54.64,0:12:56.27,Default,,0,0,0,,А... иә
Dialogue: 0,0:12:56.81,0:12:59.44,Default,,0,0,0,,Балто және басқалары жақсы ма?
Dialogue: 0,0:13:10.62,0:13:12.12,Default,,0,0,0,,Ешуа
Dialogue: 0,0:13:13.04,0:13:14.83,Default,,0,0,0,,Ю Кім?
Dialogue: 0,0:13:15.12,0:13:17.83,Default,,0,0,0,,Нағыз Самбаттың кішкентай күлгін қолтығы
Dialogue: 0,0:13:17.92,0:13:19.63,Default,,0,0,0,,Білмеймін демеңіз
Dialogue: 0,0:13:19.84,0:13:22.17,Default,,0,0,0,,Хмм, мен білмеймін.
Dialogue: 0,0:13:23.17,0:13:27.09,Default,,0,0,0,,Мен оған бірнеше рет хабарластым, ол: «Сіз менің клубыма қосыла аласыз» деді.
Dialogue: 0,0:13:27.68,0:13:30.97,Default,,0,0,0,,Кешіріңіз, бірақ мені мұндай бейтаныс клуб қызықтырмайды.
Dialogue: 0,0:13:31.22,0:13:32.68,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:13:32.77,0:13:36.73,Default,,0,0,0,,Мен иесі болдым, енді бұл өте танымал клуб.
Dialogue: 0,0:13:36.81,0:13:39.69,Default,,0,0,0,,Бұл жігіт маған жеке келді.
Dialogue: 0,0:13:41.11,0:13:46.24,Default,,0,0,0,,Тыңдаңыз, Джошуа өз жанкүйерлерін бәрінен де жоғары бағалайды.
Dialogue: 0,0:13:46.36,0:13:47.53,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:13:47.95,0:13:51.95,Default,,0,0,0,,Егер топ жұлдыз Джошуа осындай шағын клубқа қосылса ше?
Dialogue: 0,0:13:52.03,0:13:53.70,Default,,0,0,0,,Жанкүйерлердің көңілі қалады.
Dialogue: 0,0:13:53.79,0:13:57.41,Default,,0,0,0,,Кішкентай? Қайта айтып көріңіз!
Dialogue: 0,0:13:57.62,0:13:59.71,Default,,0,0,0,,Жоғарыда айтқанымдай, бұл ...
Dialogue: 0,0:13:59.79,0:14:02.80,Default,,0,0,0,,Жаға! Сен не істеп жатырсың? Сіз жай ғана рұқсатсыз кірдіңіз!
Dialogue: 0,0:14:02.88,0:14:04.59,Default,,0,0,0,,Уау, күте тұрыңыз!
Dialogue: 0,0:14:04.80,0:14:07.55,Default,,0,0,0,,Менің әңгімем әлі біткен жоқ.
Dialogue: 0,0:14:12.10,0:14:14.81,Default,,0,0,0,,Хмм... міне, болды!
Dialogue: 0,0:14:15.10,0:14:17.52,Default,,0,0,0,,Әй, Зороның атасы!
Dialogue: 0,0:14:18.23,0:14:21.52,Default,,0,0,0,,Охо~ Біраз уақыт өтті.
Dialogue: 0,0:14:21.61,0:14:23.07,Default,,0,0,0,,Мырза...
Dialogue: 0,0:14:23.61,0:14:24.82,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:14:24.90,0:14:25.99,Default,,0,0,0,,Зуко
Dialogue: 0,0:14:26.49,0:14:30.78,Default,,0,0,0,,Иә! Түсірілім қайта жалғасты!
Dialogue: 0,0:14:30.91,0:14:32.78,Default,,0,0,0,,Бәріңе сәлем!
Dialogue: 0,0:14:35.54,0:14:37.87,Default,,0,0,0,,Бұл өте танымал, Джошуа.
Dialogue: 0,0:14:37.96,0:14:41.13,Default,,0,0,0,,Өртеніп жатыр! Міндетті түрде жеңейік
Dialogue: 0,0:14:41.21,0:14:44.71,Default,,0,0,0,,Ах! Егер сіз үлкен бестіктің бірін жеңсеңіз
Dialogue: 0,0:14:44.80,0:14:47.26,Default,,0,0,0,,Әлемнің түкпір-түкпірінен назар аударады.
Dialogue: 0,0:14:47.51,0:14:49.76,Default,,0,0,0,,Мүмкін мен Голливудтан шақыру алып қалармын.
Dialogue: 0,0:14:49.84,0:14:51.39,Default,,0,0,0,,Камоне Камоне
Dialogue: 0,0:14:51.47,0:14:53.51,Default,,0,0,0,,Ей, сен сондай бейқамсың.
Dialogue: 0,0:14:54.47,0:14:55.47,Default,,0,0,0,,Вакия!
Dialogue: 0,0:14:56.10,0:14:57.68,Default,,0,0,0,,Әй, сен мұнда не үшін келдің?
Dialogue: 0,0:14:58.23,0:15:02.40,Default,,0,0,0,,Енді сәл жақынырақ болсам, мен саған өз бетімді көрсетуім керек еді деп ойлаймын.
Dialogue: 0,0:15:02.77,0:15:05.69,Default,,0,0,0,,Өтірікші! Сіз шынымен Джошуаны көру үшін келдіңіз, солай емес пе?
Dialogue: 0,0:15:05.77,0:15:06.82,Default,,0,0,0,,Кінә – кінәсіз мысықты сөмкеге салып, осы жерге тастап кеткен адамда.
Dialogue: 0,0:15:06.90,0:15:08.99,Default,,0,0,0,,Мүмкін ол барлау үшін келген шығар?
Dialogue: 0,0:15:09.07,0:15:10.24,Default,,0,0,0,,Енді беріліп қойғаның дұрыс.
Dialogue: 0,0:15:10.32,0:15:11.45,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:15:12.62,0:15:15.33,Default,,0,0,0,,Ал... Үлкен 5 қаншалықты үлкен?
Dialogue: 0,0:15:15.41,0:15:17.95,Default,,0,0,0,,Мен оны сынаған дұрыс сияқты.
Dialogue: 0,0:15:20.08,0:15:21.71,Default,,0,0,0,,Ешуа
Dialogue: 0,0:15:22.25,0:15:24.59,Default,,0,0,0,,Крис, BC Sol иесі.
Dialogue: 0,0:15:24.67,0:15:25.79,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:15:26.13,0:15:28.42,Default,,0,0,0,,Уау! Керемет Ертегі
Dialogue: 0,0:15:28.51,0:15:29.67,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:15:30.13,0:15:31.93,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:15:32.01,0:15:33.59,Default,,0,0,0,,Бірақ оның мәні неде?
Dialogue: 0,0:15:33.68,0:15:35.97,Default,,0,0,0,,Ғарыштық ниндзя әйел бастық
Dialogue: 0,0:15:36.26,0:15:38.89,Default,,0,0,0,,«Бәрі мұны істеуі керек!»
Dialogue: 0,0:15:38.97,0:15:41.81,Default,,0,0,0,,Уф, бұл дұрыс емес.
Dialogue: 0,0:15:41.89,0:15:43.19,Default,,0,0,0,,Егер сіздің кейіпкеріңіз...
Dialogue: 0,0:15:44.19,0:15:45.81,Default,,0,0,0,,Әйел бастықтан, күткендей.
Dialogue: 0,0:15:45.90,0:15:47.78,Default,,0,0,0,,Ол ханшайым сияқты жақсырақ көрінеді
Dialogue: 0,0:15:47.86,0:15:48.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:48.90,0:15:52.36,Default,,0,0,0,,Жарайды, жарайды Дебора, қазір костюміңді ауыстыр!
Dialogue: 0,0:15:52.45,0:15:54.74,Default,,0,0,0,,Иә, иә, Крис, осылай.
Dialogue: 0,0:15:54.82,0:15:57.24,Default,,0,0,0,,О, күте тұрыңыз, не?
Dialogue: 0,0:15:57.58,0:16:01.08,Default,,0,0,0,,Жақында кездескенше! Жуықта көріскенше!
Dialogue: 0,0:16:03.46,0:16:07.38,Default,,0,0,0,,Джошуа бұрын ешқашан жарылмаған.
Dialogue: 0,0:16:07.46,0:16:11.97,Default,,0,0,0,,Әйтеуір, ол жігіттің Бластогенисі қайсар.
Dialogue: 0,0:16:12.05,0:16:13.51,Default,,0,0,0,,Табанды?
Dialogue: 0,0:16:13.80,0:16:15.64,Default,,0,0,0,,Ұрысты көру арқылы білуге болады
Dialogue: 0,0:16:15.72,0:16:18.22,Default,,0,0,0,,Ол зат жарылып кетпейді.
Dialogue: 0,0:16:18.47,0:16:21.73,Default,,0,0,0,,Мен шайқасты тезірек көргім келеді.
Dialogue: 0,0:16:21.89,0:16:25.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:25.81,0:16:27.73,Default,,0,0,0,,Хахахаха~ Күткеніңізге рахмет!
Dialogue: 0,0:16:27.82,0:16:29.48,Default,,0,0,0,,Дайындық дұрыс
Dialogue: 0,0:16:29.57,0:16:31.49,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:16:32.44,0:16:34.82,Default,,0,0,0,,Ғарыштық ниндзямен шығанақ ойыны
Dialogue: 0,0:16:34.91,0:16:37.45,Default,,0,0,0,,Жақсы әрекет!
Dialogue: 0,0:16:42.00,0:16:44.04,Default,,0,0,0,,Енді бір қорқынышты нәрсе болды.
Dialogue: 0,0:16:44.12,0:16:47.67,Default,,0,0,0,,Крис ханшайымды зұлым адамдар тобы, ғарыш ниндзялары ұстап алды.
Dialogue: 0,0:16:48.63,0:16:53.13,Default,,0,0,0,,Кя, маған көмектесші~ Джошуа Бун!
Dialogue: 0,0:16:53.55,0:16:56.47,Default,,0,0,0,,Крис, сен қашан актриса болдың?
Dialogue: 0,0:16:56.55,0:16:58.39,Default,,0,0,0,,Сондай-ақ ханшайымның рөлі!
Dialogue: 0,0:16:58.47,0:16:59.60,Default,,0,0,0,,Мен қызғанамын
Dialogue: 0,0:16:59.68,0:17:02.06,Default,,0,0,0,,Джошуа-саманың маған көмектесетініне сене алар емеспін.
Dialogue: 0,0:17:02.22,0:17:04.52,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:04.60,0:17:06.06,Default,,0,0,0,,Күн ыстық!
Dialogue: 0,0:17:06.15,0:17:08.86,Default,,0,0,0,,Сәлем! Крис байланған
Dialogue: 0,0:17:08.94,0:17:12.11,Default,,0,0,0,,Крис ханшайымын ғарыштық ниндзялар ұрлап әкетті.
Dialogue: 0,0:17:12.19,0:17:14.11,Default,,0,0,0,,Не? Ғарыштық ниндзя боласыз ба?
Dialogue: 0,0:17:14.45,0:17:17.07,Default,,0,0,0,,Қайда қарап тұрсың? Бұл сендерсіңдер, жігіттер!
Dialogue: 0,0:17:17.45,0:17:19.20,Default,,0,0,0,,А... Түсіндім!
Dialogue: 0,0:17:19.28,0:17:21.62,Default,,0,0,0,,Бұл өте қызықты көрінеді.
Dialogue: 0,0:17:21.70,0:17:23.08,Default,,0,0,0,,Көңіліңізді көтермеңіз!
Dialogue: 0,0:17:23.45,0:17:27.50,Default,,0,0,0,,Күтілгендей! Бұл Голливуд фильмі!
Dialogue: 0,0:17:27.71,0:17:30.46,Default,,0,0,0,,Иә! Керемет!
Dialogue: 0,0:17:30.54,0:17:34.67,Default,,0,0,0,,Лайк басыңыз! Мен бірінші қарсыласым ретінде Юды таңдадым!
Dialogue: 0,0:17:35.09,0:17:36.97,Default,,0,0,0,,Хаха! Алақай!
Dialogue: 0,0:17:37.05,0:17:39.68,Default,,0,0,0,,Ұзақ уақыт! Мен кесілмей кетемін
Dialogue: 0,0:17:39.76,0:17:40.72,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:40.80,0:17:42.77,Default,,0,0,0,,(қайнаған магманың дыбысы)
Dialogue: 0,0:17:43.81,0:17:46.27,Default,,0,0,0,,Маған көмектес, Джошуа Бун!
Dialogue: 0,0:17:46.69,0:17:50.40,Default,,0,0,0,,Қазір біз қиын жағдайда тұрмыз. Крис ханшайымын құтқара алатын жалғыз адам...
Dialogue: 0,0:17:50.48,0:17:53.40,Default,,0,0,0,,Бұл ғалам кең болса да, ол ғана бар.
Dialogue: 0,0:17:53.48,0:17:56.65,Default,,0,0,0,,Иә, міне біздің Джошуа Бун келді.
Dialogue: 0,0:17:57.53,0:17:59.28,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, Крис ханшайым.
Dialogue: 0,0:17:59.36,0:18:00.99,Default,,0,0,0,,Мен сізге қазір көмектесемін.
Dialogue: 0,0:18:01.08,0:18:03.74,Default,,0,0,0,,Ешуаның алдында тұрған нәрсе
Dialogue: 0,0:18:03.83,0:18:08.17,Default,,0,0,0,,Бұл зұлым корпустың нөмірі бірінші ғарыш ниндзясы Пион Пёнмару Куза!
Dialogue: 0,0:18:08.37,0:18:09.42,Default,,0,0,0,,Ешуа
Dialogue: 0,0:18:09.50,0:18:13.05,Default,,0,0,0,,Крис ханшайымның қайтып оралуын қаласаңыз, алдымен мені жеңуіңіз керек.
Dialogue: 0,0:18:13.38,0:18:15.80,Default,,0,0,0,,Зұлым армия Супес Ниндзя
Dialogue: 0,0:18:15.88,0:18:19.01,Default,,0,0,0,,Мен оны Blast Genius-мен жоямын!
Dialogue: 0,0:18:19.43,0:18:20.80,Default,,0,0,0,,О, мінекей!
Dialogue: 0,0:18:20.89,0:18:22.35,Default,,0,0,0,,Бластогендік!
Dialogue: 0,0:18:22.60,0:18:23.85,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:18:23.93,0:18:25.14,Default,,0,0,0,,Фофофу
Dialogue: 0,0:18:25.64,0:18:28.89,Default,,0,0,0,,Ху, қалай қарасаң да, Кузаның жеңуге мүмкіндігі жоқ.
Dialogue: 0,0:18:29.44,0:18:30.90,Default,,0,0,0,,«Заттар сынақ»
Dialogue: 0,0:18:31.15,0:18:33.36,Default,,0,0,0,,Blastogenius – қорғаныс түрі.
Dialogue: 0,0:18:33.44,0:18:36.90,Default,,0,0,0,,Бірақ мен бәріңді бірден супер шабуылмен өлтіремін!
Dialogue: 0,0:18:37.61,0:18:39.53,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:18:41.07,0:18:42.57,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:18:44.20,0:18:45.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:45.58,0:18:48.54,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:48.75,0:18:51.21,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:12.23,0:19:14.69,Default,,0,0,0,,Ах... аа!
Dialogue: 0,0:19:14.98,0:19:16.53,Default,,0,0,0,,Куза Яй!
Dialogue: 0,0:19:16.61,0:19:17.69,Default,,0,0,0,,Керемет
Dialogue: 0,0:19:17.78,0:19:20.28,Default,,0,0,0,,Мен «Үлкен бестік» Джошуаны жеңдім.
Dialogue: 0,0:19:20.86,0:19:23.16,Default,,0,0,0,,Chronos Overfinish өзгерту
Dialogue: 0,0:19:23.62,0:19:25.16,Default,,0,0,0,,Ғажайып Куза
Dialogue: 0,0:19:25.66,0:19:27.54,Default,,0,0,0,,Не? Сіз жеңдіңіз бе?
Dialogue: 0,0:19:29.08,0:19:30.41,Default,,0,0,0,,♬~
Dialogue: 0,0:19:30.75,0:19:32.42,Default,,0,0,0,,О...
Dialogue: 0,0:19:32.50,0:19:34.75,Default,,0,0,0,,Бұл оңай ма?
Dialogue: 0,0:19:34.84,0:19:36.38,Default,,0,0,0,,Фофофу~
Dialogue: 0,0:19:37.67,0:19:41.38,Default,,0,0,0,,Ғарыштық ниндзя қорқынышты ниндзя әдістерін қолданады!
Dialogue: 0,0:19:41.88,0:19:43.80,Default,,0,0,0,,Енді бұл үлкен мәселе.
Dialogue: 0,0:19:43.89,0:19:46.93,Default,,0,0,0,,Осы қарқынмен Крис ханшайымның өміріне қауіп төніп тұр!
Dialogue: 0,0:19:47.22,0:19:49.52,Default,,0,0,0,,Куза Ақылыңды жоғалтпа.
Dialogue: 0,0:19:49.60,0:19:50.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:50.60,0:19:51.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:52.39,0:19:55.77,Default,,0,0,0,,... Джошуа! Өтінемін, маған тез көмектесіңіз~
Dialogue: 0,0:19:56.48,0:19:58.86,Default,,0,0,0,,Бұл жерде жеңілсек, Крис ханшайым өледі.
Dialogue: 0,0:19:59.28,0:20:03.45,Default,,0,0,0,,Бұл өз өмірімді қатерге тігу болса да, мен Крис ханшайымды міндетті түрде құтқарамын.
Dialogue: 0,0:20:03.53,0:20:06.24,Default,,0,0,0,,Кеттік! Бір реттік кері қайтару!
Dialogue: 0,0:20:06.33,0:20:09.54,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:20:10.08,0:20:13.04,Default,,0,0,0,,Үлкен 5-ті жеңудің тамаша мүмкіндігі!
Dialogue: 0,0:20:13.29,0:20:15.54,Default,,0,0,0,,Мен оны супер шабуылмен жарып жіберемін
Dialogue: 0,0:20:16.00,0:20:17.38,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:20:19.05,0:20:22.22,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:20:22.30,0:20:24.89,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:35.73,0:20:38.90,Default,,0,0,0,,Kronos слайд-түсіріліміне барыңыз!
Dialogue: 0,0:20:47.16,0:20:48.58,Default,,0,0,0,,Бұл өте жабысқақ.
Dialogue: 0,0:20:49.28,0:20:50.08,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:20:50.16,0:20:54.75,Default,,0,0,0,,Genius қарауылының жүргізушісі жоғары және төмен еркін қозғалады
Dialogue: 0,0:20:54.83,0:20:59.09,Default,,0,0,0,,Қандай көлбеу болса да, оны оңтайлы бұрышта ұстауға болады.
Dialogue: 0,0:21:03.92,0:21:05.38,Default,,0,0,0,,Кронос!
Dialogue: 0,0:21:06.39,0:21:08.76,Default,,0,0,0,,Циклон қабырғасы!
Dialogue: 0,0:21:15.27,0:21:16.35,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:21:21.11,0:21:25.95,Default,,0,0,0,,Қазір тоқтаңыз! циклондық есептегіш
Dialogue: 0,0:21:27.78,0:21:30.28,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:21:33.54,0:21:34.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:37.79,0:21:40.54,Default,,0,0,0,,Blast Genius және Burst Finish
Dialogue: 0,0:21:40.63,0:21:42.42,Default,,0,0,0,,Джошуа Бун жеңді!
Dialogue: 0,0:21:44.26,0:21:46.68,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:47.05,0:21:48.47,Default,,0,0,0,,Курт!
Dialogue: 0,0:21:48.72,0:21:51.14,Default,,0,0,0,,Керемет Ертегі
Dialogue: 0,0:21:51.22,0:21:53.64,Default,,0,0,0,,Өте керемет!
Dialogue: 0,0:21:55.98,0:21:58.44,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.52,0:22:01.94,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:02.02,0:22:04.74,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.82,0:22:06.99,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.07,0:22:10.66,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.74,0:22:14.33,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.41,0:22:16.20,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.29,0:22:18.04,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.12,0:22:19.88,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.96,0:22:21.59,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.67,0:22:23.59,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.67,0:22:26.05,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.17,0:22:29.09,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.18,0:22:32.80,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.89,0:22:36.56,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.64,0:22:38.27,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.35,0:22:41.52,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.61,0:22:43.98,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.07,0:22:47.57,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.65,0:22:51.20,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.28,0:22:53.16,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.24,0:22:55.04,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:55.12,0:22:58.50,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.58,0:23:00.42,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.50,0:23:03.59,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.67,0:23:05.88,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:05.96,0:23:09.93,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:10.01,0:23:13.55,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.64,0:23:17.06,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.14,0:23:20.48,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.56,0:23:22.15,Default,,0,0,0,,~♪
Dialogue: 0,0:23:20.56,0:23:22.15,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.15,0:23:22.23,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.23,0:23:25.07,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.23,0:23:25.07,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:25.07,0:23:25.52,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.48,0:23:30.32,Default,,0,0,0,,Қанша кино жұлдызы болса да, ол бәрібір өзімшіл.
Dialogue: 0,0:23:30.40,0:23:33.07,Default,,0,0,0,,Батыр дегеніміз не? Мен сені жеңемін!
Dialogue: 0,0:23:33.16,0:23:36.91,Default,,0,0,0,,Не? Бұл не, Вакия? Бұл шайқас менікі.
Dialogue: 0,0:23:36.99,0:23:41.21,Default,,0,0,0,,Сіз ұрлауды жоспарлап отырсыз ба? Сіз тым өзімшілсіз, Комурасаки Вакия!
Dialogue: 0,0:23:41.46,0:23:43.58,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.67,0:23:46.00,Default,,0,0,0,,Бластогениус дауыл деп атайды!
Dialogue: 0,0:23:46.09,0:23:49.42,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:50.92,0:23:56.92,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory