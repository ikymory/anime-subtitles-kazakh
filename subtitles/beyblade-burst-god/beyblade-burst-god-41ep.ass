Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.33,0:00:05.29,Default,,0,0,0,,Бейблейд!
Dialogue: 0,0:00:07.00,0:00:09.21,Default,,0,0,0,,Бұл баланың арманы
Dialogue: 0,0:00:09.75,0:00:14.72,Default,,0,0,0,,Дүние жүзінің түкпір-түкпірінен келген пышақшылар шыңға жету үшін жарысады және бір-біріне қарсы жанын салады.
Dialogue: 0,0:00:15.47,0:00:20.47,Default,,0,0,0,,Айналсын, жарылып, жарылсын!
Dialogue: 0,0:00:20.56,0:00:24.06,Default,,0,0,0,,Даңқты жеңіске қол жеткізіңіз!
Dialogue: 0,0:00:24.60,0:00:27.81,Default,,0,0,0,,Шайқастан кейін оны міндетті түрде табасыз.
Dialogue: 0,0:00:27.90,0:00:30.15,Default,,0,0,0,,Жарқын болашақ!
Dialogue: 0,0:00:32.65,0:00:35.70,Default,,0,0,0,,God Bladers Cup A тобының 1-ші матчы
Dialogue: 0,0:00:36.24,0:00:39.62,Default,,0,0,0,,Менің қарсыласым - жерасты шайқасының императоры Курц.
Dialogue: 0,0:00:44.58,0:00:48.42,Default,,0,0,0,,Бар, бар, бар, байланған реактивті ату!
Dialogue: 0,0:00:50.17,0:00:52.30,Default,,0,0,0,,Қызылша кукулканы
Dialogue: 0,0:00:53.92,0:00:56.38,Default,,0,0,0,,Шабуыл жасау!
Dialogue: 0,0:00:57.39,0:00:58.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:59.22,0:01:00.31,Default,,0,0,0,,Бітті
Dialogue: 0,0:01:04.56,0:01:05.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:05.73,0:01:07.27,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:07.85,0:01:08.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:10.23,0:01:14.78,Default,,0,0,0,,Мен ұсталып, адасып қалдым. Бұл өте көңілсіз.
Dialogue: 0,0:01:15.86,0:01:20.03,Default,,0,0,0,,Ал екінші матч Шу мен Боа арасындағы шайқас.
Dialogue: 0,0:01:20.45,0:01:22.87,Default,,0,0,0,,Мен сенен асып түстім
Dialogue: 0,0:01:23.20,0:01:25.21,Default,,0,0,0,,Мен қазір дәлелдеймін.
Dialogue: 0,0:01:25.66,0:01:28.54,Default,,0,0,0,,Қызыл көз Мен сені жеңемін!
Dialogue: 0,0:01:36.34,0:01:39.26,Default,,0,0,0,,Боа мен сені құртамын
Dialogue: 0,0:01:40.47,0:01:43.01,Default,,0,0,0,,♪~
Dialogue: 0,0:01:43.10,0:01:45.64,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:45.73,0:01:48.19,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:48.27,0:01:50.56,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:50.65,0:01:53.19,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:53.27,0:01:54.82,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:54.90,0:01:59.16,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:00.07,0:02:04.83,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:04.91,0:02:09.75,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:09.83,0:02:14.67,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:14.75,0:02:19.80,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:19.88,0:02:24.60,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:24.68,0:02:29.85,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:29.94,0:02:33.06,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:33.15,0:02:34.61,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:34.69,0:02:37.19,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:37.28,0:02:39.74,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:39.82,0:02:41.87,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:41.95,0:02:43.20,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:43.28,0:02:44.74,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:44.83,0:02:47.33,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:47.41,0:02:53.50,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:53.59,0:02:57.71,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:57.80,0:03:00.63,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:00.72,0:03:03.14,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:03.22,0:03:05.72,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:05.81,0:03:09.68,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:11.31,0:03:14.06,Default,,0,0,0,,Балға! Егіз жау!
Dialogue: 0,0:03:15.19,0:03:17.86,Default,,0,0,0,,(Найзағай бұлттарының дыбысы)
Dialogue: 0,0:03:17.94,0:03:19.11,Default,,0,0,0,,(күн күркірінің дыбысы)
Dialogue: 0,0:03:27.12,0:03:29.45,Default,,0,0,0,,Шынымды айтсам, бұл Шу ма?
Dialogue: 0,0:03:31.75,0:03:34.46,Default,,0,0,0,,Мен мұндай көзді бұрын көрген емеспін.
Dialogue: 0,0:03:36.92,0:03:40.34,Default,,0,0,0,,Мен сізге Спригган реквиемінің күшін көрсетемін.
Dialogue: 0,0:03:40.42,0:03:41.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:41.51,0:03:43.84,Default,,0,0,0,,Бұл аңыз Спригган емес пе?
Dialogue: 0,0:03:44.59,0:03:46.85,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:03:46.93,0:03:48.85,Default,,0,0,0,,Күшті көрінеді
Dialogue: 0,0:03:48.93,0:03:51.27,Default,,0,0,0,,Спригган реквиемі?
Dialogue: 0,0:03:51.81,0:03:54.31,Default,,0,0,0,,
Dialogue: 0,0:03:56.81,0:03:59.73,Default,,0,0,0,,Хехехехе, жүр, көрсетші.
Dialogue: 0,0:04:00.24,0:04:03.74,Default,,0,0,0,,Спригган Реквиеммен ең жақсы шайқас
Dialogue: 0,0:04:06.57,0:04:09.04,Default,,0,0,0,,Мен осы күнге...
Dialogue: 0,0:04:09.16,0:04:11.87,Default,,0,0,0,,Қызыл көзді жеңу үшін осы уақытқа дейін келдім.
Dialogue: 0,0:04:13.96,0:04:15.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:15.63,0:04:16.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:17.71,0:04:19.25,Default,,0,0,0,,Өзі соққыны қабылдауға дайын қарсы шабуыл!
Dialogue: 0,0:04:19.88,0:04:23.68,Default,,0,0,0,,Жылан шұңқырында аман қалғың келсе, мықты бол.
Dialogue: 0,0:04:26.93,0:04:28.39,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:29.64,0:04:31.10,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:04:31.22,0:04:32.23,Default,,0,0,0,,Ах
Dialogue: 0,0:04:34.69,0:04:36.56,Default,,0,0,0,,Бұл Арк Бахамут
Dialogue: 0,0:04:36.81,0:04:39.32,Default,,0,0,0,,Сіз күш жинап жатырсыз, Боа.
Dialogue: 0,0:04:39.73,0:04:42.53,Default,,0,0,0,,Бір күні көзің қызыл болады
Dialogue: 0,0:04:54.00,0:04:55.29,Default,,0,0,0,,Сіз...
Dialogue: 0,0:04:55.79,0:04:58.38,Default,,0,0,0,,Мен сені ең мықты деп сендім
Dialogue: 0,0:04:59.38,0:05:01.38,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:05:02.71,0:05:04.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:05.38,0:05:06.76,Default,,0,0,0,,Қызыл көз!
Dialogue: 0,0:05:07.47,0:05:09.68,Default,,0,0,0,,Сенен көңілім қалды!
Dialogue: 0,0:05:10.76,0:05:12.89,Default,,0,0,0,,Қандай шығанақ болса да, мен жеңемін!
Dialogue: 0,0:05:13.89,0:05:16.02,Default,,0,0,0,,Мен биікке көтерілемін!
Dialogue: 0,0:05:17.94,0:05:19.11,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:05:19.61,0:05:21.36,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:05:22.53,0:05:24.44,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:05:24.53,0:05:28.07,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:28.45,0:05:31.95,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:40.88,0:05:43.92,Default,,0,0,0,,Спригган реквиемінің қозғалысы Мұқият қараңыз.
Dialogue: 0,0:05:44.01,0:05:44.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:45.67,0:05:47.59,Default,,0,0,0,,Уау Уау Уау!
Dialogue: 0,0:05:47.68,0:05:51.26,Default,,0,0,0,,Арх Бахамуттың Сакурецуге шабуылы!
Dialogue: 0,0:05:53.47,0:05:56.52,Default,,0,0,0,,Тек! Спригган реквиемі
Dialogue: 0,0:05:56.60,0:06:00.15,Default,,0,0,0,,Резеңке қабат қуатты сіңірді!
Dialogue: 0,0:06:00.48,0:06:01.65,Default,,0,0,0,,Керемет
Dialogue: 0,0:06:01.73,0:06:04.48,Default,,0,0,0,,Сіз шынымен Фафнир сияқты техниканы пайдалана алмайсыз ба?
Dialogue: 0,0:06:04.57,0:06:08.95,Default,,0,0,0,,Және ол тепе-теңдік типі болса да, төзімділік түрі сияқты қозғалады.
Dialogue: 0,0:06:10.74,0:06:11.82,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:06:12.03,0:06:13.28,Default,,0,0,0,,Сіз Титантардың бір-бірімен шайқасып жатқанын айтасыз ба?
Dialogue: 0,0:06:13.37,0:06:15.12,Default,,0,0,0,,Реквиемді айналдыру!
Dialogue: 0,0:06:29.72,0:06:32.35,Default,,0,0,0,,Spriggan Requiem Spin Finish
Dialogue: 0,0:06:32.43,0:06:34.06,Default,,0,0,0,,1-ден 0-ге дейінгі нүктелер
Dialogue: 0,0:06:34.18,0:06:36.18,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:36.47,0:06:37.81,Default,,0,0,0,,Шудың бірі
Dialogue: 0,0:06:37.89,0:06:40.69,Default,,0,0,0,,Мен керемет күшті бек алдым.
Dialogue: 0,0:06:40.77,0:06:41.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:41.90,0:06:42.98,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:43.27,0:06:44.61,Default,,0,0,0,,Боа!
Dialogue: 0,0:06:46.11,0:06:48.15,Default,,0,0,0,,Боа! Берілме!
Dialogue: 0,0:06:48.82,0:06:50.28,Default,,0,0,0,,Бұл солтүстік-батырдағы қала ма?
Dialogue: 0,0:06:54.58,0:06:55.95,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:06:57.83,0:07:00.42,Default,,0,0,0,,Мен оның ұпай жинайтынына сенімдімін.
Dialogue: 0,0:07:03.71,0:07:05.13,Default,,0,0,0,,Содан кейін келесі жолы!
Dialogue: 0,0:07:05.42,0:07:07.09,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:07:07.46,0:07:10.47,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:10.55,0:07:14.18,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:19.52,0:07:21.14,Default,,0,0,0,,Сонымен, ол келді ме?
Dialogue: 0,0:07:21.23,0:07:24.77,Default,,0,0,0,,Қызыл көз! Мен сенің қозғалысыңнан бас тарттым!
Dialogue: 0,0:07:32.11,0:07:37.16,Default,,0,0,0,,О? Arc Bahamut Бұл резеңке бөліктен аулақ болатын шабуыл.
Dialogue: 0,0:07:41.21,0:07:43.83,Default,,0,0,0,,Сіздің уақытыңыз аяқталды!
Dialogue: 0,0:07:45.33,0:07:47.21,Default,,0,0,0,,Арқа Бахамут!
Dialogue: 0,0:07:50.97,0:07:52.51,Default,,0,0,0,,(үру)
Dialogue: 0,0:07:56.85,0:07:59.93,Default,,0,0,0,,Соңғы апат!
Dialogue: 0,0:08:11.24,0:08:12.78,Default,,0,0,0,,Уау~
Dialogue: 0,0:08:12.86,0:08:16.70,Default,,0,0,0,,Көктемгі реквием пайда болды! Күшті соққы!
Dialogue: 0,0:08:16.78,0:08:17.91,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:08:18.12,0:08:20.70,Default,,0,0,0,,Бахамут аркасы
Dialogue: 0,0:08:20.79,0:08:22.50,Default,,0,0,0,,1-1 тармақтар
Dialogue: 0,0:08:22.58,0:08:23.75,Default,,0,0,0,,
Dialogue: 0,0:08:23.92,0:08:25.96,Default,,0,0,0,,Шудан ұрланған ұпайлар
Dialogue: 0,0:08:26.04,0:08:29.21,Default,,0,0,0,,Енді кім жеңетінін білмеймін.
Dialogue: 0,0:08:29.42,0:08:31.59,Default,,0,0,0,,Хяхаха, әлгі бейбақ жеңіліп қалды.
Dialogue: 0,0:08:31.67,0:08:34.51,Default,,0,0,0,,Сәлем! (дөрекі күлкі)
Dialogue: 0,0:08:34.59,0:08:36.18,Default,,0,0,0,,Дамаре
Dialogue: 0,0:08:37.14,0:08:38.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:41.22,0:08:44.52,Default,,0,0,0,,Я, бұл мені көп жағынан қызықтырады.
Dialogue: 0,0:08:44.85,0:08:48.06,Default,,0,0,0,,Спригган Реквиемнің қарсыласы осындай болуы керек.
Dialogue: 0,0:08:48.86,0:08:50.90,Default,,0,0,0,,Боа Мұны істеу қиын.
Dialogue: 0,0:08:51.69,0:08:55.03,Default,,0,0,0,,Бірақ «Қызыл көз» соншалықты мықты қарсылас емес.
Dialogue: 0,0:08:55.24,0:08:56.45,Default,,0,0,0,,Керемет, Боа!
Dialogue: 0,0:08:56.53,0:08:58.37,Default,,0,0,0,,Енді галстук!
Dialogue: 0,0:09:00.12,0:09:02.08,Default,,0,0,0,,Мен де үшінші шайқаста боламын!
Dialogue: 0,0:09:02.16,0:09:03.20,Default,,0,0,0,,Брандо мырза
Dialogue: 0,0:09:05.96,0:09:06.87,Default,,0,0,0,,Ах
Dialogue: 0,0:09:07.75,0:09:10.42,Default,,0,0,0,,Мен сені құртамын!
Dialogue: 0,0:09:11.30,0:09:15.47,Default,,0,0,0,,Әй, құдай-ау, қызыл көздің шайтандық көрінісі.
Dialogue: 0,0:09:15.55,0:09:17.13,Default,,0,0,0,,Бұл не рух?
Dialogue: 0,0:09:17.34,0:09:19.72,Default,,0,0,0,,Бұл қорқынышты Иә...
Dialogue: 0,0:09:20.18,0:09:23.18,Default,,0,0,0,,Рух әлсіз нәрсе емес.
Dialogue: 0,0:09:23.27,0:09:24.77,Default,,0,0,0,,Бұл кісі өлтіру ниеті болды.
Dialogue: 0,0:09:24.89,0:09:25.89,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:28.44,0:09:30.94,Default,,0,0,0,,Ол шынымен Шу ма?
Dialogue: 0,0:09:31.27,0:09:33.65,Default,,0,0,0,,(қозғалған)
Dialogue: 0,0:09:34.11,0:09:37.70,Default,,0,0,0,,Кісі өлтіру ниетінің деңгейі мені жоймайды, солай ма?
Dialogue: 0,0:09:38.03,0:09:39.70,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:09:39.95,0:09:41.62,Default,,0,0,0,,Мен сені өлтіремін!
Dialogue: 0,0:09:43.74,0:09:45.54,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:09:45.62,0:09:49.00,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:49.08,0:09:50.84,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:09:52.17,0:09:53.30,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:09:55.34,0:10:00.26,Default,,0,0,0,,Спригган реквиемі Бұл жолы мен солға бұрыла алдым!
Dialogue: 0,0:10:00.34,0:10:02.01,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:10:02.10,0:10:03.56,Default,,0,0,0,,шығанақтың сипаттамалары:
Dialogue: 0,0:10:03.64,0:10:06.06,Default,,0,0,0,,Бұл оның аңыз Спригганмен бірдей екенін білдіре ме?
Dialogue: 0,0:10:06.52,0:10:09.15,Default,,0,0,0,,Бұл жалғыз мүмкіндік емес.
Dialogue: 0,0:10:09.23,0:10:10.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:14.15,0:10:16.78,Default,,0,0,0,,Бұл шабуыл түріндегі қозғалыс па?
Dialogue: 0,0:10:17.03,0:10:18.99,Default,,0,0,0,,Спригган реквиемі!
Dialogue: 0,0:10:27.41,0:10:29.12,Default,,0,0,0,,Мен жеңімпазмын!
Dialogue: 0,0:10:29.79,0:10:32.13,Default,,0,0,0,,Арка Бахамут!
Dialogue: 0,0:10:32.96,0:10:34.34,Default,,0,0,0,,Соңғы күзет!
Dialogue: 0,0:10:34.92,0:10:35.88,Default,,0,0,0,,Брандо мырза
Dialogue: 0,0:10:38.63,0:10:40.89,Default,,0,0,0,,Слеш реквиемі!
Dialogue: 0,0:10:42.97,0:10:44.06,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:10:47.43,0:10:48.81,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:10:49.85,0:10:50.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:52.23,0:10:54.94,Default,,0,0,0,,Спригган реквиемінің жарқырауы
Dialogue: 0,0:10:55.02,0:10:56.82,Default,,0,0,0,,Жеңімпаз қызыл көз!
Dialogue: 0,0:10:56.90,0:10:59.24,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:59.45,0:11:01.03,Default,,0,0,0,,Оу? Оооох!
Dialogue: 0,0:11:02.37,0:11:06.16,Default,,0,0,0,,Қызыл көзді жеңетін мен сияқтымын.
Dialogue: 0,0:11:07.79,0:11:09.96,Default,,0,0,0,,Қарғыс атсын... Қызыл көз!
Dialogue: 0,0:11:10.75,0:11:13.21,Default,,0,0,0,,Мен финалдық турнирге шығамын!
Dialogue: 0,0:11:19.30,0:11:20.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:24.18,0:11:25.26,Default,,0,0,0,,Боа…
Dialogue: 0,0:11:25.68,0:11:27.60,Default,,0,0,0,,Спригган реквиемі
Dialogue: 0,0:11:27.68,0:11:30.60,Default,,0,0,0,,Драйвердің осін өзгертуге болады.
Dialogue: 0,0:11:30.94,0:11:35.69,Default,,0,0,0,,Оны әр шайқас үшін барлық түрлерге өзгертуге болады.
Dialogue: 0,0:11:36.23,0:11:38.40,Default,,0,0,0,,Бұл ең күшті Бей!
Dialogue: 0,0:11:38.82,0:11:40.65,Default,,0,0,0,,Жын алтын таяқ па?
Dialogue: 0,0:11:40.74,0:11:41.61,Default,,0,0,0,,Неапольдың ең үздік жиһаз шебері Марионың ұлы болып дүниеге келген
Dialogue: 0,0:11:41.86,0:11:44.78,Default,,0,0,0,,Ол қазір басқа адам.
Dialogue: 0,0:11:48.33,0:11:49.70,Default,,0,0,0,,Шу…
Dialogue: 0,0:11:56.34,0:11:58.13,Default,,0,0,0,,Әй Шу!
Dialogue: 0,0:11:59.59,0:12:02.13,Default,,0,0,0,,А... Эй, күте тұрыңыз.
Dialogue: 0,0:12:02.88,0:12:04.80,Default,,0,0,0,,Ол шынымен өзгерді ме?
Dialogue: 0,0:12:05.34,0:12:06.64,Default,,0,0,0,,Әй, Шу
Dialogue: 0,0:12:07.68,0:12:08.64,Default,,0,0,0,,Ах
Dialogue: 0,0:12:09.47,0:12:12.94,Default,,0,0,0,,Мен саған Куришудың өлгенін айттым.
Dialogue: 0,0:12:20.86,0:12:22.78,Default,,0,0,0,,Шуу!
Dialogue: 0,0:12:29.37,0:12:30.75,Default,,0,0,0,,Қызыл көз
Dialogue: 0,0:12:32.33,0:12:34.25,Default,,0,0,0,,Осылай жеңіске жете беріңіз
Dialogue: 0,0:12:35.17,0:12:38.79,Default,,0,0,0,,Айтпасаң да бәрін құртамын
Dialogue: 0,0:12:39.59,0:12:40.50,Default,,0,0,0,,Хун
Dialogue: 0,0:12:42.88,0:12:43.88,Default,,0,0,0,,Кук
Dialogue: 0,0:12:45.13,0:12:48.35,Default,,0,0,0,,Жарайсыңдар Құдай Блейдерс Кубогы!
Dialogue: 0,0:12:48.43,0:12:51.64,Default,,0,0,0,,А тобы Келесі сәйкестік картасымен таныстыруға рұқсат етіңіздер.
Dialogue: 0,0:12:52.27,0:12:53.73,Default,,0,0,0,,Үшінші ойын –
Dialogue: 0,0:12:53.81,0:12:57.65,Default,,0,0,0,,Бұл Куза Акерман мен Норман Тарвер арасындағы шайқас.
Dialogue: 0,0:12:57.73,0:13:01.19,Default,,0,0,0,,Қызықты шайқас басталғалы тұр!
Dialogue: 0,0:13:11.91,0:13:13.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:13.70,0:13:16.71,Default,,0,0,0,,Мені күткеніңіз үшін рахмет, досым.
Dialogue: 0,0:13:17.04,0:13:19.75,Default,,0,0,0,,А...? Эй, мен күте алмаймын ...
Dialogue: 0,0:13:20.09,0:13:24.67,Default,,0,0,0,,Жан жарымды жеңістің шыңына шығарамын дедім.
Dialogue: 0,0:13:24.76,0:13:27.26,Default,,0,0,0,,Мен осы мақсатта ақпарат алдым.
Dialogue: 0,0:13:27.34,0:13:28.51,Default,,0,0,0,,Не? ақпарат?
Dialogue: 0,0:13:28.80,0:13:29.89,Default,,0,0,0,,Мен кеше-
Dialogue: 0,0:13:29.97,0:13:32.68,Default,,0,0,0,,Мен Норман Тарвермен төбелесіп қалдым.
Dialogue: 0,0:13:32.77,0:13:34.35,Default,,0,0,0,,Сонда сіз ұрыстыңыз ба?
Dialogue: 0,0:13:34.43,0:13:35.43,Default,,0,0,0,,Не?
Dialogue: 0,0:13:35.52,0:13:38.23,Default,,0,0,0,,Тыңдашы, досым,
Dialogue: 0,0:13:39.23,0:13:42.15,Default,,0,0,0,,Егіз жауды қалай жеңуге болады!
Dialogue: 0,0:13:46.74,0:13:48.16,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:13:48.61,0:13:50.62,Default,,0,0,0,,Мен сенің қаныңды соруға келдім.
Dialogue: 0,0:13:51.53,0:13:52.66,Default,,0,0,0,,Қан?
Dialogue: 0,0:13:52.87,0:13:56.16,Default,,0,0,0,,Иә, сенің Бейіңнің қаны.
Dialogue: 0,0:13:56.54,0:13:59.12,Default,,0,0,0,,Менімен ұрысуға келдің бе?
Dialogue: 0,0:13:59.83,0:14:01.50,Default,,0,0,0,,Енді күресейік
Dialogue: 0,0:14:01.92,0:14:05.63,Default,,0,0,0,,Әй, төбелессіз де нәтиже анық.
Dialogue: 0,0:14:07.68,0:14:11.51,Default,,0,0,0,,Кисама менің қараңғылығыма қамалып, қашып құтыла алмайды!
Dialogue: 0,0:14:13.43,0:14:15.77,Default,,0,0,0,,Хмм... бір рет, солай ма?
Dialogue: 0,0:14:16.02,0:14:19.14,Default,,0,0,0,,Маған қалай күресетінімді көрсет!
Dialogue: 0,0:14:24.44,0:14:28.20,Default,,0,0,0,,Бұдан былай сені жеңетін бек - Егіз Немес.
Dialogue: 0,0:14:28.61,0:14:30.49,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:14:30.57,0:14:34.12,Default,,0,0,0,,Сіз терең хаостың құрбаны боласыз!
Dialogue: 0,0:14:34.24,0:14:36.37,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:14:37.20,0:14:40.75,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:41.04,0:14:44.34,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:50.80,0:14:51.93,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:59.10,0:15:00.77,Default,,0,0,0,,Увахахаха
Dialogue: 0,0:15:00.85,0:15:04.27,Default,,0,0,0,,Егіз жаудың қанын сорайын.
Dialogue: 0,0:15:04.40,0:15:05.48,Default,,0,0,0,,Иә
Dialogue: 0,0:15:11.66,0:15:12.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:16.62,0:15:18.75,Default,,0,0,0,,Ойнау уақыты аяқталды
Dialogue: 0,0:15:19.58,0:15:23.38,Default,,0,0,0,,Сіз маған осындай қабілетпен бірдеңе істеуді сұрасаңыз, мені күлдіреді.
Dialogue: 0,0:15:24.17,0:15:27.17,Default,,0,0,0,,Я, қазір күлу керек.
Dialogue: 0,0:15:27.25,0:15:30.13,Default,,0,0,0,,Күле алатын жалғыз уақыт – бүгін түн
Dialogue: 0,0:15:32.97,0:15:35.76,Default,,0,0,0,,Норман Тарвер шығанағы шабуыл түрі
Dialogue: 0,0:15:35.85,0:15:37.72,Default,,0,0,0,,Оның аты - Егіз Немесис.
Dialogue: 0,0:15:38.39,0:15:39.93,Default,,0,0,0,,Егіз жау...
Dialogue: 0,0:15:40.02,0:15:41.23,Default,,0,0,0,,Немесис!
Dialogue: 0,0:15:41.77,0:15:44.10,Default,,0,0,0,,Сипаттамалардың қабаттарда екенін көрдім
Dialogue: 0,0:15:44.19,0:15:46.32,Default,,0,0,0,,А... қандай сипаттамалар?
Dialogue: 0,0:15:47.02,0:15:50.15,Default,,0,0,0,,Қарсыласын төменнен жұлып алғандай.
Dialogue: 0,0:15:50.24,0:15:51.86,Default,,0,0,0,,Шабуылдарға маманданған
Dialogue: 0,0:15:52.57,0:15:55.28,Default,,0,0,0,,Төменнен алып тастау керек пе?
Dialogue: 0,0:15:55.37,0:15:56.49,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:16:02.21,0:16:04.54,Default,,0,0,0,,Сол күшті жоғарғы шабуыл
Dialogue: 0,0:16:05.04,0:16:07.92,Default,,0,0,0,,Норман Тарвер - авантюрист.
Dialogue: 0,0:16:08.05,0:16:09.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:10.97,0:16:12.55,Default,,0,0,0,,Клиоға рахмет
Dialogue: 0,0:16:13.63,0:16:16.30,Default,,0,0,0,,Нәтижелерімен ризашылығыңызды көрсетіңіз
Dialogue: 0,0:16:16.68,0:16:18.97,Default,,0,0,0,,Тек жеңіп, осы жақсылықты қайтарыңыз.
Dialogue: 0,0:16:19.06,0:16:24.02,Default,,0,0,0,,Иә, эй, мен жеңемін, жеңемін, аман боламын және чемпиондықты жеңемін.
Dialogue: 0,0:16:24.10,0:16:25.23,Default,,0,0,0,,Мисерё!
Dialogue: 0,0:16:25.40,0:16:28.36,Default,,0,0,0,,Мен жағымсыз сөздерді жек көрмеймін.
Dialogue: 0,0:16:28.48,0:16:29.44,Default,,0,0,0,,Эхехе
Dialogue: 0,0:16:29.53,0:16:34.15,Default,,0,0,0,,Енді Егіз жауды қалай жеңуге болатынын жаттықтыруды бастайық.
Dialogue: 0,0:16:34.53,0:16:35.45,Default,,0,0,0,,О!
Dialogue: 0,0:16:36.70,0:16:38.66,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:44.83,0:16:47.54,Default,,0,0,0,,Мен сені құртамын!
Dialogue: 0,0:16:48.13,0:16:50.00,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:50.96,0:16:54.26,Default,,0,0,0,,Мен саған Куришудың өлгенін айттым.
Dialogue: 0,0:16:54.34,0:16:55.30,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:16:59.10,0:17:02.14,Default,,0,0,0,,Ату түсіру!
Dialogue: 0,0:17:03.43,0:17:07.69,Default,,0,0,0,,Даа... хаа ха ха...
Dialogue: 0,0:17:09.36,0:17:11.28,Default,,0,0,0,,Сіз осындай жерде болдыңыз ба?
Dialogue: 0,0:17:12.15,0:17:13.40,Default,,0,0,0,,Сәлем Балто!
Dialogue: 0,0:17:14.24,0:17:16.36,Default,,0,0,0,,Куза ойыны басталғалы тұр.
Dialogue: 0,0:17:16.86,0:17:18.99,Default,,0,0,0,,Не? Сол уақыт әлдеқашан ба?
Dialogue: 0,0:17:19.24,0:17:21.24,Default,,0,0,0,,Ха ха ха ха итта!
Dialogue: 0,0:17:22.20,0:17:25.00,Default,,0,0,0,,Әй, сен қаншалықты үрейлендің?
Dialogue: 0,0:17:27.71,0:17:30.09,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар!
Dialogue: 0,0:17:30.17,0:17:34.72,Default,,0,0,0,,Күткеніңізге рахмет! Үшінші ойын ақыры басталады!
Dialogue: 0,0:17:34.80,0:17:36.18,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:36.63,0:17:39.39,Default,,0,0,0,,Енді, ақырында, екі қуықтың да пайда болатын уақыты келді!
Dialogue: 0,0:17:39.80,0:17:43.68,Default,,0,0,0,,Жылан шұңқырынан шыққан Бладер Норман Тарвер!
Dialogue: 0,0:17:43.77,0:17:46.23,Default,,0,0,0,,Акробатикалық жүздің керемет билеуі
Dialogue: 0,0:17:46.31,0:17:48.40,Default,,0,0,0,,Куза Акерман!
Dialogue: 0,0:17:51.19,0:17:54.49,Default,,0,0,0,,Куза, аздап ұтып, серпін ал!
Dialogue: 0,0:17:54.57,0:17:56.32,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:18:00.37,0:18:03.74,Default,,0,0,0,,Баратын уақыт, тағдырлас досым
Dialogue: 0,0:18:09.83,0:18:11.34,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:18:13.30,0:18:14.76,Default,,0,0,0,,Бұл өкінішті мәңгі бойымен арқалап жүремін.
Dialogue: 0,0:18:14.84,0:18:16.88,Default,,0,0,0,,Керемет.
Dialogue: 0,0:18:16.97,0:18:18.26,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:18:19.34,0:18:21.85,Default,,0,0,0,,Сіздің шығанағыңыз бағындырылды.
Dialogue: 0,0:18:22.89,0:18:25.39,Default,,0,0,0,,Вампир досыңызға сәлем айтыңыз
Dialogue: 0,0:18:25.47,0:18:26.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:27.10,0:18:28.64,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:18:30.60,0:18:32.15,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:32.69,0:18:35.69,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:35.94,0:18:38.24,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:45.41,0:18:50.33,Default,,0,0,0,,Alter Kronos Супер шабуыл режиміндегі алдын ала шабуыл!
Dialogue: 0,0:18:51.17,0:18:52.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:54.04,0:18:55.13,Default,,0,0,0,,Эхехе
Dialogue: 0,0:18:59.13,0:19:00.01,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:19:00.09,0:19:01.30,Default,,0,0,0,,'Егер мен Польнареффтің мұрнына саусағымды тығып қойсам ➡
Dialogue: 0,0:19:01.68,0:19:03.72,Default,,0,0,0,,Тығыз арқанмен секіру!
Dialogue: 0,0:19:04.93,0:19:07.60,Default,,0,0,0,,Жоғарғы шабуыл жасамас бұрын жарылыңыз!
Dialogue: 0,0:19:15.61,0:19:19.11,Default,,0,0,0,,Хмф, сіз оны жеңдім деп ойлайсыз ба?
Dialogue: 0,0:19:19.19,0:19:20.49,Default,,0,0,0,,Мені күлдірме!
Dialogue: 0,0:19:21.16,0:19:22.87,Default,,0,0,0,,Егіз жау!
Dialogue: 0,0:19:29.66,0:19:32.92,Default,,0,0,0,,Жаса! соққы балға
Dialogue: 0,0:19:37.92,0:19:39.21,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:19:39.30,0:19:41.05,Default,,0,0,0,,Қый!
Dialogue: 0,0:19:41.22,0:19:42.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:43.14,0:19:44.80,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:48.89,0:19:51.64,Default,,0,0,0,,Егіз жаудың жарылуы
Dialogue: 0,0:19:51.73,0:19:55.06,Default,,0,0,0,,Жеңімпаз Норман Тарвер 2-0 ұпаймен
Dialogue: 0,0:19:55.61,0:19:57.57,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:19:57.65,0:20:00.36,Default,,0,0,0,,Жұмбақ жүзші Норман Тарвер
Dialogue: 0,0:20:00.44,0:20:02.28,Default,,0,0,0,,Керемет бірінші матч!
Dialogue: 0,0:20:02.99,0:20:04.16,Default,,0,0,0,,Бұл өтірік пе?
Dialogue: 0,0:20:04.24,0:20:05.78,Default,,0,0,0,,Мен Кузаны күтпедім...
Dialogue: 0,0:20:05.87,0:20:07.70,Default,,0,0,0,,Бұл ыңғайсыздық
Dialogue: 0,0:20:08.20,0:20:12.92,Default,,0,0,0,,Бей екі шабуыл үлгісін ауыстыра алатын сияқты.
Dialogue: 0,0:20:13.00,0:20:15.04,Default,,0,0,0,,Шабуыл үлгісін өзгерту керек пе?
Dialogue: 0,0:20:16.92,0:20:17.92,Default,,0,0,0,,Иә
Dialogue: 0,0:20:18.25,0:20:20.17,Default,,0,0,0,,Бұл не шығанақ?
Dialogue: 0,0:20:20.46,0:20:23.76,Default,,0,0,0,,Вампирге тек жоғарғы режим көрсетілді.
Dialogue: 0,0:20:28.39,0:20:32.02,Default,,0,0,0,,Дәл осы Smash режимі сізді жеңді.
Dialogue: 0,0:20:32.39,0:20:33.35,Default,,0,0,0,,Ах
Dialogue: 0,0:20:34.31,0:20:36.10,Default,,0,0,0,,Қабаттың пішіні!
Dialogue: 0,0:20:36.36,0:20:39.11,Default,,0,0,0,,А... Менің ойымша, бұл жоспарланған болды ма?
Dialogue: 0,0:20:39.86,0:20:42.11,Default,,0,0,0,,Кешіріңіз, досым...
Dialogue: 0,0:20:42.36,0:20:45.66,Default,,0,0,0,,Түсіндіңіз бе? Сіз егіз жауды жеңдіңіз.
Dialogue: 0,0:20:45.74,0:20:47.62,Default,,0,0,0,,Бұл жай ғана менің ниетім еді.
Dialogue: 0,0:20:48.20,0:20:49.79,Default,,0,0,0,,Қ–… Сен, порноман!
Dialogue: 0,0:20:50.91,0:20:53.46,Default,,0,0,0,,Бірақ келесі жолы мен жеңемін.
Dialogue: 0,0:20:53.58,0:20:56.75,Default,,0,0,0,,Я, бұл соңғы рет ұрысатынымыз.
Dialogue: 0,0:20:56.83,0:20:57.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:58.29,0:21:00.92,Default,,0,0,0,,Сіз финалдық турнирге шыға алмайсыз.
Dialogue: 0,0:21:01.00,0:21:02.05,Default,,0,0,0,,Не!
Dialogue: 0,0:21:02.13,0:21:04.34,Default,,0,0,0,,Мен жай ғана шындықты айттым.
Dialogue: 0,0:21:05.97,0:21:07.72,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:08.30,0:21:09.93,Default,,0,0,0,,Оу? Оооох!
Dialogue: 0,0:21:10.64,0:21:13.39,Default,,0,0,0,,Менің ойымша, бұл Голдиге де ұнайды.
Dialogue: 0,0:21:13.77,0:21:15.02,Default,,0,0,0,,Осы тонмен...
Dialogue: 0,0:21:15.10,0:21:18.27,Default,,0,0,0,,Спригган реквиемімен күрес.
Dialogue: 0,0:21:22.32,0:21:23.40,Default,,0,0,0,,Куза
Dialogue: 0,0:21:25.70,0:21:27.20,Default,,0,0,0,,Май тәтті болды
Dialogue: 0,0:21:27.28,0:21:31.16,Default,,0,0,0,,Егіз жауды жеңдім деп ойладым... Кешіріңіз.
Dialogue: 0,0:21:32.29,0:21:35.62,Default,,0,0,0,,Қарғыс атқыр, бұл жаман үрдісті тоқтату керек.
Dialogue: 0,0:21:36.00,0:21:38.04,Default,,0,0,0,,Екі рет болған нәрсе үш рет қайталанады.
Dialogue: 0,0:21:38.38,0:21:40.63,Default,,0,0,0,,Осындай уақытта не айтып тұрсың?
Dialogue: 0,0:21:40.96,0:21:43.42,Default,,0,0,0,,Мен мұны сен үшін жасаймын
Dialogue: 0,0:21:43.67,0:21:44.63,Default,,0,0,0,,Cisco?
Dialogue: 0,0:21:45.30,0:21:48.14,Default,,0,0,0,,Мен бұл қараңғы атмосфераны өзгертемін.
Dialogue: 0,0:21:48.89,0:21:51.01,Default,,0,0,0,,Бұл айқай Шайтан
Dialogue: 0,0:21:51.18,0:21:52.47,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:21:55.48,0:21:56.44,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.44,0:21:59.98,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.44,0:21:59.98,Default,,0,0,0,,Жарайсыңдар Ұлдар мен Қыздар Сіз бұлшық еттеріңізді шынықтырасыз ба?
Dialogue: 0,0:22:00.06,0:22:02.98,Default,,0,0,0,,Енді, күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:03.07,0:22:06.86,Default,,0,0,0,,Қозғалыс 1-нұсқаға қарағанда қарқындырақ. Алдымен, алдыңғы эпизодты және көрсетілім уақытын қарастырайық
Dialogue: 0,0:22:06.95,0:22:10.62,Default,,0,0,0,,GO Shoot GO Shoot GO Үлкен ату!
Dialogue: 0,0:22:10.70,0:22:14.33,Default,,0,0,0,,GO Shoot GO Shoot Жылдамдату!
Dialogue: 0,0:22:14.41,0:22:17.91,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:18.00,0:22:21.42,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:21.50,0:22:24.80,Default,,0,0,0,,Хахахаха Бұл жақсы емес пе? Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.88,0:22:28.84,Default,,0,0,0,,Бірақ бұл жерден күшейе түседі, мен қолдарымды және кернеуімді күшейтемін.
Dialogue: 0,0:22:28.93,0:22:32.72,Default,,0,0,0,,GO Shoot GO Shoot Bay Muscle Train Моримори
Dialogue: 0,0:22:32.80,0:22:36.39,Default,,0,0,0,,АЛДЫМ АТТЫ АЛДЫМ АТЫМ Менің атым – құдайдың атысы
Dialogue: 0,0:22:36.48,0:22:40.06,Default,,0,0,0,,Оңға ату Солға ату Оңға ату
Dialogue: 0,0:22:40.15,0:22:43.82,Default,,0,0,0,,Сол жақ ату Оң жақ ату Сол жақта ату
Dialogue: 0,0:22:43.90,0:22:47.57,Default,,0,0,0,,Өткен аптада Осы аптада GO түсірілімін жасап жатырмыз
Dialogue: 0,0:22:47.65,0:22:51.24,Default,,0,0,0,,Осы аптада келесі аптада GO түсіру, ол да жасайды
Dialogue: 0,0:22:51.32,0:22:54.91,Default,,0,0,0,,Күнделікті жаттықтыру GO Барлығы істеп жатқан ату
Dialogue: 0,0:22:54.99,0:22:58.46,Default,,0,0,0,,Жыл бойы көктемде, жазда, күзде және қыста GO түсіреді
Dialogue: 0,0:22:58.54,0:23:00.04,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:23:00.12,0:23:02.67,Default,,0,0,0,,Шығанақ бұлшықеттерін жаттықтыру үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.75,0:23:05.88,Default,,0,0,0,,Сол шиеленіспен шарықтау шегіне жетейік!
Dialogue: 0,0:23:05.96,0:23:09.67,Default,,0,0,0,,Ичи Ни Сан Ши GO түсіріліміне кірісіңіз!
Dialogue: 0,0:23:09.76,0:23:13.18,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Let's Go!
Dialogue: 0,0:23:13.26,0:23:17.02,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Кеттік!
Dialogue: 0,0:23:17.10,0:23:19.94,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:19.94,0:23:21.94,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:19.94,0:23:21.94,Default,,0,0,0,,~♪
Dialogue: 0,0:23:21.94,0:23:22.02,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.02,0:23:25.02,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.02,0:23:25.02,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:25.02,0:23:25.44,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.98,0:23:29.03,Default,,0,0,0,,Shaka мен Cisco қарсы тұрады
Dialogue: 0,0:23:29.15,0:23:32.36,Default,,0,0,0,,Не? Вакия Сисконың эксклюзивті жаттықтырушысы ма?
Dialogue: 0,0:23:33.03,0:23:37.24,Default,,0,0,0,,Шака Кешіріңіз, бірақ бұл жолы мен Cisco-ны қолданатын боламын.
Dialogue: 0,0:23:37.33,0:23:40.04,Default,,0,0,0,,Содан мен Кузамен соқтығысамын
Dialogue: 0,0:23:41.12,0:23:43.38,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.46,0:23:45.92,Default,,0,0,0,,Қаһарлы! BC Соль шайқасы!
Dialogue: 0,0:23:46.00,0:23:50.05,Default,,0,0,0,,Үш екі бір ату!
