Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.21,0:00:07.00,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:09.88,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.43,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:20.06,0:00:24.35,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.06,0:00:29.77,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:31.03,0:00:34.61,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:34.78,0:00:38.49,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:45.08,0:00:46.46,Default,,0,0,0,,Қарсы үзіліс!
Dialogue: 0,0:00:46.54,0:00:47.96,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:00:48.04,0:00:49.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:52.30,0:00:53.59,Default,,0,0,0,,Жоғарғы түсірілім!
Dialogue: 0,0:00:54.76,0:00:56.47,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:00:56.55,0:00:57.72,Default,,0,0,0,,Бұл...
Dialogue: 0,0:01:02.02,0:01:04.43,Default,,0,0,0,,Валькири әлі де осында.
Dialogue: 0,0:01:04.52,0:01:08.77,Default,,0,0,0,,Иә, Валькири! Құдай қайта жүкте!
Dialogue: 0,0:01:11.73,0:01:13.19,Default,,0,0,0,,Балта ату!
Dialogue: 0,0:01:20.83,0:01:22.62,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:23.83,0:01:24.91,Default,,0,0,0,,Не!
Dialogue: 0,0:01:26.58,0:01:31.50,Default,,0,0,0,,Біз Red Eye пайдаланатын Легенд Спригганнан толығымен жеңіліп қалдық.
Dialogue: 0,0:01:31.59,0:01:33.59,Default,,0,0,0,,Бұл өте жиіркенішті!
Dialogue: 0,0:01:33.67,0:01:36.30,Default,,0,0,0,,(Ұшақтың ызылдаған дыбысы)
Dialogue: 0,0:01:36.42,0:01:42.60,Default,,0,0,0,,Қызыл көз, мен сені бұл жолы міндетті түрде жеңемін!
Dialogue: 0,0:01:44.52,0:01:47.19,Default,,0,0,0,,♪~
Dialogue: 0,0:01:47.27,0:01:49.69,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:49.77,0:01:52.27,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:52.36,0:01:54.65,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:54.73,0:01:57.20,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:57.28,0:01:58.91,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:58.99,0:02:03.12,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:04.08,0:02:08.83,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:08.92,0:02:13.29,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:14.05,0:02:18.68,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:18.76,0:02:23.68,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:23.76,0:02:28.64,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:28.73,0:02:33.73,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:33.82,0:02:37.03,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:37.11,0:02:38.70,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:38.78,0:02:41.16,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:41.24,0:02:43.53,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:43.62,0:02:45.91,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:45.99,0:02:47.16,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:47.25,0:02:48.83,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:48.91,0:02:51.33,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:51.42,0:02:57.38,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:57.46,0:03:01.76,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:03:01.84,0:03:04.51,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:04.60,0:03:07.06,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:07.14,0:03:09.73,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:09.81,0:03:13.90,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:09.81,0:03:13.90,Default,,0,0,0,,~♪
Dialogue: 0,0:03:15.36,0:03:17.86,Default,,0,0,0,,Жарылыс! BC Sol!
Dialogue: 0,0:03:19.32,0:03:22.91,Default,,0,0,0,,Бұл рас! Ішке кіргенде пирамидаға қараңыз.
Dialogue: 0,0:03:22.99,0:03:25.28,Default,,0,0,0,,Бетперде таққан көпіршіктер бар.
Dialogue: 0,0:03:25.37,0:03:26.91,Default,,0,0,0,,Мен олармен жарыстым.
Dialogue: 0,0:03:27.37,0:03:30.79,Default,,0,0,0,,Олардың ішінде Қызыл көз деп аталатыны ең күшті.
Dialogue: 0,0:03:30.87,0:03:32.54,Default,,0,0,0,,Мен жеңілдім.
Dialogue: 0,0:03:32.92,0:03:36.25,Default,,0,0,0,,Пирамидалар мен бетперде киген пышақтарға сене аласыз ба?
Dialogue: 0,0:03:36.42,0:03:39.38,Default,,0,0,0,,Ұрысқанбыз, өтірік емес
Dialogue: 0,0:03:39.46,0:03:40.59,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:03:40.67,0:03:42.59,Default,,0,0,0,,Мен саған сенемін.
Dialogue: 0,0:03:42.68,0:03:44.30,Default,,0,0,0,,О! Сол кезде
Dialogue: 0,0:03:44.39,0:03:47.14,Default,,0,0,0,,Мен Валькирияның жаңа техникасын таптым.
Dialogue: 0,0:03:47.22,0:03:48.60,Default,,0,0,0,,Е! Не?
Dialogue: 0,0:03:48.68,0:03:49.89,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:49.97,0:03:52.39,Default,,0,0,0,,Құдайды қайта жүктеңіз
Dialogue: 0,0:03:53.73,0:03:56.48,Default,,0,0,0,,Осы жерден мені шегіне дейін итермеледі
Dialogue: 0,0:03:56.56,0:04:00.11,Default,,0,0,0,,Моккай зеңбірек жылдамдығын арттырып, қарсы шабуыл жасай алады.
Dialogue: 0,0:04:00.24,0:04:02.82,Default,,0,0,0,,Құдай қайта жүктей ме?
Dialogue: 0,0:04:07.95,0:04:11.50,Default,,0,0,0,,Бұл мылтық! Бар! Құдай қайта жүкте!
Dialogue: 0,0:04:19.00,0:04:19.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:20.00,0:04:22.26,Default,,0,0,0,,Бұл құдайдың қайта жүктеуі ме?
Dialogue: 0,0:04:22.55,0:04:25.59,Default,,0,0,0,,Жоқ, бұл Мылтық болуы керек...
Dialogue: 0,0:04:25.93,0:04:27.76,Default,,0,0,0,,солай емес пе?
Dialogue: 0,0:04:27.85,0:04:29.89,Default,,0,0,0,,Мен оны әлі меңгерген жоқпын.
Dialogue: 0,0:04:29.97,0:04:32.60,Default,,0,0,0,,Мен Құдайды қайта жүктеуді міндетті түрде меңгеремін.
Dialogue: 0,0:04:32.68,0:04:34.85,Default,,0,0,0,,Жұмыс бітпейінше қыңырлық туралы ештеңе айтпа.
Dialogue: 0,0:04:34.94,0:04:36.40,Default,,0,0,0,,Үнсіз орындау
Dialogue: 0,0:04:36.65,0:04:37.98,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:04:38.06,0:04:40.82,Default,,0,0,0,,Барлығына! Бұл қиын!
Dialogue: 0,0:04:41.94,0:04:43.61,Default,,0,0,0,,Мен сізге айтуым керек еді.
Dialogue: 0,0:04:43.70,0:04:46.03,Default,,0,0,0,,Бұлай жалғаса берсе, BC Sol пайдасыз болып қалады!
Dialogue: 0,0:04:46.11,0:04:48.24,Default,,0,0,0,,Ештеңе жаман болған жоқ.
Dialogue: 0,0:04:48.32,0:04:52.83,Default,,0,0,0,,Дүниежүзілік лигаға әрең жеткеніміз рас.
Dialogue: 0,0:04:53.04,0:04:56.29,Default,,0,0,0,,Бірақ алдыңғы BC Сол жеңген үміткер болуы керек еді.
Dialogue: 0,0:04:56.92,0:04:59.04,Default,,0,0,0,,Себебі... Тегін сонда болды.
Dialogue: 0,0:04:59.46,0:05:01.42,Default,,0,0,0,,Еркін қуат жалғыз күш емес
Dialogue: 0,0:05:01.50,0:05:05.76,Default,,0,0,0,,Бұрын бізде дәстүрдің құдіреті бар еді, қазір ол жоқ.
Dialogue: 0,0:05:06.30,0:05:10.01,Default,,0,0,0,,Бұл сіз қалаған команда болмауы мүмкін, бірақ
Dialogue: 0,0:05:10.60,0:05:13.27,Default,,0,0,0,,The team is definitely getting stronger.
Dialogue: 0,0:05:15.56,0:05:18.98,Default,,0,0,0,,Кристің осылай ойлағаны маған ауыр тиді.
Dialogue: 0,0:05:19.27,0:05:20.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:20.52,0:05:24.11,Default,,0,0,0,,Сіз менің істегенімнің бәрін жоққа шығарасыз.
Dialogue: 0,0:05:24.53,0:05:26.11,Default,,0,0,0,,Мен олай айтқан жоқпын.
Dialogue: 0,0:05:26.82,0:05:29.57,Default,,0,0,0,,Мен өз командамды қалай күшті ете аламын?
Dialogue: 0,0:05:29.66,0:05:32.41,Default,,0,0,0,,I've been thinking about how to win.
Dialogue: 0,0:05:32.49,0:05:35.00,Default,,0,0,0,,Мен сені жоққа шығарған жоқпын.
Dialogue: 0,0:05:35.41,0:05:36.58,Default,,0,0,0,,Сауда...
Dialogue: 0,0:05:36.66,0:05:38.37,Default,,0,0,0,,Дұрыс па? Бұл қиын, солай емес пе?
Dialogue: 0,0:05:38.62,0:05:40.38,Default,,0,0,0,,Мометенна
Dialogue: 0,0:05:40.79,0:05:43.88,Default,,0,0,0,,The World League is about to start...
Dialogue: 0,0:05:44.17,0:05:46.34,Default,,0,0,0,,Қазіргі BC Sol болатыны рас
Dialogue: 0,0:05:46.42,0:05:48.89,Default,,0,0,0,,Бұл мен осы уақытқа дейін көтерген команда емес.
Dialogue: 0,0:05:49.26,0:05:51.85,Default,,0,0,0,,Сондықтан мен бұл командадан кетемін...
Dialogue: 0,0:05:51.93,0:05:54.43,Default,,0,0,0,,Қорытынды жасамас бұрын біраз күтіңіз.
Dialogue: 0,0:05:56.39,0:05:58.02,Default,,0,0,0,,Дұрыс? Сауда...
Dialogue: 0,0:05:58.73,0:06:00.15,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:06:01.86,0:06:03.19,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:09.36,0:06:11.53,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:06:12.12,0:06:14.58,Default,,0,0,0,,Тора мырза, қорытынды қандай?
Dialogue: 0,0:06:15.08,0:06:16.37,Default,,0,0,0,,Тыныш
Dialogue: 0,0:06:29.22,0:06:31.30,Default,,0,0,0,,Теме бұл... Куза!
Dialogue: 0,0:06:31.39,0:06:33.47,Default,,0,0,0,,Сәлем! (Карл) Иә
Dialogue: 0,0:06:33.55,0:06:35.10,Default,,0,0,0,,BC Sol Blader?
Dialogue: 0,0:06:35.77,0:06:37.43,Default,,0,0,0,,Сол жерден төмен түс!
Dialogue: 0,0:06:42.94,0:06:46.86,Default,,0,0,0,,Балто сонда ма? Мен Балтонды көруге келдім.
Dialogue: 0,0:06:47.19,0:06:49.45,Default,,0,0,0,,After that, come here!
Dialogue: 0,0:06:49.53,0:06:51.16,Default,,0,0,0,,Әй, сен не істеп жатырсың?
Dialogue: 0,0:06:51.86,0:06:53.20,Default,,0,0,0,,Қайда барасың?
Dialogue: 0,0:06:53.28,0:06:55.87,Default,,0,0,0,,Жібер!
Dialogue: 0,0:06:56.16,0:06:57.75,Default,,0,0,0,,Кенеттен!
Dialogue: 0,0:06:58.16,0:07:00.79,Default,,0,0,0,,Оресаманың Крисатанымен жарысыңыз!
Dialogue: 0,0:07:00.87,0:07:03.50,Default,,0,0,0,,А, мен білемін, Шайтанды жылат!
Dialogue: 0,0:07:03.79,0:07:06.46,Default,,0,0,0,,Мен көрдім. Бұл ролик пе?
Dialogue: 0,0:07:06.67,0:07:10.13,Default,,0,0,0,,Уау! The loop driver also has rollers.
Dialogue: 0,0:07:10.22,0:07:11.51,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:11.59,0:07:13.26,Default,,0,0,0,,Алданбаңыз!
Dialogue: 0,0:07:13.34,0:07:15.26,Default,,0,0,0,,Маған тиіспе!
Dialogue: 0,0:07:15.35,0:07:18.14,Default,,0,0,0,,Бұл Cisco-sama шайқас жасайтынын айтты.
Dialogue: 0,0:07:18.22,0:07:19.48,Default,,0,0,0,,Дайында, Куза!
Dialogue: 0,0:07:19.89,0:07:23.81,Default,,0,0,0,,Сіз Ciscoсыз ба? Мен сенің атыңды естідім.
Dialogue: 0,0:07:24.15,0:07:25.73,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:07:29.40,0:07:30.70,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:31.20,0:07:32.57,Default,,0,0,0,,Бұл... Куза ма?
Dialogue: 0,0:07:36.95,0:07:38.54,Default,,0,0,0,,Let's do it, Kuza.
Dialogue: 0,0:07:38.83,0:07:40.79,Default,,0,0,0,,Сәлем Cisco
Dialogue: 0,0:07:41.37,0:07:43.54,Default,,0,0,0,,О ла ла, тағы бір рет!
Dialogue: 0,0:07:43.83,0:07:45.50,Default,,0,0,0,,«Супер Айджа».
Dialogue: 0,0:07:46.13,0:07:48.05,Default,,0,0,0,,Cisco көмегімен?
Dialogue: 0,0:07:53.80,0:07:57.14,Default,,0,0,0,,Тағы бір ұтыс... Тағы бір рет.
Dialogue: 0,0:07:57.60,0:07:59.10,Default,,0,0,0,,Таримейо!
Dialogue: 0,0:08:03.06,0:08:05.06,Default,,0,0,0,,Мойкайдаё!
Dialogue: 0,0:08:05.77,0:08:06.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:06.98,0:08:08.94,Default,,0,0,0,,Мен бірдеңе естідім деп ойлаймын...
Dialogue: 0,0:08:09.03,0:08:12.15,Default,,0,0,0,,Жарайды! Мен оны осы жолы шешемін!
Dialogue: 0,0:08:12.24,0:08:13.45,Default,,0,0,0,,Бұл Куза!
Dialogue: 0,0:08:15.24,0:08:17.74,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:24.29,0:08:26.75,Default,,0,0,0,,Жүр! (Куза) Шабуыл!
Dialogue: 0,0:08:26.96,0:08:29.55,Default,,0,0,0,,Ах! екінші ойлар туралы! (Рантаро) Куза!
Dialogue: 0,0:08:29.63,0:08:31.30,Default,,0,0,0,,Cisco-мен шайқас
Dialogue: 0,0:08:31.38,0:08:32.72,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:32.84,0:08:35.80,Default,,0,0,0,,О! Циклондық цикл!
Dialogue: 0,0:08:36.84,0:08:38.85,Default,,0,0,0,,Сырғымалы түсірілім!
Dialogue: 0,0:08:44.06,0:08:45.27,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:08:45.35,0:08:46.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:46.85,0:08:49.94,Default,,0,0,0,,Қайта сызу керек пе? Бұл қатал жігіт.
Dialogue: 0,0:08:50.53,0:08:52.28,Default,,0,0,0,,Cisco Carlyle
Dialogue: 0,0:08:52.36,0:08:55.82,Default,,0,0,0,,I've heard rumors, but his ability is real.
Dialogue: 0,0:08:56.16,0:08:59.08,Default,,0,0,0,,Айтсаң да, көңілім толмайды.
Dialogue: 0,0:08:59.16,0:09:00.33,Default,,0,0,0,,Мен сені бұл жолы талқандаймын!
Dialogue: 0,0:09:00.58,0:09:02.12,Default,,0,0,0,,Ол сынбайды!
Dialogue: 0,0:09:02.20,0:09:03.79,Default,,0,0,0,,Куза!
Dialogue: 0,0:09:03.87,0:09:05.04,Default,,0,0,0,,Ах! Балтық!
Dialogue: 0,0:09:05.37,0:09:06.42,Default,,0,0,0,,Кумичо да
Dialogue: 0,0:09:06.50,0:09:07.46,Default,,0,0,0,,Ақша, мәртебе және әдемі әйел.
Dialogue: 0,0:09:07.54,0:09:09.04,Default,,0,0,0,,Куза Көптен бері көрмегелі!
Dialogue: 0,0:09:09.13,0:09:12.26,Default,,0,0,0,,Біз кеше ғана Мексикада кездестік!
Dialogue: 0,0:09:12.59,0:09:16.88,Default,,0,0,0,,What does Top Vant's ace need from BC Sol?
Dialogue: 0,0:09:17.26,0:09:20.51,Default,,0,0,0,,Балт, мені БК Сольге сал.
Dialogue: 0,0:09:20.60,0:09:21.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:21.60,0:09:22.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:22.60,0:09:23.77,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:09:24.06,0:09:25.77,Default,,0,0,0,,Жаңа ғана не ұстадың?
Dialogue: 0,0:09:26.19,0:09:28.02,Default,,0,0,0,,Оны BC Sol
Dialogue: 0,0:09:28.56,0:09:30.90,Default,,0,0,0,,Қалжыңдаудан қорықпа.
Dialogue: 0,0:09:30.98,0:09:33.69,Default,,0,0,0,,Мен Балтомен бір командада болғым келді.
Dialogue: 0,0:09:34.07,0:09:37.24,Default,,0,0,0,,Өйткені Балтомен бірге болу өте қызық!
Dialogue: 0,0:09:37.61,0:09:39.16,Default,,0,0,0,,Сәлем! Жақсы емес пе?
Dialogue: 0,0:09:39.53,0:09:41.41,Default,,0,0,0,,Сіз байсалды сияқтысыз.
Dialogue: 0,0:09:41.87,0:09:43.79,Default,,0,0,0,,Мен өте қош келдіңіз.
Dialogue: 0,0:09:43.87,0:09:46.37,Default,,0,0,0,,Жарайсыңдар! Бірге жасайық
Dialogue: 0,0:09:46.46,0:09:47.33,Default,,0,0,0,,О!
Dialogue: 0,0:09:47.42,0:09:48.75,Default,,0,0,0,,Мен де Мен де!
Dialogue: 0,0:09:49.88,0:09:51.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:51.46,0:09:54.63,Default,,0,0,0,,I'm making my own decisions... Is that okay?
Dialogue: 0,0:09:54.71,0:09:56.38,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:09:56.47,0:09:59.59,Default,,0,0,0,,Besides, the battle with Oresama isn't over yet!
Dialogue: 0,0:09:59.93,0:10:03.85,Default,,0,0,0,,Жарайды! Куза: Менімен бірге жаттығуға кел!
Dialogue: 0,0:10:04.22,0:10:06.27,Default,,0,0,0,,Кеттік, арнайы дайындық!
Dialogue: 0,0:10:06.35,0:10:07.81,Default,,0,0,0,,Арнайы дайындық!
Dialogue: 0,0:10:07.89,0:10:09.27,Default,,0,0,0,,Арнайы дайындық!
Dialogue: 0,0:10:09.35,0:10:10.56,Default,,0,0,0,,Токунда!
Dialogue: 0,0:10:10.65,0:10:14.11,Default,,0,0,0,,Эй, күте тұрыңыз! Мені тыңда!
Dialogue: 0,0:10:15.48,0:10:18.82,Default,,0,0,0,,Бұл жігіт Топванттан кетіп қалды.
Dialogue: 0,0:10:19.32,0:10:21.87,Default,,0,0,0,,Барлығы мені ыңғайлы түрде шығарып салды.
Dialogue: 0,0:10:22.24,0:10:25.37,Default,,0,0,0,,Бір рет айтсаң тыңдамайтыныңды білемін.
Dialogue: 0,0:10:25.87,0:10:27.37,Default,,0,0,0,,Сәлем Крис!
Dialogue: 0,0:10:28.54,0:10:30.17,Default,,0,0,0,,Кузаны сол жерге қойыңыз.
Dialogue: 0,0:10:30.79,0:10:32.67,Default,,0,0,0,,Өтінемін! (Карл) Бір жігіт
Dialogue: 0,0:10:33.04,0:10:35.63,Default,,0,0,0,,Менің ойымша, Куза қосылса жақсы болар еді.
Dialogue: 0,0:10:35.71,0:10:36.67,Default,,0,0,0,,Мен де!
Dialogue: 0,0:10:37.55,0:10:39.43,Default,,0,0,0,,Сіз байсалдысыз ба? Куса
Dialogue: 0,0:10:40.55,0:10:42.05,Default,,0,0,0,,Super Honky режимі!
Dialogue: 0,0:10:43.30,0:10:46.43,Default,,0,0,0,,Шынында да, егер Куза BC Сольге қосылса.
Dialogue: 0,0:10:46.52,0:10:48.56,Default,,0,0,0,,Команда міндетті түрде күшейеді.
Dialogue: 0,0:10:48.93,0:10:52.31,Default,,0,0,0,,Балто, Рантаро, Сиско және Куса
Dialogue: 0,0:10:52.77,0:10:55.15,Default,,0,0,0,,Дүниежүзілік лигада жеңіске жету енді арман емес
Dialogue: 0,0:10:56.98,0:10:58.44,Default,,0,0,0,,Иә, Куза!
Dialogue: 0,0:10:58.53,0:10:59.82,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:59.90,0:11:01.03,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:11:01.66,0:11:02.99,Default,,0,0,0,,Құрметпен, баршаңызға
Dialogue: 0,0:11:03.12,0:11:05.70,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,0:11:07.83,0:11:08.87,Default,,0,0,0,,Stan?
Dialogue: 0,0:11:13.50,0:11:15.50,Default,,0,0,0,,Сөздеріңізге назар аударыңыз Крис
Dialogue: 0,0:11:16.30,0:11:19.67,Default,,0,0,0,,Енді сен бейсаналық түрде Стэнді кесіп тастадың.
Dialogue: 0,0:11:22.47,0:11:23.76,Default,,0,0,0,,Бұл өте қызықсыз
Dialogue: 0,0:11:28.93,0:11:30.73,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:11:31.14,0:11:32.90,Default,,0,0,0,,Стэн сонда ма?
Dialogue: 0,0:11:34.56,0:11:35.90,Default,,0,0,0,,Кірейік.
Dialogue: 0,0:11:49.04,0:11:51.54,Default,,0,0,0,,(Андждың гуілдеуі)
Dialogue: 0,0:11:51.62,0:11:54.42,Default,,0,0,0,,Сен Андж Стэнді көрмедің бе?
Dialogue: 0,0:11:54.50,0:11:56.50,Default,,0,0,0,,О, сен жаңа ғана келдің-
Dialogue: 0,0:11:56.59,0:11:59.42,Default,,0,0,0,,Мен ештеңе деместен бір топ чурро алдым.
Dialogue: 0,0:11:59.51,0:12:00.80,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:12:01.63,0:12:02.68,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:04.51,0:12:05.97,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:12:08.72,0:12:11.56,Default,,0,0,0,,Бұл не деген Крис? Ақымақ болма!
Dialogue: 0,0:12:12.23,0:12:15.77,Default,,0,0,0,,Балто, Рантаро, Сиско және Куза
Dialogue: 0,0:12:16.19,0:12:19.28,Default,,0,0,0,,Дүниежүзілік лигада жеңіске жету енді арман емес
Dialogue: 0,0:12:21.11,0:12:22.74,Default,,0,0,0,,Балто мен оның достары келгенге дейін...
Dialogue: 0,0:12:22.82,0:12:25.95,Default,,0,0,0,,Фри, мен және Джанго командаға қолдау көрсетті.
Dialogue: 0,0:12:29.54,0:12:30.91,Default,,0,0,0,,Stan?
Dialogue: 0,0:12:33.54,0:12:34.83,Default,,0,0,0,,Стэн!
Dialogue: 0,0:12:35.88,0:12:37.29,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:12:38.75,0:12:40.00,Default,,0,0,0,,Stan?
Dialogue: 0,0:12:40.88,0:12:43.84,Default,,0,0,0,,Мен не айттым?
Dialogue: 0,0:12:43.92,0:12:45.26,Default,,0,0,0,,Дәл осылай болды...
Dialogue: 0,0:12:45.34,0:12:49.01,Default,,0,0,0,,Енді сен бейсаналық түрде Стэнді кесіп тастадың.
Dialogue: 0,0:12:49.89,0:12:51.77,Default,,0,0,0,,Солай емес пе...
Dialogue: 0,0:12:51.85,0:12:53.18,Default,,0,0,0,,(Шөптің сыбдыры)
Dialogue: 0,0:12:55.31,0:12:56.52,Default,,0,0,0,,Stan?
Dialogue: 0,0:12:58.40,0:12:59.48,Default,,0,0,0,,Stan?
Dialogue: 0,0:13:03.78,0:13:06.45,Default,,0,0,0,,Күрсін... Мені шошытпа.
Dialogue: 0,0:13:09.74,0:13:12.04,Default,,0,0,0,,Не? Бұл бала...
Dialogue: 0,0:13:24.30,0:13:25.59,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:13:25.67,0:13:28.09,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:13:28.55,0:13:29.85,Default,,0,0,0,,(Сирена қосылады)
Dialogue: 0,0:13:32.39,0:13:33.47,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:13:35.60,0:13:36.56,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:13:37.10,0:13:38.60,Default,,0,0,0,,Бұл менің жеңісім.
Dialogue: 0,0:13:39.10,0:13:41.02,Default,,0,0,0,,Тегін Бұл күшті.
Dialogue: 0,0:13:41.11,0:13:42.53,Default,,0,0,0,,Тағы да
Dialogue: 0,0:13:43.98,0:13:48.61,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:13:55.70,0:13:58.37,Default,,0,0,0,,Менің ойымша, біреу оны әлі де пайдаланып жатыр.
Dialogue: 0,0:13:59.38,0:14:00.50,Default,,0,0,0,,Қалай болғанда да?
Dialogue: 0,0:14:00.96,0:14:03.21,Default,,0,0,0,,О, мен Нью-Йоркке барамын.
Dialogue: 0,0:14:03.55,0:14:05.92,Default,,0,0,0,,BC Sol тек сіздің арқаңызда мүмкін.
Dialogue: 0,0:14:06.55,0:14:07.80,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:07.88,0:14:09.64,Default,,0,0,0,,Сонда неге?
Dialogue: 0,0:14:10.47,0:14:11.97,Default,,0,0,0,,Мүмкін сондықтан...
Dialogue: 0,0:14:12.05,0:14:13.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:14.60,0:14:16.31,Default,,0,0,0,,Менсіз де
Dialogue: 0,0:14:16.52,0:14:19.65,Default,,0,0,0,,Крис BC Солды күштірек етеді, солай ма?
Dialogue: 0,0:14:23.27,0:14:25.44,Default,,0,0,0,,BC Соль күшейе түсуде
Dialogue: 0,0:14:26.24,0:14:28.86,Default,,0,0,0,,Күмән жоқ, бірақ...
Dialogue: 0,0:14:28.95,0:14:34.49,Default,,0,0,0,,♪
Dialogue: 0,0:14:34.95,0:14:36.95,Default,,0,0,0,,Бұл жақсы болды ма?
Dialogue: 0,0:14:37.45,0:14:38.37,Default,,0,0,0,,Мен оларды көріп тұрмын
Dialogue: 0,0:14:38.54,0:14:39.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:41.88,0:14:43.71,Default,,0,0,0,,А... сіз қалай ойлайсыз?
Dialogue: 0,0:14:47.01,0:14:48.01,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:50.34,0:14:52.47,Default,,0,0,0,,Мен бұл бөлмені пайдаланамын!
Dialogue: 0,0:14:53.97,0:14:57.73,Default,,0,0,0,,Уау, өте кең! Төсегі де үлкен!
Dialogue: 0,0:14:58.23,0:15:00.27,Default,,0,0,0,,Хехе, жақсы емес пе?
Dialogue: 0,0:15:00.35,0:15:02.10,Default,,0,0,0,,Дәл қазір мұнда бір ғана адам бар.
Dialogue: 0,0:15:02.19,0:15:04.27,Default,,0,0,0,,Бұл бөлме керемет!
Dialogue: 0,0:15:05.32,0:15:08.03,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:15:08.11,0:15:11.11,Default,,0,0,0,,Жоқ! Сен не істеп жатырсың!
Dialogue: 0,0:15:11.20,0:15:12.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:12.28,0:15:14.66,Default,,0,0,0,,Сәлем Cisco, менің бөлмеме қош келдіңіз!
Dialogue: 0,0:15:15.03,0:15:16.87,Default,,0,0,0,,Бұл Оресаманың бөлмесі.
Dialogue: 0,0:15:17.20,0:15:19.04,Default,,0,0,0,,Балалар, бұл жерден кетіңдер!
Dialogue: 0,0:15:21.37,0:15:23.00,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,0:15:23.63,0:15:25.21,Default,,0,0,0,,Бұл цирк, Яроу!
Dialogue: 0,0:15:25.29,0:15:26.50,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:15:26.59,0:15:29.88,Default,,0,0,0,,Жақсы жастық~ Мен оны жақсы күтемін.
Dialogue: 0,0:15:29.97,0:15:34.22,Default,,0,0,0,,Сіз мұны жасадыңыз! Бұл өте керемет!
Dialogue: 0,0:15:41.52,0:15:43.85,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:46.19,0:15:47.69,Default,,0,0,0,,Жүр!
Dialogue: 0,0:15:47.78,0:15:49.65,Default,,0,0,0,,Кронос!
Dialogue: 0,0:16:02.00,0:16:04.17,Default,,0,0,0,,Мен жақсы байланыстамын!
Dialogue: 0,0:16:04.25,0:16:05.42,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:16:07.84,0:16:10.01,Default,,0,0,0,,Арқанмен сүңгіңіз!
Dialogue: 0,0:16:15.55,0:16:16.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:21.48,0:16:24.14,Default,,0,0,0,,Артық мәре үшін Кузаға 1 ұпай
Dialogue: 0,0:16:24.40,0:16:26.48,Default,,0,0,0,,Аники ұпай алды!
Dialogue: 0,0:16:26.56,0:16:28.11,Default,,0,0,0,,Kuza Strong!
Dialogue: 0,0:16:28.98,0:16:30.90,Default,,0,0,0,,Ол тіпті Балтоны жеңді.
Dialogue: 0,0:16:34.24,0:16:35.78,Default,,0,0,0,,Бір сәт!
Dialogue: 0,0:16:36.16,0:16:39.03,Default,,0,0,0,,Куза Теме, бірдеңені ұмытпайсың ба?
Dialogue: 0,0:16:39.66,0:16:40.95,Default,,0,0,0,,Иә? не?
Dialogue: 0,0:16:41.79,0:16:44.79,Default,,0,0,0,,Менімен шайқас әлі біткен жоқ.
Dialogue: 0,0:16:44.87,0:16:47.00,Default,,0,0,0,,О, түсіндім бе? Сіз мұны істегіңіз келе ме?
Dialogue: 0,0:16:47.08,0:16:48.29,Default,,0,0,0,,Әрине!
Dialogue: 0,0:16:48.46,0:16:51.59,Default,,0,0,0,,Ей, менімен шайқас әлі біткен жоқ!
Dialogue: 0,0:16:51.71,0:16:53.09,Default,,0,0,0,,Кейінірек!
Dialogue: 0,0:16:53.17,0:16:54.34,Default,,0,0,0,,Cisco кейінірек!
Dialogue: 0,0:16:54.55,0:16:57.64,Default,,0,0,0,,Куза эффектісі, мен де жасаймын!
Dialogue: 0,0:16:58.30,0:16:59.47,Default,,0,0,0,,Жолдан тез кет!
Dialogue: 0,0:16:59.56,0:17:01.18,Default,,0,0,0,,Маған да істеуге рұқсат етіңіз
Dialogue: 0,0:17:03.31,0:17:06.56,Default,,0,0,0,,Эй, бәрің, Кристі көрмедің бе?
Dialogue: 0,0:17:06.65,0:17:07.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:08.02,0:17:09.44,Default,,0,0,0,,Крис жоқ.
Dialogue: 0,0:17:09.57,0:17:10.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:10.77,0:17:13.07,Default,,0,0,0,,Стэн Сіз бірдеңе білесіз бе?
Dialogue: 0,0:17:13.94,0:17:18.87,Default,,0,0,0,,(іздейтіндердің барлығының дауысы)
Dialogue: 0,0:17:19.53,0:17:21.12,Default,,0,0,0,,Неліктен орманда...
Dialogue: 0,0:17:21.20,0:17:23.20,Default,,0,0,0,,Крис мені іздеп жатыр...
Dialogue: 0,0:17:24.00,0:17:28.29,Default,,0,0,0,,Мен... Криспен бетпе-бет келгім келмегендіктен жасырдым.
Dialogue: 0,0:17:28.67,0:17:30.79,Default,,0,0,0,,А, мен бұл жолды білемін.
Dialogue: 0,0:17:32.13,0:17:33.30,Default,,0,0,0,,Эй!
Dialogue: 0,0:17:33.38,0:17:34.72,Default,,0,0,0,,Жоқ, тіпті қазір де, егер рұқсат етсеңіз…
Dialogue: 0,0:17:45.68,0:17:47.39,Default,,0,0,0,,Міне болды! Крис!
Dialogue: 0,0:17:48.44,0:17:49.86,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:17:53.65,0:17:54.82,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:17:54.90,0:17:55.90,Default,,0,0,0,,Барт?
Dialogue: 0,0:17:57.24,0:18:00.24,Default,,0,0,0,,А... Мен... ұйықтап жатырмын.
Dialogue: 0,0:18:00.32,0:18:01.53,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:01.62,0:18:05.41,Default,,0,0,0,,Сіздің орманға барғаныңызды естігенде, мен сізді осында деп ойладым.
Dialogue: 0,0:18:05.91,0:18:08.29,Default,,0,0,0,,Сіз бұл жерде Балто қолдандыңыз ба?
Dialogue: 0,0:18:08.87,0:18:11.13,Default,,0,0,0,,Тегін мен оны пайдалана аламын деді.
Dialogue: 0,0:18:11.75,0:18:15.17,Default,,0,0,0,,Мұнда сіз үшін тегін бе?
Dialogue: 0,0:18:15.55,0:18:16.76,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:17.97,0:18:20.22,Default,,0,0,0,,Мүмкін тегін...
Dialogue: 0,0:18:20.89,0:18:22.35,Default,,0,0,0,,Э? Не болып жатыр? Неге!?
Dialogue: 0,0:18:23.06,0:18:24.26,Default,,0,0,0,,Крис!
Dialogue: 0,0:18:25.14,0:18:28.69,Default,,0,0,0,,Бәріңізді алаңдатқаным үшін кешіріңіз...
Dialogue: 0,0:18:28.77,0:18:31.06,Default,,0,0,0,,Ол ұйықтап қалды.
Dialogue: 0,0:18:31.15,0:18:33.73,Default,,0,0,0,,Кристің ұйықтауы сирек.
Dialogue: 0,0:18:34.27,0:18:35.73,Default,,0,0,0,,Мұнда не бар?
Dialogue: 0,0:18:35.82,0:18:37.49,Default,,0,0,0,,Осындай жер болған.
Dialogue: 0,0:18:37.86,0:18:40.24,Default,,0,0,0,,Тегін осында жаттығады.
Dialogue: 0,0:18:40.32,0:18:41.37,Default,,0,0,0,,Тегін?
Dialogue: 0,0:18:42.12,0:18:45.20,Default,,0,0,0,,Стэн, мен сенен кешірім сұрағым келеді.
Dialogue: 0,0:18:47.83,0:18:50.87,Default,,0,0,0,,Мен сені ренжітетін бірдеңе айттым...
Dialogue: 0,0:18:51.46,0:18:52.75,Default,,0,0,0,,Мен шынымен кешірім сұраймын
Dialogue: 0,0:18:53.42,0:18:55.00,Default,,0,0,0,,Қателесудің қажеті жоқ.
Dialogue: 0,0:18:55.50,0:18:56.67,Default,,0,0,0,,Stan…
Dialogue: 0,0:18:57.13,0:19:00.30,Default,,0,0,0,,Құзаның құдіреті қазір менікінен асып түсті.
Dialogue: 0,0:19:00.38,0:19:01.97,Default,,0,0,0,,Мен де білемін.
Dialogue: 0,0:19:02.09,0:19:05.97,Default,,0,0,0,,Сондықтан... Сондықтан да! Мен күштірек болғым келеді
Dialogue: 0,0:19:06.43,0:19:08.31,Default,,0,0,0,,Жоқ, күштірек бол!
Dialogue: 0,0:19:08.89,0:19:11.40,Default,,0,0,0,,Крис, маған аударуға рұқсат етіңіз.
Dialogue: 0,0:19:11.73,0:19:12.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:12.86,0:19:14.36,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:19:14.82,0:19:18.07,Default,,0,0,0,,Мен өзімді басқа жерде қайтадан жаттықтырамын.
Dialogue: 0,0:19:18.15,0:19:20.61,Default,,0,0,0,,Ал мен мына балаларды жеңемін.
Dialogue: 0,0:19:21.32,0:19:22.57,Default,,0,0,0,,Stan…
Dialogue: 0,0:19:22.78,0:19:25.78,Default,,0,0,0,,Бұдан былай сендер менің жауларымсыңдар!
Dialogue: 0,0:19:29.04,0:19:30.41,Default,,0,0,0,,Жау?
Dialogue: 0,0:19:30.50,0:19:33.75,Default,,0,0,0,,Бірақ біз де бұдан да күшті боламыз.
Dialogue: 0,0:19:33.83,0:19:35.09,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:19:35.17,0:19:36.38,Default,,0,0,0,,Мен де!
Dialogue: 0,0:19:36.46,0:19:37.59,Default,,0,0,0,,Мен де!
Dialogue: 0,0:19:37.92,0:19:38.96,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:19:39.88,0:19:41.51,Default,,0,0,0,,Бұл команда-
Dialogue: 0,0:19:41.59,0:19:44.47,Default,,0,0,0,,Балт келгеннен бері көп нәрсе өзгерді.
Dialogue: 0,0:19:45.64,0:19:46.85,Default,,0,0,0,,Тегін…
Dialogue: 0,0:19:47.47,0:19:50.27,Default,,0,0,0,,Бұлай болатынын білдіңіз бе?
Dialogue: 0,0:19:58.11,0:19:59.48,Default,,0,0,0,,Іс жүзінде...
Dialogue: 0,0:19:59.74,0:20:03.28,Default,,0,0,0,,Бразилияда Риос деп аталатын Бейблейд клубы бар.
Dialogue: 0,0:20:03.45,0:20:06.45,Default,,0,0,0,,Менің әкем сол доджоның нұсқаушысы.
Dialogue: 0,0:20:07.08,0:20:08.20,Default,,0,0,0,,Риос?
Dialogue: 0,0:20:08.74,0:20:10.16,Default,,0,0,0,,Бұл жақсы команда.
Dialogue: 0,0:20:10.79,0:20:12.46,Default,,0,0,0,,Мені таныстырасың ба?
Dialogue: 0,0:20:12.83,0:20:14.96,Default,,0,0,0,,Балықтың жүрегі болса, ол су жүрегі.
Dialogue: 0,0:20:15.50,0:20:16.67,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:20:17.17,0:20:19.13,Default,,0,0,0,,Ұйықтауға әлі ерте!
Dialogue: 0,0:20:19.71,0:20:20.76,Default,,0,0,0,,Барт…
Dialogue: 0,0:20:21.72,0:20:23.84,Default,,0,0,0,,Стенді жаттықтырайық
Dialogue: 0,0:20:26.55,0:20:30.18,Default,,0,0,0,,Balt God Reboot Міндетті түрде меңгеріңіз!
Dialogue: 0,0:20:30.64,0:20:31.89,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:20:32.14,0:20:35.10,Default,,0,0,0,,Әйтпесе тырысудың қажеті жоқ.
Dialogue: 0,0:20:35.19,0:20:36.86,Default,,0,0,0,,Кеттік, Стэн!
Dialogue: 0,0:20:36.94,0:20:38.61,Default,,0,0,0,,Кел, Балто!
Dialogue: 0,0:20:38.69,0:20:40.82,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:20:41.82,0:20:44.28,Default,,0,0,0,,Дәстүр қорғайтын нәрсе емес
Dialogue: 0,0:20:44.66,0:20:46.99,Default,,0,0,0,,Дәстүр – жаратылған нәрсе
Dialogue: 0,0:20:47.53,0:20:49.58,Default,,0,0,0,,Бұл атаңның сөзі.
Dialogue: 0,0:20:50.83,0:20:52.04,Default,,0,0,0,,Сауда
Dialogue: 0,0:20:52.54,0:20:56.54,Default,,0,0,0,,Жаңа дәстүрді жасай аласың ба, енді өзіңе байланысты.
Dialogue: 0,0:20:59.29,0:21:00.30,Default,,0,0,0,,Сіз барасыз ба?
Dialogue: 0,0:21:00.38,0:21:01.34,Default,,0,0,0,,О
Dialogue: 0,0:21:03.22,0:21:04.80,Default,,0,0,0,,Барлығы үшін рахмет
Dialogue: 0,0:21:09.10,0:21:10.10,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:11.06,0:21:15.73,Default,,0,0,0,,Талдау деректері мен барлық BC Sol пышақтарының сипаттамаларын қамтиды.
Dialogue: 0,0:21:18.15,0:21:19.90,Default,,0,0,0,,Мен Нью-Йоркке көшемін
Dialogue: 0,0:21:20.44,0:21:23.57,Default,,0,0,0,,Келесі кездескенде мен саған жау боламын.
Dialogue: 0,0:21:25.61,0:21:26.57,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:21:37.75,0:21:41.17,Default,,0,0,0,,Әй, бұл шаршаған күн болды.
Dialogue: 0,0:21:41.84,0:21:42.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:42.88,0:21:45.84,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:21:47.18,0:21:49.34,Default,,0,0,0,,А... Түсіндім...
Dialogue: 0,0:21:49.72,0:21:54.14,Default,,0,0,0,,Не болды! ! !
Dialogue: 0,0:21:55.85,0:21:58.40,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.48,0:22:01.82,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:01.90,0:22:04.57,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.65,0:22:06.95,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.03,0:22:10.57,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.66,0:22:14.20,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.29,0:22:16.08,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.16,0:22:17.91,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.00,0:22:19.71,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.79,0:22:21.46,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.54,0:22:23.55,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.63,0:22:26.01,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.09,0:22:29.01,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.09,0:22:32.72,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.80,0:22:36.48,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.56,0:22:38.19,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.27,0:22:41.48,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.56,0:22:43.90,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:43.98,0:22:47.40,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.49,0:22:51.07,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.16,0:22:53.16,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.24,0:22:54.91,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:54.99,0:22:58.41,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.50,0:23:00.50,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.58,0:23:03.50,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.59,0:23:05.80,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:05.88,0:23:09.80,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.88,0:23:13.47,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.55,0:23:17.02,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.10,0:23:20.35,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.44,0:23:22.15,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:20.44,0:23:22.15,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.15,0:23:22.23,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.23,0:23:25.15,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.23,0:23:25.15,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:25.15,0:23:25.44,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.94,0:23:29.24,Default,,0,0,0,,Біз киноға түсеміз деп шешілді!
Dialogue: 0,0:23:29.32,0:23:31.41,Default,,0,0,0,,Басты рөлдегі Джошуа Бун
Dialogue: 0,0:23:31.49,0:23:34.62,Default,,0,0,0,,Не? Үлкен бестіктің бірі және супер супержұлдыз ба?
Dialogue: 0,0:23:34.70,0:23:38.70,Default,,0,0,0,,Крис ханшайымның рөлін ойнағанда, біз зұлымбыз ба?
Dialogue: 0,0:23:38.79,0:23:42.33,Default,,0,0,0,,Ah~ Beyblade Мен бұл фильмге айналады деп үміттенемін
Dialogue: 0,0:23:42.42,0:23:44.46,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:44.54,0:23:46.63,Default,,0,0,0,,Джошуа ғарыштық ниндзяға қарсы
Dialogue: 0,0:23:46.71,0:23:49.80,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.30,0:23:57.30,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory