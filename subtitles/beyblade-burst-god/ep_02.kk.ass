Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.08,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.13,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.39,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:19.97,0:00:24.31,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.10,0:00:29.90,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:33.28,0:00:34.90,Default,,0,0,0,,Құдай…
Dialogue: 0,0:00:36.07,0:00:37.74,Default,,0,0,0,,Құдай Валькирия!
Dialogue: 0,0:00:39.08,0:00:43.37,Default,,0,0,0,,Алып кетпеңіз
Dialogue: 0,0:00:44.16,0:00:46.50,Default,,0,0,0,,Оны жойыңыз! Шайтан!
Dialogue: 0,0:00:48.08,0:00:49.13,Default,,0,0,0,,(Шайтанның айқайы)
Dialogue: 0,0:00:49.25,0:00:52.30,Default,,0,0,0,,Қарсы шабуыл!
Dialogue: 0,0:00:59.68,0:01:02.85,Default,,0,0,0,,Валькирия Құдай Валькирияға айналды
Dialogue: 0,0:01:02.93,0:01:05.89,Default,,0,0,0,,Біз Cisco компаниясының Cry-Satan бағдарламасын жеңдік.
Dialogue: 0,0:01:05.98,0:01:08.86,Default,,0,0,0,,Бұл менің шетелдегі алғашқы жеңісім.
Dialogue: 0,0:01:09.40,0:01:12.15,Default,,0,0,0,,♪~
Dialogue: 0,0:01:12.23,0:01:14.69,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:14.78,0:01:17.11,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:17.20,0:01:19.57,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:19.66,0:01:22.12,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:22.20,0:01:23.70,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:23.83,0:01:28.08,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:29.04,0:01:33.80,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:33.88,0:01:38.38,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:38.89,0:01:43.68,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:01:43.89,0:01:48.65,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:01:48.73,0:01:53.61,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:01:53.69,0:01:58.74,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:01:58.82,0:02:02.03,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:02.12,0:02:03.83,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:03.91,0:02:06.29,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:06.37,0:02:08.62,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:08.71,0:02:10.63,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:10.71,0:02:12.25,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:12.34,0:02:13.88,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:13.96,0:02:16.26,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:16.34,0:02:22.47,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:22.55,0:02:26.77,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:26.85,0:02:29.10,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:29.56,0:02:32.11,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:32.19,0:02:34.11,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:34.19,0:02:36.73,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:36.73,0:02:38.95,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:36.73,0:02:38.95,Default,,0,0,0,,~♪
Dialogue: 0,0:02:40.28,0:02:43.95,Default,,0,0,0,,Адамның жаны! Блэз Рагнарук! !
Dialogue: 0,0:02:52.96,0:02:56.05,Default,,0,0,0,,BC Сольдің үй стадионы жақын арада осында болады.
Dialogue: 0,0:02:56.13,0:02:57.67,Default,,0,0,0,,Е, қайда, қайда, қайда?
Dialogue: 0,0:02:57.76,0:02:59.17,Default,,0,0,0,,Міне
Dialogue: 0,0:03:00.05,0:03:02.97,Default,,0,0,0,,Бұл BC Сольдің Эль-Сантодағы үйі
Dialogue: 0,0:03:03.30,0:03:04.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:04.97,0:03:07.64,Default,,0,0,0,,Бұл барлық Блейдерлер сүйсінетін жер.
Dialogue: 0,0:03:07.97,0:03:10.02,Default,,0,0,0,,Сол жерде шайқас.
Dialogue: 0,0:03:10.23,0:03:12.77,Default,,0,0,0,,Жарайды, мен істеймін.
Dialogue: 0,0:03:18.36,0:03:20.70,Default,,0,0,0,,Ихихи (Күзетші) Бір минут күтіңіз.
Dialogue: 0,0:03:21.15,0:03:24.03,Default,,0,0,0,,Рұқсатсыз одан әрі кіруге болмайды.
Dialogue: 0,0:03:24.49,0:03:27.04,Default,,0,0,0,,Мен BC Sol компаниясының пышақшысымын.
Dialogue: 0,0:03:27.49,0:03:30.87,Default,,0,0,0,,Өтірік айта алмайсың, жүр, үйге қайт.
Dialogue: 0,0:03:31.87,0:03:35.29,Default,,0,0,0,,Сондықтан мені осы топ барлаушы болды!
Dialogue: 0,0:03:35.38,0:03:37.71,Default,,0,0,0,,Аникидің әңгімесін де тыңдаңыз.
Dialogue: 0,0:03:38.13,0:03:39.13,Default,,0,0,0,,Ей!
Dialogue: 0,0:03:39.59,0:03:42.55,Default,,0,0,0,,Бұл бала Жапониядан!
Dialogue: 0,0:03:42.63,0:03:43.30,Default,,0,0,0,,Эй
Dialogue: 0,0:03:43.38,0:03:44.05,Default,,0,0,0,,Әлі де
Dialogue: 0,0:03:44.14,0:03:44.93,Default,,0,0,0,,Мұнда
Dialogue: 0,0:03:45.60,0:03:46.64,Default,,0,0,0,,Хехехе
Dialogue: 0,0:03:46.97,0:03:49.43,Default,,0,0,0,,Өте шулы. Не...
Dialogue: 0,0:03:49.93,0:03:50.73,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:03:50.81,0:03:52.81,Default,,0,0,0,,(жерді жарған дыбыс)
Dialogue: 0,0:03:55.27,0:03:56.40,Default,,0,0,0,,Секірді!
Dialogue: 0,0:03:56.73,0:03:59.61,Default,,0,0,0,,Не... не? Бұл қауіпті!
Dialogue: 0,0:03:59.86,0:04:02.61,Default,,0,0,0,,Өйткені ол кенеттен секіреді.
Dialogue: 0,0:04:02.70,0:04:04.57,Default,,0,0,0,,Сыртқа секірген сен болдың.
Dialogue: 0,0:04:04.66,0:04:07.08,Default,,0,0,0,,Амансың ба? Крис!
Dialogue: 0,0:04:07.41,0:04:09.74,Default,,0,0,0,,Иә, менде бәрі жақсы.
Dialogue: 0,0:04:10.08,0:04:11.54,Default,,0,0,0,,Кешіріңіз, иесі.
Dialogue: 0,0:04:12.66,0:04:16.13,Default,,0,0,0,,А, сен BC Sol компаниясының иесі шығарсың?
Dialogue: 0,0:04:16.21,0:04:17.04,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:04:17.13,0:04:20.13,Default,,0,0,0,,Уау, иесі ғой!
Dialogue: 0,0:04:20.26,0:04:21.51,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:04:21.59,0:04:23.68,Default,,0,0,0,,I, Balt, Balt Aoi
Dialogue: 0,0:04:24.18,0:04:26.18,Default,,0,0,0,,Балто... сіз?
Dialogue: 0,0:04:26.47,0:04:29.64,Default,,0,0,0,,Жоспарланған уақыттан сәл кеш, бірақ мен қазір келдім.
Dialogue: 0,0:04:30.10,0:04:33.06,Default,,0,0,0,,Біраз ұзақ, бір күн!
Dialogue: 0,0:04:33.18,0:04:33.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:33.94,0:04:35.60,Default,,0,0,0,,Сіз көтере алмайтын нәрсенің шегі бар
Dialogue: 0,0:04:35.98,0:04:37.98,Default,,0,0,0,,Сонымен... кешіріңіз!
Dialogue: 0,0:04:38.40,0:04:39.48,Default,,0,0,0,,сөз тіркесі ме?
Dialogue: 0,0:04:39.57,0:04:42.82,Default,,0,0,0,,Бұл адам команданың эксклюзивті шығанақ жаттықтырушысы
Dialogue: 0,0:04:42.90,0:04:44.53,Default,,0,0,0,,Тред Васкес
Dialogue: 0,0:04:44.61,0:04:46.57,Default,,0,0,0,,Кит қайдан біледі?
Dialogue: 0,0:04:47.07,0:04:50.29,Default,,0,0,0,,Кит, сен менімен кездесуге бардың ғой, солай ма?
Dialogue: 0,0:04:50.54,0:04:52.54,Default,,0,0,0,,Неге сонша кешіктің?
Dialogue: 0,0:04:52.62,0:04:54.08,Default,,0,0,0,,Бұл... бұл...
Dialogue: 0,0:04:54.16,0:04:56.67,Default,,0,0,0,,Сіз жинақ иесін білесіз бе?
Dialogue: 0,0:04:56.79,0:04:59.50,Default,,0,0,0,,Не? Ал... иә...
Dialogue: 0,0:05:01.38,0:05:03.97,Default,,0,0,0,,Кит Лопес – менің Блейдерім.
Dialogue: 0,0:05:04.05,0:05:06.34,Default,,0,0,0,,Бұл жаттығу аясындағы кіші команда.
Dialogue: 0,0:05:06.80,0:05:07.89,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:05:08.26,0:05:09.43,Default,,0,0,0,,Эххе
Dialogue: 0,0:05:09.68,0:05:11.81,Default,,0,0,0,,Неге мені бірден осында әкелмейсің?
Dialogue: 0,0:05:11.93,0:05:16.14,Default,,0,0,0,,Екеуміз ойнап жүргенде неше түрлі оқиғалар болып, кешігіп қалдық.
Dialogue: 0,0:05:16.39,0:05:19.98,Default,,0,0,0,,Мен сенен сұрадым... Оған менің де кінәм болды.
Dialogue: 0,0:05:20.40,0:05:22.19,Default,,0,0,0,,Бүгін мен сені кешірдім.
Dialogue: 0,0:05:22.28,0:05:23.28,Default,,0,0,0,,Жақсы
Dialogue: 0,0:05:24.11,0:05:27.78,Default,,0,0,0,,Мен осы команданың иесімін, Кристина Клодаг.
Dialogue: 0,0:05:28.57,0:05:29.78,Default,,0,0,0,,Маған Крис деп қоңырау шалыңыз
Dialogue: 0,0:05:30.20,0:05:31.08,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:05:31.74,0:05:33.20,Default,,0,0,0,,Бірақ чикоку жоқ
Dialogue: 0,0:05:33.33,0:05:34.66,Default,,0,0,0,,Айыппұл ретінде -
Dialogue: 0,0:05:34.75,0:05:37.58,Default,,0,0,0,,Мен сізден қосылу сынағынан өтуіңізді сұраймын.
Dialogue: 0,0:05:37.96,0:05:39.50,Default,,0,0,0,,Қосылу сынағы?
Dialogue: 0,0:05:39.83,0:05:42.55,Default,,0,0,0,,Қосылғысы келетіндер үшін сынақ болады.
Dialogue: 0,0:05:42.84,0:05:46.72,Default,,0,0,0,,Иә? Мен тест тапсыруға немесе оқуға жақсы емеспін...
Dialogue: 0,0:05:46.84,0:05:49.47,Default,,0,0,0,,Бұл сынақ емес, Бейбатл.
Dialogue: 0,0:05:49.59,0:05:52.06,Default,,0,0,0,,Шайқас? Бұлай болса жақсы
Dialogue: 0,0:05:52.18,0:05:53.35,Default,,0,0,0,,Тез айт
Dialogue: 0,0:05:54.43,0:05:55.85,Default,,0,0,0,,Өзіңізге сенімдісіз бе?
Dialogue: 0,0:05:56.31,0:05:57.94,Default,,0,0,0,,О, мен мұны істеймін.
Dialogue: 0,0:05:58.02,0:06:01.61,Default,,0,0,0,,Ата, мен қазір шайқасқа шығамын... А?
Dialogue: 0,0:06:01.69,0:06:04.23,Default,,0,0,0,,Ата?
Dialogue: 0,0:06:04.98,0:06:06.32,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:06:06.40,0:06:08.86,Default,,0,0,0,,Мүмкін тағы кездесерміз.
Dialogue: 0,0:06:08.95,0:06:12.03,Default,,0,0,0,,Whoohohoho~
Dialogue: 0,0:06:12.70,0:06:16.04,Default,,0,0,0,,Бұл Б.С.Сольдің клуб үйі мен жатақханасы.
Dialogue: 0,0:06:16.37,0:06:19.50,Default,,0,0,0,,Сынақтан өтсең, мен сені осында тұруға рұқсат етемін.
Dialogue: 0,0:06:19.92,0:06:21.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:21.63,0:06:24.59,Default,,0,0,0,,Кристің ата-бабалары бастапқыда осында тұрған.
Dialogue: 0,0:06:25.30,0:06:28.63,Default,,0,0,0,,Құйрықтардың көпшілігі осында тұрады.
Dialogue: 0,0:06:29.47,0:06:30.80,Default,,0,0,0,,Тәжірибе ауқымы осында.
Dialogue: 0,0:06:31.68,0:06:35.10,Default,,0,0,0,,(Студенттің сөйлеу дауысын тексеру)
Dialogue: 0,0:06:35.18,0:06:37.18,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:06:37.35,0:06:39.02,Default,,0,0,0,,Сынақ студенттері жиналды!
Dialogue: 0,0:06:41.90,0:06:43.90,Default,,0,0,0,,Жарайды, жанып жатыр.
Dialogue: 0,0:06:44.27,0:06:46.28,Default,,0,0,0,,Иә? Дауыс қазір...
Dialogue: 0,0:06:46.61,0:06:49.32,Default,,0,0,0,,Мен бірдеңе естідім деп ойлаймын...
Dialogue: 0,0:06:49.70,0:06:51.82,Default,,0,0,0,,Иә, Кумичо?
Dialogue: 0,0:06:52.37,0:06:53.28,Default,,0,0,0,,Тағдырына қарғыс айтып жүріп… ол күшті болып қалды… бірақ жалғыз…
Dialogue: 0,0:06:53.99,0:06:56.99,Default,,0,0,0,,Кумичо, сен мұнда неге келдің?
Dialogue: 0,0:06:57.41,0:06:59.04,Default,,0,0,0,,Бұл қазірдің өзінде шешілді.
Dialogue: 0,0:06:59.12,0:07:01.87,Default,,0,0,0,,Сіз Уенге келдіңіз!
Dialogue: 0,0:07:01.96,0:07:05.46,Default,,0,0,0,,Әй, мен де түсу емтиханын тапсыруға келдім.
Dialogue: 0,0:07:05.80,0:07:07.80,Default,,0,0,0,,Не? Кумичо?
Dialogue: 0,0:07:08.30,0:07:11.55,Default,,0,0,0,,Менің де қолданып көргім келеді! Шетелге шықпа!
Dialogue: 0,0:07:12.01,0:07:15.43,Default,,0,0,0,,Дәл қазір бұл командаға қосылу үшін сынақ бар, солай ма?
Dialogue: 0,0:07:15.64,0:07:19.23,Default,,0,0,0,,Мен тез дайындалып, Испанияға жеттім.
Dialogue: 0,0:07:19.39,0:07:21.02,Default,,0,0,0,,Жарайсың Кумичо
Dialogue: 0,0:07:21.10,0:07:23.40,Default,,0,0,0,,Сіз бірінші әрекеттен өтесіз!
Dialogue: 0,0:07:23.69,0:07:25.27,Default,,0,0,0,,Мен де ренжідім
Dialogue: 0,0:07:25.61,0:07:27.07,Default,,0,0,0,,Әй... Балто
Dialogue: 0,0:07:27.15,0:07:29.32,Default,,0,0,0,,Сіз барлау жүргізген жоқсыз ба?
Dialogue: 0,0:07:29.44,0:07:33.07,Default,,0,0,0,,Мен жалықтым, тест тапсыруға тура келді.
Dialogue: 0,0:07:33.20,0:07:34.95,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:07:35.03,0:07:35.95,Default,,0,0,0,,Эххе
Dialogue: 0,0:07:36.03,0:07:37.49,Default,,0,0,0,,Аникидің досы ма?
Dialogue: 0,0:07:37.58,0:07:40.62,Default,,0,0,0,,Әй, менің ең жақын досым, Рантаро Кияма.
Dialogue: 0,0:07:41.12,0:07:42.83,Default,,0,0,0,,Маған Кумичо деп қоңырау шалыңыз.
Dialogue: 0,0:07:42.92,0:07:45.92,Default,,0,0,0,,Егер сіз Аникидің ең жақын досы болсаңыз, онда сіз менің ең жақын досымсыз.
Dialogue: 0,0:07:46.25,0:07:48.55,Default,,0,0,0,,Танысқаныма қуаныштымын, Кит.
Dialogue: 0,0:07:48.88,0:07:50.17,Default,,0,0,0,,О!
Dialogue: 0,0:07:52.72,0:07:56.68,Default,,0,0,0,,BC Sol әлемдегі ең күшті команда болуды мақсат етеді
Dialogue: 0,0:07:56.76,0:07:59.72,Default,,0,0,0,,Маған тек күшті пышақ керек
Dialogue: 0,0:07:59.81,0:08:01.64,Default,,0,0,0,,Бізге күшіңді көрсет
Dialogue: 0,0:08:04.81,0:08:07.06,Default,,0,0,0,,Матч 2 ұпайлық жүйемен ойналады.
Dialogue: 0,0:08:07.61,0:08:09.61,Default,,0,0,0,,Аты аталғандар алға шығады.
Dialogue: 0,0:08:09.90,0:08:11.53,Default,,0,0,0,,Бірінші айналым Бірінші матч
Dialogue: 0,0:08:11.78,0:08:14.36,Default,,0,0,0,,Рантаро Кияма Пол Орландоға қарсы
Dialogue: 0,0:08:14.61,0:08:15.74,Default,,0,0,0,,Жарайды, бұл менмін!
Dialogue: 0,0:08:15.82,0:08:17.78,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:08:21.08,0:08:23.75,Default,,0,0,0,,Кумичо, қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:08:26.38,0:08:29.34,Default,,0,0,0,,Ихихи Балто Мынаны қарашы, таң қалдың!
Dialogue: 0,0:08:29.59,0:08:33.09,Default,,0,0,0,,Жарайсың, Блэйз Рагнарук!
Dialogue: 0,0:08:33.47,0:08:36.55,Default,,0,0,0,,Б...Блэз Рагнарук?
Dialogue: 0,0:08:36.84,0:08:40.52,Default,,0,0,0,,Төзімділік түрімен қабаттың түрлендіру күшін күшейтіңіз.
Dialogue: 0,0:08:40.60,0:08:43.14,Default,,0,0,0,,Екі шыдамды қанаты бар.
Dialogue: 0,0:08:43.52,0:08:47.44,Default,,0,0,0,,Төзімділік қанаты? Рагнарук те дамыды.
Dialogue: 0,0:08:47.52,0:08:49.36,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:08:49.65,0:08:51.78,Default,,0,0,0,,4 жүзді 4С дискі
Dialogue: 0,0:08:51.86,0:08:55.66,Default,,0,0,0,,Жоғарғы күшті тудыратын қанаттары бар флюгель драйвері
Dialogue: 0,0:08:55.74,0:08:57.11,Default,,0,0,0,,Қатты қарсылас
Dialogue: 0,0:08:57.53,0:09:00.03,Default,,0,0,0,,Мен Испанияға дейін келдім.
Dialogue: 0,0:09:00.16,0:09:02.37,Default,,0,0,0,,Мен шыңға көтерілемін
Dialogue: 0,0:09:03.00,0:09:05.16,Default,,0,0,0,,Мен де Нидерландыданмын.
Dialogue: 0,0:09:05.58,0:09:08.00,Default,,0,0,0,,Менің арманым осы командаға қосылу
Dialogue: 0,0:09:08.08,0:09:09.21,Default,,0,0,0,,...
Dialogue: 0,0:09:09.29,0:09:11.21,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:09:11.30,0:09:14.84,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:15.01,0:09:17.26,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:20.43,0:09:22.18,Default,,0,0,0,,(қанатты ашу дыбысы)
Dialogue: 0,0:09:22.27,0:09:24.64,Default,,0,0,0,,Төзімділік қанаты ашылды
Dialogue: 0,0:09:24.98,0:09:26.69,Default,,0,0,0,,Төзімділік қанаты…
Dialogue: 0,0:09:30.19,0:09:33.11,Default,,0,0,0,,Жүр! Рагнарук!
Dialogue: 0,0:09:34.61,0:09:35.86,Default,,0,0,0,,Керемет
Dialogue: 0,0:09:36.28,0:09:37.91,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:09:38.41,0:09:40.32,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:09:42.49,0:09:45.29,Default,,0,0,0,,Шеш, Рагнарук!
Dialogue: 0,0:09:47.46,0:09:48.83,Default,,0,0,0,,Есептегіш!
Dialogue: 0,0:09:49.13,0:09:50.71,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:09:51.13,0:09:54.88,Default,,0,0,0,,Blaze Ragnaruk 2 ұпай, Burst Finish
Dialogue: 0,0:09:54.96,0:09:56.67,Default,,0,0,0,,Рантаро Кияманың жеңісі
Dialogue: 0,0:09:57.30,0:10:00.39,Default,,0,0,0,,Бұл адамның тікелей бәсекесі
Dialogue: 0,0:10:00.68,0:10:03.85,Default,,0,0,0,,Иә! мен жеңдім. Тамаша.
Dialogue: 0,0:10:04.18,0:10:05.31,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:05.60,0:10:07.94,Default,,0,0,0,,Келесі төлемді күтіңіз
Dialogue: 0,0:10:10.15,0:10:12.32,Default,,0,0,0,,Әй, бұл күшті болды.
Dialogue: 0,0:10:13.82,0:10:17.65,Default,,0,0,0,,Маған жұбаныш керек емес, мен сені қанша қаласам, сонша жұбатамын.
Dialogue: 0,0:10:18.32,0:10:20.99,Default,,0,0,0,,Мен осы BC Solға қосылмайынша!
Dialogue: 0,0:10:21.45,0:10:23.08,Default,,0,0,0,,Қалағаныңызша...
Dialogue: 0,0:10:23.28,0:10:27.46,Default,,0,0,0,,Дәстүрлі б.з.д. Сольді тамашалайтын жүзшілер көп.
Dialogue: 0,0:10:27.62,0:10:30.92,Default,,0,0,0,,Мен мұндай керемет команда екенін білмедім.
Dialogue: 0,0:10:31.04,0:10:35.13,Default,,0,0,0,,Әй, біздің команда туралы білмейтіндер бар.
Dialogue: 0,0:10:35.21,0:10:36.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:38.17,0:10:39.05,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:10:39.26,0:10:41.34,Default,,0,0,0,,Ол бос Де Ла Хойя
Dialogue: 0,0:10:41.43,0:10:43.18,Default,,0,0,0,,Сіз Кумичоны білесіз бе?
Dialogue: 0,0:10:43.43,0:10:46.10,Default,,0,0,0,,Blader әлемде бірінші орында
Dialogue: 0,0:10:47.02,0:10:49.89,Default,,0,0,0,,Бұл BC Sol-ның жоғарғы ұшқышы.
Dialogue: 0,0:10:50.77,0:10:53.11,Default,,0,0,0,,Дүние жүзіндегі бірінші...
Dialogue: 0,0:10:53.52,0:10:56.48,Default,,0,0,0,,Сіз тегін қабылдау тестін көруге келдіңіз.
Dialogue: 0,0:10:56.78,0:10:59.95,Default,,0,0,0,,Мені қуанта алатын пышақ бар ма?
Dialogue: 0,0:11:01.45,0:11:02.62,Default,,0,0,0,,Маған қызық
Dialogue: 0,0:11:03.37,0:11:05.58,Default,,0,0,0,,Сіз сынақ студентісіз бе?
Dialogue: 0,0:11:05.95,0:11:07.41,Default,,0,0,0,,Бар болғанын қалаймын.
Dialogue: 0,0:11:07.75,0:11:10.25,Default,,0,0,0,,
Dialogue: 0,0:11:10.54,0:11:14.04,Default,,0,0,0,,Ол әлемдегі ең жақсы ма?
Dialogue: 0,0:11:14.38,0:11:16.55,Default,,0,0,0,,Үшінші матч
Dialogue: 0,0:11:16.63,0:11:19.51,Default,,0,0,0,,2 ұпай Луис Лоренцо жеңісі
Dialogue: 0,0:11:20.42,0:11:23.68,Default,,0,0,0,,Бірінші раундтың төртінші ойыны, Барто Аоимен...
Dialogue: 0,0:11:23.76,0:11:24.64,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:11:25.18,0:11:29.23,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:11:30.18,0:11:31.31,Default,,0,0,0,,Стронгты белгілеңіз
Dialogue: 0,0:11:31.60,0:11:33.60,Default,,0,0,0,,♬~
Dialogue: 0,0:11:33.77,0:11:35.77,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:11:37.82,0:11:38.65,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:11:39.19,0:11:40.82,Default,,0,0,0,,Үлкен
Dialogue: 0,0:11:41.07,0:11:42.45,Default,,0,0,0,,Чиз
Dialogue: 0,0:11:43.03,0:11:45.87,Default,,0,0,0,,Бейбатлдың сіздің денеңіздің үлкендігімен ешқандай қатысы жоқ.
Dialogue: 0,0:11:46.41,0:11:48.37,Default,,0,0,0,,Берілме, Балто
Dialogue: 0,0:11:48.45,0:11:49.41,Default,,0,0,0,,Аники!
Dialogue: 0,0:11:51.87,0:11:55.17,Default,,0,0,0,,Кумичо Менің Валькириям да дамыды.
Dialogue: 0,0:11:55.42,0:11:57.09,Default,,0,0,0,,Құдай Валькирия
Dialogue: 0,0:11:57.17,0:11:58.21,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:11:58.30,0:12:00.01,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:12:02.01,0:12:04.39,Default,,0,0,0,,Мен ол баланы барладым.
Dialogue: 0,0:12:04.80,0:12:05.55,Default,,0,0,0,,Крис?
Dialogue: 0,0:12:05.93,0:12:07.64,Default,,0,0,0,,Бұл Жапонияда 2-ші нөмір.
Dialogue: 0,0:12:07.89,0:12:11.31,Default,,0,0,0,,Жапон турнирлері ғана пайдалы емес.
Dialogue: 0,0:12:11.98,0:12:16.15,Default,,0,0,0,,Бірақ ол сол Ширасаги қамал Луимен бірдей болған сияқты.
Dialogue: 0,0:12:16.27,0:12:19.90,Default,,0,0,0,,Хмм, бірақ мен жеңілдім.
Dialogue: 0,0:12:22.74,0:12:23.99,Default,,0,0,0,,Хмм.
Dialogue: 0,0:12:24.07,0:12:25.70,Default,,0,0,0,,Валькирия
Dialogue: 0,0:12:25.78,0:12:29.58,Default,,0,0,0,,Сіздің жекпе-жек стиліңіз туралы көбірек айтып беріңіз.
Dialogue: 0,0:12:31.37,0:12:34.04,Default,,0,0,0,,Беймен сөйлесіп тұрған сияқты.
Dialogue: 0,0:12:34.21,0:12:36.67,Default,,0,0,0,,Мен ол шығанаққа әлі үйренбегенмін.
Dialogue: 0,0:12:36.75,0:12:37.96,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:38.04,0:12:40.84,Default,,0,0,0,,Уау~ Сіз оны көргенде түсінесіз
Dialogue: 0,0:12:48.39,0:12:50.81,Default,,0,0,0,,Бұл сенсің, мұқият қара.
Dialogue: 0,0:12:51.14,0:12:53.73,Default,,0,0,0,,Жарайды, ол баланы сол күйінде қалдыр.
Dialogue: 0,0:12:54.19,0:12:56.02,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:12:56.10,0:12:59.61,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:59.82,0:13:02.15,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:02.28,0:13:03.15,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:13:06.36,0:13:07.28,Default,,0,0,0,,Валькирия?
Dialogue: 0,0:13:07.70,0:13:10.08,Default,,0,0,0,,Жарайды, мен орталықты алдым.
Dialogue: 0,0:13:12.12,0:13:14.25,Default,,0,0,0,,Ах, мен тағы да бақылаудан шықтым.
Dialogue: 0,0:13:14.41,0:13:15.83,Default,,0,0,0,,Түсіру қатесі?
Dialogue: 0,0:13:15.92,0:13:17.08,Default,,0,0,0,,Аники әлі...
Dialogue: 0,0:13:17.17,0:13:19.79,Default,,0,0,0,,Мен Валькири құдайын басқара алмаймын.
Dialogue: 0,0:13:20.50,0:13:22.51,Default,,0,0,0,,Сіз бастаушы сияқтысыз.
Dialogue: 0,0:13:22.80,0:13:23.67,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:24.38,0:13:27.55,Default,,0,0,0,,Кешіріңіз, Крис, бірақ ол қала алмайды.
Dialogue: 0,0:13:33.39,0:13:35.14,Default,,0,0,0,,Ах! Валькирия!
Dialogue: 0,0:13:35.48,0:13:38.19,Default,,0,0,0,,Не? Ол дымқыл
Dialogue: 0,0:13:38.27,0:13:39.90,Default,,0,0,0,,Қызық!
Dialogue: 0,0:13:42.36,0:13:44.49,Default,,0,0,0,,Жақсы! Осы жерден.
Dialogue: 0,0:13:44.82,0:13:46.32,Default,,0,0,0,,Жағдай өзгерді
Dialogue: 0,0:13:46.40,0:13:47.20,Default,,0,0,0,,О
Dialogue: 0,0:13:49.82,0:13:51.28,Default,,0,0,0,,Жақсы, солай!
Dialogue: 0,0:13:51.37,0:13:52.37,Default,,0,0,0,,Таэро!
Dialogue: 0,0:13:52.66,0:13:53.95,Default,,0,0,0,,Толық шабуыл жасаңыз!
Dialogue: 0,0:13:57.33,0:13:58.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:58.96,0:14:00.04,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:14:03.88,0:14:07.09,Default,,0,0,0,,Год Валькири 2 ұпай
Dialogue: 0,0:14:07.42,0:14:09.09,Default,,0,0,0,,Аои Балттың жеңісі!
Dialogue: 0,0:14:09.30,0:14:10.47,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:14:11.39,0:14:12.47,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:12.56,0:14:13.97,Default,,0,0,0,,Иә
Dialogue: 0,0:14:14.35,0:14:16.18,Default,,0,0,0,,Аники мен жасадым
Dialogue: 0,0:14:16.52,0:14:18.52,Default,,0,0,0,,Сіз жеңдіңіз.
Dialogue: 0,0:14:18.77,0:14:20.77,Default,,0,0,0,,Мен тек бір рет жеңдім
Dialogue: 0,0:14:20.86,0:14:22.86,Default,,0,0,0,,♪~
Dialogue: 0,0:14:38.00,0:14:39.00,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:14:40.00,0:14:41.96,Default,,0,0,0,,Жартылай финалдың бірінші матчы
Dialogue: 0,0:14:42.67,0:14:44.63,Default,,0,0,0,,Рантаро Кияманың жеңісі!
Dialogue: 0,0:14:44.71,0:14:45.50,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:14:45.96,0:14:47.97,Default,,0,0,0,,Жеңімпаз Барто Аои
Dialogue: 0,0:14:48.05,0:14:48.97,Default,,0,0,0,,Ша!
Dialogue: 0,0:14:52.72,0:14:54.60,Default,,0,0,0,,Финалға кім өтті:
Dialogue: 0,0:14:55.14,0:14:57.73,Default,,0,0,0,,Рантаро Кияма және Барто Аои!
Dialogue: 0,0:14:58.06,0:15:01.44,Default,,0,0,0,,Аники Кумичо Қолыңыздан келгеннің бәрін жасаңыз!
Dialogue: 0,0:15:01.94,0:15:05.19,Default,,0,0,0,,Балто Осылайша аяқталды.
Dialogue: 0,0:15:05.57,0:15:07.94,Default,,0,0,0,,Мен Кумичомен жұмыс істегеніме қуаныштымын.
Dialogue: 0,0:15:08.36,0:15:09.32,Default,,0,0,0,,Жоғарыдағылар не ойлап отыр екен? Трост ауданына кіру – тек бекер өлімге апарады.
Dialogue: 0,0:15:09.57,0:15:12.41,Default,,0,0,0,,Бірақ бір адам ғана аман қалады
Dialogue: 0,0:15:12.78,0:15:13.87,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:15:14.24,0:15:16.41,Default,,0,0,0,,Алданбаңыз! мен жеңемін
Dialogue: 0,0:15:16.62,0:15:19.37,Default,,0,0,0,,Мен бүгін жанып тұрмын
Dialogue: 0,0:15:19.46,0:15:22.08,Default,,0,0,0,,Бұл да Рагнарукты жалындады.
Dialogue: 0,0:15:22.25,0:15:25.88,Default,,0,0,0,,Менің Құдайым Валькири миллион есе отты.
Dialogue: 0,0:15:26.25,0:15:28.71,Default,,0,0,0,,Мен миллиард есе көп күйіп жатырмын~
Dialogue: 0,0:15:28.92,0:15:30.88,Default,,0,0,0,,Бәрің де тоз-тоз болып қалдыңдар...
Dialogue: 0,0:15:30.97,0:15:32.26,Default,,0,0,0,,Ол құлап жатыр!
Dialogue: 0,0:15:32.55,0:15:35.01,Default,,0,0,0,,Бұл бұзылып жатқан нәрсе.
Dialogue: 0,0:15:35.51,0:15:37.72,Default,,0,0,0,,Кім жеңсе де, қызғанба
Dialogue: 0,0:15:38.02,0:15:39.68,Default,,0,0,0,,Бетпе-бет күресейік.
Dialogue: 0,0:15:39.93,0:15:40.81,Default,,0,0,0,,О
Dialogue: 0,0:15:41.31,0:15:42.44,Default,,0,0,0,,Эй Трад
Dialogue: 0,0:15:42.65,0:15:45.11,Default,,0,0,0,,Хуаншан деген бала жақсы емес пе?
Dialogue: 0,0:15:45.48,0:15:48.11,Default,,0,0,0,,Маған сол ыстық сезім ұнайды.
Dialogue: 0,0:15:48.28,0:15:51.15,Default,,0,0,0,,Иә, бұл табылған элемент болуы мүмкін.
Dialogue: 0,0:15:51.49,0:15:54.20,Default,,0,0,0,,Барто Аои қалмады ма?
Dialogue: 0,0:15:54.37,0:15:55.45,Default,,0,0,0,,Ах... ха
Dialogue: 0,0:15:56.16,0:15:57.49,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:15:58.08,0:16:01.12,Default,,0,0,0,,Дүниеде жарыссам деген арманын көрсеткен
Dialogue: 0,0:16:01.21,0:16:02.83,Default,,0,0,0,,Сәлем, Балто.
Dialogue: 0,0:16:03.17,0:16:07.50,Default,,0,0,0,,Бірақ мен сені жеңуім керек болса, мен сені жеңемін!
Dialogue: 0,0:16:07.92,0:16:11.09,Default,,0,0,0,,Кумичоның Рагнарук шынымен күшейіп келеді.
Dialogue: 0,0:16:11.51,0:16:12.88,Default,,0,0,0,,Мен қалай жеңе аламын?
Dialogue: 0,0:16:13.34,0:16:15.14,Default,,0,0,0,,Ойланып қарасаң да басталмайды.
Dialogue: 0,0:16:15.55,0:16:16.97,Default,,0,0,0,,Мұны істеу керек
Dialogue: 0,0:16:17.30,0:16:19.01,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:16:19.56,0:16:22.56,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:22.89,0:16:25.10,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:39.87,0:16:43.54,Default,,0,0,0,,Еркек жаныңды көрсет!
Dialogue: 0,0:16:49.59,0:16:51.96,Default,,0,0,0,,Ғажайып Рагнарук
Dialogue: 0,0:16:52.05,0:16:54.34,Default,,0,0,0,,Валькиридің барлық шабуылдары тойтарыс береді.
Dialogue: 0,0:16:54.93,0:16:58.60,Default,,0,0,0,,Бұл не? Мұны шыдамды шайқасқа әкелейік
Dialogue: 0,0:16:58.89,0:16:59.76,Default,,0,0,0,,Құт
Dialogue: 0,0:16:59.85,0:17:02.60,Default,,0,0,0,,Валькири, көбірек шабуыл жасаңыз.
Dialogue: 0,0:17:06.31,0:17:08.44,Default,,0,0,0,,Жақсы, Рагнарук.
Dialogue: 0,0:17:11.90,0:17:12.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:17.61,0:17:20.95,Default,,0,0,0,,Blaze Ragnaruk 1 ұпай айналдырумен
Dialogue: 0,0:17:21.08,0:17:21.83,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:17:23.58,0:17:24.29,Default,,0,0,0,,Құт
Dialogue: 0,0:17:24.83,0:17:26.00,Default,,0,0,0,,Үлкен аға Геко!
Dialogue: 0,0:17:26.33,0:17:28.67,Default,,0,0,0,,Блэз Рагнарук Жақсы.
Dialogue: 0,0:17:28.79,0:17:32.13,Default,,0,0,0,,Иә, бұл пышақта көп орын бар сияқты.
Dialogue: 0,0:17:32.55,0:17:34.63,Default,,0,0,0,,Рагнаруктың төзімділік қанаты
Dialogue: 0,0:17:34.72,0:17:35.67,Default,,0,0,0,,Күшті
Dialogue: 0,0:17:36.38,0:17:39.47,Default,,0,0,0,,Валькирия Не істегіңіз келеді?
Dialogue: 0,0:17:40.64,0:17:43.31,Default,,0,0,0,,Менің жағдайым жақсы, Блэйз Рагнарук.
Dialogue: 0,0:17:46.35,0:17:48.35,Default,,0,0,0,,Менің Бейблейд ғылыми-зерттеу институтым
Dialogue: 0,0:17:48.44,0:17:51.52,Default,,0,0,0,,Мен сіздің Рагнарукыңызды дамыту үшін бар күшімді салдым.
Dialogue: 0,0:17:52.23,0:17:53.53,Default,,0,0,0,,Рантаро Кияма
Dialogue: 0,0:17:53.61,0:17:57.45,Default,,0,0,0,,Ұлттық құрама жарысындағы өнеріңіз керемет болды.
Dialogue: 0,0:17:58.32,0:18:01.41,Default,,0,0,0,,Дүниеге деген өкініш сезімдеріңізді толығымен қабылдадым.
Dialogue: 0,0:18:01.66,0:18:04.12,Default,,0,0,0,,О, Мураки-сан, рахмет!
Dialogue: 0,0:18:04.45,0:18:08.08,Default,,0,0,0,,Рагнаруктың барлық күшін шығара алатыныңызға сенемін.
Dialogue: 0,0:18:08.96,0:18:13.88,Default,,0,0,0,,Осы Блэйз Рагнарукпен бірге әлемді жаулап алайық!
Dialogue: 0,0:18:15.38,0:18:17.47,Default,,0,0,0,,Мына ойынды алайық
Dialogue: 0,0:18:18.38,0:18:21.43,Default,,0,0,0,,Екінші шайқасқа дайын жиынтық!
Dialogue: 0,0:18:21.93,0:18:25.02,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:25.31,0:18:27.77,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:32.11,0:18:34.02,Default,,0,0,0,,Валькири тағы да қобалжыды
Dialogue: 0,0:18:34.53,0:18:35.57,Default,,0,0,0,,Ура!
Dialogue: 0,0:18:36.40,0:18:38.53,Default,,0,0,0,,Бұл Рагнарук!
Dialogue: 0,0:18:50.12,0:18:52.54,Default,,0,0,0,,Жарайды, итеріңіз!
Dialogue: 0,0:18:53.84,0:18:56.21,Default,,0,0,0,,Валькирия Сіз не істегіңіз келеді...
Dialogue: 0,0:19:05.68,0:19:06.60,Default,,0,0,0,,Не~!? (Официант) Бұл – «Ой-Пи», көріп тұрсыз ба.
Dialogue: 0,0:19:07.85,0:19:10.56,Default,,0,0,0,,Валькирияның жылдамдығы қайтадан артты!
Dialogue: 0,0:19:10.94,0:19:14.06,Default,,0,0,0,,Сіз байланыстырылған қабатты қабырғаға соғу арқылы жылдамдадыңыз ба?
Dialogue: 0,0:19:14.31,0:19:16.02,Default,,0,0,0,,Ооооооо
Dialogue: 0,0:19:19.70,0:19:23.99,Default,,0,0,0,,Жүр! валкири
Dialogue: 0,0:19:24.07,0:19:25.53,Default,,0,0,0,,(кәмпит сынған дыбыс)
Dialogue: 0,0:19:25.62,0:19:28.29,Default,,0,0,0,,Таэро Рагнарук!
Dialogue: 0,0:19:37.13,0:19:37.88,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:19:41.26,0:19:43.59,Default,,0,0,0,,Кимеро Валькири!
Dialogue: 0,0:19:43.68,0:19:45.26,Default,,0,0,0,,Байланысты шабуыл
Dialogue: 0,0:19:48.68,0:19:49.56,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:19:53.06,0:19:54.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:54.44,0:19:57.61,Default,,0,0,0,,Год Валькири 2 ұпай
Dialogue: 0,0:19:57.86,0:19:59.28,Default,,0,0,0,,Аои Балттың жеңісі
Dialogue: 0,0:20:00.03,0:20:02.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:02.28,0:20:03.11,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:03.20,0:20:05.20,Default,,0,0,0,,Ой
Dialogue: 0,0:20:05.82,0:20:06.91,Default,,0,0,0,,Аники~!
Dialogue: 0,0:20:07.37,0:20:08.99,Default,,0,0,0,,Қарсы шабуыл...
Dialogue: 0,0:20:09.45,0:20:10.62,Default,,0,0,0,,Сол эмоциясыз қыз –
Dialogue: 0,0:20:11.75,0:20:13.25,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:20:13.67,0:20:16.75,Default,,0,0,0,,Мен сізге BC Sol-қа қосылуға рұқсат етемін.
Dialogue: 0,0:20:17.38,0:20:18.80,Default,,0,0,0,,Хааа~
Dialogue: 0,0:20:18.92,0:20:20.30,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:20.55,0:20:22.01,Default,,0,0,0,,Эй, мұны істе...
Dialogue: 0,0:20:22.09,0:20:24.43,Default,,0,0,0,,Байланысты шабуыл қызықты
Dialogue: 0,0:20:24.51,0:20:25.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:25.97,0:20:26.76,Default,,0,0,0,,Енді сен агент емессің.
Dialogue: 0,0:20:26.85,0:20:29.06,Default,,0,0,0,,Осы байланыстырылған қабатты қабырғаға соғыңыз...
Dialogue: 0,0:20:29.14,0:20:30.89,Default,,0,0,0,,Мен жылдамдықты арттырдым.
Dialogue: 0,0:20:31.52,0:20:33.56,Default,,0,0,0,,және 6В диск
Dialogue: 0,0:20:33.98,0:20:34.94,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:35.23,0:20:36.19,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,0:20:36.73,0:20:37.98,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:38.07,0:20:38.82,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:20:38.90,0:20:39.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:40.11,0:20:42.24,Default,,0,0,0,,Ұрыс мені енді ғана оятты.
Dialogue: 0,0:20:42.61,0:20:44.20,Default,,0,0,0,,Бұл тамаша шығанақ.
Dialogue: 0,0:20:44.74,0:20:45.82,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:20:45.91,0:20:50.12,Default,,0,0,0,,Сол шығанақтың арқасында сіз 100% жеңдіңіз.
Dialogue: 0,0:20:50.62,0:20:51.45,Default,,0,0,0,,Сатып алуға алданған адам – нағыз ақымақ
Dialogue: 0,0:20:52.54,0:20:54.37,Default,,0,0,0,,Мен Бэйге алғыс айтуым керек.
Dialogue: 0,0:20:56.67,0:20:57.96,Default,,0,0,0,,Бұл тек қана достық теннис матчы.
Dialogue: 0,0:21:00.34,0:21:01.59,Default,,0,0,0,,Мен жеңілдім
Dialogue: 0,0:21:02.09,0:21:04.68,Default,,0,0,0,,Ал сіз... Хуаншан мырза?
Dialogue: 0,0:21:05.38,0:21:06.93,Default,,0,0,0,,Маған ешқандай жайлылық керек емес
Dialogue: 0,0:21:07.34,0:21:08.72,Default,,0,0,0,,Сіз де өтесіз.
Dialogue: 0,0:21:09.10,0:21:11.60,Default,,0,0,0,,Менің өткенімді айтқанына қуаныштымын...
Dialogue: 0,0:21:12.22,0:21:13.81,Default,,0,0,0,,Уа... ха!
Dialogue: 0,0:21:13.89,0:21:16.56,Default,,0,0,0,,Мен саған жақынырақ қарағым келді.
Dialogue: 0,0:21:16.94,0:21:19.06,Default,,0,0,0,,Жарайды... шын!
Dialogue: 0,0:21:19.36,0:21:20.15,Default,,0,0,0,,Иә
Dialogue: 0,0:21:20.23,0:21:21.57,Default,,0,0,0,,Содан кейін ережелер...
Dialogue: 0,0:21:21.69,0:21:24.28,Default,,0,0,0,,Ендеше ережелерді өзгертіңіз, солай емес пе?
Dialogue: 0,0:21:24.90,0:21:28.16,Default,,0,0,0,,Енді BC Solды күшейткім келсе,
Dialogue: 0,0:21:28.24,0:21:29.83,Default,,0,0,0,,Мен не қажет болса да істеймін.
Dialogue: 0,0:21:30.28,0:21:32.91,Default,,0,0,0,,Сіз мені БК Сольге қоясыз ба?
Dialogue: 0,0:21:33.25,0:21:34.58,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:21:34.66,0:21:36.04,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:21:36.12,0:21:39.08,Default,,0,0,0,,Жапониядан бір жігіт келді.
Dialogue: 0,0:21:39.17,0:21:40.79,Default,,0,0,0,,Сізге жақсы Кумичо
Dialogue: 0,0:21:41.34,0:21:42.30,Default,,0,0,0,,Барт
Dialogue: 0,0:21:42.38,0:21:43.51,Default,,0,0,0,,Кумичо
Dialogue: 0,0:21:43.96,0:21:46.38,Default,,0,0,0,,Біз тағы бір командадамыз!
Dialogue: 0,0:21:46.76,0:21:49.47,Default,,0,0,0,,Сізге жақсы Аники Кумичо
Dialogue: 0,0:21:50.85,0:21:54.22,Default,,0,0,0,,Эй, біз мұны жасадық!
Dialogue: 0,0:21:55.93,0:21:57.89,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.52,0:22:01.94,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:02.02,0:22:04.86,Default,,0,0,0,,Шығанақ бұлшықеттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.94,0:22:06.99,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.07,0:22:10.74,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.82,0:22:14.41,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.49,0:22:16.20,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.29,0:22:18.04,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.12,0:22:19.88,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.96,0:22:21.54,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.63,0:22:23.63,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.71,0:22:26.09,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.34,0:22:29.09,Default,,0,0,0,,Одан әрі ату жаттығуы. Мұнда да сақтығыңызды түсірмеңіз! Сәлем!
Dialogue: 0,0:22:29.18,0:22:32.80,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.89,0:22:36.56,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.64,0:22:38.35,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.44,0:22:41.65,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.73,0:22:43.98,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.07,0:22:47.65,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.74,0:22:51.16,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.24,0:22:53.37,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.45,0:22:55.04,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:55.12,0:22:58.54,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.75,0:23:00.54,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.62,0:23:03.59,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.67,0:23:05.92,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:06.09,0:23:09.88,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.97,0:23:13.55,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.64,0:23:17.18,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.27,0:23:20.60,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.69,0:23:22.65,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.73,0:23:23.44,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:23.44,0:23:25.44,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:23.44,0:23:25.44,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.78,0:23:30.45,Default,,0,0,0,,Ойынға қатысу үшін өз командаңызда жеңіске жету керек.
Dialogue: 0,0:23:30.53,0:23:32.82,Default,,0,0,0,,Соңында мен Эйспен күресемін, Еркін.
Dialogue: 0,0:23:32.95,0:23:34.24,Default,,0,0,0,,Егер сіз бұл жігітті жеңсеңіз...
Dialogue: 0,0:23:34.32,0:23:37.08,Default,,0,0,0,,Бұл менің әлемдегі ең жақсы жүзім екенімді білдіреді.
Dialogue: 0,0:23:37.20,0:23:40.37,Default,,0,0,0,,Не? Вакия! Неге мұндасың?
Dialogue: 0,0:23:40.79,0:23:43.04,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.13,0:23:45.09,Default,,0,0,0,,Шок! Фафнирді төгіп тастаңыз!
Dialogue: 0,0:23:45.88,0:23:49.26,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:50.76,0:23:56.76,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory