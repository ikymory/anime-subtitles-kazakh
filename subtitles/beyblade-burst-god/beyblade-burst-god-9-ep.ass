Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.29,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.13,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.39,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:19.97,0:00:24.44,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.10,0:00:29.73,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:32.57,0:00:36.32,Default,,0,0,0,,Біз Эль Сантода ашылу жарысын өткіземіз деп үміттенемін.
Dialogue: 0,0:00:36.41,0:00:37.91,Default,,0,0,0,,Шаңды ойлаймын
Dialogue: 0,0:00:38.20,0:00:41.37,Default,,0,0,0,,Еуропа лигасы осы жерден басталады!
Dialogue: 0,0:00:42.50,0:00:44.37,Default,,0,0,0,,(Бұрынғы Патша) Біз, Имантия, осы Дисбордта ең әлсізбіз.
Dialogue: 0,0:00:44.46,0:00:48.17,Default,,0,0,0,,WBBA Еуропа лигасы ақыры басталды!
Dialogue: 0,0:00:48.59,0:00:51.30,Default,,0,0,0,,Бірінші қарсыласымыз Германиядан келген Топванд.
Dialogue: 0,0:00:52.42,0:00:55.80,Default,,0,0,0,,Еркін бірінші ойында тамаша шайқаста жеңіске жетті.
Dialogue: 0,0:00:55.88,0:00:58.85,Default,,0,0,0,,Содан кейін мен және Куза соқтығысты.
Dialogue: 0,0:01:04.31,0:01:06.77,Default,,0,0,0,,(Айналудың тоқтау дыбысы)
Dialogue: 0,0:01:07.06,0:01:09.48,Default,,0,0,0,,Бұл мен ойлағаннан да қауіпті болуы мүмкін.
Dialogue: 0,0:01:09.73,0:01:12.61,Default,,0,0,0,,Олай болса, осында өлтірейік!
Dialogue: 0,0:01:13.74,0:01:17.66,Default,,0,0,0,,Тоқтату! Кроностың басқа бетін өзгертіңіз
Dialogue: 0,0:01:17.74,0:01:19.66,Default,,0,0,0,,Супер шабуыл режимі!
Dialogue: 0,0:01:19.87,0:01:23.29,Default,,0,0,0,,(Үдемелі айналу дыбысы)
Dialogue: 0,0:01:23.37,0:01:24.66,Default,,0,0,0,,Міне! Міне осы!
Dialogue: 0,0:01:24.75,0:01:26.96,Default,,0,0,0,,Жүр, Валькири!
Dialogue: 0,0:01:30.59,0:01:32.80,Default,,0,0,0,,Кел, Кронос!
Dialogue: 0,0:01:33.96,0:01:37.88,Default,,0,0,0,,Кроностың супер шабуыл режимі өте қиын!
Dialogue: 0,0:01:38.18,0:01:40.60,Default,,0,0,0,,Бірақ матч әлі алда!
Dialogue: 0,0:01:41.43,0:01:44.18,Default,,0,0,0,,♪~
Dialogue: 0,0:01:44.27,0:01:46.73,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:46.81,0:01:49.06,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:49.15,0:01:51.73,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:51.82,0:01:54.15,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:54.23,0:01:55.94,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:56.03,0:02:00.16,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:01.07,0:02:05.83,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:05.91,0:02:10.46,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:10.92,0:02:15.67,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:15.76,0:02:20.68,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:20.76,0:02:25.64,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:25.72,0:02:30.69,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:30.77,0:02:34.15,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:34.23,0:02:35.61,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:35.69,0:02:38.15,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:38.24,0:02:40.45,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:40.53,0:02:42.74,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:42.82,0:02:44.16,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:44.24,0:02:45.74,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:45.83,0:02:48.16,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:48.25,0:02:54.42,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:54.50,0:02:58.92,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:59.01,0:03:01.72,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:01.80,0:03:04.10,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:04.18,0:03:06.81,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:06.89,0:03:10.64,Default,,0,0,0,,~♪
Dialogue: 0,0:03:06.89,0:03:10.64,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:12.27,0:03:14.94,Default,,0,0,0,,Уақыт Құдай! Кроносты өзгертіңіз!
Dialogue: 0,0:03:16.15,0:03:18.74,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:03:18.94,0:03:21.61,Default,,0,0,0,,BC Sol және Top Vant
Dialogue: 0,0:03:21.70,0:03:24.41,Default,,0,0,0,,Екі команданың эйстері бір ойыннан жарысты.
Dialogue: 0,0:03:24.49,0:03:26.37,Default,,0,0,0,,Не деген сұмдық!
Dialogue: 0,0:03:26.91,0:03:30.37,Default,,0,0,0,,Менің Кронос екеуміз оны бір рет ұтыс ойынына әкелдік.
Dialogue: 0,0:03:30.58,0:03:32.62,Default,,0,0,0,,Оменің Валькириясы да керемет
Dialogue: 0,0:03:32.87,0:03:34.33,Default,,0,0,0,,Cuza…
Dialogue: 0,0:03:34.63,0:03:37.46,Default,,0,0,0,,Ойын біткен соң, тағы бірге ойнайық!
Dialogue: 0,0:03:37.84,0:03:38.80,Default,,0,0,0,,Асобо!
Dialogue: 0,0:03:39.17,0:03:41.26,Default,,0,0,0,,Кешегі Кузаға оралды
Dialogue: 0,0:03:41.51,0:03:42.63,Default,,0,0,0,,Жақында кездескенше!
Dialogue: 0,0:03:42.72,0:03:43.80,Default,,0,0,0,,Матан!
Dialogue: 0,0:03:44.84,0:03:47.26,Default,,0,0,0,,Мен барамын деп ойладым.
Dialogue: 0,0:03:47.35,0:03:50.10,Default,,0,0,0,,Балтты Куза толығымен жейді.
Dialogue: 0,0:03:50.18,0:03:53.48,Default,,0,0,0,,Бұл дұрыс емес. Аники жеңе жаздады.
Dialogue: 0,0:03:53.56,0:03:54.81,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:03:55.15,0:03:58.11,Default,,0,0,0,,Chronos супер шабуыл режимі жеңіске жетті.
Dialogue: 0,0:03:58.19,0:03:59.90,Default,,0,0,0,,Өкінішті миллион
Dialogue: 0,0:03:59.98,0:04:03.07,Default,,0,0,0,,Кім жеңсе, сол мықты, болды.
Dialogue: 0,0:04:03.99,0:04:07.41,Default,,0,0,0,,Мен көрінсем, мен Кроносқа жеңілмеймін.
Dialogue: 0,0:04:08.08,0:04:10.08,Default,,0,0,0,,Крис, кешіріңіз.
Dialogue: 0,0:04:10.16,0:04:11.12,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:11.41,0:04:14.62,Default,,0,0,0,,Қатысушыларды таңдауға мен жауаптымын.
Dialogue: 0,0:04:15.12,0:04:18.84,Default,,0,0,0,,Бізде тегін ойыншы бар. Біз тағы екі ойын ойнай аламыз, солай ма?
Dialogue: 0,0:04:19.46,0:04:20.21,Default,,0,0,0,,Иә
Dialogue: 0,0:04:20.88,0:04:21.92,Default,,0,0,0,,Сіз жеңдіңіз.
Dialogue: 0,0:04:25.01,0:04:27.72,Default,,0,0,0,,Сары... Әрі қарай барасың.
Dialogue: 0,0:04:27.85,0:04:29.26,Default,,0,0,0,,«Сары тауды» есте сақтаңыз!
Dialogue: 0,0:04:29.35,0:04:30.97,Default,,0,0,0,,Кумичо Ойнайық!
Dialogue: 0,0:04:31.06,0:04:32.43,Default,,0,0,0,,О! Маған қалдырыңыз!
Dialogue: 0,0:04:32.98,0:04:35.85,Default,,0,0,0,,Маған буындарды ұстау дағдыларын көрсетіңіз
Dialogue: 0,0:04:35.94,0:04:37.86,Default,,0,0,0,,Төзімділікпен жеңіңіз!
Dialogue: 0,0:04:38.36,0:04:40.73,Default,,0,0,0,,Рагнарук жарылды!
Dialogue: 0,0:04:40.82,0:04:43.78,Default,,0,0,0,,Бұл сәтсіз соққы екені анық.
Dialogue: 0,0:04:43.86,0:04:45.53,Default,,0,0,0,,Мм!
Dialogue: 0,0:04:47.41,0:04:49.49,Default,,0,0,0,,Тек рухпен жеңе алмайсың
Dialogue: 0,0:04:50.12,0:04:51.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:52.00,0:04:54.41,Default,,0,0,0,,Енді ойын саны 2:1
Dialogue: 0,0:04:54.50,0:04:57.17,Default,,0,0,0,,BC Соль Топ Ванттың алға шығуына мүмкіндік берді.
Dialogue: 0,0:04:57.63,0:05:01.17,Default,,0,0,0,,Келесі ойын шешіледі ме?
Dialogue: 0,0:05:01.75,0:05:04.17,Default,,0,0,0,,Іске қосқышты қолдайтын сол қол дірілдеп тұрды.
Dialogue: 0,0:05:04.67,0:05:06.18,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:06.55,0:05:10.05,Default,,0,0,0,,Оны матчта қолдану ерте болды ма? Хуаншань
Dialogue: 0,0:05:10.72,0:05:13.02,Default,,0,0,0,,Уайымдамаңыз, біз оны кері қайтарамыз.
Dialogue: 0,0:05:13.85,0:05:14.98,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:15.06,0:05:16.06,Default,,0,0,0,,Кумичо
Dialogue: 0,0:05:16.14,0:05:18.31,Default,,0,0,0,,Мені ренжітіп бара жаттым.
Dialogue: 0,0:05:18.65,0:05:20.73,Default,,0,0,0,,Жеңілгенде қызық болмайды.
Dialogue: 0,0:05:21.23,0:05:22.44,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:22.73,0:05:24.44,Default,,0,0,0,,Олай болса жеңу керек
Dialogue: 0,0:05:24.74,0:05:26.03,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:29.16,0:05:30.16,Default,,0,0,0,,(Ұрыс тіркеу дыбысы)
Dialogue: 0,0:05:31.53,0:05:33.33,Default,,0,0,0,,Кита Кита Кита
Dialogue: 0,0:05:33.41,0:05:37.17,Default,,0,0,0,,BC Sol Төртінші ойында эйс тегін болады!
Dialogue: 0,0:05:38.21,0:05:42.00,Default,,0,0,0,,BC Sol Free De La Hoya-ға сүйенеді
Dialogue: 0,0:05:43.71,0:05:47.22,Default,,0,0,0,,Сен кетсең, бұл жай ғана әлсіз команда.
Dialogue: 0,0:05:48.38,0:05:53.39,Default,,0,0,0,,Біз жақсы команда едік, бірақ қазір мүлде құрдымға кеттік.
Dialogue: 0,0:05:56.39,0:05:59.60,Default,,0,0,0,,Мен оның үйде болғанын қалаймын.
Dialogue: 0,0:06:00.40,0:06:03.02,Default,,0,0,0,,Топ Ванттан бұл да эйс!
Dialogue: 0,0:06:03.11,0:06:04.57,Default,,0,0,0,,Кузаны таныстыру.
Dialogue: 0,0:06:05.28,0:06:07.70,Default,,0,0,0,,Әлемдік рейтингтің шыңын жеңіңіз!
Dialogue: 0,0:06:08.24,0:06:10.53,Default,,0,0,0,,Көңілім көтеріле бастады.
Dialogue: 0,0:06:10.62,0:06:12.70,Default,,0,0,0,,Вакуваку Шитекита
Dialogue: 0,0:06:12.78,0:06:14.54,Default,,0,0,0,,Карл орындыққа оралады.
Dialogue: 0,0:06:14.62,0:06:15.70,Default,,0,0,0,,Модоттена
Dialogue: 0,0:06:16.87,0:06:17.75,Default,,0,0,0,,Жақсы бала
Dialogue: 0,0:06:17.83,0:06:28.09,Default,,0,0,0,,Тегін Тегін Тегін…
Dialogue: 0,0:06:28.63,0:06:30.76,Default,,0,0,0,,Б.С. Сольдің үйінен күткендей
Dialogue: 0,0:06:31.01,0:06:33.39,Default,,0,0,0,,Дәл қазір менің сізге ұсынатыным көп.
Dialogue: 0,0:06:33.93,0:06:35.43,Default,,0,0,0,,Осы шайқастан кейін
Dialogue: 0,0:06:35.52,0:06:37.98,Default,,0,0,0,,Бәрі сенікі болатынына сенімдімін.
Dialogue: 0,0:06:38.52,0:06:39.64,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:39.73,0:06:44.11,Default,,0,0,0,,Тегін Тегін Тегін…
Dialogue: 0,0:06:59.58,0:07:00.96,Default,,0,0,0,,Жасайық
Dialogue: 0,0:07:04.46,0:07:07.55,Default,,0,0,0,,Фафнир - солақай төзімділік түрі.
Dialogue: 0,0:07:07.96,0:07:09.63,Default,,0,0,0,,Мен бұл қиын екенін білемін.
Dialogue: 0,0:07:10.05,0:07:14.26,Default,,0,0,0,,Жарайды, бірден жеңіске жету үшін Kronos супер шабуыл режимін қолданайық!
Dialogue: 0,0:07:16.14,0:07:18.43,Default,,0,0,0,,Төртінші ойын Бірінші шайқас
Dialogue: 0,0:07:20.14,0:07:21.94,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:07:22.23,0:07:25.61,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:25.82,0:07:28.11,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:29.40,0:07:31.03,Default,,0,0,0,,(Тыныш қону дыбысы)
Dialogue: 0,0:07:31.45,0:07:32.95,Default,,0,0,0,,Фафнирді төгу
Dialogue: 0,0:07:33.03,0:07:35.91,Default,,0,0,0,,Тағы бір үнсіз, талғампаз қону!
Dialogue: 0,0:07:35.99,0:07:38.04,Default,,0,0,0,,Ой! Айналу баяу!
Dialogue: 0,0:07:38.49,0:07:39.87,Default,,0,0,0,,Сәтсіз ату?
Dialogue: 0,0:07:40.25,0:07:42.83,Default,,0,0,0,,Жоқ, еркін еріктің сәтсіздікке ұшырауы мүмкін емес.
Dialogue: 0,0:07:43.12,0:07:44.75,Default,,0,0,0,,Бұл әдейі жасалған
Dialogue: 0,0:07:45.17,0:07:46.67,Default,,0,0,0,,Баяу төмендеді
Dialogue: 0,0:07:46.75,0:07:48.96,Default,,0,0,0,,Бізде де солай болды.
Dialogue: 0,0:07:50.51,0:07:51.63,Default,,0,0,0,,бастайық
Dialogue: 0,0:07:51.88,0:07:52.72,Default,,0,0,0,,О
Dialogue: 0,0:08:00.35,0:08:02.60,Default,,0,0,0,,Сен мұны істедің, Еркін.
Dialogue: 0,0:08:03.02,0:08:06.02,Default,,0,0,0,,Цуккоме Chronos сырғымалы түсірілімі!
Dialogue: 0,0:08:06.27,0:08:09.07,Default,,0,0,0,,Альтер Кроностың арнайы шабуылы!
Dialogue: 0,0:08:10.28,0:08:14.32,Default,,0,0,0,,Ауырлық центрінің ығысуынан туындаған біртүрлі бұлыңғырлықты пайдаланып шабуыл
Dialogue: 0,0:08:14.41,0:08:15.16,Default,,0,0,0,,Не!
Dialogue: 0,0:08:15.24,0:08:18.16,Default,,0,0,0,,Бірақ бірақ!
Dialogue: 0,0:08:18.24,0:08:21.70,Default,,0,0,0,,Фафнирге шабуыл жасаған сайын ол күшейе түседі.
Dialogue: 0,0:08:21.87,0:08:22.75,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:08:26.54,0:08:28.59,Default,,0,0,0,,Бұл Фафнир ме?
Dialogue: 0,0:08:31.26,0:08:34.26,Default,,0,0,0,,(жалынның дыбысы)
Dialogue: 0,0:08:35.72,0:08:37.39,Default,,0,0,0,,(үру)
Dialogue: 0,0:08:38.80,0:08:40.72,Default,,0,0,0,,Таос Фафнир
Dialogue: 0,0:08:44.73,0:08:46.06,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:08:46.40,0:08:47.77,Default,,0,0,0,,Не!
Dialogue: 0,0:08:48.23,0:08:50.53,Default,,0,0,0,,Fafnir Burst Finish ағызу!
Dialogue: 0,0:08:50.73,0:08:53.82,Default,,0,0,0,,BC Сол төртінші ойында жеңіске жетті
Dialogue: 0,0:08:54.03,0:08:56.07,Default,,0,0,0,,Ойындар саны 2-ден 2-ге дейін
Dialogue: 0,0:08:59.62,0:09:01.12,Default,,0,0,0,,(Кёко) Ах…
Dialogue: 0,0:09:01.49,0:09:02.62,Default,,0,0,0,,...
Dialogue: 0,0:09:02.91,0:09:05.33,Default,,0,0,0,,Фриланс шынымен күшті!
Dialogue: 0,0:09:05.41,0:09:07.58,Default,,0,0,0,,Күшті, күшті!
Dialogue: 0,0:09:08.63,0:09:09.84,Default,,0,0,0,,Не болды, Балто?
Dialogue: 0,0:09:09.92,0:09:11.75,Default,,0,0,0,,(шәйнектің ысқырығы дыбысы)
Dialogue: 0,0:09:11.84,0:09:13.34,Default,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:09:14.84,0:09:17.51,Default,,0,0,0,,Еркін конькиші жеңсе, қуанамын, бірақ мен...
Dialogue: 0,0:09:18.18,0:09:20.60,Default,,0,0,0,,Бұл аймақ қызып жатыр!
Dialogue: 0,0:09:20.68,0:09:21.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:21.89,0:09:22.68,Default,,0,0,0,,Тегін
Dialogue: 0,0:09:23.56,0:09:24.85,Default,,0,0,0,,Коу!
Dialogue: 0,0:09:24.93,0:09:25.98,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:09:26.06,0:09:27.56,Default,,0,0,0,,Мм!
Dialogue: 0,0:09:28.85,0:09:30.44,Default,,0,0,0,,Сіз мұны түсіндіңіз бе?
Dialogue: 0,0:09:31.19,0:09:32.40,Default,,0,0,0,,Тегін! Жаса!
Dialogue: 0,0:09:32.48,0:09:33.78,Default,,0,0,0,,Сіз мұнымен жеңе аласыз!
Dialogue: 0,0:09:33.86,0:09:35.57,Default,,0,0,0,,Әй, әлі ерте.
Dialogue: 0,0:09:35.65,0:09:37.07,Default,,0,0,0,,Қуып жету.
Dialogue: 0,0:09:37.15,0:09:38.57,Default,,0,0,0,,Абайсыз жау
Dialogue: 0,0:09:38.70,0:09:39.99,Default,,0,0,0,,тағы 1 ойын
Dialogue: 0,0:09:40.07,0:09:42.79,Default,,0,0,0,,Тағы бір тегін коньки алсақ, біз міндетті түрде жеңеміз!
Dialogue: 0,0:09:43.24,0:09:44.33,Default,,0,0,0,,Егер ол шықса.
Dialogue: 0,0:09:44.91,0:09:47.25,Default,,0,0,0,,Не? Ол көрінбеуі мүмкін бе?
Dialogue: 0,0:09:47.54,0:09:48.21,Default,,0,0,0,,Иә
Dialogue: 0,0:09:48.58,0:09:50.17,Default,,0,0,0,,Еркін - құбылмалы
Dialogue: 0,0:09:50.25,0:09:54.09,Default,,0,0,0,,Кейде мен кенеттен үйге бардым немесе қосалқы мүшені тағайындадым.
Dialogue: 0,0:09:54.59,0:09:56.22,Default,,0,0,0,,Мен қосалқы ретінде көріне аламын ба?
Dialogue: 0,0:09:56.30,0:09:58.05,Default,,0,0,0,,Бұл үшін қосалқы құрал, солай ма?
Dialogue: 0,0:09:58.38,0:10:01.72,Default,,0,0,0,,Жазатайым жағдайда ауыстыруға рұқсат етіледі.
Dialogue: 0,0:10:02.26,0:10:04.64,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:05.02,0:10:07.85,Default,,0,0,0,,Келесі ойын Мен сені ешқашан тастамаймын
Dialogue: 0,0:10:08.60,0:10:11.11,Default,,0,0,0,,Мен сізге тегін бағдарламаға міндетті түрде қатысуды тапсырамын.
Dialogue: 0,0:10:12.98,0:10:15.65,Default,,0,0,0,,(телефонның қоңырау үні)
Dialogue: 0,0:10:16.40,0:10:17.32,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:10:17.40,0:10:19.86,Default,,0,0,0,,Хуаншан? Оның орнына тегін
Dialogue: 0,0:10:20.87,0:10:22.49,Default,,0,0,0,,Сізге тегін
Dialogue: 0,0:10:23.33,0:10:24.91,Default,,0,0,0,,Матч жүріп жатыр.
Dialogue: 0,0:10:27.54,0:10:29.00,Default,,0,0,0,,Сәлем Куза
Dialogue: 0,0:10:29.25,0:10:30.58,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:10:31.04,0:10:32.59,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:10:32.96,0:10:34.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:34.30,0:10:35.05,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:36.84,0:10:38.01,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:38.09,0:10:38.80,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:10:38.88,0:10:39.80,Default,,0,0,0,,Cuza…
Dialogue: 0,0:10:40.22,0:10:42.72,Default,,0,0,0,,Мен жеңілісімнің себебін ойладым.
Dialogue: 0,0:10:42.80,0:10:44.85,Default,,0,0,0,,Күтілгендей, еркін күшті.
Dialogue: 0,0:10:45.10,0:10:46.43,Default,,0,0,0,,Бұл сіз...
Dialogue: 0,0:10:46.52,0:10:49.39,Default,,0,0,0,,Сонымен, сіз оны таптыңыз ба? Еркіннің қандай кемшіліктері бар?
Dialogue: 0,0:10:49.73,0:10:52.81,Default,,0,0,0,,Ол менің күшімді жұтады.
Dialogue: 0,0:10:53.02,0:10:54.23,Default,,0,0,0,,Мен мұны істемеймін.
Dialogue: 0,0:10:55.90,0:10:58.19,Default,,0,0,0,,Бір соққы жеткіліксіз
Dialogue: 0,0:10:58.28,0:11:00.74,Default,,0,0,0,,Мен онымен көбірек шайқасқым келеді.
Dialogue: 0,0:11:02.66,0:11:06.24,Default,,0,0,0,,Жарайды, Куза, келесі ойынға да өтуге болады.
Dialogue: 0,0:11:06.74,0:11:07.79,Default,,0,0,0,,Иә? Бұл жақсы ма?
Dialogue: 0,0:11:07.87,0:11:11.79,Default,,0,0,0,,Аа, бәлкім, BC Sol эйссіз болады.
Dialogue: 0,0:11:12.04,0:11:14.09,Default,,0,0,0,,Белгіні қайтадан басыңыз!
Dialogue: 0,0:11:14.46,0:11:15.29,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:11:15.75,0:11:17.88,Default,,0,0,0,,Кузаға тым жұмсақсың.
Dialogue: 0,0:11:18.09,0:11:19.80,Default,,0,0,0,,Өйткені біз жеңеміз, солай ма?
Dialogue: 0,0:11:19.97,0:11:20.88,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:11:21.38,0:11:23.93,Default,,0,0,0,,Энтузиазм қосқышы қосылды!
Dialogue: 0,0:11:24.55,0:11:26.93,Default,,0,0,0,,Дүние жүзіндегі ұлдар мен қыздар!
Dialogue: 0,0:11:27.18,0:11:32.06,Default,,0,0,0,,Еуропа лигасының бірінші матчы қызу және қызу өтуде.
Dialogue: 0,0:11:32.14,0:11:34.27,Default,,0,0,0,,Өрт! ! !
Dialogue: 0,0:11:34.36,0:11:38.03,Default,,0,0,0,,Енді осы финалдық ойынның аяқталатын уақыты келді.
Dialogue: 0,0:11:38.11,0:11:41.20,Default,,0,0,0,,Келесі Blader кім болады?
Dialogue: 0,0:11:41.28,0:11:43.57,Default,,0,0,0,,(Шудың жүгірген тынысы)
Dialogue: 0,0:11:43.66,0:11:44.57,Default,,0,0,0,,Бенишу
Dialogue: 0,0:11:45.03,0:11:48.41,Default,,0,0,0,,Осылай жылынсақ қалай болады?
Dialogue: 0,0:11:48.87,0:11:50.50,Default,,0,0,0,,Тағы біраз жүгіріңіз
Dialogue: 0,0:11:50.91,0:11:53.00,Default,,0,0,0,,Ештеңе етпейді, мәжбүрлеме.
Dialogue: 0,0:11:53.79,0:11:56.50,Default,,0,0,0,,Шудан басқа мүшелер тере бастайды.
Dialogue: 0,0:11:57.09,0:11:59.55,Default,,0,0,0,,Ерекше қарау Мен қызғанамын.
Dialogue: 0,0:11:59.76,0:12:02.34,Default,,0,0,0,,Менің Нью-Йорк Буллс ойыншысы...
Dialogue: 0,0:12:02.43,0:12:04.30,Default,,0,0,0,,Ол марафондық жүгіруге бет бұрған сияқты.
Dialogue: 0,0:12:04.80,0:12:07.22,Default,,0,0,0,,Балалар сендер мысқылдайсыңдар. Уақытыңыз болса...
Dialogue: 0,0:12:07.30,0:12:09.77,Default,,0,0,0,,Шудан артық жең
Dialogue: 0,0:12:09.85,0:12:11.02,Default,,0,0,0,,Иә
Dialogue: 0,0:12:19.61,0:12:23.20,Default,,0,0,0,,Бесінші ойын Blader ұрыс кезеңіне шығады
Dialogue: 0,0:12:23.57,0:12:25.95,Default,,0,0,0,,Келесі тегін ойын мені шығарып алыңыз
Dialogue: 0,0:12:26.16,0:12:28.37,Default,,0,0,0,,Сіз кенеттен келдіңіз.
Dialogue: 0,0:12:28.45,0:12:29.62,Default,,0,0,0,,Мен қосалқы мүшемін
Dialogue: 0,0:12:30.12,0:12:33.87,Default,,0,0,0,,Балалар, бұзылсаңдар, сендерді ауыстырып, ойында ойнауға болады.
Dialogue: 0,0:12:33.96,0:12:35.83,Default,,0,0,0,,Ешкім сынған жоқ
Dialogue: 0,0:12:35.92,0:12:37.54,Default,,0,0,0,,Оны сынған деп көрсетіңіз
Dialogue: 0,0:12:37.63,0:12:38.50,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:12:39.13,0:12:41.55,Default,,0,0,0,,Еркін Келесі жолы Куза келетініне сенімдімін.
Dialogue: 0,0:12:41.63,0:12:42.67,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз
Dialogue: 0,0:12:43.67,0:12:44.43,Default,,0,0,0,,Сіз жеңе аласыз ба?
Dialogue: 0,0:12:45.01,0:12:45.97,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:12:46.47,0:12:47.93,Default,,0,0,0,,Маған орындауға рұқсат етіңіз
Dialogue: 0,0:12:48.18,0:12:49.26,Default,,0,0,0,,Мен жеңемін!
Dialogue: 0,0:12:49.35,0:12:50.51,Default,,0,0,0,,Мен де!
Dialogue: 0,0:12:50.72,0:12:51.39,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:12:51.47,0:12:52.14,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:12:52.22,0:12:52.98,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:12:53.06,0:12:55.60,Default,,0,0,0,,(Бір-бірімен айтысқан үш адамның дауысы)
Dialogue: 0,0:12:55.69,0:12:58.02,Default,,0,0,0,,Мен мұндай нәрсені жек көрмеймін.
Dialogue: 0,0:12:58.44,0:13:01.32,Default,,0,0,0,,Барт келесі
Dialogue: 0,0:13:01.86,0:13:02.99,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:13:03.28,0:13:04.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:04.78,0:13:07.24,Default,,0,0,0,,Бұл жігіт Кузадан бір рет жеңіліп қалды.
Dialogue: 0,0:13:07.45,0:13:09.07,Default,,0,0,0,,Мен тағы да жеңілетініме сенімдімін
Dialogue: 0,0:13:09.74,0:13:11.41,Default,,0,0,0,,Мұны кім шешті?
Dialogue: 0,0:13:11.79,0:13:12.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:13.66,0:13:16.67,Default,,0,0,0,,Сіз жеңесіз бе, не жеңілетініңізді өзіңіз шешесіз.
Dialogue: 0,0:13:17.58,0:13:18.71,Default,,0,0,0,,Тегін…
Dialogue: 0,0:13:21.25,0:13:23.42,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:13:23.92,0:13:26.18,Default,,0,0,0,,Сәлем! Балто, жең!
Dialogue: 0,0:13:26.26,0:13:26.88,Default,,0,0,0,,О!
Dialogue: 0,0:13:28.22,0:13:29.39,Default,,0,0,0,,Жоғалтпа!
Dialogue: 0,0:13:29.47,0:13:30.76,Default,,0,0,0,,Cisco Teme
Dialogue: 0,0:13:32.06,0:13:33.22,Default,,0,0,0,,(Ұстағышты көтеріп тұрған дыбыс)
Dialogue: 0,0:13:34.23,0:13:35.94,Default,,0,0,0,,Блейдер бесінші ойында
Dialogue: 0,0:13:36.02,0:13:38.85,Default,,0,0,0,,Топвант - Куса Акерман!
Dialogue: 0,0:13:38.94,0:13:42.23,Default,,0,0,0,,Иә! ? BC Sol - бұл Аои Барто!
Dialogue: 0,0:13:42.44,0:13:44.53,Default,,0,0,0,,А... тегін емес пе?
Dialogue: 0,0:13:44.86,0:13:45.99,Default,,0,0,0,,Бұл Аники
Dialogue: 0,0:13:46.07,0:13:46.95,Default,,0,0,0,,Уф
Dialogue: 0,0:13:47.28,0:13:48.49,Default,,0,0,0,,Неге!
Dialogue: 0,0:13:48.57,0:13:50.20,Default,,0,0,0,,Бұл жерде тегін, солай ма?
Dialogue: 0,0:13:50.28,0:13:51.95,Default,,0,0,0,,Ашық аспан
Dialogue: 0,0:13:52.41,0:13:53.87,Default,,0,0,0,,Бос болсаңыз...
Dialogue: 0,0:13:53.95,0:13:55.79,Default,,0,0,0,,Мен қатаң нұсқаулар бердім.
Dialogue: 0,0:13:56.62,0:14:00.42,Default,,0,0,0,,Тегін Сіз бұл матчты Балтоға беруді жоспарлап отырсыз ба?
Dialogue: 0,0:14:01.13,0:14:03.38,Default,,0,0,0,,Фриланс бұл матчтан бас тартты.
Dialogue: 0,0:14:09.72,0:14:13.60,Default,,0,0,0,,Шу Жүгіріп болған соң, теруге қосыл.
Dialogue: 0,0:14:13.72,0:14:14.47,Default,,0,0,0,,Иә
Dialogue: 0,0:14:21.02,0:14:23.57,Default,,0,0,0,,Мен тегін нұсқасы шығады деп ойладым.
Dialogue: 0,0:14:23.94,0:14:27.78,Default,,0,0,0,,Мен сіздермен қайтадан шайқасқа шыққаныма өте қуаныштымын.
Dialogue: 0,0:14:28.20,0:14:31.91,Default,,0,0,0,,Бір жағынан жеңілсем де бақыттымын деп айтудың өзі ғажап.
Dialogue: 0,0:14:32.28,0:14:33.58,Default,,0,0,0,,Бұл жолы жеңіңіз!
Dialogue: 0,0:14:33.95,0:14:35.33,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:14:35.58,0:14:38.12,Default,,0,0,0,,Мен сені қалай жеңетінімді білемін.
Dialogue: 0,0:14:38.54,0:14:41.33,Default,,0,0,0,,Менің қазіргі адамым бұрынғы адамнан басқаша.
Dialogue: 0,0:14:43.96,0:14:47.34,Default,,0,0,0,,Сен екеуміз доспыз, ал енді жау болдық.
Dialogue: 0,0:14:48.30,0:14:50.59,Default,,0,0,0,,Қуат айырмашылығын еске түсіру
Dialogue: 0,0:14:51.22,0:14:54.85,Default,,0,0,0,,Екінші ойында супер шабуыл режимінде толық жеңіске жеттім.
Dialogue: 0,0:14:55.56,0:14:57.64,Default,,0,0,0,,Әдетте бірдей шабуыл жақсы.
Dialogue: 0,0:14:58.14,0:15:00.44,Default,,0,0,0,,Kronos қай режимге келеді?
Dialogue: 0,0:15:00.73,0:15:03.90,Default,,0,0,0,,Өте төзімділік немесе супер шабуыл?
Dialogue: 0,0:15:04.57,0:15:07.74,Default,,0,0,0,,Сіз жеңесіз бе, әлде жеңілесіз бе.
Dialogue: 0,0:15:09.49,0:15:12.24,Default,,0,0,0,,Кеттік досым, бар күшіңді салып шабуыл жаса!
Dialogue: 0,0:15:12.62,0:15:15.58,Default,,0,0,0,,Анау ақымақ, оның не ойлағанын айта алмайсың.
Dialogue: 0,0:15:16.08,0:15:18.04,Default,,0,0,0,,Жақсы, Балто.
Dialogue: 0,0:15:18.25,0:15:21.46,Default,,0,0,0,,Мен сендердің ақымақтардың не ойлап отырғаныңды түсінбеймін.
Dialogue: 0,0:15:21.67,0:15:25.25,Default,,0,0,0,,Мені түсінуге тырыспаңыз.
Dialogue: 0,0:15:28.17,0:15:31.22,Default,,0,0,0,,Келесі жолы мен супер төзімділік режимімен өтемін.
Dialogue: 0,0:15:31.30,0:15:34.22,Default,,0,0,0,,Мен сіздің барлық шабуылдарыңыздан аулақ боламын.
Dialogue: 0,0:15:35.01,0:15:36.97,Default,,0,0,0,,Куза сенімді сияқты.
Dialogue: 0,0:15:37.35,0:15:38.93,Default,,0,0,0,,Юигадокусон
Dialogue: 0,0:15:39.02,0:15:40.60,Default,,0,0,0,,Ол күшті
Dialogue: 0,0:15:40.68,0:15:42.85,Default,,0,0,0,,Балт, сен тағы жеңілесің.
Dialogue: 0,0:15:43.44,0:15:46.11,Default,,0,0,0,,Бесінші ойын Бірінші шайқас
Dialogue: 0,0:15:47.82,0:15:49.65,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:15:49.90,0:15:52.91,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:53.36,0:15:55.37,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:00.08,0:16:01.91,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:16:02.21,0:16:04.42,Default,,0,0,0,,Kronos Slide Off түсіру!
Dialogue: 0,0:16:06.17,0:16:11.63,Default,,0,0,0,,Альтер Кронос стадионның шетінде жүрді!
Dialogue: 0,0:16:15.47,0:16:18.97,Default,,0,0,0,,Кронос баяу қозғалады
Dialogue: 0,0:16:19.06,0:16:21.39,Default,,0,0,0,,Бұл екінші ойын сияқты даму!
Dialogue: 0,0:16:21.48,0:16:23.85,Default,,0,0,0,,Валькири қарсыласын көрмей қалды...
Dialogue: 0,0:16:23.94,0:16:26.40,Default,,0,0,0,,Стадионды аралап жүріңіз
Dialogue: 0,0:16:26.48,0:16:28.15,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:16:28.23,0:16:31.28,Default,,0,0,0,,Кронус аты айтып тұрғандай, уақыт құдайы...
Dialogue: 0,0:16:31.36,0:16:34.11,Default,,0,0,0,,Жердегі Валькириге төмен қарауды жалғастыру!
Dialogue: 0,0:16:34.57,0:16:37.83,Default,,0,0,0,,Мен де бұл әдісті тегін қолданып көргім келді.
Dialogue: 0,0:16:40.29,0:16:41.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:42.58,0:16:47.88,Default,,0,0,0,,Ах! Валькирияның уақыты тоқтады!
Dialogue: 0,0:16:48.38,0:16:50.63,Default,,0,0,0,,Chronos айналдыру аяқталуын өзгерту
Dialogue: 0,0:16:50.84,0:16:52.67,Default,,0,0,0,,1 ұпай жоғарғы вант үшін
Dialogue: 0,0:16:53.34,0:16:54.51,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:54.97,0:16:57.30,Default,,0,0,0,,Тегін болса не істер едің?
Dialogue: 0,0:16:59.56,0:17:01.47,Default,,0,0,0,,Бұл техника дегеніміз не?
Dialogue: 0,0:17:01.77,0:17:03.56,Default,,0,0,0,,Құбырды сырғытыңыз
Dialogue: 0,0:17:03.64,0:17:07.35,Default,,0,0,0,,Екінші ойынды қараңыз, егер сіз супер шабуылмен шабуыл жасасаңыз
Dialogue: 0,0:17:07.44,0:17:10.36,Default,,0,0,0,,Бұл да бізге қарсы шабуыл жасауға мүмкіндік береді...
Dialogue: 0,0:17:10.94,0:17:14.86,Default,,0,0,0,,Екінші шайқаста дәл осындай тактиканы қолдансаңыз жақсы болар еді.
Dialogue: 0,0:17:15.24,0:17:18.24,Default,,0,0,0,,Мен еш жерден мұндай техника туралы ақпаратты таба алмадым.
Dialogue: 0,0:17:18.66,0:17:19.78,Default,,0,0,0,,Сонда кездескенше...
Dialogue: 0,0:17:19.95,0:17:22.04,Default,,0,0,0,,Ол бала әлі бас тартқан жоқ.
Dialogue: 0,0:17:22.12,0:17:22.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:23.20,0:17:26.08,Default,,0,0,0,,Куза Оме, бұл өте керемет.
Dialogue: 0,0:17:26.67,0:17:30.09,Default,,0,0,0,,Осындай техниканы орындау үшін қанша жаттығу керек?
Dialogue: 0,0:17:30.50,0:17:32.13,Default,,0,0,0,,Бұл сізге тым көп
Dialogue: 0,0:17:32.59,0:17:35.88,Default,,0,0,0,,Амал жоқ, оны арнайы дайындықпен жасауға болады!
Dialogue: 0,0:17:36.43,0:17:37.51,Default,,0,0,0,,Енді сен агент емессің.
Dialogue: 0,0:17:37.80,0:17:39.22,Default,,0,0,0,,Барт былай дейді:
Dialogue: 0,0:17:39.30,0:17:41.72,Default,,0,0,0,,Мен шынымен де бірдеңе істей алатындай сезінемін.
Dialogue: 0,0:17:41.93,0:17:42.97,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:17:43.06,0:17:44.48,Default,,0,0,0,,Бұл жақсы нәрсе!
Dialogue: 0,0:17:44.56,0:17:46.56,Default,,0,0,0,,Аники, жүр!
Dialogue: 0,0:17:50.19,0:17:52.11,Default,,0,0,0,,Балто жеңді!
Dialogue: 0,0:17:52.98,0:17:54.32,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:17:56.24,0:17:58.28,Default,,0,0,0,,Мен қазірдің өзінде реніштен күйіп жатырмын
Dialogue: 0,0:17:58.66,0:17:59.74,Default,,0,0,0,,мен зұлымдарды әділ сотқа тартуға тырысар ма едім?
Dialogue: 0,0:18:00.20,0:18:03.12,Default,,0,0,0,,Мен сені жеңе алмайтынымды еске саламын!
Dialogue: 0,0:18:03.33,0:18:05.04,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:05.37,0:18:08.62,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:09.08,0:18:11.34,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:14.96,0:18:16.51,Default,,0,0,0,,Түсірілімнен сырғыңыз!
Dialogue: 0,0:18:17.93,0:18:22.51,Default,,0,0,0,,Ой! Кронос тағы да стадионның шетіне көтерілді!
Dialogue: 0,0:18:22.93,0:18:26.35,Default,,0,0,0,,Валькири бұған көмектесе алмайды!
Dialogue: 0,0:18:26.43,0:18:28.52,Default,,0,0,0,,Валькири байланған!
Dialogue: 0,0:18:28.60,0:18:30.90,Default,,0,0,0,,Байланысты реактивті ату!
Dialogue: 0,0:18:37.69,0:18:40.86,Default,,0,0,0,,Валькирия! Қабырғаға соғылғаннан кейін кері шегінуге байланысты
Dialogue: 0,0:18:40.95,0:18:44.33,Default,,0,0,0,,Жылдамдық тез өсіп жатқан сияқты.
Dialogue: 0,0:18:44.41,0:18:46.33,Default,,0,0,0,,Бар, жүр, жүр!
Dialogue: 0,0:18:46.41,0:18:48.08,Default,,0,0,0,,Байланысты реактивті түсірілім
Dialogue: 0,0:18:50.00,0:18:50.83,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:18:53.00,0:18:55.21,Default,,0,0,0,,Көбірек тербелетін Валькири!
Dialogue: 0,0:18:56.09,0:18:59.42,Default,,0,0,0,,Қандай таң қалдырды! Сіз шыдай аласыз ба, Кронос?
Dialogue: 0,0:18:59.51,0:19:03.10,Default,,0,0,0,,Ах! Ақырында Кроностың бекінісі құлады.
Dialogue: 0,0:19:03.18,0:19:07.18,Default,,0,0,0,,Дегенмен орталыққа тез қонып, қорғаныс жағдайына өтті.
Dialogue: 0,0:19:07.60,0:19:10.02,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:19:13.36,0:19:15.48,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:19:15.98,0:19:18.03,Default,,0,0,0,,Кронос, тойтар!
Dialogue: 0,0:19:26.62,0:19:28.20,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:43.59,0:19:46.39,Default,,0,0,0,,Жарылыс! Кроностың құлауы!
Dialogue: 0,0:19:46.47,0:19:47.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:47.81,0:19:50.10,Default,,0,0,0,,Сәлем! Мен жеңдім!
Dialogue: 0,0:19:50.60,0:19:53.02,Default,,0,0,0,,God Valkyrie Burst Finish
Dialogue: 0,0:19:53.10,0:19:55.98,Default,,0,0,0,,Аои Барто 2:1 ұпаймен жеңеді
Dialogue: 0,0:19:56.23,0:20:00.74,Default,,0,0,0,,Ал 3-тен 2-ге дейінгі ойын санымен BC Сол жеңіске жетті!
Dialogue: 0,0:20:01.49,0:20:03.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:03.49,0:20:06.24,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:06.49,0:20:07.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:09.95,0:20:11.29,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:20:11.37,0:20:12.54,Default,,0,0,0,,Сол мыңжапырақ
Dialogue: 0,0:20:12.71,0:20:14.04,Default,,0,0,0,,Хехе... аа
Dialogue: 0,0:20:14.12,0:20:15.00,Default,,0,0,0,,Пон!
Dialogue: 0,0:20:15.08,0:20:16.42,Default,,0,0,0,,Куу! Tsk!
Dialogue: 0,0:20:16.67,0:20:18.38,Default,,0,0,0,,Еуропа лигасының бірінші ойыны
Dialogue: 0,0:20:18.46,0:20:22.59,Default,,0,0,0,,Эль Сантоның үй командасы BC Sol үшін жеңіс!
Dialogue: 0,0:20:22.67,0:20:24.68,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:20:24.76,0:20:25.55,Default,,0,0,0,,Иә
Dialogue: 0,0:20:26.47,0:20:27.93,Default,,0,0,0,,Жарайсың Балто!
Dialogue: 0,0:20:28.01,0:20:28.85,Default,,0,0,0,,О!
Dialogue: 0,0:20:29.26,0:20:31.48,Default,,0,0,0,,Жеңіске жеткеніме қатты қуандым.
Dialogue: 0,0:20:31.77,0:20:32.43,Default,,0,0,0,,Шулы
Dialogue: 0,0:20:32.85,0:20:34.35,Default,,0,0,0,,Бұл тегін ме?
Dialogue: 0,0:20:34.94,0:20:36.65,Default,,0,0,0,,Мен үйге бардым.
Dialogue: 0,0:20:37.06,0:20:39.61,Default,,0,0,0,,Еркін маған сеніп, шығарып салды.
Dialogue: 0,0:20:40.03,0:20:44.40,Default,,0,0,0,,Әйтеуір, оның саған сенуіне еш себеп жоқ.
Dialogue: 0,0:20:44.70,0:20:46.66,Default,,0,0,0,,Тегін рахмет
Dialogue: 0,0:20:47.41,0:20:49.53,Default,,0,0,0,,(Нанами) Қолына тиген жоқсың ба? (Итадори) Иә.
Dialogue: 0,0:20:54.00,0:20:55.79,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:21:05.72,0:21:09.26,Default,,0,0,0,,Балт Мен сенімен тағы да күресетін күнге дейін
Dialogue: 0,0:21:10.47,0:21:12.39,Default,,0,0,0,,Мен не істеуім керек болса, соны істеймін!
Dialogue: 0,0:21:19.86,0:21:21.40,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:21:21.98,0:21:23.82,Default,,0,0,0,,Бұл кедергі.
Dialogue: 0,0:21:24.32,0:21:27.32,Default,,0,0,0,,Менде бөлме дайын, келіңіз.
Dialogue: 0,0:21:28.28,0:21:31.87,Default,,0,0,0,,Менің сізге айтарым өте маңызды.
Dialogue: 0,0:21:35.04,0:21:36.54,Default,,0,0,0,,Мм! Аузың қызық болса да—
Dialogue: 0,0:21:55.89,0:21:58.40,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.48,0:22:01.90,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:01.98,0:22:04.69,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.78,0:22:06.90,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:06.99,0:22:10.57,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.66,0:22:14.29,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.37,0:22:16.20,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.29,0:22:18.04,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.12,0:22:19.83,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.92,0:22:21.50,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.59,0:22:23.55,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.63,0:22:26.05,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.13,0:22:29.05,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.13,0:22:32.76,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.85,0:22:36.52,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.60,0:22:38.27,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.35,0:22:41.61,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.69,0:22:43.94,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.02,0:22:47.44,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.53,0:22:51.07,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.16,0:22:53.16,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.24,0:22:54.95,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:55.04,0:22:58.46,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.54,0:23:00.37,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.46,0:23:03.54,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.63,0:23:05.84,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:05.92,0:23:09.84,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.93,0:23:13.51,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.60,0:23:17.10,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.18,0:23:20.52,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.60,0:23:22.27,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.35,0:23:22.69,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:22.69,0:23:25.02,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:22.69,0:23:25.02,Default,,0,0,0,,~♪
Dialogue: 0,0:23:25.02,0:23:25.52,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.53,0:23:31.32,Default,,0,0,0,,Yahoo! Мен ақыры әлемдік рейтингке ендім.
Dialogue: 0,0:23:31.41,0:23:34.03,Default,,0,0,0,,Мен матчта еркін сырғанау арқасында жеңіске жеттім.
Dialogue: 0,0:23:34.12,0:23:36.58,Default,,0,0,0,,Ол таң қаларлықтай жақсы жігіт.
Dialogue: 0,0:23:36.83,0:23:38.50,Default,,0,0,0,,Не? Тегін бе?
Dialogue: 0,0:23:38.58,0:23:41.42,Default,,0,0,0,,Сіз кенеттен не айтып тұрсыз? Бұл дұрыс емес!
Dialogue: 0,0:23:41.62,0:23:44.17,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:44.25,0:23:45.84,Default,,0,0,0,,Барт және Фри
Dialogue: 0,0:23:45.92,0:23:49.63,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.13,0:23:57.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory