Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.17,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.09,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.43,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:19.97,0:00:24.39,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.06,0:00:29.65,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:32.11,0:00:34.24,Default,,0,0,0,,Біз фильм түсіріп жатқанбыз.
Dialogue: 0,0:00:34.32,0:00:38.49,Default,,0,0,0,,Голливуд жұлдызы және «Үлкен 5» тобының мүшесі Джошуа Бунмен шығанақтағы кездесу!
Dialogue: 0,0:00:39.28,0:00:41.08,Default,,0,0,0,,Мен біріншімін!
Dialogue: 0,0:00:41.33,0:00:45.62,Default,,0,0,0,,Менің кезегім келгенде, Уақия кіріп келді!
Dialogue: 0,0:00:49.04,0:00:50.38,Default,,0,0,0,,(үру)
Dialogue: 0,0:00:50.46,0:00:55.30,Default,,0,0,0,,Иә! Циклон есептегіші!
Dialogue: 0,0:00:56.97,0:00:59.05,Default,,0,0,0,,(Айдаһардың айқайы)
Dialogue: 0,0:00:59.14,0:01:00.35,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:00.60,0:01:01.64,Default,,0,0,0,,Не!
Dialogue: 0,0:01:02.10,0:01:04.73,Default,,0,0,0,,Не? Жақсы!
Dialogue: 0,0:01:04.81,0:01:06.64,Default,,0,0,0,,Жарайды, бірден.
Dialogue: 0,0:01:07.56,0:01:08.86,Default,,0,0,0,,Джошуа?
Dialogue: 0,0:01:09.11,0:01:10.27,Default,,0,0,0,,Жарыс басталмас бұрын Қвиркіңді қолданба! Өзіңді шаршатпа!
Dialogue: 0,0:01:10.36,0:01:13.15,Default,,0,0,0,,Джошуа дереу Америкаға оралуы керек.
Dialogue: 0,0:01:13.23,0:01:14.65,Default,,0,0,0,,Эх! ?
Dialogue: 0,0:01:14.74,0:01:16.70,Default,,0,0,0,,(қозғалтқыш дыбысы)
Dialogue: 0,0:01:16.78,0:01:17.99,Default,,0,0,0,,Ешуа!
Dialogue: 0,0:01:18.07,0:01:20.70,Default,,0,0,0,,Next time we meet, let's fight!
Dialogue: 0,0:01:21.03,0:01:23.16,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:01:23.75,0:01:25.83,Default,,0,0,0,,Ұмытпа!
Dialogue: 0,0:01:29.50,0:01:32.00,Default,,0,0,0,,♪~
Dialogue: 0,0:01:32.09,0:01:34.67,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:34.76,0:01:37.05,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:37.13,0:01:39.72,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:39.80,0:01:42.14,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:42.22,0:01:43.93,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:44.02,0:01:48.10,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:49.06,0:01:53.82,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:53.90,0:01:58.24,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:58.99,0:02:03.70,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:03.79,0:02:08.67,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:08.75,0:02:13.63,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:13.71,0:02:18.72,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:18.80,0:02:22.10,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:22.18,0:02:23.64,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:23.72,0:02:26.18,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:26.27,0:02:28.43,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:28.52,0:02:30.98,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:31.06,0:02:32.15,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:32.23,0:02:33.57,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:33.65,0:02:36.11,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:36.19,0:02:42.49,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:42.57,0:02:46.87,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:46.95,0:02:49.62,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:49.71,0:02:52.08,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:52.17,0:02:54.21,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:54.21,0:02:54.75,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:54.21,0:02:54.75,Default,,0,0,0,,~♪
Dialogue: 0,0:02:54.75,0:02:54.84,Default,,0,0,0,,~♪
Dialogue: 0,0:02:54.84,0:02:58.55,Default,,0,0,0,,~♪
Dialogue: 0,0:02:54.84,0:02:58.55,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:58.55,0:02:58.97,Default,,0,0,0,,~♪
Dialogue: 0,0:03:00.34,0:03:03.30,Default,,0,0,0,,Сынақ! Муген Бей стадионы!
Dialogue: 0,0:03:04.97,0:03:06.93,Default,,0,0,0,,На… на… на…
Dialogue: 0,0:03:07.02,0:03:09.02,Default,,0,0,0,,Тынышталыңыз, Вакия мырза.
Dialogue: 0,0:03:09.10,0:03:10.06,Default,,0,0,0,,Мынаны тексеріңіз!
Dialogue: 0,0:03:10.60,0:03:13.61,Default,,0,0,0,,Бұл wbba ресми сайты емес пе?
Dialogue: 0,0:03:13.73,0:03:14.98,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:15.06,0:03:16.86,Default,,0,0,0,,Сіз өте қамқорсыз.
Dialogue: 0,0:03:18.44,0:03:22.57,Default,,0,0,0,,Wbba-ға үлкен жаңалық келді.
Dialogue: 0,0:03:22.66,0:03:25.41,Default,,0,0,0,,Beyblade superstar Joshua Boone
Dialogue: 0,0:03:25.49,0:03:30.54,Default,,0,0,0,,Үлкен бестіктің бірі Нью-Йорк Буллзмен күтпеген келісім-шарт жасайды.
Dialogue: 0,0:03:30.66,0:03:35.04,Default,,0,0,0,,It was officially announced recently.
Dialogue: 0,0:03:35.13,0:03:37.25,Default,,0,0,0,,Жақында Дүниежүзілік лига басталады.
Dialogue: 0,0:03:37.34,0:03:40.13,Default,,0,0,0,,Барған сайын қызық болып барады!
Dialogue: 0,0:03:41.22,0:03:43.72,Default,,0,0,0,,Бұл оқиға болды.
Dialogue: 0,0:03:43.84,0:03:46.60,Default,,0,0,0,,Сіз жаңа ғана зертханадасыз.
Dialogue: 0,0:03:46.68,0:03:48.77,Default,,0,0,0,,Мұны ара-тұра тексеріп тұрыңыз!
Dialogue: 0,0:03:48.85,0:03:52.44,Default,,0,0,0,,Маған кімнің қайда баратыны маңызды емес.
Dialogue: 0,0:03:52.89,0:03:55.77,Default,,0,0,0,,О, бұл жиіркенішті! Бұқалар
Dialogue: 0,0:03:55.86,0:03:58.86,Default,,0,0,0,,Еркін және Ешуа Ақшаны жинауды бұйырды.
Dialogue: 0,0:03:58.94,0:04:00.24,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:04:00.32,0:04:04.03,Default,,0,0,0,,Джошуа өз командасын шағын клубқа айналдырды.
Dialogue: 0,0:04:04.11,0:04:06.03,Default,,0,0,0,,Қиындық...
Dialogue: 0,0:04:06.62,0:04:09.04,Default,,0,0,0,,That's certainly unpleasant.
Dialogue: 0,0:04:10.08,0:04:14.29,Default,,0,0,0,,wbba. Ең үлкен шайқас Әлемдік лига!
Dialogue: 0,0:04:14.37,0:04:17.75,Default,,0,0,0,,Өз лигаларында жеңіске жеткен 16 күшті клуб
Dialogue: 0,0:04:17.84,0:04:20.92,Default,,0,0,0,,Әлемдегі бірінші орын үшін трансцендентті шайқас
Dialogue: 0,0:04:21.01,0:04:23.17,Default,,0,0,0,,Қай клуб жеңеді?
Dialogue: 0,0:04:23.26,0:04:24.88,Default,,0,0,0,,Дәл қазір, дәл осы сәтте
Dialogue: 0,0:04:24.97,0:04:29.10,Default,,0,0,0,,Блейдерлер жеңіске дайындалуда!
Dialogue: 0,0:04:35.98,0:04:37.98,Default,,0,0,0,,Эй, жүзің біртүрлі көрінеді.
Dialogue: 0,0:04:38.06,0:04:39.98,Default,,0,0,0,,Бетіңіздегі оғаш көрініс үшін кешіріңіз!
Dialogue: 0,0:04:40.07,0:04:43.65,Default,,0,0,0,,Кит оның бетінің әдеттегіден басқаша көрінетінін айтқысы келді.
Dialogue: 0,0:04:43.74,0:04:44.86,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:04:45.15,0:04:47.82,Default,,0,0,0,,Не? Шаса біртүрлі көрінеді ме?
Dialogue: 0,0:04:48.03,0:04:50.37,Default,,0,0,0,,Қазірдің өзінде тым шулы.
Dialogue: 0,0:04:50.62,0:04:53.08,Default,,0,0,0,,Иә, қарап шыға аласыз ба?
Dialogue: 0,0:04:53.50,0:04:54.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:54.54,0:04:55.75,Default,,0,0,0,,N?
Dialogue: 0,0:04:56.25,0:04:57.79,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:04:58.00,0:05:00.71,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:01.05,0:05:02.96,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:13.64,0:05:15.60,Default,,0,0,0,,Иә? (Рантаро) Ой!
Dialogue: 0,0:05:15.89,0:05:18.40,Default,,0,0,0,,Осылай ғана тоқтайды.
Dialogue: 0,0:05:18.48,0:05:20.23,Default,,0,0,0,,Сіз себебін білмейсіз бе?
Dialogue: 0,0:05:20.32,0:05:21.44,Default,,0,0,0,,Иә
Dialogue: 0,0:05:21.90,0:05:23.44,Default,,0,0,0,,Аники Түсінесіз бе?
Dialogue: 0,0:05:23.94,0:05:27.16,Default,,0,0,0,,Хмм, менің ойымша, дыбыс басқаша.
Dialogue: 0,0:05:27.24,0:05:28.57,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:05:28.66,0:05:31.74,Default,,0,0,0,,Енді «тоншу» сияқты.
Dialogue: 0,0:05:31.83,0:05:34.50,Default,,0,0,0,,Мен әдетте «Данг шах!» деп көбірек айтамын.
Dialogue: 0,0:05:34.91,0:05:37.17,Default,,0,0,0,,Бұл сізге серпін жеткіліксіз дегенді білдіре ме?
Dialogue: 0,0:05:37.25,0:05:39.21,Default,,0,0,0,,Сонымен не істеуім керек?
Dialogue: 0,0:05:39.29,0:05:41.50,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:05:41.79,0:05:45.38,Default,,0,0,0,,Күрсін... Тред осындай уақытта осында болса ғой.
Dialogue: 0,0:05:45.47,0:05:46.84,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:05:47.26,0:05:50.01,Default,,0,0,0,,Тред - бұл жұмыстан кеткен жаттықтырушы ма?
Dialogue: 0,0:05:50.47,0:05:52.85,Default,,0,0,0,,А, ұялар мен пішіндерді тексеру...
Dialogue: 0,0:05:52.93,0:05:55.10,Default,,0,0,0,,Ол маған егжей-тегжейлі кеңес берді.
Dialogue: 0,0:05:55.35,0:05:58.23,Default,,0,0,0,,Бірақ қазірден бастап мен өз бетімше бірдеңе істеуім керек.
Dialogue: 0,0:05:58.31,0:06:01.06,Default,,0,0,0,,Иә! Жасасаң, қолыңнан келеді!
Dialogue: 0,0:06:01.48,0:06:03.57,Default,,0,0,0,,Қалай дегенді қалай түсінесіңдер?
Dialogue: 0,0:06:03.65,0:06:04.94,Default,,0,0,0,,Арнайы дайындық!
Dialogue: 0,0:06:05.03,0:06:06.69,Default,,0,0,0,,Мәселе мынада...
Dialogue: 0,0:06:07.61,0:06:10.11,Default,,0,0,0,,Амансың ба? бұл клуб
Dialogue: 0,0:06:10.82,0:06:13.83,Default,,0,0,0,,Енді Дүниежүзілік лиганы жеңетін кез келді.
Dialogue: 0,0:06:14.49,0:06:18.04,Default,,0,0,0,,Жаттықтырушысыз барлығына қиын екенін білемін.
Dialogue: 0,0:06:18.29,0:06:21.71,Default,,0,0,0,,Білетіндеріңізді ескерсек, сіз өте тынышсыз.
Dialogue: 0,0:06:22.13,0:06:23.46,Default,,0,0,0,,Жеңуге ниетіңіз бар ма?
Dialogue: 0,0:06:23.92,0:06:24.80,Default,,0,0,0,,(Дауыс баяндамасы) «JoJo's Bizarre Adventure» сериалының алдыңғы бөлімдерінде
Dialogue: 0,0:06:29.26,0:06:30.39,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:06:30.84,0:06:32.35,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:32.43,0:06:36.31,Default,,0,0,0,,Қызық, апама қандай түсірілім жарасады?
Dialogue: 0,0:06:36.60,0:06:38.31,Default,,0,0,0,,Ал, сіз ше?
Dialogue: 0,0:06:38.39,0:06:41.15,Default,,0,0,0,,Бар, ат! мыс?
Dialogue: 0,0:06:41.23,0:06:42.27,Default,,0,0,0,,Негізсіз...
Dialogue: 0,0:06:42.65,0:06:45.07,Default,,0,0,0,,Эй, егер сен маған назар аударып тұрсаң
Dialogue: 0,0:06:45.15,0:06:47.11,Default,,0,0,0,,Барлығының жаттығу уақыты қысқартылады.
Dialogue: 0,0:06:47.86,0:06:51.11,Default,,0,0,0,,Ах! Менің жаттықтырушым бар. Эй, Аники?
Dialogue: 0,0:06:51.32,0:06:52.91,Default,,0,0,0,,Не? Мен?
Dialogue: 0,0:06:53.37,0:06:55.91,Default,,0,0,0,,Бұл Аники емес, Зороның атасы!
Dialogue: 0,0:06:56.20,0:06:58.41,Default,,0,0,0,,Түсіндім! Ата!
Dialogue: 0,0:06:59.50,0:07:01.21,Default,,0,0,0,,Фуфу~
Dialogue: 0,0:07:02.54,0:07:03.75,Default,,0,0,0,,Зоро?
Dialogue: 0,0:07:03.84,0:07:06.80,Default,,0,0,0,,Маған Валькириді қуаттандыруға көмектескеніңіз үшін рахмет.
Dialogue: 0,0:07:07.17,0:07:09.34,Default,,0,0,0,,Мен Бей туралы бәрін білемін.
Dialogue: 0,0:07:09.42,0:07:12.39,Default,,0,0,0,,Бұл керемет, мен кепілдік беремін!
Dialogue: 0,0:07:12.64,0:07:14.76,Default,,0,0,0,,Жинақтың кепілдігі...
Dialogue: 0,0:07:15.05,0:07:17.39,Default,,0,0,0,,Жарайды, бір кезде кездесейік.
Dialogue: 0,0:07:17.68,0:07:20.18,Default,,0,0,0,,Жарайды, мен сені бірден әкелемін.
Dialogue: 0,0:07:20.27,0:07:22.44,Default,,0,0,0,,А, сен қайда екеніңді білесің бе?
Dialogue: 0,0:07:22.77,0:07:23.77,Default,,0,0,0,,Демек, шынымен де мұнда жартылай жұмыс істеуді бастапсың ғой.
Dialogue: 0,0:07:24.19,0:07:26.94,Default,,0,0,0,,Менің атам барлық жерге көлікпен барады.
Dialogue: 0,0:07:27.02,0:07:29.11,Default,,0,0,0,,Мен қазір қайда екенімді білмеймін.
Dialogue: 0,0:07:29.19,0:07:30.65,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:30.74,0:07:33.28,Default,,0,0,0,,Ах! Жақсырақ жол болды!
Dialogue: 0,0:07:35.45,0:07:36.95,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:37.03,0:07:38.49,Default,,0,0,0,,Атаның суреті
Dialogue: 0,0:07:38.87,0:07:40.83,Default,,0,0,0,,Ата, бұл солай ма?
Dialogue: 0,0:07:40.91,0:07:43.33,Default,,0,0,0,,-де? Мұнымен не істейміз?
Dialogue: 0,0:07:43.67,0:07:47.34,Default,,0,0,0,,Оларды қаладағы Bay Club сияқты әртүрлі жерлерде орналастырыңыз.
Dialogue: 0,0:07:47.67,0:07:50.84,Default,,0,0,0,,Қалаған сияқты... Бұл ұқсас па?
Dialogue: 0,0:07:50.92,0:07:52.26,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:52.34,0:07:53.76,Default,,0,0,0,,Дәлірек айтқанда, адам ба?
Dialogue: 0,0:07:53.84,0:07:55.43,Default,,0,0,0,,Бұл адам!
Dialogue: 0,0:07:55.72,0:07:58.10,Default,,0,0,0,,Жинақтың мүмкіндіктері маған айтып береді
Dialogue: 0,0:07:59.22,0:08:00.56,Default,,0,0,0,,Ей, мен сурет саламын!
Dialogue: 0,0:08:00.64,0:08:01.98,Default,,0,0,0,,Какукара!
Dialogue: 0,0:08:02.98,0:08:04.23,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:04.31,0:08:05.69,Default,,0,0,0,,Олар бір-біріне ұқсайды!
Dialogue: 0,0:08:05.77,0:08:07.48,Default,,0,0,0,,Куза Жақсы!
Dialogue: 0,0:08:07.57,0:08:09.57,Default,,0,0,0,,Егер сізді қаласаңыз, бұл.
Dialogue: 0,0:08:09.69,0:08:12.61,Default,,0,0,0,,Неліктен бұл жаман емес?
Dialogue: 0,0:08:13.74,0:08:23.71,Default,,0,0,0,,♪~
Dialogue: 0,0:08:24.67,0:08:26.92,Default,,0,0,0,,-да? Сізде қандай да бір түсінік бар ма?
Dialogue: 0,0:08:27.34,0:08:28.71,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,0:08:28.79,0:08:30.88,Default,,0,0,0,,Іздеуден шаршадым
Dialogue: 0,0:08:31.21,0:08:33.63,Default,,0,0,0,,Мүмкін ол енді бұл қалада жоқ шығар.
Dialogue: 0,0:08:33.72,0:08:35.09,Default,,0,0,0,,Тек ол ғана жұтылып кеткен азаматтардың өкпе-ренішін қайтара алады
Dialogue: 0,0:08:41.35,0:08:43.73,Default,,0,0,0,,Мен оны таба алмаймын.
Dialogue: 0,0:08:43.81,0:08:44.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:50.23,0:08:51.40,Default,,0,0,0,,Ата!
Dialogue: 0,0:08:51.90,0:08:53.49,Default,,0,0,0,,Фофофу
Dialogue: 0,0:08:54.07,0:08:55.86,Default,,0,0,0,,Джикча~н!
Dialogue: 0,0:08:55.95,0:08:57.87,Default,,0,0,0,,Мен көп іздедім!
Dialogue: 0,0:08:58.95,0:09:01.95,Default,,0,0,0,,Ол жақсы ұсталды, дегенмен...
Dialogue: 0,0:09:02.25,0:09:04.08,Default,,0,0,0,,Сіз мұны істеп жатырсыз ба?
Dialogue: 0,0:09:04.16,0:09:07.83,Default,,0,0,0,,Иә! Тазалық Бейдің арнайы дайындығы болады.
Dialogue: 0,0:09:08.13,0:09:10.21,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:09:10.55,0:09:13.67,Default,,0,0,0,,Мен де осында көп ойнайтынмын.
Dialogue: 0,0:09:13.76,0:09:15.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:15.09,0:09:17.43,Default,,0,0,0,,Валькири қалпына келе ме?
Dialogue: 0,0:09:17.68,0:09:20.56,Default,,0,0,0,,Шитуру Шитуру Чо Шитуру!
Dialogue: 0,0:09:25.23,0:09:27.35,Default,,0,0,0,,Мұнда ештеңе өзгермейді.
Dialogue: 0,0:09:27.44,0:09:30.36,Default,,0,0,0,,Атам да сол BC Blader болды ма?
Dialogue: 0,0:09:31.11,0:09:32.86,Default,,0,0,0,,Міне, бұл туралы.
Dialogue: 0,0:09:34.28,0:09:36.45,Default,,0,0,0,,Мен Зороның атасын таптым!
Dialogue: 0,0:09:36.57,0:09:38.91,Default,,0,0,0,,О? Бұл ата!
Dialogue: 0,0:09:39.45,0:09:41.28,Default,,0,0,0,,Менің ойымша, сіз қалада болдыңыз.
Dialogue: 0,0:09:41.62,0:09:43.24,Default,,0,0,0,,Фофофу
Dialogue: 0,0:09:43.33,0:09:46.00,Default,,0,0,0,,Эй, бұл портрет сияқты.
Dialogue: 0,0:09:46.08,0:09:48.25,Default,,0,0,0,,Сіз Кумичосыз.
Dialogue: 0,0:09:48.83,0:09:50.92,Default,,0,0,0,,Ал әлгі қарын бүгіледі.
Dialogue: 0,0:09:51.00,0:09:52.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:52.25,0:09:55.51,Default,,0,0,0,,Мен сенен бұл клубқа қосылады деп күткен жоқпын.
Dialogue: 0,0:09:55.59,0:09:56.63,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:09:56.72,0:09:57.84,Default,,0,0,0,,Сәлем, ата
Dialogue: 0,0:09:57.93,0:10:00.09,Default,,0,0,0,,Мен сізден бір нәрсені қарап шыққаныңызды қалаймын.
Dialogue: 0,0:10:00.68,0:10:02.60,Default,,0,0,0,,(түтіксіз айналмалы дыбыс)
Dialogue: 0,0:10:05.31,0:10:07.94,Default,,0,0,0,,О, бұл дыбыс...
Dialogue: 0,0:10:12.40,0:10:13.61,Default,,0,0,0,,бірақ енді Эсидиси жеңілгендіктен—
Dialogue: 0,0:10:14.40,0:10:15.53,Default,,0,0,0,,Ммм
Dialogue: 0,0:10:16.03,0:10:17.74,Default,,0,0,0,,Ата, сіз қалай ойлайсыз?
Dialogue: 0,0:10:18.40,0:10:19.53,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:25.66,0:10:26.75,Default,,0,0,0,,(айналмалы дыбыс)
Dialogue: 0,0:10:27.33,0:10:30.54,Default,,0,0,0,,Құпия! Шұңқыр тазалаушы!
Dialogue: 0,0:10:32.13,0:10:34.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:35.71,0:10:38.05,Default,,0,0,0,,Әй, бәрі бітті.
Dialogue: 0,0:10:38.13,0:10:41.05,Default,,0,0,0,,Уау! (Жаным) Пикапика!
Dialogue: 0,0:10:41.14,0:10:43.80,Default,,0,0,0,,Жарайды Шаса, шайқасайық!
Dialogue: 0,0:10:44.18,0:10:45.22,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:45.60,0:10:47.31,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:10:47.73,0:10:50.39,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:50.52,0:10:52.77,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:56.73,0:10:57.69,Default,,0,0,0,,Ах
Dialogue: 0,0:10:57.78,0:10:58.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:58.86,0:11:01.36,Default,,0,0,0,,Жылдамдық бұрынғыдан мүлде басқаша!
Dialogue: 0,0:11:01.49,0:11:02.49,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:11:05.62,0:11:08.87,Default,,0,0,0,,Сіз Валькиридің шабуылынан осыншама ұзақ уақыт бойы қалай аман қалдыңыз?
Dialogue: 0,0:11:09.16,0:11:10.54,Default,,0,0,0,,Не өзгерді?
Dialogue: 0,0:11:10.96,0:11:12.46,Default,,0,0,0,,Қарамаңдар
Dialogue: 0,0:11:12.54,0:11:16.67,Default,,0,0,0,,Матч кезінде жүзуші тек өзінің биін көреді.
Dialogue: 0,0:11:16.75,0:11:17.80,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:11:20.13,0:11:22.01,Default,,0,0,0,,Әй, Валькири!
Dialogue: 0,0:11:26.97,0:11:28.10,Default,,0,0,0,,Э-э, не істеп жатырсыз, мырза?
Dialogue: 0,0:11:29.23,0:11:31.44,Default,,0,0,0,,Шаса айналдырумен жеңеді!
Dialogue: 0,0:11:31.85,0:11:33.94,Default,,0,0,0,,Жоғарғы топты ұтты
Dialogue: 0,0:11:34.56,0:11:36.11,Default,,0,0,0,,Ура!
Dialogue: 0,0:11:36.19,0:11:39.28,Default,,0,0,0,,Біраз уақыт өтті. Балтоны жеңгеніме өте қуаныштымын!
Dialogue: 0,0:11:39.36,0:11:42.28,Default,,0,0,0,,Зоро~ Рахмет сізге Зоро!
Dialogue: 0,0:11:42.53,0:11:45.20,Default,,0,0,0,,Хохо, дәл осылай.
Dialogue: 0,0:11:45.57,0:11:47.83,Default,,0,0,0,,Керемет екен, ата.
Dialogue: 0,0:11:48.37,0:11:52.58,Default,,0,0,0,,Шындығында, бұрағыш аздап кірленген.
Dialogue: 0,0:11:52.67,0:11:56.34,Default,,0,0,0,,Әлгі кір Бидің қимылын бәсеңдетіп тұрды.
Dialogue: 0,0:11:56.75,0:11:59.38,Default,,0,0,0,,Менің ойымша, түсіну қиын.
Dialogue: 0,0:11:59.46,0:12:01.05,Default,,0,0,0,,Бұл кішкентай нәрсе
Dialogue: 0,0:12:01.13,0:12:02.93,Default,,0,0,0,,Керемет
Dialogue: 0,0:12:03.26,0:12:04.39,Default,,0,0,0,,Және Барт
Dialogue: 0,0:12:04.47,0:12:07.85,Default,,0,0,0,,Мен әлі Валькириді меңгердім деп айта алмаймын.
Dialogue: 0,0:12:09.60,0:12:12.18,Default,,0,0,0,,Мастер Зоро! Зоро мырза!
Dialogue: 0,0:12:12.27,0:12:14.23,Default,,0,0,0,,Менікін де қараңызшы! Мен де!
Dialogue: 0,0:12:14.60,0:12:15.81,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:12:15.90,0:12:16.90,Default,,0,0,0,,Крис!
Dialogue: 0,0:12:17.19,0:12:19.11,Default,,0,0,0,,Эй, сен оны дәл қазір көрдің бе?
Dialogue: 0,0:12:19.19,0:12:21.82,Default,,0,0,0,,Менің атам болсаң, ең жақсы жаттықтырушысың.
Dialogue: 0,0:12:22.28,0:12:24.86,Default,,0,0,0,,Маған сен туралы білуді сұрады.
Dialogue: 0,0:12:25.32,0:12:28.41,Default,,0,0,0,,Қарт маған саған абай бол деді.
Dialogue: 0,0:12:28.78,0:12:30.91,Default,,0,0,0,,Хэхехе Джинбэй
Dialogue: 0,0:12:31.00,0:12:34.67,Default,,0,0,0,,Командамен араласқым келмейтін сияқты.
Dialogue: 0,0:12:35.04,0:12:36.29,Default,,0,0,0,,Джинбе?
Dialogue: 0,0:12:36.54,0:12:38.34,Default,,0,0,0,,Бұл жас келіншектің атасы
Dialogue: 0,0:12:38.75,0:12:43.05,Default,,0,0,0,,Баяғыда ол екеуміз бір-бірімізге қарсылас болдық.
Dialogue: 0,0:12:43.47,0:12:45.09,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:12:46.01,0:12:47.93,Default,,0,0,0,,Енді бір аптадан кейін.
Dialogue: 0,0:12:48.01,0:12:50.77,Default,,0,0,0,,Менің не істеп жатқанымды көре аласыз ба?
Dialogue: 0,0:12:51.60,0:12:55.64,Default,,0,0,0,,Содан кейін мені жұмысқа алғыңыз келе ме, жоқ па, соны шешіңіз.
Dialogue: 0,0:12:56.48,0:12:58.61,Default,,0,0,0,,Барлығы жақсы өтті.
Dialogue: 0,0:12:58.94,0:13:00.36,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:00.94,0:13:04.90,Default,,0,0,0,,Енді мен сізге кадрларыңызды көрсетейін.
Dialogue: 0,0:13:04.99,0:13:06.70,Default,,0,0,0,,Фофофу~
Dialogue: 0,0:13:08.03,0:13:11.12,Default,,0,0,0,,Зоро кіріп келгенде қызық.
Dialogue: 0,0:13:11.37,0:13:13.00,Default,,0,0,0,,Менің ойымша, солай ма?
Dialogue: 0,0:13:13.12,0:13:15.71,Default,,0,0,0,,Ата мен Зоро бірге болған кездегі атмосфера қандай болды?
Dialogue: 0,0:13:15.79,0:13:17.92,Default,,0,0,0,,Бұл өте әсерлі болды.
Dialogue: 0,0:13:18.25,0:13:22.76,Default,,0,0,0,,Менің ойымша, оның атақты болуына күшінің сыры осында.
Dialogue: 0,0:13:23.80,0:13:28.05,Default,,0,0,0,,Соңғы уақытқа дейін бұл жер тек намысты студенттерге тар болатын.
Dialogue: 0,0:13:28.14,0:13:30.47,Default,,0,0,0,,Бұл мүлдем жарқыраған жоқ.
Dialogue: 0,0:13:30.68,0:13:34.48,Default,,0,0,0,,Бірақ қазір ол әдемі түрде бұдыр болып барады.
Dialogue: 0,0:13:34.89,0:13:39.44,Default,,0,0,0,,Барлығы бәсекелес, бізге көбірек жалтақтау керек
Dialogue: 0,0:13:42.36,0:13:43.94,Default,,0,0,0,,Мфффф
Dialogue: 0,0:13:44.24,0:13:46.53,Default,,0,0,0,,Әй, не болды?
Dialogue: 0,0:13:46.74,0:13:48.49,Default,,0,0,0,,Бұл бәрі ме?
Dialogue: 0,0:13:48.57,0:13:49.57,Default,,0,0,0,,Иә
Dialogue: 0,0:13:49.66,0:13:51.45,Default,,0,0,0,,Енді мен ұйықтайын деп жатырмын.
Dialogue: 0,0:13:52.08,0:13:53.33,Default,,0,0,0,,Олай ма?
Dialogue: 0,0:13:53.41,0:13:55.75,Default,,0,0,0,,Айтар сөзің жоқ па?
Dialogue: 0,0:13:56.29,0:13:57.96,Default,,0,0,0,,А-а-а
Dialogue: 0,0:14:12.14,0:14:13.72,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:14:14.93,0:14:18.52,Default,,0,0,0,,(Бұрғылау дыбысы)
Dialogue: 0,0:14:19.14,0:14:20.69,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:21.48,0:14:24.28,Default,,0,0,0,,(Бұрғылау дыбысы)
Dialogue: 0,0:14:24.61,0:14:26.07,Default,,0,0,0,,Зоро?
Dialogue: 0,0:14:26.15,0:14:29.41,Default,,0,0,0,,Иә, кеудемді ауыртып ұстап тұрдым.
Dialogue: 0,0:14:31.28,0:14:34.62,Default,,0,0,0,,Мен таңғы ас ішуге келсем, қалыпты болды.
Dialogue: 0,0:14:34.99,0:14:36.91,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:14:37.37,0:14:41.42,Default,,0,0,0,,Мен аздап уайымдап тұрмын, егер кеуде ауруы болса...
Dialogue: 0,0:14:41.50,0:14:43.29,Default,,0,0,0,,Атам ауырып қалды ма?
Dialogue: 0,0:14:44.17,0:14:45.92,Default,,0,0,0,,Джикчан!
Dialogue: 0,0:14:46.42,0:14:48.67,Default,,0,0,0,,Әже, жақсысыз ба?
Dialogue: 0,0:14:48.76,0:14:50.43,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:14:50.51,0:14:53.30,Default,,0,0,0,,Мен Кристің осылай ауырғанын көрдім.
Dialogue: 0,0:14:54.14,0:14:55.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:55.85,0:14:57.02,Default,,0,0,0,,Ата...
Dialogue: 0,0:14:57.10,0:15:00.31,Default,,0,0,0,,Әй... Өліп қалатын түрі жоқ, солай ма?
Dialogue: 0,0:15:00.73,0:15:02.27,Default,,0,0,0,,Сен өлесің! ?
Dialogue: 0,0:15:02.65,0:15:05.77,Default,,0,0,0,,Пуу гааааааа!
Dialogue: 0,0:15:06.07,0:15:08.36,Default,,0,0,0,,Өлу? Мен бе?
Dialogue: 0,0:15:08.69,0:15:11.57,Default,,0,0,0,,Ақымақ болма, мен өлмейтінмін.
Dialogue: 0,0:15:11.66,0:15:15.78,Default,,0,0,0,,Қараңызшы, мынау!
Dialogue: 0,0:15:20.58,0:15:22.79,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:30.01,0:15:32.93,Default,,0,0,0,,Өлмейтінмін дедің, жарайды.
Dialogue: 0,0:15:33.34,0:15:34.35,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:15:34.43,0:15:36.10,Default,,0,0,0,,Атам сауығып кетеді деп үміттенемін.
Dialogue: 0,0:15:36.18,0:15:38.97,Default,,0,0,0,,Мен және Валькири одан да күштірек боламыз.
Dialogue: 0,0:15:39.56,0:15:41.19,Default,,0,0,0,,Жақсы айтты Барто!
Dialogue: 0,0:15:41.35,0:15:44.73,Default,,0,0,0,,Бірақ мені қызықтыратын бір нәрсе бар.
Dialogue: 0,0:15:44.81,0:15:45.69,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:46.02,0:15:48.82,Default,,0,0,0,,Мен Зороның көлігінен біртүрлі дыбыс шығып жатыр.
Dialogue: 0,0:15:48.90,0:15:51.70,Default,,0,0,0,,Мүмкін оның ауруға қатысы бар шығар?
Dialogue: 0,0:15:52.45,0:15:54.66,Default,,0,0,0,,Ауруыңыз туралы айтуды доғарыңыз.
Dialogue: 0,0:15:54.78,0:15:57.08,Default,,0,0,0,,Зороны ең жігерлі ететін не?
Dialogue: 0,0:15:57.16,0:15:59.58,Default,,0,0,0,,Бұл біздің деңгейді көтеруіміз туралы емес пе?
Dialogue: 0,0:16:01.50,0:16:04.46,Default,,0,0,0,,Жақсы, жақсы нәрсе айттыңыз.
Dialogue: 0,0:16:10.59,0:16:12.30,Default,,0,0,0,,Өйткені, осы өткен аптада
Dialogue: 0,0:16:12.38,0:16:14.97,Default,,0,0,0,,Қария, мен жаңа ғана біздің түсірілімді тамашалап отырдым.
Dialogue: 0,0:16:15.43,0:16:17.93,Default,,0,0,0,,Сіз маған ешқандай кеңес бермедіңіз.
Dialogue: 0,0:16:18.01,0:16:18.93,Default,,0,0,0,,Иә
Dialogue: 0,0:16:19.01,0:16:20.98,Default,,0,0,0,,Бірақ біз мұнда не үшін жиналдық?
Dialogue: 0,0:16:22.52,0:16:25.48,Default,,0,0,0,,Жарайды, жарайды, барлығы осында.
Dialogue: 0,0:16:25.56,0:16:26.94,Default,,0,0,0,,Нфуфуфу
Dialogue: 0,0:16:32.90,0:16:34.82,Default,,0,0,0,,(есіктің сықырлаған дыбысы)
Dialogue: 0,0:16:35.82,0:16:37.37,Default,,0,0,0,,(қозғау дауысы)
Dialogue: 0,0:16:37.66,0:16:38.87,Default,,0,0,0,,Жер асты?
Dialogue: 0,0:16:39.16,0:16:41.04,Default,,0,0,0,,Осындай жер болған
Dialogue: 0,0:16:41.37,0:16:43.62,Default,,0,0,0,,Эй, мен түстім.
Dialogue: 0,0:16:43.91,0:16:47.67,Default,,0,0,0,,Джинбей екеуміз ойнайтынбыз.
Dialogue: 0,0:16:48.21,0:16:49.84,Default,,0,0,0,,Бұл қорқынышты...
Dialogue: 0,0:16:49.92,0:16:50.84,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:50.92,0:16:52.92,Default,,0,0,0,,Ата, бұл қайда?
Dialogue: 0,0:16:53.05,0:16:55.22,Default,,0,0,0,,Неге қорқасың?
Dialogue: 0,0:16:55.55,0:16:57.64,Default,,0,0,0,,Эй...эй!
Dialogue: 0,0:16:57.72,0:17:02.73,Default,,0,0,0,,Фуфу~ Мен не шығатынын асыға күтемін.
Dialogue: 0,0:17:03.52,0:17:05.02,Default,,0,0,0,,(есіктің сықырлаған дыбысы)
Dialogue: 0,0:17:06.06,0:17:07.56,Default,,0,0,0,,Джажан~н
Dialogue: 0,0:17:08.36,0:17:09.61,Default,,0,0,0,,Стадион?
Dialogue: 0,0:17:10.23,0:17:12.15,Default,,0,0,0,,Мұны атам жасады ма?
Dialogue: 0,0:17:12.86,0:17:16.61,Default,,0,0,0,,Бұл мен көліктің ішінен шыққан дыбыс еді.
Dialogue: 0,0:17:17.07,0:17:19.12,Default,,0,0,0,,Бірақ бұл жай ғана стадион.
Dialogue: 0,0:17:21.16,0:17:23.41,Default,,0,0,0,,Жақсы! Бұл сізге -
Dialogue: 0,0:17:23.50,0:17:26.21,Default,,0,0,0,,Бұл деңгейді көтеруге көмектесетін құпия қару.
Dialogue: 0,0:17:26.54,0:17:28.17,Default,,0,0,0,,Құпия қару?
Dialogue: 0,0:17:28.63,0:17:30.00,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:17:31.00,0:17:34.13,Default,,0,0,0,,«Шексіз Бей стадионы»!
Dialogue: 0,0:17:35.55,0:17:36.59,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:17:36.68,0:17:39.01,Default,,0,0,0,,Келіңіздер! Сіздің Валькирия
Dialogue: 0,0:17:39.09,0:17:41.72,Default,,0,0,0,,Осы ортаңғы шығанақты сипап көріңіз.
Dialogue: 0,0:17:41.81,0:17:45.60,Default,,0,0,0,,Бұл шығанақта бұрылыс жоқ, сондықтан бұл оңай, солай ма?
Dialogue: 0,0:17:45.89,0:17:48.48,Default,,0,0,0,,Хехе, ол туралы ше?
Dialogue: 0,0:17:48.56,0:17:51.02,Default,,0,0,0,,Сіз мұны шынымен жасай аласыз ба?
Dialogue: 0,0:17:52.07,0:17:54.99,Default,,0,0,0,,Жарайды, мен сені бір атып жіберемін.
Dialogue: 0,0:17:55.40,0:17:58.53,Default,,0,0,0,,Кеттік, атуға барайық!
Dialogue: 0,0:17:59.74,0:18:00.66,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:18:02.66,0:18:03.66,Default,,0,0,0,,Айналды!
Dialogue: 0,0:18:05.33,0:18:06.29,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:18:09.67,0:18:10.71,Default,,0,0,0,,Не?
Dialogue: 0,0:18:14.42,0:18:16.30,Default,,0,0,0,,(қозғау дауысы)
Dialogue: 0,0:18:28.35,0:18:29.44,Default,,0,0,0,,Не болды!
Dialogue: 0,0:18:29.52,0:18:32.02,Default,,0,0,0,,Оны бір оқпен жою керек емес пе?
Dialogue: 0,0:18:32.11,0:18:33.86,Default,,0,0,0,,Мен қозғала алмаймын...
Dialogue: 0,0:18:34.11,0:18:37.15,Default,,0,0,0,,Бұл сары бөлік айналады.
Dialogue: 0,0:18:37.40,0:18:38.86,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:18:39.32,0:18:40.99,Default,,0,0,0,,Бұл не болып жатыр?
Dialogue: 0,0:18:41.07,0:18:43.33,Default,,0,0,0,,Ортасында тұрып қалды ма?
Dialogue: 0,0:18:43.99,0:18:46.54,Default,,0,0,0,,Иә? Бұл сізді ренжітпейді.
Dialogue: 0,0:18:46.83,0:18:48.87,Default,,0,0,0,,Жоқ, жоқ, мен сені үрлеймін.
Dialogue: 0,0:18:48.96,0:18:50.08,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:18:54.09,0:18:55.25,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:18:55.88,0:18:58.38,Default,,0,0,0,,Шындығында, олар магниттермен ғана жабысады.
Dialogue: 0,0:18:58.47,0:19:00.09,Default,,0,0,0,,Магнит?
Dialogue: 0,0:19:00.51,0:19:03.10,Default,,0,0,0,,Сонда магнит осында орналасады.
Dialogue: 0,0:19:03.43,0:19:07.31,Default,,0,0,0,,Десе де, Валькиридің оны ұшырып жібере алмағаны осыны білдіреді
Dialogue: 0,0:19:07.39,0:19:11.69,Default,,0,0,0,,Бұл Балттың соққысы соншалықты күшті болмады дегенді білдірмейді.
Dialogue: 0,0:19:13.06,0:19:17.15,Default,,0,0,0,,Өткен аптада маған сіздің түсіру үлгілеріңіз көрсетілді.
Dialogue: 0,0:19:17.40,0:19:21.07,Default,,0,0,0,,Бұл өте ерекше және көруге тұрарлық болды.
Dialogue: 0,0:19:21.53,0:19:22.41,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:19:22.49,0:19:26.33,Default,,0,0,0,,Біз Дүниежүзілік лиганы жеңуден әлі алыспыз.
Dialogue: 0,0:19:27.54,0:19:32.21,Default,,0,0,0,,Ағымдағы күшіңізді біліп, мақсатыңызды биік қойыңыз.
Dialogue: 0,0:19:32.75,0:19:35.59,Default,,0,0,0,,-да? Бұл стадионның оған қандай қатысы бар?
Dialogue: 0,0:19:36.00,0:19:37.63,Default,,0,0,0,,Бұл шексіз шығанақ
Dialogue: 0,0:19:37.88,0:19:41.18,Default,,0,0,0,,Айналу қуатын еркін ауыстыруға болады
Dialogue: 0,0:19:41.26,0:19:42.59,Default,,0,0,0,,Мұнда (операция дыбысы)
Dialogue: 0,0:19:45.30,0:19:46.26,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:19:47.31,0:19:48.27,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:19:49.73,0:19:51.52,Default,,0,0,0,,Бұл жігітті жеңе алмасаң
Dialogue: 0,0:19:51.60,0:19:54.90,Default,,0,0,0,,Дүниежүзілік лигада жеңіске жету қиын.
Dialogue: 0,0:19:54.98,0:19:56.40,Default,,0,0,0,,(Түкіру дыбысы)
Dialogue: 0,0:19:56.48,0:19:57.61,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:19:57.69,0:20:00.11,Default,,0,0,0,,Мен бұл жігітті жеңе аламын деп үміттенемін.
Dialogue: 0,0:20:00.40,0:20:02.11,Default,,0,0,0,,Керемет!
Dialogue: 0,0:20:02.20,0:20:03.99,Default,,0,0,0,,Иә, бұл қызықты көрінеді.
Dialogue: 0,0:20:04.16,0:20:05.62,Default,,0,0,0,,Жарайсың, ата!
Dialogue: 0,0:20:06.07,0:20:08.62,Default,,0,0,0,,Мақтау, мадақтау, мадақтау көбірек.
Dialogue: 0,0:20:08.70,0:20:12.25,Default,,0,0,0,,Фофофу
Dialogue: 0,0:20:12.50,0:20:14.42,Default,,0,0,0,,Жарайды, солай!
Dialogue: 0,0:20:14.50,0:20:15.88,Default,,0,0,0,,Маған рұқсат етіңіз!
Dialogue: 0,0:20:15.96,0:20:17.92,Default,,0,0,0,,Сіз мұны ертерек жасаған жоқсыз ба?
Dialogue: 0,0:20:18.00,0:20:19.80,Default,,0,0,0,,Мен де жасаймын!
Dialogue: 0,0:20:20.38,0:20:23.38,Default,,0,0,0,,Мен де тыңғылықты дайындалып, үздік командаға қосылуды мақсат етемін!
Dialogue: 0,0:20:23.47,0:20:25.72,Default,,0,0,0,,Иә, екінші орынмен шектеліп қалмаңыз.
Dialogue: 0,0:20:25.80,0:20:26.76,Default,,0,0,0,,Мен де!
Dialogue: 0,0:20:26.93,0:20:29.39,Default,,0,0,0,,(Барлығының шуы)
Dialogue: 0,0:20:31.93,0:20:33.14,Default,,0,0,0,,Крис!
Dialogue: 0,0:20:33.23,0:20:36.10,Default,,0,0,0,,Керемет Mugen Bay стадионы!
Dialogue: 0,0:20:40.15,0:20:42.86,Default,,0,0,0,,Міне, уәде етілген апта болды.
Dialogue: 0,0:20:42.95,0:20:46.49,Default,,0,0,0,,Мен әркімнің сезімін соншалықты өзгерте алатыныма сене алмаймын.
Dialogue: 0,0:20:47.07,0:20:48.58,Default,,0,0,0,,Әрқайсысы бәсекелес
Dialogue: 0,0:20:49.03,0:20:51.66,Default,,0,0,0,,Мүшелердің жауынгерлік рухын оятты.
Dialogue: 0,0:20:52.00,0:20:54.21,Default,,0,0,0,,Бұл тым көп мақтау.
Dialogue: 0,0:20:54.50,0:20:57.63,Default,,0,0,0,,Жауынгерлік инстинкт бұдан былай өршиді!
Dialogue: 0,0:20:59.17,0:21:00.96,Default,,0,0,0,,BC Sol, өтінемін.
Dialogue: 0,0:21:01.67,0:21:04.47,Default,,0,0,0,,Ата, өтінемін!
Dialogue: 0,0:21:04.55,0:21:06.43,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:21:06.51,0:21:08.14,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууу
Dialogue: 0,0:21:09.26,0:21:10.56,Default,,0,0,0,,Ата! (Рантаро) Ия!
Dialogue: 0,0:21:10.64,0:21:11.60,Default,,0,0,0,,Зоро?
Dialogue: 0,0:21:11.68,0:21:13.93,Default,,0,0,0,,Бұл ауырады ма? (Рантаро) Сіз өлмейсіз, солай ма?
Dialogue: 0,0:21:14.06,0:21:15.85,Default,,0,0,0,,Не болды!
Dialogue: 0,0:21:16.44,0:21:17.81,Default,,0,0,0,,Не?
Dialogue: 0,0:21:18.06,0:21:19.73,Default,,0,0,0,,Өтірік айту да ыңғайлы
Dialogue: 0,0:21:19.82,0:21:22.28,Default,,0,0,0,,Сіздің ынтаңызды ояту
Dialogue: 0,0:21:22.36,0:21:23.86,Default,,0,0,0,,Жай ғана пьеса
Dialogue: 0,0:21:23.94,0:21:27.78,Default,,0,0,0,,Е-е, қызық, қызық, о хохо хохо!
Dialogue: 0,0:21:27.86,0:21:29.53,Default,,0,0,0,,Джикчан!
Dialogue: 0,0:21:29.62,0:21:31.91,Default,,0,0,0,,Кочочочочо...
Dialogue: 0,0:21:31.99,0:21:34.04,Default,,0,0,0,,Осы кісі болғанына қуанамын ба...
Dialogue: 0,0:21:34.12,0:21:35.46,Default,,0,0,0,,Чочочочочо…
Dialogue: 0,0:21:35.54,0:21:36.87,Default,,0,0,0,,Таңқаларлық емес...
Dialogue: 0,0:21:39.21,0:21:40.59,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:21:42.80,0:21:44.72,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:21:44.80,0:21:48.01,Default,,0,0,0,,Ах! ! Cisco қашып кетті!
Dialogue: 0,0:21:48.09,0:21:49.85,Default,,0,0,0,,Бұл тас-қағаз-қайшы! Тас-қағаз-қайшы!
Dialogue: 0,0:21:49.93,0:21:53.77,Default,,0,0,0,,Алдымен шыға! Тас, қағаз, қайшы теннисі!
Dialogue: 0,0:21:56.02,0:21:58.52,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.60,0:22:01.90,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:01.98,0:22:04.74,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.82,0:22:07.11,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.20,0:22:10.70,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.78,0:22:14.49,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.58,0:22:16.20,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.29,0:22:18.08,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.17,0:22:19.96,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:20.04,0:22:21.59,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.67,0:22:23.63,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.71,0:22:26.13,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.21,0:22:29.13,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.22,0:22:32.85,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.93,0:22:36.64,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.73,0:22:38.31,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.39,0:22:41.56,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.65,0:22:44.02,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.11,0:22:47.49,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.57,0:22:51.16,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.24,0:22:53.20,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.28,0:22:54.95,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:55.04,0:22:58.58,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.66,0:23:00.67,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.75,0:23:03.63,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.71,0:23:05.92,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:06.00,0:23:09.93,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:10.01,0:23:13.60,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.68,0:23:17.18,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.27,0:23:20.52,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.60,0:23:22.27,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:20.60,0:23:22.27,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.27,0:23:22.35,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.35,0:23:25.23,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.35,0:23:25.23,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:25.23,0:23:25.57,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.61,0:23:29.11,Default,,0,0,0,,Джошуа еркін аңдып жүр ме?
Dialogue: 0,0:23:29.19,0:23:31.66,Default,,0,0,0,,Сонша алысқа барып, дос болғың келе ме?
Dialogue: 0,0:23:31.78,0:23:34.70,Default,,0,0,0,,Бірақ Джошуаның достары көп болмаған сияқты.
Dialogue: 0,0:23:35.08,0:23:38.04,Default,,0,0,0,,Соңында Дүниежүзілік лига басталады
Dialogue: 0,0:23:38.12,0:23:41.21,Default,,0,0,0,,Шыңға қарай жүгіруді бастайық!
Dialogue: 0,0:23:41.46,0:23:43.83,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.92,0:23:45.96,Default,,0,0,0,,Төңкеріс! Әлемдік лига!
Dialogue: 0,0:23:46.04,0:23:49.76,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.26,0:23:57.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory