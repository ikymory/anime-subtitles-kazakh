Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.29,0:00:05.25,Default,,0,0,0,,Бейблейд!
Dialogue: 0,0:00:07.00,0:00:09.09,Default,,0,0,0,,Бұл баланың арманы
Dialogue: 0,0:00:09.75,0:00:14.55,Default,,0,0,0,,Дүние жүзінің түкпір-түкпірінен келген пышақшылар шыңға жету үшін жарысады және бір-біріне қарсы жанын салады.
Dialogue: 0,0:00:15.47,0:00:20.22,Default,,0,0,0,,Айналсын, жарылып, жарылсын!
Dialogue: 0,0:00:20.72,0:00:23.85,Default,,0,0,0,,Даңқты жеңіске қол жеткізіңіз!
Dialogue: 0,0:00:24.60,0:00:27.81,Default,,0,0,0,,Шайқастан кейін оны міндетті түрде табасыз.
Dialogue: 0,0:00:27.90,0:00:29.98,Default,,0,0,0,,Жарқын болашақ!
Dialogue: 0,0:00:31.78,0:00:33.74,Default,,0,0,0,,God Bladers Cup 5-ші раунд
Dialogue: 0,0:00:34.03,0:00:37.41,Default,,0,0,0,,Фри Луиге өзінің шегінен асатын күшпен шабуыл жасады.
Dialogue: 0,0:00:40.24,0:00:44.12,Default,,0,0,0,,Бітті! Ештеңе үзілмейді!
Dialogue: 0,0:00:46.71,0:00:47.88,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:00:49.96,0:00:52.17,Default,,0,0,0,,Ал Фри Луисті жеңді.
Dialogue: 0,0:00:53.51,0:00:55.80,Default,,0,0,0,,Бару…
Dialogue: 0,0:00:55.97,0:00:57.34,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:00:57.43,0:00:58.34,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:01:01.77,0:01:03.77,Default,,0,0,0,,Қарсы үзіліс!
Dialogue: 0,0:01:05.56,0:01:08.77,Default,,0,0,0,,Шу Норманның егіз жауын жояды...
Dialogue: 0,0:01:08.86,0:01:11.57,Default,,0,0,0,,Бей барлық жеңістерімен финалдық турнирге өтті.
Dialogue: 0,0:01:15.61,0:01:18.78,Default,,0,0,0,,Алға!
Dialogue: 0,0:01:18.87,0:01:21.95,Default,,0,0,0,,Шексіз шабуыл!
Dialogue: 0,0:01:22.08,0:01:23.20,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:23.29,0:01:25.00,Default,,0,0,0,,Мен жаңа жүргізушімін
Dialogue: 0,0:01:25.46,0:01:28.83,Default,,0,0,0,,Boa-ны Ultimate Reboot Driver көмегімен жеңіңіз
Dialogue: 0,0:01:29.29,0:01:31.67,Default,,0,0,0,,Келесіде Куза мен Курц арасындағы кездесу.
Dialogue: 0,0:01:33.51,0:01:36.17,Default,,0,0,0,,♪~
Dialogue: 0,0:01:36.26,0:01:38.72,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:38.80,0:01:41.26,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:41.35,0:01:43.77,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:43.85,0:01:45.77,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:46.27,0:01:47.85,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:47.94,0:01:52.15,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:53.07,0:01:57.82,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:57.90,0:02:02.24,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:02.95,0:02:07.66,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:07.75,0:02:12.59,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:12.71,0:02:17.59,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:17.67,0:02:22.85,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:22.93,0:02:26.10,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:26.18,0:02:27.52,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:27.60,0:02:30.27,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:30.35,0:02:32.48,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:32.81,0:02:34.82,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:34.90,0:02:36.19,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:36.28,0:02:37.65,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:37.74,0:02:40.24,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:40.32,0:02:46.49,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:46.58,0:02:50.71,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:50.79,0:02:53.71,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:53.79,0:02:55.67,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:56.17,0:02:58.17,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:58.80,0:03:02.14,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:04.14,0:03:07.06,Default,,0,0,0,,Достық! Шешуші матчқа дейін шайқас!
Dialogue: 0,0:03:10.77,0:03:13.02,Default,,0,0,0,,Соңғы матч, Куза.
Dialogue: 0,0:03:13.10,0:03:15.98,Default,,0,0,0,,Дұрыс (Карл) Судан Судан
Dialogue: 0,0:03:16.19,0:03:20.40,Default,,0,0,0,,Мен оған барымды беремін. Маған ең жақсы шайқасыңызды көрсетіңіз.
Dialogue: 0,0:03:20.78,0:03:22.86,Default,,0,0,0,,Мен міндетті түрде Курцты жеңемін
Dialogue: 0,0:03:23.57,0:03:26.41,Default,,0,0,0,,Мен сені финалдық турнирге жіберемін.
Dialogue: 0,0:03:26.66,0:03:29.87,Default,,0,0,0,,О! Егер бұл Куза болса, ол міндетті түрде Курцты жеңе алады.
Dialogue: 0,0:03:30.29,0:03:31.33,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:03:33.33,0:03:36.67,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар!
Dialogue: 0,0:03:36.75,0:03:41.80,Default,,0,0,0,,Іріктеу лигасы ақыры қызып, шарықтау шегі жақындап қалды.
Dialogue: 0,0:03:43.22,0:03:47.26,Default,,0,0,0,,Қызыл бұрыш Мен әлі жеңген жоқпын, бірақ бұл шайқаста...
Dialogue: 0,0:03:47.35,0:03:50.43,Default,,0,0,0,,Бізге қандай акробатикалық дағдыларды көрсетесіз?
Dialogue: 0,0:03:50.52,0:03:52.52,Default,,0,0,0,,Куса Акерман!
Dialogue: 0,0:03:52.60,0:03:54.85,Default,,0,0,0,,Куза! Сіз жеңе аласыз!
Dialogue: 0,0:03:55.02,0:03:58.40,Default,,0,0,0,,Курцтың мұрнының көпірін бұзыңыз!
Dialogue: 0,0:03:58.78,0:04:01.78,Default,,0,0,0,,Көк бұрыш Қазіргі уақытта 3 жеңіс, 1 жеңіліс -
Dialogue: 0,0:04:01.86,0:04:05.91,Default,,0,0,0,,Сіз бұл шайқаста жеңіп, финалдық турнирге өте аласыз ба?
Dialogue: 0,0:04:05.99,0:04:08.41,Default,,0,0,0,,Курц Баратье!
Dialogue: 0,0:04:08.49,0:04:10.25,Default,,0,0,0,,Курц-сама~
Dialogue: 0,0:04:10.33,0:04:13.21,Default,,0,0,0,,Бір ойында да ұта алмайтын жеңілген.
Dialogue: 0,0:04:13.29,0:04:15.92,Default,,0,0,0,,Өтінемін, мені бір оқта жеңіңіз.
Dialogue: 0,0:04:16.00,0:04:20.17,Default,,0,0,0,,Толық жеңіліс Толық жеңіліс Толық жеңіліс…
Dialogue: 0,0:04:20.51,0:04:22.92,Default,,0,0,0,,Қайтадан дөрекі қолдау басталды.
Dialogue: 0,0:04:23.01,0:04:24.09,Default,,0,0,0,,Сәлем
Dialogue: 0,0:04:24.18,0:04:25.97,Default,,0,0,0,,Дәл Гесудың шеті
Dialogue: 0,0:04:26.09,0:04:28.85,Default,,0,0,0,,Куза! Ол жігіттерге алаңдамаңыз!
Dialogue: 0,0:04:28.93,0:04:30.93,Default,,0,0,0,,Шоғырлан, Куза!
Dialogue: 0,0:04:31.02,0:04:32.77,Default,,0,0,0,,Менен қорқасың ба?
Dialogue: 0,0:04:32.85,0:04:34.06,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:04:34.14,0:04:36.73,Default,,0,0,0,,Сенің қуанышың осы емес пе?
Dialogue: 0,0:04:37.11,0:04:38.48,Default,,0,0,0,,Менен жеңілсең...
Dialogue: 0,0:04:38.56,0:04:41.69,Default,,0,0,0,,Сіз финалдық турнирге бара алмауыңыз мүмкін.
Dialogue: 0,0:04:42.15,0:04:46.66,Default,,0,0,0,,Егер ұтылып қалсаңыз, сізбен бір командада бар Барто Аои финалға өте алмайды.
Dialogue: 0,0:04:46.82,0:04:48.03,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:48.20,0:04:49.74,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:04:49.83,0:04:52.33,Default,,0,0,0,,Сізден ешкім ештеңе күтпейді.
Dialogue: 0,0:04:53.12,0:04:55.54,Default,,0,0,0,,Мен енді ешқашан жеңілмеймін
Dialogue: 0,0:04:55.75,0:04:57.50,Default,,0,0,0,,Мен жеңіліске шыдай алмаймын!
Dialogue: 0,0:04:57.96,0:04:59.79,Default,,0,0,0,,Куза Мен қобалжыдым.
Dialogue: 0,0:05:00.17,0:05:02.76,Default,,0,0,0,,Бұл жыланның жалт қараған бақа.
Dialogue: 0,0:05:03.30,0:05:04.76,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:05:05.38,0:05:08.26,Default,,0,0,0,,Күшпен бәсекелессең, Курцты жеңе алмайсың.
Dialogue: 0,0:05:08.43,0:05:12.22,Default,,0,0,0,,Мұнда біз жасай алатын жалғыз нәрсе - бұл өте төзімділік режимі және төзімділік шайқасы...
Dialogue: 0,0:05:13.10,0:05:14.23,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:05:15.27,0:05:16.85,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:05:17.44,0:05:20.15,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:20.48,0:05:23.03,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:24.49,0:05:26.61,Default,,0,0,0,,Зәулім ғимараттың түсірілімі!
Dialogue: 0,0:05:27.24,0:05:29.99,Default,,0,0,0,,Кукулкан Алдын ала соққы! ?
Dialogue: 0,0:05:30.41,0:05:33.62,Default,,0,0,0,,Уау! Кронос шебер қашып жатыр!
Dialogue: 0,0:05:34.16,0:05:37.29,Default,,0,0,0,,Кроностың жоспары - оны аяқтау үшін супер төзімділік режимін пайдалану.
Dialogue: 0,0:05:37.71,0:05:38.75,Default,,0,0,0,,Оны жалама!
Dialogue: 0,0:05:41.29,0:05:42.21,Default,,0,0,0,,Ах
Dialogue: 0,0:05:42.30,0:05:43.25,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:05:43.67,0:05:45.17,Default,,0,0,0,,(Қабырғаға соғылған дыбыс)
Dialogue: 0,0:05:45.38,0:05:46.47,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:05:46.59,0:05:48.68,Default,,0,0,0,,Chronos Overfinish! ?
Dialogue: 0,0:05:48.76,0:05:50.97,Default,,0,0,0,,Мен құтылдым!
Dialogue: 0,0:05:51.30,0:05:52.85,Default,,0,0,0,,Жақсы, Кронос!
Dialogue: 0,0:05:53.26,0:05:56.43,Default,,0,0,0,,Кел, Кукулджан, жау кетті.
Dialogue: 0,0:05:56.52,0:05:58.60,Default,,0,0,0,,Шыдамыңыз таусылып жатыр ма? ?
Dialogue: 0,0:05:58.94,0:06:00.27,Default,,0,0,0,,Қатты… қатты қиын…
Dialogue: 0,0:06:03.90,0:06:07.95,Default,,0,0,0,,Уф! Кукулкан Күшті соғу
Dialogue: 0,0:06:08.03,0:06:09.82,Default,,0,0,0,,Кронос құлады!
Dialogue: 0,0:06:11.03,0:06:11.99,Default,,0,0,0,,Хмф!
Dialogue: 0,0:06:17.25,0:06:19.58,Default,,0,0,0,,Шабуылды іске қосыңыз!
Dialogue: 0,0:06:22.25,0:06:23.59,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:06:24.84,0:06:25.92,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:06:26.55,0:06:28.97,Default,,0,0,0,,Кукульканды аяқтаңыз
Dialogue: 0,0:06:29.05,0:06:31.18,Default,,0,0,0,,Курц Баратье үшін 1 ұпай
Dialogue: 0,0:06:31.47,0:06:32.47,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:06:32.55,0:06:35.18,Default,,0,0,0,,Біз мұны істедік, Курц-сама~
Dialogue: 0,0:06:35.72,0:06:37.35,Default,,0,0,0,,Бұл Яроуды толығымен жеңді
Dialogue: 0,0:06:37.43,0:06:41.19,Default,,0,0,0,,Курц-самамен бәсекелесуге әлі 100 жыл ерте!
Dialogue: 0,0:06:43.27,0:06:47.44,Default,,0,0,0,,Kronos Не істеуім керек? Қалай жеңе аламын?
Dialogue: 0,0:06:47.78,0:06:50.28,Default,,0,0,0,,Не болды? Оған ұқсамайды
Dialogue: 0,0:06:50.36,0:06:54.24,Default,,0,0,0,,Мен Аники үшін міндетті түрде жеңетінімді мәлімдеген болсам да...
Dialogue: 0,0:06:54.91,0:06:57.58,Default,,0,0,0,,Бұл кері әсер ететін сияқты.
Dialogue: 0,0:06:57.66,0:06:58.79,Default,,0,0,0,,Ата?
Dialogue: 0,0:06:59.16,0:07:02.58,Default,,0,0,0,,Егер сіз жеңіске тым көп көңіл бөлсеңіз, сіз қыңыр болып кетесіз.
Dialogue: 0,0:07:03.04,0:07:05.67,Default,,0,0,0,,Егер сіз кәдімгі Куса болсаңыз, сіз көбірек еркін боласыз.
Dialogue: 0,0:07:05.75,0:07:08.76,Default,,0,0,0,,Ол сізге шытырман оқиғалы ойын көрсететініне сенімдімін.
Dialogue: 0,0:07:08.84,0:07:11.47,Default,,0,0,0,,Дұрыс, бұл Куза емес.
Dialogue: 0,0:07:11.93,0:07:15.51,Default,,0,0,0,,Attack Kuza Attack Attack!
Dialogue: 0,0:07:16.06,0:07:17.10,Default,,0,0,0,,Ах
Dialogue: 0,0:07:18.31,0:07:19.89,Default,,0,0,0,,Мен сұр көзмін
Dialogue: 0,0:07:20.02,0:07:22.77,Default,,0,0,0,,Куза мен сенімен ұрысамын!
Dialogue: 0,0:07:28.03,0:07:31.36,Default,,0,0,0,,Кішкентай болсам да, сенен күштімін.
Dialogue: 0,0:07:31.78,0:07:33.82,Default,,0,0,0,,Сондықтан бұл Куза.
Dialogue: 0,0:07:33.91,0:07:36.95,Default,,0,0,0,,Attack Kuza Attack Attack!
Dialogue: 0,0:07:37.70,0:07:38.70,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:38.79,0:07:42.04,Default,,0,0,0,,Маған қызықтырақ нәрсе істеу керек.
Dialogue: 0,0:07:42.33,0:07:43.46,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:07:43.75,0:07:45.71,Default,,0,0,0,,А, Куза күлді.
Dialogue: 0,0:07:45.84,0:07:47.67,Default,,0,0,0,,А, мен күлдім!
Dialogue: 0,0:07:48.05,0:07:49.80,Default,,0,0,0,,Міне, Куза.
Dialogue: 0,0:07:49.88,0:07:52.30,Default,,0,0,0,,Сіз байқаған сияқтысыз.
Dialogue: 0,0:07:52.43,0:07:54.22,Default,,0,0,0,,Kuza Go!
Dialogue: 0,0:07:54.55,0:07:56.72,Default,,0,0,0,,Курцтан құтылу.
Dialogue: 0,0:07:57.35,0:08:00.22,Default,,0,0,0,,Жарайды, менің мотивация қосқышым қосылды!
Dialogue: 0,0:08:00.64,0:08:02.89,Default,,0,0,0,,Әй, хайтта~
Dialogue: 0,0:08:04.06,0:08:07.77,Default,,0,0,0,,Кронос Барлығын таң қалдырайық.
Dialogue: 0,0:08:09.11,0:08:10.74,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:08:11.15,0:08:13.11,Default,,0,0,0,,Таң қалмаңыз, Курц
Dialogue: 0,0:08:15.24,0:08:18.49,Default,,0,0,0,,Сен мені осылай сілкіп алмақсың ба?
Dialogue: 0,0:08:18.87,0:08:20.50,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:08:21.00,0:08:24.04,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:24.46,0:08:25.54,Default,,0,0,0,,Бару…
Dialogue: 0,0:08:25.63,0:08:26.67,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:08:28.71,0:08:30.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:30.46,0:08:32.26,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:08:32.63,0:08:34.26,Default,,0,0,0,,Куза Акерман!
Dialogue: 0,0:08:34.34,0:08:37.64,Default,,0,0,0,,Бұрын-соңды болмаған кері түсірілім!
Dialogue: 0,0:08:38.39,0:08:42.23,Default,,0,0,0,,Кронос керемет секірумен Кукулканды айналып өтті!
Dialogue: 0,0:08:46.90,0:08:50.15,Default,,0,0,0,,Кронос Бұрынғы атылған соққы оның күшін арттырды ма?
Dialogue: 0,0:08:50.23,0:08:53.86,Default,,0,0,0,,Бұл Кукулканмен тең!
Dialogue: 0,0:08:57.53,0:08:59.95,Default,,0,0,0,,Кукулкан! (Саусақтарды сермеу дыбысы)
Dialogue: 0,0:09:04.71,0:09:06.25,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:09:07.08,0:09:08.38,Default,,0,0,0,,Кроносты өзгертіңіз!
Dialogue: 0,0:09:17.39,0:09:19.60,Default,,0,0,0,,Шабуыл жасау!
Dialogue: 0,0:09:23.06,0:09:24.10,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:09:24.64,0:09:26.48,Default,,0,0,0,,Алға, Кронос!
Dialogue: 0,0:09:30.61,0:09:33.28,Default,,0,0,0,,Айға сүңгу!
Dialogue: 0,0:09:38.07,0:09:39.07,Default,,0,0,0,,А...
Dialogue: 0,0:09:39.53,0:09:42.29,Default,,0,0,0,,Alter Chronos Burst Finish
Dialogue: 0,0:09:42.37,0:09:44.41,Default,,0,0,0,,Жеңімпаз: Куса Акерман!
Dialogue: 0,0:09:45.00,0:09:46.16,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:09:46.58,0:09:49.13,Default,,0,0,0,,Хмм, мен жеңдім!
Dialogue: 0,0:09:50.04,0:09:51.79,Default,,0,0,0,,Сен істедің, Куза!
Dialogue: 0,0:09:51.88,0:09:52.96,Default,,0,0,0,,Керемет!
Dialogue: 0,0:09:53.09,0:09:54.80,Default,,0,0,0,,Куза!
Dialogue: 0,0:09:54.88,0:09:56.30,Default,,0,0,0,,Үлкен кері қайтару!
Dialogue: 0,0:09:57.09,0:09:59.22,Default,,0,0,0,,А... аа... Курц-сама?
Dialogue: 0,0:10:02.47,0:10:05.93,Default,,0,0,0,,Хмф, мен мүлдем жеңілген Яроудан жеңілемін деп ойламадым.
Dialogue: 0,0:10:06.68,0:10:10.86,Default,,0,0,0,,Курц Баратье Күтпеген жеңіліс!
Dialogue: 0,0:10:10.94,0:10:14.57,Default,,0,0,0,,Қазір менде Барто Аоимен тең үш жеңіс және екі жеңіліс бар.
Dialogue: 0,0:10:14.69,0:10:17.15,Default,,0,0,0,,Барто Аои мүмкіндікті пайдаланады
Dialogue: 0,0:10:17.24,0:10:22.83,Default,,0,0,0,,Финалдық турнирге өту үшін Курцпен тікелей кездесу!
Dialogue: 0,0:10:25.29,0:10:27.00,Default,,0,0,0,,Куза Сіз жасадыңыз!
Dialogue: 0,0:10:27.08,0:10:31.38,Default,,0,0,0,,А, сен мені финалдық турнирге жіберемін деп уәде бердің.
Dialogue: 0,0:10:31.46,0:10:33.25,Default,,0,0,0,,Яника Яника
Dialogue: 0,0:10:33.54,0:10:35.13,Default,,0,0,0,,О, мен сондай бақыттымын.
Dialogue: 0,0:10:35.30,0:10:38.92,Default,,0,0,0,,Құтты болсын, бұл лайықты жеңіс болды.
Dialogue: 0,0:10:39.26,0:10:42.01,Default,,0,0,0,,Бұл мен үшін де ұмытылмас жеңіс.
Dialogue: 0,0:10:42.51,0:10:44.72,Default,,0,0,0,,Балто, келесі кезегіңіз.
Dialogue: 0,0:10:45.10,0:10:46.93,Default,,0,0,0,,Курцпен жеке жекпе-жек.
Dialogue: 0,0:10:47.10,0:10:48.68,Default,,0,0,0,,Жеңіс, Балто
Dialogue: 0,0:10:48.77,0:10:53.23,Default,,0,0,0,,А, бұл сіз маған берген мүмкіндік, мен оны барынша пайдаланамын!
Dialogue: 0,0:10:53.61,0:10:55.27,Default,,0,0,0,,Букьяро!
Dialogue: 0,0:10:55.36,0:10:57.53,Default,,0,0,0,,Себебі сіздің қолдауыңыз ақымақ
Dialogue: 0,0:10:57.61,0:11:00.15,Default,,0,0,0,,Курц-саманың жағдайы есінен танып қалды!
Dialogue: 0,0:11:00.40,0:11:03.99,Default,,0,0,0,,Курц-саманың мұндай толығымен жеңілген Яроудан жеңіліп қалуы мүмкін емес.
Dialogue: 0,0:11:04.12,0:11:05.20,Default,,0,0,0,,Бискет
Dialogue: 0,0:11:05.28,0:11:06.74,Default,,0,0,0,,Ах... иә, Курц-сама.
Dialogue: 0,0:11:06.83,0:11:07.87,Default,,0,0,0,,Акселераторға да қолым жетпейді – орындық тым үлкен.
Dialogue: 0,0:11:07.95,0:11:09.33,Default,,0,0,0,,А... иә
Dialogue: 0,0:11:10.08,0:11:12.67,Default,,0,0,0,,Сіз осындай жерде ұтыла аласыз ба?
Dialogue: 0,0:11:13.25,0:11:17.76,Default,,0,0,0,,Red Eye Shirasagi Castle Louis Free De La Hoya
Dialogue: 0,0:11:17.96,0:11:19.80,Default,,0,0,0,,Оларды сындырыңыз...
Dialogue: 0,0:11:19.88,0:11:23.14,Default,,0,0,0,,Мен әлем чемпионы екенімді көрсеткенше!
Dialogue: 0,0:11:26.01,0:11:29.43,Default,,0,0,0,,Бұл қызық болып барады!
Dialogue: 0,0:11:29.81,0:11:34.77,Default,,0,0,0,,Бұл финалдық турнирге өту үшін А тобындағы екінші орын үшін матч.
Dialogue: 0,0:11:34.86,0:11:39.53,Default,,0,0,0,,Курц Баратье мен Барт Аои, үш жеңіс және екі жеңіліспен жеке жекпе-жек!
Dialogue: 0,0:11:40.53,0:11:44.41,Default,,0,0,0,,Финалдық турнирге кім қатыса алады? ?
Dialogue: 0,0:11:44.49,0:11:48.66,Default,,0,0,0,,Жең, жең, жең
Dialogue: 0,0:11:49.41,0:11:51.08,Default,,0,0,0,,Қарғыс атқыр бала!
Dialogue: 0,0:11:51.16,0:11:53.04,Default,,0,0,0,,Қанша рет жасасаңыз да...
Dialogue: 0,0:11:53.12,0:11:55.54,Default,,0,0,0,,Мен Курцты жеңе алмаймын!
Dialogue: 0,0:11:55.88,0:12:00.42,Default,,0,0,0,,Курц Баратиер бірінші раундта мәреге жетіп, жеңіске жетті
Dialogue: 0,0:12:00.51,0:12:04.30,Default,,0,0,0,,Барто Аои Ол керемет жасай ала ма?
Dialogue: 0,0:12:04.39,0:12:05.76,Default,,0,0,0,,Балто!
Dialogue: 0,0:12:05.85,0:12:08.06,Default,,0,0,0,,Балт, міндетті түрде жең!
Dialogue: 0,0:12:08.81,0:12:10.68,Default,,0,0,0,,Барлығы мені жақтайды
Dialogue: 0,0:12:11.10,0:12:12.27,Default,,0,0,0,,Сөзсіз жеңеміз
Dialogue: 0,0:12:12.35,0:12:15.44,Default,,0,0,0,,Финалдық турнирге барайық, досым!
Dialogue: 0,0:12:17.73,0:12:19.94,Default,,0,0,0,,Сәттілік Балто
Dialogue: 0,0:12:21.99,0:12:23.78,Default,,0,0,0,,Мен бір оқпен жарып шығамын.
Dialogue: 0,0:12:24.61,0:12:25.95,Default,,0,0,0,,Ах, өрттен келтірілген зиянды жөндеп жатқанда, мен де біраз жөндеу жұмыстарын жүргізгім келеді
Dialogue: 0,0:12:26.03,0:12:28.70,Default,,0,0,0,,Бір оқтан қаза тапқан сен едің.
Dialogue: 0,0:12:28.91,0:12:32.41,Default,,0,0,0,,Ендеше, бұл жолы мен сізге бір рет ат салайын!
Dialogue: 0,0:12:32.71,0:12:35.42,Default,,0,0,0,,Егер ғажайып орын алуы мүмкін болса, мен оны саған көрсетейін.
Dialogue: 0,0:12:36.00,0:12:37.38,Default,,0,0,0,,Ғажайып бала
Dialogue: 0,0:12:38.96,0:12:42.51,Default,,0,0,0,,Енді, ақыры тағдырлы шайқас басталады!
Dialogue: 0,0:12:43.30,0:12:44.51,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:12:47.18,0:12:48.76,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:12:49.14,0:12:50.85,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:12:51.22,0:12:53.81,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:54.73,0:12:56.60,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:12:56.73,0:12:57.77,Default,,0,0,0,,Ти
Dialogue: 0,0:13:04.07,0:13:07.57,Default,,0,0,0,,Кукулканның жылдам шабуылы!
Dialogue: 0,0:13:08.49,0:13:09.87,Default,,0,0,0,,Найзағай шабуылы!
Dialogue: 0,0:13:17.63,0:13:19.29,Default,,0,0,0,,Қарсы шабуыл!
Dialogue: 0,0:13:20.63,0:13:22.30,Default,,0,0,0,,Шабуыл жасау!
Dialogue: 0,0:13:24.67,0:13:25.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:25.72,0:13:26.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:29.60,0:13:32.18,Default,,0,0,0,,Әрі аяқта, әрі тең!
Dialogue: 0,0:13:32.60,0:13:33.77,Default,,0,0,0,,Сурет салу?
Dialogue: 0,0:13:34.14,0:13:35.43,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:13:35.52,0:13:37.60,Default,,0,0,0,,Жоқ, бұл қауіпті емес еді.
Dialogue: 0,0:13:37.69,0:13:39.31,Default,,0,0,0,,Бұл дәмді болды.
Dialogue: 0,0:13:39.40,0:13:40.69,Default,,0,0,0,,Бұл дәмді болды ма?
Dialogue: 0,0:13:40.77,0:13:43.15,Default,,0,0,0,,Бұл Аники жеңуі мүмкін дегенді білдіре ме?
Dialogue: 0,0:13:44.15,0:13:45.03,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:46.28,0:13:48.03,Default,,0,0,0,,Курц асығыс
Dialogue: 0,0:13:49.16,0:13:50.78,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:13:52.41,0:13:54.20,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:13:54.66,0:13:57.41,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:58.08,0:14:00.46,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:05.01,0:14:05.97,Default,,0,0,0,,Кукулкан!
Dialogue: 0,0:14:08.22,0:14:11.43,Default,,0,0,0,,Кукулкан бір жақты жоғары жылдамдықты шабуыл-
Dialogue: 0,0:14:11.51,0:14:13.18,Default,,0,0,0,,Валькириге шабуыл
Dialogue: 0,0:14:13.26,0:14:15.22,Default,,0,0,0,,Жоғалтпа, Валькири!
Dialogue: 0,0:14:15.31,0:14:17.39,Default,,0,0,0,,Түзу жүрейік, Құқұлқан!
Dialogue: 0,0:14:19.48,0:14:21.52,Default,,0,0,0,,Валькирия Әлі жоқ!
Dialogue: 0,0:14:26.78,0:14:29.49,Default,,0,0,0,,Ultimate God Reboot!
Dialogue: 0,0:14:29.57,0:14:30.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:34.24,0:14:35.66,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:14:36.37,0:14:39.42,Default,,0,0,0,,Екеуі де бір уақытта жарылып аяқталады!
Dialogue: 0,0:14:39.50,0:14:41.42,Default,,0,0,0,,Тағы бір ұтыс ойыны!
Dialogue: 0,0:14:41.50,0:14:44.30,Default,,0,0,0,,Бұл үлкен шайқасқа айналуда!
Dialogue: 0,0:14:44.92,0:14:46.51,Default,,0,0,0,,Тағы бір ұтыс...
Dialogue: 0,0:14:46.67,0:14:50.38,Default,,0,0,0,,Бұл тағы біртүрлі болды ма? Аникиде жақсырақ мүмкіндік болды ма?
Dialogue: 0,0:14:50.72,0:14:52.30,Default,,0,0,0,,Барт сөзсіз-
Dialogue: 0,0:14:52.39,0:14:56.89,Default,,0,0,0,,Сіз Ultimate Relief Driver пайдалана аласыз.
Dialogue: 0,0:14:56.97,0:14:58.52,Default,,0,0,0,,Тағы да
Dialogue: 0,0:14:58.60,0:15:00.39,Default,,0,0,0,,Курц мұны айтты ма?
Dialogue: 0,0:15:00.98,0:15:04.11,Default,,0,0,0,,Күтілгендей, бұл бұрынғы әлем чемпионы ғана жасай алатын нәрсе.
Dialogue: 0,0:15:04.52,0:15:06.07,Default,,0,0,0,,Фофофу
Dialogue: 0,0:15:07.53,0:15:10.07,Default,,0,0,0,,Сен жасайсың, Ғажайып бала
Dialogue: 0,0:15:12.32,0:15:14.58,Default,,0,0,0,,Иә? Жүргізуші...
Dialogue: 0,0:15:18.50,0:15:19.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:21.42,0:15:22.54,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:15:24.13,0:15:25.59,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:15:33.22,0:15:34.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:39.35,0:15:43.10,Default,,0,0,0,,Иә? Курцтың мыңжапырақтары маған мейірімді болды, солай емес пе?
Dialogue: 0,0:15:43.19,0:15:45.02,Default,,0,0,0,,Өзіңізді әлсіз сезінбейсіз бе?
Dialogue: 0,0:15:45.11,0:15:46.44,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:15:46.52,0:15:49.28,Default,,0,0,0,,Курц Барттың күшін мойындады.
Dialogue: 0,0:15:49.36,0:15:51.15,Default,,0,0,0,,Күшті таныдың ба?
Dialogue: 0,0:15:51.24,0:15:54.41,Default,,0,0,0,,Бұл Балттың жеңіске жеткенін білдірмейді ме?
Dialogue: 0,0:15:54.74,0:15:56.91,Default,,0,0,0,,Күшті тану дегеніміз...
Dialogue: 0,0:15:56.99,0:15:59.83,Default,,0,0,0,,Бұл жолы мен сені шын соғып жатырмын.
Dialogue: 0,0:16:00.08,0:16:02.16,Default,,0,0,0,,Сіз оны маған көрсетуіңіз керек.
Dialogue: 0,0:16:02.25,0:16:04.79,Default,,0,0,0,,Бұрынғы әлем чемпионы Хонки
Dialogue: 0,0:16:05.00,0:16:09.09,Default,,0,0,0,,Қазір бәрі терлей бастады.
Dialogue: 0,0:16:09.17,0:16:11.47,Default,,0,0,0,,Финалдық турнир үшін жеке шайқас!
Dialogue: 0,0:16:11.55,0:16:14.68,Default,,0,0,0,,Бұл шынымен үшінші шайқаста шешіледі ме?
Dialogue: 0,0:16:14.97,0:16:18.06,Default,,0,0,0,,Мені байсалды еткеніңіз үшін рахмет.
Dialogue: 0,0:16:18.56,0:16:19.56,Default,,0,0,0,,Курц…
Dialogue: 0,0:16:20.10,0:16:23.73,Default,,0,0,0,,Мен император атанғаннан бергі ең жақсы шайқасымды көрсетемін!
Dialogue: 0,0:16:24.19,0:16:25.35,Default,,0,0,0,,Бұл да
Dialogue: 0,0:16:25.44,0:16:28.23,Default,,0,0,0,,Мен және Валькири сізге толық күшімізді көрсетеміз!
Dialogue: 0,0:16:28.77,0:16:30.28,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:16:30.53,0:16:32.19,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:16:32.99,0:16:36.16,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:36.57,0:16:38.70,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:38.78,0:16:39.99,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:40.37,0:16:42.33,Default,,0,0,0,,Зәулім ғимараттың түсірілімі!
Dialogue: 0,0:16:44.92,0:16:46.83,Default,,0,0,0,,Бар, Валькири!
Dialogue: 0,0:16:46.92,0:16:48.59,Default,,0,0,0,,Жасай бер, Құқұлқан!
Dialogue: 0,0:16:55.05,0:16:57.55,Default,,0,0,0,,Шабуыл жасау!
Dialogue: 0,0:17:03.68,0:17:04.60,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:17:05.35,0:17:09.36,Default,,0,0,0,,Кукулкан бүктеледі Валькири Бұл қорғаныс шайқасы.
Dialogue: 0,0:17:09.57,0:17:12.61,Default,,0,0,0,,Валькири кеттік!
Dialogue: 0,0:17:15.36,0:17:17.87,Default,,0,0,0,,Түпкілікті Құдай қайта жүктеу!
Dialogue: 0,0:17:18.74,0:17:22.20,Default,,0,0,0,,Керемет Валькирия кенеттен жылдамдады!
Dialogue: 0,0:17:22.29,0:17:25.00,Default,,0,0,0,,Кукулканның қоршауынан қашты!
Dialogue: 0,0:17:27.33,0:17:29.00,Default,,0,0,0,,Кукулканды ұрыңыз!
Dialogue: 0,0:17:33.84,0:17:35.26,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:17:35.76,0:17:39.30,Default,,0,0,0,,Бар, Валькири!
Dialogue: 0,0:17:42.39,0:17:44.02,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:17:44.22,0:17:45.85,Default,,0,0,0,,Балтоға сәттілік!
Dialogue: 0,0:17:45.93,0:17:48.35,Default,,0,0,0,,Барту Аники
Dialogue: 0,0:17:53.23,0:17:56.49,Default,,0,0,0,,Шексіз реактивті түсірілім!
Dialogue: 0,0:18:02.37,0:18:03.87,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:18:09.50,0:18:10.96,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:18:11.13,0:18:12.38,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:18:12.71,0:18:15.17,Default,,0,0,0,,God Valkyrie Burst Finish
Dialogue: 0,0:18:15.26,0:18:17.13,Default,,0,0,0,,Жеңімпаз Барто Аои!
Dialogue: 0,0:18:17.22,0:18:18.38,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:18.59,0:18:21.39,Default,,0,0,0,,Куу~ Иә!
Dialogue: 0,0:18:21.47,0:18:23.89,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:23.97,0:18:27.89,Default,,0,0,0,,Валькири ақыры Кукулканды жеңді!
Dialogue: 0,0:18:28.27,0:18:32.90,Default,,0,0,0,,Барто Аои финалдық турнирге шығады деп шешілді.
Dialogue: 0,0:18:33.36,0:18:35.36,Default,,0,0,0,,Ия, иә!
Dialogue: 0,0:18:35.57,0:18:37.90,Default,,0,0,0,,Финалдық турнирге өту!
Dialogue: 0,0:18:38.28,0:18:39.61,Default,,0,0,0,,Алға!
Dialogue: 0,0:18:40.36,0:18:41.74,Default,,0,0,0,,Жасайық
Dialogue: 0,0:18:41.82,0:18:43.28,Default,,0,0,0,,Қол шапалақтау
Dialogue: 0,0:18:43.66,0:18:45.91,Default,,0,0,0,,Әй, бұл Балто ғой!
Dialogue: 0,0:18:46.25,0:18:48.16,Default,,0,0,0,,Қолыңнан келгеннің бәрін істедің, балақай.
Dialogue: 0,0:18:48.79,0:18:53.04,Default,,0,0,0,,Енді мен финалдық турнирді асыға күтемін.
Dialogue: 0,0:18:53.13,0:18:54.75,Default,,0,0,0,,Фофофу
Dialogue: 0,0:18:57.34,0:18:58.59,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:18:58.67,0:18:59.88,Default,,0,0,0,,Ах... ой!
Dialogue: 0,0:19:00.55,0:19:02.72,Default,,0,0,0,,Сіз менің көңілімді көтердіңіз.
Dialogue: 0,0:19:03.30,0:19:05.60,Default,,0,0,0,,Мен сенімен тезірек кездескенімді қалаймын.
Dialogue: 0,0:19:05.68,0:19:08.48,Default,,0,0,0,,Мен бұл дүниеден көбірек ләззат алар едім.
Dialogue: 0,0:19:10.94,0:19:13.06,Default,,0,0,0,,Курц Қайтадан жасайық!
Dialogue: 0,0:19:14.82,0:19:16.90,Default,,0,0,0,,Мен жер асты әлеміне қайтамын
Dialogue: 0,0:19:17.61,0:19:20.99,Default,,0,0,0,,Бұл менің әлемім. Бізге кез келген уақытта келіңіз!
Dialogue: 0,0:19:25.99,0:19:27.04,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:32.42,0:19:35.84,Default,,0,0,0,,Аники: Егер біз осы уақытқа дейін жеткен болсақ, жеңуден басқа амалымыз жоқ.
Dialogue: 0,0:19:35.92,0:19:39.59,Default,,0,0,0,,Әй, жеңеміз, жеңеміз, жеңеміз!
Dialogue: 0,0:19:39.97,0:19:41.93,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:19:42.01,0:19:42.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:44.80,0:19:46.39,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:19:46.72,0:19:48.97,Default,,0,0,0,,Боа, сен қарап тұрдың ба?
Dialogue: 0,0:19:49.06,0:19:51.64,Default,,0,0,0,,А, сен маған бір ғажайып нәрсе көрсеттің.
Dialogue: 0,0:19:52.23,0:19:54.81,Default,,0,0,0,,Бірақ келесі жолы мен сізге өзімнің қаншалықты керемет екенімді көрсетемін.
Dialogue: 0,0:19:55.19,0:19:56.23,Default,,0,0,0,,Бұрау
Dialogue: 0,0:19:56.44,0:19:57.65,Default,,0,0,0,,Жақында кездескенше!
Dialogue: 0,0:19:58.07,0:20:02.07,Default,,0,0,0,,Сіз жылан шұңқырына қайта барасыз ба? Ашрамда ма?
Dialogue: 0,0:20:04.16,0:20:07.87,Default,,0,0,0,,Сіз Балто Ашрамның не екенін білесіз бе?
Dialogue: 0,0:20:08.04,0:20:09.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:09.66,0:20:11.04,Default,,0,0,0,,Ашрамның шынайы тұлғасы қандай?
Dialogue: 0,0:20:12.46,0:20:15.46,Default,,0,0,0,,Бұл Гилтен, Нью-Йорк Буллз клубының иесі.
Dialogue: 0,0:20:15.54,0:20:16.96,Default,,0,0,0,,Гилтен?
Dialogue: 0,0:20:21.97,0:20:25.05,Default,,0,0,0,,Ол жылан шұңқырының бастығы болды ма?
Dialogue: 0,0:20:25.30,0:20:29.01,Default,,0,0,0,,А, ашрам ең күшті биді іздейді.
Dialogue: 0,0:20:29.14,0:20:30.93,Default,,0,0,0,,Ең күшті бей?
Dialogue: 0,0:20:31.02,0:20:33.10,Default,,0,0,0,,Бұл Спригган реквиемі туралы.
Dialogue: 0,0:20:33.19,0:20:34.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:34.44,0:20:35.60,Default,,0,0,0,,Бұл турнир –
Dialogue: 0,0:20:35.69,0:20:39.36,Default,,0,0,0,,Бұл Спригган реквиемін аяқтауға арналған.
Dialogue: 0,0:20:39.44,0:20:42.95,Default,,0,0,0,,Біз ол үшін жай ғана құралмыз.
Dialogue: 0,0:20:43.15,0:20:44.32,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:44.61,0:20:46.95,Default,,0,0,0,,Жылан шұңқыры да сол үшін орын.
Dialogue: 0,0:20:47.03,0:20:49.70,Default,,0,0,0,,Сондықтан мен енді ол жаққа қайтпаймын.
Dialogue: 0,0:20:50.29,0:20:51.29,Default,,0,0,0,,Бұрау
Dialogue: 0,0:20:51.87,0:20:54.12,Default,,0,0,0,,Финалдық турнирде бар күшіңізді салыңыз
Dialogue: 0,0:20:54.75,0:20:55.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:57.17,0:21:01.63,Default,,0,0,0,,Енді бүкіл әлем назарын аударып отырған ғасырдың ең үлкен оқиғасы.
Dialogue: 0,0:21:01.71,0:21:03.92,Default,,0,0,0,,Құдай Блейдерс кубогы!
Dialogue: 0,0:21:04.26,0:21:09.39,Default,,0,0,0,,Финалдық турнирде қалған ең күшті төрт жүзушілермен таныстыру.
Dialogue: 0,0:21:09.47,0:21:11.89,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:11.97,0:21:16.60,Default,,0,0,0,,А тобынан: Қызыл көз және Балт Аои
Dialogue: 0,0:21:17.31,0:21:21.94,Default,,0,0,0,,В тобынан: Де Ла Хойя мен Ширасадиджо Луи тегін!
Dialogue: 0,0:21:23.03,0:21:26.99,Default,,0,0,0,,Қиян-кескі шайқаста бәріміз жеңдік! Біз ең жақсылардың қатарындамыз!
Dialogue: 0,0:21:27.07,0:21:30.12,Default,,0,0,0,,Кім чемпион болады?
Dialogue: 0,0:21:30.24,0:21:34.45,Default,,0,0,0,,Шешуші шайқас ертең басталады!
Dialogue: 0,0:21:44.46,0:21:46.93,Default,,0,0,0,,Жарайды, жанып жатыр.
Dialogue: 0,0:21:47.01,0:21:49.05,Default,,0,0,0,,Мен ешкімнен ұтыла алмаймын
Dialogue: 0,0:21:49.68,0:21:52.85,Default,,0,0,0,,Валькири Сөзсіз жеңейік!
Dialogue: 0,0:21:55.52,0:21:56.52,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.52,0:22:00.02,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.52,0:22:00.02,Default,,0,0,0,,Жарайсыңдар Ұлдар мен Қыздар Сіз бұлшық еттеріңізді шынықтырасыз ба?
Dialogue: 0,0:22:00.11,0:22:03.03,Default,,0,0,0,,Енді, күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:03.11,0:22:06.90,Default,,0,0,0,,Қозғалыс 1-нұсқаға қарағанда қарқындырақ. Алдымен алдыңғы эпизодты және көрсетілім уақытын қарастырайық.
Dialogue: 0,0:22:06.99,0:22:10.62,Default,,0,0,0,,GO Shoot GO Shoot Great Shoot!
Dialogue: 0,0:22:10.70,0:22:14.29,Default,,0,0,0,,GO Shoot GO Shoot Жылдамдығыңызды арттырыңыз!
Dialogue: 0,0:22:14.37,0:22:18.08,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:18.17,0:22:21.46,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:21.54,0:22:24.84,Default,,0,0,0,,Хахахаха Бұл жақсы емес пе? Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.92,0:22:28.84,Default,,0,0,0,,Бірақ бұл жерден күшейе түседі, мен қолдарымды және кернеуімді арттырамын.
Dialogue: 0,0:22:29.18,0:22:32.80,Default,,0,0,0,,GO Shoot GO Shoot Bay Muscle Train Моримори
Dialogue: 0,0:22:32.89,0:22:36.48,Default,,0,0,0,,АЛУ АТТЫ БАР АТТЫ Менің атыс – құдайдың атысы
Dialogue: 0,0:22:36.56,0:22:40.19,Default,,0,0,0,,Оңға ату Солға ату Оңға ату
Dialogue: 0,0:22:40.27,0:22:43.94,Default,,0,0,0,,Сол жақ ату Оң жақ ату Сол жақта ату
Dialogue: 0,0:22:44.02,0:22:47.57,Default,,0,0,0,,Өткен аптада Осы аптада GO түсірілімін жасап жатырмыз
Dialogue: 0,0:22:47.65,0:22:51.41,Default,,0,0,0,,Осы аптада келесі аптада GO түсіру, ол да жасайды
Dialogue: 0,0:22:51.49,0:22:55.08,Default,,0,0,0,,Күн сайын барлығы жасайтын GO ату жаттығуларын жасаңыз
Dialogue: 0,0:22:55.16,0:22:58.50,Default,,0,0,0,,GO түсіру жыл бойы, көктемде, жазда, күзде және қыста
Dialogue: 0,0:22:58.58,0:23:00.12,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:23:00.21,0:23:02.71,Default,,0,0,0,,Шығанақ бұлшықеттерін жаттықтыру үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.79,0:23:05.92,Default,,0,0,0,,Сол шиеленіспен біз шарықтау шегіне жетеміз!
Dialogue: 0,0:23:06.00,0:23:09.76,Default,,0,0,0,,Ичи Ни Сан Ши GO түсіріліміне кірісіңіз!
Dialogue: 0,0:23:09.84,0:23:13.22,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Let's Go!
Dialogue: 0,0:23:13.30,0:23:17.10,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Кеттік!
Dialogue: 0,0:23:17.18,0:23:19.98,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:19.98,0:23:21.98,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:19.98,0:23:21.98,Default,,0,0,0,,~♪
Dialogue: 0,0:23:21.98,0:23:22.06,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.06,0:23:24.90,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.06,0:23:24.90,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:24.90,0:23:25.48,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.73,0:23:32.53,Default,,0,0,0,,Бұл финалдық турнир. Мен, Фри, Луис және Шу.
Dialogue: 0,0:23:32.61,0:23:34.95,Default,,0,0,0,,Кім аман қалады!
Dialogue: 0,0:23:35.08,0:23:37.66,Default,,0,0,0,,Мен қатты толқып тұрмын.
Dialogue: 0,0:23:37.74,0:23:40.87,Default,,0,0,0,,Біздің қызу шайқасымызды бар күшіңізбен тамашалаңыз!
Dialogue: 0,0:23:41.71,0:23:43.63,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:44.21,0:23:46.67,Default,,0,0,0,,Жартылай финал! Тағдырлы шайқас!
Dialogue: 0,0:23:46.75,0:23:49.76,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.26,0:23:57.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory