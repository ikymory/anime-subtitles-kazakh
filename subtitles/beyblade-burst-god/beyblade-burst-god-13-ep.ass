Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.29,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.13,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.39,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:20.02,0:00:24.39,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.02,0:00:29.73,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:31.65,0:00:33.07,Default,,0,0,0,,Жаңа ғана не айттыңыз?
Dialogue: 0,0:00:33.15,0:00:34.82,Default,,0,0,0,,Сіз Куроками дедіңіз, солай ма?
Dialogue: 0,0:00:35.03,0:00:37.37,Default,,0,0,0,,Куроками Дина?
Dialogue: 0,0:00:37.66,0:00:40.37,Default,,0,0,0,,Асхана! Бұл Дина!
Dialogue: 0,0:00:40.54,0:00:42.50,Default,,0,0,0,,Мен қатты таң қалдым.
Dialogue: 0,0:00:42.58,0:00:44.83,Default,,0,0,0,,Париж жүздерінің капитаны Дина болды!
Dialogue: 0,0:00:45.33,0:00:48.04,Default,,0,0,0,,Marie Gorgeous Bay жаттықтырушы
Dialogue: 0,0:00:48.13,0:00:49.75,Default,,0,0,0,,Люк Мар!
Dialogue: 0,0:00:49.84,0:00:51.76,Default,,0,0,0,,Ален Рено
Dialogue: 0,0:00:52.13,0:00:54.34,Default,,0,0,0,,Құрметпен Сильвпре
Dialogue: 0,0:00:54.47,0:00:57.09,Default,,0,0,0,,Әлгі жігіт шынымен де мықты болып кетті.
Dialogue: 0,0:00:57.18,0:00:59.43,Default,,0,0,0,,Өлтіруші Өлім Сізердің қос соққысы
Dialogue: 0,0:00:59.51,0:01:00.60,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:01:01.26,0:01:03.68,Default,,0,0,0,,Сізге үлкен рахмет, Cisco.
Dialogue: 0,0:01:05.10,0:01:08.02,Default,,0,0,0,,Неге ол жігіт! Ол жеңіледі.
Dialogue: 0,0:01:08.10,0:01:09.65,Default,,0,0,0,,Мен жеңілсем де жарайды
Dialogue: 0,0:01:09.73,0:01:10.36,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:01:10.69,0:01:13.23,Default,,0,0,0,,Ол жақта Куроками Дина келе жатқан шығар.
Dialogue: 0,0:01:13.74,0:01:17.57,Default,,0,0,0,,Жеңіске жетпесең де, маған қалай күресетініңді көрсет.
Dialogue: 0,0:01:17.78,0:01:19.82,Default,,0,0,0,,Стэн, сен де солайсың.
Dialogue: 0,0:01:20.12,0:01:21.03,Default,,0,0,0,,Сатып алуға алданған адам – нағыз ақымақ
Dialogue: 0,0:01:21.12,0:01:22.54,Default,,0,0,0,,Жеңілсең де
Dialogue: 0,0:01:22.62,0:01:24.79,Default,,0,0,0,,Мен 3 ойында жеңсем, бұл жеңіс.
Dialogue: 0,0:01:24.87,0:01:26.12,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:01:26.25,0:01:29.42,Default,,0,0,0,,Дина, сенімен шайқаса алатыныма қуаныштымын.
Dialogue: 0,0:01:31.80,0:01:32.75,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:01:32.84,0:01:35.26,Default,,0,0,0,,Қасқырдың қорқынышын еске түсіруге рұқсат етіңіздер!
Dialogue: 0,0:01:35.34,0:01:36.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:39.43,0:01:42.14,Default,,0,0,0,,♪~
Dialogue: 0,0:01:42.22,0:01:44.68,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:44.77,0:01:47.19,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:47.27,0:01:49.69,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:49.77,0:01:52.19,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:52.27,0:01:53.86,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:53.94,0:01:58.11,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:59.07,0:02:03.79,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:03.91,0:02:08.41,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:08.92,0:02:13.67,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:13.75,0:02:18.72,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:18.80,0:02:23.60,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:23.72,0:02:28.69,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:28.77,0:02:32.06,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:32.15,0:02:33.73,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:33.82,0:02:36.32,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:36.40,0:02:38.65,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:38.74,0:02:40.66,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:40.74,0:02:42.03,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:42.12,0:02:43.78,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:43.87,0:02:46.29,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:46.37,0:02:52.46,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:52.54,0:02:56.88,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:56.96,0:02:59.76,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:59.84,0:03:02.22,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:02.30,0:03:04.64,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:04.72,0:03:08.35,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:04.72,0:03:08.35,Default,,0,0,0,,~♪
Dialogue: 0,0:03:08.35,0:03:08.93,Default,,0,0,0,,~♪
Dialogue: 0,0:03:10.14,0:03:12.81,Default,,0,0,0,,Егіз орақтар! Қос соққы!
Dialogue: 0,0:03:14.31,0:03:16.86,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:03:16.94,0:03:21.45,Default,,0,0,0,,BC Sol және Paris Blades арасындағы матч ақыры басталады!
Dialogue: 0,0:03:22.03,0:03:24.87,Default,,0,0,0,,Париж жүздері бұрын әлсіз болған, солай ма?
Dialogue: 0,0:03:25.03,0:03:27.08,Default,,0,0,0,,Бұл ерекшеленетін команда емес еді.
Dialogue: 0,0:03:27.20,0:03:29.54,Default,,0,0,0,,Капитан Куроками Дина болғаннан кейін
Dialogue: 0,0:03:29.62,0:03:31.71,Default,,0,0,0,,Жеңілмей келе жатырмын.
Dialogue: 0,0:03:32.46,0:03:34.58,Default,,0,0,0,,Дина қорқынышты сияқты.
Dialogue: 0,0:03:34.92,0:03:36.88,Default,,0,0,0,,Бұл күресетін рух
Dialogue: 0,0:03:37.50,0:03:40.13,Default,,0,0,0,,Жапонияда болғаннан да жақсырақ
Dialogue: 0,0:03:40.34,0:03:42.38,Default,,0,0,0,,Бірінші ойында не пайда болды...
Dialogue: 0,0:03:42.47,0:03:46.14,Default,,0,0,0,,Жапонияда бірге шайқасқан екі бұрынғы командалас
Dialogue: 0,0:03:46.22,0:03:49.89,Default,,0,0,0,,Бұрынғы достар енді жау ретінде қақтығысуда!
Dialogue: 0,0:03:50.14,0:03:54.10,Default,,0,0,0,,Балт, мен сенімен осылай күресетін күнді күттім.
Dialogue: 0,0:03:55.56,0:03:56.40,Default,,0,0,0,,О
Dialogue: 0,0:03:57.90,0:03:59.94,Default,,0,0,0,,Егер біз бұл матчтан жеңілсек
Dialogue: 0,0:04:00.03,0:04:03.45,Default,,0,0,0,,BC Соль Дүниежүзілік лигаға қатыса алмайды.
Dialogue: 0,0:04:04.36,0:04:06.45,Default,,0,0,0,,Айтпасаң да білесің
Dialogue: 0,0:04:07.99,0:04:10.87,Default,,0,0,0,,Психологиялық соғысқа маманданған Қара Құдай Дина.
Dialogue: 0,0:04:11.00,0:04:14.92,Default,,0,0,0,,Ха, сен әлдеқашан жеңіліп қалдың, Балтоның Яроуы.
Dialogue: 0,0:04:16.33,0:04:18.63,Default,,0,0,0,,Барто Аои жеңіліске ұшырады, солай ма?
Dialogue: 0,0:04:19.05,0:04:20.42,Default,,0,0,0,,Бұл оңай жеңіс, солай емес пе?
Dialogue: 0,0:04:20.51,0:04:23.93,Default,,0,0,0,,Бұл Дина қалаған Бладер. Біз сақтықты төмендете алмаймыз.
Dialogue: 0,0:04:24.01,0:04:26.14,Default,,0,0,0,,Сен неге ол жігітті ойлайсың?
Dialogue: 0,0:04:26.72,0:04:29.10,Default,,0,0,0,,Ол туралы бірдеңе бар
Dialogue: 0,0:04:33.89,0:04:35.35,Default,,0,0,0,,Мен жеңіле алмаймын
Dialogue: 0,0:04:35.44,0:04:38.19,Default,,0,0,0,,Бұл матчта жеңілуге жол жоқ!
Dialogue: 0,0:04:38.69,0:04:41.23,Default,,0,0,0,,Балт мен сені жеңемін!
Dialogue: 0,0:04:41.48,0:04:43.90,Default,,0,0,0,,Сондықтан мен мұнда келдім
Dialogue: 0,0:04:47.45,0:04:50.87,Default,,0,0,0,,Бауырым, Жапонияда бар күшіңді саламын дедің.
Dialogue: 0,0:04:50.95,0:04:53.12,Default,,0,0,0,,Бірақ неге шетелге бару керек?
Dialogue: 0,0:04:54.25,0:04:57.08,Default,,0,0,0,,Француз командасынан барлаушы келді.
Dialogue: 0,0:04:57.33,0:04:58.50,Default,,0,0,0,,Скаут?
Dialogue: 0,0:04:58.96,0:05:02.71,Default,,0,0,0,,Республикалық турнирде жақсы өнер көрсете алмадым.
Dialogue: 0,0:05:03.09,0:05:06.59,Default,,0,0,0,,Бірақ мені шақырған команда болды.
Dialogue: 0,0:05:08.01,0:05:11.93,Default,,0,0,0,,Дәл қазір маған керек команда бар.
Dialogue: 0,0:05:12.77,0:05:16.89,Default,,0,0,0,,Мен бұған жауап беріп, одан да күшті болғым келеді.
Dialogue: 0,0:05:17.52,0:05:19.90,Default,,0,0,0,,Тіпті менің үлкен ағам бар...
Dialogue: 0,0:05:26.36,0:05:27.41,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:05:28.41,0:05:30.20,Default,,0,0,0,,Жеңілмейтін сәуле!
Dialogue: 0,0:05:32.54,0:05:34.58,Default,,0,0,0,,Әлемнің ең жақсысы бол.
Dialogue: 0,0:05:34.95,0:05:36.29,Default,,0,0,0,,Сота…
Dialogue: 0,0:05:37.04,0:05:39.38,Default,,0,0,0,,А, мен мұны істеймін!
Dialogue: 0,0:05:39.71,0:05:41.42,Default,,0,0,0,,Бұл уәде!
Dialogue: 0,0:05:47.05,0:05:48.84,Default,,0,0,0,,Бір күні Барт болды
Dialogue: 0,0:05:48.93,0:05:52.76,Default,,0,0,0,,Кираде Скифтің аң аулау және қос соққысын көрсету
Dialogue: 0,0:06:01.02,0:06:02.82,Default,,0,0,0,,Менің екі техникам:
Dialogue: 0,0:06:02.90,0:06:05.74,Default,,0,0,0,,Сіз Балтоға әдемі сурет салған болуыңыз керек.
Dialogue: 0,0:06:07.28,0:06:09.41,Default,,0,0,0,,Дина бұрынғыдай болса керек.
Dialogue: 0,0:06:09.66,0:06:12.16,Default,,0,0,0,,Hunt Shot және Double Strike бар
Dialogue: 0,0:06:12.41,0:06:14.29,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:06:14.37,0:06:16.29,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:06:16.87,0:06:20.42,Default,,0,0,0,,Иә! Мен сенің жүрегіңді қолымда сеземін
Dialogue: 0,0:06:21.13,0:06:23.88,Default,,0,0,0,,Бірінші ойын Бірінші шайқас
Dialogue: 0,0:06:25.09,0:06:27.01,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:06:27.09,0:06:30.68,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:30.76,0:06:32.97,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:34.76,0:06:37.14,Default,,0,0,0,,Екеуі де керемет түсірді!
Dialogue: 0,0:06:37.23,0:06:41.52,Default,,0,0,0,,Валькириде асығыс, ал Deathsizer-де көлденең ату бар!
Dialogue: 0,0:06:41.60,0:06:43.77,Default,,0,0,0,,Ах! Аңшылық ату емес
Dialogue: 0,0:06:44.19,0:06:47.28,Default,,0,0,0,,Валькири оқ жаудыра ма?
Dialogue: 0,0:06:47.36,0:06:49.53,Default,,0,0,0,,Deathsizer енді жоқ!
Dialogue: 0,0:06:49.61,0:06:53.83,Default,,0,0,0,,Мамма Миа! Валькири, сен барған сайын шыдамдылықты пайдаланасың.
Dialogue: 0,0:06:53.91,0:06:55.28,Default,,0,0,0,,Ал, Валькири
Dialogue: 0,0:06:55.83,0:06:56.70,Default,,0,0,0,,Қазірдің өзінде кеш!
Dialogue: 0,0:06:56.79,0:07:00.96,Default,,0,0,0,,Кирисаке өлтірушінің өліміне қарсы қос соққы!
Dialogue: 0,0:07:07.00,0:07:08.67,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:07:09.47,0:07:12.09,Default,,0,0,0,,Өлтіруші Өлім Сізер Burst Finish
Dialogue: 0,0:07:12.43,0:07:15.18,Default,,0,0,0,,Бірінші ойында Париж Блэдерс жеңіске жетті
Dialogue: 0,0:07:15.60,0:07:17.52,Default,,0,0,0,,Ойын саны 1-0
Dialogue: 0,0:07:17.64,0:07:18.89,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:07:18.98,0:07:19.81,Default,,0,0,0,,Бұл әлсіз
Dialogue: 0,0:07:19.89,0:07:20.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:20.89,0:07:25.23,Default,,0,0,0,,Б.С.Сол Жапониядан осындай шұңқыр әкелу қиыншылыққа тап болды ма?
Dialogue: 0,0:07:26.65,0:07:27.73,Default,,0,0,0,,Дина…
Dialogue: 0,0:07:28.07,0:07:30.19,Default,,0,0,0,,Мен тағы бір соққыда жеңілдім.
Dialogue: 0,0:07:30.28,0:07:31.24,Default,,0,0,0,,Үлкен аға Геко!
Dialogue: 0,0:07:31.70,0:07:33.36,Default,,0,0,0,,Ол толығымен оқылды.
Dialogue: 0,0:07:34.20,0:07:35.99,Default,,0,0,0,,Өлім өлшемінің техникасы...
Dialogue: 0,0:07:37.37,0:07:39.50,Default,,0,0,0,,Қос соққы
Dialogue: 0,0:07:39.58,0:07:42.71,Default,,0,0,0,,Екі қабаты бар, қара және көк.
Dialogue: 0,0:07:42.79,0:07:45.50,Default,,0,0,0,,Қара пышақ қарсыласқа шабуыл жасағаннан кейін бірден
Dialogue: 0,0:07:45.59,0:07:50.55,Default,,0,0,0,,Көк жүз екінші соққы жасап, қарсыласқа зиян келтіреді.
Dialogue: 0,0:07:51.01,0:07:53.72,Default,,0,0,0,,Бір мезетте екі рет шабуыл жасау
Dialogue: 0,0:07:54.18,0:07:57.18,Default,,0,0,0,,Қасқырда екі орақ бар.
Dialogue: 0,0:07:57.43,0:08:01.77,Default,,0,0,0,,Крис Тағы екі ойында жеңілсек, біз Әлемдік лигада боламыз...
Dialogue: 0,0:08:01.85,0:08:06.06,Default,,0,0,0,,Мен білемін, ойын әлі аяқталған жоқ.
Dialogue: 0,0:08:06.52,0:08:07.40,Default,,0,0,0,,Жарайды, операцияны басынан бастауға тура келеді.
Dialogue: 0,0:08:08.02,0:08:09.53,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:08:09.61,0:08:13.03,Default,,0,0,0,,Ол жігіт Б.С.Солды одан сайын нашарлатып жатыр.
Dialogue: 0,0:08:16.82,0:08:20.08,Default,,0,0,0,,Құдай Валькирияның әлеуеті жоғары.
Dialogue: 0,0:08:22.12,0:08:25.58,Default,,0,0,0,,Бірақ Барто оны әлі меңгерген жоқ.
Dialogue: 0,0:08:29.21,0:08:32.92,Default,,0,0,0,,Парижге ауысатындықтан әдейі ұтылған жоқсың ба?
Dialogue: 0,0:08:33.01,0:08:34.43,Default,,0,0,0,,Олай етпе!
Dialogue: 0,0:08:34.63,0:08:36.72,Default,,0,0,0,,Жеңілудің қандай ақымақ жолы!
Dialogue: 0,0:08:36.93,0:08:38.14,Default,,0,0,0,,(сыбырлап) Мысалы, дәретке барғың келген десін! Дәретке, деймін! Дәретке!
Dialogue: 0,0:08:38.51,0:08:39.85,Default,,0,0,0,,Келесі барамын.
Dialogue: 0,0:08:40.01,0:08:41.31,Default,,0,0,0,,(Ұрыс тіркеу дыбысы)
Dialogue: 0,0:08:41.47,0:08:45.85,Default,,0,0,0,,Екінші ойын BC Sol – Стэн Гамбург
Dialogue: 0,0:08:46.19,0:08:49.23,Default,,0,0,0,,Париж Блэдерс - Ален Лено!
Dialogue: 0,0:08:49.82,0:08:52.07,Default,,0,0,0,,Күтілгендей жоғалту
Dialogue: 0,0:08:52.15,0:08:53.11,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:08:53.61,0:08:58.20,Default,,0,0,0,,Стэн екі ойында жеңіліп, жеңілсе де, мен қалған ойындардың барлығын аламын.
Dialogue: 0,0:08:58.28,0:08:59.49,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:08:59.70,0:09:00.74,Default,,0,0,0,,Тітіркендіргіш!
Dialogue: 0,0:09:01.37,0:09:04.58,Default,,0,0,0,,Стэн! Міндетті түрде жеңіңіз!
Dialogue: 0,0:09:04.66,0:09:06.96,Default,,0,0,0,,Айтпасаң да, мен жеңемін!
Dialogue: 0,0:09:07.38,0:09:09.13,Default,,0,0,0,,Ол қызық адам.
Dialogue: 0,0:09:11.25,0:09:14.84,Default,,0,0,0,,Ааааааа! Оны сындырыңыз!
Dialogue: 0,0:09:20.51,0:09:23.98,Default,,0,0,0,,Стэн Гамбургті аяқтаңыз
Dialogue: 0,0:09:24.06,0:09:27.85,Default,,0,0,0,,Сіз жеңіске қорғаныс түріне ұқсамайтын керемет шабуылмен жеттіңіз.
Dialogue: 0,0:09:27.94,0:09:29.65,Default,,0,0,0,,Ойын саны 1:1
Dialogue: 0,0:09:29.73,0:09:33.48,Default,,0,0,0,,BC Соль Париж жүздерін қуып жетті.
Dialogue: 0,0:09:34.40,0:09:36.57,Default,,0,0,0,,Эй, сен жеңдің бе?
Dialogue: 0,0:09:36.90,0:09:40.16,Default,,0,0,0,,Стэн! Ол жасады...
Dialogue: 0,0:09:40.24,0:09:41.45,Default,,0,0,0,,Не... не?
Dialogue: 0,0:09:41.53,0:09:43.95,Default,,0,0,0,,Менің күшімді көрдіңіз бе, Cisco?
Dialogue: 0,0:09:44.41,0:09:46.16,Default,,0,0,0,,Тым қобалжымаңыз
Dialogue: 0,0:09:46.50,0:09:49.00,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:52.42,0:09:57.30,Default,,0,0,0,,Блейдерлер керемет, бірақ командалық жұмыс ең нашар.
Dialogue: 0,0:09:58.43,0:10:01.26,Default,,0,0,0,,Маған бұл топты жоюға рұқсат етіңіз.
Dialogue: 0,0:10:02.05,0:10:04.81,Default,,0,0,0,,Келесіде - Cisco Carlyle.
Dialogue: 0,0:10:04.89,0:10:07.31,Default,,0,0,0,,Рюкзак Дайындықтарды аяқтадыңыз ба?
Dialogue: 0,0:10:07.60,0:10:09.35,Default,,0,0,0,,Иә, тамаша.
Dialogue: 0,0:10:09.81,0:10:13.65,Default,,0,0,0,,Бұл күлкілі. Оның мінезі өзіне сенімді және өзімшіл.
Dialogue: 0,0:10:14.23,0:10:17.40,Default,,0,0,0,,Бұл капитан болуға лайықты адам емес.
Dialogue: 0,0:10:17.49,0:10:20.99,Default,,0,0,0,,Бірақ сабырлы түрде қарсыластың жүзін мұқият қадағалаңыз.
Dialogue: 0,0:10:21.49,0:10:22.70,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:10:22.95,0:10:24.83,Default,,0,0,0,,Қорғаныс түрі Crys Satan -
Dialogue: 0,0:10:25.37,0:10:28.62,Default,,0,0,0,,Драйвер роликтерімен төзімділік жоғалуын азайтыңыз
Dialogue: 0,0:10:29.62,0:10:33.25,Default,,0,0,0,,Бетпе-бет соқтығыссаңыз да, нокаутқа түсу ықтималдығы жоғары.
Dialogue: 0,0:10:33.84,0:10:37.26,Default,,0,0,0,,Төменнен келетін шабуылдар тиімді
Dialogue: 0,0:10:38.13,0:10:39.05,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:39.34,0:10:41.97,Default,,0,0,0,,Үшінші ойынға қатысатын пышақшылар
Dialogue: 0,0:10:42.05,0:10:45.68,Default,,0,0,0,,Сиско Карлайл және Люк Маар.
Dialogue: 0,0:10:46.93,0:10:48.43,Default,,0,0,0,,Cisco Carlyle
Dialogue: 0,0:10:48.98,0:10:52.06,Default,,0,0,0,,Техникасы озық дарынды адам.
Dialogue: 0,0:10:52.15,0:10:55.78,Default,,0,0,0,,Мен көптеген үйірмелерге еріксіз барамын.
Dialogue: 0,0:10:56.36,0:10:57.94,Default,,0,0,0,,Жақсы зерттеу.
Dialogue: 0,0:10:58.15,0:10:59.36,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,0:10:59.45,0:11:02.53,Default,,0,0,0,,Біз жеңілген кезде, бұл көбінесе қарапайым қателіктерге байланысты.
Dialogue: 0,0:11:02.82,0:11:06.12,Default,,0,0,0,,Сіз өзіңізге тым сенімді және қулық жасайтын адамсыз.
Dialogue: 0,0:11:08.41,0:11:11.00,Default,,0,0,0,,Мен де олар туралы естідім.
Dialogue: 0,0:11:11.37,0:11:14.09,Default,,0,0,0,,Париж Блейдерлері басқа жерде жұмыстан шығарылды.
Dialogue: 0,0:11:14.17,0:11:17.63,Default,,0,0,0,,Пайдасы жоқ, оқуды тастап кеткендердің жинағы.
Dialogue: 0,0:11:17.84,0:11:20.47,Default,,0,0,0,,Не! Біз ондай емеспіз.
Dialogue: 0,0:11:21.05,0:11:23.68,Default,,0,0,0,,Мықты болғаннан пайда жоқ.
Dialogue: 0,0:11:23.76,0:11:24.97,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:25.22,0:11:26.97,Default,,0,0,0,,Cisco-ның арандатушылықтарына түсіп қалмаңыз
Dialogue: 0,0:11:27.06,0:11:28.85,Default,,0,0,0,,Рикку тынышталыңыз
Dialogue: 0,0:11:29.56,0:11:32.06,Default,,0,0,0,,Үшінші ойын Бірінші шайқас
Dialogue: 0,0:11:32.44,0:11:34.98,Default,,0,0,0,,Команданы мазақ еткеніңді мен кешірмеймін.
Dialogue: 0,0:11:35.31,0:11:36.36,Default,,0,0,0,,Әй
Dialogue: 0,0:11:36.65,0:11:38.36,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:11:38.44,0:11:41.99,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:42.07,0:11:44.45,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:47.74,0:11:48.79,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:49.45,0:11:50.20,Default,,0,0,0,,Әй
Dialogue: 0,0:11:50.58,0:11:54.33,Default,,0,0,0,,Ах! Люк Марр Бұл сәтсіз ату ма? ?
Dialogue: 0,0:11:56.75,0:11:58.25,Default,,0,0,0,,(роликтің жерге тиген дыбысы)
Dialogue: 0,0:12:00.21,0:12:02.17,Default,,0,0,0,,Циклондық цикл!
Dialogue: 0,0:12:04.26,0:12:06.18,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:12:08.97,0:12:13.19,Default,,0,0,0,,Циклондық цикл тамаша!
Dialogue: 0,0:12:13.48,0:12:15.94,Default,,0,0,0,,Crys Satan Burst Finish
Dialogue: 0,0:12:16.02,0:12:18.65,Default,,0,0,0,,BC Sol үшінші ойында жеңеді
Dialogue: 0,0:12:18.73,0:12:20.90,Default,,0,0,0,,Ойындар саны 2-ден 1-ге дейін
Dialogue: 0,0:12:20.99,0:12:25.41,Default,,0,0,0,,Сіз маған психологиялық соғыс жүргізбек болдыңыз, бірақ аңғал болдыңыз.
Dialogue: 0,0:12:25.49,0:12:26.95,Default,,0,0,0,,(Қорқытатын дыбыс)
Dialogue: 0,0:12:30.87,0:12:31.91,Default,,0,0,0,,Не?
Dialogue: 0,0:12:33.54,0:12:34.87,Default,,0,0,0,,Бұл тек менің қиялым ба?
Dialogue: 0,0:12:36.50,0:12:38.46,Default,,0,0,0,,Ойын саны 2:1
Dialogue: 0,0:12:38.54,0:12:40.80,Default,,0,0,0,,BC Sol One step ahead!
Dialogue: 0,0:12:41.09,0:12:44.05,Default,,0,0,0,,I'm sorry, I was completely destroyed.
Dialogue: 0,0:12:44.59,0:12:46.34,Default,,0,0,0,,Енді ештеңе қалмады
Dialogue: 0,0:12:46.64,0:12:48.64,Default,,0,0,0,,Екеуің де жоғары қараңдар.
Dialogue: 0,0:12:49.18,0:12:52.77,Default,,0,0,0,,Бастауымыз одан да нашар болды, солай емес пе?
Dialogue: 0,0:12:53.73,0:12:56.90,Default,,0,0,0,,Міне, біз қазір BC Sol-пен күресіп жатырмыз.
Dialogue: 0,0:12:56.98,0:12:58.65,Default,,0,0,0,,Біз әлеммен соғысып жатырмыз!
Dialogue: 0,0:12:58.73,0:12:59.40,Default,,0,0,0,,О
Dialogue: 0,0:12:59.48,0:13:00.65,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:13:00.98,0:13:04.24,Default,,0,0,0,,Өзіңізге және осы ұжымға сенімдірек болыңыз
Dialogue: 0,0:13:04.57,0:13:06.36,Default,,0,0,0,,Біз көп нәрсені істей аламыз
Dialogue: 0,0:13:08.03,0:13:10.45,Default,,0,0,0,,Nice to meet you, I'm Dyna Kurokami.
Dialogue: 0,0:13:11.95,0:13:14.87,Default,,0,0,0,,Бүгіннен бастап мен Париж Блейдерлеріне қосыламын...
Dialogue: 0,0:13:17.67,0:13:18.88,Default,,0,0,0,,What about the stadium?
Dialogue: 0,0:13:18.96,0:13:20.96,Default,,0,0,0,,It broke yesterday
Dialogue: 0,0:13:21.17,0:13:22.88,Default,,0,0,0,,I am sending it in for repair.
Dialogue: 0,0:13:23.46,0:13:25.97,Default,,0,0,0,,We don't have a spare stadium.
Dialogue: 0,0:13:26.05,0:13:27.30,Default,,0,0,0,,So what about practice?
Dialogue: 0,0:13:27.93,0:13:30.55,Default,,0,0,0,,Стадион қайтып келгенше күтуіміз керек.
Dialogue: 0,0:13:30.64,0:13:32.97,Default,,0,0,0,,I can't help it, huh?
Dialogue: 0,0:13:33.47,0:13:35.10,Default,,0,0,0,,Бұл қандай балалар?
Dialogue: 0,0:13:35.18,0:13:37.52,Default,,0,0,0,,Мен ешқандай жауынгерлік рухты сезінбеймін.
Dialogue: 0,0:13:45.82,0:13:48.11,Default,,0,0,0,,Мен неге мұндамын...
Dialogue: 0,0:13:49.16,0:13:50.99,Default,,0,0,0,,Let's start practicing right away.
Dialogue: 0,0:13:51.08,0:13:53.16,Default,,0,0,0,,А? Бірақ стадион...
Dialogue: 0,0:13:53.37,0:13:55.75,Default,,0,0,0,,Бұл жерде болмаса да, саябақта шығар.
Dialogue: 0,0:13:56.04,0:13:58.37,Default,,0,0,0,,Алдымен, сонда жүгірейік! Барайық!
Dialogue: 0,0:14:00.17,0:14:01.25,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:05.71,0:14:08.34,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:14:08.43,0:14:10.14,Default,,0,0,0,,Жақында сөйлесейік
Dialogue: 0,0:14:10.22,0:14:12.43,Default,,0,0,0,,Әлі жоқ, кеттік.
Dialogue: 0,0:14:12.72,0:14:14.47,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:14:14.56,0:14:18.10,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:18.19,0:14:20.27,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:24.28,0:14:26.07,Default,,0,0,0,,Ах, тағы да.
Dialogue: 0,0:14:26.82,0:14:28.49,Default,,0,0,0,,Тіпті бір рет жеңе алмайды
Dialogue: 0,0:14:28.86,0:14:30.61,Default,,0,0,0,,Мына жігіт мықты екен
Dialogue: 0,0:14:30.82,0:14:34.12,Default,,0,0,0,,Бұл командаға жетіспейтін нәрсе – жауынгерлік рух пен сенімділік.
Dialogue: 0,0:14:34.54,0:14:36.20,Default,,0,0,0,,Осы жерден бастайық.
Dialogue: 0,0:14:36.70,0:14:39.87,Default,,0,0,0,,Олар Бейді бәрінен де жақсы көреді.
Dialogue: 0,0:14:40.25,0:14:43.92,Default,,0,0,0,,Сондықтан мен міндетті түрде жеңіске жетуді қалаймын және аянбай еңбек етудемін.
Dialogue: 0,0:14:44.34,0:14:46.51,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:46.88,0:14:48.17,Default,,0,0,0,,Оны да жасайық
Dialogue: 0,0:14:48.26,0:14:49.05,Default,,0,0,0,,О
Dialogue: 0,0:14:51.89,0:14:54.35,Default,,0,0,0,,Дина, менімен жарыс.
Dialogue: 0,0:14:54.43,0:14:55.35,Default,,0,0,0,,Менімен бірге
Dialogue: 0,0:14:55.43,0:14:57.22,Default,,0,0,0,,О, әрине.
Dialogue: 0,0:15:10.91,0:15:13.07,Default,,0,0,0,,А... бұл не?
Dialogue: 0,0:15:13.32,0:15:16.54,Default,,0,0,0,,Мұнда соңғы 10 жылдағы сәйкестік деректері берілген.
Dialogue: 0,0:15:16.91,0:15:20.00,Default,,0,0,0,,Біз ойыншылардың сипаттамалары мен стратегияларын талдаймыз.
Dialogue: 0,0:15:20.08,0:15:21.12,Default,,0,0,0,,10 years?
Dialogue: 0,0:15:21.54,0:15:23.92,Default,,0,0,0,,Әрине, бір уақытта кисо жаттығуын жасаңыз.
Dialogue: 0,0:15:24.21,0:15:27.00,Default,,0,0,0,,Бір уақытта бас пен денені жаттықтыруға болады.
Dialogue: 0,0:15:27.34,0:15:28.38,Default,,0,0,0,,Иә
Dialogue: 0,0:15:29.17,0:15:30.51,Default,,0,0,0,,Қитәждің түкпір-түкпірінен әйелдер осы жаққа бет алып келеді.
Dialogue: 0,0:15:30.59,0:15:33.51,Default,,0,0,0,,Бізге қарамаған мықты команда
Dialogue: 0,0:15:33.59,0:15:35.60,Default,,0,0,0,,Олардың бізден жеңілгенін көр!
Dialogue: 0,0:15:36.76,0:15:38.52,Default,,0,0,0,,Мен мұны істеймін, мен істеймін, Дина.
Dialogue: 0,0:15:38.81,0:15:41.10,Default,,0,0,0,,Мен де күшті болғым келеді
Dialogue: 0,0:15:41.19,0:15:42.14,Default,,0,0,0,,Иә
Dialogue: 0,0:15:44.31,0:15:46.52,Default,,0,0,0,,Бұл жаттығуды есте сақтаңыз
Dialogue: 0,0:15:46.77,0:15:49.86,Default,,0,0,0,,Қолымыздан келгенін істеуіміз керек еді.
Dialogue: 0,0:15:49.94,0:15:50.78,Default,,0,0,0,,О
Dialogue: 0,0:15:51.07,0:15:53.20,Default,,0,0,0,,Кеттік, Пэрис Блэдерс!
Dialogue: 0,0:15:53.45,0:15:54.95,Default,,0,0,0,,Жүр!
Dialogue: 0,0:15:56.78,0:15:59.45,Default,,0,0,0,,Cisco, мені қайтадан шығарыңыз.
Dialogue: 0,0:15:59.54,0:16:01.46,Default,,0,0,0,,Жоқ, бұл жігіт тағы жеңіледі.
Dialogue: 0,0:16:02.00,0:16:03.83,Default,,0,0,0,,Жарайды, Балтоға барайық.
Dialogue: 0,0:16:03.92,0:16:04.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:05.04,0:16:06.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:06.25,0:16:08.75,Default,,0,0,0,,Куроками Динаның көбірек әдістерін көрсетіңіз.
Dialogue: 0,0:16:08.84,0:16:11.30,Default,,0,0,0,,Cisco Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:16:12.72,0:16:14.30,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:16:14.39,0:16:16.26,Default,,0,0,0,,Себебі сіз жеңдіңіз.
Dialogue: 0,0:16:16.47,0:16:17.89,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:16:19.26,0:16:22.73,Default,,0,0,0,,Менің ойымша, сен маған бірдеңе көрсетпексің, Аои Барто.
Dialogue: 0,0:16:23.52,0:16:25.98,Default,,0,0,0,,Енді төртінші ойынның уақыты келді.
Dialogue: 0,0:16:26.06,0:16:28.77,Default,,0,0,0,,Париж пышақтарынан ештеңе қалмады...
Dialogue: 0,0:16:28.86,0:16:32.32,Default,,0,0,0,,Қасқыр капитан Курогами Дина деп аталатын адам пайда болады
Dialogue: 0,0:16:32.40,0:16:34.61,Default,,0,0,0,,Ал уау!
Dialogue: 0,0:16:34.86,0:16:38.28,Default,,0,0,0,,BC Сольда тағы Барто Аои бар!
Dialogue: 0,0:16:38.37,0:16:41.20,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:41.54,0:16:42.62,Default,,0,0,0,,Аники
Dialogue: 0,0:16:42.87,0:16:44.04,Default,,0,0,0,,Бұл Cisco емес пе?
Dialogue: 0,0:16:44.12,0:16:46.88,Default,,0,0,0,,Әрине! Бұл Балто
Dialogue: 0,0:16:47.50,0:16:48.42,Default,,0,0,0,,Барт
Dialogue: 0,0:16:49.21,0:16:52.46,Default,,0,0,0,,Эй, мен бұл жолы жеңемін!
Dialogue: 0,0:16:52.55,0:16:56.97,Default,,0,0,0,,Өз шығанағын толық пайдалана алмаған адам менің қарсыласым емес.
Dialogue: 0,0:16:57.05,0:16:58.05,Default,,0,0,0,,Сатып алуға алданған адам – нағыз ақымақ
Dialogue: 0,0:16:58.43,0:17:01.27,Default,,0,0,0,,Сізде Валькири мүлде басқара алмайды.
Dialogue: 0,0:17:01.52,0:17:04.02,Default,,0,0,0,,Жоқ... бұл дұрыс емес!
Dialogue: 0,0:17:04.39,0:17:07.48,Default,,0,0,0,,Бұл саған, мен саған түсіндіремін.
Dialogue: 0,0:17:11.48,0:17:14.36,Default,,0,0,0,,Досым... Мен...
Dialogue: 0,0:17:15.45,0:17:16.74,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:17:17.53,0:17:18.28,Default,,0,0,0,,Жарайды
Dialogue: 0,0:17:19.58,0:17:21.74,Default,,0,0,0,,Валькири Қазір барайық.
Dialogue: 0,0:17:22.37,0:17:24.37,Default,,0,0,0,,Мен жақтауды алып тастадым.
Dialogue: 0,0:17:24.62,0:17:27.79,Default,,0,0,0,,Мен салмақты азайтып, жылдамдық үшін жарысуды жоспарлап отырмын.
Dialogue: 0,0:17:28.13,0:17:30.21,Default,,0,0,0,,Дегенмен, шабуыл күші төмендейді.
Dialogue: 0,0:17:30.29,0:17:33.13,Default,,0,0,0,,Дегенмен мен оны тездетуді жоспарлап отырмын.
Dialogue: 0,0:17:33.80,0:17:37.93,Default,,0,0,0,,Сіз осылайша қос соққыдан құтыла аласыз деп ойлайсыз ба?
Dialogue: 0,0:17:38.89,0:17:41.68,Default,,0,0,0,,Төртінші ойын Бірінші шайқас
Dialogue: 0,0:17:43.06,0:17:45.43,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:17:45.52,0:17:48.60,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:48.98,0:17:51.15,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:54.90,0:17:56.53,Default,,0,0,0,,Аң аулау!
Dialogue: 0,0:17:59.95,0:18:02.12,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:18:03.66,0:18:05.16,Default,,0,0,0,,(Үдемелі айналу дыбысы)
Dialogue: 0,0:18:08.46,0:18:10.13,Default,,0,0,0,,Жарайды, орындадық.
Dialogue: 0,0:18:10.38,0:18:14.25,Default,,0,0,0,,Бұл Rush Shoot және Hunt Shoot арасындағы кездесу!
Dialogue: 0,0:18:17.42,0:18:18.38,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:18:18.51,0:18:21.14,Default,,0,0,0,,Валькирия! соқтығысудың алдын алды
Dialogue: 0,0:18:21.22,0:18:22.85,Default,,0,0,0,,Бұл керемет жылдамдық!
Dialogue: 0,0:18:22.93,0:18:23.93,Default,,0,0,0,,Нигасан!
Dialogue: 0,0:18:25.31,0:18:27.23,Default,,0,0,0,,Жүгір, Валькири!
Dialogue: 0,0:18:29.19,0:18:30.48,Default,,0,0,0,,Неліктен жалтару керек?
Dialogue: 0,0:18:31.94,0:18:33.82,Default,,0,0,0,,Барттың мақсаты осы ма?
Dialogue: 0,0:18:33.90,0:18:35.94,Default,,0,0,0,,Бірақ мен одан аулақ жүрсем де...
Dialogue: 0,0:18:36.19,0:18:39.24,Default,,0,0,0,,Шайқас енді басталады, Валькири!
Dialogue: 0,0:18:39.40,0:18:43.58,Default,,0,0,0,,Валькири одан да жылдамдауда. Ол қашанға дейін жалтарады?
Dialogue: 0,0:18:43.66,0:18:47.08,Default,,0,0,0,,Ақырында Өлім Сизер мен Валькиридің кездесулері бір-біріне сәйкес келеді.
Dialogue: 0,0:18:47.33,0:18:49.37,Default,,0,0,0,,Қос соққы!
Dialogue: 0,0:18:49.46,0:18:51.58,Default,,0,0,0,,Қарсы шабуыл!
Dialogue: 0,0:18:56.55,0:18:57.67,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:18:57.97,0:18:59.76,Default,,0,0,0,,Мен екі еселенген ереуіл алсам да...
Dialogue: 0,0:18:59.84,0:19:01.76,Default,,0,0,0,,Жылдамдық одан да артты!
Dialogue: 0,0:19:02.05,0:19:03.39,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:19:03.47,0:19:05.22,Default,,0,0,0,,Өлім Сизердің шабуылы
Dialogue: 0,0:19:05.31,0:19:07.85,Default,,0,0,0,,Мен оны Валькиридің байланыстырылған қабатынан алдым.
Dialogue: 0,0:19:08.14,0:19:10.31,Default,,0,0,0,,Және жұтылған қуат
Dialogue: 0,0:19:10.60,0:19:12.10,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,0:19:19.07,0:19:21.41,Default,,0,0,0,,Көбірек, әрі қарай жүр!
Dialogue: 0,0:19:24.32,0:19:26.37,Default,,0,0,0,,Қайта серпілу, Өлім Сізер!
Dialogue: 0,0:19:27.70,0:19:30.46,Default,,0,0,0,,Бар, Валькири!
Dialogue: 0,0:19:30.54,0:19:32.21,Default,,0,0,0,,(көтерілген жалын дыбысы)
Dialogue: 0,0:19:34.54,0:19:36.38,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:19:36.67,0:19:38.26,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,0:20:04.74,0:20:05.87,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:20:07.66,0:20:10.20,Default,,0,0,0,,God Valkyrie Burst Finish
Dialogue: 0,0:20:10.29,0:20:13.00,Default,,0,0,0,,Аои Барто 2-0 ұпаймен жеңіске жетті.
Dialogue: 0,0:20:13.83,0:20:17.67,Default,,0,0,0,,Ойын саны 3-тен 1-ге дейін BC Sol жеңеді!
Dialogue: 0,0:20:17.75,0:20:20.05,Default,,0,0,0,,(жұдырықтың соғу дыбысы)
Dialogue: 0,0:20:20.13,0:20:22.09,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:20:22.63,0:20:24.72,Default,,0,0,0,,Бұл жігіт жеңді!
Dialogue: 0,0:20:24.80,0:20:26.64,Default,,0,0,0,,Эй, бұл маған ұнамайды.
Dialogue: 0,0:20:27.30,0:20:28.68,Default,,0,0,0,,(қуаныш дауысы)
Dialogue: 0,0:20:28.76,0:20:31.48,Default,,0,0,0,,Иә! Аники жеңді!
Dialogue: 0,0:20:31.56,0:20:33.44,Default,,0,0,0,,Өрт өрісінің ақымақ күші!
Dialogue: 0,0:20:33.85,0:20:35.48,Default,,0,0,0,,Сізге жақсы, әпке.
Dialogue: 0,0:20:35.56,0:20:37.36,Default,,0,0,0,,Мен жеңетініме сендім.
Dialogue: 0,0:20:37.65,0:20:40.57,Default,,0,0,0,,Жақсы, сіз жеңдіңіз.
Dialogue: 0,0:20:41.11,0:20:43.11,Default,,0,0,0,,б.з.д. Соль аман қалды
Dialogue: 0,0:20:43.82,0:20:46.16,Default,,0,0,0,,«осы жолы»
Dialogue: 0,0:20:47.12,0:20:48.74,Default,,0,0,0,,Дина жеңілді
Dialogue: 0,0:20:49.24,0:20:51.83,Default,,0,0,0,,Алан, қазір күйзеліске түсетін уақыт емес.
Dialogue: 0,0:20:53.21,0:20:54.92,Default,,0,0,0,,Бүгінгі ұрыс деректері
Dialogue: 0,0:20:55.46,0:20:57.25,Default,,0,0,0,,Талдауды қазір бастаңыз
Dialogue: 0,0:20:58.00,0:20:59.46,Default,,0,0,0,,Тез ауысайық
Dialogue: 0,0:20:59.80,0:21:01.30,Default,,0,0,0,,Рюкзак…
Dialogue: 0,0:21:02.42,0:21:05.76,Default,,0,0,0,,Дина күшейеді, біз де күшейеміз.
Dialogue: 0,0:21:06.64,0:21:07.43,Default,,0,0,0,,О
Dialogue: 0,0:21:08.22,0:21:09.26,Default,,0,0,0,,Джотаро, араласудың қажеті жоқ
Dialogue: 0,0:21:13.64,0:21:17.19,Default,,0,0,0,,Мен кадрды алып тастау мұндай әсерге ие болады деп ойламадым.
Dialogue: 0,0:21:17.52,0:21:18.48,Default,,0,0,0,,Немесе ол Колоссалдық Титан сияқты ма.
Dialogue: 0,0:21:19.65,0:21:21.40,Default,,0,0,0,,Мен күшейемін
Dialogue: 0,0:21:21.48,0:21:23.90,Default,,0,0,0,,Ендеше сен де күшейесің.
Dialogue: 0,0:21:23.99,0:21:25.49,Default,,0,0,0,,О, әрине.
Dialogue: 0,0:21:30.20,0:21:31.54,Default,,0,0,0,,(Қорқытатын дыбыс)
Dialogue: 0,0:21:32.83,0:21:33.75,Default,,0,0,0,,Дегенмен, Шусамару…
Dialogue: 0,0:21:35.21,0:21:37.83,Default,,0,0,0,,Мені біреу бақылап тұр ма?
Dialogue: 0,0:21:39.96,0:21:41.09,Default,,0,0,0,,Бұл көздер.
Dialogue: 0,0:21:47.72,0:21:50.18,Default,,0,0,0,,Cisco Carlyle
Dialogue: 0,0:21:50.26,0:21:52.51,Default,,0,0,0,,Сіз мені ешқашан кешірмейсіз
Dialogue: 0,0:21:55.93,0:21:58.40,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.48,0:22:01.86,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:01.94,0:22:04.78,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.86,0:22:06.95,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.03,0:22:10.57,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.66,0:22:14.24,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.33,0:22:16.12,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.20,0:22:17.96,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.04,0:22:19.79,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.88,0:22:21.46,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.54,0:22:23.55,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.63,0:22:26.01,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.09,0:22:29.01,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.09,0:22:32.72,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.80,0:22:36.48,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.56,0:22:38.23,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.31,0:22:41.52,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.61,0:22:43.90,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:43.98,0:22:47.57,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.65,0:22:50.95,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.03,0:22:53.16,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.24,0:22:54.91,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:54.99,0:22:58.41,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.50,0:23:00.37,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.46,0:23:03.50,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.59,0:23:05.80,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:05.88,0:23:09.80,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.88,0:23:13.47,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.55,0:23:17.06,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.14,0:23:20.35,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.44,0:23:22.15,Default,,0,0,0,,~♪
Dialogue: 0,0:23:20.44,0:23:22.15,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.15,0:23:22.23,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.23,0:23:24.98,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.23,0:23:24.98,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:24.98,0:23:25.48,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.48,0:23:29.24,Default,,0,0,0,,Келесі қарсылас: Британдық Корольдік клуб
Dialogue: 0,0:23:29.32,0:23:31.15,Default,,0,0,0,,Ғажайып құпия қару болды.
Dialogue: 0,0:23:31.66,0:23:34.16,Default,,0,0,0,,Оны джунглидегі аңдар өсірді.
Dialogue: 0,0:23:34.37,0:23:36.54,Default,,0,0,0,,Шынайы ма? Бұл тым қорқынышты.
Dialogue: 0,0:23:36.62,0:23:39.62,Default,,0,0,0,,Не, бұл өтірік пе? шығанақ шыбындары?
Dialogue: 0,0:23:40.12,0:23:42.50,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:42.58,0:23:45.00,Default,,0,0,0,,Соқ! Максимум Гаруда!
