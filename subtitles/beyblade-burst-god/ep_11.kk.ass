Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.21,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.13,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.93,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:16.01,0:00:19.43,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:19.97,0:00:24.52,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.10,0:00:29.65,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:31.28,0:00:33.82,Default,,0,0,0,,Бұл оқиға рас па?
Dialogue: 0,0:00:33.90,0:00:35.99,Default,,0,0,0,,Иван Сіз нені айтып тұрсыз?
Dialogue: 0,0:00:36.32,0:00:38.91,Default,,0,0,0,,Free Америкаға көшіп барады.
Dialogue: 0,0:00:38.99,0:00:39.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:40.74,0:00:42.91,Default,,0,0,0,,Б.з.б. Сольдегі үлкен оқиға.
Dialogue: 0,0:00:43.54,0:00:46.67,Default,,0,0,0,,Еркін конькимен жүгіруші американдық командаға барады деп ешқашан ойламадым.
Dialogue: 0,0:00:47.38,0:00:50.21,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:50.59,0:00:52.67,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:54.17,0:00:56.80,Default,,0,0,0,,Мен Еркіннің жоғалғанын қаламаймын.
Dialogue: 0,0:00:57.14,0:01:00.10,Default,,0,0,0,,Мен Фримен соғыстым, бірақ...
Dialogue: 0,0:01:05.64,0:01:07.40,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:17.36,0:01:20.20,Default,,0,0,0,,Сіз оны осында пайдалана аласыз.
Dialogue: 0,0:01:31.34,0:01:34.13,Default,,0,0,0,,♪~
Dialogue: 0,0:01:34.21,0:01:36.80,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:36.88,0:01:39.22,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:39.30,0:01:41.76,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:41.85,0:01:44.10,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:44.18,0:01:45.81,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:45.89,0:01:50.11,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:51.06,0:01:55.82,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:55.90,0:02:00.41,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:00.91,0:02:05.66,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:05.75,0:02:10.67,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:10.75,0:02:15.59,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:15.71,0:02:20.68,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:20.76,0:02:24.14,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:24.22,0:02:25.60,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:25.68,0:02:28.31,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:28.39,0:02:30.56,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:30.65,0:02:32.65,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:32.73,0:02:34.02,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:34.11,0:02:35.73,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:35.82,0:02:38.28,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:38.36,0:02:44.41,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:44.49,0:02:48.79,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:48.87,0:02:51.54,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:51.62,0:02:54.04,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:54.13,0:02:56.67,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:56.75,0:03:00.55,Default,,0,0,0,,~♪
Dialogue: 0,0:02:56.75,0:03:00.55,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:00.55,0:03:01.01,Default,,0,0,0,,~♪
Dialogue: 0,0:03:02.30,0:03:04.60,Default,,0,0,0,,Жығылу! BC Sol!
Dialogue: 0,0:03:08.39,0:03:12.35,Default,,0,0,0,,Швецияға қарсы Еуропа лигасының келесі матчына қатысатын ойыншыларды жариялау
Dialogue: 0,0:03:12.98,0:03:15.73,Default,,0,0,0,,Бірінші топтан: Стэн Гамбург
Dialogue: 0,0:03:15.82,0:03:16.73,Default,,0,0,0,,Иә
Dialogue: 0,0:03:17.15,0:03:19.53,Default,,0,0,0,,Екінші командадан Барто Аои
Dialogue: 0,0:03:19.61,0:03:21.24,Default,,0,0,0,,О, мен жасадым!
Dialogue: 0,0:03:21.32,0:03:22.36,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:03:22.82,0:03:24.62,Default,,0,0,0,,Сондай-ақ Рантаро Кияма
Dialogue: 0,0:03:24.70,0:03:26.99,Default,,0,0,0,,Жарайсыңдар! тозақ!
Dialogue: 0,0:03:27.41,0:03:30.62,Default,,0,0,0,,Сондай-ақ қосалқы мүше ретінде: Cisco Carlyle
Dialogue: 0,0:03:30.71,0:03:33.12,Default,,0,0,0,,Тағы да Tsk?
Dialogue: 0,0:03:33.21,0:03:35.21,Default,,0,0,0,,Стэн Қолдан келгеннің бәрін жасайық!
Dialogue: 0,0:03:35.29,0:03:36.63,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:03:40.22,0:03:43.59,Default,,0,0,0,,Жоғарыдағы төрт адам матчқа қызу жаттығуда.
Dialogue: 0,0:03:43.68,0:03:44.80,Default,,0,0,0,,Мәзір үшін осы жерді басыңыз...
Dialogue: 0,0:03:44.89,0:03:46.80,Default,,0,0,0,,Trad Wait
Dialogue: 0,0:03:48.10,0:03:49.85,Default,,0,0,0,,Енді бұл тегін аударылды
Dialogue: 0,0:03:49.93,0:03:54.02,Default,,0,0,0,,Біз одан әрі нығайып, алға секіруіміз керек деп есептеймін.
Dialogue: 0,0:03:54.31,0:03:58.78,Default,,0,0,0,,Сонымен, біз екінші командадан бірнеше адамды жоғары командаға көтереміз.
Dialogue: 0,0:03:58.86,0:03:59.78,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:00.32,0:04:02.20,Default,,0,0,0,,Мен бұл туралы көптен бері ойлап жүрдім.
Dialogue: 0,0:04:02.61,0:04:04.57,Default,,0,0,0,,Кім жоғарылайды?
Dialogue: 0,0:04:04.86,0:04:07.70,Default,,0,0,0,,Барто Аои Рантаро Кияма
Dialogue: 0,0:04:07.78,0:04:11.29,Default,,0,0,0,,Жоғарыдағы екі адам бүгіннен бастап топ құрамаға айналады.
Dialogue: 0,0:04:11.58,0:04:13.83,Default,,0,0,0,,Ех! Шынайы! ?
Dialogue: 0,0:04:13.96,0:04:16.04,Default,,0,0,0,,Жарайсың Балто, біз біріншіміз!
Dialogue: 0,0:04:16.13,0:04:17.09,Default,,0,0,0,,Ушаа
Dialogue: 0,0:04:17.42,0:04:18.84,Default,,0,0,0,,Жасайық, Аники
Dialogue: 0,0:04:18.92,0:04:21.05,Default,,0,0,0,,Рейтингке ие болғаныңыз үшін сізге рахмет.
Dialogue: 0,0:04:21.13,0:04:22.80,Default,,0,0,0,,Нгуу~
Dialogue: 0,0:04:22.88,0:04:24.09,Default,,0,0,0,,Ha
Dialogue: 0,0:04:24.38,0:04:27.64,Default,,0,0,0,,Рахмет Крис. Біз қолдан келгеннің бәрін жасаймыз!
Dialogue: 0,0:04:27.72,0:04:31.93,Default,,0,0,0,,О! Тегін конькиді өткізіп алсаңыз да, біз сіздің көңіл-күйіңізді көтереміз, BC Sol.
Dialogue: 0,0:04:32.31,0:04:35.60,Default,,0,0,0,,Көңіліңді көтермеңдер, балалар...
Dialogue: 0,0:04:37.36,0:04:39.86,Default,,0,0,0,,New York Bulls ойынына қош келдіңіз
Dialogue: 0,0:04:40.36,0:04:41.78,Default,,0,0,0,,Хаа, міне
Dialogue: 0,0:04:41.86,0:04:46.20,Default,,0,0,0,,Тағы да бұл Нью-Йорк Буллз клубының иесі Александр Гилтен.
Dialogue: 0,0:04:46.41,0:04:48.41,Default,,0,0,0,,Мен сізге үлкен үміт артамын.
Dialogue: 0,0:04:50.99,0:04:51.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:52.58,0:04:54.87,Default,,0,0,0,,Ал, шығанақтың қай жерінен соғу керектігін көрсетіңізші.
Dialogue: 0,0:04:57.21,0:05:00.30,Default,,0,0,0,,Мұнда бізде ең жақсы мүмкіндіктер бар.
Dialogue: 0,0:05:00.38,0:05:01.63,Default,,0,0,0,,Жаттықтырушы дәрігер
Dialogue: 0,0:05:01.71,0:05:03.97,Default,,0,0,0,,Дене және психикалық саулықта болу.
Dialogue: 0,0:05:04.05,0:05:07.51,Default,,0,0,0,,Оны ең жақсы жағдайда ұстауға тырысыңыз...
Dialogue: 0,0:05:07.59,0:05:08.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:20.32,0:05:23.57,Default,,0,0,0,,Бос Де Ла Хойя Неліктен командадан кеттіңіз?
Dialogue: 0,0:05:25.86,0:05:27.78,Default,,0,0,0,,Балт Аоиды қосу керек еді.
Dialogue: 0,0:05:27.86,0:05:29.37,Default,,0,0,0,,Иә, бар.
Dialogue: 0,0:05:29.91,0:05:31.70,Default,,0,0,0,,Сіз өз командаңызды тастадыңыз ба?
Dialogue: 0,0:05:33.08,0:05:35.16,Default,,0,0,0,,Саған солай көрінеді
Dialogue: 0,0:05:36.83,0:05:39.83,Default,,0,0,0,,Барстоу! Бұл тамаша болды!
Dialogue: 0,0:05:39.92,0:05:44.59,Default,,0,0,0,,Швецияның «Викингс» командасы үшінші ойында жеңіске жетті!
Dialogue: 0,0:05:44.67,0:05:49.89,Default,,0,0,0,,Битингтер беделді BC Sol-қа қарсы барлық ойындарда басым болды!
Dialogue: 0,0:05:49.97,0:05:53.43,Default,,0,0,0,,Ақыр соңында, біз Эйсті жоғалттық, Free De La Hoya.
Dialogue: 0,0:05:53.51,0:05:55.77,Default,,0,0,0,,Бұл үлкен әсер етті ме? BC Sol!
Dialogue: 0,0:05:55.85,0:06:00.02,Default,,0,0,0,,Екінші жағынан, викингтер қылшықтар арасында тамаша ынтымақтастыққа ие!
Dialogue: 0,0:06:00.10,0:06:03.07,Default,,0,0,0,,Келесі ойынды асыға күтеміз!
Dialogue: 0,0:06:03.52,0:06:05.07,Default,,0,0,0,,Әзірге...
Dialogue: 0,0:06:05.69,0:06:09.82,Default,,0,0,0,,Неге менімен ақылдаспай әлгі екеуін жоғарылаттың!
Dialogue: 0,0:06:17.96,0:06:20.88,Default,,0,0,0,,Балалар, сендер не туралысыңдар?
Dialogue: 0,0:06:21.42,0:06:23.67,Default,,0,0,0,,Мәселе осы екеуі емес пе?
Dialogue: 0,0:06:23.96,0:06:25.96,Default,,0,0,0,,Жақсы орын болмады.
Dialogue: 0,0:06:26.26,0:06:28.97,Default,,0,0,0,,Менің осы уақытқа дейінгі барлық жеңістерім еркіндіктің арқасында болды.
Dialogue: 0,0:06:29.18,0:06:30.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:30.26,0:06:31.22,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:31.30,0:06:34.31,Default,,0,0,0,,Еркінсіз біз ештеңе істей алмаймыз ба?
Dialogue: 0,0:06:34.60,0:06:37.68,Default,,0,0,0,,Дұрыс, тіпті мен Real Sambat-пен жұмыс істеген кезде де...
Dialogue: 0,0:06:37.81,0:06:40.69,Default,,0,0,0,,Тегін кеңес болмағанда не болар еді?
Dialogue: 0,0:06:40.77,0:06:42.77,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:06:42.86,0:06:43.94,Default,,0,0,0,,«Бірақ»
Dialogue: 0,0:06:44.02,0:06:47.90,Default,,0,0,0,,Шырылдап жатыр деймін, бірақ сен де ұтыласың, солай емес пе?
Dialogue: 0,0:06:48.19,0:06:51.57,Default,,0,0,0,,Бұл екеуін жоғары командаға көтеру қате болды.
Dialogue: 0,0:06:51.95,0:06:55.08,Default,,0,0,0,,Мен бұл жігіттерден Иван мен Риксонды жақсы көремін.
Dialogue: 0,0:06:55.16,0:06:57.37,Default,,0,0,0,,Жарайды, Стэн, иесі -
Dialogue: 0,0:06:57.45,0:07:00.58,Default,,0,0,0,,Балто мен оның достары қабілетіне қарай бағаланды.
Dialogue: 0,0:07:00.67,0:07:03.67,Default,,0,0,0,,Бұл рейтингті бастау біртүрлі!
Dialogue: 0,0:07:03.92,0:07:05.88,Default,,0,0,0,,Бүгінгі ойынды барлығы тамашалады, солай ма?
Dialogue: 0,0:07:06.13,0:07:07.71,Default,,0,0,0,,Сіз тым көп айтасыз, Стэн.
Dialogue: 0,0:07:07.96,0:07:09.51,Default,,0,0,0,,Екіншісін ұстап тұрыңыз.
Dialogue: 0,0:07:09.84,0:07:10.84,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:10.93,0:07:14.35,Default,,0,0,0,,Үздік командалар осындай болса, олар Еуропа лигасына қатыса алмайды.
Dialogue: 0,0:07:14.85,0:07:19.73,Default,,0,0,0,,Қалай болғанда да, бүгінгі алған білімдерімнің негізінде келесі матчта бар күшімді салудан басқа амалым жоқ.
Dialogue: 0,0:07:19.81,0:07:23.10,Default,,0,0,0,,Келесі қарсылас – Португалия құрамасы Галлеон.
Dialogue: 0,0:07:23.69,0:07:25.40,Default,,0,0,0,,Галлеон б.з.б.
Dialogue: 0,0:07:25.73,0:07:27.65,Default,,0,0,0,,Бұл күшті әдеттер бар команда.
Dialogue: 0,0:07:27.98,0:07:30.99,Default,,0,0,0,,«Мың мильдік жол бір қадамнан басталады»…
Dialogue: 0,0:07:31.40,0:07:32.20,Default,,0,0,0,,Иә
Dialogue: 0,0:07:32.61,0:07:35.45,Default,,0,0,0,,Жарайды, Кумичо, келесі кездескенше!
Dialogue: 0,0:07:35.53,0:07:36.28,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:36.53,0:07:38.20,Default,,0,0,0,,Келесі жолы келуді жоспарлап отырсыз ба?
Dialogue: 0,0:07:38.29,0:07:40.91,Default,,0,0,0,,Біз жеңілуді жалғастыра аламыз ба?
Dialogue: 0,0:07:41.25,0:07:44.83,Default,,0,0,0,,Trad Сіз бұл жігіттерді келесі негізгі құрамға қарайсыз ба?
Dialogue: 0,0:07:45.29,0:07:46.96,Default,,0,0,0,,Жоқ, таңдау қазір басталады.
Dialogue: 0,0:07:47.04,0:07:48.50,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:48.59,0:07:50.17,Default,,0,0,0,,Cisco не болды?
Dialogue: 0,0:07:50.26,0:07:51.80,Default,,0,0,0,,Біз жиналыстамыз.
Dialogue: 0,0:07:52.09,0:07:54.43,Default,,0,0,0,,Хмф, өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:07:55.89,0:07:56.97,Default,,0,0,0,,Cisco…
Dialogue: 0,0:08:01.10,0:08:04.02,Default,,0,0,0,,Мен бұл барлығына шабыт болады деп үміттендім.
Dialogue: 0,0:08:04.73,0:08:06.94,Default,,0,0,0,,Бұл көтерілу күтпеген жағдай болды...
Dialogue: 0,0:08:07.57,0:08:09.11,Default,,0,0,0,,Бұл керісінше әсер етті.
Dialogue: 0,0:08:09.57,0:08:13.57,Default,,0,0,0,,Еркіннің жоқтығы бәріне соншалықты әсер еткеніне сене алар емеспін.
Dialogue: 0,0:08:14.16,0:08:17.49,Default,,0,0,0,,Ең күшті жоғалту сезімін Крис сезінеді ме?
Dialogue: 0,0:08:17.66,0:08:18.91,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:08:20.95,0:08:22.75,Default,,0,0,0,,Такустандағы мыңжапырақ
Dialogue: 0,0:08:23.08,0:08:25.33,Default,,0,0,0,,Бізде де солай.
Dialogue: 0,0:08:25.42,0:08:28.71,Default,,0,0,0,,Дұрыс, мен Аники мен Кумичоның жанкүйерімін.
Dialogue: 0,0:08:28.79,0:08:31.26,Default,,0,0,0,,Желдеткіш? О, сен жанкүйерсің!
Dialogue: 0,0:08:31.34,0:08:34.09,Default,,0,0,0,,Мен шыдай алмаймын! Мен жанкүйермін, Балто.
Dialogue: 0,0:08:34.18,0:08:35.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:35.34,0:08:36.43,Default,,0,0,0,,Аники?
Dialogue: 0,0:08:41.68,0:08:45.39,Default,,0,0,0,,Келесі жолы мен жеңемін. Адамдар маған осылай күлетін болады.
Dialogue: 0,0:08:52.57,0:08:53.61,Default,,0,0,0,,Тегін?
Dialogue: 0,0:08:57.95,0:08:59.08,Default,,0,0,0,,Шығатын жол жоқ сияқты
Dialogue: 0,0:08:59.53,0:09:00.58,Default,,0,0,0,,Cisco
Dialogue: 0,0:09:01.29,0:09:03.41,Default,,0,0,0,,Біз қызықсыз командаға айналдық.
Dialogue: 0,0:09:04.04,0:09:05.83,Default,,0,0,0,,Неге олай дейсің?
Dialogue: 0,0:09:06.12,0:09:08.50,Default,,0,0,0,,Тегін жоғалғандықтан, бұл бейберекетсіздік.
Dialogue: 0,0:09:09.00,0:09:11.75,Default,,0,0,0,,Не керек, біреулер де араластырып жатыр.
Dialogue: 0,0:09:11.84,0:09:13.17,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:09:13.51,0:09:14.55,Default,,0,0,0,,Бұл сенсің!
Dialogue: 0,0:09:14.80,0:09:16.47,Default,,0,0,0,,Сіз бұл менің кінәм деп айтасыз ба?
Dialogue: 0,0:09:17.47,0:09:19.64,Default,,0,0,0,,Мен БК Солдан қашып кете аламын.
Dialogue: 0,0:09:19.72,0:09:20.93,Default,,0,0,0,,Онда менде тамаша идея бар.
Dialogue: 0,0:09:21.60,0:09:24.10,Default,,0,0,0,,Саған қарап ренжіп барамын.
Dialogue: 0,0:09:24.43,0:09:25.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:26.06,0:09:29.77,Default,,0,0,0,,Біз осындай командамен күресе аламыз ба? Келесі кездескенде жау боламыз!
Dialogue: 0,0:09:32.11,0:09:34.99,Default,,0,0,0,,Жоқ, Cisco, бірге қолдан келгеннің бәрін жасайық.
Dialogue: 0,0:09:35.40,0:09:36.70,Default,,0,0,0,,Cisco!
Dialogue: 0,0:09:38.61,0:09:40.62,Default,,0,0,0,,«Бірге» ақымақ па?
Dialogue: 0,0:09:43.12,0:09:45.29,Default,,0,0,0,,Cisco сонда болды ма?
Dialogue: 0,0:09:45.91,0:09:48.50,Default,,0,0,0,,Ол шынымен кетіп қалды ма?
Dialogue: 0,0:09:48.58,0:09:49.50,Default,,0,0,0,,Иә
Dialogue: 0,0:09:49.58,0:09:52.38,Default,,0,0,0,,Бұл жігіт тым өзімшіл!
Dialogue: 0,0:09:54.80,0:09:56.76,Default,,0,0,0,,Барлығы, бұл қандай бет?
Dialogue: 0,0:09:57.01,0:09:59.89,Default,,0,0,0,,Бір адам жоқ болса, келесі пайда болу мүмкіндігі артады.
Dialogue: 0,0:10:00.39,0:10:02.10,Default,,0,0,0,,Осыны айтқан соң...
Dialogue: 0,0:10:02.47,0:10:04.81,Default,,0,0,0,,Иван, сенің де мүмкіндігің бар.
Dialogue: 0,0:10:05.10,0:10:07.14,Default,,0,0,0,,Жоқ... Мен...
Dialogue: 0,0:10:07.48,0:10:10.69,Default,,0,0,0,,Балто: Егер бұл орын алса, Cisco бөлігі жабайы болады!
Dialogue: 0,0:10:10.77,0:10:11.56,Default,,0,0,0,,О
Dialogue: 0,0:10:11.90,0:10:14.78,Default,,0,0,0,,Аники, тамақ ішіп, жаттығуға барайық!
Dialogue: 0,0:10:14.86,0:10:18.57,Default,,0,0,0,,Күте тұрыңыз! Мен сені тез жегеніңді кешірмеймін.
Dialogue: 0,0:10:19.07,0:10:22.95,Default,,0,0,0,,Оны абайлап шайнап, ләззат алмасаң, жеңуге күшің жетпейді.
Dialogue: 0,0:10:23.03,0:10:25.08,Default,,0,0,0,,Түсіндім! Жақсылап шайнаңыз!
Dialogue: 0,0:10:26.45,0:10:28.04,Default,,0,0,0,,Сіз оны шайнап жатырсыз ба?
Dialogue: 0,0:10:28.29,0:10:29.79,Default,,0,0,0,,Оны да жасайық!
Dialogue: 0,0:10:31.17,0:10:32.04,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,0:10:32.46,0:10:35.50,Default,,0,0,0,,Мен сендерге айттым ғой, балалар, өздеріңе қамқор болыңдар!
Dialogue: 0,0:10:37.80,0:10:38.59,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:10:39.55,0:10:43.43,Default,,0,0,0,,Мені бақытты ететін команда осы ма?
Dialogue: 0,0:10:43.68,0:10:44.93,Default,,0,0,0,,Мен сізге телефон соққаннан бері...
Dialogue: 0,0:10:45.01,0:10:48.52,Default,,0,0,0,,Маған белгілі бір дәрежеде ләззат алатынымды көрейін.
Dialogue: 0,0:10:48.60,0:10:49.85,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:10:57.40,0:11:00.11,Default,,0,0,0,,Эй... Менің бірдеңе айтатыным бар.
Dialogue: 0,0:11:00.78,0:11:01.70,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:01.78,0:11:02.82,Default,,0,0,0,,Оңтүстік аймақтардың бас қолбасшысы Доти Пиксис
Dialogue: 0,0:11:03.37,0:11:04.49,Default,,0,0,0,,Мен де...
Dialogue: 0,0:11:05.24,0:11:06.66,Default,,0,0,0,,«Мен де»
Dialogue: 0,0:11:07.04,0:11:09.46,Default,,0,0,0,,Тоқтау керек пе деп ойлаймын...
Dialogue: 0,0:11:09.58,0:11:11.58,Default,,0,0,0,,Не айтып тұрсың, Иван?
Dialogue: 0,0:11:11.67,0:11:13.29,Default,,0,0,0,,Бұл жұмыс, солай ма?
Dialogue: 0,0:11:15.92,0:11:18.13,Default,,0,0,0,,Иван, кенеттен не болды?
Dialogue: 0,0:11:18.21,0:11:20.09,Default,,0,0,0,,Бұл өтірік емес пе? Оны жасама.
Dialogue: 0,0:11:20.47,0:11:24.05,Default,,0,0,0,,Кешіріңіз, мен бұрын солай ойладым.
Dialogue: 0,0:11:24.76,0:11:26.85,Default,,0,0,0,,Иван, мүмкін сен...
Dialogue: 0,0:11:27.14,0:11:30.18,Default,,0,0,0,,Иә, мен Хиксонға бұрын айттым.
Dialogue: 0,0:11:30.52,0:11:32.40,Default,,0,0,0,,Менің арманымның оқиғасы
Dialogue: 0,0:11:32.94,0:11:34.98,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:35.65,0:11:37.94,Default,,0,0,0,,Аники Кумичо
Dialogue: 0,0:11:48.62,0:11:51.71,Default,,0,0,0,,Бұл тегін сыйлық сияқты емес.
Dialogue: 0,0:11:51.96,0:11:54.88,Default,,0,0,0,,Мен өз еркіммен жұмыстан кетуді шештім.
Dialogue: 0,0:11:55.17,0:11:56.54,Default,,0,0,0,,Тоқтасам не істеуім керек?
Dialogue: 0,0:11:57.04,0:11:58.75,Default,,0,0,0,,Мен жаттықтырушы болғым келеді
Dialogue: 0,0:12:00.21,0:12:01.34,Default,,0,0,0,,Жаттықтырушы?
Dialogue: 0,0:12:01.88,0:12:03.09,Default,,0,0,0,,Мен оны бірінші рет естіп тұрмын.
Dialogue: 0,0:12:03.34,0:12:06.51,Default,,0,0,0,,Trad-тен сіз екінші командадасыз.
Dialogue: 0,0:12:06.60,0:12:09.64,Default,,0,0,0,,Мен сізді іс жүзінде ең ұқыпты жүзгіш деп естідім.
Dialogue: 0,0:12:09.93,0:12:12.56,Default,,0,0,0,,Болашақта әлі де өсу мүмкіндігі бар.
Dialogue: 0,0:12:12.64,0:12:14.48,Default,,0,0,0,,Оны лақтырғың келе ме?
Dialogue: 0,0:12:14.81,0:12:17.23,Default,,0,0,0,,Мен оны лақтырмаймын деп ойлаймын
Dialogue: 0,0:12:18.02,0:12:21.57,Default,,0,0,0,,Барто Аои мен Рантаро Кияма келіп, оны байқады.
Dialogue: 0,0:12:21.86,0:12:23.57,Default,,0,0,0,,Менің өсе алмауымның себептері
Dialogue: 0,0:12:25.74,0:12:27.62,Default,,0,0,0,,Не деп тұрсың, Иван?
Dialogue: 0,0:12:28.03,0:12:29.33,Default,,0,0,0,,Әй, айтшы!
Dialogue: 0,0:12:29.87,0:12:30.95,Default,,0,0,0,,Барт
Dialogue: 0,0:12:31.25,0:12:35.04,Default,,0,0,0,,Менде сен сияқты, Рантаро сияқты күш жоқ.
Dialogue: 0,0:12:35.62,0:12:39.04,Default,,0,0,0,,Қарсылас болса да, жеңіске қарай бір қадам да артқа шегінбеймін.
Dialogue: 0,0:12:39.30,0:12:41.88,Default,,0,0,0,,Жеңіс туралы жырламайтын күш...
Dialogue: 0,0:12:41.96,0:12:45.05,Default,,0,0,0,,Шынымды айтсам, бұл мүмкін емес деп ойладым.
Dialogue: 0,0:12:45.76,0:12:49.05,Default,,0,0,0,,Барлығы осылай істейді емес пе? Мен тек жеңіс туралы ойлаймын
Dialogue: 0,0:12:49.89,0:12:53.56,Default,,0,0,0,,Мен ұтылып қалсам не істеймін деп ойлаймын.
Dialogue: 0,0:12:55.69,0:12:59.52,Default,,0,0,0,,Мен әрқашан ойынның ағымын өз басымда құрылымдаймын.
Dialogue: 0,0:12:59.73,0:13:01.82,Default,,0,0,0,,Мен стратегия жасағанды ​​ұнатамын.
Dialogue: 0,0:13:02.65,0:13:07.07,Default,,0,0,0,,Мысалы, менің стратегияммен достарым жеңсе, мен қуанар едім.
Dialogue: 0,0:13:08.91,0:13:11.74,Default,,0,0,0,,BC Соль өзгеруге жақын
Dialogue: 0,0:13:12.08,0:13:16.21,Default,,0,0,0,,Мен сияқты орта мансаптағы адамдар араласпауы керек деп ойлаймын.
Dialogue: 0,0:13:16.54,0:13:18.42,Default,,0,0,0,,Оны жарты жолда орындау мүмкін емес.
Dialogue: 0,0:13:18.50,0:13:21.25,Default,,0,0,0,,Иван әрқашан көп жұмыс істеді!
Dialogue: 0,0:13:21.38,0:13:25.30,Default,,0,0,0,,Жалғыз көп жұмыс істеу бәсекелестік әлемде оны қысқартпайды.
Dialogue: 0,0:13:25.38,0:13:27.22,Default,,0,0,0,,Сіз мұны түсінбейсіз!
Dialogue: 0,0:13:28.30,0:13:29.64,Default,,0,0,0,,Бартоны өтінемін
Dialogue: 0,0:13:31.14,0:13:32.89,Default,,0,0,0,,Барлығы түсінеді.
Dialogue: 0,0:13:33.22,0:13:37.44,Default,,0,0,0,,Соған қарамастан, мен бұл туралы айту үшін жеткілікті батылдық жинадым.
Dialogue: 0,0:13:38.52,0:13:39.65,Default,,0,0,0,,Иван…
Dialogue: 0,0:13:41.11,0:13:43.53,Default,,0,0,0,,Мен бұл сөзімнен бас тарта алмаймын, Балто.
Dialogue: 0,0:13:46.82,0:13:48.82,Default,,0,0,0,,Меншік иесін растаңыз
Dialogue: 0,0:13:50.62,0:13:51.87,Default,,0,0,0,,Оны мойындайық
Dialogue: 0,0:13:52.62,0:13:54.12,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:13:54.20,0:13:56.25,Default,,0,0,0,,Мен көмектесе алмаймын, Балто.
Dialogue: 0,0:13:56.37,0:13:57.71,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз -
Dialogue: 0,0:13:57.79,0:14:00.84,Default,,0,0,0,,Б.з.д. Сольдің алтын ғасырын қайтарыңыз.
Dialogue: 0,0:14:01.34,0:14:02.38,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:03.59,0:14:05.46,Default,,0,0,0,,Мен ертең кетемін.
Dialogue: 0,0:14:07.05,0:14:08.18,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:14:09.01,0:14:12.30,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:12.60,0:14:14.81,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:16.52,0:14:17.56,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:14:20.15,0:14:22.98,Default,,0,0,0,,♪~
Dialogue: 0,0:14:29.20,0:14:32.28,Default,,0,0,0,,Мүмкін, қайда қоныстану керектігін шешетін кез келді ме?
Dialogue: 0,0:14:32.37,0:14:35.24,Default,,0,0,0,,Сіздің жағдайыңыз – бәрін жеу.
Dialogue: 0,0:14:35.41,0:14:37.54,Default,,0,0,0,,Менің командам сізге қамқор болады...
Dialogue: 0,0:14:37.62,0:14:39.00,Default,,0,0,0,,Мен бәрібір тоқтаймын.
Dialogue: 0,0:14:39.42,0:14:41.42,Default,,0,0,0,,Е... Cisco!
Dialogue: 0,0:14:41.67,0:14:43.54,Default,,0,0,0,,(Су дыбысы)
Dialogue: 0,0:14:50.43,0:14:52.01,Default,,0,0,0,,Бұл қызықсыз...
Dialogue: 0,0:14:56.35,0:14:59.14,Default,,0,0,0,,BC Galleon матчына қатысушыларды жариялаймыз.
Dialogue: 0,0:14:59.56,0:15:03.81,Default,,0,0,0,,Стэн Гамбургер Барто Аои Рантаро Кияма
Dialogue: 0,0:15:03.90,0:15:06.03,Default,,0,0,0,,Риксон Клэй қосалқы мүше ретінде
Dialogue: 0,0:15:06.11,0:15:06.98,Default,,0,0,0,,Міне!
Dialogue: 0,0:15:07.07,0:15:08.49,Default,,0,0,0,,Гах!
Dialogue: 0,0:15:09.03,0:15:12.16,Default,,0,0,0,,Таңғалғаным сонша, үйреншікті сөздерді де айта алмай қалдым.
Dialogue: 0,0:15:12.62,0:15:16.62,Default,,0,0,0,,Бүгін Галлеонға қарсы матчқа жаттығу басталады.
Dialogue: 0,0:15:17.04,0:15:19.87,Default,,0,0,0,,Басқа мүшелер мәзірді әдеттегідей орындауы керек.
Dialogue: 0,0:15:20.21,0:15:21.58,Default,,0,0,0,,Еріту
Dialogue: 0,0:15:24.21,0:15:26.17,Default,,0,0,0,,Кеттік, Балто!
Dialogue: 0,0:15:43.56,0:15:45.90,Default,,0,0,0,,Өзіңізді сергек сезінбеңіз.
Dialogue: 0,0:15:51.24,0:15:53.70,Default,,0,0,0,,Мен әр жерден дауыстар естідім...
Dialogue: 0,0:15:53.78,0:15:55.91,Default,,0,0,0,,Бас тарта беретін қандай нәрсе?
Dialogue: 0,0:15:55.99,0:15:57.45,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:15:58.87,0:16:02.25,Default,,0,0,0,,Баратын жеріңіз болмаса, қайтып келуіңізге болады.
Dialogue: 0,0:16:02.75,0:16:04.50,Default,,0,0,0,,Мен сенімен қосылғым келмейді.
Dialogue: 0,0:16:05.96,0:16:09.21,Default,,0,0,0,,Жарайды, шынын айтсаң, мен саған қызықты оқиғаларды айтып берейін.
Dialogue: 0,0:16:09.76,0:16:10.42,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:10.80,0:16:14.68,Default,,0,0,0,,Балт келесі ойында ойнай алмайтын сияқты.
Dialogue: 0,0:16:15.39,0:16:16.43,Default,,0,0,0,,Балт?
Dialogue: 0,0:16:18.22,0:16:21.93,Default,,0,0,0,,Португалияға қарсы келесі ойынға тіркелу күтілуде.
Dialogue: 0,0:16:27.90,0:16:30.73,Default,,0,0,0,,Кеттік! гипер қалқанның бұзылуы
Dialogue: 0,0:16:32.44,0:16:35.24,Default,,0,0,0,,Маған рұқсат етіңіз! циклондық цикл
Dialogue: 0,0:16:41.16,0:16:43.75,Default,,0,0,0,,Сізге соққы болды ма?
Dialogue: 0,0:16:45.71,0:16:48.84,Default,,0,0,0,,Қалай? Осы ергежейлі жеңгеніңіз үшін жеңілдендіңіз бе?
Dialogue: 0,0:16:49.34,0:16:50.55,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:16:51.01,0:16:54.59,Default,,0,0,0,,Сіз тез арада қайдан алуға болатынын білесіз, солай ма?
Dialogue: 0,0:16:55.55,0:16:56.84,Default,,0,0,0,,Не айтпақшысың?
Dialogue: 0,0:16:57.18,0:17:01.81,Default,,0,0,0,,Мен Еуропа лигасын қызықтырақ еткім келеді.
Dialogue: 0,0:17:06.19,0:17:08.73,Default,,0,0,0,,(Андждың гуілдеуі)
Dialogue: 0,0:17:09.36,0:17:11.28,Default,,0,0,0,,Эй, бұл сирек.
Dialogue: 0,0:17:13.15,0:17:14.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:16.66,0:17:19.62,Default,,0,0,0,,Қожайын болғанда жиі келетінмін.
Dialogue: 0,0:17:20.08,0:17:21.79,Default,,0,0,0,,Сіз шаршаған сияқтысыз.
Dialogue: 0,0:17:21.87,0:17:23.62,Default,,0,0,0,,Соған ұқсайды ма?
Dialogue: 0,0:17:23.70,0:17:25.08,Default,,0,0,0,,Мен көре аламын, көремін
Dialogue: 0,0:17:26.83,0:17:29.59,Default,,0,0,0,,Тегін арқа сүйеген мен едім
Dialogue: 0,0:17:30.17,0:17:33.26,Default,,0,0,0,,Бұдан былай командамызды қалай құруымыз керек...
Dialogue: 0,0:17:33.96,0:17:36.47,Default,,0,0,0,,Бұл менімен ақылдасатын нәрсе емес.
Dialogue: 0,0:17:36.80,0:17:40.39,Default,,0,0,0,,Андж-сан, сен бұл команданы бұрыннан танисың, солай емес пе?
Dialogue: 0,0:17:40.47,0:17:42.81,Default,,0,0,0,,Атаң екеуің бір бөлек.
Dialogue: 0,0:17:42.89,0:17:45.39,Default,,0,0,0,,Мұның бәрі сіздің не істегіңіз келетініне байланысты.
Dialogue: 0,0:17:45.48,0:17:46.89,Default,,0,0,0,,Пісірумен бірдей
Dialogue: 0,0:17:46.98,0:17:50.81,Default,,0,0,0,,Егер сіз оны дайын өнімнің көрінісімен жасасаңыз, оны жасай аласыз.
Dialogue: 0,0:17:53.44,0:17:57.15,Default,,0,0,0,,Олай болса да, мен қателіктер жіберетін шығармын.
Dialogue: 0,0:17:57.95,0:18:00.87,Default,,0,0,0,,Сәтсіздік... қабылданбайды.
Dialogue: 0,0:18:03.66,0:18:05.75,Default,,0,0,0,,Эй, уайымдама!
Dialogue: 0,0:18:05.83,0:18:08.29,Default,,0,0,0,,Сіз мұны келесі жолы жасаймын дедіңіз!
Dialogue: 0,0:18:08.54,0:18:12.17,Default,,0,0,0,,Бұл бізге қарағанда екінші топтағылардың барлығына жақсырақ болады.
Dialogue: 0,0:18:12.25,0:18:13.75,Default,,0,0,0,,Еркінбеңіз!
Dialogue: 0,0:18:13.84,0:18:15.92,Default,,0,0,0,,Біз үздік командамыз.
Dialogue: 0,0:18:16.01,0:18:19.43,Default,,0,0,0,,Жеңіске жетпесек, екіншісі одан да агрессивті болуы керек.
Dialogue: 0,0:18:19.93,0:18:22.39,Default,,0,0,0,,Аники, Португалиямен матчқа барайық
Dialogue: 0,0:18:22.68,0:18:25.43,Default,,0,0,0,,Бұл Йонекома академиясында болған кезден басқаша.
Dialogue: 0,0:18:25.52,0:18:27.81,Default,,0,0,0,,Бұл нешеу бар?
Dialogue: 0,0:18:27.89,0:18:29.19,Default,,0,0,0,,«Якинику ас»!
Dialogue: 0,0:18:29.35,0:18:31.90,Default,,0,0,0,,If you want to call it that, it’s “eat the fittest”
Dialogue: 0,0:18:32.52,0:18:33.90,Default,,0,0,0,,Бұл Шаса ма?
Dialogue: 0,0:18:34.19,0:18:36.19,Default,,0,0,0,,Құрметті тұтынушы, Балтоға
Dialogue: 0,0:18:37.74,0:18:38.61,Default,,0,0,0,,Иван!
Dialogue: 0,0:18:38.95,0:18:41.74,Default,,0,0,0,,О, сені көргеніме қуаныштымын. Бойыңыз өсті, солай емес пе?
Dialogue: 0,0:18:41.82,0:18:43.70,Default,,0,0,0,,Үш күн бұрын шықты.
Dialogue: 0,0:18:43.78,0:18:46.16,Default,,0,0,0,,Сіз жаттықтырушы ретінде оқисыз ба?
Dialogue: 0,0:18:46.25,0:18:49.96,Default,,0,0,0,,Ал, одан артық не бар, Барто оның үстінен өтіп жатыр ма?
Dialogue: 0,0:18:50.96,0:18:54.67,Default,,0,0,0,,I appreciate that you noticed my second.
Dialogue: 0,0:18:54.84,0:18:56.46,Default,,0,0,0,,I think that's wrong.
Dialogue: 0,0:18:56.55,0:18:57.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:57.55,0:18:59.17,Default,,0,0,0,,Мен ризамын
Dialogue: 0,0:18:59.51,0:19:03.05,Default,,0,0,0,,It was you who made me realize my dreams.
Dialogue: 0,0:19:03.80,0:19:06.56,Default,,0,0,0,,Мені шығарып салған барлықтарыңызға
Dialogue: 0,0:19:06.64,0:19:08.64,Default,,0,0,0,,I feel like I have to try hard.
Dialogue: 0,0:19:08.73,0:19:11.98,Default,,0,0,0,,Portugal match I want you to fight
Dialogue: 0,0:19:12.06,0:19:15.94,Default,,0,0,0,,You will become stronger, I will continue on the path of becoming a trainer.
Dialogue: 0,0:19:16.02,0:19:18.36,Default,,0,0,0,,Isn't it like fighting together?
Dialogue: 0,0:19:18.90,0:19:21.66,Default,,0,0,0,,Жүр, Балто, жеңеміз!
Dialogue: 0,0:19:21.74,0:19:23.41,Default,,0,0,0,,I'm going to Ouen.
Dialogue: 0,0:19:25.74,0:19:28.66,Default,,0,0,0,,BC Sol vs. BC Galleon
Dialogue: 0,0:19:28.75,0:19:32.67,Default,,0,0,0,,First of all, BC Galleon won the first game!
Dialogue: 0,0:19:32.75,0:19:35.67,Default,,0,0,0,,Біздің эрамызға дейінгі Галлеон Бірінші Торрес
Dialogue: 0,0:19:35.75,0:19:38.92,Default,,0,0,0,,Хмм! A truly brilliant burst win!
Dialogue: 0,0:19:39.21,0:19:41.43,Default,,0,0,0,,Өтінемін, Кумичо.
Dialogue: 0,0:19:41.51,0:19:43.68,Default,,0,0,0,,Мен қысым көрсеттім бе?
Dialogue: 0,0:19:43.76,0:19:45.80,Default,,0,0,0,,Балто жақсы!
Dialogue: 0,0:19:46.14,0:19:47.43,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:19:49.22,0:19:51.44,Default,,0,0,0,,I'm going, no complaints.
Dialogue: 0,0:19:51.73,0:19:52.56,Default,,0,0,0,,О
Dialogue: 0,0:19:59.15,0:20:01.82,Default,,0,0,0,,BC Галлеон өзінің екінші жеңісіне қол жеткізді.
Dialogue: 0,0:20:01.90,0:20:03.57,Default,,0,0,0,,What a great advance!
Dialogue: 0,0:20:03.91,0:20:06.16,Default,,0,0,0,,Не болып жатыр? Стэн!
Dialogue: 0,0:20:06.24,0:20:08.04,Default,,0,0,0,,It doesn't look good at all.
Dialogue: 0,0:20:08.12,0:20:10.83,Default,,0,0,0,,I feel like I'm not even using half of my ability.
Dialogue: 0,0:20:11.41,0:20:13.37,Default,,0,0,0,,There was no point in practicing.
Dialogue: 0,0:20:13.67,0:20:16.34,Default,,0,0,0,,It's still too early to draw conclusions.
Dialogue: 0,0:20:16.63,0:20:18.25,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:20:18.67,0:20:22.38,Default,,0,0,0,,3-ші ойын BC Сольдің істейтін ештеңесі жоқ!
Dialogue: 0,0:20:22.47,0:20:23.93,Default,,0,0,0,,Will we make a breakthrough?
Dialogue: 0,0:20:24.64,0:20:27.35,Default,,0,0,0,,Барлығына жеңіс!
Dialogue: 0,0:20:27.43,0:20:29.47,Default,,0,0,0,,We need to win here and connect.
Dialogue: 0,0:20:29.56,0:20:32.56,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:20:32.85,0:20:34.94,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:35.15,0:20:37.06,Default,,0,0,0,,Ксавье келе ме? Ксавьер келеді!
Dialogue: 0,0:20:37.15,0:20:38.94,Default,,0,0,0,,Ксавье Китер
Dialogue: 0,0:20:39.02,0:20:41.36,Default,,0,0,0,,3-ойын аяқталды!
Dialogue: 0,0:20:41.44,0:20:44.53,Default,,0,0,0,,BC Галлеонның 3-ші қатарынан жеңісі!
Dialogue: 0,0:20:44.61,0:20:46.16,Default,,0,0,0,,Қандай BC Sol!
Dialogue: 0,0:20:46.24,0:20:50.24,Default,,0,0,0,,Швецияның викингтерге қарсы ойынынан кейін тағы бір жеңіліс!
Dialogue: 0,0:20:50.62,0:20:53.12,Default,,0,0,0,,Мен адасып қалдым, әйтеуір...
Dialogue: 0,0:20:59.50,0:21:00.92,Default,,0,0,0,,Иван, кешіріңіз.
Dialogue: 0,0:21:01.59,0:21:04.72,Default,,0,0,0,,Өкінішті. Бұл әлі де топ команда ма?
Dialogue: 0,0:21:05.18,0:21:07.68,Default,,0,0,0,,«Әлсіз көздің қарғысы» деп аталады.
Dialogue: 0,0:21:07.76,0:21:10.47,Default,,0,0,0,,Мен жеңіп, сені жібергім келді.
Dialogue: 0,0:21:10.56,0:21:12.93,Default,,0,0,0,,Жарайды, бұл да ойын.
Dialogue: 0,0:21:13.31,0:21:15.81,Default,,0,0,0,,Бірақ мен ''Мен міндетті түрде жеңемін'' дедім...
Dialogue: 0,0:21:16.19,0:21:18.06,Default,,0,0,0,,Жеңімпаз деген ұғым жоқ
Dialogue: 0,0:21:18.15,0:21:20.94,Default,,0,0,0,,Дегенмен бүгінгі жеңіліс келесіге апарары сөзсіз.
Dialogue: 0,0:21:21.02,0:21:23.82,Default,,0,0,0,,Олай ойламасаң, қолыңнан келмейді.
Dialogue: 0,0:21:25.95,0:21:27.07,Default,,0,0,0,,Cisco!
Dialogue: 0,0:21:29.03,0:21:30.83,Default,,0,0,0,,Бұл қызықсыз матч болды.
Dialogue: 0,0:21:31.45,0:21:32.58,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:21:33.91,0:21:36.12,Default,,0,0,0,,Бұдан былай мен оны қызықты етемін.
Dialogue: 0,0:21:36.42,0:21:38.96,Default,,0,0,0,,Әй, сен шықпадың ба?
Dialogue: 0,0:21:39.04,0:21:40.38,Default,,0,0,0,,Жаяу серуендеу
Dialogue: 0,0:21:41.17,0:21:43.17,Default,,0,0,0,,Сіз қайтасыз, Cisco.
Dialogue: 0,0:21:43.26,0:21:44.76,Default,,0,0,0,,Барымызды бірге жасайық
Dialogue: 0,0:21:48.39,0:21:49.14,Default,,0,0,0,,Пон!
Dialogue: 0,0:21:50.51,0:21:51.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:51.93,0:21:52.85,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:21:55.89,0:21:58.35,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.44,0:22:01.77,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:01.86,0:22:04.61,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.69,0:22:06.90,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:06.99,0:22:10.57,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.66,0:22:14.24,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.33,0:22:16.08,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.16,0:22:17.91,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.00,0:22:19.71,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.79,0:22:21.46,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.54,0:22:23.50,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.59,0:22:26.01,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.09,0:22:29.01,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.09,0:22:32.76,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.85,0:22:36.48,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.56,0:22:38.27,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.35,0:22:41.56,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.65,0:22:43.90,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:43.98,0:22:47.40,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.49,0:22:51.07,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.16,0:22:53.12,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.20,0:22:54.95,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:55.04,0:22:58.41,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.50,0:23:00.37,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.46,0:23:03.50,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.59,0:23:05.84,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:06.00,0:23:09.80,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.88,0:23:13.43,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.55,0:23:17.10,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.18,0:23:20.31,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.39,0:23:22.19,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.27,0:23:24.98,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.27,0:23:24.98,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:24.98,0:23:25.48,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.53,0:23:30.65,Default,,0,0,0,,Дина Париж пышақтарының ойыншысы ретінде қайта оралды!
Dialogue: 0,0:23:30.74,0:23:32.86,Default,,0,0,0,,Бірақ мен және Кумичо
Dialogue: 0,0:23:32.95,0:23:36.41,Default,,0,0,0,,Мен ауыстырып жатырмын деген қауесет шығып, ойынға қатыса алмадым.
Dialogue: 0,0:23:36.49,0:23:40.12,Default,,0,0,0,,Біздің қиыншылықтарымыз мұнымен бітпейді!
Dialogue: 0,0:23:40.50,0:23:42.96,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.04,0:23:44.79,Default,,0,0,0,,Қасқырдың екінші келуі (Өлімші Сайрин)!
Dialogue: 0,0:23:45.00,0:23:48.71,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:50.21,0:23:56.21,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory