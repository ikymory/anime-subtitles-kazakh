Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.08,0:00:07.00,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.13,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.43,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:20.02,0:00:24.48,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.10,0:00:29.73,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:31.03,0:00:32.57,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:00:32.65,0:00:34.24,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:00:34.57,0:00:38.16,Default,,0,0,0,,Бізде, В.С. Соль, сынақ шайқасы болады.
Dialogue: 0,0:00:38.28,0:00:40.20,Default,,0,0,0,,Онда не пайда болды...
Dialogue: 0,0:00:41.33,0:00:42.91,Default,,0,0,0,,Ақша, мәртебе және әдемі әйел.
Dialogue: 0,0:00:43.33,0:00:44.16,Default,,0,0,0,,Cisco?
Dialogue: 0,0:00:46.79,0:00:48.96,Default,,0,0,0,,Жүр!
Dialogue: 0,0:00:54.09,0:00:55.34,Default,,0,0,0,,Не!
Dialogue: 0,0:00:55.97,0:00:59.14,Default,,0,0,0,,Мұны істеме! Шайтан жыла!
Dialogue: 0,0:00:59.22,0:01:02.10,Default,,0,0,0,,Cisco Real Sambat-тан шыққаннан кейін келді.
Dialogue: 0,0:01:02.52,0:01:06.81,Default,,0,0,0,,Ол өзінің керемет күшін көрсетіп, BC Sol-қа қосылды.
Dialogue: 0,0:01:07.98,0:01:08.90,Default,,0,0,0,,Және…
Dialogue: 0,0:01:09.61,0:01:10.94,Default,,0,0,0,,Джанго!
Dialogue: 0,0:01:11.82,0:01:13.86,Default,,0,0,0,,Төменгі қабатта мұны істеуге шыдай алмаймын.
Dialogue: 0,0:01:14.40,0:01:17.36,Default,,0,0,0,,Сондықтан мен бұл топтан кетуді шештім.
Dialogue: 0,0:01:17.45,0:01:19.57,Default,,0,0,0,,Бірақ Джанго...
Dialogue: 0,0:01:19.82,0:01:22.66,Default,,0,0,0,,Команда ішіндегі бәсеке күшейе түсті.
Dialogue: 0,0:01:23.37,0:01:26.87,Default,,0,0,0,,Мен міндетті түрде үздік командаға кіремін!
Dialogue: 0,0:01:28.46,0:01:31.21,Default,,0,0,0,,♪~
Dialogue: 0,0:01:31.29,0:01:33.71,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:33.80,0:01:36.26,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:36.34,0:01:38.72,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:38.80,0:01:41.22,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:41.30,0:01:42.89,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:42.97,0:01:47.14,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:48.06,0:01:52.82,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:52.90,0:01:57.40,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:57.90,0:02:02.66,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:02.74,0:02:07.66,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:07.75,0:02:12.63,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:12.71,0:02:17.72,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:17.80,0:02:21.05,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:21.14,0:02:22.68,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:22.76,0:02:25.18,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:25.27,0:02:27.64,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:27.73,0:02:29.85,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:29.94,0:02:31.23,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:31.31,0:02:32.69,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:32.77,0:02:35.28,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:35.36,0:02:41.49,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:41.57,0:02:45.79,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:45.87,0:02:48.66,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:48.75,0:02:51.17,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:51.25,0:02:53.71,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:53.79,0:02:57.38,Default,,0,0,0,,BURST BURST 3, 2, 1, АТТЫРУ! )
Dialogue: 0,0:02:53.79,0:02:57.38,Default,,0,0,0,,~♪
Dialogue: 0,0:02:59.17,0:03:01.59,Default,,0,0,0,,Ұстаңыз! Үздік команда!
Dialogue: 0,0:03:06.76,0:03:08.31,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:03:11.44,0:03:12.31,Default,,0,0,0,,Сыртқа шығарған ауаңыз сол жақтағы осы бөліктен шығады.
Dialogue: 0,0:03:12.40,0:03:14.11,Default,,0,0,0,,Е... эй...
Dialogue: 0,0:03:15.69,0:03:19.19,Default,,0,0,0,,Күте тұрыңыз, оны қалдыру жақсы идея емес.
Dialogue: 0,0:03:19.32,0:03:20.49,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:03:20.82,0:03:22.24,Default,,0,0,0,,Стэн! Қайырлы таң
Dialogue: 0,0:03:22.45,0:03:23.28,Default,,0,0,0,,Тс!
Dialogue: 0,0:03:25.83,0:03:27.41,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:29.08,0:03:30.75,Default,,0,0,0,,Қараңдаршы, жаңадан жасалған чурролар!
Dialogue: 0,0:03:31.16,0:03:32.42,Default,,0,0,0,,Қайырлы таң, анашым!
Dialogue: 0,0:03:32.71,0:03:34.00,Default,,0,0,0,,Қайырлы таң Балто
Dialogue: 0,0:03:34.33,0:03:36.59,Default,,0,0,0,,Балто Бұл жолмен, былай!
Dialogue: 0,0:03:37.63,0:03:40.59,Default,,0,0,0,,Эй, Кумичо Стэнс, бірдеңе болды ма?
Dialogue: 0,0:03:40.67,0:03:43.13,Default,,0,0,0,,Тек атмосфераны оқыңыз.
Dialogue: 0,0:03:43.68,0:03:46.97,Default,,0,0,0,,Не? Сіз атмосфераны оқи аласыз ба?
Dialogue: 0,0:03:47.31,0:03:49.14,Default,,0,0,0,,Эй... Тыңдашы, Балто.
Dialogue: 0,0:03:49.97,0:03:52.27,Default,,0,0,0,,Бәріміз де жартастың үстіндеміз.
Dialogue: 0,0:03:53.10,0:03:54.48,Default,,0,0,0,,Жарайды, жаттығу! Жаттығу!
Dialogue: 0,0:03:55.10,0:03:56.61,Default,,0,0,0,,Гочисо-сан!
Dialogue: 0,0:03:56.69,0:03:57.73,Default,,0,0,0,,Айо
Dialogue: 0,0:03:57.82,0:03:59.40,Default,,0,0,0,,«Гакеппучи» дегеніміз не?
Dialogue: 0,0:04:00.99,0:04:03.03,Default,,0,0,0,,«Жасайтын ештеңе жоқ».
Dialogue: 0,0:04:03.11,0:04:07.20,Default,,0,0,0,,Бұл ренжітті, бірақ қазір фрилансерлерден басқа барлық адамдарда бірдей қабілет бар.
Dialogue: 0,0:04:07.91,0:04:11.62,Default,,0,0,0,,Біреу қатты тырысса, біреу құлап қалады.
Dialogue: 0,0:04:12.50,0:04:14.42,Default,,0,0,0,,Бұл жартас па...
Dialogue: 0,0:04:15.00,0:04:16.17,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:04:16.25,0:04:18.04,Default,,0,0,0,,Уау! Уау уау
Dialogue: 0,0:04:18.13,0:04:19.96,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:04:20.67,0:04:22.51,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:04:22.59,0:04:24.01,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:04:24.09,0:04:26.14,Default,,0,0,0,,Құлап кетсе сонда болар еді.
Dialogue: 0,0:04:26.22,0:04:27.35,Default,,0,0,0,,Зуко
Dialogue: 0,0:04:27.89,0:04:29.89,Default,,0,0,0,,Аники Бұл басқаша.
Dialogue: 0,0:04:29.97,0:04:31.64,Default,,0,0,0,,Бұл нағыз жартас емес.
Dialogue: 0,0:04:32.14,0:04:33.52,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:04:33.60,0:04:34.89,Default,,0,0,0,,Гакеппучика!
Dialogue: 0,0:04:34.98,0:04:36.27,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:04:36.35,0:04:37.86,Default,,0,0,0,,Бұл жартас!
Dialogue: 0,0:04:51.95,0:04:54.00,Default,,0,0,0,,О! Бұлай етпе!
Dialogue: 0,0:04:54.37,0:04:55.75,Default,,0,0,0,,Жарайды, мен де!
Dialogue: 0,0:04:56.08,0:04:57.29,Default,,0,0,0,,Қап…
Dialogue: 0,0:04:57.58,0:04:59.67,Default,,0,0,0,,Иә? Жақсы жұмыс!
Dialogue: 0,0:04:59.75,0:05:02.63,Default,,0,0,0,,Кездесуге аз қалды. Барайық.
Dialogue: 0,0:05:03.67,0:05:06.55,Default,,0,0,0,,Жарайды! Мен де бүгін бар күшімді саламын
Dialogue: 0,0:05:06.76,0:05:09.72,Default,,0,0,0,,А, сәл күте тұрыңыз.
Dialogue: 0,0:05:12.06,0:05:13.64,Default,,0,0,0,,Кездесу орны өзгерді.
Dialogue: 0,0:05:13.73,0:05:15.10,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:15.23,0:05:18.02,Default,,0,0,0,,Аа, отырыс бөлмесінде кездесейік.
Dialogue: 0,0:05:18.15,0:05:20.90,Default,,0,0,0,,Түсіндім, хабарлағаныңызға рахмет.
Dialogue: 0,0:05:20.98,0:05:23.53,Default,,0,0,0,,Ура! О, жақсы!
Dialogue: 0,0:05:24.49,0:05:25.74,Default,,0,0,0,,Nbe
Dialogue: 0,0:05:26.61,0:05:29.24,Default,,0,0,0,,Келіңіздер! Бүгін де жасайық!
Dialogue: 0,0:05:29.32,0:05:32.99,Default,,0,0,0,,А... А? Ешкім келмейді!
Dialogue: 0,0:05:34.12,0:05:35.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:35.62,0:05:38.29,Default,,0,0,0,,Ах! Бұл не?
Dialogue: 0,0:05:38.46,0:05:40.34,Default,,0,0,0,,Барлығы осында болды ма?
Dialogue: 0,0:05:40.79,0:05:42.67,Default,,0,0,0,,Кеттік, Балто.
Dialogue: 0,0:05:42.75,0:05:43.42,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:43.50,0:05:45.30,Default,,0,0,0,,Барто Аои!
Dialogue: 0,0:05:45.92,0:05:47.47,Default,,0,0,0,,Чикоку?
Dialogue: 0,0:05:47.55,0:05:50.80,Default,,0,0,0,,Не? Бірақ... жиналыс бөлмесі?
Dialogue: 0,0:05:50.89,0:05:52.47,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:05:52.64,0:05:55.43,Default,,0,0,0,,Сылтау айтпаңыз, жай ғана 10 айналым жасаңыз.
Dialogue: 0,0:05:55.85,0:05:57.52,Default,,0,0,0,,Эх!
Dialogue: 0,0:05:57.85,0:05:59.27,Default,,0,0,0,,Гүлп...
Dialogue: 0,0:05:59.60,0:06:03.82,Default,,0,0,0,,Жоқ! Егер сіз шындап жаттығатын болсаңыз, одан да күшті бола аласыз!
Dialogue: 0,0:06:03.90,0:06:06.07,Default,,0,0,0,,Мен аяғымнан тұрамын
Dialogue: 0,0:06:06.15,0:06:08.15,Default,,0,0,0,,Ал, кеттік~
Dialogue: 0,0:06:08.57,0:06:10.41,Default,,0,0,0,,Ол ақымақ па?
Dialogue: 0,0:06:10.49,0:06:14.08,Default,,0,0,0,,Басқалардан айырмашылығы, Балто әрқашан позитивті.
Dialogue: 0,0:06:14.16,0:06:16.08,Default,,0,0,0,,Не! Қарғыс атқыр...
Dialogue: 0,0:06:16.37,0:06:18.00,Default,,0,0,0,,Хехехе
Dialogue: 0,0:06:18.08,0:06:19.71,Default,,0,0,0,,Кин!
Dialogue: 0,0:06:23.59,0:06:25.67,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:06:30.72,0:06:33.64,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:06:36.77,0:06:38.43,Default,,0,0,0,,(құлап жатқан дыбыс)
Dialogue: 0,0:06:38.81,0:06:41.65,Default,,0,0,0,,10 айналым... Бітті.
Dialogue: 0,0:06:42.02,0:06:44.48,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:06:44.57,0:06:47.53,Default,,0,0,0,,(Барлық атудың дауысы)
Dialogue: 0,0:06:47.61,0:06:49.45,Default,,0,0,0,,Ах! Ұрыс!
Dialogue: 0,0:06:50.78,0:06:52.49,Default,,0,0,0,,Келесі Менің балам!
Dialogue: 0,0:06:52.57,0:06:53.87,Default,,0,0,0,,Кедергі жасамаңыз
Dialogue: 0,0:06:54.37,0:06:56.08,Default,,0,0,0,,Мен Риксонмен жұмыс істедім.
Dialogue: 0,0:06:56.16,0:06:57.20,Default,,0,0,0,,Кеттік, Хиксон.
Dialogue: 0,0:06:57.29,0:06:58.04,Default,,0,0,0,,Біз
Dialogue: 0,0:06:58.45,0:07:01.25,Default,,0,0,0,,Қарашы, Балто, ана жаққа, ана жаққа!
Dialogue: 0,0:07:01.33,0:07:02.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:04.46,0:07:07.05,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:07.13,0:07:08.92,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:13.85,0:07:15.10,Default,,0,0,0,,Бұл сұмдық
Dialogue: 0,0:07:15.18,0:07:17.27,Default,,0,0,0,,Қарғыс атқыр... бірдеңе дедіңіз бе?
Dialogue: 0,0:07:19.93,0:07:22.02,Default,,0,0,0,,Қоқыс деп айттым.
Dialogue: 0,0:07:22.35,0:07:23.73,Default,,0,0,0,,Мәңгі...
Dialogue: 0,0:07:23.81,0:07:26.77,Default,,0,0,0,,BC Sol «бір адамдық еркін команда» деп аталады.
Dialogue: 0,0:07:26.86,0:07:28.15,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:28.57,0:07:32.61,Default,,0,0,0,,Ендеше, сендер бір-біріңді осылай ұстап тұрыңдар.
Dialogue: 0,0:07:32.70,0:07:33.61,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:07:34.91,0:07:37.33,Default,,0,0,0,,Шүкір, ол да кептеліс.
Dialogue: 0,0:07:37.41,0:07:39.41,Default,,0,0,0,,Бұл тым көп емес пе?
Dialogue: 0,0:07:40.04,0:07:41.08,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:41.16,0:07:42.58,Default,,0,0,0,,Атмосфера тым нашар
Dialogue: 0,0:07:42.67,0:07:44.17,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:07:44.46,0:07:47.88,Default,,0,0,0,,Стэннің жігіті, басына шеге соғып жатыр.
Dialogue: 0,0:07:47.96,0:07:49.17,Default,,0,0,0,,Сегіз соққы?
Dialogue: 0,0:07:49.26,0:07:50.84,Default,,0,0,0,,Сіз байқамадыңыз ба?
Dialogue: 0,0:07:50.92,0:07:52.22,Default,,0,0,0,,Сізге ұқсайды
Dialogue: 0,0:07:55.85,0:07:57.26,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:07:57.35,0:07:59.68,Default,,0,0,0,,Тоқта! Уақытты жақсы өткізіңіз
Dialogue: 0,0:08:01.18,0:08:04.15,Default,,0,0,0,,Эй, Кумичо, бұрын не айтқың келді...
Dialogue: 0,0:08:04.48,0:08:06.40,Default,,0,0,0,,О? Кумичо?
Dialogue: 0,0:08:07.15,0:08:07.94,Default,,0,0,0,,Ах
Dialogue: 0,0:08:09.28,0:08:10.32,Default,,0,0,0,,Стэн!
Dialogue: 0,0:08:11.53,0:08:12.49,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:12.57,0:08:15.49,Default,,0,0,0,,Мен сені қатты ұрып жатқаныңды естідім.
Dialogue: 0,0:08:15.62,0:08:16.66,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:16.74,0:08:17.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:18.70,0:08:21.20,Default,,0,0,0,,Сіз мұны менен тікелей сұрағыңыз келе ме?
Dialogue: 0,0:08:23.37,0:08:25.42,Default,,0,0,0,,Бұл шынымен тітіркендіргіш.
Dialogue: 0,0:08:25.50,0:08:26.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:26.79,0:08:29.05,Default,,0,0,0,,Сенің кесіріңнен Джанго қашып кетті.
Dialogue: 0,0:08:29.13,0:08:30.55,Default,,0,0,0,,Сен үшін!
Dialogue: 0,0:08:32.13,0:08:33.22,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:08:33.30,0:08:34.84,Default,,0,0,0,,Күте тұрыңыз, Стэн.
Dialogue: 0,0:08:35.97,0:08:37.76,Default,,0,0,0,,Бұл менің кінәм...?
Dialogue: 0,0:08:39.89,0:08:43.06,Default,,0,0,0,,(Рантароның гуілдеуі)
Dialogue: 0,0:08:44.06,0:08:44.81,Default,,0,0,0,,Бүгін той күні болады.
Dialogue: 0,0:08:46.35,0:08:48.44,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:08:53.36,0:08:55.07,Default,,0,0,0,,О? Эй
Dialogue: 0,0:08:56.07,0:08:58.74,Default,,0,0,0,,О? Бұл не!
Dialogue: 0,0:09:00.49,0:09:02.20,Default,,0,0,0,,О! О!
Dialogue: 0,0:09:02.29,0:09:05.21,Default,,0,0,0,,Керемет емес пе! Бұл ұстау ма?
Dialogue: 0,0:09:05.75,0:09:07.08,Default,,0,0,0,,Қауіпке барма.
Dialogue: 0,0:09:07.17,0:09:08.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:09.92,0:09:12.34,Default,,0,0,0,,Мені шошытпа!
Dialogue: 0,0:09:12.42,0:09:14.34,Default,,0,0,0,,Менің бөлмеме рұқсатсыз кірме.
Dialogue: 0,0:09:14.84,0:09:17.93,Default,,0,0,0,,Бұл қызықты пішінді ұстағыш па?
Dialogue: 0,0:09:18.14,0:09:20.05,Default,,0,0,0,,Осыны қолдануға рұқсат етіңіз.
Dialogue: 0,0:09:20.43,0:09:21.43,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:09:21.51,0:09:24.56,Default,,0,0,0,,Бұл түйін әлі де даму үстінде.
Dialogue: 0,0:09:24.64,0:09:26.06,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:09:26.14,0:09:27.98,Default,,0,0,0,,Stamina түрі үшін Ragnaruk-
Dialogue: 0,0:09:28.06,0:09:31.44,Default,,0,0,0,,Мен сол қолыммен тұрақтылық керек деп ойладым.
Dialogue: 0,0:09:31.94,0:09:32.69,Default,,0,0,0,,О
Dialogue: 0,0:09:32.98,0:09:37.41,Default,,0,0,0,,Бұл менің төзімділік дағдыларымды аяқтайтынын сеземін.
Dialogue: 0,0:09:37.86,0:09:42.12,Default,,0,0,0,,Мен бұл шыдамдылық соқты ма білмеймін, бірақ жаман нәрсенің бәрі жақсы емес.
Dialogue: 0,0:09:42.66,0:09:46.75,Default,,0,0,0,,Бұл тұтқаны дәл қазір пайдалана алмайсыз.
Dialogue: 0,0:09:48.58,0:09:49.88,Default,,0,0,0,,Түсінсең, кет.
Dialogue: 0,0:09:50.00,0:09:52.30,Default,,0,0,0,,Аздап сауда!
Dialogue: 0,0:09:52.38,0:09:55.13,Default,,0,0,0,,Түсіндім, баспа!
Dialogue: 0,0:09:55.21,0:09:56.80,Default,,0,0,0,,(Тред күрсініс)
Dialogue: 0,0:09:57.22,0:10:00.60,Default,,0,0,0,,Хуаншаньдан келген бұл ұстамды табу қиын...
Dialogue: 0,0:10:01.35,0:10:03.22,Default,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,0:10:03.85,0:10:05.39,Default,,0,0,0,,Trad!
Dialogue: 0,0:10:05.60,0:10:09.77,Default,,0,0,0,,Бұл өте жақсы! Ол сондай жақсы жарасады
Dialogue: 0,0:10:09.85,0:10:11.15,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:11.23,0:10:12.40,Default,,0,0,0,,Мен мұны білмей тұрып...
Dialogue: 0,0:10:12.82,0:10:14.19,Default,,0,0,0,,Сен оны қабылдайтыныңа қуаныштымын.
Dialogue: 0,0:10:14.86,0:10:16.99,Default,,0,0,0,,Аа~ Тағы біраз?
Dialogue: 0,0:10:22.03,0:10:26.33,Default,,0,0,0,,Егер сіз күштірек соққыны соға алмасаңыз, сіз оны жоғары командаға жете алмайсыз!
Dialogue: 0,0:10:26.75,0:10:28.41,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:10:31.67,0:10:33.88,Default,,0,0,0,,(Үдемелі айналу дыбысы)
Dialogue: 0,0:10:36.17,0:10:37.97,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:10:38.55,0:10:40.59,Default,,0,0,0,,Керемет Валькирия!
Dialogue: 0,0:10:42.51,0:10:47.48,Default,,0,0,0,,Мен сенің шынайы күшіңді әлі шығарған жоқпын.
Dialogue: 0,0:10:48.35,0:10:50.48,Default,,0,0,0,,Жарайды, тағы бір рет!
Dialogue: 0,0:10:50.94,0:10:52.98,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:53.90,0:10:56.94,Default,,0,0,0,,О? Бұл басқаша.
Dialogue: 0,0:10:57.53,0:11:00.57,Default,,0,0,0,,Әй, тағы бір рет!
Dialogue: 0,0:11:00.66,0:11:02.70,Default,,0,0,0,,Ол әлі де осылай істеп жатыр ма?
Dialogue: 0,0:11:03.12,0:11:05.91,Default,,0,0,0,,Жаттығу уақыты әлдеқашан аяқталды.
Dialogue: 0,0:11:07.16,0:11:09.04,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:11:09.12,0:11:10.75,Default,,0,0,0,,Маған бәрібір болса ше?
Dialogue: 0,0:11:10.83,0:11:12.67,Default,,0,0,0,,Терге малынбаған
Dialogue: 0,0:11:12.79,0:11:13.88,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:11:14.25,0:11:15.63,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:11:17.88,0:11:19.59,Default,,0,0,0,,Мұнымен қанша уақыт айналысып келесіз?
Dialogue: 0,0:11:19.92,0:11:21.84,Default,,0,0,0,,Тамақтың уақыты таяп қалды.
Dialogue: 0,0:11:22.09,0:11:24.51,Default,,0,0,0,,Кішкене ғана, тағы біраз!
Dialogue: 0,0:11:24.60,0:11:26.97,Default,,0,0,0,,Бұл өте жақсы сезінді.
Dialogue: 0,0:11:27.06,0:11:28.10,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:11:29.93,0:11:31.94,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:11:33.60,0:11:35.90,Default,,0,0,0,,О? Басқа
Dialogue: 0,0:11:35.98,0:11:37.40,Default,,0,0,0,,Бұл сөзсіз басқаша...
Dialogue: 0,0:11:37.48,0:11:38.78,Default,,0,0,0,,Айырмашылығы неде?
Dialogue: 0,0:11:39.32,0:11:42.07,Default,,0,0,0,,Сіз ертерек күйдіріп айттыңыз ба? (Рантаро) Күйіп қалды ма?
Dialogue: 0,0:11:42.15,0:11:43.53,Default,,0,0,0,,Хухун? (Рантаро) Хухун?
Dialogue: 0,0:11:43.61,0:11:44.82,Default,,0,0,0,,Шун? (Рантаро) Шун?
Dialogue: 0,0:11:44.91,0:11:46.41,Default,,0,0,0,,«Ган» (Рантаро) «Ган?» сияқты.
Dialogue: 0,0:11:46.49,0:11:48.29,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:11:48.37,0:11:49.87,Default,,0,0,0,,Шынымен! Шынайы!
Dialogue: 0,0:11:49.95,0:11:52.58,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:11:52.67,0:11:54.33,Default,,0,0,0,,Неліктен сіз сөйлесе аласыз?
Dialogue: 0,0:11:54.54,0:11:56.46,Default,,0,0,0,,Менде түсінік жоқ
Dialogue: 0,0:11:57.59,0:12:00.05,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:00.13,0:12:02.26,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:08.35,0:12:09.89,Default,,0,0,0,,Балто Бұл ма?
Dialogue: 0,0:12:09.97,0:12:11.18,Default,,0,0,0,,Жоқ, бұл басқаша.
Dialogue: 0,0:12:11.27,0:12:12.77,Default,,0,0,0,,Жарайды, қайталап көрейік.
Dialogue: 0,0:12:12.85,0:12:13.60,Default,,0,0,0,,О!
Dialogue: 0,0:12:14.10,0:12:15.90,Default,,0,0,0,,(ату дыбысы)
Dialogue: 0,0:12:23.78,0:12:25.99,Default,,0,0,0,,Сіз қанша уақытқа дейін жалғастыруды жоспарлайсыз?
Dialogue: 0,0:12:26.24,0:12:28.53,Default,,0,0,0,,«Ағын су бұзылмайды»?
Dialogue: 0,0:12:28.66,0:12:31.87,Default,,0,0,0,,Оны жайына қалдыр, сауда бәрібір сені ұрсады.
Dialogue: 0,0:12:33.25,0:12:34.58,Default,,0,0,0,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,0:12:41.55,0:12:43.26,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:12:44.01,0:12:45.89,Default,,0,0,0,,Ах! (Рантаро) Жарайды!
Dialogue: 0,0:12:45.97,0:12:47.72,Default,,0,0,0,,Иә! (Рантаро) О!
Dialogue: 0,0:12:48.01,0:12:51.31,Default,,0,0,0,,Бұл екеуі шынымен де күресіп жатқан сияқты.
Dialogue: 0,0:12:52.02,0:12:53.73,Default,,0,0,0,,Мен енді шыдай алмаймын!
Dialogue: 0,0:12:54.06,0:12:55.85,Default,,0,0,0,,Эй, мен де араластырайын.
Dialogue: 0,0:12:55.94,0:12:58.19,Default,,0,0,0,,Жарайды, жасайық, жасайық!
Dialogue: 0,0:12:58.27,0:13:00.11,Default,,0,0,0,,Біз де кіре аламыз ба?
Dialogue: 0,0:13:00.23,0:13:01.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:01.90,0:13:02.74,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:03.07,0:13:04.15,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:13:04.24,0:13:05.70,Default,,0,0,0,,Не? Сіз оны көрдіңіз бе?
Dialogue: 0,0:13:06.11,0:13:09.28,Default,,0,0,0,,Осы екеуінің жекпе-жегін көріп қышыдым.
Dialogue: 0,0:13:09.37,0:13:12.04,Default,,0,0,0,,Балалар, қызықсыңдар!
Dialogue: 0,0:13:12.12,0:13:14.62,Default,,0,0,0,,Жарайды, келіңдер! Қанекей мынаны істейік!
Dialogue: 0,0:13:14.71,0:13:16.62,Default,,0,0,0,,Антон төреші.
Dialogue: 0,0:13:16.71,0:13:17.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:18.00,0:13:19.50,Default,,0,0,0,,Мен бәріне жеңілгім келмейді.
Dialogue: 0,0:13:19.59,0:13:21.13,Default,,0,0,0,,«Бұл сәтті күн болды»
Dialogue: 0,0:13:21.55,0:13:22.46,Default,,0,0,0,,Тс!
Dialogue: 0,0:13:25.55,0:13:28.72,Default,,0,0,0,,Сол жігіттер... неге олар кестені сақтамайды?
Dialogue: 0,0:13:29.55,0:13:30.97,Default,,0,0,0,,Осы уақытқа дейін
Dialogue: 0,0:13:31.22,0:13:34.64,Default,,0,0,0,,Бұл балалар Бэйді жақсы көреді.
Dialogue: 0,0:13:34.73,0:13:35.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:36.27,0:13:40.36,Default,,0,0,0,,Бүгін кешке екінші көмек сұрайтын балалар көп болатын сияқты.
Dialogue: 0,0:13:41.36,0:13:42.78,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:13:43.48,0:13:46.65,Default,,0,0,0,,Еуропа лигасы ақыры басталады
Dialogue: 0,0:13:46.74,0:13:50.49,Default,,0,0,0,,Еркін Сіз капитансыз
Dialogue: 0,0:13:51.16,0:13:52.62,Default,,0,0,0,,Қалған екі ұяшық -
Dialogue: 0,0:13:52.70,0:13:56.25,Default,,0,0,0,,Біз өткен жұмыс пен бүгінгі нәтижеге қарап шешім қабылдаймыз.
Dialogue: 0,0:13:56.33,0:14:00.38,Default,,0,0,0,,Бұл сіздің екінші командаға таңдалу мүмкіндігіңіз бар дегенді білдіре ме?
Dialogue: 0,0:14:00.46,0:14:01.63,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:14:02.21,0:14:04.13,Default,,0,0,0,,Жоғарғы және екінші маңызды емес
Dialogue: 0,0:14:04.21,0:14:08.01,Default,,0,0,0,,(Күту дауысы)
Dialogue: 0,0:14:08.30,0:14:11.26,Default,,0,0,0,,Жарайды! Мен міндетті түрде таңдаймын
Dialogue: 0,0:14:18.52,0:14:19.90,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:14:20.15,0:14:22.65,Default,,0,0,0,,Келесі! Аои Барт және Стэн Гамбург
Dialogue: 0,0:14:22.94,0:14:25.15,Default,,0,0,0,,Сәлем! Стэнге барайық
Dialogue: 0,0:14:25.23,0:14:28.24,Default,,0,0,0,,Хе! Мәңгілікке алданып қалмаңыз
Dialogue: 0,0:14:28.86,0:14:30.16,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:14:31.20,0:14:33.45,Default,,0,0,0,,Мен сенен ешқашан жеңілмеймін
Dialogue: 0,0:14:33.66,0:14:35.95,Default,,0,0,0,,Тіпті мен міндетті түрде жеңемін!
Dialogue: 0,0:14:36.04,0:14:37.96,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:14:38.29,0:14:40.92,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:41.79,0:14:43.96,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:48.63,0:14:50.43,Default,,0,0,0,,Жақсы! Орталықты алыңыз!
Dialogue: 0,0:14:52.47,0:14:54.35,Default,,0,0,0,,Бар, Валькири!
Dialogue: 0,0:15:00.64,0:15:02.40,Default,,0,0,0,,Бар, жүр!
Dialogue: 0,0:15:02.48,0:15:05.77,Default,,0,0,0,,Мұндай оғаш шабуыл менің Бейімге әсер ете ме?
Dialogue: 0,0:15:06.69,0:15:09.78,Default,,0,0,0,,BC Sol-ның топ командасын төмендетпеңіз!
Dialogue: 0,0:15:11.99,0:15:13.74,Default,,0,0,0,,Уау! Валькирия!
Dialogue: 0,0:15:16.99,0:15:20.66,Default,,0,0,0,,Стэн Гамбургке 1 ұпай!
Dialogue: 0,0:15:20.96,0:15:23.04,Default,,0,0,0,,Хахаха, қалайсың Барто?
Dialogue: 0,0:15:23.33,0:15:25.79,Default,,0,0,0,,Бұлай етпе, Стэн!
Dialogue: 0,0:15:26.13,0:15:28.84,Default,,0,0,0,,Не? Неге күлесің?
Dialogue: 0,0:15:29.92,0:15:31.26,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:15:32.22,0:15:33.68,Default,,0,0,0,,Келесі жолы мен жеңемін
Dialogue: 0,0:15:34.93,0:15:36.56,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:15:37.22,0:15:39.98,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:40.43,0:15:42.77,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:47.69,0:15:50.28,Default,,0,0,0,,Жақсы! Бұл тағы да тамаша позиция
Dialogue: 0,0:15:50.86,0:15:53.28,Default,,0,0,0,,(Үдеттеуші айналу дыбысы)
Dialogue: 0,0:15:53.95,0:15:55.78,Default,,0,0,0,,Соқпаса мағынасыз.
Dialogue: 0,0:15:57.83,0:15:59.24,Default,,0,0,0,,Жақсы, Валькири!
Dialogue: 0,0:16:02.92,0:16:03.83,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:16:04.21,0:16:06.38,Default,,0,0,0,,Иә, бұл қозғалыс.
Dialogue: 0,0:16:08.30,0:16:11.67,Default,,0,0,0,,Бұл шықты! Бұл туралы Балто айтты.
Dialogue: 0,0:16:11.76,0:16:12.63,Default,,0,0,0,,Керемет!
Dialogue: 0,0:16:12.72,0:16:16.14,Default,,0,0,0,,Әрқашан зорлық-зомбылық көрсететін Валькири мүлдем басқа!
Dialogue: 0,0:16:17.55,0:16:18.97,Default,,0,0,0,,Жүр!
Dialogue: 0,0:16:19.89,0:16:21.23,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:16:21.64,0:16:22.98,Default,,0,0,0,,Қазір! Ах...
Dialogue: 0,0:16:23.85,0:16:27.44,Default,,0,0,0,,Аои Бартоның 2-1 жеңісімен аяқталды
Dialogue: 0,0:16:27.90,0:16:29.23,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:16:29.57,0:16:32.61,Default,,0,0,0,,Валькири О, бұл керемет
Dialogue: 0,0:16:32.70,0:16:35.03,Default,,0,0,0,,Ауа-райына күле берме!
Dialogue: 0,0:16:35.11,0:16:35.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:36.20,0:16:38.78,Default,,0,0,0,,Сендегі мұндай нәрсе мені ренжітеді!
Dialogue: 0,0:16:38.95,0:16:39.99,Default,,0,0,0,,Бакуго-кунға қарсы қандай жоспары барын сұрамақ едім.
Dialogue: 0,0:16:40.08,0:16:40.95,Default,,0,0,0,,Stan…
Dialogue: 0,0:16:42.54,0:16:44.25,Default,,0,0,0,,Уайымдама, Балто
Dialogue: 0,0:16:44.96,0:16:46.29,Default,,0,0,0,,Кумичо
Dialogue: 0,0:16:46.83,0:16:48.21,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:16:48.42,0:16:51.55,Default,,0,0,0,,Келесі! Рантаро Кияма және Сиско Карлайл
Dialogue: 0,0:16:51.63,0:16:52.63,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:16:52.84,0:16:55.34,Default,,0,0,0,,Мен сенімен шайқасты күттім!
Dialogue: 0,0:16:55.55,0:16:58.18,Default,,0,0,0,,Ха! Тағы да нокдаунға түскіңіз келе ме?
Dialogue: 0,0:16:58.60,0:17:00.47,Default,,0,0,0,,Сіз маған айтасыз.
Dialogue: 0,0:17:00.56,0:17:02.93,Default,,0,0,0,,Мен саған Кумичо-саманың өсиетін көрсетемін!
Dialogue: 0,0:17:03.31,0:17:05.44,Default,,0,0,0,,Жүр, көрсетейін.
Dialogue: 0,0:17:05.52,0:17:07.60,Default,,0,0,0,,Кумичо, қолыңнан келгеннің бәрін істе
Dialogue: 0,0:17:07.69,0:17:10.07,Default,,0,0,0,,Маған қалдырыңыз! мынаны қараңыз
Dialogue: 0,0:17:10.15,0:17:12.23,Default,,0,0,0,,Жаңа тұтқа
Dialogue: 0,0:17:12.32,0:17:13.57,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:17:13.65,0:17:16.70,Default,,0,0,0,,Бұл ұстағыш өте керемет!
Dialogue: 0,0:17:16.78,0:17:18.03,Default,,0,0,0,,О!
Dialogue: 0,0:17:18.12,0:17:19.83,Default,,0,0,0,,Хехе, солай ма?
Dialogue: 0,0:17:19.91,0:17:23.37,Default,,0,0,0,,Мен Cisco-ны осы қолмен жеңемін!
Dialogue: 0,0:17:23.70,0:17:28.21,Default,,0,0,0,,Хе! Сіз мені ұстағаныңызды өзгерту арқылы жеңе аласыз деп ойлайсыз ба?
Dialogue: 0,0:17:28.50,0:17:29.96,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:17:31.92,0:17:33.17,Default,,0,0,0,,Кумичо позициясы
Dialogue: 0,0:17:33.26,0:17:34.76,Default,,0,0,0,,Әдеттегіден өзгеше
Dialogue: 0,0:17:35.76,0:17:37.01,Default,,0,0,0,,Бұл ақылсыз!
Dialogue: 0,0:17:37.22,0:17:38.97,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:39.34,0:17:42.35,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:42.97,0:17:45.23,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:45.31,0:17:46.27,Default,,0,0,0,,Жылайды!
Dialogue: 0,0:17:46.44,0:17:48.65,Default,,0,0,0,,(қанаттың дыбысы)
Dialogue: 0,0:17:51.32,0:17:53.48,Default,,0,0,0,,Бұл менің төзімділік шабуылым.
Dialogue: 0,0:17:55.49,0:17:57.82,Default,,0,0,0,,Ха! Төзімділік дегеніміз не?
Dialogue: 0,0:17:57.91,0:17:59.32,Default,,0,0,0,,Ештеңе өзгерген жоқ
Dialogue: 0,0:17:59.57,0:18:02.58,Default,,0,0,0,,Жоқ, бұл дұрыс емес. Бұл мүлдем басқа.
Dialogue: 0,0:18:02.66,0:18:03.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:03.66,0:18:05.54,Default,,0,0,0,,Керемет айналу күші
Dialogue: 0,0:18:05.87,0:18:07.83,Default,,0,0,0,,Бәлкім, бұл ұстағандықтан шығар.
Dialogue: 0,0:18:07.92,0:18:10.04,Default,,0,0,0,,Керемет Кумичо
Dialogue: 0,0:18:13.34,0:18:14.80,Default,,0,0,0,,(жалынның дыбысы)
Dialogue: 0,0:18:15.30,0:18:18.09,Default,,0,0,0,,Жаңа Рагнарук аймағы!
Dialogue: 0,0:18:19.30,0:18:20.80,Default,,0,0,0,,Цк, жолдан кет!
Dialogue: 0,0:18:23.72,0:18:26.64,Default,,0,0,0,,Егер бұл шыдамды шайқас болса, Рагнарук жеңілмейді.
Dialogue: 0,0:18:27.06,0:18:29.44,Default,,0,0,0,,Сіз ең жақсысыз. Шайтанды құрт!
Dialogue: 0,0:18:32.86,0:18:34.27,Default,,0,0,0,,Роликтің дрейфі!
Dialogue: 0,0:18:34.44,0:18:35.98,Default,,0,0,0,,(роликтің жерге тиген дыбысы)
Dialogue: 0,0:18:37.61,0:18:41.07,Default,,0,0,0,,Сәлем! Оны доғар, Шайтан!
Dialogue: 0,0:18:47.50,0:18:48.71,Default,,0,0,0,,(үру)
Dialogue: 0,0:18:50.87,0:18:53.13,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:18:53.21,0:18:56.55,Default,,0,0,0,,Аузыңды жап, Рагнарук!
Dialogue: 0,0:18:56.63,0:18:58.42,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:18:59.63,0:19:01.01,Default,,0,0,0,,(үру)
Dialogue: 0,0:19:03.76,0:19:04.93,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:19:05.22,0:19:07.27,Default,,0,0,0,,Не болды!
Dialogue: 0,0:19:08.27,0:19:12.35,Default,,0,0,0,,Рантаро Кияманың 2-0 жеңісімен аяқталды
Dialogue: 0,0:19:13.27,0:19:15.82,Default,,0,0,0,,Мен қарызымды толығымен өтедім.
Dialogue: 0,0:19:15.90,0:19:16.90,Default,,0,0,0,,Tsk
Dialogue: 0,0:19:19.49,0:19:22.24,Default,,0,0,0,,Кумичо: Керемет төзімділік!
Dialogue: 0,0:19:22.53,0:19:23.49,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:23.57,0:19:26.12,Default,,0,0,0,,Бұл Блейз Рагнаруктың күші.
Dialogue: 0,0:19:26.24,0:19:29.12,Default,,0,0,0,,Мен айналып жүрдім.
Dialogue: 0,0:19:29.20,0:19:33.42,Default,,0,0,0,,Әй, осы ұстағанымның арқасында қолым дірілдеп қалмайды.
Dialogue: 0,0:19:33.50,0:19:34.88,Default,,0,0,0,,Хуаншан
Dialogue: 0,0:19:35.42,0:19:38.05,Default,,0,0,0,,Жақсы болғаны мені жақсы сезінбейді.
Dialogue: 0,0:19:38.42,0:19:39.92,Default,,0,0,0,,Менің әлі де күшім жетпейді.
Dialogue: 0,0:19:40.09,0:19:41.26,Default,,0,0,0,,О... Жарайды.
Dialogue: 0,0:19:41.68,0:19:45.76,Default,,0,0,0,,Бұл ұстауды меңгеруге жаттықпаңыз.
Dialogue: 0,0:19:48.18,0:19:49.35,Default,,0,0,0,,Қазір...
Dialogue: 0,0:19:49.43,0:19:51.52,Default,,0,0,0,,Бұл маған оны пайдалануға рұқсат бересіз бе?
Dialogue: 0,0:19:52.31,0:19:54.73,Default,,0,0,0,,Иә! Рахмет Тора-сан
Dialogue: 0,0:19:56.77,0:19:58.07,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:58.65,0:20:01.15,Default,,0,0,0,,Мен неге мұндаймын...
Dialogue: 0,0:20:01.24,0:20:02.95,Default,,0,0,0,,Cisco Carlyle
Dialogue: 0,0:20:03.03,0:20:03.95,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:04.28,0:20:05.53,Default,,0,0,0,,Менің көңілім қалды.
Dialogue: 0,0:20:05.78,0:20:08.24,Default,,0,0,0,,Мен, әрине, сені аман қалады деп ойладым.
Dialogue: 0,0:20:08.62,0:20:10.00,Default,,0,0,0,,Саған әдемі опасыздық жасалды.
Dialogue: 0,0:20:10.58,0:20:11.33,Default,,0,0,0,,Тс!
Dialogue: 0,0:20:11.41,0:20:13.42,Default,,0,0,0,,Тым жеңіл қабылдамаңыз
Dialogue: 0,0:20:13.54,0:20:14.42,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:20:19.05,0:20:19.80,Default,,0,0,0,,Иә
Dialogue: 0,0:20:21.55,0:20:25.64,Default,,0,0,0,,Енді біз Еуропа лигасының ашылу ойынына арналған Блейдерлерді жариялаймыз.
Dialogue: 0,0:20:26.05,0:20:27.47,Default,,0,0,0,,Тегін Де Ла Хойя
Dialogue: 0,0:20:27.55,0:20:30.27,Default,,0,0,0,,Барто Аои Рантаро Кияма
Dialogue: 0,0:20:30.35,0:20:31.39,Default,,0,0,0,,Бұл 3 адам.
Dialogue: 0,0:20:31.60,0:20:32.77,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:20:32.85,0:20:33.85,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:20:35.19,0:20:36.81,Default,,0,0,0,,Барто...
Dialogue: 0,0:20:37.48,0:20:39.07,Default,,0,0,0,,Бұл екеуі тағы да?
Dialogue: 0,0:20:39.32,0:20:41.15,Default,,0,0,0,,Келесі жолы мен сізге соққы беремін.
Dialogue: 0,0:20:41.61,0:20:43.95,Default,,0,0,0,,Менің ойымша, бұл жолы көмектесу мүмкін емес.
Dialogue: 0,0:20:44.78,0:20:46.20,Default,,0,0,0,,Cisco Carlyle
Dialogue: 0,0:20:46.82,0:20:49.70,Default,,0,0,0,,Сіз кез келген уақытта қосалқы мүше ретінде шыға аласыз.
Dialogue: 0,0:20:49.79,0:20:51.45,Default,,0,0,0,,Артық дайындалмаңыз
Dialogue: 0,0:20:51.54,0:20:52.25,Default,,0,0,0,,Tsk
Dialogue: 0,0:20:53.50,0:20:56.38,Default,,0,0,0,,Мен Еуропа лигасын тағы да түсіндіремін.
Dialogue: 0,0:20:56.88,0:21:01.96,Default,,0,0,0,,Әр елдің клубтық командалары WBBA ұпайлары үшін жарысады.
Dialogue: 0,0:21:02.88,0:21:04.09,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:21:04.17,0:21:06.34,Default,,0,0,0,,Бұл әлем сияқты сезіледі.
Dialogue: 0,0:21:06.43,0:21:09.22,Default,,0,0,0,,Әй, біз қазір қайдамыз?
Dialogue: 0,0:21:09.55,0:21:12.93,Default,,0,0,0,,Білмей мұнда қалай келдің?
Dialogue: 0,0:21:13.23,0:21:16.06,Default,,0,0,0,,Еуропа лигасында ұпай жинауым керек
Dialogue: 0,0:21:16.14,0:21:18.69,Default,,0,0,0,,Сіз келесі Әлемдік лигаға қатыса алмайсыз.
Dialogue: 0,0:21:18.77,0:21:20.73,Default,,0,0,0,,Барлық командалар мықты.
Dialogue: 0,0:21:20.82,0:21:22.15,Default,,0,0,0,,Жақсылап дайындалыңыз
Dialogue: 0,0:21:22.23,0:21:23.65,Default,,0,0,0,,Оу!
Dialogue: 0,0:21:23.74,0:21:27.45,Default,,0,0,0,,Бірінші қарсылас неміс Топ Ванд.
Dialogue: 0,0:21:27.53,0:21:29.66,Default,,0,0,0,,Мен әрқашан рейтингтің басындамын.
Dialogue: 0,0:21:30.24,0:21:33.04,Default,,0,0,0,,Балалар, міндетті түрде жеңіңдер!
Dialogue: 0,0:21:33.41,0:21:35.75,Default,,0,0,0,,Кумичо Көңіліңізді түсірмеңіз!
Dialogue: 0,0:21:35.87,0:21:38.08,Default,,0,0,0,,Ал, мен оны асыға күтемін!
Dialogue: 0,0:21:39.00,0:21:40.71,Default,,0,0,0,,Хуаншан, отыр.
Dialogue: 0,0:21:40.79,0:21:41.46,Default,,0,0,0,,О
Dialogue: 0,0:21:41.88,0:21:44.30,Default,,0,0,0,,Бірінші жарыс Эль Сантода өтеді.
Dialogue: 0,0:21:46.80,0:21:50.18,Default,,0,0,0,,Сіз Эль Сантода шайқаса аласыз.
Dialogue: 0,0:21:50.26,0:21:53.72,Default,,0,0,0,,Еуропа лигасы Валькиримен жабайы болайық
Dialogue: 0,0:21:56.02,0:21:58.44,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.52,0:22:01.86,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:01.94,0:22:04.82,Default,,0,0,0,,Шығанақ бұлшық еттерін жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.90,0:22:06.99,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.07,0:22:10.66,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.74,0:22:14.37,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.45,0:22:16.25,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.33,0:22:17.96,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.04,0:22:19.88,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:19.96,0:22:21.54,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.63,0:22:23.59,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.67,0:22:26.09,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.17,0:22:29.09,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.18,0:22:32.80,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.89,0:22:36.56,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.64,0:22:38.23,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.31,0:22:41.65,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.73,0:22:43.98,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.07,0:22:47.57,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.65,0:22:51.20,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.28,0:22:53.16,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.24,0:22:55.04,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:55.12,0:22:58.50,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.58,0:23:00.71,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.79,0:23:03.59,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.67,0:23:05.92,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:06.09,0:23:09.88,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.97,0:23:13.55,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.64,0:23:17.06,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.14,0:23:20.56,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.64,0:23:22.27,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.35,0:23:25.02,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.35,0:23:25.02,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:25.02,0:23:25.57,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.44,0:23:30.20,Default,,0,0,0,,Мен кереметмін. Мен қызықты адамдармен достасамын.
Dialogue: 0,0:23:30.28,0:23:32.03,Default,,0,0,0,,Оны Куза деп атайды...
Dialogue: 0,0:23:32.11,0:23:35.41,Default,,0,0,0,,Ол тотықұстармен жақсы қарым-қатынас жасайды.
Dialogue: 0,0:23:35.49,0:23:37.08,Default,,0,0,0,,Маған да айтыңызшы!
Dialogue: 0,0:23:37.16,0:23:39.58,Default,,0,0,0,,Жардан кейін келесі қадам!
Dialogue: 0,0:23:40.62,0:23:42.83,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.00,0:23:45.25,Default,,0,0,0,,Ашылу! Еуропа лигасы!
Dialogue: 0,0:23:45.50,0:23:49.17,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:50.67,0:23:56.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory