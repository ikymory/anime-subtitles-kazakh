Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.87,0:00:07.21,Default,,0,0,0,,wbba.Әлемдік лига!
Dialogue: 0,0:00:07.67,0:00:13.01,Default,,0,0,0,,Әр лигада жеңіске жеткен клубтар әлемнің шыңына шығу үшін күреседі.
Dialogue: 0,0:00:13.09,0:00:16.51,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз!
Dialogue: 0,0:00:17.05,0:00:20.31,Default,,0,0,0,,Жауынгерлеріңді өртеп, шектен шығып кет!
Dialogue: 0,0:00:21.06,0:00:25.15,Default,,0,0,0,,Жандардың қызу шайқасы әлемді толғандырады
Dialogue: 0,0:00:25.90,0:00:29.27,Default,,0,0,0,,Даңқты алатын сенсің!
Dialogue: 0,0:00:31.74,0:00:35.74,Default,,0,0,0,,Финал үшінші ойын Cisco шынымен жақсы жұмыс жасады.
Dialogue: 0,0:00:35.82,0:00:39.62,Default,,0,0,0,,Ақырында, бұл! Фафнирді төгіп тастаңыз! ?
Dialogue: 0,0:00:39.70,0:00:42.33,Default,,0,0,0,,Осылай аяқталады деп ойлайсың ба?
Dialogue: 0,0:00:42.41,0:00:45.92,Default,,0,0,0,,Мен мұны бітіремін, Жыла Шайтан
Dialogue: 0,0:00:46.58,0:00:48.84,Default,,0,0,0,,Фафнирді төгіп алайық
Dialogue: 0,0:00:49.46,0:00:53.72,Default,,0,0,0,,Бірақ бұл баяу жарылыс болды және мен тегін өлтірілдім.
Dialogue: 0,0:00:54.67,0:00:55.68,Default,,0,0,0,,На
Dialogue: 0,0:00:56.05,0:00:57.68,Default,,0,0,0,,Ол… ол тұрып кетті!
Dialogue: 0,0:00:58.30,0:00:59.93,Default,,0,0,0,,Бұл тегін бе?
Dialogue: 0,0:01:02.89,0:01:04.31,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:01:04.39,0:01:06.06,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:01:08.90,0:01:10.52,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:01:11.19,0:01:14.94,Default,,0,0,0,,4-ойын Мен Джошуаны жеңдім
Dialogue: 0,0:01:15.74,0:01:18.74,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:01:19.24,0:01:20.83,Default,,0,0,0,,Барлығыңыз өтінемін
Dialogue: 0,0:01:21.70,0:01:23.41,Default,,0,0,0,,Не болды, Cisco?
Dialogue: 0,0:01:24.08,0:01:26.62,Default,,0,0,0,,Соңғы шайқас Маған рұқсат етіңіз
Dialogue: 0,0:01:27.42,0:01:29.08,Default,,0,0,0,,Келесіде Джошуа пайда болады
Dialogue: 0,0:01:29.96,0:01:30.92,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:01:31.29,0:01:34.55,Default,,0,0,0,,Бұл капитанның шешімі. Мен шағымданбаймын.
Dialogue: 0,0:01:35.88,0:01:39.05,Default,,0,0,0,,Ал бесінші ойын Cisco және Джошуа болды.
Dialogue: 0,0:01:39.51,0:01:43.18,Default,,0,0,0,,Жеңімпаз - менің BC Sol!
Dialogue: 0,0:01:43.47,0:01:45.27,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:01:47.19,0:01:50.23,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:01:50.77,0:01:53.36,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:01:55.44,0:01:58.24,Default,,0,0,0,,♪~
Dialogue: 0,0:01:58.32,0:02:00.74,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:00.82,0:02:03.28,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:03.37,0:02:05.66,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:05.75,0:02:08.25,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:08.33,0:02:09.83,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:02:09.92,0:02:14.13,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:15.09,0:02:19.84,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:19.93,0:02:24.26,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:24.93,0:02:29.69,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:29.77,0:02:34.69,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:34.77,0:02:39.70,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:39.78,0:02:44.58,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:44.66,0:02:48.08,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:48.16,0:02:49.62,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:49.71,0:02:52.29,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:52.38,0:02:54.67,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:54.75,0:02:56.84,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:56.92,0:02:58.13,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:58.21,0:02:59.80,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:59.88,0:03:02.30,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:03:02.39,0:03:08.43,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:03:08.52,0:03:12.90,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:03:12.98,0:03:15.65,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:15.73,0:03:17.94,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:18.03,0:03:20.53,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:20.61,0:03:24.20,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:26.58,0:03:28.91,Default,,0,0,0,,Біздің финалдық матч!
Dialogue: 0,0:03:34.58,0:03:36.71,Default,,0,0,0,,Мен бұл шайқасқа қатысамын!
Dialogue: 0,0:03:37.38,0:03:40.22,Default,,0,0,0,,Сен Ешуаның қайта тірілуіне арналған трамплинсің.
Dialogue: 0,0:03:40.30,0:03:42.93,Default,,0,0,0,,Шайтан мен Генийдің екеуі де қорғаныс түрі!
Dialogue: 0,0:03:43.01,0:03:45.43,Default,,0,0,0,,Қай қорғаныс жеңеді!
Dialogue: 0,0:03:45.68,0:03:48.85,Default,,0,0,0,,Қорғаныс ойыны қызықты!
Dialogue: 0,0:03:48.93,0:03:52.35,Default,,0,0,0,,Көңілді ойындар өткізу жақсы, бірақ маған көбірек Cisco беріңізші.
Dialogue: 0,0:03:52.44,0:03:53.94,Default,,0,0,0,,Ах... Жарайды!
Dialogue: 0,0:03:54.02,0:03:54.98,Default,,0,0,0,,Сейя!
Dialogue: 0,0:03:55.10,0:03:57.57,Default,,0,0,0,,Cisco! Сәттілік~
Dialogue: 0,0:03:57.65,0:04:00.49,Default,,0,0,0,,Бұл өте шулы, тыныш қарап тұрыңыз!
Dialogue: 0,0:04:02.78,0:04:04.45,Default,,0,0,0,,Еркін қараңыз
Dialogue: 0,0:04:08.79,0:04:10.04,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:04:10.12,0:04:11.25,Default,,0,0,0,,(Ұрыс тіркеу дыбысы)
Dialogue: 0,0:04:11.37,0:04:13.54,Default,,0,0,0,,Сіз иесіне қарсы шығасыз ба?
Dialogue: 0,0:04:14.08,0:04:16.96,Default,,0,0,0,,Чемпиондықты саған берсем, шағымданбайсың, солай ма?
Dialogue: 0,0:04:19.05,0:04:22.17,Default,,0,0,0,,Джошуа жеңеді, тамаша!
Dialogue: 0,0:04:22.26,0:04:24.34,Default,,0,0,0,,Циклон қабырғасы!
Dialogue: 0,0:04:24.97,0:04:27.60,Default,,0,0,0,,Гений орталықты бірінші алды!
Dialogue: 0,0:04:27.93,0:04:30.68,Default,,0,0,0,,Орталықты қайтар, Шайтан!
Dialogue: 0,0:04:30.77,0:04:33.77,Default,,0,0,0,,Содан кейін Шайтан келеді Бірақ!
Dialogue: 0,0:04:33.85,0:04:38.27,Default,,0,0,0,,Генийдің циклон қабырғасы Шайтанның шабуылдарына тойтарыс береді!
Dialogue: 0,0:04:38.73,0:04:41.73,Default,,0,0,0,,Юның шабуылдары Генийге ешқандай әсер етпейді!
Dialogue: 0,0:04:41.82,0:04:42.57,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:04:42.90,0:04:46.07,Default,,0,0,0,,Неліктен Шайтанның шабуылдары Генийге әсер етпейді?
Dialogue: 0,0:04:46.70,0:04:50.95,Default,,0,0,0,,Гений циклон қабырғасымен қабаттың сыртын көтерді.
Dialogue: 0,0:04:51.37,0:04:55.67,Default,,0,0,0,,Өйткені шайтанның шабуылы шығанақ осіне жақын.
Dialogue: 0,0:04:55.75,0:04:58.96,Default,,0,0,0,,Бұл оның оське жақынырақ болғандықтан, оның дірілдеу ықтималдығы аз дегенді білдіре ме?
Dialogue: 0,0:04:59.04,0:05:00.55,Default,,0,0,0,,Осымен
Dialogue: 0,0:05:00.75,0:05:03.30,Default,,0,0,0,,Данышпанның қорғанысы құламайды
Dialogue: 0,0:05:03.84,0:05:05.97,Default,,0,0,0,,Орталықты қандай да бір жолмен қалпына келтіріңіз
Dialogue: 0,0:05:06.05,0:05:07.51,Default,,0,0,0,,Ортаға шығыңыз! Cisco!
Dialogue: 0,0:05:08.43,0:05:10.01,Default,,0,0,0,,Ең маңызды сәт әлі алда
Dialogue: 0,0:05:10.10,0:05:12.10,Default,,0,0,0,,Циклондық цикл!
Dialogue: 0,0:05:12.56,0:05:13.64,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:13.73,0:05:17.48,Default,,0,0,0,,О, құдай-ау, Шайтан Генийді қозғады.
Dialogue: 0,0:05:17.56,0:05:21.40,Default,,0,0,0,,Бірақ күзетші жүргізушімен тез сауығып кетесіз!
Dialogue: 0,0:05:21.48,0:05:24.65,Default,,0,0,0,,Қайтадан циклондық цикл!
Dialogue: 0,0:05:24.94,0:05:26.82,Default,,0,0,0,,Циклондық есептегіш
Dialogue: 0,0:05:27.28,0:05:29.74,Default,,0,0,0,,Олардың екі ерекше қозғалысы да соқтығысады!
Dialogue: 0,0:05:29.82,0:05:31.78,Default,,0,0,0,,Жеңіске жет! Шайтан жылайды
Dialogue: 0,0:05:32.16,0:05:34.54,Default,,0,0,0,,Көру уақыты! Бластоген
Dialogue: 0,0:05:34.62,0:05:37.42,Default,,0,0,0,,Бір-біріңе көнбеңдер! таңқаларлық таңқаларлық
Dialogue: 0,0:05:37.50,0:05:39.46,Default,,0,0,0,,Қандай қиын шайқас!
Dialogue: 0,0:05:40.34,0:05:42.42,Default,,0,0,0,,Ууууууууууу
Dialogue: 0,0:05:43.13,0:05:45.09,Default,,0,0,0,,Уф! Ай!
Dialogue: 0,0:05:45.38,0:05:48.97,Default,,0,0,0,,Жарыста кім жеңеді?
Dialogue: 0,0:05:49.34,0:05:51.18,Default,,0,0,0,,Көңілді ~
Dialogue: 0,0:05:59.94,0:06:02.57,Default,,0,0,0,,Blast Genius Spin Finish
Dialogue: 0,0:06:02.90,0:06:04.90,Default,,0,0,0,,1-ден 0-ге дейінгі нүктелер
Dialogue: 0,0:06:05.65,0:06:09.78,Default,,0,0,0,,Бірінші шайқаста Джошуа Бун жеңіске жетті.
Dialogue: 0,0:06:10.11,0:06:13.20,Default,,0,0,0,,Мен Джошуаны бірінші рет көріп тұрмын.
Dialogue: 0,0:06:13.53,0:06:15.33,Default,,0,0,0,,Бұл тамаша болды, Cisco.
Dialogue: 0,0:06:15.41,0:06:16.75,Default,,0,0,0,,Тағы біраз!
Dialogue: 0,0:06:17.25,0:06:20.46,Default,,0,0,0,,Алдымен орталықты алу үшін жұмыс істеді.
Dialogue: 0,0:06:20.54,0:06:21.96,Default,,0,0,0,,Фофофу
Dialogue: 0,0:06:22.29,0:06:25.38,Default,,0,0,0,,Ата! Бұл күлетін уақыт емес.
Dialogue: 0,0:06:25.71,0:06:27.30,Default,,0,0,0,,Cisco-ға қараңыз
Dialogue: 0,0:06:27.38,0:06:28.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:28.88,0:06:30.09,Default,,0,0,0,,Иә
Dialogue: 0,0:06:30.47,0:06:32.76,Default,,0,0,0,,Cisco күліп тұр
Dialogue: 0,0:06:33.26,0:06:35.22,Default,,0,0,0,,Сен Кристі түсінбейсің бе?
Dialogue: 0,0:06:35.56,0:06:36.39,Default,,0,0,0,,Иә
Dialogue: 0,0:06:36.85,0:06:38.68,Default,,0,0,0,,Сол қыз шайқасы...
Dialogue: 0,0:06:40.19,0:06:42.02,Default,,0,0,0,,Уайымдамаңыздар, балалар!
Dialogue: 0,0:06:42.11,0:06:44.57,Default,,0,0,0,,Бар болғаны 1 ұпай алынды.
Dialogue: 0,0:06:44.65,0:06:46.36,Default,,0,0,0,,Мен оны келесі жолы міндетті түрде қайтарамын!
Dialogue: 0,0:06:46.86,0:06:49.11,Default,,0,0,0,,Бұл алдау оқиғасы ма?
Dialogue: 0,0:06:49.20,0:06:52.91,Default,,0,0,0,,Хмм, әдеттегі Cisco-дан өзгеше.
Dialogue: 0,0:06:52.99,0:06:54.33,Default,,0,0,0,,Чигауна~
Dialogue: 0,0:06:55.12,0:06:56.33,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:56.58,0:06:59.12,Default,,0,0,0,,Бірақ бұл жаман емес, осындай нәрсе
Dialogue: 0,0:06:59.54,0:07:00.83,Default,,0,0,0,,Cisco, сіз өзгердіңіз.
Dialogue: 0,0:07:01.33,0:07:03.33,Default,,0,0,0,,Кимико кенет өзгерді
Dialogue: 0,0:07:03.75,0:07:07.92,Default,,0,0,0,,Cisco байсалды, ол сенімді.
Dialogue: 0,0:07:11.68,0:07:15.35,Default,,0,0,0,,Мені осы ойынға жібергеніңіз үшін қандай сезімде болдыңыз?
Dialogue: 0,0:07:15.43,0:07:17.39,Default,,0,0,0,,Мен мұны байыппен қабылдаймын.
Dialogue: 0,0:07:20.64,0:07:23.44,Default,,0,0,0,,Мен өзімді мұндай сезінемін деп ешқашан ойламаппын.
Dialogue: 0,0:07:24.65,0:07:28.82,Default,,0,0,0,,Хахахаха, бұл күлкілі.
Dialogue: 0,0:07:30.95,0:07:34.16,Default,,0,0,0,,Барт, мен сенен рухыңды беруіңді сұраймын!
Dialogue: 0,0:07:36.83,0:07:37.99,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:39.08,0:07:41.12,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:07:41.29,0:07:43.46,Default,,0,0,0,,Мен Валькири жақтауын қойдым.
Dialogue: 0,0:07:48.50,0:07:50.97,Default,,0,0,0,,Сіз нені айтасыз? (Карл) Дойукото?
Dialogue: 0,0:07:51.22,0:07:54.22,Default,,0,0,0,,Vortex кадры шабуыл күшін арттырады, бірақ...
Dialogue: 0,0:07:54.30,0:07:56.18,Default,,0,0,0,,Қорғаныс күші төмендейді
Dialogue: 0,0:07:56.93,0:08:00.31,Default,,0,0,0,,Дегенмен, Cisco-ның бірдеңе жасағысы келетіні бар.
Dialogue: 0,0:08:01.02,0:08:02.44,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:08:02.52,0:08:03.73,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:04.10,0:08:07.19,Default,,0,0,0,,Сіз айла-шарғы жасап көрсеңіз де, Джошуаға жете алмайсыз.
Dialogue: 0,0:08:07.40,0:08:10.19,Default,,0,0,0,,Енді Дүниежүзілік лиганың финалына...
Dialogue: 0,0:08:10.28,0:08:13.49,Default,,0,0,0,,Маған соңғы жауыз ретінде қызмет етуге рұқсат етіңіз.
Dialogue: 0,0:08:14.16,0:08:15.49,Default,,0,0,0,,Сол қылмыскер... қайтыс болды ма?
Dialogue: 0,0:08:15.99,0:08:18.24,Default,,0,0,0,,Батырдың бастығын ұру
Dialogue: 0,0:08:18.33,0:08:21.75,Default,,0,0,0,,Дүние жүзіндегі Джошуаның жанкүйерлері сізді қатты жек көреді.
Dialogue: 0,0:08:22.08,0:08:23.33,Default,,0,0,0,,№~
Dialogue: 0,0:08:23.41,0:08:26.58,Default,,0,0,0,,Сіз жанкүйерлердің қаншалықты қорқынышты екенін білмейсіз бе?
Dialogue: 0,0:08:26.83,0:08:30.38,Default,,0,0,0,,Бірақ Уайымдамаңыз, өйткені ол болмайды!
Dialogue: 0,0:08:30.80,0:08:32.92,Default,,0,0,0,,Зұлымдар зұлым адамдар ретінде -
Dialogue: 0,0:08:33.47,0:08:36.34,Default,,0,0,0,,Мен сізді қайғылы жағдайға душар етемін.
Dialogue: 0,0:08:38.51,0:08:40.01,Default,,0,0,0,,Жақтауды кім өзгертті?
Dialogue: 0,0:08:40.10,0:08:42.85,Default,,0,0,0,,Мен бұл тек рух үшін емес екенін білемін.
Dialogue: 0,0:08:43.18,0:08:45.27,Default,,0,0,0,,Үлкен 5-тен күткендей.
Dialogue: 0,0:08:45.98,0:08:50.73,Default,,0,0,0,,Сіз менің стратегиямды оқыған боларсыз, бірақ мен бар күшімді саламын!
Dialogue: 0,0:08:50.82,0:08:52.07,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:08:52.19,0:08:54.11,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:08:56.57,0:08:59.91,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:59.99,0:09:02.20,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:02.37,0:09:03.33,Default,,0,0,0,,Жылайды!
Dialogue: 0,0:09:03.54,0:09:06.58,Default,,0,0,0,,Уау~ Не? Не? Не?
Dialogue: 0,0:09:07.92,0:09:09.13,Default,,0,0,0,,Айқайлау
Dialogue: 0,0:09:09.54,0:09:11.42,Default,,0,0,0,,Кенеттен Шайтан шабуыл жасайды
Dialogue: 0,0:09:12.88,0:09:14.09,Default,,0,0,0,,Тағы бір ату!
Dialogue: 0,0:09:15.76,0:09:19.18,Default,,0,0,0,,Мен мұны Валькиридің кадрымен мақсат еттім!
Dialogue: 0,0:09:19.26,0:09:21.10,Default,,0,0,0,,Асығыңызды күшейтіңіз!
Dialogue: 0,0:09:21.31,0:09:23.47,Default,,0,0,0,,Кет, Шайтан!
Dialogue: 0,0:09:23.93,0:09:27.44,Default,,0,0,0,,Blastogenius бірте-бірте сыртқа итеріледі.
Dialogue: 0,0:09:27.77,0:09:30.52,Default,,0,0,0,,Тек артық аяқтауды жалғастырыңыз.
Dialogue: 0,0:09:30.61,0:09:34.61,Default,,0,0,0,,Иә! Күте тұрыңыз, күзетші жүргізуші
Dialogue: 0,0:09:35.11,0:09:36.99,Default,,0,0,0,,Күзетші
Dialogue: 0,0:09:37.78,0:09:38.70,Default,,0,0,0,,Не!
Dialogue: 0,0:09:38.82,0:09:42.24,Default,,0,0,0,,Ой, данышпан, біз Шайтанның қууынан жалтардық!
Dialogue: 0,0:09:43.29,0:09:44.54,Default,,0,0,0,,Ах! Бұл!
Dialogue: 0,0:09:44.95,0:09:46.79,Default,,0,0,0,,Бұл шоу уақыты!
Dialogue: 0,0:09:47.54,0:09:51.46,Default,,0,0,0,,Гений шайтанның шабуылына төтеп берді. Енді кері соққы беру уақыты келді!
Dialogue: 0,0:09:53.80,0:09:55.46,Default,,0,0,0,,Сау бол, Шайтан!
Dialogue: 0,0:09:57.17,0:09:58.68,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:09:59.18,0:10:03.26,Default,,0,0,0,,Уау Уау Уау! Гений, біз Шайтанға жақындап қалдық.
Dialogue: 0,0:10:03.51,0:10:05.81,Default,,0,0,0,,Жаса! Гений!
Dialogue: 0,0:10:07.27,0:10:09.65,Default,,0,0,0,,(Түтіннің шығуы)
Dialogue: 0,0:10:19.24,0:10:22.16,Default,,0,0,0,,Уууу! Жеңдер!
Dialogue: 0,0:10:22.37,0:10:23.91,Default,,0,0,0,,Қызық!
Dialogue: 0,0:10:24.20,0:10:26.41,Default,,0,0,0,,Шайтан қабырғаға соғылады!
Dialogue: 0,0:10:26.50,0:10:30.17,Default,,0,0,0,,Джиниус одан әрі күтіп тұр.
Dialogue: 0,0:10:30.54,0:10:33.92,Default,,0,0,0,,Керемет! Аяқтаңыз! Алақай!
Dialogue: 0,0:10:34.67,0:10:36.26,Default,,0,0,0,,Әлі біткен жоқ.
Dialogue: 0,0:10:36.34,0:10:37.92,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:10:41.05,0:10:43.76,Default,,0,0,0,,Уау, Шайтан!
Dialogue: 0,0:10:45.85,0:10:48.23,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:10:51.15,0:10:53.77,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:11:04.83,0:11:06.74,Default,,0,0,0,,А... қайсысы!
Dialogue: 0,0:11:09.71,0:11:13.75,Default,,0,0,0,,Тағдырдың екінші шайқасы Үкім қандай болады?
Dialogue: 0,0:11:13.83,0:11:16.84,Default,,0,0,0,,Қайсысы!
Dialogue: 0,0:11:23.68,0:11:26.68,Default,,0,0,0,,Cry Satan: Burst Finish арқылы жеңіңіз
Dialogue: 0,0:11:27.01,0:11:30.10,Default,,0,0,0,,Демек, ойын саны 3-тен 2-ге дейін.
Dialogue: 0,0:11:30.18,0:11:34.65,Default,,0,0,0,,Әлемдік лига финалының жеңімпазы: BC Sol!
Dialogue: 0,0:11:34.73,0:11:37.15,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:37.23,0:11:40.15,Default,,0,0,0,,Ей, балалар мұны істедіңдер!
Dialogue: 0,0:11:40.49,0:11:43.24,Default,,0,0,0,,Жеңімпаз - Cisco Carlyle
Dialogue: 0,0:11:43.32,0:11:46.03,Default,,0,0,0,,Мен «Үлкен бестік» Джошуа Бунды жеңдім!
Dialogue: 0,0:11:46.12,0:11:47.41,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:11:47.49,0:11:48.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:49.08,0:11:50.04,Default,,0,0,0,,Cisco!
Dialogue: 0,0:11:50.12,0:11:51.75,Default,,0,0,0,,Ооо! Сейя!
Dialogue: 0,0:11:51.83,0:11:53.75,Default,,0,0,0,,Ой-ау, тоқтат!
Dialogue: 0,0:11:57.17,0:11:59.92,Default,,0,0,0,,Ей, сендер ауырсыңдар!
Dialogue: 0,0:12:04.59,0:12:05.76,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:05.85,0:12:06.85,Default,,0,0,0,,Э-э, не істеп жатырсыз, мырза?
Dialogue: 0,0:12:06.93,0:12:08.18,Default,,0,0,0,,Мен бұған сене алмаймын
Dialogue: 0,0:12:08.51,0:12:12.44,Default,,0,0,0,,Крис, менің арманым орындалды.
Dialogue: 0,0:12:12.73,0:12:13.64,Default,,0,0,0,,Иә
Dialogue: 0,0:12:14.44,0:12:15.60,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:12:16.44,0:12:17.52,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:12:25.99,0:12:29.95,Default,,0,0,0,,Эль Санто тамаша және керемет
Dialogue: 0,0:12:30.04,0:12:32.87,Default,,0,0,0,,Көңіл-күйдің арасында!
Dialogue: 0,0:12:32.96,0:12:38.42,Default,,0,0,0,,BC Соль Дүниежүзілік лиганы жеңіп алды!
Dialogue: 0,0:12:38.79,0:12:40.76,Default,,0,0,0,,Әлемнің шыңы
Dialogue: 0,0:12:40.84,0:12:44.13,Default,,0,0,0,,BC Соль дәл осы жерде және қазір әлемнің шыңын бағындырды!
Dialogue: 0,0:12:44.22,0:12:49.43,Default,,0,0,0,,Жеңімпаз - Испанияның BC Sol. Құттықтаймыз!
Dialogue: 0,0:12:49.68,0:12:52.68,Default,,0,0,0,,Беделді жаңғыру енді осында!
Dialogue: 0,0:12:53.35,0:12:54.60,Default,,0,0,0,,Керемет
Dialogue: 0,0:12:54.69,0:12:56.40,Default,,0,0,0,,Жақсы ойын
Dialogue: 0,0:12:56.94,0:12:58.94,Default,,0,0,0,,Барлығы сондай бақытты
Dialogue: 0,0:12:59.98,0:13:01.61,Default,,0,0,0,,Йорокондел
Dialogue: 0,0:13:01.69,0:13:03.36,Default,,0,0,0,,Ичинен аспанға апарады
Dialogue: 0,0:13:05.20,0:13:06.28,Default,,0,0,0,,♬~
Dialogue: 0,0:13:06.53,0:13:07.62,Default,,0,0,0,,Cisco!
Dialogue: 0,0:13:08.16,0:13:10.24,Default,,0,0,0,,Чо, керемет болды.
Dialogue: 0,0:13:10.66,0:13:12.41,Default,,0,0,0,,Бұл жиіркенішті дерлік!
Dialogue: 0,0:13:13.58,0:13:14.83,Default,,0,0,0,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:13:14.91,0:13:18.25,Default,,0,0,0,,Ал... бұл... не...
Dialogue: 0,0:13:18.33,0:13:22.42,Default,,0,0,0,,(қуаныш дыбыстары)
Dialogue: 0,0:13:22.59,0:13:24.01,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:13:26.09,0:13:27.89,Default,,0,0,0,,Яғни... бұл...
Dialogue: 0,0:13:28.55,0:13:29.64,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:30.18,0:13:32.97,Default,,0,0,0,,Мен ВС Солсыз жеңе алмас едім
Dialogue: 0,0:13:33.22,0:13:34.52,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:13:34.81,0:13:36.81,Default,,0,0,0,,Міне... міне, солай!
Dialogue: 0,0:13:36.89,0:13:39.10,Default,,0,0,0,,Бұл көп уақыт бұрын емес пе?
Dialogue: 0,0:13:39.23,0:13:41.36,Default,,0,0,0,,Енді айтпа.
Dialogue: 0,0:13:41.86,0:13:43.53,Default,,0,0,0,,Керемет ойнау!
Dialogue: 0,0:13:44.69,0:13:46.32,Default,,0,0,0,,Керемет!
Dialogue: 0,0:13:47.61,0:13:48.74,Default,,0,0,0,,Cisco
Dialogue: 0,0:13:49.16,0:13:50.45,Default,,0,0,0,,Cisco!
Dialogue: 0,0:13:51.45,0:13:53.04,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:53.12,0:13:55.33,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:05.21,0:14:06.72,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:06.80,0:14:10.18,Default,,0,0,0,,Қате болғанша, ол көрінбесе екен.
Dialogue: 0,0:14:10.51,0:14:14.52,Default,,0,0,0,,Жалғыз сен емес, бәріміз ұтылып қалдық.
Dialogue: 0,0:14:14.60,0:14:15.81,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:14:23.52,0:14:25.44,Default,,0,0,0,,Ааааааааа!
Dialogue: 0,0:14:26.69,0:14:31.12,Default,,0,0,0,,Ешуа, нағыз батырлар осы жерден шығады.
Dialogue: 0,0:14:31.91,0:14:33.12,Default,,0,0,0,,Қайта оралу
Dialogue: 0,0:14:41.21,0:14:45.17,Default,,0,0,0,,Тегін Сіз пайда болуыңыз керек еді.
Dialogue: 0,0:14:52.14,0:14:54.31,Default,,0,0,0,,Сіз Bulls-тан шығуды жоспарлап отырсыз ба?
Dialogue: 0,0:14:56.97,0:14:59.18,Default,,0,0,0,,Бұл жақсы болуы мүмкін
Dialogue: 0,0:15:03.69,0:15:07.28,Default,,0,0,0,,Сіз үшін әлі де қолданыс бар.
Dialogue: 0,0:15:11.16,0:15:13.45,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,0:15:15.83,0:15:18.41,Default,,0,0,0,,Жеңісті тойлауға арналған ерекше торт.
Dialogue: 0,0:15:18.50,0:15:20.71,Default,,0,0,0,,Тойып же
Dialogue: 0,0:15:21.04,0:15:22.12,Default,,0,0,0,,Уау~
Dialogue: 0,0:15:22.21,0:15:23.42,Default,,0,0,0,,Итадакима...
Dialogue: 0,0:15:23.75,0:15:25.46,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,0:15:25.54,0:15:26.92,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:27.30,0:15:30.47,Default,,0,0,0,,Сіз тортты бірінші болып алған жоқсыз!
Dialogue: 0,0:15:31.43,0:15:33.18,Default,,0,0,0,,Ережелер бар ма?
Dialogue: 0,0:15:33.89,0:15:35.60,Default,,0,0,0,,Ең бірінші жеу керек...
Dialogue: 0,0:15:37.01,0:15:38.02,Default,,0,0,0,,Сәлем Крис!
Dialogue: 0,0:15:38.10,0:15:39.98,Default,,0,0,0,,Не? мен?
Dialogue: 0,0:15:42.52,0:15:43.90,Default,,0,0,0,,Шағымдар жоқ, солай ма?
Dialogue: 0,0:15:44.10,0:15:45.40,Default,,0,0,0,,О!
Dialogue: 0,0:15:45.48,0:15:46.73,Default,,0,0,0,,Қарсылық жоқ!
Dialogue: 0,0:15:46.82,0:15:49.11,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:15:49.19,0:15:52.66,Default,,0,0,0,,У-у-у-у-у, жақсы балалар екен.
Dialogue: 0,0:15:58.58,0:16:03.21,Default,,0,0,0,,Куза Балто Рантаро Риксон Сиско
Dialogue: 0,0:16:03.71,0:16:08.13,Default,,0,0,0,,Және матчқа қатыспаса да бірге күрескендердің барлығы.
Dialogue: 0,0:16:08.67,0:16:12.30,Default,,0,0,0,,Мен көргім келген BC Sol ақыры жасалды.
Dialogue: 0,0:16:12.80,0:16:14.68,Default,,0,0,0,,Мұның бәрі барлығына алғыс.
Dialogue: 0,0:16:15.26,0:16:16.68,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:16:17.01,0:16:19.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:20.39,0:16:22.77,Default,,0,0,0,,Онда мен аламын!
Dialogue: 0,0:16:23.69,0:16:24.94,Default,,0,0,0,,Хмм!
Dialogue: 0,0:16:29.11,0:16:31.07,Default,,0,0,0,,Өте дәмді
Dialogue: 0,0:16:31.57,0:16:36.70,Default,,0,0,0,,♪~
Dialogue: 0,0:16:52.63,0:16:54.17,Default,,0,0,0,,Жолға түсіңіз
Dialogue: 0,0:16:54.26,0:16:56.22,Default,,0,0,0,,Иә? Вакия!
Dialogue: 0,0:16:56.30,0:16:58.14,Default,,0,0,0,,Уакияда (Карл) Уакияда
Dialogue: 0,0:16:58.22,0:17:01.06,Default,,0,0,0,,Ой, тойлауға келдің бе?
Dialogue: 0,0:17:01.43,0:17:04.48,Default,,0,0,0,,Сіз тосын сыйлық немесе басқа нәрсе әкелген жоқсыз ба?
Dialogue: 0,0:17:04.56,0:17:05.94,Default,,0,0,0,,Тез шығарыңыз
Dialogue: 0,0:17:06.02,0:17:08.31,Default,,0,0,0,,Қазіргі уақытта
Dialogue: 0,0:17:08.77,0:17:10.52,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:17:10.61,0:17:12.86,Default,,0,0,0,,Мен жеңіліп қалдым, әлі де ренжідім.
Dialogue: 0,0:17:13.40,0:17:15.03,Default,,0,0,0,,Онда не үшін келдің?
Dialogue: 0,0:17:15.11,0:17:16.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:16.53,0:17:19.32,Default,,0,0,0,,Сіз әлі ештеңе білмейтін сияқтысыз.
Dialogue: 0,0:17:20.37,0:17:21.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:24.37,0:17:26.92,Default,,0,0,0,,Бейтубе сайтында жарияланған бейнелер
Dialogue: 0,0:17:29.25,0:17:30.84,Default,,0,0,0,,Луи!
Dialogue: 0,0:17:31.13,0:17:35.01,Default,,0,0,0,,Әй, мына қызыл көз деген жігітті тыңдап тұрсың ба?
Dialogue: 0,0:17:35.26,0:17:38.43,Default,,0,0,0,,Шамасы олар пышақпен аң аулау ойынын ойнап жатқан сияқты.
Dialogue: 0,0:17:38.59,0:17:41.81,Default,,0,0,0,,Кез келген уақытта кел, мен саған серіктес боламын.
Dialogue: 0,0:17:42.10,0:17:44.31,Default,,0,0,0,,Фухахахахахаха
Dialogue: 0,0:17:45.43,0:17:46.31,Default,,0,0,0,,Луис…
Dialogue: 0,0:17:46.94,0:17:48.56,Default,,0,0,0,,Аңшылық дегеніміз не?
Dialogue: 0,0:17:48.98,0:17:53.32,Default,,0,0,0,,Қызыл көз әртүрлі қылшықтарға қарсы көше шайқасын бастайды.
Dialogue: 0,0:17:53.61,0:17:56.82,Default,,0,0,0,,Көшедегі шайқас... Мен де істеймін!
Dialogue: 0,0:17:57.36,0:18:01.99,Default,,0,0,0,,Маған жеткен мәлімет бойынша, Ғазем мен Шақаға да шабуыл жасалған көрінеді.
Dialogue: 0,0:18:02.37,0:18:04.20,Default,,0,0,0,,Е! Шака?
Dialogue: 0,0:18:04.29,0:18:05.45,Default,,0,0,0,,Сіз жеңілдіңіз бе?
Dialogue: 0,0:18:05.54,0:18:06.66,Default,,0,0,0,,Сол Шака?
Dialogue: 0,0:18:06.75,0:18:07.79,Default,,0,0,0,,О
Dialogue: 0,0:18:07.87,0:18:12.80,Default,,0,0,0,,Қызыл көз әлемге өзінің құдіретін көрсеткісі келетін сияқты.
Dialogue: 0,0:18:13.42,0:18:18.38,Default,,0,0,0,,Неліктен Ширасаги сарайы бұл туралы біліп, оның орнына шақыру жасады?
Dialogue: 0,0:18:18.80,0:18:22.10,Default,,0,0,0,,Бұл бала өте сенімді болуы керек.
Dialogue: 0,0:18:23.31,0:18:24.64,Default,,0,0,0,,Қызыл көз…
Dialogue: 0,0:18:25.93,0:18:30.23,Default,,0,0,0,,Жеңгендер ғана аман қалады, бұл жерде заң солай.
Dialogue: 0,0:18:30.69,0:18:34.15,Default,,0,0,0,,Аңыз Спригган менің қолымда одан да күшті болады.
Dialogue: 0,0:18:34.53,0:18:35.57,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:18:36.07,0:18:38.70,Default,,0,0,0,,Шәкеңе қамқор боламын!
Dialogue: 0,0:18:38.90,0:18:41.99,Default,,0,0,0,,Барлығымыз, кеттік! Мазалауға уақыт жоқ!
Dialogue: 0,0:18:42.12,0:18:43.62,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:18:43.70,0:18:46.70,Default,,0,0,0,,Эй, сен Қызыл көздің қайда екенін білмейсің ғой, солай ма?
Dialogue: 0,0:18:46.79,0:18:47.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:47.79,0:18:50.54,Default,,0,0,0,,Міне, сондықтан келдің емес пе?
Dialogue: 0,0:18:50.71,0:18:52.88,Default,,0,0,0,,Ах! Уакия~
Dialogue: 0,0:18:52.96,0:18:54.80,Default,,0,0,0,,(ащы күлімсіреу)
Dialogue: 0,0:18:54.88,0:18:59.34,Default,,0,0,0,,(Ұшақ дыбысы)
Dialogue: 0,0:18:59.63,0:19:03.89,Default,,0,0,0,,Мен Қызыл көздің қайда екенін білмеймін, бірақ Луидің қайда екенін білемін.
Dialogue: 0,0:19:03.97,0:19:04.93,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:05.01,0:19:08.06,Default,,0,0,0,,Әлгі баланың қырын көрсеңіз...
Dialogue: 0,0:19:08.14,0:19:09.60,Default,,0,0,0,,Қызыл көз қозғалуы керек.
Dialogue: 0,0:19:10.19,0:19:11.40,Default,,0,0,0,,Сіз сонда келесіз бе?
Dialogue: 0,0:19:11.48,0:19:13.23,Default,,0,0,0,,Эй, сен данышпансың ба?
Dialogue: 0,0:19:13.98,0:19:17.78,Default,,0,0,0,,Әй, жаным, мен онымен тағы да төбелескім келеді.
Dialogue: 0,0:19:24.28,0:19:25.37,Default,,0,0,0,,Мен!
Dialogue: 0,0:19:37.55,0:19:39.38,Default,,0,0,0,,Кисама қызыл көз ме?
Dialogue: 0,0:19:39.84,0:19:40.67,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:40.76,0:19:43.26,Default,,0,0,0,,Жақсы жұмыс, мен сені мақтаймын.
Dialogue: 0,0:19:44.05,0:19:45.80,Default,,0,0,0,,Фухахаха
Dialogue: 0,0:19:46.76,0:19:49.22,Default,,0,0,0,,Менің бегім - Кобус Лонгинус
Dialogue: 0,0:19:49.56,0:19:50.68,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:19:51.39,0:19:55.44,Default,,0,0,0,,Nightmare Longinus Солға айналу шабуылының түрі
Dialogue: 0,0:19:55.77,0:19:59.82,Default,,0,0,0,,Ең үлкен ерекшелігі - қабат пен диск біріктірілген
Dialogue: 0,0:20:01.07,0:20:03.36,Default,,0,0,0,,Аңызға айналған Спригган - сіздің қарсыласыңыз
Dialogue: 0,0:20:06.12,0:20:07.91,Default,,0,0,0,,Спригган ше?
Dialogue: 0,0:20:11.00,0:20:12.79,Default,,0,0,0,,Ах! сонда болды!
Dialogue: 0,0:20:13.87,0:20:16.46,Default,,0,0,0,,Бұл сөзсіз Луи мен Қызыл Көз.
Dialogue: 0,0:20:17.04,0:20:18.30,Default,,0,0,0,,(Shinrin Kamui) Серіктесіңмен бірлесіп жұмыс істеу, басқа агенттіктермен бірлескен Квирк жаттығулары… Хмм.
Dialogue: 0,0:20:18.38,0:20:19.34,Default,,0,0,0,,Өл… жоқ, әйелім мен арбашы қазірдің өзінде қайтыс болды.
Dialogue: 0,0:20:19.42,0:20:20.67,Default,,0,0,0,,Күтпеңіз
Dialogue: 0,0:20:21.51,0:20:24.22,Default,,0,0,0,,Қозғалыс кезінде ұрысты көру қиын
Dialogue: 0,0:20:24.43,0:20:26.05,Default,,0,0,0,,Ал, біз не істеуіміз керек?
Dialogue: 0,0:20:26.14,0:20:28.93,Default,,0,0,0,,Осы жерден қараңыз.
Dialogue: 0,0:20:31.43,0:20:34.56,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:20:34.90,0:20:37.36,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:48.70,0:20:52.41,Default,,0,0,0,,Менің көңілімді көтерерсің, Қызыл көз!
Dialogue: 0,0:20:52.83,0:20:54.92,Default,,0,0,0,,Спригганға барыңыз!
Dialogue: 0,0:21:00.96,0:21:02.55,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:21:02.84,0:21:04.17,Default,,0,0,0,,Лонгинус!
Dialogue: 0,0:21:15.89,0:21:17.35,Default,,0,0,0,,Жоғарғы түсірілім!
Dialogue: 0,0:21:22.28,0:21:23.40,Default,,0,0,0,,Бұл босқа!
Dialogue: 0,0:21:33.37,0:21:36.08,Default,,0,0,0,,Луи... Уау!
Dialogue: 0,0:21:36.46,0:21:38.08,Default,,0,0,0,,Хухахахаха
Dialogue: 0,0:21:38.17,0:21:41.63,Default,,0,0,0,,Аңыз Спригган Мынадай нәрсе ме?
Dialogue: 0,0:21:42.42,0:21:43.80,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:21:43.88,0:21:46.34,Default,,0,0,0,,Мені бақытты ет
Dialogue: 0,0:21:47.43,0:21:49.80,Default,,0,0,0,,Хухахахаха
Dialogue: 0,0:21:49.89,0:21:55.43,Default,,0,0,0,,Фухахахаха ахахахха
Dialogue: 0,0:21:55.98,0:21:56.48,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.48,0:22:00.06,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.48,0:22:00.06,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, бұлшық еттеріңді жаттығып жатырсыңдар ма?
Dialogue: 0,0:22:00.15,0:22:03.03,Default,,0,0,0,,Енді, күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:03.11,0:22:06.99,Default,,0,0,0,,Қозғалыс 1-нұсқаға қарағанда қарқындырақ. Алдымен алдыңғы эпизодты және көрсетілім уақытын қарастырайық.
Dialogue: 0,0:22:07.07,0:22:10.66,Default,,0,0,0,,GO Shoot GO Shoot Great Shoot!
Dialogue: 0,0:22:10.74,0:22:14.37,Default,,0,0,0,,GO Shoot GO Shoot Жылдамдығыңызды арттырыңыз!
Dialogue: 0,0:22:14.45,0:22:17.96,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:18.04,0:22:21.50,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:21.59,0:22:24.88,Default,,0,0,0,,Хахахаха Бұл жақсы емес пе? Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.96,0:22:28.88,Default,,0,0,0,,Бірақ бұл жерден одан да күшті болады. Мен қолдарымды және кернеуімді арттырамын.
Dialogue: 0,0:22:28.97,0:22:32.80,Default,,0,0,0,,GO ату GO ату Бей бұлшықеттерін жаттықтыру Моримори
Dialogue: 0,0:22:32.89,0:22:36.43,Default,,0,0,0,,GO АТТЫ БАР АТТЫ Менің атысым – құдайдың атысы
Dialogue: 0,0:22:36.52,0:22:40.23,Default,,0,0,0,,Оңға ату Солға ату Оңға ату
Dialogue: 0,0:22:40.31,0:22:43.90,Default,,0,0,0,,Сол жақ ату Оң жақ ату Сол жақта ату
Dialogue: 0,0:22:43.98,0:22:47.53,Default,,0,0,0,,Өткен аптада Осы аптада GO түсірілімін жасап жатырмыз
Dialogue: 0,0:22:47.61,0:22:51.24,Default,,0,0,0,,Осы аптада келесі аптада GO түсіру, ол да жасайды
Dialogue: 0,0:22:51.32,0:22:55.08,Default,,0,0,0,,Күн сайын барлығы жасайтын GO ату жаттығуларын жасаңыз
Dialogue: 0,0:22:55.16,0:22:58.58,Default,,0,0,0,,Көктем/жаз/күз/қыс GO түсіру жыл бойы
Dialogue: 0,0:22:58.66,0:23:00.21,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:23:00.29,0:23:02.75,Default,,0,0,0,,Шығанақ бұлшықеттерін жаттықтыру үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.83,0:23:05.96,Default,,0,0,0,,Сол шиеленіспен шарықтау шегіне жетейік!
Dialogue: 0,0:23:06.05,0:23:09.76,Default,,0,0,0,,Ичи Ни Сан Ши GO Түсіріңіз!
Dialogue: 0,0:23:09.84,0:23:13.26,Default,,0,0,0,,Ичи Ни Сан Ши GO Түсіріңіз, кеттік!
Dialogue: 0,0:23:13.35,0:23:17.14,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Кеттік!
Dialogue: 0,0:23:17.22,0:23:20.02,Default,,0,0,0,,«Үш екі бір GO» атыспен аяқталды!
Dialogue: 0,0:23:20.02,0:23:22.02,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:20.02,0:23:22.02,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.02,0:23:22.10,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.10,0:23:25.19,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.10,0:23:25.19,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:26.65,0:23:29.57,Default,,0,0,0,,Қызыл көз мен Луи арасындағы кездесу аяқталды!
Dialogue: 0,0:23:29.90,0:23:32.61,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:23:32.91,0:23:35.99,Default,,0,0,0,,Ақыры сені кездестірдім, бірақ кетпе!
Dialogue: 0,0:23:36.54,0:23:40.21,Default,,0,0,0,,Бұл металл айдаһар деген не? Менімен шайқас!
Dialogue: 0,0:23:40.87,0:23:43.13,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.21,0:23:46.13,Default,,0,0,0,,Дуэль! Лонгинус Спригганға қарсы!
Dialogue: 0,0:23:46.34,0:23:50.13,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.63,0:23:57.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory