Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.54,0:00:07.17,Default,,0,0,0,,wbba әлемдік лигасы
Dialogue: 0,0:00:07.71,0:00:09.88,Default,,0,0,0,,Әр лигада жеңіске жеткен клубтар...
Dialogue: 0,0:00:10.17,0:00:12.84,Default,,0,0,0,,Әлемнің шыңына қарай шайқас
Dialogue: 0,0:00:13.09,0:00:14.55,Default,,0,0,0,,Чемпион болуды мақсат етіңіз
Dialogue: 0,0:00:14.84,0:00:16.51,Default,,0,0,0,,Қолға алу үшін бірінші нөмір
Dialogue: 0,0:00:16.97,0:00:18.51,Default,,0,0,0,,Жауынгерлік рухыңызды өртеп жіберіңіз
Dialogue: 0,0:00:18.60,0:00:20.27,Default,,0,0,0,,Және шектен шығу
Dialogue: 0,0:00:20.97,0:00:22.43,Default,,0,0,0,,Жалынды жандардың шайқасы
Dialogue: 0,0:00:22.81,0:00:24.98,Default,,0,0,0,,Дүниені отқа сал
Dialogue: 0,0:00:25.81,0:00:27.27,Default,,0,0,0,,Даңққа кім ие болады?
Dialogue: 0,0:00:27.94,0:00:29.19,Default,,0,0,0,,Бұл – тура қызыл карта. (Бакуго) Тс.
Dialogue: 0,0:00:31.03,0:00:32.15,Default,,0,0,0,,Үш
Dialogue: 0,0:00:32.24,0:00:33.36,Default,,0,0,0,,Екі
Dialogue: 0,0:00:33.45,0:00:34.57,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:00:34.65,0:00:37.07,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:37.16,0:00:39.41,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:39.49,0:00:41.62,Default,,0,0,0,,Әлемдік лиганың жартылай финалы
Dialogue: 0,0:00:41.70,0:00:43.12,Default,,0,0,0,,Мен Лувэймін.
Dialogue: 0,0:00:43.20,0:00:45.37,Default,,0,0,0,,Дина Ешуаға соқтығысты
Dialogue: 0,0:00:45.46,0:00:47.25,Default,,0,0,0,,Мен білемін, Джошуа.
Dialogue: 0,0:00:47.50,0:00:49.17,Default,,0,0,0,,Мұны қалай жасайсыз?
Dialogue: 0,0:00:49.71,0:00:53.38,Default,,0,0,0,,Жұлдыз - шымшу мен жеңістің уәдесі.
Dialogue: 0,0:00:53.63,0:00:55.38,Default,,0,0,0,,Жүр! қос соққы
Dialogue: 0,0:00:56.30,0:00:57.05,Default,,0,0,0,,(Дыбысты ойнату)
Dialogue: 0,0:00:58.89,0:01:01.77,Default,,0,0,0,,Дина Джошуадан 1 ұпай алды.
Dialogue: 0,0:01:02.06,0:01:02.93,Default,,0,0,0,,Мен сені азаптан оңай-ақ құтқара алар едім.
Dialogue: 0,0:01:03.31,0:01:05.31,Default,,0,0,0,,Сен, бұл ұят болды.
Dialogue: 0,0:01:05.56,0:01:08.44,Default,,0,0,0,,Орындалғандықтан уәде деп аталады.
Dialogue: 0,0:01:09.94,0:01:10.69,Default,,0,0,0,,(Дыбысты ойнату)
Dialogue: 0,0:01:11.69,0:01:14.11,Default,,0,0,0,,Алға, Валькири!
Dialogue: 0,0:01:14.69,0:01:16.99,Default,,0,0,0,,Қарсы шабуыл!
Dialogue: 0,0:01:17.61,0:01:18.36,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:01:20.33,0:01:21.24,Default,,0,0,0,,(Дыбысты ойнату)
Dialogue: 0,0:01:22.54,0:01:23.54,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:24.29,0:01:26.71,Default,,0,0,0,,Мен Лу Вэйді жеңдім.
Dialogue: 0,0:01:26.87,0:01:28.96,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:01:29.63,0:01:31.25,Default,,0,0,0,,Келесі кезекте Шака!
Dialogue: 0,0:01:31.92,0:01:33.51,Default,,0,0,0,,Ау~
Dialogue: 0,0:01:33.96,0:01:34.96,Default,,0,0,0,,Сәлем Шака!
Dialogue: 0,0:01:35.51,0:01:38.93,Default,,0,0,0,,Міне, мен болғым келеді! Балтық!
Dialogue: 0,0:01:54.44,0:01:58.11,Default,,0,0,0,,Тіпті таңертеңгі жарқылмен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:59.07,0:02:01.41,Default,,0,0,0,,Бір жерден естілген дыбыс
Dialogue: 0,0:02:01.49,0:02:03.83,Default,,0,0,0,,Бұл шығанақтың соқтығысуы.
Dialogue: 0,0:02:03.91,0:02:08.25,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:08.92,0:02:13.67,Default,,0,0,0,,Жалынды жүрек ұйықтамайды, Майданға құмар.
Dialogue: 0,0:02:13.75,0:02:18.68,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:18.76,0:02:23.64,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:23.72,0:02:28.77,Default,,0,0,0,,Ең жақсы сахнада шыңды көздеу
Dialogue: 0,0:02:28.85,0:02:32.06,Default,,0,0,0,,Қазір ат!
Dialogue: 0,0:02:32.15,0:02:34.19,Default,,0,0,0,,(Үш екі бір ату!)
Dialogue: 0,0:02:34.27,0:02:36.19,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:36.28,0:02:38.44,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:38.53,0:02:43.45,Default,,0,0,0,,Маған бұрын ешқашан көрмеген шайқасты көрсетіңіз
Dialogue: 0,0:02:43.53,0:02:46.29,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:46.37,0:02:52.29,Default,,0,0,0,,Әріптесіңізбен үнемі дамып келе жатқан байланыс және дірілдеген жүрек соғысы
Dialogue: 0,0:02:52.38,0:02:56.88,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз.
Dialogue: 0,0:02:56.96,0:02:58.97,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:09.31,0:03:13.35,Default,,0,0,0,,Теңдесі жоқ! Үш есе әсер! !
Dialogue: 0,0:03:14.15,0:03:15.06,Default,,0,0,0,,(сенсорлық дыбыс)
Dialogue: 0,0:03:15.57,0:03:16.73,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:17.03,0:03:20.11,Default,,0,0,0,,Ал, сіз бұл жағдайды өзгерте алдыңыз.
Dialogue: 0,0:03:20.20,0:03:22.91,Default,,0,0,0,,Құдайды қайта жүктеу қабылданбаған кезде...
Dialogue: 0,0:03:22.99,0:03:24.62,Default,,0,0,0,,Мен жеңілдім деп ойладым.
Dialogue: 0,0:03:24.87,0:03:28.04,Default,,0,0,0,,Менің таяқ жегенім мүлдем келмеді.
Dialogue: 0,0:03:28.20,0:03:30.71,Default,,0,0,0,,Эй, Балто, бұл қандай техника?
Dialogue: 0,0:03:30.79,0:03:31.92,Default,,0,0,0,,Нан Нано!
Dialogue: 0,0:03:32.00,0:03:32.67,Default,,0,0,0,,Техника?
Dialogue: 0,0:03:33.12,0:03:36.09,Default,,0,0,0,,«Гюн» және «Бэн!» деп айтқан адам.
Dialogue: 0,0:03:36.38,0:03:39.55,Default,,0,0,0,,Әрине, бұл бұрынғы байланысты шабуылдарда болған жоқ.
Dialogue: 0,0:03:40.30,0:03:41.05,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:03:41.26,0:03:44.18,Default,,0,0,0,,Бұл мүлдем басқаша болды (Рантаро Кияма) Иә, иә
Dialogue: 0,0:03:46.10,0:03:46.85,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:03:47.43,0:03:48.43,Default,,0,0,0,,Дос…
Dialogue: 0,0:03:50.23,0:03:53.10,Default,,0,0,0,,Кешіріңіз, мен шеше алмадым.
Dialogue: 0,0:03:55.98,0:03:58.15,Default,,0,0,0,,Хехе, мені естімей тұрсың ба?
Dialogue: 0,0:03:58.48,0:04:00.53,Default,,0,0,0,,Келесі матчты сізге қалдырамын.
Dialogue: 0,0:04:01.82,0:04:04.16,Default,,0,0,0,,Балто, мынаны қара.
Dialogue: 0,0:04:04.66,0:04:05.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:05.49,0:04:09.16,Default,,0,0,0,,Нью-Йорк Буллс пен Париж Блэдерс арасындағы шайқас –
Dialogue: 0,0:04:09.24,0:04:11.83,Default,,0,0,0,,Бұқалар ойын ұпайлары бойынша 2-1
Dialogue: 0,0:04:12.16,0:04:12.79,Default,,0,0,0,,дәл қазір менің алдымда тұр!
Dialogue: 0,0:04:12.87,0:04:15.67,Default,,0,0,0,,Бладерс ойыншысы Дина Куроками қарсы шабуылды бастады!
Dialogue: 0,0:04:16.08,0:04:18.38,Default,,0,0,0,,Біз тағы бір ұпайға жетеміз!
Dialogue: 0,0:04:19.21,0:04:21.26,Default,,0,0,0,,Бірінші шайқаста жеңіске жетсем де,
Dialogue: 0,0:04:21.34,0:04:23.76,Default,,0,0,0,,Керісінше, мені бұрышқа салып жатыр.
Dialogue: 0,0:04:24.30,0:04:25.68,Default,,0,0,0,,Джошуа Бун…
Dialogue: 0,0:04:26.14,0:04:28.14,Default,,0,0,0,,Бұл Үлкен 5-тің ұлылығы!
Dialogue: 0,0:04:28.85,0:04:29.51,Default,,0,0,0,,Құт
Dialogue: 0,0:04:29.85,0:04:32.18,Default,,0,0,0,,Қазір Орақ орақының уақыты келді...
Dialogue: 0,0:04:32.27,0:04:34.52,Default,,0,0,0,,Жұлдыздың жарығы сөнгенде
Dialogue: 0,0:04:34.60,0:04:36.19,Default,,0,0,0,,Ешуа…
Dialogue: 0,0:04:36.27,0:04:39.19,Default,,0,0,0,,Мен сіздің жеңіс үлгісін бұзамын
Dialogue: 0,0:04:39.77,0:04:40.44,Default,,0,0,0,,Хун
Dialogue: 0,0:04:41.73,0:04:43.95,Default,,0,0,0,,Джошуа оны көтере алады.
Dialogue: 0,0:04:44.03,0:04:46.11,Default,,0,0,0,,Саған солай көрінеді
Dialogue: 0,0:04:46.20,0:04:46.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:48.95,0:04:50.83,Default,,0,0,0,,Не?
Dialogue: 0,0:04:51.20,0:04:53.29,Default,,0,0,0,,Бұл жағымсыз сезім
Dialogue: 0,0:04:53.66,0:04:55.67,Default,,0,0,0,,Мен бұл Джошуаға сене алмадым...
Dialogue: 0,0:04:55.75,0:04:58.75,Default,,0,0,0,,Сізге қысым көрсетіліп жатыр ма?
Dialogue: 0,0:04:58.96,0:04:59.63,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:05:05.30,0:05:07.05,Default,,0,0,0,,Бұл қызық, өйткені сен жеңесің
Dialogue: 0,0:05:07.55,0:05:08.22,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:09.22,0:05:10.56,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:11.18,0:05:13.77,Default,,0,0,0,,Мен Еркіннің көңілін қалдыра алмаймын.
Dialogue: 0,0:05:14.43,0:05:16.44,Default,,0,0,0,,Келіңіздер, шоу уақыты!
Dialogue: 0,0:05:16.52,0:05:18.65,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:05:19.11,0:05:22.48,Default,,0,0,0,,Джошуа Бун Бұрышта тұрғанда да...
Dialogue: 0,0:05:22.57,0:05:25.65,Default,,0,0,0,,Жою шегінен қайта жаңғырып, жеңіске жет!
Dialogue: 0,0:05:26.07,0:05:27.70,Default,,0,0,0,,Шекена балақай!
Dialogue: 0,0:05:27.78,0:05:28.87,Default,,0,0,0,,Дүние жүзіндегі барлық адамдар -
Dialogue: 0,0:05:29.32,0:05:31.24,Default,,0,0,0,,Чекероут! Иә~и
Dialogue: 0,0:05:34.79,0:05:36.96,Default,,0,0,0,,(Әйел жанкүйерлердің құттықтауы)
Dialogue: 0,0:05:37.42,0:05:38.96,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:05:41.25,0:05:42.42,Default,,0,0,0,,Барт
Dialogue: 0,0:05:42.50,0:05:44.63,Default,,0,0,0,,Мен Джошуаны жеңемін
Dialogue: 0,0:05:44.84,0:05:45.63,Default,,0,0,0,,Және-
Dialogue: 0,0:05:45.80,0:05:48.51,Default,,0,0,0,,Мен сенен бұрын финалға шығуды шешемін!
Dialogue: 0,0:05:48.84,0:05:49.72,Default,,0,0,0,,Дина…
Dialogue: 0,0:05:50.43,0:05:52.39,Default,,0,0,0,,Соны істейік, Балто!
Dialogue: 0,0:05:52.47,0:05:53.14,Default,,0,0,0,,Мен—
Dialogue: 0,0:05:53.68,0:05:55.73,Default,,0,0,0,,Әй, солай!
Dialogue: 0,0:05:55.81,0:05:58.48,Default,,0,0,0,,Жеңілмейтін сәуле!
Dialogue: 0,0:06:01.02,0:06:02.69,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:06:03.11,0:06:03.86,Default,,0,0,0,,Айт!
Dialogue: 0,0:06:04.36,0:06:05.49,Default,,0,0,0,,Үш
Dialogue: 0,0:06:05.57,0:06:06.69,Default,,0,0,0,,Екі
Dialogue: 0,0:06:06.78,0:06:08.03,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:06:08.11,0:06:10.66,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:11.07,0:06:11.82,Default,,0,0,0,,Білегім мен қолым аман қалғаны, бәлкім,
Dialogue: 0,0:06:15.08,0:06:17.50,Default,,0,0,0,,Әдеттегідей қорғаныс түрі -
Dialogue: 0,0:06:17.58,0:06:20.00,Default,,0,0,0,,Бластогениус тез орталыққа барады!
Dialogue: 0,0:06:20.08,0:06:21.83,Default,,0,0,0,,Қос соққы!
Dialogue: 0,0:06:21.92,0:06:23.42,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:06:24.38,0:06:27.84,Default,,0,0,0,,Қасқыр генийдің өмірін қырып жатыр!
Dialogue: 0,0:06:29.01,0:06:29.68,Default,,0,0,0,,Хун
Dialogue: 0,0:06:30.09,0:06:32.93,Default,,0,0,0,,Барлық жанкүйерлер артқа қарай тұрайық
Dialogue: 0,0:06:33.01,0:06:33.60,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:06:33.93,0:06:35.72,Default,,0,0,0,,Шекена сәби
Dialogue: 0,0:06:35.89,0:06:38.39,Default,,0,0,0,,Циклон қабырғасы!
Dialogue: 0,0:06:42.19,0:06:42.94,Default,,0,0,0,,Дех!
Dialogue: 0,0:06:43.02,0:06:43.77,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:06:44.02,0:06:45.73,Default,,0,0,0,,Жүр!
Dialogue: 0,0:06:45.82,0:06:47.32,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:06:49.82,0:06:52.45,Default,,0,0,0,,Күзетші жұмыс істейді!
Dialogue: 0,0:06:52.66,0:06:54.87,Default,,0,0,0,,Әлі жоқ! Гений
Dialogue: 0,0:07:03.46,0:07:05.34,Default,,0,0,0,,Циклондық есептегіш!
Dialogue: 0,0:07:07.42,0:07:08.17,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:07:09.59,0:07:10.34,Default,,0,0,0,,(Дыбысты ойнату)
Dialogue: 0,0:07:10.72,0:07:13.64,Default,,0,0,0,,Күшті есептегіш шешілді!
Dialogue: 0,0:07:14.05,0:07:15.89,Default,,0,0,0,,Шыда! өлім өлшемі
Dialogue: 0,0:07:16.10,0:07:17.64,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:07:19.60,0:07:21.64,Default,,0,0,0,,Осы жерден, қос соққы!
Dialogue: 0,0:07:21.89,0:07:22.65,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:07:23.02,0:07:23.77,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:07:24.11,0:07:27.57,Default,,0,0,0,,Death Sizer қабырғаға екі рет соққы беріңіз!
Dialogue: 0,0:07:29.03,0:07:29.86,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:07:30.15,0:07:32.16,Default,,0,0,0,,Ал, баста!
Dialogue: 0,0:07:34.41,0:07:35.16,Default,,0,0,0,,(түрлендіру дыбысы)
Dialogue: 0,0:07:40.04,0:07:42.25,Default,,0,0,0,,Генийге шабуыл жасаңыз!
Dialogue: 0,0:07:44.04,0:07:46.50,Default,,0,0,0,,Дағдарысқа қарсы күрес!
Dialogue: 0,0:07:51.72,0:07:52.47,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:07:53.68,0:07:54.43,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:07:56.97,0:07:57.72,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:59.31,0:08:00.06,Default,,0,0,0,,ал Ол Майтпен шайқасу – қауіпті ғана емес,
Dialogue: 0,0:08:01.77,0:08:02.77,Default,,0,0,0,,(бірге ойнаған дыбыс)
Dialogue: 0,0:08:04.15,0:08:04.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:06.52,0:08:08.07,Default,,0,0,0,,Шинигами жеңеді!
Dialogue: 0,0:08:09.69,0:08:10.69,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:08:11.24,0:08:11.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:12.49,0:08:13.32,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:08:13.74,0:08:15.07,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:08:22.50,0:08:25.17,Default,,0,0,0,,Blast Genius Burst Finish
Dialogue: 0,0:08:25.42,0:08:27.75,Default,,0,0,0,,Төртінші ойын 2-ден 1 ұпайға тең болды.
Dialogue: 0,0:08:27.84,0:08:29.71,Default,,0,0,0,,Нью-Йорк Буллз жеңді!
Dialogue: 0,0:08:34.18,0:08:36.43,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:08:36.97,0:08:38.97,Default,,0,0,0,,Ша~о!
Dialogue: 0,0:08:39.06,0:08:40.89,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:40.97,0:08:44.14,Default,,0,0,0,,Гений жеңісті бір секундта жұлып алды!
Dialogue: 0,0:08:45.02,0:08:46.77,Default,,0,0,0,,Ойын саны 3-тен 1-ге дейін.
Dialogue: 0,0:08:46.85,0:08:48.86,Default,,0,0,0,,Нью-Йорк Буллз жеңді
Dialogue: 0,0:08:49.36,0:08:52.90,Default,,0,0,0,,Осы арқылы бұқалар финалға шығады!
Dialogue: 0,0:08:54.11,0:08:55.11,Default,,0,0,0,,Дина!
Dialogue: 0,0:08:55.61,0:08:56.86,Default,,0,0,0,,Тағы да әуеніңді бұздың! Қанша рет айтуым керек саған түсіну үшін!—
Dialogue: 0,0:08:57.20,0:08:57.91,Default,,0,0,0,,Ах
Dialogue: 0,0:08:58.16,0:09:00.54,Default,,0,0,0,,Басқа біреудің ойыны сізді қызықтырса ше?
Dialogue: 0,0:09:00.91,0:09:02.29,Default,,0,0,0,,Концентрат!
Dialogue: 0,0:09:02.58,0:09:04.16,Default,,0,0,0,,Бұл маңызды ойын
Dialogue: 0,0:09:04.50,0:09:05.46,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:09:05.67,0:09:06.50,Default,,0,0,0,,Кім барады?
Dialogue: 0,0:09:06.92,0:09:09.54,Default,,0,0,0,,Риода Шака бар.
Dialogue: 0,0:09:09.84,0:09:11.09,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:09:11.67,0:09:14.01,Default,,0,0,0,,Сіз жаңа ғана жеңілдіңіз!
Dialogue: 0,0:09:14.09,0:09:16.09,Default,,0,0,0,,А? Тіпті шыға алмайтын жігіт...
Dialogue: 0,0:09:16.18,0:09:17.59,Default,,0,0,0,,Бастық аузыңды шапалақтама!
Dialogue: 0,0:09:17.84,0:09:20.01,Default,,0,0,0,,Fah fah
Dialogue: 0,0:09:20.10,0:09:21.56,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:09:21.64,0:09:22.77,Default,,0,0,0,,Сол балалар...
Dialogue: 0,0:09:22.85,0:09:24.93,Default,,0,0,0,,Бұл BC Sol, солай ма?
Dialogue: 0,0:09:25.02,0:09:26.64,Default,,0,0,0,,Мен үйреніп қалдым
Dialogue: 0,0:09:26.73,0:09:27.31,Default,,0,0,0,,Иә
Dialogue: 0,0:09:27.44,0:09:29.98,Default,,0,0,0,,Егер бұл Excalibur шабуыл түрі болса...
Dialogue: 0,0:09:30.06,0:09:33.03,Default,,0,0,0,,Шайтанның қорғаныс түрімен жақсы үйлесімділік
Dialogue: 0,0:09:33.19,0:09:35.28,Default,,0,0,0,,Егер сіз осы уақытқа дейін келген болсаңыз, бұл үйлесімділік туралы көбірек...
Dialogue: 0,0:09:35.36,0:09:36.78,Default,,0,0,0,,Маңызды нәрсе бар.
Dialogue: 0,0:09:37.53,0:09:38.45,Default,,0,0,0,,Не?
Dialogue: 0,0:09:38.91,0:09:41.33,Default,,0,0,0,,Қарсыласқа қарсы жеңіске ұмтылу сезімі
Dialogue: 0,0:09:41.53,0:09:43.87,Default,,0,0,0,,Ол қаншалықты үлкен?
Dialogue: 0,0:09:44.45,0:09:46.96,Default,,0,0,0,,Жеңіске жол жоқ, ақымақ.
Dialogue: 0,0:09:47.04,0:09:49.38,Default,,0,0,0,,Сіз тырыспайынша білмейсіз!
Dialogue: 0,0:09:49.46,0:09:50.75,Default,,0,0,0,,Мен барамын!
Dialogue: 0,0:09:53.88,0:09:54.55,Default,,0,0,0,,Не!
Dialogue: 0,0:09:55.42,0:09:56.59,Default,,0,0,0,,Мен барамын!
Dialogue: 0,0:09:58.76,0:10:00.39,Default,,0,0,0,,О, о...\NОл
Dialogue: 0,0:10:02.85,0:10:03.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:04.68,0:10:06.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:07.06,0:10:10.61,Default,,0,0,0,,Жарайды! Blader 5-ші ойында -
Dialogue: 0,0:10:10.69,0:10:14.15,Default,,0,0,0,,BC Соль - Аои Балт! Және-
Dialogue: 0,0:10:14.23,0:10:16.44,Default,,0,0,0,,Бразилия Риосы - жанып тұрған жалын ғибадатханасы Кайза
Dialogue: 0,0:10:16.53,0:10:19.61,Default,,0,0,0,,Жапонияда кескілескен шайқасқа түскен екі қарсылас...
Dialogue: 0,0:10:19.70,0:10:21.41,Default,,0,0,0,,Қазір Бразилияда
Dialogue: 0,0:10:21.49,0:10:24.20,Default,,0,0,0,,Тағы бір қақтығыс!
Dialogue: 0,0:10:24.29,0:10:25.12,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:29.21,0:10:32.63,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:34.42,0:10:36.59,Default,,0,0,0,,Барту!
Dialogue: 0,0:10:38.42,0:10:40.34,Default,,0,0,0,,Акула!
Dialogue: 0,0:10:40.97,0:10:41.84,Default,,0,0,0,,
Dialogue: 0,0:10:55.57,0:10:57.32,Default,,0,0,0,,Балто! Іске сәт!
Dialogue: 0,0:10:57.40,0:10:58.61,Default,,0,0,0,,Ганбарли
Dialogue: 0,0:10:59.32,0:11:01.24,Default,,0,0,0,,Шака! Іске сәт!
Dialogue: 0,0:11:01.41,0:11:03.87,Default,,0,0,0,,Жеңіске жет! Жең!
Dialogue: 0,0:11:03.95,0:11:07.87,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:11:08.87,0:11:10.12,Default,,0,0,0,,Хаха келді.
Dialogue: 0,0:11:10.21,0:11:10.83,Default,,0,0,0,,Кита!
Dialogue: 0,0:11:11.21,0:11:12.75,Default,,0,0,0,,Үлкен толқу
Dialogue: 0,0:11:12.83,0:11:14.34,Default,,0,0,0,,Ең жақсы!
Dialogue: 0,0:11:14.42,0:11:17.84,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:11:18.38,0:11:19.05,Default,,0,0,0,,(Шинобу) Мұнда кездейсоқ біреуді білетін адам бар ма?
Dialogue: 0,0:11:19.63,0:11:21.47,Default,,0,0,0,,Гяа ха ха
Dialogue: 0,0:11:21.84,0:11:23.43,Default,,0,0,0,,Бұл ыстық сезім
Dialogue: 0,0:11:23.59,0:11:25.18,Default,,0,0,0,,Бразилия ең жақсысы, солай ма?
Dialogue: 0,0:11:25.43,0:11:26.18,Default,,0,0,0,,Ах-
Dialogue: 0,0:11:26.26,0:11:27.43,Default,,0,0,0,,Керемет!
Dialogue: 0,0:11:28.22,0:11:29.77,Default,,0,0,0,,Бірақ сәлем, Барто.
Dialogue: 0,0:11:29.93,0:11:32.69,Default,,0,0,0,,Соңғы жауынгерлік король өте тітіркендіргіш болды.
Dialogue: 0,0:11:35.02,0:11:35.77,Default,,0,0,0,,(Дыбысты ойнату)
Dialogue: 0,0:11:37.90,0:11:38.90,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:11:39.44,0:11:42.49,Default,,0,0,0,,God Reboot...оны босату мүмкін болмады
Dialogue: 0,0:11:43.07,0:11:45.07,Default,,0,0,0,,Балто!
Dialogue: 0,0:11:45.78,0:11:48.91,Default,,0,0,0,,Осындай ақымақ жауынгермен күресу үшін...
Dialogue: 0,0:11:48.99,0:11:51.50,Default,,0,0,0,,Мен қатаң дайындықтан өткен сияқты емеспін!
Dialogue: 0,0:11:51.58,0:11:52.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:53.21,0:11:56.88,Default,,0,0,0,,Бүгінгі шайқас...Мүлдем толқыған жоқ.
Dialogue: 0,0:11:57.84,0:12:01.38,Default,,0,0,0,,Бұл жеңілгеннен гөрі ренжітеді.
Dialogue: 0,0:12:02.47,0:12:03.13,Default,,0,0,0,,Кен-
Dialogue: 0,0:12:03.93,0:12:05.97,Default,,0,0,0,,Тех ха ха ха!
Dialogue: 0,0:12:06.64,0:12:07.26,Default,,0,0,0,,Мен сені азаптан оңай-ақ құтқара алар едім.
Dialogue: 0,0:12:07.35,0:12:09.39,Default,,0,0,0,,Балто Балто болды ғой!
Dialogue: 0,0:12:11.93,0:12:14.48,Default,,0,0,0,,Шака! Бұл менікі -
Dialogue: 0,0:12:14.56,0:12:16.77,Default,,0,0,0,,Менің барлық күшім!
Dialogue: 0,0:12:20.44,0:12:23.20,Default,,0,0,0,,Сіз мені әрқашан күйдіртіңіз!
Dialogue: 0,0:12:23.70,0:12:25.70,Default,,0,0,0,,Шака сен де!
Dialogue: 0,0:12:26.57,0:12:28.87,Default,,0,0,0,,Гах ха ха!
Dialogue: 0,0:12:29.12,0:12:29.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:30.08,0:12:30.58,Default,,0,0,0,,Сәлем
Dialogue: 0,0:12:31.33,0:12:33.54,Default,,0,0,0,,Гах, ха, ха!
Dialogue: 0,0:12:33.62,0:12:37.21,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:12:37.29,0:12:39.30,Default,,0,0,0,,Ақымақ күлсең де, жеңе аласың!
Dialogue: 0,0:12:39.38,0:12:40.84,Default,,0,0,0,,Мен де жеңілмеймін!
Dialogue: 0,0:12:40.92,0:12:43.59,Default,,0,0,0,,Гах ха ха!
Dialogue: 0,0:12:43.67,0:12:46.22,Default,,0,0,0,,Гяа ха ха!
Dialogue: 0,0:12:46.30,0:12:47.72,Default,,0,0,0,,5-ойын
Dialogue: 0,0:12:48.18,0:12:49.47,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:12:49.76,0:12:51.27,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:12:53.31,0:12:54.06,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:12:54.69,0:12:55.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:58.23,0:13:01.11,Default,,0,0,0,,Енді Экскалибурға еніңіз!
Dialogue: 0,0:13:01.19,0:13:03.32,Default,,0,0,0,,Шеш, Валькири!
Dialogue: 0,0:13:05.15,0:13:05.82,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:13:07.11,0:13:07.87,Default,,0,0,0,,(Дыбысты ойнату)
Dialogue: 0,0:13:13.00,0:13:14.91,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:13:15.37,0:13:16.17,Default,,0,0,0,,Коу!
Dialogue: 0,0:13:16.46,0:13:19.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:20.21,0:13:22.38,Default,,0,0,0,,Мен сенен жеңілгеннен бері...
Dialogue: 0,0:13:22.59,0:13:25.63,Default,,0,0,0,,Экскалибур екеуміз осы күнді күттік!
Dialogue: 0,0:13:26.30,0:13:28.51,Default,,0,0,0,,Шақа жеңген 100 адамның шайқасы.
Dialogue: 0,0:13:28.84,0:13:30.22,Default,,0,0,0,,Мен мұны істей алмадым
Dialogue: 0,0:13:30.47,0:13:32.56,Default,,0,0,0,,Өйткені, сен ғажап адамсың.
Dialogue: 0,0:13:32.89,0:13:34.31,Default,,0,0,0,,Сондықтан мен-
Dialogue: 0,0:13:34.48,0:13:36.89,Default,,0,0,0,,Мен оған барымды беремін!
Dialogue: 0,0:13:37.81,0:13:40.65,Default,,0,0,0,,Жақсы, солай ма? Крис
Dialogue: 0,0:13:44.65,0:13:46.45,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:13:46.53,0:13:47.66,Default,,0,0,0,,Үш
Dialogue: 0,0:13:47.74,0:13:48.86,Default,,0,0,0,,Екі
Dialogue: 0,0:13:48.95,0:13:50.07,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:13:50.16,0:13:51.66,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:13:51.74,0:13:53.62,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:13:56.37,0:13:59.83,Default,,0,0,0,,Екеуі бетпе-бет соқтығысады!
Dialogue: 0,0:14:00.25,0:14:01.34,Default,,0,0,0,,(Масато) Қандай күш! Жоқ, күте тұр—
Dialogue: 0,0:14:01.42,0:14:02.84,Default,,0,0,0,,Қандай үлкен соққы!
Dialogue: 0,0:14:09.30,0:14:11.18,Default,,0,0,0,,Мен болғанның бәрі
Dialogue: 0,0:14:11.26,0:14:12.64,Default,,0,0,0,,Оны осы соққыға салыңыз
Dialogue: 0,0:14:13.22,0:14:16.06,Default,,0,0,0,,Үш есе әсер ету!
Dialogue: 0,0:14:16.35,0:14:17.31,Default,,0,0,0,,(Дыбысты ойнату)
Dialogue: 0,0:14:18.31,0:14:18.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:19.06,0:14:20.10,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:14:22.27,0:14:24.94,Default,,0,0,0,,Зиг Экскалибур аяқталды
Dialogue: 0,0:14:25.40,0:14:27.28,Default,,0,0,0,,1-ден 0-ге дейінгі нүктелер
Dialogue: 0,0:14:27.95,0:14:28.70,Default,,0,0,0,,Куу!
Dialogue: 0,0:14:29.66,0:14:32.03,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,0:14:32.32,0:14:33.24,Default,,0,0,0,,Барт…
Dialogue: 0,0:14:33.99,0:14:35.74,Default,,0,0,0,,Шака
Dialogue: 0,0:14:35.91,0:14:37.66,Default,,0,0,0,,Тіпті Балто!
Dialogue: 0,0:14:37.75,0:14:40.12,Default,,0,0,0,,Мен үш есе соққы алсам да...
Dialogue: 0,0:14:40.21,0:14:41.42,Default,,0,0,0,,Жарылған жоқ
Dialogue: 0,0:14:41.58,0:14:43.92,Default,,0,0,0,,Бірақ бұл жеткіліксіз...
Dialogue: 0,0:14:44.13,0:14:45.42,Default,,0,0,0,,Жеңіске жету
Dialogue: 0,0:14:48.51,0:14:49.34,Default,,0,0,0,,Айбо-
Dialogue: 0,0:14:49.59,0:14:52.34,Default,,0,0,0,,Денем қатты қызып кетті.
Dialogue: 0,0:14:52.68,0:14:54.22,Default,,0,0,0,,Бұл жақсы, солай ма?
Dialogue: 0,0:14:54.51,0:14:56.27,Default,,0,0,0,,Қазір! (жарқыраған дыбыс)
Dialogue: 0,0:14:58.43,0:14:58.93,Default,,0,0,0,,Е!
Dialogue: 0,0:15:02.06,0:15:03.36,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:04.32,0:15:06.11,Default,,0,0,0,,Балт Сіз жеңдіңіз!
Dialogue: 0,0:15:06.19,0:15:06.69,Default,,0,0,0,,О...
Dialogue: 0,0:15:07.44,0:15:09.03,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:15:09.32,0:15:10.11,Default,,0,0,0,,Балто!
Dialogue: 0,0:15:10.65,0:15:13.87,Default,,0,0,0,,Мен сені және Валькириді толығымен талқандаймын!
Dialogue: 0,0:15:14.12,0:15:16.08,Default,,0,0,0,,Шака! мен-
Dialogue: 0,0:15:16.20,0:15:17.70,Default,,0,0,0,,Бұл өте қызық!
Dialogue: 0,0:15:18.08,0:15:18.91,Default,,0,0,0,,Не?
Dialogue: 0,0:15:19.29,0:15:21.12,Default,,0,0,0,,Менің жеңілгім келмейді!
Dialogue: 0,0:15:21.75,0:15:23.92,Default,,0,0,0,,Сөзсіз жарылды!
Dialogue: 0,0:15:24.21,0:15:26.25,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:15:26.34,0:15:27.46,Default,,0,0,0,,Үш
Dialogue: 0,0:15:27.55,0:15:28.67,Default,,0,0,0,,Екі
Dialogue: 0,0:15:28.76,0:15:29.88,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:15:29.97,0:15:31.38,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:15:31.47,0:15:32.80,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:15:32.89,0:15:33.59,Default,,0,0,0,,Екінші жартысында басқалар әлсіреп жатқанда, олар өздерінің көз тартымды Квиркімен жауды өздеріне тартты ➡
Dialogue: 0,0:15:39.27,0:15:40.60,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:15:43.19,0:15:44.52,Default,,0,0,0,,Ал, баста!
Dialogue: 0,0:15:44.61,0:15:46.19,Default,,0,0,0,,Шат!
Dialogue: 0,0:15:46.44,0:15:48.53,Default,,0,0,0,,Жарайды, мен шыдаймын.
Dialogue: 0,0:15:48.90,0:15:51.99,Default,,0,0,0,,Шака келесі соққысымен гол соғуға ниетті.
Dialogue: 0,0:15:52.15,0:15:52.91,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:15:55.66,0:15:58.33,Default,,0,0,0,,Valkyrie God Reboot!
Dialogue: 0,0:16:01.66,0:16:02.83,Default,,0,0,0,,Жарайсыңдар! сәттілік
Dialogue: 0,0:16:03.33,0:16:04.08,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:16:04.46,0:16:06.46,Default,,0,0,0,,Абареро!
Dialogue: 0,0:16:06.79,0:16:08.21,Default,,0,0,0,,Сіздің толық күшіңіз-
Dialogue: 0,0:16:08.63,0:16:11.22,Default,,0,0,0,,Экскалибур қайтып оралды!
Dialogue: 0,0:16:11.59,0:16:12.34,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:16:16.18,0:16:16.93,Default,,0,0,0,,(Дыбысты ойнату)
Dialogue: 0,0:16:17.35,0:16:18.10,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:16:18.39,0:16:20.39,Default,,0,0,0,,Құдай қайта жүктесін...
Dialogue: 0,0:16:20.64,0:16:22.81,Default,,0,0,0,,Мен енді Балтоға көмектесе алмаймын.
Dialogue: 0,0:16:23.39,0:16:24.14,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:16:26.69,0:16:29.32,Default,,0,0,0,,Мына металл қылышты мен жылтыраттым.
Dialogue: 0,0:16:29.94,0:16:32.11,Default,,0,0,0,,Бұл теңдесі жоқ қылыш!
Dialogue: 0,0:16:37.45,0:16:38.20,Default,,0,0,0,,(түрлендіру дыбысы)
Dialogue: 0,0:16:48.38,0:16:49.13,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:16:52.30,0:16:53.05,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:16:53.13,0:16:53.80,Default,,0,0,0,,Ол ұшты ма?
Dialogue: 0,0:16:54.01,0:16:56.26,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:16:58.22,0:16:59.81,Default,,0,0,0,,(жіңішке дауыс)
Dialogue: 0,0:17:02.85,0:17:05.39,Default,,0,0,0,,Қарсы шабуыл!
Dialogue: 0,0:17:07.81,0:17:12.69,Default,,0,0,0,,Үш есе әсер ету!
Dialogue: 0,0:17:13.32,0:17:14.07,Default,,0,0,0,,(Дыбысты ойнату)
Dialogue: 0,0:17:14.57,0:17:16.49,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:17:31.13,0:17:32.30,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:17:33.63,0:17:34.80,Default,,0,0,0,,Ооо!
Dialogue: 0,0:17:34.88,0:17:35.63,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:17:36.51,0:17:37.26,Default,,0,0,0,,(Дыбысты ойнату)
Dialogue: 0,0:17:40.97,0:17:41.81,Default,,0,0,0,,Яаа!
Dialogue: 0,0:17:42.18,0:17:43.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:43.97,0:17:46.31,Default,,0,0,0,,God Valkyrie Burst Finish
Dialogue: 0,0:17:47.10,0:17:48.90,Default,,0,0,0,,2-1 пункттер -
Dialogue: 0,0:17:49.02,0:17:50.81,Default,,0,0,0,,б.з.б. Жеңіс!
Dialogue: 0,0:17:51.44,0:17:54.11,Default,,0,0,0,,Уау... мен жеңдім-
Dialogue: 0,0:17:54.19,0:17:55.74,Default,,0,0,0,,Бұл Барто Аои!
Dialogue: 0,0:17:55.82,0:17:57.82,Default,,0,0,0,,Сенгісіз! (аудитория үнсіз қалады)
Dialogue: 0,0:17:57.91,0:17:59.91,Default,,0,0,0,,Ойын саны 3-тен 2-ге дейін
Dialogue: 0,0:17:59.99,0:18:03.33,Default,,0,0,0,,Сольдің жеңісі! !
Dialogue: 0,0:18:04.66,0:18:05.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:06.08,0:18:07.25,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:18:07.54,0:18:09.08,Default,,0,0,0,,Ta!
Dialogue: 0,0:18:09.50,0:18:11.75,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:18:12.42,0:18:14.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:14.42,0:18:17.84,Default,,0,0,0,,Экскалибур толық жеңіс сияқты көрінді, бірақ...
Dialogue: 0,0:18:17.93,0:18:19.51,Default,,0,0,0,,Соңында, Валькири...
Dialogue: 0,0:18:19.59,0:18:22.47,Default,,0,0,0,,Батырдың қылышын шауып тастады!
Dialogue: 0,0:18:22.55,0:18:24.14,Default,,0,0,0,,Аники жеңді!
Dialogue: 0,0:18:24.22,0:18:25.64,Default,,0,0,0,,​​Керемет тамаша!
Dialogue: 0,0:18:25.72,0:18:27.48,Default,,0,0,0,,Мен сен істейсің деп ойладым~
Dialogue: 0,0:18:27.98,0:18:30.69,Default,,0,0,0,,Крис, біз финалға өтіп жатырмыз.
Dialogue: 0,0:18:30.94,0:18:32.94,Default,,0,0,0,,Иә! Ақырында -
Dialogue: 0,0:18:33.19,0:18:34.15,Default,,0,0,0,,Ақырында!
Dialogue: 0,0:18:34.36,0:18:35.69,Default,,0,0,0,,Крис!
Dialogue: 0,0:18:36.24,0:18:37.69,Default,,0,0,0,,Көңіліңіз толқып тұр ма?
Dialogue: 0,0:18:37.86,0:18:40.41,Default,,0,0,0,,Эй, көңілің толды ма?
Dialogue: 0,0:18:43.62,0:18:45.62,Default,,0,0,0,,Мен қатты толқыдым!
Dialogue: 0,0:18:45.79,0:18:49.12,Default,,0,0,0,,Рахмет Балто! Барлығына!
Dialogue: 0,0:18:50.83,0:18:51.58,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:52.13,0:18:52.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:52.71,0:18:54.67,Default,,0,0,0,,Fah fah fah
Dialogue: 0,0:18:55.30,0:18:56.30,Default,,0,0,0,,Хэхехе
Dialogue: 0,0:18:56.96,0:18:57.55,Default,,0,0,0,,Бакуго-кунға қарсы қандай жоспары барын сұрамақ едім.
Dialogue: 0,0:18:58.63,0:18:59.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:04.56,0:19:05.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:06.89,0:19:08.73,Default,,0,0,0,,Бұл жігіт-
Dialogue: 0,0:19:08.81,0:19:09.81,Default,,0,0,0,,Шака
Dialogue: 0,0:19:10.81,0:19:11.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:12.40,0:19:13.56,Default,,0,0,0,,Барт
Dialogue: 0,0:19:14.31,0:19:16.73,Default,,0,0,0,,Сіз мұны қайтадан жасадыңыз!
Dialogue: 0,0:19:17.19,0:19:18.74,Default,,0,0,0,,Бұл жай ғана болды.
Dialogue: 0,0:19:18.94,0:19:20.24,Default,,0,0,0,,Бұл қауіпті болды!
Dialogue: 0,0:19:21.57,0:19:22.16,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:19:22.57,0:19:23.74,Default,,0,0,0,,Сіздің досыңыз-
Dialogue: 0,0:19:23.99,0:19:25.49,Default,,0,0,0,,Сіз қайтадан есейдіңіз!
Dialogue: 0,0:19:25.87,0:19:26.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:28.66,0:19:32.42,Default,,0,0,0,,Иә? Сіз әлі байқамадыңыз ба?
Dialogue: 0,0:19:32.71,0:19:34.00,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:19:34.08,0:19:35.25,Default,,0,0,0,,Жоқ, га, га.
Dialogue: 0,0:19:35.34,0:19:36.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:36.67,0:19:37.96,Default,,0,0,0,,Сізге қарсы жеңіске жету үшін-
Dialogue: 0,0:19:38.13,0:19:40.34,Default,,0,0,0,,Мен одан да ақымақ болуым керек!
Dialogue: 0,0:19:40.80,0:19:42.01,Default,,0,0,0,,Міне!
Dialogue: 0,0:19:42.09,0:19:44.47,Default,,0,0,0,,Уау! Апыр-ай! О...
Dialogue: 0,0:19:45.47,0:19:46.35,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:19:46.43,0:19:48.97,Default,,0,0,0,,Финалға өткені үшін BC Солды мақтаймыз!
Dialogue: 0,0:19:51.73,0:19:55.48,Default,,0,0,0,,(Біртіндеп шапалақтау)
Dialogue: 0,0:19:55.56,0:20:00.15,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:20:00.24,0:20:02.15,Default,,0,0,0,,Құттықтаймыз BC Соль
Dialogue: 0,0:20:02.61,0:20:04.62,Default,,0,0,0,,Бірақ келесіде Рио...
Dialogue: 0,0:20:04.70,0:20:07.41,Default,,0,0,0,,Бұл міндетті түрде барлығын қызықтырады!
Dialogue: 0,0:20:08.04,0:20:09.04,Default,,0,0,0,,Шака!
Dialogue: 0,0:20:09.70,0:20:11.58,Default,,0,0,0,,«Қызықты», солай ма?
Dialogue: 0,0:20:12.16,0:20:13.83,Default,,0,0,0,,Ах! Біз жасаймыз ба?
Dialogue: 0,0:20:14.42,0:20:15.08,Default,,0,0,0,,О!
Dialogue: 0,0:20:15.46,0:20:19.59,Default,,0,0,0,,Көңілді! толқып кетті!
Dialogue: 0,0:20:20.17,0:20:21.30,Default,,0,0,0,,Көңілді!
Dialogue: 0,0:20:21.63,0:20:22.63,Default,,0,0,0,,О!
Dialogue: 0,0:20:28.60,0:20:30.85,Default,,0,0,0,,Рахмет, сезім, жаңбыр!
Dialogue: 0,0:20:33.35,0:20:33.85,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:36.69,0:20:40.40,Default,,0,0,0,,Батылдық! Бұл керемет шайқас болды!
Dialogue: 0,0:20:42.78,0:20:43.70,Default,,0,0,0,,Ұлы-
Dialogue: 0,0:20:44.57,0:20:46.07,Default,,0,0,0,,Жақсы компания!
Dialogue: 0,0:20:46.57,0:20:47.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:47.87,0:20:50.29,Default,,0,0,0,,Рахмет! Әке!
Dialogue: 0,0:20:51.33,0:20:56.00,Default,,0,0,0,,Барлығыңызға рахмет! Рақмет сізге!
Dialogue: 0,0:20:57.83,0:21:00.38,Default,,0,0,0,,Соңғы ойын Нью-Йорк Буллзға қарсы болады.
Dialogue: 0,0:21:00.46,0:21:01.76,Default,,0,0,0,,Мәртебелі отбасы ақыры қайта жанданды.
Dialogue: 0,0:21:01.84,0:21:04.80,Default,,0,0,0,,BC Соль кездеседі!
Dialogue: 0,0:21:05.13,0:21:08.01,Default,,0,0,0,,Әлемдегі ең жақсы клуб қайсы? ?
Dialogue: 0,0:21:08.43,0:21:10.39,Default,,0,0,0,,Иә, күштірек
Dialogue: 0,0:21:11.89,0:21:13.89,Default,,0,0,0,,Fah fah fah
Dialogue: 0,0:21:14.77,0:21:16.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:16.10,0:21:17.02,Default,,0,0,0,,(Масато) Қандай күш! Жоқ, күте тұр—
Dialogue: 0,0:21:17.10,0:21:19.11,Default,,0,0,0,,Бұл Strike God Chip деп аталады.
Dialogue: 0,0:21:19.27,0:21:20.02,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:21:20.73,0:21:23.03,Default,,0,0,0,,Соққы... Құдай чипі?
Dialogue: 0,0:21:23.61,0:21:25.78,Default,,0,0,0,,Егер сіз мұны кисеңіз, Валькири...
Dialogue: 0,0:21:25.95,0:21:29.03,Default,,0,0,0,,Сізге жаңа шабуыл күші қажет.
Dialogue: 0,0:21:29.45,0:21:30.66,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:21:30.74,0:21:31.49,Default,,0,0,0,,Керемет!
Dialogue: 0,0:21:31.58,0:21:32.54,Default,,0,0,0,,Бұл жақсы~
Dialogue: 0,0:21:32.74,0:21:34.91,Default,,0,0,0,,Wear Wear God Chip~
Dialogue: 0,0:21:35.00,0:21:35.83,Default,,0,0,0,,Ой
Dialogue: 0,0:21:36.04,0:21:37.25,Default,,0,0,0,,Әлі ерте!
Dialogue: 0,0:21:37.37,0:21:40.09,Default,,0,0,0,,Мен Валькириді көбірек өсіргім келеді.
Dialogue: 0,0:21:40.50,0:21:41.96,Default,,0,0,0,,Fah fah fah
Dialogue: 0,0:21:42.42,0:21:44.09,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:44.34,0:21:46.34,Default,,0,0,0,,Жарайды, мен істеймін.
Dialogue: 0,0:21:46.43,0:21:47.26,Default,,0,0,0,,Досым!
Dialogue: 0,0:21:47.55,0:21:48.55,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:21:48.93,0:21:52.81,Default,,0,0,0,,Баршаңызға, финалға арнайы дайындық!
Dialogue: 0,0:21:52.97,0:21:54.81,Default,,0,0,0,,О!
Dialogue: 0,0:21:55.93,0:21:57.73,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:21:58.15,0:21:59.98,Default,,0,0,0,,Негіздерге дайынсыз ба?
Dialogue: 0,0:22:00.06,0:22:02.82,Default,,0,0,0,,Енді күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:02.90,0:22:04.78,Default,,0,0,0,,Қозғалыс 1 нұсқаға қарағанда жылдамырақ.
Dialogue: 0,0:22:04.86,0:22:06.95,Default,,0,0,0,,Алдымен, Showtime бағдарламасының алдыңғы бөлімін қараңыз
Dialogue: 0,0:22:07.03,0:22:10.57,Default,,0,0,0,,Бар! Шүкір! үлкен
Dialogue: 0,0:22:10.66,0:22:13.41,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:13.49,0:22:14.33,Default,,0,0,0,,Жылдамдату
Dialogue: 0,0:22:14.41,0:22:16.16,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:16.25,0:22:18.00,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:18.08,0:22:19.83,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:19.92,0:22:21.42,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:21.50,0:22:23.13,Default,,0,0,0,,Хахаха, бұл жақсы емес пе?
Dialogue: 0,0:22:23.21,0:22:24.80,Default,,0,0,0,,Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.88,0:22:26.63,Default,,0,0,0,,Бұл жерден нашарлай түседі.
Dialogue: 0,0:22:26.72,0:22:28.80,Default,,0,0,0,,Шиеленісті көтерейік!
Dialogue: 0,0:22:28.88,0:22:30.84,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:30.93,0:22:32.80,Default,,0,0,0,,Мори Мори Моримори
Dialogue: 0,0:22:32.89,0:22:34.64,Default,,0,0,0,,Бар! Шүкір!
Dialogue: 0,0:22:34.72,0:22:36.48,Default,,0,0,0,,Менің атуым – құдайдың атысы
Dialogue: 0,0:22:36.56,0:22:40.10,Default,,0,0,0,,Оң аяқ киім Сол аяқ киім Оң жақтағы аяқ киім
Dialogue: 0,0:22:40.19,0:22:43.77,Default,,0,0,0,,Сол аяқ киім Оң аяқ киім Сол жақтағы аяқ киім
Dialogue: 0,0:22:43.86,0:22:45.69,Default,,0,0,0,,Өткен апта Осы аптада
Dialogue: 0,0:22:45.78,0:22:47.57,Default,,0,0,0,,Біз түсірілім жасап жатырмыз.
Dialogue: 0,0:22:47.65,0:22:49.36,Default,,0,0,0,,Осы апта Келесі аптада
Dialogue: 0,0:22:49.45,0:22:51.41,Default,,0,0,0,,Ол сондай-ақ Go Shoot ойнайды.
Dialogue: 0,0:22:51.49,0:22:53.08,Default,,0,0,0,,Күнделікті жаттығу
Dialogue: 0,0:22:53.16,0:22:54.99,Default,,0,0,0,,Барлығы Go Shoot жасап жатыр
Dialogue: 0,0:22:55.08,0:22:56.79,Default,,0,0,0,,Көктем/жаз күз/қыс
Dialogue: 0,0:22:56.87,0:22:58.46,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:22:58.54,0:22:59.96,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:23:00.04,0:23:02.67,Default,,0,0,0,,Негізгі бұлшықеттерді жақсарту үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.75,0:23:05.88,Default,,0,0,0,,Сол шиеленіспен біз шарықтау шегіне жетеміз.
Dialogue: 0,0:23:05.96,0:23:08.92,Default,,0,0,0,,1 2 3 4 Бар!
Dialogue: 0,0:23:09.01,0:23:09.67,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:23:09.76,0:23:12.39,Default,,0,0,0,,1 2 3 4 Бар!
Dialogue: 0,0:23:12.47,0:23:13.18,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:23:13.26,0:23:17.06,Default,,0,0,0,,1 2 3 4 Бар! кеттік
Dialogue: 0,0:23:17.14,0:23:17.72,Default,,0,0,0,,Үш
Dialogue: 0,0:23:17.97,0:23:18.60,Default,,0,0,0,,Екі
Dialogue: 0,0:23:18.81,0:23:20.60,Default,,0,0,0,,One Go аяқ киім!
Dialogue: 0,0:23:20.69,0:23:21.94,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.02,0:23:25.11,Default,,0,0,0,,Керемет түсіріңіз! Керемет негіз!
Dialogue: 0,0:23:26.32,0:23:28.94,Default,,0,0,0,,Дүниежүзілік лиганың финалдық ойындары аяқталуда
Dialogue: 0,0:23:29.15,0:23:31.24,Default,,0,0,0,,BC Соль капитаны ретінде...
Dialogue: 0,0:23:31.41,0:23:33.45,Default,,0,0,0,,Эль Сантоның шайқас сахнасында тұрыңыз.
Dialogue: 0,0:23:33.57,0:23:34.53,Default,,0,0,0,,Сондықтан мен-
Dialogue: 0,0:23:34.62,0:23:36.70,Default,,0,0,0,,Өте керемет! Мен жеңу стратегиясын ойладым.
Dialogue: 0,0:23:37.12,0:23:39.04,Default,,0,0,0,,Маған айтып уақытыңды босқа өткізбе?
Dialogue: 0,0:23:39.12,0:23:40.83,Default,,0,0,0,,Мен бұл жерде айта алмаймын!
Dialogue: 0,0:23:41.42,0:23:43.25,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.33,0:23:46.84,Default,,0,0,0,,Финал! BC Sol және New York Bulls! !
Dialogue: 0,0:23:46.92,0:23:49.84,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.34,0:23:57.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory