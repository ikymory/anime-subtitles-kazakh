Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.25,0:00:05.29,Default,,0,0,0,,Бейблейд!
Dialogue: 0,0:00:07.00,0:00:09.21,Default,,0,0,0,,Бұл баланың арманы
Dialogue: 0,0:00:09.75,0:00:14.51,Default,,0,0,0,,Дүние жүзінің түкпір-түкпірінен келген пышақшылар шыңға жету үшін жарысады және бір-біріне қарсы жанын салады.
Dialogue: 0,0:00:15.47,0:00:20.47,Default,,0,0,0,,Айналсын, жарылып, жарылсын!
Dialogue: 0,0:00:20.77,0:00:23.89,Default,,0,0,0,,Даңқты жеңіске қол жеткізіңіз!
Dialogue: 0,0:00:24.64,0:00:27.90,Default,,0,0,0,,Шайқастан кейін оны міндетті түрде табасыз.
Dialogue: 0,0:00:27.98,0:00:30.03,Default,,0,0,0,,Жарқын болашақ!
Dialogue: 0,0:00:37.66,0:00:39.83,Default,,0,0,0,,Кел, Кронос!
Dialogue: 0,0:00:43.96,0:00:45.83,Default,,0,0,0,,Айға сүңгу!
Dialogue: 0,0:00:51.00,0:00:53.59,Default,,0,0,0,,Куза Курцты жеңу үшін артынан келеді!
Dialogue: 0,0:00:53.67,0:00:56.38,Default,,0,0,0,,Мен финалдық турнирге өтуге тырысамын
Dialogue: 0,0:00:56.47,0:00:58.72,Default,,0,0,0,,Мен Курцпен шешуші шайқасқа шығуды шештім.
Dialogue: 0,0:00:58.80,0:01:03.10,Default,,0,0,0,,Мен император атанғаннан бергі ең жақсы шайқасымды көрсетемін.
Dialogue: 0,0:01:03.27,0:01:04.35,Default,,0,0,0,,Бұл да
Dialogue: 0,0:01:04.43,0:01:07.10,Default,,0,0,0,,Мен сізге және Валькирияның толық күшін көрсетемін!
Dialogue: 0,0:01:11.98,0:01:15.53,Default,,0,0,0,,Ең жоғары ұшатын реактивті түсірілім!
Dialogue: 0,0:01:21.24,0:01:22.91,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:01:28.33,0:01:29.38,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:30.13,0:01:34.34,Default,,0,0,0,,Мен Курцты жеңдім! Финалдық турнирге өтіңіз!
Dialogue: 0,0:01:35.22,0:01:38.47,Default,,0,0,0,,Ертеңгі жартылай финал Луи мен Редиге қарсы
Dialogue: 0,0:01:39.30,0:01:41.26,Default,,0,0,0,,Ал Еркін және мен.
Dialogue: 0,0:01:42.14,0:01:45.23,Default,,0,0,0,,Осы уақытқа дейін жеткен болсақ, жеңуден басқа амалымыз жоқ!
Dialogue: 0,0:01:46.52,0:01:49.23,Default,,0,0,0,,♪~
Dialogue: 0,0:01:49.31,0:01:51.77,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:51.86,0:01:54.23,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:54.32,0:01:56.07,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:56.78,0:01:58.78,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:59.28,0:02:00.82,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:02:00.91,0:02:05.08,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:06.08,0:02:10.83,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:10.92,0:02:15.84,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:15.96,0:02:20.68,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:20.76,0:02:25.60,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:25.81,0:02:30.60,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:30.69,0:02:35.86,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:35.94,0:02:39.03,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:39.15,0:02:40.66,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:40.74,0:02:43.20,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:43.28,0:02:45.49,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:45.83,0:02:47.79,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:47.87,0:02:49.21,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:49.29,0:02:50.71,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:50.79,0:02:53.17,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:53.25,0:02:59.51,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:59.59,0:03:03.72,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:03:03.80,0:03:06.68,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:06.76,0:03:08.64,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:09.31,0:03:11.19,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:11.23,0:03:11.77,Default,,0,0,0,,~♪
Dialogue: 0,0:03:11.77,0:03:15.32,Default,,0,0,0,,~♪
Dialogue: 0,0:03:11.77,0:03:15.32,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:15.32,0:03:15.94,Default,,0,0,0,,~♪
Dialogue: 0,0:03:17.23,0:03:19.94,Default,,0,0,0,,Жартылай финал! Тағдырлы шайқас!
Dialogue: 0,0:03:27.91,0:03:29.54,Default,,0,0,0,,Жақсы (жарқыраған дыбыс)
Dialogue: 0,0:03:29.83,0:03:32.50,Default,,0,0,0,,Бұл жартылай финалда Аники
Dialogue: 0,0:03:32.75,0:03:36.29,Default,,0,0,0,,А, ертең мен Валькири құдайымен жарысамын.
Dialogue: 0,0:03:36.67,0:03:38.30,Default,,0,0,0,,Осы жолы орындаңыз!
Dialogue: 0,0:03:38.46,0:03:41.01,Default,,0,0,0,,Бұл еркін жарыста жеңіске жетудің жалғыз жолы
Dialogue: 0,0:03:41.09,0:03:44.30,Default,,0,0,0,,Бірақ сіз байланыстырылған шабуылдарды пайдалана алмайсыз, солай ма?
Dialogue: 0,0:03:44.76,0:03:47.51,Default,,0,0,0,,Біз соқтығысқан сайын көп шығын аламыз.
Dialogue: 0,0:03:47.89,0:03:49.72,Default,,0,0,0,,Әлсіз жақтарға толы
Dialogue: 0,0:03:49.93,0:03:52.14,Default,,0,0,0,,Балалар, сендер не айтып тұрсыңдар?
Dialogue: 0,0:03:52.23,0:03:54.40,Default,,0,0,0,,Көрдіңіз бе? құдай қиғаш
Dialogue: 0,0:03:54.48,0:03:57.61,Default,,0,0,0,,Осылайша мен Спригганды асыра аяқтадым.
Dialogue: 0,0:03:57.69,0:03:59.36,Default,,0,0,0,,Жүр, Валькири!
Dialogue: 0,0:03:59.57,0:04:02.45,Default,,0,0,0,,Құдай жарсын!
Dialogue: 0,0:04:05.20,0:04:06.28,Default,,0,0,0,,Ша!
Dialogue: 0,0:04:07.24,0:04:10.41,Default,,0,0,0,,Сондай-ақ Ultimate God Reboot бар.
Dialogue: 0,0:04:10.75,0:04:14.00,Default,,0,0,0,,Осы екі нәрсені меңгере алсаң, қорықпайсың.
Dialogue: 0,0:04:14.21,0:04:16.38,Default,,0,0,0,,А, мен міндетті түрде жеңемін.
Dialogue: 0,0:04:16.46,0:04:18.42,Default,,0,0,0,,Балалар!
Dialogue: 0,0:04:19.09,0:04:22.59,Default,,0,0,0,,Жалқау болмаңыз, жаттығу жасаңыз!
Dialogue: 0,0:04:22.92,0:04:26.22,Default,,0,0,0,,Ах! Жарайды, арнайы дайындық! Арнайы дайындық!
Dialogue: 0,0:04:26.39,0:04:28.43,Default,,0,0,0,,Онда мен сенімен айналысамын.
Dialogue: 0,0:04:28.51,0:04:30.52,Default,,0,0,0,,Ах, Танаму Куза
Dialogue: 0,0:04:39.48,0:04:41.73,Default,,0,0,0,,(Маска сынған дыбыс)
Dialogue: 0,0:04:44.07,0:04:47.74,Default,,0,0,0,,Мен сенімен кез келген уақытта ұрысамын, кел тағы жеңіл.
Dialogue: 0,0:04:48.28,0:04:50.37,Default,,0,0,0,,Фухахахахахаха
Dialogue: 0,0:04:52.08,0:04:54.16,Default,,0,0,0,,Мен бұл қорлықты ешқашан ұмытпаймын.
Dialogue: 0,0:04:54.25,0:04:56.21,Default,,0,0,0,,Ширасаги сарайы Луис
Dialogue: 0,0:04:57.71,0:04:58.84,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:04:59.63,0:05:02.17,Default,,0,0,0,,Ертең мен міндетті түрде Лонгинусты құртамын.
Dialogue: 0,0:05:03.01,0:05:06.88,Default,,0,0,0,,Жолыма бөгет болған әрбір шығанақты құртамын.
Dialogue: 0,0:05:07.34,0:05:09.43,Default,,0,0,0,,Уау
Dialogue: 0,0:05:09.51,0:05:12.85,Default,,0,0,0,,Уау
Dialogue: 0,0:05:22.15,0:05:23.48,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:26.49,0:05:28.36,Default,,0,0,0,,Слеш реквиемі!
Dialogue: 0,0:05:28.45,0:05:29.66,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:05:30.45,0:05:32.24,Default,,0,0,0,,Мен сені құртамын!
Dialogue: 0,0:05:33.16,0:05:35.79,Default,,0,0,0,,(Сырылдаған дыбыс)
Dialogue: 0,0:05:35.87,0:05:37.08,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:05:39.13,0:05:40.63,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:43.63,0:05:47.68,Default,,0,0,0,,Бенишуу Тұңғиық түбінен қайтып келген сияқты.
Dialogue: 0,0:05:48.63,0:05:50.80,Default,,0,0,0,,Бірақ мен Ширасадиджо Луимін
Dialogue: 0,0:05:51.22,0:05:53.93,Default,,0,0,0,,Мен саған тағы бір қорқынышты түс түсіремін.
Dialogue: 0,0:05:59.81,0:06:01.44,Default,,0,0,0,,Хухахахаха
Dialogue: 0,0:06:01.52,0:06:03.90,Default,,0,0,0,,Сізде де қан кетіп жатыр ма? longinus
Dialogue: 0,0:06:04.44,0:06:07.28,Default,,0,0,0,,Жақсы, жақсы, жақсы.
Dialogue: 0,0:06:07.82,0:06:09.82,Default,,0,0,0,,Сіз жеңілмейтін бексіз
Dialogue: 0,0:06:09.99,0:06:13.99,Default,,0,0,0,,Спригган жұмбағы, оны тағы бір соққымен жаншып ал.
Dialogue: 0,0:06:14.12,0:06:16.87,Default,,0,0,0,,Фухахахахаха
Dialogue: 0,0:06:17.71,0:06:21.25,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:06:21.71,0:06:24.34,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:06:24.75,0:06:27.42,Default,,0,0,0,,Гррр... Ннууууууу
Dialogue: 0,0:06:27.51,0:06:30.26,Default,,0,0,0,,Мен ол баланы іздедім.
Dialogue: 0,0:06:30.68,0:06:34.06,Default,,0,0,0,,Мен сол Ширасаги сарайы Луимен жақын танысқан сияқтымын.
Dialogue: 0,0:06:34.47,0:06:35.85,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:35.93,0:06:37.81,Default,,0,0,0,,Бірақ сіз жеңілдіңіз, солай ма?
Dialogue: 0,0:06:38.48,0:06:40.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:40.98,0:06:44.32,Default,,0,0,0,,Тегін! Кешегі күнге рахмет!
Dialogue: 0,0:06:44.77,0:06:45.82,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:46.23,0:06:49.45,Default,,0,0,0,,Маған сеніп, соңғы матчты бердіңіз.
Dialogue: 0,0:06:50.15,0:06:51.66,Default,,0,0,0,,Жеңіске жету қызық болды ма?
Dialogue: 0,0:06:52.07,0:06:54.49,Default,,0,0,0,,О, өте қызық!
Dialogue: 0,0:06:55.03,0:06:57.33,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:06:58.20,0:07:01.25,Default,,0,0,0,,Угугугу уф
Dialogue: 0,0:07:01.33,0:07:05.17,Default,,0,0,0,,Унгаааааа!
Dialogue: 0,0:07:05.25,0:07:08.63,Default,,0,0,0,,Ахх!
Dialogue: 0,0:07:08.76,0:07:11.09,Default,,0,0,0,,Ахх!
Dialogue: 0,0:07:14.47,0:07:15.60,Default,,0,0,0,,(құлаған тастардың дыбысы)
Dialogue: 0,0:07:15.68,0:07:20.73,Default,,0,0,0,,Ха ха ха ха ха ха
Dialogue: 0,0:07:21.44,0:07:24.19,Default,,0,0,0,,Мен сенімен шайқасты асыға күтемін.
Dialogue: 0,0:07:25.36,0:07:27.28,Default,,0,0,0,,Жақсы емес...
Dialogue: 0,0:07:27.61,0:07:29.65,Default,,0,0,0,,Менің кезегім жақындап қалды.
Dialogue: 0,0:07:29.74,0:07:31.36,Default,,0,0,0,,Хуаншан Бұл менмін.
Dialogue: 0,0:07:33.41,0:07:34.95,Default,,0,0,0,,Фуфу~
Dialogue: 0,0:07:35.28,0:07:36.74,Default,,0,0,0,,Зоро?
Dialogue: 0,0:07:37.20,0:07:39.45,Default,,0,0,0,,Менің тегін сыйлығым қайтып келмейді.
Dialogue: 0,0:07:39.79,0:07:42.17,Default,,0,0,0,,Уайымдама...
Dialogue: 0,0:07:42.46,0:07:46.29,Default,,0,0,0,,Сіз қайда бара жатқаныңызды білесіз.
Dialogue: 0,0:07:48.13,0:07:51.05,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:07:51.13,0:07:52.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:54.43,0:07:56.30,Default,,0,0,0,,Ха... Тегін
Dialogue: 0,0:08:02.48,0:08:04.81,Default,,0,0,0,,Тегін... Жарайды ма?
Dialogue: 0,0:08:05.94,0:08:07.02,Default,,0,0,0,,Не?
Dialogue: 0,0:08:07.52,0:08:10.40,Default,,0,0,0,,Мен қажетсіз арнайы жаттығулар жасап жатқан шығармын деп ойладым...
Dialogue: 0,0:08:11.15,0:08:14.53,Default,,0,0,0,,Мен қисынсыз ештеңе істеген жоқпын.
Dialogue: 0,0:08:23.50,0:08:26.42,Default,,0,0,0,,Барт: Сіз өзіңіздің күшіңізді білесіз...
Dialogue: 0,0:08:26.50,0:08:28.67,Default,,0,0,0,,Оның қайдан шыққанын білмейсің.
Dialogue: 0,0:08:28.92,0:08:29.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:30.25,0:08:32.80,Default,,0,0,0,,Сіз әрқашан көңілді деп айтасыз, солай ма?
Dialogue: 0,0:08:32.88,0:08:34.01,Default,,0,0,0,,Онда
Dialogue: 0,0:08:34.76,0:08:36.51,Default,,0,0,0,,Менің күшім қандай?
Dialogue: 0,0:08:38.22,0:08:40.89,Default,,0,0,0,,Мен Фридің не айтып тұрғанын түсінбеймін.
Dialogue: 0,0:08:41.64,0:08:44.35,Default,,0,0,0,,Бірақ мен тегін конькиде ұтып алғым келеді.
Dialogue: 0,0:08:44.64,0:08:46.77,Default,,0,0,0,,Не істеуім керек? валкири
Dialogue: 0,0:08:48.23,0:08:49.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:52.90,0:08:53.78,Default,,0,0,0,,Гррр…
Dialogue: 0,0:08:55.32,0:08:56.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:57.91,0:08:59.28,Default,,0,0,0,,Валькирия?
Dialogue: 0,0:09:04.37,0:09:06.50,Default,,0,0,0,,Дұрыс, Валькири.
Dialogue: 0,0:09:07.50,0:09:10.96,Default,,0,0,0,,Сіз менімен бірге болсаңыз, алаңдайтын ештеңе жоқ.
Dialogue: 0,0:09:11.30,0:09:13.55,Default,,0,0,0,,Біз ешкімнен жеңілмейміз!
Dialogue: 0,0:09:13.88,0:09:17.93,Default,,0,0,0,,Ертең міндетті түрде жеңеміз, жолдасым!
Dialogue: 0,0:09:25.94,0:09:30.57,Default,,0,0,0,,Жарайды... Иә! Ұлдар мен қыздар!
Dialogue: 0,0:09:30.65,0:09:31.90,Default,,0,0,0,,Ғасыр оқиғалары
Dialogue: 0,0:09:31.98,0:09:35.19,Default,,0,0,0,,God Bladers кубогы ақыры қызу жүріп жатыр!
Dialogue: 0,0:09:35.32,0:09:38.99,Default,,0,0,0,,Финалдық турнир басталады!
Dialogue: 0,0:09:39.07,0:09:43.79,Default,,0,0,0,,Қиын шайқастан аман өткен ең мықты төрт ойыншы жартылай финалда кездеседі!
Dialogue: 0,0:09:44.20,0:09:46.08,Default,,0,0,0,,Бірінші матчта не болады?
Dialogue: 0,0:09:46.50,0:09:50.67,Default,,0,0,0,,Ширасаги сарайы Луи және Қызыл көз!
Dialogue: 0,0:09:51.17,0:09:55.26,Default,,0,0,0,,Екеуі жайлап стадионға қарай келе жатыр.
Dialogue: 0,0:09:55.88,0:09:56.84,Default,,0,0,0,,Шу…
Dialogue: 0,0:09:57.72,0:10:00.64,Default,,0,0,0,,Финалдық турнир 3 ұпайлық жүйе бойынша өтеді.
Dialogue: 0,0:10:01.30,0:10:04.06,Default,,0,0,0,,Бірінші 3 ұпай жинаған жеңеді.
Dialogue: 0,0:10:04.64,0:10:08.60,Default,,0,0,0,,Егер сіз бір соққыда жеңіліп қалсаңыз да, сіз бәрібір жағдайды өзгерте аласыз.
Dialogue: 0,0:10:13.98,0:10:15.57,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:10:16.99,0:10:18.28,Default,,0,0,0,,есімде
Dialogue: 0,0:10:18.36,0:10:21.24,Default,,0,0,0,,Сол кездегі сұрықсыз келбетіңіз
Dialogue: 0,0:10:22.03,0:10:23.83,Default,,0,0,0,,Ол кездегіден басқаша.
Dialogue: 0,0:10:24.08,0:10:28.71,Default,,0,0,0,,Бұл Спригган реквиемі Лонгинусты бөліктерге бөледі.
Dialogue: 0,0:10:29.00,0:10:31.25,Default,,0,0,0,,Қанша тырыссаң да пайдасы жоқ.
Dialogue: 0,0:10:31.50,0:10:34.63,Default,,0,0,0,,Сіз де сол қорқынышты түстердің азабын тартасыз
Dialogue: 0,0:10:35.05,0:10:36.71,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:10:37.17,0:10:40.05,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:40.55,0:10:43.60,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:43.68,0:10:44.89,Default,,0,0,0,,Бұл кішкентай вакуумдық торнадоның соңғы әсері!
Dialogue: 0,0:10:52.56,0:10:56.40,Default,,0,0,0,,Nightmare Longinus Үмітсіз бірінші шабуыл!
Dialogue: 0,0:10:56.48,0:10:58.57,Default,,0,0,0,,Шабуылдан кейін шабуыл!
Dialogue: 0,0:10:58.99,0:11:02.53,Default,,0,0,0,,Оған шыдауға бола ма? Ой, Спригган реквиемі
Dialogue: 0,0:11:02.62,0:11:06.04,Default,,0,0,0,,Резеңке сіңіру арқылы қуат тез артады.
Dialogue: 0,0:11:06.45,0:11:07.54,Default,,0,0,0,,Лонгинус!
Dialogue: 0,0:11:12.29,0:11:14.04,Default,,0,0,0,,Қарсы үзіліс!
Dialogue: 0,0:11:18.76,0:11:20.13,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:11:21.30,0:11:24.05,Default,,0,0,0,,Спригган реквиемі
Dialogue: 0,0:11:24.14,0:11:25.85,Default,,0,0,0,,1 ұпай қызыл көзге
Dialogue: 0,0:11:25.93,0:11:27.39,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:28.14,0:11:29.10,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:34.19,0:11:35.27,Default,,0,0,0,,Шу
Dialogue: 0,0:11:36.82,0:11:39.07,Default,,0,0,0,,Жақсы, Спригган.
Dialogue: 0,0:11:42.15,0:11:45.03,Default,,0,0,0,,Хмф, сіз аздап күшейіп кеткен сияқтысыз.
Dialogue: 0,0:11:46.53,0:11:50.33,Default,,0,0,0,,Бірақ сен мені жеңе алмайсың, Куришуу!
Dialogue: 0,0:11:51.25,0:11:52.54,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:11:54.46,0:11:56.50,Default,,0,0,0,,Түнгі түсірілім
Dialogue: 0,0:11:56.79,0:11:58.50,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:11:58.88,0:12:01.72,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:02.34,0:12:05.01,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:12.81,0:12:15.48,Default,,0,0,0,,Бір қозғалыс екі рет жұмыс істей ме?
Dialogue: 0,0:12:15.98,0:12:19.98,Default,,0,0,0,,Ой, Спригган, бұл жерде резеңке соқпайды!
Dialogue: 0,0:12:20.32,0:12:22.99,Default,,0,0,0,,Ол Лонгинустан жеткілікті мөлшердегі шабуылдарды қабылдауда.
Dialogue: 0,0:12:23.40,0:12:25.95,Default,,0,0,0,,Спригганды жойыңыз!
Dialogue: 0,0:12:30.08,0:12:31.79,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:12:31.87,0:12:32.96,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:12:33.50,0:12:36.29,Default,,0,0,0,,Сіз жойылатын адамсыз.
Dialogue: 0,0:12:36.75,0:12:38.29,Default,,0,0,0,,Лонгинусқа барыңыз!
Dialogue: 0,0:12:40.63,0:12:41.76,Default,,0,0,0,,(үру)
Dialogue: 0,0:12:45.30,0:12:47.26,Default,,0,0,0,,Металл айдаһардың қақтығысы!
Dialogue: 0,0:12:51.22,0:12:52.31,Default,,0,0,0,,(үру)
Dialogue: 0,0:12:54.56,0:12:56.27,Default,,0,0,0,,Еркін таралады
Dialogue: 0,0:12:56.44,0:12:57.69,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:13:00.48,0:13:03.19,Default,,0,0,0,,Nightmare Longinus Burst Finish
Dialogue: 0,0:13:03.28,0:13:05.36,Default,,0,0,0,,Ширасаги Castle Louis үшін 2 ұпай
Dialogue: 0,0:13:06.45,0:13:07.57,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:13:07.66,0:13:09.87,Default,,0,0,0,,Өйткені, Луи Яроу
Dialogue: 0,0:13:10.45,0:13:12.37,Default,,0,0,0,,3 ұпай болғанына қуаныштымын.
Dialogue: 0,0:13:12.87,0:13:17.96,Default,,0,0,0,,Әдетте мен тағы жеңіліп қалатын едім хахахахаха
Dialogue: 0,0:13:20.54,0:13:21.75,Default,,0,0,0,,Лонгинус…
Dialogue: 0,0:13:30.43,0:13:33.52,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз. Мен сені мақтаймын.
Dialogue: 0,0:13:33.81,0:13:35.48,Default,,0,0,0,,Бірақ бәрі осы.
Dialogue: 0,0:13:36.14,0:13:37.56,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:13:40.31,0:13:41.61,Default,,0,0,0,,Жою!
Dialogue: 0,0:13:42.23,0:13:44.61,Default,,0,0,0,,Бұл қызық, байқап көріңіз
Dialogue: 0,0:13:46.36,0:13:48.41,Default,,0,0,0,,Түнгі түсірілім
Dialogue: 0,0:13:48.95,0:13:50.49,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:13:50.87,0:13:53.74,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:54.37,0:13:57.46,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:57.58,0:13:58.75,Default,,0,0,0,,Бұл кішкентай вакуумдық торнадоның соңғы әсері!
Dialogue: 0,0:13:59.58,0:14:03.46,Default,,0,0,0,,Ой, Spriggan Енді солға бұру арқылы шабуыл режимі
Dialogue: 0,0:14:04.92,0:14:08.88,Default,,0,0,0,,О, сен менімен бетпе-бет ұрыспақсың ба?
Dialogue: 0,0:14:11.55,0:14:14.39,Default,,0,0,0,,Тағы келіңіз, Лонгинусты өтінемін.
Dialogue: 0,0:14:19.73,0:14:22.31,Default,,0,0,0,,Уууу Спригган!
Dialogue: 0,0:14:26.49,0:14:28.11,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:14:28.20,0:14:29.41,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:14:29.70,0:14:30.95,Default,,0,0,0,,Лонгинус!
Dialogue: 0,0:14:42.50,0:14:43.92,Default,,0,0,0,,Гууууууу
Dialogue: 0,0:14:44.00,0:14:45.55,Default,,0,0,0,,Нууууу
Dialogue: 0,0:14:55.14,0:14:58.43,Default,,0,0,0,,Оны құлатыңыз Metal Dragon Crush!
Dialogue: 0,0:15:00.52,0:15:02.61,Default,,0,0,0,,Слеш реквиемі!
Dialogue: 0,0:15:08.86,0:15:10.78,Default,,0,0,0,,Ууууууу
Dialogue: 0,0:15:10.86,0:15:12.82,Default,,0,0,0,,Уаааааааааааааааааааааа
Dialogue: 0,0:15:18.33,0:15:19.83,Default,,0,0,0,,Оны жойыңыз!
Dialogue: 0,0:15:19.91,0:15:22.50,Default,,0,0,0,,Уау
Dialogue: 0,0:15:27.80,0:15:28.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:31.22,0:15:32.47,Default,,0,0,0,,(Сыну дыбысы)
Dialogue: 0,0:15:40.02,0:15:42.90,Default,,0,0,0,,Спригган реквиемінің жарқырауы
Dialogue: 0,0:15:42.98,0:15:45.31,Default,,0,0,0,,Жеңімпаз 3-2 Қызыл көз
Dialogue: 0,0:15:45.65,0:15:48.57,Default,,0,0,0,,Уау
Dialogue: 0,0:15:49.69,0:15:53.07,Default,,0,0,0,,Бір қызығы, Ширасадиджо Луи жеңіліп қалды!
Dialogue: 0,0:15:53.57,0:15:56.66,Default,,0,0,0,,Шу Луиді жеңді.
Dialogue: 0,0:15:56.91,0:16:01.71,Default,,0,0,0,,Бұл турнирдің басты фавориті - ақ тиран Ширасагижоруи...
Dialogue: 0,0:16:01.79,0:16:04.79,Default,,0,0,0,,Жартылай финалда ұтылды~!
Dialogue: 0,0:16:16.55,0:16:17.89,Default,,0,0,0,,Қызықты
Dialogue: 0,0:16:19.47,0:16:22.35,Default,,0,0,0,,Фухахахахаха
Dialogue: 0,0:16:22.43,0:16:26.15,Default,,0,0,0,,Ахахахахахахаха
Dialogue: 0,0:16:27.27,0:16:28.82,Default,,0,0,0,,қиын өмір кешкен.
Dialogue: 0,0:16:29.40,0:16:31.19,Default,,0,0,0,,Жеңілсең де бақытты көрінесің
Dialogue: 0,0:16:31.74,0:16:33.24,Default,,0,0,0,,Луи жеңілді...
Dialogue: 0,0:16:33.32,0:16:36.45,Default,,0,0,0,,Менің ойымша, бұл шайқастың қызығын қайтарды.
Dialogue: 0,0:16:37.37,0:16:40.95,Default,,0,0,0,,Мен күткеннен де күшті болып кеттің, Қызыл көз.
Dialogue: 0,0:16:41.45,0:16:46.54,Default,,0,0,0,,Ең күшті Bay Spring Requiem аяқталуға бір қадам қалды.
Dialogue: 0,0:16:46.79,0:16:49.84,Default,,0,0,0,,Менің армандарым орындалатын уақыт келді.
Dialogue: 0,0:16:52.51,0:16:54.13,Default,,0,0,0,,Китакита
Dialogue: 0,0:16:54.22,0:16:59.10,Default,,0,0,0,,Көңіл суымай тұрып, жартылай финалдың екінші матчының уақыты келді.
Dialogue: 0,0:16:59.81,0:17:05.48,Default,,0,0,0,,Осы турнирдегі тағы бір үлкен фаворит, Фри Де Ла Хойя пайда болды.
Dialogue: 0,0:17:05.56,0:17:09.69,Default,,0,0,0,,Менің қарсыласым Б.С.Сольдің әріптесі Балт Аои!
Dialogue: 0,0:17:18.03,0:17:19.91,Default,,0,0,0,,Аники, сен қызғансың.
Dialogue: 0,0:17:20.41,0:17:23.58,Default,,0,0,0,,Жақсы, бірақ... қобалжымайсың ба?
Dialogue: 0,0:17:24.08,0:17:25.66,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:17:26.04,0:17:27.62,Default,,0,0,0,,Хмм... а?
Dialogue: 0,0:17:27.71,0:17:30.63,Default,,0,0,0,,Фуфуфуфуфуфу…
Dialogue: 0,0:17:30.71,0:17:36.13,Default,,0,0,0,,Уф... Уф... Уф...
Dialogue: 0,0:17:36.51,0:17:37.51,Default,,0,0,0,,Тегін?
Dialogue: 0,0:17:37.59,0:17:39.72,Default,,0,0,0,,Ахх...
Dialogue: 0,0:17:40.39,0:17:43.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:43.47,0:17:44.56,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:17:44.85,0:17:47.06,Default,,0,0,0,,О, тәңірім Мамма Миа
Dialogue: 0,0:17:47.39,0:17:51.27,Default,,0,0,0,,Бұл оның Луимен қақтығыс кезінде көрсеткен керемет рухы!
Dialogue: 0,0:17:51.82,0:17:53.73,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:17:54.44,0:17:56.99,Default,,0,0,0,,Бұл бұрынғыдан да керемет.
Dialogue: 0,0:17:59.91,0:18:00.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:02.24,0:18:04.95,Default,,0,0,0,,Сезіміңіздің сізді жеңуіне жол бермеңіз!
Dialogue: 0,0:18:07.08,0:18:08.62,Default,,0,0,0,,Сәлем Балто!
Dialogue: 0,0:18:09.54,0:18:11.67,Default,,0,0,0,,Концентрат концентраты!
Dialogue: 0,0:18:11.96,0:18:13.67,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:14.55,0:18:17.09,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:17.59,0:18:19.76,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:20.09,0:18:21.22,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:18:24.85,0:18:26.64,Default,,0,0,0,,Валькирияға барыңыз
Dialogue: 0,0:18:30.40,0:18:33.19,Default,,0,0,0,,Фафнир Валькиридің шабуылынан қашады
Dialogue: 0,0:18:33.27,0:18:35.03,Default,,0,0,0,,Мен орталықты алдым!
Dialogue: 0,0:18:35.32,0:18:39.95,Default,,0,0,0,,Бұл Фафнир, қандай жоғары жылдамдықпен айналу!
Dialogue: 0,0:18:41.41,0:18:43.24,Default,,0,0,0,,Ештеңе бұзылмайды!
Dialogue: 0,0:18:45.08,0:18:45.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:48.83,0:18:49.92,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:18:50.29,0:18:51.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:52.79,0:18:55.84,Default,,0,0,0,,Ағызу Fafnir Burst Finish
Dialogue: 0,0:18:55.92,0:18:58.22,Default,,0,0,0,,Тегін Де Ла Хойя үшін 2 ұпай
Dialogue: 0,0:18:58.30,0:19:00.51,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:00.72,0:19:02.22,Default,,0,0,0,,Барт…
Dialogue: 0,0:19:02.30,0:19:03.80,Default,,0,0,0,,Аники, қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:19:03.89,0:19:05.47,Default,,0,0,0,,Балто концентраты!
Dialogue: 0,0:19:07.85,0:19:10.14,Default,,0,0,0,,Сіз бұл деңгейде жеңе алмайсыз.
Dialogue: 0,0:19:13.52,0:19:14.61,Default,,0,0,0,,Тегін…
Dialogue: 0,0:19:15.23,0:19:17.78,Default,,0,0,0,,Толық қуат Толық қуат!
Dialogue: 0,0:19:28.75,0:19:30.66,Default,,0,0,0,,Кеттік, Валькири.
Dialogue: 0,0:19:34.75,0:19:36.21,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:19:38.01,0:19:39.72,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:19:40.22,0:19:42.72,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:43.39,0:19:45.51,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:19:51.35,0:19:52.48,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:52.56,0:19:54.35,Default,,0,0,0,,Бұрынғыдай даму.
Dialogue: 0,0:19:54.69,0:19:57.36,Default,,0,0,0,,Фафнир бірінші шайқасы сияқты
Dialogue: 0,0:19:57.44,0:20:00.65,Default,,0,0,0,,Тіпті Валькиридің қатты шабуылына қарамастан, ешқандай зақым болған жоқ!
Dialogue: 0,0:20:00.74,0:20:01.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:02.11,0:20:06.49,Default,,0,0,0,,Валькири дүңгіршегі! Фафнир бұл жолы тағы жеңе ме?
Dialogue: 0,0:20:07.03,0:20:08.54,Default,,0,0,0,,Валькирия
Dialogue: 0,0:20:08.62,0:20:11.41,Default,,0,0,0,,Түпкілікті Құдай қайта жүктеу!
Dialogue: 0,0:20:18.59,0:20:20.09,Default,,0,0,0,,Ал, бақ бұйырсын!
Dialogue: 0,0:20:20.17,0:20:21.84,Default,,0,0,0,,Аники Бұл сіздің мүмкіндігіңіз!
Dialogue: 0,0:20:22.47,0:20:28.06,Default,,0,0,0,,Міне, Valkyrie's Ultimate God Reboot!
Dialogue: 0,0:20:30.64,0:20:32.64,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:20:36.69,0:20:38.27,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:20:39.73,0:20:41.03,Default,,0,0,0,,Фафнир!
Dialogue: 0,0:20:45.91,0:20:47.12,Default,,0,0,0,,(үру)
Dialogue: 0,0:20:50.12,0:20:53.46,Default,,0,0,0,,Құдай жарсын!
Dialogue: 0,0:21:00.13,0:21:03.34,Default,,0,0,0,,Аяқтаған кезде Құдай Валькириге шабуыл жасаңыз
Dialogue: 0,0:21:03.42,0:21:05.43,Default,,0,0,0,,1 ұпай Барто Аои үшін
Dialogue: 0,0:21:05.51,0:21:07.93,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:08.22,0:21:09.51,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:21:09.60,0:21:11.18,Default,,0,0,0,,1 ұпай қайтарылды!
Dialogue: 0,0:21:11.52,0:21:14.10,Default,,0,0,0,,Мен оны Хамфриден алдым.
Dialogue: 0,0:21:14.39,0:21:16.31,Default,,0,0,0,,Тақылдап тұр, Балто.
Dialogue: 0,0:21:16.40,0:21:17.56,Default,,0,0,0,,Бұл жұмыс істейді
Dialogue: 0,0:21:18.06,0:21:19.94,Default,,0,0,0,,Бос уақытыңыз сәтті өтсін!
Dialogue: 0,0:21:20.02,0:21:21.82,Default,,0,0,0,,Екеуіне де сәттілік!
Dialogue: 0,0:21:22.11,0:21:24.07,Default,,0,0,0,,Екеуі де дамиды
Dialogue: 0,0:21:24.15,0:21:26.61,Default,,0,0,0,,Бұл қызықты матчқа айналуда.
Dialogue: 0,0:21:28.07,0:21:29.07,Default,,0,0,0,,Тегін…
Dialogue: 0,0:21:29.32,0:21:31.95,Default,,0,0,0,,Хаха...
Dialogue: 0,0:21:32.12,0:21:35.79,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:21:36.42,0:21:39.38,Default,,0,0,0,,Үшінші шайқас: Мен келесі жолы міндетті түрде жеңемін!
Dialogue: 0,0:21:39.92,0:21:41.96,Default,,0,0,0,,Хаха...
Dialogue: 0,0:21:42.59,0:21:43.63,Default,,0,0,0,,Әй
Dialogue: 0,0:21:44.05,0:21:45.22,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:21:45.47,0:21:48.34,Default,,0,0,0,,Олай болса келесі матчты шешейік.
Dialogue: 0,0:21:55.48,0:21:56.44,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.44,0:21:59.98,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.44,0:21:59.98,Default,,0,0,0,,Жарайсыңдар Ұлдар мен Қыздар Сіз бұлшық еттеріңізді шынықтырасыз ба?
Dialogue: 0,0:22:00.06,0:22:02.98,Default,,0,0,0,,Енді, күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:03.07,0:22:06.95,Default,,0,0,0,,Қозғалыс 1-нұсқаға қарағанда қарқындырақ. Алдымен алдыңғы эпизодты және көрсетілім уақытын қарастырайық.
Dialogue: 0,0:22:07.03,0:22:10.57,Default,,0,0,0,,GO Shoot GO Shoot Great Shoot!
Dialogue: 0,0:22:10.66,0:22:14.37,Default,,0,0,0,,GO Shoot GO Shoot Жылдамдығыңызды арттырыңыз!
Dialogue: 0,0:22:14.45,0:22:18.00,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:18.08,0:22:21.42,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:21.50,0:22:24.80,Default,,0,0,0,,Хахахаха Бұл жақсы емес пе? Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.88,0:22:28.80,Default,,0,0,0,,Бірақ бұл жерден күшейе түседі, мен қолдарымды және кернеуімді арттырамын.
Dialogue: 0,0:22:28.88,0:22:32.72,Default,,0,0,0,,GO Shoot GO Shoot Bay Muscle Train Моримори
Dialogue: 0,0:22:32.80,0:22:36.43,Default,,0,0,0,,АЛУ АТТЫ БАР АТТЫ Менің атыс – құдайдың атысы
Dialogue: 0,0:22:36.52,0:22:40.15,Default,,0,0,0,,Оңға ату Солға ату Оңға ату
Dialogue: 0,0:22:40.23,0:22:43.86,Default,,0,0,0,,Сол жақ ату Оң жақ ату Сол жақта ату
Dialogue: 0,0:22:43.94,0:22:47.53,Default,,0,0,0,,Өткен аптада Осы аптада GO түсірілімін жасап жатырмыз
Dialogue: 0,0:22:47.61,0:22:51.32,Default,,0,0,0,,Осы аптада келесі аптада GO түсіру, ол да жасайды
Dialogue: 0,0:22:51.41,0:22:54.87,Default,,0,0,0,,Күн сайын барлығы жасайтын GO ату жаттығуларын жасаңыз
Dialogue: 0,0:22:54.95,0:22:58.46,Default,,0,0,0,,GO түсіру жыл бойы, көктемде, жазда, күзде және қыста
Dialogue: 0,0:22:58.54,0:23:00.12,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:23:00.21,0:23:02.67,Default,,0,0,0,,Шығанақ бұлшықеттерін жаттықтыру үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.75,0:23:05.88,Default,,0,0,0,,Сол шиеленіспен біз шарықтау шегіне жетеміз!
Dialogue: 0,0:23:05.96,0:23:09.67,Default,,0,0,0,,Ичи Ни Сан Ши GO түсіріліміне кірісіңіз!
Dialogue: 0,0:23:09.76,0:23:13.18,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Let's Go!
Dialogue: 0,0:23:13.26,0:23:17.02,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Кеттік!
Dialogue: 0,0:23:17.10,0:23:21.94,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:22.02,0:23:24.86,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.02,0:23:24.86,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:24.86,0:23:25.44,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.61,0:23:28.65,Default,,0,0,0,,Мен Фримен осылай шайқасқым келді.
Dialogue: 0,0:23:29.03,0:23:32.66,Default,,0,0,0,,Өте ыстық! Тегін, сен кереметсің!
Dialogue: 0,0:23:33.16,0:23:36.03,Default,,0,0,0,,Бірақ адам сенбейтін нәрсе болады.
Dialogue: 0,0:23:36.12,0:23:38.79,Default,,0,0,0,,Содан кейін Крис өте ауыр шешім қабылдайды.
Dialogue: 0,0:23:39.20,0:23:41.25,Default,,0,0,0,,Бұл өте жаман
Dialogue: 0,0:23:41.62,0:23:43.79,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.88,0:23:46.13,Default,,0,0,0,,Тез кіріңіз! Соңғы шайқас!
Dialogue: 0,0:23:46.38,0:23:49.97,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.47,0:23:57.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory