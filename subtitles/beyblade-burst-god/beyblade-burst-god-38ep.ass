Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.25,0:00:05.42,Default,,0,0,0,,Бейблейд!
Dialogue: 0,0:00:07.00,0:00:09.25,Default,,0,0,0,,Бұл баланың арманы
Dialogue: 0,0:00:09.75,0:00:14.72,Default,,0,0,0,,Дүние жүзінің түкпір-түкпірінен келген пышақшылар шыңға жету үшін жарысады және бір-біріне қарсы жанын салады.
Dialogue: 0,0:00:15.47,0:00:20.47,Default,,0,0,0,,Айналсын, жарылып, жарылсын!
Dialogue: 0,0:00:20.56,0:00:24.06,Default,,0,0,0,,Даңқты жеңіске қол жеткізіңіз!
Dialogue: 0,0:00:24.56,0:00:27.86,Default,,0,0,0,,Шайқастан кейін оны міндетті түрде табасыз.
Dialogue: 0,0:00:27.94,0:00:30.15,Default,,0,0,0,,Жарқын болашақ!
Dialogue: 0,0:00:31.23,0:00:34.57,Default,,0,0,0,,«Кимеру! Ең күшті қуық кім!» Атаңыз.
Dialogue: 0,0:00:34.65,0:00:39.08,Default,,0,0,0,,God Bladers кубогы өтеді!
Dialogue: 0,0:00:39.33,0:00:41.66,Default,,0,0,0,,Турнирге қатысу керемет
Dialogue: 0,0:00:41.75,0:00:45.21,Default,,0,0,0,,Cisco Cuza Мен таңдалдым!
Dialogue: 0,0:00:45.29,0:00:48.59,Default,,0,0,0,,Жарайды, көп жаттығу жасайық! ...Бұл кезде
Dialogue: 0,0:00:48.67,0:00:51.96,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:52.46,0:00:54.97,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:58.22,0:01:01.47,Default,,0,0,0,,Metal Dragon Clash!
Dialogue: 0,0:01:04.23,0:01:05.52,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:05.60,0:01:06.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:06.90,0:01:10.52,Default,,0,0,0,,Олар маған Луиден жеңілген еркін бейнені жіберді.
Dialogue: 0,0:01:10.69,0:01:12.28,Default,,0,0,0,,Сауда?
Dialogue: 0,0:01:12.40,0:01:13.78,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:01:14.53,0:01:16.11,Default,,0,0,0,,Иә? Ха!
Dialogue: 0,0:01:18.45,0:01:20.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:20.45,0:01:21.45,Default,,0,0,0,,Тегін?
Dialogue: 0,0:01:21.53,0:01:23.66,Default,,0,0,0,,Неге?
Dialogue: 0,0:01:24.25,0:01:26.12,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:01:31.42,0:01:34.13,Default,,0,0,0,,♪~
Dialogue: 0,0:01:34.21,0:01:36.72,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:36.80,0:01:39.09,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:39.18,0:01:41.47,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:41.55,0:01:43.97,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:44.06,0:01:45.85,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:45.93,0:01:50.11,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:51.06,0:01:55.82,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:55.90,0:02:00.24,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:00.95,0:02:05.66,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:05.75,0:02:10.71,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:10.79,0:02:15.63,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:15.71,0:02:20.68,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:20.76,0:02:24.10,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:24.18,0:02:25.68,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:25.77,0:02:28.18,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:28.27,0:02:30.69,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:30.77,0:02:32.90,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:32.98,0:02:34.15,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:34.23,0:02:35.57,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:35.65,0:02:38.11,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:38.19,0:02:44.41,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:44.49,0:02:48.91,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:49.00,0:02:51.46,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:51.54,0:02:54.17,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:54.25,0:02:56.71,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:56.80,0:03:00.26,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:56.80,0:03:00.26,Default,,0,0,0,,~♪
Dialogue: 0,0:03:00.26,0:03:00.97,Default,,0,0,0,,~♪
Dialogue: 0,0:03:02.18,0:03:05.22,Default,,0,0,0,,Зұлым машина! Спригган реквиемі!
Dialogue: 0,0:03:06.26,0:03:07.93,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:03:08.02,0:03:09.56,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:09.64,0:03:10.94,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:11.69,0:03:13.73,Default,,0,0,0,,Бұл болды.
Dialogue: 0,0:03:13.90,0:03:17.32,Default,,0,0,0,,«Нью-Йорк Буллздан тегін Де Ла Хойя кете ме?»
Dialogue: 0,0:03:17.40,0:03:18.78,Default,,0,0,0,,Шығу?
Dialogue: 0,0:03:18.86,0:03:23.11,Default,,0,0,0,,«Себебі айтылмады, оның хабарсыз кеткені туралы да ақпарат бар...»
Dialogue: 0,0:03:23.20,0:03:25.45,Default,,0,0,0,,Әй, сен не істеп жатырсың?
Dialogue: 0,0:03:25.53,0:03:29.37,Default,,0,0,0,,Еркін осы қаладан, сондықтан қайтып келген болуы керек.
Dialogue: 0,0:03:29.87,0:03:32.33,Default,,0,0,0,,А, үйге қайтып бара жатырсың ба?
Dialogue: 0,0:03:32.42,0:03:34.50,Default,,0,0,0,,Жоқ, мен қайтып келдім.
Dialogue: 0,0:03:34.58,0:03:37.34,Default,,0,0,0,,Не? Сондықтан сіз бұлай айтып отырсыз, солай ма?
Dialogue: 0,0:03:37.80,0:03:41.17,Default,,0,0,0,,Тегін BC Sol-ға оралды.
Dialogue: 0,0:03:41.88,0:03:44.34,Default,,0,0,0,,О, бұқалар?
Dialogue: 0,0:03:44.59,0:03:47.26,Default,,0,0,0,,Сен әлі еркін баласың.
Dialogue: 0,0:03:48.22,0:03:51.35,Default,,0,0,0,,-де? Әлгі «еркін бала» осында орала ма?
Dialogue: 0,0:03:52.14,0:03:54.77,Default,,0,0,0,,Бұл ерікті шешім.
Dialogue: 0,0:03:55.86,0:03:57.48,Default,,0,0,0,,Фофофу
Dialogue: 0,0:03:57.57,0:04:00.32,Default,,0,0,0,,Бұл шынымен де балаға ұқсайды.
Dialogue: 0,0:04:01.36,0:04:03.03,Default,,0,0,0,,Айо
Dialogue: 0,0:04:03.11,0:04:05.99,Default,,0,0,0,,Бұл арнайы мәзір. Көп жеңіз.
Dialogue: 0,0:04:06.78,0:04:08.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:10.91,0:04:13.54,Default,,0,0,0,,Ей, ары қарай не істейсің, Еркін?
Dialogue: 0,0:04:13.67,0:04:15.71,Default,,0,0,0,,Сіз қайтадан келесіз, солай ма?
Dialogue: 0,0:04:15.79,0:04:18.92,Default,,0,0,0,,Нью-Йоркте қандай тренингтен өттіңіз?
Dialogue: 0,0:04:19.55,0:04:21.26,Default,,0,0,0,,Тегін!
Dialogue: 0,0:04:21.84,0:04:25.51,Default,,0,0,0,,Маған сенің қайда бара жатқаның бәрібір.
Dialogue: 0,0:04:25.59,0:04:28.76,Default,,0,0,0,,Мен сізге өткен жолы қарызымды қайтарамын.
Dialogue: 0,0:04:29.26,0:04:30.81,Default,,0,0,0,,Менімен шайқас!
Dialogue: 0,0:04:30.89,0:04:32.89,Default,,0,0,0,,Ей, жасырын шықпа!
Dialogue: 0,0:04:33.31,0:04:35.65,Default,,0,0,0,,Иә! Алаңдамаңыз, Cisco!
Dialogue: 0,0:04:36.19,0:04:38.52,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар? Мен біріншімін!
Dialogue: 0,0:04:38.90,0:04:41.53,Default,,0,0,0,,Бұл менмін! (Рантаро) Бұл менмін!
Dialogue: 0,0:04:41.61,0:04:44.86,Default,,0,0,0,,Бұл менмін! Бірінші айтқан адам жеңеді!
Dialogue: 0,0:04:44.95,0:04:50.16,Default,,0,0,0,,(Дауласып жатқан үш адамның дауысы)
Dialogue: 0,0:04:50.49,0:04:52.25,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:04:53.41,0:04:55.04,Default,,0,0,0,,Сәлем! Тыңдаңыз!
Dialogue: 0,0:04:56.50,0:04:58.25,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:04:58.33,0:04:59.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:59.63,0:05:02.34,Default,,0,0,0,,Мен саған қатты ашуландым.
Dialogue: 0,0:05:02.67,0:05:03.80,Default,,0,0,0,,Әпке?
Dialogue: 0,0:05:03.92,0:05:07.64,Default,,0,0,0,,Осы уақытқа дейін тынбай еңбек еттік.
Dialogue: 0,0:05:08.05,0:05:11.56,Default,,0,0,0,,Сіз тастап кеткен BC Sol дәстүрін қайтару үшін!
Dialogue: 0,0:05:12.02,0:05:13.64,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:05:13.98,0:05:16.69,Default,,0,0,0,,Әлемдік лиганы жеңіп алды
Dialogue: 0,0:05:17.06,0:05:18.19,Default,,0,0,0,,Сіз мұны жасадыңыз.
Dialogue: 0,0:05:18.77,0:05:20.69,Default,,0,0,0,,Сосын қайтып келдің
Dialogue: 0,0:05:21.23,0:05:23.86,Default,,0,0,0,,Неге! ? неге?
Dialogue: 0,0:05:24.36,0:05:26.32,Default,,0,0,0,,Шаса, сабыр ет.
Dialogue: 0,0:05:26.70,0:05:30.53,Default,,0,0,0,,Ол Луиден жеңіліп, енді Нью-Йорк Буллзда болған жоқ па?
Dialogue: 0,0:05:30.62,0:05:31.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:31.87,0:05:32.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:35.66,0:05:38.08,Default,,0,0,0,,Күтпеңіз және жауап беріңіз!
Dialogue: 0,0:05:40.50,0:05:41.67,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:45.51,0:05:46.76,Default,,0,0,0,,Әпке...
Dialogue: 0,0:05:47.34,0:05:49.47,Default,,0,0,0,,Меніңше, сен асыра айтып отырсың, Шаса.
Dialogue: 0,0:05:49.68,0:05:52.93,Default,,0,0,0,,Еркін қайтып келсе, команда күштірек болар еді...
Dialogue: 0,0:05:53.18,0:05:54.72,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:05:54.81,0:05:57.31,Default,,0,0,0,,Неліктен жүзің мұңаяды?
Dialogue: 0,0:05:57.77,0:05:58.73,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:00.27,0:06:03.90,Default,,0,0,0,,Иә, бәріңіз, мына қолшатырға назар аударыңыздар!
Dialogue: 0,0:06:05.74,0:06:08.49,Default,,0,0,0,,Йо-хо-ха!
Dialogue: 0,0:06:09.24,0:06:13.12,Default,,0,0,0,,Мен әдеттегіден жылдам айналамын.
Dialogue: 0,0:06:13.20,0:06:14.54,Default,,0,0,0,,Оримасу
Dialogue: 0,0:06:15.04,0:06:16.04,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:06:17.08,0:06:18.12,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:18.54,0:06:22.54,Default,,0,0,0,,Керемет, солай ма? Тегін сәлемдесу бір реттік трюк!
Dialogue: 0,0:06:22.63,0:06:27.30,Default,,0,0,0,,Бірақ мен бәрін дайындап қойсам да, шығу қиынға соғып тұрғандай...
Dialogue: 0,0:06:27.38,0:06:29.59,Default,,0,0,0,,Куза клубқа кейінірек қосылды.
Dialogue: 0,0:06:29.68,0:06:31.64,Default,,0,0,0,,Сіз менің сезімімді түсінбейсіз.
Dialogue: 0,0:06:32.14,0:06:36.35,Default,,0,0,0,,Қиын нәрселер туралы ойламаңыз, тек «Мен жасадым!» деп айтыңыз, солай ма?
Dialogue: 0,0:06:36.47,0:06:37.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:37.98,0:06:39.23,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:40.81,0:06:44.32,Default,,0,0,0,,Күн сайын еркін коньки тебушілермен бәсекелесу керемет.
Dialogue: 0,0:06:44.40,0:06:47.61,Default,,0,0,0,,«Күшті болу үшін өзіңнен күшті адамдармен күрес»
Dialogue: 0,0:06:47.69,0:06:48.78,Default,,0,0,0,,Бұл ең жақсы!
Dialogue: 0,0:06:48.86,0:06:52.49,Default,,0,0,0,,Мен сендер сияқты алаңсыз бола алмаймын.
Dialogue: 0,0:06:53.12,0:06:54.95,Default,,0,0,0,,Айтпақшы, сіз кімсіз өзі?
Dialogue: 0,0:06:58.66,0:07:00.87,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммм...
Dialogue: 0,0:07:01.54,0:07:04.42,Default,,0,0,0,,Ха нх хах
Dialogue: 0,0:07:04.75,0:07:07.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:08.38,0:07:09.42,Default,,0,0,0,,Ах
Dialogue: 0,0:07:09.51,0:07:10.63,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:07:11.05,0:07:16.14,Default,,0,0,0,,Ха ха ха ха ха ха
Dialogue: 0,0:07:18.02,0:07:21.31,Default,,0,0,0,,Metal Dragon Clash!
Dialogue: 0,0:07:23.73,0:07:27.44,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:07:27.86,0:07:28.69,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:07:33.78,0:07:34.99,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:36.41,0:07:37.87,Default,,0,0,0,,кеттік досым
Dialogue: 0,0:07:37.95,0:07:39.62,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:49.05,0:07:51.13,Default,,0,0,0,,Мен көбірек шабуыл жасай беремін.
Dialogue: 0,0:07:51.63,0:07:54.30,Default,,0,0,0,,Байланысты қабатты шегіне дейін кеңейтіңіз
Dialogue: 0,0:08:01.02,0:08:02.23,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:02.31,0:08:04.81,Default,,0,0,0,,Тегін! Ақыр соңында мен мұнда келдім
Dialogue: 0,0:08:04.90,0:08:06.44,Default,,0,0,0,,Ол өсуде...
Dialogue: 0,0:08:06.90,0:08:10.69,Default,,0,0,0,,Оны барған сайын толық ашу керек.
Dialogue: 0,0:08:11.07,0:08:13.45,Default,,0,0,0,,Менімен еркін шайқас
Dialogue: 0,0:08:28.92,0:08:30.80,Default,,0,0,0,,Жарайды, менің басым айналып кетті!
Dialogue: 0,0:08:31.13,0:08:32.42,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:36.26,0:08:37.18,Default,,0,0,0,,Ах
Dialogue: 0,0:08:39.85,0:08:41.27,Default,,0,0,0,,Мен қайтып келдім
Dialogue: 0,0:08:43.23,0:08:45.14,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:08:45.69,0:08:46.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:47.27,0:08:48.86,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:08:48.94,0:08:50.98,Default,,0,0,0,,Ух... тағы бір рет!
Dialogue: 0,0:08:56.11,0:08:58.78,Default,,0,0,0,,Әй, тағы бір рет!
Dialogue: 0,0:09:02.91,0:09:05.67,Default,,0,0,0,,Ах! Тағы да!
Dialogue: 0,0:09:06.21,0:09:07.17,Default,,0,0,0,,Иә
Dialogue: 0,0:09:12.30,0:09:13.97,Default,,0,0,0,,Бұл жолы!
Dialogue: 0,0:09:17.59,0:09:19.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:20.26,0:09:21.93,Default,,0,0,0,,Сіз әлі де көңіл-күйіңізді көтере алмайсыз ба?
Dialogue: 0,0:09:22.14,0:09:24.85,Default,,0,0,0,,Ах! Күте тұрыңыз, қайталап көріңіз!
Dialogue: 0,0:09:24.93,0:09:27.56,Default,,0,0,0,,Тағы бір рет! Не?
Dialogue: 0,0:09:27.81,0:09:29.69,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:09:30.19,0:09:31.19,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:34.94,0:09:37.07,Default,,0,0,0,,Хи хи хи хи
Dialogue: 0,0:09:38.28,0:09:40.78,Default,,0,0,0,,Эй... ашық!
Dialogue: 0,0:09:41.03,0:09:43.95,Default,,0,0,0,,Байланысты қабат ашық!
Dialogue: 0,0:09:45.91,0:09:48.46,Default,,0,0,0,,Рахмет саған, Еркін, рахмет саған.
Dialogue: 0,0:09:48.54,0:09:51.92,Default,,0,0,0,,Strike God Chip қосылуы мүмкін!
Dialogue: 0,0:09:52.80,0:09:56.09,Default,,0,0,0,,Сәлем! Джича~н!
Dialogue: 0,0:09:57.38,0:10:00.30,Default,,0,0,0,,(Механикалық электрондық дыбыстар)
Dialogue: 0,0:10:06.14,0:10:09.94,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:10:10.23,0:10:13.40,Default,,0,0,0,,Бірнеше күннен бері осылай болды.
Dialogue: 0,0:10:13.48,0:10:14.94,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:10:15.03,0:10:17.99,Default,,0,0,0,,Бақылау сигналы үзілді
Dialogue: 0,0:10:18.07,0:10:19.82,Default,,0,0,0,,Қазір тоқтатыңыз
Dialogue: 0,0:10:20.36,0:10:22.58,Default,,0,0,0,,Жоқ, жалғастырыңыз.
Dialogue: 0,0:10:22.74,0:10:24.66,Default,,0,0,0,,Ашрам-сама
Dialogue: 0,0:10:24.74,0:10:28.25,Default,,0,0,0,,Сенің қолыңнан келуі керек, Қызыл көз.
Dialogue: 0,0:10:28.33,0:10:31.54,Default,,0,0,0,,Уаааааааааа!
Dialogue: 0,0:10:32.00,0:10:34.09,Default,,0,0,0,,Шу? Шуу!
Dialogue: 0,0:10:34.17,0:10:35.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:37.51,0:10:38.38,Default,,0,0,0,,Барт?
Dialogue: 0,0:10:38.84,0:10:43.14,Default,,0,0,0,,Не болды? Неаполитан аңырап қалды Сіз әлі осындасыз ба?
Dialogue: 0,0:10:43.43,0:10:45.31,Default,,0,0,0,,Дәм дәмі!
Dialogue: 0,0:10:47.98,0:10:49.39,Default,,0,0,0,,Unme~
Dialogue: 0,0:10:49.48,0:10:52.36,Default,,0,0,0,,Өйткені, Шудың неаполитаны - әлемдегі ең жақсы!
Dialogue: 0,0:10:52.44,0:10:54.86,Default,,0,0,0,,Шуды да же!
Dialogue: 0,0:10:56.19,0:10:57.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:57.61,0:11:01.41,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:11:02.24,0:11:04.62,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:11:04.70,0:11:06.45,Default,,0,0,0,,(көтерілген жалын дыбысы)
Dialogue: 0,0:11:09.00,0:11:11.00,Default,,0,0,0,,Сіз шешесіз.
Dialogue: 0,0:11:11.67,0:11:13.88,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:11:14.17,0:11:17.76,Default,,0,0,0,,Мен... Мен...
Dialogue: 0,0:11:19.97,0:11:21.13,Default,,0,0,0,,Мен!
Dialogue: 0,0:11:22.09,0:11:25.22,Default,,0,0,0,,Уф! Ай!
Dialogue: 0,0:11:28.93,0:11:30.48,Default,,0,0,0,,Бұл Спригган!
Dialogue: 0,0:11:31.02,0:11:33.69,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:11:34.23,0:11:35.69,Default,,0,0,0,,Қандай тамаша жауап!
Dialogue: 0,0:11:35.77,0:11:37.98,Default,,0,0,0,,Жақсы, қызыл көз.
Dialogue: 0,0:11:38.15,0:11:40.57,Default,,0,0,0,,Ааааааааа!
Dialogue: 0,0:11:40.90,0:11:42.78,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:11:43.03,0:11:44.37,Default,,0,0,0,,О!
Dialogue: 0,0:11:44.45,0:11:45.87,Default,,0,0,0,,Ааа!
Dialogue: 0,0:11:45.95,0:11:47.33,Default,,0,0,0,,Нуаа!
Dialogue: 0,0:11:47.41,0:11:50.50,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:11:55.38,0:11:56.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:07.26,0:12:08.22,Default,,0,0,0,,Иә
Dialogue: 0,0:12:16.56,0:12:18.86,Default,,0,0,0,,Хмм... иә? а!
Dialogue: 0,0:12:18.94,0:12:20.90,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:12:22.36,0:12:24.74,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:12:47.93,0:12:49.10,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:12:49.89,0:12:51.47,Default,,0,0,0,,Ол аяқталды.
Dialogue: 0,0:12:52.52,0:12:54.85,Default,,0,0,0,,(Машинаны тоқтату)
Dialogue: 0,0:13:07.32,0:13:12.29,Default,,0,0,0,,Бұл сіз жасаған Бей Спригган реквиемі.
Dialogue: 0,0:13:12.83,0:13:16.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:18.04,0:13:19.42,Default,,0,0,0,,Бұл — «mercy rule» (рақымшылдық ережесі) бойынша ойын сол сәтте тоқтатылатынын ұмытпа
Dialogue: 0,0:13:19.50,0:13:21.63,Default,,0,0,0,,Соғыссын...
Dialogue: 0,0:13:22.38,0:13:24.84,Default,,0,0,0,,Маған ұрысуға рұқсат етіңіз!
Dialogue: 0,0:13:26.05,0:13:29.72,Default,,0,0,0,,Бұл құрылғыда дүние жүзіндегі пышақтардың деректері бар.
Dialogue: 0,0:13:30.05,0:13:31.85,Default,,0,0,0,,(голограмма дыбысы)
Dialogue: 0,0:13:34.10,0:13:35.18,Default,,0,0,0,,Луис…
Dialogue: 0,0:13:35.48,0:13:39.23,Default,,0,0,0,,Nightmare Longinus шабуыл түрі солға айналдыру болып табылады.
Dialogue: 0,0:13:39.94,0:13:41.32,Default,,0,0,0,,Қалай күресу керек?
Dialogue: 0,0:13:44.32,0:13:48.28,Default,,0,0,0,,Кел, қызыл көз, бізге күшіңді көрсет!
Dialogue: 0,0:13:49.11,0:13:52.28,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:13:52.95,0:13:56.21,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:59.50,0:14:02.29,Default,,0,0,0,,Біріншіден, сағат тілімен айналу арқылы шабуыл режимі.
Dialogue: 0,0:14:06.88,0:14:09.09,Default,,0,0,0,,Керемет... бір соққыда!
Dialogue: 0,0:14:09.18,0:14:10.34,Default,,0,0,0,,көріп тұрғаныңыздай, кітапхананы қамтиды—
Dialogue: 0,0:14:10.43,0:14:11.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:18.39,0:14:21.15,Default,,0,0,0,,Солға айналудан қорғаныс режимі
Dialogue: 0,0:14:21.48,0:14:22.44,Default,,0,0,0,,Келесі!
Dialogue: 0,0:14:24.53,0:14:26.49,Default,,0,0,0,,Солға айналдыру Төзімділік режимі
Dialogue: 0,0:14:26.57,0:14:27.49,Default,,0,0,0,,Келесі!
Dialogue: 0,0:14:31.62,0:14:32.91,Default,,0,0,0,,(голограмма дыбысы)
Dialogue: 0,0:14:33.62,0:14:35.41,Default,,0,0,0,,Солға айналу шабуыл режимі
Dialogue: 0,0:14:36.70,0:14:39.00,Default,,0,0,0,,Солға және оңға айналу ғана емес
Dialogue: 0,0:14:39.08,0:14:43.04,Default,,0,0,0,,Шабуыл, төзімділік және қорғаныс өзгерістерінің бәрі тамаша.
Dialogue: 0,0:14:43.46,0:14:46.05,Default,,0,0,0,,Кемелдік деңгейі мен күткеннен де жақсы, Ашрам мырза.
Dialogue: 0,0:14:46.92,0:14:50.97,Default,,0,0,0,,Спригган-Реквиемді әлемдегі ең күшті шығанаққа айналдыру
Dialogue: 0,0:14:51.05,0:14:54.01,Default,,0,0,0,,Енді мен оған соңғы нүктені қоямын.
Dialogue: 0,0:14:58.48,0:15:00.06,Default,,0,0,0,,Әпке?
Dialogue: 0,0:15:00.94,0:15:02.86,Default,,0,0,0,,Бұл жеткізу.
Dialogue: 0,0:15:03.81,0:15:05.98,Default,,0,0,0,,Тітіркенгенде тәтті тағам
Dialogue: 0,0:15:06.40,0:15:08.15,Default,,0,0,0,,Мен пудинг жасадым.
Dialogue: 0,0:15:08.69,0:15:10.32,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:10.70,0:15:12.16,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:15:12.24,0:15:15.16,Default,,0,0,0,,Уау~ Дәмді көрінеді!
Dialogue: 0,0:15:16.66,0:15:18.83,Default,,0,0,0,,Шаса да иә
Dialogue: 0,0:15:21.04,0:15:22.88,Default,,0,0,0,,...
Dialogue: 0,0:15:23.46,0:15:25.54,Default,,0,0,0,,Хмм, дәмді!
Dialogue: 0,0:15:27.84,0:15:31.26,Default,,0,0,0,,Шаса жаман емес, ашулануы табиғи нәрсе.
Dialogue: 0,0:15:32.22,0:15:34.85,Default,,0,0,0,,Бірақ... бәрі бақытты болды.
Dialogue: 0,0:15:35.64,0:15:37.93,Default,,0,0,0,,Сіз ұжымның қамын ойлайтын жақсы баласыз.
Dialogue: 0,0:15:38.39,0:15:40.85,Default,,0,0,0,,Сондықтан мұңаймаңыз, сенімді болыңыз
Dialogue: 0,0:15:40.94,0:15:43.69,Default,,0,0,0,,Ендеше тағы да бір-бірімізді дұрыстап соқтығысайық.
Dialogue: 0,0:15:44.10,0:15:45.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:46.07,0:15:47.61,Default,,0,0,0,,Жүр, тамақ іш!
Dialogue: 0,0:15:50.74,0:15:51.74,Default,,0,0,0,,Дәмді
Dialogue: 0,0:15:51.82,0:15:53.61,Default,,0,0,0,,Дұрыс? Керемет!
Dialogue: 0,0:15:56.78,0:15:59.66,Default,,0,0,0,,Неге болмасқа?
Dialogue: 0,0:15:59.91,0:16:01.87,Default,,0,0,0,,Неге сонша ашық?
Dialogue: 0,0:16:02.46,0:16:05.04,Default,,0,0,0,,Бұл тағы бір дем алған сияқты.
Dialogue: 0,0:16:05.13,0:16:06.96,Default,,0,0,0,,Әлі де көп жұмыс!
Dialogue: 0,0:16:07.29,0:16:08.46,Default,,0,0,0,,Э~?
Dialogue: 0,0:16:08.63,0:16:10.09,Default,,0,0,0,,Тегін
Dialogue: 0,0:16:10.51,0:16:12.05,Default,,0,0,0,,Саған айтар сөзім бар.
Dialogue: 0,0:16:12.42,0:16:14.30,Default,,0,0,0,,Апа, тоқтайық.
Dialogue: 0,0:16:14.55,0:16:15.55,Default,,0,0,0,,Аузыңды жап
Dialogue: 0,0:16:15.84,0:16:17.47,Default,,0,0,0,,Эй, сен маған айта аласың ба?
Dialogue: 0,0:16:18.14,0:16:19.06,Default,,0,0,0,,Не?
Dialogue: 0,0:16:19.43,0:16:22.10,Default,,0,0,0,,Мен сенің шынайы сезімдеріңді білгім келеді
Dialogue: 0,0:16:22.18,0:16:24.77,Default,,0,0,0,,Клубқа қайтып оралуға шын ниетіңіз бар ма? Немесе...
Dialogue: 0,0:16:27.06,0:16:31.03,Default,,0,0,0,,Егер біз тағы да қысылып қалсақ, сіз бір жерге қашуды жоспарлап отырсыз ба?
Dialogue: 0,0:16:31.11,0:16:32.53,Default,,0,0,0,,Сен қалай ойлайсың?
Dialogue: 0,0:16:32.99,0:16:34.28,Default,,0,0,0,,Сәлем Шаса!
Dialogue: 0,0:16:35.03,0:16:36.32,Default,,0,0,0,,(Нәрсенің төгілу дыбысы)
Dialogue: 0,0:16:36.70,0:16:39.79,Default,,0,0,0,,Онда мен сені мүлдем қабылдамаймын.
Dialogue: 0,0:16:40.20,0:16:42.87,Default,,0,0,0,,Жоқ, Тегін ондай емес!
Dialogue: 0,0:16:43.46,0:16:44.87,Default,,0,0,0,,Балт үндемейді.
Dialogue: 0,0:16:45.00,0:16:49.21,Default,,0,0,0,,Еркін Б.С. Сольді жақсы көрді және оны өте маңызды деп санады.
Dialogue: 0,0:16:49.50,0:16:51.05,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:16:51.13,0:16:54.17,Default,,0,0,0,,Ақыр аяғында кететін болсаң, қайтып келгеніңді қаламаймын.
Dialogue: 0,0:16:54.55,0:16:56.93,Default,,0,0,0,,Тегін BC Sol қазірдің өзінде...
Dialogue: 0,0:16:57.01,0:16:59.22,Default,,0,0,0,,Сіз толығымен өзіңізге арқа сүйейтін команда емессіз бе?
Dialogue: 0,0:17:03.60,0:17:06.31,Default,,0,0,0,,Шаса шайқасайық
Dialogue: 0,0:17:06.60,0:17:07.60,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:08.48,0:17:09.57,Default,,0,0,0,,Шайқас?
Dialogue: 0,0:17:12.94,0:17:15.45,Default,,0,0,0,,Еркіннен шайқасқа қалай бардың...
Dialogue: 0,0:17:15.53,0:17:16.74,Default,,0,0,0,,Бұл менің бірінші рет
Dialogue: 0,0:17:16.99,0:17:21.66,Default,,0,0,0,,Сіз соңғы рет Корольдік клубқа қарсы ойында диагональ бойынша соққы жасадыңыз.
Dialogue: 0,0:17:22.75,0:17:26.75,Default,,0,0,0,,Төзімділікке қарамастан, бұл орталық сахнаға шықпай-ақ жылдамдық ойыны.
Dialogue: 0,0:17:28.50,0:17:30.84,Default,,0,0,0,,Бұл өте қызықты болды.
Dialogue: 0,0:17:33.17,0:17:37.43,Default,,0,0,0,,Бірақ мұндай жылдамдықта сіз ең жақсы пышақтарды жеңе алмайсыз.
Dialogue: 0,0:17:42.85,0:17:45.52,Default,,0,0,0,,Тегін жеңіс
Dialogue: 0,0:17:45.60,0:17:46.56,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:17:47.27,0:17:48.31,Default,,0,0,0,,Соңы?
Dialogue: 0,0:17:48.56,0:17:50.36,Default,,0,0,0,,Тағы да жоқ!
Dialogue: 0,0:17:50.77,0:17:51.77,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:55.65,0:17:57.45,Default,,0,0,0,,Тегін ұтыс
Dialogue: 0,0:17:58.74,0:18:00.12,Default,,0,0,0,,Тағы да
Dialogue: 0,0:18:00.20,0:18:02.12,Default,,0,0,0,,О! Дәл солай!
Dialogue: 0,0:18:02.20,0:18:04.41,Default,,0,0,0,,Үлкен апа ешқашан берілмейді
Dialogue: 0,0:18:04.50,0:18:05.66,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:18:07.08,0:18:08.46,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:18:10.00,0:18:11.25,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:18:15.46,0:18:17.05,Default,,0,0,0,,Тегін ұтыс
Dialogue: 0,0:18:17.42,0:18:18.59,Default,,0,0,0,,Тағы бір рет!
Dialogue: 0,0:18:19.13,0:18:21.80,Default,,0,0,0,,Ха, қолыңды да, аяғыңды да шығаруға болмайды.
Dialogue: 0,0:18:22.22,0:18:24.35,Default,,0,0,0,,Қабілетте тым көп айырмашылық бар.
Dialogue: 0,0:18:24.81,0:18:27.52,Default,,0,0,0,,Бірақ неліктен Freelance мұндай матчқа ие?
Dialogue: 0,0:18:27.77,0:18:28.94,Default,,0,0,0,,Тегін…
Dialogue: 0,0:18:37.49,0:18:39.66,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:18:39.74,0:18:41.78,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:18:42.37,0:18:43.74,Default,,0,0,0,,Бұл шектеуге жақын ба?
Dialogue: 0,0:18:44.24,0:18:46.91,Default,,0,0,0,,Бұл дұрыс емес! Әлі алда
Dialogue: 0,0:18:47.33,0:18:49.29,Default,,0,0,0,,Сәттілік, апа!
Dialogue: 0,0:18:49.37,0:18:51.13,Default,,0,0,0,,Сәттілік Шаса!
Dialogue: 0,0:18:51.21,0:18:53.71,Default,,0,0,0,,Өйткені, еркіндік күшті!
Dialogue: 0,0:18:53.79,0:18:55.00,Default,,0,0,0,,Тағы бір рет!
Dialogue: 0,0:18:55.42,0:18:57.88,Default,,0,0,0,,Аяғыңызды көбірек ашып, ауырлық центріңізді төмендетіңіз
Dialogue: 0,0:18:57.97,0:18:58.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:59.01,0:19:01.97,Default,,0,0,0,,Денеңіздің тұрақсыз осі біршама тұрақты болады.
Dialogue: 0,0:19:06.93,0:19:11.98,Default,,0,0,0,,Бұлшықет күші жеткіліксіз, сондықтан денеңізді бұраңыз және қолыңызды көп қолданыңыз.
Dialogue: 0,0:19:13.98,0:19:18.74,Default,,0,0,0,,Сондай-ақ, егер сіз қиғаш ағынды пайдалансаңыз, оны көбірек бұрышқа орнатыңыз.
Dialogue: 0,0:19:23.70,0:19:25.28,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:19:25.58,0:19:28.75,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:29.00,0:19:31.46,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:34.17,0:19:35.63,Default,,0,0,0,,Жылдамдық артты!
Dialogue: 0,0:19:35.71,0:19:37.71,Default,,0,0,0,,Керемет (жаным) Они-чан!
Dialogue: 0,0:19:39.97,0:19:41.18,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:41.72,0:19:42.97,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:19:43.51,0:19:45.80,Default,,0,0,0,,Тегін кеңес береді.
Dialogue: 0,0:19:54.02,0:19:56.57,Default,,0,0,0,,Тегін жеңіс!
Dialogue: 0,0:19:57.15,0:19:58.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:58.32,0:19:59.53,Default,,0,0,0,,Әпке!
Dialogue: 0,0:20:00.03,0:20:01.86,Default,,0,0,0,,Бұл қызық болды, Шаса.
Dialogue: 0,0:20:01.95,0:20:04.95,Default,,0,0,0,,Шынымды айтсам, мен бір сәт еркін конькиде жеңемін деп ойладым.
Dialogue: 0,0:20:06.99,0:20:09.49,Default,,0,0,0,,Куу~! Бұл жиіркенішті!
Dialogue: 0,0:20:09.58,0:20:10.45,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:12.25,0:20:13.92,Default,,0,0,0,,Жеңіске жету қызық
Dialogue: 0,0:20:15.33,0:20:17.88,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл анық!
Dialogue: 0,0:20:20.42,0:20:21.38,Default,,0,0,0,,Иә
Dialogue: 0,0:20:22.51,0:20:25.14,Default,,0,0,0,,Тегін қош келдіңіз
Dialogue: 0,0:20:26.39,0:20:27.64,Default,,0,0,0,,Ihi~
Dialogue: 0,0:20:28.31,0:20:29.47,Default,,0,0,0,,Қайта оралуыңмен!
Dialogue: 0,0:20:29.89,0:20:31.81,Default,,0,0,0,,Э? Не? Мен тыңдамаппын.
Dialogue: 0,0:20:36.61,0:20:37.61,Default,,0,0,0,,Не?
Dialogue: 0,0:20:39.19,0:20:40.36,Default,,0,0,0,,Зуко!
Dialogue: 0,0:20:40.78,0:20:43.61,Default,,0,0,0,,Бұл жерде сіз «Мен үйдемін» дейсіз бе?
Dialogue: 0,0:20:44.03,0:20:44.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:45.36,0:20:47.32,Default,,0,0,0,,Ал... Мен үйдемін.
Dialogue: 0,0:20:48.83,0:20:51.37,Default,,0,0,0,,А... хахахахаха
Dialogue: 0,0:20:51.45,0:20:55.62,Default,,0,0,0,,Хахахахахахаха
Dialogue: 0,0:20:55.71,0:20:57.29,Default,,0,0,0,,Ахаха
Dialogue: 0,0:21:01.67,0:21:04.38,Default,,0,0,0,,Сәлем! Қай жерде тегін!
Dialogue: 0,0:21:05.38,0:21:07.39,Default,,0,0,0,,Жасырынба, шық!
Dialogue: 0,0:21:07.72,0:21:11.43,Default,,0,0,0,,Сәлем! Келесі жолы сенімен шайқасайық~
Dialogue: 0,0:21:11.85,0:21:13.52,Default,,0,0,0,,Эй, тегін нұсқаны көрдіңіз бе?
Dialogue: 0,0:21:13.81,0:21:15.14,Default,,0,0,0,,Мұнда да жоқ
Dialogue: 0,0:21:16.10,0:21:17.40,Default,,0,0,0,,Тегін сыйлықтар бар ма?
Dialogue: 0,0:21:17.81,0:21:19.06,Default,,0,0,0,,Ол жоқ.
Dialogue: 0,0:21:19.15,0:21:22.36,Default,,0,0,0,,Мен оның қайтадан жоғалып кеткеніне сенбеймін, солай ма?
Dialogue: 0,0:21:22.48,0:21:27.78,Default,,0,0,0,,(Тегін іздеп жүргендердің дауысы)
Dialogue: 0,0:21:28.70,0:21:31.74,Default,,0,0,0,,Сіз өте танымал болдыңыз.
Dialogue: 0,0:21:31.83,0:21:34.54,Default,,0,0,0,,Мен кеңес бермедім.
Dialogue: 0,0:21:34.83,0:21:36.37,Default,,0,0,0,,Суық, солай емес пе?
Dialogue: 0,0:21:36.46,0:21:39.08,Default,,0,0,0,,Барлығы сенімен шайқасқысы келеді
Dialogue: 0,0:21:39.17,0:21:40.92,Default,,0,0,0,,Мен жалғызбын жақсымын
Dialogue: 0,0:21:41.21,0:21:43.42,Default,,0,0,0,,Сәлем (Тегін) Не?
Dialogue: 0,0:21:43.80,0:21:45.92,Default,,0,0,0,,Сіз Луиді келесіде жеңе аласыз деп ойлайсыз ба?
Dialogue: 0,0:21:46.47,0:21:49.01,Default,,0,0,0,,Қарсылас кім болса да, мен жеңемін.
Dialogue: 0,0:21:50.51,0:21:55.35,Default,,0,0,0,,Ей, еркін шайқас болсын!
Dialogue: 0,0:21:55.56,0:21:56.52,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.52,0:22:00.06,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.52,0:22:00.06,Default,,0,0,0,,Жарайсыңдар Ұлдар мен Қыздар Сіз бұлшық еттеріңізді шынықтырасыз ба?
Dialogue: 0,0:22:00.15,0:22:03.07,Default,,0,0,0,,Енді, күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:03.15,0:22:07.03,Default,,0,0,0,,Қозғалыс 1-нұсқаға қарағанда қарқындырақ. Алдымен алдыңғы эпизодты және көрсетілім уақытын қарастырайық.
Dialogue: 0,0:22:07.11,0:22:10.70,Default,,0,0,0,,GO Shoot GO Shoot Great Shoot!
Dialogue: 0,0:22:10.78,0:22:14.41,Default,,0,0,0,,GO Shoot GO Shoot Жылдамдығыңызды арттырыңыз!
Dialogue: 0,0:22:14.49,0:22:18.00,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:18.08,0:22:21.50,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:21.59,0:22:24.88,Default,,0,0,0,,Хахахаха Бұл жақсы емес пе? Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.96,0:22:28.88,Default,,0,0,0,,Бірақ бұл жерден күшейе түседі, мен қолдарымды және кернеуімді арттырамын.
Dialogue: 0,0:22:28.97,0:22:32.85,Default,,0,0,0,,GO Shoot GO Shoot Bay Muscle Train Моримори
Dialogue: 0,0:22:32.93,0:22:36.39,Default,,0,0,0,,АЛУ АТТЫ БАР АТТЫ Менің атыс – құдайдың атысы
Dialogue: 0,0:22:36.48,0:22:40.19,Default,,0,0,0,,Оңға ату Солға ату Оңға ату
Dialogue: 0,0:22:40.27,0:22:43.94,Default,,0,0,0,,Сол жақ ату Оң жақ ату Сол жақта ату
Dialogue: 0,0:22:44.02,0:22:47.57,Default,,0,0,0,,Өткен аптада Осы аптада GO түсірілімін жасап жатырмыз
Dialogue: 0,0:22:47.65,0:22:51.32,Default,,0,0,0,,Осы аптада келесі аптада GO түсіру, ол да жасайды
Dialogue: 0,0:22:51.41,0:22:55.12,Default,,0,0,0,,Күн сайын барлығы жасайтын GO ату жаттығуларын жасаңыз
Dialogue: 0,0:22:55.20,0:22:58.54,Default,,0,0,0,,GO түсіру жыл бойы, көктемде, жазда, күзде және қыста
Dialogue: 0,0:22:58.62,0:23:00.17,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:23:00.25,0:23:02.75,Default,,0,0,0,,Шығанақ бұлшықеттерін жаттықтыру үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.83,0:23:05.96,Default,,0,0,0,,Сол шиеленіспен біз шарықтау шегіне жетеміз!
Dialogue: 0,0:23:06.05,0:23:09.80,Default,,0,0,0,,Ичи Ни Сан Ши GO түсіріліміне кірісіңіз!
Dialogue: 0,0:23:09.88,0:23:13.26,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Let's Go!
Dialogue: 0,0:23:13.35,0:23:17.10,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Кеттік!
Dialogue: 0,0:23:17.18,0:23:20.02,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:20.02,0:23:22.02,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:20.02,0:23:22.02,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.02,0:23:22.10,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.10,0:23:25.23,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.10,0:23:25.23,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:25.23,0:23:25.57,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.65,0:23:31.03,Default,,0,0,0,,Жер асты әлемі? Бұл қорқынышты көрінеді, бірақ керемет көрінеді
Dialogue: 0,0:23:31.11,0:23:36.16,Default,,0,0,0,,Неліктен әлемдегі ең күшті және аты аңызға айналған чемпион жер астында жекпе-жек өткізеді?
Dialogue: 0,0:23:36.66,0:23:39.45,Default,,0,0,0,,Beat Kukulkan Бұл керемет емес пе!
Dialogue: 0,0:23:39.54,0:23:40.71,Default,,0,0,0,,Өртеніп жатыр!
Dialogue: 0,0:23:41.37,0:23:43.63,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.71,0:23:45.75,Default,,0,0,0,,Император Курц жерасты шайқасы!
Dialogue: 0,0:23:45.84,0:23:49.84,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.34,0:23:57.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory