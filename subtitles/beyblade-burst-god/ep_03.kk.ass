Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.25,0:00:07.04,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:07.13,0:00:10.13,Default,,0,0,0,,Бұл шайқасқа арналған күнжіт тұқымын қолданатын спорт түрі.
Dialogue: 0,0:00:10.21,0:00:15.89,Default,,0,0,0,,Дүние жүзіндегі ұшқыштар шыңға жету үшін жанып жатыр
Dialogue: 0,0:00:15.97,0:00:19.39,Default,,0,0,0,,Чемпион болуды мақсат етіңіз, бірінші нөмірді алыңыз
Dialogue: 0,0:00:20.02,0:00:24.69,Default,,0,0,0,,Сіздің шығанақ сізді шексіз әлемге жетелейді.
Dialogue: 0,0:00:25.02,0:00:29.90,Default,,0,0,0,,Енді армандарыңызға қарай бет алып, әлемге секіріңіз!
Dialogue: 0,0:00:32.61,0:00:34.82,Default,,0,0,0,,Мен Испанияға келдім
Dialogue: 0,0:00:34.90,0:00:38.45,Default,,0,0,0,,Неліктен әр түрлі адамдармен бірінен соң бірі кездесесің?
Dialogue: 0,0:00:38.83,0:00:39.78,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:00:39.87,0:00:42.41,Default,,0,0,0,,Ол бос Де Ла Хойя
Dialogue: 0,0:00:42.50,0:00:45.29,Default,,0,0,0,,Blader әлемде бірінші орында
Dialogue: 0,0:00:46.92,0:00:49.09,Default,,0,0,0,,BC Сольдің қосылу сынағы –
Dialogue: 0,0:00:49.17,0:00:52.17,Default,,0,0,0,,Кумичо екеуміз төбелеспекпіз.
Dialogue: 0,0:00:53.51,0:00:55.72,Default,,0,0,0,,Кимеро Валькири!
Dialogue: 0,0:00:55.80,0:00:58.43,Default,,0,0,0,,Қарсы шабуыл!
Dialogue: 0,0:01:00.64,0:01:01.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:01.64,0:01:05.27,Default,,0,0,0,,Год Валькири 2 ұпай
Dialogue: 0,0:01:05.35,0:01:06.81,Default,,0,0,0,,Аои Балттың жеңісі
Dialogue: 0,0:01:06.90,0:01:10.27,Default,,0,0,0,,Мен сізге BC Sol-қа қосылуға рұқсат етемін.
Dialogue: 0,0:01:10.86,0:01:12.32,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:01:12.69,0:01:14.07,Default,,0,0,0,,Сіз де өтесіз.
Dialogue: 0,0:01:14.44,0:01:17.36,Default,,0,0,0,,Мен өттім десе қуанбас едім...
Dialogue: 0,0:01:17.45,0:01:19.20,Default,,0,0,0,,Уа... ха!
Dialogue: 0,0:01:19.28,0:01:21.95,Default,,0,0,0,,Мен саған жақынырақ қарағым келді.
Dialogue: 0,0:01:22.33,0:01:23.50,Default,,0,0,0,,Барт
Dialogue: 0,0:01:23.58,0:01:24.66,Default,,0,0,0,,Кумичо
Dialogue: 0,0:01:25.12,0:01:27.87,Default,,0,0,0,,Біз тағы бір командадамыз.
Dialogue: 0,0:01:28.46,0:01:31.00,Default,,0,0,0,,♪~
Dialogue: 0,0:01:31.09,0:01:33.63,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:33.71,0:01:36.22,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:36.30,0:01:38.80,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:38.89,0:01:41.26,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:41.35,0:01:42.85,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:01:42.93,0:01:47.10,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:01:48.06,0:01:52.82,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:01:52.90,0:01:57.40,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:01:57.90,0:02:02.66,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:02.95,0:02:07.66,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:07.75,0:02:12.63,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:12.71,0:02:17.80,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:17.88,0:02:21.09,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:21.18,0:02:23.18,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:23.26,0:02:25.31,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:25.39,0:02:27.68,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:27.77,0:02:29.77,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:29.85,0:02:31.06,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:31.15,0:02:32.81,Default,,0,0,0,,Үш екі, бір ату
Dialogue: 0,0:02:32.90,0:02:35.32,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:35.40,0:02:41.45,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:02:41.53,0:02:45.79,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:02:45.87,0:02:48.20,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:02:48.62,0:02:51.04,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:51.12,0:02:53.63,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:53.71,0:02:55.75,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:55.75,0:02:57.71,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:02:55.75,0:02:57.71,Default,,0,0,0,,~♪
Dialogue: 0,0:02:59.17,0:03:02.47,Default,,0,0,0,,Шок! Фафнирді төгіп тастаңыз!
Dialogue: 0,0:03:07.85,0:03:11.56,Default,,0,0,0,,Біз Сольдің жатақханасына көшеміз.
Dialogue: 0,0:03:14.90,0:03:18.86,Default,,0,0,0,,Ішіңізде әрқашан Бейбатт болуы мүмкін.
Dialogue: 0,0:03:22.16,0:03:26.62,Default,,0,0,0,,Біз екінші командамыз, Кит және кіші топ.
Dialogue: 0,0:03:26.70,0:03:28.45,Default,,0,0,0,,Егер сіз мұнда жақсы жұмыс жасасаңыз...
Dialogue: 0,0:03:28.54,0:03:31.16,Default,,0,0,0,,Сіз жоғарғы командаға көтеріле аласыз.
Dialogue: 0,0:03:32.21,0:03:34.00,Default,,0,0,0,,Бұл біздің бөлме
Dialogue: 0,0:03:34.13,0:03:37.92,Default,,0,0,0,,Мен Кумичо мен Китпен бір бөлмеде болдым.
Dialogue: 0,0:03:39.55,0:03:43.64,Default,,0,0,0,,(Оятқыштың шырылдау дыбысы)
Dialogue: 0,0:03:45.68,0:03:49.27,Default,,0,0,0,,
Dialogue: 0,0:03:49.35,0:03:53.27,Default,,0,0,0,,
Dialogue: 0,0:03:53.90,0:03:57.86,Default,,0,0,0,,Шулы болса да неге оянбаймын деп ойлаймын.
Dialogue: 0,0:03:57.94,0:04:00.03,Default,,0,0,0,,Анадан бөлмені ауыстыруды сұрайық.
Dialogue: 0,0:04:04.49,0:04:07.08,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:07.33,0:04:09.33,Default,,0,0,0,,Уау! !
Dialogue: 0,0:04:10.95,0:04:12.96,Default,,0,0,0,,Қайырлы таң… Жинақ
Dialogue: 0,0:04:13.12,0:04:15.33,Default,,0,0,0,,Жарайды... бұл таң тамаша.
Dialogue: 0,0:04:16.17,0:04:19.38,Default,,0,0,0,,Барлық жапондықтар ояну үшін мұны істеу керек пе?
Dialogue: 0,0:04:25.47,0:04:27.26,Default,,0,0,0,,Қайырлы таң Андж-сан
Dialogue: 0,0:04:27.35,0:04:28.68,Default,,0,0,0,,Түрлі оқиғаларға араласып жүріп—
Dialogue: 0,0:04:28.89,0:04:31.47,Default,,0,0,0,,Қайырлы таң Балто Кумичо
Dialogue: 0,0:04:31.56,0:04:35.44,Default,,0,0,0,,Мен кеше Андждың орнына анамды қолдана аламын деп айтпадым ба?
Dialogue: 0,0:04:35.73,0:04:38.23,Default,,0,0,0,,Түсіндім! қайырлы таң анашым
Dialogue: 0,0:04:38.31,0:04:39.48,Default,,0,0,0,,екінші Кира тек бет-әлпетке қарап кісі өлтіре алатынын көрсетеді.
Dialogue: 0,0:04:39.82,0:04:41.94,Default,,0,0,0,,Әркімнің анасы, қуанышым
Dialogue: 0,0:04:42.03,0:04:43.99,Default,,0,0,0,,
Dialogue: 0,0:04:44.07,0:04:46.61,Default,,0,0,0,,Кел, Кит Шан.
Dialogue: 0,0:04:46.74,0:04:47.95,Default,,0,0,0,,Шынымен.
Dialogue: 0,0:04:48.24,0:04:50.99,Default,,0,0,0,,Мен өзімнің ұлым болғандықтан, оған мүлдем көмектесе алмаймын.
Dialogue: 0,0:04:51.08,0:04:53.25,Default,,0,0,0,,Қатал ана
Dialogue: 0,0:04:53.33,0:04:55.33,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:04:57.17,0:04:58.25,Default,,0,0,0,,Бұл Крис
Dialogue: 0,0:04:58.33,0:04:59.25,Default,,0,0,0,,Не?
Dialogue: 0,0:04:59.84,0:05:02.59,Default,,0,0,0,,Қайырлы таң, Bladers of BC Sol
Dialogue: 0,0:05:02.67,0:05:04.30,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:05:04.88,0:05:09.01,Default,,0,0,0,,Кеса Реал Самбат мені жолдастық кездесуге шақырды.
Dialogue: 0,0:05:09.30,0:05:11.51,Default,,0,0,0,,
Dialogue: 0,0:05:11.72,0:05:13.52,Default,,0,0,0,,«Сирек кездесетін соққы қап»?
Dialogue: 0,0:05:13.73,0:05:16.10,Default,,0,0,0,,Бұл қазір ең күшті команда.
Dialogue: 0,0:05:16.39,0:05:19.44,Default,,0,0,0,,Күшті жүзді көп жинап жатыр дейді.
Dialogue: 0,0:05:19.69,0:05:20.77,Default,,0,0,0,,Иә
Dialogue: 0,0:05:21.40,0:05:24.28,Default,,0,0,0,,Менің БК Солымның бас тартуына ешқандай себеп жоқ.
Dialogue: 0,0:05:24.57,0:05:26.78,Default,,0,0,0,,Әрине, мен жақсы дедім.
Dialogue: 0,0:05:27.03,0:05:30.12,Default,,0,0,0,,Сәлем, сәлем, мен көрінгім келеді! Әйтеуір матч!
Dialogue: 0,0:05:30.20,0:05:33.16,Default,,0,0,0,,Біз шыққаннан кейін біз жеңілмеспіз.
Dialogue: 0,0:05:36.54,0:05:38.37,Default,,0,0,0,,Тек рұқсатпен сөйлесіңіз
Dialogue: 0,0:05:38.46,0:05:40.17,Default,,0,0,0,,және «Нағыз самбат»
Dialogue: 0,0:05:40.63,0:05:42.84,Default,,0,0,0,,Менің бұйрығым жеңіске жету.
Dialogue: 0,0:05:43.30,0:05:44.26,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:05:44.76,0:05:46.92,Default,,0,0,0,,Матч 10 күннен кейін өтеді деп шешілді.
Dialogue: 0,0:05:47.09,0:05:48.30,Default,,0,0,0,,Сонымен бүгін
Dialogue: 0,0:05:48.38,0:05:51.26,Default,,0,0,0,,Реал Самбатқа қарсы матчқа ойыншыларды таңдау -
Dialogue: 0,0:05:51.39,0:05:52.89,Default,,0,0,0,,Тест өткізуді шештік.
Dialogue: 0,0:05:53.22,0:05:55.27,Default,,0,0,0,,О, тағы бір сынақ?
Dialogue: 0,0:05:55.81,0:05:57.31,Default,,0,0,0,,Бақылау жұмысының мазмұны
Dialogue: 0,0:05:57.77,0:05:59.94,Default,,0,0,0,,Екінші топтан үміткерлерді жұмысқа алу
Dialogue: 0,0:06:00.23,0:06:02.32,Default,,0,0,0,,Оларға үздік командалық тегін конькишілерге қарсы ойнауға мүмкіндік беріңіз
Dialogue: 0,0:06:02.44,0:06:03.57,Default,,0,0,0,,Не!
Dialogue: 0,0:06:04.61,0:06:05.65,Default,,0,0,0,,Тегін?
Dialogue: 0,0:06:09.36,0:06:12.03,Default,,0,0,0,,Бұл тегін ме?
Dialogue: 0,0:06:12.12,0:06:14.33,Default,,0,0,0,,Артқы су қабатында соғысу керек
Dialogue: 0,0:06:14.41,0:06:16.00,Default,,0,0,0,,Байқап көруге тұрарлық.
Dialogue: 0,0:06:16.37,0:06:17.66,Default,,0,0,0,,Осы матчта
Dialogue: 0,0:06:17.75,0:06:21.71,Default,,0,0,0,,Біз сіздің ойыныңызды жан-жақты бағалаймыз және сайыскерлерді анықтаймыз.
Dialogue: 0,0:06:22.63,0:06:25.51,Default,,0,0,0,,Сонымен қатар, жолдастық кездесудің көрсеткіштеріне байланысты
Dialogue: 0,0:06:25.59,0:06:29.22,Default,,0,0,0,,Сізді үздік командаға қосуға болады. Іске сәт.
Dialogue: 0,0:06:29.68,0:06:33.35,Default,,0,0,0,,Жарайды, жасайық. Жоғарғы командаға ұмтылыңыз.
Dialogue: 0,0:06:33.43,0:06:34.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:37.43,0:06:39.44,Default,,0,0,0,,Иә? Ал тегін ше?
Dialogue: 0,0:06:40.69,0:06:41.90,Default,,0,0,0,,Хи-хи
Dialogue: 0,0:06:42.31,0:06:44.23,Default,,0,0,0,,Әдеттегідей, солай емес пе?
Dialogue: 0,0:06:44.32,0:06:47.40,Default,,0,0,0,,Тегін тым еркін, тіпті иесі де мойындайды.
Dialogue: 0,0:06:48.19,0:06:49.82,Default,,0,0,0,,Енді бұл нені білдіреді?
Dialogue: 0,0:06:49.90,0:06:52.28,Default,,0,0,0,,Штаттан тыс жұмыс уақытылы емес.
Dialogue: 0,0:06:52.37,0:06:53.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:53.41,0:06:55.79,Default,,0,0,0,,Крис те, Тред те сақ...
Dialogue: 0,0:06:55.87,0:06:57.41,Default,,0,0,0,,Мен мүлде тыңдамаймын.
Dialogue: 0,0:06:57.54,0:07:00.75,Default,,0,0,0,,Дегенмен, Крис ең қатал адам...
Dialogue: 0,0:07:01.04,0:07:02.25,Default,,0,0,0,,Бұл тегін
Dialogue: 0,0:07:03.79,0:07:06.96,Default,,0,0,0,,Қарсы болмасаң, мен сенің сынақ серіктесің боламын.
Dialogue: 0,0:07:07.05,0:07:08.30,Default,,0,0,0,,Мен тегін күтемін
Dialogue: 0,0:07:09.84,0:07:11.55,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:07:11.63,0:07:12.93,Default,,0,0,0,,Менің Джангом...
Dialogue: 0,0:07:13.18,0:07:15.01,Default,,0,0,0,,Мен сені іздеп жүрмін
Dialogue: 0,0:07:18.77,0:07:20.60,Default,,0,0,0,,Иттетте…
Dialogue: 0,0:07:24.19,0:07:25.40,Default,,0,0,0,,Тегін
Dialogue: 0,0:07:26.11,0:07:28.32,Default,,0,0,0,,Бүгін әлі ерте, солай емес пе?
Dialogue: 0,0:07:28.44,0:07:29.44,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:07:29.74,0:07:30.74,Default,,0,0,0,,Чикоку!
Dialogue: 0,0:07:30.82,0:07:32.74,Default,,0,0,0,,Бірнеше минут?
Dialogue: 0,0:07:32.82,0:07:35.07,Default,,0,0,0,,Дәлірек айтсақ жеті минут 10... Тыңдаңыз!
Dialogue: 0,0:07:35.45,0:07:37.99,Default,,0,0,0,,-де? Мен кіммен ұрысамын?
Dialogue: 0,0:07:39.16,0:07:40.33,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:07:40.87,0:07:42.37,Default,,0,0,0,,О, сен бе?
Dialogue: 0,0:07:42.46,0:07:45.00,Default,,0,0,0,,Мен сенімен күресе аламын, еркін!
Dialogue: 0,0:07:45.88,0:07:48.21,Default,,0,0,0,,Құдай Валькири де сізді күтті.
Dialogue: 0,0:07:48.46,0:07:49.96,Default,,0,0,0,,Көңілді болайық!
Dialogue: 0,0:07:50.51,0:07:52.68,Default,,0,0,0,,Бұл жалықтырады.
Dialogue: 0,0:07:53.01,0:07:56.60,Default,,0,0,0,,Бұл не? Бейбаттлдар қызықты, солай ма?
Dialogue: 0,0:07:56.68,0:08:00.22,Default,,0,0,0,,Қанша рет қолдансаңыз да, жеңсеңіз де, жеңілсеңіз де, бұл өте қызық.
Dialogue: 0,0:08:01.39,0:08:02.73,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:02.94,0:08:04.06,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:08:04.31,0:08:06.31,Default,,0,0,0,,Таңдау сынағы қазір басталады.
Dialogue: 0,0:08:06.86,0:08:08.73,Default,,0,0,0,,Бірінші тұлға – Барто Аои.
Dialogue: 0,0:08:09.19,0:08:09.90,Default,,0,0,0,,О!
Dialogue: 0,0:08:10.11,0:08:12.57,Default,,0,0,0,,Мына жапон жігіті жақсы көрінеді.
Dialogue: 0,0:08:12.65,0:08:17.20,Default,,0,0,0,,Ол кеше ғана қосылды, оның жағдайын көрейік.
Dialogue: 0,0:08:17.53,0:08:19.95,Default,,0,0,0,,Егер сіз бұл тегінде қызып кетсеңіз де
Dialogue: 0,0:08:20.16,0:08:24.92,Default,,0,0,0,,Еркін шайқасты көргеннен кейін оған ұнайтынына сенімдімін.
Dialogue: 0,0:08:25.58,0:08:27.29,Default,,0,0,0,,Кеттік, Валькири
Dialogue: 0,0:08:27.42,0:08:30.00,Default,,0,0,0,,А, бұл сенің...?
Dialogue: 0,0:08:30.30,0:08:31.30,Default,,0,0,0,,О
Dialogue: 0,0:08:31.38,0:08:32.51,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:08:32.84,0:08:35.05,Default,,0,0,0,,Дренфафнир келді
Dialogue: 0,0:08:39.01,0:08:39.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:46.27,0:08:47.65,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:47.73,0:08:49.32,Default,,0,0,0,,Не... Шайқас
Dialogue: 0,0:08:49.57,0:08:50.65,Default,,0,0,0,,Іске қосу құрылғысы туралы не деуге болады?
Dialogue: 0,0:08:51.15,0:08:52.11,Default,,0,0,0,,Пайдаланылмайды
Dialogue: 0,0:08:52.19,0:08:53.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:53.15,0:08:54.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:54.86,0:08:56.49,Default,,0,0,0,,Мен оны қолыммен айналдырамын
Dialogue: 0,0:08:56.70,0:08:58.82,Default,,0,0,0,,Шынайы ма? Қолмен?
Dialogue: 0,0:08:59.20,0:09:02.54,Default,,0,0,0,,Бұлай етпесек, шайқас жақын арада аяқталады.
Dialogue: 0,0:09:02.79,0:09:05.54,Default,,0,0,0,,Не... Не?!
Dialogue: 0,0:09:05.79,0:09:08.96,Default,,0,0,0,,Эй, тез позицияңды ұста, Аои Балт.
Dialogue: 0,0:09:09.71,0:09:11.67,Default,,0,0,0,,Сіз менімен ұрысқыңыз келді, солай ма?
Dialogue: 0,0:09:12.26,0:09:13.59,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:09:13.67,0:09:15.42,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба? неге?
Dialogue: 0,0:09:15.84,0:09:17.89,Default,,0,0,0,,Бұл мен үшін қызық емес
Dialogue: 0,0:09:18.01,0:09:21.56,Default,,0,0,0,,Бейбатт ләззат алатын нәрсе емес пе?
Dialogue: 0,0:09:21.64,0:09:23.39,Default,,0,0,0,,Қарғыс атсын... арх...
Dialogue: 0,0:09:24.27,0:09:25.81,Default,,0,0,0,,Ол әрқашан ма?
Dialogue: 0,0:09:25.89,0:09:27.14,Default,,0,0,0,,Иә
Dialogue: 0,0:09:27.69,0:09:28.81,Default,,0,0,0,,Гууу~
Dialogue: 0,0:09:28.90,0:09:30.73,Default,,0,0,0,,Балто! Жең!
Dialogue: 0,0:09:31.36,0:09:33.07,Default,,0,0,0,,Мен міндетті түрде жеңілмеймін
Dialogue: 0,0:09:33.15,0:09:35.74,Default,,0,0,0,,О, әрине, Кумичо.
Dialogue: 0,0:09:36.45,0:09:37.95,Default,,0,0,0,,Жасайық
Dialogue: 0,0:09:38.53,0:09:40.20,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:09:40.78,0:09:43.49,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:43.83,0:09:45.87,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:49.21,0:09:50.38,Default,,0,0,0,,Солға бұрылыңыз! ?
Dialogue: 0,0:09:50.84,0:09:53.13,Default,,0,0,0,,Иә, сіз оңға бұрыласыз.
Dialogue: 0,0:09:53.63,0:09:55.26,Default,,0,0,0,,Бэйдің басы айналады.
Dialogue: 0,0:09:55.34,0:09:56.38,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:56.47,0:09:58.47,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:09:58.97,0:10:01.60,Default,,0,0,0,,Өйткені, қолмен ату мүмкін емес.
Dialogue: 0,0:10:01.80,0:10:04.02,Default,,0,0,0,,Жоқ, бұл дұрыс емес, Кумичо.
Dialogue: 0,0:10:04.10,0:10:06.85,Default,,0,0,0,,Міне, Drain Fafnir туралы керемет нәрсе
Dialogue: 0,0:10:06.93,0:10:09.15,Default,,0,0,0,,Қайда сонша басың айналады?
Dialogue: 0,0:10:12.69,0:10:14.36,Default,,0,0,0,,Бар, Валькири!
Dialogue: 0,0:10:14.44,0:10:17.74,Default,,0,0,0,,Сол батыр шығанақ, бірден ұшып кетсін
Dialogue: 0,0:10:19.99,0:10:20.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:22.91,0:10:24.12,Default,,0,0,0,,Бұл басталды.
Dialogue: 0,0:10:24.20,0:10:26.20,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:10:30.88,0:10:32.88,Default,,0,0,0,,Бұл өтірік. Неліктен?
Dialogue: 0,0:10:34.96,0:10:37.63,Default,,0,0,0,,Не болып жатыр? Ол тезірек барады!
Dialogue: 0,0:10:37.88,0:10:41.76,Default,,0,0,0,,Drain Fafnir-ге сағат тілімен айналмалы шығанақ шабуыл жасағанда,
Dialogue: 0,0:10:41.84,0:10:45.14,Default,,0,0,0,,Резеңке бөлігі қарсыластың айналу күшін жұтады.
Dialogue: 0,0:10:45.22,0:10:47.27,Default,,0,0,0,,Оны өз күшіңізге айналдырыңыз
Dialogue: 0,0:10:47.35,0:10:49.69,Default,,0,0,0,,Бұл әдіс мүмкін, себебі ол солға айналады.
Dialogue: 0,0:10:50.14,0:10:52.73,Default,,0,0,0,,Сондықтан сізге шабуыл неғұрлым көп болса, соншалықты ...
Dialogue: 0,0:10:52.81,0:10:55.69,Default,,0,0,0,,Бұл сіздің айналу күшіңіз артады дегенді білдіреді.
Dialogue: 0,0:10:55.78,0:10:58.86,Default,,0,0,0,,Бұл төзімділік түрі, сондықтан Фафнирді қалай жеңу керек
Dialogue: 0,0:10:58.94,0:11:00.24,Default,,0,0,0,,Бұл өте қиын
Dialogue: 0,0:11:00.32,0:11:01.28,Default,,0,0,0,,Ей...
Dialogue: 0,0:11:08.00,0:11:09.29,Default,,0,0,0,,Бұл Декү.
Dialogue: 0,0:11:09.37,0:11:11.79,Default,,0,0,0,,Валькиридің айналу күші азайса да
Dialogue: 0,0:11:11.87,0:11:14.79,Default,,0,0,0,,Фафнирдің айналу күші жылдам өсуде.
Dialogue: 0,0:11:16.38,0:11:17.96,Default,,0,0,0,,Орны керісінше.
Dialogue: 0,0:11:23.05,0:11:26.22,Default,,0,0,0,,Drain Fafnir айналдыру арқылы жеңеді
Dialogue: 0,0:11:26.51,0:11:27.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:28.64,0:11:29.56,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:11:32.44,0:11:36.07,Default,,0,0,0,,Қолымен атқан жігіттен жеңіліп қалдым.
Dialogue: 0,0:11:36.44,0:11:38.36,Default,,0,0,0,,Бұл қызық болды
Dialogue: 0,0:11:39.61,0:11:41.61,Default,,0,0,0,,Сіз де көңілді болдыңыз ба?
Dialogue: 0,0:11:41.78,0:11:44.07,Default,,0,0,0,,Сіз шайқас қызықты деп айттыңыз.
Dialogue: 0,0:11:44.37,0:11:46.87,Default,,0,0,0,,Көңілді болсаң, неге көбірек күлмейсің?
Dialogue: 0,0:11:46.95,0:11:48.08,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:11:48.70,0:11:51.91,Default,,0,0,0,,Жеңілгенде де көңіл көтеру әдемі.
Dialogue: 0,0:11:52.75,0:11:55.29,Default,,0,0,0,,Жарыс қызықты, өйткені сіз жеңесіз.
Dialogue: 0,0:11:55.54,0:11:58.71,Default,,0,0,0,,Мен әрқашан жеңемін, Мен әрқашан көңілдімін
Dialogue: 0,0:12:00.13,0:12:01.55,Default,,0,0,0,,О! !
Dialogue: 0,0:12:01.92,0:12:02.84,Default,,0,0,0,,Балто!
Dialogue: 0,0:12:02.93,0:12:05.85,Default,,0,0,0,,Кумичо, мен қатты шаршадым.
Dialogue: 0,0:12:05.93,0:12:07.60,Default,,0,0,0,,Осылай жеңілудің жолы бар ма?
Dialogue: 0,0:12:07.72,0:12:10.31,Default,,0,0,0,,Мен білемін! Мен саған қамқор боламын
Dialogue: 0,0:12:11.18,0:12:13.35,Default,,0,0,0,,Не, бұл жиіркенішті емес пе?
Dialogue: 0,0:12:16.73,0:12:20.53,Default,,0,0,0,,Екіншісі – мен. Жасырыңыз, бұл тегін!
Dialogue: 0,0:12:21.61,0:12:23.07,Default,,0,0,0,,...бірдеңе айт
Dialogue: 0,0:12:23.20,0:12:24.49,Default,,0,0,0,,Сіз де солайсыз ба?
Dialogue: 0,0:12:24.61,0:12:25.49,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:25.57,0:12:29.83,Default,,0,0,0,,Барлық жапондықтар шайқастарды ұната ма?
Dialogue: 0,0:12:30.29,0:12:33.29,Default,,0,0,0,,Сіз шынымен жеңілуді қызық деп ойлайсыз ба?
Dialogue: 0,0:12:33.37,0:12:35.50,Default,,0,0,0,,Иә, бұл Бей.
Dialogue: 0,0:12:35.62,0:12:36.67,Default,,0,0,0,,Хмм.
Dialogue: 0,0:12:37.21,0:12:38.63,Default,,0,0,0,,Олай болса орындайық
Dialogue: 0,0:12:38.79,0:12:39.80,Default,,0,0,0,,О
Dialogue: 0,0:12:40.25,0:12:42.26,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Кумичо
Dialogue: 0,0:12:42.59,0:12:44.26,Default,,0,0,0,,Әй, мұны маған қалдырыңыз.
Dialogue: 0,0:12:44.63,0:12:46.72,Default,,0,0,0,,Рагнарук Кеттік!
Dialogue: 0,0:12:49.35,0:12:51.02,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:51.27,0:12:53.02,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:12:53.27,0:12:56.48,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:56.94,0:12:59.19,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:06.61,0:13:09.03,Default,,0,0,0,,Бұл не, өйткені ол солға айналады!
Dialogue: 0,0:13:09.12,0:13:11.83,Default,,0,0,0,,Нокаут, Рагнарук!
Dialogue: 0,0:13:19.34,0:13:23.17,Default,,0,0,0,,Шынымен... Рагнаруктың күші ұрланып жатыр.
Dialogue: 0,0:13:25.01,0:13:27.05,Default,,0,0,0,,Кумичо жеңді!
Dialogue: 0,0:13:30.47,0:13:32.39,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:13:33.18,0:13:34.56,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:13:34.64,0:13:37.60,Default,,0,0,0,,Төзімділік түрін анықтаңыз
Dialogue: 0,0:13:42.32,0:13:45.19,Default,,0,0,0,,Drain Fafnir айналдыру арқылы жеңеді
Dialogue: 0,0:13:46.20,0:13:48.41,Default,,0,0,0,,Не... мына шығанақ?
Dialogue: 0,0:13:50.87,0:13:53.66,Default,,0,0,0,,Ах! Тағы да жеңдік, қызық
Dialogue: 0,0:13:54.75,0:13:56.87,Default,,0,0,0,,Сіз ше? қызық?
Dialogue: 0,0:13:56.96,0:14:00.17,Default,,0,0,0,,Бұлай жеңілу қызық емес.
Dialogue: 0,0:14:00.50,0:14:03.34,Default,,0,0,0,,Дұрыс, бұл қалыпты жағдай.
Dialogue: 0,0:14:03.71,0:14:05.42,Default,,0,0,0,,Бәсекелестік деген осы.
Dialogue: 0,0:14:08.38,0:14:09.47,Default,,0,0,0,,Тегін…
Dialogue: 0,0:14:09.80,0:14:13.10,Default,,0,0,0,,Осы жалқау жігіттен жеңіліп қалсам ше?
Dialogue: 0,0:14:13.18,0:14:15.27,Default,,0,0,0,,Мен Bay Club-та барлығына шыдай алмаймын.
Dialogue: 0,0:14:15.60,0:14:18.98,Default,,0,0,0,,Енді мен осындамын, мен сені міндетті түрде жеңемін!
Dialogue: 0,0:14:19.69,0:14:21.56,Default,,0,0,0,,Жасырын, тегін
Dialogue: 0,0:14:21.65,0:14:23.19,Default,,0,0,0,,Сонымен, келесі кім?
Dialogue: 0,0:14:23.27,0:14:24.40,Default,,0,0,0,,Ал біз осыншама көп адамды әкелуге сонша күш жұмсадық деп ойласаңшы.➡
Dialogue: 0,0:14:39.50,0:14:40.67,Default,,0,0,0,,(ысқырық дыбысы)
Dialogue: 0,0:14:41.67,0:14:43.04,Default,,0,0,0,,Тест аяқталды.
Dialogue: 0,0:14:43.42,0:14:44.71,Default,,0,0,0,,А... соңы ма?
Dialogue: 0,0:14:47.34,0:14:48.97,Default,,0,0,0,,Күте тұрыңыз, бұл тегін!
Dialogue: 0,0:14:49.30,0:14:52.18,Default,,0,0,0,,Бүгінгі шайқас, мен оны босқа өткізбеймін.
Dialogue: 0,0:14:52.51,0:14:55.93,Default,,0,0,0,,Себебі мен әлемде осындай ғажайып адамдар бар екенін білдім.
Dialogue: 0,0:14:58.68,0:15:02.23,Default,,0,0,0,,Испанияның ең жақсысы Б.С. Сольдің үздіктері
Dialogue: 0,0:15:05.44,0:15:07.74,Default,,0,0,0,,Мырзалар, осы нәтижеге сүйене отырып...
Dialogue: 0,0:15:07.82,0:15:09.24,Default,,0,0,0,,Сайысқа қатысушыларды таңдау
Dialogue: 0,0:15:09.95,0:15:11.70,Default,,0,0,0,,Сәтті үміткерлер болмаса -
Dialogue: 0,0:15:11.78,0:15:14.83,Default,,0,0,0,,Ойыншылар жолдастық кездесулерге қатысу үшін бірінші командадан таңдалуы керек.
Dialogue: 0,0:15:14.91,0:15:16.24,Default,,0,0,0,,Тарту!
Dialogue: 0,0:15:17.33,0:15:18.50,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:15:20.87,0:15:22.92,Default,,0,0,0,,Кумичо, жаттығу жасайық.
Dialogue: 0,0:15:23.00,0:15:24.38,Default,,0,0,0,,А-ри
Dialogue: 0,0:15:24.92,0:15:26.59,Default,,0,0,0,,Жаным, біз де!
Dialogue: 0,0:15:26.67,0:15:28.38,Default,,0,0,0,,Иә! Үлкен әпке де!
Dialogue: 0,0:15:30.22,0:15:31.84,Default,,0,0,0,,Жүр, Валькири!
Dialogue: 0,0:15:31.93,0:15:34.09,Default,,0,0,0,,Жоғалтпа, Рагнарук!
Dialogue: 0,0:15:34.93,0:15:37.31,Default,,0,0,0,,Сіздің пікіріңіз қандай?
Dialogue: 0,0:15:37.68,0:15:39.27,Default,,0,0,0,,Өкінішті, бірақ…
Dialogue: 0,0:15:39.35,0:15:42.27,Default,,0,0,0,,Сізге өту ұпайын бере алатын саптама жоқ.
Dialogue: 0,0:15:42.35,0:15:43.52,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:43.90,0:15:46.02,Default,,0,0,0,,Өйткені, бұл жоғары команда.
Dialogue: 0,0:15:49.07,0:15:51.07,Default,,0,0,0,,Сіз бұл туралы әлі де ойлайсыз ба?
Dialogue: 0,0:15:53.07,0:15:55.37,Default,,0,0,0,,(Телефон дыбысы)
Dialogue: 0,0:15:56.74,0:15:58.87,Default,,0,0,0,,BC Соль иесінің бөлмесі
Dialogue: 0,0:16:00.41,0:16:02.71,Default,,0,0,0,,Нағыз Самбаттың иесінен
Dialogue: 0,0:16:07.00,0:16:09.80,Default,,0,0,0,,Жолдастық кездесуге қатысатын ойыншыларды хабарлау
Dialogue: 0,0:16:10.42,0:16:12.26,Default,,0,0,0,,3 қатысушы бар
Dialogue: 0,0:16:12.47,0:16:14.34,Default,,0,0,0,,Капитан бос
Dialogue: 0,0:16:14.47,0:16:17.43,Default,,0,0,0,,Қалған екі қораптың сынақ нәтижелері
Dialogue: 0,0:16:17.72,0:16:20.64,Default,,0,0,0,,Сонымен қатар, шешім басқа да шарттарды ескере отырып қабылданған.
Dialogue: 0,0:16:21.14,0:16:22.48,Default,,0,0,0,,Иә, сұрақ!
Dialogue: 0,0:16:22.94,0:16:23.94,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:16:24.02,0:16:25.98,Default,,0,0,0,,Тағы қандай шарттар бар?
Dialogue: 0,0:16:26.90,0:16:28.36,Default,,0,0,0,,Жауап берудің қажеті жоқ.
Dialogue: 0,0:16:28.73,0:16:29.98,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:16:30.73,0:16:33.40,Default,,0,0,0,,-де біз тағы екі адамның атын жариялаймыз.
Dialogue: 0,0:16:33.90,0:16:35.49,Default,,0,0,0,,Ең алдымен, Барто Аои
Dialogue: 0,0:16:35.78,0:16:37.49,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:16:38.16,0:16:41.16,Default,,0,0,0,,Иә, иә! Кумичо мен жасадым!
Dialogue: 0,0:16:41.25,0:16:43.00,Default,,0,0,0,,Уау, сен істедің, Балто!
Dialogue: 0,0:16:43.46,0:16:45.79,Default,,0,0,0,,Тағы бір Рантаро Кияма
Dialogue: 0,0:16:46.04,0:16:48.13,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:16:48.21,0:16:50.05,Default,,0,0,0,,Біз кереметпіз
Dialogue: 0,0:16:50.13,0:16:52.42,Default,,0,0,0,,Жарайды, орындадық!
Dialogue: 0,0:16:52.97,0:16:54.55,Default,,0,0,0,,Бұл керемет, Аники!
Dialogue: 0,0:16:54.72,0:16:56.01,Default,,0,0,0,,Екеуіңді де құттықтаймын.
Dialogue: 0,0:16:56.30,0:16:58.47,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:59.05,0:17:00.26,Default,,0,0,0,,Мынау
Dialogue: 0,0:17:00.39,0:17:01.68,Default,,0,0,0,,Күтпеген
Dialogue: 0,0:17:01.97,0:17:03.98,Default,,0,0,0,,Қабылдау критерийлері қандай?
Dialogue: 0,0:17:04.14,0:17:05.27,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:17:05.89,0:17:07.90,Default,,0,0,0,,(бидің лақтырған дыбысы)
Dialogue: 0,0:17:19.87,0:17:21.62,Default,,0,0,0,,(Шөптің сыбдыры)
Dialogue: 0,0:17:33.21,0:17:35.38,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:17:35.47,0:17:39.97,Default,,0,0,0,,Беделді BC Sol командасы көптеген жетістіктерге жетті!
Dialogue: 0,0:17:40.05,0:17:43.22,Default,,0,0,0,,Екінші жағынан, дүние жүзінде назар аударып отырған жаңа тұлға бар.
Dialogue: 0,0:17:43.31,0:17:46.73,Default,,0,0,0,,Нағыз Самбат жолдастық кездесуін бастайық!
Dialogue: 0,0:17:47.06,0:17:48.90,Default,,0,0,0,,Мен тікелей түсініктемемін
Dialogue: 0,0:17:48.98,0:17:51.69,Default,,0,0,0,,Бұл сеньор Анами.
Dialogue: 0,0:17:51.98,0:17:54.40,Default,,0,0,0,,Енді екі команда арасындағы салтанатты рәсімнен бастайық.
Dialogue: 0,0:17:54.53,0:17:58.57,Default,,0,0,0,,Үш өкіл бір-біріне қатты тонмен жақсы шайқас үшін жақындайды.
Dialogue: 0,0:17:59.82,0:18:01.91,Default,,0,0,0,,Тегін Ол әлі жоқ.
Dialogue: 0,0:18:01.99,0:18:03.37,Default,,0,0,0,,Бар ма?
Dialogue: 0,0:18:04.29,0:18:06.71,Default,,0,0,0,,Аруақты көрсең, маған жасырын түспе!
Dialogue: 0,0:18:06.91,0:18:08.67,Default,,0,0,0,,Сіз елес кездестірдіңіз бе?
Dialogue: 0,0:18:08.75,0:18:11.29,Default,,0,0,0,,Сәлем! Жемді қабылдамаңыз
Dialogue: 0,0:18:11.50,0:18:13.42,Default,,0,0,0,,Қуырылған аяқ қандай аяққа жатады?
Dialogue: 0,0:18:13.50,0:18:14.71,Default,,0,0,0,,Ммм!
Dialogue: 0,0:18:14.80,0:18:16.42,Default,,0,0,0,,Салтанатты шара болады.
Dialogue: 0,0:18:16.51,0:18:19.05,Default,,0,0,0,,Маған ол жігіт ұнамайды...
Dialogue: 0,0:18:19.34,0:18:22.89,Default,,0,0,0,,Көп жағдайда мен оны жеңе алмайтынымды сезінбеймін.
Dialogue: 0,0:18:22.97,0:18:27.43,Default,,0,0,0,,Кумичо Менің әдеттегі рухым қайда кетті? Барайық!
Dialogue: 0,0:18:30.19,0:18:31.77,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,0:18:32.19,0:18:35.07,Default,,0,0,0,,Мен білемін, білемін.
Dialogue: 0,0:18:35.15,0:18:36.53,Default,,0,0,0,,Шантосея!
Dialogue: 0,0:18:36.61,0:18:38.53,Default,,0,0,0,,Ақыры құрт келді.
Dialogue: 0,0:18:38.86,0:18:39.78,Default,,0,0,0,,Wa…
Dialogue: 0,0:18:39.86,0:18:40.78,Default,,0,0,0,,Wa…
Dialogue: 0,0:18:40.95,0:18:41.91,Default,,0,0,0,,Ki…
Dialogue: 0,0:18:41.99,0:18:42.74,Default,,0,0,0,,Ki…
Dialogue: 0,0:18:43.58,0:18:45.29,Default,,0,0,0,,Иә, бос сөз айтып тұрсың.
Dialogue: 0,0:18:45.41,0:18:47.00,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:47.08,0:18:49.46,Default,,0,0,0,,Неліктен неге? Вакия Неге?
Dialogue: 0,0:18:49.79,0:18:52.08,Default,,0,0,0,,Кетіліп қалмаңыз, ренжітеді
Dialogue: 0,0:18:52.42,0:18:54.63,Default,,0,0,0,,Әй, сен мұнда не істеп жүрсің?
Dialogue: 0,0:18:54.80,0:18:57.26,Default,,0,0,0,,Эххехе мен саған үйретемін.
Dialogue: 0,0:18:57.34,0:19:00.22,Default,,0,0,0,,Waihana Real Sambat иесі және...
Dialogue: 0,0:19:00.30,0:19:02.26,Default,,0,0,0,,Мен ойын менеджері болдым!
Dialogue: 0,0:19:02.43,0:19:03.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:04.72,0:19:06.22,Default,,0,0,0,,нені білдіреді?
Dialogue: 0,0:19:06.85,0:19:10.73,Default,,0,0,0,,Ұзын сөздің қысқасы, мен Нағыз Самбатты сатып алдым.
Dialogue: 0,0:19:11.10,0:19:12.35,Default,,0,0,0,,Кота?
Dialogue: 0,0:19:12.48,0:19:13.98,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:19:14.06,0:19:16.86,Default,,0,0,0,,Бүгін менің команда ретінде дебюттік күнім.
Dialogue: 0,0:19:16.94,0:19:19.32,Default,,0,0,0,,Айтпақшы, BC Соль иесіне
Dialogue: 0,0:19:19.40,0:19:22.74,Default,,0,0,0,,Мен сізді қатысуыңызды өтіну үшін барын салдым.
Dialogue: 0,0:19:23.45,0:19:25.20,Default,,0,0,0,,О, сен не қаласаң, соны істей аласың.
Dialogue: 0,0:19:25.33,0:19:26.91,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:19:26.99,0:19:30.54,Default,,0,0,0,,Мен де жапон достарыммен дүниежүзі бойынша шайқасқым келді.
Dialogue: 0,0:19:30.83,0:19:32.46,Default,,0,0,0,,Бұл сіздің рухыңыз!
Dialogue: 0,0:19:32.71,0:19:35.09,Default,,0,0,0,,Біздің мүшелермен таныстыру
Dialogue: 0,0:19:37.67,0:19:38.92,Default,,0,0,0,,Cisco!
Dialogue: 0,0:19:39.72,0:19:41.30,Default,,0,0,0,,Мен сені іздедім.
Dialogue: 0,0:19:41.80,0:19:43.26,Default,,0,0,0,,Менің сүйіктім
Dialogue: 0,0:19:43.47,0:19:46.93,Default,,0,0,0,,Еркін мен сенімен шайқасқа келдім.
Dialogue: 0,0:19:47.31,0:19:49.31,Default,,0,0,0,,Мен емес пе...
Dialogue: 0,0:19:49.73,0:19:52.35,Default,,0,0,0,,Ал мына жігіт Атару Окинака.
Dialogue: 0,0:19:52.64,0:19:53.98,Default,,0,0,0,,жапон?
Dialogue: 0,0:19:54.06,0:19:57.07,Default,,0,0,0,,Тегін Шындығында, мен де
Dialogue: 0,0:19:57.15,0:20:00.49,Default,,0,0,0,,Мен сенімен күресуді асыға күттім.
Dialogue: 0,0:20:02.40,0:20:04.24,Default,,0,0,0,,Енді екі команда, сөйлесейік.
Dialogue: 0,0:20:07.37,0:20:10.83,Default,,0,0,0,,Қане, екі команда да жақсы жекпе-жектен үмітті.
Dialogue: 0,0:20:10.95,0:20:13.00,Default,,0,0,0,,Ойын ақыры басталып жатыр!
Dialogue: 0,0:20:13.62,0:20:15.71,Default,,0,0,0,,Осы жолдастық кездесудің ережелері!
Dialogue: 0,0:20:15.79,0:20:18.71,Default,,0,0,0,,Матчқа қатысатын қылшықтарды әр команданың капитаны анықтайды.
Dialogue: 0,0:20:18.80,0:20:20.30,Default,,0,0,0,,Номинациялар жүйесі
Dialogue: 0,0:20:20.59,0:20:23.51,Default,,0,0,0,,Кім шығады және ойын қалай өтеді?
Dialogue: 0,0:20:23.59,0:20:25.26,Default,,0,0,0,,Капитанның шешімі шешуші болып табылады
Dialogue: 0,0:20:25.64,0:20:28.56,Default,,0,0,0,,Әрбір шайқаста алдымен 2 ұпай жеңеді.
Dialogue: 0,0:20:28.68,0:20:31.39,Default,,0,0,0,,Бірінші болып 3 жеңіске жеткен команда жеңеді.
Dialogue: 0,0:20:31.48,0:20:33.77,Default,,0,0,0,,Біз қызу шайқасты күтеміз!
Dialogue: 0,0:20:34.23,0:20:37.48,Default,,0,0,0,,Нағыз Самбаттың бірінші қадамы осы!
Dialogue: 0,0:20:38.11,0:20:39.86,Default,,0,0,0,,(Уэннің дауысы)
Dialogue: 0,0:20:40.28,0:20:42.32,Default,,0,0,0,,Сәлем! Мен шыдай алмаймын
Dialogue: 0,0:20:42.40,0:20:44.45,Default,,0,0,0,,Әлем қарап тұр!
Dialogue: 0,0:20:44.86,0:20:46.87,Default,,0,0,0,,Біріншіден, нағыз самбат!
Dialogue: 0,0:20:46.95,0:20:49.87,Default,,0,0,0,,Бірінші Бладер - Комурасаки Вакия!
Dialogue: 0,0:20:49.95,0:20:51.95,Default,,0,0,0,,Иесінің өзі қатысады!
Dialogue: 0,0:20:52.25,0:20:55.00,Default,,0,0,0,,Ол шынымен де қалағанын жасай алады.
Dialogue: 0,0:20:55.08,0:20:57.54,Default,,0,0,0,,Тегін! Мен бірінші болуым керек, солай ма?
Dialogue: 0,0:20:57.63,0:20:59.71,Default,,0,0,0,,Сәлем! Капитан Кирикоми менмін, солай ма?
Dialogue: 0,0:20:59.88,0:21:01.59,Default,,0,0,0,,Қайсысы да жақсы.
Dialogue: 0,0:21:01.67,0:21:03.42,Default,,0,0,0,,Капитан шешсін.
Dialogue: 0,0:21:03.51,0:21:06.30,Default,,0,0,0,,Бұл менмін, солай ма? Мен! Бұл менмін, солай ма?
Dialogue: 0,0:21:07.05,0:21:08.22,Default,,0,0,0,,Джа Кими
Dialogue: 0,0:21:08.30,0:21:09.60,Default,,0,0,0,,Неліктен? (Рантаро) Жарайды!
Dialogue: 0,0:21:09.97,0:21:14.35,Default,,0,0,0,,BC Сольдің бірінші таңдауы Рантаро Кияма болды!
Dialogue: 0,0:21:14.48,0:21:15.60,Default,,0,0,0,,Кумичо!
Dialogue: 0,0:21:15.69,0:21:16.90,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:21:18.86,0:21:22.36,Default,,0,0,0,,Вакияға қараңыз, жаңа Рагнарук күші!
Dialogue: 0,0:21:22.90,0:21:25.36,Default,,0,0,0,,Өзгерген жалғыз адам болма
Dialogue: 0,0:21:25.78,0:21:28.53,Default,,0,0,0,,Жарайсыңдар! Бұл Bay Check!
Dialogue: 0,0:21:28.62,0:21:31.24,Default,,0,0,0,,Бір-біріміздің шығанақтарымызға қамқор болайық!
Dialogue: 0,0:21:32.04,0:21:34.58,Default,,0,0,0,,Бұл жаңа вивер ме?
Dialogue: 0,0:21:35.00,0:21:37.33,Default,,0,0,0,,Менің вивернім де қайта туды.
Dialogue: 0,0:21:38.08,0:21:40.29,Default,,0,0,0,,Торнадо Вайверн!
Dialogue: 0,0:21:41.00,0:21:42.71,Default,,0,0,0,,Торнадо Вайверн?
Dialogue: 0,0:21:44.17,0:21:45.72,Default,,0,0,0,,Бұл қандай қабат?
Dialogue: 0,0:21:46.80,0:21:49.80,Default,,0,0,0,,Қозғалайық. Оның қандай күші бар?
Dialogue: 0,0:21:55.56,0:21:57.81,Default,,0,0,0,,♪~
Dialogue: 0,0:21:58.44,0:22:01.94,Default,,0,0,0,,Жарайсыңдар, ұлдар мен қыздар, қазір сәби өлшемі!
Dialogue: 0,0:22:02.02,0:22:04.82,Default,,0,0,0,,Шығанақ бұлшықеттеріңізді жаттықтырыңыз және ең күшті қуық болуды мақсат етіңіз!
Dialogue: 0,0:22:04.90,0:22:06.99,Default,,0,0,0,,Алдымен қыздырыңыз. Иықтарыңызды айналдырайық!
Dialogue: 0,0:22:07.07,0:22:10.66,Default,,0,0,0,,Айнал, бұрыл, иә!
Dialogue: 0,0:22:10.74,0:22:14.41,Default,,0,0,0,,Шығанақ бұлшық еттерін байқаңыз. Жүр, сен жылдам боласың. Қуаныңыз!
Dialogue: 0,0:22:14.49,0:22:16.25,Default,,0,0,0,,Punch Punch!
Dialogue: 0,0:22:16.33,0:22:17.96,Default,,0,0,0,,Оң солға!
Dialogue: 0,0:22:18.04,0:22:19.92,Default,,0,0,0,,Оңға солға Оңға солға!
Dialogue: 0,0:22:20.00,0:22:21.54,Default,,0,0,0,,Оңға солға оңға солға!
Dialogue: 0,0:22:21.63,0:22:23.63,Default,,0,0,0,,Уау, керемет рух!
Dialogue: 0,0:22:23.71,0:22:26.09,Default,,0,0,0,,Сіз кез келген қарсыласты жеңе алатын сияқтысыз!
Dialogue: 0,0:22:26.17,0:22:29.09,Default,,0,0,0,,Одан әрі ату жаттығуы. Бұл жерде де абай болмаңыз!
Dialogue: 0,0:22:29.18,0:22:32.80,Default,,0,0,0,,GO Shoot GO Shoot және керісінше!
Dialogue: 0,0:22:32.89,0:22:36.56,Default,,0,0,0,,GO Shoot GO Shoot GO Shoot Иә!
Dialogue: 0,0:22:36.64,0:22:38.35,Default,,0,0,0,,Атуға бар!
Dialogue: 0,0:22:38.44,0:22:41.65,Default,,0,0,0,,Ашу және ату Ашу және ату
Dialogue: 0,0:22:41.73,0:22:43.98,Default,,0,0,0,,Енді тезірек жетейік!
Dialogue: 0,0:22:44.07,0:22:47.44,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:47.53,0:22:51.16,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:51.24,0:22:53.37,Default,,0,0,0,,Сіз мені дұрыс орындайсыз ба? Бұл не?
Dialogue: 0,0:22:53.45,0:22:55.04,Default,,0,0,0,,Ату - Бей үшін өмір!
Dialogue: 0,0:22:55.12,0:22:58.50,Default,,0,0,0,,1-де, 2-де, GO-да ат, өйткені 3 немесе 4 жоқ!
Dialogue: 0,0:22:58.79,0:23:00.50,Default,,0,0,0,,Ммм, тамаша
Dialogue: 0,0:23:00.58,0:23:03.59,Default,,0,0,0,,Жасайық! Бұл шарықтау шегіне жақындады
Dialogue: 0,0:23:03.67,0:23:05.92,Default,,0,0,0,,Рухыңызды көтеріңіз!
Dialogue: 0,0:23:06.09,0:23:09.88,Default,,0,0,0,,Болды, болды, БАР, жарайсың!
Dialogue: 0,0:23:09.97,0:23:13.55,Default,,0,0,0,,Болды, болды, GO тамаша түсір!
Dialogue: 0,0:23:13.64,0:23:17.18,Default,,0,0,0,,Мынау, анау, GO тамаша түсіреді!
Dialogue: 0,0:23:17.27,0:23:20.56,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:20.64,0:23:22.27,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:23:22.35,0:23:23.73,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:23.73,0:23:25.52,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:23.73,0:23:25.52,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.11,0:23:30.07,Default,,0,0,0,,Вакияның Виверні өте күшті болды
Dialogue: 0,0:23:30.15,0:23:34.16,Default,,0,0,0,,Мен Вакиямен біраз уақыттан кейін бірінші рет жекпе-жекке шыққаныма өте қуаныштымын!
Dialogue: 0,0:23:34.45,0:23:35.83,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:23:35.95,0:23:38.12,Default,,0,0,0,,«Жақтауды алып тастау»?
Dialogue: 0,0:23:38.25,0:23:40.54,Default,,0,0,0,,Нені айтып тұрсың, Еркін?
Dialogue: 0,0:23:41.16,0:23:43.58,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:43.71,0:23:46.00,Default,,0,0,0,,Құйын! Торнадо Вайверн!
Dialogue: 0,0:23:46.09,0:23:49.55,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.05,0:23:57.05,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory