Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.25,0:00:05.33,Default,,0,0,0,,Бейблейд!
Dialogue: 0,0:00:07.00,0:00:09.09,Default,,0,0,0,,Бұл баланың арманы
Dialogue: 0,0:00:09.75,0:00:14.55,Default,,0,0,0,,Дүние жүзінің түкпір-түкпірінен келген пышақшылар шыңға жету үшін жарысады және бір-біріне қарсы жанын салады.
Dialogue: 0,0:00:15.47,0:00:20.22,Default,,0,0,0,,Айналсын, жарылып, жарылсын!
Dialogue: 0,0:00:20.72,0:00:23.85,Default,,0,0,0,,Даңқты жеңіске қол жеткізіңіз!
Dialogue: 0,0:00:24.60,0:00:27.81,Default,,0,0,0,,Шайқастан кейін оны міндетті түрде табасыз.
Dialogue: 0,0:00:27.90,0:00:29.86,Default,,0,0,0,,Жарқын болашақ!
Dialogue: 0,0:00:31.44,0:00:34.24,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:34.90,0:00:37.95,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:38.03,0:00:39.20,Default,,0,0,0,,Бұл кішкентай вакуумдық торнадоның соңғы әсері!
Dialogue: 0,0:00:39.49,0:00:42.20,Default,,0,0,0,,God Bladers кубогының жартылай финалы
Dialogue: 0,0:00:42.29,0:00:45.12,Default,,0,0,0,,Оны жойыңыз! Уууу...
Dialogue: 0,0:00:45.21,0:00:47.21,Default,,0,0,0,,...Уау
Dialogue: 0,0:00:47.75,0:00:48.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:50.30,0:00:51.55,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:00:51.76,0:00:52.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:53.21,0:00:54.34,Default,,0,0,0,,(Сыну дыбысы)
Dialogue: 0,0:00:54.92,0:00:58.47,Default,,0,0,0,,Шу финалға шығуға шешім қабылдады және...
Dialogue: 0,0:00:59.01,0:01:00.47,Default,,0,0,0,,Мм... Ах!
Dialogue: 0,0:01:00.72,0:01:02.52,Default,,0,0,0,,Ахх...
Dialogue: 0,0:01:03.27,0:01:05.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:06.39,0:01:07.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:10.32,0:01:11.69,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:11.86,0:01:12.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:13.03,0:01:15.74,Default,,0,0,0,,Бірінші шайқаста Фриланс жеңді.
Dialogue: 0,0:01:15.82,0:01:18.11,Default,,0,0,0,,Шеті жоқ екінші шайқас
Dialogue: 0,0:01:18.20,0:01:21.53,Default,,0,0,0,,Құдай жарсын!
Dialogue: 0,0:01:25.04,0:01:27.04,Default,,0,0,0,,(сүртіп алу дыбысы)
Dialogue: 0,0:01:27.62,0:01:29.00,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:01:29.08,0:01:30.79,Default,,0,0,0,,1 ұпай қайтарылды!
Dialogue: 0,0:01:31.13,0:01:35.72,Default,,0,0,0,,Екеуі де дамып, қызықты сәйкестікке айналдырады.
Dialogue: 0,0:01:36.13,0:01:38.01,Default,,0,0,0,,Тегін…
Dialogue: 0,0:01:38.68,0:01:41.68,Default,,0,0,0,,Үшінші шайқас: Мен келесі жолы міндетті түрде жеңемін!
Dialogue: 0,0:01:42.22,0:01:44.35,Default,,0,0,0,,Хаха...
Dialogue: 0,0:01:45.02,0:01:47.31,Default,,0,0,0,,Аа... жақсы
Dialogue: 0,0:01:47.73,0:01:50.56,Default,,0,0,0,,Олай болса келесі матчты шешейік.
Dialogue: 0,0:01:51.48,0:01:54.15,Default,,0,0,0,,♪~
Dialogue: 0,0:01:54.23,0:01:56.57,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:01:56.65,0:01:59.20,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:01:59.28,0:02:01.70,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:02:01.78,0:02:03.74,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:02:04.04,0:02:05.75,Default,,0,0,0,,ЖАРЫЛЫҚ...)
Dialogue: 0,0:02:05.83,0:02:10.13,Default,,0,0,0,,Тіпті күннің шығысымен жарықтандырылған көше қиылысында
Dialogue: 0,0:02:11.08,0:02:15.80,Default,,0,0,0,,Мен бір жерден естіген дыбыс шығанақтардың соқтығысуы еді!
Dialogue: 0,0:02:15.92,0:02:20.84,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:02:20.93,0:02:25.68,Default,,0,0,0,,Жалынды жүрек ұйқысыз ойында жеңіске жетуге ниетті.
Dialogue: 0,0:02:25.77,0:02:30.56,Default,,0,0,0,,Қанша сүрінсем де, қайта тұрамын.
Dialogue: 0,0:02:30.65,0:02:35.61,Default,,0,0,0,,Бірін-бірі жақсарта алатын бәсекелестер болса
Dialogue: 0,0:02:35.69,0:02:40.86,Default,,0,0,0,,Үздік сахнада шыңды көздеу
Dialogue: 0,0:02:40.95,0:02:44.08,Default,,0,0,0,,Дәл қазір атайық.
Dialogue: 0,0:02:44.16,0:02:45.66,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:45.74,0:02:48.29,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:48.37,0:02:50.54,Default,,0,0,0,,Жаңа әлем күтіп тұр
Dialogue: 0,0:02:50.62,0:02:52.79,Default,,0,0,0,,Сіз әлі көрмеген шайқастар
Dialogue: 0,0:02:52.88,0:02:54.09,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:02:54.17,0:02:55.75,Default,,0,0,0,,(Үш екі бір рет ату)
Dialogue: 0,0:02:55.84,0:02:58.21,Default,,0,0,0,,Бейблейд! Бейблейд!
Dialogue: 0,0:02:58.30,0:03:04.47,Default,,0,0,0,,Үнемі дамып келе жатқан серіктестің байланысы мен дірілдеген жүрек соғысымен
Dialogue: 0,0:03:04.55,0:03:08.73,Default,,0,0,0,,Айналу жылдамдығын арттыру арқылы шешіңіз
Dialogue: 0,0:03:08.81,0:03:10.98,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:03:11.73,0:03:13.69,Default,,0,0,0,,ЖАРЫЛҒАН ЖАРЫЛЫП ЖАРЫЛЫП БЕРІҢІЗ! )
Dialogue: 0,0:03:14.19,0:03:16.15,Default,,0,0,0,,BURST BURST BEYBLEDE! )
Dialogue: 0,0:03:16.23,0:03:16.73,Default,,0,0,0,,~♪
Dialogue: 0,0:03:16.73,0:03:20.28,Default,,0,0,0,,~♪
Dialogue: 0,0:03:16.73,0:03:20.28,Default,,0,0,0,,BURST BURST 3, 2, 1, АТЫЛЫҢЫЗ! )
Dialogue: 0,0:03:20.28,0:03:20.95,Default,,0,0,0,,~♪
Dialogue: 0,0:03:22.28,0:03:25.07,Default,,0,0,0,,Тез кіріңіз! Соңғы шайқас!
Dialogue: 0,0:03:26.16,0:03:28.45,Default,,0,0,0,,Эй, эй, эй!
Dialogue: 0,0:03:28.70,0:03:32.42,Default,,0,0,0,,Сіз де сезіп тұрсыз ба? Бұл құмарлық сезім!
Dialogue: 0,0:03:32.75,0:03:36.75,Default,,0,0,0,,God Bladers кубогының жартылай финалы Жоғары шиеленіс!
Dialogue: 0,0:03:36.84,0:03:41.17,Default,,0,0,0,,Ыстық болыңыз және үшінші шайқасқа кірейік!
Dialogue: 0,0:03:41.26,0:03:42.38,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:42.76,0:03:43.80,Default,,0,0,0,,Барт ше?
Dialogue: 0,0:03:43.89,0:03:46.22,Default,,0,0,0,,Әлі де аймақта.
Dialogue: 0,0:03:46.55,0:03:48.68,Default,,0,0,0,,Үлкен концентрация
Dialogue: 0,0:03:49.31,0:03:53.69,Default,,0,0,0,,(ұшқан ұшқындардың дыбысы)
Dialogue: 0,0:03:53.77,0:03:55.27,Default,,0,0,0,,(найзағайдың дыбысы)
Dialogue: 0,0:03:55.40,0:03:56.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:56.56,0:04:03.74,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:04:04.49,0:04:05.70,Default,,0,0,0,,Тегін
Dialogue: 0,0:04:06.20,0:04:08.28,Default,,0,0,0,,Бұл қызық, Балто
Dialogue: 0,0:04:09.20,0:04:11.45,Default,,0,0,0,,Көбірек көңіл көтерейік
Dialogue: 0,0:04:13.16,0:04:16.04,Default,,0,0,0,,Тегін - бұл таңқаларлық
Dialogue: 0,0:04:16.63,0:04:20.38,Default,,0,0,0,,Өзіңізді итермесеңіз, жоғары көтеріле алмайсыз.
Dialogue: 0,0:04:20.71,0:04:23.09,Default,,0,0,0,,Сонша алысқа барсаң, өзіңді көресің.
Dialogue: 0,0:04:23.97,0:04:27.51,Default,,0,0,0,,Өзіңізді өзгерткіңіз келсе, шектеу қоймаңыз.
Dialogue: 0,0:04:28.68,0:04:30.85,Default,,0,0,0,,Мен тегін ойынды жеңдім.
Dialogue: 0,0:04:31.43,0:04:33.06,Default,,0,0,0,,Сөзсіз жеңіңіз
Dialogue: 0,0:04:34.39,0:04:35.98,Default,,0,0,0,,Біз жеңеміз, досым!
Dialogue: 0,0:04:40.28,0:04:42.40,Default,,0,0,0,,Жеңімпаз... мен!
Dialogue: 0,0:04:45.95,0:04:49.24,Default,,0,0,0,,Мен олардың рухын шынымен сезінемін.
Dialogue: 0,0:04:49.33,0:04:52.41,Default,,0,0,0,,Balt және Free екеуі де толығымен аймақта.
Dialogue: 0,0:04:53.00,0:04:55.04,Default,,0,0,0,,Екеуіңе сәттілік
Dialogue: 0,0:04:55.58,0:04:58.75,Default,,0,0,0,,Жарайсыңдар! Одан да бір-бірімізге қолдау көрсетейік.
Dialogue: 0,0:04:58.84,0:05:00.00,Default,,0,0,0,,О!
Dialogue: 0,0:05:00.09,0:05:02.38,Default,,0,0,0,,Екеуіне де сәттілік!
Dialogue: 0,0:05:03.01,0:05:04.30,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:05:06.72,0:05:07.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:08.09,0:05:09.85,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:05:10.72,0:05:13.77,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:14.31,0:05:16.44,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:16.52,0:05:17.48,Default,,0,0,0,,Е!
Dialogue: 0,0:05:17.56,0:05:19.90,Default,,0,0,0,,сәби әлі тірі. Бұл адам баланы қорғап қалған болар.
Dialogue: 0,0:05:20.44,0:05:23.07,Default,,0,0,0,,Екеуі де тамаша соққы!
Dialogue: 0,0:05:23.15,0:05:26.40,Default,,0,0,0,,Фафнир Валькирия орталығына барады
Dialogue: 0,0:05:26.49,0:05:28.32,Default,,0,0,0,,Жүр, Валькири!
Dialogue: 0,0:05:31.74,0:05:34.62,Default,,0,0,0,,Ой... ой... ол жұмыс істемейді.
Dialogue: 0,0:05:36.79,0:05:40.50,Default,,0,0,0,,Валькирия! Түпкілікті Құдай қайта жүктеңіз!
Dialogue: 0,0:05:45.80,0:05:48.93,Default,,0,0,0,,Сен мені бұлай жеңе алмайсың!
Dialogue: 0,0:05:52.47,0:05:54.18,Default,,0,0,0,,Ештеңе бұзылмайды!
Dialogue: 0,0:05:57.56,0:05:58.64,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:05:59.10,0:06:01.65,Default,,0,0,0,,Бұл дыбыс жылдамдығымен шайқас!
Dialogue: 0,0:06:01.90,0:06:03.82,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:06:05.44,0:06:08.15,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:06:10.87,0:06:13.33,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:06:15.87,0:06:17.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:17.16,0:06:18.83,Default,,0,0,0,,Бір-бірімізбен сонша ұрысып жатсақ та
Dialogue: 0,0:06:19.17,0:06:21.08,Default,,0,0,0,,Бидің күші азайған жоқ.
Dialogue: 0,0:06:21.17,0:06:23.00,Default,,0,0,0,,Бұл шайқас керемет
Dialogue: 0,0:06:23.63,0:06:27.34,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:06:29.13,0:06:30.80,Default,,0,0,0,,Оны шешейік.
Dialogue: 0,0:06:31.47,0:06:33.05,Default,,0,0,0,,Фафнир!
Dialogue: 0,0:06:36.97,0:06:38.48,Default,,0,0,0,,(үру)
Dialogue: 0,0:06:39.10,0:06:42.69,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:06:45.44,0:06:46.86,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:06:47.65,0:06:49.95,Default,,0,0,0,,Ууууууу
Dialogue: 0,0:06:50.03,0:06:52.99,Default,,0,0,0,,Охххх!
Dialogue: 0,0:06:53.07,0:06:54.87,Default,,0,0,0,,(үру)
Dialogue: 0,0:06:56.29,0:06:58.04,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:06:58.45,0:07:02.42,Default,,0,0,0,,Олар бір уақытта дерлік жарылып кетті! Үкім! ?
Dialogue: 0,0:07:02.58,0:07:04.42,Default,,0,0,0,,Ұпайлар жоқ!
Dialogue: 0,0:07:04.71,0:07:07.00,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:07.09,0:07:10.22,Default,,0,0,0,,Әй, уау! Бұл өте ыстық шайқас -
Dialogue: 0,0:07:10.30,0:07:12.01,Default,,0,0,0,,Күшті шайқастың уақыты келді.
Dialogue: 0,0:07:12.30,0:07:13.51,Default,,0,0,0,,(дем алу)
Dialogue: 0,0:07:18.52,0:07:20.77,Default,,0,0,0,,Көбірек шоғырланыңыз! Шоғырлан!
Dialogue: 0,0:07:21.10,0:07:22.06,Default,,0,0,0,,​​О?
Dialogue: 0,0:07:27.11,0:07:28.19,Default,,0,0,0,,Тегін?
Dialogue: 0,0:07:29.99,0:07:31.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:31.86,0:07:32.95,Default,,0,0,0,,Сіз...
Dialogue: 0,0:07:33.32,0:07:34.32,Default,,0,0,0,,Тегін
Dialogue: 0,0:07:35.95,0:07:36.99,Default,,0,0,0,,Крис!
Dialogue: 0,0:07:37.62,0:07:40.66,Default,,0,0,0,,Не? Не болды, Бос Де Ла Хойя!
Dialogue: 0,0:07:41.16,0:07:44.88,Default,,0,0,0,,Уф... Қозғалмай жатыр. Не болып жатыр?
Dialogue: 0,0:07:44.96,0:07:47.38,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:07:48.38,0:07:49.38,Default,,0,0,0,,Тегін
Dialogue: 0,0:07:49.92,0:07:52.09,Default,,0,0,0,,Ол жігіт мені әйтеуір ренжітті.
Dialogue: 0,0:07:52.22,0:07:54.72,Default,,0,0,0,,Бұл өте нашар көрінеді.
Dialogue: 0,0:07:54.80,0:07:56.18,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:57.51,0:08:01.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:03.02,0:08:04.98,Default,,0,0,0,,Шешу...
Dialogue: 0,0:08:05.52,0:08:06.90,Default,,0,0,0,,Мен оны киемін!
Dialogue: 0,0:08:08.07,0:08:09.44,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:08:11.53,0:08:12.57,Default,,0,0,0,,Крис!
Dialogue: 0,0:08:13.11,0:08:16.82,Default,,0,0,0,,Міне, шайқас сахнасында BC Sol иесі...
Dialogue: 0,0:08:16.91,0:08:19.04,Default,,0,0,0,,Кристина Клодаг осында!
Dialogue: 0,0:08:19.37,0:08:21.50,Default,,0,0,0,,Тоқтатыңыз, тегін
Dialogue: 0,0:08:21.62,0:08:23.08,Default,,0,0,0,,Мен ары қарай жүре алмаймын.
Dialogue: 0,0:08:27.25,0:08:28.92,Default,,0,0,0,,Фафнил...
Dialogue: 0,0:08:29.13,0:08:30.67,Default,,0,0,0,,Я...
Dialogue: 0,0:08:31.84,0:08:33.51,Default,,0,0,0,,Я...
Dialogue: 0,0:08:37.72,0:08:41.02,Default,,0,0,0,,Фри Де Ла Хойя мұндағы шайқастан қалыс қалады.
Dialogue: 0,0:08:41.39,0:08:43.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:44.39,0:08:46.98,Default,,0,0,0,,Мен мұны істей аламын!
Dialogue: 0,0:08:47.19,0:08:50.65,Default,,0,0,0,,Мен иесі ретінде ойыншыларымды қорғауға міндеттімін.
Dialogue: 0,0:08:52.24,0:08:53.32,Default,,0,0,0,,Жәбірленген жан, қатты әлсіреп кеткендей…
Dialogue: 0,0:08:58.62,0:09:00.70,Default,,0,0,0,,Onegai тегін
Dialogue: 0,0:09:03.58,0:09:04.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:10.96,0:09:12.09,Default,,0,0,0,,Тегін
Dialogue: 0,0:09:14.26,0:09:16.30,Default,,0,0,0,,Түсінгеніңізге рахмет.
Dialogue: 0,0:09:21.26,0:09:24.85,Default,,0,0,0,,О, Құдайым, Құдайым!
Dialogue: 0,0:09:24.93,0:09:28.23,Default,,0,0,0,,Дүние жүзіндегі №1 жүзік, Фри Де Ла Хойя...
Dialogue: 0,0:09:28.31,0:09:31.11,Default,,0,0,0,,Міне, мен күтпеген жерден зейнетке шықтым!
Dialogue: 0,0:09:31.19,0:09:37.28,Default,,0,0,0,,Енді Red Eye және Balt Aoi финалға шығады деп шешілді.
Dialogue: 0,0:09:39.41,0:09:41.24,Default,,0,0,0,,Тегін Жақсы ма?
Dialogue: 0,0:09:42.83,0:09:43.79,Default,,0,0,0,,Тегін!
Dialogue: 0,0:09:44.16,0:09:45.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:49.67,0:09:51.46,Default,,0,0,0,,Кешіріңіз Фафнир
Dialogue: 0,0:09:52.30,0:09:53.46,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:09:53.55,0:09:54.59,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:55.21,0:09:58.09,Default,,0,0,0,,Біз әрі қарай жүре аламыз!
Dialogue: 0,0:09:59.26,0:10:00.22,Default,,0,0,0,,болды
Dialogue: 0,0:10:00.30,0:10:03.39,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:10:03.47,0:10:04.56,Default,,0,0,0,,Тегін
Dialogue: 0,0:10:05.06,0:10:06.73,Default,,0,0,0,,Барлығына не болды?
Dialogue: 0,0:10:07.23,0:10:09.10,Default,,0,0,0,,Не... бәрібір
Dialogue: 0,0:10:09.19,0:10:11.69,Default,,0,0,0,,Мен сені уайымдап, сені іздедім.
Dialogue: 0,0:10:12.44,0:10:15.07,Default,,0,0,0,,Мазасыз ба? Неліктен?
Dialogue: 0,0:10:15.74,0:10:17.24,Default,,0,0,0,,Еркін ақымақ!
Dialogue: 0,0:10:17.32,0:10:18.40,Default,,0,0,0,,Шаса…
Dialogue: 0,0:10:18.61,0:10:22.45,Default,,0,0,0,,Егер сіздің әріптесіңіз жарақат алса, сіз міндетті түрде алаңдайсыз.
Dialogue: 0,0:10:23.03,0:10:24.58,Default,,0,0,0,,Бұл дос, солай ма?
Dialogue: 0,0:10:25.37,0:10:28.62,Default,,0,0,0,,Қарапайым нәрсені қалай түсінбейсің?
Dialogue: 0,0:10:28.71,0:10:30.21,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:10:30.29,0:10:32.29,Default,,0,0,0,,Тегін Бұл ауырды ма?
Dialogue: 0,0:10:32.92,0:10:35.34,Default,,0,0,0,,Мен қатты уайымдадым.
Dialogue: 0,0:10:37.47,0:10:38.63,Default,,0,0,0,,...мм
Dialogue: 0,0:10:40.22,0:10:42.26,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:10:43.18,0:10:45.22,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,0:10:45.85,0:10:47.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:47.10,0:10:49.73,Default,,0,0,0,,Әй... Әй, жаңа не ұстадың?
Dialogue: 0,0:10:50.14,0:10:52.98,Default,,0,0,0,,«Кешіріңіз, барлығыңызға рахмет»
Dialogue: 0,0:10:53.23,0:10:55.19,Default,,0,0,0,,Бос қате
Dialogue: 0,0:10:55.27,0:10:57.69,Default,,0,0,0,,Жоқ, күте тұрыңыз! Бұл жігіт не дейді?
Dialogue: 0,0:10:57.78,0:10:59.32,Default,,0,0,0,,Құлақ бос па?
Dialogue: 0,0:10:59.40,0:11:02.37,Default,,0,0,0,,Мен айттым, айттым!
Dialogue: 0,0:11:02.82,0:11:06.54,Default,,0,0,0,,Жарайды, бос тоқтадың. Бұл дұрыс.
Dialogue: 0,0:11:06.62,0:11:10.67,Default,,0,0,0,,Негізі мен оның жарақат алуын тоқтатар едім.
Dialogue: 0,0:11:10.75,0:11:11.67,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:11.75,0:11:15.25,Default,,0,0,0,,Мен Балттың айтқанын түсіндім.
Dialogue: 0,0:11:15.34,0:11:16.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:16.38,0:11:19.42,Default,,0,0,0,,Мен бүгін жеңілдім, бірақ көңілді болды.
Dialogue: 0,0:11:20.42,0:11:21.51,Default,,0,0,0,,Тегін
Dialogue: 0,0:11:22.01,0:11:24.35,Default,,0,0,0,,Мен Қызыл көзбен жұмыс істегім келді.
Dialogue: 0,0:11:25.81,0:11:27.47,Default,,0,0,0,,Жеңіс, Балто
Dialogue: 0,0:11:29.60,0:11:30.60,Default,,0,0,0,,Иә
Dialogue: 0,0:11:34.90,0:11:37.36,Default,,0,0,0,,(Шығанақты щеткалау дыбысы)
Dialogue: 0,0:11:39.07,0:11:40.61,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:11:40.70,0:11:43.41,Default,,0,0,0,,Иә? …иә?
Dialogue: 0,0:11:43.49,0:11:45.12,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:11:45.20,0:11:46.41,Default,,0,0,0,,Уау! ! !
Dialogue: 0,0:11:48.04,0:11:49.70,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:11:51.79,0:11:52.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:53.62,0:11:54.96,Default,,0,0,0,,Анашым!
Dialogue: 0,0:11:57.67,0:12:01.80,Default,,0,0,0,,Каачан Токонацу Ника Дина Инусуке!
Dialogue: 0,0:12:02.55,0:12:05.68,Default,,0,0,0,,Келгеніңізге рахмет! Хахаха!
Dialogue: 0,0:12:06.05,0:12:08.93,Default,,0,0,0,,Вайморуяро Ваймо! Кешіріңіз!
Dialogue: 0,0:12:09.01,0:12:11.18,Default,,0,0,0,,Барлығы мені осында әкелді.
Dialogue: 0,0:12:12.10,0:12:13.48,Default,,0,0,0,,Барто!
Dialogue: 0,0:12:13.60,0:12:15.40,Default,,0,0,0,,Финалға өту…
Dialogue: 0,0:12:15.48,0:12:17.52,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,0:12:19.73,0:12:21.32,Default,,0,0,0,,Бұл керемет емес пе, Балто?
Dialogue: 0,0:12:21.65,0:12:23.57,Default,,0,0,0,,Мен оны тікелей эфирде көрдім.
Dialogue: 0,0:12:23.65,0:12:25.32,Default,,0,0,0,,Өте керемет көріндің.
Dialogue: 0,0:12:25.66,0:12:28.03,Default,,0,0,0,,Тегін апат болса да
Dialogue: 0,0:12:28.12,0:12:31.50,Default,,0,0,0,,Финалға шығудың өзі үлкен іс, бұл мақтау.
Dialogue: 0,0:12:33.91,0:12:35.04,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:12:35.12,0:12:36.50,Default,,0,0,0,,Уау~
Dialogue: 0,0:12:36.88,0:12:38.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:38.34,0:12:40.80,Default,,0,0,0,,Балттың анасының наны Біраз болды.
Dialogue: 0,0:12:41.30,0:12:43.84,Default,,0,0,0,,Қара, қара, Аники, бұл Валькири Пан!
Dialogue: 0,0:12:44.26,0:12:46.84,Default,,0,0,0,,Құдай Валькириге айналу!
Dialogue: 0,0:12:46.93,0:12:48.43,Default,,0,0,0,,Бейнелеу өнері!
Dialogue: 0,0:12:48.51,0:12:50.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:50.14,0:12:51.89,Default,,0,0,0,,HAMMMNGNGNG
Dialogue: 0,0:12:51.97,0:12:54.77,Default,,0,0,0,,Уме~ Анам күткендей
Dialogue: 0,0:12:59.27,0:13:01.78,Default,,0,0,0,,Балттың Качан наны дүниедегі ең жақсы.
Dialogue: 0,0:13:02.11,0:13:03.78,Default,,0,0,0,,Дұрыс, солай ма?
Dialogue: 0,0:13:04.20,0:13:06.78,Default,,0,0,0,,Қайсысы жақсы, менің анам Испанияда тамақ пісіреді?
Dialogue: 0,0:13:06.86,0:13:08.07,Default,,0,0,0,,Нһ!
Dialogue: 0,0:13:09.03,0:13:10.53,Default,,0,0,0,,Нфуфуфу~
Dialogue: 0,0:13:10.91,0:13:13.79,Default,,0,0,0,,Бұны жеп болған соң, тағы да жаттығуым керек.
Dialogue: 0,0:13:14.21,0:13:15.87,Default,,0,0,0,,Бір-бірімізбен танысайық
Dialogue: 0,0:13:15.96,0:13:17.29,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:13:17.37,0:13:19.00,Default,,0,0,0,,О, таному вакия!
Dialogue: 0,0:13:19.67,0:13:21.50,Default,,0,0,0,,Инсуке Біз...
Dialogue: 0,0:13:21.59,0:13:22.63,Default,,0,0,0,,О
Dialogue: 0,0:13:24.30,0:13:26.30,Default,,0,0,0,,Ояныңдар Шу
Dialogue: 0,0:13:26.38,0:13:28.80,Default,,0,0,0,,Сіз қазір Шу емессіз.
Dialogue: 0,0:13:29.09,0:13:32.47,Default,,0,0,0,,Мен бәріміз тамсанатын Бенишу емеспін.
Dialogue: 0,0:13:33.31,0:13:37.56,Default,,0,0,0,,Осылай жеңе берсең, ақырында тек қана зардап шегесің.
Dialogue: 0,0:13:39.02,0:13:40.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:40.73,0:13:41.82,Default,,0,0,0,,Әй, Шу!
Dialogue: 0,0:13:41.90,0:13:42.90,Default,,0,0,0,,Шығу.
Dialogue: 0,0:13:42.98,0:13:45.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:45.82,0:13:48.53,Default,,0,0,0,,(Спригган ырылдады)
Dialogue: 0,0:13:49.11,0:13:51.99,Default,,0,0,0,,Түпнұсқа Шуға оралуыңызды өтінемін.
Dialogue: 0,0:13:52.28,0:13:54.70,Default,,0,0,0,,Барлығы сені күтіп отыр.
Dialogue: 0,0:14:00.25,0:14:01.21,Default,,0,0,0,,Шу…
Dialogue: 0,0:14:01.29,0:14:02.50,Default,,0,0,0,,
Dialogue: 0,0:14:07.76,0:14:09.18,Default,,0,0,0,,Бет!
Dialogue: 0,0:14:10.72,0:14:12.05,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:12.60,0:14:14.64,Default,,0,0,0,,Шу Шу, ашыңызшы.
Dialogue: 0,0:14:14.72,0:14:16.10,Default,,0,0,0,,(есік қағу)
Dialogue: 0,0:14:16.98,0:14:17.89,Default,,0,0,0,,Ах
Dialogue: 0,0:14:20.94,0:14:21.90,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:24.98,0:14:27.07,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:28.99,0:14:30.07,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:14:30.16,0:14:31.16,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:14:31.24,0:14:32.41,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:14:33.12,0:14:36.04,Default,,0,0,0,,Бұл жігіттің валькири екені анық.
Dialogue: 0,0:14:36.12,0:14:37.75,Default,,0,0,0,,Жоюға келейік
Dialogue: 0,0:14:37.83,0:14:40.08,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:14:40.25,0:14:43.88,Default,,0,0,0,,Ultimate God қайта жүктелуі біраз уақытты алады, солай емес пе?
Dialogue: 0,0:14:43.96,0:14:46.05,Default,,0,0,0,,Бұл Godslash
Dialogue: 0,0:14:46.63,0:14:50.59,Default,,0,0,0,,Шу көп төбелескен сайын күшейе түседі.
Dialogue: 0,0:15:01.44,0:15:04.86,Default,,0,0,0,,Жеңгім келеді Шууды жеңгім келеді
Dialogue: 0,0:15:04.94,0:15:08.36,Default,,0,0,0,,Бұл оңай! Мен мұны ынтамен жасаймын
Dialogue: 0,0:15:08.44,0:15:10.78,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:15:11.28,0:15:12.36,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:12.95,0:15:15.62,Default,,0,0,0,,Сәлем, балалар, не болды?
Dialogue: 0,0:15:15.70,0:15:17.37,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:15:17.62,0:15:18.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:18.87,0:15:20.41,Default,,0,0,0,,Ке... Инуске?
Dialogue: 0,0:15:21.08,0:15:24.42,Default,,0,0,0,,Бұл өте керемет, Қызыл көз.
Dialogue: 0,0:15:24.50,0:15:27.59,Default,,0,0,0,,Осы қарқынмен біздің жеңетінімізге күмән жоқ
Dialogue: 0,0:15:28.01,0:15:31.72,Default,,0,0,0,,Ал Реквием жобасы аяқталды.
Dialogue: 0,0:15:31.80,0:15:33.34,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:15:35.60,0:15:37.14,Default,,0,0,0,,Ұстамаңыз...
Dialogue: 0,0:15:37.22,0:15:39.27,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:15:39.81,0:15:41.27,Default,,0,0,0,,Маған тиіспе!
Dialogue: 0,0:15:41.77,0:15:42.77,Default,,0,0,0,,Не?
Dialogue: 0,0:15:46.11,0:15:47.07,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:15:56.16,0:15:59.04,Default,,0,0,0,,Спригган - бұл... мен.
Dialogue: 0,0:15:59.12,0:16:00.08,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:00.45,0:16:01.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:01.91,0:16:02.87,Default,,0,0,0,,Уф
Dialogue: 0,0:16:03.50,0:16:04.92,Default,,0,0,0,,Уау...
Dialogue: 0,0:16:05.00,0:16:07.96,Default,,0,0,0,,...Ааааааааааааааа!
Dialogue: 0,0:16:08.80,0:16:11.80,Default,,0,0,0,,Спригган жұтып қойды ма?
Dialogue: 0,0:16:12.01,0:16:14.34,Default,,0,0,0,,Нәтиже күткеннен де жақсы болды.
Dialogue: 0,0:16:14.72,0:16:17.43,Default,,0,0,0,,Менің іздегенім осы еді
Dialogue: 0,0:16:17.89,0:16:20.39,Default,,0,0,0,,Хехехехехе
Dialogue: 0,0:16:20.47,0:16:23.23,Default,,0,0,0,,Фухахахахаха
Dialogue: 0,0:16:25.60,0:16:26.94,Default,,0,0,0,,Бет...
Dialogue: 0,0:16:27.06,0:16:29.73,Default,,0,0,0,,Әлгі бейбақ Хидеко бірдеңе істеп жатыр.
Dialogue: 0,0:16:30.36,0:16:32.28,Default,,0,0,0,,Мен не айтсам да, пайдасыз болды.
Dialogue: 0,0:16:32.90,0:16:34.82,Default,,0,0,0,,Барт, кешіріңіз.
Dialogue: 0,0:16:34.91,0:16:37.87,Default,,0,0,0,,Маған еш пайда болмады.
Dialogue: 0,0:16:39.16,0:16:40.54,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:16:40.62,0:16:43.00,Default,,0,0,0,,Шу қазірдің өзінде қайтып келуі керек.
Dialogue: 0,0:16:43.08,0:16:44.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:44.75,0:16:46.83,Default,,0,0,0,,Ол өзгерді.
Dialogue: 0,0:16:47.50,0:16:49.13,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:16:50.96,0:16:52.13,Default,,0,0,0,,Шу…
Dialogue: 0,0:16:54.88,0:16:55.88,Default,,0,0,0,,Мен!
Dialogue: 0,0:17:02.35,0:17:04.85,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар!
Dialogue: 0,0:17:05.31,0:17:10.57,Default,,0,0,0,,God Bladers кубогының финалына қош келдіңіз
Dialogue: 0,0:17:10.65,0:17:14.90,Default,,0,0,0,,Дүние жүзіндегі жанкүйерлер чемпионды анықтауды асыға күткен сәт...
Dialogue: 0,0:17:14.99,0:17:17.32,Default,,0,0,0,,Жақында!
Dialogue: 0,0:17:17.41,0:17:21.62,Default,,0,0,0,,Көптеген тамаша матчтарды өткізген God Bladers кубогы...
Dialogue: 0,0:17:21.70,0:17:25.46,Default,,0,0,0,,Ақтық матчтың уақыты келді!
Dialogue: 0,0:17:25.79,0:17:28.67,Default,,0,0,0,,Барлығына! Күтуден шаршадыңыз ба?
Dialogue: 0,0:17:28.75,0:17:30.75,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:31.00,0:17:32.71,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:17:32.80,0:17:35.22,Default,,0,0,0,,Сеньор Аннами де күте алмайды!
Dialogue: 0,0:17:35.30,0:17:36.76,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:17:37.05,0:17:39.26,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:39.34,0:17:41.35,Default,,0,0,0,,Таңдалған пышақтардың арасында-
Dialogue: 0,0:17:41.56,0:17:44.93,Default,,0,0,0,,Қайсысы шыңда жарқырайды!
Dialogue: 0,0:17:45.10,0:17:49.48,Default,,0,0,0,,Бұл өте қызықты ерекше шайқас болатыны сөзсіз.
Dialogue: 0,0:17:49.56,0:17:51.69,Default,,0,0,0,,Бұл шоу уақыты!
Dialogue: 0,0:17:52.02,0:17:55.07,Default,,0,0,0,,Барто! Барынша барыңыз!
Dialogue: 0,0:17:55.15,0:17:56.36,Default,,0,0,0,,Бал аға
Dialogue: 0,0:17:56.45,0:17:57.40,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:17:57.49,0:17:58.70,Default,,0,0,0,,Аники!
Dialogue: 0,0:17:58.78,0:18:00.82,Default,,0,0,0,,Бар күшіңізбен күресіңіз!
Dialogue: 0,0:18:01.16,0:18:03.45,Default,,0,0,0,,Енді, Blader пайда болатын кез келді.
Dialogue: 0,0:18:03.54,0:18:07.41,Default,,0,0,0,,Өткізілген жердегілердің барлығы, теледидардың алдында тұрғандар мені үлкен қошеметпен қарсы алады.
Dialogue: 0,0:18:07.66,0:18:09.12,Default,,0,0,0,,Кеттік, жолдасым.
Dialogue: 0,0:18:13.67,0:18:16.38,Default,,0,0,0,,Қызыл бұрыш Ғажайып ғажайып бала
Dialogue: 0,0:18:16.80,0:18:19.68,Default,,0,0,0,,Ғажайыптар жасауды жалғастыра отырып, біз осы уақытқа дейін жеттік!
Dialogue: 0,0:18:19.76,0:18:22.10,Default,,0,0,0,,б.з.д. Сол Барто Аои!
Dialogue: 0,0:18:22.18,0:18:24.10,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:24.18,0:18:26.14,Default,,0,0,0,,Көк бұрыш қарсы
Dialogue: 0,0:18:26.52,0:18:28.39,Default,,0,0,0,,Бұл керемет рух!
Dialogue: 0,0:18:28.48,0:18:31.11,Default,,0,0,0,,Жылан шұңқырынан туған жойқын жын
Dialogue: 0,0:18:31.56,0:18:34.53,Default,,0,0,0,,Қызыл көз, сондай-ақ Куришуу ретінде белгілі!
Dialogue: 0,0:18:34.73,0:18:38.49,Default,,0,0,0,,Енді мен оның күшін көрсетейін.
Dialogue: 0,0:18:38.86,0:18:41.99,Default,,0,0,0,,Қызыл көз... Жоқ, Спригган
Dialogue: 0,0:18:42.32,0:18:44.62,Default,,0,0,0,,Барто Аои мен Шуу Куренаи
Dialogue: 0,0:18:44.70,0:18:47.70,Default,,0,0,0,,Бұл екеуі бір кездері жақын достар, әріптестер болған.
Dialogue: 0,0:18:47.96,0:18:49.92,Default,,0,0,0,,Уақыт өтіп жатыр, теңіздің арғы жағында
Dialogue: 0,0:18:50.00,0:18:54.75,Default,,0,0,0,,Енді осы финалдық стадионда біз ең мықты қарсыластарымыз ретінде кездесеміз.
Dialogue: 0,0:19:05.43,0:19:10.10,Default,,0,0,0,,Balt Aoi Бұл жолы да мен қабатқа Gekigod чипін қосамын.
Dialogue: 0,0:19:10.98,0:19:12.44,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:19:15.90,0:19:18.49,Default,,0,0,0,,Шуды жеңу үшін бар күшімді саламын!
Dialogue: 0,0:19:19.57,0:19:21.41,Default,,0,0,0,,Кеттік, жолдасым!
Dialogue: 0,0:19:24.66,0:19:27.12,Default,,0,0,0,,Мен Спригганмын!
Dialogue: 0,0:19:27.20,0:19:32.25,Default,,0,0,0,,(Спригган ырылдады)
Dialogue: 0,0:19:34.54,0:19:36.25,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:19:36.55,0:19:39.38,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:40.13,0:19:42.22,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:43.68,0:19:46.35,Default,,0,0,0,,Екі күшті соққы!
Dialogue: 0,0:19:46.43,0:19:49.64,Default,,0,0,0,,Спригган реквиемінде сағат тіліне қарсы айналмалы шабуыл режимі бар.
Dialogue: 0,0:19:49.73,0:19:50.81,Default,,0,0,0,,Спригган!
Dialogue: 0,0:19:52.48,0:19:55.27,Default,,0,0,0,,Спригганның қатты шабуылы!
Dialogue: 0,0:19:55.77,0:19:58.57,Default,,0,0,0,,Уф! Бұл даму! ?
Dialogue: 0,0:20:01.65,0:20:03.20,Default,,0,0,0,,Қабырғамен бұрышталған
Dialogue: 0,0:20:03.41,0:20:04.62,Default,,0,0,0,,Бұл!
Dialogue: 0,0:20:08.29,0:20:09.62,Default,,0,0,0,,(Жарық дыбысы)
Dialogue: 0,0:20:09.70,0:20:10.91,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:20:11.50,0:20:13.21,Default,,0,0,0,,Бұрынғыдай
Dialogue: 0,0:20:13.62,0:20:14.67,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:20:15.00,0:20:17.54,Default,,0,0,0,,Ой! Өзіңізді жеңіл сезінесіз бе?
Dialogue: 0,0:20:18.25,0:20:20.80,Default,,0,0,0,,Спригган онымен ойнап жүргендей-
Dialogue: 0,0:20:20.88,0:20:23.68,Default,,0,0,0,,Валькирияның бұрышы және қайта-қайта шабуыл
Dialogue: 0,0:20:23.76,0:20:25.72,Default,,0,0,0,,Ол мұны қайтадан жасай ма?
Dialogue: 0,0:20:26.18,0:20:27.85,Default,,0,0,0,,Аники!
Dialogue: 0,0:20:30.60,0:20:34.19,Default,,0,0,0,,Түпкілікті Құдайды қайта жүктеңіз!
Dialogue: 0,0:20:36.73,0:20:38.23,Default,,0,0,0,,Жақсы! шықты
Dialogue: 0,0:20:38.32,0:20:40.07,Default,,0,0,0,,Бар, Балто!
Dialogue: 0,0:20:40.44,0:20:42.07,Default,,0,0,0,,Алып өтіңіз!
Dialogue: 0,0:20:47.78,0:20:50.08,Default,,0,0,0,,Уф! Ай!
Dialogue: 0,0:20:51.54,0:20:52.96,Default,,0,0,0,,Жою!
Dialogue: 0,0:21:01.96,0:21:04.17,Default,,0,0,0,,Слеш реквиемі!
Dialogue: 0,0:21:04.80,0:21:06.51,Default,,0,0,0,,Құдай жарсын!
Dialogue: 0,0:21:08.05,0:21:10.56,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:21:16.14,0:21:17.31,Default,,0,0,0,,(Шығанақтың соғу дыбысы)
Dialogue: 0,0:21:17.40,0:21:18.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:21.19,0:21:22.11,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:21:22.53,0:21:28.28,Default,,0,0,0,,Burst Burst Burst!
Dialogue: 0,0:21:31.91,0:21:35.00,Default,,0,0,0,,Спригган реквиемінің жарқырауы
Dialogue: 0,0:21:35.08,0:21:36.62,Default,,0,0,0,,2-ден 0-ге дейінгі нүктелер
Dialogue: 0,0:21:36.71,0:21:38.58,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:38.67,0:21:41.63,Default,,0,0,0,,Құдай Валькиридің жойылуынан аулақ болды!
Dialogue: 0,0:21:41.71,0:21:44.17,Default,,0,0,0,,Бірақ енді істейтін ештеңе қалмады!
Dialogue: 0,0:21:45.05,0:21:46.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:49.89,0:21:52.56,Default,,0,0,0,,Жоғал, Барто Аои!
Dialogue: 0,0:21:55.48,0:21:56.44,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.44,0:21:59.90,Default,,0,0,0,,♪~
Dialogue: 0,0:21:56.44,0:21:59.90,Default,,0,0,0,,Жарайсыңдар Ұлдар мен Қыздар Сіз бұлшық еттеріңізді шынықтырасыз ба?
Dialogue: 0,0:21:59.90,0:21:59.98,Default,,0,0,0,,Жарайсыңдар Ұлдар мен Қыздар Сіз бұлшық еттеріңізді шынықтырасыз ба?
Dialogue: 0,0:22:00.06,0:22:02.98,Default,,0,0,0,,Енді, күтіңіз, Baysasize 2 уақыты келді!
Dialogue: 0,0:22:03.07,0:22:06.90,Default,,0,0,0,,Қозғалыс 1-нұсқаға қарағанда қарқындырақ. Алдымен алдыңғы эпизодты және көрсетілім уақытын қарастырайық.
Dialogue: 0,0:22:06.99,0:22:10.53,Default,,0,0,0,,GO Shoot GO Shoot Great Shoot!
Dialogue: 0,0:22:10.62,0:22:14.29,Default,,0,0,0,,GO Shoot GO Shoot Жылдамдығыңызды арттырыңыз!
Dialogue: 0,0:22:14.37,0:22:17.91,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:18.00,0:22:21.42,Default,,0,0,0,,GO ату БАРДЫҚ ату БАРДЫҚ ату
Dialogue: 0,0:22:21.50,0:22:24.80,Default,,0,0,0,,Хахахаха Бұл жақсы емес пе? Негізгі түсірілім тамаша.
Dialogue: 0,0:22:24.88,0:22:28.80,Default,,0,0,0,,Бірақ бұл жерден күшейе түседі, мен қолдарымды және кернеуімді арттырамын.
Dialogue: 0,0:22:28.88,0:22:32.76,Default,,0,0,0,,GO Shoot GO Shoot Bay Muscle Train Моримори
Dialogue: 0,0:22:32.85,0:22:36.35,Default,,0,0,0,,АЛУ АТТЫ БАР АТТЫ Менің атыс – құдайдың атысы
Dialogue: 0,0:22:36.43,0:22:40.15,Default,,0,0,0,,Оңға ату Солға ату Оңға ату
Dialogue: 0,0:22:40.23,0:22:43.86,Default,,0,0,0,,Сол жақ ату Оң жақ ату Сол жақта ату
Dialogue: 0,0:22:43.94,0:22:47.57,Default,,0,0,0,,Өткен аптада Осы аптада GO түсірілімін жасап жатырмыз
Dialogue: 0,0:22:47.65,0:22:51.24,Default,,0,0,0,,Осы аптада келесі аптада GO түсіру, ол да жасайды
Dialogue: 0,0:22:51.32,0:22:55.20,Default,,0,0,0,,Күн сайын барлығы жасайтын GO ату жаттығуларын жасаңыз
Dialogue: 0,0:22:55.29,0:22:58.50,Default,,0,0,0,,GO түсіру жыл бойы, көктемде, жазда, күзде және қыста
Dialogue: 0,0:22:58.58,0:23:00.04,Default,,0,0,0,,Хмм, жарайды!
Dialogue: 0,0:23:00.12,0:23:02.63,Default,,0,0,0,,Шығанақ бұлшықеттерін жаттықтыру үшін күнделікті жаттығу қажет.
Dialogue: 0,0:23:02.75,0:23:05.88,Default,,0,0,0,,Сол шиеленіспен біз шарықтау шегіне жетеміз!
Dialogue: 0,0:23:05.96,0:23:09.72,Default,,0,0,0,,Ичи Ни Сан Ши GO түсіріліміне кірісіңіз!
Dialogue: 0,0:23:09.80,0:23:13.18,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Let's Go!
Dialogue: 0,0:23:13.26,0:23:17.02,Default,,0,0,0,,Ichi Ni San Shi GO Shoot Кеттік!
Dialogue: 0,0:23:17.10,0:23:19.94,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:19.94,0:23:21.94,Default,,0,0,0,,Үш екі бір GO түсірілімі.
Dialogue: 0,0:23:19.94,0:23:21.94,Default,,0,0,0,,~♪
Dialogue: 0,0:23:21.94,0:23:22.02,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.02,0:23:24.94,Default,,0,0,0,,~♪
Dialogue: 0,0:23:22.02,0:23:24.94,Default,,0,0,0,,Nice GO түсіріңіз Nice Basa Size!
Dialogue: 0,0:23:24.94,0:23:25.48,Default,,0,0,0,,~♪
Dialogue: 0,0:23:26.40,0:23:29.86,Default,,0,0,0,,Шу, сенің арқаңда осы уақытқа дейін келдім.
Dialogue: 0,0:23:30.53,0:23:34.16,Default,,0,0,0,,Енді, дәл осы сәтте мен күресемін!
Dialogue: 0,0:23:34.74,0:23:35.99,Default,,0,0,0,,Ертеңге!
Dialogue: 0,0:23:36.45,0:23:40.96,Default,,0,0,0,,Бұл жай екеуміздің арамыздағы шайқас емес, барлығының ойы осында.
Dialogue: 0,0:23:41.83,0:23:44.17,Default,,0,0,0,,Келесі Beyblade Burst God
Dialogue: 0,0:23:44.25,0:23:46.13,Default,,0,0,0,,Балт Шуға қарсы!
Dialogue: 0,0:23:46.21,0:23:49.80,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:23:51.30,0:23:57.30,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory