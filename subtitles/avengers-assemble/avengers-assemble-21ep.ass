Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:39.08,0:00:41.38,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.46,0:00:47.49,Default,,0,0,0,,<Кек алушылар, яғни➡
Dialogue: 0,0:00:47.49,0:00:49.51,Default,,0,0,0,,Супер қаһармандар жиналды➡
Dialogue: 0,0:00:49.51,0:00:51.58,Default,,0,0,0,,Ең күшті батырлар командасы
Dialogue: 0,0:00:51.58,0:00:54.60,Default,,0,0,0,,Өзіңіздің керемет күшіңізді жинаңыз және жердің тыныштығын қорғаңыз! ＞
Dialogue: 0,0:00:54.60,0:00:56.92,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:56.92,0:00:59.07,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:59.07,0:01:01.59,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:01.59,0:01:03.57,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:03.57,0:01:05.59,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:05.59,0:01:07.59,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:09.58,0:01:12.07,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:12.07,0:01:15.12,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:15.12,0:01:17.15,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:17.15,0:01:19.19,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:19.19,0:01:21.19,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:23.26,0:01:27.30,Default,,0,0,0,,Мұнда жануарлардың барлық түрі бар.
Dialogue: 0,0:01:27.30,0:01:30.35,Default,,0,0,0,,Мама қарашы, бұл үлкен арыстан!
Dialogue: 0,0:01:30.35,0:01:32.24,Default,,0,0,0,,Бұл тастан жасалған.
Dialogue: 0,0:01:32.24,0:01:35.59,Default,,0,0,0,,Мен мұны білемін, мама. Бұл жерде!
Dialogue: 0,0:01:35.59,0:01:48.90,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:48.90,0:01:52.41,Default,,0,0,0,,Хахаха, егер Мидгардтағы барлық жануарлар осындай болса➡
Dialogue: 0,0:01:52.41,0:01:54.84,Default,,0,0,0,,Мен хайуанаттар бағына жиі келемін.
Dialogue: 0,0:01:54.84,0:01:57.23,Default,,0,0,0,,О, достарың да сенімен бірге ме?
Dialogue: 0,0:01:57.23,0:02:00.91,Default,,0,0,0,,Міне, міне! (Халк) Кеттік!
Dialogue: 0,0:02:00.91,0:02:07.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:07.84,0:02:10.92,Default,,0,0,0,,Мұны кім жасады? Зұлым күзетші?
Dialogue: 0,0:02:10.92,0:02:13.23,Default,,0,0,0,,Жануарларға кім осылай қараса да➡
Dialogue: 0,0:02:13.23,0:02:15.23,Default,,0,0,0,,Мен оларды кешіре алмаймын!
Dialogue: 0,0:02:15.23,0:02:17.43,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:17.43,0:02:21.27,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:02:21.27,0:02:23.67,Default,,0,0,0,,Терезе Hawkeye айналасын!
Dialogue: 0,0:02:27.26,0:02:29.91,Default,,0,0,0,,Сұңқар мен Тони аспаннан қолдау көрсетеді
Dialogue: 0,0:02:29.91,0:02:34.41,Default,,0,0,0,,Антман, мутацияның себебін табыңыз.
Dialogue: 0,0:02:34.41,0:02:38.57,Default,,0,0,0,,Қаш! Асығыңыз, асығыңыз!
Dialogue: 0,0:02:38.57,0:02:41.57,Default,,0,0,0,,Ешқандай ауытқу табылмады
Dialogue: 0,0:02:41.57,0:02:44.57,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:44.57,0:02:47.06,Default,,0,0,0,,Бұл мутация емес. Ол күшейтілді.
Dialogue: 0,0:02:47.06,0:02:51.25,Default,,0,0,0,,Қуат шекке дейін
Dialogue: 0,0:02:51.25,0:02:54.92,Default,,0,0,0,,Аюды маған қалдырыңыз, түлкіні беріңізші.
Dialogue: 0,0:02:54.92,0:02:57.92,Default,,0,0,0,,Бұл жігіттер кицюнеццер ме? Өтірік емес пе?
Dialogue: 0,0:03:00.31,0:03:02.43,Default,,0,0,0,,Тыңда, сондықтан. Біз ➡-мен айналысамыз
Dialogue: 0,0:03:02.43,0:03:06.13,Default,,0,0,0,,Бұл үлкен аң. Мен оны түсіндім.
Dialogue: 0,0:03:10.25,0:03:13.40,Default,,0,0,0,,Модерацияда. Бұл жігіттер зорлық-зомбылық жасамайды, өйткені оларға ұнайды.
Dialogue: 0,0:03:13.40,0:03:16.57,Default,,0,0,0,,Одиннің ұлына жануар сияқты қарайды ма?
Dialogue: 0,0:03:16.57,0:03:19.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:19.09,0:03:21.09,Default,,0,0,0,,Бұлай айтқаннан бері сізге шабуыл жасалды➡
Dialogue: 0,0:03:21.09,0:03:25.06,Default,,0,0,0,,Тор Ординсон, сен нағыз жауынгер емес пе едің?
Dialogue: 0,0:03:25.06,0:03:27.06,Default,,0,0,0,,ｻﾞﾙﾀﾞ？
Dialogue: 0,0:04:48.16,0:04:55.42,Default,,0,0,0,,♪♪～
Dialogue: 0,0:04:55.42,0:04:57.77,Default,,0,0,0,,Салда, дәл нені айтып тұрсың?
Dialogue: 0,0:04:57.77,0:05:00.41,Default,,0,0,0,,Біз одақтас емес, жаумыз.
Dialogue: 0,0:05:00.41,0:05:03.58,Default,,0,0,0,,Жоғарғы эскадрилья кек алушылардың жауы екені сөзсіз
Dialogue: 0,0:05:03.58,0:05:06.93,Default,,0,0,0,,Біріншіден, екеуміз де жауынгерміз.
Dialogue: 0,0:05:06.93,0:05:09.43,Default,,0,0,0,,Тез кел, мен тазалаймын!
Dialogue: 0,0:05:12.91,0:05:16.11,Default,,0,0,0,,Неткен сымбатты, қатал қозғалыс!
Dialogue: 0,0:05:20.33,0:05:22.83,Default,,0,0,0,,Ұйқы, асыл жануар.
Dialogue: 0,0:05:25.42,0:05:29.26,Default,,0,0,0,,Қарсыласты күшсіз ететін техника, Муспеллдің ұйқысы ма?
Dialogue: 0,0:05:29.26,0:05:33.26,Default,,0,0,0,,Иә, жануарларды ренжіту ақылға сыймайды.
Dialogue: 0,0:05:33.26,0:05:35.90,Default,,0,0,0,,Мен бірде сол әдісті қолданған жауынгерді кездестірдім.
Dialogue: 0,0:05:35.90,0:05:37.91,Default,,0,0,0,,Муспельсхайм шайқасында
Dialogue: 0,0:05:37.91,0:05:41.77,Default,,0,0,0,,Әй, менің эскадрильям бірде Шинмара жеріне шабуыл жасады.
Dialogue: 0,0:05:41.77,0:05:45.27,Default,,0,0,0,,Бұл сіз бен мен одақтас едік дегенді білдіре ме?
Dialogue: 0,0:05:47.59,0:05:50.59,Default,,0,0,0,,Кешіріңіз, жас ханым, қалғанын сізге қалдырамын.
Dialogue: 0,0:05:50.59,0:05:52.89,Default,,0,0,0,,Энергетикалық қаруды қолдануды тоқтатыңыз!
Dialogue: 0,0:05:55.73,0:05:59.24,Default,,0,0,0,,Салда? Мұның бәрі «Squadron Supreme» жұмысы ма?
Dialogue: 0,0:05:59.24,0:06:03.27,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:06:03.27,0:06:07.27,Default,,0,0,0,,Нағыз жауынгер абыройлы жануарға ешқашан зиян тигізбейді.
Dialogue: 0,0:06:09.93,0:06:12.42,Default,,0,0,0,,Сардадан мұндай сөз шығады деп күтпеп едім.
Dialogue: 0,0:06:12.42,0:06:17.07,Default,,0,0,0,,Қазіргі Салдаға сенуге болады. Оның адамгершілік сезімі таң қалдырады.
Dialogue: 0,0:06:17.07,0:06:20.76,Default,,0,0,0,,Уф... бұл жақсы, бірақ мәселе әлі шешілген жоқ.
Dialogue: 0,0:06:20.76,0:06:24.43,Default,,0,0,0,,Қал... Біз бұл жігіттерді қамаудың жолын табуымыз керек.
Dialogue: 0,0:06:24.43,0:06:26.58,Default,,0,0,0,,Бір жерге жиналу
Dialogue: 0,0:06:26.58,0:06:28.68,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:06:30.73,0:06:33.07,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:06:33.07,0:06:35.09,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:35.09,0:06:38.26,Default,,0,0,0,,Әзірге жануарларды энергетикалық торға қамалайық.
Dialogue: 0,0:06:38.26,0:06:45.92,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:45.92,0:06:48.58,Default,,0,0,0,,Жануарларды не өзгерткенін білмеймін➡
Dialogue: 0,0:06:48.58,0:06:51.42,Default,,0,0,0,,Бұл уақытша сияқты. Ол қалыпты жағдайға оралды.
Dialogue: 0,0:06:51.42,0:06:53.46,Default,,0,0,0,,(енеді)
Dialogue: 0,0:06:53.46,0:06:58.09,Default,,0,0,0,,Салда: Мен саған таң қалдым, бірақ маған көмектескенің үшін рахмет.
Dialogue: 0,0:06:58.09,0:07:01.08,Default,,0,0,0,,Ақымақ болма, сондықтан. Сіз эскадрильяның мүшесісіз.
Dialogue: 0,0:07:01.08,0:07:03.08,Default,,0,0,0,,Менің ойымша, қандай да бір жасырын ниет бар деп ойлаймын.
Dialogue: 0,0:07:05.23,0:07:09.17,Default,,0,0,0,,Жаттығуға бара жатқанымда кездейсоқ бір әбігерге тап болдым.
Dialogue: 0,0:07:09.17,0:07:11.07,Default,,0,0,0,,Жекпе-жек мені қозғайтын жалғыз нәрсе
Dialogue: 0,0:07:11.07,0:07:15.95,Default,,0,0,0,,Біздің жауынгерлер мен қарапайым сарбаздар арасындағы айырмашылық осында. Капитан
Dialogue: 0,0:07:15.95,0:07:19.25,Default,,0,0,0,,Тор Ординсон, сіз түсінуіңіз керек.
Dialogue: 0,0:07:19.25,0:07:21.58,Default,,0,0,0,,Жануарлар жауыз болып кетті➡
Dialogue: 0,0:07:21.58,0:07:23.90,Default,,0,0,0,,Сіз бұған қатысыңыз жоқ дейсіз бе?
Dialogue: 0,0:07:23.90,0:07:27.09,Default,,0,0,0,,Сенің сенетінің маған бәрібір.
Dialogue: 0,0:07:27.09,0:07:30.43,Default,,0,0,0,,Әлсіздерге куәлік етудің қажеті жоқ.
Dialogue: 0,0:07:30.43,0:07:32.75,Default,,0,0,0,,Сіз әлсіз адамсыз ба?
Dialogue: 0,0:07:32.75,0:07:34.75,Default,,0,0,0,,Ол Халкты ешқашан кездестірмеген сияқты.
Dialogue: 0,0:07:34.75,0:07:37.08,Default,,0,0,0,,Мені ұстаңыз! (Сарда) Енді жоқ ➡
Dialogue: 0,0:07:37.08,0:07:39.62,Default,,0,0,0,,Уақытты босқа кетіру! Ха ха...
Dialogue: 0,0:07:39.62,0:07:42.15,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:07:42.15,0:07:44.65,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:46.56,0:07:48.56,Default,,0,0,0,,А... иә?
Dialogue: 0,0:07:48.56,0:07:50.58,Default,,0,0,0,,Жоғалып кетті
Dialogue: 0,0:07:50.58,0:07:52.58,Default,,0,0,0,,Менің әлі де айтқым келген нәрсе бар еді.
Dialogue: 0,0:07:55.57,0:07:57.57,Default,,0,0,0,,Спутниктік суреттер де пайдасыз.
Dialogue: 0,0:07:57.57,0:07:59.57,Default,,0,0,0,,Радар мен инфрақызыл сәулелер де жақсы емес.
Dialogue: 0,0:07:59.57,0:08:03.58,Default,,0,0,0,,Эй, Видо, бұл екі адамға арналмаған.
Dialogue: 0,0:08:03.58,0:08:06.61,Default,,0,0,0,,Мені дәл алдымда тұрған эскадрилья қашып кетті.
Dialogue: 0,0:08:06.61,0:08:08.65,Default,,0,0,0,,Дене температурасының қолтаңбасы ше?
Dialogue: 0,0:08:08.65,0:08:11.40,Default,,0,0,0,,Мен үш рет тексердім. Салда шынымен де жоғалып кетті.
Dialogue: 0,0:08:11.40,0:08:14.74,Default,,0,0,0,,Зарда Nighthawk фан-клубынан кеткен шығар.
Dialogue: 0,0:08:14.74,0:08:17.77,Default,,0,0,0,,Бұл мүмкін. Доктор Спектр де қашып кетті, солай ма?
Dialogue: 0,0:08:17.77,0:08:20.41,Default,,0,0,0,,Зарда өз қалауымен эскадрильяға қосылды.
Dialogue: 0,0:08:20.41,0:08:22.40,Default,,0,0,0,,Бізге көмектесуге ешқандай себеп жоқ
Dialogue: 0,0:08:22.40,0:08:24.40,Default,,0,0,0,,Моральдық себептер бойынша
Dialogue: 0,0:08:24.40,0:08:27.57,Default,,0,0,0,,Муспельсхаймда шайқасқан жауынгерлер ант берді.
Dialogue: 0,0:08:27.57,0:08:30.25,Default,,0,0,0,,Даңқ пен адамгершілік үшін ғана күресу
Dialogue: 0,0:08:30.25,0:08:32.25,Default,,0,0,0,,Бұл ақымақ ант болды.
Dialogue: 0,0:08:32.25,0:08:34.41,Default,,0,0,0,,Алдыңғы Салданы қараңыз!
Dialogue: 0,0:08:34.41,0:08:36.93,Default,,0,0,0,,Жауынгерлер үшін ант – байлау.
Dialogue: 0,0:08:36.93,0:08:39.41,Default,,0,0,0,,Түнгі сұңқарлардың адамгершілік сезімі жоқ.
Dialogue: 0,0:08:39.41,0:08:42.58,Default,,0,0,0,,Зардадай жауынгерді ұзақ ұстай алмайсың.
Dialogue: 0,0:08:42.58,0:08:45.75,Default,,0,0,0,,Сарданың адамгершілік сезімі бар ма, жоқ па➡
Dialogue: 0,0:08:45.75,0:08:48.40,Default,,0,0,0,,Біз үшін әлі де қауіп
Dialogue: 0,0:08:48.40,0:08:50.92,Default,,0,0,0,,Ешкім түсінбейтінін білемін.
Dialogue: 0,0:08:50.92,0:08:53.91,Default,,0,0,0,,Мен бұл шайқаста жалғыз күресемін.
Dialogue: 0,0:08:53.91,0:08:56.10,Default,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:08:56.10,0:09:13.26,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:13.26,0:09:15.93,Default,,0,0,0,,Уау! Осымен өмір сүр!
Dialogue: 0,0:09:15.93,0:09:18.25,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:09:18.25,0:09:20.40,Default,,0,0,0,,Бұл өте кеш болды, солай емес пе?
Dialogue: 0,0:09:20.40,0:09:22.92,Default,,0,0,0,,Қай жерде екені туралы хабарланбаған
Dialogue: 0,0:09:22.92,0:09:26.39,Default,,0,0,0,,Келе жатқанын көрдім Нағыз жауынгерлер бірін-бірі тартады
Dialogue: 0,0:09:26.39,0:09:28.41,Default,,0,0,0,,Мен де осында жиі келемін.
Dialogue: 0,0:09:28.41,0:09:30.95,Default,,0,0,0,,Сіз өз қалауыңыз бойынша жаттыға аласыз.
Dialogue: 0,0:09:30.95,0:09:34.25,Default,,0,0,0,,Сен мені ұстау үшін келдің бе?
Dialogue: 0,0:09:34.25,0:09:37.75,Default,,0,0,0,,No. Муспельсхайм жауынгерлеріне➡
Dialogue: 0,0:09:37.75,0:09:39.89,Default,,0,0,0,,Өйткені мен құрмет көрсетуім керек деп ойладым.
Dialogue: 0,0:09:39.89,0:09:41.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:41.92,0:09:45.08,Default,,0,0,0,,Адамгершілік үшін күресуге ант бердік.
Dialogue: 0,0:09:45.08,0:09:48.75,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:48.75,0:09:52.10,Default,,0,0,0,,Эскадрильялардың шайқасы өзімшіл. Уф!
Dialogue: 0,0:09:52.10,0:09:56.42,Default,,0,0,0,,Nighthawk Жердегі әлсіз адамдарға тәртіп пен тәртіп әкелетінін айтты.
Dialogue: 0,0:09:56.42,0:09:59.78,Default,,0,0,0,,Бірақ дәл қазір мен тек Кек алушылар туралы ойлаймын.
Dialogue: 0,0:09:59.78,0:10:02.06,Default,,0,0,0,,Әрқашан кек алушылар туралы айтамыз!
Dialogue: 0,0:10:02.06,0:10:07.23,Default,,0,0,0,,Эскадрильялар мықты! Мен бұл күшті құрметтеймін
Dialogue: 0,0:10:07.23,0:10:10.09,Default,,0,0,0,,Сәлем! Батырлармен күрескен дұрыс➡
Dialogue: 0,0:10:10.09,0:10:12.59,Default,,0,0,0,,Дәл сіз сияқты емес пе?
Dialogue: 0,0:10:16.23,0:10:20.25,Default,,0,0,0,,Хаха! Әлсіз адам батыр ма?
Dialogue: 0,0:10:20.25,0:10:24.23,Default,,0,0,0,,Осы кішкентай әлемде дос бола алатын жауынгер болыңыз➡
Dialogue: 0,0:10:24.23,0:10:26.92,Default,,0,0,0,,Мен сені ешқашан кездестірген емеспін. Оған дейін➡
Dialogue: 0,0:10:26.92,0:10:30.92,Default,,0,0,0,,Мен туған жерім Утопияда ханшайым болдым
Dialogue: 0,0:10:30.92,0:10:34.24,Default,,0,0,0,,Тақта отырған менің анам болатын. Нағыз мықты адам➡
Dialogue: 0,0:10:34.24,0:10:38.75,Default,,0,0,0,,Менімен күрескен анамды құрметтеймін. (Сонымен) мен де бір патшаның баласымын.
Dialogue: 0,0:10:38.75,0:10:42.67,Default,,0,0,0,,Менің әкем де адамнан күдіктенетін. Бірақ адам әлсіз болып көрінсе де➡
Dialogue: 0,0:10:42.67,0:10:46.74,Default,,0,0,0,,Тоғыз дүниеде ешкімнен кем түспейтін ерік-жігері бар.
Dialogue: 0,0:10:46.74,0:10:50.39,Default,,0,0,0,,Бұл жеткілікті. Жаттығу үшін қолайлы жер бар.
Dialogue: 0,0:10:50.39,0:10:52.81,Default,,0,0,0,,Батыл болсаң, артымнан ер.
Dialogue: 0,0:10:52.81,0:10:59.92,Default,,0,0,0,,♪♪～
Dialogue: 0,0:10:59.92,0:11:04.24,Default,,0,0,0,,Бұл көрінбейтін кеме ме? Ол көзден ғайып болған болуы керек.
Dialogue: 0,0:11:04.24,0:11:06.91,Default,,0,0,0,,Жер бетінде мұндай ештеңе жоқ
Dialogue: 0,0:11:06.91,0:11:10.58,Default,,0,0,0,,Сіз мені алдамақшысыз ба?
Dialogue: 0,0:11:10.58,0:11:15.10,Default,,0,0,0,,Менің жауынгерлік мақтанышпен мен ешқашан мұндай әрекетке бармас едім.
Dialogue: 0,0:11:15.10,0:11:36.07,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:36.07,0:11:39.24,Default,,0,0,0,,Бұл тек мұхит түбіндегі тау жыныстары арқылы жасалған арал.
Dialogue: 0,0:11:39.24,0:11:42.24,Default,,0,0,0,,Мен мұнда өз Отанымның ДНҚ үлгісін әкелдім.
Dialogue: 0,0:11:42.24,0:11:47.25,Default,,0,0,0,,Біз сияқты нағыз жауынгерлерге арналған орын.
Dialogue: 0,0:11:47.25,0:11:50.75,Default,,0,0,0,,Басқа жауынгерлер жоқ. (Сарда) Мына балға➡
Dialogue: 0,0:11:50.75,0:11:54.91,Default,,0,0,0,,Сіз көп нәрсені жасай аласыз, бірақ мен сияқты жауынгер жасай алмайсыз.
Dialogue: 0,0:11:54.91,0:11:58.58,Default,,0,0,0,,Мен шынымен таң қалдым.
Dialogue: 0,0:11:58.58,0:12:03.23,Default,,0,0,0,,Тосын... әлі алда!
Dialogue: 0,0:12:03.23,0:12:05.25,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:12:05.25,0:12:09.67,Default,,0,0,0,,♪♪～
Dialogue: 0,0:12:09.67,0:12:12.27,Default,,0,0,0,,Бұл өте күрделі тұзақ.
Dialogue: 0,0:12:14.76,0:12:18.16,Default,,0,0,0,,Салда Сен мені алдадың!
Dialogue: 0,0:13:20.14,0:13:24.58,Default,,0,0,0,,Айдаһарды алып шығуға шыдамаймын... Менің қалағаным осы!
Dialogue: 0,0:13:24.58,0:13:37.93,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:37.93,0:13:42.41,Default,,0,0,0,,Саған сенгенім қате болды! Тұтқынға түсу деген нені білдіреді?
Dialogue: 0,0:13:42.41,0:13:46.09,Default,,0,0,0,,Тұзақ? Бұл нағыз жауынгерге берілген сыйлық.
Dialogue: 0,0:13:46.09,0:13:54.43,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:54.43,0:13:56.78,Default,,0,0,0,,Старктың тәтті жаттықтыру машинасы дегеніміз не➡
Dialogue: 0,0:13:56.78,0:13:58.81,Default,,0,0,0,,Салыстыруға болмайтындай болуы керек
Dialogue: 0,0:13:58.81,0:14:01.43,Default,,0,0,0,,Мен өз күшімді соншалықты зорлықпен шығара алдым➡
Dialogue: 0,0:14:01.43,0:14:05.43,Default,,0,0,0,,Көп уақыт өтті! керемет сыйлық болды
Dialogue: 0,0:14:08.09,0:14:10.99,Default,,0,0,0,,Сізге шын жүректен рахмет
Dialogue: 0,0:14:10.99,0:14:13.41,Default,,0,0,0,,Әлі біткен жоқ
Dialogue: 0,0:14:13.41,0:14:21.11,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:28.46,0:14:30.98,Default,,0,0,0,,Хаа…｡ Хаха!
Dialogue: 0,0:14:30.98,0:14:33.90,Default,,0,0,0,,Иә? Бұл Тордыкі
Dialogue: 0,0:14:33.90,0:14:36.09,Default,,0,0,0,,Ах, бірақ солай...
Dialogue: 0,0:14:36.09,0:14:38.75,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:14:38.75,0:14:41.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:41.44,0:14:44.14,Default,,0,0,0,,Майорния, кел!
Dialogue: 0,0:14:46.58,0:14:48.73,Default,,0,0,0,,Га
Dialogue: 0,0:14:48.73,0:14:51.58,Default,,0,0,0,,Бұл үлкен шайқас болды.
Dialogue: 0,0:14:51.58,0:14:55.12,Default,,0,0,0,,Сіз өзіңіздің қазіргі командаңызбен осындай қуанышты сезіне аласыз деп ойлайсыз ба?
Dialogue: 0,0:14:55.12,0:14:59.17,Default,,0,0,0,,«Кек алушылар» - адамдарды құтқару үшін өз өмірлерін қатерге тігеді.
Dialogue: 0,0:14:59.17,0:15:02.09,Default,,0,0,0,,Халк барлық адамдарға, тіпті оны жек көретіндерге де көмектеседі.
Dialogue: 0,0:15:02.09,0:15:05.10,Default,,0,0,0,,Кек алушылар? Аты-жөніне қарағанда, әлсіз емес пе?
Dialogue: 0,0:15:05.10,0:15:08.77,Default,,0,0,0,,Олар мұнарада зұлымдардың пайда болуын күтіп отыр.
Dialogue: 0,0:15:08.77,0:15:11.10,Default,,0,0,0,,Ерлігіңді танимыз.
Dialogue: 0,0:15:11.10,0:15:15.70,Default,,0,0,0,,Бірақ сенде миссияңды құрметтейтін жүрек, адалдық, жанашырлық бар ма?
Dialogue: 0,0:15:17.74,0:15:20.10,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:15:20.10,0:15:22.10,Default,,0,0,0,,Хамф!
Dialogue: 0,0:15:25.07,0:15:27.07,Default,,0,0,0,,Хмф!!
Dialogue: 0,0:15:31.74,0:15:33.74,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:15:37.43,0:15:40.78,Default,,0,0,0,,Сіз маған не жетіспейтінін көрсеттіңіз.
Dialogue: 0,0:15:40.78,0:15:43.09,Default,,0,0,0,,Бірақ сен де жауынгерсің→
Dialogue: 0,0:15:43.09,0:15:45.42,Default,,0,0,0,,Маған бірдеңе жетіспеді ме?
Dialogue: 0,0:15:45.42,0:15:49.26,Default,,0,0,0,,Жерлестердің арасында тым көп болып, жұмсақ болып кеткен сияқтысың.
Dialogue: 0,0:15:49.26,0:15:54.73,Default,,0,0,0,,Қазіргі шайқас жеткіліксіз деп ойлайсыз ба? Бұл жай ғана қыздыру
Dialogue: 0,0:15:54.73,0:15:56.73,Default,,0,0,0,,Хмф!
Dialogue: 0,0:16:00.07,0:16:02.75,Default,,0,0,0,,Бұл рок-тролль ма? Бұл лас.
Dialogue: 0,0:16:02.75,0:16:05.76,Default,,0,0,0,,Нағыз жауынгердің қалай күресетінін көрсетейін
Dialogue: 0,0:16:05.76,0:16:07.76,Default,,0,0,0,,Хамф!
Dialogue: 0,0:16:07.76,0:16:10.16,Default,,0,0,0,,Әй... Уау!
Dialogue: 0,0:16:12.08,0:16:15.08,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:16:15.08,0:16:18.09,Default,,0,0,0,,Бұл жолы мен жалғыз күреспеймін.
Dialogue: 0,0:16:18.09,0:16:20.09,Default,,0,0,0,,Хмм... Ха!
Dialogue: 0,0:16:22.11,0:16:24.11,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:26.08,0:16:28.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:30.42,0:16:34.42,Default,,0,0,0,,Әділ жекпе-жек қандай болатынын байқап көрейік.
Dialogue: 0,0:16:34.42,0:16:36.42,Default,,0,0,0,,Хмф! (｜｜) Ха!
Dialogue: 0,0:16:39.91,0:16:42.41,Default,,0,0,0,,Халк әлі де күңіреніп тұр ма?
Dialogue: 0,0:16:42.41,0:16:45.43,Default,,0,0,0,,Күрсін... Мен өзім көптен бері ойын ойнадым.
Dialogue: 0,0:16:45.43,0:16:47.48,Default,,0,0,0,,Егер сіз мұның бәрін өзіңізде сақтасаңыз, адамдар сізді жек көреді.
Dialogue: 0,0:16:47.48,0:16:50.09,Default,,0,0,0,,[Спикер] (Джервис) Теңізде қалыпты емес толқын қозғалысы анықталды.
Dialogue: 0,0:16:50.09,0:16:52.09,Default,,0,0,0,,Нью-Йоркке жоғары толқындар келеді!!
Dialogue: 0,0:16:52.09,0:16:55.42,Default,,0,0,0,,Бұл бұрын да болған. Біреу Аттомаға еліктеп жатыр ма?
Dialogue: 0,0:16:55.42,0:16:57.42,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:17:01.81,0:17:06.21,Default,,0,0,0,,Тор... Бір жерде Тор төбелесіп жатыр.
Dialogue: 0,0:17:08.09,0:17:11.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:11.07,0:17:13.74,Default,,0,0,0,,Ха! Хаха!
Dialogue: 0,0:17:13.74,0:17:17.76,Default,,0,0,0,,Сергіту сезімін тудырады. Мен де осындай аралға ие болғым келеді.
Dialogue: 0,0:17:17.76,0:17:20.42,Default,,0,0,0,,Бұл жағдайда сіз бұл аралды пайдалана аласыз.
Dialogue: 0,0:17:20.42,0:17:23.77,Default,,0,0,0,,Бұл менің Squadron Supreme мүшесі болуым керек дегенді білдіре ме?
Dialogue: 0,0:17:23.77,0:17:27.42,Default,,0,0,0,,Мен сені құрметтеймін, бірақ достарың басқа.
Dialogue: 0,0:17:27.42,0:17:31.09,Default,,0,0,0,,Бұл билікті әділеттілік үшін пайдалана білу керек.
Dialogue: 0,0:17:31.09,0:17:33.75,Default,,0,0,0,,Менің достарым ең күшті
Dialogue: 0,0:17:33.75,0:17:37.23,Default,,0,0,0,,Кім күшті екенін анықтайтын кез келген сияқты.
Dialogue: 0,0:17:37.23,0:17:39.64,Default,,0,0,0,,Хмф! Апыр-ай! Уф...
Dialogue: 0,0:17:39.64,0:17:43.24,Default,,0,0,0,,Келіңіздер, сіздің спарринг серіктесі ретінде жарамды екеніңізді көрейік.
Dialogue: 0,0:17:43.24,0:17:45.24,Default,,0,0,0,,Хмф! Хмф!
Dialogue: 0,0:17:45.24,0:17:47.24,Default,,0,0,0,,Ха! Тезек
Dialogue: 0,0:17:47.24,0:17:49.26,Default,,0,0,0,,Мен сені жеңсем ше?
Dialogue: 0,0:17:49.26,0:17:53.46,Default,,0,0,0,,Мені жеңсең, мен эскадрильядан кетемін деп уәде беремін.
Dialogue: 0,0:17:55.83,0:17:57.75,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:17:57.75,0:18:03.13,Default,,0,0,0,,Оның орнына, мен жеңсем, сіз Кек алушылардан кетесіз.
Dialogue: 0,0:18:03.13,0:18:05.76,Default,,0,0,0,,Хмф! Хмм...
Dialogue: 0,0:18:05.76,0:18:07.73,Default,,0,0,0,,Уау! Хамф!
Dialogue: 0,0:18:07.73,0:18:09.73,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:11.77,0:18:16.42,Default,,0,0,0,,Сіздің жауабыңыз қандай? Кек алушыларға деген адалдығыңнан бас тартуға дайынсың ба?
Dialogue: 0,0:18:16.42,0:18:20.42,Default,,0,0,0,,Маған дайындалу керек жалғыз уақыт, егер мен жеңіліп қалу мүмкіндігім болса.
Dialogue: 0,0:18:23.08,0:18:25.75,Default,,0,0,0,,Ха! Хамф!
Dialogue: 0,0:18:25.75,0:18:29.65,Default,,0,0,0,,Сиқыр қажет пе? Сіз балғаны біраз уақытқа дейін пайдалана алмайсыз.
Dialogue: 0,0:18:31.75,0:18:33.76,Default,,0,0,0,,Уау
Dialogue: 0,0:18:33.76,0:18:36.43,Default,,0,0,0,,Бұл толқын сіздің әрекетіңіз, солай ма?
Dialogue: 0,0:18:36.43,0:18:38.41,Default,,0,0,0,,Сіз қайдасыз?
Dialogue: 0,0:18:38.41,0:18:41.11,Default,,0,0,0,,Бұл Тор жоғалтқан нәрсе ме?
Dialogue: 0,0:18:45.08,0:18:47.10,Default,,0,0,0,,ﾑｼﾞｮﾙﾆｱ！
Dialogue: 0,0:18:47.10,0:18:49.20,Default,,0,0,0,,Бағыну?
Dialogue: 0,0:18:51.26,0:18:54.96,Default,,0,0,0,,Асгардиялықтар Кек алушылардан кетеді.
Dialogue: 0,0:18:58.66,0:19:00.92,Default,,0,0,0,,Мен сенен әлі жеңілген жоқпын➡
Dialogue: 0,0:19:00.92,0:19:03.40,Default,,0,0,0,,Кек алушылардан кетсем де➡
Dialogue: 0,0:19:03.40,0:19:06.30,Default,,0,0,0,,Мидгардты қорғау үшін күрес
Dialogue: 0,0:19:06.30,0:19:10.08,Default,,0,0,0,,Сіз және мен кек алушылар мен эскадрильялардан артықпыз.
Dialogue: 0,0:19:10.08,0:19:12.26,Default,,0,0,0,,Бәріміз шаңға айналып, ұмытылсақ та➡
Dialogue: 0,0:19:12.26,0:19:14.66,Default,,0,0,0,,Аңызға айналып, өмір сүріңіз
Dialogue: 0,0:19:17.92,0:19:20.42,Default,,0,0,0,,Аһ!
Dialogue: 0,0:19:20.42,0:19:23.41,Default,,0,0,0,,Асгард пен Утопияның корольдік отбасы ретінде...
Dialogue: 0,0:19:23.41,0:19:25.41,Default,,0,0,0,,Жас ханым
Dialogue: 0,0:19:29.75,0:19:31.75,Default,,0,0,0,,Әдепті болған жақсы
Dialogue: 0,0:19:31.75,0:19:34.75,Default,,0,0,0,,Қандай қорқақ шабуыл! Кет, хайуан!
Dialogue: 0,0:19:36.75,0:19:38.92,Default,,0,0,0,,Тіпті сіз кемені эвакуациялап, толқынды толқын жасасаңыз да➡
Dialogue: 0,0:19:38.92,0:19:41.22,Default,,0,0,0,,Осылай жалғаса берсе, қалаға қауіп төнеді.
Dialogue: 0,0:19:44.58,0:19:46.56,Default,,0,0,0,,Мен мұндай толқындарды бұрын да тоқтатқанмын.
Dialogue: 0,0:19:46.56,0:19:48.58,Default,,0,0,0,,Мен мұны осы жолы қайталай аламын. Ах.
Dialogue: 0,0:19:48.58,0:19:51.08,Default,,0,0,0,,Бірақ бұрын Халк пен Тор болды.
Dialogue: 0,0:20:53.09,0:20:55.93,Default,,0,0,0,,Нағыз жауынгерлердің шайқасына араластың.
Dialogue: 0,0:20:55.93,0:20:58.08,Default,,0,0,0,,Бұл жерді қалай таптың?
Dialogue: 0,0:20:58.08,0:21:01.24,Default,,0,0,0,,Сіздің кездесуіңіз үшін теңіз толқынды. Мен толқындардың артынан жүрдім.
Dialogue: 0,0:21:01.24,0:21:05.11,Default,,0,0,0,,Сатқын. Мені жеңе алмайтыныңды білесің➡
Dialogue: 0,0:21:05.11,0:21:08.74,Default,,0,0,0,,Сіз ақымақ жасыл құбыжықты қолдауға шақырдыңыз ба?
Dialogue: 0,0:21:08.74,0:21:10.75,Default,,0,0,0,,｜Мына жігіт жау, солай ма?
Dialogue: 0,0:21:10.75,0:21:15.07,Default,,0,0,0,,Зарда жауынгерлік ант қабылдады. Бұл ең қасиетті ант.
Dialogue: 0,0:21:15.07,0:21:18.57,Default,,0,0,0,,Қасиетті? Ақымақ болма. Сіз жақтауға қалдыңыз.
Dialogue: 0,0:21:18.57,0:21:22.06,Default,,0,0,0,,Сіз Асгардтың дәстүрін қорлауға тырысасыз ба?
Dialogue: 0,0:21:22.06,0:21:25.74,Default,,0,0,0,,Антман Мұны кішірейту үшін бірдеңе істей алмайсыз ба?
Dialogue: 0,0:21:25.74,0:21:28.60,Default,,0,0,0,,Теңізді тарылту керек пе? Жарайды, жасап көрейік
Dialogue: 0,0:21:28.60,0:21:32.40,Default,,0,0,0,,Тони, мен бұрын қолданған қуат торын дайындап жатырмын.
Dialogue: 0,0:21:34.92,0:21:38.41,Default,,0,0,0,,Жарайды, мен реактор сымдарын ауыстырдым. Сіз мұны кез келген уақытта жасай аласыз.
Dialogue: 0,0:21:38.41,0:21:41.56,Default,,0,0,0,,Күтіңіз, күтіңіз.
Dialogue: 0,0:21:41.56,0:21:44.41,Default,,0,0,0,,Кез келген уақытта емес, қазір!
Dialogue: 0,0:21:44.41,0:21:48.95,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:48.95,0:21:50.99,Default,,0,0,0,,Келесісі жақын арада келеді.
Dialogue: 0,0:21:50.99,0:21:53.26,Default,,0,0,0,,Бұл ауытқудың себебін анықтауымыз керек.
Dialogue: 0,0:21:53.26,0:21:55.26,Default,,0,0,0,,Қазірдің өзінде істеп жатырмын
Dialogue: 0,0:22:00.23,0:22:02.23,Default,,0,0,0,,Аң!
Dialogue: 0,0:22:06.42,0:22:09.92,Default,,0,0,0,,Сіз өзіңіз сияқты емессіз. Сізді Зарда басқарып жатыр.
Dialogue: 0,0:22:09.92,0:22:13.42,Default,,0,0,0,,Мен сендерге «Кек алушылар» ғажайыптарын көрсеткім келеді.
Dialogue: 0,0:22:20.08,0:22:22.58,Default,,0,0,0,,Достарыңызбен төбелесу арқылы?
Dialogue: 0,0:22:27.09,0:22:30.41,Default,,0,0,0,,Айтқаныңызда бір ой болуы мүмкін.
Dialogue: 0,0:22:30.41,0:22:34.26,Default,,0,0,0,,Мен сенің төбелесіңді осылай оңай қояды деп ойламадым➡
Dialogue: 0,0:22:34.26,0:22:37.92,Default,,0,0,0,,Мен сені нағыз жауынгер деп ойладым.
Dialogue: 0,0:22:37.92,0:22:41.75,Default,,0,0,0,,Бірақ достарымен шайқасу арқылы атақ-даңқ жоқ.
Dialogue: 0,0:22:41.75,0:22:45.15,Default,,0,0,0,,Сонда мен оны енді дос деп айта алмаймын.
Dialogue: 0,0:22:47.64,0:22:50.18,Default,,0,0,0,,ｿｰ！
Dialogue: 0,0:22:50.18,0:22:52.10,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:22:52.10,0:22:56.10,Default,,0,0,0,,Хайуанаттар бағында осылай істедік. Біз жер бетіндегі жануарларды күшейттік.
Dialogue: 0,0:22:59.05,0:23:01.07,Default,,0,0,0,,Бұл сіздің әрекетіңіз бе?
Dialogue: 0,0:23:01.07,0:23:04.91,Default,,0,0,0,,Малдың да қадірі бар деп айтпадың ба?
Dialogue: 0,0:23:04.91,0:23:07.90,Default,,0,0,0,,Биліктен асқан қадір бар ма?
Dialogue: 0,0:23:07.90,0:23:11.80,Default,,0,0,0,,Оооуу!
Dialogue: 0,0:23:11.80,0:23:14.57,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:23:14.57,0:23:18.57,Default,,0,0,0,,Егер сен тоқтамасаң, мен сені тоқтатамын.
Dialogue: 0,0:23:18.57,0:23:20.58,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:23:20.58,0:23:24.73,Default,,0,0,0,,Балғаңдай, Мен ғана көтере аламын.
Dialogue: 0,0:23:24.73,0:23:28.58,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ. Бұл нәрсе менің сиқырыммен қозғалады.
Dialogue: 0,0:23:28.58,0:23:30.75,Default,,0,0,0,,Тоқта және абыройға ие бол.
Dialogue: 0,0:23:30.75,0:23:35.45,Default,,0,0,0,,Жоқ, мен Кек алушылар достарыма опасыздық жасамаймын.
Dialogue: 0,0:23:40.08,0:23:44.73,Default,,0,0,0,,Аңды жеңіп, даңққа ие бол. Сіз нағыз жауынгерсіз бе?
Dialogue: 0,0:23:44.73,0:23:47.07,Default,,0,0,0,,Сіз қателесесіз
Dialogue: 0,0:23:47.07,0:23:50.09,Default,,0,0,0,,Жауынгер осылайша шайқасады Уау!
Dialogue: 0,0:23:50.09,0:23:52.14,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:23:52.14,0:23:54.64,Default,,0,0,0,,Халк мен сенімен ұрыспаймын.
Dialogue: 0,0:23:56.56,0:23:58.56,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:23:58.56,0:24:01.42,Default,,0,0,0,,Зарданы тоқтату Уф!
Dialogue: 0,0:24:01.42,0:24:03.95,Default,,0,0,0,,Уау! Ол кетті!
Dialogue: 0,0:24:03.95,0:24:07.56,Default,,0,0,0,,Сенің бұл жігітті қорғамақ болғаныңның себебі, сен әлсізсің!
Dialogue: 0,0:24:07.56,0:24:12.24,Default,,0,0,0,,(айқайлау)
Dialogue: 0,0:24:12.24,0:24:14.90,Default,,0,0,0,,Сен маған қауіп төндірдің.
Dialogue: 0,0:24:14.90,0:24:17.58,Default,,0,0,0,,Сіздің арқаңызда мен өзімді жоғалтпадым.
Dialogue: 0,0:24:17.58,0:24:21.75,Default,,0,0,0,,Мен жай ғана біреумен ойын ойнағым келді.
Dialogue: 0,0:24:21.75,0:24:25.26,Default,,0,0,0,,Мен сені досым еткім келеді➡
Dialogue: 0,0:24:25.26,0:24:27.41,Default,,0,0,0,,Тәуекелдерге қарамастан мен бұл аралды көрсеттім.
Dialogue: 0,0:24:27.41,0:24:29.41,Default,,0,0,0,,Бірақ мен қателескен сияқтымын.
Dialogue: 0,0:24:36.07,0:24:38.09,Default,,0,0,0,,Мен аралды суға батырамын.
Dialogue: 0,0:24:38.09,0:24:40.09,Default,,0,0,0,,Бұл арал?
Dialogue: 0,0:24:43.74,0:24:45.74,Default,,0,0,0,,Ой!
Dialogue: 0,0:24:52.63,0:24:55.40,Default,,0,0,0,,Не?
Dialogue: 0,0:24:55.40,0:24:58.26,Default,,0,0,0,,Достарына арқа сүйеу дұрыс емес пе?
Dialogue: 0,0:24:58.26,0:25:00.76,Default,,0,0,0,,Сондай-ақ орамал.
Dialogue: 0,0:25:04.35,0:25:08.25,Default,,0,0,0,,Торды біздің жағымызға әкелу стратегиясы сәтсіздікке ұшырады.
Dialogue: 0,0:25:08.25,0:25:10.25,Default,,0,0,0,,Мен күткенмен
Dialogue: 0,0:25:10.25,0:25:12.74,Default,,0,0,0,,Билікке ие болу – жауынгердің антын сақтау➡
Dialogue: 0,0:25:12.74,0:25:17.43,Default,,0,0,0,,Шынайы даңққа ілесу - мен мұны Тор түсінеді деп ойладым.
Dialogue: 0,0:25:17.43,0:25:22.58,Default,,0,0,0,,Бірақ мен... Бірақ сен қателестің.
Dialogue: 0,0:25:22.58,0:25:26.08,Default,,0,0,0,,Сіз сәтсіздікке ұшырасаңыз да, Nighthawk риза сияқты.
Dialogue: 0,0:25:26.08,0:25:30.00,Default,,0,0,0,,Менің стратегиямнан басқа жол жоқ екенін көріп тұрсыз.
Dialogue: 0,0:25:30.00,0:25:36.08,Default,,0,0,0,,Аа, Кек алушылар толығымен талқандалу керек.
Dialogue: 0,0:25:36.08,0:25:40.25,Default,,0,0,0,,Не? Айдаһарлар мен рок-роллдар аралы?
Dialogue: 0,0:25:40.25,0:25:42.73,Default,,0,0,0,,Бұл қорқынышты. Бұл көңілді болды.
Dialogue: 0,0:25:42.73,0:25:46.24,Default,,0,0,0,,Мен келісемін. Мен олармен қайтадан күрескім келеді.
Dialogue: 0,0:25:46.24,0:25:49.09,Default,,0,0,0,,Мен келісемін. Біз шынымен жақсы араласамыз.
Dialogue: 0,0:25:49.09,0:25:52.08,Default,,0,0,0,,Бұл ақымақ жасыл құбыжықтың жаттығу бөлмесі!
Dialogue: 0,0:25:52.08,0:25:54.75,Default,,0,0,0,,Бұл екеуі тамаша үйлеседі.
Dialogue: 0,0:25:54.75,0:25:56.77,Default,,0,0,0,,Мен үлгере алмаймын
Dialogue: 0,0:25:56.77,0:26:01.25,Default,,0,0,0,,Кешіріңіз! Ақыры менің кезегім хаха!
Dialogue: 0,0:26:01.25,0:26:03.75,Default,,0,0,0,,Ах, контроллер бұзылған!
Dialogue: 0,0:26:36.12,0:26:38.16,Default,,0,0,0,,<“Кек алушылар жиналуда”➡ пайда болады
Dialogue: 0,0:26:38.16,0:26:40.16,Default,,0,0,0,,Супер қаһармандар, жауыздар және т.б. туралы ақпарат➡
Dialogue: 0,0:26:40.16,0:26:42.24,Default,,0,0,0,,Осы жерде жинаңыз
Dialogue: 0,0:26:42.24,0:26:44.90,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:44.90,0:26:47.58,Default,,0,0,0,,Ол Күш ханшайымы➡ ретінде де белгілі
Dialogue: 0,0:26:47.58,0:26:50.44,Default,,0,0,0,,Дыбыстан жоғары жылдамдықпен ұшу Адамнан тыс физикалық күш➡
Dialogue: 0,0:26:50.44,0:26:54.24,Default,,0,0,0,,Және ерекше рефлекстері мен сезімдерімен мақтана алады.
Dialogue: 0,0:26:54.24,0:26:56.59,Default,,0,0,0,,Басқа өлшемдегі батырлар командасы ➡
Dialogue: 0,0:26:56.59,0:26:59.09,Default,,0,0,0,,Squadron Supreme мүшесі ретінде сахна артында жұмыс істеу＞
Dialogue: 0,0:26:59.09,0:27:01.09,Default,,0,0,0,,Оған бүкіл әлем куә болды.
Dialogue: 0,0:27:02.59,0:27:08.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
