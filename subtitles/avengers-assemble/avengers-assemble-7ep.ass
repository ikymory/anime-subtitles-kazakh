Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:38.30,0:00:40.60,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.18,0:00:47.19,Default,,0,0,0,,<Кек алушылар, бұл супер қаһармандар➡
Dialogue: 0,0:00:47.19,0:00:49.80,Default,,0,0,0,,Жиналған ең күшті батырлар командасы
Dialogue: 0,0:00:49.80,0:00:52.13,Default,,0,0,0,,Өзіңіздің трансценденттік күшіңізді жинаңыз➡
Dialogue: 0,0:00:52.13,0:00:54.14,Default,,0,0,0,,Жер бетіндегі бейбітшілікті қорға! ＞
Dialogue: 0,0:00:54.14,0:00:56.12,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:56.12,0:00:58.29,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:58.29,0:01:00.79,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:00.79,0:01:02.81,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:02.81,0:01:04.81,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:04.81,0:01:06.81,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:08.80,0:01:11.30,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:11.30,0:01:14.31,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:14.31,0:01:16.34,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:16.34,0:01:18.36,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:18.36,0:01:20.36,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:22.30,0:01:26.15,Default,,0,0,0,,Онымен сөйлесудің қажеті жоқ. Ол есін жоғалтып жатыр.
Dialogue: 0,0:01:26.15,0:01:28.19,Default,,0,0,0,,Бірақ менің басқа амалым жоқ.
Dialogue: 0,0:01:28.19,0:01:30.96,Default,,0,0,0,,Шексіздік тасын табу үшін ақпарат сұраңыз.
Dialogue: 0,0:01:30.96,0:01:34.14,Default,,0,0,0,,Абайлаңыз, Тони. Мен өткен тәжірибелерден сабақ алдым.
Dialogue: 0,0:01:34.14,0:01:36.79,Default,,0,0,0,,Қызыл бас сүйекпен ешқашан сақтықты төмендетпеңіз.
Dialogue: 0,0:01:36.79,0:01:39.98,Default,,0,0,0,,Жаман болған кездегі Бас сүйек.
Dialogue: 0,0:01:39.98,0:01:42.47,Default,,0,0,0,,Миының зақымдалуына байланысты ол қазір зиянсыз.
Dialogue: 0,0:01:42.47,0:01:44.67,Default,,0,0,0,,Бұрынғыға қарағанда өңдеу оңайырақ
Dialogue: 0,0:01:47.97,0:01:51.14,Default,,0,0,0,,(ﾚｯﾄﾞ･ｽｶﾙ)ﾔｰ ﾔｰ ﾔｰ｡ ｽｶﾙ
Dialogue: 0,0:01:51.14,0:01:53.94,Default,,0,0,0,,Шексіздік тасы жоқ
Dialogue: 0,0:01:57.31,0:01:59.62,Default,,0,0,0,,Бірақ мен радиотолқынды ұстадым.
Dialogue: 0,0:01:59.62,0:02:01.65,Default,,0,0,0,,Егер бұл сіздің телефоныңыз болмаса➡
Dialogue: 0,0:02:01.65,0:02:04.79,Default,,0,0,0,,Бұл бақылау сигналы емес пе?
Dialogue: 0,0:02:04.79,0:02:06.81,Default,,0,0,0,,Уақыт келді!
Dialogue: 0,0:02:06.81,0:02:08.81,Default,,0,0,0,,Өйткені, мен сені жай ғана толқыдым.
Dialogue: 0,0:02:08.81,0:02:10.81,Default,,0,0,0,,Басқа сұрағыңыз келетін нәрсе бар ма?
Dialogue: 0,0:02:18.99,0:02:25.81,Default,,0,0,0,,《Уақыт ғарыш күшінің рухы
Dialogue: 0,0:02:25.81,0:02:28.41,Default,,0,0,0,,Шындық》
Dialogue: 0,0:02:33.97,0:02:38.16,Default,,0,0,0,,Мен өзіме қажет нәрсені білдім. Рақмет сізге.
Dialogue: 0,0:02:38.16,0:02:40.86,Default,,0,0,0,,Менің не айтқанымды білесің бе?
Dialogue: 0,0:02:43.63,0:02:47.82,Default,,0,0,0,,Шындық Ақыл Күші Кеңістік Уақыт
Dialogue: 0,0:02:47.82,0:02:50.80,Default,,0,0,0,,Мен мұны 10 рет естідім, бірақ бұл міндетті пәндер тізімі ме?
Dialogue: 0,0:02:50.80,0:02:52.97,Default,,0,0,0,,Шексіздік тастың күші ашылды.
Dialogue: 0,0:02:52.97,0:02:54.97,Default,,0,0,0,,Мен дұрыс емес жолмен іздедім.
Dialogue: 0,0:02:54.97,0:02:57.31,Default,,0,0,0,,Басқаша айтқанда, бұл тастың қайда екендігі туралы емес ...
Dialogue: 0,0:02:57.31,0:02:59.64,Default,,0,0,0,,Қай дәуірде екеніне байланысты.Көрдім.
Dialogue: 0,0:02:59.64,0:03:02.65,Default,,0,0,0,,Өткенге оралудан аулақ болыңыз.
Dialogue: 0,0:03:02.65,0:03:06.03,Default,,0,0,0,,Бастауыш мектепке қайта оралу - ең жаманы.
Dialogue: 0,0:03:06.03,0:03:10.14,Default,,0,0,0,,Сіз мені онша жек көресіз деп ойлаймын. Мен өткеннен көп нәрсені үйрендім.
Dialogue: 0,0:03:10.14,0:03:12.47,Default,,0,0,0,,Өткен – даңқты жетістіктердің қазынасы.
Dialogue: 0,0:03:12.47,0:03:14.81,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба? Бұрын толық дамымаған➡
Dialogue: 0,0:03:14.81,0:03:16.96,Default,,0,0,0,,Мен жай ғана ұялып тұрмын
Dialogue: 0,0:03:16.96,0:03:19.98,Default,,0,0,0,,Өткен өміріңіздің арқасында сіз бүгін кім екеніңізді білесіз.
Dialogue: 0,0:03:19.98,0:03:22.97,Default,,0,0,0,,Мен болашаққа қараймын, ал сен өткенді еске түсіресің
Dialogue: 0,0:03:22.97,0:03:25.87,Default,,0,0,0,,Міне, мұның бәрі даралық туралы. (Ескерту дыбысы)
Dialogue: 0,0:03:28.49,0:03:32.54,Default,,0,0,0,,Толқу көп сияқты, бірақ біз келдік.
Dialogue: 0,0:03:32.54,0:03:37.13,Default,,0,0,0,,Қараңызшы, менің есептеулерім дұрыс болса... олар әрқашан дұрыс.
Dialogue: 0,0:03:37.13,0:03:40.15,Default,,0,0,0,,Мұнда Уақыт тасы пайда болуы керек.
Dialogue: 0,0:03:40.15,0:03:45.21,Default,,0,0,0,,3 секунд қалды 2 1
Dialogue: 0,0:03:45.21,0:03:49.31,Default,,0,0,0,,Қараңдаршы, мынандай. Әрқашан дұрыс.
Dialogue: 0,0:03:49.31,0:03:51.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:51.61,0:03:53.78,Default,,0,0,0,,Бұл менің айтқаным дұрыс болғандықтан бола ма?
Dialogue: 0,0:03:53.78,0:03:57.13,Default,,0,0,0,,Джарвис Джарвисті қайта іске қосуда!
Dialogue: 0,0:03:57.13,0:03:59.14,Default,,0,0,0,,ﾄﾆｰ！
Dialogue: 0,0:03:59.14,0:04:03.97,Default,,0,0,0,,Сондықтан мен Asgard өнімдері үшін батареяларды пайдаланбаймын.
Dialogue: 0,0:04:03.97,0:04:06.16,Default,,0,0,0,,Өткенге оралудың қажеті болмағанына қуаныштымын.
Dialogue: 0,0:04:06.16,0:04:08.66,Default,,0,0,0,,Бастауыш мектеп шынымен жағымсыз жер.
Dialogue: 0,0:04:08.66,0:04:10.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:14.65,0:04:17.35,Default,,0,0,0,,Ей, енді не болады? Бітіру кеші?
Dialogue: 0,0:05:39.37,0:05:42.14,Default,,0,0,0,,Динозавр шапқыншылығы не болып жатыр?
Dialogue: 0,0:05:42.14,0:05:44.66,Default,,0,0,0,,Мен динозаврларды жақсы көремін
Dialogue: 0,0:05:44.66,0:05:48.65,Default,,0,0,0,,Өтінемін, біреу маған көмектесші. Қуат қосылмайды.
Dialogue: 0,0:05:48.65,0:05:52.45,Default,,0,0,0,,Майорнияға батареялар қажет емес. Енді осыны айтып тұрсың ба?
Dialogue: 0,0:05:58.46,0:06:02.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:02.48,0:06:05.98,Default,,0,0,0,,Түсіндіңіз бе? Сол себепті өткенді жек көремін
Dialogue: 0,0:06:12.15,0:06:14.32,Default,,0,0,0,,[Сымсыз] (Сұңқар) Бағдарламадан бас тартып, Hawkeye-ге өтіңіз
Dialogue: 0,0:06:14.32,0:06:17.17,Default,,0,0,0,,Деректерден көріп отырғанымыздай, бұл әлі де қазіргі заман.
Dialogue: 0,0:06:17.17,0:06:19.47,Default,,0,0,0,,Динозаврларды да оқыт
Dialogue: 0,0:06:22.83,0:06:24.80,Default,,0,0,0,,Бұл қазіргі заман болса, динозаврлар қайдан пайда болды?
Dialogue: 0,0:06:24.80,0:06:28.34,Default,,0,0,0,,Бұл Савагеленд ме?
Dialogue: 0,0:06:28.34,0:06:32.14,Default,,0,0,0,,Динозаврларды жою? Бұл Iron Man және басқаларға көмектесетін уақыт емес еді.
Dialogue: 0,0:06:32.14,0:06:34.48,Default,,0,0,0,,Не?
Dialogue: 0,0:06:34.48,0:06:38.65,Default,,0,0,0,,Ха, мен динозаврмен соғысқаныма біраз болды.
Dialogue: 0,0:06:38.65,0:06:42.05,Default,,0,0,0,,Тағы да. Алақай!
Dialogue: 0,0:06:42.05,0:06:45.05,Default,,0,0,0,,Әй, сен оны қайда лақтырып жатырсың?
Dialogue: 0,0:06:49.46,0:06:51.81,Default,,0,0,0,,Түсіндіріңізші, доктор Эйнштейн.
Dialogue: 0,0:06:51.81,0:06:54.31,Default,,0,0,0,,Мен динозаврлар саябағында серуендеген болуым керек➡
Dialogue: 0,0:06:54.31,0:06:57.13,Default,,0,0,0,,Уақыт қабырғасын абайсызда тесіп алған шығармын.
Dialogue: 0,0:06:57.13,0:06:59.98,Default,,0,0,0,,Сіз тесікті жабасыз ба? Әрине аласыз
Dialogue: 0,0:06:59.98,0:07:02.99,Default,,0,0,0,,Бірақ алдымен доғалық реактордан тасты алуымыз керек.
Dialogue: 0,0:07:02.99,0:07:07.04,Default,,0,0,0,,Қайта жүктеу. Сіз әрқашан осылай жасайсыз.
Dialogue: 0,0:07:07.04,0:07:09.63,Default,,0,0,0,,Қайта жүктеу. Мен тырыстым, бірақ ол жұмыс істемеді.
Dialogue: 0,0:07:09.63,0:07:11.63,Default,,0,0,0,,Бірдеңе дұрыс емес
Dialogue: 0,0:07:11.63,0:07:14.63,Default,,0,0,0,,Аа, дауысы біртүрлі екен. Динамикте ақау бар ма?
Dialogue: 0,0:07:14.63,0:07:17.78,Default,,0,0,0,,Сіз қалай ойлайсыз? (тамақты тазартады)
Dialogue: 0,0:07:17.78,0:07:19.80,Default,,0,0,0,,ﾀﾞﾒ
Dialogue: 0,0:07:19.80,0:07:22.31,Default,,0,0,0,,Құрыш дұрыс жұмыс істеп тұр➡
Dialogue: 0,0:07:22.31,0:07:24.79,Default,,0,0,0,,Физикалық сипаттарды тани алмайды
Dialogue: 0,0:07:24.79,0:07:26.96,Default,,0,0,0,,Сіз өзіңізді басқа адаммын деп ойлайтын сияқтысыз.
Dialogue: 0,0:07:26.96,0:07:28.98,Default,,0,0,0,,Бұл басқа біреу болуы мүмкін емес.
Dialogue: 0,0:07:28.98,0:07:31.35,Default,,0,0,0,,Құрышыңызды шешіңіз. Мен одан шаршадым.
Dialogue: 0,0:07:31.35,0:07:33.47,Default,,0,0,0,,Бұл тым тітіркендіргіш емес пе?
Dialogue: 0,0:07:33.47,0:07:36.30,Default,,0,0,0,,Маған тітіркеніп қалмай, құлыптаулы отыра бер дейсің бе?
Dialogue: 0,0:07:36.30,0:07:39.79,Default,,0,0,0,,Халк, бет тақтасын алыңыз. Тез.
Dialogue: 0,0:07:39.79,0:07:41.98,Default,,0,0,0,,Оны жоймайынша мүмкін емес.
Dialogue: 0,0:07:41.98,0:07:43.98,Default,,0,0,0,,Жарайды, оны шешіп ал.
Dialogue: 0,0:07:47.85,0:07:50.15,Default,,0,0,0,,Тонидің шашы...
Dialogue: 0,0:07:52.14,0:07:55.47,Default,,0,0,0,,Бұл ең нашар күн.
Dialogue: 0,0:07:55.47,0:07:58.31,Default,,0,0,0,,Жасөспірімдік шағыңызға оралған сияқтысыз.
Dialogue: 0,0:07:58.31,0:08:00.31,Default,,0,0,0,,Оны көргенде білесің
Dialogue: 0,0:08:00.31,0:08:02.81,Default,,0,0,0,,Armor сіздің командаңызды танымау себебі➡
Dialogue: 0,0:08:02.81,0:08:05.31,Default,,0,0,0,,Өйткені бұл ересек адамның дауысы емес еді.
Dialogue: 0,0:08:07.73,0:08:09.97,Default,,0,0,0,,Ах! Сіз қалай жасарасыз?
Dialogue: 0,0:08:09.97,0:08:14.34,Default,,0,0,0,,Доғалық реактор жүрекке қосылған. Мүмкін бұл жүрек соғу жылдамдығына байланысты болуы мүмкін.
Dialogue: 0,0:08:14.34,0:08:16.38,Default,,0,0,0,,Себебін іздеуді кейінге қалдырыңыз.
Dialogue: 0,0:08:16.38,0:08:19.15,Default,,0,0,0,,Одан гөрі бұл оғаш құбылысты қалай тоқтатуға болады деген сұрақ туындайды.
Dialogue: 0,0:08:19.15,0:08:23.30,Default,,0,0,0,,Жастауды тоқтатуым керек. Безеу ме?
Dialogue: 0,0:08:23.30,0:08:25.30,Default,,0,0,0,,Тастан шыққан уақыт толқындары➡
Dialogue: 0,0:08:25.30,0:08:27.80,Default,,0,0,0,,Олар басқа дәуірден заттарды әкеліп жатқан сияқты.
Dialogue: 0,0:08:27.80,0:08:31.81,Default,,0,0,0,,Басқа дәуірлер ше? [Монитор] Қаш!
Dialogue: 0,0:08:31.81,0:08:34.65,Default,,0,0,0,,Бұл Тиранозавр!
Dialogue: 0,0:08:34.65,0:08:38.45,Default,,0,0,0,,А, мен мұны бастауыш мектептен де жек көретін шығармын.
Dialogue: 0,0:08:40.80,0:08:43.60,Default,,0,0,0,,Бұл Бродвей
Dialogue: 0,0:08:49.29,0:08:55.98,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:08:55.98,0:08:58.47,Default,,0,0,0,,Мен мұны суретке түсіруім керек.
Dialogue: 0,0:08:58.47,0:09:02.39,Default,,0,0,0,,Үлкен алмаға қош келдіңіз. Қолдарыңызды немесе аяқтарыңызды көліктің сыртына қоймаңыз.
Dialogue: 0,0:09:02.39,0:09:04.98,Default,,0,0,0,,Сіз тістегеніңізді білмейсіз. Динозаврлар отты жек көреді.
Dialogue: 0,0:09:04.98,0:09:07.63,Default,,0,0,0,,Сіз балғаны көбірек жек көресіз.
Dialogue: 0,0:09:07.63,0:09:10.16,Default,,0,0,0,,Мен жеңілгенді жек көремін!
Dialogue: 0,0:09:10.16,0:09:14.66,Default,,0,0,0,,[Радио] Тыңдаңыз, біз динозаврды Мидтаундағы бұрышқа бұрып, қоршаймыз.
Dialogue: 0,0:09:31.82,0:09:35.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:35.66,0:09:39.96,Default,,0,0,0,,Уау, сен қазір кереметсің. (Халк) Мен мұны саған еске түсірдім.
Dialogue: 0,0:09:45.80,0:09:48.30,Default,,0,0,0,,Сонымен, бұл сағат 6 бағыты.
Dialogue: 0,0:09:48.30,0:09:51.67,Default,,0,0,0,,Қандай қызық хаха
Dialogue: 0,0:09:51.67,0:09:54.81,Default,,0,0,0,,Уақыт тасының әсерін тоқтату керек емес пе?
Dialogue: 0,0:09:54.81,0:09:57.48,Default,,0,0,0,,Менің мұндай қауіпті бәс тігуге мүмкіндігім жоқ.
Dialogue: 0,0:09:57.48,0:09:59.48,Default,,0,0,0,,Саған менің амулетім керек емес
Dialogue: 0,0:09:59.48,0:10:01.48,Default,,0,0,0,,Жасөспірімдік шаққа оралсаңыз да, сіз әлі де данышпан боласыз.
Dialogue: 0,0:10:01.48,0:10:03.48,Default,,0,0,0,,Мен сізге көмектесуге келдім
Dialogue: 0,0:10:03.48,0:10:05.89,Default,,0,0,0,,Қараңызшы, бәрі жақсы.
Dialogue: 0,0:10:05.89,0:10:09.64,Default,,0,0,0,,Сіз мұны істейсіз бе? Әрине мүмкін
Dialogue: 0,0:10:09.64,0:10:11.98,Default,,0,0,0,,Кеудемде алғаш рет уақыт тасы қадалып тұр.
Dialogue: 0,0:10:11.98,0:10:14.13,Default,,0,0,0,,Бірақ мұны істеуден басқа амалым жоқ. Барайық.
Dialogue: 0,0:10:14.13,0:10:17.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:17.15,0:10:19.63,Default,,0,0,0,,Неге тоқтамайсың! Сондықтан мен саған ескерттім
Dialogue: 0,0:10:19.63,0:10:21.64,Default,,0,0,0,,Қалай айтасыз: Әкем сияқты
Dialogue: 0,0:10:21.64,0:10:24.30,Default,,0,0,0,,Әкем маған әрқашан сендей бол деп айтатын.
Dialogue: 0,0:10:24.30,0:10:27.30,Default,,0,0,0,,Бірақ мен ұлы Капитан Америка сияқты емеспін...
Dialogue: 0,0:10:31.98,0:10:33.98,Default,,0,0,0,,Капитан, маған көмектесіңізші.
Dialogue: 0,0:10:35.98,0:10:38.38,Default,,0,0,0,,Менің артымнан осы жолмен жүріңіз.
Dialogue: 0,0:10:41.64,0:10:44.34,Default,,0,0,0,,Маған сағынышқа толы достармен кездесуге рұқсат етіңіз
Dialogue: 0,0:10:55.32,0:10:59.31,Default,,0,0,0,,Мен динозаврларды өлтіруді толық түсіндім.
Dialogue: 0,0:10:59.31,0:11:01.31,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:11:06.50,0:11:11.65,Default,,0,0,0,,Уақыт ағымында анықталған бұзылу. Инициализация бағдарламасы Destroy белсендірілді.
Dialogue: 0,0:11:11.65,0:11:13.65,Default,,0,0,0,,Бұл болашақтан келген кісі өлтіруші робот па?
Dialogue: 0,0:11:13.65,0:11:15.85,Default,,0,0,0,,Қарсылас қандай болса да мен жеңілмеймін
Dialogue: 0,0:11:24.46,0:11:29.97,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:11:29.97,0:11:32.66,Default,,0,0,0,,Мен біраз уақыттан кейін бірінші рет боулингке барғым келді.
Dialogue: 0,0:11:32.66,0:11:35.96,Default,,0,0,0,,Қарсылас анықталды, өшіру.
Dialogue: 0,0:11:42.48,0:11:45.88,Default,,0,0,0,,Найзағайдан барлық дәуірлерде қорқу керек.
Dialogue: 0,0:11:52.31,0:11:54.96,Default,,0,0,0,,[Радио] Араны ғимаратқа соқпау үшін бағыттаңыз.
Dialogue: 0,0:11:54.96,0:11:57.46,Default,,0,0,0,,Бұл тамаша стратегия.
Dialogue: 0,0:12:01.64,0:12:04.82,Default,,0,0,0,,Неге түзете алмайсың! Бәрі қорқынышты!
Dialogue: 0,0:12:04.82,0:12:07.97,Default,,0,0,0,,Шыдамсыз болма, Тони. (соққы дыбысы)
Dialogue: 0,0:12:07.97,0:12:11.48,Default,,0,0,0,,Старк мырза, камераның еденінде қаскүнем бар.
Dialogue: 0,0:12:11.48,0:12:14.48,Default,,0,0,0,,Оны маған қалдырыңыз, сіз сауытты жөндейсіз.
Dialogue: 0,0:12:18.45,0:12:20.47,Default,,0,0,0,,ﾚｯﾄﾞ･ｽｶﾙ…
Dialogue: 0,0:12:20.47,0:12:23.37,Default,,0,0,0,,Кек алушылар Бұл төтенше жағдай! Апыр-ай!
Dialogue: 0,0:13:28.39,0:13:32.79,Default,,0,0,0,,(Динозавр дыбысы)
Dialogue: 0,0:13:32.79,0:13:34.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:34.79,0:13:36.96,Default,,0,0,0,,ｽﾀｰｸ
Dialogue: 0,0:13:36.96,0:13:41.13,Default,,0,0,0,,Тас менікі
Dialogue: 0,0:13:41.13,0:13:44.49,Default,,0,0,0,,Ол осында келе жатыр. Джарвис, лифтті өшір.
Dialogue: 0,0:13:44.49,0:13:47.66,Default,,0,0,0,,Бұрынғы зақымға байланысты қорғаныс жүйесі жұмыс істемейді.
Dialogue: 0,0:13:47.66,0:13:50.86,Default,,0,0,0,,Мен сені жақсартуым керек еді.
Dialogue: 0,0:13:55.50,0:13:58.20,Default,,0,0,0,,Олардың саны тым көп. Шабуыл әдісін өзгертіңіз.
Dialogue: 0,0:14:01.89,0:14:04.19,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:14:06.64,0:14:08.66,Default,,0,0,0,,Бұл менің боулингім
Dialogue: 0,0:14:08.66,0:14:12.03,Default,,0,0,0,,Динозаврлар мен роботтармен боулинг? Сіз қаланы жоюды жоспарлап отырсыз ба?
Dialogue: 0,0:14:12.03,0:14:14.03,Default,,0,0,0,,Бұл қызықсыз.
Dialogue: 0,0:14:18.14,0:14:24.46,Default,,0,0,0,,ｽﾀｰｸ ﾀｲﾑ･ｽﾄｰﾝ
Dialogue: 0,0:14:24.46,0:14:27.48,Default,,0,0,0,,Уау! Сыра шарлары?
Dialogue: 0,0:14:27.48,0:14:30.38,Default,,0,0,0,,Өйткені мен алға қарап жүрмеймін.
Dialogue: 0,0:14:46.07,0:14:49.97,Default,,0,0,0,,Тұйыққа тірелді, амал жоқ.
Dialogue: 0,0:14:57.73,0:15:00.46,Default,,0,0,0,,Голограмманың айласы.
Dialogue: 0,0:15:00.46,0:15:03.98,Default,,0,0,0,,Тас. Оны неге сонша қалайсың?
Dialogue: 0,0:15:03.98,0:15:08.14,Default,,0,0,0,,Бұл менің көзімнің үстіндегі түйір ғана. Дәлірек айтқанда, бұл менің кеудем.
Dialogue: 0,0:15:08.14,0:15:10.84,Default,,0,0,0,,Беріңіз!
Dialogue: 0,0:15:12.81,0:15:15.91,Default,,0,0,0,,Капитан Америка жаттығулары басталады
Dialogue: 0,0:15:17.96,0:15:19.98,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:15:19.98,0:15:22.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:36.07,0:15:38.27,Default,,0,0,0,,ｽﾀｰｸ
Dialogue: 0,0:15:46.98,0:15:48.98,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:00.97,0:16:04.17,Default,,0,0,0,,Бас сүйекті айналдыру өте қызықты.
Dialogue: 0,0:16:08.15,0:16:10.65,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:16:30.14,0:16:33.31,Default,,0,0,0,,"Кешіріңіз, биыл тағы да сіздің туған күніңізге бара алмадым. Әкемнен."
Dialogue: 0,0:16:33.31,0:16:35.91,Default,,0,0,0,,Бұл затты не үшін сақтадың?
Dialogue: 0,0:16:37.98,0:16:39.98,Default,,0,0,0,,Ой, бұл...
Dialogue: 0,0:16:39.98,0:16:44.97,Default,,0,0,0,,Бірінші қару-жарақ жобасы. Бұл шедевр болды, бірақ нәтиже болмады.
Dialogue: 0,0:16:44.97,0:16:48.42,Default,,0,0,0,,Өйткені доғалық реактор болған жоқ.
Dialogue: 0,0:16:48.42,0:16:50.42,Default,,0,0,0,,(Биллгеснайптың ырылдауы)
Dialogue: 0,0:16:59.05,0:17:01.55,Default,,0,0,0,,Старк!
Dialogue: 0,0:17:16.15,0:17:18.15,Default,,0,0,0,,Тони, сен қайдасың?
Dialogue: 0,0:17:22.00,0:17:24.14,Default,,0,0,0,,Буын не болып жатыр?
Dialogue: 0,0:17:24.14,0:17:28.63,Default,,0,0,0,,Мен көремін. Менен күткендей. Сіз әрқашан данышпан болдыңыз.
Dialogue: 0,0:17:28.63,0:17:31.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:31.31,0:17:33.81,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:37.47,0:17:40.14,Default,,0,0,0,,20 роботта тек 3 көрсеткі бар.
Dialogue: 0,0:17:40.14,0:17:42.14,Default,,0,0,0,,Сіз оны жеңе аласыз, солай ма?
Dialogue: 0,0:17:42.14,0:17:45.81,Default,,0,0,0,,Келесі жолы төбелесіп қалмас үшін біреу шығады деп үміттенемін.
Dialogue: 0,0:17:45.81,0:17:48.41,Default,,0,0,0,,Шынымен бе? Қайтадан ештеңе шықпаса жақсы болар еді.
Dialogue: 0,0:17:51.30,0:17:53.30,Default,,0,0,0,,Менің бүгін жолым болмай тұрған сияқты.
Dialogue: 0,0:17:53.30,0:17:55.30,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:18:04.90,0:18:09.50,Default,,0,0,0,,Жоғалған Hydra жойғыш ұшағы қайта пайда болды. (Халк) Жоғалып кетсе жақсы болар еді.
Dialogue: 0,0:18:21.98,0:18:24.98,Default,,0,0,0,,Мен асгардиялықтардың сенің жеміңе айналуына жол бермеймін.
Dialogue: 0,0:18:36.63,0:18:38.93,Default,,0,0,0,,Сіз қайдасыз?
Dialogue: 0,0:18:42.07,0:18:45.30,Default,,0,0,0,,(шу)
Dialogue: 0,0:18:45.30,0:18:47.80,Default,,0,0,0,,шық, балақай.
Dialogue: 0,0:18:52.21,0:18:56.51,Default,,0,0,0,,Жасырсаң да, мен сені міндетті түрде табамын.
Dialogue: 0,0:19:15.63,0:19:19.66,Default,,0,0,0,,Міне! Маған жақындама!
Dialogue: 0,0:19:19.66,0:19:23.36,Default,,0,0,0,,Сіз ересек адам болып бара жатырсыз, Старк.
Dialogue: 0,0:20:28.32,0:20:32.62,Default,,0,0,0,,Уау! Маған уақыт тасын беріңіз!
Dialogue: 0,0:20:37.82,0:20:40.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:42.81,0:20:46.96,Default,,0,0,0,,ﾊﾊﾊﾊﾊ！
Dialogue: 0,0:20:46.96,0:20:50.63,Default,,0,0,0,,Мен өзімді жас сезінемін, өзімді жақсы сезінемін.
Dialogue: 0,0:20:50.63,0:20:53.98,Default,,0,0,0,,Кек алушылар келе жатыр және сізді жеңеді, сондықтан дайын болыңыз!
Dialogue: 0,0:20:53.98,0:20:59.15,Default,,0,0,0,,Достарыңыз сіз тудырған қиыншылықты басуға тырысуда.
Dialogue: 0,0:20:59.15,0:21:01.51,Default,,0,0,0,,ал біз батырлармыз.
Dialogue: 0,0:21:01.51,0:21:06.21,Default,,0,0,0,,Баланы қорлау - ең жаманы, сен қанша жаман болсаң да.
Dialogue: 0,0:21:12.17,0:21:15.37,Default,,0,0,0,,Конькимен сырғанау басталды! Апыр-ай!
Dialogue: 0,0:21:19.31,0:21:21.81,Default,,0,0,0,,Мен сені әрқашан жұдырықпен ұрғым келген
Dialogue: 0,0:21:24.96,0:21:28.65,Default,,0,0,0,,Өтінемін, жақсы орындаңыз!
Dialogue: 0,0:21:28.65,0:21:31.30,Default,,0,0,0,,Эй, не істеуіміз керек? Адамдар мен қарулар жеткіліксіз
Dialogue: 0,0:21:31.30,0:21:34.64,Default,,0,0,0,,Одан да нашар жағдайлар болды, солай ма? (Сұңқар) Мен есімде жоқ па?
Dialogue: 0,0:21:34.64,0:21:36.66,Default,,0,0,0,,Бұл Тони мен капитанның жоқ екенін білдіреді➡
Dialogue: 0,0:21:36.66,0:21:38.69,Default,,0,0,0,,Өйткені, мен мұны айтуым керек.
Dialogue: 0,0:21:38.69,0:21:43.63,Default,,0,0,0,,Кек алушылар жиналды! Бұл қулық!
Dialogue: 0,0:21:43.63,0:21:47.65,Default,,0,0,0,,Маған уақыт тасын беріңіз!
Dialogue: 0,0:21:47.65,0:21:50.95,Default,,0,0,0,,Мен сенің бойыңда әлі де осындай күш бар екенін білмедім.
Dialogue: 0,0:21:53.06,0:21:54.98,Default,,0,0,0,,Мен қалыпты жағдайға оралдым
Dialogue: 0,0:21:54.98,0:21:57.68,Default,,0,0,0,,Мен енді ешқашан қамауға алынбаймын
Dialogue: 0,0:22:10.66,0:22:13.46,Default,,0,0,0,,Жағдайлар қалпына келеді, бірақ мен сені изоляторға қайта отырғызамын.
Dialogue: 0,0:22:25.79,0:22:27.81,Default,,0,0,0,,Қолдарыңызды алыңыз!
Dialogue: 0,0:22:27.81,0:22:30.46,Default,,0,0,0,,Уақыт тасы менікі!
Dialogue: 0,0:22:30.46,0:22:33.36,Default,,0,0,0,,Бұл туралы не деуге болады? Қазір!
Dialogue: 0,0:22:42.14,0:22:44.94,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:22:48.65,0:22:50.95,Default,,0,0,0,,ﾊﾊﾊﾊ！
Dialogue: 0,0:22:55.64,0:22:58.64,Default,,0,0,0,,Қараңдар, мен Темір баламын!
Dialogue: 0,0:23:00.81,0:23:02.81,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:23:09.15,0:23:11.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:14.01,0:23:17.51,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:23:19.58,0:23:21.48,Default,,0,0,0,,Тони, жақсысың ба?
Dialogue: 0,0:23:21.48,0:23:25.88,Default,,0,0,0,,Мен данышпанмын! О... маған тұруға рұқсат бере аласыз ба?
Dialogue: 0,0:23:28.65,0:23:31.31,Default,,0,0,0,,Мен мұны басқара алмаймын.
Dialogue: 0,0:23:31.31,0:23:34.31,Default,,0,0,0,,Концентрат. Сіз тастың әсерін тоқтата аласыз.
Dialogue: 0,0:23:34.31,0:23:38.31,Default,,0,0,0,,Бірақ мен сәтсіздікке ұшырасам ше? Мен жай жоғалып кетуім мүмкін
Dialogue: 0,0:23:38.31,0:23:40.48,Default,,0,0,0,,Егер біз ғаламды жойсақ ше?
Dialogue: 0,0:23:40.48,0:23:44.47,Default,,0,0,0,,Капитан Бұл өте қорқынышты. Қорқатын ештеңе жоқ.
Dialogue: 0,0:23:44.47,0:23:48.64,Default,,0,0,0,,Капитан түсінбейді. Сіз батыл супер қаһармансыз.
Dialogue: 0,0:23:48.64,0:23:51.14,Default,,0,0,0,,Мен капитан Америка болғанға дейін батыл болдым.
Dialogue: 0,0:23:51.14,0:23:54.94,Default,,0,0,0,,Тони Старк Темір адам болғанға дейін де қаһарман болған.
Dialogue: 0,0:24:17.14,0:24:20.14,Default,,0,0,0,,Соңғысы, бұл мен ешқашан пайдаланбаған көрсеткі.
Dialogue: 0,0:24:20.14,0:24:22.94,Default,,0,0,0,,Бұл әлі де прототип. Ендеше неге байқап көрмеске?
Dialogue: 0,0:24:37.81,0:24:42.48,Default,,0,0,0,,Ой, бәрі жоғалып кетті. Бұл ең жақсысы болды.
Dialogue: 0,0:24:42.48,0:24:47.47,Default,,0,0,0,,Уақыт тасы жабылды. Бұл мәселені шешеді.
Dialogue: 0,0:24:47.47,0:24:50.47,Default,,0,0,0,,Мұны Тони жасады ма?
Dialogue: 0,0:24:50.47,0:24:52.99,Default,,0,0,0,,Дегенмен, бұл үлкен шабуыл болды.
Dialogue: 0,0:24:52.99,0:24:54.99,Default,,0,0,0,,Міне!
Dialogue: 0,0:24:57.66,0:25:01.46,Default,,0,0,0,,Сіз мұны 8 жасыңызда жасадыңыз ба? Мен де ескі жазбаларымды қарап шығамын.
Dialogue: 0,0:25:03.47,0:25:05.48,Default,,0,0,0,,Бір шексіздік тасын жинаңыз
Dialogue: 0,0:25:05.48,0:25:07.62,Default,,0,0,0,,Егер ол Таностың қолына түссе, қорқынышты болар еді.
Dialogue: 0,0:25:07.62,0:25:10.66,Default,,0,0,0,,Мені бастауыш мектепке қайта жібермес еді.
Dialogue: 0,0:25:10.66,0:25:14.33,Default,,0,0,0,,Биллис Снайп атриумда, неге?
Dialogue: 0,0:25:14.33,0:25:16.63,Default,,0,0,0,,Мені бөлмемнен шығаруға кім рұқсат етті?
Dialogue: 0,0:25:24.64,0:25:28.31,Default,,0,0,0,,Джарвис жаттығуының үзілуі
Dialogue: 0,0:25:28.31,0:25:31.79,Default,,0,0,0,,Мен интуитивті бейнелі есте сақтау қабілетім болса, мен ештеңені ұмытпаймын деп ойладым.
Dialogue: 0,0:25:31.79,0:25:34.71,Default,,0,0,0,,Тони Старк та ұмытшақ болды ма?
Dialogue: 0,0:25:34.71,0:25:36.97,Default,,0,0,0,,Тіпті балалар да күшті бола алады
Dialogue: 0,0:25:36.97,0:25:39.99,Default,,0,0,0,,Өзіңіз айтқандай, өткеннен сабақ аламыз.
Dialogue: 0,0:25:39.99,0:25:42.97,Default,,0,0,0,,Мысалы, батыр болу деген нені білдіреді?
Dialogue: 0,0:25:42.97,0:25:45.62,Default,,0,0,0,,Суреттегі қалқан қолдан жасалған.
Dialogue: 0,0:25:45.62,0:25:49.65,Default,,0,0,0,,Содан кейін нақты нәрсені пайдаланып көріңіз.
Dialogue: 0,0:25:49.65,0:25:55.13,Default,,0,0,0,,Мен оны заманауи ету үшін өзгерте аламын ба?
Dialogue: 0,0:25:55.13,0:26:00.33,Default,,0,0,0,,Бұл жай ғана әзіл. Әзірге жаттығуды жалғастырыңыз.
Dialogue: 0,0:26:35.31,0:26:37.31,Default,,0,0,0,,<“Кек алушылар жиналуда”➡ пайда болады
Dialogue: 0,0:26:37.31,0:26:39.29,Default,,0,0,0,,Супер қаһармандар, жауыздар және т.б. туралы ақпарат➡
Dialogue: 0,0:26:39.29,0:26:41.48,Default,,0,0,0,,Осы жерде жинаңыз
Dialogue: 0,0:26:41.48,0:26:44.13,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:44.13,0:26:46.47,Default,,0,0,0,,Құдіреті зор алты асыл тас
Dialogue: 0,0:26:46.47,0:26:49.14,Default,,0,0,0,,Жан қуаты кеңістігі➡
Dialogue: 0,0:26:49.14,0:26:53.31,Default,,0,0,0,,Шындықтың, уақыт пен рухтың барлық тастары➡
Dialogue: 0,0:26:53.31,0:26:56.81,Default,,0,0,0,,Қолғап киген адам Infinity Gauntlet➡ деп аталады
Dialogue: 0,0:26:56.81,0:27:00.31,Default,,0,0,0,,Бүкіл ғаламды басқара алады дейді>
Dialogue: 0,0:27:01.81,0:27:07.81,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
