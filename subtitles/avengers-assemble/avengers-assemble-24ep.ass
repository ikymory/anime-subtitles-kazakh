Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:38.48,0:00:40.78,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:44.85,0:00:46.88,Default,,0,0,0,,<Кек алушылар, яғни➡
Dialogue: 0,0:00:46.88,0:00:48.90,Default,,0,0,0,,Супер қаһармандар жиналды➡
Dialogue: 0,0:00:48.90,0:00:51.16,Default,,0,0,0,,Ең күшті батырлар командасы
Dialogue: 0,0:00:51.16,0:00:54.51,Default,,0,0,0,,Өзіңіздің керемет күшіңізді жинаңыз және жердің тыныштығын қорғаңыз! ＞
Dialogue: 0,0:00:54.51,0:00:56.83,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:56.83,0:00:58.81,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:58.81,0:01:01.00,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:01.00,0:01:02.98,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:02.98,0:01:04.99,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:04.99,0:01:06.99,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:08.99,0:01:11.84,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:11.84,0:01:14.68,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:14.68,0:01:16.71,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:16.71,0:01:18.73,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:18.73,0:01:20.73,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:25.84,0:01:29.16,Default,,0,0,0,,Үлкен түрмеде бір ғана тұтқын бар ма?
Dialogue: 0,0:01:29.16,0:01:32.51,Default,,0,0,0,,Сіз жұлдызды жарып жібердім дейсіз бе?
Dialogue: 0,0:01:32.51,0:01:34.81,Default,,0,0,0,,Жарылған 13 планета
Dialogue: 0,0:01:38.67,0:01:40.67,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:01:40.67,0:01:47.24,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:47.24,0:01:50.78,Default,,0,0,0,,Ерік-жігері әлсіз адамды оның сақшысы ету➡
Dialogue: 0,0:01:50.78,0:01:53.18,Default,,0,0,0,,Бұл мүлдем ақымақтық.
Dialogue: 0,0:01:53.18,0:02:00.51,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:00.51,0:02:03.18,Default,,0,0,0,,(енеді)
Dialogue: 0,0:02:03.18,0:02:06.38,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:02:10.17,0:02:13.00,Default,,0,0,0,,Корвус қабірі. (Корвус) Дереу тазалаңыз.
Dialogue: 0,0:02:13.00,0:02:15.19,Default,,0,0,0,,ｽｰﾊﾟｰ･ｼﾞｬｲｱﾝﾄ
Dialogue: 0,0:02:15.19,0:02:22.51,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:22.51,0:02:25.88,Default,,0,0,0,,Тезірек жүріңіз, қожайынымыздың мінезі қысқа.
Dialogue: 0,0:02:25.88,0:02:31.34,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:31.34,0:02:33.67,Default,,0,0,0,,Жақындау мүмкін емес
Dialogue: 0,0:02:33.67,0:02:36.86,Default,,0,0,0,,Қозғалыс анықталған, ұяшық жойылған.
Dialogue: 0,0:02:36.86,0:02:41.01,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:41.01,0:02:43.00,Default,,0,0,0,,ﾌﾞﾗｯｸ･ﾄﾞﾜｰﾌ
Dialogue: 0,0:02:43.00,0:02:45.00,Default,,0,0,0,,Уф... уау!
Dialogue: 0,0:02:45.00,0:02:47.50,Default,,0,0,0,,(енеді)
Dialogue: 0,0:02:47.50,0:03:28.83,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:28.83,0:03:31.68,Default,,0,0,0,,Ebony пәрмендерін ашыңыз
Dialogue: 0,0:03:31.68,0:03:35.52,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:35.52,0:03:38.02,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:03:38.02,0:03:40.01,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:03:40.01,0:03:45.01,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:45.01,0:03:48.17,Default,,0,0,0,,Бұл өте әдемі. (Ианман) А, шынымен
Dialogue: 0,0:03:48.17,0:03:51.05,Default,,0,0,0,,Жер сіздің артыңызда екенін білесіз бе?
Dialogue: 0,0:03:51.05,0:03:55.17,Default,,0,0,0,,Бірақ болашақ біздің көз алдымызда ашылып жатыр. Антман!
Dialogue: 0,0:03:55.17,0:03:57.67,Default,,0,0,0,,DAN бастауға бола ма?
Dialogue: 0,0:03:57.67,0:04:00.53,Default,,0,0,0,,DAN？ ﾃﾞｰﾀ･ｱﾅﾘｼｽ･ﾈｯﾄﾜｰｸ
Dialogue: 0,0:04:00.53,0:04:03.13,Default,,0,0,0,,Бұл біздің жаңа шекарамыз, оны белсендірейік.
Dialogue: 0,0:04:05.17,0:04:07.68,Default,,0,0,0,,DAN – ең соңғы технологиямен жабдықталған спутник
Dialogue: 0,0:04:07.68,0:04:10.57,Default,,0,0,0,,Алыстағы ғаламды бақылай алады
Dialogue: 0,0:04:10.57,0:04:14.52,Default,,0,0,0,,Бірақ Тони, бізге Галактика деңгейіне дейін кеңейту керек пе?
Dialogue: 0,0:04:14.52,0:04:17.19,Default,,0,0,0,,Кек алушылар кез келген нәрсені шеше алады
Dialogue: 0,0:04:17.19,0:04:20.35,Default,,0,0,0,,Артқы айна емес, алдыңғы әйнектің арғы жағына қараңыз.
Dialogue: 0,0:04:20.35,0:04:23.55,Default,,0,0,0,,Бөтен ғарыш кемесі соншалықты жақын болуы мүмкін.
Dialogue: 0,0:04:25.85,0:04:29.19,Default,,0,0,0,,Уау... (Сонымен) Хеймдал ма?
Dialogue: 0,0:04:29.19,0:04:31.19,Default,,0,0,0,,Уау! Сонымен!
Dialogue: 0,0:05:53.52,0:05:58.48,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:58.48,0:06:00.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:00.51,0:06:03.15,Default,,0,0,0,,Бөтен планетаның ұшып кеткенінен кейін үндемейсің бе?
Dialogue: 0,0:06:03.15,0:06:05.17,Default,,0,0,0,,Әрине, мен оны қайтарамын!
Dialogue: 0,0:06:05.17,0:06:09.64,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:09.64,0:06:13.16,Default,,0,0,0,,Сіздің байланысыңыз белгісіз бе? Сіз жаңа аймақтан келген қонақсыз ба?
Dialogue: 0,0:06:13.16,0:06:15.48,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:06:15.48,0:06:18.83,Default,,0,0,0,,Халк Бұл вакуумдық кеңістік.
Dialogue: 0,0:06:18.83,0:06:21.53,Default,,0,0,0,,Бірден ұруды тоқтатқан дұрыс.
Dialogue: 0,0:06:24.91,0:06:27.52,Default,,0,0,0,,Мен тек мейірімді адам деп үміттенемін.
Dialogue: 0,0:06:27.52,0:06:39.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:39.84,0:06:43.32,Default,,0,0,0,,Сақ болыңыз, қандай жаумен бетпе-бет келетініңізді білмейсіз.
Dialogue: 0,0:06:43.32,0:06:47.24,Default,,0,0,0,,Аты аңызға айналған Кек алушыларды кездестірдік
Dialogue: 0,0:06:47.24,0:06:49.18,Default,,0,0,0,,Мен тапсырманы орындай алмаймын деп қорықтым➡
Dialogue: 0,0:06:49.18,0:06:51.88,Default,,0,0,0,,Жарық жылдарын аралауға тұрарлық болды.
Dialogue: 0,0:06:54.03,0:06:57.64,Default,,0,0,0,,Бұл жау қаңбақпен шабуыл жасайтын сияқты, капитан.
Dialogue: 0,0:06:57.64,0:07:00.66,Default,,0,0,0,,Хмм, мен құшақтауды жек көремін.
Dialogue: 0,0:07:00.66,0:07:03.49,Default,,0,0,0,,Бұл біздің планетамызды құтқарады
Dialogue: 0,0:07:03.49,0:07:06.65,Default,,0,0,0,,Осындай алыс планетада Кек алушылар туралы қауесеттер бар ма?
Dialogue: 0,0:07:06.65,0:07:09.98,Default,,0,0,0,,Олар бізге білмей-ақ Таносты жеңді.
Dialogue: 0,0:07:09.98,0:07:12.65,Default,,0,0,0,,Сондай-ақ Space Phantom және Galactus➡ күреседі
Dialogue: 0,0:07:12.65,0:07:15.66,Default,,0,0,0,,Шексіздік тасын алған кезде
Dialogue: 0,0:07:15.66,0:07:18.14,Default,,0,0,0,,Кейбіреулер әсірелеуі мүмкін...
Dialogue: 0,0:07:18.14,0:07:20.18,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:07:20.18,0:07:22.71,Default,,0,0,0,,Сіз кімсіз? Жаңа стажер?
Dialogue: 0,0:07:22.71,0:07:25.65,Default,,0,0,0,,Ахаха... Жоқ, мен Хокимін
Dialogue: 0,0:07:25.65,0:07:28.14,Default,,0,0,0,,Мен басынан бері мүшемін.
Dialogue: 0,0:07:28.14,0:07:31.54,Default,,0,0,0,,Hawkeye? Мен бұл туралы ешқашан естіген емеспін ...
Dialogue: 0,0:07:31.54,0:07:34.32,Default,,0,0,0,,Бірақ егер сіз ұлы Сұңқар➡ астында жаттығып жатсаңыз
Dialogue: 0,0:07:34.32,0:07:36.34,Default,,0,0,0,,Мен сенің жақсы жауынгер болатыныңа сенімдімін.
Dialogue: 0,0:07:36.34,0:07:39.33,Default,,0,0,0,,Уау, маған бұл жігіт ұнады.
Dialogue: 0,0:07:39.33,0:07:42.35,Default,,0,0,0,,Менің туған қалам Жаңа Корбинге шабуыл жасалды➡
Dialogue: 0,0:07:42.35,0:07:46.50,Default,,0,0,0,,Басқыншылар қаланы қиратуда. Өтінемін көмектесіңізші.
Dialogue: 0,0:07:46.50,0:07:48.51,Default,,0,0,0,,Бұл жаңа шекара, капитан.
Dialogue: 0,0:07:48.51,0:07:51.66,Default,,0,0,0,,Біз әрекет етуіміз керек, бірақ жер қорғаныссыз қалады.
Dialogue: 0,0:07:51.66,0:07:54.66,Default,,0,0,0,,Уайымдама, мұны бізге қалдыр.
Dialogue: 0,0:07:54.66,0:07:57.18,Default,,0,0,0,,Біз жер бетіндегі ең мықты батырлармыз.
Dialogue: 0,0:07:57.18,0:08:00.62,Default,,0,0,0,,Әлемдегі ең күшті болуды мақсат ету дұрыс емес пе?
Dialogue: 0,0:08:00.62,0:08:02.69,Default,,0,0,0,,Жаңа Корбиннің атмосферасы бар➡
Dialogue: 0,0:08:02.69,0:08:06.21,Default,,0,0,0,,Құрамында белгісіз ингредиенттер бар. Қауіпті болуы мүмкін.
Dialogue: 0,0:08:06.21,0:08:08.23,Default,,0,0,0,,Көңілім толқымай тұра алмаймын.
Dialogue: 0,0:08:08.23,0:08:12.66,Default,,0,0,0,,Экваторда жиналатын энергияға қараңызшы, соншалықты бөлінетін мөлшерді өлшеу мүмкін емес.
Dialogue: 0,0:08:12.66,0:08:15.17,Default,,0,0,0,,Мен мазасызданамын
Dialogue: 0,0:08:15.17,0:08:18.54,Default,,0,0,0,,Дайындықсыз шайқасқа бару тым қауіпті стратегия.
Dialogue: 0,0:08:18.54,0:08:21.15,Default,,0,0,0,,Баки екеуміз Red Skull төбелескен кезде➡
Dialogue: 0,0:08:21.15,0:08:23.51,Default,,0,0,0,,Олар өздерін алдады.
Dialogue: 0,0:08:23.51,0:08:27.84,Default,,0,0,0,,Күрсін... Анау-мынау қағып, баяғы...
Dialogue: 0,0:08:27.84,0:08:29.84,Default,,0,0,0,,Маған бұл ойын ұнамайды.
Dialogue: 0,0:08:31.98,0:08:36.15,Default,,0,0,0,,Егер сіз шектеуге тап болсаңыз, әдеттегідей әрекет етіңіз.
Dialogue: 0,0:08:36.15,0:08:39.82,Default,,0,0,0,,Одан әрі шектеулерге қарсы тұрайық
Dialogue: 0,0:08:39.82,0:08:43.49,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:08:43.49,0:08:55.16,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:55.16,0:08:59.83,Default,,0,0,0,,Айтайын, менің сүйкімді үй жануарым бар.
Dialogue: 0,0:08:59.83,0:09:02.48,Default,,0,0,0,,ｷｬﾌﾟﾃﾝ･ｱﾏﾗｲｶ
Dialogue: 0,0:09:02.48,0:09:05.48,Default,,0,0,0,,Сіз мені танымайтыныңызға сенімдісіз бе?
Dialogue: 0,0:09:05.48,0:09:08.49,Default,,0,0,0,,Шетелдіктерді жойыңыз!
Dialogue: 0,0:09:08.49,0:09:10.50,Default,,0,0,0,,Жүр сені үйге апарайық
Dialogue: 0,0:09:10.50,0:09:15.64,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:15.64,0:09:17.84,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:09:19.81,0:09:21.83,Default,,0,0,0,,Сіз біреуді іздеп жүрсіз бе?
Dialogue: 0,0:09:21.83,0:09:27.30,Default,,0,0,0,,Мен Кек алушылар ертегі кейіпкерлері деп ойладым. Олар шын ба?
Dialogue: 0,0:09:27.30,0:09:29.34,Default,,0,0,0,,Солай сияқты.
Dialogue: 0,0:09:29.34,0:09:38.50,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:38.50,0:09:40.50,Default,,0,0,0,,ｲｪｰｲ！
Dialogue: 0,0:09:42.50,0:09:46.51,Default,,0,0,0,,Эй, мұнда не болып жатыр? Жебе жіберіп алды.
Dialogue: 0,0:09:46.51,0:09:49.11,Default,,0,0,0,,Гравитация Жерден күшті, біз оны реттеуіміз керек.
Dialogue: 0,0:09:51.54,0:09:53.54,Default,,0,0,0,,Мен реттедім
Dialogue: 0,0:09:56.48,0:09:58.48,Default,,0,0,0,,Біртүрлі жер екен.
Dialogue: 0,0:10:04.16,0:10:07.83,Default,,0,0,0,,Қожайынымызды мазалайтындай біз кімбіз?
Dialogue: 0,0:10:07.83,0:10:10.83,Default,,0,0,0,,Мастер? Бұл бастық бар дегенді білдіре ме?
Dialogue: 0,0:10:12.82,0:10:15.49,Default,,0,0,0,,Сіз Жердегі ең күшті кек алушыларды білмейсіз бе?
Dialogue: 0,0:10:15.49,0:10:17.82,Default,,0,0,0,,Шамасы, бұл аңызға айналған тіршілік.
Dialogue: 0,0:10:17.82,0:10:20.16,Default,,0,0,0,,Мен Жер туралы естідім→
Dialogue: 0,0:10:20.16,0:10:24.51,Default,,0,0,0,,Proxima Midnight сіз туралы білмейді. Бұл шабуыл.
Dialogue: 0,0:10:24.51,0:10:26.55,Default,,0,0,0,,Уф! Ах... аа...
Dialogue: 0,0:10:26.55,0:10:29.82,Default,,0,0,0,,Маған сізге майорнияны үйретуге рұқсат етіңіз. Хмф!
Dialogue: 0,0:10:29.82,0:10:33.47,Default,,0,0,0,,Сол деңгейде оның жер бетіндегі ең күштісі екені мені күлдіреді.
Dialogue: 0,0:10:33.47,0:10:35.49,Default,,0,0,0,,Хамф!
Dialogue: 0,0:10:35.49,0:10:37.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:37.49,0:10:40.18,Default,,0,0,0,,Сұңқар. Бұрын анықталған энергияның үлкен мөлшері →
Dialogue: 0,0:10:40.18,0:10:43.16,Default,,0,0,0,,Сол пирамидадан шығу. Сол сүйкімді әйел →
Dialogue: 0,0:10:43.16,0:10:45.82,Default,,0,0,0,,Міне, сондықтан да келген шығарсың.
Dialogue: 0,0:10:45.82,0:10:47.82,Default,,0,0,0,,Мен оны қарастырамын.
Dialogue: 0,0:10:47.82,0:10:50.82,Default,,0,0,0,,Көңілді жүрсің бе? Тони
Dialogue: 0,0:10:50.82,0:10:54.82,Default,,0,0,0,,Қауіпсіз аймақтан шығу жақсы. Кек алушылар күшейе түседі.
Dialogue: 0,0:10:54.82,0:10:57.83,Default,,0,0,0,,Егер бұл рас болса, мен ең күшті бола алар едім.
Dialogue: 0,0:10:57.83,0:11:00.88,Default,,0,0,0,,Энергия жұлдыздың ортасынан шығады
Dialogue: 0,0:11:00.88,0:11:03.58,Default,,0,0,0,,Ол Galactus-тан әлдеқайда үлкен.
Dialogue: 0,0:11:09.49,0:11:11.52,Default,,0,0,0,,ｻﾉｽ…
Dialogue: 0,0:11:11.52,0:11:14.58,Default,,0,0,0,,Хахахахаха... хахахахаха...
Dialogue: 0,0:11:14.58,0:11:16.58,Default,,0,0,0,,Уау!!
Dialogue: 0,0:12:18.56,0:12:20.48,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:12:20.48,0:12:22.83,Default,,0,0,0,,Уау!!
Dialogue: 0,0:12:22.83,0:12:25.85,Default,,0,0,0,,Аяз дәу әлдеқайда көрікті.
Dialogue: 0,0:12:25.85,0:12:28.17,Default,,0,0,0,,Уау! Falcon!
Dialogue: 0,0:12:28.17,0:12:30.87,Default,,0,0,0,,Уау! Жолдан кет!!
Dialogue: 0,0:12:32.82,0:12:34.82,Default,,0,0,0,,Хмф! Уф...
Dialogue: 0,0:12:36.83,0:12:41.23,Default,,0,0,0,,Мұндағы ортаға байланысты құлағым өзгерген сияқты.
Dialogue: 0,0:12:41.23,0:12:44.17,Default,,0,0,0,,Мен Сұңқар Санос деді деп ойладым.
Dialogue: 0,0:12:44.17,0:12:46.17,Default,,0,0,0,,деді
Dialogue: 0,0:12:46.17,0:12:48.57,Default,,0,0,0,,Танос поляризацияланған бөлшектерді сорып, сіңіреді.
Dialogue: 0,0:12:51.16,0:12:53.58,Default,,0,0,0,,Хамф!
Dialogue: 0,0:12:53.58,0:12:56.48,Default,,0,0,0,,Күткендей, менің қорқынышым дұрыс болды.
Dialogue: 0,0:12:56.48,0:12:58.83,Default,,0,0,0,,Бұл Таностың шайқасы болды.
Dialogue: 0,0:12:58.83,0:13:02.87,Default,,0,0,0,,Жарайды, мен мойындаймын. Бұл мен ойлағаннан да қиынырақ сияқты.
Dialogue: 0,0:13:02.87,0:13:04.87,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:13:06.92,0:13:09.16,Default,,0,0,0,,Дірілдеген адамдар
Dialogue: 0,0:13:09.16,0:13:12.53,Default,,0,0,0,,Жақында ғалам біздің қожайынымыздың алдында тізерлейді.
Dialogue: 0,0:13:12.53,0:13:14.53,Default,,0,0,0,,Сіз бірдеңе айтып тұрсыз
Dialogue: 0,0:13:16.60,0:13:18.49,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:18.49,0:13:20.49,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:20.49,0:13:23.17,Default,,0,0,0,,Уау... Уау...
Dialogue: 0,0:13:23.17,0:13:28.04,Default,,0,0,0,,Белгісіз елдегі шайқас күтпеген жайттарға толы.
Dialogue: 0,0:13:28.04,0:13:31.98,Default,,0,0,0,,Танос бәрін сорып алмас бұрын пирамида туралы бірдеңе жасап көрейік.
Dialogue: 0,0:13:31.98,0:13:35.17,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:13:35.17,0:13:37.49,Default,,0,0,0,,Ха! Пирамидаларды қирату...
Dialogue: 0,0:13:37.49,0:13:39.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:51.84,0:13:55.22,Default,,0,0,0,,Бұл таңқаларлық. Проксима циркті әкелді.
Dialogue: 0,0:13:55.22,0:13:58.83,Default,,0,0,0,,Қара қара ағаш Бұл адам не туралы айтып тұр?
Dialogue: 0,0:13:58.83,0:14:02.16,Default,,0,0,0,,Жерде біз заттарды осылай айтамыз →
Dialogue: 0,0:14:02.16,0:14:04.50,Default,,0,0,0,,Оны әзіл деп айту
Dialogue: 0,0:14:04.50,0:14:08.82,Default,,0,0,0,,Мен көремін. Нағыз қауіп жақындағанда қорқақ адамдар→
Dialogue: 0,0:14:08.82,0:14:12.49,Default,,0,0,0,,Қорқынышты әзілмен жабуға тырысу
Dialogue: 0,0:14:12.49,0:14:16.16,Default,,0,0,0,,Естеріңізге сала кетейік. Корвус Грей
Dialogue: 0,0:14:16.16,0:14:18.14,Default,,0,0,0,,Жаса!
Dialogue: 0,0:14:18.14,0:14:20.84,Default,,0,0,0,,Уф! Ахх...
Dialogue: 0,0:14:22.82,0:14:25.49,Default,,0,0,0,,Біз қара тапсырыстардың таңдаулы тобымыз.
Dialogue: 0,0:14:25.49,0:14:29.49,Default,,0,0,0,,Танос-самаға қызмет ету. Сен үшін бітті.
Dialogue: 0,0:14:29.49,0:14:33.48,Default,,0,0,0,,Менмендік диктаторлар?
Dialogue: 0,0:14:33.48,0:14:35.50,Default,,0,0,0,,Уау!!
Dialogue: 0,0:14:35.50,0:14:38.82,Default,,0,0,0,,Өйткені, бұл жаңалық емес еді.
Dialogue: 0,0:14:38.82,0:14:40.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:45.97,0:14:47.99,Default,,0,0,0,,(Дарио) Хе-хе-хе-хе. Эй, қарашы — бұл апат!
Dialogue: 0,0:14:47.99,0:14:51.83,Default,,0,0,0,,Уф! Апыр-ай! Ах...
Dialogue: 0,0:14:51.83,0:14:54.50,Default,,0,0,0,,Таносқа даңқ!
Dialogue: 0,0:14:54.50,0:14:58.48,Default,,0,0,0,,Тони жаңа аумаққа ұмтылып, өз шегіне қарсы тұра ма?
Dialogue: 0,0:14:58.48,0:15:00.82,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:00.82,0:15:03.82,Default,,0,0,0,,Мен интеллектті сіңіре аламын
Dialogue: 0,0:15:03.82,0:15:06.21,Default,,0,0,0,,Мен көп нәрсені сіңіргім келді →
Dialogue: 0,0:15:06.21,0:15:09.83,Default,,0,0,0,,Қалай қарасаң да, жеңіл тамақтан артық емессің.
Dialogue: 0,0:15:09.83,0:15:15.53,Default,,0,0,0,,Ей, бұл планетада мені қорлау енді жоқ... аа...
Dialogue: 0,0:15:17.50,0:15:19.49,Default,,0,0,0,,Хамф!
Dialogue: 0,0:15:19.49,0:15:21.49,Default,,0,0,0,,ﾎｰｸｱｲ！
Dialogue: 0,0:15:24.48,0:15:28.83,Default,,0,0,0,,Жаулар телепатияны пайдаланады. Олардың басқа да ерекше қабілеттері болуы мүмкін.
Dialogue: 0,0:15:28.83,0:15:31.83,Default,,0,0,0,,Бұл сізді алаңдату керек жалғыз қабілет.
Dialogue: 0,0:15:31.83,0:15:34.83,Default,,0,0,0,,Ха! Апыр-ай! Уф...
Dialogue: 0,0:15:39.81,0:15:42.83,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ？
Dialogue: 0,0:15:42.83,0:15:46.48,Default,,0,0,0,,...
Dialogue: 0,0:15:46.48,0:15:48.82,Default,,0,0,0,,Күресудің қажеті жоқ
Dialogue: 0,0:15:48.82,0:15:51.15,Default,,0,0,0,,Қара орден ешқашан жеңілген емес.
Dialogue: 0,0:15:51.15,0:15:53.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:53.17,0:15:55.21,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:15:55.21,0:15:58.24,Default,,0,0,0,,Себебі мен ешқашан кек алушылармен шайқасқан емеспін!
Dialogue: 0,0:15:58.24,0:16:01.16,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:16:01.16,0:16:05.15,Default,,0,0,0,,Хахахахаха...
Dialogue: 0,0:16:05.15,0:16:08.15,Default,,0,0,0,,Сұңқар! Сіз бұл жұлдыздың тартылыс күші күшті деп айтпадыңыз ба?
Dialogue: 0,0:16:08.15,0:16:10.82,Default,,0,0,0,,Ah, шамамен 0,2G күшті
Dialogue: 0,0:16:10.82,0:16:13.83,Default,,0,0,0,,Бұл жеткілікті деп үміттенемін...
Dialogue: 0,0:16:13.83,0:16:16.81,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:16.81,0:16:18.83,Default,,0,0,0,,Уф! Уау...
Dialogue: 0,0:16:18.83,0:16:22.15,Default,,0,0,0,,Тони айтқандай, біз қауіпсіз аймақтан шығуымыз керек еді.
Dialogue: 0,0:16:22.15,0:16:24.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:24.15,0:16:26.49,Default,,0,0,0,,Тек осы жұлдыздың сипаттамаларын жақсы пайдаланыңыз.
Dialogue: 0,0:16:26.49,0:16:28.54,Default,,0,0,0,,Ауырлық күші күшті ғана емес
Dialogue: 0,0:16:28.54,0:16:31.16,Default,,0,0,0,,Атмосферада кристалдарға ұқсайтын бөлшектер араласады.
Dialogue: 0,0:16:31.16,0:16:34.85,Default,,0,0,0,,Кристалл? Маған деректерді жіберіңіз. Менде бір идея бар...
Dialogue: 0,0:16:34.85,0:16:39.85,Default,,0,0,0,,Егер сіз сауытыңызды реттесеңіз, кристалдар арқылы Repulsor-ды қуаттай аласыз.
Dialogue: 0,0:16:41.84,0:16:43.84,Default,,0,0,0,,Хмф!
Dialogue: 0,0:16:43.84,0:16:47.14,Default,,0,0,0,,Уау! Ғылымға рахмет
Dialogue: 0,0:16:50.16,0:16:52.18,Default,,0,0,0,,ｷｬｰｯ!!
Dialogue: 0,0:16:52.18,0:16:54.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:54.17,0:16:57.82,Default,,0,0,0,,Менің басымның ішіне кіруге рұқсат етілген жалғыз адам - мен.
Dialogue: 0,0:16:57.82,0:17:00.51,Default,,0,0,0,,ｷｬｰｯ！
Dialogue: 0,0:17:00.51,0:17:03.51,Default,,0,0,0,,Мұз көрсеткі мен күткеннен де жақсы көрінеді.
Dialogue: 0,0:17:03.51,0:17:07.11,Default,,0,0,0,,Атмосферадағы бөлшектер мұзға жабысып қалды деп ойлаймын.
Dialogue: 0,0:17:15.15,0:17:18.17,Default,,0,0,0,,Хоки - ең жақсы кейіпкер
Dialogue: 0,0:17:18.17,0:17:21.57,Default,,0,0,0,,Дұрыс па? Ақыры түсіндім
Dialogue: 0,0:17:23.53,0:17:25.53,Default,,0,0,0,,Уф...｡ Ах...
Dialogue: 0,0:17:27.53,0:17:30.13,Default,,0,0,0,,Smash де қосылды!
Dialogue: 0,0:17:33.51,0:17:35.53,Default,,0,0,0,,≪Жақсы, Кек алушылар!
Dialogue: 0,0:17:35.53,0:17:38.86,Default,,0,0,0,,≪Иә! Кек алушылар!! Сіз құтқарушыларсыз!
Dialogue: 0,0:17:38.86,0:17:42.86,Default,,0,0,0,,Саносқа келгенімізді хабарлайтын кез келді.
Dialogue: 0,0:17:46.29,0:17:49.29,Default,,0,0,0,,Сіз бұрыннан білетін сияқтысыз.
Dialogue: 0,0:17:52.53,0:17:55.93,Default,,0,0,0,,Біздің шеберіміз Танос-сама осында.
Dialogue: 0,0:17:55.93,0:18:00.93,Default,,0,0,0,,Таңдалған обсидиан, Қара орден, оның пайда болуына дайындал.
Dialogue: 0,0:18:03.15,0:18:05.54,Default,,0,0,0,,Кек алушылар
Dialogue: 0,0:18:05.54,0:18:07.59,Default,,0,0,0,,Көп нәрсе өзгерді.
Dialogue: 0,0:18:07.59,0:18:11.83,Default,,0,0,0,,Танос бір ғана нәрсеге сенеді: күш.
Dialogue: 0,0:18:11.83,0:18:14.50,Default,,0,0,0,,Балалар сендер мені бір рет жеңдіңдер.
Dialogue: 0,0:18:14.50,0:18:17.83,Default,,0,0,0,,Сондықтан, бұл жолы Жерді елемейміз.
Dialogue: 0,0:18:17.83,0:18:21.15,Default,,0,0,0,,Бірақ қалған ғалам менікі.
Dialogue: 0,0:18:21.15,0:18:24.54,Default,,0,0,0,,Таносқа қарсы шыққыңыз келсе, тартынбаңыз →
Dialogue: 0,0:18:24.54,0:18:28.59,Default,,0,0,0,,Қымбат жеріңді құрт
Dialogue: 0,0:18:28.59,0:18:39.59,Default,,0,0,0,,♪♪～
Dialogue: 0,0:19:41.50,0:19:43.60,Default,,0,0,0,,ｼﾞｰﾀｰ
Dialogue: 0,0:19:52.51,0:19:54.65,Default,,0,0,0,,Ironman координаталары алынды
Dialogue: 0,0:19:54.65,0:19:59.65,Default,,0,0,0,,Бұл Sanos-тың жаңартылған нұсқасы ма... Бұған дейін де қатты болды.
Dialogue: 0,0:19:59.65,0:20:02.59,Default,,0,0,0,,Танос біздің планетадан энергия ұрлады
Dialogue: 0,0:20:02.59,0:20:04.99,Default,,0,0,0,,Бірақ енді уайымдамаңыз.
Dialogue: 0,0:20:04.99,0:20:07.33,Default,,0,0,0,,Жерді сағынамыз деп естідім.
Dialogue: 0,0:20:07.33,0:20:10.50,Default,,0,0,0,,Сіз өз планетаңызды қорғауыңыз керек.
Dialogue: 0,0:20:10.50,0:20:14.32,Default,,0,0,0,,Капитан да мен сияқты ойлайтын болуы керек.
Dialogue: 0,0:20:14.32,0:20:16.32,Default,,0,0,0,,Барлығы да солай ма?
Dialogue: 0,0:20:16.32,0:20:19.69,Default,,0,0,0,,Кемені Жаңа Корбинге қайтарыңыз.
Dialogue: 0,0:20:19.69,0:20:23.49,Default,,0,0,0,,Неге бізге көмектесесіңдер, бейтаныс?
Dialogue: 0,0:20:23.49,0:20:26.16,Default,,0,0,0,,Танос кеңістікте бақылаусыз қалдырылса ше➡
Dialogue: 0,0:20:26.16,0:20:28.16,Default,,0,0,0,,Барлық жұлдыздар қауіпті
Dialogue: 0,0:20:28.16,0:20:30.86,Default,,0,0,0,,Алдымен сенің жұлдызыңнан көмектесейік.
Dialogue: 0,0:20:35.07,0:20:38.84,Default,,0,0,0,,Төтенше жағдайда сендер жерді қорғайсыңдар.
Dialogue: 0,0:20:38.84,0:20:42.19,Default,,0,0,0,,Түсінді. (Антоман) Барлығының қайтып келуін күтемін.
Dialogue: 0,0:20:42.19,0:20:44.98,Default,,0,0,0,,Сіз айтқандай, біз дайын емеспіз.
Dialogue: 0,0:20:44.98,0:20:48.67,Default,,0,0,0,,Шайқас әлі аяқталған жоқ.
Dialogue: 0,0:20:48.67,0:20:51.82,Default,,0,0,0,,Лорд Танос келесі жұлдызға аттанды.
Dialogue: 0,0:20:51.82,0:20:54.82,Default,,0,0,0,,Осы планетадағы барлық құнды заттарды кемеге жүктеңіз➡
Dialogue: 0,0:20:54.82,0:20:57.73,Default,,0,0,0,,Қалғанын өртеу туралы бұйрық.
Dialogue: 0,0:20:57.73,0:21:02.32,Default,,0,0,0,,Барлығы күлге айналды. Танос мырзадан кейін қалғаны осы ғана.
Dialogue: 0,0:21:02.32,0:21:04.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:04.33,0:21:06.67,Default,,0,0,0,,Менің туған планетам жойылса да➡
Dialogue: 0,0:21:06.67,0:21:10.07,Default,,0,0,0,,Мен неге күле аламын? Бала
Dialogue: 0,0:21:12.56,0:21:14.56,Default,,0,0,0,,Ух... аа!
Dialogue: 0,0:21:17.66,0:21:21.16,Default,,0,0,0,,Жерде мұны істеу соққы тигізу деп аталады.
Dialogue: 0,0:21:28.32,0:21:30.33,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ？
Dialogue: 0,0:21:30.33,0:21:33.53,Default,,0,0,0,,Менің ұсынысымды ертерек ұмыттыңыз ба? Бұл біздің жауабымыз!
Dialogue: 0,0:21:38.50,0:21:41.32,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:21:41.32,0:21:43.51,Default,,0,0,0,,Сіз сияқты қарабайыр ақылдан➡
Dialogue: 0,0:21:43.51,0:21:47.01,Default,,0,0,0,,Ойды қабылдау оңай
Dialogue: 0,0:21:49.00,0:21:52.48,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:21:52.48,0:21:55.99,Default,,0,0,0,,Қандай ашу! Менің басым ауырып тұр!
Dialogue: 0,0:21:55.99,0:21:58.59,Default,,0,0,0,,Ух... аа!
Dialogue: 0,0:22:00.66,0:22:02.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:04.99,0:22:07.83,Default,,0,0,0,,Егер мен сізді Танос мырзаға олжа ретінде жеткізсем➡
Dialogue: 0,0:22:07.83,0:22:11.92,Default,,0,0,0,,Сізге көмекші ретінде Proxima Midnight болатынына сенімдімін.
Dialogue: 0,0:22:11.92,0:22:15.22,Default,,0,0,0,,Proxima Midnight? Панк тобының аты сияқты естіледі
Dialogue: 0,0:22:20.83,0:22:23.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:25.00,0:22:28.50,Default,,0,0,0,,Басыңды суыт... Бұл рас па?
Dialogue: 0,0:22:32.64,0:22:35.66,Default,,0,0,0,,ｼﾞｰﾀｰ！
Dialogue: 0,0:22:35.66,0:22:37.64,Default,,0,0,0,,Тез қаш!
Dialogue: 0,0:22:37.64,0:22:39.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:41.83,0:22:46.50,Default,,0,0,0,,Олар біз үшін соғысып жатыр, бейтаныс адамдар!
Dialogue: 0,0:22:46.50,0:22:48.80,Default,,0,0,0,,Сіз үнсіз қарауды жоспарлап отырсыз ба?
Dialogue: 0,0:22:50.84,0:22:53.04,Default,,0,0,0,,Мына планетадан кет!
Dialogue: 0,0:23:03.52,0:23:05.64,Default,,0,0,0,,Эй!
Dialogue: 0,0:23:05.64,0:23:08.34,Default,,0,0,0,,Бұл жерден кет!
Dialogue: 0,0:23:11.01,0:23:14.51,Default,,0,0,0,,ｷｬｰ！
Dialogue: 0,0:23:14.51,0:23:16.81,Default,,0,0,0,,Барлығы, кемеге оралыңдар!
Dialogue: 0,0:23:19.42,0:23:21.42,Default,,0,0,0,,Енді келме!
Dialogue: 0,0:23:24.81,0:23:27.83,Default,,0,0,0,,Мынаны қараңыз. Барлығына жақсы.
Dialogue: 0,0:23:27.83,0:23:31.20,Default,,0,0,0,,Мына планетаны қалпына келтір... иә?
Dialogue: 0,0:23:31.20,0:23:34.48,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ
Dialogue: 0,0:23:34.48,0:23:36.82,Default,,0,0,0,,Мен саған мүмкіндік бердім.
Dialogue: 0,0:23:36.82,0:23:38.82,Default,,0,0,0,,Ешқашан екінші рет болмайды.
Dialogue: 0,0:23:38.82,0:23:41.02,Default,,0,0,0,,Екінші рет қайталаудың қажеті жоқ
Dialogue: 0,0:23:44.16,0:23:49.32,Default,,0,0,0,,Қара орден бұл планетаны жоюды жоспарлады, бірақ...
Dialogue: 0,0:23:49.32,0:23:52.02,Default,,0,0,0,,Осы екеуі орындасын.
Dialogue: 0,0:23:55.99,0:23:58.49,Default,,0,0,0,,Бұл планета бітті
Dialogue: 0,0:23:58.49,0:24:02.50,Default,,0,0,0,,Келесі - Жер.
Dialogue: 0,0:24:02.50,0:24:06.32,Default,,0,0,0,,Сіз тым алыс кеткен сияқтысыз. Бұлай жалғаса берсе, ол күйрейді.
Dialogue: 0,0:24:06.32,0:24:09.67,Default,,0,0,0,,Таностың артынан барайық. Барлығын құтқарғаннан кейін.
Dialogue: 0,0:24:09.67,0:24:12.99,Default,,0,0,0,,Асығыңыз және ешкімді қалдырмаңыз!
Dialogue: 0,0:24:12.99,0:24:15.29,Default,,0,0,0,,Тез эвакуациялаңыз!
Dialogue: 0,0:24:17.33,0:24:19.36,Default,,0,0,0,,Бұл бәрі ме?
Dialogue: 0,0:24:19.36,0:24:22.43,Default,,0,0,0,,Тор мен Халк әлі де осында
Dialogue: 0,0:24:22.43,0:24:49.83,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:49.83,0:24:52.88,Default,,0,0,0,,Барлығы солай. Барлығы эвакуацияланды.
Dialogue: 0,0:24:52.88,0:24:56.00,Default,,0,0,0,,Туған жерімнен айырылдым, бірақ өмірім сақталды.
Dialogue: 0,0:24:56.00,0:24:59.65,Default,,0,0,0,,Кек алушылар сен ойлағаннан да көп қаһармандар.
Dialogue: 0,0:24:59.65,0:25:02.82,Default,,0,0,0,,Иә, Тони бекерге ұқсайды.
Dialogue: 0,0:25:02.82,0:25:05.32,Default,,0,0,0,,Авенгетпен ұшатын болсақ, Таносты қуып жетуіміз мүмкін.
Dialogue: 0,0:25:05.32,0:25:07.34,Default,,0,0,0,,Біз жерді қорғауымыз керек
Dialogue: 0,0:25:07.34,0:25:10.00,Default,,0,0,0,,Ынтымақтастық үшін рахмет. Мен планетаны құтқара алмағаныма өкінемін.
Dialogue: 0,0:25:10.00,0:25:13.15,Default,,0,0,0,,Біздің, кобиндіктердің болашағы жарқын.
Dialogue: 0,0:25:13.15,0:25:16.49,Default,,0,0,0,,Мен сенемін.
Dialogue: 0,0:25:16.49,0:25:18.50,Default,,0,0,0,,ﾎｰｸｱｲ！
Dialogue: 0,0:25:18.50,0:25:21.59,Default,,0,0,0,,Бір күні мен де сен сияқты ұлы жауынгер болғым келеді!
Dialogue: 0,0:25:21.59,0:25:24.18,Default,,0,0,0,,Барлығы естіді ме?
Dialogue: 0,0:25:24.18,0:25:27.58,Default,,0,0,0,,Неліктен? Неге тыңдамайсың?
Dialogue: 0,0:25:36.16,0:25:39.64,Default,,0,0,0,,Кек алушылар мұнарасы, жауап бер. Антоман жесірі
Dialogue: 0,0:25:39.64,0:25:42.56,Default,,0,0,0,,Жауап жоқ, бұл радио кедергі болуы мүмкін.
Dialogue: 0,0:25:42.56,0:25:46.13,Default,,0,0,0,,Жердің айналасында келді, еш жерде Таностың белгісі жоқ
Dialogue: 0,0:25:46.13,0:25:48.15,Default,,0,0,0,,Сіз бірінші келдіңіз бе?
Dialogue: 0,0:25:48.15,0:25:50.20,Default,,0,0,0,,Санос оның белгісі жоқ жалғыз адам емес сияқты.
Dialogue: 0,0:25:50.20,0:25:53.74,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:25:53.74,0:25:56.99,Default,,0,0,0,,Жер жоғалып барады!
Dialogue: 0,0:25:56.99,0:25:58.99,Default,,0,0,0,,Тым кеш болды ма?
Dialogue: 0,0:25:58.99,0:26:02.49,Default,,0,0,0,,Жаңа аумаққа кіру арқылы жерді жоғалтты
Dialogue: 0,0:26:35.50,0:26:37.48,Default,,0,0,0,,<“Кек алушылар жиналуда”➡ пайда болады
Dialogue: 0,0:26:37.48,0:26:39.49,Default,,0,0,0,,Супер қаһармандар, жауыздар және т.б. туралы ақпарат➡
Dialogue: 0,0:26:39.49,0:26:41.65,Default,,0,0,0,,Осы жерге жинаңыз
Dialogue: 0,0:26:41.65,0:26:45.14,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:45.14,0:26:47.64,Default,,0,0,0,,Санос басқаратын супержауын тобы
Dialogue: 0,0:26:47.64,0:26:51.33,Default,,0,0,0,,Саностың басшылығымен оның мүшелері адамнан тыс физикалық күшке ие➡
Dialogue: 0,0:26:51.33,0:26:54.97,Default,,0,0,0,,Төзімділікті, жылдамдықты, ұрыс дағдыларын және т.б. қолданыңыз.➡
Dialogue: 0,0:26:54.97,0:26:58.47,Default,,0,0,0,,Жерді басқаруға тырысу＞
Dialogue: 0,0:26:59.97,0:27:05.97,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
