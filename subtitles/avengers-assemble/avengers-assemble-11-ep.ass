Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:39.02,0:00:41.52,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.51,0:00:47.74,Default,,0,0,0,,<Кек алушылар Бұл супер қаһармандар →
Dialogue: 0,0:00:47.74,0:00:51.11,Default,,0,0,0,,Жиналған ең күшті батырлар командасы
Dialogue: 0,0:00:51.11,0:00:53.03,Default,,0,0,0,,Өзіңіздің трансценденттік күшіңізді жинаңыз➡
Dialogue: 0,0:00:53.03,0:00:55.02,Default,,0,0,0,,Жер бетіндегі бейбітшілікті қорға! ＞
Dialogue: 0,0:00:55.02,0:00:57.02,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:57.02,0:00:59.04,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:59.04,0:01:01.52,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:01.52,0:01:03.54,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:03.54,0:01:05.54,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:05.54,0:01:07.54,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:09.61,0:01:12.02,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:12.02,0:01:15.00,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:15.00,0:01:17.04,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:17.04,0:01:19.02,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:19.02,0:01:21.02,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:23.03,0:01:26.06,Default,,0,0,0,,Жұлдызды жол бүлінген аудио файл сияқты➡
Dialogue: 0,0:01:26.06,0:01:28.68,Default,,0,0,0,,Мен бір нәрсені қайта-қайта жасаудан шаршадым.
Dialogue: 0,0:01:28.68,0:01:31.35,Default,,0,0,0,,Мен де қалқанға хабар бердім. Бас тарту.
Dialogue: 0,0:01:31.35,0:01:34.21,Default,,0,0,0,,Кек алушылар шексіздік тастарын жинап қойған
Dialogue: 0,0:01:34.21,0:01:36.24,Default,,0,0,0,,Бұл оңай жұмыс емес еді.
Dialogue: 0,0:01:36.24,0:01:39.38,Default,,0,0,0,,Кек алушылар тасты қорғауға ең қолайлы.
Dialogue: 0,0:01:39.38,0:01:42.36,Default,,0,0,0,,Сәлем, Старк. Мен әрқашан Кек алушылар ақылды деп айтамын➡
Dialogue: 0,0:01:42.36,0:01:44.38,Default,,0,0,0,,Мен айтсам да, адамдар мені өтірікші деп ойлайды.
Dialogue: 0,0:01:44.38,0:01:46.42,Default,,0,0,0,,Ей, бұл біраз мәселе.
Dialogue: 0,0:01:46.42,0:01:48.95,Default,,0,0,0,,Төрт тасты бірге ұстайсың ба?
Dialogue: 0,0:01:48.95,0:01:51.69,Default,,0,0,0,,Танос оны ұрлауға келсе, не істейсің?
Dialogue: 0,0:01:51.69,0:01:54.04,Default,,0,0,0,,Ол міндетті түрде келеді. Танос бір таспен➡
Dialogue: 0,0:01:54.04,0:01:56.08,Default,,0,0,0,,Жерді жарып жібере жаздады.
Dialogue: 0,0:01:56.08,0:01:59.85,Default,,0,0,0,,Мұнда келіңдер, адамдар. Тасты Галактика сақшылары қорғайды.
Dialogue: 0,0:01:59.85,0:02:03.22,Default,,0,0,0,,Еноттардың жылтыр заттарды ұнататынын білемін➡
Dialogue: 0,0:02:03.22,0:02:05.27,Default,,0,0,0,,Мен оны саған бермеймін
Dialogue: 0,0:02:05.27,0:02:07.77,Default,,0,0,0,,Жаңа ғана мен туралы не айттыңыз!? Әңгіменің соңы!
Dialogue: 0,0:02:12.38,0:02:16.03,Default,,0,0,0,,Мен басқару тақтасын жаңартуды ойладым.
Dialogue: 0,0:02:16.03,0:02:19.02,Default,,0,0,0,,Халк кесу ретінде сындыруға жауапты.
Dialogue: 0,0:02:19.02,0:02:21.35,Default,,0,0,0,,Сіз тасқа әбден әуессіз ғой, солай ма?
Dialogue: 0,0:02:21.35,0:02:24.71,Default,,0,0,0,,Шексіздік тасы - ғаламдағы ең қауіпті нысан.
Dialogue: 0,0:02:24.71,0:02:26.74,Default,,0,0,0,,Мен ешкімге сене алмаймын.
Dialogue: 0,0:02:26.74,0:02:28.78,Default,,0,0,0,,Не айтып тұрғаныңызды түсіндім, бірақ➡
Dialogue: 0,0:02:28.78,0:02:31.70,Default,,0,0,0,,Сақшылар айтқандай, бұл тас нысанаға алынған.
Dialogue: 0,0:02:31.70,0:02:35.87,Default,,0,0,0,,Сондықтан біз арнайы қойма жасап, оны озық технологиямен қорғадық.
Dialogue: 0,0:02:35.87,0:02:40.17,Default,,0,0,0,,Оны ешкім тартып ала алмайды, әсіресе Танос.
Dialogue: 0,0:02:42.27,0:02:46.01,Default,,0,0,0,,Тас осында сақталады. Бұл шешім қабылдау мәселесі.
Dialogue: 0,0:02:51.42,0:02:54.45,Default,,0,0,0,,Эй, сен мені естисің бе? (Халк) Не?
Dialogue: 0,0:02:54.45,0:02:56.86,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:02:56.86,0:03:13.39,Default,,0,0,0,,(Халктың қорылдауы)
Dialogue: 0,0:03:13.39,0:03:19.09,Default,,0,0,0,,Хм, менің артымдағы жігітті ұрып тастаңыз...
Dialogue: 0,0:03:23.85,0:03:25.85,Default,,0,0,0,,Маған көбірек мақсаттар беріңіз.
Dialogue: 0,0:03:25.85,0:04:12.71,Default,,0,0,0,,♪♪～
Dialogue: 0,0:04:12.71,0:04:15.08,Default,,0,0,0,,Сен данышпаннан ұрламақшысың ба?
Dialogue: 0,0:04:15.08,0:04:17.88,Default,,0,0,0,,Менің технологияма сәйкес келу мүмкін емес.
Dialogue: 0,0:04:21.71,0:04:25.76,Default,,0,0,0,,Жесір? Мен саған тасты бере алмаймын
Dialogue: 0,0:04:25.76,0:04:30.16,Default,,0,0,0,,Жоқ, Наташа, шексіздік тасын осында қойыңыз.
Dialogue: 0,0:05:52.05,0:05:55.35,Default,,0,0,0,,Мен бұл мұнарадан Шексіздік тасымен бірге шығуға рұқсат бермеймін.
Dialogue: 0,0:05:57.52,0:06:00.71,Default,,0,0,0,,Сіз кек алушыларға опасыздық жасайсыз ба?
Dialogue: 0,0:06:00.71,0:06:05.68,Default,,0,0,0,,Өйткені, сіз кек алушылар емес, қалқан адамсыз.
Dialogue: 0,0:06:05.68,0:06:10.22,Default,,0,0,0,,Мұнда екеніңізді қайдан білдіңіз? дабыл қосылмаған
Dialogue: 0,0:06:10.22,0:06:14.54,Default,,0,0,0,,Сізде бірдеңе істеу керек еді, солай ма? Стоунмен не істеуді жоспарладыңыз?
Dialogue: 0,0:06:14.54,0:06:18.19,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:20.21,0:06:31.02,Default,,0,0,0,,Император Старк аман болсын! Император Старк аман болсын!
Dialogue: 0,0:06:31.02,0:06:33.35,Default,,0,0,0,,Бұл менікі!
Dialogue: 0,0:06:33.35,0:06:36.02,Default,,0,0,0,,Таспен тозған
Dialogue: 0,0:06:36.02,0:06:38.32,Default,,0,0,0,,Мен бұлай істегім келмеді... Ха!
Dialogue: 0,0:06:46.02,0:06:48.62,Default,,0,0,0,,Мені бұл жерден кетіріңіз!
Dialogue: 0,0:06:53.12,0:06:57.72,Default,,0,0,0,,《Шексіздік тасы арқылы сіз әлемдегі ең күшті тіршілік иесі бола аласыз》
Dialogue: 0,0:06:59.68,0:07:03.00,Default,,0,0,0,,А... менің басымнан кет.
Dialogue: 0,0:07:03.00,0:07:05.00,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:07:05.00,0:07:07.19,Default,,0,0,0,,Бұл дәл Тони айтқандай. Бұл Фьюридің бұйрығы болды ма?
Dialogue: 0,0:07:07.19,0:07:10.09,Default,,0,0,0,,Мен Фьюриге сене алмаймын, басқа ешкімге.
Dialogue: 0,0:07:13.56,0:07:15.60,Default,,0,0,0,,Уау! Кешіріңіз Falcon
Dialogue: 0,0:07:15.60,0:07:18.50,Default,,0,0,0,,Кек алушылар! Жесір тасты ұрламақшы
Dialogue: 0,0:07:18.50,0:07:20.67,Default,,0,0,0,,Шықса, амал жоқ. (Ескерту)
Dialogue: 0,0:07:20.67,0:07:23.17,Default,,0,0,0,,Сіз ақымақтық жасадыңыз, Наташа.
Dialogue: 0,0:07:23.17,0:07:26.67,Default,,0,0,0,,Бұл Қара жесірге ұқсамайды. Оған тасты беріңіз.
Dialogue: 0,0:07:26.67,0:07:29.68,Default,,0,0,0,,Мен сенімен ұрысқым келмейді
Dialogue: 0,0:07:29.68,0:07:44.34,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:44.34,0:07:46.34,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:07:52.52,0:07:54.50,Default,,0,0,0,,Мен сені ренжіткім келмейді
Dialogue: 0,0:07:54.50,0:07:56.52,Default,,0,0,0,,Мені күлдірме
Dialogue: 0,0:07:56.52,0:08:01.34,Default,,0,0,0,,Тоқта, Халк, Тони жүрегін тас жеп кетті.
Dialogue: 0,0:08:01.34,0:08:03.83,Default,,0,0,0,,Тасқа қол тигізсең, бәрі бірдей нәрсеге тап болады.
Dialogue: 0,0:08:03.83,0:08:05.83,Default,,0,0,0,,А, сен де.
Dialogue: 0,0:08:05.83,0:08:09.00,Default,,0,0,0,,Жоқ, S.H.I.E.L.D. алған тренингтің арқасында мен әлі де жақсымын.
Dialogue: 0,0:08:09.00,0:08:11.00,Default,,0,0,0,,Бірақ бұл ұзаққа созылмайды
Dialogue: 0,0:08:11.00,0:08:13.00,Default,,0,0,0,,Дәл қазір тасты бір жерге жылжытуымыз керек.
Dialogue: 0,0:08:13.00,0:08:16.17,Default,,0,0,0,,Маған сеніңіз
Dialogue: 0,0:08:16.17,0:08:18.84,Default,,0,0,0,,Бұл олар үшін емес.
Dialogue: 0,0:08:18.84,0:08:21.01,Default,,0,0,0,,Сен мені өлтіре жаздадың
Dialogue: 0,0:08:21.01,0:08:23.00,Default,,0,0,0,,Ұйқыда сөйлеме
Dialogue: 0,0:08:23.00,0:08:27.00,Default,,0,0,0,,Асгардта тасты шынымен мөрлеуге бола ма?
Dialogue: 0,0:08:27.00,0:08:31.67,Default,,0,0,0,,Мәселе жоқ, Асгардта тыйым салынған сиқырдың сансыз түрлері бар.
Dialogue: 0,0:08:31.67,0:08:33.68,Default,,0,0,0,,Тасты қорғай алады
Dialogue: 0,0:08:33.68,0:08:35.68,Default,,0,0,0,,Heimdal порталы!
Dialogue: 0,0:08:51.84,0:08:56.01,Default,,0,0,0,,Хеймдал Маңызды мәселе туындады, мен сіздің көмегіңізді қалаймын.
Dialogue: 0,0:08:56.01,0:08:59.00,Default,,0,0,0,,Мен мән-жайды білемін. Тәуекел болса да ➡
Dialogue: 0,0:08:59.00,0:09:02.50,Default,,0,0,0,,Тасты қалауыңызша қауіпсіз жерге тығып қойыңыз.
Dialogue: 0,0:09:17.00,0:09:22.67,Default,,0,0,0,,(Хеймдал күлкісі)
Dialogue: 0,0:09:22.67,0:09:26.66,Default,,0,0,0,,Жақсы емес! Оны тас жеп қойған!
Dialogue: 0,0:09:26.66,0:09:29.16,Default,,0,0,0,,Ах... Бұл менікі!
Dialogue: 0,0:09:29.16,0:09:32.68,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:09:32.68,0:09:48.35,Default,,0,0,0,,♪♪～
Dialogue: 0,0:09:48.35,0:09:52.42,Default,,0,0,0,,Мен Хеймдал маған опасыздық жасайды деп армандаған емеспін.
Dialogue: 0,0:09:52.42,0:09:55.52,Default,,0,0,0,,Бұл оның кінәсі емес. Кез келген адам Стоунның құрбанына айналуы мүмкін.
Dialogue: 0,0:09:55.52,0:09:58.84,Default,,0,0,0,,Ал, сізден сұрайын, алдағы жоспарларыңыз бар ма?
Dialogue: 0,0:09:58.84,0:10:01.68,Default,,0,0,0,,Әрине, ең алдымен...
Dialogue: 0,0:10:01.68,0:10:04.03,Default,,0,0,0,,Қозғалмаңдар, ана жақтағы адамдар.
Dialogue: 0,0:10:04.03,0:10:07.67,Default,,0,0,0,,Біз бұл туралы айттық, Зымыран. Нұсқауларды беретін менмін.
Dialogue: 0,0:10:07.67,0:10:11.01,Default,,0,0,0,,Бірақ мен сөйлейтін болсам, қорқыту тиімдірек болады. Келесі жолы жасай аласыз.
Dialogue: 0,0:10:11.01,0:10:14.08,Default,,0,0,0,,Мен тасты ұрлаған жоқпын. Мен оны жай ғана жылжыттым.
Dialogue: 0,0:10:14.08,0:10:17.10,Default,,0,0,0,,А, мен естідім. Оны бүкіл ғалам естіді.
Dialogue: 0,0:10:17.10,0:10:21.67,Default,,0,0,0,,Сіздің Асгардқа саяхатыңыз Тастың орнын ашты.
Dialogue: 0,0:10:21.67,0:10:27.36,Default,,0,0,0,,Сізге қонаққа Спартак, сақарандар, аспаншылар келсе, таң қалмаңыз.
Dialogue: 0,0:10:27.36,0:10:29.34,Default,,0,0,0,,Бұл ескерту.
Dialogue: 0,0:10:29.34,0:10:32.01,Default,,0,0,0,,Мен сізге ескерту үшін келген жоқпын. Өзіңнен озып кетпеуің үшін мен осындамын.
Dialogue: 0,0:10:32.01,0:10:35.03,Default,,0,0,0,,Күзетшілер, тұрыңдар!
Dialogue: 0,0:10:35.03,0:10:38.00,Default,,0,0,0,,Қараңдар, мен сендерге нұсқау бердім. Өзіңізді қалай сезінесіз?
Dialogue: 0,0:10:38.00,0:10:40.02,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:10:40.02,0:10:42.02,Default,,0,0,0,,Менің ойымша, бұл келесі жоспар емес.
Dialogue: 0,0:11:44.00,0:11:48.00,Default,,0,0,0,,Маған шексіздік тасын беріңіз. Қиындыққа тап боласыз.
Dialogue: 0,0:11:50.00,0:11:53.69,Default,,0,0,0,,《Бәрін құрт, құрт...》
Dialogue: 0,0:11:53.69,0:11:58.35,Default,,0,0,0,,Тас тым көп. Оны өз бетімен басқару мүмкін емес.
Dialogue: 0,0:11:58.35,0:12:00.35,Default,,0,0,0,,Сақшылар дұрыс шығар.
Dialogue: 0,0:12:10.04,0:12:14.41,Default,,0,0,0,,Жоқ, мен де оларға сене алмаймын. Жарайды, түсінемін.
Dialogue: 0,0:12:14.41,0:12:16.71,Default,,0,0,0,,Сақшылар тасын ұрлау.
Dialogue: 0,0:12:18.70,0:12:21.70,Default,,0,0,0,,үшінң, тезірек қозғалыңдар! Groot! Ұстаңыз!
Dialogue: 0,0:12:23.70,0:12:25.71,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:25.71,0:12:28.41,Default,,0,0,0,,Мен Грутпын!
Dialogue: 0,0:12:37.80,0:12:40.50,Default,,0,0,0,,Бүгін жаман көрінесің, Гамора.
Dialogue: 0,0:12:43.36,0:12:45.39,Default,,0,0,0,,Ой…
Dialogue: 0,0:12:45.39,0:13:06.00,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:06.00,0:13:09.37,Default,,0,0,0,,Енді қаша алмайсың. Маған тасты беріңіз.
Dialogue: 0,0:13:09.37,0:13:14.67,Default,,0,0,0,,《Тасты қолдан, оларды өшіріп, әлемді басқар》
Dialogue: 0,0:13:16.67,0:13:18.67,Default,,0,0,0,,Мен сені қолдаймын, Видо.
Dialogue: 0,0:13:22.35,0:13:25.68,Default,,0,0,0,,Маған көмектесесіңдер ме? Мен... дұрыс жасадым
Dialogue: 0,0:13:25.68,0:13:29.08,Default,,0,0,0,,Мені Тас басқарып жатқанын түсінбедім.
Dialogue: 0,0:13:32.34,0:13:34.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:34.34,0:13:48.34,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:48.34,0:13:50.36,Default,,0,0,0,,Уау...
Dialogue: 0,0:13:50.36,0:13:57.00,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:57.00,0:13:59.32,Default,,0,0,0,,♬~
Dialogue: 0,0:13:59.32,0:14:02.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:02.00,0:14:05.41,Default,,0,0,0,,А... Мен тасты алып шыққаныма сенесің бе?
Dialogue: 0,0:14:05.41,0:14:07.34,Default,,0,0,0,,Шындығында мен сенетін жалғыз адам - ​​сен.
Dialogue: 0,0:14:07.34,0:14:10.34,Default,,0,0,0,,Басқа мүшелердің Стоунға қарсы тұруға ақыл-ой күші жетпейді.
Dialogue: 0,0:14:10.34,0:14:12.70,Default,,0,0,0,,Және бұл Халктың кепілдігімен бірге келеді.
Dialogue: 0,0:14:12.70,0:14:14.70,Default,,0,0,0,,ﾌﾝ
Dialogue: 0,0:14:22.67,0:14:24.69,Default,,0,0,0,,А-а-а-а!
Dialogue: 0,0:14:24.69,0:14:34.39,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:37.34,0:14:39.74,Default,,0,0,0,,Уф...!
Dialogue: 0,0:14:39.74,0:14:41.78,Default,,0,0,0,,Сіз де түсінбейсіз.
Dialogue: 0,0:14:41.78,0:14:44.33,Default,,0,0,0,,Сіз Infinity Stone-мен айналыса алмайсыз.
Dialogue: 0,0:14:44.33,0:14:46.68,Default,,0,0,0,,Сізге де солай.
Dialogue: 0,0:14:46.68,0:14:48.67,Default,,0,0,0,,Үйге құр қол барма!
Dialogue: 0,0:14:48.67,0:14:51.34,Default,,0,0,0,,Ха! Дәмі керемет! Шынында да, тамаша!
Dialogue: 0,0:14:51.34,0:14:53.34,Default,,0,0,0,,Үйлеріне құр қол қайтсын!
Dialogue: 0,0:14:55.69,0:14:58.24,Default,,0,0,0,,Мен жасадым, жұмыс істеді, тамаша!
Dialogue: 0,0:14:58.24,0:15:00.49,Default,,0,0,0,,Эй, сен оны басқа өлшемге жібердің бе?
Dialogue: 0,0:15:00.49,0:15:03.16,Default,,0,0,0,,Қамқоршылардың телепортация құрылғысы іске қосылды.
Dialogue: 0,0:15:03.16,0:15:05.18,Default,,0,0,0,,Жұлдызды лорд кемеге оралды.
Dialogue: 0,0:15:05.18,0:15:07.35,Default,,0,0,0,,Маған бір сәт уақыт беріңіз, мен оны 10 секундта аяқтаймын.
Dialogue: 0,0:15:07.35,0:15:11.01,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:11.01,0:15:13.17,Default,,0,0,0,,Бір өтінемін.
Dialogue: 0,0:15:13.17,0:15:15.84,Default,,0,0,0,,Сен үшін де жасап көрейік
Dialogue: 0,0:15:15.84,0:15:20.00,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:20.00,0:15:22.33,Default,,0,0,0,,Екеуің жиналыңдар!
Dialogue: 0,0:15:22.33,0:15:24.37,Default,,0,0,0,,Мен топпын...
Dialogue: 0,0:15:24.37,0:15:27.92,Default,,0,0,0,,Мен қайта құрып, қайтамын. Бұл бірден болуы мүмкін емес.
Dialogue: 0,0:15:27.92,0:15:30.94,Default,,0,0,0,,Бұл диск олардың мобильді құрылғысын бұзады.
Dialogue: 0,0:15:30.94,0:15:34.68,Default,,0,0,0,,Асгард сәтсіздікке ұшырады ма? Келесі стратегия қандай?
Dialogue: 0,0:15:34.68,0:15:37.18,Default,,0,0,0,,Неліктен басқа стратегия бар?
Dialogue: 0,0:15:37.18,0:15:39.63,Default,,0,0,0,,Видоның әрқашан балама жоспары бар.
Dialogue: 0,0:15:39.63,0:15:42.17,Default,,0,0,0,,Тор екеуміз оған қамқор боламыз.
Dialogue: 0,0:15:42.17,0:15:45.56,Default,,0,0,0,,Мұнарадан тасты не үшін алғаныңызды түсіндім.
Dialogue: 0,0:15:45.56,0:15:49.43,Default,,0,0,0,,Сіз мені құтқардыңыз. Біз командамыз.
Dialogue: 0,0:15:49.43,0:15:51.93,Default,,0,0,0,,Маған ынтымақтасуға рұқсат етіңіз.
Dialogue: 0,0:15:58.05,0:16:01.19,Default,,0,0,0,,《Тасты пайдалан...
Dialogue: 0,0:16:01.19,0:16:05.54,Default,,0,0,0,,Билік сенікі, оны ал.
Dialogue: 0,0:16:05.54,0:16:09.68,Default,,0,0,0,,Әлемді билеу үшін тасты пайдаланыңыз
Dialogue: 0,0:16:09.68,0:16:11.68,Default,,0,0,0,,Бұл сенікі.
Dialogue: 0,0:16:11.68,0:16:16.09,Default,,0,0,0,,Әлемдегі ең үлкен күшке ие болмысқа айнал...》
Dialogue: 0,0:16:16.09,0:16:19.19,Default,,0,0,0,,Азғыру күшейе түсуде.
Dialogue: 0,0:16:21.68,0:16:23.69,Default,,0,0,0,,Ей, уәдеңде тұра аласың ба?
Dialogue: 0,0:16:23.69,0:16:27.53,Default,,0,0,0,,Мен Асгард ханзадасымын, сөздерім абсолютті.
Dialogue: 0,0:16:27.53,0:16:30.37,Default,,0,0,0,,Маған уәде бер. Азғыруға көнсем➡
Dialogue: 0,0:16:30.37,0:16:32.42,Default,,0,0,0,,Егер сіз тасты қолдансаңыз➡
Dialogue: 0,0:16:32.42,0:16:34.52,Default,,0,0,0,,Мені жеңсең
Dialogue: 0,0:16:34.52,0:16:37.36,Default,,0,0,0,,Бұған Один заңы бойынша тыйым салынған.
Dialogue: 0,0:16:37.36,0:16:40.23,Default,,0,0,0,,Бірақ оны қараңғылық патшалығына өшіруге болады.
Dialogue: 0,0:16:40.23,0:16:42.55,Default,,0,0,0,,Бірақ бұл мүмкін емес
Dialogue: 0,0:16:42.55,0:16:46.05,Default,,0,0,0,,Саған сенгенімді қаласаң... уәде бер!
Dialogue: 0,0:16:52.19,0:16:55.19,Default,,0,0,0,,Жарайды, мен уәде беремін.
Dialogue: 0,0:17:04.17,0:17:07.02,Default,,0,0,0,,А, Блеккер көшесі, 177
Dialogue: 0,0:17:07.02,0:17:09.86,Default,,0,0,0,,Сіздің келесі жоспарыңыз Манхэттендегі пәтер ме?
Dialogue: 0,0:17:09.86,0:17:12.41,Default,,0,0,0,,Бұл жай ғана пәтер емес. Барайық.
Dialogue: 0,0:17:12.41,0:17:15.23,Default,,0,0,0,,Мен оны қағып аламын.
Dialogue: 0,0:17:15.23,0:17:18.23,Default,,0,0,0,,Уау! ≪Тоқта, Халк
Dialogue: 0,0:17:22.02,0:17:24.17,Default,,0,0,0,,Мен есікті жаңа ғана ауыстырдым.
Dialogue: 0,0:17:24.17,0:17:28.34,Default,,0,0,0,,Доктор Стренж!? Жоғарғы сиқыршы қарапайым пәтерде тұрады ма?
Dialogue: 0,0:17:28.34,0:17:30.85,Default,,0,0,0,,Нью-Йоркте қалыпты ештеңе жоқ.
Dialogue: 0,0:17:30.85,0:17:34.01,Default,,0,0,0,,Кек алушылар Мен сендердің келе жатқаныңды білдім.
Dialogue: 0,0:17:34.01,0:17:36.67,Default,,0,0,0,,Қауіпті болуы мүмкін.
Dialogue: 0,0:17:36.67,0:17:40.17,Default,,0,0,0,,Тас менің ойымды басқаруға тырысады
Dialogue: 0,0:17:40.17,0:17:43.37,Default,,0,0,0,,Мен оны патшалықтардың арасын жабуға көмектесуіңізді қалаймын.
Dialogue: 0,0:17:51.18,0:17:53.20,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:17:53.20,0:17:57.00,Default,,0,0,0,,Сіз Стоуннан жеңіле алмайсыз. Ғаламның тағдыры өз қолыңда...
Dialogue: 0,0:17:57.00,0:17:59.17,Default,,0,0,0,,Бұл жай ғана ғарыш мәселесі емес
Dialogue: 0,0:17:59.17,0:18:02.67,Default,,0,0,0,,Бұл қайшылық барлық өлшемдерді оятты.
Dialogue: 0,0:18:04.68,0:18:08.17,Default,,0,0,0,,Ал енді жұмбақ әлемі белсенді түрде қозғала бастады.
Dialogue: 0,0:18:08.17,0:18:10.17,Default,,0,0,0,,Мен сиқырға сенбеймін➡
Dialogue: 0,0:18:10.17,0:18:12.19,Default,,0,0,0,,Доктор Стренж➡ үшін алаңдасаңыз
Dialogue: 0,0:18:12.19,0:18:16.02,Default,,0,0,0,,Жаман нәрсе болуы керек
Dialogue: 0,0:18:16.02,0:18:18.66,Default,,0,0,0,,Шындықтың өзі жыртылады
Dialogue: 0,0:18:18.66,0:18:23.01,Default,,0,0,0,,Абайлаңыз, жын патшасы шығады.
Dialogue: 0,0:18:23.01,0:18:26.08,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,0:18:26.08,0:18:30.00,Default,,0,0,0,,Дормамму? Бұл жоспарланғандай.
Dialogue: 0,0:18:30.00,0:18:33.84,Default,,0,0,0,,Хехехехе...
Dialogue: 0,0:18:33.84,0:18:37.04,Default,,0,0,0,,Сіз әлі де сиқырға сенбейсіз бе, Тони?
Dialogue: 0,0:19:40.01,0:19:43.16,Default,,0,0,0,,Хехехехе...
Dialogue: 0,0:19:43.16,0:19:46.01,Default,,0,0,0,,Дормамму үлкен, бірақ ол жалғыз.
Dialogue: 0,0:19:46.01,0:19:49.57,Default,,0,0,0,,Мұнда адамдар көп. (Жауынгерлік айқай)
Dialogue: 0,0:19:49.57,0:19:52.85,Default,,0,0,0,,Сіз ақымақ нәрсе айттыңыз! Ақылға киетіндер?
Dialogue: 0,0:19:52.85,0:19:55.52,Default,,0,0,0,,Оның қызметшілері – жансыз тас құбыжықтар.
Dialogue: 0,0:19:55.52,0:19:57.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:00.68,0:20:03.83,Default,,0,0,0,,Тоқта! Жау тасқа жақындамасын!!
Dialogue: 0,0:20:03.83,0:20:07.02,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:07.02,0:20:10.35,Default,,0,0,0,,Әзірге келесі стратегия маған ұнамайды.
Dialogue: 0,0:20:10.35,0:20:13.69,Default,,0,0,0,,Хехехехе...
Dialogue: 0,0:20:13.69,0:20:16.84,Default,,0,0,0,,Мен мұны жалғыз істеуім керек еді. Мен барлығын қатыстырдым!
Dialogue: 0,0:20:16.84,0:20:21.33,Default,,0,0,0,,Дормам! Кінибтің жеті күні сөнсін
Dialogue: 0,0:20:21.33,0:20:25.00,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,0:20:25.00,0:20:28.36,Default,,0,0,0,,Эй, Окабе.
Dialogue: 0,0:20:28.36,0:20:31.51,Default,,0,0,0,,Фуфуфуфу…｡ Ах!
Dialogue: 0,0:20:31.51,0:20:35.18,Default,,0,0,0,,Хахахаха! Эй, от құбыжығы!
Dialogue: 0,0:20:35.18,0:20:37.18,Default,,0,0,0,,Тамақ жегің келсе, мінекей!
Dialogue: 0,0:20:37.18,0:20:40.02,Default,,0,0,0,,Тамаша болмаса да, жебенің дәмі жоқ.
Dialogue: 0,0:20:40.02,0:21:05.49,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:05.49,0:21:08.91,Default,,0,0,0,,Басқа стратегиялар бар деп үміттенемін...
Dialogue: 0,0:21:08.91,0:21:11.35,Default,,0,0,0,,《Тасты қолдан》
Dialogue: 0,0:21:11.35,0:21:21.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:21.84,0:21:23.86,Default,,0,0,0,,Ешқандай шектеу жоқ!
Dialogue: 0,0:21:23.86,0:21:27.68,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:27.68,0:21:30.33,Default,,0,0,0,,Уау!!
Dialogue: 0,0:21:30.33,0:21:36.51,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:36.51,0:21:40.49,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:21:40.49,0:21:42.51,Default,,0,0,0,,Басқа стратегия.
Dialogue: 0,0:21:42.51,0:21:45.18,Default,,0,0,0,,｜ Уәдеңді ұмытпа!
Dialogue: 0,0:21:45.18,0:21:48.00,Default,,0,0,0,,Тоқта! Ах!
Dialogue: 0,0:21:48.00,0:22:04.72,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:04.72,0:22:07.02,Default,,0,0,0,,Бұл ыңғайсыздық!
Dialogue: 0,0:22:07.02,0:22:13.01,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:13.01,0:22:16.01,Default,,0,0,0,,Уау!!
Dialogue: 0,0:22:20.00,0:22:26.14,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,0:22:26.14,0:22:33.75,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:33.75,0:22:35.95,Default,,0,0,0,,(айқайлау)
Dialogue: 0,0:22:37.85,0:22:40.55,Default,,0,0,0,,(айқайлау)
Dialogue: 0,0:22:42.52,0:22:45.41,Default,,0,0,0,,Сезіңіз... бәрін!
Dialogue: 0,0:22:45.41,0:22:48.46,Default,,0,0,0,,Мен ғаламды, бәрін көремін
Dialogue: 0,0:22:48.46,0:22:51.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:51.32,0:22:54.20,Default,,0,0,0,,Бұл қара/жесір, солай ма?
Dialogue: 0,0:22:54.20,0:22:56.85,Default,,0,0,0,,Мен неге қарсылық көрсете бердім?
Dialogue: 0,0:22:56.85,0:23:00.54,Default,,0,0,0,,Мен бәрін істей аламын. Менің бақылауымда.
Dialogue: 0,0:23:00.54,0:23:04.01,Default,,0,0,0,,Жоқ, бірақ... бір тас жетіспейді.
Dialogue: 0,0:23:04.01,0:23:07.51,Default,,0,0,0,,Бұл қуат тасы. Пауэр тасы жоғалып кетті.
Dialogue: 0,0:23:07.51,0:23:11.17,Default,,0,0,0,,Қайтып кел, Видо!
Dialogue: 0,0:23:11.17,0:23:13.50,Default,,0,0,0,,Күшті тастар бар
Dialogue: 0,0:23:13.50,0:23:18.18,Default,,0,0,0,,Тауып алсам, күшім шексіз болар еді.
Dialogue: 0,0:23:18.18,0:23:20.16,Default,,0,0,0,,тым кеш болады
Dialogue: 0,0:23:20.16,0:23:22.83,Default,,0,0,0,,Маған шексіздік тасын беріңіз. Кәне!
Dialogue: 0,0:23:22.83,0:23:25.50,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:23:25.50,0:23:27.50,Default,,0,0,0,,(енеді)
Dialogue: 0,0:23:27.50,0:23:30.35,Default,,0,0,0,,Мен ешкімнің пікір білдіруіне жол бермеймін.
Dialogue: 0,0:23:30.35,0:23:41.01,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:41.01,0:23:43.68,Default,,0,0,0,,ｳｨﾄﾞｳ！
Dialogue: 0,0:23:43.68,0:23:46.38,Default,,0,0,0,,Сіз есін жоғалтып жатырсыз. Жақсырақ болыңыз.
Dialogue: 0,0:23:49.17,0:23:51.57,Default,,0,0,0,,Мен не істедім?
Dialogue: 0,0:23:53.68,0:23:55.85,Default,,0,0,0,,бізге көмектесті
Dialogue: 0,0:23:55.85,0:24:00.52,Default,,0,0,0,,Бірақ орнына уәдеңізді орындаңыз. Сонымен!
Dialogue: 0,0:24:00.52,0:24:02.85,Default,,0,0,0,,Басқа жол болуы керек
Dialogue: 0,0:24:02.85,0:24:09.01,Default,,0,0,0,,Мені Кек алушылардың бас жауы және нағыз шайтан болуға жол берме!
Dialogue: 0,0:24:09.01,0:24:11.01,Default,,0,0,0,,Менің сөздерім абсолютті
Dialogue: 0,0:24:11.01,0:24:21.59,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:21.59,0:24:23.49,Default,,0,0,0,,Неліктен? Жаса!
Dialogue: 0,0:24:23.49,0:24:27.66,Default,,0,0,0,,Жоқ, мен бәрінен де көп сенемін.
Dialogue: 0,0:24:27.66,0:24:31.83,Default,,0,0,0,,Бұл өзін-өзі бақылау туралы. Сіз Кек алушылар тобындасыз➡
Dialogue: 0,0:24:31.83,0:24:33.85,Default,,0,0,0,,Бұл ең күшті дегенді білдіреді.
Dialogue: 0,0:24:33.85,0:24:37.52,Default,,0,0,0,,Сіз өзіңізді құрбан етпей-ақ Тасты жеңе аласыз.
Dialogue: 0,0:24:37.52,0:24:39.86,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:24:39.86,0:24:46.01,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:46.01,0:24:48.37,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:24:48.37,0:24:50.37,Default,,0,0,0,,Ах... Натася
Dialogue: 0,0:24:52.34,0:24:55.02,Default,,0,0,0,,Мен қайтып келдім
Dialogue: 0,0:24:55.02,0:24:58.18,Default,,0,0,0,,Мен де оралдым
Dialogue: 0,0:24:58.18,0:25:00.19,Default,,0,0,0,,ｻﾉｽ！
Dialogue: 0,0:25:00.19,0:25:03.21,Default,,0,0,0,,Тастар оларды дұрыс ұстай алатын адамды іздейді.
Dialogue: 0,0:25:03.21,0:25:06.20,Default,,0,0,0,,Мен ғана иесі болуға лайықпын.
Dialogue: 0,0:25:06.20,0:25:11.90,Default,,0,0,0,,Infinity Gauntлет соңғы күш енді менікі.
Dialogue: 0,0:25:16.01,0:25:18.35,Default,,0,0,0,,Енді! Жақсы!
Dialogue: 0,0:25:18.35,0:25:21.16,Default,,0,0,0,,Танос! Асгардтың күшімен➡
Dialogue: 0,0:25:21.16,0:25:24.36,Default,,0,0,0,,Мен сені қараңғылық патшалығына мәңгілікке өшіремін.
Dialogue: 0,0:25:27.04,0:25:30.17,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:25:30.17,0:25:33.66,Default,,0,0,0,,Таностың қалауына қарсы тұру үшін шексіз күш қажет.
Dialogue: 0,0:25:33.66,0:25:36.33,Default,,0,0,0,,Сізде ондай күш жоқ.
Dialogue: 0,0:25:36.33,0:25:38.35,Default,,0,0,0,,Менде бар
Dialogue: 0,0:25:38.35,0:25:44.86,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:44.86,0:25:47.56,Default,,0,0,0,,Рахмет, кек алушылар!
Dialogue: 0,0:25:54.03,0:25:59.35,Default,,0,0,0,,Хоки, сіз саркастикалық бірдеңе айта аласыз ба?
Dialogue: 0,0:25:59.35,0:26:02.35,Default,,0,0,0,,Дүние бітсе де ирония жоқ
Dialogue: 0,0:26:35.99,0:26:38.01,Default,,0,0,0,,<“Кек алушылар жиналады” фильмінде пайда болу➡
Dialogue: 0,0:26:38.01,0:26:40.16,Default,,0,0,0,,Супер қаһармандар, жауыздар және т.б. туралы ақпарат ➡
Dialogue: 0,0:26:40.16,0:26:42.51,Default,,0,0,0,,Осы жерде жинаңыз
Dialogue: 0,0:26:42.51,0:26:45.67,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:45.67,0:26:49.34,Default,,0,0,0,,Жақын шайқаста және атыс қаруын қолдануда дағдыланған➡
Dialogue: 0,0:26:49.34,0:26:52.86,Default,,0,0,0,,Сабырлы, сабырлы және ақылды әйел агент
Dialogue: 0,0:26:52.86,0:26:56.71,Default,,0,0,0,,Қарқынды электр тоғымен тұтанатын білезік кию.
Dialogue: 0,0:26:56.71,0:26:59.11,Default,,0,0,0,,Шын аты - Наташа Романоф>
Dialogue: 0,0:27:00.61,0:27:06.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
