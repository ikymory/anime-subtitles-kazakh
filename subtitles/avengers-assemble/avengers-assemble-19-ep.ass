Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:38.51,0:00:40.81,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.39,0:00:50.01,Default,,0,0,0,,<Кек алушылар Бұл супер қаһармандар жинаған ең күшті батырлар командасы.
Dialogue: 0,0:00:50.01,0:00:52.36,Default,,0,0,0,,Трансценденттік күшіңізді жинаңыз➡
Dialogue: 0,0:00:52.36,0:00:54.36,Default,,0,0,0,,Жер бетіндегі тыныштықты қорғаңыз! ＞
Dialogue: 0,0:00:54.36,0:00:56.35,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:56.35,0:00:58.52,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:58.52,0:01:01.00,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:01.00,0:01:03.00,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:03.00,0:01:05.01,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:05.01,0:01:07.01,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:09.01,0:01:11.53,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:11.53,0:01:14.52,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:14.52,0:01:16.57,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:16.57,0:01:18.59,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:18.59,0:01:20.59,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:23.53,0:01:25.53,Default,,0,0,0,,Ха~ Хаха
Dialogue: 0,0:01:25.53,0:01:29.83,Default,,0,0,0,,Жақсы, хахахаха. О, бұл керемет.
Dialogue: 0,0:01:31.93,0:01:34.73,Default,,0,0,0,,О~ хаха. Жарайды, кеттік.
Dialogue: 0,0:01:36.69,0:01:39.19,Default,,0,0,0,,Ой!
Dialogue: 0,0:01:39.19,0:01:41.36,Default,,0,0,0,,Бұл жеткілікті, Халк.
Dialogue: 0,0:01:41.36,0:01:44.51,Default,,0,0,0,,Мен Старкқа тапсырма беруден шаршадым.
Dialogue: 0,0:01:44.51,0:01:46.53,Default,,0,0,0,,Тапсырмаларды орындау, солай ма?
Dialogue: 0,0:01:46.53,0:01:50.40,Default,,0,0,0,,Сонымен қатар, бұзылған байланыс спутнигін қайтарып алуыңызды қалаймын➡
Dialogue: 0,0:01:50.40,0:01:52.44,Default,,0,0,0,,Мен сізден...
Dialogue: 0,0:01:52.44,0:01:54.74,Default,,0,0,0,,Дұрыс, шағымданба.
Dialogue: 0,0:01:59.53,0:02:02.36,Default,,0,0,0,,Әу бастан осылай болғанын айт
Dialogue: 0,0:02:02.36,0:02:06.16,Default,,0,0,0,,Мен сізді естимін. (Халк) Иә.
Dialogue: 0,0:02:19.66,0:02:23.54,Default,,0,0,0,,Тұрақты өрісті кеңейтіңіз. (Антоман) Ол қазірдің өзінде өте кең.
Dialogue: 0,0:02:23.54,0:02:27.69,Default,,0,0,0,,Асгардиялықтар, гамма-сәулелердің массасы және гамма-сәулелерінің массасы бізге дыбыс жылдамдығынан жылдамырақ ұшып келеді.
Dialogue: 0,0:02:27.69,0:02:31.18,Default,,0,0,0,,Мен дұрыс жерге қона аламын ба деп алаңдаймын.
Dialogue: 0,0:02:31.18,0:02:33.38,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:42.29,0:02:45.17,Default,,0,0,0,,Неліктен Халктан дәл спутникті алуды сұрадыңыз?
Dialogue: 0,0:02:45.17,0:02:48.01,Default,,0,0,0,,Ей, мен міндетті түрде бұзылып қайтамын.
Dialogue: 0,0:02:48.01,0:02:50.05,Default,,0,0,0,,Өзіңіз айттыңыз.
Dialogue: 0,0:02:50.05,0:02:52.06,Default,,0,0,0,,Қалқанда барлығы Халк туралы айтады➡
Dialogue: 0,0:02:52.06,0:02:55.35,Default,,0,0,0,,Сіз қолыңыздан келетін жалғыз нәрсе - ұрып-соғу деп ойлайсыз.
Dialogue: 0,0:02:55.35,0:02:57.35,Default,,0,0,0,,Бұл оның басқаша екенін білдіре ме?
Dialogue: 0,0:02:57.35,0:02:59.69,Default,,0,0,0,,Халк қиратқан қабырғаны жөндеуге кететін шығын орасан.
Dialogue: 0,0:02:59.69,0:03:02.72,Default,,0,0,0,,Ашу мен аштық Халкты қозғайтын жалғыз нәрсе емес➡
Dialogue: 0,0:03:02.72,0:03:04.76,Default,,0,0,0,,Мен оны дәлелдеуге мүмкіндік алғым келеді.
Dialogue: 0,0:03:04.76,0:03:09.51,Default,,0,0,0,,Егер сіз сонша мылтық қуатын шығарсаңыз, аш қалуыңыз мүмкін.
Dialogue: 0,0:03:09.51,0:03:11.81,Default,,0,0,0,,Менің ішім дірілдеп тұрған сияқты.
Dialogue: 0,0:03:19.88,0:03:23.86,Default,,0,0,0,,Баяу, баяу орындаңыз
Dialogue: 0,0:03:23.86,0:03:25.86,Default,,0,0,0,,Керемет
Dialogue: 0,0:03:30.02,0:03:32.69,Default,,0,0,0,,Айттым ғой, басынан солай болды.
Dialogue: 0,0:03:32.69,0:03:36.36,Default,,0,0,0,,Кем дегенде, ол құлаған жоқ. Рахмет, Халк.
Dialogue: 0,0:03:36.36,0:03:40.03,Default,,0,0,0,,Кек алушылардың барлық байланысы бір спутник арқылы жүзеге асады ма?
Dialogue: 0,0:03:40.03,0:03:43.53,Default,,0,0,0,,Менің ойымша, бұл аздап қауіпті. Бұл дұрыс.
Dialogue: 0,0:03:43.53,0:03:48.13,Default,,0,0,0,,Сондықтан біз байланыс желілерін нығайту үшін дизайнды қайта қарастырамыз.
Dialogue: 0,0:03:51.04,0:03:54.88,Default,,0,0,0,,Сонымен, сіз фотондарды қуат үшін пайдаланасыз ба?
Dialogue: 0,0:03:54.88,0:03:57.68,Default,,0,0,0,,Мен фотонды пайдаланбаймын. Бұл жаман!
Dialogue: 0,0:04:01.28,0:04:03.68,Default,,0,0,0,,Ол дәнекерленген. Түсіңіз.
Dialogue: 0,0:04:06.87,0:04:10.21,Default,,0,0,0,,Бұл бомба. Түнгі сұңқар ма?
Dialogue: 0,0:04:10.21,0:04:12.69,Default,,0,0,0,,Маған қалдырыңыз. Мен жылдамырақпын.
Dialogue: 0,0:04:12.69,0:04:14.69,Default,,0,0,0,,Мен мықтымын
Dialogue: 0,0:04:17.18,0:04:20.50,Default,,0,0,0,,Гиперион? (Гиперион) Бастайық, Темір адам
Dialogue: 0,0:04:20.50,0:04:22.50,Default,,0,0,0,,«Кек алушылардың» соңы
Dialogue: 0,0:05:56.55,0:05:58.55,Default,,0,0,0,,Мұны маған қалдырыңыз.
Dialogue: 0,0:06:01.19,0:06:03.19,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:06:03.19,0:06:06.39,Default,,0,0,0,,Құшақтасуды ұнатпаймын, бірақ... (Гиперион) Арх!
Dialogue: 0,0:06:09.34,0:06:12.53,Default,,0,0,0,,Мен Hyperion-ты одан сайын жек көремін.
Dialogue: 0,0:06:12.53,0:06:15.52,Default,,0,0,0,,Бұл тәртіпсіздік
Dialogue: 0,0:06:15.52,0:06:17.50,Default,,0,0,0,,Нашар радио...
Dialogue: 0,0:06:17.50,0:06:19.92,Default,,0,0,0,,Халк Не істедің!
Dialogue: 0,0:06:19.92,0:06:24.38,Default,,0,0,0,,Бұл қауіпті жағдай болды. Рахмет сізге.
Dialogue: 0,0:06:24.38,0:06:26.91,Default,,0,0,0,,Бұл не туралы? Тағы барбекю?
Dialogue: 0,0:06:26.91,0:06:28.91,Default,,0,0,0,,Өткендегідей болғанын қаламаймын.
Dialogue: 0,0:06:30.85,0:06:34.54,Default,,0,0,0,,Бұл гиперион барлығын қытырлақ қоңырға дейін қуырады.
Dialogue: 0,0:06:34.54,0:06:36.84,Default,,0,0,0,,Сондықтан мен кештерді жек көремін.
Dialogue: 0,0:06:40.19,0:06:42.86,Default,,0,0,0,,Біздің базаға жалғыз келгеніңізге сене алар емеспін➡
Dialogue: 0,0:06:42.86,0:06:45.86,Default,,0,0,0,,Сіз менменсіз бе, әлде жай ғана ақымақсыз ба?
Dialogue: 0,0:06:45.86,0:06:50.06,Default,,0,0,0,,Мен сізге өз базаңызда қаншалықты тиімді екеніңізді көрсетейін, капитан.
Dialogue: 0,0:06:53.19,0:06:55.84,Default,,0,0,0,,Әңгімеңіз жеткілікті болды.
Dialogue: 0,0:06:55.84,0:06:57.86,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:06:57.86,0:07:09.34,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:09.34,0:07:11.39,Default,,0,0,0,,Бұл Гиперион ба?
Dialogue: 0,0:07:11.39,0:07:13.53,Default,,0,0,0,,Мен көп өсек естідім!
Dialogue: 0,0:07:13.53,0:07:15.63,Default,,0,0,0,,Бұл үлкен мәселе емес сияқты.
Dialogue: 0,0:07:21.03,0:07:23.03,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:07:25.07,0:07:27.17,Default,,0,0,0,,Бұл өлшем ұзаққа созылмайды!
Dialogue: 0,0:07:30.84,0:07:32.84,Default,,0,0,0,,ﾀｸｼｰ！
Dialogue: 0,0:07:32.84,0:07:34.84,Default,,0,0,0,,мотивацияң — мүлде басқаша болады ғой?
Dialogue: 0,0:07:37.02,0:07:40.52,Default,,0,0,0,,Сізде мақтаныш пен әдептілік жоқ!
Dialogue: 0,0:07:40.52,0:07:42.52,Default,,0,0,0,,Мейірім жоқ!
Dialogue: 0,0:07:42.52,0:07:52.50,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:52.50,0:07:54.85,Default,,0,0,0,,Жүр, аң!
Dialogue: 0,0:07:54.85,0:07:57.85,Default,,0,0,0,,Бұл әлі де жеткіліксіз.
Dialogue: 0,0:07:57.85,0:07:59.85,Default,,0,0,0,,Уау! (Hyperion) Өшірілген.
Dialogue: 0,0:08:05.28,0:08:08.01,Default,,0,0,0,,Бұл мұнара қашаннан бастап үлкен үйге айналды!?
Dialogue: 0,0:08:08.01,0:08:10.01,Default,,0,0,0,,ﾀﾜｰ ﾊﾟﾜｰﾀﾞｳﾝ
Dialogue: 0,0:08:13.18,0:08:16.34,Default,,0,0,0,,Бұл жаңа қорғаныс жүйесі. Ол әлі сынақ сатысында.
Dialogue: 0,0:08:16.34,0:08:18.51,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:08:18.51,0:08:20.68,Default,,0,0,0,,Бет-әлпетің мен екпінің—
Dialogue: 0,0:08:20.68,0:08:23.18,Default,,0,0,0,,Кек алушылардың қимылдарын түсінуге оңай.
Dialogue: 0,0:08:23.18,0:08:25.56,Default,,0,0,0,,Ал, бұл туралы не деуге болады?
Dialogue: 0,0:08:25.56,0:08:28.67,Default,,0,0,0,,Бәрі де соңғы кездескеніміздей емес.
Dialogue: 0,0:08:28.67,0:08:30.87,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:08:33.02,0:08:35.84,Default,,0,0,0,,Аридің жеңіске жету мүмкіндігі бар, Hyperion!
Dialogue: 0,0:08:35.84,0:08:41.50,Default,,0,0,0,,Уау! Апыр-ай...!
Dialogue: 0,0:08:41.50,0:08:43.52,Default,,0,0,0,,Мені бұл жерден кетіріңіз!
Dialogue: 0,0:08:43.52,0:08:45.85,Default,,0,0,0,,Шайқас әлі аяқталған жоқ!
Dialogue: 0,0:08:45.85,0:08:47.85,Default,,0,0,0,,Мен...!
Dialogue: 0,0:08:50.71,0:08:53.53,Default,,0,0,0,,Әй, Алидің жеңіске жету мүмкіндігі қандай деп ойлайсың?
Dialogue: 0,0:08:53.53,0:08:55.66,Default,,0,0,0,,Бөлісуге көбірек жаттығу керек.
Dialogue: 0,0:08:55.66,0:08:57.66,Default,,0,0,0,,Хахаха не?
Dialogue: 0,0:08:57.66,0:09:00.18,Default,,0,0,0,,Мен бөлісуге дағдылануға мүмкіндік жоқ!
Dialogue: 0,0:09:00.18,0:09:02.35,Default,,0,0,0,,Бір ісім болса, мына жігіттің аузынан шығады➡
Dialogue: 0,0:09:02.35,0:09:04.70,Default,,0,0,0,,Ең алыс жерді табыңыз
Dialogue: 0,0:09:04.70,0:09:08.04,Default,,0,0,0,,Эй, Хоки, мұндай қарапайым мысқыл сөздерді айтпа!
Dialogue: 0,0:09:08.04,0:09:10.04,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:09:12.03,0:09:14.33,Default,,0,0,0,,Әу бастан осылай болды демеңіз.
Dialogue: 0,0:09:16.68,0:09:20.19,Default,,0,0,0,,Байланыс спутнигі Nighthawk-тан бомба алады.
Dialogue: 0,0:09:20.19,0:09:23.34,Default,,0,0,0,,Сол кезде менің жауым, бөтен адам пайда болды.
Dialogue: 0,0:09:23.34,0:09:25.84,Default,,0,0,0,,Қызық, Жоғарғы эскадрилья келе ме?
Dialogue: 0,0:09:25.84,0:09:27.84,Default,,0,0,0,,Найтхоуктың мақсаты қандай?
Dialogue: 0,0:09:27.84,0:09:31.85,Default,,0,0,0,,Мұны назардан тыс қалдырмаңыз. Достарымды сатамын деп ойлайсың ба?
Dialogue: 0,0:09:31.85,0:09:34.52,Default,,0,0,0,,О, мен солай ойлаймын.
Dialogue: 0,0:09:34.52,0:09:36.87,Default,,0,0,0,,Соңғы рет эскадрильялар жиналды➡
Dialogue: 0,0:09:36.87,0:09:41.51,Default,,0,0,0,,Біз «Кек алушылардың» бар екенін өшіріп тастадық!
Dialogue: 0,0:09:41.51,0:09:44.34,Default,,0,0,0,,Бұл қыздыру жаттығулары.
Dialogue: 0,0:09:44.34,0:09:48.21,Default,,0,0,0,,Қараңызшы, соңғы Falcon Mama печеньесі
Dialogue: 0,0:09:48.21,0:09:51.53,Default,,0,0,0,,Сіз сондай-ақ Халкты ашуландырасыз, ол сізді қуып жетеді.
Dialogue: 0,0:09:51.53,0:09:53.90,Default,,0,0,0,,Тіпті сіз ұрыста әріптестеріңізді токқа жібердіңіз➡
Dialogue: 0,0:09:53.90,0:09:55.90,Default,,0,0,0,,Бұл сізді ашуландырады, солай ма?
Dialogue: 0,0:09:59.34,0:10:01.54,Default,,0,0,0,,Мен печеньеден шаршадым
Dialogue: 0,0:10:04.91,0:10:06.85,Default,,0,0,0,,Мен осындамын деп сен тым қобалжыдың.
Dialogue: 0,0:10:06.85,0:10:08.85,Default,,0,0,0,,Мен үнемі ұрып-соға бермеймін
Dialogue: 0,0:10:10.85,0:10:13.02,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:13.02,0:10:15.51,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:15.51,0:10:17.51,Default,,0,0,0,,Қашып кеткенің жөн. (Сұңқар көз) Уау!
Dialogue: 0,0:10:17.51,0:10:20.18,Default,,0,0,0,,Тоқта! Уф!
Dialogue: 0,0:10:20.18,0:10:23.85,Default,,0,0,0,,Сүтті қашан жақсы көре бастадыңыз?
Dialogue: 0,0:10:23.85,0:10:26.17,Default,,0,0,0,,Сүт сүйектеріңізді берік етеді!
Dialogue: 0,0:10:26.17,0:10:28.35,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:10:28.35,0:10:30.85,Default,,0,0,0,,А, не?
Dialogue: 0,0:10:35.51,0:10:37.51,Default,,0,0,0,,Не, жанкүйер?
Dialogue: 0,0:10:39.53,0:10:42.52,Default,,0,0,0,,Мені құтқарғаныңызға рахмет!
Dialogue: 0,0:10:42.52,0:10:44.52,Default,,0,0,0,,Ұстап көріңіз!
Dialogue: 0,0:10:47.34,0:10:50.19,Default,,0,0,0,,А, бұл менің кінәм емес! Мен емес!
Dialogue: 0,0:10:50.19,0:10:54.33,Default,,0,0,0,,41-қабаттағы Jarvis жөндеу роботы. Халк мұны қайтадан жасады.
Dialogue: 0,0:10:54.33,0:10:56.33,Default,,0,0,0,,Гиперион дұрыс.
Dialogue: 0,0:10:56.33,0:10:58.35,Default,,0,0,0,,Бұл желдеткішпен ойнайтын уақыт емес.
Dialogue: 0,0:10:58.35,0:11:01.35,Default,,0,0,0,,Зорлық-зомбылықты доғар. Бірақ бұл менің кінәм емес!
Dialogue: 0,0:11:01.35,0:11:04.87,Default,,0,0,0,,Hyperion-ды қуып жіберейік. Avenget бортына шығыңыз.
Dialogue: 0,0:11:04.87,0:11:07.91,Default,,0,0,0,,Күрсін... маған ешкім сенбейді.
Dialogue: 0,0:11:07.91,0:11:10.51,Default,,0,0,0,,Уф! Ой...
Dialogue: 0,0:11:10.51,0:11:13.35,Default,,0,0,0,,О... иә?
Dialogue: 0,0:11:13.35,0:11:15.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:18.04,0:11:26.18,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:26.18,0:11:29.16,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:11:29.16,0:11:31.17,Default,,0,0,0,,Не?
Dialogue: 0,0:11:31.17,0:11:33.18,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:11:33.18,0:11:35.35,Default,,0,0,0,,Уайымдама, дүние тоқтаған жоқ.
Dialogue: 0,0:11:35.35,0:11:37.36,Default,,0,0,0,,Мен сені жылдамырақ еттім.
Dialogue: 0,0:11:37.36,0:11:39.34,Default,,0,0,0,,Бұл әдейі жасалған жоқ. Бірақ мұндай күш➡
Dialogue: 0,0:11:39.34,0:11:42.24,Default,,0,0,0,,Ол дайын сияқты. Жылдамдық демон?
Dialogue: 0,0:11:42.24,0:11:46.01,Default,,0,0,0,,Nighthawk-тан қуат алғаннан кейін ол осылай бола бастады.
Dialogue: 0,0:11:46.01,0:11:49.35,Default,,0,0,0,,Менің қимылымды ешкім көре алмайды. Ол жылдамдық уақыты деп аталады.
Dialogue: 0,0:11:49.35,0:11:52.52,Default,,0,0,0,,Олай болса, мен сізге Smash Time көрсетемін.
Dialogue: 0,0:11:52.52,0:11:55.51,Default,,0,0,0,,Жақсы, жоғары немесе төмен.
Dialogue: 0,0:11:55.51,0:11:58.19,Default,,0,0,0,,Уау! Тым кеш хаха!
Dialogue: 0,0:11:58.19,0:12:00.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:00.51,0:12:03.55,Default,,0,0,0,,Ой, бұл ұят болды. Night Hawk➡ күшімен
Dialogue: 0,0:12:03.55,0:12:05.58,Default,,0,0,0,,Мен сені өте жылдам ете алсам➡
Dialogue: 0,0:12:05.58,0:12:07.85,Default,,0,0,0,,Тіпті сіздің өміріңіз өте жоғары жылдамдықпен аяқталады➡
Dialogue: 0,0:12:07.85,0:12:11.55,Default,,0,0,0,,Сіз мұны істей алуыңыз керек. Апыр-ай!
Dialogue: 0,0:13:13.62,0:13:16.50,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:13:16.50,0:13:19.86,Default,,0,0,0,,Уау... уф...
Dialogue: 0,0:13:19.86,0:13:23.51,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:13:23.51,0:13:25.53,Default,,0,0,0,,ｱｲｱﾝﾏﾝ！
Dialogue: 0,0:13:25.53,0:13:27.83,Default,,0,0,0,,Айттым ғой, жылдам екен, оны ешкім көрмейді➡
Dialogue: 0,0:13:27.83,0:13:30.18,Default,,0,0,0,,Даусыңды да естімеймін. Уф!
Dialogue: 0,0:13:30.18,0:13:32.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:32.35,0:13:35.05,Default,,0,0,0,,ше? Бұл не, Джарвис?
Dialogue: 0,0:13:37.86,0:13:40.86,Default,,0,0,0,,Шайқас кезінде Халктың сенің жаныңда болуы сенімділік береді➡
Dialogue: 0,0:13:40.86,0:13:42.83,Default,,0,0,0,,Осылай жарылып кете берсең➡
Dialogue: 0,0:13:42.83,0:13:45.87,Default,,0,0,0,,Мен қатты қиналып отырмын. Бұл рас, бірақ➡
Dialogue: 0,0:13:45.87,0:13:47.90,Default,,0,0,0,,Бұл жолы басқаша➡
Dialogue: 0,0:13:47.90,0:13:50.04,Default,,0,0,0,,Бұл Халкпен болған болуы мүмкін.
Dialogue: 0,0:13:50.04,0:13:52.69,Default,,0,0,0,,Hyperion қашып кетуіне жол бергенде, сіз не істеп жатырсыз?
Dialogue: 0,0:13:52.69,0:13:54.89,Default,,0,0,0,,Ой! (дабыл)
Dialogue: 0,0:13:57.85,0:13:59.85,Default,,0,0,0,,Басқару элементтері жұмыс істемейді!
Dialogue: 0,0:13:59.85,0:14:02.02,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:14:02.02,0:14:05.90,Default,,0,0,0,,Гиперион желдің екпінін тудырады!
Dialogue: 0,0:14:05.90,0:14:08.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:08.52,0:14:11.62,Default,,0,0,0,,Мен сенің қимылыңды көремін дедім!
Dialogue: 0,0:14:14.66,0:14:17.33,Default,,0,0,0,,Уау! Мен оны сындырамын
Dialogue: 0,0:14:17.33,0:14:20.02,Default,,0,0,0,,Қолын тигізбесе болмайды. Апыр-ай!
Dialogue: 0,0:14:20.02,0:14:22.50,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:14:22.50,0:14:24.60,Default,,0,0,0,,♬~
Dialogue: 0,0:14:28.53,0:14:32.01,Default,,0,0,0,,Хахаха... Маған не істедің?
Dialogue: 0,0:14:32.01,0:14:34.18,Default,,0,0,0,,Бұлай болмауы керек еді.
Dialogue: 0,0:14:34.18,0:14:36.37,Default,,0,0,0,,Хмм, шын мәнінде, сіз жаңа ғана жоғалып кеттіңіз➡
Dialogue: 0,0:14:36.37,0:14:39.85,Default,,0,0,0,,Бұл үйілген қоқыс болуы керек еді. (Халк) Халк энергияны жасайды
Dialogue: 0,0:14:39.85,0:14:43.36,Default,,0,0,0,,Энергия жойылмайды. Жоқ.
Dialogue: 0,0:14:43.36,0:14:45.84,Default,,0,0,0,,Ал, кері санақты бастайық, Ганма-кун.
Dialogue: 0,0:14:45.84,0:14:47.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:47.85,0:14:50.01,Default,,0,0,0,,Ол қайтадан жойылуда. Неліктен?
Dialogue: 0,0:14:50.01,0:14:54.39,Default,,0,0,0,,Джарвис Халктың іздерін іздеңіз.
Dialogue: 0,0:14:54.39,0:14:57.94,Default,,0,0,0,,Мен оны қарап шықтым, бірақ нәтижелер түсініксіз.
Dialogue: 0,0:14:57.94,0:15:00.86,Default,,0,0,0,,Tell me. (Джарвис) Старк мырзаның айналасындағы адамдар➡
Dialogue: 0,0:15:00.86,0:15:04.35,Default,,0,0,0,,Халк энергиясына толы. Басқаша айтқанда, ол Халкпен қоршалған.
Dialogue: 0,0:15:04.35,0:15:08.80,Default,,0,0,0,,To Hulk? Бұл нені білдіретінін түсінбеймін.
Dialogue: 0,0:15:08.80,0:15:12.35,Default,,0,0,0,,Сонымен қатар, мұнара ішіндегі гамма-сәулелену қауіпті деңгейге жетті.
Dialogue: 0,0:15:12.35,0:15:16.15,Default,,0,0,0,,Ха, Халк, сен не істедің?
Dialogue: 0,0:15:18.19,0:15:23.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:23.20,0:15:26.10,Default,,0,0,0,,Уау! Ой...
Dialogue: 0,0:15:28.00,0:15:32.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:32.51,0:15:35.39,Default,,0,0,0,,Мен сауытымды жаңа ғана тазаласам да.
Dialogue: 0,0:15:35.39,0:15:37.68,Default,,0,0,0,,Алдымен спутник, енді мынау?
Dialogue: 0,0:15:37.68,0:15:42.67,Default,,0,0,0,,Гиперионды басып алған капсула да жойылып, Гунма деңгейі күрт көтерілді.
Dialogue: 0,0:15:42.67,0:15:45.69,Default,,0,0,0,,Көрінбейтін жарылыс
Dialogue: 0,0:15:45.69,0:15:47.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:47.69,0:15:52.03,Default,,0,0,0,,Бұл мен күткеннен әлдеқайда қызықты хахаха...
Dialogue: 0,0:15:52.03,0:15:54.70,Default,,0,0,0,,Джарвис қайта сканерлеу.
Dialogue: 0,0:15:54.70,0:15:57.90,Default,,0,0,0,,Сүзгіні қосыңыз Мен гамма сәулелерінің спектрін көргім келеді
Dialogue: 0,0:16:02.34,0:16:04.34,Default,,0,0,0,,О
Dialogue: 0,0:16:11.86,0:16:14.66,Default,,0,0,0,,Ха, деректер тезірек қозғалса екен.
Dialogue: 0,0:16:17.52,0:16:19.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:25.18,0:16:27.85,Default,,0,0,0,,Бұл аяқталды! Хахаха...
Dialogue: 0,0:16:27.85,0:16:31.17,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:31.17,0:16:35.00,Default,,0,0,0,,Жылдам жын бар...
Dialogue: 0,0:16:35.00,0:16:37.51,Default,,0,0,0,,Уау! Бұл қызықсыз
Dialogue: 0,0:16:37.51,0:16:40.88,Default,,0,0,0,,Екеуміздің арамызда құпия болсын.
Dialogue: 0,0:16:40.88,0:16:44.20,Default,,0,0,0,,Халк бірдеңені жеткізуге тырысады
Dialogue: 0,0:16:44.20,0:16:47.90,Default,,0,0,0,,Артқа айналдыру және баяу ойнату. Тыңда.
Dialogue: 0,0:16:51.19,0:16:57.19,Default,,0,0,0,,Уф…
Dialogue: 0,0:17:01.50,0:17:03.85,Default,,0,0,0,,(Ескерту)
Dialogue: 0,0:17:03.85,0:17:06.70,Default,,0,0,0,,Кенет құлауға дайындалыңыз. Мен сені қайта тұрғызамын.
Dialogue: 0,0:17:06.70,0:17:14.18,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:14.18,0:17:18.68,Default,,0,0,0,,Ха, әрине, сен, найзағай құдайы, ондай емессің, солай ма?
Dialogue: 0,0:17:18.68,0:17:22.02,Default,,0,0,0,,Бұл дұрыс емес. Сіздің жағымсыз иісіңіз мені қатты жаман сезінді.
Dialogue: 0,0:17:22.02,0:17:29.17,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:29.17,0:17:32.03,Default,,0,0,0,,(Ескерту)
Dialogue: 0,0:17:32.03,0:17:37.06,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:37.06,0:17:42.54,Default,,0,0,0,,Сіздің қорқақтығыңызды ұрыс-керіссіз құйынға түсіріп, дәлелдеді.
Dialogue: 0,0:17:42.54,0:17:46.39,Default,,0,0,0,,Егер сіз оны мұздатып алсаңыз, ұрысудың қажеті жоқ!
Dialogue: 0,0:17:46.39,0:17:50.49,Default,,0,0,0,,Уау! Ахахха!
Dialogue: 0,0:17:50.49,0:17:53.85,Default,,0,0,0,,Жылдам жын бар
Dialogue: 0,0:17:53.85,0:17:56.53,Default,,0,0,0,,Уау! Жылдамдық демон?
Dialogue: 0,0:17:56.53,0:17:59.33,Default,,0,0,0,,JARVIS Оны келесі кадрға жіберіңіз. (ДЖАРВИС) Мен түсінемін.
Dialogue: 0,0:18:05.33,0:18:10.18,Default,,0,0,0,,Халкты үлкейту
Dialogue: 0,0:18:10.18,0:18:12.53,Default,,0,0,0,,Гамма сәулеленуі үдеуде
Dialogue: 0,0:18:12.53,0:18:14.69,Default,,0,0,0,,Гамма бомбасына айналған сияқты.
Dialogue: 0,0:18:14.69,0:18:18.86,Default,,0,0,0,,Біз энергияны қандай да бір жолмен босатудың жолын табуымыз керек➡
Dialogue: 0,0:18:18.86,0:18:21.16,Default,,0,0,0,,Нью-Йорк таң қалды
Dialogue: 0,0:18:28.78,0:18:32.52,Default,,0,0,0,,Сіз өте баяусыз. Асықшы!
Dialogue: 0,0:18:32.52,0:18:36.89,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:18:36.89,0:18:39.39,Default,,0,0,0,,(ысқырық)
Dialogue: 0,0:18:47.35,0:18:50.72,Default,,0,0,0,,Уау, қарулы бомба орнату соншалықты қиын екеніне сене алар емеспін.
Dialogue: 0,0:18:50.72,0:18:53.27,Default,,0,0,0,,Көңілді болды, бірақ мен терлеп кеттім.
Dialogue: 0,0:18:53.27,0:18:55.88,Default,,0,0,0,,Мен терлеуді жек көремін
Dialogue: 0,0:18:55.88,0:19:02.58,Default,,0,0,0,,Бұл жаман және жарылып кетеді! Апыр-ай!!
Dialogue: 0,0:20:04.53,0:20:08.18,Default,,0,0,0,,Джарвис Халк пен Speed ​​Demon қазір қайда екенін білесіз бе?
Dialogue: 0,0:20:08.18,0:20:11.57,Default,,0,0,0,,Жоқ, оларды қадағалау өте жылдам.
Dialogue: 0,0:20:11.57,0:20:15.67,Default,,0,0,0,,Алайда Халктың гамма-сәулелері тез өсуде.
Dialogue: 0,0:20:15.67,0:20:17.68,Default,,0,0,0,,Жаман нәрсе болды.
Dialogue: 0,0:20:17.68,0:20:20.68,Default,,0,0,0,,Мен сені таба алмасам, құтқара алмаймын.
Dialogue: 0,0:20:20.68,0:20:24.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:24.70,0:20:26.85,Default,,0,0,0,,Әлі емес... әлі
Dialogue: 0,0:20:26.85,0:20:29.85,Default,,0,0,0,,Содан кейін көбірек шабуыл жасаңыз... Уау!
Dialogue: 0,0:20:29.85,0:20:32.02,Default,,0,0,0,,Мен істеймін... Әй, қайда барасың?
Dialogue: 0,0:20:32.02,0:20:36.82,Default,,0,0,0,,♬~
Dialogue: 0,0:20:40.01,0:20:43.85,Default,,0,0,0,,Джарвис түсіндім. Халк оны жойып жатқан жоқ.
Dialogue: 0,0:20:43.85,0:20:48.34,Default,,0,0,0,,Іздерді қалдыру
Dialogue: 0,0:20:48.34,0:20:52.36,Default,,0,0,0,,Сіз қайда барасыз? Тікұшақ айлағы?
Dialogue: 0,0:20:52.36,0:20:57.68,Default,,0,0,0,,Бұл стаз өрісінің генераторы ма? Халк: Сен данышпансың!
Dialogue: 0,0:20:57.68,0:21:02.34,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:21:02.34,0:21:04.67,Default,,0,0,0,,Бұл тығырық, Халк.
Dialogue: 0,0:21:04.67,0:21:07.69,Default,,0,0,0,,♬~
Dialogue: 0,0:21:07.69,0:21:11.25,Default,,0,0,0,,Мен оңай жеңілемін бе?
Dialogue: 0,0:21:11.25,0:21:15.00,Default,,0,0,0,,Егер сіз оны жеңгіңіз келсе, оны мүмкіндігінше қатты соққыңыз.
Dialogue: 0,0:21:15.00,0:21:17.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:21:21.67,0:21:24.51,Default,,0,0,0,,Кез келген уақыт жақсы, Халк.
Dialogue: 0,0:21:24.51,0:21:27.66,Default,,0,0,0,,Мен сені ақылдырақ деп ойладым. Енді берілесің бе?
Dialogue: 0,0:21:27.66,0:21:33.50,Default,,0,0,0,,Қызық емес пе? Оны сындырып көріңіз.
Dialogue: 0,0:21:33.50,0:21:38.36,Default,,0,0,0,,Мен жай ғана ұрып-соғып тұрған жоқпын
Dialogue: 0,0:21:38.36,0:21:40.86,Default,,0,0,0,,Қараңдар, күліңдер. Апыр-ай!
Dialogue: 0,0:21:47.18,0:21:49.85,Default,,0,0,0,,О, сен әдемісің. Сіз мені қуантуға тырысасыз ба?
Dialogue: 0,0:21:49.85,0:21:52.55,Default,,0,0,0,,Сізді тоқтату үшін
Dialogue: 0,0:21:56.86,0:21:59.51,Default,,0,0,0,,Жылдамдыққа қалай жетуге болады? сен енді жылдам емессің
Dialogue: 0,0:21:59.51,0:22:04.67,Default,,0,0,0,,Бұл құрылғының көмегімен сіз бізбен бірдей жылдамдыққа ие болдыңыз.
Dialogue: 0,0:22:04.67,0:22:09.00,Default,,0,0,0,,Жылдамдықты арттыратын белдік! Сен бұздың!
Dialogue: 0,0:22:09.00,0:22:12.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:12.67,0:22:15.36,Default,,0,0,0,,Стаз өрісін қолданған дұрыс.
Dialogue: 0,0:22:15.36,0:22:18.35,Default,,0,0,0,,Рахмет. Бірақ гамма сызығы төмендемейді.
Dialogue: 0,0:22:18.35,0:22:21.83,Default,,0,0,0,,Жылдамдықта жарылыс болғанға дейін бірнеше секунд қана қалды.
Dialogue: 0,0:22:21.83,0:22:24.00,Default,,0,0,0,,Бірақ қазір бізде көп минуттар бар
Dialogue: 0,0:22:24.00,0:22:28.17,Default,,0,0,0,,Ух... қош бол, бомба
Dialogue: 0,0:22:28.17,0:22:30.84,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:22:30.84,0:22:34.85,Default,,0,0,0,,Speed Demon тіпті белбеусіз менің сауытыма қарағанда жылдам
Dialogue: 0,0:22:34.85,0:22:36.85,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:22:36.85,0:22:39.35,Default,,0,0,0,,Біз энергияны шығаруымыз керек, солай ма?
Dialogue: 0,0:22:39.35,0:22:42.17,Default,,0,0,0,,Дұрыс, бұл физика негіздері...
Dialogue: 0,0:22:42.17,0:22:44.17,Default,,0,0,0,,Бұл заң.
Dialogue: 0,0:22:44.17,0:22:52.83,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:52.83,0:22:55.52,Default,,0,0,0,,Эй, жай ғана жарыл!
Dialogue: 0,0:22:55.52,0:22:59.35,Default,,0,0,0,,Сен неге мені әлі қуып жүрсің! Ой... хмм!
Dialogue: 0,0:22:59.35,0:23:02.51,Default,,0,0,0,,Мен күн сайын энергиямды бақылаймын.
Dialogue: 0,0:23:02.51,0:23:07.46,Default,,0,0,0,,Менен аулақ жүр!
Dialogue: 0,0:23:07.46,0:23:12.52,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:12.52,0:23:15.85,Default,,0,0,0,,Эй, Hyperion, сен маған көмектесе аласың ба? Өтінемін жауап беріңіз
Dialogue: 0,0:23:15.85,0:23:28.18,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:28.18,0:23:30.35,Default,,0,0,0,,Жынның жылдам жауабы! мен...
Dialogue: 0,0:23:30.35,0:23:32.35,Default,,0,0,0,,Маған көмектес, маған көмектес, маған көмектес...
Dialogue: 0,0:23:32.35,0:23:34.35,Default,,0,0,0,,аянышты дауыс шығармаңыз! Апыр-ай!
Dialogue: 0,0:23:34.35,0:23:44.68,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:44.68,0:23:47.52,Default,,0,0,0,,Жасыл шам жаңа ғана бөтелкеге ұқсады➡
Dialogue: 0,0:23:47.52,0:23:51.21,Default,,0,0,0,,Бұлай болуы мүмкін емес, солай ма?
Dialogue: 0,0:23:51.21,0:23:54.68,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:54.68,0:23:58.38,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:24:00.70,0:24:04.85,Default,,0,0,0,,Бұл көп күш жұмсады, өйткені мен мұны қалай істеу керектігін білемін.
Dialogue: 0,0:24:04.85,0:24:09.17,Default,,0,0,0,,Ха, ақыры күресуге тұрарлық адам пайда болды ма?
Dialogue: 0,0:24:09.17,0:24:16.85,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:16.85,0:24:19.68,Default,,0,0,0,,Кел, жат планеталық!
Dialogue: 0,0:24:19.68,0:24:25.36,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:25.36,0:24:27.36,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,0:24:27.36,0:24:29.34,Default,,0,0,0,,(енеді)
Dialogue: 0,0:24:29.34,0:24:32.33,Default,,0,0,0,,Неге мүлде жауап бермейсіз?
Dialogue: 0,0:24:32.33,0:24:35.18,Default,,0,0,0,,Ашуымды жинақтау үшін!
Dialogue: 0,0:24:35.18,0:24:37.18,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,0:24:37.18,0:24:39.19,Default,,0,0,0,,Жаман!
Dialogue: 0,0:24:39.19,0:24:45.68,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:45.68,0:24:47.69,Default,,0,0,0,,ﾊﾙｸ！
Dialogue: 0,0:24:47.69,0:24:49.70,Default,,0,0,0,,Бұл...
Dialogue: 0,0:24:49.70,0:24:57.52,Default,,0,0,0,,♪♪～
Dialogue: 0,0:24:57.52,0:24:59.51,Default,,0,0,0,,Ұйықтау уақыты келді
Dialogue: 0,0:24:59.51,0:25:06.45,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:06.45,0:25:08.52,Default,,0,0,0,,А... мынау ауыр жігіт екен.
Dialogue: 0,0:25:08.52,0:25:10.52,Default,,0,0,0,,Халк өлтірді
Dialogue: 0,0:25:10.52,0:25:14.56,Default,,0,0,0,,Мен мұны жер бетіндегі барлық адамдар естігенін білемін.
Dialogue: 0,0:25:14.56,0:25:16.57,Default,,0,0,0,,Тапсырма орындалды ма?
Dialogue: 0,0:25:16.57,0:25:20.84,Default,,0,0,0,,Әрине, қараңдар, бұл «Кек алушылардың» негізгі деректерінің көшірмесі.
Dialogue: 0,0:25:20.84,0:25:24.16,Default,,0,0,0,,Мм, бәрі жоспар бойынша жүріп жатыр.
Dialogue: 0,0:25:24.16,0:25:27.84,Default,,0,0,0,,(Халктың ырылдауы)
Dialogue: 0,0:25:27.84,0:25:30.00,Default,,0,0,0,,(есіктің ашылу дыбысы)
Dialogue: 0,0:25:30.00,0:25:32.69,Default,,0,0,0,,Стресстен құтылу!
Dialogue: 0,0:25:32.69,0:25:36.04,Default,,0,0,0,,Мойындау көңілсіз, бірақ мен қателесіппін.
Dialogue: 0,0:25:36.04,0:25:38.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:38.08,0:25:40.60,Default,,0,0,0,,Мен саған сенуім керек еді.
Dialogue: 0,0:25:40.60,0:25:42.50,Default,,0,0,0,,Мен үйреніп қалдым
Dialogue: 0,0:25:42.50,0:25:45.02,Default,,0,0,0,,Жоқ, бұл жақсы емес.
Dialogue: 0,0:25:45.02,0:25:48.19,Default,,0,0,0,,Кейде мен шындықты көре алмаймын
Dialogue: 0,0:25:48.19,0:25:51.18,Default,,0,0,0,,Егер бірдеңе болып жатса, пікіріңіз болса, маған хабарлаңыз.
Dialogue: 0,0:25:51.18,0:25:53.68,Default,,0,0,0,,Келесі жолы міндетті түрде тыңдаймын
Dialogue: 0,0:25:53.68,0:25:55.70,Default,,0,0,0,,О!
Dialogue: 0,0:25:55.70,0:25:58.02,Default,,0,0,0,,Менің айтарым бар. Жоқ?
Dialogue: 0,0:25:58.02,0:26:00.20,Default,,0,0,0,,Сүт жеткіліксіз
Dialogue: 0,0:26:00.20,0:26:02.60,Default,,0,0,0,,Қазір дайындалыңыз
Dialogue: 0,0:26:35.52,0:26:37.52,Default,,0,0,0,,<“Кек алушылар жиналуда”➡ пайда болады
Dialogue: 0,0:26:37.52,0:26:39.69,Default,,0,0,0,,Супер қаһармандар, жауыздар және т.б. туралы ақпарат➡
Dialogue: 0,0:26:39.69,0:26:42.11,Default,,0,0,0,,Осы жерде жинаңыз
Dialogue: 0,0:26:42.11,0:26:44.68,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:44.68,0:26:47.01,Default,,0,0,0,,Басқа өлшемдегі батырлар командасы ➡
Dialogue: 0,0:26:47.01,0:26:49.18,Default,,0,0,0,,Жоғарғы эскадрильяның мүшесі
Dialogue: 0,0:26:49.18,0:26:51.67,Default,,0,0,0,,Адамнан жоғары жылдамдыққа төзімділік➡
Dialogue: 0,0:26:51.67,0:26:53.84,Default,,0,0,0,,Және рефлекстеріңізбен мақтаныңыз➡
Dialogue: 0,0:26:53.84,0:26:55.84,Default,,0,0,0,,Қабырғаға жүгіру➡
Dialogue: 0,0:26:55.84,0:26:57.82,Default,,0,0,0,,Суда жүгіру➡
Dialogue: 0,0:26:57.82,0:27:00.52,Default,,0,0,0,,Шеңбер бойымен жүгіру арқылы құйын жасауға болады! ＞
Dialogue: 0,0:27:02.02,0:27:08.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
