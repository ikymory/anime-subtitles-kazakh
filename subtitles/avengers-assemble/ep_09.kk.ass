Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:38.66,0:00:40.96,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.16,0:00:47.15,Default,,0,0,0,,<Кек алушылар Бұл супер қаһармандар →
Dialogue: 0,0:00:47.15,0:00:51.12,Default,,0,0,0,,Жиналған ең күшті батырлар командасы
Dialogue: 0,0:00:51.12,0:00:54.19,Default,,0,0,0,,Өзіңіздің керемет күшіңізді жинаңыз және жердің тыныштығын қорғаңыз! ＞
Dialogue: 0,0:00:54.19,0:00:56.47,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:56.47,0:00:58.64,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:58.64,0:01:01.15,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:01.15,0:01:03.15,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:03.15,0:01:05.22,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:05.22,0:01:07.22,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:09.10,0:01:11.61,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:11.61,0:01:14.68,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:14.68,0:01:16.73,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:16.73,0:01:18.61,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:18.61,0:01:20.61,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:37.67,0:01:44.29,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:01:44.29,0:01:46.69,Default,,0,0,0,,Маған біреу көмектессін!
Dialogue: 0,0:01:54.82,0:01:58.32,Default,,0,0,0,,Амансың ба? Мұндай жерде тұру қауіпті
Dialogue: 0,0:02:00.30,0:02:03.50,Default,,0,0,0,,Гиперион – менің кейіпкерім.
Dialogue: 0,0:02:05.63,0:02:08.13,Default,,0,0,0,,Әй, қандай сүйкімді ит.
Dialogue: 0,0:02:11.15,0:02:14.30,Default,,0,0,0,,Қалған роботтарды осы күлімсіреу арқылы жеңуді жоспарлайсыз ба? Гиперион
Dialogue: 0,0:02:14.30,0:02:17.00,Default,,0,0,0,,Миссия аяқталғанша зейініңізді шоғырландырыңыз.
Dialogue: 0,0:02:22.78,0:02:24.76,Default,,0,0,0,,Мен сіздің атыңызға назар аударамын.
Dialogue: 0,0:02:24.76,0:02:28.13,Default,,0,0,0,,Мен мынаны аламын!
Dialogue: 0,0:02:28.13,0:02:31.93,Default,,0,0,0,,Жарайсың, Салда. Бірақ бұл нағыз күш.
Dialogue: 0,0:02:34.62,0:02:37.72,Default,,0,0,0,,Тыңда, Спектр, мен саған шынайы күшімді көрсетемін.
Dialogue: 0,0:02:48.70,0:02:51.62,Default,,0,0,0,,Рахмет, керемет эскадрилья!
Dialogue: 0,0:02:51.62,0:02:54.96,Default,,0,0,0,,Жоғарғы эскадрильяның қолында бұл оңай жеңіс болар еді.
Dialogue: 0,0:02:54.96,0:02:58.01,Default,,0,0,0,,Өйткені ол жер бетіндегі ең күшті батыр.
Dialogue: 0,0:02:58.01,0:03:00.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:00.05,0:03:04.64,Default,,0,0,0,,Олар жеңілгендерін түсінбейтін сияқты.
Dialogue: 0,0:03:04.64,0:03:07.14,Default,,0,0,0,,Hyperion Тоқта!
Dialogue: 0,0:03:12.61,0:03:15.61,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:03:15.61,0:03:17.62,Default,,0,0,0,,ｷｬｰ！
Dialogue: 0,0:03:17.62,0:03:20.12,Default,,0,0,0,,Темір адам! Әрине
Dialogue: 0,0:03:20.12,0:03:22.62,Default,,0,0,0,,Сіз кімді күттіңіз? Батыр?
Dialogue: 0,0:04:44.65,0:04:46.65,Default,,0,0,0,,Роботтың алаяқ екенін қалай түсіне алмайсың?
Dialogue: 0,0:04:46.65,0:04:50.62,Default,,0,0,0,,Жердің ең құдіретті қаһарманы ең ақылды емес екен.
Dialogue: 0,0:04:50.62,0:04:52.64,Default,,0,0,0,,...
Dialogue: 0,0:04:52.64,0:04:55.50,Default,,0,0,0,,Жылдамдық жын. Маған қалдырыңыз.
Dialogue: 0,0:04:55.50,0:04:59.00,Default,,0,0,0,,Байқадым, электронды тордың дизайнында ақау бар сияқты.
Dialogue: 0,0:05:05.81,0:05:07.81,Default,,0,0,0,,Беріңіз! Апыр-ай!
Dialogue: 0,0:05:10.98,0:05:12.96,Default,,0,0,0,,Уа. Алақай!
Dialogue: 0,0:05:12.96,0:05:16.87,Default,,0,0,0,,Ой
Dialogue: 0,0:05:16.87,0:05:19.90,Default,,0,0,0,,Неліктен бұл дүниеде жауыздар көп?➡
Dialogue: 0,0:05:19.90,0:05:22.62,Default,,0,0,0,,Мен оны мүлдем түсінбеймін. Ах!
Dialogue: 0,0:05:22.62,0:05:24.64,Default,,0,0,0,,ﾄﾆｰ･ｽﾀｰｸ
Dialogue: 0,0:05:24.64,0:05:28.66,Default,,0,0,0,,Тони Старк - қорқақ. Оны жең!
Dialogue: 0,0:05:28.66,0:05:31.26,Default,,0,0,0,,Осы жерден аяқтаймыз.
Dialogue: 0,0:05:34.15,0:05:36.99,Default,,0,0,0,,Менің қашып кетуіме рұқсат бересің бе?
Dialogue: 0,0:05:36.99,0:05:39.69,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:05:41.66,0:05:43.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:43.64,0:05:46.24,Default,,0,0,0,,Басқа жаман адамдар. Не болып жатыр?
Dialogue: 0,0:05:53.15,0:05:56.17,Default,,0,0,0,,Джарвис сен мені жындымын дейсің бе?
Dialogue: 0,0:05:56.17,0:06:00.83,Default,,0,0,0,,Жоқ, қуаттың үлкен мөлшері өлшемді бұрмалауды тудырды.
Dialogue: 0,0:06:00.83,0:06:03.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:05.00,0:06:07.00,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:08.94,0:06:10.94,Default,,0,0,0,,Гяаах!
Dialogue: 0,0:06:12.94,0:06:15.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:15.96,0:06:19.61,Default,,0,0,0,,Бірдеңе болды. Старк бәрін көрді.
Dialogue: 0,0:06:19.61,0:06:22.11,Default,,0,0,0,,Жарайды, түсінбейсің.
Dialogue: 0,0:06:26.44,0:06:30.44,Default,,0,0,0,,Қышқан жеріме қолым жетпейтін сияқты.
Dialogue: 0,0:06:30.44,0:06:32.46,Default,,0,0,0,,Неліктен ол таныс болып көрінеді?
Dialogue: 0,0:06:32.46,0:06:35.45,Default,,0,0,0,,Бұл болашақ па? Бұл басқа шындық па?
Dialogue: 0,0:06:35.45,0:06:38.10,Default,,0,0,0,,Жоқ, құрышқа осындай ерекше түсті таңдау➡
Dialogue: 0,0:06:38.10,0:06:40.10,Default,,0,0,0,,Шындықта мүмкін емес
Dialogue: 0,0:06:40.10,0:06:42.77,Default,,0,0,0,,Бұл жігіттермен күш біріктіру мүмкін емес.
Dialogue: 0,0:06:42.77,0:06:45.79,Default,,0,0,0,,2-ден 7-ге дейінгі қылмыстық нөмірлерге арналған материалдар
Dialogue: 0,0:06:45.79,0:06:49.28,Default,,0,0,0,,Ironman-ді 23 айып бойынша қамауға алу ордері бар.
Dialogue: 0,0:06:49.28,0:06:52.28,Default,,0,0,0,,Ақпарат беруді жалғастырыңыз.
Dialogue: 0,0:06:52.28,0:06:55.27,Default,,0,0,0,,[Монитор] Атақты хакер Falcon
Dialogue: 0,0:06:55.27,0:06:58.10,Default,,0,0,0,,[Монитор] Қара жесір ұрлық шебері
Dialogue: 0,0:06:58.10,0:07:00.60,Default,,0,0,0,,[Монитор] Қылмыс құдайы Тор
Dialogue: 0,0:07:00.60,0:07:03.27,Default,,0,0,0,,[Монитор] Табиғаттан тыс банда Халк
Dialogue: 0,0:07:03.27,0:07:07.95,Default,,0,0,0,,[Монитор] Hawkeye, бай адамдарға бағытталған ұры
Dialogue: 0,0:07:07.95,0:07:12.93,Default,,0,0,0,,Ал жұмбақ адам капитан әлі қашып жүр.
Dialogue: 0,0:07:12.93,0:07:16.62,Default,,0,0,0,,Мен Джейсонның жалаңаш бетін қылмыстық әрекет деп есептеймін.
Dialogue: 0,0:07:16.62,0:07:18.62,Default,,0,0,0,,Шашыңыз туралы білгіңіз келе ме?
Dialogue: 0,0:07:18.62,0:07:22.61,Default,,0,0,0,,Жоқ, әзірше басқа қылмыскерлермен танысайық.
Dialogue: 0,0:07:22.61,0:07:26.61,Default,,0,0,0,,Егер зейінді сақтай алмасаңыз, енді далаға шықпаңыз.
Dialogue: 0,0:07:26.61,0:07:31.29,Default,,0,0,0,,Шындық тастарын өңдеу қиын. Мен қолымнан келгеннің бәрін істеп жатырмын.
Dialogue: 0,0:07:31.29,0:07:34.96,Default,,0,0,0,,Бұл Кек алушылар жоғалып кеткен әлемді құру туралы уәде болса керек.
Dialogue: 0,0:07:34.96,0:07:37.63,Default,,0,0,0,,Біздің артықшылығымыз бар
Dialogue: 0,0:07:37.63,0:07:40.28,Default,,0,0,0,,Азаматтар жақсы көреді және құрметтейді
Dialogue: 0,0:07:40.28,0:07:44.27,Default,,0,0,0,,Сізде тек бала қиялы бар ма? Кек алушыларды жеңейік
Dialogue: 0,0:07:44.27,0:07:48.94,Default,,0,0,0,,Біздің көздегеніміз күлімсіреп, танымал адам емес, билеуші.
Dialogue: 0,0:07:48.94,0:07:51.96,Default,,0,0,0,,Старк шындықты көрді.
Dialogue: 0,0:07:51.96,0:07:55.63,Default,,0,0,0,,Ол екеуміз бұрынғы Кек алушыларды жоямыз.
Dialogue: 0,0:07:55.63,0:07:58.23,Default,,0,0,0,,Менің жолым
Dialogue: 0,0:08:14.30,0:08:17.26,Default,,0,0,0,,Сіз өзіңізді ақылдымын деп ойлайсыз, солай ма?
Dialogue: 0,0:08:17.26,0:08:19.60,Default,,0,0,0,,Проактивті деген не?
Dialogue: 0,0:08:19.60,0:08:22.60,Default,,0,0,0,,Қалқаннан ұрланған деректер сіздің қолыңызда.
Dialogue: 0,0:08:22.60,0:08:24.62,Default,,0,0,0,,Мені алып кетіңіз
Dialogue: 0,0:08:24.62,0:08:26.64,Default,,0,0,0,,Кешіріңіз, бірақ оны алып кету - ➡
Dialogue: 0,0:08:26.64,0:08:28.64,Default,,0,0,0,,Мен кеттім.
Dialogue: 0,0:08:31.95,0:08:34.95,Default,,0,0,0,,Ха! Апыр-ай!
Dialogue: 0,0:08:34.95,0:08:38.94,Default,,0,0,0,,Міне, Хоки, қолыңды көтер, солай ма?
Dialogue: 0,0:08:38.94,0:08:42.96,Default,,0,0,0,,Болды, Хоки, қолыңды көтер!
Dialogue: 0,0:08:42.96,0:08:45.63,Default,,0,0,0,,О... уау!
Dialogue: 0,0:08:45.63,0:08:49.31,Default,,0,0,0,,Уф... Эй! Сізге көмек қажет емес!
Dialogue: 0,0:08:49.31,0:08:52.31,Default,,0,0,0,,Мен бұлай көрмедім.
Dialogue: 0,0:08:57.29,0:09:00.99,Default,,0,0,0,,Уф, оған көбірек сақтықпен қара.
Dialogue: 0,0:09:04.96,0:09:06.95,Default,,0,0,0,,➡ емес
Dialogue: 0,0:09:06.95,0:09:09.97,Default,,0,0,0,,Маған көмектескеніңіз үшін рахмет, солай ма? Менің досым
Dialogue: 0,0:09:09.97,0:09:14.02,Default,,0,0,0,,Старк? Мен өліп, арамзаның еліне келдім бе?
Dialogue: 0,0:09:14.02,0:09:18.63,Default,,0,0,0,,Сіз қылмыскерге бұлай айтпас едіңіз.
Dialogue: 0,0:09:18.63,0:09:21.23,Default,,0,0,0,,(күшті дауыс)
Dialogue: 0,0:09:27.30,0:09:29.95,Default,,0,0,0,,Міне. Hyperion➡ жеңетін қаруыңыз болса
Dialogue: 0,0:09:29.95,0:09:32.29,Default,,0,0,0,,Хабарламаны жіберген сіз бе?
Dialogue: 0,0:09:32.29,0:09:34.63,Default,,0,0,0,,Мен сенің оқи және жаза алатыныңа таң қалдым.
Dialogue: 0,0:09:34.63,0:09:38.61,Default,,0,0,0,,Мен де сол хабарламаны алдым. Берілме. Бірінші келген, бірінші қызмет көрсетіледі.
Dialogue: 0,0:09:38.61,0:09:40.63,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:09:40.63,0:09:42.63,Default,,0,0,0,,Нуу! Уф!
Dialogue: 0,0:09:46.62,0:09:49.29,Default,,0,0,0,,Мынаны да же!
Dialogue: 0,0:09:49.29,0:09:54.29,Default,,0,0,0,,(төбелестің дыбысы)
Dialogue: 0,0:10:04.39,0:10:06.39,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:10:11.30,0:10:13.28,Default,,0,0,0,,Бұл тұзақ болды
Dialogue: 0,0:10:13.28,0:10:16.28,Default,,0,0,0,,Сіз оңай ұсталды.
Dialogue: 0,0:10:16.28,0:10:20.29,Default,,0,0,0,,Ха, балалар қазірдің өзінде бір қап құрт болдыңдар.
Dialogue: 0,0:10:20.29,0:10:22.62,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:10:22.62,0:10:25.62,Default,,0,0,0,,Өртеніп кетсін
Dialogue: 0,0:11:29.61,0:11:33.63,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:33.63,0:11:36.63,Default,,0,0,0,,Гуо... Уау!
Dialogue: 0,0:11:36.63,0:11:40.07,Default,,0,0,0,,Менен берілемін бе деп сұрағың келмейтін сияқты.
Dialogue: 0,0:11:40.07,0:11:42.64,Default,,0,0,0,,Қазір берілуге ​​кеш.
Dialogue: 0,0:11:42.64,0:11:45.64,Default,,0,0,0,,Эскадрилья бұдан артық емес... Уау!
Dialogue: 0,0:11:47.69,0:11:49.69,Default,,0,0,0,,ｱｲｱﾝﾏﾝ！
Dialogue: 0,0:11:51.73,0:11:53.73,Default,,0,0,0,,Уау! Уф!
Dialogue: 0,0:12:00.35,0:12:02.94,Default,,0,0,0,,Менің сенімен келгенімді қалайсың ба? Бұл да тұзақ па?
Dialogue: 0,0:12:02.94,0:12:05.96,Default,,0,0,0,,Келмесең келудің қажеті жоқ.
Dialogue: 0,0:12:05.96,0:12:07.96,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:12.07,0:12:15.32,Default,,0,0,0,,Құрылғы сіз жасай алмайтын нәрсені жасай ала ма?
Dialogue: 0,0:12:15.32,0:12:19.27,Default,,0,0,0,,Қазіргідей, шындық тасын қаншалықты манипуляциялай алатыныңыздың шегі бар.
Dialogue: 0,0:12:19.27,0:12:23.61,Default,,0,0,0,,Құрылғы аяқталғаннан кейін шындықты толығымен өңдеу мүмкін болады➡
Dialogue: 0,0:12:23.61,0:12:26.28,Default,,0,0,0,,Өзіңіз қалаған әлемді алыңыз
Dialogue: 0,0:12:26.28,0:12:30.68,Default,,0,0,0,,Басқаша айтқанда, Кек алушылар жер бетінен жоғалады.
Dialogue: 0,0:12:32.67,0:12:34.77,Default,,0,0,0,,Старк...
Dialogue: 0,0:12:34.77,0:12:37.27,Default,,0,0,0,,Ол мүлде ақымақ.
Dialogue: 0,0:12:37.27,0:12:39.59,Default,,0,0,0,,Hyperion бөксесін сүртіңіз
Dialogue: 0,0:12:39.59,0:12:41.80,Default,,0,0,0,,Құрылғыны аяқтаңыз
Dialogue: 0,0:12:41.80,0:12:43.95,Default,,0,0,0,,Кешіріңіз, сәйкес келмейтіндер бір-бірімен араласады➡
Dialogue: 0,0:12:43.95,0:12:45.93,Default,,0,0,0,,Менің ешнәрсе істегім келмейді.
Dialogue: 0,0:12:45.93,0:12:48.44,Default,,0,0,0,,Біліксіз адамдар дұрыс айтады.
Dialogue: 0,0:12:48.44,0:12:50.84,Default,,0,0,0,,Білікті емес пе? (Сонымен) бізді неге жинадың?
Dialogue: 0,0:12:50.84,0:12:53.27,Default,,0,0,0,,Ауырған жеріне жете алмайтын не?
Dialogue: 0,0:12:53.27,0:12:56.11,Default,,0,0,0,,Әрқашан солай. Жоқ, менің айтқым келгені бұл емес еді.
Dialogue: 0,0:12:56.11,0:12:58.95,Default,,0,0,0,,Сіз бірдеңе дұрыс емес екенін сезесіз бе?
Dialogue: 0,0:12:58.95,0:13:01.62,Default,,0,0,0,,Spectrum ұстап тұрған тасқа шабуыл жасағанда➡
Dialogue: 0,0:13:01.62,0:13:04.45,Default,,0,0,0,,Мен мұны көрдім
Dialogue: 0,0:13:04.45,0:13:07.62,Default,,0,0,0,,Мен күлгенде шынымен солай көрінемін бе?
Dialogue: 0,0:13:07.62,0:13:09.77,Default,,0,0,0,,Мен бұрын ешқашан күлген емеспін.
Dialogue: 0,0:13:09.77,0:13:12.78,Default,,0,0,0,,Бұл не? Бұл тас сізге елес берді.
Dialogue: 0,0:13:12.78,0:13:16.95,Default,,0,0,0,,Дұрыс, бірақ бұл елес шығар, бұл шындық.
Dialogue: 0,0:13:16.95,0:13:19.10,Default,,0,0,0,,Біз бастапқыда дос болдық➡
Dialogue: 0,0:13:19.10,0:13:21.60,Default,,0,0,0,,Менің естеліктерімді эскадрилья алып кетті.
Dialogue: 0,0:13:21.60,0:13:23.60,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:13:23.60,0:13:27.27,Default,,0,0,0,,Анықтаудың жалғыз жолы - спектрден тасты алу.
Dialogue: 0,0:13:27.27,0:13:29.61,Default,,0,0,0,,Маған қол ұшын беріңіз
Dialogue: 0,0:13:29.61,0:13:33.26,Default,,0,0,0,,Мен бұлыңғыр жадыма сүйеніп, дос болармыз деп ойладым➡
Dialogue: 0,0:13:33.26,0:13:37.45,Default,,0,0,0,,Эскадрильяларды шайқасқа шақыру керек пе? Ха, кешіріңіз, бірақ мен келемін.
Dialogue: 0,0:13:37.45,0:13:39.44,Default,,0,0,0,,Мен жалғыз қасқырмын
Dialogue: 0,0:13:39.44,0:13:41.44,Default,,0,0,0,,Сіз ынтымақтастық жасайсыз ба? Бұл әзіл емес
Dialogue: 0,0:13:41.44,0:13:44.84,Default,,0,0,0,,Олай болса мен қатысамын. Бір ғана адам ба?
Dialogue: 0,0:13:44.84,0:13:47.78,Default,,0,0,0,,Капитан ше? Капитан? Ха!
Dialogue: 0,0:13:47.78,0:13:50.11,Default,,0,0,0,,Сіз оны табасыз деп үміттенемін, оны ешкім көрмеген.
Dialogue: 0,0:13:50.11,0:13:53.27,Default,,0,0,0,,Мен оның жоқтығына бәс тігемін. (Халк) Мен оның сонда болуына бәс тігемін.
Dialogue: 0,0:13:53.27,0:13:55.27,Default,,0,0,0,,«Мен кеттім» қалай?
Dialogue: 0,0:14:02.11,0:14:04.26,Default,,0,0,0,,Мен Халкпен бәс тігуден ұтылдым.
Dialogue: 0,0:14:04.26,0:14:06.26,Default,,0,0,0,,Оны маған кейінірек беріңіз.
Dialogue: 0,0:14:06.26,0:14:08.28,Default,,0,0,0,,Сен не істемексің, Старк?
Dialogue: 0,0:14:08.28,0:14:11.29,Default,,0,0,0,,Неге қазір Сұңқарға көмектестіңіз?
Dialogue: 0,0:14:11.29,0:14:14.94,Default,,0,0,0,,Мен бір нәрсені сезіндім. Біз бұрын...
Dialogue: 0,0:14:14.94,0:14:18.11,Default,,0,0,0,,Дос болған шығар... Мен де солай сезінемін.
Dialogue: 0,0:14:18.11,0:14:20.44,Default,,0,0,0,,Мен әрқашан бірдеңе дұрыс емес екенін сезіндім.
Dialogue: 0,0:14:20.44,0:14:22.96,Default,,0,0,0,,Мен қазіргі адам менің шынайы болмысым емес.
Dialogue: 0,0:14:22.96,0:14:26.77,Default,,0,0,0,,Сондықтан мен жасырдым. Мен ешкімге сене алмадым.
Dialogue: 0,0:14:26.77,0:14:29.44,Default,,0,0,0,,Басқаларға сену тәжірибесі бар, бірақ мұны істеу керек пе?
Dialogue: 0,0:14:29.44,0:14:31.61,Default,,0,0,0,,Құла, мен сені қолдаймын.
Dialogue: 0,0:14:31.61,0:14:33.61,Default,,0,0,0,,Мен тағы бір нәрсені растағым келеді.
Dialogue: 0,0:14:33.61,0:14:36.48,Default,,0,0,0,,Мен осы жерде масштабтауға және түпнұсқа аудионы тыңдағым келеді.
Dialogue: 0,0:14:36.48,0:14:39.01,Default,,0,0,0,,Жақсы, Кек алушылар!
Dialogue: 0,0:14:39.01,0:14:42.12,Default,,0,0,0,,Тоқта, мен әділдік жағындамыз деп ойладым➡
Dialogue: 0,0:14:42.12,0:14:44.62,Default,,0,0,0,,Сіз өз атыңызды Кек алушылар деп айтасыз ба?
Dialogue: 0,0:14:44.62,0:14:48.27,Default,,0,0,0,,Эскадрилья шындықты бұрмалады. Енді жұмбақ шешілді.
Dialogue: 0,0:14:48.27,0:14:50.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:50.27,0:14:59.35,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:59.35,0:15:01.27,Default,,0,0,0,,Сіз әрқашан ұшқышты басқарасыз ба?
Dialogue: 0,0:15:01.27,0:15:03.29,Default,,0,0,0,,Жоқ. Өмірімдегі бірінші тәжірибе
Dialogue: 0,0:15:03.29,0:15:11.09,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:11.09,0:15:13.28,Default,,0,0,0,,Келесі жолы ескертіңіз.
Dialogue: 0,0:15:13.28,0:15:15.45,Default,,0,0,0,,Ескерту. Апыр-ай!
Dialogue: 0,0:15:15.45,0:15:29.61,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:29.61,0:15:32.61,Default,,0,0,0,,Бәрін бірге үрлеймін.
Dialogue: 0,0:15:36.44,0:15:39.11,Default,,0,0,0,,Барлығы қашады! Алдымен барайық!
Dialogue: 0,0:15:39.11,0:15:42.11,Default,,0,0,0,,Жоқ! Қаланың жартысы бомбадан ұшып кетті.
Dialogue: 0,0:15:42.11,0:15:45.50,Default,,0,0,0,,Сізді бұл мазалайды ма? Біз іздеген адамдармыз➡
Dialogue: 0,0:15:45.50,0:15:48.12,Default,,0,0,0,,Біреудің өмірін қиатын ештеңе жасама!
Dialogue: 0,0:15:48.12,0:15:51.60,Default,,0,0,0,,Бұл сіздің нағыз жауыз бола алмайтыныңызды білдіреді.
Dialogue: 0,0:15:51.60,0:15:54.65,Default,,0,0,0,,Құрбандыққа шалынасың ба? Біздің қазір тұрғанымыз шындық емес.
Dialogue: 0,0:15:54.65,0:15:56.77,Default,,0,0,0,,Сонымен, бәрі жақсы, солай ма?
Dialogue: 0,0:15:56.77,0:15:58.94,Default,,0,0,0,,Сіз өз өміріңізді осы гипотезаға қояр ма едіңіз?
Dialogue: 0,0:15:58.94,0:16:01.74,Default,,0,0,0,,Баршаңызға өмірімізді аманат етейік.
Dialogue: 0,0:16:11.61,0:16:13.61,Default,,0,0,0,,Сол екеу ме?
Dialogue: 0,0:17:15.59,0:17:18.27,Default,,0,0,0,,Неліктен жер бетінде➡
Dialogue: 0,0:17:18.27,0:17:20.62,Default,,0,0,0,,Старк өз өмірін құрбан етті ме?
Dialogue: 0,0:17:20.62,0:17:24.13,Default,,0,0,0,,Бұл адамдарды қорғау. Оның үмітін ақтайық!
Dialogue: 0,0:17:24.13,0:17:26.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:26.28,0:17:28.78,Default,,0,0,0,,Бұлай жалғаса берсе, апатқа ұшыраудан басқа амалымыз қалмайды. (Ескерту дыбысы)
Dialogue: 0,0:17:28.78,0:17:30.78,Default,,0,0,0,,Маған қалдыр!
Dialogue: 0,0:17:34.79,0:17:37.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:39.84,0:17:41.84,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:17:56.31,0:17:58.81,Default,,0,0,0,,Уау...
Dialogue: 0,0:18:04.95,0:18:08.82,Default,,0,0,0,,Сіздің күшіңіз аздап көмектескен болуы мүмкін.
Dialogue: 0,0:18:08.82,0:18:11.88,Default,,0,0,0,,Мен мұны жалғыз жасай алмадым.
Dialogue: 0,0:18:11.88,0:18:15.15,Default,,0,0,0,,Сонда біз шынымен доспыз ба?
Dialogue: 0,0:18:15.15,0:18:19.13,Default,,0,0,0,,Өзіңді батырмын деп ойламасаң да, жүрегіңнің түбінде➡
Dialogue: 0,0:18:19.13,0:18:21.65,Default,,0,0,0,,Мен бірдеңе дұрыс емес деп ойлаған шығармын.
Dialogue: 0,0:18:21.65,0:18:24.44,Default,,0,0,0,,Эскадрильяларды жеңу тек әділдік үшін ғана емес.
Dialogue: 0,0:18:24.44,0:18:26.64,Default,,0,0,0,,Әлемнің тағдыры қыл үстінде
Dialogue: 0,0:18:26.64,0:18:30.14,Default,,0,0,0,,Тони бізге сенді. Оның сөзіне сенейік!
Dialogue: 0,0:18:30.14,0:18:32.78,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:18:32.78,0:18:34.78,Default,,0,0,0,,Бұл таныс сияқты.
Dialogue: 0,0:18:34.78,0:18:37.30,Default,,0,0,0,,Старк ұшып кетті... Ха!
Dialogue: 0,0:18:37.30,0:18:40.19,Default,,0,0,0,,Бұл бұрынғы Кек алушылар фильмінің соңы. Хаха!
Dialogue: 0,0:18:40.19,0:18:43.46,Default,,0,0,0,,Сіз түсінбейсіз. Біз бірігіп, күресеміз.
Dialogue: 0,0:18:43.46,0:18:46.96,Default,,0,0,0,,Құрылғы жұмыс істеп тұрғанша біраз уақыт өтеді. Уайымдама➡
Dialogue: 0,0:18:46.96,0:18:50.38,Default,,0,0,0,,Жеңіс жақын. Ах...
Dialogue: 0,0:18:50.38,0:18:56.94,Default,,0,0,0,,♪♪～
Dialogue: 0,0:18:56.94,0:18:59.24,Default,,0,0,0,,Эскадрилья жауынгері!
Dialogue: 0,0:19:03.53,0:19:06.96,Default,,0,0,0,,Егер капитанның айтқаны "алаңдау" дұрыс болса➡
Dialogue: 0,0:19:06.96,0:19:10.62,Default,,0,0,0,,Сіз мұны күні бойы жасай аласыз! (Халк) Оны бірінші бұзған жеңеді.
Dialogue: 0,0:19:10.62,0:19:13.12,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:13.12,0:19:15.12,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:19:17.11,0:19:19.61,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:19:19.61,0:19:21.78,Default,,0,0,0,,Сіздің тарихыңыз аяқталды!
Dialogue: 0,0:19:21.78,0:19:24.10,Default,,0,0,0,,Иә? Тарихты үйрену екінші орында➡
Dialogue: 0,0:19:24.10,0:19:26.15,Default,,0,0,0,,Маған ұнайтыны осы! Ах!
Dialogue: 0,0:19:26.15,0:19:28.29,Default,,0,0,0,,Бірақ маған ең ұнайтыны... (Жылдамдық демон) Мынау➡
Dialogue: 0,0:19:28.29,0:19:30.95,Default,,0,0,0,,Ұстаңыз! Кешіріңіз, бұл мүмкін емес.
Dialogue: 0,0:19:30.95,0:19:35.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:19:35.84,0:19:38.90,Default,,0,0,0,,♬~
Dialogue: 0,0:19:38.90,0:19:41.62,Default,,0,0,0,,♪♪～
Dialogue: 0,0:19:41.62,0:19:43.62,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:43.62,0:19:45.62,Default,,0,0,0,,Уау!!
Dialogue: 0,0:19:47.82,0:19:52.19,Default,,0,0,0,,Түнгі сұңқар! Мен зертханаға барамын. Мен Реалити тасты қандай жағдайда болмасын қорғаймын.
Dialogue: 0,0:19:52.19,0:19:57.63,Default,,0,0,0,,Сәтті ену. Менімен топ құрайық. (Қара жесір) Сіз команда құрып қойғансыз, солай ма?
Dialogue: 0,0:19:57.63,0:20:00.13,Default,,0,0,0,,[Сымсыз] (Қара/Жесір) Captain Spectrum ашылды!
Dialogue: 0,0:20:00.13,0:20:02.23,Default,,0,0,0,,Бізге жазылыңыз
Dialogue: 0,0:20:06.46,0:20:08.76,Default,,0,0,0,,Бұл кір жуғыш машина емес.
Dialogue: 0,0:20:11.96,0:20:15.15,Default,,0,0,0,,Бұл шындықта менде балға болуы мүмкін!
Dialogue: 0,0:20:15.15,0:20:17.45,Default,,0,0,0,,Қараңдаршы, мына жер тамаша!
Dialogue: 0,0:20:19.54,0:20:23.74,Default,,0,0,0,,Егер сен сонда тұрсаң... жолың кесілген! Хахахаха!
Dialogue: 0,0:20:26.78,0:20:29.28,Default,,0,0,0,,Уф! Керемет, эскадрон!
Dialogue: 0,0:20:31.30,0:20:34.80,Default,,0,0,0,,Менің сигналым бойынша шабуылды бастаңыз. (Hyperion) Менің сигналым ➡
Dialogue: 0,0:20:34.80,0:20:37.00,Default,,0,0,0,,Ол қазірдің өзінде шықты!
Dialogue: 0,0:20:40.12,0:20:43.28,Default,,0,0,0,,Бұл әлі де қажет пе? Маған тағы үш минут керек.
Dialogue: 0,0:20:43.28,0:20:45.46,Default,,0,0,0,,Мұны бар болғаны 1 минутқа орындаңыз
Dialogue: 0,0:20:45.46,0:20:52.47,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:52.47,0:20:54.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:54.62,0:21:09.79,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:09.79,0:21:13.96,Default,,0,0,0,,Шындық қайта оралды! Мына қалқанға қараңдар!
Dialogue: 0,0:21:13.96,0:21:16.79,Default,,0,0,0,,Шындық тастың әсері өшіп барады!
Dialogue: 0,0:21:16.79,0:21:18.95,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:21:18.95,0:21:22.97,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:22.97,0:21:25.79,Default,,0,0,0,,Қалқанды қайтарыңыз! Алыңыз!
Dialogue: 0,0:21:25.79,0:21:28.96,Default,,0,0,0,,Уау! Ах~!!
Dialogue: 0,0:21:28.96,0:21:31.83,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:31.83,0:21:34.13,Default,,0,0,0,,Басқаларға сенуге машықтандыру
Dialogue: 0,0:21:34.13,0:21:36.78,Default,,0,0,0,,Старк! Шындық қайта оралды ма?
Dialogue: 0,0:21:36.78,0:21:40.15,Default,,0,0,0,,Мен сені қолдаймын дедің ғой, солай ма? Аман жүргеніңізге қуаныштымын.
Dialogue: 0,0:21:40.15,0:21:46.61,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:46.61,0:21:48.63,Default,,0,0,0,,Хе...
Dialogue: 0,0:21:48.63,0:22:06.46,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:06.46,0:22:09.31,Default,,0,0,0,,Соңында дайын
Dialogue: 0,0:22:09.31,0:22:15.01,Default,,0,0,0,,Тас маған ғаламды билейтін күш береді
Dialogue: 0,0:22:18.61,0:22:23.13,Default,,0,0,0,,Сіз бізді шындықтан өшіргіңіз келеді! (Қасқыр) Мен батыр бола алмадым.
Dialogue: 0,0:22:23.13,0:22:28.23,Default,,0,0,0,,бітті, кек алушылар. Сіздің бар болмысыңыз жоғалады!
Dialogue: 0,0:22:30.28,0:22:32.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:32.77,0:22:36.27,Default,,0,0,0,,Керемет, есіміңіз есіңізде ме?
Dialogue: 0,0:22:36.27,0:22:40.13,Default,,0,0,0,,Шындықты қалпына келтіру
Dialogue: 0,0:22:40.13,0:22:42.28,Default,,0,0,0,,Сіз сәтсіздікке ұшырай алмайсыз, қолдау сұраңыз!
Dialogue: 0,0:22:42.28,0:22:44.95,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:22:44.95,0:22:46.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:46.95,0:22:56.33,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:56.33,0:22:58.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:00.31,0:23:02.32,Default,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:23:02.32,0:23:04.32,Default,,0,0,0,,Менде шындыққа оралудан гөрі жақсы идея бар.
Dialogue: 0,0:23:04.32,0:23:06.64,Default,,0,0,0,,Әлемді идеалдарымызға сәйкестендіру үшін өзгертіңіз
Dialogue: 0,0:23:06.64,0:23:10.02,Default,,0,0,0,,Жоқ! Идеалдарды таңу еркіндікті алып тастайды.
Dialogue: 0,0:23:10.02,0:23:12.56,Default,,0,0,0,,Бұл диктатор.
Dialogue: 0,0:23:12.56,0:23:14.76,Default,,0,0,0,,Біз кек алушылармыз
Dialogue: 0,0:23:23.70,0:23:26.81,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:23:26.81,0:23:29.99,Default,,0,0,0,,Иә, кек алушылар жойылады!
Dialogue: 0,0:23:29.99,0:23:31.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:39.99,0:23:41.99,Default,,0,0,0,,Не? Ой...
Dialogue: 0,0:23:41.99,0:23:43.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:49.15,0:23:51.80,Default,,0,0,0,,Осылай болуы керек.
Dialogue: 0,0:23:51.80,0:23:53.97,Default,,0,0,0,,Бәрі есімде.
Dialogue: 0,0:23:53.97,0:23:58.14,Default,,0,0,0,,Мен бәрін жек көрмеймін, бірақ кейбір адамдарды...
Dialogue: 0,0:23:58.14,0:24:03.01,Default,,0,0,0,,Аа, бұлай болған соң, шындық енді маңызды емес.
Dialogue: 0,0:24:03.01,0:24:06.56,Default,,0,0,0,,Әлі біткен жоқ. Бұл стратегияның өзгеруі.
Dialogue: 0,0:24:06.56,0:24:08.63,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:24:08.63,0:24:10.63,Default,,0,0,0,,Мұнара!
Dialogue: 0,0:24:15.27,0:24:17.79,Default,,0,0,0,,Кек алушылар Түсінесіз бе?
Dialogue: 0,0:24:20.66,0:24:25.26,Default,,0,0,0,,Тыңдаңыздар, мұнара құласа, басқа ғимараттар да құлап қалады.
Dialogue: 0,0:24:28.45,0:24:31.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:24:36.49,0:24:40.96,Default,,0,0,0,,Эскадронға жердегі ең күшті потенциалды көрсетейік!
Dialogue: 0,0:24:40.96,0:24:43.26,Default,,0,0,0,,<Мен оны «Спайс» деп атаймын➡
Dialogue: 0,0:24:52.94,0:24:58.82,Default,,0,0,0,,Гува! Уау...
Dialogue: 0,0:24:58.82,0:25:02.37,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:25:02.37,0:25:07.31,Default,,0,0,0,,Бұзба, маған мына мұнара ұнайды.
Dialogue: 0,0:25:07.31,0:25:17.65,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:17.65,0:25:19.67,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:25:19.67,0:25:22.27,Default,,0,0,0,,[Баяндамашы] Мұнараны жөндеуге кірісеміз.
Dialogue: 0,0:25:26.64,0:25:28.65,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:25:28.65,0:25:30.68,Default,,0,0,0,,Рахмет, жеңіл жеңіс...
Dialogue: 0,0:25:30.68,0:25:32.72,Default,,0,0,0,,Менің Халкқа айтқаным!
Dialogue: 0,0:25:32.72,0:25:35.02,Default,,0,0,0,,А... сен маған айттың ғой.
Dialogue: 0,0:25:38.62,0:25:41.12,Default,,0,0,0,,Шындық тасы сәтті қалпына келтірілді.
Dialogue: 0,0:25:41.12,0:25:43.29,Default,,0,0,0,,Бұл бестің үшінші бөлігі.
Dialogue: 0,0:25:43.29,0:25:45.81,Default,,0,0,0,,Тони, мен бір нәрсе айтқым келеді.
Dialogue: 0,0:25:45.81,0:25:49.70,Default,,0,0,0,,Мен сенің басқа шындықта болғаныңда не істегеніңді ешқашан ұмытпаймын.
Dialogue: 0,0:25:49.70,0:25:53.30,Default,,0,0,0,,Мақтанғым келеді, бірақ басқалардың бәрі бірдей істеді.
Dialogue: 0,0:25:53.30,0:25:57.44,Default,,0,0,0,,Қай жерде болсақ та доспыз.
Dialogue: 0,0:25:57.44,0:25:59.98,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:25:59.98,0:26:02.98,Default,,0,0,0,,Өйткені кейіпкерлер күлімсіреу керек
Dialogue: 0,0:26:35.61,0:26:37.63,Default,,0,0,0,,<“Кек алушылар жиналуда”➡ пайда болады
Dialogue: 0,0:26:37.63,0:26:39.62,Default,,0,0,0,,Супер қаһармандар, жауыздар және т.б. туралы ақпарат➡
Dialogue: 0,0:26:39.62,0:26:41.80,Default,,0,0,0,,Осы жерде жинаңыз
Dialogue: 0,0:26:41.80,0:26:44.65,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:44.65,0:26:47.21,Default,,0,0,0,,Басқа өлшемдегі батырлар командасы➡
Dialogue: 0,0:26:47.21,0:26:49.63,Default,,0,0,0,,Squadron Supreme тобының негізгі мүшесі➡
Dialogue: 0,0:26:49.63,0:26:52.46,Default,,0,0,0,,Адамнан тыс физикалық күш пен жылдамдыққа төзімділік➡
Dialogue: 0,0:26:52.46,0:26:55.11,Default,,0,0,0,,Сондай-ақ өткір сезіммен мақтанады.
Dialogue: 0,0:26:55.11,0:26:58.03,Default,,0,0,0,,Ол жататын Жоғарғы эскадрон әлемінде➡
Dialogue: 0,0:26:58.03,0:27:00.73,Default,,0,0,0,,Кек алушылар зұлым адамдар ретінде қарастырылады.
Dialogue: 0,0:27:02.23,0:27:08.23,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
