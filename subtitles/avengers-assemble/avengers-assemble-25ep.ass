Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:39.00,0:00:41.30,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.38,0:00:47.41,Default,,0,0,0,,<Кек алушылар, яғни➡
Dialogue: 0,0:00:47.41,0:00:49.33,Default,,0,0,0,,Супер қаһармандар жиналды➡
Dialogue: 0,0:00:49.33,0:00:51.50,Default,,0,0,0,,Ең күшті батырлар командасы
Dialogue: 0,0:00:51.50,0:00:55.00,Default,,0,0,0,,Өзіңіздің керемет күшіңізді жинаңыз және жердің тыныштығын қорғаңыз! ＞
Dialogue: 0,0:00:55.00,0:00:57.39,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:57.39,0:00:59.42,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:59.42,0:01:01.48,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:01.48,0:01:03.49,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:03.49,0:01:05.53,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:05.53,0:01:07.53,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:09.60,0:01:12.34,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:12.34,0:01:15.17,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:15.17,0:01:17.23,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:17.23,0:01:19.26,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:19.26,0:01:21.26,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:25.17,0:01:29.02,Default,,0,0,0,,Жер жоғалып кетті ме?
Dialogue: 0,0:01:29.02,0:01:32.56,Default,,0,0,0,,тым кеш болды. Мен оны тым алыс қудым ...
Dialogue: 0,0:01:32.56,0:01:34.84,Default,,0,0,0,,Танос Жерді жойды
Dialogue: 0,0:01:34.84,0:01:37.33,Default,,0,0,0,,Олар Жердің бар болуын жойды ма?
Dialogue: 0,0:01:37.33,0:01:39.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:39.98,0:01:42.33,Default,,0,0,0,,Бірақ қалай?
Dialogue: 0,0:01:42.33,0:01:45.35,Default,,0,0,0,,Бұл ешқашан төзбейтін жексұрын әрекет.
Dialogue: 0,0:01:45.35,0:01:47.66,Default,,0,0,0,,Күрсін... Мен анама хабарласпадым.
Dialogue: 0,0:01:47.66,0:01:51.01,Default,,0,0,0,,Мен миссияда жүргенімде маған анам қоңырау шалды, бірақ...
Dialogue: 0,0:01:51.01,0:01:53.64,Default,,0,0,0,,Бірдеңе дұрыс емес сияқты.
Dialogue: 0,0:01:53.64,0:01:57.00,Default,,0,0,0,,Бәрі дұрыс емес, солай емес пе?
Dialogue: 0,0:01:57.00,0:01:59.65,Default,,0,0,0,,Ештеңе қалмады. Жер жойылса➡
Dialogue: 0,0:01:59.65,0:02:02.34,Default,,0,0,0,,Шаң бұлты бола ма? мүлде ештеңе
Dialogue: 0,0:02:02.34,0:02:06.77,Default,,0,0,0,,Дұрыс айтасыз, бірақ бұл Саностың жаңа Пауэрі болуы мүмкін.
Dialogue: 0,0:02:06.77,0:02:09.24,Default,,0,0,0,,Күте тұрыңыз! Қазір дауысыңыз қандай? [Сымсыз] Avengers…
Dialogue: 0,0:02:09.24,0:02:13.33,Default,,0,0,0,,Мен оны алдым. Бұл өте жақын. Ол қайдан?
Dialogue: 0,0:02:13.33,0:02:15.85,Default,,0,0,0,,Кек алушылар жауап береді Кек алушылар
Dialogue: 0,0:02:15.85,0:02:19.40,Default,,0,0,0,,Қара жесір қауіпсіз болды ма?
Dialogue: 0,0:02:19.40,0:02:21.82,Default,,0,0,0,,Сіз қазір Валхалладасыз ба?
Dialogue: 0,0:02:21.82,0:02:24.16,Default,,0,0,0,,Жоқ, бұл әлі Жер.
Dialogue: 0,0:02:24.16,0:02:27.19,Default,,0,0,0,,Бұл микроскоптың өлшемі.
Dialogue: 0,0:02:27.19,0:02:29.83,Default,,0,0,0,,Тонидің жаңа жерсерігі Таносты анықтады.
Dialogue: 0,0:02:29.83,0:02:33.83,Default,,0,0,0,,Ant-Man спутникті Жерге қарай пим бөлшектерін түсіру үшін пайдаланды.
Dialogue: 0,0:02:33.83,0:02:37.00,Default,,0,0,0,,Жер кішірейді ме? Бұл тамаша шешім
Dialogue: 0,0:02:37.00,0:02:38.97,Default,,0,0,0,,Мен ең жаманға дайындалдым.
Dialogue: 0,0:02:38.97,0:02:41.49,Default,,0,0,0,,Сонымен, сіз Таносты жеңдіңіз бе?
Dialogue: 0,0:02:41.49,0:02:44.31,Default,,0,0,0,,Біз қысылып қалдық. Тезірек бірдеңе істе.
Dialogue: 0,0:02:44.31,0:02:46.33,Default,,0,0,0,,Бұл ұзаққа созылмайды!
Dialogue: 0,0:02:46.33,0:02:48.70,Default,,0,0,0,,Жарайсыңдар, менің тағы бір мүмкіндігім бар! (дабыл дыбысы)
Dialogue: 0,0:02:48.70,0:02:51.80,Default,,0,0,0,,Не? [Сөйлеуші] (Джарвис) Айдағы көгілдір аймаққа біреу басып кірді.
Dialogue: 0,0:02:51.80,0:02:59.14,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:59.14,0:03:01.80,Default,,0,0,0,,Жерді Thanos таппағанына көз жеткізіңіз.
Dialogue: 0,0:03:01.80,0:03:03.81,Default,,0,0,0,,Сіздің планетаңыз жоқ
Dialogue: 0,0:03:03.81,0:03:06.15,Default,,0,0,0,,Бірақ ай әлі де айналуда
Dialogue: 0,0:03:06.15,0:03:09.19,Default,,0,0,0,,Мен Саносты қызықсыз айламен алдай алмаймын деп ойлаймын.
Dialogue: 0,0:03:09.19,0:03:11.97,Default,,0,0,0,,Мен де жерді талқандаймын!
Dialogue: 0,0:03:11.97,0:03:13.97,Default,,0,0,0,,Кек алушылар сияқты!
Dialogue: 0,0:04:36.02,0:04:41.80,Default,,0,0,0,,♪♪～
Dialogue: 0,0:04:41.80,0:04:44.47,Default,,0,0,0,,Арсенал бізге бұрын көмектесті, солай ма?
Dialogue: 0,0:04:44.47,0:04:47.30,Default,,0,0,0,,Бірақ менің ең жақын досым кетті. Сіз не істемексіз?
Dialogue: 0,0:04:47.30,0:04:52.01,Default,,0,0,0,,Тони айтқандай, біз шектеулерге одан әрі қарсы шығуымыз керек.
Dialogue: 0,0:04:52.01,0:04:55.18,Default,,0,0,0,,Біз Таносты, Кек алушыларды жеңеміз!
Dialogue: 0,0:04:55.18,0:04:57.14,Default,,0,0,0,,Бұдан басқа ештеңе айтпайсың ба?
Dialogue: 0,0:04:57.14,0:04:59.81,Default,,0,0,0,,Жинал! Жарайды, мен айттым!
Dialogue: 0,0:04:59.81,0:05:03.48,Default,,0,0,0,,Олар Жерді жасырудың жолын тапқан сияқты.
Dialogue: 0,0:05:03.48,0:05:05.84,Default,,0,0,0,,Бірақ бұл тек уақыт мәселесі
Dialogue: 0,0:05:05.84,0:05:07.87,Default,,0,0,0,,Жерді іздеймін!
Dialogue: 0,0:05:07.87,0:05:10.17,Default,,0,0,0,,Балғаны Таносқа лақтыр!
Dialogue: 0,0:05:10.17,0:05:12.83,Default,,0,0,0,,Халк Гравитациямен жылдамдаңыз! иә~!
Dialogue: 0,0:05:12.83,0:05:17.20,Default,,0,0,0,,Уф, мен бұл стратегияны жек көремін!
Dialogue: 0,0:05:17.20,0:05:19.50,Default,,0,0,0,,А... бағыты басқа емес пе?
Dialogue: 0,0:05:19.50,0:05:21.84,Default,,0,0,0,,Жылдамдық қазір артып келеді. Сәл күте тұрыңыз.
Dialogue: 0,0:05:21.84,0:05:24.89,Default,,0,0,0,,Соңында сені талқандауға рұқсат етіңіз!
Dialogue: 0,0:05:24.89,0:05:30.64,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:30.64,0:05:32.80,Default,,0,0,0,,Жақсы стратегия. Ол құлап қалды!
Dialogue: 0,0:05:32.80,0:05:34.98,Default,,0,0,0,,Мүмкіндік бар, шабуыл!
Dialogue: 0,0:05:34.98,0:05:46.13,Default,,0,0,0,,♪♪～
Dialogue: 0,0:05:46.13,0:05:48.15,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:05:48.15,0:05:51.63,Default,,0,0,0,,Сіздің туған қалаңыз жойылу керек еді➡
Dialogue: 0,0:05:51.63,0:05:55.47,Default,,0,0,0,,Біріншіден, мен өмірлік күшті алып кетуді шештім.
Dialogue: 0,0:05:55.47,0:05:59.64,Default,,0,0,0,,Жер адамдары! Жүгіріп, тығылудан пайда жоқ!
Dialogue: 0,0:05:59.64,0:06:05.00,Default,,0,0,0,,Біз сіздің планетаңызды тауып, оны жоямыз!
Dialogue: 0,0:06:05.00,0:06:07.55,Default,,0,0,0,,Дүние біткен кезде➡
Dialogue: 0,0:06:07.55,0:06:12.00,Default,,0,0,0,,Мұның бәрі мен осы уақытқа дейін сеніп келген Кек алушылар арқасында➡
Dialogue: 0,0:06:12.00,0:06:14.36,Default,,0,0,0,,Сіз білесіз!
Dialogue: 0,0:06:14.36,0:06:19.69,Default,,0,0,0,,Менің психикалық күйзеліс күшейіп барады. Тони не істеп жатыр?
Dialogue: 0,0:06:19.69,0:06:23.80,Default,,0,0,0,,Танос Жерге хабарлама жіберуде.
Dialogue: 0,0:06:23.80,0:06:26.82,Default,,0,0,0,,Кек алушылар жеңілді! Ол келе жатыр!?
Dialogue: 0,0:06:26.82,0:06:33.72,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:33.72,0:06:36.13,Default,,0,0,0,,Бұл мүлдем мағынасыз. Басқа стратегия бар!
Dialogue: 0,0:06:36.13,0:06:38.46,Default,,0,0,0,,Менің бір ойым бар
Dialogue: 0,0:06:38.46,0:06:40.50,Default,,0,0,0,,Деректерді талдау желісін пайдаланыңыз
Dialogue: 0,0:06:40.50,0:06:42.53,Default,,0,0,0,,Спутниктер қару емес!
Dialogue: 0,0:06:42.53,0:06:45.59,Default,,0,0,0,,Құмырсқа адам сол затпен пим бөлшектерін күйдірді.
Dialogue: 0,0:06:45.59,0:06:48.99,Default,,0,0,0,,Егер сіз жеткілікті қуат жинасаңыз, Thanos-ты нокаутқа түсіре аласыз.
Dialogue: 0,0:06:48.99,0:06:52.68,Default,,0,0,0,,Сіз қанша электр қуатын жинау керек екенін білесіз бе?
Dialogue: 0,0:06:52.68,0:06:57.15,Default,,0,0,0,,А, жер бетіндегі барлық жүйедегі барлық электр энергиясы!
Dialogue: 0,0:06:57.15,0:07:00.30,Default,,0,0,0,,Жер бетіндегі барлық елдер ынтымақтасады ма?
Dialogue: 0,0:07:00.30,0:07:04.31,Default,,0,0,0,,Хехе, бұл жай ғана жақсылық сұрау емес.
Dialogue: 0,0:07:04.31,0:07:07.47,Default,,0,0,0,,Әлемдік бейбітшілік пен халықаралық ынтымақтастықпен жұмыс істейтін қарулар➡
Dialogue: 0,0:07:07.47,0:07:10.31,Default,,0,0,0,,Сізге идея келді ме? Сіз де солай айта аласыз.
Dialogue: 0,0:07:10.31,0:07:12.35,Default,,0,0,0,,Қазір сәл қиын болуы мүмкін.
Dialogue: 0,0:07:12.35,0:07:14.50,Default,,0,0,0,,Дүние дүрбелеңде
Dialogue: 0,0:07:14.50,0:07:17.00,Default,,0,0,0,,Басқа стратегиялар бар ма?
Dialogue: 0,0:07:17.00,0:07:20.65,Default,,0,0,0,,Түсіндім. Shield дерекқорынан әр елдің үкіметімен байланысыңыз.
Dialogue: 0,0:07:20.65,0:07:23.07,Default,,0,0,0,,Видо дипломатиялық келіссөздерге қатыса ма?
Dialogue: 0,0:07:23.07,0:07:25.83,Default,,0,0,0,,Не? [Монитор] (Хоки) Ештеңе... ештеңе.
Dialogue: 0,0:07:25.83,0:07:38.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:38.84,0:07:40.84,Default,,0,0,0,,ｳｫｯﾁｬｰ
Dialogue: 0,0:07:42.89,0:07:44.83,Default,,0,0,0,,Көрушілер, кетіңіздер.
Dialogue: 0,0:07:44.83,0:07:52.99,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:52.99,0:07:57.16,Default,,0,0,0,,Бұл Таностың жасыратын бірдеңесі бар деп ойлайсыз ба?
Dialogue: 0,0:07:57.16,0:08:00.64,Default,,0,0,0,,Енді жоқ...
Dialogue: 0,0:08:00.64,0:08:03.05,Default,,0,0,0,,Саносқа қауіп төніп тұр
Dialogue: 0,0:08:03.05,0:08:06.60,Default,,0,0,0,,Бізге өмір сүру үшін әлемдегі барлық электр энергиясы қажет.
Dialogue: 0,0:08:06.60,0:08:10.15,Default,,0,0,0,,Танос кек алушыларды жеңіп, Жерге шабуыл жасайды.
Dialogue: 0,0:08:10.15,0:08:12.34,Default,,0,0,0,,Әркім өз елін қорғағысы келеді
Dialogue: 0,0:08:12.34,0:08:15.49,Default,,0,0,0,,Ұлттың іргетасы саналатын электр қуатын тапсырсақ ше?➡
Dialogue: 0,0:08:15.49,0:08:18.00,Default,,0,0,0,,Халықты қорғаудың жолы болмайды.
Dialogue: 0,0:08:18.00,0:08:22.00,Default,,0,0,0,,Бұл Кек алушылар әкелген апат. Оны өзіміз тазалаймыз.
Dialogue: 0,0:08:22.00,0:08:25.30,Default,,0,0,0,,Жерді қорғаудың басқа жолы жоқ!
Dialogue: 0,0:08:29.01,0:08:32.66,Default,,0,0,0,,Ғаламшарды қаншалықты ақылдылықпен кішірейттің?
Dialogue: 0,0:08:32.66,0:08:34.65,Default,,0,0,0,,Бірақ бұл мағынасыз.
Dialogue: 0,0:08:34.65,0:08:38.65,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:38.65,0:08:40.65,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:08:40.65,0:08:44.00,Default,,0,0,0,,А, жоқ, мен өз шегімдемін!
Dialogue: 0,0:08:44.00,0:08:46.97,Default,,0,0,0,,(енеді)
Dialogue: 0,0:08:46.97,0:08:49.07,Default,,0,0,0,,Танос тапқан
Dialogue: 0,0:08:54.00,0:08:58.32,Default,,0,0,0,,А-а... Жерге қарап, өкінетін күннің келетініне сене алар емеспін...
Dialogue: 0,0:08:58.32,0:09:01.82,Default,,0,0,0,,Барлық үміттерің сөнді!
Dialogue: 0,0:09:01.82,0:09:05.33,Default,,0,0,0,,Барлығыңыз, Жерге толық жылдамдықпен оралыңыз!
Dialogue: 0,0:09:05.33,0:09:08.35,Default,,0,0,0,,Туған жеріңе қайтып бара алмайсың!
Dialogue: 0,0:09:08.35,0:09:12.05,Default,,0,0,0,,Біз мұнда Таностың Жерді қиратуын көреміз.
Dialogue: 0,0:10:14.70,0:10:17.75,Default,,0,0,0,,Қара түске тапсырыс бергенім есімде жоқ.
Dialogue: 0,0:10:17.75,0:10:20.32,Default,,0,0,0,,Тағы бір қызықсыз әзіл жасап жатырсыз ба?
Dialogue: 0,0:10:20.32,0:10:22.32,Default,,0,0,0,,Жалықпадың ба?
Dialogue: 0,0:10:22.32,0:10:24.34,Default,,0,0,0,,(енеді)
Dialogue: 0,0:10:24.34,0:10:26.51,Default,,0,0,0,,Жақында сіз бұдан былай ойнай алмайсыз!
Dialogue: 0,0:10:26.51,0:10:56.32,Default,,0,0,0,,♪♪～
Dialogue: 0,0:10:56.32,0:10:58.32,Default,,0,0,0,,Мен айла-шарғы жасағым келмейді
Dialogue: 0,0:11:00.66,0:11:02.66,Default,,0,0,0,,Не? Кешіріңіз капитан
Dialogue: 0,0:11:02.66,0:11:04.65,Default,,0,0,0,,Бұл Сэмнің кінәсі емес
Dialogue: 0,0:11:04.65,0:11:07.05,Default,,0,0,0,,Неліктен Корвус Грей Санос➡?
Dialogue: 0,0:11:07.05,0:11:09.33,Default,,0,0,0,,Сіз шалғай планетада уақытыңызды босқа өткізіп жатырсыз ба?
Dialogue: 0,0:11:09.33,0:11:12.32,Default,,0,0,0,,Жер күтілгеннен де күштірек болып шықты.
Dialogue: 0,0:11:12.32,0:11:15.34,Default,,0,0,0,,Бірақ мен жеңілмеймін
Dialogue: 0,0:11:15.34,0:11:17.49,Default,,0,0,0,,Жер үрейлі күйде.
Dialogue: 0,0:11:17.49,0:11:20.68,Default,,0,0,0,,Танос қорқады, өйткені ол ең күшті жаулап алушы.
Dialogue: 0,0:11:20.68,0:11:23.55,Default,,0,0,0,,Біз ешқашан қашпаймыз!
Dialogue: 0,0:11:23.55,0:11:26.18,Default,,0,0,0,,Осы уақытқа дейін және болашақта!
Dialogue: 0,0:11:26.18,0:11:29.35,Default,,0,0,0,,Жай сөзбен жеңе алмайсың.
Dialogue: 0,0:11:29.35,0:11:31.32,Default,,0,0,0,,Жүр, Қара Гном!
Dialogue: 0,0:11:31.32,0:11:33.32,Default,,0,0,0,,Уф! Уау
Dialogue: 0,0:11:35.33,0:11:37.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:39.33,0:11:44.03,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:11:48.39,0:11:50.31,Default,,0,0,0,,Менің уақытым жоқ!
Dialogue: 0,0:11:50.31,0:11:53.14,Default,,0,0,0,,Бізге дәл қазір сіздің күшіңіз керек!
Dialogue: 0,0:11:53.14,0:11:56.98,Default,,0,0,0,,Біз электр энергиясынан бас тартып, елді тәуекелге ұшырата алмаймыз.
Dialogue: 0,0:11:56.98,0:12:00.63,Default,,0,0,0,,Мен «Кек алушыларға» сене алмағандықтан, өз елімді өзім қорғай аламын.
Dialogue: 0,0:12:00.63,0:12:02.63,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:12:07.01,0:12:09.81,Default,,0,0,0,,Тони әлем тыныштығын қорғай алмайды
Dialogue: 0,0:12:09.81,0:12:11.98,Default,,0,0,0,,Бір минут күтіңіз! Апыр-ай!
Dialogue: 0,0:12:11.98,0:12:13.98,Default,,0,0,0,,Не?
Dialogue: 0,0:12:13.98,0:12:15.97,Default,,0,0,0,,Хоки айтқандай, дипломатия мүмкін емес еді.
Dialogue: 0,0:12:15.97,0:12:17.97,Default,,0,0,0,,Менің енді уақытым жоқ
Dialogue: 0,0:12:17.97,0:12:20.27,Default,,0,0,0,,Не қажет болса да жасаңыз!
Dialogue: 0,0:12:22.66,0:12:25.64,Default,,0,0,0,,Олай болса Қара жесір стиліндегі дипломатия жасайық.
Dialogue: 0,0:12:25.64,0:12:40.32,Default,,0,0,0,,♪♪～
Dialogue: 0,0:12:40.32,0:12:42.32,Default,,0,0,0,,Сатқын кім?
Dialogue: 0,0:12:44.48,0:12:46.46,Default,,0,0,0,,Маған қара тәртіп ұнамайды➡
Dialogue: 0,0:12:46.46,0:12:48.97,Default,,0,0,0,,Ғарыш кемесін құрастыра білу керемет.
Dialogue: 0,0:12:48.97,0:12:51.13,Default,,0,0,0,,Мен Жерге қайтамын
Dialogue: 0,0:12:51.13,0:13:10.74,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:10.74,0:13:15.66,Default,,0,0,0,,(электрондық дыбыс)
Dialogue: 0,0:13:15.66,0:13:18.35,Default,,0,0,0,,Қаланы Таностан қорғау үшін қорғаныс сызығы бар!
Dialogue: 0,0:13:18.35,0:13:21.72,Default,,0,0,0,,Тіпті Халк пен Тордың бірлескен күштері де оны тоқтата алмайды.
Dialogue: 0,0:13:21.72,0:13:24.52,Default,,0,0,0,,Менің бір ойым бар. Бұл жаңа тұжырымдаманың бір бөлігі➡
Dialogue: 0,0:13:24.52,0:13:26.52,Default,,0,0,0,,Мен оны әлі қолданып көрмедім
Dialogue: 0,0:13:26.52,0:13:28.52,Default,,0,0,0,,Бәлкім, бүгін байқап көрерсің.
Dialogue: 0,0:13:28.52,0:13:31.17,Default,,0,0,0,,Маған бірдеңе соқты! (соққы дыбысы)
Dialogue: 0,0:13:31.17,0:13:33.69,Default,,0,0,0,,Кеме ішінде!
Dialogue: 0,0:13:33.69,0:13:41.15,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:41.15,0:13:44.35,Default,,0,0,0,,Тони, жүр!
Dialogue: 0,0:13:44.35,0:13:46.36,Default,,0,0,0,,Люкті ашты!
Dialogue: 0,0:13:46.36,0:14:08.51,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:08.51,0:14:12.85,Default,,0,0,0,,Құрбандық - Таносқа ең жақсы құрмет
Dialogue: 0,0:14:12.85,0:14:24.68,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:24.68,0:14:28.70,Default,,0,0,0,,Танос ешқашан қарсы шабуылға ұшырамаған деп ойладыңыз ба?
Dialogue: 0,0:14:28.70,0:14:32.35,Default,,0,0,0,,Санос Кек алушылардан күштірек адамдарға қарсы күресті➡
Dialogue: 0,0:14:32.35,0:14:34.35,Default,,0,0,0,,Ешқашан жоғалмаған
Dialogue: 0,0:14:36.37,0:14:40.07,Default,,0,0,0,,Осы Таностың алдында тізе бүгіңіз.
Dialogue: 0,0:14:42.03,0:14:44.03,Default,,0,0,0,,Не?
Dialogue: 0,0:14:46.02,0:14:50.02,Default,,0,0,0,,Жалғыз өзіңді үлкен денелі деп санама!
Dialogue: 0,0:14:50.02,0:14:53.34,Default,,0,0,0,,Сіз күш жағынан Саноспен бәсекелесе аласыз деп ойлайсыз ба?
Dialogue: 0,0:14:53.34,0:15:00.26,Default,,0,0,0,,Жердегі адамдар күресуге деген ықыластарын жоғалтты, ал шайқаста жеңіске жеткен немесе жеңілген.
Dialogue: 0,0:15:00.26,0:15:02.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:02.35,0:15:05.85,Default,,0,0,0,,Бұлай мақтаншақ болу – менің ерекше патентім.
Dialogue: 0,0:15:05.85,0:15:41.67,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:41.67,0:15:45.19,Default,,0,0,0,,Қаш!
Dialogue: 0,0:15:45.19,0:15:49.09,Default,,0,0,0,,Енді, жас ханым, Алыстағы шайқас туралы не айтасыз?
Dialogue: 0,0:15:51.33,0:15:53.33,Default,,0,0,0,,Уау! Басқа планеталар➡
Dialogue: 0,0:15:53.33,0:15:56.22,Default,,0,0,0,,Сіз қанша тонадым деп ойлайсыз?
Dialogue: 0,0:15:56.22,0:16:04.18,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:04.18,0:16:07.05,Default,,0,0,0,,Сіз қайда болдыңыз? Найзағайыңызды пайдаланыңыз...
Dialogue: 0,0:16:07.05,0:16:09.67,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:16:09.67,0:16:12.17,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:16:12.17,0:16:17.51,Default,,0,0,0,,Сонымен, мен сенің мына хайуаннан күшті екеніңді білдім.
Dialogue: 0,0:16:17.51,0:16:21.34,Default,,0,0,0,,Сәлем! Сен не істеп жатырсың!?
Dialogue: 0,0:16:21.34,0:16:26.42,Default,,0,0,0,,Асгардыларды ешкім басқара алмайды!
Dialogue: 0,0:16:26.42,0:16:46.49,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:46.49,0:16:48.99,Default,,0,0,0,,Ол шынымен де тітіркендіргіш!
Dialogue: 0,0:16:48.99,0:16:51.66,Default,,0,0,0,,Сіз ұтылғаныңызды қашан мойындайсыз?
Dialogue: 0,0:16:51.66,0:16:53.86,Default,,0,0,0,,Кек алушылардың жоғалып кететін уақыты келді!
Dialogue: 0,0:16:58.65,0:17:00.67,Default,,0,0,0,,Содан кейін жоғал!
Dialogue: 0,0:17:00.67,0:17:02.64,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:17:02.64,0:17:05.66,Default,,0,0,0,,Мен оны бастапқы өлшеміне қайтарамын!
Dialogue: 0,0:17:05.66,0:17:10.33,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:10.33,0:17:15.50,Default,,0,0,0,,Тек адам Таностың күшін ұрлайды!
Dialogue: 0,0:17:15.50,0:17:19.67,Default,,0,0,0,,О, бөлшектердің күші мен күткеннен де күшті.
Dialogue: 0,0:17:19.67,0:17:21.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:24.32,0:17:26.99,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:17:26.99,0:17:32.92,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:32.92,0:17:35.50,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:17:35.50,0:17:46.81,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:46.81,0:17:49.82,Default,,0,0,0,,Адамдар...
Dialogue: 0,0:17:49.82,0:17:51.82,Default,,0,0,0,,Мен саған Жерді бермеймін!
Dialogue: 0,0:17:51.82,0:17:54.84,Default,,0,0,0,,Бір ғана Кек алушылар қалды!
Dialogue: 0,0:17:54.84,0:17:57.36,Default,,0,0,0,,Әлі де үміт бар ма?
Dialogue: 0,0:17:57.36,0:18:06.70,Default,,0,0,0,,♪♪～
Dialogue: 0,0:18:06.70,0:18:10.09,Default,,0,0,0,,Соңғы үмітіңіз сөнетін сәтті бақылаңыз
Dialogue: 0,0:18:10.09,0:18:13.09,Default,,0,0,0,,Бұл «Кек алушылар» фильмінің соңы
Dialogue: 0,0:19:16.00,0:19:19.66,Default,,0,0,0,,Әлсіз адамдар, жеңілгеніңді мойында!
Dialogue: 0,0:19:19.66,0:19:23.36,Default,,0,0,0,,Жер ақыры Таносқа тиесілі.
Dialogue: 0,0:19:26.33,0:19:30.98,Default,,0,0,0,,Кек алушылар жойылды.
Dialogue: 0,0:19:30.98,0:19:33.32,Default,,0,0,0,,Өтірік емес пе!?
Dialogue: 0,0:19:33.32,0:19:49.17,Default,,0,0,0,,♪♪～
Dialogue: 0,0:19:49.17,0:19:52.17,Default,,0,0,0,,Сізге айтайын, мен Кек алушылармын!
Dialogue: 0,0:19:54.49,0:19:57.66,Default,,0,0,0,,Иә, мен де солаймын.
Dialogue: 0,0:19:57.66,0:20:03.37,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:03.37,0:20:08.24,Default,,0,0,0,,Не!? Сен Саносты қорлайсың ба? Мен жеңдім!
Dialogue: 0,0:20:08.24,0:20:12.51,Default,,0,0,0,,Шайқас әлі аяқталған жоқ!
Dialogue: 0,0:20:12.51,0:20:15.01,Default,,0,0,0,,Мен мұндай үлкен нәрсені бірінші рет көріп тұрмын...
Dialogue: 0,0:20:19.15,0:20:23.17,Default,,0,0,0,,Өйткені, бұл бірінші рет болады.
Dialogue: 0,0:20:23.17,0:20:29.33,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:29.33,0:20:31.33,Default,,0,0,0,,Бұл қала ең жақсысы
Dialogue: 0,0:20:31.33,0:20:40.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:40.84,0:20:43.01,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:43.01,0:20:45.31,Default,,0,0,0,,Мен түс көріп тұрмын ба?
Dialogue: 0,0:20:51.31,0:20:54.00,Default,,0,0,0,,Мен мұндай нәрседен құтыла алмаймын деп ойлаймын!
Dialogue: 0,0:20:54.00,0:20:59.17,Default,,0,0,0,,Саносқа сен жәндіктерден басқа ештеңесің!
Dialogue: 0,0:20:59.17,0:21:01.16,Default,,0,0,0,,Не деген сұмдық!?
Dialogue: 0,0:21:01.16,0:21:03.53,Default,,0,0,0,,Мен күттім!
Dialogue: 0,0:21:03.53,0:21:10.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:10.15,0:21:13.67,Default,,0,0,0,,Видо бүкіл әлемнен электр қуатын жинады ма?
Dialogue: 0,0:21:13.67,0:21:16.32,Default,,0,0,0,,Мен мұны істейсің деп ойладым.
Dialogue: 0,0:21:16.32,0:21:19.01,Default,,0,0,0,,Әлемнің тыныштығы қиын дедіңіз.
Dialogue: 0,0:21:19.01,0:21:20.99,Default,,0,0,0,,Біз Мисаны екінші Кира болуы мүмкін деген күдікпен қамауға алдық
Dialogue: 0,0:21:20.99,0:21:27.15,Default,,0,0,0,,Хехехе. Сіз Таносты жеңдім деп ойладыңыз ба?
Dialogue: 0,0:21:27.15,0:21:29.17,Default,,0,0,0,,Бұл сәтсіздікке ұшыраған сияқты.
Dialogue: 0,0:21:29.17,0:21:35.16,Default,,0,0,0,,Ағымдағы жарылыс мінсіз емес. Біз көбірек уақыт сатып алуымыз керек.
Dialogue: 0,0:21:35.16,0:21:38.56,Default,,0,0,0,,Біз ақша табамыз делік. Апыр-ай!
Dialogue: 0,0:21:40.81,0:21:43.00,Default,,0,0,0,,Басқа планеталар сияқты емес.
Dialogue: 0,0:21:43.00,0:21:45.32,Default,,0,0,0,,Қатты мұқтаждық кезінде...
Dialogue: 0,0:21:45.32,0:21:51.17,Default,,0,0,0,,Жер бетіндегі адамдар өздерінің ең үлкен күшін көрсетеді.
Dialogue: 0,0:21:51.17,0:21:55.16,Default,,0,0,0,,Адамның тітіркендіргіш екенін саған ешкім айтпады ма?
Dialogue: 0,0:21:55.16,0:21:59.48,Default,,0,0,0,,Таностың күшіне ешбір планета қарсы тұра алмайды.
Dialogue: 0,0:21:59.48,0:22:02.50,Default,,0,0,0,,Осы уақытқа дейін және болашақта
Dialogue: 0,0:22:02.50,0:22:13.31,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:13.31,0:22:15.67,Default,,0,0,0,,Шабуыл жасауды жалғастырыңыз!
Dialogue: 0,0:22:15.67,0:22:19.99,Default,,0,0,0,,Сіз маған Майорниядан айырмашылығыңызды айтып көрдіңіз бе?
Dialogue: 0,0:22:19.99,0:22:22.01,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:22:22.01,0:22:26.49,Default,,0,0,0,,Лақтырғанда қызық болады.
Dialogue: 0,0:22:26.49,0:22:32.00,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:32.00,0:22:34.33,Default,,0,0,0,,Біз бәріміз одақтаспыз
Dialogue: 0,0:22:34.33,0:22:37.49,Default,,0,0,0,,Бірақ біз бірге жұмыс жасамайынша бұл шайқаста жеңе алмаймыз.
Dialogue: 0,0:22:37.49,0:22:40.66,Default,,0,0,0,,Мен сені мәжбүрлей алмаймын. Бірақ тек екі нұсқа бар.
Dialogue: 0,0:22:40.66,0:22:44.33,Default,,0,0,0,,Бізді бөлек өлтіреміз бе, әлде бірге соғысамыз ба?
Dialogue: 0,0:22:44.33,0:22:48.18,Default,,0,0,0,,Кек алушылар ретінде
Dialogue: 0,0:22:48.18,0:23:08.99,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:08.99,0:23:11.09,Default,,0,0,0,,Міне келдік! Эвакуацияланамын!
Dialogue: 0,0:23:15.04,0:23:18.49,Default,,0,0,0,,Санос ешкімге ұтыла алмайды
Dialogue: 0,0:23:18.49,0:23:22.67,Default,,0,0,0,,Мен кек алушылардың әрқайсысын жыртып тастаймын!
Dialogue: 0,0:23:22.67,0:23:29.67,Default,,0,0,0,,Санос әлі бар күшін пайдаланған жоқ!
Dialogue: 0,0:23:29.67,0:23:33.07,Default,,0,0,0,,♬~
Dialogue: 0,0:23:39.35,0:23:42.85,Default,,0,0,0,,Өзіне тым сенімді адамдарды жек көремін.
Dialogue: 0,0:23:47.01,0:23:50.66,Default,,0,0,0,,Сіз өзіңіздің дайындығыңыздың жоқтығына алаңдадыңыз.
Dialogue: 0,0:23:50.66,0:23:55.01,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:23:55.01,0:23:59.01,Default,,0,0,0,,Хаха! Сіз шабуылды алдын ала ойламадыңыз ба?
Dialogue: 0,0:24:01.32,0:24:04.99,Default,,0,0,0,,Мен де мұндайды күткен жоқпын. Хахаха!
Dialogue: 0,0:24:04.99,0:24:07.66,Default,,0,0,0,,О, мүлде. Ойын қайтадан аяқталды.
Dialogue: 0,0:24:07.66,0:24:09.83,Default,,0,0,0,,Олай болса, мен оны жебемен жылтыратып, күтемін деп ойлаймын.
Dialogue: 0,0:24:09.83,0:24:13.48,Default,,0,0,0,,Бұл сізге керек емес пе?
Dialogue: 0,0:24:13.48,0:24:16.99,Default,,0,0,0,,Жаңа контроллер!? Хаха мен екеуін де жақсы көремін!
Dialogue: 0,0:24:16.99,0:24:19.01,Default,,0,0,0,,Мен өзімді біртүрлі сезінемін.
Dialogue: 0,0:24:19.01,0:24:22.51,Default,,0,0,0,,Сонымен Видо Біріккен Ұлттар Ұйымының елшісі болды ма?
Dialogue: 0,0:24:22.51,0:24:25.33,Default,,0,0,0,,Дүние жүзінде бейбітшілік орнатуға көмектесуіңізді қалаймын.
Dialogue: 0,0:24:25.33,0:24:28.33,Default,,0,0,0,,Сізге? Өйткені Red Skull бас тартты? Ахах...
Dialogue: 0,0:24:28.33,0:24:31.75,Default,,0,0,0,,Сэм Бұл не? Мама маған торт пісірді
Dialogue: 0,0:24:31.75,0:24:35.45,Default,,0,0,0,,Маған біреу печеньеден шаршағанын айтты.
Dialogue: 0,0:24:39.34,0:24:41.64,Default,,0,0,0,,Қара орден ұсталды➡
Dialogue: 0,0:24:41.64,0:24:44.48,Default,,0,0,0,,Thanos бөлшектерді қалай жинап, бастапқы пішініне қайтарады➡
Dialogue: 0,0:24:44.48,0:24:46.53,Default,,0,0,0,,Оған ғасырлар керек сияқты.
Dialogue: 0,0:24:46.53,0:24:50.14,Default,,0,0,0,,Қираған қаланы қалпына келтіру жұмыстары бірқалыпты жүріп жатқан сияқты.
Dialogue: 0,0:24:50.14,0:24:53.47,Default,,0,0,0,,Сонымен қатар, дүние жүзінде қылмыс деңгейі төмендеуде.
Dialogue: 0,0:24:53.47,0:24:55.48,Default,,0,0,0,,Бұл – шындық.
Dialogue: 0,0:24:55.48,0:24:58.34,Default,,0,0,0,,Өйткені біз Таносқа қарсы тұру үшін күш біріктірдік.
Dialogue: 0,0:24:58.34,0:25:01.90,Default,,0,0,0,,Бейбіт уақытты өткізейік
Dialogue: 0,0:25:01.90,0:25:04.97,Default,,0,0,0,,Торт ше? Оны маған Сұңқардың анасы жіберді.
Dialogue: 0,0:25:04.97,0:25:07.82,Default,,0,0,0,,Бұл печеньеден жақсы.
Dialogue: 0,0:25:07.82,0:25:10.66,Default,,0,0,0,,Тони, көп нәрсе болды, бірақ сіз дұрыс айттыңыз.
Dialogue: 0,0:25:10.66,0:25:12.71,Default,,0,0,0,,Кек алушылар ғарыштан келетін қауіп ➡
Dialogue: 0,0:25:12.71,0:25:15.63,Default,,0,0,0,,Дайын болу керек. Комплименттен бас тарту – ➡
Dialogue: 0,0:25:15.63,0:25:18.65,Default,,0,0,0,,Мен сияқты емес, бірақ мен ойлағандай дұрыс болмады.
Dialogue: 0,0:25:18.65,0:25:22.04,Default,,0,0,0,,Мен болашақты көру үшін ғарышты мақсат еттім➡
Dialogue: 0,0:25:22.04,0:25:25.81,Default,,0,0,0,,Негізі мен іздегенім әрқашан осында болатын.
Dialogue: 0,0:25:25.81,0:25:28.31,Default,,0,0,0,,Мен мағынасын түсінбеймін
Dialogue: 0,0:25:28.31,0:25:30.48,Default,,0,0,0,,Тіпті Нью-Корбинде немесе Нью-Йоркте➡
Dialogue: 0,0:25:30.48,0:25:32.98,Default,,0,0,0,,Кек алушылар жай ғана команда емес еді
Dialogue: 0,0:25:32.98,0:25:36.65,Default,,0,0,0,,Ол идеалды жан. Сіз де солай айттыңыз.
Dialogue: 0,0:25:36.65,0:25:40.82,Default,,0,0,0,,Зұлымдыққа қарсы тұрған кез келген адам Кек алушылардың мүшесі.
Dialogue: 0,0:25:40.82,0:25:42.82,Default,,0,0,0,,Енді не істейміз?
Dialogue: 0,0:25:42.82,0:25:46.83,Default,,0,0,0,,Біраз уақыт өз әрекеттеріңізді жасаңыз және күштірек оралыңыз.
Dialogue: 0,0:25:46.83,0:25:49.78,Default,,0,0,0,,Және әрекеттер ауқымын кеңейтіңіз.
Dialogue: 0,0:25:49.78,0:25:53.82,Default,,0,0,0,,Кек алушылар кеңейіп жатыр
Dialogue: 0,0:25:53.82,0:25:56.65,Default,,0,0,0,,Кек алушылар әлемі
Dialogue: 0,0:25:56.65,0:26:03.05,Default,,0,0,0,,♪♪～
Dialogue: 0,0:26:36.03,0:26:38.08,Default,,0,0,0,,<“Кек алушылар жиналады” фильмінде пайда болу➡
Dialogue: 0,0:26:38.08,0:26:40.15,Default,,0,0,0,,Супер қаһармандар, жауыздар және т.б. туралы ақпарат ➡
Dialogue: 0,0:26:40.15,0:26:42.15,Default,,0,0,0,,Осы жерге жинаңыз
Dialogue: 0,0:26:42.15,0:26:45.80,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:45.80,0:26:48.49,Default,,0,0,0,,Капитан Америка Кек алушыларды біріктіреді➡
Dialogue: 0,0:26:48.49,0:26:51.47,Default,,0,0,0,,Миссияға батыл барған кездегі құпия сөз
Dialogue: 0,0:26:51.47,0:26:55.63,Default,,0,0,0,,Жағымды сезім, үміт, батылдық, топтық жұмыс➡ бар
Dialogue: 0,0:26:55.63,0:26:57.63,Default,,0,0,0,,Берілмеу сезімі. Және➡
Dialogue: 0,0:26:57.63,0:27:01.03,Default,,0,0,0,,Кез келген адам Кек алушы бола алатын құмарлықты қамтиды>
Dialogue: 0,0:27:02.53,0:27:08.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
