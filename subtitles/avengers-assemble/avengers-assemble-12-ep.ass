Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:39.21,0:00:41.51,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.36,0:00:48.03,Default,,0,0,0,,<Кек алушылар. Бұл супер қаһармандар➡
Dialogue: 0,0:00:48.03,0:00:51.37,Default,,0,0,0,,Жиналған ең күшті батырлар командасы
Dialogue: 0,0:00:51.37,0:00:55.19,Default,,0,0,0,,Өзіңіздің керемет күшіңізді жинаңыз және жердің тыныштығын қорғаңыз! ＞
Dialogue: 0,0:00:55.19,0:00:57.37,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:57.37,0:00:59.56,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:59.56,0:01:01.86,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:01.86,0:01:03.91,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:03.91,0:01:05.97,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:05.97,0:01:07.97,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:09.85,0:01:12.36,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:12.36,0:01:15.23,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:15.23,0:01:17.28,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:17.28,0:01:19.30,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:19.30,0:01:21.30,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:23.53,0:01:26.40,Default,,0,0,0,,Көптен күткен күн де келді.
Dialogue: 0,0:01:26.40,0:01:29.47,Default,,0,0,0,,Тіпті өздерін Жердің ең күшті батырлары деп атайтындар да➡
Dialogue: 0,0:01:29.47,0:01:33.03,Default,,0,0,0,,Олар өздерінің қандай дәрменсіз екенін түсінсе керек.
Dialogue: 0,0:01:33.03,0:01:35.20,Default,,0,0,0,,Ақырында бүгін➡
Dialogue: 0,0:01:35.20,0:01:39.37,Default,,0,0,0,,Мен, Танос, бүкіл ғаламның ең күшті билеушісі болдым.
Dialogue: 0,0:01:39.37,0:01:56.92,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:56.92,0:01:58.97,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:01:58.97,0:02:05.71,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:05.71,0:02:07.81,Default,,0,0,0,,Аздап ұялшақ мектеп кеңесінің төрағасы мен екі жақын дос.
Dialogue: 0,0:02:11.20,0:02:13.72,Default,,0,0,0,,Миллиондаған күн және ➡
Dialogue: 0,0:02:13.72,0:02:18.76,Default,,0,0,0,,Мен сансыз планеталар мен өмірлерді жойдым.
Dialogue: 0,0:02:18.76,0:02:23.06,Default,,0,0,0,,Infinity Gauntlet көмегімен соңғы қуатты басқарыңыз...
Dialogue: 0,0:02:25.86,0:02:27.90,Default,,0,0,0,,Хмм…
Dialogue: 0,0:02:27.90,0:02:37.22,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:37.22,0:02:39.19,Default,,0,0,0,,Таносты қорғау...
Dialogue: 0,0:02:39.19,0:02:43.63,Default,,0,0,0,,Өз қадірін білмейтін ақымақ адамның күресі ме?
Dialogue: 0,0:02:43.63,0:02:50.75,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:50.75,0:02:54.52,Default,,0,0,0,,Мен қашықтан басқарылатын Avenger ұшағы пайдасыз екенін түсіндім.
Dialogue: 0,0:02:54.52,0:02:57.53,Default,,0,0,0,,Болашақта анықтама ретінде қолданайық. (Сұңқар көз) Тіпті болашақта?
Dialogue: 0,0:02:57.53,0:02:59.53,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:02:59.53,0:03:02.47,Default,,0,0,0,,Титан броньды пайдалану туралы не деуге болады?
Dialogue: 0,0:03:02.47,0:03:05.04,Default,,0,0,0,,Мен сенің туған жерімді қорлауыңа жол бермеймін.
Dialogue: 0,0:03:05.04,0:03:10.37,Default,,0,0,0,,Жердегілерден айырмашылығы, титандарда жеңілгенін шынайы мойындайтын даналық бар.
Dialogue: 0,0:03:10.37,0:03:13.21,Default,,0,0,0,,Бұл сіздің қыңыр екеніңізді білдіреді.
Dialogue: 0,0:03:13.21,0:03:16.01,Default,,0,0,0,,Сіз тастардың қауіптілігін түсінбейсіз.
Dialogue: 0,0:03:20.30,0:03:22.20,Default,,0,0,0,,Ах! Маған➡
Dialogue: 0,0:03:22.20,0:03:24.20,Default,,0,0,0,,Мақтаншақ болма!
Dialogue: 0,0:03:24.20,0:03:27.21,Default,,0,0,0,,Сен тек тасты көтеретін құрал едің.
Dialogue: 0,0:03:27.21,0:03:31.14,Default,,0,0,0,,Тек Санос тастың күшін басқара алады.
Dialogue: 0,0:03:31.14,0:03:34.38,Default,,0,0,0,,ﾅﾀｰｼｬ！
Dialogue: 0,0:03:34.38,0:03:36.38,Default,,0,0,0,,(енеді)
Dialogue: 0,0:03:36.38,0:03:38.39,Default,,0,0,0,,Рахмет сізге Хоки
Dialogue: 0,0:03:38.39,0:03:44.56,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:44.56,0:03:46.89,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:03:46.89,0:03:52.97,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:52.97,0:03:54.97,Default,,0,0,0,,ｿｰ！
Dialogue: 0,0:05:17.20,0:05:20.35,Default,,0,0,0,,Бізге Infinity Gauntlet➡ туралы бірдеңе істеу керек
Dialogue: 0,0:05:20.35,0:05:23.02,Default,,0,0,0,,Бірге жұмыс жасасақ та, табысқа жете алмайтын сияқтымыз.
Dialogue: 0,0:05:23.02,0:05:27.39,Default,,0,0,0,,Саноста әрқашан әлсіздік болады, сондықтан оны тезірек тауып алыңыз.
Dialogue: 0,0:05:27.39,0:05:30.71,Default,,0,0,0,,Мен сенің әлсіз тұстарыңды білемін.
Dialogue: 0,0:05:30.71,0:05:33.01,Default,,0,0,0,,Бұл планетаны қорғау менің құмарлығым.
Dialogue: 0,0:05:35.07,0:05:40.72,Default,,0,0,0,,Мен өзімнің туған планетамды жойғанда, менде бір сәт ойланбадым.
Dialogue: 0,0:05:40.72,0:05:43.21,Default,,0,0,0,,Бұл сіз дирижерді басқаруға тырысатын сияқты емес, солай емес пе?
Dialogue: 0,0:05:43.21,0:05:46.38,Default,,0,0,0,,Жоқ, мен қирату симфониясын ойнап жатырмын.
Dialogue: 0,0:05:46.38,0:06:12.37,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:12.37,0:06:16.86,Default,,0,0,0,,Мен сіздің планетаңызды ақырындап бүлдіремін
Dialogue: 0,0:06:16.86,0:06:19.28,Default,,0,0,0,,Мен сені ренжітемін...!
Dialogue: 0,0:06:19.28,0:06:22.70,Default,,0,0,0,,Біз Жер Кек алушылар Ассамблеясын қорғаймыз Ха!
Dialogue: 0,0:06:22.70,0:06:27.59,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:27.59,0:06:29.64,Default,,0,0,0,,(Хулктың ұрыс айқайы)
Dialogue: 0,0:06:29.64,0:06:35.21,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:35.21,0:06:38.03,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:06:38.03,0:06:40.53,Default,,0,0,0,,Капитан Таностың әлсіз тұсын таптыңыз ба?
Dialogue: 0,0:06:40.53,0:06:51.70,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:51.70,0:06:53.70,Default,,0,0,0,,Біз жердегі адамдарға көмектесуіміз керек
Dialogue: 0,0:06:53.70,0:06:56.18,Default,,0,0,0,,Оны қалқанға қалдырыңыз. Біз Thanos➡ тоқтатуымыз керек
Dialogue: 0,0:06:56.18,0:06:58.22,Default,,0,0,0,,Жер жоғалады
Dialogue: 0,0:06:58.22,0:07:05.04,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:05.04,0:07:07.04,Default,,0,0,0,,Тас шығармасам➡
Dialogue: 0,0:07:07.04,0:07:09.03,Default,,0,0,0,,Оны Танос ұрлаған жоқ.
Dialogue: 0,0:07:09.03,0:07:12.20,Default,,0,0,0,,Жоқ, ол бәрібір тасты алды.
Dialogue: 0,0:07:12.20,0:07:14.20,Default,,0,0,0,,Мен жауапкершілікті аламын.
Dialogue: 0,0:07:14.20,0:07:16.22,Default,,0,0,0,,Мен аяқтаймын, көмектесіңізші
Dialogue: 0,0:07:16.22,0:07:20.21,Default,,0,0,0,,Видоның жоспары болса, оны орындаған дұрыс.
Dialogue: 0,0:07:20.21,0:07:23.19,Default,,0,0,0,,Жарайды, Видоға біраз уақыт сатып алайық.
Dialogue: 0,0:07:23.19,0:07:25.21,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:07:25.21,0:07:27.81,Default,,0,0,0,,Фуфуфу…｡ (Халк) Уау!
Dialogue: 0,0:07:30.77,0:07:34.04,Default,,0,0,0,,Ақымақтар. Сіз мені ренжіте аласыз деп ойлайсыз ба?
Dialogue: 0,0:07:34.04,0:07:36.54,Default,,0,0,0,,Бұл сен емес, жер.
Dialogue: 0,0:07:40.23,0:07:43.21,Default,,0,0,0,,Халк Таносты Жердің тартылыс құдығына салыңыз➡
Dialogue: 0,0:07:43.21,0:07:45.21,Default,,0,0,0,,Мені құлыптаңыз
Dialogue: 0,0:07:49.22,0:07:53.39,Default,,0,0,0,,Адамдық өлшем бойынша сен ақылды сияқтысың, Старк.
Dialogue: 0,0:07:53.39,0:07:57.59,Default,,0,0,0,,Ақылдылықтың бұл деңгейі мүлдем аянышты.
Dialogue: 0,0:08:06.39,0:08:09.54,Default,,0,0,0,,Менің балғамды қолғаппен ұра аласыз ба?
Dialogue: 0,0:08:09.54,0:08:12.04,Default,,0,0,0,,Мені алдаймын деп ойладың ба?
Dialogue: 0,0:08:12.04,0:08:14.04,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:08:17.71,0:08:19.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:19.70,0:08:21.70,Default,,0,0,0,,Ей, хайуан!
Dialogue: 0,0:08:25.87,0:08:28.86,Default,,0,0,0,,Бұл батыл болды, Видо.
Dialogue: 0,0:08:28.86,0:08:31.74,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:08:31.74,0:08:34.78,Default,,0,0,0,,Сен жәндіксің.
Dialogue: 0,0:08:34.78,0:08:37.58,Default,,0,0,0,,Бұрауға тұрарлық емес
Dialogue: 0,0:08:39.70,0:08:43.21,Default,,0,0,0,,Капитан, төтенше жағдайларды жою жоспарларын жүзеге асыру уақыты келді.
Dialogue: 0,0:08:43.21,0:08:46.36,Default,,0,0,0,,Мен құлықсызмын, бірақ екіленетін уақытым жоқ.
Dialogue: 0,0:08:46.36,0:08:49.71,Default,,0,0,0,,Нұсқауларды сұраңыз. Оларға тастарды бір-бірден қолдануға рұқсат етіңіз.
Dialogue: 0,0:08:49.71,0:08:52.55,Default,,0,0,0,,Эй, мен оның ғаламдағы ең қауіпті қаруды қолданады деп ойламадым➡
Dialogue: 0,0:08:52.55,0:08:54.87,Default,,0,0,0,,Біздің шабуыл жасағанымызды қалайсыз ба?
Dialogue: 0,0:08:54.87,0:08:57.20,Default,,0,0,0,,Сіз ақылдысыз, солай ма?
Dialogue: 0,0:08:57.20,0:08:59.21,Default,,0,0,0,,Менің айтқанымды тыңдау мүмкін емес➡
Dialogue: 0,0:08:59.21,0:09:01.56,Default,,0,0,0,,Мен оларды бір уақытта пайдалана аламын ба?
Dialogue: 0,0:09:01.56,0:09:04.63,Default,,0,0,0,,Оның әлсіз жақтарын табыңыз. Оның осал тұсы жоқ емес пе?
Dialogue: 0,0:09:04.63,0:09:09.53,Default,,0,0,0,,Иә. Тирандарға ғана тән әлсіздік – бос әурешілік!
Dialogue: 0,0:09:09.53,0:09:11.73,Default,,0,0,0,,Бұлай айтқанда, Тони да тиран.
Dialogue: 0,0:09:14.39,0:09:18.02,Default,,0,0,0,,Маған үзіліс беріңіз. иә?
Dialogue: 0,0:09:18.02,0:09:21.32,Default,,0,0,0,,Таностың сізді елемейтін себебі - оның қорқатындығы.
Dialogue: 0,0:09:23.38,0:09:25.37,Default,,0,0,0,,Мен сенімдімін. Сәлем Санос
Dialogue: 0,0:09:25.37,0:09:27.88,Default,,0,0,0,,Пауэр Стоунда бізді ұрғаныңыз есіңізде ме?
Dialogue: 0,0:09:27.88,0:09:31.27,Default,,0,0,0,,Жоқ, жоқ, біз жеңдік. Ах.
Dialogue: 0,0:09:31.27,0:09:34.71,Default,,0,0,0,,Біз Таносты ғарышқа ұшырдық. Бұл көңілді болды.
Dialogue: 0,0:09:34.71,0:09:39.06,Default,,0,0,0,,Сол кезде бозарып, айқайлап тұрған.
Dialogue: 0,0:09:39.06,0:09:41.10,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:09:41.10,0:09:43.03,Default,,0,0,0,,Хахаха күлкілі
Dialogue: 0,0:09:43.03,0:09:47.20,Default,,0,0,0,,Мен сіздердің не мақсат етіп отырғаныңызды білемін, адамдар.
Dialogue: 0,0:09:47.20,0:09:49.21,Default,,0,0,0,,Бірақ қазір және болашақта➡
Dialogue: 0,0:09:49.21,0:09:52.58,Default,,0,0,0,,Менің жеңетінімді есте сақтаңыз
Dialogue: 0,0:09:52.58,0:09:56.21,Default,,0,0,0,,Бес тастың күшін пайдалансаң, кез келген адам жеңе алады.
Dialogue: 0,0:09:56.21,0:09:58.55,Default,,0,0,0,,Infinity Gauntlet➡-ге сенбеңіз
Dialogue: 0,0:09:58.55,0:10:01.05,Default,,0,0,0,,Бір уақытта бір тасты пайдаланып жеңіске жетуге тырысыңыз
Dialogue: 0,0:10:03.92,0:10:06.72,Default,,0,0,0,,Сол қылмыскер... қайтыс болды ма?
Dialogue: 0,0:10:06.72,0:10:17.22,Default,,0,0,0,,♪♪～
Dialogue: 0,0:10:17.22,0:10:22.04,Default,,0,0,0,,Уақыт тасы Уақыт ағымынан ешкім қашып құтыла алмайды.
Dialogue: 0,0:10:22.04,0:10:25.84,Default,,0,0,0,,Бұл туралы не деуге болады? Мен қашып кеттім!
Dialogue: 0,0:10:29.03,0:10:33.18,Default,,0,0,0,,Осыншама жасқа келсең де ұрыспақсың ба?
Dialogue: 0,0:10:33.18,0:10:35.22,Default,,0,0,0,,Бұл өмір жанып кеткенше
Dialogue: 0,0:10:35.22,0:10:38.09,Default,,0,0,0,,Ешқашан берілме!
Dialogue: 0,0:10:38.09,0:10:40.09,Default,,0,0,0,,Хехехе
Dialogue: 0,0:10:43.38,0:10:45.78,Default,,0,0,0,,Менің ойымша, бұл жоспарға сәйкес пе? Тони
Dialogue: 0,0:10:57.37,0:10:59.37,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:11:07.72,0:11:10.02,Default,,0,0,0,,ﾊﾙｸ･ｽﾏｯｼｭ！
Dialogue: 0,0:11:12.06,0:11:14.26,Default,,0,0,0,,Хехехе
Dialogue: 0,0:11:21.03,0:11:24.53,Default,,0,0,0,,Қарттықтың үмітсіздігін сезіну.
Dialogue: 0,0:11:24.53,0:11:26.54,Default,,0,0,0,,Үмітсіздік?
Dialogue: 0,0:11:26.54,0:11:29.34,Default,,0,0,0,,Асгард құдайы есейген сайын күшіне ие болады!
Dialogue: 0,0:11:31.69,0:11:34.04,Default,,0,0,0,,Кәріліктің дәмін тат!
Dialogue: 0,0:11:34.04,0:11:36.36,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:11:36.36,0:11:39.38,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:11:39.38,0:11:41.72,Default,,0,0,0,,Жоқ, мен жеңілмеймін.
Dialogue: 0,0:11:41.72,0:11:43.82,Default,,0,0,0,,Мен уақытты өзгертемін!
Dialogue: 0,0:11:47.87,0:11:52.21,Default,,0,0,0,,Бақыттысың, адам. Асгард құдайы достарыңыздың арасында!
Dialogue: 0,0:11:52.21,0:11:56.23,Default,,0,0,0,,Бұл жай ғана сәттілік емес. Бұл командалық жұмыс.
Dialogue: 0,0:11:56.23,0:11:59.89,Default,,0,0,0,,Мен сене алар емеспін. Сізге құтқарылғаныңыздың жолы болды ма?
Dialogue: 0,0:11:59.89,0:12:03.74,Default,,0,0,0,,Алғыссыз бейбақ! Менің күшіме күмәндандың ба?
Dialogue: 0,0:12:03.74,0:12:05.78,Default,,0,0,0,,Мен дәл қазір еске саламын!
Dialogue: 0,0:12:05.78,0:12:08.54,Default,,0,0,0,,Сабыр ет! Бұл бөлінетін уақыт емес!
Dialogue: 0,0:12:08.54,0:12:10.55,Default,,0,0,0,,Тони әртүрлі бұйрықтар береді➡
Dialogue: 0,0:12:10.55,0:12:13.22,Default,,0,0,0,,Біздің өміріміз маңызды емес!
Dialogue: 0,0:12:13.22,0:12:15.22,Default,,0,0,0,,Тас ұрланғанына сен кінәлісің!
Dialogue: 0,0:12:15.22,0:12:18.39,Default,,0,0,0,,Ол Таностың бағыныштысы емес пе?
Dialogue: 0,0:12:18.39,0:12:22.06,Default,,0,0,0,,Барлығы тынышталсын!
Dialogue: 0,0:12:22.06,0:12:24.04,Default,,0,0,0,,Бастықтың бұйрығын бермеңіз
Dialogue: 0,0:12:24.04,0:12:27.55,Default,,0,0,0,,Менің балғамның бұйрығын орында
Dialogue: 0,0:12:27.55,0:12:30.48,Default,,0,0,0,,Барлығы жарылып кете жаздаса, мен от жағамын.
Dialogue: 0,0:12:30.48,0:12:33.54,Default,,0,0,0,,ﾁｸ ﾀｸ ﾎﾞｰﾝ！
Dialogue: 0,0:12:33.54,0:12:35.84,Default,,0,0,0,,Уау...!
Dialogue: 0,0:12:38.09,0:12:41.14,Default,,0,0,0,,Кек алушылар Тоқта! Жақсы
Dialogue: 0,0:12:41.14,0:12:44.55,Default,,0,0,0,,Барлығына манипуляция жасалуда! Танос Mind Stone қолданады.
Dialogue: 0,0:12:44.55,0:12:46.55,Default,,0,0,0,,Жоғалтпа!
Dialogue: 0,0:12:46.55,0:12:48.90,Default,,0,0,0,,Сіз енді алданбайсыз!
Dialogue: 0,0:12:48.90,0:12:51.94,Default,,0,0,0,,Ол тіпті арамыздағы ең мықты жауынгер емес➡
Dialogue: 0,0:12:51.94,0:12:54.87,Default,,0,0,0,,Нұсқаулар бермеңіз!
Dialogue: 0,0:12:54.87,0:12:56.89,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:12:56.89,0:12:59.59,Default,,0,0,0,,Уау...!
Dialogue: 0,0:13:01.56,0:13:05.86,Default,,0,0,0,,Сол себепті ашуланасың ба? Мен саған шынайы ашуымды көрсетемін!
Dialogue: 0,0:14:08.31,0:14:10.31,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,0:14:12.22,0:14:14.22,Default,,0,0,0,,Ақыл тасынан туындаған ашу?
Dialogue: 0,0:14:14.22,0:14:16.39,Default,,0,0,0,,Ашу қайнап жатыр!
Dialogue: 0,0:14:16.39,0:14:18.74,Default,,0,0,0,,Мен күнде сондаймын!
Dialogue: 0,0:14:18.74,0:14:22.06,Default,,0,0,0,,Ашуды қалай ұстауға болады? Айтыңызшы! Қазір!
Dialogue: 0,0:14:22.06,0:14:25.72,Default,,0,0,0,,Мен ашуымды мүлдем баспаймын
Dialogue: 0,0:14:25.72,0:14:28.72,Default,,0,0,0,,Мен ашудың өзімін!
Dialogue: 0,0:14:31.87,0:14:33.87,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,0:14:33.87,0:14:37.74,Default,,0,0,0,,Халк айтқандай, ашуыңызды тыймаңыз және бәрін Thanos-тан шығарыңыз!
Dialogue: 0,0:14:37.74,0:14:45.38,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:45.38,0:14:50.21,Default,,0,0,0,,Ашу мен өшпенділікке бой алдыр!
Dialogue: 0,0:14:50.21,0:14:53.71,Default,,0,0,0,,Білмеймін, бұлай айтқаныңа өкінбейсің бе.
Dialogue: 0,0:14:53.71,0:14:55.71,Default,,0,0,0,,Ол ашуланған сайын...
Dialogue: 0,0:14:55.71,0:14:57.73,Default,,0,0,0,,(Хулктың ұрыс айқайы)
Dialogue: 0,0:14:57.73,0:15:00.73,Default,,0,0,0,,Халк күшейе түседі!
Dialogue: 0,0:15:00.73,0:15:05.05,Default,,0,0,0,,Халк бәрінен де күшті!
Dialogue: 0,0:15:05.05,0:15:07.21,Default,,0,0,0,,Кек алушылар, бізге қосылыңыз!
Dialogue: 0,0:15:07.21,0:15:18.87,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:18.87,0:15:22.54,Default,,0,0,0,,Кешіріңіз. Мен сені алғыссыз деп санамаймын.
Dialogue: 0,0:15:22.54,0:15:25.71,Default,,0,0,0,,Бәрі жақсы. Бәріне Стоун кінәлі.
Dialogue: 0,0:15:25.71,0:15:28.39,Default,,0,0,0,,Ойын аяқталды!
Dialogue: 0,0:15:28.39,0:15:32.06,Default,,0,0,0,,Менің енді төменгі нәсілдермен айналысуға уақытым жоқ!
Dialogue: 0,0:15:32.06,0:15:34.72,Default,,0,0,0,,Бізді бір ғана таспен жеңе алмайсың.
Dialogue: 0,0:15:34.72,0:15:36.72,Default,,0,0,0,,Маған хабарлағаныңыз үшін рахмет.
Dialogue: 0,0:15:40.89,0:15:43.59,Default,,0,0,0,,Уау! Енді ше?
Dialogue: 0,0:15:46.55,0:15:48.73,Default,,0,0,0,,Ғарыш тастарына ренжіме
Dialogue: 0,0:15:48.73,0:15:50.70,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:15:50.70,0:15:53.87,Default,,0,0,0,,Сонымен! Өтінемін, байыппен қабылдаңыз!
Dialogue: 0,0:15:53.87,0:15:55.89,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:15:55.89,0:16:03.53,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:03.53,0:16:05.88,Default,,0,0,0,,ﾂｰ ｽﾘｰ
Dialogue: 0,0:16:05.88,0:16:07.90,Default,,0,0,0,,Әй!
Dialogue: 0,0:16:07.90,0:16:10.10,Default,,0,0,0,,Екі үш Круч!
Dialogue: 0,0:16:12.20,0:16:14.54,Default,,0,0,0,,Бұл шабуылды оқи алмайтын сияқты емес.
Dialogue: 0,0:16:14.54,0:16:16.58,Default,,0,0,0,,Егер заңдылық болса
Dialogue: 0,0:16:16.58,0:16:18.58,Default,,0,0,0,,Сіздің кезегіңіз.
Dialogue: 0,0:16:20.63,0:16:22.93,Default,,0,0,0,,ﾜﾝ ﾂｰ ｽﾘｰ
Dialogue: 0,0:16:25.87,0:16:28.57,Default,,0,0,0,,ﾜﾝ ﾂｰ ｽﾘｰ！
Dialogue: 0,0:16:30.76,0:16:33.36,Default,,0,0,0,,ﾜﾝ ﾂｰ ｽﾘｰ！
Dialogue: 0,0:16:39.88,0:16:41.92,Default,,0,0,0,,Мен мұны қарызға аламын.
Dialogue: 0,0:16:41.92,0:16:44.55,Default,,0,0,0,,Танос жеңілмейтін
Dialogue: 0,0:16:44.55,0:16:47.85,Default,,0,0,0,,Жеңілмейтін бе? Титанның сөздігі болған жоқ.
Dialogue: 0,0:16:49.89,0:16:54.03,Default,,0,0,0,,Мен де Таносты жеңіп, Кек алушылардың намысын қорғай алдым.
Dialogue: 0,0:16:54.03,0:16:57.23,Default,,0,0,0,,Әлемді құтқару біздің міндетіміз.
Dialogue: 0,0:16:59.54,0:17:03.19,Default,,0,0,0,,Фьюри, тағы айтшы. Тарату дегенді қалай түсінесіңдер?
Dialogue: 0,0:17:03.19,0:17:05.22,Default,,0,0,0,,Бұл Кек алушылар
Dialogue: 0,0:17:05.22,0:17:08.56,Default,,0,0,0,,Гидра аман қалғандарға қолдау көрсетеді Эйм қайырымдылық қорын құрады
Dialogue: 0,0:17:08.56,0:17:11.61,Default,,0,0,0,,Жоғарғы эскадрилья Қалқанның мүшесі
Dialogue: 0,0:17:11.61,0:17:15.53,Default,,0,0,0,,Танос тудырған дүниенің жойылу қаупі адамзатты біріктірді
Dialogue: 0,0:17:15.53,0:17:19.21,Default,,0,0,0,,Әлемдік бейбітшілікке қол жеткізілді? Күш-жігер сыйланды ма?
Dialogue: 0,0:17:19.21,0:17:23.56,Default,,0,0,0,,Зұлымдарды жою аяқталды ма? Бұл қызықсыз күнделікті өмірге қайта оралды.
Dialogue: 0,0:17:23.56,0:17:25.59,Default,,0,0,0,,Сіз циркке қайта барасыз ба?
Dialogue: 0,0:17:25.59,0:17:28.20,Default,,0,0,0,,А, мүмкін...
Dialogue: 0,0:17:28.20,0:17:30.20,Default,,0,0,0,,Айтпақшы, Қызыл бас сүйек туралы қандай мәлімет бар?
Dialogue: 0,0:17:30.20,0:17:33.22,Default,,0,0,0,,Сенесіз бе, сенбесеңіз, ол өзін тапсырды.
Dialogue: 0,0:17:33.22,0:17:36.22,Default,,0,0,0,,Өткен күнәларды өтеуді қалау
Dialogue: 0,0:17:40.31,0:17:42.91,Default,,0,0,0,,Дұрыс, мен сенбеймін.
Dialogue: 0,0:17:46.18,0:17:48.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:48.20,0:17:50.20,Default,,0,0,0,,Тым көп шығар
Dialogue: 0,0:17:50.20,0:17:54.21,Default,,0,0,0,,Халк дұрыс айтады. Тұтқындарға шабуыл жасау – жексұрын әрекет.
Dialogue: 0,0:17:54.21,0:17:57.21,Default,,0,0,0,,Ол тұтқын емес
Dialogue: 0,0:17:57.21,0:17:59.53,Default,,0,0,0,,Бұлай істеу капитанға ұқсамайды.
Dialogue: 0,0:17:59.53,0:18:01.53,Default,,0,0,0,,Тоқта, сіз жеңдіңіз.
Dialogue: 0,0:18:01.53,0:18:05.53,Default,,0,0,0,,Тони. Thanos бізге галлюцинацияларды көрсету үшін шындық тасын пайдаланады.
Dialogue: 0,0:18:05.53,0:18:07.97,Default,,0,0,0,,Біз оны жойылмай тұрып тоқтатуымыз керек.
Dialogue: 0,0:18:07.97,0:18:09.86,Default,,0,0,0,,Менің ойымша, бұл галлюцинация емес.
Dialogue: 0,0:18:09.86,0:18:13.89,Default,,0,0,0,,Бірақ капитан солай айтса, сенейік. Avengers Assemble!
Dialogue: 0,0:18:13.89,0:18:15.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:15.86,0:18:18.86,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:18:29.21,0:18:31.54,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:31.54,0:18:33.88,Default,,0,0,0,,Кедей адамдар
Dialogue: 0,0:18:33.88,0:18:36.87,Default,,0,0,0,,Білмейсің бе, маған қол көтерсең де, пайдасы жоқ!
Dialogue: 0,0:18:36.87,0:18:41.54,Default,,0,0,0,,Мен оны алдасам да, капитан әрқашан шындықты көре алады.
Dialogue: 0,0:18:41.54,0:18:44.54,Default,,0,0,0,,Сіз де сәтті өтіп кеттіңіз➡
Dialogue: 0,0:18:44.54,0:18:46.91,Default,,0,0,0,,Қуат тастай жақсы
Dialogue: 0,0:18:46.91,0:18:49.53,Default,,0,0,0,,Мәселелерді реттейтін уақыт жеткен сияқты!
Dialogue: 0,0:18:49.53,0:18:51.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:55.22,0:18:59.19,Default,,0,0,0,,Санос мен сенің қарсыласыңмын! Хмф!
Dialogue: 0,0:18:59.19,0:19:01.52,Default,,0,0,0,,Егер ол сізге тимесе, сіз оны жеңе алмайсыз.
Dialogue: 0,0:19:01.52,0:19:05.56,Default,,0,0,0,,Сіз мәңгілік ұшуды жоспарлап отырсыз ба? Таяз адам
Dialogue: 0,0:19:05.56,0:19:09.93,Default,,0,0,0,,Сіз байсалдысыз ба? Бұл жұмыс істемейді!
Dialogue: 0,0:19:09.93,0:19:11.93,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:19:14.22,0:19:17.21,Default,,0,0,0,,Осындай әлсіз шабуылдарды қанша рет қайталасам да➡
Dialogue: 0,0:19:17.21,0:19:19.21,Default,,0,0,0,,Жеңіске жету мүмкіндігі жоқ! Апыр-ай!
Dialogue: 0,0:19:21.21,0:19:24.21,Default,,0,0,0,,Осымен менің ақымақ ойындарға қатысуым аяқталды.
Dialogue: 0,0:19:24.21,0:19:26.21,Default,,0,0,0,,ｱｲｱﾝﾏﾝ！
Dialogue: 0,0:20:39.22,0:20:44.28,Default,,0,0,0,,Мен Кек алушыларды да, Жерді де қорғай алмадым, Старк.
Dialogue: 0,0:20:44.28,0:20:46.88,Default,,0,0,0,,Иә? [Сымсыз] Avengers➡
Dialogue: 0,0:20:46.88,0:20:50.90,Default,,0,0,0,,Құрышпен байланыс үзілді. Стратегия дұрыс емес болуы мүмкін.
Dialogue: 0,0:20:50.90,0:20:53.92,Default,,0,0,0,,Мен 5 тастың деректерін алдым, бірақ➡
Dialogue: 0,0:20:53.92,0:20:57.56,Default,,0,0,0,,Арсеналды қайта іске қосу үшін тағы бірнеше секунд қажет болады.
Dialogue: 0,0:20:57.56,0:21:02.56,Default,,0,0,0,,Құрыштың басынан бос екенін білмедім.
Dialogue: 0,0:21:02.56,0:21:06.86,Default,,0,0,0,,Старктың маған тікелей қарсы тұруға батылы жетпейді.
Dialogue: 0,0:21:12.57,0:21:15.93,Default,,0,0,0,,Бұл мүлдем дұрыс емес сияқты.
Dialogue: 0,0:21:15.93,0:21:17.93,Default,,0,0,0,,Тониді қорғаңыз!
Dialogue: 0,0:21:19.95,0:21:22.88,Default,,0,0,0,,Иә, мен қазір сонда барамын.
Dialogue: 0,0:21:22.88,0:21:25.53,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:21:25.53,0:21:28.55,Default,,0,0,0,,Уау! Ууууууууу...
Dialogue: 0,0:21:28.55,0:21:30.92,Default,,0,0,0,,Арнайы орындарда көрсетемін➡
Dialogue: 0,0:21:30.92,0:21:34.62,Default,,0,0,0,,Көшбасшыңның бұл дүниеден жоғалып кетуіне жол берме.
Dialogue: 0,0:21:37.90,0:21:40.92,Default,,0,0,0,,Осындай трюктерді ойнап, Таносты жеңуге қалай батылыңыз барады ➡
Dialogue: 0,0:21:40.92,0:21:42.85,Default,,0,0,0,,Менің ойымша, бұл ақылсыздық емес.
Dialogue: 0,0:21:42.85,0:21:44.85,Default,,0,0,0,,Мен бос емес едім.
Dialogue: 0,0:21:48.52,0:21:51.19,Default,,0,0,0,,Арсенал жобасын қалпына келтіру аяқталды
Dialogue: 0,0:21:51.19,0:21:53.88,Default,,0,0,0,,Сәлем Тони, мен сізге көмектесе аламын ба?
Dialogue: 0,0:21:53.88,0:21:57.22,Default,,0,0,0,,Иә. Бұл жігіт есіңізде ме?
Dialogue: 0,0:21:57.22,0:22:01.52,Default,,0,0,0,,Бұл бұрын мені жеңуге тырысқан жігіт емес пе?
Dialogue: 0,0:22:04.29,0:22:06.23,Default,,0,0,0,,Қолқаның күшін сіңіру
Dialogue: 0,0:22:06.23,0:22:09.86,Default,,0,0,0,,Бұрын мен бір тастың күшін ғана қабылдай алатынмын➡
Dialogue: 0,0:22:09.86,0:22:13.22,Default,,0,0,0,,Бұл жолы мен бәрін сіңіре алатындай етіп жаңарттым.
Dialogue: 0,0:22:13.22,0:22:16.25,Default,,0,0,0,,Мен сенің бос сөзіңді сіңіре алмаймын.
Dialogue: 0,0:22:16.25,0:22:18.25,Default,,0,0,0,,Хмф!
Dialogue: 0,0:22:23.88,0:22:25.89,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:22:25.89,0:22:28.55,Default,,0,0,0,,Мүмкін емес нәрсені мүмкін ету Старк стилі.
Dialogue: 0,0:22:28.55,0:22:33.22,Default,,0,0,0,,Әкемнің туған күніне арналған сыйлығын әлемді құтқаратын батырға айналдырдым.
Dialogue: 0,0:22:33.22,0:22:36.87,Default,,0,0,0,,Сіз өзіңізге алып мүсін жасаумен айналысып, байқамай қалдыңыз ба?
Dialogue: 0,0:22:36.87,0:22:45.71,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:45.71,0:22:50.59,Default,,0,0,0,,Менің күшім робот сияқты бірдеңеден айырылуы мүмкін емес!
Dialogue: 0,0:22:50.59,0:22:54.59,Default,,0,0,0,,Бұл жай ғана робот емес. Бұл әкемнің ең үлкен өнертабысы.
Dialogue: 0,0:22:58.88,0:23:01.05,Default,,0,0,0,,Қолаяқты ұрлағыңыз келе ме?
Dialogue: 0,0:23:01.05,0:23:03.55,Default,,0,0,0,,Бұл жақсы идея.
Dialogue: 0,0:23:12.54,0:23:17.06,Default,,0,0,0,,Аяғыңызды жерге тигізіп, шындықты көрдіңіз бе?
Dialogue: 0,0:23:17.06,0:23:21.90,Default,,0,0,0,,Таносқа қарсы шығу...
Dialogue: 0,0:23:21.90,0:23:24.89,Default,,0,0,0,,Беріңіз, кек алушылар сізді қайта-қайта жеңеді.
Dialogue: 0,0:23:24.89,0:23:33.90,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:33.90,0:23:37.05,Default,,0,0,0,,Титандар жеңілгенін мойындайды, солай емес пе?
Dialogue: 0,0:23:37.05,0:23:41.39,Default,,0,0,0,,Қателерді жеңу үшін сізге Infinity Пауэр қажет емес!
Dialogue: 0,0:23:41.39,0:23:43.41,Default,,0,0,0,,Осымен өмір сүр!
Dialogue: 0,0:23:43.41,0:23:45.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:53.05,0:23:55.90,Default,,0,0,0,,Йошито, бұл оңай жеңіс болды.
Dialogue: 0,0:23:55.90,0:23:58.22,Default,,0,0,0,,Бұл қатты қысылды, бірақ мен оны уақытында орындадым.
Dialogue: 0,0:23:58.22,0:24:00.22,Default,,0,0,0,,Менің талантыма сеніңіз
Dialogue: 0,0:24:00.22,0:24:02.88,Default,,0,0,0,,Санос бекершілікке бейім жалғыз адам емес.
Dialogue: 0,0:24:02.88,0:24:05.23,Default,,0,0,0,,Арсенал миссиясы аяқталды.
Dialogue: 0,0:24:05.23,0:24:09.80,Default,,0,0,0,,Қолаяқты қауіпсіз жерде сақтаңыз...
Dialogue: 0,0:24:09.80,0:24:13.34,Default,,0,0,0,,Кешіріңіз, Тони. Төтенше жағдайға жауап берудің жаңа бағдарламалық құралы➡
Dialogue: 0,0:24:13.34,0:24:17.74,Default,,0,0,0,,Мен сізге басқа нұсқаулар беремін. иә?
Dialogue: 0,0:24:17.74,0:24:20.61,Default,,0,0,0,,Сіз төтенше жағдайға әрекет ету жоспарысыз.
Dialogue: 0,0:24:20.61,0:24:25.23,Default,,0,0,0,,Алайда жүйе осал болып қалды...
Dialogue: 0,0:24:25.23,0:24:28.53,Default,,0,0,0,,Ультрон басып алды. Ultron!?
Dialogue: 0,0:24:31.75,0:24:35.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:35.56,0:24:41.06,Default,,0,0,0,,♬~
Dialogue: 0,0:24:43.70,0:24:46.24,Default,,0,0,0,,А...
Dialogue: 0,0:24:46.24,0:24:50.39,Default,,0,0,0,,Сіздің әкеңіздің өнертабысы шексіз Пауэрді сіңіре алады.
Dialogue: 0,0:24:50.39,0:24:54.54,Default,,0,0,0,,Басқаша айтқанда, мен де...
Dialogue: 0,0:24:54.54,0:24:57.38,Default,,0,0,0,,"Олар әңгімелесіп жатыр!"
Dialogue: 0,0:24:57.38,0:25:02.08,Default,,0,0,0,,Адамзаттың жойылып кетуіне дайындалу.
Dialogue: 0,0:25:02.08,0:25:04.24,Default,,0,0,0,,Бұл Ultron ма?
Dialogue: 0,0:25:04.24,0:25:06.71,Default,,0,0,0,,Ол мен ойлағаннан да қорқынышты.
Dialogue: 0,0:25:06.71,0:25:10.39,Default,,0,0,0,,Мені Танос алаңдатқаны сонша, мен Ультронды ұмытып кеттім.
Dialogue: 0,0:25:10.39,0:25:14.38,Default,,0,0,0,,Ультронның артынан бармас бұрын Санос мәселесін шешіп алайық.
Dialogue: 0,0:25:14.38,0:25:16.90,Default,,0,0,0,,Қадаммен алға жылжудан басқа амалымыз жоқ.
Dialogue: 0,0:25:16.90,0:25:19.38,Default,,0,0,0,,Сәлеметсіз бе, Гокуру мырза. Шексіздік тасы➡
Dialogue: 0,0:25:19.38,0:25:22.22,Default,,0,0,0,,Мұны сендерге қалдырған дұрыс шешім болды.
Dialogue: 0,0:25:22.22,0:25:24.39,Default,,0,0,0,,Жұлдызды Лорд не айтқысы келіп тұр➡
Dialogue: 0,0:25:24.39,0:25:26.88,Default,,0,0,0,,Видоға шабуыл жасап, тасты ұрламақшы➡
Dialogue: 0,0:25:26.88,0:25:30.30,Default,,0,0,0,,Жаман болды. Танос өте қатал болды, бірақ➡
Dialogue: 0,0:25:30.30,0:25:33.40,Default,,0,0,0,,Бірлесе отырып жеңдік. Сіз сенімді бола аласыз.
Dialogue: 0,0:25:33.40,0:25:36.22,Default,,0,0,0,,Егер сіз мұны бізге қалдырсаңыз, Танос мойынсұнғыш болады.
Dialogue: 0,0:25:36.22,0:25:39.39,Default,,0,0,0,,Бұл Сақшылар болды. Сақшылар болды ма?
Dialogue: 0,0:25:39.39,0:25:41.59,Default,,0,0,0,,Бұл не деген ақымақ сәлемдесу?
Dialogue: 0,0:25:47.80,0:25:51.23,Default,,0,0,0,,Қайтадан тауып көрейік. иә?
Dialogue: 0,0:25:51.23,0:25:54.72,Default,,0,0,0,,Ультрон жақында қозғала бастауы керек.
Dialogue: 0,0:25:54.72,0:26:00.21,Default,,0,0,0,,Аа, егер әлгі робот жігіт көрінсе, онда Кек алушылар оның қарсыласы болады.
Dialogue: 0,0:26:00.21,0:26:02.81,Default,,0,0,0,,Әрқашан
Dialogue: 0,0:26:36.21,0:26:38.21,Default,,0,0,0,,<“Кек алушылар жиналады” фильмінде пайда болу➡
Dialogue: 0,0:26:38.21,0:26:40.25,Default,,0,0,0,,Супер қаһармандар, жауыздар және т.б. туралы ақпарат➡
Dialogue: 0,0:26:40.25,0:26:42.38,Default,,0,0,0,,Осы жерге жинаңыз
Dialogue: 0,0:26:42.38,0:26:45.54,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:45.54,0:26:47.89,Default,,0,0,0,,Тони Старктың әкесі Ховард➡
Dialogue: 0,0:26:47.89,0:26:50.71,Default,,0,0,0,,Менің ұлымды қорғау үшін жасалған андроид.
Dialogue: 0,0:26:50.71,0:26:53.05,Default,,0,0,0,,Энергияның үлкен мөлшерін сіңіреді➡
Dialogue: 0,0:26:53.05,0:26:55.60,Default,,0,0,0,,Қауіпсіз сақтау мүмкіндігі бар
Dialogue: 0,0:26:55.60,0:26:58.22,Default,,0,0,0,,Себебі бұл әкемнің туған күніне сыйлығы еді➡
Dialogue: 0,0:26:58.22,0:27:01.22,Default,,0,0,0,,Тони Арсеналға ерекше жақынды＞
Dialogue: 0,0:27:02.72,0:27:08.72,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
