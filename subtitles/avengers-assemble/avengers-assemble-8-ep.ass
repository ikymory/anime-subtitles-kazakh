Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:38.36,0:00:40.66,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.23,0:00:47.27,Default,,0,0,0,,<Кек алушылар, бұл супер қаһармандар➡
Dialogue: 0,0:00:47.27,0:00:49.87,Default,,0,0,0,,Жиналған ең күшті батырлар командасы
Dialogue: 0,0:00:49.87,0:00:52.21,Default,,0,0,0,,Өзіңіздің трансценденттік күшіңізді жинаңыз➡
Dialogue: 0,0:00:52.21,0:00:54.19,Default,,0,0,0,,Жер бетіндегі бейбітшілікті қорға! ＞
Dialogue: 0,0:00:54.19,0:00:56.21,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:56.21,0:00:58.38,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:58.38,0:01:00.86,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:00.86,0:01:02.87,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:02.87,0:01:04.87,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:04.87,0:01:06.87,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:08.86,0:01:11.38,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:11.38,0:01:14.39,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:14.39,0:01:16.45,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:16.45,0:01:18.47,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:18.47,0:01:20.47,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:32.03,0:01:34.03,Default,,0,0,0,,Бұл олар!
Dialogue: 0,0:01:34.03,0:01:36.23,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:01:39.54,0:01:43.49,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,0:01:43.49,0:01:46.19,Default,,0,0,0,,≪Базаға оралыңыз, зымыранды бермеңіз.
Dialogue: 0,0:01:46.19,0:01:48.70,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:01:48.70,0:01:51.37,Default,,0,0,0,,Қалжыңдама, сондықтан
Dialogue: 0,0:01:51.37,0:01:53.88,Default,,0,0,0,,Барлығы мантияны күңгірт деп ойлайды.
Dialogue: 0,0:01:53.88,0:01:57.75,Default,,0,0,0,,Ха! Қысқа шалбар киген жігіт не дейді?
Dialogue: 0,0:01:57.75,0:01:59.75,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:02.39,0:02:04.69,Default,,0,0,0,,≪Қорғаныс шебін орнату. Тек екі жау бар!
Dialogue: 0,0:02:08.22,0:02:10.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:12.22,0:02:14.71,Default,,0,0,0,,Мұндай қақтығыста жеңімпаз болмайды.
Dialogue: 0,0:02:14.71,0:02:17.14,Default,,0,0,0,,Жеңімпаз бар
Dialogue: 0,0:02:17.14,0:02:19.54,Default,,0,0,0,,Бұл күннен қорғайтын көзілдірік киген адам.
Dialogue: 0,0:02:26.87,0:02:28.97,Default,,0,0,0,,(айқайлау)
Dialogue: 0,0:02:32.71,0:02:34.71,Default,,0,0,0,,Кім ең керемет?➡
Dialogue: 0,0:02:34.71,0:02:36.71,Default,,0,0,0,,Сіз таласып жатырсыз ба?
Dialogue: 0,0:02:45.37,0:02:48.04,Default,,0,0,0,,Уау! Ха!
Dialogue: 0,0:02:48.04,0:02:50.04,Default,,0,0,0,,Уф…
Dialogue: 0,0:02:50.04,0:02:52.04,Default,,0,0,0,,Алыс бол, мен оқ атамын.
Dialogue: 0,0:02:54.19,0:02:56.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:56.36,0:02:58.70,Default,,0,0,0,,Мен ештеңені атқылай алмаймын деп ойлаймын.
Dialogue: 0,0:02:58.70,0:03:00.73,Default,,0,0,0,,Айтпақшы, ең кереметі ➡
Dialogue: 0,0:03:00.73,0:03:03.87,Default,,0,0,0,,Эйму жігіттері емес пе? сары соқыр
Dialogue: 0,0:03:03.87,0:03:06.69,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:03:06.69,0:03:08.86,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:03:08.86,0:03:10.86,Default,,0,0,0,,Бұл жаман, Тони!
Dialogue: 0,0:03:10.86,0:03:12.96,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:03:15.03,0:03:18.22,Default,,0,0,0,,Олай дейтін болсам, ең кереметі➡
Dialogue: 0,0:03:18.22,0:03:21.42,Default,,0,0,0,,Бұл менің 10 мегатондық зымырандарды жеңе алатын сауытым.
Dialogue: 0,0:03:28.03,0:03:30.05,Default,,0,0,0,,Сен қолыңнан келгеннің бәрін істедің, Эйм
Dialogue: 0,0:03:30.05,0:03:33.05,Default,,0,0,0,,Мәңгілік, орташа және бос күш-жігермен, мақсат?
Dialogue: 0,0:03:39.56,0:03:41.96,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,0:03:44.54,0:03:47.94,Default,,0,0,0,,Шалбар қысқа және кең.
Dialogue: 0,0:03:50.12,0:03:53.37,Default,,0,0,0,,Бұл табиғи нәтиже. 100 ұпай.
Dialogue: 0,0:03:53.37,0:03:55.56,Default,,0,0,0,,Бұл сауыттың ойыны бар, солай ма?
Dialogue: 0,0:03:55.56,0:03:58.89,Default,,0,0,0,,Мен Фьюримен сөйлескенде, ол әдетте ойын ойнайды.
Dialogue: 0,0:03:58.89,0:04:01.55,Default,,0,0,0,,Жоқ, кейде.
Dialogue: 0,0:04:01.55,0:04:03.86,Default,,0,0,0,,Бұл жауынгерлік тиімділік мониторы.
Dialogue: 0,0:04:03.86,0:04:06.70,Default,,0,0,0,,Біз бұл жолы 100 пайыздық қуатты көрсеттік.
Dialogue: 0,0:04:06.70,0:04:10.54,Default,,0,0,0,,Максималды қабілеттілік. Максимум? Әлі де өсіп жатыр
Dialogue: 0,0:04:10.54,0:04:15.04,Default,,0,0,0,,Математикалық түсініктің жоқтығы. 100 пайыздан жоғары болуы мүмкін емес.
Dialogue: 0,0:04:15.04,0:04:18.55,Default,,0,0,0,,Математика – математика. Психикалық күш әртүрлі.
Dialogue: 0,0:04:18.55,0:04:21.21,Default,,0,0,0,,Жұмыс орнында бағдарламада есептелмейтін күштер бар.
Dialogue: 0,0:04:21.21,0:04:23.22,Default,,0,0,0,,Менің бағдарламам тамаша
Dialogue: 0,0:04:23.22,0:04:25.42,Default,,0,0,0,,Сіз кімнің ең керемет екенін анықтай аласыз ба?
Dialogue: 0,0:04:27.37,0:04:29.37,Default,,0,0,0,,Қайырлы таң, Қалқан халқы.
Dialogue: 0,0:04:31.39,0:04:36.05,Default,,0,0,0,,Біздің тазалайтын кез келді. Өтінемін, Эймнің эскадрильяларының бірін алыңыз.
Dialogue: 0,0:04:36.05,0:04:39.05,Default,,0,0,0,,Әй, мұнымен не айтқың келеді?
Dialogue: 0,0:04:39.05,0:04:41.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:41.45,0:04:45.45,Default,,0,0,0,,Ой, бұл біздің 100 пайыз күтпеген нәрсе.
Dialogue: 0,0:06:08.37,0:06:11.54,Default,,0,0,0,,Қалқан Қаруларыңызды тастаңыз. [Спикер] Кек алушылар бағынды!
Dialogue: 0,0:06:11.54,0:06:13.54,Default,,0,0,0,,Біреу Фьюриге қоңырау шалыңыз.
Dialogue: 0,0:06:13.54,0:06:16.41,Default,,0,0,0,,Байланыс бұғатталған. [Спикер] Қарсылық көрсетудің қажеті жоқ!
Dialogue: 0,0:06:16.41,0:06:18.43,Default,,0,0,0,,тым кеш! [Спикер] Hulkbuster іске қосылды!
Dialogue: 0,0:06:18.43,0:06:20.73,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:06:27.37,0:06:29.53,Default,,0,0,0,,Қалқан неге сонша ашулы? Келіңіздер
Dialogue: 0,0:06:29.53,0:06:31.55,Default,,0,0,0,,Бірақ бұл Хокидің кінәсі шығар.
Dialogue: 0,0:06:31.55,0:06:34.21,Default,,0,0,0,,Мен олардың барлық пицца пакеттерін жегендіктен бе?
Dialogue: 0,0:06:34.21,0:06:38.05,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:06:38.05,0:06:40.05,Default,,0,0,0,,Ағынға оралу.
Dialogue: 0,0:06:44.64,0:06:47.84,Default,,0,0,0,,Егер бәрібір ұрысып қалатын болсаң, мен саған ұрысатындай әрекет жасаймын!
Dialogue: 0,0:06:54.03,0:06:56.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:58.37,0:07:01.42,Default,,0,0,0,,О, бұл үлкен мәселе.
Dialogue: 0,0:07:01.42,0:07:04.72,Default,,0,0,0,,Уау, Трикария тіпті шықты!
Dialogue: 0,0:07:07.88,0:07:10.48,Default,,0,0,0,,Жарайды, мен сен сындырған велосипедтің ақысын төлеймін!
Dialogue: 0,0:07:13.54,0:07:15.71,Default,,0,0,0,,Шынымен, сен неге маған шабуыл жасайсың!?
Dialogue: 0,0:07:15.71,0:07:17.71,Default,,0,0,0,,Тони, қазір көшуге дайынсың ба?
Dialogue: 0,0:07:17.71,0:07:21.06,Default,,0,0,0,,Әй, әйтеуір... бұл Хокидің кінәсі болуы керек.
Dialogue: 0,0:07:21.06,0:07:24.71,Default,,0,0,0,,Халк! Мен лақтыруды жасаймын.
Dialogue: 0,0:07:24.71,0:07:26.91,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:29.70,0:07:32.37,Default,,0,0,0,,♬~
Dialogue: 0,0:07:32.37,0:07:35.17,Default,,0,0,0,,Ах! Бұл шыбық!
Dialogue: 0,0:07:38.88,0:07:44.53,Default,,0,0,0,,Мені есіңе түсірмейсің бе? Бұл Сэм Уилсон. Ол S.I.E.L.D. стажер...
Dialogue: 0,0:07:44.53,0:07:47.55,Default,,0,0,0,,Мен ұмытып кеткен сияқтымын
Dialogue: 0,0:07:47.55,0:07:51.54,Default,,0,0,0,,Тиімділік бақылаушылары Қалқанның толық сатқындығын болжады ма?
Dialogue: 0,0:07:51.54,0:07:54.38,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:07:54.38,0:07:56.88,Default,,0,0,0,,[Спикер] (Қара/Жесір) Барлығы, жүріңдер! Wido! Біз үшін➡
Dialogue: 0,0:07:56.88,0:07:58.87,Default,,0,0,0,,Авенджит бар.
Dialogue: 0,0:07:58.87,0:08:00.87,Default,,0,0,0,,Бас тартпаңыз
Dialogue: 0,0:08:00.87,0:08:03.87,Default,,0,0,0,,Сондықтан Халк, қолдау сұра!
Dialogue: 0,0:08:03.87,0:08:05.87,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:08:15.38,0:08:17.38,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:08:17.38,0:08:20.05,Default,,0,0,0,,Егер сізге кенеттен аралар тобы шабуыл жасаса, не істер едіңіз?
Dialogue: 0,0:08:20.05,0:08:24.06,Default,,0,0,0,,Бұл ұяға асығуым керек дегенді білдіре ме? Фьюри түсіндіреді.
Dialogue: 0,0:08:24.06,0:08:26.46,Default,,0,0,0,,Қалқанның жау қолына түсу мүмкіндігі бар.
Dialogue: 0,0:08:26.46,0:08:28.86,Default,,0,0,0,,Менің ойымша, маған Фьюридің көз патчын алатын кез келді.
Dialogue: 0,0:08:28.86,0:08:30.88,Default,,0,0,0,,Бұл сен кінәлі
Dialogue: 0,0:08:30.88,0:08:35.39,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:35.39,0:08:37.55,Default,,0,0,0,,[Монитор] Қол жеткізу рұқсаты
Dialogue: 0,0:08:37.55,0:08:43.69,Default,,0,0,0,,♪♪～
Dialogue: 0,0:08:43.69,0:08:47.58,Default,,0,0,0,,≪Бұл күтпеген қайтару. Балалар сендер кімсіңдер?
Dialogue: 0,0:08:47.58,0:08:51.37,Default,,0,0,0,,Мен директор Фьюриге келдім. Бұл сен емессің!
Dialogue: 0,0:08:51.37,0:08:54.05,Default,,0,0,0,,Зиянкес!
Dialogue: 0,0:08:54.05,0:08:58.21,Default,,0,0,0,,Абайлаңыз! Қалқан жау емес. Сіз де солай ойлайсыз ба?
Dialogue: 0,0:08:58.21,0:09:01.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:01.19,0:09:03.38,Default,,0,0,0,,Жабыңыз!
Dialogue: 0,0:09:03.38,0:09:06.88,Default,,0,0,0,,Оны шынымен бұзуға болады ма? Фьюри...
Dialogue: 0,0:09:06.88,0:09:09.48,Default,,0,0,0,,Мм. Бұл терезе.
Dialogue: 0,0:09:12.89,0:09:16.21,Default,,0,0,0,,Сенің маған қатысың бар ма? Ашу мен мұны 10 секундқа жасаймын➡
Dialogue: 0,0:09:16.21,0:09:18.19,Default,,0,0,0,,Не болып жатқанын түсіндіріңіз.
Dialogue: 0,0:09:18.19,0:09:21.88,Default,,0,0,0,,Сіздің операцияңыз халықаралық құқықты өрескел бұзады.
Dialogue: 0,0:09:21.88,0:09:25.54,Default,,0,0,0,,Кек алушыларды таратып, сізді осында қалдырыңыз.
Dialogue: 0,0:09:25.54,0:09:29.21,Default,,0,0,0,,Соңына дейін тыңдайық. Фьюридің айтқанында бір мән бар.
Dialogue: 0,0:09:29.21,0:09:32.71,Default,,0,0,0,,А... түрменің формасы маған жараспайды.
Dialogue: 0,0:09:32.71,0:09:36.11,Default,,0,0,0,,Тыңда, Старк. Мен де мұндай нәрсені жасағым келмейді.
Dialogue: 0,0:09:36.11,0:09:40.03,Default,,0,0,0,,Менің бастығым да жазамызға қатысты келіссөздер жүргізуге мүмкіндік бар екенін айтты.
Dialogue: 0,0:09:40.03,0:09:43.72,Default,,0,0,0,,Жақында жұртшылықтың Кек алушыларға деген көзқарасы өзгерді.
Dialogue: 0,0:09:43.72,0:09:46.22,Default,,0,0,0,,Балалар, сендердің күресулерің өте абайсыз.
Dialogue: 0,0:09:46.22,0:09:49.88,Default,,0,0,0,,Сол ойсыз шайқастар әлемді бірнеше рет құтқарды.
Dialogue: 0,0:09:49.88,0:09:53.36,Default,,0,0,0,,Қалқан бұлай көрмейді. Ең бастысы...
Dialogue: 0,0:09:53.36,0:09:56.78,Default,,0,0,0,,Бұл модель олай ойламайды.
Dialogue: 0,0:09:56.78,0:10:00.37,Default,,0,0,0,,Күткендей...Капитан, Шавалмасандқа өзіңізді сыйлаңыз.
Dialogue: 0,0:10:00.37,0:10:04.04,Default,,0,0,0,,Сіз ставка жасадыңыз ба? Мен Red Skull-ға бәс тігемін
Dialogue: 0,0:10:04.04,0:10:08.38,Default,,0,0,0,,Қызыл бас сүйек кек алушыларды жеңудің жалғыз жолы - команда болып күресу екенін айтты.
Dialogue: 0,0:10:08.38,0:10:11.55,Default,,0,0,0,,Әлсіз адамдар осылай істейді. Бұл мод ➡
Dialogue: 0,0:10:11.55,0:10:17.04,Default,,0,0,0,,Ақыл-ойды басқаратын армия - Кек алушыларды жойылуға апаратын әскер➡
Dialogue: 0,0:10:17.04,0:10:19.71,Default,,0,0,0,,Бұл әлемді басқарудың жалғыз жолы!
Dialogue: 0,0:10:19.71,0:10:23.21,Default,,0,0,0,,Сіз әдемі аксессуарларды киіп жүрсіз. Сіз осылай айттыңыз ба?
Dialogue: 0,0:10:23.21,0:10:27.63,Default,,0,0,0,,Ақыл тасы мені таңдап, іздеді.
Dialogue: 0,0:10:27.63,0:10:30.38,Default,,0,0,0,,Хмм... Ол өте ойшыл жігіт.
Dialogue: 0,0:10:30.38,0:10:33.74,Default,,0,0,0,,Менің жаңа қабілетімнің қаншалықты керемет екенін түсінбейсің.
Dialogue: 0,0:10:33.74,0:10:37.27,Default,,0,0,0,,Ол енді тек технологияның шегінен шығып кетті.
Dialogue: 0,0:10:37.27,0:10:39.71,Default,,0,0,0,,Енді Мордок ақыл-ойды басқара алады!
Dialogue: 0,0:10:39.71,0:10:43.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:43.38,0:10:48.25,Default,,0,0,0,,Ал кек алушылар Модокқа тиесілі болады.
Dialogue: 0,0:10:48.25,0:10:51.54,Default,,0,0,0,,Өкінішті... Менің әлі де достарым бар...
Dialogue: 0,0:10:51.54,0:10:54.19,Default,,0,0,0,,Не!?
Dialogue: 0,0:10:54.19,0:10:57.49,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,0:10:59.71,0:11:01.71,Default,,0,0,0,,Сіз қоңырау шалдыңыз ба?
Dialogue: 0,0:11:01.71,0:11:07.87,Default,,0,0,0,,♪♪～
Dialogue: 0,0:11:07.87,0:11:10.04,Default,,0,0,0,,Кел, Модок!
Dialogue: 0,0:11:10.04,0:11:14.71,Default,,0,0,0,,Қалқан абдырап қалды. Ақыл тасына мақсат қойыңыз!
Dialogue: 0,0:11:14.71,0:11:17.21,Default,,0,0,0,,Ах! Мұндай дүрбелең➡
Dialogue: 0,0:11:17.21,0:11:19.55,Default,,0,0,0,,Енді бітті!
Dialogue: 0,0:11:19.55,0:11:22.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:28.02,0:11:30.71,Default,,0,0,0,,Сіз оны жеңдіңіз бе? иә?
Dialogue: 0,0:11:30.71,0:11:32.70,Default,,0,0,0,,Мен жеңдім деп айта алмайтын шығармын.
Dialogue: 0,0:11:32.70,0:11:35.40,Default,,0,0,0,,Ой... бірдеңе дұрыс емес.
Dialogue: 0,0:11:35.40,0:11:37.40,Default,,0,0,0,,А...
Dialogue: 0,0:12:40.40,0:12:43.55,Default,,0,0,0,,Бұл шындық па? Мен қатты таң қалдым➡
Dialogue: 0,0:12:43.55,0:12:45.55,Default,,0,0,0,,Мен жалғызбын ба? (Сұңқыр) Жоқ ➡
Dialogue: 0,0:12:45.55,0:12:48.92,Default,,0,0,0,,Мен де өз денем емеспін. Бұл үлкен мәселе.
Dialogue: 0,0:12:48.92,0:12:51.04,Default,,0,0,0,,Барлық денелер ауыстырылды
Dialogue: 0,0:12:51.04,0:12:53.23,Default,,0,0,0,,Оның құдіретін түсінген сияқтысыз.
Dialogue: 0,0:12:53.23,0:12:55.71,Default,,0,0,0,,Бұл ақыл тасы
Dialogue: 0,0:12:55.71,0:12:57.73,Default,,0,0,0,,Мордокпен бірге жоғалып кетті.
Dialogue: 0,0:12:57.73,0:13:00.90,Default,,0,0,0,,Қара/Жесір өте ыңғайсыз бірдеңені киіп жүр➡
Dialogue: 0,0:13:00.90,0:13:03.89,Default,,0,0,0,,Сіз қалай оңай қозғала аласыз?
Dialogue: 0,0:13:03.89,0:13:05.87,Default,,0,0,0,,Иә... уф...｡ Уау.
Dialogue: 0,0:13:05.87,0:13:07.89,Default,,0,0,0,,Аа, мен Тормен орын ауыстырсам ғой.
Dialogue: 0,0:13:07.89,0:13:11.56,Default,,0,0,0,,Қазірдің өзінде кеш. Бұл ең көп ұтқан мен екенімді білдіре ме?
Dialogue: 0,0:13:11.56,0:13:13.55,Default,,0,0,0,,Кел, Мжолния
Dialogue: 0,0:13:13.55,0:13:15.93,Default,,0,0,0,,♬~
Dialogue: 0,0:13:15.93,0:13:21.05,Default,,0,0,0,,Сәлем, өтінемін! Ол Араға ұқсайды және де Ара сияқты қозғалады!
Dialogue: 0,0:13:21.05,0:13:23.39,Default,,0,0,0,,Майорния сіздің жалған екеніңізді біледі.
Dialogue: 0,0:13:23.39,0:13:26.06,Default,,0,0,0,,Асгардқа оралыңыз және нақты иесін күтіңіз.
Dialogue: 0,0:13:26.06,0:13:28.06,Default,,0,0,0,,Балғаны пайдалана алмайтын ара?
Dialogue: 0,0:13:28.06,0:13:30.71,Default,,0,0,0,,Ақшасы жоқ Тони сияқты. Апыр-ай.
Dialogue: 0,0:13:30.71,0:13:33.72,Default,,0,0,0,,Мордок әлі де қалқанды бақылауда.
Dialogue: 0,0:13:33.72,0:13:35.70,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ！
Dialogue: 0,0:13:35.70,0:13:37.72,Default,,0,0,0,,ｽｸﾗﾝﾌﾞﾙ！
Dialogue: 0,0:13:37.72,0:13:43.39,Default,,0,0,0,,♪♪～
Dialogue: 0,0:13:43.39,0:13:46.39,Default,,0,0,0,,Уф... Мен Тонидің осылай істегенін көп көрдім.
Dialogue: 0,0:13:48.38,0:13:50.38,Default,,0,0,0,,Мынадай
Dialogue: 0,0:13:52.37,0:13:54.37,Default,,0,0,0,,Халк! Мінеки!
Dialogue: 0,0:13:54.37,0:13:56.39,Default,,0,0,0,,Жоқ, иә... ЖЕСІР!
Dialogue: 0,0:13:56.39,0:13:58.42,Default,,0,0,0,,Мен солаймын
Dialogue: 0,0:13:58.42,0:14:01.21,Default,,0,0,0,,Әйтеуір, Халктың денесіндегі жігіт есікті тарс еткіз.
Dialogue: 0,0:14:01.21,0:14:03.21,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:03.21,0:14:09.37,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:09.37,0:14:11.37,Default,,0,0,0,,А...
Dialogue: 0,0:14:11.37,0:14:14.04,Default,,0,0,0,,Әрқашан иығыңды пайдалан, басыңды пайдаланба.
Dialogue: 0,0:14:14.04,0:14:16.21,Default,,0,0,0,,Хмм... Түсіндім.
Dialogue: 0,0:14:16.21,0:14:24.13,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:24.13,0:14:26.37,Default,,0,0,0,,Трикария қашан арулар үйіне айналды?
Dialogue: 0,0:14:26.37,0:14:30.04,Default,,0,0,0,,Ей, Темір адам, сен өз ойының туралы бірдеңе істей алмайсың ба?
Dialogue: 0,0:14:30.04,0:14:32.36,Default,,0,0,0,,Қазір не шықты? Нөл пайыз?
Dialogue: 0,0:14:32.36,0:14:35.03,Default,,0,0,0,,Бұл ойын емес, Hawkeye бағдарламасы.
Dialogue: 0,0:14:35.03,0:14:37.03,Default,,0,0,0,,Бұл тиімділікті арттыру бағдарламасы.
Dialogue: 0,0:14:37.03,0:14:41.53,Default,,0,0,0,,Мен 17-процентильмін. Бұл сауыт менің денемнің бір бөлігі сияқты.
Dialogue: 0,0:14:41.53,0:14:45.57,Default,,0,0,0,,Бұл Халктың тістерінен қатты ерекшеленеді. Олар өздерінің тістері сияқты емес.
Dialogue: 0,0:14:45.57,0:14:47.61,Default,,0,0,0,,Сіз оны соңғы рет қашан жылтыраттыңыз?
Dialogue: 0,0:14:47.61,0:14:50.19,Default,,0,0,0,,Не? Жылтырату дегенді қалай түсінесіңдер?
Dialogue: 0,0:14:50.19,0:14:52.73,Default,,0,0,0,,Мен 17-процентильде мәңгі қала алмаймын
Dialogue: 0,0:14:52.73,0:14:56.87,Default,,0,0,0,,Егер біз осы Ақыл тасын жапсақ, әр адамның денесі қалыпты жағдайға оралуы керек.
Dialogue: 0,0:14:56.87,0:15:00.85,Default,,0,0,0,,Алдымен мен тасы бар модемді табуым керек. Ал сұңқар ше?
Dialogue: 0,0:15:00.85,0:15:02.89,Default,,0,0,0,,Міне, уақыты!
Dialogue: 0,0:15:02.89,0:15:05.44,Default,,0,0,0,,Капитан кейпіндегі сұңқар. Қалқанға ➡ кіріңіз
Dialogue: 0,0:15:05.44,0:15:08.03,Default,,0,0,0,,Ақыл тасы бөлетін энергияны бақылай аламыз ба?
Dialogue: 0,0:15:08.03,0:15:10.05,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:15:10.05,0:15:14.70,Default,,0,0,0,,♪♪～
Dialogue: 0,0:15:14.70,0:15:16.72,Default,,0,0,0,,Бұл жаман! Бұл Халк Бастер!
Dialogue: 0,0:15:16.72,0:15:18.70,Default,,0,0,0,,Менің уақытым көп емес
Dialogue: 0,0:15:18.70,0:15:21.87,Default,,0,0,0,,Жарайды, бұл жүк қоймасы. Апыр-ай!
Dialogue: 0,0:15:21.87,0:15:23.97,Default,,0,0,0,,Avengers ойынын жою
Dialogue: 0,0:15:28.87,0:15:32.54,Default,,0,0,0,,Кешіріңіз, жүк қоймасына қалай жетуге болатынын айта аласыз ба?
Dialogue: 0,0:15:32.54,0:15:35.69,Default,,0,0,0,,Модек... Уау! Ол қабылданбаған сияқты!
Dialogue: 0,0:15:35.69,0:15:37.86,Default,,0,0,0,,ﾊﾙｸ･ｽﾏｯｼｭ！
Dialogue: 0,0:15:37.86,0:15:40.54,Default,,0,0,0,,Уф…
Dialogue: 0,0:15:40.54,0:15:44.41,Default,,0,0,0,,Уф... Екеуміз де бір-біріміздің қимыл-қозғалысын білеміз. Біз кемшілікке ұшырамауымыз керек.
Dialogue: 0,0:15:44.41,0:15:46.51,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:15:49.55,0:15:51.55,Default,,0,0,0,,Бұл оңай көрінді. Ха!
Dialogue: 0,0:15:54.56,0:15:56.58,Default,,0,0,0,,Ей!
Dialogue: 0,0:15:56.58,0:15:58.69,Default,,0,0,0,,Өздігінен қайтып келмейді ме?
Dialogue: 0,0:15:58.69,0:16:00.70,Default,,0,0,0,,ﾔｯ ﾊｯ！
Dialogue: 0,0:16:00.70,0:16:02.70,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:07.24,0:16:11.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:11.04,0:16:13.04,Default,,0,0,0,,ｳｨﾄﾞｳ･ｽﾏｯｼｭ！
Dialogue: 0,0:16:15.39,0:16:17.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:20.53,0:16:22.53,Default,,0,0,0,,Қайтып кел, маған қалдыр.
Dialogue: 0,0:16:25.87,0:16:29.04,Default,,0,0,0,,Ой, сәтсіздікке ұшыраған сияқтымыз. (Үру)
Dialogue: 0,0:16:29.04,0:16:32.20,Default,,0,0,0,,Капитан: Сауыт дененің бір бөлігі емес пе?
Dialogue: 0,0:16:32.20,0:16:37.38,Default,,0,0,0,,Уф... Уф... Әйтеуір, мен сені сындырайын.
Dialogue: 0,0:16:37.38,0:16:48.36,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:48.36,0:16:52.05,Default,,0,0,0,,Жебеге май құйдың ба? Мен таң қалдым, сіз жақсы идея таптыңыз.
Dialogue: 0,0:16:52.05,0:16:55.05,Default,,0,0,0,,Бақылағыштық және жылдам ойлау қабілеті
Dialogue: 0,0:16:55.05,0:16:57.70,Default,,0,0,0,,Сіз мұны жарылатын жебе деп ойладыңыз, солай ма?
Dialogue: 0,0:16:57.70,0:16:59.72,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:16:59.72,0:17:02.07,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:17:02.07,0:17:04.61,Default,,0,0,0,,Мен Видодан тағы сұрауым керек еді.
Dialogue: 0,0:17:04.61,0:17:07.23,Default,,0,0,0,,Бұл қызықты болды
Dialogue: 0,0:17:07.23,0:17:10.37,Default,,0,0,0,,Ақыры Халк болуға лайық болды.
Dialogue: 0,0:17:10.37,0:17:13.07,Default,,0,0,0,,Бас тарт, Модок. Біз...
Dialogue: 0,0:17:13.07,0:17:17.46,Default,,0,0,0,,Ей, сені кім есінен танып қалды? Мен түсінбедім.
Dialogue: 0,0:17:17.46,0:17:19.49,Default,,0,0,0,,Егер ес-түссіз болсаңыз, мұнда қалай келдіңіз?
Dialogue: 0,0:17:19.49,0:17:21.54,Default,,0,0,0,,Ештеңе етпейді, тасты ал.
Dialogue: 0,0:17:21.54,0:17:23.53,Default,,0,0,0,,Мен бұл әлсіз денеден шыққым келеді.
Dialogue: 0,0:17:23.53,0:17:26.88,Default,,0,0,0,,Әлсіз?
Dialogue: 0,0:17:26.88,0:17:28.90,Default,,0,0,0,,Мен мұны сұрадым, капитан.
Dialogue: 0,0:17:28.90,0:17:31.20,Default,,0,0,0,,Оң қолыңызды көтеріп, қуат жинаңыз.
Dialogue: 0,0:17:38.06,0:17:40.06,Default,,0,0,0,,Түскі асқа не жедің?
Dialogue: 0,0:17:40.06,0:17:42.76,Default,,0,0,0,,Мен оны қайта қоямын деп ойлаймын.
Dialogue: 0,0:17:52.88,0:17:56.03,Default,,0,0,0,,Хахаха! Мұны бәрі көре ала ма?
Dialogue: 0,0:17:56.03,0:17:59.05,Default,,0,0,0,,Әй, кек алушылар
Dialogue: 0,0:17:59.05,0:18:02.03,Default,,0,0,0,,Ақыл тасы жарылыс кезінде бүлінген сияқты.
Dialogue: 0,0:18:02.03,0:18:05.93,Default,,0,0,0,,Әзірге мен үлкен болдым.
Dialogue: 0,0:19:10.47,0:19:12.37,Default,,0,0,0,,Артқа шегін!
Dialogue: 0,0:19:12.37,0:19:15.37,Default,,0,0,0,,Мен Қызыл бас сүйекке өзімнің осы жағымды көрсеткім келеді.
Dialogue: 0,0:19:15.37,0:19:17.38,Default,,0,0,0,,Трикариямен ассимиляцияланған
Dialogue: 0,0:19:17.38,0:19:20.88,Default,,0,0,0,,Сонда оның денесі ес-түссіз болды ма?
Dialogue: 0,0:19:20.88,0:19:22.88,Default,,0,0,0,,Бұл өте жаман. Бұл не?
Dialogue: 0,0:19:22.88,0:19:25.72,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:19:25.72,0:19:27.72,Default,,0,0,0,,ｷﾞｬｰ！
Dialogue: 0,0:19:31.69,0:19:34.88,Default,,0,0,0,,Бұл менің денем емес екеніне қуаныштымын
Dialogue: 0,0:19:34.88,0:19:38.73,Default,,0,0,0,,Оны Modoc оқып жатыр. Ол Ақыл тасын жасырады.
Dialogue: 0,0:19:38.73,0:19:41.37,Default,,0,0,0,,Жарайды, бөлініп, денесін іздейік.
Dialogue: 0,0:19:41.37,0:19:43.37,Default,,0,0,0,,Алдымен тасты алуым керек.
Dialogue: 0,0:19:43.37,0:19:45.87,Default,,0,0,0,,Шұңқыр сұңқар, менімен бірге жүр.
Dialogue: 0,0:19:51.21,0:19:55.56,Default,,0,0,0,,Хоки, сіз шпиондық дайындықтан өттіңіз. Тыныш жүріңіз.
Dialogue: 0,0:19:55.56,0:19:58.62,Default,,0,0,0,,Мына етіктерге қарап, айт.
Dialogue: 0,0:19:58.62,0:20:00.55,Default,,0,0,0,,Бұл қуат қосқышы.
Dialogue: 0,0:20:00.55,0:20:04.21,Default,,0,0,0,,Modoc қандай да бір қуат көзіне қосылуға ниетті ме?
Dialogue: 0,0:20:04.21,0:20:06.86,Default,,0,0,0,,Әзірше ол назардан тыс қалды.
Dialogue: 0,0:20:06.86,0:20:08.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:08.86,0:20:13.25,Default,,0,0,0,,Дауыстап айт, жолым қашып кетті!
Dialogue: 0,0:20:13.25,0:20:16.87,Default,,0,0,0,,Хахахаха! Тіпті жасыратын жер бар ма?
Dialogue: 0,0:20:16.87,0:20:19.87,Default,,0,0,0,,Бұл режим три-кария!
Dialogue: 0,0:20:26.21,0:20:30.37,Default,,0,0,0,,А... Ендеше, қолыңды берші. (Сондықтан) Оны өрескел ұстамаңыз.
Dialogue: 0,0:20:30.37,0:20:32.37,Default,,0,0,0,,Бұл менің қолым, сондықтан жақсы.
Dialogue: 0,0:20:32.37,0:20:36.04,Default,,0,0,0,,Модоктың денесін Трикарияда жасырсам...
Dialogue: 0,0:20:36.04,0:20:40.06,Default,,0,0,0,,Мен мұны таңдаймын
Dialogue: 0,0:20:40.06,0:20:43.05,Default,,0,0,0,,Тони Миндстоун қауіпсіз. Миссия сәтті.
Dialogue: 0,0:20:43.05,0:20:45.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:48.03,0:20:50.93,Default,,0,0,0,,Дұрыс, менің міндетім
Dialogue: 0,0:20:52.87,0:20:56.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:56.38,0:20:59.18,Default,,0,0,0,,Бұл оның денесі. (Қара жесір) Әрине.
Dialogue: 0,0:21:05.87,0:21:08.40,Default,,0,0,0,,Кек алушылар өте дәрменсіз➡
Dialogue: 0,0:21:08.40,0:21:10.74,Default,,0,0,0,,Оны көретін күн келеді деп ойламаппын.
Dialogue: 0,0:21:10.74,0:21:14.74,Default,,0,0,0,,Құпия қоғам нақты жауынгерлік машина сияқты.
Dialogue: 0,0:21:16.71,0:21:18.71,Default,,0,0,0,,Денеңді Мордокқа берме!
Dialogue: 0,0:21:31.19,0:21:35.06,Default,,0,0,0,,Тони командасы жақсырақ жұмыс істейді деп үміттенемін...
Dialogue: 0,0:21:35.06,0:21:39.62,Default,,0,0,0,,Бұл ең нашар жоспар, Тони.
Dialogue: 0,0:21:39.62,0:21:42.12,Default,,0,0,0,,Жақсырақ стратегия болды ма?
Dialogue: 0,0:21:46.71,0:21:48.76,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:21:48.76,0:21:52.76,Default,,0,0,0,,Тордың денесі қаншалықты күшті екенін көрейік.
Dialogue: 0,0:21:58.04,0:22:01.52,Default,,0,0,0,,Бұл менің несием, солай ма? Қалағаныңды айт
Dialogue: 0,0:22:01.52,0:22:04.38,Default,,0,0,0,,Мордоктың шабуылын тоқтатуының бір ғана себебі бар.
Dialogue: 0,0:22:04.38,0:22:07.75,Default,,0,0,0,,Сонымен, сіз денеңізді қалаған жерге қойдыңыз ба?
Dialogue: 0,0:22:07.75,0:22:11.45,Default,,0,0,0,,Жарайды, жүктеп алуға дайын болыңыз.
Dialogue: 0,0:22:25.71,0:22:29.57,Default,,0,0,0,,Тони Мордоктың денесін тапты. Орын туралы ақпаратты жіберу.
Dialogue: 0,0:22:29.57,0:22:33.37,Default,,0,0,0,,Мен сіздің бұл денеге қайта кіруге тырысып жатқаныңызға сене алмаймын.
Dialogue: 0,0:22:33.37,0:22:37.04,Default,,0,0,0,,Бастауыш мектептің 3-сыныбында оқып жүрген кезімнен Хоки➡
Dialogue: 0,0:22:37.04,0:22:41.03,Default,,0,0,0,,Мен ешкімнен көмек сұраған емеспін, бірақ жебе атуды үйретіңізші.
Dialogue: 0,0:22:41.03,0:22:43.72,Default,,0,0,0,,Жоқ, мен бас тартамын. иә?
Dialogue: 0,0:22:43.72,0:22:46.39,Default,,0,0,0,,Сол дулыға миыңыздың жұмысын тоқтатты ма?
Dialogue: 0,0:22:46.39,0:22:50.04,Default,,0,0,0,,Біз болмаған адам болуға тырыспауымыз керек.
Dialogue: 0,0:22:50.04,0:22:52.04,Default,,0,0,0,,Тони Старк - Hawkeye емес
Dialogue: 0,0:22:52.04,0:22:54.71,Default,,0,0,0,,Йо-Йоны сағаттық бомбаға айналдыра алатын адам.
Dialogue: 0,0:22:54.71,0:22:57.38,Default,,0,0,0,,Денеңізге ілініп, өз жолыңызбен күреспеңіз➡
Dialogue: 0,0:22:57.38,0:22:59.38,Default,,0,0,0,,Біздің жеңу мүмкіндігіміз жоқ.
Dialogue: 0,0:23:04.75,0:23:07.39,Default,,0,0,0,,бастайық
Dialogue: 0,0:23:07.39,0:23:09.39,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:23:09.39,0:23:13.39,Default,,0,0,0,,Кек алушылар режимін тоқтатыңыз. Оның Ақыл тасын манипуляциялауға жол бермеңіз.
Dialogue: 0,0:23:22.04,0:23:24.37,Default,,0,0,0,,Хахаха...!
Dialogue: 0,0:23:24.37,0:23:28.03,Default,,0,0,0,,Мен сізді ангарда қамап отырғаныма өте қуаныштымын.
Dialogue: 0,0:23:28.03,0:23:30.03,Default,,0,0,0,,Күші бар
Dialogue: 0,0:23:33.02,0:23:35.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:35.05,0:23:38.05,Default,,0,0,0,,ﾎｰｸｱｲ！
Dialogue: 0,0:23:38.05,0:23:42.04,Default,,0,0,0,,Менің сауытыма керек нәрсе.
Dialogue: 0,0:23:42.04,0:23:44.74,Default,,0,0,0,,Маған қазір не керек
Dialogue: 0,0:23:47.36,0:23:49.40,Default,,0,0,0,,Гуах! Хоки дұрыс айтады
Dialogue: 0,0:23:49.40,0:23:54.04,Default,,0,0,0,,Кек алушылар Қазіргі денеңізге сай емес, өз жолыңызбен күресіңіз
Dialogue: 0,0:23:54.04,0:23:56.04,Default,,0,0,0,,Ұнады! Уф...
Dialogue: 0,0:23:58.04,0:24:00.04,Default,,0,0,0,,О!
Dialogue: 0,0:24:03.71,0:24:06.38,Default,,0,0,0,,Бұл Hulk шалбары шынымен де әуе.
Dialogue: 0,0:24:06.38,0:24:08.38,Default,,0,0,0,,Аһ!
Dialogue: 0,0:24:08.38,0:24:10.98,Default,,0,0,0,,ﾌｧﾙｺﾝ･ｽﾏｯｼｭ！
Dialogue: 0,0:24:13.04,0:24:16.74,Default,,0,0,0,,Ах! Хаа! Санаулы секундтар қалды
Dialogue: 0,0:24:19.43,0:24:21.43,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:24:26.70,0:24:29.71,Default,,0,0,0,,Модок, Таспен қоштасу.
Dialogue: 0,0:24:29.71,0:24:32.41,Default,,0,0,0,,(енеді)
Dialogue: 0,0:24:36.71,0:24:41.03,Default,,0,0,0,,Мен қандай болсам да, мен Одиннің ұлы Тормын!
Dialogue: 0,0:24:41.03,0:24:43.73,Default,,0,0,0,,Майорния, маған кел!
Dialogue: 0,0:24:45.72,0:24:48.42,Default,,0,0,0,,Арх! Хмф!
Dialogue: 0,0:24:57.03,0:25:01.04,Default,,0,0,0,,Не болды? Жер бетінде не ...
Dialogue: 0,0:25:01.04,0:25:04.04,Default,,0,0,0,,Кек алушылар сөйлейді. капитан
Dialogue: 0,0:25:04.04,0:25:06.69,Default,,0,0,0,,Мен енді сенің демін иіске алмаймын
Dialogue: 0,0:25:06.69,0:25:10.05,Default,,0,0,0,,Хм, менің тынысым сасық екеніне сенімдімін.
Dialogue: 0,0:25:10.05,0:25:12.38,Default,,0,0,0,,Сальто қалай жасайсыз?
Dialogue: 0,0:25:12.38,0:25:16.04,Default,,0,0,0,,Менің сауытымды қару ретінде қолдануға болатынын ешқашан ойламадым.
Dialogue: 0,0:25:16.04,0:25:19.37,Default,,0,0,0,,Бұл не... бұл...?
Dialogue: 0,0:25:19.37,0:25:21.41,Default,,0,0,0,,Кешіріңіз. Гайя!
Dialogue: 0,0:25:21.41,0:25:24.46,Default,,0,0,0,,Мақсат! Сонымен?
Dialogue: 0,0:25:24.46,0:25:27.40,Default,,0,0,0,,115 пайыз
Dialogue: 0,0:25:27.40,0:25:31.07,Default,,0,0,0,,Біреу бұл мүмкін емес деді.
Dialogue: 0,0:25:31.07,0:25:34.77,Default,,0,0,0,,Мен тек өз шеңберімде ойладым.
Dialogue: 0,0:25:37.07,0:25:39.43,Default,,0,0,0,,Старк, бұл өте қауіпті.
Dialogue: 0,0:25:39.43,0:25:43.38,Default,,0,0,0,,Ақыл тасын сіздің мұнараңызда емес, қалқанда сақтау керек.
Dialogue: 0,0:25:43.38,0:25:47.07,Default,,0,0,0,,Қаһар Соңғы уақытта халықтың қалқанға деген көзқарасы өзгеруде.
Dialogue: 0,0:25:47.07,0:25:49.07,Default,,0,0,0,,Modoc-қа хакерлік шабуыл жасалды.
Dialogue: 0,0:25:49.07,0:25:52.45,Default,,0,0,0,,Бұл ерекшелік. Қауіпсіздік қазірдің өзінде қалпына келтірілді.
Dialogue: 0,0:25:52.45,0:25:55.71,Default,,0,0,0,,Жарайды, мен сені тірілтемін. Бірақ мен саған Ақыл тасын бермеймін.
Dialogue: 0,0:25:55.71,0:25:57.74,Default,,0,0,0,,Байланысты тоқтату
Dialogue: 0,0:25:57.74,0:25:59.73,Default,,0,0,0,,Бұл Фьюриге қарсы теледидар ойынын ойнау сияқты.
Dialogue: 0,0:25:59.73,0:26:02.43,Default,,0,0,0,,Мен жоғары балл алдым.
Dialogue: 0,0:26:36.08,0:26:39.37,Default,,0,0,0,,<«Кек алушылар жиналады» фильмінде пайда болатын супер қаһармандар, жауыздар және т.б. туралы ақпарат➡
Dialogue: 0,0:26:39.37,0:26:41.37,Default,,0,0,0,,Осы жерге жиналыңыз!
Dialogue: 0,0:26:41.37,0:26:43.37,Default,,0,0,0,,Бұл жолы таныстыратынымыз →
Dialogue: 0,0:26:45.36,0:26:47.36,Default,,0,0,0,,<Капитан Американың жауы
Dialogue: 0,0:26:47.36,0:26:50.05,Default,,0,0,0,,Компьютер сияқты данышпан миы бар➡
Dialogue: 0,0:26:50.05,0:26:54.03,Default,,0,0,0,,Қарсыласыңызға адамнан тыс ақыл-ой күшімен шабуыл жасаңыз➡
Dialogue: 0,0:26:54.03,0:26:58.43,Default,,0,0,0,,Бір уақытта көп адамдарды басқара алады＞
Dialogue: 0,0:26:59.93,0:27:05.93,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
