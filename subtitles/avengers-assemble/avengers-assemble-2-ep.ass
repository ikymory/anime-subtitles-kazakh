Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:39.30,0:00:41.80,Default,,0,0,0,,Бұл Кек алушылармен уәде!
Dialogue: 0,0:00:45.78,0:00:48.08,Default,,0,0,0,,<Кек алушылар, бұл супер қаһармандар➡
Dialogue: 0,0:00:48.08,0:00:51.23,Default,,0,0,0,,Жиналған ең күшті батырлар командасы
Dialogue: 0,0:00:51.23,0:00:53.25,Default,,0,0,0,,Өзіңіздің трансценденттік күшіңізді жинаңыз➡
Dialogue: 0,0:00:53.25,0:00:55.25,Default,,0,0,0,,Жер бетіндегі бейбітшілікті қорға! ＞
Dialogue: 0,0:00:55.25,0:00:57.25,Default,,0,0,0,,Күте тұрыңыз. Мен сізге дереу көмектесуге келемін.
Dialogue: 0,0:00:57.25,0:00:59.24,Default,,0,0,0,,＜ﾊｲﾃｸｱｰﾏｰ ｱｲｱﾝﾏﾝ
Dialogue: 0,0:00:59.24,0:01:01.76,Default,,0,0,0,,Адамнан тыс сарбаз Капитан Америка
Dialogue: 0,0:01:01.76,0:01:03.81,Default,,0,0,0,,Найзағай Құдайы Тор
Dialogue: 0,0:01:03.81,0:01:05.71,Default,,0,0,0,,Жасыл алып Халк>
Dialogue: 0,0:01:05.71,0:01:07.71,Default,,0,0,0,,Бұл көңілді болатын сияқты!
Dialogue: 0,0:01:09.68,0:01:12.25,Default,,0,0,0,,＜ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:12.25,0:01:15.22,Default,,0,0,0,,Шабуылдаушы зұлым зұлымға қарсы тұрыңыз>
Dialogue: 0,0:01:15.22,0:01:17.27,Default,,0,0,0,,Қарсылас қандай болса да, мен жеңілмеймін.
Dialogue: 0,0:01:17.27,0:01:19.33,Default,,0,0,0,,<Дыбыс! Әділет құпия сөзі>
Dialogue: 0,0:01:19.33,0:01:21.33,Default,,0,0,0,,ｱﾍﾞﾝｼﾞｬｰｽﾞ･ｱｯｾﾝﾌﾞﾙ！
Dialogue: 0,0:01:35.41,0:01:37.36,Default,,0,0,0,,Сіз Grim Reaper-ді тоқтатқыңыз келе ме?
Dialogue: 0,0:01:37.36,0:01:39.60,Default,,0,0,0,,Бұл би билейтін уақыт емес.
Dialogue: 0,0:01:39.60,0:01:41.73,Default,,0,0,0,,Ол Арсеналдың денесін босаңсытып жатыр.
Dialogue: 0,0:01:41.73,0:01:44.40,Default,,0,0,0,,Қараңызшы, ол менің сауытымдай жұмыс істейді.
Dialogue: 0,0:01:44.40,0:01:46.79,Default,,0,0,0,,Қозғалыс күшінің артуы
Dialogue: 0,0:01:46.79,0:01:50.59,Default,,0,0,0,,Қозғаушы күш 23 пайызға жоғары
Dialogue: 0,0:01:50.59,0:01:52.58,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:01:52.58,0:01:54.86,Default,,0,0,0,,Бұл үлкен мәселе. Бірақ бұл таңқаларлық емес.
Dialogue: 0,0:01:54.86,0:01:57.93,Default,,0,0,0,,Бұл менің әкемнің дизайны болатын. Бұл әкемнің ең үлкен өнертабысы.
Dialogue: 0,0:01:57.93,0:02:01.28,Default,,0,0,0,,Бұл нағыз шедевр. Ха
Dialogue: 0,0:02:01.28,0:02:03.70,Default,,0,0,0,,Грим Реапер қорғаныс шебін бұзып өтті.
Dialogue: 0,0:02:03.70,0:02:05.69,Default,,0,0,0,,Тони, көңіл бөл.
Dialogue: 0,0:02:05.69,0:02:08.74,Default,,0,0,0,,Арсенал Барлығына өз күшіңізді көрсетіңіз
Dialogue: 0,0:02:08.74,0:02:12.04,Default,,0,0,0,,Тони түсіндім
Dialogue: 0,0:02:15.75,0:02:18.05,Default,,0,0,0,,Қол шапалақтау деп аталады.
Dialogue: 0,0:02:23.62,0:02:26.12,Default,,0,0,0,,Сіз өзіңіздің қазіргі шабуылыңызбен бар күшіңізді салып жатырсыз ба?
Dialogue: 0,0:02:28.51,0:02:31.73,Default,,0,0,0,,Грим Реапердің жауы емес
Dialogue: 0,0:02:31.73,0:02:34.73,Default,,0,0,0,,Әй, бұл осылай. Біз сенің қарсыласың боламыз.
Dialogue: 0,0:02:34.73,0:02:39.92,Default,,0,0,0,,Темір адам. Бұл кім? Темір бала ма?
Dialogue: 0,0:02:39.92,0:02:43.39,Default,,0,0,0,,Тыңда, егер сен ойыншықтарды сындыра берсең, онымен ешкім ойнамайды.
Dialogue: 0,0:02:43.39,0:02:47.76,Default,,0,0,0,,Мен ойнауға келген жоқпын. Мен жоюға келдім!
Dialogue: 0,0:02:47.76,0:02:52.74,Default,,0,0,0,,ﾔｯ！ ｳｯ！
Dialogue: 0,0:02:52.74,0:02:56.77,Default,,0,0,0,,Электромагниттік импульс? Бұл жаңа техника ма? (Джервис) Ескерту функциясы тоқтады
Dialogue: 0,0:02:56.77,0:02:59.69,Default,,0,0,0,,Саған да дұрыс өмір сүруге мүмкіндік беремін!
Dialogue: 0,0:02:59.69,0:03:02.80,Default,,0,0,0,,Дұрыс. Қаш, қорқақ.
Dialogue: 0,0:03:02.80,0:03:04.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:08.87,0:03:11.92,Default,,0,0,0,,Мен сені негізгі бағдарлама бойынша қорғадым.
Dialogue: 0,0:03:11.92,0:03:14.57,Default,,0,0,0,,Мен жақсы боламын. Зұлым адамды қуыңыз.
Dialogue: 0,0:03:14.57,0:03:16.76,Default,,0,0,0,,[Үндеткіш] Қол жеткізу рұқсаты
Dialogue: 0,0:03:16.76,0:03:21.20,Default,,0,0,0,,ﾊﾊｯ！
Dialogue: 0,0:03:21.20,0:03:25.02,Default,,0,0,0,,[Спикер] Отқа дайын
Dialogue: 0,0:03:25.02,0:03:28.74,Default,,0,0,0,,[ｽﾋﾟｰｶ]ﾀｰｹﾞｯﾄ ｱﾍﾞﾝｼﾞｬｰｽﾞ･ﾀﾜｰ
Dialogue: 0,0:03:28.74,0:03:30.91,Default,,0,0,0,,ﾊﾊｯ！
Dialogue: 0,0:03:30.91,0:03:35.41,Default,,0,0,0,,Мұны тек мұнарамен жасауға болмайды! Нью-Йорктің жартысы таң қалды!
Dialogue: 0,0:03:35.41,0:03:39.53,Default,,0,0,0,,Сонымен, Манхэттенге зымыран ұшырылды. Тез кел!
Dialogue: 0,0:03:39.53,0:03:42.75,Default,,0,0,0,,Мен қай жерде болу керектігін білемін
Dialogue: 0,0:03:42.75,0:03:45.39,Default,,0,0,0,,Зымырандарды тоқтат, бұл бұйрық.
Dialogue: 0,0:03:45.39,0:03:47.86,Default,,0,0,0,,Негізгі бағдарламаны елемеу керек пе?
Dialogue: 0,0:03:47.86,0:03:50.91,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:03:50.91,0:03:53.38,Default,,0,0,0,,Ахх. (Джервис) Құрыш қайта іске қосылғанша →
Dialogue: 0,0:03:53.38,0:03:55.38,Default,,0,0,0,,3 минут қалды
Dialogue: 0,0:04:05.09,0:04:08.04,Default,,0,0,0,,Мына затты күннің ортасына тастайын ба?
Dialogue: 0,0:04:08.04,0:04:11.05,Default,,0,0,0,,Ах, сондықтан деректер ракетаның траекториясын өзгертетінін көрсетеді→
Dialogue: 0,0:04:11.05,0:04:13.20,Default,,0,0,0,,Жарылу үшін жасалған
Dialogue: 0,0:04:13.20,0:04:17.09,Default,,0,0,0,,Ха, мен қазір сене алмаймын...
Dialogue: 0,0:04:17.09,0:04:19.19,Default,,0,0,0,,ｿｰ！
Dialogue: 0,0:05:43.31,0:05:45.41,Default,,0,0,0,,Жоқ, ол тірі!
Dialogue: 0,0:05:48.91,0:05:52.08,Default,,0,0,0,,Тониге рахмет. Энергияны сақтау
Dialogue: 0,0:05:52.08,0:05:55.89,Default,,0,0,0,,Маған сол сиқырлы амалды үйретсеңші. Хаха!
Dialogue: 0,0:05:55.89,0:05:58.19,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:06:02.14,0:06:05.24,Default,,0,0,0,,Кек алушылар мүмкін емес нәрсені мүмкін етеді
Dialogue: 0,0:06:09.58,0:06:12.85,Default,,0,0,0,,Иә? Арсеналдан Кек алушыларға?
Dialogue: 0,0:06:12.85,0:06:15.87,Default,,0,0,0,,Олай болса, менің кофеқайнатқышымды қосасыз ба?
Dialogue: 0,0:06:15.87,0:06:19.98,Default,,0,0,0,,30 мегатонналық зымырандарды тоқтатсақ та, сіз оны әлі қабылдамайсыз ба?
Dialogue: 0,0:06:19.98,0:06:22.48,Default,,0,0,0,,Біз мойындаймыз
Dialogue: 0,0:06:25.20,0:06:29.25,Default,,0,0,0,,Маған ұнады. Бұл жігіт Торға қарағанда қиынырақ.
Dialogue: 0,0:06:29.25,0:06:33.69,Default,,0,0,0,,Және ол Халктың иісіне ұқсамайды. Үшеуміз бірге айтысайық.
Dialogue: 0,0:06:33.69,0:06:36.09,Default,,0,0,0,,Кешіріңіз, бірақ менің Арсеналда үй тапсырмасы бар.
Dialogue: 0,0:06:36.09,0:06:40.23,Default,,0,0,0,,Оқу? Бұл қызық емес. Smash әлдеқайда қызықты!
Dialogue: 0,0:06:40.23,0:06:42.75,Default,,0,0,0,,Барлығына айт, мен сені кейін көремін.
Dialogue: 0,0:06:42.75,0:06:45.24,Default,,0,0,0,,Кездескенше, бәріміз.
Dialogue: 0,0:06:45.24,0:06:47.24,Default,,0,0,0,,ﾌﾝ…
Dialogue: 0,0:06:47.24,0:06:50.22,Default,,0,0,0,,Роботтар тірі адамдар сияқты жауынгерлік рухқа ие→
Dialogue: 0,0:06:50.22,0:06:52.29,Default,,0,0,0,,Мүлдем жоқ.
Dialogue: 0,0:06:52.29,0:06:56.59,Default,,0,0,0,,Мен Арсенал 100 пайыз мінсіз деп айтпаймын, бірақ...
Dialogue: 0,0:06:58.60,0:07:01.90,Default,,0,0,0,,Ой... хехе! Жоқ, бұл тамаша болды
Dialogue: 0,0:07:04.92,0:07:06.89,Default,,0,0,0,,Сіз бұл үшін төлеуіңіз керек.
Dialogue: 0,0:07:06.89,0:07:09.33,Default,,0,0,0,,Кіріс қоңырау, директор Фюри.
Dialogue: 0,0:07:09.33,0:07:12.56,Default,,0,0,0,,Кек алушылар, менің туған жеріме жақындамаңдар.
Dialogue: 0,0:07:12.56,0:07:14.58,Default,,0,0,0,,Жоғалған орман құлады
Dialogue: 0,0:07:14.58,0:07:18.57,Default,,0,0,0,,Қарсылас флотының көлемін ескере отырып, шығынды барынша азайту керек еді.
Dialogue: 0,0:07:18.57,0:07:23.24,Default,,0,0,0,,Ең аз!? Бұл көп кепілдік зиян ба?
Dialogue: 0,0:07:23.24,0:07:25.74,Default,,0,0,0,,ｻﾉｽ…
Dialogue: 0,0:07:25.74,0:07:29.25,Default,,0,0,0,,Мен сенен тағы сұрайын, Қызыл бас сүйек.
Dialogue: 0,0:07:29.25,0:07:31.28,Default,,0,0,0,,Санос қайда орналасқан?
Dialogue: 0,0:07:31.28,0:07:35.69,Default,,0,0,0,,Бес... Күш... Рух...
Dialogue: 0,0:07:35.69,0:07:39.69,Default,,0,0,0,,Сен сондай бейбақпен аралассаң не болатынын білесің бе?
Dialogue: 0,0:07:39.69,0:07:41.69,Default,,0,0,0,,Мидың зақымдануы
Dialogue: 0,0:07:41.69,0:07:44.74,Default,,0,0,0,,Мәліметтерді мағынасы жоқ әңгімелерден алуға болады.
Dialogue: 0,0:07:44.74,0:07:46.80,Default,,0,0,0,,Жер бетінде қалай?
Dialogue: 0,0:07:46.80,0:07:49.30,Default,,0,0,0,,Өйткені сен оған үйреніп қалғансың
Dialogue: 0,0:07:51.30,0:07:55.54,Default,,0,0,0,,ｳｫｯﾁｬｰ･ﾚﾎﾟｰﾄ 51108
Dialogue: 0,0:07:55.54,0:07:58.22,Default,,0,0,0,,Апат жақын
Dialogue: 0,0:07:58.22,0:08:01.21,Default,,0,0,0,,Титан жауынгері Таностың белгісі жоқ→
Dialogue: 0,0:08:01.21,0:08:05.18,Default,,0,0,0,,Ол жақында Пауэр Stone-ді қайтарады.
Dialogue: 0,0:08:05.18,0:08:08.79,Default,,0,0,0,,Мен жердегілерді аяймын, бірақ... (соққы дыбыс)
Dialogue: 0,0:08:08.79,0:08:10.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:14.24,0:08:17.19,Default,,0,0,0,,Жарайсың, Арсенал! ғарыш кемесі келді
Dialogue: 0,0:08:17.19,0:08:20.28,Default,,0,0,0,,Маған күшіңді көрсет. Мен саған күшімді көрсетемін.
Dialogue: 0,0:08:20.28,0:08:24.58,Default,,0,0,0,,Пауэр Stone сынағын бастау
Dialogue: 0,0:08:34.29,0:08:36.29,Default,,0,0,0,,Джарвис! Сынақ тоқтатылды
Dialogue: 0,0:08:38.20,0:08:40.77,Default,,0,0,0,,Модельдеудің соңы
Dialogue: 0,0:08:40.77,0:08:44.19,Default,,0,0,0,,Арсенал Пауэр Stone пайдаланса, дүние жойылады ма?
Dialogue: 0,0:08:44.19,0:08:47.74,Default,,0,0,0,,Жоқ, олай емес. Бүкіл ғалам аяқталуы мүмкін.
Dialogue: 0,0:08:47.74,0:08:50.76,Default,,0,0,0,,Ол қуат тасты басқара алмайды.
Dialogue: 0,0:08:50.76,0:08:53.75,Default,,0,0,0,,Бірақ оны бұрынғы зымыран сияқты сақтауға болады.
Dialogue: 0,0:08:53.75,0:08:56.75,Default,,0,0,0,,Жиналған қуат қайда кетті?
Dialogue: 0,0:08:56.75,0:08:59.19,Default,,0,0,0,,Схемалар шет тілі сияқты
Dialogue: 0,0:08:59.19,0:09:03.21,Default,,0,0,0,,Менің әкем бір нәрсені басқаларға жеткізуде нашар.
Dialogue: 0,0:09:03.21,0:09:07.54,Default,,0,0,0,,Әке... Мен Арсеналға арналған нұсқаулықты алғым келді.
Dialogue: 0,0:09:07.54,0:09:09.55,Default,,0,0,0,,болуы керек
Dialogue: 0,0:09:09.55,0:09:12.58,Default,,0,0,0,,Тони... Сәлем! Бұл менің әкем
Dialogue: 0,0:09:12.58,0:09:15.54,Default,,0,0,0,,Сізге Арсенал ұнайды деп үміттенемін.
Dialogue: 0,0:09:15.54,0:09:19.11,Default,,0,0,0,,Сіздің досыңыз. Бұл не?
Dialogue: 0,0:09:19.11,0:09:23.56,Default,,0,0,0,,Менің жадымда әкемнің 108 голограммасы бар.
Dialogue: 0,0:09:23.56,0:09:26.16,Default,,0,0,0,,Менің әкемнің голограммасы соншалықты үлкен бе?
Dialogue: 0,0:09:28.28,0:09:33.85,Default,,0,0,0,,Сізді қорғау үшін Арсенал артық энергияны басқа өлшемге жібере алады.
Dialogue: 0,0:09:33.85,0:09:37.86,Default,,0,0,0,,Қажет болса, оны қайтарып алуға болады, бірақ кейін ол жоғалады.
Dialogue: 0,0:09:37.86,0:09:41.26,Default,,0,0,0,,Бұл күрделі, бірақ сен ақылды баласың.
Dialogue: 0,0:09:41.26,0:09:43.73,Default,,0,0,0,,Ақылды - бұл төмен баға.
Dialogue: 0,0:09:43.73,0:09:47.25,Default,,0,0,0,,Арсеналда сіз футбол, бейсбол және баскетбол ойнай аласыз.
Dialogue: 0,0:09:47.25,0:09:51.27,Default,,0,0,0,,Кешіріңіз, ескі және бүлінген файлдар бар.
Dialogue: 0,0:09:51.27,0:09:53.57,Default,,0,0,0,,Мен өскенде ол жерде болмасам...
Dialogue: 0,0:09:53.57,0:09:56.23,Default,,0,0,0,,Бұл шашыңызды қырудың ең жақсы тәсілі.
Dialogue: 0,0:09:56.23,0:09:59.65,Default,,0,0,0,,Әрине, Арсенал мені алмастырмайды...
Dialogue: 0,0:09:59.65,0:10:01.65,Default,,0,0,0,,Тони! Сәл күте тұрыңыз...Харвард!?
Dialogue: 0,0:10:01.65,0:10:05.03,Default,,0,0,0,,Менің әкем өзінің голограммасын Арсеналда жаттап алған.
Dialogue: 0,0:10:05.03,0:10:07.09,Default,,0,0,0,,Мен Ховардты қайта көретініме сене алар емеспін.
Dialogue: 0,0:10:07.09,0:10:10.97,Default,,0,0,0,,Арсенал сенің досың ба? Әлде бұл қару ма?
Dialogue: 0,0:10:10.97,0:10:14.21,Default,,0,0,0,,[Монитор] Менің артымнан жүріңіз. Маған қолдау көрсетіңіздерші.
Dialogue: 0,0:10:14.21,0:10:16.56,Default,,0,0,0,,Ха... у...
Dialogue: 0,0:10:16.56,0:10:19.65,Default,,0,0,0,,А, қазірдің өзінде! Біз дерлік құтқару нүктесінде болдық!!
Dialogue: 0,0:10:19.65,0:10:22.64,Default,,0,0,0,,Әй, біреу! Келетін қонақтар бар ма?
Dialogue: 0,0:10:22.64,0:10:25.24,Default,,0,0,0,,Ол үлкен жылдамдықпен келеді. Апыр-ай!
Dialogue: 0,0:10:29.26,0:10:31.18,Default,,0,0,0,,Қап…
Dialogue: 0,0:10:31.18,0:10:35.38,Default,,0,0,0,,Бұл мені таң қалдырды! Сіз бақылаушысыз ба?
Dialogue: 0,0:10:35.38,0:10:39.45,Default,,0,0,0,,Адам қанша ұлы болса да, біреудің үйіне барғанда→
Dialogue: 0,0:10:39.45,0:10:41.45,Default,,0,0,0,,Сіз оны қағып кетесіз!
Dialogue: 0,0:10:45.24,0:10:49.23,Default,,0,0,0,,Бұл Санос! Ол айда. Бұл шақыру.
Dialogue: 0,0:10:49.23,0:10:51.93,Default,,0,0,0,,Айдан бақылаушы лақтырдың ба?
Dialogue: 0,0:10:51.93,0:10:54.27,Default,,0,0,0,,Маған электрондық хат жіберсеңіз екен.
Dialogue: 0,0:10:54.27,0:10:57.22,Default,,0,0,0,,Бұл өте батыл, бірақ бұл Таностың тұзағы болуы мүмкін.
Dialogue: 0,0:10:57.22,0:11:00.52,Default,,0,0,0,,Бұл қақпан ба, жоқ па, мен бір нәрсені қайтаруым керек.
Dialogue: 0,0:11:05.38,0:11:08.28,Default,,0,0,0,,Thanos нысанаға алған нәрсе - бұл қуат тасы.
Dialogue: 0,0:11:08.28,0:11:11.53,Default,,0,0,0,,Роботты не үшін әкелдің? Егер біз жойылып кетсе →
Dialogue: 0,0:11:11.53,0:11:14.44,Default,,0,0,0,,Таносты тоқтата алатын жалғыз нәрсе - Пауэр Stone.
Dialogue: 0,0:11:14.44,0:11:17.54,Default,,0,0,0,,Сіз байсалдысыз ба? Сәтсіздіктің қорытынды кітабын қараңыз →
Dialogue: 0,0:11:17.54,0:11:19.61,Default,,0,0,0,,Сіз стратегияны жоспарлап жатқан шығарсыз, солай ма?
Dialogue: 0,0:11:19.61,0:11:22.61,Default,,0,0,0,,Ескерту объектісі жақындады
Dialogue: 0,0:11:22.61,0:11:26.21,Default,,0,0,0,,Мен ай тасын алғым келді
Dialogue: 0,0:12:43.28,0:12:45.98,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:12:45.98,0:12:49.48,Default,,0,0,0,,ﾌﾌ
Dialogue: 0,0:12:52.20,0:12:57.64,Default,,0,0,0,,Пауэр Stone Ақыры оны қайтардым, бұл менікі.
Dialogue: 0,0:12:57.64,0:13:01.64,Default,,0,0,0,,Бос болса ше!? Апыр-ай!
Dialogue: 0,0:13:05.77,0:13:08.58,Default,,0,0,0,,Жарайсыңдар, бәріміз Айдағы көгілдір аймаққа келдік.
Dialogue: 0,0:13:08.58,0:13:10.69,Default,,0,0,0,,Мұнда атмосфера бар
Dialogue: 0,0:13:10.69,0:13:14.26,Default,,0,0,0,,Екі болды ма? Уф!
Dialogue: 0,0:13:14.26,0:13:16.41,Default,,0,0,0,,Сен мені өте жақсы алдадың, Видо.
Dialogue: 0,0:13:16.41,0:13:19.30,Default,,0,0,0,,Avenget туралы не деуге болады? Буби бомбалары туралы не деуге болады?
Dialogue: 0,0:13:19.30,0:13:22.01,Default,,0,0,0,,Негізгі шпиондық технология. Ұнайды.
Dialogue: 0,0:13:22.01,0:13:24.92,Default,,0,0,0,,Бірақ егер бұл алдамшы болса, сіз экрандалған ғарыш кемесін пайдалана аласыз ба?
Dialogue: 0,0:13:24.92,0:13:28.70,Default,,0,0,0,,Арсенал Тыңдаңыз, Саносқа жақындамаңыз.
Dialogue: 0,0:13:28.70,0:13:32.36,Default,,0,0,0,,Сіздің отбасыңыз ешқандай жолмен араласа алмайды, солай ма?
Dialogue: 0,0:13:32.36,0:13:36.60,Default,,0,0,0,,Мен де сен үшін Саносты ұрамын.
Dialogue: 0,0:13:36.60,0:13:38.75,Default,,0,0,0,,Сіз Таноссыз ба?
Dialogue: 0,0:13:38.75,0:13:41.25,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:13:41.25,0:13:45.09,Default,,0,0,0,,Бұл сіз алған энергияны сіңіретін түрме. Мен оны ойлап таптым, солай ма?
Dialogue: 0,0:13:45.09,0:13:48.49,Default,,0,0,0,,Неғұрлым көп ұрсаң, түрме соғұрлым күшті болады.
Dialogue: 0,0:13:48.49,0:13:50.34,Default,,0,0,0,,Мұқият тыңда, Жер.
Dialogue: 0,0:13:50.34,0:13:54.26,Default,,0,0,0,,Сенің досың Red Skull мені ұрлап кетті.
Dialogue: 0,0:13:54.26,0:13:56.80,Default,,0,0,0,,Сіз біздің доссыз ба? Сен қалжыңдап тұрсың ба?
Dialogue: 0,0:13:56.80,0:13:59.35,Default,,0,0,0,,Бір ғана ұсыныс айтайын.
Dialogue: 0,0:13:59.35,0:14:03.96,Default,,0,0,0,,Менің ұрлағанымды қайтарсаң, дүниеңе тиіспеймін.
Dialogue: 0,0:14:03.96,0:14:07.19,Default,,0,0,0,,Жаманмен мәміле жасап, ғаламды жаулап алуға талпыну→
Dialogue: 0,0:14:07.19,0:14:10.65,Default,,0,0,0,,Мәселе мынада: сенуге болмайды.
Dialogue: 0,0:14:10.65,0:14:13.87,Default,,0,0,0,,Содан кейін не болғанына қарамастан, қалағаныңызды жасаңыз→
Dialogue: 0,0:14:13.87,0:14:16.92,Default,,0,0,0,,Бұл сіздің жауапкершілігіңіз.
Dialogue: 0,0:14:16.92,0:14:19.62,Default,,0,0,0,,Уау
Dialogue: 0,0:14:19.62,0:14:22.42,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:14:24.91,0:14:28.21,Default,,0,0,0,,Адам технологиясы және т.б. Титандар үшін→
Dialogue: 0,0:14:28.21,0:14:31.81,Default,,0,0,0,,Бұл баланың ойыншығы. Delta Nine шабуыл үлгісі
Dialogue: 0,0:14:34.77,0:14:38.09,Default,,0,0,0,,Уау
Dialogue: 0,0:14:38.09,0:14:40.59,Default,,0,0,0,,ﾄﾆｰ
Dialogue: 0,0:14:44.53,0:14:46.53,Default,,0,0,0,,Уау
Dialogue: 0,0:14:46.53,0:14:50.25,Default,,0,0,0,,Бұл Халк Смашер, мен жақсартқан жарылғыш көрсеткі.
Dialogue: 0,0:14:50.25,0:14:52.42,Default,,0,0,0,,Бірақ атын өзгертейік
Dialogue: 0,0:14:52.42,0:14:54.72,Default,,0,0,0,,ﾁｸﾀｸ…
Dialogue: 0,0:14:56.89,0:14:59.99,Default,,0,0,0,,Bon? Сұңқарды көтеріңізші.
Dialogue: 0,0:15:04.63,0:15:06.73,Default,,0,0,0,,Уау! Уау~
Dialogue: 0,0:15:09.39,0:15:11.91,Default,,0,0,0,,Жақында қуат тасты қолданасыз ба?
Dialogue: 0,0:15:11.91,0:15:14.53,Default,,0,0,0,,Айдың жартысы ұшып кетеді. Жақсы емес.
Dialogue: 0,0:15:14.53,0:15:16.80,Default,,0,0,0,,Бұл соншалықты көп күш.
Dialogue: 0,0:15:16.80,0:15:19.40,Default,,0,0,0,,Фокустау құралынсыз
Dialogue: 0,0:15:21.62,0:15:25.62,Default,,0,0,0,,Ей, бақылаушы, мен құралдарды пайдалануға рұқсат етіңіз.
Dialogue: 0,0:15:33.25,0:15:35.40,Default,,0,0,0,,(Итадори) «Ха! Кугисаки, сол қанға тиме!»
Dialogue: 0,0:15:35.40,0:15:38.10,Default,,0,0,0,,[Радио] Капитан Менде бір ой бар. Маған қолдауыңызды жіберіңіз.
Dialogue: 0,0:15:38.10,0:15:40.15,Default,,0,0,0,,Үшеуі Тониге барады.
Dialogue: 0,0:15:40.15,0:15:42.25,Default,,0,0,0,,Мен жаңа ғана кетіп қалдым
Dialogue: 0,0:15:47.68,0:15:50.78,Default,,0,0,0,,Wow~ Watcher технологиясы керемет.
Dialogue: 0,0:15:50.78,0:15:53.08,Default,,0,0,0,,Кек алушылар осында.
Dialogue: 0,0:15:55.35,0:15:58.70,Default,,0,0,0,,Бұл алып газ планетасының өзегінде пайда болған линза.
Dialogue: 0,0:15:58.70,0:16:01.09,Default,,0,0,0,,Ол Халктың ішінде жасалды ма?
Dialogue: 0,0:16:01.09,0:16:04.74,Default,,0,0,0,,Оның көмегімен Арсенал Пауэр Stone-ға назар аудара алады.
Dialogue: 0,0:16:04.74,0:16:08.41,Default,,0,0,0,,Дұрыс. Falcon Watcher жүйесін пайдалану→
Dialogue: 0,0:16:08.41,0:16:12.54,Default,,0,0,0,,Санос туралы мәлімет жинау. Hawkeye линзаларын жинауға арналған контейнер табыңыз.
Dialogue: 0,0:16:12.54,0:16:14.95,Default,,0,0,0,,Жесір, құрылғыны бөлшектеуге көмектесіңізші.
Dialogue: 0,0:16:14.95,0:16:17.25,Default,,0,0,0,,Қуанышпен
Dialogue: 0,0:16:22.03,0:16:25.63,Default,,0,0,0,,Үйі бұзылса да бұл жігіт ашуланбайды ма?
Dialogue: 0,0:16:25.63,0:16:29.93,Default,,0,0,0,,Мен тек бақылаймын.
Dialogue: 0,0:16:33.91,0:16:36.24,Default,,0,0,0,,ﾌﾌﾌﾌ
Dialogue: 0,0:16:36.24,0:16:38.98,Default,,0,0,0,,Маған майорния бер, арамза.
Dialogue: 0,0:16:38.98,0:16:41.58,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:16:45.43,0:16:47.59,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:47.59,0:16:50.89,Default,,0,0,0,,Сізде не болуы мүмкін?
Dialogue: 0,0:16:50.89,0:16:54.08,Default,,0,0,0,,Егер мен сені балғамен ұра алмасам→
Dialogue: 0,0:16:54.08,0:16:58.01,Default,,0,0,0,,Жарайды, сен мені балғамен ұрғанша!
Dialogue: 0,0:16:58.01,0:17:03.19,Default,,0,0,0,,Бұл керемет. Watcher жүйесі - галактикааралық интернет. Жақсы!
Dialogue: 0,0:17:03.19,0:17:06.22,Default,,0,0,0,,Танос Титандар деп аталатын жауынгерлер руынан шыққан.
Dialogue: 0,0:17:06.22,0:17:09.38,Default,,0,0,0,,Бұл не... менің өз планетама?
Dialogue: 0,0:17:09.38,0:17:11.76,Default,,0,0,0,,Гипериондар өте сүйкімді.
Dialogue: 0,0:17:11.76,0:17:16.03,Default,,0,0,0,,Мына жерде бақылаушы қарап тұр. Сондай-ақ өте әсерлі қарулар бар.
Dialogue: 0,0:17:16.03,0:17:20.13,Default,,0,0,0,,Бізге керегі жалғыз қару – күш тасы, үміт нұры.
Dialogue: 0,0:17:26.76,0:17:30.70,Default,,0,0,0,,ұшыруға дайындық аяқталды. (Халк) Ооо!
Dialogue: 0,0:17:30.70,0:17:34.75,Default,,0,0,0,,Халк? Уау
Dialogue: 0,0:17:34.75,0:17:37.54,Default,,0,0,0,,Үміт нұры әлі алыс
Dialogue: 0,0:17:37.54,0:17:42.21,Default,,0,0,0,,Жер бетіндегі ең күшті болсаң→
Dialogue: 0,0:17:42.21,0:17:44.96,Default,,0,0,0,,Жер бітті!
Dialogue: 0,0:17:44.96,0:17:47.26,Default,,0,0,0,,Ой, ай дірілдеп тұр
Dialogue: 0,0:18:49.26,0:18:51.86,Default,,0,0,0,,Уау! Уау~
Dialogue: 0,0:18:51.86,0:18:54.81,Default,,0,0,0,,Мен қайтадан қарызға баттым ба?
Dialogue: 0,0:18:54.81,0:18:56.91,Default,,0,0,0,,Токува
Dialogue: 0,0:19:02.79,0:19:05.59,Default,,0,0,0,,Балалар, бұл туралы уайымдауға уақыт жоқ.
Dialogue: 0,0:19:07.58,0:19:09.88,Default,,0,0,0,,Линзаларды жинаңыз
Dialogue: 0,0:19:12.30,0:19:14.60,Default,,0,0,0,,Га. Эй!
Dialogue: 0,0:19:17.19,0:19:19.57,Default,,0,0,0,,Мен біреуін алдым
Dialogue: 0,0:19:19.57,0:19:21.91,Default,,0,0,0,,Бұл қағып алған допқа ұқсайды.
Dialogue: 0,0:19:21.91,0:19:24.59,Default,,0,0,0,,Бұл екінші линза.
Dialogue: 0,0:19:24.59,0:19:26.59,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:31.07,0:19:35.39,Default,,0,0,0,,Олар қызықты адамдар. Осындай стақан үшін →
Dialogue: 0,0:19:35.39,0:19:37.39,Default,,0,0,0,,Сіз не ойнап жатырсыз?
Dialogue: 0,0:19:39.86,0:19:42.48,Default,,0,0,0,,Ойнайық. Қызық, бұл қандай ойын?
Dialogue: 0,0:19:42.48,0:19:44.48,Default,,0,0,0,,Енді 3 бөлік
Dialogue: 0,0:19:50.04,0:19:52.77,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:19:52.77,0:19:54.87,Default,,0,0,0,,Жарайды, өтінемін.
Dialogue: 0,0:19:58.41,0:20:00.56,Default,,0,0,0,,Фуфуфу! Ууууууууууу!
Dialogue: 0,0:20:00.56,0:20:03.05,Default,,0,0,0,,Сіздің ойыншықтарыңыз жұмыс істемейді!
Dialogue: 0,0:20:03.05,0:20:05.10,Default,,0,0,0,,Бұл Арсеналдың ашылуы.
Dialogue: 0,0:20:05.10,0:20:13.10,Default,,0,0,0,,Ол адам қуанады…
Dialogue: 0,0:20:22.92,0:20:25.57,Default,,0,0,0,,Тони миссиясы аяқталды.
Dialogue: 0,0:20:25.57,0:20:29.26,Default,,0,0,0,,Бұл тамаша болды. (Танос) Уау!
Dialogue: 0,0:20:29.26,0:20:31.66,Default,,0,0,0,,Мен оны ұстау үшін ешқандай құралсыз→
Dialogue: 0,0:20:31.66,0:20:34.13,Default,,0,0,0,,Сіз мені Пауэр Stone алуға келді деп ойладыңыз ба?
Dialogue: 0,0:20:34.13,0:20:37.73,Default,,0,0,0,,Қараңызшы, бұл Infinity Gauntlet!
Dialogue: 0,0:20:45.56,0:20:48.66,Default,,0,0,0,,Ей, менің Арсенаммен араласпа!
Dialogue: 0,0:20:50.85,0:20:53.90,Default,,0,0,0,,Хмф! Уф!
Dialogue: 0,0:20:53.90,0:20:57.14,Default,,0,0,0,,Мен бұл сауытты сенің табытыңа айналдырамын.
Dialogue: 0,0:20:57.14,0:20:59.94,Default,,0,0,0,,Уау! Тони!
Dialogue: 0,0:21:03.64,0:21:06.94,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:21:10.30,0:21:12.80,Default,,0,0,0,,♬~
Dialogue: 0,0:21:17.19,0:21:19.22,Default,,0,0,0,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,0:21:19.22,0:21:21.82,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:21:23.86,0:21:25.86,Default,,0,0,0,,ﾌﾝ
Dialogue: 0,0:21:25.86,0:21:29.90,Default,,0,0,0,,Кек алушылар Сіз менің ұсынысымды қабылдамады.
Dialogue: 0,0:21:29.90,0:21:34.22,Default,,0,0,0,,Сіздің әлеміңіз аяқталуда
Dialogue: 0,0:21:34.22,0:21:37.91,Default,,0,0,0,,Сәтсіздіктің қорытынды кітабына жаңа беттер қосылады
Dialogue: 0,0:21:37.91,0:21:40.25,Default,,0,0,0,,Әрқашан қарсы тұрудың жолдары бар.
Dialogue: 0,0:21:40.25,0:21:42.55,Default,,0,0,0,,Falcon Watcher деректерін тексеріңіз.
Dialogue: 0,0:21:42.55,0:21:45.15,Default,,0,0,0,,Күшті тастың әлсіз жағы болуы керек.
Dialogue: 0,0:21:47.70,0:21:51.09,Default,,0,0,0,,Мен олай ойламаймын. Бұл шынымен берік тас.
Dialogue: 0,0:21:51.09,0:21:54.19,Default,,0,0,0,,Бұл дүниенің соңы болмаса, әсерлі күш.
Dialogue: 0,0:21:54.19,0:21:57.03,Default,,0,0,0,,Сонымен, Infinity Gauntlet туралы не деуге болады?
Dialogue: 0,0:21:57.03,0:21:59.23,Default,,0,0,0,,Бұл да мүмкін емес.
Dialogue: 0,0:21:59.23,0:22:03.10,Default,,0,0,0,,Оны жою үшін көп энергия қажет. Шамамен 10 мегатонна.
Dialogue: 0,0:22:03.10,0:22:06.29,Default,,0,0,0,,Дайын. Grim Reaper ұшырған зымыран→
Dialogue: 0,0:22:06.29,0:22:08.29,Default,,0,0,0,,Сіңірілген
Dialogue: 0,0:22:10.24,0:22:12.56,Default,,0,0,0,,Сізді қорғау үшін →
Dialogue: 0,0:22:12.56,0:22:16.08,Default,,0,0,0,,Арсенал артық энергияны басқа өлшемге жібере алады
Dialogue: 0,0:22:16.08,0:22:18.08,Default,,0,0,0,,Жалғасы
Dialogue: 0,0:22:18.08,0:22:23.57,Default,,0,0,0,,Қажет болса қайтарып алуға болады, бірақ кейін ол жоғалады.
Dialogue: 0,0:22:23.57,0:22:26.96,Default,,0,0,0,,Жоқ, мен рұқсат ете алмаймын. Басқа амал жоқ.
Dialogue: 0,0:22:26.96,0:22:31.26,Default,,0,0,0,,Дұрыс. Бұл қиын болуы мүмкін, бірақ жер біздің басты басымдығымыз.
Dialogue: 0,0:22:33.58,0:22:36.45,Default,,0,0,0,,Тони, менің бір ғана миссиям бар.
Dialogue: 0,0:22:36.45,0:22:39.91,Default,,0,0,0,,Сізді қорғау үшін. Рұқсат.
Dialogue: 0,0:22:39.91,0:22:43.29,Default,,0,0,0,,Жарайды, жасайық.
Dialogue: 0,0:22:43.29,0:22:47.76,Default,,0,0,0,,Біріншіден, энергия жиілігін өлшеу үшін қуат тасты қолдану керек.
Dialogue: 0,0:22:47.76,0:22:52.40,Default,,0,0,0,,Бұл Саностың туған қаласынан Watcher әкелген кәдесый.
Dialogue: 0,0:22:52.40,0:22:54.50,Default,,0,0,0,,Мен оны мазақ етемін
Dialogue: 0,0:23:05.26,0:23:07.95,Default,,0,0,0,,ﾌｯﾌｯﾌｯﾌｯ…
Dialogue: 0,0:23:07.95,0:23:10.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:18.98,0:23:21.58,Default,,0,0,0,,Жооо! О~
Dialogue: 0,0:23:27.32,0:23:29.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:34.54,0:23:36.55,Default,,0,0,0,,Уф!
Dialogue: 0,0:23:36.55,0:23:38.55,Default,,0,0,0,,Титан әскерінің қаруы ма?
Dialogue: 0,0:23:38.55,0:23:40.93,Default,,0,0,0,,Мен оларды жойған кезде→
Dialogue: 0,0:23:40.93,0:23:43.32,Default,,0,0,0,,Бұл мүлдем пайдасыз болды.
Dialogue: 0,0:23:43.32,0:23:46.82,Default,,0,0,0,,Бірақ бұл жолы қарсылас - Кек алушылар.
Dialogue: 0,0:23:49.96,0:23:51.96,Default,,0,0,0,,Уф!
Dialogue: 0,0:23:54.85,0:23:57.23,Default,,0,0,0,,Жарайды, 87 Terra Heltu.
Dialogue: 0,0:23:57.23,0:23:59.55,Default,,0,0,0,,Осы жиілікке энергия шығысын реттеңіз
Dialogue: 0,0:23:59.55,0:24:01.55,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:24:18.25,0:24:21.25,Default,,0,0,0,,Олар күлкілі табанды.
Dialogue: 0,0:24:23.31,0:24:27.20,Default,,0,0,0,,Неліктен сонша күресіп, көп уақытты босқа өткізесіз?
Dialogue: 0,0:24:27.20,0:24:30.25,Default,,0,0,0,,Күресуге қабілетті болу да талант.
Dialogue: 0,0:24:30.25,0:24:33.24,Default,,0,0,0,,ﾊｯ！
Dialogue: 0,0:24:33.24,0:24:38.24,Default,,0,0,0,,Хахахаха... Тіпті достарым мені тастап кетті.
Dialogue: 0,0:24:38.24,0:24:41.89,Default,,0,0,0,,Нағыз күштен қорқады
Dialogue: 0,0:24:41.89,0:24:45.25,Default,,0,0,0,,Жоқ, Санос. Достар нағыз күш.
Dialogue: 0,0:24:45.25,0:24:48.20,Default,,0,0,0,,Арсенал. Қош бол Тони
Dialogue: 0,0:24:48.20,0:24:50.24,Default,,0,0,0,,Не!?
Dialogue: 0,0:24:50.24,0:24:53.84,Default,,0,0,0,,Ой~!
Dialogue: 0,0:24:57.56,0:25:00.16,Default,,0,0,0,,Арсеналға рахмет
Dialogue: 0,0:25:10.24,0:25:14.18,Default,,0,0,0,,Әлемді құтқару үшін құрбандық қажет.
Dialogue: 0,0:25:14.18,0:25:17.80,Default,,0,0,0,,Дүниені қорғау... құрбандықты қажет етеді.
Dialogue: 0,0:25:17.80,0:25:19.80,Default,,0,0,0,,Әлем...
Dialogue: 0,0:25:22.55,0:25:25.59,Default,,0,0,0,,Менің ойымша, Санос әлі де бір жерде →
Dialogue: 0,0:25:25.59,0:25:27.54,Default,,0,0,0,,Мен тыныш ұйықтай алмаймын
Dialogue: 0,0:25:27.54,0:25:29.86,Default,,0,0,0,,Мен ғарышқа ұшып кеттім.
Dialogue: 0,0:25:29.86,0:25:33.58,Default,,0,0,0,,Қуат тасы сынды. Танос қорықпау керек.
Dialogue: 0,0:25:33.58,0:25:36.57,Default,,0,0,0,,Арсеналды қалпына келтіруді жоспарлап отырсыз ба?
Dialogue: 0,0:25:36.57,0:25:39.52,Default,,0,0,0,,Мен оны қайтармайынша бас тартпаймын
Dialogue: 0,0:25:39.52,0:25:42.54,Default,,0,0,0,,Сәлем Тони
Dialogue: 0,0:25:42.54,0:25:46.24,Default,,0,0,0,,Мен қателестім. Бұл жай робот емес еді.
Dialogue: 0,0:25:46.24,0:25:50.55,Default,,0,0,0,,Бұл жігіт кек алушылар
Dialogue: 0,0:25:50.55,0:25:54.12,Default,,0,0,0,,Бір күні бұл сөздерді тікелей айтыңыз.
Dialogue: 0,0:25:54.12,0:25:56.64,Default,,0,0,0,,Түзетіңізші, данышпан.
Dialogue: 0,0:25:56.64,0:25:58.74,Default,,0,0,0,,Мен Дартс кек алғым келеді
Dialogue: 0,0:26:00.77,0:26:03.77,Default,,0,0,0,,Жоқ, алдымен допты қағып ал.
Dialogue: 0,0:26:36.29,0:26:38.19,Default,,0,0,0,,<“Кек алушылар жиналады” →
Dialogue: 0,0:26:38.19,0:26:40.20,Default,,0,0,0,,Супер қаһармандар, жауыздар және т.б. туралы ақпарат →
Dialogue: 0,0:26:40.20,0:26:42.26,Default,,0,0,0,,Осы жерге жиналыңыз!
Dialogue: 0,0:26:42.26,0:26:44.68,Default,,0,0,0,,Бұл жолы біз Саноспен таныстырамыз
Dialogue: 0,0:26:44.68,0:26:47.72,Default,,0,0,0,,Сатурнның серігі Титаннан келген бақылаушы
Dialogue: 0,0:26:47.72,0:26:50.26,Default,,0,0,0,,Құдіреті зор алты әшекей→
Dialogue: 0,0:26:50.26,0:26:52.59,Default,,0,0,0,,Барлық шексіздік тастарын жинаңыз →
Dialogue: 0,0:26:52.59,0:26:55.26,Default,,0,0,0,,Бүкіл ғаламды өз меншігіне айналдыру жоспарлары
Dialogue: 0,0:26:55.26,0:26:57.98,Default,,0,0,0,,Адамнан тыс физикалық күш пен төзімділікпен мақтанады→
Dialogue: 0,0:26:57.98,0:27:01.28,Default,,0,0,0,,Кеңістік энергиясын жұтып, шығара алады＞
Dialogue: 0,0:27:02.78,0:27:08.78,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
