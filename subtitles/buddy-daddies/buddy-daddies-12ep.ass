Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.67,0:00:06.17,Default,,0,0,0,,Бұл жылдам!
Dialogue: 0,0:00:06.25,0:00:06.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:06.92,0:00:09.59,Default,,0,0,0,,Оян~ Оян~ Кокекокко!
Dialogue: 0,0:00:09.67,0:00:10.63,Default,,0,0,0,,Ұйқы…
Dialogue: 0,0:00:10.71,0:00:12.13,Default,,0,0,0,,Ой! (Нөл) Гуаа!
Dialogue: 0,0:00:12.22,0:00:13.38,Default,,0,0,0,,Киахахаха! (Нөл) Жоқ...
Dialogue: 0,0:00:13.47,0:00:16.05,Default,,0,0,0,,Таңертеңнен бері толқыдым.
Dialogue: 0,0:00:16.55,0:00:18.47,Default,,0,0,0,,Уа, қар жауып тұр!
Dialogue: 0,0:00:18.56,0:00:21.02,Default,,0,0,0,,Ой, қар жауып тұр!
Dialogue: 0,0:00:21.10,0:00:22.10,Default,,0,0,0,,Ойна!
Dialogue: 0,0:00:22.18,0:00:24.64,Default,,0,0,0,,Иә, иә, оған дейін таңғы ас ішейік.
Dialogue: 0,0:00:24.73,0:00:25.98,Default,,0,0,0,,Таңғы ас?
Dialogue: 0,0:00:29.52,0:00:31.11,Default,,0,0,0,,Жасайық, Мири
Dialogue: 0,0:00:31.19,0:00:32.36,Default,,0,0,0,,О!
Dialogue: 0,0:00:41.83,0:00:43.71,Default,,0,0,0,,Жағымды иіс~
Dialogue: 0,0:00:45.62,0:00:47.21,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:00:50.30,0:00:51.71,Default,,0,0,0,,Мен ойладым: «Бұл – британдық көк мысық».
Dialogue: 0,0:00:51.80,0:00:53.47,Default,,0,0,0,,Ммм
Dialogue: 0,0:00:54.67,0:00:56.55,Default,,0,0,0,,Уф... Мен өттім!
Dialogue: 0,0:00:56.63,0:00:59.55,Default,,0,0,0,,Иә! Хехе...
Dialogue: 0,0:00:59.64,0:01:03.64,Default,,0,0,0,,Ммм~ Оны салыңыз...
Dialogue: 0,0:01:03.73,0:01:06.19,Default,,0,0,0,,Ах! Мен кірдім~
Dialogue: 0,0:01:06.27,0:01:07.40,Default,,0,0,0,,Сіз бірдеңені ұмыттыңыз ба?
Dialogue: 0,0:01:07.48,0:01:08.27,Default,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,0:01:08.35,0:01:09.23,Default,,0,0,0,,Орамал ше?
Dialogue: 0,0:01:09.31,0:01:10.19,Default,,0,0,0,,Мен ұмытып қалдым~
Dialogue: 0,0:01:10.86,0:01:11.40,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:01:11.48,0:01:13.69,Default,,0,0,0,,Рахмет сізге Папа!
Dialogue: 0,0:01:14.49,0:01:16.45,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:01:16.53,0:01:19.12,Default,,0,0,0,,Қар~! Кяхаха!
Dialogue: 0,0:01:19.20,0:01:21.12,Default,,0,0,0,,Ей, құлама.
Dialogue: 0,0:01:21.62,0:01:24.20,Default,,0,0,0,,Ақ Рождество дегеніміз не?
Dialogue: 0,0:01:24.70,0:01:26.75,Default,,0,0,0,,Миридің келгеніне бір жыл болды.
Dialogue: 0,0:01:26.83,0:01:29.33,Default,,0,0,0,,Сонымен етіктер де кішірейе ме?
Dialogue: 0,0:01:29.42,0:01:32.00,Default,,0,0,0,,Жақын болсаңыз, өсуді байқамайсыз.
Dialogue: 0,0:01:32.09,0:01:33.55,Default,,0,0,0,,Қараңдар, қараңдар!
Dialogue: 0,0:01:34.26,0:01:35.97,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:01:36.05,0:01:37.51,Default,,0,0,0,,Аяз ата?
Dialogue: 0,0:01:37.59,0:01:38.80,Default,,0,0,0,,Пинг теннисі
Dialogue: 0,0:01:39.39,0:01:42.31,Default,,0,0,0,,Эй, Мири, сыйлыққа не алғың келеді?
Dialogue: 0,0:01:42.39,0:01:43.81,Default,,0,0,0,,Сыйлық па?
Dialogue: 0,0:01:43.89,0:01:46.39,Default,,0,0,0,,Мен Аяз атаға айтамын.
Dialogue: 0,0:01:46.48,0:01:48.81,Default,,0,0,0,,Саған сыйлық әкелетініне сенімдімін.
Dialogue: 0,0:01:48.90,0:01:52.57,Default,,0,0,0,,Аяз ата анасынан жақсылық сұрады.
Dialogue: 0,0:01:52.65,0:01:55.19,Default,,0,0,0,,О, а... солай ма?
Dialogue: 0,0:01:55.28,0:01:56.86,Default,,0,0,0,,Әй, уақыт таяп қалды.
Dialogue: 0,0:01:56.95,0:01:59.07,Default,,0,0,0,,Әй... О, дұрыс.
Dialogue: 0,0:02:01.16,0:02:04.58,Default,,0,0,0,,♪ ғұн ғұн хун хун
Dialogue: 0,0:02:09.79,0:02:11.84,Default,,0,0,0,,Бұл Аяз ата!
Dialogue: 0,0:02:12.42,0:02:15.00,Default,,0,0,0,,Мен сені алып кеткеніме немесе түсіргеніме біраз болды.
Dialogue: 0,0:02:15.09,0:02:16.46,Default,,0,0,0,,Бет тым бос
Dialogue: 0,0:02:16.55,0:02:17.26,Default,,0,0,0,,Ендеше, ертең кездескенше.
Dialogue: 0,0:02:17.34,0:02:19.09,Default,,0,0,0,,Қайырлы таң, Милли-чан
Dialogue: 0,0:02:19.68,0:02:21.34,Default,,0,0,0,,Қайырлы таң Анна Чан!
Dialogue: 0,0:02:21.43,0:02:23.14,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:23.22,0:02:25.01,Default,,0,0,0,,Бүгін екеуің ғана.
Dialogue: 0,0:02:25.10,0:02:26.81,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:02:26.89,0:02:30.52,Default,,0,0,0,,Сіз бүгін кешке анаңызбен Рождестволық кеш өткізесіз бе?
Dialogue: 0,0:02:30.60,0:02:33.31,Default,,0,0,0,,Ал... тек мен және Нөл...
Dialogue: 0,0:02:33.40,0:02:35.02,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:02:35.11,0:02:37.15,Default,,0,0,0,,Мама, келмейсіз бе?
Dialogue: 0,0:02:39.07,0:02:40.45,Default,,0,0,0,,Білесің бе, Мири
Dialogue: 0,0:02:40.53,0:02:43.53,Default,,0,0,0,,Анам біраз уақытқа кетіп қалады.
Dialogue: 0,0:02:43.62,0:02:46.04,Default,,0,0,0,,Милли: Біз көп ән айтамыз ба?
Dialogue: 0,0:02:46.12,0:02:48.04,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:02:48.12,0:02:50.83,Default,,0,0,0,,Анам да естімейтіні ұят деді.
Dialogue: 0,0:02:50.92,0:02:52.33,Default,,0,0,0,,А, бірақ...
Dialogue: 0,0:02:52.42,0:02:54.09,Default,,0,0,0,,Қараңдар, бұл Аяз ата.
Dialogue: 0,0:02:54.17,0:02:56.17,Default,,0,0,0,,Маған сыйлықтар беруге көмектесіңізші.
Dialogue: 0,0:02:56.25,0:02:58.59,Default,,0,0,0,,Сіз сұраған сияқтысыз...
Dialogue: 0,0:02:59.38,0:03:01.68,Default,,0,0,0,,Мама, келмейсіз бе?
Dialogue: 0,0:03:01.76,0:03:03.05,Default,,0,0,0,,Миллиметр…
Dialogue: 0,0:03:03.72,0:03:07.39,Default,,0,0,0,,Олай болса, анама жету үшін қатты ән салайық.
Dialogue: 0,0:03:08.43,0:03:11.27,Default,,0,0,0,,Папа Нөл мен Папа Кадзу бізді көруге келеді, солай ма?
Dialogue: 0,0:03:11.35,0:03:12.44,Default,,0,0,0,,Әрине
Dialogue: 0,0:03:12.52,0:03:13.35,Default,,0,0,0,,Келіңіз және көріңіз
Dialogue: 0,0:03:13.44,0:03:14.98,Default,,0,0,0,,Әрине, солай ма?
Dialogue: 0,0:03:15.06,0:03:17.07,Default,,0,0,0,,Мүлдем (нөл) Мен уәде беремін.
Dialogue: 0,0:03:17.15,0:03:18.94,Default,,0,0,0,,Уәде! (Нөл) Иә?
Dialogue: 0,0:03:19.03,0:03:20.45,Default,,0,0,0,,Юбикири!
Dialogue: 0,0:03:21.99,0:03:22.86,Default,,0,0,0,,Кемсітушілік?
Dialogue: 0,0:03:22.95,0:03:23.70,Default,,0,0,0,,Мен
Dialogue: 0,0:03:25.45,0:03:27.29,Default,,0,0,0,,♪ Юбикири Генман
Dialogue: 0,0:03:27.37,0:03:31.71,Default,,0,0,0,,♪ Өтірік айтсаң жазаланасың.
Dialogue: 0,0:03:31.79,0:03:34.00,Default,,0,0,0,,♪ Ол жоғалды
Dialogue: 0,0:03:34.08,0:03:35.29,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:03:36.71,0:03:38.05,Default,,0,0,0,,Милли-чан
Dialogue: 0,0:03:38.13,0:03:39.88,Default,,0,0,0,,А~со~бо~
Dialogue: 0,0:03:39.96,0:03:41.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:42.76,0:03:44.55,Default,,0,0,0,,Әкелер кездескенше!
Dialogue: 0,0:03:44.64,0:03:46.97,Default,,0,0,0,,О, кейінірек.
Dialogue: 0,0:03:47.47,0:03:52.06,Default,,0,0,0,,Милли-чан, мен бүгін қатты ән айтып жаттығатынмын.
Dialogue: 0,0:03:52.14,0:03:54.19,Default,,0,0,0,,Оны асыға күтіңіз.
Dialogue: 0,0:03:54.77,0:03:55.61,Default,,0,0,0,,Иә (нөл) Иә
Dialogue: 0,0:04:02.95,0:04:05.20,Default,,0,0,0,,Рақмет. Кешіріңіз.
Dialogue: 0,0:04:13.79,0:04:17.34,Default,,0,0,0,,Кешіріңіз, Хиса-чан, мен сізге қауіпті көпірден өтуге рұқсат бердім.
Dialogue: 0,0:04:17.42,0:04:20.84,Default,,0,0,0,,Мен де анамның ісіне жауаптымын.
Dialogue: 0,0:04:21.34,0:04:23.84,Default,,0,0,0,,Себебі Миридің жеке куәлігі жалған.
Dialogue: 0,0:04:23.93,0:04:26.97,Default,,0,0,0,,Полиция біраз уақыт балабақшаға назар аудармайды.
Dialogue: 0,0:04:27.05,0:04:28.22,Default,,0,0,0,,Бұл пайдалы.
Dialogue: 0,0:04:28.72,0:04:29.97,Default,,0,0,0,,Сіздің жарақатыңыз қалай?
Dialogue: 0,0:04:30.06,0:04:32.73,Default,,0,0,0,,А, мен ауруды басатын дәрі ішейін.
Dialogue: 0,0:04:32.81,0:04:33.85,Default,,0,0,0,,Мысал қандай?
Dialogue: 0,0:04:33.94,0:04:35.81,Default,,0,0,0,,Мен дайындалдым, бірақ...
Dialogue: 0,0:04:36.40,0:04:38.94,Default,,0,0,0,,Балалар, сендер не істейсіңдер?
Dialogue: 0,0:04:39.02,0:04:40.57,Default,,0,0,0,,Талқылау
Dialogue: 0,0:04:41.07,0:04:42.90,Default,,0,0,0,,Бұл адам талқылауға келді ме?
Dialogue: 0,0:04:42.99,0:04:44.03,Default,,0,0,0,,Иә
Dialogue: 0,0:04:44.11,0:04:46.74,Default,,0,0,0,,Бұл жігіттің отбасы жаман сөйлейді.
Dialogue: 0,0:04:47.66,0:04:49.83,Default,,0,0,0,,Оларға соңына дейін қамқорлық жасаңыз
Dialogue: 0,0:04:50.58,0:04:51.33,Default,,0,0,0,,Хиса-чан...
Dialogue: 0,0:04:52.45,0:04:54.37,Default,,0,0,0,,Егер бізге бірдеңе болса
Dialogue: 0,0:04:54.46,0:04:56.83,Default,,0,0,0,,Оның орнына Мириге Рождестволық сыйлық беріңіз...
Dialogue: 0,0:04:56.92,0:04:59.54,Default,,0,0,0,,Қосымша қолайсыздықтар үшін кешірім сұраймыз.
Dialogue: 0,0:05:00.04,0:05:03.46,Default,,0,0,0,,Сыйлық болса, өзіңіз жеткізіңіз.
Dialogue: 0,0:05:15.60,0:05:16.89,Default,,0,0,0,,Аяз ата?
Dialogue: 0,0:05:17.40,0:05:18.19,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:18.27,0:05:20.94,Default,,0,0,0,,Сіз Мириге оны киіп, көрсетіңіз деп жатырсыз, солай ма?
Dialogue: 0,0:05:21.02,0:05:23.82,Default,,0,0,0,,Мұндай бақыт Хиса-чанға ұқсамайды.
Dialogue: 0,0:05:24.40,0:05:27.78,Default,,0,0,0,,Биік ұшсаң да ұйымнан қашып құтыла алмайсың.
Dialogue: 0,0:05:28.28,0:05:32.95,Default,,0,0,0,,Егер мені қуатын болса, мен сыртқа шығып, мәселені шешкенім жөн.
Dialogue: 0,0:05:33.04,0:05:36.58,Default,,0,0,0,,Ақылға қонымсыз болып көрінсе де, біз ойлап тапқан адам осы.
Dialogue: 0,0:05:36.66,0:05:39.71,Default,,0,0,0,,Мұны істеудің бір ғана жолы бар
Dialogue: 0,0:05:40.84,0:05:43.71,Default,,0,0,0,,Эй, сен Аяз атаға сендің бе?
Dialogue: 0,0:05:43.80,0:05:45.97,Default,,0,0,0,,Иә? Бұл кенеттен не болды?
Dialogue: 0,0:05:46.47,0:05:48.63,Default,,0,0,0,,Ата-анамның жүзін де білмеймін
Dialogue: 0,0:05:48.72,0:05:51.14,Default,,0,0,0,,Сіз сыйлық ала алмайсыз.
Dialogue: 0,0:05:51.22,0:05:53.77,Default,,0,0,0,,Мен Аяз атаға сенбеймін.
Dialogue: 0,0:05:54.27,0:05:55.73,Default,,0,0,0,,Мен де солай болдым.
Dialogue: 0,0:05:56.73,0:05:59.85,Default,,0,0,0,,Мен Мириге бірінші кездескен кезден сендім.
Dialogue: 0,0:05:59.94,0:06:02.44,Default,,0,0,0,,А... Түсіндім, дұрыс.
Dialogue: 0,0:06:03.40,0:06:06.74,Default,,0,0,0,,Баланың арманын қорғау ата-ананың міндеті емес пе?
Dialogue: 0,0:06:08.24,0:06:10.24,Default,,0,0,0,,Өтірік айтсаң да
Dialogue: 0,0:06:10.32,0:06:12.95,Default,,0,0,0,,Ересек болу өте қиын!
Dialogue: 0,0:06:13.03,0:06:15.62,Default,,0,0,0,,Тапсырмаларыңызды тез аяқтап, Аяз атаны көріңіз...
Dialogue: 0,0:06:15.70,0:06:17.41,Default,,0,0,0,,Мен Аяз атаға қамқор боламын.
Dialogue: 0,0:06:17.50,0:06:19.79,Default,,0,0,0,,Иә? Өзімді жасыру менің рөлім.
Dialogue: 0,0:06:19.87,0:06:21.54,Default,,0,0,0,,Жоқ, мен істеймін.
Dialogue: 0,0:06:21.63,0:06:23.63,Default,,0,0,0,,Сіз шынымен өзгердіңіз.
Dialogue: 0,0:06:24.13,0:06:25.84,Default,,0,0,0,,Дәлірек айтсақ, бұл екі киімге жетеді.
Dialogue: 0,0:06:25.92,0:06:27.42,Default,,0,0,0,,Иә? Бұл рас
Dialogue: 0,0:06:27.51,0:06:31.55,Default,,0,0,0,,Хиса-чан күткендей, сен сондай тапқырсың.
Dialogue: 0,0:06:37.98,0:06:42.02,Default,,0,0,0,,Енді жындар немесе жыландар бола ма?
Dialogue: 0,0:06:49.65,0:06:50.86,Default,,0,0,0,,Бұл Сува Нөл.
Dialogue: 0,0:06:50.95,0:06:52.32,Default,,0,0,0,,Бастыққа айтар сөзім бар.
Dialogue: 0,0:06:52.41,0:06:53.57,Default,,0,0,0,,Сізді күтуде.
Dialogue: 0,0:06:53.66,0:06:55.03,Default,,0,0,0,,Көліктен шығыңыз.
Dialogue: 0,0:06:59.12,0:07:01.42,Default,,0,0,0,,Бөксегіме тиме, тентек
Dialogue: 0,0:07:02.13,0:07:03.04,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:07:06.25,0:07:06.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:07.26,0:07:10.34,Default,,0,0,0,,Күте тұрыңыз, мені өзіңізбен бірге алып кетпейсіз бе?
Dialogue: 0,0:07:10.43,0:07:11.59,Default,,0,0,0,,Сіз осында болыңыз.
Dialogue: 0,0:07:12.22,0:07:15.51,Default,,0,0,0,,Әй, бұл Сува отбасының қарсы алу стилі ме?
Dialogue: 0,0:07:15.60,0:07:18.64,Default,,0,0,0,,Біз өзімізді ұстанып, сөйлесуге келдік.
Dialogue: 0,0:07:18.72,0:07:19.81,Default,,0,0,0,,Міне, осындай бір теория бар:
Dialogue: 0,0:07:20.31,0:07:21.06,Default,,0,0,0,,Эй
Dialogue: 0,0:07:21.56,0:07:24.73,Default,,0,0,0,,Ол менің серігім, мен оны өзіммен бірге алып кетемін.
Dialogue: 0,0:07:27.40,0:07:30.11,Default,,0,0,0,,Сіз өз ұстанымыңызды түсінбейтін сияқтысыз.
Dialogue: 0,0:07:30.61,0:07:32.20,Default,,0,0,0,,Бұл бастықтың бұйрығы.
Dialogue: 0,0:07:34.78,0:07:36.24,Default,,0,0,0,,Білмеймін.
Dialogue: 0,0:07:36.33,0:07:39.12,Default,,0,0,0,,Түсінбеген сендерсіңдер.
Dialogue: 0,0:07:39.20,0:07:41.37,Default,,0,0,0,,Сіз бізден қару ұрламақшысыз ба?
Dialogue: 0,0:07:41.46,0:07:42.12,Default,,0,0,0,,Не?
Dialogue: 0,0:07:42.21,0:07:43.17,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:43.67,0:07:46.34,Default,,0,0,0,,Оның өзі қару!
Dialogue: 0,0:07:46.42,0:07:47.71,Default,,0,0,0,,Уф... ау!
Dialogue: 0,0:07:48.84,0:07:49.59,Default,,0,0,0,,Ой…
Dialogue: 0,0:07:51.17,0:07:51.84,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:52.72,0:07:53.30,Default,,0,0,0,,Гах...
Dialogue: 0,0:07:53.38,0:07:54.39,Default,,0,0,0,,Нөл!
Dialogue: 0,0:08:07.11,0:08:08.57,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:08:14.24,0:08:15.28,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:08:26.88,0:08:28.75,Default,,0,0,0,,Әрі қарай итерейік!
Dialogue: 0,0:08:28.84,0:08:30.42,Default,,0,0,0,,Тым көп шиеленіс
Dialogue: 0,0:08:30.51,0:08:33.47,Default,,0,0,0,,Жылтыр болайық!
Dialogue: 0,0:08:36.18,0:08:37.35,Default,,0,0,0,,Қазір!
Dialogue: 0,0:08:37.93,0:08:39.43,Default,,0,0,0,,Сәлем, ха... Сәлем!
Dialogue: 0,0:08:40.43,0:08:41.97,Default,,0,0,0,,Уау~ Ах!
Dialogue: 0,0:08:43.68,0:08:45.98,Default,,0,0,0,,Гехо Гехо... Цуцуцу...
Dialogue: 0,0:08:46.06,0:08:46.85,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:47.86,0:08:48.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:50.23,0:08:51.53,Default,,0,0,0,,Бұл Огино
Dialogue: 0,0:08:51.61,0:08:52.65,Default,,0,0,0,,Шекара Regalia-ның қалқаны әрі жалғыз қаруы болып табылады.
Dialogue: 0,0:08:52.74,0:08:55.03,Default,,0,0,0,,Жеке сезімдерге тыйым салынады. Барайық.
Dialogue: 0,0:08:55.11,0:08:56.78,Default,,0,0,0,,Мен өте қуаныштымын!
Dialogue: 0,0:08:59.12,0:09:00.28,Default,,0,0,0,,Ой!
Dialogue: 0,0:09:00.37,0:09:02.83,Default,,0,0,0,,Бұл дөрекі қош келдіңіз, досым.
Dialogue: 0,0:09:02.91,0:09:04.46,Default,,0,0,0,,Тұрмыстық зорлық-зомбылық
Dialogue: 0,0:09:04.54,0:09:06.96,Default,,0,0,0,,Егер бұл ата-ана мен бала ұрысы болса, оны қорғасынсыз жасаңыз!
Dialogue: 0,0:09:07.04,0:09:08.71,Default,,0,0,0,,Барлығы 8 жау бар.
Dialogue: 0,0:09:09.21,0:09:11.09,Default,,0,0,0,,Сіздің ойыңызда сарайдың құрылымы бар ма?
Dialogue: 0,0:09:11.17,0:09:12.38,Default,,0,0,0,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:09:12.46,0:09:14.13,Default,,0,0,0,,Мен оң жақтағы 6-мын.
Dialogue: 0,0:09:14.22,0:09:16.59,Default,,0,0,0,,Бұл жарақат алған адам үшін қатаң квота.
Dialogue: 0,0:09:21.72,0:09:23.22,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:23.31,0:09:25.56,Default,,0,0,0,,(Қара киімді жөтелу)
Dialogue: 0,0:09:27.77,0:09:28.69,Default,,0,0,0,,Аһ!
Dialogue: 0,0:09:32.78,0:09:33.65,Default,,0,0,0,,Ой…
Dialogue: 0,0:09:33.73,0:09:35.57,Default,,0,0,0,,Гүлп, жұт... Арх!
Dialogue: 0,0:09:36.40,0:09:37.41,Default,,0,0,0,,Уф... (қара киім) Уф!
Dialogue: 0,0:09:37.49,0:09:40.32,Default,,0,0,0,,Хе... Мен де істеу керек болса, істеймін!
Dialogue: 0,0:09:45.20,0:09:47.16,Default,,0,0,0,,Ах, нөл, бітті...
Dialogue: 0,0:09:47.96,0:09:48.83,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:49.42,0:09:51.38,Default,,0,0,0,,Гаха! Уф...
Dialogue: 0,0:09:53.88,0:09:56.92,Default,,0,0,0,,Соңғы сөздеріңіз туралы ойладыңыз ба?
Dialogue: 0,0:10:00.51,0:10:02.85,Default,,0,0,0,,Эй, бұл керемет.
Dialogue: 0,0:10:03.35,0:10:06.39,Default,,0,0,0,,Милли-чан, сен көп нәрсе жасадың.
Dialogue: 0,0:10:06.48,0:10:08.81,Default,,0,0,0,,Оны Нөл Папа мен Кадзу Папаға көрсетіңіз.
Dialogue: 0,0:10:08.89,0:10:12.73,Default,,0,0,0,,Уау әкелер, жұмысыңызды тез бітіруіңізге тілектеспін.
Dialogue: 0,0:10:12.82,0:10:14.07,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:10:14.15,0:10:16.03,Default,,0,0,0,,Юбикири Генманши
Dialogue: 0,0:10:16.11,0:10:18.74,Default,,0,0,0,,Мен де Аяз атадан сұрадым!
Dialogue: 0,0:10:18.82,0:10:19.82,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:22.83,0:10:23.49,Default,,0,0,0,,Огино!
Dialogue: 0,0:10:23.58,0:10:24.20,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:30.50,0:10:31.88,Default,,0,0,0,,(Цезарь) Не… Не болып жатыр? Бұл жігіттердің айналасындағы атмосфера…
Dialogue: 0,0:10:31.96,0:10:34.13,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:43.10,0:10:45.47,Default,,0,0,0,,Мен жаңа ғана сөйлесуге келдім.
Dialogue: 0,0:10:47.39,0:10:50.31,Default,,0,0,0,,Ұйымдар сатқындарға жауап бермейді
Dialogue: 0,0:10:53.11,0:10:55.02,Default,,0,0,0,,Барлығы өледі
Dialogue: 0,0:10:55.11,0:10:58.74,Default,,0,0,0,,Өлім тағдырын сөз ғана жеңеді.
Dialogue: 0,0:10:59.24,0:11:03.78,Default,,0,0,0,,Бірақ бұл сөздердің көпшілігі ұмытылып кетеді.
Dialogue: 0,0:11:03.87,0:11:05.91,Default,,0,0,0,,Талқылаудың пайдасы жоқ
Dialogue: 0,0:11:05.99,0:11:10.54,Default,,0,0,0,,Өмірді қысқартатын бір ғана сөз керек!
Dialogue: 0,0:11:12.29,0:11:16.46,Default,,0,0,0,,Сенің өміріңнің жанып тұрған үнін естуге рұқсат етіңіз
Dialogue: 0,0:11:16.55,0:11:18.21,Default,,0,0,0,,Бұл туралы айтудың қажеті жоқ
Dialogue: 0,0:11:21.55,0:11:22.30,Default,,0,0,0,,Аһ!
Dialogue: 0,0:11:22.89,0:11:24.18,Default,,0,0,0,,Сәлем Нөл!
Dialogue: 0,0:11:24.26,0:11:25.10,Default,,0,0,0,,Чи…
Dialogue: 0,0:11:28.31,0:11:30.23,Default,,0,0,0,,Уф... (Икки) Әй, сен тірісің бе?
Dialogue: 0,0:11:30.31,0:11:32.73,Default,,0,0,0,,Оқ тоқтады... Қарғыс атсын...
Dialogue: 0,0:11:33.31,0:11:35.48,Default,,0,0,0,,Өте ақылсыз
Dialogue: 0,0:11:36.19,0:11:40.11,Default,,0,0,0,,Сува әулетінің ұлына лайық соңғы сөздер
Dialogue: 0,0:11:40.19,0:11:41.49,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:11:43.74,0:11:45.66,Default,,0,0,0,,Огино! Дұрыс, сен
Dialogue: 0,0:11:45.74,0:11:49.54,Default,,0,0,0,,Мисаки Кайзаканың сөзі Сен маған сеніп тапсырдың.
Dialogue: 0,0:11:50.58,0:11:52.71,Default,,0,0,0,,Қаласаңыз, алыңыз!
Dialogue: 0,0:11:54.58,0:11:55.96,Default,,0,0,0,,Біз екеуміздің біреуіміздің қанын сіңіргеннен кейін—
Dialogue: 0,0:11:56.54,0:11:58.05,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:58.67,0:12:00.05,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:02.59,0:12:04.14,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:12:09.89,0:12:10.93,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,0:12:12.98,0:12:14.23,Default,,0,0,0,,(Итадори) «Ха! Кугисаки, сол қанға тиме!»
Dialogue: 0,0:12:16.15,0:12:17.19,Default,,0,0,0,,Көрінбейтін
Dialogue: 0,0:12:18.44,0:12:22.03,Default,,0,0,0,,Мисаки Кайсаканың бір рет оған сеніп тапсырылған соңғы сөздері
Dialogue: 0,0:12:22.53,0:12:24.03,Default,,0,0,0,,Алайық, алайық.
Dialogue: 0,0:12:25.45,0:12:26.53,Default,,0,0,0,,Миллиметр…
Dialogue: 0,0:12:27.95,0:12:30.54,Default,,0,0,0,,Бұл менің сүйікті қызымның есімі еді.
Dialogue: 0,0:12:31.04,0:12:32.75,Default,,0,0,0,,Орташа.
Dialogue: 0,0:12:33.25,0:12:34.12,Default,,0,0,0,,Теме...
Dialogue: 0,0:12:34.21,0:12:35.79,Default,,0,0,0,,Бірақ жаман емес
Dialogue: 0,0:12:36.29,0:12:39.80,Default,,0,0,0,,Соңында ол орташа махаббат тапты.
Dialogue: 0,0:12:40.30,0:12:41.38,Default,,0,0,0,,Мені жылатпа
Dialogue: 0,0:12:41.46,0:12:42.21,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:42.30,0:12:45.01,Default,,0,0,0,,Мен сенің әйеліңнен айырылғаныңды естідім.
Dialogue: 0,0:12:45.59,0:12:48.35,Default,,0,0,0,,Өлетін жер іздеп жүрсің бе?
Dialogue: 0,0:12:48.85,0:12:51.60,Default,,0,0,0,,Сіздің өміріңіздің мәні неде?
Dialogue: 0,0:12:52.14,0:12:55.94,Default,,0,0,0,,Кадзуки Курусудың соңғы сөзін тыңдауға рұқсат етіңіз.
Dialogue: 0,0:12:57.61,0:12:59.32,Default,,0,0,0,,Сіз де менімен біргесіз!
Dialogue: 0,0:13:01.03,0:13:01.94,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:13:04.61,0:13:05.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:07.32,0:13:08.91,Default,,0,0,0,,Гах! Уф...
Dialogue: 0,0:13:12.87,0:13:13.66,Default,,0,0,0,,бірақ ол да маған күдікпен қарады…
Dialogue: 0,0:13:14.54,0:13:16.87,Default,,0,0,0,,Сен де ол сияқтысың.
Dialogue: 0,0:13:16.96,0:13:19.29,Default,,0,0,0,,Артында ештеңе қалдырмай өлу...
Dialogue: 0,0:13:23.67,0:13:24.17,Default,,0,0,0,,Хмф!
Dialogue: 0,0:13:26.13,0:13:27.89,Default,,0,0,0,,Гах... аа...
Dialogue: 0,0:13:27.97,0:13:28.93,Default,,0,0,0,,Аһ!
Dialogue: 0,0:13:32.26,0:13:34.68,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:13:35.35,0:13:36.44,Default,,0,0,0,,Сіз тұра аласыз ба?
Dialogue: 0,0:13:38.35,0:13:39.48,Default,,0,0,0,,Кешіктіріңіз
Dialogue: 0,0:13:40.48,0:13:41.98,Default,,0,0,0,,Окабе?
Dialogue: 0,0:13:42.07,0:13:43.11,Default,,0,0,0,,Аде…
Dialogue: 0,0:13:43.90,0:13:45.57,Default,,0,0,0,,Сіз өзіңізді жоюды ойладыңыз ба?
Dialogue: 0,0:13:45.65,0:13:48.36,Default,,0,0,0,,Миллиметрді қою керек пе? Амал жоқ
Dialogue: 0,0:13:49.20,0:13:52.54,Default,,0,0,0,,Мен сенің келеріңе сендім, жолдасым.
Dialogue: 0,0:13:53.04,0:13:54.12,Default,,0,0,0,,О
Dialogue: 0,0:13:54.70,0:13:57.29,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:14:05.88,0:14:07.80,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:15.64,0:14:17.73,Default,,0,0,0,,Сиыр Бұл жақсы.
Dialogue: 0,0:14:17.81,0:14:19.69,Default,,0,0,0,,Олай болса, мәселені шешейік...
Dialogue: 0,0:14:19.77,0:14:21.86,Default,,0,0,0,,Рахмет, бірақ...
Dialogue: 0,0:14:22.36,0:14:25.23,Default,,0,0,0,,Бұдан былай бұл ата-ана мен балаға қатысты.
Dialogue: 0,0:14:25.32,0:14:25.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:26.57,0:14:29.91,Default,,0,0,0,,Кешіріңіз, бірақ мен үйге баруыңызды сұраймын.
Dialogue: 0,0:14:31.28,0:14:33.16,Default,,0,0,0,,Өз бетіңізше жақсысыз ба?
Dialogue: 0,0:14:34.20,0:14:35.37,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:14:36.75,0:14:38.29,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:14:38.37,0:14:40.25,Default,,0,0,0,,Маған бұл ұнайды
Dialogue: 0,0:15:08.28,0:15:09.40,Default,,0,0,0,,Егер бізге шабуыл жасалса, онда
Dialogue: 0,0:15:09.99,0:15:11.57,Default,,0,0,0,,Мен ұйымнан кетемін.
Dialogue: 0,0:15:12.53,0:15:14.45,Default,,0,0,0,,Бұл рұқсат етілмейді
Dialogue: 0,0:15:15.12,0:15:18.33,Default,,0,0,0,,Сезімталдықтан бас тартып, ұйымды мұраға алыңыз
Dialogue: 0,0:15:18.83,0:15:21.33,Default,,0,0,0,,Бұл сіздің тағдырыңыз.
Dialogue: 0,0:15:22.42,0:15:24.34,Default,,0,0,0,,Жауап, сіз...
Dialogue: 0,0:15:24.42,0:15:26.34,Default,,0,0,0,,Ұйымнан шығу
Dialogue: 0,0:15:31.09,0:15:32.34,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:15:34.18,0:15:35.22,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:38.60,0:15:43.27,Default,,0,0,0,,Мені өлтірсең де, ұйым сені жердің шетіне дейін қуып шығады.
Dialogue: 0,0:15:43.77,0:15:46.02,Default,,0,0,0,,Тіпті сіз жақсы көретін адамдар
Dialogue: 0,0:15:46.61,0:15:48.44,Default,,0,0,0,,Нөлді өлтіру
Dialogue: 0,0:15:48.53,0:15:50.95,Default,,0,0,0,,Сен де қаннан құтыла алмайсың.
Dialogue: 0,0:15:52.07,0:15:55.03,Default,,0,0,0,,Мен сені бөлек танитынмын.
Dialogue: 0,0:15:55.53,0:15:57.95,Default,,0,0,0,,Жарықпен бірге қараңғылық та келеді
Dialogue: 0,0:15:58.58,0:16:01.37,Default,,0,0,0,,Лас жұмыс дүниеден кетпейді
Dialogue: 0,0:16:02.58,0:16:04.71,Default,,0,0,0,,Менің қазір осында болуымның себебі
Dialogue: 0,0:16:05.21,0:16:09.46,Default,,0,0,0,,Маған аман қалуды үйреткеніңіз үшін рахмет.
Dialogue: 0,0:16:10.13,0:16:11.80,Default,,0,0,0,,Мен мұны бағалаймын
Dialogue: 0,0:16:12.80,0:16:13.80,Default,,0,0,0,,'Біз қазір-ақ бара жатырмыз!
Dialogue: 0,0:16:14.30,0:16:17.30,Default,,0,0,0,,Ұйымды мұраға қалдыру үшін өмір салты болған болуы мүмкін.
Dialogue: 0,0:16:18.31,0:16:23.02,Default,,0,0,0,,Бірақ мен сізден кетіп бара жатып, көп нәрсені үйрендім.
Dialogue: 0,0:16:24.27,0:16:26.44,Default,,0,0,0,,Шулы және қамқор үй құрбысы
Dialogue: 0,0:16:27.77,0:16:29.27,Default,,0,0,0,,Арзан гамбургер дәмі
Dialogue: 0,0:16:29.78,0:16:32.74,Default,,0,0,0,,Өзенде ұйықтап жатқан футонның жылуы
Dialogue: 0,0:16:33.28,0:16:35.78,Default,,0,0,0,,Балаға күтім жасау
Dialogue: 0,0:16:36.28,0:16:38.53,Default,,0,0,0,,Француз тосттарын қалай жасауға болады
Dialogue: 0,0:16:39.03,0:16:41.45,Default,,0,0,0,,Күтпеген тосын кеш
Dialogue: 0,0:16:42.16,0:16:43.66,Default,,0,0,0,,Спорт күні алтын медаль
Dialogue: 0,0:16:44.79,0:16:47.17,Default,,0,0,0,,Дөңгелектің жоғарғы жағынан көрініс
Dialogue: 0,0:16:48.46,0:16:49.59,Default,,0,0,0,,Әлемде
Dialogue: 0,0:16:50.09,0:16:52.97,Default,,0,0,0,,Маған ұнайтын нәрселер көп болды.
Dialogue: 0,0:16:53.67,0:16:56.34,Default,,0,0,0,,Өйткені, бұл тек отбасына еліктеу.
Dialogue: 0,0:16:56.84,0:17:00.26,Default,,0,0,0,,Қанша тырыссаң да Сува әулетінің қанынан құтыла алмайсың.
Dialogue: 0,0:17:00.35,0:17:02.43,Default,,0,0,0,,Маған еліктеп алсаң да
Dialogue: 0,0:17:02.93,0:17:04.52,Default,,0,0,0,,Мен үшін емес
Dialogue: 0,0:17:05.19,0:17:09.19,Default,,0,0,0,,Мен, Мири және Икки арасында қаннан да күшті байланыс бар.
Dialogue: 0,0:17:09.69,0:17:10.77,Default,,0,0,0,,Мен бұған сенгім келеді
Dialogue: 0,0:17:11.73,0:17:14.90,Default,,0,0,0,,Мен нағыз отбасының мүшесі болғым келеді.
Dialogue: 0,0:17:15.53,0:17:19.41,Default,,0,0,0,,Егер қанішердің қаны жолға түсіп, мен оларды қорғай алмасам
Dialogue: 0,0:17:19.99,0:17:21.24,Default,,0,0,0,,Бұл қолдың мағынасы жоқ!
Dialogue: 0,0:17:26.67,0:17:28.96,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:17:30.09,0:17:33.96,Default,,0,0,0,,Мен қазір саған түкке тұрғысызмын.
Dialogue: 0,0:17:34.05,0:17:35.80,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:17:44.64,0:17:47.64,Default,,0,0,0,,Қош бол, әке
Dialogue: 0,0:18:04.66,0:18:05.79,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:18:05.87,0:18:07.12,Default,,0,0,0,,Қош келдіңіз...
Dialogue: 0,0:18:07.21,0:18:08.87,Default,,0,0,0,,Эй, эй, қолдар!
Dialogue: 0,0:18:08.96,0:18:10.33,Default,,0,0,0,,Өзім жасадым
Dialogue: 0,0:18:10.42,0:18:12.13,Default,,0,0,0,,Өзім...
Dialogue: 0,0:18:12.63,0:18:14.34,Default,,0,0,0,,Бұл абайсызда болды
Dialogue: 0,0:18:22.26,0:18:23.68,Default,,0,0,0,,Сәлем Екі
Dialogue: 0,0:18:24.18,0:18:26.52,Default,,0,0,0,,Біз өзгердік пе?
Dialogue: 0,0:18:27.94,0:18:28.69,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:29.19,0:18:31.56,Default,,0,0,0,,Әлі алда
Dialogue: 0,0:18:32.73,0:18:34.61,Default,,0,0,0,,Сонымен, үйге қайтқыңыз келе ме?
Dialogue: 0,0:18:35.11,0:18:37.15,Default,,0,0,0,,Мен Аяз атаны күтемін.
Dialogue: 0,0:18:45.08,0:18:49.00,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:18:49.92,0:18:53.75,Default,,0,0,0,,(фортепиано сүйемелдеу)
Dialogue: 0,0:18:58.34,0:19:02.64,Default,,0,0,0,,♪ Тыныш түн!
Dialogue: 0,0:19:02.72,0:19:06.89,Default,,0,0,0,,♪ Қасиетті түн!
Dialogue: 0,0:19:06.97,0:19:11.19,Default,,0,0,0,,♪ Бәрі тыныш,
Dialogue: 0,0:19:11.27,0:19:15.65,Default,,0,0,0,,♪ бәрі жарқын,
Dialogue: 0,0:19:15.73,0:19:19.90,Default,,0,0,0,,♪ Айналайын сен қыз
Dialogue: 0,0:19:19.99,0:19:24.16,Default,,0,0,0,,♪ ана мен бала!
Dialogue: 0,0:19:24.24,0:19:28.33,Default,,0,0,0,,♪ Қасиетті сәби солай
Dialogue: 0,0:19:28.41,0:19:32.50,Default,,0,0,0,,♪ нәзік және жұмсақ,
Dialogue: 0,0:19:33.00,0:19:40.01,Default,,0,0,0,,♪ Жұмақтағы тыныштықта ұйықтаңыз,
Dialogue: 0,0:19:41.51,0:19:48.52,Default,,0,0,0,,♪ Жұмақтағы тыныштықта ұйықтаңыз.
Dialogue: 0,0:19:56.52,0:19:59.32,Default,,0,0,0,,Нөл әке! Казу Папа~!
Dialogue: 0,0:19:59.40,0:20:00.19,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:20:00.78,0:20:03.16,Default,,0,0,0,,О... жұмыс істейді...
Dialogue: 0,0:20:03.24,0:20:06.03,Default,,0,0,0,,Мири ән айтуды өте жақсы білетін.
Dialogue: 0,0:20:06.12,0:20:08.95,Default,,0,0,0,,Иә! Мен көп ән айттым
Dialogue: 0,0:20:09.04,0:20:11.46,Default,,0,0,0,,Анам да мені тыңдады ма?
Dialogue: 0,0:20:11.54,0:20:12.46,Default,,0,0,0,,Иә
Dialogue: 0,0:20:12.54,0:20:13.96,Default,,0,0,0,,Әрине
Dialogue: 0,0:20:14.54,0:20:16.34,Default,,0,0,0,,Аяз ата!
Dialogue: 0,0:20:16.42,0:20:20.21,Default,,0,0,0,,Сыйлық үшін рахмет!
Dialogue: 0,0:20:20.30,0:20:22.30,Default,,0,0,0,,О, бұл керемет!
Dialogue: 0,0:20:22.38,0:20:24.34,Default,,0,0,0,,Барлығы сәйкес келеді, солай ма?
Dialogue: 0,0:20:24.43,0:20:27.47,Default,,0,0,0,,Ах, ахаха... Дұрыс~
Dialogue: 0,0:20:27.55,0:20:31.52,Default,,0,0,0,,Түпнұсқа киім қанға боялған, саңылауларға толы.
Dialogue: 0,0:20:31.60,0:20:33.56,Default,,0,0,0,,Мм, қарсы болмасаң...
Dialogue: 0,0:20:34.77,0:20:36.90,Default,,0,0,0,,Қара, Нөл, күл.
Dialogue: 0,0:20:36.98,0:20:38.73,Default,,0,0,0,,Мен жүгері дорбаларын жүк көліктеріне тиеп, қоймаға апаратынмын.
Dialogue: 0,0:20:38.82,0:20:40.65,Default,,0,0,0,,Олай болса, кеттік~
Dialogue: 0,0:20:41.15,0:20:43.20,Default,,0,0,0,,1 плюс 1 нешеге тең?
Dialogue: 0,0:20:43.28,0:20:44.57,Default,,0,0,0,,Ni~!
Dialogue: 0,0:20:44.66,0:20:45.53,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:20:58.75,0:21:00.46,Default,,0,0,0,,Хмм... Жарайды.
Dialogue: 0,0:21:01.05,0:21:03.51,Default,,0,0,0,,Милли~ Уақыт таяп қалды!
Dialogue: 0,0:21:03.59,0:21:05.05,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:21:05.55,0:21:07.34,Default,,0,0,0,,Мен келемін, мама.
Dialogue: 0,0:21:07.97,0:21:09.97,Default,,0,0,0,,♪～
Dialogue: 0,0:21:10.56,0:21:12.72,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:21:19.94,0:21:21.73,Default,,0,0,0,,Нөлдік папа Казу папа
Dialogue: 0,0:21:21.82,0:21:23.49,Default,,0,0,0,,Хмм... (Икки) О!
Dialogue: 0,0:21:25.57,0:21:27.03,Default,,0,0,0,,Джажан~н
Dialogue: 0,0:21:27.53,0:21:29.24,Default,,0,0,0,,О~
Dialogue: 0,0:21:29.32,0:21:30.58,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:21:31.08,0:21:32.24,Default,,0,0,0,,Жоғары сынып оқушысы
Dialogue: 0,0:21:32.33,0:21:33.29,Default,,0,0,0,,Жеңіске жет!
Dialogue: 0,0:21:33.37,0:21:36.12,Default,,0,0,0,,Мен бұзық болып өспегеніме өте қуаныштымын.
Dialogue: 0,0:21:36.21,0:21:37.92,Default,,0,0,0,,Иә, бұл не?
Dialogue: 0,0:21:38.00,0:21:41.46,Default,,0,0,0,,Ата-ананы толғандыратын нәрсе көп.
Dialogue: 0,0:21:41.96,0:21:44.59,Default,,0,0,0,,Бұл асхананы ашқаныма 10 жыл болды.
Dialogue: 0,0:21:44.67,0:21:47.18,Default,,0,0,0,,Сіз шындап жұмыс жасадыңыз ба?
Dialogue: 0,0:21:47.26,0:21:48.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:48.55,0:21:49.55,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:21:49.64,0:21:51.76,Default,,0,0,0,,Мен де кеше дүкеннен жасырын шықтым.
Dialogue: 0,0:21:51.85,0:21:53.81,Default,,0,0,0,,Сіз әйелмен ішімдікке бардыңыз ғой, солай ма?
Dialogue: 0,0:21:53.89,0:21:55.68,Default,,0,0,0,,Аа, солай.
Dialogue: 0,0:21:56.27,0:21:57.69,Default,,0,0,0,,Милли жейді
Dialogue: 0,0:21:57.77,0:21:59.35,Default,,0,0,0,,Уау, рахмет
Dialogue: 0,0:22:00.06,0:22:02.32,Default,,0,0,0,,Көп уақыт өтті...
Dialogue: 0,0:22:02.40,0:22:03.98,Default,,0,0,0,,Хмм!
Dialogue: 0,0:22:04.99,0:22:05.82,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:22:06.32,0:22:07.86,Default,,0,0,0,,Бүгін де дәмді!
Dialogue: 0,0:22:07.95,0:22:08.66,Default,,0,0,0,,Иә
Dialogue: 0,0:22:08.74,0:22:12.58,Default,,0,0,0,,Тост біздің ерекшелігіміз екеніне қуаныштымын.
Dialogue: 0,0:22:12.66,0:22:14.83,Default,,0,0,0,,Неліктен репертуарыңызды кеңейтпеске?
Dialogue: 0,0:22:14.91,0:22:15.79,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:22:15.87,0:22:17.50,Default,,0,0,0,,Бір нәрсе есімде...
Dialogue: 0,0:22:17.58,0:22:19.25,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:22:19.33,0:22:22.46,Default,,0,0,0,,Папа Нөлдікі ең дәмді!
Dialogue: 0,0:22:22.54,0:22:23.75,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:22:24.71,0:22:26.92,Default,,0,0,0,,Иә? Мектепке әлі ерте.
Dialogue: 0,0:22:27.01,0:22:28.01,Default,,0,0,0,,Менің бір ісім бар!
Dialogue: 0,0:22:28.80,0:22:32.43,Default,,0,0,0,,Әй... Әкелер, келіңдер!
Dialogue: 0,0:22:32.97,0:22:34.81,Default,,0,0,0,,Хмм…
Dialogue: 0,0:22:34.89,0:22:37.89,Default,,0,0,0,,Нөл Папа Казу Папа, жақында!
Dialogue: 0,0:22:37.98,0:22:40.65,Default,,0,0,0,,Ех~ (Икки) Бұл жақсы, солай ма?
Dialogue: 0,0:22:40.73,0:22:41.86,Default,,0,0,0,,Жақсы емес!
Dialogue: 0,0:22:41.94,0:22:44.69,Default,,0,0,0,,Қараңдаршы, біз бір отбасымыз.
Dialogue: 0,0:22:45.19,0:22:46.28,Default,,0,0,0,,Демек, Қамалардың сыртында шынымен қалалар бар екен, және онда адамдар тұрады…
Dialogue: 0,0:22:46.78,0:22:48.70,Default,,0,0,0,,Ол маған мотоцикл мен соққан көлік туралы уайымдама, тек қайта кел деп айтты.
Dialogue: 0,0:22:48.78,0:22:49.32,Default,,0,0,0,,Маюри үшін сол сәт келгенде қасында болғым келеді… яғни…
Dialogue: 0,0:22:50.11,0:22:51.28,Default,,0,0,0,,Олай болса, кеттік!
Dialogue: 0,0:22:51.78,0:22:53.83,Default,,0,0,0,,1 плюс 1 нешеге тең?
Dialogue: 0,0:22:53.91,0:22:55.54,Default,,0,0,0,,Ni!
Dialogue: 0,0:23:58.89,0:24:00.89,Default,,0,0,0,,～♪
Dialogue: 0,0:24:02.39,0:24:08.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory