Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:04.50,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:00:20.47,0:00:22.02,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:22.60,0:00:23.98,Default,,0,0,0,,Аа...
Dialogue: 0,0:00:25.40,0:00:27.81,Default,,0,0,0,,Нөл папа? Қайырлы таң
Dialogue: 0,0:00:27.90,0:00:28.57,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:29.07,0:00:30.98,Default,,0,0,0,,Сіз бір жерге шығасыз ба?
Dialogue: 0,0:00:31.07,0:00:34.11,Default,,0,0,0,,Мири зәр шығаруға кетті.
Dialogue: 0,0:00:34.20,0:00:35.24,Default,,0,0,0,,Мен үйге келе жатырмын
Dialogue: 0,0:00:35.32,0:00:36.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:37.07,0:00:39.45,Default,,0,0,0,,Папа Нөлдің үйі осында.
Dialogue: 0,0:00:39.53,0:00:41.04,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:00:43.20,0:00:44.71,Default,,0,0,0,,Э~?
Dialogue: 0,0:00:44.79,0:00:47.00,Default,,0,0,0,,А... бұл тітіркендіргіш.
Dialogue: 0,0:00:48.33,0:00:50.67,Default,,0,0,0,,Мм... сенің бүгін жұмысың бар ма еді?
Dialogue: 0,0:00:51.25,0:00:52.09,Default,,0,0,0,,Жоқ
Dialogue: 0,0:00:52.17,0:00:55.05,Default,,0,0,0,,Нөл Папа, тезірек оралыңыз!
Dialogue: 0,0:00:55.13,0:00:55.84,Default,,0,0,0,,Өйткені бүгін…
Dialogue: 0,0:00:55.93,0:00:57.14,Default,,0,0,0,,О, міне, Милли!
Dialogue: 0,0:00:59.26,0:01:00.35,Default,,0,0,0,,Тынш!
Dialogue: 0,0:01:00.43,0:01:01.77,Default,,0,0,0,,Хаха...
Dialogue: 0,0:01:02.27,0:01:04.60,Default,,0,0,0,,Әйтеуір, кеш емес!
Dialogue: 0,0:01:05.39,0:01:07.69,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:01:08.94,0:01:11.44,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:01:11.52,0:01:12.94,Default,,0,0,0,,Хаа~
Dialogue: 0,0:01:13.44,0:01:15.99,Default,,0,0,0,,Ол қайда барады?
Dialogue: 0,0:01:16.07,0:01:17.86,Default,,0,0,0,,Сіз үйге айттыңыз.
Dialogue: 0,0:01:17.95,0:01:18.74,Default,,0,0,0,,Аякаши оны кесіп өте алмайды
Dialogue: 0,0:01:20.12,0:01:21.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:22.16,0:01:24.58,Default,,0,0,0,,Әкемнің қоңырауы ма?
Dialogue: 0,0:01:26.33,0:01:29.96,Default,,0,0,0,,Бұл мені оны қуып шығудан құтқарады, бұл керемет.
Dialogue: 0,0:01:30.54,0:01:33.67,Default,,0,0,0,,Жарайды, Мири, тапсырманы бастайық.
Dialogue: 0,0:01:33.76,0:01:36.42,Default,,0,0,0,,Бастау!
Dialogue: 0,0:01:39.51,0:01:41.51,Default,,0,0,0,,♪～
Dialogue: 0,0:03:06.89,0:03:08.89,Default,,0,0,0,,～♪
Dialogue: 0,0:03:10.39,0:03:15.40,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:03:54.06,0:03:55.73,Default,,0,0,0,,3 жыл болды ма?
Dialogue: 0,0:03:58.82,0:04:01.19,Default,,0,0,0,,Нөлдік папаның екі үйі бар ма?
Dialogue: 0,0:04:01.90,0:04:05.03,Default,,0,0,0,,Әй, мен бұрын әкеммен бірге тұрғанмын.
Dialogue: 0,0:04:05.53,0:04:07.58,Default,,0,0,0,,Нөл Папаның әкесі?
Dialogue: 0,0:04:08.08,0:04:09.16,Default,,0,0,0,,Ата?
Dialogue: 0,0:04:09.24,0:04:12.29,Default,,0,0,0,,Әй, солай бола ма?
Dialogue: 0,0:04:12.37,0:04:14.00,Default,,0,0,0,,Мен де Миримен таныстым!
Dialogue: 0,0:04:14.08,0:04:15.50,Default,,0,0,0,,А, жоқ, жоқ, жоқ.
Dialogue: 0,0:04:15.58,0:04:16.75,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:17.25,0:04:20.05,Default,,0,0,0,,Ол қорқынышты~ Нөлдің әкесі
Dialogue: 0,0:04:20.13,0:04:21.67,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:04:21.76,0:04:23.63,Default,,0,0,0,,О, бұл қорқынышты.
Dialogue: 0,0:04:23.72,0:04:24.76,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:24.84,0:04:26.84,Default,,0,0,0,,Білесіз бе, ол мұғалім де.
Dialogue: 0,0:04:26.93,0:04:30.01,Default,,0,0,0,,Сен маған ән үйретсең, қорқамын
Dialogue: 0,0:04:30.10,0:04:34.77,Default,,0,0,0,,♪ Оны ашыңыз
Dialogue: 0,0:04:34.85,0:04:38.36,Default,,0,0,0,,Хмм... Иә, бұдан сәл басқаша болуы мүмкін.
Dialogue: 0,0:04:59.17,0:05:01.09,Default,,0,0,0,,Көптен бері көрмегелі, бастық
Dialogue: 0,0:05:01.59,0:05:02.84,Default,,0,0,0,,Сіз жақсы жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:05:02.92,0:05:05.80,Default,,0,0,0,,Дүниелікпен қоршап, мақтануды үйрендің бе?
Dialogue: 0,0:05:06.97,0:05:09.01,Default,,0,0,0,,Бұл Кадзуки Курусу ма?
Dialogue: 0,0:05:09.51,0:05:12.81,Default,,0,0,0,,Ол төмен адам, бірақ аздап көмектесті.
Dialogue: 0,0:05:14.60,0:05:17.06,Default,,0,0,0,,Бірақ сіздің қолдарыңыз үшінші дәрежелі сияқты.
Dialogue: 0,0:05:17.56,0:05:20.57,Default,,0,0,0,,Соңғы жұмыста көптеген олқылықтар болды.
Dialogue: 0,0:05:20.65,0:05:22.28,Default,,0,0,0,,Бұл себеп пе?
Dialogue: 0,0:05:25.49,0:05:26.61,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:05:29.45,0:05:31.24,Default,,0,0,0,,Осы үйге оралу
Dialogue: 0,0:05:34.62,0:05:38.00,Default,,0,0,0,,Олай болса, Нөл әке, сен атаңа ашуландың ба?
Dialogue: 0,0:05:38.08,0:05:39.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:39.58,0:05:41.88,Default,,0,0,0,,Біз ұрысып қалдық па?
Dialogue: 0,0:05:41.96,0:05:43.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:43.46,0:05:46.97,Default,,0,0,0,,Бұл одан да тереңірек мәселе.
Dialogue: 0,0:05:47.05,0:05:49.84,Default,,0,0,0,,Оның үйі біршама ерекше.
Dialogue: 0,0:05:49.93,0:05:50.76,Default,,0,0,0,,Токушю?
Dialogue: 0,0:05:50.85,0:05:54.14,Default,,0,0,0,,Әй, әкемнің үміті сондай үлкен.
Dialogue: 0,0:05:54.22,0:05:58.06,Default,,0,0,0,,Менің ойымша, сіз маған бұл жұмысты өте қатал үйретті деп айта аласыз.
Dialogue: 0,0:05:58.56,0:06:01.48,Default,,0,0,0,,Сондықтан мен оны алғаш көргенде...
Dialogue: 0,0:06:03.73,0:06:04.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:05.53,0:06:08.36,Default,,0,0,0,,Ол робот сияқты болды.
Dialogue: 0,0:06:08.45,0:06:09.70,Default,,0,0,0,,Робот?
Dialogue: 0,0:06:09.78,0:06:11.74,Default,,0,0,0,,Біріктіру? Сәуле болады ма?
Dialogue: 0,0:06:11.82,0:06:14.87,Default,,0,0,0,,А... Шығар емес шығар.
Dialogue: 0,0:06:14.95,0:06:17.37,Default,,0,0,0,,Че~ Мен шықпаймын.
Dialogue: 0,0:06:17.46,0:06:18.79,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:06:19.87,0:06:21.79,Default,,0,0,0,,Сондықтан ол үйден қашып кетті
Dialogue: 0,0:06:21.88,0:06:25.88,Default,,0,0,0,,Әкеме қарсы шығу сияқты бірдеңе бар шығар...
Dialogue: 0,0:06:25.96,0:06:30.13,Default,,0,0,0,,Папа Нөл, сен атаңмен татуласа аласың ба?
Dialogue: 0,0:06:30.76,0:06:34.14,Default,,0,0,0,,Иә? Ой, таң қалдым...
Dialogue: 0,0:06:34.93,0:06:38.98,Default,,0,0,0,,Егер бұл орын алса, ол сол жерге қайтады ма?
Dialogue: 0,0:06:40.69,0:06:43.69,Default,,0,0,0,,Жаман қолдардың қаны Сува отбасында өтеді.
Dialogue: 0,0:06:44.19,0:06:47.19,Default,,0,0,0,,Кісі өлтіру арқылы күн көретіндерге
Dialogue: 0,0:06:47.28,0:06:50.24,Default,,0,0,0,,Қан ең жоғары сапалы.
Dialogue: 0,0:06:51.32,0:06:53.95,Default,,0,0,0,,Жарық бар жерде қараңғылық бар
Dialogue: 0,0:06:54.45,0:06:56.91,Default,,0,0,0,,Жарқырауға тырысатындар
Dialogue: 0,0:06:56.99,0:07:00.16,Default,,0,0,0,,Біз терең қараңғылықтың күшін алуымыз керек.
Dialogue: 0,0:07:00.83,0:07:03.92,Default,,0,0,0,,Сува әулеті – сол қараңғылықтың шыңы.
Dialogue: 0,0:07:04.42,0:07:08.17,Default,,0,0,0,,Қан тамырларыңыз арқылы өтеді.
Dialogue: 0,0:07:08.67,0:07:13.47,Default,,0,0,0,,Мұрагер отбасын, Сенің бар болуыңның себебі.
Dialogue: 0,0:07:13.97,0:07:16.22,Default,,0,0,0,,Осы мақсатта берілген білім
Dialogue: 0,0:07:18.06,0:07:20.35,Default,,0,0,0,,Рақым жеткілікті болды.
Dialogue: 0,0:07:20.85,0:07:22.40,Default,,0,0,0,,Бұдан былай сіз
Dialogue: 0,0:07:22.48,0:07:26.23,Default,,0,0,0,,Оқушыларға ұйым басшысы ретіндегі міндеттері туралы білуге мүмкіндік беріңіз
Dialogue: 0,0:07:27.78,0:07:29.07,Default,,0,0,0,,Қанағаттанбады ма?
Dialogue: 0,0:07:30.11,0:07:32.82,Default,,0,0,0,,Өйткені мен бір күні ораламын деп уәде бердім
Dialogue: 0,0:07:32.91,0:07:35.12,Default,,0,0,0,,Сыртта тұруға рұқсат етілген
Dialogue: 0,0:07:35.62,0:07:37.16,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:07:37.66,0:07:40.25,Default,,0,0,0,,Сізге сыртта орын болды ма?
Dialogue: 0,0:07:41.50,0:07:42.50,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:42.58,0:07:46.25,Default,,0,0,0,,Бұл сіз қайтуыңыз керек жер.
Dialogue: 0,0:07:48.05,0:07:50.72,Default,,0,0,0,,Бос жүкті арқалап жүрген сияқтысың.
Dialogue: 0,0:07:51.51,0:07:54.80,Default,,0,0,0,,Бұтада тікен бар деп жиі айтатын.
Dialogue: 0,0:07:55.30,0:07:57.22,Default,,0,0,0,,Бұл Сува отбасының қанына дақ түсіреді...
Dialogue: 0,0:07:57.31,0:08:00.93,Default,,0,0,0,,Жоқ! Екі... маңызды емес.
Dialogue: 0,0:08:04.35,0:08:05.94,Default,,0,0,0,,Маған уақыт беріңіз.
Dialogue: 0,0:08:06.52,0:08:09.57,Default,,0,0,0,,Хун, істеріңді реттеу керек пе?
Dialogue: 0,0:08:11.07,0:08:13.15,Default,,0,0,0,,Бүгін тазалаңыз.
Dialogue: 0,0:08:16.16,0:08:17.49,Default,,0,0,0,,Таныс бет
Dialogue: 0,0:08:17.58,0:08:19.49,Default,,0,0,0,,Ұйымға опасыздық жасады
Dialogue: 0,0:08:19.99,0:08:23.00,Default,,0,0,0,,Үмітіңізді ақтамаңыз
Dialogue: 0,0:08:24.12,0:08:25.50,Default,,0,0,0,,Иә Бастық
Dialogue: 0,0:08:28.17,0:08:30.51,Default,,0,0,0,,Иә? Кеш пе?
Dialogue: 0,0:08:30.59,0:08:31.84,Default,,0,0,0,,Нашар
Dialogue: 0,0:08:31.92,0:08:34.26,Default,,0,0,0,,Маған да ыңғайлы.
Dialogue: 0,0:08:34.34,0:08:36.76,Default,,0,0,0,,Кешіріңіз нөл әке~!
Dialogue: 0,0:08:37.35,0:08:39.81,Default,,0,0,0,,Әкеңмен әңгіме бітті, солай ма?
Dialogue: 0,0:08:41.02,0:08:43.56,Default,,0,0,0,,Сәлеметсіз бе, мені естисіз бе?
Dialogue: 0,0:08:43.64,0:08:45.10,Default,,0,0,0,,Телефон!
Dialogue: 0,0:08:45.19,0:08:45.77,Default,,0,0,0,,Нашар
Dialogue: 0,0:08:45.85,0:08:47.06,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:08:47.15,0:08:49.48,Default,,0,0,0,,«кешіріңіз» және «жаман» сөздерінен басқа сөздерді қолданыңыз
Dialogue: 0,0:08:49.98,0:08:52.19,Default,,0,0,0,,Тек Икки Папа қу!
Dialogue: 0,0:08:52.28,0:08:53.53,Default,,0,0,0,,Нөл Папа~!
Dialogue: 0,0:08:53.61,0:08:55.45,Default,,0,0,0,,О, мен оны қалаймын!
Dialogue: 0,0:08:55.53,0:08:58.32,Default,,0,0,0,,Кешкі ас алдында қайтып келіңіз!
Dialogue: 0,0:08:58.41,0:08:59.91,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:08:59.99,0:09:01.54,Default,,0,0,0,,Бізде де пицца мен картоп бар!
Dialogue: 0,0:09:01.62,0:09:02.91,Default,,0,0,0,,Сосын...
Dialogue: 0,0:09:03.50,0:09:05.75,Default,,0,0,0,,Күте тұрыңыз, кездескенше!
Dialogue: 0,0:09:06.42,0:09:07.58,Default,,0,0,0,,Хаа~
Dialogue: 0,0:09:07.67,0:09:10.46,Default,,0,0,0,,Маңызды ештеңе айтпаңыз.
Dialogue: 0,0:09:10.55,0:09:12.09,Default,,0,0,0,,Ах
Dialogue: 0,0:09:12.17,0:09:14.59,Default,,0,0,0,,Папа Икки шырылдады.
Dialogue: 0,0:09:15.22,0:09:18.26,Default,,0,0,0,,Ой, ыстық, тиіспе.
Dialogue: 0,0:09:20.35,0:09:21.26,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:28.85,0:09:31.65,Default,,0,0,0,,Сіз Сува отбасының ұлысыз ба?
Dialogue: 0,0:09:32.15,0:09:32.65,Default,,0,0,0,,Атпен жүру
Dialogue: 0,0:09:49.04,0:09:50.17,Default,,0,0,0,,Әлгі адам...
Dialogue: 0,0:09:51.04,0:09:53.75,Default,,0,0,0,,Ол сізбен бұрыннан жұмыс істеген сияқты.
Dialogue: 0,0:09:54.76,0:09:57.88,Default,,0,0,0,,Бұл кісі маған қару қолдануды үйретті.
Dialogue: 0,0:09:58.38,0:10:00.51,Default,,0,0,0,,Сіз қалай жұмыс істейсіз және неге...
Dialogue: 0,0:10:00.60,0:10:03.06,Default,,0,0,0,,Ұйымға неге опасыздық жасадың?
Dialogue: 0,0:10:05.60,0:10:07.39,Default,,0,0,0,,Бұл мағынасыз сұрақ.
Dialogue: 0,0:10:07.89,0:10:11.19,Default,,0,0,0,,Егер сіз бұл туралы ойласаңыз, басқа нәрсе туралы ойлағаныңыз дұрыс.
Dialogue: 0,0:10:17.74,0:10:19.24,Default,,0,0,0,,Бұл себеп пе?
Dialogue: 0,0:10:19.32,0:10:21.41,Default,,0,0,0,,(қағазды аудару дыбысы)
Dialogue: 0,0:10:22.16,0:10:22.83,Default,,0,0,0,,Хмм…
Dialogue: 0,0:10:23.33,0:10:25.24,Default,,0,0,0,,Қанша күтсе де
Dialogue: 0,0:10:25.33,0:10:28.00,Default,,0,0,0,,Енді даяшылар болмайды.
Dialogue: 0,0:10:30.92,0:10:33.13,Default,,0,0,0,,Неге өлтіресің?
Dialogue: 0,0:10:33.75,0:10:35.50,Default,,0,0,0,,Сува отбасына арналған ба?
Dialogue: 0,0:10:36.01,0:10:37.67,Default,,0,0,0,,Әлде бұл хобби ме?
Dialogue: 0,0:10:38.97,0:10:39.93,Default,,0,0,0,,Бала, отыр!
Dialogue: 0,0:10:41.14,0:10:42.68,Default,,0,0,0,,Тұжырымдама
Dialogue: 0,0:10:43.26,0:10:44.35,Default,,0,0,0,,Тұжырымдама?
Dialogue: 0,0:10:44.43,0:10:47.31,Default,,0,0,0,,Көліктер жүру үшін бар
Dialogue: 0,0:10:47.39,0:10:50.27,Default,,0,0,0,,Ақша - тілектерді жүзеге асыруға арналған
Dialogue: 0,0:10:50.77,0:10:52.94,Default,,0,0,0,,Зорлық-зомбылық үшін қару
Dialogue: 0,0:10:54.73,0:10:57.90,Default,,0,0,0,,Сонда ол не үшін бар?
Dialogue: 0,0:10:58.94,0:11:01.61,Default,,0,0,0,,Материалдарды қарап отырып ойлаймын
Dialogue: 0,0:11:02.11,0:11:04.45,Default,,0,0,0,,Бұл адамның өмір сүруінің маңызы қандай?
Dialogue: 0,0:11:04.95,0:11:08.58,Default,,0,0,0,,Өміріңді жоғалтпас бұрын Жарық шамдарында не көріп тұрсың?
Dialogue: 0,0:11:09.08,0:11:11.79,Default,,0,0,0,,Сіз нені жақсы көресіз?
Dialogue: 0,0:11:12.29,0:11:14.09,Default,,0,0,0,,Оны болжа
Dialogue: 0,0:11:15.17,0:11:17.84,Default,,0,0,0,,Өлтіру - бұл жауап.
Dialogue: 0,0:11:19.42,0:11:20.68,Default,,0,0,0,,Жағымсыз дәм
Dialogue: 0,0:11:43.11,0:11:44.70,Default,,0,0,0,,Менің бір өтінішім бар
Dialogue: 0,0:11:45.57,0:11:48.99,Default,,0,0,0,,Оның соңғы сөзінде не айтқанын айт.
Dialogue: 0,0:11:50.54,0:11:54.17,Default,,0,0,0,,Жазылмайтын сырқаттан сөз жинап жатырмын.
Dialogue: 0,0:11:54.79,0:11:58.09,Default,,0,0,0,,Мен оның сөздерімен бірге жазып алғым келеді.
Dialogue: 0,0:12:20.86,0:12:22.32,Default,,0,0,0,,Сіз қуғыншысыз ба?
Dialogue: 0,0:12:22.82,0:12:24.20,Default,,0,0,0,,Арнайы тапсырыстар үшін жақсы.
Dialogue: 0,0:12:25.24,0:12:26.95,Default,,0,0,0,,Бұл да жұмыс.
Dialogue: 0,0:12:29.62,0:12:30.79,Default,,0,0,0,,Ол туралы не деуге болады?
Dialogue: 0,0:12:32.54,0:12:34.04,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:12:35.17,0:12:36.83,Default,,0,0,0,,Бастық сені де жоғалтып алса
Dialogue: 0,0:12:36.92,0:12:39.80,Default,,0,0,0,,Менің сезімімді қандай да бір дәрежеде түсіне аласыз ба?
Dialogue: 0,0:12:40.76,0:12:42.47,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:12:43.13,0:12:46.09,Default,,0,0,0,,Енді біз қанша жерге барамыз?
Dialogue: 0,0:12:47.55,0:12:49.22,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:12:57.48,0:13:00.44,Default,,0,0,0,,Әкеңіз сізді ұйымға қайта оралуыңызды сұрады ма?
Dialogue: 0,0:13:01.61,0:13:05.20,Default,,0,0,0,,Сіздің үйден кеткеніңізді естідім, сондықтан біраз үміт бар деп ойладым.
Dialogue: 0,0:13:05.70,0:13:08.28,Default,,0,0,0,,Бұл оның Сува отбасының мүшесі екенін білдіре ме?
Dialogue: 0,0:13:33.68,0:13:34.18,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:39.98,0:13:42.73,Default,,0,0,0,,Нөл Папа кейде жалғыз болып көрінеді
Dialogue: 0,0:13:42.82,0:13:45.99,Default,,0,0,0,,Ол үнемі шлюха сияқты әрекет етеді, солай емес пе?
Dialogue: 0,0:13:46.61,0:13:49.74,Default,,0,0,0,,Адамның жүрегін түсінбейсің.
Dialogue: 0,0:13:49.82,0:13:53.12,Default,,0,0,0,,А... қайдан есіңде қалды? Мұндай нәрсе
Dialogue: 0,0:13:53.20,0:13:56.12,Default,,0,0,0,,Миридің анасы ішкен кезде
Dialogue: 0,0:13:56.21,0:13:58.87,Default,,0,0,0,,Көңілді көрінгенімен, жалғыз көрінеді
Dialogue: 0,0:13:59.67,0:14:03.88,Default,,0,0,0,,Нөл әкем де бүгін Шәкін болып киінген.
Dialogue: 0,0:14:03.96,0:14:05.71,Default,,0,0,0,,Мен өзімді жалғыз сезіндім.
Dialogue: 0,0:14:09.39,0:14:10.39,Default,,0,0,0,,Чи…
Dialogue: 0,0:14:15.64,0:14:18.64,Default,,0,0,0,,Сондықтан бүгін «Сапурай»
Dialogue: 0,0:14:18.73,0:14:22.19,Default,,0,0,0,,Нөл Папаға ұнайтын көптеген нәрселерді дайындаңыз.
Dialogue: 0,0:14:22.27,0:14:23.90,Default,,0,0,0,,Мені таң қалдыр
Dialogue: 0,0:14:24.94,0:14:27.99,Default,,0,0,0,,Нөл Папа, күлесіз бе?
Dialogue: 0,0:14:28.99,0:14:30.66,Default,,0,0,0,,О, мен сенімдімін
Dialogue: 0,0:14:32.87,0:14:36.37,Default,,0,0,0,,Қызық, жақын арада қайтасың ба?
Dialogue: 0,0:14:38.00,0:14:40.08,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:14:52.97,0:14:53.97,Default,,0,0,0,,(шу)
Dialogue: 0,0:15:03.19,0:15:04.94,Default,,0,0,0,,Өткенді еске түсірме
Dialogue: 0,0:15:05.02,0:15:07.03,Default,,0,0,0,,Мен сені ешқашан жеңген емеспін
Dialogue: 0,0:15:07.61,0:15:08.32,Default,,0,0,0,,Хмм…
Dialogue: 0,0:15:13.41,0:15:16.95,Default,,0,0,0,,Адамдарды құрал ретінде өлтіру, еріксіз ұйымды мұрагер ету
Dialogue: 0,0:15:17.45,0:15:20.12,Default,,0,0,0,,Мен пышағымды еш ойланбастан кез келген адамға бағыттаймын.
Dialogue: 0,0:15:20.62,0:15:22.50,Default,,0,0,0,,идеалды өлтіруші!
Dialogue: 0,0:15:23.83,0:15:25.67,Default,,0,0,0,,Бұл ұйымның заңы.
Dialogue: 0,0:15:25.75,0:15:27.50,Default,,0,0,0,,Сіз аяғыңызды жоғалта алмайтыныңызды білесіз!
Dialogue: 0,0:15:29.80,0:15:31.43,Default,,0,0,0,,Қуыршақ түсінбейтін шығар.
Dialogue: 0,0:15:31.93,0:15:33.76,Default,,0,0,0,,Мен қорғағым келетін нәрсені таптым!
Dialogue: 0,0:15:33.84,0:15:37.10,Default,,0,0,0,,Сондықтан мен өз өмірімді өзгерткім келді, болды!
Dialogue: 0,0:15:38.18,0:15:42.14,Default,,0,0,0,,Бірақ сендер менің ең қымбат дүниемді алып кеттіңдер.
Dialogue: 0,0:15:44.56,0:15:45.36,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:54.70,0:15:56.16,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:15:56.66,0:15:58.91,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:16:03.58,0:16:07.50,Default,,0,0,0,,Егер мен қорғағым келетін бірдеңе болса...
Dialogue: 0,0:16:08.75,0:16:12.26,Default,,0,0,0,,Хмф... Сіз де өзгерте алмайсыз!
Dialogue: 0,0:16:18.26,0:16:19.22,Default,,0,0,0,,Уф
Dialogue: 0,0:16:19.72,0:16:21.06,Default,,0,0,0,,Хмф! (Каджи) Жақсы...
Dialogue: 0,0:16:35.78,0:16:38.20,Default,,0,0,0,,Енді... жүріңіз
Dialogue: 0,0:16:40.41,0:16:41.83,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:16:51.46,0:16:52.97,Default,,0,0,0,,Лезде өлім?
Dialogue: 0,0:16:53.51,0:16:58.05,Default,,0,0,0,,Көңіл қалдырады. Ол қауесет сияқты жақсы емес.
Dialogue: 0,0:16:59.93,0:17:01.56,Default,,0,0,0,,Соңғы сөздеріңіз қандай?
Dialogue: 0,0:17:03.39,0:17:04.44,Default,,0,0,0,,…болған жоқ
Dialogue: 0,0:17:05.64,0:17:06.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:07.19,0:17:08.61,Default,,0,0,0,,Мен оны ести алмадым
Dialogue: 0,0:17:09.31,0:17:11.65,Default,,0,0,0,,Tsk, бұл пайдасыз.
Dialogue: 0,0:17:15.57,0:17:16.70,Default,,0,0,0,,Мен қайтамын.
Dialogue: 0,0:17:17.24,0:17:19.58,Default,,0,0,0,,Жоқ, мен мұнда жақсымын.
Dialogue: 0,0:17:21.04,0:17:23.33,Default,,0,0,0,,Екеуі де жақсы болар еді...
Dialogue: 0,0:17:24.25,0:17:27.50,Default,,0,0,0,,Оның сөзі немесе сенікі
Dialogue: 0,0:17:40.85,0:17:44.27,Default,,0,0,0,,Үмітіңізді ақтамаңыз.
Dialogue: 0,0:17:45.81,0:17:47.35,Default,,0,0,0,,Мен бірдеймін бе?
Dialogue: 0,0:17:48.40,0:17:53.03,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:18:01.62,0:18:03.79,Default,,0,0,0,,Мен саған қайтып кел дедім.
Dialogue: 0,0:18:04.29,0:18:05.95,Default,,0,0,0,,Енді қайдасың...
Dialogue: 0,0:18:06.04,0:18:08.75,Default,,0,0,0,,Нашар Мен бүгін басымды сәл салқындатамын.
Dialogue: 0,0:18:08.83,0:18:10.38,Default,,0,0,0,,А? Бір минут күте тұрыңыз...
Dialogue: 0,0:18:15.30,0:18:17.47,Default,,0,0,0,,Сіз де өзгерте алмайсыз!
Dialogue: 0,0:18:19.47,0:18:21.97,Default,,0,0,0,,Мен бұл туралы ұзақ ойламауға тырыстым.
Dialogue: 0,0:18:24.60,0:18:26.43,Default,,0,0,0,,Бұйрық бойынша
Dialogue: 0,0:18:27.27,0:18:28.44,Default,,0,0,0,,Достар...?
Dialogue: 0,0:18:29.19,0:18:30.44,Default,,0,0,0,,Достар...?
Dialogue: 0,0:18:31.19,0:18:32.44,Default,,0,0,0,,Достар...?
Dialogue: 0,0:18:34.98,0:18:36.40,Default,,0,0,0,,Менің атым – Кёома Хоуоин
Dialogue: 0,0:18:38.28,0:18:39.66,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:44.24,0:18:46.37,Default,,0,0,0,,Әй, сен не істеп жатырсың, ақымақ Нөл!
Dialogue: 0,0:18:46.45,0:18:47.75,Default,,0,0,0,,Екі...
Dialogue: 0,0:18:47.83,0:18:49.46,Default,,0,0,0,,Уақыт жоқ. Жүріңіз!
Dialogue: 0,0:18:50.04,0:18:50.87,Default,,0,0,0,,(Сота) Онда менің үйіме барайық! Апама айтамын!
Dialogue: 0,0:18:50.96,0:18:53.29,Default,,0,0,0,,Жай айтпаңыз!
Dialogue: 0,0:18:56.13,0:18:56.80,Default,,0,0,0,,Миллиметрлер ше?
Dialogue: 0,0:18:56.88,0:18:59.47,Default,,0,0,0,,Бұл үй. (Нөл) Сіз оны артта қалдырдыңыз ба?
Dialogue: 0,0:18:59.55,0:19:00.97,Default,,0,0,0,,Рэм де көмектеседі.
Dialogue: 0,0:19:01.05,0:19:03.22,Default,,0,0,0,,Одан гөрі менің уақытым аз, сондықтан оны өткізіп жіберемін.
Dialogue: 0,0:19:03.80,0:19:05.18,Default,,0,0,0,,ше? Не...
Dialogue: 0,0:19:09.23,0:19:10.35,Default,,0,0,0,,Неге сонда?
Dialogue: 0,0:19:10.44,0:19:13.73,Default,,0,0,0,,Смартфонды кім орнатты деп ойлайсыз?
Dialogue: 0,0:19:15.02,0:19:16.57,Default,,0,0,0,,Сіз тым қорғансыз.
Dialogue: 0,0:19:17.07,0:19:20.20,Default,,0,0,0,,Қайтып келмесең, Мири күйзеліске түседі.
Dialogue: 0,0:19:20.28,0:19:22.24,Default,,0,0,0,,Менің амалым жоқ, ақымақ!
Dialogue: 0,0:19:23.66,0:19:26.12,Default,,0,0,0,,Мири сен туралы көп нәрсені сұрады.
Dialogue: 0,0:19:26.20,0:19:29.25,Default,,0,0,0,,Өткендегі бірдеңені есіме түсірмей тұра алмадым.
Dialogue: 0,0:19:29.87,0:19:30.75,Default,,0,0,0,,Ұзақ уақыт бұрын?
Dialogue: 0,0:19:31.33,0:19:33.96,Default,,0,0,0,,Хиса-чан сені менімен таныстырғанда.
Dialogue: 0,0:19:34.04,0:19:35.92,Default,,0,0,0,,Сіз тоз-тоз болып қалдыңыз.
Dialogue: 0,0:19:36.42,0:19:39.76,Default,,0,0,0,,Бөлменің іші қоқыс, ал тамақ тез дайындалатын тағамға толы.
Dialogue: 0,0:19:40.34,0:19:42.22,Default,,0,0,0,,Шаш пен сақал қалағанша өседі
Dialogue: 0,0:19:42.30,0:19:45.76,Default,,0,0,0,,Ол жабық қана емес, көзі өліп қалған, зомбиге ұқсайтын.
Dialogue: 0,0:19:45.85,0:19:49.06,Default,,0,0,0,,Мен әлі де хикикоморимын.
Dialogue: 0,0:19:51.23,0:19:53.94,Default,,0,0,0,,Дүниенің бақытсыздығы сияқты сен де
Dialogue: 0,0:19:54.02,0:19:57.23,Default,,0,0,0,,Ол менің кінәм сияқты көрінді, бұл ренжітті.
Dialogue: 0,0:19:57.32,0:20:00.57,Default,,0,0,0,,Жұмыс істеп жүрген кезімде де алғашында ыңғайсыздық тудырды, бірақ олай емес.
Dialogue: 0,0:20:00.65,0:20:01.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:01.74,0:20:05.20,Default,,0,0,0,,Сіз мұны бұрын ешқашан айтқан емессіз!
Dialogue: 0,0:20:05.28,0:20:06.58,Default,,0,0,0,,Айтпады
Dialogue: 0,0:20:07.16,0:20:09.83,Default,,0,0,0,,Айтсам да ештеңе өзгермейді деп ойладым.
Dialogue: 0,0:20:10.37,0:20:12.25,Default,,0,0,0,,Мен солай деп ойладым.
Dialogue: 0,0:20:14.46,0:20:18.30,Default,,0,0,0,,Бірақ сіз кенеттен тазалауды бастадыңыз.
Dialogue: 0,0:20:18.38,0:20:19.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:23.05,0:20:26.97,Default,,0,0,0,,Мен соншалықты жалқаулыққа шыдай алмаймын.
Dialogue: 0,0:20:38.07,0:20:39.82,Default,,0,0,0,,Мен мұны қажетсіз ыңғайсыздық деп ойладым.
Dialogue: 0,0:20:40.57,0:20:41.90,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:20:44.24,0:20:45.32,Default,,0,0,0,,Ойын ішінде болсақ, қауіпсізбіз!
Dialogue: 0,0:20:45.99,0:20:47.57,Default,,0,0,0,,Бұл жаман болған жоқ.
Dialogue: 0,0:20:47.66,0:20:49.45,Default,,0,0,0,,...
Dialogue: 0,0:20:50.20,0:20:52.41,Default,,0,0,0,,Эй, Икки (Икки)?
Dialogue: 0,0:20:54.54,0:20:57.33,Default,,0,0,0,,Біз өзгерте аламыз ба?
Dialogue: 0,0:20:57.42,0:21:00.63,Default,,0,0,0,,Хаха... Олай болса.
Dialogue: 0,0:21:04.97,0:21:05.93,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:21:06.43,0:21:09.85,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:21:14.48,0:21:16.60,Default,,0,0,0,,А, бұл бүгін болды.
Dialogue: 0,0:21:17.19,0:21:19.40,Default,,0,0,0,,Milli Zero is back.
Dialogue: 0,0:21:19.48,0:21:20.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:21.44,0:21:25.32,Default,,0,0,0,,Мири таңертеңнен бері маған көмектесіп жүр.
Dialogue: 0,0:21:26.74,0:21:29.16,Default,,0,0,0,,Мен сенің бақытты болғаныңды қалаймын
Dialogue: 0,0:21:31.79,0:21:35.79,Default,,0,0,0,,Хмм... Иә? Нөл папа?
Dialogue: 0,0:21:35.87,0:21:37.42,Default,,0,0,0,,Қайтадан қош келдіңіз~
Dialogue: 0,0:21:39.38,0:21:42.80,Default,,0,0,0,,♪ Happy Birthday to you
Dialogue: 0,0:21:43.30,0:21:46.51,Default,,0,0,0,,♪ Туған күніңмен...
Dialogue: 0,0:21:49.97,0:21:50.72,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:21:51.31,0:21:53.97,Default,,0,0,0,,Сәлем! Well done Miri, you laughed.
Dialogue: 0,0:21:58.31,0:21:59.19,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:21:59.77,0:22:00.52,Default,,0,0,0,,О
Dialogue: 0,0:22:01.19,0:22:04.32,Default,,0,0,0,,Өте ұзақ уақыттан бері көрмеппін.
Dialogue: 0,0:22:09.36,0:22:11.20,Default,,0,0,0,,Кешіріңіз, бүгін...
Dialogue: 0,0:22:16.41,0:22:18.75,Default,,0,0,0,,Бастықтың тергеу сұрауы.
Dialogue: 0,0:22:19.46,0:22:21.67,Default,,0,0,0,,Ұйым сізге сенеді
Dialogue: 0,0:22:31.01,0:22:33.01,Default,,0,0,0,,♪～
Dialogue: 0,0:23:58.89,0:24:00.89,Default,,0,0,0,,～♪
