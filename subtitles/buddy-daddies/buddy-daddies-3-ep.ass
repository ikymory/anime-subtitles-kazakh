Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.38,0:00:06.29,Default,,0,0,0,,Сенде ондай мақсат болса да…
Dialogue: 0,0:00:06.38,0:00:08.29,Default,,0,0,0,,Мені әке деме
Dialogue: 0,0:00:08.38,0:00:10.96,Default,,0,0,0,,Мен сенің бастығыңмын
Dialogue: 0,0:00:12.26,0:00:13.30,Default,,0,0,0,,Э? Бірақ Браун мырза әлі төменде жүр ғой, иә?
Dialogue: 0,0:00:14.59,0:00:16.68,Default,,0,0,0,,Таң атты~
Dialogue: 0,0:00:17.30,0:00:18.64,Default,,0,0,0,,Оян!
Dialogue: 0,0:00:18.72,0:00:22.18,Default,,0,0,0,,Абаба ба ба ба ба ба ба ба…
Dialogue: 0,0:00:22.27,0:00:24.98,Default,,0,0,0,,Мен Зеро-кунмен таңғы ас ішкім келеді.
Dialogue: 0,0:00:25.48,0:00:27.31,Default,,0,0,0,,Эй, оян!
Dialogue: 0,0:00:27.40,0:00:28.61,Default,,0,0,0,,Оян!
Dialogue: 0,0:00:28.69,0:00:29.69,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:00:30.19,0:00:31.78,Default,,0,0,0,,Кяхахаха!
Dialogue: 0,0:00:31.86,0:00:32.94,Default,,0,0,0,,Жай ғана кездесіңіз…
Dialogue: 0,0:00:33.03,0:00:34.61,Default,,0,0,0,,Ия, мен жасадым!
Dialogue: 0,0:00:40.83,0:00:42.37,Default,,0,0,0,,Хмм!
Dialogue: 0,0:00:43.37,0:00:44.21,Default,,0,0,0,,Уау~
Dialogue: 0,0:00:44.29,0:00:46.71,Default,,0,0,0,,Себебі оны жегісі келеді.
Dialogue: 0,0:00:46.79,0:00:49.13,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:00:49.96,0:00:50.80,Default,,0,0,0,,Әй!
Dialogue: 0,0:00:51.30,0:00:53.63,Default,,0,0,0,,(тырнақ дыбысы)
Dialogue: 0,0:00:53.72,0:00:54.88,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:00:56.38,0:00:57.47,Default,,0,0,0,,Бұл жігіттер...
Dialogue: 0,0:00:59.01,0:01:00.97,Default,,0,0,0,,Мен бүгін Кючанмен барамын.
Dialogue: 0,0:01:01.47,0:01:02.22,Default,,0,0,0,,Жұмыс?
Dialogue: 0,0:01:02.31,0:01:05.06,Default,,0,0,0,,Жоқ, мен оның ата-анасын іздеп жүрмін.
Dialogue: 0,0:01:05.14,0:01:06.23,Default,,0,0,0,,Ах~
Dialogue: 0,0:01:06.31,0:01:07.85,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:01:07.94,0:01:09.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:09.11,0:01:10.32,Default,,0,0,0,,Құшақтас!
Dialogue: 0,0:01:10.40,0:01:13.11,Default,,0,0,0,,Ал... ол әлі тамақтанып жатыр.
Dialogue: 0,0:01:14.11,0:01:16.15,Default,,0,0,0,,Қараңдар, банан жасайық~ Банан~
Dialogue: 0,0:01:16.24,0:01:18.16,Default,,0,0,0,,Уау! Банан~!
Dialogue: 0,0:01:18.74,0:01:20.41,Default,,0,0,0,,Қызықты қызықты! (Икки) Қарашы, қарашы, аласың ба?
Dialogue: 0,0:01:20.49,0:01:22.37,Default,,0,0,0,,Банан~ Банан~! (Икки) Бұл дәмді банан~
Dialogue: 0,0:01:22.45,0:01:25.37,Default,,0,0,0,,Ахаха сен маймылға ұқсайсың.
Dialogue: 0,0:01:25.46,0:01:27.96,Default,,0,0,0,,Эй, Баняня деп айтып көріңіз. Баняня айтыңыз.
Dialogue: 0,0:01:28.04,0:01:30.00,Default,,0,0,0,,Ата-анаңызға қайтарыңыз.
Dialogue: 0,0:01:30.59,0:01:33.00,Default,,0,0,0,,Эй, мен мұны қалаймын!
Dialogue: 0,0:01:33.09,0:01:34.38,Default,,0,0,0,,Қызықты
Dialogue: 0,0:01:34.46,0:01:38.64,Default,,0,0,0,,Бала тәрбиелеуге ешқандай мүмкіндік жоқ.
Dialogue: 0,0:01:39.14,0:01:40.72,Default,,0,0,0,,Өйткені, біз...
Dialogue: 0,0:01:41.30,0:01:43.01,Default,,0,0,0,,Өйткені мен көлеңкелі адаммын.
Dialogue: 0,0:01:47.52,0:01:49.52,Default,,0,0,0,,♪～
Dialogue: 0,0:03:14.90,0:03:16.90,Default,,0,0,0,,～♪
Dialogue: 0,0:03:19.99,0:03:24.66,Default,,0,0,0,,(әйнек сүрту дыбысы)
Dialogue: 0,0:03:25.16,0:03:27.49,Default,,0,0,0,,Өткен күн нашар болды.
Dialogue: 0,0:03:27.99,0:03:30.58,Default,,0,0,0,,А... ол жұмысқа не болды?
Dialogue: 0,0:03:30.66,0:03:33.21,Default,,0,0,0,,Сізге білудің қажеті жоқ
Dialogue: 0,0:03:33.29,0:03:35.34,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:03:35.42,0:03:37.46,Default,,0,0,0,,Маған соны сұрады.
Dialogue: 0,0:03:37.55,0:03:39.63,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:39.71,0:03:41.47,Default,,0,0,0,,Оны сізге жіберейін бе? (Икки) Иә?
Dialogue: 0,0:03:42.47,0:03:46.47,Default,,0,0,0,,Нысананың артында сыйлық қуыршақ немесе басқа нәрсе қалды, солай ма?
Dialogue: 0,0:03:46.55,0:03:49.18,Default,,0,0,0,,А, а... иә.
Dialogue: 0,0:03:49.27,0:03:51.64,Default,,0,0,0,,А-а, мен... А-а, мен асығып тұрмын, мінекей!
Dialogue: 0,0:03:51.73,0:03:52.60,Default,,0,0,0,,Гочисусан
Dialogue: 0,0:03:53.27,0:03:56.11,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:04:02.70,0:04:05.11,Default,,0,0,0,,Миридің анасының жатқан жері табылды.
Dialogue: 0,0:04:05.20,0:04:06.45,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:06.95,0:04:09.62,Default,,0,0,0,,Олар жақсы ата-ана болады деп ойламаймын.
Dialogue: 0,0:04:09.70,0:04:12.75,Default,,0,0,0,,Сонда да жоқтан жақсы.
Dialogue: 0,0:04:13.50,0:04:16.54,Default,,0,0,0,,Мен ата-анамның жүзін де білмеймін.
Dialogue: 0,0:04:16.63,0:04:19.96,Default,,0,0,0,,Мен көп шатастырғаным сонша, ол мынаған айналды.
Dialogue: 0,0:04:21.17,0:04:23.34,Default,,0,0,0,,Бұлай айтатындар сирек.
Dialogue: 0,0:04:23.42,0:04:24.38,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:04:24.47,0:04:25.72,Default,,0,0,0,,Иә! (2 адам) Иә?
Dialogue: 0,0:04:25.80,0:04:28.72,Default,,0,0,0,,Оданго, өтінемін!
Dialogue: 0,0:04:32.48,0:04:34.56,Default,,0,0,0,,Жеңдер! (Икки) Мен оны жей аламын ...
Dialogue: 0,0:04:34.64,0:04:37.19,Default,,0,0,0,,Па-па же!
Dialogue: 0,0:04:37.27,0:04:40.94,Default,,0,0,0,,Сіз! Көпшілік алдында мені әке деме
Dialogue: 0,0:04:43.11,0:04:44.90,Default,,0,0,0,,Ешкім жоқ
Dialogue: 0,0:04:46.32,0:04:48.95,Default,,0,0,0,,Иә, мен аламын!
Dialogue: 0,0:04:49.45,0:04:50.37,Default,,0,0,0,,Ма... Масу
Dialogue: 0,0:04:50.45,0:04:53.41,Default,,0,0,0,,Ах... (сөйлеуші) ♪ Таста қуырылған тәтті картоп...
Dialogue: 0,0:04:53.50,0:04:56.42,Default,,0,0,0,,Бұл тәтті картоп дүкені! (Икки) Ах...
Dialogue: 0,0:04:57.96,0:05:01.13,Default,,0,0,0,,Жоқ, мен бұл күлкіге қарсы тұра алмаймын.
Dialogue: 0,0:05:02.26,0:05:05.97,Default,,0,0,0,,Осы жаста көп күлгенім есімде жоқ.
Dialogue: 0,0:05:07.09,0:05:08.47,Default,,0,0,0,,Мен де емеспін.
Dialogue: 0,0:05:08.55,0:05:12.56,Default,,0,0,0,,Ой, балалар сендерге қиналып жатқан сияқтысыңдар.
Dialogue: 0,0:05:12.64,0:05:13.77,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:05:15.31,0:05:16.35,Default,,0,0,0,,Менен сұрама
Dialogue: 0,0:05:17.56,0:05:18.44,Default,,0,0,0,,Мен оны айтпаймын
Dialogue: 0,0:05:18.94,0:05:22.11,Default,,0,0,0,,Ей, тәтті картоп жейміз!
Dialogue: 0,0:05:29.16,0:05:30.53,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:05:34.29,0:05:36.96,Default,,0,0,0,,Уау (қуырылған тәтті картоп дүкені) Күн ыстық, абай болыңыз.
Dialogue: 0,0:05:42.00,0:05:42.96,Default,,0,0,0,,Соңында...
Dialogue: 0,0:05:44.51,0:05:46.84,Default,,0,0,0,,Бұл үлгі емес еді.
Dialogue: 0,0:05:48.30,0:05:51.22,Default,,0,0,0,,Тәтті картоп~! (Икки) Мен ше?
Dialogue: 0,0:05:51.30,0:05:52.72,Default,,0,0,0,,Жоқ (Ikki) Иә?
Dialogue: 0,0:05:52.81,0:05:55.14,Default,,0,0,0,,Иә, әке, жарымжан.
Dialogue: 0,0:05:55.64,0:05:58.44,Default,,0,0,0,,Сен жақсы қызсың~ Уф...
Dialogue: 0,0:05:58.52,0:05:59.65,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:06:02.82,0:06:05.07,Default,,0,0,0,,Эй, мен саған сусын сатып алайын деп жатырмын.
Dialogue: 0,0:06:10.32,0:06:12.24,Default,,0,0,0,,Әткеншекпен серуендеу!
Dialogue: 0,0:06:17.04,0:06:18.50,Default,,0,0,0,,басыңыз!
Dialogue: 0,0:06:18.58,0:06:20.50,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:21.00,0:06:21.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:22.13,0:06:24.88,Default,,0,0,0,,Бір ғана қыз бар ма?
Dialogue: 0,0:06:28.05,0:06:29.43,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:30.72,0:06:33.39,Default,,0,0,0,,Сіз әкеңізсіз бе? (Нөл) Жоқ
Dialogue: 0,0:06:33.47,0:06:35.47,Default,,0,0,0,,Сонымен, сіздің отбасыңыз?
Dialogue: 0,0:06:36.39,0:06:36.89,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:39.14,0:06:39.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:40.65,0:06:41.81,Default,,0,0,0,,500 метр радиустағы тұрғындар да көшірілді.
Dialogue: 0,0:06:42.44,0:06:44.07,Default,,0,0,0,,О, сен менің әкемсің бе?
Dialogue: 0,0:06:44.15,0:06:47.24,Default,,0,0,0,,Не? А... иә, солай.
Dialogue: 0,0:06:47.32,0:06:48.28,Default,,0,0,0,,Сәлем? мм
Dialogue: 0,0:06:51.28,0:06:52.87,Default,,0,0,0,,Жүр, мені әке деп шақыр.
Dialogue: 0,0:06:56.62,0:06:58.20,Default,,0,0,0,,Милиция?
Dialogue: 0,0:06:58.87,0:07:02.42,Default,,0,0,0,,Өйткені дәл қазір сыртта мені әке деуге болмайды.
Dialogue: 0,0:07:02.50,0:07:04.50,Default,,0,0,0,,Жоқ, қазір емес!
Dialogue: 0,0:07:05.00,0:07:09.22,Default,,0,0,0,,Мм... сіз мұны естідіңіз бе? Бұл жігіт мені әке деп атады
Dialogue: 0,0:07:09.30,0:07:10.76,Default,,0,0,0,,Иә, жақсы...
Dialogue: 0,0:07:10.84,0:07:13.76,Default,,0,0,0,,Қара, уайымдама, Мири.
Dialogue: 0,0:07:13.85,0:07:16.26,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:18.93,0:07:21.85,Default,,0,0,0,,Ондай кезде мені әке деуге болады.
Dialogue: 0,0:07:21.94,0:07:24.27,Default,,0,0,0,,Иә, түсіндім, әке!
Dialogue: 0,0:07:24.36,0:07:28.69,Default,,0,0,0,,Бұл орын алғанда, сіз тек әке екеніңізді айтыңыз.
Dialogue: 0,0:07:28.78,0:07:29.57,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:29.65,0:07:31.61,Default,,0,0,0,,Бұл сондай әурешілік, солай емес пе?
Dialogue: 0,0:07:32.41,0:07:34.12,Default,,0,0,0,,Нөл сіздің әкеңіз бе?
Dialogue: 0,0:07:34.78,0:07:35.62,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:35.70,0:07:38.29,Default,,0,0,0,,Нөл әке! (Нөл) Бұл басқаша.
Dialogue: 0,0:07:38.37,0:07:40.96,Default,,0,0,0,,Нөл Papa~n (Нөл) Оны тоқтатыңыз.
Dialogue: 0,0:07:42.42,0:07:45.00,Default,,0,0,0,,Эй, қазір ұйықта.
Dialogue: 0,0:07:45.08,0:07:46.38,Default,,0,0,0,,Әйтпесе...
Dialogue: 0,0:07:46.46,0:07:48.34,Default,,0,0,0,,Елес пайда болады!
Dialogue: 0,0:07:48.42,0:07:50.05,Default,,0,0,0,,Мен елестерді көргім келеді!
Dialogue: 0,0:07:50.72,0:07:54.72,Default,,0,0,0,,Аа, бұл өтірік. Ешқандай елес жоқ. Қазір ұйықта.
Dialogue: 0,0:07:54.80,0:07:57.85,Default,,0,0,0,,Иә~ мен әкеммен жатқым келеді~
Dialogue: 0,0:07:57.93,0:07:59.43,Default,,0,0,0,,Мен шамдарды сөндіремін.
Dialogue: 0,0:07:59.52,0:08:00.98,Default,,0,0,0,,Сен ше, Нөл?
Dialogue: 0,0:08:01.06,0:08:02.52,Default,,0,0,0,,1-A сыныбы 1-B сыныбына қарсы—
Dialogue: 0,0:08:03.27,0:08:04.60,Default,,0,0,0,,Ммм~
Dialogue: 0,0:08:12.74,0:08:15.07,Default,,0,0,0,,Нөл-күн, не...?
Dialogue: 0,0:08:23.96,0:08:24.87,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:08:26.96,0:08:29.00,Default,,0,0,0,,Неге мұнда ұйықтайсың?
Dialogue: 0,0:08:29.09,0:08:31.30,Default,,0,0,0,,Тосын шабуылға дайындалу
Dialogue: 0,0:08:31.38,0:08:32.51,Default,,0,0,0,,Шугеки?
Dialogue: 0,0:08:34.84,0:08:36.26,Default,,0,0,0,,Бір қорқынышты жігіт келе жатыр
Dialogue: 0,0:08:36.34,0:08:37.68,Default,,0,0,0,,Елес?
Dialogue: 0,0:08:38.85,0:08:42.48,Default,,0,0,0,,Мм... Мири де менімен ұйықтайды!
Dialogue: 0,0:08:42.56,0:08:43.89,Default,,0,0,0,,Жоқ... а
Dialogue: 0,0:08:43.98,0:08:45.48,Default,,0,0,0,,Кяхаха!
Dialogue: 0,0:08:47.86,0:08:49.73,Default,,0,0,0,,Жалғыз болу қауіпті
Dialogue: 0,0:08:50.23,0:08:53.53,Default,,0,0,0,,Мен қорқынышты түс көріп, төсегімді сулағанда
Dialogue: 0,0:08:53.61,0:08:56.49,Default,,0,0,0,,Папа Икки саған ашуланады.
Dialogue: 0,0:08:57.78,0:09:00.74,Default,,0,0,0,,Қорқынышты, қорқынышты, ұшып кет~
Dialogue: 0,0:09:01.24,0:09:01.95,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:09:02.04,0:09:03.79,Default,,0,0,0,,Анам мұны мен үшін жасады.
Dialogue: 0,0:09:03.87,0:09:08.08,Default,,0,0,0,,Мири сәби кезінде смайлик
Dialogue: 0,0:09:08.58,0:09:09.63,Default,,0,0,0,,Хмм…
Dialogue: 0,0:09:10.50,0:09:11.80,Default,,0,0,0,,Күлімсіре!
Dialogue: 0,0:09:14.72,0:09:16.22,Default,,0,0,0,,Мен күле алмаймын
Dialogue: 0,0:09:17.39,0:09:18.64,Default,,0,0,0,,Маған соны үйретті.
Dialogue: 0,0:09:18.72,0:09:19.89,Default,,0,0,0,,Заклинание?
Dialogue: 0,0:09:20.39,0:09:21.68,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:09:24.68,0:09:26.35,Default,,0,0,0,,Күлімсіре!
Dialogue: 0,0:09:27.35,0:09:30.65,Default,,0,0,0,,Күлімде, күл!
Dialogue: 0,0:09:32.36,0:09:34.11,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:09:38.66,0:09:40.58,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:09:45.54,0:09:48.46,Default,,0,0,0,,Бұл менің анам...
Dialogue: 0,0:09:50.13,0:09:51.21,Default,,0,0,0,,Сыртқа шығасыз ба?
Dialogue: 0,0:09:51.29,0:09:54.55,Default,,0,0,0,,О, анамның гамбургерін жегің келе ме?
Dialogue: 0,0:09:54.63,0:09:55.84,Default,,0,0,0,,Мен жедім!
Dialogue: 0,0:09:55.92,0:09:57.47,Default,,0,0,0,,Олай болса тамақ ішейік!
Dialogue: 0,0:09:57.55,0:09:59.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:09.23,0:10:11.11,Default,,0,0,0,,О, бұл керемет!
Dialogue: 0,0:10:11.19,0:10:13.11,Default,,0,0,0,,Әйтеуір керемет!
Dialogue: 0,0:10:13.19,0:10:16.03,Default,,0,0,0,,Бұл коммерциялық супермаркет деп аталады.
Dialogue: 0,0:10:16.11,0:10:17.99,Default,,0,0,0,,Gyoza үшін супер ме?
Dialogue: 0,0:10:18.07,0:10:19.28,Default,,0,0,0,,Гиоза емес
Dialogue: 0,0:10:19.36,0:10:20.57,Default,,0,0,0,,Джиму!
Dialogue: 0,0:10:20.66,0:10:23.37,Default,,0,0,0,,Милли гиозаны жақсы көреді!
Dialogue: 0,0:10:23.45,0:10:24.24,Default,,0,0,0,,Мен оны естіген жоқпын.
Dialogue: 0,0:10:24.33,0:10:27.91,Default,,0,0,0,,Хаа... Міне, бүгін бәрі бітті.
Dialogue: 0,0:10:28.41,0:10:29.33,Default,,0,0,0,,Өзіңізді сергек сезінбеңіз
Dialogue: 0,0:10:30.83,0:10:32.46,Default,,0,0,0,,Жарайды ма? шынымен
Dialogue: 0,0:10:32.54,0:10:34.96,Default,,0,0,0,,Не?
Dialogue: 0,0:10:36.38,0:10:39.59,Default,,0,0,0,,Бірге болудан жақсы ештеңе жоқ.
Dialogue: 0,0:10:40.09,0:10:42.72,Default,,0,0,0,,Біз бұрынғы өмірімізге қайта ораламыз.
Dialogue: 0,0:10:43.93,0:10:45.10,Default,,0,0,0,,Нашар жұмыс...
Dialogue: 0,0:11:01.45,0:11:04.33,Default,,0,0,0,,А, мен алдымен сені тексеремін.
Dialogue: 0,0:11:04.41,0:11:06.08,Default,,0,0,0,,Иә? Неліктен?
Dialogue: 0,0:11:06.16,0:11:08.16,Default,,0,0,0,,Аз ғана...
Dialogue: 0,0:11:09.21,0:11:11.79,Default,,0,0,0,,Хмм... гамбургер?
Dialogue: 0,0:11:11.87,0:11:14.50,Default,,0,0,0,,Әй, жақсы қыз болып, мені күт.
Dialogue: 0,0:11:33.27,0:11:34.52,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:11:35.52,0:11:41.53,Default,,0,0,0,,♪ Uh…
Dialogue: 0,0:11:41.61,0:11:42.78,Default,,0,0,0,,Бұл ән...
Dialogue: 0,0:11:43.61,0:11:47.33,Default,,0,0,0,,♪ Уу~ Уу~
Dialogue: 0,0:11:47.41,0:11:51.21,Default,,0,0,0,,(Мисакидің ән айту дауысы)
Dialogue: 0,0:11:53.71,0:11:58.42,Default,,0,0,0,,Ей, қызықсыз!
Dialogue: 0,0:11:58.50,0:12:00.46,Default,,0,0,0,,Әткеншек~ (Нөл) А?
Dialogue: 0,0:12:00.55,0:12:03.97,Default,,0,0,0,,Мен әткеншекке шыққым келеді! Мен мінгім келеді, мінгім келеді...
Dialogue: 0,0:12:04.05,0:12:06.26,Default,,0,0,0,,Мінгім келеді Мінгім келеді...
Dialogue: 0,0:12:06.35,0:12:07.30,Default,,0,0,0,,Теппе...
Dialogue: 0,0:12:12.23,0:12:19.23,Default,,0,0,0,,♪ Қош болма
Dialogue: 0,0:12:20.57,0:12:27.32,Default,,0,0,0,,♪ Қош болма
Dialogue: 0,0:12:27.41,0:12:28.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:28.53,0:12:30.70,Default,,0,0,0,,Дүкен түнде ашылады.
Dialogue: 0,0:12:31.20,0:12:32.71,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:12:33.58,0:12:34.79,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:12:34.87,0:12:36.54,Default,,0,0,0,,Оның шабуылдары ерекше төмен!
Dialogue: 0,0:12:37.08,0:12:37.59,Default,,0,0,0,,Ой
Dialogue: 0,0:12:37.67,0:12:40.09,Default,,0,0,0,,Рұқсатсыз тұтынушыларды қабылдамаңыз дедім.
Dialogue: 0,0:12:40.17,0:12:41.76,Default,,0,0,0,,Жоқ... Уф!
Dialogue: 0,0:12:41.84,0:12:43.34,Default,,0,0,0,,Сақтамаңыз!
Dialogue: 0,0:12:43.42,0:12:44.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:45.13,0:12:46.76,Default,,0,0,0,,Уау! (Икки) Тоқта!
Dialogue: 0,0:12:47.34,0:12:49.05,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:12:50.56,0:12:52.64,Default,,0,0,0,,Эй, келші
Dialogue: 0,0:12:56.02,0:12:56.65,Default,,0,0,0,,Аһ!
Dialogue: 0,0:13:00.23,0:13:01.90,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:03.32,0:13:04.74,Default,,0,0,0,,Амансың ба? Сіз де...
Dialogue: 0,0:13:06.45,0:13:08.66,Default,,0,0,0,,Менің адамыма не істеп жатырсың?
Dialogue: 0,0:13:15.83,0:13:16.67,Default,,0,0,0,,Саған хабарлап қояйын, бәлкім қажет болады.
Dialogue: 0,0:13:17.17,0:13:18.88,Default,,0,0,0,,Мен сенің тыртықтарыңды қараймын.
Dialogue: 0,0:13:19.75,0:13:21.92,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:13:22.51,0:13:24.13,Default,,0,0,0,,Нөл-күн, басыңыз!
Dialogue: 0,0:13:24.63,0:13:25.76,Default,,0,0,0,,Хаа~
Dialogue: 0,0:13:26.26,0:13:30.60,Default,,0,0,0,,Кяхахаха! Кяхаха…
Dialogue: 0,0:13:35.94,0:13:37.19,Default,,0,0,0,,Келесі!
Dialogue: 0,0:13:38.48,0:13:40.15,Default,,0,0,0,,Зеро-кун да мінеді
Dialogue: 0,0:13:43.11,0:13:44.28,Default,,0,0,0,,Басқаша!
Dialogue: 0,0:13:45.11,0:13:46.32,Default,,0,0,0,,Мына жерде!
Dialogue: 0,0:13:47.15,0:13:49.66,Default,,0,0,0,,Міне, Гиттанбаттан
Dialogue: 0,0:13:51.91,0:13:53.16,Default,,0,0,0,,Ах~
Dialogue: 0,0:13:53.24,0:13:57.04,Default,,0,0,0,,Ахахаха! Бұл қызық!
Dialogue: 0,0:13:57.12,0:13:59.67,Default,,0,0,0,,Ахахха! Ахахха...
Dialogue: 0,0:13:59.75,0:14:03.92,Default,,0,0,0,,(Миридің күлуі)
Dialogue: 0,0:14:04.00,0:14:06.67,Default,,0,0,0,,Нөл, қараңыз!
Dialogue: 0,0:14:06.76,0:14:08.13,Default,,0,0,0,,Сіз қарап отырсыз ба?
Dialogue: 0,0:14:08.22,0:14:09.89,Default,,0,0,0,,Сіз сол баланың әкесісіз бе?
Dialogue: 0,0:14:09.97,0:14:12.10,Default,,0,0,0,,Қолымды бір сілтеп қалсам ғой.
Dialogue: 0,0:14:12.18,0:14:13.18,Default,,0,0,0,,Елеусіздікке ұқсайды.
Dialogue: 0,0:14:13.85,0:14:15.93,Default,,0,0,0,,Нөл!
Dialogue: 0,0:14:16.02,0:14:18.44,Default,,0,0,0,,Хаа~
Dialogue: 0,0:14:18.52,0:14:21.44,Default,,0,0,0,,Ахахха~ Көңілді болды~
Dialogue: 0,0:14:21.52,0:14:24.32,Default,,0,0,0,,Ертең де ойнайық, Зеро-кун!
Dialogue: 0,0:14:24.94,0:14:26.94,Default,,0,0,0,,Екі Папа да бізбен бірге!
Dialogue: 0,0:14:28.15,0:14:31.62,Default,,0,0,0,,Неліктен Икки папа дейсің?
Dialogue: 0,0:14:31.70,0:14:35.66,Default,,0,0,0,,Әке - әке, ол Мириді құтқарды.
Dialogue: 0,0:14:36.16,0:14:37.33,Default,,0,0,0,,Сіздің нағыз әкеңіз кім?
Dialogue: 0,0:14:38.79,0:14:39.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:40.50,0:14:45.09,Default,,0,0,0,,Қиналғанда қол ұшын беретін әкем!
Dialogue: 0,0:14:45.17,0:14:46.80,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:14:48.51,0:14:50.13,Default,,0,0,0,,Әке?
Dialogue: 0,0:14:51.64,0:14:55.01,Default,,0,0,0,,Уф... Хаа Хаа...
Dialogue: 0,0:15:00.35,0:15:02.69,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:15:04.02,0:15:06.19,Default,,0,0,0,,Неліктен соңғы соққы емес?
Dialogue: 0,0:15:07.82,0:15:09.99,Default,,0,0,0,,Өлтіріңіз немесе өлтіріңіз
Dialogue: 0,0:15:12.07,0:15:13.91,Default,,0,0,0,,Мені ренжітпе
Dialogue: 0,0:15:14.41,0:15:15.37,Default,,0,0,0,,Сенде ондай мақсат болса да…
Dialogue: 0,0:15:17.58,0:15:19.12,Default,,0,0,0,,Мені әке деме
Dialogue: 0,0:15:19.20,0:15:20.83,Default,,0,0,0,,Мен сенің бастығыңмын
Dialogue: 0,0:15:27.00,0:15:30.01,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:15:31.63,0:15:34.18,Default,,0,0,0,,Міне осылай. (Бала) Күте тұрыңыз~
Dialogue: 0,0:15:34.26,0:15:34.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:48.19,0:15:51.15,Default,,0,0,0,,қандай мақсатта қолданылады?
Dialogue: 0,0:15:51.65,0:15:53.86,Default,,0,0,0,,Сенің қызың бар, солай ма?
Dialogue: 0,0:15:53.95,0:15:55.45,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:15:55.53,0:15:56.99,Default,,0,0,0,,Мен анамды көргім келеді
Dialogue: 0,0:15:57.08,0:16:00.08,Default,,0,0,0,,Әй, сен оның қол астындағысың ба?
Dialogue: 0,0:16:00.58,0:16:02.54,Default,,0,0,0,,Цк... Алимент туралы не айтасыз?
Dialogue: 0,0:16:03.04,0:16:04.00,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:16:04.08,0:16:05.54,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:16:05.63,0:16:08.09,Default,,0,0,0,,Мен тек жоғалған балаға қарап отырмын.
Dialogue: 0,0:16:08.17,0:16:09.46,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:16:09.96,0:16:13.72,Default,,0,0,0,,Жарайды, менің енді ол қызға қатысым жоқ.
Dialogue: 0,0:16:13.80,0:16:15.64,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:16:15.72,0:16:17.97,Default,,0,0,0,,Мен сіздің гамбургеріңізді жегім келеді деп жатырмын.
Dialogue: 0,0:16:18.06,0:16:21.35,Default,,0,0,0,,Төбет... Бұл супермаркеттің реніші.
Dialogue: 0,0:16:21.43,0:16:23.64,Default,,0,0,0,,Үш жиынтық үшін 200 иен
Dialogue: 0,0:16:24.14,0:16:27.98,Default,,0,0,0,,Сен осындай нәрсеге қуанатын арзан баласың.
Dialogue: 0,0:16:28.48,0:16:29.98,Default,,0,0,0,,Сіз кімге ұқсайсыз?
Dialogue: 0,0:16:30.07,0:16:32.53,Default,,0,0,0,,Бұл жағдайда оны өзіңіз жасауыңыз керек.
Dialogue: 0,0:16:33.03,0:16:34.11,Default,,0,0,0,,Өйткені ол ана
Dialogue: 0,0:16:34.20,0:16:36.62,Default,,0,0,0,,Ол баланы сүйгендіктен тудым дедің бе?
Dialogue: 0,0:16:38.70,0:16:41.50,Default,,0,0,0,,Жауапсыз адам мені алдап кетті.
Dialogue: 0,0:16:42.00,0:16:45.79,Default,,0,0,0,,Маған бір тиын ақша берме, мені қуып жібереді...
Dialogue: 0,0:16:46.29,0:16:48.84,Default,,0,0,0,,Мен енді ол қыздың түрін көргім келмейді.
Dialogue: 0,0:16:49.34,0:16:50.71,Default,,0,0,0,,Сіз...
Dialogue: 0,0:16:50.80,0:16:54.55,Default,,0,0,0,,Әлгі бала күлген сайын мен оны жұдырығыммен ұрғым келеді.
Dialogue: 0,0:16:55.05,0:16:57.85,Default,,0,0,0,,Мұнда таңғаларлық ештеңе жоқ.
Dialogue: 0,0:16:57.93,0:16:59.72,Default,,0,0,0,,маған күліңіз
Dialogue: 0,0:17:00.64,0:17:02.93,Default,,0,0,0,,Мен саған тоқтаңдар дедім...
Dialogue: 0,0:17:03.43,0:17:05.44,Default,,0,0,0,,А, мен қатты ашуландым!
Dialogue: 0,0:17:06.23,0:17:08.44,Default,,0,0,0,,Баланың күнәсі қандай?
Dialogue: 0,0:17:08.52,0:17:10.65,Default,,0,0,0,,Сіз де жауапсызсыз.
Dialogue: 0,0:17:10.73,0:17:13.03,Default,,0,0,0,,Керемет уағыз?
Dialogue: 0,0:17:13.69,0:17:14.99,Default,,0,0,0,,Бала күліп тұрса
Dialogue: 0,0:17:15.07,0:17:17.24,Default,,0,0,0,,Мен қорғағым келетін нәрсе - бұл
Dialogue: 0,0:17:17.32,0:17:18.37,Default,,0,0,0,,Ата-аналар да, солай ма?
Dialogue: 0,0:17:18.45,0:17:21.74,Default,,0,0,0,,Коо... Фуфу Ахахахха!
Dialogue: 0,0:17:22.33,0:17:24.33,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:17:24.87,0:17:29.21,Default,,0,0,0,,Мені күнде тамақтандырып, киіндір...
Dialogue: 0,0:17:30.71,0:17:34.59,Default,,0,0,0,,Ол менің арманымды жойды, бірақ сен әлі күліп жүрсің бе?
Dialogue: 0,0:17:34.67,0:17:37.76,Default,,0,0,0,,Егер сіз ана болсаңыз, бұлай істеу табиғи болар еді.
Dialogue: 0,0:17:38.26,0:17:41.39,Default,,0,0,0,,Күресіп, өміріңді балаларыңа арнау
Dialogue: 0,0:17:41.47,0:17:43.22,Default,,0,0,0,,Ата-ана бақыты емес пе?
Dialogue: 0,0:17:47.02,0:17:49.56,Default,,0,0,0,,Жақсы сөз айтатындар ғана
Dialogue: 0,0:17:49.65,0:17:51.73,Default,,0,0,0,,Сіз өз отбасыңызды бақытсыз етіп жатырсыз.
Dialogue: 0,0:17:56.78,0:17:59.95,Default,,0,0,0,,Мен ешқашан бала өсірген емеспін.
Dialogue: 0,0:18:00.03,0:18:02.20,Default,,0,0,0,,Қалжыңдамаңыз!
Dialogue: 0,0:18:18.68,0:18:21.72,Default,,0,0,0,,Барлығың кетіңдер!
Dialogue: 0,0:18:21.80,0:18:23.47,Default,,0,0,0,,Жоғал!
Dialogue: 0,0:18:23.97,0:18:27.27,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:18:36.86,0:18:39.11,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:18:39.20,0:18:42.41,Default,,0,0,0,,Менің атым Мири Кайзака, мен 4 жастамын.
Dialogue: 0,0:18:42.49,0:18:44.08,Default,,0,0,0,,Сіз қайдансыз?
Dialogue: 0,0:18:44.16,0:18:46.66,Default,,0,0,0,,Мм, ана жерде!
Dialogue: 0,0:18:46.75,0:18:49.29,Default,,0,0,0,,Маған мекен-жайыңызды айта аласыз ба? Мен түсінбеймін
Dialogue: 0,0:18:49.37,0:18:50.42,Default,,0,0,0,,Осы суретте олар мінсіз жұп сияқты көрінеді, иә?
Dialogue: 0,0:18:50.50,0:18:52.42,Default,,0,0,0,,Мири мен үйге бара аламын
Dialogue: 0,0:18:52.50,0:18:55.67,Default,,0,0,0,,Мен сені қорғауым керек пе, әлде полиция қорабына апаруым керек пе?
Dialogue: 0,0:18:56.96,0:18:58.17,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:18:58.26,0:18:59.68,Default,,0,0,0,,Әй, тыныш бол!
Dialogue: 0,0:18:59.76,0:19:02.64,Default,,0,0,0,,Мен оны жек көремін! Мен үйге барамын!
Dialogue: 0,0:19:02.72,0:19:04.10,Default,,0,0,0,,Ашуланба
Dialogue: 0,0:19:04.18,0:19:05.31,Default,,0,0,0,,Тез кел!
Dialogue: 0,0:19:05.39,0:19:07.22,Default,,0,0,0,,Маған көмектес, әке!
Dialogue: 0,0:19:09.06,0:19:12.60,Default,,0,0,0,,Көмектесіңіз! Папа!
Dialogue: 0,0:19:19.90,0:19:24.41,Default,,0,0,0,,Қиналғанда қол ұшын беретін әкем!
Dialogue: 0,0:19:29.16,0:19:32.83,Default,,0,0,0,,Жоқ, мені жібер! (Полиция қызметкері А) Тыныш отырыңыз!
Dialogue: 0,0:19:34.04,0:19:35.13,Default,,0,0,0,,Не? Сіз
Dialogue: 0,0:19:35.21,0:19:38.05,Default,,0,0,0,,Баланы жіберіңіз. (Полиция қызметкері А) Иә?
Dialogue: 0,0:19:38.13,0:19:41.22,Default,,0,0,0,,Мен де ертең ойнауға уәде беремін.
Dialogue: 0,0:19:41.30,0:19:43.59,Default,,0,0,0,,Сіз бұл баланың қамқоршысысыз ба?
Dialogue: 0,0:19:44.09,0:19:45.05,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:45.55,0:19:47.47,Default,,0,0,0,,Сіз танысыңыздың баласысыз ба?
Dialogue: 0,0:19:47.97,0:19:49.10,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:51.39,0:19:52.31,Default,,0,0,0,,Мен...
Dialogue: 0,0:19:53.73,0:19:55.23,Default,,0,0,0,,Бұл оның әкесі.
Dialogue: 0,0:19:55.31,0:19:56.65,Default,,0,0,0,,Ах
Dialogue: 0,0:19:57.65,0:19:59.69,Default,,0,0,0,,Мири үйге қайтайық
Dialogue: 0,0:20:03.53,0:20:05.91,Default,,0,0,0,,Иә! Нөл әке!
Dialogue: 0,0:20:10.79,0:20:12.29,Default,,0,0,0,,Мири үйге қайтайық
Dialogue: 0,0:20:12.37,0:20:13.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:22.59,0:20:24.51,Default,,0,0,0,,Екі Папа~!
Dialogue: 0,0:20:25.01,0:20:26.68,Default,,0,0,0,,(ДжоДжо) Мен ең жоғарғысынан ең төменгісіне дейін әрбір картаны атай аламын
Dialogue: 0,0:20:29.93,0:20:31.18,Default,,0,0,0,,Қандай да бір себепті,
Dialogue: 0,0:20:31.27,0:20:32.56,Default,,0,0,0,,Оу (нөл) Шаршадым.
Dialogue: 0,0:20:33.14,0:20:34.73,Default,,0,0,0,,Мен Зеро Папамен ойнадым!
Dialogue: 0,0:20:38.40,0:20:40.57,Default,,0,0,0,,«Нөл әке»
Dialogue: 0,0:20:41.32,0:20:43.53,Default,,0,0,0,,Нөл Папа~?
Dialogue: 0,0:20:43.61,0:20:45.99,Default,,0,0,0,,Сен де күліп жібердің ғой, солай ма?
Dialogue: 0,0:20:46.07,0:20:47.45,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:20:49.66,0:20:51.70,Default,,0,0,0,,Енді не істейміз?
Dialogue: 0,0:20:52.37,0:20:55.04,Default,,0,0,0,,Ммм, дұрыс...
Dialogue: 0,0:20:57.29,0:20:59.34,Default,,0,0,0,,Кешкі ас сатып алып, үйге баруым керек пе?
Dialogue: 0,0:20:59.92,0:21:01.34,Default,,0,0,0,,3 адамға?
Dialogue: 0,0:21:01.42,0:21:02.84,Default,,0,0,0,,3 адамға
Dialogue: 0,0:21:03.38,0:21:04.55,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:21:12.22,0:21:14.06,Default,,0,0,0,,Бет Не болды? ол
Dialogue: 0,0:21:15.23,0:21:17.81,Default,,0,0,0,,Әйелдермен жолым жоқ.
Dialogue: 0,0:21:18.31,0:21:19.56,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:21:23.19,0:21:24.61,Default,,0,0,0,,Бұл анамның гамбургері!
Dialogue: 0,0:21:24.70,0:21:26.91,Default,,0,0,0,,А, көп же!
Dialogue: 0,0:21:26.99,0:21:28.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:29.57,0:21:30.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:30.70,0:21:33.04,Default,,0,0,0,,♪～
Dialogue: 0,0:21:33.12,0:21:36.42,Default,,0,0,0,,Екі Пападан да дәмді!
Dialogue: 0,0:21:36.92,0:21:38.38,Default,,0,0,0,,Иә, бара аламын.
Dialogue: 0,0:21:38.96,0:21:40.46,Default,,0,0,0,,Бұл жігіттер...
Dialogue: 0,0:21:43.55,0:21:46.01,Default,,0,0,0,,Әй, қой, маңызды емес.
Dialogue: 0,0:23:15.93,0:23:17.93,Default,,0,0,0,,～♪
Dialogue: 0,0:23:20.10,0:23:22.77,Default,,0,0,0,,Мм... пуах
Dialogue: 0,0:23:24.65,0:23:26.65,Default,,0,0,0,,Енді бүгін ұйықтайық.
Dialogue: 0,0:23:27.32,0:23:28.69,Default,,0,0,0,,Ммм (Икки) О...
Dialogue: 0,0:23:28.78,0:23:31.07,Default,,0,0,0,,Әке, менімен жат! (Икки) Иә?
Dialogue: 0,0:23:31.57,0:23:34.16,Default,,0,0,0,,Нөл Папа және барлығы! Ал (нөл) ше?
Dialogue: 0,0:23:34.24,0:23:36.45,Default,,0,0,0,,Жоқ, мен өзімді тыныш сезінбеймін.
Dialogue: 0,0:23:36.54,0:23:37.91,Default,,0,0,0,,Мені жіберіңізші, эй
Dialogue: 0,0:23:37.99,0:23:40.83,Default,,0,0,0,,Хмм, жоқ! Жоқ, жоқ!
Dialogue: 0,0:23:40.91,0:23:43.38,Default,,0,0,0,,Бәріміз бірге ұйықтаймыз!
Dialogue: 0,0:23:44.50,0:23:46.13,Default,,0,0,0,,Е...
Dialogue: 0,0:23:48.34,0:23:49.38,Default,,0,0,0,,Ммм (Икки) Атта!
Dialogue: 0,0:23:51.63,0:23:54.55,Default,,0,0,0,,Гиоза супер…
Dialogue: 0,0:23:54.64,0:23:57.64,Default,,0,0,0,,Сәлем Нөл! Оны аздап толтырыңыз.
Dialogue: 0,0:23:57.72,0:23:59.02,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:23:59.52,0:24:00.89,Default,,0,0,0,,Не, ұйықтадың ба?
Dialogue: 0,0:24:02.39,0:24:08.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory