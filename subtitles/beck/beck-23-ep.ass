Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.37,0:00:07.00,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.67,0:01:36.97,Default,,0,0,0,,～♪
Dialogue: 0,0:01:37.38,0:01:38.55,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:01:38.55,0:01:42.68,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:01:38.55,0:01:42.68,Default,,0,0,0,,(топ өнімділігі)
Dialogue: 0,0:01:42.68,0:01:44.56,Default,,0,0,0,,(топ өнімділігі)
Dialogue: 0,0:01:50.94,0:01:52.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:17.22,0:02:19.97,Default,,0,0,0,,Өте шулы...
Dialogue: 0,0:02:17.22,0:02:19.97,Default,,0,0,0,,(топ өнімділігі)
Dialogue: 0,0:02:20.09,0:02:21.93,Default,,0,0,0,,Ах! Ол қазірдің өзінде басталды
Dialogue: 0,0:02:22.05,0:02:23.14,Default,,0,0,0,,Бұл не өзі?
Dialogue: 0,0:02:23.26,0:02:25.35,Default,,0,0,0,,Хмм... Уау! О, жоқ!
Dialogue: 0,0:02:25.47,0:02:28.10,Default,,0,0,0,,Мен енді Гон айдаһарына міне алмаймын.
Dialogue: 0,0:02:28.39,0:02:32.61,Default,,0,0,0,,Хмм... топтағы адамдардың суретті-сюжеттік шоулары әлі де бар.
Dialogue: 0,0:02:44.58,0:02:46.49,Default,,0,0,0,,Әй, сен бала емессің бе?
Dialogue: 0,0:02:46.62,0:02:47.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:47.75,0:02:48.71,Default,,0,0,0,,Рикия-кун!
Dialogue: 0,0:02:48.83,0:02:51.96,Default,,0,0,0,,Мен сенен бұл сахнада тұрады деп күткен жоқпын.
Dialogue: 0,0:02:52.46,0:02:55.25,Default,,0,0,0,,Мен де Рикияны кездестіретініме сене алар емеспін...
Dialogue: 0,0:02:55.38,0:02:58.59,Default,,0,0,0,,Әй... Ерлігіңе жақсылап қараймын.
Dialogue: 0,0:02:58.72,0:03:00.13,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:03:00.59,0:03:01.72,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:02.26,0:03:04.97,Default,,0,0,0,,Хм... Рюсукеге де сәлемімді айтыңызшы.
Dialogue: 0,0:03:05.39,0:03:06.60,Default,,0,0,0,,Чиба ше?
Dialogue: 0,0:03:06.68,0:03:08.52,Default,,0,0,0,,Уф... Хмф!
Dialogue: 0,0:03:10.06,0:03:11.81,Default,,0,0,0,,Қазіргісі нашар.
Dialogue: 0,0:03:11.94,0:03:12.94,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:16.19,0:03:18.07,Default,,0,0,0,,Әй, солай болды!
Dialogue: 0,0:03:18.15,0:03:19.94,Default,,0,0,0,,Сәлем Коюки!
Dialogue: 0,0:03:20.07,0:03:22.24,Default,,0,0,0,,Махо! Мұнда қашан келдің?
Dialogue: 0,0:03:22.36,0:03:23.62,Default,,0,0,0,,Біраз уақыт бұрын
Dialogue: 0,0:03:23.74,0:03:25.24,Default,,0,0,0,,Өтетін орны кең.
Dialogue: 0,0:03:25.37,0:03:26.24,Default,,0,0,0,,Біраз.
Dialogue: 0,0:03:26.83,0:03:28.58,Default,,0,0,0,,Біз кетеміз -
Dialogue: 0,0:03:28.70,0:03:30.91,Default,,0,0,0,,Бұл ең терең кезең.
Dialogue: 0,0:03:31.04,0:03:33.63,Default,,0,0,0,,Үш үлкен кезең бар, солай ма?
Dialogue: 0,0:03:33.75,0:03:35.54,Default,,0,0,0,,Кішігірім кезеңдері де бар сияқты.
Dialogue: 0,0:03:35.67,0:03:36.50,Default,,0,0,0,,Иә
Dialogue: 0,0:03:36.84,0:03:38.34,Default,,0,0,0,,〈Бір уақытта бірнеше кезең〉
Dialogue: 0,0:03:38.46,0:03:39.71,Default,,0,0,0,,<Кел, ойнайық~>
Dialogue: 0,0:03:39.84,0:03:42.22,Default,,0,0,0,,<Иә? Қызық, дыбыстар араласпай ма? 〉
Dialogue: 0,0:03:42.34,0:03:45.47,Default,,0,0,0,,〈Маған 15:00-ден бастап Husking Bee көрген ұнады〉
Dialogue: 0,0:03:45.60,0:03:47.43,Default,,0,0,0,,〈Себебі сахна өте алыс〉
Dialogue: 0,0:03:47.56,0:03:49.02,Default,,0,0,0,,<Дыбыстар аралас болуы мүмкін.>
Dialogue: 0,0:03:49.14,0:03:50.68,Default,,0,0,0,,<Ағаш өсіп келе жатқандықтан>
Dialogue: 0,0:03:50.81,0:03:53.35,Default,,0,0,0,,〈Уау! Oil Octopus пайда болады
Dialogue: 0,0:03:53.48,0:03:54.90,Default,,0,0,0,,Біздің кезегіміз 18:30 үшінші кезеңде болады.
Dialogue: 0,0:03:54.90,0:03:56.61,Default,,0,0,0,,Біздің кезегіміз 18:30 үшінші кезеңде болады.
Dialogue: 0,0:03:54.90,0:03:56.61,Default,,0,0,0,,〈Уа, Apple да келеді〉
Dialogue: 0,0:03:56.61,0:03:57.98,Default,,0,0,0,,〈Уау, Apple да келеді〉
Dialogue: 0,0:03:58.36,0:04:01.74,Default,,0,0,0,,Сәлем! БЕК пен Йошитоның уақыты Кабуруян
Dialogue: 0,0:04:01.82,0:04:02.82,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:04:02.95,0:04:05.32,Default,,0,0,0,,〈Екі кезең бір-бірінен өте алыс.〉
Dialogue: 0,0:04:05.45,0:04:07.53,Default,,0,0,0,,<Мен тек бір жағын ғана көре аламын>
Dialogue: 0,0:04:07.66,0:04:09.70,Default,,0,0,0,,〈Біз басты сахнада боламыз ба?〉
Dialogue: 0,0:04:09.83,0:04:11.33,Default,,0,0,0,,<Сыныптас>
Dialogue: 0,0:04:11.45,0:04:13.08,Default,,0,0,0,,〈Мен екінші сатыдағы Малкольммын...〉
Dialogue: 0,0:04:13.21,0:04:14.46,Default,,0,0,0,,〈Мен оны шынымен көргім келеді〉
Dialogue: 0,0:04:14.58,0:04:15.79,Default,,0,0,0,,Білесің бе, Рюсуке-кун...
Dialogue: 0,0:04:15.92,0:04:16.75,Default,,0,0,0,,Рюсуке?
Dialogue: 0,0:04:17.92,0:04:19.13,Default,,0,0,0,,Хаха...
Dialogue: 0,0:04:19.92,0:04:21.84,Default,,0,0,0,,Мен ол туралы естігім келмейді.
Dialogue: 0,0:04:21.97,0:04:23.38,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,0:04:23.51,0:04:27.47,Default,,0,0,0,,Ол бір аптадан бері қышиды.
Dialogue: 0,0:04:27.60,0:04:30.72,Default,,0,0,0,,Мен сені кеше телефонмен ұрысып қалғаннан бері көрмедім.
Dialogue: 0,0:04:31.35,0:04:32.43,Default,,0,0,0,,Қайсысы Махо...
Dialogue: 0,0:04:32.56,0:04:33.77,Default,,0,0,0,,Коюки!
Dialogue: 0,0:04:33.85,0:04:34.73,Default,,0,0,0,,Е...
Dialogue: 0,0:04:34.81,0:04:36.02,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:04:36.15,0:04:37.48,Default,,0,0,0,,Иә... Ах! Шын мәнінде біз...
Dialogue: 0,0:04:37.48,0:04:38.52,Default,,0,0,0,,Иә... Ах! Шын мәнінде біз...
Dialogue: 0,0:04:37.48,0:04:38.52,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:04:38.52,0:04:39.86,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:04:39.98,0:04:41.03,Default,,0,0,0,,<Мошимоши>
Dialogue: 0,0:04:41.15,0:04:43.07,Default,,0,0,0,,О, Йошито
Dialogue: 0,0:04:44.11,0:04:46.95,Default,,0,0,0,,<Эй, сен люкс бөлмесінде тұрасың ба? 〉
Dialogue: 0,0:04:47.07,0:04:48.99,Default,,0,0,0,,〈Иә, кеттік! 〉
Dialogue: 0,0:04:49.12,0:04:51.29,Default,,0,0,0,,Көріскенше, Коюки-кун!
Dialogue: 0,0:04:51.41,0:04:52.54,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:04:52.83,0:04:55.83,Default,,0,0,0,,Махо-чан, қай кезеңді тамашалайсың?
Dialogue: 0,0:04:56.17,0:04:57.08,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:57.33,0:04:59.71,Default,,0,0,0,,О, суық!
Dialogue: 0,0:04:59.79,0:05:02.34,Default,,0,0,0,,Ей, жүрегім тоқтап қалады! Шынайы
Dialogue: 0,0:05:02.46,0:05:03.88,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:05:07.72,0:05:10.97,Default,,0,0,0,,Олар сол жақтағы тұтынушылардың санын санап жатыр.
Dialogue: 0,0:05:11.31,0:05:13.22,Default,,0,0,0,,Қалай ойласаң да, мүмкін емес.
Dialogue: 0,0:05:13.35,0:05:15.35,Default,,0,0,0,,Біз Эйджи тобынан немесе Малколмнан жақсымыз.
Dialogue: 0,0:05:15.48,0:05:17.02,Default,,0,0,0,,Тұтынушыларды тарту
Dialogue: 0,0:05:17.15,0:05:19.65,Default,,0,0,0,,Ал, масштабы да әртүрлі.
Dialogue: 0,0:05:20.36,0:05:23.23,Default,,0,0,0,,Оның үстіне, Леонмен берген уәдесі - бұл әбігер!
Dialogue: 0,0:05:23.32,0:05:24.86,Default,,0,0,0,,Егер мен бұл ставканы жоғалтсам —
Dialogue: 0,0:05:24.99,0:05:28.32,Default,,0,0,0,,Бізге таралу ғана қалды.
Dialogue: 0,0:05:28.45,0:05:31.24,Default,,0,0,0,,Сізде жақсы идеялар бар ма?
Dialogue: 0,0:05:32.33,0:05:35.12,Default,,0,0,0,,Мен әлі де мүмкіндікке сенемін
Dialogue: 0,0:05:35.41,0:05:39.08,Default,,0,0,0,,Не? Сіздің потенциалыңыздың негізі неде?
Dialogue: 0,0:05:39.21,0:05:40.88,Default,,0,0,0,,Бұл Коюкидің әні ме?
Dialogue: 0,0:05:41.71,0:05:42.55,Default,,0,0,0,,Бұл арман
Dialogue: 0,0:05:42.67,0:05:44.55,Default,,0,0,0,,Не, арман? (Чиба) Түсіңіз!
Dialogue: 0,0:05:45.38,0:05:47.18,Default,,0,0,0,,Бұл бәріміз бірге көрген арман еді.
Dialogue: 0,0:05:48.38,0:05:49.72,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:50.22,0:05:51.51,Default,,0,0,0,,Сөзсіз аян.
Dialogue: 0,0:05:54.22,0:05:55.64,Default,,0,0,0,,Бұл арман ма?
Dialogue: 0,0:05:55.77,0:05:58.85,Default,,0,0,0,,Ақымақ! Мен мұндай түс көрмеймін!
Dialogue: 0,0:05:58.98,0:06:00.52,Default,,0,0,0,,Чиба!
Dialogue: 0,0:06:00.65,0:06:02.11,Default,,0,0,0,,Чиба... (Чиба) Әй?
Dialogue: 0,0:06:06.94,0:06:08.45,Default,,0,0,0,,Мүмкін—
Dialogue: 0,0:06:08.70,0:06:11.82,Default,,0,0,0,,Мүмкін сіз топта болуға лайықты адам емес шығарсыз.
Dialogue: 0,0:06:13.49,0:06:14.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:16.54,0:06:18.75,Default,,0,0,0,,Ей! (Рюсуке) Уф!
Dialogue: 0,0:06:19.75,0:06:23.13,Default,,0,0,0,,Сіз ол жерде болмауыңыз керек пе? Сіз не айттыңыз?
Dialogue: 0,0:06:24.92,0:06:27.88,Default,,0,0,0,,БЕКке керек емес адам жоқ.
Dialogue: 0,0:06:29.34,0:06:30.18,Default,,0,0,0,,Рюсуке
Dialogue: 0,0:06:30.51,0:06:33.14,Default,,0,0,0,,Көргеніміз жай ғана түс еді
Dialogue: 0,0:06:33.26,0:06:34.35,Default,,0,0,0,,Бұл орын:
Dialogue: 0,0:06:34.47,0:06:37.48,Default,,0,0,0,,Клиенттердің мінез-құлқы нашар, қоқыс көп екені рас...
Dialogue: 0,0:06:39.85,0:06:41.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:41.35,0:06:42.94,Default,,0,0,0,,Жарайды, Тайра-күн.
Dialogue: 0,0:06:43.06,0:06:45.36,Default,,0,0,0,,БЕК-ті жасаған жігіт осылай деді.
Dialogue: 0,0:06:46.40,0:06:47.86,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:06:47.99,0:06:49.53,Default,,0,0,0,,Чиба? Эй Чиба!
Dialogue: 0,0:06:49.65,0:06:51.24,Default,,0,0,0,,Тики шоу! (Тайра) Күте тұрыңыз!
Dialogue: 0,0:06:52.53,0:06:54.53,Default,,0,0,0,,Ол армандамайтын жалғыз адам екенін біледі
Dialogue: 0,0:06:54.66,0:06:56.54,Default,,0,0,0,,Мен қатты уайымдадым.
Dialogue: 0,0:06:57.08,0:06:59.16,Default,,0,0,0,,...
Dialogue: 0,0:06:59.29,0:07:01.04,Default,,0,0,0,,Олар дебют алдында мүшелерді жұмыстан шығарды.
Dialogue: 0,0:07:02.08,0:07:03.63,Default,,0,0,0,,Чибалық жігіт кез келген мүшеден жақсы...
Dialogue: 0,0:07:03.75,0:07:05.50,Default,,0,0,0,,Тек достар тобы...
Dialogue: 0,0:07:05.63,0:07:07.63,Default,,0,0,0,,Сіз үлкен топта бола алмайсыз!
Dialogue: 0,0:07:11.93,0:07:13.89,Default,,0,0,0,,Сіз бұған шындап қарайсыз ба?
Dialogue: 0,0:07:15.97,0:07:20.14,Default,,0,0,0,,Чиба кетсе, мен де БЕКтен шығамын.
Dialogue: 0,0:07:22.77,0:07:25.15,Default,,0,0,0,,Мария - белсенді бала.
Dialogue: 0,0:07:25.27,0:07:26.40,Default,,0,0,0,,Сол жігіт!
Dialogue: 0,0:07:26.61,0:07:28.78,Default,,0,0,0,,Ол маған Коюкимен абай болу керектігін айтты.
Dialogue: 0,0:07:28.90,0:07:29.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:29.90,0:07:32.41,Default,,0,0,0,,Мария - өлімші әйел
Dialogue: 0,0:07:39.00,0:07:40.41,Default,,0,0,0,,Иә? Чиба-кун...
Dialogue: 0,0:07:40.54,0:07:41.66,Default,,0,0,0,,Жоқ па?
Dialogue: 0,0:07:41.79,0:07:44.75,Default,,0,0,0,,Менің ұялы телефоным өшірулі, сондықтан қосыла алмаймын.
Dialogue: 0,0:07:45.13,0:07:46.92,Default,,0,0,0,,Жанды орындаулар туралы не айтасыз?
Dialogue: 0,0:07:47.17,0:07:49.46,Default,,0,0,0,,Әйтеуір бөлініп, ізденейік.
Dialogue: 0,0:07:49.55,0:07:52.22,Default,,0,0,0,,Қазір сағат 15.00, демек 3 сағат қалды.
Dialogue: 0,0:07:52.34,0:07:54.22,Default,,0,0,0,,Мен лагерьді тексеремін.
Dialogue: 0,0:07:54.34,0:07:56.18,Default,,0,0,0,,Содан кейін мен сахнаны іздеймін.
Dialogue: 0,0:07:56.30,0:07:58.51,Default,,0,0,0,,Мен қақпаға қараймын.
Dialogue: 0,0:08:15.62,0:08:18.03,Default,,0,0,0,,Рахмет дыбысының әпкесінің мұрасы қандай?
Dialogue: 0,0:08:18.16,0:08:19.41,Default,,0,0,0,,Мен өлім аузындамын.
Dialogue: 0,0:08:19.54,0:08:21.45,Default,,0,0,0,,Миха өсті
Dialogue: 0,0:08:21.58,0:08:23.46,Default,,0,0,0,,Мен әдетте көре алмайтын нәрселерді көремін.
Dialogue: 0,0:08:23.58,0:08:25.96,Default,,0,0,0,,Маған бұл өзінше қызықты.
Dialogue: 0,0:08:26.46,0:08:28.00,Default,,0,0,0,,Мен сіздің шалбарыңызды жаңа ғана көрдім.
Dialogue: 0,0:08:28.13,0:08:29.13,Default,,0,0,0,,Не? Шынайы ма?
Dialogue: 0,0:08:29.21,0:08:31.13,Default,,0,0,0,,(Ер қонақтардың күлкісі)
Dialogue: 0,0:08:31.21,0:08:33.84,Default,,0,0,0,,Қазірдің өзінде!
Dialogue: 0,0:08:34.68,0:08:37.01,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:08:40.47,0:08:41.97,Default,,0,0,0,,Чиба-кун!
Dialogue: 0,0:08:43.68,0:08:45.31,Default,,0,0,0,,Чибаның жүгі...
Dialogue: 0,0:08:45.39,0:08:46.73,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:08:48.06,0:08:49.40,Default,,0,0,0,,Сәлеметсіз бе! Коюки
Dialogue: 0,0:08:49.52,0:08:51.57,Default,,0,0,0,,Иә? Мария
Dialogue: 0,0:08:51.69,0:08:54.65,Default,,0,0,0,,〈Концерт алдында мен қатты толқып тұрмын.〉
Dialogue: 0,0:08:54.78,0:08:57.41,Default,,0,0,0,,<Менің мұны істегім келетіні рас па? 〉
Dialogue: 0,0:08:58.16,0:09:00.41,Default,,0,0,0,,Менің қазір сөйлесуге уақытым жоқ...
Dialogue: 0,0:09:00.54,0:09:02.29,Default,,0,0,0,,Кез келген анықтамалар... Хмм!
Dialogue: 0,0:09:02.58,0:09:04.25,Default,,0,0,0,,Хехе…
Dialogue: 0,0:09:04.37,0:09:05.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:06.79,0:09:07.92,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:09:08.04,0:09:09.54,Default,,0,0,0,,Иә? Коюки
Dialogue: 0,0:09:09.84,0:09:11.50,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:11.71,0:09:12.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:12.63,0:09:15.05,Default,,0,0,0,,Хмм... Эххехе
Dialogue: 0,0:09:15.38,0:09:17.76,Default,,0,0,0,,Жоқ... бұл дұрыс емес, Махо!
Dialogue: 0,0:09:18.22,0:09:23.89,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:09:31.32,0:09:32.61,Default,,0,0,0,,Чиба-кун…
Dialogue: 0,0:09:40.49,0:09:42.41,Default,,0,0,0,,Ха ха ха... Уау!
Dialogue: 0,0:09:44.95,0:09:48.62,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:09:49.21,0:09:50.59,Default,,0,0,0,,Чиба-кун…
Dialogue: 0,0:09:51.34,0:09:54.51,Default,,0,0,0,,Қайдасың? Чиба-кун!
Dialogue: 0,0:09:55.38,0:09:58.38,Default,,0,0,0,,Моңғол шоп отрядының Цунеми Чиба
Dialogue: 0,0:09:58.51,0:10:01.14,Default,,0,0,0,,Үшінші кезеңде сені досың күтіп тұр.
Dialogue: 0,0:10:01.26,0:10:02.10,Default,,0,0,0,,Қайталаңыз
Dialogue: 0,0:10:02.72,0:10:06.14,Default,,0,0,0,,Моңғол шоп отрядының Цунеми Чиба
Dialogue: 0,0:10:06.27,0:10:07.94,Default,,0,0,0,,Сіздің досыңыз үшінші кезеңде...
Dialogue: 0,0:10:08.06,0:10:08.89,Default,,0,0,0,,Мүмкін—
Dialogue: 0,0:10:09.02,0:10:11.98,Default,,0,0,0,,Мүмкін сіз топта болуға лайықты адам емес шығарсыз.
Dialogue: 0,0:10:17.78,0:10:18.70,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:19.86,0:10:20.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:21.91,0:10:23.45,Default,,0,0,0,,Кешіріңіз, Тайра-кун.
Dialogue: 0,0:10:23.58,0:10:26.12,Default,,0,0,0,,Сонда кездескенше! Коюки Саку
Dialogue: 0,0:10:27.46,0:10:32.34,Default,,0,0,0,,(69-буын орындау)
Dialogue: 0,0:10:44.26,0:10:45.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:46.72,0:10:47.56,Default,,0,0,0,,Чиба-кун!
Dialogue: 0,0:10:47.68,0:10:49.27,Default,,0,0,0,,Ах! Кешіріңіз
Dialogue: 0,0:10:49.39,0:10:51.06,Default,,0,0,0,,Мен өте қателік жасадым.
Dialogue: 0,0:10:51.35,0:10:53.40,Default,,0,0,0,,Эхехе... Эххехе
Dialogue: 0,0:10:55.27,0:10:57.57,Default,,0,0,0,,Мен тікелей үйге баруды жоспарлап едім, бірақ...
Dialogue: 0,0:10:57.69,0:11:00.70,Default,,0,0,0,,Мен оны естіп тұрмын, сондықтан олай етпеңіз.
Dialogue: 0,0:11:08.50,0:11:10.83,Default,,0,0,0,,69-буын
Dialogue: 0,0:11:10.96,0:11:14.54,Default,,0,0,0,,Егер мен бұл топты көрмесем, мен қазіргідей адам болар едім...
Dialogue: 0,0:11:24.97,0:11:27.47,Default,,0,0,0,,Аздап салқын емес пе?
Dialogue: 0,0:11:28.60,0:11:31.56,Default,,0,0,0,,Солай ма? Мен мочи шошқа етін жемеймін
Dialogue: 0,0:11:31.77,0:11:34.61,Default,,0,0,0,,БЕКтің жанды орындауы Жарайды ма?
Dialogue: 0,0:11:43.28,0:11:49.29,Default,,0,0,0,,(Жюльдің ағылшынша ән айту дауысы)
Dialogue: 0,0:11:58.55,0:12:00.51,Default,,0,0,0,,Ол керемет
Dialogue: 0,0:12:00.63,0:12:02.47,Default,,0,0,0,,Мен жанкүйер болдым.
Dialogue: 0,0:12:02.59,0:12:04.51,Default,,0,0,0,,Иә, ол шынайы.
Dialogue: 0,0:12:05.39,0:12:08.64,Default,,0,0,0,,Бірақ жұмылдыру негізгі кезеңде де, екінші кезеңде де болды —
Dialogue: 0,0:12:08.76,0:12:10.14,Default,,0,0,0,,Мүлде мүмкін емес.
Dialogue: 0,0:12:10.27,0:12:12.10,Default,,0,0,0,,А? Бұл мүлдем мүмкін емес
Dialogue: 0,0:12:12.23,0:12:15.44,Default,,0,0,0,,Екінші кезеңді былай қойғанда, ол негізгі кезеңнен жақсырақ.
Dialogue: 0,0:12:15.56,0:12:17.11,Default,,0,0,0,,Бұл керемет сияқты...
Dialogue: 0,0:12:19.15,0:12:20.69,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:12:21.82,0:12:22.86,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:22.99,0:12:24.11,Default,,0,0,0,,Берейік
Dialogue: 0,0:12:24.24,0:12:25.07,Default,,0,0,0,,Не?
Dialogue: 0,0:12:25.16,0:12:27.83,Default,,0,0,0,,Эйджидің негізгі сахнадағы тобы рок-сод.
Dialogue: 0,0:12:27.95,0:12:29.91,Default,,0,0,0,,Екінші кезең Малколм да
Dialogue: 0,0:12:30.04,0:12:32.58,Default,,0,0,0,,АҚШ-тағы сатылымдар 20 миллион данадан асады
Dialogue: 0,0:12:32.87,0:12:35.42,Default,,0,0,0,,Үшінші кезеңде жеңіске жетуге мүмкіндік беретін факторлар қандай?
Dialogue: 0,0:12:35.54,0:12:36.42,Default,,0,0,0,,Қолыңды тигізбе…
Dialogue: 0,0:12:37.92,0:12:39.71,Default,,0,0,0,,Ал егер Чибадан келген жігіт болмаса...
Dialogue: 0,0:12:39.84,0:12:41.63,Default,,0,0,0,,Жанды орындау басталмайды.
Dialogue: 0,0:12:41.92,0:12:43.38,Default,,0,0,0,,Я...
Dialogue: 0,0:12:45.01,0:12:46.80,Default,,0,0,0,,Бір сағат қалды.
Dialogue: 0,0:12:47.30,0:12:49.72,Default,,0,0,0,,Дәл қазір біз Чибаны іздеп жатырмыз.
Dialogue: 0,0:12:50.35,0:12:52.60,Default,,0,0,0,,〈Оны қонақүйден көруге болады.〉
Dialogue: 0,0:12:53.27,0:12:55.98,Default,,0,0,0,,〈Сен қойылым алдында не үшін келдің? 〉
Dialogue: 0,0:12:57.40,0:12:58.44,Default,,0,0,0,,Сәлем, Рюсуке...
Dialogue: 0,0:12:58.56,0:13:00.02,Default,,0,0,0,,Тыңдап тұрсың ба? Эй...
Dialogue: 0,0:13:00.02,0:13:00.82,Default,,0,0,0,,Тыңдап тұрсың ба? Эй...
Dialogue: 0,0:13:00.02,0:13:00.82,Default,,0,0,0,,(Қоңырауды аяқтау дыбысы)
Dialogue: 0,0:13:00.82,0:13:01.28,Default,,0,0,0,,(Қоңырауды аяқтау дыбысы)
Dialogue: 0,0:13:01.69,0:13:04.32,Default,,0,0,0,,<Жеңілу шарттары есіңізде ме? 〉
Dialogue: 0,0:13:04.45,0:13:05.28,Default,,0,0,0,,〈Аа〉
Dialogue: 0,0:13:05.40,0:13:07.99,Default,,0,0,0,,〈Менде дәл қазір бұл туралы мүшелермен қиналып жатырмын.〉
Dialogue: 0,0:13:08.12,0:13:09.16,Default,,0,0,0,,Хмф!
Dialogue: 0,0:13:12.91,0:13:14.46,Default,,0,0,0,,<Қашып кетейін бе? 〉
Dialogue: 0,0:13:15.83,0:13:16.87,Default,,0,0,0,,(капюшонда отыру дыбысы)
Dialogue: 0,0:13:16.96,0:13:17.92,Default,,0,0,0,,<Осындай болсам да—>
Dialogue: 0,0:13:18.04,0:13:19.50,Default,,0,0,0,,〈Олар өте табанды болды.〉
Dialogue: 0,0:13:19.63,0:13:20.96,Default,,0,0,0,,<Сақ болыңыз>
Dialogue: 0,0:13:21.42,0:13:23.05,Default,,0,0,0,,〈Ол сені шынымен ұнатпайтын сияқты.〉
Dialogue: 0,0:13:29.01,0:13:29.85,Default,,0,0,0,,<Менімен жүр>
Dialogue: 0,0:13:29.97,0:13:31.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:32.01,0:13:33.39,Default,,0,0,0,,〈Мен саған бір нәрсе бергім келеді〉
Dialogue: 0,0:13:33.85,0:13:35.73,Default,,0,0,0,,<Кеттік>
Dialogue: 0,0:13:35.81,0:13:37.98,Default,,0,0,0,,(Голдидің күлкісі)
Dialogue: 0,0:13:41.07,0:13:43.53,Default,,0,0,0,,Жібер! Жіберу!
Dialogue: 0,0:13:43.82,0:13:46.28,Default,,0,0,0,,(Сәкудің ауыр тыныс алуы)
Dialogue: 0,0:13:47.45,0:13:48.28,Default,,0,0,0,,Я...
Dialogue: 0,0:13:49.32,0:13:51.33,Default,,0,0,0,,Хаха...
Dialogue: 0,0:13:51.45,0:13:52.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:58.08,0:14:00.00,Default,,0,0,0,,Ау, суық.
Dialogue: 0,0:14:00.71,0:14:05.80,Default,,0,0,0,,(Тайраның ауыр тыныс алуы)
Dialogue: 0,0:14:07.47,0:14:09.26,Default,,0,0,0,,Енді уақыт жоқ...
Dialogue: 0,0:14:17.98,0:14:19.40,Default,,0,0,0,,Сен ше, Чиба?
Dialogue: 0,0:14:25.53,0:14:26.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:28.74,0:14:31.07,Default,,0,0,0,,Мына жігіт кенет үнсіз қалды.
Dialogue: 0,0:14:31.20,0:14:32.07,Default,,0,0,0,,О
Dialogue: 0,0:14:32.20,0:14:34.58,Default,,0,0,0,,Малкольм мен Белл Арм басталғалы тұр.
Dialogue: 0,0:14:34.70,0:14:35.95,Default,,0,0,0,,Бүгінгі күннің ең бастысы.
Dialogue: 0,0:14:36.45,0:14:38.96,Default,,0,0,0,,Мені шеш, мен үйге барамын.
Dialogue: 0,0:14:39.08,0:14:40.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:40.75,0:14:44.50,Default,,0,0,0,,(Малколмның ағылшынша рэпі)
Dialogue: 0,0:14:57.85,0:15:02.40,Default,,0,0,0,,(Гакудың ән салған дауысы)
Dialogue: 0,0:15:26.59,0:15:29.26,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:15:29.59,0:15:33.09,Default,,0,0,0,,Барлығына! Бұл қауіпті, себебі жер лай.
Dialogue: 0,0:15:33.22,0:15:36.22,Default,,0,0,0,,Алдыңыздағы адамды қатты итермеңіз.
Dialogue: 0,0:15:36.76,0:15:39.31,Default,,0,0,0,,Олай болса, мен сені онымен таныстырып өтейін.
Dialogue: 0,0:15:39.43,0:15:41.44,Default,,0,0,0,,Мен де сол суды ішіп жатырмын.
Dialogue: 0,0:15:41.56,0:15:42.73,Default,,0,0,0,,Олай болса, кеттік!
Dialogue: 0,0:15:43.27,0:15:44.73,Default,,0,0,0,,Оның аты...
Dialogue: 0,0:15:44.86,0:15:47.86,Default,,0,0,0,,Морозуми Йошито!
Dialogue: 0,0:15:47.98,0:15:49.86,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:15:49.99,0:15:52.74,Default,,0,0,0,,Сәлем қыздар! Дайынсыз ба?
Dialogue: 0,0:15:52.86,0:15:54.32,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,0:15:54.66,0:15:58.74,Default,,0,0,0,,Жарайды! Кя!
Dialogue: 0,0:16:01.96,0:16:06.34,Default,,0,0,0,,(Ёшитоның ән айту дауысы)
Dialogue: 0,0:16:12.59,0:16:15.47,Default,,0,0,0,,Сәлем! Қауіпсіздік Сіз не істеп жатырсыз?
Dialogue: 0,0:16:15.76,0:16:19.01,Default,,0,0,0,,Бір кездері ноар концертінде біреу жарақат алып қалды!
Dialogue: 0,0:16:19.89,0:16:21.81,Default,,0,0,0,,<17 000 адам басты сахнада>
Dialogue: 0,0:16:21.93,0:16:24.60,Default,,0,0,0,,<Екінші кезең 12000 адам>
Dialogue: 0,0:16:24.85,0:16:27.27,Default,,0,0,0,,<үшінші кезеңде 500 адам>
Dialogue: 0,0:16:27.40,0:16:28.65,Default,,0,0,0,,<Есеп беру үшін рахмет>
Dialogue: 0,0:16:29.15,0:16:30.57,Default,,0,0,0,,<Есеп беруді жалғастырыңыз>
Dialogue: 0,0:16:30.65,0:16:31.49,Default,,0,0,0,,(Қоңырауды аяқтау дыбысы)
Dialogue: 0,0:16:30.65,0:16:31.49,Default,,0,0,0,,〈Бұл маған сәйкес келмейді.〉
Dialogue: 0,0:16:31.49,0:16:32.99,Default,,0,0,0,,〈Бұл тіпті сәйкестік емес.〉
Dialogue: 0,0:16:33.11,0:16:36.87,Default,,0,0,0,,〈Үшінші кезеңде жауған жаңбыр салдарынан жабдық істен шыққан сияқты〉
Dialogue: 0,0:16:36.99,0:16:40.66,Default,,0,0,0,,〈Тікелей орындау әлі басталмаған сияқты.〉
Dialogue: 0,0:16:42.29,0:16:45.12,Default,,0,0,0,,〈Олардың жолы болмады.〉
Dialogue: 0,0:16:45.87,0:16:48.67,Default,,0,0,0,,Не? Мен отставкаға кетемін...
Dialogue: 0,0:16:48.79,0:16:50.75,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:16:51.30,0:16:54.43,Default,,0,0,0,,Чиба мен Рюсуке болмаса, бұл тікелей шоу болмас еді.
Dialogue: 0,0:16:54.55,0:16:56.93,Default,,0,0,0,,Егер сіз оны кездейсоқ түрде ойнасаңыз да...
Dialogue: 0,0:16:57.05,0:17:00.47,Default,,0,0,0,,Мен кәдімгі қуатымның 10%-ын да ала аламын ба, білмеймін.
Dialogue: 0,0:17:00.60,0:17:02.56,Default,,0,0,0,,Бұл дұрыс болуы мүмкін, бірақ—
Dialogue: 0,0:17:02.68,0:17:06.73,Default,,0,0,0,,Жаңбырда күтіп тұрған 500 адамды не істейміз?
Dialogue: 0,0:17:06.81,0:17:08.90,Default,,0,0,0,,А... 500 адам?
Dialogue: 0,0:17:09.27,0:17:10.44,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:17:10.57,0:17:12.32,Default,,0,0,0,,Бұл соншалықты керемет емес.
Dialogue: 0,0:17:12.44,0:17:14.70,Default,,0,0,0,,Негізгі және екіншімен салыстырғанда
Dialogue: 0,0:17:14.82,0:17:16.74,Default,,0,0,0,,Менің ойымша, қалғандары басқалар.
Dialogue: 0,0:17:16.86,0:17:17.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:17.95,0:17:20.99,Default,,0,0,0,,Ран мен Леон қанша адам жиналғаны маңызды емес.
Dialogue: 0,0:17:22.12,0:17:23.00,Default,,0,0,0,,Балалар,
Dialogue: 0,0:17:23.12,0:17:25.66,Default,,0,0,0,,Ол таратылған Лоудтың (Тайра) алмастырғышы.
Dialogue: 0,0:17:27.08,0:17:30.29,Default,,0,0,0,,Мен ол жерде бірдеңені сезінемін.
Dialogue: 0,0:17:30.79,0:17:33.96,Default,,0,0,0,,Мен осы уақытқа дейін үш топты бастан өткердім.
Dialogue: 0,0:17:34.21,0:17:36.26,Default,,0,0,0,,Ал екі жолақ енді жоқ
Dialogue: 0,0:17:36.59,0:17:38.68,Default,,0,0,0,,БЕК бұрынғыдай химияға ие.
Dialogue: 0,0:17:38.80,0:17:40.64,Default,,0,0,0,,Менің ойымша, бұл ұшқын тудыруы мүмкін емес
Dialogue: 0,0:17:41.68,0:17:42.93,Default,,0,0,0,,Тайра мырза…
Dialogue: 0,0:17:43.27,0:17:46.39,Default,,0,0,0,,Сато мырза, жабдық жақында дайын болады.
Dialogue: 0,0:17:46.52,0:17:47.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:48.23,0:17:50.94,Default,,0,0,0,,Бізді көруге 500 адам...
Dialogue: 0,0:17:51.07,0:17:54.07,Default,,0,0,0,,Көпшіліктің көңілінен шыққандықтан көруге келген адамдар.
Dialogue: 0,0:17:54.19,0:17:56.03,Default,,0,0,0,,Мұндай адамдар сынайтын нәрсе —
Dialogue: 0,0:17:56.15,0:17:59.41,Default,,0,0,0,,Шынымды айтсам, қазіргі БЕК қатал болуы мүмкін.
Dialogue: 0,0:17:59.82,0:18:01.66,Default,,0,0,0,,Саку байқамай ма? иә?
Dialogue: 0,0:18:01.78,0:18:05.41,Default,,0,0,0,,Концертімізге үнемі келетіндер көп.
Dialogue: 0,0:18:05.83,0:18:08.71,Default,,0,0,0,,Жаңбырда осылай тауда терең болса да.
Dialogue: 0,0:18:15.05,0:18:16.76,Default,,0,0,0,,Коюки-кун Саку-чан!
Dialogue: 0,0:18:16.88,0:18:19.72,Default,,0,0,0,,Ах! Хироми-чан, сен жалғыз келдің бе?
Dialogue: 0,0:18:21.14,0:18:22.81,Default,,0,0,0,,Терең тыныс алыңыз.
Dialogue: 0,0:18:22.89,0:18:23.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:23.89,0:18:27.18,Default,,0,0,0,,Мен мұны жарыстар алдында жасаймын.
Dialogue: 0,0:18:27.64,0:18:28.81,Default,,0,0,0,,Я~
Dialogue: 0,0:18:29.31,0:18:30.73,Default,,0,0,0,,Екеуіңізге қатысты бірдеңе—
Dialogue: 0,0:18:30.85,0:18:34.90,Default,,0,0,0,,Мен сені бұрын-соңды көрмегеннен де қобалжыған сияқтысың.
Dialogue: 0,0:18:40.41,0:18:41.78,Default,,0,0,0,,Мен мұны қарызға аламын ба?
Dialogue: 0,0:18:41.87,0:18:42.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:46.95,0:18:49.37,Default,,0,0,0,,Бұл өте жақсы естіледі.
Dialogue: 0,0:18:49.50,0:18:52.13,Default,,0,0,0,,Бұл Джоульдің акустикалық гитарасы, солай ма?
Dialogue: 0,0:18:52.25,0:18:54.55,Default,,0,0,0,,Мен мұны қарызға аламын ба?
Dialogue: 0,0:18:55.00,0:18:58.80,Default,,0,0,0,,Осымен мен ұсақ-түйек боламын.
Dialogue: 0,0:18:59.13,0:19:00.30,Default,,0,0,0,,Коюки…
Dialogue: 0,0:19:01.80,0:19:04.72,Default,,0,0,0,,Жарайды, мен сенімен сөйлесемін.
Dialogue: 0,0:19:05.18,0:19:06.52,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:06.64,0:19:07.98,Default,,0,0,0,,Жабдық жарамсыз.
Dialogue: 0,0:19:08.10,0:19:10.10,Default,,0,0,0,,Кез келген уақытта бастаңыз
Dialogue: 0,0:19:10.98,0:19:12.44,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:19:12.90,0:19:13.86,Default,,0,0,0,,Иә
Dialogue: 0,0:19:16.32,0:19:17.86,Default,,0,0,0,,Сәлем Коюки!
Dialogue: 0,0:19:19.32,0:19:20.61,Default,,0,0,0,,Не болды? Пластырь жапсыруым керек болар.
Dialogue: 0,0:19:21.57,0:19:22.82,Default,,0,0,0,,Коюки…
Dialogue: 0,0:19:30.29,0:19:32.79,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:19:38.67,0:19:42.13,Default,,0,0,0,,Иә? Неліктен Коюки-кун жалғыз?
Dialogue: 0,0:19:42.93,0:19:45.68,Default,,0,0,0,,Әй, мынау кинодағы бала ғой, солай ма?
Dialogue: 0,0:19:46.14,0:19:48.10,Default,,0,0,0,,Бір ғана БЕК бар ма?
Dialogue: 0,0:19:55.69,0:19:57.11,Default,,0,0,0,,Коюки~!
Dialogue: 0,0:19:57.19,0:19:59.28,Default,,0,0,0,,Мықты болыңыз! а!
Dialogue: 0,0:20:01.57,0:20:02.74,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:09.45,0:20:11.71,Default,,0,0,0,,Барша адамның ішінде мен дәл осылай қысылып қалсам…
Dialogue: 0,0:20:24.80,0:20:30.81,Default,,0,0,0,,(Коюкидің ағылшынша ән айтатын дауысы)
Dialogue: 0,0:20:55.50,0:20:57.83,Default,,0,0,0,,U.A. Спорттық күні тез арада келіп жетті
Dialogue: 0,0:21:07.97,0:21:09.76,Default,,0,0,0,,「Менде бір сезім бар」…
Dialogue: 0,0:21:10.39,0:21:11.56,Default,,0,0,0,,The Beatles, солай ма?
Dialogue: 0,0:21:11.68,0:21:12.64,Default,,0,0,0,,Иә
Dialogue: 0,0:21:52.06,0:21:53.89,Default,,0,0,0,,Эй, менде бір сезім бар...
Dialogue: 0,0:21:54.02,0:21:55.81,Default,,0,0,0,,Мынадай ән болды ма?
Dialogue: 0,0:21:57.85,0:22:00.11,Default,,0,0,0,,Бұл мүлдем басқаша емес пе?
Dialogue: 0,0:22:02.44,0:22:03.32,Default,,0,0,0,,Коюки-кун
Dialogue: 0,0:22:03.40,0:22:07.03,Default,,0,0,0,,Бұл, әрине, сенің менің сезімім
Dialogue: 0,0:22:08.61,0:22:10.41,Default,,0,0,0,,Маған бұл ән ұнайды
Dialogue: 0,0:22:10.87,0:22:11.83,Default,,0,0,0,,Коюки-кун...
Dialogue: 0,0:22:11.91,0:22:13.33,Default,,0,0,0,,Коюки~!
Dialogue: 0,0:22:13.54,0:22:15.62,Default,,0,0,0,,Ол менің танысым!
Dialogue: 0,0:22:15.75,0:22:17.33,Default,,0,0,0,,Танака~!
Dialogue: 0,0:22:19.83,0:22:21.71,Default,,0,0,0,,Сәлем! Сіз мұны естіп жатырсыз ба?
Dialogue: 0,0:22:21.84,0:22:24.76,Default,,0,0,0,,Мотивацияңыз болса, асығыңыз да, сахнаға шығыңыз!
Dialogue: 0,0:22:25.38,0:22:28.38,Default,,0,0,0,,Хэхехе... Түсінбедім.
Dialogue: 0,0:22:28.88,0:22:29.97,Default,,0,0,0,,Коюкидің сол шиеленісі...
Dialogue: 0,0:22:30.09,0:22:32.60,Default,,0,0,0,,Сіз кенеттен үлгере алмайсыз.
Dialogue: 0,0:22:33.60,0:22:35.97,Default,,0,0,0,,Күте тұрыңыз, Коюки!
Dialogue: 0,0:22:36.10,0:22:42.11,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:22:43.94,0:22:49.86,Default,,0,0,0,,♪～
Dialogue: 0,0:24:03.90,0:24:09.15,Default,,0,0,0,,～♪
Dialogue: 0,0:24:14.28,0:24:16.03,Default,,0,0,0,,Келесі аптада «Үшінші кезең»
Dialogue: 0,0:24:16.16,0:24:18.66,Default,,0,0,0,,Соңында, мен ризамын...
Dialogue: 0,0:24:18.79,0:24:19.66,Default,,0,0,0,,Мен шыға аламын ба?
Dialogue: 0,0:24:19.79,0:24:20.91,Default,,0,0,0,,Бұл шықты!
Dialogue: 0,0:24:22.41,0:24:28.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
