Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.45,0:00:06.96,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.67,0:01:36.88,Default,,0,0,0,,～♪
Dialogue: 0,0:01:37.43,0:01:42.01,Default,,0,0,0,,(Тікұшақтың ұшу дыбысы)
Dialogue: 0,0:01:46.73,0:01:47.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:50.98,0:01:52.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:58.36,0:01:59.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:01.49,0:02:02.45,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:10.50,0:02:14.96,Default,,0,0,0,,(Бектің жылағаны)
Dialogue: 0,0:02:16.80,0:02:17.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:27.85,0:02:28.69,Default,,0,0,0,,Иә
Dialogue: 0,0:02:28.77,0:02:30.69,Default,,0,0,0,,(айқай)
Dialogue: 0,0:02:31.60,0:02:33.19,Default,,0,0,0,,Абай бол, Твайлайт.
Dialogue: 0,0:02:51.21,0:02:54.88,Default,,0,0,0,,Бек серуенге шықпады ма?
Dialogue: 0,0:02:55.13,0:02:57.30,Default,,0,0,0,,Не? Екі күн?
Dialogue: 0,0:02:57.88,0:03:00.17,Default,,0,0,0,,Байланыс жоқ, солай ма?
Dialogue: 0,0:03:03.18,0:03:04.72,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:03:05.18,0:03:06.26,Default,,0,0,0,,Я...
Dialogue: 0,0:03:06.35,0:03:11.27,Default,,0,0,0,,Хмм, сәлем, әже! Сіз уайымдамайсыз ба?
Dialogue: 0,0:03:13.52,0:03:14.61,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:14.81,0:03:16.27,Default,,0,0,0,,Сәлем! (Коюки Саку) Жоқ...
Dialogue: 0,0:03:16.40,0:03:18.36,Default,,0,0,0,,Хмм.
Dialogue: 0,0:03:19.32,0:03:21.03,Default,,0,0,0,,Люсиль де жоқ сияқты.
Dialogue: 0,0:03:25.45,0:03:28.58,Default,,0,0,0,,Ол... Хм!
Dialogue: 0,0:03:36.46,0:03:38.96,Default,,0,0,0,,(ғибадатхана қоңырауының дыбысы)
Dialogue: 0,0:03:50.52,0:03:52.85,Default,,0,0,0,,Мен Киотоға келгім келеді.
Dialogue: 0,0:03:53.06,0:03:55.77,Default,,0,0,0,,Леон-сан, сен жапонофильсің.
Dialogue: 0,0:03:55.90,0:03:58.11,Default,,0,0,0,,Ағамның әсері болғанына сенімдімін...
Dialogue: 0,0:03:58.23,0:04:00.15,Default,,0,0,0,,Мен бұл туралы естідім.
Dialogue: 0,0:04:00.61,0:04:01.99,Default,,0,0,0,,Я~
Dialogue: 0,0:04:02.70,0:04:06.16,Default,,0,0,0,,Жастайынан нағашысының қолында болып, тәрбиеленген көрінеді.
Dialogue: 0,0:04:06.57,0:04:09.54,Default,,0,0,0,,Ағамның әйелі жапон болса керек.
Dialogue: 0,0:04:10.58,0:04:14.92,Default,,0,0,0,,Леон мырза түрлі себептермен жетістікке жеткен адам.
Dialogue: 0,0:04:15.54,0:04:17.50,Default,,0,0,0,,Мен егжей-тегжейлі білмеймін, бірақ...
Dialogue: 0,0:04:17.63,0:04:21.46,Default,,0,0,0,,Оның денесінде азиялық, англосаксондық, африкалық...
Dialogue: 0,0:04:21.59,0:04:24.80,Default,,0,0,0,,Тамырың арқылы бес құрлықтың қаны ағып жатыр дейді.
Dialogue: 0,0:04:25.13,0:04:27.39,Default,,0,0,0,,Бес?
Dialogue: 0,0:04:27.64,0:04:30.97,Default,,0,0,0,,Бұл жай ғана өсек.
Dialogue: 0,0:04:32.18,0:04:34.27,Default,,0,0,0,,Бірдеңе... Мен қорқамын.
Dialogue: 0,0:04:34.39,0:04:35.81,Default,,0,0,0,,О
Dialogue: 0,0:04:53.08,0:04:55.58,Default,,0,0,0,,<Бастық! 〉
Dialogue: 0,0:04:55.71,0:04:57.92,Default,,0,0,0,,<Бөлмеде жалғыз менмін>
Dialogue: 0,0:04:58.00,0:05:02.46,Default,,0,0,0,,<Бәріңіз де Акихабарада сауда жасамайсыз ба?>
Dialogue: 0,0:05:02.59,0:05:03.80,Default,,0,0,0,,<Сол адам? 〉
Dialogue: 0,0:05:03.92,0:05:06.18,Default,,0,0,0,,<Жарайды>
Dialogue: 0,0:05:06.38,0:05:09.47,Default,,0,0,0,,〈Себебі мен сені ұрдым〉
Dialogue: 0,0:05:09.60,0:05:10.51,Default,,0,0,0,,〈Мен енді қашуды ойламаймын.〉
Dialogue: 0,0:05:10.51,0:05:13.47,Default,,0,0,0,,〈Мен енді қашу туралы ойламаймын.〉
Dialogue: 0,0:05:10.51,0:05:13.47,Default,,0,0,0,,(Бектің жылағаны)
Dialogue: 0,0:05:14.02,0:05:16.60,Default,,0,0,0,,<Жарайды, Токио станциясы сағат 10-да.>
Dialogue: 0,0:05:16.73,0:05:20.02,Default,,0,0,0,,<Уақытында келіп алып кетемін, бастық>
Dialogue: 0,0:05:22.73,0:05:23.82,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:05:23.94,0:05:27.41,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:05:27.53,0:05:29.91,Default,,0,0,0,,Мм!! Хмф! (Голди) Ах!
Dialogue: 0,0:05:32.83,0:05:34.25,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:34.62,0:05:40.38,Default,,0,0,0,,(Голди ағылшын тілі)
Dialogue: 0,0:05:40.46,0:05:41.29,Default,,0,0,0,,Уау... (Рюсуке жөтеледі)
Dialogue: 0,0:05:41.29,0:05:44.13,Default,,0,0,0,,Уау... (Рюсуке жөтеледі)
Dialogue: 0,0:05:41.29,0:05:44.13,Default,,0,0,0,,<Чикушо! Ол қатты тітіркендіреді! 〉
Dialogue: 0,0:05:44.13,0:05:44.71,Default,,0,0,0,,<Чикушо! Ол қатты тітіркендіреді! 〉
Dialogue: 0,0:05:54.97,0:05:56.18,Default,,0,0,0,,<Мырза. Сайкс! 〉
Dialogue: 0,0:05:56.27,0:05:59.69,Default,,0,0,0,,Сіз Джон Ли Дэвисті білесіз бе? 〉
Dialogue: 0,0:05:59.94,0:06:02.36,Default,,0,0,0,,<Компанияға хабарласты>
Dialogue: 0,0:06:02.48,0:06:05.03,Default,,0,0,0,,〈Ол қазір кешегі танымал жан әншісі〉
Dialogue: 0,0:06:05.15,0:06:07.15,Default,,0,0,0,,〈Олар Жапонияға минус тобы ретінде келетін сияқты〉
Dialogue: 0,0:06:08.70,0:06:10.66,Default,,0,0,0,,〈Бір-бірімізді үш жыл бойы көрмедік.〉
Dialogue: 0,0:06:10.74,0:06:12.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:12.16,0:06:14.91,Default,,0,0,0,,〈Джон Ли Дэвис – менің ағам〉
Dialogue: 0,0:06:15.50,0:06:17.12,Default,,0,0,0,,〈Теледидардан көріп отырған шығар.〉
Dialogue: 0,0:06:17.25,0:06:20.42,Default,,0,0,0,,<Сіз Мистер Сайкстың Жапонияға келгені туралы естіген шығарсыз.>
Dialogue: 0,0:06:33.01,0:06:34.60,Default,,0,0,0,,<Дүкеннің атауы Crossroads>
Dialogue: 0,0:06:34.72,0:06:36.47,Default,,0,0,0,,〈Бұл біраз ыңғайсыз〉
Dialogue: 0,0:06:36.56,0:06:39.27,Default,,0,0,0,,〈Ағаң сол дүкенде ме? 〉
Dialogue: 0,0:06:39.39,0:06:43.56,Default,,0,0,0,,〈Бұл менің ағам Жапонияға келгенде үнемі баратын дүкен.〉
Dialogue: 0,0:06:43.69,0:06:45.40,Default,,0,0,0,,<Олай болса да, бұл бастық>
Dialogue: 0,0:06:45.53,0:06:48.99,Default,,0,0,0,,〈Мені мұнда неге алып бара жатырсың? 〉
Dialogue: 0,0:06:49.07,0:06:51.32,Default,,0,0,0,,<Люсиль табылды—>
Dialogue: 0,0:06:51.45,0:06:53.87,Default,,0,0,0,,<Мен оларға кінәлі жапон музыканты екенін айтқанымда...>
Dialogue: 0,0:06:53.99,0:06:56.12,Default,,0,0,0,,〈Ол маған кездесуді өтінді〉
Dialogue: 0,0:06:56.24,0:06:58.37,Default,,0,0,0,,〈Бұл қиын емес пе? 〉
Dialogue: 0,0:06:59.41,0:07:01.33,Default,,0,0,0,,<Итке не болды? 〉
Dialogue: 0,0:07:02.25,0:07:04.50,Default,,0,0,0,,<Мен онымен мүлдем таныс емеспін.>
Dialogue: 0,0:07:07.34,0:07:11.38,Default,,0,0,0,,(көк өнімділігі)
Dialogue: 0,0:07:41.79,0:07:43.46,Default,,0,0,0,,<Көгілдір>
Dialogue: 0,0:07:44.96,0:07:46.50,Default,,0,0,0,,<Роберт Джонсон?>
Dialogue: 0,0:07:46.63,0:07:47.67,Default,,0,0,0,,<Бұл таңқаларлық>
Dialogue: 0,0:07:47.80,0:07:50.26,Default,,0,0,0,,〈Алтын елес: RJ белгісінің артындағы бастық〉
Dialogue: 0,0:07:50.38,0:07:51.55,Default,,0,0,0,,<Леон Сайкстың аузынан—>
Dialogue: 0,0:07:51.67,0:07:54.05,Default,,0,0,0,,<Роберт Джонсонның аты аталғанына сене алмаймын.>
Dialogue: 0,0:07:55.85,0:07:57.93,Default,,0,0,0,,<О, бұл Леон! 〉
Dialogue: 0,0:07:58.06,0:07:59.22,Default,,0,0,0,,<Сәлем! 〉
Dialogue: 0,0:07:59.35,0:08:01.48,Default,,0,0,0,,<Осындай қорқынышты жүзбен не ойлап отырсың? 〉
Dialogue: 0,0:08:01.60,0:08:04.44,Default,,0,0,0,,〈Мен сенің алауың сияқты сені сотқа беремін.''
Dialogue: 0,0:08:04.56,0:08:06.56,Default,,0,0,0,,<Мен сенен ақша алмақшымын...>
Dialogue: 0,0:08:06.69,0:08:08.90,Default,,0,0,0,,<Уайымдама, мен бұл туралы ойламаймын! 〉
Dialogue: 0,0:08:09.03,0:08:10.03,Default,,0,0,0,,<Джон>
Dialogue: 0,0:08:10.69,0:08:11.57,Default,,0,0,0,,<Леон>
Dialogue: 0,0:08:11.69,0:08:15.07,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:08:17.66,0:08:19.91,Default,,0,0,0,,<Бұл сіз айтқан жапон адамы ма? 〉
Dialogue: 0,0:08:20.04,0:08:22.37,Default,,0,0,0,,<Ах Рюсуке Минами>
Dialogue: 0,0:08:23.46,0:08:25.29,Default,,0,0,0,,<Чикаго Үндістанынан—>
Dialogue: 0,0:08:25.42,0:08:27.75,Default,,0,0,0,,<Мен куртка киген Люсильмен альбом шығардым.>
Dialogue: 0,0:08:27.88,0:08:29.13,Default,,0,0,0,,<Жынды бейбақ>
Dialogue: 0,0:08:29.25,0:08:30.13,Default,,0,0,0,,<Бірдеңе айт! 〉
Dialogue: 0,0:08:30.25,0:08:30.55,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:08:30.55,0:08:31.67,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:08:30.55,0:08:31.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:32.34,0:08:34.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:36.68,0:08:38.89,Default,,0,0,0,,<Мен бір сәт қолымды жуайын>
Dialogue: 0,0:08:44.81,0:08:46.98,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:08:47.10,0:08:49.90,Default,,0,0,0,,<Пьесаны бұрын естігенде солай ойладым>
Dialogue: 0,0:08:50.19,0:08:51.36,Default,,0,0,0,,〈Оу〉
Dialogue: 0,0:08:51.48,0:08:53.19,Default,,0,0,0,,<Ол тірі ме? 〉
Dialogue: 0,0:08:53.32,0:08:54.57,Default,,0,0,0,,〈Мүмкін—〉
Dialogue: 0,0:08:54.70,0:08:56.70,Default,,0,0,0,,〈Сіз Джон Ли Дэвис мырзасыз ба? 〉
Dialogue: 0,0:08:56.82,0:08:58.74,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:09:03.96,0:09:09.96,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:09:10.46,0:09:12.00,Default,,0,0,0,,〈Хо! 〉
Dialogue: 0,0:09:12.13,0:09:14.55,Default,,0,0,0,,〈Сонымен, сіз мұны түсінесіз бе? 〉
Dialogue: 0,0:09:14.67,0:09:21.06,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:09:29.06,0:09:32.61,Default,,0,0,0,,<1964 жылы Сан-Францискодағы қойылым>
Dialogue: 0,0:09:32.73,0:09:34.07,Default,,0,0,0,,〈Oioi〉
Dialogue: 0,0:09:34.19,0:09:37.03,Default,,0,0,0,,〈Сіз жер бетінде қашан дүниеге келдіңіз? 〉
Dialogue: 0,0:09:39.41,0:09:41.33,Default,,0,0,0,,〈Соңында, мистер Дэвис...〉
Dialogue: 0,0:09:41.45,0:09:42.99,Default,,0,0,0,,<Мен сеанс өткізгім келеді>
Dialogue: 0,0:09:45.54,0:09:50.29,Default,,0,0,0,,(Дэвис гитарада ойнау)
Dialogue: 0,0:09:50.42,0:09:53.55,Default,,0,0,0,,〈Осындай қолмен ойнай аласың ба? 〉
Dialogue: 0,0:09:53.67,0:09:57.38,Default,,0,0,0,,〈Бақытымызға орай, сол қолым бүтін.〉
Dialogue: 0,0:09:57.68,0:10:03.68,Default,,0,0,0,,(Рюсуке мен Дэвис сессиясы)
Dialogue: 0,0:10:45.89,0:10:47.39,Default,,0,0,0,,〈Хо! 〉
Dialogue: 0,0:10:48.48,0:10:50.60,Default,,0,0,0,,〈Көк түс те жақсы〉
Dialogue: 0,0:10:50.94,0:10:55.19,Default,,0,0,0,,〈Музыка бизнеске жарамсыз〉
Dialogue: 0,0:11:07.33,0:11:08.87,Default,,0,0,0,,〈Мен сіздің гитараңызды естігенде...〉
Dialogue: 0,0:11:09.00,0:11:10.79,Default,,0,0,0,,〈Бір себептермен бұл маған Күншіл баланы еске түсіреді〉
Dialogue: 0,0:11:10.92,0:11:13.96,Default,,0,0,0,,〈Шынымен бе? Хахахаха! 〉
Dialogue: 0,0:11:14.09,0:11:16.63,Default,,0,0,0,,<Күншуақ бала менің қожайыным! 〉
Dialogue: 0,0:11:16.75,0:11:20.30,Default,,0,0,0,,<Сіз байсалдысыз ба? Сонда Люсиль ше? 〉
Dialogue: 0,0:11:20.42,0:11:23.55,Default,,0,0,0,,<Күншуақ бала туысы жоқ адам>
Dialogue: 0,0:11:23.68,0:11:24.93,Default,,0,0,0,,〈Менен басқа〉
Dialogue: 0,0:11:25.05,0:11:28.10,Default,,0,0,0,,<Люсильді қабылдайтын ешкім болмады.>
Dialogue: 0,0:11:28.22,0:11:31.44,Default,,0,0,0,,〈Бірақ Люсиль менің ыдысым үшін тым үлкен〉
Dialogue: 0,0:11:31.56,0:11:33.23,Default,,0,0,0,,〈Люсильге өте қолайлы〉
Dialogue: 0,0:11:33.35,0:11:35.11,Default,,0,0,0,,〈Егер нағыз блюзмен шықса...〉
Dialogue: 0,0:11:35.23,0:11:36.44,Default,,0,0,0,,<Мен берілуді жоспарладым.>
Dialogue: 0,0:11:36.57,0:11:39.74,Default,,0,0,0,,〈Сен нағыз блюзменсің! 〉
Dialogue: 0,0:11:40.03,0:11:41.82,Default,,0,0,0,,〈Негізі мен бір кездері музыкадан бас тартқанмын.〉
Dialogue: 0,0:11:41.95,0:11:45.45,Default,,0,0,0,,<Ол кезде Люсиль оны Леонға сеніп тапсырған>
Dialogue: 0,0:11:47.91,0:11:49.66,Default,,0,0,0,,<Мырза. Джон Ли Дэвис>
Dialogue: 0,0:11:49.79,0:11:53.71,Default,,0,0,0,,<Сенімен ойнау үлкен мәртебе. Рахмет.>
Dialogue: 0,0:11:55.21,0:11:57.42,Default,,0,0,0,,Доиташима Шите
Dialogue: 0,0:11:57.80,0:12:01.59,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:12:08.97,0:12:11.06,Default,,0,0,0,,〈Сіз темекі шегесіз бе? 〉
Dialogue: 0,0:12:11.18,0:12:12.81,Default,,0,0,0,,<Бұл маған қажет емес>
Dialogue: 0,0:12:14.27,0:12:14.69,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:12:14.69,0:12:15.98,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:12:14.69,0:12:15.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:21.11,0:12:22.99,Default,,0,0,0,,<Леон, ол шынайы>
Dialogue: 0,0:12:23.11,0:12:25.28,Default,,0,0,0,,〈Мен осы уақытқа дейін кездестірген жапондықтар〉
Dialogue: 0,0:12:25.41,0:12:27.99,Default,,0,0,0,,``Блюзді ол сияқты ешкім түсінбеді.''
Dialogue: 0,0:12:28.12,0:12:29.83,Default,,0,0,0,,〈Сонымен қатар, ол таңқаларлықтай жас.〉
Dialogue: 0,0:12:31.16,0:12:34.04,Default,,0,0,0,,〈Эрика Блайдж өз-өзіне қол жұмсаған жоқ, ол өлтірілді.〉
Dialogue: 0,0:12:34.17,0:12:35.96,Default,,0,0,0,,〈Мен сен кінәлі деген қауесет естідім.〉
Dialogue: 0,0:12:36.08,0:12:39.34,Default,,0,0,0,,<Эрика, әрине, RJ белгісін сынады>
Dialogue: 0,0:12:41.42,0:12:42.67,Default,,0,0,0,,<Леон>
Dialogue: 0,0:12:42.80,0:12:45.84,Default,,0,0,0,,〈Ақша үшін адам өлтіруге дейін барасыз ба? 〉
Dialogue: 0,0:12:46.26,0:12:49.26,Default,,0,0,0,,〈Ол өлтіруге тым жақсы.〉
Dialogue: 0,0:12:50.81,0:12:52.06,Default,,0,0,0,,<Ағатай>
Dialogue: 0,0:12:52.18,0:12:54.77,Default,,0,0,0,,〈Осындай келеңсіз қоғамда қаншалықты лайықты өмір сүрсең де〉
Dialogue: 0,0:12:54.89,0:12:57.10,Default,,0,0,0,,〈Сіздің қолыңыздан келетін жалғыз нәрсе — кедей адам болу.〉
Dialogue: 0,0:12:57.23,0:13:01.03,Default,,0,0,0,,〈Сонымен қатар адамдардың көпшілігі көмексіз өледі.〉
Dialogue: 0,0:13:03.57,0:13:05.74,Default,,0,0,0,,<Сосын мен...>
Dialogue: 0,0:13:08.95,0:13:14.00,Default,,0,0,0,,(Көлікте хип-хоп ойнайды)
Dialogue: 0,0:13:14.33,0:13:17.46,Default,,0,0,0,,<Бұл сұмдық музыка>
Dialogue: 0,0:13:17.83,0:13:19.42,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:13:17.83,0:13:19.42,Default,,0,0,0,,Сол жерде болыңыз! Ах!
Dialogue: 0,0:13:19.42,0:13:20.67,Default,,0,0,0,,Сол жерде болыңыз! Ах!
Dialogue: 0,0:13:25.84,0:13:29.72,Default,,0,0,0,,Рюсуке-кунның жоғалып кеткеніне төрт күн болды.
Dialogue: 0,0:13:29.85,0:13:31.01,Default,,0,0,0,,Иә
Dialogue: 0,0:13:31.31,0:13:35.60,Default,,0,0,0,,Мүмкін мен полицияға хабарлауым керек...
Dialogue: 0,0:13:36.60,0:13:39.06,Default,,0,0,0,,Жақында тікелей эфир болады.
Dialogue: 0,0:13:41.07,0:13:43.82,Default,,0,0,0,,Ха! Оны балық аулайтын тоғандағы әжеге жеткізіңіз!
Dialogue: 0,0:13:43.94,0:13:45.32,Default,,0,0,0,,Сәлем!! иә?
Dialogue: 0,0:13:45.40,0:13:47.78,Default,,0,0,0,,Міне! Бұл! Ууууу!
Dialogue: 0,0:13:47.91,0:13:50.66,Default,,0,0,0,,Ах! Чиба-кун
Dialogue: 0,0:13:50.78,0:13:53.95,Default,,0,0,0,,Жарайды, не болды?
Dialogue: 0,0:13:55.08,0:13:58.92,Default,,0,0,0,,Не, балалар әлі білмейсіңдер ме?
Dialogue: 0,0:13:59.04,0:14:01.00,Default,,0,0,0,,Хехе... Хм.
Dialogue: 0,0:14:01.13,0:14:03.17,Default,,0,0,0,,Қаша бер! Мықтап ұста!
Dialogue: 0,0:14:03.30,0:14:05.34,Default,,0,0,0,,Махо...?
Dialogue: 0,0:14:05.97,0:14:06.80,Default,,0,0,0,,Хмф
Dialogue: 0,0:14:07.30,0:14:09.55,Default,,0,0,0,,Минами… Махо
Dialogue: 0,0:14:10.09,0:14:11.89,Default,,0,0,0,,16 жас…
Dialogue: 0,0:14:13.60,0:14:17.27,Default,,0,0,0,,Менің ойымша, Махоның жігіті бірден шығып кетуі мүмкін.
Dialogue: 0,0:14:17.39,0:14:19.02,Default,,0,0,0,,Хехехехехе~
Dialogue: 0,0:14:19.14,0:14:22.15,Default,,0,0,0,,Елдің түкпір-түкпірінде сіздей адамдар бар...
Dialogue: 0,0:14:22.27,0:14:24.15,Default,,0,0,0,,Адамдар көп!
Dialogue: 0,0:14:24.28,0:14:27.40,Default,,0,0,0,,Мен оны ұстанатын сияқты емеспін!
Dialogue: 0,0:14:27.78,0:14:32.95,Default,,0,0,0,,Хэхехехе~ Сосын істеймін~ Ухаха...
Dialogue: 0,0:14:33.08,0:14:35.58,Default,,0,0,0,,Екеуің не нәрсеге жабысып тұрсыңдар?
Dialogue: 0,0:14:35.70,0:14:39.92,Default,,0,0,0,,А, жоқ, бұл ойынға арналған стратегиялық нұсқаулық сияқты...
Dialogue: 0,0:14:40.04,0:14:41.42,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:14:41.83,0:14:43.46,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:43.67,0:14:46.92,Default,,0,0,0,,Коюки Маходан естіген жоқ па?
Dialogue: 0,0:14:47.17,0:14:51.14,Default,,0,0,0,,Мен сені соңғы уақытта мүлде көрмедім, ал сен бос емес сияқтысың...
Dialogue: 0,0:14:56.47,0:14:58.93,Default,,0,0,0,,Иә? Саку-чанның мұрнынан қан кетті
Dialogue: 0,0:14:59.06,0:15:00.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:02.86,0:15:03.65,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:15:03.65,0:15:04.73,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:15:03.65,0:15:04.73,Default,,0,0,0,,О? Хмм
Dialogue: 0,0:15:04.73,0:15:05.36,Default,,0,0,0,,О? Хмм
Dialogue: 0,0:15:05.48,0:15:09.78,Default,,0,0,0,,Эй, Хэйкун? Иә, не болды?
Dialogue: 0,0:15:10.70,0:15:12.49,Default,,0,0,0,,Иә!?
Dialogue: 0,0:15:12.99,0:15:16.41,Default,,0,0,0,,Не болды, Чиба-кун!? (Чиба) Иә! Мен бірден барамын!
Dialogue: 0,0:15:16.62,0:15:19.04,Default,,0,0,0,,Уау! Чиба-кун!
Dialogue: 0,0:15:22.00,0:15:25.34,Default,,0,0,0,,Эй!! Рюсуке~!!
Dialogue: 0,0:15:25.46,0:15:26.30,Default,,0,0,0,,Ммм
Dialogue: 0,0:15:26.71,0:15:28.05,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:15:29.38,0:15:33.01,Default,,0,0,0,,Ол Бекті серуендеуге алып бара жатты.
Dialogue: 0,0:15:33.47,0:15:35.76,Default,,0,0,0,,Неге таңғышпен жабылып қалдың!
Dialogue: 0,0:15:35.89,0:15:38.27,Default,,0,0,0,,Рюсуке-кун, жақсысың ба?
Dialogue: 0,0:15:38.39,0:15:40.18,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:15:40.31,0:15:43.27,Default,,0,0,0,,Сәлем! Бек пен Люсильге не болды?
Dialogue: 0,0:15:43.35,0:15:48.03,Default,,0,0,0,,Хаха, жақсы, әйелдер, ақша т.б.
Dialogue: 0,0:15:48.15,0:15:49.78,Default,,0,0,0,,Менен ақымақ ештеңе сұрама.
Dialogue: 0,0:15:50.07,0:15:52.45,Default,,0,0,0,,Әй, әйел...?
Dialogue: 0,0:15:52.78,0:15:54.28,Default,,0,0,0,,Ақша?
Dialogue: 0,0:15:55.57,0:16:00.16,Default,,0,0,0,,Әйтеуір, Бек пен Люсиль қайтып келмейді.
Dialogue: 0,0:16:02.41,0:16:04.46,Default,,0,0,0,,Мен сенімен кейінірек сөйлесемін (Чиба)!
Dialogue: 0,0:16:04.58,0:16:05.92,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:06.04,0:16:08.25,Default,,0,0,0,,Шынымен, сен не істеп жүрсің?
Dialogue: 0,0:16:08.38,0:16:11.51,Default,,0,0,0,,Мазасыз екенсің (Тайра) Жүр, кел, жарасып алайық.
Dialogue: 0,0:16:13.22,0:16:14.97,Default,,0,0,0,,Рюсуке-кун...
Dialogue: 0,0:16:30.94,0:16:34.82,Default,,0,0,0,,Басқаша айтқанда, мен өлтіруге тұрарлық емеспін.
Dialogue: 0,0:16:43.83,0:16:48.63,Default,,0,0,0,,<Иә, мен ақша үшін кез келген адамды өлтірер едім>
Dialogue: 0,0:16:48.84,0:16:52.51,Default,,0,0,0,,〈Бірақ менде мағынасыз кісі өлтірмеу саясаты бар.〉
Dialogue: 0,0:16:52.63,0:16:55.13,Default,,0,0,0,,<Кет, тентек! 〉
Dialogue: 0,0:16:56.59,0:17:01.85,Default,,0,0,0,,Қызық, мен адамдардың жүрегін елжірететін музыка жасай алмаймын ба?
Dialogue: 0,0:17:04.52,0:17:06.77,Default,,0,0,0,,Сен... не айттың!
Dialogue: 0,0:17:06.90,0:17:09.57,Default,,0,0,0,,Дұрыс, аман бол!
Dialogue: 0,0:17:11.28,0:17:13.78,Default,,0,0,0,,Ей, Саку, мынаны қара!
Dialogue: 0,0:17:14.03,0:17:16.53,Default,,0,0,0,,Бұл тамаша мүмкіндік!
Dialogue: 0,0:17:16.99,0:17:20.78,Default,,0,0,0,,Сәлем! Тыңдау иә...
Dialogue: 0,0:17:20.91,0:17:23.04,Default,,0,0,0,,Айтайын, Рюсуке-кун.
Dialogue: 0,0:17:23.16,0:17:23.75,Default,,0,0,0,,Дұрыс! Ах!
Dialogue: 0,0:17:23.75,0:17:25.21,Default,,0,0,0,,Дұрыс! Ах!
Dialogue: 0,0:17:23.75,0:17:25.21,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:17:25.21,0:17:25.33,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:17:25.33,0:17:26.29,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:17:25.33,0:17:26.29,Default,,0,0,0,,Ал, бұл туралы не деуге болады?
Dialogue: 0,0:17:26.29,0:17:27.29,Default,,0,0,0,,Ал, бұл туралы не деуге болады?
Dialogue: 0,0:17:27.42,0:17:28.79,Default,,0,0,0,,Не? мм...
Dialogue: 0,0:17:28.88,0:17:32.21,Default,,0,0,0,,Бұл тыңдау екі ай бұрын аяқталды.
Dialogue: 0,0:17:32.34,0:17:34.38,Default,,0,0,0,,Не? Сол сияқты...
Dialogue: 0,0:17:34.51,0:17:38.59,Default,,0,0,0,,Жалпы алғанда, Grateful Sound-қа дайындалу үшін бір жыл қажет.
Dialogue: 0,0:17:38.72,0:17:40.97,Default,,0,0,0,,А, сен...
Dialogue: 0,0:17:41.26,0:17:44.02,Default,,0,0,0,,Айтпақшы, тыңдаудан өткен топ...
Dialogue: 0,0:17:44.14,0:17:45.68,Default,,0,0,0,,Ла Махистре
Dialogue: 0,0:17:45.81,0:17:48.94,Default,,0,0,0,,Ранның лейблінен келешегі зор жаңадан келген ойыншы.
Dialogue: 0,0:17:49.06,0:17:50.27,Default,,0,0,0,,Орхидея…
Dialogue: 0,0:17:50.36,0:17:52.44,Default,,0,0,0,,Басқаша айтқанда, бұл қысқа жарыс.
Dialogue: 0,0:17:52.57,0:17:54.82,Default,,0,0,0,,Сол кемпір-
Dialogue: 0,0:17:54.94,0:17:57.28,Default,,0,0,0,,Қария? Ммммммм!
Dialogue: 0,0:17:54.94,0:17:57.28,Default,,0,0,0,,Бұл балық аулайтын тоған бүгін жабық.
Dialogue: 0,0:17:57.28,0:17:58.20,Default,,0,0,0,,Бұл балық аулайтын тоған бүгін жабық.
Dialogue: 0,0:17:58.32,0:17:59.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:01.91,0:18:03.49,Default,,0,0,0,,Уау!!
Dialogue: 0,0:18:03.62,0:18:06.12,Default,,0,0,0,,Бо Бо Бо Бо... Мүмкін мен—
Dialogue: 0,0:18:06.25,0:18:09.46,Default,,0,0,0,,Джим Уолш фильміндегі Дайбрмен бірге ән айтып жатқан бала!?
Dialogue: 0,0:18:09.58,0:18:12.42,Default,,0,0,0,,Иә, бұл рас, бірақ хехе
Dialogue: 0,0:18:12.50,0:18:15.96,Default,,0,0,0,,Иә, бұл сендерсіңдер, солай ма?
Dialogue: 0,0:18:16.63,0:18:17.59,Default,,0,0,0,,Иә
Dialogue: 0,0:18:17.72,0:18:19.51,Default,,0,0,0,,Моңғолдың шабақ жасағы —
Dialogue: 0,0:18:19.64,0:18:22.76,Default,,0,0,0,,Бұл біздің Америкадағы топтың аты.
Dialogue: 0,0:18:23.31,0:18:25.97,Default,,0,0,0,,Кяаааа! Мен оны істедім!!
Dialogue: 0,0:18:26.10,0:18:28.89,Default,,0,0,0,,Ақыры, мен оны таптым! Мен қателескен жоқпын
Dialogue: 0,0:18:29.02,0:18:31.23,Default,,0,0,0,,Менің шегерім дұрыс болды!
Dialogue: 0,0:18:31.36,0:18:33.44,Default,,0,0,0,,Бұл керемет!!
Dialogue: 0,0:18:34.53,0:18:37.24,Default,,0,0,0,,Әй, мен саған клиенттерді кіргізбе дедім ғой!
Dialogue: 0,0:18:37.36,0:18:40.45,Default,,0,0,0,,О, мен тұтынушы емеспін. Дәлірек айтсақ, мен тұтынушымын...
Dialogue: 0,0:18:40.57,0:18:42.28,Default,,0,0,0,,Жоқ, мен ондай тұтынушы емеспін...
Dialogue: 0,0:18:42.28,0:18:42.45,Default,,0,0,0,,Жоқ, мен ондай тұтынушы емеспін...
Dialogue: 0,0:18:42.28,0:18:42.45,Default,,0,0,0,,(Казуо шуы)
Dialogue: 0,0:18:42.45,0:18:42.57,Default,,0,0,0,,(Казуо шуы)
Dialogue: 0,0:18:42.57,0:18:45.29,Default,,0,0,0,,(Казуо шуы)
Dialogue: 0,0:18:42.57,0:18:45.29,Default,,0,0,0,,Эй, біздің АҚШ CD-ді тыңдаңыз.
Dialogue: 0,0:18:45.41,0:18:47.50,Default,,0,0,0,,Ол болашаққа сенді.
Dialogue: 0,0:18:49.12,0:18:50.92,Default,,0,0,0,,Әлгі кемпір?
Dialogue: 0,0:18:51.04,0:18:52.50,Default,,0,0,0,,Хмм.
Dialogue: 0,0:18:52.63,0:18:57.55,Default,,0,0,0,,«Металл желім Sato Wow»?
Dialogue: 0,0:18:57.67,0:19:00.09,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:19:00.22,0:19:01.05,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:19:01.18,0:19:03.93,Default,,0,0,0,,<Әй, Рюсуке, сен не істеп жүрсің!? 〉
Dialogue: 0,0:19:04.05,0:19:07.43,Default,,0,0,0,,<Аа, Уолли, қазір бос емессің бе?>
Dialogue: 0,0:19:07.77,0:19:09.23,Default,,0,0,0,,Сәлем! Коюки
Dialogue: 0,0:19:09.48,0:19:11.69,Default,,0,0,0,,Не?
Dialogue: 0,0:19:14.98,0:19:16.28,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:19:16.40,0:19:17.36,Default,,0,0,0,,Коюки?
Dialogue: 0,0:19:17.48,0:19:19.90,Default,,0,0,0,,Рюсуке-кун, сен аман-есен оралдың!
Dialogue: 0,0:19:20.03,0:19:22.87,Default,,0,0,0,,Ол бәрібір әйелдің орнында болды, солай ма?
Dialogue: 0,0:19:23.24,0:19:27.24,Default,,0,0,0,,Айтпақшы, бүгін роуд-шоу.
Dialogue: 0,0:19:27.37,0:19:29.33,Default,,0,0,0,,Дайбури туристік фильмі
Dialogue: 0,0:19:29.58,0:19:33.83,Default,,0,0,0,,Иә!? Дайбури фильмі? сәлем?
Dialogue: 0,0:19:33.96,0:19:36.59,Default,,0,0,0,,Эй, Коюки, оны менімен бірге көргің келе ме?
Dialogue: 0,0:19:36.71,0:19:38.42,Default,,0,0,0,,Иә! (Саку Чиба) Хехе
Dialogue: 0,0:19:38.55,0:19:39.76,Default,,0,0,0,,Мен, бір сәт...
Dialogue: 0,0:19:39.88,0:19:42.22,Default,,0,0,0,,Сәлем! Кәне!
Dialogue: 0,0:19:42.34,0:19:43.89,Default,,0,0,0,,Саку? Хехе!
Dialogue: 0,0:19:44.01,0:19:46.85,Default,,0,0,0,,Олай болса, бұл Рюсукеге арналған!
Dialogue: 0,0:19:48.10,0:19:51.06,Default,,0,0,0,,Маған ұнайды, өте жас көрінесің.
Dialogue: 0,0:19:51.19,0:19:53.10,Default,,0,0,0,,Иә (Чиба) Дахахаха…
Dialogue: 0,0:19:57.11,0:19:58.57,Default,,0,0,0,,Кеш болды~
Dialogue: 0,0:19:58.65,0:20:00.86,Default,,0,0,0,,Хаха...
Dialogue: 0,0:20:01.90,0:20:03.32,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:03.82,0:20:06.28,Default,,0,0,0,,Маған жаңа ғана Йошито қоңырау шалды.
Dialogue: 0,0:20:06.41,0:20:09.20,Default,,0,0,0,,Йошито да фильм көргісі келеді.
Dialogue: 0,0:20:09.33,0:20:11.71,Default,,0,0,0,,Екі адамның ер адаммен жағдайы...
Dialogue: 0,0:20:11.79,0:20:14.79,Default,,0,0,0,,Бұл Махоның болашағы үшін де жақсы емес.
Dialogue: 0,0:20:14.92,0:20:17.42,Default,,0,0,0,,Ахаха ахаха
Dialogue: 0,0:20:17.54,0:20:18.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:21.76,0:20:24.05,Default,,0,0,0,,Йошито-кун, бағдарламаны көргің келе ме?
Dialogue: 0,0:20:24.18,0:20:27.30,Default,,0,0,0,,Мен фильм көрмей тұрып оқымаймын.
Dialogue: 0,0:20:27.97,0:20:29.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:34.41,0:21:35.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:35.83,0:21:39.71,Default,,0,0,0,,(Эддидің ағылшыншасы)
Dialogue: 0,0:21:44.59,0:21:47.51,Default,,0,0,0,,Туған күнің құтты болсын
Dialogue: 0,0:21:47.63,0:21:49.01,Default,,0,0,0,,Эдди!
Dialogue: 0,0:21:49.39,0:21:52.22,Default,,0,0,0,,(Эдди мен Мэтт күледі)
Dialogue: 0,0:22:14.58,0:22:15.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:20.17,0:22:21.00,Default,,0,0,0,,Хехе
Dialogue: 0,0:22:21.67,0:22:22.88,Default,,0,0,0,,Иә
Dialogue: 0,0:22:31.89,0:22:34.14,Default,,0,0,0,,Ғажайып нәрсе болғалы тұр.
Dialogue: 0,0:22:35.06,0:22:36.73,Default,,0,0,0,,Менің бір болжамым бар еді.
Dialogue: 0,0:22:36.85,0:22:42.81,Default,,0,0,0,,♪～
Dialogue: 0,0:24:00.39,0:24:06.36,Default,,0,0,0,,～♪
Dialogue: 0,0:24:07.27,0:24:09.86,Default,,0,0,0,,Сатоны кемпір өте күлкілі!
Dialogue: 0,0:24:09.94,0:24:11.82,Default,,0,0,0,,Келесі аптада…
Dialogue: 0,0:24:11.95,0:24:13.82,Default,,0,0,0,,БЕК қатыса алады ма?
Dialogue: 0,0:24:15.32,0:24:21.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
