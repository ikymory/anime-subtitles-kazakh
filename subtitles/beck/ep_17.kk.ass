Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.45,0:00:06.96,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.67,0:01:36.93,Default,,0,0,0,,～♪
Dialogue: 0,0:01:38.89,0:01:42.10,Default,,0,0,0,,〈А, түсіндім.〉
Dialogue: 0,0:01:42.22,0:01:45.43,Default,,0,0,0,,<Барлық келісім-шарт мәселелерін сізге қалдырамын>
Dialogue: 0,0:01:45.56,0:01:46.68,Default,,0,0,0,,〈Аа〉
Dialogue: 0,0:01:47.02,0:01:47.85,Default,,0,0,0,,<Не? 〉
Dialogue: 0,0:01:47.98,0:01:50.56,Default,,0,0,0,,<БЕК топтың аты жаман ба? 〉
Dialogue: 0,0:01:50.69,0:01:52.32,Default,,0,0,0,,<Сонда Америкада қандай атау танымал болар еді?>
Dialogue: 0,0:01:52.44,0:01:53.94,Default,,0,0,0,,<Оған бірдеңе салыңыз>
Dialogue: 0,0:01:55.36,0:01:58.82,Default,,0,0,0,,<Мен мүмкіндігінше тезірек деректерді жіберемін. Рахмет.>
Dialogue: 0,0:02:03.16,0:02:04.95,Default,,0,0,0,,Сәлем, Рюсуке!
Dialogue: 0,0:02:05.04,0:02:06.91,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:02:10.04,0:02:13.09,Default,,0,0,0,,Иә!? Шетелде дебют!?
Dialogue: 0,0:02:13.17,0:02:17.09,Default,,0,0,0,,Бұл оңай ма? Жоқ... Мен бақыттымын.
Dialogue: 0,0:02:17.17,0:02:20.14,Default,,0,0,0,,Жоқ, менің ойымша, сіз соншалықты көп нәрсені күте алмайсыз.
Dialogue: 0,0:02:20.26,0:02:24.14,Default,,0,0,0,,Тіпті Америкада бұл супер-минор инди лейбл.
Dialogue: 0,0:02:24.26,0:02:27.48,Default,,0,0,0,,О, мм... Элвин ағай
Dialogue: 0,0:02:27.60,0:02:29.52,Default,,0,0,0,,Визит карточкасы бар адам.
Dialogue: 0,0:02:30.60,0:02:33.82,Default,,0,0,0,,Бірақ мен президенттің ынта-жігерін сезінемін.
Dialogue: 0,0:02:34.02,0:02:38.11,Default,,0,0,0,,BECK - мен естіген ең жақсы жапон тобы.
Dialogue: 0,0:02:38.90,0:02:40.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:41.11,0:02:42.82,Default,,0,0,0,,Хэхехехехе...
Dialogue: 0,0:02:42.95,0:02:49.71,Default,,0,0,0,,Америка!! Аққұба сұлулық! Муфуфуфуфуфу…
Dialogue: 0,0:02:49.83,0:02:52.58,Default,,0,0,0,,Әй... (жалпақ) Уа
Dialogue: 0,0:02:55.09,0:02:58.30,Default,,0,0,0,,Менің ойымша, бұл шетелде бізге қолайлырақ па деп ойлаймын.
Dialogue: 0,0:02:59.97,0:03:01.55,Default,,0,0,0,,Америка?
Dialogue: 0,0:03:02.01,0:03:03.18,Default,,0,0,0,,Иә
Dialogue: 0,0:03:19.61,0:03:21.24,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:03:21.78,0:03:24.16,Default,,0,0,0,,Аа, көп рахмет!
Dialogue: 0,0:03:28.58,0:03:29.66,Default,,0,0,0,,Хун
Dialogue: 0,0:03:31.21,0:03:33.79,Default,,0,0,0,,Тұтынушының маған көп рахмет айтқанына сене алар емеспін.
Dialogue: 0,0:03:33.92,0:03:35.88,Default,,0,0,0,,Иә, шынымен.
Dialogue: 0,0:03:36.21,0:03:39.76,Default,,0,0,0,,Мен осындай бақытты тұтынушыларды көрмегелі біраз болды.
Dialogue: 0,0:03:40.51,0:03:46.51,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:03:57.19,0:03:59.28,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:03.40,0:04:05.37,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:04:05.49,0:04:07.99,Default,,0,0,0,,Юкио~ Шулы!
Dialogue: 0,0:04:08.12,0:04:10.08,Default,,0,0,0,,А-а, кешіріңіз, кешіріңіз.
Dialogue: 0,0:04:10.20,0:04:13.41,Default,,0,0,0,,Ум, көлем, көлем...
Dialogue: 0,0:04:13.54,0:04:14.42,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:36.10,0:04:38.31,Default,,0,0,0,,Әй, таңға дейін күт.
Dialogue: 0,0:04:38.44,0:04:39.94,Default,,0,0,0,,Иә
Dialogue: 0,0:04:40.19,0:04:42.82,Default,,0,0,0,,Бұл Гретштен мүлде басқа түрі...
Dialogue: 0,0:04:42.94,0:04:45.03,Default,,0,0,0,,Ойнау өте қызық.
Dialogue: 0,0:04:45.24,0:04:46.32,Default,,0,0,0,,Тележүргізуші?
Dialogue: 0,0:04:46.45,0:04:49.78,Default,,0,0,0,,Иә, мен толық емес жұмыс күнімнен бір күн демалыс алдым.
Dialogue: 0,0:04:49.91,0:04:53.45,Default,,0,0,0,,Түсіндім, толық емес жұмыс күніңнен қуылма.
Dialogue: 0,0:04:53.58,0:04:55.04,Default,,0,0,0,,О
Dialogue: 0,0:05:07.14,0:05:08.85,Default,,0,0,0,,Ах~
Dialogue: 0,0:05:13.27,0:05:14.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:21.36,0:05:23.03,Default,,0,0,0,,Ах! Сол қыз!
Dialogue: 0,0:05:23.15,0:05:24.15,Default,,0,0,0,,Бетінде бір атмосфера.
Dialogue: 0,0:05:26.53,0:05:28.49,Default,,0,0,0,,Хмм ха ха ха
Dialogue: 0,0:05:31.74,0:05:33.41,Default,,0,0,0,,Ах! екінші ойлар туралы!
Dialogue: 0,0:05:33.49,0:05:34.91,Default,,0,0,0,,Иә!?
Dialogue: 0,0:05:36.41,0:05:38.50,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:05:39.25,0:05:40.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:40.42,0:05:41.79,Default,,0,0,0,,Мен...
Dialogue: 0,0:05:42.09,0:05:45.05,Default,,0,0,0,,Міне кеттік... Уф...
Dialogue: 0,0:05:45.97,0:05:47.34,Default,,0,0,0,,О... жақсысың ба?
Dialogue: 0,0:05:47.47,0:05:49.80,Default,,0,0,0,,Әйтеуір...
Dialogue: 0,0:05:49.89,0:05:51.35,Default,,0,0,0,,Ки-кун…
Dialogue: 0,0:05:51.47,0:05:54.27,Default,,0,0,0,,Мен пончик дүкенінде жұмыс істейтініме сенімдімін...
Dialogue: 0,0:05:55.10,0:05:57.60,Default,,0,0,0,,Танака... сіз?
Dialogue: 0,0:05:58.52,0:06:01.19,Default,,0,0,0,,Иә? (Масуока) Ахаха
Dialogue: 0,0:06:03.27,0:06:05.53,Default,,0,0,0,,Неліктен менің атым...
Dialogue: 0,0:06:05.86,0:06:08.70,Default,,0,0,0,,Өйткені сіз үнемі ашуланасыз.
Dialogue: 0,0:06:08.78,0:06:13.20,Default,,0,0,0,,А, түсіндім. Өте жағымсыз~ Эххе
Dialogue: 0,0:06:13.62,0:06:15.50,Default,,0,0,0,,Қараңдар, аяқталды.
Dialogue: 0,0:06:15.62,0:06:18.92,Default,,0,0,0,,Бұл үлкен мәселе емес, бірақ бірнеше күн тыныш болыңыз.
Dialogue: 0,0:06:19.04,0:06:20.75,Default,,0,0,0,,Иә
Dialogue: 0,0:06:22.09,0:06:24.92,Default,,0,0,0,,Бұл дүкендегі адамдар дөрекі.
Dialogue: 0,0:06:25.38,0:06:28.47,Default,,0,0,0,,Сол себепті қосылған адамдар бірден кетеді.
Dialogue: 0,0:06:29.47,0:06:32.68,Default,,0,0,0,,Танака-кун, сен гитарада ойнай аласың ба?
Dialogue: 0,0:06:32.76,0:06:34.68,Default,,0,0,0,,Иә, сіз оны ойнай аласыз, солай ма?
Dialogue: 0,0:06:34.81,0:06:37.39,Default,,0,0,0,,Жоқ, мүлде емес
Dialogue: 0,0:06:37.89,0:06:43.69,Default,,0,0,0,,А, мен бұл гитараны жеңіл музыка клубының бөлмесінде көрдім.
Dialogue: 0,0:06:44.52,0:06:48.32,Default,,0,0,0,,Иә, менеджер маған айқайлағандықтан 3 күннен кейін жұмыстан шықтым.
Dialogue: 0,0:06:49.57,0:06:50.82,Default,,0,0,0,,696-санды тұтқын – Мұнда не болып жатыр өзі?
Dialogue: 0,0:06:51.57,0:06:55.12,Default,,0,0,0,,Ах, мен Хироми Масуокамын.
Dialogue: 0,0:06:55.87,0:07:00.29,Default,,0,0,0,,Марс Хироми
Dialogue: 0,0:07:00.50,0:07:04.29,Default,,0,0,0,,Хироми Масуока
Dialogue: 0,0:07:05.21,0:07:09.13,Default,,0,0,0,,Хироми Масуока
Dialogue: 0,0:07:09.97,0:07:12.43,Default,,0,0,0,,Масуока~
Dialogue: 0,0:07:12.55,0:07:15.39,Default,,0,0,0,,Хироми Масуока
Dialogue: 0,0:07:29.11,0:07:32.66,Default,,0,0,0,,Хироми Масуока
Dialogue: 0,0:07:34.20,0:07:35.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:36.70,0:07:39.70,Default,,0,0,0,,Эй, Танака-кун, бұл жақсы.
Dialogue: 0,0:07:40.08,0:07:43.42,Default,,0,0,0,,Қазіргі ән қалай аталады?
Dialogue: 0,0:07:43.83,0:07:46.42,Default,,0,0,0,,Бұл БЕКтің "FACE" деп аталатын әні.
Dialogue: 0,0:07:46.84,0:07:49.17,Default,,0,0,0,,Бұл таңқаларлық, Танака-кун.
Dialogue: 0,0:07:49.26,0:07:51.17,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:07:52.30,0:07:54.68,Default,,0,0,0,,Ах, гитара қауіпсіз сияқты.
Dialogue: 0,0:07:55.30,0:07:57.35,Default,,0,0,0,,(Коюки мен Масуоканың күлкісі)
Dialogue: 0,0:07:57.47,0:07:59.81,Default,,0,0,0,,А, онда келесі жолы үйретемін.
Dialogue: 0,0:07:59.93,0:08:01.68,Default,,0,0,0,,Ах! Өтінемін
Dialogue: 0,0:08:10.11,0:08:12.49,Default,,0,0,0,,Ақ сұңқар, маған осы уақытқа дейін қарыз бергені үшін...
Dialogue: 0,0:08:12.61,0:08:14.82,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:08:14.91,0:08:17.87,Default,,0,0,0,,Аа, егер оны қайта пайдаланғыңыз келсе, маған хабарлаңыз.
Dialogue: 0,0:08:17.99,0:08:19.66,Default,,0,0,0,,Мен оны сізге кез келген уақытта берем.
Dialogue: 0,0:08:19.79,0:08:21.08,Default,,0,0,0,,Иә
Dialogue: 0,0:08:22.00,0:08:23.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:22.00,0:08:23.50,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:08:26.00,0:08:27.88,Default,,0,0,0,,Хехехе… Біраз мақтанып қояйын
Dialogue: 0,0:08:30.46,0:08:33.93,Default,,0,0,0,,Ах~ Сәлеметсіз бе, сіз кез келген уақытта кете аласыз.
Dialogue: 0,0:08:34.05,0:08:36.30,Default,,0,0,0,,Момо-чан ше?
Dialogue: 0,0:08:36.51,0:08:40.52,Default,,0,0,0,,А, көремін, содан кейін кәдімгі иттің алдында.
Dialogue: 0,0:08:42.48,0:08:44.48,Default,,0,0,0,,Момоко-сенсей?
Dialogue: 0,0:08:47.65,0:08:49.57,Default,,0,0,0,,Шындығында, баяғыда-
Dialogue: 0,0:08:49.69,0:08:51.73,Default,,0,0,0,,Мен бір апта бойы пабта толық емес жұмыс күніммен жұмыс істедім.
Dialogue: 0,0:08:51.86,0:08:54.49,Default,,0,0,0,,Түлектердің тағылған айыптарымен анықталды.
Dialogue: 0,0:08:54.61,0:08:58.45,Default,,0,0,0,,Оны құпия ұстау қызметкерлер бөлмесінде қиындық туғызды.
Dialogue: 0,0:08:58.57,0:09:01.16,Default,,0,0,0,,Мен қатты күйзелдім, көп нәрсеге алаңдадым.
Dialogue: 0,0:09:01.24,0:09:05.00,Default,,0,0,0,,Мен де түрлі семинарларға қатыстым, кейде сондай...
Dialogue: 0,0:09:05.12,0:09:07.46,Default,,0,0,0,,Мен сіздермен кеңестім.
Dialogue: 0,0:09:07.58,0:09:10.67,Default,,0,0,0,,Мен басқаларға қарағанда ойын-сауық индустриясын жақсы түсінемін.
Dialogue: 0,0:09:10.75,0:09:12.88,Default,,0,0,0,,Аа, бәрінен де артық.
Dialogue: 0,0:09:13.01,0:09:15.17,Default,,0,0,0,,Сәлем! Тататата Цуцуцу
Dialogue: 0,0:09:15.47,0:09:18.55,Default,,0,0,0,,Момо-чан екеуміз әлі еркек пен әйелдің қарым-қатынасында емеспіз.
Dialogue: 0,0:09:18.68,0:09:21.22,Default,,0,0,0,,Сондықтан қажетсіз сөздерді айтпаңыз!
Dialogue: 0,0:09:21.35,0:09:22.77,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:23.35,0:09:25.98,Default,,0,0,0,,Сонда кездескенше! Коюки-кун
Dialogue: 0,0:09:26.64,0:09:29.19,Default,,0,0,0,,Кеничи Сайто 44 жаста
Dialogue: 0,0:09:29.40,0:09:32.48,Default,,0,0,0,,Сейшун Кайдо қазір орындалуда
Dialogue: 0,0:09:38.49,0:09:42.79,Default,,0,0,0,,Мен Масука мырзаны соңғы уақытта толық емес жұмыс уақытында көрмедім.
Dialogue: 0,0:09:43.29,0:09:47.16,Default,,0,0,0,,Мен дүкенге үлкен соққы әкелген қателік жасадым.
Dialogue: 0,0:09:47.29,0:09:49.92,Default,,0,0,0,,Мен жұмыстан шығарылдым.
Dialogue: 0,0:09:50.33,0:09:52.55,Default,,0,0,0,,Бірақ қазір мен жаңа клубқа қосылдым...
Dialogue: 0,0:09:52.67,0:09:54.13,Default,,0,0,0,,Бұл шынымен жанып тұр!
Dialogue: 0,0:09:54.26,0:09:55.76,Default,,0,0,0,,Иә... иә?
Dialogue: 0,0:09:56.51,0:09:58.38,Default,,0,0,0,,Олай болса! Хехе
Dialogue: 0,0:09:58.51,0:10:01.18,Default,,0,0,0,,(Масуоканың ызылдағаны)
Dialogue: 0,0:10:02.26,0:10:03.31,Default,,0,0,0,,Хун
Dialogue: 0,0:10:03.43,0:10:06.35,Default,,0,0,0,,1/2 сынып Хироми Масуока
Dialogue: 0,0:10:06.48,0:10:07.85,Default,,0,0,0,,Не, сен білесің бе?
Dialogue: 0,0:10:07.98,0:10:11.44,Default,,0,0,0,,Хехехехе, мен оны тексеріп қойғанмын.
Dialogue: 0,0:10:20.70,0:10:23.03,Default,,0,0,0,,О~
Dialogue: 0,0:10:23.12,0:10:26.75,Default,,0,0,0,,Ол орта мектепте оқып жүрген кезінде жақсы баға алды.
Dialogue: 0,0:10:26.87,0:10:28.29,Default,,0,0,0,,Я~
Dialogue: 0,0:10:28.41,0:10:32.08,Default,,0,0,0,,Масуока-сан, сен біздің концертке келесің бе?
Dialogue: 0,0:10:32.21,0:10:33.92,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:35.13,0:10:37.63,Default,,0,0,0,,Хироми, неге кішкене демалмайсың?
Dialogue: 0,0:10:37.76,0:10:41.72,Default,,0,0,0,,Сіз шөлдедіңіз бе? Иә (Масуока) Рахмет!
Dialogue: 0,0:10:41.84,0:10:43.85,Default,,0,0,0,,Жақсы! Мен сені кейін шақырамын
Dialogue: 0,0:10:43.97,0:10:44.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:48.27,0:10:49.81,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:11:04.41,0:11:05.83,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:10.33,0:11:11.67,Default,,0,0,0,,(Рюсукенің ағылшыншасы)
Dialogue: 0,0:11:11.79,0:11:13.79,Default,,0,0,0,,(Бектің жылағаны)
Dialogue: 0,0:11:14.42,0:11:21.38,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:11:25.47,0:11:26.35,Default,,0,0,0,,Сәлем
Dialogue: 0,0:11:26.47,0:11:27.89,Default,,0,0,0,,<Ах, Элвин-сан>
Dialogue: 0,0:11:28.02,0:11:30.27,Default,,0,0,0,,〈Біздің CD туралы не айтасыз?
Dialogue: 0,0:11:32.60,0:11:33.81,Default,,0,0,0,,Не? 〉
Dialogue: 0,0:11:49.45,0:11:50.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:29.58,0:12:32.87,Default,,0,0,0,,Үлкен аға! Чемпионды жеңіп алған ағама рахмет.
Dialogue: 0,0:12:33.37,0:12:36.04,Default,,0,0,0,,Мен енді жүре аламын!
Dialogue: 0,0:12:36.17,0:12:39.55,Default,,0,0,0,,Әй, сен ақымақсың.
Dialogue: 0,0:12:39.67,0:12:41.71,Default,,0,0,0,,Үлкен аға!! Уф
Dialogue: 0,0:12:41.84,0:12:43.63,Default,,0,0,0,,Үлкен аға!!
Dialogue: 0,0:13:02.57,0:13:05.70,Default,,0,0,0,,(Аспаздың есінеу)
Dialogue: 0,0:13:09.53,0:13:13.91,Default,,0,0,0,,Хмм, уау! Ача~
Dialogue: 0,0:13:14.83,0:13:16.83,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:13:17.58,0:13:19.08,Default,,0,0,0,,Иә
Dialogue: 0,0:13:19.21,0:13:20.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:21.13,0:13:22.59,Default,,0,0,0,,Ааах!
Dialogue: 0,0:13:22.80,0:13:25.01,Default,,0,0,0,,Соңында не?
Dialogue: 0,0:13:25.30,0:13:27.22,Default,,0,0,0,,Оны басқа жерде көрді, сондықтан ол сонда кетті.
Dialogue: 0,0:13:29.97,0:13:35.02,Default,,0,0,0,,(БЕК орындауы)
Dialogue: 0,0:13:47.57,0:13:49.37,Default,,0,0,0,,Сіз не істеп жатырсыз? Коюки
Dialogue: 0,0:13:50.45,0:13:52.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:54.04,0:13:56.21,Default,,0,0,0,,Ха...
Dialogue: 0,0:13:58.83,0:14:01.92,Default,,0,0,0,,Менің қарным ашты, ау
Dialogue: 0,0:14:02.04,0:14:03.92,Default,,0,0,0,,Эй, рамен жейміз де, үйге қайтайық.
Dialogue: 0,0:14:04.05,0:14:05.59,Default,,0,0,0,,Иә, жақсы
Dialogue: 0,0:14:05.71,0:14:07.68,Default,,0,0,0,,Цк, тағы рамен?
Dialogue: 0,0:14:19.81,0:14:21.23,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:21.52,0:14:22.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:22.44,0:14:24.36,Default,,0,0,0,,Күткеніңізге рахмет!
Dialogue: 0,0:14:24.86,0:14:27.11,Default,,0,0,0,,Рюсуке ше?
Dialogue: 0,0:14:27.32,0:14:30.32,Default,,0,0,0,,Менің бір ісім бар еді, сіз маған баруымды өтініп, билет бердіңіз.
Dialogue: 0,0:14:30.45,0:14:31.78,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:40.37,0:14:43.50,Default,,0,0,0,,(фильм аудиосы)
Dialogue: 0,0:15:03.61,0:15:05.98,Default,,0,0,0,,Бұл фильмді түсіну қиын...
Dialogue: 0,0:15:06.65,0:15:10.36,Default,,0,0,0,,Кейіпкерлер жанды болып, фильм аяқталғанда—
Dialogue: 0,0:15:10.49,0:15:14.66,Default,,0,0,0,,Мен олармен қоштасуға аздап қынжылдым.
Dialogue: 0,0:15:16.70,0:15:18.54,Default,,0,0,0,,Джим Уолш
Dialogue: 0,0:15:19.04,0:15:21.54,Default,,0,0,0,,Бұл режиссер данышпан.
Dialogue: 0,0:15:21.62,0:15:25.63,Default,,0,0,0,,Иә! Қызық болды, ұйқым мүлде келмеді.
Dialogue: 0,0:15:27.30,0:15:30.17,Default,,0,0,0,,Бұл фильм жақсы қабылданды және Дайбуридің гастрольдік фильмі...
Dialogue: 0,0:15:30.97,0:15:33.59,Default,,0,0,0,,Ол Жапония мен АҚШ-та бір уақытта шығарылады.
Dialogue: 0,0:15:33.72,0:15:36.14,Default,,0,0,0,,Ху~ Гастрольдік фильм
Dialogue: 0,0:15:37.56,0:15:38.97,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:44.10,0:15:47.69,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:15:47.82,0:15:49.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:55.07,0:15:56.41,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:56.78,0:15:59.20,Default,,0,0,0,,<Махо, сенбі күні боссың ба? 〉
Dialogue: 0,0:15:59.33,0:16:01.54,Default,,0,0,0,,<Бірлескен жұлдыздар Морита-кун және Эгучи-санмен...>
Dialogue: 0,0:16:01.66,0:16:03.25,Default,,0,0,0,,<Мен тамақ жеп жатырмын>
Dialogue: 0,0:16:03.33,0:16:04.79,Default,,0,0,0,,<Әй, жақсы>
Dialogue: 0,0:16:04.92,0:16:07.46,Default,,0,0,0,,<Бірақ сенбіде бұл мүмкін емес, өйткені БЕКтің жанды орындауы бар>
Dialogue: 0,0:16:08.38,0:16:10.71,Default,,0,0,0,,Меши Эгучи мырзамен~
Dialogue: 0,0:16:10.88,0:16:12.22,Default,,0,0,0,,А...
Dialogue: 0,0:16:12.34,0:16:13.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:14.43,0:16:16.47,Default,,0,0,0,,<Мені қайта шақыр>
Dialogue: 0,0:16:16.72,0:16:18.01,Default,,0,0,0,,〈Жарайды! 〉
Dialogue: 0,0:16:21.23,0:16:23.52,Default,,0,0,0,,Жүр, тамақ ішейік.
Dialogue: 0,0:16:23.64,0:16:24.73,Default,,0,0,0,,О
Dialogue: 0,0:16:31.90,0:16:33.99,Default,,0,0,0,,Иә, шынымен!?
Dialogue: 0,0:16:34.11,0:16:37.24,Default,,0,0,0,,Аа, жақсы сатылып жатқан сияқты.
Dialogue: 0,0:16:37.32,0:16:39.62,Default,,0,0,0,,Біздің ән (Чиба) Ммм...
Dialogue: 0,0:16:39.74,0:16:41.83,Default,,0,0,0,,Уууу!
Dialogue: 0,0:16:41.91,0:16:44.83,Default,,0,0,0,,Бұл жапон топтары үшін әдеттен тыс сияқты.
Dialogue: 0,0:16:44.96,0:16:46.79,Default,,0,0,0,,Бұл президент – орындаушы.
Dialogue: 0,0:16:46.92,0:16:49.92,Default,,0,0,0,,Мм, бұл Әлпен мырза ма?
Dialogue: 0,0:16:50.42,0:16:51.38,Default,,0,0,0,,Увааах! Уф!
Dialogue: 0,0:16:51.51,0:16:52.76,Default,,0,0,0,,Ах~
Dialogue: 0,0:16:52.88,0:16:53.92,Default,,0,0,0,,Увааах! Уф!
Dialogue: 0,0:16:54.05,0:16:56.72,Default,,0,0,0,,Роялти шарты
Dialogue: 0,0:16:57.22,0:16:58.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:58.60,0:17:00.06,Default,,0,0,0,,Хмм!
Dialogue: 0,0:17:00.68,0:17:03.31,Default,,0,0,0,,Не? Қанша дана сатылса да солай ма?
Dialogue: 0,0:17:03.43,0:17:03.93,Default,,0,0,0,,Онда қанша сатса да (Рюсуке), айт.
Dialogue: 0,0:17:03.93,0:17:05.52,Default,,0,0,0,,Олай болса, қанша сатса да (Рюсуке), айт.
Dialogue: 0,0:17:03.93,0:17:05.52,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:17:05.64,0:17:07.35,Default,,0,0,0,,Уау, эй, эй, эй... Уау!
Dialogue: 0,0:17:07.35,0:17:08.40,Default,,0,0,0,,Уау, эй, эй, эй... Уау!
Dialogue: 0,0:17:07.35,0:17:08.40,Default,,0,0,0,,(тоғанға құлау дыбысы)
Dialogue: 0,0:17:08.40,0:17:08.52,Default,,0,0,0,,(Тоғанға құлау дыбысы)
Dialogue: 0,0:17:08.52,0:17:09.77,Default,,0,0,0,,(Тоғанға құлау дыбысы)
Dialogue: 0,0:17:08.52,0:17:09.77,Default,,0,0,0,,Хахахахаха~
Dialogue: 0,0:17:09.77,0:17:10.40,Default,,0,0,0,,Хахахахаха~
Dialogue: 0,0:17:10.61,0:17:16.61,Default,,0,0,0,,(BECK өнімділігі)
Dialogue: 0,0:17:46.77,0:17:49.69,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:18:08.42,0:18:10.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:12.63,0:18:13.96,Default,,0,0,0,,Тс!
Dialogue: 0,0:18:29.56,0:18:32.73,Default,,0,0,0,,Менің құлағым әлі сыңғырлап тұр, бірақ керемет болды!
Dialogue: 0,0:18:32.86,0:18:36.28,Default,,0,0,0,,Шынымен бе? Мен бақыттымын. Эй, Саку?
Dialogue: 0,0:18:36.40,0:18:37.65,Default,,0,0,0,,Шынымен де рас
Dialogue: 0,0:18:37.78,0:18:40.24,Default,,0,0,0,,Бұл өте нашар, солай емес пе?
Dialogue: 0,0:18:40.36,0:18:42.95,Default,,0,0,0,,Клиенттер өте көп!
Dialogue: 0,0:18:43.49,0:18:46.50,Default,,0,0,0,,Тұтынушылар саны біртіндеп артып келеді.
Dialogue: 0,0:18:47.25,0:18:49.00,Default,,0,0,0,,Масуока мырза, қайта келіңіз.
Dialogue: 0,0:18:49.12,0:18:50.96,Default,,0,0,0,,Иә! (Махо) Хмф
Dialogue: 0,0:18:54.21,0:18:56.67,Default,,0,0,0,,БЕК Келесі жолы олар мұны маркеде жасайтын сияқты.
Dialogue: 0,0:18:56.80,0:18:58.59,Default,,0,0,0,,Уау, бұл таңқаларлық.
Dialogue: 0,0:18:58.67,0:19:01.05,Default,,0,0,0,,Сіз барған сайын көтеріліп жатырсыз.
Dialogue: 0,0:19:02.14,0:19:04.93,Default,,0,0,0,,Әй, сен қазіргі Морозуми Йошитоға ұқсамайсың ба?
Dialogue: 0,0:19:05.06,0:19:06.77,Default,,0,0,0,,Иә? Өтірік? Шынымен бе?
Dialogue: 0,0:19:06.89,0:19:09.27,Default,,0,0,0,,Мұндай адам мұндай жерде болмайды.
Dialogue: 0,0:19:10.56,0:19:14.98,Default,,0,0,0,,Хм, бұл жай ғана белгісіз әуесқой топ емес пе?
Dialogue: 0,0:19:18.49,0:19:21.57,Default,,0,0,0,,(Бектің жылағаны)
Dialogue: 0,0:19:23.45,0:19:25.41,Default,,0,0,0,,Мен президенттен дауыстық хат қалдырдым.
Dialogue: 0,0:19:25.41,0:19:26.03,Default,,0,0,0,,Мен президенттен дауыстық хат қалдырдым.
Dialogue: 0,0:19:25.41,0:19:26.03,Default,,0,0,0,,(Чиба қорылдау)
Dialogue: 0,0:19:26.03,0:19:26.16,Default,,0,0,0,,(Чиба қорылдау)
Dialogue: 0,0:19:26.16,0:19:29.62,Default,,0,0,0,,(Чиба қорылдау)
Dialogue: 0,0:19:26.16,0:19:29.62,Default,,0,0,0,,BECK компакт-дискі қосымша шығарылады.
Dialogue: 0,0:19:32.58,0:19:34.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:39.26,0:19:40.97,Default,,0,0,0,,Иә
Dialogue: 0,0:19:41.55,0:19:44.76,Default,,0,0,0,,Біздің музыка Америкада ойналып жатыр ма?
Dialogue: 0,0:19:45.10,0:19:46.39,Default,,0,0,0,,О
Dialogue: 0,0:19:47.31,0:19:49.10,Default,,0,0,0,,Эй (Рюсуке) Ан?
Dialogue: 0,0:19:49.22,0:19:51.44,Default,,0,0,0,,Маған тезірек айтып бере аласыз ба?
Dialogue: 0,0:19:55.23,0:19:56.98,Default,,0,0,0,,Оны қайдан алдың?
Dialogue: 0,0:19:59.07,0:20:00.49,Default,,0,0,0,,Иә
Dialogue: 0,0:20:00.57,0:20:02.53,Default,,0,0,0,,Мен оны ұрлап алдым.
Dialogue: 0,0:20:05.20,0:20:06.49,Default,,0,0,0,,(Көлік құлпы ашылған дыбыс)
Dialogue: 0,0:20:06.78,0:20:08.66,Default,,0,0,0,,Көлікті бұзу?
Dialogue: 0,0:20:11.33,0:20:12.71,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:20:14.96,0:20:18.30,Default,,0,0,0,,Менің бос уақытым болды, сондықтан мен Эддимен көп араластым.
Dialogue: 0,0:20:18.50,0:20:21.63,Default,,0,0,0,,Мен сол ессіз көлікті соқтым.
Dialogue: 0,0:20:23.72,0:20:24.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:25.39,0:20:27.72,Default,,0,0,0,,Мені одан да таң қалдырған нәрсе...
Dialogue: 0,0:20:29.81,0:20:31.43,Default,,0,0,0,,<Бұл Люсиль>
Dialogue: 0,0:20:31.56,0:20:32.64,Default,,0,0,0,,<Не? 〉
Dialogue: 0,0:20:32.77,0:20:34.81,Default,,0,0,0,,〈Бұл көлік қауіпті〉
Dialogue: 0,0:20:35.06,0:20:37.40,Default,,0,0,0,,<Бұл жақсы белгілі емес...>
Dialogue: 0,0:20:37.52,0:20:38.65,Default,,0,0,0,,〈Мен Эрик Клэптонды да құрметтеймін〉
Dialogue: 0,0:20:38.73,0:20:40.48,Default,,0,0,0,,〈Аңызға айналған блюз гитаристі〉
Dialogue: 0,0:20:40.61,0:20:42.53,Default,,0,0,0,,<Бұл Сонни Бой Уотерстің гитарасы>
Dialogue: 0,0:20:42.65,0:20:43.82,Default,,0,0,0,,<Күншуақ бала>
Dialogue: 0,0:20:43.95,0:20:47.20,Default,,0,0,0,,<Сериялық нөмірі 8 3001>
Dialogue: 0,0:20:47.62,0:20:48.83,Default,,0,0,0,,〈Күмән жоқ! 〉
Dialogue: 0,0:20:48.95,0:20:50.54,Default,,0,0,0,,<Эди, тез қашайық>
Dialogue: 0,0:20:50.66,0:20:53.00,Default,,0,0,0,,〈Күншуақ бала мен түнгі клубтағы адам〉
Dialogue: 0,0:20:53.12,0:20:55.00,Default,,0,0,0,,<Олар Люсиль есімді әйел үшін төбелесті>
Dialogue: 0,0:20:55.12,0:20:56.29,Default,,0,0,0,,〈Сосын ашуланған адам келесі күні қайтып келді〉
Dialogue: 0,0:20:56.38,0:20:58.00,Default,,0,0,0,,〈Тікелей орындау кезінде Sunny Boy атып өлтірілді〉
Dialogue: 0,0:20:58.13,0:20:59.46,Default,,0,0,0,,<Ойын кезінде>
Dialogue: 0,0:20:59.59,0:21:00.92,Default,,0,0,0,,〈Осы оқиғадан бері〉
Dialogue: 0,0:21:01.05,0:21:03.34,Default,,0,0,0,,<Бұл гитара Люсиль деп аталады>
Dialogue: 0,0:21:03.72,0:21:05.68,Default,,0,0,0,,<Сіз байсалдысыз ба?>
Dialogue: 0,0:21:07.26,0:21:09.26,Default,,0,0,0,,<Қашайық>
Dialogue: 0,0:21:09.39,0:21:10.51,Default,,0,0,0,,<Тез кел>
Dialogue: 0,0:21:12.02,0:21:13.81,Default,,0,0,0,,Сәлем, Рэй!
Dialogue: 0,0:21:15.73,0:21:17.56,Default,,0,0,0,,<Маған бұл гитара біртүрлі ұнайды>
Dialogue: 0,0:21:17.69,0:21:18.86,Default,,0,0,0,,<Не? 〉
Dialogue: 0,0:21:20.57,0:21:23.74,Default,,0,0,0,,<Шуақты бала туралы аңыз мұрагер боламын>
Dialogue: 0,0:21:26.28,0:21:27.36,Default,,0,0,0,,(күшік үреді)
Dialogue: 0,0:21:27.36,0:21:28.45,Default,,0,0,0,,(күшік үреді)
Dialogue: 0,0:21:27.36,0:21:28.45,Default,,0,0,0,,Иә? (Рюсуке) А?
Dialogue: 0,0:21:28.45,0:21:29.32,Default,,0,0,0,,(күшік үреді)
Dialogue: 0,0:21:30.37,0:21:32.62,Default,,0,0,0,,Сол кезде мен оны кездестірдім.
Dialogue: 0,0:21:36.71,0:21:39.33,Default,,0,0,0,,Ммм
Dialogue: 0,0:21:42.34,0:21:44.30,Default,,0,0,0,,Кейін білдім.
Dialogue: 0,0:21:44.38,0:21:47.22,Default,,0,0,0,,Бұл өте қауіпті адамның көлігі.
Dialogue: 0,0:21:47.34,0:21:52.10,Default,,0,0,0,,Енді ол Бек пен Люсильді іздеп жатыр.
Dialogue: 0,0:21:53.10,0:21:56.39,Default,,0,0,0,,(Бектің жылағаны)
Dialogue: 0,0:22:24.00,0:22:26.01,Default,,0,0,0,,Эй, бұл топ. Үзіліс аяқталды.
Dialogue: 0,0:22:26.01,0:22:27.26,Default,,0,0,0,,Эй, бұл топ. Үзіліс аяқталды.
Dialogue: 0,0:22:26.01,0:22:27.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:27.26,0:22:28.09,Default,,0,0,0,,Эй, бұл топ. Үзіліс аяқталды.
Dialogue: 0,0:22:28.55,0:22:30.97,Default,,0,0,0,,Иә! Мен қазір барамын
Dialogue: 0,0:22:36.85,0:22:42.81,Default,,0,0,0,,♪～
