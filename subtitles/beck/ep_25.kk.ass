Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.37,0:00:07.00,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.71,0:01:36.97,Default,,0,0,0,,～♪
Dialogue: 0,0:01:38.18,0:01:43.60,Default,,0,0,0,,(Коюкидің ән айту дауысы)
Dialogue: 0,0:02:11.63,0:02:14.59,Default,,0,0,0,,<Осылай болады деп күткен жоқпын>
Dialogue: 0,0:02:14.96,0:02:16.46,Default,,0,0,0,,<Бұл Малкольм кінәлі>
Dialogue: 0,0:02:16.59,0:02:17.92,Default,,0,0,0,,<Ньюарктың жас діни қызметкері! 〉
Dialogue: 0,0:02:18.05,0:02:21.55,Default,,0,0,0,,〈Ол рұқсатсыз қонақүйге қайтып кетті!!〉
Dialogue: 0,0:02:22.60,0:02:25.14,Default,,0,0,0,,<Моңғол шабақтары отряды—>
Dialogue: 0,0:02:25.27,0:02:27.56,Default,,0,0,0,,〈Бұл дүниеде оларды сыпырып тастауға жеткілікті адамдар бар〉
Dialogue: 0,0:02:27.68,0:02:30.40,Default,,0,0,0,,〈Бұл ақша таппайтын тағы бір қоқыс жинағы.〉
Dialogue: 0,0:02:31.73,0:02:33.52,Default,,0,0,0,,<Дэвис ағайдың хаты—>
Dialogue: 0,0:02:33.65,0:02:35.15,Default,,0,0,0,,〈Мен жай ғана қарап шықтым〉
Dialogue: 0,0:02:35.28,0:02:38.90,Default,,0,0,0,,<“Күншуақ бала туралы аңыз мұрагері Рюсуке Минамиге”>
Dialogue: 0,0:02:39.03,0:02:41.99,Default,,0,0,0,,<Бұл жазылған>
Dialogue: 0,0:02:42.74,0:02:44.91,Default,,0,0,0,,〈Ағам бәріне солай дейді〉
Dialogue: 0,0:02:45.03,0:02:46.20,Default,,0,0,0,,〈Хаа〉
Dialogue: 0,0:02:49.83,0:02:54.42,Default,,0,0,0,,<Бірақ Люсильді беремін деген адам...>
Dialogue: 0,0:02:54.54,0:02:55.96,Default,,0,0,0,,<Бұл менің бірінші рет>
Dialogue: 0,0:03:39.09,0:03:41.59,Default,,0,0,0,,〈Аудиторияны жинау〉
Dialogue: 0,0:03:42.84,0:03:44.93,Default,,0,0,0,,〈Бастық, анау бала...〉
Dialogue: 0,0:04:05.20,0:04:06.12,Default,,0,0,0,,(Коюкидің ән айту дауысы)
Dialogue: 0,0:04:06.12,0:04:07.99,Default,,0,0,0,,(Коюкидің ән айту дауысы)
Dialogue: 0,0:04:06.12,0:04:07.99,Default,,0,0,0,,О... не болды? Сіз әнді білесіз бе?
Dialogue: 0,0:04:07.99,0:04:08.70,Default,,0,0,0,,А... не болды? Сіз әнді білесіз бе?
Dialogue: 0,0:04:08.83,0:04:10.20,Default,,0,0,0,,Мен оны бірінші рет естідім...
Dialogue: 0,0:04:10.50,0:04:12.46,Default,,0,0,0,,Бұл өте жақсы ән.
Dialogue: 0,0:04:12.58,0:04:13.83,Default,,0,0,0,,О
Dialogue: 0,0:04:16.83,0:04:20.34,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:04:24.97,0:04:26.72,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:04:26.80,0:04:28.22,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:04:29.14,0:04:30.22,Default,,0,0,0,,Уау
Dialogue: 0,0:04:30.31,0:04:32.23,Default,,0,0,0,,Ууууууууууууу...
Dialogue: 0,0:04:32.31,0:04:34.81,Default,,0,0,0,,Коюки-кун... Саку-чан...
Dialogue: 0,0:04:47.45,0:04:49.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:52.08,0:04:58.08,Default,,0,0,0,,Охохо!
Dialogue: 0,0:05:11.89,0:05:15.98,Default,,0,0,0,,Жақсы көр! Еңсеріңіз!
Dialogue: 0,0:05:20.82,0:05:22.78,Default,,0,0,0,,Эй, сен мені естисің бе?
Dialogue: 0,0:05:22.90,0:05:25.24,Default,,0,0,0,,Ол бізді шындап шақырып жатыр.
Dialogue: 0,0:05:25.95,0:05:28.24,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:05:28.32,0:05:30.74,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:30.83,0:05:34.37,Default,,0,0,0,,Соңында бұл тамаша жанды шоу болды.
Dialogue: 0,0:05:34.87,0:05:37.25,Default,,0,0,0,,Бірақ Коюки керемет
Dialogue: 0,0:05:37.37,0:05:40.13,Default,,0,0,0,,Сіз сахнада жалғыз боласыз.
Dialogue: 0,0:05:40.63,0:05:43.92,Default,,0,0,0,,Менде мұндай батылдық болмады...
Dialogue: 0,0:05:44.05,0:05:46.38,Default,,0,0,0,,Барлығы... барлығы келді...
Dialogue: 0,0:05:46.51,0:05:47.80,Default,,0,0,0,,Сондықтан мен мұны істей алдым.
Dialogue: 0,0:05:47.93,0:05:52.01,Default,,0,0,0,,Мен өз бетімше мұнша көңіл көтере алмас едім деп ойлаймын.
Dialogue: 0,0:05:52.35,0:05:54.52,Default,,0,0,0,,Олай болса, байқауға барайық!
Dialogue: 0,0:05:54.64,0:05:55.98,Default,,0,0,0,,Амансың ба? Коюки
Dialogue: 0,0:05:56.10,0:05:57.19,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:57.56,0:05:59.23,Default,,0,0,0,,3 минут Үзіліс жасай аламын ба?
Dialogue: 0,0:05:59.35,0:06:01.77,Default,,0,0,0,,Сәлем! Сіз аудиторияңызды күтесіз бе?
Dialogue: 0,0:06:01.90,0:06:03.02,Default,,0,0,0,,Хамф!
Dialogue: 0,0:06:04.36,0:06:06.57,Default,,0,0,0,,Коюки мұны істей алмайды. Оған демалуға рұқсат етіңіз.
Dialogue: 0,0:06:06.69,0:06:08.28,Default,,0,0,0,,Сәлем, Рюсуке...
Dialogue: 0,0:06:09.24,0:06:10.66,Default,,0,0,0,,Мен жоғалып кеттім
Dialogue: 0,0:06:14.20,0:06:15.16,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:15.29,0:06:18.66,Default,,0,0,0,,Мен бұл жолы тұрақты топ деп ойладым.
Dialogue: 0,0:06:20.58,0:06:21.54,Default,,0,0,0,,Рюсуке-кун~!
Dialogue: 0,0:06:21.63,0:06:23.29,Default,,0,0,0,,Хаха...
Dialogue: 0,0:06:23.42,0:06:25.55,Default,,0,0,0,,О, не болды? Коюки
Dialogue: 0,0:06:25.63,0:06:27.47,Default,,0,0,0,,Ха ха ха... Нуах!
Dialogue: 0,0:06:27.59,0:06:30.68,Default,,0,0,0,,Сәлем! Қараңызшы, бұл қауіпті емес пе?
Dialogue: 0,0:06:30.80,0:06:33.35,Default,,0,0,0,,Шаршадың, енді қолыңнан келмейді.
Dialogue: 0,0:06:33.47,0:06:34.60,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:06:34.72,0:06:36.35,Default,,0,0,0,,Мен мұны айтқым келді
Dialogue: 0,0:06:37.31,0:06:39.19,Default,,0,0,0,,Я...
Dialogue: 0,0:06:39.31,0:06:41.56,Default,,0,0,0,,Рахмет Рюсуке
Dialogue: 0,0:06:45.02,0:06:47.15,Default,,0,0,0,,Көріскенше Коюки
Dialogue: 0,0:06:49.11,0:06:52.32,Default,,0,0,0,,О, отшашу! Бұл шағады!
Dialogue: 0,0:06:52.74,0:06:53.83,Default,,0,0,0,,Сәлем? Эйджи-кун
Dialogue: 0,0:06:53.95,0:06:55.12,Default,,0,0,0,,Хаха...
Dialogue: 0,0:06:55.24,0:06:56.29,Default,,0,0,0,,(Бір нәрсені соққан дыбыс)
Dialogue: 0,0:06:57.25,0:06:59.29,Default,,0,0,0,,Йошито, сен...
Dialogue: 0,0:06:59.91,0:07:02.13,Default,,0,0,0,,Махо көрінбейді.
Dialogue: 0,0:07:02.67,0:07:04.34,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:07:04.46,0:07:07.00,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:07:07.13,0:07:10.09,Default,,0,0,0,,Негізгі кезең 8900 адам
Dialogue: 0,0:07:10.22,0:07:13.97,Default,,0,0,0,,Екінші кезең 980 адам
Dialogue: 0,0:07:14.35,0:07:17.85,Default,,0,0,0,,және үшінші кезең 8100 адам
Dialogue: 0,0:07:18.10,0:07:20.77,Default,,0,0,0,,Көптеген тұтынушылар әлі қозғалыста
Dialogue: 0,0:07:21.73,0:07:23.69,Default,,0,0,0,,Мен сенбеймін...
Dialogue: 0,0:07:23.81,0:07:27.44,Default,,0,0,0,,Егер бәрі осылай жалғаса берсе, біз үшінші кезеңде үлкен жеңіске жетеміз.
Dialogue: 0,0:07:27.57,0:07:30.53,Default,,0,0,0,,Негізгі кезеңдегі көрермендер саны азайып келеді.
Dialogue: 0,0:07:30.65,0:07:34.37,Default,,0,0,0,,Үшінші кезеңге бет алған адамдардың легі ешқашан тоқтамайды.
Dialogue: 0,0:07:35.03,0:07:36.87,Default,,0,0,0,,Сол үшінші кезең...
Dialogue: 0,0:07:36.99,0:07:38.41,Default,,0,0,0,,Бұл үлкен тәртіпсіздік.
Dialogue: 0,0:07:38.54,0:07:40.75,Default,,0,0,0,,Адамдардың саны айтарлықтай өсті, бірақ...
Dialogue: 0,0:07:40.87,0:07:43.88,Default,,0,0,0,,BECK мүшелері анкорр жасамайтын сияқты.
Dialogue: 0,0:07:44.13,0:07:45.38,Default,,0,0,0,,Не? Неліктен?
Dialogue: 0,0:07:45.75,0:07:47.30,Default,,0,0,0,,О... мынау... Уау!
Dialogue: 0,0:07:47.42,0:07:48.38,Default,,0,0,0,,Жақсы көр!
Dialogue: 0,0:07:48.96,0:07:51.42,Default,,0,0,0,,БЕК! БЕК!
Dialogue: 0,0:07:51.55,0:07:53.97,Default,,0,0,0,,Шық! (Ер тұтынушы 1) Маған тыңдауға рұқсат етіңіз!
Dialogue: 0,0:07:54.09,0:07:55.80,Default,,0,0,0,,Жақсы көр!
Dialogue: 0,0:07:55.93,0:07:58.85,Default,,0,0,0,,Жақсы көр! Еңсеріңіз!
Dialogue: 0,0:08:00.89,0:08:03.44,Default,,0,0,0,,А? Бұл не? (Әйел тұтынушы 1) Uso~
Dialogue: 0,0:08:05.02,0:08:07.48,Default,,0,0,0,,Әй, БЕКтің вокалы!
Dialogue: 0,0:08:08.07,0:08:08.90,Default,,0,0,0,,Хехе
Dialogue: 0,0:08:09.03,0:08:10.44,Default,,0,0,0,,А, мен қашып кеттім!
Dialogue: 0,0:08:11.11,0:08:12.45,Default,,0,0,0,,Эй, күт! (Әйел тұтынушы 2) Күте тұрыңыз!
Dialogue: 0,0:08:12.90,0:08:14.78,Default,,0,0,0,,Эй, күте тұрыңыз! (Әйел тұтынушы 2) Сәлем!
Dialogue: 0,0:08:14.91,0:08:16.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:18.45,0:08:21.00,Default,,0,0,0,,Махо! (Минами Махо) Хехе, кеттік!
Dialogue: 0,0:08:21.12,0:08:22.21,Default,,0,0,0,,Махо!
Dialogue: 0,0:08:23.37,0:08:24.71,Default,,0,0,0,,Уф! (Махо) Коюки!
Dialogue: 0,0:08:24.79,0:08:26.08,Default,,0,0,0,,Махо!
Dialogue: 0,0:08:26.42,0:08:28.29,Default,,0,0,0,,Менің артымнан ешкім жүре алмайды.
Dialogue: 0,0:08:28.42,0:08:29.67,Default,,0,0,0,,Иә
Dialogue: 0,0:08:30.09,0:08:32.51,Default,,0,0,0,,Коюки, сен тым жылдамсың.
Dialogue: 0,0:08:37.14,0:08:38.80,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:08:39.89,0:08:41.27,Default,,0,0,0,,Иә
Dialogue: 0,0:08:41.39,0:08:43.73,Default,,0,0,0,,Өйткені Коюки...
Dialogue: 0,0:08:43.81,0:08:44.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:46.69,0:08:48.11,Default,,0,0,0,,Коюки…
Dialogue: 0,0:08:49.40,0:08:52.57,Default,,0,0,0,,Коюки Бұл тамаша жанды шоу болды.
Dialogue: 0,0:08:52.69,0:08:55.15,Default,,0,0,0,,Маған қатты әсер қалдырды.
Dialogue: 0,0:08:55.45,0:08:58.62,Default,,0,0,0,,Коюки өте керемет.
Dialogue: 0,0:09:08.13,0:09:10.63,Default,,0,0,0,,Бұл соңғы тікелей шоу.
Dialogue: 0,0:09:10.92,0:09:11.96,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:09:12.09,0:09:13.26,Default,,0,0,0,,О
Dialogue: 0,0:09:16.05,0:09:17.55,Default,,0,0,0,,Келесі күні сахнада
Dialogue: 0,0:09:17.68,0:09:20.93,Default,,0,0,0,,Тікелей эфирде көп шу болды.
Dialogue: 0,0:09:35.32,0:09:38.07,Default,,0,0,0,,Эй, Коюки, тезірек!
Dialogue: 0,0:09:38.20,0:09:39.03,Default,,0,0,0,,Иә
Dialogue: 0,0:09:40.45,0:09:41.62,Default,,0,0,0,,Чиба ше?
Dialogue: 0,0:09:41.74,0:09:44.16,Default,,0,0,0,,Ол үйге пойызбен бара жатыр.
Dialogue: 0,0:09:44.29,0:09:45.20,Default,,0,0,0,,Я~
Dialogue: 0,0:09:45.33,0:09:47.62,Default,,0,0,0,,Ол жалғыз қалғысы келетінін айтады.
Dialogue: 0,0:09:48.58,0:09:50.63,Default,,0,0,0,,Кешегі тікелей эфир —
Dialogue: 0,0:09:50.75,0:09:53.05,Default,,0,0,0,,BECK тобы керемет болды.
Dialogue: 0,0:09:53.17,0:09:54.01,Default,,0,0,0,,Я~
Dialogue: 0,0:09:54.13,0:09:55.84,Default,,0,0,0,,Мен оны көргім келді~ Керемет! иә?
Dialogue: 0,0:09:55.97,0:09:57.68,Default,,0,0,0,,(Әйел тұтынушылардың күлкісі)
Dialogue: 0,0:09:57.80,0:09:58.76,Default,,0,0,0,,Коюки?
Dialogue: 0,0:09:58.88,0:10:00.93,Default,,0,0,0,,Ах! Кешіріңіз, кешіріңіз!
Dialogue: 0,0:10:02.60,0:10:04.27,Default,,0,0,0,,Тіпті ертең, тіпті одан кейінгі күні —
Dialogue: 0,0:10:04.39,0:10:06.98,Default,,0,0,0,,Күнделікті өмір бірқалыпты өтеді.
Dialogue: 0,0:10:08.23,0:10:11.19,Default,,0,0,0,,БЕК не болғанымен...
Dialogue: 0,0:10:14.32,0:10:16.11,Default,,0,0,0,,Саку Мынаны қара!
Dialogue: 0,0:10:16.24,0:10:18.65,Default,,0,0,0,,Уау! Бұл керемет!
Dialogue: 0,0:10:19.07,0:10:20.16,Default,,0,0,0,,Хехе...
Dialogue: 0,0:10:20.28,0:10:23.58,Default,,0,0,0,,Сол тікелей эфирден бері бір жарым ай өтті...
Dialogue: 0,0:10:23.70,0:10:25.70,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:10:29.08,0:10:31.21,Default,,0,0,0,,Юкио, қоңырау шал!
Dialogue: 0,0:10:31.33,0:10:32.50,Default,,0,0,0,,Кім?
Dialogue: 0,0:10:32.63,0:10:34.50,Default,,0,0,0,,Сато есімді әйел!
Dialogue: 0,0:10:34.63,0:10:35.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:35.59,0:10:37.55,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:10:37.67,0:10:39.38,Default,,0,0,0,,Міне...
Dialogue: 0,0:10:40.38,0:10:41.43,Default,,0,0,0,,Коюки-кун?
Dialogue: 0,0:10:41.55,0:10:43.93,Default,,0,0,0,,Ертең түске жақын, уақытың бар ма?
Dialogue: 0,0:10:44.06,0:10:45.43,Default,,0,0,0,,Не? ертең?
Dialogue: 0,0:10:45.56,0:10:48.48,Default,,0,0,0,,Сағат 13.00-де вокзал алдындағы ит тұрған жерде.
Dialogue: 0,0:10:49.56,0:10:52.77,Default,,0,0,0,,БЕКтің жанды орындауы қазірдің өзінде аңызға айналған.
Dialogue: 0,0:10:53.15,0:10:54.36,Default,,0,0,0,,Күрсініп... Ах, журналда...
Dialogue: 0,0:10:54.48,0:10:56.61,Default,,0,0,0,,Көп нәрсе айтылды...
Dialogue: 0,0:10:56.98,0:11:00.61,Default,,0,0,0,,Осынша шатасу кезінде нақты санды алу мүмкін емес.
Dialogue: 0,0:11:00.74,0:11:03.03,Default,,0,0,0,,Неліктен бүгін мен?
Dialogue: 0,0:11:03.66,0:11:06.66,Default,,0,0,0,,Сізбен танысқысы келетін біреу бар, хехе...
Dialogue: 0,0:11:07.08,0:11:08.83,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:11:08.95,0:11:11.37,Default,,0,0,0,,Таң қаласың, хехе...
Dialogue: 0,0:11:12.21,0:11:13.54,Default,,0,0,0,,<Қош келдіңіз Юкио>
Dialogue: 0,0:11:13.67,0:11:16.17,Default,,0,0,0,,〈Енді негізгі тақырыпқа көшейік〉
Dialogue: 0,0:11:16.30,0:11:19.59,Default,,0,0,0,,〈Мен сіздің жеке дебютіңізді Америка Құрама Штаттарында жасағым келеді〉
Dialogue: 0,0:11:19.72,0:11:21.47,Default,,0,0,0,,Е... бұл...
Dialogue: 0,0:11:21.59,0:11:24.22,Default,,0,0,0,,Ол Леон Сайкс мырза.
Dialogue: 0,0:11:24.35,0:11:25.30,Default,,0,0,0,,Коюки-кун—
Dialogue: 0,0:11:25.43,0:11:28.22,Default,,0,0,0,,Ол Америка Құрама Штаттарында жеке дебют жасағысы келеді.
Dialogue: 0,0:11:58.30,0:12:00.01,Default,,0,0,0,,Бұл жақсы гитара.
Dialogue: 0,0:12:01.26,0:12:02.88,Default,,0,0,0,,<Қорытындыға асығудың қажеті жоқ>
Dialogue: 0,0:12:03.01,0:12:04.30,Default,,0,0,0,,〈Тамаша! 〉
Dialogue: 0,0:12:04.89,0:12:06.51,Default,,0,0,0,,<Бұдан былай талай рет кездесеміз...>
Dialogue: 0,0:12:06.64,0:12:08.47,Default,,0,0,0,,<Осы жобаны талқылайық>
Dialogue: 0,0:12:09.39,0:12:11.27,Default,,0,0,0,,〈Өткен жылғы RJ белгісінен〉
Dialogue: 0,0:12:11.39,0:12:13.14,Default,,0,0,0,,〈8 алтын диск шығарылды〉
Dialogue: 0,0:12:14.02,0:12:15.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:15.40,0:12:18.57,Default,,0,0,0,,Май және Джимми және Малколм үшін Қауіпті Жан!
Dialogue: 0,0:12:18.69,0:12:21.82,Default,,0,0,0,,Дәл қазір диаграммаларда толқын жасап жатқан адамдар ғана емес!
Dialogue: 0,0:12:21.94,0:12:23.45,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:23.57,0:12:25.87,Default,,0,0,0,,Бұл оқиғаны қабылдауға болмайды.
Dialogue: 0,0:12:25.99,0:12:27.87,Default,,0,0,0,,Гитараны да қайтарып беремін.
Dialogue: 0,0:12:27.99,0:12:28.87,Default,,0,0,0,,Не?
Dialogue: 0,0:12:28.95,0:12:30.87,Default,,0,0,0,,Эй... Эй, Коюки-кун!
Dialogue: 0,0:12:31.16,0:12:33.79,Default,,0,0,0,,<Бәрібір, мен сізге қайта қоңырау шаламын>
Dialogue: 0,0:12:33.91,0:12:34.75,Default,,0,0,0,,Коюки-кун!
Dialogue: 0,0:12:34.87,0:12:36.96,Default,,0,0,0,,<Бастық! Жарайды ма? 〉
Dialogue: 0,0:12:38.09,0:12:40.21,Default,,0,0,0,,Әй, түсіндің бе?
Dialogue: 0,0:12:40.34,0:12:41.30,Default,,0,0,0,,Ә? Не айтпақшысың?
Dialogue: 0,0:12:41.42,0:12:44.26,Default,,0,0,0,,Қазірдің өзінде! Мұндай дәмді үлкен мүмкіндік.
Dialogue: 0,0:12:44.38,0:12:46.14,Default,,0,0,0,,Бұл өте жиі бола бермейді!
Dialogue: 0,0:12:46.26,0:12:48.43,Default,,0,0,0,,Шынымды айтсам!
Dialogue: 0,0:13:00.27,0:13:02.32,Default,,0,0,0,,Рюсуке... сен...
Dialogue: 0,0:13:06.36,0:13:09.12,Default,,0,0,0,,<Не? Рюсуке Минами жоғалып кетті ме? 〉
Dialogue: 0,0:13:09.24,0:13:11.20,Default,,0,0,0,,<Иса Босс>
Dialogue: 0,0:13:12.04,0:13:13.29,Default,,0,0,0,,<Білу—>
Dialogue: 0,0:13:13.41,0:13:14.75,Default,,0,0,0,,<Одан құтылу>
Dialogue: 0,0:13:14.87,0:13:16.29,Default,,0,0,0,,〈Иә! 〉
Dialogue: 0,0:13:16.42,0:13:17.79,Default,,0,0,0,,〈Сонымен қатар кешегі еркеге〉
Dialogue: 0,0:13:17.92,0:13:20.38,Default,,0,0,0,,<Менің ойымша, тиісті санкциялар қажет...>
Dialogue: 0,0:13:20.75,0:13:22.80,Default,,0,0,0,,〈Сіз мұны қалайсыз ба? 〉
Dialogue: 0,0:13:23.59,0:13:25.38,Default,,0,0,0,,<Ол да «Менімен араласпа»—>
Dialogue: 0,0:13:25.51,0:13:27.38,Default,,0,0,0,,<Мен оны бірінші рет естідім>
Dialogue: 0,0:13:28.09,0:13:30.18,Default,,0,0,0,,〈Не? Босс? 〉
Dialogue: 0,0:13:33.35,0:13:35.94,Default,,0,0,0,,Менің қайтадан топта ойнау ойым жоқ!
Dialogue: 0,0:13:36.35,0:13:37.56,Default,,0,0,0,,Е! Эх! Сол сияқты...
Dialogue: 0,0:13:37.69,0:13:43.19,Default,,0,0,0,,Осы мейрамханада жаттығып, ұзын-сонар кезектері бар рамен мейрамханасы болуды мақсат етіңіз!
Dialogue: 0,0:13:43.32,0:13:47.70,Default,,0,0,0,,Тайраның да жаңа топқа қосылғанын көру өте жақсы.
Dialogue: 0,0:13:47.82,0:13:50.20,Default,,0,0,0,,Бірақ бұл рамен жаман.
Dialogue: 0,0:13:50.32,0:13:51.20,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:51.78,0:13:54.08,Default,,0,0,0,,Сіз дұрыс жаттығуға болатын дүкенді таңдауыңыз керек.
Dialogue: 0,0:13:54.20,0:13:55.54,Default,,0,0,0,,Шу!
Dialogue: 0,0:13:56.87,0:13:59.67,Default,,0,0,0,,Өтінемін, менің Typhoon Stones гитарам ретінде...
Dialogue: 0,0:13:59.79,0:14:00.96,Default,,0,0,0,,Бізге қосылыңыз!
Dialogue: 0,0:14:01.42,0:14:03.96,Default,,0,0,0,,Кешіріңіз, бірақ мен бас тартамын.
Dialogue: 0,0:14:04.30,0:14:06.55,Default,,0,0,0,,Тікелей эфирге бір күн қалды.
Dialogue: 0,0:14:06.67,0:14:08.68,Default,,0,0,0,,Позитивті ойланыңыз!
Dialogue: 0,0:14:08.88,0:14:10.43,Default,,0,0,0,,Олай болса, өтінемін!
Dialogue: 0,0:14:12.14,0:14:13.72,Default,,0,0,0,,(Изуку) Мүмкін. Оятып алғаным үшін кешір.
Dialogue: 0,0:14:15.64,0:14:18.56,Default,,0,0,0,,Біз мұны істеуіміз керек емес пе? Көмек…
Dialogue: 0,0:14:19.60,0:14:21.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:22.19,0:14:23.23,Default,,0,0,0,,Коюки
Dialogue: 0,0:14:23.36,0:14:25.61,Default,,0,0,0,,Менің сізбен сөйлесетін нәрсем бар.
Dialogue: 0,0:14:26.11,0:14:28.11,Default,,0,0,0,,Е... Саку!
Dialogue: 0,0:14:28.49,0:14:30.57,Default,,0,0,0,,Мен бұған үйреніп қалдым.
Dialogue: 0,0:14:30.91,0:14:36.29,Default,,0,0,0,,Бұл менің бастауыш, орта және жоғары сыныптарға 5-ші рет баруым.
Dialogue: 0,0:14:36.62,0:14:39.00,Default,,0,0,0,,Бірақ бұл жолы, осы уақытқа дейін
Dialogue: 0,0:14:39.12,0:14:41.83,Default,,0,0,0,,Бұл ең ауыр трансфер болуы мүмкін.
Dialogue: 0,0:14:44.42,0:14:45.55,Default,,0,0,0,,Саку!
Dialogue: 0,0:14:45.92,0:14:48.92,Default,,0,0,0,,Әлі екі ай бар.
Dialogue: 0,0:14:49.05,0:14:51.72,Default,,0,0,0,,Мен алдымен Коюкиге хабарлауды жоспарлап отырмын.
Dialogue: 0,0:14:51.84,0:14:53.01,Default,,0,0,0,,Саку…
Dialogue: 0,0:14:53.14,0:14:54.72,Default,,0,0,0,,Иә, иә?
Dialogue: 0,0:14:54.81,0:14:57.93,Default,,0,0,0,,Коюкиге тағы бір айтарым бар.
Dialogue: 0,0:14:58.06,0:14:59.31,Default,,0,0,0,,Не?
Dialogue: 0,0:14:59.44,0:15:03.19,Default,,0,0,0,,Бұл туралы айту әлі ерте шығар, бірақ...
Dialogue: 0,0:15:03.31,0:15:06.86,Default,,0,0,0,,Мен болашақта музыканы тастауым мүмкін.
Dialogue: 0,0:15:07.23,0:15:10.24,Default,,0,0,0,,Бірақ! Бірақ Коюки...
Dialogue: 0,0:15:10.32,0:15:13.91,Default,,0,0,0,,Коюки музыка ойнауды ешқашан тоқтатпайды!
Dialogue: 0,0:15:14.37,0:15:15.24,Default,,0,0,0,,Саку…
Dialogue: 0,0:15:15.33,0:15:16.87,Default,,0,0,0,,«Сырғып кету» сияқты—
Dialogue: 0,0:15:16.99,0:15:19.79,Default,,0,0,0,,Адамдардың жүрегін жаулаған әндер.
Dialogue: 0,0:15:19.91,0:15:21.75,Default,,0,0,0,,Көп жазыңыз!
Dialogue: 0,0:15:21.83,0:15:23.58,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:15:23.71,0:15:27.00,Default,,0,0,0,,Музыка ойнауды тоқтатпау керек!
Dialogue: 0,0:15:27.13,0:15:29.88,Default,,0,0,0,,Мен сізден көп нәрсені үйрендім...
Dialogue: 0,0:15:30.01,0:15:32.05,Default,,0,0,0,,Үйрендім... келдім...
Dialogue: 0,0:15:32.64,0:15:34.01,Default,,0,0,0,,Коюки…
Dialogue: 0,0:15:46.44,0:15:49.19,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:15:58.58,0:16:00.12,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:16:06.79,0:16:07.88,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:16:14.26,0:16:15.34,Default,,0,0,0,,О~ Танака
Dialogue: 0,0:16:15.55,0:16:17.10,Default,,0,0,0,,Уау, бұл керемет болды!
Dialogue: 0,0:16:17.22,0:16:19.64,Default,,0,0,0,,Тағы да өтінемін, Курт Кобейн!
Dialogue: 0,0:16:19.77,0:16:21.85,Default,,0,0,0,,Жоқ, мен оны шынымен сақтап қойдым.
Dialogue: 0,0:16:22.06,0:16:23.31,Default,,0,0,0,,Тағы кездескенше
Dialogue: 0,0:16:23.44,0:16:25.81,Default,,0,0,0,,Иә? Іске қосуға қатысқыңыз келе ме?
Dialogue: 0,0:16:26.48,0:16:27.86,Default,,0,0,0,,Танаканы көндіру —
Dialogue: 0,0:16:27.98,0:16:31.07,Default,,0,0,0,,Мен сені Тайфун Стоунздың ресми мүшесі етемін деп ойладым.
Dialogue: 0,0:16:32.78,0:16:35.49,Default,,0,0,0,,Мен сізді соңғы рет көргеніме біраз болды, сондықтан мен қобалжыдым.
Dialogue: 0,0:16:35.61,0:16:38.08,Default,,0,0,0,,Бұл ризашылық дыбысынан бері болды.
Dialogue: 0,0:16:38.20,0:16:39.03,Default,,0,0,0,,Иә
Dialogue: 0,0:16:39.16,0:16:42.00,Default,,0,0,0,,Маған да көмек сұрады, бірақ мен оны екі рет алдым.
Dialogue: 0,0:16:42.12,0:16:44.12,Default,,0,0,0,,Мен қатты қобалжыдым.
Dialogue: 0,0:16:45.83,0:16:48.25,Default,,0,0,0,,Бірақ бұл жеткіліксіз
Dialogue: 0,0:16:48.54,0:16:50.38,Default,,0,0,0,,Мүлдем қанағаттанарлықсыз
Dialogue: 0,0:16:51.88,0:16:53.97,Default,,0,0,0,,Мен мұны тағы да түсіндім
Dialogue: 0,0:16:54.34,0:16:58.22,Default,,0,0,0,,BECK шынымен керемет топ болды.
Dialogue: 0,0:17:16.36,0:17:17.41,Default,,0,0,0,,Күткеніңізге рахмет!
Dialogue: 0,0:17:17.53,0:17:20.20,Default,,0,0,0,,Бүгін Сақудың соңғы күні.
Dialogue: 0,0:17:20.33,0:17:21.62,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:17:21.74,0:17:23.33,Default,,0,0,0,,Оу!
Dialogue: 0,0:17:23.83,0:17:25.21,Default,,0,0,0,,Ей, жасайық!
Dialogue: 0,0:17:25.33,0:17:27.25,Default,,0,0,0,,Хэхехе... (Масуока) Керемет!
Dialogue: 0,0:17:27.54,0:17:30.04,Default,,0,0,0,,Сәлем Коюки! Шешіңіз!
Dialogue: 0,0:17:30.17,0:17:31.25,Default,,0,0,0,,Бірақ мен әлі біраз уақыт үйге оралмаймын.
Dialogue: 0,0:17:33.80,0:17:34.76,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:17:34.88,0:17:35.84,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:35.97,0:17:37.55,Default,,0,0,0,,Жақсы! Бұл қатарынан 6 жеңіс!
Dialogue: 0,0:17:37.68,0:17:38.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:38.93,0:17:40.85,Default,,0,0,0,,Оны біраз ретке келтірейік.
Dialogue: 0,0:17:40.97,0:17:42.89,Default,,0,0,0,,Сакумен серіктес болғым келеді
Dialogue: 0,0:17:43.02,0:17:46.02,Default,,0,0,0,,Чикусо! Тағы бір ойын ойнайық!
Dialogue: 0,0:17:46.14,0:17:47.85,Default,,0,0,0,,Эх!
Dialogue: 0,0:17:50.06,0:17:51.27,Default,,0,0,0,,(раменнің шырылдаған дыбысы)
Dialogue: 0,0:17:51.40,0:17:55.03,Default,,0,0,0,,Уф... О, мұндағы рамен дәмді.
Dialogue: 0,0:17:55.15,0:17:55.99,Default,,0,0,0,,Рас!
Dialogue: 0,0:17:56.11,0:17:58.53,Default,,0,0,0,,Дұрыс? Дұрыс па? хехехе
Dialogue: 0,0:17:58.66,0:18:01.16,Default,,0,0,0,,Олай болса, келесі дүкенге барайық!
Dialogue: 0,0:18:01.28,0:18:05.12,Default,,0,0,0,,Мм... Жақында менде коменданттық сағат бар...
Dialogue: 0,0:18:05.25,0:18:07.08,Default,,0,0,0,,Иә, әлдеқашан?
Dialogue: 0,0:18:07.21,0:18:08.21,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:18:08.33,0:18:10.79,Default,,0,0,0,,Қыздардың бірі қауіпті...
Dialogue: 0,0:18:11.13,0:18:13.63,Default,,0,0,0,,А, мен сені міндетті түрде қайтарамын.
Dialogue: 0,0:18:13.75,0:18:15.42,Default,,0,0,0,,Көріскенше Коюки
Dialogue: 0,0:18:15.76,0:18:17.63,Default,,0,0,0,,Олай болса, сау болыңыз.
Dialogue: 0,0:18:20.47,0:18:22.85,Default,,0,0,0,,Бұл біраз түсінікті сияқты, иә...
Dialogue: 0,0:18:22.97,0:18:25.77,Default,,0,0,0,,Чиба-кун, сен рамен дүкенінде жаттығасың, солай ма?
Dialogue: 0,0:18:25.89,0:18:29.27,Default,,0,0,0,,Тайра - танымал инди-топтың бас гитарашысы.
Dialogue: 0,0:18:29.39,0:18:31.52,Default,,0,0,0,,Рюсуке жоқ
Dialogue: 0,0:18:32.19,0:18:34.86,Default,,0,0,0,,БЕК қазірдің өзінде құлап жатыр.
Dialogue: 0,0:18:35.78,0:18:37.40,Default,,0,0,0,,U~ Samii~
Dialogue: 0,0:18:37.53,0:18:40.74,Default,,0,0,0,,Амансың ба? Даусыңыз сәл мұрындық.
Dialogue: 0,0:18:40.86,0:18:42.95,Default,,0,0,0,,Сонда кездескенше Коюки
Dialogue: 0,0:18:43.08,0:18:44.70,Default,,0,0,0,,Суық тигізбе
Dialogue: 0,0:18:54.55,0:18:55.71,Default,,0,0,0,,(шу)
Dialogue: 0,0:18:55.84,0:18:58.05,Default,,0,0,0,,Хмм... Махо?
Dialogue: 0,0:19:02.30,0:19:03.60,Default,,0,0,0,,Саку!
Dialogue: 0,0:19:09.27,0:19:11.02,Default,,0,0,0,,Сыртта өте суық.
Dialogue: 0,0:19:11.15,0:19:12.98,Default,,0,0,0,,Болжам бойынша ертең қар жауады.
Dialogue: 0,0:19:13.11,0:19:14.69,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:19:15.11,0:19:16.53,Default,,0,0,0,,Тамақ ішейік
Dialogue: 0,0:19:16.65,0:19:17.73,Default,,0,0,0,,Иә
Dialogue: 0,0:19:18.15,0:19:20.49,Default,,0,0,0,,Уау, картоп чипсы! А... кимчи дәмі?
Dialogue: 0,0:19:20.61,0:19:21.66,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:19:22.11,0:19:24.83,Default,,0,0,0,,А... Сонда сен оны бүгін ғана түсіріп жібердің бе?
Dialogue: 0,0:19:24.95,0:19:27.95,Default,,0,0,0,,Өкінішке орай, біз ешқашан қол ұстасып көрген емеспіз.
Dialogue: 0,0:19:28.08,0:19:29.04,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:29.16,0:19:30.83,Default,,0,0,0,,Коюки Махомен қаншалықты алысқа барады?
Dialogue: 0,0:19:30.96,0:19:32.75,Default,,0,0,0,,О, мен...
Dialogue: 0,0:19:32.88,0:19:34.21,Default,,0,0,0,,Мен Сакуға бұрын айттым.
Dialogue: 0,0:19:34.33,0:19:35.17,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:19:35.29,0:19:37.67,Default,,0,0,0,,Grateful Sound қолданбасынан ешқандай прогресс жоқ па?
Dialogue: 0,0:19:38.17,0:19:40.51,Default,,0,0,0,,(БЕКтің жанды дыбыс көзі)
Dialogue: 0,0:19:41.09,0:19:42.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:42.13,0:19:43.72,Default,,0,0,0,,Эй... эй... бір секундқа тоқтайық.
Dialogue: 0,0:19:43.84,0:19:45.39,Default,,0,0,0,,Бұл менің алғашқы тікелей шоуым!
Dialogue: 0,0:19:45.51,0:19:47.64,Default,,0,0,0,,Уау... бұл қорқынышты.
Dialogue: 0,0:19:48.60,0:19:51.69,Default,,0,0,0,,Ол кезде Чиба-кун дұрыс түсінбеген.
Dialogue: 0,0:19:51.81,0:19:53.52,Default,,0,0,0,,Mount Punch қателікпен!
Dialogue: 0,0:19:53.65,0:19:55.69,Default,,0,0,0,,(Саку мен Коюкидің күлкісі)
Dialogue: 0,0:19:55.77,0:20:00.61,Default,,0,0,0,,Хахаха... хахахаха...!
Dialogue: 0,0:20:06.95,0:20:08.74,Default,,0,0,0,,Енді... және Саку...
Dialogue: 0,0:20:08.87,0:20:10.50,Default,,0,0,0,,Олай болса кететін уақыт келді.
Dialogue: 0,0:20:10.62,0:20:12.79,Default,,0,0,0,,Мен оны жіберемін
Dialogue: 0,0:20:12.92,0:20:13.87,Default,,0,0,0,,Сәлем Коюки!
Dialogue: 0,0:20:14.00,0:20:15.21,Default,,0,0,0,,Не? Ах!
Dialogue: 0,0:20:17.34,0:20:18.21,Default,,0,0,0,,Мен… мен жай…—
Dialogue: 0,0:20:18.34,0:20:19.71,Default,,0,0,0,,Уау
Dialogue: 0,0:20:26.80,0:20:29.06,Default,,0,0,0,,Суық.
Dialogue: 0,0:20:29.18,0:20:30.60,Default,,0,0,0,,Саму~
Dialogue: 0,0:20:30.72,0:20:32.10,Default,,0,0,0,,Самии~
Dialogue: 0,0:20:32.23,0:20:33.81,Default,,0,0,0,,Күрделі Самии~
Dialogue: 0,0:20:33.94,0:20:35.56,Default,,0,0,0,,Самиизо, міне, осы.
Dialogue: 0,0:20:35.69,0:20:38.65,Default,,0,0,0,,Әтеш Самии~ Уу~!
Dialogue: 0,0:20:38.73,0:20:41.57,Default,,0,0,0,,Сами... Сами~ Ах...
Dialogue: 0,0:20:43.24,0:20:44.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:46.53,0:20:48.41,Default,,0,0,0,,Көріскенше Коюки
Dialogue: 0,0:20:48.74,0:20:50.08,Default,,0,0,0,,Саку аман бол
Dialogue: 0,0:20:51.25,0:20:52.37,Default,,0,0,0,,Иә
Dialogue: 0,0:20:52.75,0:20:56.54,Default,,0,0,0,,Жалғыз өмір сүру үшін ақша жинау үшін толық емес жұмыс күнімен жұмыс жасаңыз
Dialogue: 0,0:20:56.67,0:20:59.88,Default,,0,0,0,,Мен ата-анамды көктемде қайтып келуге көндіремін.
Dialogue: 0,0:21:00.30,0:21:03.59,Default,,0,0,0,,БЕК-ті бастапқы мүшелермен жандандыру -
Dialogue: 0,0:21:03.67,0:21:06.39,Default,,0,0,0,,Мектепті дереу тастап, қайтып орал
Dialogue: 0,0:21:08.01,0:21:09.60,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:21:21.57,0:21:22.57,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:21:22.69,0:21:24.11,Default,,0,0,0,,Саку да!
Dialogue: 0,0:21:32.58,0:21:35.58,Default,,0,0,0,,Бұл өте керемет ән таңдау болды. Сен ше?
Dialogue: 0,0:21:35.71,0:21:37.21,Default,,0,0,0,,3 курс 2 сынып Хироси Сакурай
Dialogue: 0,0:21:37.33,0:21:39.00,Default,,0,0,0,,Уау, анау бет!
Dialogue: 0,0:21:39.13,0:21:40.88,Default,,0,0,0,,Мен мұны саған бергім келеді.
Dialogue: 0,0:21:41.00,0:21:42.25,Default,,0,0,0,,Бұл Дайбридің Германиядағы тікелей орындауы.
Dialogue: 0,0:21:42.38,0:21:43.34,Default,,0,0,0,,Танака мырза
Dialogue: 0,0:21:43.46,0:21:46.01,Default,,0,0,0,,Сіз Эдди Лидің «Гитара әлемі» тақырыбындағы сұхбат мақаласын оқыдыңыз ба?
Dialogue: 0,0:21:46.13,0:21:48.80,Default,,0,0,0,,«Әлемде екі түрлі адам бар»
Dialogue: 0,0:21:48.93,0:21:51.60,Default,,0,0,0,,«Ақылды адам және адал адам».
Dialogue: 0,0:21:51.72,0:21:55.18,Default,,0,0,0,,«Дана адам – тәртіп пен имандылықты тудырған адам».
Dialogue: 0,0:21:55.31,0:21:58.35,Default,,0,0,0,,«Менің ойымша, бұл әлемді қозғайтынның бәрі».
Dialogue: 0,0:21:58.94,0:22:01.73,Default,,0,0,0,,«Бірақ мен бұл туралы ойламаймын».
Dialogue: 0,0:22:01.86,0:22:03.73,Default,,0,0,0,,Эдди күткендей.
Dialogue: 0,0:22:03.86,0:22:06.99,Default,,0,0,0,,Эй, Танака-кун, сен топтасың.
Dialogue: 0,0:22:07.11,0:22:08.49,Default,,0,0,0,,(велосипед қоңырауы)
Dialogue: 0,0:22:11.45,0:22:12.28,Default,,0,0,0,,Ой
Dialogue: 0,0:22:12.66,0:22:13.62,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:22:13.91,0:22:15.50,Default,,0,0,0,,Хэхе... хаха!
Dialogue: 0,0:22:16.20,0:22:17.04,Default,,0,0,0,,Фу…
Dialogue: 0,0:22:17.66,0:22:19.25,Default,,0,0,0,,Коюки! Ха
Dialogue: 0,0:22:20.25,0:22:21.79,Default,,0,0,0,,Ой...
Dialogue: 0,0:22:28.55,0:22:31.34,Default,,0,0,0,,Уф... мм...
Dialogue: 0,0:22:33.64,0:22:36.06,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,0:22:36.22,0:22:38.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:45.15,0:22:51.07,Default,,0,0,0,,♪～
Dialogue: 0,0:24:05.23,0:24:10.24,Default,,0,0,0,,～♪
Dialogue: 0,0:24:15.41,0:24:17.12,Default,,0,0,0,,Келесі аптада «Америка»
Dialogue: 0,0:24:17.24,0:24:19.37,Default,,0,0,0,,Біздің саяхатымыз жалғасуда
Dialogue: 0,0:24:19.49,0:24:21.96,Default,,0,0,0,,Менің ескертуім аяқталды.
Dialogue: 0,0:24:23.46,0:24:29.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
