Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.37,0:00:07.00,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.71,0:01:36.97,Default,,0,0,0,,～♪
Dialogue: 0,0:01:37.97,0:01:39.30,Default,,0,0,0,,Коюки БЕК-ті тірілтеді —
Dialogue: 0,0:01:39.43,0:01:41.10,Default,,0,0,0,,Өйткені мен бұл туралы шындап ойлап жүрмін...
Dialogue: 0,0:01:41.22,0:01:43.85,Default,,0,0,0,,Мен де көмектесе аламын ба?
Dialogue: 0,0:01:44.18,0:01:46.02,Default,,0,0,0,,Сонымен... сен не дейсің, Чиба?
Dialogue: 0,0:01:46.52,0:01:48.60,Default,,0,0,0,,Сіз өлесіз!
Dialogue: 0,0:01:48.73,0:01:49.85,Default,,0,0,0,,～
Dialogue: 0,0:01:50.48,0:01:53.90,Default,,0,0,0,,Пікірталас өте нашар аяқталды.
Dialogue: 0,0:01:54.03,0:01:55.90,Default,,0,0,0,,Хмм... Чиба-кун сияқты.
Dialogue: 0,0:01:56.03,0:01:57.53,Default,,0,0,0,,Бұл күлетін нәрсе емес!
Dialogue: 0,0:01:57.65,0:01:58.78,Default,,0,0,0,,Иә...
Dialogue: 0,0:01:59.20,0:02:00.37,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:02:00.49,0:02:03.24,Default,,0,0,0,,Бұл рамен жаман ...
Dialogue: 0,0:02:03.37,0:02:05.45,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:02:08.41,0:02:10.46,Default,,0,0,0,,Сәлем (Чиба) О
Dialogue: 0,0:02:08.41,0:02:10.46,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,0:02:10.46,0:02:10.58,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,0:02:10.58,0:02:11.25,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,0:02:10.58,0:02:11.25,Default,,0,0,0,,Чиба-кун...Шынында...
Dialogue: 0,0:02:11.25,0:02:12.04,Default,,0,0,0,,Чиба-кун...Шынында...
Dialogue: 0,0:02:12.50,0:02:15.09,Default,,0,0,0,,Солай ма? Оны маған жіберген Махо ма?
Dialogue: 0,0:02:15.21,0:02:16.38,Default,,0,0,0,,Е... а, жоқ...
Dialogue: 0,0:02:16.51,0:02:19.72,Default,,0,0,0,,Сіз шынымен айтқыңыз келгеннің бәрін айттыңыз!
Dialogue: 0,0:02:19.84,0:02:21.43,Default,,0,0,0,,Махо не дейді?
Dialogue: 0,0:02:21.85,0:02:24.06,Default,,0,0,0,,«Жаман раменнің болашағы жоқ».
Dialogue: 0,0:02:24.18,0:02:27.06,Default,,0,0,0,,«БЕКтің кездесуіне қосыл!»...
Dialogue: 0,0:02:27.18,0:02:29.73,Default,,0,0,0,,Бір жақты айқайлады.
Dialogue: 0,0:02:30.44,0:02:31.90,Default,,0,0,0,,Чиба-кун
Dialogue: 0,0:02:32.02,0:02:33.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:33.61,0:02:36.36,Default,,0,0,0,,БЕК-ті қайтадан жасайық!
Dialogue: 0,0:02:36.44,0:02:37.61,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:02:37.82,0:02:42.16,Default,,0,0,0,,Мен қазір жалғыз болсам да.
Dialogue: 0,0:02:42.28,0:02:43.53,Default,,0,0,0,,Уолли
Dialogue: 0,0:02:43.66,0:02:46.83,Default,,0,0,0,,Мен қазір тек рамен туралы ойлаймын.
Dialogue: 0,0:02:51.58,0:02:54.09,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:02:54.42,0:02:56.38,Default,,0,0,0,,Сәлем! Коюки! иә?
Dialogue: 0,0:02:56.50,0:02:59.88,Default,,0,0,0,,Менің раменім шынымен соншалықты нашар ма?
Dialogue: 0,0:03:00.51,0:03:01.68,Default,,0,0,0,,Иә
Dialogue: 0,0:03:01.80,0:03:04.05,Default,,0,0,0,,БЕК туралы шын айтасыз ба?
Dialogue: 0,0:03:04.18,0:03:05.93,Default,,0,0,0,,Ум...не деуім керек...
Dialogue: 0,0:03:06.06,0:03:07.81,Default,,0,0,0,,Сіз байсалды болуыңыз керек -
Dialogue: 0,0:03:07.93,0:03:09.85,Default,,0,0,0,,БЕК мүмкін емес!
Dialogue: 0,0:03:10.10,0:03:12.23,Default,,0,0,0,,Мен қайтуға болады? Ах
Dialogue: 0,0:03:13.73,0:03:16.23,Default,,0,0,0,,Түс көрмесем жарай ма?
Dialogue: 0,0:03:16.36,0:03:18.53,Default,,0,0,0,,Чиба-кун, сен не айтып тұрсың?
Dialogue: 0,0:03:18.61,0:03:20.74,Default,,0,0,0,,О... Осе, сен!
Dialogue: 0,0:03:20.86,0:03:24.41,Default,,0,0,0,,Рахмет дыбысынан кейін келесі күні өкінемін.
Dialogue: 0,0:03:24.53,0:03:26.24,Default,,0,0,0,,Неге олай істедің...
Dialogue: 0,0:03:27.12,0:03:28.33,Default,,0,0,0,,Чиба-кун!
Dialogue: 0,0:03:28.45,0:03:31.62,Default,,0,0,0,,Бірақ мен Рюсукемен бітіспеймін!
Dialogue: 0,0:03:31.75,0:03:33.00,Default,,0,0,0,,Чиба-кун…
Dialogue: 0,0:03:33.12,0:03:39.96,Default,,0,0,0,,(топ өнімділігі)
Dialogue: 0,0:04:01.90,0:04:04.78,Default,,0,0,0,,А... а...
Dialogue: 0,0:04:18.71,0:04:20.46,Default,,0,0,0,,Тайра-кун керемет...
Dialogue: 0,0:04:20.59,0:04:22.30,Default,,0,0,0,,Бұл топ керемет
Dialogue: 0,0:04:22.42,0:04:25.09,Default,,0,0,0,,Қазірдің өзінде! Асықпасаң, Тайра-күн барады!
Dialogue: 0,0:04:25.22,0:04:27.97,Default,,0,0,0,,А... Бірақ сонша уайымдасаңыз да, уайымдамаңыз.
Dialogue: 0,0:04:28.10,0:04:29.18,Default,,0,0,0,,Хэйкун!
Dialogue: 0,0:04:29.31,0:04:30.85,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:04:30.97,0:04:33.48,Default,,0,0,0,,Тайра~ Йошиаки төменге қоңырау шалып жатыр.
Dialogue: 0,0:04:33.60,0:04:35.48,Default,,0,0,0,,Аа, мен бірден барамын.
Dialogue: 0,0:04:35.60,0:04:37.65,Default,,0,0,0,,Негізі... қайтадан БЕКке оралайық...
Dialogue: 0,0:04:37.77,0:04:39.07,Default,,0,0,0,,Түсіндім, иә!?
Dialogue: 0,0:04:39.19,0:04:40.53,Default,,0,0,0,,БЕК Сіз мұны істейсіз бе?
Dialogue: 0,0:04:40.65,0:04:41.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:41.61,0:04:45.20,Default,,0,0,0,,Коюки мені шақыруға келгенде ғана қабылдайтын болдым.
Dialogue: 0,0:04:45.32,0:04:46.28,Default,,0,0,0,,Тайра мырза…
Dialogue: 0,0:04:46.41,0:04:47.45,Default,,0,0,0,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,0:04:47.57,0:04:48.74,Default,,0,0,0,,Хэйкун~!
Dialogue: 0,0:04:48.87,0:04:50.41,Default,,0,0,0,,Идиот! (Чиба) Ахах...
Dialogue: 0,0:04:51.45,0:04:53.33,Default,,0,0,0,,Енді мен Батырлардың мүшесімін...
Dialogue: 0,0:04:53.45,0:04:55.21,Default,,0,0,0,,Бұл бірден мүмкін емес, бірақ...
Dialogue: 0,0:04:55.33,0:04:58.13,Default,,0,0,0,,Тур мен жарнамалар аяқталғаннан кейін мен бұл туралы бірдеңе істеймін.
Dialogue: 0,0:04:58.25,0:04:59.84,Default,,0,0,0,,Тайра мырза…
Dialogue: 0,0:05:00.13,0:05:02.96,Default,,0,0,0,,Алайда мен тек қайтып келемін—
Dialogue: 0,0:05:03.09,0:05:06.09,Default,,0,0,0,,Тек 5 бастапқы мүше жиналса.
Dialogue: 0,0:05:06.22,0:05:07.22,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:05:07.34,0:05:10.10,Default,,0,0,0,,Одан басқа, мен онымен ешнәрсе болғым келмейді.
Dialogue: 0,0:05:10.22,0:05:11.81,Default,,0,0,0,,Тайра мырза…
Dialogue: 0,0:05:11.93,0:05:13.10,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:05:13.22,0:05:15.89,Default,,0,0,0,,Мен бос емеспін!
Dialogue: 0,0:05:17.56,0:05:20.02,Default,,0,0,0,,Бұл жағдайда мәселе Рюсукеде.
Dialogue: 0,0:05:20.15,0:05:21.36,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:34.87,0:05:38.92,Default,,0,0,0,,Менің ойымша, ол енді Жапонияда емес пе?
Dialogue: 0,0:05:40.25,0:05:44.17,Default,,0,0,0,,Арамыз алшақ болса да, бәрінің ойы бір деп есептеймін.
Dialogue: 0,0:05:51.47,0:05:53.10,Default,,0,0,0,,Идиот ақымақ
Dialogue: 0,0:05:53.22,0:05:55.89,Default,,0,0,0,,Коюки-кун, мынаны тасташы.
Dialogue: 0,0:05:56.02,0:05:57.31,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:57.39,0:06:00.23,Default,,0,0,0,,Уф... Мм... А!
Dialogue: 0,0:06:02.32,0:06:03.27,Default,,0,0,0,,Я...
Dialogue: 0,0:06:03.40,0:06:06.40,Default,,0,0,0,,Коюки-кун, сосын дүкенге барыңыз.
Dialogue: 0,0:06:06.69,0:06:09.74,Default,,0,0,0,,Мен Момо-чанмен кездесіп жүрмін, сондықтан...
Dialogue: 0,0:06:09.86,0:06:11.87,Default,,0,0,0,,Идиот! Коюки ақымақ
Dialogue: 0,0:06:29.97,0:06:31.26,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:34.56,0:06:35.60,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:06:35.72,0:06:37.18,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:06:37.31,0:06:38.68,Default,,0,0,0,,Сізге телефон қоңыраулары түсті ме?
Dialogue: 0,0:06:38.81,0:06:40.73,Default,,0,0,0,,Жоқ, олай емес еді.
Dialogue: 0,0:06:40.85,0:06:42.11,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:06:58.41,0:07:04.42,Default,,0,0,0,,(топ өнімділігі)
Dialogue: 0,0:07:17.89,0:07:20.06,Default,,0,0,0,,Уау! Хахаха!
Dialogue: 0,0:07:20.18,0:07:24.11,Default,,0,0,0,,Иә! Уф! иә!
Dialogue: 0,0:07:24.81,0:07:27.86,Default,,0,0,0,,(Чибаның шулы дауысы)
Dialogue: 0,0:07:42.79,0:07:45.42,Default,,0,0,0,,Уау, бұл таңғажайып тікелей эфир болды.
Dialogue: 0,0:07:45.54,0:07:48.67,Default,,0,0,0,,Келетініңді айтсаң, мен сені қонаққа қосар едім.
Dialogue: 0,0:07:48.80,0:07:49.67,Default,,0,0,0,,Тайра мырза
Dialogue: 0,0:07:49.80,0:07:52.93,Default,,0,0,0,,Мм... мен сенімен суретке түсе аламын ба?
Dialogue: 0,0:07:53.05,0:07:54.59,Default,,0,0,0,,Қажеті жоқ. Айтқым келетін ешкім жоқ.
Dialogue: 0,0:07:56.22,0:08:00.18,Default,,0,0,0,,Бұл Коюкиден, хехехехе...
Dialogue: 0,0:08:00.68,0:08:01.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:01.89,0:08:03.10,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:08:03.10,0:08:04.73,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:08:03.10,0:08:04.73,Default,,0,0,0,,Сәлем Чиба!
Dialogue: 0,0:08:04.85,0:08:07.11,Default,,0,0,0,,Жанкүйерлеріңізді күтпеңіз!
Dialogue: 0,0:08:07.23,0:08:08.77,Default,,0,0,0,,Мынау әдемі адам!
Dialogue: 0,0:08:08.90,0:08:10.15,Default,,0,0,0,,Идиот!
Dialogue: 0,0:08:12.15,0:08:13.82,Default,,0,0,0,,Коюкидің жігіті...
Dialogue: 0,0:08:17.45,0:08:18.62,Default,,0,0,0,,Жақында жанкүйерлер арасында—
Dialogue: 0,0:08:18.74,0:08:20.70,Default,,0,0,0,,Біртүрлі қауесеттер сыбырлап жатыр...
Dialogue: 0,0:08:20.83,0:08:21.91,Default,,0,0,0,,Сабарудың арқасында болар.
Dialogue: 0,0:08:22.04,0:08:25.79,Default,,0,0,0,,Тур біткен кезде Тайра Батырларды тастап кететін сияқты.
Dialogue: 0,0:08:26.08,0:08:28.29,Default,,0,0,0,,БЕК қайта қосылады.
Dialogue: 0,0:08:28.38,0:08:29.25,Default,,0,0,0,,(Коюкидің ән айту дауысы)
Dialogue: 0,0:08:29.25,0:08:30.09,Default,,0,0,0,,(Коюкидің ән айту дауысы)
Dialogue: 0,0:08:29.25,0:08:30.09,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:30.21,0:08:31.63,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:08:31.76,0:08:33.76,Default,,0,0,0,,Инди болғанына қарамастан 200 000 дана сатылды.
Dialogue: 0,0:08:33.88,0:08:36.55,Default,,0,0,0,,Мен Heroes-тен шыққаныма сене алар емеспін.
Dialogue: 0,0:08:37.85,0:08:39.89,Default,,0,0,0,,Сәлем, Тайра?
Dialogue: 0,0:08:40.01,0:08:41.68,Default,,0,0,0,,Сіз сұрағыңыз келе ме? (Яманака/Йошиаки) Иә?
Dialogue: 0,0:08:41.81,0:08:45.02,Default,,0,0,0,,Шеттері өрескел, бірақ талантың жарқырайды.
Dialogue: 0,0:08:45.14,0:08:48.23,Default,,0,0,0,,Оның үстіне ол көп жаза білген...
Dialogue: 0,0:08:48.94,0:08:49.90,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:50.82,0:08:53.49,Default,,0,0,0,,Барлығы үшін көп рахмет
Dialogue: 0,0:08:53.61,0:08:55.45,Default,,0,0,0,,Мені ақымақ деп ойла
Dialogue: 0,0:08:55.57,0:08:57.49,Default,,0,0,0,,Мен БЕК-ке қайтамын.
Dialogue: 0,0:08:57.62,0:08:59.58,Default,,0,0,0,,Бұл өтірік. Шынайы ма?
Dialogue: 0,0:09:27.14,0:09:29.27,Default,,0,0,0,,<Сәлем! Рюсуке Минами! 〉
Dialogue: 0,0:09:29.40,0:09:32.36,Default,,0,0,0,,<Мен таң қалдым! 〉
Dialogue: 0,0:09:32.48,0:09:34.74,Default,,0,0,0,,〈Нью-Йоркке қашан келдің? 〉
Dialogue: 0,0:09:34.86,0:09:36.49,Default,,0,0,0,,<Мырза. Дэвис! 〉
Dialogue: 0,0:09:37.20,0:09:39.37,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:09:45.37,0:09:47.12,Default,,0,0,0,,〈Жарайды! Рюсуке Минами! 〉
Dialogue: 0,0:09:47.25,0:09:51.29,Default,,0,0,0,,<Егер мен көмектесе алсам, мен ынтымақтасамын.>
Dialogue: 0,0:09:51.42,0:09:54.05,Default,,0,0,0,,〈Рахмет сізге Дэвис мырза! 〉
Dialogue: 0,0:09:54.17,0:09:56.13,Default,,0,0,0,,Дуташимашит!
Dialogue: 0,0:09:56.26,0:09:58.05,Default,,0,0,0,,(Рюсуке мен Дэвис күледі)
Dialogue: 0,0:09:59.18,0:10:01.76,Default,,0,0,0,,Юкио! Қоңырау шал!
Dialogue: 0,0:10:01.89,0:10:02.35,Default,,0,0,0,,Уа!
Dialogue: 0,0:10:02.35,0:10:02.93,Default,,0,0,0,,Уа!
Dialogue: 0,0:10:02.35,0:10:02.93,Default,,0,0,0,,(Төмен түсетін баспалдақтың дыбысы)
Dialogue: 0,0:10:02.93,0:10:03.51,Default,,0,0,0,,(Төмен түсетін баспалдақтың дыбысы)
Dialogue: 0,0:10:03.60,0:10:04.64,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:10:04.77,0:10:06.89,Default,,0,0,0,,Уау! Ух... иә!
Dialogue: 0,0:10:08.02,0:10:11.52,Default,,0,0,0,,Хаха...
Dialogue: 0,0:10:11.98,0:10:13.82,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:10:17.15,0:10:20.82,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:10:27.66,0:10:29.33,Default,,0,0,0,,Күткеніңізге рахмет! Коюки
Dialogue: 0,0:10:29.46,0:10:30.58,Default,,0,0,0,,Хмм... Саку!
Dialogue: 0,0:10:30.71,0:10:32.84,Default,,0,0,0,,Ақшаға тоймаймын.
Dialogue: 0,0:10:32.96,0:10:34.42,Default,,0,0,0,,Сіз кешіктіңіз!
Dialogue: 0,0:10:34.55,0:10:35.55,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:10:35.67,0:10:38.05,Default,,0,0,0,,Мен қатты уайымдадым!
Dialogue: 0,0:10:38.17,0:10:39.01,Default,,0,0,0,,Коюки…
Dialogue: 0,0:10:39.13,0:10:41.97,Default,,0,0,0,,Соңғы кездері маған көп хабарласпай кетті...
Dialogue: 0,0:10:42.09,0:10:44.35,Default,,0,0,0,,Мен тезірек келгім келді.
Dialogue: 0,0:10:44.47,0:10:45.72,Default,,0,0,0,,Саку~
Dialogue: 0,0:10:45.85,0:10:47.10,Default,,0,0,0,,Коюки…
Dialogue: 0,0:10:48.06,0:10:52.36,Default,,0,0,0,,♪「ӨМІР ДӘТТІЛЕРІ」
Dialogue: 0,0:11:06.83,0:11:09.83,Default,,0,0,0,,Қарт қыңыр.
Dialogue: 0,0:11:09.91,0:11:14.38,Default,,0,0,0,,Ақыры қарияны сендіре алмай, жүгіріп шықтым.
Dialogue: 0,0:11:14.50,0:11:15.34,Default,,0,0,0,,Сау бол...
Dialogue: 0,0:11:15.42,0:11:17.05,Default,,0,0,0,,Пәтер тапқанша—
Dialogue: 0,0:11:17.17,0:11:19.22,Default,,0,0,0,,Қалағаныңызша менімен бірге бола аласыз.
Dialogue: 0,0:11:19.55,0:11:20.88,Default,,0,0,0,,Бақытты болыңыз
Dialogue: 0,0:11:21.01,0:11:21.84,Default,,0,0,0,,Сау болыңыз...
Dialogue: 0,0:11:22.84,0:11:26.85,Default,,0,0,0,,(Коюки және басқалардың орындауы)
Dialogue: 0,0:11:31.27,0:11:34.06,Default,,0,0,0,,Юкио! Маған Сато деген біреу қоңырау шалды!
Dialogue: 0,0:11:34.19,0:11:34.90,Default,,0,0,0,,Уа!
Dialogue: 0,0:11:34.90,0:11:35.65,Default,,0,0,0,,Уа!
Dialogue: 0,0:11:34.90,0:11:35.65,Default,,0,0,0,,(Төмен түсетін баспалдақтың дыбысы)
Dialogue: 0,0:11:35.65,0:11:36.02,Default,,0,0,0,,(Төмен түсетін баспалдақтың дыбысы)
Dialogue: 0,0:11:36.15,0:11:37.36,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:11:37.44,0:11:39.65,Default,,0,0,0,,БЕК-тің оралуымен құттықтаймыз
Dialogue: 0,0:11:39.78,0:11:41.15,Default,,0,0,0,,О, досым! Осы жеңісті тойлайық
Dialogue: 0,0:11:41.28,0:11:43.45,Default,,0,0,0,,Мен өз ісімді қысқаша түсіндіремін.
Dialogue: 0,0:11:43.57,0:11:44.41,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:11:44.62,0:11:46.03,Default,,0,0,0,,Сізге БЕК—
Dialogue: 0,0:11:46.16,0:11:48.70,Default,,0,0,0,,Маған америкалық турға бару ұсынылды.
Dialogue: 0,0:11:48.83,0:11:49.83,Default,,0,0,0,,Америка?
Dialogue: 0,0:11:55.46,0:11:59.76,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:12:01.80,0:12:02.63,Default,,0,0,0,,Сәлем
Dialogue: 0,0:12:02.76,0:12:04.26,Default,,0,0,0,,〈Сәлеметсіз бе, қалыңыз қалай? 〉
Dialogue: 0,0:12:04.97,0:12:06.60,Default,,0,0,0,,〈Джон менен сұрады〉
Dialogue: 0,0:12:06.72,0:12:08.14,Default,,0,0,0,,<Мен сенімен бизнес жасағым келеді>
Dialogue: 0,0:12:08.22,0:12:10.02,Default,,0,0,0,,〈Менде өте бағалы таспа бар〉
Dialogue: 0,0:12:10.14,0:12:12.14,Default,,0,0,0,,<Едиден алынды>
Dialogue: 0,0:12:12.23,0:12:13.35,Default,,0,0,0,,<Мұны сізге берудің орнына—>
Dialogue: 0,0:12:13.48,0:12:15.52,Default,,0,0,0,,<Ешқашан Моңғол шоп тобына енді қосылмау>
Dialogue: 0,0:12:15.65,0:12:17.23,Default,,0,0,0,,〈Маған тиіспеңіз〉
Dialogue: 0,0:12:17.36,0:12:19.19,Default,,0,0,0,,<Бұл жәндіктер туралы жақсы әңгіме.>
Dialogue: 0,0:12:19.32,0:12:22.32,Default,,0,0,0,,<Мен бүгін кешке қонақүйге таспаны апарамын>
Dialogue: 0,0:12:23.11,0:12:25.74,Default,,0,0,0,,<Ол әлі жынды жігіт>
Dialogue: 0,0:12:28.16,0:12:33.96,Default,,0,0,0,,♪「миға шабуыл（ҮЛКЕН MUFF）」
Dialogue: 0,0:12:43.84,0:12:45.89,Default,,0,0,0,,АҚШ турнесі...
Dialogue: 0,0:12:46.18,0:12:47.60,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:12:47.72,0:12:49.68,Default,,0,0,0,,Сонымен, Цеппелин немесе тастар сияқты—
Dialogue: 0,0:12:49.81,0:12:51.43,Default,,0,0,0,,Теледидарды қонақүй бөлмесінен лақтырып тастау—
Dialogue: 0,0:12:51.56,0:12:52.85,Default,,0,0,0,,Жеке ұшақта топ мүшелерімен—
Dialogue: 0,0:12:52.98,0:12:55.35,Default,,0,0,0,,Сен анау-мынау жасай алмайсың ба?!
Dialogue: 0,0:12:55.48,0:12:59.27,Default,,0,0,0,,Барса көлігін бүкіл ел бойынша ондаған жанды музыкалық орындарға айдап барады.
Dialogue: 0,0:12:59.40,0:13:01.32,Default,,0,0,0,,Бұл қиын тур.
Dialogue: 0,0:13:02.23,0:13:03.07,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:13:03.19,0:13:05.40,Default,,0,0,0,,Десе де, бұл ғажап, солай емес пе?
Dialogue: 0,0:13:05.53,0:13:06.45,Default,,0,0,0,,Рахмет дыбысымен—
Dialogue: 0,0:13:06.57,0:13:08.87,Default,,0,0,0,,F.V.E тобынан біреу. бізді көрді.
Dialogue: 0,0:13:08.99,0:13:10.45,Default,,0,0,0,,Ол мені шақырды.
Dialogue: 0,0:13:10.58,0:13:12.16,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ!
Dialogue: 0,0:13:12.29,0:13:13.37,Default,,0,0,0,,Ойлан.
Dialogue: 0,0:13:13.50,0:13:14.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:14.54,0:13:18.13,Default,,0,0,0,,БЕК-пен Рюсукесіз АҚШ-тың қазіргі туры тым қауіпті.
Dialogue: 0,0:13:18.21,0:13:19.04,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:13:19.17,0:13:20.34,Default,,0,0,0,,Мен мұндай мүмкіндіктен қалай бас тарта аламын?
Dialogue: 0,0:13:20.46,0:13:22.30,Default,,0,0,0,,Бұл біз сияқты емес!
Dialogue: 0,0:13:22.42,0:13:23.80,Default,,0,0,0,,Бұл қауіпті ставка.
Dialogue: 0,0:13:23.92,0:13:24.88,Default,,0,0,0,,Америка?
Dialogue: 0,0:13:25.01,0:13:26.22,Default,,0,0,0,,Маған төлқұжат жасау керек
Dialogue: 0,0:13:26.34,0:13:28.55,Default,,0,0,0,,Бұл ақшаны талап ете ме?
Dialogue: 0,0:13:29.14,0:13:29.60,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:13:29.60,0:13:32.14,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:13:29.60,0:13:32.14,Default,,0,0,0,,Жазғы демалыс БЕК-ті жаттықтырумен өтті.
Dialogue: 0,0:13:32.14,0:13:32.39,Default,,0,0,0,,Жазғы демалыс БЕК-ті жаттықтырумен өтті.
Dialogue: 0,0:13:32.52,0:13:34.52,Default,,0,0,0,,Уақыт көзді ашып-жұмғанша өтті
Dialogue: 0,0:13:35.10,0:13:36.39,Default,,0,0,0,,Сіз қараңғысыз!
Dialogue: 0,0:13:36.52,0:13:37.85,Default,,0,0,0,,Сен ақсың
Dialogue: 0,0:13:37.98,0:13:38.94,Default,,0,0,0,,Коюки-кун
Dialogue: 0,0:13:39.06,0:13:42.65,Default,,0,0,0,,Саку-чаннан естідім, сен шынымен мектепті тастап кетесің бе?
Dialogue: 0,0:13:42.78,0:13:44.07,Default,,0,0,0,,Иә
Dialogue: 0,0:13:44.49,0:13:45.53,Default,,0,0,0,,Коюки-кун...
Dialogue: 0,0:13:45.65,0:13:48.16,Default,,0,0,0,,Мен табиғи өшуді мақсат еттім, бірақ...
Dialogue: 0,0:13:48.28,0:13:51.12,Default,,0,0,0,,Америка туры да бар, сондықтан менің ойымша, бұл жақсы уақыт.
Dialogue: 0,0:13:51.24,0:13:53.41,Default,,0,0,0,,Ах, мен өзімді жалғыз сезінемін...
Dialogue: 0,0:13:53.54,0:13:54.37,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:54.50,0:13:58.62,Default,,0,0,0,,Америка... баруға тым алыс.
Dialogue: 0,0:13:59.71,0:14:00.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:01.88,0:14:03.09,Default,,0,0,0,,Қош бол!
Dialogue: 0,0:14:03.50,0:14:05.21,Default,,0,0,0,,（）
Dialogue: 0,0:14:05.34,0:14:07.22,Default,,0,0,0,,(Мектеп сигналы)
Dialogue: 0,0:14:07.34,0:14:10.22,Default,,0,0,0,,Студенттік кеңестің хабарламасы бар.
Dialogue: 0,0:14:10.34,0:14:12.72,Default,,0,0,0,,26 күні сағат 15:00-ден бастап...
Dialogue: 0,0:14:12.97,0:14:14.01,Default,,0,0,0,,(Коюкидің ән айту дауысы)
Dialogue: 0,0:14:14.01,0:14:18.81,Default,,0,0,0,,(Коюкидің ән айту дауысы)
Dialogue: 0,0:14:14.01,0:14:18.81,Default,,0,0,0,,Америка турнесінің алдында тікелей эфирдің қызықты аптасы басталды.
Dialogue: 0,0:14:18.81,0:14:19.48,Default,,0,0,0,,Америка турнесінің алдында тікелей эфирдің қызықты аптасы басталды.
Dialogue: 0,0:14:23.40,0:14:26.44,Default,,0,0,0,,(БЕК орындауы)
Dialogue: 0,0:14:29.07,0:14:30.45,Default,,0,0,0,,Соңғысы мынамен аяқталды:
Dialogue: 0,0:14:30.57,0:14:31.24,Default,,0,0,0,,Бұл маркет.
Dialogue: 0,0:14:31.24,0:14:31.87,Default,,0,0,0,,Бұл маркет.
Dialogue: 0,0:14:31.24,0:14:31.87,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:14:31.87,0:14:31.99,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:14:31.99,0:14:33.66,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:14:31.99,0:14:33.66,Default,,0,0,0,,Біздің келесі жанды орындау туралы хабарландыру...
Dialogue: 0,0:14:33.66,0:14:34.54,Default,,0,0,0,,Біздің келесі жанды орындау туралы хабарландыру...
Dialogue: 0,0:14:34.66,0:14:35.70,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:35.70,0:14:36.12,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:35.70,0:14:36.12,Default,,0,0,0,,(аудиторияны қоздыру)
Dialogue: 0,0:14:36.12,0:14:36.79,Default,,0,0,0,,(аудиторияны қоздыру)
Dialogue: 0,0:14:36.79,0:14:37.25,Default,,0,0,0,,(аудиторияны қоздыру)
Dialogue: 0,0:14:36.79,0:14:37.25,Default,,0,0,0,,BECK келесі аптада басталады
Dialogue: 0,0:14:37.25,0:14:37.75,Default,,0,0,0,,BECK келесі аптада басталады
Dialogue: 0,0:14:37.87,0:14:43.46,Default,,0,0,0,,50 күн, 46 орын, біз АҚШ-тың тозақтық турына барамыз!
Dialogue: 0,0:14:45.34,0:14:46.96,Default,,0,0,0,,БЕК Керемет!
Dialogue: 0,0:14:48.80,0:14:52.51,Default,,0,0,0,,♪「ӨМІР ДӘТТІЛЕРІ」
Dialogue: 0,0:14:58.64,0:14:59.85,Default,,0,0,0,,Бұл тікелей эфир-
Dialogue: 0,0:14:59.98,0:15:02.81,Default,,0,0,0,,Соңында Чиба-кун аудиторияға сүңгіп, шымылдықты жапты.
Dialogue: 0,0:15:02.94,0:15:05.61,Default,,0,0,0,,Бұл өте керемет болды, иә...
Dialogue: 0,0:15:07.44,0:15:09.45,Default,,0,0,0,,БЕК ше?
Dialogue: 0,0:15:09.57,0:15:12.24,Default,,0,0,0,,Танаканың гитарасы өте жақсы болды
Dialogue: 0,0:15:12.36,0:15:13.57,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:15:13.87,0:15:14.70,Default,,0,0,0,,О
Dialogue: 0,0:15:14.83,0:15:16.24,Default,,0,0,0,,Иә? (Хёдо) Онда кездескенше.
Dialogue: 0,0:15:16.70,0:15:18.83,Default,,0,0,0,,Коюки Қазір...
Dialogue: 0,0:15:18.95,0:15:21.62,Default,,0,0,0,,Бұл Хиодо. Менің ойымша, ол қонақ ретінде келді.
Dialogue: 0,0:15:21.75,0:15:23.17,Default,,0,0,0,,Сіз топтасыз ба?
Dialogue: 0,0:15:23.29,0:15:24.54,Default,,0,0,0,,Соңғы уақытта Поша...
Dialogue: 0,0:15:24.67,0:15:27.17,Default,,0,0,0,,Біз жаңа мүшелерді іздейміз.
Dialogue: 0,0:15:27.30,0:15:28.84,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:28.96,0:15:30.97,Default,,0,0,0,,Американдық турға сәттілік тілейміз
Dialogue: 0,0:15:31.09,0:15:32.68,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:35.76,0:15:36.89,Default,,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 0,0:15:37.01,0:15:38.60,Default,,0,0,0,,Өйткені, екі ай демалыс...
Dialogue: 0,0:15:38.72,0:15:40.43,Default,,0,0,0,,Әрине
Dialogue: 0,0:15:40.56,0:15:41.85,Default,,0,0,0,,Олай болса маған жұмыстан шығуға рұқсат етіңіз...
Dialogue: 0,0:15:41.98,0:15:45.11,Default,,0,0,0,,Жақында сіздің орнын басатын адамды табасыз.
Dialogue: 0,0:15:45.40,0:15:47.98,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:15:48.32,0:15:50.19,Default,,0,0,0,,Америка?
Dialogue: 0,0:15:52.91,0:15:55.16,Default,,0,0,0,,Ол жігіттерден жеңілме.
Dialogue: 0,0:15:55.28,0:15:56.37,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:56.78,0:15:57.83,Default,,0,0,0,,сырғып кету
Dialogue: 0,0:15:57.95,0:15:59.12,Default,,0,0,0,,Сырғытыңыз
Dialogue: 0,0:16:00.04,0:16:01.62,Default,,0,0,0,,тыс!
Dialogue: 0,0:16:01.71,0:16:02.62,Default,,0,0,0,,тыс
Dialogue: 0,0:16:02.75,0:16:04.33,Default,,0,0,0,,Енді мүлде жоқ!
Dialogue: 0,0:16:04.46,0:16:06.29,Default,,0,0,0,,Біз ертең кетеміз, солай ма?
Dialogue: 0,0:16:06.42,0:16:09.13,Default,,0,0,0,,Мынадай қарапайым нәрсені айта алмасаңыз...
Dialogue: 0,0:16:09.21,0:16:11.51,Default,,0,0,0,,Америкаға бармағаныңыз жөн!
Dialogue: 0,0:16:11.63,0:16:13.80,Default,,0,0,0,,Тіпті Махо да канжиде жақсы емес.
Dialogue: 0,0:16:13.93,0:16:16.14,Default,,0,0,0,,Бұл оқиғаның еш қатысы жоқ!
Dialogue: 0,0:16:16.26,0:16:19.31,Default,,0,0,0,,Кішкене жұмсақ бола алмайсың ба?
Dialogue: 0,0:16:20.18,0:16:22.31,Default,,0,0,0,,Бұл өте жаман болды, мен мейірімді емес едім.
Dialogue: 0,0:16:22.43,0:16:23.77,Default,,0,0,0,,Шулы
Dialogue: 0,0:16:23.89,0:16:26.15,Default,,0,0,0,,Коюки Америкада өлуі керек!
Dialogue: 0,0:16:26.36,0:16:27.90,Default,,0,0,0,,（）
Dialogue: 0,0:16:28.02,0:16:29.78,Default,,0,0,0,,Махоның ақымақ...
Dialogue: 0,0:16:31.44,0:16:35.16,Default,,0,0,0,,Иә, мен Танакамын, мен екі адамға сағат 7-ге тапсырыс бердім.
Dialogue: 0,0:16:35.28,0:16:37.49,Default,,0,0,0,,Кешіріңіз, бас тартуыңызды өтінемін.
Dialogue: 0,0:16:37.62,0:16:38.78,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:38.91,0:16:41.16,Default,,0,0,0,,Коюки-кун Махоның ұмытылған заты
Dialogue: 0,0:16:41.29,0:16:43.75,Default,,0,0,0,,Не? Бұл...
Dialogue: 0,0:16:46.83,0:16:48.46,Default,,0,0,0,,Махо...
Dialogue: 0,0:16:48.59,0:16:54.51,Default,,0,0,0,,♪「СУДАҒЫ АЙ」
Dialogue: 0,0:17:01.93,0:17:04.48,Default,,0,0,0,,Юкио! Сіздің төлқұжатыңыз болды ма?
Dialogue: 0,0:17:04.60,0:17:05.73,Default,,0,0,0,,Иә
Dialogue: 0,0:17:06.31,0:17:09.19,Default,,0,0,0,,Олай болса, әкеңмен амандасайық.
Dialogue: 0,0:17:09.31,0:17:10.65,Default,,0,0,0,,Иә
Dialogue: 0,0:17:10.77,0:17:12.90,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:17:15.32,0:17:17.11,Default,,0,0,0,,Сіз әжеңізге қоңырау шалдыңыз ба?
Dialogue: 0,0:17:17.87,0:17:18.91,Default,,0,0,0,,Иә
Dialogue: 0,0:17:24.12,0:17:27.29,Default,,0,0,0,,Бірақ мен қанша қарасам да, бұл қиын кесте.
Dialogue: 0,0:17:27.42,0:17:29.75,Default,,0,0,0,,Оған шынымен 50 күн қажет пе?
Dialogue: 0,0:17:29.88,0:17:32.59,Default,,0,0,0,,Ол болады! Бұл бір нәрсе!
Dialogue: 0,0:17:33.05,0:17:34.34,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:17:38.59,0:17:41.22,Default,,0,0,0,,Мм, осында шығар?
Dialogue: 0,0:17:41.22,0:17:41.60,Default,,0,0,0,,Мм, осында шығар?
Dialogue: 0,0:17:41.22,0:17:41.60,Default,,0,0,0,,(Слайдпен жұмыс дыбысы)
Dialogue: 0,0:17:41.60,0:17:41.93,Default,,0,0,0,,(Слайдпен жұмыс дыбысы)
Dialogue: 0,0:17:41.93,0:17:42.68,Default,,0,0,0,,(Слайдпен жұмыс дыбысы)
Dialogue: 0,0:17:41.93,0:17:42.68,Default,,0,0,0,,Эй, ол кенет назардан шығып қалды.
Dialogue: 0,0:17:42.68,0:17:44.85,Default,,0,0,0,,Эй, ол кенет назардан шығып қалды.
Dialogue: 0,0:17:45.43,0:17:47.52,Default,,0,0,0,,О, мен Америка құрлығын көріп тұрмын.
Dialogue: 0,0:17:47.64,0:17:49.15,Default,,0,0,0,,Бұл реактивті қанаттар ма?
Dialogue: 0,0:17:49.23,0:17:50.06,Default,,0,0,0,,Иә
Dialogue: 0,0:17:50.81,0:17:51.65,Default,,0,0,0,,Қазір толқу -
Dialogue: 0,0:17:51.77,0:17:53.82,Default,,0,0,0,,F.V.E. вокалист Дэвид Эрик...
Dialogue: 0,0:17:53.94,0:17:55.44,Default,,0,0,0,,Ол мені көлікпен алып кетуге келді.
Dialogue: 0,0:17:55.57,0:17:57.53,Default,,0,0,0,,Фокус артқы жағында.
Dialogue: 0,0:17:58.16,0:17:59.16,Default,,0,0,0,,Бұл бөтен база.
Dialogue: 0,0:17:59.28,0:18:00.78,Default,,0,0,0,,Лос-Анджелес әуежайы.
Dialogue: 0,0:18:01.24,0:18:02.12,Default,,0,0,0,,Бұл мен тұрған қонақүй.
Dialogue: 0,0:18:02.24,0:18:03.91,Default,,0,0,0,,Huh~ Бұл өте жақсы.
Dialogue: 0,0:18:04.04,0:18:05.79,Default,,0,0,0,,Бұл жалғыз жақсы нәрсе болды.
Dialogue: 0,0:18:06.33,0:18:07.71,Default,,0,0,0,,Эх, Чиба-кун оқиды.
Dialogue: 0,0:18:07.83,0:18:09.79,Default,,0,0,0,,Сіз не оқып жатырсыз...
Dialogue: 0,0:18:10.25,0:18:12.13,Default,,0,0,0,,Бізде тікелей эфирде шоу болды (Махо) Ах~!
Dialogue: 0,0:18:12.25,0:18:14.34,Default,,0,0,0,,Онда «Mongolian Chop Squad» деп жазылған!
Dialogue: 0,0:18:14.84,0:18:16.42,Default,,0,0,0,,Бірақ мен өзімді мүлде жақсы сезінбедім...
Dialogue: 0,0:18:16.55,0:18:17.84,Default,,0,0,0,,А, тұтынушы төмен қарап тұр.
Dialogue: 0,0:18:18.22,0:18:19.18,Default,,0,0,0,,Чиба депрессияда
Dialogue: 0,0:18:19.30,0:18:21.35,Default,,0,0,0,,Ха ха, бұрыңыз!
Dialogue: 0,0:18:21.97,0:18:23.56,Default,,0,0,0,,Бұл фургонға қарсы адамдар.
Dialogue: 0,0:18:23.68,0:18:25.85,Default,,0,0,0,,Коюки... қайда? Хехе...
Dialogue: 0,0:18:26.35,0:18:27.52,Default,,0,0,0,,Мен осы көлікпен саяхаттадым.
Dialogue: 0,0:18:27.64,0:18:30.44,Default,,0,0,0,,Хахаха шайнап жатырмын Саку шайнап жатыр!
Dialogue: 0,0:18:30.56,0:18:31.81,Default,,0,0,0,,О, онда көп адам бар.
Dialogue: 0,0:18:31.94,0:18:33.48,Default,,0,0,0,,Бұл біз емес.
Dialogue: 0,0:18:33.61,0:18:34.90,Default,,0,0,0,,Бұл шаш таңғажайып түс.
Dialogue: 0,0:18:35.03,0:18:36.28,Default,,0,0,0,,Кесірткелер (Кесірткелер) Мен адаммын.
Dialogue: 0,0:18:36.40,0:18:37.36,Default,,0,0,0,,Ә!?
Dialogue: 0,0:18:37.86,0:18:40.36,Default,,0,0,0,,Мен CD саттым. Ол өте жақсы сатылды.
Dialogue: 0,0:18:40.49,0:18:41.37,Default,,0,0,0,,Я~
Dialogue: 0,0:18:42.03,0:18:43.49,Default,,0,0,0,,Мен осы көлікпен саяхаттадым.
Dialogue: 0,0:18:43.62,0:18:45.37,Default,,0,0,0,,Америкаға ұқсайды.
Dialogue: 0,0:18:45.62,0:18:48.37,Default,,0,0,0,,Бұл бақа (Махо) Хахаха... Біртүрлі екен.
Dialogue: 0,0:18:48.83,0:18:50.87,Default,,0,0,0,,Мына көлікте... (Махо) Иә, иә.
Dialogue: 0,0:18:51.46,0:18:53.09,Default,,0,0,0,,А, міне сайқымазақ бар.
Dialogue: 0,0:18:53.59,0:18:54.80,Default,,0,0,0,,Бұл жерде керемет болды.
Dialogue: 0,0:18:54.92,0:18:56.17,Default,,0,0,0,,Хмм, бірақ мен оны көре алмаймын.
Dialogue: 0,0:18:56.30,0:18:59.09,Default,,0,0,0,,Ғажайып Лонг-Бич өмір сүрсін!
Dialogue: 0,0:18:59.88,0:19:01.09,Default,,0,0,0,,Бәрімізде сессия болды
Dialogue: 0,0:19:01.22,0:19:02.51,Default,,0,0,0,,Сіз не істеп жатырсыз? Коюки
Dialogue: 0,0:19:02.64,0:19:04.60,Default,,0,0,0,,А, бұл панк~ Иә.
Dialogue: 0,0:19:04.72,0:19:06.35,Default,,0,0,0,,Бұл Чиба-кун.
Dialogue: 0,0:19:07.18,0:19:08.60,Default,,0,0,0,,Бұл таңғажайып бұлттар.
Dialogue: 0,0:19:08.73,0:19:10.31,Default,,0,0,0,,Шынайы бұдан да керемет болды.
Dialogue: 0,0:19:10.44,0:19:11.56,Default,,0,0,0,,Я~
Dialogue: 0,0:19:11.69,0:19:12.56,Default,,0,0,0,,О сессиясы
Dialogue: 0,0:19:12.69,0:19:15.11,Default,,0,0,0,,Ол Америкада да танымал болды.
Dialogue: 0,0:19:15.19,0:19:16.15,Default,,0,0,0,,Бұл Чиба-кун.
Dialogue: 0,0:19:16.28,0:19:17.86,Default,,0,0,0,,Хехе... Коюки сондай сүйкімді
Dialogue: 0,0:19:17.99,0:19:20.11,Default,,0,0,0,,Барлығы шаршау шегіне жетті.
Dialogue: 0,0:19:20.57,0:19:21.74,Default,,0,0,0,,Э-э…
Dialogue: 0,0:19:21.86,0:19:23.12,Default,,0,0,0,,Бір сәтке демалу
Dialogue: 0,0:19:23.53,0:19:24.91,Default,,0,0,0,,Нью-Йоркте жүзу
Dialogue: 0,0:19:25.03,0:19:27.12,Default,,0,0,0,,Қараңғы, мен түсінбеймін
Dialogue: 0,0:19:27.54,0:19:28.75,Default,,0,0,0,,Нью-Йорктегі серуен
Dialogue: 0,0:19:28.87,0:19:30.62,Default,,0,0,0,,Хот-дог жедіңіз бе? Иә
Dialogue: 0,0:19:31.29,0:19:32.62,Default,,0,0,0,,CBGB
Dialogue: 0,0:19:32.75,0:19:34.54,Default,,0,0,0,,Аудиторияға арналған орындар оң жақта.
Dialogue: 0,0:19:34.63,0:19:35.79,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:19:35.92,0:19:38.05,Default,,0,0,0,,Бұл жігіт. Ол Нью-Йорк панк.
Dialogue: 0,0:19:38.80,0:19:40.17,Default,,0,0,0,,Хмм, кім?
Dialogue: 0,0:19:40.30,0:19:41.88,Default,,0,0,0,,Ол Кевин Эрик
Dialogue: 0,0:19:42.01,0:19:44.26,Default,,0,0,0,,Гитарист және F.V.E жетекшісі.
Dialogue: 0,0:19:44.39,0:19:45.64,Default,,0,0,0,,Ол Дэвидтің ағасы.
Dialogue: 0,0:19:45.89,0:19:47.97,Default,,0,0,0,,Әй, ол қайтадан бұлыңғыр.
Dialogue: 0,0:19:48.10,0:19:50.14,Default,,0,0,0,,Өйткені Кевин қорқынышты.
Dialogue: 0,0:19:50.56,0:19:51.39,Default,,0,0,0,,Бұл адам да?
Dialogue: 0,0:19:51.52,0:19:54.35,Default,,0,0,0,,Иә, бұл адам. Мүмкін Техас шығар?
Dialogue: 0,0:19:54.48,0:19:56.82,Default,,0,0,0,,Мен де осындай жерлерде жүгірдім (Махо) Ха...
Dialogue: 0,0:19:56.94,0:19:58.15,Default,,0,0,0,,Алтын қақпа көпірі
Dialogue: 0,0:19:58.28,0:20:00.15,Default,,0,0,0,,Бұл Сан-Франциско.
Dialogue: 0,0:20:00.53,0:20:01.36,Default,,0,0,0,,А, бұл не?
Dialogue: 0,0:20:01.49,0:20:02.91,Default,,0,0,0,,Сиэтл.
Dialogue: 0,0:20:03.86,0:20:05.32,Default,,0,0,0,,Pike Place базары
Dialogue: 0,0:20:05.45,0:20:07.58,Default,,0,0,0,,Супер? балық ұшады
Dialogue: 0,0:20:08.20,0:20:09.58,Default,,0,0,0,,Бұл диск.
Dialogue: 0,0:20:10.33,0:20:11.62,Default,,0,0,0,,Джими Хендрикс
Dialogue: 0,0:20:11.75,0:20:13.54,Default,,0,0,0,,Чиба-кун да осындай түс көрді.
Dialogue: 0,0:20:13.67,0:20:15.25,Default,,0,0,0,,«Зиратта кездескенше» дегенді естідім.
Dialogue: 0,0:20:15.38,0:20:16.21,Default,,0,0,0,,Қабыр?
Dialogue: 0,0:20:16.34,0:20:19.05,Default,,0,0,0,,Ал бұл күн тура 18 қыркүйек.
Dialogue: 0,0:20:19.17,0:20:20.67,Default,,0,0,0,,Бұл мен Рюсукенің электрондық поштасын алған күн болды.
Dialogue: 0,0:20:20.80,0:20:21.80,Default,,0,0,0,,Және—
Dialogue: 0,0:20:21.92,0:20:24.38,Default,,0,0,0,,Бұл сонымен қатар Джими Хендрикстің қайтыс болған күні.
Dialogue: 0,0:20:24.51,0:20:26.60,Default,,0,0,0,,Ах, Коюки, ол бұзылды.
Dialogue: 0,0:20:27.43,0:20:28.89,Default,,0,0,0,,Бұл Джими Хендрикстің бейіті.
Dialogue: 0,0:20:29.01,0:20:30.18,Default,,0,0,0,,Иә
Dialogue: 0,0:20:30.64,0:20:33.44,Default,,0,0,0,,Содан кейін біз Рюсуке-кунды таптық.
Dialogue: 0,0:20:33.56,0:20:35.19,Default,,0,0,0,,Бек пен Кит те.
Dialogue: 0,0:20:35.69,0:20:36.77,Default,,0,0,0,,Иә
Dialogue: 0,0:20:37.61,0:20:39.11,Default,,0,0,0,,Ахаха, қайтадан назардан тыс қалды
Dialogue: 0,0:20:39.23,0:20:40.69,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:20:41.19,0:20:43.24,Default,,0,0,0,,А, бұл газет мақаласы.
Dialogue: 0,0:20:43.36,0:20:44.99,Default,,0,0,0,,Леон тұтқындалды ма?
Dialogue: 0,0:20:45.11,0:20:47.53,Default,,0,0,0,,Рюсуке-кун, сен оқиға орнында болдың.
Dialogue: 0,0:20:47.66,0:20:49.70,Default,,0,0,0,,Бауырым, сенің тірі болғаныңа қуаныштымын~
Dialogue: 0,0:20:50.49,0:20:51.87,Default,,0,0,0,,Аа, сіз мұны бұрыннан көрдіңіз.
Dialogue: 0,0:20:52.00,0:20:53.08,Default,,0,0,0,,Иә
Dialogue: 0,0:20:54.41,0:20:56.00,Default,,0,0,0,,Және…
Dialogue: 0,0:20:56.12,0:20:58.54,Default,,0,0,0,,Біз Люсильмен бірге Рюсуке-кунбыз және...
Dialogue: 0,0:20:58.67,0:21:01.80,Default,,0,0,0,,Біз Сиэтлдегі «Крокодил» кафесінде тағы кездестік.
Dialogue: 0,0:21:01.92,0:21:05.26,Default,,0,0,0,,Мен Америкаға келгеннен бері бірінші рет бес мүшенің барлығы бірге болды.
Dialogue: 0,0:21:05.38,0:21:06.97,Default,,0,0,0,,Бұл БЕК
Dialogue: 0,0:21:07.84,0:21:09.85,Default,,0,0,0,,Коюки «Сырғып» шығайық!
Dialogue: 0,0:21:09.97,0:21:10.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:10.93,0:21:13.48,Default,,0,0,0,,(БЕК орындауы)
Dialogue: 0,0:21:13.48,0:21:16.94,Default,,0,0,0,,(БЕК орындауы)
Dialogue: 0,0:21:13.48,0:21:16.94,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:21:16.94,0:21:19.48,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:21:44.63,0:21:49.09,Default,,0,0,0,,(Коюкидің ағылшынша ән айтатын дауысы)
Dialogue: 0,0:22:13.16,0:22:15.37,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:22:15.50,0:22:17.00,Default,,0,0,0,,Қорлауды тоқтатыңыз
Dialogue: 0,0:22:17.12,0:22:20.54,Default,,0,0,0,,Өте тітіркендіргіш! Барлығымыз, кеттік!
Dialogue: 0,0:22:23.75,0:22:25.80,Default,,0,0,0,,Бек! Мында кел!
Dialogue: 0,0:22:25.92,0:22:27.84,Default,,0,0,0,,(Рюсукенің ағылшыншасы)
Dialogue: 0,0:22:27.84,0:22:28.59,Default,,0,0,0,,(Рюсукенің ағылшыншасы)
Dialogue: 0,0:22:27.84,0:22:28.59,Default,,0,0,0,,(Бектің жылағаны)
Dialogue: 0,0:22:28.59,0:22:28.72,Default,,0,0,0,,(Бектің жылағаны)
Dialogue: 0,0:22:28.72,0:22:31.39,Default,,0,0,0,,(Бектің жылағаны)
Dialogue: 0,0:22:28.72,0:22:31.39,Default,,0,0,0,,(Рюсукенің ағылшыншасы)
Dialogue: 0,0:22:31.39,0:22:31.51,Default,,0,0,0,,(Бектің жылағаны)
Dialogue: 0,0:22:31.51,0:22:33.06,Default,,0,0,0,,(Бектің жылағаны)
Dialogue: 0,0:22:31.51,0:22:33.06,Default,,0,0,0,,Шет елден келген адам?
Dialogue: 0,0:22:33.06,0:22:34.35,Default,,0,0,0,,Шет елден келген адам?
Dialogue: 0,0:22:35.10,0:22:38.60,Default,,0,0,0,,Хаха~ Бұл ит жиіркенішті.
Dialogue: 0,0:22:38.73,0:22:40.44,Default,,0,0,0,,Бекке көмегіңіз үшін рахмет.
Dialogue: 0,0:22:40.81,0:22:45.65,Default,,0,0,0,,♪～
Dialogue: 0,0:23:30.99,0:23:37.95,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:23:39.45,0:23:43.46,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:23:56.35,0:24:00.81,Default,,0,0,0,,～♪
Dialogue: 0,0:24:01.69,0:24:06.27,Default,,0,0,0,,(аудиторияның қолдауы)
