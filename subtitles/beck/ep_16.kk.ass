Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.45,0:00:07.00,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.67,0:01:36.93,Default,,0,0,0,,～♪
Dialogue: 0,0:01:53.73,0:01:55.36,Default,,0,0,0,,Иә? (Еркек) Хехе
Dialogue: 0,0:01:56.53,0:01:58.32,Default,,0,0,0,,〈Сіз картридждерді алдыңыз ба? 〉
Dialogue: 0,0:02:00.24,0:02:01.07,Default,,0,0,0,,〈Бұл кім? 〉
Dialogue: 0,0:02:04.04,0:02:07.08,Default,,0,0,0,,<Сұрақтарға байсалдылықпен жауап берсеңіз, бұл жақсы.>
Dialogue: 0,0:02:07.16,0:02:10.58,Default,,0,0,0,,<Эди Ли өлгенде көптеген ақ адамдар қайғырады, солай ма? 〉
Dialogue: 0,0:02:11.92,0:02:14.09,Default,,0,0,0,,<Мен үшін маңызды емес.>
Dialogue: 0,0:02:15.00,0:02:16.63,Default,,0,0,0,,〈Кімнің? 〉
Dialogue: 0,0:02:16.80,0:02:18.72,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:02:19.18,0:02:20.43,Default,,0,0,0,,<Сұрақ қоятын менмін>
Dialogue: 0,0:02:20.55,0:02:24.10,Default,,0,0,0,,<Сен ұрлаған заттар қайда! 〉
Dialogue: 0,0:02:27.31,0:02:28.60,Default,,0,0,0,,<Не? 〉
Dialogue: 0,0:02:28.69,0:02:31.60,Default,,0,0,0,,<Эди, жақсысың ба? 〉
Dialogue: 0,0:02:31.69,0:02:32.52,Default,,0,0,0,,〈Аа〉
Dialogue: 0,0:02:32.61,0:02:35.61,Default,,0,0,0,,〈Қауіпсіздік келді, ол қашып кетті〉
Dialogue: 0,0:02:36.07,0:02:37.19,Default,,0,0,0,,<Мен көремін>
Dialogue: 0,0:02:37.32,0:02:38.49,Default,,0,0,0,,〈Жақсы〉
Dialogue: 0,0:02:38.61,0:02:40.74,Default,,0,0,0,,<Ол білді>
Dialogue: 0,0:02:40.86,0:02:43.95,Default,,0,0,0,,〈Жоқ, олардың білмейтініне сенімдімін! 〉
Dialogue: 0,0:02:44.08,0:02:45.83,Default,,0,0,0,,<Фильм аяқталды>
Dialogue: 0,0:02:45.95,0:02:48.62,Default,,0,0,0,,<Бұл біздің экскурсиялық фильм, режиссер Джим>
Dialogue: 0,0:02:49.04,0:02:49.87,Default,,0,0,0,,Иә...
Dialogue: 0,0:02:50.00,0:02:53.46,Default,,0,0,0,,<Мен оны өткен аптадан бері бірнеше рет алдын ала қарап шықтым>
Dialogue: 0,0:02:53.67,0:02:54.50,Default,,0,0,0,,<Жоқ>
Dialogue: 0,0:02:55.38,0:02:58.42,Default,,0,0,0,,〈Олар менен Люсильді ойнайтын сахнаны қиып алуымды өтінді.〉
Dialogue: 0,0:02:58.55,0:03:00.84,Default,,0,0,0,,<Джимнен сұрадым, ол да суретші>
Dialogue: 0,0:03:01.05,0:03:01.89,Default,,0,0,0,,<Мен көремін>
Dialogue: 0,0:03:05.56,0:03:07.47,Default,,0,0,0,,〈Коюки әні〉
Dialogue: 0,0:03:07.60,0:03:10.81,Default,,0,0,0,,<Бұл шынымен де әсерлі көрініс>
Dialogue: 0,0:03:17.82,0:03:20.19,Default,,0,0,0,,(Бектің жылағаны)
Dialogue: 0,0:03:44.30,0:03:46.64,Default,,0,0,0,,Мен тағы келемін.
Dialogue: 0,0:03:47.35,0:03:48.77,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:48.89,0:03:51.60,Default,,0,0,0,,Анау бала, күнде кел, жымиып, жиіркенішті.
Dialogue: 0,0:03:51.73,0:03:54.02,Default,,0,0,0,,О, не болса да, мен тележүргізушіні көргенде—
Dialogue: 0,0:03:54.15,0:03:57.15,Default,,0,0,0,,Ауыр еңбекке төтеп береді дейді.
Dialogue: 0,0:03:57.69,0:03:59.48,Default,,0,0,0,,Я~
Dialogue: 0,0:03:59.61,0:04:00.78,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:04:02.20,0:04:04.70,Default,,0,0,0,,Асықпасаң, сатылып кетеді.
Dialogue: 0,0:04:10.54,0:04:11.45,Default,,0,0,0,,Эй! Эй!
Dialogue: 0,0:04:11.45,0:04:12.83,Default,,0,0,0,,Эй! Эй!
Dialogue: 0,0:04:11.45,0:04:12.83,Default,,0,0,0,,Ммм
Dialogue: 0,0:04:13.62,0:04:15.33,Default,,0,0,0,,Серіппелі роллдар әлі бар ма?
Dialogue: 0,0:04:15.42,0:04:17.71,Default,,0,0,0,,О, кешіріңіз.
Dialogue: 0,0:04:18.42,0:04:21.01,Default,,0,0,0,,Эй Танака, Теншин тым күйіп кетті.
Dialogue: 0,0:04:21.13,0:04:23.17,Default,,0,0,0,,Тұтынушы шағымданды.
Dialogue: 0,0:04:23.30,0:04:24.34,Default,,0,0,0,,О, кешіріңіз.
Dialogue: 0,0:04:24.43,0:04:27.05,Default,,0,0,0,,Әй, серіппелер! Иә
Dialogue: 0,0:04:29.56,0:04:30.64,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:30.77,0:04:33.73,Default,,0,0,0,,Ей, Танака, сорпаны жинаған түрің жаман екен.
Dialogue: 0,0:04:33.85,0:04:36.27,Default,,0,0,0,,Сол тұтынушы қайтадан шағымданды.
Dialogue: 0,0:04:36.40,0:04:37.36,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:04:44.20,0:04:47.49,Default,,0,0,0,,Бұл таңқаларлық, бірақ ол дұрыс жұмыс істейді.
Dialogue: 0,0:04:48.57,0:04:50.58,Default,,0,0,0,,Енді мен айтамын, бұл дүкен жақсы.
Dialogue: 0,0:04:50.70,0:04:53.75,Default,,0,0,0,,Қызмет толығымен қолжетімді.
Dialogue: 0,0:04:53.83,0:04:56.12,Default,,0,0,0,,Аа, олай емес, ақша алайын деп жатырмын...
Dialogue: 0,0:04:56.12,0:04:57.13,Default,,0,0,0,,Аа, олай емес, ақша алайын деп жатырмын...
Dialogue: 0,0:04:56.12,0:04:57.13,Default,,0,0,0,,Ах! Неліктен Сайто-сан...
Dialogue: 0,0:04:57.13,0:04:57.25,Default,,0,0,0,,Ах! Неліктен Сайто-сан...
Dialogue: 0,0:04:57.25,0:04:59.84,Default,,0,0,0,,Ах! Неліктен Сайто-сан...
Dialogue: 0,0:04:57.25,0:04:59.84,Default,,0,0,0,,Сізде қандай жүйке бар?
Dialogue: 0,0:04:59.92,0:05:01.55,Default,,0,0,0,,Жоқ, шынымен...
Dialogue: 0,0:05:01.67,0:05:04.26,Default,,0,0,0,,Мен оны маған тегін берерсің деп ойладым.
Dialogue: 0,0:05:05.09,0:05:07.39,Default,,0,0,0,,Tsk, бұл шынымен керемет дүкен.
Dialogue: 0,0:05:07.51,0:05:09.89,Default,,0,0,0,,Құпия болған сенсің
Dialogue: 0,0:05:10.01,0:05:12.52,Default,,0,0,0,,Өтінемін, мен үшін сейсенбі.
Dialogue: 0,0:05:12.64,0:05:14.85,Default,,0,0,0,,Сондай-ақ тонналап жеткізілім бар.
Dialogue: 0,0:05:14.93,0:05:17.15,Default,,0,0,0,,Мүмкін мен тез шомылу керек шығар.
Dialogue: 0,0:05:17.27,0:05:20.36,Default,,0,0,0,,Риели ах Рири Рири...
Dialogue: 0,0:05:22.36,0:05:23.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:22.36,0:05:23.23,Default,,0,0,0,,(шу)
Dialogue: 0,0:05:23.23,0:05:24.36,Default,,0,0,0,,(шу)
Dialogue: 0,0:05:24.57,0:05:26.57,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:30.78,0:05:32.37,Default,,0,0,0,,Ммм
Dialogue: 0,0:05:36.41,0:05:40.88,Default,,0,0,0,,Мүмкін мен көршілес пончик дүкенінде сұхбат алуым керек шығар. Хехе.
Dialogue: 0,0:05:41.54,0:05:44.88,Default,,0,0,0,,Жалқау болмаңыз, жұмыс істейік!
Dialogue: 0,0:05:44.96,0:05:47.22,Default,,0,0,0,,О! Кешіріңіз!
Dialogue: 0,0:05:48.34,0:05:49.97,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:50.47,0:05:51.55,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:58.48,0:06:00.73,Default,,0,0,0,,Ммм~ Өте керемет~
Dialogue: 0,0:06:00.86,0:06:03.90,Default,,0,0,0,,Жоқ, жоқ, Йошито менікі.
Dialogue: 0,0:06:04.03,0:06:06.36,Default,,0,0,0,,Иә, Йошито менікі~
Dialogue: 0,0:06:06.49,0:06:07.28,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:06:07.28,0:06:08.78,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:06:07.28,0:06:08.78,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:06:08.78,0:06:08.91,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:06:08.91,0:06:09.11,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:06:08.91,0:06:09.11,Default,,0,0,0,,Не? иә?
Dialogue: 0,0:06:09.11,0:06:10.07,Default,,0,0,0,,Не? иә?
Dialogue: 0,0:06:10.62,0:06:12.53,Default,,0,0,0,,Бұл адам танымал ма?
Dialogue: 0,0:06:12.87,0:06:16.54,Default,,0,0,0,,Иә? Шынайы ма? Танака-кун, сен 8 тамыздағы драманы көрмедің бе?
Dialogue: 0,0:06:16.62,0:06:18.62,Default,,0,0,0,,Жүйрік болудың жалғыздығы ма?
Dialogue: 0,0:06:18.75,0:06:20.88,Default,,0,0,0,,Маған Харука қатты ұнайды~
Dialogue: 0,0:06:21.00,0:06:25.55,Default,,0,0,0,,Йошито-кун мүгедектер арбасына таңылған бала ретінде бұзылудың алдында тұр.
Dialogue: 0,0:06:25.96,0:06:27.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:27.59,0:06:29.09,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:34.72,0:06:37.56,Default,,0,0,0,,Жоқ, сен бүгін кірдің.
Dialogue: 0,0:06:37.64,0:06:39.48,Default,,0,0,0,,Мен қатты шаршадым.
Dialogue: 0,0:06:39.60,0:06:40.98,Default,,0,0,0,,Ал, мен кіремін, мен шығамын.
Dialogue: 0,0:06:41.10,0:06:42.98,Default,,0,0,0,,Иә, шын айтасыз ба?
Dialogue: 0,0:06:45.61,0:06:47.49,Default,,0,0,0,,Сәлем Танака-кун
Dialogue: 0,0:06:47.61,0:06:50.57,Default,,0,0,0,,Тұтынушы қыз мені Минами деп атайды.
Dialogue: 0,0:06:50.86,0:06:53.49,Default,,0,0,0,,Не, Махо?
Dialogue: 0,0:06:53.74,0:06:55.62,Default,,0,0,0,,Ол өте сүйкімді қыз.
Dialogue: 0,0:06:55.74,0:06:56.62,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:06:56.74,0:06:58.58,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:07:04.75,0:07:05.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:07.55,0:07:09.13,Default,,0,0,0,,Висс
Dialogue: 0,0:07:13.18,0:07:14.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:15.60,0:07:18.47,Default,,0,0,0,,Эй, сен ол баланы көрдің бе?
Dialogue: 0,0:07:18.60,0:07:19.64,Default,,0,0,0,,Э~?
Dialogue: 0,0:07:23.23,0:07:24.81,Default,,0,0,0,,Ах, драма адамы.
Dialogue: 0,0:07:24.94,0:07:26.65,Default,,0,0,0,,Ми су жарнамасында пайда болды...
Dialogue: 0,0:07:27.94,0:07:29.82,Default,,0,0,0,,Мен мұны Рюсукеден естідім~
Dialogue: 0,0:07:29.94,0:07:31.15,Default,,0,0,0,,Иә
Dialogue: 0,0:07:31.90,0:07:33.66,Default,,0,0,0,,Сіз қатты тырысып жатқан сияқтысыз.
Dialogue: 0,0:07:33.95,0:07:37.03,Default,,0,0,0,,Жоқ, әлі бірдеңе бар...
Dialogue: 0,0:07:37.12,0:07:38.91,Default,,0,0,0,,Аа, дұрыс, мен сені таныстырамын.
Dialogue: 0,0:07:39.04,0:07:41.16,Default,,0,0,0,,Сыныптасы Йошито
Dialogue: 0,0:07:41.96,0:07:44.04,Default,,0,0,0,,Мен Миччанды оның дүкенінде кездестірдім.
Dialogue: 0,0:07:44.13,0:07:47.17,Default,,0,0,0,,Драма болып жатқан жоқ па? Бұл керемет
Dialogue: 0,0:07:48.50,0:07:51.22,Default,,0,0,0,,Эй Махо, бұл жігіт шынымен лас көрінеді, бірақ...
Dialogue: 0,0:07:51.34,0:07:53.05,Default,,0,0,0,,Мұндағы тамақ дұрыс па?
Dialogue: 0,0:07:55.22,0:07:57.10,Default,,0,0,0,,Эй, Коюки дүйсенбіде бос па?
Dialogue: 0,0:07:57.22,0:07:58.39,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:07:58.51,0:08:00.73,Default,,0,0,0,,Біз Кристиннің туған күнін өткізіп жатырмыз.
Dialogue: 0,0:08:00.85,0:08:03.06,Default,,0,0,0,,Мен де Коюки келер ме деп едім.
Dialogue: 0,0:08:03.14,0:08:06.06,Default,,0,0,0,,О, Кристин...
Dialogue: 0,0:08:06.15,0:08:10.61,Default,,0,0,0,,<Кеш тек мектептегі достарға арналған, солай ма? 〉
Dialogue: 0,0:08:10.74,0:08:11.74,Default,,0,0,0,,〈Жарайды! 〉
Dialogue: 0,0:08:11.86,0:08:13.91,Default,,0,0,0,,<Адам көп болса қызық>
Dialogue: 0,0:08:14.03,0:08:16.70,Default,,0,0,0,,<Мен сені шақырдым, солай емес пе?>
Dialogue: 0,0:08:16.82,0:08:19.33,Default,,0,0,0,,〈Көп адам болса жақсы〉
Dialogue: 0,0:08:20.12,0:08:22.41,Default,,0,0,0,,Сіз таңғажайып екі тілдесіз.
Dialogue: 0,0:08:22.54,0:08:25.08,Default,,0,0,0,,Мына қыздың түрі өте әдемі~
Dialogue: 0,0:08:29.05,0:08:31.30,Default,,0,0,0,,Олар 5000 иендік курсты жеді.
Dialogue: 0,0:08:31.42,0:08:33.51,Default,,0,0,0,,Тексеріңіз, мұны істемеңіз~
Dialogue: 0,0:08:36.01,0:08:37.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:44.44,0:08:48.11,Default,,0,0,0,,Мен тіпті ағылшынша сөйлей алмаймын.
Dialogue: 0,0:08:49.69,0:08:51.11,Default,,0,0,0,,Эх… Ха-ха-ха
Dialogue: 0,0:08:51.65,0:08:54.11,Default,,0,0,0,,Чинтара Сіз істеп жатырсыз~ Уау!
Dialogue: 0,0:08:55.91,0:08:58.03,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:00.16,0:09:03.00,Default,,0,0,0,,Ахаха жоқ, көп рахмет хаха
Dialogue: 0,0:09:03.12,0:09:04.37,Default,,0,0,0,,Олай болса~
Dialogue: 0,0:09:04.50,0:09:06.12,Default,,0,0,0,,Ннуууу
Dialogue: 0,0:09:06.79,0:09:08.71,Default,,0,0,0,,Барлық белгілер нашар ма?
Dialogue: 0,0:09:08.83,0:09:11.75,Default,,0,0,0,,Бұл жойылу. Өзіміз шығарған CD.
Dialogue: 0,0:09:11.88,0:09:13.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:13.21,0:09:15.68,Default,,0,0,0,,Хмм, мен оны жасау үшін көп еңбек еттім...
Dialogue: 0,0:09:17.84,0:09:20.47,Default,,0,0,0,,Ранның әсері мен күткеннен де жоғары.
Dialogue: 0,0:09:20.60,0:09:23.43,Default,,0,0,0,,Аа, ешкім анық сөйлемейді...
Dialogue: 0,0:09:23.56,0:09:26.69,Default,,0,0,0,,Мен орхидеяның қалың қабырғаларын сеземін.
Dialogue: 0,0:09:26.77,0:09:30.31,Default,,0,0,0,,Оны жаруға бола ма? біздің күшімізбен
Dialogue: 0,0:09:30.65,0:09:31.69,Default,,0,0,0,,Орхидея…
Dialogue: 0,0:09:36.78,0:09:40.70,Default,,0,0,0,,(БЕК әні)
Dialogue: 0,0:09:43.79,0:09:47.08,Default,,0,0,0,,Дыбыс әуесқойлық деңгейде, бірақ...
Dialogue: 0,0:09:47.21,0:09:48.83,Default,,0,0,0,,Мен жарқыраған заттарды сезіне аламын
Dialogue: 0,0:09:48.83,0:09:49.54,Default,,0,0,0,,Мен жарқыраған заттарды сезіне аламын
Dialogue: 0,0:09:48.83,0:09:49.54,Default,,0,0,0,,(өшіру дыбысы)
Dialogue: 0,0:09:49.54,0:09:49.67,Default,,0,0,0,,(өшіру дыбысы)
Dialogue: 0,0:09:49.67,0:09:50.25,Default,,0,0,0,,(өшіру дыбысы)
Dialogue: 0,0:09:49.67,0:09:50.25,Default,,0,0,0,,BECK тобының атын ұмытпаңыз.
Dialogue: 0,0:09:50.25,0:09:52.80,Default,,0,0,0,,BECK тобының атын ұмытпаңыз.
Dialogue: 0,0:09:56.97,0:10:01.85,Default,,0,0,0,,Бірақ бұл жігіттер ешқашан негізгі дебют жасамайды!
Dialogue: 0,0:10:01.97,0:10:03.26,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:10:03.39,0:10:07.52,Default,,0,0,0,,Мені мүкке айналдырған жігітті жерлеймін!
Dialogue: 0,0:10:07.64,0:10:09.19,Default,,0,0,0,,Ран-сан...
Dialogue: 0,0:10:09.27,0:10:14.98,Default,,0,0,0,,Эйдзи! Бұл дүниеде тек мықтылар ғана аман қалады.
Dialogue: 0,0:10:15.11,0:10:18.20,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:10:20.78,0:10:22.20,Default,,0,0,0,,Рахмет. Кешіріңіз.
Dialogue: 0,0:10:28.12,0:10:30.88,Default,,0,0,0,,Бұл дүниеде күш - бәрі.
Dialogue: 0,0:10:33.54,0:10:35.96,Default,,0,0,0,,Ранда бар.
Dialogue: 0,0:10:39.05,0:10:42.47,Default,,0,0,0,,Менің күшім жоқ, сондықтан айналып өтуден басқа амалым жоқ.
Dialogue: 0,0:10:42.60,0:10:44.47,Default,,0,0,0,,Бұл шындық
Dialogue: 0,0:10:44.60,0:10:46.77,Default,,0,0,0,,Бірақ Рюсуке
Dialogue: 0,0:10:47.18,0:10:48.85,Default,,0,0,0,,Қанша жамандық жасасам да...
Dialogue: 0,0:10:48.98,0:10:51.02,Default,,0,0,0,,Сәттілікке қол жеткізіңіз
Dialogue: 0,0:10:59.45,0:11:01.99,Default,,0,0,0,,〈16-шы? 〉
Dialogue: 0,0:11:02.07,0:11:02.99,Default,,0,0,0,,〈Жоқ.〉
Dialogue: 0,0:11:03.12,0:11:04.99,Default,,0,0,0,,<БЕКтің жанды орындауы>
Dialogue: 0,0:11:05.08,0:11:06.16,Default,,0,0,0,,Кэмоне Махо
Dialogue: 0,0:11:06.29,0:11:10.16,Default,,0,0,0,,〈Итамеши мейрамханасының қарттың досы бастаған түнгі көрінісі〉
Dialogue: 0,0:11:10.29,0:11:12.38,Default,,0,0,0,,<Бұл өте әдемі>
Dialogue: 0,0:11:13.29,0:11:14.38,Default,,0,0,0,,Хамф!
Dialogue: 0,0:11:15.46,0:11:17.09,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:11:17.21,0:11:19.47,Default,,0,0,0,,(иттің күлкісі)
Dialogue: 0,0:11:19.80,0:11:21.63,Default,,0,0,0,,〈Ол туралы ойланайық〉
Dialogue: 0,0:11:21.76,0:11:24.18,Default,,0,0,0,,<Мен дәретхана...>
Dialogue: 0,0:11:25.35,0:11:27.56,Default,,0,0,0,,<БЕК қандай топ? 〉
Dialogue: 0,0:11:27.68,0:11:29.18,Default,,0,0,0,,<Бұл шынымен де жақсы ма? 〉
Dialogue: 0,0:11:29.31,0:11:31.81,Default,,0,0,0,,〈Тікелей орындау әрқашан бірінші орында〉
Dialogue: 0,0:11:31.94,0:11:33.85,Default,,0,0,0,,<Мен вокалмен айналысатын жігітпен таныстым>
Dialogue: 0,0:11:33.98,0:11:35.65,Default,,0,0,0,,〈Ал ше? 〉
Dialogue: 0,0:11:36.07,0:11:37.65,Default,,0,0,0,,Хаха
Dialogue: 0,0:11:39.32,0:11:41.95,Default,,0,0,0,,〈Ол ақымақ бала еді〉
Dialogue: 0,0:11:42.49,0:11:46.41,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:11:47.58,0:11:48.99,Default,,0,0,0,,<Мошимоши>
Dialogue: 0,0:11:49.58,0:11:51.91,Default,,0,0,0,,Иә? Жарайды, мен қателік жасадым.
Dialogue: 0,0:11:52.00,0:11:54.29,Default,,0,0,0,,А, Коюки-кун, солай ма?
Dialogue: 0,0:11:54.42,0:11:56.75,Default,,0,0,0,,Иә
Dialogue: 0,0:11:57.17,0:12:00.17,Default,,0,0,0,,Махоның жігіті қазір душ қабылдап жатыр, шыға алмайды...
Dialogue: 0,0:12:00.30,0:12:02.43,Default,,0,0,0,,Саған бірдеңе айтуым керек пе?
Dialogue: 0,0:12:02.51,0:12:03.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:04.22,0:12:07.43,Default,,0,0,0,,А, онда дүйсенбідегі кеш...
Dialogue: 0,0:12:07.68,0:12:09.64,Default,,0,0,0,,Әй, кеш.
Dialogue: 0,0:12:09.77,0:12:12.39,Default,,0,0,0,,Той қонақ үйге шақырылғандай.
Dialogue: 0,0:12:12.52,0:12:14.27,Default,,0,0,0,,Мен сенің салтанатты киіммен келгеніңді қалаймын.
Dialogue: 0,0:12:14.40,0:12:17.23,Default,,0,0,0,,Әрине, құрметті қонаққа сыйлық беріңіз.
Dialogue: 0,0:12:17.36,0:12:19.02,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:12:19.15,0:12:20.48,Default,,0,0,0,,(Телефон қоңыраулары шырылдамайды)
Dialogue: 0,0:12:20.61,0:12:21.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:23.82,0:12:26.87,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:12:27.03,0:12:29.95,Default,,0,0,0,,<Әй, несіне күлесің?>
Dialogue: 0,0:12:35.42,0:12:37.79,Default,,0,0,0,,Коюки мейірімді.
Dialogue: 0,0:12:39.38,0:12:42.63,Default,,0,0,0,,Бірақ сен менің досымды ұнатпайтын сияқтысың.
Dialogue: 0,0:12:42.84,0:12:45.38,Default,,0,0,0,,Біз Кристиннің туған күнін өткізіп жатырмыз.
Dialogue: 0,0:12:45.51,0:12:48.05,Default,,0,0,0,,Мен Коюки де келер ме деп едім.
Dialogue: 0,0:13:05.74,0:13:07.95,Default,,0,0,0,,(Коюки күрсінуі)
Dialogue: 0,0:13:16.75,0:13:17.75,Default,,0,0,0,,〈Ои〉
Dialogue: 0,0:13:18.63,0:13:20.92,Default,,0,0,0,,〈Бүгін жеке күн〉
Dialogue: 0,0:13:21.05,0:13:23.51,Default,,0,0,0,,<Қаңғыбауыңызды өтінемін>
Dialogue: 0,0:13:23.63,0:13:27.47,Default,,0,0,0,,Уау, жоқ... Менің досым кешті тамашалап отыр
Dialogue: 0,0:13:28.84,0:13:30.18,Default,,0,0,0,,Ах! Йошито-кун!
Dialogue: 0,0:13:30.26,0:13:32.68,Default,,0,0,0,,Әй, бәрі өзгерді.
Dialogue: 0,0:13:32.81,0:13:36.19,Default,,0,0,0,,Бүгінгі кеште мектептегі достарым ғана болды.
Dialogue: 0,0:13:36.56,0:13:38.19,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:38.56,0:13:41.69,Default,,0,0,0,,Сондықтан бөгде адамдарды кіргізбейді. Өте өкінішті.
Dialogue: 0,0:13:41.77,0:13:43.36,Default,,0,0,0,,А...
Dialogue: 0,0:13:44.28,0:13:45.69,Default,,0,0,0,,Енді мұны Кристинге беріңіз.
Dialogue: 0,0:13:46.86,0:13:47.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:47.78,0:13:50.03,Default,,0,0,0,,Сонда кездескенше хаха
Dialogue: 0,0:14:03.38,0:14:05.46,Default,,0,0,0,,〈Неге? 〉
Dialogue: 0,0:14:05.55,0:14:07.01,Default,,0,0,0,,Хаха...
Dialogue: 0,0:14:07.13,0:14:09.47,Default,,0,0,0,,〈Ол байсалды болуы керек〉
Dialogue: 0,0:14:09.84,0:14:12.10,Default,,0,0,0,,〈Ол мұнда өзінің ақымақ түрімен келді〉
Dialogue: 0,0:14:12.22,0:14:14.47,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:14:14.60,0:14:16.06,Default,,0,0,0,,Коюки...!
Dialogue: 0,0:14:17.94,0:14:20.52,Default,,0,0,0,,<Ол жігіт маған бәрібір.>
Dialogue: 0,0:14:28.36,0:14:30.53,Default,,0,0,0,,Хаха...
Dialogue: 0,0:14:38.29,0:14:41.71,Default,,0,0,0,,(Махоның ауыр тыныс алуы)
Dialogue: 0,0:14:49.68,0:14:55.72,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:15:34.89,0:15:36.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:36.47,0:15:37.81,Default,,0,0,0,,А...
Dialogue: 0,0:15:38.89,0:15:40.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:44.48,0:15:47.07,Default,,0,0,0,,Аа, телехабар таратушы жоқ.
Dialogue: 0,0:15:48.03,0:15:50.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:51.03,0:15:51.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:51.99,0:15:54.32,Default,,0,0,0,,Такано мырза артта күтуімді өтінді.
Dialogue: 0,0:15:56.03,0:15:56.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:56.99,0:15:58.62,Default,,0,0,0,,Хмм! (Сатушы) О, эй!
Dialogue: 0,0:15:58.70,0:16:01.25,Default,,0,0,0,,Ха ха ха... (Сатушы) Эй, күте тұрыңыз~
Dialogue: 0,0:16:01.50,0:16:04.17,Default,,0,0,0,,Эй... Такано мырза!
Dialogue: 0,0:16:04.29,0:16:05.63,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:06.34,0:16:07.59,Default,,0,0,0,,Хахаха
Dialogue: 0,0:16:08.25,0:16:10.09,Default,,0,0,0,,Қандай ұры!!
Dialogue: 0,0:16:10.76,0:16:12.09,Default,,0,0,0,,Иә!?
Dialogue: 0,0:16:12.17,0:16:13.72,Default,,0,0,0,,Хмф!?
Dialogue: 0,0:16:13.84,0:16:15.93,Default,,0,0,0,,Такано~
Dialogue: 0,0:16:16.68,0:16:18.56,Default,,0,0,0,,Апат!! Дауааа!
Dialogue: 0,0:16:18.68,0:16:19.72,Default,,0,0,0,,Ахх
Dialogue: 0,0:16:19.85,0:16:22.14,Default,,0,0,0,,Не! Ах...
Dialogue: 0,0:16:22.43,0:16:23.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:30.69,0:16:35.61,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:16:38.03,0:16:40.45,Default,,0,0,0,,Катахира мырза, не істеуіміз керек? Сол тележүргізуші
Dialogue: 0,0:16:40.58,0:16:42.37,Default,,0,0,0,,Ол әр түрлі қылық жасайды.
Dialogue: 0,0:16:42.66,0:16:44.08,Default,,0,0,0,,Катахира...
Dialogue: 0,0:16:44.54,0:16:47.63,Default,,0,0,0,,О, дораа, дәмі жақсы.
Dialogue: 0,0:16:47.75,0:16:49.09,Default,,0,0,0,,Мен оны сатып аламын.
Dialogue: 0,0:16:49.17,0:16:52.59,Default,,0,0,0,,Ах... Тацуя Катахира, «Қарулы қылмыстар» қаласынан...
Dialogue: 0,0:16:52.67,0:16:54.93,Default,,0,0,0,,Жоқ, бұл бала сатып алады.
Dialogue: 0,0:16:55.05,0:16:56.93,Default,,0,0,0,,Екі рет төлеңіз
Dialogue: 0,0:16:57.05,0:16:58.80,Default,,0,0,0,,Аа, мен тапсырыс бердім...
Dialogue: 0,0:16:58.93,0:17:00.06,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:17:00.47,0:17:02.85,Default,,0,0,0,,Мені Тайра сұрады.
Dialogue: 0,0:17:04.06,0:17:05.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:05.64,0:17:10.36,Default,,0,0,0,,Мен барабаншымын, сондықтан мен де гитарада ойнамасам, сені аяймын.
Dialogue: 0,0:17:10.48,0:17:11.57,Default,,0,0,0,,Үйісшо
Dialogue: 0,0:17:11.94,0:17:15.61,Default,,0,0,0,,Егер ол баланы сатып алғыңыз келмесе, маған хабарласыңыз.
Dialogue: 0,0:17:18.37,0:17:19.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:19.74,0:17:23.08,Default,,0,0,0,,Келесі тікелей шоудан кейін Loud шынымен тарай ма?
Dialogue: 0,0:17:24.87,0:17:27.88,Default,,0,0,0,,Қане, адамдар, кілт есікті жабу.
Dialogue: 0,0:17:28.00,0:17:29.96,Default,,0,0,0,,Сізге ұнаса келіңіз.
Dialogue: 0,0:17:31.21,0:17:35.38,Default,,0,0,0,,Балам, мерзім айдың соңына дейін, жарай ма?
Dialogue: 0,0:17:35.51,0:17:36.68,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:17:37.84,0:17:40.60,Default,,0,0,0,,Ху~ Даудан Катахира
Dialogue: 0,0:17:41.01,0:17:41.93,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:42.06,0:17:45.39,Default,,0,0,0,,Loud шын мәнінде Жапонияның №1 рок тобы.
Dialogue: 0,0:17:45.52,0:17:47.64,Default,,0,0,0,,Әй, Будоканды көрейік.
Dialogue: 0,0:17:47.77,0:17:50.65,Default,,0,0,0,,Баркер әлдеқашан сатылып кеткен.
Dialogue: 0,0:17:50.73,0:17:53.90,Default,,0,0,0,,Хмф, сен бізден мүлдем басқашасың.
Dialogue: 0,0:17:54.32,0:17:57.65,Default,,0,0,0,,Дауыс әуел бастан ондай емес еді.
Dialogue: 0,0:17:57.78,0:18:00.12,Default,,0,0,0,,Біріншіден, бүгінгі тікелей эфир.
Dialogue: 0,0:18:01.16,0:18:04.04,Default,,0,0,0,,Дұрыс, жанды орындау да маңызды.
Dialogue: 0,0:18:04.16,0:18:05.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:06.00,0:18:09.50,Default,,0,0,0,,Бірақ қазір біздің мәселеміз...
Dialogue: 0,0:18:09.63,0:18:10.92,Default,,0,0,0,,Міне!
Dialogue: 0,0:18:12.04,0:18:15.92,Default,,0,0,0,,300 дана престелген және қоймада 210 дана.
Dialogue: 0,0:18:16.01,0:18:18.01,Default,,0,0,0,,бір адамға 42 дана!
Dialogue: 0,0:18:18.13,0:18:21.43,Default,,0,0,0,,Квотаңызға жету үшін барлық туыстарыңыз бен таныстарыңызды жұмылдырыңыз!!
Dialogue: 0,0:18:21.85,0:18:25.27,Default,,0,0,0,,Мен сол 40 адамның ешқайсысын танымаймын.
Dialogue: 0,0:18:25.39,0:18:29.27,Default,,0,0,0,,Квота орындалмаса, үлкен тапшылық қалады!
Dialogue: 0,0:18:29.39,0:18:30.44,Default,,0,0,0,,(үшін күрсінеді)
Dialogue: 0,0:18:34.86,0:18:36.69,Default,,0,0,0,,БЕК!
Dialogue: 0,0:18:36.82,0:18:39.36,Default,,0,0,0,,Ааа!!
Dialogue: 0,0:18:39.95,0:18:43.58,Default,,0,0,0,,Адам көп болса да, бәрінің даусы өте төмен.
Dialogue: 0,0:18:43.70,0:18:45.99,Default,,0,0,0,,Олардың көргісі келетіні келесі топ.
Dialogue: 0,0:18:46.08,0:18:48.50,Default,,0,0,0,,Мен осы тұтынушымен үлкен тамақтанғым келеді.
Dialogue: 0,0:18:49.83,0:18:52.00,Default,,0,0,0,,Бір екі
Dialogue: 0,0:18:52.08,0:18:57.01,Default,,0,0,0,,♪「миға шабуыл（ҮЛКЕН MUFF）」
Dialogue: 0,0:18:57.67,0:19:01.47,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:19:19.82,0:19:22.36,Default,,0,0,0,,Бұл мен оны тікелей эфирде соңғы рет қолданатын шығармын.
Dialogue: 0,0:19:23.62,0:19:25.99,Default,,0,0,0,,үшін үшін рахмет, Ақ сұңқар
Dialogue: 0,0:19:30.79,0:19:34.33,Default,,0,0,0,,Loud еріген кезде жапон тастары жойылады.
Dialogue: 0,0:19:35.29,0:19:37.67,Default,,0,0,0,,Меніңше... десем артық айтқандық емес.
Dialogue: 0,0:19:37.80,0:19:38.63,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:38.76,0:19:40.63,Default,,0,0,0,,Факті: Loud — жапон рок-сахнасы.
Dialogue: 0,0:19:40.76,0:19:43.05,Default,,0,0,0,,Сен мені тартып алдың ғой, солай ма?
Dialogue: 0,0:19:43.18,0:19:44.47,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:45.35,0:19:48.06,Default,,0,0,0,,Және дыбысты мұра ететін жолақтар -
Dialogue: 0,0:19:48.18,0:19:50.39,Default,,0,0,0,,Мүлде жоқ
Dialogue: 0,0:19:53.31,0:19:55.06,Default,,0,0,0,,Менің бензинім таусылды.
Dialogue: 0,0:19:55.27,0:19:56.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:56.65,0:20:00.07,Default,,0,0,0,,Өйткені біз енді жүгіре алмаймыз
Dialogue: 0,0:20:00.15,0:20:02.07,Default,,0,0,0,,Өздеріңіз білетіндей, музыкалық сахна...
Dialogue: 0,0:20:02.20,0:20:04.28,Default,,0,0,0,,Циклда көруге болатын қызықты нәрселер бар.
Dialogue: 0,0:20:05.16,0:20:06.07,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:20:06.16,0:20:08.79,Default,,0,0,0,,Менің ойымша, қазір де ешкім оны еш жерден көрген жоқ.
Dialogue: 0,0:20:08.91,0:20:11.37,Default,,0,0,0,,Ой, топ ойнап жатыр.
Dialogue: 0,0:20:11.50,0:20:13.08,Default,,0,0,0,,Мұндай топ...
Dialogue: 0,0:20:13.17,0:20:15.67,Default,,0,0,0,,Олар туралы қазір ешкім білмейді, бірақ...
Dialogue: 0,0:20:15.79,0:20:17.63,Default,,0,0,0,,Келесі көріністе пайда болу—
Dialogue: 0,0:20:17.75,0:20:20.88,Default,,0,0,0,,Сіз шынайы дыбысты ести білуіңіз керек.
Dialogue: 0,0:20:23.38,0:20:24.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:24.80,0:20:26.43,Default,,0,0,0,,Хонжа
Dialogue: 0,0:20:28.14,0:20:29.60,Default,,0,0,0,,Катахира-сан
Dialogue: 0,0:20:30.89,0:20:35.15,Default,,0,0,0,,(БЕК орындауы)
Dialogue: 0,0:20:53.37,0:20:56.21,Default,,0,0,0,,Хехе, енді сіз оны жақсы тыңдай аласыз.
Dialogue: 0,0:20:56.33,0:20:58.21,Default,,0,0,0,,Балалар гитарасы Хехехе
Dialogue: 0,0:21:34.45,0:21:36.79,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:21:45.72,0:21:47.43,Default,,0,0,0,,<Сол ықшам дискіні сатып ала аламын ба? 〉
Dialogue: 0,0:21:47.43,0:21:48.18,Default,,0,0,0,,<Сол ықшам дискіні сатып ала аламын ба? 〉
Dialogue: 0,0:21:48.47,0:21:49.76,Default,,0,0,0,,〈Иә! 〉
Dialogue: 0,0:21:49.89,0:21:51.81,Default,,0,0,0,,<БЕК жақсы ма? 〉
Dialogue: 0,0:21:52.06,0:21:54.43,Default,,0,0,0,,〈Аа, қандай жақсы топ〉
Dialogue: 0,0:21:54.56,0:21:56.44,Default,,0,0,0,,〈Гитара керемет〉
Dialogue: 0,0:21:56.56,0:21:57.81,Default,,0,0,0,,〈Иә〉
Dialogue: 0,0:21:58.77,0:22:01.36,Default,,0,0,0,,Чикагодағы инди лейблінің президенті?
Dialogue: 0,0:22:01.90,0:22:04.86,Default,,0,0,0,,Иә, бұл шынымен кездейсоқ болған сияқты.
Dialogue: 0,0:22:04.99,0:22:07.53,Default,,0,0,0,,Бұл жерде шетелдіктер өте көп.
Dialogue: 0,0:22:08.03,0:22:09.32,Default,,0,0,0,,Хмм.
Dialogue: 0,0:22:14.37,0:22:15.91,Default,,0,0,0,,<Күн зауытының жазбалары>
Dialogue: 0,0:22:16.04,0:22:17.41,Default,,0,0,0,,<Тіпті Фрэнк Альбин>
Dialogue: 0,0:22:17.54,0:22:20.88,Default,,0,0,0,,Хмм, мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:22:21.00,0:22:21.84,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:22:21.92,0:22:24.34,Default,,0,0,0,,Мм, ол жақсы адам еді...
Dialogue: 0,0:22:25.13,0:22:27.63,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:22:27.76,0:22:30.14,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:22:36.85,0:22:42.86,Default,,0,0,0,,♪～
Dialogue: 0,0:24:00.39,0:24:06.40,Default,,0,0,0,,～♪
Dialogue: 0,0:24:07.36,0:24:09.90,Default,,0,0,0,,Мен иттерге арналған сөмке сатып алдым.
Dialogue: 0,0:24:09.99,0:24:11.70,Default,,0,0,0,,Неліктен мен Бэкпен жүруім керек?
Dialogue: 0,0:24:11.82,0:24:13.86,Default,,0,0,0,,Сен бара алмайсың, Рюсуке~!
Dialogue: 0,0:24:15.36,0:24:21.36,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
