Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.41,0:00:06.96,Default,,0,0,0,,♪～
Dialogue: 0,0:01:33.63,0:01:36.93,Default,,0,0,0,,～♪
Dialogue: 0,0:01:40.22,0:01:43.97,Default,,0,0,0,,Сіз сол сахнада Дайбримен сеанс өткізіп жатырсыз.
Dialogue: 0,0:01:44.10,0:01:47.52,Default,,0,0,0,,Мен олармен жұмыс істегеніме сене алмаймын...
Dialogue: 0,0:01:48.23,0:01:52.23,Default,,0,0,0,,Белл Армның дебюті үшін үлкен оқиға қажет.
Dialogue: 0,0:01:52.94,0:01:54.65,Default,,0,0,0,,Мен оны өте бағалаймын.
Dialogue: 0,0:01:54.78,0:01:57.70,Default,,0,0,0,,Эйдзи Бұл бизнес.
Dialogue: 0,0:01:59.24,0:02:03.74,Default,,0,0,0,,Күтілгендей, ол Америка Құрама Штаттарында 8 миллион жазба сататын топтың менеджері.
Dialogue: 0,0:02:04.33,0:02:07.37,Default,,0,0,0,,Әңгіме ойдағыдай өтті.
Dialogue: 0,0:02:08.33,0:02:10.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:25.43,0:02:27.43,Default,,0,0,0,,〈Бұл топ жұмыс істеп жатыр ма? 〉
Dialogue: 0,0:02:27.73,0:02:29.77,Default,,0,0,0,,<Әрине, Едіге>
Dialogue: 0,0:02:29.89,0:02:32.90,Default,,0,0,0,,〈Олар жапондық рекордтық компаниялардың ең жаңадан келгендері〉
Dialogue: 0,0:02:32.98,0:02:34.82,Default,,0,0,0,,<Кевин бұрынғыдай итермелейді>
Dialogue: 0,0:02:35.40,0:02:36.90,Default,,0,0,0,,<Мэтпен не істеуіміз керек? 〉
Dialogue: 0,0:02:37.32,0:02:39.57,Default,,0,0,0,,<Егер репетиция кезінде ұнаса—>
Dialogue: 0,0:02:39.70,0:02:41.91,Default,,0,0,0,,<Бірге жасай аласыз>
Dialogue: 0,0:02:42.57,0:02:45.41,Default,,0,0,0,,<Кел, бұл бизнес, өтінемін.>
Dialogue: 0,0:02:47.62,0:02:49.41,Default,,0,0,0,,<Ол топ қалай аталады? 〉
Dialogue: 0,0:02:49.50,0:02:50.46,Default,,0,0,0,,<Қоңырау қолы>
Dialogue: 0,0:02:50.58,0:02:53.92,Default,,0,0,0,,(Француз тілінен аударғанда «әдемі жан» дегенді білдіреді.)
Dialogue: 0,0:02:54.42,0:02:55.92,Default,,0,0,0,,<Эй Джим, суретке түсуді доғар.>
Dialogue: 0,0:02:56.38,0:02:58.42,Default,,0,0,0,,<Тоқтатыңыз>
Dialogue: 0,0:02:58.51,0:02:59.97,Default,,0,0,0,,<Жақсы емес пе?>
Dialogue: 0,0:03:00.09,0:03:03.18,Default,,0,0,0,,<Сенің қаншалықты жақсы екеніңді барлығына көрсетейік! 〉
Dialogue: 0,0:03:03.30,0:03:04.60,Default,,0,0,0,,<Құйын жоқ>
Dialogue: 0,0:03:04.72,0:03:06.89,Default,,0,0,0,,〈Оған бірдеңе айта аласыз ба? 〉
Dialogue: 0,0:03:08.52,0:03:11.90,Default,,0,0,0,,<Оны жіберме дедім.>
Dialogue: 0,0:03:23.66,0:03:25.41,Default,,0,0,0,,Ал...
Dialogue: 0,0:03:25.74,0:03:27.41,Default,,0,0,0,,Едігенің қонақтары БЕК, 6 адам.
Dialogue: 0,0:03:27.83,0:03:30.41,Default,,0,0,0,,Иә, осы жерге атыңызды енгізіңіз.
Dialogue: 0,0:03:33.42,0:03:35.63,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:03:40.42,0:03:41.88,Default,,0,0,0,,Рюсуке-кун...
Dialogue: 0,0:03:42.34,0:03:43.93,Default,,0,0,0,,Сәлем Коюки!
Dialogue: 0,0:03:44.26,0:03:46.05,Default,,0,0,0,,Енді секір!
Dialogue: 0,0:03:46.18,0:03:47.93,Default,,0,0,0,,Чиба-кун
Dialogue: 0,0:03:48.01,0:03:48.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:48.93,0:03:50.43,Default,,0,0,0,,Ти! Уф...
Dialogue: 0,0:03:50.56,0:03:51.77,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:51.89,0:03:54.65,Default,,0,0,0,,А, жүр...
Dialogue: 0,0:03:59.07,0:04:01.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:06.07,0:04:06.87,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:04:06.87,0:04:07.78,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:04:06.87,0:04:07.78,Default,,0,0,0,,Мен көрмеймін...
Dialogue: 0,0:04:07.78,0:04:07.91,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:04:07.91,0:04:10.95,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:04:07.91,0:04:10.95,Default,,0,0,0,,Коюки! Ертерек барайық!
Dialogue: 0,0:04:10.95,0:04:12.08,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:04:33.60,0:04:36.31,Default,,0,0,0,,(гитара дыбысы)
Dialogue: 0,0:04:36.40,0:04:37.98,Default,,0,0,0,,Ой, мен оны тісіммен ойнаймын.
Dialogue: 0,0:04:38.11,0:04:40.65,Default,,0,0,0,,Сіз кенеттен Джими Хендрикске еліктедіңіз бе?
Dialogue: 0,0:04:41.28,0:04:42.32,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:04:45.41,0:04:51.41,Default,,0,0,0,,♪～
Dialogue: 0,0:06:00.31,0:06:01.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:02.15,0:06:08.15,Default,,0,0,0,,(Чибаның шулы дауысы)
Dialogue: 0,0:07:01.67,0:07:03.00,Default,,0,0,0,,～♪
Dialogue: 0,0:07:03.00,0:07:07.67,Default,,0,0,0,,～♪
Dialogue: 0,0:07:03.00,0:07:07.67,Default,,0,0,0,,Охохо!
Dialogue: 0,0:07:07.67,0:07:09.01,Default,,0,0,0,,Охохо!
Dialogue: 0,0:07:22.31,0:07:24.19,Default,,0,0,0,,Коюки Сіз ол адамды танисыз ба?
Dialogue: 0,0:07:24.73,0:07:26.32,Default,,0,0,0,,А... Сіз музыкантсыз ба?
Dialogue: 0,0:07:26.44,0:07:29.90,Default,,0,0,0,,Кинорежиссер Джим Уолш, 28 жаста
Dialogue: 0,0:07:30.03,0:07:33.20,Default,,0,0,0,,Нью-Йорктен шыққан визуалды данышпан
Dialogue: 0,0:07:33.45,0:07:35.12,Default,,0,0,0,,Неліктен бұл адам?
Dialogue: 0,0:07:35.24,0:07:37.70,Default,,0,0,0,,Мен Дайбури туристік фильмін түсіріп жатырмын.
Dialogue: 0,0:07:41.41,0:07:44.71,Default,,0,0,0,,〈Мұнда біз сұралмаған қонақтарды таныстырамыз〉
Dialogue: 0,0:07:44.92,0:07:47.25,Default,,0,0,0,,<Мырза. Жасы Кимура>
Dialogue: 0,0:07:48.30,0:07:49.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:49.30,0:07:50.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:50.72,0:07:51.80,Default,,0,0,0,,Хун
Dialogue: 0,0:07:52.30,0:07:55.22,Default,,0,0,0,,хун (голланд) фуфуфуфуфу…
Dialogue: 0,0:07:58.89,0:08:00.85,Default,,0,0,0,,Ақыры осында
Dialogue: 0,0:08:01.81,0:08:02.73,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:02.81,0:08:05.73,Default,,0,0,0,,(ағылшынша мат деген сөз)
Dialogue: 0,0:08:05.81,0:08:09.57,Default,,0,0,0,,Соңында соққы алмасқан адамның сен болғаныңа қуаныштымын
Dialogue: 0,0:08:09.69,0:08:11.69,Default,,0,0,0,,Менің страт...
Dialogue: 0,0:08:18.33,0:08:19.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:23.62,0:08:27.25,Default,,0,0,0,,〈Соңында сіздің музыкаңыз ешкімді құтқармайды.〉
Dialogue: 0,0:08:27.92,0:08:28.75,Default,,0,0,0,,<Жоғал! 〉
Dialogue: 0,0:08:34.47,0:08:36.30,Default,,0,0,0,,Ах... (жүгіріп) А...
Dialogue: 0,0:08:37.09,0:08:40.26,Default,,0,0,0,,<Әй, аудитория жағдайды түсінбейді.>
Dialogue: 0,0:08:43.35,0:08:45.27,Default,,0,0,0,,<Не болды, Едіге?>
Dialogue: 0,0:08:57.32,0:08:59.03,Default,,0,0,0,,Иә? Келді
Dialogue: 0,0:09:00.70,0:09:03.25,Default,,0,0,0,,Мэтт Коюкиге қоңырау шалып жатыр.
Dialogue: 0,0:09:03.62,0:09:07.42,Default,,0,0,0,,<Кел, бізбен ән айт>
Dialogue: 0,0:09:09.00,0:09:09.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:12.13,0:09:13.30,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:09:13.71,0:09:14.80,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:09:14.88,0:09:16.01,Default,,0,0,0,,Жапон халқы
Dialogue: 0,0:09:16.13,0:09:18.14,Default,,0,0,0,,Әлі бала
Dialogue: 0,0:09:25.52,0:09:26.35,Default,,0,0,0,,<Коюки>
Dialogue: 0,0:09:26.48,0:09:29.02,Default,,0,0,0,,<Біздің ең жақсы көретін әніміз қандай? 〉
Dialogue: 0,0:09:29.90,0:09:32.32,Default,,0,0,0,,Иә...? (Махо) Сіздің сүйікті әніңіз қандай?
Dialogue: 0,0:09:34.86,0:09:36.53,Default,,0,0,0,,Судағы Ай
Dialogue: 0,0:09:36.65,0:09:40.32,Default,,0,0,0,,Өйткені менің ерекше жадым бар
Dialogue: 0,0:09:52.84,0:09:58.93,Default,,0,0,0,,(жаман ән айту)
Dialogue: 0,0:10:00.76,0:10:04.35,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:10:04.93,0:10:08.10,Default,,0,0,0,,<Не? Бұл жай ғана Мэтттің әзілі ме? 〉
Dialogue: 0,0:10:20.41,0:10:26.41,Default,,0,0,0,,(Коюкидің ағылшынша ән айтатын дауысы)
Dialogue: 0,0:12:26.16,0:12:32.16,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:12:38.59,0:12:39.84,Default,,0,0,0,,Ммм
Dialogue: 0,0:12:43.51,0:12:45.55,Default,,0,0,0,,Жарайды, мен көмектесе алмаймын.
Dialogue: 0,0:12:45.68,0:12:49.26,Default,,0,0,0,,Өйткені, мен Дайбримен бірге сахнада болдым.
Dialogue: 0,0:12:49.39,0:12:51.85,Default,,0,0,0,,Бірақ бар болғаны бір апта болды.
Dialogue: 0,0:12:52.14,0:12:59.06,Default,,0,0,0,,Гитара – алты ішек арқылы шығатын адамзат.
Dialogue: 0,0:13:00.32,0:13:02.69,Default,,0,0,0,,Бірақ~
Dialogue: 0,0:13:03.57,0:13:04.65,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:13:05.53,0:13:08.57,Default,,0,0,0,,Эй, Рюсуке-кун, ағылшынша айтшы.
Dialogue: 0,0:13:08.70,0:13:10.16,Default,,0,0,0,,Сәлем Коюки
Dialogue: 0,0:13:10.28,0:13:13.45,Default,,0,0,0,,Маған бұл туралы 100 рет айтылды, маған үзіліс беріңіз.
Dialogue: 0,0:13:15.54,0:13:17.46,Default,,0,0,0,,Гитара – бұл...
Dialogue: 0,0:13:17.54,0:13:19.08,Default,,0,0,0,,Фелингсвари
Dialogue: 0,0:13:19.21,0:13:20.46,Default,,0,0,0,,Бұл қандай да бір «Гя●ган» ба?!
Dialogue: 0,0:13:22.34,0:13:25.34,Default,,0,0,0,,<Рей, бұл қауіпті, Махоның жігіті>
Dialogue: 0,0:13:25.47,0:13:27.47,Default,,0,0,0,,<Не болды? 〉
Dialogue: 0,0:13:27.68,0:13:28.97,Default,,0,0,0,,〈Сәлем Йошито! 〉
Dialogue: 0,0:13:29.30,0:13:32.47,Default,,0,0,0,,<Ағаңызға бірдеңе айтқыңыз келе ме? 〉
Dialogue: 0,0:13:33.14,0:13:33.52,Default,,0,0,0,,(Ёшитоның ағылшыншасы)
Dialogue: 0,0:13:33.52,0:13:37.35,Default,,0,0,0,,(Ёшитоның ағылшыншасы)
Dialogue: 0,0:13:33.52,0:13:37.35,Default,,0,0,0,,Йошитоның қарт адамы «Алтын драмада».
Dialogue: 0,0:13:37.35,0:13:37.48,Default,,0,0,0,,(Ёшитоның ағылшыншасы)
Dialogue: 0,0:13:37.48,0:13:39.44,Default,,0,0,0,,(Ёшитоның ағылшыншасы)
Dialogue: 0,0:13:37.48,0:13:39.44,Default,,0,0,0,,А... Мен оны Маходан естідім.
Dialogue: 0,0:13:39.56,0:13:40.81,Default,,0,0,0,,Сәлем Йошито
Dialogue: 0,0:13:40.94,0:13:44.49,Default,,0,0,0,,Бұл жігіт Daibri's secret тікелей эфирде ән айтты.
Dialogue: 0,0:13:44.90,0:13:46.53,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:46.90,0:13:50.87,Default,,0,0,0,,〈Күні, қария, маған актриса әкел.〉
Dialogue: 0,0:13:51.83,0:13:53.29,Default,,0,0,0,,〈Бұл кім? 〉
Dialogue: 0,0:13:55.04,0:13:59.50,Default,,0,0,0,,(Махо ағылшын тілі)
Dialogue: 0,0:14:15.98,0:14:18.73,Default,,0,0,0,,Мен бұл нені білдіргені қызық...
Dialogue: 0,0:14:34.62,0:14:36.54,Default,,0,0,0,,Не!?
Dialogue: 0,0:14:36.62,0:14:38.00,Default,,0,0,0,,Олай болса, биылғы ән байқауына...
Dialogue: 0,0:14:38.12,0:14:40.04,Default,,0,0,0,,Сіз қатыса алмаймын дейсіз бе?
Dialogue: 0,0:14:40.17,0:14:41.33,Default,,0,0,0,,Аудан басшысы ашулы ма? Бұл кім?
Dialogue: 0,0:14:41.33,0:14:42.54,Default,,0,0,0,,Аудан президенті ашулы ма? Бұл кім?
Dialogue: 0,0:14:41.33,0:14:42.54,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:14:42.63,0:14:46.80,Default,,0,0,0,,Мен күнде қатты жаттығатынмын, ақымақ!
Dialogue: 0,0:14:48.30,0:14:50.13,Default,,0,0,0,,Сіз нені айтасыз? Эй, мұнда!
Dialogue: 0,0:14:50.13,0:14:52.09,Default,,0,0,0,,Сіз нені айтасыз? Эй, мұнда!
Dialogue: 0,0:14:50.13,0:14:52.09,Default,,0,0,0,,Ах... Ахах...
Dialogue: 0,0:14:52.09,0:14:52.55,Default,,0,0,0,,Ах... Ахах...
Dialogue: 0,0:15:07.23,0:15:08.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:15.08,0:15:16.62,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:15:16.74,0:15:18.08,Default,,0,0,0,,Көптен бері көрмегелі...
Dialogue: 0,0:15:18.50,0:15:21.62,Default,,0,0,0,,Мен сәл жақындадым да, тоқтадым.
Dialogue: 0,0:15:23.25,0:15:24.08,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:15:26.13,0:15:27.09,Default,,0,0,0,,Иә
Dialogue: 0,0:15:28.17,0:15:30.30,Default,,0,0,0,,Коюки де жақсы емес сияқты.
Dialogue: 0,0:15:36.64,0:15:38.02,Default,,0,0,0,,Мен Кайо-чаннан сұрадым
Dialogue: 0,0:15:38.14,0:15:40.31,Default,,0,0,0,,Дайбридің жанды орындауында ән айтқаныңызды естідім.
Dialogue: 0,0:15:40.43,0:15:41.89,Default,,0,0,0,,Ха? Эээ!
Dialogue: 0,0:15:42.10,0:15:45.02,Default,,0,0,0,,Иә, Мэтт мені шақырды.
Dialogue: 0,0:15:45.36,0:15:48.61,Default,,0,0,0,,Эй, Коюки... бойың өскен жоқ па?
Dialogue: 0,0:15:48.73,0:15:52.45,Default,,0,0,0,,Аа, Сайто мырза да солай деді.
Dialogue: 0,0:15:53.03,0:15:56.03,Default,,0,0,0,,Сіз жетілгендей болдыңыз.
Dialogue: 0,0:15:58.62,0:16:03.87,Default,,0,0,0,,Шынымды айтсам, мен күнде 3 км жүзуім керек.
Dialogue: 0,0:16:06.13,0:16:07.63,Default,,0,0,0,,көремін.
Dialogue: 0,0:16:08.55,0:16:11.13,Default,,0,0,0,,Менің де біраз уақыттан кейін бірінші рет жүзгім келеді.
Dialogue: 0,0:16:11.47,0:16:13.84,Default,,0,0,0,,Бірақ купальник жоқ, солай ма?
Dialogue: 0,0:16:13.97,0:16:15.14,Default,,0,0,0,,Сіз жүзбейсіз бе?
Dialogue: 0,0:16:16.85,0:16:18.14,Default,,0,0,0,,Ертең кездескенше.
Dialogue: 0,0:16:19.39,0:16:21.39,Default,,0,0,0,,Біз купальник сатып алайық па?
Dialogue: 0,0:16:21.81,0:16:22.64,Default,,0,0,0,,Е...
Dialogue: 0,0:16:35.16,0:16:37.45,Default,,0,0,0,,Кішкене ме?
Dialogue: 0,0:16:38.74,0:16:39.70,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:16:44.50,0:16:46.00,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:16:47.50,0:16:51.26,Default,,0,0,0,,Өйткені, шынымен... біраз уақыт өтті...
Dialogue: 0,0:16:52.09,0:16:55.18,Default,,0,0,0,,А, кешіріңіз, мен біртүрлі айттым...
Dialogue: 0,0:17:14.40,0:17:16.70,Default,,0,0,0,,Мен жігітіммен ажырасып кеттім... Ааа...
Dialogue: 0,0:17:40.51,0:17:42.47,Default,,0,0,0,,Қараңғы тақырыптардың соңы!
Dialogue: 0,0:17:42.68,0:17:45.14,Default,,0,0,0,,Хмм... иә~
Dialogue: 0,0:17:45.27,0:17:47.64,Default,,0,0,0,,Ей, жүзуге барайық!
Dialogue: 0,0:17:47.85,0:17:50.48,Default,,0,0,0,,Бүгін муниципалды бассейн жабық.
Dialogue: 0,0:17:51.52,0:17:53.48,Default,,0,0,0,,Хехе...
Dialogue: 0,0:17:55.19,0:17:56.49,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:17:56.99,0:17:59.99,Default,,0,0,0,,Ах, Юкио, маған Махо есімді қыз көп қоңырау шалды.
Dialogue: 0,0:18:00.66,0:18:02.62,Default,,0,0,0,,Не? Қайтадан қоңырау шалсаңыз...
Dialogue: 0,0:18:02.74,0:18:05.45,Default,,0,0,0,,Маған кейінірек қоңырау шалатыныңызды айтыңыз!
Dialogue: 0,0:18:10.25,0:18:13.25,Default,,0,0,0,,Сол жақ қолыңдағы ырғақ артта қалып жатыр
Dialogue: 0,0:18:18.76,0:18:22.51,Default,,0,0,0,,Коюки келмесе де, мен жалғыз барамын.
Dialogue: 0,0:18:24.47,0:18:29.27,Default,,0,0,0,,(Охайаши)
Dialogue: 0,0:18:41.24,0:18:42.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:51.75,0:18:53.96,Default,,0,0,0,,Содан бері бір жыл өтті...
Dialogue: 0,0:19:09.27,0:19:11.15,Default,,0,0,0,,(өрмелеу дуалының дыбысы)
Dialogue: 0,0:19:11.27,0:19:12.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:13.11,0:19:14.11,Default,,0,0,0,,Изуми-чан!
Dialogue: 0,0:19:19.07,0:19:21.11,Default,,0,0,0,,Коюки, сен келдің.
Dialogue: 0,0:19:21.36,0:19:22.49,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:22.61,0:19:25.16,Default,,0,0,0,,А... Қатты айтсаң, жұрт біледі.
Dialogue: 0,0:19:25.28,0:19:26.12,Default,,0,0,0,,Хехе...
Dialogue: 0,0:19:30.08,0:19:34.21,Default,,0,0,0,,Түсіндің бе? Егер сіз тізеңізді тым көп бүгсеңіз, сіз серпін жоғалтасыз.
Dialogue: 0,0:19:35.34,0:19:37.00,Default,,0,0,0,,Иә
Dialogue: 0,0:19:41.13,0:19:42.13,Default,,0,0,0,,Коюки...
Dialogue: 0,0:19:44.51,0:19:46.39,Default,,0,0,0,,Махо-чан ұнай ма?
Dialogue: 0,0:19:46.51,0:19:47.47,Default,,0,0,0,,Эх!
Dialogue: 0,0:19:48.02,0:19:50.81,Default,,0,0,0,,Өткен жылғы ән байқауы туралы
Dialogue: 0,0:19:52.64,0:19:55.90,Default,,0,0,0,,Мен мұны Сайто мырзадан баяғыда естідім.
Dialogue: 0,0:20:06.16,0:20:10.20,Default,,0,0,0,,Менің ойымша, оған Коюки ұнайды.
Dialogue: 0,0:20:10.79,0:20:11.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:19.63,0:20:23.76,Default,,0,0,0,,Мен өз сезімімді кеш түсіндім деп ойлаймын.
Dialogue: 0,0:20:26.97,0:20:29.72,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:20:29.72,0:20:31.60,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:20:29.72,0:20:31.60,Default,,0,0,0,,А... а...
Dialogue: 0,0:20:31.60,0:20:32.02,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:20:51.04,0:20:56.71,Default,,0,0,0,,♪「СУДАҒЫ АЙ」
Dialogue: 0,0:21:25.11,0:21:26.32,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:21:30.37,0:21:31.74,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:21:32.41,0:21:35.33,Default,,0,0,0,,(жүгірген аяқ дыбысы)
Dialogue: 0,0:21:42.59,0:21:45.72,Default,,0,0,0,,Иә, көп рахмет...
Dialogue: 0,0:21:45.84,0:21:47.34,Default,,0,0,0,,(Қоңырауды аяқтау дыбысы)
Dialogue: 0,0:21:49.09,0:21:51.35,Default,,0,0,0,,Хи хи хи хи...
Dialogue: 0,0:21:51.43,0:21:53.35,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:21:53.81,0:21:56.85,Default,,0,0,0,,Ол БЕКтің демо таспасын тыңдағысы келеді.
Dialogue: 0,0:21:56.94,0:21:59.06,Default,,0,0,0,,Yahoo! Хахаха...
Dialogue: 0,0:21:59.19,0:22:01.36,Default,,0,0,0,,Ей, бұл қауіпті.
Dialogue: 0,0:22:01.61,0:22:01.98,Default,,0,0,0,,Ия хахаха...хехехе...
Dialogue: 0,0:22:01.98,0:22:04.15,Default,,0,0,0,,Ия хахаха...хехехе...
Dialogue: 0,0:22:01.98,0:22:04.15,Default,,0,0,0,,Қалай болғанда да, Коюкиге рахмет...
Dialogue: 0,0:22:04.15,0:22:04.28,Default,,0,0,0,,Ия хахаха...хехехе...
Dialogue: 0,0:22:04.28,0:22:07.53,Default,,0,0,0,,Ия хахаха...хехехе...
Dialogue: 0,0:22:04.28,0:22:07.53,Default,,0,0,0,,БЕКке де үлкен толқындар келді.
Dialogue: 0,0:22:07.53,0:22:07.86,Default,,0,0,0,,Ия хахаха...хехехе...
Dialogue: 0,0:22:08.57,0:22:10.20,Default,,0,0,0,,Дүние жүзіндегі музыка әуесқойларына—
Dialogue: 0,0:22:10.20,0:22:10.37,Default,,0,0,0,,Дүние жүзіндегі музыка әуесқойларына—
Dialogue: 0,0:22:10.20,0:22:10.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:10.37,0:22:10.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:10.45,0:22:11.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:10.45,0:22:11.20,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:22:11.20,0:22:11.91,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:22:12.03,0:22:13.37,Default,,0,0,0,,Американдық танымал әнші әйел—
Dialogue: 0,0:22:13.45,0:22:14.66,Default,,0,0,0,,Ватт!?
Dialogue: 0,0:22:13.45,0:22:14.66,Default,,0,0,0,,Эрика Блайдж...
Dialogue: 0,0:22:14.66,0:22:15.16,Default,,0,0,0,,Эрика Блайдж...
Dialogue: 0,0:22:15.29,0:22:16.87,Default,,0,0,0,,Жергілікті уақыт бойынша өткен түнде
Dialogue: 0,0:22:17.21,0:22:19.88,Default,,0,0,0,,Мен тұрған Нью-Йорктегі қонақүй бөлмесінде—
Dialogue: 0,0:22:19.96,0:22:22.09,Default,,0,0,0,,Пистолетпен өз-өзіне қол жұмсады
Dialogue: 0,0:22:22.38,0:22:23.25,Default,,0,0,0,,Эрика - Жапонияда көптеген жанкүйерлері бар харизматикалық әнші.
Dialogue: 0,0:22:23.25,0:22:24.71,Default,,0,0,0,,Эрика - Жапонияда көптеген жанкүйерлері бар харизматикалық әнші.
Dialogue: 0,0:22:23.25,0:22:24.71,Default,,0,0,0,,Хмм... (Чиба) Хмм...
Dialogue: 0,0:22:24.71,0:22:26.59,Default,,0,0,0,,Эрика - Жапонияда көптеген жанкүйерлері бар харизматикалық әнші.
Dialogue: 0,0:22:26.72,0:22:28.30,Default,,0,0,0,,Біз бүкіл әлем бойынша 20 миллионнан астам компакт-дискілерді сатумен мақтанамыз.
Dialogue: 0,0:22:28.30,0:22:30.89,Default,,0,0,0,,Біз бүкіл әлем бойынша 20 миллионнан астам компакт-дискілерді сатумен мақтанамыз.
Dialogue: 0,0:22:28.30,0:22:30.89,Default,,0,0,0,,(Бектің жылағаны)
Dialogue: 0,0:22:31.26,0:22:32.93,Default,,0,0,0,,Қатысқан дереккөздерге сәйкес...
Dialogue: 0,0:22:33.06,0:22:36.77,Default,,0,0,0,,Жаңа альбом шығарылымы және бірнеше айдан кейін АҚШ-тағы тур...
Dialogue: 0,0:22:36.89,0:22:42.90,Default,,0,0,0,,♪～
Dialogue: 0,0:24:00.39,0:24:06.40,Default,,0,0,0,,～♪
Dialogue: 0,0:24:07.40,0:24:09.03,Default,,0,0,0,,Күн балығы дегеніміз не?
Dialogue: 0,0:24:09.15,0:24:11.53,Default,,0,0,0,,Бұл сүйкімді, солай емес пе?
Dialogue: 0,0:24:11.90,0:24:13.95,Default,,0,0,0,,Сіз мұны жей аласыз ба?
Dialogue: 0,0:24:15.45,0:24:21.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
