Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.97,0:00:05.30,Default,,0,0,0,,Анау «Хауа» - тәкаппар қаншық➡
Dialogue: 0,0:00:05.30,0:00:07.64,Default,,0,0,0,,Ол менің құмар ойын ойнайтын жерімді бүлдірген.
Dialogue: 0,0:00:07.64,0:00:09.97,Default,,0,0,0,,Мұндағы бизнес өсуде.
Dialogue: 0,0:00:09.97,0:00:12.64,Default,,0,0,0,,Мен сені жалғыз қалдыра аламын ба? Әпке
Dialogue: 0,0:00:12.64,0:00:15.64,Default,,0,0,0,,Жарайды, мен саған қалағаныңды беремін.
Dialogue: 0,0:00:15.64,0:00:17.65,Default,,0,0,0,,Не болды?
Dialogue: 0,0:00:17.65,0:00:20.98,Default,,0,0,0,,Біз көтерілісшілердің бәрін басып тастадық, солай емес пе?
Dialogue: 0,0:00:20.98,0:00:22.99,Default,,0,0,0,,Бұл гольф болсын, жекпе-жек болсын
Dialogue: 0,0:00:22.99,0:00:26.66,Default,,0,0,0,,Әлі уақыт емес. Уақыт емес пе?
Dialogue: 0,0:00:26.66,0:00:30.66,Default,,0,0,0,,Ол жарты жыл ғана астыртын гольф ойыншысы болды.
Dialogue: 0,0:00:30.66,0:00:34.33,Default,,0,0,0,,Егер сіз дәл қазір гольф ойнасаңыз, оны оңай жеңе аласыз.
Dialogue: 0,0:00:34.33,0:00:37.03,Default,,0,0,0,,Бірақ бұл мені қанағаттандырмайды.
Dialogue: 0,0:00:38.67,0:00:40.67,Default,,0,0,0,,Уақыт піспеген.
Dialogue: 0,0:00:40.67,0:00:44.67,Default,,0,0,0,,Әлгі жігіт көзін ашып, гольфтың не екенін түсінгенде➡
Dialogue: 0,0:00:44.67,0:00:47.01,Default,,0,0,0,,Мен оны матчқа шақырамын.
Dialogue: 0,0:00:47.01,0:00:50.01,Default,,0,0,0,,Ал Хауа түсінеді
Dialogue: 0,0:00:50.01,0:00:53.68,Default,,0,0,0,,Сіз менің гольф ойнау шеберлігіме ешқашан тең келе алмайсыз.
Dialogue: 0,0:00:53.68,0:00:57.02,Default,,0,0,0,,Неге сен Хауаның боқтығына құмарсың?
Dialogue: 0,0:00:57.02,0:00:59.62,Default,,0,0,0,,Мақтаныш пен...
Dialogue: 0,0:01:01.29,0:01:03.29,Default,,0,0,0,,Бұл ұсақ-түйек сезім.
Dialogue: 0,0:01:05.63,0:01:09.30,Default,,0,0,0,,Хауа ананы біраз уақытқа қалдырыңыз, жарай ма?
Dialogue: 0,0:01:09.30,0:01:11.60,Default,,0,0,0,,Түсіндім, ханым.
Dialogue: 0,0:01:13.64,0:01:18.31,Default,,0,0,0,,Тағдырымызға төбелесу жазылған сияқты.
Dialogue: 0,0:01:18.31,0:01:21.64,Default,,0,0,0,,Оған себепкер болған сіз болдыңыз, солай ма?
Dialogue: 0,0:01:21.64,0:01:25.31,Default,,0,0,0,,Сондықтан мен өкінбеймін, мұны істеудің қажеті жоқ.
Dialogue: 0,0:01:25.31,0:01:27.98,Default,,0,0,0,,бастайық
Dialogue: 0,0:01:27.98,0:01:33.29,Default,,0,0,0,,Біз бір-біріміздің өмірімізге бәс тіккен гольф ойынының соңғы ойыны.
Dialogue: 0,0:01:36.33,0:01:39.33,Default,,0,0,0,,Мен басқа адам сен болады деп ешқашан ойламадым.
Dialogue: 0,0:01:39.33,0:01:41.66,Default,,0,0,0,,Сізді көптен бері ойнамағаныңызды естідім➡
Dialogue: 0,0:01:41.66,0:01:44.00,Default,,0,0,0,,Мен оны міндетті түрде зейнеткер деп ойладым.
Dialogue: 0,0:01:44.00,0:01:46.67,Default,,0,0,0,,Ойнаудың қажеті жоқ еді.
Dialogue: 0,0:01:46.67,0:01:49.34,Default,,0,0,0,,Сізбен жарысуға Хауа жеткілікті.
Dialogue: 0,0:01:49.34,0:01:51.67,Default,,0,0,0,,Менің жолымнан шығып кету маған тұрарлық емес.
Dialogue: 0,0:01:51.67,0:01:53.68,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,0:01:53.68,0:01:56.68,Default,,0,0,0,,Сіз өзіңіз қалаған нәрсені жасай аласыз, тіпті бұл ең соңғы болса да.
Dialogue: 0,0:01:56.68,0:01:58.68,Default,,0,0,0,,Мен жай ғана атамын
Dialogue: 0,0:01:58.68,0:02:03.62,Default,,0,0,0,,Мен сенің кеудеңді кемпірқосақ түсті оқпен тесемін.
Dialogue: 0,0:02:03.62,0:02:07.62,Default,,0,0,0,,Жоқ, бұл өте жақсы.
Dialogue: 0,0:02:07.62,0:02:27.64,Default,,0,0,0,,♬～
Dialogue: 0,0:02:27.64,0:02:47.66,Default,,0,0,0,,♬～
Dialogue: 0,0:02:47.66,0:03:07.62,Default,,0,0,0,,♬～
Dialogue: 0,0:03:07.62,0:03:27.64,Default,,0,0,0,,♬～
Dialogue: 0,0:03:27.64,0:03:39.98,Default,,0,0,0,,♬～
Dialogue: 0,0:03:51.96,0:03:56.63,Default,,0,0,0,,Ойынның ережесі өткен жолғыдай, тек бір тесікпен матч ойнау.
Dialogue: 0,0:03:56.63,0:03:59.97,Default,,0,0,0,,Тең болған жағдайда, есеп шешілгенге дейін кенеттен өлім орын алады.
Dialogue: 0,0:03:59.97,0:04:03.64,Default,,0,0,0,,Тесіктердің орналасуы кездейсоқ түрде орнатылады
Dialogue: 0,0:04:03.64,0:04:05.97,Default,,0,0,0,,Сіз сенімдісіз бе? ханым
Dialogue: 0,0:04:05.97,0:04:08.28,Default,,0,0,0,,Иә, танысқаныма қуаныштымын.
Dialogue: 0,0:04:11.31,0:04:14.32,Default,,0,0,0,,Орналасуды кездейсоқ түрде орнатыңыз
Dialogue: 0,0:04:14.32,0:04:17.32,Default,,0,0,0,,Жер бедерін өзімізге тиімді етейік, т.б. ➡
Dialogue: 0,0:04:17.32,0:04:19.99,Default,,0,0,0,,Күтпеген жерден армандау
Dialogue: 0,0:04:19.99,0:04:21.99,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:04:21.99,0:04:25.29,Default,,0,0,0,,Жақсы, бастайық.
Dialogue: 0,0:04:26.33,0:04:28.66,Default,,0,0,0,,бастайық
Dialogue: 0,0:04:28.66,0:04:33.67,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:04:33.67,0:04:53.62,Default,,0,0,0,,♬～
Dialogue: 0,0:04:53.62,0:04:55.96,Default,,0,0,0,,♬～
Dialogue: 0,0:04:55.96,0:04:59.29,Default,,0,0,0,,「Ｐａｒ４ ３８７ｙｄｓ」
Dialogue: 0,0:04:59.29,0:05:01.96,Default,,0,0,0,,Жол кеңістігі және толқындары аз.
Dialogue: 0,0:05:01.96,0:05:03.97,Default,,0,0,0,,Жеңіл тесік
Dialogue: 0,0:05:03.97,0:05:06.64,Default,,0,0,0,,Бұл бүркіт сайысы болады (Випера) Иә?
Dialogue: 0,0:05:06.64,0:05:08.64,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:09.64,0:05:11.64,Default,,0,0,0,,Кесте
Dialogue: 0,0:05:13.64,0:05:15.64,Default,,0,0,0,,Сіз абыройсыз.
Dialogue: 0,0:05:19.31,0:05:23.02,Default,,0,0,0,,Жарқырап айтпасаң да
Dialogue: 0,0:05:24.99,0:05:28.32,Default,,0,0,0,,<Бұл ойынды ешқашан ұтыла алмайсыз>
Dialogue: 0,0:05:28.32,0:05:33.66,Default,,0,0,0,,<Әпке мен Лилия, балаларымыздың болашағы... ертең➡
Dialogue: 0,0:05:33.66,0:05:36.06,Default,,0,0,0,,Мен міндетті түрде орындаймын>
Dialogue: 0,0:05:37.33,0:05:41.67,Default,,0,0,0,,<Тікелей көк оқ тиді! ＞
Dialogue: 0,0:05:41.67,0:05:53.95,Default,,0,0,0,,♬～
Dialogue: 0,0:05:53.95,0:05:57.62,Default,,0,0,0,,＜Күтілгендей, жеңілсек, өмір болмайды＞
Dialogue: 0,0:05:57.62,0:05:59.62,Default,,0,0,0,,<Ақыл-ойы тым күшті>
Dialogue: 0,0:05:59.62,0:06:02.96,Default,,0,0,0,,Әй, эй, ей, ұшты.
Dialogue: 0,0:06:02.96,0:06:06.29,Default,,0,0,0,,250 ярдтан артық емес пе?
Dialogue: 0,0:06:06.29,0:06:09.97,Default,,0,0,0,,Бұл өте үлкен көлік (Кэтрин) иә?
Dialogue: 0,0:06:09.97,0:06:11.97,Default,,0,0,0,,Керемет кадр
Dialogue: 0,0:06:13.97,0:06:15.97,Default,,0,0,0,,Раушан Ареон…
Dialogue: 0,0:06:15.97,0:06:18.64,Default,,0,0,0,,Хауа, сен оның ойнағанын көрдің бе?
Dialogue: 0,0:06:18.64,0:06:20.64,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:20.64,0:06:25.65,Default,,0,0,0,,<Мен оны кездестірген кезде ол енді құмар гольф ойнамайтын болды>
Dialogue: 0,0:06:25.65,0:06:29.65,Default,,0,0,0,,Мен оның ойнағанын төрт жыл бұрын ғана бір рет көрдім.
Dialogue: 0,0:06:29.65,0:06:32.65,Default,,0,0,0,,Бұл қандай сезімде? Сіз сияқты
Dialogue: 0,0:06:32.65,0:06:35.06,Default,,0,0,0,,Бұл сізді құлату үшін күш қолданатын стиль.
Dialogue: 0,0:06:35.99,0:06:37.99,Default,,0,0,0,,<High tee>
Dialogue: 0,0:06:37.99,0:06:43.00,Default,,0,0,0,,♬～
Dialogue: 0,0:06:43.00,0:06:45.00,Default,,0,0,0,,Гуреннің... а
Dialogue: 0,0:06:45.00,0:06:47.67,Default,,0,0,0,,Роуз Барретт!
Dialogue: 0,0:06:47.67,0:07:00.28,Default,,0,0,0,,♬～
Dialogue: 0,0:07:00.28,0:07:03.95,Default,,0,0,0,,Не...? (Бағыныңқы) Мына доп...
Dialogue: 0,0:07:03.95,0:07:07.29,Default,,0,0,0,,Хауа қалай 10 ярдтан артық қалды?
Dialogue: 0,0:07:07.29,0:07:09.62,Default,,0,0,0,,Бұл➡
Dialogue: 0,0:07:09.62,0:07:12.63,Default,,0,0,0,,Қарсыластарымның бәрін өртеп жібердім➡
Dialogue: 0,0:07:12.63,0:07:16.63,Default,,0,0,0,,Қып-қызыл әйел Роуз Ареонның күші.
Dialogue: 0,0:07:19.30,0:07:21.30,Default,,0,0,0,,Мен... Ағымдағы түсірілім...
Dialogue: 0,0:07:23.31,0:07:27.64,Default,,0,0,0,,《Оқты салыңыз және балғаны көтеріңіз➡
Dialogue: 0,0:07:27.64,0:07:31.65,Default,,0,0,0,,Мақсат қойып, триггерді➡ тартыңыз
Dialogue: 0,0:07:31.65,0:07:33.65,Default,,0,0,0,,Бөшкеден босату》
Dialogue: 0,0:07:34.98,0:07:37.65,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:07:37.65,0:07:40.66,Default,,0,0,0,,Дұрыс, мүмкін емес.
Dialogue: 0,0:07:40.66,0:07:44.66,Default,,0,0,0,,Леодан гольфті үйренген жалғыз сен емессің.
Dialogue: 0,0:07:44.66,0:07:46.10,Default,,0,0,0,,Неге үндемедің?
Dialogue: 0,0:07:46.10,0:07:49.66,Default,,0,0,0,,Оны айтудың қажеті жоқ.
Dialogue: 0,0:07:49.66,0:07:53.94,Default,,0,0,0,,Бірақ сол Лео маған үш жыл бойы гольф ойнауды үйретті➡
Dialogue: 0,0:07:53.94,0:07:56.60,Default,,0,0,0,,Мен тек осы қашықтыққа жете аламын деп ешқашан ойламадым.
Dialogue: 0,0:07:56.60,0:08:00.94,Default,,0,0,0,,Хауа, ағам мен ұлым ретінде мен саған жол көрсетемін.
Dialogue: 0,0:08:00.94,0:08:03.61,Default,,0,0,0,,Мен сені өртеп жіберемін.
Dialogue: 0,0:08:03.61,0:08:06.01,Default,,0,0,0,,Менің «гуреніммен»
Dialogue: 0,0:08:08.95,0:08:12.29,Default,,0,0,0,,<Мен ешқашан Хауа мен Роузды бір сыныптан деп ойламадым>
Dialogue: 0,0:08:12.29,0:08:16.62,Default,,0,0,0,,<Мен жүргізушімен де қабілетімнің айырмашылығын көрсете алдым➡
Dialogue: 0,0:08:16.62,0:08:20.96,Default,,0,0,0,,Одан да ойша басымдыққа ие болғаным ауырады.＞
Dialogue: 0,0:08:20.96,0:08:24.63,Default,,0,0,0,,135 ярд қалды. 8 санын ала аламын ба?
Dialogue: 0,0:08:24.63,0:08:27.97,Default,,0,0,0,,Мен керемет алдын ала соққыға ұшырадым.
Dialogue: 0,0:08:27.97,0:08:31.31,Default,,0,0,0,,А... онша уайымдамайсың.
Dialogue: 0,0:08:31.31,0:08:35.01,Default,,0,0,0,,Жарайды, мен қазір қатты шаршадым.
Dialogue: 0,0:08:37.98,0:08:39.98,Default,,0,0,0,,<Нағыз гольф дегеніміз➡
Dialogue: 0,0:08:39.98,0:08:42.58,Default,,0,0,0,,Мен мұны тек сол қызбен ғана істей аламын деп ойладым＞
Dialogue: 0,0:08:43.65,0:08:46.65,Default,,0,0,0,,<Сіз оны шынымен әдемі өртеп жібердіңіз.>
Dialogue: 0,0:08:46.65,0:08:50.06,Default,,0,0,0,,<Сақтандырғышта өрт бар>
Dialogue: 0,0:08:50.93,0:08:54.90,Default,,0,0,0,,<Көк оқтың үздіксіз шабуылы! ＞
Dialogue: 0,0:08:54.90,0:09:02.94,Default,,0,0,0,,♬～
Dialogue: 0,0:09:02.94,0:09:05.27,Default,,0,0,0,,О, құстың мүмкіндігі
Dialogue: 0,0:09:05.27,0:09:07.28,Default,,0,0,0,,Сіз не нәрсеге қуаныштысыз?
Dialogue: 0,0:09:07.28,0:09:11.61,Default,,0,0,0,,Осы кезде Роуздың бүркіттік мүмкіндігі бар.
Dialogue: 0,0:09:11.61,0:09:15.28,Default,,0,0,0,,Қанқызыл раушан оғы!
Dialogue: 0,0:09:15.28,0:09:22.29,Default,,0,0,0,,♬～
Dialogue: 0,0:09:22.29,0:09:25.29,Default,,0,0,0,,<Желіде болмау>
Dialogue: 0,0:09:25.29,0:09:27.30,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:09:27.30,0:09:29.60,Default,,0,0,0,,Ей эй эй эй эй эй
Dialogue: 0,0:09:31.97,0:09:36.30,Default,,0,0,0,,Ху... Жақсы, шықты (Кэтрин) Цк.
Dialogue: 0,0:09:36.30,0:09:38.64,Default,,0,0,0,,Бұл ұят, ханым.
Dialogue: 0,0:09:38.64,0:09:40.98,Default,,0,0,0,,Мен оны алып тастаймын деп ешқашан ойламадым.
Dialogue: 0,0:09:40.98,0:09:44.65,Default,,0,0,0,,Сіздің ойын сезіміңіз әлі оралмаған сияқты.
Dialogue: 0,0:09:44.65,0:09:47.65,Default,,0,0,0,,Бірақ ештеңені түзету мүмкін емес.
Dialogue: 0,0:09:47.65,0:09:54.99,Default,,0,0,0,,♬～
Dialogue: 0,0:09:54.99,0:09:58.99,Default,,0,0,0,,Екі құс те кенеттен өледі.
Dialogue: 0,0:09:58.99,0:10:02.33,Default,,0,0,0,,<Алайда, Роуз мазмұны жағынан басым>
Dialogue: 0,0:10:02.33,0:10:05.33,Default,,0,0,0,,<Егер бұл жалғаса берсе, ол сыртқа шығарылады>
Dialogue: 0,0:10:05.33,0:10:07.64,Default,,0,0,0,,Тесік орналасуын өзгерту
Dialogue: 0,0:10:21.68,0:10:24.39,Default,,0,0,0,,「Ｐａｒ３ １５８ｙｄｓ」
Dialogue: 0,0:10:25.35,0:10:28.02,Default,,0,0,0,,<Тоғандармен қоршалған жасыл арал>
Dialogue: 0,0:10:28.02,0:10:31.03,Default,,0,0,0,,Жасыл түсті соға алмасаң, болды.
Dialogue: 0,0:10:31.03,0:10:33.03,Default,,0,0,0,,Мен оны ұстаймын
Dialogue: 0,0:10:34.70,0:10:36.70,Default,,0,0,0,,<Бірінші қадам, әрине, жасалды>
Dialogue: 0,0:10:36.70,0:10:42.04,Default,,0,0,0,,<Бірақ Роуздың арқасы әлі менің ауқымымда>
Dialogue: 0,0:10:42.04,0:10:45.37,Default,,0,0,0,,<Аспанның қызыл оғы! ＞
Dialogue: 0,0:10:45.37,0:10:50.65,Default,,0,0,0,,♬～
Dialogue: 0,0:10:50.65,0:10:52.65,Default,,0,0,0,,Жарайды, жақсы түсірілді.
Dialogue: 0,0:10:52.65,0:10:55.32,Default,,0,0,0,,(Стефани) Сол сөзіңді қайтарып ал. (Сора) Ә?
Dialogue: 0,0:10:55.32,0:10:57.32,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:10:57.32,0:11:04.66,Default,,0,0,0,,♬～
Dialogue: 0,0:11:04.66,0:11:07.66,Default,,0,0,0,,Қарғыс атсын... Бұл ұят.
Dialogue: 0,0:11:07.66,0:11:10.67,Default,,0,0,0,,<Бір қадам жақындау>
Dialogue: 0,0:11:10.67,0:11:13.00,Default,,0,0,0,,<Ал ше?>
Dialogue: 0,0:11:13.00,0:11:18.01,Default,,0,0,0,,<Мен сізге күйдегі айырмашылықты көрсетемін>
Dialogue: 0,0:11:18.01,0:11:27.68,Default,,0,0,0,,♬～
Dialogue: 0,0:11:27.68,0:11:31.09,Default,,0,0,0,,(Жалпы тыныс алу дыбысы)
Dialogue: 0,0:11:33.69,0:11:36.02,Default,,0,0,0,,Сен сондай ақымақсың...
Dialogue: 0,0:11:36.02,0:11:39.63,Default,,0,0,0,,Оны сол жерде қалдырыңыз.
Dialogue: 0,0:11:44.03,0:11:46.03,Default,,0,0,0,,А... а...
Dialogue: 0,0:11:46.03,0:11:50.31,Default,,0,0,0,,Жүрегіңе зиян. (Роза) Бұл бос уақыт.
Dialogue: 0,0:11:50.31,0:11:53.64,Default,,0,0,0,,Екеуіңе де жақсы ма? Иә
Dialogue: 0,0:11:53.64,0:11:56.31,Default,,0,0,0,,<Бірге күйіп өлу>
Dialogue: 0,0:11:56.31,0:11:58.61,Default,,0,0,0,,<Келесіге мақсат қойыңыз>
Dialogue: 0,0:12:12.96,0:12:15.30,Default,,0,0,0,,Сырттағы хабарламаны көрмедің бе? ⚟ (есік жабылған дыбыс)
Dialogue: 0,0:12:15.30,0:12:17.30,Default,,0,0,0,,Біз жабықпыз...
Dialogue: 0,0:12:18.63,0:12:22.64,Default,,0,0,0,,<Бұл адам Хауаға гольф ойнауды үйретті...>
Dialogue: 0,0:12:22.64,0:12:26.64,Default,,0,0,0,,Ұшаққа мініп, ақыры осында жеттім.
Dialogue: 0,0:12:26.64,0:12:29.98,Default,,0,0,0,,Маған сусын беруге рұқсат ете аласыз ба?
Dialogue: 0,0:12:29.98,0:12:31.98,Default,,0,0,0,,Дүкен жабылады, солай ма?
Dialogue: 0,0:12:31.98,0:12:35.58,Default,,0,0,0,,Қаласаңыз, қалған спиртті маған сатыңыз.
Dialogue: 0,0:12:39.32,0:12:42.59,Default,,0,0,0,,Хауа қазір жоқ.
Dialogue: 0,0:12:42.59,0:12:44.93,Default,,0,0,0,,Ол балаға пайда жоқ.
Dialogue: 0,0:12:44.93,0:12:48.26,Default,,0,0,0,,Маған ескі танысым телефон соқты.
Dialogue: 0,0:12:48.26,0:12:50.60,Default,,0,0,0,,Сізден бір нәрсе сұрасам болады ма?
Dialogue: 0,0:12:50.60,0:12:53.60,Default,,0,0,0,,Неліктен Хауаны гольф ойнауға үйреттің?
Dialogue: 0,0:12:54.60,0:12:57.27,Default,,0,0,0,,Бір адам менен сұрады
Dialogue: 0,0:12:57.27,0:12:59.27,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:12:59.27,0:13:01.94,Default,,0,0,0,,Себебі мен көз жеткізгім келді.
Dialogue: 0,0:13:01.94,0:13:04.28,Default,,0,0,0,,Сіз нені растағыңыз келді?
Dialogue: 0,0:13:04.28,0:13:07.28,Default,,0,0,0,,Бір ғана сұрақ болуы керек.
Dialogue: 0,0:13:08.28,0:13:10.95,Default,,0,0,0,,Менің бір ғана сұрағым бар.
Dialogue: 0,0:13:10.95,0:13:13.96,Default,,0,0,0,,Хауа мафияға бағынышты болды ма?
Dialogue: 0,0:13:16.96,0:13:19.29,Default,,0,0,0,,Міне, мен қыңыр бас тартамын.
Dialogue: 0,0:13:19.29,0:13:21.96,Default,,0,0,0,,Онда уайымдаудың қажеті жоқ.
Dialogue: 0,0:13:21.96,0:13:25.97,Default,,0,0,0,,Үніңді жап, күт, ол қайтып келеді.
Dialogue: 0,0:13:25.97,0:13:45.92,Default,,0,0,0,,♬～
Dialogue: 0,0:13:45.92,0:14:05.94,Default,,0,0,0,,♬～
Dialogue: 0,0:14:05.94,0:14:14.62,Default,,0,0,0,,♬～
Dialogue: 0,0:14:14.62,0:14:16.62,Default,,0,0,0,,7 саңылау дәйекті тарту
Dialogue: 0,0:14:16.62,0:14:19.29,Default,,0,0,0,,Ол қанша уақытқа созылады?
Dialogue: 0,0:14:19.29,0:14:21.59,Default,,0,0,0,,Тесік орналасуын өзгерту
Dialogue: 0,0:14:25.29,0:14:28.30,Default,,0,0,0,,<Раушан, сен тым қиынсың.>
Dialogue: 0,0:14:28.30,0:14:32.63,Default,,0,0,0,,<Бірақ мен кішкентай қыздың ойын стилін зерттегеніме қуаныштымын>
Dialogue: 0,0:14:32.63,0:14:34.97,Default,,0,0,0,,<Ол бала тек допты тура соға алады.>
Dialogue: 0,0:14:34.97,0:14:36.97,Default,,0,0,0,,＜Егер➡
Dialogue: 0,0:14:36.97,0:14:41.24,Default,,0,0,0,,Тек түзу жүріп, шұңқырды бағындыра алмайсың.
Dialogue: 0,0:14:41.24,0:14:43.58,Default,,0,0,0,,Бұл... бұл зал
Dialogue: 0,0:14:43.58,0:14:52.25,Default,,0,0,0,,♬～
Dialogue: 0,0:14:52.25,0:14:55.26,Default,,0,0,0,,<Сол кәрі қаңбақ дайындалған>
Dialogue: 0,0:14:55.26,0:14:58.59,Default,,0,0,0,,<Иә, мен жаттықтым>
Dialogue: 0,0:14:58.59,0:15:02.26,Default,,0,0,0,,<8-параграф 4 470 ярд>
Dialogue: 0,0:15:02.26,0:15:04.60,Default,,0,0,0,,<Егер сіз кесілген допты бірінші соққыда соқсаңыз➡
Dialogue: 0,0:15:04.60,0:15:06.60,Default,,0,0,0,,2 соққы мүмкін болатын тесіктер＞
Dialogue: 0,0:15:06.60,0:15:09.27,Default,,0,0,0,,<Бірақ сіз тек тура соғуға болады➡
Dialogue: 0,0:15:09.27,0:15:12.61,Default,,0,0,0,,Жасылға жету үшін кемінде 3 рет ату керек>
Dialogue: 0,0:15:12.61,0:15:15.28,Default,,0,0,0,,<Бұл баланың соңы.>
Dialogue: 0,0:15:15.28,0:15:18.61,Default,,0,0,0,,Хауа, бұл сіздің гольф алаңыңыз...
Dialogue: 0,0:15:18.61,0:15:21.32,Default,,0,0,0,,Мен сені атып тастаймын, солай ма?
Dialogue: 0,0:15:24.95,0:15:27.62,Default,,0,0,0,,<Енді не істеуіміз керек? Хауа>
Dialogue: 0,0:15:27.62,0:15:29.96,Default,,0,0,0,,<Сіз не істемексіз? Хауа>
Dialogue: 0,0:15:29.96,0:15:36.56,Default,,0,0,0,,<Не істесең де, тура соғудан басқа амалың жоқ.>
Dialogue: 0,0:15:37.63,0:15:40.23,Default,,0,0,0,,<Оқтар жеті түсті>
Dialogue: 0,0:15:40.23,0:15:42.24,Default,,0,0,0,,<Жарқыра, Аой! ＞
Dialogue: 0,0:15:53.58,0:15:56.58,Default,,0,0,0,,<Тілім...> (Раушан) <Бұл доп! ? ＞
Dialogue: 0,0:15:56.58,0:15:59.59,Default,,0,0,0,,<Оны қалай ұруға болады!? ? ＞
Dialogue: 0,0:15:59.59,0:16:04.59,Default,,0,0,0,,♬～
Dialogue: 0,0:16:04.59,0:16:08.26,Default,,0,0,0,,Допты кесуді қашан үйрендің?
Dialogue: 0,0:16:08.26,0:16:10.97,Default,,0,0,0,,VR (раушан) не?
Dialogue: 0,0:16:12.27,0:16:14.27,Default,,0,0,0,,《Тесіктелген доп? 》
Dialogue: 0,0:16:14.27,0:16:16.94,Default,,0,0,0,,《Алғаш рет саған қарсы шықтым➡
Dialogue: 0,0:16:16.94,0:16:18.94,Default,,0,0,0,,Бұл керемет хит болды.
Dialogue: 0,0:16:18.94,0:16:22.94,Default,,0,0,0,,《Ол туралы айтып бер》 《Иә, жақсы, бірақ...》
Dialogue: 0,0:16:22.94,0:16:25.28,Default,,0,0,0,,《...Ева, бір тілім соға алмайсың ба? 》
Dialogue: 0,0:16:25.28,0:16:27.95,Default,,0,0,0,,《Жаман ба? 》 《Жоқ, олай емес...》
Dialogue: 0,0:16:27.95,0:16:30.28,Default,,0,0,0,,《Олай болса, тез айтыңызшы! 》
Dialogue: 0,0:16:30.28,0:16:32.29,Default,,0,0,0,,《Иә...》
Dialogue: 0,0:16:33.62,0:16:39.63,Default,,0,0,0,,Бұл мен алған жаңа кемпірқосақ оқ: Қисық күлгін оқ
Dialogue: 0,0:16:39.63,0:16:41.90,Default,,0,0,0,,«Күлгін оқ»
Dialogue: 0,0:16:41.90,0:16:44.90,Default,,0,0,0,,Мен сенің арқаңа мылтық тақтым.
Dialogue: 0,0:16:44.90,0:16:46.90,Default,,0,0,0,,Қазір кез келген уақытта түсіре аласыз.
Dialogue: 0,0:16:46.90,0:16:49.24,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:16:49.24,0:16:52.57,Default,,0,0,0,,<Менің жалыным онша жылы емес>
Dialogue: 0,0:16:52.57,0:16:57.58,Default,,0,0,0,,<Өрт, қызыл раушан оқ! ＞
Dialogue: 0,0:16:59.25,0:17:01.25,Default,,0,0,0,,<Уф>
Dialogue: 0,0:17:09.92,0:17:12.26,Default,,0,0,0,,Мен саған айттым ғой, солай ма?
Dialogue: 0,0:17:12.26,0:17:14.96,Default,,0,0,0,,«Ол менің арқама мылтық тақты»
Dialogue: 0,0:17:16.93,0:17:18.93,Default,,0,0,0,,Ах... ханым.
Dialogue: 0,0:17:18.93,0:17:21.27,Default,,0,0,0,,Үніңді жап, сөмкеңді алып жүр!
Dialogue: 0,0:17:21.27,0:17:23.27,Default,,0,0,0,,бұл... Иә, кешіріңіз.
Dialogue: 0,0:17:25.94,0:17:30.28,Default,,0,0,0,,<Роздың қазіргі соққысы азырақ болды>
Dialogue: 0,0:17:30.28,0:17:34.28,Default,,0,0,0,,<Әсер ету сәті: Бірдеңе болды ма? ＞
Dialogue: 0,0:17:35.28,0:17:37.29,Default,,0,0,0,,<Жер бетінде не...>
Dialogue: 0,0:17:37.29,0:17:48.90,Default,,0,0,0,,♬～
Dialogue: 0,0:17:48.90,0:17:50.90,Default,,0,0,0,,<Жақсы қосулы>
Dialogue: 0,0:17:50.90,0:17:54.24,Default,,0,0,0,,<Бірақ №7-ге дейінгі пьесамен салыстырғанда➡
Dialogue: 0,0:17:54.24,0:17:56.57,Default,,0,0,0,,Түсірілім дәлдігі төмендегені анық>
Dialogue: 0,0:17:56.57,0:17:58.57,Default,,0,0,0,,Ева мүмкіндігі
Dialogue: 0,0:17:58.57,0:18:00.58,Default,,0,0,0,,Мен оны енді шешпеймін
Dialogue: 0,0:18:00.58,0:18:09.58,Default,,0,0,0,,♬～
Dialogue: 0,0:18:09.58,0:18:12.59,Default,,0,0,0,,Жүр! Ішке кір!
Dialogue: 0,0:18:12.59,0:18:17.59,Default,,0,0,0,,♬～
Dialogue: 0,0:18:17.59,0:18:20.60,Default,,0,0,0,,А, мен сол жерде болдым!
Dialogue: 0,0:18:20.60,0:18:23.00,Default,,0,0,0,,Менің ойымша, бұл енді жеңіс.
Dialogue: 0,0:18:23.93,0:18:28.27,Default,,0,0,0,,<Бірақ бұл матчта мен бірінші рет бастаманы өз қолыма ала алдым>
Dialogue: 0,0:18:28.27,0:18:30.27,Default,,0,0,0,,<Арақашықтық 4м-ден сәл артық>
Dialogue: 0,0:18:30.27,0:18:32.94,Default,,0,0,0,,<Екі шарға арналған ілмек сызығы>
Dialogue: 0,0:18:32.94,0:18:35.28,Default,,0,0,0,,<Егер ол кәдімгі пут болса да➡
Dialogue: 0,0:18:35.28,0:18:38.28,Default,,0,0,0,,Бұл матчта өмірге қауіп төніп тұр>
Dialogue: 0,0:18:38.28,0:18:42.22,Default,,0,0,0,,<Розаға жеткілікті қысым жасау керек>
Dialogue: 0,0:18:42.22,0:18:45.52,Default,,0,0,0,,<Жоқ, бұл мүлдем жансызданады.>
Dialogue: 0,0:18:46.55,0:18:49.22,Default,,0,0,0,,<Гольфты осылай ойнау керек>
Dialogue: 0,0:18:49.22,0:18:51.23,Default,,0,0,0,,<Күлдіңіз бе? ＞
Dialogue: 0,0:18:51.23,0:18:57.23,Default,,0,0,0,,♬～
Dialogue: 0,0:18:57.23,0:19:00.57,Default,,0,0,0,,Сіз сүңгіп жатқан сұмдықтардың саны әртүрлі.
Dialogue: 0,0:19:00.57,0:19:02.57,Default,,0,0,0,,Қ–… Сен, порноман!
Dialogue: 0,0:19:02.57,0:19:04.57,Default,,0,0,0,,Nice Inn
Dialogue: 0,0:19:09.91,0:19:13.25,Default,,0,0,0,,「９ｔｈ Ｐａｒ５ ６０５ｙｄｓ」
Dialogue: 0,0:19:13.25,0:19:15.25,Default,,0,0,0,,Өте ұзын тесік
Dialogue: 0,0:19:15.25,0:19:17.92,Default,,0,0,0,,Роуздың ату күші төмендеді.
Dialogue: 0,0:19:17.92,0:19:19.92,Default,,0,0,0,,Тартыңыз Иә.
Dialogue: 0,0:19:22.59,0:19:24.59,Default,,0,0,0,,<Розаның жағдайы әрине төмендеп барады>
Dialogue: 0,0:19:24.59,0:19:26.59,Default,,0,0,0,,＜Бірақ➡
Dialogue: 0,0:19:26.59,0:19:31.60,Default,,0,0,0,,Қайталанатын күйзеліс пен қысымның салдарынан Хауаның зейіні төмендей бастайды.
Dialogue: 0,0:19:31.60,0:19:34.30,Default,,0,0,0,,<Сәттілік Ева>
Dialogue: 0,0:19:35.27,0:19:41.61,Default,,0,0,0,,<ханым. Кляйн, Лили, Эмили, Шарлотта, Джессика>
Dialogue: 0,0:19:41.61,0:19:44.61,Default,,0,0,0,,<"Маған күш-қуатыңды бер" деме>
Dialogue: 0,0:19:44.61,0:19:48.95,Default,,0,0,0,,<Бірақ бұл сезімді оққа салыңыз>
Dialogue: 0,0:19:48.95,0:19:51.25,Default,,0,0,0,,<Жүктелу аяқталды>
Dialogue: 0,0:19:53.29,0:19:57.29,Default,,0,0,0,,Көк оқтың жарылуы!
Dialogue: 0,0:19:57.29,0:20:05.30,Default,,0,0,0,,♬～
Dialogue: 0,0:20:05.30,0:20:07.97,Default,,0,0,0,,Қандай... қандай траектория!
Dialogue: 0,0:20:07.97,0:20:11.64,Default,,0,0,0,,Доп түскен жоқ Әлі құлаған жоқ
Dialogue: 0,0:20:11.64,0:20:13.64,Default,,0,0,0,,Әлі де құлап жатқан жоқ
Dialogue: 0,0:20:15.31,0:20:18.98,Default,,0,0,0,,Жай ғана құла!
Dialogue: 0,0:20:18.98,0:20:30.66,Default,,0,0,0,,♬～
Dialogue: 0,0:20:30.66,0:20:32.99,Default,,0,0,0,,Ұшу қашықтығы...
Dialogue: 0,0:20:32.99,0:20:35.66,Default,,0,0,0,,… «278 ярд»!
Dialogue: 0,0:20:35.66,0:20:39.00,Default,,0,0,0,,Бұл бүгінгі таңдағы ең жақсы диск. (Бағыныңқы) О.
Dialogue: 0,0:20:39.00,0:20:40.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:40.94,0:20:44.94,Default,,0,0,0,,Бұл... Бұл... Бұл ақымақтық.
Dialogue: 0,0:20:44.94,0:20:47.24,Default,,0,0,0,,Мықты болыңыз, ханым.
Dialogue: 0,0:20:50.95,0:20:53.95,Default,,0,0,0,,Бұл жолы алдыңғы жақтан ату
Dialogue: 0,0:20:53.95,0:20:56.95,Default,,0,0,0,,Хмф, көріңіз.
