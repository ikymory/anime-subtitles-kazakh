Dialogue: 0,0:22:30.31,0:22:34.62,Default,,0,0,0,,<Жеңілмеймін, міндетті түрде осы 9 санымен шешемін>
Dialogue: 0,0:22:35.98,0:22:37.99,Default,,0,0,0,,<Әпке…>
Dialogue: 0,0:22:38.99,0:22:42.26,Default,,0,0,0,,《Раушан, саған бәрі бар》
Dialogue: 0,0:22:42.26,0:22:44.26,Default,,0,0,0,,<Шу>
Dialogue: 0,0:22:44.26,0:22:46.93,Default,,0,0,0,,《Ақымақ әйел》
Dialogue: 0,0:22:46.93,0:22:49.26,Default,,0,0,0,,<Urusee>
Dialogue: 0,0:22:49.26,0:22:52.60,Default,,0,0,0,,<Мен сізге бірегей кадрды көрсетемін>
Dialogue: 0,0:22:52.60,0:22:54.60,Default,,0,0,0,,<Оны жеп ал>
Dialogue: 0,0:22:54.60,0:22:56.60,Default,,0,0,0,,<Гурендікі...>
Dialogue: 0,0:22:58.61,0:23:01.61,Default,,0,0,0,,<Роз Барретт! ＞
