Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,(жоғары және анық дыбыс)
Dialogue: 0,0:00:06.20,0:00:10.04,Default,,0,0,0,,Біздің атымыз Шарлатан
Dialogue: 0,0:00:10.12,0:00:12.88,Default,,0,0,0,,(қорқынышты күлкі)
Dialogue: 0,0:00:12.96,0:00:14.42,Default,,0,0,0,,(дірілдеген дауыс)
Dialogue: 0,0:00:14.50,0:00:16.88,Default,,0,0,0,,(қорқынышты күлкі)
Dialogue: 0,0:00:19.09,0:00:20.38,Default,,0,0,0,,Сіз...
Dialogue: 0,0:00:21.84,0:00:23.76,Default,,0,0,0,,Сен!
Dialogue: 0,0:00:23.85,0:00:25.93,Default,,0,0,0,,(Күш дауысы және жүгірген аяқ дыбысы)
Dialogue: 0,0:00:26.43,0:00:27.35,Default,,0,0,0,,Бұл кептеліс!
Dialogue: 0,0:00:29.18,0:00:30.27,Default,,0,0,0,,(батыл тыныс алу)
Dialogue: 0,0:00:32.31,0:00:35.44,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:00:35.52,0:00:37.86,Default,,0,0,0,,I Сіз туралы
Dialogue: 0,0:00:37.94,0:00:39.61,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:00:39.69,0:00:43.78,Default,,0,0,0,,Сіз мұны бұрын біреудің көзімен көрдіңіз бе?
Dialogue: 0,0:00:43.87,0:00:47.12,Default,,0,0,0,,Ол баланың аты... Мен сенімдімін...
Dialogue: 0,0:00:47.20,0:00:48.37,Default,,0,0,0,,Луис
Dialogue: 0,0:00:48.45,0:00:49.83,Default,,0,0,0,,(демілеу)
Dialogue: 0,0:00:49.91,0:00:52.62,Default,,0,0,0,,(Қауіпті музыка)
Dialogue: 0,0:00:58.42,0:01:02.18,Default,,0,0,0,,(♪~Ашық ән)
Dialogue: 0,0:01:12.14,0:01:17.52,Default,,0,0,0,,♪ Қарапайым, көбінесе қуаныш, ашу, қайғы, махаббат, сіздің ойларыңыз ♪
Dialogue: 0,0:01:17.61,0:01:21.65,Default,,0,0,0,,♪ Бір күні түсінерсіз ♪
Dialogue: 0,0:01:21.74,0:01:23.78,Default,,0,0,0,,♪ Талай рет кесіп, жапсырдым ♪
Dialogue: 0,0:01:23.86,0:01:26.12,Default,,0,0,0,,♪ Цугихаги онсыз да аянышты ♪
Dialogue: 0,0:01:26.20,0:01:31.16,Default,,0,0,0,,♪ Мен тірі болудың анықтамасын да білмеймін ♪
Dialogue: 0,0:01:31.25,0:01:34.46,Default,,0,0,0,,♪ Тек екеуміз ♪
Dialogue: 0,0:01:34.54,0:01:38.54,Default,,0,0,0,,♪ ♪ деп айтудың қажеті жоқ
Dialogue: 0,0:01:38.63,0:01:44.97,Default,,0,0,0,,♪ Мен бір-бірімізді түсінетін сияқтымын, бірақ әлі ♪ емес
Dialogue: 0,0:01:45.05,0:01:48.10,Default,,0,0,0,,♪ Бұл жақсы ♪
Dialogue: 0,0:01:49.18,0:01:51.72,Default,,0,0,0,,♪ Менің сүйікті әлемім ♪
Dialogue: 0,0:01:51.81,0:01:56.35,Default,,0,0,0,,♪ Сен ғана бере алатын нұрмен ♪
Dialogue: 0,0:01:56.44,0:01:58.86,Default,,0,0,0,,♪ Мынау жарылған көздер ♪
Dialogue: 0,0:01:58.94,0:02:01.36,Default,,0,0,0,,♪ Мен тиіп тұрған дүние ♪
Dialogue: 0,0:02:01.44,0:02:05.74,Default,,0,0,0,,♪ Бәрі жарқырап тұрған сияқты ♪
Dialogue: 0,0:02:05.82,0:02:10.66,Default,,0,0,0,,♪ Ештеңе анық емес ♪
Dialogue: 0,0:02:10.74,0:02:15.54,Default,,0,0,0,,♪ Сіз мені бұл көздерден көре аласыз, солай ма? ♪
Dialogue: 0,0:02:19.04,0:02:22.13,Default,,0,0,0,,♪ Аспан мен қуыс тоғысқанда, арман әлі алда ♪
Dialogue: 0,0:02:22.21,0:02:23.63,Default,,0,0,0,,♪ Өткенге қарасақ ♪
Dialogue: 0,0:02:23.72,0:02:24.59,Default,,0,0,0,,(Ашық ән~♪)
Dialogue: 0,0:02:28.51,0:02:31.56,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:02:31.64,0:02:33.81,Default,,0,0,0,,Номен таныстырайық
Dialogue: 0,0:02:33.89,0:02:36.56,Default,,0,0,0,,Менің сүйкімді немерелерім
Dialogue: 0,0:02:36.64,0:02:38.81,Default,,0,0,0,,Луи және оның әпкесі Доминик.
Dialogue: 0,0:02:39.48,0:02:40.48,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:40.57,0:02:44.82,Default,,0,0,0,,Доминик менің сарайыма жаңа ғана келгеніне қуаныштымын.
Dialogue: 0,0:02:44.90,0:02:48.07,Default,,0,0,0,,Жақында қайтадан шығуым керек.
Dialogue: 0,0:02:48.16,0:02:50.32,Default,,0,0,0,,Мұнда не болғанын екі адамнан сұрау керек.
Dialogue: 0,0:02:50.41,0:02:52.58,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:02:52.66,0:02:56.08,Default,,0,0,0,,... Танысқаныма қуаныштымын.
Dialogue: 0,0:02:56.91,0:02:58.96,Default,,0,0,0,,Басында... былай тұрсын
Dialogue: 0,0:02:59.67,0:03:01.00,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,0:03:01.09,0:03:04.80,Default,,0,0,0,,Не? Нойды адамдар өсірді ме?
Dialogue: 0,0:03:04.88,0:03:05.72,Default,,0,0,0,,Иә
Dialogue: 0,0:03:05.80,0:03:08.63,Default,,0,0,0,,Сонда сіз адам әлемінде болдыңыз ба?
Dialogue: 0,0:03:08.72,0:03:09.72,Default,,0,0,0,,Иә
Dialogue: 0,0:03:09.80,0:03:11.35,Default,,0,0,0,,Ата-анаңа не болды?
Dialogue: 0,0:03:12.01,0:03:13.60,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:03:13.68,0:03:15.73,Default,,0,0,0,,Ата мен әже
Dialogue: 0,0:03:15.81,0:03:19.60,Default,,0,0,0,,Ол мені қарлы күні жалғыз жылап отырғанымды айтты.
Dialogue: 0,0:03:19.69,0:03:21.31,Default,,0,0,0,,және келісім-шарт аяқталады
Dialogue: 0,0:03:21.40,0:03:23.61,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:03:23.69,0:03:26.61,Default,,0,0,0,,Ондай адамның айтқанына сенесің бе?
Dialogue: 0,0:03:26.69,0:03:27.82,Default,,0,0,0,,Луис
Dialogue: 0,0:03:27.90,0:03:31.12,Default,,0,0,0,,Сол адамдардың көпшілігі сізді ұрлап кетті.
Dialogue: 0,0:03:31.20,0:03:33.58,Default,,0,0,0,,Сіз оны жеуге дайын болғанша өсірдіңіз.
Dialogue: 0,0:03:33.66,0:03:34.37,Default,,0,0,0,,Жоқ! ...Уф
Dialogue: 0,0:03:34.45,0:03:34.99,Default,,0,0,0,,(Доминиктің дірілдеген дауысы)
Dialogue: 0,0:03:35.08,0:03:36.37,Default,,0,0,0,,Атасы да, әжесі де
Dialogue: 0,0:03:36.45,0:03:38.12,Default,,0,0,0,,Ол жаман адам емес.
Dialogue: 0,0:03:38.21,0:03:39.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:39.71,0:03:42.63,Default,,0,0,0,,(нәзік музыка)
Dialogue: 0,0:03:44.92,0:03:47.17,Default,,0,0,0,,Әртүрлі…ай
Dialogue: 0,0:03:47.26,0:03:52.14,Default,,0,0,0,,(жылау)
Dialogue: 0,0:03:52.22,0:03:55.52,Default,,0,0,0,,(таңданған дауыс)
Dialogue: 0,0:03:55.60,0:03:57.52,Default,,0,0,0,,А... күте тұрыңыз, не?
Dialogue: 0,0:03:57.60,0:03:59.48,Default,,0,0,0,,(шатастырылған дауыс)
Dialogue: 0,0:03:59.56,0:04:01.10,Default,,0,0,0,,(Ноның жылаған дауысы)
Dialogue: 0,0:04:01.19,0:04:02.48,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:04:05.57,0:04:06.48,Default,,0,0,0,,(Ноның жылаған дауысы)
Dialogue: 0,0:04:06.57,0:04:09.57,Default,,0,0,0,,(жеңіл дыбыс)
Dialogue: 0,0:04:09.65,0:04:11.24,Default,,0,0,0,,Бұл жаман болды...
Dialogue: 0,0:04:12.49,0:04:16.49,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:04:17.41,0:04:18.62,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:04:18.70,0:04:23.00,Default,,0,0,0,,Сол екі адам өлгеннен кейін оларды ұрлаушылар тұтқынға алды ма?
Dialogue: 0,0:04:23.08,0:04:25.04,Default,,0,0,0,,Иә, онда
Dialogue: 0,0:04:25.13,0:04:27.92,Default,,0,0,0,,Әртүрлі жерлерге апарды
Dialogue: 0,0:04:28.01,0:04:30.76,Default,,0,0,0,,Ақыры мұғалімім мені сатып алды.
Dialogue: 0,0:04:30.84,0:04:34.26,Default,,0,0,0,,Бонсоир Чиби-сан
Dialogue: 0,0:04:35.14,0:04:37.31,Default,,0,0,0,,Не? Ол мұғалім кім?
Dialogue: 0,0:04:37.39,0:04:39.06,Default,,0,0,0,,Мені қожайын десең
Dialogue: 0,0:04:39.14,0:04:42.02,Default,,0,0,0,,Ұстазым оны Сенсей деп атаңыз деді.
Dialogue: 0,0:04:42.10,0:04:45.77,Default,,0,0,0,,Жоқ... бұл қиын болған болуы керек.
Dialogue: 0,0:04:45.86,0:04:49.03,Default,,0,0,0,,Не? Мен күнде жақсы тамақ аламын.
Dialogue: 0,0:04:49.11,0:04:52.66,Default,,0,0,0,,Мені Вампир әлеміне осылай әкелді.
Dialogue: 0,0:04:52.74,0:04:55.03,Default,,0,0,0,,Саяхат сияқты болды және көңілді болды.
Dialogue: 0,0:04:55.12,0:04:57.03,Default,,0,0,0,,(тыныштандыратын дыбыс)
Dialogue: 0,0:04:57.12,0:05:00.00,Default,,0,0,0,,(қатты күлу)
Dialogue: 0,0:05:00.08,0:05:02.79,Default,,0,0,0,,Сіз шынымен біртүрлі жігітсіз.
Dialogue: 0,0:05:02.87,0:05:04.17,Default,,0,0,0,,(сүйкімді дыбыс)
Dialogue: 0,0:05:05.88,0:05:07.55,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:05:09.92,0:05:12.43,Default,,0,0,0,,Луи, сен қатты күлесің
Dialogue: 0,0:05:12.51,0:05:14.55,Default,,0,0,0,,Хм
Dialogue: 0,0:05:14.64,0:05:20.06,Default,,0,0,0,,(көңілді музыка)
Dialogue: 0,0:05:37.74,0:05:42.08,Default,,0,0,0,,Луи мен Доми менің алғашқы достарым болды.
Dialogue: 0,0:05:48.84,0:05:52.76,Default,,0,0,0,,Сіз орманның тереңінде қамалда тұратын адамдарсыз ба?
Dialogue: 0,0:05:52.84,0:05:53.84,Default,,0,0,0,,Иә
Dialogue: 0,0:05:53.93,0:05:56.39,Default,,0,0,0,,Мен Мина Фред!
Dialogue: 0,0:05:56.47,0:05:58.05,Default,,0,0,0,,Джил! (Фанни) Фани
Dialogue: 0,0:05:58.14,0:05:59.85,Default,,0,0,0,,Ендеше бірге ойнайық
Dialogue: 0,0:05:59.93,0:06:02.85,Default,,0,0,0,,Ауылдағы балалармен де дос болдым.
Dialogue: 0,0:06:02.93,0:06:05.85,Default,,0,0,0,,Мен де құпия негіз таптым.
Dialogue: 0,0:06:13.74,0:06:16.70,Default,,0,0,0,,Әр күнім өте қызықты өтті
Dialogue: 0,0:06:19.20,0:06:20.87,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:21.45,0:06:25.75,Default,,0,0,0,,Ное басқа адамның қанын сору арқылы түсіне ала ма?
Dialogue: 0,0:06:25.83,0:06:29.84,Default,,0,0,0,,Иә, көп нәрсе дірілдеп көрінеді.
Dialogue: 0,0:06:29.92,0:06:32.30,Default,,0,0,0,,Керемет таңқаларлық! көріңіз
Dialogue: 0,0:06:32.38,0:06:34.84,Default,,0,0,0,,Е... қан ішуге болады ма?
Dialogue: 0,0:06:34.92,0:06:36.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:37.97,0:06:40.39,Default,,0,0,0,,(қан соратын дыбыс)
Dialogue: 0,0:06:41.22,0:06:44.02,Default,,0,0,0,,Иә? Менде көп
Dialogue: 0,0:06:44.10,0:06:45.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:45.35,0:06:47.52,Default,,0,0,0,,О! Керемет таңқаларлық
Dialogue: 0,0:06:47.60,0:06:48.90,Default,,0,0,0,,(Екі адам күрсінді)
Dialogue: 0,0:06:50.19,0:06:52.40,Default,,0,0,0,,Жоқ... мен емес.
Dialogue: 0,0:06:52.48,0:06:53.82,Default,,0,0,0,,Сәлем Жоқ!
Dialogue: 0,0:06:53.90,0:06:55.40,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:06:55.49,0:06:58.45,Default,,0,0,0,,(қан соратын дыбыс)
Dialogue: 0,0:07:00.49,0:07:02.66,Default,,0,0,0,,Сіз қалай ойлайсыз? Но ше?
Dialogue: 0,0:07:05.25,0:07:07.92,Default,,0,0,0,,(мұңды музыка)
Dialogue: 0,0:07:08.00,0:07:09.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:10.00,0:07:11.42,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:07:15.59,0:07:17.34,Default,,0,0,0,,Қараңғыда
Dialogue: 0,0:07:17.43,0:07:20.93,Default,,0,0,0,,Мен Луидің жалғыз еңкейіп отырғанын көрдім.
Dialogue: 0,0:07:23.01,0:07:26.43,Default,,0,0,0,,Бұл... мені қынжылтады.
Dialogue: 0,0:07:27.23,0:07:29.02,Default,,0,0,0,,Осы уақытта маған
Dialogue: 0,0:07:29.10,0:07:31.44,Default,,0,0,0,,Маған альцивист ретінде көбірек күш-қуат болса
Dialogue: 0,0:07:32.44,0:07:35.61,Default,,0,0,0,,Егер мен Луидің өткенін жақсы білетін болсам...
Dialogue: 0,0:07:40.57,0:07:42.41,Default,,0,0,0,,Жатақхана айына бір рет
Dialogue: 0,0:07:42.49,0:07:45.95,Default,,0,0,0,,Шалғайдағы Сад әулетінің сарайынан қонақ келеді.
Dialogue: 0,0:07:46.04,0:07:49.96,Default,,0,0,0,,Луи көптен бері ұстаздар сарайында тұратын сияқты.
Dialogue: 0,0:07:50.04,0:07:54.46,Default,,0,0,0,,Мен туылғаннан кейін көп ұзамай ауруға шалдыққанмын.
Dialogue: 0,0:07:54.55,0:07:58.59,Default,,0,0,0,,Сондықтан оны сауықтыру үшін атасының сарайына көшірді.
Dialogue: 0,0:07:58.67,0:08:01.89,Default,,0,0,0,,Ауру? қандай?
Dialogue: 0,0:08:01.97,0:08:03.10,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:08:03.93,0:08:06.35,Default,,0,0,0,,Әкеңді немесе анаңды көргің келе ме?
Dialogue: 0,0:08:06.43,0:08:08.48,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:08:08.56,0:08:12.23,Default,,0,0,0,,Сад отбасында мен қазірдің өзінде өлдім.
Dialogue: 0,0:08:20.49,0:08:25.24,Default,,0,0,0,,(Найзағай дыбысы)
Dialogue: 0,0:08:28.50,0:08:30.00,Default,,0,0,0,,(есік қағу)
Dialogue: 0,0:08:31.12,0:08:32.00,Default,,0,0,0,,Луис?
Dialogue: 0,0:08:32.08,0:08:33.38,Default,,0,0,0,,(есік ашылады)
Dialogue: 0,0:08:33.46,0:08:35.25,Default,,0,0,0,,Сіз әлі ояусыз ба?
Dialogue: 0,0:08:36.05,0:08:39.76,Default,,0,0,0,,Мм... бүгін түнде сенімен ұйықтай аламын ба?
Dialogue: 0,0:08:42.89,0:08:43.76,Default,,0,0,0,,Луи?
Dialogue: 0,0:08:45.22,0:08:46.93,Default,,0,0,0,,(жеңіл күрсіну)
Dialogue: 0,0:08:47.01,0:08:49.52,Default,,0,0,0,,Мен көмектесе алмаймын, бәрі жақсы.
Dialogue: 0,0:08:50.31,0:08:52.52,Default,,0,0,0,,Олай болса, сөзіңді бөлемін.
Dialogue: 0,0:08:52.60,0:08:55.52,Default,,0,0,0,,Сен де сонда болдың ба, Но?
Dialogue: 0,0:08:57.61,0:08:59.86,Default,,0,0,0,,Не? Бұл не?
Dialogue: 0,0:09:00.74,0:09:04.41,Default,,0,0,0,,Не, Жоқ, сен де күн күркіреуінен қорқасың ба?
Dialogue: 0,0:09:04.49,0:09:06.53,Default,,0,0,0,,(тыныштандыратын дыбыс)
Dialogue: 0,0:09:06.62,0:09:07.91,Default,,0,0,0,,Ұйықтап қалды
Dialogue: 0,0:09:09.16,0:09:11.12,Default,,0,0,0,,Мен сені сағындым, Луис.
Dialogue: 0,0:09:11.21,0:09:13.96,Default,,0,0,0,,Бұрын үшеуміз бірге жаттық.
Dialogue: 0,0:09:14.04,0:09:17.17,Default,,0,0,0,,Ал, мен енді ондай кәрі емеспін.
Dialogue: 0,0:09:18.13,0:09:21.42,Default,,0,0,0,,Мен де... Осында мәңгі қалсам ғой.
Dialogue: 0,0:09:23.26,0:09:24.43,Default,,0,0,0,,Мен үйге келгенде
Dialogue: 0,0:09:24.51,0:09:27.97,Default,,0,0,0,,Күн сайын мен тек сабақ оқып, сабақ аламын.
Dialogue: 0,0:09:28.06,0:09:30.43,Default,,0,0,0,,Мен мұнда бәрімен бірге орманда ойнағанды ​​жөн көремін.
Dialogue: 0,0:09:30.52,0:09:31.93,Default,,0,0,0,,Көңілді
Dialogue: 0,0:09:32.69,0:09:34.31,Default,,0,0,0,,Мен Луиді қызғанамын.
Dialogue: 0,0:09:34.40,0:09:36.36,Default,,0,0,0,,(Мұңды музыка)
Dialogue: 0,0:09:36.44,0:09:37.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:37.40,0:09:39.82,Default,,0,0,0,,(Найзағайдың гүрсілі)
Dialogue: 0,0:09:39.90,0:09:41.57,Default,,0,0,0,,Ах… Ух…
Dialogue: 0,0:09:43.65,0:09:46.62,Default,,0,0,0,,Олай айтпа.
Dialogue: 0,0:09:46.70,0:09:48.37,Default,,0,0,0,,Үлкенірек болыңыз
Dialogue: 0,0:09:48.45,0:09:51.83,Default,,0,0,0,,Егер сіз көп нәрсені білсеңіз, міндетті түрде түсінесіз.
Dialogue: 0,0:09:53.04,0:09:54.83,Default,,0,0,0,,Сіз қаншасыз...
Dialogue: 0,0:09:56.17,0:09:57.33,Default,,0,0,0,,Қанша...
Dialogue: 0,0:09:58.42,0:10:01.84,Default,,0,0,0,,Сізді бәрі жақсы көреді және жақсы көреді ме?
Dialogue: 0,0:10:03.80,0:10:05.34,Default,,0,0,0,,Иә
Dialogue: 0,0:10:05.43,0:10:08.14,Default,,0,0,0,,Көп уақыт өтті...
Dialogue: 0,0:10:08.22,0:10:10.43,Default,,0,0,0,,Тарте татин Эй, эй...
Dialogue: 0,0:10:10.51,0:10:12.48,Default,,0,0,0,,Менің қолым тарте татин емес
Dialogue: 0,0:10:13.35,0:10:15.90,Default,,0,0,0,,Тататата... жіберіңізші
Dialogue: 0,0:10:15.98,0:10:17.35,Default,,0,0,0,,Эй, сәлем...
Dialogue: 0,0:10:17.44,0:10:19.61,Default,,0,0,0,,Хехехе... не қаласаң, соны істе, ақымақ.
Dialogue: 0,0:10:21.57,0:10:24.11,Default,,0,0,0,,Уау! Қарашы, Доми
Dialogue: 0,0:10:24.20,0:10:26.61,Default,,0,0,0,,Бұл әдемі көк ай.
Dialogue: 0,0:10:26.70,0:10:29.12,Default,,0,0,0,,Жоқ... бәрібір қорқынышты.
Dialogue: 0,0:10:29.20,0:10:31.04,Default,,0,0,0,,Бұл дұрыс емес, қараңыз.
Dialogue: 0,0:10:31.12,0:10:34.54,Default,,0,0,0,,Вампир Көк айды көргенде қатты толқып кетті.
Dialogue: 0,0:10:34.62,0:10:37.37,Default,,0,0,0,,Дүниенің түкпір-түкпірінен іздесеңіз, осы баланы ғана табатын шығарсыз.
Dialogue: 0,0:10:39.63,0:10:41.96,Default,,0,0,0,,Әй, қария.
Dialogue: 0,0:10:42.05,0:10:42.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:44.09,0:10:46.88,Default,,0,0,0,,Қарғыс айтушы дегеніміз не?
Dialogue: 0,0:10:49.47,0:10:51.76,Default,,0,0,0,,Қарияның жинайтын бөлмесінде
Dialogue: 0,0:10:51.85,0:10:54.77,Default,,0,0,0,,Мен өзім туралы жазылған материал таптым.
Dialogue: 0,0:10:54.85,0:10:58.65,Default,,0,0,0,,Кешіріңіз, мен оны ұмытып қалдым.
Dialogue: 0,0:10:59.73,0:11:01.57,Default,,0,0,0,,Жақсы айт
Dialogue: 0,0:11:01.65,0:11:04.15,Default,,0,0,0,,Әдейі табылсын деп жасасам да.
Dialogue: 0,0:11:04.24,0:11:07.07,Default,,0,0,0,,Жүр, қолыңды берші.
Dialogue: 0,0:11:07.15,0:11:09.91,Default,,0,0,0,,Өйткені мен сол қарғыстың иесімін.
Dialogue: 0,0:11:09.99,0:11:11.74,Default,,0,0,0,,Әке мен ана
Dialogue: 0,0:11:11.83,0:11:15.08,Default,,0,0,0,,Мүмкін сен мені ұмытқың келгендіктен Домиді дүниеге әкелдің бе?
Dialogue: 0,0:11:17.50,0:11:20.92,Default,,0,0,0,,Қарт менің не істегенімді қалайды?
Dialogue: 0,0:11:21.00,0:11:22.42,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:22.50,0:11:26.42,Default,,0,0,0,,Жоқ... Жоқ, сүйкімді Луи.
Dialogue: 0,0:11:26.51,0:11:30.68,Default,,0,0,0,,Мен сенің нақты ештеңе істегеніңді қаламаймын.
Dialogue: 0,0:11:30.76,0:11:32.68,Default,,0,0,0,,Әкемнің естеліктерінен ➡
Dialogue: 0,0:11:32.76,0:11:36.02,Default,,0,0,0,,Қалағаныңызды жасаңыз.
Dialogue: 0,0:11:36.77,0:11:38.39,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,0:11:38.48,0:11:42.65,Default,,0,0,0,,Сіздің еркіңізден алынған процесс және нәтижелер.
Dialogue: 0,0:11:42.73,0:11:44.15,Default,,0,0,0,,Мен жай ғана байқағым келеді.
Dialogue: 0,0:11:50.57,0:11:51.91,Default,,0,0,0,,Жарайды, алдымен осыны оқимын, бітірген соң екіншісін де оқимыз ба?
Dialogue: 0,0:11:52.83,0:11:55.62,Default,,0,0,0,,Дәмі өте нашар...
Dialogue: 0,0:11:59.04,0:12:00.46,Default,,0,0,0,,Сәлем Луис
Dialogue: 0,0:12:00.54,0:12:02.54,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:02.63,0:12:03.71,Default,,0,0,0,,Құпия
Dialogue: 0,0:12:10.43,0:12:11.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:11.47,0:12:14.10,Default,,0,0,0,,Сәлем Луис, сен не істеп жатырсың?
Dialogue: 0,0:12:14.18,0:12:16.18,Default,,0,0,0,,Сондықтан бұл құпия
Dialogue: 0,0:12:16.27,0:12:17.10,Default,,0,0,0,,Хмф...!
Dialogue: 0,0:12:18.93,0:12:21.60,Default,,0,0,0,,Бұл сізге сыйлық.
Dialogue: 0,0:12:21.69,0:12:23.15,Default,,0,0,0,,Не!
Dialogue: 0,0:12:23.23,0:12:24.77,Default,,0,0,0,,Мен оны асыға күтемін
Dialogue: 0,0:12:24.86,0:12:26.03,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:12:26.11,0:12:29.24,Default,,0,0,0,,Ләззат алу ләззат!
Dialogue: 0,0:12:31.61,0:12:34.49,Default,,0,0,0,,Ойланып қарасаңыз, осы уақыттан бастап аз-аздан
Dialogue: 0,0:12:34.58,0:12:37.70,Default,,0,0,0,,Маған Луидің мінез-құлқы біртүрлі болып кеткен сияқты.
Dialogue: 0,0:12:37.79,0:12:41.75,Default,,0,0,0,,(Мұңды музыка)
Dialogue: 0,0:12:43.71,0:12:46.80,Default,,0,0,0,,Иә? Мен басқа нәрсе жасап жатырмын
Dialogue: 0,0:12:46.88,0:12:50.09,Default,,0,0,0,,Аа, алдыңғысы сәтсіз аяқталды.
Dialogue: 0,0:12:57.60,0:12:59.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:59.73,0:13:02.90,Default,,0,0,0,,Луи, мен істей алатын бірдеңе бар ма?
Dialogue: 0,0:13:03.65,0:13:06.40,Default,,0,0,0,,Луи үшін не істей аламын?
Dialogue: 0,0:13:11.74,0:13:12.78,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:13.78,0:13:15.53,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:15.62,0:13:16.74,Default,,0,0,0,,(есік қағу)
Dialogue: 0,0:13:16.83,0:13:18.24,Default,,0,0,0,,Луис? Жоқ?
Dialogue: 0,0:13:18.33,0:13:19.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:20.45,0:13:21.54,Default,,0,0,0,,Доми, өтінемін...
Dialogue: 0,0:13:21.62,0:13:26.00,Default,,0,0,0,,Жоқ! Мен жаңа ғана қызметшілердің сөйлескенін естідім.
Dialogue: 0,0:13:26.09,0:13:27.09,Default,,0,0,0,,Доми?
Dialogue: 0,0:13:27.17,0:13:28.17,Default,,0,0,0,,Мина...
Dialogue: 0,0:13:28.25,0:13:31.80,Default,,0,0,0,,Мина ертең өлім жазасына кесіледі дейсің бе?
Dialogue: 0,0:13:31.88,0:13:33.51,Default,,0,0,0,,(Екеуі де дем)
Dialogue: 0,0:13:36.68,0:13:40.06,Default,,0,0,0,,Мина... ертең өлім жазасына кесіледі ме?
Dialogue: 0,0:13:40.14,0:13:42.02,Default,,0,0,0,,Сонымен... неге?
Dialogue: 0,0:13:42.10,0:13:43.39,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:43.48,0:13:45.69,Default,,0,0,0,,Өйткені ол бала қарғыс атқанға айналды.
Dialogue: 0,0:13:45.77,0:13:47.69,Default,,0,0,0,,Қарғыс атқан ба?
Dialogue: 0,0:13:47.77,0:13:51.44,Default,,0,0,0,,(Өткір дыбыс)
Dialogue: 0,0:13:51.53,0:13:55.45,Default,,0,0,0,,Қарғыс айтушылардың бастарын Буро (жалаушы) шауып алады.
Dialogue: 0,0:13:55.53,0:13:58.45,Default,,0,0,0,,Сіз білесіз бе? Мина туралы
Dialogue: 0,0:13:58.53,0:14:00.70,Default,,0,0,0,,(қорқынышты музыка)
Dialogue: 0,0:14:00.79,0:14:01.95,Default,,0,0,0,,(демілеу)
Dialogue: 0,0:14:02.66,0:14:04.67,Default,,0,0,0,,Тез барып көмекке келмесем ше?
Dialogue: 0,0:14:04.75,0:14:06.08,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:14:06.17,0:14:08.46,Default,,0,0,0,,Анықтама? Қалай?
Dialogue: 0,0:14:08.54,0:14:11.30,Default,,0,0,0,,Көк Айдың қарғысын өшіре аласыз ба?
Dialogue: 0,0:14:11.38,0:14:13.17,Default,,0,0,0,,Шешім қабылдау мүмкін емес
Dialogue: 0,0:14:13.26,0:14:15.68,Default,,0,0,0,,Мен саған көмектесе алмаймын, Но.
Dialogue: 0,0:14:16.47,0:14:19.22,Default,,0,0,0,,...Неге олай дейсің?
Dialogue: 0,0:14:19.30,0:14:21.72,Default,,0,0,0,,Мен жай ғана фактілерді айтып отырмын.
Dialogue: 0,0:14:21.81,0:14:24.23,Default,,0,0,0,,Сіз тырыспайынша ешқашан білмейсіз
Dialogue: 0,0:14:25.64,0:14:29.31,Default,,0,0,0,,Онда мені құтқаруға тырыс! Енді міне!
Dialogue: 0,0:14:29.40,0:14:30.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:31.48,0:14:32.40,Default,,0,0,0,,Луис…
Dialogue: 0,0:14:32.48,0:14:34.07,Default,,0,0,0,,Тыңда, Жоқ.
Dialogue: 0,0:14:34.74,0:14:36.99,Default,,0,0,0,,Сіз ештеңе істей алмайсыз
Dialogue: 0,0:14:37.07,0:14:38.45,Default,,0,0,0,,(Жүректің соғу дыбысы)
Dialogue: 0,0:14:38.53,0:14:41.45,Default,,0,0,0,,Сіз ештеңе істей алмайсыз
Dialogue: 0,0:14:41.54,0:14:42.45,Default,,0,0,0,,(тыныс алу дыбысы)
Dialogue: 0,0:14:42.54,0:14:44.54,Default,,0,0,0,,Луи ақымақ!
Dialogue: 0,0:14:45.12,0:14:46.96,Default,,0,0,0,,А... Жоқ!
Dialogue: 0,0:14:51.75,0:14:56.09,Default,,0,0,0,,Жоқ мен де Минаға көмектескім келеді.
Dialogue: 0,0:14:56.18,0:14:58.97,Default,,0,0,0,,Мен Минаның ауылдан қашып кетуіне көмектесе аламын ба?
Dialogue: 0,0:15:03.56,0:15:06.48,Default,,0,0,0,,(Мазасыз тыныс алу)
Dialogue: 0,0:15:16.86,0:15:19.24,Default,,0,0,0,,Мина? Не болды, Мина?
Dialogue: 0,0:15:21.07,0:15:24.24,Default,,0,0,0,,(Минаның дірілдеген дауысы)
Dialogue: 0,0:15:25.87,0:15:27.87,Default,,0,0,0,,Мина... жақсысың ба?
Dialogue: 0,0:15:27.96,0:15:30.38,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:15:35.55,0:15:36.51,Default,,0,0,0,,(Фред еңіреп)
Dialogue: 0,0:15:37.47,0:15:39.76,Default,,0,0,0,,Мина... Фред...
Dialogue: 0,0:15:39.84,0:15:42.76,Default,,0,0,0,,(дүбірлі дыбыс)
Dialogue: 0,0:15:42.85,0:15:45.31,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:15:45.39,0:15:47.02,Default,,0,0,0,,Хмф!
Dialogue: 0,0:15:47.10,0:15:48.77,Default,,0,0,0,,Арх!
Dialogue: 0,0:15:48.85,0:15:51.27,Default,,0,0,0,,(Минаның айқайы)
Dialogue: 0,0:15:51.36,0:15:52.36,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:15:56.61,0:15:59.28,Default,,0,0,0,,(Тыныс алудың ауыруы)
Dialogue: 0,0:16:00.82,0:16:03.03,Default,,0,0,0,,Доми… Жоқ…
Dialogue: 0,0:16:03.12,0:16:06.66,Default,,0,0,0,,Мен қуаныштымын... сен амансың...
Dialogue: 0,0:16:07.41,0:16:08.91,Default,,0,0,0,,Не? Луис…
Dialogue: 0,0:16:09.00,0:16:10.92,Default,,0,0,0,,(Сорып алған сияқты)
Dialogue: 0,0:16:11.00,0:16:13.59,Default,,0,0,0,,(Жүректің соғу дыбысы)
Dialogue: 0,0:16:19.51,0:16:22.93,Default,,0,0,0,,(Луи еңіреп)
Dialogue: 0,0:16:25.51,0:16:26.35,Default,,0,0,0,,Луи!
Dialogue: 0,0:16:26.43,0:16:27.31,Default,,0,0,0,,(Өткір дыбыс)
Dialogue: 0,0:16:27.39,0:16:29.48,Default,,0,0,0,,(Жел сияқты дыбыс)
Dialogue: 0,0:16:29.56,0:16:30.48,Default,,0,0,0,,(демілеу)
Dialogue: 0,0:16:33.81,0:16:35.94,Default,,0,0,0,,Джил? Фанни?
Dialogue: 0,0:16:36.02,0:16:39.74,Default,,0,0,0,,Қан... Мен қан алғым келеді...
Dialogue: 0,0:16:39.82,0:16:41.95,Default,,0,0,0,,Қан... Қан!
Dialogue: 0,0:16:42.03,0:16:44.70,Default,,0,0,0,,(Қан соратын дыбыс)
Dialogue: 0,0:16:47.66,0:16:49.83,Default,,0,0,0,,Доми... қаш.
Dialogue: 0,0:16:49.91,0:16:50.96,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:52.83,0:16:53.71,Default,,0,0,0,,Осы әйелдің айналасындағы кеңістік бұрмаланып жатқан сияқты
Dialogue: 0,0:16:53.79,0:16:55.21,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:16:55.29,0:16:57.46,Default,,0,0,0,,(екпінді дауыс)
Dialogue: 0,0:16:59.05,0:17:02.22,Default,,0,0,0,,Луи! Мықты болыңыз! Не болды?
Dialogue: 0,0:17:02.93,0:17:04.76,Default,,0,0,0,,Сіз бұрын болған оқиғаға ашулысыз ба?
Dialogue: 0,0:17:04.85,0:17:07.22,Default,,0,0,0,,Өйткені менің айтқанымды тыңдамадың
Dialogue: 0,0:17:07.89,0:17:09.73,Default,,0,0,0,,Луи, Сәлем Луи!
Dialogue: 0,0:17:09.81,0:17:12.81,Default,,0,0,0,,Өйткені барлығына мен кінәлімін
Dialogue: 0,0:17:12.90,0:17:16.73,Default,,0,0,0,,Өтінемін, кері қайтыңыз!
Dialogue: 0,0:17:28.83,0:17:30.83,Default,,0,0,0,,Өлтіру...
Dialogue: 0,0:17:30.91,0:17:33.75,Default,,0,0,0,,Мені өлтір... Жоқ
Dialogue: 0,0:17:34.92,0:17:36.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:37.59,0:17:40.26,Default,,0,0,0,,Өтінемін, Жоқ.
Dialogue: 0,0:17:41.17,0:17:45.72,Default,,0,0,0,,Мен қайтып бара алмаймын...
Dialogue: 0,0:17:45.80,0:17:49.97,Default,,0,0,0,,Жақында оның басын Буро (жалаушы) алады.
Dialogue: 0,0:17:53.35,0:17:56.77,Default,,0,0,0,,Маған келетін болсақ, Но, бәрібір...
Dialogue: 0,0:17:56.86,0:17:59.48,Default,,0,0,0,,Мен бәрібір өлу керек болсам... бұл сен боларсың!
Dialogue: 0,0:17:59.57,0:18:01.78,Default,,0,0,0,,Менің өлтіргім келеді!
Dialogue: 0,0:18:01.86,0:18:06.28,Default,,0,0,0,,(Мұңды музыка)
Dialogue: 0,0:18:08.16,0:18:10.58,Default,,0,0,0,,Бұл мүмкін емес, Луи...
Dialogue: 0,0:18:12.08,0:18:14.04,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:18:16.50,0:18:17.63,Default,,0,0,0,,(азу тістерінің дыбысы)
Dialogue: 0,0:18:17.71,0:18:22.05,Default,,0,0,0,,(қан соратын дыбыс)
Dialogue: 0,0:18:23.84,0:18:28.05,Default,,0,0,0,,Луи… Луи… Луи…
Dialogue: 0,0:18:28.97,0:18:30.93,Default,,0,0,0,,Өте білімді
Dialogue: 0,0:18:31.01,0:18:33.31,Default,,0,0,0,,Кейде мен сенімен араласамын
Dialogue: 0,0:18:33.39,0:18:35.31,Default,,0,0,0,,Түрі
Dialogue: 0,0:18:35.39,0:18:38.02,Default,,0,0,0,,Біз әрқашан бірге болдық
Dialogue: 0,0:18:38.11,0:18:40.44,Default,,0,0,0,,Менің қымбатты досым
Dialogue: 0,0:18:42.15,0:18:43.07,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:18:50.74,0:18:53.41,Default,,0,0,0,,Хмм... Бұл қауіпті жер еді.
Dialogue: 0,0:18:55.50,0:18:58.42,Default,,0,0,0,,Менің үйге асығуым дұрыс болды.
Dialogue: 0,0:18:58.50,0:19:02.92,Default,,0,0,0,,(қорқынышты дыбыс)
Dialogue: 0,0:19:03.01,0:19:06.17,Default,,0,0,0,,Амансың ба? Жоқ
Dialogue: 0,0:19:10.47,0:19:12.18,Default,,0,0,0,,(сөздерді жоғалтқан дауыс)
Dialogue: 0,0:19:12.26,0:19:13.93,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:19:17.64,0:19:20.19,Default,,0,0,0,,(ауырсыну сияқты)
Dialogue: 0,0:19:27.11,0:19:28.11,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:29.20,0:19:30.53,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,0:19:37.25,0:19:40.71,Default,,0,0,0,,(есіктің қағу және ашылған дыбысы)
Dialogue: 0,0:19:45.30,0:19:50.47,Default,,0,0,0,,Луи оны уақыты келгенде Ноға бергенімді қалайды.
Dialogue: 0,0:19:50.55,0:19:52.22,Default,,0,0,0,,Сен оны маған қалдырдың.
Dialogue: 0,0:19:58.06,0:19:59.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:04.98,0:20:05.86,Default,,0,0,0,,Қада...?
Dialogue: 0,0:20:05.94,0:20:07.86,Default,,0,0,0,,(Мұңды музыка)
Dialogue: 0,0:20:08.82,0:20:12.12,Default,,0,0,0,,Құпия... Бұл саған сыйлық.
Dialogue: 0,0:20:13.45,0:20:17.00,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:20:19.37,0:20:23.63,Default,,0,0,0,,Луи, сен... бұған қалай қарадың...
Dialogue: 0,0:20:24.38,0:20:26.63,Default,,0,0,0,,Мені өлтіріңіз
Dialogue: 0,0:20:26.71,0:20:30.01,Default,,0,0,0,,Менің жүрегімді сол қазықпен тесіп жібер
Dialogue: 0,0:20:30.09,0:20:33.51,Default,,0,0,0,,(ауырсынған жылау дыбысы)
Dialogue: 0,0:20:34.55,0:20:35.76,Default,,0,0,0,,Гуаааа... аа...
Dialogue: 0,0:20:35.85,0:20:37.02,Default,,0,0,0,,Жоқ! (Но қатты жылайды)
Dialogue: 0,0:20:39.60,0:20:42.56,Default,,0,0,0,,Кешіріңіз Луи
Dialogue: 0,0:20:42.65,0:20:45.69,Default,,0,0,0,,Мен де сені құтқара алар едім
Dialogue: 0,0:20:45.77,0:20:49.53,Default,,0,0,0,,Мен сені қалағанымдай өлтіре де алмадым.
Dialogue: 0,0:20:51.36,0:20:52.78,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:54.49,0:20:55.91,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:57.74,0:20:58.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:59.04,0:21:00.46,Default,,0,0,0,,(Сыңғырлаған қоңырау дыбысы)
Dialogue: 0,0:21:01.12,0:21:02.46,Default,,0,0,0,,Денемнің қатып қалатынына ешқандай белгі болмады…
Dialogue: 0,0:21:03.21,0:21:06.88,Default,,0,0,0,,Мен де сүйікті досымды құтқара алмадым.
Dialogue: 0,0:21:06.96,0:21:09.97,Default,,0,0,0,,Мұңды болды, ауырды.
Dialogue: 0,0:21:11.55,0:21:15.60,Default,,0,0,0,,Луимен кездесуге рұқсат етейін бе?
Dialogue: 0,0:21:15.68,0:21:16.60,Default,,0,0,0,,(демілеу)
Dialogue: 0,0:21:16.68,0:21:20.35,Default,,0,0,0,,Осылай жасасаңыз, өзіңізді жалғыз сезінбейтініңізге сенімдімін.
Dialogue: 0,0:21:20.43,0:21:23.85,Default,,0,0,0,,Сонымен... солай ма? Оның орнына...
Dialogue: 0,0:21:26.02,0:21:29.86,Default,,0,0,0,,Маған шын есіміңді айт
Dialogue: 0,0:21:31.44,0:21:33.86,Default,,0,0,0,,Мен...
Dialogue: 0,0:21:33.95,0:21:37.12,Default,,0,0,0,,Сіз ештеңе істей алмайсыз
Dialogue: 0,0:21:40.95,0:21:41.87,Default,,0,0,0,,Екінші жігіт мені мазақ еткенде…
Dialogue: 0,0:21:41.96,0:21:43.79,Default,,0,0,0,,(өткір дыбыс)
Dialogue: 0,0:21:43.87,0:21:48.30,Default,,0,0,0,,(жарқыраған дыбыс)
Dialogue: 0,0:21:49.50,0:21:50.46,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:21:50.55,0:21:53.09,Default,,0,0,0,,Не істеп жатырсың?
Dialogue: 0,0:21:53.18,0:21:55.47,Default,,0,0,0,,Би билеп жатқанда аяғың ауырды ма?
Dialogue: 0,0:21:57.47,0:21:59.18,Default,,0,0,0,,Ванитас…
Dialogue: 0,0:22:05.90,0:22:07.15,Default,,0,0,0,,(♪~соңғы ән)
Dialogue: 0,0:22:07.23,0:22:12.61,Default,,0,0,0,,♪ Ол бастала салысымен соңы ♪ көрінеді
Dialogue: 0,0:22:12.69,0:22:17.45,Default,,0,0,0,,♪ Балмұздақ ыдырап, еріген сияқты ♪
Dialogue: 0,0:22:17.53,0:22:22.25,Default,,0,0,0,,♪ Ең алыс қашықтықта ақырын естіледі ♪
Dialogue: 0,0:22:22.33,0:22:26.88,Default,,0,0,0,,♪ Бір күрсіну толқындай көтеріледі ♪
Dialogue: 0,0:22:26.96,0:22:30.50,Default,,0,0,0,,♪ 〈Өзімді жоғалтқанда〉 ♪
Dialogue: 0,0:22:30.59,0:22:33.42,Default,,0,0,0,,♪ 〈Мен сен боламын〉 ♪
Dialogue: 0,0:22:33.51,0:22:40.22,Default,,0,0,0,,♪ Бірден онға дейін толтырыңыз, ♪ ұстаңыз
Dialogue: 0,0:22:40.31,0:22:43.18,Default,,0,0,0,,♪ Пердені шешіңіз ♪
Dialogue: 0,0:22:43.27,0:22:48.06,Default,,0,0,0,,♪ Сіздің ат тегіңіз де ертең жойылады ♪
Dialogue: 0,0:22:48.15,0:22:50.61,Default,,0,0,0,,♪ 〈Мен іздеген сен бе едің〉 ♪
Dialogue: 0,0:22:50.69,0:22:53.11,Default,,0,0,0,,♪ 〈Өмірімді жалғыз өткізіп, күттім бе?〉 ♪
Dialogue: 0,0:22:53.19,0:22:55.49,Default,,0,0,0,,♪ 〈Сондай нәзік және шексіз〉 ♪
Dialogue: 0,0:22:55.57,0:22:57.45,Default,,0,0,0,,♪ 〈Сен мені түзеттің Сен мені түзеттің〉 ♪
Dialogue: 0,0:22:57.53,0:23:00.20,Default,,0,0,0,,♪ Көз жасыма батып кетемін ♪
Dialogue: 0,0:23:00.28,0:23:02.62,Default,,0,0,0,,♪ Қоштасудан ары ♪
Dialogue: 0,0:23:02.70,0:23:05.04,Default,,0,0,0,,♪ Айналу уақытының ішінде ♪
Dialogue: 0,0:23:05.12,0:23:07.67,Default,,0,0,0,,♪ 〈Сен мені түзеттің Сен мені түзеттің〉 ♪
Dialogue: 0,0:23:07.75,0:23:09.88,Default,,0,0,0,,♪ 〈Есіктен естіген сен бе едің〉 ♪
Dialogue: 0,0:23:09.96,0:23:12.30,Default,,0,0,0,,♪ 〈Мен жылап, барар жерім жоқ кезде?〉 ♪
Dialogue: 0,0:23:12.38,0:23:14.42,Default,,0,0,0,,♪ Айналу уақытының ішінде ♪
Dialogue: 0,0:23:14.51,0:23:17.09,Default,,0,0,0,,♪ Мен енді жалғыз емеспін ♪
Dialogue: 0,0:23:17.18,0:23:19.43,Default,,0,0,0,,♪ Құшақта ♪ кездестік
Dialogue: 0,0:23:19.51,0:23:21.93,Default,,0,0,0,,♪ 〈Сен мені түзеттің Сен мені түзеттің〉 ♪
Dialogue: 0,0:23:23.22,0:23:27.52,Default,,0,0,0,,♪ 〈Мен өзімді жоғалтамын, өзімді жоғалтамын〉 ♪
Dialogue: 0,0:23:27.60,0:23:31.77,Default,,0,0,0,,♪ Мен енді жалғыз емеспін ♪
Dialogue: 0,0:23:31.86,0:23:33.15,Default,,0,0,0,,(Соңғы ән~♪)
Dialogue: 0,0:23:35.44,0:23:37.90,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:23:37.99,0:23:39.82,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,0:23:41.32,0:23:46.32,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
