Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:08.09,Default,,0,0,0,,Мен жетілмегенмін Мен білмейтін нәрселер өте көп
Dialogue: 0,0:00:10.43,0:00:12.22,Default,,0,0,0,,Мысалы...
Dialogue: 0,0:00:15.35,0:00:19.11,Default,,0,0,0,,Ванитас Менің бір сұрағым бар.
Dialogue: 0,0:00:20.07,0:00:22.36,Default,,0,0,0,,Бұл не? Айтыңызшы.
Dialogue: 0,0:00:23.53,0:00:26.03,Default,,0,0,0,,Махаббат деген не...?
Dialogue: 0,0:00:27.45,0:00:31.20,Default,,0,0,0,,(♪~Ашық ән)
Dialogue: 0,0:00:41.17,0:00:46.55,Default,,0,0,0,,♪ Қарапайым, көбінесе қуаныш, ашу, қайғы, махаббат, сіздің ойларыңыз ♪
Dialogue: 0,0:00:46.63,0:00:50.68,Default,,0,0,0,,♪ Бір күні түсінерсіз ♪
Dialogue: 0,0:00:50.76,0:00:52.68,Default,,0,0,0,,♪ Талай рет кесіп, жапсырдым ♪
Dialogue: 0,0:00:52.76,0:00:55.14,Default,,0,0,0,,♪ Цугихаги онсыз да аянышты ♪
Dialogue: 0,0:00:55.23,0:01:00.19,Default,,0,0,0,,♪ Мен тірі болудың анықтамасын да білмеймін ♪
Dialogue: 0,0:01:00.27,0:01:03.48,Default,,0,0,0,,♪ Тек екеуміз ♪
Dialogue: 0,0:01:03.57,0:01:07.57,Default,,0,0,0,,♪ ♪ деп айтудың қажеті жоқ
Dialogue: 0,0:01:07.65,0:01:13.99,Default,,0,0,0,,♪ Мен бір-бірімізді түсінетін сияқтымын, бірақ әлі ♪ емес
Dialogue: 0,0:01:14.08,0:01:17.12,Default,,0,0,0,,♪ Бұл жақсы ♪
Dialogue: 0,0:01:18.21,0:01:20.75,Default,,0,0,0,,♪ Менің сүйікті әлемім ♪
Dialogue: 0,0:01:20.83,0:01:25.38,Default,,0,0,0,,♪ Сен ғана бере алатын нұрмен ♪
Dialogue: 0,0:01:25.46,0:01:27.88,Default,,0,0,0,,♪ Мынау жарылған көздер ♪
Dialogue: 0,0:01:27.97,0:01:30.39,Default,,0,0,0,,♪ Мен тиіп тұрған дүние ♪
Dialogue: 0,0:01:30.47,0:01:34.76,Default,,0,0,0,,♪ Бәрі жарқырап тұрған сияқты ♪
Dialogue: 0,0:01:34.85,0:01:39.69,Default,,0,0,0,,♪ Ештеңе анық емес ♪
Dialogue: 0,0:01:39.77,0:01:44.57,Default,,0,0,0,,♪ Сіз мені бұл көздерден көре аласыз, солай ма? ♪
Dialogue: 0,0:01:48.07,0:01:51.16,Default,,0,0,0,,♪ Аспан мен қуыс тоғысқанда, арман әлі алда ♪
Dialogue: 0,0:01:51.24,0:01:52.57,Default,,0,0,0,,♪ Өткенге қарасақ ♪
Dialogue: 0,0:01:52.66,0:01:53.62,Default,,0,0,0,,(Ашық ән~♪)
Dialogue: 0,0:01:58.46,0:02:01.25,Default,,0,0,0,,Та... Тарте Татин!
Dialogue: 0,0:02:01.33,0:02:03.25,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:02:04.04,0:02:07.34,Default,,0,0,0,,Мен ешқашан бұлай бақытты боламын деп ойламаппын.
Dialogue: 0,0:02:07.42,0:02:11.13,Default,,0,0,0,,Ное әрқашан тарте татинге көз салған.
Dialogue: 0,0:02:11.22,0:02:14.89,Default,,0,0,0,,Маған хабарлағаныңыз үшін рахмет, Доминик.
Dialogue: 0,0:02:14.97,0:02:16.77,Default,,0,0,0,,Сізге көмектесе алу үлкен мәртебе.
Dialogue: 0,0:02:16.85,0:02:19.02,Default,,0,0,0,,Тарте Татин!
Dialogue: 0,0:02:22.35,0:02:24.81,Default,,0,0,0,,Мм... алуға болады ма?
Dialogue: 0,0:02:24.90,0:02:25.90,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:02:28.78,0:02:29.90,Default,,0,0,0,,Дәмді
Dialogue: 0,0:02:34.62,0:02:36.53,Default,,0,0,0,,Хмм.
Dialogue: 0,0:02:37.45,0:02:38.70,Default,,0,0,0,,Тарте татин
Dialogue: 0,0:02:38.79,0:02:41.46,Default,,0,0,0,,Ұстазым маған адам әлемінен естелік ретінде жиі береді.
Dialogue: 0,0:02:41.54,0:02:42.79,Default,,0,0,0,,Ол мен үшін сатып алды.
Dialogue: 0,0:02:42.87,0:02:46.71,Default,,0,0,0,,Алтаспариден тамақ ішетін күн келеді деп ойламаппын.
Dialogue: 0,0:02:47.38,0:02:51.09,Default,,0,0,0,,Сол сияқты, Вампирге де бұл тарте татин ұнады.
Dialogue: 0,0:02:51.17,0:02:54.18,Default,,0,0,0,,Рецепттер адам әлемінен әкелінген сияқты.
Dialogue: 0,0:02:54.26,0:02:56.55,Default,,0,0,0,,Сол вампир
Dialogue: 0,0:02:56.64,0:02:59.68,Default,,0,0,0,,Мүмкін қарияның өзі шығар...
Dialogue: 0,0:03:03.85,0:03:06.69,Default,,0,0,0,,Мені осындай керемет дүкенге әкелгеніңіз үшін рахмет.
Dialogue: 0,0:03:06.77,0:03:08.78,Default,,0,0,0,,Лұқа рахмет
Dialogue: 0,0:03:08.86,0:03:12.15,Default,,0,0,0,,Жоқ... сен маған қонаққа баруға бардың бардың.
Dialogue: 0,0:03:12.24,0:03:14.70,Default,,0,0,0,,Ағамның кеткеніне өкінемін.
Dialogue: 0,0:03:14.78,0:03:15.70,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:15.78,0:03:18.83,Default,,0,0,0,,Ертең кездесуге уақыт бөліңіз⸺
Dialogue: 0,0:03:18.91,0:03:19.99,Default,,0,0,0,,Осылайша әлем бейбітшілік кейпін сақтайды
Dialogue: 0,0:03:20.62,0:03:22.87,Default,,0,0,0,,Маскарадтық балдан кейін не болды, т.б.
Dialogue: 0,0:03:22.96,0:03:24.50,Default,,0,0,0,,Мен сізге бірнеше сұрақтар қойғым келеді.
Dialogue: 0,0:03:26.21,0:03:27.25,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:03:28.29,0:03:31.13,Default,,0,0,0,,Өткен түн үшін көп рахмет.
Dialogue: 0,0:03:31.84,0:03:34.09,Default,,0,0,0,,Мен сізге рахмет
Dialogue: 0,0:03:34.18,0:03:37.89,Default,,0,0,0,,Сол жерде болған көптеген вампирлердің өмірі сақталды.
Dialogue: 0,0:03:37.97,0:03:41.31,Default,,0,0,0,,Ха...
Dialogue: 0,0:03:42.39,0:03:45.44,Default,,0,0,0,,Жоқ... Менде ештеңе жоқ...
Dialogue: 0,0:03:46.60,0:03:47.52,Default,,0,0,0,,Ама!
Dialogue: 0,0:03:48.65,0:03:51.99,Default,,0,0,0,,Мен де саған рахмет айтқым келеді, Ное.
Dialogue: 0,0:03:52.07,0:03:52.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:53.03,0:03:54.95,Default,,0,0,0,,Мен жоқ кезде
Dialogue: 0,0:03:55.03,0:03:57.70,Default,,0,0,0,,Лука-саманы қорғағаны үшін.
Dialogue: 0,0:03:57.78,0:03:58.95,Default,,0,0,0,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,0:03:59.03,0:04:00.24,Default,,0,0,0,,(демілеу)
Dialogue: 0,0:04:02.54,0:04:03.41,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:04:06.00,0:04:08.59,Default,,0,0,0,,Ха...! А, жоқ, бұл дұрыс емес.
Dialogue: 0,0:04:08.67,0:04:10.88,Default,,0,0,0,,Онда бейберекеттік орнатқан мен емес едім.
Dialogue: 0,0:04:10.96,0:04:12.17,Default,,0,0,0,,Ванитастың күші
Dialogue: 0,0:04:12.26,0:04:15.51,Default,,0,0,0,,Мм...!
Dialogue: 0,0:04:17.34,0:04:19.76,Default,,0,0,0,,Әрине, мен білемін.
Dialogue: 0,0:04:19.85,0:04:23.06,Default,,0,0,0,,Қарғыс айтушылардың басын кесуден құтқарды.
Dialogue: 0,0:04:23.14,0:04:26.14,Default,,0,0,0,,Мен оған міндетті түрде қарыздармын.
Dialogue: 0,0:04:26.23,0:04:27.60,Default,,0,0,0,,Хмм…
Dialogue: 0,0:04:27.69,0:04:29.44,Default,,0,0,0,,Бірақ Ванитас
Dialogue: 0,0:04:29.52,0:04:31.52,Default,,0,0,0,,Алғыс айтудан бұрын
Dialogue: 0,0:04:31.61,0:04:34.15,Default,,0,0,0,,Өткен күні болған оқиға үшін кешірім сұрағаныңызды қалаймын.
Dialogue: 0,0:04:34.24,0:04:36.78,Default,,0,0,0,,Кешірім сұрау? Не?
Dialogue: 0,0:04:36.86,0:04:40.49,Default,,0,0,0,,Біз алғаш танысқанда сен Жанна едің...!
Dialogue: 0,0:04:40.58,0:04:44.04,Default,,0,0,0,,Бұл... сіз тым көп жұмыс істеген болуыңыз керек.
Dialogue: 0,0:04:44.12,0:04:46.16,Default,,0,0,0,,О, сіз поцелу дейсіз бе?
Dialogue: 0,0:04:46.25,0:04:47.83,Default,,0,0,0,,Қандай апатты күн.
Dialogue: 0,0:04:49.79,0:04:51.54,Default,,0,0,0,,Миссияны соншалықты тез аяқтағаның үшін абыройлысың
Dialogue: 0,0:04:51.63,0:04:54.34,Default,,0,0,0,,Ең алдымен бұл үшін шын жүректен кешірім сұраңыз.
Dialogue: 0,0:04:54.42,0:04:55.26,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:04:55.34,0:04:57.18,Default,,0,0,0,,Аня Форджер
Dialogue: 0,0:04:57.26,0:04:59.89,Default,,0,0,0,,Қандай қиын жігіт.
Dialogue: 0,0:04:59.97,0:05:03.26,Default,,0,0,0,,Ең алдымен кешірім сұрау кімге арналған?
Dialogue: 0,0:05:03.35,0:05:06.27,Default,,0,0,0,,Жанна? Әлде сен бе?
Dialogue: 0,0:05:06.35,0:05:09.73,Default,,0,0,0,,Бұл... әрине, Жанна үшін.
Dialogue: 0,0:05:09.81,0:05:13.07,Default,,0,0,0,,Олай болса, кешірім сұраудың қажеті жоқ.
Dialogue: 0,0:05:13.15,0:05:14.44,Default,,0,0,0,,(жарқыраған дыбыс)
Dialogue: 0,0:05:14.53,0:05:17.70,Default,,0,0,0,,Жанна екеуміздің сүйіспеншілігіміз бар.
Dialogue: 0,0:05:17.78,0:05:19.70,Default,,0,0,0,,Ұйқыда сөйлесіңіз.
Dialogue: 0,0:05:19.78,0:05:21.57,Default,,0,0,0,,Хехехе…
Dialogue: 0,0:05:21.66,0:05:23.70,Default,,0,0,0,,Ұйқыда сөйлемеу
Dialogue: 0,0:05:23.79,0:05:25.95,Default,,0,0,0,,Мұқият қараңыз.
Dialogue: 0,0:05:26.04,0:05:27.25,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:05:27.33,0:05:30.67,Default,,0,0,0,,Жанна екеуміздің қарым-қатынасымыз бұрыннан бар.
Dialogue: 0,0:05:30.75,0:05:31.79,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:05:31.88,0:05:33.54,Default,,0,0,0,,Нһ!
Dialogue: 0,0:05:33.63,0:05:34.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:34.88,0:05:38.05,Default,,0,0,0,,Белгілеу! Жа... Жаннаныкі
Dialogue: 0,0:05:38.13,0:05:39.68,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:39.76,0:05:41.39,Default,,0,0,0,,Вампир қансорғышқа айналады
Dialogue: 0,0:05:41.47,0:05:45.31,Default,,0,0,0,,Сіздің күшіңіздің бір бөлігін енгізетін белгі
Dialogue: 0,0:05:45.39,0:05:47.23,Default,,0,0,0,,Уф... бұл өтірік!
Dialogue: 0,0:05:47.31,0:05:49.19,Default,,0,0,0,,Мен мұндай нәрсені қалдырғаным есімде жоқ.
Dialogue: 0,0:05:49.27,0:05:52.98,Default,,0,0,0,,Жоқ, жоқ, сіз тым болмаса өз белгіңізді тани аласыз, солай ма?
Dialogue: 0,0:05:53.82,0:05:57.74,Default,,0,0,0,,Сен сол түні өте қатты болдың.
Dialogue: 0,0:05:57.82,0:06:00.99,Default,,0,0,0,,Жадыңыз бір жерде секіріп жатқаны таңқаларлық емес.
Dialogue: 0,0:06:01.07,0:06:03.74,Default,,0,0,0,,Ах... сонша...
Dialogue: 0,0:06:03.83,0:06:06.74,Default,,0,0,0,,Мен онымен әуестеніп кеткеніме сене алар емеспін
Dialogue: 0,0:06:06.83,0:06:10.29,Default,,0,0,0,,Менің қаным соншалықты дәмді болды ма?
Dialogue: 0,0:06:10.37,0:06:13.25,Default,,0,0,0,,Соншалықты мен бейсаналық түрде осылай із қалдырдым.
Dialogue: 0,0:06:13.33,0:06:14.75,Default,,0,0,0,,(дауыссыз дауыс)
Dialogue: 0,0:06:15.55,0:06:19.17,Default,,0,0,0,,Жанна, сен оның қанын шынымен сордың ба?
Dialogue: 0,0:06:19.26,0:06:20.09,Default,,0,0,0,,Лорд Лұқа
Dialogue: 0,0:06:20.17,0:06:22.93,Default,,0,0,0,,Жанна мұндай адам ұнай ма?
Dialogue: 0,0:06:23.01,0:06:25.56,Default,,0,0,0,,Не? Неге ол туралы айтып отырсыз?
Dialogue: 0,0:06:25.64,0:06:27.56,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:06:27.64,0:06:32.23,Default,,0,0,0,,Неліктен сіз оның ізін қалдыру үшін бар күшіңізді саласыз, Ай вампирінің ұрпағы?
Dialogue: 0,0:06:32.31,0:06:35.57,Default,,0,0,0,,Менікі деп айтып тұрғандай.
Dialogue: 0,0:06:35.65,0:06:36.82,Default,,0,0,0,,Қ-қараңыз… ол…
Dialogue: 0,0:06:38.11,0:06:39.44,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:39.53,0:06:42.45,Default,,0,0,0,,(Драмалық музыка)
Dialogue: 0,0:06:42.53,0:06:43.95,Default,,0,0,0,,Хехе...
Dialogue: 0,0:06:44.03,0:06:46.74,Default,,0,0,0,,Кешіріңіз, кешіріңіз, мен сізді тым көп мазақ еттім деп ойлаймын.
Dialogue: 0,0:06:46.83,0:06:49.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:49.66,0:06:50.66,Default,,0,0,0,,Лұқа
Dialogue: 0,0:06:50.75,0:06:53.50,Default,,0,0,0,,Бұл есімнің Жаннаға қойылғаны рас.
Dialogue: 0,0:06:53.58,0:06:56.09,Default,,0,0,0,,Жанна мұны қалағандықтан жасамады.
Dialogue: 0,0:06:56.17,0:06:57.05,Default,,0,0,0,,Ха...
Dialogue: 0,0:06:57.13,0:07:00.47,Default,,0,0,0,,Мен оны мәжбүрлеймін деп ешқашан ойламадым...
Dialogue: 0,0:07:00.55,0:07:03.05,Default,,0,0,0,,Тыңда, тыңда! Тынышталыңыз, бұл қорқынышты
Dialogue: 0,0:07:03.72,0:07:06.64,Default,,0,0,0,,Ол кезде есінен танып қалған.
Dialogue: 0,0:07:06.72,0:07:08.93,Default,,0,0,0,,Сіз де естіген шығарсыз.
Dialogue: 0,0:07:09.02,0:07:11.18,Default,,0,0,0,,Қарғыс айтушылардың айтқан дауысы.
Dialogue: 0,0:07:11.27,0:07:12.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:12.27,0:07:14.65,Default,,0,0,0,,(саңырау дауыс)
Dialogue: 0,0:07:14.73,0:07:17.40,Default,,0,0,0,,Басқа вампирлер сияқты
Dialogue: 0,0:07:17.48,0:07:19.36,Default,,0,0,0,,Жанна да бір сәт өзін ұмытты.
Dialogue: 0,0:07:19.44,0:07:22.20,Default,,0,0,0,,Сен маған кеш қоңырау шалдың.
Dialogue: 0,0:07:22.28,0:07:24.91,Default,,0,0,0,,Бұл рас па? Жанна
Dialogue: 0,0:07:26.03,0:07:28.66,Default,,0,0,0,,Иә, Лұқа.
Dialogue: 0,0:07:28.74,0:07:30.41,Default,,0,0,0,,Хабарлама
Dialogue: 0,0:07:30.50,0:07:32.71,Default,,0,0,0,,Бва! Мен дәл тиетіндей едім...
Dialogue: 0,0:07:32.79,0:07:35.67,Default,,0,0,0,,Иә! Солай болды ма?
Dialogue: 0,0:07:35.75,0:07:38.54,Default,,0,0,0,,Мен жеңілдеп қалдым, солай ма?
Dialogue: 0,0:07:38.63,0:07:41.63,Default,,0,0,0,,Есін жоғалтпағанша⸺
Dialogue: 0,0:07:41.71,0:07:43.93,Default,,0,0,0,,Өзімшіл және шектен тыс дөрекі адамға.
Dialogue: 0,0:07:44.01,0:07:46.30,Default,,0,0,0,,Сіз ешқандай белгі қалдырмайсыз, солай ма?
Dialogue: 0,0:07:46.39,0:07:50.18,Default,,0,0,0,,Не? Лука-кун, сен мені жек көретін шығарсың.
Dialogue: 0,0:07:52.52,0:07:54.94,Default,,0,0,0,,Аман болғаныңызға қуаныштымын, Жанна.
Dialogue: 0,0:07:55.02,0:07:58.19,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:08:00.48,0:08:02.03,Default,,0,0,0,,Кешіріңіз, Лука-сама.
Dialogue: 0,0:08:02.11,0:08:04.03,Default,,0,0,0,,Мен бұл жігітті біраз уақытқа қарызға аламын.
Dialogue: 0,0:08:04.11,0:08:05.82,Default,,0,0,0,,Жанна
Dialogue: 0,0:08:24.92,0:08:26.34,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:08:26.43,0:08:27.76,Default,,0,0,0,,Мен сізге еремін
Dialogue: 0,0:08:27.84,0:08:28.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:29.72,0:08:30.60,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:30.68,0:08:33.31,Default,,0,0,0,,Неліктен бәрі терезеден шығып жатыр?
Dialogue: 0,0:08:33.39,0:08:35.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:38.98,0:08:41.15,Default,,0,0,0,,Неге олай өтірік айттың?
Dialogue: 0,0:08:41.23,0:08:42.19,Default,,0,0,0,,Не?
Dialogue: 0,0:08:42.28,0:08:44.44,Default,,0,0,0,,Шындықты айтқан дұрыс па?
Dialogue: 0,0:08:44.53,0:08:45.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:45.57,0:08:47.82,Default,,0,0,0,,Бұрын болған оқиғаны қарастыру
Dialogue: 0,0:08:47.91,0:08:50.37,Default,,0,0,0,,Сізге қан соратын құмарлық шабуыл жасады.
Dialogue: 0,0:08:50.45,0:08:53.66,Default,,0,0,0,,Ол Луканың білгенін қаламаған сияқты.
Dialogue: 0,0:08:53.74,0:08:55.50,Default,,0,0,0,,Мен оны дұрыс алдадым.
Dialogue: 0,0:08:55.58,0:08:57.00,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:58.83,0:09:01.50,Default,,0,0,0,,Мен мұны бұрын естігенмін, Жанна.
Dialogue: 0,0:09:01.59,0:09:03.25,Default,,0,0,0,,Сіз қарғысқа ұшырадыңыз ба?
Dialogue: 0,0:09:06.09,0:09:09.01,Default,,0,0,0,,Сіз сөйлеспейсіз бе?
Dialogue: 0,0:09:10.64,0:09:12.89,Default,,0,0,0,,Мен әдетте олай әрекет етпеймін.
Dialogue: 0,0:09:12.97,0:09:15.35,Default,,0,0,0,,(Мұңды музыка)
Dialogue: 0,0:09:15.43,0:09:17.23,Default,,0,0,0,,Сіз дәрі ішкенше
Dialogue: 0,0:09:17.31,0:09:19.77,Default,,0,0,0,,Қан соруға деген құштарлықты басуға болады
Dialogue: 0,0:09:19.85,0:09:23.52,Default,,0,0,0,,Бірақ сол күні дәрінің әсері тез басылды.
Dialogue: 0,0:09:23.61,0:09:26.78,Default,,0,0,0,,Хм... Ондай дәрі бар ма?
Dialogue: 0,0:09:26.86,0:09:28.15,Default,,0,0,0,,Басқалардан гөрі қаттырақ айқайлап тұр
Dialogue: 0,0:09:28.24,0:09:30.16,Default,,0,0,0,,(дірілдеп тыныс алу)
Dialogue: 0,0:09:30.24,0:09:31.20,Default,,0,0,0,,Адамдар…
Dialogue: 0,0:09:31.99,0:09:35.29,Default,,0,0,0,,Бұл туралы ешқашан ешкімге айтпаңыз
Dialogue: 0,0:09:35.37,0:09:38.08,Default,,0,0,0,,Жоқ... өтінемін.
Dialogue: 0,0:09:38.16,0:09:39.42,Default,,0,0,0,,Сөйлеме
Dialogue: 0,0:09:39.50,0:09:41.42,Default,,0,0,0,,(тыныш жылап)
Dialogue: 0,0:09:43.25,0:09:47.67,Default,,0,0,0,,Хэхе... Хахахаха!
Dialogue: 0,0:09:50.34,0:09:52.68,Default,,0,0,0,,Уайымдама, Жанна.
Dialogue: 0,0:09:52.76,0:09:56.06,Default,,0,0,0,,Рұқсатсыз ұсталған әйелдің сырын таратпа.
Dialogue: 0,0:09:56.14,0:09:57.60,Default,,0,0,0,,Менің хоббиім емес
Dialogue: 0,0:09:59.27,0:10:01.69,Default,,0,0,0,,Алайда екі шарт бар.
Dialogue: 0,0:10:01.77,0:10:03.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:03.48,0:10:06.15,Default,,0,0,0,,Шарт? (Ванитас) Иә.
Dialogue: 0,0:10:06.23,0:10:10.32,Default,,0,0,0,,Мен сенің сырыңды ешкімге айтпаймын, бірақ...
Dialogue: 0,0:10:10.40,0:10:14.16,Default,,0,0,0,,（）
Dialogue: 0,0:10:15.03,0:10:18.41,Default,,0,0,0,,Енді менің қанымнан басқаның қанын сормау керек.
Dialogue: 0,0:10:18.50,0:10:19.91,Default,,0,0,0,,(демілеу)
Dialogue: 0,0:10:20.00,0:10:24.67,Default,,0,0,0,,(Драмалық музыка)
Dialogue: 0,0:10:24.75,0:10:25.84,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:25.92,0:10:28.42,Default,,0,0,0,,Неліктен мұндай шарт қою керек?
Dialogue: 0,0:10:28.51,0:10:30.42,Default,,0,0,0,,Бұл қарапайым себеп.
Dialogue: 0,0:10:31.13,0:10:34.43,Default,,0,0,0,,Мен сенің қаныңды сорғаным өте жақсы болды.
Dialogue: 0,0:10:34.51,0:10:35.81,Default,,0,0,0,,А...?
Dialogue: 0,0:10:35.89,0:10:38.43,Default,,0,0,0,,Не... ха ха?
Dialogue: 0,0:10:38.52,0:10:43.15,Default,,0,0,0,,Қанымды сорып алғанымда бірінші рет мұндай күйзеліс болды.
Dialogue: 0,0:10:43.23,0:10:44.94,Default,,0,0,0,,Бұл өте керемет болды.
Dialogue: 0,0:10:45.02,0:10:47.28,Default,,0,0,0,,Қан сорғанда ләззат неден туады?
Dialogue: 0,0:10:47.36,0:10:48.90,Default,,0,0,0,,Вампир азуларынан жіберілді⸺
Dialogue: 0,0:10:48.99,0:10:51.07,Default,,0,0,0,,Бұл сақал сияқты ингредиенттерге байланысты дейді.
Dialogue: 0,0:10:51.15,0:10:53.66,Default,,0,0,0,,Вампирдің өз күшіне және нысанаға сәйкестігіне байланысты.
Dialogue: 0,0:10:53.74,0:10:56.28,Default,,0,0,0,,Ингредиенттердің жұмыс істеу жолында да айырмашылықтар болуы мүмкін.
Dialogue: 0,0:10:56.37,0:10:57.54,Default,,0,0,0,,Бірінші кезекте, Вампир
Dialogue: 0,0:10:57.62,0:10:59.70,Default,,0,0,0,,Мұндай компоненттерді қан соратын нысанаға енгізу болып табылады
Dialogue: 0,0:10:59.79,0:11:02.12,Default,,0,0,0,,Бұл қан сорған кезде қарсыластың қозғалуына жол бермеу.
Dialogue: 0,0:11:02.21,0:11:04.67,Default,,0,0,0,,Кейбір вампирлер үшін олардың мақсатына бергені ләззат емес.
Dialogue: 0,0:11:04.75,0:11:06.54,Default,,0,0,0,,Ұйқы Паралич сияқты басқа да жағдайлар бар.
Dialogue: 0,0:11:06.63,0:11:08.34,Default,,0,0,0,,Меніңше, әлі көп жұмбақтар бар...
Dialogue: 0,0:11:08.42,0:11:09.96,Default,,0,0,0,,Барлығын түсіндірудің қажеті жоқ!
Dialogue: 0,0:11:10.05,0:11:13.80,Default,,0,0,0,,Кез келген жағдайда, біз физикалық тұрғыдан өте үйлесімдіміз.
Dialogue: 0,0:11:13.88,0:11:15.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:15.39,0:11:17.31,Default,,0,0,0,,Сіз! Біраз уақыттан бері әдейі⸺
Dialogue: 0,0:11:17.39,0:11:19.52,Default,,0,0,0,,Жаңылыстыратын сөздерді қолданбаңыз!
Dialogue: 0,0:11:20.18,0:11:21.89,Default,,0,0,0,,Хмм, хаха!
Dialogue: 0,0:11:21.98,0:11:25.52,Default,,0,0,0,,Жақсы! Сенімен жүргенде жүрегім билейді ғой
Dialogue: 0,0:11:25.61,0:11:26.94,Default,,0,0,0,,Құт
Dialogue: 0,0:11:27.02,0:11:27.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:30.36,0:11:33.57,Default,,0,0,0,,Қан келсе, маған айт.
Dialogue: 0,0:11:33.65,0:11:36.20,Default,,0,0,0,,Қалағанымша беремін
Dialogue: 0,0:11:36.82,0:11:38.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:39.16,0:11:41.54,Default,,0,0,0,,Жоқ... есімде жоқ.
Dialogue: 0,0:11:41.62,0:11:45.54,Default,,0,0,0,,Сәлем, сәлем, танысқаныма қуаныштымын
Dialogue: 0,0:11:48.59,0:11:51.80,Default,,0,0,0,,Мына кісінің тәтті қанынан дәм тат...
Dialogue: 0,0:11:51.88,0:11:54.55,Default,,0,0,0,,Сәлем, сәлем, танысқаныма қуаныштымын
Dialogue: 0,0:11:54.63,0:11:55.80,Default,,0,0,0,,Дәл қазір...
Dialogue: 0,0:11:55.89,0:11:56.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:57.80,0:12:01.77,Default,,0,0,0,,Екі шарт бар... Екіншісі ше?
Dialogue: 0,0:12:01.85,0:12:03.56,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:12:05.73,0:12:07.19,Default,,0,0,0,,Бұдан былай мен туралы.
Dialogue: 0,0:12:07.27,0:12:10.73,Default,,0,0,0,,Мені «адам» емес, менің атыммен атағаныңызды қалаймын.
Dialogue: 0,0:12:11.32,0:12:12.44,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:12:14.78,0:12:15.95,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:17.28,0:12:19.28,Default,,0,0,0,,Ванитас…
Dialogue: 0,0:12:20.24,0:12:24.00,Default,,0,0,0,,(Қан ішу дыбысы)
Dialogue: 0,0:12:25.75,0:12:29.54,Default,,0,0,0,,(шіркеу қоңырауының дыбысы)
Dialogue: 0,0:12:36.47,0:12:39.89,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,0:12:57.49,0:12:58.36,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:59.45,0:13:01.58,Default,,0,0,0,,Екеуі де қайтып келді.
Dialogue: 0,0:13:01.66,0:13:04.12,Default,,0,0,0,,Иә, мен оны көрдім.
Dialogue: 0,0:13:12.25,0:13:16.22,Default,,0,0,0,,Не болды, Мон Чери, сен жылайтын сияқтысың ба?
Dialogue: 0,0:13:17.93,0:13:20.22,Default,,0,0,0,,Доми... I
Dialogue: 0,0:13:20.30,0:13:24.47,Default,,0,0,0,,Жаннаның Ванитастың қанын сорғанын естіген соң.
Dialogue: 0,0:13:24.56,0:13:26.98,Default,,0,0,0,,Менің кеудем көптен бері ауырады.
Dialogue: 0,0:13:27.06,0:13:28.98,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:13:32.23,0:13:33.61,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:13:34.44,0:13:35.36,Default,,0,0,0,,Себебі
Dialogue: 0,0:13:37.70,0:13:39.24,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:42.37,0:13:43.62,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:13:47.12,0:13:49.87,Default,,0,0,0,,Жаннаның менен асып кеткеніне көңілім қалды.
Dialogue: 0,0:13:49.96,0:13:51.13,Default,,0,0,0,,(тыныштандыратын дыбыс)
Dialogue: 0,0:13:51.21,0:13:52.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:52.50,0:13:54.25,Default,,0,0,0,,Ванитастың қаны екені рас
Dialogue: 0,0:13:54.34,0:13:57.51,Default,,0,0,0,,Мен әрқашан оның иісі өте жақсы деп ойлайтынмын.
Dialogue: 0,0:13:57.59,0:13:58.84,Default,,0,0,0,,Егер бұл орын алса
Dialogue: 0,0:13:58.92,0:14:01.64,Default,,0,0,0,,Бір жерде дәмін татып көрсем ғой.
Dialogue: 0,0:14:01.72,0:14:05.64,Default,,0,0,0,,Қанның көптігі сонша, Жанна таңба қалдырып, оны өзіне қалдырғысы келеді.
Dialogue: 0,0:14:05.72,0:14:06.52,Default,,0,0,0,,(Жарқыраған дыбыс)
Dialogue: 0,0:14:06.60,0:14:09.27,Default,,0,0,0,,Дәмі қандай керемет деп ойлаймын.
Dialogue: 0,0:14:11.23,0:14:13.27,Default,,0,0,0,,О... мүлде
Dialogue: 0,0:14:13.36,0:14:15.23,Default,,0,0,0,,Сізге адам қоңырау шалды
Dialogue: 0,0:14:15.32,0:14:16.15,Default,,0,0,0,,Доми?
Dialogue: 0,0:14:16.23,0:14:18.03,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:18.11,0:14:19.78,Default,,0,0,0,,Ах! Эй Доми!
Dialogue: 0,0:14:19.86,0:14:20.99,Default,,0,0,0,,Мм... бұл шу!
Dialogue: 0,0:14:21.07,0:14:24.66,Default,,0,0,0,,Сендей еркекті менімен қағып алу керек.
Dialogue: 0,0:14:24.74,0:14:28.04,Default,,0,0,0,,Ей... менің құлағым қытық.
Dialogue: 0,0:14:31.62,0:14:33.67,Default,,0,0,0,,Басқа адамдардың сезіміне мән бермеу
Dialogue: 0,0:14:33.75,0:14:35.92,Default,,0,0,0,,Ах! Хахаха...
Dialogue: 0,0:14:37.25,0:14:38.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:40.42,0:14:42.68,Default,,0,0,0,,(қан соратын дыбыс)
Dialogue: 0,0:14:48.52,0:14:49.39,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:14:53.23,0:14:54.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:54.48,0:14:55.90,Default,,0,0,0,,Ах...!
Dialogue: 0,0:14:59.24,0:15:02.15,Default,,0,0,0,,(қан соратын дыбыс)
Dialogue: 0,0:15:08.79,0:15:11.41,Default,,0,0,0,,Хмм... Мен мұны білдім.
Dialogue: 0,0:15:12.41,0:15:13.92,Default,,0,0,0,,Домидің қаны дәмді
Dialogue: 0,0:15:24.93,0:15:27.30,Default,,0,0,0,,Жоқ... үлкен ақымақ
Dialogue: 0,0:15:28.31,0:15:29.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:32.77,0:15:37.69,Default,,0,0,0,,(вальс музыкасы)
Dialogue: 0,0:15:42.44,0:15:45.41,Default,,0,0,0,,Күн батқан бойда жанданды.
Dialogue: 0,0:15:56.63,0:15:58.04,Default,,0,0,0,,Я... Жанна!
Dialogue: 0,0:15:58.13,0:15:58.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:59.04,0:16:00.13,Default,,0,0,0,,Біз де билейік
Dialogue: 0,0:16:00.21,0:16:01.71,Default,,0,0,0,,Иә...!
Dialogue: 0,0:16:01.80,0:16:03.63,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:16:03.72,0:16:06.22,Default,,0,0,0,,Мен бұлай дөрекі болуға қарсы болмас едім.
Dialogue: 0,0:16:06.89,0:16:09.14,Default,,0,0,0,,Мм... Доминик-сама?
Dialogue: 0,0:16:09.22,0:16:11.85,Default,,0,0,0,,Сіз мен туралы білуіңіз керек.
Dialogue: 0,0:16:11.93,0:16:15.39,Default,,0,0,0,,Буромен билеп жатқаныңды біреу көрсе ше?
Dialogue: 0,0:16:16.06,0:16:18.90,Default,,0,0,0,,Доминиктің атына кір келтіреді.
Dialogue: 0,0:16:18.98,0:16:20.19,Default,,0,0,0,,Иә
Dialogue: 0,0:16:20.27,0:16:22.19,Default,,0,0,0,,Мен қиындыққа тап болдым. Ол жақсы бала.
Dialogue: 0,0:16:22.28,0:16:23.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:24.74,0:16:26.74,Default,,0,0,0,,Ләззат алу әрекеті дегеніміз не?
Dialogue: 0,0:16:26.82,0:16:31.16,Default,,0,0,0,,Барлық басқа құмарлықтарды бағындыратын құмарлық.
Dialogue: 0,0:16:31.24,0:16:32.66,Default,,0,0,0,,Әке сөзі
Dialogue: 0,0:16:35.71,0:16:38.58,Default,,0,0,0,,Алдыңызда жайнаған әдемі гүлдерге таңданудың орнына.
Dialogue: 0,0:16:39.25,0:16:41.09,Default,,0,0,0,,Бірінші орынға қойылуы тиіс құмарлық және т.б
Dialogue: 0,0:16:42.00,0:16:44.72,Default,,0,0,0,,Ол менде жоқ
Dialogue: 0,0:16:44.80,0:16:48.43,Default,,0,0,0,,(вальс музыкасы)
Dialogue: 0,0:16:59.98,0:17:03.40,Default,,0,0,0,,Жаннамен билеу керек пе?
Dialogue: 0,0:17:03.48,0:17:05.61,Default,,0,0,0,,Мен билеуге онша жақсы емеспін.
Dialogue: 0,0:17:06.32,0:17:09.82,Default,,0,0,0,,Жаннаның аяғын абайсызда басып кеткенім үшін өзімді жаман сезінемін.
Dialogue: 0,0:17:12.79,0:17:15.83,Default,,0,0,0,,Олай болса, айтайын.
Dialogue: 0,0:17:15.91,0:17:16.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:20.38,0:17:21.54,Default,,0,0,0,,Иә
Dialogue: 0,0:17:22.21,0:17:24.21,Default,,0,0,0,,Сізге бір жақсылық сұрауға рұқсат етіңіз.
Dialogue: 0,0:17:27.72,0:17:29.18,Default,,0,0,0,,Лорд Лұқа
Dialogue: 0,0:17:29.76,0:17:30.93,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:17:33.18,0:17:34.18,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:17:36.64,0:17:38.69,Default,,0,0,0,,Мен мүмкіндігінше тезірек ересек болғым келеді
Dialogue: 0,0:17:42.27,0:17:45.48,Default,,0,0,0,,Не, сен қалыпты билей аласың ба?
Dialogue: 0,0:17:45.57,0:17:47.19,Default,,0,0,0,,Мен билей алмайсың деп айтпаймын.
Dialogue: 0,0:17:51.95,0:17:55.95,Default,,0,0,0,,Ванитас, менің бір сұрағым бар.
Dialogue: 0,0:17:57.54,0:17:59.96,Default,,0,0,0,,Бұл не? Айтыңызшы.
Dialogue: 0,0:18:00.04,0:18:02.38,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:18:02.46,0:18:04.59,Default,,0,0,0,,Махаббат деген не...?
Dialogue: 0,0:18:04.67,0:18:07.34,Default,,0,0,0,,Уф... Гяхахаха!
Dialogue: 0,0:18:07.92,0:18:10.59,Default,,0,0,0,,Сіз тіпті әдейі билеуімді өтіндіңіз.
Dialogue: 0,0:18:10.68,0:18:14.60,Default,,0,0,0,,Мен шынымен естуге қиын нәрселер бар ма деп ойладым.
Dialogue: 0,0:18:14.68,0:18:16.35,Default,,0,0,0,,Немесе...
Dialogue: 0,0:18:18.68,0:18:20.60,Default,,0,0,0,,(сырғаның шырылдаған дыбысы)
Dialogue: 0,0:18:21.85,0:18:22.98,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,0:18:23.06,0:18:24.11,Default,,0,0,0,,А...?
Dialogue: 0,0:18:25.07,0:18:26.90,Default,,0,0,0,,Бірақ Жаннаға қарап
Dialogue: 0,0:18:26.98,0:18:30.11,Default,,0,0,0,,Жүрегім дүрсілдеп, дірілдеп тұра алмаймын.
Dialogue: 0,0:18:30.20,0:18:33.87,Default,,0,0,0,,(вальс музыкасы)
Dialogue: 0,0:18:36.45,0:18:37.79,Default,,0,0,0,,Бұл импульс
Dialogue: 0,0:18:37.87,0:18:41.50,Default,,0,0,0,,Мен оны өзіме деген махаббат деп анықтадым.
Dialogue: 0,0:18:41.58,0:18:43.42,Default,,0,0,0,,Бұл қызықтырақ.
Dialogue: 0,0:18:44.08,0:18:47.42,Default,,0,0,0,,Жүрегім дүрсілдеп, дірілдеп барады...
Dialogue: 0,0:18:48.34,0:18:51.05,Default,,0,0,0,,Суық тигендей болады.
Dialogue: 0,0:18:51.13,0:18:54.39,Default,,0,0,0,,Иә, суық тигендей болады.
Dialogue: 0,0:19:11.78,0:19:15.07,Default,,0,0,0,,Ванитас Жаннаға не ұнайды?
Dialogue: 0,0:19:15.16,0:19:16.58,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:17.41,0:19:20.08,Default,,0,0,0,,Күшті нүктелер Әдемі нүктелер
Dialogue: 0,0:19:20.16,0:19:23.21,Default,,0,0,0,,Шіркін жер, нәзік жер
Dialogue: 0,0:19:23.29,0:19:25.04,Default,,0,0,0,,Үлкен кеуде
Dialogue: 0,0:19:25.13,0:19:26.84,Default,,0,0,0,,Мазақтауға тұрарлық жерде
Dialogue: 0,0:19:27.59,0:19:30.09,Default,,0,0,0,,Қалғаны... жақсы.
Dialogue: 0,0:19:31.30,0:19:35.34,Default,,0,0,0,,Сен маған ешқашан ғашық болмайтын сияқтысың...
Dialogue: 0,0:19:35.43,0:19:36.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:36.68,0:19:39.01,Default,,0,0,0,,Бұл шынымен де жай кездейсоқтық па деп ойлайсың ба?
Dialogue: 0,0:19:39.10,0:19:40.18,Default,,0,0,0,,Сізге ұнайтын адамға
Dialogue: 0,0:19:40.27,0:19:43.60,Default,,0,0,0,,Адамдар сізді де солай ұнатқанын қаламайсыз ба?
Dialogue: 0,0:19:43.69,0:19:44.94,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:19:45.02,0:19:47.11,Default,,0,0,0,,Мен мұны сұрамаймын.
Dialogue: 0,0:19:48.44,0:19:50.86,Default,,0,0,0,,Мен Жаннаны ұнатсам да
Dialogue: 0,0:19:50.94,0:19:53.61,Default,,0,0,0,,Жанна мені ұнатпауы керек.
Dialogue: 0,0:19:57.28,0:20:01.16,Default,,0,0,0,,Мен ешкімге ұнағанын қаламаймын
Dialogue: 0,0:20:01.25,0:20:02.87,Default,,0,0,0,,Мүлде қызықпайды
Dialogue: 0,0:20:06.08,0:20:09.13,Default,,0,0,0,,Мен білмейтін нәрселер әлі де көп.
Dialogue: 0,0:20:15.84,0:20:18.89,Default,,0,0,0,,Неге... бұл кеуде неге сыбырлайды?
Dialogue: 0,0:20:21.89,0:20:24.14,Default,,0,0,0,,Мен түсінбейтін нәрселер өте көп
Dialogue: 0,0:20:25.39,0:20:26.31,Default,,0,0,0,,Даа!
Dialogue: 0,0:20:26.40,0:20:27.77,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:20:27.86,0:20:28.36,Default,,0,0,0,,Даа!
Dialogue: 0,0:20:28.44,0:20:30.36,Default,,0,0,0,,Сіз кешірім айтудан құтыла аласыз деп ойлайсыз ба?
Dialogue: 0,0:20:30.44,0:20:32.19,Default,,0,0,0,,Бұл әдейі емес...
Dialogue: 0,0:20:33.61,0:20:34.82,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:20:34.90,0:20:38.16,Default,,0,0,0,,Лорд Рутвен туралы білмей, оған қалай баруға батылыңыз бар?
Dialogue: 0,0:20:38.24,0:20:39.95,Default,,0,0,0,,Сіз шынымен...
Dialogue: 0,0:20:40.03,0:20:43.00,Default,,0,0,0,,Мен сенат мүшелерінің бірі екеніңді білемін.
Dialogue: 0,0:20:43.08,0:20:44.29,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:20:44.37,0:20:45.25,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:20:45.33,0:20:47.50,Default,,0,0,0,,Лорд Рутвен қалыпты адам ретінде
Dialogue: 0,0:20:47.58,0:20:50.67,Default,,0,0,0,,Вампирлер мен адамдар арасындағы соғыстың аяқталуына әкелді⸺
Dialogue: 0,0:20:50.75,0:20:52.80,Default,,0,0,0,,Ол бейбітшіліктің қозғаушы күші.
Dialogue: 0,0:20:52.88,0:20:56.30,Default,,0,0,0,,Оны батыр деп мақтайтындар әлі де көп.
Dialogue: 0,0:20:56.38,0:20:57.93,Default,,0,0,0,,оның қазір қайда екенін немесе не істеп жатқанын білуге рұқсат жоқ па? Тіпті соны да білмейміз бе?
Dialogue: 0,0:20:58.01,0:21:02.43,Default,,0,0,0,,Сонда, әрине, сіз Люциус туралы ештеңе білмеуіңіз мүмкін.
Dialogue: 0,0:21:02.51,0:21:04.39,Default,,0,0,0,,Не? Жоқ, жақсы
Dialogue: 0,0:21:04.47,0:21:07.10,Default,,0,0,0,,Бұл адамның өзі жеткізгісі келетін нәрсе.
Dialogue: 0,0:21:07.19,0:21:08.06,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:09.31,0:21:11.44,Default,,0,0,0,,Мүмкін мен сенімен бірге баруым керек шығар.
Dialogue: 0,0:21:11.52,0:21:12.86,Default,,0,0,0,,Доми жоқ
Dialogue: 0,0:21:12.94,0:21:15.32,Default,,0,0,0,,Бұл Сад отбасының күтпеген қоңырауы, солай емес пе?
Dialogue: 0,0:21:16.90,0:21:18.74,Default,,0,0,0,,Кешіріңіз Жоқ
Dialogue: 0,0:21:18.82,0:21:21.83,Default,,0,0,0,,Жақсы болар деп сені Altusқа алып келдім.
Dialogue: 0,0:21:22.49,0:21:25.45,Default,,0,0,0,,Соңында мен керемет әбігерге түстім.
Dialogue: 0,0:21:25.54,0:21:27.21,Default,,0,0,0,,Неліктен кешірім сұрайсыз?
Dialogue: 0,0:21:30.71,0:21:33.71,Default,,0,0,0,,Доми мен үшін үнемі алаңдайды.
Dialogue: 0,0:21:34.46,0:21:38.30,Default,,0,0,0,,Бұл мен үшін керемет нәрсе.
Dialogue: 0,0:21:40.22,0:21:41.47,Default,,0,0,0,,Иә
Dialogue: 0,0:21:42.14,0:21:44.85,Default,,0,0,0,,Қайта кездескенше Мон Чери
Dialogue: 0,0:21:44.93,0:21:48.89,Default,,0,0,0,,(ауыр музыка)
Dialogue: 0,0:21:56.78,0:22:00.91,Default,,0,0,0,,(қорқынышты дыбыс)
Dialogue: 0,0:22:05.99,0:22:07.25,Default,,0,0,0,,(♪~соңғы ән)
Dialogue: 0,0:22:07.33,0:22:12.71,Default,,0,0,0,,♪ Ол бастала салысымен ♪ соңын көруге болады
Dialogue: 0,0:22:12.79,0:22:17.55,Default,,0,0,0,,♪ Балмұздақ ыдырап, еріген сияқты ♪
Dialogue: 0,0:22:17.63,0:22:22.34,Default,,0,0,0,,♪ Ең алыс қашықтықта ақырын естіледі ♪
Dialogue: 0,0:22:22.43,0:22:26.97,Default,,0,0,0,,♪ Бір күрсіну толқындай көтеріледі ♪
Dialogue: 0,0:22:27.06,0:22:30.56,Default,,0,0,0,,♪ 〈Өзімді жоғалтқанда〉 ♪
Dialogue: 0,0:22:30.64,0:22:33.52,Default,,0,0,0,,♪ 〈Мен саған айналамын〉 ♪
Dialogue: 0,0:22:33.61,0:22:40.32,Default,,0,0,0,,♪ Бірден онға дейін толтырыңыз, ♪ ұстаңыз
Dialogue: 0,0:22:40.40,0:22:43.28,Default,,0,0,0,,♪ Пердені шешіңіз ♪
Dialogue: 0,0:22:43.37,0:22:48.16,Default,,0,0,0,,♪ Сіздің ат тегіңіз де ертең жойылады ♪
Dialogue: 0,0:22:48.25,0:22:50.71,Default,,0,0,0,,♪ 〈Мен іздеген сен бе едің〉 ♪
Dialogue: 0,0:22:50.79,0:22:53.21,Default,,0,0,0,,♪ 〈Өмірімді жалғыз өткізіп, күттім бе?〉 ♪
Dialogue: 0,0:22:53.29,0:22:55.59,Default,,0,0,0,,♪ 〈Сондай нәзік және шексіз〉 ♪
Dialogue: 0,0:22:55.67,0:22:57.55,Default,,0,0,0,,♪ 〈Сен мені бүтін қылдың Сен мені түзеттің〉 ♪
Dialogue: 0,0:22:57.63,0:23:00.30,Default,,0,0,0,,♪ Көз жасына батып ♪
Dialogue: 0,0:23:00.38,0:23:02.72,Default,,0,0,0,,♪ Қоштасудан ары ♪
Dialogue: 0,0:23:02.80,0:23:05.14,Default,,0,0,0,,♪ Айналу уақытының ішінде ♪
Dialogue: 0,0:23:05.22,0:23:07.76,Default,,0,0,0,,♪ 〈Сен мені бүтін қылдың〉 ♪
Dialogue: 0,0:23:07.85,0:23:09.98,Default,,0,0,0,,♪ 〈Есіктен естіген сен бе едің〉 ♪
Dialogue: 0,0:23:10.06,0:23:12.39,Default,,0,0,0,,♪ 〈Мен жылап, барар жерім болмаған кезде?〉 ♪
Dialogue: 0,0:23:12.48,0:23:14.52,Default,,0,0,0,,♪ Айналу уақытының ішінде ♪
Dialogue: 0,0:23:14.60,0:23:17.19,Default,,0,0,0,,♪ Мен енді жалғыз емеспін ♪
Dialogue: 0,0:23:17.27,0:23:19.53,Default,,0,0,0,,♪ Құшақта ♪ кездестік
Dialogue: 0,0:23:19.61,0:23:22.03,Default,,0,0,0,,♪ 〈Сен мені түзеттің Сен мені түзеттің〉 ♪
Dialogue: 0,0:23:23.32,0:23:27.62,Default,,0,0,0,,♪ 〈Мен өзімді жоғалтамын, өзімді жоғалтамын〉 ♪
Dialogue: 0,0:23:27.70,0:23:31.62,Default,,0,0,0,,♪ Мен енді жалғыз емеспін ♪
Dialogue: 0,0:23:31.71,0:23:33.29,Default,,0,0,0,,(Соңғы ән~♪)
Dialogue: 0,0:23:35.50,0:23:37.50,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:23:37.59,0:23:39.92,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,0:23:41.42,0:23:46.42,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
