Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.39,0:00:28.40,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:00:53.34,0:00:54.92,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:00:55.47,0:00:56.93,Default,,0,0,0,,(айқай)
Dialogue: 0,0:00:57.30,0:00:59.80,Default,,0,0,0,,(шу)
Dialogue: 0,0:01:05.31,0:01:08.48,Default,,0,0,0,,(иттің үруі)
Dialogue: 0,0:01:09.06,0:01:12.65,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:01:15.15,0:01:17.49,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:01:19.78,0:01:20.91,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:01:21.03,0:01:24.12,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:01:27.50,0:01:30.38,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:01:37.18,0:01:38.18,Default,,0,0,0,,Батырдың аты: Ол Майт
Dialogue: 0,0:01:40.22,0:01:41.97,Default,,0,0,0,,(айқай)
Dialogue: 0,0:01:53.86,0:01:59.86,Default,,0,0,0,,♪～
Dialogue: 0,0:02:15.30,0:02:17.01,Default,,0,0,0,,Баспропеллер
Dialogue: 0,0:02:30.85,0:02:32.69,Default,,0,0,0,,Кез келген жердегі есік
Dialogue: 0,0:03:16.65,0:03:22.66,Default,,0,0,0,,～♪
Dialogue: 0,0:03:25.91,0:03:30.62,Default,,0,0,0,,Ертеде жер сыры мен сырына толы болған.
Dialogue: 0,0:03:33.79,0:03:36.84,Default,,0,0,0,,Шексіз джунгли
Dialogue: 0,0:03:38.25,0:03:42.47,Default,,0,0,0,,Бұлттардың үстінде мұнартқан алып ақ шың
Dialogue: 0,0:03:43.59,0:03:47.26,Default,,0,0,0,,Мұзда қатқан өлім әлемі
Dialogue: 0,0:03:48.68,0:03:50.52,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:03:51.27,0:03:54.44,Default,,0,0,0,,Джунглилер мен шөлдер, полярлық аймақтар мен биік таулар...
Dialogue: 0,0:03:54.56,0:03:56.48,Default,,0,0,0,,Немесе тіпті терең теңіз түбі...
Dialogue: 0,0:03:56.98,0:03:59.98,Default,,0,0,0,,Жердің әрбір бұрышы зерттелді.
Dialogue: 0,0:04:00.11,0:04:04.61,Default,,0,0,0,,Енді адам бара алмайтын жер жоқ!
Dialogue: 0,0:04:07.58,0:04:09.87,Default,,0,0,0,,Бұл өте ұят!
Dialogue: 0,0:04:09.99,0:04:14.25,Default,,0,0,0,,Бізге жұмбақ пен жұмбақ та қалмаған.
Dialogue: 0,0:04:14.37,0:04:16.88,Default,,0,0,0,,Мен... Маған ашулансаң, қиналып қаласың.
Dialogue: 0,0:04:17.34,0:04:20.84,Default,,0,0,0,,Жарайды, мен осыны талқылауым керек.
Dialogue: 0,0:04:20.96,0:04:22.76,Default,,0,0,0,,Осы кең жер бетінде...
Dialogue: 0,0:04:22.88,0:04:26.34,Default,,0,0,0,,Бір жерде әлі де сиқырлы аймақтар мен зерттелмеген аймақтар қалды деп ойлаймын.
Dialogue: 0,0:04:26.72,0:04:28.10,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:04:28.22,0:04:31.06,Default,,0,0,0,,Егер сіз Дораемонның орнында болсаңыз, мұндай құпия орынды таба алар едіңіз, солай ма?
Dialogue: 0,0:04:31.72,0:04:32.64,Default,,0,0,0,,Дораемон! ?
Dialogue: 0,0:04:33.14,0:04:37.44,Default,,0,0,0,,Осы жазғы демалыста бәріміз үлкен барлау саяхатына шығамыз.
Dialogue: 0,0:04:37.56,0:04:40.28,Default,,0,0,0,,Мен осылай шештім
Dialogue: 0,0:04:40.40,0:04:41.36,Default,,0,0,0,,Сәлем (Сунео) Сәлем
Dialogue: 0,0:04:41.94,0:04:44.24,Default,,0,0,0,,Түсіндің бе, Нобита? (Нобита) Иә...
Dialogue: 0,0:04:44.36,0:04:45.32,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:46.11,0:04:47.24,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:04:47.66,0:04:50.49,Default,,0,0,0,,Егер мұндай нәрсе ерікті түрде шешілсе, бұл проблема болар еді.
Dialogue: 0,0:04:51.04,0:04:54.33,Default,,0,0,0,,Өтінемін, Дораемон, жындар патшалығын табыңыз.
Dialogue: 0,0:04:54.46,0:04:56.12,Default,,0,0,0,,Әйтпесе ұрып-соғасың.
Dialogue: 0,0:04:56.25,0:04:58.79,Default,,0,0,0,,Біз болашақтанбыз. Мен қайталаңыз...
Dialogue: 0,0:04:58.92,0:05:00.34,Default,,0,0,0,,(қосқышты басқан дыбыс)
Dialogue: 0,0:05:00.46,0:05:02.46,Default,,0,0,0,,Көріп тұрғаныңыздай Дора Даймёжин
Dialogue: 0,0:05:02.88,0:05:04.55,Default,,0,0,0,,Мудаттеба!
Dialogue: 0,0:05:04.67,0:05:08.22,Default,,0,0,0,,Жердің әрбір дюймі зерттелді!
Dialogue: 0,0:05:08.64,0:05:10.01,Default,,0,0,0,,Бірақ-
Dialogue: 0,0:05:10.47,0:05:11.93,Default,,0,0,0,,Мүмкін-
Dialogue: 0,0:05:13.22,0:05:14.52,Default,,0,0,0,,Мен жаңа ғана іздедім, іздедім.
Dialogue: 0,0:05:14.64,0:05:16.44,Default,,0,0,0,,Дааататата
Dialogue: 0,0:05:16.56,0:05:18.90,Default,,0,0,0,,Жасырудың қажеті жоқ!
Dialogue: 0,0:05:20.73,0:05:22.90,Default,,0,0,0,,Өте табанды! корморант?
Dialogue: 0,0:05:23.32,0:05:24.61,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:05:24.86,0:05:28.24,Default,,0,0,0,,Шық, Та...Тамма!
Dialogue: 0,0:05:28.45,0:05:32.49,Default,,0,0,0,,Қараңызшы, бұл өткен жылы Дораяки сатып алмақ болғанымда жоғалтқан 100 иен.
Dialogue: 0,0:05:32.62,0:05:35.62,Default,,0,0,0,,Мен баяғыда берілдім, бірақ қазір біттім~ хаха~
Dialogue: 0,0:05:35.75,0:05:38.50,Default,,0,0,0,,Дереу Дораяки сатып алайық.
Dialogue: 0,0:05:38.92,0:05:43.38,Default,,0,0,0,,Мына жаққа қара! Тіпті жын-шайтан әлемінде де, берілмей, жан-жақты ізденсең...
Dialogue: 0,0:05:43.50,0:05:46.13,Default,,0,0,0,,Мүмкін ол бір жерде әлі де бар шығар.
Dialogue: 0,0:05:46.47,0:05:49.14,Default,,0,0,0,,(Нобитаның күлкісі)
Dialogue: 0,0:05:49.51,0:05:51.89,Default,,0,0,0,,Мұқият...
Dialogue: 0,0:05:52.51,0:05:55.89,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:56.31,0:05:57.85,Default,,0,0,0,,Жеке жерсерікті ұшыру
Dialogue: 0,0:06:00.06,0:06:01.06,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:06:07.15,0:06:11.12,Default,,0,0,0,,Сол спутник бізге Жердің суреттерін жібереді.
Dialogue: 0,0:06:11.24,0:06:12.95,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:06:13.53,0:06:16.04,Default,,0,0,0,,Уау, ол әлдеқашан жіберілді.
Dialogue: 0,0:06:17.79,0:06:20.46,Default,,0,0,0,,Ол анық көрінеді.
Dialogue: 0,0:06:20.58,0:06:23.17,Default,,0,0,0,,Егер сіз мұны жасасаңыз, сіз міндетті түрде сиқырлы орынды табасыз.
Dialogue: 0,0:06:23.29,0:06:24.38,Default,,0,0,0,,Бұл тәтті.
Dialogue: 0,0:06:24.88,0:06:29.38,Default,,0,0,0,,Жердің әр бұрышын суретке түсірсек, онда он мыңдаған фотосуреттер болар еді... Жоқ.
Dialogue: 0,0:06:29.51,0:06:31.72,Default,,0,0,0,,Миллиондаған бөліктер болуы мүмкін
Dialogue: 0,0:06:31.84,0:06:32.85,Default,,0,0,0,,Жүздеген! ?
Dialogue: 0,0:06:33.10,0:06:37.81,Default,,0,0,0,,Оны білу үшін неше күн, апта, ай қажет?
Dialogue: 0,0:06:38.06,0:06:41.44,Default,,0,0,0,,Сіз ештеңе таба алмауыңыз мүмкін.
Dialogue: 0,0:06:42.36,0:06:44.77,Default,,0,0,0,,Тіпті тырыспастан ыңылдамаңыз!
Dialogue: 0,0:06:42.36,0:06:44.77,Default,,0,0,0,,Уау
Dialogue: 0,0:06:45.86,0:06:48.15,Default,,0,0,0,,Жалғыз болсам да істеймін.
Dialogue: 0,0:06:48.78,0:06:52.32,Default,,0,0,0,,Сіз байсалдысыз ба? Сен Джианнан қорқасың ба?
Dialogue: 0,0:06:52.45,0:06:53.74,Default,,0,0,0,,Бұл да дұрыс...
Dialogue: 0,0:06:54.53,0:06:55.99,Default,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:06:56.12,0:07:00.21,Default,,0,0,0,,Мен ешкім білмейтін ұлы жын әлемін тауып, зерттейтінімізге сене алмаймын.
Dialogue: 0,0:07:01.08,0:07:04.25,Default,,0,0,0,,Менің ойымша, бұл сіздің жазғы демалысыңызды өлтіретін болса да, оны байқап көруге тұрарлық.
Dialogue: 0,0:07:04.38,0:07:06.96,Default,,0,0,0,,Додо додо... Жарайды!
Dialogue: 0,0:07:07.09,0:07:10.38,Default,,0,0,0,,Егер сен соншалықты жігерлі болсаң, ынтымақтасайық.
Dialogue: 0,0:07:10.72,0:07:14.47,Default,,0,0,0,,Дораемон! Мен оған сене аламын.
Dialogue: 0,0:07:15.18,0:07:17.93,Default,,0,0,0,,Алдымен спутниктің орбитасын түзетіңіз
Dialogue: 0,0:07:18.31,0:07:20.06,Default,,0,0,0,,Теңізді және қаланы кесіп тастаңыз -
Dialogue: 0,0:07:20.18,0:07:23.90,Default,,0,0,0,,Өркениетті қоғамнан мүмкіндігінше алыс жер іздеңіз
Dialogue: 0,0:07:24.27,0:07:28.03,Default,,0,0,0,,Джунглилер, альпі аймақтары және шөлдер жасырын асыл тастар болуы мүмкін.
Dialogue: 0,0:07:28.15,0:07:30.11,Default,,0,0,0,,Мм... сосын (саусақтарды сермеу)
Dialogue: 0,0:07:30.24,0:07:31.70,Default,,0,0,0,,Африкаға назар аударыңыз
Dialogue: 0,0:07:31.82,0:07:33.87,Default,,0,0,0,,Жақсы идея! Хахан
Dialogue: 0,0:07:35.24,0:07:39.08,Default,,0,0,0,,Біз Үнді мұхитынан Африка аспанына енді ғана кірдік.
Dialogue: 0,0:07:39.20,0:07:44.54,Default,,0,0,0,,Атлант мұхитына жеткен соң, ендік өзгерте отырып, материкті көп рет кесіп өтейік.
Dialogue: 0,0:07:44.75,0:07:47.00,Default,,0,0,0,,Түсірілім басталады!
Dialogue: 0,0:07:48.21,0:07:50.30,Default,,0,0,0,,Уау! Хахаха
Dialogue: 0,0:07:51.92,0:07:53.59,Default,,0,0,0,,Джунгли!
Dialogue: 0,0:07:54.05,0:07:57.31,Default,,0,0,0,,Джунглиде серуендеу қызықсыз.
Dialogue: 0,0:07:57.43,0:07:58.89,Default,,0,0,0,,Мен мақсат алғым келеді.
Dialogue: 0,0:07:59.14,0:08:02.52,Default,,0,0,0,,Ашылмаған көлдер, көне қирандылар, т.б.
Dialogue: 0,0:08:02.64,0:08:04.94,Default,,0,0,0,,Жарайды, мен оны міндетті түрде табамын.
Dialogue: 0,0:08:05.06,0:08:06.31,Default,,0,0,0,,Ноби-чан
Dialogue: 0,0:08:07.48,0:08:08.52,Default,,0,0,0,,Маған келесі сұраққа жауап бер.
Dialogue: 0,0:08:08.65,0:08:10.57,Default,,0,0,0,,Маған тапсырма беріңізші.
Dialogue: 0,0:08:10.69,0:08:11.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:12.65,0:08:15.49,Default,,0,0,0,,Мен бірдеңе істеуге тырысқан сайын, осылай болады.
Dialogue: 0,0:08:19.91,0:08:20.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:24.75,0:08:28.25,Default,,0,0,0,,Не болды? Ол әбден лас
Dialogue: 0,0:08:29.63,0:08:32.97,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:08:34.38,0:08:36.18,Default,,0,0,0,,Мотоциклді қолданғандағыдай, ол—
Dialogue: 0,0:08:36.72,0:08:38.30,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ
Dialogue: 0,0:08:38.43,0:08:40.14,Default,,0,0,0,,Біз ит ұстай алмаймыз.
Dialogue: 0,0:08:40.72,0:08:42.10,Default,,0,0,0,,(айқай)
Dialogue: 0,0:08:42.35,0:08:46.06,Default,,0,0,0,,Әй, өтірік... Қарның аштың ба, тұра алмайсың ба?
Dialogue: 0,0:08:46.19,0:08:47.06,Default,,0,0,0,,Ах
Dialogue: 0,0:08:51.15,0:08:55.49,Default,,0,0,0,,Мен сені аяймын, бірақ саған көмектесу үшін қолымнан ештеңе келмейді.
Dialogue: 0,0:09:01.16,0:09:03.87,Default,,0,0,0,,үшін үшін рахмет (Нобита)
Dialogue: 0,0:09:05.83,0:09:06.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:07.92,0:09:10.29,Default,,0,0,0,,Шұжық беріңізші.
Dialogue: 0,0:09:10.42,0:09:13.34,Default,,0,0,0,,А, ең арзаны.
Dialogue: 0,0:09:19.18,0:09:20.76,Default,,0,0,0,,Эй
Dialogue: 0,0:09:25.94,0:09:28.77,Default,,0,0,0,,Тамақ іш, қарның ашты, солай ма?
Dialogue: 0,0:09:29.31,0:09:33.73,Default,,0,0,0,,Мен саған шұжықты беремін, бірақ менің артымнан ергеннен пайда жоқ.
Dialogue: 0,0:09:33.86,0:09:34.74,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:09:34.90,0:09:36.86,Default,,0,0,0,,Жарайды, бұл уәде.
Dialogue: 0,0:09:36.99,0:09:38.07,Default,,0,0,0,,Батырдың аты: Ол Майт
Dialogue: 0,0:09:40.91,0:09:44.37,Default,,0,0,0,,А... А, кешіріңіз, сәл күте тұрыңыз.
Dialogue: 0,0:09:51.79,0:09:53.96,Default,,0,0,0,,Иә (иіскеу дыбысы)
Dialogue: 0,0:10:01.68,0:10:07.02,Default,,0,0,0,,Бұл лас, бірақ мұқият қарасаңыз, оның біршама талғампаз ит екенін көресіз.
Dialogue: 0,0:10:07.14,0:10:10.69,Default,,0,0,0,,Ах! Мичисо: Бұл тамақ ішетін уақыт емес!
Dialogue: 0,0:10:11.40,0:10:13.02,Default,,0,0,0,,Маған тезірек Африканы қарау керек.
Dialogue: 0,0:10:13.15,0:10:14.15,Default,,0,0,0,,(айқай)
Dialogue: 0,0:10:14.44,0:10:17.95,Default,,0,0,0,,Олай болса, мен мейірімді адамнан мені алып кетуін сұраймын.
Dialogue: 0,0:10:20.28,0:10:21.37,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:10:22.78,0:10:25.08,Default,,0,0,0,,Уау, бұл өте көп.
Dialogue: 0,0:10:25.20,0:10:26.75,Default,,0,0,0,,Себебі мен қарауға үлгере алмаймын...
Dialogue: 0,0:10:27.04,0:10:29.58,Default,,0,0,0,,Біз сымды жіберуді біраз уақытқа тоқтатамыз.
Dialogue: 0,0:10:29.92,0:10:33.29,Default,,0,0,0,,Жарайды, барлығын тексеріп көрейік!
Dialogue: 0,0:10:33.42,0:10:34.55,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,0:10:34.67,0:10:35.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:36.01,0:10:37.84,Default,,0,0,0,,Бұл мен емес
Dialogue: 0,0:10:37.97,0:10:40.72,Default,,0,0,0,,Әй, жоқ... (Нобита) Болмайды!
Dialogue: 0,0:10:41.05,0:10:42.26,Default,,0,0,0,,(айқай)
Dialogue: 0,0:10:43.30,0:10:46.60,Default,,0,0,0,,Көп айтсаң да, уәдең басқа.
Dialogue: 0,0:10:46.72,0:10:49.06,Default,,0,0,0,,Нобита-кун, сен ит алдың ба?
Dialogue: 0,0:10:49.19,0:10:51.60,Default,,0,0,0,,Мен оны көтермедім, соңынан ердім.
Dialogue: 0,0:10:51.94,0:10:54.57,Default,,0,0,0,,Анам білсе не істеуім керек?
Dialogue: 0,0:10:54.69,0:10:56.57,Default,,0,0,0,,Ноби-чан (2 адам) О!
Dialogue: 0,0:10:56.65,0:10:58.32,Default,,0,0,0,,Ана... Бұл мама. Оны жасыр. Оны жасыр.
Dialogue: 0,0:10:58.44,0:10:59.57,Default,,0,0,0,,Дауысыңызды көтермеңіз
Dialogue: 0,0:10:59.70,0:11:00.91,Default,,0,0,0,,Жоқ... Не!
Dialogue: 0,0:11:01.03,0:11:03.49,Default,,0,0,0,,Мен сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:11:03.57,0:11:05.66,Default,,0,0,0,,Күте тұрыңыз... уау (Нобита)!
Dialogue: 0,0:11:05.79,0:11:08.37,Default,,0,0,0,,Өтінемін... Кешіріңіз, мен сізге рұқсатсыз ердім.
Dialogue: 0,0:11:08.50,0:11:10.21,Default,,0,0,0,,Мен сені бірден кері қайтарамын.
Dialogue: 0,0:11:10.33,0:11:12.63,Default,,0,0,0,,Түсінбейтін нәрселерді айтпа
Dialogue: 0,0:11:12.75,0:11:15.46,Default,,0,0,0,,Оның үстіне ананың сөмкесі мұндайды білмейсің бе?
Dialogue: 0,0:11:15.75,0:11:17.17,Default,,0,0,0,,Сөмке?
Dialogue: 0,0:11:17.30,0:11:21.38,Default,,0,0,0,,Күрсін... Мен таң қалдым. Менің білуге ​​ешқандай мүмкіндік жоқ.
Dialogue: 0,0:11:21.47,0:11:24.64,Default,,0,0,0,,Мен оны банктен үйге қайтып бара жатқанда тастаған болуым керек.
Dialogue: 0,0:11:24.76,0:11:27.39,Default,,0,0,0,,Менің барлық активтерім сонда...
Dialogue: 0,0:11:27.68,0:11:28.56,Default,,0,0,0,,Анашым!
Dialogue: 0,0:11:28.68,0:11:29.68,Default,,0,0,0,,Өз ойларыңызға сенімді болыңыз
Dialogue: 0,0:11:29.81,0:11:31.85,Default,,0,0,0,,Оны бірден іздеп көрейік.
Dialogue: 0,0:11:37.78,0:11:39.07,Default,,0,0,0,,Банктен кету -
Dialogue: 0,0:11:39.19,0:11:40.78,Default,,0,0,0,,Сіз тікелей үйге бардыңыз ба?
Dialogue: 0,0:11:40.90,0:11:42.78,Default,,0,0,0,,Иә... Қалай өтті деп ойлаймын.
Dialogue: 0,0:11:43.32,0:11:46.53,Default,,0,0,0,,Ыстықтан аңырап қалғаным сонша, есімде ештеңе қалмады.
Dialogue: 0,0:11:46.91,0:11:48.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:48.83,0:11:50.41,Default,,0,0,0,,Сіз менің артымнан келе жатырсыз ба?
Dialogue: 0,0:11:50.54,0:11:52.75,Default,,0,0,0,,Мен бірдеңенің иісін сездім деп ойлаймын.
Dialogue: 0,0:11:52.87,0:11:54.79,Default,,0,0,0,,Менің үйім мен Әбекөбе жаққа қарай.
Dialogue: 0,0:11:54.92,0:11:56.79,Default,,0,0,0,,Аа, бәрібір ілесейік.
Dialogue: 0,0:11:56.92,0:11:58.21,Default,,0,0,0,,Бұл не? сол ит
Dialogue: 0,0:11:59.38,0:12:00.17,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,0:12:01.17,0:12:02.30,Default,,0,0,0,,Не? мұнда
Dialogue: 0,0:12:02.43,0:12:04.64,Default,,0,0,0,,Иә, есіме түсті!
Dialogue: 0,0:12:04.76,0:12:07.81,Default,,0,0,0,,Ыстық болғаны сонша, ширатама кремі анмицу жедім.
Dialogue: 0,0:12:07.89,0:12:10.06,Default,,0,0,0,,Енді (Нобита) бәрі мен туралы
Dialogue: 0,0:12:10.18,0:12:11.43,Default,,0,0,0,,Кездейсоқ Кездейсоқ
Dialogue: 0,0:12:11.56,0:12:13.35,Default,,0,0,0,,Ойоё
Dialogue: 0,0:12:13.48,0:12:15.48,Default,,0,0,0,,Сіз кенеттен адасып қалдыңыз ба?
Dialogue: 0,0:12:15.60,0:12:16.86,Default,,0,0,0,,Иә, дұрыс!
Dialogue: 0,0:12:17.48,0:12:19.07,Default,,0,0,0,,Мұнда өрт шықты.
Dialogue: 0,0:12:19.19,0:12:21.53,Default,,0,0,0,,Бұл аймақ қазірдің өзінде ақымақтарға толы.
Dialogue: 0,0:12:21.65,0:12:24.53,Default,,0,0,0,,Мені итеріп, домалап кетті...
Dialogue: 0,0:12:24.66,0:12:27.32,Default,,0,0,0,,Мен осында құладым.
Dialogue: 0,0:12:27.53,0:12:28.91,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:12:29.54,0:12:33.75,Default,,0,0,0,,Міне болды! Біздің отбасымыздың барлық байлығы!
Dialogue: 0,0:12:33.87,0:12:34.87,Default,,0,0,0,,(Дораэмонның сыбыры)
Dialogue: 0,0:12:35.12,0:12:36.83,Default,,0,0,0,,Анашым, не?
Dialogue: 0,0:12:37.42,0:12:39.55,Default,,0,0,0,,Міне, мен кеңесуім керек.
Dialogue: 0,0:12:39.67,0:12:42.55,Default,,0,0,0,,Мына ит кедей ит екен.
Dialogue: 0,0:12:42.67,0:12:45.84,Default,,0,0,0,,Олай болса, жақсылықты қайтару үшін, неге оны менің үйіме қалдырмайсың?
Dialogue: 0,0:12:46.05,0:12:47.51,Default,,0,0,0,,Ум...
Dialogue: 0,0:12:48.39,0:12:49.22,Default,,0,0,0,,О.
Dialogue: 0,0:12:49.31,0:12:51.47,Default,,0,0,0,,Фуфу Яй! Алақай!
Dialogue: 0,0:12:51.93,0:12:56.35,Default,,0,0,0,,Итке ашық иелік ету арман сияқты.
Dialogue: 0,0:12:56.65,0:12:58.81,Default,,0,0,0,,Қабырғаға орнатылған ит үйі!
Dialogue: 0,0:12:58.94,0:13:00.19,Default,,0,0,0,,Нюрутто
Dialogue: 0,0:13:00.32,0:13:03.61,Default,,0,0,0,,Бұл сіздің үйіңіз, иә?
Dialogue: 0,0:13:05.91,0:13:07.24,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:13:07.36,0:13:09.07,Default,,0,0,0,,Уау, кең
Dialogue: 0,0:13:09.20,0:13:10.87,Default,,0,0,0,,Сізге ұнаған сияқты.
Dialogue: 0,0:13:11.29,0:13:13.83,Default,,0,0,0,,Нобита-кун, оның атын қалай қою керек?
Dialogue: 0,0:13:13.95,0:13:17.83,Default,,0,0,0,,Иә... Мен көптен бері қарным ашты, сондықтан оны «пеко» деп атаймын.
Dialogue: 0,0:13:17.96,0:13:18.88,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:13:19.29,0:13:21.80,Default,,0,0,0,,(Дораэмон гуілдейді)
Dialogue: 0,0:13:22.71,0:13:23.88,Default,,0,0,0,,О
Dialogue: 0,0:13:24.51,0:13:27.84,Default,,0,0,0,,Қазір таза, таза ақ.
Dialogue: 0,0:13:27.93,0:13:29.47,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:13:29.60,0:13:30.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:34.23,0:13:36.81,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:13:38.31,0:13:39.77,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:13:40.02,0:13:40.98,Default,,0,0,0,,Аа...
Dialogue: 0,0:13:41.11,0:13:42.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:42.78,0:13:45.07,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:13:45.19,0:13:47.32,Default,,0,0,0,,Ой! ?
Dialogue: 0,0:13:47.45,0:13:49.53,Default,,0,0,0,,Қош келдіңіз әке, қош келдіңіз
Dialogue: 0,0:13:49.66,0:13:51.28,Default,,0,0,0,,Не болды? бұл ит
Dialogue: 0,0:13:51.74,0:13:53.99,Default,,0,0,0,,Бүгіннен бастап мен оны үйде ұстауды шештім.
Dialogue: 0,0:13:54.12,0:13:55.62,Default,,0,0,0,,Мен Пекомын.
Dialogue: 0,0:13:55.75,0:13:58.08,Default,,0,0,0,,Хмм, жоқ.
Dialogue: 0,0:13:58.29,0:13:59.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:59.46,0:14:03.09,Default,,0,0,0,,Мен сізді аяймын, бірақ оны бастапқы орнына қайтаруыңызды өтінемін.
Dialogue: 0,0:14:03.21,0:14:04.05,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:14:04.38,0:14:07.84,Default,,0,0,0,,Менің анам рұқсат бермеуі мүмкін.
Dialogue: 0,0:14:07.97,0:14:09.47,Default,,0,0,0,,Сіз! иә
Dialogue: 0,0:14:09.59,0:14:12.30,Default,,0,0,0,,Сіз бейшара итіңізді тастап кетесіз бе?
Dialogue: 0,0:14:12.43,0:14:13.47,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:14:14.35,0:14:16.93,Default,,0,0,0,,Жоқ, сізде бәрі жақсы деп үміттенемін.
Dialogue: 0,0:14:17.06,0:14:17.98,Default,,0,0,0,,Хаха
Dialogue: 0,0:14:18.81,0:14:20.56,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:14:26.07,0:14:30.07,Default,,0,0,0,,Осы өзеннің жоғары жағында, тіпті аңдар да жақындай алмайтын ұлы жындар патшалығында ...
Dialogue: 0,0:14:30.20,0:14:33.62,Default,,0,0,0,,Ертеде гүлденген күн мен айдың қаласы бар дейді.
Dialogue: 0,0:14:33.74,0:14:35.95,Default,,0,0,0,,Эй, бұл керемет!
Dialogue: 0,0:14:36.25,0:14:38.96,Default,,0,0,0,,Жолда қандай қиындыққа тап болмасын...
Dialogue: 0,0:14:39.08,0:14:42.88,Default,,0,0,0,,Біз, Нобита экспедициясы командасы, аман қалу үшін бірге жұмыс істейміз!
Dialogue: 0,0:14:43.00,0:14:43.88,Default,,0,0,0,,О!
Dialogue: 0,0:14:45.05,0:14:46.84,Default,,0,0,0,,Иә? кінә?
Dialogue: 0,0:14:47.46,0:14:50.30,Default,,0,0,0,,Не? Өзенде не бар?
Dialogue: 0,0:14:50.80,0:14:52.26,Default,,0,0,0,,Баршаңыз, сақтығыңызды түсірмеңіз!
Dialogue: 0,0:14:52.39,0:14:55.68,Default,,0,0,0,,Ааа!
Dialogue: 0,0:14:58.52,0:15:00.23,Default,,0,0,0,,Бұл құбыжық!
Dialogue: 0,0:15:02.15,0:15:05.69,Default,,0,0,0,,үшінңызға Африка жеріне қош келдіңіздер.
Dialogue: 0,0:15:05.90,0:15:06.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:07.03,0:15:08.36,Default,,0,0,0,,Робот?
Dialogue: 0,0:15:09.49,0:15:12.45,Default,,0,0,0,,Толқынға толы зерттелмеген аймақ
Dialogue: 0,0:15:12.57,0:15:16.45,Default,,0,0,0,,Балалардан қарттарға дейін қауіпсіз рахаттана алатын шытырман оқиғалы ойын-сауық саябағы
Dialogue: 0,0:15:16.58,0:15:18.37,Default,,0,0,0,,Африка жеріне қош келдіңіз
Dialogue: 0,0:15:18.54,0:15:20.12,Default,,0,0,0,,(Жолаушылар айқайы)
Dialogue: 0,0:15:20.25,0:15:22.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:22.17,0:15:25.04,Default,,0,0,0,,Иә Нобита! Мұның несі сиқырлы?
Dialogue: 0,0:15:25.17,0:15:26.55,Default,,0,0,0,,Сен мені өте жақсы алдадың.
Dialogue: 0,0:15:26.80,0:15:29.05,Default,,0,0,0,,Тоқта, мен де білмедім.
Dialogue: 0,0:15:29.17,0:15:30.76,Default,,0,0,0,,Шуды күтіңіз! (Сунео) Бұл!
Dialogue: 0,0:15:30.97,0:15:32.97,Default,,0,0,0,,​​Маған көмектес!
Dialogue: 0,0:15:35.22,0:15:37.68,Default,,0,0,0,,Енді жындар патшалығы жоқ.
Dialogue: 0,0:15:38.31,0:15:41.31,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:15:41.39,0:15:44.31,Default,,0,0,0,,Ах ха ха ха
Dialogue: 0,0:15:44.73,0:15:46.98,Default,,0,0,0,,Не, арман?
Dialogue: 0,0:15:47.78,0:15:51.36,Default,,0,0,0,,Бірақ бұл жай ғана арман болуы мүмкін.
Dialogue: 0,0:15:51.49,0:15:53.82,Default,,0,0,0,,Бәлкім, енді жындар патшалығы деген ұғым жоқ шығар.
Dialogue: 0,0:15:53.95,0:15:55.45,Default,,0,0,0,,(Пеконың айқайы)
Dialogue: 0,0:15:56.08,0:15:57.74,Default,,0,0,0,,Пеко!
Dialogue: 0,0:15:59.37,0:16:04.67,Default,,0,0,0,,А, сіз қалай ойлайсыз? Сіз жындар патшалығы бар деп ойлайсыз ба?
Dialogue: 0,0:16:04.79,0:16:08.21,Default,,0,0,0,,Хехехе, дұрыс, бар екеніне сенімдімін.
Dialogue: 0,0:16:09.30,0:16:12.72,Default,,0,0,0,,Бүгін бірге ұйықтайық. Қайырлы түн.
Dialogue: 0,0:16:14.13,0:16:17.68,Default,,0,0,0,,(Нобитаның қорылдауы)
Dialogue: 0,0:16:31.28,0:16:33.74,Default,,0,0,0,,Түскі ас! Оян!
Dialogue: 0,0:16:33.82,0:16:36.07,Default,,0,0,0,,Күріш Күріш Фуфуфу
Dialogue: 0,0:16:36.20,0:16:37.91,Default,,0,0,0,,Нахаха күріш
Dialogue: 0,0:16:38.03,0:16:39.20,Default,,0,0,0,,Бұл қан сенікі емес; бұл Абдулдің қаны.
Dialogue: 0,0:16:39.41,0:16:40.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:40.37,0:16:42.16,Default,,0,0,0,,Пеко, кешкі ас сонда.
Dialogue: 0,0:16:42.29,0:16:43.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:47.38,0:16:50.00,Default,,0,0,0,,Ах... (Нобита) А...
Dialogue: 0,0:16:50.46,0:16:51.96,Default,,0,0,0,,Итадакимасу!
Dialogue: 0,0:16:54.68,0:16:57.22,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:17:00.18,0:17:03.35,Default,,0,0,0,,Нобита! Бұл не? жаман мінез-құлық
Dialogue: 0,0:17:03.48,0:17:04.98,Default,,0,0,0,,Неге Пеко-чанның соңынан аздап ілеспеске?
Dialogue: 0,0:17:05.10,0:17:05.94,Default,,0,0,0,,Иә? а?
Dialogue: 0,0:17:10.52,0:17:12.61,Default,,0,0,0,,Қандай жақсы мінезді ит.
Dialogue: 0,0:17:12.74,0:17:14.24,Default,,0,0,0,,Дора-чанның түскі ас қорабы бар
Dialogue: 0,0:17:14.36,0:17:15.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:15.74,0:17:17.11,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:17:20.28,0:17:23.04,Default,,0,0,0,,Иә? Саванна пайда бола бастады
Dialogue: 0,0:17:23.16,0:17:24.66,Default,,0,0,0,,Саванна дегеніміз не?
Dialogue: 0,0:17:24.79,0:17:28.50,Default,,0,0,0,,Бұл жайлаулы аймақ. Шығыс Африкада жиі кездеседі.
Dialogue: 0,0:17:28.58,0:17:31.50,Default,,0,0,0,,Жабайы аңдар бар ма? Біреу жоқ па?
Dialogue: 0,0:17:31.84,0:17:36.72,Default,,0,0,0,,Уау, эй, Африканың өзі қанша суретке түседі?
Dialogue: 0,0:17:36.84,0:17:40.55,Default,,0,0,0,,Бір фотосурет шамамен 3 шаршы километрді құрайды...
Dialogue: 0,0:17:40.68,0:17:43.47,Default,,0,0,0,,Шамамен 9,3 миллион дана (Нобита) Иә! ?
Dialogue: 0,0:17:43.68,0:17:45.98,Default,,0,0,0,,9,3 миллион дана! ?
Dialogue: 0,0:17:46.27,0:17:48.90,Default,,0,0,0,,Ааа
Dialogue: 0,0:17:49.19,0:17:50.81,Default,,0,0,0,,Әй, өзіңді дайында.
Dialogue: 0,0:17:50.94,0:17:54.11,Default,,0,0,0,,Сіз бұл қиын жұмыс болатынын білдіңіз, солай ма?
Dialogue: 0,0:17:54.23,0:17:56.86,Default,,0,0,0,,Анашым! SOS
Dialogue: 0,0:18:04.95,0:18:06.71,Default,,0,0,0,,Амансың ба? Нобита-кун
Dialogue: 0,0:18:06.83,0:18:10.25,Default,,0,0,0,,Иә, мен әбден ұйықтап қалдым.
Dialogue: 0,0:18:10.75,0:18:14.34,Default,,0,0,0,,Зерттеуді тездетпесем, қысқы демалыс болады.
Dialogue: 0,0:18:14.46,0:18:16.84,Default,,0,0,0,,Өзіңді қатты итермеу жақсы емес пе?
Dialogue: 0,0:18:19.76,0:18:21.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:22.85,0:18:24.26,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:18:24.39,0:18:26.60,Default,,0,0,0,,Сымды жіберу тоқтатылуы керек еді.
Dialogue: 0,0:18:28.48,0:18:29.56,Default,,0,0,0,,Пеко!
Dialogue: 0,0:18:29.90,0:18:32.52,Default,,0,0,0,,Не, бұл Пеконың еркелігі ме?
Dialogue: 0,0:18:32.90,0:18:35.73,Default,,0,0,0,,А-а-а, мен әбігерге түстім.
Dialogue: 0,0:18:37.61,0:18:39.78,Default,,0,0,0,,А? не? Бұл
Dialogue: 0,0:18:41.03,0:18:43.66,Default,,0,0,0,,А, джунглиде бос жер бар.
Dialogue: 0,0:18:44.20,0:18:47.16,Default,,0,0,0,,Бір нүктені үлкейтейік
Dialogue: 0,0:18:48.79,0:18:51.13,Default,,0,0,0,,О? Бұл тас па...
Dialogue: 0,0:18:51.25,0:18:53.71,Default,,0,0,0,,Жоқ, бұл сөзсіз артефакт.
Dialogue: 0,0:18:54.25,0:18:57.76,Default,,0,0,0,,Осындай кезде алты жақты камераны пайдаланыңыз!
Dialogue: 0,0:18:57.88,0:19:01.09,Default,,0,0,0,,Нобита-кун, фотоны маған қарай ұста.
Dialogue: 0,0:19:02.09,0:19:02.93,Default,,0,0,0,,Мағынасыздық
Dialogue: 0,0:19:03.05,0:19:06.60,Default,,0,0,0,,Иә, дәл солай.
Dialogue: 0,0:19:06.72,0:19:08.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:08.60,0:19:09.98,Default,,0,0,0,,Тіпті оның есту қабілетінен айырылғаны туралы қауесет те бар
Dialogue: 0,0:19:11.40,0:19:12.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:13.31,0:19:14.77,Default,,0,0,0,,Тас мүсін!
Dialogue: 0,0:19:14.90,0:19:16.94,Default,,0,0,0,,Джунглидің осы терең бөлігінде?
Dialogue: 0,0:19:17.23,0:19:19.90,Default,,0,0,0,,Декисугиден сұрайық, ол көп біледі.
Dialogue: 0,0:19:20.15,0:19:22.53,Default,,0,0,0,,Тамақтанып алайық (Нобита) Кейінірек!
Dialogue: 0,0:19:26.45,0:19:28.25,Default,,0,0,0,,Бұндай нәрсені бірінші рет көруім.
Dialogue: 0,0:19:28.66,0:19:30.29,Default,,0,0,0,,Африканың қай бөлігі?
Dialogue: 0,0:19:30.41,0:19:32.96,Default,,0,0,0,,Орталық Африка Джунглиінің тереңдігі
Dialogue: 0,0:19:33.46,0:19:37.13,Default,,0,0,0,,Орталық Африка Хмм... Ах.
Dialogue: 0,0:19:37.71,0:19:39.63,Default,,0,0,0,,Ауыр темекі шегетін орман
Dialogue: 0,0:19:40.05,0:19:41.93,Default,,0,0,0,,Темекі шегетін орман?
Dialogue: 0,0:19:42.05,0:19:43.09,Default,,0,0,0,,Қорқамын, ол қайтып келмейді.
Dialogue: 0,0:19:43.22,0:19:46.10,Default,,0,0,0,,«Темекіқұмарлар орманы» дегенді білдіреді
Dialogue: 0,0:19:46.56,0:19:48.81,Default,,0,0,0,,Орталық Африканың джунглиінің бір бөлігінде.
Dialogue: 0,0:19:48.93,0:19:53.65,Default,,0,0,0,,Ауданның әрқашан бұлт басқан бөліктері болады, мен спутниктік фотосуреттерді түсіре алмаймын.
Dialogue: 0,0:19:53.90,0:19:57.90,Default,,0,0,0,,Түсіндім! Менің спутнигіме бұлттар кедергі келтірмейді.
Dialogue: 0,0:19:57.98,0:19:59.69,Default,,0,0,0,,Рахмет саған Декисуги-кун
Dialogue: 0,0:19:59.82,0:20:01.40,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:03.03,0:20:06.07,Default,,0,0,0,,Ақыры... Ақыры жын патшалығын таптым!
Dialogue: 0,0:20:06.37,0:20:09.24,Default,,0,0,0,,үшінмызға хабарлап, ертең таңертең жолға шығайық!
Dialogue: 0,0:20:09.33,0:20:10.50,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:20:10.62,0:20:12.92,Default,,0,0,0,,Ертең ерте ме деп ойлаймын
Dialogue: 0,0:20:16.34,0:20:18.75,Default,,0,0,0,,(Пеко қабығы)
Dialogue: 0,0:20:19.76,0:20:21.97,Default,,0,0,0,,Қызық, бәрі жиналып қалды ма?
Dialogue: 0,0:20:25.22,0:20:26.43,Default,,0,0,0,,Сәнді дизайнерлік аяқ киім алу үшін жинап жүрген 20 000 йенім...
Dialogue: 0,0:20:26.55,0:20:28.31,Default,,0,0,0,,Не? сол қалпақ
Dialogue: 0,0:20:28.43,0:20:30.64,Default,,0,0,0,,Барлау үшін көңіл-күйге түсу керек.
Dialogue: 0,0:20:31.43,0:20:33.73,Default,,0,0,0,,Күткеніңізге рахмет! (Сунео) Сіз кешіктіңіз! Нобита
Dialogue: 0,0:20:33.85,0:20:35.02,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:35.15,0:20:36.98,Default,,0,0,0,,Не? бұл ит сүйкімді
Dialogue: 0,0:20:37.23,0:20:40.82,Default,,0,0,0,,Менің атым «Пеко» және мен осында болдым.
Dialogue: 0,0:20:40.94,0:20:42.99,Default,,0,0,0,,Танысқаныма қуаныштымын, Пеко-чан
Dialogue: 0,0:20:45.11,0:20:47.28,Default,,0,0,0,,Бұл өте ақылды ит.
Dialogue: 0,0:20:47.41,0:20:48.62,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:20:48.74,0:20:50.49,Default,,0,0,0,,Меншік иесінен айырмашылығы.
Dialogue: 0,0:20:50.62,0:20:51.75,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:20:52.16,0:20:54.04,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:20:54.16,0:20:55.71,Default,,0,0,0,,(Джианның күлкісі)
Dialogue: 0,0:20:58.92,0:21:01.67,Default,,0,0,0,,Экспедиция тобының ретке келтіру нөмірі!
Dialogue: 0,0:21:02.17,0:21:03.22,Default,,0,0,0,,1 (Нобита) 2
Dialogue: 0,0:21:03.34,0:21:04.34,Default,,0,0,0,,３ ４
Dialogue: 0,0:21:04.47,0:21:06.05,Default,,0,0,0,,5 5?
Dialogue: 0,0:21:06.18,0:21:07.97,Default,,0,0,0,,Сендер төртеу емессіңдер ме?
Dialogue: 0,0:21:08.10,0:21:09.89,Default,,0,0,0,,О? (Нобита) Бұл біртүрлі.
Dialogue: 0,0:21:10.01,0:21:12.35,Default,,0,0,0,,Мен біреудің «5» деп айтқанына сенімдімін
Dialogue: 0,0:21:12.68,0:21:15.60,Default,,0,0,0,,О, бұл не, Джан?
Dialogue: 0,0:21:15.73,0:21:17.81,Default,,0,0,0,,Сен өзіңді санауды ұмыттың.
Dialogue: 0,0:21:17.90,0:21:22.03,Default,,0,0,0,,Иә? А, түсіндім. Мені қосқанда 5 адам бар.
Dialogue: 0,0:21:22.15,0:21:24.44,Default,,0,0,0,,Сонымен, Дора отряды
Dialogue: 0,0:21:24.57,0:21:26.70,Default,,0,0,0,,Экспедицияңыздың мақсатын түсіндіріңіз.
Dialogue: 0,0:21:26.78,0:21:28.41,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:21:28.95,0:21:31.03,Default,,0,0,0,,Барлық жерде есіктер! Йотто
Dialogue: 0,0:21:31.66,0:21:35.25,Default,,0,0,0,,Біздің мақсатымыз – ең алғашқы адамдар дүниеге келген өлке.
Dialogue: 0,0:21:35.37,0:21:37.25,Default,,0,0,0,,Африка материгі
Dialogue: 0,0:21:38.25,0:21:41.63,Default,,0,0,0,,Ежелден бері сейілмеген тұманның қойнауында...
Dialogue: 0,0:21:41.75,0:21:44.17,Default,,0,0,0,,Сол жерде жұмбақ алып мүсін тұр.
Dialogue: 0,0:21:44.26,0:21:48.18,Default,,0,0,0,,Ей, ол жерде қазына бар шығар?
Dialogue: 0,0:21:48.30,0:21:50.89,Default,,0,0,0,,Қазынаны бос сөз деп санамаңыз.
Dialogue: 0,0:21:51.01,0:21:51.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:51.89,0:21:56.89,Default,,0,0,0,,Біздің мақсатымыз - қызықты шытырман оқиға.
Dialogue: 0,0:21:57.14,0:22:00.44,Default,,0,0,0,,Баратын жеріңізге кенет жетіп қалсаңыз да қызықсыз...
Dialogue: 0,0:22:00.56,0:22:03.11,Default,,0,0,0,,Өз аяқпен 100 шақырымдай жол жүрейік
Dialogue: 0,0:22:04.48,0:22:07.15,Default,,0,0,0,,Мақсатқа 100 км қалғанда
Dialogue: 0,0:22:08.95,0:22:11.28,Default,,0,0,0,,үшінң дайынсыңдар ма?
Dialogue: 0,0:22:11.41,0:22:13.04,Default,,0,0,0,,Әрине! (Нобита) Иә
Dialogue: 0,0:22:13.16,0:22:13.99,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:22:14.12,0:22:15.25,Default,,0,0,0,,Жеңіске жетейік!
Dialogue: 0,0:22:17.41,0:22:20.75,Default,,0,0,0,,Келіңіздер! Бұл үлкен шытырман оқиғаның басы
Dialogue: 0,0:22:20.88,0:22:23.75,Default,,0,0,0,,Уау, олар керемет көрінеді!
Dialogue: 0,0:22:25.46,0:22:27.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:28.05,0:22:29.47,Default,,0,0,0,,Бұл ауыр (Нобита) Дораемон
Dialogue: 0,0:22:29.59,0:22:32.05,Default,,0,0,0,,Сіз не істеп жатырсыз? Бұл ауырады
Dialogue: 0,0:22:32.18,0:22:33.64,Default,,0,0,0,,Оу!
Dialogue: 0,0:22:49.28,0:22:51.03,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:22:51.49,0:22:52.99,Default,,0,0,0,,Керемет!
Dialogue: 0,0:22:53.12,0:22:53.95,Default,,0,0,0,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,0:22:54.08,0:22:54.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:55.08,0:22:56.50,Default,,0,0,0,,Айқай~
Dialogue: 0,0:22:57.08,0:22:58.66,Default,,0,0,0,,Африка…
Dialogue: 0,0:22:59.25,0:23:02.46,Default,,0,0,0,,Біз нағыз Африкаға келдік!
Dialogue: 0,0:23:02.75,0:23:04.29,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:23:04.42,0:23:06.63,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:23:06.76,0:23:07.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:08.55,0:23:11.05,Default,,0,0,0,,Пеко: «Тез барайық» дейді.
Dialogue: 0,0:23:11.18,0:23:13.64,Default,,0,0,0,,Жарайды! Олай болса кеттік
Dialogue: 0,0:23:15.01,0:23:18.10,Default,,0,0,0,,Экспедиция тобы кетеді!
Dialogue: 0,0:23:18.23,0:23:19.60,Default,,0,0,0,,О!
Dialogue: 0,0:23:21.85,0:23:24.06,Default,,0,0,0,,А-а, жақсысың ба?
Dialogue: 0,0:23:29.07,0:23:32.16,Default,,0,0,0,,Уау! сирек гүл
Dialogue: 0,0:23:34.74,0:23:36.66,Default,,0,0,0,,Иә? Ахх
Dialogue: 0,0:23:36.91,0:23:40.00,Default,,0,0,0,,Ах Окапи
Dialogue: 0,0:23:41.54,0:23:43.54,Default,,0,0,0,,Хехе, ата-ана мен бала.
Dialogue: 0,0:23:46.67,0:23:49.51,Default,,0,0,0,,Уау! әдемі шаш үлгісі
Dialogue: 0,0:23:49.76,0:23:52.47,Default,,0,0,0,,Хахаха бұл...
Dialogue: 0,0:23:55.72,0:23:57.64,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:23:57.76,0:23:58.85,Default,,0,0,0,,Ах
Dialogue: 0,0:23:58.97,0:23:59.89,Default,,0,0,0,,Уау...
Dialogue: 0,0:24:04.19,0:24:05.86,Default,,0,0,0,,Батырдың аты: Ол Майт
Dialogue: 0,0:24:06.44,0:24:07.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:07.86,0:24:09.48,Default,,0,0,0,,Уау~
Dialogue: 0,0:24:13.03,0:24:15.03,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:24:20.08,0:24:21.91,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:24:22.46,0:24:24.08,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:24:24.42,0:24:25.63,Default,,0,0,0,,Ия
Dialogue: 0,0:24:27.71,0:24:29.00,Default,,0,0,0,,Джан тезірек!
Dialogue: 0,0:24:29.13,0:24:30.26,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:24:30.38,0:24:33.18,Default,,0,0,0,,Осымен қанша күн өтсе де жалықпайсың.
Dialogue: 0,0:24:37.35,0:24:41.43,Default,,0,0,0,,А... а... мен жалықтым!
Dialogue: 0,0:24:42.06,0:24:45.15,Default,,0,0,0,,Менің ойымша, мен шамамен 10 км жүрдім.
Dialogue: 0,0:24:45.27,0:24:47.36,Default,,0,0,0,,Сіз әлі 5 шақырым жаяу жүрген жоқсыз.
Dialogue: 0,0:24:47.48,0:24:50.86,Default,,0,0,0,,Иә! ? 95 км қалды!
Dialogue: 0,0:24:50.94,0:24:54.24,Default,,0,0,0,,Джунгли қанша алыс жүрсең де ағаштарға толы.
Dialogue: 0,0:24:54.36,0:24:55.99,Default,,0,0,0,,Әрине
Dialogue: 0,0:24:56.11,0:24:59.03,Default,,0,0,0,,Жабайы аңдар жоқ!
Dialogue: 0,0:24:59.16,0:25:01.79,Default,,0,0,0,,Мен қобалжымаймын немесе қобалжымаймын.
Dialogue: 0,0:25:03.29,0:25:05.46,Default,,0,0,0,,Балалар, тым көп шағымдандыңдар!
Dialogue: 0,0:25:05.96,0:25:09.96,Default,,0,0,0,,Пекоға қарашы, ол сондай ынталы. Әркім одан үйренуі керек.
Dialogue: 0,0:25:10.30,0:25:13.47,Default,,0,0,0,,Ах! Мен маңызды нәрсені ұмытып кеттім
Dialogue: 0,0:25:13.59,0:25:16.01,Default,,0,0,0,,Дораемон, кез келген жерде есікті аш
Dialogue: 0,0:25:16.13,0:25:17.26,Default,,0,0,0,,Бірақ оны қазір анаға көрсетпе.
Dialogue: 0,0:25:17.39,0:25:20.81,Default,,0,0,0,,0 баллдық тесттердің көптігі сонша, мен оларды жасыруға тура келеді.
Dialogue: 0,0:25:22.31,0:25:25.48,Default,,0,0,0,,Тексер, барлау көңіл күйі бұзылды.
Dialogue: 0,0:25:26.10,0:25:28.31,Default,,0,0,0,,Мен бірден қайтамын.
Dialogue: 0,0:25:33.11,0:25:36.45,Default,,0,0,0,,Анам мені таппағанына қуаныштымын.
Dialogue: 0,0:25:37.66,0:25:39.82,Default,,0,0,0,,Қайда бара жатырсың? (Нобита) Африка!
Dialogue: 0,0:25:40.33,0:25:42.83,Default,,0,0,0,,Мен кешкі асқа дейін үйде боламын.
Dialogue: 0,0:25:44.33,0:25:46.83,Default,,0,0,0,,Иә? Африка! ?
Dialogue: 0,0:25:47.08,0:25:50.09,Default,,0,0,0,,Енді, бәріміз, шетке қарамай кетейік!
Dialogue: 0,0:25:50.21,0:25:51.80,Default,,0,0,0,,Жақсы жігіт
Dialogue: 0,0:25:52.59,0:25:54.59,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:25:54.71,0:25:58.26,Default,,0,0,0,,Жетілдірілген француз курсының жазбасын брондауды ұмытып кетіппін.
Dialogue: 0,0:25:58.64,0:26:00.51,Default,,0,0,0,,Мен... Мен бірден қайтамын.
Dialogue: 0,0:26:00.64,0:26:02.14,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:26:02.76,0:26:06.02,Default,,0,0,0,,Мен өзімді зерттеуші ретінде дайындай алмаймын!
Dialogue: 0,0:26:07.31,0:26:11.98,Default,,0,0,0,,Кәне, бәріміз, қайтадан ретке келтірейік!
Dialogue: 0,0:26:14.73,0:26:16.40,Default,,0,0,0,,Дора-чан?
Dialogue: 0,0:26:16.53,0:26:17.99,Default,,0,0,0,,Сіз мені кез келген жерде есіктен шығара аласыз ба?
Dialogue: 0,0:26:18.11,0:26:20.49,Default,,0,0,0,,Иә! ? Шизука-чан да?
Dialogue: 0,0:26:20.70,0:26:23.03,Default,,0,0,0,,Бір минут күтіңіз! (Нобита) А~
Dialogue: 0,0:26:23.20,0:26:25.83,Default,,0,0,0,,Барлық жерде есіктерді пайдалануды тоқтатыңыз.
Dialogue: 0,0:26:26.45,0:26:28.75,Default,,0,0,0,,Сонымен... Иә?
Dialogue: 0,0:26:28.83,0:26:30.92,Default,,0,0,0,,Дәретхана! ?
Dialogue: 0,0:26:32.17,0:26:33.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:26:33.80,0:26:37.72,Default,,0,0,0,,Әр кезде ваннаға қайтатын экспедиция туралы естіген емеспін.
Dialogue: 0,0:26:38.88,0:26:42.39,Default,,0,0,0,,Қараңдар! Барлау кезінде үйге қайтқыңыз келсе...
Dialogue: 0,0:26:42.51,0:26:44.39,Default,,0,0,0,,Мен сені ұрамын!
Dialogue: 0,0:26:44.56,0:26:44.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:44.89,0:26:45.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:44.89,0:26:45.85,Default,,0,0,0,,Себеп қандай болса да.
Dialogue: 0,0:26:45.85,0:26:47.06,Default,,0,0,0,,Себеп қандай болса да.
Dialogue: 0,0:26:47.18,0:26:49.39,Default,,0,0,0,,Таке-сан, сәл күте тұрыңыз.
Dialogue: 0,0:26:49.52,0:26:50.35,Default,,0,0,0,,Не?
Dialogue: 0,0:26:53.02,0:26:57.82,Default,,0,0,0,,Не? Анам ашуланып: «Тезірек кел!» деді.
Dialogue: 0,0:26:58.24,0:26:59.45,Default,,0,0,0,,Ол ол ол ол ол ол
Dialogue: 0,0:26:59.57,0:27:02.45,Default,,0,0,0,,Дора-чан, қайда болсаң да есікті ашық қалдыр.
Dialogue: 0,0:27:02.57,0:27:03.58,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:27:03.70,0:27:07.16,Default,,0,0,0,,Анамды көру үшін қайтып келемін, мен ешқашан экспедиция көрген емеспін!
Dialogue: 0,0:27:07.29,0:27:08.79,Default,,0,0,0,,Шулы! Шулы!
Dialogue: 0,0:27:12.79,0:27:13.75,Default,,0,0,0,,Әй?
Dialogue: 0,0:27:20.30,0:27:21.72,Default,,0,0,0,,Кеттік
Dialogue: 0,0:27:24.89,0:27:25.72,Default,,0,0,0,,(Пеко қабығы)
Dialogue: 0,0:27:28.68,0:27:31.14,Default,,0,0,0,,Бірдеңе болды.
Dialogue: 0,0:27:31.56,0:27:34.44,Default,,0,0,0,,Толқып тұрған жалғыз Пеко ма?
Dialogue: 0,0:27:36.90,0:27:40.03,Default,,0,0,0,,А, эй, жақында түскі ас ішеміз бе?
Dialogue: 0,0:27:40.15,0:27:41.82,Default,,0,0,0,,Һм… Ха-ха-ха
Dialogue: 0,0:27:41.95,0:27:44.07,Default,,0,0,0,,Мен түскі асымды әкелген жоқпын.
Dialogue: 0,0:27:44.20,0:27:45.62,Default,,0,0,0,,Жарайды, оны маған қалдырыңыз.
Dialogue: 0,0:27:45.70,0:27:48.04,Default,,0,0,0,,Фуфунді жеткізу телефон қоңырауы
Dialogue: 0,0:27:48.16,0:27:50.37,Default,,0,0,0,,Тоқта! Егер сіз осындай нәрсені қолдансаңыз ...
Dialogue: 0,0:27:51.41,0:27:52.29,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:27:52.58,0:27:55.79,Default,,0,0,0,,Мен түсінемін, бұл көңіл-күйді бұзады (Сунео/Шидзука) Иә, иә.
Dialogue: 0,0:27:55.92,0:27:57.80,Default,,0,0,0,,Хмм, онда...
Dialogue: 0,0:27:58.71,0:28:01.59,Default,,0,0,0,,Өсімдіктерді өзгерту сығындысы I
Dialogue: 0,0:28:02.05,0:28:04.64,Default,,0,0,0,,үшін, маған не жегіңіз келетінін айтыңыз.
Dialogue: 0,0:28:04.76,0:28:06.35,Default,,0,0,0,,Карри және күріш! құймақ
Dialogue: 0,0:28:06.47,0:28:08.22,Default,,0,0,0,,Рамен краб палауы
Dialogue: 0,0:28:08.60,0:28:10.02,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:28:10.43,0:28:14.23,Default,,0,0,0,,Ал, карри мен күріш ампуласы...
Dialogue: 0,0:28:14.35,0:28:15.27,Default,,0,0,0,,Міне!
Dialogue: 0,0:28:15.61,0:28:18.73,Default,,0,0,0,,Хмм... аа хе хе.
Dialogue: 0,0:28:18.86,0:28:21.15,Default,,0,0,0,,Бұл ағаш жақсы.
Dialogue: 0,0:28:23.41,0:28:28.28,Default,,0,0,0,,♪Гүлдер гүлдеп, жемістер өседі
Dialogue: 0,0:28:28.41,0:28:32.71,Default,,0,0,0,,♪Карри күріш дайын
Dialogue: 0,0:28:33.46,0:28:34.79,Default,,0,0,0,,Иә...
Dialogue: 0,0:28:34.92,0:28:37.21,Default,,0,0,0,,Бұл карри күріші ше?
Dialogue: 0,0:28:37.34,0:28:38.96,Default,,0,0,0,,Қане, оны бөлшектеп көрейік.
Dialogue: 0,0:28:41.17,0:28:42.84,Default,,0,0,0,,Уау, бұл рас!
Dialogue: 0,0:28:43.13,0:28:44.63,Default,,0,0,0,,Фуфу (Сунео) Ахаха
Dialogue: 0,0:28:44.76,0:28:46.76,Default,,0,0,0,,Йойшо (Сунео) Эй
Dialogue: 0,0:28:47.18,0:28:49.22,Default,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,0:28:49.35,0:28:51.10,Default,,0,0,0,,Уау! Дәмді көрінеді!
Dialogue: 0,0:28:51.22,0:28:52.31,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:28:52.43,0:28:55.77,Default,,0,0,0,,Мүмкін болса, әдемі көрініс бар жерде тамақтанайық.
Dialogue: 0,0:28:55.90,0:28:57.65,Default,,0,0,0,,Импровизацияланған лифт
Dialogue: 0,0:28:58.98,0:28:59.65,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:29:03.70,0:29:06.03,Default,,0,0,0,,Осының үстіне асхана салайық.
Dialogue: 0,0:29:07.24,0:29:08.99,Default,,0,0,0,,Yahoo! Хехе
Dialogue: 0,0:29:09.70,0:29:12.04,Default,,0,0,0,,Өсімдіктерді өзгерту сығындысы II (Екі)
Dialogue: 0,0:29:24.55,0:29:25.55,Default,,0,0,0,,Уау
Dialogue: 0,0:29:25.68,0:29:28.34,Default,,0,0,0,,үшінң ретімен келіңдер.
Dialogue: 0,0:29:28.60,0:29:29.80,Default,,0,0,0,,Хаха
Dialogue: 0,0:29:30.35,0:29:32.60,Default,,0,0,0,,Мен №1! (Сунео) Жарайды, 2 саны.
Dialogue: 0,0:29:32.72,0:29:35.35,Default,,0,0,0,,Пеко, жүр, тамақ ішейік.
Dialogue: 0,0:29:36.56,0:29:38.69,Default,,0,0,0,,Пеко да аш, солай ма?
Dialogue: 0,0:29:38.77,0:29:40.11,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:29:40.23,0:29:43.03,Default,,0,0,0,,Құлап қалма, ау!
Dialogue: 0,0:29:43.57,0:29:45.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:49.28,0:29:50.87,Default,,0,0,0,,Керемет!
Dialogue: 0,0:29:50.99,0:29:53.20,Default,,0,0,0,,Қандай тамаша көрініс.
Dialogue: 0,0:29:53.29,0:29:55.21,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:29:56.37,0:29:58.17,Default,,0,0,0,,Хмм.
Dialogue: 0,0:30:04.51,0:30:07.34,Default,,0,0,0,,Джунглидегі түскі ас ең жақсысы.
Dialogue: 0,0:30:07.47,0:30:08.30,Default,,0,0,0,,Иә
Dialogue: 0,0:30:08.43,0:30:10.43,Default,,0,0,0,,Джианның көңіл-күйінің көтерілгеніне қуаныштымын.
Dialogue: 0,0:30:10.55,0:30:11.43,Default,,0,0,0,,Рас
Dialogue: 0,0:30:11.60,0:30:15.73,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:30:17.35,0:30:18.56,Default,,0,0,0,,Эй, маған Сунеоның тамағынан тістеп берші.
Dialogue: 0,0:30:18.56,0:30:18.73,Default,,0,0,0,,Эй, маған Сунеоның тамағынан тістеп берші.
Dialogue: 0,0:30:18.56,0:30:18.73,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:30:18.73,0:30:18.85,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:30:18.85,0:30:20.23,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:30:18.85,0:30:20.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:20.36,0:30:22.23,Default,,0,0,0,,Не болды? Пеко
Dialogue: 0,0:30:22.65,0:30:23.98,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:30:24.90,0:30:28.24,Default,,0,0,0,,Солтүстікте ақ түтін сияқты бірдеңе бар.
Dialogue: 0,0:30:28.74,0:30:31.78,Default,,0,0,0,,Кез келген жағдайда... кез келген жағдайда, солай
Dialogue: 0,0:30:31.91,0:30:33.95,Default,,0,0,0,,Темекі шегетін орман!
Dialogue: 0,0:30:34.33,0:30:36.20,Default,,0,0,0,,Бұл шынымен болды ма?
Dialogue: 0,0:30:36.33,0:30:38.92,Default,,0,0,0,,Жаяу жүрсең, бір күні жетесің
Dialogue: 0,0:30:47.59,0:30:49.68,Default,,0,0,0,,Бұл қызықты бола бастады.
Dialogue: 0,0:30:49.80,0:30:54.31,Default,,0,0,0,,Егер жабайы аңдар пайда болса, бұл оны барлау сияқты етеді.
Dialogue: 0,0:30:54.68,0:30:56.93,Default,,0,0,0,,Дораемон аңы босатылуы мүмкін емес пе?
Dialogue: 0,0:30:57.06,0:30:58.77,Default,,0,0,0,,Әрине аласыз.
Dialogue: 0,0:31:00.14,0:31:02.69,Default,,0,0,0,,Аңдардан қорғанатын жадағай
Dialogue: 0,0:31:02.77,0:31:04.73,Default,,0,0,0,,Жадағайдан түскен жарық...
Dialogue: 0,0:31:04.86,0:31:08.19,Default,,0,0,0,,Аңның ашуын келтіріп, оны өзіне тартады
Dialogue: 0,0:31:10.78,0:31:12.74,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:31:13.87,0:31:15.33,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:31:15.45,0:31:17.87,Default,,0,0,0,,Сіз не деп үріп тұрсыз? Пеко
Dialogue: 0,0:31:18.37,0:31:20.04,Default,,0,0,0,,(айқай)
Dialogue: 0,0:31:20.12,0:31:23.21,Default,,0,0,0,,А, мен бір адамды түсіне алмаймын.
Dialogue: 0,0:31:23.33,0:31:24.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:27.55,0:31:30.26,Default,,0,0,0,,Уау! Бұл барыс!
Dialogue: 0,0:31:30.51,0:31:32.68,Default,,0,0,0,,Та та... Көмектесіңізші!
Dialogue: 0,0:31:34.97,0:31:37.27,Default,,0,0,0,,(Джианның айқайы)
Dialogue: 0,0:31:37.39,0:31:39.27,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:31:43.19,0:31:44.52,Default,,0,0,0,,Аа...
Dialogue: 0,0:31:44.65,0:31:46.57,Default,,0,0,0,,Момотаро мөрі бар тары тұшпара
Dialogue: 0,0:31:46.69,0:31:47.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:47.78,0:31:50.24,Default,,0,0,0,,Иә! Хахаха
Dialogue: 0,0:31:50.36,0:31:52.36,Default,,0,0,0,,Үйреніп алсаң сүйкімді.
Dialogue: 0,0:31:52.49,0:31:54.32,Default,,0,0,0,,Келесі мен мінгім келеді!
Dialogue: 0,0:31:55.12,0:31:56.70,Default,,0,0,0,,Қажет емес нәрсе жасаңыз!
Dialogue: 0,0:31:56.83,0:31:59.70,Default,,0,0,0,,Мен сені жеңу менің міндетім деп ойладым.
Dialogue: 0,0:32:00.00,0:32:01.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:01.29,0:32:04.00,Default,,0,0,0,,(Нобита) қайтадан күшейді
Dialogue: 0,0:32:04.67,0:32:06.29,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:32:06.71,0:32:09.42,Default,,0,0,0,,Сіз бөрене клубын осылай толқындайсыз.
Dialogue: 0,0:32:09.55,0:32:10.59,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:32:11.01,0:32:13.38,Default,,0,0,0,,Шегіртке мен шегіртке шабу...
Dialogue: 0,0:32:16.85,0:32:18.51,Default,,0,0,0,,Оны басқа жерде көрді, сондықтан ол сонда кетті.
Dialogue: 0,0:32:18.77,0:32:21.52,Default,,0,0,0,,О, маған көмектес!
Dialogue: 0,0:32:21.73,0:32:25.10,Default,,0,0,0,,О, бұл қиын, Кіші жарық!
Dialogue: 0,0:32:25.23,0:32:26.40,Default,,0,0,0,,Маған да жасап берейін
Dialogue: 0,0:32:26.48,0:32:28.52,Default,,0,0,0,,Анашым! (Нобита) Ei
Dialogue: 0,0:32:32.40,0:32:34.24,Default,,0,0,0,,Қараңызшы, сіз енді қорықпайсыз.
Dialogue: 0,0:32:34.57,0:32:35.87,Default,,0,0,0,,жауын құрты сияқты
Dialogue: 0,0:32:35.99,0:32:38.12,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:32:38.24,0:32:40.20,Default,,0,0,0,,Оны тез қайтарыңыз!
Dialogue: 0,0:32:40.29,0:32:42.54,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:32:42.66,0:32:43.58,Default,,0,0,0,,Әй?
Dialogue: 0,0:32:44.75,0:32:46.58,Default,,0,0,0,,Мүйізтұмсық!
Dialogue: 0,0:32:47.46,0:32:50.92,Default,,0,0,0,,Хахаха неге... Мен... Бәрі мен туралы!
Dialogue: 0,0:32:53.63,0:32:55.39,Default,,0,0,0,,Шок мылтығы!
Dialogue: 0,0:32:55.51,0:32:57.14,Default,,0,0,0,,Маған осы жолы орындауға рұқсат етіңіз
Dialogue: 0,0:32:57.89,0:33:01.10,Default,,0,0,0,,Мені кешіріңіз!
Dialogue: 0,0:33:02.23,0:33:03.52,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:33:03.60,0:33:06.02,Default,,0,0,0,,Көмектесіңіз!
Dialogue: 0,0:33:07.94,0:33:09.36,Default,,0,0,0,,Әй, не болды!
Dialogue: 0,0:33:09.48,0:33:11.86,Default,,0,0,0,,Керемет жұмыс! Көрініңіз!
Dialogue: 0,0:33:11.99,0:33:14.45,Default,,0,0,0,,О? Таке-сан ше?
Dialogue: 0,0:33:14.53,0:33:16.78,Default,,0,0,0,,Неліктен, неге, неге, неге...
Dialogue: 0,0:33:16.95,0:33:19.16,Default,,0,0,0,,Бұл жолы мені горилла қуып келеді.
Dialogue: 0,0:33:19.28,0:33:20.74,Default,,0,0,0,,Бұл ағайынды төбелес сияқты
Dialogue: 0,0:33:21.37,0:33:23.29,Default,,0,0,0,,Супер қолғаптар
Dialogue: 0,0:33:23.58,0:33:25.58,Default,,0,0,0,,Шизука-чан, сен оны көргің келе ме?
Dialogue: 0,0:33:25.71,0:33:27.42,Default,,0,0,0,,Мен мұны істей аламын ба?
Dialogue: 0,0:33:27.50,0:33:30.46,Default,,0,0,0,,Анашым!
Dialogue: 0,0:33:31.88,0:33:34.42,Default,,0,0,0,,Горилла мырза, мен сіздің қарсыласымын.
Dialogue: 0,0:33:34.51,0:33:36.59,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:33:41.10,0:33:43.89,Default,,0,0,0,,Уаа
Dialogue: 0,0:33:48.40,0:33:49.23,Default,,0,0,0,,Уау
Dialogue: 0,0:33:49.90,0:33:52.69,Default,,0,0,0,,Бұл! анау анау мынау
Dialogue: 0,0:33:52.82,0:33:55.19,Default,,0,0,0,,Хехехехехехе
Dialogue: 0,0:33:56.70,0:33:57.61,Default,,0,0,0,,Иә
Dialogue: 0,0:33:59.62,0:34:01.45,Default,,0,0,0,,Шыу!
Dialogue: 0,0:34:03.62,0:34:04.95,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:34:05.04,0:34:07.96,Default,,0,0,0,,(айқай)
Dialogue: 0,0:34:08.46,0:34:10.79,Default,,0,0,0,,Кешіріңіз, Горилла мырза.
Dialogue: 0,0:34:10.92,0:34:12.59,Default,,0,0,0,,Иә! Шизука-чан
Dialogue: 0,0:34:12.71,0:34:13.92,Default,,0,0,0,,Иә! әйел тарзан
Dialogue: 0,0:34:14.26,0:34:16.88,Default,,0,0,0,,(Сунео мен оның достарының күлкісі)
Dialogue: 0,0:34:20.30,0:34:21.64,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:34:21.76,0:34:23.56,Default,,0,0,0,,А, бұл қызық болды.
Dialogue: 0,0:34:23.68,0:34:25.77,Default,,0,0,0,,Мен бірінші рет осылай толқуым.
Dialogue: 0,0:34:25.85,0:34:27.69,Default,,0,0,0,,Бұл барлау, солай ма?
Dialogue: 0,0:34:27.81,0:34:28.98,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:34:29.10,0:34:30.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:30.98,0:34:33.19,Default,,0,0,0,,Барлау дегеніміз не?
Dialogue: 0,0:34:33.32,0:34:36.19,Default,,0,0,0,,Африка дегеніміз не? Бұл қоқыс.
Dialogue: 0,0:34:36.65,0:34:38.95,Default,,0,0,0,,Енді зерттеймін деп кейіп көрсетуге болмайды.
Dialogue: 0,0:34:39.07,0:34:41.45,Default,,0,0,0,,Бірақ алып мүсіннің сыры...
Dialogue: 0,0:34:41.53,0:34:43.87,Default,,0,0,0,,Бұл қандай тас құдай?
Dialogue: 0,0:34:44.20,0:34:47.00,Default,,0,0,0,,Ешқашан «экспедиция» немесе «сиқырлы патшалық» деп айтпаңыз.
Dialogue: 0,0:34:47.12,0:34:49.87,Default,,0,0,0,,Мен сені жұдырықтай алмаймын!
Dialogue: 0,0:34:50.29,0:34:51.83,Default,,0,0,0,,Бұл өзімшілдік.
Dialogue: 0,0:34:51.96,0:34:55.88,Default,,0,0,0,,Жоқ, мен бүгін өте көңілді болдым.
Dialogue: 0,0:34:56.01,0:34:57.34,Default,,0,0,0,,Міне саған – қоштасу сүйісі.
Dialogue: 0,0:34:57.47,0:34:58.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:34:59.13,0:35:01.80,Default,,0,0,0,,Расымен де, бұл жігіттер кімдер...
Dialogue: 0,0:35:02.22,0:35:03.85,Default,,0,0,0,,(айқай)
Dialogue: 0,0:35:15.11,0:35:16.90,Default,,0,0,0,,Оян
Dialogue: 0,0:35:17.57,0:35:20.57,Default,,0,0,0,,Джанды оят
Dialogue: 0,0:35:21.32,0:35:22.16,Default,,0,0,0,,Әй?
Dialogue: 0,0:35:25.33,0:35:27.58,Default,,0,0,0,,Күрсін... мүмкін бұл менің қиялым шығар?
Dialogue: 0,0:35:29.87,0:35:31.87,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:35:34.29,0:35:36.55,Default,,0,0,0,,Үлкен мүсін! ?
Dialogue: 0,0:35:37.09,0:35:40.01,Default,,0,0,0,,Уф, аа, не болып жатыр?
Dialogue: 0,0:35:40.42,0:35:45.68,Default,,0,0,0,,Ібіліс патшалығын іздеуден оңай бас тартамын деп ойламаппын...
Dialogue: 0,0:35:45.81,0:35:47.47,Default,,0,0,0,,Әлі де еркек пе?
Dialogue: 0,0:35:49.27,0:35:51.94,Default,,0,0,0,,Себебі бұл қызықсыз.
Dialogue: 0,0:35:52.52,0:35:54.69,Default,,0,0,0,,Бұл ешқашан жалықтырмайды
Dialogue: 0,0:35:54.81,0:35:57.65,Default,,0,0,0,,Барғанның зияны жоқ.
Dialogue: 0,0:35:57.78,0:36:01.40,Default,,0,0,0,,Жұмбақты міндетті түрде көресіз
Dialogue: 0,0:36:01.53,0:36:02.91,Default,,0,0,0,,Жұмбақ?
Dialogue: 0,0:36:03.53,0:36:06.78,Default,,0,0,0,,Жүр! батыл бала
Dialogue: 0,0:36:06.91,0:36:10.75,Default,,0,0,0,,Бованконың қазынасын қолдарыңызбен ұстаңыз.
Dialogue: 0,0:36:10.87,0:36:12.46,Default,,0,0,0,,Құдай!
Dialogue: 0,0:36:12.71,0:36:13.75,Default,,0,0,0,,​​О?
Dialogue: 0,0:36:15.00,0:36:16.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:18.21,0:36:20.01,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:36:21.63,0:36:23.63,Default,,0,0,0,,«Садақ Ванко»?
Dialogue: 0,0:36:25.60,0:36:27.72,Default,,0,0,0,,Бованконың қазынасы?
Dialogue: 0,0:36:28.14,0:36:31.43,Default,,0,0,0,,Менің бөлмемде жұмбақ алып мүсін пайда болды...
Dialogue: 0,0:36:31.56,0:36:34.44,Default,,0,0,0,,Ол маған қазына картасын берді.
Dialogue: 0,0:36:34.94,0:36:36.73,Default,,0,0,0,,Африка құдайы?
Dialogue: 0,0:36:36.86,0:36:39.15,Default,,0,0,0,,Саман қағазға фломастермен сызылған.
Dialogue: 0,0:36:39.28,0:36:40.78,Default,,0,0,0,,Бұл жалған
Dialogue: 0,0:36:40.90,0:36:43.11,Default,,0,0,0,,Барлауды тоқтатпадың ба?
Dialogue: 0,0:36:43.20,0:36:48.12,Default,,0,0,0,,Барлауды шешкеннен кейін одан бас тартатын адам әлі де бар ма?
Dialogue: 0,0:36:48.41,0:36:49.87,Default,,0,0,0,,А... бұл әйел.
Dialogue: 0,0:36:49.99,0:36:50.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:51.37,0:36:55.37,Default,,0,0,0,,Бірақ бұл жақсы. Мүмкін бұл алып мүсіннің құпиясын шешер.
Dialogue: 0,0:36:55.50,0:36:56.33,Default,,0,0,0,,Иә
Dialogue: 0,0:36:57.25,0:36:58.71,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:36:59.84,0:37:03.01,Default,,0,0,0,,Олай болса, кешегі тоқтаған жерімізден бастайық.
Dialogue: 0,0:37:03.42,0:37:05.59,Default,,0,0,0,,Ныхх
Dialogue: 0,0:37:05.72,0:37:06.68,Default,,0,0,0,,Дораэмон Ah?
Dialogue: 0,0:37:06.80,0:37:07.97,Default,,0,0,0,,Бұл қандай жаман иіс?
Dialogue: 0,0:37:09.39,0:37:11.93,Default,,0,0,0,,Осы заттарды осында сақтаңыз
Dialogue: 0,0:37:12.02,0:37:13.06,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:37:13.18,0:37:15.39,Default,,0,0,0,,Сізге қауіп төнсе не істеу керек?
Dialogue: 0,0:37:15.98,0:37:18.11,Default,,0,0,0,,Мұндай нәрсеге сүйену ақымақтық болар еді.
Dialogue: 0,0:37:18.23,0:37:21.61,Default,,0,0,0,,Осы білек пен батылдықпен мен қауіпті жеңемін.
Dialogue: 0,0:37:21.86,0:37:24.40,Default,,0,0,0,,Батылдық! ? (Нобита және басқалар) Ах...
Dialogue: 0,0:37:35.04,0:37:37.71,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:37:38.33,0:37:39.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:40.25,0:37:44.09,Default,,0,0,0,,Қарашы, Дораемон, ол бізге айналаны көрсетуге тырысады.
Dialogue: 0,0:37:44.17,0:37:47.47,Default,,0,0,0,,А, бұл рас. Танысқаныма қуаныштымын, Пеко.
Dialogue: 0,0:37:48.30,0:37:50.60,Default,,0,0,0,,Адам әлемінен алыс-
Dialogue: 0,0:37:51.26,0:37:53.56,Default,,0,0,0,,Мен осылай ескі қайықта тербелгенде...
Dialogue: 0,0:37:54.85,0:37:58.77,Default,,0,0,0,,Мен өзімді сенімсіз сезінемін...
Dialogue: 0,0:37:59.90,0:38:01.32,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:38:01.40,0:38:04.28,Default,,0,0,0,,Бұл сезімді айтып жеткізу мүмкін емес.
Dialogue: 0,0:38:04.86,0:38:08.24,Default,,0,0,0,,Мен өзімді Ливингстон немесе Стэнли сияқты сезінемін.
Dialogue: 0,0:38:08.99,0:38:10.28,Default,,0,0,0,,(Сунеоның гуілдеуі)
Dialogue: 0,0:38:10.41,0:38:12.45,Default,,0,0,0,,Эй, Сунео, оны мен үшін сынап көр.
Dialogue: 0,0:38:12.58,0:38:15.16,Default,,0,0,0,,Джиан мұны істей алмайды.
Dialogue: 0,0:38:15.25,0:38:16.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:17.21,0:38:19.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:38:19.83,0:38:22.59,Default,,0,0,0,,Менің руль туралы не ойлайсың?
Dialogue: 0,0:38:22.80,0:38:27.68,Default,,0,0,0,,Алдыңнан үлкен тасты тапты.
Dialogue: 0,0:38:37.73,0:38:39.56,Default,,0,0,0,,А... А?
Dialogue: 0,0:38:40.77,0:38:44.65,Default,,0,0,0,,Бұл өте қорқынышты! Бос жер деп қарасаңыз, қоқыс лақтыратын адамдарды көресіз...
Dialogue: 0,0:38:44.78,0:38:46.99,Default,,0,0,0,,Мен оны есік алдына лақтырып тастаймын деп ойламаппын.
Dialogue: 0,0:38:47.65,0:38:51.45,Default,,0,0,0,,Өзіңізді көршіңізде тұратын адамның орнына қойыңыз.
Dialogue: 0,0:38:54.87,0:38:56.41,Default,,0,0,0,,Ах
Dialogue: 0,0:38:56.70,0:38:58.62,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:38:58.71,0:38:59.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:38:59.46,0:39:00.71,Default,,0,0,0,,Не болды? Шизука-чан
Dialogue: 0,0:39:00.83,0:39:02.63,Default,,0,0,0,,А, мынаны қарашы (Нобита мен оның достары) Иә?
Dialogue: 0,0:39:04.84,0:39:05.96,Default,,0,0,0,,Крокодил!
Dialogue: 0,0:39:06.09,0:39:07.92,Default,,0,0,0,,Мен толығымен қоршалғанмын!
Dialogue: 0,0:39:09.51,0:39:11.39,Default,,0,0,0,,А, бұл қорқынышты
Dialogue: 0,0:39:11.51,0:39:14.35,Default,,0,0,0,,Жарайды, бұл сондай үлкен кеме.
Dialogue: 0,0:39:14.81,0:39:18.31,Default,,0,0,0,,Қараңдар, хехе, солай!
Dialogue: 0,0:39:18.64,0:39:19.89,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:39:20.48,0:39:22.27,Default,,0,0,0,,Уау! Ол қандай нәрсе?
Dialogue: 0,0:39:22.40,0:39:23.44,Default,,0,0,0,,Тамаша жұмыс
Dialogue: 0,0:39:23.56,0:39:25.86,Default,,0,0,0,,Әй, тамаша құмырасы! Хмф!
Dialogue: 0,0:39:26.15,0:39:27.69,Default,,0,0,0,,Ах, Джан, Каджи ше?
Dialogue: 0,0:39:27.82,0:39:29.28,Default,,0,0,0,,Не? (Нобита және басқалар) Ах!
Dialogue: 0,0:39:34.78,0:39:37.16,Default,,0,0,0,,(үшін айқайлайды)
Dialogue: 0,0:39:38.04,0:39:41.54,Default,,0,0,0,,...
Dialogue: 0,0:39:41.67,0:39:43.33,Default,,0,0,0,,Не? Гах!
Dialogue: 0,0:39:43.63,0:39:46.38,Default,,0,0,0,,Зақымдалған Кеменің түбі зақымдалған.
Dialogue: 0,0:39:47.46,0:39:50.09,Default,,0,0,0,,Жоқ, одан сайын батып барады
Dialogue: 0,0:39:50.59,0:39:53.14,Default,,0,0,0,,Уау...жөндеу мүмкін емес.
Dialogue: 0,0:39:53.84,0:39:56.43,Default,,0,0,0,,Уау, маған көмектес!
Dialogue: 0,0:39:57.52,0:39:59.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:59.89,0:40:02.02,Default,,0,0,0,,Бұл! Уау
Dialogue: 0,0:40:02.27,0:40:04.02,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:40:04.15,0:40:05.73,Default,,0,0,0,,Сунео-сан (Сунео) Ах.
Dialogue: 0,0:40:06.07,0:40:07.65,Default,,0,0,0,,Шизука-чан
Dialogue: 0,0:40:07.78,0:40:09.19,Default,,0,0,0,,Мықты
Dialogue: 0,0:40:10.53,0:40:12.99,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:40:13.66,0:40:15.16,Default,,0,0,0,,О, жоқ болып кетті.
Dialogue: 0,0:40:16.53,0:40:19.79,Default,,0,0,0,,Бұл! Мынау... аа
Dialogue: 0,0:40:20.29,0:40:22.50,Default,,0,0,0,,Джан Секіру!
Dialogue: 0,0:40:23.25,0:40:24.96,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:40:25.08,0:40:26.71,Default,,0,0,0,,Ааа (Нобита) Джан!
Dialogue: 0,0:40:26.92,0:40:28.21,Default,,0,0,0,,Уф
Dialogue: 0,0:40:29.26,0:40:31.17,Default,,0,0,0,,Сіз жеуге шыдай аласыз ба?
Dialogue: 0,0:40:31.55,0:40:35.14,Default,,0,0,0,,Осы жылдамдықпен сізді қолтырауын жеп қояды!
Dialogue: 0,0:40:35.76,0:40:38.14,Default,,0,0,0,,Дораэмон Момотаро таңбаланған тары тұшпара
Dialogue: 0,0:40:38.26,0:40:39.27,Default,,0,0,0,,Мен оны тастап кеттім.
Dialogue: 0,0:40:39.39,0:40:42.73,Default,,0,0,0,,Содан кейін Баспропеллер Shock Gun Super Gloves пневматикалық зеңбірегі
Dialogue: 0,0:40:42.85,0:40:45.10,Default,,0,0,0,,Әркім, бәрі, артта қалды!
Dialogue: 0,0:40:45.60,0:40:47.73,Default,,0,0,0,,...
Dialogue: 0,0:40:47.86,0:40:49.11,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:40:49.36,0:40:53.07,Default,,0,0,0,,Оны енді байқамайсың... Барлық жерде есіктер!
Dialogue: 0,0:40:53.70,0:40:55.32,Default,,0,0,0,,А... бұл?
Dialogue: 0,0:40:55.41,0:40:56.41,Default,,0,0,0,,Барлық жерде есік бар ма?
Dialogue: 0,0:40:56.49,0:40:58.08,Default,,0,0,0,,Тек тұтқасы бар!
Dialogue: 0,0:40:58.16,0:40:59.41,Default,,0,0,0,,Корольдің тұғырын басып алу
Dialogue: 0,0:40:59.83,0:41:03.50,Default,,0,0,0,,Нухахаха ше? Куро, бұл шарасыз жағдай.
Dialogue: 0,0:41:03.62,0:41:05.25,Default,,0,0,0,,(Куроның айқайы)
Dialogue: 0,0:41:05.58,0:41:06.75,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:41:06.88,0:41:08.38,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:41:09.42,0:41:10.80,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:41:10.88,0:41:11.80,Default,,0,0,0,,Нобита!
Dialogue: 0,0:41:11.96,0:41:13.38,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:41:14.59,0:41:15.59,Default,,0,0,0,,Пеко!
Dialogue: 0,0:41:18.60,0:41:20.39,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:41:20.64,0:41:22.56,Default,,0,0,0,,Әй, Пеко!
Dialogue: 0,0:41:26.85,0:41:28.73,Default,,0,0,0,,Қаш, Пеко! Қауіп!
Dialogue: 0,0:41:35.24,0:41:36.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:41:36.86,0:41:38.07,Default,,0,0,0,,А, солай.
Dialogue: 0,0:41:38.20,0:41:39.16,Default,,0,0,0,,Олар болашақта бізден тағы да көп нәрсені тартып алады.
Dialogue: 0,0:41:42.62,0:41:47.63,Default,,0,0,0,,(Музыка)
Dialogue: 0,0:41:59.60,0:42:00.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:03.02,0:42:04.81,Default,,0,0,0,,Ва... қолтырауын! ?
Dialogue: 0,0:42:05.14,0:42:06.14,Default,,0,0,0,,Иә
Dialogue: 0,0:42:06.27,0:42:08.94,Default,,0,0,0,,Бүгін маған қауіпті жерде көмектескеніңіз үшін рахмет.
Dialogue: 0,0:42:09.06,0:42:12.48,Default,,0,0,0,,Не керек, сондай үлкен той жасадыңыз...
Dialogue: 0,0:42:12.61,0:42:14.99,Default,,0,0,0,,Сізге алғысымды айта алмаймын.
Dialogue: 0,0:42:15.11,0:42:18.61,Default,,0,0,0,,Малка Бали Либани Такос Даморка
Dialogue: 0,0:42:18.74,0:42:19.70,Default,,0,0,0,,Не? Сегізаяқ?
Dialogue: 0,0:42:21.66,0:42:23.70,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:42:24.25,0:42:26.41,Default,,0,0,0,,Хоньяку Коньяку
Dialogue: 0,0:42:27.37,0:42:30.04,Default,,0,0,0,,Курумбабоэ Оэоебудангга
Dialogue: 0,0:42:30.17,0:42:33.63,Default,,0,0,0,,Малка Бали Либани Такос Даморка
Dialogue: 0,0:42:34.26,0:42:38.43,Default,,0,0,0,,«Бүгін киелі құдайдың мейрамы, сондықтан ас ішіңіздер».
Dialogue: 0,0:42:38.55,0:42:41.26,Default,,0,0,0,,Тексеру... Құттықтау кеші емес пе еді?
Dialogue: 0,0:42:41.39,0:42:42.60,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:42:42.72,0:42:44.56,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:42:44.64,0:42:47.89,Default,,0,0,0,,Элида Бованко
Dialogue: 0,0:42:48.44,0:42:49.94,Default,,0,0,0,,Садақ ит? (Нобита) А?
Dialogue: 0,0:42:50.06,0:42:51.52,Default,,0,0,0,,Уау, а... бұл!
Dialogue: 0,0:42:53.11,0:42:54.53,Default,,0,0,0,,Спутниктік фотосурет
Dialogue: 0,0:42:54.65,0:42:56.03,Default,,0,0,0,,Түсімде пайда болды
Dialogue: 0,0:42:56.32,0:42:57.78,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:42:57.90,0:43:00.99,Default,,0,0,0,,Бұл жердегі адамдар садақ тіккендерді бұрын да көрген.
Dialogue: 0,0:43:01.12,0:43:03.62,Default,,0,0,0,,Жақын жерде алып мүсін болуы керек.
Dialogue: 0,0:43:03.74,0:43:04.99,Default,,0,0,0,,Соль (Нобита және т.б.) Ах
Dialogue: 0,0:43:05.58,0:43:08.71,Default,,0,0,0,,Морба Бауванко Сем Семдари
Dialogue: 0,0:43:09.67,0:43:13.42,Default,,0,0,0,,«Бованко құдайымен кездесу үшін үш адам қажет».
Dialogue: 0,0:43:13.54,0:43:14.92,Default,,0,0,0,,Үш өмір?
Dialogue: 0,0:43:15.30,0:43:19.80,Default,,0,0,0,,«Сіз саваннаға барсаңыз, азу патшалары жеті есе көп болады».
Dialogue: 0,0:43:19.93,0:43:23.10,Default,,0,0,0,,«Бұл жерде бір өмір жоғалды».
Dialogue: 0,0:43:23.76,0:43:28.60,Default,,0,0,0,,«Одрондро аңғары, мөлдір жартастар, өлілер елі»
Dialogue: 0,0:43:28.73,0:43:31.90,Default,,0,0,0,,«Тағы бір өлім»
Dialogue: 0,0:43:32.48,0:43:35.90,Default,,0,0,0,,«Мәңгілік тұманға оранған Құдай Патшалығының арғы жағында».
Dialogue: 0,0:43:36.03,0:43:38.90,Default,,0,0,0,,«Егер сен кірсең, ешқашан тірі оралмайсың».
Dialogue: 0,0:43:39.15,0:43:42.03,Default,,0,0,0,,«Үшінші өміріңді жоғалтты»
Dialogue: 0,0:43:42.16,0:43:44.16,Default,,0,0,0,,Бұл соншалықты қорқынышты болды ма?
Dialogue: 0,0:43:44.24,0:43:45.83,Default,,0,0,0,,Үйге қайтайық?
Dialogue: 0,0:43:46.70,0:43:49.54,Default,,0,0,0,,Не, не, шала
Dialogue: 0,0:43:49.66,0:43:51.62,Default,,0,0,0,,Мен ырымдардан қорықпаймын
Dialogue: 0,0:43:51.96,0:43:54.63,Default,,0,0,0,,Бұл сен іздеген ұлы жын.
Dialogue: 0,0:43:54.75,0:43:57.84,Default,,0,0,0,,Бовванко құдайымен кездесіп, қазынаға ие болыңыз!
Dialogue: 0,0:43:57.96,0:43:59.09,Default,,0,0,0,,Соны айт!
Dialogue: 0,0:43:59.21,0:44:00.88,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:44:01.01,0:44:05.47,Default,,0,0,0,,Каминеба Курумба М. М. Бауванко Виллазубадонга
Dialogue: 0,0:44:05.60,0:44:07.22,Default,,0,0,0,,Ой
Dialogue: 0,0:44:07.47,0:44:08.31,Default,,0,0,0,,Ой
Dialogue: 0,0:44:08.39,0:44:11.31,Default,,0,0,0,,Раушан гүлдер! Роза! Роза! Роза!
Dialogue: 0,0:44:11.77,0:44:14.77,Default,,0,0,0,,Не? Не? (Нобита) Не болып жатыр?
Dialogue: 0,0:44:15.52,0:44:17.23,Default,,0,0,0,,«Құдайдан қорықпайтындар»
Dialogue: 0,0:44:17.36,0:44:20.44,Default,,0,0,0,,«Осы ауылға апат келмей тұрып кет!»
Dialogue: 0,0:44:20.57,0:44:21.78,Default,,0,0,0,,«Әйтпесе...»
Dialogue: 0,0:44:23.11,0:44:24.74,Default,,0,0,0,,Ахх... «Міне, солай!»
Dialogue: 0,0:44:25.03,0:44:28.41,Default,,0,0,0,,(Дораэмонның айқайы)
Dialogue: 0,0:44:31.58,0:44:34.08,Default,,0,0,0,,Мен құтқарылдым деп ойладым.
Dialogue: 0,0:44:34.21,0:44:36.21,Default,,0,0,0,,Бір қорқынышты нәрсе болды.
Dialogue: 0,0:44:36.34,0:44:39.30,Default,,0,0,0,,Ой, қандай дауыс?
Dialogue: 0,0:44:39.42,0:44:40.59,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:44:40.67,0:44:43.22,Default,,0,0,0,,Түнде джунглиде серуендеу қауіпті.
Dialogue: 0,0:44:43.34,0:44:45.09,Default,,0,0,0,,Бүгін осында лагерь жасайық.
Dialogue: 0,0:44:45.22,0:44:46.10,Default,,0,0,0,,​​О?
Dialogue: 0,0:44:46.47,0:44:47.81,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:44:51.06,0:44:52.77,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:44:52.89,0:44:53.98,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:44:54.77,0:44:57.23,Default,,0,0,0,,Жабайы аңдардың алдын алу үшін -
Dialogue: 0,0:44:57.98,0:44:59.98,Default,,0,0,0,,Кіреберіс жоғарғы жағында.
Dialogue: 0,0:45:00.36,0:45:02.40,Default,,0,0,0,,Бұл құпия құрал болды ма?
Dialogue: 0,0:45:02.53,0:45:04.99,Default,,0,0,0,,Дораемоннан күткендей.
Dialogue: 0,0:45:05.24,0:45:08.33,Default,,0,0,0,,Қызық, монша да бар ма? Уууу
Dialogue: 0,0:45:12.79,0:45:16.88,Default,,0,0,0,,Әрқайсысында кереует пен дәретхана бар бес шағын бөлме бар.
Dialogue: 0,0:45:17.58,0:45:19.17,Default,,0,0,0,,Жуынатын бөлме жоқ, солай ма?
Dialogue: 0,0:45:19.29,0:45:20.71,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:45:20.84,0:45:22.46,Default,,0,0,0,,Рамен кеспесін де жасайық!
Dialogue: 0,0:45:22.59,0:45:24.05,Default,,0,0,0,,Ұнады! келісім!
Dialogue: 0,0:45:24.13,0:45:28.01,Default,,0,0,0,,Жоқ, далаға шықпаңыз. Ертеңгі таңға дейін күтейік.
Dialogue: 0,0:45:28.26,0:45:30.18,Default,,0,0,0,,Күлсін, мен үйде болсам...
Dialogue: 0,0:45:30.31,0:45:32.43,Default,,0,0,0,,Жылы күріш ыдысы және салқын желато.
Dialogue: 0,0:45:32.56,0:45:34.77,Default,,0,0,0,,Мен оны жеуге болар едім~
Dialogue: 0,0:45:34.98,0:45:36.98,Default,,0,0,0,,Біз не боламыз?
Dialogue: 0,0:45:37.10,0:45:38.23,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:45:38.36,0:45:41.32,Default,,0,0,0,,Сіз барлық пайдалы құралдарды қалдырдыңыз.
Dialogue: 0,0:45:41.44,0:45:44.36,Default,,0,0,0,,Неліктен мен мұндай ақылсыз сапарға шықтым?
Dialogue: 0,0:45:45.74,0:45:47.45,Default,,0,0,0,,Бұл менің кінәм!
Dialogue: 0,0:45:47.57,0:45:49.99,Default,,0,0,0,,Оны ешкім айтқан жоқ.
Dialogue: 0,0:45:50.12,0:45:50.99,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:45:51.58,0:45:53.83,Default,,0,0,0,,Айтпасаң да бетінде жазылған
Dialogue: 0,0:45:53.95,0:45:56.50,Default,,0,0,0,,«Бұл сенің кінәң, бұл сенің кінәң»
Dialogue: 0,0:45:57.04,0:46:00.46,Default,,0,0,0,,Дұрыс, бұл экспедицияны жоспарлаған мен болдым.
Dialogue: 0,0:46:00.59,0:46:02.38,Default,,0,0,0,,Құрал-саймандарды қалдырған мен едім.
Dialogue: 0,0:46:02.80,0:46:06.13,Default,,0,0,0,,Кеме суға батты, ауыл қуылды...
Dialogue: 0,0:46:06.26,0:46:08.39,Default,,0,0,0,,Бәріне мен кінәлімін!
Dialogue: 0,0:46:09.39,0:46:13.56,Default,,0,0,0,,Мен бәрібір жек көретін адаммын.
Dialogue: 0,0:46:16.02,0:46:17.23,Default,,0,0,0,,Такеши мырза!
Dialogue: 0,0:46:17.35,0:46:21.82,Default,,0,0,0,,Сіз қалай ойлайсыз? Осындай көзқараспен сіз өзіңіз қалаған нәрсені жасайсыз.
Dialogue: 0,0:46:21.94,0:46:23.57,Default,,0,0,0,,Хотоко Хоттоко
Dialogue: 0,0:46:25.61,0:46:28.41,Default,,0,0,0,,Пеко, бірге ұйықтайық.
Dialogue: 0,0:46:29.91,0:46:31.78,Default,,0,0,0,,Қайда кетті?
Dialogue: 0,0:46:43.09,0:46:44.17,Default,,0,0,0,,Хмм
Dialogue: 0,0:46:48.59,0:46:50.01,Default,,0,0,0,,Пеко
Dialogue: 0,0:46:50.14,0:46:51.72,Default,,0,0,0,,(айқай)
Dialogue: 0,0:46:57.31,0:46:59.56,Default,,0,0,0,,Пеко!
Dialogue: 0,0:47:00.35,0:47:03.36,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:47:04.15,0:47:07.11,Default,,0,0,0,,(Джианның айқайы)
Dialogue: 0,0:47:16.12,0:47:19.33,Default,,0,0,0,,Карта бойынша бұл саваннадан ары...
Dialogue: 0,0:47:19.46,0:47:22.00,Default,,0,0,0,,Ауыр темекі шегетін орман болуы керек.
Dialogue: 0,0:47:22.13,0:47:23.46,Default,,0,0,0,,Ол кең.
Dialogue: 0,0:47:23.75,0:47:25.92,Default,,0,0,0,,«Азу патша өмірінен айырылды»
Dialogue: 0,0:47:26.05,0:47:27.26,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:47:27.38,0:47:29.13,Default,,0,0,0,,Әйтеуір, алға ұмтылайық
Dialogue: 0,0:47:29.26,0:47:32.30,Default,,0,0,0,,Алып мүсіннің жанында адамдар тұруы мүмкін.
Dialogue: 0,0:47:32.43,0:47:35.56,Default,,0,0,0,,Мен сонда жетсем деп едім.
Dialogue: 0,0:47:39.43,0:47:41.35,Default,,0,0,0,,(Пеко қабығы)
Dialogue: 0,0:47:42.10,0:47:43.77,Default,,0,0,0,,Не болды? Пеко
Dialogue: 0,0:47:43.90,0:47:45.82,Default,,0,0,0,,А, мынаны қараңыз.
Dialogue: 0,0:47:47.07,0:47:49.82,Default,,0,0,0,,Керемет, бұл пілдер үйірі.
Dialogue: 0,0:47:49.90,0:47:54.20,Default,,0,0,0,,Не, Азу патшасы пілді меңзеп тұр?
Dialogue: 0,0:47:54.32,0:47:56.29,Default,,0,0,0,,Уау, бұл үлкен.
Dialogue: 0,0:47:56.37,0:47:59.50,Default,,0,0,0,,Сүйкімді пілдің баласы.
Dialogue: 0,0:47:59.71,0:48:01.29,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:48:02.17,0:48:05.63,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:48:08.13,0:48:11.47,Default,,0,0,0,,(айқай)
Dialogue: 0,0:48:14.22,0:48:16.64,Default,,0,0,0,,Не? Не? Қызық, не болды?
Dialogue: 0,0:48:17.06,0:48:18.10,Default,,0,0,0,,Әй?
Dialogue: 0,0:48:22.02,0:48:25.86,Default,,0,0,0,,Ра... Бұл арыстан! Жүгіріп кету!
Dialogue: 0,0:48:25.98,0:48:26.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:48:27.36,0:48:29.61,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:48:29.86,0:48:31.90,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:48:33.32,0:48:35.99,Default,,0,0,0,,Азу патшасы арыстанға сілтеме жасады ма?
Dialogue: 0,0:48:36.12,0:48:39.08,Default,,0,0,0,,Хмммм аа
Dialogue: 0,0:48:40.70,0:48:41.83,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:48:41.96,0:48:43.87,Default,,0,0,0,,Арғы бетке жүгірейік
Dialogue: 0,0:48:44.29,0:48:45.67,Default,,0,0,0,,Ах! Ахх
Dialogue: 0,0:48:45.79,0:48:48.59,Default,,0,0,0,,Аа, кетті. Мен қоршалғанмын.
Dialogue: 0,0:48:49.50,0:48:51.38,Default,,0,0,0,,Артық емес...
Dialogue: 0,0:48:52.13,0:48:54.80,Default,,0,0,0,,үшінңыз, күресуді жалғастырыңыз және ешқашан берілмеңіз.
Dialogue: 0,0:48:54.89,0:48:57.60,Default,,0,0,0,,Арыстанмен қалай күресесіңдер?
Dialogue: 0,0:48:57.72,0:48:58.56,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:48:59.68,0:49:01.06,Default,,0,0,0,,Ах (Нобита) Пеко
Dialogue: 0,0:49:01.48,0:49:03.02,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:49:03.64,0:49:05.02,Default,,0,0,0,,Джан! Такеши мырза!
Dialogue: 0,0:49:06.36,0:49:09.11,Default,,0,0,0,,Эй, мұнда кел!
Dialogue: 0,0:49:13.49,0:49:14.49,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:49:19.03,0:49:20.37,Default,,0,0,0,,Уау
Dialogue: 0,0:49:21.29,0:49:23.33,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:49:23.66,0:49:24.79,Default,,0,0,0,,Джан!
Dialogue: 0,0:49:26.75,0:49:27.83,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:49:27.92,0:49:29.46,Default,,0,0,0,,Уккуку…
Dialogue: 0,0:49:30.50,0:49:32.26,Default,,0,0,0,,Ууу... аааа
Dialogue: 0,0:49:33.42,0:49:37.18,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:49:41.43,0:49:42.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:47.60,0:49:49.19,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:49:49.77,0:49:53.24,Default,,0,0,0,,Неліктен Бовванко құдайы осындай жерде?
Dialogue: 0,0:49:58.37,0:49:59.62,Default,,0,0,0,,Ол бұзылды!
Dialogue: 0,0:49:59.74,0:50:01.41,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:50:03.95,0:50:05.41,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:50:12.92,0:50:14.63,Default,,0,0,0,,Амансың ба? Джан
Dialogue: 0,0:50:16.68,0:50:19.55,Default,,0,0,0,,Патшалыққа жол ашық
Dialogue: 0,0:50:19.68,0:50:23.10,Default,,0,0,0,,Алға, балалар.
Dialogue: 0,0:50:24.68,0:50:26.81,Default,,0,0,0,,Уау, жоғалып барады
Dialogue: 0,0:50:27.06,0:50:28.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:28.85,0:50:30.27,Default,,0,0,0,,Ах
Dialogue: 0,0:50:30.65,0:50:32.86,Default,,0,0,0,,(Пеко қабығы)
Dialogue: 0,0:50:32.98,0:50:34.48,Default,,0,0,0,,Пеко!
Dialogue: 0,0:50:35.28,0:50:38.66,Default,,0,0,0,,Хахаха Пеко, жақсы болдыңыз ба?
Dialogue: 0,0:50:39.03,0:50:40.62,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:50:40.99,0:50:41.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:42.24,0:50:43.54,Default,,0,0,0,,Не болды?
Dialogue: 0,0:50:43.66,0:50:47.08,Default,,0,0,0,,Енді Пеко дәл алып мүсінге ұқсайды.
Dialogue: 0,0:50:47.21,0:50:48.50,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:50:48.62,0:50:51.08,Default,,0,0,0,,Қызық, оған қатысы бар ма? иә?
Dialogue: 0,0:50:51.21,0:50:52.96,Default,,0,0,0,,Біреуі болуы мүмкін емес.
Dialogue: 0,0:50:53.34,0:50:55.05,Default,,0,0,0,,Тағы не істеуіміз керек?
Dialogue: 0,0:50:55.17,0:50:56.59,Default,,0,0,0,,Патшалыққа қалай жетуге болады
Dialogue: 0,0:50:56.72,0:50:59.97,Default,,0,0,0,,Маған тағы екі рет өлу керек.
Dialogue: 0,0:51:00.39,0:51:04.10,Default,,0,0,0,,Ештеңе етпейді, алға ұмтылудан басқа амалымыз жоқ.
Dialogue: 0,0:51:04.22,0:51:05.85,Default,,0,0,0,,Қалай ойлайсың, Шизука-чан?
Dialogue: 0,0:51:06.06,0:51:08.69,Default,,0,0,0,,Аа, мені уайымдағаны...
Dialogue: 0,0:51:08.81,0:51:09.77,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:51:09.90,0:51:13.36,Default,,0,0,0,,Сол патшалықтың моншасы бар ма?
Dialogue: 0,0:51:13.77,0:51:15.19,Default,,0,0,0,,Онда?
Dialogue: 0,0:51:15.65,0:51:17.49,Default,,0,0,0,,Маған демалыс беріңіз.
Dialogue: 0,0:51:17.61,0:51:20.32,Default,,0,0,0,,Мен Джанкунның пікірін де естігім келеді.
Dialogue: 0,0:51:20.45,0:51:22.87,Default,,0,0,0,,Көптен бері үнсіз жүрген сияқтысың.
Dialogue: 0,0:51:23.03,0:51:24.66,Default,,0,0,0,,А? О, тәңірім
Dialogue: 0,0:51:28.33,0:51:30.79,Default,,0,0,0,,Такеши мырза, сіз адам ретінде мүлдем өзгерген сияқтысыз.
Dialogue: 0,0:51:30.92,0:51:32.79,Default,,0,0,0,,Жоқ, мен құрттарды алып жатырмын.
Dialogue: 0,0:51:32.92,0:51:34.67,Default,,0,0,0,,Біртүрлі нәрсе!
Dialogue: 0,0:51:34.75,0:51:35.63,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:51:35.75,0:51:39.30,Default,,0,0,0,,Маған оның қандай патшалық екені маңызды емес, мен ол жерге тезірек жеткім келеді.
Dialogue: 0,0:51:44.22,0:51:46.77,Default,,0,0,0,,Пойыздың арқанына ұқсаңыз!
Dialogue: 0,0:51:48.18,0:51:51.19,Default,,0,0,0,,Бұл тамаша емес, пойыз ойнау.
Dialogue: 0,0:51:51.31,0:51:55.02,Default,,0,0,0,,Жақсы болмаса да, пойыз сияқты жылдам жүре алады.
Dialogue: 0,0:51:55.11,0:51:57.53,Default,,0,0,0,,Уау, таңғажайып жартас
Dialogue: 0,0:51:57.65,0:52:01.40,Default,,0,0,0,,Алқап түбі өлі рухтар елі екеніне сенімдімін.
Dialogue: 0,0:52:04.74,0:52:07.70,Default,,0,0,0,,Ақырында, төмен түсуден басқа амалым жоқ.
Dialogue: 0,0:52:07.83,0:52:09.75,Default,,0,0,0,,Ең жақсы қамыр кім? (Сунео) Гику
Dialogue: 0,0:52:10.04,0:52:12.00,Default,,0,0,0,,Мен соңғысы боламын деп ойлаймын
Dialogue: 0,0:52:12.12,0:52:13.71,Default,,0,0,0,,Сунео-кун, бірінші бар.
Dialogue: 0,0:52:13.83,0:52:16.67,Default,,0,0,0,,Жоқ, жоқ, жоқ, Нобита-кун, бірінші бар.
Dialogue: 0,0:52:16.75,0:52:18.80,Default,,0,0,0,,Ұстаудың қажеті болмаса (Сунео), онда бұл туралы абай болу керек.
Dialogue: 0,0:52:18.92,0:52:21.47,Default,,0,0,0,,Қойыңыз (Нобита) Иә?
Dialogue: 0,0:52:21.72,0:52:23.30,Default,,0,0,0,,Джан! Такеши мырза!
Dialogue: 0,0:52:25.76,0:52:27.18,Default,,0,0,0,,Джиан күткендей
Dialogue: 0,0:52:27.31,0:52:29.39,Default,,0,0,0,,Сізде батылдық бар.
Dialogue: 0,0:52:30.81,0:52:32.23,Default,,0,0,0,,Ах
Dialogue: 0,0:52:32.35,0:52:34.73,Default,,0,0,0,,Ааа!
Dialogue: 0,0:52:34.81,0:52:35.90,Default,,0,0,0,,Джан!
Dialogue: 0,0:52:36.23,0:52:38.86,Default,,0,0,0,,Ах! Ол жерде тұрып қалды!
Dialogue: 0,0:52:38.94,0:52:40.49,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:52:40.61,0:52:41.78,Default,,0,0,0,,Уау
Dialogue: 0,0:52:41.86,0:52:44.11,Default,,0,0,0,,Тез, тез, тез...
Dialogue: 0,0:52:44.24,0:52:47.08,Default,,0,0,0,,А, сондықтан мен барлық пайдалы құралдарымды тастап кеттім.
Dialogue: 0,0:52:47.37,0:52:50.83,Default,,0,0,0,,Уа, күте тұрыңыз, бұл жұмыс істеуі мүмкін.
Dialogue: 0,0:52:50.95,0:52:52.96,Default,,0,0,0,,Гравитациялық бояу
Dialogue: 0,0:52:53.33,0:52:56.00,Default,,0,0,0,,Мұны қолданған кезде боялған аймақ төменгі жағында болады. Мысалы...
Dialogue: 0,0:52:56.13,0:52:57.50,Default,,0,0,0,,Жақсы түсініктеме! Дора-чан!
Dialogue: 0,0:53:03.97,0:53:07.60,Default,,0,0,0,,Бояу жолынан адасып кетсең, дұрыс емес жерде боласың.
Dialogue: 0,0:53:08.10,0:53:10.85,Default,,0,0,0,,Токио мұнарасынан биік көрінеді
Dialogue: 0,0:53:10.97,0:53:12.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:53:14.35,0:53:18.06,Default,,0,0,0,,Уа, ау, әй...
Dialogue: 0,0:53:19.61,0:53:21.53,Default,,0,0,0,,Бояу таусылды
Dialogue: 0,0:53:23.24,0:53:25.36,Default,,0,0,0,,Қараңғы жер екен.
Dialogue: 0,0:53:25.49,0:53:28.12,Default,,0,0,0,,Бұл шынымен де өлілер елі.
Dialogue: 0,0:53:28.24,0:53:30.49,Default,,0,0,0,,Арғы беттегі жартасқа тез көтерілейік.
Dialogue: 0,0:53:31.58,0:53:33.41,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:53:33.54,0:53:34.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:53:35.04,0:53:36.42,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:53:36.54,0:53:37.96,Default,,0,0,0,,Тастар ыңылдап жатыр
Dialogue: 0,0:53:38.42,0:53:40.46,Default,,0,0,0,,Күдікті жарық Күдікті дауыс
Dialogue: 0,0:53:40.59,0:53:42.38,Default,,0,0,0,,Өлі рухтар бар ғой!
Dialogue: 0,0:53:44.38,0:53:48.18,Default,,0,0,0,,(үшін айқайлайды)
Dialogue: 0,0:53:48.39,0:53:49.93,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:53:50.93,0:53:51.77,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:53:54.27,0:53:56.60,Default,,0,0,0,,Ой, бейбақ, бейбақ.
Dialogue: 0,0:53:57.73,0:53:59.81,Default,,0,0,0,,Керемет! Шаң болды
Dialogue: 0,0:53:59.94,0:54:01.15,Default,,0,0,0,,Уау, олар керемет көрінеді!
Dialogue: 0,0:54:01.86,0:54:04.07,Default,,0,0,0,,Джиан мықты ғой.
Dialogue: 0,0:54:04.19,0:54:05.40,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:54:05.53,0:54:07.66,Default,,0,0,0,,Біз адамды ұстадық (Нобита мен оның достары) Иә! ?
Dialogue: 0,0:54:10.83,0:54:16.08,Default,,0,0,0,,Бұл шымтезек тәрізді кішкентай жәндік, оған люминесцентті бактериялар жабысады.
Dialogue: 0,0:54:16.21,0:54:19.58,Default,,0,0,0,,Жарайды, түрді білген соң, оңай.
Dialogue: 0,0:54:19.96,0:54:21.96,Default,,0,0,0,,Өлгендердің дауысы да солай.
Dialogue: 0,0:54:22.09,0:54:25.01,Default,,0,0,0,,Мен ғылыми түсініктеме бар екеніне сенімдімін.
Dialogue: 0,0:54:25.09,0:54:26.38,Default,,0,0,0,,Ммммм... (ыңылдап)
Dialogue: 0,0:54:26.51,0:54:28.47,Default,,0,0,0,,Гах! Ыстық, ыстық...
Dialogue: 0,0:54:28.59,0:54:30.22,Default,,0,0,0,,Амансың ба? Сунео мырза
Dialogue: 0,0:54:30.35,0:54:32.72,Default,,0,0,0,,Иә, бірақ мен түсіндім (Нобита және басқалар) Иә?
Dialogue: 0,0:54:33.14,0:54:35.14,Default,,0,0,0,,Бұл аймақ жанартаулық аймақ.
Dialogue: 0,0:54:35.27,0:54:38.69,Default,,0,0,0,,Сондықтан кейде жер астынан бу шығады.
Dialogue: 0,0:54:39.19,0:54:44.65,Default,,0,0,0,,Шұңқырға толы жартас жаңғырып, дыбыс шығаратын флейта сияқты принцип.
Dialogue: 0,0:54:44.73,0:54:46.15,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:54:46.28,0:54:47.32,Default,,0,0,0,,Сунео күткендей
Dialogue: 0,0:54:47.45,0:54:48.53,Default,,0,0,0,,Сәнді дизайнерлік аяқ киім алу үшін жинап жүрген 20 000 йенім...
Dialogue: 0,0:54:48.66,0:54:50.57,Default,,0,0,0,,Әй?
Dialogue: 0,0:54:50.91,0:54:52.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:54:54.58,0:54:58.00,Default,,0,0,0,,Жарайсың, мен күткен барлық адамдар күткендей.
Dialogue: 0,0:54:58.08,0:55:02.04,Default,,0,0,0,,Ахх... Пеко сөйледі!
Dialogue: 0,0:55:04.34,0:55:06.55,Default,,0,0,0,,Мен сені шошытқым келмеді.
Dialogue: 0,0:55:06.67,0:55:10.47,Default,,0,0,0,,Мен саған ертерек айтып, сенен көмек сұрауым керек еді.
Dialogue: 0,0:55:10.84,0:55:11.93,Default,,0,0,0,,Тұр! ?
Dialogue: 0,0:55:12.60,0:55:15.72,Default,,0,0,0,,Мен болған жағдайды айтсам да, олар маған сенеді деп ойламадым...
Dialogue: 0,0:55:15.85,0:55:19.39,Default,,0,0,0,,Өз көзіңізбен көруіңізге мүмкіндік беріп, осы уақытқа дейін жеттік.
Dialogue: 0,0:55:19.77,0:55:23.11,Default,,0,0,0,,Пеко, сен кімсің?
Dialogue: 0,0:55:23.48,0:55:28.07,Default,,0,0,0,,Мен князь Кунтакпын, 108-ші король Бауванконың ұлымын.
Dialogue: 0,0:55:28.78,0:55:30.07,Default,,0,0,0,,Ханзада?
Dialogue: 0,0:55:30.20,0:55:31.53,Default,,0,0,0,,Боу ванконың баласы?
Dialogue: 0,0:55:31.99,0:55:33.99,Default,,0,0,0,,Мен белгілі бір себептермен Жапонияға бардым...
Dialogue: 0,0:55:34.12,0:55:37.50,Default,,0,0,0,,үшінңызға рахмет, біз осы уақытқа дейін жеттік.
Dialogue: 0,0:55:37.75,0:55:39.96,Default,,0,0,0,,Сонда әлгі алып мүсін ше?
Dialogue: 0,0:55:40.58,0:55:44.17,Default,,0,0,0,,Бұл патшалықтың негізін салған король Бауванко I мүсіні.
Dialogue: 0,0:55:44.29,0:55:46.42,Default,,0,0,0,,Осы асыл таспен бейнеленген
Dialogue: 0,0:55:52.84,0:55:53.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:55:54.05,0:55:55.81,Default,,0,0,0,,Бұл голограмма сияқты...
Dialogue: 0,0:55:55.93,0:55:56.85,Default,,0,0,0,,Бұл сәл басқаша.
Dialogue: 0,0:55:57.77,0:56:01.19,Default,,0,0,0,,Бұл әшекей патша әулетінде ұрпақтан-ұрпаққа беріліп отырды.
Dialogue: 0,0:56:01.31,0:56:04.31,Default,,0,0,0,,Алып мүсіннің әрбір қимылы жазылады.
Dialogue: 0,0:56:04.56,0:56:08.99,Default,,0,0,0,,Керемет! адамзат өркениетінен әлдеқайда озық
Dialogue: 0,0:56:09.11,0:56:12.32,Default,,0,0,0,,Бұл патшалықтың да гүлденгенін білдіре ме?
Dialogue: 0,0:56:12.91,0:56:15.33,Default,,0,0,0,,Өкінішке орай, олай емес.
Dialogue: 0,0:56:15.45,0:56:16.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:16.87,0:56:20.00,Default,,0,0,0,,Мен жаяу жүріп егжей-тегжейлі түсіндіремін.
Dialogue: 0,0:56:20.12,0:56:22.00,Default,,0,0,0,,Тезірек.
Dialogue: 0,0:56:22.62,0:56:25.04,Default,,0,0,0,,Патшалыққа апаратын бір ғана жол бар
Dialogue: 0,0:56:25.17,0:56:27.17,Default,,0,0,0,,Тек осы жер асты үңгірі
Dialogue: 0,0:56:27.30,0:56:30.97,Default,,0,0,0,,Бұл өзеннің суы патшалықтың көлінен ағады.
Dialogue: 0,0:56:31.88,0:56:35.93,Default,,0,0,0,,Бірақ мен иттер патшалығына сенбеймін.
Dialogue: 0,0:56:36.39,0:56:38.89,Default,,0,0,0,,Бұл өзара.
Dialogue: 0,0:56:39.02,0:56:41.48,Default,,0,0,0,,Мен де, өз көзіммен көргенше...
Dialogue: 0,0:56:41.60,0:56:43.90,Default,,0,0,0,,Мен адам әлеміне сене алмадым.
Dialogue: 0,0:56:45.15,0:56:49.98,Default,,0,0,0,,Мүмкін, миллиондаған жылдар бұрын жер қыртысында катаклизм болған шығар.
Dialogue: 0,0:56:50.65,0:56:52.95,Default,,0,0,0,,Жердің бір бөлігі шөгінді.
Dialogue: 0,0:56:53.20,0:56:56.32,Default,,0,0,0,,Мен сыртқы әлеммен байланысым үзілді.
Dialogue: 0,0:56:57.41,0:57:02.12,Default,,0,0,0,,Сыртқы әлемде маймылдардың ата-бабалары дамып, адамдар дүниеге келген...
Dialogue: 0,0:57:02.25,0:57:05.88,Default,,0,0,0,,Иттердің ата-бабалары біздің әлемде дамыды.
Dialogue: 0,0:57:06.21,0:57:07.67,Default,,0,0,0,,Иә
Dialogue: 0,0:57:07.79,0:57:10.42,Default,,0,0,0,,А? Бұл тұйыққа тіреледі
Dialogue: 0,0:57:10.55,0:57:11.88,Default,,0,0,0,,Солай сияқты.
Dialogue: 0,0:57:12.38,0:57:14.34,Default,,0,0,0,,Дорэмон, біз бірдеңе істей алмаймыз ба?
Dialogue: 0,0:57:14.47,0:57:17.30,Default,,0,0,0,,Мм... Әйтеуір айтсаң да
Dialogue: 0,0:57:17.43,0:57:19.85,Default,,0,0,0,,Иә! Мүмкін оны қолдануға болады
Dialogue: 0,0:57:20.14,0:57:21.60,Default,,0,0,0,,Қайықпен саяхат
Dialogue: 0,0:57:21.72,0:57:23.81,Default,,0,0,0,,Yahoo!
Dialogue: 0,0:57:24.23,0:57:27.90,Default,,0,0,0,,Сарқырамаға өрмелеп бара жатқан сазандай, ағысқа қарсы жүр.
Dialogue: 0,0:57:28.02,0:57:29.19,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:57:30.02,0:57:34.03,Default,,0,0,0,,Сіз бақыттысыз ба? Пеко: Мен туған жеріме біраз уақыттан кейін бірінші рет қайта аламын.
Dialogue: 0,0:57:34.15,0:57:37.20,Default,,0,0,0,,Әрине, мен бақытты болғаныма қуаныштымын, бірақ...
Dialogue: 0,0:57:37.32,0:57:40.29,Default,,0,0,0,,Патшалықты қорқынышты жау күтіп тұр.
Dialogue: 0,0:57:40.41,0:57:41.91,Default,,0,0,0,,Жау?
Dialogue: 0,0:57:42.29,0:57:43.16,Default,,0,0,0,,Ах
Dialogue: 0,0:57:43.79,0:57:45.00,Default,,0,0,0,,Жарық!
Dialogue: 0,0:57:45.12,0:57:47.13,Default,,0,0,0,,Сіз жерге жеттіңіз.
Dialogue: 0,0:57:50.42,0:57:54.09,Default,,0,0,0,,Ух... Ах!
Dialogue: 0,0:58:08.94,0:58:11.48,Default,,0,0,0,,Бұл иттер елі!
Dialogue: 0,0:58:18.16,0:58:20.45,Default,,0,0,0,,Бұл үлкен су дөңгелегі.
Dialogue: 0,0:58:21.20,0:58:23.87,Default,,0,0,0,,Жиналған ауыл шаруашылығы өнімдерін өңдеу
Dialogue: 0,0:58:24.00,0:58:26.41,Default,,0,0,0,,Патша сарайына су тасу үшін қолданылады
Dialogue: 0,0:58:26.92,0:58:29.29,Default,,0,0,0,,Бұл әдемі жер.
Dialogue: 0,0:58:31.46,0:58:33.17,Default,,0,0,0,,(тұяқ дыбысы)
Dialogue: 0,0:58:33.17,0:58:34.80,Default,,0,0,0,,(тұяқ дыбысы)
Dialogue: 0,0:58:33.17,0:58:34.80,Default,,0,0,0,,А, жат!
Dialogue: 0,0:58:34.80,0:58:34.92,Default,,0,0,0,,(тұяқ дыбысы)
Dialogue: 0,0:58:34.92,0:58:36.47,Default,,0,0,0,,(тұяқ дыбысы)
Dialogue: 0,0:58:34.92,0:58:36.47,Default,,0,0,0,,Ах
Dialogue: 0,0:58:36.59,0:58:37.59,Default,,0,0,0,,Не болды? Тынш!
Dialogue: 0,0:58:40.30,0:58:41.51,Default,,0,0,0,,Ит солдаттар! ?
Dialogue: 0,0:58:44.97,0:58:45.98,Default,,0,0,0,,Не болды?
Dialogue: 0,0:58:46.27,0:58:49.40,Default,,0,0,0,,Арғы жақтан біртүрлі айқай естідім.
Dialogue: 0,0:58:49.52,0:58:50.94,Default,,0,0,0,,Бұл менің қиялым ғана ма?
Dialogue: 0,0:58:51.48,0:58:53.23,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:58:54.48,0:58:55.69,Default,,0,0,0,,Ал егер Цуки Кира болса, онда Цуки Нианы өлтіреді
Dialogue: 0,0:58:57.99,0:58:58.91,Default,,0,0,0,,Ах
Dialogue: 0,0:58:59.45,0:59:01.20,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:59:01.32,0:59:02.87,Default,,0,0,0,,Тек таңдаулы бірнешеуге ғана тән делінген күш—
Dialogue: 0,0:59:02.99,0:59:06.54,Default,,0,0,0,,Ол әкесінен тағын тартып алған министр Даврандардың бағыныштысы.
Dialogue: 0,0:59:06.66,0:59:07.83,Default,,0,0,0,,Дубландер?
Dialogue: 0,0:59:08.16,0:59:11.04,Default,,0,0,0,,Айлакер және айбатты жау.
Dialogue: 0,0:59:11.17,0:59:14.84,Default,,0,0,0,,Бұл ел енді Даврандардың бақылауында.
Dialogue: 0,0:59:15.13,0:59:17.17,Default,,0,0,0,,Қазір қайда бара жатырсың?
Dialogue: 0,0:59:17.30,0:59:18.80,Default,,0,0,0,,Бұл Бурстың сарайы.
Dialogue: 0,0:59:19.51,0:59:25.68,Default,,0,0,0,,Брюс - менің әкемнің гвардия капитаны және осы елдегі ең сенімді адам.
Dialogue: 0,0:59:26.72,0:59:28.89,Default,,0,0,0,,Не, жатасың ба?
Dialogue: 0,0:59:32.81,0:59:34.57,Default,,0,0,0,,Мен құлап қалдым.
Dialogue: 0,0:59:34.69,0:59:35.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:36.15,0:59:38.53,Default,,0,0,0,,Брюс Эй Брюс?
Dialogue: 0,0:59:38.95,0:59:40.24,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:59:40.36,0:59:41.99,Default,,0,0,0,,Онда ешкім жоқ сияқты
Dialogue: 0,0:59:42.37,0:59:45.49,Default,,0,0,0,,Ол тұтқынға түскен шығар.
Dialogue: 0,0:59:45.62,0:59:49.00,Default,,0,0,0,,Мен Бурсус қауіпсіз болады деп ойладым.
Dialogue: 0,0:59:49.37,0:59:52.33,Default,,0,0,0,,Сенетін басқа ешкім жоқ па?
Dialogue: 0,0:59:52.46,0:59:56.00,Default,,0,0,0,,Осы қарқынмен одақтастар қалмайды...
Dialogue: 0,0:59:56.50,0:59:59.92,Default,,0,0,0,,Пеко, бұл қалай болды?
Dialogue: 0,1:00:01.09,1:00:02.89,Default,,0,0,0,,5000 жыл бұрын -
Dialogue: 0,1:00:03.01,1:00:07.85,Default,,0,0,0,,Патшалықта қазіргіден әлдеқайда дамыған өркениет болды.
Dialogue: 0,1:00:09.10,1:00:13.10,Default,,0,0,0,,Біздің ата-бабаларымыз өздерінің ғылыми күш-қуатын пайдаланып, от сөндіретін көліктер жасаған...
Dialogue: 0,1:00:13.19,1:00:17.11,Default,,0,0,0,,Ұшатын кемелер мен басқа да қорқынышты қаруларды ойлап тапты.
Dialogue: 0,1:00:18.15,1:00:20.61,Default,,0,0,0,,Бірақ дана Бованко I...
Dialogue: 0,1:00:20.74,1:00:24.53,Default,,0,0,0,,Қарудың шексіз дамуы дүниенің жойылуына әкелетініне сенді.
Dialogue: 0,1:00:24.62,1:00:28.95,Default,,0,0,0,,Олар қаруды зерттеуге тыйым салып, жазбаларын мөрмен бекітті.
Dialogue: 0,1:00:30.08,1:00:32.96,Default,,0,0,0,,Оның орнына, патшалықтың қамқоршысы ретінде ...
Dialogue: 0,1:00:33.08,1:00:34.54,Default,,0,0,0,,Алып мүсін тұрғызылды.
Dialogue: 0,1:00:35.63,1:00:39.38,Default,,0,0,0,,5000 жылдан кейін ғылыми қуат төмендеді...
Dialogue: 0,1:00:39.51,1:00:41.55,Default,,0,0,0,,Патшалықтың тыныштығы сақталды.
Dialogue: 0,1:00:43.51,1:00:46.39,Default,,0,0,0,,Алайда әкесі патша болған кезде...
Dialogue: 0,1:00:46.51,1:00:49.06,Default,,0,0,0,,Министр Даврандардың амбициялары болды.
Dialogue: 0,1:00:51.98,1:00:54.48,Default,,0,0,0,,Хмм...хехе
Dialogue: 0,1:00:55.19,1:00:56.94,Default,,0,0,0,,Ежелгі қарулардың қайта жаңғыруы
Dialogue: 0,1:00:57.07,1:01:00.40,Default,,0,0,0,,Олар сыртқы әлемді басып алуды жоспарлады.
Dialogue: 0,1:01:00.74,1:01:02.49,Default,,0,0,0,,Бұл?
Dialogue: 0,1:01:02.61,1:01:04.45,Default,,0,0,0,,Ей, ей, ей! Бар дейсің бе? Қайда, нақты қай жерде?
Dialogue: 0,1:01:06.57,1:01:08.08,Default,,0,0,0,,Хмм...
Dialogue: 0,1:01:08.20,1:01:10.29,Default,,0,0,0,,Иә? Хмм
Dialogue: 0,1:01:13.67,1:01:16.29,Default,,0,0,0,,Ой
Dialogue: 0,1:01:16.46,1:01:18.21,Default,,0,0,0,,Керемет!
Dialogue: 0,1:01:18.34,1:01:21.01,Default,,0,0,0,,Шынымен жоғалған ежелгі қарудың жазбасы
Dialogue: 0,1:01:21.09,1:01:24.55,Default,,0,0,0,,О! Фуфуфуфу…
Dialogue: 0,1:01:24.68,1:01:26.97,Default,,0,0,0,,Әлем енді біздікі
Dialogue: 0,1:01:27.05,1:01:29.35,Default,,0,0,0,,Нухахаха…
Dialogue: 0,1:01:30.93,1:01:35.19,Default,,0,0,0,,Бұл менің Спиана ханшайыммен үйлену тойымнан бір күн бұрын болды.
Dialogue: 0,1:01:35.90,1:01:38.27,Default,,0,0,0,,Қолыңызға рахмет
Dialogue: 0,1:01:41.82,1:01:44.32,Default,,0,0,0,,Мен бұл елді қорғаймын
Dialogue: 0,1:01:44.45,1:01:46.41,Default,,0,0,0,,Сіз туралы да.
Dialogue: 0,1:01:46.53,1:01:47.66,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:49.12,1:01:52.12,Default,,0,0,0,,Бұл тыныштық мәңгілік болсын
Dialogue: 0,1:01:53.87,1:01:56.62,Default,,0,0,0,,Ханзада! Ханзада!
Dialogue: 0,1:01:57.54,1:01:59.50,Default,,0,0,0,,Осы жерде күтіңіз.
Dialogue: 0,1:02:03.01,1:02:05.22,Default,,0,0,0,,А... Иә?
Dialogue: 0,1:02:06.63,1:02:08.14,Default,,0,0,0,,Жаңбыр?
Dialogue: 0,1:02:09.26,1:02:10.97,Default,,0,0,0,,князь Кунтак!
Dialogue: 0,1:02:11.10,1:02:12.77,Default,,0,0,0,,Не болып жатыр? шнаузер
Dialogue: 0,1:02:12.89,1:02:15.94,Default,,0,0,0,,Қиын, Ханзада, мені тыңда.
Dialogue: 0,1:02:16.14,1:02:17.81,Default,,0,0,0,,Патша... аа!
Dialogue: 0,1:02:17.90,1:02:19.36,Default,,0,0,0,,(Кунтактың ауыр тыныс алуы)
Dialogue: 0,1:02:21.52,1:02:22.78,Default,,0,0,0,,Әке!
Dialogue: 0,1:02:24.44,1:02:25.95,Default,,0,0,0,,Әке...
Dialogue: 0,1:02:27.41,1:02:29.16,Default,,0,0,0,,Әке әке!
Dialogue: 0,1:02:29.62,1:02:33.20,Default,,0,0,0,,Шамасы, бұл кесеге у жағылған.
Dialogue: 0,1:02:33.33,1:02:34.66,Default,,0,0,0,,Хмм...
Dialogue: 0,1:02:35.25,1:02:40.88,Default,,0,0,0,,Бұл кесе міндетті түрде ханзаданың сыйы болды, хаха.
Dialogue: 0,1:02:41.00,1:02:42.09,Default,,0,0,0,,Ах!
Dialogue: 0,1:02:44.80,1:02:47.84,Default,,0,0,0,,Жоқ... А, сен жоспар құрдың, Дубландер!
Dialogue: 0,1:02:48.26,1:02:52.56,Default,,0,0,0,,Конспирация? Сіз нені меңзеп тұрсыз?
Dialogue: 0,1:02:52.68,1:02:56.85,Default,,0,0,0,,Оның орнына өзіңіз туралы алаңдауға кеңес беремін.
Dialogue: 0,1:02:58.35,1:03:00.15,Default,,0,0,0,,Көтерілісшіні қолға түсіріңіз!
Dialogue: 0,1:03:00.23,1:03:02.11,Default,,0,0,0,,О!
Dialogue: 0,1:03:02.48,1:03:04.40,Default,,0,0,0,,(Найзағай)
Dialogue: 0,1:03:05.94,1:03:08.15,Default,,0,0,0,,(Сарбаздардың дауысы)
Dialogue: 0,1:03:08.28,1:03:09.53,Default,,0,0,0,,(Амон) Нагачика? (Хайд) Ах, Амон-сан.
Dialogue: 0,1:03:11.32,1:03:12.91,Default,,0,0,0,,Міне болды!
Dialogue: 0,1:03:14.91,1:03:16.50,Default,,0,0,0,,Chase! (Солдат) Күте тұрыңыз!
Dialogue: 0,1:03:17.00,1:03:20.29,Default,,0,0,0,,Сен қайда бардың? (Солдат) Өзен бойын ізде!
Dialogue: 0,1:03:20.63,1:03:21.46,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:22.46,1:03:25.71,Default,,0,0,0,,Мен күте алмадым, князь Кунтак.
Dialogue: 0,1:03:32.47,1:03:35.35,Default,,0,0,0,,Уф (Сабель) Хмм...
Dialogue: 0,1:03:36.56,1:03:38.98,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,1:03:46.65,1:03:50.07,Default,,0,0,0,,Дәл осылай мен сол жер асты суының ағынына ілініп қалдым.
Dialogue: 0,1:03:51.45,1:03:54.87,Default,,0,0,0,,Адам әлемін алғаш көргенде, мен мұңайып қалдым...
Dialogue: 0,1:03:54.99,1:03:57.50,Default,,0,0,0,,Мен портта тұрған кемеге тығылдым.
Dialogue: 0,1:03:58.20,1:04:02.46,Default,,0,0,0,,Кеме Африка мен Жапонияны байланыстыратын жүк кемесі болды.
Dialogue: 0,1:04:02.75,1:04:06.46,Default,,0,0,0,,Үйге қайту мүмкіндігі болған кезде мен көшеде адасып қалдым...
Dialogue: 0,1:04:06.59,1:04:08.97,Default,,0,0,0,,Нобита-сан мені құтқарды.
Dialogue: 0,1:04:10.30,1:04:14.60,Default,,0,0,0,,Даврандарды жеңмейінше, патшалықтың болашағы жоқ.
Dialogue: 0,1:04:14.72,1:04:17.60,Default,,0,0,0,,үшін, бұл қиын болуы мүмкін екенін түсініңіз.
Dialogue: 0,1:04:17.72,1:04:20.60,Default,,0,0,0,,Маған күшіңізді беріңізші.
Dialogue: 0,1:04:21.02,1:04:21.89,Default,,0,0,0,,Өтінемін...
Dialogue: 0,1:04:22.23,1:04:23.10,Default,,0,0,0,,Пеко…
Dialogue: 0,1:04:23.23,1:04:24.65,Default,,0,0,0,,Эй... Мен қалжыңдап тұрған жоқпын!
Dialogue: 0,1:04:24.77,1:04:25.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:26.15,1:04:27.69,Default,,0,0,0,,Мен қазына табуға келдім...
Dialogue: 0,1:04:27.82,1:04:30.82,Default,,0,0,0,,Неліктен мен бұған араласуым керек?
Dialogue: 0,1:04:30.95,1:04:33.82,Default,,0,0,0,,Жаяу жүрсе де Жапонияға қайтайық!
Dialogue: 0,1:04:34.62,1:04:36.58,Default,,0,0,0,,Бұл шындық болуы мүмкін емес, солай ма?
Dialogue: 0,1:04:36.70,1:04:39.79,Default,,0,0,0,,Иә! Мен Пекодан бас тарта алмаймын
Dialogue: 0,1:04:40.12,1:04:42.62,Default,,0,0,0,,Біз не істей аламыз?
Dialogue: 0,1:04:42.75,1:04:44.29,Default,,0,0,0,,үшінмыз ойланып көрейік
Dialogue: 0,1:04:44.42,1:04:46.25,Default,,0,0,0,,Бұл босқа! (Нобита) Бұл ысырап емес!
Dialogue: 0,1:04:46.38,1:04:48.75,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,1:04:51.13,1:04:53.22,Default,,0,0,0,,Күте тұрыңыз! Мына жырау!
Dialogue: 0,1:04:55.30,1:04:58.60,Default,,0,0,0,,Ия, мен оны ұстадым!
Dialogue: 0,1:04:58.72,1:05:00.85,Default,,0,0,0,,Қандай епті кішкентай бала!
Dialogue: 0,1:05:00.98,1:05:03.06,Default,,0,0,0,,2-ден 1-ге дейін ақылсыз!
Dialogue: 0,1:05:03.19,1:05:05.15,Default,,0,0,0,,Әділ және әділ күрес!
Dialogue: 0,1:05:05.27,1:05:08.73,Default,,0,0,0,,Хахаха Бернард, біз ақымақпыз.
Dialogue: 0,1:05:08.86,1:05:12.49,Default,,0,0,0,,Иә? О... біз бейбақ емеспіз.
Dialogue: 0,1:05:12.61,1:05:15.87,Default,,0,0,0,,Иә! Бар!
Dialogue: 0,1:05:16.66,1:05:20.87,Default,,0,0,0,,Жарайды, мен сенің мұрныңа енді бас тарта алмаймын!
Dialogue: 0,1:05:21.00,1:05:22.62,Default,,0,0,0,,Тоқта! (2 адам) Иә?
Dialogue: 0,1:05:22.75,1:05:24.83,Default,,0,0,0,,Уау
Dialogue: 0,1:05:25.29,1:05:27.29,Default,,0,0,0,,Жоқ... не? Балалар сендер
Dialogue: 0,1:05:27.42,1:05:29.84,Default,,0,0,0,,Мен балаларға дөрекі қарым-қатынас жасауға шыдамаймын!
Dialogue: 0,1:05:30.38,1:05:32.21,Default,,0,0,0,,Шатаспаңыз!
Dialogue: 0,1:05:32.67,1:05:34.01,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:05:34.72,1:05:37.47,Default,,0,0,0,,Қат! Уф, күте тұрыңыз!
Dialogue: 0,1:05:43.52,1:05:44.35,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,1:05:44.52,1:05:46.31,Default,,0,0,0,,О? иә!
Dialogue: 0,1:05:46.40,1:05:47.65,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:05:48.19,1:05:51.11,Default,,0,0,0,,А, жарайды... Кешіріңіз.
Dialogue: 0,1:05:51.90,1:05:52.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:54.99,1:05:56.61,Default,,0,0,0,,Жоқ, сен!
Dialogue: 0,1:05:56.70,1:05:58.95,Default,,0,0,0,,Ой... бұл елес! Жүгіріп кету!
Dialogue: 0,1:05:59.08,1:06:00.58,Default,,0,0,0,,Әрине!
Dialogue: 0,1:06:01.12,1:06:04.04,Default,,0,0,0,,Хахаха, сен күшті емессің бе, Пеко?
Dialogue: 0,1:06:04.16,1:06:04.50,Default,,0,0,0,,Сіз менің шынайы болмысымды түсінген сияқтысыз.
Dialogue: 0,1:06:04.50,1:06:06.12,Default,,0,0,0,,Сіз менің шынайы болмысымды түсінген сияқтысыз.
Dialogue: 0,1:06:04.50,1:06:06.12,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:06:06.12,1:06:06.87,Default,,0,0,0,,Сіз менің шынайы болмысымды түсінген сияқтысыз.
Dialogue: 0,1:06:07.67,1:06:09.25,Default,,0,0,0,,Менің атым Чиппо.
Dialogue: 0,1:06:09.71,1:06:12.88,Default,,0,0,0,,Сол адамдардың түскі ас қораптарын ұрлағаным жаман болды, бірақ...
Dialogue: 0,1:06:13.01,1:06:15.30,Default,,0,0,0,,Өйткені мен аштан өлдім.
Dialogue: 0,1:06:15.72,1:06:17.59,Default,,0,0,0,,Сенің әкең немесе анаң ше?
Dialogue: 0,1:06:17.72,1:06:21.39,Default,,0,0,0,,Ауыл тұрғындарының барлығын алып кетті.
Dialogue: 0,1:06:21.51,1:06:22.72,Default,,0,0,0,,Сізді алдыңыз ба?
Dialogue: 0,1:06:22.81,1:06:26.06,Default,,0,0,0,,Кенет солдаттар келіп, амалсыздан...
Dialogue: 0,1:06:32.40,1:06:35.70,Default,,0,0,0,,Анашым! Мен мұны Бу мен Уға бере аламын ба?
Dialogue: 0,1:06:35.82,1:06:37.32,Default,,0,0,0,,Мен бұл туралы бұрын айтқан жоқпын ба?
Dialogue: 0,1:06:37.45,1:06:38.61,Default,,0,0,0,,Мен әлі де жегім келеді
Dialogue: 0,1:06:38.70,1:06:40.24,Default,,0,0,0,,Әй, Чиппо!
Dialogue: 0,1:06:40.37,1:06:41.91,Default,,0,0,0,,Неге жасырып жатырсың?
Dialogue: 0,1:06:42.87,1:06:44.91,Default,,0,0,0,,Уау, түсіндім.
Dialogue: 0,1:06:46.75,1:06:49.92,Default,,0,0,0,,Сіз нені айтасыз? Дұрыстап түсіндіріп беріңізші
Dialogue: 0,1:06:50.29,1:06:52.63,Default,,0,0,0,,Даврандар мырзаның бұйрығымен-
Dialogue: 0,1:06:52.75,1:06:55.88,Default,,0,0,0,,Бүгіннен бастап мен сізді қару жасаушы етіп тағайындаймын.
Dialogue: 0,1:06:56.01,1:06:57.84,Default,,0,0,0,,Иә! ? Мұндай тәртіпсіздік
Dialogue: 0,1:06:58.22,1:07:01.80,Default,,0,0,0,,Егіс пен малды кім күтеді?
Dialogue: 0,1:07:02.47,1:07:03.56,Default,,0,0,0,,Мені ал
Dialogue: 0,1:07:03.68,1:07:05.89,Default,,0,0,0,,Не істейсің... (Корин) Мені жібер.
Dialogue: 0,1:07:06.23,1:07:08.98,Default,,0,0,0,,Тоқта! Анаң мен әкеңді қорлама
Dialogue: 0,1:07:09.10,1:07:10.27,Default,,0,0,0,,Маған кедергі жасама! Ахх
Dialogue: 0,1:07:12.77,1:07:15.57,Default,,0,0,0,,Чиппо! (Корин) Чиппо!
Dialogue: 0,1:07:17.40,1:07:20.91,Default,,0,0,0,,Сондықтан мен әкем мен анама көмектесемін.
Dialogue: 0,1:07:21.49,1:07:23.87,Default,,0,0,0,,Қараңдаршы, мен де қылыш жасадым.
Dialogue: 0,1:07:24.37,1:07:26.00,Default,,0,0,0,,Chippo…
Dialogue: 0,1:07:28.75,1:07:30.12,Default,,0,0,0,,Маған көрсет
Dialogue: 0,1:07:30.25,1:07:31.29,Default,,0,0,0,,Иә
Dialogue: 0,1:07:33.34,1:07:34.55,Default,,0,0,0,,Керемет қылыш.
Dialogue: 0,1:07:34.67,1:07:36.63,Default,,0,0,0,,Шынымен бе? Иә
Dialogue: 0,1:07:37.09,1:07:38.30,Default,,0,0,0,,Пеко
Dialogue: 0,1:07:38.67,1:07:40.59,Default,,0,0,0,,Біз де сізге көмектесейік
Dialogue: 0,1:07:40.72,1:07:41.76,Default,,0,0,0,,Иә!
Dialogue: 0,1:07:42.30,1:07:43.72,Default,,0,0,0,,Нобита-сан…
Dialogue: 0,1:07:43.85,1:07:46.43,Default,,0,0,0,,Әрине бізге де.
Dialogue: 0,1:07:46.56,1:07:49.94,Default,,0,0,0,,Бәріміз бірге жұмыс жасасақ, міндетті түрде бірдеңе істей аламыз.
Dialogue: 0,1:07:50.06,1:07:50.90,Default,,0,0,0,,Хмф!
Dialogue: 0,1:07:51.02,1:07:53.44,Default,,0,0,0,,Ух... аааа
Dialogue: 0,1:07:53.56,1:07:56.98,Default,,0,0,0,,Түсіндім! Сізге көмектесуім керек пе?
Dialogue: 0,1:07:57.94,1:08:01.86,Default,,0,0,0,,А... Рахмет, рахмет, бәріңе.
Dialogue: 0,1:08:01.95,1:08:05.45,Default,,0,0,0,,Егер сіз мұны шешсеңіз, дереу стратегияны жасайық.
Dialogue: 0,1:08:15.88,1:08:17.76,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,1:08:25.64,1:08:26.68,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,1:08:27.35,1:08:29.68,Default,,0,0,0,,Не ойнап жүрсің?
Dialogue: 0,1:08:30.02,1:08:32.94,Default,,0,0,0,,Өте жақсы жұмыс, доктор Косс.
Dialogue: 0,1:08:33.06,1:08:34.36,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:08:34.73,1:08:39.53,Default,,0,0,0,,Сыртқы дүниеде қандай жау болса да, қорықпа.
Dialogue: 0,1:08:41.70,1:08:43.66,Default,,0,0,0,,Әрине.
Dialogue: 0,1:08:43.78,1:08:46.78,Default,,0,0,0,,Осы бірліктердің мыңдаған немесе он мыңдағанын жасау үшін...
Dialogue: 0,1:08:46.91,1:08:49.83,Default,,0,0,0,,Біз қазір еліміздің түкпір-түкпірінен адамдарды жинап жатырмыз.
Dialogue: 0,1:08:50.45,1:08:53.29,Default,,0,0,0,,Даврандар-сама дүниенің патшасы болған күн...
Dialogue: 0,1:08:53.42,1:08:55.79,Default,,0,0,0,,Бұл алыс емес.
Dialogue: 0,1:08:56.63,1:08:59.71,Default,,0,0,0,,Құрметті Даврандар! Бұл үлкен мәселе!
Dialogue: 0,1:08:59.80,1:09:02.26,Default,,0,0,0,,Не! ? Бұл ханзада ма?
Dialogue: 0,1:09:02.63,1:09:07.14,Default,,0,0,0,,Бұл ақымақтық. Ханзада көлге терең батып кетуі керек еді.
Dialogue: 0,1:09:07.26,1:09:09.47,Default,,0,0,0,,Бірақ мен сіздің жүзіңізді көрдім.
Dialogue: 0,1:09:09.81,1:09:13.35,Default,,0,0,0,,Оның үстіне онымен бірге бес бөтен жануар да болды.
Dialogue: 0,1:09:13.48,1:09:15.69,Default,,0,0,0,,Киім киген маймылға ұқсайды...
Dialogue: 0,1:09:15.81,1:09:17.73,Default,,0,0,0,,Араластың ішінде бір иті бар еді.
Dialogue: 0,1:09:18.19,1:09:21.65,Default,,0,0,0,,Мен Бованко I пайғамбарлығын күткен жоқпын...
Dialogue: 0,1:09:21.78,1:09:23.40,Default,,0,0,0,,Жоқ, бірақ сандар сәйкес келмейді.
Dialogue: 0,1:09:23.78,1:09:25.91,Default,,0,0,0,,Маған сенің кім екенің бәрібір.
Dialogue: 0,1:09:26.03,1:09:28.37,Default,,0,0,0,,Барлық күдікті адамдарды ұстаңыз!
Dialogue: 0,1:09:28.45,1:09:30.24,Default,,0,0,0,,Дабурандр мырза (Дабурандр) иә?
Dialogue: 0,1:09:30.37,1:09:34.29,Default,,0,0,0,,Нағыз ханзада болса, қылыш шебері болар еді.
Dialogue: 0,1:09:34.87,1:09:38.38,Default,,0,0,0,,Капитан Саберді осында жіберу керек.
Dialogue: 0,1:09:39.09,1:09:40.34,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,1:09:41.05,1:09:42.84,Default,,0,0,0,,Уау
Dialogue: 0,1:09:52.18,1:09:54.44,Default,,0,0,0,,Сіз кедергісіз. Жолдан кет!
Dialogue: 0,1:09:54.56,1:09:56.60,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:09:58.73,1:09:59.86,Default,,0,0,0,,Тоқта
Dialogue: 0,1:10:00.61,1:10:02.99,Default,,0,0,0,,Бала, күймеде не бар?
Dialogue: 0,1:10:03.28,1:10:06.99,Default,,0,0,0,,Иә, біз базарға көкөністерді тиеп жатырмыз.
Dialogue: 0,1:10:07.70,1:10:10.41,Default,,0,0,0,,Сонымен, мен оны қарап шықсам жақсы ма?
Dialogue: 0,1:10:10.49,1:10:13.16,Default,,0,0,0,,Иә... иә
Dialogue: 0,1:10:29.18,1:10:31.06,Default,,0,0,0,,Хмм...
Dialogue: 0,1:10:31.18,1:10:32.43,Default,,0,0,0,,Капитан Сабер! (Сәбель) Иә?
Dialogue: 0,1:10:32.68,1:10:34.98,Default,,0,0,0,,Әсіресе күдікті ештеңе болған жоқ.
Dialogue: 0,1:10:35.27,1:10:36.85,Default,,0,0,0,,Бар болғаны осы болды
Dialogue: 0,1:10:38.27,1:10:40.36,Default,,0,0,0,,Бала, кешіріңіз.
Dialogue: 0,1:10:41.23,1:10:44.11,Default,,0,0,0,,Біртүрлі иіс шығады. Барайық!
Dialogue: 0,1:10:49.37,1:10:51.74,Default,,0,0,0,,Ханзада, қазір бәрі жақсы.
Dialogue: 0,1:10:55.20,1:10:57.33,Default,,0,0,0,,Уф...
Dialogue: 0,1:10:57.46,1:10:58.62,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:58.75,1:11:02.50,Default,,0,0,0,,Бұл қауіпті болды. Күткендей, қуғыншылар жақындап қалды.
Dialogue: 0,1:11:02.63,1:11:05.67,Default,,0,0,0,,Енді трансформация сусыны жоқ.
Dialogue: 0,1:11:16.27,1:11:19.56,Default,,0,0,0,,Ху, Күнтақ күткендей.
Dialogue: 0,1:11:20.10,1:11:22.61,Default,,0,0,0,,Көзіңді жұм!
Dialogue: 0,1:11:26.57,1:11:27.70,Default,,0,0,0,,(Инумаки) Та… (Бірдеңенің тесіп өткен дыбысы)
Dialogue: 0,1:11:34.54,1:11:37.91,Default,,0,0,0,,Барлық сарбаздарды жұмылдырып, үлкен тор орнатыңыз!
Dialogue: 0,1:11:38.66,1:11:41.88,Default,,0,0,0,,Ханзада мен оның бандасының әрқайсысын тұтқынға алыңыз!
Dialogue: 0,1:11:42.63,1:11:44.75,Default,,0,0,0,,Сыбыс шындыққа айналды
Dialogue: 0,1:11:44.88,1:11:49.22,Default,,0,0,0,,Брюс мырза осы ғимараттың түбінде қамалған.
Dialogue: 0,1:11:49.84,1:11:52.80,Default,,0,0,0,,Таныс өтетін шеңбер
Dialogue: 0,1:11:53.22,1:11:54.85,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,1:11:54.97,1:11:58.35,Default,,0,0,0,,Дораэмон шынымен жұмбақ құралға ие.
Dialogue: 0,1:11:58.48,1:12:00.77,Default,,0,0,0,,Әй, таңданба, асығыс, асығыс.
Dialogue: 0,1:12:10.03,1:12:13.70,Default,,0,0,0,,А, біз неге қарауылдамыз?
Dialogue: 0,1:12:13.87,1:12:15.16,Default,,0,0,0,,Эй (Бернард) Уф.
Dialogue: 0,1:12:16.04,1:12:18.45,Default,,0,0,0,,Осылай (Нобита) Мен өзімді жаман сезінемін.
Dialogue: 0,1:12:18.58,1:12:20.96,Default,,0,0,0,,Жақсы балауыз дүкендері бар ма?
Dialogue: 0,1:12:26.34,1:12:28.88,Default,,0,0,0,,Brusus Brusus иә?
Dialogue: 0,1:12:29.21,1:12:30.80,Default,,0,0,0,,Бұл менмін, Брюс.
Dialogue: 0,1:12:30.92,1:12:32.84,Default,,0,0,0,,Бұл дауыс! Сол иіс!
Dialogue: 0,1:12:33.51,1:12:36.18,Default,,0,0,0,,Ханзада! Бұл арман ба?
Dialogue: 0,1:12:36.31,1:12:37.31,Default,,0,0,0,,Тыныш!
Dialogue: 0,1:12:37.68,1:12:39.31,Default,,0,0,0,,(шу)
Dialogue: 0,1:12:39.43,1:12:40.27,Default,,0,0,0,,Әй?
Dialogue: 0,1:12:41.14,1:12:43.27,Default,,0,0,0,,Әйтеуір кейінірек сөйлесейік, бұл жерден кетейік.
Dialogue: 0,1:12:43.40,1:12:45.48,Default,,0,0,0,,(Бернардтың есінеу)
Dialogue: 0,1:12:45.61,1:12:47.69,Default,,0,0,0,,Ұйықтап жатқанда жүруге болмайды
Dialogue: 0,1:12:47.94,1:12:49.57,Default,,0,0,0,,Брюс! ? Хмф!
Dialogue: 0,1:12:49.69,1:12:53.20,Default,,0,0,0,,Бұл... қиын! Уау
Dialogue: 0,1:12:53.32,1:12:54.95,Default,,0,0,0,,Ах~
Dialogue: 0,1:12:55.07,1:12:57.03,Default,,0,0,0,,А, а, а...
Dialogue: 0,1:12:57.16,1:12:58.24,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,1:12:58.37,1:12:59.58,Default,,0,0,0,,Тыныш!
Dialogue: 0,1:12:59.66,1:13:01.54,Default,,0,0,0,,(мүйіз дыбысы)
Dialogue: 0,1:13:01.62,1:13:03.46,Default,,0,0,0,,Дезертир! (Солдат) Қашып кетуіме жол берме!
Dialogue: 0,1:13:03.54,1:13:05.46,Default,,0,0,0,,Таптым, асығыңыз!
Dialogue: 0,1:13:05.63,1:13:07.75,Default,,0,0,0,,Жоқ... бұл қауіпті.
Dialogue: 0,1:13:07.88,1:13:08.92,Default,,0,0,0,,Ханзада!
Dialogue: 0,1:13:09.05,1:13:10.26,Default,,0,0,0,,Дегенмен—
Dialogue: 0,1:13:10.38,1:13:13.01,Default,,0,0,0,,үшін қауіпсіз, соның ішінде Брюс.
Dialogue: 0,1:13:13.59,1:13:14.43,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:14.51,1:13:16.22,Default,,0,0,0,,Тез, тез
Dialogue: 0,1:13:16.35,1:13:18.64,Default,,0,0,0,,Міне болды! (2 адам) Ахх!
Dialogue: 0,1:13:18.76,1:13:21.31,Default,,0,0,0,,(Дораэмонның күшті дауысы)
Dialogue: 0,1:13:21.81,1:13:23.56,Default,,0,0,0,,Уау!
Dialogue: 0,1:13:27.61,1:13:30.03,Default,,0,0,0,,Дана Бованко I
Dialogue: 0,1:13:30.15,1:13:32.40,Default,,0,0,0,,Осы дұғаны тыңдаңыз.
Dialogue: 0,1:13:32.99,1:13:35.82,Default,,0,0,0,,Патшалықты енді зұлым адамдар басқарады...
Dialogue: 0,1:13:35.95,1:13:38.87,Default,,0,0,0,,Мен терең қараңғылықта кезіп келемін.
Dialogue: 0,1:13:39.33,1:13:43.58,Default,,0,0,0,,Өтінемін, осы елге нұр әкел.
Dialogue: 0,1:13:43.71,1:13:46.58,Default,,0,0,0,,Күте тұрыңыз! иә? Ах
Dialogue: 0,1:13:48.13,1:13:49.75,Default,,0,0,0,,Іздеу (Солдат) Қайда қашты?
Dialogue: 0,1:13:49.88,1:13:53.88,Default,,0,0,0,,(Әскерилер дауысты іздейді)
Dialogue: 0,1:13:55.63,1:13:57.22,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,1:13:57.64,1:14:01.06,Default,,0,0,0,,Ханшайым! А, мен соғуым керек.
Dialogue: 0,1:14:01.18,1:14:02.93,Default,,0,0,0,,Жарайсың, қуыршақ.
Dialogue: 0,1:14:03.06,1:14:04.18,Default,,0,0,0,,Бұл қиын, ханшайым.
Dialogue: 0,1:14:04.89,1:14:07.81,Default,,0,0,0,,Ханзада... Ханзада үйіне оралған сияқты.
Dialogue: 0,1:14:07.94,1:14:10.07,Default,,0,0,0,,Не? Ханзада?
Dialogue: 0,1:14:10.40,1:14:13.82,Default,,0,0,0,,Бұл рас па? Өйткені ол тірі еді.
Dialogue: 0,1:14:13.94,1:14:17.87,Default,,0,0,0,,Мен оның дүниеден өткеніне сене алмадым.
Dialogue: 0,1:14:18.28,1:14:21.45,Default,,0,0,0,,Жақсы, шынымен жақсы
Dialogue: 0,1:14:21.58,1:14:23.29,Default,,0,0,0,,Алданбаңыз.
Dialogue: 0,1:14:23.41,1:14:24.79,Default,,0,0,0,,Спиана ханшайымы га
Dialogue: 0,1:14:25.46,1:14:29.71,Default,,0,0,0,,Жалған ханзада мен оның бандысы жақын арада тұтқынға алынады.
Dialogue: 0,1:14:29.84,1:14:32.75,Default,,0,0,0,,Әрине мен олардың бәрін өлім жазасына кесемін.
Dialogue: 0,1:14:33.42,1:14:35.38,Default,,0,0,0,,Ханзада туралы ұмытыңыз...
Dialogue: 0,1:14:35.51,1:14:39.01,Default,,0,0,0,,Сен маған дос болғаның жақсы.
Dialogue: 0,1:14:39.14,1:14:40.26,Default,,0,0,0,,Дөрекі!
Dialogue: 0,1:14:40.39,1:14:43.56,Default,,0,0,0,,Ол сізді ұстайтын адам емес.
Dialogue: 0,1:14:43.68,1:14:47.73,Default,,0,0,0,,Мен міндетті түрде халықпен бірге тұрып, осы елді сақтаймын.
Dialogue: 0,1:14:48.02,1:14:50.23,Default,,0,0,0,,Олай болса...
Dialogue: 0,1:14:50.36,1:14:53.73,Default,,0,0,0,,Оны өзіңіз көруіңіз керек.
Dialogue: 0,1:14:54.32,1:14:57.40,Default,,0,0,0,,Оны ертең таңертеңге дейін жеткізіңіз.
Dialogue: 0,1:14:57.53,1:14:59.70,Default,,0,0,0,,Ханзада басы
Dialogue: 0,1:14:59.82,1:15:02.41,Default,,0,0,0,,Хухаха хаха...
Dialogue: 0,1:15:02.53,1:15:05.25,Default,,0,0,0,,Хаа... (Қуыршақ) Әй, ханшайым!
Dialogue: 0,1:15:05.83,1:15:09.21,Default,,0,0,0,,Ханзада, аман болыңыз.
Dialogue: 0,1:15:10.25,1:15:12.25,Default,,0,0,0,,Мұны іздеңіз! (Солдат) Қайда қаштың?
Dialogue: 0,1:15:13.63,1:15:16.26,Default,,0,0,0,,Бір күдікті адамды жіберіп алмаңыз.
Dialogue: 0,1:15:16.38,1:15:19.13,Default,,0,0,0,,Ағаштың тамырын қазу керек болса да, тауып ал!
Dialogue: 0,1:15:19.51,1:15:21.22,Default,,0,0,0,,Мұқият тыңдаңыз!
Dialogue: 0,1:15:21.35,1:15:25.10,Default,,0,0,0,,Жалған ханзада мен оның тобы қаланың бір жерінде жасырынып жүр.
Dialogue: 0,1:15:25.56,1:15:28.56,Default,,0,0,0,,Қараңдаршы, төрт маймыл мен енот ит бар.
Dialogue: 0,1:15:28.85,1:15:31.52,Default,,0,0,0,,Жасырынған адам өлім жазасына кесіледі.
Dialogue: 0,1:15:31.98,1:15:35.90,Default,,0,0,0,,Жасырылған жері туралы хабарлаған адамға бір жылдық сүйектер беріледі.
Dialogue: 0,1:15:36.03,1:15:38.36,Default,,0,0,0,,Хо... 1 жылдық сүйектер!
Dialogue: 0,1:15:38.49,1:15:40.11,Default,,0,0,0,,Өте ыстық!
Dialogue: 0,1:15:40.24,1:15:43.03,Default,,0,0,0,,Иә? иә? Онда ешкім жоқ
Dialogue: 0,1:15:43.28,1:15:46.83,Default,,0,0,0,,Тексеру...Давландер-сама танымал емес.
Dialogue: 0,1:15:48.04,1:15:50.46,Default,,0,0,0,,Иә? Мен бұл жерді бақылауым керек пе?
Dialogue: 0,1:15:50.58,1:15:51.38,Default,,0,0,0,,Барқа!
Dialogue: 0,1:15:51.50,1:15:54.04,Default,,0,0,0,,Біз оны тауып, сыйлық аламыз, солай ма?
Dialogue: 0,1:15:54.17,1:15:58.09,Default,,0,0,0,,Брутелли күткендей, мен өмірімнің соңына дейін саған еремін.
Dialogue: 0,1:16:00.22,1:16:02.14,Default,,0,0,0,,Ракон ит дегеніміз не? Ракон ит дегеніміз не?
Dialogue: 0,1:16:02.26,1:16:04.81,Default,,0,0,0,,Тынш! Сіз оны табасыз, Дораемон
Dialogue: 0,1:16:04.93,1:16:07.47,Default,,0,0,0,,Бұрын мысықты көрмегеніңізге сенімдімін.
Dialogue: 0,1:16:07.60,1:16:09.77,Default,,0,0,0,,Сондықтан ракон иттер онша көп емес
Dialogue: 0,1:16:09.89,1:16:12.77,Default,,0,0,0,,Ханзада, бұл кімдер?
Dialogue: 0,1:16:12.90,1:16:15.86,Default,,0,0,0,,Бұл сыртқы әлемнен келген батыл адамдар.
Dialogue: 0,1:16:15.98,1:16:18.19,Default,,0,0,0,,Не! сыртқы әлемнен
Dialogue: 0,1:16:18.44,1:16:23.20,Default,,0,0,0,,Рахмет, Мәртебелі Бованко І-нің пайғамбарлығы рас болды ма?
Dialogue: 0,1:16:23.41,1:16:25.53,Default,,0,0,0,,Пайғамбарлық дегеніміз не?
Dialogue: 0,1:16:25.66,1:16:28.66,Default,,0,0,0,,Бұл патша әулетінде қалған ескі аңыз.
Dialogue: 0,1:16:29.45,1:16:33.33,Default,,0,0,0,,«Ел дүр сілкіндірсе, 10 шетелдік келеді...»
Dialogue: 0,1:16:33.46,1:16:35.67,Default,,0,0,0,,«Алып құдайдың жүрегін қозғау»
Dialogue: 0,1:16:35.88,1:16:39.63,Default,,0,0,0,,10 шетелдіктер? Біз туралы ма?
Dialogue: 0,1:16:39.76,1:16:41.88,Default,,0,0,0,,Өйткені бес адам ғана.
Dialogue: 0,1:16:42.01,1:16:44.55,Default,,0,0,0,,Қалған бесеуі қайдан шығады?
Dialogue: 0,1:16:44.89,1:16:47.06,Default,,0,0,0,,Оның келуі мүмкін емес, солай ма?
Dialogue: 0,1:16:47.85,1:16:51.10,Default,,0,0,0,,Алып құдайдың жүрегін елжірету деген нені білдіреді?
Dialogue: 0,1:16:51.23,1:16:52.56,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,1:16:52.69,1:16:56.19,Default,,0,0,0,,Дегенмен алып мүсіннің іші қуыс сияқты.
Dialogue: 0,1:16:56.32,1:16:59.03,Default,,0,0,0,,Ішке кірсеңіз, бірдеңе білуіңіз мүмкін.
Dialogue: 0,1:16:59.69,1:17:01.11,Default,,0,0,0,,Ичи немесе барабан таяқшасы?
Dialogue: 0,1:17:01.24,1:17:03.24,Default,,0,0,0,,Әй?
Dialogue: 0,1:17:04.03,1:17:05.41,Default,,0,0,0,,Ах
Dialogue: 0,1:17:05.49,1:17:08.87,Default,,0,0,0,,Қарным ашты, өлетін шығармын
Dialogue: 0,1:17:08.95,1:17:12.25,Default,,0,0,0,,Ойланып қарасам, көптен бері ештеңе жеген жоқпын.
Dialogue: 0,1:17:12.37,1:17:13.37,Default,,0,0,0,,Мм... (ішінің шуылдауы)
Dialogue: 0,1:17:13.50,1:17:14.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:14.46,1:17:16.38,Default,,0,0,0,,Біз бірдеңе істеуіміз керек
Dialogue: 0,1:17:17.13,1:17:19.34,Default,,0,0,0,,Алдын ала уәде беру машинасы
Dialogue: 0,1:17:19.80,1:17:24.01,Default,,0,0,0,,Егер сіз мұны міндеттесеңіз, нәтижені болжай аласыз.
Dialogue: 0,1:17:24.13,1:17:25.30,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:25.68,1:17:27.51,Default,,0,0,0,,Жарайды, мен жасап көремін.
Dialogue: 0,1:17:27.64,1:17:31.35,Default,,0,0,0,,Уәде беремін, ертең міндетті түрде кешкі ас ішеміз.
Dialogue: 0,1:17:31.48,1:17:33.52,Default,,0,0,0,,Қазір ішіңізді өсіріңіз
Dialogue: 0,1:17:33.64,1:17:35.73,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:17:35.85,1:17:37.77,Default,,0,0,0,,Иә? (иіскеу дыбысы)
Dialogue: 0,1:17:37.90,1:17:40.94,Default,,0,0,0,,Иә? Бір нәрсенің иісі жақсы.
Dialogue: 0,1:17:41.53,1:17:44.95,Default,,0,0,0,,Дәмді дәм ауызға тарайды
Dialogue: 0,1:17:45.07,1:17:46.41,Default,,0,0,0,,Бұл рас!
Dialogue: 0,1:17:46.70,1:17:49.74,Default,,0,0,0,,Мен енді тамақ іше алмаймын
Dialogue: 0,1:17:49.87,1:17:51.50,Default,,0,0,0,,Бұл мені таң қалдырды
Dialogue: 0,1:17:51.62,1:17:56.12,Default,,0,0,0,,Оның орнына ертең бүгінгі порцияны жейсің.
Dialogue: 0,1:17:56.25,1:17:58.79,Default,,0,0,0,,Дора-чан, сен маған сол құралды бере аласың ба?
Dialogue: 0,1:17:58.92,1:18:00.46,Default,,0,0,0,,Сіз әлі тамақтанып жатырсыз ба?
Dialogue: 0,1:18:00.88,1:18:02.51,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,1:18:02.63,1:18:06.64,Default,,0,0,0,,Уәде беремін, мен міндетті түрде жуынамын.
Dialogue: 0,1:18:06.76,1:18:09.26,Default,,0,0,0,,Қазір денемді жуайын.
Dialogue: 0,1:18:10.26,1:18:13.73,Default,,0,0,0,,Жарайды, сергітіп жіберді.
Dialogue: 0,1:18:13.85,1:18:14.94,Default,,0,0,0,,…ол үстем болатынына сенді.
Dialogue: 0,1:18:15.39,1:18:17.60,Default,,0,0,0,,Қайырлы түн
Dialogue: 0,1:18:18.02,1:18:21.11,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,1:18:26.53,1:18:28.53,Default,,0,0,0,,Пи
Dialogue: 0,1:18:33.50,1:18:36.79,Default,,0,0,0,,Хе! Ха! Алақай!
Dialogue: 0,1:18:37.29,1:18:39.25,Default,,0,0,0,,Не? Ха!
Dialogue: 0,1:18:40.54,1:18:44.72,Default,,0,0,0,,Брюс ханшайымы... Спиана ханшайымы қауіпсіз бе?
Dialogue: 0,1:18:44.97,1:18:49.18,Default,,0,0,0,,Мен сарайдың ішінде қамалып қалдым, бірақ мен аманмын.
Dialogue: 0,1:18:49.30,1:18:54.43,Default,,0,0,0,,Ол патшалық үшін күндіз-түні құлшылық етіп жүрген көрінеді.
Dialogue: 0,1:18:56.64,1:18:58.15,Default,,0,0,0,,Хаа!
Dialogue: 0,1:18:59.19,1:19:01.15,Default,,0,0,0,,Сәлем! Пеко!
Dialogue: 0,1:19:01.48,1:19:05.15,Default,,0,0,0,,Бұл жақсы емес пе? Егер сіз табылсаңыз не істейсіз?
Dialogue: 0,1:19:05.28,1:19:06.86,Default,,0,0,0,,Нобита-сан
Dialogue: 0,1:19:08.53,1:19:12.28,Default,,0,0,0,,Кешіріңіз, мен ұйықтай алмаймын.
Dialogue: 0,1:19:12.41,1:19:17.33,Default,,0,0,0,,Хмм, мен дыбысты 3 секундтан кейін сезінемін.
Dialogue: 0,1:19:18.75,1:19:20.54,Default,,0,0,0,,Нобита-сан (Нобита) иә?
Dialogue: 0,1:19:20.67,1:19:24.96,Default,,0,0,0,,Мен бұл елдің патшасы болуға лайықтымын ба?
Dialogue: 0,1:19:25.09,1:19:26.13,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:26.63,1:19:29.09,Default,,0,0,0,,Мен ештеңені қорғай алмадым.
Dialogue: 0,1:19:29.22,1:19:33.56,Default,,0,0,0,,Менің әкем, Спиана ханшайымы және Чиппоның ата-анасы.
Dialogue: 0,1:19:34.10,1:19:36.52,Default,,0,0,0,,Халық қиналып жатса да...
Dialogue: 0,1:19:36.64,1:19:39.27,Default,,0,0,0,,Біздің қолымыздан келер нәрсе – ескі аңыздарға жабысу.
Dialogue: 0,1:19:39.90,1:19:43.11,Default,,0,0,0,,Мен өзімді аяймын
Dialogue: 0,1:19:43.32,1:19:44.86,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:47.53,1:19:49.24,Default,,0,0,0,,Пеко керемет.
Dialogue: 0,1:19:49.36,1:19:50.20,Default,,0,0,0,,Ах
Dialogue: 0,1:19:50.95,1:19:54.20,Default,,0,0,0,,Мен бар күшімді салып жатырмын
Dialogue: 0,1:19:54.33,1:19:57.45,Default,,0,0,0,,Мен тесттен 0 ұпай алдым және бейсболда нашармын.
Dialogue: 0,1:19:57.58,1:20:00.17,Default,,0,0,0,,Мені үнемі әркім айғайлайды.
Dialogue: 0,1:20:00.58,1:20:01.58,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:02.71,1:20:04.04,Default,,0,0,0,,Бірақ
Dialogue: 0,1:20:04.80,1:20:08.17,Default,,0,0,0,,Тесттен бір рет қана 100 балл алдым.
Dialogue: 0,1:20:08.59,1:20:11.43,Default,,0,0,0,,Мен сол кезде бақытты едім.
Dialogue: 0,1:20:11.80,1:20:14.30,Default,,0,0,0,,Маған ешкім сенбеді.
Dialogue: 0,1:20:14.60,1:20:17.89,Default,,0,0,0,,Мен бір рет үйге жүгірдім.
Dialogue: 0,1:20:18.23,1:20:22.23,Default,,0,0,0,,Көзімді жұмып, қолымнан келгенше ұрдым, соқты.
Dialogue: 0,1:20:22.35,1:20:25.61,Default,,0,0,0,,Тіпті таңғалғаным сонша, жүгіруді ұмытып кеттім.
Dialogue: 0,1:20:25.73,1:20:27.07,Default,,0,0,0,,Хаха... (Нобита) Ах...
Dialogue: 0,1:20:27.23,1:20:28.94,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,1:20:29.07,1:20:32.82,Default,,0,0,0,,Кешіріңіз, мен әңгімеге тым берілдім.
Dialogue: 0,1:20:32.95,1:20:34.57,Default,,0,0,0,,(Дарио) Хе-хе-хе-хе. Эй, қарашы — бұл апат!
Dialogue: 0,1:20:34.95,1:20:38.37,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың?
Dialogue: 0,1:20:38.50,1:20:41.92,Default,,0,0,0,,Сонымен менің айтайын дегенім...
Dialogue: 0,1:20:42.00,1:20:43.38,Default,,0,0,0,,Хехехе
Dialogue: 0,1:20:43.50,1:20:44.96,Default,,0,0,0,,Пеко па?
Dialogue: 0,1:20:45.42,1:20:46.63,Default,,0,0,0,,(Серо) Тіпті бастауыш сынып оқушысы кенеттен «Қорықпа!» деп айқайлады.
Dialogue: 0,1:20:47.05,1:20:48.09,Default,,0,0,0,,Ах
Dialogue: 0,1:20:50.09,1:20:50.92,Default,,0,0,0,,Ах...
Dialogue: 0,1:20:51.72,1:20:56.81,Default,,0,0,0,,Менің айтайын дегенім, сенен жақсы патша болатынына сенімдімін.
Dialogue: 0,1:20:56.93,1:20:58.89,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:21:00.77,1:21:01.85,Default,,0,0,0,,Иә
Dialogue: 0,1:21:15.78,1:21:17.45,Default,,0,0,0,,О, құдай!
Dialogue: 0,1:21:17.58,1:21:21.96,Default,,0,0,0,,Осыншама сарбазды жұмылдыра отырып, бір ғана із таба аласыз ба?
Dialogue: 0,1:21:22.37,1:21:27.38,Default,,0,0,0,,Аспанға көтерілдіңіз бе, жерге батып кеттіңіз бе? Тіпті жаудың өзі мұны жақсы жасайды.
Dialogue: 0,1:21:27.46,1:21:30.51,Default,,0,0,0,,Аузыңды жап! Бұл тіпті құбыжық емес.
Dialogue: 0,1:21:30.63,1:21:33.38,Default,,0,0,0,,Өтінемін, тыныш отырыңыз. (Дублендер) Иә?
Dialogue: 0,1:21:33.76,1:21:39.39,Default,,0,0,0,,Олар түн жамылып алып мүсінді көздеген шығар.
Dialogue: 0,1:21:39.89,1:21:42.35,Default,,0,0,0,,Мұны қайдан білесіз?
Dialogue: 0,1:21:42.64,1:21:46.31,Default,,0,0,0,,Корольдік әулет арқылы жеткен көне пайғамбарлық бар.
Dialogue: 0,1:21:47.11,1:21:51.28,Default,,0,0,0,,«Ел дүр сілкіндіргенде, 10 шетелдік келеді...»
Dialogue: 0,1:21:51.61,1:21:55.03,Default,,0,0,0,,«Алып құдайдың жүрегін қозғау»
Dialogue: 0,1:22:00.16,1:22:03.25,Default,,0,0,0,,үшінмыз, біз алып мүсіннің ғибадатханасына жақындап қалдық.
Dialogue: 0,1:22:05.00,1:22:06.83,Default,,0,0,0,,Бұл таңқаларлық жылдам болды.
Dialogue: 0,1:22:06.96,1:22:09.21,Default,,0,0,0,,Іздеуден бас тартқаныма сенімдімін.
Dialogue: 0,1:22:10.88,1:22:14.67,Default,,0,0,0,,Тым тыныш. Солдаттар қайда кетті?
Dialogue: 0,1:22:15.09,1:22:17.39,Default,,0,0,0,,Бұл...
Dialogue: 0,1:22:23.22,1:22:24.35,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,1:22:28.77,1:22:30.77,Default,,0,0,0,,Ол кетті, ол әлі Ванака!
Dialogue: 0,1:22:31.07,1:22:34.11,Default,,0,0,0,,Бұл алып мүсін дерлік еді.
Dialogue: 0,1:22:34.24,1:22:35.70,Default,,0,0,0,,Уау!
Dialogue: 0,1:22:37.03,1:22:38.53,Default,,0,0,0,,Брюс! (Солдат) Брюс!
Dialogue: 0,1:22:38.66,1:22:39.78,Default,,0,0,0,,Хмф!
Dialogue: 0,1:22:41.83,1:22:45.08,Default,,0,0,0,,Мұны маған қалдырыңыз, ханзада алып мүсінге барады.
Dialogue: 0,1:22:45.16,1:22:47.08,Default,,0,0,0,,(Бурстың айқайы)
Dialogue: 0,1:22:47.42,1:22:49.00,Default,,0,0,0,,Чиппо! иә
Dialogue: 0,1:22:49.08,1:22:51.13,Default,,0,0,0,,Мен сұрадым, Брюс!
Dialogue: 0,1:22:53.88,1:22:58.01,Default,,0,0,0,,Балалар! Дегенмен, ол Бованко патшалығының мақтан тұтатын жауынгері!
Dialogue: 0,1:22:58.34,1:23:00.01,Default,,0,0,0,,Иә!
Dialogue: 0,1:23:02.72,1:23:03.97,Default,,0,0,0,,Уау
Dialogue: 0,1:23:05.60,1:23:08.56,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,1:23:09.90,1:23:10.81,Default,,0,0,0,,Біз бәріміз бірге отырып, бір шыныаяқ ішкен күн де болар еді.
Dialogue: 0,1:23:12.11,1:23:13.94,Default,,0,0,0,,Ол өмір энергиясына толы—
Dialogue: 0,1:23:16.65,1:23:19.95,Default,,0,0,0,,Алып мүсінге жетсең, міндетті түрде жол ашылады!
Dialogue: 0,1:23:20.07,1:23:23.16,Default,,0,0,0,,Оған дейін аман бол, Брюс.
Dialogue: 0,1:23:23.83,1:23:26.58,Default,,0,0,0,,Қараңдар! Алып мүсін дәл сіздің алдыңызда
Dialogue: 0,1:23:26.66,1:23:27.37,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:23:27.37,1:23:28.04,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:23:27.37,1:23:28.04,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:23:28.04,1:23:28.16,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:23:28.16,1:23:29.58,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:23:28.16,1:23:29.58,Default,,0,0,0,,А, а?
Dialogue: 0,1:23:34.80,1:23:36.76,Default,,0,0,0,,Уау
Dialogue: 0,1:23:38.93,1:23:39.93,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,1:23:40.05,1:23:41.64,Default,,0,0,0,,Бұл от жағатын көлік.
Dialogue: 0,1:23:41.76,1:23:42.93,Default,,0,0,0,,Дубландер!
Dialogue: 0,1:23:43.05,1:23:45.27,Default,,0,0,0,,Сіз ежелгі қаруды аяқтадыңыз ба?
Dialogue: 0,1:23:45.85,1:23:47.81,Default,,0,0,0,,үшін орманның тереңінде
Dialogue: 0,1:23:48.48,1:23:49.56,Default,,0,0,0,,Кеттік
Dialogue: 0,1:23:50.90,1:23:53.15,Default,,0,0,0,,Жалған ханзада мен оның бандысын айту
Dialogue: 0,1:23:53.98,1:23:56.99,Default,,0,0,0,,Бұл орман толығымен қоршалған.
Dialogue: 0,1:23:57.11,1:24:00.11,Default,,0,0,0,,Беріңіз де, қазір шығыңыз!
Dialogue: 0,1:24:02.03,1:24:04.99,Default,,0,0,0,,Қайталаңыз! Беріп, шық!
Dialogue: 0,1:24:05.12,1:24:07.29,Default,,0,0,0,,Мен сенің өміріңді аяймын.
Dialogue: 0,1:24:07.66,1:24:11.12,Default,,0,0,0,,Бұл өтірік. Кетсең міндетті түрде өлтіресің.
Dialogue: 0,1:24:11.67,1:24:14.46,Default,,0,0,0,,Хмф, жасырудың қажеті жоқ.
Dialogue: 0,1:24:14.59,1:24:15.63,Default,,0,0,0,,Жаса! (Солдат) Ха!
Dialogue: 0,1:24:24.80,1:24:26.72,Default,,0,0,0,,Джунглиді өртеңіз!
Dialogue: 0,1:24:26.85,1:24:28.93,Default,,0,0,0,,Оларды әшкерелейік!
Dialogue: 0,1:24:31.35,1:24:35.40,Default,,0,0,0,,Жарыс болған сияқты.
Dialogue: 0,1:24:35.82,1:24:38.94,Default,,0,0,0,,Бұл менің кесірімнен болды...
Dialogue: 0,1:24:39.07,1:24:40.86,Default,,0,0,0,,Кешірім сұрайтын сөздер жоқ
Dialogue: 0,1:24:42.11,1:24:45.03,Default,,0,0,0,,Осы орман арқылы оңтүстікке барсаңыз, көлге келесіз.
Dialogue: 0,1:24:45.16,1:24:47.08,Default,,0,0,0,,Ол жерден кет
Dialogue: 0,1:24:47.20,1:24:49.33,Default,,0,0,0,,Осы арада мен жауды тартамын.
Dialogue: 0,1:24:49.62,1:24:51.75,Default,,0,0,0,,Не! ? (Нобита) Жоқ! Болды
Dialogue: 0,1:24:51.87,1:24:53.54,Default,,0,0,0,,Жақында тұтқынға аласыз.
Dialogue: 0,1:24:53.92,1:24:58.71,Default,,0,0,0,,Біз енді шетелдіктерді тарта алмаймыз.
Dialogue: 0,1:24:58.84,1:25:00.51,Default,,0,0,0,,Chippo Иә
Dialogue: 0,1:25:02.22,1:25:04.59,Default,,0,0,0,,Мен сізге мұқият жол көрсетемін.
Dialogue: 0,1:25:04.72,1:25:05.97,Default,,0,0,0,,Ханзада…
Dialogue: 0,1:25:06.26,1:25:09.02,Default,,0,0,0,,Олай болса, Пеко, бірге барайық.
Dialogue: 0,1:25:09.14,1:25:11.94,Default,,0,0,0,,Неге тек адам әлемінде өмір сүрмеске?
Dialogue: 0,1:25:12.60,1:25:16.40,Default,,0,0,0,,Егер бұл орындалса, қандай қызық болар еді!
Dialogue: 0,1:25:16.94,1:25:22.11,Default,,0,0,0,,Бірақ мен ханзада ретінде қаша алмаймын.
Dialogue: 0,1:25:24.49,1:25:26.99,Default,,0,0,0,,үшінңыз, аман болыңыздар!
Dialogue: 0,1:25:27.12,1:25:27.83,Default,,0,0,0,,Пеко!
Dialogue: 0,1:25:38.00,1:25:40.00,Default,,0,0,0,,Жалғыз Пеко ештеңе істемейді
Dialogue: 0,1:25:40.59,1:25:41.59,Default,,0,0,0,,Мен де барамын!
Dialogue: 0,1:25:41.80,1:25:43.05,Default,,0,0,0,,Иә! ?
Dialogue: 0,1:25:43.17,1:25:45.43,Default,,0,0,0,,Жоқ... сен не айтып тұрсың, Джан?
Dialogue: 0,1:25:45.55,1:25:47.10,Default,,0,0,0,,Өлетін сияқты.
Dialogue: 0,1:25:47.22,1:25:48.43,Default,,0,0,0,,Шулы! (Сунео) Ах!
Dialogue: 0,1:25:48.72,1:25:51.02,Default,,0,0,0,,Тез жүгірмесең, айналаң отқа оранады.
Dialogue: 0,1:25:51.35,1:25:52.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:52.31,1:25:54.48,Default,,0,0,0,,Немесе... қалағаныңды істе!
Dialogue: 0,1:25:54.81,1:25:58.06,Default,,0,0,0,,Джан! Қайтып кел!
Dialogue: 0,1:26:00.57,1:26:05.91,Default,,0,0,0,,Такеши мырза әрқашан өзінше жауапкершілікті сезінеді.
Dialogue: 0,1:26:07.53,1:26:11.83,Default,,0,0,0,,Енді ол осылайша жауапкершілікті алуға тырысады.
Dialogue: 0,1:26:11.91,1:26:17.92,Default,,0,0,0,,♪～
Dialogue: 0,1:27:23.19,1:27:26.32,Default,,0,0,0,,Не болды? Ақыр соңында олар бірдей емес пе?
Dialogue: 0,1:27:26.44,1:27:28.70,Default,,0,0,0,,Иә, бәріміз бірдейміз.
Dialogue: 0,1:27:29.03,1:27:33.37,Default,,0,0,0,,Бұдан былай қандай жағдай болмасын, біз әрқашан бірге боламыз.
Dialogue: 0,1:27:33.49,1:27:34.74,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,1:27:34.87,1:27:39.58,Default,,0,0,0,,Жақсы! Кеттік, экспедиция тобы кетеді!
Dialogue: 0,1:27:39.71,1:27:41.46,Default,,0,0,0,,О!
Dialogue: 0,1:27:52.68,1:27:58.69,Default,,0,0,0,,～♪
Dialogue: 0,1:28:02.44,1:28:03.69,Default,,0,0,0,,Міне келдік
Dialogue: 0,1:28:07.61,1:28:12.07,Default,,0,0,0,,Ханзада күткендей, оның батылдығын мақтайық.
Dialogue: 0,1:28:12.66,1:28:14.08,Default,,0,0,0,,Түсіру?
Dialogue: 0,1:28:14.20,1:28:17.04,Default,,0,0,0,,Бұл өте қиын, тек осы жерден құтылыңыз.
Dialogue: 0,1:28:18.00,1:28:21.75,Default,,0,0,0,,Алып мүсінге жақындағанда бар жылдамдықпен жүгір.
Dialogue: 0,1:28:21.87,1:28:24.79,Default,,0,0,0,,Бір адам болса да ішке кірсе
Dialogue: 0,1:28:24.92,1:28:28.46,Default,,0,0,0,,Пайғамбарлықтың қалған бес шетелдікі ешқашан келмеді.
Dialogue: 0,1:28:28.59,1:28:30.22,Default,,0,0,0,,Ах! (Сунео) Қандай пайғамбарлық...
Dialogue: 0,1:28:30.34,1:28:32.01,Default,,0,0,0,,Сіз оған сене аласыз!
Dialogue: 0,1:28:32.55,1:28:33.97,Default,,0,0,0,,Иә!
Dialogue: 0,1:28:35.81,1:28:36.89,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,1:28:37.43,1:28:40.35,Default,,0,0,0,,Солдат дайын!
Dialogue: 0,1:28:40.85,1:28:42.27,Default,,0,0,0,,Әрине...
Dialogue: 0,1:28:44.77,1:28:45.73,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:28:45.82,1:28:47.73,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:28:48.90,1:28:51.61,Default,,0,0,0,,Қабыл ал! (Сарбаздар) Иә!
Dialogue: 0,1:28:51.70,1:28:53.57,Default,,0,0,0,,Қазір! толық жылдамдық!
Dialogue: 0,1:28:53.66,1:28:55.53,Default,,0,0,0,,Иә!
Dialogue: 0,1:28:55.62,1:28:57.99,Default,,0,0,0,,Мақсатқа бірден жету!
Dialogue: 0,1:28:58.08,1:28:59.75,Default,,0,0,0,,Иә!
Dialogue: 0,1:29:02.79,1:29:03.67,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,1:29:03.96,1:29:05.67,Default,,0,0,0,,О, міне!
Dialogue: 0,1:29:05.79,1:29:06.63,Default,,0,0,0,,Oh?
Dialogue: 0,1:29:11.84,1:29:12.97,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,1:29:13.38,1:29:14.47,Default,,0,0,0,,Бұл...
Dialogue: 0,1:29:15.14,1:29:16.93,Default,,0,0,0,,10 шетелдіктер?
Dialogue: 0,1:29:23.52,1:29:24.77,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,1:29:24.90,1:29:26.94,Default,,0,0,0,,Біз басқа топпыз ба?
Dialogue: 0,1:29:27.40,1:29:30.61,Default,,0,0,0,,Кейінірек таң қалмаңыз. Тезірек алып мүсіннің ішіне кіріңіз.
Dialogue: 0,1:29:30.90,1:29:33.07,Default,,0,0,0,,Сарбаздар қабылдады!
Dialogue: 0,1:29:33.15,1:29:39.16,Default,,0,0,0,,♪～
Dialogue: 0,1:30:03.60,1:30:05.44,Default,,0,0,0,,Аяқ астынан салыңыз.
Dialogue: 0,1:30:05.56,1:30:07.73,Default,,0,0,0,,Сіз мұны қайдан білесіз?
Dialogue: 0,1:30:09.07,1:30:11.19,Default,,0,0,0,,Осында кулонның нұрын шашыңыз
Dialogue: 0,1:30:11.57,1:30:12.65,Default,,0,0,0,,Иә
Dialogue: 0,1:30:20.66,1:30:21.70,Default,,0,0,0,,Кіреберіс!
Dialogue: 0,1:30:21.83,1:30:23.45,Default,,0,0,0,,Жүр, асығайық!
Dialogue: 0,1:30:26.33,1:30:29.92,Default,,0,0,0,,Нунуну... Сабер олардың соңынан жүр!
Dialogue: 0,1:30:30.38,1:30:32.34,Default,,0,0,0,,Ах (Сабель) Иә!
Dialogue: 0,1:30:32.96,1:30:33.71,Default,,0,0,0,,Сәлем! Менің артымнан 1-ші топ келеді
Dialogue: 0,1:30:33.71,1:30:35.51,Default,,0,0,0,,Өз бетімен! Менің артымнан 1-ші топ келеді
Dialogue: 0,1:30:33.71,1:30:35.51,Default,,0,0,0,,～♪
Dialogue: 0,1:30:35.51,1:30:35.63,Default,,0,0,0,,～♪
Dialogue: 0,1:30:35.63,1:30:38.18,Default,,0,0,0,,～♪
Dialogue: 0,1:30:35.63,1:30:38.18,Default,,0,0,0,,Алып тәңірдің жүрегіне жақындамасын!
Dialogue: 0,1:30:41.76,1:30:44.56,Default,,0,0,0,,Бір ғана нәрсені мақсат ет, Алланың жүрегі!
Dialogue: 0,1:30:46.89,1:30:49.19,Default,,0,0,0,,О, мінекей.
Dialogue: 0,1:30:50.61,1:30:52.57,Default,,0,0,0,,О (Сунео) Бұл тамаша!
Dialogue: 0,1:30:52.69,1:30:55.86,Default,,0,0,0,,Жоқ, жоқ, бұл қазына бөлмесі.
Dialogue: 0,1:30:55.99,1:30:58.49,Default,,0,0,0,,Не қызықсыз? (Сунео) Қазына...
Dialogue: 0,1:30:58.61,1:31:00.03,Default,,0,0,0,,Кеттік! (Сунео) Ах!
Dialogue: 0,1:31:00.28,1:31:01.03,Default,,0,0,0,,үшін, күте тұрыңдар~ Иә?
Dialogue: 0,1:31:01.03,1:31:03.66,Default,,0,0,0,,үшін, күте тұрыңдар~ Иә?
Dialogue: 0,1:31:01.03,1:31:03.66,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:31:03.79,1:31:04.95,Default,,0,0,0,,А-а, (Сабель) сонда!
Dialogue: 0,1:31:05.20,1:31:06.62,Default,,0,0,0,,Та... маған көмектес!
Dialogue: 0,1:31:06.75,1:31:07.92,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:31:10.67,1:31:11.63,Default,,0,0,0,,Ах!
Dialogue: 0,1:31:13.59,1:31:15.46,Default,,0,0,0,,Бұл не? Мен қайдамын?
Dialogue: 0,1:31:16.22,1:31:19.05,Default,,0,0,0,,Сол баспалдақтың соңында Құдайдың жүрегі орналасқан.
Dialogue: 0,1:31:19.55,1:31:21.64,Default,,0,0,0,,Жарайды, тезірек барайық.
Dialogue: 0,1:31:24.14,1:31:26.85,Default,,0,0,0,,Уау! Дораемон!
Dialogue: 0,1:31:26.93,1:31:27.85,Default,,0,0,0,,Ах!
Dialogue: 0,1:31:27.98,1:31:30.31,Default,,0,0,0,,Осы қарбалас уақытта
Dialogue: 0,1:31:30.44,1:31:32.32,Default,,0,0,0,,Атақты қылыш Денкомару!
Dialogue: 0,1:31:32.44,1:31:35.44,Default,,0,0,0,,Көп уақыт болды... иә?
Dialogue: 0,1:31:35.61,1:31:37.28,Default,,0,0,0,,Ендеше тоқтатыңыз!
Dialogue: 0,1:31:37.40,1:31:38.65,Default,,0,0,0,,Иә! ?
Dialogue: 0,1:31:38.78,1:31:40.36,Default,,0,0,0,,Ахх
Dialogue: 0,1:31:40.70,1:31:45.54,Default,,0,0,0,,Сіз қазіргіден асып түсу үшін өте білікті болуыңыз керек.
Dialogue: 0,1:31:45.66,1:31:46.75,Default,,0,0,0,,Енді жарысатын кез келді!
Dialogue: 0,1:31:48.33,1:31:50.17,Default,,0,0,0,,Уау (Сәбиль) О, жоқ!
Dialogue: 0,1:31:52.00,1:31:53.13,Default,,0,0,0,,Бұл бөлме.
Dialogue: 0,1:31:53.88,1:31:56.09,Default,,0,0,0,,(үшін ауыр тыныс алады)
Dialogue: 0,1:31:59.18,1:32:00.05,Default,,0,0,0,,Хмм.
Dialogue: 0,1:32:02.51,1:32:03.51,Default,,0,0,0,,Ах...
Dialogue: 0,1:32:08.60,1:32:11.98,Default,,0,0,0,,Бұл жүрек пішінді мүсін - алып құдайдың жүрегі.
Dialogue: 0,1:32:12.10,1:32:13.19,Default,,0,0,0,,Ах!
Dialogue: 0,1:32:13.69,1:32:16.36,Default,,0,0,0,,Мен мұны істеуім керек пе?
Dialogue: 0,1:32:16.86,1:32:18.53,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:32:20.66,1:32:22.66,Default,,0,0,0,,Оны бұранда сияқты бұраңыз
Dialogue: 0,1:32:22.78,1:32:25.62,Default,,0,0,0,,Мен білмейтін нәрселер туралы сен көп білесің.
Dialogue: 0,1:32:26.45,1:32:28.66,Default,,0,0,0,,Фуфуфу Жарайды.
Dialogue: 0,1:32:29.71,1:32:32.42,Default,,0,0,0,,Ой (Сунео) жарылыс
Dialogue: 0,1:32:33.92,1:32:35.42,Default,,0,0,0,,Міне (Солдат) Уау!
Dialogue: 0,1:32:36.67,1:32:37.55,Default,,0,0,0,,Бум!
Dialogue: 0,1:32:37.80,1:32:39.09,Default,,0,0,0,,Ойлағанымдай, жұдырығыммен тиіп,
Dialogue: 0,1:32:39.80,1:32:43.30,Default,,0,0,0,,Нунунуну... небәрі 5 немесе 10 бала.
Dialogue: 0,1:32:43.43,1:32:44.30,Default,,0,0,0,,Оны тез тазалаңыз!
Dialogue: 0,1:32:44.30,1:32:45.43,Default,,0,0,0,,Оны тез тазалаңыз!
Dialogue: 0,1:32:44.30,1:32:45.43,Default,,0,0,0,,(механикалық дыбыс)
Dialogue: 0,1:32:45.43,1:32:45.55,Default,,0,0,0,,(механикалық дыбыс)
Dialogue: 0,1:32:45.55,1:32:47.31,Default,,0,0,0,,(механикалық дыбыс)
Dialogue: 0,1:32:45.55,1:32:47.31,Default,,0,0,0,,Иә? Ахх
Dialogue: 0,1:32:49.85,1:32:52.23,Default,,0,0,0,,Мынау (Нобита) - отты сөндіретін көлік!
Dialogue: 0,1:32:53.94,1:32:54.69,Default,,0,0,0,,Ах!
Dialogue: 0,1:32:56.23,1:32:57.65,Default,,0,0,0,,Амансың ба? (Нобита) Иә
Dialogue: 0,1:32:57.65,1:32:58.28,Default,,0,0,0,,Амансың ба? (Нобита) Иә
Dialogue: 0,1:32:57.65,1:32:58.28,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,1:32:58.28,1:32:58.82,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,1:32:58.82,1:32:59.65,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,1:32:58.82,1:32:59.65,Default,,0,0,0,,Ах!
Dialogue: 0,1:33:04.24,1:33:07.99,Default,,0,0,0,,Бүкіл флот отпен атуға дайын
Dialogue: 0,1:33:08.12,1:33:09.12,Default,,0,0,0,,Өрт!
Dialogue: 0,1:33:10.87,1:33:12.54,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:33:12.83,1:33:15.00,Default,,0,0,0,,Алып мүсіннің артына тығылу
Dialogue: 0,1:33:15.29,1:33:16.96,Default,,0,0,0,,Нуу! (Нобита) Ммм
Dialogue: 0,1:33:17.09,1:33:17.96,Default,,0,0,0,,Уау
Dialogue: 0,1:33:18.67,1:33:20.72,Default,,0,0,0,,Ахх (Сабель) Эй!
Dialogue: 0,1:33:22.59,1:33:24.51,Default,,0,0,0,,Хмм, ойбай
Dialogue: 0,1:33:26.22,1:33:27.85,Default,,0,0,0,,Жасай бер! Фуфу фуфу фуфу
Dialogue: 0,1:33:28.56,1:33:29.77,Default,,0,0,0,,Сол кезде мен Кирамен есептесемін.
Dialogue: 0,1:33:29.93,1:33:32.23,Default,,0,0,0,,Иә... иә!
Dialogue: 0,1:33:32.31,1:33:33.31,Default,,0,0,0,,Уф
Dialogue: 0,1:33:34.77,1:33:35.65,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:33:35.77,1:33:37.19,Default,,0,0,0,,Батарея бітті
Dialogue: 0,1:33:37.32,1:33:38.23,Default,,0,0,0,,Өтірік! ?
Dialogue: 0,1:33:38.73,1:33:42.70,Default,,0,0,0,,Келмейсің бе? Олай болса, осы жерден кетейік!
Dialogue: 0,1:33:44.70,1:33:46.62,Default,,0,0,0,,Жоқ, мен қозғалмаймын.
Dialogue: 0,1:33:46.74,1:33:49.62,Default,,0,0,0,,Ол 5000 жыл тот басқан.
Dialogue: 0,1:33:50.91,1:33:54.58,Default,,0,0,0,,Заттарды бір-бірінен итерсек жұмыс істемейді. Бәріміз бірге жұмыс жасайық.
Dialogue: 0,1:33:55.00,1:33:59.05,Default,,0,0,0,,Оши Даусымды тыңда! Сейно
Dialogue: 0,1:33:59.38,1:34:02.97,Default,,0,0,0,,(барлық күш айқайлары)
Dialogue: 0,1:34:06.09,1:34:06.89,Default,,0,0,0,,Уау
Dialogue: 0,1:34:06.97,1:34:10.85,Default,,0,0,0,,(барлық күш айқайлары)
Dialogue: 0,1:34:13.35,1:34:16.27,Default,,0,0,0,,Ммм, менің қолым шегінде!
Dialogue: 0,1:34:17.15,1:34:20.23,Default,,0,0,0,,Берілме! достарыңызға сеніңіз
Dialogue: 0,1:34:20.98,1:34:24.20,Default,,0,0,0,,Берілме! Мен соңына дейін күресемін
Dialogue: 0,1:34:26.20,1:34:29.08,Default,,0,0,0,,(барлық күш айқайлары)
Dialogue: 0,1:34:33.00,1:34:34.54,Default,,0,0,0,,Құрметті Джан...
Dialogue: 0,1:34:37.54,1:34:38.96,Default,,0,0,0,,Ууууах!
Dialogue: 0,1:34:39.42,1:34:41.92,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,1:34:42.34,1:34:45.72,Default,,0,0,0,,Алданбаңыз!
Dialogue: 0,1:34:47.43,1:34:48.64,Default,,0,0,0,,Ах!
Dialogue: 0,1:34:49.76,1:34:50.60,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,1:34:54.73,1:34:55.77,Default,,0,0,0,,Уф
Dialogue: 0,1:34:59.94,1:35:01.52,Default,,0,0,0,,Керемет
Dialogue: 0,1:35:04.65,1:35:05.74,Default,,0,0,0,,Уф...
Dialogue: 0,1:35:09.32,1:35:11.08,Default,,0,0,0,,Капитан Сабер жеңілді!
Dialogue: 0,1:35:11.20,1:35:13.33,Default,,0,0,0,,Вааа, қаш!
Dialogue: 0,1:35:16.21,1:35:17.04,Default,,0,0,0,,Иә!
Dialogue: 0,1:35:17.16,1:35:19.54,Default,,0,0,0,,Алып мүсіннің жүрегін қозғадың.
Dialogue: 0,1:35:22.46,1:35:24.96,Default,,0,0,0,,Бұлттар жиналып жатыр
Dialogue: 0,1:35:28.88,1:35:30.97,Default,,0,0,0,,Жоқ... не?
Dialogue: 0,1:35:31.35,1:35:33.93,Default,,0,0,0,,Алып құдайдың жүрегі...
Dialogue: 0,1:35:45.23,1:35:47.28,Default,,0,0,0,,Бұл белгіде көрсетілмеген ғой, иә?
Dialogue: 0,1:35:47.40,1:35:48.82,Default,,0,0,0,,Императрица картасы!
Dialogue: 0,1:35:51.66,1:35:52.70,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:35:53.83,1:35:55.66,Default,,0,0,0,,Ах... а...
Dialogue: 0,1:35:56.33,1:35:57.25,Default,,0,0,0,,үшінна! Нобита-сан
Dialogue: 0,1:35:57.37,1:35:59.54,Default,,0,0,0,,Нобита-кун, асығыңыз!
Dialogue: 0,1:36:00.88,1:36:02.59,Default,,0,0,0,,Шыу!
Dialogue: 0,1:36:14.97,1:36:17.02,Default,,0,0,0,,Ууу
Dialogue: 0,1:36:18.35,1:36:19.89,Default,,0,0,0,,Балалар, қараңдаршы.
Dialogue: 0,1:36:20.02,1:36:20.98,Default,,0,0,0,,Әй?
Dialogue: 0,1:36:21.85,1:36:23.19,Default,,0,0,0,,Хехехе
Dialogue: 0,1:36:23.31,1:36:26.15,Default,,0,0,0,,Хо хо хо
Dialogue: 0,1:36:29.65,1:36:31.70,Default,,0,0,0,,(Алып мүсіннің гүрілі)
Dialogue: 0,1:36:31.99,1:36:33.66,Default,,0,0,0,,Егер осылай салқынқанды болып жүре берсең, сүйкімді жүзіңді бүлдіріп аласың.
Dialogue: 0,1:36:36.04,1:36:39.12,Default,,0,0,0,,Бүгін... алып мүсін қозғала бастады!
Dialogue: 0,1:36:40.25,1:36:43.38,Default,,0,0,0,,(сарбаздардың айқайы)
Dialogue: 0,1:36:43.92,1:36:47.76,Default,,0,0,0,,(Алып мүсіннің гүрілі)
Dialogue: 0,1:36:48.05,1:36:49.34,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:36:49.42,1:36:51.80,Default,,0,0,0,,Керемет! Алақай!
Dialogue: 0,1:36:52.13,1:36:54.93,Default,,0,0,0,,Құбыжық, мынаны же!
Dialogue: 0,1:36:57.68,1:36:59.73,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,1:37:00.10,1:37:03.10,Default,,0,0,0,,Біз мұны жасадық! (Солдат) Қараңдар!
Dialogue: 0,1:37:03.23,1:37:05.69,Default,,0,0,0,,Ах (солдаттар) Уау!
Dialogue: 0,1:37:05.81,1:37:07.69,Default,,0,0,0,,Қаш!
Dialogue: 0,1:37:09.24,1:37:11.53,Default,,0,0,0,,Ааа
Dialogue: 0,1:37:20.12,1:37:21.79,Default,,0,0,0,,(сарбаздардың айқайы)
Dialogue: 0,1:37:22.96,1:37:25.25,Default,,0,0,0,,(сарбаздардың айқайы)
Dialogue: 0,1:37:29.34,1:37:31.63,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:37:40.02,1:37:44.23,Default,,0,0,0,,Тас мүсін резеңке қуыршақ сияқты қалай қозғалады?
Dialogue: 0,1:37:44.35,1:37:46.52,Default,,0,0,0,,Бәрі жақсы, орында!
Dialogue: 0,1:37:47.57,1:37:49.86,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:37:50.65,1:37:52.49,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:37:52.74,1:37:55.91,Default,,0,0,0,,Сен тек тас болған соң не істеп жүрсің?
Dialogue: 0,1:37:56.03,1:37:58.45,Default,,0,0,0,,Иә, дауысты дайындаңыз.
Dialogue: 0,1:37:58.70,1:37:59.79,Default,,0,0,0,,Ха!
Dialogue: 0,1:38:06.79,1:38:09.21,Default,,0,0,0,,Дайын OK.
Dialogue: 0,1:38:10.38,1:38:12.55,Default,,0,0,0,,Зеңбірек атылды!
Dialogue: 0,1:38:19.81,1:38:20.97,Default,,0,0,0,,(үшін айқайлайды)
Dialogue: 0,1:38:22.18,1:38:23.52,Default,,0,0,0,,Ах!
Dialogue: 0,1:38:27.94,1:38:29.69,Default,,0,0,0,,Ха-ха-ха-ха…
Dialogue: 0,1:38:29.82,1:38:33.86,Default,,0,0,0,,Тауларды талқандайтын зеңбіректің құдіретін түсіндіңіз бе!
Dialogue: 0,1:38:34.19,1:38:36.41,Default,,0,0,0,,Барлық бомбаларды тастаңыз
Dialogue: 0,1:38:36.53,1:38:38.78,Default,,0,0,0,,Соңғы соққыны қазір беріңіз.
Dialogue: 0,1:38:39.03,1:38:41.24,Default,,0,0,0,,Сәттілік! Тұр, жүр!
Dialogue: 0,1:38:41.37,1:38:43.75,Default,,0,0,0,,Берілме, қозғал
Dialogue: 0,1:38:44.20,1:38:47.21,Default,,0,0,0,,Өтінемін, осы елді құтқар!
Dialogue: 0,1:38:51.42,1:38:54.76,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,1:38:56.13,1:38:59.09,Default,,0,0,0,,Не! ? Сіз әлі де қозғала аласыз!
Dialogue: 0,1:38:59.35,1:39:02.01,Default,,0,0,0,,Жоқ. Кемені дереу бұрыңыз!
Dialogue: 0,1:39:02.10,1:39:04.10,Default,,0,0,0,,Иә! Жақсы!
Dialogue: 0,1:39:04.22,1:39:05.93,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,1:39:08.40,1:39:10.19,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,1:39:10.27,1:39:11.69,Default,,0,0,0,,Жүр!
Dialogue: 0,1:39:12.73,1:39:15.11,Default,,0,0,0,,Жоқ, біз уақытында үлгермейміз!
Dialogue: 0,1:39:18.07,1:39:20.78,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,1:39:21.53,1:39:25.16,Default,,0,0,0,,(сарбаздардың айқайы)
Dialogue: 0,1:39:25.91,1:39:27.75,Default,,0,0,0,,Ах!
Dialogue: 0,1:39:28.83,1:39:32.54,Default,,0,0,0,,Иә! (Нобита мен оның достары күледі)
Dialogue: 0,1:39:33.25,1:39:36.42,Default,,0,0,0,,Доктор Косс, Давландер қайда?
Dialogue: 0,1:39:36.88,1:39:40.72,Default,,0,0,0,,Хмф! Мен баяғыда патша сарайына қашып кеттім.
Dialogue: 0,1:39:41.18,1:39:42.64,Default,,0,0,0,,Король сарайы…
Dialogue: 0,1:39:43.06,1:39:45.10,Default,,0,0,0,,А, Спиана ханшайымға қауіп төніп тұр!
Dialogue: 0,1:39:48.52,1:39:51.77,Default,,0,0,0,,Спиана ханшайым, менімен бірге қашыңыз.
Dialogue: 0,1:39:52.52,1:39:54.65,Default,,0,0,0,,Нунуну... аххх
Dialogue: 0,1:39:54.82,1:39:57.28,Default,,0,0,0,,Егер жақындасаң, мен осы жерден секіремін.
Dialogue: 0,1:39:57.70,1:39:59.74,Default,,0,0,0,,Маған қарсы шығасың ба?
Dialogue: 0,1:39:59.86,1:40:02.28,Default,,0,0,0,,Шық! Дубландер!
Dialogue: 0,1:40:02.41,1:40:03.24,Default,,0,0,0,,Уф
Dialogue: 0,1:40:04.70,1:40:07.25,Default,,0,0,0,,Бұл не... бұл... нені білдіреді?
Dialogue: 0,1:40:07.54,1:40:09.79,Default,,0,0,0,,Мен бәріне айттым
Dialogue: 0,1:40:09.92,1:40:12.88,Default,,0,0,0,,Ханзада өз өмірі үшін күресіп жатыр!
Dialogue: 0,1:40:12.96,1:40:15.88,Default,,0,0,0,,(Халықтың айқайы)
Dialogue: 0,1:40:15.96,1:40:18.63,Default,,0,0,0,,Ууу
Dialogue: 0,1:40:19.51,1:40:20.34,Default,,0,0,0,,Га
Dialogue: 0,1:40:20.72,1:40:23.60,Default,,0,0,0,,Бұлай болса, бірге өлейік!
Dialogue: 0,1:40:23.72,1:40:24.81,Default,,0,0,0,,Ах!
Dialogue: 0,1:40:26.43,1:40:28.14,Default,,0,0,0,,Дайын болыңыз! Ахх
Dialogue: 0,1:40:28.27,1:40:31.23,Default,,0,0,0,,Уа, ау, ау
Dialogue: 0,1:40:31.35,1:40:33.65,Default,,0,0,0,,Дөңгелек үшбұрыш…
Dialogue: 0,1:40:34.94,1:40:35.90,Default,,0,0,0,,Га
Dialogue: 0,1:40:36.61,1:40:38.32,Default,,0,0,0,,Үлкен мүсін!
Dialogue: 0,1:40:39.86,1:40:41.32,Default,,0,0,0,,Спиана ханшайымы!
Dialogue: 0,1:40:41.74,1:40:43.12,Default,,0,0,0,,Ханзада!
Dialogue: 0,1:40:49.66,1:40:53.17,Default,,0,0,0,,Мен сені қорғауға ант берсем де, кешір.
Dialogue: 0,1:40:53.42,1:40:57.00,Default,,0,0,0,,Жоқ, сіз уәдеңізде тұрдыңыз.
Dialogue: 0,1:40:57.13,1:41:00.63,Default,,0,0,0,,Енді мен сенің құшағында отырмын
Dialogue: 0,1:41:01.38,1:41:03.09,Default,,0,0,0,,Спиана ханшайымы
Dialogue: 0,1:41:04.55,1:41:07.06,Default,,0,0,0,,Романтикалық (Сунео) хехехе
Dialogue: 0,1:41:07.77,1:41:10.23,Default,,0,0,0,,Иә?
Dialogue: 0,1:41:10.77,1:41:13.65,Default,,0,0,0,,О! Үлкен мүсін
Dialogue: 0,1:41:14.44,1:41:16.86,Default,,0,0,0,,Жаңа патша аман болсын!
Dialogue: 0,1:41:16.98,1:41:19.90,Default,,0,0,0,,Жаңа патша аман болсын!
Dialogue: 0,1:41:20.03,1:41:21.86,Default,,0,0,0,,Жаңа патша аман болсын!
Dialogue: 0,1:41:21.95,1:41:24.24,Default,,0,0,0,,Жаңа патша аман болсын!
Dialogue: 0,1:41:25.70,1:41:29.37,Default,,0,0,0,,Бованко патшалығы аман болсын!
Dialogue: 0,1:41:31.66,1:41:34.83,Default,,0,0,0,,Бірақ бізге көмектескен кімсіз...
Dialogue: 0,1:41:35.25,1:41:38.84,Default,,0,0,0,,Біз уақыт машинасындағы болашақтанбыз.
Dialogue: 0,1:41:38.96,1:41:40.55,Default,,0,0,0,,Хехе, түсіндің бе?
Dialogue: 0,1:41:41.09,1:41:44.51,Default,,0,0,0,,Сол кезде мен алдын ала уәде беру машинасын пайдаланып уәде бердім.
Dialogue: 0,1:41:44.93,1:41:48.76,Default,,0,0,0,,Үйге аман-есен оралсам, уақытты міндетті түрде кері қайтарамын...
Dialogue: 0,1:41:48.89,1:41:51.43,Default,,0,0,0,,Бізге көмекке оралу
Dialogue: 0,1:41:51.52,1:41:52.94,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:41:53.06,1:41:54.39,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,1:41:55.56,1:41:58.52,Default,,0,0,0,,Олай болса, уәдеңде тұратыныңа сенімдімін.
Dialogue: 0,1:41:58.65,1:41:59.65,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,1:41:59.78,1:42:01.82,Default,,0,0,0,,Кез келген жерде жаңа есік
Dialogue: 0,1:42:01.94,1:42:03.40,Default,,0,0,0,,Сәлем, сәлем
Dialogue: 0,1:42:03.65,1:42:05.95,Default,,0,0,0,,Олай болса, барымызды салайық.
Dialogue: 0,1:42:06.07,1:42:08.33,Default,,0,0,0,,Сіз бізді құтқардыңыз (Сунео) сау болыңыз
Dialogue: 0,1:42:08.41,1:42:09.62,Default,,0,0,0,,Ол айналып өткеннен кейін әлсіз жақтарымнан шағын соққылар береді.
Dialogue: 0,1:42:09.74,1:42:15.33,Default,,0,0,0,,10 шетелдіктің жұмбағы шешілді, бірақ бұл күрделі оқиға.
Dialogue: 0,1:42:17.63,1:42:19.04,Default,,0,0,0,,Уау!
Dialogue: 0,1:42:19.17,1:42:23.01,Default,,0,0,0,,Бұл сіздің талғамыңызға сай келе ме, білмеймін, бірақ ләззат алыңыз.
Dialogue: 0,1:42:23.26,1:42:25.26,Default,,0,0,0,,Итадакимасу!
Dialogue: 0,1:42:25.38,1:42:28.68,Default,,0,0,0,,Бірақ екі күн бойы жеткілікті тамақ жеу қиын.
Dialogue: 0,1:42:28.80,1:42:31.43,Default,,0,0,0,,Онда маған бер! (Сунео) О, Джан!
Dialogue: 0,1:42:31.52,1:42:33.81,Default,,0,0,0,,Мен тамақ ішуге барынша тырысуым керек.
Dialogue: 0,1:42:33.93,1:42:35.44,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,1:42:35.89,1:42:38.52,Default,,0,0,0,,Мұны жуыңыз! (Даяшы) Мұнда да солай.
Dialogue: 0,1:42:38.81,1:42:41.98,Default,,0,0,0,,Неліктен біз ыдыстарды жууымыз керек?
Dialogue: 0,1:42:42.11,1:42:44.40,Default,,0,0,0,,Мен енді Брутеллиге ілесе алмаймын!
Dialogue: 0,1:42:44.74,1:42:48.20,Default,,0,0,0,,Мм... Менің тағы бір жеке уәдем бар...
Dialogue: 0,1:42:48.32,1:42:49.66,Default,,0,0,0,,Бұл ванна, солай емес пе?
Dialogue: 0,1:42:49.78,1:42:51.37,Default,,0,0,0,,Ол дайын. Ах!
Dialogue: 0,1:42:51.99,1:42:55.29,Default,,0,0,0,,Уау, үлкен ванна! Ухуху
Dialogue: 0,1:42:55.37,1:42:59.08,Default,,0,0,0,,Жүзейік, иә?
Dialogue: 0,1:42:59.21,1:43:00.25,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:43:00.59,1:43:02.09,Default,,0,0,0,,Мен сабын сатушымын.
Dialogue: 0,1:43:02.21,1:43:03.38,Default,,0,0,0,,Мен шаш жуушымын.
Dialogue: 0,1:43:03.51,1:43:05.47,Default,,0,0,0,,Душ қызметкері (қызметші) Массаж бойынша қызметші
Dialogue: 0,1:43:05.59,1:43:07.97,Default,,0,0,0,,Парфюмерия сатушы (қызметші) Ұнтақ сатушы
Dialogue: 0,1:43:08.34,1:43:11.93,Default,,0,0,0,,Эй... мен өзім кіре аламын~ Иян
Dialogue: 0,1:43:13.27,1:43:16.89,Default,,0,0,0,,үшінңызға көп рахмет
Dialogue: 0,1:43:17.23,1:43:18.90,Default,,0,0,0,,Есімдерің кім?
Dialogue: 0,1:43:19.02,1:43:22.36,Default,,0,0,0,,Ол патшалық тарихында мәңгі қалады.
Dialogue: 0,1:43:22.86,1:43:27.28,Default,,0,0,0,,Рахмет ретінде Бованконың қазынасын әкеліңіз.
Dialogue: 0,1:43:27.36,1:43:28.24,Default,,0,0,0,,Уау!
Dialogue: 0,1:43:28.36,1:43:31.33,Default,,0,0,0,,Біз мұндай нәрсе үшін күрескен жоқпыз.
Dialogue: 0,1:43:31.45,1:43:33.54,Default,,0,0,0,,А... Куу
Dialogue: 0,1:43:33.66,1:43:36.46,Default,,0,0,0,,Бұл қазынаны патшалықты қалпына келтіруді қаржыландыру үшін пайдаланыңыз!
Dialogue: 0,1:43:36.58,1:43:37.29,Default,,0,0,0,,Ихихи
Dialogue: 0,1:43:38.79,1:43:41.79,Default,,0,0,0,,Пеко, сенің жақсы патша болатыныңа сенімдімін.
Dialogue: 0,1:43:41.92,1:43:45.26,Default,,0,0,0,,Иә, Нобита-сан да, сау болыңыз.
Dialogue: 0,1:43:55.27,1:43:57.27,Default,,0,0,0,,Ал... (Шнаузер) Мынау да, анау да.
Dialogue: 0,1:43:57.39,1:43:58.64,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:43:59.31,1:44:02.44,Default,,0,0,0,,Аш болсаң, кез келген уақытта кел.
Dialogue: 0,1:44:02.56,1:44:05.53,Default,,0,0,0,,Мен көп шұжық дайындаймын.
Dialogue: 0,1:44:05.98,1:44:08.65,Default,,0,0,0,,Иә, мен сізге міндетті түрде келемін.
Dialogue: 0,1:44:08.82,1:44:11.49,Default,,0,0,0,,Әрине, әрине...
Dialogue: 0,1:44:20.54,1:44:22.83,Default,,0,0,0,,Бәріңмен сау болыңдар, көріскенше
Dialogue: 0,1:44:23.25,1:44:25.34,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,1:44:32.55,1:44:33.72,Default,,0,0,0,,Хехе
Dialogue: 0,1:44:34.68,1:44:36.18,Default,,0,0,0,,Хехехе
Dialogue: 0,1:44:37.64,1:44:39.18,Default,,0,0,0,,Сол сұм Боинго! Ең болмағанда қазір! Мылтығым➡
Dialogue: 0,1:44:44.77,1:44:45.77,Default,,0,0,0,,Ах
Dialogue: 0,1:44:50.11,1:44:53.70,Default,,0,0,0,,Келіңдер, бәріміз патшалықты қалпына келтірейік!
Dialogue: 0,1:45:04.96,1:45:07.09,Default,,0,0,0,,Бұл тамаша шытырман оқиға болды.
Dialogue: 0,1:45:07.21,1:45:10.05,Default,,0,0,0,,Бұл ең жақсы жазғы демалыс, хаха
Dialogue: 0,1:45:11.68,1:45:16.43,Default,,0,0,0,,Біз өскенде де осындай шытырман оқиғаларға бара аламыз ба?
Dialogue: 0,1:45:16.51,1:45:17.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:45:27.23,1:45:29.82,Default,,0,0,0,,Бірақ бұл соңы емес.
Dialogue: 0,1:45:29.94,1:45:33.36,Default,,0,0,0,,Түсіндім, әлі бір уәде қалды.
Dialogue: 0,1:45:33.45,1:45:35.82,Default,,0,0,0,,Иә, сізде әлі бар ма?
Dialogue: 0,1:45:35.95,1:45:37.49,Default,,0,0,0,,Көңіл көтеріңіз!
Dialogue: 0,1:45:37.62,1:45:39.45,Default,,0,0,0,,Өзіңізге көмектесіңіз
Dialogue: 0,1:45:39.58,1:45:41.33,Default,,0,0,0,,Шағымдану! (Сунео) Жоқ, жоқ.
Dialogue: 0,1:45:41.71,1:45:44.29,Default,,0,0,0,,Көптеген құпия құралдармен
Dialogue: 0,1:45:44.88,1:45:47.21,Default,,0,0,0,,Менің бөлмемдегі уақыт машинасына
Dialogue: 0,1:45:47.29,1:45:50.09,Default,,0,0,0,,Алып мүсіннің сырын айтайық!
Dialogue: 0,1:45:50.21,1:45:51.72,Default,,0,0,0,,О!
Dialogue: 0,1:45:51.84,1:45:57.85,Default,,0,0,0,,♪～
Dialogue: 0,1:48:59.24,1:49:05.24,Default,,0,0,0,,～♪
