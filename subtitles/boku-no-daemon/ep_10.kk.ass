Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.54,0:00:09.16,Default,,0,0,0,,Ум...хии фуу мии...
Dialogue: 0,0:00:11.62,0:00:13.41,Default,,0,0,0,,А? А... бұл не?
Dialogue: 0,0:00:13.91,0:00:15.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:18.41,0:00:19.91,Default,,0,0,0,,Мау (ер) Мен мұны қалаймын...
Dialogue: 0,0:00:20.58,0:00:22.16,Default,,0,0,0,,Иә... Иә?
Dialogue: 0,0:00:22.91,0:00:24.08,Default,,0,0,0,,Мау?
Dialogue: 0,0:00:24.16,0:00:27.16,Default,,0,0,0,,О? Бұл ештеңе емес.
Dialogue: 0,0:00:27.25,0:00:29.87,Default,,0,0,0,,Мау Мау! Маумаума...
Dialogue: 0,0:00:30.70,0:00:33.00,Default,,0,0,0,,Мау мау мау мау...
Dialogue: 0,0:00:46.83,0:00:48.83,Default,,0,0,0,,Мм! Хмм!
Dialogue: 0,0:00:49.54,0:00:52.29,Default,,0,0,0,,Мааа! Жарайды... (Ұшатын тышқан) Сәл күте тұрыңыз...
Dialogue: 0,0:00:52.37,0:00:54.95,Default,,0,0,0,,Мау мау мау мау...
Dialogue: 0,0:00:55.04,0:00:56.08,Default,,0,0,0,,Очочо…
Dialogue: 0,0:00:56.16,0:00:59.95,Default,,0,0,0,,Мау мау мау мау...
Dialogue: 0,0:01:00.54,0:01:01.50,Default,,0,0,0,,Мааа!
Dialogue: 0,0:01:01.58,0:01:02.91,Default,,0,0,0,,Мау мау мау...
Dialogue: 0,0:01:09.25,0:01:10.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:10.54,0:01:13.20,Default,,0,0,0,,Хакатаға соңғы экспресс
Dialogue: 0,0:01:13.29,0:01:15.00,Default,,0,0,0,,Пойыз жақында жолға шығады.
Dialogue: 0,0:01:15.58,0:01:18.29,Default,,0,0,0,,Барлық жолаушылардың билеті болуы керек.
Dialogue: 0,0:01:18.37,0:01:21.12,Default,,0,0,0,,Отырар алдында билет қақпасын пайдаланыңыз.
Dialogue: 0,0:01:23.04,0:01:25.20,Default,,0,0,0,,Маған Хаката станциясына билет беріңізші!
Dialogue: 0,0:01:25.87,0:01:30.70,Default,,0,0,0,,«Хёго»
Dialogue: 0,0:01:36.33,0:01:37.29,Default,,0,0,0,,Қорытынды экспресс
Dialogue: 0,0:01:37.37,0:01:40.00,Default,,0,0,0,,Біздің қызметті пайдаланғаныңыз үшін рахмет.
Dialogue: 0,0:01:40.70,0:01:42.79,Default,,0,0,0,,Бұл пойыз Хакатаға барады.
Dialogue: 0,0:01:43.66,0:01:49.12,Default,,0,0,0,,Жол бойындағы аялдамалар: Окаяма, Хиросима, Шин-Ямагучи, Кокура…
Dialogue: 0,0:01:52.66,0:01:53.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:53.70,0:01:57.12,Default,,0,0,0,,Мау Мау (алты аяқ)
Dialogue: 0,0:01:57.20,0:01:58.12,Default,,0,0,0,,Мау~
Dialogue: 0,0:01:58.62,0:02:00.12,Default,,0,0,0,,Сен сияқты жігіт тазаруға тиіс.
Dialogue: 0,0:02:00.20,0:02:01.66,Default,,0,0,0,,Нана!
Dialogue: 0,0:02:16.87,0:02:18.87,Default,,0,0,0,,♪～
Dialogue: 0,0:03:37.12,0:03:39.12,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:03:37.12,0:03:39.12,Default,,0,0,0,,～♪
Dialogue: 0,0:03:39.12,0:03:42.00,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:03:47.50,0:03:49.91,Default,,0,0,0,,Бұл бейне 30 минут бұрынғы бейне.
Dialogue: 0,0:03:50.75,0:03:54.45,Default,,0,0,0,,Мен оны пойыздан тауып алдым.
Dialogue: 0,0:03:55.54,0:03:58.37,Default,,0,0,0,,Күні кеше мен бір баладан сапардың мақсатын сұрадым.
Dialogue: 0,0:03:59.00,0:04:01.25,Default,,0,0,0,,Кюсюді көздеп отыр
Dialogue: 0,0:04:01.33,0:04:03.91,Default,,0,0,0,,Олар уақыттың жындысын іздеп жүрген сияқты.
Dialogue: 0,0:04:04.00,0:04:05.75,Default,,0,0,0,,Уақыттың шайтаны?
Dialogue: 0,0:04:05.83,0:04:07.54,Default,,0,0,0,,Жай ғана қауесет
Dialogue: 0,0:04:07.62,0:04:10.95,Default,,0,0,0,,Хмм... егер ол шынымен бар болса
Dialogue: 0,0:04:11.04,0:04:13.95,Default,,0,0,0,,Мен оны бөлшектеп, ішіне қарағым келеді.
Dialogue: 0,0:04:14.04,0:04:15.41,Default,,0,0,0,,А... ауырады
Dialogue: 0,0:04:16.00,0:04:18.79,Default,,0,0,0,,Пойыздағы сақтаушы жынды бекітіңіз.
Dialogue: 0,0:04:19.45,0:04:21.50,Default,,0,0,0,,Жолда біреуді жасырып кіргізіңіз
Dialogue: 0,0:04:22.87,0:04:25.04,Default,,0,0,0,,Бұл миссия өте қауіпті.
Dialogue: 0,0:04:25.70,0:04:28.83,Default,,0,0,0,,Егер сақтаушы жын қайтадан бақылаудан шықса...
Dialogue: 0,0:04:28.91,0:04:31.70,Default,,0,0,0,,Менің қол астында сеніп тапсыра алатын бір адам бар.
Dialogue: 0,0:04:32.70,0:04:34.45,Default,,0,0,0,,Дәл осы аймақта
Dialogue: 0,0:04:36.50,0:04:41.16,Default,,0,0,0,,Хиросима
Dialogue: 0,0:04:49.54,0:04:50.87,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:04:50.95,0:04:53.62,Default,,0,0,0,,Менің де пойызға бірінші рет мінуім.
Dialogue: 0,0:04:53.70,0:04:54.70,Default,,0,0,0,,А?
Dialogue: 0,0:04:55.62,0:04:59.25,Default,,0,0,0,,Салмақсыз жын іздерді жұлып алады.
Dialogue: 0,0:04:59.33,0:05:00.33,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:05:02.33,0:05:04.95,Default,,0,0,0,,О! Анна, мына ғимаратқа қара.
Dialogue: 0,0:05:05.04,0:05:05.87,Default,,0,0,0,,Ана Ана
Dialogue: 0,0:05:06.87,0:05:09.37,Default,,0,0,0,,Жақында Хиросима станциясына жетеміз.
Dialogue: 0,0:05:09.45,0:05:12.83,Default,,0,0,0,,Пойыздан түскенде, артта ештеңе қалдырмаңыз.
Dialogue: 0,0:05:43.50,0:05:44.66,Default,,0,0,0,,1-платформадан
Dialogue: 0,0:05:44.75,0:05:46.91,Default,,0,0,0,,Хакатаға бағытталған соңғы экспресс
Dialogue: 0,0:05:47.00,0:05:48.91,Default,,0,0,0,,Мен жақында кетемін.
Dialogue: 0,0:05:49.00,0:05:51.87,Default,,0,0,0,,Егер билетіңіз болмаса, пойызға отыра алмайсыз.
Dialogue: 0,0:05:57.70,0:05:58.75,Default,,0,0,0,,Қорытынды экспресс
Dialogue: 0,0:05:58.83,0:06:01.66,Default,,0,0,0,,Біздің қызметті пайдаланғаныңыз үшін рахмет.
Dialogue: 0,0:06:02.50,0:06:04.70,Default,,0,0,0,,Бұл пойыз Хакатаға барады.
Dialogue: 0,0:06:05.62,0:06:09.20,Default,,0,0,0,,Жол бойындағы аялдамалар - Шин-Ямагучи және Кокура…
Dialogue: 0,0:06:09.29,0:06:10.58,Default,,0,0,0,,А... мынау!
Dialogue: 0,0:06:28.75,0:06:31.25,Default,,0,0,0,,Анашым! сол адамға қара
Dialogue: 0,0:06:32.20,0:06:34.45,Default,,0,0,0,,Кім? Онда ешкім жоқ
Dialogue: 0,0:06:34.54,0:06:36.62,Default,,0,0,0,,Білесің бе... аа...
Dialogue: 0,0:06:41.50,0:06:44.37,Default,,0,0,0,,Woohoo shhh
Dialogue: 0,0:06:49.58,0:06:53.37,Default,,0,0,0,,Біз пойызға кірдік. Біз іздеуді бастаймыз.
Dialogue: 0,0:07:16.00,0:07:17.50,Default,,0,0,0,,Мен сіздің билетіңізді қараймын. (Андо) О?
Dialogue: 0,0:07:17.58,0:07:19.83,Default,,0,0,0,,Рахмет (дирижер) Мен сіздің билетіңізді қараймын.
Dialogue: 0,0:07:19.91,0:07:21.20,Default,,0,0,0,,Мен сіздің билетіңізді қараймын.
Dialogue: 0,0:07:21.29,0:07:23.75,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:24.33,0:07:25.50,Default,,0,0,0,,Есіктер!
Dialogue: 0,0:07:34.54,0:07:35.41,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:38.00,0:07:40.58,Default,,0,0,0,,Жолаушы, мен сенің билетіңді қараймын.
Dialogue: 0,0:07:40.66,0:07:41.29,Default,,0,0,0,,Га
Dialogue: 0,0:07:42.91,0:07:46.37,Default,,0,0,0,,Мен жақсы ұйықтадым.Қазір қайдасың?
Dialogue: 0,0:07:46.87,0:07:48.62,Default,,0,0,0,,Хиросимадан өткенде.
Dialogue: 0,0:07:52.91,0:07:57.37,Default,,0,0,0,,Мен оны әлі таба алмаймын. Ол қауіпті ме?
Dialogue: 0,0:07:57.45,0:07:59.66,Default,,0,0,0,,Жасөспірімдерде олай емес.
Dialogue: 0,0:07:59.75,0:08:01.95,Default,,0,0,0,,Бірақ түрлендіру қиынға соғады.
Dialogue: 0,0:08:02.54,0:08:05.83,Default,,0,0,0,,Баланы білмей шығарып саласың.
Dialogue: 0,0:08:06.50,0:08:07.58,Default,,0,0,0,,Дереу
Dialogue: 0,0:08:08.37,0:08:11.04,Default,,0,0,0,,Ең бастысы, баланы ренжітпеу.
Dialogue: 0,0:08:14.08,0:08:16.70,Default,,0,0,0,,Бұл оңай тапсырма емес
Dialogue: 0,0:08:16.79,0:08:19.58,Default,,0,0,0,,Егер сіз табысқа жетсеңіз, бұл бонус.
Dialogue: 0,0:08:22.50,0:08:24.50,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:08:24.58,0:08:26.20,Default,,0,0,0,,Оң қолымен теңдеулерді шешіп отыр
Dialogue: 0,0:08:34.62,0:08:35.91,Default,,0,0,0,,Хехехе
Dialogue: 0,0:08:39.62,0:08:41.20,Default,,0,0,0,,Бұл шыны!
Dialogue: 0,0:08:45.54,0:08:47.04,Default,,0,0,0,,Керемет пейзаж!
Dialogue: 0,0:08:53.20,0:08:54.37,Default,,0,0,0,,Қараңдаршы, көре аласың ба?
Dialogue: 0,0:08:54.45,0:08:55.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:56.70,0:08:57.70,Default,,0,0,0,,болды
Dialogue: 0,0:08:58.91,0:09:00.12,Default,,0,0,0,,Көңілді сияқты
Dialogue: 0,0:09:00.91,0:09:03.83,Default,,0,0,0,,Менің жүрегім ауырады, бірақ бұл жұмыс...
Dialogue: 0,0:09:05.16,0:09:09.04,Default,,0,0,0,,Бірақ мен бонусыммен сатып алғым келетін нәрсе бар.
Dialogue: 0,0:09:09.62,0:09:11.12,Default,,0,0,0,,Косметика және т.б.
Dialogue: 0,0:09:11.20,0:09:14.20,Default,,0,0,0,,Сондай-ақ, жаңа жарқыраған қызғылт лалагүл үлгісі.
Dialogue: 0,0:09:14.29,0:09:16.25,Default,,0,0,0,,Жасалған сөмкелер
Dialogue: 0,0:09:16.33,0:09:18.04,Default,,0,0,0,,Мен сенің осындай сөздер айтқаныңды ұнатпаймын, Маюши.
Dialogue: 0,0:09:21.41,0:09:22.54,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:09:26.45,0:09:27.45,Default,,0,0,0,,Есіктер
Dialogue: 0,0:09:28.50,0:09:31.95,Default,,0,0,0,,Қалай! Уа, уай, ау!
Dialogue: 0,0:09:32.04,0:09:33.50,Default,,0,0,0,,Хехехе
Dialogue: 0,0:09:42.16,0:09:45.50,Default,,0,0,0,,Менің қарным ашты. Мен жей алатын нәрсе бар ма?
Dialogue: 0,0:09:45.58,0:09:46.58,Default,,0,0,0,,Сіз!
Dialogue: 0,0:09:47.83,0:09:50.50,Default,,0,0,0,,Біз Канмон бұғазының туннеліне жақындап қалдық.
Dialogue: 0,0:09:50.58,0:09:51.58,Default,,0,0,0,,Не?
Dialogue: 0,0:09:51.66,0:09:54.83,Default,,0,0,0,,Хонсю мен Кюсю аралдарының арасында мұхит бар.
Dialogue: 0,0:09:54.91,0:09:55.91,Default,,0,0,0,,Қара…
Dialogue: 0,0:09:56.00,0:09:56.83,Default,,0,0,0,,Уау
Dialogue: 0,0:10:06.45,0:10:08.04,Default,,0,0,0,,Эй, эй! (Кенто) Уау!
Dialogue: 0,0:10:19.08,0:10:21.12,Default,,0,0,0,,Шыны туннель!
Dialogue: 0,0:10:21.20,0:10:23.91,Default,,0,0,0,,Судың іші өте әдемі!
Dialogue: 0,0:10:25.20,0:10:26.58,Default,,0,0,0,,Ах... иә!
Dialogue: 0,0:10:26.66,0:10:30.45,Default,,0,0,0,,Уау! сүйкімді! Мен демімді ұстауға жаттығамын
Dialogue: 0,0:10:31.41,0:10:35.29,Default,,0,0,0,,Бірақ бәрібір! Пойызға су кірмейді
Dialogue: 0,0:10:35.37,0:10:36.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:36.83,0:10:39.04,Default,,0,0,0,,Егер мен мүсінші болсам
Dialogue: 0,0:10:39.12,0:10:44.37,Default,,0,0,0,,Аннаның сүйкімділігін мүсіндеу арқылы көрсетіп, кейінгі ұрпаққа жеткізуге болатын.
Dialogue: 0,0:10:46.83,0:10:50.00,Default,,0,0,0,,Осы жерден өтсеңіз, Кюсюге жетесіз...
Dialogue: 0,0:10:51.00,0:10:54.20,Default,,0,0,0,,Маған уақытты басқара алатын жын табу керек.
Dialogue: 0,0:10:56.58,0:10:59.25,Default,,0,0,0,,Анаңды тірілтсін.
Dialogue: 0,0:11:05.41,0:11:06.54,Default,,0,0,0,,Уау...
Dialogue: 0,0:11:07.08,0:11:08.20,Default,,0,0,0,,Ах~
Dialogue: 0,0:11:19.25,0:11:20.79,Default,,0,0,0,,Керемет
Dialogue: 0,0:11:21.95,0:11:23.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:23.62,0:11:25.25,Default,,0,0,0,,Сіз? Ах...
Dialogue: 0,0:11:26.58,0:11:29.75,Default,,0,0,0,,Сіз! А? (Андо) Уфуфуфу…
Dialogue: 0,0:11:29.83,0:11:32.04,Default,,0,0,0,,Жасау-істеу-істеу-істеу...
Dialogue: 0,0:11:32.12,0:11:36.62,Default,,0,0,0,,Бұл бала үлкен және өте әсерлі, Анна.
Dialogue: 0,0:11:37.70,0:11:38.70,Default,,0,0,0,,Ана?
Dialogue: 0,0:11:39.91,0:11:42.79,Default,,0,0,0,,Жоқ! қайда?
Dialogue: 0,0:11:44.54,0:11:46.95,Default,,0,0,0,,Ана? қайда?
Dialogue: 0,0:11:47.79,0:11:49.25,Default,,0,0,0,,Ана!
Dialogue: 0,0:11:56.04,0:11:57.45,Default,,0,0,0,,Бұл!
Dialogue: 0,0:11:58.12,0:11:59.25,Default,,0,0,0,,Сіз! Не...
Dialogue: 0,0:11:59.33,0:12:01.00,Default,,0,0,0,,Анананаана…
Dialogue: 0,0:12:01.08,0:12:02.12,Default,,0,0,0,,Мориёх қандай әдемі қала.
Dialogue: 0,0:12:02.20,0:12:05.12,Default,,0,0,0,,Үндемей қалсаң, өлесің, солай ма?
Dialogue: 0,0:12:06.50,0:12:09.20,Default,,0,0,0,,Мен келесі станцияға жеткенше тығылуым керек.
Dialogue: 0,0:12:11.91,0:12:12.91,Default,,0,0,0,,Анна?
Dialogue: 0,0:12:15.62,0:12:17.45,Default,,0,0,0,,Анна? Ана?
Dialogue: 0,0:12:20.16,0:12:21.08,Default,,0,0,0,,Ана?
Dialogue: 0,0:12:29.12,0:12:30.12,Default,,0,0,0,,Анашым!
Dialogue: 0,0:12:30.70,0:12:33.58,Default,,0,0,0,,Бұл сенің апаң, мен айтып отырған бақсы.
Dialogue: 0,0:12:34.41,0:12:37.33,Default,,0,0,0,,Бұлай айтуға қалай дәтің бар! әпкеңнен кешірім сұра
Dialogue: 0,0:12:37.95,0:12:39.83,Default,,0,0,0,,Қызымның дөрекі болғанына өкінемін.
Dialogue: 0,0:12:39.91,0:12:41.91,Default,,0,0,0,,Жоқ, жоқ... Ха!
Dialogue: 0,0:12:42.00,0:12:45.33,Default,,0,0,0,,А, жоқ... у... а...
Dialogue: 0,0:12:46.75,0:12:51.83,Default,,0,0,0,,Сіз! О, менің! Ах!
Dialogue: 0,0:12:52.45,0:12:54.16,Default,,0,0,0,,Оны таптым! ұры!
Dialogue: 0,0:12:54.25,0:12:56.83,Default,,0,0,0,,Жоқ! Әзірге кетейік
Dialogue: 0,0:12:56.91,0:12:57.83,Default,,0,0,0,,Есіктер!
Dialogue: 0,0:12:57.91,0:12:59.25,Default,,0,0,0,,Қалай!
Dialogue: 0,0:12:59.91,0:13:01.29,Default,,0,0,0,,Уау, бұл ақылсыз!
Dialogue: 0,0:13:02.45,0:13:03.58,Default,,0,0,0,,Ана!
Dialogue: 0,0:13:04.87,0:13:07.16,Default,,0,0,0,,Уау! Не болды?
Dialogue: 0,0:13:07.25,0:13:08.58,Default,,0,0,0,,Жоғалып кетті ме?
Dialogue: 0,0:13:09.91,0:13:12.04,Default,,0,0,0,,Уф... күрсініп...
Dialogue: 0,0:13:12.12,0:13:15.29,Default,,0,0,0,,Күшті жел! Мен қателестім бе?
Dialogue: 0,0:13:20.50,0:13:21.58,Default,,0,0,0,,Жоғарыда!
Dialogue: 0,0:13:27.33,0:13:30.62,Default,,0,0,0,,Бұрынғы бала Бұл майысатын жын!
Dialogue: 0,0:13:44.25,0:13:48.12,Default,,0,0,0,,Жолаушы жын көріп, әбігерге түсті.
Dialogue: 0,0:13:48.20,0:13:49.70,Default,,0,0,0,,Пойызға оралу мүмкін емес
Dialogue: 0,0:13:50.25,0:13:53.00,Default,,0,0,0,,Олай болса келесі аялдамаға дейін сонда бол.
Dialogue: 0,0:13:53.83,0:13:55.50,Default,,0,0,0,,Өйткені мен көп жұмыс істеймін
Dialogue: 0,0:13:55.58,0:13:57.79,Default,,0,0,0,,Бонусты ұмытпаңыз
Dialogue: 0,0:13:58.37,0:13:59.87,Default,,0,0,0,,Ана! тесік?
Dialogue: 0,0:14:00.58,0:14:02.45,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:14:03.54,0:14:04.83,Default,,0,0,0,,Мен сені қазір шығарамын!
Dialogue: 0,0:14:07.45,0:14:09.00,Default,,0,0,0,,Жоқ, ол ашылмайды!
Dialogue: 0,0:14:09.62,0:14:11.37,Default,,0,0,0,,Уау! қауіпті!
Dialogue: 0,0:14:22.50,0:14:23.50,Default,,0,0,0,,Сіз!
Dialogue: 0,0:14:25.29,0:14:27.12,Default,,0,0,0,,Тыныштап бер!
Dialogue: 0,0:14:27.20,0:14:29.33,Default,,0,0,0,,Сіз бұл себетті аша алмайсыз.
Dialogue: 0,0:14:29.83,0:14:32.29,Default,,0,0,0,,Маған ұнамайды! Мен берілмеймін!
Dialogue: 0,0:14:32.37,0:14:33.62,Default,,0,0,0,,Қалай болғанда да, бастайық!
Dialogue: 0,0:14:37.25,0:14:38.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:39.58,0:14:40.95,Default,,0,0,0,,Сіз! (Кендо) Анна!
Dialogue: 0,0:14:41.58,0:14:42.20,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:14:43.04,0:14:44.08,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:14:53.25,0:14:54.25,Default,,0,0,0,,Қозғалмаңыз!
Dialogue: 0,0:14:56.25,0:14:57.16,Default,,0,0,0,,Сіз!
Dialogue: 0,0:14:59.70,0:15:01.58,Default,,0,0,0,,Сіз данышпансыз ба?
Dialogue: 0,0:15:02.16,0:15:04.16,Default,,0,0,0,,Онда мен де байсалды боламын.
Dialogue: 0,0:15:15.25,0:15:16.62,Default,,0,0,0,,Ана қарсы шабуыл!
Dialogue: 0,0:15:16.70,0:15:18.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:18.58,0:15:19.45,Default,,0,0,0,,Есіктер (есіктер)
Dialogue: 0,0:15:19.54,0:15:20.58,Default,,0,0,0,,Сіз!
Dialogue: 0,0:15:23.37,0:15:25.45,Default,,0,0,0,,А... не? тесік!
Dialogue: 0,0:15:27.04,0:15:28.70,Default,,0,0,0,,Бұл өте ыстық!
Dialogue: 0,0:15:34.83,0:15:36.75,Default,,0,0,0,,Есіктер (есіктер) Эй!
Dialogue: 0,0:15:36.83,0:15:38.12,Default,,0,0,0,,Міне болды! Ана Ана!
Dialogue: 0,0:15:38.20,0:15:38.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:40.25,0:15:41.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:41.87,0:15:42.70,Default,,0,0,0,,Сіз!
Dialogue: 0,0:15:43.66,0:15:44.62,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:15:44.70,0:15:45.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:51.50,0:15:52.33,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:15:52.41,0:15:55.37,Default,,0,0,0,,Ах! (Андо) Ұсталды...
Dialogue: 0,0:15:55.45,0:15:57.20,Default,,0,0,0,,Иә? А... жоқ...
Dialogue: 0,0:15:57.83,0:16:00.20,Default,,0,0,0,,Ах... Ах! Бір сәт...
Dialogue: 0,0:16:02.45,0:16:05.16,Default,,0,0,0,,Маған бұл ұнамайды. Неліктен? (Кенто) А, бұл қауіпті!
Dialogue: 0,0:16:08.45,0:16:10.66,Default,,0,0,0,,Кя! Сиқыршы!
Dialogue: 0,0:16:13.58,0:16:15.41,Default,,0,0,0,,Ух... ха...
Dialogue: 0,0:16:37.37,0:16:39.66,Default,,0,0,0,,Әпке, сіз бейбітшілік ұйымынансыз ба?
Dialogue: 0,0:16:41.00,0:16:45.08,Default,,0,0,0,,Кешіріңіз, мен жұмыстамын. Баланы әкеліңізші.
Dialogue: 0,0:16:46.08,0:16:47.87,Default,,0,0,0,,Мен саған бұлай істеуге жол бермеймін!
Dialogue: 0,0:16:47.95,0:16:50.20,Default,,0,0,0,,Ана мен үшін ерекше!
Dialogue: 0,0:16:50.29,0:16:53.62,Default,,0,0,0,,Достар мен отбасы, біз бірміз!
Dialogue: 0,0:16:58.91,0:17:02.58,Default,,0,0,0,,Есіктер Менің ойымша, бұл миссия сәтсіз аяқталды.
Dialogue: 0,0:17:03.66,0:17:06.66,Default,,0,0,0,,Мен бонустан бас тартуым керек пе? Тохохо...
Dialogue: 0,0:17:08.87,0:17:10.87,Default,,0,0,0,,Балада қалқымалы сақина бар ма?
Dialogue: 0,0:17:11.62,0:17:14.04,Default,,0,0,0,,Мен солай ойлаймын... бірақ неге?
Dialogue: 0,0:17:14.95,0:17:16.91,Default,,0,0,0,,Келесі аялдамада
Dialogue: 0,0:17:17.00,0:17:19.45,Default,,0,0,0,,Бейбітшілік ұйымының мүшелері күтіп тұр.
Dialogue: 0,0:17:20.25,0:17:21.87,Default,,0,0,0,,Мен оны ұсынбаймын.
Dialogue: 0,0:17:21.95,0:17:22.62,Default,,0,0,0,,Іс-әрекет-іс
Dialogue: 0,0:17:24.33,0:17:25.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:27.08,0:17:28.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:28.08,0:17:31.37,Default,,0,0,0,,Сізге сәттілік тілеймін, абайлаңыз
Dialogue: 0,0:17:31.45,0:17:32.29,Default,,0,0,0,,Не?
Dialogue: 0,0:17:42.79,0:17:43.62,Default,,0,0,0,,Сіз!
Dialogue: 0,0:17:43.70,0:17:50.70,Default,,0,0,0,,Хаката
Dialogue: 0,0:17:59.79,0:18:04.08,Default,,0,0,0,,(Баланың жылауы)
Dialogue: 0,0:18:10.95,0:18:12.29,Default,,0,0,0,,Қарт әже, кіріп келемін.
Dialogue: 0,0:18:14.25,0:18:16.25,Default,,0,0,0,,Ұшақ бұзылды.
Dialogue: 0,0:18:19.87,0:18:20.87,Default,,0,0,0,,Маған көрсет
Dialogue: 0,0:18:29.83,0:18:31.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:32.00,0:18:33.87,Default,,0,0,0,,Қараңызшы, бұл жақсы.
Dialogue: 0,0:18:33.95,0:18:35.37,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:18:35.45,0:18:38.54,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:18:51.12,0:18:53.12,Default,,0,0,0,,♪～
Dialogue: 0,0:21:15.33,0:21:17.33,Default,,0,0,0,,～♪
