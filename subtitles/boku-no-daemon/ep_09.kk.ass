Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:23.87,0:00:24.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:26.91,0:00:27.83,Default,,0,0,0,,А?
Dialogue: 0,0:00:27.91,0:00:33.25,Default,,0,0,0,,Уау~
Dialogue: 0,0:00:35.50,0:00:36.33,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:00:39.83,0:00:41.41,Default,,0,0,0,,Мау! Мау!
Dialogue: 0,0:00:43.29,0:00:44.75,Default,,0,0,0,,Сіз...
Dialogue: 0,0:00:44.83,0:00:45.79,Default,,0,0,0,,Мау! Мау!
Dialogue: 0,0:01:01.62,0:01:03.62,Default,,0,0,0,,♪～
Dialogue: 0,0:02:21.87,0:02:22.00,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:02:22.00,0:02:24.00,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:02:22.00,0:02:24.00,Default,,0,0,0,,～♪
Dialogue: 0,0:02:24.00,0:02:26.75,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:02:26.83,0:02:30.00,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:02:37.12,0:02:39.79,Default,,0,0,0,,Бұл болды ма? осында келіп отыр
Dialogue: 0,0:02:42.95,0:02:44.16,Default,,0,0,0,,Уау~
Dialogue: 0,0:02:45.54,0:02:47.79,Default,,0,0,0,,Бұл таңғы ас, оны іш.
Dialogue: 0,0:02:47.87,0:02:50.79,Default,,0,0,0,,Бұл өтірік емес пе? Басқа ештеңе жоқ па?
Dialogue: 0,0:02:50.87,0:02:52.12,Default,,0,0,0,,Нан, күріш, т.б.
Dialogue: 0,0:02:54.08,0:02:55.79,Default,,0,0,0,,Жоқ, бас тарт.
Dialogue: 0,0:02:56.29,0:02:58.16,Default,,0,0,0,,Мұны ішіңіз, бұлшық етіңіз артады.
Dialogue: 0,0:02:58.25,0:03:00.25,Default,,0,0,0,,Сізге көбірек жаттығу керек
Dialogue: 0,0:03:04.58,0:03:07.25,Default,,0,0,0,,Каэде-сан, маған көмектес!
Dialogue: 0,0:03:19.75,0:03:23.20,Default,,0,0,0,,Бірге тамақтанғанымызға біраз болды.
Dialogue: 0,0:03:23.29,0:03:24.66,Default,,0,0,0,,Игис қайда орналасқан?
Dialogue: 0,0:03:31.29,0:03:34.54,Default,,0,0,0,,Igigi…
Dialogue: 0,0:03:34.62,0:03:35.62,Default,,0,0,0,,Igi…
Dialogue: 0,0:03:37.16,0:03:41.12,Default,,0,0,0,,Мен қауіпсіз жердемін, сені әлі өлтірген жоқпын
Dialogue: 0,0:03:41.83,0:03:44.87,Default,,0,0,0,,Каэде тыныш болғанша.
Dialogue: 0,0:03:46.33,0:03:47.87,Default,,0,0,0,,Тез тамақтаныңыз
Dialogue: 0,0:03:57.50,0:03:58.50,Default,,0,0,0,,Очо
Dialogue: 0,0:04:00.95,0:04:02.62,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:04:04.41,0:04:05.25,Default,,0,0,0,,Очо?
Dialogue: 0,0:04:06.08,0:04:08.41,Default,,0,0,0,,Гуруруру... Гвиния!
Dialogue: 0,0:04:08.50,0:04:09.66,Default,,0,0,0,,Очо~!
Dialogue: 0,0:04:10.58,0:04:11.54,Default,,0,0,0,,Очо…
Dialogue: 0,0:04:12.04,0:04:14.75,Default,,0,0,0,,Очочочо...!
Dialogue: 0,0:04:17.04,0:04:17.87,Default,,0,0,0,,Сіз!
Dialogue: 0,0:04:18.62,0:04:19.95,Default,,0,0,0,,Гвинея~
Dialogue: 0,0:04:21.70,0:04:22.66,Default,,0,0,0,,Допты жұлып алған адам — біздің Хью Хадсон мектебінің мақтанышы —
Dialogue: 0,0:04:25.16,0:04:28.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:28.25,0:04:31.00,Default,,0,0,0,,Шах Гвинья~
Dialogue: 0,0:04:43.75,0:04:45.58,Default,,0,0,0,,Мау Мау! тесік!
Dialogue: 0,0:04:45.66,0:04:47.50,Default,,0,0,0,,Мау! (Шыбынды тышқан) Очо
Dialogue: 0,0:04:48.29,0:04:49.25,Default,,0,0,0,,Сіз?
Dialogue: 0,0:04:50.29,0:04:51.45,Default,,0,0,0,,Анаана!
Dialogue: 0,0:04:51.54,0:04:52.66,Default,,0,0,0,,Маумау
Dialogue: 0,0:04:53.58,0:04:55.37,Default,,0,0,0,,А... иә?
Dialogue: 0,0:04:56.79,0:04:57.75,Default,,0,0,0,,Сіз?
Dialogue: 0,0:04:58.95,0:05:01.37,Default,,0,0,0,,Не? Ахххх!
Dialogue: 0,0:05:04.45,0:05:05.66,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:06.87,0:05:09.66,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:05:09.75,0:05:14.62,Default,,0,0,0,,(ит жын үреді)
Dialogue: 0,0:05:20.41,0:05:22.95,Default,,0,0,0,,Біреу… біреу…
Dialogue: 0,0:05:29.41,0:05:30.66,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:05:30.75,0:05:33.04,Default,,0,0,0,,бұл... Иә, бұл қауіпті!
Dialogue: 0,0:05:45.00,0:05:46.50,Default,,0,0,0,,Эй, күте тұр!
Dialogue: 0,0:05:49.16,0:05:50.83,Default,,0,0,0,,Таран Таран... Йо
Dialogue: 0,0:05:51.87,0:05:52.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:22.12,0:06:24.25,Default,,0,0,0,,Босс миссиясы аяқталды!
Dialogue: 0,0:06:24.33,0:06:25.95,Default,,0,0,0,,Ах! Бұл не жын?
Dialogue: 0,0:06:26.04,0:06:27.12,Default,,0,0,0,,Пара!
Dialogue: 0,0:06:27.62,0:06:29.75,Default,,0,0,0,,«Парасар» паразиттік жын
Dialogue: 0,0:06:30.50,0:06:34.16,Default,,0,0,0,,Паразиттік қарсыластың физикалық қабілеттерін жақсартады.
Dialogue: 0,0:06:36.25,0:06:38.62,Default,,0,0,0,,(ит жын үруі)
Dialogue: 0,0:06:39.37,0:06:42.37,Default,,0,0,0,,Ол иесінің жын-шайтанын жеп, қашып кетті.
Dialogue: 0,0:06:42.95,0:06:45.75,Default,,0,0,0,,Жағасы әлдебір соққыдан шығып кеткен сияқты.
Dialogue: 0,0:06:46.66,0:06:48.41,Default,,0,0,0,,Ол бала не болады?
Dialogue: 0,0:06:49.00,0:06:50.20,Default,,0,0,0,,Өлтірілді
Dialogue: 0,0:06:51.91,0:06:53.00,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:57.45,0:06:58.37,Default,,0,0,0,,Эй!
Dialogue: 0,0:07:00.12,0:07:02.62,Default,,0,0,0,,(ит жын үреді)
Dialogue: 0,0:07:14.54,0:07:16.62,Default,,0,0,0,,Яги, торды аш.
Dialogue: 0,0:07:16.70,0:07:17.45,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:07:35.04,0:07:38.16,Default,,0,0,0,,Бұл бала зорлық-зомбылыққа ұшырағандықтан агрессивті.
Dialogue: 0,0:07:40.08,0:07:41.25,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:43.41,0:07:46.45,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:07:47.33,0:07:48.70,Default,,0,0,0,,~ бастап
Dialogue: 0,0:07:49.58,0:07:51.95,Default,,0,0,0,,Қарақарқарақара～
Dialogue: 0,0:07:53.04,0:07:55.91,Default,,0,0,0,,бастап? ~ бастап
Dialogue: 0,0:07:59.62,0:08:00.70,Default,,0,0,0,,бастап
Dialogue: 0,0:08:34.12,0:08:36.20,Default,,0,0,0,,...
Dialogue: 0,0:08:49.62,0:08:50.66,Default,,0,0,0,,Қайдан?
Dialogue: 0,0:08:51.29,0:08:52.75,Default,,0,0,0,,Менің есімде
Dialogue: 0,0:08:52.83,0:08:55.33,Default,,0,0,0,,Анамның кірді кептіру үшін іліп жатқанын көру
Dialogue: 0,0:08:55.41,0:08:56.54,Default,,0,0,0,,Маған ұнады.
Dialogue: 0,0:08:56.62,0:08:58.37,Default,,0,0,0,,Қара Қара Қара
Dialogue: 0,0:08:58.45,0:09:02.62,Default,,0,0,0,,Ауруханада анаңыздың қайтыс болғаны туралы анықтама болды.
Dialogue: 0,0:09:03.50,0:09:07.16,Default,,0,0,0,,Бірақ дене жоқ, сен де жоқсың.
Dialogue: 0,0:09:08.62,0:09:10.41,Default,,0,0,0,,Себебі Анна оны тастап кетті
Dialogue: 0,0:09:10.50,0:09:13.08,Default,,0,0,0,,Менің анам қайтыс болғаннан кейін бірден күйде.
Dialogue: 0,0:09:14.04,0:09:16.33,Default,,0,0,0,,Уақытты артқа айналдыратын жынды табыңыз
Dialogue: 0,0:09:16.41,0:09:18.50,Default,,0,0,0,,Өлгенге дейінгі уақытқа оралыңыз.
Dialogue: 0,0:09:19.54,0:09:21.25,Default,,0,0,0,,Сыбыс бар.
Dialogue: 0,0:09:21.33,0:09:23.79,Default,,0,0,0,,Кюсюда уақыт жын бар.
Dialogue: 0,0:09:24.54,0:09:26.45,Default,,0,0,0,,Бар екендігі расталмады
Dialogue: 0,0:09:27.12,0:09:29.87,Default,,0,0,0,,Бұл жасырын! Табылмау
Dialogue: 0,0:09:29.95,0:09:32.50,Default,,0,0,0,,Сөзсіз уақыт жын бар!
Dialogue: 0,0:09:32.58,0:09:34.25,Default,,0,0,0,,Мен бұған сенгім келеді.
Dialogue: 0,0:09:35.04,0:09:38.62,Default,,0,0,0,,Анаңның өлімін мойындасаң болғаны.
Dialogue: 0,0:09:39.83,0:09:42.83,Default,,0,0,0,,Анам бір күні қайта тіріледі!
Dialogue: 0,0:09:44.04,0:09:45.20,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:10:02.08,0:10:05.33,Default,,0,0,0,,Әй... бала тәрбиесі қиын.
Dialogue: 0,0:10:13.33,0:10:14.45,Default,,0,0,0,,Мау...
Dialogue: 0,0:10:18.54,0:10:19.54,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:10:21.16,0:10:22.20,Default,,0,0,0,,Сіз!
Dialogue: 0,0:10:42.95,0:10:43.91,Default,,0,0,0,,Анна...?
Dialogue: 0,0:10:50.29,0:10:51.20,Default,,0,0,0,,Анна?
Dialogue: 0,0:10:59.70,0:11:01.50,Default,,0,0,0,,Анна табылды!
Dialogue: 0,0:11:04.33,0:11:06.95,Default,,0,0,0,,Қарала, сенен бір жақсылығым бар.
Dialogue: 0,0:11:07.04,0:11:08.20,Default,,0,0,0,,Қайдан?
Dialogue: 0,0:11:08.79,0:11:12.87,Default,,0,0,0,,Мені бұл шектеуден босатуыңызды қалаймын. Мен досыма барғым келеді.
Dialogue: 0,0:11:13.45,0:11:16.20,Default,,0,0,0,,Ол бала жын және менің досым...
Dialogue: 0,0:11:16.70,0:11:19.00,Default,,0,0,0,,Және менің отбасым
Dialogue: 0,0:11:19.58,0:11:21.08,Default,,0,0,0,,бастап...
Dialogue: 0,0:11:25.50,0:11:26.58,Default,,0,0,0,,бастап
Dialogue: 0,0:11:26.66,0:11:28.79,Default,,0,0,0,,Не? «Ол өтті»?
Dialogue: 0,0:11:28.87,0:11:30.20,Default,,0,0,0,,Менің жүрегім?
Dialogue: 0,0:11:30.29,0:11:31.16,Default,,0,0,0,,бастап!
Dialogue: 0,0:11:33.25,0:11:35.33,Default,,0,0,0,,Рахмет саған Қарала!
Dialogue: 0,0:11:35.41,0:11:36.58,Default,,0,0,0,,бастап
Dialogue: 0,0:11:41.33,0:11:42.79,Default,,0,0,0,,бастап!
Dialogue: 0,0:11:45.66,0:11:48.62,Default,,0,0,0,,Мен жынды сендіремін деп ешқашан ойламаппын.
Dialogue: 0,0:11:49.25,0:11:52.29,Default,,0,0,0,,Бұл бұйрықты бұзу, бірақ мен бұл жолы назардан тыс қалдырамын.
Dialogue: 0,0:11:52.37,0:11:53.62,Default,,0,0,0,,бастап...
Dialogue: 0,0:11:54.37,0:11:56.00,Default,,0,0,0,,Яги Бұл жұмыс.
Dialogue: 0,0:11:58.08,0:12:00.87,Default,,0,0,0,,Мені күт, Анна, мен дәл сол жерде боламын!
Dialogue: 0,0:12:05.37,0:12:08.95,Default,,0,0,0,,Кенто-кун мен саған айналамын, хи хи хи.
Dialogue: 0,0:12:14.79,0:12:15.75,Default,,0,0,0,,«Аздап жұмсауға да болар...» деп ойладым.
Dialogue: 0,0:12:16.87,0:12:17.87,Default,,0,0,0,,Бұл жерде?
Dialogue: 0,0:12:19.75,0:12:22.66,Default,,0,0,0,,Сәлем! Анна сен мені естисің бе?
Dialogue: 0,0:12:22.75,0:12:24.58,Default,,0,0,0,,Бұл менмін, Кенто!
Dialogue: 0,0:12:36.20,0:12:37.29,Default,,0,0,0,,Сіз?
Dialogue: 0,0:12:37.95,0:12:39.50,Default,,0,0,0,,Маумаума?
Dialogue: 0,0:12:39.58,0:12:41.00,Default,,0,0,0,,Маау (Шыбынды егеуқұйрық) Очо?
Dialogue: 0,0:12:41.08,0:12:42.50,Default,,0,0,0,,Сіз? Ах!
Dialogue: 0,0:12:43.08,0:12:45.20,Default,,0,0,0,,Ана Ана! О, менің!
Dialogue: 0,0:12:46.83,0:12:47.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:47.79,0:12:49.45,Default,,0,0,0,,Очо? Мау...
Dialogue: 0,0:12:50.91,0:12:52.20,Default,,0,0,0,,Очочочо…
Dialogue: 0,0:12:53.33,0:12:56.50,Default,,0,0,0,,Ана, сен мені естисің бе? Ана!
Dialogue: 0,0:12:57.00,0:12:58.08,Default,,0,0,0,,Сіз!
Dialogue: 0,0:12:58.16,0:13:00.37,Default,,0,0,0,,Ана! менде сен барсың!
Dialogue: 0,0:13:00.45,0:13:01.62,Default,,0,0,0,,Сіз...
Dialogue: 0,0:13:02.83,0:13:06.29,Default,,0,0,0,,Сіз бұл баланы тек бақытсыз етіп жатырсыз, солай емес пе?
Dialogue: 0,0:13:07.00,0:13:07.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:10.12,0:13:11.95,Default,,0,0,0,,Не болды, Ана?
Dialogue: 0,0:13:13.00,0:13:14.54,Default,,0,0,0,,Анна күтіңіз!
Dialogue: 0,0:13:15.83,0:13:19.41,Default,,0,0,0,,Не? Бұл балалар қандай? (Ұшып) Сәл күте тұрыңыз...
Dialogue: 0,0:13:22.83,0:13:23.87,Default,,0,0,0,,А?
Dialogue: 0,0:13:25.87,0:13:26.70,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:13:35.08,0:13:37.66,Default,,0,0,0,,О? Не... Эй...
Dialogue: 0,0:13:37.75,0:13:40.04,Default,,0,0,0,,Бұл Хупи таразысы!
Dialogue: 0,0:13:43.79,0:13:45.91,Default,,0,0,0,,Міне, жұмыс орындалды.
Dialogue: 0,0:13:53.75,0:13:55.75,Default,,0,0,0,,Мына балалар қандай? (Шыбынды тышқан) Очочо...
Dialogue: 0,0:13:55.83,0:13:59.20,Default,,0,0,0,,Бұл түсінбеушілік. Мен Аннаның досымын!
Dialogue: 0,0:14:01.04,0:14:02.04,Default,,0,0,0,,Мау?
Dialogue: 0,0:14:09.62,0:14:10.66,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:11.25,0:14:12.66,Default,,0,0,0,,Мау Мау!
Dialogue: 0,0:14:12.75,0:14:15.16,Default,,0,0,0,,Иә! Анна тұтқындалды ма?
Dialogue: 0,0:14:15.25,0:14:17.70,Default,,0,0,0,,Баршаңыз, маған күш-қуатыңызды беріңіздерші!
Dialogue: 0,0:14:31.29,0:14:33.45,Default,,0,0,0,,Сақтау Демон Ана
Dialogue: 0,0:14:34.70,0:14:35.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:35.45,0:14:37.12,Default,,0,0,0,,Саяхат аяқталды
Dialogue: 0,0:14:37.70,0:14:40.83,Default,,0,0,0,,Сіз өміріңіздің соңына дейін ғылыми-зерттеу институтында өтесіз.
Dialogue: 0,0:14:41.62,0:14:45.25,Default,,0,0,0,,Қауіпті деп табылса, ол бөлшектеліп, жойылады.
Dialogue: 0,0:14:47.95,0:14:51.41,Default,,0,0,0,,Жаман болма, бұл да менің жұмысым.
Dialogue: 0,0:15:00.08,0:15:01.20,Default,,0,0,0,,Мау
Dialogue: 0,0:15:01.29,0:15:04.33,Default,,0,0,0,,Онда Анна бар ма? Қалай көмектесе аламын?
Dialogue: 0,0:15:06.25,0:15:07.50,Default,,0,0,0,,Ммма!
Dialogue: 0,0:15:07.58,0:15:10.12,Default,,0,0,0,,Мау мау мау!
Dialogue: 0,0:15:14.66,0:15:19.29,Default,,0,0,0,,Мен сені біраз уақыт өсірген баламен бірге тұрдым.
Dialogue: 0,0:15:19.37,0:15:20.75,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:21.50,0:15:23.50,Default,,0,0,0,,Басында бүлікшіл болғанымен
Dialogue: 0,0:15:24.00,0:15:27.54,Default,,0,0,0,,Мен өзімді соңында жақсы орындағандай сезінемін.
Dialogue: 0,0:15:28.29,0:15:29.62,Default,,0,0,0,,Отбасы дегеніміз...
Dialogue: 0,0:15:32.54,0:15:34.54,Default,,0,0,0,,Бәлкім, осындай нәрсе шығар.
Dialogue: 0,0:15:56.04,0:15:57.95,Default,,0,0,0,,Уау... уау
Dialogue: 0,0:16:02.70,0:16:05.08,Default,,0,0,0,,Яги, не болғанын тексеріңіз.
Dialogue: 0,0:16:05.16,0:16:06.37,Default,,0,0,0,,(Сыныптасы) Әй, осындай жалғыздыққа толы сөздер айтпашы.
Dialogue: 0,0:16:19.04,0:16:20.08,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:16:20.62,0:16:21.58,Default,,0,0,0,,Түнгі күзетші келеді. Көзіңді жұмшы.
Dialogue: 0,0:16:21.66,0:16:23.41,Default,,0,0,0,,Гах...кетіңіз!
Dialogue: 0,0:16:23.50,0:16:24.25,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:28.83,0:16:30.95,Default,,0,0,0,,Иә! Не болып жатыр?
Dialogue: 0,0:16:31.04,0:16:34.54,Default,,0,0,0,,Ым, м... Менің ойымша, бұл солай ма?
Dialogue: 0,0:16:38.08,0:16:39.41,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:16:39.50,0:16:41.29,Default,,0,0,0,,Уау! Не?
Dialogue: 0,0:16:41.37,0:16:43.25,Default,,0,0,0,,Кола! Бұл қауіпті!
Dialogue: 0,0:16:45.41,0:16:47.20,Default,,0,0,0,,Хмм! Манманма
Dialogue: 0,0:16:47.29,0:16:48.75,Default,,0,0,0,,Мен мұны түсіндім!
Dialogue: 0,0:16:52.04,0:16:53.00,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:16:53.62,0:16:54.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:56.04,0:16:57.66,Default,,0,0,0,,Сен осындасың ба, Кенто...
Dialogue: 0,0:16:58.54,0:17:00.62,Default,,0,0,0,,Сіз бүкіл тіркемені ұрлауды жоспарлап отырсыз ба?
Dialogue: 0,0:17:00.70,0:17:02.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:18.87,0:17:19.75,Default,,0,0,0,,Кенто-кун!
Dialogue: 0,0:17:19.83,0:17:20.50,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:17:20.58,0:17:23.20,Default,,0,0,0,,Ой, көлікті тоқтат!
Dialogue: 0,0:17:23.29,0:17:24.25,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:17:25.12,0:17:26.29,Default,,0,0,0,,Парасар!
Dialogue: 0,0:17:26.37,0:17:27.37,Default,,0,0,0,,Пара!
Dialogue: 0,0:17:34.83,0:17:36.83,Default,,0,0,0,,Не, мына балалар сұмдық қой!
Dialogue: 0,0:17:36.91,0:17:38.50,Default,,0,0,0,,Очочочо…
Dialogue: 0,0:17:39.91,0:17:42.29,Default,,0,0,0,,Уау! Мен соққы алдым...
Dialogue: 0,0:17:42.37,0:17:43.45,Default,,0,0,0,,Пара…
Dialogue: 0,0:18:13.29,0:18:14.25,Default,,0,0,0,,Мау!
Dialogue: 0,0:18:14.83,0:18:17.04,Default,,0,0,0,,Ахх!
Dialogue: 0,0:18:18.50,0:18:20.33,Default,,0,0,0,,Тоқтаған жерден жалғастырғыңыз келе ме?
Dialogue: 0,0:18:23.37,0:18:24.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:25.54,0:18:26.45,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:18:39.66,0:18:41.12,Default,,0,0,0,,Сағындыңыз ба?
Dialogue: 0,0:18:41.62,0:18:45.75,Default,,0,0,0,,(Коноеның күлкісі)
Dialogue: 0,0:18:51.83,0:18:52.87,Default,,0,0,0,,Анна
Dialogue: 0,0:18:52.95,0:18:53.70,Default,,0,0,0,,А?
Dialogue: 0,0:18:54.66,0:18:57.37,Default,,0,0,0,,Үлкендердің маған не айтқанын білмеймін.
Dialogue: 0,0:18:59.83,0:19:02.29,Default,,0,0,0,,Әркімнің айтқанын тыңдаудың қажеті жоқ.
Dialogue: 0,0:19:03.75,0:19:05.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:05.79,0:19:09.41,Default,,0,0,0,,Бұл мені бақытсыз етеді ме? Бұл ақымақ
Dialogue: 0,0:19:09.95,0:19:14.00,Default,,0,0,0,,Одан да көп бақыт аламын сенен.
Dialogue: 0,0:19:14.08,0:19:16.04,Default,,0,0,0,,Бірге барайық, Анна!
Dialogue: 0,0:19:16.12,0:19:19.50,Default,,0,0,0,,Сізсіз саяхаттау қызық болмас еді.
Dialogue: 0,0:19:20.41,0:19:23.41,Default,,0,0,0,,Ах! О, менің!
Dialogue: 0,0:19:24.08,0:19:25.41,Default,,0,0,0,,Сіз!
Dialogue: 0,0:19:26.29,0:19:29.33,Default,,0,0,0,,Отбасы екенімізді бөлек болған соң түсіндім!
Dialogue: 0,0:19:29.41,0:19:30.66,Default,,0,0,0,,Анана!
Dialogue: 0,0:19:33.00,0:19:35.33,Default,,0,0,0,,Сәлем! Ах!
Dialogue: 0,0:19:35.41,0:19:37.37,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:19:37.45,0:19:40.66,Default,,0,0,0,,Анна мен сені жақсы көремін
Dialogue: 0,0:19:40.75,0:19:41.87,Default,,0,0,0,,Сіз!
Dialogue: 0,0:19:44.33,0:19:46.33,Default,,0,0,0,,♪～
Dialogue: 0,0:22:08.54,0:22:10.54,Default,,0,0,0,,～♪
