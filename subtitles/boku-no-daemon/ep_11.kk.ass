Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.33,0:00:17.95,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:00:22.62,0:00:25.58,Default,,0,0,0,,Бұл Аннаның ішінде ме?
Dialogue: 0,0:00:26.25,0:00:29.45,Default,,0,0,0,,Әлде мен өлген шығармын?
Dialogue: 0,0:00:36.25,0:00:37.16,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:38.12,0:00:39.29,Default,,0,0,0,,Ана?
Dialogue: 0,0:00:40.08,0:00:41.20,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:00:42.08,0:00:43.54,Default,,0,0,0,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,0:00:47.50,0:00:51.66,Default,,0,0,0,,(Тікұшақтың ұшу дыбысы)
Dialogue: 0,0:00:59.58,0:01:01.37,Default,,0,0,0,,Кирико-кун, сен не істеп жатырсың?
Dialogue: 0,0:01:02.37,0:01:04.54,Default,,0,0,0,,Бұл жерден тез кетейік.
Dialogue: 0,0:01:05.83,0:01:08.66,Default,,0,0,0,,Сасаки мырза, алдымен мектепке барыңыз.
Dialogue: 0,0:01:08.75,0:01:12.41,Default,,0,0,0,,Мен сирек кездесетін жәндік таптым, сәл кешігіп қаламын.
Dialogue: 0,0:01:15.45,0:01:17.54,Default,,0,0,0,,Мектепте кездескенше, Кирико-кун!
Dialogue: 0,0:01:17.62,0:01:19.70,Default,,0,0,0,,Мұнда кел. (Офицер) Мен қазір барамын.
Dialogue: 0,0:01:23.12,0:01:25.12,Default,,0,0,0,,Көлденең қима тым таза
Dialogue: 0,0:01:25.20,0:01:28.25,Default,,0,0,0,,Жарылыстан қираған сияқты емес.
Dialogue: 0,0:01:31.66,0:01:33.54,Default,,0,0,0,,Бұл жынның жұмысы?
Dialogue: 0,0:01:38.29,0:01:39.87,Default,,0,0,0,,Анам…
Dialogue: 0,0:01:49.62,0:01:51.62,Default,,0,0,0,,♪～
Dialogue: 0,0:03:09.70,0:03:09.87,Default,,0,0,0,,～♪
Dialogue: 0,0:03:09.87,0:03:11.70,Default,,0,0,0,,～♪
Dialogue: 0,0:03:09.87,0:03:11.70,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:03:11.70,0:03:14.75,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:03:19.33,0:03:21.16,Default,,0,0,0,,Кенто... (Кенто) Анашым!
Dialogue: 0,0:03:21.25,0:03:23.25,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:03:26.33,0:03:27.29,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:29.87,0:03:31.54,Default,,0,0,0,,А... Ана!
Dialogue: 0,0:03:31.62,0:03:33.16,Default,,0,0,0,,Сіз... сіз?
Dialogue: 0,0:03:34.20,0:03:35.62,Default,,0,0,0,,Кешіріңіз, Анна
Dialogue: 0,0:03:36.25,0:03:40.16,Default,,0,0,0,,Сен мені құтқару үшін күш қолдандың.
Dialogue: 0,0:03:40.25,0:03:42.20,Default,,0,0,0,,Баланың аты Анна ма?
Dialogue: 0,0:03:45.87,0:03:48.79,Default,,0,0,0,,Сіз кімсіз? Біз қайдамыз?
Dialogue: 0,0:03:49.54,0:03:51.00,Default,,0,0,0,,Бұл менің үйім
Dialogue: 0,0:03:51.08,0:03:54.66,Default,,0,0,0,,Мен қазір жалғыз тұрамын, сондықтан жақсы, қорықпа.
Dialogue: 0,0:03:55.70,0:03:58.87,Default,,0,0,0,,Мен сені мен балаңды өзеннің жағасында жатқан жерінен таптым.
Dialogue: 0,0:03:58.95,0:04:00.12,Default,,0,0,0,,Мен сені алып келдім.
Dialogue: 0,0:04:01.04,0:04:05.41,Default,,0,0,0,,Дәл қазір ештеңе айтудың қажеті жоқ, күріш ботқасын жеу керек.
Dialogue: 0,0:04:06.12,0:04:07.58,Default,,0,0,0,,Өйткені ол денеңді жылытады
Dialogue: 0,0:04:08.25,0:04:09.33,Default,,0,0,0,,Мен Кирикомын
Dialogue: 0,0:04:09.83,0:04:11.37,Default,,0,0,0,,А?
Dialogue: 0,0:04:11.45,0:04:12.41,Default,,0,0,0,,Кенто жігіттері
Dialogue: 0,0:04:12.50,0:04:15.04,Default,,0,0,0,,Уақытты басқару Жынды табу үшін
Dialogue: 0,0:04:15.12,0:04:17.00,Default,,0,0,0,,Сіз Токиодан Хакатаға келдіңіз бе?
Dialogue: 0,0:04:17.58,0:04:21.50,Default,,0,0,0,,Иә, мен анамды өмірге қайтарғым келеді.
Dialogue: 0,0:04:22.16,0:04:25.37,Default,,0,0,0,,Анам қазір Аннаның ішінде...
Dialogue: 0,0:04:26.91,0:04:28.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:28.83,0:04:32.25,Default,,0,0,0,,Көпір мен жердің жоғалып кетуіне Аннаның күші себеп болды ма?
Dialogue: 0,0:04:35.91,0:04:37.58,Default,,0,0,0,,Міне! Оны қорғаңыз!
Dialogue: 0,0:04:38.41,0:04:40.62,Default,,0,0,0,,Уау! аа!
Dialogue: 0,0:04:40.70,0:04:42.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:42.29,0:04:45.54,Default,,0,0,0,,Ана!
Dialogue: 0,0:04:46.33,0:04:49.95,Default,,0,0,0,,Кирико-сан, Ананы жиіркенішті деп таппайсың ба?
Dialogue: 0,0:04:51.20,0:04:53.66,Default,,0,0,0,,Менің жеке себептерім бар.
Dialogue: 0,0:04:54.37,0:04:57.08,Default,,0,0,0,,Сіз одан да шаршаған болуыңыз керек.
Dialogue: 0,0:04:57.16,0:04:58.91,Default,,0,0,0,,Қазір демалу керек.
Dialogue: 0,0:04:59.41,0:05:01.50,Default,,0,0,0,,Сіз сол жерде сол бөлмені пайдалана аласыз.
Dialogue: 0,0:05:02.00,0:05:03.58,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:05.54,0:05:08.16,Default,,0,0,0,,Маған неге сонша мейірімдісің?
Dialogue: 0,0:05:09.50,0:05:13.54,Default,,0,0,0,,Мүмкін менде де осындай жағдай болғандықтан шығар.
Dialogue: 0,0:05:15.08,0:05:17.25,Default,,0,0,0,,А? не?
Dialogue: 0,0:05:18.20,0:05:21.33,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:05:27.87,0:05:32.50,Default,,0,0,0,,(жәндіктердің ұшқан дыбысы)
Dialogue: 0,0:05:49.91,0:05:52.95,Default,,0,0,0,,(теру дыбысы)
Dialogue: 0,0:05:53.70,0:05:54.70,Default,,0,0,0,,Бұл Татара өзенінде болды
Dialogue: 0,0:05:54.79,0:05:56.16,Default,,0,0,0,,Біртүрлі оқиғалар туралы
Dialogue: 0,0:05:56.25,0:05:59.54,Default,,0,0,0,,Сағат 22.00-де біз сізге жаңа ақпаратты береміз.
Dialogue: 0,0:06:00.91,0:06:03.58,Default,,0,0,0,,Осакадағы бейбітшілік агенттігінің штаб-пәтерінің күйреуі
Dialogue: 0,0:06:03.66,0:06:05.50,Default,,0,0,0,,Бұл бір жынның ісі екенін
Dialogue: 0,0:06:05.58,0:06:06.58,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:06:07.08,0:06:08.12,Default,,0,0,0,,Бұл жын
Dialogue: 0,0:06:08.20,0:06:10.95,Default,,0,0,0,,11 жасар баламен жұмыс
Dialogue: 0,0:06:12.00,0:06:13.91,Default,,0,0,0,,Осы баланы көрген адам
Dialogue: 0,0:06:14.00,0:06:16.04,Default,,0,0,0,,Тез арада полицияға хабарласыңыз
Dialogue: 0,0:06:16.12,0:06:17.16,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:06:17.25,0:06:20.91,Default,,0,0,0,,Балаға ешқашан жақындамаңыз.
Dialogue: 0,0:06:30.29,0:06:32.66,Default,,0,0,0,,Жын қауіпті ме?
Dialogue: 0,0:06:32.75,0:06:37.87,Default,,0,0,0,,Егер бұл жағдай маңызды болып кетсе, Хаката картадан жоғалады.
Dialogue: 0,0:06:38.45,0:06:42.16,Default,,0,0,0,,Сен ақымақ Қорғаныс министрін ыңғайсыздандырып жатырсың ба?
Dialogue: 0,0:06:42.79,0:06:45.29,Default,,0,0,0,,Неліктен бейбітшілік агенттіктері ұзақ уақыт жалғыз қалды?
Dialogue: 0,0:06:45.37,0:06:47.70,Default,,0,0,0,,Неліктен бұл туралы дереу хабарлаған жоқсыз?
Dialogue: 0,0:06:47.79,0:06:52.29,Default,,0,0,0,,Біз бұл мәселені шешуге жауаптымыз.
Dialogue: 0,0:06:52.37,0:06:55.95,Default,,0,0,0,,Не істеу керектігін министрге есеп бергеннен кейін шешеміз.
Dialogue: 0,0:06:56.04,0:06:58.33,Default,,0,0,0,,Онда тым кеш...
Dialogue: 0,0:06:58.41,0:07:03.08,Default,,0,0,0,,Мұндай залалдың себебі бейбітшілік ұйымдарының ештеңе істей алмауынан болды.
Dialogue: 0,0:07:03.16,0:07:07.08,Default,,0,0,0,,Министрдің рұқсатынсыз әрекет етуге тыйым салынады!
Dialogue: 0,0:07:15.41,0:07:17.20,Default,,0,0,0,,Коконоемен байланысыңыз
Dialogue: 0,0:07:18.45,0:07:19.87,Default,,0,0,0,,Иә, Төраға
Dialogue: 0,0:07:20.62,0:07:24.12,Default,,0,0,0,,Біз оқиға орнына бара жатырмыз. Қандай да бір өзгерістер бар ма?
Dialogue: 0,0:07:25.29,0:07:26.54,Default,,0,0,0,,Өзгерістер жоқ
Dialogue: 0,0:07:27.04,0:07:30.08,Default,,0,0,0,,Қорғаныс министрлігінен рұқсат алынбағанымен
Dialogue: 0,0:07:30.95,0:07:36.20,Default,,0,0,0,,Операция сәтті болуы үшін барлық құралдарыңызды пайдаланыңыз.
Dialogue: 0,0:07:36.79,0:07:37.83,Default,,0,0,0,,Қосымша күштер! Біз тез арада қорғаныс жасауымыз керек, әйтпесе қайтадан қоршауға алынамыз.
Dialogue: 0,0:07:40.20,0:07:43.29,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:53.41,0:07:55.08,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:07:55.95,0:07:58.91,Default,,0,0,0,,Аннаның өзін жақсы сезінгеніне қуаныштымын!
Dialogue: 0,0:07:59.00,0:08:01.08,Default,,0,0,0,,Сіз! аа! (Кенто) Ахаха эй~
Dialogue: 0,0:08:01.87,0:08:04.16,Default,,0,0,0,,Енді біз тағы да бірге саяхаттай аламыз.
Dialogue: 0,0:08:04.25,0:08:05.25,Default,,0,0,0,,Сіз!
Dialogue: 0,0:08:07.58,0:08:09.29,Default,,0,0,0,,Амансың ба? Кирико-сан
Dialogue: 0,0:08:09.37,0:08:10.12,Default,,0,0,0,,Нана?
Dialogue: 0,0:08:13.08,0:08:14.08,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:08:14.58,0:08:18.33,Default,,0,0,0,,Балалар, сіз басқа уақытты басқаратын жын іздеп жүрсіз бе?
Dialogue: 0,0:08:18.41,0:08:21.45,Default,,0,0,0,,А... Иә, өйткені мен босаңсуға болмайды.
Dialogue: 0,0:08:21.95,0:08:24.33,Default,,0,0,0,,Рахмет, Кирико-сан.
Dialogue: 0,0:08:24.41,0:08:25.70,Default,,0,0,0,,Сен сияқты жігіт тазаруға тиіс.
Dialogue: 0,0:08:26.79,0:08:29.33,Default,,0,0,0,,Мен кетер алдында сізге бір нәрсе көрсеткім келеді.
Dialogue: 0,0:08:33.29,0:08:35.25,Default,,0,0,0,,Сізді солай еткенім үшін кешіріңіз.
Dialogue: 0,0:08:35.75,0:08:38.41,Default,,0,0,0,,Бірақ қазір мен бұрынғыға қарағанда қауіпсіз әрекет ете аламын.
Dialogue: 0,0:08:38.50,0:08:39.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:39.79,0:08:40.54,Default,,0,0,0,,Мориёх қандай әдемі қала.
Dialogue: 0,0:08:40.62,0:08:44.45,Default,,0,0,0,,Кирико мырза, сіз бізді қайда апарасыз?
Dialogue: 0,0:08:45.08,0:08:47.50,Default,,0,0,0,,Бұл кешегі жауаптарды таба алатын жер
Dialogue: 0,0:08:47.58,0:08:50.08,Default,,0,0,0,,Мен неге жындардан қорықпаймын?
Dialogue: 0,0:09:04.87,0:09:07.08,Default,,0,0,0,,Сен қалай қатыгез болдың?
Dialogue: 0,0:09:07.70,0:09:11.33,Default,,0,0,0,,Жындар мен басқа жаратылыстардың өмірі бірдей салмаққа ие.
Dialogue: 0,0:09:12.29,0:09:14.91,Default,,0,0,0,,Мұны істеудің еш мәні жоқ.
Dialogue: 0,0:09:15.75,0:09:19.62,Default,,0,0,0,,Адамзат тарихында жындардың өмірі еленбеген.
Dialogue: 0,0:09:21.04,0:09:24.87,Default,,0,0,0,,Анна екеуің осындай жағдайға тап болдыңдар ма?
Dialogue: 0,0:09:24.95,0:09:27.83,Default,,0,0,0,,Мен сені Кенто-кунды таң қалдыратын жерге апарамын.
Dialogue: 0,0:09:29.45,0:09:31.04,Default,,0,0,0,,Сіздің алдыңызда
Dialogue: 0,0:09:31.12,0:09:34.00,Default,,0,0,0,,Сақтандырғыш шыны қораптың ішінде не бейнеленген?
Dialogue: 0,0:09:34.08,0:09:37.12,Default,,0,0,0,,«Пандемониум» алып жынының тырнақтары
Dialogue: 0,0:09:38.08,0:09:41.79,Default,,0,0,0,,50 жыл бұрын ол Американың батыс жағалауында кенеттен пайда болды.
Dialogue: 0,0:09:42.41,0:09:44.50,Default,,0,0,0,,Бірнеше қалаларды жойыңыз
Dialogue: 0,0:09:44.58,0:09:47.62,Default,,0,0,0,,3 миллионға жуық адамның өліміне себепкер болған әйгілі.
Dialogue: 0,0:09:55.70,0:09:57.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:57.95,0:10:00.33,Default,,0,0,0,,Ең күшті және ең жаман жын
Dialogue: 0,0:10:00.41,0:10:03.79,Default,,0,0,0,,Қаруды көп қолданғандықтан, жер бедері өзгереді
Dialogue: 0,0:10:03.87,0:10:06.04,Default,,0,0,0,,Ақыры жұмысын тоқтатқан сияқты.
Dialogue: 0,0:10:06.54,0:10:07.83,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:09.04,0:10:11.83,Default,,0,0,0,,Бірақ жоқ, бұл жосықсыз.
Dialogue: 0,0:10:11.91,0:10:13.95,Default,,0,0,0,,Көптеген адамдар өліп жатыр
Dialogue: 0,0:10:14.50,0:10:18.37,Default,,0,0,0,,Бірақ өлтірілген жындар санымен салыстырғанда бұл аз.
Dialogue: 0,0:10:18.45,0:10:19.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:20.54,0:10:23.83,Default,,0,0,0,,Адамдар жәндіктер сияқты жаншылады
Dialogue: 0,0:10:23.91,0:10:27.16,Default,,0,0,0,,Менің қаза тапқан жолдастарымның санымен салыстырғанда.
Dialogue: 0,0:10:27.79,0:10:29.12,Default,,0,0,0,,Шағын сан
Dialogue: 0,0:10:29.62,0:10:30.70,Default,,0,0,0,,(Шинобу) Мұнда тірі қалғандар жоқ сияқты.
Dialogue: 0,0:10:34.08,0:10:35.20,Default,,0,0,0,,Жоқ...?
Dialogue: 0,0:10:36.45,0:10:39.62,Default,,0,0,0,,Қараңызшы, ішіңіздегі жын әрекет жасап жатыр.
Dialogue: 0,0:10:40.70,0:10:43.33,Default,,0,0,0,,Мұнда кел, мен саған түсіндіремін.
Dialogue: 0,0:10:44.33,0:10:46.29,Default,,0,0,0,,«Бұзуға болмайды»
Dialogue: 0,0:10:47.12,0:10:49.54,Default,,0,0,0,,Кирико мырза? Неге мұндасың...
Dialogue: 0,0:10:50.45,0:10:52.66,Default,,0,0,0,,Заттың жады бар
Dialogue: 0,0:10:56.70,0:11:01.62,Default,,0,0,0,,Менің күшім – заттарды бастапқы қалпына келтіру үшін сол жадыға сүйену.
Dialogue: 0,0:11:02.70,0:11:03.79,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:11:04.45,0:11:06.75,Default,,0,0,0,,Жетіспейтін бөліктер қалпына келтірілді
Dialogue: 0,0:11:10.75,0:11:11.33,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:11:25.25,0:11:26.41,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:11:32.20,0:11:33.16,Default,,0,0,0,,Кенто-кун
Dialogue: 0,0:11:33.25,0:11:36.25,Default,,0,0,0,,Мен Аннадан неге қорықпағанымды сұрадың.
Dialogue: 0,0:11:36.83,0:11:39.08,Default,,0,0,0,,Өйткені менің шынайы болмысым – жын.
Dialogue: 0,0:11:39.58,0:11:41.79,Default,,0,0,0,,Мен қалпына келтіру жынмын.
Dialogue: 0,0:11:45.66,0:11:49.41,Default,,0,0,0,,1 жыл бұрын Бұл баланы бірнеше жыл бұрын көлік қағып өлтірген.
Dialogue: 0,0:11:49.41,0:11:52.41,Default,,0,0,0,,1 жыл бұрын
Dialogue: 0,0:11:55.25,0:11:58.66,Default,,0,0,0,,Машина кетіп қалды, мен жалғыз куә болдым.
Dialogue: 0,0:11:59.91,0:12:04.20,Default,,0,0,0,,Мен ыңғайсызданып, баланың ішіне кірдім.
Dialogue: 0,0:12:07.25,0:12:12.29,Default,,0,0,0,,Ішкі мүшелер мен сүйектерді жеп, миын біріктіріп, біртұтас болды.
Dialogue: 0,0:12:15.75,0:12:20.37,Default,,0,0,0,,Үнемі жөндеу және қалпына келтіру, сондықтан ол ешқашан шіріп кетпейді
Dialogue: 0,0:12:27.41,0:12:29.54,Default,,0,0,0,,Мен адамдар туралы білгім келді.
Dialogue: 0,0:12:30.04,0:12:32.29,Default,,0,0,0,,Неліктен жындарды қудалау керек?
Dialogue: 0,0:12:32.95,0:12:36.33,Default,,0,0,0,,Осылайша мен адам болып көрініп, қоғамға араластым.
Dialogue: 0,0:12:36.41,0:12:37.75,Default,,0,0,0,,Мен бақылап отырдым
Dialogue: 0,0:12:38.37,0:12:41.45,Default,,0,0,0,,Қазіргі аты-жөні мен тегі осы балаға тиесілі.
Dialogue: 0,0:12:42.08,0:12:44.95,Default,,0,0,0,,Сөйлейтін жындар болды.
Dialogue: 0,0:12:45.04,0:12:47.12,Default,,0,0,0,,Мүмкін бұл мутация
Dialogue: 0,0:12:47.20,0:12:49.41,Default,,0,0,0,,Менің серігім сөйлей алмады.
Dialogue: 0,0:12:50.00,0:12:51.29,Default,,0,0,0,,Уақыттың шайтаны?
Dialogue: 0,0:12:51.91,0:12:54.66,Default,,0,0,0,,Кюсюда уақыт жын бар деген қауесет бар.
Dialogue: 0,0:12:54.75,0:12:56.75,Default,,0,0,0,,Мүмкін бұл мен туралы болған шығар.
Dialogue: 0,0:12:57.54,0:13:02.00,Default,,0,0,0,,Біреу қалпына келтіру қабілетін көріп, оны дұрыс түсінбей қалды ма деп ойлаймын.
Dialogue: 0,0:13:02.08,0:13:03.08,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:13:03.16,0:13:05.16,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:13:07.25,0:13:09.00,Default,,0,0,0,,Эрозия дамып жатыр ма?
Dialogue: 0,0:13:11.83,0:13:13.70,Default,,0,0,0,,Иә? Кирико-кун?
Dialogue: 0,0:13:13.79,0:13:17.62,Default,,0,0,0,,Сасаки мырза, сізді осындай жерде кездестіру біртүрлі кездейсоқтық болды.
Dialogue: 0,0:13:17.70,0:13:20.08,Default,,0,0,0,,Шынымен, ол бала кім?
Dialogue: 0,0:13:20.66,0:13:21.95,Default,,0,0,0,,Кента немере ағасы
Dialogue: 0,0:13:22.04,0:13:25.45,Default,,0,0,0,,Мен мұнда қонаққа келдім, сондықтан мен сендерге Хакатаның айналасын көрсетемін.
Dialogue: 0,0:13:25.54,0:13:27.79,Default,,0,0,0,,Танысқаныма қуаныштымын, Кента-кун
Dialogue: 0,0:13:33.50,0:13:35.83,Default,,0,0,0,,Сасаки-сан, мектепте кездескенше.
Dialogue: 0,0:13:38.54,0:13:43.79,Default,,0,0,0,,Жындармен бетпе-бет келгенде, адамдар жан деңгейінде жиіркенішті сезінеді.
Dialogue: 0,0:13:43.87,0:13:47.41,Default,,0,0,0,,Бірақ терінің бір бөлігі сізді оңай алдауы мүмкін.
Dialogue: 0,0:13:47.50,0:13:48.83,Default,,0,0,0,,Адамдар ақымақ
Dialogue: 0,0:13:49.33,0:13:52.04,Default,,0,0,0,,Мен жедім Мен жедім Өте дәмді болды
Dialogue: 0,0:13:52.12,0:13:53.20,Default,,0,0,0,,Дұрыс? (дос) иә
Dialogue: 0,0:13:56.50,0:13:58.45,Default,,0,0,0,,Сәлеметсіз бе, сіз полициясыз ба?
Dialogue: 0,0:13:59.45,0:14:02.79,Default,,0,0,0,,Өзенде болған оқиға туралы маңызды ақпарат бар.
Dialogue: 0,0:14:04.37,0:14:05.95,Default,,0,0,0,,Кенто-кун, жақсысың ба?
Dialogue: 0,0:14:06.04,0:14:07.50,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:08.00,0:14:12.45,Default,,0,0,0,,Кирико мырза, сіз менің анамды қалпына келтіріп, тірілте аласыз ба?
Dialogue: 0,0:14:13.29,0:14:16.29,Default,,0,0,0,,Маған анаңыздың денесін сынақ ретінде көрсете аласыз ба?
Dialogue: 0,0:14:17.20,0:14:20.54,Default,,0,0,0,,Мен оны қалпына келтірсем, анам қайта тіріле ме?
Dialogue: 0,0:14:21.12,0:14:23.91,Default,,0,0,0,,Мен білмеймін, бірақ байқап көруге тұрарлық.
Dialogue: 0,0:14:25.25,0:14:26.04,Default,,0,0,0,,Ана!
Dialogue: 0,0:14:26.12,0:14:27.16,Default,,0,0,0,,Сіз!
Dialogue: 0,0:14:27.25,0:14:29.50,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:14:32.70,0:14:33.75,Default,,0,0,0,,Анам…
Dialogue: 0,0:14:34.33,0:14:37.33,Default,,0,0,0,,Ананың құдіреті шынымен қызық
Dialogue: 0,0:14:41.20,0:14:42.41,Default,,0,0,0,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,0:14:44.45,0:14:45.58,Default,,0,0,0,,Кенто-кун...
Dialogue: 0,0:14:53.29,0:14:55.12,Default,,0,0,0,,Мен оны қалпына келтіруге тырысамын.
Dialogue: 0,0:15:06.08,0:15:07.16,Default,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:15:09.37,0:15:12.95,Default,,0,0,0,,Кенто Тачибана қауіпті жынға ие болу және⸺
Dialogue: 0,0:15:13.04,0:15:15.25,Default,,0,0,0,,Сервитут қылмысы үшін қоршауға алынған
Dialogue: 0,0:15:16.41,0:15:19.29,Default,,0,0,0,,Мен 5 секундқа дейін санап жатқанда, тыныш шық.
Dialogue: 0,0:15:19.79,0:15:23.00,Default,,0,0,0,,Айтқанымды істемесең, асығыс кіріп, қамқорлыққа аламын.
Dialogue: 0,0:15:23.08,0:15:25.29,Default,,0,0,0,,Ах! (Әскер) 5...
Dialogue: 0,0:15:26.50,0:15:27.33,Default,,0,0,0,,４…
Dialogue: 0,0:15:27.41,0:15:28.54,Default,,0,0,0,,Неге...
Dialogue: 0,0:15:28.62,0:15:30.33,Default,,0,0,0,,Менің ойымша, бұл туралы Сасаки мырза хабарлады.
Dialogue: 0,0:15:30.41,0:15:31.25,Default,,0,0,0,,3… Сіз!
Dialogue: 0,0:15:31.33,0:15:33.54,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:15:33.62,0:15:35.45,Default,,0,0,0,,２… 1…
Dialogue: 0,0:15:36.45,0:15:37.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:37.45,0:15:38.45,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:40.41,0:15:42.45,Default,,0,0,0,,Тезірек бұл жерден кет!
Dialogue: 0,0:15:42.54,0:15:43.45,Default,,0,0,0,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,0:15:45.54,0:15:47.91,Default,,0,0,0,,Ана, анаңды кіргіз!
Dialogue: 0,0:15:48.00,0:15:49.00,Default,,0,0,0,,Сіз!
Dialogue: 0,0:15:51.45,0:15:52.66,Default,,0,0,0,,Сіз!
Dialogue: 0,0:15:54.54,0:15:55.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:58.29,0:16:00.54,Default,,0,0,0,,Анна Ана...
Dialogue: 0,0:16:02.04,0:16:04.20,Default,,0,0,0,,Уау! (Әскер) Гах...
Dialogue: 0,0:16:10.29,0:16:11.70,Default,,0,0,0,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,0:16:11.79,0:16:13.58,Default,,0,0,0,,Тезірек бұл жерден кет!
Dialogue: 0,0:16:22.95,0:16:24.33,Default,,0,0,0,,Мақсатқа жету!
Dialogue: 0,0:16:24.41,0:16:25.83,Default,,0,0,0,,Атуға рұқсат етіңіз
Dialogue: 0,0:16:25.91,0:16:26.83,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:16:26.91,0:16:27.83,Default,,0,0,0,,Кирико-сан!
Dialogue: 0,0:16:28.33,0:16:29.45,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:16:35.54,0:16:36.41,Default,,0,0,0,,Түсіруді тоқтатыңыз!
Dialogue: 0,0:16:39.12,0:16:40.20,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:16:41.20,0:16:44.87,Default,,0,0,0,,Әй... адамдар байсалды сияқты.
Dialogue: 0,0:16:50.50,0:16:52.04,Default,,0,0,0,,Егер шайқаста жеңілсең—
Dialogue: 0,0:16:55.33,0:16:57.08,Default,,0,0,0,,Тез кеттік, Кенто-кун!
Dialogue: 0,0:17:10.12,0:17:14.41,Default,,0,0,0,,Қазіргі уақытта Хаката қаласында төтенше жағдай жарияланды.
Dialogue: 0,0:17:14.50,0:17:18.04,Default,,0,0,0,,Қаланы қирататын жын жасырынып жүр дейді.
Dialogue: 0,0:17:18.83,0:17:22.87,Default,,0,0,0,,Сондықтан бүкіл халық эвакуацияланып, қала жабылды.
Dialogue: 0,0:17:22.95,0:17:26.29,Default,,0,0,0,,Біз сіздің қауіпсіздігіңізді қорғау үшін әскер жібереміз.
Dialogue: 0,0:17:27.41,0:17:29.08,Default,,0,0,0,,Бұл қалада тұру қауіпті.
Dialogue: 0,0:17:29.83,0:17:32.91,Default,,0,0,0,,Өзіңізбен бірге бағалы заттарды алып, жылдам қозғалыңыз
Dialogue: 0,0:17:41.33,0:17:44.54,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:17:45.04,0:17:45.62,Default,,0,0,0,,Сіз!
Dialogue: 0,0:17:45.70,0:17:47.08,Default,,0,0,0,,Мен адасып қалдым
Dialogue: 0,0:17:47.58,0:17:50.75,Default,,0,0,0,,Мен қазір жеңілдеп қалдым. Не болып жатыр?
Dialogue: 0,0:17:50.83,0:17:52.29,Default,,0,0,0,,Кирико-сан
Dialogue: 0,0:17:52.37,0:17:55.91,Default,,0,0,0,,Ол кісілерді сен өлтірген жоқсың ғой?
Dialogue: 0,0:17:56.79,0:17:58.41,Default,,0,0,0,,Сен мейірімдісің.
Dialogue: 0,0:17:58.95,0:18:01.33,Default,,0,0,0,,Ол өліп қала жаздады.
Dialogue: 0,0:18:01.41,0:18:03.91,Default,,0,0,0,,Анамның қалпына келуіне де кедергі болды.
Dialogue: 0,0:18:05.66,0:18:06.33,Default,,0,0,0,,Сіз?
Dialogue: 0,0:18:06.41,0:18:07.29,Default,,0,0,0,,Анам…
Dialogue: 0,0:18:07.37,0:18:09.33,Default,,0,0,0,,Бұл! Эй...
Dialogue: 0,0:18:09.41,0:18:10.62,Default,,0,0,0,,Кенто-кун
Dialogue: 0,0:18:11.12,0:18:14.08,Default,,0,0,0,,Сіз әлі адам жағындасыз, солай емес пе?
Dialogue: 0,0:18:17.41,0:18:21.37,Default,,0,0,0,,Біздің жақта тұрсаң, олай ойламайсың.
Dialogue: 0,0:18:22.16,0:18:26.91,Default,,0,0,0,,Мен адамдар ақылсыз өлтірген жындарды ойласам,
Dialogue: 0,0:18:27.00,0:18:29.16,Default,,0,0,0,,Мен әлі жеткілікті өлтірген жоқпын.
Dialogue: 0,0:18:30.29,0:18:33.66,Default,,0,0,0,,Бір күні мен жындарды езген адамзат баласын құртамын.
Dialogue: 0,0:18:33.75,0:18:35.62,Default,,0,0,0,,Жоюды қалайды
Dialogue: 0,0:18:36.25,0:18:40.12,Default,,0,0,0,,Мен адам кейпіне еніп, бақылап, ойладым.
Dialogue: 0,0:18:41.04,0:18:44.83,Default,,0,0,0,,Адам түрін қалай жоюға болады?
Dialogue: 0,0:18:51.95,0:18:53.58,Default,,0,0,0,,(жәндіктердің ұшқан дыбысы)
Dialogue: 0,0:18:54.25,0:18:56.12,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:18:57.08,0:19:00.70,Default,,0,0,0,,Кенто-кун, Ана, менің досым болшы.
Dialogue: 0,0:19:00.79,0:19:02.41,Default,,0,0,0,,Менімен төбелесесіңдер ме?
Dialogue: 0,0:19:03.20,0:19:05.29,Default,,0,0,0,,Жындар бекер өлтірілмейді
Dialogue: 0,0:19:05.37,0:19:09.25,Default,,0,0,0,,Сізді кемсітпейтін баспана жасаңыз.
Dialogue: 0,0:19:10.25,0:19:14.20,Default,,0,0,0,,Жындар қуғынсыз өмір сүретін ел жасаймын.
Dialogue: 0,0:19:14.29,0:19:16.33,Default,,0,0,0,,Мен ол үшін бәрін жасаймын
Dialogue: 0,0:19:17.16,0:19:19.41,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:19:21.04,0:19:23.41,Default,,0,0,0,,Ааа... ана
Dialogue: 0,0:19:28.33,0:19:29.95,Default,,0,0,0,,Кенто-кун Анна
Dialogue: 0,0:19:30.04,0:19:33.08,Default,,0,0,0,,Сізде оны жүзеге асыруға күшіңіз жетеді.
Dialogue: 0,0:19:39.29,0:19:43.45,Default,,0,0,0,,Егер сіз Pandemonium-ды қалпына келтіруде ынтымақтассаңыз.
Dialogue: 0,0:19:43.54,0:19:45.87,Default,,0,0,0,,Мен сенің тілегіңді орындаймын
Dialogue: 0,0:19:49.58,0:19:50.58,Default,,0,0,0,,Кенто?
Dialogue: 0,0:19:54.41,0:19:58.04,Default,,0,0,0,,«Қайта тірілу»
Dialogue: 0,0:20:01.20,0:20:02.41,Default,,0,0,0,,Бұл Кенто ма?
Dialogue: 0,0:20:05.16,0:20:06.91,Default,,0,0,0,,Анашым! Ахх
Dialogue: 0,0:20:15.04,0:20:17.04,Default,,0,0,0,,♪～
Dialogue: 0,0:22:39.16,0:22:41.16,Default,,0,0,0,,～♪
Dialogue: 0,0:22:42.66,0:22:48.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
