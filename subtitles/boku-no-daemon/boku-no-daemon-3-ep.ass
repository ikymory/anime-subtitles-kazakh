Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:16.04,0:00:21.08,Default,,0,0,0,,(сағаттың секунд тілінің дыбысы)
Dialogue: 0,0:00:21.16,0:00:22.08,Default,,0,0,0,,Сіз...
Dialogue: 0,0:00:23.37,0:00:24.54,Default,,0,0,0,,Сіз!
Dialogue: 0,0:00:24.62,0:00:25.66,Default,,0,0,0,,Кенто
Dialogue: 0,0:00:26.20,0:00:27.20,Default,,0,0,0,,Сіз!
Dialogue: 0,0:00:27.29,0:00:28.91,Default,,0,0,0,,(трейлер қозғалтқышының дыбысы)
Dialogue: 0,0:00:40.50,0:00:42.50,Default,,0,0,0,,♪～
Dialogue: 0,0:02:00.58,0:02:00.75,Default,,0,0,0,,～♪
Dialogue: 0,0:02:00.75,0:02:02.58,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:02:00.75,0:02:02.58,Default,,0,0,0,,～♪
Dialogue: 0,0:02:02.58,0:02:05.62,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:02:21.87,0:02:22.87,Default,,0,0,0,,Тиіп көр!
Dialogue: 0,0:02:23.70,0:02:25.08,Default,,0,0,0,,Val...
Dialogue: 0,0:02:33.45,0:02:35.33,Default,,0,0,0,,Топырақты жерге сақтадың ба?
Dialogue: 0,0:02:35.83,0:02:38.20,Default,,0,0,0,,Құндылық! (Кенто) Ана, тіркеме сұра!
Dialogue: 0,0:02:38.29,0:02:39.87,Default,,0,0,0,,Сіз! Құн?
Dialogue: 0,0:02:39.95,0:02:42.37,Default,,0,0,0,,Вару Вару Вару Вару…
Dialogue: 0,0:02:50.83,0:02:53.16,Default,,0,0,0,,Варуу!
Dialogue: 0,0:02:55.87,0:02:58.50,Default,,0,0,0,,Вару! Балу...!
Dialogue: 0,0:02:59.41,0:03:00.95,Default,,0,0,0,,Мен саған рұқсат бермеймін!
Dialogue: 0,0:03:01.04,0:03:02.37,Default,,0,0,0,,Вару!
Dialogue: 0,0:03:05.12,0:03:07.33,Default,,0,0,0,,Вару! О, менің!
Dialogue: 0,0:03:08.50,0:03:09.41,Default,,0,0,0,,Куфуфу
Dialogue: 0,0:03:10.91,0:03:12.66,Default,,0,0,0,,Ана! Құндылық!
Dialogue: 0,0:03:25.33,0:03:26.41,Default,,0,0,0,,Вару!
Dialogue: 0,0:03:27.00,0:03:28.08,Default,,0,0,0,,Эй... О!
Dialogue: 0,0:03:30.00,0:03:31.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:31.45,0:03:33.50,Default,,0,0,0,,Вару! тесік!
Dialogue: 0,0:03:33.58,0:03:34.79,Default,,0,0,0,,Мән
Dialogue: 0,0:03:36.50,0:03:38.25,Default,,0,0,0,,Вару? Құн?
Dialogue: 0,0:03:39.33,0:03:41.04,Default,,0,0,0,,Жоқ... мына жігіт! тесік!
Dialogue: 0,0:03:41.12,0:03:42.25,Default,,0,0,0,,Не?
Dialogue: 0,0:03:42.33,0:03:43.37,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:03:48.41,0:03:49.41,Default,,0,0,0,,Ана!
Dialogue: 0,0:03:59.87,0:04:00.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:02.25,0:04:04.75,Default,,0,0,0,,Жүгір, Ана! Құлайды!
Dialogue: 0,0:04:05.66,0:04:06.62,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:07.45,0:04:08.29,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:14.79,0:04:16.00,Default,,0,0,0,,Ана!
Dialogue: 0,0:04:16.08,0:04:17.70,Default,,0,0,0,,Вару!
Dialogue: 0,0:04:17.79,0:04:20.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:22.16,0:04:23.00,Default,,0,0,0,,Вару!
Dialogue: 0,0:04:31.62,0:04:32.66,Default,,0,0,0,,Мән...
Dialogue: 0,0:04:38.20,0:04:40.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:44.79,0:04:46.66,Default,,0,0,0,,Var…
Dialogue: 0,0:04:51.62,0:04:52.45,Default,,0,0,0,,Мән...
Dialogue: 0,0:04:55.00,0:04:56.00,Default,,0,0,0,,Анна…
Dialogue: 0,0:05:04.50,0:05:06.87,Default,,0,0,0,,Керемет! Жақсы болды!
Dialogue: 0,0:05:09.16,0:05:10.16,Default,,0,0,0,,Анааа
Dialogue: 0,0:05:17.62,0:05:18.54,Default,,0,0,0,,Val...
Dialogue: 0,0:05:35.58,0:05:39.83,Default,,0,0,0,,Барон: Сен Урага-санды жақсы көрдің, солай ма?
Dialogue: 0,0:05:58.45,0:06:00.79,Default,,0,0,0,,Сәлем! Кенто-кун!
Dialogue: 0,0:06:00.87,0:06:01.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:02.58,0:06:03.66,Default,,0,0,0,,Ино-сан?
Dialogue: 0,0:06:03.75,0:06:05.54,Default,,0,0,0,,Такеда-сан да!
Dialogue: 0,0:06:06.12,0:06:10.33,Default,,0,0,0,,Ино-сан Такеда-сан! Жақсы болдыңыз ба?
Dialogue: 0,0:06:11.37,0:06:12.75,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:06:12.83,0:06:14.54,Default,,0,0,0,,Қан бірден тоқтады.
Dialogue: 0,0:06:15.04,0:06:17.79,Default,,0,0,0,,Мүмкін олар өмірлік маңызды бөліктерді әдейі қалдырған шығар.
Dialogue: 0,0:06:18.29,0:06:21.54,Default,,0,0,0,,Барон мені өлтіремін деп сыңай танытқан шығар.
Dialogue: 0,0:06:21.62,0:06:25.62,Default,,0,0,0,,Орағаның жігіті де бір ақымақ нәрсені ойлап отырды.
Dialogue: 0,0:06:26.50,0:06:27.91,Default,,0,0,0,,Біз Токиоға қайтамыз
Dialogue: 0,0:06:28.00,0:06:31.12,Default,,0,0,0,,Менімен жүр, мен сені жалғыз жібере алмаймын.
Dialogue: 0,0:06:31.20,0:06:32.75,Default,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,0:06:32.83,0:06:33.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:34.45,0:06:37.04,Default,,0,0,0,,Мені ұстап тұрудың қажеті жоқ, бұл көздер...
Dialogue: 0,0:06:40.79,0:06:42.33,Default,,0,0,0,,Ау!
Dialogue: 0,0:06:45.95,0:06:48.04,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:06:57.29,0:07:00.79,Default,,0,0,0,,Уау... бұл керемет!
Dialogue: 0,0:07:00.87,0:07:02.04,Default,,0,0,0,,Ах...!
Dialogue: 0,0:07:02.54,0:07:06.16,Default,,0,0,0,,Фудзи тауының етегінде жайылған орман
Dialogue: 0,0:07:18.41,0:07:20.41,Default,,0,0,0,,Ха! Ха! Ха!
Dialogue: 0,0:07:25.91,0:07:28.45,Default,,0,0,0,,Кирикиру Кирукиру…
Dialogue: 0,0:07:36.95,0:07:38.20,Default,,0,0,0,,Тыныш
Dialogue: 0,0:07:38.29,0:07:42.50,Default,,0,0,0,,Кирикиру Кирукиру…
Dialogue: 0,0:07:54.83,0:07:56.12,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:07:57.16,0:07:57.95,Default,,0,0,0,,Сәлем...!
Dialogue: 0,0:08:07.70,0:08:09.45,Default,,0,0,0,,Өзіңді тым биік ұстама! (Какиёин) Қойсаңшы енді!
Dialogue: 0,0:08:13.37,0:08:14.37,Default,,0,0,0,,Сіз!
Dialogue: 0,0:08:15.20,0:08:18.12,Default,,0,0,0,,Ха! Бұл қала! Барайық!
Dialogue: 0,0:08:21.58,0:08:25.00,Default,,0,0,0,,Иә? Эй, сен саяхатшысың ба?
Dialogue: 0,0:08:25.08,0:08:26.33,Default,,0,0,0,,Манга ма? Ах, мен де бәрібір адам сияқты оқимын ғой, болар.
Dialogue: 0,0:08:26.87,0:08:27.87,Default,,0,0,0,,Жасыру!
Dialogue: 0,0:08:29.83,0:08:31.29,Default,,0,0,0,,Қамқоршың жоқ па?
Dialogue: 0,0:08:31.37,0:08:32.75,Default,,0,0,0,,Бір адам!
Dialogue: 0,0:08:32.83,0:08:34.66,Default,,0,0,0,,Оны салыңыз! Сыртта қауіпті!
Dialogue: 0,0:08:34.75,0:08:36.95,Default,,0,0,0,,(қақпаның ашылған дыбысы)
Dialogue: 0,0:08:48.25,0:08:52.41,Default,,0,0,0,,Шидзуока маңындағы қызмет көрсету аймағы
Dialogue: 0,0:08:52.50,0:08:54.25,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:54.33,0:08:57.75,Default,,0,0,0,,Бұл қызмет көрсету аймағы қазір қала ма?
Dialogue: 0,0:09:20.79,0:09:22.04,Default,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:09:22.54,0:09:24.70,Default,,0,0,0,,Бір чикува темпура, өтінемін!
Dialogue: 0,0:09:25.79,0:09:27.08,Default,,0,0,0,,(Танжиро) Бір сәт бұрын осы адам осы жерде жай ғана серуендеп жүрген еді…
Dialogue: 0,0:09:38.16,0:09:41.37,Default,,0,0,0,,Қараңдаршы, бұл Аннаның сүйікті тағамы, чикува.
Dialogue: 0,0:09:41.45,0:09:43.75,Default,,0,0,0,,А-а-а-а!
Dialogue: 0,0:09:43.83,0:09:46.08,Default,,0,0,0,,Эй, сен мұны естідің бе? Сол қауесет
Dialogue: 0,0:09:47.12,0:09:48.70,Default,,0,0,0,,Сіз өлтірілген жігіт туралы айтып отырсыз ба?
Dialogue: 0,0:09:49.20,0:09:53.00,Default,,0,0,0,,Қалада біреу радионың көмекке шақырғанын естіген сияқты.
Dialogue: 0,0:09:53.79,0:09:55.87,Default,,0,0,0,,«Сэнджу» деп аталады ма?
Dialogue: 0,0:09:55.95,0:09:58.58,Default,,0,0,0,,Сенджу? Бұл не?
Dialogue: 0,0:09:58.66,0:10:00.50,Default,,0,0,0,,Сенджу Каннон
Dialogue: 0,0:10:00.58,0:10:02.95,Default,,0,0,0,,Қолдар көп.
Dialogue: 0,0:10:03.04,0:10:04.33,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:10:04.91,0:10:05.62,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:10:06.20,0:10:07.95,Default,,0,0,0,,Уау! сүйкімді!
Dialogue: 0,0:10:08.45,0:10:11.00,Default,,0,0,0,,Билікте мен болсам ғой
Dialogue: 0,0:10:11.08,0:10:14.33,Default,,0,0,0,,Мен сізге келесі шоттың жобасын дайындаймын.
Dialogue: 0,0:10:14.41,0:10:15.45,Default,,0,0,0,,Ахана?
Dialogue: 0,0:10:20.79,0:10:21.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:27.25,0:10:30.95,Default,,0,0,0,,Кешіріңіз, ата-анаңыз осында ма?
Dialogue: 0,0:10:31.04,0:10:32.58,Default,,0,0,0,,Жоқ, тек бір адам.
Dialogue: 0,0:10:33.16,0:10:38.79,Default,,0,0,0,,Хмм... Шарттарға сәйкес 13 жасқа дейінгі балаларға тұруға рұқсат етілмейді.
Dialogue: 0,0:10:38.87,0:10:41.29,Default,,0,0,0,,Ата-ана бақылауы қажет
Dialogue: 0,0:10:41.37,0:10:42.87,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:10:46.20,0:10:48.66,Default,,0,0,0,,Бұл не? Бұл жиіркенішті сезінеді!
Dialogue: 0,0:10:59.58,0:11:00.66,Default,,0,0,0,,(Кенто күрсінуі)
Dialogue: 0,0:11:02.08,0:11:04.00,Default,,0,0,0,,Ағай, бұл не?
Dialogue: 0,0:11:04.50,0:11:07.37,Default,,0,0,0,,Шизуоканың ерекшелігі - маринадталған васаби
Dialogue: 0,0:11:09.04,0:11:10.54,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,0:11:10.62,0:11:14.33,Default,,0,0,0,,Хмм, бұл балалар үшін тым қызықты болуы мүмкін.
Dialogue: 0,0:11:15.20,0:11:16.54,Default,,0,0,0,,Ах (Дүкенші) А?
Dialogue: 0,0:11:17.83,0:11:20.16,Default,,0,0,0,,Дүкен ұрлау! Мені ұста!
Dialogue: 0,0:11:21.16,0:11:22.41,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:11:22.50,0:11:24.12,Default,,0,0,0,,Қырағы топ! Жүгір!
Dialogue: 0,0:11:24.62,0:11:26.16,Default,,0,0,0,,Ұсталмаңыз!
Dialogue: 0,0:11:28.29,0:11:30.54,Default,,0,0,0,,Ахаха! Ләззат алыңыз!
Dialogue: 0,0:11:34.91,0:11:36.33,Default,,0,0,0,,Ұры!
Dialogue: 0,0:11:38.54,0:11:39.87,Default,,0,0,0,,Бұл ыңғайсыздық! Жолдан кет!
Dialogue: 0,0:11:41.04,0:11:41.95,Default,,0,0,0,,Ана
Dialogue: 0,0:11:50.29,0:11:51.04,Default,,0,0,0,,Сіз оны шашыңыз ба?
Dialogue: 0,0:11:51.12,0:11:52.91,Default,,0,0,0,,Мені ешкім қумайды Сәттілік!
Dialogue: 0,0:11:58.04,0:11:59.87,Default,,0,0,0,,Әй... Әй, ағайын.
Dialogue: 0,0:12:00.37,0:12:00.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:00.95,0:12:02.54,Default,,0,0,0,,Иә? Иә?
Dialogue: 0,0:12:02.62,0:12:04.08,Default,,0,0,0,,Нені ұрладың? Оны қайда қойдыңыз?
Dialogue: 0,0:12:04.16,0:12:07.83,Default,,0,0,0,,Мен қатты ұстадым, бірақ жоғалып кетті!
Dialogue: 0,0:12:07.91,0:12:08.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:10.45,0:12:11.45,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:12:12.75,0:12:13.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:17.50,0:12:19.37,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:22.41,0:12:24.08,Default,,0,0,0,,Ау, ау…
Dialogue: 0,0:12:33.79,0:12:34.91,Default,,0,0,0,,Ым... (Кіші) Әй?
Dialogue: 0,0:12:36.16,0:12:38.91,Default,,0,0,0,,Бұл! Сіз оны қайтардыңыз ба?
Dialogue: 0,0:12:39.00,0:12:42.16,Default,,0,0,0,,Иә, солай сияқты.
Dialogue: 0,0:12:46.91,0:12:47.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:53.16,0:12:55.75,Default,,0,0,0,,Бүгін тағы да далаға шығасыз ба?
Dialogue: 0,0:12:56.37,0:12:57.66,Default,,0,0,0,,Эй, сен (Кенто)?
Dialogue: 0,0:12:59.79,0:13:01.37,Default,,0,0,0,,Сіз осында ұйықтауды жоспарлап отырсыз ба?
Dialogue: 0,0:13:02.83,0:13:05.95,Default,,0,0,0,,Кешіріңіз! басқа жерге барыңыз
Dialogue: 0,0:13:06.04,0:13:08.75,Default,,0,0,0,,О... күте тұрыңыз! Мен сені қуып жібергім келмейді
Dialogue: 0,0:13:08.83,0:13:12.37,Default,,0,0,0,,Анна, кеттік, біз бос жерге баруымыз керек.
Dialogue: 0,0:13:12.45,0:13:14.91,Default,,0,0,0,,Ұйықтап жатқанда сізді ұрлап кетуі мүмкін.
Dialogue: 0,0:13:16.16,0:13:18.33,Default,,0,0,0,,Күте тұрсаңыз! Иги!
Dialogue: 0,0:13:18.41,0:13:19.41,Default,,0,0,0,,Игиги!
Dialogue: 0,0:13:46.50,0:13:47.79,Default,,0,0,0,,Мен саған Аннаны бермеймін!
Dialogue: 0,0:13:47.87,0:13:48.54,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:13:48.62,0:13:52.62,Default,,0,0,0,,Уайымдама, мен ол баланы ұстау үшін келген жоқпын.
Dialogue: 0,0:13:57.08,0:13:58.16,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:13:58.95,0:14:01.87,Default,,0,0,0,,Егер мен оны ұстағым келсе, мен оны басынан бастап істеймін.
Dialogue: 0,0:14:02.45,0:14:04.95,Default,,0,0,0,,Бұл адам жаман адам емес.
Dialogue: 0,0:14:05.04,0:14:05.79,Default,,0,0,0,,Ах~
Dialogue: 0,0:14:05.87,0:14:07.20,Default,,0,0,0,,Сәлем, әпке
Dialogue: 0,0:14:07.29,0:14:10.50,Default,,0,0,0,,Бұл бала біріктірілген робот па?
Dialogue: 0,0:14:11.37,0:14:13.08,Default,,0,0,0,,Мен оны ұстай аламын ба?
Dialogue: 0,0:14:13.16,0:14:15.12,Default,,0,0,0,,Ха, қиын! Игиги...
Dialogue: 0,0:14:15.20,0:14:18.00,Default,,0,0,0,,Темірдей керемет!
Dialogue: 0,0:14:19.45,0:14:22.16,Default,,0,0,0,,Ол бала - қалқан жын Игис.
Dialogue: 0,0:14:22.25,0:14:23.08,Default,,0,0,0,,Игиги!
Dialogue: 0,0:14:23.58,0:14:25.33,Default,,0,0,0,,Мен Каэде Ходжомын
Dialogue: 0,0:14:26.04,0:14:27.79,Default,,0,0,0,,Бұл Кенто Тачибана.
Dialogue: 0,0:14:27.87,0:14:29.12,Default,,0,0,0,,Бұл Анна
Dialogue: 0,0:14:29.20,0:14:29.87,Default,,0,0,0,,Сіз!
Dialogue: 0,0:14:31.62,0:14:33.87,Default,,0,0,0,,Жаға... Жоқ?
Dialogue: 0,0:14:37.25,0:14:41.37,Default,,0,0,0,,(Ерлердің қорылдауы)
Dialogue: 0,0:14:59.50,0:15:02.33,Default,,0,0,0,,Не! Ол бос!
Dialogue: 0,0:15:02.41,0:15:04.50,Default,,0,0,0,,Мен бүгін твиттер жазбадым.
Dialogue: 0,0:15:06.50,0:15:09.70,Default,,0,0,0,,Аға, қазір үйге қайтайық.
Dialogue: 0,0:15:09.79,0:15:11.41,Default,,0,0,0,,Ертең не істейсің?
Dialogue: 0,0:15:12.79,0:15:14.79,Default,,0,0,0,,Қала сыртына барғыңыз келе ме?
Dialogue: 0,0:15:15.29,0:15:17.58,Default,,0,0,0,,Орманда құлып тәрізді қиранды бар, солай ма?
Dialogue: 0,0:15:18.08,0:15:21.12,Default,,0,0,0,,Бұрын неше түрлі дүкендер болған деген қауесет бар ма?
Dialogue: 0,0:15:22.33,0:15:25.25,Default,,0,0,0,,Зерттелмеген бөлмелер қалуы мүмкін.
Dialogue: 0,0:15:25.33,0:15:27.33,Default,,0,0,0,,Ақша жасауға болатын нәрселерді іздеңіз.
Dialogue: 0,0:15:36.00,0:15:38.87,Default,,0,0,0,,Уау! Бұл керемет!
Dialogue: 0,0:15:44.04,0:15:46.70,Default,,0,0,0,,Үлпілдек! Мен мұнда ұйықтай аламын ба?
Dialogue: 0,0:15:46.79,0:15:49.62,Default,,0,0,0,,Әрине Игис еденде ұйықтауы керек.
Dialogue: 0,0:15:49.70,0:15:50.66,Default,,0,0,0,,Игги!
Dialogue: 0,0:15:51.83,0:15:52.66,Default,,0,0,0,,Igi
Dialogue: 0,0:15:52.75,0:15:55.37,Default,,0,0,0,,На на наа!
Dialogue: 0,0:15:55.45,0:15:57.20,Default,,0,0,0,,Ит жаға тақпаса да
Dialogue: 0,0:15:57.29,0:15:59.75,Default,,0,0,0,,Адамдардың айтқанын тыңдаймын.
Dialogue: 0,0:15:59.83,0:16:02.50,Default,,0,0,0,,Мен тіпті қаша алмаймын. Не болып жатыр?
Dialogue: 0,0:16:05.87,0:16:08.29,Default,,0,0,0,,Өте жылы!
Dialogue: 0,0:16:08.37,0:16:09.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:16.66,0:16:18.91,Default,,0,0,0,,О, менің...
Dialogue: 0,0:16:20.25,0:16:21.62,Default,,0,0,0,,Бұл жын пайдаланушыларға арналған
Dialogue: 0,0:16:21.70,0:16:24.70,Default,,0,0,0,,Ақпаратты және жұмысқа орналастыруды қамтамасыз ететін сайттар
Dialogue: 0,0:16:25.37,0:16:27.04,Default,,0,0,0,,Біраз уақыттан бері
Dialogue: 0,0:16:27.12,0:16:30.25,Default,,0,0,0,,Сақтау жынына қатысты сұрау жіберілді.
Dialogue: 0,0:16:31.16,0:16:32.45,Default,,0,0,0,,Тірі немесе өлі -
Dialogue: 0,0:16:33.12,0:16:36.25,Default,,0,0,0,,Оны басып алған адамға 100 миллион иен төленеді.
Dialogue: 0,0:16:36.33,0:16:38.08,Default,,0,0,0,,100 миллион иен...
Dialogue: 0,0:16:38.79,0:16:40.50,Default,,0,0,0,,Клиент – «бейбітшілік ұйымы»
Dialogue: 0,0:16:41.00,0:16:42.79,Default,,0,0,0,,Йерги (Кэде) Сіз бұл туралы естідіңіз бе?
Dialogue: 0,0:16:45.20,0:16:48.75,Default,,0,0,0,,Жоқ сияқты...
Dialogue: 0,0:16:49.33,0:16:52.33,Default,,0,0,0,,Жындарды зерттеумен айналысатын ірі компания
Dialogue: 0,0:16:52.41,0:16:57.08,Default,,0,0,0,,Каэде-сан бізге неге сонша мейірімді?
Dialogue: 0,0:16:58.16,0:17:01.91,Default,,0,0,0,,Менің бейбітшілік ұйымдарымен аздаған байланысым бар.
Dialogue: 0,0:17:02.79,0:17:06.75,Default,,0,0,0,,Сондықтан мен олар бұл баланы неге нысанаға алды деп ойладым.
Dialogue: 0,0:17:07.45,0:17:09.79,Default,,0,0,0,,Мен сол балаға қызығамын.
Dialogue: 0,0:17:10.62,0:17:11.83,Default,,0,0,0,,А...
Dialogue: 0,0:17:13.16,0:17:14.95,Default,,0,0,0,,(Кентоның есінеу)
Dialogue: 0,0:17:26.58,0:17:28.41,Default,,0,0,0,,Бейбітшілік ұйымы...
Dialogue: 0,0:17:29.66,0:17:32.04,Default,,0,0,0,,Қалайсың, ата?
Dialogue: 0,0:17:41.00,0:17:42.20,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:17:47.75,0:17:48.58,Default,,0,0,0,,Эй!
Dialogue: 0,0:17:53.33,0:17:55.04,Default,,0,0,0,,Керемет!
Dialogue: 0,0:17:56.75,0:17:58.04,Default,,0,0,0,,Сіз қорықпайсыз ба?
Dialogue: 0,0:17:58.12,0:17:58.83,Default,,0,0,0,,Иә
Dialogue: 0,0:18:08.75,0:18:10.66,Default,,0,0,0,,Деке! Уау~
Dialogue: 0,0:18:10.75,0:18:11.75,Default,,0,0,0,,Керемет
Dialogue: 0,0:18:27.20,0:18:28.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:29.83,0:18:32.25,Default,,0,0,0,,(Бірдеңе жылайды)
Dialogue: 0,0:18:37.83,0:18:39.20,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:18:39.29,0:18:41.12,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:43.20,0:18:45.79,Default,,0,0,0,,Жарайды, бұл кішкентай жын ғой.
Dialogue: 0,0:19:28.79,0:19:31.25,Default,,0,0,0,,Кирикиру Кирукиру…
Dialogue: 0,0:19:36.66,0:19:40.37,Default,,0,0,0,,Кирикиру Кирукиру…
Dialogue: 0,0:19:42.04,0:19:43.58,Default,,0,0,0,,Кяаа!
Dialogue: 0,0:19:47.66,0:19:49.66,Default,,0,0,0,,♪～
Dialogue: 0,0:22:12.00,0:22:14.00,Default,,0,0,0,,～♪
