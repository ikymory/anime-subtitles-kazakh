Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:23.70,0:00:25.25,Default,,0,0,0,,О, рахмет...
Dialogue: 0,0:00:25.33,0:00:27.08,Default,,0,0,0,,Біз әскерден алынған ақпаратты бұздық.
Dialogue: 0,0:00:27.16,0:00:29.29,Default,,0,0,0,,Кенто-кун әлі табылмаған сияқты.
Dialogue: 0,0:00:29.37,0:00:32.45,Default,,0,0,0,,Егер бізде жаңа ақпарат болса, біз сізбен дереу хабарласамыз.
Dialogue: 0,0:00:33.12,0:00:35.79,Default,,0,0,0,,Күте тұрыңыз, Кенто-кун, Ана.
Dialogue: 0,0:00:58.41,0:01:00.41,Default,,0,0,0,,♪～
Dialogue: 0,0:02:18.66,0:02:18.83,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:02:18.83,0:02:20.83,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:02:18.83,0:02:20.83,Default,,0,0,0,,～♪
Dialogue: 0,0:02:20.83,0:02:23.54,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:02:27.16,0:02:28.95,Default,,0,0,0,,(шу)
Dialogue: 0,0:02:31.95,0:02:32.58,Default,,0,0,0,,Құсу?
Dialogue: 0,0:02:32.66,0:02:35.75,Default,,0,0,0,,Бұл нысана емес. Бұл бақа тәрізді жын.
Dialogue: 0,0:02:35.83,0:02:37.29,Default,,0,0,0,,Жою (жын) құсу!
Dialogue: 0,0:02:37.79,0:02:38.45,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:02:44.66,0:02:45.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:46.04,0:02:46.95,Default,,0,0,0,,Сіз...
Dialogue: 0,0:03:04.33,0:03:07.00,Default,,0,0,0,,Қош келдіңіздер, екеуің де.
Dialogue: 0,0:03:07.87,0:03:10.08,Default,,0,0,0,,Не болды? Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:03:10.87,0:03:13.20,Default,,0,0,0,,Тамақ іздегенде
Dialogue: 0,0:03:13.29,0:03:15.70,Default,,0,0,0,,Армия дерлік тапты
Dialogue: 0,0:03:15.79,0:03:19.95,Default,,0,0,0,,Бірақ кездейсоқ бақа жын пайда болды...
Dialogue: 0,0:03:20.87,0:03:23.00,Default,,0,0,0,,Сондықтан мен табылмадым.
Dialogue: 0,0:03:23.79,0:03:26.25,Default,,0,0,0,,О, саған сәттілік.
Dialogue: 0,0:03:27.12,0:03:29.04,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:03:29.12,0:03:32.04,Default,,0,0,0,,Менің орныма бақа жын өлді.
Dialogue: 0,0:03:32.54,0:03:35.70,Default,,0,0,0,,Мен ештеңе істемесем де, бұл менің кінәм.
Dialogue: 0,0:03:35.79,0:03:37.33,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:03:37.83,0:03:41.12,Default,,0,0,0,,Жоқ, бұл Кентоның кінәсі емес.
Dialogue: 0,0:03:41.91,0:03:45.54,Default,,0,0,0,,Адамдар қателеседі.
Dialogue: 0,0:03:49.00,0:03:51.45,Default,,0,0,0,,Енді уайымдаудың қажеті жоқ
Dialogue: 0,0:03:52.37,0:03:56.83,Default,,0,0,0,,Біраз уақыттан кейін біз күш біріктіреміз
Dialogue: 0,0:03:56.91,0:03:59.87,Default,,0,0,0,,Мен жындарды өлтіруден сақтаймын.
Dialogue: 0,0:04:00.37,0:04:01.91,Default,,0,0,0,,Сіз! Ах!
Dialogue: 0,0:04:05.25,0:04:06.50,Default,,0,0,0,,Осыдан кейін
Dialogue: 0,0:04:06.58,0:04:10.04,Default,,0,0,0,,Бұл аймақ арнайы қорғаныс аймағы ретінде белгіленген.
Dialogue: 0,0:04:10.12,0:04:12.62,Default,,0,0,0,,Жол жүру рұқсатыңызды көрсетіңіз
Dialogue: 0,0:04:13.25,0:04:16.20,Default,,0,0,0,,Мен бейбітшілік ұйымының өтініші бойынша тергеуге келдім.
Dialogue: 0,0:04:16.29,0:04:17.29,Default,,0,0,0,,Ішінде
Dialogue: 0,0:04:17.37,0:04:18.70,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:18.79,0:04:22.33,Default,,0,0,0,,Жол жүру билеті жоқтарды ішке кіргізбейді.
Dialogue: 0,0:04:28.45,0:04:31.37,Default,,0,0,0,,Ол менің командамның бір бөлігі
Dialogue: 0,0:04:32.29,0:04:33.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:37.91,0:04:39.70,Default,,0,0,0,,Адамзатты құрту?
Dialogue: 0,0:04:39.79,0:04:41.66,Default,,0,0,0,,Неліктен Кенто мен Анна?
Dialogue: 0,0:04:43.33,0:04:45.37,Default,,0,0,0,,Белгісіз жын
Dialogue: 0,0:04:45.87,0:04:48.04,Default,,0,0,0,,Пандемониумның тырнақтарын көздеу
Dialogue: 0,0:04:48.83,0:04:52.08,Default,,0,0,0,,Аннаның құдіреті музейдегі шыңдалған шыны жасағандықтан
Dialogue: 0,0:04:52.16,0:04:54.08,Default,,0,0,0,,Оны жоюға болатынын білу
Dialogue: 0,0:04:55.12,0:04:56.41,Default,,0,0,0,,Жын
Dialogue: 0,0:04:56.50,0:04:59.66,Default,,0,0,0,,Кенто іздеген жын уақытты кері қайтара алады ма?
Dialogue: 0,0:05:00.54,0:05:02.83,Default,,0,0,0,,Бұл кезеңде жынның қабілеттері
Dialogue: 0,0:05:02.91,0:05:04.62,Default,,0,0,0,,Мен оның не екенін білмеймін, бірақ
Dialogue: 0,0:05:05.37,0:05:08.20,Default,,0,0,0,,Ұлдар қауіпті жағдайда қалады
Dialogue: 0,0:05:08.29,0:05:09.12,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:09.79,0:05:11.70,Default,,0,0,0,,Мен бастықты әкелдім!
Dialogue: 0,0:05:14.08,0:05:14.91,Default,,0,0,0,,Igi!
Dialogue: 0,0:05:16.20,0:05:16.83,Default,,0,0,0,,Igis!
Dialogue: 0,0:05:17.50,0:05:20.37,Default,,0,0,0,,Игги! Игги, Игги, Игги, Игги
Dialogue: 0,0:05:20.45,0:05:23.62,Default,,0,0,0,,Сіздің ынтымақтастығыңыз бізге де көмектеседі.
Dialogue: 0,0:05:24.33,0:05:25.58,Default,,0,0,0,,Әскерден бұрын жынды табыңыз.
Dialogue: 0,0:05:25.58,0:05:26.70,Default,,0,0,0,,Әскерден бұрын жынды табыңыз.
Dialogue: 0,0:05:25.58,0:05:26.70,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:05:26.70,0:05:26.79,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:05:26.79,0:05:29.70,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:05:26.79,0:05:29.70,Default,,0,0,0,,Төраға екеуін қорғауға бұйрық берді.
Dialogue: 0,0:05:29.70,0:05:30.33,Default,,0,0,0,,Төраға екеуін қорғауға бұйрық берді.
Dialogue: 0,0:05:34.16,0:05:36.04,Default,,0,0,0,,Мені осы аймаққа жібергеніңіз үшін.
Dialogue: 0,0:05:36.12,0:05:38.62,Default,,0,0,0,,Игисті әкелгеніңіз үшін рахмет.
Dialogue: 0,0:05:39.12,0:05:42.37,Default,,0,0,0,,Мен Кенто мен басқаларды іздеу үшін өз әдісімді қолданамын.
Dialogue: 0,0:05:43.29,0:05:45.70,Default,,0,0,0,,Не? Бұл айлакер!
Dialogue: 0,0:05:45.79,0:05:49.12,Default,,0,0,0,,Коконое мырза сізге жақсы қарау үшін барын салып жатса да.
Dialogue: 0,0:05:50.91,0:05:53.41,Default,,0,0,0,,Баланы тапсаңыз, маған хабарлаңыз.
Dialogue: 0,0:05:54.04,0:05:56.29,Default,,0,0,0,,Мен де сен сияқты уайымдап жүрмін.
Dialogue: 0,0:05:59.00,0:06:00.37,Default,,0,0,0,,Менің сұрағым бар
Dialogue: 0,0:06:01.00,0:06:04.58,Default,,0,0,0,,Бұл аяқталғаннан кейін Аннаның болашағы қандай болады?
Dialogue: 0,0:06:05.95,0:06:09.45,Default,,0,0,0,,Мұны тек төраға ғана біледі.
Dialogue: 0,0:06:12.62,0:06:15.29,Default,,0,0,0,,Бұл да жұмыс... дұрыс па?
Dialogue: 0,0:06:20.62,0:06:23.12,Default,,0,0,0,,Мен Хаката қаласындағы бақылау камерасын бұзып көрдім.
Dialogue: 0,0:06:23.20,0:06:25.58,Default,,0,0,0,,Мен Кентоға ұқсайтын адамды ұстадым!
Dialogue: 0,0:06:25.66,0:06:28.54,Default,,0,0,0,,Мен Хаката қаласының батыс бөлігіндемін. Иә.
Dialogue: 0,0:06:28.62,0:06:30.79,Default,,0,0,0,,Мен қазір сізге картаны жіберемін.
Dialogue: 0,0:06:35.37,0:06:38.66,Default,,0,0,0,,Маған ақпаратыңызды жіберіп, қалғанының бәрін жойыңыз.
Dialogue: 0,0:06:39.25,0:06:41.41,Default,,0,0,0,,Мен әскердің қозғалысын барынша бәсеңдеткім келеді.
Dialogue: 0,0:06:51.91,0:06:53.50,Default,,0,0,0,,(Каору ызылдаған)
Dialogue: 0,0:06:53.58,0:06:54.45,Default,,0,0,0,,Сіз?
Dialogue: 0,0:06:58.37,0:07:00.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:21.87,0:07:26.16,Default,,0,0,0,,Анам жасайтын шибазуке қосылған якисобаны сағындым.
Dialogue: 0,0:07:26.25,0:07:28.29,Default,,0,0,0,,Анна Анна!
Dialogue: 0,0:07:28.37,0:07:29.66,Default,,0,0,0,,Сәлем! (Каору) О.
Dialogue: 0,0:07:29.75,0:07:31.79,Default,,0,0,0,,Мама, мен ұмытып қалдым.
Dialogue: 0,0:07:31.87,0:07:35.08,Default,,0,0,0,,Кенто маринадталған көкөніс қосылған якисобаны ұнатады, солай ма?
Dialogue: 0,0:07:35.70,0:07:37.41,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:07:37.50,0:07:41.04,Default,,0,0,0,,А... жарайды! Сиыр еті де дәмді көрінеді
Dialogue: 0,0:07:41.12,0:07:42.25,Default,,0,0,0,,Сәлем? Ана
Dialogue: 0,0:07:47.29,0:07:50.16,Default,,0,0,0,,Саған Анна қатты ұнайды, солай ма?
Dialogue: 0,0:07:50.87,0:07:53.08,Default,,0,0,0,,Өйткені Анна тартымды
Dialogue: 0,0:07:53.16,0:07:54.83,Default,,0,0,0,,үшін біртүрлі
Dialogue: 0,0:07:54.91,0:07:57.45,Default,,0,0,0,,Анна қауіпті болуы мүмкін емес, солай ма?
Dialogue: 0,0:07:57.54,0:08:00.33,Default,,0,0,0,,Кейде ол үлкен күш көрсетеді.
Dialogue: 0,0:08:00.91,0:08:01.91,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:02.91,0:08:06.41,Default,,0,0,0,,Ананың күші ең жақсы
Dialogue: 0,0:08:06.50,0:08:08.45,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:08:08.54,0:08:10.58,Default,,0,0,0,,Ой! Жоқ... не!
Dialogue: 0,0:08:10.66,0:08:13.12,Default,,0,0,0,,Анашым, жақсысыз ба? Ах...
Dialogue: 0,0:08:13.20,0:08:15.29,Default,,0,0,0,,Ана, неге бұлай істедің?
Dialogue: 0,0:08:15.37,0:08:17.62,Default,,0,0,0,,А... сен... (Каору) Анам жарайды.
Dialogue: 0,0:08:17.70,0:08:19.45,Default,,0,0,0,,Сіз? (Каору) Аннаға ашуланба.
Dialogue: 0,0:08:19.54,0:08:21.45,Default,,0,0,0,,Иә, анашым
Dialogue: 0,0:08:21.54,0:08:22.20,Default,,0,0,0,,Сіз...
Dialogue: 0,0:08:22.29,0:08:24.25,Default,,0,0,0,,Ана болу деген нені білдіреді?
Dialogue: 0,0:08:24.33,0:08:25.29,Default,,0,0,0,,А?
Dialogue: 0,0:08:26.37,0:08:28.41,Default,,0,0,0,,Каэде-сан Игис!
Dialogue: 0,0:08:28.50,0:08:29.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:29.66,0:08:31.29,Default,,0,0,0,,Igigi! О, менің!
Dialogue: 0,0:08:31.37,0:08:33.79,Default,,0,0,0,,Біраз болды, Кенто-кун, Ана.
Dialogue: 0,0:08:35.12,0:08:38.62,Default,,0,0,0,,Әй, сен менің баламның досысың ба?
Dialogue: 0,0:08:45.79,0:08:50.20,Default,,0,0,0,,Кенто-кун, анаңды қайтарғаныңа қуаныштымын.
Dialogue: 0,0:08:51.29,0:08:52.91,Default,,0,0,0,,Сыртта біраз сөйлесейік пе?
Dialogue: 0,0:08:53.62,0:08:56.50,Default,,0,0,0,,Каору-сан, мен Кенто-кунды бір сәтке қарызға аламын.
Dialogue: 0,0:08:57.29,0:09:00.66,Default,,0,0,0,,Мама, күте тұрыңыз, мен жақында келемін.
Dialogue: 0,0:09:01.33,0:09:02.83,Default,,0,0,0,,Иги Ана!
Dialogue: 0,0:09:03.45,0:09:05.16,Default,,0,0,0,,Ана, осында да күте тұрыңыз.
Dialogue: 0,0:09:08.83,0:09:09.87,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:09:14.25,0:09:16.25,Default,,0,0,0,,Біздің уақытымыз жоқ
Dialogue: 0,0:09:16.33,0:09:19.00,Default,,0,0,0,,Мен мұнда мәңгі жасыра алмаймын.
Dialogue: 0,0:09:19.08,0:09:20.83,Default,,0,0,0,,Хакатадан кетейік, Кенто-кун.
Dialogue: 0,0:09:21.50,0:09:23.33,Default,,0,0,0,,Олай болса анаңа айтуың керек.
Dialogue: 0,0:09:26.16,0:09:27.50,Default,,0,0,0,,Тыңда, Кенто-кун.
Dialogue: 0,0:09:27.58,0:09:28.58,Default,,0,0,0,,Қауіпті жын
Dialogue: 0,0:09:28.66,0:09:31.25,Default,,0,0,0,,Олар адамзатты жоюды жоспарлап отыр.
Dialogue: 0,0:09:31.83,0:09:33.29,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:09:34.25,0:09:37.66,Default,,0,0,0,,Кенто-кун, бұл сенің анаң емес.
Dialogue: 0,0:09:38.45,0:09:40.62,Default,,0,0,0,,Бұл күн... (Кенто) Жетеді!
Dialogue: 0,0:09:40.70,0:09:43.54,Default,,0,0,0,,Мен де қазір жағдай басқаша екенін білемін...
Dialogue: 0,0:09:44.04,0:09:47.79,Default,,0,0,0,,Бірақ уақыт өте келе сіз нағыз анаға айналасыз.
Dialogue: 0,0:09:47.87,0:09:51.00,Default,,0,0,0,,Сонымен, сіз маған тағы біраз уақыт бере аласыз, солай ма?
Dialogue: 0,0:09:55.33,0:09:57.16,Default,,0,0,0,,Сізді алдап жатыр.
Dialogue: 0,0:09:58.62,0:10:02.62,Default,,0,0,0,,Мен жай ғана анаммен және Аннамен бірге болғым келеді.
Dialogue: 0,0:10:03.12,0:10:06.50,Default,,0,0,0,,Маған тағы біраз уақыт беріңізші.
Dialogue: 0,0:10:19.25,0:10:20.08,Default,,0,0,0,,Igi?
Dialogue: 0,0:10:24.37,0:10:25.70,Default,,0,0,0,,Igigi…
Dialogue: 0,0:10:27.41,0:10:29.70,Default,,0,0,0,,Igi? Иги
Dialogue: 0,0:10:31.37,0:10:32.45,Default,,0,0,0,,Игги
Dialogue: 0,0:10:33.20,0:10:34.75,Default,,0,0,0,,...
Dialogue: 0,0:10:36.04,0:10:37.66,Default,,0,0,0,,Igi? Игиги!
Dialogue: 0,0:10:38.33,0:10:40.16,Default,,0,0,0,,Игги! G...
Dialogue: 0,0:10:40.25,0:10:43.91,Default,,0,0,0,,Адамның бұйрығын орындайтын үй жануары болғың келсе
Dialogue: 0,0:10:44.00,0:10:45.70,Default,,0,0,0,,Оның ішіне кіріңіз.
Dialogue: 0,0:10:46.20,0:10:48.20,Default,,0,0,0,,Сіз өзіңіздің шынайы болмысыңызды көрсеттіңіз.
Dialogue: 0,0:10:55.16,0:10:56.91,Default,,0,0,0,,Ана, кешіріңіз.
Dialogue: 0,0:10:57.00,0:10:57.83,Default,,0,0,0,,Иә
Dialogue: 0,0:10:58.41,0:11:01.12,Default,,0,0,0,,Эй, Анна, менің саған өтінішім бар.
Dialogue: 0,0:11:01.20,0:11:02.33,Default,,0,0,0,,Не?
Dialogue: 0,0:11:02.41,0:11:05.04,Default,,0,0,0,,Егер Анна анасын қабылдаса
Dialogue: 0,0:11:05.12,0:11:07.16,Default,,0,0,0,,Мен өте қуаныштымын
Dialogue: 0,0:11:07.25,0:11:11.16,Default,,0,0,0,,Бәріміз қайтадан бір отбасы болып өмір сүрейік, солай ма?
Dialogue: 0,0:11:11.25,0:11:13.04,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:11:14.16,0:11:16.20,Default,,0,0,0,,Сіз? Ах!
Dialogue: 0,0:11:16.29,0:11:17.33,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:18.25,0:11:21.33,Default,,0,0,0,,Игисті қазір босат, қарғыс атқан жын!
Dialogue: 0,0:11:22.16,0:11:24.37,Default,,0,0,0,,Сіз жындар туралы алаңдайсыз ба?
Dialogue: 0,0:11:26.20,0:11:27.29,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:11:28.16,0:11:31.04,Default,,0,0,0,,Адамдар жындарды өз пайдасына пайдаланады!
Dialogue: 0,0:12:02.79,0:12:03.70,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:04.79,0:12:06.62,Default,,0,0,0,,Өзің кінәлісің
Dialogue: 0,0:12:07.25,0:12:09.66,Default,,0,0,0,,Себебі мен Кентоны өзіммен бірге алып кетейін деп едім.
Dialogue: 0,0:12:09.75,0:12:11.00,Default,,0,0,0,,Каэде-сан!
Dialogue: 0,0:12:15.08,0:12:16.25,Default,,0,0,0,,Кенто
Dialogue: 0,0:12:21.50,0:12:22.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:24.25,0:12:25.33,Default,,0,0,0,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,0:12:30.75,0:12:33.54,Default,,0,0,0,,Кел, Кенто-кунмен мәмілеге келейік
Dialogue: 0,0:12:34.62,0:12:36.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:36.62,0:12:40.87,Default,,0,0,0,,Амансың ба? Бұлай жалғаса берсе ол өледі
Dialogue: 0,0:12:43.00,0:12:45.62,Default,,0,0,0,,Қорқынышты Бұл қорқынышты!
Dialogue: 0,0:12:46.41,0:12:48.95,Default,,0,0,0,,Егер сіз мені тыңдасаңыз
Dialogue: 0,0:12:49.45,0:12:52.37,Default,,0,0,0,,Мен оған өз қабілеттеріммен көмектесе аламын.
Dialogue: 0,0:12:53.33,0:12:55.04,Default,,0,0,0,,Не істеу керек? Кенто-кун
Dialogue: 0,0:12:55.12,0:12:56.00,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:01.12,0:13:02.54,Default,,0,0,0,,Мазасыз адамдар!
Dialogue: 0,0:13:03.08,0:13:04.75,Default,,0,0,0,,Сен менің курткамды ұшырып, мені де ұшырып жібердің ғой!
Dialogue: 0,0:13:05.25,0:13:07.95,Default,,0,0,0,,Кенто-кун, өзіңе байланысты.
Dialogue: 0,0:13:11.83,0:13:12.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:18.12,0:13:20.58,Default,,0,0,0,,Igi…
Dialogue: 0,0:13:20.66,0:13:23.58,Default,,0,0,0,,...
Dialogue: 0,0:13:25.12,0:13:28.91,Default,,0,0,0,,...
Dialogue: 0,0:13:29.54,0:13:31.33,Default,,0,0,0,,Бұл өтірік, солай ма? Каэде-сан?
Dialogue: 0,0:13:32.00,0:13:34.66,Default,,0,0,0,,...
Dialogue: 0,0:13:36.62,0:13:37.54,Default,,0,0,0,,әлі тірі
Dialogue: 0,0:13:42.83,0:13:44.12,Default,,0,0,0,,Емделдің бе?
Dialogue: 0,0:13:44.75,0:13:46.12,Default,,0,0,0,,Мұнда не болды?
Dialogue: 0,0:13:50.54,0:13:51.75,Default,,0,0,0,,Жақсы
Dialogue: 0,0:13:54.62,0:13:55.45,Default,,0,0,0,,Сіз...
Dialogue: 0,0:14:01.37,0:14:05.12,Default,,0,0,0,,Уау...! тесік? тесік! тесік…
Dialogue: 0,0:14:07.66,0:14:08.83,Default,,0,0,0,,Гуаа...!
Dialogue: 0,0:14:08.91,0:14:11.87,Default,,0,0,0,,Бас! Менің басым ауырып тұр!
Dialogue: 0,0:14:12.91,0:14:15.87,Default,,0,0,0,,Бейбітшілік агенттіктері әзірлеген соңғы жағалар
Dialogue: 0,0:14:15.95,0:14:17.12,Default,,0,0,0,,Өзгертілген
Dialogue: 0,0:14:17.20,0:14:20.66,Default,,0,0,0,,Демония бөлшектері белгілі бір адамдар үшін қолжетімді болды.
Dialogue: 0,0:14:20.75,0:14:24.29,Default,,0,0,0,,Оны күштеп алып тастау немесе Аннаға сақтау
Dialogue: 0,0:14:24.37,0:14:25.91,Default,,0,0,0,,Оны тоқтатқан дұрыс.
Dialogue: 0,0:14:26.50,0:14:30.83,Default,,0,0,0,,Жаға бөлігі мойын нервтерімен органикалық байланысқан.
Dialogue: 0,0:14:31.83,0:14:33.45,Default,,0,0,0,,Бұл өте ауыр болуы керек.
Dialogue: 0,0:14:38.75,0:14:40.95,Default,,0,0,0,,Жеке куәлігіңізді көрсетіңіз
Dialogue: 0,0:14:43.20,0:14:45.58,Default,,0,0,0,,Иә? сіз қай бірлікке жатасыз
Dialogue: 0,0:14:45.66,0:14:47.91,Default,,0,0,0,,Мұның бұған еш қатысы болмауы керек.
Dialogue: 0,0:14:48.00,0:14:50.45,Default,,0,0,0,,Неліктен мұнда? Көлікте не бар?
Dialogue: 0,0:14:53.41,0:14:56.41,Default,,0,0,0,,Бұл! Ол іздеген бала емес пе?
Dialogue: 0,0:14:56.50,0:14:58.25,Default,,0,0,0,,Тезірек басшыға хабарлаңыз!
Dialogue: 0,0:15:11.37,0:15:12.62,Default,,0,0,0,,үшінна ескерту
Dialogue: 0,0:15:12.70,0:15:15.41,Default,,0,0,0,,Қауіпті жындармен шайқасқа дереу дайындал!
Dialogue: 0,0:15:16.04,0:15:19.33,Default,,0,0,0,,Бейбітшілік ұйымынан біреудің мұражайға кіріп кеткені туралы хабарлама келді.
Dialogue: 0,0:15:19.95,0:15:23.66,Default,,0,0,0,,Қайталау Мұражайға қауіпті жын кіріп жатыр!
Dialogue: 0,0:15:25.45,0:15:27.50,Default,,0,0,0,,Балалар, сонда күтіңдер!
Dialogue: 0,0:15:32.54,0:15:34.00,Default,,0,0,0,,Дұрыс, Макио-сан. Ммм…
Dialogue: 0,0:15:40.54,0:15:42.75,Default,,0,0,0,,Shoot! Түсіріңіз!
Dialogue: 0,0:15:48.41,0:15:52.50,Default,,0,0,0,,Мен сендерден қатты ауырдым.
Dialogue: 0,0:16:00.79,0:16:02.58,Default,,0,0,0,,Мынау кім?
Dialogue: 0,0:16:02.66,0:16:05.04,Default,,0,0,0,,Міне осылай! Тездетіп, осы жерден эвакуациялан!
Dialogue: 0,0:16:07.62,0:16:08.75,Default,,0,0,0,,Егер шайқаста жеңілсең—
Dialogue: 0,0:16:16.20,0:16:18.04,Default,,0,0,0,,Бұл өте таңқаларлық.
Dialogue: 0,0:16:33.41,0:16:35.12,Default,,0,0,0,,Ааа!
Dialogue: 0,0:16:38.87,0:16:39.70,Default,,0,0,0,,Сіз...
Dialogue: 0,0:16:40.66,0:16:42.29,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:16:42.37,0:16:43.87,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:16:43.95,0:16:47.25,Default,,0,0,0,,Енді кіреберісті тез жауып тастау керек.
Dialogue: 0,0:16:47.33,0:16:50.12,Default,,0,0,0,,Кенто одан да көп зардап шегеді.
Dialogue: 0,0:16:50.20,0:16:52.20,Default,,0,0,0,,(Кентоның мазасыз дауысы)
Dialogue: 0,0:16:54.08,0:16:55.95,Default,,0,0,0,,Ух... сен!
Dialogue: 0,0:16:59.50,0:17:01.95,Default,,0,0,0,,Ух... аааа! Ах... Ах!
Dialogue: 0,0:17:02.54,0:17:05.50,Default,,0,0,0,,Менің басым...! Ол бұзылатын сияқты!
Dialogue: 0,0:17:05.58,0:17:06.66,Default,,0,0,0,,Сіз...
Dialogue: 0,0:17:06.75,0:17:09.25,Default,,0,0,0,,Менің басымдағы жын бөлшектері
Dialogue: 0,0:17:09.33,0:17:11.00,Default,,0,0,0,,Шығу алдында
Dialogue: 0,0:17:11.87,0:17:15.04,Default,,0,0,0,,Жағадан шыққан энергия резонанс тудырады.
Dialogue: 0,0:17:15.12,0:17:17.04,Default,,0,0,0,,Мүмкін мен сені ояттым.
Dialogue: 0,0:17:17.83,0:17:19.83,Default,,0,0,0,,Қалыпты өсу қарқыны
Dialogue: 0,0:17:20.79,0:17:24.62,Default,,0,0,0,,Гуаа...! Ауырды... Ауырды!
Dialogue: 0,0:17:24.70,0:17:27.87,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:17:27.95,0:17:29.16,Default,,0,0,0,,Парри
Dialogue: 0,0:17:30.08,0:17:32.08,Default,,0,0,0,,Para para para… (Yagi) Қат!
Dialogue: 0,0:17:33.83,0:17:35.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:35.12,0:17:39.04,Default,,0,0,0,,Мен ішке кіріп, Кенто мен Аннаны қалай құтқарамын?
Dialogue: 0,0:17:39.83,0:17:41.70,Default,,0,0,0,,Андо, мен мұны саған қалдырамын.
Dialogue: 0,0:17:42.41,0:17:44.70,Default,,0,0,0,,Иә, есіктер!
Dialogue: 0,0:17:44.79,0:17:46.20,Default,,0,0,0,,Қалай!
Dialogue: 0,0:17:47.91,0:17:50.41,Default,,0,0,0,,Анна Бұны құрт.
Dialogue: 0,0:17:50.50,0:17:52.41,Default,,0,0,0,,Ана, жоқ.
Dialogue: 0,0:17:52.50,0:17:53.95,Default,,0,0,0,,Гуаа...!
Dialogue: 0,0:17:54.75,0:17:57.12,Default,,0,0,0,,Ахх... Ахах!
Dialogue: 0,0:17:59.87,0:18:03.75,Default,,0,0,0,,Қазіргі күйінде ол әйнекті жоя алмайтын сияқты.
Dialogue: 0,0:18:03.83,0:18:06.87,Default,,0,0,0,,Мен сені одан да күшті етуім керек.
Dialogue: 0,0:18:08.12,0:18:10.70,Default,,0,0,0,,Ааа...! Ах...
Dialogue: 0,0:18:11.25,0:18:13.45,Default,,0,0,0,,Ана... Ана Ана!
Dialogue: 0,0:18:20.08,0:18:21.08,Default,,0,0,0,,Сіз?
Dialogue: 0,0:18:23.50,0:18:26.91,Default,,0,0,0,,Ана, мәңгі бірге болайық.
Dialogue: 0,0:18:30.16,0:18:31.00,Default,,0,0,0,,Анна…
Dialogue: 0,0:18:33.12,0:18:34.12,Default,,0,0,0,,Сіз...
Dialogue: 0,0:18:36.25,0:18:42.20,Default,,0,0,0,,(Аннаның жүрек соғысы)
Dialogue: 0,0:18:42.29,0:18:44.58,Default,,0,0,0,,Ах на на на на на на!
Dialogue: 0,0:18:48.62,0:18:50.66,Default,,0,0,0,,Ва!
Dialogue: 0,0:18:51.70,0:18:53.25,Default,,0,0,0,,Ваа!
Dialogue: 0,0:18:54.04,0:18:55.70,Default,,0,0,0,,Va!
Dialogue: 0,0:18:55.79,0:19:00.37,Default,,0,0,0,,Ваа!
Dialogue: 0,0:19:03.16,0:19:05.20,Default,,0,0,0,,Чумимин?
Dialogue: 0,0:19:05.29,0:19:06.75,Default,,0,0,0,,Ва! (Өсімдік жын) Чуми...
Dialogue: 0,0:19:07.37,0:19:08.75,Default,,0,0,0,,Ваа!
Dialogue: 0,0:19:13.54,0:19:14.54,Default,,0,0,0,,Ва!
Dialogue: 0,0:19:16.25,0:19:17.20,Default,,0,0,0,,Ваа!
Dialogue: 0,0:19:18.37,0:19:21.25,Default,,0,0,0,,Чумин Чумин?
Dialogue: 0,0:19:32.33,0:19:34.04,Default,,0,0,0,,Сіз! Сіз...
Dialogue: 0,0:19:34.83,0:19:39.29,Default,,0,0,0,,Ана, сен әлі бірге өмір сүру мүмкіндігін армандайсың ба?
Dialogue: 0,0:19:39.95,0:19:42.91,Default,,0,0,0,,Адамдардың жындарға деген жағымсыз сезімі бар
Dialogue: 0,0:19:43.00,0:19:45.04,Default,,0,0,0,,Тіпті басу мүмкін болса да
Dialogue: 0,0:19:45.54,0:19:48.20,Default,,0,0,0,,Біз ешқашан бейбіт өмір сүрмейміз
Dialogue: 0,0:19:49.25,0:19:51.50,Default,,0,0,0,,Чумимин?
Dialogue: 0,0:19:51.58,0:19:54.04,Default,,0,0,0,,Мұны сіз де білуіңіз керек.
Dialogue: 0,0:19:54.66,0:19:56.37,Default,,0,0,0,,Бір-бірімізге көмектесуді жалғастырайық
Dialogue: 0,0:19:56.45,0:19:59.54,Default,,0,0,0,,Біз жындар солай істеуіміз керек.
Dialogue: 0,0:19:59.62,0:20:02.66,Default,,0,0,0,,Адамдардан мәңгілік езгіде
Dialogue: 0,0:20:02.75,0:20:06.41,Default,,0,0,0,,Бірігіп, өміріңізге ешкім қауіп төндірмесін⸺
Dialogue: 0,0:20:06.50,0:20:08.45,Default,,0,0,0,,Қауіпсіз баспана жасаңыз
Dialogue: 0,0:20:08.54,0:20:11.29,Default,,0,0,0,,Ол үшін біз адамзатты жоюымыз керек.
Dialogue: 0,0:20:12.12,0:20:16.54,Default,,0,0,0,,Сіздің күшіңіз бізге пайдалы болуы керек.
Dialogue: 0,0:20:20.66,0:20:21.58,Default,,0,0,0,,Не?
Dialogue: 0,0:20:24.20,0:20:25.12,Default,,0,0,0,,Не!
Dialogue: 0,0:20:26.20,0:20:27.50,Default,,0,0,0,,Парри
Dialogue: 0,0:20:27.58,0:20:28.79,Default,,0,0,0,,Хюпи
Dialogue: 0,0:20:30.16,0:20:33.70,Default,,0,0,0,,Ана, сен қай жолмен бара жатырсың?
Dialogue: 0,0:20:34.33,0:20:35.62,Default,,0,0,0,,Адам жағы?
Dialogue: 0,0:20:36.54,0:20:39.37,Default,,0,0,0,,Әлде жын жағы ма?
Dialogue: 0,0:20:52.25,0:20:53.79,Default,,0,0,0,,Чумими…
Dialogue: 0,0:20:56.00,0:20:57.00,Default,,0,0,0,,Чуми…
Dialogue: 0,0:20:58.00,0:21:00.54,Default,,0,0,0,,Сонымен... кешіріңіз
Dialogue: 0,0:21:01.29,0:21:05.16,Default,,0,0,0,,Мен бір отбасы бола аламыз деп ойладым.
Dialogue: 0,0:21:09.54,0:21:10.50,Default,,0,0,0,,Адамгершілік
Dialogue: 0,0:21:11.00,0:21:15.41,Default,,0,0,0,,Біздің жын-перілердің көптен бергі кек. Алыңыз!
Dialogue: 0,0:21:16.37,0:21:19.37,Default,,0,0,0,,Андо! Бізді бұл жерден тезірек кетіңіз!
Dialogue: 0,0:21:31.83,0:21:33.83,Default,,0,0,0,,♪～
Dialogue: 0,0:23:56.00,0:23:58.00,Default,,0,0,0,,～♪
Dialogue: 0,0:23:59.50,0:24:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
