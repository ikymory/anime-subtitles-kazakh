Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:23.95,0:00:25.75,Default,,0,0,0,,Бұл да жаман ба?
Dialogue: 0,0:00:29.79,0:00:33.00,Default,,0,0,0,,Ішімізге терең үңілейік. Жейтін бірдеңе болуы мүмкін.
Dialogue: 0,0:00:35.04,0:00:36.20,Default,,0,0,0,,(Құлаған нәрсенің дыбысы)
Dialogue: 0,0:00:41.41,0:00:42.41,Default,,0,0,0,,Уау
Dialogue: 0,0:00:46.33,0:00:47.58,Default,,0,0,0,,Мұнда қараңғы екен, иә?
Dialogue: 0,0:00:48.95,0:00:49.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:50.41,0:00:51.87,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:00:51.95,0:00:55.12,Default,,0,0,0,,Мен оның соншалықты сүйкімді және мейірімді екеніне сене алмаймын.
Dialogue: 0,0:00:55.66,0:00:58.04,Default,,0,0,0,,Бай болсам ғой
Dialogue: 0,0:00:58.12,0:01:01.83,Default,,0,0,0,,Мен өз кілттеріңді жасап, барлығына таратқым келеді.
Dialogue: 0,0:01:01.91,0:01:04.08,Default,,0,0,0,,Юби~
Dialogue: 0,0:01:04.16,0:01:04.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:12.70,0:01:14.70,Default,,0,0,0,,♪～
Dialogue: 0,0:02:32.95,0:02:37.83,Default,,0,0,0,,Менің жыным
Dialogue: 0,0:02:37.91,0:02:38.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:39.33,0:02:40.66,Default,,0,0,0,,Юби...
Dialogue: 0,0:02:42.33,0:02:43.20,Default,,0,0,0,,Сіз!
Dialogue: 0,0:02:45.75,0:02:47.50,Default,,0,0,0,,Қашайық! Не!
Dialogue: 0,0:02:47.58,0:02:51.37,Default,,0,0,0,,Саусақтардың таңғажайып саны! Сіз тырнақтарыңызды қалай қиып жатырсыз?
Dialogue: 0,0:02:52.25,0:02:53.29,Default,,0,0,0,,Юбий!
Dialogue: 0,0:02:55.00,0:02:57.16,Default,,0,0,0,,Анна, сен ол баланы өткізе аласың ба?
Dialogue: 0,0:02:57.25,0:02:58.08,Default,,0,0,0,,Не!
Dialogue: 0,0:03:07.00,0:03:08.25,Default,,0,0,0,,Ооо Юви!
Dialogue: 0,0:03:09.20,0:03:11.91,Default,,0,0,0,,Жабық! Анна өтінемін!
Dialogue: 0,0:03:13.83,0:03:15.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:15.54,0:03:16.83,Default,,0,0,0,,Би...
Dialogue: 0,0:03:20.70,0:03:21.79,Default,,0,0,0,,Цукиюби
Dialogue: 0,0:03:23.29,0:03:26.91,Default,,0,0,0,,Хаа
Dialogue: 0,0:03:31.33,0:03:37.70,Default,,0,0,0,,Канагава
Dialogue: 0,0:03:59.95,0:04:01.12,Default,,0,0,0,,Сіз!
Dialogue: 0,0:04:08.50,0:04:12.08,Default,,0,0,0,,Кешегі отты өшіргеніме қуаныштымын.
Dialogue: 0,0:04:14.20,0:04:16.00,Default,,0,0,0,,Жылы.
Dialogue: 0,0:04:16.75,0:04:19.75,Default,,0,0,0,,Сәлем! Эй...
Dialogue: 0,0:04:19.83,0:04:23.08,Default,,0,0,0,,Сен менің иісім сияқтысың
Dialogue: 0,0:04:23.70,0:04:26.58,Default,,0,0,0,,Бұл жерде анам болғандықтан ба?
Dialogue: 0,0:04:27.37,0:04:28.37,Default,,0,0,0,,Анааа
Dialogue: 0,0:04:43.41,0:04:45.95,Default,,0,0,0,,Хмм... Ана...
Dialogue: 0,0:04:47.50,0:04:50.00,Default,,0,0,0,,Мен сіздің фан-клубыңызды құрдым
Dialogue: 0,0:04:50.08,0:04:52.95,Default,,0,0,0,,Жоқ! Эй, эй!
Dialogue: 0,0:04:58.29,0:05:00.54,Default,,0,0,0,,Ой... а... а...
Dialogue: 0,0:05:01.50,0:05:02.33,Default,,0,0,0,,Уаааа
Dialogue: 0,0:05:02.41,0:05:05.79,Default,,0,0,0,,Сіз адасып қалдыңыз ба? Ата-анаң қайда? Бар емес пе?
Dialogue: 0,0:05:06.62,0:05:09.12,Default,,0,0,0,,Жын сөйледі ме?
Dialogue: 0,0:05:09.62,0:05:11.83,Default,,0,0,0,,Сабыр ет, бұл жаға.
Dialogue: 0,0:05:11.91,0:05:12.75,Default,,0,0,0,,Жаға?
Dialogue: 0,0:05:12.83,0:05:15.25,Default,,0,0,0,,Кірістірілген камера және динамик
Dialogue: 0,0:05:15.79,0:05:17.04,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:05:17.79,0:05:20.54,Default,,0,0,0,,Мен түтін көрдім, тергеуге келдім.
Dialogue: 0,0:05:21.12,0:05:24.12,Default,,0,0,0,,Бұл шар жын. Оның аты Барон.
Dialogue: 0,0:05:24.20,0:05:25.33,Default,,0,0,0,,Варун
Dialogue: 0,0:05:30.29,0:05:31.33,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:05:44.41,0:05:46.00,Default,,0,0,0,,Сонымен... бұл өте үлкен.
Dialogue: 0,0:05:50.87,0:05:52.70,Default,,0,0,0,,Сізді таң қалдырғаным үшін кешіріңіз.
Dialogue: 0,0:05:53.79,0:05:55.75,Default,,0,0,0,,Бұрынғы дауысты адам...
Dialogue: 0,0:05:56.41,0:05:59.04,Default,,0,0,0,,Мен Урағамын, жын пайдаланушымын.
Dialogue: 0,0:05:59.54,0:06:00.79,Default,,0,0,0,,Вару~
Dialogue: 0,0:06:03.62,0:06:05.70,Default,,0,0,0,,Бұл сіздің жыныңыз ба?
Dialogue: 0,0:06:05.79,0:06:08.12,Default,,0,0,0,,Әй, Ураға, не таптың?
Dialogue: 0,0:06:08.20,0:06:10.83,Default,,0,0,0,,Бұл бала. Ол далада лагерьде жүрген сияқты.
Dialogue: 0,0:06:12.00,0:06:15.25,Default,,0,0,0,,Балалар? Неліктен мұндай жерде?
Dialogue: 0,0:06:15.33,0:06:18.54,Default,,0,0,0,,Сіз адасып қалдыңыз ба? Эй! демон!
Dialogue: 0,0:06:19.12,0:06:21.75,Default,,0,0,0,,Монк, сен неге мұндай жерде жүрсің?
Dialogue: 0,0:06:22.29,0:06:25.16,Default,,0,0,0,,Мм... мен сапардамын...
Dialogue: 0,0:06:25.25,0:06:26.37,Default,,0,0,0,,Саяхаттау?
Dialogue: 0,0:06:27.00,0:06:30.12,Default,,0,0,0,,Тек балалар? Сен жындарға жем боласың.
Dialogue: 0,0:06:30.20,0:06:33.04,Default,,0,0,0,,А... Әй... Сенпай, сабыр ет.
Dialogue: 0,0:06:33.12,0:06:35.37,Default,,0,0,0,,Жүр! Оны мұндай жерде қалдырмаңыз!
Dialogue: 0,0:06:36.12,0:06:37.20,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:37.29,0:06:39.66,Default,,0,0,0,,Сіз қанша қашықтыққа баруды жоспарлап отырсыз?
Dialogue: 0,0:06:40.58,0:06:41.58,Default,,0,0,0,,Батыс
Dialogue: 0,0:06:42.33,0:06:43.50,Default,,0,0,0,,дұрыс
Dialogue: 0,0:06:44.00,0:06:46.29,Default,,0,0,0,,Бұл тіркеме де батысқа қарай бет алады.
Dialogue: 0,0:06:48.00,0:06:48.91,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:06:49.00,0:06:49.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:49.83,0:06:51.45,Default,,0,0,0,,Тезірек бортқа шығыңыз
Dialogue: 0,0:06:52.08,0:06:53.91,Default,,0,0,0,,Кешіріңіз, кенеттен...
Dialogue: 0,0:06:54.58,0:06:55.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:00.95,0:07:02.87,Default,,0,0,0,,Валюруу
Dialogue: 0,0:07:02.95,0:07:04.66,Default,,0,0,0,,Барон! Варун
Dialogue: 0,0:07:07.33,0:07:09.79,Default,,0,0,0,,Вару Вару
Dialogue: 0,0:07:10.75,0:07:11.62,Default,,0,0,0,,Руру…
Dialogue: 0,0:07:13.29,0:07:14.70,Default,,0,0,0,,Руруу...
Dialogue: 0,0:07:18.04,0:07:20.91,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:07:21.00,0:07:22.75,Default,,0,0,0,,А, жегің келе ме?
Dialogue: 0,0:07:26.91,0:07:29.50,Default,,0,0,0,,Дәмді! Бұл дәмді!
Dialogue: 0,0:07:30.58,0:07:32.58,Default,,0,0,0,,Менің атым Ино. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:07:33.20,0:07:35.41,Default,,0,0,0,,Такеда мырза айдап келеді.
Dialogue: 0,0:07:35.50,0:07:38.50,Default,,0,0,0,,Бұл көлікте не бар?
Dialogue: 0,0:07:39.00,0:07:40.83,Default,,0,0,0,,Азық-түлік және дәрі-дәрмек.
Dialogue: 0,0:07:41.41,0:07:43.20,Default,,0,0,0,,Біз көлік компаниясының қызметкерлеріміз.
Dialogue: 0,0:07:43.20,0:07:43.79,Default,,0,0,0,,Біз көлік компаниясының қызметкерлеріміз.
Dialogue: 0,0:07:43.20,0:07:43.79,Default,,0,0,0,,...
Dialogue: 0,0:07:43.79,0:07:45.00,Default,,0,0,0,,...
Dialogue: 0,0:07:45.00,0:07:45.41,Default,,0,0,0,,...
Dialogue: 0,0:07:45.00,0:07:45.41,Default,,0,0,0,,Күзет мұнарасындағы Урага мырза компания жалдаған жын пайдаланушы.
Dialogue: 0,0:07:45.41,0:07:49.04,Default,,0,0,0,,Күзет мұнарасындағы Урага мырза – компания жалдаған жын пайдаланушы.
Dialogue: 0,0:07:49.83,0:07:50.95,Default,,0,0,0,,Вару
Dialogue: 0,0:07:55.41,0:07:57.70,Default,,0,0,0,,Уау, бұл керемет!
Dialogue: 0,0:07:57.79,0:08:00.20,Default,,0,0,0,,Мұнда келіп, табиғат көрінісін көргің келе ме?
Dialogue: 0,0:08:00.70,0:08:01.75,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:08:01.83,0:08:03.12,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:08:03.20,0:08:04.00,Default,,0,0,0,,Вару Руу~!
Dialogue: 0,0:08:04.08,0:08:06.08,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:08:06.79,0:08:08.33,Default,,0,0,0,,Валюруруру
Dialogue: 0,0:08:27.45,0:08:28.41,Default,,0,0,0,,Вару!
Dialogue: 0,0:08:34.83,0:08:36.16,Default,,0,0,0,,Мұнда бір нәрсе бар.
Dialogue: 0,0:08:37.08,0:08:38.12,Default,,0,0,0,,Жын!
Dialogue: 0,0:08:42.75,0:08:43.75,Default,,0,0,0,,Барон, ат!
Dialogue: 0,0:08:43.83,0:08:44.62,Default,,0,0,0,,Вару!
Dialogue: 0,0:08:54.33,0:08:56.87,Default,,0,0,0,,Уайымдамаңыз, мен өмірлік маңызды бөліктерді алып тастадым.
Dialogue: 0,0:08:58.95,0:09:01.08,Default,,0,0,0,,А... жын!
Dialogue: 0,0:09:02.45,0:09:03.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:12.58,0:09:15.91,Default,,0,0,0,,А... Өте жақсы істеп жатырсың ғой, солай емес пе!
Dialogue: 0,0:09:16.00,0:09:19.70,Default,,0,0,0,,Хехе, менің дикторым да ақылды, сүйкімді емес пе?
Dialogue: 0,0:09:19.79,0:09:20.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:20.66,0:09:22.79,Default,,0,0,0,,Ах... қандай сүйкімді...
Dialogue: 0,0:09:24.08,0:09:25.20,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:09:38.79,0:09:40.83,Default,,0,0,0,,Вару~
Dialogue: 0,0:09:41.95,0:09:44.87,Default,,0,0,0,,(Кентоның күлкісі)
Dialogue: 0,0:10:02.33,0:10:04.58,Default,,0,0,0,,Кеме жүзуде
Dialogue: 0,0:10:04.66,0:10:06.45,Default,,0,0,0,,Бұл салмақсыз жын.
Dialogue: 0,0:10:06.54,0:10:09.12,Default,,0,0,0,,Олардың арқасында жер бедері өзгереді.
Dialogue: 0,0:10:09.20,0:10:12.83,Default,,0,0,0,,Жолдар да, темір жолдар да жыртылады.
Dialogue: 0,0:10:13.83,0:10:15.04,Default,,0,0,0,,Ендеше бұзып көрейік
Dialogue: 0,0:10:21.79,0:10:23.25,Default,,0,0,0,,Сіз? Не!
Dialogue: 0,0:10:23.95,0:10:25.54,Default,,0,0,0,,Нанана Ана!
Dialogue: 0,0:10:25.62,0:10:26.95,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:10:27.04,0:10:28.87,Default,,0,0,0,,(Кентоның күлкісі)
Dialogue: 0,0:10:28.95,0:10:31.29,Default,,0,0,0,,Ах! Эй.
Dialogue: 0,0:10:32.12,0:10:34.58,Default,,0,0,0,,Наа на на на наа!
Dialogue: 0,0:10:43.58,0:10:46.62,Default,,0,0,0,,Эй... сапарыңда қайда бара жатырсың?
Dialogue: 0,0:10:47.91,0:10:49.91,Default,,0,0,0,,Мен біреуге көмектескім келеді
Dialogue: 0,0:10:51.95,0:10:54.25,Default,,0,0,0,,Иә, дәл солай.
Dialogue: 0,0:10:55.00,0:10:56.83,Default,,0,0,0,,Менің де көмектескім келетін адамдар бар.
Dialogue: 0,0:10:58.66,0:10:59.91,Default,,0,0,0,,Менің кішкентай інім
Dialogue: 0,0:11:00.58,0:11:04.25,Default,,0,0,0,,Мен сізбен құрдаспын, бірақ менің конституциям әлсіз.
Dialogue: 0,0:11:05.25,0:11:08.25,Default,,0,0,0,,Ақшаны тез жинап, жын пайдаланушы болудан бас тартыңыз.
Dialogue: 0,0:11:08.83,0:11:12.87,Default,,0,0,0,,Бірге шағын дүкен ашамыз деп уәде бердік.
Dialogue: 0,0:11:25.58,0:11:27.08,Default,,0,0,0,,Вару
Dialogue: 0,0:11:30.08,0:11:33.12,Default,,0,0,0,,«Төрт аяқ, бүкіл дене көз»?
Dialogue: 0,0:11:34.16,0:11:35.79,Default,,0,0,0,,Анна Бұл дәмді ме?
Dialogue: 0,0:11:40.29,0:11:42.04,Default,,0,0,0,,Вару~
Dialogue: 0,0:11:47.91,0:11:50.08,Default,,0,0,0,,Жоқ! жақсы!
Dialogue: 0,0:11:51.08,0:11:53.33,Default,,0,0,0,,Тағы да бар, сондықтан мүмкіндігінше көп тамақтаныңыз!
Dialogue: 0,0:11:53.41,0:11:55.66,Default,,0,0,0,,Сәлем Ино! Мұз қайда?
Dialogue: 0,0:11:56.33,0:11:58.62,Default,,0,0,0,,Ах, кешіріңіз! Мен одан қалдым!
Dialogue: 0,0:11:58.70,0:12:00.50,Default,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:12:00.58,0:12:03.45,Default,,0,0,0,,Мен жұмыстан кейін тастарда виски ішемін.
Dialogue: 0,0:12:03.54,0:12:06.58,Default,,0,0,0,,Ең қызығы - оны құю.
Dialogue: 0,0:12:06.66,0:12:08.45,Default,,0,0,0,,Мен бұған сенбеймін...
Dialogue: 0,0:12:10.16,0:12:12.41,Default,,0,0,0,,Мұз? Анна сіз оны шығара аласыз ба?
Dialogue: 0,0:12:12.50,0:12:13.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:13.58,0:12:14.54,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:12:15.54,0:12:16.54,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:16.62,0:12:21.08,Default,,0,0,0,,Хаха! Суық! Бұл ең жақсы! Не болып жатыр?
Dialogue: 0,0:12:21.58,0:12:24.70,Default,,0,0,0,,Аннаның заттарды сақтау қабілеті бар.
Dialogue: 0,0:12:24.79,0:12:28.04,Default,,0,0,0,,Бұл үйдегі мұздатқыштан шыққан мұз.
Dialogue: 0,0:12:28.12,0:12:31.16,Default,,0,0,0,,Ка! иә!
Dialogue: 0,0:12:42.16,0:12:43.25,Default,,0,0,0,,Такеда мырза
Dialogue: 0,0:12:44.37,0:12:45.08,Default,,0,0,0,,Не?
Dialogue: 0,0:12:46.00,0:12:46.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:49.50,0:12:50.83,Default,,0,0,0,,Бұл не? Қайда жүрміз…
Dialogue: 0,0:12:52.95,0:12:53.87,Default,,0,0,0,,Ал...
Dialogue: 0,0:12:54.41,0:12:57.58,Default,,0,0,0,,Demon пайдаланушылар гильдиясы жоғары құнды сұрау алды.
Dialogue: 0,0:12:58.20,0:13:00.54,Default,,0,0,0,,Сақтаушы жынды ұстағанға
Dialogue: 0,0:13:00.62,0:13:02.12,Default,,0,0,0,,Егер сіз 100 миллион иен төлесеңіз
Dialogue: 0,0:13:02.62,0:13:04.41,Default,,0,0,0,,Өмір де, өлім де маңызды емес сияқты.
Dialogue: 0,0:13:05.66,0:13:08.95,Default,,0,0,0,,Сақтау демоны? Ол жігіт...
Dialogue: 0,0:13:09.45,0:13:11.08,Default,,0,0,0,,Сіз оны күшпен алып кеткіңіз келе ме?
Dialogue: 0,0:13:12.00,0:13:14.20,Default,,0,0,0,,Менің арманым бар
Dialogue: 0,0:13:14.83,0:13:17.50,Default,,0,0,0,,Ақшаны үнемдеңіз және жын пайдаланушы болудан бас тартыңыз.
Dialogue: 0,0:13:18.20,0:13:20.66,Default,,0,0,0,,Мен бір қалада дүкен ашқым келеді.
Dialogue: 0,0:13:21.16,0:13:22.70,Default,,0,0,0,,Бұл кішігірім жалпы дүкен.
Dialogue: 0,0:13:23.66,0:13:26.75,Default,,0,0,0,,Хмм... монах оны жақсы көреді.
Dialogue: 0,0:13:26.83,0:13:28.70,Default,,0,0,0,,Сізді ажырату - қатыгездік.
Dialogue: 0,0:13:28.79,0:13:33.62,Default,,0,0,0,,Бірақ бұл 100 миллион иен, солай ма? Әрине, егер басқа жол болса ...
Dialogue: 0,0:13:33.70,0:13:37.41,Default,,0,0,0,,Өйткені сіз жындармен байланыста болғансыз.
Dialogue: 0,0:13:38.00,0:13:41.08,Default,,0,0,0,,Сіздің басыңыз ластанған жоқ па?
Dialogue: 0,0:13:41.95,0:13:45.25,Default,,0,0,0,,Осы көп ақшаға мен інімді емдей аламын!
Dialogue: 0,0:13:45.91,0:13:49.70,Default,,0,0,0,,Олай істесең ағаң қуанады деп ойлайсың ба?
Dialogue: 0,0:13:50.54,0:13:52.08,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:13:55.87,0:13:58.95,Default,,0,0,0,,Мен Такеда мырза түсінеді деп ойладым.
Dialogue: 0,0:14:01.04,0:14:03.16,Default,,0,0,0,,Демек, біздің таңдауымыз жоқ.
Dialogue: 0,0:14:03.87,0:14:04.83,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:05.41,0:14:06.50,Default,,0,0,0,,Барон, істе!
Dialogue: 0,0:14:07.00,0:14:08.20,Default,,0,0,0,,Вару!
Dialogue: 0,0:14:08.83,0:14:09.95,Default,,0,0,0,,Аһ!
Dialogue: 0,0:14:10.04,0:14:11.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:12.66,0:14:14.66,Default,,0,0,0,,Уф! Ахх...
Dialogue: 0,0:14:23.41,0:14:25.12,Default,,0,0,0,,Иә? Такеда ше?
Dialogue: 0,0:14:25.20,0:14:28.50,Default,,0,0,0,,Бұл біртүрлі. Мен ертерек оралуым керек еді.
Dialogue: 0,0:14:29.75,0:14:32.75,Default,,0,0,0,,Адасып қалдым, мас болып қалдым...
Dialogue: 0,0:14:37.54,0:14:38.16,Default,,0,0,0,,Жаса!
Dialogue: 0,0:14:38.25,0:14:39.04,Default,,0,0,0,,Вару!
Dialogue: 0,0:14:39.12,0:14:39.70,Default,,0,0,0,,Уау
Dialogue: 0,0:14:41.00,0:14:42.00,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:43.12,0:14:44.12,Default,,0,0,0,,Ана!
Dialogue: 0,0:14:53.75,0:14:55.87,Default,,0,0,0,,Урага-сан! Сен не істеп жатырсың?
Dialogue: 0,0:14:58.75,0:15:00.08,Default,,0,0,0,,Вару!
Dialogue: 0,0:15:11.04,0:15:11.95,Default,,0,0,0,,Барон!
Dialogue: 0,0:15:12.04,0:15:13.08,Default,,0,0,0,,Вару!
Dialogue: 0,0:15:13.16,0:15:15.29,Default,,0,0,0,,Осыншама қиналғаның үшін рахмет. Рахмет.
Dialogue: 0,0:15:43.16,0:15:44.29,Default,,0,0,0,,Val...
Dialogue: 0,0:15:50.87,0:15:52.12,Default,,0,0,0,,Руруу...
Dialogue: 0,0:15:53.04,0:15:53.91,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:15:54.00,0:15:55.20,Default,,0,0,0,,Вару!
Dialogue: 0,0:15:58.33,0:15:59.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:59.87,0:16:03.75,Default,,0,0,0,,Анна Тек сынап көру үшін, сіз мұны сақтай аласыз ба?
Dialogue: 0,0:16:03.83,0:16:04.66,Default,,0,0,0,,Сіз!
Dialogue: 0,0:16:05.29,0:16:07.79,Default,,0,0,0,,Орындалды! Басқалар өтінемін!
Dialogue: 0,0:16:10.58,0:16:11.75,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:16:12.33,0:16:13.04,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:16:13.12,0:16:14.25,Default,,0,0,0,,Мән
Dialogue: 0,0:16:14.33,0:16:17.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:32.75,0:16:34.33,Default,,0,0,0,,Вару!
Dialogue: 0,0:16:37.83,0:16:38.83,Default,,0,0,0,,Мән
Dialogue: 0,0:16:38.91,0:16:39.58,Default,,0,0,0,,Уау
Dialogue: 0,0:16:39.66,0:16:41.00,Default,,0,0,0,,Вару!
Dialogue: 0,0:16:42.00,0:16:43.20,Default,,0,0,0,,Val...
Dialogue: 0,0:16:53.45,0:16:55.29,Default,,0,0,0,,Ұш! Ах!
Dialogue: 0,0:17:13.04,0:17:15.50,Default,,0,0,0,,Варуу Вару…
Dialogue: 0,0:17:15.58,0:17:18.58,Default,,0,0,0,,Менің қашып кетуіме сен кінәлісің!
Dialogue: 0,0:17:19.08,0:17:19.87,Default,,0,0,0,,Барон!
Dialogue: 0,0:17:19.95,0:17:20.70,Default,,0,0,0,,Мән
Dialogue: 0,0:17:20.79,0:17:22.87,Default,,0,0,0,,Варуу...!
Dialogue: 0,0:17:29.75,0:17:31.20,Default,,0,0,0,,Келесі жолы жақсырақ әрекет етіңіз
Dialogue: 0,0:17:32.00,0:17:34.00,Default,,0,0,0,,Айналма жолмен жүріп, басқа көпірді табыңыз
Dialogue: 0,0:17:37.91,0:17:39.29,Default,,0,0,0,,...
Dialogue: 0,0:17:47.54,0:17:49.20,Default,,0,0,0,,Бүгін күн суық.
Dialogue: 0,0:17:49.95,0:17:50.62,Default,,0,0,0,,А...
Dialogue: 0,0:17:50.70,0:17:54.33,Default,,0,0,0,,Мен отқа қыздырғым келеді, бірақ мен шыдамды болуым керек.
Dialogue: 0,0:17:54.41,0:17:57.50,Default,,0,0,0,,Егер сіз отты қолдансаңыз, олар сізді бірден табады.
Dialogue: 0,0:17:58.45,0:18:01.41,Default,,0,0,0,,А... жағасы сынып қалды.
Dialogue: 0,0:18:02.08,0:18:05.41,Default,,0,0,0,,Бұл бізге керек емес.
Dialogue: 0,0:18:05.50,0:18:06.50,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:18:10.08,0:18:11.08,Default,,0,0,0,,Мүмкін мен де байқап көрермін.
Dialogue: 0,0:18:13.95,0:18:15.45,Default,,0,0,0,,Мән...
Dialogue: 0,0:18:24.62,0:18:25.45,Default,,0,0,0,,Ru…
Dialogue: 0,0:18:52.70,0:18:55.54,Default,,0,0,0,,Неліктен бәрі Аннаны нысанаға алады?
Dialogue: 0,0:18:57.25,0:18:59.29,Default,,0,0,0,,Иә. Бұл мен Окаға… яғни, Кёма-санға берген уәдем.
Dialogue: 0,0:18:59.37,0:19:00.20,Default,,0,0,0,,Сіз?
Dialogue: 0,0:19:00.29,0:19:03.58,Default,,0,0,0,,Сенің сүйкімді екеніңді бәрі байқады.
Dialogue: 0,0:19:03.66,0:19:05.37,Default,,0,0,0,,Сондықтан мен мұны қалаймын
Dialogue: 0,0:19:05.45,0:19:08.58,Default,,0,0,0,,Менің ойыма басқа себеп жоқ.
Dialogue: 0,0:19:10.91,0:19:11.91,Default,,0,0,0,,Төмен қаратыңыз
Dialogue: 0,0:19:16.70,0:19:19.04,Default,,0,0,0,,Сенгокухара Сусуки шабындығы
Dialogue: 0,0:19:20.12,0:19:21.87,Default,,0,0,0,,Барон, таңғы ас.
Dialogue: 0,0:19:21.95,0:19:23.08,Default,,0,0,0,,Вару!
Dialogue: 0,0:19:29.83,0:19:30.87,Default,,0,0,0,,Руру
Dialogue: 0,0:19:36.20,0:19:37.54,Default,,0,0,0,,Var~
Dialogue: 0,0:19:38.33,0:19:41.37,Default,,0,0,0,,Сен жолға түстің, жолдан кет! Мен ештеңе көре алмаймын
Dialogue: 0,0:19:41.45,0:19:42.91,Default,,0,0,0,,Рууу... Рууру
Dialogue: 0,0:19:43.54,0:19:46.62,Default,,0,0,0,,Көзге түспе, білесің.
Dialogue: 0,0:19:47.41,0:19:48.91,Default,,0,0,0,,Біз адамдар
Dialogue: 0,0:19:49.00,0:19:52.16,Default,,0,0,0,,Жын көрсем жүрегім айнып кетеді.
Dialogue: 0,0:19:52.70,0:19:54.62,Default,,0,0,0,,Рууу...
Dialogue: 0,0:19:55.62,0:19:58.29,Default,,0,0,0,,Сізді алдын ала алады. Айналмалы жолмен жүрейік.
Dialogue: 0,0:20:06.20,0:20:07.75,Default,,0,0,0,,Міне болды! Бұл орман!
Dialogue: 0,0:20:09.37,0:20:10.20,Default,,0,0,0,,Вару
Dialogue: 0,0:20:10.29,0:20:11.29,Default,,0,0,0,,Бұл тұзақ!
Dialogue: 0,0:20:13.54,0:20:14.58,Default,,0,0,0,,Вару
Dialogue: 0,0:20:25.50,0:20:26.79,Default,,0,0,0,,Вару
Dialogue: 0,0:20:30.16,0:20:32.62,Default,,0,0,0,,Варуру Варуру
Dialogue: 0,0:20:33.95,0:20:34.95,Default,,0,0,0,,Вару
Dialogue: 0,0:20:36.50,0:20:37.95,Default,,0,0,0,,Вару!
Dialogue: 0,0:20:40.00,0:20:41.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:57.62,0:20:58.70,Default,,0,0,0,,Вару!
Dialogue: 0,0:21:01.70,0:21:02.95,Default,,0,0,0,,Варуу!
Dialogue: 0,0:21:03.04,0:21:03.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:05.62,0:21:06.75,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:21:08.50,0:21:09.66,Default,,0,0,0,,Бұл қауіпті, келе жатыр!
Dialogue: 0,0:21:23.12,0:21:24.75,Default,,0,0,0,,Вару!
Dialogue: 0,0:21:27.79,0:21:29.79,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:21:35.70,0:21:36.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:42.50,0:21:43.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:48.70,0:21:53.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:58.00,0:22:00.00,Default,,0,0,0,,♪～
Dialogue: 0,0:24:22.58,0:24:24.58,Default,,0,0,0,,～♪
