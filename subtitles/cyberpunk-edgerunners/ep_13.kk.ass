Dialogue: 0,0:00:12.46,0:00:15.58,OP-CH_EP02,,0,0,0,,Қатты көрініс
Dialogue: 0,0:00:18.84,0:00:21.53,OP-CH_EP02,,0,0,0,,Тәтті жер шірік
Dialogue: 0,0:00:25.58,0:00:28.29,OP-CH_EP02,,0,0,0,,Гаму Кирецуэн
Dialogue: 0,0:01:02.73,0:01:05.11,OP-CH_EP02,,0,0,0,,Жалынды сөндіруден босату жүйесі
Dialogue: 0,0:16:59.67,0:17:01.82,IN-EN,,0,0,0,,Гял ашуланып, жеңілірек итеріп жіберді
Dialogue: 0,0:17:01.82,0:17:03.99,IN-EN,,0,0,0,,Өгіз шабандоздай қуып жет
Dialogue: 0,0:17:03.99,0:17:05.82,IN-EN,,0,0,0,,Me a di baddest deejay tonight-a
Dialogue: 0,0:17:05.82,0:17:07.50,IN-EN,,0,0,0,,Caa mi a di тек біреуі
Dialogue: 0,0:17:07.50,0:17:10.00,IN-EN,,0,0,0,,Кім отты жағады және оны жақсы көреді
Dialogue: 0,0:17:10.00,0:17:12.00,IN-EN,,0,0,0,,Sweet gyal af booty so dem bobble it
Dialogue: 0,0:17:12.00,0:17:14.49,IN-EN,,0,0,0,,Маған сех gyal on fleek және сіз fitta dem fit
Dialogue: 0,0:17:14.49,0:17:16.63,IN-EN,,0,0,0,,Көздеріңе қарасам, соның бәрін көремін
Dialogue: 0,0:17:16.63,0:17:18.55,IN-EN,,0,0,0,,Ижі шарабы, шай шарабы
Dialogue: 0,0:17:19.10,0:17:21.05,IN-EN,,0,0,0,,Кел, денең мен шарапыңды жоғары көтер
Dialogue: 0,0:17:21.05,0:17:23.07,IN-EN,,0,0,0,,Ижі шарабы, шай шарабы
Dialogue: 0,0:17:23.34,0:17:25.11,IN-EN,,0,0,0,,Кел, денең мен шарапты жоғары жылжыт
Dialogue: 0,0:17:25.11,0:17:27.17,IN-EN,,0,0,0,,Ижі шарабы, жус шарабы
Dialogue: 0,0:17:27.17,0:17:29.41,IN-EN,,0,0,0,,Кел, денең мен шарапты жоғары көтер
Dialogue: 0,0:17:29.41,0:17:31.18,IN-EN,,0,0,0,,Ижі шарабы, жусан шарабы
Dialogue: 0,0:17:31.18,0:17:34.02,IN-EN,,0,0,0,,Кел, денең мен шарапты жоғары жылжыт
Dialogue: 0,0:17:52.04,0:17:54.04,IN-EN,,0,0,0,,Аяғыңызды ұшып, шарап ішіңіз – yo!
Dialogue: 0,0:17:54.04,0:17:56.45,IN-EN,,0,0,0,,Пон ди Майк мені мүйізтұмсық сияқты ашуландырады
Dialogue: 0,0:17:56.45,0:17:58.20,IN-EN,,0,0,0,,Егер сізге мені жақсы көру керек болса, сізге барыңыз
Dialogue: 0,0:17:58.20,0:17:59.95,IN-EN,,0,0,0,,Caa mi a di тек біреуі
Dialogue: 0,0:18:00.92,0:18:02.12,IN-EN,,0,0,0,,Кім отты жағады және оны жақсы көреді
Dialogue: 0,0:18:02.12,0:18:04.37,IN-EN,,0,0,0,,Sweet gyal af booty so dem bobble it
Dialogue: 0,0:18:04.37,0:18:05.85,IN-EN,,0,0,0,,Маған сех gyal on fleek және сіз fitta dem fit
Dialogue: 0,0:18:06.85,0:18:09.11,IN-EN,,0,0,0,,Мен сенің көзіңе қарасам, соның бәрін көремін
Dialogue: 0,0:18:09.11,0:18:11.24,IN-EN,,0,0,0,,Ижі шарабы, шай шарабы
Dialogue: 0,0:18:11.24,0:18:13.24,IN-EN,,0,0,0,,Кел, денең мен шарапты жоғары жылжыт
Dialogue: 0,0:18:13.38,0:18:15.55,IN-EN,,0,0,0,,Ижі шарабы, жусан шарабы
Dialogue: 0,0:18:15.75,0:18:17.43,IN-EN,,0,0,0,,Кел, денең мен шарапты жоғары көтер
Dialogue: 0,0:18:17.67,0:18:19.59,IN-EN,,0,0,0,,Ижі шарабы, жусан шарабы
Dialogue: 0,0:18:19.67,0:18:22.07,IN-EN,,0,0,0,,Кел, денең мен шарапты жоғары жылжыт
Dialogue: 0,0:18:22.07,0:18:24.07,IN-EN,,0,0,0,,Жусс шарабы, жус шарабы
Dialogue: 0,0:18:24.32,0:18:26.08,IN-EN,,0,0,0,,Кел, денең мен шарапты жоғары көтер
Dialogue: 0,0:20:08.46,0:20:10.72,IN-EN,,0,0,0,,Znika dla mnie wczorajszy dzień
Dialogue: 0,0:20:11.02,0:20:13.02,IN-EN,,0,0,0,,120 chwil co są jak sen
Dialogue: 0,0:20:13.02,0:20:15.56,IN-EN,,0,0,0,,Wszystko inne jest nieważne
Dialogue: 0,0:20:15.56,0:20:18.19,IN-EN,,0,0,0,,Tak nieważne gdy jesteś blisko mnie
Dialogue: 0,0:20:18.42,0:20:20.70,IN-EN,,0,0,0,,Nie obchodzi mnie żaden inny głos
Dialogue: 0,0:20:21.03,0:20:23.19,IN-EN,,0,0,0,,Kiedy twoje ciepło daje mi moc
Dialogue: 0,0:20:23.19,0:20:25.63,IN-EN,,0,0,0,,Złap moją dłoń - chodźmy stąd
Dialogue: 0,0:20:28.30,0:20:30.20,IN-EN,,0,0,0,,Rozbiłaś moją głowę w pył
Dialogue: 0,0:20:31.18,0:20:32.71,IN-EN,,0,0,0,,Jakby ktoś sypnął w oczy piach
Dialogue: 0,0:20:33.38,0:20:35.86,IN-EN,,0,0,0,,Myślałem znam siebie tak dobrze
Dialogue: 0,0:20:35.98,0:20:37.35,IN-EN,,0,0,0,,Teraz wiem - nie rozumiem sam
Dialogue: 0,0:20:38.35,0:20:40.21,IN-EN,,0,0,0,,Patrzę na Ciebie
Dialogue: 0,0:20:40.62,0:20:42.57,IN-EN,,0,0,0,,Słońce oświetla twarz
Dialogue: 0,0:20:42.92,0:20:46.22,IN-EN,,0,0,0,,Ja słyszę wciąż rozsądku głos, rozsądku ton
Dialogue: 0,0:20:46.38,0:20:48.22,IN-EN,,0,0,0,,To takie ważne, kiedy tu jesteś
Dialogue: 0,0:20:48.38,0:20:52.22,IN-EN,,0,0,0,,Ty jesteś obok mnie
Dialogue: 0,0:20:52.22,0:20:54.22,IN-EN,,0,0,0,,Обок мние, обок мние
Dialogue: 0,0:20:54.22,0:20:56.23,IN-EN,,0,0,0,,(Ogień rozpala twojej dłoni dotyk)
Dialogue: 0,0:20:56.48,0:20:58.72,IN-EN,,0,0,0,,Znika dla mnie wczorajszy dzień
Dialogue: 0,0:20:59.07,0:21:01.06,IN-EN,,0,0,0,,120 chwil co są jak sen
Dialogue: 0,0:21:01.06,0:21:03.14,IN-EN,,0,0,0,,Wszystko inne jest nieważne
Dialogue: 0,0:21:03.57,0:21:06.24,IN-EN,,0,0,0,,Tak nieważne gdy jesteś blisko mnie
Dialogue: 0,0:21:06.35,0:21:08.83,IN-EN,,0,0,0,,Nie obchodzi mnie żaden inny głos
Dialogue: 0,0:21:08.83,0:21:10.99,IN-EN,,0,0,0,,Kiedy twoje ciepło daje mi moc
Dialogue: 0,0:21:11.12,0:21:13.92,IN-EN,,0,0,0,,Złap moją dłoń - chodźmy stąd
Dialogue: 0,0:21:16.25,0:21:18.25,IN-EN,,0,0,0,,Widzę niebo odbija się
Dialogue: 0,0:21:18.60,0:21:21.12,IN-EN,,0,0,0,,W twoich oczach teraz wiesz
Dialogue: 0,0:21:21.12,0:21:23.55,IN-EN,,0,0,0,,Możesz poczuć mnie, być blisko mnie
Dialogue: 0,0:21:23.55,0:21:25.54,IN-EN,,0,0,0,,Poczuć mnie - możesz
Dialogue: 0,0:21:25.54,0:21:28.07,IN-EN,,0,0,0,,Chcę spróbować ale wiesz
Dialogue: 0,0:21:28.07,0:21:30.26,IN-EN,,0,0,0,,Zanim skończy się ten dzień
Dialogue: 0,0:21:30.80,0:21:33.52,IN-EN,,0,0,0,,Pozwól płynąć temu, tak płynąć temu
Dialogue: 0,0:21:33.52,0:21:34.67,IN-EN,,0,0,0,,Pozwól płynąć temu tak
Dialogue: 0,0:21:34.67,0:21:37.80,IN-EN,,0,0,0,,I kiedy obejmujesz mnie
Dialogue: 0,0:21:37.80,0:21:39.90,IN-EN,,0,0,0,,Spojrzeniem które wie
Dialogue: 0,0:21:40.81,0:21:43.22,IN-EN,,0,0,0,,Otwiera przestrzeń w której teraz
Dialogue: 0,0:21:43.22,0:21:46.28,IN-EN,,0,0,0,,Nie istnieje czas
