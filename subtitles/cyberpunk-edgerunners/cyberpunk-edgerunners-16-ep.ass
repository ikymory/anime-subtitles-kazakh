Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:23:55.99,0:23:57.53,Staff,,0,0,0,,： ：Dysonsphere ：astrayveller ：MIR
Dialogue: 1,0:01:34.69,0:01:36.91,Dial-JP2,,0,0,0,,Сәлем түнгі қала
Dialogue: 1,0:01:36.91,0:01:40.40,Dial-JP2,,0,0,0,,Бүгін армандар қаласында жаңа күн басталады.
Dialogue: 1,0:01:41.48,0:01:43.25,Dial-JP2,,0,0,0,,Бүгін тағы да жұмысқа кешігіп қалдым.
Dialogue: 1,0:01:43.64,0:01:47.43,Dial-JP2,,0,0,0,,Вейланд Боа Боа сияқты аңыздарға тамсанатын ақымақтар бар.
Dialogue: 1,0:01:47.43,0:01:50.02,Dial-JP2,,0,0,0,,Өйткені олар тас жолда кезекке тұруды ұнатпайды.
Dialogue: 1,0:01:51.02,0:01:55.93,Dial-JP2,,0,0,0,,Эй, Түнгі қала неге көп адамды тартады?
Dialogue: 1,0:01:58.01,0:01:59.47,Dial-JP2,,0,0,0,,Тәуекелдерден қорықпа
Dialogue: 1,0:01:59.91,0:02:02.03,Dial-JP2,,0,0,0,,Жарқыраған арманға қол жеткізгіңіз келсе
Dialogue: 1,0:02:02.03,0:02:04.88,Dial-JP2,,0,0,0,,Сізге үлкен табыс ұтып алсаңыз болғаны
Dialogue: 1,0:02:06.36,0:02:11.43,Dial-JP2,,0,0,0,,Түнгі қаланың барлық аңыздары қайда жиналатынын білесіз бе?
Dialogue: 1,0:02:13.65,0:02:14.46,Dial-JP2,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 1,0:02:14.46,0:02:15.23,Dial-JP,,0,0,0,,Негізгі
Dialogue: 1,0:02:16.16,0:02:18.13,Dial-JP,,0,0,0,,Сіз тамақ жеген жоқсыз, солай ма?
Dialogue: 1,0:02:25.13,0:02:28.76,Dial-JP,,0,0,0,,Қол дірілдеу. Нервтеріңізге әсер етеді, солай ма?
Dialogue: 1,0:02:29.47,0:02:30.48,Dial-JP,,0,0,0,,Бұл аяқталған кезде
Dialogue: 1,0:02:30.76,0:02:32.99,Dial-JP,,0,0,0,,CHROME-ға ауыстырған дұрыс, бұл аз ауыртпалық.
Dialogue: 1,0:02:33.35,0:02:36.37,Dial-JP,,0,0,0,,Сіз асыра айтып жатырсыз. Қолдарыңыздың шайқалуына жол бермеңіз.
Dialogue: 1,0:02:37.79,0:02:39.38,Dial-JP,,0,0,0,,Сіз осылай қаласыз...
Dialogue: 1,0:02:39.38,0:02:42.37,Dial-JP,,0,0,0,,Tsk IMPLANT 10 немесе 20
Dialogue: 1,0:02:44.44,0:02:45.02,Dial-JP,,0,0,0,,Негізгі
Dialogue: 1,0:02:46.47,0:02:47.31,Dial-JP,,0,0,0,,Сәлем, бас
Dialogue: 1,0:02:48.02,0:02:48.64,Dial-JP,,0,0,0,,Шулы
Dialogue: 1,0:02:48.96,0:02:51.77,Dial-JP,,0,0,0,,Мен өз денемді жақсы білемін.
Dialogue: 1,0:02:51.77,0:02:54.40,Dial-JP,,0,0,0,,Бұл жұмыс ақыры осы уақытқа дейін жетті.
Dialogue: 1,0:02:54.77,0:02:56.58,Dial-JP,,0,0,0,,Мен жарты жолда кете аламын ба?
Dialogue: 1,0:02:57.27,0:02:58.45,Dial-JP,,0,0,0,,Деректер әлі де бар ма?
Dialogue: 1,0:02:58.45,0:03:00.68,Dial-JP,,0,0,0,,Қазір кивилер бұзып жатқан шығар.
Dialogue: 1,0:03:06.24,0:03:08.80,Dial-JP,,0,0,0,,Бұл мен күткеннен қалыңырақ мұз.
Dialogue: 1,0:03:22.37,0:03:23.37,Dial-JP,,0,0,0,,Хамейн, тоқтат!
Dialogue: 1,0:03:24.25,0:03:26.01,Dial-JP,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 1,0:03:31.08,0:03:33.53,Dial-JP,,0,0,0,,Киви Фалько
Dialogue: 1,0:03:35.39,0:03:37.07,Dial-JP,,0,0,0,,Сіз тынышталдыңыз ба? Боқ.
Dialogue: 1,0:03:37.96,0:03:38.49,Dial-JP,,0,0,0,,Дорио
Dialogue: 1,0:03:39.41,0:03:41.14,Dial-JP,,0,0,0,,Не? Не болды?
Dialogue: 1,0:03:41.73,0:03:42.50,Dial-JP,,0,0,0,,Шабуыл?
Dialogue: 1,0:03:43.76,0:03:45.35,Dial-JP,,0,0,0,,Мына киви не болды...
Dialogue: 1,0:03:48.16,0:03:50.62,Dial-JP,,0,0,0,,Жағалаудағы кей жерлерде жаңбыр жауады
Dialogue: 1,0:03:51.26,0:03:53.82,Dial-JP,,0,0,0,,Санто-Доминго Вестбрукта
Dialogue: 1,0:03:53.82,0:03:56.00,Dial-JP,,0,0,0,,Түн ортасынан кейін таң атқанға дейін
Dialogue: 1,0:03:56.00,0:03:58.95,Dial-JP,,0,0,0,,Нөсер жаңбыр кезеңі болуы ықтимал.
Dialogue: 1,0:04:02.19,0:04:04.40,Dial-JP,,0,0,0,,​​Falco Бұл не?
Dialogue: 1,0:04:05.81,0:04:06.51,Dial-JP,,0,0,0,,болып табылады
Dialogue: 1,0:04:06.51,0:04:09.41,Dial-JP,,0,0,0,,Негізгі тұлғадан сұрау дегенді қалай түсінесіңдер?
Dialogue: 1,0:04:16.67,0:04:18.15,Dial-JP,,0,0,0,,Мен мұны істей алмаймын
Dialogue: 1,0:04:19.17,0:04:21.41,Dial-JP,,0,0,0,,Киви жедел жәрдем жібереді ме?
Dialogue: 1,0:04:21.84,0:04:23.39,Dial-JP,,0,0,0,,Бұл Танаканың бұзуы.
Dialogue: 1,0:04:23.95,0:04:25.12,Dial-JP,,0,0,0,,Не болды?
Dialogue: 1,0:04:25.57,0:04:27.29,Dial-JP,,0,0,0,,Мына ақымақтан сұра
Dialogue: 1,0:04:27.29,0:04:27.94,Dial-JP,,0,0,0,,Шулы
Dialogue: 1,0:04:29.42,0:04:30.89,Dial-JP,,0,0,0,,Негізгі соққы.
Dialogue: 1,0:04:31.28,0:04:33.61,Dial-JP,,0,0,0,,Кивидің тұзаққа түскеніне ашуланады
Dialogue: 1,0:04:34.47,0:04:36.70,Dial-JP,,0,0,0,,Негізгі Егер сіз ауруханаға барсаңыз
Dialogue: 1,0:04:37.37,0:04:39.83,Dial-JP,,0,0,0,,Негізгі Симптомдар келесі жолы пайда болса...
Dialogue: 1,0:04:45.45,0:04:47.65,Dial-JP,,0,0,0,,Әй, қандай белгілер бар?
Dialogue: 1,0:04:48.58,0:04:50.00,Dial-JP,,0,0,0,,Киберпсихоз
Dialogue: 1,0:04:59.63,0:05:00.42,Dial-JP,,0,0,0,,Негізгі
Dialogue: 1,0:05:01.56,0:05:02.96,Dial-JP,,0,0,0,,Ум...
Dialogue: 1,0:05:03.43,0:05:06.22,Dial-JP,,0,0,0,,Дорио былай деді...
Dialogue: 1,0:05:06.69,0:05:09.68,Dial-JP,,0,0,0,,Жарайды, бастысы...
Dialogue: 1,0:05:09.68,0:05:10.65,Dial-JP,,0,0,0,,Жарайды
Dialogue: 1,0:05:11.35,0:05:14.05,Dial-JP,,0,0,0,,Жарайды деп не айтасың, Дэвид?
Dialogue: 1,0:05:14.89,0:05:16.20,Dial-JP,,0,0,0,,Киберпсихо?
Dialogue: 1,0:05:17.91,0:05:20.26,Dial-JP,,0,0,0,,Қалайша мен сондай боламын?
Dialogue: 1,0:05:20.26,0:05:21.71,Dial-JP,,0,0,0,,Негізгі I...
Dialogue: 1,0:05:22.06,0:05:23.51,Dial-JP,,0,0,0,,Менің артымнан ермеңіз Дәуіт
Dialogue: 1,0:05:24.37,0:05:26.96,Dial-JP,,0,0,0,,Мен жүгіруден шаршаймын.
Dialogue: 1,0:05:29.98,0:05:32.87,Dial-JP,,0,0,0,,Сіз Сандевистандағы басқа адамдарға қарағанда жылдам жүгіре алатындықтан
Dialogue: 1,0:05:33.09,0:05:34.80,Dial-JP,,0,0,0,,Алдында басқа адам бар ма?
Dialogue: 1,0:05:35.51,0:05:37.37,Dial-JP,,0,0,0,,Бұл бастапқыда мен болдым.
Dialogue: 1,0:05:43.27,0:05:45.15,Dial-JP,,0,0,0,,Біз ақыры осы уақытқа дейін жеттік
Dialogue: 1,0:05:45.85,0:05:49.65,Dial-JP,,0,0,0,,CHROME нұсқасын төмендетудің мәні неде?
Dialogue: 1,0:05:51.18,0:05:53.35,Dial-JP,,0,0,0,,Неліктен осы жерге дейін жүгіріп келдің?
Dialogue: 1,0:05:54.66,0:05:56.97,Dial-JP,,0,0,0,,Іздеу әлдеқашан басталып кеткен болуы мүмкін.
Dialogue: 1,0:05:57.49,0:05:59.60,Dial-JP,,0,0,0,,Таң атқанша шайқас болатынын білесің.
Dialogue: 1,0:06:00.03,0:06:01.18,Dial-JP,,0,0,0,,Менің мұны істеуден басқа амалым жоқ.
Dialogue: 1,0:06:01.18,0:06:02.23,Dial-JP,,0,0,0,,Мен алмаймын.
Dialogue: 1,0:06:02.60,0:06:04.48,Dial-JP,,0,0,0,,Сіз шынымен білетін адамсыз ба?
Dialogue: 1,0:06:05.13,0:06:06.16,Dial-JP,,0,0,0,,Арасака…
Dialogue: 1,0:06:09.59,0:06:10.74,Dial-JP,,0,0,0,,Оны тоқтатайық
Dialogue: 1,0:06:11.58,0:06:12.82,Dial-JP,,0,0,0,,Үйге қайтайық, Люси.
Dialogue: 1,0:06:13.59,0:06:15.16,Dial-JP,,0,0,0,,Өзіңізді мұны істеуге мәжбүрлемеңіз.
Dialogue: 1,0:06:15.16,0:06:16.58,Dial-JP,,0,0,0,,Үніңді жап, Дэвид.
Dialogue: 1,0:06:16.58,0:06:18.66,Dial-JP,,0,0,0,,Танаканы бастапқы орнында қалдырыңыз.
Dialogue: 1,0:06:18.96,0:06:20.43,Dial-JP,,0,0,0,,Бәрі ешқашан болмағандай
Dialogue: 1,0:06:20.43,0:06:21.84,Dial-JP,,0,0,0,,Саған бәрібір.
Dialogue: 1,0:06:22.33,0:06:24.26,Dial-JP,,0,0,0,,Қашудың пайдасы жоқ.
Dialogue: 1,0:06:25.70,0:06:27.96,Dial-JP,,0,0,0,,Дэвид, маған мұны істей алатыныңды айт.
Dialogue: 1,0:06:29.01,0:06:29.89,Dial-JP,,0,0,0,,Бірақ ертерек
Dialogue: 1,0:06:29.89,0:06:30.87,Dial-JP,,0,0,0,,Айтыңыз
Dialogue: 1,0:06:32.09,0:06:35.16,Dial-JP,,0,0,0,,Арасаканың қандай екенін білмейсің.
Dialogue: 1,0:06:35.58,0:06:36.81,Dial-JP,,0,0,0,,Мені бақылап жатыр.
Dialogue: 1,0:06:37.57,0:06:39.34,Dial-JP,,0,0,0,,Мен де, сен де
Dialogue: 1,0:06:40.09,0:06:41.78,Dial-JP,,0,0,0,,Мен мұны істеймін немесе жасамаймын.
Dialogue: 1,0:06:42.32,0:06:43.55,Dial-JP,,0,0,0,,Менің мұны істеуден басқа амалым жоқ.
Dialogue: 1,0:06:44.62,0:06:45.57,Dial-JP,,0,0,0,,Мен түсінемін.
Dialogue: 1,0:06:47.27,0:06:49.45,Dial-JP,,0,0,0,,Бірақ егер сен оны айтсаң, мен...
Dialogue: 1,0:06:50.54,0:06:51.85,Dial-JP,,0,0,0,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 1,0:06:54.69,0:06:57.29,Dial-JP,,0,0,0,,Кешіріңіз Люси, мен...
Dialogue: 1,0:06:59.22,0:07:01.96,Dial-JP,,0,0,0,,Мен мұны істей аламын, егер бұл сен болсаң, жоқ.
Dialogue: 1,0:07:02.55,0:07:04.05,Dial-JP,,0,0,0,,Жасаңыз Люси
Dialogue: 1,0:07:06.44,0:07:07.04,Dial-JP,,0,0,0,,X-Кира, Дәптері бар және оны шынымен қолданатын
Dialogue: 1,0:07:08.70,0:07:10.50,Dial-JP,,0,0,0,,Бірақ тек Дәуітпен.
Dialogue: 1,0:07:10.96,0:07:12.48,Dial-JP,,0,0,0,,Басты да кіргізбе.
Dialogue: 1,0:07:12.78,0:07:14.26,Dial-JP,,0,0,0,,Әйтпесе, мен мұны істемеймін.
Dialogue: 1,0:07:18.10,0:07:19.01,Dial-JP,,0,0,0,,Түсіндім
Dialogue: 1,0:07:19.30,0:07:21.06,Dial-JP,,0,0,0,,Дегенмен, бізге хабарласыңыз.
Dialogue: 1,0:07:21.43,0:07:22.83,Dial-JP,,0,0,0,,Әр 15 минут сайын
Dialogue: 1,0:07:23.42,0:07:24.71,Dial-JP,,0,0,0,,Таң атқанша тазалаңыз
Dialogue: 1,0:07:25.06,0:07:25.56,Dial-JP,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 1,0:07:27.29,0:07:28.99,Dial-JP,,0,0,0,,Дэвид Мейн
Dialogue: 1,0:07:31.88,0:07:33.12,Dial-JP,,0,0,0,,Мен білмеймін
Dialogue: 1,0:07:41.78,0:07:42.50,Dial-JP,,0,0,0,,Негізгі
Dialogue: 1,0:07:47.43,0:07:48.02,Dial-JP,,0,0,0,,Дорио
Dialogue: 1,0:07:49.62,0:07:52.86,Dial-JP,,0,0,0,,Әй, бәрібір Дорио болғаны жақсы болар еді.
Dialogue: 1,0:07:52.86,0:07:54.00,Dial-JP,,0,0,0,,Шешім жасаңыз
Dialogue: 1,0:07:54.33,0:07:58.49,Dial-JP,,0,0,0,,Алдымен бірдеңе айтыңыз.
Dialogue: 1,0:07:58.94,0:08:01.28,Dial-JP,,0,0,0,,Неліктен мұны екі адам орындауы керек?
Dialogue: 1,0:08:01.28,0:08:01.98,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:08:11.01,0:08:12.75,Dial-JP,,0,0,0,,Ум...
Dialogue: 1,0:08:15.24,0:08:19.18,Dial-JP,,0,0,0,,Неліктен терең сүңгуір портын жасырдың?
Dialogue: 1,0:08:24.21,0:08:25.03,Dial-JP,,0,0,0,,Мен оны саламын.
Dialogue: 1,0:08:29.23,0:08:30.04,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:08:30.71,0:08:31.36,Dial-JP,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 1,0:08:34.10,0:08:34.80,Dial-JP,,0,0,0,,Жүректеріңізді құрбан етіңіздер!! Жүректеріңізді құрбан етіңіздер!! (Әскери полиция) Хич
Dialogue: 1,0:08:39.06,0:08:40.79,Dial-JP,,0,0,0,,Бұл жерде тұзақ болды
Dialogue: 1,0:08:41.46,0:08:43.61,Dial-JP,,0,0,0,,Бұл кіреберіс екеніне күмән жоқ.
Dialogue: 1,0:08:54.31,0:08:56.87,Dial-JP,,0,0,0,,Иә, ең бастысы
Dialogue: 1,0:08:57.18,0:08:58.50,Dial-JP,,0,0,0,,Мен қазір тынышпын.
Dialogue: 1,0:08:59.64,0:09:02.72,Dial-JP,,0,0,0,,Эй, Дорио, мына жігіт.
Dialogue: 1,0:09:02.72,0:09:03.17,Dial-JP,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 1,0:09:03.62,0:09:04.94,Dial-JP,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 1,0:09:08.83,0:09:10.12,Dial-JP,,0,0,0,,Мен сені өлтіремін бе?
Dialogue: 1,0:09:11.93,0:09:14.03,Dial-JP,,0,0,0,,Уақыттың таусылуына дайын болу керек.
Dialogue: 1,0:09:15.26,0:09:18.43,Dial-JP,,0,0,0,,Өзіңізді жақсы сезінсеңіз, мұны істеудің қажеті жоқ.
Dialogue: 1,0:09:22.80,0:09:23.81,Dial-JP,,0,0,0,,Бұл не үшін?
Dialogue: 1,0:09:24.30,0:09:25.49,Dial-JP,,0,0,0,,Деректер жоқ па?
Dialogue: 1,0:09:25.86,0:09:26.85,Dial-JP,,0,0,0,,Қазір орындалуда
Dialogue: 1,0:09:27.41,0:09:30.26,Dial-JP,,0,0,0,,Бұл көп уақытты алады. Оны кім істеп жатыр?
Dialogue: 1,0:09:30.68,0:09:32.12,Dial-JP,,0,0,0,,Бұл не?
Dialogue: 1,0:09:32.74,0:09:35.28,Dial-JP,,0,0,0,,Негізгі Сіз бірдеңені жасырып жатырсыз, солай ма?
Dialogue: 1,0:09:36.90,0:09:38.69,Dial-JP,,0,0,0,,Кивисіз жасауға бола ма?
Dialogue: 1,0:09:39.33,0:09:41.82,Dial-JP,,0,0,0,,Неліктен Чи Фалько?
Dialogue: 1,0:09:42.36,0:09:44.98,Dial-JP,,0,0,0,,Сақтық көшірмеге түсетін жүктеме тым ауыр емес пе?
Dialogue: 1,0:09:45.48,0:09:46.43,Dial-JP,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 1,0:09:46.77,0:09:48.05,Dial-JP,,0,0,0,,Тек асығыңыз
Dialogue: 1,0:09:48.32,0:09:50.96,Dial-JP,,0,0,0,,Ол Арасаканың басшыларына тікелей хабарласты.
Dialogue: 1,0:09:51.64,0:09:53.55,Dial-JP,,0,0,0,,Бұл жолы сәтсіздікке жол берілмейді
Dialogue: 1,0:09:53.80,0:09:54.78,Dial-JP,,0,0,0,,Мен білемін
Dialogue: 1,0:09:56.79,0:09:57.40,Dial-JP,,0,0,0,,Не?
Dialogue: 1,0:09:58.94,0:10:00.30,Dial-JP,,0,0,0,,Не қарап тұрсың, Фарах...
Dialogue: 1,0:10:09.77,0:10:10.85,Dial-JP,,0,0,0,,Тұрақты емес
Dialogue: 1,0:10:12.17,0:10:14.46,Dial-JP,,0,0,0,,Ей, кенеттен не болды?
Dialogue: 1,0:10:18.17,0:10:20.70,Dial-JP,,0,0,0,,Ал, күт, күт.
Dialogue: 1,0:10:20.70,0:10:21.64,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:10:24.40,0:10:27.57,Dial-JP,,0,0,0,,Сәлем, негізгі түзетуді алыңыз.
Dialogue: 1,0:10:29.86,0:10:32.12,Dial-JP,,0,0,0,,Анестезия тозып барады.
Dialogue: 1,0:10:33.15,0:10:34.46,Dial-JP,,0,0,0,,Не істеп жатырсың, Дэвид?
Dialogue: 1,0:10:40.37,0:10:43.33,Dial-JP,,0,0,0,,Менің ойымша, бұл сенсің, Дэвид.
Dialogue: 1,0:10:44.52,0:10:45.31,Dial-JP,,0,0,0,,Неліктен?
Dialogue: 1,0:10:46.72,0:10:49.65,Dial-JP,,0,0,0,,Маған сіз туралы әртүрлі хабарламалар келді.
Dialogue: 1,0:10:49.96,0:10:53.49,Dial-JP,,0,0,0,,Катсуо екеуіңнің араларыңда мәселе болғанын да білемін.
Dialogue: 1,0:10:56.07,0:10:59.92,Dial-JP,,0,0,0,,Оның үстіне мен сені мектепке қайтаруға бұйрық бердім.
Dialogue: 1,0:11:00.33,0:11:01.26,Dial-JP,,0,0,0,,Сіз
Dialogue: 1,0:11:01.67,0:11:04.87,Dial-JP,,0,0,0,,Өтінемін, Давид, маған көмектес.
Dialogue: 1,0:11:05.95,0:11:08.10,Dial-JP,,0,0,0,,Мен әлі өлгім келмейді
Dialogue: 1,0:11:08.71,0:11:11.13,Dial-JP,,0,0,0,,Деректерді шығарып алу сізді өлтіреді...
Dialogue: 1,0:11:11.13,0:11:12.60,Dial-JP,,0,0,0,,Ол қайда еді?
Dialogue: 1,0:11:14.12,0:11:15.53,Dial-JP,,0,0,0,,Мен олардың жүздерін көрдім.
Dialogue: 1,0:11:16.10,0:11:18.26,Dial-JP,,0,0,0,,Әлі де өшірілмеген
Dialogue: 1,0:11:19.58,0:11:23.30,Dial-JP,,0,0,0,,Тыңдаңыз, мен сізді неге қайта қалпына келтірдім деп ойлайсыз?
Dialogue: 1,0:11:24.21,0:11:26.83,Dial-JP,,0,0,0,,Өйткені сіз құнды ресурссыз.
Dialogue: 1,0:11:27.51,0:11:30.42,Dial-JP,,0,0,0,,Арасака пайда әкеледі деп есептейді
Dialogue: 1,0:11:31.27,0:11:34.59,Dial-JP,,0,0,0,,Болашақ уәде етілген, Давид.
Dialogue: 1,0:11:34.99,0:11:37.11,Dial-JP,,0,0,0,,Өміріңді босқа өткізбе
Dialogue: 1,0:11:47.72,0:11:48.23,Dial-JP,,0,0,0,,Шинигаминің көздерін алу үшін,
Dialogue: 1,0:12:00.17,0:12:02.18,Dial-JP,,0,0,0,,Мен сенің қашуыңа жол бере алмаймын.
Dialogue: 1,0:12:02.60,0:12:04.39,Dial-JP,,0,0,0,,Арасака хабарлаңыз.
Dialogue: 1,0:12:04.68,0:12:06.37,Dial-JP,,0,0,0,,Басқа ештеңе істеудің қажеті жоқ
Dialogue: 1,0:12:06.63,0:12:08.08,Dial-JP,,0,0,0,,Кесектер 5 минутта жиналады
Dialogue: 1,0:12:08.08,0:12:09.40,Dial-JP,,0,0,0,,Менің айтқым келгені бұл емес.
Dialogue: 1,0:12:10.03,0:12:11.44,Dial-JP,,0,0,0,,Досыңа опасыздық жасай алмайсың
Dialogue: 1,0:12:11.44,0:12:15.26,Dial-JP,,0,0,0,,Пунчлинь: ақымақтарды бір реттік етіп жасайды.
Dialogue: 1,0:12:15.61,0:12:17.84,Dial-JP,,0,0,0,,Арасақа қосылсаң да солай.
Dialogue: 1,0:12:17.84,0:12:19.85,Dial-JP,,0,0,0,,Жоқ, түсінбеймін.
Dialogue: 1,0:12:20.42,0:12:23.37,Dial-JP,,0,0,0,,MILITECH бәрібір ақша төлейтін шығар.
Dialogue: 1,0:12:23.65,0:12:27.10,Dial-JP,,0,0,0,,Сіз компания атынан қолыңызды былғап жатырсыз.
Dialogue: 1,0:12:27.56,0:12:30.45,Dial-JP,,0,0,0,,Ол дүниеде қанша биікке көтерілсең де
Dialogue: 1,0:12:30.45,0:12:33.13,Dial-JP,,0,0,0,,Компания корпорациясының соңынан төмен
Dialogue: 1,0:12:34.22,0:12:35.04,Dial-JP,,0,0,0,,Мұндай нәрсе
Dialogue: 1,0:12:54.81,0:12:55.61,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:12:56.89,0:12:59.38,Dial-JP,,0,0,0,,Эй Дэвид, сен ше?
Dialogue: 1,0:12:59.81,0:13:02.59,Dial-JP,,0,0,0,,Сіз шынымен не қалайсыз?
Dialogue: 1,0:13:04.67,0:13:06.11,Dial-JP,,0,0,0,,Не...
Dialogue: 1,0:13:08.86,0:13:10.36,Dial-JP,,0,0,0,,Дэвид, сен не істеп жатырсың?
Dialogue: 1,0:13:10.36,0:13:11.22,Dial-JP,,0,0,0,,Сіз ояусыз.
Dialogue: 1,0:13:11.54,0:13:12.59,Dial-JP,,0,0,0,,Дэвидтің медицинасы
Dialogue: 1,0:13:13.08,0:13:13.74,Dial-JP,,0,0,0,,Маған қарыз бер
Dialogue: 1,0:13:15.88,0:13:17.67,Dial-JP,,0,0,0,,Не болды?
Dialogue: 1,0:13:18.42,0:13:21.27,Dial-JP,,0,0,0,,Бұл өте жаман. Қазір өлсем, бітті.
Dialogue: 1,0:13:21.27,0:13:21.86,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:13:22.27,0:13:23.67,Dial-JP,,0,0,0,,Мықты бол, Дэвид.
Dialogue: 1,0:13:24.02,0:13:25.68,Dial-JP,,0,0,0,,Сіз оны орнаттыңыз, солай ма?
Dialogue: 1,0:13:26.20,0:13:27.00,Dial-JP,,0,0,0,,Жарайды, Рюк.
Dialogue: 1,0:13:28.84,0:13:30.56,Dial-JP,,0,0,0,,Дорио Люси терең сүңгумен айналысады
Dialogue: 1,0:13:30.56,0:13:31.10,Dial-JP,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 1,0:13:31.10,0:13:33.04,Dial-JP,,0,0,0,,Жылдам ажыратыңыз
Dialogue: 1,0:13:35.07,0:13:35.62,Dial-JP,,0,0,0,,Жарайды
Dialogue: 1,0:13:36.11,0:13:36.73,Dial-JP,,0,0,0,,розеткадан ажыратыңыз
Dialogue: 1,0:13:50.36,0:13:51.42,Dial-JP,,0,0,0,,Деректер қауіпсіз ме?
Dialogue: 1,0:13:51.71,0:13:54.28,Dial-JP,,0,0,0,,Жүрек тоқтағаннан кейін бірден емделгендіктен болар.
Dialogue: 1,0:13:55.66,0:13:56.55,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:13:57.02,0:13:59.55,Dial-JP,,0,0,0,,Ах, Люси жақсы...
Dialogue: 1,0:14:01.54,0:14:04.02,Dial-JP,,0,0,0,,Дэвид, сен не істеп жүрсің?
Dialogue: 1,0:14:05.25,0:14:06.67,Dial-JP,,0,0,0,,Сен ғой—
Dialogue: 1,0:14:07.25,0:14:09.37,Dial-JP,,0,0,0,,Сіз не істеп жүрсіз?
Dialogue: 1,0:14:09.62,0:14:10.54,Dial-JP,,0,0,0,,Нандато
Dialogue: 1,0:14:10.94,0:14:14.88,Dial-JP,,0,0,0,,Кивиді ұрып, бәрін Люсиге итеріңіз
Dialogue: 1,0:14:14.88,0:14:17.15,Dial-JP,,0,0,0,,Мен сенен не істеп жатқаныңды сұрадым.
Dialogue: 1,0:14:17.15,0:14:18.93,Dial-JP,,0,0,0,,Давид
Dialogue: 1,0:14:18.93,0:14:20.17,Dial-JP,,0,0,0,,Негізгі Дэвид
Dialogue: 1,0:14:21.07,0:14:22.81,Dial-JP,,0,0,0,,Жалған чипке бұрын шабуыл жасалған.
Dialogue: 1,0:14:23.09,0:14:24.96,Dial-JP,,0,0,0,,Травматология тобына сигнал ағып кетті
Dialogue: 1,0:14:25.96,0:14:26.85,Dial-JP,,0,0,0,,Ақымақ
Dialogue: 1,0:14:29.52,0:14:31.37,Dial-JP,,0,0,0,,Дэвид, бұл туралы кейінірек.
Dialogue: 1,0:14:31.74,0:14:33.01,Dial-JP,,0,0,0,,Көлікті дайында
Dialogue: 1,0:14:35.13,0:14:36.61,Dial-JP,,0,0,0,,Тұрақты Дэвид
Dialogue: 1,0:14:37.02,0:14:38.88,Dial-JP,,0,0,0,,Жаса, істе.
Dialogue: 1,0:14:40.61,0:14:42.58,Dial-JP,,0,0,0,,Мен бірден келемін, сондықтан төменде күтіңіз.
Dialogue: 1,0:14:42.91,0:14:43.73,Dial-JP,,0,0,0,,Мен білемін
Dialogue: 1,0:14:46.32,0:14:48.59,Dial-JP,,0,0,0,,Ол платинамен үйлесімді ме?
Dialogue: 1,0:14:48.59,0:14:49.13,Dial-JP,,0,0,0,,Дорио
Dialogue: 1,0:14:54.52,0:14:56.81,Dial-JP,,0,0,0,,Нысанаға жақын жерде атыс дыбысы расталды
Dialogue: 1,0:14:57.57,0:14:59.77,Dial-JP,,0,0,0,,Қарулы кедергілер болуы мүмкін
Dialogue: 1,0:15:00.51,0:15:02.34,Dial-JP,,0,0,0,,NCPD-ден қолдау сұрау
Dialogue: 1,0:15:13.21,0:15:14.35,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:15:15.07,0:15:16.45,Dial-JP,,0,0,0,,Люси, бәрі жақсы.
Dialogue: 1,0:15:17.11,0:15:18.99,Dial-JP,,0,0,0,,Не болып жатыр?
Dialogue: 1,0:15:19.58,0:15:22.94,Dial-JP,,0,0,0,,Танака оянды деп ойласам, миы қуырылып қалыпты.
Dialogue: 1,0:15:24.74,0:15:26.36,Dial-JP,,0,0,0,,Ішінде бірдеңе болды.
Dialogue: 1,0:15:26.87,0:15:28.09,Dial-JP,,0,0,0,,Бас және Дорио
Dialogue: 1,0:15:28.66,0:15:30.41,Dial-JP,,0,0,0,,Танаканы қабылдағаннан кейін...
Dialogue: 1,0:15:31.43,0:15:32.36,Dial-JP,,0,0,0,,Ол қайтыс болды
Dialogue: 1,0:15:32.69,0:15:33.76,Dial-JP,,0,0,0,,Жанданды
Dialogue: 1,0:15:34.50,0:15:35.25,Dial-JP,,0,0,0,,Неліктен?
Dialogue: 1,0:15:35.79,0:15:38.26,Dial-JP,,0,0,0,,Неліктен әлі күнге дейін деректер жоқ ...
Dialogue: 1,0:15:38.26,0:15:40.04,Dial-JP,,0,0,0,,Танаканы әкелудің еш мәні жоқ.
Dialogue: 1,0:15:41.22,0:15:42.42,Dial-JP,,0,0,0,,Деректер болған жоқ.
Dialogue: 1,0:15:44.79,0:15:45.66,Dial-JP,,0,0,0,,Бұл өтірік
Dialogue: 1,0:15:46.76,0:15:49.36,Dial-JP,,0,0,0,,Шүкір, Арасака бұл туралы білді.
Dialogue: 1,0:15:49.89,0:15:52.85,Dial-JP,,0,0,0,,Негізгі ингибиторды ұмытпаңыз
Dialogue: 1,0:15:53.35,0:15:54.40,Dial-JP,,0,0,0,,Сіз жай ғана соқтыңыз.
Dialogue: 1,0:15:54.84,0:15:55.48,Dial-JP,,0,0,0,,Қозғалмаңыз
Dialogue: 1,0:16:03.75,0:16:04.35,Dial-JP,,0,0,0,,Ақымақ
Dialogue: 1,0:16:04.69,0:16:08.39,Dial-JP,,0,0,0,,NCPD жігіттері осындай уақытта ғана жылдам жұмыс істейді.
Dialogue: 1,0:16:09.06,0:16:10.57,Dial-JP,,0,0,0,,Терең жүр, тереңде.
Dialogue: 1,0:16:12.50,0:16:14.03,Dial-JP,,0,0,0,,Ақымақ, қосыла алмаймын.
Dialogue: 1,0:16:15.31,0:16:17.08,Dial-JP,,0,0,0,,Дэвид, сен қайда бара жатырсың?
Dialogue: 1,0:16:17.45,0:16:18.42,Dial-JP,,0,0,0,,Көмекке барыңыз
Dialogue: 1,0:16:18.42,0:16:20.93,Dial-JP,,0,0,0,,Идиот, қатесін алсаң не істейсің?
Dialogue: 1,0:16:21.41,0:16:22.19,Dial-JP,,0,0,0,,Күте тұрыңыз.
Dialogue: 1,0:16:30.64,0:16:31.68,Dial-JP,,0,0,0,,Мен бәрібір барамын
Dialogue: 1,0:16:31.68,0:16:32.68,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:16:32.68,0:16:34.01,Dial-JP,,0,0,0,,​​Неден қорқасың?
Dialogue: 1,0:16:34.32,0:16:36.43,Dial-JP,,0,0,0,,Бұл ұзаққа созылатыны қызық
Dialogue: 1,0:16:36.43,0:16:38.42,Dial-JP,,0,0,0,,Мен күттім де, радионы алдым.
Dialogue: 1,0:16:39.18,0:16:41.85,Dial-JP,,0,0,0,,Жарақаттың тереңінде NCPD де осында.
Dialogue: 1,0:16:42.70,0:16:43.78,Dial-JP,,0,0,0,,Мен қоршаудамын.
Dialogue: 1,0:16:44.09,0:16:45.24,Dial-JP,,0,0,0,,Мен әлі баруым керек
Dialogue: 1,0:16:45.24,0:16:47.22,Dial-JP,,0,0,0,,Жоқ, сен өлгің келеді.
Dialogue: 1,0:16:55.55,0:16:58.34,Dial-JP,,0,0,0,,Мен өлмеймін, өйткені Люси осында.
Dialogue: 1,0:16:58.34,0:16:59.27,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:16:59.69,0:17:02.31,Dial-JP,,0,0,0,,Мүмкін екеуміз де аман қалмаспыз.
Dialogue: 1,0:17:02.84,0:17:04.21,Dial-JP,,0,0,0,,Тек қашып кеткен дұрыс...
Dialogue: 1,0:17:04.21,0:17:05.61,Dial-JP,,0,0,0,,Дыбысты естіп тұрсам да
Dialogue: 1,0:17:06.30,0:17:07.27,Dial-JP,,0,0,0,,Жылдамдықтан гөрі сабыр сақтауды басты ұстаным ет.
Dialogue: 1,0:17:08.85,0:17:11.01,Dial-JP,,0,0,0,,Бүгін сен біртүрлі әрекет етесің, Люси.
Dialogue: 1,0:17:11.63,0:17:14.63,Dial-JP,,0,0,0,,Мен Танаканың ішінен бірдеңе көрдім.
Dialogue: 1,0:17:14.63,0:17:17.11,Dial-JP,,0,0,0,,Мен сені қалаймын...
Dialogue: 1,0:17:19.11,0:17:20.05,Dial-JP,,0,0,0,,Сәлем Люси
Dialogue: 1,0:17:20.65,0:17:22.26,Dial-JP,,0,0,0,,Сіз маған айтпайсыз.
Dialogue: 1,0:17:23.42,0:17:24.82,Dial-JP,,0,0,0,,«Мен мұны істей аламын»
Dialogue: 1,0:17:45.42,0:17:46.49,Dial-JP,,0,0,0,,Сіз не істеп жатырсыз? Негізгі
Dialogue: 1,0:17:46.78,0:17:47.94,Dial-JP,,0,0,0,,Тәртіпсіз көрінбеңіз
Dialogue: 1,0:17:53.51,0:17:55.46,Dial-JP,,0,0,0,,Қарғыс атсын бұл ақымақ.
Dialogue: 1,0:18:01.46,0:18:02.38,Dial-JP,,0,0,0,,Жоқ, атпа.
Dialogue: 1,0:18:02.68,0:18:03.39,Dial-JP,,0,0,0,,Неліктен?
Dialogue: 1,0:18:03.77,0:18:05.25,Dial-JP,,0,0,0,,Платина мүшелерін қалқан ретінде пайдалану
Dialogue: 1,0:18:05.25,0:18:06.42,Dial-JP,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 1,0:18:34.83,0:18:35.64,Dial-JP,,0,0,0,,Дорио
Dialogue: 1,0:18:36.30,0:18:39.08,Dial-JP,,0,0,0,,Негізгі Мен қазір саған барамын.
Dialogue: 1,0:18:40.61,0:18:41.40,Dial-JP,,0,0,0,,Сіз
Dialogue: 1,0:18:42.39,0:18:44.69,Dial-JP,,0,0,0,,Маған мұны істе десең, мен...
Dialogue: 1,0:18:56.31,0:18:57.29,Dial-JP,,0,0,0,,Ой, ой… Бұл жарамайды. Шынымен де жарамайды.
Dialogue: 1,0:18:58.15,0:18:59.55,Dial-JP,,0,0,0,,Менің кінәм бар ма?
Dialogue: 1,0:19:07.88,0:19:08.58,Dial-JP,,0,0,0,,Қозғалмаңыз
Dialogue: 1,0:19:08.90,0:19:11.36,Dial-JP,,0,0,0,,Қаруыңызды қойып, қолыңызды басыңыздан жоғары көтеріңіз.
Dialogue: 1,0:19:12.27,0:19:13.39,Dial-JP,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 1,0:19:22.73,0:19:24.48,Dial-JP,,0,0,0,,Сақтанушының қайтыс болуын растау
Dialogue: 1,0:19:25.16,0:19:25.74,Dial-JP,,0,0,0,,Эй
Dialogue: 1,0:19:27.11,0:19:28.43,Dial-JP,,0,0,0,,Менің кінәм бар ма?
Dialogue: 1,0:19:31.10,0:19:32.29,Dial-JP,,0,0,0,,Киберпсихо
Dialogue: 1,0:19:32.29,0:19:34.30,Dial-JP,,0,0,0,,MaxTac Ah-қа хабарласыңыз!
Dialogue: 1,0:19:38.26,0:19:40.31,Dial-JP,,0,0,0,,Мердігердің қайтыс болуын растау. Шығу.
Dialogue: 1,0:19:40.56,0:19:41.78,Dial-JP,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 1,0:19:42.19,0:19:44.65,Dial-JP,,0,0,0,,Келісімшарт жойылды. Қалағаныңызша түсіре аласыз.
Dialogue: 1,0:19:44.65,0:19:45.57,Dial-JP,,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 1,0:19:46.40,0:19:47.74,Dial-JP,,0,0,0,,Бұл осында. Тез шығарыңыз.
Dialogue: 1,0:20:07.19,0:20:07.67,Dial-JP,,0,0,0,,Ақымақ
Dialogue: 1,0:20:18.25,0:20:19.83,Dial-JP,,0,0,0,,Дэвид Мен оны естимін.
Dialogue: 1,0:20:20.46,0:20:21.95,Dial-JP,,0,0,0,,Киберпсихоға басты назар аудару
Dialogue: 1,0:20:22.70,0:20:24.15,Dial-JP,,0,0,0,,MaxTac деп те аталады
Dialogue: 1,0:20:24.76,0:20:26.06,Dial-JP,,0,0,0,,Тезірек оралыңыз
Dialogue: 1,0:20:27.79,0:20:28.33,Dial-JP,,0,0,0,,Негізгі
Dialogue: 1,0:20:30.10,0:20:32.04,Dial-JP,,0,0,0,,Бұл не, Дәуіт?
Dialogue: 1,0:20:32.57,0:20:33.76,Dial-JP,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 1,0:20:34.28,0:20:36.32,Dial-JP,,0,0,0,,Маған көмектес
Dialogue: 1,0:20:38.19,0:20:40.66,Dial-JP,,0,0,0,,Дориогана қайтыс болды.
Dialogue: 1,0:20:41.62,0:20:45.22,Dial-JP,,0,0,0,,Бұл не?
Dialogue: 1,0:20:45.74,0:20:47.88,Dial-JP,,0,0,0,,Бұл сіздің қолыңыздан келетін нәрсе
Dialogue: 1,0:20:50.15,0:20:52.86,Dial-JP,,0,0,0,,Қашайық, сен де өлесің.
Dialogue: 1,0:20:55.01,0:20:56.34,Dial-JP,,0,0,0,,Мен қашпаймын
Dialogue: 1,0:20:56.62,0:20:58.98,Dial-JP,,0,0,0,,Сол жақтан «Қасқыр» келе жатыр.
Dialogue: 1,0:21:00.01,0:21:01.18,Dial-JP,,0,0,0,,Бәрі жақсы, Буккирати
Dialogue: 1,0:21:06.32,0:21:08.60,Dial-JP,,0,0,0,,Жарайды, мен де күресемін.
Dialogue: 1,0:21:09.01,0:21:10.11,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:21:10.50,0:21:12.30,Dial-JP,,0,0,0,,Мен мұны істеуге шешім қабылдадым.
Dialogue: 1,0:21:12.66,0:21:14.21,Dial-JP,,0,0,0,,Мен негізгіге көмектесемін
Dialogue: 1,0:21:16.34,0:21:18.15,Dial-JP,,0,0,0,,Қарғыс атсын, мен қорқамын.
Dialogue: 1,0:21:19.08,0:21:20.89,Dial-JP,,0,0,0,,MaxTac-пен араласпаңыз.
Dialogue: 1,0:21:21.15,0:21:22.30,Dial-JP,,0,0,0,,Келіңіз және көріңіз
Dialogue: 1,0:21:22.93,0:21:25.21,Dial-JP,,0,0,0,,Негізгі: Екі адам бір нәрсені істей алады.
Dialogue: 1,0:21:25.58,0:21:26.68,Dial-JP,,0,0,0,,әйтеуір
Dialogue: 1,0:21:27.47,0:21:29.69,Dial-JP,,0,0,0,,Егер бірдеңе болса, онда...
Dialogue: 1,0:21:50.58,0:21:51.46,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:21:54.88,0:21:56.57,Dial-JP,,0,0,0,,Сіз мұны әлі істей алмайсыз.
Dialogue: 1,0:21:59.88,0:22:01.74,Dial-JP,,0,0,0,,Неліктен Негізгі
Dialogue: 1,0:22:03.13,0:22:03.86,Dial-JP,,0,0,0,,Неліктен?
Dialogue: 1,0:22:14.47,0:22:15.38,Dial-JP,,0,0,0,,Дәуіт
Dialogue: 1,0:22:18.96,0:22:20.54,Dial-JP,,0,0,0,,Мен осында өлемін
Dialogue: 1,0:22:21.79,0:22:23.13,Dial-JP,,0,0,0,,Сіз өмір сүруіңіз керек
