Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.46,0:00:08.71,Top,,0000,0000,0000,,‎NETFLIX аниме сериясы
Dialogue: 0,0:00:11.72,0:00:13.93,Top,,0000,0000,0000,,‎(Дэвид Мартинес) ‎Оны мен үшін орнатыңыз.
Dialogue: 0,0:00:11.76,0:00:13.93,Bottom,,0000,0000,0000,,Менің хромдайтын уақытым келді.
Dialogue: 0,0:00:14.01,0:00:15.97,Bottom,,0000,0000,0000,,Бұл жерден кет.
Dialogue: 0,0:00:14.01,0:00:18.39,Top,,0000,0000,0000,,‎(Липпардок) Сіз қалжыңдап тұрсыз ба? Сіз оны сату туралы айтқан жоқсыз ба?
Dialogue: 0,0:00:16.05,0:00:18.39,Bottom,,0000,0000,0000,,Мен сізге сату үшін бағаны бердім.
Dialogue: 0,0:00:18.47,0:00:19.68,Bottom,,0000,0000,0000,,Бұл жерде сату үшін емес.
Dialogue: 0,0:00:18.47,0:00:21.60,Top,,0000,0000,0000,,Мен оны сатпаймын. Мен оны өзім орнатқым келеді.
Dialogue: 0,0:00:19.76,0:00:21.60,Bottom,,0000,0000,0000,,Мен орнатуға келдім.
Dialogue: 0,0:00:21.68,0:00:23.23,Top,,0000,0000,0000,,‎(Reperdoc) Оны тоқтатыңыз.
Dialogue: 0,0:00:21.68,0:00:24.31,Bottom,,0000,0000,0000,,Тыңдау. Бұл әскери дәреже.
Dialogue: 0,0:00:23.31,0:00:26.06,Top,,0000,0000,0000,,‎Бұл жай ғана сәйкес емес, бірақ ол қарқынды
Dialogue: 0,0:00:24.39,0:00:27.81,Bottom,,0000,0000,0000,,Сізде оны өңдеу үшін құрастыру бар немесе жоқ.
Dialogue: 0,0:00:26.15,0:00:30.57,Top,,0000,0000,0000,,Сонымен қатар, бұл ауыр әскери зат, сондықтан бұл баланың қолынан келетін нәрсе емес.
Dialogue: 0,0:00:27.90,0:00:30.57,Bottom,,0000,0000,0000,,Ал таңда, сіз оны түсінбедіңіз.
Dialogue: 0,0:00:30.65,0:00:33.86,Bottom,,0000,0000,0000,,Клиентінің қамын ойлайтын сыпырушы сияқты сөйлейді.
Dialogue: 0,0:00:30.65,0:00:33.95,Top,,0000,0000,0000,,Сіз ақшаны төлесеңіз, бұл сіз білетін нәрсе емес.
Dialogue: 0,0:00:33.95,0:00:37.49,Bottom,,0000,0000,0000,,Ха! Маған шамасы келмейтін бала үшін қыжыл.
Dialogue: 0,0:00:34.03,0:00:37.24,Top,,0000,0000,0000,,‎Хаха, ақша... Хмм, сенде жоқ шығар.
Dialogue: 0,0:00:38.62,0:00:40.66,Top,,0000,0000,0000,,‎Ха... Түсіндім.
Dialogue: 0,0:00:39.16,0:00:40.79,Bottom,,0000,0000,0000,,Бля саған.
Dialogue: 0,0:00:41.37,0:00:42.70,Bottom,,0000,0000,0000,,Мен сені таңдадым, себебі маған асталы дүниеде ауыр қару-жарақ қажет болады.
Dialogue: 0,0:00:41.37,0:00:42.70,Top,,0000,0000,0000,,Бір минут күтіңіз
Dialogue: 0,0:00:42.79,0:00:45.00,Top,,0000,0000,0000,,‎Бұл сауда деп аталады емес пе?
Dialogue: 0,0:00:42.79,0:00:45.25,Bottom,,0000,0000,0000,,Бля, адам. мен тістеймін.
Dialogue: 0,0:00:45.92,0:00:48.21,Top,,0000,0000,0000,,Мен оны орнатамын.
Dialogue: 0,0:00:45.92,0:00:48.50,Bottom,,0000,0000,0000,,Мен сені чиптеймін.
Dialogue: 0,0:00:48.59,0:00:51.67,Bottom,,0000,0000,0000,,Бірақ сіз оны жұлып алуға жылап келгенде...
Dialogue: 0,0:00:48.71,0:00:51.42,Top,,0000,0000,0000,,‎Оның орнына, тіпті оны жойғыңыз келсе де
Dialogue: 0,0:00:52.84,0:00:57.59,Bottom,,0000,0000,0000,,'себебі бұл сіздің миыңызды браконьерлік етеді, мен Сэндиді тегін аламын.
Dialogue: 0,0:00:52.92,0:00:55.72,Top,,0000,0000,0000,,‎Сен шаршаған кезде де
Dialogue: 0,0:00:55.80,0:00:57.59,Top,,0000,0000,0000,,Мен оны тегін аламын
Dialogue: 0,0:00:57.68,0:01:00.06,Bottom,,0000,0000,0000,,Сонымен, жыртуға дайынсыз ба?
Dialogue: 0,0:00:57.68,0:01:00.06,Top,,0000,0000,0000,,Жақсы естіледі, солай ма?
Dialogue: 0,0:01:03.06,0:01:04.48,Top,,0000,0000,0000,,‎Уф, уф…
Dialogue: 0,0:01:04.56,0:01:06.85,Top,,0000,0000,0000,,‎Ууууууууууу...
Dialogue: 0,0:01:15.99,0:01:20.99,Top,,0000,0000,0000,,♪~
Dialogue: 0,0:02:39.11,0:02:44.12,Top,,0000,0000,0000,,~♪
Dialogue: 0,0:02:46.04,0:02:49.46,Top,,0000,0000,0000,,‎(AI мұғалімі) ‎ Лавабр ЕО тариф саясатын қалқан ретінде пайдаланды.
Dialogue: 0,0:02:46.04,0:02:52.21,Bottom,,0000,0000,0000,,Конвенцияда Лавабре Арасаканы көндіруге тырысты ...
Dialogue: 0,0:02:49.54,0:02:52.21,Top,,0000,0000,0000,,(АИ мұғалімі) Мен Арасакаға қысым көрсетуге тырыстым, бірақ...
Dialogue: 0,0:02:52.29,0:02:55.80,Bottom,,0000,0000,0000,,Мартинес, Дэвид. Сіздің кешігуіңіз тіркелді.
Dialogue: 0,0:02:52.29,0:02:55.80,Top,,0000,0000,0000,,Дэвид Мартинес, кешіріңіз, бірақ сіз кешігіп қаласыз.
Dialogue: 0,0:02:55.88,0:02:57.71,Bottom,,0000,0000,0000,,Мына жігітті жүктеп ал...
Dialogue: 0,0:02:55.88,0:02:57.71,Top,,0000,0000,0000,,‎(Кацуо Танака) Эй, мен сабақтамын.
Dialogue: 0,0:02:57.80,0:02:59.30,Top,,0000,0000,0000,,‎Ақыл-есі дұрыс... Гаха!
Dialogue: 0,0:02:57.80,0:02:59.72,Bottom,,0000,0000,0000,,Ол серио ма?
Dialogue: 0,0:03:00.38,0:03:01.72,Top,,0000,0000,0000,,Уф...
Dialogue: 0,0:03:01.80,0:03:03.89,Bottom,,0000,0000,0000,,Біз мектептеміз!
Dialogue: 0,0:03:01.80,0:03:05.47,Top,,0000,0000,0000,,Бұл мектеп! Бұл камера, ақымақ...
Dialogue: 0,0:03:03.97,0:03:05.97,Bottom,,0000,0000,0000,,Камералар бар. Сіз өзіңізді жоғалттыңыз ба...
Dialogue: 0,0:03:05.56,0:03:06.64,Top,,0000,0000,0000,,Уау!
Dialogue: 0,0:03:07.22,0:03:09.02,Bottom,,0000,0000,0000,,Ұсталып қалудан қорқасыз ба?
Dialogue: 0,0:03:07.22,0:03:09.02,Top,,0000,0000,0000,,Ол жазылады ма?
Dialogue: 0,0:03:09.10,0:03:11.10,Bottom,,0000,0000,0000,,Себебі мен олай емеспін.
Dialogue: 0,0:03:09.10,0:03:12.02,Top,,0000,0000,0000,,Оның маған қатысы жоқ, қараңыз.
Dialogue: 0,0:03:11.19,0:03:12.02,Bottom,,0000,0000,0000,,Келіңіздер.
Dialogue: 0,0:03:12.10,0:03:12.90,Top,,0000,0000,0000,,‎Пісіру…
Dialogue: 0,0:03:12.98,0:03:13.65,Top,,0000,0000,0000,,‎Ui
Dialogue: 0,0:03:12.98,0:03:14.15,Bottom,,0000,0000,0000,,Жақсы ма?
Dialogue: 0,0:03:18.48,0:03:19.28,Top,,0000,0000,0000,,‎(созылу)
Dialogue: 0,0:03:19.36,0:03:21.65,Top,,0000,0000,0000,,‎Howchochochocho…
Dialogue: 0,0:03:21.74,0:03:23.66,Top,,0000,0000,0000,,‎(Имплантты белсендіру дыбысы)
Dialogue: 0,0:03:24.28,0:03:25.53,Top,,0000,0000,0000,,‎чочочочочочо
Dialogue: 0,0:03:26.53,0:03:27.20,Top,,0000,0000,0000,,Чоп
Dialogue: 0,0:03:40.51,0:03:41.88,Top,,0000,0000,0000,,‎Howchochocho…
Dialogue: 0,0:03:44.22,0:03:46.30,Bottom,,0000,0000,0000,,Ой... Бұл ауырды...
Dialogue: 0,0:03:44.26,0:03:45.80,Top,,0000,0000,0000,,Міне!
Dialogue: 0,0:03:46.39,0:03:50.64,Bottom,,0000,0000,0000,,Ой... Не істедің?!
Dialogue: 0,0:03:46.47,0:03:49.18,Top,,0000,0000,0000,,‎Ол ауырады, ауырады, ауырады
Dialogue: 0,0:03:49.27,0:03:50.64,Top,,0000,0000,0000,,‎Не болды!
Dialogue: 0,0:03:50.73,0:03:54.15,Bottom,,0000,0000,0000,,Бұл импланттың қандай түрі? Сен менің мұрнымды сындырдың!
Dialogue: 0,0:03:50.73,0:03:54.15,Top,,0000,0000,0000,,‎Қандай хром салдыңыз? Мұрын сынған.
Dialogue: 0,0:03:54.73,0:03:56.40,Bottom,,0000,0000,0000,,Аяқтадыңыз!
Dialogue: 0,0:03:54.77,0:03:58.69,Top,,0000,0000,0000,,‎Сен үшін бітті. Қария Арасакада басшы болып жұмыс істейді.
Dialogue: 0,0:03:56.48,0:04:00.40,Bottom,,0000,0000,0000,,Менің әкем – Арасаканың қызметкері! Академияның тақтасында!
Dialogue: 0,0:03:58.78,0:04:02.95,Top,,0000,0000,0000,,‎Сен де академияның директорысың, сондықтан сені оқудан шығару маған оңай болар еді.
Dialogue: 0,0:04:00.49,0:04:04.57,Bottom,,0000,0000,0000,,Сізді оқудан шығару қаншалықты оңай болатынын білесіз бе?
Dialogue: 0,0:04:03.03,0:04:04.61,Top,,0000,0000,0000,,Егер сіз өз бетіңізше оқуды тастамасаңыз да, сіз оқуды тастауға мәжбүр боласыз ...
Dialogue: 0,0:04:04.66,0:04:06.82,Bottom,,0000,0000,0000,,Мен түк беретін сияқтымын.
Dialogue: 0,0:04:04.70,0:04:06.95,Top,,0000,0000,0000,,‎‎Сен нені білесің, бейбақ?
Dialogue: 0,0:04:11.96,0:04:13.62,Top,,0000,0000,0000,,‎Пух... пә!
Dialogue: 0,0:04:13.71,0:04:15.54,Top,,0000,0000,0000,,‎Хахахаха Ахахаха…
Dialogue: 0,0:04:15.63,0:04:17.42,Top,,0000,0000,0000,,(Импланттың белсендіру дыбысы) (Өту) Иә?
Dialogue: 0,0:04:23.22,0:04:24.05,Top,,0000,0000,0000,,‎Ха…
Dialogue: 0,0:04:31.52,0:04:33.18,Bottom,,0000,0000,0000,,Ол серио ма?
Dialogue: 0,0:04:31.64,0:04:33.31,Top,,0000,0000,0000,,‎Ақыл-есі дұрыс... Гаха!
Dialogue: 0,0:04:33.89,0:04:35.31,Top,,0000,0000,0000,,‎Howchochocho…
Dialogue: 0,0:04:35.40,0:04:36.31,Top,,0000,0000,0000,,Ға!
Dialogue: 0,0:04:36.40,0:04:38.94,Top,,0000,0000,0000,,Қария Арасакада басқарушы.
Dialogue: 0,0:04:36.40,0:04:40.57,Bottom,,0000,0000,0000,,Менің әкем – Арасаканың қызметкері! Академияның тақтасында!
Dialogue: 0,0:04:39.02,0:04:43.03,Top,,0000,0000,0000,,‎Сен де академияның директорысың, сондықтан сені оқудан шығару маған оңай болар еді.
Dialogue: 0,0:04:40.65,0:04:43.03,Bottom,,0000,0000,0000,,Сізді оқудан шығару қаншалықты оңай болатынын білесіз бе?
Dialogue: 0,0:04:43.11,0:04:45.61,Top,,0000,0000,0000,,‎(Holo Communication: Tanaka) ‎Маркус, айтыңызшы.
Dialogue: 0,0:04:43.61,0:04:50.54,Bottom,,0000,0000,0000,,Маркус, неге маған өз ұлымның зорлық-зомбылық көрсеткені түсірілген кадрлар көрсетіліп жатыр?
Dialogue: 0,0:04:45.70,0:04:50.58,Top,,0000,0000,0000,,‎Неге мен сізге ұлымды ұрып-соққаны туралы алаңдатарлық бейнені көрсетуім керек?
Dialogue: 0,0:04:50.62,0:04:55.42,Bottom,,0000,0000,0000,,Бұл студент Дэвид Мартинес, 17 жаста, Санто-Домингодан.
Dialogue: 0,0:04:50.66,0:04:53.79,Top,,0000,0000,0000,,(Маркус) Бұл студент Дэвид Мартинес, 17 жаста.
Dialogue: 0,0:04:53.87,0:04:55.50,Top,,0000,0000,0000,,Санто-Домингода дүниеге келген
Dialogue: 0,0:04:55.50,0:04:57.29,Bottom,,0000,0000,0000,,Ол академияның үздік студенті,
Dialogue: 0,0:04:55.58,0:04:57.25,Top,,0000,0000,0000,,Менің бағаларым өте жақсы, бірақ
Dialogue: 0,0:04:57.33,0:05:01.00,Top,,0000,0000,0000,,Келесі күні заңсыз құрылғы Академия жүйесін бұзды.
Dialogue: 0,0:04:57.38,0:05:01.00,Bottom,,0000,0000,0000,,, бірақ ол Академияның аппараттық құралдарын бүлдіретін жасырын гүл шоқтарын пайдаланып табылды.
Dialogue: 0,0:05:01.09,0:05:04.47,Bottom,,0000,0000,0000,,Әкесі жоқ, анасы жақында жол-көлік оқиғасынан қаза тапты.
Dialogue: 0,0:05:01.09,0:05:06.38,Top,,0000,0000,0000,,‎Оның әкесі жоқ, анасы апаттан қайтыс болды. Қазіргі уақытта оның үлкен көлемдегі қарызы бар...
Dialogue: 0,0:05:04.55,0:05:06.47,Bottom,,0000,0000,0000,,Оның үлкен қарызы бар...
Dialogue: 0,0:05:06.47,0:05:07.93,Top,,0000,0000,0000,,‎Мұның оған қандай қатысы бар?
Dialogue: 0,0:05:06.55,0:05:07.93,Bottom,,0000,0000,0000,,Мұның қаншалықты қатысы бар?
Dialogue: 0,0:05:08.01,0:05:10.18,Bottom,,0000,0000,0000,,Оның қимылдарына назар аударыңыз...
Dialogue: 0,0:05:08.01,0:05:10.22,Top,,0000,0000,0000,,(Маркус) Оның ерекше қимылдары
Dialogue: 0,0:05:10.26,0:05:14.93,Bottom,,0000,0000,0000,,Оның осы өлім кезінде Джеймс Норристе болған Сандевистаны бар.
Dialogue: 0,0:05:10.31,0:05:12.89,Top,,0000,0000,0000,,‎Бұл имплант бұрынғы лейтенант Джеймс Норриске тиесілі болды.
Dialogue: 0,0:05:12.97,0:05:14.93,Top,,0000,0000,0000,,‎Сан-Девистанда
Dialogue: 0,0:05:15.02,0:05:17.02,Top,,0000,0000,0000,,‎Киберпсихоз
Dialogue: 0,0:05:15.02,0:05:18.23,Bottom,,0000,0000,0000,,Киберпсихотикалық оқиға ретінде қозғалған іс.
Dialogue: 0,0:05:17.10,0:05:18.52,Top,,0000,0000,0000,,Бұл қарастырылған мәселе, солай ма?
Dialogue: 0,0:05:18.31,0:05:19.15,Bottom,,0000,0000,0000,,Иә, сэр.
Dialogue: 0,0:05:18.60,0:05:20.57,Top,,0000,0000,0000,,(Маркус) Иә, тіпті ардагер сарбаздар үшін де.
Dialogue: 0,0:05:19.23,0:05:24.57,Bottom,,0000,0000,0000,,Дегенмен, сарбаздан айырмашылығы, бұл студент импланттың жанама әсерлерін көрсетпейді.
Dialogue: 0,0:05:20.65,0:05:22.57,Top,,0000,0000,0000,,Мен шыдай алмадым, бұл имплант.
Dialogue: 0,0:05:22.65,0:05:24.69,Top,,0000,0000,0000,,‎Ол ешқандай жанама әсерлер көрсетпейді
Dialogue: 0,0:05:24.65,0:05:31.03,Bottom,,0000,0000,0000,,Оның кибернетикаға төзімділігі оны өнімді сынауға басты үміткер ете алады.
Dialogue: 0,0:05:24.78,0:05:27.20,Top,,0000,0000,0000,,Ерекше қарсылыққа ие болуы керек
Dialogue: 0,0:05:27.28,0:05:31.16,Top,,0000,0000,0000,,Өнімнің үлгісін қолданып көріңіз. Сіз жақсы қызметкер бола аласыз
Dialogue: 0,0:05:31.70,0:05:35.79,Top,,0000,0000,0000,,Мен түсінемін. Енді ол ше? (Маркус) Бірден шығарып жіберу.
Dialogue: 0,0:05:31.74,0:05:34.37,Bottom,,0000,0000,0000,,Мен көремін. Ал ол қазір қайда?
Dialogue: 0,0:05:34.45,0:05:35.75,Bottom,,0000,0000,0000,,Ол шығарылды, сэр.
Dialogue: 0,0:05:35.83,0:05:36.91,Bottom,,0000,0000,0000,,Оны шақыр.
Dialogue: 0,0:05:35.87,0:05:39.79,Top,,0000,0000,0000,,Оны қайтарыңыз. Сіз оның оқу ақысын қолдау үшін бәрін жасай аласыз.
Dialogue: 0,0:05:37.00,0:05:39.83,Bottom,,0000,0000,0000,,Қажет болса, оны қаржылық көмекке уәде беріп, азғырыңыз.
Dialogue: 0,0:05:39.88,0:05:41.96,Top,,0000,0000,0000,,‎(Маркус) ‎Ұлыңызға қатысты зорлық-зомбылық туралы не айтасыз?
Dialogue: 0,0:05:39.92,0:05:41.96,Bottom,,0000,0000,0000,,Ал сіздің ұлыңыз ше?
Dialogue: 0,0:05:42.05,0:05:45.84,Top,,0000,0000,0000,,‎«Компанияның мүдделері барлық мәселелерде басымдыққа ие».
Dialogue: 0,0:05:42.05,0:05:45.88,Bottom,,0000,0000,0000,,Менің мұрагерім ретінде оның үйренетін уақыты келді...
Dialogue: 0,0:05:45.92,0:05:48.97,Top,,0000,0000,0000,,Мен сенің не сұрап тұрғаныңды білемін.
Dialogue: 0,0:05:45.97,0:05:48.97,Bottom,,0000,0000,0000,,компанияның ең жақсы мүдделеріне қызмет ету дегеніміз не.
Dialogue: 0,0:05:50.14,0:05:52.81,Top,,0000,0000,0000,,‎(Голоколь қоңырау үні)
Dialogue: 0,0:05:52.89,0:05:54.31,Top,,0000,0000,0000,,(Басшы) Мартинес мырза
Dialogue: 0,0:05:54.39,0:05:58.35,Top,,0000,0000,0000,,‎Ережеге негізделген алып қою рәсімдері автоматты түрде жүзеге асырылды.
Dialogue: 0,0:05:58.44,0:05:59.98,Top,,0000,0000,0000,,- Танаканың ата-анасы...
Dialogue: 0,0:06:00.06,0:06:00.86,Top,,0000,0000,0000,,‎(байланысты ажырату дыбысы)
Dialogue: 0,0:06:03.07,0:06:06.36,Bottom,,0000,0000,0000,,Мен қатты ренжідім.
Dialogue: 0,0:06:03.23,0:06:05.78,Top,,0000,0000,0000,,‎Бітті~ Мен
Dialogue: 0,0:06:10.45,0:06:13.08,Top,,0000,0000,0000,,‎(Кір жуғыш машинаның жұмыс дыбысы) ‎Ха...
Dialogue: 0,0:06:13.70,0:06:16.12,Top,,0000,0000,0000,,‎(кір жуғыш машинаның соңындағы дыбыс)
Dialogue: 0,0:06:16.20,0:06:18.87,Bottom,,0000,0000,0000,,Жуу циклы аяқталды…
Dialogue: 0,0:06:16.20,0:06:18.87,Top,,0000,0000,0000,,‎(Кір жуғыш машина AI) ‎Кір жуу аяқталды Кір жуу...
Dialogue: 0,0:06:18.96,0:06:21.96,Top,,0000,0000,0000,,‎(Қорылдаған адам)
Dialogue: 0,0:06:48.32,0:06:49.24,Top,,0000,0000,0000,,‎Ха…
Dialogue: 0,0:06:55.54,0:06:57.25,Top,,0000,0000,0000,,‎(Бала) Әй, жүр!
Dialogue: 0,0:06:57.33,0:07:00.25,Top,,0000,0000,0000,,‎(Еркектер ентігу)
Dialogue: 0,0:07:00.33,0:07:03.00,Top,,0000,0000,0000,,‎(Полиция қызметкері) Менің қолымнан келмейді. Бұл аз айлық жалақы.
Dialogue: 0,0:07:10.51,0:07:11.13,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:39.20,0:07:40.37,Top,,0000,0000,0000,,‎(Люси) Иә?
Dialogue: 0,0:07:44.46,0:07:45.33,Top,,0000,0000,0000,,А...
Dialogue: 0,0:07:46.13,0:07:48.25,Top,,0000,0000,0000,,(Люси) Бір секундқа осында келіңіз, эй, эй...
Dialogue: 0,0:07:46.21,0:07:47.42,Bottom,,0000,0000,0000,,Өтірік, жеккөру, құлдырау—әр күнді лақтыру
Dialogue: 0,0:07:48.75,0:07:50.01,Bottom,,0000,0000,0000,,Сіздің проблемаңыз ба?
Dialogue: 0,0:07:48.75,0:07:50.09,Top,,0000,0000,0000,,Сіз нені айтып тұрсыз?
Dialogue: 0,0:07:50.09,0:07:51.01,Bottom,,0000,0000,0000,,Жер
Dialogue: 0,0:07:50.17,0:07:51.01,Top,,0000,0000,0000,,Не?
Dialogue: 0,0:07:51.09,0:07:53.30,Bottom,,0000,0000,0000,,Сіз менің жұмысыма араласып жатырсыз.
Dialogue: 0,0:07:51.09,0:07:53.34,Top,,0000,0000,0000,,Сіз менің жұмысыма кедергі келтірдіңіз.
Dialogue: 0,0:07:53.38,0:07:56.89,Bottom,,0000,0000,0000,,Жұмыс? Маған көбірек пиксокет сияқты көрінді.
Dialogue: 0,0:07:53.43,0:07:56.89,Top,,0000,0000,0000,,Жоқ, тыныш бол. Маған оны ұрлауға рұқсат беретін біреу бар ма?
Dialogue: 0,0:07:56.97,0:07:59.02,Bottom,,0000,0000,0000,,Сізде қандай да бір белгі бар ма?
Dialogue: 0,0:07:56.97,0:07:59.02,Top,,0000,0000,0000,,Сіз маған қарап тұрдыңыз.
Dialogue: 0,0:07:59.10,0:08:01.64,Bottom,,0000,0000,0000,,Ұсақ ұры екеніңізге сене алмаймын...
Dialogue: 0,0:07:59.10,0:08:01.64,Top,,0000,0000,0000,,Мен оны ұры болады деп ойламадым.
Dialogue: 0,0:08:02.27,0:08:03.31,Top,,0000,0000,0000,,Уф...
Dialogue: 0,0:08:03.98,0:08:06.15,Top,,0000,0000,0000,,‎(Люси) ‎Аа... біз бір жерде кездестік пе?
Dialogue: 0,0:08:04.69,0:08:06.11,Bottom,,0000,0000,0000,,Мен сізді танимын ба?
Dialogue: 0,0:08:06.19,0:08:07.94,Bottom,,0000,0000,0000,,Жоқ... шынымен емес. Тек...
Dialogue: 0,0:08:06.23,0:08:07.94,Top,,0000,0000,0000,,‎Жоқ, мүмкін бұл... бірінші рет.
Dialogue: 0,0:08:09.11,0:08:10.07,Top,,0000,0000,0000,,‎(Қатты!)
Dialogue: 0,0:08:10.15,0:08:11.36,Top,,0000,0000,0000,,‎(электрондық дыбыс)
Dialogue: 0,0:08:11.36,0:08:14.53,Bottom,,0000,0000,0000,,Ой, сен қиыншылыққа тап болдың.
Dialogue: 0,0:08:11.44,0:08:14.07,Top,,0000,0000,0000,,‎Аа, мен осындай нәрсені кидім.
Dialogue: 0,0:08:14.61,0:08:15.45,Bottom,,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:08:14.61,0:08:15.62,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:15.53,0:08:19.83,Bottom,,0000,0000,0000,,Шынымен бе? Сандевистан? Сондай-ақ дайын модель емес.
Dialogue: 0,0:08:15.70,0:08:19.83,Top,,0000,0000,0000,,Гаки - Сандевистан ба? Бұл да дайын өнім емес.
Dialogue: 0,0:08:19.91,0:08:23.66,Bottom,,0000,0000,0000,,Мен сені баспаймын. Бұл Түнгі қала ғой…
Dialogue: 0,0:08:19.91,0:08:23.75,Top,,0000,0000,0000,,Мен бұзбаймын. Бұл Түнгі қала, солай ма?
Dialogue: 0,0:08:23.75,0:08:26.58,Bottom,,0000,0000,0000,,Ақылсыз идея. Бірге жұмыс жасасақ қалай?
Dialogue: 0,0:08:23.83,0:08:26.33,Top,,0000,0000,0000,,‎Менің жұмысыма көмектескіңіз келе ме?
Dialogue: 0,0:08:26.67,0:08:27.88,Bottom,,0000,0000,0000,,Не, ұрлау?
Dialogue: 0,0:08:26.83,0:08:28.09,Top,,0000,0000,0000,,Ұры?
Dialogue: 0,0:08:27.96,0:08:30.84,Bottom,,0000,0000,0000,,Мен тек Арасака костюмдерінен ұрлаймын.
Dialogue: 0,0:08:28.17,0:08:30.84,Top,,0000,0000,0000,,(Люси) Мен тек Арасаканы нысанаға алып отырмын.
Dialogue: 0,0:08:30.92,0:08:33.72,Bottom,,0000,0000,0000,,Сонда мен ше? Мен саған корпомен қараймын ба?
Dialogue: 0,0:08:30.92,0:08:33.84,Top,,0000,0000,0000,,‎Сонымен мен Корпоға ұқсадым ба?
Dialogue: 0,0:08:33.80,0:08:37.22,Bottom,,0000,0000,0000,,Менің сканерлеуім Арасака академиясының жеке куәлігін алды.
Dialogue: 0,0:08:33.93,0:08:37.30,Top,,0000,0000,0000,,Сканерлеуден кейін Arasaka Academy идентификаторын тіркеу.
Dialogue: 0,0:08:37.30,0:08:41.39,Bottom,,0000,0000,0000,,Бірақ сіз дұрыс айтасыз, сіз түрге ұқсамайсыз.
Dialogue: 0,0:08:37.39,0:08:41.22,Top,,0000,0000,0000,,Менен сұрасаңыз, мен ефрейторға ұқсамаймын.
Dialogue: 0,0:08:41.31,0:08:43.98,Top,,0000,0000,0000,,Мен ол жерден кетіп қалдым.
Dialogue: 0,0:08:41.47,0:08:43.94,Bottom,,0000,0000,0000,,Мен оқуды тастадым.
Dialogue: 0,0:08:44.02,0:08:46.81,Bottom,,0000,0000,0000,,О? Жаман бала.
Dialogue: 0,0:08:44.06,0:08:46.56,Top,,0000,0000,0000,,‎Хмм, сен проблемалы баласың.
Dialogue: 0,0:08:47.40,0:08:49.61,Top,,0000,0000,0000,,Сіз тек Корпорацияны мақсат етіп отырсыз, солай ма?
Dialogue: 0,0:08:47.52,0:08:49.69,Bottom,,0000,0000,0000,,Бұл жай ғана «Сака сіз нысанаға алдыңыз ба?
Dialogue: 0,0:08:49.69,0:08:51.94,Top,,0000,0000,0000,,‎(Люси) Эй, мен борттамын.
Dialogue: 0,0:08:50.82,0:08:52.19,Bottom,,0000,0000,0000,,Сіз кіресіз бе?
Dialogue: 0,0:08:52.28,0:08:55.24,Bottom,,0000,0000,0000,,Бейшара анамның жүрегін жаралаймын, білесің бе.
Dialogue: 0,0:08:52.44,0:08:55.20,Top,,0000,0000,0000,,‎Сені ақылмен тәрбиелеген ата-анаңа алғыс айт
Dialogue: 0,0:08:55.28,0:08:56.24,Top,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:08:56.86,0:08:58.99,Bottom,,0000,0000,0000,,Бірінші сабақ.
Dialogue: 0,0:08:56.86,0:08:58.99,Top,,0000,0000,0000,,‎(Люси) Сіз шынымен олқылықтарға толысыз.
Dialogue: 0,0:08:59.08,0:09:01.33,Bottom,,0000,0000,0000,,Аз пайымдау, көп хабардарлық.
Dialogue: 0,0:08:59.08,0:09:01.41,Top,,0000,0000,0000,,Дәріс оқуға тұрарлық.
Dialogue: 0,0:09:01.41,0:09:03.50,Bottom,,0000,0000,0000,,Иә, иә. Сонымен, менің кесімім қандай?
Dialogue: 0,0:09:01.49,0:09:03.50,Top,,0000,0000,0000,,Сонда менің үлесім қандай?
Dialogue: 0,0:09:03.58,0:09:06.33,Bottom,,0000,0000,0000,,Біз жолды 80-20-ға бөлеміз.
Dialogue: 0,0:09:04.08,0:09:06.37,Top,,0000,0000,0000,,‎Мен 8-де, Сіз 2-десіз
Dialogue: 0,0:09:06.42,0:09:10.84,Bottom,,0000,0000,0000,,Білсін. Саған менің Сандестаным керек емес пе?
Dialogue: 0,0:09:06.46,0:09:08.17,Top,,0000,0000,0000,,Иә? Сен қалжыңдап тұрсың ба?
Dialogue: 0,0:09:08.25,0:09:10.84,Top,,0000,0000,0000,,Менің Sandevistan сенімді.
Dialogue: 0,0:09:10.92,0:09:13.09,Top,,0000,0000,0000,,Бұл жерде сіз ұрланған чиптерді өңдейсіз.
Dialogue: 0,0:09:10.92,0:09:13.34,Bottom,,0000,0000,0000,,Бірақ мен сынықтарды итеріп жатқан адаммын.
Dialogue: 0,0:09:13.42,0:09:15.88,Bottom,,0000,0000,0000,,Плюс, қазір менде бақылаушы стажер бар.
Dialogue: 0,0:09:13.63,0:09:15.63,Top,,0000,0000,0000,,‎Ал сіздің оқу ақысы бар.
Dialogue: 0,0:09:15.97,0:09:17.51,Bottom,,0000,0000,0000,,Стажер…?
Dialogue: 0,0:09:16.13,0:09:17.51,Top,,0000,0000,0000,,Оқу ақысы.
Dialogue: 0,0:09:17.59,0:09:21.39,Bottom,,0000,0000,0000,,Мен дәл қазір құйындыларға қатты батып отырмын. 60-40 жасай алмаймыз ба?
Dialogue: 0,0:09:17.59,0:09:21.39,Top,,0000,0000,0000,,Негізі маған да ақша керек. Тым болмаса 6:4-ке жеткізе алмаймыз ба?
Dialogue: 0,0:09:22.18,0:09:23.47,Top,,0000,0000,0000,,7:3
Dialogue: 0,0:09:22.18,0:09:26.73,Bottom,,0000,0000,0000,,70-30. Ал мен саған жұмыс біткен соң төлеймін.
Dialogue: 0,0:09:23.56,0:09:26.85,Top,,0000,0000,0000,,Жұмыс біткен соң өз үлесіңізді сол жерде төлеуге болады ма?
Dialogue: 0,0:09:28.27,0:09:29.44,Bottom,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:09:28.35,0:09:29.48,Top,,0000,0000,0000,,Түсінді
Dialogue: 0,0:09:29.52,0:09:30.65,Bottom,,0000,0000,0000,,Бұл мәміле.
Dialogue: 0,0:09:29.56,0:09:30.65,Top,,0000,0000,0000,,Шешілді.
Dialogue: 0,0:09:31.44,0:09:32.40,Top,,0000,0000,0000,,Люси
Dialogue: 0,0:09:31.48,0:09:32.40,Bottom,,0000,0000,0000,,Маған Люси қоңырау шалыңыз.
Dialogue: 0,0:09:34.03,0:09:35.28,Top,,0000,0000,0000,,Бұл Дэвид.
Dialogue: 0,0:09:34.07,0:09:35.28,Bottom,,0000,0000,0000,,Давид.
Dialogue: 0,0:09:37.99,0:09:39.95,Top,,0000,0000,0000,,‎(Holo Communication: David) ‎Қосылды. Сіз мені естисіз бе?
Dialogue: 0,0:09:40.03,0:09:41.03,Top,,0000,0000,0000,,(Люси) Мен сізді естимін.
Dialogue: 0,0:09:41.12,0:09:43.12,Top,,0000,0000,0000,,Мен де сізді естимін.
Dialogue: 0,0:09:43.20,0:09:44.29,Top,,0000,0000,0000,,Мақсат дегеніміз не?
Dialogue: 0,0:09:44.37,0:09:45.91,Top,,0000,0000,0000,,(Люси) 3 сағат бағыты
Dialogue: 0,0:09:46.54,0:09:49.17,Top,,0000,0000,0000,,Түсіндім (Люси) Мен кіріп кетейін.
Dialogue: 0,0:09:50.59,0:09:53.42,Top,,0000,0000,0000,,Жарайды, дайындал, жарай ма?
Dialogue: 0,0:09:53.50,0:09:56.92,Top,,0000,0000,0000,,‎3 2 1 Кеттік
Dialogue: 0,0:10:04.81,0:10:06.10,Top,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:10:06.60,0:10:09.40,Top,,0000,0000,0000,,‎(Люси) ‎Бұл бастауыш курс. Нағыз іс ары қарай басталады.
Dialogue: 0,0:10:09.48,0:10:10.40,Top,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:10:11.11,0:10:13.65,Top,,0000,0000,0000,,(Люси) Әңгімелесіп отырған кеңсе ханымы күзетілмейді.
Dialogue: 0,0:10:14.78,0:10:16.78,Top,,0000,0000,0000,,BD (Bee Dee) Ішіндегі дәмді үйрек
Dialogue: 0,0:10:17.32,0:10:20.78,Top,,0000,0000,0000,,‎‎Тым оңай ‎Оқулықпен жеткілікті
Dialogue: 0,0:10:21.28,0:10:24.45,Top,,0000,0000,0000,,(Люси) Жарайды, енді құбыжықтарды аулау уақыты келді.
Dialogue: 0,0:10:24.54,0:10:26.33,Top,,0000,0000,0000,,‎‎Әй... Уа!
Dialogue: 0,0:10:26.91,0:10:29.04,Top,,0000,0000,0000,,‎Уһ... бұл корпус емес, солай ма?
Dialogue: 0,0:10:29.12,0:10:32.17,Top,,0000,0000,0000,,(Люси) ‎Арасаканың оққағары 3 2...
Dialogue: 0,0:10:32.25,0:10:34.67,Top,,0000,0000,0000,,‎‎Е, чочочо... уф…
Dialogue: 0,0:10:40.97,0:10:44.60,Top,,0000,0000,0000,,(Люси) Бұлай етпе. Құбыжықты тазалаңыз. Мен келесі жолы түсемін.
Dialogue: 0,0:10:44.68,0:10:46.39,Top,,0000,0000,0000,,‎‎Ха… Түсінікті
Dialogue: 0,0:10:47.81,0:10:49.94,Bottom,,0000,0000,0000,,Сонымен? Мен қалай істедім?
Dialogue: 0,0:10:47.85,0:10:50.02,Top,,0000,0000,0000,,‎Қалай? Жақсы орындадың
Dialogue: 0,0:10:50.02,0:10:52.81,Bottom,,0000,0000,0000,,Мен сізді 20% төлеуге тұрарлық деп айтар едім.
Dialogue: 0,0:10:50.10,0:10:52.81,Top,,0000,0000,0000,,(Люси) Мен жұмыстың 20% орындадым деп ойлаймын.
Dialogue: 0,0:10:52.90,0:10:54.32,Bottom,,0000,0000,0000,,Бұл 30!
Dialogue: 0,0:10:52.90,0:10:55.73,Top,,0000,0000,0000,,Бұл 30%. (Люси) Хехе, әзілдеп жатырмын.
Dialogue: 0,0:10:54.40,0:10:55.82,Bottom,,0000,0000,0000,,Қалжың.
Dialogue: 0,0:10:56.69,0:10:58.32,Bottom,,0000,0000,0000,,Оны басқа көлікте айналдыра бересіз бе?
Dialogue: 0,0:10:56.69,0:10:58.32,Top,,0000,0000,0000,,‎Ауысып, қайта істегіңіз келе ме?
Dialogue: 0,0:10:58.40,0:11:02.62,Bottom,,0000,0000,0000,,Мүмкін басқа жол. Қазір біреу байқаған шығар.
Dialogue: 0,0:10:58.40,0:11:02.70,Top,,0000,0000,0000,,‎Мен маршрутты өзгертемін. Кейбіреулеріңіз байқағаныңызға сенімдімін. (Мұрыннан ағып жатқан қанның дыбысы)
Dialogue: 0,0:11:02.70,0:11:04.58,Bottom,,0000,0000,0000,,Біз тәуекелді барынша азайтуымыз керек...
Dialogue: 0,0:11:02.78,0:11:04.58,Top,,0000,0000,0000,,Ах... а... ‎Тәуекел ең аз...
Dialogue: 0,0:11:07.58,0:11:08.83,Bottom,,0000,0000,0000,,Қаншалықты жаман?
Dialogue: 0,0:11:07.62,0:11:10.54,Top,,0000,0000,0000,,‎(Люси) Не болып жатыр? (Төтенше жағдай қызметкері) Жаңадан бастағандар жиі не істейді
Dialogue: 0,0:11:08.91,0:11:10.50,Bottom,,0000,0000,0000,,Жаңа ойыншының қатесі.
Dialogue: 0,0:11:10.58,0:11:14.09,Bottom,,0000,0000,0000,,Имплантантты орнатқаннан бері ешқандай сақтық шараларын қолданбаған.
Dialogue: 0,0:11:10.62,0:11:14.09,Top,,0000,0000,0000,,Сіз қатты жүктелген имплантты тіпті үйренбей-ақ қолдандыңыз.
Dialogue: 0,0:11:14.17,0:11:16.05,Bottom,,0000,0000,0000,,Ол қандай иммуносупрессанттарды қолданады?
Dialogue: 0,0:11:14.17,0:11:16.05,Top,,0000,0000,0000,,‎(Фельдшер) Сіз қандай супрессорды қолданасыз?
Dialogue: 0,0:11:16.84,0:11:18.46,Bottom,,0000,0000,0000,,Ол сақтандырды ма?
Dialogue: 0,0:11:16.92,0:11:18.13,Top,,0000,0000,0000,,Оның сақтандыруы бар ма?
Dialogue: 0,0:11:18.55,0:11:21.84,Bottom,,0000,0000,0000,,Анықтама жоқ. Ол болмайтын сияқты.
Dialogue: 0,0:11:18.63,0:11:21.84,Top,,0000,0000,0000,,Мен білмеймін. Ол жерде жоқ сияқты.
Dialogue: 0,0:11:21.93,0:11:25.64,Bottom,,0000,0000,0000,,Кез келген отбасы немесе қамқоршы? Мен қоңырау шала алатын кез келген адам бар ма?
Dialogue: 0,0:11:21.93,0:11:25.72,Top,,0000,0000,0000,,‎(Фельдшер) Мен қоңырау шала алатын отбасы мүшесі бар ма? Төтенше жағдайда байланыс ақпараты
Dialogue: 0,0:11:25.72,0:11:28.85,Bottom,,0000,0000,0000,,Білмеймін. Ата-аналар, менің ойымша.
Dialogue: 0,0:11:25.81,0:11:27.26,Top,,0000,0000,0000,,‎(Люси) сондықтан мен білмеймін
Dialogue: 0,0:11:27.35,0:11:30.73,Top,,0000,0000,0000,,Ең болмаса ата-анаң бар емес пе? Ол академияның студенті болды.
Dialogue: 0,0:11:28.93,0:11:30.73,Bottom,,0000,0000,0000,,Ол Академияға баратын.
Dialogue: 0,0:11:30.81,0:11:33.77,Top,,0000,0000,0000,,‎(Фельдшер) ‎Арасака? Міне осылай...
Dialogue: 0,0:11:30.81,0:11:34.06,Bottom,,0000,0000,0000,,Арасака? Оның мұны көтере алатыны таңқаларлық емес.
Dialogue: 0,0:11:34.15,0:11:36.11,Bottom,,0000,0000,0000,,Күте тұрыңыз…
Dialogue: 0,0:11:34.31,0:11:35.48,Top,,0000,0000,0000,,Аздап кешіріңіз
Dialogue: 0,0:11:35.56,0:11:36.98,Top,,0000,0000,0000,,‎(орындықтың сықырлаған дыбысы)
Dialogue: 0,0:11:37.07,0:11:39.99,Bottom,,0000,0000,0000,,Сәлем. Қалай сезінесіз?
Dialogue: 0,0:11:37.07,0:11:40.11,Top,,0000,0000,0000,,Сіз қалай ойлайсыз? Қазіргі жағдай туралы ойларыңыз қандай?
Dialogue: 0,0:11:40.61,0:11:42.32,Bottom,,0000,0000,0000,,Мен ауырып қаламын...
Dialogue: 0,0:11:40.70,0:11:42.45,Top,,0000,0000,0000,,Жиренішті
Dialogue: 0,0:11:42.41,0:11:44.24,Bottom,,0000,0000,0000,,Қандай иммунодепрессант қабылдайсыз?
Dialogue: 0,0:11:42.53,0:11:46.12,Top,,0000,0000,0000,,‎(Люси) Сіз қандай басқышты қолданасыз? Бұл не?
Dialogue: 0,0:11:44.95,0:11:46.24,Bottom,,0000,0000,0000,,Иммуно... не?
Dialogue: 0,0:11:47.08,0:11:51.00,Top,,0000,0000,0000,,‎Хахахаха Бұл өтірік, солай ма? Мен жындымын
Dialogue: 0,0:11:48.33,0:11:49.75,Bottom,,0000,0000,0000,,Уау, жігіт...
Dialogue: 0,0:11:49.83,0:11:51.08,Bottom,,0000,0000,0000,,Сіз психикасыз.
Dialogue: 0,0:11:51.08,0:11:51.75,Top,,0000,0000,0000,,Хехе
Dialogue: 0,0:11:51.83,0:11:54.29,Top,,0000,0000,0000,,‎ (көліктің үдеу дыбысы)
Dialogue: 0,0:11:55.25,0:11:56.38,Top,,0000,0000,0000,,‎Жай ғана өтіп бара жатырмын...
Dialogue: 0,0:11:55.25,0:11:57.13,Bottom,,0000,0000,0000,,Эй, біз өттік…
Dialogue: 0,0:11:56.46,0:11:57.13,Top,,0000,0000,0000,,‎(Кача!)
Dialogue: 0,0:11:57.21,0:11:58.42,Bottom,,0000,0000,0000,,О, ау.
Dialogue: 0,0:11:57.21,0:11:58.50,Top,,0000,0000,0000,,‎(Люси) О...
Dialogue: 0,0:11:58.50,0:12:02.38,Bottom,,0000,0000,0000,,Тыңдаңдар, балада жақсы бағаға әкелетін имплант бар.
Dialogue: 0,0:11:58.59,0:12:02.38,Top,,0000,0000,0000,,‎Бұл баланың имплантаты өте қымбат.
Dialogue: 0,0:12:02.47,0:12:04.01,Bottom,,0000,0000,0000,,Жай отырыңыз, демалыңыз және...
Dialogue: 0,0:12:02.47,0:12:04.01,Top,,0000,0000,0000,,‎Егер сен үндемей, үндемесең...
Dialogue: 0,0:12:04.09,0:12:07.26,Bottom,,0000,0000,0000,,Не? Сіз Қоқысшылармен мәміле жасадыңыз ба?
Dialogue: 0,0:12:04.09,0:12:07.26,Top,,0000,0000,0000,,Не? Сіз оны қоқысшыға сатасыз ба?
Dialogue: 0,0:12:07.35,0:12:10.02,Bottom,,0000,0000,0000,,Отырыңыз, әйтпесе мен сіздің хромыңызды да аламын.
Dialogue: 0,0:12:07.35,0:12:10.02,Top,,0000,0000,0000,,‎Егер сізге ұнамаса, мен сіздің имплантатыңызды да аламын.
Dialogue: 0,0:12:10.10,0:12:11.56,Bottom,,0000,0000,0000,,Кешіріңіз, Дэвид.
Dialogue: 0,0:12:10.10,0:12:14.77,Top,,0000,0000,0000,,Дэвид ‎Мен 8-демін, ал сен 2-десің.
Dialogue: 0,0:12:11.64,0:12:14.77,Bottom,,0000,0000,0000,,Сіздің кесуіңіз 20-ға дейін азайған сияқты.
Dialogue: 0,0:12:14.85,0:12:16.40,Top,,0000,0000,0000,,‎Хмм... Иә? (Күлдір!)
Dialogue: 0,0:12:17.11,0:12:18.02,Top,,0000,0000,0000,,‎(2 адам) Уф...
Dialogue: 0,0:12:19.28,0:12:20.44,Top,,0000,0000,0000,,Ух... Уау!
Dialogue: 0,0:12:21.78,0:12:22.70,Top,,0000,0000,0000,,Фухун
Dialogue: 0,0:12:24.20,0:12:25.61,Top,,0000,0000,0000,,‎Мм!
Dialogue: 0,0:12:27.58,0:12:30.24,Top,,0000,0000,0000,,Уау! Хаха тамаша!
Dialogue: 0,0:12:29.33,0:12:30.87,Bottom,,0000,0000,0000,,Жер
Dialogue: 0,0:12:30.33,0:12:32.41,Top,,0000,0000,0000,,‎(Люси күлді)
Dialogue: 0,0:12:40.88,0:12:41.67,Top,,0000,0000,0000,,Фу
Dialogue: 0,0:12:48.60,0:12:50.26,Top,,0000,0000,0000,,Гугугу... (Люси) Иә?
Dialogue: 0,0:12:49.35,0:12:50.26,Bottom,,0000,0000,0000,,Ой.
Dialogue: 0,0:12:50.35,0:12:53.35,Top,,0000,0000,0000,,‎Эй, жақсысың ба?
Dialogue: 0,0:12:50.35,0:12:53.43,Bottom,,0000,0000,0000,,Әй, өліп жатқан жоқсың ба?
Dialogue: 0,0:12:53.43,0:12:54.94,Top,,0000,0000,0000,,Риппер
Dialogue: 0,0:12:53.52,0:12:54.77,Bottom,,0000,0000,0000,,Құжат…
Dialogue: 0,0:12:54.85,0:12:55.94,Bottom,,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:12:55.02,0:12:55.98,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:56.02,0:12:58.52,Bottom,,0000,0000,0000,,Дәрігерлік емхана… Өтінемін… қабылдаңыз…
Dialogue: 0,0:12:56.06,0:12:58.52,Top,,0000,0000,0000,,Мені Рипперге апарыңыз...
Dialogue: 0,0:12:58.61,0:13:00.27,Top,,0000,0000,0000,,‎(Люси) Ха~
Dialogue: 0,0:13:08.66,0:13:10.03,Bottom,,0000,0000,0000,,Дэвид, досым...
Dialogue: 0,0:13:08.74,0:13:12.87,Top,,0000,0000,0000,,‎(Липпардок) Эй Дэвид, бұл қорқынышты тәртіпсіздік. Сенімен бәрі жақсы ма?
Dialogue: 0,0:13:10.12,0:13:13.04,Bottom,,0000,0000,0000,,Сіз ақымақ сияқтысыз.
Dialogue: 0,0:13:13.12,0:13:14.21,Bottom,,0000,0000,0000,,Рахмет…
Dialogue: 0,0:13:13.37,0:13:14.62,Top,,0000,0000,0000,,‎Жоқ…
Dialogue: 0,0:13:14.71,0:13:17.04,Top,,0000,0000,0000,,‎(Reperdoc) ‎Хаха Сіз оны қанша рет қолдандыңыз?
Dialogue: 0,0:13:15.46,0:13:16.92,Bottom,,0000,0000,0000,,Сіз оны неше рет қолданасыз?
Dialogue: 0,0:13:17.00,0:13:19.29,Bottom,,0000,0000,0000,,Алты... Жоқ, сегіз?
Dialogue: 0,0:13:17.12,0:13:19.29,Top,,0000,0000,0000,,‎6…шамамен 8 рет?
Dialogue: 0,0:13:19.38,0:13:21.34,Bottom,,0000,0000,0000,,Иса Генри Христос!
Dialogue: 0,0:13:19.38,0:13:24.05,Top,,0000,0000,0000,,‎(Липпардок) Эй, эй, сен ақымақсың ба? Бұл тіпті ересектердің де есінен танғанының саны.
Dialogue: 0,0:13:21.42,0:13:24.13,Bottom,,0000,0000,0000,,Ересек адам бұл жазаны көтере алмады.
Dialogue: 0,0:13:24.13,0:13:28.43,Top,,0000,0000,0000,,Ештеңе болған жоқ, бірақ кенет мұрным қан бастады...
Dialogue: 0,0:13:24.22,0:13:26.22,Bottom,,0000,0000,0000,,Мен жақсы болдым...
Dialogue: 0,0:13:26.30,0:13:28.43,Bottom,,0000,0000,0000,,Бірақ содан кейін мұрным тығындап қалды.
Dialogue: 0,0:13:29.01,0:13:32.06,Top,,0000,0000,0000,,‎(Люси) Бұл жігіт ингибиторлар туралы білмейтін сияқты.
Dialogue: 0,0:13:29.01,0:13:32.18,Bottom,,0000,0000,0000,,Бұл гонк иммуносупрессанттар туралы білмеді.
Dialogue: 0,0:13:32.14,0:13:35.18,Top,,0000,0000,0000,,‎(Reperdoc) ‎О, бұл қажет емес деп ойлаймын.
Dialogue: 0,0:13:33.06,0:13:35.18,Bottom,,0000,0000,0000,,Қажеттілігін көрмедім.
Dialogue: 0,0:13:35.27,0:13:39.27,Bottom,,0000,0000,0000,,Әрине болмады. Тек оған дәрі сат.
Dialogue: 0,0:13:35.27,0:13:39.40,Top,,0000,0000,0000,,(Люси) Сіз таң қалдыңыз. Маған тезірек дәрі беріңізші.
Dialogue: 0,0:13:39.36,0:13:42.27,Bottom,,0000,0000,0000,,Сөредегі қоқыс оны кеспейді. Бұл сізге қымбатқа түседі.
Dialogue: 0,0:13:39.48,0:13:41.36,Top,,0000,0000,0000,,‎(Reperdoc) ‎Қарапайымдары жұмыс істемейді.
Dialogue: 0,0:13:41.44,0:13:43.65,Top,,0000,0000,0000,,Бұл сәл қымбат. Сізде қанша ақша бар?
Dialogue: 0,0:13:42.36,0:13:43.78,Bottom,,0000,0000,0000,,Сіз бұл үшін жақсысыз ба?
Dialogue: 0,0:13:43.86,0:13:45.53,Bottom,,0000,0000,0000,,Сіз мені зарядтайсыз ба?
Dialogue: 0,0:13:44.15,0:13:45.65,Top,,0000,0000,0000,,‎Ақша алғыңыз келе ме...
Dialogue: 0,0:13:45.61,0:13:49.78,Bottom,,0000,0000,0000,,Дұрыс айтамын! Қайырымдылықпен айналыспайды.
Dialogue: 0,0:13:45.74,0:13:49.37,Top,,0000,0000,0000,,‎(Lippardoc) Әрине, қызмет операция ақысын қамтиды.
Dialogue: 0,0:13:50.62,0:13:53.04,Top,,0000,0000,0000,,‎(Люси) Бұл туралы не айтасыз? (чипті орналастыру дыбысы)
Dialogue: 0,0:13:50.74,0:13:51.95,Bottom,,0000,0000,0000,,Бұларды қаншаға сатып аласыз?
Dialogue: 0,0:13:53.12,0:13:55.58,Top,,0000,0000,0000,,‎(Липпардок) Иә, бұл екі күннің құны. (Сөмкені түсіріп жатқан дыбыс)
Dialogue: 0,0:13:53.74,0:13:54.91,Bottom,,0000,0000,0000,,Екі күннің құны.
Dialogue: 0,0:13:56.21,0:13:57.46,Bottom,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:13:56.21,0:13:57.50,Top,,0000,0000,0000,,‎(Люси) Бәрі осы ма?
Dialogue: 0,0:13:57.54,0:13:59.33,Bottom,,0000,0000,0000,,Мұнда көптеген басқа жыртқыштар бар.
Dialogue: 0,0:13:57.58,0:13:59.42,Top,,0000,0000,0000,,‎(Липпардок) ‎Егер сізге ұнамаса, қаладағы дәрігерге барыңыз.
Dialogue: 0,0:13:59.42,0:14:02.88,Bottom,,0000,0000,0000,,Әрине, бұл сізді скавтармен бірге қайтаруы мүмкін.
Dialogue: 0,0:13:59.50,0:14:02.55,Top,,0000,0000,0000,,Мен енді қоқыс жинаушыларға сатылмаймын.
Dialogue: 0,0:14:02.63,0:14:03.59,Top,,0000,0000,0000,,‎Хахаха!
Dialogue: 0,0:14:04.00,0:14:05.97,Bottom,,0000,0000,0000,,Ашкөз бейбақ...
Dialogue: 0,0:14:04.09,0:14:05.97,Top,,0000,0000,0000,,‎Сен арсыз жыртқыш
Dialogue: 0,0:14:06.05,0:14:08.97,Top,,0000,0000,0000,,‎(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:14:09.26,0:14:11.97,Bottom,,0000,0000,0000,,Сіз шынымен оның кеткенін қаламайсыз ба?
Dialogue: 0,0:14:09.47,0:14:11.93,Top,,0000,0000,0000,,‎(Lippardoc) ‎Оны әлі жоюға ниетіңіз жоқ сияқты.
Dialogue: 0,0:14:12.01,0:14:13.31,Top,,0000,0000,0000,,№
Dialogue: 0,0:14:12.05,0:14:13.18,Bottom,,0000,0000,0000,,Ах, бұл – өзін өзгелерден бөліп тұратын сызық екен
Dialogue: 0,0:14:13.85,0:14:18.69,Bottom,,0000,0000,0000,,Әлі де сене алар емеспін... Бір күнде сегіз рет.
Dialogue: 0,0:14:13.97,0:14:16.68,Top,,0000,0000,0000,,‎(Reperdoc) Мен бұл затты күніне сегіз рет іске қостым.
Dialogue: 0,0:14:16.77,0:14:20.65,Top,,0000,0000,0000,,Сіздің жақсы екеніңізге сене алар емеспін. Сіз жай ғана сезімсізсіз бе?
Dialogue: 0,0:14:18.77,0:14:20.98,Bottom,,0000,0000,0000,,Сіз толық мазохистсіз немесе…
Dialogue: 0,0:14:21.06,0:14:26.61,Bottom,,0000,0000,0000,,Тыңдау. Оны күніне екі реттен артық қолданбаңыз. Үш максимум.
Dialogue: 0,0:14:21.27,0:14:23.02,Top,,0000,0000,0000,,‎Бірақ оны асыра пайдаланбаңыз
Dialogue: 0,0:14:23.11,0:14:26.69,Top,,0000,0000,0000,,‎Күніне екі реттен көп емес, күніне үш реттен көп.
Dialogue: 0,0:14:26.69,0:14:29.78,Bottom,,0000,0000,0000,,Денең көтерсе де, анауың көтере алмайды.
Dialogue: 0,0:14:26.78,0:14:29.86,Top,,0000,0000,0000,,‎Сенің денең қабылдаса да, ойың басқаша.
Dialogue: 0,0:14:29.86,0:14:34.24,Bottom,,0000,0000,0000,,Сіздің миыңыз шиеленісіп қалады.
Dialogue: 0,0:14:29.95,0:14:34.16,Top,,0000,0000,0000,,Бұл жігіт міндетті түрде сіздің рухыңызды жейді.
Dialogue: 0,0:14:35.37,0:14:38.58,Bottom,,0000,0000,0000,,Жалғыз имплант мені киберпсихо жасай алады ма?
Dialogue: 0,0:14:35.37,0:14:38.62,Top,,0000,0000,0000,,Кибер психозға айналу дегенді білдіреді ме?
Dialogue: 0,0:14:38.66,0:14:42.17,Bottom,,0000,0000,0000,,Бұрын мұндайды естімеппін.
Dialogue: 0,0:14:38.71,0:14:42.17,Top,,0000,0000,0000,,Бір имплант? Мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:14:42.25,0:14:43.50,Bottom,,0000,0000,0000,,Сізге көрсетеді…
Dialogue: 0,0:14:42.25,0:14:46.01,Top,,0000,0000,0000,,‎Бұл қаншалықты қауіпті.
Dialogue: 0,0:14:43.59,0:14:46.01,Bottom,,0000,0000,0000,,бұл нәрсе қаншалықты қауіпті.
Dialogue: 0,0:15:01.15,0:15:01.90,Top,,0000,0000,0000,,Фу
Dialogue: 0,0:15:03.81,0:15:05.02,Bottom,,0000,0000,0000,,Барлығы орындалды ма?
Dialogue: 0,0:15:03.90,0:15:05.11,Top,,0000,0000,0000,,Бұл жеткілікті ме?
Dialogue: 0,0:15:05.11,0:15:06.32,Bottom,,0000,0000,0000,,Оқу, оқу
Dialogue: 0,0:15:05.19,0:15:06.03,Top,,0000,0000,0000,,А
Dialogue: 0,0:15:06.40,0:15:08.86,Bottom,,0000,0000,0000,,Бұл бүгінгі күннің қортындысы.
Dialogue: 0,0:15:06.57,0:15:08.53,Top,,0000,0000,0000,,Бүгін жұмысты тоқтатайық.
Dialogue: 0,0:15:08.94,0:15:10.70,Bottom,,0000,0000,0000,,Мен жалғастыра аламын.
Dialogue: 0,0:15:09.03,0:15:10.70,Top,,0000,0000,0000,,Мен мұны істей аламын.
Dialogue: 0,0:15:10.78,0:15:11.95,Top,,0000,0000,0000,,№.
Dialogue: 0,0:15:10.78,0:15:15.03,Bottom,,0000,0000,0000,,Жоқ, мен киберпсихологқа бала күтпеймін.
Dialogue: 0,0:15:12.03,0:15:15.03,Top,,0000,0000,0000,,‎Киберпсихоға қамқорлық жасағаным үшін кешірім сұраймын.
Dialogue: 0,0:15:15.62,0:15:18.87,Bottom,,0000,0000,0000,,Sandevistan-ды шынымен қажет болғанда ғана пайдаланыңыз.
Dialogue: 0,0:15:15.62,0:15:18.87,Top,,0000,0000,0000,,‎Sandevistan тек төтенше жағдайда ғана қолданылуы керек.
Dialogue: 0,0:15:18.95,0:15:20.71,Top,,0000,0000,0000,,‎Оны орындаудың басқа жолдары бар.
Dialogue: 0,0:15:18.95,0:15:20.79,Bottom,,0000,0000,0000,,Редакцияларды шығарудың көптеген басқа жолдары.
Dialogue: 0,0:15:21.71,0:15:24.00,Bottom,,0000,0000,0000,,Осының бәрінен кейін де менімен жұмыс істеуге дайынсыз ба?
Dialogue: 0,0:15:21.79,0:15:24.13,Top,,0000,0000,0000,,‎Сіз әлі де менімен бірлескіңіз келеді...
Dialogue: 0,0:15:24.08,0:15:26.92,Bottom,,0000,0000,0000,,Мен сізге ақшаны қайтармай-ақ жіберемін деп ойлайсыз ба?
Dialogue: 0,0:15:24.21,0:15:26.88,Top,,0000,0000,0000,,Мен бүгін ақшамды қайтаруым керек.
Dialogue: 0,0:15:26.96,0:15:27.80,Top,,0000,0000,0000,,‎Ах~
Dialogue: 0,0:15:29.84,0:15:32.55,Bottom,,0000,0000,0000,,Жақсы, жақсы. Маған құйындылар керек.
Dialogue: 0,0:15:29.88,0:15:32.30,Top,,0000,0000,0000,,Менің де мұны істегім келеді, маған ақша керек.
Dialogue: 0,0:15:32.64,0:15:33.84,Bottom,,0000,0000,0000,,Бұл рух.
Dialogue: 0,0:15:32.80,0:15:33.93,Top,,0000,0000,0000,,‎(Люси) Бұл шешілді.
Dialogue: 0,0:15:35.47,0:15:37.72,Top,,0000,0000,0000,,‎‎Неге көбірек ақша таппайсыз?
Dialogue: 0,0:15:35.51,0:15:40.06,Bottom,,0000,0000,0000,,Сіз бүгін кешке дайын емессіз бе? Мен жалдаудан біраз кешігіп жатырмын.
Dialogue: 0,0:15:37.81,0:15:40.23,Top,,0000,0000,0000,,Менің үй иесі мені үйден қуып жібермекші.
Dialogue: 0,0:15:40.14,0:15:42.85,Bottom,,0000,0000,0000,,Бүгін жоқ. Сұрауды доғар.
Dialogue: 0,0:15:40.31,0:15:42.85,Top,,0000,0000,0000,,‎(Люси) ‎Енді бүгін болмайды, берілме.
Dialogue: 0,0:15:43.40,0:15:44.86,Top,,0000,0000,0000,,‎
Dialogue: 0,0:15:43.52,0:15:44.90,Bottom,,0000,0000,0000,,Жарайды...
Dialogue: 0,0:15:48.44,0:15:49.44,Bottom,,0000,0000,0000,,Өтірік, жеккөру, құлдырау—әр күнді лақтыру
Dialogue: 0,0:15:48.57,0:15:49.44,Top,,0000,0000,0000,,‎(Люси) кел
Dialogue: 0,0:15:49.53,0:15:51.45,Bottom,,0000,0000,0000,,Мен сенің қалайтыныңды білдім!
Dialogue: 0,0:15:49.53,0:15:51.45,Top,,0000,0000,0000,,‎Ой, солай!
Dialogue: 0,0:15:51.53,0:15:53.28,Bottom,,0000,0000,0000,,Жұмысқа қатысы жоқ.
Dialogue: 0,0:15:51.53,0:15:54.53,Top,,0000,0000,0000,,(Люси) Бұл жұмыс емес. иә?
Dialogue: 0,0:15:53.91,0:15:54.87,Bottom,,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:15:56.49,0:15:57.49,Bottom,,0000,0000,0000,,Дәл осы жерде.
Dialogue: 0,0:15:56.58,0:16:00.20,Top,,0000,0000,0000,,‎(Люси) Мұнда. Әм... жалғыз ба?
Dialogue: 0,0:15:57.58,0:16:00.20,Bottom,,0000,0000,0000,,Сіз жалғыз тұрасыз ба?
Dialogue: 0,0:16:00.29,0:16:01.37,Bottom,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:00.29,0:16:02.96,Top,,0000,0000,0000,,(Люси) Иә, бірақ хмм.
Dialogue: 0,0:16:02.12,0:16:02.96,Bottom,,0000,0000,0000,,Иә.
Dialogue: 0,0:16:04.42,0:16:06.13,Top,,0000,0000,0000,,Сіз қобалжыған шығарсыз?
Dialogue: 0,0:16:04.50,0:16:06.17,Bottom,,0000,0000,0000,,Тоқта, қобалжыдың ба?
Dialogue: 0,0:16:06.21,0:16:07.04,Top,,0000,0000,0000,,№
Dialogue: 0,0:16:06.25,0:16:07.09,Bottom,,0000,0000,0000,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:16:07.63,0:16:08.75,Bottom,,0000,0000,0000,,Сіз бірінші ретсіз бе?
Dialogue: 0,0:16:07.63,0:16:08.80,Top,,0000,0000,0000,,Бірінші рет?
Dialogue: 0,0:16:08.84,0:16:09.76,Bottom,,0000,0000,0000,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:16:08.88,0:16:09.67,Top,,0000,0000,0000,,№
Dialogue: 0,0:16:10.17,0:16:11.22,Top,,0000,0000,0000,,‎Hehehehe
Dialogue: 0,0:16:11.26,0:16:12.47,Bottom,,0000,0000,0000,,Ей, кет!
Dialogue: 0,0:16:11.30,0:16:12.47,Top,,0000,0000,0000,,Мен болмады!
Dialogue: 0,0:16:13.26,0:16:14.22,Bottom,,0000,0000,0000,,Орынға отырыңыз.
Dialogue: 0,0:16:13.30,0:16:17.05,Top,,0000,0000,0000,,(Люси) отыршы, менде сыра ғана, сондықтан сыра.
Dialogue: 0,0:16:15.01,0:16:16.89,Bottom,,0000,0000,0000,,Мен тек сыра алдым. Сіз ішесіз бе?
Dialogue: 0,0:16:16.97,0:16:18.47,Bottom,,0000,0000,0000,,Иә.
Dialogue: 0,0:16:17.14,0:16:19.60,Top,,0000,0000,0000,,А... иә, Сәлеметсіз бе
Dialogue: 0,0:16:18.56,0:16:19.72,Bottom,,0000,0000,0000,,Сәлеметсіз бе.
Dialogue: 0,0:16:22.31,0:16:25.27,Top,,0000,0000,0000,,‎(ырылдаған дыбыс)
Dialogue: 0,0:16:25.35,0:16:26.02,Top,,0000,0000,0000,,Уф...
Dialogue: 0,0:16:26.11,0:16:28.23,Top,,0000,0000,0000,,‎(жөтел) ‎(Люси) Эй.
Dialogue: 0,0:16:28.32,0:16:31.49,Top,,0000,0000,0000,,Не? Алкогольді бірінші рет ішіп отырсыз ба?
Dialogue: 0,0:16:28.32,0:16:31.86,Bottom,,0000,0000,0000,,Шынайы ма? Сіз бұрын ешқашан мас болған жоқсыз ба?
Dialogue: 0,0:16:31.94,0:16:33.99,Bottom,,0000,0000,0000,,Жоқ, менде. Бұл жай ғана…
Dialogue: 0,0:16:32.03,0:16:34.86,Top,,0000,0000,0000,,Ішімдік ішу жақсы, бірақ (Люси) Хмм?
Dialogue: 0,0:16:34.86,0:16:37.24,Bottom,,0000,0000,0000,,Мен газдалған сусындар мен темекі шегуді ұнатпаймын.
Dialogue: 0,0:16:34.95,0:16:37.32,Top,,0000,0000,0000,,Мен көмір қышқылы мен темекіні ұнатпаймын.
Dialogue: 0,0:16:37.41,0:16:39.74,Top,,0000,0000,0000,,Иә? Ондай адам бар ма?
Dialogue: 0,0:16:37.87,0:16:39.91,Bottom,,0000,0000,0000,,Ондай адамдар шынымен бар ма?
Dialogue: 0,0:16:39.83,0:16:41.25,Top,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:16:39.99,0:16:41.25,Bottom,,0000,0000,0000,,Мен өтірік айтпаймын.
Dialogue: 0,0:16:41.33,0:16:44.12,Top,,0000,0000,0000,,(Люси) Киімдерің де ақсақ.
Dialogue: 0,0:16:41.33,0:16:44.16,Bottom,,0000,0000,0000,,Әрине, олай емессіз. Ал бұл көтеріліс не болды?
Dialogue: 0,0:16:46.00,0:16:47.75,Top,,0000,0000,0000,,‎(аяқ дыбысы)
Dialogue: 0,0:16:47.79,0:16:48.67,Bottom,,0000,0000,0000,,Оны шешіп алыңыз.
Dialogue: 0,0:16:47.84,0:16:50.25,Top,,0000,0000,0000,,(Люси) Оны шешіп тасташы, неге?
Dialogue: 0,0:16:48.75,0:16:50.21,Bottom,,0000,0000,0000,,Не? Неліктен?
Dialogue: 0,0:16:50.30,0:16:52.21,Bottom,,0000,0000,0000,,Тек орындаңыз. Кәне.
Dialogue: 0,0:16:50.34,0:16:53.13,Top,,0000,0000,0000,,‎(Люси) Маған қарызға берші. Әй... Эй.
Dialogue: 0,0:16:52.30,0:16:53.13,Bottom,,0000,0000,0000,,Аякаши оны кесіп өте алмайды
Dialogue: 0,0:16:53.22,0:16:55.01,Top,,0000,0000,0000,,‎(операция дыбысы)
Dialogue: 0,0:16:55.09,0:16:57.01,Top,,0000,0000,0000,,А...
Dialogue: 0,0:16:57.09,0:16:58.68,Top,,0000,0000,0000,,Рұқсатсыз сурет салмаңыз
Dialogue: 0,0:16:57.09,0:16:58.85,Bottom,,0000,0000,0000,,Бұған араласпа...
Dialogue: 0,0:16:59.39,0:17:00.01,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:01.06,0:17:02.68,Bottom,,0000,0000,0000,,Эдгеруннер?
Dialogue: 0,0:17:01.06,0:17:02.77,Top,,0000,0000,0000,,Шеттен жүгірушілер?
Dialogue: 0,0:17:02.77,0:17:05.14,Bottom,,0000,0000,0000,,Бұл киберпанк үшін басқа сөз.
Dialogue: 0,0:17:02.85,0:17:05.23,Top,,0000,0000,0000,,Киберпанктың басқа атауы
Dialogue: 0,0:17:05.23,0:17:07.02,Bottom,,0000,0000,0000,,Сіз кім болғыңыз келеді, солай ма?
Dialogue: 0,0:17:05.31,0:17:07.02,Top,,0000,0000,0000,,Сіз жақсы боласыз, солай ма?
Dialogue: 0,0:17:07.10,0:17:11.03,Top,,0000,0000,0000,,Я, мен JK's Edge Runners фильмін көп көрдім.
Dialogue: 0,0:17:08.27,0:17:11.03,Bottom,,0000,0000,0000,,Мен шын мәнінде JK-тің "EDGERUNNERS" сериясының жанкүйерімін.
Dialogue: 0,0:17:11.11,0:17:13.28,Top,,0000,0000,0000,,‎Hehehe? Солай ма?
Dialogue: 0,0:17:12.23,0:17:13.28,Bottom,,0000,0000,0000,,Сіз байсалдысыз ба?
Dialogue: 0,0:17:13.36,0:17:18.66,Top,,0000,0000,0000,,Иә, солай. Бөлмеңізге сол ақсақ плакатты ілгіңіз келе ме?
Dialogue: 0,0:17:14.61,0:17:15.78,Bottom,,0000,0000,0000,,Кім сөйлеп тұрғанын қараңыз.
Dialogue: 0,0:17:15.86,0:17:18.66,Bottom,,0000,0000,0000,,Мына жабысқақ плакатқа не болды?
Dialogue: 0,0:17:20.20,0:17:21.16,Bottom,,0000,0000,0000,,Бәрі жақсы... емес пе?
Dialogue: 0,0:17:20.41,0:17:21.16,Top,,0000,0000,0000,,Нашар ма?
Dialogue: 0,0:17:21.24,0:17:25.04,Bottom,,0000,0000,0000,,А... проблема жоқ.
Dialogue: 0,0:17:21.24,0:17:25.04,Top,,0000,0000,0000,,‎‎Е... А, жоқ, бұл жаман емес.
Dialogue: 0,0:17:25.66,0:17:29.92,Bottom,,0000,0000,0000,,Бұл жарнамалар оны жұмақ сияқты етіп көрсететіні мені әрқашан таң қалдырды.
Dialogue: 0,0:17:25.71,0:17:29.63,Top,,0000,0000,0000,,Олар оны жер бетіндегі жұмақ деп жиі жарнамалайды.
Dialogue: 0,0:17:30.00,0:17:33.42,Bottom,,0000,0000,0000,,Менің айтайын дегенім, сол мылқау тасты пайдалы нәрсеге айналдыруға тырысқанда талай қаракөз өлді.
Dialogue: 0,0:17:30.17,0:17:33.42,Top,,0000,0000,0000,,Айдың дамуы үшін қанша адам өлгенін білесіз бе?
Dialogue: 0,0:17:34.01,0:17:36.05,Bottom,,0000,0000,0000,,Жұмақтан гөрі түрме сияқты естіледі.
Dialogue: 0,0:17:34.01,0:17:36.05,Top,,0000,0000,0000,,Бұл жұмақтан гөрі тозаққа ұқсайды.
Dialogue: 0,0:17:37.18,0:17:38.80,Bottom,,0000,0000,0000,,Біреу үй тапсырмасын орындаған сияқты.
Dialogue: 0,0:17:37.26,0:17:38.72,Top,,0000,0000,0000,,‎(Люси) Сіз көп нәрсені білесіз.
Dialogue: 0,0:17:40.01,0:17:43.97,Bottom,,0000,0000,0000,,Академия сізге жарнамада көрсетілмейтін нәрселерді үйретеді.
Dialogue: 0,0:17:40.10,0:17:41.22,Top,,0000,0000,0000,,Академия
Dialogue: 0,0:17:41.31,0:17:44.06,Top,,0000,0000,0000,,‎Олар жарнамада айтылмайтын нәрселерді біле аласыз.
Dialogue: 0,0:17:44.06,0:17:47.02,Bottom,,0000,0000,0000,,Академияның дайын баласынан күткендей.
Dialogue: 0,0:17:44.14,0:17:47.14,Top,,0000,0000,0000,,(Люси) Арасака академиясының монахы күткендей
Dialogue: 0,0:17:47.64,0:17:49.44,Bottom,,0000,0000,0000,,Бұл олай емес.
Dialogue: 0,0:17:47.69,0:17:49.19,Top,,0000,0000,0000,,Бұл олай емес.
Dialogue: 0,0:17:49.52,0:17:52.32,Bottom,,0000,0000,0000,,солай емес пе? Ешқашан сақ мектебіне барғанды ​​ұстамадым.
Dialogue: 0,0:17:49.69,0:17:52.32,Top,,0000,0000,0000,,(Люси) Монах ретінде мен үшін мектепке бару жеткілікті.
Dialogue: 0,0:17:52.40,0:17:53.53,Bottom,,0000,0000,0000,,Бұл емес!
Dialogue: 0,0:17:52.40,0:17:53.53,Top,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:17:56.15,0:17:56.95,Top,,0000,0000,0000,,‎Пухач
Dialogue: 0,0:17:57.36,0:18:00.45,Bottom,,0000,0000,0000,,Анам екеуміздің жағдайымыз жақсы болмады.
Dialogue: 0,0:17:57.49,0:18:00.53,Top,,0000,0000,0000,,‎Әкем екеумізде ақша жоқ.
Dialogue: 0,0:18:00.53,0:18:03.33,Bottom,,0000,0000,0000,,Академия әдетте мені қабылдамас еді.
Dialogue: 0,0:18:00.62,0:18:03.33,Top,,0000,0000,0000,,Академия сіз бара алатындай үй емес еді.
Dialogue: 0,0:18:04.08,0:18:08.71,Bottom,,0000,0000,0000,,Бірақ анам мені үйде ұстау үшін көп жұмыс істеуге мәжбүр болды.
Dialogue: 0,0:18:04.20,0:18:05.29,Top,,0000,0000,0000,,Бірақ менің анам
Dialogue: 0,0:18:05.37,0:18:08.83,Top,,0000,0000,0000,,Сіз менің академияға барғым келеді, сіз өзіңізді соған мәжбүрлейсіз ...
Dialogue: 0,0:18:09.37,0:18:14.09,Bottom,,0000,0000,0000,,Сіз соққыны білгіңіз келе ме? Мен ешқашан тиесілі болмайтынымды бірінші күннен білдім.
Dialogue: 0,0:18:09.42,0:18:11.46,Top,,0000,0000,0000,,‎Бірақ мен барған бойда білдім.
Dialogue: 0,0:18:11.54,0:18:14.09,Top,,0000,0000,0000,,Менің бұл жігіттермен араласуым мүмкін емес.
Dialogue: 0,0:18:14.17,0:18:17.55,Bottom,,0000,0000,0000,,Олай болса, неге сонша уақыт бойы тұрып қалдың?
Dialogue: 0,0:18:14.17,0:18:17.55,Top,,0000,0000,0000,,(Люси) Білгенде, неге бірден тастамадың?
Dialogue: 0,0:18:17.63,0:18:18.97,Top,,0000,0000,0000,,Бұл мүмкін емес, солай ма?
Dialogue: 0,0:18:17.63,0:18:22.55,Bottom,,0000,0000,0000,,Жақсы сұрақ. Анам менің сақтық жұмысты алуымды қалағандықтан деп ойлаймын.
Dialogue: 0,0:18:19.05,0:18:22.51,Top,,0000,0000,0000,,Академияға барыңыз, Арасакада жұмысқа орналасыңыз
Dialogue: 0,0:18:22.60,0:18:24.47,Top,,0000,0000,0000,,‎Биік жерлерде жұмыс істеу...
Dialogue: 0,0:18:22.64,0:18:24.47,Bottom,,0000,0000,0000,,корпоративтік баспалдақпен көтерілу…
Dialogue: 0,0:18:24.56,0:18:27.60,Top,,0000,0000,0000,,Сенің анаң осыны қалайды ма?
Dialogue: 0,0:18:24.56,0:18:29.56,Bottom,,0000,0000,0000,,Бұл оның тілегі еді... Немесе арман, меніңше.
Dialogue: 0,0:18:28.19,0:18:30.65,Top,,0000,0000,0000,,Өйткені бұл арман...
Dialogue: 0,0:18:29.65,0:18:31.36,Bottom,,0000,0000,0000,,Сондықтан.
Dialogue: 0,0:18:32.31,0:18:34.36,Top,,0000,0000,0000,,Бұл басқа біреудің арманы.
Dialogue: 0,0:18:32.31,0:18:34.82,Bottom,,0000,0000,0000,,Бұл сіздің арманыңыз емес.
Dialogue: 0,0:18:34.90,0:18:35.73,Bottom,,0000,0000,0000,,Менің арманым емес пе?
Dialogue: 0,0:18:35.03,0:18:35.73,Top,,0000,0000,0000,,Басқа адамдар?
Dialogue: 0,0:18:36.32,0:18:38.99,Bottom,,0000,0000,0000,,Иә, иә. Анаң екеуің екі бөлек адамсыңдар.
Dialogue: 0,0:18:36.32,0:18:39.07,Top,,0000,0000,0000,,(Люси) Ата-аналар мен балалар әртүрлі адамдар, солай емес пе?
Dialogue: 0,0:18:39.91,0:18:42.32,Bottom,,0000,0000,0000,,Неліктен оның арманы үшін жұмыс істеу керек?
Dialogue: 0,0:18:39.99,0:18:42.41,Top,,0000,0000,0000,,Сіз біреудің арманы үшін өмір сүресіз бе?
Dialogue: 0,0:18:43.16,0:18:45.74,Bottom,,0000,0000,0000,,Бұл жерде ештеңе жоқ.
Dialogue: 0,0:18:43.16,0:18:45.74,Top,,0000,0000,0000,,‎Бұл жаман нәрсе ме?
Dialogue: 0,0:18:45.83,0:18:48.12,Bottom,,0000,0000,0000,,Өз арманыңды табу керек.
Dialogue: 0,0:18:45.83,0:18:48.62,Top,,0000,0000,0000,,‎(Люси) ‎Армандар басқаларға тиесілі емес.
Dialogue: 0,0:18:48.66,0:18:51.50,Bottom,,0000,0000,0000,,Сіз өзіңізді тапқан сияқтысыз.
Dialogue: 0,0:18:48.71,0:18:51.50,Top,,0000,0000,0000,,‎Сен арманым бар дейсің.
Dialogue: 0,0:18:53.38,0:18:54.50,Bottom,,0000,0000,0000,,Сіз қалжыңдап тұрсыз.
Dialogue: 0,0:18:53.46,0:18:54.50,Top,,0000,0000,0000,,Сіз байсалдысыз ба?
Dialogue: 0,0:18:54.59,0:18:57.13,Top,,0000,0000,0000,,(Люси) Сенің тозақтасың дейді.
Dialogue: 0,0:18:54.59,0:18:59.80,Bottom,,0000,0000,0000,,Сіз оны түрме деп атадыңыз, бірақ мен үшін бұл қала әлдеқайда нашар.
Dialogue: 0,0:18:57.63,0:18:59.68,Top,,0000,0000,0000,,‎Бұл мен үшін тозақ
Dialogue: 0,0:19:00.43,0:19:01.59,Bottom,,0000,0000,0000,,Мұнда?
Dialogue: 0,0:19:00.55,0:19:01.80,Top,,0000,0000,0000,,Бұл жер?
Dialogue: 0,0:19:02.30,0:19:04.76,Top,,0000,0000,0000,,(Люси) Мен алыс жерге барғым келеді.
Dialogue: 0,0:19:02.34,0:19:04.76,Bottom,,0000,0000,0000,,Мен мүмкіндігінше алысқа кеткім келеді.
Dialogue: 0,0:19:08.02,0:19:09.18,Top,,0000,0000,0000,,Мен саған жақсы нәрсе көрсетемін
Dialogue: 0,0:19:08.02,0:19:09.48,Bottom,,0000,0000,0000,,Сізге бірдеңе көрсетейін.
Dialogue: 0,0:19:09.27,0:19:09.89,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:24.91,0:19:27.66,Bottom,,0000,0000,0000,,Ой! Бұл туралы шешімді тексеріңіз!
Dialogue: 0,0:19:24.91,0:19:27.66,Top,,0000,0000,0000,,‎Уау, керемет ажыратымдылық
Dialogue: 0,0:19:27.74,0:19:29.66,Bottom,,0000,0000,0000,,Мен күнді сезінемін!
Dialogue: 0,0:19:27.74,0:19:29.79,Top,,0000,0000,0000,,‎Күн ыстық!
Dialogue: 0,0:19:29.75,0:19:33.67,Bottom,,0000,0000,0000,,Ол күннің жылуын сезіну үшін жеке сілтеме арқылы қосылады.
Dialogue: 0,0:19:29.87,0:19:33.67,Top,,0000,0000,0000,,‎Жеке сілтеме арқылы Күннің жылуын сезіндіреді
Dialogue: 0,0:19:33.75,0:19:36.92,Bottom,,0000,0000,0000,,Әрине, егер бұл нақты температура болса, сіз қытырлақ күйіп кетер едіңіз,
Dialogue: 0,0:19:33.75,0:19:36.92,Top,,0000,0000,0000,,‎Реалистік жағдайда бұл тым ыстық және қауіпті.
Dialogue: 0,0:19:37.00,0:19:40.09,Top,,0000,0000,0000,,‎Мен оны адамдар сезінуі мүмкін болғанша сақтаймын.
Dialogue: 0,0:19:37.00,0:19:40.42,Bottom,,0000,0000,0000,,сондықтан мен оны түзетуге тырыстым.
Dialogue: 0,0:19:41.30,0:19:42.30,Bottom,,0000,0000,0000,,Оны қайта өзгертуімді қалайсыз ба?
Dialogue: 0,0:19:41.43,0:19:42.30,Top,,0000,0000,0000,,Оны өшіру керек пе?
Dialogue: 0,0:19:42.38,0:19:44.30,Bottom,,0000,0000,0000,,Жоқ, бұл қызық!
Dialogue: 0,0:19:42.38,0:19:44.30,Top,,0000,0000,0000,,‎Бұл жақсы, себебі бұл қызықты
Dialogue: 0,0:19:44.39,0:19:46.81,Top,,0000,0000,0000,,‎Ахаха қандай көрінеді
Dialogue: 0,0:19:45.55,0:19:46.81,Bottom,,0000,0000,0000,,Сіз күлкілі көрінесіз!
Dialogue: 0,0:19:46.89,0:19:48.77,Top,,0000,0000,0000,,Ио хаха
Dialogue: 0,0:19:49.35,0:19:51.39,Top,,0000,0000,0000,,‎Ух хахаха ой
Dialogue: 0,0:19:53.40,0:19:54.52,Bottom,,0000,0000,0000,,Өте керемет, иә?
Dialogue: 0,0:19:53.48,0:19:56.23,Top,,0000,0000,0000,,‎(Люси) Жарайсың ба? Бұл ең жақсысы!
Dialogue: 0,0:19:54.61,0:19:56.23,Bottom,,0000,0000,0000,,Бұл керемет!
Dialogue: 0,0:19:56.32,0:19:57.36,Bottom,,0000,0000,0000,,солай емес пе?
Dialogue: 0,0:19:56.32,0:19:59.19,Top,,0000,0000,0000,,(Люси), солай ма? Ахаха хаха
Dialogue: 0,0:19:59.69,0:20:00.82,Bottom,,0000,0000,0000,,Мұнда.
Dialogue: 0,0:19:59.74,0:20:00.82,Top,,0000,0000,0000,,Мұнда келіңіз
Dialogue: 0,0:20:13.46,0:20:14.08,Top,,0000,0000,0000,,А...
Dialogue: 0,0:20:20.51,0:20:21.92,Top,,0000,0000,0000,,О, уау!
Dialogue: 0,0:20:26.26,0:20:28.72,Top,,0000,0000,0000,,‎(Люси) Хэхехехе ‎Хехехехе
Dialogue: 0,0:20:33.81,0:20:35.85,Top,,0000,0000,0000,,‎(қозғалтқыш дыбысы)
Dialogue: 0,0:20:39.19,0:20:40.44,Top,,0000,0000,0000,,‎(Люси) Хэхехехе
Dialogue: 0,0:20:41.74,0:20:43.40,Top,,0000,0000,0000,,‎Hehehehehe
Dialogue: 0,0:21:13.18,0:21:15.02,Top,,0000,0000,0000,,‎(жөтел)
Dialogue: 0,0:21:17.40,0:21:18.15,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:18.23,0:21:21.15,Top,,0000,0000,0000,,‎(Люси) Фуфуфу Ахахха ‎Хмф!
Dialogue: 0,0:21:28.62,0:21:31.33,Bottom,,0000,0000,0000,,Мен мұны бірінші рет ешкімге көрсеттім.
Dialogue: 0,0:21:28.70,0:21:31.37,Top,,0000,0000,0000,,‎(Люси) ‎Мен мұны біреумен бірінші рет жасап тұрмын.
Dialogue: 0,0:21:31.41,0:21:33.16,Bottom,,0000,0000,0000,,О... шынымен бе?
Dialogue: 0,0:21:31.45,0:21:33.16,Top,,0000,0000,0000,,‎Сонымен... не?
Dialogue: 0,0:21:34.71,0:21:38.38,Bottom,,0000,0000,0000,,Сонымен,... неге мен?
Dialogue: 0,0:21:34.83,0:21:38.29,Top,,0000,0000,0000,,‎Мм... неге маған көрсеттің?
Dialogue: 0,0:21:39.17,0:21:43.42,Bottom,,0000,0000,0000,,Ой жоқ. Бұл жай ғана дұрыс сезілді.
Dialogue: 0,0:21:39.21,0:21:43.42,Top,,0000,0000,0000,,‎(Люси) Неге? Саған көрсете аламын ба деп ойладым.
Dialogue: 0,0:21:44.01,0:21:45.17,Top,,0000,0000,0000,,‎Хмм.
Dialogue: 0,0:21:45.80,0:21:47.09,Bottom,,0000,0000,0000,,Сіз білесіз...
Dialogue: 0,0:21:45.92,0:21:46.88,Top,,0000,0000,0000,,Біз
Dialogue: 0,0:21:47.72,0:21:49.68,Bottom,,0000,0000,0000,,Менің ойымша, біз жақсы команда құра аламыз.
Dialogue: 0,0:21:47.80,0:21:49.68,Top,,0000,0000,0000,,Олар жақсы жұп болады деп ойламайсыз ба?
Dialogue: 0,0:21:51.22,0:21:52.64,Bottom,,0000,0000,0000,,Иә…
Dialogue: 0,0:21:51.35,0:21:52.68,Top,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:21:55.14,0:21:55.85,Top,,0000,0000,0000,,А...
Dialogue: 0,0:22:03.15,0:22:05.99,Top,,0000,0000,0000,,‎(Holo Communication: Негізгі) ‎Сен шетінен өттің, балам.
Dialogue: 0,0:22:07.45,0:22:08.28,Bottom,,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:22:07.53,0:22:08.28,Top,,0000,0000,0000,,Кімге?
Dialogue: 0,0:22:08.36,0:22:10.37,Top,,0000,0000,0000,,‎Уау... Де!
Dialogue: 0,0:22:10.41,0:22:14.24,Bottom,,0000,0000,0000,,Сізге оны бұзуды жек көремін, бірақ бұл имплант менікі.
Dialogue: 0,0:22:10.45,0:22:14.24,Top,,0000,0000,0000,,‎Балам, кешіріңіз, бірақ бұл мен.
Dialogue: 0,0:22:14.83,0:22:16.83,Top,,0000,0000,0000,,Мен оны қайтарып аламын.
Dialogue: 0,0:22:15.00,0:22:17.12,Bottom,,0000,0000,0000,,Мен оны қазір қайтарамын.
Dialogue: 0,0:22:18.83,0:22:20.25,Top,,0000,0000,0000,,Уф...
Dialogue: 0,0:22:24.96,0:22:25.59,Top,,0000,0000,0000,,‎Ах~
Dialogue: 0,0:22:25.67,0:22:26.26,Top,,0000,0000,0000,,Гарг
Dialogue: 0,0:22:35.52,0:22:40.52,Top,,0000,0000,0000,,♪~
Dialogue: 0,0:24:00.52,0:24:05.52,Top,,0000,0000,0000,,~♪
