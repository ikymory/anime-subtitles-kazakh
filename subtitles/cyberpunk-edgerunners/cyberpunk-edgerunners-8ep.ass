Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.46,0:00:08.63,Top,,0000,0000,0000,,‎NETFLIX аниме сериясы
Dialogue: 0,0:00:16.26,0:00:17.85,Top,,0000,0000,0000,,Директор Эванс
Dialogue: 0,0:00:16.30,0:00:17.93,Bottom,,0000,0000,0000,,Директор Эванс.
Dialogue: 0,0:00:17.93,0:00:20.85,Top,,0000,0000,0000,,‎Не! Неге үндемей кірдің?
Dialogue: 0,0:00:18.01,0:00:20.81,Bottom,,0000,0000,0000,,Не? Қайдан келдің?
Dialogue: 0,0:00:20.89,0:00:24.52,Bottom,,0000,0000,0000,,Кешіріңіз, сэр. Мен бірнеше рет ұрдым ...
Dialogue: 0,0:00:20.93,0:00:24.19,Top,,0000,0000,0000,,Кешіріңіз. Мен сенен бірнеше рет кешірім сұрадым...
Dialogue: 0,0:00:24.60,0:00:27.23,Bottom,,0000,0000,0000,,Жақсы, жақсы... Сізге не керек?
Dialogue: 0,0:00:24.69,0:00:27.27,Top,,0000,0000,0000,,‎Жарайды, сенің ісің не?
Dialogue: 0,0:00:27.98,0:00:31.99,Bottom,,0000,0000,0000,,Мм... Бір күні үйге барсам болады ма?
Dialogue: 0,0:00:28.02,0:00:29.27,Top,,0000,0000,0000,,Бұл…
Dialogue: 0,0:00:29.36,0:00:31.94,Top,,0000,0000,0000,,‎Алдымен кешірім сұрасам болады ма?
Dialogue: 0,0:00:32.57,0:00:33.90,Top,,0000,0000,0000,,‎(Эванс күрсініп)
Dialogue: 0,0:00:33.99,0:00:37.32,Bottom,,0000,0000,0000,,Кешіріңіз, сэр. Менің бұл кешке жоспарым бар еді...
Dialogue: 0,0:00:33.99,0:00:37.41,Top,,0000,0000,0000,,Кешіріңіз. Менің бүгін жоспарларым бар.
Dialogue: 0,0:00:37.41,0:00:41.20,Bottom,,0000,0000,0000,,Мен сіздің кестеңізді басқару да менің жұмысым екенін түсінбедім.
Dialogue: 0,0:00:37.49,0:00:41.24,Top,,0000,0000,0000,,Мен сіздің кестеңізді басқаруым керек пе?
Dialogue: 0,0:00:41.29,0:00:44.00,Bottom,,0000,0000,0000,,Жоқ, сэр. Бұл жай ғана…
Dialogue: 0,0:00:41.33,0:00:44.04,Top,,0000,0000,0000,,‎Ой жоқ... Кешіріңіз.
Dialogue: 0,0:00:44.08,0:00:47.83,Bottom,,0000,0000,0000,,Мен ұлымның Академияға түсуін атап өткім келді…
Dialogue: 0,0:00:44.12,0:00:47.88,Top,,0000,0000,0000,,Бірақ бүгін мен ұлымның академияға түсуін тойлап жатырмын.
Dialogue: 0,0:00:47.92,0:00:52.92,Bottom,,0000,0000,0000,,О! Бұл тамаша. Біз бәріміз басқа мұраны жалға алуды күтеміз.
Dialogue: 0,0:00:47.96,0:00:52.92,Top,,0000,0000,0000,,‎Дұрыс, құттықтаймын. Сіз Арасаканың болашақ жұлдызысыз.
Dialogue: 0,0:00:53.01,0:00:56.72,Top,,0000,0000,0000,,Олай болса, біреуден UG2 үлгісін әкелсін.
Dialogue: 0,0:00:53.01,0:00:56.80,Bottom,,0000,0000,0000,,UG2 үлгісін алу үшін біреуді табыңыз.
Dialogue: 0,0:00:56.80,0:00:59.64,Top,,0000,0000,0000,,Басқа қызметкерлер үйге уақытында оралды...
Dialogue: 0,0:00:56.89,0:01:00.01,Bottom,,0000,0000,0000,,Осы сағатта барлығы үйлеріне қайтты...
Dialogue: 0,0:01:00.39,0:01:01.97,Top,,0000,0000,0000,,(күрсіну)
Dialogue: 0,0:01:02.06,0:01:04.48,Top,,0000,0000,0000,,Мен үлгіні әкелемін.
Dialogue: 0,0:01:02.06,0:01:05.60,Bottom,,0000,0000,0000,,Үлгіні өзім әкелемін... сондықтан…
Dialogue: 0,0:01:04.56,0:01:05.56,Top,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:01:05.64,0:01:08.27,Top,,0000,0000,0000,,‎Бұл жақсы ұсыныс.
Dialogue: 0,0:01:05.69,0:01:10.65,Bottom,,0000,0000,0000,,Сіз қандай мейірімдісіз. Оны алып, менің көз алдымнан кетіңіз.
Dialogue: 0,0:01:08.35,0:01:10.77,Top,,0000,0000,0000,,Тез әкеліп, үйге тез қайт.
Dialogue: 0,0:01:11.32,0:01:13.36,Top,,0000,0000,0000,,‎(шкафтағы іздеу дыбысы)
Dialogue: 0,0:01:22.83,0:01:24.50,Bottom,,0000,0000,0000,,Директор Эванс?
Dialogue: 0,0:01:22.83,0:01:24.50,Top,,0000,0000,0000,,Директор Эванс? Ах...
Dialogue: 0,0:01:24.58,0:01:26.96,Top,,0000,0000,0000,,‎(Дэвидтің ауыр тыныс алуы)
Dialogue: 0,0:01:28.58,0:01:29.21,Top,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:01:29.29,0:01:30.38,Top,,0000,0000,0000,,‎(қораптың құлаған дыбысы)
Dialogue: 0,0:01:31.84,0:01:33.80,Top,,0000,0000,0000,,(дірілдеген тыныс)
Dialogue: 0,0:01:33.80,0:01:35.01,Bottom,,0000,0000,0000,,Күте тұрыңыз…
Dialogue: 0,0:01:33.88,0:01:35.01,Top,,0000,0000,0000,,Күте тұрыңыз
Dialogue: 0,0:01:36.01,0:01:36.80,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:01:38.18,0:01:39.76,Top,,0000,0000,0000,,‎(шу) ‎Хмм?
Dialogue: 0,0:01:43.47,0:01:45.39,Top,,0000,0000,0000,,‎(Киви) Бұл бұрын не болды?
Dialogue: 0,0:01:43.52,0:01:45.39,Bottom,,0000,0000,0000,,Онда не болды?
Dialogue: 0,0:01:46.02,0:01:48.10,Top,,0000,0000,0000,,‎Бір сәт есту қиын болды.
Dialogue: 0,0:01:46.02,0:01:49.31,Bottom,,0000,0000,0000,,Сізді бір секундқа жоғалтты. Біреу кептелісті көтере ме?
Dialogue: 0,0:01:48.19,0:01:49.31,Top,,0000,0000,0000,,Кептеліп жатыр ма?
Dialogue: 0,0:01:49.40,0:01:51.52,Bottom,,0000,0000,0000,,Беріліс тұрақты болды.
Dialogue: 0,0:01:49.40,0:01:51.61,Top,,0000,0000,0000,,‎(Киви) ‎Бірақ байланыс үзілген жоқ.
Dialogue: 0,0:01:52.15,0:01:53.27,Top,,0000,0000,0000,,Мен түсінемін.
Dialogue: 0,0:01:52.19,0:01:53.15,Bottom,,0000,0000,0000,,Біртүрлі.
Dialogue: 0,0:01:53.36,0:01:55.78,Top,,0000,0000,0000,,Иә, ааа
Dialogue: 0,0:01:54.82,0:01:57.95,Bottom,,0000,0000,0000,,Ие, қандай қызықсыз концерт.
Dialogue: 0,0:01:55.86,0:01:57.82,Top,,0000,0000,0000,,‎Бұл қызықсыз жұмыс болды~
Dialogue: 0,0:01:57.90,0:01:59.16,Top,,0000,0000,0000,,‎(қозғалтқыштың іске қосылу дыбысы)
Dialogue: 0,0:02:01.03,0:02:06.04,Top,,0000,0000,0000,,♪~
Dialogue: 0,0:03:24.16,0:03:29.16,Top,,0000,0000,0000,,~♪
Dialogue: 0,0:03:31.92,0:03:36.67,Top,,0000,0000,0000,,Мекемедегі қастандық? Арасаканы да сынға алды.
Dialogue: 0,0:03:32.00,0:03:36.67,Bottom,,0000,0000,0000,,Олар Арасака үй-жайларын бұзып, бізді өз үйімізде ұрды.
Dialogue: 0,0:03:36.75,0:03:38.92,Top,,0000,0000,0000,,‎Militek қарсы шаралар зертханасы
Dialogue: 0,0:03:36.75,0:03:40.92,Bottom,,0000,0000,0000,,Зертхананың зерттеулері Militech қарсы шараларға бағытталған.
Dialogue: 0,0:03:39.01,0:03:40.42,Top,,0000,0000,0000,,Сіз нысанаға алынған сияқтысыз.
Dialogue: 0,0:03:40.92,0:03:42.47,Top,,0000,0000,0000,,Джейми мен Маркусты өлтірді.
Dialogue: 0,0:03:41.01,0:03:44.14,Bottom,,0000,0000,0000,,Бұл Джейми мен Маркусты тегістеп жіберген жүгірушіге қатысты ма?
Dialogue: 0,0:03:42.55,0:03:44.18,Top,,0000,0000,0000,,‎Сіздің жүгірушілермен қарым-қатынасыңыз қандай?
Dialogue: 0,0:03:44.22,0:03:46.51,Bottom,,0000,0000,0000,,Эванс оқтан өлтірілді...
Dialogue: 0,0:03:44.26,0:03:46.55,Top,,0000,0000,0000,,Режиссер Эванс атып өлтірілді.
Dialogue: 0,0:03:46.60,0:03:51.39,Bottom,,0000,0000,0000,,Бұл немқұрайлы, зорлық-зомбылық болды. Бірдей жүгіруші емес деп айтуға болады.
Dialogue: 0,0:03:46.64,0:03:51.48,Top,,0000,0000,0000,,Іздерді өшіру жолы да аздап шала болды, сондықтан ол жүгірушіден басқа сызықта тұрған сияқты.
Dialogue: 0,0:03:51.48,0:03:55.69,Bottom,,0000,0000,0000,,Нетруннерді түсіну біздің басымдылығымыз. Олар тым қауіпті.
Dialogue: 0,0:03:51.56,0:03:53.85,Top,,0000,0000,0000,,‎Жүгірушіні анықтау басты міндет болып табылады
Dialogue: 0,0:03:53.94,0:03:55.69,Top,,0000,0000,0000,,Ол тым қауіпті
Dialogue: 0,0:03:55.77,0:03:58.69,Bottom,,0000,0000,0000,,Бірақ біз олардың себебін де, мақсатын да білмейміз...
Dialogue: 0,0:03:55.77,0:03:58.69,Top,,0000,0000,0000,,Алайда, мотив пен мақсат белгісіз
Dialogue: 0,0:03:58.78,0:04:00.86,Bottom,,0000,0000,0000,,Олар кім болса да, сақ.
Dialogue: 0,0:03:58.78,0:04:00.86,Top,,0000,0000,0000,,‎Мен құйрықты ұстай алмайтын сияқтымын.
Dialogue: 0,0:04:00.94,0:04:03.53,Bottom,,0000,0000,0000,,Ұпай алғысы келетін орташа жүгіруші емес.
Dialogue: 0,0:04:00.94,0:04:03.61,Top,,0000,0000,0000,,Адасқан жүйрік деңгейінде емес.
Dialogue: 0,0:04:03.61,0:04:06.70,Bottom,,0000,0000,0000,,Біз Арасака контринтелліміз. Біз ешқашан орташамен айналыспаймыз.
Dialogue: 0,0:04:03.70,0:04:06.37,Top,,0000,0000,0000,,Біз қарсы барлау бөлімін өз міндетін орындауға мәжбүрлеп жатырмыз.
Dialogue: 0,0:04:06.78,0:04:10.04,Bottom,,0000,0000,0000,,Біз жүгірушінің ізін қуып жету үшін айналма жолмен жүруіміз керек.
Dialogue: 0,0:04:06.87,0:04:10.04,Top,,0000,0000,0000,,Жүгірушілердің ізімен жүру үшін айналма жолмен жүру керек пе?
Dialogue: 0,0:04:10.12,0:04:13.12,Bottom,,0000,0000,0000,,Біз Эвансты өлтірген адамның артынан барамыз ба?
Dialogue: 0,0:04:10.12,0:04:13.12,Top,,0000,0000,0000,,Сіз Эвансты зерттегіңіз келе ме?
Dialogue: 0,0:04:13.21,0:04:16.96,Bottom,,0000,0000,0000,,Бұл екі бөлек жол. Бізге сәттілік жетіп, олардың біріктірілгенін табуымыз мүмкін.
Dialogue: 0,0:04:13.21,0:04:16.96,Top,,0000,0000,0000,,Бөлек оқиғалар күтпеген жерден орын алуы мүмкін.
Dialogue: 0,0:04:17.79,0:04:21.51,Bottom,,0000,0000,0000,,Оны ауыстырайық. Біз жөндеушінің соңынан барамыз.
Dialogue: 0,0:04:17.84,0:04:21.55,Top,,0000,0000,0000,,Мақсатыңызды өзгертіңіз. Орнатылған түзеткішті табыңыз
Dialogue: 0,0:04:21.59,0:04:25.30,Bottom,,0000,0000,0000,,Милитехпен байланысы бар кімдерді білеміз?
Dialogue: 0,0:04:21.63,0:04:25.34,Top,,0000,0000,0000,,‎Әскери техникамен терең байланысы бар адамдардың тізімін қысқарту қиын емес.
Dialogue: 0,0:04:25.39,0:04:29.39,Bottom,,0000,0000,0000,,Бірақ егер фиксатор жүгірушіге қосылса,
Dialogue: 0,0:04:25.43,0:04:27.68,Top,,0000,0000,0000,,Бірақ бекітушілер мен жүгірушілер үшін
Dialogue: 0,0:04:27.76,0:04:29.47,Top,,0000,0000,0000,,Байланыс болса
Dialogue: 0,0:04:29.47,0:04:34.98,Bottom,,0000,0000,0000,,олар бұрылып, Militech-ке өнім туралы ақпаратты жіберуі мүмкін.
Dialogue: 0,0:04:29.56,0:04:31.72,Top,,0000,0000,0000,,Мысал өнімге қатысты ақпарат
Dialogue: 0,0:04:31.81,0:04:34.98,Top,,0000,0000,0000,,Оның орнына Милитехке сатылу мүмкіндігі бар емес пе?
Dialogue: 0,0:04:35.06,0:04:38.23,Top,,0000,0000,0000,,Егер сіз айлакерлікке және өзін-өзі сақтауға дағдыланбасаңыз.
Dialogue: 0,0:04:35.56,0:04:40.44,Bottom,,0000,0000,0000,,Өз-өзіне қызмет ететін бейбақ болмаса, олар нашар жөндеуші болар еді.
Dialogue: 0,0:04:38.31,0:04:40.65,Top,,0000,0000,0000,,Түнгі қалада жөндеушілер өздерін атаумен атай алмайды.
Dialogue: 0,0:04:40.53,0:04:44.78,Bottom,,0000,0000,0000,,Бірақ күннің соңында олар тек даңққа бөленетін корпоративтік лапдогтар.
Dialogue: 0,0:04:40.73,0:04:44.74,Top,,0000,0000,0000,,‎  ‎
Dialogue: 0,0:04:45.41,0:04:50.74,Bottom,,0000,0000,0000,,Біз оларға бұл қалада кімнің қолын жейтінін еске саламыз.
Dialogue: 0,0:04:45.49,0:04:47.37,Top,,0000,0000,0000,,‎Бұл қалада корпорациялар басым
Dialogue: 0,0:04:47.45,0:04:50.74,Top,,0000,0000,0000,,Мен сізге тек сіздің итіңіз ғана аман қала алатынын көрсетемін.
Dialogue: 0,0:04:51.33,0:04:53.00,Bottom,,0000,0000,0000,,Бұған қалай қарайтын едіңіз?
Dialogue: 0,0:04:51.33,0:04:53.00,Top,,0000,0000,0000,,‎Қандай жолмен?
Dialogue: 0,0:04:53.71,0:04:57.75,Top,,0000,0000,0000,,‎Иә, түнгі қала әдісімен де жасайық.
Dialogue: 0,0:04:54.75,0:04:57.79,Bottom,,0000,0000,0000,,Біз оларға осы қала сөйлейтін жалғыз тілде айтамыз.
Dialogue: 0,0:04:59.92,0:05:01.88,Top,,0000,0000,0000,,(Көліктің үдеу дыбысы) (Фарадей) Иә?
Dialogue: 0,0:05:07.22,0:05:07.97,Top,,0000,0000,0000,,‎Эй!
Dialogue: 0,0:05:07.51,0:05:08.47,Bottom,,0000,0000,0000,,Сәлем…
Dialogue: 0,0:05:08.05,0:05:08.89,Top,,0000,0000,0000,,‎(оқ ату)
Dialogue: 0,0:05:11.31,0:05:12.85,Top,,0000,0000,0000,,‎(Соқтығыс дыбысы)
Dialogue: 0,0:05:14.98,0:05:16.69,Top,,0000,0000,0000,,Түзеткішті өлтірмеңіз!
Dialogue: 0,0:05:14.98,0:05:18.10,Bottom,,0000,0000,0000,,Бекіткішті алыңыз! Басқаларды өлтіріңіз!
Dialogue: 0,0:05:16.77,0:05:18.10,Top,,0000,0000,0000,,Сіз басқаларды өлтіре аласыз.
Dialogue: 0,0:05:20.11,0:05:21.23,Bottom,,0000,0000,0000,,Граната!
Dialogue: 0,0:05:20.23,0:05:21.32,Top,,0000,0000,0000,,Граната!
Dialogue: 0,0:05:21.32,0:05:22.32,Bottom,,0000,0000,0000,,Жүр! Бар!
Dialogue: 0,0:05:21.86,0:05:23.53,Top,,0000,0000,0000,,‎Оны артқа тастаңыз... Арх!
Dialogue: 0,0:05:23.61,0:05:24.53,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:05:41.34,0:05:43.09,Top,,0000,0000,0000,,‎(Фарадей) Ол өліп қала жаздады.
Dialogue: 0,0:05:41.38,0:05:43.00,Bottom,,0000,0000,0000,,Мен өліп қала жаздадым.
Dialogue: 0,0:05:43.09,0:05:45.80,Bottom,,0000,0000,0000,,Бұл Арасака деп ойлайсың ба?
Dialogue: 0,0:05:43.17,0:05:45.88,Top,,0000,0000,0000,,‎(Ер) ‎Бұл міндетті түрде Арасака депозиті емес.
Dialogue: 0,0:05:45.88,0:05:48.63,Bottom,,0000,0000,0000,,Сен мені ақымақ санайсың ба? Басқа кім болуы мүмкін еді?
Dialogue: 0,0:05:45.97,0:05:48.63,Top,,0000,0000,0000,,(Фарадей) ақымақ, мені тағы кім нысанаға алады?
Dialogue: 0,0:05:48.72,0:05:52.01,Bottom,,0000,0000,0000,,Біз ешқандай қосымша міндеттемелер үшін төлемейміз.
Dialogue: 0,0:05:48.72,0:05:52.06,Top,,0000,0000,0000,,Сіз ер адам болғандықтан, қосымша қаражат алуға рұқсат етілмейді.
Dialogue: 0,0:05:52.10,0:05:54.39,Bottom,,0000,0000,0000,,Ал корпоративтік иммунитет әлі күнге дейін жоқ.
Dialogue: 0,0:05:52.14,0:05:54.35,Top,,0000,0000,0000,,‎Айыптауға қарсы иммунитет мәселесі де қиын.
Dialogue: 0,0:05:54.43,0:05:55.64,Top,,0000,0000,0000,,‎(Фарадей) Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:05:54.47,0:05:55.64,Bottom,,0000,0000,0000,,Ято-сама, өтінемін, солай істеңіз
Dialogue: 0,0:05:55.73,0:05:59.40,Bottom,,0000,0000,0000,,Танака ісіне қатысты мәлімдемеңіз бізге қазірдің өзінде қызық болып қалды.
Dialogue: 0,0:05:55.73,0:05:59.40,Top,,0000,0000,0000,,‎(Ер) Танаканың ісімен айналысу қанша тұрады деп ойлайсыз?
Dialogue: 0,0:05:59.48,0:06:01.44,Top,,0000,0000,0000,,‎Және нәтиже жоқ.
Dialogue: 0,0:05:59.48,0:06:04.40,Bottom,,0000,0000,0000,,Көрсететін ештеңесі жоқ. Инвестицияларымыздан қайтарым күтеміз.
Dialogue: 0,0:06:01.98,0:06:06.69,Top,,0000,0000,0000,,‎Егер сізге қосымша инвестиция жасау қажет болса, алдымен нәтижені көруіміз керек.
Dialogue: 0,0:06:04.48,0:06:07.03,Bottom,,0000,0000,0000,,Қосымша ресурстарды қалайсыз ба? Бізге нәтижелерді көрсетіңіз.
Dialogue: 0,0:06:07.11,0:06:10.28,Bottom,,0000,0000,0000,,Ал мен нені қудым деп ойлайсың?
Dialogue: 0,0:06:07.28,0:06:10.32,Top,,0000,0000,0000,,Осы уақытқа дейін атқарған жұмыстарыңызға көңіліңіз толмайтынын айтқыңыз келе ме?
Dialogue: 0,0:06:10.36,0:06:15.66,Bottom,,0000,0000,0000,,Уақытыңыз таусылып жатыр. Шыдамымыз таусылып барады.
Dialogue: 0,0:06:10.41,0:06:12.58,Top,,0000,0000,0000,,‎(Еркек) Мен көп айтпаймын ба?
Dialogue: 0,0:06:12.66,0:06:15.66,Top,,0000,0000,0000,,‎Менің ойымша, бұл көп уақытты қажет етпейді.
Dialogue: 0,0:06:15.75,0:06:19.17,Bottom,,0000,0000,0000,,Арасаканың қауіпсіздігі әдеттегіден жоғары деңгейде.
Dialogue: 0,0:06:15.75,0:06:19.25,Top,,0000,0000,0000,,Өйткені Арасаканың күзетшісі ерекше.
Dialogue: 0,0:06:19.25,0:06:23.84,Bottom,,0000,0000,0000,,Киберқаңқаның олар үшін қаншалықты маңызды екенін көрсетеді.
Dialogue: 0,0:06:19.33,0:06:20.63,Top,,0000,0000,0000,,Мұның бәрі Арасака үшін
Dialogue: 0,0:06:20.71,0:06:24.00,Top,,0000,0000,0000,,Киберқаңқалардың маңызды екенін дәлелдеу.
Dialogue: 0,0:06:23.92,0:06:25.17,Bottom,,0000,0000,0000,,Сіз тым көп нәрсені күтесіз.
Dialogue: 0,0:06:24.09,0:06:25.17,Top,,0000,0000,0000,,Түсінбейсің бе?
Dialogue: 0,0:06:25.25,0:06:26.42,Top,,0000,0000,0000,,Өйткені мен білемін
Dialogue: 0,0:06:25.25,0:06:30.34,Bottom,,0000,0000,0000,,Осыған салған ақшамызбен маған ставкалар туралы дәріс оқымаңыз.
Dialogue: 0,0:06:26.51,0:06:28.51,Top,,0000,0000,0000,,Мен оған көп нәрсе салдым.
Dialogue: 0,0:06:28.59,0:06:30.09,Top,,0000,0000,0000,,Маған нәтижелерді беріңіз.
Dialogue: 0,0:06:30.43,0:06:34.35,Bottom,,0000,0000,0000,,Сіз оны таппайынша, басқа қызық емес. Біз мұнда бітірдік.
Dialogue: 0,0:06:30.64,0:06:32.97,Top,,0000,0000,0000,,Нәтижесіз соманы көбейте алмайсыз.
Dialogue: 0,0:06:33.05,0:06:34.31,Top,,0000,0000,0000,,Әзірге осымен бітті.
Dialogue: 0,0:06:38.64,0:06:41.40,Top,,0000,0000,0000,,‎Цк... ең соңында жас жігіт
Dialogue: 0,0:06:39.44,0:06:41.48,Bottom,,0000,0000,0000,,Қарғыс атқыр корпоративті брат...
Dialogue: 0,0:06:49.53,0:06:50.45,Top,,0000,0000,0000,,‎(Голокольдық үн)
Dialogue: 0,0:06:51.61,0:06:54.33,Bottom,,0000,0000,0000,,Бекіткіш байланыс орнатты.
Dialogue: 0,0:06:51.66,0:06:54.95,Top,,0000,0000,0000,,‎ ‎Мысалды түзетуші маған хабарласты.
Dialogue: 0,0:06:55.03,0:06:56.45,Top,,0000,0000,0000,,Сіз мақсатқа тура келдіңіз.
Dialogue: 0,0:06:55.12,0:06:56.45,Bottom,,0000,0000,0000,,Мен болжағандай.
Dialogue: 0,0:06:57.04,0:06:59.08,Bottom,,0000,0000,0000,,Қандай жақсы кішкентай ит.
Dialogue: 0,0:06:57.12,0:06:59.08,Top,,0000,0000,0000,,Бұл жеңіл гиена.
Dialogue: 0,0:06:59.16,0:07:02.54,Top,,0000,0000,0000,,(теледидар дыбысы) (Люси) Иә?
Dialogue: 0,0:07:07.38,0:07:08.71,Bottom,,0000,0000,0000,,Дэвид?
Dialogue: 0,0:07:07.46,0:07:08.80,Top,,0000,0000,0000,,‎(Люси) Дэвид?
Dialogue: 0,0:07:11.18,0:07:13.59,Bottom,,0000,0000,0000,,О, менің жаманым.
Dialogue: 0,0:07:11.18,0:07:13.59,Top,,0000,0000,0000,,А... кешіріңіз
Dialogue: 0,0:07:13.68,0:07:15.10,Top,,0000,0000,0000,,‎Мен сені ояттым ба?
Dialogue: 0,0:07:13.68,0:07:15.30,Bottom,,0000,0000,0000,,Мен сені ояттым ба?
Dialogue: 0,0:07:15.18,0:07:16.60,Top,,0000,0000,0000,,‎(Люси) Сіз ұйықтай алмайсыз ба?
Dialogue: 0,0:07:15.39,0:07:16.81,Bottom,,0000,0000,0000,,Ұйықтау мүмкін емес пе?
Dialogue: 0,0:07:16.68,0:07:19.02,Top,,0000,0000,0000,,‎Мен көзім бос қалғандай сезінемін.
Dialogue: 0,0:07:16.89,0:07:18.56,Bottom,,0000,0000,0000,,Миымды өшіре алмадым.
Dialogue: 0,0:07:19.10,0:07:21.10,Top,,0000,0000,0000,,(Люси) Иә, мен оны жоямын.
Dialogue: 0,0:07:19.18,0:07:20.18,Bottom,,0000,0000,0000,,Ә... ә... білесің бе...
Dialogue: 0,0:07:20.27,0:07:21.10,Bottom,,0000,0000,0000,,Мен оны өшіремін.
Dialogue: 0,0:07:21.19,0:07:22.73,Bottom,,0000,0000,0000,,Сіз қарап тұрған жоқсыз ба?
Dialogue: 0,0:07:21.19,0:07:22.77,Top,,0000,0000,0000,,‎(Люси) Сіз қарап тұрсыз, солай ма?
Dialogue: 0,0:07:22.81,0:07:24.81,Bottom,,0000,0000,0000,,Жоқ, мен оны жаңа ғана кидім…
Dialogue: 0,0:07:22.85,0:07:25.73,Top,,0000,0000,0000,,‎Мен оны жай ғана киіп жүрмін... Ах.
Dialogue: 0,0:07:24.90,0:07:25.73,Bottom,,0000,0000,0000,,Ә... ә... білесің бе...
Dialogue: 0,0:07:26.40,0:07:31.36,Bottom,,0000,0000,0000,,250K Айға... Ия, мен ойлағаннан да арзанырақ.
Dialogue: 0,0:07:26.65,0:07:31.36,Top,,0000,0000,0000,,‎Сіз ол жерге 250 000 иенге бара аласыз. Бұл таңқаларлық арзан деп ойламайсыз ба?
Dialogue: 0,0:07:31.45,0:07:33.36,Bottom,,0000,0000,0000,,Бір жақты билет үшін.
Dialogue: 0,0:07:31.45,0:07:33.49,Top,,0000,0000,0000,,‎Егер сіз жай ғана барсаңыз, солай ма?
Dialogue: 0,0:07:33.45,0:07:35.49,Bottom,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:07:33.57,0:07:35.66,Top,,0000,0000,0000,,Иә, бірақ
Dialogue: 0,0:07:35.74,0:07:37.87,Top,,0000,0000,0000,,‎Хмм... есімде.
Dialogue: 0,0:07:36.70,0:07:37.87,Bottom,,0000,0000,0000,,Есіңізде қалды...
Dialogue: 0,0:07:37.95,0:07:39.00,Bottom,,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:07:38.45,0:07:39.12,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:39.08,0:07:41.21,Bottom,,0000,0000,0000,,Ештеңе. Мен төсекке қайтамын.
Dialogue: 0,0:07:39.20,0:07:41.37,Top,,0000,0000,0000,,‎(Люси) Жоқ, мен қазір ұйықтаймын.
Dialogue: 0,0:07:41.96,0:07:43.62,Bottom,,0000,0000,0000,,Жарайды. 'Түн.
Dialogue: 0,0:07:42.08,0:07:43.62,Top,,0000,0000,0000,,Иә, қайырлы түн.
Dialogue: 0,0:07:51.76,0:07:56.01,Top,,0000,0000,0000,,Әлемдегі ең үлкен жапон компаниясының қарсы барлау бөлімі осындай жерде жасырын жиналыс өткізіп жатыр ма?
Dialogue: 0,0:07:51.80,0:07:56.01,Bottom,,0000,0000,0000,,Асханада заңсыз бизнес жүргізетін әлемдегі ең ірі корпорация.
Dialogue: 0,0:07:56.60,0:07:59.77,Bottom,,0000,0000,0000,,Таныстығыңызға сенімділік береді деп ойладым.
Dialogue: 0,0:07:56.60,0:07:59.81,Top,,0000,0000,0000,,Мен сіздің стиліңізге сәйкес келуге тырысамын.
Dialogue: 0,0:07:59.85,0:08:02.27,Bottom,,0000,0000,0000,,Мен шаш алмаймын. Мен сенің жауабың үшін келдім.
Dialogue: 0,0:07:59.89,0:08:02.27,Top,,0000,0000,0000,,‎(Фарадей) ‎Жарайды, жауабын тыңдайық.
Dialogue: 0,0:08:02.35,0:08:05.15,Top,,0000,0000,0000,,Кибер қаңқалар Тіпті менің Арасакамда
Dialogue: 0,0:08:02.35,0:08:07.40,Bottom,,0000,0000,0000,,Киберскелет жобасы тіпті Арасака ішінде де нәзік тақырып болып табылады.
Dialogue: 0,0:08:05.23,0:08:07.40,Top,,0000,0000,0000,,‎Бұл нәзік өнім.
Dialogue: 0,0:08:07.48,0:08:10.36,Top,,0000,0000,0000,,Ақпарат Танакада тым көп шоғырланған
Dialogue: 0,0:08:07.48,0:08:11.78,Bottom,,0000,0000,0000,,Танака операциялық деректерді шамадан тыс шоғырландырған кезде бұл проблемаға айналды.
Dialogue: 0,0:08:10.44,0:08:14.49,Top,,0000,0000,0000,,Бұл да кері әсер етеді, әскери техника қаншалықты біледі?
Dialogue: 0,0:08:11.86,0:08:14.41,Bottom,,0000,0000,0000,,Милитех қанша біледі?
Dialogue: 0,0:08:14.49,0:08:16.32,Bottom,,0000,0000,0000,,Ақпарат – менің кәсіпімнің қаны.
Dialogue: 0,0:08:14.57,0:08:18.91,Top,,0000,0000,0000,,(Фарадей) Ақпарат – өмірлік арқау. Мен бірінші кезекте кепілдік алғым келеді.
Dialogue: 0,0:08:16.41,0:08:18.91,Bottom,,0000,0000,0000,,Мен бұдан әрі айтпас бұрын, маған біраз кепілдіктер қажет болады.
Dialogue: 0,0:08:18.99,0:08:23.33,Bottom,,0000,0000,0000,,Біз сіздің жұмыс үшін ең жақсы адам екеніңізді құрметтейміз.
Dialogue: 0,0:08:18.99,0:08:23.41,Top,,0000,0000,0000,,‎Біз сіздей басқа түзетуші жоқ екенін түсінеміз.
Dialogue: 0,0:08:23.41,0:08:27.84,Bottom,,0000,0000,0000,,Біз Militech сізден ақымақтықпен бас тартқан өтемақыны қуана береміз.
Dialogue: 0,0:08:23.50,0:08:27.92,Top,,0000,0000,0000,,Сіздің Милитех бас тартқан шартыңыз толық
Dialogue: 0,0:08:27.92,0:08:30.92,Bottom,,0000,0000,0000,,Танакадағы тәртіпсіздікке келетін болсақ, сіздің қарызыңыз өтелді деп есептеңіз.
Dialogue: 0,0:08:28.00,0:08:30.92,Top,,0000,0000,0000,,Танаканың ұрлануына қатысты кешірім туралы да солай.
Dialogue: 0,0:08:31.01,0:08:32.17,Bottom,,0000,0000,0000,,Керемет.
Dialogue: 0,0:08:31.01,0:08:32.17,Top,,0000,0000,0000,,Өте жақсы
Dialogue: 0,0:08:32.26,0:08:35.55,Bottom,,0000,0000,0000,,Дегенмен, бізде де кейбір шарттар бар.
Dialogue: 0,0:08:32.26,0:08:35.55,Top,,0000,0000,0000,,‎Бірақ мұнда да шарттар бар.
Dialogue: 0,0:08:36.47,0:08:37.43,Bottom,,0000,0000,0000,,Тыңдап көрейік.
Dialogue: 0,0:08:36.47,0:08:37.43,Top,,0000,0000,0000,,Тыңдап көрейік
Dialogue: 0,0:08:37.51,0:08:40.60,Top,,0000,0000,0000,,Кибер қаңқалардың бар екендігі туралы білетіндер
Dialogue: 0,0:08:37.51,0:08:42.81,Bottom,,0000,0000,0000,,Біз киберқаңқа туралы білетіндерді жоюымыз керек.
Dialogue: 0,0:08:40.68,0:08:42.85,Top,,0000,0000,0000,,Барлығынан құтылу
Dialogue: 0,0:08:42.89,0:08:44.48,Bottom,,0000,0000,0000,,Орындалды.
Dialogue: 0,0:08:42.93,0:08:44.56,Top,,0000,0000,0000,,‎(Фарадей) Мәселе жоқ
Dialogue: 0,0:08:44.56,0:08:46.23,Bottom,,0000,0000,0000,,Тағы бір нәрсе.
Dialogue: 0,0:08:44.64,0:08:46.27,Top,,0000,0000,0000,,Мен тағы бір нәрсе сұрағым келеді.
Dialogue: 0,0:08:46.31,0:08:47.48,Bottom,,0000,0000,0000,,Уф, емтихандар.
Dialogue: 0,0:08:46.35,0:08:47.52,Top,,0000,0000,0000,,‎(Фарадей) Не?
Dialogue: 0,0:08:47.56,0:08:49.11,Bottom,,0000,0000,0000,,Танака қайтыс болғаннан кейін,
Dialogue: 0,0:08:47.61,0:08:49.15,Top,,0000,0000,0000,,‎Танака қайтыс болғаннан кейін
Dialogue: 0,0:08:49.19,0:08:54.61,Bottom,,0000,0000,0000,,зақымдалған деректерді қалпына келтіруге жүгіруші кедергі жасады.
Dialogue: 0,0:08:49.23,0:08:51.40,Top,,0000,0000,0000,,Кибер қаңқаға қатысты бүлінген
Dialogue: 0,0:08:51.48,0:08:54.57,Top,,0000,0000,0000,,‎Деректерді қалпына келтіруге кедергі келтіретін жүгірушілер бар.
Dialogue: 0,0:08:54.65,0:08:57.07,Top,,0000,0000,0000,,Бұл туралы ақпарат бар ма?
Dialogue: 0,0:08:54.70,0:08:57.07,Bottom,,0000,0000,0000,,Бұл туралы бірдеңе білесіз бе?
Dialogue: 0,0:08:57.78,0:08:59.03,Bottom,,0000,0000,0000,,Менің есімде жоқ.
Dialogue: 0,0:08:57.82,0:08:59.08,Top,,0000,0000,0000,,Мен білмеймін
Dialogue: 0,0:08:59.12,0:08:59.95,Bottom,,0000,0000,0000,,Б... бір сызық
Dialogue: 0,0:08:59.16,0:09:02.95,Top,,0000,0000,0000,,Мен түсінемін. Бұған қатысты жұмбақ көп.
Dialogue: 0,0:09:00.03,0:09:02.91,Bottom,,0000,0000,0000,,Бізді бұл жағдай қызықтырады.
Dialogue: 0,0:09:03.00,0:09:08.71,Bottom,,0000,0000,0000,,Бұл Милитех болса да, мен олардың неге бұлай істейтінін елестете алмаймын.
Dialogue: 0,0:09:03.04,0:09:05.87,Top,,0000,0000,0000,,‎Бұл бірінші кезекте әскери-техникалық жағынан тапсырыс болса да
Dialogue: 0,0:09:05.96,0:09:08.42,Top,,0000,0000,0000,,Мен мақсат не екенін білмеймін
Dialogue: 0,0:09:08.79,0:09:10.63,Bottom,,0000,0000,0000,,Менің дереккөздерімнің айтуы бойынша,
Dialogue: 0,0:09:09.04,0:09:12.55,Top,,0000,0000,0000,,‎Танака кибер қаңқаға қатысы бар деп есептеледі.
Dialogue: 0,0:09:10.71,0:09:15.13,Bottom,,0000,0000,0000,,Танаканың киберскелет жобасымен байланысы туралы ешкім білмейді.
Dialogue: 0,0:09:12.63,0:09:16.09,Top,,0000,0000,0000,,‎Оны менен басқа ешкім ойламайды... ‎Іштей?
Dialogue: 0,0:09:15.22,0:09:16.09,Bottom,,0000,0000,0000,,Ішкі жұмыс?
Dialogue: 0,0:09:16.18,0:09:17.72,Top,,0000,0000,0000,,‎Мүмкін емес
Dialogue: 0,0:09:16.18,0:09:21.68,Bottom,,0000,0000,0000,,Жоқ. Із қалдырмай іштей қозғалу мүмкін емес.
Dialogue: 0,0:09:17.80,0:09:21.68,Top,,0000,0000,0000,,‎Іштен із қалдырмай қозғалу мүмкін емес.
Dialogue: 0,0:09:21.76,0:09:24.39,Top,,0000,0000,0000,,Білікті жүгіруші киберпанк қауымдастығына қосылды —
Dialogue: 0,0:09:21.76,0:09:27.35,Bottom,,0000,0000,0000,,Сырттан қарағанда шебер жүйрік деп ойлау табиғирақ.
Dialogue: 0,0:09:24.48,0:09:27.35,Top,,0000,0000,0000,,‎Оны жасырын деп ойлау табиғирақ.
Dialogue: 0,0:09:27.44,0:09:30.31,Bottom,,0000,0000,0000,,Маған жөндеуші жұмысы сияқты көрінеді.
Dialogue: 0,0:09:27.44,0:09:30.31,Top,,0000,0000,0000,,‎Бұл сіздің түзетуші ретіндегі өрісіңіз болуы мүмкін.
Dialogue: 0,0:09:30.98,0:09:32.86,Bottom,,0000,0000,0000,,Бұл ресми комиссия ма?
Dialogue: 0,0:09:31.07,0:09:32.86,Top,,0000,0000,0000,,Бұл қосымша сұрау емес пе?
Dialogue: 0,0:09:33.44,0:09:38.36,Bottom,,0000,0000,0000,,Оларды тірі қалдыру үшін бір миллион. Олардың басының жарты бағасы.
Dialogue: 0,0:09:33.48,0:09:36.32,Top,,0000,0000,0000,,1 миллион иен, егер мені тірідей тапсырсаң.
Dialogue: 0,0:09:36.40,0:09:38.36,Top,,0000,0000,0000,,Тіпті мәйіттің құны 500 000 иен болады.
Dialogue: 0,0:09:39.82,0:09:41.41,Bottom,,0000,0000,0000,,Мен қабылдаймын.
Dialogue: 0,0:09:39.91,0:09:41.24,Top,,0000,0000,0000,,Қабыл алайық
Dialogue: 0,0:09:42.45,0:09:45.75,Top,,0000,0000,0000,,(Holo News: Kiwi) Маған хабарласу сирек.
Dialogue: 0,0:09:45.83,0:09:48.62,Top,,0000,0000,0000,,‎(Люси) ‎(Киви) ‎Не болды?
Dialogue: 0,0:09:48.71,0:09:52.00,Top,,0000,0000,0000,,(Люси) Иә, мен сізден бір нәрсе сұрағым келеді.
Dialogue: 0,0:09:52.09,0:09:53.59,Top,,0000,0000,0000,,(Киви) Бұл не?
Dialogue: 0,0:09:53.67,0:09:54.96,Top,,0000,0000,0000,,(Люси) Бұл үлкен мәселе емес.
Dialogue: 0,0:09:55.46,0:09:58.76,Top,,0000,0000,0000,,‎Дэвид, сенің жұмысың жақсы ма деп ойлаймын.
Dialogue: 0,0:09:58.84,0:10:01.26,Top,,0000,0000,0000,,‎(Киви)‎Менің ойымша, сіз жақсы жүрсіз.
Dialogue: 0,0:10:01.35,0:10:04.56,Top,,0000,0000,0000,,‎Алғашында мен сені қолдаймын деген ниетпен бірігіп кеттім.
Dialogue: 0,0:10:04.64,0:10:07.06,Top,,0000,0000,0000,,‎Мен қазір өзімді кәдімгі көшбасшы сияқты сезінемін.
Dialogue: 0,0:10:07.64,0:10:10.48,Top,,0000,0000,0000,,Маған Фарадейден жұмысқа сұраныстар түсе бастады.
Dialogue: 0,0:10:10.56,0:10:11.52,Top,,0000,0000,0000,,ұқсайды (Люси)
Dialogue: 0,0:10:11.61,0:10:15.57,Top,,0000,0000,0000,,(Киви) Егер Мэн Дэвидті қазір көрсе, ол таң қалар еді.
Dialogue: 0,0:10:15.65,0:10:16.82,Top,,0000,0000,0000,,(Люси) Иә?
Dialogue: 0,0:10:18.07,0:10:20.32,Top,,0000,0000,0000,,‎(Киви) ‎Сізді бірдеңе уайымдайтын нәрсе бар ма?
Dialogue: 0,0:10:20.41,0:10:22.41,Top,,0000,0000,0000,,(Люси) Бұл олай емес...
Dialogue: 0,0:10:22.91,0:10:24.29,Top,,0000,0000,0000,,‎Егер дұрыс істеп жатсаңыз
Dialogue: 0,0:10:25.04,0:10:26.91,Top,,0000,0000,0000,,Неге біз бірге жұмыс істемейміз?
Dialogue: 0,0:10:27.00,0:10:28.08,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:28.16,0:10:30.08,Top,,0000,0000,0000,,‎(Киви) ‎Дэвид сізге ұнағанша.
Dialogue: 0,0:10:30.17,0:10:31.71,Top,,0000,0000,0000,,‎Сіз күтуді жоспарлап отырған сияқтысыз.
Dialogue: 0,0:10:31.79,0:10:34.38,Top,,0000,0000,0000,,Негізі, тезірек оралғаныңды қалаймын.
Dialogue: 0,0:10:34.88,0:10:37.67,Top,,0000,0000,0000,,(Люси) Мен білемін. (Киви) Әлі де мүмкін емес пе?
Dialogue: 0,0:10:37.76,0:10:43.22,Top,,0000,0000,0000,,‎(Люси) ‎Әлі емес... ‎Бірақ бұл жақында бітетін сияқты.
Dialogue: 0,0:10:43.30,0:10:44.43,Top,,0000,0000,0000,,‎(Киви) ‎Мм
Dialogue: 0,0:10:45.06,0:10:46.85,Top,,0000,0000,0000,,Мен ұрмаймын.
Dialogue: 0,0:10:47.48,0:10:52.36,Top,,0000,0000,0000,,‎Түнгі қалада адамдарға сенбеңіз. Сеніп, алданып қалсаң одан да жаман.
Dialogue: 0,0:10:52.44,0:10:53.94,Top,,0000,0000,0000,,Мен мұны сізге баяғыда үйреткенмін.
Dialogue: 0,0:10:54.02,0:10:56.19,Top,,0000,0000,0000,,(Люси) Ха, сен солай айттың.
Dialogue: 0,0:10:56.82,0:11:00.07,Top,,0000,0000,0000,,(Киви) Жарайды, мен сенің жақында оралуыңды күтемін.
Dialogue: 0,0:11:00.15,0:11:02.99,Top,,0000,0000,0000,,Дэвид мүлде тыңдамайды.
Dialogue: 0,0:11:03.07,0:11:04.83,Top,,0000,0000,0000,,(Люси) Бұл не?
Dialogue: 0,0:11:05.45,0:11:06.54,Top,,0000,0000,0000,,Я тағы да
Dialogue: 0,0:11:06.62,0:11:07.66,Top,,0000,0000,0000,,‎(байланысты ажырату дыбысы)
Dialogue: 0,0:11:09.33,0:11:10.58,Top,,0000,0000,0000,,‎(Кіру қоңырауы)
Dialogue: 0,0:11:11.42,0:11:12.58,Top,,0000,0000,0000,,‎(Голо коммуникация: Фарадей) ‎Бұл менмін.
Dialogue: 0,0:11:13.17,0:11:14.13,Top,,0000,0000,0000,,(күрсіну)
Dialogue: 0,0:11:14.67,0:11:15.38,Top,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:16.42,0:11:17.30,Top,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:18.05,0:11:20.47,Top,,0000,0000,0000,,(қатты күлу)
Dialogue: 0,0:11:20.55,0:11:23.22,Top,,0000,0000,0000,,‎Бұл тартылған ет!
Dialogue: 0,0:11:20.88,0:11:23.22,Bottom,,0000,0000,0000,,Оны алыңыз!
Dialogue: 0,0:11:23.84,0:11:26.14,Top,,0000,0000,0000,,Оқ бітті! Түсінді
Dialogue: 0,0:11:24.01,0:11:25.18,Bottom,,0000,0000,0000,,Шырын бітті!
Dialogue: 0,0:11:25.26,0:11:26.72,Bottom,,0000,0000,0000,,Түсінді.
Dialogue: 0,0:11:30.85,0:11:32.85,Top,,0000,0000,0000,,‎Ух... Уф...
Dialogue: 0,0:11:32.94,0:11:33.98,Top,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:11:34.52,0:11:35.40,Top,,0000,0000,0000,,Ух...
Dialogue: 0,0:11:36.52,0:11:37.40,Top,,0000,0000,0000,,Күте тұрыңыз
Dialogue: 0,0:11:37.48,0:11:38.28,Top,,0000,0000,0000,,‎Ха…
Dialogue: 0,0:11:39.61,0:11:40.74,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:11:45.87,0:11:47.16,Bottom,,0000,0000,0000,,Не істеп жатырсың?!
Dialogue: 0,0:11:45.87,0:11:47.16,Top,,0000,0000,0000,,‎Сен не істеп жатырсың!
Dialogue: 0,0:11:48.12,0:11:50.08,Bottom,,0000,0000,0000,,Ах... Менің жаманым.
Dialogue: 0,0:11:48.24,0:11:49.95,Top,,0000,0000,0000,,О, жаман
Dialogue: 0,0:11:51.46,0:11:54.21,Top,,0000,0000,0000,,Кездескенше, Давид Ах.
Dialogue: 0,0:11:51.50,0:11:53.04,Bottom,,0000,0000,0000,,Кейінірек, Дэвид.
Dialogue: 0,0:11:53.12,0:11:54.13,Bottom,,0000,0000,0000,,Иә…
Dialogue: 0,0:11:59.59,0:12:01.09,Top,,0000,0000,0000,,‎Фалько Ашимо түседі
Dialogue: 0,0:11:59.59,0:12:01.17,Bottom,,0000,0000,0000,,Фалько! Мен де кетемін!
Dialogue: 0,0:12:01.17,0:12:01.67,Top,,0000,0000,0000,,О?
Dialogue: 0,0:12:01.26,0:12:02.30,Bottom,,0000,0000,0000,,Жер
Dialogue: 0,0:12:01.76,0:12:02.68,Top,,0000,0000,0000,,‎(есік жабылған дыбыс)
Dialogue: 0,0:12:05.26,0:12:07.35,Top,,0000,0000,0000,,‎Жоқ, бірге ішейік.
Dialogue: 0,0:12:05.26,0:12:08.01,Bottom,,0000,0000,0000,,Әйтеуір, кешке біз екеуміз деп ойлайсыз.
Dialogue: 0,0:12:08.10,0:12:11.02,Bottom,,0000,0000,0000,,Менің де баратын жерім бар.
Dialogue: 0,0:12:08.10,0:12:11.02,Top,,0000,0000,0000,,‎(Киви) Falco~ ‎Мені де тастап кететін жер бар.
Dialogue: 0,0:12:11.10,0:12:14.44,Bottom,,0000,0000,0000,,Солай ма? Бір топ өлтіруші, сен, бір және бәрі.
Dialogue: 0,0:12:11.10,0:12:14.44,Top,,0000,0000,0000,,Иә, олар жаман адамдар.
Dialogue: 0,0:12:15.69,0:12:16.98,Bottom,,0000,0000,0000,,Дэвид!
Dialogue: 0,0:12:15.69,0:12:17.11,Top,,0000,0000,0000,,Дәуіт!
Dialogue: 0,0:12:19.11,0:12:20.90,Bottom,,0000,0000,0000,,Бүгін кештен кейінгі кеш жоқ па?
Dialogue: 0,0:12:19.15,0:12:20.90,Top,,0000,0000,0000,,Сусын ішуге шығамыз ба?
Dialogue: 0,0:12:20.99,0:12:23.57,Top,,0000,0000,0000,,Қартпен ішу қызықсыз
Dialogue: 0,0:12:20.99,0:12:23.61,Bottom,,0000,0000,0000,,Сол екі бумермен мас бола алмаймын.
Dialogue: 0,0:12:23.65,0:12:26.12,Top,,0000,0000,0000,,Мен осында болсам, қызық болмас еді.
Dialogue: 0,0:12:23.70,0:12:25.99,Bottom,,0000,0000,0000,,Мен бұдан былай көңілді боламын деп уәде бере алмаймын.
Dialogue: 0,0:12:26.07,0:12:27.83,Bottom,,0000,0000,0000,,Өзіңізді төмендетпеңіз!
Dialogue: 0,0:12:26.20,0:12:28.03,Top,,0000,0000,0000,,Уайымдамаңыз
Dialogue: 0,0:12:28.62,0:12:30.49,Bottom,,0000,0000,0000,,Эй... Серуендегің келе ме?
Dialogue: 0,0:12:28.70,0:12:30.54,Top,,0000,0000,0000,,Ей, тез серуендейміз.
Dialogue: 0,0:12:30.58,0:12:33.29,Bottom,,0000,0000,0000,,Иә? Әрине, менің ойымша…
Dialogue: 0,0:12:30.62,0:12:33.29,Top,,0000,0000,0000,,Иә? А... жарайды
Dialogue: 0,0:12:33.37,0:12:34.58,Bottom,,0000,0000,0000,,(Тик-так, тик-так соғады сағат)
Dialogue: 0,0:12:33.37,0:12:34.83,Top,,0000,0000,0000,,Уша!
Dialogue: 0,0:12:38.50,0:12:41.13,Bottom,,0000,0000,0000,,Сонымен... сіз жақсысыз ба?
Dialogue: 0,0:12:38.54,0:12:42.21,Top,,0000,0000,0000,,Эй, жақсысың ба? Не?
Dialogue: 0,0:12:41.21,0:12:42.21,Bottom,,0000,0000,0000,,Жер
Dialogue: 0,0:12:42.30,0:12:44.30,Top,,0000,0000,0000,,Бүгін бұл не?
Dialogue: 0,0:12:42.30,0:12:44.72,Bottom,,0000,0000,0000,,Бүгін бұл не болды?
Dialogue: 0,0:12:44.80,0:12:46.30,Top,,0000,0000,0000,,Не?
Dialogue: 0,0:12:44.80,0:12:46.43,Bottom,,0000,0000,0000,,Не болды?
Dialogue: 0,0:12:46.39,0:12:49.72,Top,,0000,0000,0000,,Маған бұл керек емес. Ештеңе емес.
Dialogue: 0,0:12:46.51,0:12:47.76,Bottom,,0000,0000,0000,,Сіз менің не айтқым келгенін түсінесіз.
Dialogue: 0,0:12:48.39,0:12:49.68,Bottom,,0000,0000,0000,,Бұл ештеңе болмады.
Dialogue: 0,0:12:49.76,0:12:51.81,Bottom,,0000,0000,0000,,Бұл бірінші рет болып тұрған жоқ.
Dialogue: 0,0:12:49.81,0:12:51.93,Top,,0000,0000,0000,,‎Бүгін бірінші рет емес.
Dialogue: 0,0:12:52.68,0:12:54.48,Bottom,,0000,0000,0000,,Сіз мені байқамадым деп ойладыңыз ба?
Dialogue: 0,0:12:52.77,0:12:54.48,Top,,0000,0000,0000,,Сіз байқамадым деп ойладыңыз ба?
Dialogue: 0,0:12:55.48,0:12:56.60,Bottom,,0000,0000,0000,,Мен бір қолымда оқталған винтовка ұстап тұрмын
Dialogue: 0,0:12:55.56,0:12:58.73,Top,,0000,0000,0000,,Ал, әйелдерді кемітпе.
Dialogue: 0,0:12:56.69,0:12:58.73,Bottom,,0000,0000,0000,,Қыздың интуициясы, білесің бе?
Dialogue: 0,0:12:58.81,0:12:59.82,Bottom,,0000,0000,0000,,Қандай қыз?
Dialogue: 0,0:12:58.81,0:13:01.32,Top,,0000,0000,0000,,Әйел? Мен сені өлтіремін
Dialogue: 0,0:12:59.90,0:13:01.28,Bottom,,0000,0000,0000,,Өтірік, жеккөру, құлдырау—әр күнді лақтыру
Dialogue: 0,0:13:01.40,0:13:02.49,Top,,0000,0000,0000,,‎(Екі адам күледі)
Dialogue: 0,0:13:03.07,0:13:04.95,Top,,0000,0000,0000,,Міне солай.
Dialogue: 0,0:13:03.19,0:13:07.28,Bottom,,0000,0000,0000,,Мен мұны мұқият бақылайтын жалғыз сенсің, білесің.
Dialogue: 0,0:13:05.03,0:13:07.07,Top,,0000,0000,0000,,‎Бұл мен саған қарап тұрмын дегенді білдірмейді.
Dialogue: 0,0:13:08.20,0:13:09.45,Top,,0000,0000,0000,,Сәлем Дэвид
Dialogue: 0,0:13:08.20,0:13:11.49,Bottom,,0000,0000,0000,,Кел, Дэвид. Не болды?
Dialogue: 0,0:13:10.58,0:13:12.08,Top,,0000,0000,0000,,Бірдеңе болды ма?
Dialogue: 0,0:13:12.66,0:13:13.83,Bottom,,0000,0000,0000,,Юкине, сонда ісіңді бітірген соң дүкенге бар.
Dialogue: 0,0:13:12.79,0:13:15.37,Top,,0000,0000,0000,,№. Сіз оны әлі де жасырғыңыз келе ме?
Dialogue: 0,0:13:13.91,0:13:15.33,Bottom,,0000,0000,0000,,Мен бұқаны кесіп ал дедім.
Dialogue: 0,0:13:15.41,0:13:17.12,Bottom,,0000,0000,0000,,Оның саған қатысы жоқ.
Dialogue: 0,0:13:15.46,0:13:17.12,Top,,0000,0000,0000,,‎Ребеккаға қатысы жоқ
Dialogue: 0,0:13:17.21,0:13:19.63,Top,,0000,0000,0000,,Маңызды емес нәрсе бар ма?
Dialogue: 0,0:13:17.21,0:13:21.38,Bottom,,0000,0000,0000,,Бұлай емес. Мен өз өмірімді сенің қолыңа тапсырамын.
Dialogue: 0,0:13:19.71,0:13:21.38,Top,,0000,0000,0000,,Өмірімді саған аманат еттім.
Dialogue: 0,0:13:22.80,0:13:24.09,Bottom,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:13:22.84,0:13:23.84,Top,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:13:23.92,0:13:25.38,Top,,0000,0000,0000,,‎(жүгіру)
Dialogue: 0,0:13:26.47,0:13:28.01,Bottom,,0000,0000,0000,,Мен ойладым...
Dialogue: 0,0:13:26.47,0:13:29.30,Top,,0000,0000,0000,,А, Дэвид?
Dialogue: 0,0:13:28.59,0:13:29.43,Bottom,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:30.01,0:13:32.31,Top,,0000,0000,0000,,Имплантантты біраз уақытқа пайдаланбаңыз.
Dialogue: 0,0:13:30.05,0:13:32.39,Bottom,,0000,0000,0000,,Импланттарды біраз уақытқа тастау керек.
Dialogue: 0,0:13:32.97,0:13:35.14,Bottom,,0000,0000,0000,,Уайымдамаңыз. Мен сенің арқаңды алдым!
Dialogue: 0,0:13:32.97,0:13:35.14,Top,,0000,0000,0000,,Мен бәрін қамтыдым!
Dialogue: 0,0:13:35.81,0:13:36.77,Bottom,,0000,0000,0000,,Сіз?
Dialogue: 0,0:13:35.89,0:13:36.77,Top,,0000,0000,0000,,Сіз?
Dialogue: 0,0:13:36.85,0:13:38.52,Bottom,,0000,0000,0000,,Мен байсалдымын.
Dialogue: 0,0:13:36.85,0:13:38.52,Top,,0000,0000,0000,,Мен байсалдымын.
Dialogue: 0,0:13:39.86,0:13:43.19,Bottom,,0000,0000,0000,,Менің ағамды ренжіткен психотропты есіңізде ме?
Dialogue: 0,0:13:39.86,0:13:43.40,Top,,0000,0000,0000,,Аникиді өлтірген киберпсихо жігіт есіңізде ме?
Dialogue: 0,0:13:43.90,0:13:45.24,Bottom,,0000,0000,0000,,Оқу, оқу
Dialogue: 0,0:13:43.98,0:13:46.53,Top,,0000,0000,0000,,А, сен...
Dialogue: 0,0:13:45.32,0:13:49.41,Bottom,,0000,0000,0000,,Мен... сенің осылай болғаныңды көргім келмейді.
Dialogue: 0,0:13:47.36,0:13:49.41,Top,,0000,0000,0000,,Мен бұлай болғым келмейді.
Dialogue: 0,0:13:51.12,0:13:51.95,Bottom,,0000,0000,0000,,Оқу, оқу
Dialogue: 0,0:13:51.24,0:13:51.99,Top,,0000,0000,0000,,А
Dialogue: 0,0:13:56.75,0:13:57.41,Top,,0000,0000,0000,,А...
Dialogue: 0,0:13:57.50,0:13:58.29,Top,,0000,0000,0000,,‎(тозған дыбыс)
Dialogue: 0,0:14:15.39,0:14:16.14,Top,,0000,0000,0000,,‎Ха...
Dialogue: 0,0:14:24.82,0:14:27.82,Bottom,,0000,0000,0000,,Олар әлі де жүгірушілерді жіберіп жатыр ма?
Dialogue: 0,0:14:24.86,0:14:27.36,Top,,0000,0000,0000,,Сіз әлі іздеп жүрген жүгірушілер бар ма?
Dialogue: 0,0:14:36.16,0:14:38.58,Top,,0000,0000,0000,,‎(ТД аудиосы) ‎(Lucy) Иә?
Dialogue: 0,0:14:47.30,0:14:49.88,Top,,0000,0000,0000,,‎(Holo Communication: Kiwi) ‎Қалған жалғыз нәрсе - нысана.
Dialogue: 0,0:14:49.97,0:14:51.47,Top,,0000,0000,0000,,Ақпаратқа сәйкес.
Dialogue: 0,0:14:51.55,0:14:53.35,Top,,0000,0000,0000,,‎(құлыпты ашу дыбысы)
Dialogue: 0,0:14:53.43,0:14:54.47,Top,,0000,0000,0000,,ашылды
Dialogue: 0,0:14:55.06,0:14:56.93,Top,,0000,0000,0000,,‎Кіру жолы қорғалған
Dialogue: 0,0:14:59.73,0:15:00.60,Bottom,,0000,0000,0000,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:15:00.10,0:15:01.77,Top,,0000,0000,0000,,‎Хмм? Ол кім?
Dialogue: 0,0:15:00.69,0:15:03.11,Bottom,,0000,0000,0000,,Сіз кімсіз? W-не…
Dialogue: 0,0:15:01.85,0:15:02.90,Top,,0000,0000,0000,,‎Не... не!
Dialogue: 0,0:15:13.95,0:15:15.41,Top,,0000,0000,0000,,‎Ах... аа аа!
Dialogue: 0,0:15:17.41,0:15:19.16,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:15:20.87,0:15:22.88,Top,,0000,0000,0000,,(Киви) Дэвид, сен оны өлтірдің бе?
Dialogue: 0,0:15:22.96,0:15:24.75,Top,,0000,0000,0000,,Ішінде тағы бір адам қалды.
Dialogue: 0,0:15:24.84,0:15:26.50,Top,,0000,0000,0000,,Сол жаққа қарай
Dialogue: 0,0:15:27.00,0:15:30.47,Top,,0000,0000,0000,,Бұл жаман. Ол бөлмеге келеді. Эй, тыңдап тұрсың ба?
Dialogue: 0,0:15:30.55,0:15:31.88,Top,,0000,0000,0000,,Сәлем! (Құлаған қораптың дыбысы)
Dialogue: 0,0:15:34.55,0:15:35.39,Bottom,,0000,0000,0000,,Күтіңіз…
Dialogue: 0,0:15:34.64,0:15:35.39,Top,,0000,0000,0000,,Күте тұрыңыз
Dialogue: 0,0:15:37.01,0:15:37.64,Top,,0000,0000,0000,,А...
Dialogue: 0,0:15:37.72,0:15:41.35,Top,,0000,0000,0000,,‎(қорқынышты күлкі)
Dialogue: 0,0:15:41.44,0:15:42.27,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:15:47.23,0:15:49.53,Top,,0000,0000,0000,,(Киви) Эй, сен мені естисің бе? Дэвид
Dialogue: 0,0:15:50.03,0:15:51.74,Top,,0000,0000,0000,,‎‎Хмм... аа
Dialogue: 0,0:15:51.82,0:15:54.32,Top,,0000,0000,0000,,‎(Киви) ‎Мен саған ертерек қоңырау шалған едім.
Dialogue: 0,0:15:54.41,0:15:56.53,Top,,0000,0000,0000,,Бір адам сонда қайтып кетті.
Dialogue: 0,0:15:57.41,0:15:58.87,Top,,0000,0000,0000,,емделді
Dialogue: 0,0:16:02.87,0:16:03.75,Top,,0000,0000,0000,,Дереу кетіңіз
Dialogue: 0,0:16:17.10,0:16:19.31,Top,,0000,0000,0000,,‎Ха… Дэвид!
Dialogue: 0,0:16:18.22,0:16:19.60,Bottom,,0000,0000,0000,,Дэвид!
Dialogue: 0,0:16:26.48,0:16:28.48,Top,,0000,0000,0000,,‎(Липпардоку) Сіз ояусыз ба?
Dialogue: 0,0:16:26.48,0:16:28.57,Bottom,,0000,0000,0000,,Көтерілу және жарқырау.
Dialogue: 0,0:16:29.15,0:16:30.32,Top,,0000,0000,0000,,‎Құжат…
Dialogue: 0,0:16:29.19,0:16:30.19,Bottom,,0000,0000,0000,,Құжат…
Dialogue: 0,0:16:30.28,0:16:32.53,Bottom,,0000,0000,0000,,Симптомдар басыла ма?
Dialogue: 0,0:16:30.40,0:16:32.61,Top,,0000,0000,0000,,‎(Липердоку) ‎Аздап тынышталдыңыз ба?
Dialogue: 0,0:16:32.61,0:16:33.65,Bottom,,0000,0000,0000,,Иә…
Dialogue: 0,0:16:32.70,0:16:33.65,Top,,0000,0000,0000,,О
Dialogue: 0,0:16:37.70,0:16:40.45,Top,,0000,0000,0000,,‎(Lippardoc) Қашаннан бері? Қашан?
Dialogue: 0,0:16:37.78,0:16:39.33,Bottom,,0000,0000,0000,,Ол қашан басталды?
Dialogue: 0,0:16:39.41,0:16:40.49,Bottom,,0000,0000,0000,,Жер
Dialogue: 0,0:16:40.54,0:16:44.58,Top,,0000,0000,0000,,Қолдың қалтырауы, бас айналуы, жүрек айнуы, белгілері болды ма?
Dialogue: 0,0:16:40.58,0:16:44.50,Bottom,,0000,0000,0000,,Қол діріл, бас айналу, жүрек айну, әдеттегі күдіктілер.
Dialogue: 0,0:16:44.58,0:16:47.00,Bottom,,0000,0000,0000,,Біраз уақыт бұрын.
Dialogue: 0,0:16:44.67,0:16:46.92,Top,,0000,0000,0000,,‎Аа... сәл бұрын
Dialogue: 0,0:16:47.00,0:16:49.00,Top,,0000,0000,0000,,‎Неге бірден айтпадың?
Dialogue: 0,0:16:47.08,0:16:49.29,Bottom,,0000,0000,0000,,Маған неге айтпадың?
Dialogue: 0,0:16:49.38,0:16:51.17,Bottom,,0000,0000,0000,,Бұл уақытша деп ойладым.
Dialogue: 0,0:16:49.59,0:16:51.17,Top,,0000,0000,0000,,Уақытша
Dialogue: 0,0:16:51.26,0:16:54.30,Bottom,,0000,0000,0000,,Жанама әсерлер сізді қуып жететін сияқты.
Dialogue: 0,0:16:51.26,0:16:54.43,Top,,0000,0000,0000,,‎Соңында, сізде де жанама әсерлер бар ма?
Dialogue: 0,0:16:54.38,0:16:59.43,Bottom,,0000,0000,0000,,Әрине, сіздің осы уақытқа дейін жақсы болғаныңыз ақылсыз.
Dialogue: 0,0:16:54.51,0:16:58.93,Top,,0000,0000,0000,,Мен осы уақытқа дейін жақсы болғаныма қарамастан, бұл қалыпты емес еді.
Dialogue: 0,0:16:59.51,0:17:01.06,Bottom,,0000,0000,0000,,Неге қазір?
Dialogue: 0,0:16:59.51,0:17:01.06,Top,,0000,0000,0000,,Неге қазір?
Dialogue: 0,0:17:01.14,0:17:04.85,Bottom,,0000,0000,0000,,Хромды біраз уақытқа қалдырыңыз.
Dialogue: 0,0:17:01.14,0:17:04.98,Top,,0000,0000,0000,,Имплантты біраз уақытқа белсендіруден бас тартыңыз.
Dialogue: 0,0:17:04.94,0:17:08.40,Bottom,,0000,0000,0000,,Сіз қазірдің өзінде психозонада бір аяқсызсыз.
Dialogue: 0,0:17:05.06,0:17:08.44,Top,,0000,0000,0000,,‎Киберпсихозға бір қадам жақындау
Dialogue: 0,0:17:08.48,0:17:11.07,Bottom,,0000,0000,0000,,Онда маған күштірек дәрі беріңіз!
Dialogue: 0,0:17:08.52,0:17:11.07,Top,,0000,0000,0000,,‎Олай болса маған күштірек дәрі беріңіз!
Dialogue: 0,0:17:11.15,0:17:12.40,Top,,0000,0000,0000,,‎Эй, сәлем
Dialogue: 0,0:17:11.15,0:17:16.11,Bottom,,0000,0000,0000,,Боқ. Сіз мені естімейсіз. Әлде сен есіңді жоғалтып алдың ба?
Dialogue: 0,0:17:12.48,0:17:16.41,Top,,0000,0000,0000,,Сіз киберпсихозға айналдыңыз ба?
Dialogue: 0,0:17:16.20,0:17:18.95,Bottom,,0000,0000,0000,,Мұндай ғажайып дәрі жоқ...
Dialogue: 0,0:17:16.49,0:17:18.95,Top,,0000,0000,0000,,‎Егер мұндай қолайлы дәрі болса...
Dialogue: 0,0:17:19.03,0:17:19.70,Top,,0000,0000,0000,,‎(Қырсық!)
Dialogue: 0,0:17:20.37,0:17:26.46,Bottom,,0000,0000,0000,,Мен әзіл үшін келдім деп ойлайсыз ба? Менің ақшамды ал...
Dialogue: 0,0:17:20.41,0:17:23.04,Top,,0000,0000,0000,,Жарайды, маған бер.
Dialogue: 0,0:17:23.62,0:17:25.83,Top,,0000,0000,0000,,Шу шығармаңыз
Dialogue: 0,0:17:26.54,0:17:27.83,Top,,0000,0000,0000,,‎Сен тек ақшаны ал!
Dialogue: 0,0:17:26.54,0:17:28.88,Bottom,,0000,0000,0000,,және маған дәрі беріңіз!
Dialogue: 0,0:17:27.83,0:17:29.04,Top,,0000,0000,0000,,‎Сен тек ақшаны ал! (шу дыбысы)
Dialogue: 0,0:17:28.96,0:17:30.34,Bottom,,0000,0000,0000,,Дэвид!
Dialogue: 0,0:17:29.13,0:17:30.34,Top,,0000,0000,0000,,‎(Люси) Дэвид!
Dialogue: 0,0:17:30.96,0:17:33.96,Top,,0000,0000,0000,,‎(Липпердоктың мазасыз дауысы)
Dialogue: 0,0:17:35.22,0:17:38.34,Top,,0000,0000,0000,,‎(жөтел)
Dialogue: 0,0:17:39.51,0:17:42.10,Top,,0000,0000,0000,,‎(Липардоку) Сора, бұл соңғы рецепт.
Dialogue: 0,0:17:39.51,0:17:45.10,Bottom,,0000,0000,0000,,Онда. Сіздің соңғы рецептіңіз. Тоғыз есе стандартты доза, тоғыз күн бойы жақсы.
Dialogue: 0,0:17:42.18,0:17:47.94,Top,,0000,0000,0000,,9x резервуар 9 күн бойы шетінен өту үшін жеткілікті
Dialogue: 0,0:17:45.18,0:17:49.73,Bottom,,0000,0000,0000,,Ол сізді тікелей шетінен жəне тозаққа жібереді.
Dialogue: 0,0:17:48.02,0:17:49.69,Top,,0000,0000,0000,,Тура тозаққа
Dialogue: 0,0:17:50.40,0:17:53.48,Bottom,,0000,0000,0000,,Кешіріңіз. Мен мұның қайталануына жол бермеймін.
Dialogue: 0,0:17:50.48,0:17:53.53,Top,,0000,0000,0000,,Бұл жаман болды. Мен мұны қайталамаймын.
Dialogue: 0,0:17:53.57,0:17:54.69,Bottom,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:17:53.61,0:17:57.20,Top,,0000,0000,0000,,‎(Қайта өңделген құжат) Жарайды. Мен сізге бұл дәріні беремін.
Dialogue: 0,0:17:54.78,0:17:59.87,Bottom,,0000,0000,0000,,Сізге бұл дәрі-дәрмек қажет екендігі сіздің енді бұл жерге оралмайтыныңызды білдіреді.
Dialogue: 0,0:17:57.28,0:17:59.87,Top,,0000,0000,0000,,Сіз бұл жерге енді қайтып оралмайсыз.
Dialogue: 0,0:18:01.12,0:18:04.87,Bottom,,0000,0000,0000,,Бала XBD-ді итеріп жатыр, ал қазір…
Dialogue: 0,0:18:01.28,0:18:04.87,Top,,0000,0000,0000,,Артқы BD (Beady) Мен оны сатуға мәжбүр болған бала соншалықты өзгереді деп ойламаппын.
Dialogue: 0,0:18:05.66,0:18:10.54,Bottom,,0000,0000,0000,,Аңыз болыңыз немесе панктар не істесе де.
Dialogue: 0,0:18:05.75,0:18:10.17,Top,,0000,0000,0000,,‎Ең жақсы жағдайда бұл аңыз. Бұл үйреншікті жағдай.
Dialogue: 0,0:18:14.34,0:18:15.63,Top,,0000,0000,0000,,‎(есік жабылған дыбыс)
Dialogue: 0,0:18:18.59,0:18:20.89,Bottom,,0000,0000,0000,,Келесі армандаушы үшін тағы бір ертегі…
Dialogue: 0,0:18:18.72,0:18:20.89,Top,,0000,0000,0000,,‎(Липпардок) Мен оқиғаны айтып беремін.
Dialogue: 0,0:18:21.39,0:18:23.51,Top,,0000,0000,0000,,‎(Люси) Дэвид Уэйт.
Dialogue: 0,0:18:21.39,0:18:25.31,Bottom,,0000,0000,0000,,Давид! Күте тұрыңыз! Бұл не болды?
Dialogue: 0,0:18:24.06,0:18:25.31,Top,,0000,0000,0000,,Бұрын бұл не болды?
Dialogue: 0,0:18:25.89,0:18:27.31,Bottom,,0000,0000,0000,,Жігіттерге айтпа.
Dialogue: 0,0:18:25.89,0:18:27.31,Top,,0000,0000,0000,,Барлығына айтпа
Dialogue: 0,0:18:28.10,0:18:29.31,Bottom,,0000,0000,0000,,Мен түсінбеймін.
Dialogue: 0,0:18:28.31,0:18:29.31,Top,,0000,0000,0000,,Сіз нені айтып тұрсыз?
Dialogue: 0,0:18:33.40,0:18:33.98,Top,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:18:33.40,0:18:34.23,Bottom,,0000,0000,0000,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:18:39.70,0:18:43.20,Bottom,,0000,0000,0000,,Сіздің денеңіз, сіздің ақыл-ойыңыз ... Олардың шегі бар, Дэвид. Сіз мұны білдіңіз.
Dialogue: 0,0:18:39.74,0:18:42.91,Top,,0000,0000,0000,,Егер сіз тым көп импланттарды салсаңыз, шектеу бір күні келеді.
Dialogue: 0,0:18:43.28,0:18:46.58,Bottom,,0000,0000,0000,,Қалыпты дәрілер енді сізге көмектеспейді.
Dialogue: 0,0:18:43.41,0:18:45.83,Top,,0000,0000,0000,,‎Оны енді қарапайым супрессанттармен басу мүмкін емес.
Dialogue: 0,0:18:46.66,0:18:48.04,Bottom,,0000,0000,0000,,Жұмыстан кететін уақыт емес пе?
Dialogue: 0,0:18:46.87,0:18:48.04,Top,,0000,0000,0000,,Жетеді, солай ма?
Dialogue: 0,0:18:49.21,0:18:53.96,Bottom,,0000,0000,0000,,Мен сенің өзіңе бұлай істегеніңді көре алмаймын. Кибербағдарламаның көлемін азайтыңыз…
Dialogue: 0,0:18:49.25,0:18:51.42,Top,,0000,0000,0000,,Мен сенің өзгергеніңді көре алмаймын.
Dialogue: 0,0:18:52.08,0:18:53.88,Top,,0000,0000,0000,,Импланттарды алып тастаңыз
Dialogue: 0,0:18:54.63,0:18:56.09,Bottom,,0000,0000,0000,,Мен мұны істей алмаймын.
Dialogue: 0,0:18:54.63,0:18:56.21,Top,,0000,0000,0000,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:18:56.17,0:18:57.05,Bottom,,0000,0000,0000,,Неліктен жоқ?
Dialogue: 0,0:18:56.30,0:18:57.05,Top,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:18:58.09,0:19:02.30,Bottom,,0000,0000,0000,,Анам мен Мэн... Олардың бәрі маған бір нәрсе қалдырды.
Dialogue: 0,0:18:58.17,0:19:02.30,Top,,0000,0000,0000,,Менің анам да, Мэн де маған бір нәрсені сеніп тапсырып өлді.
Dialogue: 0,0:19:03.30,0:19:05.31,Bottom,,0000,0000,0000,,Бірақ мен әлі ештеңе істеген жоқпын.
Dialogue: 0,0:19:03.35,0:19:05.39,Top,,0000,0000,0000,,Мен әлі ештеңе істеген жоқпын.
Dialogue: 0,0:19:05.39,0:19:08.77,Bottom,,0000,0000,0000,,Бірақ сіз бұлай жалғастыра алмайсыз...
Dialogue: 0,0:19:05.47,0:19:06.64,Top,,0000,0000,0000,,Мұндай нәрсе...
Dialogue: 0,0:19:07.27,0:19:08.77,Top,,0000,0000,0000,,Өйткені бұл одан да көп...
Dialogue: 0,0:19:08.85,0:19:10.98,Bottom,,0000,0000,0000,,Ято ақша әкелмейтіндіктен, жартылай жұмыс, жартылай жұмыс.
Dialogue: 0,0:19:08.85,0:19:11.06,Top,,0000,0000,0000,,Мен үшін бәрібір
Dialogue: 0,0:19:11.06,0:19:15.52,Bottom,,0000,0000,0000,,Сіз мұны қалай айта аласыз? Сіз шынымен өзіңізді ерекшемін деп ойлайсыз ба?
Dialogue: 0,0:19:11.15,0:19:15.52,Top,,0000,0000,0000,,‎(Люси) Неге? Сіз шынымен өзіңізді ерекшемін деп ойлайсыз ба?
Dialogue: 0,0:19:16.61,0:19:18.49,Top,,0000,0000,0000,,Мен Сандевистанға төтеп бере алдым.
Dialogue: 0,0:19:16.61,0:19:21.11,Bottom,,0000,0000,0000,,Сандевистанға төтеп бердім. Мен қалыпты емеспін.
Dialogue: 0,0:19:19.44,0:19:21.11,Top,,0000,0000,0000,,Қалыпты нәрсе жоқ.
Dialogue: 0,0:19:22.49,0:19:28.33,Bottom,,0000,0000,0000,,Демек, сен басқаларға қарағанда біршама мықтысың. Бірақ сен әлі адамсың.
Dialogue: 0,0:19:22.57,0:19:25.66,Top,,0000,0000,0000,,Адамдарға қарағанда біршама төзімді болуы мүмкін
Dialogue: 0,0:19:26.24,0:19:28.41,Top,,0000,0000,0000,,‎Бірақ сіз қарапайым адамсыз.
Dialogue: 0,0:19:28.50,0:19:29.25,Top,,0000,0000,0000,,‎(Дэн!)
Dialogue: 0,0:19:31.21,0:19:32.83,Bottom,,0000,0000,0000,,Мен әйелді атып тастадым.
Dialogue: 0,0:19:31.21,0:19:33.00,Top,,0000,0000,0000,,Әйелді атып өлтірді
Dialogue: 0,0:19:32.92,0:19:33.75,Bottom,,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:19:33.08,0:19:33.75,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:35.09,0:19:38.13,Bottom,,0000,0000,0000,,Ол анаммен бір жаста болатын.
Dialogue: 0,0:19:35.09,0:19:38.13,Top,,0000,0000,0000,,Мен анаммен жастамын.
Dialogue: 0,0:19:38.88,0:19:40.63,Bottom,,0000,0000,0000,,Оның да мендей ұлы болды.
Dialogue: 0,0:19:38.92,0:19:40.63,Top,,0000,0000,0000,,Менің өлшемімде балалар болды.
Dialogue: 0,0:19:42.97,0:19:45.60,Bottom,,0000,0000,0000,,Зиянсыз адам. Қалыпты адам.
Dialogue: 0,0:19:42.97,0:19:45.68,Top,,0000,0000,0000,,‎Ол қылмыскер емес, қарапайым адам еді.
Dialogue: 0,0:19:47.10,0:19:50.10,Bottom,,0000,0000,0000,,Мен енді қанша өлтіргенімді білмеймін.
Dialogue: 0,0:19:47.10,0:19:50.10,Top,,0000,0000,0000,,Осы уақытқа дейін қанша адамды өлтіргенімді де білмеймін.
Dialogue: 0,0:19:51.73,0:19:54.10,Bottom,,0000,0000,0000,,Бұл мені енді кідіртуге де мәжбүр етпейді.
Dialogue: 0,0:19:51.81,0:19:54.15,Top,,0000,0000,0000,,‎Маған адамдарды өлтіру маңызды емес.
Dialogue: 0,0:19:55.48,0:19:58.98,Bottom,,0000,0000,0000,,Мүмкін мен шынымен есінен танып бара жатқан шығармын.
Dialogue: 0,0:19:55.52,0:19:58.98,Top,,0000,0000,0000,,Мүмкін мен қазірдің өзінде жынды шығармын
Dialogue: 0,0:19:59.61,0:20:00.53,Bottom,,0000,0000,0000,,Дэвид…
Dialogue: 0,0:19:59.65,0:20:00.53,Top,,0000,0000,0000,,‎Дэвид…
Dialogue: 0,0:20:01.45,0:20:05.20,Bottom,,0000,0000,0000,,Мен қалыпты емеспін. Бұрын айтқаныңыздай, мен басқашамын.
Dialogue: 0,0:20:01.49,0:20:05.28,Top,,0000,0000,0000,,Бұл қалыпты жағдай емес, мен енді сен сияқты емеспін
Dialogue: 0,0:20:05.28,0:20:06.62,Bottom,,0000,0000,0000,,Сіз жоқсыз.
Dialogue: 0,0:20:05.37,0:20:08.04,Top,,0000,0000,0000,,‎(Люси) Бұл басқаша емес. Ол басқаша.
Dialogue: 0,0:20:06.70,0:20:07.99,Bottom,,0000,0000,0000,,Менмін!
Dialogue: 0,0:20:08.70,0:20:10.33,Bottom,,0000,0000,0000,,Сіз жоқсыз.
Dialogue: 0,0:20:08.70,0:20:12.33,Top,,0000,0000,0000,,‎(Люси) Бұл басқаша емес. Сіз мұны істей алмайсыз.
Dialogue: 0,0:20:10.41,0:20:12.12,Bottom,,0000,0000,0000,,Сіз түсінбейсіз.
Dialogue: 0,0:20:12.41,0:20:13.50,Top,,0000,0000,0000,,‎(Люси) Иә?
Dialogue: 0,0:20:13.58,0:20:17.00,Bottom,,0000,0000,0000,,Сіз Мэн қайтыс болғаннан кейін экипаждан шықтыңыз.
Dialogue: 0,0:20:13.58,0:20:17.04,Top,,0000,0000,0000,,Бастысы қайтыс болғаннан кейін командаға қосылмадың, солай ма?
Dialogue: 0,0:20:17.09,0:20:18.50,Bottom,,0000,0000,0000,,Себебі…
Dialogue: 0,0:20:17.13,0:20:18.50,Top,,0000,0000,0000,,‎(Люси) Бұл...
Dialogue: 0,0:20:18.59,0:20:20.26,Bottom,,0000,0000,0000,,Мен сені кінәлап отырған жоқпын.
Dialogue: 0,0:20:18.59,0:20:21.51,Top,,0000,0000,0000,,Бұл жақсы. (Люси) Неге?
Dialogue: 0,0:20:20.34,0:20:21.51,Bottom,,0000,0000,0000,,Неліктен жоқ?
Dialogue: 0,0:20:21.59,0:20:24.38,Bottom,,0000,0000,0000,,Бұл өмірде өмір сүрудің қажеті жоқ.
Dialogue: 0,0:20:21.59,0:20:24.47,Top,,0000,0000,0000,,‎Сен мен сияқты болмайсың.
Dialogue: 0,0:20:24.47,0:20:27.89,Bottom,,0000,0000,0000,,Жоқ, Дэвид. Мен бұл емес…
Dialogue: 0,0:20:24.55,0:20:27.55,Top,,0000,0000,0000,,(Люси) Жоқ, Дэвид, мен...
Dialogue: 0,0:20:27.97,0:20:30.81,Bottom,,0000,0000,0000,,Сонда қайтесің?
Dialogue: 0,0:20:28.06,0:20:30.39,Top,,0000,0000,0000,,‎Мен командаға орала аламын ба?
Dialogue: 0,0:20:30.89,0:20:34.31,Bottom,,0000,0000,0000,,Бірлесіп жұмыс істеген кездегі жағдайға оралайық.
Dialogue: 0,0:20:30.89,0:20:34.31,Top,,0000,0000,0000,,‎Бұрынғыдай, бірге жасайық.
Dialogue: 0,0:20:38.40,0:20:41.65,Bottom,,0000,0000,0000,,Мен дәл қазір алмаймын. Мені тағы біраз күтіңіз.
Dialogue: 0,0:20:38.48,0:20:41.53,Top,,0000,0000,0000,,Мен мұны қазір істей алмаймын. Тағы біраз күтіңіз.
Dialogue: 0,0:20:41.61,0:20:42.57,Top,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:20:41.74,0:20:42.57,Bottom,,0000,0000,0000,,Не үшін?
Dialogue: 0,0:20:43.65,0:20:46.28,Bottom,,0000,0000,0000,,Алдымен бір нәрсе істеуім керек.
Dialogue: 0,0:20:43.70,0:20:46.37,Top,,0000,0000,0000,,(Люси) Маған бір нәрсе істеу керек.
Dialogue: 0,0:20:46.37,0:20:48.12,Bottom,,0000,0000,0000,,Қалай?
Dialogue: 0,0:20:46.45,0:20:49.87,Top,,0000,0000,0000,,‎Бұл не? (Люси) Мен сізге толығырақ айта алмаймын.
Dialogue: 0,0:20:48.20,0:20:49.79,Bottom,,0000,0000,0000,,Мен айта алмаймын.
Dialogue: 0,0:20:50.41,0:20:51.50,Bottom,,0000,0000,0000,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:20:50.45,0:20:52.70,Top,,0000,0000,0000,,Неліктен? (Люси) Кешіріңіз
Dialogue: 0,0:20:51.58,0:20:52.54,Bottom,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:20:53.21,0:20:55.00,Bottom,,0000,0000,0000,,Өйткені сен маған сенбейсің.
Dialogue: 0,0:20:53.21,0:20:55.29,Top,,0000,0000,0000,,‎Сен маған да айта алмайсың ба?
Dialogue: 0,0:20:55.71,0:20:57.00,Bottom,,0000,0000,0000,,Мұнда.
Dialogue: 0,0:20:55.79,0:20:57.17,Top,,0000,0000,0000,,‎(Люси) Кешіріңіз.
Dialogue: 0,0:20:58.09,0:21:01.17,Bottom,,0000,0000,0000,,Жарайды. Мен бұл туралы сенен сұрауды доғарамын.
Dialogue: 0,0:20:58.29,0:21:01.26,Top,,0000,0000,0000,,‎Жарайды, мен енді сенен сұрамаймын.
Dialogue: 0,0:21:01.26,0:21:02.09,Bottom,,0000,0000,0000,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,0:21:01.34,0:21:02.09,Top,,0000,0000,0000,,‎(Люси) Иә.
Dialogue: 0,0:21:03.72,0:21:06.39,Top,,0000,0000,0000,,‎Біз өз жолымызбен жүргеніміз дұрыс болар еді
Dialogue: 0,0:21:03.72,0:21:07.43,Bottom,,0000,0000,0000,,Мүмкін біз өз жолымызбен жүруіміз керек шығар.
Dialogue: 0,0:21:06.47,0:21:08.10,Top,,0000,0000,0000,,Мүмкін жақсы шығар.
Dialogue: 0,0:21:08.18,0:21:10.60,Bottom,,0000,0000,0000,,Жоқ! Бұл дұрыс емес Дэвид.
Dialogue: 0,0:21:08.18,0:21:10.60,Top,,0000,0000,0000,,Жоқ! Солай емес пе, Дэвид?
Dialogue: 0,0:21:18.11,0:21:21.86,Bottom,,0000,0000,0000,,Кешіріңіз, Дэвид. Мен баруым керек.
Dialogue: 0,0:21:18.15,0:21:21.86,Top,,0000,0000,0000,,Кешіріңіз, Дэвид, мен кетуім керек...
Dialogue: 0,0:21:21.94,0:21:24.36,Bottom,,0000,0000,0000,,Иә? Қайда?
Dialogue: 0,0:21:21.94,0:21:24.36,Top,,0000,0000,0000,,‎Е... қайда?
Dialogue: 0,0:21:25.82,0:21:27.20,Bottom,,0000,0000,0000,,Менің кетуім керек...
Dialogue: 0,0:21:25.95,0:21:27.41,Top,,0000,0000,0000,,Менің кетуім керек
Dialogue: 0,0:21:29.28,0:21:30.74,Bottom,,0000,0000,0000,,Алдымен, ортаңғы және көрсеткі саусақтарыңызды осылайша қосыңыз,
Dialogue: 0,0:21:29.32,0:21:30.70,Top,,0000,0000,0000,,Түсіндім
Dialogue: 0,0:21:30.78,0:21:32.37,Top,,0000,0000,0000,,Қайтып келгенде дұрыстап сөйлесейік.
Dialogue: 0,0:21:30.83,0:21:32.37,Bottom,,0000,0000,0000,,Мен үйге келгенде сөйлесеміз.
Dialogue: 0,0:21:33.08,0:21:34.91,Bottom,,0000,0000,0000,,Мені күт.
Dialogue: 0,0:21:33.20,0:21:34.91,Top,,0000,0000,0000,,Сондықтан күте тұрыңыз.
Dialogue: 0,0:21:49.18,0:21:51.76,Bottom,,0000,0000,0000,,Бұрынғы жүгірушімен бірдей идентификатор.
Dialogue: 0,0:21:49.26,0:21:51.76,Top,,0000,0000,0000,,‎(Люси) ‎Алдыңғы жүгіруші идентификаторымен бірдей
Dialogue: 0,0:21:52.93,0:21:54.31,Bottom,,0000,0000,0000,,Міне, сіз…
Dialogue: 0,0:21:53.02,0:21:54.31,Top,,0000,0000,0000,,Мен таптым.
Dialogue: 0,0:21:57.39,0:21:58.81,Top,,0000,0000,0000,,‎(Сым тартылып жатқан дыбыс)
Dialogue: 0,0:22:01.82,0:22:03.32,Top,,0000,0000,0000,,‎(шу дыбысы)
Dialogue: 0,0:22:04.03,0:22:04.82,Top,,0000,0000,0000,,Ғұн
Dialogue: 0,0:22:04.90,0:22:05.57,Top,,0000,0000,0000,,Ах!
Dialogue: 0,0:22:06.11,0:22:06.82,Top,,0000,0000,0000,,Гах!
Dialogue: 0,0:22:12.70,0:22:14.08,Top,,0000,0000,0000,,А... а...
Dialogue: 0,0:22:14.16,0:22:15.75,Top,,0000,0000,0000,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:22:15.83,0:22:17.08,Top,,0000,0000,0000,,≪Ол күлмейді≫
Dialogue: 0,0:22:19.12,0:22:22.34,Bottom,,0000,0000,0000,,Бұл оңай болады деп ойламадым.
Dialogue: 0,0:22:19.33,0:22:22.46,Top,,0000,0000,0000,,‎(Фарадей) ‎Мен сен оны оңай аласың деп ешқашан ойламаппын.
Dialogue: 0,0:22:23.38,0:22:24.21,Top,,0000,0000,0000,,‎(Етік!)
Dialogue: 0,0:22:26.30,0:22:29.93,Bottom,,0000,0000,0000,,Бұл Арасакадағы төлқұжатымыз.
Dialogue: 0,0:22:26.38,0:22:29.51,Top,,0000,0000,0000,,Бұл сувенир Арасакаға төлқұжатыңыз болады.
Dialogue: 0,0:22:30.01,0:22:32.30,Bottom,,0000,0000,0000,,Өте жақсы жұмыс, Киви.
Dialogue: 0,0:22:30.05,0:22:31.97,Top,,0000,0000,0000,,‎Жарайсың киви
Dialogue: 0,0:22:37.52,0:22:42.52,Top,,0000,0000,0000,,♪~
Dialogue: 0,0:24:02.52,0:24:07.52,Top,,0000,0000,0000,,~♪
Dialogue: 0,0:24:09.02,0:24:15.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory