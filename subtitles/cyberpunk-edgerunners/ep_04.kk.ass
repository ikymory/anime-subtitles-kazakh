Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.46,0:00:08.71,Top,,0000,0000,0000,,‎NETFLIX аниме сериясы
Dialogue: 0,0:00:11.42,0:00:14.18,Top,,0000,0000,0000,,‎(сұйық барабанның соғу дыбысы)
Dialogue: 0,0:00:29.07,0:00:30.94,Top,,0000,0000,0000,,‎(Жарылыс дыбысы)
Dialogue: 0,0:00:31.03,0:00:36.03,Top,,0000,0000,0000,,♪~
Dialogue: 0,0:01:54.15,0:01:59.16,Top,,0000,0000,0000,,~♪
Dialogue: 0,0:02:15.38,0:02:16.46,Bottom,,0000,0000,0000,,Бірдеңе?
Dialogue: 0,0:02:15.46,0:02:17.97,Top,,0000,0000,0000,,Қалай? Ешқандай кіру немесе шығу жоқ
Dialogue: 0,0:02:16.55,0:02:17.97,Bottom,,0000,0000,0000,,Ешкім кіріп-шықпайды.
Dialogue: 0,0:02:18.05,0:02:19.30,Bottom,,0000,0000,0000,,Суреттер.
Dialogue: 0,0:02:18.05,0:02:19.34,Top,,0000,0000,0000,,Мен түсінемін.
Dialogue: 0,0:02:19.38,0:02:22.35,Bottom,,0000,0000,0000,,Фарадей дұрыс айтты. Ол сайттарды ауыстырды.
Dialogue: 0,0:02:19.43,0:02:22.43,Top,,0000,0000,0000,,Фарадей айтқандай, олар орындарын ауыстырған сияқты.
Dialogue: 0,0:02:22.43,0:02:25.97,Bottom,,0000,0000,0000,,Бұл жоғалған себеп болды. Допты осы жерге тастады.
Dialogue: 0,0:02:22.51,0:02:24.47,Top,,0000,0000,0000,,Мен жағдайды бақылауға тырыстым, бірақ
Dialogue: 0,0:02:24.56,0:02:25.97,Top,,0000,0000,0000,,‎Бос әткеншекке қараңыз.
Dialogue: 0,0:02:26.06,0:02:29.48,Bottom,,0000,0000,0000,,Егер Арасака ұрланған көліктің үстінен үй тазалауға дайын болса, үлкен болуы керек.
Dialogue: 0,0:02:26.06,0:02:29.48,Top,,0000,0000,0000,,Арасаканың сақ болғаны таң қалдырады.
Dialogue: 0,0:02:29.56,0:02:31.81,Top,,0000,0000,0000,,Фарадей тым айқын.
Dialogue: 0,0:02:29.56,0:02:33.06,Bottom,,0000,0000,0000,,Сол Фарадей бізге нені аңсайтынымызды айтса ғой.
Dialogue: 0,0:02:31.90,0:02:33.11,Top,,0000,0000,0000,,Маған ұнамайды
Dialogue: 0,0:02:33.15,0:02:35.73,Bottom,,0000,0000,0000,,Бұл өте қауіпті боктың иісі.
Dialogue: 0,0:02:33.19,0:02:35.78,Top,,0000,0000,0000,,‎Бұл жерде шынымен қауіпті нәрсе болды.
Dialogue: 0,0:02:35.82,0:02:38.53,Bottom,,0000,0000,0000,,«Ең үлкен балық әрқашан қашып кеткен балық»?
Dialogue: 0,0:02:35.86,0:02:38.40,Top,,0000,0000,0000,,‎Қашып кеткен балық үлкен бе?
Dialogue: 0,0:02:38.49,0:02:40.99,Top,,0000,0000,0000,,Танака туралы көбірек білгіңіз келе ме?
Dialogue: 0,0:02:38.61,0:02:40.99,Bottom,,0000,0000,0000,,Танаканы тереңірек қазғанымды қалайсыз ба?
Dialogue: 0,0:02:41.57,0:02:44.99,Top,,0000,0000,0000,,‎Арасака шошқаларын иіскеу менің хоббиім емес.
Dialogue: 0,0:02:41.57,0:02:47.62,Bottom,,0000,0000,0000,,Жоқ, иіскеу «Сақ ісі – жөндеушінің ісі.
Dialogue: 0,0:02:45.08,0:02:47.29,Top,,0000,0000,0000,,Бұл жөндеушінің жұмысы.
Dialogue: 0,0:02:47.70,0:02:51.75,Bottom,,0000,0000,0000,,«Менің бақылау парағымдағы ұяшықтарды алып тастау үшін сізге ақша төленеді».
Dialogue: 0,0:02:47.79,0:02:51.88,Top,,0000,0000,0000,,‎"Мен бұйрық беремін, ал сен орындайсың. Бұл ережелер."
Dialogue: 0,0:02:51.83,0:02:55.88,Bottom,,0000,0000,0000,,Иә, иә. Мен алға барып, оған киви іштім.
Dialogue: 0,0:02:51.96,0:02:55.88,Top,,0000,0000,0000,,Иә, иә, бірақ Киви де қозғалады.
Dialogue: 0,0:02:55.96,0:02:58.72,Bottom,,0000,0000,0000,,Менің ойымша, біз не тапқанымызды көреміз.
Dialogue: 0,0:02:55.96,0:02:58.80,Top,,0000,0000,0000,,Егер сіз бірдеңені ұстап алсаңыз, оны айналдыра алуыңыз керек.
Dialogue: 0,0:02:58.80,0:03:01.01,Bottom,,0000,0000,0000,,Сонымен, біз қазір күтеміз бе?
Dialogue: 0,0:02:58.88,0:03:01.01,Top,,0000,0000,0000,,‎Басқаша айтқанда, менің бос уақытым бар.
Dialogue: 0,0:03:01.09,0:03:05.31,Top,,0000,0000,0000,,Біз күтеміз...
Dialogue: 0,0:03:01.09,0:03:05.51,Bottom,,0000,0000,0000,,Бізге уақытты өлтірудің жолын табу керек...
Dialogue: 0,0:03:05.39,0:03:06.06,Top,,0000,0000,0000,,Гах!
Dialogue: 0,0:03:06.14,0:03:07.27,Top,,0000,0000,0000,,А...
Dialogue: 0,0:03:07.85,0:03:09.02,Top,,0000,0000,0000,,‎Хехе
Dialogue: 0,0:03:15.44,0:03:17.36,Top,,0000,0000,0000,,‎(Holocall рингтоны) ‎Хмм? Хмм...
Dialogue: 0,0:03:18.19,0:03:20.90,Top,,0000,0000,0000,,Дэвид, мен қазір бос емеспін.
Dialogue: 0,0:03:20.99,0:03:24.07,Top,,0000,0000,0000,,‎Аа, жоқ... Содан бері сізден хабар жоқ.
Dialogue: 0,0:03:24.16,0:03:26.83,Top,,0000,0000,0000,,‎‎Мен жұмысым болса хабарласамын дедім.
Dialogue: 0,0:03:27.37,0:03:29.54,Top,,0000,0000,0000,,‎Қазір емес пе? Мен бәрін істеймін
Dialogue: 0,0:03:30.08,0:03:32.04,Top,,0000,0000,0000,,Бұлай асықпа
Dialogue: 0,0:03:32.12,0:03:34.71,Top,,0000,0000,0000,,Өткен жолғы ақшаны жұмсадыңыз ба?
Dialogue: 0,0:03:35.34,0:03:37.17,Top,,0000,0000,0000,,Бұл тек ақшаға қатысты емес.
Dialogue: 0,0:03:37.25,0:03:38.00,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:38.09,0:03:40.13,Top,,0000,0000,0000,,Мен жұмысты үйренгім келеді
Dialogue: 0,0:03:40.63,0:03:42.22,Top,,0000,0000,0000,,Мәңгілік аман бол...
Dialogue: 0,0:03:42.30,0:03:44.55,Top,,0000,0000,0000,,Мен қала алмаймын... солай ма?
Dialogue: 0,0:03:43.09,0:03:44.64,Bottom,,0000,0000,0000,,Өзіңіз айттыңыз, солай ма?
Dialogue: 0,0:03:45.55,0:03:47.18,Bottom,,0000,0000,0000,,Жарайды, жақсы.
Dialogue: 0,0:03:45.55,0:03:47.18,Top,,0000,0000,0000,,Мұны жасамаңыз.
Dialogue: 0,0:03:48.35,0:03:50.02,Bottom,,0000,0000,0000,,Мен Альдо үшін келдім.
Dialogue: 0,0:03:48.39,0:03:50.02,Top,,0000,0000,0000,,Сіз Альдосыз ба?
Dialogue: 0,0:03:50.10,0:03:52.60,Top,,0000,0000,0000,,А? сен кімсің
Dialogue: 0,0:03:50.10,0:03:52.64,Bottom,,0000,0000,0000,,Иә? Кім сұрап жатыр?
Dialogue: 0,0:03:52.69,0:03:54.60,Top,,0000,0000,0000,,‎Нұсқаулар негізгі...
Dialogue: 0,0:03:52.73,0:03:54.44,Bottom,,0000,0000,0000,,Мені Мэн жіберді.
Dialogue: 0,0:03:54.52,0:03:57.27,Bottom,,0000,0000,0000,,Ха? Сіз Дэвис?
Dialogue: 0,0:03:54.69,0:03:57.44,Top,,0000,0000,0000,,А? Сіз Дэвиссіз бе?
Dialogue: 0,0:03:57.36,0:03:58.82,Bottom,,0000,0000,0000,,Уф…
Dialogue: 0,0:03:57.52,0:03:59.90,Top,,0000,0000,0000,,А, жоқ... ‎Аа?
Dialogue: 0,0:03:58.90,0:03:59.78,Bottom,,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:03:59.86,0:04:01.15,Bottom,,0000,0000,0000,,Мен Дэвидпін.
Dialogue: 0,0:03:59.98,0:04:02.11,Top,,0000,0000,0000,,Дэвид Дэвис?
Dialogue: 0,0:04:01.24,0:04:02.07,Bottom,,0000,0000,0000,,Дэвис?
Dialogue: 0,0:04:02.15,0:04:05.28,Bottom,,0000,0000,0000,,Дэвид! Дэвис емес! Дэвид!
Dialogue: 0,0:04:02.20,0:04:05.37,Top,,0000,0000,0000,,‎Дэвид Дэвид, Дэвис емес!
Dialogue: 0,0:04:05.37,0:04:08.33,Bottom,,0000,0000,0000,,Сен айқайлап тұрсың ба?! Мен сені естимін.
Dialogue: 0,0:04:05.45,0:04:07.83,Top,,0000,0000,0000,,Айқайламаңыз, мен сізді естимін
Dialogue: 0,0:04:08.41,0:04:13.54,Bottom,,0000,0000,0000,,Дэвид? Сіз Пилардың тасымалдаушы көгершінсіз.
Dialogue: 0,0:04:08.53,0:04:11.41,Top,,0000,0000,0000,,А, Дәуіт, Дәуіт.
Dialogue: 0,0:04:11.50,0:04:13.37,Top,,0000,0000,0000,,‎Пилар үшін тапсырма
Dialogue: 0,0:04:13.46,0:04:14.67,Top,,0000,0000,0000,,‎Пирал?
Dialogue: 0,0:04:13.62,0:04:14.67,Bottom,,0000,0000,0000,,Пилардікі?
Dialogue: 0,0:04:15.50,0:04:17.04,Top,,0000,0000,0000,,Сіз бе?
Dialogue: 0,0:04:15.50,0:04:21.42,Bottom,,0000,0000,0000,,Сіз болдыңыз, солай емес пе? «Сака лимузинін» ұрып-соғып, лақтырып жіберген панк бала?
Dialogue: 0,0:04:17.13,0:04:21.42,Top,,0000,0000,0000,,‎Арасаканың лимузиніне мініп, суланып кеткен ақымақ.
Dialogue: 0,0:04:21.51,0:04:24.22,Bottom,,0000,0000,0000,,Иә... Жұмысқа бірінші рет.
Dialogue: 0,0:04:21.51,0:04:24.22,Top,,0000,0000,0000,,А... бұл менің бірінші рет.
Dialogue: 0,0:04:24.30,0:04:28.18,Top,,0000,0000,0000,,‎Егер сіз зиянсыз болсаңыз, сіз әлдеқашан 5000 тапқан болар едіңіз
Dialogue: 0,0:04:24.30,0:04:30.68,Bottom,,0000,0000,0000,,Егер сіз оны тозаққа тастамасаңыз, ол үшін 5 мың жинап алар едіңіз.
Dialogue: 0,0:04:28.68,0:04:30.68,Top,,0000,0000,0000,,Сіз шынымен ештеңе түсінбейсіз.
Dialogue: 0,0:04:30.77,0:04:32.14,Top,,0000,0000,0000,,Мен мұны келесі жолы жасаймын
Dialogue: 0,0:04:30.77,0:04:32.60,Bottom,,0000,0000,0000,,-Мен оны келесі жолы есіме аламын. -А?
Dialogue: 0,0:04:32.23,0:04:34.06,Top,,0000,0000,0000,,А? Мен мұны келесі жолы жасаймын!
Dialogue: 0,0:04:32.68,0:04:34.10,Bottom,,0000,0000,0000,,Мен келесі жолы жақсырақ істеймін!
Dialogue: 0,0:04:34.14,0:04:37.23,Top,,0000,0000,0000,,‎Хахахахаха Енді не болады?
Dialogue: 0,0:04:35.73,0:04:37.69,Bottom,,0000,0000,0000,,Келесі жолы, иә?
Dialogue: 0,0:04:37.77,0:04:41.73,Bottom,,0000,0000,0000,,Соңғы рет жаңадан бастағандар үшін сәттілік болған жоқ па, соны көреміз.
Dialogue: 0,0:04:37.94,0:04:41.78,Top,,0000,0000,0000,,Арасака екеуіңнің айырмашылығың боқ пен дәретханада.
Dialogue: 0,0:04:41.82,0:04:43.19,Bottom,,0000,0000,0000,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:04:41.86,0:04:44.99,Top,,0000,0000,0000,,‎Бұл нені білдіреді? Бұл сенсің
Dialogue: 0,0:04:43.28,0:04:44.99,Bottom,,0000,0000,0000,,Жеке ештеңе жоқ.
Dialogue: 0,0:04:45.07,0:04:49.33,Bottom,,0000,0000,0000,,Сенің боқ екеніңді немесе жай ғана лас дақ екеніңді білуге ​​көп уақыт кетпейді.
Dialogue: 0,0:04:45.57,0:04:49.24,Top,,0000,0000,0000,,Бокпен жабылғанның айырмашылығы болуы керек.
Dialogue: 0,0:04:50.29,0:04:52.54,Bottom,,0000,0000,0000,,Уотсондағы киберпсихо туралы естідіңіз бе?
Dialogue: 0,0:04:50.29,0:04:52.54,Top,,0000,0000,0000,,‎(полиция қызметкері) Уотсонда киберпсихо пайда болды ма?
Dialogue: 0,0:04:52.62,0:04:54.29,Bottom,,0000,0000,0000,,Олар жай ғана пайда болады.
Dialogue: 0,0:04:52.62,0:04:54.37,Top,,0000,0000,0000,,‎Ол соңғы уақытта артып келеді.
Dialogue: 0,0:04:54.37,0:04:59.84,Bottom,,0000,0000,0000,,Иә, патрульге екі ҰҚК шығарылды. Шиыршықты көрдім. Бұл қанды болды.
Dialogue: 0,0:04:54.46,0:04:58.00,Top,,0000,0000,0000,,‎(Полиция қызметкері) Әй, патрульде жүрген екі полиция қызметкері қаза тапты.
Dialogue: 0,0:04:58.08,0:04:59.96,Top,,0000,0000,0000,,Мен жазбаны қарадым, бірақ бұл құпия.
Dialogue: 0,0:04:59.92,0:05:04.05,Bottom,,0000,0000,0000,,Бір ұшырғыштың соғуы оны соншалықты консервіленген пастаға айналдырды ...
Dialogue: 0,0:05:00.04,0:05:02.84,Top,,0000,0000,0000,,‎Бір ұшыру құрылғысы атылды және ол паста тағамы сияқты беріледі.
Dialogue: 0,0:05:02.92,0:05:04.09,Top,,0000,0000,0000,,А... Бұл тәртіпсіздік болды.
Dialogue: 0,0:05:08.76,0:05:09.80,Top,,0000,0000,0000,,(дыбыстық дыбыс)
Dialogue: 0,0:05:09.89,0:05:10.93,Top,,0000,0000,0000,,‎(есіктің ашылған дыбысы)
Dialogue: 0,0:05:11.01,0:05:14.27,Bottom,,0000,0000,0000,,Сәлем Дэвид! Қалайсың?
Dialogue: 0,0:05:11.01,0:05:14.35,Top,,0000,0000,0000,,О, Дэвид, қалайсың?
Dialogue: 0,0:05:14.35,0:05:15.44,Bottom,,0000,0000,0000,,Уф…
Dialogue: 0,0:05:14.43,0:05:15.48,Top,,0000,0000,0000,,Әй... А?
Dialogue: 0,0:05:15.52,0:05:17.69,Bottom,,0000,0000,0000,,Не болды? Сізге бірдеңе керек пе?
Dialogue: 0,0:05:15.56,0:05:17.69,Top,,0000,0000,0000,,Не болды? Сізге бірдеңе керек пе?
Dialogue: 0,0:05:17.77,0:05:21.94,Bottom,,0000,0000,0000,,Ух. Бұл пакетті Пилар үшін Мэнден алды.
Dialogue: 0,0:05:17.77,0:05:22.07,Top,,0000,0000,0000,,Е-е, мынау Піралға арналған негізгі нұсқаулар
Dialogue: 0,0:05:22.03,0:05:22.90,Bottom,,0000,0000,0000,,О...
Dialogue: 0,0:05:22.15,0:05:24.32,Top,,0000,0000,0000,,О, Аники!
Dialogue: 0,0:05:22.98,0:05:24.32,Bottom,,0000,0000,0000,,Брат!
Dialogue: 0,0:05:24.40,0:05:25.32,Top,,0000,0000,0000,,Аники?
Dialogue: 0,0:05:24.40,0:05:25.86,Bottom,,0000,0000,0000,,Брат?
Dialogue: 0,0:05:25.40,0:05:26.03,Top,,0000,0000,0000,,Әй?
Dialogue: 0,0:05:25.95,0:05:28.03,Bottom,,0000,0000,0000,,Мэннен жеткізу!
Dialogue: 0,0:05:26.11,0:05:27.78,Top,,0000,0000,0000,,‎Негізінен бірдеңе шығып жатыр.
Dialogue: 0,0:05:27.86,0:05:30.33,Top,,0000,0000,0000,,‎Ооохохохо, міне, осында!
Dialogue: 0,0:05:29.16,0:05:30.28,Bottom,,0000,0000,0000,,Блять!
Dialogue: 0,0:05:30.78,0:05:35.41,Bottom,,0000,0000,0000,,Осы киберқолдарды алу үшін қанша ұл өлтіретінін білесіз бе?
Dialogue: 0,0:05:31.16,0:05:35.41,Top,,0000,0000,0000,,Барлық техникалар ‎құтқару‎ ‎Ультра кибер қол Хаха
Dialogue: 0,0:05:35.50,0:05:37.58,Bottom,,0000,0000,0000,,Керемет!
Dialogue: 0,0:05:35.50,0:05:39.67,Top,,0000,0000,0000,,Мен шыдай алмаймын! Хахахаха Жарайды!
Dialogue: 0,0:05:39.71,0:05:41.42,Bottom,,0000,0000,0000,,Қазір кешірім сұрауым керек пе, әлде...?
Dialogue: 0,0:05:39.75,0:05:41.42,Top,,0000,0000,0000,,‎Үйге баратын уақыт емес пе?
Dialogue: 0,0:05:41.50,0:05:43.84,Bottom,,0000,0000,0000,,Оның маған жасайтын тағы бір ісі бар ма?
Dialogue: 0,0:05:41.50,0:05:43.92,Top,,0000,0000,0000,,Қызық, келесі нұсқаулар бар ма?
Dialogue: 0,0:05:43.92,0:05:45.63,Bottom,,0000,0000,0000,,Брат?
Dialogue: 0,0:05:44.01,0:05:45.67,Top,,0000,0000,0000,,Әй, Аники!
Dialogue: 0,0:05:45.72,0:05:50.76,Bottom,,0000,0000,0000,,Иә, кет. Оған шығуға кеңес беріңіз.
Dialogue: 0,0:05:45.76,0:05:48.18,Top,,0000,0000,0000,,‎Жарайды, қазір үйге бара аласыз.
Dialogue: 0,0:05:48.26,0:05:49.89,Top,,0000,0000,0000,,‎Ребекка, жалдау ақысын төле.
Dialogue: 0,0:05:49.97,0:05:50.76,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:05:50.85,0:05:54.02,Bottom,,0000,0000,0000,,Ол сенің жұмысшы балаң! Өзіңе бас сал, арзан!
Dialogue: 0,0:05:50.85,0:05:54.02,Top,,0000,0000,0000,,‎Өзің төле, қоқыс!
Dialogue: 0,0:05:54.10,0:05:54.97,Bottom,,0000,0000,0000,,Бұл оқ өткізбейтін!
Dialogue: 0,0:05:54.10,0:05:55.39,Top,,0000,0000,0000,,Оқ өткізбейтін де тамаша.
Dialogue: 0,0:05:55.06,0:05:57.69,Bottom,,0000,0000,0000,,Енді мен сағатты өшіремін бе?
Dialogue: 0,0:05:55.48,0:05:57.69,Top,,0000,0000,0000,,‎Бұл бүгін аяқталды дегенді білдіре ме?
Dialogue: 0,0:05:57.77,0:05:59.94,Bottom,,0000,0000,0000,,Ух... Солай көрінеді.
Dialogue: 0,0:05:57.77,0:05:59.94,Top,,0000,0000,0000,,О, солай емес пе?
Dialogue: 0,0:06:00.02,0:06:01.15,Top,,0000,0000,0000,,Мен түсінемін.
Dialogue: 0,0:06:00.02,0:06:01.48,Bottom,,0000,0000,0000,,О. Керемет…
Dialogue: 0,0:06:01.23,0:06:02.69,Top,,0000,0000,0000,,‎n ‎ (электрондық дыбыс)
Dialogue: 0,0:06:02.77,0:06:05.19,Top,,0000,0000,0000,,‎Ой, соншама? Ухохохо
Dialogue: 0,0:06:02.86,0:06:05.19,Bottom,,0000,0000,0000,,Әй?! Мұның бәрі кеңес үшін бе?!
Dialogue: 0,0:06:05.28,0:06:07.70,Top,,0000,0000,0000,,‎Күшік, сен жақсысың.
Dialogue: 0,0:06:05.78,0:06:07.70,Bottom,,0000,0000,0000,,Сіз сүйкімдісіз.
Dialogue: 0,0:06:07.78,0:06:08.57,Top,,0000,0000,0000,,Кімге?
Dialogue: 0,0:06:08.65,0:06:10.37,Top,,0000,0000,0000,,‎Кездескенше Дэвид
Dialogue: 0,0:06:08.65,0:06:10.41,Bottom,,0000,0000,0000,,Кездескенше, Дэвид.
Dialogue: 0,0:06:12.78,0:06:15.33,Top,,0000,0000,0000,,(Holo Communication: Люси) Бүгін кешке боссыз ба?
Dialogue: 0,0:06:15.41,0:06:16.50,Top,,0000,0000,0000,,‎Ооохохо
Dialogue: 0,0:06:20.83,0:06:23.00,Top,,0000,0000,0000,,‎(аяқ дыбысына жақындау)
Dialogue: 0,0:06:24.17,0:06:25.42,Top,,0000,0000,0000,,‎(Люси) Мен осындамын.
Dialogue: 0,0:06:24.17,0:06:25.80,Bottom,,0000,0000,0000,,Келдің бе?
Dialogue: 0,0:06:25.88,0:06:28.47,Bottom,,0000,0000,0000,,Сен маған кел деді.
Dialogue: 0,0:06:25.96,0:06:28.47,Top,,0000,0000,0000,,‎Бұл қоңырау шалған адам, солай ма?
Dialogue: 0,0:06:28.55,0:06:30.47,Bottom,,0000,0000,0000,,Мэн мені қорқытты.
Dialogue: 0,0:06:28.55,0:06:30.51,Top,,0000,0000,0000,,‎(Люси) Main тым шулы.
Dialogue: 0,0:06:30.55,0:06:32.47,Bottom,,0000,0000,0000,,Не... Мэн?
Dialogue: 0,0:06:30.59,0:06:32.14,Top,,0000,0000,0000,,Не? негізгі?
Dialogue: 0,0:06:33.47,0:06:36.72,Top,,0000,0000,0000,,‎(Holo Communication: Люси) ‎Неге мен? Бұл мысық немесе қуаныш ойыншығы болсын
Dialogue: 0,0:06:36.81,0:06:39.73,Top,,0000,0000,0000,,Оны тапқан адамға қамқорлық жасау мағынасы бар еді.
Dialogue: 0,0:06:40.31,0:06:42.40,Top,,0000,0000,0000,,‎(Люси) ‎Оны өсірген сіз болдыңыз, солай ма?
Dialogue: 0,0:06:42.48,0:06:46.07,Top,,0000,0000,0000,,Қалай болғанда да, ол маған жұмыс беруі керек.
Dialogue: 0,0:06:46.15,0:06:48.82,Top,,0000,0000,0000,,‎Мен денемді жаттықтырып, аузымды жабуға рұқсат етіңіз.
Dialogue: 0,0:06:50.28,0:06:51.36,Bottom,,0000,0000,0000,,Ақымақ.
Dialogue: 0,0:06:50.32,0:06:51.45,Top,,0000,0000,0000,,‎(Люси) бейбақ
Dialogue: 0,0:06:52.16,0:06:53.16,Bottom,,0000,0000,0000,,Сіз қалжыңдап тұрсыз.
Dialogue: 0,0:06:52.20,0:06:53.24,Top,,0000,0000,0000,,Жасыру
Dialogue: 0,0:06:53.24,0:06:55.66,Bottom,,0000,0000,0000,,Сіз маған айтып отырсыз. Бүгін менің демалыс күнім.
Dialogue: 0,0:06:53.32,0:06:55.66,Top,,0000,0000,0000,,(Люси) Мен сенен жақсымын.
Dialogue: 0,0:06:55.74,0:06:57.91,Bottom,,0000,0000,0000,,Оны естігеніме өкінішті.
Dialogue: 0,0:06:55.74,0:06:57.91,Top,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:06:58.54,0:07:02.33,Bottom,,0000,0000,0000,,Ренжімеңіз, бірақ сіз панк сияқты қалыптаспағансыз.
Dialogue: 0,0:06:58.58,0:07:02.46,Top,,0000,0000,0000,,(Люси) Шынында да, сіз киберпанк болу үшін тым кедейсіз.
Dialogue: 0,0:07:02.42,0:07:07.30,Bottom,,0000,0000,0000,,Сіз тағы бір немесе екі импланттан кейін түзететін сияқтысыз.
Dialogue: 0,0:07:02.54,0:07:05.04,Top,,0000,0000,0000,,Тағы бір немесе екі имплантациядан кейін
Dialogue: 0,0:07:05.13,0:07:07.13,Top,,0000,0000,0000,,Сіз киберпсихо болуыңыз мүмкін
Dialogue: 0,0:07:07.38,0:07:09.80,Bottom,,0000,0000,0000,,Мен соншалықты әлсіз емеспін!
Dialogue: 0,0:07:07.63,0:07:09.80,Top,,0000,0000,0000,,Бұл соншалықты жұмсақ емес.
Dialogue: 0,0:07:09.88,0:07:11.34,Top,,0000,0000,0000,,‎(Люси) Қалайсың?
Dialogue: 0,0:07:09.88,0:07:11.38,Bottom,,0000,0000,0000,,Олай болса жалғастырыңыз.
Dialogue: 0,0:07:16.14,0:07:17.93,Bottom,,0000,0000,0000,,Бір кездері қолданып көрдіңіз бе?
Dialogue: 0,0:07:16.14,0:07:19.27,Top,,0000,0000,0000,,Сіз оны қолданып көрдіңіз бе? Жоқ.
Dialogue: 0,0:07:18.02,0:07:19.23,Bottom,,0000,0000,0000,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:07:19.31,0:07:23.44,Bottom,,0000,0000,0000,,Глория сені ешқашан алып жүруге рұқсат етпейді ме? Ешқашаннан гөрі қазір бастаған дұрыс.
Dialogue: 0,0:07:19.35,0:07:21.94,Top,,0000,0000,0000,,Глория оны алуға рұқсат етпеді ме?
Dialogue: 0,0:07:22.02,0:07:23.44,Top,,0000,0000,0000,,‎Одан кейін үйреніп ал.
Dialogue: 0,0:07:23.52,0:07:26.02,Top,,0000,0000,0000,,Сіз маған кез келген нәрсені айта аласыз.
Dialogue: 0,0:07:23.52,0:07:26.07,Bottom,,0000,0000,0000,,Қаласаңыз, сізге үйрете аламын.
Dialogue: 0,0:07:26.65,0:07:30.24,Bottom,,0000,0000,0000,,Мен Сандестистанмен бірге боламын деп ойлаңыз.
Dialogue: 0,0:07:26.77,0:07:30.24,Top,,0000,0000,0000,,Егер менде Сандеви Стэн болса, мен жақсы болар едім, солай ма?
Dialogue: 0,0:07:52.97,0:07:54.01,Bottom,,0000,0000,0000,,Та-да!
Dialogue: 0,0:07:53.05,0:07:54.80,Top,,0000,0000,0000,,Эй (Люси) Не?
Dialogue: 0,0:07:54.09,0:07:54.93,Bottom,,0000,0000,0000,,Уф, емтихандар.
Dialogue: 0,0:07:55.51,0:07:58.14,Bottom,,0000,0000,0000,,Сонымен, сіз нетруннерсіз бе?
Dialogue: 0,0:07:55.51,0:07:58.26,Top,,0000,0000,0000,,‎Люси, мүмкін, Net Runner?
Dialogue: 0,0:07:58.22,0:07:59.47,Bottom,,0000,0000,0000,,Иә. Және?
Dialogue: 0,0:07:58.35,0:07:59.60,Top,,0000,0000,0000,,Сонда ше?
Dialogue: 0,0:07:59.56,0:08:02.81,Bottom,,0000,0000,0000,,Ештеңе. Нетруннерлерге жүгіру керек пе?
Dialogue: 0,0:07:59.68,0:08:02.89,Top,,0000,0000,0000,,А, жүгірушілер үшін жүгіру керек пе?
Dialogue: 0,0:08:02.89,0:08:07.36,Bottom,,0000,0000,0000,,Netrunner, edgerunner. Айырмашылық жоқ. Төзімділік - бәрі.
Dialogue: 0,0:08:02.98,0:08:05.40,Top,,0000,0000,0000,,Netrunner - бұл киберпанк.
Dialogue: 0,0:08:05.48,0:08:07.23,Top,,0000,0000,0000,,Мен қалыпты денеде өмір сүре алмаймын.
Dialogue: 0,0:08:14.28,0:08:15.20,Top,,0000,0000,0000,,‎(Кача!)
Dialogue: 0,0:08:15.28,0:08:16.07,Top,,0000,0000,0000,,‎(Jaki!)
Dialogue: 0,0:08:36.47,0:08:40.10,Bottom,,0000,0000,0000,,Енді үйден құр қол шықпа, естідің бе?
Dialogue: 0,0:08:36.64,0:08:40.26,Top,,0000,0000,0000,,Мылтық - менің анамның бойтұмары.
Dialogue: 0,0:08:40.97,0:08:44.89,Bottom,,0000,0000,0000,,Күн сайын. Сіз әмияныңызды, презервативіңізді және мылтығыңызды тексересіз.
Dialogue: 0,0:08:41.14,0:08:44.89,Top,,0000,0000,0000,,Егер сіз киберпанк болғыңыз келсе, оны әрқашан резеңке таспа сияқты алып жүріңіз.
Dialogue: 0,0:08:45.48,0:08:49.19,Bottom,,0000,0000,0000,,Әрине, кейбір панктар тікелей хромға барады.
Dialogue: 0,0:08:45.52,0:08:46.52,Top,,0000,0000,0000,,‎Ортада
Dialogue: 0,0:08:46.60,0:08:49.27,Top,,0000,0000,0000,,‎Тек жүгіру қабілетімен күресетіндер бар.
Dialogue: 0,0:08:49.27,0:08:54.40,Bottom,,0000,0000,0000,,Бірақ сіз тек кибербағдарламамен өмір сүре алуыңыз үшін біраз уақыт қажет.
Dialogue: 0,0:08:49.36,0:08:52.03,Top,,0000,0000,0000,,Олар сияқты импланттары бар ақымақтар——
Dialogue: 0,0:08:52.11,0:08:54.40,Top,,0000,0000,0000,,‎Кіруге әлі көп жол бар.
Dialogue: 0,0:08:54.99,0:08:58.82,Top,,0000,0000,0000,,‎Сонымен салыстырғанда, мылтықтарды тез қолдануға болады.
Dialogue: 0,0:08:54.99,0:08:58.91,Bottom,,0000,0000,0000,,Оған дейін бұл мылтық сіздің резервтік жоспарыңыз болады.
Dialogue: 0,0:09:05.67,0:09:06.75,Bottom,,0000,0000,0000,,Та-да!
Dialogue: 0,0:09:05.75,0:09:06.46,Top,,0000,0000,0000,,Сәлем
Dialogue: 0,0:09:06.83,0:09:07.79,Bottom,,0000,0000,0000,,Уф, емтихандар.
Dialogue: 0,0:09:07.00,0:09:07.79,Top,,0000,0000,0000,,Не?
Dialogue: 0,0:09:07.88,0:09:09.50,Bottom,,0000,0000,0000,,Сіздің жасыңыз нешеде?
Dialogue: 0,0:09:07.88,0:09:09.50,Top,,0000,0000,0000,,‎Люси неше жаста?
Dialogue: 0,0:09:20.81,0:09:21.81,Top,,0000,0000,0000,,‎(Соқтығыс дыбысы)
Dialogue: 0,0:09:22.31,0:09:24.18,Top,,0000,0000,0000,,‎(бензиннің атқылаған дыбысы)
Dialogue: 0,0:09:27.48,0:09:28.23,Top,,0000,0000,0000,,‎(Жарылыс дыбысы)
Dialogue: 0,0:09:35.49,0:09:36.99,Bottom,,0000,0000,0000,,Люсидің жағдайы қалай?
Dialogue: 0,0:09:35.49,0:09:36.99,Top,,0000,0000,0000,,‎Люси ше?
Dialogue: 0,0:09:37.07,0:09:38.03,Bottom,,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:09:37.07,0:09:39.49,Top,,0000,0000,0000,,Иә? Барлығы жақсы болып жатыр ма?
Dialogue: 0,0:09:38.11,0:09:39.41,Bottom,,0000,0000,0000,,Сіз оған дұрыс қарайсыз ба?
Dialogue: 0,0:09:40.28,0:09:46.00,Bottom,,0000,0000,0000,,Жоқ, мен айтқым келген жоқ... Сіздің жасыңыз бен дағдыларыңыз сәйкес келмейді.
Dialogue: 0,0:09:40.32,0:09:41.74,Top,,0000,0000,0000,,Жоқ, кешіріңіз
Dialogue: 0,0:09:41.83,0:09:46.08,Top,,0000,0000,0000,,Ал... жастық пен шеберлік сәйкес келмейді.
Dialogue: 0,0:09:46.08,0:09:48.33,Bottom,,0000,0000,0000,,Шеберліктің жасқа қатысы жоқ.
Dialogue: 0,0:09:46.16,0:09:48.37,Top,,0000,0000,0000,,(Люси) Жастың шеберлікке еш қатысы жоқ.
Dialogue: 0,0:09:48.42,0:09:50.29,Bottom,,0000,0000,0000,,Мұның бәрі еңбекқорлық.
Dialogue: 0,0:09:48.46,0:09:49.92,Top,,0000,0000,0000,,Дарындылық пен күш-жігер
Dialogue: 0,0:09:50.38,0:09:54.17,Bottom,,0000,0000,0000,,Оның үстіне, өздерінен кіші адамдарға тек ақымақтар ғана сөйлейді.
Dialogue: 0,0:09:50.46,0:09:54.17,Top,,0000,0000,0000,,Мен жаспын, Тауды алуға келген жаман.
Dialogue: 0,0:09:54.26,0:09:55.63,Bottom,,0000,0000,0000,,Кімге ұнайды?
Dialogue: 0,0:09:54.76,0:09:55.63,Top,,0000,0000,0000,,Мысалы?
Dialogue: 0,0:09:55.72,0:09:57.34,Top,,0000,0000,0000,,‎Қол ұзындығы техникасы
Dialogue: 0,0:09:55.72,0:09:57.43,Bottom,,0000,0000,0000,,Ұзын қарулы техниктер сияқты.
Dialogue: 0,0:09:58.13,0:10:01.51,Top,,0000,0000,0000,,‎(Люсидің тынысы)
Dialogue: 0,0:10:08.98,0:10:10.31,Top,,0000,0000,0000,,‎(Люси) га...
Dialogue: 0,0:10:21.74,0:10:23.83,Bottom,,0000,0000,0000,,«Оған дұрыс қарау» дегенді қалай түсінесің?
Dialogue: 0,0:10:21.82,0:10:23.87,Top,,0000,0000,0000,,‎Сен не туралы айтып тұрсың?
Dialogue: 0,0:10:24.37,0:10:26.41,Top,,0000,0000,0000,,‎Сіз әлі ұрысқан жоқсыз ба?
Dialogue: 0,0:10:24.49,0:10:26.58,Bottom,,0000,0000,0000,,Күте тұрыңыз... Сіз мұны әлі орындамадыңыз ба?
Dialogue: 0,0:10:26.50,0:10:29.08,Top,,0000,0000,0000,,‎Бір минут күте тұрыңыз, сонда сіз не туралы айтып тұрсыз?
Dialogue: 0,0:10:26.66,0:10:28.96,Bottom,,0000,0000,0000,,Біз нақты не туралы айтып отырмыз?
Dialogue: 0,0:10:29.04,0:10:32.92,Bottom,,0000,0000,0000,,Дэвид, сізге бір жұп кажон өсіру керек
Dialogue: 0,0:10:29.17,0:10:30.50,Top,,0000,0000,0000,,Дэвид
Dialogue: 0,0:10:31.00,0:10:33.04,Top,,0000,0000,0000,,Киберпанк және ерлер
Dialogue: 0,0:10:33.00,0:10:36.42,Bottom,,0000,0000,0000,,және мен тек киберпанк мағынасында сөйлеспеймін.
Dialogue: 0,0:10:33.13,0:10:36.38,Top,,0000,0000,0000,,Сіз мәңгілік жаңа ойыншы болып қала алмайсыз, солай ма?
Dialogue: 0,0:10:39.51,0:10:42.22,Bottom,,0000,0000,0000,,Бір күні екеуіңнің сөйлесіп тұрғаныңды көрдім деп ойладым.
Dialogue: 0,0:10:39.51,0:10:42.47,Top,,0000,0000,0000,,‎‎Бірақ өткен күні екеуің сөйлеспедіңдер ме?
Dialogue: 0,0:10:43.35,0:10:46.31,Bottom,,0000,0000,0000,,Лимузинді ұрлаудан кейінгі кеште.
Dialogue: 0,0:10:43.39,0:10:46.31,Top,,0000,0000,0000,,Мен сол лимузинді ұрлаған күні дүкенге бардым.
Dialogue: 0,0:10:46.39,0:10:49.81,Bottom,,0000,0000,0000,,Ол менің тәлімгерім сияқты әрекет еткенді ұнатады.
Dialogue: 0,0:10:46.39,0:10:49.81,Top,,0000,0000,0000,,‎(Люси) Ол жай ғана жоғары сынып оқушысы болып, мені аздап мазақтады.
Dialogue: 0,0:10:49.89,0:10:53.81,Bottom,,0000,0000,0000,,Ол ұсталып қалды, сондықтан мен оны аздап қуырып жібердім де, ұрып-соғуын айттым.
Dialogue: 0,0:10:49.89,0:10:53.81,Top,,0000,0000,0000,,Ол мас болған кезде, ол бірден маған қол созады, сондықтан мен оны бұзып, үйіне жібердім.
Dialogue: 0,0:10:53.90,0:10:55.07,Bottom,,0000,0000,0000,,Иә.
Dialogue: 0,0:10:54.40,0:10:55.07,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:56.36,0:10:57.82,Bottom,,0000,0000,0000,,Ал сіз ше?
Dialogue: 0,0:10:56.48,0:10:57.32,Top,,0000,0000,0000,,Сіз
Dialogue: 0,0:10:58.40,0:11:00.66,Bottom,,0000,0000,0000,,Сіз шеттен жүгіруге шындап қарайсыз ба?
Dialogue: 0,0:10:58.40,0:11:00.70,Top,,0000,0000,0000,,Сіз киберпанк болғыңыз келе ме?
Dialogue: 0,0:11:08.95,0:11:10.58,Bottom,,0000,0000,0000,,Мен оған олай ұнамаймын.
Dialogue: 0,0:11:08.95,0:11:10.67,Top,,0000,0000,0000,,Мен олай істегім келмеді...
Dialogue: 0,0:11:11.17,0:11:13.29,Top,,0000,0000,0000,,Бұл шынымен де анық.
Dialogue: 0,0:11:11.17,0:11:13.33,Bottom,,0000,0000,0000,,Қане, балақай, бәріміздің көзіміз бар.
Dialogue: 0,0:11:13.38,0:11:15.21,Top,,0000,0000,0000,,‎Хаа... мен
Dialogue: 0,0:11:14.38,0:11:17.80,Bottom,,0000,0000,0000,,Ол маған олай ұнамайды.
Dialogue: 0,0:11:15.29,0:11:18.01,Top,,0000,0000,0000,,‎Сізді серіктес ретінде қарастырмайтын шығар.
Dialogue: 0,0:11:17.88,0:11:19.17,Bottom,,0000,0000,0000,,Иә, мүмкін.
Dialogue: 0,0:11:18.09,0:11:19.26,Top,,0000,0000,0000,,Мүмкін солай шығар.
Dialogue: 0,0:11:29.39,0:11:30.56,Top,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:11:29.48,0:11:30.48,Bottom,,0000,0000,0000,,Неге сұрап тұрсыз?
Dialogue: 0,0:11:30.56,0:11:33.40,Bottom,,0000,0000,0000,,Сіз ондай емес сияқтысыз.
Dialogue: 0,0:11:30.64,0:11:33.40,Top,,0000,0000,0000,,‎Шынымды айтсам, мен оған лайық емеспін деп ойлаймын.
Dialogue: 0,0:11:33.98,0:11:34.98,Bottom,,0000,0000,0000,,Неге?!
Dialogue: 0,0:11:33.98,0:11:34.98,Top,,0000,0000,0000,,Қайда?
Dialogue: 0,0:11:35.56,0:11:36.40,Bottom,,0000,0000,0000,,Айтыңызшы!
Dialogue: 0,0:11:35.61,0:11:36.23,Top,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:11:47.58,0:11:49.62,Top,,0000,0000,0000,,Қаншалықты шындық болды?
Dialogue: 0,0:11:47.58,0:11:51.25,Bottom,,0000,0000,0000,,Мен оның қаншалықты шынайы болғанын білмеймін.
Dialogue: 0,0:11:49.70,0:11:51.33,Top,,0000,0000,0000,,‎Сен түсінбейсің, солай ма?
Dialogue: 0,0:11:52.12,0:11:53.00,Bottom,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:11:52.16,0:11:53.50,Top,,0000,0000,0000,,Не?
Dialogue: 0,0:11:53.58,0:11:55.58,Bottom,,0000,0000,0000,,Айға барғысы келетінін айтты.
Dialogue: 0,0:11:53.58,0:11:55.58,Top,,0000,0000,0000,,Мен айға барғым келеді
Dialogue: 0,0:11:55.67,0:11:56.96,Bottom,,0000,0000,0000,,Ай?
Dialogue: 0,0:11:55.67,0:11:56.96,Top,,0000,0000,0000,,‎Ай?
Dialogue: 0,0:11:57.04,0:11:59.13,Top,,0000,0000,0000,,Бұл арман
Dialogue: 0,0:11:57.04,0:11:59.17,Bottom,,0000,0000,0000,,Иә, бұл оның арманы немесе басқасы.
Dialogue: 0,0:11:59.80,0:12:01.88,Top,,0000,0000,0000,,‎(мылтық атылған дыбыс)
Dialogue: 0,0:12:20.19,0:12:21.78,Top,,0000,0000,0000,,‎(жүгіру)
Dialogue: 0,0:12:21.86,0:12:24.78,Top,,0000,0000,0000,,‎(Дэвидтің ауыр тыныс алуы)
Dialogue: 0,0:12:27.03,0:12:28.70,Bottom,,0000,0000,0000,,Сіз көрінгеннен де жылдамсыз.
Dialogue: 0,0:12:27.07,0:12:28.70,Top,,0000,0000,0000,,Бұл таңқаларлық жылдам болды.
Dialogue: 0,0:12:28.78,0:12:30.58,Bottom,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:12:28.78,0:12:30.66,Top,,0000,0000,0000,,‎Хехе, мен жиі айтамын.
Dialogue: 0,0:12:30.66,0:12:33.71,Bottom,,0000,0000,0000,,Шынымен. Сіз жалғастыра алатыныңызға күмәндандым.
Dialogue: 0,0:12:30.75,0:12:33.71,Top,,0000,0000,0000,,Бұл мен ойлағаннан да жылдамырақ.
Dialogue: 0,0:12:33.79,0:12:37.46,Bottom,,0000,0000,0000,,Сарказм? Менен құтылу оңай емес.
Dialogue: 0,0:12:33.79,0:12:37.46,Top,,0000,0000,0000,,Алдыңнан жүгіріп шыққан адам осылай айтса да, мен риза емеспін.
Dialogue: 0,0:12:37.54,0:12:39.55,Top,,0000,0000,0000,,‎Хаа ха…
Dialogue: 0,0:12:51.22,0:12:51.93,Top,,0000,0000,0000,,‎(Jaki!)
Dialogue: 0,0:13:07.03,0:13:07.78,Top,,0000,0000,0000,,‎(Тепкен дыбыс)
Dialogue: 0,0:13:10.70,0:13:11.54,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:13:15.87,0:13:18.46,Bottom,,0000,0000,0000,,Маған бұл туралы ешқашан ештеңе айтқан емес.
Dialogue: 0,0:13:15.87,0:13:18.46,Top,,0000,0000,0000,,Мен мұндай әңгімені естімеппін.
Dialogue: 0,0:13:19.13,0:13:20.63,Top,,0000,0000,0000,,Бұл өтірік пе?
Dialogue: 0,0:13:19.17,0:13:20.54,Bottom,,0000,0000,0000,,Сонда ол өтірік айтты ма?
Dialogue: 0,0:13:20.63,0:13:22.96,Bottom,,0000,0000,0000,,Кім біледі? Тек одан сұра.
Dialogue: 0,0:13:20.71,0:13:22.96,Top,,0000,0000,0000,,Келіңіздер, өзіңіз тыңдаңыз.
Dialogue: 0,0:13:23.05,0:13:27.38,Bottom,,0000,0000,0000,,Ол мені жай ғана тоқтатып тұрған шығар, бірақ...
Dialogue: 0,0:13:23.05,0:13:27.43,Top,,0000,0000,0000,,Жағдайға қарасақ, бұл өтірік екені заңды сияқты.
Dialogue: 0,0:13:27.47,0:13:32.18,Bottom,,0000,0000,0000,,Бірақ біз айға бірге бардық. Арнайы BD-мен.
Dialogue: 0,0:13:27.51,0:13:30.14,Top,,0000,0000,0000,,Бірақ айдың BD менімен бірге...
Dialogue: 0,0:13:31.06,0:13:32.18,Top,,0000,0000,0000,,Сіз мұны істедіңіз бе?
Dialogue: 0,0:13:32.26,0:13:34.10,Bottom,,0000,0000,0000,,Айда күніңіз болды ма?
Dialogue: 0,0:13:32.26,0:13:34.14,Top,,0000,0000,0000,,‎Айдағы құрма?
Dialogue: 0,0:13:34.18,0:13:38.35,Bottom,,0000,0000,0000,,Түк, түнгі қалада одан да романтикалық бола алмайсың.
Dialogue: 0,0:13:34.23,0:13:38.44,Top,,0000,0000,0000,,Түнгі қалада тұратын адам үшін бұл тым көп!
Dialogue: 0,0:13:47.57,0:13:49.24,Bottom,,0000,0000,0000,,Мұнда жаттығу режимі.
Dialogue: 0,0:13:47.61,0:13:49.37,Top,,0000,0000,0000,,‎(Люси) ‎Бұл жаттығу мәзірі
Dialogue: 0,0:13:50.24,0:13:54.33,Bottom,,0000,0000,0000,,Бұл минимум ғана. Бүгіннен кейін сен жалғызсың.
Dialogue: 0,0:13:50.28,0:13:54.33,Top,,0000,0000,0000,,Менде минимум бар. Біз бүгін ғана бірге боламыз.
Dialogue: 0,0:13:55.16,0:13:58.83,Bottom,,0000,0000,0000,,Егер сіз бұған шындап қарасаңыз, сізге ілесу керек. Ал содан кейін…
Dialogue: 0,0:13:55.16,0:13:58.83,Top,,0000,0000,0000,,‎Сен маған арқаңды көрсететіндей көп жүгіре алсаң...
Dialogue: 0,0:13:59.67,0:14:00.67,Top,,0000,0000,0000,,‎Егер ше?
Dialogue: 0,0:13:59.67,0:14:00.71,Bottom,,0000,0000,0000,,Сонда?
Dialogue: 0,0:14:01.59,0:14:02.34,Top,,0000,0000,0000,,А...
Dialogue: 0,0:14:04.84,0:14:05.63,Top,,0000,0000,0000,,‎Мм…
Dialogue: 0,0:14:11.30,0:14:12.22,Top,,0000,0000,0000,,‎(Дон!)
Dialogue: 0,0:14:20.06,0:14:21.86,Top,,0000,0000,0000,,‎Ха ха ха ха…
Dialogue: 0,0:14:21.94,0:14:24.02,Top,,0000,0000,0000,,‎Ол қашан сіздің досыңыз болды?
Dialogue: 0,0:14:22.02,0:14:24.15,Bottom,,0000,0000,0000,,Ол сізбен қанша уақыт болды?
Dialogue: 0,0:14:25.03,0:14:28.95,Bottom,,0000,0000,0000,,Бір жылдай болды ма? Оны киви кіргізді.
Dialogue: 0,0:14:25.11,0:14:29.03,Top,,0000,0000,0000,,Киви оны бір жылдай бұрын алған.
Dialogue: 0,0:14:29.03,0:14:31.82,Bottom,,0000,0000,0000,,Табиғатты тапқанын айтты.
Dialogue: 0,0:14:29.11,0:14:31.91,Top,,0000,0000,0000,,‎Маған қарулы біреуді тапқаныңызды айтыңыз.
Dialogue: 0,0:14:31.91,0:14:33.08,Bottom,,0000,0000,0000,,Бұған дейін ше?
Dialogue: 0,0:14:31.99,0:14:33.08,Top,,0000,0000,0000,,Бұған дейін?
Dialogue: 0,0:14:33.16,0:14:36.54,Bottom,,0000,0000,0000,,Мен білмеймін. Мен айтқанымдай, оның өзінен сұраңыз.
Dialogue: 0,0:14:33.16,0:14:36.66,Top,,0000,0000,0000,,Мен де егжей-тегжейлі білмеймін. Білгіңіз келсе, өзіңізден сұраңыз.
Dialogue: 0,0:14:37.12,0:14:39.37,Bottom,,0000,0000,0000,,Мен адамдардың өткеніне екі жақты қарамаймын
Dialogue: 0,0:14:37.20,0:14:39.37,Top,,0000,0000,0000,,‎Мен үшін маңыздысы
Dialogue: 0,0:14:39.46,0:14:42.50,Bottom,,0000,0000,0000,,олар өз салмағын көтере алғанша.
Dialogue: 0,0:14:39.46,0:14:42.50,Top,,0000,0000,0000,,‎Бұл бірге жиналатын нәрсе ме?
Dialogue: 0,0:14:42.59,0:14:44.50,Bottom,,0000,0000,0000,,Осылай деп ойладым.
Dialogue: 0,0:14:42.59,0:14:44.50,Top,,0000,0000,0000,,‎Бұл ең бастысы сияқты.
Dialogue: 0,0:14:45.00,0:14:46.46,Top,,0000,0000,0000,,‎(2 адам)
Dialogue: 0,0:14:47.09,0:14:47.88,Top,,0000,0000,0000,,‎(инъекция дыбысы)
Dialogue: 0,0:14:47.97,0:14:49.63,Top,,0000,0000,0000,,‎(2 адам) Ах~
Dialogue: 0,0:14:52.14,0:14:54.64,Top,,0000,0000,0000,,‎(спрей дыбысы)
Dialogue: 0,0:15:06.15,0:15:07.82,Top,,0000,0000,0000,,‎(зәрдің барабанның соғу дыбысы)
Dialogue: 0,0:15:07.90,0:15:09.49,Top,,0000,0000,0000,,Бұл тітіркендіргіш!
Dialogue: 0,0:15:07.94,0:15:09.45,Bottom,,0000,0000,0000,,«Ей, оны төмендет!
Dialogue: 0,0:15:11.03,0:15:12.24,Bottom,,0000,0000,0000,,Мұнда.
Dialogue: 0,0:15:11.07,0:15:12.24,Top,,0000,0000,0000,,Таку
Dialogue: 0,0:15:13.28,0:15:15.12,Top,,0000,0000,0000,,(Ер адамның жұмбақ сөздері)
Dialogue: 0,0:15:15.08,0:15:16.83,Bottom,,0000,0000,0000,,Джэ, бұл қатты.
Dialogue: 0,0:15:15.12,0:15:16.41,Top,,0000,0000,0000,,Керемет дыбыс
Dialogue: 0,0:15:16.41,0:15:16.83,Top,,0000,0000,0000,,(Ер адамның жұмбақ сөздері)
Dialogue: 0,0:15:16.91,0:15:17.75,Bottom,,0000,0000,0000,,Жалпы.
Dialogue: 0,0:15:16.91,0:15:18.66,Top,,0000,0000,0000,,(киви) ұзақ тітіркендіргіш
Dialogue: 0,0:15:17.83,0:15:18.70,Bottom,,0000,0000,0000,,Шынайы.
Dialogue: 0,0:15:18.75,0:15:23.08,Top,,0000,0000,0000,,‎Сен несің? Сіз ақымақ зәр шығарушысыз ба?
Dialogue: 0,0:15:18.79,0:15:21.25,Bottom,,0000,0000,0000,,Сіздің проблемаңыз не?
Dialogue: 0,0:15:21.33,0:15:23.08,Bottom,,0000,0000,0000,,Неге көшеде синайсың?!
Dialogue: 0,0:15:23.17,0:15:25.84,Top,,0000,0000,0000,,Ей, қария, мынау үлкен барабан.
Dialogue: 0,0:15:23.67,0:15:25.84,Bottom,,0000,0000,0000,,«Ей, досым! Мені естіп тұрсың ба?!
Dialogue: 0,0:15:25.92,0:15:27.17,Top,,0000,0000,0000,,Мені жалғыз қалдырмаңыз. Тесік алу үшін тым қуанбаңыз.
Dialogue: 0,0:15:25.92,0:15:27.21,Bottom,,0000,0000,0000,,Оны жайына қалдырыңыз.
Dialogue: 0,0:15:27.17,0:15:27.25,Top,,0000,0000,0000,,Тесік алу үшін қатты қуанбаңыз.
Dialogue: 0,0:15:27.25,0:15:28.59,Top,,0000,0000,0000,,Сізде бір тесік бар. Бақытты болма. Эй, қарғыс атқыр Аники.
Dialogue: 0,0:15:27.30,0:15:28.34,Bottom,,0000,0000,0000,,Сау бол бауырым.
Dialogue: 0,0:15:28.59,0:15:29.01,Top,,0000,0000,0000,,Тесік алу үшін қатты қуанбаңыз.
Dialogue: 0,0:15:29.09,0:15:30.67,Top,,0000,0000,0000,,‎Jobo jobo!
Dialogue: 0,0:15:29.13,0:15:30.67,Bottom,,0000,0000,0000,,Сіз бірдеңені іздеп жүрсіз бе?
Dialogue: 0,0:15:31.43,0:15:33.72,Bottom,,0000,0000,0000,,Мен сенімен сөйлесіп тұрмын! Мені тыңдайсың ба?!
Dialogue: 0,0:15:31.55,0:15:33.72,Top,,0000,0000,0000,,‎Эй, сен мені естисің бе?
Dialogue: 0,0:15:33.80,0:15:35.35,Top,,0000,0000,0000,,Тыңдашы, сен осыншама ұзақ сілейгенің үшін осындасың.
Dialogue: 0,0:15:33.80,0:15:39.73,Bottom,,0000,0000,0000,,Тыңдашы, біз пысықтап жүргенді ұнатпаймыз, құлыншақ.
Dialogue: 0,0:15:35.35,0:15:37.43,Top,,0000,0000,0000,,‎Тыңдаңыз, сіз осындасыз. Сіз ұзақ уақыт зәр шығарасыз. (шу дыбысы)
Dialogue: 0,0:15:37.43,0:15:37.51,Top,,0000,0000,0000,,Суасты кемесі ме?
Dialogue: 0,0:15:37.51,0:15:39.02,Top,,0000,0000,0000,,Бұл жақсы жер емес.
Dialogue: 0,0:15:39.02,0:15:39.73,Top,,0000,0000,0000,,Бұл жақсы жер емес.
Dialogue: 0,0:15:39.81,0:15:41.23,Top,,0000,0000,0000,,Түсінесіз бе?
Dialogue: 0,0:15:39.81,0:15:44.65,Bottom,,0000,0000,0000,,Жарайсың ба? Бұл тротуар бізге тиесілі...
Dialogue: 0,0:15:41.31,0:15:44.77,Top,,0000,0000,0000,,Бұл біздің жолымыз.
Dialogue: 0,0:15:44.73,0:15:49.61,Bottom,,0000,0000,0000,,О, бәлен! Бұл керемет имплант!
Dialogue: 0,0:15:44.86,0:15:47.23,Top,,0000,0000,0000,,Уау! Бұл не, адам?
Dialogue: 0,0:15:47.32,0:15:49.61,Top,,0000,0000,0000,,‎Уау, бұл шимпанз өсімдігі.
Dialogue: 0,0:15:49.69,0:15:50.49,Top,,0000,0000,0000,,‎Мм!
Dialogue: 0,0:15:50.57,0:15:52.15,Top,,0000,0000,0000,,‎Сен маған көп жұмыс бересің!
Dialogue: 0,0:15:50.57,0:15:53.07,Bottom,,0000,0000,0000,,«Hard as ir...» деген сөзге мүлде жаңа мағына береді.
Dialogue: 0,0:15:52.24,0:15:53.03,Top,,0000,0000,0000,,‎(Jaki!)
Dialogue: 0,0:15:58.95,0:15:59.75,Top,,0000,0000,0000,,А...
Dialogue: 0,0:16:11.92,0:16:13.34,Bottom,,0000,0000,0000,,Сәлем…
Dialogue: 0,0:16:11.92,0:16:13.34,Top,,0000,0000,0000,,‎(Баяу аудио: Негізгі) ‎Oi
Dialogue: 0,0:16:17.68,0:16:19.85,Bottom,,0000,0000,0000,,Да…
Dialogue: 0,0:16:17.68,0:16:23.06,Top,,0000,0000,0000,,‎Дэвид О
Dialogue: 0,0:16:19.93,0:16:23.06,Bottom,,0000,0000,0000,,бейне…
Dialogue: 0,0:16:24.44,0:16:26.23,Bottom,,0000,0000,0000,,жылжыту…
Dialogue: 0,0:16:24.44,0:16:26.23,Top,,0000,0000,0000,,Қаш!
Dialogue: 0,0:16:27.94,0:16:33.07,Top,,0000,0000,0000,,Цутеннога...
Dialogue: 0,0:16:35.61,0:16:38.24,Top,,0000,0000,0000,,Мен түсінбеймін...
Dialogue: 0,0:16:38.24,0:16:39.28,Top,,0000,0000,0000,,‎Мен түсінбедім... (Мылтық дыбысы)
Dialogue: 0,0:16:39.28,0:16:41.16,Top,,0000,0000,0000,,Мен түсінбеймін...
Dialogue: 0,0:16:41.25,0:16:42.45,Top,,0000,0000,0000,,… немесе…
Dialogue: 0,0:16:42.45,0:16:44.08,Top,,0000,0000,0000,,‎’s… немесе… (тепкі дыбысы)
Dialogue: 0,0:16:44.08,0:16:44.67,Top,,0000,0000,0000,,… немесе…
Dialogue: 0,0:16:44.67,0:16:45.79,Top,,0000,0000,0000,,‎... иә...
Dialogue: 0,0:16:46.88,0:16:48.88,Top,,0000,0000,0000,,‎(Жарылыс дыбысы)
Dialogue: 0,0:16:49.55,0:16:51.38,Bottom,,0000,0000,0000,,Тоңатын уақыт емес, балақай!
Dialogue: 0,0:16:49.67,0:16:51.38,Top,,0000,0000,0000,,‎Сен не істеп жатырсың, Дэвид?
Dialogue: 0,0:16:51.46,0:16:52.51,Bottom,,0000,0000,0000,,Оны жауып тастады!
Dialogue: 0,0:16:51.46,0:16:52.55,Top,,0000,0000,0000,,Пилар өлтірілді
Dialogue: 0,0:16:52.59,0:16:54.34,Bottom,,0000,0000,0000,,-Менде Пилар биттері бар... - Беріңізші!
Dialogue: 0,0:16:52.63,0:16:54.59,Top,,0000,0000,0000,,‎(Киви) Ми құлап жатыр ‎Маған қарызға бер!
Dialogue: 0,0:16:54.43,0:16:57.01,Bottom,,0000,0000,0000,,Блять!
Dialogue: 0,0:16:54.68,0:16:57.09,Top,,0000,0000,0000,,‎Бұл өте күлкілі!
Dialogue: 0,0:16:57.09,0:16:58.47,Bottom,,0000,0000,0000,,Сенің құқығың жоқ еді!
Dialogue: 0,0:16:57.18,0:16:59.10,Top,,0000,0000,0000,,Мұны кімнің рұқсатымен істедің?
Dialogue: 0,0:16:58.55,0:17:01.72,Bottom,,0000,0000,0000,,Психо қоқыс!
Dialogue: 0,0:16:59.18,0:17:01.72,Top,,0000,0000,0000,,‎Сен мені өлтірдің!
Dialogue: 0,0:17:01.81,0:17:02.77,Top,,0000,0000,0000,,‎Ааа!
Dialogue: 0,0:17:02.85,0:17:03.60,Top,,0000,0000,0000,,Кя!
Dialogue: 0,0:17:04.27,0:17:07.15,Top,,0000,0000,0000,,Сен ақымақ! Сенің де сенің басың ұшып кетеді!
Dialogue: 0,0:17:04.31,0:17:07.23,Bottom,,0000,0000,0000,,Ақымақ, сіз оқ атудан тезірек түзелесіз!
Dialogue: 0,0:17:07.23,0:17:09.48,Top,,0000,0000,0000,,Уф, боқ! Ой... ой
Dialogue: 0,0:17:07.31,0:17:08.73,Bottom,,0000,0000,0000,,Мені жіберіңізші!
Dialogue: 0,0:17:11.11,0:17:12.15,Bottom,,0000,0000,0000,,Өл!
Dialogue: 0,0:17:11.19,0:17:12.11,Top,,0000,0000,0000,,Өл!
Dialogue: 0,0:17:15.57,0:17:17.49,Top,,0000,0000,0000,,‎Уф уф
Dialogue: 0,0:17:17.78,0:17:19.41,Bottom,,0000,0000,0000,,Боқ, барлық уақытта…
Dialogue: 0,0:17:18.03,0:17:19.87,Top,,0000,0000,0000,,Қарғыс атсын, осындай уақытта
Dialogue: 0,0:17:19.95,0:17:21.99,Top,,0000,0000,0000,,Киви! Ребекканың жүйесі қалпына келтірілді!
Dialogue: 0,0:17:19.99,0:17:21.99,Bottom,,0000,0000,0000,,Киви! Бекка жүйесін қалпына келтіріңіз!
Dialogue: 0,0:17:22.08,0:17:23.16,Bottom,,0000,0000,0000,,Ол туралы.
Dialogue: 0,0:17:22.08,0:17:23.16,Top,,0000,0000,0000,,‎(Киви) Иә Иә
Dialogue: 0,0:17:23.25,0:17:24.20,Top,,0000,0000,0000,,‎(ұшқын дыбысы)
Dialogue: 0,0:17:25.50,0:17:26.33,Top,,0000,0000,0000,,Ух... Ха!
Dialogue: 0,0:17:27.17,0:17:28.08,Top,,0000,0000,0000,,‎Люси ше?
Dialogue: 0,0:17:27.17,0:17:28.21,Bottom,,0000,0000,0000,,Люси қайда?!
Dialogue: 0,0:17:35.55,0:17:36.51,Top,,0000,0000,0000,,О?
Dialogue: 0,0:17:37.55,0:17:38.55,Top,,0000,0000,0000,,‎(Жарылыс дыбысы)
Dialogue: 0,0:17:38.64,0:17:39.55,Top,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:17:39.64,0:17:41.51,Top,,0000,0000,0000,,‎Темее!
Dialogue: 0,0:17:39.64,0:17:41.60,Bottom,,0000,0000,0000,,Әй, ақымақ!
Dialogue: 0,0:17:42.26,0:17:43.47,Top,,0000,0000,0000,,‎(жұмбақ сөз)
Dialogue: 0,0:17:43.56,0:17:44.31,Top,,0000,0000,0000,,Дэвид!
Dialogue: 0,0:17:43.56,0:17:44.48,Bottom,,0000,0000,0000,,Давид!
Dialogue: 0,0:17:56.03,0:17:56.86,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:18:01.58,0:18:02.99,Bottom,,0000,0000,0000,,Люси!
Dialogue: 0,0:18:02.08,0:18:02.99,Top,,0000,0000,0000,,Люси!
Dialogue: 0,0:18:03.08,0:18:05.83,Top,,0000,0000,0000,,‎(Люси) Фу... Жарайды.
Dialogue: 0,0:18:04.83,0:18:05.91,Bottom,,0000,0000,0000,,Менде бәрі жақсы.
Dialogue: 0,0:18:06.58,0:18:08.00,Bottom,,0000,0000,0000,,Қасиетті орындарым қалайша күйреді.
Dialogue: 0,0:18:06.62,0:18:08.00,Top,,0000,0000,0000,,Жақсы…
Dialogue: 0,0:18:10.17,0:18:11.00,Bottom,,0000,0000,0000,,Қансырап жатыр...
Dialogue: 0,0:18:10.33,0:18:11.00,Top,,0000,0000,0000,,Қан!
Dialogue: 0,0:18:11.09,0:18:12.00,Top,,0000,0000,0000,,‎(Jaki!)
Dialogue: 0,0:18:12.09,0:18:12.75,Top,,0000,0000,0000,,‎Ха!
Dialogue: 0,0:18:17.34,0:18:18.01,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:18:18.59,0:18:23.35,Top,,0000,0000,0000,,‎Мен ғана оны өлтіруге құқылымын!
Dialogue: 0,0:18:18.59,0:18:23.39,Bottom,,0000,0000,0000,,Мен оны өлтіруге рұқсат етілген жалғыз адаммын...
Dialogue: 0,0:18:23.85,0:18:25.52,Top,,0000,0000,0000,,‎(дірілдеген тыныс)
Dialogue: 0,0:18:25.60,0:18:26.60,Top,,0000,0000,0000,,‎Pe!
Dialogue: 0,0:18:27.52,0:18:28.94,Bottom,,0000,0000,0000,,Маған тиіспе.
Dialogue: 0,0:18:27.52,0:18:28.94,Top,,0000,0000,0000,,‎(Люси) Маған тиіспе
Dialogue: 0,0:18:29.02,0:18:30.90,Bottom,,0000,0000,0000,,Сізге медициналық көмек қажет пе?
Dialogue: 0,0:18:29.02,0:18:30.94,Top,,0000,0000,0000,,Жедел жәрдем бөлмесіне баруым керек пе?
Dialogue: 0,0:18:30.98,0:18:31.94,Bottom,,0000,0000,0000,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:18:31.02,0:18:31.98,Top,,0000,0000,0000,,Барма
Dialogue: 0,0:18:32.02,0:18:35.57,Bottom,,0000,0000,0000,,Дорио, Люсиді рипердокқа апарыңыз.
Dialogue: 0,0:18:32.06,0:18:35.57,Top,,0000,0000,0000,,Дорио: Люсиді Риперге апарыңыз.
Dialogue: 0,0:18:36.19,0:18:39.91,Bottom,,0000,0000,0000,,Шошқалар келгенше мен кивимен бірге боламын.
Dialogue: 0,0:18:36.24,0:18:39.95,Top,,0000,0000,0000,,Киви екеуміз NCPD келгенше осында боламыз.
Dialogue: 0,0:18:39.99,0:18:43.33,Bottom,,0000,0000,0000,,Біреу мынаны түсіндіруі керек.
Dialogue: 0,0:18:40.03,0:18:43.33,Top,,0000,0000,0000,,Әңгімеден хабардар болған дұрыс, Ол сізді кейінірек қиындықтан құтқарады.
Dialogue: 0,0:18:43.41,0:18:44.83,Top,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:18:43.41,0:18:44.91,Bottom,,0000,0000,0000,,Сіз оны естідіңіз.
Dialogue: 0,0:18:44.91,0:18:46.33,Top,,0000,0000,0000,,‎(Люси) Хмм...
Dialogue: 0,0:18:46.41,0:18:49.08,Bottom,,0000,0000,0000,,Сен олармен жүр, балам.
Dialogue: 0,0:18:46.41,0:18:49.21,Top,,0000,0000,0000,,‎Дэвид, сен менімен баруың керек.
Dialogue: 0,0:18:49.16,0:18:50.04,Bottom,,0000,0000,0000,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:18:49.29,0:18:50.04,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:50.12,0:18:52.42,Top,,0000,0000,0000,,Киви екеуміз оны өлтірдік делік.
Dialogue: 0,0:18:50.12,0:18:55.00,Bottom,,0000,0000,0000,,Біз оларға Пиларды нөлге келтіргеннен кейін оны алып кеткенімізді айтамыз.
Dialogue: 0,0:18:52.50,0:18:55.09,Top,,0000,0000,0000,,Қалай қарасаңыз да, ол кибер психозға шалдыққан жігіт.
Dialogue: 0,0:18:55.09,0:18:58.51,Bottom,,0000,0000,0000,,Олар оны киберпсихикалық оқиға ретінде жібереді, бірақ сіздің бұл жерде болмағаныңыз жақсы.
Dialogue: 0,0:18:55.17,0:18:58.63,Top,,0000,0000,0000,,‎Пирал өлтірілгендіктен, бұл біраз қиынға соғатын сияқты.
Dialogue: 0,0:18:58.59,0:18:59.42,Bottom,,0000,0000,0000,,Бірақ…
Dialogue: 0,0:18:58.72,0:18:59.55,Top,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:18:59.51,0:19:01.34,Bottom,,0000,0000,0000,,Мен сенің не істегеніңді көрдім.
Dialogue: 0,0:18:59.63,0:19:01.34,Top,,0000,0000,0000,,Сіз оны ертерек түсіре алар едіңіз.
Dialogue: 0,0:19:01.43,0:19:03.97,Bottom,,0000,0000,0000,,Жаңа ойыншы сияқты ойлауды тоқтатқан кез.
Dialogue: 0,0:19:01.43,0:19:03.97,Top,,0000,0000,0000,,‎Мәңгілік жаңа ойыншы болып қалмаңыз
Dialogue: 0,0:19:06.06,0:19:10.31,Bottom,,0000,0000,0000,,Тағы да көп болдыңыз ба? Мен шын мәнінде лицензияланған физик емеспін, білесіз бе.
Dialogue: 0,0:19:06.27,0:19:10.35,Top,,0000,0000,0000,,‎(Дәрігер) Біз жедел жәрдем дәрігері емеспіз.
Dialogue: 0,0:19:10.39,0:19:13.44,Bottom,,0000,0000,0000,,Мен де өз еркімен келген жоқпын.
Dialogue: 0,0:19:10.44,0:19:13.48,Top,,0000,0000,0000,,Менің де мұнда келгім келмеді.
Dialogue: 0,0:19:13.52,0:19:15.15,Bottom,,0000,0000,0000,,Керемет.
Dialogue: 0,0:19:13.56,0:19:15.15,Top,,0000,0000,0000,,‎(Липпардок) Міне, міне, осы
Dialogue: 0,0:19:15.23,0:19:16.48,Bottom,,0000,0000,0000,,Мен жалғыз барамын.
Dialogue: 0,0:19:15.23,0:19:16.48,Top,,0000,0000,0000,,Жалғыз болған дұрыс
Dialogue: 0,0:19:17.36,0:19:20.07,Bottom,,0000,0000,0000,,Оны тазалап, үйіне жеткіз.
Dialogue: 0,0:19:17.36,0:19:20.15,Top,,0000,0000,0000,,Жарайды, Дэвид, қалғанын сұрадым.
Dialogue: 0,0:19:20.15,0:19:23.20,Bottom,,0000,0000,0000,,-Сіз кетесіз бе? -Мэйн оның көлігін алуға болады деді.
Dialogue: 0,0:19:20.24,0:19:21.20,Top,,0000,0000,0000,,‎Ааа... Эй!
Dialogue: 0,0:19:21.28,0:19:23.32,Top,,0000,0000,0000,,‎Автокөлікті негізгі көлік ретінде пайдалану дұрыс емес.
Dialogue: 0,0:19:27.74,0:19:29.00,Top,,0000,0000,0000,,‎(есік жабылған дыбыс)
Dialogue: 0,0:19:30.12,0:19:32.00,Top,,0000,0000,0000,,О, Люси
Dialogue: 0,0:19:30.87,0:19:32.00,Bottom,,0000,0000,0000,,Люси.
Dialogue: 0,0:19:42.34,0:19:44.22,Top,,0000,0000,0000,,‎(Люси) Жетеді, ә...
Dialogue: 0,0:19:42.38,0:19:44.22,Bottom,,0000,0000,0000,,-Жарайсыңдар. -Әрине.
Dialogue: 0,0:19:44.30,0:19:45.22,Bottom,,0000,0000,0000,,Қайырлы түн.
Dialogue: 0,0:19:44.80,0:19:45.64,Top,,0000,0000,0000,,‎Я
Dialogue: 0,0:19:45.72,0:19:47.76,Top,,0000,0000,0000,,А...
Dialogue: 0,0:19:45.85,0:19:50.35,Bottom,,0000,0000,0000,,Мм... Сөйлесе аламыз ба?
Dialogue: 0,0:19:48.35,0:19:50.10,Top,,0000,0000,0000,,‎Аздап сөйлесе аламыз ба?
Dialogue: 0,0:19:54.81,0:19:56.02,Bottom,,0000,0000,0000,,Осы жолмен.
Dialogue: 0,0:19:54.81,0:19:56.11,Top,,0000,0000,0000,,(Люси) Осы жолмен
Dialogue: 0,0:20:00.32,0:20:02.91,Bottom,,0000,0000,0000,,Әу. Бәрі бұлтты.
Dialogue: 0,0:20:00.32,0:20:02.99,Top,,0000,0000,0000,,‎(Люси) Ау, бұлтты.
Dialogue: 0,0:20:02.99,0:20:07.03,Bottom,,0000,0000,0000,,Сіз маған көрсеткен BD айы өте тәтті болды.
Dialogue: 0,0:20:03.07,0:20:05.74,Top,,0000,0000,0000,,‎Сол Ай BD керемет болды.
Dialogue: 0,0:20:05.82,0:20:06.99,Top,,0000,0000,0000,,Бұл қызық болды
Dialogue: 0,0:20:12.66,0:20:15.29,Bottom,,0000,0000,0000,,Менің де айтқым келген нәрсе бар еді.
Dialogue: 0,0:20:12.71,0:20:15.21,Top,,0000,0000,0000,,(Люси) Менің де сөйлескім келді.
Dialogue: 0,0:20:15.29,0:20:16.25,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:15.38,0:20:16.25,Bottom,,0000,0000,0000,,Біздің руға шабуыл жасаған Маскалылар Эбису-саманың…
Dialogue: 0,0:20:16.34,0:20:20.92,Top,,0000,0000,0000,,Менің сол күні айтқаным өтірік емес еді.
Dialogue: 0,0:20:16.34,0:20:21.42,Bottom,,0000,0000,0000,,Мен оның қалай көрінетінін білемін, бірақ... Мен сізге сол күні не дедім?
Dialogue: 0,0:20:21.51,0:20:24.64,Bottom,,0000,0000,0000,,Мен өтірік айтқан жоқпын. Бұл бірінші рет ешкімге айттым.
Dialogue: 0,0:20:21.63,0:20:24.01,Top,,0000,0000,0000,,‎Мен мұны біреумен бірінші рет жасауым еді.
Dialogue: 0,0:20:24.72,0:20:25.76,Bottom,,0000,0000,0000,,Бұл…
Dialogue: 0,0:20:24.80,0:20:28.22,Top,,0000,0000,0000,,Жақсы. Мұның бәрі өтірік болды.
Dialogue: 0,0:20:25.84,0:20:29.77,Bottom,,0000,0000,0000,,Бұл жақсы. Мен сені өтірік айтып тұр деп ойлағым келмеді.
Dialogue: 0,0:20:28.31,0:20:29.77,Top,,0000,0000,0000,,Мен бұл туралы ойлағым келмеді.
Dialogue: 0,0:20:30.35,0:20:32.02,Top,,0000,0000,0000,,(Люси) Мүмкін сіз әлі өтірік айтып жатқан шығарсыз.
Dialogue: 0,0:20:30.39,0:20:32.02,Bottom,,0000,0000,0000,,Мен қазір өтірік айтсам ше?
Dialogue: 0,0:20:32.10,0:20:33.39,Top,,0000,0000,0000,,Мен бұған сенбеймін
Dialogue: 0,0:20:32.10,0:20:34.27,Bottom,,0000,0000,0000,,-Мен сені олай емес деп ойлаймын. -Неге жоқ?
Dialogue: 0,0:20:33.48,0:20:34.27,Top,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:20:34.35,0:20:35.40,Top,,0000,0000,0000,,Себебі бұл маған ұнамайды
Dialogue: 0,0:20:34.35,0:20:37.02,Bottom,,0000,0000,0000,,-'Себебі маған бұл ұнамайды. -Бұл ақылсыз.
Dialogue: 0,0:20:35.48,0:20:37.02,Top,,0000,0000,0000,,Иә, бұл не?
Dialogue: 0,0:20:37.11,0:20:39.65,Bottom,,0000,0000,0000,,Сіз бірдеңені ертерек айтуыңыз керек еді.
Dialogue: 0,0:20:37.11,0:20:39.65,Top,,0000,0000,0000,,‎Маған ертерек айтқаныңызды қалаймын.
Dialogue: 0,0:20:39.73,0:20:41.40,Bottom,,0000,0000,0000,,Мен алмадым.
Dialogue: 0,0:20:39.73,0:20:41.40,Top,,0000,0000,0000,,Мен оны айта алмаймын.
Dialogue: 0,0:20:41.49,0:20:42.40,Bottom,,0000,0000,0000,,Неліктен жоқ?
Dialogue: 0,0:20:41.49,0:20:42.40,Top,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:20:42.49,0:20:44.66,Top,,0000,0000,0000,,Сіз маған ашулы болдыңыз, солай ма?
Dialogue: 0,0:20:42.99,0:20:44.66,Bottom,,0000,0000,0000,,Сен маған қатты ашуландың.
Dialogue: 0,0:20:44.74,0:20:46.03,Bottom,,0000,0000,0000,,Мен ашуланбадым.
Dialogue: 0,0:20:45.20,0:20:46.03,Top,,0000,0000,0000,,Мен ашулы емеспін
Dialogue: 0,0:20:46.11,0:20:47.62,Top,,0000,0000,0000,,Сіз ашулы болдыңыз.
Dialogue: 0,0:20:46.11,0:20:48.03,Bottom,,0000,0000,0000,,Сондай-ақ болды.
Dialogue: 0,0:20:48.12,0:20:49.99,Top,,0000,0000,0000,,‎Мен ашуландым...
Dialogue: 0,0:20:48.12,0:20:52.29,Bottom,,0000,0000,0000,,Мен ашулы емеспін, жай ғана... Иә, иә. Мен болдым деп ойлаймын.
Dialogue: 0,0:20:50.70,0:20:52.29,Top,,0000,0000,0000,,Менің ойымша, ол ашулы болды.
Dialogue: 0,0:20:52.37,0:20:53.54,Bottom,,0000,0000,0000,,Ф-Фатирлеу ештеңе әкелмейді.
Dialogue: 0,0:20:52.37,0:20:53.54,Top,,0000,0000,0000,,Мен мойындадым.
Dialogue: 0,0:20:53.62,0:20:55.54,Bottom,,0000,0000,0000,,Мен ашуландым, бірақ...
Dialogue: 0,0:20:53.62,0:20:55.54,Top,,0000,0000,0000,,Мен ашуланған шығармын.
Dialogue: 0,0:20:55.62,0:20:57.54,Bottom,,0000,0000,0000,,Мен саған ренжіген жоқпын.
Dialogue: 0,0:20:56.12,0:20:57.54,Top,,0000,0000,0000,,Себебі мен сені жек көрмеймін
Dialogue: 0,0:20:59.63,0:21:01.80,Bottom,,0000,0000,0000,,Мен құтқарсам, сені құтқармас едім.
Dialogue: 0,0:20:59.63,0:21:01.80,Top,,0000,0000,0000,,Мен сізге басқаша көмектеспеймін.
Dialogue: 0,0:21:01.88,0:21:02.67,Top,,0000,0000,0000,,Өтірік
Dialogue: 0,0:21:01.88,0:21:03.55,Bottom,,0000,0000,0000,,-Өтірікші. -Мен емес.
Dialogue: 0,0:21:02.76,0:21:03.55,Top,,0000,0000,0000,,Рас
Dialogue: 0,0:21:03.63,0:21:04.68,Bottom,,0000,0000,0000,,Жоқ, бұл өтірік.
Dialogue: 0,0:21:03.63,0:21:04.68,Top,,0000,0000,0000,,Бұл өтірік
Dialogue: 0,0:21:04.76,0:21:06.84,Top,,0000,0000,0000,,Сіз секіресіз.
Dialogue: 0,0:21:04.76,0:21:11.22,Bottom,,0000,0000,0000,,Сіз күйіп қалсаңыз да, біреуді құтқару үшін отқа секіретін жігітсіз.
Dialogue: 0,0:21:06.93,0:21:11.22,Top,,0000,0000,0000,,Кез келген адам ойланбастан рефлексивті түрде...
Dialogue: 0,0:21:11.93,0:21:13.52,Bottom,,0000,0000,0000,,Сіз сондай адамсыз.
Dialogue: 0,0:21:12.14,0:21:13.48,Top,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:21:14.52,0:21:16.90,Bottom,,0000,0000,0000,,Сондықтан мен үлгере алмаймын деп ойлайсың ба?
Dialogue: 0,0:21:14.52,0:21:17.06,Top,,0000,0000,0000,,‎Сонымен сіз мені жарамсыз деп айтасыз ба?
Dialogue: 0,0:21:17.48,0:21:20.27,Bottom,,0000,0000,0000,,Мэн мен істеймін деп ойлайды. Неге болмайды...
Dialogue: 0,0:21:17.56,0:21:20.27,Top,,0000,0000,0000,,Негізгі оны мақұлдайды, бірақ сіз ...
Dialogue: 0,0:21:20.36,0:21:21.78,Top,,0000,0000,0000,,‎(Люси) Олай емес.
Dialogue: 0,0:21:20.36,0:21:24.82,Bottom,,0000,0000,0000,,Жоқ, олай емес. Менің ойымша, сіз жақсы жүгіруші болар едіңіз.
Dialogue: 0,0:21:21.86,0:21:24.90,Top,,0000,0000,0000,,Менің ойымша, сіз жақсы киберпанк бола аласыз.
Dialogue: 0,0:21:25.61,0:21:27.57,Bottom,,0000,0000,0000,,Мен шынымен солаймын.
Dialogue: 0,0:21:25.74,0:21:27.70,Top,,0000,0000,0000,,Мүмкін солай шығар.
Dialogue: 0,0:21:27.66,0:21:28.99,Bottom,,0000,0000,0000,,Сонымен, мәселе неде?
Dialogue: 0,0:21:27.78,0:21:29.07,Top,,0000,0000,0000,,Онда неге...
Dialogue: 0,0:21:29.07,0:21:32.95,Bottom,,0000,0000,0000,,Сіз қалай өмір сүріп жатқаныңыз арқылы киберпанк ретінде ат салмайсыз.
Dialogue: 0,0:21:29.16,0:21:31.33,Top,,0000,0000,0000,,‎(Люси) ‎Бұл әлемде өз атыңызды қалай қалдыруға болады
Dialogue: 0,0:21:31.41,0:21:32.95,Top,,0000,0000,0000,,Бұл сіздің қалай өмір сүретініңіз туралы емес.
Dialogue: 0,0:21:34.00,0:21:35.62,Bottom,,0000,0000,0000,,Сіз қалай өлгеніңізбен есте қаласыз.
Dialogue: 0,0:21:34.12,0:21:35.41,Top,,0000,0000,0000,,‎Мен қалай өлемін?
Dialogue: 0,0:21:37.71,0:21:40.04,Bottom,,0000,0000,0000,,Бұл сізге лайықты өмір немесе соңғы емес.
Dialogue: 0,0:21:37.71,0:21:40.09,Top,,0000,0000,0000,,Бұл сізге сәйкес келмейді.
Dialogue: 0,0:21:40.13,0:21:43.26,Bottom,,0000,0000,0000,,Менің сенен айырмашылығым неде?
Dialogue: 0,0:21:40.17,0:21:43.34,Top,,0000,0000,0000,,Сіз ше? Менен айырмашылығы көп емес.
Dialogue: 0,0:21:43.34,0:21:46.01,Bottom,,0000,0000,0000,,Менің басқа баратын жерім жоқ.
Dialogue: 0,0:21:43.42,0:21:46.01,Top,,0000,0000,0000,,(Люси) Менің басқа болатын жерім жоқ.
Dialogue: 0,0:21:46.09,0:21:47.38,Bottom,,0000,0000,0000,,Менде де жоқ.
Dialogue: 0,0:21:46.09,0:21:47.38,Top,,0000,0000,0000,,Бұл менмін...
Dialogue: 0,0:21:47.47,0:21:49.18,Bottom,,0000,0000,0000,,Сен екеуміз екі дүниеміз.
Dialogue: 0,0:21:47.47,0:21:49.18,Top,,0000,0000,0000,,‎(Люси) Сіз екеуміз басқамыз.
Dialogue: 0,0:21:49.26,0:21:49.97,Top,,0000,0000,0000,,Қайда!
Dialogue: 0,0:21:49.26,0:21:50.55,Bottom,,0000,0000,0000,,Қалай?!
Dialogue: 0,0:21:54.06,0:21:56.23,Bottom,,0000,0000,0000,,Мен сені айға апарамын!
Dialogue: 0,0:21:54.06,0:21:56.23,Top,,0000,0000,0000,,Мен сені айға апарамын
Dialogue: 0,0:21:58.06,0:21:59.40,Top,,0000,0000,0000,,Уәде
Dialogue: 0,0:21:58.06,0:21:59.69,Bottom,,0000,0000,0000,,Уәде беремін!
Dialogue: 0,0:22:09.57,0:22:11.49,Bottom,,0000,0000,0000,,Мен сенің өлгеніңді қаламаймын.
Dialogue: 0,0:22:09.66,0:22:11.49,Top,,0000,0000,0000,,‎(Люси) Мен сенің өлгеніңді қаламаймын.
Dialogue: 0,0:22:20.58,0:22:22.59,Top,,0000,0000,0000,,‎(Люсидің тынысы)
Dialogue: 0,0:22:29.80,0:22:31.39,Bottom,,0000,0000,0000,,Мен алмаймын.
Dialogue: 0,0:22:29.93,0:22:31.30,Top,,0000,0000,0000,,Сіз өлесіз бе?
Dialogue: 0,0:22:36.52,0:22:41.52,Top,,0000,0000,0000,,♪~
Dialogue: 0,0:24:01.52,0:24:06.52,Top,,0000,0000,0000,,~♪
