Dialogue: 1,0:23:02.35,0:23:05.94,IN-EN,,0,0,0,,Себебі мен сіздің үйіңізде қалғым келеді
Dialogue: 1,0:23:05.94,0:23:09.41,IN-EN,,0,0,0,,Бұл нәтиже береді деп үміттенемін
Dialogue: 1,0:23:10.14,0:23:13.21,IN-EN,,0,0,0,,Бірақ сен мені қаншалықты сындырғаныңды білесің
Dialogue: 1,0:23:13.21,0:23:15.70,IN-EN,,0,0,0,,Мен сенімен біттім, мен сені елемеймін
Dialogue: 1,0:23:15.70,0:23:18.37,IN-EN,,0,0,0,,Менің білгім келмейді
Dialogue: 1,0:23:25.89,0:23:28.38,IN-EN,,0,0,0,,Ой-ой, о-о-о
Dialogue: 1,0:23:28.38,0:23:31.82,IN-EN,,0,0,0,,Мен неге ешкім емес екенімді білмеймін
Dialogue: 1,0:23:33.81,0:23:35.93,IN-EN,,0,0,0,,Олай болса, кет
Dialogue: 1,0:23:36.20,0:23:40.39,IN-EN,,0,0,0,,Өзіңіз білгіңіз келмейтін нәрсені сезінудің тағы бір жолы
Dialogue: 1,0:23:40.39,0:23:42.39,IN-EN,,0,0,0,,Ал өзіңізді жіберіңіз
Dialogue: 1,0:23:43.34,0:23:47.45,IN-EN,,0,0,0,,Сіз өзіңізді бақылауды жоғалтпағаныңызды білесіз
Dialogue: 1,0:23:47.45,0:23:50.01,IN-EN,,0,0,0,,Кемпірқосақтан бастайық
Dialogue: 1,0:23:50.01,0:23:51.32,IN-EN,,0,0,0,,Бұрылыңыз
Dialogue: 1,0:23:51.55,0:23:56.41,IN-EN,,0,0,0,,Өзіңіз қаламаған жерде болудың тағы бір жолы
Dialogue: 1,0:23:56.41,0:23:57.97,IN-EN,,0,0,0,,Өзіңізді жіберіңіз
Dialogue: 1,0:23:58.77,0:24:02.41,IN-EN,,0,0,0,,Бұл ымыраға келу ме?
Dialogue: 1,0:24:20.43,0:24:25.03,IN-EN,,0,0,0,,Сонымен, сіз не істегіңіз келеді, сіздің көзқарасыңыз қандай
Dialogue: 1,0:24:25.03,0:24:28.79,IN-EN,,0,0,0,,Жақында кеш бар, барғың келе ме?
Dialogue: 1,0:24:28.79,0:24:33.05,IN-EN,,0,0,0,,Сізбен қол алысу, сіздің көзқарасыңыз қандай?
Dialogue: 1,0:24:33.05,0:24:35.99,IN-EN,,0,0,0,,Мен сенің үстіңдемін, барғым келмейді
Dialogue: 1,0:24:35.99,0:24:39.80,IN-EN,,0,0,0,,Себебі мен сіздің үйіңізде қалғым келеді
Dialogue: 1,0:24:39.95,0:24:43.00,IN-EN,,0,0,0,,Бұл нәтиже береді деп үміттенемін
Dialogue: 1,0:24:43.56,0:24:46.78,IN-EN,,0,0,0,,Бірақ сен мені қаншалықты сындырғаныңды білесің
Dialogue: 1,0:24:46.78,0:24:49.83,IN-EN,,0,0,0,,Мен сенімен біттім, мен сені елемеймін
Dialogue: 1,0:24:49.83,0:24:51.91,IN-EN,,0,0,0,,Менің білгім келмейді
Dialogue: 1,0:25:19.82,0:25:23.99,ED-JP_EP02,,0,0,0,,Олар ақырында жалынды сезінеді
Dialogue: 1,0:25:24.17,0:25:28.36,ED-JP_EP02,,0,0,0,,Тамырымда ағып жатқан жалын
Dialogue: 1,0:25:28.70,0:25:32.71,ED-JP_EP02,,0,0,0,,Мен бұл қаланы өртеп жіберемін
Dialogue: 1,0:25:32.92,0:25:37.07,ED-JP_EP02,,0,0,0,,Біз қайтуды жоспарламаймыз
Dialogue: 1,0:25:37.92,0:25:41.75,ED-JP_EP02,,0,0,0,,Еркін болуға тырысу
Dialogue: 1,0:25:42.09,0:25:45.35,ED-JP_EP02,,0,0,0,,Менің көргенімді сендерге көрсету үшін
Dialogue: 1,0:25:46.75,0:25:50.59,ED-JP_EP02,,0,0,0,,Өз тілектеріңізді ұстаныңыз
Dialogue: 1,0:25:50.59,0:25:54.24,ED-JP_EP02,,0,0,0,,Егер сіз мені ұстай алмасаңыз
Dialogue: 1,0:25:54.58,0:25:57.36,ED-JP_EP02,,0,0,0,,Көңіліңізді түсіргенім үшін кешіріңіз
Dialogue: 1,0:25:59.11,0:26:03.02,ED-JP_EP02,,0,0,0,,Сізді тағы да ренжіткенім үшін кешіріңіз
Dialogue: 1,0:26:03.36,0:26:06.44,ED-JP_EP02,,0,0,0,,Менің күшім жеткіліксіз деп ойлаймын
Dialogue: 1,0:26:08.15,0:26:09.87,ED-JP_EP02,,0,0,0,,Дәл қазір
Dialogue: 1,0:26:10.29,0:26:11.37,ED-JP_EP02,,0,0,0,,Сізді ренжітіңіз
Dialogue: 1,0:26:11.37,0:26:17.38,ED-JP_EP02,,0,0,0,,О, менің махаббатым
Dialogue: 1,0:26:25.63,0:26:28.34,ED-JP_EP02,,0,0,0,,Ой, көңіліңді қалдыр
Dialogue: 0,0:25:19.82,0:25:23.99,ED-CH_EP02,,0,0,0,,Адамзаттың ақыры жалынмен сезіледі
Dialogue: 0,0:25:24.17,0:25:28.36,ED-CH_EP02,,0,0,0,,Тамырымда күйіп
Dialogue: 0,0:25:28.70,0:25:32.71,ED-CH_EP02,,0,0,0,,От жарық қаласы
Dialogue: 0,0:25:32.92,0:25:37.07,ED-CH_EP02,,0,0,0,,Қайтару
Dialogue: 0,0:25:37.92,0:25:41.75,ED-CH_EP02,,0,0,0,,Тегін және тегін
Dialogue: 0,0:25:42.09,0:25:45.35,ED-CH_EP02,,0,0,0,,Менің не істей алатынымды көргің келсе
Dialogue: 0,0:25:46.75,0:25:50.59,ED-CH_EP02,,0,0,0,,Меншік иесінің қалауы
Dialogue: 0,0:25:50.59,0:25:54.24,ED-CH_EP02,,0,0,0,,Нәтиже қайталанбайды деп үміттенемін
Dialogue: 0,0:25:54.58,0:25:57.36,ED-CH_EP02,,0,0,0,,Көңілсіздік
Dialogue: 0,0:25:59.11,0:26:03.02,ED-CH_EP02,,0,0,0,,Көңілсіздік
Dialogue: 0,0:26:03.36,0:26:06.44,ED-CH_EP02,,0,0,0,,Менің өзімді тануым күшті
Dialogue: 0,0:26:29.84,0:26:35.84,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
