Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.98,0:00:12.98,Staff,,0,0,0,,Бұл субтитрді Moechaya жазған Жабдықтаушы алмасу сынағы және мониторингі шығарған Коммерциялық мақсатта пайдалану Аударма: mugi Өңдеу: Dysonsphere Уақыты: astrayveller Кейінгі кезең: MIR әзірлеу: Catworm
Dialogue: 1,0:00:00.80,0:00:02.61,Dial-JP,,0,0,0,,Оны мен үшін орнатыңыз
Dialogue: 1,0:00:03.31,0:00:07.42,Dial-JP,,0,0,0,,Сіз қалжыңдап тұрсыз ба? Сіз оны сату туралы айтқан жоқсыз ба?
Dialogue: 1,0:00:07.42,0:00:10.17,Dial-JP,,0,0,0,,Мен оны сатқым келмейді, оны өзім орнатқым келеді.
Dialogue: 1,0:00:10.72,0:00:12.24,Dial-JP,,0,0,0,,Тоқта.
Dialogue: 1,0:00:12.24,0:00:15.06,Dial-JP,,0,0,0,,Бұл тіпті сәйкес келмейді, бірақ ол қарқынды
Dialogue: 1,0:00:15.06,0:00:16.90,Dial-JP,,0,0,0,,Сонымен қатар, ол нағыз әскери мақсатқа арналған.
Dialogue: 1,0:00:16.90,0:00:19.33,Dial-JP,,0,0,0,,Бұл баланың қолынан келетін нәрсе емес.
Dialogue: 1,0:00:19.70,0:00:22.80,Dial-JP,,0,0,0,,Төлегенше, бұл сіз білетін нәрсе емес.
Dialogue: 1,0:00:23.89,0:00:26.17,Dial-JP,,0,0,0,,Сізде ақша жоқ шығар.
Dialogue: 1,0:00:27.59,0:00:29.47,Dial-JP,,0,0,0,,Ха, түсіндім.
Dialogue: 1,0:00:30.33,0:00:31.58,Dial-JP,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 1,0:00:32.05,0:00:34.07,Dial-JP,,0,0,0,,Бұл мәміле деп аталады емес пе?
Dialogue: 1,0:00:34.87,0:00:37.20,Dial-JP,,0,0,0,,Мен оны орнатамын.
Dialogue: 1,0:00:37.66,0:00:40.56,Dial-JP,,0,0,0,,Оның орнына, тіпті оны шешкіңіз келсе де
Dialogue: 1,0:00:41.86,0:00:44.47,Dial-JP,,0,0,0,,Тіпті шаршаған кезде де
Dialogue: 1,0:00:44.76,0:00:46.76,Dial-JP,,0,0,0,,Мен оны тегін аламын
Dialogue: 1,0:00:47.04,0:00:48.88,Dial-JP,,0,0,0,,Жақсы әңгіме сияқты.
Dialogue: 1,0:02:35.01,0:02:38.55,Dial-JP,,0,0,0,,Лавабр мырза ЕО-ның кеден саясатын қалқан ретінде пайдаланады
Dialogue: 1,0:02:38.55,0:02:41.12,Dial-JP,,0,0,0,,Мен Арасака қысым көрсетпек болдым, бірақ...
Dialogue: 1,0:02:41.40,0:02:45.48,Dial-JP2,,0,0,0,,Құрметті Дэвид Мартинес, кешігіп қалатыныңызды хабарлаймын.
Dialogue: 1,0:02:44.77,0:02:46.66,Dial-JP,,0,0,0,,Эй, мен сабақтамын.
Dialogue: 1,0:02:46.85,0:02:48.26,Dial-JP,,0,0,0,,Саналылық
Dialogue: 1,0:02:50.98,0:02:52.65,Dial-JP,,0,0,0,,Бұл мектеп, солай ма?
Dialogue: 1,0:02:52.94,0:02:54.95,Dial-JP,,0,0,0,,Камера ақымақ.
Dialogue: 1,0:02:56.26,0:02:57.76,Dial-JP,,0,0,0,,Ол жазылады ма?
Dialogue: 1,0:02:58.19,0:02:59.96,Dial-JP,,0,0,0,,Оның маған қатысы жоқ.
Dialogue: 1,0:03:00.44,0:03:01.01,Dial-JP,,0,0,0,,Қараңыз
Dialogue: 1,0:03:33.26,0:03:34.81,Dial-JP,,0,0,0,,...
Dialogue: 1,0:03:35.38,0:03:37.79,Dial-JP,,0,0,0,,Ауырады, ауырады, ауырады
Dialogue: 1,0:03:38.10,0:03:39.67,Dial-JP,,0,0,0,,Не болды?
Dialogue: 1,0:03:39.67,0:03:41.46,Dial-JP,,0,0,0,,Сіз қандай ХРОМ салдыңыз?
Dialogue: 1,0:03:41.46,0:03:43.32,Dial-JP,,0,0,0,,Мұрныңыз сынған, солай ма?
Dialogue: 1,0:03:43.69,0:03:45.20,Dial-JP,,0,0,0,,Сіз аяқтадыңыз.
Dialogue: 1,0:03:45.46,0:03:47.45,Dial-JP,,0,0,0,,Қария Арасакада басшы болып жұмыс істейді.
Dialogue: 1,0:03:47.72,0:03:49.49,Dial-JP,,0,0,0,,Мен де академияның директорымын.
Dialogue: 1,0:03:49.49,0:03:52.02,Dial-JP,,0,0,0,,Сізді қуып шығу оңай болар еді.
Dialogue: 1,0:03:52.02,0:03:54.09,Dial-JP2,,0,0,0,,Сіз өз бетіңізше оқуды тастамасаңыз да, оқуды тастауға мәжбүр боласыз.
Dialogue: 1,0:03:53.67,0:03:55.51,Dial-JP,,0,0,0,,Білесің бе, бейбақ?
Dialogue: 1,0:04:20.65,0:04:22.02,Dial-JP,,0,0,0,,Саналылық
Dialogue: 1,0:04:25.66,0:04:27.58,Dial-JP,,0,0,0,,Қария Арасакада басшы болып жұмыс істейді.
Dialogue: 1,0:04:27.94,0:04:29.69,Dial-JP,,0,0,0,,Мен де академияның директорымын.
Dialogue: 1,0:04:29.69,0:04:32.36,Dial-JP,,0,0,0,,Сізді қуып шығу оңай болар еді.
Dialogue: 1,0:04:32.36,0:04:34.65,Dial-JP,,0,0,0,,Маркус, маған айт.
Dialogue: 1,0:04:34.65,0:04:39.19,Dial-JP,,0,0,0,,Неліктен маған баламды ұрып-соғып жатқан мазасыз бейнені көрсету керек?
Dialogue: 1,0:04:39.63,0:04:42.76,Dial-JP,,0,0,0,,Бұл студент Дэвид Мартинес, 17 жаста
Dialogue: 1,0:04:42.76,0:04:44.10,Dial-JP,,0,0,0,,Санто-Домингодан
Dialogue: 1,0:04:44.55,0:04:46.34,Dial-JP,,0,0,0,,Менің бағаларым өте жақсы, бірақ
Dialogue: 1,0:04:46.34,0:04:49.64,Dial-JP,,0,0,0,,Күні кеше заңсыз құрылғы академияның жүйесін бұзды.
Dialogue: 1,0:04:50.07,0:04:51.26,Dial-JP,,0,0,0,,Әкесі жоқ
Dialogue: 1,0:04:51.52,0:04:53.60,Dial-JP,,0,0,0,,Апам жазатайым оқиғадан қайтыс болды
Dialogue: 1,0:04:53.60,0:04:55.50,Dial-JP,,0,0,0,,Қазіргі уақытта менің үлкен көлемдегі қарызым бар.
Dialogue: 1,0:04:55.50,0:04:56.98,Dial-JP,,0,0,0,,Оның не қатысы бар
Dialogue: 1,0:04:57.25,0:04:59.01,Dial-JP,,0,0,0,,Оның ерекше қимылдары
Dialogue: 1,0:04:59.28,0:05:01.90,Dial-JP,,0,0,0,,Бұл ИМПЛАНТты бұрынғы лейтенант Джеймс Норрис жасаған.
Dialogue: 1,0:05:01.90,0:05:03.71,Dial-JP,,0,0,0,,Сөзсіз Сандевистан
Dialogue: 1,0:05:04.15,0:05:07.29,Dial-JP,,0,0,0,,Оны Киберпсихозға айналдыру және онымен күресу мәселесі.
Dialogue: 1,0:05:07.57,0:05:11.60,Dial-JP,,0,0,0,,Иә, ИМПЛАНТ тіпті ардагер сарбаздар да төтеп бере алмайтын нәрсе болды.
Dialogue: 1,0:05:11.60,0:05:13.37,Dial-JP,,0,0,0,,Ол ешқандай жанама әсер көрсетпейді.
Dialogue: 1,0:05:13.77,0:05:15.96,Dial-JP,,0,0,0,,Ерекше қарсылыққа ие болуы керек.
Dialogue: 1,0:05:16.24,0:05:19.90,Dial-JP,,0,0,0,,Өнімнің мысалын қолданып көріңіз. Сіз жақсы үміткер бола аласыз
Dialogue: 1,0:05:20.67,0:05:23.13,Dial-JP,,0,0,0,,Түсіндім, қазір ол
Dialogue: 1,0:05:23.45,0:05:24.85,Dial-JP,,0,0,0,,Бірден шығару
Dialogue: 1,0:05:24.85,0:05:28.57,Dial-JP,,0,0,0,,Оны қайтарыңыз. Сіз оның оқу ақысын қолдау үшін бәрін жасай аласыз.
Dialogue: 1,0:05:28.91,0:05:30.82,Dial-JP,,0,0,0,,Сіздің ұлыңызға қатысты зорлық-зомбылыққа қатысты
Dialogue: 1,0:05:31.23,0:05:34.60,Dial-JP,,0,0,0,,«Компанияның мүддесі барлығында басымдылыққа ие»
Dialogue: 1,0:05:34.99,0:05:37.55,Dial-JP,,0,0,0,,Мен сенің менен не істеуімді сұрап тұрғаныңды білемін
Dialogue: 1,0:05:42.04,0:05:43.31,Dial-JP,,0,0,0,,Мартинес мырза
Dialogue: 1,0:05:43.31,0:05:47.11,Dial-JP,,0,0,0,,Нормативтік актілерге негізделген ақшаны алу процедуралары автоматты түрде орындалды.
Dialogue: 1,0:05:47.92,0:05:49.18,Dial-JP,,0,0,0,,— Танаканың ата-анасы
Dialogue: 1,0:05:52.16,0:05:54.79,Dial-JP,,0,0,0,,Бітті.
Dialogue: 1,0:06:05.20,0:06:08.05,Dial-JP,,0,0,0,,Кір жуу аяқталды Кір...
Dialogue: 1,0:06:44.51,0:06:46.20,Dial-JP2,,0,0,0,,Эй, кел!
Dialogue: 1,0:06:49.23,0:06:51.96,Dial-JP2,,0,0,0,,Мен мұны істей алмаймын. Бұл аз айлық жалақы.
Dialogue: 1,0:07:35.24,0:07:35.93,Dial-JP,,0,0,0,,Бір сәт осында келіңіз.
Dialogue: 1,0:07:37.73,0:07:39.11,Dial-JP,,0,0,0,,Сіз нені айтасыз?
Dialogue: 1,0:07:39.11,0:07:40.15,Dial-JP,,0,0,0,,Не
Dialogue: 1,0:07:40.15,0:07:42.04,Dial-JP,,0,0,0,,Менің жұмысыма кедергі келтірдің.
Dialogue: 1,0:07:42.39,0:07:45.57,Dial-JP,,0,0,0,,Жоқ. Маған тыныш ұрлауға рұқсат беретін адам бар ма?
Dialogue: 1,0:07:46.00,0:07:48.24,Dial-JP,,0,0,0,,Сіз маған жалт қарадыңыз, солай ма?
Dialogue: 1,0:07:48.24,0:07:50.54,Dial-JP,,0,0,0,,Мен оның ұры болады деп ешқашан ойламадым.
Dialogue: 1,0:07:53.74,0:07:55.16,Dial-JP,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 1,0:07:55.16,0:07:57.35,Dial-JP,,0,0,0,,Жоқ, мүмкін бұл бірінші рет болуым мүмкін.
Dialogue: 1,0:08:01.41,0:08:03.12,Dial-JP,,0,0,0,,Мен мұны кидім
Dialogue: 1,0:08:04.67,0:08:06.50,Dial-JP,,0,0,0,,Гаки — Сандевистан
Dialogue: 1,0:08:06.80,0:08:08.73,Dial-JP,,0,0,0,,Бұл да дайын өнім емес.
Dialogue: 1,0:08:09.10,0:08:12.74,Dial-JP,,0,0,0,,Мен бұзбаймын. Бұл Түнгі қала.
Dialogue: 1,0:08:12.74,0:08:15.29,Dial-JP,,0,0,0,,Керісінше менің жұмысыма көмектеспе.
Dialogue: 1,0:08:15.79,0:08:17.06,Dial-JP,,0,0,0,,Ұры
Dialogue: 1,0:08:17.06,0:08:19.72,Dial-JP,,0,0,0,,Мен тек Арасаканы нысанаға алып отырмын.
Dialogue: 1,0:08:20.02,0:08:22.49,Dial-JP,,0,0,0,,Сонымен мен Корпоға ұқсадым ба?
Dialogue: 1,0:08:22.87,0:08:26.32,Dial-JP,,0,0,0,,Оны сканерлеген кезде сіз Arasaka Academy ID тіркеуін көресіз.
Dialogue: 1,0:08:26.32,0:08:30.05,Dial-JP,,0,0,0,,Егер сіз менен сұрасаңыз, мен Корпорацияның баласына ұқсамаймын деп ойлаймын.
Dialogue: 1,0:08:30.38,0:08:32.60,Dial-JP,,0,0,0,,Мен жұмыстан шығып кеттім.
Dialogue: 1,0:08:34.52,0:08:35.61,Dial-JP,,0,0,0,,Ол проблемалық бала.
Dialogue: 1,0:08:36.43,0:08:38.51,Dial-JP,,0,0,0,,Жалғыз мақсат - Corp.
Dialogue: 1,0:08:39.74,0:08:40.71,Dial-JP,,0,0,0,,Мен бортқа шықтым.
Dialogue: 1,0:08:41.45,0:08:44.08,Dial-JP,,0,0,0,,Ақылмен өсірген ата-анаңа алғыс айт.
Dialogue: 1,0:08:45.86,0:08:47.85,Dial-JP,,0,0,0,,Сіз олқылықтарға толысыз.
Dialogue: 1,0:08:48.37,0:08:50.07,Dial-JP,,0,0,0,,Дәріс оқуға тұрарлық.
Dialogue: 1,0:08:50.48,0:08:52.46,Dial-JP,,0,0,0,,Сонымен менің үлесім
Dialogue: 1,0:08:52.91,0:08:55.07,Dial-JP,,0,0,0,,Менің жасым 8-де, сен 2-десің
Dialogue: 1,0:08:56.08,0:08:57.21,Dial-JP,,0,0,0,,(Изуку) Ах. (Каибуки) Керо.
Dialogue: 1,0:08:57.21,0:08:59.43,Dial-JP,,0,0,0,,Сіз менің Sandestistan-ға сене аласыз.
Dialogue: 1,0:08:59.91,0:09:02.10,Dial-JP,,0,0,0,,Бұл жерде біз ұрланған чиптерді өңдейміз.
Dialogue: 1,0:09:02.56,0:09:04.58,Dial-JP,,0,0,0,,Мұнда сіздің оқу ақысы бар.
Dialogue: 1,0:09:05.08,0:09:06.39,Dial-JP,,0,0,0,,Оқу ақысы.
Dialogue: 1,0:09:06.66,0:09:10.27,Dial-JP,,0,0,0,,Негізі маған да ақша керек. Кем дегенде 6:4 болмайды.
Dialogue: 1,0:09:11.19,0:09:12.00,Dial-JP,,0,0,0,,7:3
Dialogue: 1,0:09:12.49,0:09:15.40,Dial-JP,,0,0,0,,Жұмыс біткен соң кесілген ақшаны орнында төлеу туралы не айтасыз?
Dialogue: 1,0:09:17.32,0:09:18.54,Dial-JP,,0,0,0,,Түсіндім
Dialogue: 1,0:09:18.54,0:09:19.15,Dial-JP,,0,0,0,,Б-бұл не өзі?
Dialogue: 1,0:09:20.51,0:09:21.35,Dial-JP,,0,0,0,,Люси
Dialogue: 1,0:09:22.94,0:09:24.05,Dial-JP,,0,0,0,,Бұл Дэвид.
Dialogue: 1,0:09:27.11,0:09:28.74,Dial-JP,,0,0,0,,Қосылған Мен ести аламын
Dialogue: 1,0:09:29.00,0:09:29.82,Dial-JP,,0,0,0,,Мен сізді естимін
Dialogue: 1,0:09:30.26,0:09:31.61,Dial-JP,,0,0,0,,Мен де сені естимін.
Dialogue: 1,0:09:32.21,0:09:33.00,Dial-JP,,0,0,0,,Мақсат
Dialogue: 1,0:09:33.52,0:09:34.61,Dial-JP,,0,0,0,,Сағат 3 бағыты
Dialogue: 1,0:09:35.43,0:09:36.18,Dial-JP,,0,0,0,,Түсінікті
Dialogue: 1,0:09:36.83,0:09:37.99,Dial-JP,,0,0,0,,Мен басып кіремін
Dialogue: 1,0:09:39.47,0:09:42.12,Dial-JP,,0,0,0,,Жарайды, дайындал.
Dialogue: 1,0:09:42.66,0:09:45.84,Dial-JP,,0,0,0,,3 2 1 Кеттік
Dialogue: 1,0:09:53.81,0:09:54.90,Dial-JP,,0,0,0,,Сәттілік
Dialogue: 1,0:09:55.49,0:09:58.22,Dial-JP,,0,0,0,,Бұл бастаушы курс. Нақты нәрсе келесіден басталады.
Dialogue: 1,0:09:58.78,0:09:59.43,Dial-JP,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 1,0:10:00.01,0:10:02.29,Dial-JP,,0,0,0,,Әңгімелесіп отырған кеңсе әйелі күзетілмейді.
Dialogue: 1,0:10:03.58,0:10:05.48,Dial-JP,,0,0,0,,БД кезінде дәмді үйрек
Dialogue: 1,0:10:06.20,0:10:09.55,Dial-JP,,0,0,0,,Тым оңай. Оқулықпен жеткілікті.
Dialogue: 1,0:10:10.23,0:10:13.14,Dial-JP,,0,0,0,,Жарайды, енді құбыжықтарды аулау уақыты келді.
Dialogue: 1,0:10:13.42,0:10:14.91,Dial-JP,,0,0,0,,Иә
Dialogue: 1,0:10:15.86,0:10:18.22,Dial-JP,,0,0,0,,Бұл корпорация емес.
Dialogue: 1,0:10:18.22,0:10:22.12,Dial-JP,,0,0,0,,Арасака оққағары 3 2 1
Dialogue: 1,0:10:22.12,0:10:23.65,Dial-JP,,0,0,0,,Чочочо уф
Dialogue: 1,0:10:29.94,0:10:31.06,Dial-JP,,0,0,0,,Мұны жасамаңыз
Dialogue: 1,0:10:31.06,0:10:32.28,Dial-JP,,0,0,0,,Құбыжық таза
Dialogue: 1,0:10:32.79,0:10:33.71,Dial-JP,,0,0,0,,Мен келесі аялдамада түсемін.
Dialogue: 1,0:10:34.54,0:10:35.29,Dial-JP,,0,0,0,,Түсінікті
Dialogue: 1,0:10:36.82,0:10:38.59,Dial-JP,,0,0,0,,Қалай жақсы орындадың?
Dialogue: 1,0:10:39.08,0:10:41.88,Dial-JP,,0,0,0,,Мен жұмыстың 20% орындадым деп ойлаймын.
Dialogue: 1,0:10:41.88,0:10:42.92,Dial-JP,,0,0,0,,30%.
Dialogue: 1,0:10:43.44,0:10:44.38,Dial-JP,,0,0,0,,Жай әзіл.
Dialogue: 1,0:10:45.76,0:10:47.13,Dial-JP,,0,0,0,,Ауыстырыңыз және әрекетті қайталаңыз
Dialogue: 1,0:10:47.59,0:10:48.76,Dial-JP,,0,0,0,,Мен де маршрутты өзгертемін.
Dialogue: 1,0:10:49.31,0:10:51.43,Dial-JP,,0,0,0,,Кейбіреулеріңіз байқағаныңызға сенімдімін.
Dialogue: 1,0:10:51.72,0:10:53.44,Dial-JP,,0,0,0,,О, тәуекел ең аз.
Dialogue: 1,0:10:56.65,0:10:57.53,Dial-JP,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 1,0:10:57.90,0:10:59.52,Dial-JP,,0,0,0,,Жаңадан бастағандар жиі не істейді
Dialogue: 1,0:10:59.52,0:11:03.07,Dial-JP,,0,0,0,,Жүктемесі жоғары ИМПЛАНТты үйренбей қолдандыңыз.
Dialogue: 1,0:11:03.38,0:11:04.88,Dial-JP,,0,0,0,,Ингибитор дегеніміз не?
Dialogue: 1,0:11:05.91,0:11:07.05,Dial-JP,,0,0,0,,Ол сақтандыру болып табылады
Dialogue: 1,0:11:07.59,0:11:10.75,Dial-JP,,0,0,0,,​​Мен білмеймін. Ол сонда емес сияқты.
Dialogue: 1,0:11:11.21,0:11:12.81,Dial-JP,,0,0,0,,Сіздің қоңырау шалатын отбасы мүшелеріңіз бар ма?
Dialogue: 1,0:11:13.12,0:11:14.49,Dial-JP,,0,0,0,,Төтенше жағдайда байланыс ақпараты т.б.
Dialogue: 1,0:11:14.74,0:11:16.29,Dial-JP,,0,0,0,,Сондықтан мен білмеймін
Dialogue: 1,0:11:16.29,0:11:19.96,Dial-JP,,0,0,0,,Ол ата-анасы ғана емес, академияның студенті болды.
Dialogue: 1,0:11:19.96,0:11:22.65,Dial-JP,,0,0,0,,Міне, сондықтан да солай
Dialogue: 1,0:11:23.26,0:11:24.73,Dial-JP,,0,0,0,,<Мен оны «Спайс» деп атаймын➡
Dialogue: 1,0:11:26.24,0:11:26.75,Dial-JP,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 1,0:11:27.38,0:11:28.97,Dial-JP,,0,0,0,,Қазіргі жағдай туралы сіздің ойыңыз қандай?
Dialogue: 1,0:11:29.61,0:11:31.14,Dial-JP,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 1,0:11:31.50,0:11:33.22,Dial-JP,,0,0,0,,Сіз қандай басқышты қолданасыз?
Dialogue: 1,0:11:33.95,0:11:34.94,Dial-JP,,0,0,0,,Бұл не?
Dialogue: 1,0:11:37.32,0:11:38.81,Dial-JP,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 1,0:11:38.81,0:11:39.83,Dial-JP,,0,0,0,,Бұл ақылсыз
Dialogue: 1,0:11:44.35,0:11:45.97,Dial-JP,,0,0,0,,Жаңа өтіп бара жатырмын
Dialogue: 1,0:11:47.52,0:11:51.47,Dial-JP,,0,0,0,,Бұл бала киетін ИМПЛАНТ өте қымбат.
Dialogue: 1,0:11:51.47,0:11:53.26,Dial-JP,,0,0,0,,Үндемей, үндемесең
Dialogue: 1,0:11:53.26,0:11:56.38,Dial-JP,,0,0,0,,Неліктен оны Scavenger-ге сату керек?
Dialogue: 1,0:11:56.38,0:11:59.22,Dial-JP,,0,0,0,,Ұнамаса имплантыңызды да аламын.
Dialogue: 1,0:11:59.22,0:12:03.78,Dial-JP,,0,0,0,,Дэвид, менің жасым 8-де, ал сен 2-десің.
Dialogue: 1,0:12:18.36,0:12:19.74,Dial-JP,,0,0,0,,онда Цуки-кунге қатысты күдік мүлде сейіледі.
Dialogue: 1,0:12:38.30,0:12:38.92,Dial-JP,,0,0,0,,Бұл
Dialogue: 1,0:12:39.53,0:12:42.03,Dial-JP,,0,0,0,,Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 1,0:12:42.75,0:12:43.67,Dial-JP,,0,0,0,,Риппер
Dialogue: 1,0:12:45.00,0:12:47.64,Dial-JP,,0,0,0,,Мені Рипперге апарыңыз
Dialogue: 1,0:12:57.69,0:12:59.50,Dial-JP,,0,0,0,,Сәлем Дэвид.
Dialogue: 1,0:12:59.50,0:13:01.65,Dial-JP,,0,0,0,,Бұл қорқынышты, сен жақсысың ба?
Dialogue: 1,0:13:02.29,0:13:03.03,Dial-JP,,0,0,0,,Жоқ
Dialogue: 1,0:13:04.63,0:13:05.65,Dial-JP,,0,0,0,,Сіз оны неше рет қолдандыңыз?
Dialogue: 1,0:13:06.03,0:13:08.24,Dial-JP,,0,0,0,,6 Шамамен 8 рет
Dialogue: 1,0:13:08.46,0:13:10.42,Dial-JP,,0,0,0,,Эй, ақымақ?
Dialogue: 1,0:13:10.42,0:13:13.12,Dial-JP,,0,0,0,,Бұл тіпті ересектердің де есінен тануы.
Dialogue: 1,0:13:13.12,0:13:15.09,Dial-JP,,0,0,0,,Ештеңе болған жоқ.
Dialogue: 1,0:13:15.57,0:13:17.51,Dial-JP,,0,0,0,,Мұрыннан кенет қан кету
Dialogue: 1,0:13:17.95,0:13:20.81,Dial-JP,,0,0,0,,Менің ойымша, бұл жігіт ингибиторлар туралы білмеді.
Dialogue: 1,0:13:21.10,0:13:24.01,Dial-JP,,0,0,0,,Аға, бұл қажет емес деп ойлаймын.
Dialogue: 1,0:13:24.43,0:13:26.11,Dial-JP,,0,0,0,,Не деген сұмдық.
Dialogue: 1,0:13:26.65,0:13:27.96,Dial-JP,,0,0,0,,Маған тез дәрі беріңізші
Dialogue: 1,0:13:28.45,0:13:30.35,Dial-JP,,0,0,0,,Қарапайымдары жұмыс істемейді.
Dialogue: 1,0:13:30.35,0:13:32.60,Dial-JP,,0,0,0,,Бұл сәл қымбат. Сізде қанша ақша бар?
Dialogue: 1,0:13:33.05,0:13:34.71,Dial-JP,,0,0,0,,Сіз ақша алып жатырсыз ба?
Dialogue: 1,0:13:34.71,0:13:38.24,Dial-JP,,0,0,0,,Әрине, қызмет операция ақысын қамтиды.
Dialogue: 1,0:13:39.69,0:13:40.39,Dial-JP,,0,0,0,,Тек ішіне зәр шығарып алмаса екен.
Dialogue: 1,0:13:42.74,0:13:44.00,Dial-JP,,0,0,0,,Бұл 2 күн.
Dialogue: 1,0:13:45.21,0:13:46.21,Dial-JP,,0,0,0,,Барлығы осы
Dialogue: 1,0:13:46.55,0:13:48.56,Dial-JP,,0,0,0,,Егер сізге ұнамаса, қаладағы дәрігерге барыңыз.
Dialogue: 1,0:13:48.56,0:13:52.46,Dial-JP,,0,0,0,,Мен енді Скавенгерге сатылмаймын.
Dialogue: 1,0:13:53.10,0:13:54.84,Dial-JP,,0,0,0,,Сен арсыз жыртқыш
Dialogue: 1,0:13:58.38,0:14:00.80,Dial-JP,,0,0,0,,Оны әлі жою ниетіңіз жоқ сияқты.
Dialogue: 1,0:14:01.21,0:14:01.91,Dial-JP,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 1,0:14:02.91,0:14:07.80,Dial-JP,,0,0,0,,Сіз бұл затты күніне 8 рет қосқаныңызға сенбеймін, бәрі жақсы.
Dialogue: 1,0:14:07.80,0:14:09.65,Dial-JP,,0,0,0,,Сіз жай ғана сезімсізсіз бе?
Dialogue: 1,0:14:10.25,0:14:12.00,Dial-JP,,0,0,0,,Бірақ оны асыра пайдаланбаңыз.
Dialogue: 1,0:14:12.00,0:14:15.67,Dial-JP,,0,0,0,,Күніне көп дегенде екі рет, күніне үш ретке дейін.
Dialogue: 1,0:14:15.67,0:14:18.89,Dial-JP,,0,0,0,,Денем қабылдаса да, басым басқа.
Dialogue: 1,0:14:18.89,0:14:23.03,Dial-JP,,0,0,0,,Бұл жігіт міндетті түрде сіздің рухыңызды бұзады.
Dialogue: 1,0:14:24.35,0:14:27.62,Dial-JP,,0,0,0,,Киберпсихозға айналу нені білдіреді?
Dialogue: 1,0:14:27.62,0:14:31.23,Dial-JP,,0,0,0,,ИМПЛАНТ Мен оны ешқашан естіген емеспін.
Dialogue: 1,0:14:31.23,0:14:34.87,Dial-JP,,0,0,0,,Бұл қаншалықты қауіпті.
Dialogue: 1,0:14:52.80,0:14:53.73,Dial-JP,,0,0,0,,Жетеді
Dialogue: 1,0:14:54.16,0:14:54.71,Dial-JP,,0,0,0,,О
Dialogue: 1,0:14:55.47,0:14:57.40,Dial-JP,,0,0,0,,Бүгін жұмыс жоқ.
Dialogue: 1,0:14:57.99,0:14:59.40,Dial-JP,,0,0,0,,Мен мұны істей аламын.
Dialogue: 1,0:14:59.77,0:15:00.72,Dial-JP,,0,0,0,,Мүмкін емес
Dialogue: 1,0:15:00.97,0:15:03.74,Dial-JP,,0,0,0,,Мен Киберпсихоға қамқорлық жасағым келмейді.
Dialogue: 1,0:15:04.55,0:15:07.63,Dial-JP,,0,0,0,,Sandevistan-ды тек төтенше жағдайда пайдалану керек.
Dialogue: 1,0:15:07.94,0:15:09.49,Dial-JP,,0,0,0,,Оны орындаудың басқа да жолдары бар.
Dialogue: 1,0:15:10.77,0:15:12.68,Dial-JP,,0,0,0,,Сіз әлі де менімен бірлесуге дайынсыз ба?
Dialogue: 1,0:15:13.11,0:15:15.61,Dial-JP,,0,0,0,,Бүгінге ақшамды қайтаруым керек.
Dialogue: 1,0:15:18.82,0:15:21.09,Dial-JP,,0,0,0,,Мен де мұны істегім келеді, маған ақша керек
Dialogue: 1,0:15:21.75,0:15:22.49,Dial-JP,,0,0,0,,Б-бұл не өзі?
Dialogue: 1,0:15:24.46,0:15:26.44,Dial-JP,,0,0,0,,Мен енді ақша таппаймын ғой.
Dialogue: 1,0:15:26.77,0:15:28.76,Dial-JP,,0,0,0,,Мен үй иесі мені үйден қуып жіберетін сияқтымын.
Dialogue: 1,0:15:29.26,0:15:31.72,Dial-JP,,0,0,0,,Бүгін жоқ, берілме
Dialogue: 1,0:15:32.39,0:15:33.66,Dial-JP,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 1,0:15:37.54,0:15:37.97,Dial-JP,,0,0,0,,Келіңіз
Dialogue: 1,0:15:38.45,0:15:40.29,Dial-JP,,0,0,0,,О, солай!
Dialogue: 1,0:15:40.72,0:15:42.24,Dial-JP,,0,0,0,,Бұл жұмыс емес.
Dialogue: 1,0:15:45.47,0:15:46.05,Dial-JP,,0,0,0,,Осы мектепті бітіру – шеберліктің дәлелі.
Dialogue: 1,0:15:46.58,0:15:47.76,Dial-JP,,0,0,0,,Жақсы
Dialogue: 1,0:15:48.55,0:15:49.42,Dial-JP,,0,0,0,,Жалғыз
Dialogue: 1,0:15:49.42,0:15:50.12,Dial-JP,,0,0,0,,Иә, бірақ
Dialogue: 1,0:15:53.52,0:15:55.20,Dial-JP,,0,0,0,,Сіз қобалжыған шығарсыз.
Dialogue: 1,0:15:55.20,0:15:55.73,Dial-JP,,0,0,0,,Жоқ
Dialogue: 1,0:15:56.60,0:15:57.54,Dial-JP,,0,0,0,,Алғаш рет
Dialogue: 1,0:15:57.85,0:15:58.49,Dial-JP,,0,0,0,,Жоқ
Dialogue: 1,0:16:00.21,0:16:01.31,Dial-JP,,0,0,0,,Мен мұны істеген жоқпын.
Dialogue: 1,0:16:02.29,0:16:05.71,Dial-JP,,0,0,0,,Отыр, менде сыра ғана, сондықтан сыра.
Dialogue: 1,0:16:06.92,0:16:07.34,Dial-JP,,0,0,0,,Иә
Dialogue: 1,0:16:07.90,0:16:08.64,Dial-JP,,0,0,0,,Сәлеметсіз бе
Dialogue: 1,0:16:16.18,0:16:17.25,Dial-JP,,0,0,0,,Біраз
Dialogue: 1,0:16:17.62,0:16:20.39,Dial-JP,,0,0,0,,Не, мен бірінші рет ішіп отырмын ба?
Dialogue: 1,0:16:20.98,0:16:22.77,Dial-JP,,0,0,0,,Алкоголь жақсы.
Dialogue: 1,0:16:23.83,0:16:26.15,Dial-JP,,0,0,0,,Көмір қышқылы мен темекіні ұнатпаймын.
Dialogue: 1,0:16:26.90,0:16:28.68,Dial-JP,,0,0,0,,Ондай адам бар ма?
Dialogue: 1,0:16:29.11,0:16:30.24,Dial-JP,,0,0,0,,Бұл рас
Dialogue: 1,0:16:30.49,0:16:32.99,Dial-JP,,0,0,0,,Жалқау, сенің киімің де ақсақ.
Dialogue: 1,0:16:36.86,0:16:37.67,Dial-JP,,0,0,0,,Киіміңді шеш
Dialogue: 1,0:16:38.48,0:16:39.29,Dial-JP,,0,0,0,,Неліктен?
Dialogue: 1,0:16:39.29,0:16:40.61,Dial-JP,,0,0,0,,Оны маған қарызға бер.
Dialogue: 1,0:16:46.23,0:16:47.59,Dial-JP,,0,0,0,,Өз бетіңізше сурет салмаңыз
Dialogue: 1,0:16:50.01,0:16:51.33,Dial-JP,,0,0,0,,Эдгеруннер
Dialogue: 1,0:16:51.86,0:16:53.81,Dial-JP,,0,0,0,,Киберпанктың басқа атауы
Dialogue: 1,0:16:54.32,0:16:55.84,Dial-JP,,0,0,0,,Сіз жақсы боласыз, солай ма?
Dialogue: 1,0:16:57.27,0:17:00.05,Dial-JP,,0,0,0,,Мен Дж.К.-ның Эдгеруннерлерін көп көрдім.
Dialogue: 1,0:17:01.27,0:17:02.16,Dial-JP,,0,0,0,,Осылайша
Dialogue: 1,0:17:03.68,0:17:04.72,Dial-JP,,0,0,0,,Осымен
Dialogue: 1,0:17:05.08,0:17:07.34,Dial-JP,,0,0,0,,Мына ақсақ плакатты бөлмеңе іліп қой.
Dialogue: 1,0:17:09.31,0:17:10.14,Dial-JP,,0,0,0,,Нашар
Dialogue: 1,0:17:10.14,0:17:13.93,Dial-JP,,0,0,0,,Е, жоқ, бұл жаман емес.
Dialogue: 1,0:17:14.68,0:17:18.46,Dial-JP,,0,0,0,,Жарнамалар оны жер бетіндегі жұмақ деп жиі жарнамалайды.
Dialogue: 1,0:17:19.13,0:17:22.29,Dial-JP,,0,0,0,,Айдың дамуынан қанша адам өлгенін білесіз бе?
Dialogue: 1,0:17:22.88,0:17:24.74,Dial-JP,,0,0,0,,Бұл жұмақтан гөрі тозаққа ұқсайды.
Dialogue: 1,0:17:26.19,0:17:27.32,Dial-JP,,0,0,0,,Егжей-тегжейлі?
Dialogue: 1,0:17:29.06,0:17:30.23,Dial-JP,,0,0,0,,Академия
Dialogue: 1,0:17:30.23,0:17:33.21,Dial-JP,,0,0,0,,Жарнамада айтылмайтын нәрселерді де білуге ​​болады.
Dialogue: 1,0:17:33.21,0:17:35.84,Dial-JP,,0,0,0,,Арасака академиясының монахынан күткендей
Dialogue: 1,0:17:36.71,0:17:38.03,Dial-JP,,0,0,0,,Бұл емес.
Dialogue: 1,0:17:38.61,0:17:41.10,Dial-JP,,0,0,0,,Монах болу үшін мектепке бару жеткілікті.
Dialogue: 1,0:17:41.43,0:17:42.38,Dial-JP,,0,0,0,,Жоқ
Dialogue: 1,0:17:46.55,0:17:49.56,Dial-JP,,0,0,0,,Әкем екеумізде ақша жоқ.
Dialogue: 1,0:17:49.56,0:17:52.36,Dial-JP,,0,0,0,,Академия мен бара алатын үй емес еді.
Dialogue: 1,0:17:53.13,0:17:54.27,Dial-JP,,0,0,0,,Бірақ анам
Dialogue: 1,0:17:54.27,0:17:57.53,Dial-JP,,0,0,0,,Сіз шынымен мені академияға баруға мәжбүрледіңіз.
Dialogue: 1,0:17:58.35,0:18:00.45,Dial-JP,,0,0,0,,Бірақ мен барған бойда білдім.
Dialogue: 1,0:18:00.45,0:18:02.90,Dial-JP,,0,0,0,,Менің бұл жігіттермен араласуым мүмкін емес.
Dialogue: 1,0:18:03.48,0:18:06.30,Dial-JP,,0,0,0,,Мұны білгеннен кейін неге бірден тастамадың?
Dialogue: 1,0:18:06.60,0:18:07.67,Dial-JP,,0,0,0,,Бұл мүмкін емес, солай ма?
Dialogue: 1,0:18:08.02,0:18:11.58,Dial-JP,,0,0,0,,Академияға барып, Арасакада жұмысқа тұрыңыз
Dialogue: 1,0:18:11.58,0:18:13.45,Dial-JP,,0,0,0,,Биіктікте жұмыс істеу
Dialogue: 1,0:18:13.93,0:18:16.55,Dial-JP,,0,0,0,,Сенің анаң осыны қалайды ма?
Dialogue: 1,0:18:17.18,0:18:19.59,Dial-JP,,0,0,0,,Бұл арман болды...
Dialogue: 1,0:18:21.50,0:18:23.25,Dial-JP,,0,0,0,,Бұл басқа біреудің арманы
Dialogue: 1,0:18:24.02,0:18:24.74,Dial-JP,,0,0,0,,Басқалар
Dialogue: 1,0:18:25.23,0:18:27.83,Dial-JP,,0,0,0,,Ата-аналар мен балалар әртүрлі адамдар, солай емес пе?
Dialogue: 1,0:18:28.90,0:18:31.11,Dial-JP,,0,0,0,,Сіз біреудің арманы үшін өмір сүріп жатырсыз ба?
Dialogue: 1,0:18:32.14,0:18:34.70,Dial-JP,,0,0,0,,Бұл жаман нәрсе ме?
Dialogue: 1,0:18:35.07,0:18:37.15,Dial-JP,,0,0,0,,Армандар басқаларға тиесілі емес.
Dialogue: 1,0:18:37.77,0:18:40.43,Dial-JP,,0,0,0,,Арманым бар дейсің.
Dialogue: 1,0:18:42.51,0:18:43.31,Dial-JP,,0,0,0,,Шынайы ма?
Dialogue: 1,0:18:43.80,0:18:45.90,Dial-JP,,0,0,0,,Сіз тозақ дейсіз.
Dialogue: 1,0:18:46.53,0:18:48.55,Dial-JP,,0,0,0,,Бұл мен үшін тозақ
Dialogue: 1,0:18:49.56,0:18:50.30,Dial-JP,,0,0,0,,Мұнда
Dialogue: 1,0:18:51.31,0:18:53.58,Dial-JP,,0,0,0,,Мен алыс жерге барғым келеді
Dialogue: 1,0:18:56.98,0:18:58.19,Dial-JP,,0,0,0,,Мен саған жақсы нәрсе көрсетемін
Dialogue: 1,0:19:13.90,0:19:16.93,Dial-JP,,0,0,0,,Уау, керемет ажыратымдылық
Dialogue: 1,0:19:16.93,0:19:18.43,Dial-JP,,0,0,0,,Күн ыстық
Dialogue: 1,0:19:18.79,0:19:22.39,Dial-JP,,0,0,0,,Мен сіздің жеке сілтемеңіз арқылы күннің жылуын сезіндірудемін.
Dialogue: 1,0:19:22.94,0:19:25.68,Dial-JP,,0,0,0,,Егер ол шынайы жағдайда болса, ол тым ыстық және қауіпті.
Dialogue: 1,0:19:25.98,0:19:29.03,Dial-JP,,0,0,0,,Адамдар оны сезінуі үшін мен жеткілікті түрде үнемдедім және бәрі жақсы.
Dialogue: 1,0:19:30.36,0:19:31.13,Dial-JP,,0,0,0,,Өшіру
Dialogue: 1,0:19:31.41,0:19:33.31,Dial-JP,,0,0,0,,Бұл жақсы, себебі бұл қызықты
Dialogue: 1,0:19:34.64,0:19:35.81,Dial-JP,,0,0,0,,Бұл қандай көрініс?
Dialogue: 1,0:19:42.40,0:19:43.15,Dial-JP,,0,0,0,,Мырза, кенет қозғалмаңыз.
Dialogue: 1,0:19:43.59,0:19:44.90,Dial-JP,,0,0,0,,Бұл ең жақсысы
Dialogue: 1,0:19:45.32,0:19:45.81,Dial-JP,,0,0,0,,Дұрыс па?
Dialogue: 1,0:19:48.66,0:19:49.56,Dial-JP,,0,0,0,,Мұнда кел
Dialogue: 1,0:21:17.72,0:21:20.02,Dial-JP,,0,0,0,,Мен мұны біреумен бірінші рет жасап тұрмын.
Dialogue: 1,0:21:20.47,0:21:21.99,Dial-JP,,0,0,0,,Жарайды, мені мақтасаң да, мен саған ештеңе бермеймін.
Dialogue: 1,0:21:23.72,0:21:27.28,Dial-JP,,0,0,0,,Ал, маған неге көрсеттің?
Dialogue: 1,0:21:28.16,0:21:29.10,Dial-JP,,0,0,0,,Неліктен?
Dialogue: 1,0:21:29.81,0:21:32.20,Dial-JP,,0,0,0,,Оны сізге көрсете аламын ба?
Dialogue: 1,0:21:34.88,0:21:35.92,Dial-JP,,0,0,0,,Біз
Dialogue: 1,0:21:36.80,0:21:38.58,Dial-JP,,0,0,0,,Олар жақсы жұп болады деп ойламаймын.
Dialogue: 1,0:21:40.31,0:21:41.31,Dial-JP,,0,0,0,,Бұл дұрыс.
Dialogue: 1,0:21:52.10,0:21:54.80,Dial-JP,,0,0,0,,Сен шектен шығып кеттің, балам.
Dialogue: 1,0:21:59.43,0:22:03.10,Dial-JP,,0,0,0,,Бала, кешіріңіз, бұл мен.
Dialogue: 1,0:22:03.77,0:22:05.61,Dial-JP,,0,0,0,,Мен оны қайтарып аламын.
Dialogue: 0,0:02:41.40,0:02:45.48,Dial-CH2,,0,0,0,,Сенің келгеніңе көп уақыт болды.
Dialogue: 0,0:03:52.02,0:03:54.09,Dial-CH2,,0,0,0,,Мектептен кетуді ұмытпаңыз.
Dialogue: 0,0:06:44.51,0:06:46.20,Dial-CH2,,0,0,0,,...
Dialogue: 0,0:06:49.23,0:06:51.96,Dial-CH2,,0,0,0,,Қабылданбаған.
Dialogue: 1,0:01:17.53,0:01:20.65,OP-EN_EP02,,0,0,0,,Менің жолымды өртеп жіберу
Dialogue: 1,0:01:23.91,0:01:26.60,OP-EN_EP02,,0,0,0,,Сондай тәтті қирату
Dialogue: 1,0:01:30.65,0:01:33.36,OP-EN_EP02,,0,0,0,,Менің ішімде от бар
Dialogue: 1,0:01:33.67,0:01:41.41,OP-EN_EP02,,0,0,0,,Жанып тұрған от
Dialogue: 1,0:02:07.80,0:02:10.18,OP-EN_EP02,,0,0,0,,Бұл өрт бақылаудан шықты
Dialogue: 1,0:02:10.42,0:02:11.10,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 1,0:02:11.10,0:02:12.11,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 1,0:02:12.11,0:02:13.10,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 1,0:02:13.10,0:02:14.43,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 1,0:02:23.61,0:02:24.44,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 1,0:02:24.44,0:02:25.54,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 1,0:02:25.54,0:02:26.40,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 1,0:02:26.40,0:02:27.45,OP-EN_EP02,,0,0,0,,Мен оны өртеп жіберемін
Dialogue: 0,0:01:17.53,0:01:20.65,OP-CH_EP02,,0,0,0,,Қатты көрініс
Dialogue: 0,0:01:23.91,0:01:26.60,OP-CH_EP02,,0,0,0,,Тәтті жер шірік
Dialogue: 0,0:01:30.65,0:01:33.36,OP-CH_EP02,,0,0,0,,Гаму Кирецуэн
Dialogue: 0,0:02:07.80,0:02:10.18,OP-CH_EP02,,0,0,0,,Жалынды сөндіруден босату жүйесі
Dialogue: 1,0:12:18.21,0:12:23.26,IN-EN,,0,0,0,,Көп армандар, жұма күнгі жекпе-жекте үлкен армандарда
Dialogue: 1,0:12:23.71,0:12:26.37,IN-EN,,0,0,0,,Отырыңыз және тізе бүгіңіз, бұл жұма түні ғана
Dialogue: 1,0:12:26.37,0:12:30.34,IN-EN,,0,0,0,,Қасқырлар отырса, сіз үшін достық жолын іздейді, махаббатқа міндетті емес
Dialogue: 1,0:12:30.34,0:12:33.31,IN-EN,,0,0,0,,Қала тар джинсыға жататын кезде
Dialogue: 1,0:19:37.11,0:19:41.36,IN-EN,,0,0,0,,Мен сіздің шкафтарды тазалауға келгеніңізді күте алмадым
Dialogue: 1,0:19:44.74,0:19:48.16,IN-EN,,0,0,0,,Бірақ енді сіз тек белгімен кетесіз
Dialogue: 1,0:19:52.52,0:19:59.13,IN-EN,,0,0,0,,Тағы бір кеште мен сіздің жолдарыңыздың арасында оқитын боламын
Dialogue: 1,0:20:00.17,0:20:02.69,IN-EN,,0,0,0,,Себебі мен сені үнемі сағынамын
Dialogue: 1,0:20:05.95,0:20:08.18,IN-EN,,0,0,0,,Олай болса, кет
Dialogue: 1,0:20:08.33,0:20:12.70,IN-EN,,0,0,0,,Өзіңіз білгіңіз келмейтін нәрсені сезінудің тағы бір жолы
Dialogue: 1,0:20:12.70,0:20:14.42,IN-EN,,0,0,0,,Ал өзіңізді жіберіңіз
Dialogue: 1,0:20:15.51,0:20:18.73,IN-EN,,0,0,0,,Сіз өзіңізді бақылауды жоғалтпағаныңызды білесіз
Dialogue: 1,0:20:19.61,0:20:22.19,IN-EN,,0,0,0,,Кемпірқосақтан бастайық
Dialogue: 1,0:20:22.42,0:20:23.40,IN-EN,,0,0,0,,Бұрылыңыз
Dialogue: 1,0:20:23.61,0:20:28.20,IN-EN,,0,0,0,,Өзіңіз қаламаған жерде болудың тағы бір жолы
Dialogue: 1,0:20:28.20,0:20:29.98,IN-EN,,0,0,0,,Өзіңізді жіберіңіз
Dialogue: 1,0:20:30.90,0:20:34.55,IN-EN,,0,0,0,,Бұл ымыраға келу ме?
Dialogue: 1,0:20:36.21,0:20:40.21,IN-EN,,0,0,0,,Сонымен, сіз не істегіңіз келеді, сіздің көзқарасыңыз қандай?
Dialogue: 1,0:20:40.21,0:20:44.21,IN-EN,,0,0,0,,Жақында кеш бар, барғың келе ме?
Dialogue: 1,0:20:44.21,0:20:47.86,IN-EN,,0,0,0,,Сізбен қол алысу, сіздің көзқарасыңыз қандай?
Dialogue: 1,0:20:47.86,0:20:51.33,IN-EN,,0,0,0,,Мен сенің үстіңдемін, барғым келмейді
Dialogue: 1,0:20:51.33,0:20:55.10,IN-EN,,0,0,0,,Себебі мен сіздің үйіңізде қалғым келеді
Dialogue: 1,0:20:55.10,0:20:58.23,IN-EN,,0,0,0,,Бұл нәтиже береді деп үміттенемін
Dialogue: 1,0:20:58.95,0:21:02.02,IN-EN,,0,0,0,,Бірақ сен мені қаншалықты сындырғаныңды білесің
Dialogue: 1,0:21:02.02,0:21:04.82,IN-EN,,0,0,0,,Мен сенімен біттім, мен сені елемеймін
Dialogue: 1,0:21:04.82,0:21:07.20,IN-EN,,0,0,0,,Менің білгім келмейді
Dialogue: 1,0:21:16.96,0:21:20.47,IN-EN,,0,0,0,,Мен сенің шұңқырда жатқаныңды білемін
Dialogue: 1,0:21:24.60,0:21:32.26,IN-EN,,0,0,0,,Себебі мен сенің жаныңда болу үшін бәрін жасадым
Dialogue: 1,0:21:32.26,0:21:39.08,IN-EN,,0,0,0,,Сондықтан сіз маған айтқаныңызда, мен өтірікке сене алмаймын
Dialogue: 1,0:21:39.99,0:21:44.88,IN-EN,,0,0,0,,Неліктен мен сізге қоңырау шалғым келеді (саған қоңырау шалыңыз, сізге қоңырау шалыңыз, сізге қоңырау шалыңыз)
Dialogue: 1,0:21:45.22,0:21:49.50,IN-EN,,0,0,0,,Сонымен, сіз не істегіңіз келеді, сіздің көзқарасыңыз қандай?
Dialogue: 1,0:21:49.50,0:21:52.28,IN-EN,,0,0,0,,Жақында кеш болады, қалайсыз ба?
Dialogue: 1,0:22:40.83,0:22:45.00,ED-JP_EP02,,0,0,0,,Олар ақырында жалынды сезінеді
Dialogue: 1,0:22:45.18,0:22:49.37,ED-JP_EP02,,0,0,0,,Тамырымда ағып жатқан жалын
Dialogue: 1,0:22:49.71,0:22:53.72,ED-JP_EP02,,0,0,0,,Мен бұл қаланы өртеп жіберемін
Dialogue: 1,0:22:53.93,0:22:58.08,ED-JP_EP02,,0,0,0,,Біз қайтуды жоспарламаймыз
Dialogue: 1,0:22:58.93,0:23:02.76,ED-JP_EP02,,0,0,0,,Еркін болуға тырысу
Dialogue: 1,0:23:03.10,0:23:06.36,ED-JP_EP02,,0,0,0,,Менің көргенімді сендерге көрсету үшін
Dialogue: 1,0:23:07.76,0:23:11.60,ED-JP_EP02,,0,0,0,,Өз тілектеріңізді ұстаныңыз
Dialogue: 1,0:23:11.60,0:23:15.25,ED-JP_EP02,,0,0,0,,Егер сіз мені ұстай алмасаңыз
Dialogue: 1,0:23:15.59,0:23:18.37,ED-JP_EP02,,0,0,0,,Көңіліңізді түсіргенім үшін кешіріңіз
Dialogue: 1,0:23:20.12,0:23:24.03,ED-JP_EP02,,0,0,0,,Сізді тағы да ренжіткенім үшін кешіріңіз
Dialogue: 1,0:23:24.37,0:23:27.45,ED-JP_EP02,,0,0,0,,Менің күшім жеткіліксіз деп ойлаймын
Dialogue: 1,0:23:29.16,0:23:30.88,ED-JP_EP02,,0,0,0,,Дәл қазір
Dialogue: 1,0:23:31.30,0:23:32.38,ED-JP_EP02,,0,0,0,,Сізді ренжітіңіз
Dialogue: 1,0:23:32.38,0:23:38.39,ED-JP_EP02,,0,0,0,,О, менің махаббатым
Dialogue: 1,0:23:46.64,0:23:49.35,ED-JP_EP02,,0,0,0,,Ой, көңіліңді қалдыр
Dialogue: 0,0:22:40.83,0:22:45.00,ED-CH_EP02,,0,0,0,,Адамзаттың ақыры жалынмен сезіледі
Dialogue: 0,0:22:45.18,0:22:49.37,ED-CH_EP02,,0,0,0,,Тамырымда күйіп
Dialogue: 0,0:22:49.71,0:22:53.72,ED-CH_EP02,,0,0,0,,От жарық қаласы
Dialogue: 0,0:22:53.93,0:22:58.08,ED-CH_EP02,,0,0,0,,Қайтару
Dialogue: 0,0:22:58.93,0:23:02.76,ED-CH_EP02,,0,0,0,,Тегін және тегін
Dialogue: 0,0:23:03.10,0:23:06.36,ED-CH_EP02,,0,0,0,,Менің не істей алатынымды көргің келсе
Dialogue: 0,0:23:07.76,0:23:11.60,ED-CH_EP02,,0,0,0,,Меншік иесінің қалауы
Dialogue: 0,0:23:11.60,0:23:15.25,ED-CH_EP02,,0,0,0,,Нәтиже қайталанбайды деп үміттенемін
Dialogue: 0,0:23:15.59,0:23:18.37,ED-CH_EP02,,0,0,0,,Көңілсіздік
Dialogue: 0,0:23:20.12,0:23:24.03,ED-CH_EP02,,0,0,0,,Көңілсіздік
Dialogue: 0,0:23:24.37,0:23:27.45,ED-CH_EP02,,0,0,0,,Менің өзімді тануым күшті
