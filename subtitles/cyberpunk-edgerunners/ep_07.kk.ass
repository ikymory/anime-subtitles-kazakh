Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.46,0:00:08.71,Top,,0000,0000,0000,,‎NETFLIX аниме сериясы
Dialogue: 0,0:00:13.93,0:00:18.35,Top,,0000,0000,0000,,‎(Джулионың ауыр тыныс алуы)
Dialogue: 0,0:00:18.43,0:00:20.60,Top,,0000,0000,0000,,‎Хаа ха…
Dialogue: 0,0:00:21.27,0:00:23.64,Bottom,,0000,0000,0000,,Хулио, өзіңді ренжітіп тұрсың ба?
Dialogue: 0,0:00:21.27,0:00:23.81,Top,,0000,0000,0000,,‎Сен қобалжыдың, Хулио.
Dialogue: 0,0:00:23.73,0:00:24.85,Bottom,,0000,0000,0000,,Жылдам бол, мен қазір ойнағым келеді!
Dialogue: 0,0:00:23.89,0:00:24.85,Top,,0000,0000,0000,,Олай етпе!
Dialogue: 0,0:00:25.44,0:00:28.27,Top,,0000,0000,0000,,Мен сені Вакако алдап кетті деп естідім.
Dialogue: 0,0:00:25.65,0:00:28.15,Bottom,,0000,0000,0000,,Сіз Вакаконың бізді ренжіткен адамсыз, солай ма?
Dialogue: 0,0:00:28.23,0:00:29.77,Bottom,,0000,0000,0000,,Сіздің Дэвидтің жанкүйері екеніңізді естідім.
Dialogue: 0,0:00:28.36,0:00:29.98,Top,,0000,0000,0000,,Сіз шынымен Дэвидтің жанкүйерісіз бе?
Dialogue: 0,0:00:29.86,0:00:32.53,Bottom,,0000,0000,0000,,Иә! Бірақ ол мені саған ренжітті деп не айтасың?
Dialogue: 0,0:00:30.07,0:00:32.53,Top,,0000,0000,0000,,Шынымен! Бұрандалы дегенді қалай түсінесіңдер?
Dialogue: 0,0:00:32.61,0:00:34.86,Bottom,,0000,0000,0000,,Мұны естідің бе, Дэвид?
Dialogue: 0,0:00:32.61,0:00:35.45,Top,,0000,0000,0000,,Сәлем Дэвид жанкүйерлері.
Dialogue: 0,0:00:35.45,0:00:39.03,Bottom,,0000,0000,0000,,Қазір сіздің жанкүйерлеріңіз бар. Бәлкім, сенің бәрің ісіп кеткендіктен болар.
Dialogue: 0,0:00:35.53,0:00:38.95,Top,,0000,0000,0000,,Сіз атақты болдыңыз. Сіз үлкейдіңіз.
Dialogue: 0,0:00:39.83,0:00:40.87,Bottom,,0000,0000,0000,,Мылтығың қайда?
Dialogue: 0,0:00:39.99,0:00:42.91,Top,,0000,0000,0000,,(Дэвид Мартинес) Мылтық туралы не деуге болады? Сіз не қолданасыз?
Dialogue: 0,0:00:41.66,0:00:42.91,Bottom,,0000,0000,0000,,Сіз не қолданасыз?
Dialogue: 0,0:00:43.00,0:00:44.66,Top,,0000,0000,0000,,Иә, Лексингтон.
Dialogue: 0,0:00:43.00,0:00:44.71,Bottom,,0000,0000,0000,,Уф, менде Лексингтон бар.
Dialogue: 0,0:00:44.75,0:00:46.58,Top,,0000,0000,0000,,Мүлдем емес.
Dialogue: 0,0:00:44.79,0:00:46.50,Bottom,,0000,0000,0000,,Бұл оны кеспейді.
Dialogue: 0,0:00:46.58,0:00:49.50,Bottom,,0000,0000,0000,,Сіз онымен Маэлстромға қарсы шығасыз ба?
Dialogue: 0,0:00:46.67,0:00:49.50,Top,,0000,0000,0000,,Сіз Маэлстромға осындай нәрсемен шығуды жоспарлап отырсыз ба?
Dialogue: 0,0:00:50.09,0:00:51.00,Bottom,,0000,0000,0000,,Юкине, сен...
Dialogue: 0,0:00:50.09,0:00:51.00,Top,,0000,0000,0000,,Осыны пайдаланыңыз
Dialogue: 0,0:00:51.96,0:00:54.42,Bottom,,0000,0000,0000,,Шынымен, досым?! Сатара!
Dialogue: 0,0:00:52.17,0:00:54.47,Top,,0000,0000,0000,,Сіз байсалдысыз ба? Бұл Сатара!
Dialogue: 0,0:00:54.51,0:00:56.13,Bottom,,0000,0000,0000,,Жаңа! Рахмет, адам!
Dialogue: 0,0:00:54.55,0:00:56.13,Top,,0000,0000,0000,,Керемет! Міне бітті!
Dialogue: 0,0:00:56.72,0:00:59.55,Bottom,,0000,0000,0000,,Техникалық шолақ мылтықтар өте керемет.
Dialogue: 0,0:00:56.76,0:00:59.39,Top,,0000,0000,0000,,Бұл, әрине, техникалық шолақ мылтық, бұл қауіпті.
Dialogue: 0,0:00:59.47,0:01:00.35,Top,,0000,0000,0000,,‎(Гача!)
Dialogue: 0,0:01:00.31,0:01:02.10,Bottom,,0000,0000,0000,,Зарядтау кадрлары, иә...
Dialogue: 0,0:01:00.43,0:01:01.81,Top,,0000,0000,0000,,Бұл айып...
Dialogue: 0,0:01:01.89,0:01:02.97,Top,,0000,0000,0000,,‎(Зарядтау дыбысы)
Dialogue: 0,0:01:03.02,0:01:04.06,Bottom,,0000,0000,0000,,Бум!
Dialogue: 0,0:01:03.06,0:01:04.02,Top,,0000,0000,0000,,‎Дошун!
Dialogue: 0,0:01:04.10,0:01:05.10,Top,,0000,0000,0000,,‎(Зарядтау дыбысы)
Dialogue: 0,0:01:05.10,0:01:06.27,Bottom,,0000,0000,0000,,Бум!
Dialogue: 0,0:01:05.19,0:01:06.06,Top,,0000,0000,0000,,Дошун!
Dialogue: 0,0:01:06.14,0:01:07.10,Top,,0000,0000,0000,,‎(Зарядтау дыбысы)
Dialogue: 0,0:01:07.19,0:01:08.02,Top,,0000,0000,0000,,‎Дошун!
Dialogue: 0,0:01:07.27,0:01:08.15,Bottom,,0000,0000,0000,,Бум!
Dialogue: 0,0:01:08.23,0:01:10.48,Bottom,,0000,0000,0000,,Оны өшіріңіз!
Dialogue: 0,0:01:08.52,0:01:10.57,Top,,0000,0000,0000,,‎Уззе Уззе Уззе!
Dialogue: 0,0:01:10.57,0:01:12.32,Bottom,,0000,0000,0000,,Ой! Тоқта! Тізені бақылаңыз!
Dialogue: 0,0:01:10.65,0:01:12.19,Top,,0000,0000,0000,,‎Не? Сіз тізеңізді теппейсіз, солай ма?
Dialogue: 0,0:01:12.28,0:01:14.74,Top,,0000,0000,0000,,‎Дошу дош ‎Сен баласың!
Dialogue: 0,0:01:12.40,0:01:14.78,Bottom,,0000,0000,0000,,Сен несің, бес?!
Dialogue: 0,0:01:14.82,0:01:17.91,Top,,0000,0000,0000,,Менің артыма жабысыңыз. Алға асықпа.
Dialogue: 0,0:01:14.86,0:01:17.91,Bottom,,0000,0000,0000,,Менің артымда тұра бер. Алға асықпа.
Dialogue: 0,0:01:17.99,0:01:19.66,Top,,0000,0000,0000,,Иә, артыңызда ма?
Dialogue: 0,0:01:17.99,0:01:22.04,Bottom,,0000,0000,0000,,Менің артта қалғанымды қалайсың ба? Мен жаңадан келген емеспін, жігітім.
Dialogue: 0,0:01:19.74,0:01:21.87,Top,,0000,0000,0000,,Мен жаңадан келген емеспін
Dialogue: 0,0:01:21.95,0:01:22.66,Top,,0000,0000,0000,,(күрсіну)
Dialogue: 0,0:01:22.74,0:01:23.66,Bottom,,0000,0000,0000,,Назар аударыңыз, ханымдар.
Dialogue: 0,0:01:22.74,0:01:25.91,Top,,0000,0000,0000,,‎Ханымдар, біз бір минутта боламыз.
Dialogue: 0,0:01:24.25,0:01:25.91,Bottom,,0000,0000,0000,,Межелі жерден бір минут.
Dialogue: 0,0:01:26.00,0:01:31.00,Top,,0000,0000,0000,,♪~
Dialogue: 0,0:02:49.12,0:02:54.13,Top,,0000,0000,0000,,~♪
Dialogue: 0,0:02:59.55,0:03:01.47,Top,,0000,0000,0000,,‎(Holo News: Kiwi) ‎Ақыр соңында өте аз
Dialogue: 0,0:03:02.22,0:03:04.14,Top,,0000,0000,0000,,Мұнаралар да орналастырылған
Dialogue: 0,0:03:04.22,0:03:07.02,Top,,0000,0000,0000,,‎Хакерлеу үшін қалай тег қою керек ‎Көп күш жұмсалған сияқты
Dialogue: 0,0:03:07.68,0:03:10.98,Top,,0000,0000,0000,,Теорияға сәйкес, алдыңғы жақтан аулақ болыңыз және артқы есікті айналып өтіңіз
Dialogue: 0,0:03:11.06,0:03:13.44,Top,,0000,0000,0000,,Мен теорияны елемеу керек.
Dialogue: 0,0:03:13.52,0:03:14.48,Top,,0000,0000,0000,,Жарайды
Dialogue: 0,0:03:14.56,0:03:16.73,Top,,0000,0000,0000,,Неге артқы есікті іздемейсіз?
Dialogue: 0,0:03:16.82,0:03:18.48,Top,,0000,0000,0000,,‎Мен сені іздеп жүрсем ше?
Dialogue: 0,0:03:18.57,0:03:20.61,Top,,0000,0000,0000,,Е, жоқ, мен де барамын.
Dialogue: 0,0:03:20.99,0:03:22.99,Bottom,,0000,0000,0000,,Олар алдыңғы жақта келе жатқан сияқты.
Dialogue: 0,0:03:21.11,0:03:22.95,Top,,0000,0000,0000,,Олар алдыңғы жақтан келе жатыр.
Dialogue: 0,0:03:23.03,0:03:24.99,Top,,0000,0000,0000,,(Киви) Мен оны көріп тұрмын!
Dialogue: 0,0:03:23.07,0:03:24.99,Bottom,,0000,0000,0000,,Түсінікті. Ет миының қозғалысы!
Dialogue: 0,0:03:26.45,0:03:27.54,Bottom,,0000,0000,0000,,Бля?
Dialogue: 0,0:03:26.66,0:03:30.00,Top,,0000,0000,0000,,‎(Maelstrom) ‎Ой? Сатан алғыр!
Dialogue: 0,0:03:28.16,0:03:30.00,Bottom,,0000,0000,0000,,Түскі асқа етке тапсырыс берген кім?
Dialogue: 0,0:03:30.08,0:03:32.25,Bottom,,0000,0000,0000,,Кішкентай сәбилер жоғалып кетті ме?
Dialogue: 0,0:03:30.08,0:03:32.25,Top,,0000,0000,0000,,(Маэлстром) Бұл жоғалған маймыл ба?
Dialogue: 0,0:03:32.33,0:03:34.75,Bottom,,0000,0000,0000,,Олар бірдеңе бастағысы келетін сияқты.
Dialogue: 0,0:03:32.33,0:03:34.75,Top,,0000,0000,0000,,‎(Маэлстром) ‎Не, сен соншалықты бекініпсің!
Dialogue: 0,0:03:34.83,0:03:37.25,Bottom,,0000,0000,0000,,Құлағыңа боқ тиді ме?!
Dialogue: 0,0:03:34.83,0:03:37.80,Top,,0000,0000,0000,,‎Құлағыңызға боқ кептеліп қалды ма?
Dialogue: 0,0:03:37.84,0:03:41.84,Bottom,,0000,0000,0000,,Мен саған жаңа құлақ теспей тұрып сөйлескенім жөн...
Dialogue: 0,0:03:37.88,0:03:41.63,Top,,0000,0000,0000,,Егер мен бұл қарғыс атқыр құлақтарды тесіп өтсем, мен ести аламын ...
Dialogue: 0,0:03:41.93,0:03:43.76,Bottom,,0000,0000,0000,,Өлер алдында сөйлесуді тоқтатқан дұрыс.
Dialogue: 0,0:03:42.13,0:03:43.76,Top,,0000,0000,0000,,‎Үндемесең мен сені өлтіремін
Dialogue: 0,0:03:43.84,0:03:45.09,Top,,0000,0000,0000,,‎(Барлығы) Ой ой!
Dialogue: 0,0:03:45.18,0:03:46.76,Top,,0000,0000,0000,,Ие!
Dialogue: 0,0:03:49.02,0:03:51.52,Bottom,,0000,0000,0000,,Белгілеу аяқталды. Қысқа шеңбер кіріс…
Dialogue: 0,0:03:49.02,0:03:51.52,Top,,0000,0000,0000,,‎(Киви) ‎Тектеу аяқталды Қысқа тізбек
Dialogue: 0,0:03:52.14,0:03:54.77,Bottom,,0000,0000,0000,,Орындалды! Қоңырау шалдың, бірақ үлгерді, ақымақ!
Dialogue: 0,0:03:52.31,0:03:54.77,Top,,0000,0000,0000,,‎Ха, сен уақытында жасадың, ерте эякуляция сволоч.
Dialogue: 0,0:03:54.85,0:03:57.82,Top,,0000,0000,0000,,‎(Маэлстром) ‎Гах... нетруннер бар.
Dialogue: 0,0:03:55.40,0:03:57.77,Bottom,,0000,0000,0000,,Бля! Олардың нетруннері бар!
Dialogue: 0,0:03:57.90,0:03:58.52,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:03:58.61,0:04:00.65,Top,,0000,0000,0000,,‎(Ребекка күлді)
Dialogue: 0,0:04:05.99,0:04:08.16,Bottom,,0000,0000,0000,,Ах! Біз бәріміз өлеміз!
Dialogue: 0,0:04:05.99,0:04:08.24,Top,,0000,0000,0000,,‎Хяаа! Бұл оқ жауды!
Dialogue: 0,0:04:08.33,0:04:10.54,Top,,0000,0000,0000,,Тым көп, мен енді мұны істей алмаймын
Dialogue: 0,0:04:10.62,0:04:13.04,Bottom,,0000,0000,0000,,Келіңіздер!
Dialogue: 0,0:04:10.62,0:04:13.25,Top,,0000,0000,0000,,‎Үйрек, үйрек, камо!
Dialogue: 0,0:04:13.96,0:04:15.08,Bottom,,0000,0000,0000,,Оқ-дәрі бітті!
Dialogue: 0,0:04:14.00,0:04:15.08,Top,,0000,0000,0000,,Менің оқтар бітті!
Dialogue: 0,0:04:15.17,0:04:16.96,Bottom,,0000,0000,0000,,Қаншыққа шырын жоқ!
Dialogue: 0,0:04:15.17,0:04:17.17,Top,,0000,0000,0000,,‎Ей, оқ таусылды!
Dialogue: 0,0:04:17.04,0:04:18.09,Bottom,,0000,0000,0000,,Оны блять!
Dialogue: 0,0:04:17.25,0:04:18.09,Top,,0000,0000,0000,,Өлтір!
Dialogue: 0,0:04:18.17,0:04:21.01,Bottom,,0000,0000,0000,,Үлкен мылтықтардың уақыты!
Dialogue: 0,0:04:18.17,0:04:21.01,Top,,0000,0000,0000,,‎Келесі ~ Үлкен мылтық!
Dialogue: 0,0:04:22.67,0:04:24.09,Top,,0000,0000,0000,,Бұл мұнара мылтығы.
Dialogue: 0,0:04:23.22,0:04:24.09,Bottom,,0000,0000,0000,,Мұнда мұнара бар!
Dialogue: 0,0:04:25.68,0:04:26.59,Top,,0000,0000,0000,,‎(Holo Communication: David) ‎Киви
Dialogue: 0,0:04:27.18,0:04:29.35,Bottom,,0000,0000,0000,,Абайлаңыз! Жүгірушінің бақылауында...
Dialogue: 0,0:04:27.18,0:04:29.35,Top,,0000,0000,0000,,‎(Maelstrom) ‎Эй, ол бұзылды! Арх!
Dialogue: 0,0:04:29.43,0:04:32.35,Bottom,,0000,0000,0000,,Қарғыс атқыр брат, маған бұйырды...
Dialogue: 0,0:04:29.43,0:04:32.35,Top,,0000,0000,0000,,‎(Киви) ‎Ол адамдармен дөрекі.
Dialogue: 0,0:04:35.48,0:04:36.94,Top,,0000,0000,0000,,Біріншіден, аяқтарыңыздың астындағы қорапқа қараңыздар
Dialogue: 0,0:04:42.49,0:04:46.61,Bottom,,0000,0000,0000,,Нағыз Маэлстроммен ойнауға дайынсыз ба?
Dialogue: 0,0:04:42.57,0:04:46.61,Top,,0000,0000,0000,,‎(Маэлстром) ‎Маэлстроммен ойнайық
Dialogue: 0,0:04:46.70,0:04:47.74,Bottom,,0000,0000,0000,,О, қарғыс атсын...
Dialogue: 0,0:04:46.70,0:04:47.78,Top,,0000,0000,0000,,Керемет
Dialogue: 0,0:04:47.82,0:04:50.62,Bottom,,0000,0000,0000,,Бұл тіпті адам емес пе?!
Dialogue: 0,0:04:47.87,0:04:50.58,Top,,0000,0000,0000,,Хроммен қапталған үлкен жігіт бар.
Dialogue: 0,0:04:51.16,0:04:51.87,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:53.83,0:04:54.79,Top,,0000,0000,0000,,А...
Dialogue: 0,0:04:59.63,0:05:02.76,Top,,0000,0000,0000,,(Маэлстром)
Dialogue: 0,0:04:59.67,0:05:02.88,Bottom,,0000,0000,0000,,Мына органикалық есекті беріңіз...
Dialogue: 0,0:05:03.59,0:05:04.97,Top,,0000,0000,0000,,‎(Имплантты белсендіру дыбысы)
Dialogue: 0,0:05:12.31,0:05:12.93,Top,,0000,0000,0000,,Боу!
Dialogue: 0,0:05:13.02,0:05:13.64,Top,,0000,0000,0000,,На!
Dialogue: 0,0:05:13.73,0:05:17.77,Top,,0000,0000,0000,,‎(Маэлстром) ‎Оны жоюға рұқсат етіңіз!
Dialogue: 0,0:05:13.73,0:05:17.98,Bottom,,0000,0000,0000,,Ал мен саған жаңа тесік жыртамын!
Dialogue: 0,0:05:29.45,0:05:32.95,Bottom,,0000,0000,0000,,Сіз жаңа саңылау аласыз.
Dialogue: 0,0:05:29.70,0:05:32.62,Top,,0000,0000,0000,,‎Мен сенің басыңа тағы да ессіздерді қосамын.
Dialogue: 0,0:05:37.46,0:05:41.00,Top,,0000,0000,0000,,Уау! Керемет! Шу Шу Шу До Баан!
Dialogue: 0,0:05:38.29,0:05:40.96,Bottom,,0000,0000,0000,,Бұл ақылсыз болды! …Zoot-zoot-zoot, bang!
Dialogue: 0,0:05:41.04,0:05:44.21,Bottom,,0000,0000,0000,,Бұл сіздің жаңа аяқ имплантаттары? Жақсы көрінеді.
Dialogue: 0,0:05:41.09,0:05:44.21,Top,,0000,0000,0000,,Шушу Шу Добаан Шушу Шу Добаан Сіз жаңа арматуралық сіңірді қолдандыңыз. Бұл жақсы сезінеді.
Dialogue: 0,0:05:44.80,0:05:46.34,Top,,0000,0000,0000,,(Киви) Осымен аяқталды
Dialogue: 0,0:05:46.97,0:05:50.60,Top,,0000,0000,0000,,Артқы бөлмеге бір адамды итеріп жіберді. Құтқару мақсаты да осында.
Dialogue: 0,0:05:50.68,0:05:51.60,Top,,0000,0000,0000,,Түсінді
Dialogue: 0,0:05:51.68,0:05:53.64,Bottom,,0000,0000,0000,,Түсіндім! Артқы бөлме, солай ма?
Dialogue: 0,0:05:51.68,0:05:53.64,Top,,0000,0000,0000,,Жарайды, бұл артқы бөлме.
Dialogue: 0,0:05:53.72,0:05:54.72,Bottom,,0000,0000,0000,,Күте тұрыңыз! Хулио!
Dialogue: 0,0:05:53.72,0:05:55.98,Top,,0000,0000,0000,,Күте тұр, Хулио, егер қақпан болса.
Dialogue: 0,0:05:54.81,0:05:55.98,Bottom,,0000,0000,0000,,Егер тұзақтар болса...
Dialogue: 0,0:05:56.56,0:05:58.06,Top,,0000,0000,0000,,‎(Жарылыс дыбысы)
Dialogue: 0,0:06:01.02,0:06:01.98,Top,,0000,0000,0000,,‎Ках
Dialogue: 0,0:06:02.98,0:06:04.48,Top,,0000,0000,0000,,‎(есіктің ашылған дыбысы)
Dialogue: 0,0:06:08.95,0:06:10.87,Bottom,,0000,0000,0000,,Изабелла Морган, сен қайдасың?
Dialogue: 0,0:06:08.99,0:06:10.87,Top,,0000,0000,0000,,‎Изабелла Морган сонда ма?
Dialogue: 0,0:06:10.95,0:06:12.87,Top,,0000,0000,0000,,‎
Dialogue: 0,0:06:12.95,0:06:15.12,Bottom,,0000,0000,0000,,Әкеңіз сізге SOS жіберді.
Dialogue: 0,0:06:12.95,0:06:15.12,Top,,0000,0000,0000,,‎Бір қарт мені қорғауымды өтінді.
Dialogue: 0,0:06:15.70,0:06:17.04,Bottom,,0000,0000,0000,,Сіз қазір қауіпсізсіз.
Dialogue: 0,0:06:15.75,0:06:16.95,Top,,0000,0000,0000,,Қазір жақсы.
Dialogue: 0,0:06:17.04,0:06:18.29,Top,,0000,0000,0000,,А...
Dialogue: 0,0:06:18.37,0:06:21.13,Top,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,0:06:21.21,0:06:22.75,Top,,0000,0000,0000,,‎(Голоколь қоңырау үні)
Dialogue: 0,0:06:23.59,0:06:24.63,Top,,0000,0000,0000,,‎‎Вакако?
Dialogue: 0,0:06:24.71,0:06:27.63,Top,,0000,0000,0000,,‎Изабелланың қорғанысы расталды
Dialogue: 0,0:06:28.22,0:06:33.14,Top,,0000,0000,0000,,Бұл өте жақсы орындалды. Клиент те қуанып жылады.
Dialogue: 0,0:06:33.22,0:06:34.39,Top,,0000,0000,0000,,Бұл жақсы болды.
Dialogue: 0,0:06:34.47,0:06:38.39,Top,,0000,0000,0000,,‎Күтілгендей, Cyberpunk күткендей
Dialogue: 0,0:06:38.48,0:06:39.98,Top,,0000,0000,0000,,‎‎Жаңадан келген адам туралы...
Dialogue: 0,0:06:40.06,0:06:42.56,Top,,0000,0000,0000,,‎‎Ой, кешіріңіз.
Dialogue: 0,0:06:42.65,0:06:47.15,Top,,0000,0000,0000,,Мен сізбен бірге болғым келмеді, бірақ сіз әуесқой болған сияқтысыз.
Dialogue: 0,0:06:47.86,0:06:50.41,Top,,0000,0000,0000,,Егер бірдеңе қайталанса, мен сенен көмек сұраймын.
Dialogue: 0,0:06:51.03,0:06:52.91,Top,,0000,0000,0000,,О, маған көмектесіңізші.
Dialogue: 0,0:06:52.99,0:06:53.91,Top,,0000,0000,0000,,‎(байланысты ажырату дыбысы)
Dialogue: 0,0:06:55.66,0:06:57.41,Top,,0000,0000,0000,,‎(Ребекканың ойнақы дауысы)
Dialogue: 0,0:06:57.50,0:07:00.00,Top,,0000,0000,0000,,‎Шашашашаша! ‎Эй!
Dialogue: 0,0:07:00.87,0:07:02.17,Top,,0000,0000,0000,,Ачо!
Dialogue: 0,0:07:02.25,0:07:03.42,Top,,0000,0000,0000,,‎(электрондық дыбыс)
Dialogue: 0,0:07:03.29,0:07:04.42,Bottom,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:07:03.50,0:07:04.42,Top,,0000,0000,0000,,Әрине
Dialogue: 0,0:07:05.17,0:07:07.42,Bottom,,0000,0000,0000,,Рақмет, Фалько.
Dialogue: 0,0:07:05.21,0:07:07.46,Top,,0000,0000,0000,,‎Сен әрқашан көмектесесің, Фалько.
Dialogue: 0,0:07:07.51,0:07:09.88,Bottom,,0000,0000,0000,,Арқамнан тер кетпейді.
Dialogue: 0,0:07:07.55,0:07:09.92,Top,,0000,0000,0000,,‎Маған оңай жалақы алатыным өкінішті.
Dialogue: 0,0:07:10.01,0:07:13.55,Top,,0000,0000,0000,,Ия, сенімді жүргізуші қымбат.
Dialogue: 0,0:07:10.42,0:07:13.51,Bottom,,0000,0000,0000,,Жоқ, жақсы жүргізушілерді табу қиын.
Dialogue: 0,0:07:13.59,0:07:17.22,Bottom,,0000,0000,0000,,Бұл туралы білмеймін. Сізде қазір фан-клуб бар сияқты.
Dialogue: 0,0:07:13.64,0:07:17.35,Top,,0000,0000,0000,,Қазір сізбен бірге болғысы келетіндер көп шығар.
Dialogue: 0,0:07:17.31,0:07:18.93,Bottom,,0000,0000,0000,,Сіз Хулио сияқты дейсіз бе?
Dialogue: 0,0:07:17.43,0:07:18.93,Top,,0000,0000,0000,,Хулио сияқты ма?
Dialogue: 0,0:07:19.02,0:07:21.02,Top,,0000,0000,0000,,‎Мен оны алғаш көргеннен бері
Dialogue: 0,0:07:19.02,0:07:22.56,Bottom,,0000,0000,0000,,Мен оны көргенде гонктың блеф жасап жатқанын білдім.
Dialogue: 0,0:07:21.10,0:07:22.44,Top,,0000,0000,0000,,‎Мен бірдеңені дұрыс істемейтін сияқтымын.
Dialogue: 0,0:07:22.52,0:07:24.19,Top,,0000,0000,0000,,А
Dialogue: 0,0:07:24.19,0:07:30.24,Bottom,,0000,0000,0000,,Мэнді білмесе, мен сияқты баламен жұмыс істейтін ардагерлер көп емес пе?
Dialogue: 0,0:07:24.27,0:07:27.07,Top,,0000,0000,0000,,‎Сен менің басты танысым болуың керек.
Dialogue: 0,0:07:27.15,0:07:30.24,Top,,0000,0000,0000,,Жас ойыншылармен серіктес болғысы келетін ардагерлер жоқ.
Dialogue: 0,0:07:30.32,0:07:33.41,Bottom,,0000,0000,0000,,Мойындау керек, сіз бірінші рет қоңырау шалдыңыз,
Dialogue: 0,0:07:30.32,0:07:33.45,Top,,0000,0000,0000,,Мен де алғаш шақырылған кезде.
Dialogue: 0,0:07:33.49,0:07:36.24,Bottom,,0000,0000,0000,,Мен сізді итермелейтін қытырлақ деп ойладым.
Dialogue: 0,0:07:33.53,0:07:36.16,Top,,0000,0000,0000,,Мен баланың тұмары өкінішті деп ойладым.
Dialogue: 0,0:07:36.66,0:07:38.83,Top,,0000,0000,0000,,‎(Екі адам күледі)
Dialogue: 0,0:07:39.37,0:07:41.71,Bottom,,0000,0000,0000,,Бірақ қазір? Ал...
Dialogue: 0,0:07:39.45,0:07:41.71,Top,,0000,0000,0000,,‎Бірақ, мен қазір осылай ойлаймын.
Dialogue: 0,0:07:42.42,0:07:44.96,Bottom,,0000,0000,0000,,Сіз Мэннің қолынан келгеннен де озық боласыз.
Dialogue: 0,0:07:42.50,0:07:44.96,Top,,0000,0000,0000,,‎Сен бастыдан асып түсетін адамсың.
Dialogue: 0,0:07:46.88,0:07:49.67,Top,,0000,0000,0000,,Мен әділ емес нәрсе айттым.
Dialogue: 0,0:07:47.80,0:07:50.26,Bottom,,0000,0000,0000,,Бұл бәрі сыпырылғанша шығарылады.
Dialogue: 0,0:07:50.34,0:07:52.47,Bottom,,0000,0000,0000,,Келесі үлкен концертіңіз үшін маған қоңырау шалыңыз, иә?
Dialogue: 0,0:07:50.42,0:07:52.47,Top,,0000,0000,0000,,‎Егер сізге басқа нәрсе керек болса, маған қоңырау шалыңыз.
Dialogue: 0,0:07:52.55,0:07:55.30,Bottom,,0000,0000,0000,,Кейінірек ұстаймыз, Дэвид. Киви.
Dialogue: 0,0:07:53.09,0:07:55.43,Top,,0000,0000,0000,,‎Кездескенше Дэвид Киви
Dialogue: 0,0:07:55.39,0:07:56.22,Bottom,,0000,0000,0000,,Көріскенше.
Dialogue: 0,0:07:55.51,0:07:56.22,Top,,0000,0000,0000,,О
Dialogue: 0,0:07:56.80,0:07:57.97,Bottom,,0000,0000,0000,,Сау болыңыз.
Dialogue: 0,0:07:56.80,0:07:57.97,Top,,0000,0000,0000,,‎(киви).
Dialogue: 0,0:08:00.14,0:08:04.23,Bottom,,0000,0000,0000,,Шынымды айтсам? Сізде тізгінді өз қолыңызға алу мүмкіндігі бар екеніне күмәндандым.
Dialogue: 0,0:08:00.27,0:08:04.35,Top,,0000,0000,0000,,(Киви) Негізі, мен сені бұлай көтере алмаймын деп ойладым.
Dialogue: 0,0:08:04.31,0:08:07.02,Bottom,,0000,0000,0000,,Бәрі де біздің үздік жүгірушіге рахмет.
Dialogue: 0,0:08:04.44,0:08:07.19,Top,,0000,0000,0000,,‎Мүмкін тамаша желішілерге рахмет
Dialogue: 0,0:08:07.11,0:08:11.07,Bottom,,0000,0000,0000,,Сенің мені айтқың келмейтініңді екеуміз де білеміз.
Dialogue: 0,0:08:07.27,0:08:11.03,Top,,0000,0000,0000,,‎(Киви) Бұл мен емес. Сіз шынымен топтасуыңыз керек жүгіруші
Dialogue: 0,0:08:12.61,0:08:14.32,Bottom,,0000,0000,0000,,Сіз одан сұрадыңыз, солай ма?
Dialogue: 0,0:08:12.65,0:08:14.32,Top,,0000,0000,0000,,Сіз маған қоңырау шалып тұрсыз, солай ма?
Dialogue: 0,0:08:14.99,0:08:18.53,Bottom,,0000,0000,0000,,Қолданылған. Мен тырысудан бас тарттым.
Dialogue: 0,0:08:15.11,0:08:18.20,Top,,0000,0000,0000,,Бұрын, енді мен сені шақырмаймын.
Dialogue: 0,0:08:18.62,0:08:22.54,Bottom,,0000,0000,0000,,Оны аяғын суытып алатын түрі ретінде бекітпеді.
Dialogue: 0,0:08:18.70,0:08:20.79,Top,,0000,0000,0000,,(Киви) Мен соншалықты әлсіз емеспін.
Dialogue: 0,0:08:20.87,0:08:22.58,Top,,0000,0000,0000,,‎Осылай ойладым~
Dialogue: 0,0:08:22.62,0:08:26.75,Bottom,,0000,0000,0000,,Мен бұл Мэн мен Дориомен болған оқиғадан да көп екеніне сенімдімін.
Dialogue: 0,0:08:22.66,0:08:26.75,Top,,0000,0000,0000,,Менің ойымша, бұл тек Мейн мен Дорио туралы емес.
Dialogue: 0,0:08:27.42,0:08:31.84,Bottom,,0000,0000,0000,,Қоймада Люси біртүрлі әрекет етті.
Dialogue: 0,0:08:27.42,0:08:31.84,Top,,0000,0000,0000,,Сол кезде Люси, қазір ойлап қарасам, ол біртүрлі болып көрінді.
Dialogue: 0,0:08:31.92,0:08:33.13,Bottom,,0000,0000,0000,,Нені білдіреді?
Dialogue: 0,0:08:31.92,0:08:33.17,Top,,0000,0000,0000,,‎(Киви) Сіз нені білдіреді?
Dialogue: 0,0:08:33.22,0:08:36.84,Bottom,,0000,0000,0000,,Барлық нәрсе бұлыңғыр. Ештеңе болмаған шығар.
Dialogue: 0,0:08:33.26,0:08:36.84,Top,,0000,0000,0000,,‎Жоқ, мен де ол кезде қалыпты емес едім.
Dialogue: 0,0:08:39.85,0:08:45.60,Bottom,,0000,0000,0000,,Айтпақшы, сіз Люсиді экипажға әкелген адамсыз, солай ма?
Dialogue: 0,0:08:39.93,0:08:44.35,Top,,0000,0000,0000,,Білесіз бе, мен Люсиді командаға шақырдым.
Dialogue: 0,0:08:44.44,0:08:45.69,Top,,0000,0000,0000,,‎Бұл киви, солай ма?
Dialogue: 0,0:08:45.69,0:08:46.77,Bottom,,0000,0000,0000,,Оқу, оқу
Dialogue: 0,0:08:45.77,0:08:46.90,Top,,0000,0000,0000,,‎(Киви) Иә.
Dialogue: 0,0:08:46.85,0:08:49.11,Bottom,,0000,0000,0000,,Ол сізге өткен өмірі туралы айтып жатыр ма?
Dialogue: 0,0:08:46.98,0:08:49.11,Top,,0000,0000,0000,,Ескі күндер туралы естідің бе?
Dialogue: 0,0:08:49.19,0:08:50.61,Top,,0000,0000,0000,,‎(киви) №
Dialogue: 0,0:08:49.19,0:08:50.65,Bottom,,0000,0000,0000,,Ах, бұл – өзін өзгелерден бөліп тұратын сызық екен
Dialogue: 0,0:08:51.36,0:08:53.03,Top,,0000,0000,0000,,Киберпанк?
Dialogue: 0,0:08:51.36,0:08:55.61,Bottom,,0000,0000,0000,,Біздің лигадағы саптардың көпшілігі ескі күндерді келтірмейді.
Dialogue: 0,0:08:53.11,0:08:55.78,Top,,0000,0000,0000,,‎Өмір сүрген адам үшін қашу жолы ма?
Dialogue: 0,0:08:55.70,0:08:59.24,Bottom,,0000,0000,0000,,Ұят, ашкөздік, дәлелдейтін нәрсе ... бәрібір.
Dialogue: 0,0:08:55.86,0:08:58.87,Top,,0000,0000,0000,,Аяғын көрмейтін түс көруші, солай ма?
Dialogue: 0,0:08:59.33,0:09:02.50,Bottom,,0000,0000,0000,,Шығу немесе көтерілу жолын іздейсіз бе, маңызды ма?
Dialogue: 0,0:08:59.49,0:09:02.29,Top,,0000,0000,0000,,‎Өткенге үңілу әдепсіз.
Dialogue: 0,0:09:02.37,0:09:03.54,Top,,0000,0000,0000,,‎Ха…
Dialogue: 0,0:09:04.62,0:09:06.00,Top,,0000,0000,0000,,‎Эй, эй!
Dialogue: 0,0:09:06.08,0:09:07.79,Bottom,,0000,0000,0000,,Неге ұзын бет, Дэвид?!
Dialogue: 0,0:09:06.08,0:09:07.88,Top,,0000,0000,0000,,Уайымдама, Дэвид.
Dialogue: 0,0:09:07.88,0:09:11.38,Bottom,,0000,0000,0000,,Құшақтауды қойып, менімен билеңіз!
Dialogue: 0,0:09:07.96,0:09:11.59,Top,,0000,0000,0000,,‎Кәрі ханымдармен сырласпа. Би билейік, иә?
Dialogue: 0,0:09:12.51,0:09:14.80,Top,,0000,0000,0000,,‎(Киви) ‎Бұл жай ғана сұмдық өмір.
Dialogue: 0,0:09:12.55,0:09:17.01,Bottom,,0000,0000,0000,,Кейбір жүгірушілер бастағаннан гөрі ұяттан өледі...
Dialogue: 0,0:09:14.88,0:09:17.01,Top,,0000,0000,0000,,Сіз жүрмейтін сияқтысыз.
Dialogue: 0,0:09:17.09,0:09:18.72,Top,,0000,0000,0000,,‎Аппақ
Dialogue: 0,0:09:17.09,0:09:23.14,Bottom,,0000,0000,0000,,Кем дегенде, желге ұшып тұрған психо мені ренжіткен жоқ.
Dialogue: 0,0:09:18.80,0:09:23.27,Top,,0000,0000,0000,,‎Кәрі адам иығын ашып өлтірді. Сен ақымақ.
Dialogue: 0,0:09:23.22,0:09:27.52,Bottom,,0000,0000,0000,,Қалай болғанда да, сіз Дэвидтің билегенін көрдіңіз бе? Бұл тәртіпсіздік…
Dialogue: 0,0:09:23.35,0:09:27.56,Top,,0000,0000,0000,,Солай ма? Сен білесің бе? Дэвидтің өте ақсақ биі
Dialogue: 0,0:09:27.60,0:09:31.15,Bottom,,0000,0000,0000,,Кешіріңіз, мен кетіп бара жатырмын. Дәрігерге тоқтаймын.
Dialogue: 0,0:09:27.65,0:09:29.94,Top,,0000,0000,0000,,‎Жаман, мен де үйге барамын.
Dialogue: 0,0:09:30.02,0:09:31.23,Top,,0000,0000,0000,,Келіңіз
Dialogue: 0,0:09:31.23,0:09:33.03,Bottom,,0000,0000,0000,,Не? Тағы?
Dialogue: 0,0:09:31.32,0:09:33.07,Top,,0000,0000,0000,,‎Е... тағы да?
Dialogue: 0,0:09:33.11,0:09:36.03,Bottom,,0000,0000,0000,,Айтыңыз, сізге би чипін немесе басқасын сатсын!
Dialogue: 0,0:09:33.15,0:09:35.90,Top,,0000,0000,0000,,Қалай болғанда да бишілерге имплант алыңыз.
Dialogue: 0,0:09:35.99,0:09:37.53,Top,,0000,0000,0000,,Өткір жігіт Дауысыңды шығар!
Dialogue: 0,0:09:36.11,0:09:37.53,Bottom,,0000,0000,0000,,-Нағыз жақсы! -Ауызыңды жап.
Dialogue: 0,0:09:37.61,0:09:38.74,Top,,0000,0000,0000,,‎Онда кездескенше
Dialogue: 0,0:09:37.61,0:09:38.82,Bottom,,0000,0000,0000,,Кейінірек ұстаңыз.
Dialogue: 0,0:09:41.28,0:09:44.70,Bottom,,0000,0000,0000,,Неліктен сіз әрқашан қиын ойын ойнауыңыз керек?!
Dialogue: 0,0:09:41.45,0:09:44.66,Top,,0000,0000,0000,,Тексеріңіз, біз бұрынғыдай нашармыз!
Dialogue: 0,0:09:44.75,0:09:47.12,Top,,0000,0000,0000,,‎(Киви) Тәсіл ‎Мүмкін оны өзгерту керек пе?
Dialogue: 0,0:09:44.79,0:09:47.12,Bottom,,0000,0000,0000,,Неліктен көзқарасыңызды шайқамайсыз?
Dialogue: 0,0:09:47.21,0:09:48.54,Bottom,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:47.21,0:09:48.54,Top,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:09:49.29,0:09:53.13,Bottom,,0000,0000,0000,,Мен ұялшақ пен ерке ойнауым керек деп ойлайсыз ба...
Dialogue: 0,0:09:49.38,0:09:51.54,Top,,0000,0000,0000,,Йинкья үшін Инкья…
Dialogue: 0,0:09:51.63,0:09:53.13,Top,,0000,0000,0000,,Мүмкін...
Dialogue: 0,0:09:57.13,0:09:59.43,Top,,0000,0000,0000,,‎(Repardoku) ‎Бұрмаланған білік
Dialogue: 0,0:09:57.13,0:10:01.22,Bottom,,0000,0000,0000,,Бұл майысқан металл бөлігі қолыңызды розеткаға итеріп жіберді.
Dialogue: 0,0:09:59.51,0:10:01.39,Top,,0000,0000,0000,,Бұл жай ғана олар оны мәжбүрлеп кіргізеді.
Dialogue: 0,0:10:01.30,0:10:03.56,Bottom,,0000,0000,0000,,Бұл бірінші кезекте сізге сәйкес келмейді.
Dialogue: 0,0:10:01.47,0:10:03.56,Top,,0000,0000,0000,,‎Бұл біріншіден менің дене бітіміме сәйкес келмейді.
Dialogue: 0,0:10:04.39,0:10:06.48,Bottom,,0000,0000,0000,,Оның үстіне бұл ескі үлгі.
Dialogue: 0,0:10:04.43,0:10:06.60,Top,,0000,0000,0000,,Үлгі де екі ұрпақ бұрынғы.
Dialogue: 0,0:10:06.56,0:10:09.31,Bottom,,0000,0000,0000,,Жаңа буын хромының барлық түрін алды...
Dialogue: 0,0:10:06.68,0:10:09.81,Top,,0000,0000,0000,,‎Қалай? Жақсы әскери заттар бар.
Dialogue: 0,0:10:09.40,0:10:11.31,Bottom,,0000,0000,0000,,Мен мұнымен жақсымын.
Dialogue: 0,0:10:09.90,0:10:11.31,Top,,0000,0000,0000,,‎Жарайды, бұл.
Dialogue: 0,0:10:11.40,0:10:14.82,Bottom,,0000,0000,0000,,Цк. Жақсы. Бұл сенің жерлеуің.
Dialogue: 0,0:10:11.40,0:10:14.82,Top,,0000,0000,0000,,‎(Липердок) Егер солай болса, асығыңыз да.
Dialogue: 0,0:10:14.90,0:10:19.11,Bottom,,0000,0000,0000,,Бұлшықет күшейткіштері бар ма? Кирошидің жаңа моделі?
Dialogue: 0,0:10:14.90,0:10:19.16,Top,,0000,0000,0000,,Мен оның орнына күшейту жүйесін сұраймын. Сізде соңғы Кироши бар ма?
Dialogue: 0,0:10:19.20,0:10:22.37,Bottom,,0000,0000,0000,,Мен өзгертілген хром басымен сөйлесіп жатқанымды білмедім.
Dialogue: 0,0:10:19.24,0:10:20.24,Top,,0000,0000,0000,,‎(Липпардоку) Эй, эй
Dialogue: 0,0:10:20.32,0:10:22.37,Top,,0000,0000,0000,,Сіз шынымен баяғыда жынды болдыңыз ба?
Dialogue: 0,0:10:22.45,0:10:23.58,Bottom,,0000,0000,0000,,Мен емес.
Dialogue: 0,0:10:22.45,0:10:23.58,Top,,0000,0000,0000,,Мен лайықтымын
Dialogue: 0,0:10:24.16,0:10:25.66,Bottom,,0000,0000,0000,,Сізге жеңіл болу керек.
Dialogue: 0,0:10:24.16,0:10:25.75,Top,,0000,0000,0000,,‎(Reperdoc) Оны біраз уақытқа тоқтатыңыз.
Dialogue: 0,0:10:25.75,0:10:28.62,Bottom,,0000,0000,0000,,Бұл қарқынмен сіздің ақыл-ойыңыз төтеп бере алмайды.
Dialogue: 0,0:10:25.83,0:10:28.50,Top,,0000,0000,0000,,‎Осы қарқынмен тіпті таныс нәрселер де бейтаныс болып қалады.
Dialogue: 0,0:10:28.58,0:10:30.21,Top,,0000,0000,0000,,Жарайды
Dialogue: 0,0:10:28.71,0:10:30.04,Bottom,,0000,0000,0000,,Менде бәрі жақсы.
Dialogue: 0,0:10:30.12,0:10:33.67,Bottom,,0000,0000,0000,,Қанша хром алсам да, түк те сезбеймін.
Dialogue: 0,0:10:30.29,0:10:33.79,Top,,0000,0000,0000,,Менде қандай имплант болса да, мен мүлде ыңғайсыздықты сезінбеймін.
Dialogue: 0,0:10:33.75,0:10:36.42,Bottom,,0000,0000,0000,,Металл өз терімде болғаннан гөрі жақсырақ сезінеді.
Dialogue: 0,0:10:33.88,0:10:36.59,Top,,0000,0000,0000,,Шындығында, бұл нақты нәрседен гөрі таныс.
Dialogue: 0,0:10:36.51,0:10:40.59,Bottom,,0000,0000,0000,,Мойындауым керек, сіздің кибербағдарламаға бейімделу қабілетіңіз жаңғақ.
Dialogue: 0,0:10:36.67,0:10:40.64,Top,,0000,0000,0000,,‎(Lippardoc) Шынында да, сіздің хромға бейімделуіңіз қалыпты емес.
Dialogue: 0,0:10:40.68,0:10:44.10,Bottom,,0000,0000,0000,,Мұндай киборгты ешқашан көрген емеспін.
Dialogue: 0,0:10:40.72,0:10:43.76,Top,,0000,0000,0000,,Оны табиғи сезімсіз жігіт деп атауға болады.
Dialogue: 0,0:10:44.18,0:10:46.81,Bottom,,0000,0000,0000,,Сіздің кибербағдарлама сыйымдылығы әлдеқашан--
Dialogue: 0,0:10:44.26,0:10:46.81,Top,,0000,0000,0000,,Сіздің адамгершілігіңіздің құны...
Dialogue: 0,0:10:46.89,0:10:48.98,Bottom,,0000,0000,0000,,Сіз өзіңізді ерекшемін деп ойлайсыз ба?
Dialogue: 0,0:10:46.89,0:10:48.98,Top,,0000,0000,0000,,(ЖК) Сіз өзіңізді ерекшемін деп ойлайсыз ба?
Dialogue: 0,0:10:49.06,0:10:51.40,Bottom,,0000,0000,0000,,Ерекше болуы керек, менің ойымша.
Dialogue: 0,0:10:49.06,0:10:51.40,Top,,0000,0000,0000,,‎"ерекше" деп айтқым келеді
Dialogue: 0,0:10:51.48,0:10:52.40,Top,,0000,0000,0000,,‎(Lippardoc) Ха!
Dialogue: 0,0:10:52.40,0:10:54.77,Bottom,,0000,0000,0000,,Сіз Адам Смашер сияқты болғыңыз келе ме?
Dialogue: 0,0:10:52.48,0:10:54.82,Top,,0000,0000,0000,,Сіз Адам Смашер болғыңыз келе ме?
Dialogue: 0,0:10:54.86,0:10:56.03,Bottom,,0000,0000,0000,,Адам не?
Dialogue: 0,0:10:54.90,0:10:56.11,Top,,0000,0000,0000,,Адам?
Dialogue: 0,0:10:56.11,0:10:58.90,Bottom,,0000,0000,0000,,Қарғыс атсын. Осы уақыттың бәрінде және сіз әлі де жаңа адамсыз.
Dialogue: 0,0:10:56.19,0:10:57.40,Top,,0000,0000,0000,,‎(Липпардок) ‎Оны сонша атасаңыз да,
Dialogue: 0,0:10:57.49,0:10:58.90,Top,,0000,0000,0000,,‎Ол әлі де жаңа ойыншы.
Dialogue: 0,0:10:58.99,0:11:01.66,Bottom,,0000,0000,0000,,Адам Смешерді де танымайсың.
Dialogue: 0,0:10:58.99,0:11:01.66,Top,,0000,0000,0000,,Адам Смашер де мен білмеймін.
Dialogue: 0,0:11:01.74,0:11:04.83,Bottom,,0000,0000,0000,,Кейбіреулер оны 4-ші корпоративтік соғыстағы соғыс қаһарманы ретінде біледі.
Dialogue: 0,0:11:02.28,0:11:04.87,Top,,0000,0000,0000,,4-ші корпоративтік соғыстан бері
Dialogue: 0,0:11:04.91,0:11:09.16,Bottom,,0000,0000,0000,,Басқаларға толық кибордталған бугеймен, серуендеу қорқынышты түс.
Dialogue: 0,0:11:04.95,0:11:09.21,Top,,0000,0000,0000,,Ол алдыңғы қатарда өмір сүруді жалғастыруда. Бұл толығымен хромнан жасалған құбыжық.
Dialogue: 0,0:11:09.25,0:11:13.29,Bottom,,0000,0000,0000,,Бірақ бәрінен, тірі аңыздан сұраңыз.
Dialogue: 0,0:11:09.29,0:11:13.29,Top,,0000,0000,0000,,Адам Смашер әлі де аңыздарды жаппай шығаруда дейді.
Dialogue: 0,0:11:13.88,0:11:15.63,Bottom,,0000,0000,0000,,Қандай аңыз?
Dialogue: 0,0:11:13.88,0:11:15.67,Top,,0000,0000,0000,,‎‎Аңыздарды жаппай шығару?
Dialogue: 0,0:11:15.71,0:11:17.80,Bottom,,0000,0000,0000,,Сыртта зират бар шығар
Dialogue: 0,0:11:15.75,0:11:17.80,Top,,0000,0000,0000,,‎(Липардоку) ‎Арасакаға қарсы тұрған үлкен адам.
Dialogue: 0,0:11:17.88,0:11:20.47,Bottom,,0000,0000,0000,,үлкен кадрларға толы ол Арасаканың бұйрығымен тегістелді.
Dialogue: 0,0:11:17.88,0:11:20.59,Top,,0000,0000,0000,,Сізді қабірге жіберіп жатырсыз.
Dialogue: 0,0:11:20.55,0:11:22.26,Bottom,,0000,0000,0000,,Өтірік сияқты естіледі.
Dialogue: 0,0:11:20.68,0:11:22.30,Top,,0000,0000,0000,,Өтірік айтпа
Dialogue: 0,0:11:22.39,0:11:25.14,Top,,0000,0000,0000,,(Голоколь қоңырау үні) Ммм... Киви?
Dialogue: 0,0:11:23.64,0:11:24.80,Bottom,,0000,0000,0000,,Киви?
Dialogue: 0,0:11:26.14,0:11:27.10,Bottom,,0000,0000,0000,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:11:26.14,0:11:27.18,Top,,0000,0000,0000,,‎(Голо-беру: Дэвид) ‎Не болды?
Dialogue: 0,0:11:27.18,0:11:30.06,Bottom,,0000,0000,0000,,Сіз ақыреттік өмірге бара аласыз ба?
Dialogue: 0,0:11:27.26,0:11:30.06,Top,,0000,0000,0000,,(Киви) Сіз енді ақырет өміріне келе аласыз ба?
Dialogue: 0,0:11:30.14,0:11:32.56,Bottom,,0000,0000,0000,,Балалар, әлі де барсыз ба?
Dialogue: 0,0:11:30.14,0:11:32.56,Top,,0000,0000,0000,,‎‎Не, ішіп тұрған жоқсың ба?
Dialogue: 0,0:11:32.65,0:11:35.06,Bottom,,0000,0000,0000,,Мұнда сізді көргісі келетін біреу бар.
Dialogue: 0,0:11:32.65,0:11:35.06,Top,,0000,0000,0000,,‎(Киви) ‎Сізбен танысқысы келетін біреу бар.
Dialogue: 0,0:11:35.65,0:11:36.82,Top,,0000,0000,0000,,‎(Киви) Давид
Dialogue: 0,0:11:35.69,0:11:36.73,Bottom,,0000,0000,0000,,Давид.
Dialogue: 0,0:11:36.82,0:11:38.94,Bottom,,0000,0000,0000,,Сәлем, киви.
Dialogue: 0,0:11:36.90,0:11:38.57,Top,,0000,0000,0000,,Сәлем Киви
Dialogue: 0,0:11:39.86,0:11:41.07,Bottom,,0000,0000,0000,,Сәттілік тілеймін.
Dialogue: 0,0:11:39.86,0:11:41.15,Top,,0000,0000,0000,,‎(Киви) Сәттілік
Dialogue: 0,0:11:43.57,0:11:47.08,Bottom,,0000,0000,0000,,Мартинес мырза, біз бірінші рет кездесіп отырмыз деп ойлаймын.
Dialogue: 0,0:11:43.70,0:11:47.08,Top,,0000,0000,0000,,‎(Фарадей) Танысқаныма қуаныштымын ба? Мартинес мырза
Dialogue: 0,0:11:47.16,0:11:50.58,Bottom,,0000,0000,0000,,Екеуміздің жолымыз қиылды... Сіз Мэнмен сөйлесу үшін бір рет кешке келдіңіз.
Dialogue: 0,0:11:47.16,0:11:50.58,Top,,0000,0000,0000,,Мен Майн екеуің кездескен кезде бір рет сонда болдым.
Dialogue: 0,0:11:51.79,0:11:54.71,Top,,0000,0000,0000,,‎(Фарадей) Мен көремін, содан кейін тағы да.
Dialogue: 0,0:11:51.79,0:11:55.08,Bottom,,0000,0000,0000,,Солай ма? Кіріспелер реттелген деп ойлаймын.
Dialogue: 0,0:11:55.17,0:11:56.46,Bottom,,0000,0000,0000,,Мен Фарадеймін.
Dialogue: 0,0:11:55.25,0:11:56.46,Top,,0000,0000,0000,,Фарадей.
Dialogue: 0,0:11:59.59,0:12:01.13,Bottom,,0000,0000,0000,,Маған жұмысың бар ма?
Dialogue: 0,0:11:59.63,0:12:01.17,Top,,0000,0000,0000,,Сіз жұмыс туралы айтып отырсыз ба?
Dialogue: 0,0:12:01.22,0:12:04.97,Bottom,,0000,0000,0000,,Асықпаудың қажеті жоқ. Сізге ішімдіік алып беруге рұқсат беріңіз
Dialogue: 0,0:12:01.26,0:12:04.97,Top,,0000,0000,0000,,‎(Фарадей) Асықпаудың қажеті жоқ. Алдымен саған сусын алып берейін.
Dialogue: 0,0:12:05.59,0:12:08.85,Bottom,,0000,0000,0000,,Мен сен туралы көп естідім.
Dialogue: 0,0:12:05.68,0:12:08.85,Top,,0000,0000,0000,,Мен сіз туралы соңғы уақытта көп естідім.
Dialogue: 0,0:12:09.43,0:12:12.39,Bottom,,0000,0000,0000,,Сіз өзіңіздің атыңызды шығарып жатырсыз.
Dialogue: 0,0:12:09.43,0:12:12.39,Top,,0000,0000,0000,,Кредоны бұрын-соңды болмаған күшпен алуды жалғастырыңыз——
Dialogue: 0,0:12:12.48,0:12:14.85,Bottom,,0000,0000,0000,,Сандестистандық жаңа ойыншы.
Dialogue: 0,0:12:12.48,0:12:14.85,Top,,0000,0000,0000,,‎Сандеви Стэнді пайдаланатын жаңа ойыншы
Dialogue: 0,0:12:15.44,0:12:18.07,Bottom,,0000,0000,0000,,Менде қазір Сэндиден көп нәрсе бар.
Dialogue: 0,0:12:15.44,0:12:18.11,Top,,0000,0000,0000,,‎Сандевистан менің бір бөлігім ғана.
Dialogue: 0,0:12:18.15,0:12:22.11,Bottom,,0000,0000,0000,,Бұл дұрыс. Сіз қазір сүйектен гөрі болат сияқтысыз.
Dialogue: 0,0:12:18.19,0:12:22.11,Top,,0000,0000,0000,,‎(Фарадей) Шынымен де, қазір сіздің ет пен қаныңыз аз сияқты.
Dialogue: 0,0:12:22.86,0:12:26.16,Bottom,,0000,0000,0000,,Мэн екеуміз екі жаққа да тиімді жұмыс қарым-қатынаста болдық.
Dialogue: 0,0:12:22.90,0:12:26.24,Top,,0000,0000,0000,,Мен өз басымнан жұмыс сұрайтынмын.
Dialogue: 0,0:12:26.24,0:12:27.58,Bottom,,0000,0000,0000,,Мұнда.
Dialogue: 0,0:12:26.32,0:12:27.66,Top,,0000,0000,0000,,Мен білемін
Dialogue: 0,0:12:27.66,0:12:30.29,Bottom,,0000,0000,0000,,Ол экипаждың химиясын түсінді.
Dialogue: 0,0:12:27.74,0:12:30.16,Top,,0000,0000,0000,,(Фарадей) Ол командалық ойындарда жақсы болды.
Dialogue: 0,0:12:30.24,0:12:31.29,Top,,0000,0000,0000,,О
Dialogue: 0,0:12:30.37,0:12:31.20,Bottom,,0000,0000,0000,,Ол жасады.
Dialogue: 0,0:12:31.29,0:12:35.12,Bottom,,0000,0000,0000,,Бірақ оның кемшілігі - жеке басына байланысты болды.
Dialogue: 0,0:12:31.37,0:12:35.21,Top,,0000,0000,0000,,‎(Фарадей) Бірақ кейде достар арасындағы достық сізді зейін қоюдан алшақтатады.
Dialogue: 0,0:12:35.21,0:12:37.63,Bottom,,0000,0000,0000,,Таныс сананы лайлайды, ойранға апарады.
Dialogue: 0,0:12:35.29,0:12:37.63,Top,,0000,0000,0000,,‎Бұл жұмыстың дәлдігін төмендетуі мүмкін.
Dialogue: 0,0:12:39.21,0:12:41.96,Bottom,,0000,0000,0000,,Менің естуімше, сіз топтық жұмыста да жақсы екенсіз.
Dialogue: 0,0:12:39.25,0:12:42.01,Top,,0000,0000,0000,,‎Сіз командалық ойындарда да жақсы сияқтысыз.
Dialogue: 0,0:12:42.05,0:12:44.80,Bottom,,0000,0000,0000,,Бірақ мен жеке және кәсіби өмірімді бөлек ұстаймын.
Dialogue: 0,0:12:42.09,0:12:44.88,Top,,0000,0000,0000,,‎Бұл ниет, сондықтан біз бір-бірімізді танымаймыз.
Dialogue: 0,0:12:44.88,0:12:49.85,Bottom,,0000,0000,0000,,Мен сізді Мэнмен бірдей деңгейде жұмыс істей алатыныңызға сендіргім келеді.
Dialogue: 0,0:12:44.97,0:12:48.39,Top,,0000,0000,0000,,(Фарадей) Алдымен, негізгі жұмысты орындай алатыныңды көрейік.
Dialogue: 0,0:12:48.47,0:12:49.85,Top,,0000,0000,0000,,Мен мұны дәлелдеуіңізді қалаймын.
Dialogue: 0,0:12:49.93,0:12:50.97,Bottom,,0000,0000,0000,,Сіз мені сынап жатырсыз ба?
Dialogue: 0,0:12:49.93,0:12:50.97,Top,,0000,0000,0000,,Бұл сынақ па?
Dialogue: 0,0:12:51.06,0:12:53.31,Bottom,,0000,0000,0000,,Сіз бұл туралы ойлай аласыз.
Dialogue: 0,0:12:51.06,0:12:53.39,Top,,0000,0000,0000,,(Фарадей) Сіз осылай ойласаңыз, мен қарсы емеспін.
Dialogue: 0,0:12:53.39,0:12:56.65,Bottom,,0000,0000,0000,,Сіз мені қалағаныңыздың бәрін сынай аласыз, бірақ мен арзанға жұмыс істеп жатқан жоқпын.
Dialogue: 0,0:12:53.48,0:12:56.69,Top,,0000,0000,0000,,Тесттер жақсы, бірақ мен арзан жұмыстан бас тартамын.
Dialogue: 0,0:12:56.73,0:12:59.15,Bottom,,0000,0000,0000,,Мен жасайтын ештеңе арзан емес.
Dialogue: 0,0:12:56.77,0:12:59.15,Top,,0000,0000,0000,,(Фарадей) Мен арзан жұмыс істемеймін.
Dialogue: 0,0:13:06.86,0:13:08.78,Bottom,,0000,0000,0000,,Бұл Милитех жұмысы ма?
Dialogue: 0,0:13:06.99,0:13:11.12,Top,,0000,0000,0000,,‎Клиент Милитех пе? Арасаканың іскер жауы, солай ма?
Dialogue: 0,0:13:08.87,0:13:11.04,Bottom,,0000,0000,0000,,Олар Арасакамен қайшылықта.
Dialogue: 0,0:13:11.12,0:13:15.29,Bottom,,0000,0000,0000,,Сіз күткендей, корпоративтік жұмыстар ең көп төлейді.
Dialogue: 0,0:13:11.20,0:13:15.04,Top,,0000,0000,0000,,‎Әрине, жалақысы жоғары жұмыс орындарының көбі корпоративтік жұмыс болып табылады.
Dialogue: 0,0:13:15.37,0:13:17.50,Bottom,,0000,0000,0000,,Сіз қарсысыз ба?
Dialogue: 0,0:13:15.62,0:13:17.50,Top,,0000,0000,0000,,Сіз корпусты жек көресіз бе?
Dialogue: 0,0:13:18.63,0:13:19.63,Bottom,,0000,0000,0000,,Орындалды деп есептеңіз.
Dialogue: 0,0:13:18.63,0:13:19.63,Top,,0000,0000,0000,,Алайық
Dialogue: 0,0:13:19.71,0:13:21.05,Bottom,,0000,0000,0000,,Тыңдау жақсы.
Dialogue: 0,0:13:19.71,0:13:21.09,Top,,0000,0000,0000,,‎(Фарадей) Мен оны асыға күтемін.
Dialogue: 0,0:13:21.13,0:13:24.88,Bottom,,0000,0000,0000,,Осы жұмыстан кейін бір тапсырманы орындағаныңызды қалаймын.
Dialogue: 0,0:13:21.17,0:13:24.92,Top,,0000,0000,0000,,‎Егер бұл ойдағыдай болса, менің жұмысым бар, оны сіз басқарғаныңызды қалаймын.
Dialogue: 0,0:13:24.97,0:13:26.51,Bottom,,0000,0000,0000,,Бұл сізге таныс мәселе.
Dialogue: 0,0:13:25.01,0:13:26.72,Top,,0000,0000,0000,,Менің де сенімен байланысым бар.
Dialogue: 0,0:13:26.59,0:13:29.01,Bottom,,0000,0000,0000,,Сіз Танакадан қажет деректерді айтасыз ба?
Dialogue: 0,0:13:26.80,0:13:29.01,Top,,0000,0000,0000,,Мен Танакадан шығуға тырыстым. Деректер ме?
Dialogue: 0,0:13:29.09,0:13:31.06,Top,,0000,0000,0000,,(Фарадей) Өкінішке орай, Танаканың ішінде
Dialogue: 0,0:13:29.09,0:13:33.22,Bottom,,0000,0000,0000,,Өкінішке орай, мен Танаканың деректері жоқ екендігі туралы хабарлама алдым.
Dialogue: 0,0:13:31.14,0:13:32.97,Top,,0000,0000,0000,,Деректер жоқ сияқты.
Dialogue: 0,0:13:33.31,0:13:34.14,Bottom,,0000,0000,0000,,Иә.
Dialogue: 0,0:13:33.47,0:13:34.35,Top,,0000,0000,0000,,О
Dialogue: 0,0:13:34.23,0:13:38.10,Bottom,,0000,0000,0000,,Бірақ мен сіздің Арасаканың ICE-ті сәтті айналып өткеніңіз туралы хабарлама алдым.
Dialogue: 0,0:13:34.43,0:13:36.27,Top,,0000,0000,0000,,(Фарадей) Бірақ Арасака қауіпсіздігі
Dialogue: 0,0:13:36.35,0:13:38.10,Top,,0000,0000,0000,,Мен сізді бұзып кеткеніңізді естідім, солай ма?
Dialogue: 0,0:13:38.19,0:13:42.02,Bottom,,0000,0000,0000,,Мұны Киви емес, қосалқы жүгіруші жасады.
Dialogue: 0,0:13:38.19,0:13:42.11,Top,,0000,0000,0000,,‎Ал ол киви емес. Мен оның қосалқы жүгіруші екенін естідім.
Dialogue: 0,0:13:42.11,0:13:45.44,Bottom,,0000,0000,0000,,Иә. Біздің командада жақсы жүгірушілер бар.
Dialogue: 0,0:13:42.19,0:13:43.86,Top,,0000,0000,0000,,‎Аа, менің командам
Dialogue: 0,0:13:43.94,0:13:45.40,Top,,0000,0000,0000,,Барлығы жүгірушілер туралы
Dialogue: 0,0:13:45.49,0:13:48.53,Top,,0000,0000,0000,,(Фарадей) Керемет, бірақ қазір мәселе бар.
Dialogue: 0,0:13:45.53,0:13:48.53,Bottom,,0000,0000,0000,,Өте жақсы. Дегенмен, бұл жүгірушінің жоқ екенін естідім.
Dialogue: 0,0:13:49.11,0:13:52.03,Bottom,,0000,0000,0000,,Иә. Олар осы жағдайдан кейін командадан кетті.
Dialogue: 0,0:13:49.11,0:13:52.03,Top,,0000,0000,0000,,‎Ой, содан бері командаға қосылмадым.
Dialogue: 0,0:13:52.12,0:13:55.54,Bottom,,0000,0000,0000,,Неліктен бұл? Жақсы таланттың босқа кетуі.
Dialogue: 0,0:13:52.12,0:13:55.54,Top,,0000,0000,0000,,‎(Фарадей) Неліктен? Ол сондай тамаша жүгіруші.
Dialogue: 0,0:13:56.12,0:13:57.79,Bottom,,0000,0000,0000,,Олардың жүрегі бұл жерде емес.
Dialogue: 0,0:13:56.12,0:13:57.79,Top,,0000,0000,0000,,‎Адамның бұған құлшынысы жоқ.
Dialogue: 0,0:13:57.87,0:14:01.04,Bottom,,0000,0000,0000,,Оны тағы да сендіруге тырысқанның зияны жоқ.
Dialogue: 0,0:13:57.87,0:14:01.04,Top,,0000,0000,0000,,‎Егер мені көндірсеңіз, мен қайтып келуім мүмкін.
Dialogue: 0,0:14:01.13,0:14:03.00,Bottom,,0000,0000,0000,,Айтуға оңай...
Dialogue: 0,0:14:01.13,0:14:03.42,Top,,0000,0000,0000,,‎Бұл қарапайым... Ах...
Dialogue: 0,0:14:05.51,0:14:09.43,Top,,0000,0000,0000,,Сіз Милитехтің Арасаканы да нысанаға алғанын білесіз бе?
Dialogue: 0,0:14:06.01,0:14:09.43,Bottom,,0000,0000,0000,,Арасака Милитех олардың артынан жүргенін біледі, солай ма?
Dialogue: 0,0:14:09.51,0:14:11.01,Bottom,,0000,0000,0000,,Әрине.
Dialogue: 0,0:14:09.51,0:14:11.05,Top,,0000,0000,0000,,(Фарадей) Әрине.
Dialogue: 0,0:14:11.10,0:14:13.81,Bottom,,0000,0000,0000,,Милитех деген не, олар мұндай жамандықты қалайды?
Dialogue: 0,0:14:11.14,0:14:13.81,Top,,0000,0000,0000,,Милитех нені қатты қалайды?
Dialogue: 0,0:14:14.39,0:14:18.19,Bottom,,0000,0000,0000,,Бұл мені алаңдатады және сізді алаңдатпайды.
Dialogue: 0,0:14:14.47,0:14:18.19,Top,,0000,0000,0000,,Білудің қажеті жоқ, Білмегенің жақсы.
Dialogue: 0,0:14:18.77,0:14:20.94,Bottom,,0000,0000,0000,,Қажетсіз мәліметтер сіздің жолыңызға кедергі келтіреді.
Dialogue: 0,0:14:18.77,0:14:20.94,Top,,0000,0000,0000,,‎Қажетсіз ақпарат тек мазасыздану болып табылады
Dialogue: 0,0:14:21.77,0:14:23.69,Bottom,,0000,0000,0000,,Сізге көмектесетін жаңа нәрсені білдіңіз бе?
Dialogue: 0,0:14:21.81,0:14:23.69,Top,,0000,0000,0000,,Жаңа ақпарат бар ма?
Dialogue: 0,0:14:23.77,0:14:27.70,Bottom,,0000,0000,0000,,Әлі жоқ. Бірақ, «Жақсылық күткенге келеді» дегендей.
Dialogue: 0,0:14:23.77,0:14:27.70,Top,,0000,0000,0000,,Әлі жоқ, бірақ мүмкіндік міндетті түрде келеді.
Dialogue: 0,0:14:28.28,0:14:31.32,Bottom,,0000,0000,0000,,Бірақ сіз менің уақытыма лайық екеніңізді әлі дәлелдей алмайсыз.
Dialogue: 0,0:14:28.36,0:14:31.32,Top,,0000,0000,0000,,‎Одан бұрын күшіңізді көрсетіңіз
Dialogue: 0,0:14:41.75,0:14:42.59,Bottom,,0000,0000,0000,,Сіз үйдесіз.
Dialogue: 0,0:14:41.79,0:14:43.21,Top,,0000,0000,0000,,‎(Люси) Қайтадан қош келдіңіз
Dialogue: 0,0:14:46.17,0:14:47.76,Bottom,,0000,0000,0000,,Өте кеш.
Dialogue: 0,0:14:46.17,0:14:47.76,Top,,0000,0000,0000,,‎(Люси) Сіз кешігіп қалдыңыз.
Dialogue: 0,0:14:49.17,0:14:51.51,Bottom,,0000,0000,0000,,Түсіндім.
Dialogue: 0,0:14:49.17,0:14:51.55,Top,,0000,0000,0000,,Мен үйге ертерек баруды жоспарлап едім.
Dialogue: 0,0:14:51.59,0:14:53.43,Bottom,,0000,0000,0000,,Минджундікінде жеңісті айналым жасадыңыз ба?
Dialogue: 0,0:14:51.64,0:14:53.60,Top,,0000,0000,0000,,(Люси) Сен Мин Чонның дүкеніне тоқтадың, солай ма?
Dialogue: 0,0:14:53.51,0:14:54.43,Bottom,,0000,0000,0000,,Оқу, оқу
Dialogue: 0,0:14:53.68,0:14:56.06,Top,,0000,0000,0000,,‎Аа (Люси) Жұмысыңыз жақсы өтті ме?
Dialogue: 0,0:14:54.51,0:14:56.06,Bottom,,0000,0000,0000,,Жұмыста қандай да бір проблемалар бар ма?
Dialogue: 0,0:14:56.14,0:14:58.14,Bottom,,0000,0000,0000,,Біз бүгін түнде біреуді жоғалттық.
Dialogue: 0,0:14:56.14,0:14:58.18,Top,,0000,0000,0000,,‎Бір серігі өлтірілді.
Dialogue: 0,0:14:58.68,0:14:59.60,Top,,0000,0000,0000,,‎(Люси) Кім?
Dialogue: 0,0:14:58.68,0:14:59.98,Bottom,,0000,0000,0000,,Кім?
Dialogue: 0,0:15:00.06,0:15:02.35,Bottom,,0000,0000,0000,,Гринхорнның солосы Вакако бізді жіберді.
Dialogue: 0,0:15:00.10,0:15:02.35,Top,,0000,0000,0000,,‎Вакакодан секіру
Dialogue: 0,0:15:02.44,0:15:05.40,Bottom,,0000,0000,0000,,О. Бірақ бәрі жақсы болды, басқаша?
Dialogue: 0,0:15:02.44,0:15:05.52,Top,,0000,0000,0000,,(Люси) Не... Өтініш жақсы өтті, солай ма?
Dialogue: 0,0:15:05.48,0:15:08.40,Bottom,,0000,0000,0000,,Жеңіл. Жаңадан келген жігіт тапаншадан секірді.
Dialogue: 0,0:15:05.61,0:15:08.74,Top,,0000,0000,0000,,‎Бәрі жақсы, ол мұны істеді
Dialogue: 0,0:15:08.82,0:15:11.11,Top,,0000,0000,0000,,‎(Люси) ‎Сіз өзіңізді біраз бұрын көрдіңіз бе?
Dialogue: 0,0:15:08.90,0:15:11.20,Bottom,,0000,0000,0000,,Мен бұрыннан білетін басқа бір жаңадан келген адамға ұқсайды.
Dialogue: 0,0:15:11.20,0:15:12.16,Top,,0000,0000,0000,,Шулы
Dialogue: 0,0:15:11.28,0:15:12.36,Bottom,,0000,0000,0000,,Та-да!
Dialogue: 0,0:15:12.24,0:15:13.70,Top,,0000,0000,0000,,(Люси күлді)
Dialogue: 0,0:15:14.83,0:15:15.83,Bottom,,0000,0000,0000,,Сонымен…
Dialogue: 0,0:15:14.91,0:15:15.66,Top,,0000,0000,0000,,Сәлем
Dialogue: 0,0:15:15.74,0:15:16.70,Top,,0000,0000,0000,,‎Хмм?
Dialogue: 0,0:15:16.70,0:15:19.00,Bottom,,0000,0000,0000,,Бізде үлкен бір нәрсе келе жатыр.
Dialogue: 0,0:15:16.79,0:15:19.04,Top,,0000,0000,0000,,Мен үлкен жұмысқа орналасамын деп ойлаймын.
Dialogue: 0,0:15:19.08,0:15:20.62,Bottom,,0000,0000,0000,,Қандай қызық.
Dialogue: 0,0:15:19.12,0:15:20.21,Top,,0000,0000,0000,,Керемет
Dialogue: 0,0:15:20.71,0:15:24.17,Bottom,,0000,0000,0000,,Егер сіз бортқа мінсеңіз, бұл шынымен де көмектесер еді...
Dialogue: 0,0:15:20.83,0:15:24.21,Top,,0000,0000,0000,,Мүмкін болса... Люси де.
Dialogue: 0,0:15:24.25,0:15:27.38,Bottom,,0000,0000,0000,,Екі жүйрік тобырдың алдынан шығады, солай емес пе?
Dialogue: 0,0:15:24.29,0:15:27.34,Top,,0000,0000,0000,,Қазіргі командаға екі жүгіруші қажет емес, солай ма?
Dialogue: 0,0:15:27.42,0:15:30.34,Top,,0000,0000,0000,,‎Міне... Мен сені жақсы көремін
Dialogue: 0,0:15:27.46,0:15:30.47,Bottom,,0000,0000,0000,,Білесің бе, менің...
Dialogue: 0,0:15:30.42,0:15:31.80,Top,,0000,0000,0000,,Сәлем Дэвид
Dialogue: 0,0:15:30.55,0:15:31.80,Bottom,,0000,0000,0000,,Дэвид, өтінемін.
Dialogue: 0,0:15:33.01,0:15:34.51,Top,,0000,0000,0000,,Тағы біраз күтіңіз
Dialogue: 0,0:15:33.01,0:15:34.89,Bottom,,0000,0000,0000,,Маған көбірек уақыт керек.
Dialogue: 0,0:15:36.72,0:15:38.89,Bottom,,0000,0000,0000,,Жақсы. Жақсы.
Dialogue: 0,0:15:37.01,0:15:38.89,Top,,0000,0000,0000,,О, түсіндім.
Dialogue: 0,0:15:40.39,0:15:43.19,Top,,0000,0000,0000,,Бүгін сіз де суға түстіңіз бе? (Люси) Иә
Dialogue: 0,0:15:40.43,0:15:41.85,Bottom,,0000,0000,0000,,Сіз қайтадан суға түстіңіз бе?
Dialogue: 0,0:15:43.19,0:15:45.44,Bottom,,0000,0000,0000,,Неге жүгіру костюмін сатып алмайсыз?
Dialogue: 0,0:15:43.27,0:15:45.52,Top,,0000,0000,0000,,‎Жақсы жүгіруші костюмін сатып алуға қалай қарайсыз?
Dialogue: 0,0:15:45.52,0:15:46.86,Bottom,,0000,0000,0000,,Қажет емес.
Dialogue: 0,0:15:45.61,0:15:46.90,Top,,0000,0000,0000,,‎(Люси) Бұл маған керек емес.
Dialogue: 0,0:15:46.94,0:15:51.36,Bottom,,0000,0000,0000,,Біз сізге жаңа орындық алып береміз. Мұзды ванна ыңғайлы болуы мүмкін емес.
Dialogue: 0,0:15:46.98,0:15:48.73,Top,,0000,0000,0000,,‎Соңғы орындықтарды да сатып алайық
Dialogue: 0,0:15:48.82,0:15:51.40,Top,,0000,0000,0000,,Мұзды ваннадан әлдеқайда жақсы, солай ма?
Dialogue: 0,0:15:52.03,0:15:55.07,Bottom,,0000,0000,0000,,Рахмет. Бірақ мен костюм кигенді ұнатпаймын.
Dialogue: 0,0:15:52.07,0:15:55.62,Top,,0000,0000,0000,,(Люси) Рахмет, бірақ мен костюмдерді ұнатпаймын.
Dialogue: 0,0:15:55.70,0:15:58.58,Top,,0000,0000,0000,,Түсіндім, білмеймін, кешіріңіз.
Dialogue: 0,0:15:55.74,0:15:56.66,Bottom,,0000,0000,0000,,Ә... ә... білесің бе...
Dialogue: 0,0:15:56.74,0:15:58.70,Bottom,,0000,0000,0000,,Кешіріңіз, мен білмедім.
Dialogue: 0,0:16:00.70,0:16:01.54,Top,,0000,0000,0000,,‎Пухач
Dialogue: 0,0:16:03.25,0:16:04.83,Bottom,,0000,0000,0000,,Сәлем, Дэвид?
Dialogue: 0,0:16:03.33,0:16:04.96,Top,,0000,0000,0000,,‎(Люси) Сәлем Дэвид.
Dialogue: 0,0:16:05.04,0:16:05.67,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:06.25,0:16:07.13,Bottom,,0000,0000,0000,,Өтірік, жеккөру, құлдырау—әр күнді лақтыру
Dialogue: 0,0:16:06.38,0:16:07.00,Top,,0000,0000,0000,,Келіңіз
Dialogue: 0,0:16:08.50,0:16:09.13,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:14.76,0:16:17.26,Bottom,,0000,0000,0000,,Ой! Жұлдыздарға қараңдар!
Dialogue: 0,0:16:14.89,0:16:17.22,Top,,0000,0000,0000,,О, қандай тамаша жұлдыз!
Dialogue: 0,0:16:17.30,0:16:19.72,Top,,0000,0000,0000,,(Люси) Сіз оны Түнгі Ситиде ешқашан көре алмайсыз, солай ма?
Dialogue: 0,0:16:17.35,0:16:19.72,Bottom,,0000,0000,0000,,Қалада мұндай көріністі алу мүмкін емес.
Dialogue: 0,0:16:19.81,0:16:21.68,Top,,0000,0000,0000,,‎Haha Сіз оны ұстай аласыз ба?
Dialogue: 0,0:16:20.68,0:16:22.81,Bottom,,0000,0000,0000,,-Біреуін ұстай аламын деп ойлайсың ба? -Өйткендей.
Dialogue: 0,0:16:21.77,0:16:22.89,Top,,0000,0000,0000,,‎(Люси) Барса
Dialogue: 0,0:16:23.39,0:16:25.35,Bottom,,0000,0000,0000,,Айды көрсек екен.
Dialogue: 0,0:16:23.39,0:16:25.40,Top,,0000,0000,0000,,‎Мен де айды көргім келді~
Dialogue: 0,0:16:25.44,0:16:28.36,Bottom,,0000,0000,0000,,Ай шықпағандықтан жұлдыздар жарқырайды.
Dialogue: 0,0:16:25.48,0:16:28.40,Top,,0000,0000,0000,,Ай жоқ болғандықтан, Жұлдыздар әдемі көрінеді.
Dialogue: 0,0:16:28.44,0:16:29.53,Bottom,,0000,0000,0000,,Мен бір қолымда оқ жалғанған винтовка ұстап тұрмын
Dialogue: 0,0:16:28.48,0:16:29.57,Top,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:16:29.61,0:16:32.49,Bottom,,0000,0000,0000,,Ай жұлдыздардан асып түседі.
Dialogue: 0,0:16:29.65,0:16:34.82,Top,,0000,0000,0000,,‎Айдың жарықтығы жұлдыздарды жасырады. Академияда не үйрендіңіз?
Dialogue: 0,0:16:32.57,0:16:34.74,Bottom,,0000,0000,0000,,Олар сізге академияда не үйретті?
Dialogue: 0,0:16:34.82,0:16:36.45,Bottom,,0000,0000,0000,,Мен оқудан қалдым, есіңізде ме?
Dialogue: 0,0:16:34.91,0:16:36.57,Top,,0000,0000,0000,,Мен мектепті тастадым.
Dialogue: 0,0:16:36.53,0:16:38.08,Bottom,,0000,0000,0000,,Дұрыс, дұрыс.
Dialogue: 0,0:16:36.66,0:16:38.08,Top,,0000,0000,0000,,Бұл болды
Dialogue: 0,0:16:38.16,0:16:41.45,Top,,0000,0000,0000,,Түнгі қаладан бірінші рет шығуым.
Dialogue: 0,0:16:38.16,0:16:41.66,Bottom,,0000,0000,0000,,Қала сыртында ешқашан болған емес.
Dialogue: 0,0:16:42.08,0:16:43.08,Top,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:16:42.16,0:16:43.08,Bottom,,0000,0000,0000,,Иә.
Dialogue: 0,0:16:44.25,0:16:47.33,Bottom,,0000,0000,0000,,Бір кездері қала сыртында өмір сүрдіңіз бе?
Dialogue: 0,0:16:44.25,0:16:47.33,Top,,0000,0000,0000,,Сіз тек Түнгі қалада емессіз.
Dialogue: 0,0:16:50.50,0:16:54.72,Bottom,,0000,0000,0000,,Қала осы жерден жарықтан жасалған торға ұқсайды.
Dialogue: 0,0:16:50.63,0:16:52.67,Top,,0000,0000,0000,,(Люси) Түнгі қала осы жерден көрінеді
Dialogue: 0,0:16:52.76,0:16:54.55,Top,,0000,0000,0000,,Жарық түрмесі сияқты
Dialogue: 0,0:16:57.68,0:16:59.10,Bottom,,0000,0000,0000,,Есіңізде болмауы мүмкін…
Dialogue: 0,0:16:57.80,0:17:00.43,Top,,0000,0000,0000,,Бұрын... (Люси) Иә.
Dialogue: 0,0:17:01.06,0:17:03.98,Bottom,,0000,0000,0000,,Сіз екеуміз басқамыз дедіңіздер.
Dialogue: 0,0:17:01.10,0:17:04.10,Top,,0000,0000,0000,,Мен сен екеуміз басқамыз дедім ғой, солай ма?
Dialogue: 0,0:17:04.77,0:17:05.60,Bottom,,0000,0000,0000,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:17:04.89,0:17:08.48,Top,,0000,0000,0000,,(Люси) Иә, бұл нені білдіреді?
Dialogue: 0,0:17:06.15,0:17:08.27,Bottom,,0000,0000,0000,,Мұнымен не айтқың келді?
Dialogue: 0,0:17:10.82,0:17:12.28,Bottom,,0000,0000,0000,,Бұл туралы айтқыңыз келмейді ме?
Dialogue: 0,0:17:10.98,0:17:12.23,Top,,0000,0000,0000,,Айтқыңыз келмей ме?
Dialogue: 0,0:17:14.86,0:17:16.41,Bottom,,0000,0000,0000,,Сіз естімегеніңіз жөн.
Dialogue: 0,0:17:14.95,0:17:16.36,Top,,0000,0000,0000,,‎(Люси) Оны естігіңіз келе ме?
Dialogue: 0,0:17:16.45,0:17:19.74,Top,,0000,0000,0000,,‎Мен сіз туралы көбірек білгім келеді.
Dialogue: 0,0:17:16.49,0:17:19.74,Bottom,,0000,0000,0000,,Мен жай ғана... сен туралы көбірек білгім келеді.
Dialogue: 0,0:17:22.24,0:17:23.29,Top,,0000,0000,0000,,‎(терең тыныс)
Dialogue: 0,0:17:23.83,0:17:26.50,Top,,0000,0000,0000,,(Люси) ‎Арасака ‎‎Арасака?
Dialogue: 0,0:17:24.33,0:17:25.50,Bottom,,0000,0000,0000,,Арасака.
Dialogue: 0,0:17:25.58,0:17:26.62,Bottom,,0000,0000,0000,,Арасака?
Dialogue: 0,0:17:26.58,0:17:32.00,Top,,0000,0000,0000,,(Люси) Иә, мен бала кезімде басқа елдегі Арасакадағы мекемеде болдым.
Dialogue: 0,0:17:26.71,0:17:27.88,Bottom,,0000,0000,0000,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:17:27.96,0:17:32.00,Bottom,,0000,0000,0000,,Мен басқа елде туып, Арасакадағы мекемеде өстім.
Dialogue: 0,0:17:32.80,0:17:38.51,Bottom,,0000,0000,0000,,Мені қосқанда 13 бала нетруннер болу үшін біліктілік сынағынан өтті.
Dialogue: 0,0:17:32.88,0:17:36.84,Top,,0000,0000,0000,,Мен де нысанға қосылдым. Мен жүгірушіге қабілеттілік сынағынан өттім.
Dialogue: 0,0:17:36.93,0:17:38.51,Top,,0000,0000,0000,,‎13 бала
Dialogue: 0,0:17:39.43,0:17:42.26,Bottom,,0000,0000,0000,,Жоғалып кетсе, сағынбайтын балалар.
Dialogue: 0,0:17:39.51,0:17:41.47,Top,,0000,0000,0000,,‎Олардың бәрі туыстарсыз болды.
Dialogue: 0,0:17:42.35,0:17:45.93,Bottom,,0000,0000,0000,,«Біз бір күні әлемдегі ең қуатты мегакорпқа қызмет көрсетеміз...»
Dialogue: 0,0:17:42.35,0:17:45.93,Top,,0000,0000,0000,,Сіз әлемдегі ең жақсы компанияның желісін құрушы бола аласыз.
Dialogue: 0,0:17:46.02,0:17:47.73,Top,,0000,0000,0000,,‎Себебі менде сондай үміт болды
Dialogue: 0,0:17:46.02,0:17:50.73,Bottom,,0000,0000,0000,,Сол арман бізді жаттығудың қиын күндерінен өткізді.
Dialogue: 0,0:17:47.81,0:17:50.77,Top,,0000,0000,0000,,Ол ауыр жаттығуларға төтеп бере алған болуы мүмкін.
Dialogue: 0,0:17:51.36,0:17:55.82,Top,,0000,0000,0000,,‎Біз табиғи түрде өзіміз таңдамаған армандарға ұмтылдық.
Dialogue: 0,0:17:51.36,0:17:55.86,Bottom,,0000,0000,0000,,Бұл бізге берілген арман, біз ешқашан күмәнданбаған арман.
Dialogue: 0,0:17:56.86,0:18:01.87,Bottom,,0000,0000,0000,,Бірақ оқу аяқталғанда, бізді корпус кеңсесіне тағайындамады.
Dialogue: 0,0:17:56.90,0:17:59.78,Top,,0000,0000,0000,,Біз жаттығуды аяқтаған соң, бізді алып кетті.
Dialogue: 0,0:17:59.87,0:18:02.28,Top,,0000,0000,0000,,Бұл Корпоның кеңсесі емес еді.
Dialogue: 0,0:18:02.66,0:18:08.00,Bottom,,0000,0000,0000,,Бізді үнемі суға түсуге мәжбүрлейтін жер асты мекемесіне апарды...
Dialogue: 0,0:18:02.79,0:18:07.33,Top,,0000,0000,0000,,Қараңғы жер асты қондырғысы сонда сүңгуге мәжбүр болды
Dialogue: 0,0:18:08.08,0:18:12.21,Bottom,,0000,0000,0000,,Олар бізді ескі желіге жіберді.
Dialogue: 0,0:18:08.17,0:18:11.75,Top,,0000,0000,0000,,Біз Oldnet-ке бет алдық.
Dialogue: 0,0:18:12.29,0:18:14.25,Bottom,,0000,0000,0000,,Ескі желі?
Dialogue: 0,0:18:12.29,0:18:14.96,Top,,0000,0000,0000,,Мен бұл Oldnet екеніне сенімдімін.
Dialogue: 0,0:18:14.34,0:18:18.68,Bottom,,0000,0000,0000,,Бұл шамамен 50 жыл бұрын құлаған ескі интернет домені, солай емес пе?
Dialogue: 0,0:18:15.05,0:18:18.72,Top,,0000,0000,0000,,Бұл жарты ғасыр бұрын құлаған ескі интернет аймағы, солай ма?
Dialogue: 0,0:18:18.76,0:18:19.59,Bottom,,0000,0000,0000,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:18:18.80,0:18:22.72,Top,,0000,0000,0000,,Иә, барлық уақыттағы ең ұлы жүгіруші және жындардың жаратушысы.
Dialogue: 0,0:18:19.68,0:18:22.72,Bottom,,0000,0000,0000,,Тарихтағы ең үлкен желі қолданушысы, демондарды жасаушы…
Dialogue: 0,0:18:22.81,0:18:24.56,Top,,0000,0000,0000,,‎Хакерліктің негізін салушы
Dialogue: 0,0:18:22.81,0:18:27.02,Bottom,,0000,0000,0000,,Хакер-савант, аңыз, Рэйч Бартмос.
Dialogue: 0,0:18:24.64,0:18:27.14,Top,,0000,0000,0000,,Легенда ‎Лэйси Бартмос
Dialogue: 0,0:18:27.10,0:18:32.73,Bottom,,0000,0000,0000,,Дүниежүзілік желінің 78 пайызын жойған жігіт.
Dialogue: 0,0:18:27.23,0:18:30.56,Top,,0000,0000,0000,,Дүниежүзілік желінің 78% күйреді
Dialogue: 0,0:18:30.65,0:18:32.73,Top,,0000,0000,0000,,Аты аңызға айналған қылмыскер...
Dialogue: 0,0:18:32.82,0:18:35.19,Top,,0000,0000,0000,,(Люси) Оның деректердің бұзылуы вирусы
Dialogue: 0,0:18:32.82,0:18:37.36,Bottom,,0000,0000,0000,,Оның DataKrash вирусы киберкеңістікті бұзды…
Dialogue: 0,0:18:35.28,0:18:37.44,Top,,0000,0000,0000,,Киберкеңістікті ажырату
Dialogue: 0,0:18:37.44,0:18:43.58,Bottom,,0000,0000,0000,,…Жетті оқшауланған жергілікті желілердің шашыраңқы мозаикасына айналдырды.
Dialogue: 0,0:18:37.53,0:18:41.24,Top,,0000,0000,0000,,‎Интернетке тек шектеулі шеңберде қол жеткізуге болады——
Dialogue: 0,0:18:41.32,0:18:43.91,Top,,0000,0000,0000,,Өте шағын жергілікті желіге ауыстырылды
Dialogue: 0,0:18:44.54,0:18:46.29,Top,,0000,0000,0000,,‎Арасаканың мақсаты
Dialogue: 0,0:18:44.58,0:18:49.21,Bottom,,0000,0000,0000,,Арасаканың мақсаты Ескі торда болды. Өткеннің мұралары.
Dialogue: 0,0:18:46.37,0:18:49.29,Top,,0000,0000,0000,,‎Олднетте секвестрленген ‎Өткеннің реликті
Dialogue: 0,0:18:49.29,0:18:51.54,Bottom,,0000,0000,0000,,Жоғалған білімнің үлкен көлемі.
Dialogue: 0,0:18:49.37,0:18:51.71,Top,,0000,0000,0000,,Үлкен білім мен ақпарат
Dialogue: 0,0:18:51.63,0:18:57.17,Bottom,,0000,0000,0000,,Біз заңсыз зиянды бағдарламалар мен агрессивті AI ұясына жіберілген сарбаздар едік.
Dialogue: 0,0:18:51.79,0:18:53.04,Top,,0000,0000,0000,,Біз
Dialogue: 0,0:18:53.13,0:18:57.46,Top,,0000,0000,0000,,Мен заңсыз зиянды бағдарламалар мен жаман AI ұясына жіберілген сарбаз болдым.
Dialogue: 0,0:18:58.09,0:19:02.18,Bottom,,0000,0000,0000,,Жетілдірілген нетруннерлер оған бүкіл ақыл-ойымен сүңги алады.
Dialogue: 0,0:18:58.26,0:19:02.14,Top,,0000,0000,0000,,Жетілдірілген нетруннерлер ол жерде ақыл-ойымен сүңги алады.
Dialogue: 0,0:19:02.22,0:19:03.72,Top,,0000,0000,0000,,‎‎Терең сүңгу
Dialogue: 0,0:19:02.26,0:19:03.68,Bottom,,0000,0000,0000,,Сіз терең сүңгуді айтасыз.
Dialogue: 0,0:19:03.76,0:19:06.77,Bottom,,0000,0000,0000,,Ал дайвинг киберкеңістікті өтуге болатын әлемге айналдырады.
Dialogue: 0,0:19:03.80,0:19:06.77,Top,,0000,0000,0000,,‎(Люси) ‎Сүңгуір арқылы көрінетін киберкеңістік
Dialogue: 0,0:19:06.85,0:19:11.31,Bottom,,0000,0000,0000,,Бірақ біз кез келген сирек деректер кэшін тапқан кезде…
Dialogue: 0,0:19:06.85,0:19:11.31,Top,,0000,0000,0000,,Ескі желіде сирек деректерді тапсаңыз...
Dialogue: 0,0:19:12.73,0:19:13.94,Top,,0000,0000,0000,,‎(Люси) Иә?
Dialogue: 0,0:19:15.27,0:19:19.15,Bottom,,0000,0000,0000,,Жалған AI бізді тауып, шабуыл жасайды.
Dialogue: 0,0:19:15.36,0:19:19.15,Top,,0000,0000,0000,,(Люси) Қауіпті AI бізді тауып алды да, бізге шабуыл жасады.
Dialogue: 0,0:19:19.90,0:19:22.66,Bottom,,0000,0000,0000,,Бізді бірінен соң бірі таңдап алды.
Dialogue: 0,0:19:19.99,0:19:22.66,Top,,0000,0000,0000,,‎Ескі желіден ‎Үйге бара алмайтын балалар жалғастырады
Dialogue: 0,0:19:23.62,0:19:27.91,Bottom,,0000,0000,0000,,Әр жолы соңғысы болар деп, сүңгуді жалғастырдым.
Dialogue: 0,0:19:23.70,0:19:27.91,Top,,0000,0000,0000,,Келесі менің кезегім болуы мүмкін. Мен осы оймен суға түстім.
Dialogue: 0,0:19:28.54,0:19:31.96,Top,,0000,0000,0000,,Көп ұзамай біз бір жағадан бас шығардық.
Dialogue: 0,0:19:28.62,0:19:31.96,Bottom,,0000,0000,0000,,Көп ұзамай санаулы ғана адам қалды.
Dialogue: 0,0:19:32.67,0:19:37.09,Bottom,,0000,0000,0000,,Бізді біреудің арманымен өмір сүру үшін өлтірді.
Dialogue: 0,0:19:32.67,0:19:37.17,Top,,0000,0000,0000,,Басқалардың маған берген армандары жақсы болмады.
Dialogue: 0,0:19:37.17,0:19:41.68,Bottom,,0000,0000,0000,,«Егер біз өлетін болсақ, қашып құтыламыз деп неге өлмеске?» деп ойладық.
Dialogue: 0,0:19:37.25,0:19:41.34,Top,,0000,0000,0000,,Сонымен, бәрібір өлетін болсақ, бәріміз қашуды шештік.
Dialogue: 0,0:19:42.76,0:19:43.39,Top,,0000,0000,0000,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:19:43.34,0:19:47.43,Bottom,,0000,0000,0000,,Техникалық қызметкерлердің мүмкіндігі болмады. Олар бізге үйреткен дағдыларға қарсы емес.
Dialogue: 0,0:19:43.39,0:19:47.43,Top,,0000,0000,0000,,Біз өскен күшімізді ересектерді өлтіру үшін пайдаландық——
Dialogue: 0,0:19:48.14,0:19:49.47,Bottom,,0000,0000,0000,,Біз қашып кеттік.
Dialogue: 0,0:19:48.22,0:19:49.35,Top,,0000,0000,0000,,Қашу
Dialogue: 0,0:19:51.02,0:19:53.44,Top,,0000,0000,0000,,‎(Балалар қатты тыныс алады)
Dialogue: 0,0:19:54.73,0:19:56.69,Top,,0000,0000,0000,,‎(мылтық ату) ‎(қыздың айқайы)
Dialogue: 0,0:19:57.32,0:19:58.44,Top,,0000,0000,0000,,‎(мылтық ату) ‎(баланың айқайы)
Dialogue: 0,0:19:58.53,0:19:59.15,Top,,0000,0000,0000,,(Люси) Мен бәрібір жүгірдім.
Dialogue: 0,0:19:58.53,0:20:00.44,Bottom,,0000,0000,0000,,Мен жүгіре бердім.
Dialogue: 0,0:19:59.15,0:20:00.07,Top,,0000,0000,0000,,(Люси) Мен бәрібір жүгірдім (мылтық)
Dialogue: 0,0:20:00.07,0:20:00.53,Top,,0000,0000,0000,,(Люси) Мен бәрібір жүгірдім.
Dialogue: 0,0:20:00.53,0:20:03.11,Bottom,,0000,0000,0000,,Мен достарымның айқайлағанын естідім,
Dialogue: 0,0:20:00.61,0:20:02.03,Top,,0000,0000,0000,,Мен біреудің жылағанын естідім, бірақ бұрылмадым.
Dialogue: 0,0:20:02.03,0:20:04.78,Top,,0000,0000,0000,,Мен біреудің жылағанын естідім, бірақ бұрылмадым.
Dialogue: 0,0:20:03.20,0:20:05.07,Bottom,,0000,0000,0000,,бірақ мен артыма қарамадым.
Dialogue: 0,0:20:09.16,0:20:11.50,Top,,0000,0000,0000,,‎(Люси) Ах... аа...
Dialogue: 0,0:20:13.04,0:20:16.63,Top,,0000,0000,0000,,(Люси) Мен мұны білмей тұрып, мен қоқыста өмір сүрдім.
Dialogue: 0,0:20:13.04,0:20:17.00,Bottom,,0000,0000,0000,,Өзіме келсем, қоқысханада тұрып жатырмын.
Dialogue: 0,0:20:17.54,0:20:21.34,Bottom,,0000,0000,0000,,Осыдан кейін мен бір орында тұруға қатты қорықтым.
Dialogue: 0,0:20:17.54,0:20:21.38,Top,,0000,0000,0000,,Осыдан кейін мен бір орында қалудан қорықтым.
Dialogue: 0,0:20:21.42,0:20:23.51,Bottom,,0000,0000,0000,,Сонымен мен әртүрлі қалаларды араладым.
Dialogue: 0,0:20:21.47,0:20:23.13,Top,,0000,0000,0000,,Мен көп жерге бардым
Dialogue: 0,0:20:25.89,0:20:29.47,Bottom,,0000,0000,0000,,Бірақ егер сіз жасырғыңыз келсе, Түнгі қала сияқты жер жоқ.
Dialogue: 0,0:20:25.93,0:20:29.47,Top,,0000,0000,0000,,Түнгі қала - жасырынуға өте жақсы орын.
Dialogue: 0,0:20:29.56,0:20:32.48,Bottom,,0000,0000,0000,,Сіз әлі де сізді қуып бара жатқандай сезінесіз бе?
Dialogue: 0,0:20:29.56,0:20:32.48,Top,,0000,0000,0000,,‎Сізді әлі де аңдып жатқандай сезінесіз бе?
Dialogue: 0,0:20:33.10,0:20:34.69,Top,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:20:33.10,0:20:37.23,Bottom,,0000,0000,0000,,Шын мәнінде емес. Мен мұнда тым ыңғайлы болдым деп ойлаймын.
Dialogue: 0,0:20:35.27,0:20:39.98,Top,,0000,0000,0000,,Түнгі қаланың жайлылығы сонша, бәлкім, менің қорқынышым мені сал етті.
Dialogue: 0,0:20:37.81,0:20:40.40,Bottom,,0000,0000,0000,,Әлде мен қорқып үйренген шығармын.
Dialogue: 0,0:20:40.69,0:20:42.15,Top,,0000,0000,0000,,‎Хмм... Ах.
Dialogue: 0,0:20:42.24,0:20:43.57,Top,,0000,0000,0000,,‎(Люси) Сол қол...
Dialogue: 0,0:20:42.28,0:20:43.57,Bottom,,0000,0000,0000,,Сол қол…
Dialogue: 0,0:20:43.65,0:20:46.24,Bottom,,0000,0000,0000,,Бұл ештеңе емес. Бір секундта бәрі жақсы болады.
Dialogue: 0,0:20:43.65,0:20:46.24,Top,,0000,0000,0000,,‎Жарайды, тез арада жақсарады.
Dialogue: 0,0:20:47.07,0:20:51.12,Bottom,,0000,0000,0000,,Сіз мүлде өзгерген жоқсыз. Әлі де біреудің арманы үшін өмір сүру.
Dialogue: 0,0:20:47.12,0:20:51.12,Top,,0000,0000,0000,,‎Ол өзгерген жоқ. Мен тағы біреудің арманының ауыртпалығымен өмір сүріп жатырмын.
Dialogue: 0,0:20:54.33,0:20:55.25,Top,,0000,0000,0000,,А...
Dialogue: 0,0:20:55.83,0:20:58.04,Bottom,,0000,0000,0000,,Мен түсінбейтін сияқтымын.
Dialogue: 0,0:20:55.83,0:20:59.38,Top,,0000,0000,0000,,(Люси) Сенің сезіміңді түсінемін, бірақ иә.
Dialogue: 0,0:21:00.59,0:21:05.26,Bottom,,0000,0000,0000,,Мен енді өзім үшін қорықпаймын деп ойлаймын.
Dialogue: 0,0:21:00.59,0:21:05.26,Top,,0000,0000,0000,,‎Мүмкін мен енді өзімнен қорықпайтын шығармын.
Dialogue: 0,0:21:06.01,0:21:07.39,Bottom,,0000,0000,0000,,Мен одан қорқамын...
Dialogue: 0,0:21:06.09,0:21:08.89,Top,,0000,0000,0000,,‎Мен қазір қорқатыным сенсің...
Dialogue: 0,0:21:07.47,0:21:08.89,Bottom,,0000,0000,0000,,Бір күні сіз…
Dialogue: 0,0:21:14.89,0:21:15.81,Top,,0000,0000,0000,,Фу
Dialogue: 0,0:21:16.85,0:21:17.69,Top,,0000,0000,0000,,А...
Dialogue: 0,0:21:18.44,0:21:20.32,Top,,0000,0000,0000,,‎(Holo Communication: Jamie) ‎Иә, деректердің көпшілігі
Dialogue: 0,0:21:18.48,0:21:21.69,Bottom,,0000,0000,0000,,Иә. Мен деректердің көп бөлігін қалпына келтіре алдым.
Dialogue: 0,0:21:20.40,0:21:21.82,Top,,0000,0000,0000,,Қалпына келтіру мүмкін
Dialogue: 0,0:21:21.78,0:21:25.03,Bottom,,0000,0000,0000,,Сынақ субъектілерінің бірі туралы ақпарат
Dialogue: 0,0:21:21.90,0:21:25.11,Top,,0000,0000,0000,,Дегенмен, мысалда өнімнің тақырыбы деректері
Dialogue: 0,0:21:25.11,0:21:29.16,Bottom,,0000,0000,0000,,толығымен бүлінген сияқты.
Dialogue: 0,0:21:25.20,0:21:28.95,Top,,0000,0000,0000,,‎Кейбір заттар қатты зақымдалған және әлі де...
Dialogue: 0,0:21:29.87,0:21:32.74,Bottom,,0000,0000,0000,,Әдейі қолдан жасалған деп айтар едім.
Dialogue: 0,0:21:29.95,0:21:32.41,Top,,0000,0000,0000,,Әдейі жойылған болуы мүмкін
Dialogue: 0,0:21:32.83,0:21:34.29,Bottom,,0000,0000,0000,,ICE-де із жоқ.
Dialogue: 0,0:21:32.91,0:21:34.41,Top,,0000,0000,0000,,ICE-де із жоқ
Dialogue: 0,0:21:34.37,0:21:37.67,Bottom,,0000,0000,0000,,Бұл бұзуды қарапайым жүгіруші жасай алмайды.
Dialogue: 0,0:21:34.50,0:21:37.54,Top,,0000,0000,0000,,Тәжірибелі торға жүйріктердің қатысуы сөзсіз.
Dialogue: 0,0:21:39.88,0:21:42.17,Bottom,,0000,0000,0000,,Мен Танаканың оны өшіретініне сенбеймін.
Dialogue: 0,0:21:40.00,0:21:42.25,Top,,0000,0000,0000,,‎Танаканың оны жоюына ешқандай себеп жоқ.
Dialogue: 0,0:21:42.25,0:21:46.09,Bottom,,0000,0000,0000,,Сондықтан оны тұтқындау кезінде қолдан жасалған болуы керек.
Dialogue: 0,0:21:42.34,0:21:46.05,Top,,0000,0000,0000,,Ұрланғанда жойылып кетер еді деп ойлаудың өзі заңдылық еді.
Dialogue: 0,0:21:47.01,0:21:51.01,Bottom,,0000,0000,0000,,Түсінді. Мен оны қалпына келтіру үшін не істей алатынымды көремін.
Dialogue: 0,0:21:47.09,0:21:47.80,Top,,0000,0000,0000,,‎Иә Сақтық көшірмеден қалпына келтіру әрекеті
Dialogue: 0,0:21:47.80,0:21:50.68,Top,,0000,0000,0000,,Иә, сақтық көшірмеден қалпына келтіру әрекеті (аяқ дыбыстары)
Dialogue: 0,0:21:50.68,0:21:51.18,Top,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:21:51.10,0:21:52.22,Bottom,,0000,0000,0000,,Қош бол.
Dialogue: 0,0:21:51.18,0:21:52.22,Top,,0000,0000,0000,,‎In
Dialogue: 0,0:22:03.57,0:22:05.24,Top,,0000,0000,0000,,‎(шу дыбысы)
Dialogue: 0,0:22:06.82,0:22:08.45,Top,,0000,0000,0000,,‎(Джейми) Арг!
Dialogue: 0,0:22:10.53,0:22:11.91,Top,,0000,0000,0000,,‎Grrrr…
Dialogue: 0,0:22:13.58,0:22:14.20,Top,,0000,0000,0000,,Көкек!
Dialogue: 0,0:22:15.04,0:22:17.25,Top,,0000,0000,0000,,‎Ааа!
Dialogue: 0,0:22:33.51,0:22:38.52,Top,,0000,0000,0000,,♪~
Dialogue: 0,0:23:58.52,0:24:03.52,Top,,0000,0000,0000,,~♪
