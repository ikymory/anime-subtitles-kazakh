Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.46,0:00:08.71,Top,,0000,0000,0000,,‎NETFLIX аниме сериясы
Dialogue: 0,0:00:13.51,0:00:16.51,Top,,0000,0000,0000,,‎(Жаңбыр дыбысы)
Dialogue: 0,0:00:39.99,0:00:42.66,Top,,0000,0000,0000,,(Holo News: Полиция қызметкері A) Сіз де твиттерде мүлдем жазбағансыз.
Dialogue: 0,0:00:40.08,0:00:45.71,Bottom,,0000,0000,0000,,Аға, мен сені бестен кейін жұмыстан шығасың деп ойладым ба? Олар сізді әлі де шақырды ма? Қатты сәттілік.
Dialogue: 0,0:00:42.75,0:00:45.71,Top,,0000,0000,0000,,5 минуттан кейін кетуім керек болғанда, мені сыртқа шығарып жіберді.
Dialogue: 0,0:00:45.79,0:00:48.00,Top,,0000,0000,0000,,(Полиция қызметкері В) Егер сіз төсбелгіңізді қоюға дайын болсаңыз.
Dialogue: 0,0:00:46.29,0:00:50.25,Bottom,,0000,0000,0000,,Кап үйге барғым келсе, мылтығым мен бейджімді қалдыра алатынымды айтты
Dialogue: 0,0:00:48.08,0:00:52.34,Top,,0000,0000,0000,,Лас төсекке тез секіріп, анамның бүгін сатып алған пошталық тапсырысы туралы сөйлесіңіз.
Dialogue: 0,0:00:50.34,0:00:55.09,Bottom,,0000,0000,0000,,және анамның онлайн-сатып алу немесе кез келген нәрсе туралы әрі қарай жалғастыруын тыңдаңыз.
Dialogue: 0,0:00:52.42,0:00:55.09,Top,,0000,0000,0000,,Сіз оны тыңдап жатып ұйықтайсыз. Сіз мені қорқытып жатырсыз.
Dialogue: 0,0:00:55.18,0:00:58.01,Bottom,,0000,0000,0000,,Полицияның өмірін таңдағаныңыз үшін сізге осындай нәрсе беріледі.
Dialogue: 0,0:00:55.18,0:00:58.05,Top,,0000,0000,0000,,(Полиция қызметкері А) Бұл адам өзін заңның күзетшісі сияқты ұстайды.
Dialogue: 0,0:00:58.09,0:00:59.93,Bottom,,0000,0000,0000,,Жаңбыр жаууы керек еді...
Dialogue: 0,0:00:58.14,0:00:59.89,Top,,0000,0000,0000,,(Полиция қызметкері В) Мен жаңбырды жек көремін.
Dialogue: 0,0:01:00.64,0:01:03.10,Top,,0000,0000,0000,,(Полиция қызметкері В) Иә? Эй, не болып жатыр, сен кет
Dialogue: 0,0:01:01.10,0:01:03.10,Bottom,,0000,0000,0000,,Сіздің проблемаңыз неде? Сақтық көшірме жасаңыз.
Dialogue: 0,0:01:03.18,0:01:04.48,Bottom,,0000,0000,0000,,Оқ алғым келеді...
Dialogue: 0,0:01:03.18,0:01:04.48,Top,,0000,0000,0000,,Мен өлтіргім келеді... Иә?
Dialogue: 0,0:01:04.56,0:01:05.23,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:01:19.78,0:01:21.20,Top,,0000,0000,0000,,‎(оқ ату)
Dialogue: 0,0:01:30.79,0:01:31.67,Top,,0000,0000,0000,,‎(Жарылыс дыбысы)
Dialogue: 0,0:01:31.75,0:01:33.17,Bottom,,0000,0000,0000,,Киберпсихо болды!
Dialogue: 0,0:01:31.75,0:01:35.55,Top,,0000,0000,0000,,(Полиция қызметкері) Киберпсихоз! (Полиция қызметкері) MaxTac-қа қоңырау шалыңыз!
Dialogue: 0,0:01:33.84,0:01:35.92,Bottom,,0000,0000,0000,,MaxTac-ты қазір көтеріңіз!
Dialogue: 0,0:01:36.51,0:01:37.13,Top,,0000,0000,0000,,Уау!
Dialogue: 0,0:01:48.44,0:01:50.73,Top,,0000,0000,0000,,Уау!
Dialogue: 0,0:01:59.70,0:02:00.32,Top,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:06.54,0:02:08.37,Top,,0000,0000,0000,,‎(Имплантты белсендіру дыбысы)
Dialogue: 0,0:02:13.84,0:02:15.96,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:02:20.80,0:02:23.22,Top,,0000,0000,0000,,(AV ұшу дыбысы)
Dialogue: 0,0:02:23.30,0:02:24.14,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:02:31.23,0:02:32.98,Bottom,,0000,0000,0000,,Оның жүйесін қуырыңыз.
Dialogue: 0,0:02:31.23,0:02:32.98,Top,,0000,0000,0000,,(Капитан MaxTac) Оның қызып кетуіне жол беріңіз.
Dialogue: 0,0:02:33.06,0:02:34.94,Bottom,,0000,0000,0000,,Фрейкте әскери дәрежелі ICE бар!
Dialogue: 0,0:02:33.06,0:02:34.98,Top,,0000,0000,0000,,(MaxTac мүшесі) Әскери деңгейдегі ICE пайдалану
Dialogue: 0,0:02:35.02,0:02:36.86,Bottom,,0000,0000,0000,,Біздікі де солай.
Dialogue: 0,0:02:35.07,0:02:37.82,Top,,0000,0000,0000,,Бұл әскери мақсатта қолданылуы мүмкін, бірақ бұл шығу.
Dialogue: 0,0:02:36.94,0:02:37.82,Bottom,,0000,0000,0000,,Бар!
Dialogue: 0,0:02:53.00,0:02:55.00,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:03:10.52,0:03:11.60,Top,,0000,0000,0000,,(Дыбыс жүктелуде)
Dialogue: 0,0:03:12.56,0:03:13.40,Top,,0000,0000,0000,,‎(мылтық дыбысы)
Dialogue: 0,0:03:13.48,0:03:15.57,Top,,0000,0000,0000,,(Дэвид Мартинес) Ааа!
Dialogue: 0,0:03:15.65,0:03:17.23,Top,,0000,0000,0000,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:03:17.32,0:03:20.90,Top,,0000,0000,0000,,‎Уаааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:03:20.99,0:03:23.41,Top,,0000,0000,0000,,(Holo News: Reperdoc) Haa~ Қалай?
Dialogue: 0,0:03:23.49,0:03:27.08,Top,,0000,0000,0000,,‎2 сағат бұрын жаңа өлген жүгірушінің миынан——
Dialogue: 0,0:03:27.16,0:03:29.29,Top,,0000,0000,0000,,Мен шығарып алған шикі естелік.
Dialogue: 0,0:03:29.29,0:03:30.75,Bottom,,0000,0000,0000,,​​Өте ақымақ!
Dialogue: 0,0:03:29.37,0:03:30.75,Top,,0000,0000,0000,,‎Тамаша!
Dialogue: 0,0:03:30.83,0:03:34.04,Top,,0000,0000,0000,,‎Doc! Менде өте қауіпті BD (Bee Dee) бар
Dialogue: 0,0:03:34.13,0:03:36.21,Top,,0000,0000,0000,,(Липердоку) фухахахаха бұл таңқаларлық
Dialogue: 0,0:03:36.29,0:03:39.34,Top,,0000,0000,0000,,Бұл ми биін Дж.К. өңдеген.
Dialogue: 0,0:03:39.42,0:03:41.22,Top,,0000,0000,0000,,Өйткені, ол реттелмеген.
Dialogue: 0,0:03:41.30,0:03:44.76,Top,,0000,0000,0000,,‎Ааа! ‎Менің миым қатты қышиды, құсқым келеді~
Dialogue: 0,0:03:44.84,0:03:48.10,Top,,0000,0000,0000,,(Reperdoc) Жақсы, толық киберпсихоз жігіт.
Dialogue: 0,0:03:48.18,0:03:51.60,Top,,0000,0000,0000,,Бұл менің басымда болды. Кез келген адам осындай болар еді.
Dialogue: 0,0:03:51.68,0:03:54.23,Top,,0000,0000,0000,,Жарайды, мен құсуды бастамас бұрын келесі BD аламын.
Dialogue: 0,0:03:54.31,0:03:55.77,Top,,0000,0000,0000,,Келесі не болады?
Dialogue: 0,0:03:55.86,0:03:58.02,Top,,0000,0000,0000,,(Reperdoc) Арнайы
Dialogue: 0,0:03:58.52,0:03:59.65,Top,,0000,0000,0000,,‎(Қуыршақтың дем алған дауысы)
Dialogue: 0,0:03:59.65,0:04:01.78,Bottom,,0000,0000,0000,,Не?! Қиып ал, жігіт!
Dialogue: 0,0:03:59.73,0:04:01.78,Top,,0000,0000,0000,,Иә? Жылдам көзқарас
Dialogue: 0,0:04:03.53,0:04:06.53,Top,,0000,0000,0000,,‎(Кір жуғыш машинаның жұмыс дыбысы)
Dialogue: 0,0:04:09.41,0:04:11.04,Top,,0000,0000,0000,,(күрсіну)
Dialogue: 0,0:04:11.96,0:04:13.71,Top,,0000,0000,0000,,(Кір жуғыш машина тоқтайды) (Ескерту дыбысы)
Dialogue: 0,0:04:13.79,0:04:14.58,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:15.54,0:04:18.34,Top,,0000,0000,0000,,(Кір жуғыш машина AI) Теңгерім жеткіліксіз болғандықтан кептіру тоқтатылды.
Dialogue: 0,0:04:15.54,0:04:18.38,Bottom,,0000,0000,0000,,Қаражаттың жеткіліксіздігіне байланысты цикл тоқтатылды…
Dialogue: 0,0:04:18.42,0:04:21.01,Top,,0000,0000,0000,,Мама, тағы кездескенше?
Dialogue: 0,0:04:18.46,0:04:21.01,Bottom,,0000,0000,0000,,Қайта емес...
Dialogue: 0,0:04:21.55,0:04:23.76,Top,,0000,0000,0000,,(ТД: Диктор) Вестбрукта оқиға болды.
Dialogue: 0,0:04:21.55,0:04:25.55,Bottom,,0000,0000,0000,,Вестбруктағы трагедия. Корпоративтік колонна 6-шы көшеде буксирленген ...
Dialogue: 0,0:04:23.84,0:04:25.76,Top,,0000,0000,0000,,‎Алтыншы көшедегі компаниялардың колоннасы...
Dialogue: 0,0:04:25.64,0:04:27.85,Bottom,,0000,0000,0000,,Ия, ана…
Dialogue: 0,0:04:25.84,0:04:27.85,Top,,0000,0000,0000,,‎Хонтоннимо
Dialogue: 0,0:04:27.93,0:04:29.10,Top,,0000,0000,0000,,Ах
Dialogue: 0,0:04:29.18,0:04:31.27,Top,,0000,0000,0000,,(Глория Мартинес) Ах... Қайырлы таң.
Dialogue: 0,0:04:30.22,0:04:31.22,Bottom,,0000,0000,0000,,Таң.
Dialogue: 0,0:04:31.31,0:04:34.98,Bottom,,0000,0000,0000,,Тағы да диванда ұйықтайсыз ба? Сізде төсек бар екенін білесіз.
Dialogue: 0,0:04:31.35,0:04:35.23,Top,,0000,0000,0000,,Тағы да осындай жерде ұйықта. Төсекте дұрыс ұйықта
Dialogue: 0,0:04:35.06,0:04:37.86,Bottom,,0000,0000,0000,,Түнгі ауысымнан кейін ғана өлді.
Dialogue: 0,0:04:35.31,0:04:37.86,Top,,0000,0000,0000,,А, түнгі ауысымнан кейін...
Dialogue: 0,0:04:37.94,0:04:40.15,Top,,0000,0000,0000,,‎Кір жуғыш машина қайтадан тоқтатылады.
Dialogue: 0,0:04:37.94,0:04:40.32,Bottom,,0000,0000,0000,,Сіз де, кір жуғыш машина да.
Dialogue: 0,0:04:40.23,0:04:41.69,Top,,0000,0000,0000,,Зарядтауды ұмытып қалдыңыз ба?
Dialogue: 0,0:04:40.40,0:04:41.61,Bottom,,0000,0000,0000,,Оны қайта қосуды ұмытып қалдыңыз ба?
Dialogue: 0,0:04:41.69,0:04:42.86,Bottom,,0000,0000,0000,,Иә…
Dialogue: 0,0:04:41.78,0:04:44.65,Top,,0000,0000,0000,,Мен ұмытып қалдым. Мен оны кейінірек саламын.
Dialogue: 0,0:04:42.94,0:04:44.61,Bottom,,0000,0000,0000,,Мен мұны кейінірек жасаймын, ' жарай ма?
Dialogue: 0,0:04:44.70,0:04:50.29,Bottom,,0000,0000,0000,,Ақша туралы айтатын болсақ, сіз бұл жаңартуды сабаққа қашан қажет деп айттыңыз?
Dialogue: 0,0:04:44.74,0:04:47.99,Top,,0000,0000,0000,,Қазір ойлап қарасам, сабақта қолданылатын құрылғыларға арналған жаңарту бар.
Dialogue: 0,0:04:48.07,0:04:50.29,Top,,0000,0000,0000,,Мен мұны қашан істеуім керек?
Dialogue: 0,0:04:50.37,0:04:54.54,Bottom,,0000,0000,0000,,Жақсы. Онымен айналысатын доктор бар.
Dialogue: 0,0:04:50.37,0:04:54.75,Top,,0000,0000,0000,,Бұл жеткілікті. Мен Липпардоктан бұл туралы бірдеңе жасауын өтіндім.
Dialogue: 0,0:04:54.62,0:04:56.71,Bottom,,0000,0000,0000,,"Оны қолға алу"?
Dialogue: 0,0:04:54.83,0:04:58.13,Top,,0000,0000,0000,,Қалай болғанда да? Әйтеуір жақсы
Dialogue: 0,0:04:56.79,0:04:58.13,Bottom,,0000,0000,0000,,Иә, бәрі дайын.
Dialogue: 0,0:04:58.21,0:05:00.55,Bottom,,0000,0000,0000,,​​Бұрыштарды кесуге бармаңыз, Ди.
Dialogue: 0,0:04:58.21,0:05:00.59,Top,,0000,0000,0000,,‎Қараңғы қайта құру жақсы емес.
Dialogue: 0,0:05:00.63,0:05:04.38,Bottom,,0000,0000,0000,,Мен бүгін түнде ақы алып жатырмын, сондықтан сіз оны дұрыс жаңартасыз, жарай ма?
Dialogue: 0,0:05:00.67,0:05:04.38,Top,,0000,0000,0000,,Мен жалақымды алдым және қазір төлей аламын. Дұрыс жаңартыңыз.
Dialogue: 0,0:05:04.47,0:05:05.68,Top,,0000,0000,0000,,Жарайды
Dialogue: 0,0:05:04.47,0:05:07.72,Bottom,,0000,0000,0000,,Жақсы. Кір жуғыш машинаны қалпына келтіруге де жетпейді.
Dialogue: 0,0:05:05.76,0:05:07.76,Top,,0000,0000,0000,,Кір жуғыш машинаны зарядтауға да ақшам жоқ.
Dialogue: 0,0:05:07.80,0:05:09.76,Bottom,,0000,0000,0000,,Мен сізге ұмытып кеткенімді айттым.
Dialogue: 0,0:05:07.84,0:05:10.56,Top,,0000,0000,0000,,Мен ұмытып қалдым, жарай ма?
Dialogue: 0,0:05:09.85,0:05:12.60,Bottom,,0000,0000,0000,,Жаңартуды сатып алатыныңызға уәде беріңіз.
Dialogue: 0,0:05:10.64,0:05:12.64,Top,,0000,0000,0000,,Дұрыс жаңартыңыз.
Dialogue: 0,0:05:12.68,0:05:14.39,Bottom,,0000,0000,0000,,Жарайды, жарайды.
Dialogue: 0,0:05:12.72,0:05:14.39,Top,,0000,0000,0000,,Мен түсінемін.
Dialogue: 0,0:05:14.48,0:05:17.06,Bottom,,0000,0000,0000,,Сен мектепке осылай киініп барасың ба?
Dialogue: 0,0:05:14.48,0:05:17.06,Top,,0000,0000,0000,,Академияға осылай киініп баруды жоспарлап отырсыз ба?
Dialogue: 0,0:05:17.15,0:05:18.86,Bottom,,0000,0000,0000,,Менің формасым суланған.
Dialogue: 0,0:05:17.15,0:05:18.94,Top,,0000,0000,0000,,Суланған
Dialogue: 0,0:05:18.94,0:05:21.40,Bottom,,0000,0000,0000,,Әскери үлгідегі имплант жоғалып кеткен
Dialogue: 0,0:05:19.02,0:05:21.40,Top,,0000,0000,0000,,(ТД: Диктор) Кеше түнде MaxTac атып өлтірді.
Dialogue: 0,0:05:21.48,0:05:23.36,Top,,0000,0000,0000,,Бұрынғы лейтенант Джеймс Норристің денесінен
Dialogue: 0,0:05:21.48,0:05:24.36,Bottom,,0000,0000,0000,,MaxTac атып өлтірген подполковник Джеймс Норристің денесі…
Dialogue: 0,0:05:23.44,0:05:24.40,Top,,0000,0000,0000,,Әскери имплант жоқ...
Dialogue: 0,0:05:24.40,0:05:25.40,Top,,0000,0000,0000,,Менің әскери имплантым жоқ... Анашым! Сіз сонда болдыңыз ба?
Dialogue: 0,0:05:24.44,0:05:26.70,Bottom,,0000,0000,0000,,Анашым, сіз теледидардасыз!
Dialogue: 0,0:05:25.40,0:05:26.65,Top,,0000,0000,0000,,Анашым! Сіз сонда болдыңыз ба?
Dialogue: 0,0:05:26.74,0:05:27.78,Top,,0000,0000,0000,,Керемет!
Dialogue: 0,0:05:26.78,0:05:27.78,Bottom,,0000,0000,0000,,Жаңа!
Dialogue: 0,0:05:27.86,0:05:30.16,Bottom,,0000,0000,0000,,Жаңа емес, Дэвид. Қан төгу.
Dialogue: 0,0:05:27.86,0:05:30.16,Top,,0000,0000,0000,,Бұл ең сорақысы, үйілген мәйіт
Dialogue: 0,0:05:30.74,0:05:32.33,Bottom,,0000,0000,0000,,Мектепке барыңыз.
Dialogue: 0,0:05:30.74,0:05:33.83,Top,,0000,0000,0000,,Қазір барыңыз
Dialogue: 0,0:05:32.41,0:05:33.66,Bottom,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:05:34.41,0:05:36.04,Bottom,,0000,0000,0000,,Сені жақсы көремін.
Dialogue: 0,0:05:34.45,0:05:36.04,Top,,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:05:36.62,0:05:38.79,Top,,0000,0000,0000,,‎(Голокольдық үн)
Dialogue: 0,0:05:40.67,0:05:41.67,Bottom,,0000,0000,0000,,Мэн?
Dialogue: 0,0:05:40.71,0:05:43.42,Top,,0000,0000,0000,,(Holo News: Gloria) Негізгі? Сәлем Глория
Dialogue: 0,0:05:41.75,0:05:42.96,Bottom,,0000,0000,0000,,Бұл Глория.
Dialogue: 0,0:05:47.13,0:05:48.13,Top,,0000,0000,0000,,‎(есік жабылған дыбыс)
Dialogue: 0,0:05:50.18,0:05:53.01,Top,,0000,0000,0000,,‎(Қорылдаған адам)
Dialogue: 0,0:06:11.70,0:06:13.79,Top,,0000,0000,0000,,(Адамның үрейлі дауысы) (Бала) Әй!
Dialogue: 0,0:06:14.45,0:06:17.75,Top,,0000,0000,0000,,‎(Еркектер ентігу)
Dialogue: 0,0:06:17.83,0:06:20.75,Top,,0000,0000,0000,,‎(Әйел) О, о!
Dialogue: 0,0:06:31.01,0:06:32.89,Top,,0000,0000,0000,,(AV дыбыс жазбасы) Бұл жарақат тобы.
Dialogue: 0,0:06:31.01,0:06:35.31,Bottom,,0000,0000,0000,,Жарақат тобы. Жолды дереу босатыңыз.
Dialogue: 0,0:06:32.97,0:06:35.43,Top,,0000,0000,0000,,Біз мердігерге асығып жатырмыз.
Dialogue: 0,0:06:35.39,0:06:37.98,Bottom,,0000,0000,0000,,Төтенше эвакуация жүріп жатыр.
Dialogue: 0,0:06:35.52,0:06:38.14,Top,,0000,0000,0000,,Маңайдағы AV ұшақтары үшін әуе бағытын босатыңыз.
Dialogue: 0,0:06:38.06,0:06:40.56,Bottom,,0000,0000,0000,,Барлық AV тыныс алу жолын дереу босатады.
Dialogue: 0,0:06:38.23,0:06:42.27,Top,,0000,0000,0000,,Өмірді сақтауға көмектесіңіз. Бұл жарақат тобы.
Dialogue: 0,0:06:40.65,0:06:42.27,Bottom,,0000,0000,0000,,Қайталап айтамын. Жарақат тобы…
Dialogue: 0,0:06:42.36,0:06:44.73,Top,,0000,0000,0000,,Біз мердігерге асығып жатырмыз.
Dialogue: 0,0:06:45.36,0:06:49.28,Top,,0000,0000,0000,,​​‎(Бағдаршам дыбысы) ‎Жүрмеңіз. Жаяу жүрме.
Dialogue: 0,0:06:51.07,0:06:55.03,Top,,0000,0000,0000,,Жаяу. Жаяу жүру. Жаяу...
Dialogue: 0,0:07:19.81,0:07:20.44,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:21.35,0:07:23.40,Top,,0000,0000,0000,,Ха...
Dialogue: 0,0:07:33.03,0:07:35.12,Top,,0000,0000,0000,,‎Ха ха ха
Dialogue: 0,0:07:35.83,0:07:36.62,Top,,0000,0000,0000,,‎Ха…
Dialogue: 0,0:07:37.66,0:07:38.74,Top,,0000,0000,0000,,(күрсіну)
Dialogue: 0,0:08:00.85,0:08:02.73,Top,,0000,0000,0000,,(AI мұғалімі) Қайырлы таң
Dialogue: 0,0:08:01.35,0:08:02.73,Bottom,,0000,0000,0000,,Қайырлы таң, сынып.
Dialogue: 0,0:08:02.81,0:08:05.77,Bottom,,0000,0000,0000,,Бүгінгі сабаққа қатысу, қатыспау нөл.
Dialogue: 0,0:08:02.81,0:08:05.77,Top,,0000,0000,0000,,Қатыспағандар жоқ. Бұл тамаша.
Dialogue: 0,0:08:05.86,0:08:07.77,Bottom,,0000,0000,0000,,Мартинес, Дэвид.
Dialogue: 0,0:08:05.86,0:08:10.40,Top,,0000,0000,0000,,‎Дэвид Мартинес ‎Ол қажетті форманы кимеген сияқты.
Dialogue: 0,0:08:07.86,0:08:10.28,Bottom,,0000,0000,0000,,Сіз Академия формасын киген жоқсыз.
Dialogue: 0,0:08:10.36,0:08:14.28,Bottom,,0000,0000,0000,,Кешіріңіз. Ол әлі тазалаушыда.
Dialogue: 0,0:08:10.49,0:08:14.28,Top,,0000,0000,0000,,Кешіріңіз. Мен бүгін таңертең көйлегім мен шалбарымды ластадым.
Dialogue: 0,0:08:14.36,0:08:16.12,Bottom,,0000,0000,0000,,Бос жеріңіз қайда?
Dialogue: 0,0:08:14.36,0:08:16.20,Top,,0000,0000,0000,,(AI мұғалімі) Сізде қосалқы бөлшектер болған жоқ па?
Dialogue: 0,0:08:16.20,0:08:18.08,Bottom,,0000,0000,0000,,Қосалқы құрал да бар.
Dialogue: 0,0:08:16.28,0:08:17.70,Top,,0000,0000,0000,,Иә, кешіріңіз.
Dialogue: 0,0:08:18.16,0:08:22.08,Bottom,,0000,0000,0000,,Түсінікті. Сабақтан кейін Бірыңғай ерекшелік формасын жіберіңіз.
Dialogue: 0,0:08:18.20,0:08:22.12,Top,,0000,0000,0000,,‎(AI мұғалімі) ‎Жарайды. Арнайы киім ережелеріне жүгініңіз.
Dialogue: 0,0:08:22.21,0:08:22.71,Top,,0000,0000,0000,,(Голоколь қоңырау үні)
Dialogue: 0,0:08:22.71,0:08:24.29,Top,,0000,0000,0000,,Сабақты бастайық.
Dialogue: 0,0:08:22.75,0:08:24.29,Bottom,,0000,0000,0000,,Енді бүгінгі сабағымызды бастайық.
Dialogue: 0,0:08:25.63,0:08:27.88,Top,,0000,0000,0000,,Форма кимеймін деп әзілдеме.
Dialogue: 0,0:08:27.96,0:08:30.38,Top,,0000,0000,0000,,Мен болсам, мектепке келуге ұялатын едім.
Dialogue: 0,0:08:30.46,0:08:32.34,Top,,0000,0000,0000,,Мен ұялмаймын.
Dialogue: 0,0:08:32.42,0:08:34.13,Top,,0000,0000,0000,,Оқу маңызды.
Dialogue: 0,0:08:34.22,0:08:36.39,Top,,0000,0000,0000,,Сіз әлі де сол ескі стильді қолданасыз ба?
Dialogue: 0,0:08:36.47,0:08:38.55,Top,,0000,0000,0000,,Ол енді жаңартулармен үйлесімді емес.
Dialogue: 0,0:08:39.14,0:08:40.56,Top,,0000,0000,0000,,‎Үйлесімді
Dialogue: 0,0:08:40.64,0:08:43.98,Top,,0000,0000,0000,,Не? Ол нені білдіреді? Бұл дегеніміз осы
Dialogue: 0,0:08:44.06,0:08:48.31,Top,,0000,0000,0000,,Жаңасын сатып алуға ақшаңыз жоқ па? Мен мектепке жиі келетін сияқтымын.
Dialogue: 0,0:08:48.40,0:08:50.48,Top,,0000,0000,0000,,(AI мұғалімі) Сонымен, ойды ашу
Dialogue: 0,0:08:48.40,0:08:52.65,Bottom,,0000,0000,0000,,Мен барлық студенттерден медитация үшін Жасыл бөлмеге кіруді сұраймын.
Dialogue: 0,0:08:50.57,0:08:52.65,Top,,0000,0000,0000,,Жасыл бөлмеге кіріңіз.
Dialogue: 0,0:08:52.74,0:08:54.32,Bottom,,0000,0000,0000,,Сізге сенемін, доктор…
Dialogue: 0,0:08:52.74,0:08:54.32,Top,,0000,0000,0000,,Өтінемін, док
Dialogue: 0,0:08:56.32,0:08:59.08,Top,,0000,0000,0000,,‎(шу дыбысы)
Dialogue: 0,0:08:59.16,0:09:00.45,Bottom,,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,0:08:59.16,0:09:00.62,Top,,0000,0000,0000,,(Студент) Не болды?
Dialogue: 0,0:09:00.54,0:09:01.49,Bottom,,0000,0000,0000,,Бұл Мартинес.
Dialogue: 0,0:09:00.70,0:09:03.08,Top,,0000,0000,0000,,(Студент) Бұл Мартинес. (Оқушы) Бұл қате. Қате қате...
Dialogue: 0,0:09:01.58,0:09:03.08,Bottom,,0000,0000,0000,,Бұл вирус!
Dialogue: 0,0:09:03.16,0:09:04.21,Top,,0000,0000,0000,,‎(Қысқа дыбыс)
Dialogue: 0,0:09:04.71,0:09:05.83,Top,,0000,0000,0000,,Ух... иә?
Dialogue: 0,0:09:05.92,0:09:08.17,Top,,0000,0000,0000,,‎(Шуыл дыбысы) ‎(Бонито гүрілдеген)
Dialogue: 0,0:09:09.09,0:09:12.26,Bottom,,0000,0000,0000,,Ол келтірген қолайсыздықтар үшін кешірім сұраймын.
Dialogue: 0,0:09:09.13,0:09:12.30,Top,,0000,0000,0000,,Келтірілген қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:09:12.34,0:09:15.38,Bottom,,0000,0000,0000,,Мен бұл жай ғана ақша мәселесі деп айтпас едім, Мартинес ханым.
Dialogue: 0,0:09:12.38,0:09:15.38,Top,,0000,0000,0000,,(Басшы) Бұл жай ғана ақша мәселесі емес.
Dialogue: 0,0:09:15.47,0:09:19.35,Bottom,,0000,0000,0000,,​​Жүйені қалпына келтіру айтарлықтай шығын болғанымен.
Dialogue: 0,0:09:15.47,0:09:19.39,Top,,0000,0000,0000,,Шындығында жүйені қалпына келтіру өте қымбатқа түседі.
Dialogue: 0,0:09:19.43,0:09:22.18,Bottom,,0000,0000,0000,,Әрине, мен жөндеу ақысын төлеймін.
Dialogue: 0,0:09:19.47,0:09:22.22,Top,,0000,0000,0000,,Әрине, біз шығынды өтейміз.
Dialogue: 0,0:09:22.27,0:09:23.10,Bottom,,0000,0000,0000,,Жер
Dialogue: 0,0:09:22.31,0:09:23.22,Top,,0000,0000,0000,,Е...
Dialogue: 0,0:09:23.18,0:09:26.94,Bottom,,0000,0000,0000,,Менің түсінуімше, Дэвид гарнитурасын өзгертті
Dialogue: 0,0:09:23.31,0:09:24.48,Top,,0000,0000,0000,,Дэвид
Dialogue: 0,0:09:24.56,0:09:27.02,Top,,0000,0000,0000,,Құрылғыңызды жаңартыңыз. Шығындарды сақтаңыз
Dialogue: 0,0:09:27.02,0:09:30.61,Bottom,,0000,0000,0000,,лицензияланған жаңарту үшін төлем жасамау үшін артқы аллея бағдарламалық құралымен.
Dialogue: 0,0:09:27.10,0:09:30.27,Top,,0000,0000,0000,,Ол қараңғы инженерден құрылғыны өзгертуді сұраған сияқты.
Dialogue: 0,0:09:30.69,0:09:34.57,Bottom,,0000,0000,0000,,Құрметпен айтсақ, бұл кейбір қаржылық қиындықтармен байланысты болуы мүмкін бе?
Dialogue: 0,0:09:30.86,0:09:34.61,Top,,0000,0000,0000,,Кешіріңіз, бірақ сіз қаржылық қиындыққа тап болдыңыз ба?
Dialogue: 0,0:09:34.65,0:09:37.86,Bottom,,0000,0000,0000,,Бұл шынымен де проблема емес. Оған шамамыз жетеді.
Dialogue: 0,0:09:34.69,0:09:37.86,Top,,0000,0000,0000,,Жарайды. Мен міндетті түрде төлеймін.
Dialogue: 0,0:09:37.95,0:09:41.83,Bottom,,0000,0000,0000,,Бұл Дэвидтің жағдайын қайта қарауға жақсы мүмкіндік деп ойлаймын.
Dialogue: 0,0:09:37.95,0:09:41.91,Top,,0000,0000,0000,,(Басшы) Бұл жақсы мүмкіндік. Неге оны отбасыңмен талқыламайсың?
Dialogue: 0,0:09:41.91,0:09:43.12,Bottom,,0000,0000,0000,,Қандай жағдай?
Dialogue: 0,0:09:41.99,0:09:43.12,Top,,0000,0000,0000,,Не?
Dialogue: 0,0:09:43.20,0:09:45.79,Top,,0000,0000,0000,,(директор) Бұл... Дэвид те сыныптасы.
Dialogue: 0,0:09:43.20,0:09:47.50,Bottom,,0000,0000,0000,,Дэвид сыныптастарымен үйлеспейді.
Dialogue: 0,0:09:45.87,0:09:49.58,Top,,0000,0000,0000,,Олар бұған үйренбеген сияқты. Немесе ортаны өзгертуге тырысу керек шығар...
Dialogue: 0,0:09:47.58,0:09:49.54,Bottom,,0000,0000,0000,,Қоршаған ортаның өзгеруі пайдалы болуы мүмкін--
Dialogue: 0,0:09:49.63,0:09:52.55,Bottom,,0000,0000,0000,,Жоқ! Ол осында қалуы керек.
Dialogue: 0,0:09:49.67,0:09:52.63,Top,,0000,0000,0000,,Жоқ, бұл бала осында болуы керек.
Dialogue: 0,0:09:52.63,0:09:55.72,Bottom,,0000,0000,0000,,Ол мұндағы барлық балалар сияқты бұл білімге лайық…
Dialogue: 0,0:09:52.71,0:09:55.72,Top,,0000,0000,0000,,Өтінемін, бұл баланы мектепте қалдырыңыз.
Dialogue: 0,0:09:56.34,0:09:58.72,Bottom,,0000,0000,0000,,Мен сізге жаңартуды алуды айтқан жоқпын ба?
Dialogue: 0,0:09:56.42,0:09:59.18,Top,,0000,0000,0000,,Мен сізге жаңартуды айттым.
Dialogue: 0,0:09:59.26,0:10:02.31,Top,,0000,0000,0000,,Рипперден сұрау қате болды.
Dialogue: 0,0:09:59.30,0:10:02.31,Bottom,,0000,0000,0000,,Дәрігер кінәлі, ол маған көлікті бұзды...
Dialogue: 0,0:10:02.39,0:10:04.43,Top,,0000,0000,0000,,‎Себебі мен аз ақша жұмсауға құлықсыз болдым
Dialogue: 0,0:10:02.39,0:10:07.39,Bottom,,0000,0000,0000,,Сіз жүйені жеңуге тырыстыңыз және қазір біз бастапқы құнынан он есе қарызбыз.
Dialogue: 0,0:10:04.52,0:10:07.48,Top,,0000,0000,0000,,Ақырында мен ондаған есе көп төледім.
Dialogue: 0,0:10:07.48,0:10:08.98,Bottom,,0000,0000,0000,,Кешіріңіз…
Dialogue: 0,0:10:07.56,0:10:10.35,Top,,0000,0000,0000,,Бұл жаман болды. Егер сіз оны жаман деп ойласаңыз.
Dialogue: 0,0:10:09.06,0:10:12.57,Bottom,,0000,0000,0000,,Егер сіз бәрібір кешірім сұрағыңыз келсе, бірінші кезекте мұны істемеңіз.
Dialogue: 0,0:10:10.44,0:10:12.65,Top,,0000,0000,0000,,Олар мұны басынан бастап дұрыс орындаса жақсы болар еді.
Dialogue: 0,0:10:12.65,0:10:15.44,Bottom,,0000,0000,0000,,Мен бірінші рет сұрағанымда сізде құйындылар жоқ дедіңіз...
Dialogue: 0,0:10:12.73,0:10:15.48,Top,,0000,0000,0000,,Өйткені мен саған ақшам жоқ екенін алғаш айтқанымда...
Dialogue: 0,0:10:15.53,0:10:17.99,Bottom,,0000,0000,0000,,Өйткені ол әлі жалақы алатын күн емес еді!
Dialogue: 0,0:10:15.57,0:10:18.15,Top,,0000,0000,0000,,‎Себебі бұл жалақы күніне дейін болды, солай ма?
Dialogue: 0,0:10:18.07,0:10:20.45,Bottom,,0000,0000,0000,,Әрине, бізде жай ғана қолма-қол ақша жоқ!
Dialogue: 0,0:10:18.24,0:10:20.45,Top,,0000,0000,0000,,Менде әрқашан ақша жеткіліксіз.
Dialogue: 0,0:10:20.53,0:10:22.41,Top,,0000,0000,0000,,Бұл әдеттен бас тарт!
Dialogue: 0,0:10:20.53,0:10:22.70,Bottom,,0000,0000,0000,,Ал сен бір орында отыра алмайсың ба?
Dialogue: 0,0:10:22.91,0:10:24.04,Top,,0000,0000,0000,,‎Ха…
Dialogue: 0,0:10:25.16,0:10:28.00,Bottom,,0000,0000,0000,,Білесіз бе, мен соңғы уақытта ойлап жүрмін...
Dialogue: 0,0:10:25.29,0:10:27.71,Top,,0000,0000,0000,,‎Білесіз бе, мен бұл туралы ойладым.
Dialogue: 0,0:10:28.08,0:10:29.58,Bottom,,0000,0000,0000,,туралы?
Dialogue: 0,0:10:28.21,0:10:29.33,Top,,0000,0000,0000,,Не?
Dialogue: 0,0:10:29.67,0:10:33.09,Bottom,,0000,0000,0000,,​​Мүмкін мен оқуды тастап кетемін... Қазір немесе басқасын табыңыз.
Dialogue: 0,0:10:29.83,0:10:33.17,Top,,0000,0000,0000,,Мектепті тастап, жұмыс істегенім жақсы емес пе?
Dialogue: 0,0:10:33.17,0:10:34.71,Bottom,,0000,0000,0000,,Өзіңді естисің бе?!
Dialogue: 0,0:10:33.25,0:10:34.71,Top,,0000,0000,0000,,‎Сен не айтып тұрсың!
Dialogue: 0,0:10:34.80,0:10:38.88,Bottom,,0000,0000,0000,,Жүр, шындап. Білесіз бе, бұл жөндеу жұмыстарына біздің ақшамыз жетпейді.
Dialogue: 0,0:10:34.80,0:10:38.88,Top,,0000,0000,0000,,‎Себебі... Сіз жүйені жөндеуге ақы төлей алмайсыз, солай ма?
Dialogue: 0,0:10:38.97,0:10:43.47,Bottom,,0000,0000,0000,,Оған қоса, сіз менің қаншалықты ерекшеленетінімді білмейсіз.
Dialogue: 0,0:10:38.97,0:10:43.60,Top,,0000,0000,0000,,Анашым, сіз білмейсіз бе? Мен мектепте қандай күлкілімін?
Dialogue: 0,0:10:43.55,0:10:46.89,Bottom,,0000,0000,0000,,Шынайы-көк корпус емес кез келген адам үнемі ренжіп қалады.
Dialogue: 0,0:10:43.68,0:10:46.72,Top,,0000,0000,0000,,Кедейлер қаншалықты емделеді?
Dialogue: 0,0:10:46.97,0:10:51.65,Bottom,,0000,0000,0000,,Олар мені ешқашан, тіпті оқуды бітірсем де қабылдамайды.
Dialogue: 0,0:10:47.22,0:10:51.56,Top,,0000,0000,0000,,Қанша оқысам да олар сияқты бола алмаймын.
Dialogue: 0,0:10:52.23,0:10:53.90,Top,,0000,0000,0000,,Мен тіпті болғым келмейді
Dialogue: 0,0:10:52.23,0:10:54.32,Bottom,,0000,0000,0000,,Бәрібір корпус болғың келмейді.
Dialogue: 0,0:10:57.65,0:11:00.82,Top,,0000,0000,0000,,Сонда мен не үшін жұмыс істеп жатырмын?
Dialogue: 0,0:10:57.74,0:11:00.70,Bottom,,0000,0000,0000,,Сонда мен не үшін есегімді ұрдым?
Dialogue: 0,0:11:01.99,0:11:07.66,Bottom,,0000,0000,0000,,Мен істеп жатқанның бәрі сен үшін, Ди... Мұны көрмейсің бе?
Dialogue: 0,0:11:02.07,0:11:05.33,Top,,0000,0000,0000,,‎Сіз үшін... ‎Жұмыс...
Dialogue: 0,0:11:05.95,0:11:07.16,Top,,0000,0000,0000,,Не үшін...
Dialogue: 0,0:11:08.87,0:11:11.00,Bottom,,0000,0000,0000,,Сіз менің жүрегімді жаралап жатырсыз.
Dialogue: 0,0:11:09.00,0:11:10.92,Top,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:11.00,0:11:12.12,Top,,0000,0000,0000,,Ана?
Dialogue: 0,0:11:11.08,0:11:12.12,Bottom,,0000,0000,0000,,Анашым...?
Dialogue: 0,0:11:12.21,0:11:16.38,Top,,0000,0000,0000,,Олар сені ақылды және талантты дейді...
Dialogue: 0,0:11:12.21,0:11:16.75,Bottom,,0000,0000,0000,,Менің балам... Өте ақылды және өте талантты.
Dialogue: 0,0:11:16.84,0:11:21.59,Bottom,,0000,0000,0000,,Мен сізге осы қалада шайқасу мүмкіндігін, жақсы білім бергім келеді...
Dialogue: 0,0:11:16.92,0:11:18.17,Top,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:11:18.26,0:11:21.47,Top,,0000,0000,0000,,Сен үшін деп ойлап, қатты жұмыс істеп жатырмын...
Dialogue: 0,0:11:22.30,0:11:27.10,Bottom,,0000,0000,0000,,Сондықтан мен сағаттарды қойдым, неге мен ешқашан үйде емеспін!
Dialogue: 0,0:11:22.39,0:11:24.22,Top,,0000,0000,0000,,Мен мектепке барғым келмейді...
Dialogue: 0,0:11:24.72,0:11:26.97,Top,,0000,0000,0000,,Сонда мен не істеп жатырмын?
Dialogue: 0,0:11:29.10,0:11:31.06,Bottom,,0000,0000,0000,,Мұнда.
Dialogue: 0,0:11:29.23,0:11:31.14,Top,,0000,0000,0000,,Мен тым көп айттым
Dialogue: 0,0:11:31.14,0:11:35.02,Bottom,,0000,0000,0000,,Оны қозғамау керек еді. Жылама, анашым...
Dialogue: 0,0:11:31.23,0:11:34.61,Top,,0000,0000,0000,,‎Бұл жаман болды... Өтінемін, жылама.
Dialogue: 0,0:11:35.11,0:11:38.32,Bottom,,0000,0000,0000,,Мен олардың саған қалай қарайтынын білмеймін деп ойлайсың ба?
Dialogue: 0,0:11:35.11,0:11:38.44,Top,,0000,0000,0000,,Саған қарсы желдің күшті екенін білемін.
Dialogue: 0,0:11:38.40,0:11:40.86,Bottom,,0000,0000,0000,,Маған дәл солай қарамайды деп ойлайсыз ба?
Dialogue: 0,0:11:38.53,0:11:40.95,Top,,0000,0000,0000,,Аналар ұқсас.
Dialogue: 0,0:11:40.95,0:11:43.57,Bottom,,0000,0000,0000,,Бірақ сондықтан сіз олардың қате екенін дәлелдеуіңіз керек.
Dialogue: 0,0:11:41.03,0:11:43.57,Top,,0000,0000,0000,,Сондықтан мен оған қайта қарағым келеді.
Dialogue: 0,0:11:43.66,0:11:45.49,Bottom,,0000,0000,0000,,Мен сенің ерінбей еңбек етуіңді, көтерілуіңді қалаймын,
Dialogue: 0,0:11:43.66,0:11:45.57,Top,,0000,0000,0000,,Сізге элита болыңыз
Dialogue: 0,0:11:45.57,0:11:49.87,Bottom,,0000,0000,0000,,және Арасака мұнарасының жоғарғы қабатына жетіңіз!
Dialogue: 0,0:11:45.66,0:11:49.95,Top,,0000,0000,0000,,Арасака мұнарасының жоғарғы қабатында жұмыс істей алуыңызды қалаймын.
Dialogue: 0,0:11:49.95,0:11:52.58,Bottom,,0000,0000,0000,,Мен сенде бар екенін білемін, Ди.
Dialogue: 0,0:11:50.04,0:11:52.58,Top,,0000,0000,0000,,Сізде сонша талант бар.
Dialogue: 0,0:11:53.17,0:11:54.88,Top,,0000,0000,0000,,Жасалғаннан гөрі айту оңай...
Dialogue: 0,0:11:53.25,0:11:55.46,Bottom,,0000,0000,0000,,Айтуға оңай… жасағаннан…
Dialogue: 0,0:11:54.96,0:11:56.13,Top,,0000,0000,0000,,Уф!
Dialogue: 0,0:12:00.30,0:12:01.47,Top,,0000,0000,0000,,‎Жақсы... Жақсы...
Dialogue: 0,0:12:01.55,0:12:03.13,Top,,0000,0000,0000,,Өлтір!
Dialogue: 0,0:12:01.59,0:12:03.09,Bottom,,0000,0000,0000,,Біліңдер!
Dialogue: 0,0:12:05.22,0:12:06.47,Top,,0000,0000,0000,,Менің қашып кетуіме жол берме!
Dialogue: 0,0:12:05.26,0:12:06.47,Bottom,,0000,0000,0000,,Олардың қашып кетуіне жол бермеңіз!
Dialogue: 0,0:12:06.55,0:12:08.64,Bottom,,0000,0000,0000,,Бля! Костюм лимузинмен қапталған!
Dialogue: 0,0:12:06.55,0:12:08.64,Top,,0000,0000,0000,,Корпоның лимузині өте қиын!
Dialogue: 0,0:12:08.72,0:12:11.31,Top,,0000,0000,0000,,Жануарлардың жанын көрсет!
Dialogue: 0,0:12:08.72,0:12:12.60,Bottom,,0000,0000,0000,,Аңшылық басталды, хайуанаттар!
Dialogue: 0,0:12:11.39,0:12:12.60,Top,,0000,0000,0000,,Уау!
Dialogue: 0,0:12:12.69,0:12:13.52,Top,,0000,0000,0000,,‎(Өрт дыбысы)
Dialogue: 0,0:12:13.60,0:12:16.73,Top,,0000,0000,0000,,‎(Зеңбірек оқтарының ұшқан дыбысы)
Dialogue: 0,0:12:16.81,0:12:18.82,Top,,0000,0000,0000,,(Соққы дыбысы) Иә!
Dialogue: 0,0:12:23.03,0:12:25.45,Top,,0000,0000,0000,,‎Жануарларды ашуландырған кезде осылай болады!
Dialogue: 0,0:12:23.03,0:12:25.82,Bottom,,0000,0000,0000,,Жануарлармен ешкім айналыспайды!
Dialogue: 0,0:12:25.91,0:12:27.66,Bottom,,0000,0000,0000,,Анашым! Қатты тежеңіз!
Dialogue: 0,0:12:25.99,0:12:27.66,Top,,0000,0000,0000,,Анашым тежеңіз!
Dialogue: 0,0:12:27.74,0:12:28.78,Bottom,,0000,0000,0000,,Анашым!
Dialogue: 0,0:12:27.74,0:12:29.33,Top,,0000,0000,0000,,Анашым!
Dialogue: 0,0:12:34.79,0:12:36.46,Top,,0000,0000,0000,,Уф...
Dialogue: 0,0:12:37.29,0:12:39.30,Top,,0000,0000,0000,,‎Хаа ха…
Dialogue: 0,0:12:39.38,0:12:41.30,Top,,0000,0000,0000,,Уф, ана?
Dialogue: 0,0:12:40.21,0:12:41.30,Bottom,,0000,0000,0000,,Ана?
Dialogue: 0,0:12:41.88,0:12:42.80,Top,,0000,0000,0000,,Анашым!
Dialogue: 0,0:12:41.88,0:12:43.09,Bottom,,0000,0000,0000,,Анашым!
Dialogue: 0,0:12:43.42,0:12:45.76,Top,,0000,0000,0000,,‎(AV ұшу дыбысы)
Dialogue: 0,0:12:50.39,0:12:53.27,Top,,0000,0000,0000,,‎Травматологиялық топ құтқарылды...
Dialogue: 0,0:12:50.39,0:12:53.39,Bottom,,0000,0000,0000,,Жарақат тобы? Құдайға шүкір…
Dialogue: 0,0:12:55.27,0:12:56.44,Top,,0000,0000,0000,,‎(сканерлеу дыбысы)
Dialogue: 0,0:12:56.40,0:12:58.19,Bottom,,0000,0000,0000,,Клиент емес.
Dialogue: 0,0:12:56.52,0:12:59.19,Top,,0000,0000,0000,,(Травма мүшесі) Ол мердігер емес. (Травма мүшесі) Бұл да солай.
Dialogue: 0,0:12:58.27,0:12:59.19,Bottom,,0000,0000,0000,,Ол да емес.
Dialogue: 0,0:12:59.27,0:13:00.07,Top,,0000,0000,0000,,‎Эй!
Dialogue: 0,0:12:59.27,0:13:00.11,Bottom,,0000,0000,0000,,Шынымен
Dialogue: 0,0:13:00.15,0:13:01.82,Top,,0000,0000,0000,,(Жарақат мүшесі) Оларды жедел жәрдем бөліміне қалдырыңыз.
Dialogue: 0,0:13:00.19,0:13:03.94,Bottom,,0000,0000,0000,,Саясат ұстаушыны бекітіңіз. Мына жігіттерді қаладағы ет вагондарына қалдыр.
Dialogue: 0,0:13:01.90,0:13:03.99,Top,,0000,0000,0000,,‎Тек лимузиндік мердігерлерді тасымалдауға болады.
Dialogue: 0,0:13:04.03,0:13:05.70,Bottom,,0000,0000,0000,,-Соны көшіріңіз. -Не?!
Dialogue: 0,0:13:04.07,0:13:05.70,Top,,0000,0000,0000,,(Травма мүшесі) Түсінікті. иә?
Dialogue: 0,0:13:05.78,0:13:07.66,Top,,0000,0000,0000,,‎Сен не істеп жатырсың? Эй
Dialogue: 0,0:13:05.78,0:13:08.45,Bottom,,0000,0000,0000,,Бұл не? Эй! Күте тұрыңыз!
Dialogue: 0,0:13:07.74,0:13:08.45,Top,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:13:08.53,0:13:10.70,Top,,0000,0000,0000,,(ұшу дыбысы) Қарғыс атсын
Dialogue: 0,0:13:09.62,0:13:10.70,Bottom,,0000,0000,0000,,Қат!
Dialogue: 0,0:13:10.78,0:13:12.70,Bottom,,0000,0000,0000,,Сіз бізді осында қалдырасыз ба?
Dialogue: 0,0:13:10.79,0:13:12.70,Top,,0000,0000,0000,,Сіз оны артта қалдырғыңыз келетініне сенімдісіз бе?
Dialogue: 0,0:13:13.29,0:13:15.71,Bottom,,0000,0000,0000,,Анашым!
Dialogue: 0,0:13:13.37,0:13:15.71,Top,,0000,0000,0000,,Анашым! Анашым!
Dialogue: 0,0:13:15.79,0:13:17.71,Bottom,,0000,0000,0000,,Оян!
Dialogue: 0,0:13:15.79,0:13:17.71,Top,,0000,0000,0000,,‎Анашым, ояныңыз!
Dialogue: 0,0:13:17.79,0:13:19.25,Top,,0000,0000,0000,,Қарғыс атсын! Қарғыс атсын!
Dialogue: 0,0:13:17.79,0:13:19.71,Bottom,,0000,0000,0000,,Бұзық...
Dialogue: 0,0:13:19.79,0:13:22.46,Top,,0000,0000,0000,,Анашым! Қарғыс атсын, кет!
Dialogue: 0,0:13:19.79,0:13:24.01,Bottom,,0000,0000,0000,,Анашым! Қарғыс атсын, кет менен!
Dialogue: 0,0:13:22.55,0:13:24.97,Top,,0000,0000,0000,,Шығу! Қат!
Dialogue: 0,0:13:24.09,0:13:27.97,Bottom,,0000,0000,0000,,Жібер! Қарғыс атсын!
Dialogue: 0,0:13:25.05,0:13:27.97,Top,,0000,0000,0000,,Не деген сұмдық! Чикусо!
Dialogue: 0,0:13:28.05,0:13:30.05,Top,,0000,0000,0000,,Қарға! Қат!
Dialogue: 0,0:13:28.05,0:13:30.93,Bottom,,0000,0000,0000,,Боқ, боқ, боқ!
Dialogue: 0,0:13:31.01,0:13:32.72,Bottom,,0000,0000,0000,,Қат!
Dialogue: 0,0:13:31.22,0:13:32.22,Top,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:13:36.27,0:13:38.23,Top,,0000,0000,0000,,(Дәрігер) Операция қиындықсыз өтті.
Dialogue: 0,0:13:36.27,0:13:41.19,Bottom,,0000,0000,0000,,Операция сәтті болды. Ол әлі келген жоқ, бірақ ол тұрақты.
Dialogue: 0,0:13:38.31,0:13:41.19,Top,,0000,0000,0000,,Ол әлі комада және есін жиған жоқ.
Dialogue: 0,0:13:41.27,0:13:43.40,Bottom,,0000,0000,0000,,Біз оны бақылау үшін тағы бірнеше түн қалдырамыз.
Dialogue: 0,0:13:41.27,0:13:43.44,Top,,0000,0000,0000,,Мен әзірге ауруханаға жатқызылатын шығармын.
Dialogue: 0,0:13:43.48,0:13:45.61,Bottom,,0000,0000,0000,,О... Мен оны көре алмаймын ба?
Dialogue: 0,0:13:43.53,0:13:45.57,Top,,0000,0000,0000,,‎Не, сіз кездесе алмайсыз ба?
Dialogue: 0,0:13:45.65,0:13:49.53,Top,,0000,0000,0000,,(Дәрігер) Жоқ, бұл арзан курс. Енді олар келуге рұқсат бермейді.
Dialogue: 0,0:13:45.69,0:13:49.49,Bottom,,0000,0000,0000,,Қолдан келмейді, балам. Бару сіздің пакетіңіздің бөлігі емес.
Dialogue: 0,0:13:49.57,0:13:51.16,Bottom,,0000,0000,0000,,R-Оң…
Dialogue: 0,0:13:49.62,0:13:51.16,Top,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:13:51.24,0:13:53.83,Top,,0000,0000,0000,,(Дәрігер) Бұл медициналық шығындар мен ауруханаға жатқызу шығындары үшін есепшот ақпараты.
Dialogue: 0,0:13:51.24,0:13:56.12,Bottom,,0000,0000,0000,,Қалай болғанда да, міне, кейбір құжаттар мен сіздің шотыңыз. Анаңның заттарын да алып келді.
Dialogue: 0,0:13:53.91,0:13:58.33,Top,,0000,0000,0000,,Сондай-ақ, бұл сіздің анаңыздың заттары. 3 күн ішінде төлеңіз.
Dialogue: 0,0:13:56.21,0:13:58.29,Bottom,,0000,0000,0000,,Бұл құйындыларды үш күн ішінде бізге жіберіңіз.
Dialogue: 0,0:13:58.37,0:13:59.21,Bottom,,0000,0000,0000,,Уф…
Dialogue: 0,0:13:58.42,0:13:59.21,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:59.79,0:14:02.67,Top,,0000,0000,0000,,(Дәрігер) Мен де Түнгі қалада сақтандыру алғым келеді.
Dialogue: 0,0:13:59.79,0:14:03.09,Bottom,,0000,0000,0000,,Түнгі қалада барлығының сақтандыруды қалайтынының себебі бар, балам.
Dialogue: 0,0:14:03.17,0:14:04.21,Bottom,,0000,0000,0000,,Сәтті өтіңіз.
Dialogue: 0,0:14:03.25,0:14:04.21,Top,,0000,0000,0000,,Сау болыңыз
Dialogue: 0,0:14:05.09,0:14:07.47,Top,,0000,0000,0000,,Мен баскетбол фишкаларын сатқым келеді.
Dialogue: 0,0:14:05.17,0:14:07.47,Bottom,,0000,0000,0000,,Иә, иә, құрсау чипіне сатып алушы іздейді…
Dialogue: 0,0:14:08.34,0:14:11.47,Bottom,,0000,0000,0000,,Сіз мені ренжітуіңіз керек, бәрі осы ма? Не?
Dialogue: 0,0:14:08.38,0:14:10.89,Top,,0000,0000,0000,,Өтірік тым арзан емес пе? иә?
Dialogue: 0,0:14:11.55,0:14:13.60,Top,,0000,0000,0000,,‎Жоқ, бұл туралы айтудың қажеті жоқ.
Dialogue: 0,0:14:11.55,0:14:14.39,Bottom,,0000,0000,0000,,Жоқ, ұмыт, таңда.
Dialogue: 0,0:14:13.68,0:14:15.39,Top,,0000,0000,0000,,‎Хаа… шіркін!
Dialogue: 0,0:14:14.47,0:14:15.77,Bottom,,0000,0000,0000,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:14:15.89,0:14:16.56,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:18.94,0:14:20.60,Bottom,,0000,0000,0000,,Не бля?!
Dialogue: 0,0:14:18.94,0:14:20.60,Top,,0000,0000,0000,,Міне, солай!
Dialogue: 0,0:14:28.11,0:14:30.53,Bottom,,0000,0000,0000,,Басқа есептік жазба бар…
Dialogue: 0,0:14:28.11,0:14:30.53,Top,,0000,0000,0000,,Басқа есептік жазба бар.
Dialogue: 0,0:14:31.12,0:14:33.08,Bottom,,0000,0000,0000,,Оның соншалықты көп үнемдегенін ешқашан білмеген ...
Dialogue: 0,0:14:31.16,0:14:33.08,Top,,0000,0000,0000,,‎Неге сонша көп?
Dialogue: 0,0:14:33.62,0:14:36.54,Bottom,,0000,0000,0000,,Сонымен, бұл медициналық мәселені шешеді ...
Dialogue: 0,0:14:33.62,0:14:36.54,Top,,0000,0000,0000,,Бұл ауруханаға жатқызу шығындарын өтей ме?
Dialogue: 0,0:14:38.75,0:14:40.88,Bottom,,0000,0000,0000,,Жалдау ақысын жабу керек.
Dialogue: 0,0:14:38.75,0:14:41.63,Top,,0000,0000,0000,,Жалғыз төлейтіні жалдау ақысы... А?
Dialogue: 0,0:14:42.13,0:14:45.05,Top,,0000,0000,0000,,‎Доктор, бұл мен сізге жіберген сурет...
Dialogue: 0,0:14:42.13,0:14:45.34,Bottom,,0000,0000,0000,,Doc? Эй, сен менің жібергенімді түсіндің бе?
Dialogue: 0,0:14:45.42,0:14:50.68,Bottom,,0000,0000,0000,,Тыңдаңыз, мен сіз маған берген мінсіз алаяқтық туралы ұмытып кеттім деп ойламаңыз ...
Dialogue: 0,0:14:45.55,0:14:48.01,Top,,0000,0000,0000,,Бұған дейін құрылғыны келесі күні жаңартыңыз.
Dialogue: 0,0:14:48.09,0:14:50.34,Top,,0000,0000,0000,,Бізде қорқынышты оқиға болды, солай емес пе?
Dialogue: 0,0:14:50.76,0:14:51.97,Bottom,,0000,0000,0000,,Уф. Не болса да, адам.
Dialogue: 0,0:14:50.84,0:14:51.80,Top,,0000,0000,0000,,Жарық!
Dialogue: 0,0:14:52.68,0:14:57.81,Bottom,,0000,0000,0000,,Бұл кибербағдарлама... Иә, әскери деңгейге ұқсайды, солай ма?
Dialogue: 0,0:14:52.76,0:14:55.81,Top,,0000,0000,0000,,Бұл әскерилер қолданатын имплант...
Dialogue: 0,0:14:56.68,0:14:57.81,Top,,0000,0000,0000,,солай емес пе?
Dialogue: 0,0:14:57.89,0:14:59.27,Top,,0000,0000,0000,,Мысалы,
Dialogue: 0,0:14:57.89,0:15:02.40,Bottom,,0000,0000,0000,,Бұл не әкелуі мүмкін деп ойлайсыз?
Dialogue: 0,0:14:59.35,0:15:02.27,Top,,0000,0000,0000,,Егер мен мұны сатсам, қанша тұрады?
Dialogue: 0,0:15:03.06,0:15:05.23,Bottom,,0000,0000,0000,,Сатылмайды. Тек баға алғым келеді.
Dialogue: 0,0:15:03.19,0:15:05.02,Top,,0000,0000,0000,,Мысалы, жоқ.
Dialogue: 0,0:15:07.86,0:15:11.07,Bottom,,0000,0000,0000,,Жоқ, бұл шуды бұзыңыз, бұл соншалықты арзан емес.
Dialogue: 0,0:15:07.90,0:15:10.70,Top,,0000,0000,0000,,Бұл өтірік. Оның соншалықты арзан болуы мүмкін емес.
Dialogue: 0,0:15:13.99,0:15:15.70,Top,,0000,0000,0000,,Тіпті...
Dialogue: 0,0:15:14.07,0:15:15.95,Bottom,,0000,0000,0000,,Жүр, таңда.
Dialogue: 0,0:15:18.08,0:15:20.00,Bottom,,0000,0000,0000,,Қалай болғанда да, бәрібір сатылмады.
Dialogue: 0,0:15:18.08,0:15:20.00,Top,,0000,0000,0000,,‎Ах~ Жарайды, түсіндім!
Dialogue: 0,0:15:20.08,0:15:23.58,Top,,0000,0000,0000,,‎Онда мен саған бұдан былай мектептегі құпия BD бойынша көмектеспеймін!
Dialogue: 0,0:15:20.08,0:15:23.92,Bottom,,0000,0000,0000,,Енді мен сіздің XBD-ді мектепте итереді деп күтпеңіз!
Dialogue: 0,0:15:26.17,0:15:27.80,Top,,0000,0000,0000,,Аяқтарыңа қараңдар
Dialogue: 0,0:15:26.17,0:15:27.92,Bottom,,0000,0000,0000,,Мені жақсылыққа шақыру…
Dialogue: 0,0:15:29.72,0:15:31.59,Bottom,,0000,0000,0000,,Сандевистан…
Dialogue: 0,0:15:29.84,0:15:31.59,Top,,0000,0000,0000,,‎Сан-Девистан…
Dialogue: 0,0:15:31.68,0:15:36.10,Bottom,,0000,0000,0000,,Серия жоқ. Әскери дәреже, бұл шынымен бе?
Dialogue: 0,0:15:31.68,0:15:36.10,Top,,0000,0000,0000,,‎Бас әріптер өшірілді. Менің ойымша, бұл әскери мақсатқа арналған.
Dialogue: 0,0:15:36.18,0:15:39.06,Bottom,,0000,0000,0000,,Әлбетте заңды емес, бірақ…
Dialogue: 0,0:15:36.18,0:15:39.06,Top,,0000,0000,0000,,Абайсызда сәйкестендірусіз түзетіңіз
Dialogue: 0,0:15:39.14,0:15:41.69,Top,,0000,0000,0000,,Уау, бұл таңқаларлық. Бұл қандай ерекшелік?
Dialogue: 0,0:15:39.14,0:15:42.23,Bottom,,0000,0000,0000,,Уа! Бұл сипаттамалар ма?!
Dialogue: 0,0:15:52.99,0:15:53.61,Top,,0000,0000,0000,,А...
Dialogue: 0,0:15:55.87,0:15:56.58,Top,,0000,0000,0000,,Хехе
Dialogue: 0,0:15:58.20,0:15:59.83,Top,,0000,0000,0000,,‎(Бонитостардың күлкісі)
Dialogue: 0,0:16:00.41,0:16:01.12,Top,,0000,0000,0000,,‎Цк
Dialogue: 0,0:16:01.75,0:16:06.34,Bottom,,0000,0000,0000,,Академиядан шығу. Кеңес алуды үйреніңіз, Дэвид Мартинес.
Dialogue: 0,0:16:01.83,0:16:03.46,Top,,0000,0000,0000,,Академиядан шығу
Dialogue: 0,0:16:03.54,0:16:06.42,Top,,0000,0000,0000,,Сіз білесіз бе? Дэвид Мартинес!
Dialogue: 0,0:16:06.42,0:16:07.38,Bottom,,0000,0000,0000,,Не туралы?
Dialogue: 0,0:16:06.50,0:16:07.42,Top,,0000,0000,0000,,Не?
Dialogue: 0,0:16:07.46,0:16:10.26,Bottom,,0000,0000,0000,,Біздің сынып. Қош келмейсіз.
Dialogue: 0,0:16:07.50,0:16:10.30,Top,,0000,0000,0000,,Сыныпқа қиындық тудырып жатқаныңызды білу.
Dialogue: 0,0:16:10.34,0:16:11.80,Bottom,,0000,0000,0000,,Егер бұл кеше туралы болса...
Dialogue: 0,0:16:10.38,0:16:11.84,Top,,0000,0000,0000,,Иә? Ал кешегі күнге келсек...
Dialogue: 0,0:16:11.88,0:16:14.22,Bottom,,0000,0000,0000,,Кешегі күн туралы кім айтты?
Dialogue: 0,0:16:11.92,0:16:14.22,Top,,0000,0000,0000,,Бұл кеше ғана емес, иә?
Dialogue: 0,0:16:14.30,0:16:17.76,Bottom,,0000,0000,0000,,Мен сені кедей болғандықтан қиналып жатырмын деп ойлайсың ба? Жоқ.
Dialogue: 0,0:16:14.30,0:16:17.89,Top,,0000,0000,0000,,Мен сізді бай мен кедейдің айырмашылығына қарамай кемсітпеймін.
Dialogue: 0,0:16:17.85,0:16:19.89,Bottom,,0000,0000,0000,,Негізі, мен өзімді қайырымдылықпен санаймын.
Dialogue: 0,0:16:17.97,0:16:19.93,Top,,0000,0000,0000,,Себебі мен либералды адаммын.
Dialogue: 0,0:16:19.97,0:16:22.48,Bottom,,0000,0000,0000,,Кедей болып туылғаныңа сенің кінәң жоқ.
Dialogue: 0,0:16:20.02,0:16:22.48,Top,,0000,0000,0000,,​​‎Ал сенің кедей болғаныңа сенің кінәң жоқ.
Dialogue: 0,0:16:23.06,0:16:26.19,Bottom,,0000,0000,0000,,Көшедегі бала академияға бара алмайды деген ереже жоқ.
Dialogue: 0,0:16:23.14,0:16:26.19,Top,,0000,0000,0000,,Мектеп ережелерінде «кедей адамдар келмеуі керек» деп айтылмаған.
Dialogue: 0,0:16:26.27,0:16:28.61,Bottom,,0000,0000,0000,,, әрине, оқу ақысын төлеген жағдайда.
Dialogue: 0,0:16:26.27,0:16:28.61,Top,,0000,0000,0000,,Оқу ақысын төлегеніңізше.
Dialogue: 0,0:16:28.69,0:16:31.44,Bottom,,0000,0000,0000,,Менің хромды бұзатын нәрсе мүлдем басқа нәрсе.
Dialogue: 0,0:16:28.69,0:16:31.94,Top,,0000,0000,0000,,‎Мен сені кешіре алмайтынымның тағы бір себебі бар. Түсінесіз бе?
Dialogue: 0,0:16:31.53,0:16:32.74,Bottom,,0000,0000,0000,,-Оның не екенін білесіз бе? -Таңдау...
Dialogue: 0,0:16:32.03,0:16:35.16,Top,,0000,0000,0000,,Жаман. Біраз уақыттан бері. Мен сенің не айтып тұрғаныңды түсінбеймін.
Dialogue: 0,0:16:32.82,0:16:35.16,Bottom,,0000,0000,0000,,Мен сенің аузыңнан ештеңе түсінбедім.
Dialogue: 0,0:16:35.24,0:16:36.70,Bottom,,0000,0000,0000,,Дәл сол жерде!
Dialogue: 0,0:16:35.24,0:16:36.70,Top,,0000,0000,0000,,Міне, солай!
Dialogue: 0,0:16:36.78,0:16:39.45,Bottom,,0000,0000,0000,,Шығу. Кетіңіз.
Dialogue: 0,0:16:36.78,0:16:39.45,Top,,0000,0000,0000,,Мектепті таста, өз еркімен оқудан бас тарт.
Dialogue: 0,0:16:39.54,0:16:40.29,Top,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:39.54,0:16:40.37,Bottom,,0000,0000,0000,,Жер
Dialogue: 0,0:16:40.37,0:16:43.25,Top,,0000,0000,0000,,Сіз сыныптың аутсайдерисіз. Боқ.
Dialogue: 0,0:16:40.45,0:16:42.20,Bottom,,0000,0000,0000,,Сіз жарамсыз, аномалиясыз.
Dialogue: 0,0:16:42.29,0:16:48.34,Bottom,,0000,0000,0000,,Адам қоқысы. Және мұны ештеңе өзгерте алмайды. Шірік сүйектеріңіздей тереңге түседі.
Dialogue: 0,0:16:43.33,0:16:44.96,Top,,0000,0000,0000,,Қанша тырыссам да, ассимиляция жасай алмаймын
Dialogue: 0,0:16:45.04,0:16:48.34,Top,,0000,0000,0000,,Оны жайына қалдырсаң, айналаңдағы адамдар да шіриді.
Dialogue: 0,0:16:48.42,0:16:49.55,Top,,0000,0000,0000,,Бізді бұл сұмдыққа әкелуді доғар.
Dialogue: 0,0:16:48.42,0:16:51.84,Bottom,,0000,0000,0000,,Сіз жасай алатын ең жақсы нәрсе - оны басқаларға таратпау.
Dialogue: 0,0:16:49.55,0:16:51.84,Top,,0000,0000,0000,,Бізді бұл сұмдыққа әкелуді доғар. (Адам) О, о!
Dialogue: 0,0:16:51.92,0:16:53.47,Bottom,,0000,0000,0000,,Мен қысқа айналдырдым ба?
Dialogue: 0,0:16:51.92,0:16:53.47,Top,,0000,0000,0000,,Мен мұны бұрын айттым.
Dialogue: 0,0:16:53.55,0:16:56.18,Bottom,,0000,0000,0000,,Мен оқу ақысын төлегенімде сізге бәрібір деп ойладым.
Dialogue: 0,0:16:53.55,0:16:56.18,Top,,0000,0000,0000,,Оқу ақысын төлеп тұрғанда қиындық жоқ па?
Dialogue: 0,0:16:56.26,0:17:01.22,Bottom,,0000,0000,0000,,Мен кеше анамның директордан кешірім сұрауға келгенін естідім.
Dialogue: 0,0:16:56.26,0:17:01.22,Top,,0000,0000,0000,,Анаң кеше мектепке келіп, басын иді, солай ма?
Dialogue: 0,0:17:01.31,0:17:05.48,Bottom,,0000,0000,0000,,Нәрестенің қуылып кетпеуі үшін жылауы керемет көрініс тудырды, солай ма?
Dialogue: 0,0:17:01.31,0:17:05.52,Top,,0000,0000,0000,,Менің ойымша, ол ұлының жұмыстан шығуына жол бермеу үшін қатты қиналған шығар?
Dialogue: 0,0:17:05.56,0:17:06.85,Bottom,,0000,0000,0000,,Ұятсыз.
Dialogue: 0,0:17:05.60,0:17:06.85,Top,,0000,0000,0000,,Көрінбейтін
Dialogue: 0,0:17:06.94,0:17:09.57,Bottom,,0000,0000,0000,,Білесіз бе, бұл мен үшін әрқашан жұмбақ болды…
Dialogue: 0,0:17:06.94,0:17:09.69,Top,,0000,0000,0000,,Сіз бұл біртүрлі деп ойламайсыз ба?
Dialogue: 0,0:17:09.65,0:17:13.11,Bottom,,0000,0000,0000,,Ол сізді бірінші кезекте Арасака академиясына жіберуге қалай мүмкіндік алды?
Dialogue: 0,0:17:09.77,0:17:13.11,Top,,0000,0000,0000,,Анаңның табысымен оқу ақысын қалай төлей аласың?
Dialogue: 0,0:17:13.19,0:17:16.11,Bottom,,0000,0000,0000,,Дэвид Мартинес, түсіндіру керек пе?
Dialogue: 0,0:17:13.19,0:17:16.11,Top,,0000,0000,0000,,Түсіндіре аласыз ба? Дэвид Мартинес
Dialogue: 0,0:17:16.20,0:17:17.91,Top,,0000,0000,0000,,‎Анаң қалай?
Dialogue: 0,0:17:16.20,0:17:20.62,Bottom,,0000,0000,0000,,Мектептегі ақшаңызды төлеу үшін анаңыз не істейді?
Dialogue: 0,0:17:17.99,0:17:20.62,Top,,0000,0000,0000,,Арасака академиясында оқу ақысын төлеу үшін ақша тауып жатырсыз ба?
Dialogue: 0,0:17:20.70,0:17:24.87,Top,,0000,0000,0000,,Түнгі қаланың төменгі жағындағы жігіттер заңсыз пайда тапса ше?
Dialogue: 0,0:17:20.70,0:17:26.29,Bottom,,0000,0000,0000,,Кез келген Night City астыңғы тамақтандыру құрылғысы жылдам еуробак жасау үшін не істейді, иә?
Dialogue: 0,0:17:24.96,0:17:28.46,Top,,0000,0000,0000,,Мұны істеудің бір ғана жолы бар емес пе? Бұл заңсыз ба?
Dialogue: 0,0:17:26.37,0:17:28.42,Bottom,,0000,0000,0000,,Ойыма бірнеше нәрсе келеді...
Dialogue: 0,0:17:28.50,0:17:29.63,Bottom,,0000,0000,0000,,Жетеді бұл сұмдық.
Dialogue: 0,0:17:28.54,0:17:29.63,Top,,0000,0000,0000,,‎Ақымақ
Dialogue: 0,0:17:29.71,0:17:31.88,Bottom,,0000,0000,0000,,Уа, біз біттік деп кім айтты?
Dialogue: 0,0:17:29.71,0:17:31.88,Top,,0000,0000,0000,,Күте тұрыңыз, әңгіме біткен жоқ.
Dialogue: 0,0:17:31.96,0:17:33.21,Bottom,,0000,0000,0000,,​​Жоқ!
Dialogue: 0,0:17:31.96,0:17:34.13,Top,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:17:35.38,0:17:38.09,Top,,0000,0000,0000,,‎N haa hoi haa!
Dialogue: 0,0:17:35.51,0:17:36.38,Bottom,,0000,0000,0000,,Тозақ?
Dialogue: 0,0:17:38.76,0:17:39.47,Top,,0000,0000,0000,,Уф...
Dialogue: 0,0:17:43.14,0:17:45.10,Bottom,,0000,0000,0000,,Иә? Не?
Dialogue: 0,0:17:43.35,0:17:46.10,Top,,0000,0000,0000,,А? иә? о?
Dialogue: 0,0:17:45.18,0:17:46.60,Bottom,,0000,0000,0000,,Біздің руға шабуыл жасаған Маскалылар Эбису-саманың…
Dialogue: 0,0:17:46.69,0:17:48.60,Bottom,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:46.77,0:17:48.60,Top,,0000,0000,0000,,‎Қане?
Dialogue: 0,0:17:48.69,0:17:49.56,Top,,0000,0000,0000,,Аспаз
Dialogue: 0,0:17:51.32,0:17:52.07,Top,,0000,0000,0000,,Жақсы…
Dialogue: 0,0:17:53.07,0:17:56.49,Bottom,,0000,0000,0000,,Сізде не бар? Қандай да бір тегін бағдарлама?
Dialogue: 0,0:17:53.07,0:17:56.49,Top,,0000,0000,0000,,Сіз арзан ұрыс фишкаларын салып жатырсыз. Бұл тегін бе?
Dialogue: 0,0:17:56.57,0:17:58.86,Top,,0000,0000,0000,,Уф... ‎Хмм?
Dialogue: 0,0:17:58.95,0:18:01.49,Top,,0000,0000,0000,,Хмм? Хмм
Dialogue: 0,0:18:03.37,0:18:04.29,Top,,0000,0000,0000,,‎(созылу)
Dialogue: 0,0:18:04.37,0:18:05.62,Top,,0000,0000,0000,,‎Қандай!
Dialogue: 0,0:18:05.70,0:18:08.75,Top,,0000,0000,0000,,Қандай Чочочочочо…
Dialogue: 0,0:18:11.17,0:18:11.88,Top,,0000,0000,0000,,‎(Үлдеген дыбыс)
Dialogue: 0,0:18:22.47,0:18:28.02,Bottom,,0000,0000,0000,,Strongarms 400 шын мәнінде кунг-фу чиптерінің ең жақсысын шығарады.
Dialogue: 0,0:18:22.64,0:18:24.97,Top,,0000,0000,0000,,‎400 сериялы күшті қол және
Dialogue: 0,0:18:25.06,0:18:28.02,Top,,0000,0000,0000,,Арнайы кунг-фу чип комби - ең жақсысы.
Dialogue: 0,0:18:28.10,0:18:30.06,Bottom,,0000,0000,0000,,Шынайы ма? Органикалық түйіндер?
Dialogue: 0,0:18:28.10,0:18:31.06,Top,,0000,0000,0000,,Жалаң қол тым ақсақ. ‎Кек алғыңыз келсе⸺
Dialogue: 0,0:18:30.15,0:18:34.11,Bottom,,0000,0000,0000,,Мені қайталап көргіңіз келсе, хромды жинап алғаныңыз жөн.
Dialogue: 0,0:18:31.15,0:18:34.53,Top,,0000,0000,0000,,Сәл жақсырақ имплант орнатайық.
Dialogue: 0,0:18:34.61,0:18:36.49,Top,,0000,0000,0000,,Егер қолыңнан келмесе, мектепті таста.
Dialogue: 0,0:18:34.61,0:18:36.99,Bottom,,0000,0000,0000,,Немесе жай ғана мектепті тастап кетті.
Dialogue: 0,0:18:36.57,0:18:38.53,Top,,0000,0000,0000,,‎G… ah… ah…
Dialogue: 0,0:18:39.74,0:18:43.66,Top,,0000,0000,0000,,‎(Holocall рингтоны) ‎Haa haa…
Dialogue: 0,0:18:43.74,0:18:44.49,Top,,0000,0000,0000,,‎(Жауап дыбысы)
Dialogue: 0,0:18:44.49,0:18:51.17,Bottom,,0000,0000,0000,,Мартинес мырза? Мен Глория Мартинестің жағдайына байланысты қоңырау шалып жатырмын ...
Dialogue: 0,0:18:44.58,0:18:47.00,Top,,0000,0000,0000,,(Дәрігер) Айвид Бұл Мартинес мырза ма?
Dialogue: 0,0:18:47.08,0:18:51.17,Top,,0000,0000,0000,,Мен сізге Глория Мартинестің жағдайы туралы хабарлаймын.
Dialogue: 0,0:18:51.75,0:18:52.46,Top,,0000,0000,0000,,Не?
Dialogue: 0,0:18:52.46,0:18:57.67,Bottom,,0000,0000,0000,,Ол бүгін таңертең тұрақты болды, бірақ оның өмірлік мүшелері күтпеген жерден мұрнынан айнып кетті.
Dialogue: 0,0:18:52.54,0:18:54.96,Top,,0000,0000,0000,,(Дәрігер) Бүгін таңға дейін ол өте тұрақты болды.
Dialogue: 0,0:18:55.05,0:18:57.67,Top,,0000,0000,0000,,Кенеттен, кенеттен, қайтыс болды.
Dialogue: 0,0:18:58.26,0:19:02.64,Bottom,,0000,0000,0000,,Бірақ сіз айттыңыз... Сіз операцияның жақсы өткенін айттыңыз.
Dialogue: 0,0:18:58.30,0:19:02.68,Top,,0000,0000,0000,,Өмірге қауіп төндіретін жарақаттар жоқ деп айтпадың ба?
Dialogue: 0,0:19:02.72,0:19:04.89,Bottom,,0000,0000,0000,,Оның денесі әлдеқашан әлсіз еді.
Dialogue: 0,0:19:02.76,0:19:04.97,Top,,0000,0000,0000,,(Дәрігер) Бұл ең төменгі курс.
Dialogue: 0,0:19:04.97,0:19:08.56,Bottom,,0000,0000,0000,,Ол жеңілдіктер пакетінде болмаса да, ұзақ өмір сүре алмас еді.
Dialogue: 0,0:19:05.06,0:19:08.52,Top,,0000,0000,0000,,Апат болмаса да, сіздің денеңіз өте әлсіз болған болуы керек, солай емес пе?
Dialogue: 0,0:19:08.60,0:19:11.23,Top,,0000,0000,0000,,‎(Дәрігер) Жұмысқа байланысты шектен шығып кеткеніңізді естідім. А...
Dialogue: 0,0:19:08.64,0:19:10.64,Bottom,,0000,0000,0000,,Ол шамадан тыс жұмыс істеген сияқты.
Dialogue: 0,0:19:11.19,0:19:14.44,Bottom,,0000,0000,0000,,Мұнда жерлеудің кейбір нұсқаларын ұсынамыз.
Dialogue: 0,0:19:11.31,0:19:14.44,Top,,0000,0000,0000,,(Дәрігер) Бұл өлімді тіркеу және жерлеу туралы есеп беру ақпараты.
Dialogue: 0,0:19:14.52,0:19:17.99,Top,,0000,0000,0000,,Түнгі қалада мен де көп жұмыс істемейтінімді тексеруім керек.
Dialogue: 0,0:19:14.52,0:19:18.36,Bottom,,0000,0000,0000,,Барлығының Night City-де корпоративтік концертті қалайтынының себебі бар, балам.
Dialogue: 0,0:19:18.44,0:19:21.32,Bottom,,0000,0000,0000,,​​Құрметті тұтынушы, жоғалтқаныңыз үшін кешірім сұраймыз.
Dialogue: 0,0:19:18.49,0:19:20.95,Top,,0000,0000,0000,,(AI дауысы) Осы уақытта көңіл айтамын.
Dialogue: 0,0:19:21.41,0:19:25.83,Bottom,,0000,0000,0000,,Біз марқұмның денесін үйіңізге немесе жерлеу орталығына жеткізе аламыз.
Dialogue: 0,0:19:21.45,0:19:25.28,Top,,0000,0000,0000,,Мәйітке келетін болсақ, біз оны үйіңізге немесе жерлеу компаниясына жеткізе аламыз.
Dialogue: 0,0:19:25.87,0:19:27.04,Top,,0000,0000,0000,,Төлем туралы
Dialogue: 0,0:19:25.91,0:19:29.45,Bottom,,0000,0000,0000,,Біздің төлем жоспарларымыз туралы білгіңіз келе ме?
Dialogue: 0,0:19:27.12,0:19:29.45,Top,,0000,0000,0000,,Мен сізге біраз ақпарат берсем болады ма?
Dialogue: 0,0:19:29.54,0:19:31.79,Top,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:19:30.04,0:19:31.79,Bottom,,0000,0000,0000,,Менің таңдауым бар ма?
Dialogue: 0,0:19:31.87,0:19:33.38,Top,,0000,0000,0000,,(AI дауысы) Егер солай болса, бұл орынды.
Dialogue: 0,0:19:31.87,0:19:35.71,Bottom,,0000,0000,0000,,Біздің бюджеттік кремация қызметіміз сізге сәйкес келе ме?
Dialogue: 0,0:19:33.46,0:19:35.75,Top,,0000,0000,0000,,Үйге апаратын кремация курсы туралы не деуге болады?
Dialogue: 0,0:19:35.79,0:19:37.92,Bottom,,0000,0000,0000,,Жеткізу ақыларынан бас тартыңыз және…
Dialogue: 0,0:19:35.84,0:19:37.92,Top,,0000,0000,0000,,кремация және дереу үйге апару...
Dialogue: 0,0:19:40.55,0:19:42.13,Top,,0000,0000,0000,,(дыбыстық дыбыс)
Dialogue: 0,0:19:42.80,0:19:43.93,Top,,0000,0000,0000,,‎(Құлаған дыбыс)
Dialogue: 0,0:19:46.01,0:19:47.22,Bottom,,0000,0000,0000,,Қайырлы күн, Мартинес ханым.
Dialogue: 0,0:19:46.01,0:19:47.39,Top,,0000,0000,0000,,(Дауыстық пошта: Басшы) Мартинес мырза
Dialogue: 0,0:19:47.31,0:19:51.44,Bottom,,0000,0000,0000,,Біз зақымдалған жүйелік инфрақұрылымды жөндеуге баға алдық.
Dialogue: 0,0:19:47.47,0:19:52.02,Top,,0000,0000,0000,,Академия жүйесін қалпына келтіруге қатысты төлем сомасы шешілді.
Dialogue: 0,0:19:51.52,0:19:56.94,Bottom,,0000,0000,0000,,Мен сізге келісілгендей мәліметтерді жібердім. Немесе ойлануға уақытыңыз болған шығар?
Dialogue: 0,0:19:52.10,0:19:53.94,Top,,0000,0000,0000,,Жақсы екеніңізге сенімдісіз бе?
Dialogue: 0,0:19:54.02,0:19:56.94,Top,,0000,0000,0000,,Жоқ, егер сіз оны төлей алсаңыз, бұл жақсы.
Dialogue: 0,0:19:57.02,0:19:59.90,Top,,0000,0000,0000,,Белгіленген мерзімде төлей алмасаңыз
Dialogue: 0,0:19:57.02,0:20:02.20,Bottom,,0000,0000,0000,,Төлемді уақытында төлей алмасаңыз, Дэвидті қуудан басқа амалымыз қалмайды...
Dialogue: 0,0:19:59.99,0:20:02.20,Top,,0000,0000,0000,,Дэвид мектептен шығарылады...
Dialogue: 0,0:20:02.28,0:20:05.70,Bottom,,0000,0000,0000,,Коммуналдық қызмет туралы келісім-шартты жалғастырғыңыз келсе,
Dialogue: 0,0:20:02.28,0:20:05.70,Top,,0000,0000,0000,,(Электронды дауыс) Lifeline келісімшартын жалғастырғыңыз келсе,
Dialogue: 0,0:20:05.78,0:20:09.04,Bottom,,0000,0000,0000,,сізге 500 еуро доллар айыппұл төлеу керек болады
Dialogue: 0,0:20:05.78,0:20:09.04,Top,,0000,0000,0000,,Кешіктірілген төлемдерге қосымша айыппұл ретінде
Dialogue: 0,0:20:09.12,0:20:13.50,Bottom,,0000,0000,0000,,кез келген мерзімі өткен сомалар мен кешіктірілген төлемдерге қосымша.
Dialogue: 0,0:20:09.12,0:20:13.58,Top,,0000,0000,0000,,500 Eddy төлемі қажет болатынын ескеріңіз.
Dialogue: 0,0:20:13.58,0:20:17.92,Bottom,,0000,0000,0000,,Төлемді жасай алмасаңыз, коммуналдық қызметтеріңіз өшіріледі…
Dialogue: 0,0:20:13.67,0:20:16.21,Top,,0000,0000,0000,,Назар аударыңыз, егер белгіленген мерзім өтіп кетсе,
Dialogue: 0,0:20:16.29,0:20:21.34,Top,,0000,0000,0000,,‎Интернет электр су Төтенше жағдай ‎Полиция тәртібімен...
Dialogue: 0,0:20:18.00,0:20:20.67,Bottom,,0000,0000,0000,,Жарақат тобы. Жолды дереу босатыңыз.
Dialogue: 0,0:20:21.38,0:20:26.47,Bottom,,0000,0000,0000,,Динг динг, Мартинес! Уақыт бітті! Жалдау мерзімі әлдеқашан өтіп кетті!
Dialogue: 0,0:20:21.42,0:20:24.84,Top,,0000,0000,0000,,(Дауыстық пошта: жалға беруші) Мартинес мырза: Жалдау ақысы әлі төленген жоқ.
Dialogue: 0,0:20:24.93,0:20:26.55,Top,,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,0:20:26.55,0:20:29.39,Bottom,,0000,0000,0000,,Осыны жалғастыра бер, мен сенің құлпын ауыстырмаймын.
Dialogue: 0,0:20:26.64,0:20:29.51,Top,,0000,0000,0000,,Алдыңғы есікті құлыптау жеткіліксіз, солай емес пе?
Dialogue: 0,0:20:29.47,0:20:34.35,Bottom,,0000,0000,0000,,Есегіңді көшеге лақтырамын, естідің бе?!
Dialogue: 0,0:20:29.60,0:20:31.43,Top,,0000,0000,0000,,‎Егер ол әрі қарай жалғаса берсе
Dialogue: 0,0:20:31.52,0:20:34.10,Top,,0000,0000,0000,,Мен сенен қазір шығуыңды өтінемін.
Dialogue: 0,0:20:44.57,0:20:46.32,Top,,0000,0000,0000,,‎(Дәуіттің күші)
Dialogue: 0,0:20:49.28,0:20:53.66,Top,,0000,0000,0000,,Кешегі имплант 10 000-ға сатылады дедіңіз ғой, солай ма?
Dialogue: 0,0:20:49.79,0:20:53.58,Bottom,,0000,0000,0000,,Мен сізге көрсеткен имплант... Сіз оны 10 мыңға алатыныңызды айттыңыз ба?
Dialogue: 0,0:20:54.25,0:20:56.21,Top,,0000,0000,0000,,6000? Жоқ, күте тұрыңыз.
Dialogue: 0,0:20:54.25,0:20:58.25,Bottom,,0000,0000,0000,,Енді алты ма? Таңдау, жоқ. Кеше ғана 10 дедіңіз!
Dialogue: 0,0:20:56.29,0:21:00.63,Top,,0000,0000,0000,,Сіз кеше 10 000 дедіңіз. Бұл, әрине, арзан емес.
Dialogue: 0,0:20:58.34,0:21:00.63,Bottom,,0000,0000,0000,,​​Сіз де, мен де оның әлдеқайда құнды екенін білеміз!
Dialogue: 0,0:21:00.71,0:21:02.67,Top,,0000,0000,0000,,Мен де аздап зерттедім!
Dialogue: 0,0:21:00.71,0:21:02.80,Bottom,,0000,0000,0000,,Иә, мен оны қарап шықтым және…
Dialogue: 0,0:21:05.55,0:21:08.18,Bottom,,0000,0000,0000,,Иә? Жақсы! Саған да құрт!
Dialogue: 0,0:21:05.63,0:21:08.10,Top,,0000,0000,0000,,Иә, мен түсіндім!
Dialogue: 0,0:21:08.18,0:21:09.10,Top,,0000,0000,0000,,Қарға!
Dialogue: 0,0:21:08.26,0:21:09.30,Bottom,,0000,0000,0000,,Бля!
Dialogue: 0,0:21:09.18,0:21:10.18,Top,,0000,0000,0000,,‎(қатты тыныс алу)
Dialogue: 0,0:21:10.26,0:21:13.27,Top,,0000,0000,0000,,‎(Голоколь қоңырау үні)
Dialogue: 0,0:21:14.31,0:21:18.44,Top,,0000,0000,0000,,Бұл бонито. Анаңның қайтыс болғанын естідім.
Dialogue: 0,0:21:18.52,0:21:20.40,Top,,0000,0000,0000,,Мен көңіл айтуым керек деп ойлаймын.
Dialogue: 0,0:21:20.48,0:21:23.24,Top,,0000,0000,0000,,Мен сені аяғым келмейді.
Dialogue: 0,0:21:23.32,0:21:26.91,Top,,0000,0000,0000,,Баламды оған жарамсыз мектепке беру.
Dialogue: 0,0:21:26.99,0:21:31.16,Top,,0000,0000,0000,,Қылмыспен айналысып, Ақырында жазатайым оқиғадан қайтыс болды.
Dialogue: 0,0:21:31.24,0:21:33.00,Top,,0000,0000,0000,,Бұл мағынасыз деп ойламайсыз ба?
Dialogue: 0,0:21:33.08,0:21:36.04,Top,,0000,0000,0000,,Әр адамның өзіне сәйкес келетін жолы болады.
Dialogue: 0,0:21:36.12,0:21:39.63,Top,,0000,0000,0000,,Одан ауытқысаң да, бақытты болмайтын шығарсың.
Dialogue: 0,0:21:40.54,0:21:43.05,Top,,0000,0000,0000,,Маманның өлімінен сен де сабақ ал.
Dialogue: 0,0:21:43.05,0:21:43.63,Top,,0000,0000,0000,,‎Сен де Маманның өлімінен сабақ алуың керек (Дәуіттің ауыр тыныс алуы)
Dialogue: 0,0:21:43.63,0:21:43.71,Top,,0000,0000,0000,,(Дэвидтің ауыр тыныс алуы)
Dialogue: 0,0:21:43.71,0:21:46.93,Top,,0000,0000,0000,,Кеше айтқанымдай, егер мен академияны тастасам...
Dialogue: 0,0:21:46.93,0:21:49.43,Top,,0000,0000,0000,,(Дэвидтің ауыр тыныс алуы)
Dialogue: 0,0:21:53.22,0:21:56.14,Top,,0000,0000,0000,,‎(Reperdoc) ‎О, хохохохо! (Қуыршақтың дем алған дауысы)
Dialogue: 0,0:21:56.14,0:21:56.23,Top,,0000,0000,0000,,(Қуыршақтың дем алған дауысы)
Dialogue: 0,0:21:56.23,0:21:57.31,Top,,0000,0000,0000,,‎Nfu yahaha!
Dialogue: 0,0:21:57.31,0:21:57.39,Top,,0000,0000,0000,,‎Nfu yahaha!
Dialogue: 0,0:21:57.39,0:21:58.15,Top,,0000,0000,0000,,‎Nfu yahaha! (дыбыстық дыбыс)
Dialogue: 0,0:21:58.23,0:22:00.48,Top,,0000,0000,0000,,‎Уау, уһ, ой, ой, ой...
Dialogue: 0,0:22:00.56,0:22:02.61,Bottom,,0000,0000,0000,,Тозақ... Бұл кім?
Dialogue: 0,0:22:00.56,0:22:02.61,Top,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:22:03.23,0:22:05.44,Bottom,,0000,0000,0000,,О. Дэвид, сәлем.
Dialogue: 0,0:22:03.28,0:22:05.53,Top,,0000,0000,0000,,Бұл не, Дәуіт?
Dialogue: 0,0:22:05.61,0:22:07.65,Top,,0000,0000,0000,,‎Ohhohohoho Бұл бірдей нәрсе ме?
Dialogue: 0,0:22:06.45,0:22:07.65,Bottom,,0000,0000,0000,,Бұл үлкен, жаман Сэнди?
Dialogue: 0,0:22:07.74,0:22:10.74,Top,,0000,0000,0000,,Қазір Satsu және Cyberpunk түнгі қалада.
Dialogue: 0,0:22:07.74,0:22:14.12,Bottom,,0000,0000,0000,,Қалада мұндай сұлулықты іздемейтін бірде-бір белгі немесе жөндеуші жоқ.
Dialogue: 0,0:22:10.82,0:22:13.70,Top,,0000,0000,0000,,Бұл мен іздеп жүрген бірінші дәрежелі қазына.
Dialogue: 0,0:22:14.20,0:22:15.41,Top,,0000,0000,0000,,Бұл қауіпті.
Dialogue: 0,0:22:14.20,0:22:18.17,Bottom,,0000,0000,0000,,Мен сізге айттым, сіз оны қолыңыздан алатындай есі дұрыс адамды таба алмайсыз.
Dialogue: 0,0:22:15.50,0:22:18.25,Top,,0000,0000,0000,,Олар сатып алушы таба алмағанын айтқан шығар.
Dialogue: 0,0:22:18.25,0:22:19.79,Bottom,,0000,0000,0000,,Мен мұнда сату үшін келген жоқпын.
Dialogue: 0,0:22:18.33,0:22:20.63,Top,,0000,0000,0000,,‎Жоқ, мен оны сатпаймын. ‎(Reperdoc) Әй?
Dialogue: 0,0:22:20.71,0:22:21.88,Top,,0000,0000,0000,,Бұл жігіт
Dialogue: 0,0:22:20.71,0:22:22.88,Bottom,,0000,0000,0000,,Мен мұны ... дәл осы жерде біріктіргім келеді.
Dialogue: 0,0:22:21.96,0:22:22.88,Top,,0000,0000,0000,,Маған
Dialogue: 0,0:22:22.96,0:22:24.63,Top,,0000,0000,0000,,Оны орнатыңыз!
Dialogue: 0,0:22:22.96,0:22:25.13,Bottom,,0000,0000,0000,,Менің хромдайтын уақытым келді.
Dialogue: 0,0:22:34.51,0:22:39.52,Top,,0000,0000,0000,,♪~
Dialogue: 0,0:23:57.72,0:24:02.73,Top,,0000,0000,0000,,~♪
Dialogue: 0,0:24:04.23,0:24:10.23,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory