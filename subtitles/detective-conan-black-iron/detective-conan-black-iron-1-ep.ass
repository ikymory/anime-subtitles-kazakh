Dialogue: 0,0:21:36.60,0:21:38.63,Default,,0000,0000,0000,,(
Dialogue: 0,0:21:36.60,0:21:38.63,Default,,0000,0000,0000,,Наоми
Dialogue: 0,0:21:36.60,0:21:38.63,Default,,0000,0000,0000,,)
Dialogue: 0,0:21:36.60,0:21:38.63,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:21:36.60,0:21:38.63,Default,,0000,0000,0000,,Жеңіске тұрып қошемет!
Dialogue: 0,0:21:36.60,0:21:38.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:38.63,0:21:55.08,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:55.08,0:21:56.58,Default,,0000,0000,0000,,Ha
Dialogue: 0,0:21:55.08,0:21:56.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:56.58,0:22:01.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:01.09,0:22:03.06,Default,,0000,0000,0000,,(Бурбон)
Dialogue: 0,0:22:01.09,0:22:03.06,Default,,0000,0000,0000,,《Неге мұнда...? 》
Dialogue: 0,0:22:03.06,0:22:05.56,Default,,0000,0000,0000,,
Dialogue: 0,0:22:03.06,0:22:05.56,Default,,0000,0000,0000,,《Күміс оқ...》
Dialogue: 0,0:22:05.56,0:22:07.56,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:05.56,0:22:07.56,Default,,0000,0000,0000,,Наоми ше?
Dialogue: 0,0:22:07.56,0:22:10.13,Default,,0000,0000,0000,,Дәретхана.
Dialogue: 0,0:22:07.56,0:22:10.13,Default,,0000,0000,0000,,Алдымен қайтайық.
Dialogue: 0,0:22:07.56,0:22:10.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:10.13,0:22:12.10,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:22:10.13,0:22:12.10,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:22:10.13,0:22:12.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:19.57,0:22:21.07,Default,,0000,0000,0000,,Ha
Dialogue: 0,0:22:19.57,0:22:21.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:21.07,0:22:22.57,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:22:26.08,0:22:29.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:22:26.08,0:22:29.08,Default,,0000,0000,0000,,Аққу
Dialogue: 0,0:22:26.08,0:22:29.08,Default,,0000,0000,0000,,)
Dialogue: 0,0:22:26.08,0:22:29.08,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:22:26.08,0:22:29.08,Default,,0000,0000,0000,,Бұл керемет болды
Dialogue: 0,0:22:26.08,0:22:29.08,Default,,0000,0000,0000,,Жас және кәрі аттестаттау
Dialogue: 0,0:22:26.08,0:22:29.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:29.08,0:22:31.58,Default,,0000,0000,0000,,(
Dialogue: 0,0:22:29.08,0:22:31.58,Default,,0000,0000,0000,,Курода
Dialogue: 0,0:22:29.08,0:22:31.58,Default,,0000,0000,0000,,)
Dialogue: 0,0:22:29.08,0:22:31.58,Default,,0000,0000,0000,,Бет қаңқасынан өсірілген бет➡
Dialogue: 0,0:22:31.58,0:22:34.59,Default,,0000,0000,0000,,Болжау - бұл
Dialogue: 0,0:22:31.58,0:22:34.59,Default,,0000,0000,0000,,Қандай жолмен?
Dialogue: 0,0:22:34.59,0:22:41.06,Default,,0000,0000,0000,,Белгілі
Dialogue: 0,0:22:34.59,0:22:41.06,Default,,0000,0000,0000,,Анатомия және статистикалық мәліметтер
Dialogue: 0,0:22:34.59,0:22:41.06,Default,,0000,0000,0000,,Есептеу үшін AI пайдаланасыз ба?
Dialogue: 0,0:22:34.59,0:22:41.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:41.06,0:22:43.60,Default,,0000,0000,0000,,Толық ақпарат алу үшін Наомиге хабарласыңыз...
Dialogue: 0,0:22:41.06,0:22:43.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:43.60,0:22:45.56,Default,,0000,0000,0000,,(Благодать)
Dialogue: 0,0:22:43.60,0:22:45.56,Default,,0000,0000,0000,,Бейне деректеріңіз болғанша➡
Dialogue: 0,0:22:45.56,0:22:48.07,Default,,0000,0000,0000,,AI технологиясымен автоматтандыру мүмкін
Dialogue: 0,0:22:45.56,0:22:48.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:48.07,0:22:52.07,Default,,0000,0000,0000,,(
Dialogue: 0,0:22:48.07,0:22:52.07,Default,,0000,0000,0000,,Курода
Dialogue: 0,0:22:48.07,0:22:52.07,Default,,0000,0000,0000,,)
Dialogue: 0,0:22:48.07,0:22:52.07,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:22:48.07,0:22:52.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:48.07,0:22:52.07,Default,,0000,0000,0000,,(
Dialogue: 0,0:22:48.07,0:22:52.07,Default,,0000,0000,0000,,Аққу
Dialogue: 0,0:22:48.07,0:22:52.07,Default,,0000,0000,0000,,)
Dialogue: 0,0:22:48.07,0:22:52.07,Default,,0000,0000,0000,,Қандай тамаша техника!
Dialogue: 0,0:22:48.07,0:22:52.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:52.07,0:22:57.11,Default,,0000,0000,0000,,(
Dialogue: 0,0:22:52.07,0:22:57.11,Default,,0000,0000,0000,,Ред
Dialogue: 0,0:22:52.07,0:22:57.11,Default,,0000,0000,0000,,)
Dialogue: 0,0:22:52.07,0:22:57.11,Default,,0000,0000,0000,,Макино мырза
Dialogue: 0,0:22:52.07,0:22:57.11,Default,,0000,0000,0000,,Үзіліс уақыты
Dialogue: 0,0:22:52.07,0:22:57.11,Default,,0000,0000,0000,,(Кёко Хори) Өте суық қой! Ертеңнен бастап шарф тағып жүремін.
Dialogue: 0,0:22:52.07,0:22:57.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:22:57.11,0:23:00.11,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:22:57.11,0:23:00.11,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:22:57.11,0:23:00.11,Default,,0000,0000,0000,,Бұған дейін Наоми ше?
Dialogue: 0,0:23:00.11,0:23:02.65,Default,,0000,0000,0000,,(
Dialogue: 0,0:23:00.11,0:23:02.65,Default,,0000,0000,0000,,Ред
Dialogue: 0,0:23:00.11,0:23:02.65,Default,,0000,0000,0000,,)
Dialogue: 0,0:23:00.11,0:23:02.65,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:23:00.11,0:23:02.65,Default,,0000,0000,0000,,Айтып тұрғасын...
Dialogue: 0,0:23:00.11,0:23:02.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:23:02.65,0:23:05.58,Default,,0000,0000,0000,,Таку
Dialogue: 0,0:23:02.65,0:23:05.58,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:23:02.65,0:23:05.58,Default,,0000,0000,0000,,Сол әйел
Dialogue: 0,0:23:02.65,0:23:05.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:23:05.58,0:23:08.09,Default,,0000,0000,0000,,《Сен жассың ба, әлде кәрісің бе...》
Dialogue: 0,0:23:08.09,0:23:10.06,Default,,0000,0000,0000,,
Dialogue: 0,0:23:08.09,0:23:10.06,Default,,0000,0000,0000,,Ол шықты
Dialogue: 0,0:23:08.09,0:23:10.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:23:10.06,0:23:13.06,Default,,0000,0000,0000,,(Благодать)
Dialogue: 0,0:23:10.06,0:23:13.06,Default,,0000,0000,0000,,12 минут бұрынғы бейне.
Dialogue: 0,0:23:10.06,0:23:13.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:23:15.06,0:23:18.60,Default,,0000,0000,0000,,
Dialogue: 0,0:23:15.06,0:23:18.60,Default,,0000,0000,0000,,Камерада не көрінеді?
Dialogue: 0,0:23:15.06,0:23:18.60,Default,,0000,0000,0000,,Бұл соңғы рет
Dialogue: 0,0:23:15.06,0:23:18.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:23:18.60,0:23:21.10,Default,,0000,0000,0000,,2 тазалаушы персонал
Dialogue: 0,0:23:18.60,0:23:21.10,Default,,0000,0000,0000,,Иә, бірақ➡
Dialogue: 0,0:23:21.10,0:23:24.17,Default,,0000,0000,0000,,5 минуттан кейін шығады.
Dialogue: 0,0:23:21.10,0:23:24.17,Default,,0000,0000,0000,,.
Dialogue: 0,0:23:24.17,0:23:26.61,Default,,0000,0000,0000,,Адамдар сол арбаға міне алады.
Dialogue: 0,0:23:24.17,0:23:26.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:23:26.61,0:23:29.07,Default,,0000,0000,0000,,О
Dialogue: 0,0:23:26.61,0:23:29.07,Default,,0000,0000,0000,,Біраз
Dialogue: 0,0:23:26.61,0:23:29.07,Default,,0000,0000,0000,,Мынаны қараңыз
Dialogue: 0,0:23:26.61,0:23:29.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:23:29.07,0:23:31.44,Default,,0000,0000,0000,,Құрғақ палубадағы сол жігіттер.
Dialogue: 0,0:23:29.07,0:23:31.44,Default,,0000,0000,0000,,.
Dialogue: 0,0:23:34.08,0:23:36.05,Default,,0000,0000,0000,,
Dialogue: 0,0:23:34.08,0:23:36.05,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:23:34.08,0:23:36.05,Default,,0000,0000,0000,,Бұл өте талғамсыз екен.
Dialogue: 0,0:23:34.08,0:23:36.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:23:38.62,0:23:41.09,Default,,0000,0000,0000,,(
Dialogue: 0,0:23:38.62,0:23:41.09,Default,,0000,0000,0000,,Аққу
Dialogue: 0,0:23:38.62,0:23:41.09,Default,,0000,0000,0000,,)
Dialogue: 0,0:23:38.62,0:23:41.09,Default,,0000,0000,0000,,Осы жерден теңізге дейін
Dialogue: 0,0:23:38.62,0:23:41.09,Default,,0000,0000,0000,,Сіз кете аласыз, солай ма?
Dialogue: 0,0:23:41.09,0:23:44.12,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:23:41.09,0:23:44.12,Default,,0000,0000,0000,,Бөлмені теңіз суымен толтырыңыз➡
Dialogue: 0,0:23:44.12,0:23:47.16,Default,,0000,0000,0000,,Су қысымын сыртқы қысыммен сәйкестендіргеннен кейін
Dialogue: 0,0:23:44.12,0:23:47.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:23:47.16,0:23:49.56,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:23:47.16,0:23:49.56,Default,,0000,0000,0000,,Алда теңіз
Dialogue: 0,0:23:47.16,0:23:49.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:23:49.56,0:23:53.57,Default,,0000,0000,0000,,Хачиджо Кодзима
Dialogue: 0,0:23:49.56,0:23:53.57,Default,,0000,0000,0000,,Тіпті ең жақын Хачижо Кодзимада
Dialogue: 0,0:23:49.56,0:23:53.57,Default,,0000,0000,0000,,5 км-ден астам
Dialogue: 0,0:23:49.56,0:23:53.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:23:53.57,0:23:56.07,Default,,0000,0000,0000,,Наоми
Dialogue: 0,0:23:53.57,0:23:56.07,Default,,0000,0000,0000,,Жердің қай жерінде...
Dialogue: 0,0:23:53.57,0:23:56.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:23:56.07,0:24:00.07,Default,,0000,0000,0000,,(
Dialogue: 0,0:23:56.07,0:24:00.07,Default,,0000,0000,0000,,Курода
Dialogue: 0,0:23:56.07,0:24:00.07,Default,,0000,0000,0000,,)
Dialogue: 0,0:23:56.07,0:24:00.07,Default,,0000,0000,0000,,Бұл есікті кім басқарады?
Dialogue: 0,0:24:02.07,0:24:05.08,Default,,0000,0000,0000,,Бұл люк
Dialogue: 0,0:24:02.07,0:24:05.08,Default,,0000,0000,0000,,Тікелей
Dialogue: 0,0:24:02.07,0:24:05.08,Default,,0000,0000,0000,,Оны ашуға болады➡
Dialogue: 0,0:24:05.08,0:24:08.61,Default,,0000,0000,0000,,Теңіз жағасындағы люкті кім аша алады?
Dialogue: 0,0:24:05.08,0:24:08.61,Default,,0000,0000,0000,,Менімен➡
Dialogue: 0,0:24:08.61,0:24:12.58,Default,,0000,0000,0000,,Қалғандары
Dialogue: 0,0:24:08.61,0:24:12.58,Default,,0000,0000,0000,,Бұрын енгізілгендей
Dialogue: 0,0:24:08.61,0:24:12.58,Default,,0000,0000,0000,,Тек инженерлер
Dialogue: 0,0:24:08.61,0:24:12.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:24:12.58,0:24:16.56,Default,,0000,0000,0000,,Егер
Dialogue: 0,0:24:12.58,0:24:16.56,Default,,0000,0000,0000,,Наоми-сан
Dialogue: 0,0:24:12.58,0:24:16.56,Default,,0000,0000,0000,,Ұрлаушының сыбайласы➡
Dialogue: 0,0:24:16.56,0:24:19.06,Default,,0000,0000,0000,,онда болады
Dialogue: 0,0:24:16.56,0:24:19.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:24:19.06,0:24:22.56,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:24:19.06,0:24:22.56,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:24:19.06,0:24:22.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:24:22.56,0:24:26.57,Default,,0000,0000,0000,,Қалай болғанда да
Dialogue: 0,0:24:22.56,0:24:26.57,Default,,0000,0000,0000,,Елордалық полиция департаментінен оқиға орнына келуді сұраңыз
Dialogue: 0,0:24:22.56,0:24:26.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:24:28.10,0:24:31.64,Default,,0000,0000,0000,,《Осындай қысқа мерзімде ұрлау...
Dialogue: 0,0:24:28.10,0:24:31.64,Default,,0000,0000,0000,,Сөзсіз》
Dialogue: 0,0:24:31.64,0:24:35.07,Default,,0000,0000,0000,,《Кінәлі – Наоми.
Dialogue: 0,0:24:31.64,0:24:35.07,Default,,0000,0000,0000,,Мен сіздің ваннада екеніңізді білдім》
Dialogue: 0,0:24:35.07,0:24:37.04,Default,,0000,0000,0000,,《Және
Dialogue: 0,0:24:35.07,0:24:37.04,Default,,0000,0000,0000,,Қайда? 》
Dialogue: 0,0:25:00.03,0:25:02.03,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:25:00.03,0:25:02.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:25:05.04,0:25:07.51,Default,,0000,0000,0000,,
Dialogue: 0,0:25:05.04,0:25:07.51,Default,,0000,0000,0000,,О.
Dialogue: 0,0:25:05.04,0:25:07.51,Default,,0000,0000,0000,,Сүйкімді
Dialogue: 0,0:25:05.04,0:25:07.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:25:09.54,0:25:11.51,Default,,0000,0000,0000,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:25:09.54,0:25:11.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:25:15.11,0:25:18.05,Default,,0000,0000,0000,,
Dialogue: 0,0:25:15.11,0:25:18.05,Default,,0000,0000,0000,,Сурет файлына ұқсайды
Dialogue: 0,0:25:15.11,0:25:18.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:25:18.05,0:25:19.55,Default,,0000,0000,0000,,(
Dialogue: 0,0:25:18.05,0:25:19.55,Default,,0000,0000,0000,,Тінтуірді басқан дыбыс
Dialogue: 0,0:25:18.05,0:25:19.55,Default,,0000,0000,0000,,)
Dialogue: 0,0:25:21.52,0:25:24.02,Default,,0000,0000,0000,,Шын жүректен осылай сезінемін
Dialogue: 0,0:25:21.52,0:25:24.02,Default,,0000,0000,0000,,
Dialogue: 0,0:25:21.52,0:25:24.02,Default,,0000,0000,0000,,Шерри
Dialogue: 0,0:25:21.52,0:25:24.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:25:24.02,0:25:27.03,Default,,0000,0000,0000,,Көрші бала
Dialogue: 0,0:25:24.02,0:25:27.03,Default,,0000,0000,0000,,Ұқсас
Dialogue: 0,0:25:24.02,0:25:27.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:25:27.03,0:25:28.99,Default,,0000,0000,0000,,Бұл менің бала кезімдегі Шери ме?
Dialogue: 0,0:25:28.99,0:25:31.53,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:25:28.99,0:25:31.53,Default,,0000,0000,0000,,Бұл соңғы сурет.
Dialogue: 0,0:25:28.99,0:25:31.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:25:31.53,0:25:35.60,Default,,0000,0000,0000,,Арттағы бейбақ қолына қара.
Dialogue: 0,0:25:31.53,0:25:35.60,Default,,0000,0000,0000,,Бұл соңғы үлгі.
Dialogue: 0,0:25:31.53,0:25:35.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:25:35.60,0:25:37.64,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:25:35.60,0:25:37.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:25:37.64,0:25:39.54,Default,,0000,0000,0000,,Басқаша айтқанда
Dialogue: 0,0:25:37.64,0:25:39.54,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:25:39.54,0:25:42.54,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:25:39.54,0:25:42.54,Default,,0000,0000,0000,,Бұл бала Шерри⁉
Dialogue: 0,0:25:46.01,0:25:49.55,Default,,0000,0000,0000,,(
Dialogue: 0,0:25:46.01,0:25:49.55,Default,,0000,0000,0000,,Джин
Dialogue: 0,0:25:46.01,0:25:49.55,Default,,0000,0000,0000,,)
Dialogue: 0,0:25:46.01,0:25:49.55,Default,,0000,0000,0000,,Бұл қандай әзіл?
Dialogue: 0,0:25:46.01,0:25:49.55,Default,,0000,0000,0000,,Арақ
Dialogue: 0,0:25:46.01,0:25:49.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:25:49.55,0:25:52.52,Default,,0000,0000,0000,,Шери
Dialogue: 0,0:25:49.55,0:25:52.52,Default,,0000,0000,0000,,Ол Белтри экспрессінде өлуі керек еді.
Dialogue: 0,0:25:49.55,0:25:52.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:25:54.62,0:25:57.02,Default,,0000,0000,0000,,｟Жарылыс дыбысы｠
Dialogue: 0,0:25:57.02,0:26:01.13,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:25:57.02,0:26:01.13,Default,,0000,0000,0000,,Бала бол
Dialogue: 0,0:25:57.02,0:26:01.13,Default,,0000,0000,0000,,Ол аман қалды!
Dialogue: 0,0:26:01.13,0:26:02.66,Default,,0000,0000,0000,,(
Dialogue: 0,0:26:01.13,0:26:02.66,Default,,0000,0000,0000,,Джин
Dialogue: 0,0:26:01.13,0:26:02.66,Default,,0000,0000,0000,,)
Dialogue: 0,0:26:01.13,0:26:02.66,Default,,0000,0000,0000,,Оған өз күнәларының ауырлығын түсіну үшін—
Dialogue: 0,0:26:02.66,0:26:05.03,Default,,0000,0000,0000,,
Dialogue: 0,0:26:02.66,0:26:05.03,Default,,0000,0000,0000,,Бұл қандай қулық?
Dialogue: 0,0:26:02.66,0:26:05.03,Default,,0000,0000,0000,,Мен түсінбеймін➡
Dialogue: 0,0:26:05.03,0:26:08.57,Default,,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:26:05.03,0:26:08.57,Default,,0000,0000,0000,,Ол ғалым
Dialogue: 0,0:26:05.03,0:26:08.57,Default,,0000,0000,0000,,Қазірге дейінгі тәжірибелердің нәтижелеріне сүйене отырып,
Dialogue: 0,0:26:05.03,0:26:08.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:26:08.57,0:26:11.54,Default,,0000,0000,0000,,Неліктен суретті жібермейсіз?
Dialogue: 0,0:26:11.54,0:26:15.54,Default,,0000,0000,0000,,(
Dialogue: 0,0:26:11.54,0:26:15.54,Default,,0000,0000,0000,,Джин
Dialogue: 0,0:26:11.54,0:26:15.54,Default,,0000,0000,0000,,)
Dialogue: 0,0:26:11.54,0:26:15.54,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:26:11.54,0:26:15.54,Default,,0000,0000,0000,,Тікелей қараңыз
Dialogue: 0,0:26:11.54,0:26:15.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:26:15.54,0:26:18.08,Default,,0000,0000,0000,,
Dialogue: 0,0:26:15.54,0:26:18.08,Default,,0000,0000,0000,,Сол кезде
Dialogue: 0,0:26:15.54,0:26:18.08,Default,,0000,0000,0000,,Баланы ұрлаңыз.
Dialogue: 0,0:26:15.54,0:26:18.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:26:18.08,0:26:21.61,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:26:18.08,0:26:21.61,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:26:18.08,0:26:21.61,Default,,0000,0000,0000,,Қайдасың?
Dialogue: 0,0:26:18.08,0:26:21.61,Default,,0000,0000,0000,,Мен түсінбеймін.
Dialogue: 0,0:26:18.08,0:26:21.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:26:21.61,0:26:26.62,Default,,0000,0000,0000,,(
Dialogue: 0,0:26:21.61,0:26:26.62,Default,,0000,0000,0000,,Джин
Dialogue: 0,0:26:21.61,0:26:26.62,Default,,0000,0000,0000,,)
Dialogue: 0,0:26:21.61,0:26:26.62,Default,,0000,0000,0000,,Мұндай адамды табу
Dialogue: 0,0:26:21.61,0:26:26.62,Default,,0000,0000,0000,,Қолайлы жүйе...
Dialogue: 0,0:26:21.61,0:26:26.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:26:30.06,0:26:32.92,Default,,0000,0000,0000,,Жаңа ғана түсіндің, солай ма?
Dialogue: 0,0:26:35.03,0:26:37.56,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:26:35.03,0:26:37.56,Default,,0000,0000,0000,,Аникиден күткендей
Dialogue: 0,0:26:35.03,0:26:37.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:26:37.56,0:26:39.06,Default,,0000,0000,0000,,(киль)
Dialogue: 0,0:26:37.56,0:26:39.06,Default,,0000,0000,0000,,Сіз мені ұрлауды жоспарлап отырсыз ба?
Dialogue: 0,0:26:39.06,0:26:41.57,Default,,0000,0000,0000,,
Dialogue: 0,0:26:39.06,0:26:41.57,Default,,0000,0000,0000,,Мен бас тартамын
Dialogue: 0,0:26:39.06,0:26:41.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:26:39.06,0:26:41.57,Default,,0000,0000,0000,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:26:41.57,0:26:44.07,Default,,0000,0000,0000,,Жоспарда не жоқ?
Dialogue: 0,0:26:41.57,0:26:44.07,Default,,0000,0000,0000,,Олай етпеу керек.
Dialogue: 0,0:26:41.57,0:26:44.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:26:44.07,0:26:46.61,Default,,0000,0000,0000,,(Вермут
Dialogue: 0,0:26:44.07,0:26:46.61,Default,,0000,0000,0000,,Дауыс
Dialogue: 0,0:26:44.07,0:26:46.61,Default,,0000,0000,0000,,)
Dialogue: 0,0:26:44.07,0:26:46.61,Default,,0000,0000,0000,,Жас аутентификациясын бұзу➡
Dialogue: 0,0:26:46.61,0:26:50.54,Default,,0000,0000,0000,,Өткен қауіпсіздік камерасының жазбаларынан
Dialogue: 0,0:26:46.61,0:26:50.54,Default,,0000,0000,0000,,Біздің іздерімізді өшіріңіз
Dialogue: 0,0:26:46.61,0:26:50.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:26:50.54,0:26:54.05,Default,,0000,0000,0000,,Бұл бастықтың бұйрығы.
Dialogue: 0,0:26:50.54,0:26:54.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:26:54.05,0:26:56.05,Default,,0000,0000,0000,,(Бурбон)
Dialogue: 0,0:26:54.05,0:26:56.05,Default,,0000,0000,0000,,Мен келісемін.
Dialogue: 0,0:26:54.05,0:26:56.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:26:56.05,0:26:59.55,Default,,0000,0000,0000,,(Бурбон)
Dialogue: 0,0:26:56.05,0:26:59.55,Default,,0000,0000,0000,,Жоспарланбаған қозғалыстар
Dialogue: 0,0:26:56.05,0:26:59.55,Default,,0000,0000,0000,,Жоспарлардың орындалмауы
Dialogue: 0,0:26:56.05,0:26:59.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:26:59.55,0:27:03.56,Default,,0000,0000,0000,,Мен де бұлай істеуден аулақ едім.
Dialogue: 0,0:26:59.55,0:27:03.56,Default,,0000,0000,0000,,Мынадай
Dialogue: 0,0:26:59.55,0:27:03.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:27:03.56,0:27:08.09,Default,,0000,0000,0000,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:27:03.56,0:27:08.09,Default,,0000,0000,0000,,Басынан бастап
Dialogue: 0,0:27:03.56,0:27:08.09,Default,,0000,0000,0000,,Менің сендермен топтасуға ниетім жоқ.
Dialogue: 0,0:27:03.56,0:27:08.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:27:08.09,0:27:10.63,Default,,0000,0000,0000,,Пингаға мұны істеуге рұқсат етіңіз.
Dialogue: 0,0:27:08.09,0:27:10.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:27:10.63,0:27:15.03,Default,,0000,0000,0000,,Сол Пинга
Dialogue: 0,0:27:10.63,0:27:15.03,Default,,0000,0000,0000,,Мен сені тыңдаймын ба?
Dialogue: 0,0:27:15.03,0:27:18.04,Default,,0000,0000,0000,,Рамның айтқанын тыңдау керек.
Dialogue: 0,0:27:15.03,0:27:18.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:27:18.04,0:27:21.04,Default,,0000,0000,0000,,бір рет
Dialogue: 0,0:27:18.04,0:27:21.04,Default,,0000,0000,0000,,Кюрасао Рамның оң қолы болды
Dialogue: 0,0:27:18.04,0:27:21.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:27:21.04,0:27:23.04,Default,,0000,0000,0000,,Енді Кюрасао қайтыс болды➡
Dialogue: 0,0:27:23.04,0:27:26.54,Default,,0000,0000,0000,,Рамның қасындағы адам
Dialogue: 0,0:27:23.04,0:27:26.54,Default,,0000,0000,0000,,Өйткені бұл Пинга.
Dialogue: 0,0:27:23.04,0:27:26.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:27:26.54,0:27:29.05,Default,,0000,0000,0000,,Пинга Рамға бағынады
Dialogue: 0,0:27:26.54,0:27:29.05,Default,,0000,0000,0000,,➡ деген не
Dialogue: 0,0:27:29.05,0:27:31.08,Default,,0000,0000,0000,,Неліктен деп ойлайсыңдар?
Dialogue: 0,0:27:31.08,0:27:35.05,Default,,0000,0000,0000,,Рам мені жақсы көреді
Dialogue: 0,0:27:31.08,0:27:35.05,Default,,0000,0000,0000,,Жоғары дәрежеге көтерілу.
Dialogue: 0,0:27:31.08,0:27:35.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:27:35.05,0:27:37.06,Default,,0000,0000,0000,,Мен білемін
Dialogue: 0,0:27:35.05,0:27:37.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:27:37.06,0:27:41.06,Default,,0000,0000,0000,,Біреуді тепсең де
Dialogue: 0,0:27:37.06,0:27:41.06,Default,,0000,0000,0000,,Ол да көтерілгісі келетін жігіт.
Dialogue: 0,0:27:37.06,0:27:41.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:27:41.06,0:27:43.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:27:41.06,0:27:43.03,Default,,0000,0000,0000,,Есіктің ашылу/жабылу дыбысы
Dialogue: 0,0:27:41.06,0:27:43.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:27:43.03,0:27:45.56,Default,,0000,0000,0000,,
Dialogue: 0,0:27:43.03,0:27:45.56,Default,,0000,0000,0000,,《Сосын
Dialogue: 0,0:27:43.03,0:27:45.56,Default,,0000,0000,0000,,Мұны сіз де білесіз бе? 》
Dialogue: 0,0:27:45.56,0:27:48.53,Default,,0000,0000,0000,,《Сол Пинга
Dialogue: 0,0:27:45.56,0:27:48.53,Default,,0000,0000,0000,,Ең көп тепкісі келетіні➡
Dialogue: 0,0:27:48.53,0:27:51.60,Default,,0000,0000,0000,,Бұл Джин》
Dialogue: 0,0:27:51.60,0:27:56.04,Default,,0000,0000,0000,,《Солай болса да,
Dialogue: 0,0:27:51.60,0:27:56.04,Default,,0000,0000,0000,,Жас және ескі аутентификация жүйесі➡
Dialogue: 0,0:27:56.04,0:28:00.55,Default,,0000,0000,0000,,Бұл ашылмайтын қазына сандығы болуы мүмкін...》
Dialogue: 0,0:28:00.55,0:28:02.55,Default,,0000,0000,0000,,Наоми ұрланған⁉
Dialogue: 0,0:28:02.55,0:28:07.05,Default,,0000,0000,0000,,Манга салмас бұрын жаттығулар
Dialogue: 0,0:28:02.55,0:28:07.05,Default,,0000,0000,0000,,Бізде
Dialogue: 0,0:28:02.55,0:28:07.05,Default,,0000,0000,0000,,Сыбайластары болуы мүмкін
Dialogue: 0,0:28:02.55,0:28:07.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:28:07.05,0:28:09.55,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:28:07.05,0:28:09.55,Default,,0000,0000,0000,,Ухммм… ммм…
Dialogue: 0,0:28:07.05,0:28:09.55,Default,,0000,0000,0000,,Бұл күлкілі!
Dialogue: 0,0:28:09.55,0:28:12.59,Default,,0000,0000,0000,,(
Dialogue: 0,0:28:09.55,0:28:12.59,Default,,0000,0000,0000,,Макино
Dialogue: 0,0:28:09.55,0:28:12.59,Default,,0000,0000,0000,,)
Dialogue: 0,0:28:09.55,0:28:12.59,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:28:09.55,0:28:12.59,Default,,0000,0000,0000,,Бірақ біз Интерполмыз
Dialogue: 0,0:28:09.55,0:28:12.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:28:12.59,0:28:16.06,Default,,0000,0000,0000,,Өзіне қарсы жасалған күдіктер
Dialogue: 0,0:28:12.59,0:28:16.06,Default,,0000,0000,0000,,Өзіңізді тазалаңыз
Dialogue: 0,0:28:12.59,0:28:16.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:28:16.06,0:28:20.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:28:16.06,0:28:20.03,Default,,0000,0000,0000,,Ред
Dialogue: 0,0:28:16.06,0:28:20.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:28:16.06,0:28:20.03,Default,,0000,0000,0000,,Су астындағы люктер журналы
Dialogue: 0,0:28:16.06,0:28:20.03,Default,,0000,0000,0000,,Егер сіз оны қарастырсаңыз
Dialogue: 0,0:28:16.06,0:28:20.03,Default,,0000,0000,0000,,Жақсы, солай ма?
Dialogue: 0,0:28:23.07,0:28:26.04,Default,,0000,0000,0000,,Журнал бұл...
Dialogue: 0,0:28:23.07,0:28:26.04,Default,,0000,0000,0000,,№.
Dialogue: 0,0:28:23.07,0:28:26.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:28:26.04,0:28:29.54,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:28:26.04,0:28:29.54,Default,,0000,0000,0000,,Сырттан бұзылған
Dialogue: 0,0:28:26.04,0:28:29.54,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:28:29.54,0:28:32.08,Default,,0000,0000,0000,,《Не?
Dialogue: 0,0:28:29.54,0:28:32.08,Default,,0000,0000,0000,,Сол бала》
Dialogue: 0,0:28:32.08,0:28:36.55,Default,,0000,0000,0000,,Бұл жүйе
Dialogue: 0,0:28:32.08,0:28:36.55,Default,,0000,0000,0000,,Жапон полициясы және
Dialogue: 0,0:28:32.08,0:28:36.55,Default,,0000,0000,0000,,Еурополға қосылған
Dialogue: 0,0:28:32.08,0:28:36.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:28:36.55,0:28:40.05,Default,,0000,0000,0000,,Бэк есік сол жерден қолжетімді
Dialogue: 0,0:28:36.55,0:28:40.05,Default,,0000,0000,0000,,Ол орнатылған болуы мүмкін.
Dialogue: 0,0:28:36.55,0:28:40.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:28:40.05,0:28:42.05,Default,,0000,0000,0000,,Артқы есік…
Dialogue: 0,0:28:40.05,0:28:42.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:28:42.05,0:28:44.52,Default,,0000,0000,0000,,Бұзылу үшін орнату
Dialogue: 0,0:28:42.05,0:28:44.52,Default,,0000,0000,0000,,Бұл артқы есік пе?
Dialogue: 0,0:28:42.05,0:28:44.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:28:44.52,0:28:47.06,Default,,0000,0000,0000,,Бұл сізді нысанаға алды дегенді білдіре ме?
Dialogue: 0,0:28:44.52,0:28:47.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:28:47.06,0:28:49.03,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:28:47.06,0:28:49.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:28:49.03,0:28:52.06,Default,,0000,0000,0000,,Франкфуртке кіру оқиғасы
Dialogue: 0,0:28:49.03,0:28:52.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:28:52.06,0:28:55.63,Default,,0000,0000,0000,,Қылмыскердің шын мақсаты қандай?
Dialogue: 0,0:28:52.06,0:28:55.63,Default,,0000,0000,0000,,Тынық мұхиты
Dialogue: 0,0:28:52.06,0:28:55.63,Default,,0000,0000,0000,,
Dialogue: 0,0:28:52.06,0:28:55.63,Default,,0000,0000,0000,,Қалтқы ➡
Dialogue: 0,0:28:55.63,0:28:58.54,Default,,0000,0000,0000,,Еуропамен байланыс
Dialogue: 0,0:28:55.63,0:28:58.54,Default,,0000,0000,0000,,Бүгін болса керек.
Dialogue: 0,0:28:55.63,0:28:58.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:28:58.54,0:29:00.54,Default,,0000,0000,0000,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:29:00.54,0:29:05.54,Default,,0000,0000,0000,,Компьютер қауіпсіздігі – бұл
Dialogue: 0,0:29:00.54,0:29:05.54,Default,,0000,0000,0000,,Іштен жасалған шабуылдарға әлсіз.
Dialogue: 0,0:29:00.54,0:29:05.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:29:05.54,0:29:10.05,Default,,0000,0000,0000,,Егер солай болса
Dialogue: 0,0:29:05.54,0:29:10.05,Default,,0000,0000,0000,,Сыбайлас қазір
Dialogue: 0,0:29:05.54,0:29:10.05,Default,,0000,0000,0000,,Europol
Dialogue: 0,0:29:05.54,0:29:10.05,Default,,0000,0000,0000,,-десіз бе?
Dialogue: 0,0:29:10.05,0:29:13.02,Default,,0000,0000,0000,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:29:10.05,0:29:13.02,Default,,0000,0000,0000,,Бэк есік жасалғаннан кейін➡
Dialogue: 0,0:29:13.02,0:29:16.09,Default,,0000,0000,0000,,Әлемнің кез келген жерінен басқаруға болады
Dialogue: 0,0:29:13.02,0:29:16.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:29:16.09,0:29:20.66,Default,,0000,0000,0000,,(
Dialogue: 0,0:29:16.09,0:29:20.66,Default,,0000,0000,0000,,Курода
Dialogue: 0,0:29:16.09,0:29:20.66,Default,,0000,0000,0000,,)
Dialogue: 0,0:29:16.09,0:29:20.66,Default,,0000,0000,0000,,Басқаша айтқанда
Dialogue: 0,0:29:16.09,0:29:20.66,Default,,0000,0000,0000,,Оларға ілеспе — мына жаққа оралыңдар!
Dialogue: 0,0:29:16.09,0:29:20.66,Default,,0000,0000,0000,,Сыбайластың болуы мүмкіндігі сақталады➡
Dialogue: 0,0:29:20.66,0:29:24.03,Default,,0000,0000,0000,,...Сондықтан
Dialogue: 0,0:29:20.66,0:29:24.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:29:24.03,0:29:28.63,Default,,0000,0000,0000,,《Олардың мақсаты болса керек
Dialogue: 0,0:29:24.03,0:29:28.63,Default,,0000,0000,0000,,Жас және ескі аутентификация жүйесі》
Dialogue: 0,0:29:28.63,0:29:31.50,Default,,0000,0000,0000,,｟Код атауы
Dialogue: 0,0:29:28.63,0:29:31.50,Default,,0000,0000,0000,,Пинга
Dialogue: 0,0:29:31.50,0:29:35.04,Default,,0000,0000,0000,,《Мұнда
Dialogue: 0,0:29:31.50,0:29:35.04,Default,,0000,0000,0000,,Олардың достары бар ма?
Dialogue: 0,0:29:35.04,0:29:38.08,Default,,0000,0000,0000,,《Немесе...》
Dialogue: 0,0:29:38.08,0:29:42.11,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:29:38.08,0:29:42.11,Default,,0000,0000,0000,,Баршаңызға
Dialogue: 0,0:29:38.08,0:29:42.11,Default,,0000,0000,0000,,Смартфон немесе
Dialogue: 0,0:29:38.08,0:29:42.11,Default,,0000,0000,0000,,Компьютерді өз еркімен тапсыру және т.б.➡
Dialogue: 0,0:29:42.11,0:29:44.52,Default,,0000,0000,0000,,және
