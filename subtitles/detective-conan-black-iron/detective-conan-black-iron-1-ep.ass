Dialogue: 0,1:17:27.98,1:17:32.91,Default,,0000,0000,0000,,.
Dialogue: 0,1:17:32.91,1:17:35.42,Default,,0000,0000,0000,,(
Dialogue: 0,1:17:32.91,1:17:35.42,Default,,0000,0000,0000,,Наоми
Dialogue: 0,1:17:32.91,1:17:35.42,Default,,0000,0000,0000,,)
Dialogue: 0,1:17:32.91,1:17:35.42,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:17:32.91,1:17:35.42,Default,,0000,0000,0000,,Мен саған көмектесемін
Dialogue: 0,1:17:32.91,1:17:35.42,Default,,0000,0000,0000,,.
Dialogue: 0,1:17:36.92,1:17:39.42,Default,,0000,0000,0000,,Сізді ұрлаған кезде қандай жағдайлар болды?
Dialogue: 0,1:17:36.92,1:17:39.42,Default,,0000,0000,0000,,біз төрт жылдан бері соғыста жүргеніміз?
Dialogue: 0,1:17:39.42,1:17:43.39,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:17:39.42,1:17:43.39,Default,,0000,0000,0000,,Эфир мені ұйықтатты.
Dialogue: 0,1:17:39.42,1:17:43.39,Default,,0000,0000,0000,,.
Dialogue: 0,1:17:39.42,1:17:43.39,Default,,0000,0000,0000,,Эфир?
Dialogue: 0,1:17:43.39,1:17:47.43,Default,,0000,0000,0000,,Соның негізінде
Dialogue: 0,1:17:43.39,1:17:47.43,Default,,0000,0000,0000,,Менің ойымша, бұл Пинга жасаған анестетик.
Dialogue: 0,1:17:43.39,1:17:47.43,Default,,0000,0000,0000,,.
Dialogue: 0,1:17:47.43,1:17:52.50,Default,,0000,0000,0000,,Бояу еріткіштің иісі бар ма?
Dialogue: 0,1:17:47.43,1:17:52.50,Default,,0000,0000,0000,,Ах
Dialogue: 0,1:17:47.43,1:17:52.50,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,1:17:47.43,1:17:52.50,Default,,0000,0000,0000,,Олар бір-біріне ұқсайды.
Dialogue: 0,1:17:47.43,1:17:52.50,Default,,0000,0000,0000,,.
Dialogue: 0,1:17:52.50,1:17:58.41,Default,,0000,0000,0000,,Егер
Dialogue: 0,1:17:52.50,1:17:58.41,Default,,0000,0000,0000,,Леонхардт мырза
Dialogue: 0,1:17:52.50,1:17:58.41,Default,,0000,0000,0000,,Өлім алдында ұйықтатылды》
Dialogue: 0,1:17:58.41,1:18:01.91,Default,,0000,0000,0000,,Тағы бірдеңе естідіңіз бе?
Dialogue: 0,1:18:01.91,1:18:05.91,Default,,0000,0000,0000,,Мен бәрібір жақсы боламын. Бар күшімді саламын
Dialogue: 0,1:18:01.91,1:18:05.91,Default,,0000,0000,0000,,Жоспарланбаған әрекеттерге қатысты
Dialogue: 0,1:18:01.91,1:18:05.91,Default,,0000,0000,0000,,Мен ашуландым
Dialogue: 0,1:18:01.91,1:18:05.91,Default,,0000,0000,0000,,.
Dialogue: 0,1:18:05.91,1:18:09.92,Default,,0000,0000,0000,,Жоспарда жоқ...
Dialogue: 0,1:18:05.91,1:18:09.92,Default,,0000,0000,0000,,Бірақ бұл естеліктер мен үш-төрт жастағы кезімдегі ғой, иә?
Dialogue: 0,1:18:09.92,1:18:12.39,Default,,0000,0000,0000,,(
Dialogue: 0,1:18:09.92,1:18:12.39,Default,,0000,0000,0000,,Есіктің ашылған дыбысы
Dialogue: 0,1:18:09.92,1:18:12.39,Default,,0000,0000,0000,,)
Dialogue: 0,1:18:09.92,1:18:12.39,Default,,0000,0000,0000,,(
Dialogue: 0,1:18:09.92,1:18:12.39,Default,,0000,0000,0000,,Сато
Dialogue: 0,1:18:09.92,1:18:12.39,Default,,0000,0000,0000,,)
Dialogue: 0,1:18:09.92,1:18:12.39,Default,,0000,0000,0000,,Күткеніңізге рахмет
Dialogue: 0,1:18:09.92,1:18:12.39,Default,,0000,0000,0000,,.
Dialogue: 0,1:18:12.39,1:18:14.96,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:18:12.39,1:18:14.96,Default,,0000,0000,0000,,Өтінемін
Dialogue: 0,1:18:12.39,1:18:14.96,Default,,0000,0000,0000,,.
Dialogue: 0,1:18:12.39,1:18:14.96,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,1:18:12.39,1:18:14.96,Default,,0000,0000,0000,,.
Dialogue: 0,1:18:14.96,1:18:17.99,Default,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,1:18:14.96,1:18:17.99,Default,,0000,0000,0000,,(
Dialogue: 0,1:18:14.96,1:18:17.99,Default,,0000,0000,0000,,Наоми
Dialogue: 0,1:18:14.96,1:18:17.99,Default,,0000,0000,0000,,)
Dialogue: 0,1:18:14.96,1:18:17.99,Default,,0000,0000,0000,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,1:18:14.96,1:18:17.99,Default,,0000,0000,0000,,Жылы доп
Dialogue: 0,1:18:14.96,1:18:17.99,Default,,0000,0000,0000,,.
Dialogue: 0,1:18:14.96,1:18:17.99,Default,,0000,0000,0000,,(
Dialogue: 0,1:18:14.96,1:18:17.99,Default,,0000,0000,0000,,Сато
Dialogue: 0,1:18:14.96,1:18:17.99,Default,,0000,0000,0000,,)
Dialogue: 0,1:18:14.96,1:18:17.99,Default,,0000,0000,0000,,Киімді ауыстыру
Dialogue: 0,1:18:14.96,1:18:17.99,Default,,0000,0000,0000,,Мен оны осында қоямын.
Dialogue: 0,1:18:14.96,1:18:17.99,Default,,0000,0000,0000,,.
