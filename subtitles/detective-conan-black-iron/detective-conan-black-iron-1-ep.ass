Dialogue: 0,1:18:58.90,1:19:01.90,Default,,0000,0000,0000,,)
Dialogue: 0,1:18:58.90,1:19:01.90,Default,,0000,0000,0000,,Егер бұл операция сәтті өтсе,
Dialogue: 0,1:18:58.90,1:19:01.90,Default,,0000,0000,0000,,Ол жуғыш зат немесе басқа нәрсе болуы мүмкін деді.
Dialogue: 0,1:18:58.90,1:19:01.90,Default,,0000,0000,0000,,.
Dialogue: 0,1:19:01.90,1:19:05.47,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,1:19:01.90,1:19:05.47,Default,,0000,0000,0000,,Менің аузым ауырып қалды.
Dialogue: 0,1:19:01.90,1:19:05.47,Default,,0000,0000,0000,,Өте рахмет! (Ол Майт) Ахахаха!
Dialogue: 0,1:19:01.90,1:19:05.47,Default,,0000,0000,0000,,.
Dialogue: 0,1:19:05.47,1:19:07.88,Default,,0000,0000,0000,,(
Dialogue: 0,1:19:05.47,1:19:07.88,Default,,0000,0000,0000,,Анестезия инесінің енгізіліп жатқан дыбысы
Dialogue: 0,1:19:05.47,1:19:07.88,Default,,0000,0000,0000,,)
Dialogue: 0,1:19:05.47,1:19:07.88,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:19:05.47,1:19:07.88,Default,,0000,0000,0000,,А...
Dialogue: 0,1:19:05.47,1:19:07.88,Default,,0000,0000,0000,,.
Dialogue: 0,1:19:07.88,1:19:09.91,Default,,0000,0000,0000,,(
Dialogue: 0,1:19:07.88,1:19:09.91,Default,,0000,0000,0000,,Орхидея
Dialogue: 0,1:19:07.88,1:19:09.91,Default,,0000,0000,0000,,)
Dialogue: 0,1:19:07.88,1:19:09.91,Default,,0000,0000,0000,,Ах
Dialogue: 0,1:19:07.88,1:19:09.91,Default,,0000,0000,0000,,Әке!
Dialogue: 0,1:19:09.91,1:19:12.38,Default,,0000,0000,0000,,(
Dialogue: 0,1:19:09.91,1:19:12.38,Default,,0000,0000,0000,,Мегур
Dialogue: 0,1:19:09.91,1:19:12.38,Default,,0000,0000,0000,,)
Dialogue: 0,1:19:09.91,1:19:12.38,Default,,0000,0000,0000,,Сол сияқты, бір күні, бір жерде кездесесіздер.
Dialogue: 0,1:19:09.91,1:19:12.38,Default,,0000,0000,0000,,Моури-кун!
Dialogue: 0,1:19:09.91,1:19:12.38,Default,,0000,0000,0000,,(
Dialogue: 0,1:19:09.91,1:19:12.38,Default,,0000,0000,0000,,Когоро
Dialogue: 0,1:19:09.91,1:19:12.38,Default,,0000,0000,0000,,)
Dialogue: 0,1:19:09.91,1:19:12.38,Default,,0000,0000,0000,,Ауырсыну...
Dialogue: 0,1:19:09.91,1:19:12.38,Default,,0000,0000,0000,,.
Dialogue: 0,1:19:12.38,1:19:14.42,Default,,0000,0000,0000,,Мияу мияу!
Dialogue: 0,1:19:14.42,1:19:16.92,Default,,0000,0000,0000,,Не!?
Dialogue: 0,1:19:14.42,1:19:16.92,Default,,0000,0000,0000,,Ол ұзақ фильм сияқты көрінді, сондықтан мен оны көруге үлгермедім.
Dialogue: 0,1:19:14.42,1:19:16.92,Default,,0000,0000,0000,,Шын жүректен осылай сезінемін
Dialogue: 0,1:19:16.92,1:19:19.42,Default,,0000,0000,0000,,Ұйқыдағы Когоро!
Dialogue: 0,1:19:19.42,1:19:21.39,Default,,0000,0000,0000,,(
Dialogue: 0,1:19:19.42,1:19:21.39,Default,,0000,0000,0000,,Дауысты өзгерткіш
Dialogue: 0,1:19:19.42,1:19:21.39,Default,,0000,0000,0000,,:
Dialogue: 0,1:19:19.42,1:19:21.39,Default,,0000,0000,0000,,Когороның дауысы
Dialogue: 0,1:19:19.42,1:19:21.39,Default,,0000,0000,0000,,)
Dialogue: 0,1:19:19.42,1:19:21.39,Default,,0000,0000,0000,,Е...
Dialogue: 0,1:19:19.42,1:19:21.39,Default,,0000,0000,0000,,Барлығы➡
Dialogue: 0,1:19:21.39,1:19:24.96,Default,,0000,0000,0000,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,1:19:21.39,1:19:24.96,Default,,0000,0000,0000,,Наомиді ұрлау бойынша нұсқаулық
Dialogue: 0,1:19:21.39,1:19:24.96,Default,,0000,0000,0000,,Ai ұрлау➡
Dialogue: 0,1:19:24.96,1:19:28.90,Default,,0000,0000,0000,,Леонхардт мырзаны өлтірді.
Dialogue: 0,1:19:24.96,1:19:28.90,Default,,0000,0000,0000,,Кінәлі
Dialogue: 0,1:19:24.96,1:19:28.90,Default,,0000,0000,0000,,Мен осындамын
Dialogue: 0,1:19:24.96,1:19:28.90,Default,,0000,0000,0000,,.
