Dialogue: 0,0:11:29.66,0:11:33.16,Default,,0000,0000,0000,,Әрқашан бір!
Dialogue: 0,0:11:37.60,0:11:40.10,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:37.60,0:11:40.10,Default,,0000,0000,0000,,Мицухико
Dialogue: 0,0:11:37.60,0:11:40.10,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:37.60,0:11:40.10,Default,,0000,0000,0000,,Хаха…
Dialogue: 0,0:11:37.60,0:11:40.10,Default,,0000,0000,0000,,Аюми-чан
Dialogue: 0,0:11:37.60,0:11:40.10,Default,,0000,0000,0000,,Сәл күте тұрыңыз.
Dialogue: 0,0:11:37.60,0:11:40.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:40.10,0:11:42.60,Default,,0000,0000,0000,,Осылайша...
Dialogue: 0,0:11:40.10,0:11:42.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:42.60,0:11:44.57,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:42.60,0:11:44.57,Default,,0000,0000,0000,,Аюми
Dialogue: 0,0:11:42.60,0:11:44.57,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:42.60,0:11:44.57,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:11:42.60,0:11:44.57,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:42.60,0:11:44.57,Default,,0000,0000,0000,,Мицухико
Dialogue: 0,0:11:42.60,0:11:44.57,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:42.60,0:11:44.57,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:11:42.60,0:11:44.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:44.57,0:11:46.61,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:44.57,0:11:46.61,Default,,0000,0000,0000,,Орхидея
Dialogue: 0,0:11:44.57,0:11:46.61,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:44.57,0:11:46.61,Default,,0000,0000,0000,,Бұл дұрыс
Dialogue: 0,0:11:44.57,0:11:46.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:44.57,0:11:46.61,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:11:44.57,0:11:46.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:46.61,0:11:51.14,Default,,0000,0000,0000,,Ушио
Dialogue: 0,0:11:46.61,0:11:51.14,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:46.61,0:11:51.14,Default,,0000,0000,0000,,Ушио
Dialogue: 0,0:11:46.61,0:11:51.14,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:46.61,0:11:51.14,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:46.61,0:11:51.14,Default,,0000,0000,0000,,Тоғыз адам және
Dialogue: 0,0:11:46.61,0:11:51.14,Default,,0000,0000,0000,,Мен естідім
Dialogue: 0,0:11:46.61,0:11:51.14,Default,,0000,0000,0000,,Тағы бір адам ше?
Dialogue: 0,0:11:51.14,0:11:54.18,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:51.14,0:11:54.18,Default,,0000,0000,0000,,Орхидея
Dialogue: 0,0:11:51.14,0:11:54.18,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:51.14,0:11:54.18,Default,,0000,0000,0000,,Менің келмеуімді кешіріңіз.
Dialogue: 0,0:11:51.14,0:11:54.18,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:54.18,0:11:56.12,Default,,0000,0000,0000,,Ішімдік ішкендер мазасыз
Dialogue: 0,0:11:54.18,0:11:56.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:56.12,0:11:59.09,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:56.12,0:11:59.09,Default,,0000,0000,0000,,Мицухиконың дауысы
Dialogue: 0,0:11:56.12,0:11:59.09,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:56.12,0:11:59.09,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:56.12,0:11:59.09,Default,,0000,0000,0000,,Қазірдің өзінде?
Dialogue: 0,0:11:56.12,0:11:59.09,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:56.12,0:11:59.09,Default,,0000,0000,0000,,Агасаның дауысы
Dialogue: 0,0:11:56.12,0:11:59.09,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:56.12,0:11:59.09,Default,,0000,0000,0000,,Берон берон жа
Dialogue: 0,0:11:56.12,0:11:59.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:59.09,0:12:00.59,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:59.09,0:12:00.59,Default,,0000,0000,0000,,Гентаның дауысы
Dialogue: 0,0:11:59.09,0:12:00.59,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:59.09,0:12:00.59,Default,,0000,0000,0000,,Бір айдан кейін
Dialogue: 0,0:11:59.09,0:12:00.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:00.59,0:12:04.09,Default,,0000,0000,0000,,Таку
Dialogue: 0,0:12:00.59,0:12:04.09,Default,,0000,0000,0000,,Егер сіздің әкеңіз
Dialogue: 0,0:12:00.59,0:12:04.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:00.59,0:12:04.09,Default,,0000,0000,0000,,《Күтілгендей
Dialogue: 0,0:12:00.59,0:12:04.09,Default,,0000,0000,0000,,Аға…》
Dialogue: 0,0:12:04.09,0:12:06.59,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:12:04.09,0:12:06.59,Default,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:12:04.09,0:12:06.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:06.59,0:12:09.63,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:06.59,0:12:09.63,Default,,0000,0000,0000,,Гента
Dialogue: 0,0:12:06.59,0:12:09.63,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:06.59,0:12:09.63,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:12:06.59,0:12:09.63,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:06.59,0:12:09.63,Default,,0000,0000,0000,,Мицухико
Dialogue: 0,0:12:06.59,0:12:09.63,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:06.59,0:12:09.63,Default,,0000,0000,0000,,Хаха...
Dialogue: 0,0:12:06.59,0:12:09.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:09.63,0:12:12.13,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:09.63,0:12:12.13,Default,,0000,0000,0000,,Аюми
Dialogue: 0,0:12:09.63,0:12:12.13,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:09.63,0:12:12.13,Default,,0000,0000,0000,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:12:09.63,0:12:12.13,Default,,0000,0000,0000,,Кя!
Dialogue: 0,0:12:13.17,0:12:15.67,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:13.17,0:12:15.67,Default,,0000,0000,0000,,Ушио
Dialogue: 0,0:12:13.17,0:12:15.67,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:13.17,0:12:15.67,Default,,0000,0000,0000,,Олар:
Dialogue: 0,0:12:13.17,0:12:15.67,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:13.17,0:12:15.67,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:13.17,0:12:15.67,Default,,0000,0000,0000,,Орхидея
Dialogue: 0,0:12:13.17,0:12:15.67,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:13.17,0:12:15.67,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:12:13.17,0:12:15.67,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:18.60,0:12:20.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:23.61,0:12:25.58,Default,,0000,0000,0000,,Ha
Dialogue: 0,0:12:23.61,0:12:25.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:25.58,0:12:29.12,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:12:25.58,0:12:29.12,Default,,0000,0000,0000,,Dr.
Dialogue: 0,0:12:25.58,0:12:29.12,Default,,0000,0000,0000,,Алдау
Dialogue: 0,0:12:25.58,0:12:29.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:25.58,0:12:29.12,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:25.58,0:12:29.12,Default,,0000,0000,0000,,Агаса
Dialogue: 0,0:12:25.58,0:12:29.12,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:25.58,0:12:29.12,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:29.12,0:12:31.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:29.12,0:12:31.08,Default,,0000,0000,0000,,Соноко
Dialogue: 0,0:12:29.12,0:12:31.08,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:29.12,0:12:31.08,Default,,0000,0000,0000,,Dr.
Dialogue: 0,0:12:29.12,0:12:31.08,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:12:31.08,0:12:33.09,Default,,0000,0000,0000,,Мені тыңда!
Dialogue: 0,0:12:31.08,0:12:33.09,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:12:31.08,0:12:33.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:33.09,0:12:37.09,Default,,0000,0000,0000,,Кү…
Dialogue: 0,0:12:33.09,0:12:37.09,Default,,0000,0000,0000,,Кит дегеніміз не?
Dialogue: 0,0:12:33.09,0:12:37.09,Default,,0000,0000,0000,,Қызық, бұл қандай кит?
Dialogue: 0,0:12:33.09,0:12:37.09,Default,,0000,0000,0000,,Хехе…
Dialogue: 0,0:12:33.09,0:12:37.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:40.19,0:12:41.66,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:12:46.60,0:12:49.10,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:12:46.60,0:12:49.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:49.10,0:12:50.60,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:49.10,0:12:50.60,Default,,0000,0000,0000,,Гента
Dialogue: 0,0:12:49.10,0:12:50.60,Default,,0000,0000,0000,,:
Dialogue: 0,0:12:49.10,0:12:50.60,Default,,0000,0000,0000,,Мицухико
Dialogue: 0,0:12:49.10,0:12:50.60,Default,,0000,0000,0000,,:
Dialogue: 0,0:12:49.10,0:12:50.60,Default,,0000,0000,0000,,Аюми
Dialogue: 0,0:12:49.10,0:12:50.60,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:49.10,0:12:50.60,Default,,0000,0000,0000,,Эх!
Dialogue: 0,0:12:50.60,0:12:53.11,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:50.60,0:12:53.11,Default,,0000,0000,0000,,Соноко
Dialogue: 0,0:12:50.60,0:12:53.11,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:50.60,0:12:53.11,Default,,0000,0000,0000,,Қате кемеде
Dialogue: 0,0:12:50.60,0:12:53.11,Default,,0000,0000,0000,,Мен түстім!?
Dialogue: 0,0:12:53.11,0:12:55.61,Default,,0000,0000,0000,,Конанның бір ерекшелігі бар.
Dialogue: 0,0:12:53.11,0:12:55.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:55.61,0:12:59.11,Default,,0000,0000,0000,,Мен бар ма деп ойлаймын...
Dialogue: 0,0:12:55.61,0:12:59.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:55.61,0:12:59.11,Default,,0000,0000,0000,,Мен уайымдап тұрмын.
Dialogue: 0,0:12:55.61,0:12:59.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:59.11,0:13:02.62,Default,,0000,0000,0000,,Ах~
Dialogue: 0,0:12:59.11,0:13:02.62,Default,,0000,0000,0000,,Бірақ инспектор Ширатори
Dialogue: 0,0:12:59.11,0:13:02.62,Default,,0000,0000,0000,,Біз бірге жүрген сияқтымыз
Dialogue: 0,0:12:59.11,0:13:02.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:02.62,0:13:06.19,Default,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:13:02.62,0:13:06.19,Default,,0000,0000,0000,,Ол мені кейінірек қонақүйге түсіретінін айтты.
Dialogue: 0,0:13:02.62,0:13:06.19,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:06.19,0:13:09.22,Default,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:13:06.19,0:13:09.22,Default,,0000,0000,0000,,Конан-кун...
Dialogue: 0,0:13:06.19,0:13:09.22,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:09.22,0:13:12.19,Default,,0000,0000,0000,,《F…
Dialogue: 0,0:13:09.22,0:13:12.19,Default,,0000,0000,0000,,Қателік...》
Dialogue: 0,0:13:21.60,0:13:24.10,Default,,0000,0000,0000,,《Ақпарат жоқ》
Dialogue: 0,0:13:24.10,0:13:26.11,Default,,0000,0000,0000,,《Күтілгендей
Dialogue: 0,0:13:24.10,0:13:26.11,Default,,0000,0000,0000,,Бұл кеме➡
Dialogue: 0,0:13:26.11,0:13:28.61,Default,,0000,0000,0000,,Тынық мұхиты
Dialogue: 0,0:13:26.11,0:13:28.61,Default,,0000,0000,0000,,
Dialogue: 0,0:13:26.11,0:13:28.61,Default,,0000,0000,0000,,Қалқымаға
Dialogue: 0,0:13:26.11,0:13:28.61,Default,,0000,0000,0000,,Мен келе жатырмын》
Dialogue: 0,0:13:38.65,0:13:40.62,Default,,0000,0000,0000,,(
Dialogue: 0,0:13:38.65,0:13:40.62,Default,,0000,0000,0000,,Агаса
Dialogue: 0,0:13:38.65,0:13:40.62,Default,,0000,0000,0000,,)
Dialogue: 0,0:13:38.65,0:13:40.62,Default,,0000,0000,0000,,Сен… кімсің?
Dialogue: 0,0:13:38.65,0:13:40.62,Default,,0000,0000,0000,,Айқай!
Dialogue: 0,0:13:38.65,0:13:40.62,Default,,0000,0000,0000,,(
Dialogue: 0,0:13:38.65,0:13:40.62,Default,,0000,0000,0000,,Соноко
Dialogue: 0,0:13:38.65,0:13:40.62,Default,,0000,0000,0000,,:
Dialogue: 0,0:13:38.65,0:13:40.62,Default,,0000,0000,0000,,Орхидея
Dialogue: 0,0:13:38.65,0:13:40.62,Default,,0000,0000,0000,,)
Dialogue: 0,0:13:38.65,0:13:40.62,Default,,0000,0000,0000,,Ай!
Dialogue: 0,0:13:43.12,0:13:45.09,Default,,0000,0000,0000,,Маджи
Dialogue: 0,0:13:43.12,0:13:45.09,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:13:43.12,0:13:45.09,Default,,0000,0000,0000,,Суық!
Dialogue: 0,0:13:45.09,0:13:46.59,Default,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:13:45.09,0:13:46.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:53.17,0:13:56.67,Default,,0000,0000,0000,,(
Dialogue: 0,0:13:53.17,0:13:56.67,Default,,0000,0000,0000,,Полиция қызметкері
Dialogue: 0,0:13:53.17,0:13:56.67,Default,,0000,0000,0000,,)
Dialogue: 0,0:13:53.17,0:13:56.67,Default,,0000,0000,0000,,Фут
Dialogue: 0,0:13:53.17,0:13:56.67,Default,,0000,0000,0000,,Сақ болыңыз
Dialogue: 0,0:13:53.17,0:13:56.67,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:53.17,0:13:56.67,Default,,0000,0000,0000,,Курода
Dialogue: 0,0:13:53.17,0:13:56.67,Default,,0000,0000,0000,,(
Dialogue: 0,0:13:53.17,0:13:56.67,Default,,0000,0000,0000,,Курода
Dialogue: 0,0:13:53.17,0:13:56.67,Default,,0000,0000,0000,,)
Dialogue: 0,0:13:53.17,0:13:56.67,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:13:53.17,0:13:56.67,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:58.60,0:14:00.61,Default,,0000,0000,0000,,(
Dialogue: 0,0:13:58.60,0:14:00.61,Default,,0000,0000,0000,,Аққу
Dialogue: 0,0:13:58.60,0:14:00.61,Default,,0000,0000,0000,,)
Dialogue: 0,0:13:58.60,0:14:00.61,Default,,0000,0000,0000,,Сол сияқты, бір күні, бір жерде кездесесіздер.
Dialogue: 0,0:13:58.60,0:14:00.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:00.61,0:14:03.11,Default,,0000,0000,0000,,Бұл өте үлкен!
Dialogue: 0,0:14:00.61,0:14:03.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:04.61,0:14:07.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:04.61,0:14:07.08,Default,,0000,0000,0000,,Курода
Dialogue: 0,0:14:04.61,0:14:07.08,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:04.61,0:14:07.08,Default,,0000,0000,0000,,Енді бір нәрсе сұрасам болады ма?
Dialogue: 0,0:14:07.08,0:14:08.61,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:08.61,0:14:11.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:08.61,0:14:11.08,Default,,0000,0000,0000,,Курода
Dialogue: 0,0:14:08.61,0:14:11.08,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:08.61,0:14:11.08,Default,,0000,0000,0000,,Бізбен не үшін келдің?
Dialogue: 0,0:14:08.61,0:14:11.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:11.08,0:14:13.15,Default,,0000,0000,0000,,Хмм
Dialogue: 0,0:14:11.08,0:14:13.15,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:13.15,0:14:15.15,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:13.15,0:14:15.15,Default,,0000,0000,0000,,Аққу
Dialogue: 0,0:14:13.15,0:14:15.15,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:13.15,0:14:15.15,Default,,0000,0000,0000,,Конан-кун!
Dialogue: 0,0:14:13.15,0:14:15.15,Default,,0000,0000,0000,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:14:15.15,0:14:16.66,Default,,0000,0000,0000,,Ахаха…
Dialogue: 0,0:14:15.15,0:14:16.66,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:17.69,0:14:20.59,Default,,0000,0000,0000,,Киттерді көруге бара жатқан қайық
Dialogue: 0,0:14:17.69,0:14:20.59,Default,,0000,0000,0000,,Мен қателік жібердім...
Dialogue: 0,0:14:17.69,0:14:20.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:20.59,0:14:23.10,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:20.59,0:14:23.10,Default,,0000,0000,0000,,Аққу
Dialogue: 0,0:14:20.59,0:14:23.10,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:20.59,0:14:23.10,Default,,0000,0000,0000,,Неге маған бірден айтпадың?
Dialogue: 0,0:14:23.10,0:14:25.60,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,0:14:23.10,0:14:25.60,Default,,0000,0000,0000,,Мен сені ашуланады деп ойладым.
Dialogue: 0,0:14:23.10,0:14:25.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:25.60,0:14:27.60,Default,,0000,0000,0000,,Кемені еске түсіру
Dialogue: 0,0:14:25.60,0:14:27.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:27.60,0:14:30.97,Default,,0000,0000,0000,,Йосе
Dialogue: 0,0:14:27.60,0:14:30.97,Default,,0000,0000,0000,,Интерпол
Dialogue: 0,0:14:27.60,0:14:30.97,Default,,0000,0000,0000,,Мен сізді күттіргім келмейді
Dialogue: 0,0:14:27.60,0:14:30.97,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:34.64,0:14:37.18,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:34.64,0:14:37.18,Default,,0000,0000,0000,,Макино
Dialogue: 0,0:14:34.64,0:14:37.18,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:34.64,0:14:37.18,Default,,0000,0000,0000,,алыс
Dialogue: 0,0:14:34.64,0:14:37.18,Default,,0000,0000,0000,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:14:34.64,0:14:37.18,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:37.18,0:14:39.08,Default,,0000,0000,0000,,Танысқаныма қуаныштымын
Dialogue: 0,0:14:37.18,0:14:39.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:39.08,0:14:41.61,Default,,0000,0000,0000,,Тынық мұхиты қалқымасы
Dialogue: 0,0:14:39.08,0:14:41.61,Default,,0000,0000,0000,,Бұл Макино, директор.
Dialogue: 0,0:14:39.08,0:14:41.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:41.61,0:14:45.08,Default,,0000,0000,0000,,Наоми
Dialogue: 0,0:14:41.61,0:14:45.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:41.61,0:14:45.08,Default,,0000,0000,0000,,Наоми
Dialogue: 0,0:14:41.61,0:14:45.08,Default,,0000,0000,0000,,）
Dialogue: 0,0:14:41.61,0:14:45.08,Default,,0000,0000,0000,,Инженер
Dialogue: 0,0:14:41.61,0:14:45.08,Default,,0000,0000,0000,,Наоми
Dialogue: 0,0:14:41.61,0:14:45.08,Default,,0000,0000,0000,,...
Dialogue: 0,0:14:41.61,0:14:45.08,Default,,0000,0000,0000,,болып табылады
Dialogue: 0,0:14:41.61,0:14:45.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:45.08,0:14:48.59,Default,,0000,0000,0000,,Бұл елордалық полиция департаментінен Ширатори және оның бастығы Курода.
Dialogue: 0,0:14:45.08,0:14:48.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:48.59,0:14:50.62,Default,,0000,0000,0000,,Танысқаныма қуаныштымын
Dialogue: 0,0:14:48.59,0:14:50.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:50.62,0:14:53.09,Default,,0000,0000,0000,,Бүгін
Dialogue: 0,0:14:50.62,0:14:53.09,Default,,0000,0000,0000,,Алдын ала рахмет
Dialogue: 0,0:14:50.62,0:14:53.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:53.09,0:14:57.16,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:14:53.09,0:14:57.16,Default,,0000,0000,0000,,Бұл бала қателесті.
Dialogue: 0,0:14:53.09,0:14:57.16,Default,,0000,0000,0000,,Кемеге мінген дейді...
Dialogue: 0,0:14:53.09,0:14:57.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:57.16,0:15:00.10,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:57.16,0:15:00.10,Default,,0000,0000,0000,,Наоми
Dialogue: 0,0:14:57.16,0:15:00.10,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:57.16,0:15:00.10,Default,,0000,0000,0000,,Сәлем
Dialogue: 0,0:14:57.16,0:15:00.10,Default,,0000,0000,0000,,Аты
Dialogue: 0,0:14:57.16,0:15:00.10,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:15:00.10,0:15:03.10,Default,,0000,0000,0000,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:15:00.10,0:15:03.10,Default,,0000,0000,0000,,Конан Эдогава
Dialogue: 0,0:15:00.10,0:15:03.10,Default,,0000,0000,0000,,Танысқаныма қуаныштымын!
Dialogue: 0,0:15:03.10,0:15:06.61,Default,,0000,0000,0000,,Конан-кун.
Dialogue: 0,0:15:03.10,0:15:06.61,Default,,0000,0000,0000,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:15:03.10,0:15:06.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:06.61,0:15:10.14,Default,,0000,0000,0000,,(
Dialogue: 0,0:15:06.61,0:15:10.14,Default,,0000,0000,0000,,Наоми
Dialogue: 0,0:15:06.61,0:15:10.14,Default,,0000,0000,0000,,)
Dialogue: 0,0:15:06.61,0:15:10.14,Default,,0000,0000,0000,,Бұдан басқа
Dialogue: 0,0:15:06.61,0:15:10.14,Default,,0000,0000,0000,,Тынық мұхиты қалқымасы
Dialogue: 0,0:15:06.61,0:15:10.14,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:15:06.61,0:15:10.14,Default,,0000,0000,0000,,Кіреберіс бар.
Dialogue: 0,0:15:06.61,0:15:10.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:10.14,0:15:11.61,Default,,0000,0000,0000,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:15:10.14,0:15:11.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:11.61,0:15:16.08,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:15:11.61,0:15:16.08,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:15:11.61,0:15:16.08,Default,,0000,0000,0000,,Кең!
Dialogue: 0,0:15:11.61,0:15:16.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:15:11.61,0:15:16.08,Default,,0000,0000,0000,,Наоми
Dialogue: 0,0:15:11.61,0:15:16.08,Default,,0000,0000,0000,,)
Dialogue: 0,0:15:11.61,0:15:16.08,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:15:11.61,0:15:16.08,Default,,0000,0000,0000,,Конан-кун
Dialogue: 0,0:15:11.61,0:15:16.08,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:15:21.69,0:15:24.09,Default,,0000,0000,0000,,Үлкен тесік?
Dialogue: 0,0:15:24.09,0:15:27.09,Default,,0000,0000,0000,,Бұл кіреберіс
Dialogue: 0,0:15:24.09,0:15:27.09,Default,,0000,0000,0000,,Тек қарап тұр.
Dialogue: 0,0:15:24.09,0:15:27.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:27.09,0:15:40.11,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:40.11,0:15:42.11,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:15:40.11,0:15:42.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:43.68,0:15:46.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:15:43.68,0:15:46.08,Default,,0000,0000,0000,,Макино
Dialogue: 0,0:15:43.68,0:15:46.08,Default,,0000,0000,0000,,)
Dialogue: 0,0:15:43.68,0:15:46.08,Default,,0000,0000,0000,,Бұл кіреберіс бөлігі
Dialogue: 0,0:15:43.68,0:15:46.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:46.08,0:15:49.58,Default,,0000,0000,0000,,Шын мәнінде
Dialogue: 0,0:15:46.08,0:15:49.58,Default,,0000,0000,0000,,Нысандардың көпшілігі
Dialogue: 0,0:15:46.08,0:15:49.58,Default,,0000,0000,0000,,Ол теңіздің астында.
Dialogue: 0,0:15:46.08,0:15:49.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:49.58,0:15:52.08,Default,,0000,0000,0000,,Балласты цистерналарда
Dialogue: 0,0:15:49.58,0:15:52.08,Default,,0000,0000,0000,,Жоғары көтерілетін және түсетін механизммен ➡
Dialogue: 0,0:15:52.08,0:15:55.59,Default,,0000,0000,0000,,Толқындардың күшін басқарады
Dialogue: 0,0:15:52.08,0:15:55.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:55.59,0:15:58.59,Default,,0000,0000,0000,,Теңіздің астында не бар?
Dialogue: 0,0:15:55.59,0:15:58.59,Default,,0000,0000,0000,,Серверлердің үлкен саны ➡
Dialogue: 0,0:15:58.59,0:16:00.63,Default,,0000,0000,0000,,Сондай-ақ салқындату үшін
Dialogue: 0,0:15:58.59,0:16:00.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:00.63,0:16:03.66,Default,,0000,0000,0000,,Теңізде қалқыған қалқығандай.
Dialogue: 0,0:16:00.63,0:16:03.66,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:03.66,0:16:07.13,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:03.66,0:16:07.13,Default,,0000,0000,0000,,Наоми
Dialogue: 0,0:16:03.66,0:16:07.13,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:03.66,0:16:07.13,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:16:03.66,0:16:07.13,Default,,0000,0000,0000,,«Тынық мұхиты қалқымасы»
Dialogue: 0,0:16:03.66,0:16:07.13,Default,,0000,0000,0000,,Жарайды, екеу болсын.
Dialogue: 0,0:16:03.66,0:16:07.13,Default,,0000,0000,0000,,Мені шақырып жатыр.
Dialogue: 0,0:16:03.66,0:16:07.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:09.60,0:16:11.60,Default,,0000,0000,0000,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:16:11.60,0:16:13.57,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:11.60,0:16:13.57,Default,,0000,0000,0000,,Аққу
Dialogue: 0,0:16:11.60,0:16:13.57,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:11.60,0:16:13.57,Default,,0000,0000,0000,,О
Dialogue: 0,0:16:11.60,0:16:13.57,Default,,0000,0000,0000,,Шын жүректен осылай сезінемін
Dialogue: 0,0:16:13.57,0:16:16.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:13.57,0:16:16.08,Default,,0000,0000,0000,,Наоми
Dialogue: 0,0:16:13.57,0:16:16.08,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:13.57,0:16:16.08,Default,,0000,0000,0000,,Негізгі бөлме
Dialogue: 0,0:16:13.57,0:16:16.08,Default,,0000,0000,0000,,Бұдан төмен
Dialogue: 0,0:16:13.57,0:16:16.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:17.58,0:16:19.58,Default,,0000,0000,0000,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:16:17.58,0:16:19.58,Default,,0000,0000,0000,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:16:19.58,0:16:21.61,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:16:19.58,0:16:21.61,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:16:19.58,0:16:21.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:21.61,0:16:24.65,Default,,0000,0000,0000,,Толқынның ағынынан электр энергиясын өндіретін сақина.
Dialogue: 0,0:16:21.61,0:16:24.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:24.65,0:16:28.19,Default,,0000,0000,0000,,Бұл жерде Курошио ағысы күшті.
Dialogue: 0,0:16:24.65,0:16:28.19,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:28.19,0:16:30.59,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:28.19,0:16:30.59,Default,,0000,0000,0000,,Лифттің келу дыбысы
Dialogue: 0,0:16:28.19,0:16:30.59,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:30.59,0:16:34.59,Default,,0000,0000,0000,,Бұл қабат қызметкерлерге арналған.
Dialogue: 0,0:16:30.59,0:16:34.59,Default,,0000,0000,0000,,Сондай-ақ тұрғын үй ауданы ретінде қызмет етеді
Dialogue: 0,0:16:30.59,0:16:34.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:34.59,0:16:37.60,Default,,0000,0000,0000,,Негізгі бөлме дәліздің соңында
Dialogue: 0,0:16:34.59,0:16:37.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:37.60,0:16:40.60,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:37.60,0:16:40.60,Default,,0000,0000,0000,,Кит дыбыстары
Dialogue: 0,0:16:37.60,0:16:40.60,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:37.60,0:16:40.60,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:37.60,0:16:40.60,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:16:40.60,0:16:42.60,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:40.60,0:16:42.60,Default,,0000,0000,0000,,Макино
Dialogue: 0,0:16:40.60,0:16:42.60,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:40.60,0:16:42.60,Default,,0000,0000,0000,,Бұл киттің дыбысы.
Dialogue: 0,0:16:40.60,0:16:42.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:42.60,0:16:45.60,Default,,0000,0000,0000,,Өркеш киттер
Dialogue: 0,0:16:42.60,0:16:45.60,Default,,0000,0000,0000,,Өйткені бұл ән салатын кит
Dialogue: 0,0:16:42.60,0:16:45.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:45.60,0:16:47.64,Default,,0000,0000,0000,,Ол сонар арқылы анықталды ма?
Dialogue: 0,0:16:47.64,0:16:51.71,Default,,0000,0000,0000,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:16:47.64,0:16:51.71,Default,,0000,0000,0000,,Конан-кун, сен көп нәрсені білесің.
Dialogue: 0,0:16:47.64,0:16:51.71,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:51.71,0:16:54.11,Default,,0000,0000,0000,,Эхехе…
Dialogue: 0,0:16:51.71,0:16:54.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:54.11,0:16:58.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:54.11,0:16:58.08,Default,,0000,0000,0000,,Макино
Dialogue: 0,0:16:54.11,0:16:58.08,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:54.11,0:16:58.08,Default,,0000,0000,0000,,Шыдамдылығыңыз үшін рахмет.
Dialogue: 0,0:16:54.11,0:16:58.08,Default,,0000,0000,0000,,Бұл негізгі бөлме болады
Dialogue: 0,0:16:54.11,0:16:58.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:58.08,0:17:06.59,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:06.59,0:17:09.09,Default,,0000,0000,0000,,(
Dialogue: 0,0:17:06.59,0:17:09.09,Default,,0000,0000,0000,,Аққу
Dialogue: 0,0:17:06.59,0:17:09.09,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:06.59,0:17:09.09,Default,,0000,0000,0000,,О
Dialogue: 0,0:17:06.59,0:17:09.09,Default,,0000,0000,0000,,кең
Dialogue: 0,0:17:06.59,0:17:09.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:15.57,0:17:19.07,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:17:15.57,0:17:19.07,Default,,0000,0000,0000,,Негізгі құрам
Dialogue: 0,0:17:15.57,0:17:19.07,Default,,0000,0000,0000,,Сіздерді таныстырып өтейін.
Dialogue: 0,0:17:15.57,0:17:19.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:19.07,0:17:21.57,Default,,0000,0000,0000,,Франциядан келген Грейс
Dialogue: 0,0:17:19.07,0:17:21.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:21.57,0:17:23.58,Default,,0000,0000,0000,,(Благодать)
Dialogue: 0,0:17:21.57,0:17:23.58,Default,,0000,0000,0000,,Сәлем~
Dialogue: 0,0:17:21.57,0:17:23.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:23.58,0:17:26.58,Default,,0000,0000,0000,,(
Dialogue: 0,0:17:23.58,0:17:26.58,Default,,0000,0000,0000,,Макино
Dialogue: 0,0:17:23.58,0:17:26.58,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:23.58,0:17:26.58,Default,,0000,0000,0000,,Германиядан Леонхард
Dialogue: 0,0:17:23.58,0:17:26.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:31.12,0:17:33.65,Default,,0000,0000,0000,,(
Dialogue: 0,0:17:31.12,0:17:33.65,Default,,0000,0000,0000,,Макино
Dialogue: 0,0:17:31.12,0:17:33.65,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:31.12,0:17:33.65,Default,,0000,0000,0000,,Үндістаннан Ed
Dialogue: 0,0:17:31.12,0:17:33.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:33.65,0:17:35.65,Default,,0000,0000,0000,,(
Dialogue: 0,0:17:33.65,0:17:35.65,Default,,0000,0000,0000,,Ред
Dialogue: 0,0:17:33.65,0:17:35.65,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:33.65,0:17:35.65,Default,,0000,0000,0000,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:17:33.65,0:17:35.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:37.12,0:17:40.09,Default,,0000,0000,0000,,Қалғаны менмін
Dialogue: 0,0:17:37.12,0:17:40.09,Default,,0000,0000,0000,,Наоми
Dialogue: 0,0:17:37.12,0:17:40.09,Default,,0000,0000,0000,,
Dialogue: 0,0:17:37.12,0:17:40.09,Default,,0000,0000,0000,,Аргенто
Dialogue: 0,0:17:37.12,0:17:40.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:40.09,0:17:42.59,Default,,0000,0000,0000,,немесе одан да көп инженерлер
Dialogue: 0,0:17:40.09,0:17:42.59,Default,,0000,0000,0000,,Миссияда
Dialogue: 0,0:17:40.09,0:17:42.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:42.59,0:17:44.56,Default,,0000,0000,0000,,(
Dialogue: 0,0:17:42.59,0:17:44.56,Default,,0000,0000,0000,,Аққу
Dialogue: 0,0:17:42.59,0:17:44.56,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:42.59,0:17:44.56,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:17:42.59,0:17:44.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:42.59,0:17:44.56,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:44.56,0:17:48.57,Default,,0000,0000,0000,,Бұл бүкіл Жапонияда
Dialogue: 0,0:17:44.56,0:17:48.57,Default,,0000,0000,0000,,Бұл полицияның қауіпсіздік камерасы ма?
Dialogue: 0,0:17:48.57,0:17:51.10,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:17:48.57,0:17:51.10,Default,,0000,0000,0000,,Today ➡
Dialogue: 0,0:17:51.10,0:17:54.14,Default,,0000,0000,0000,,Еуропадағы қауіпсіздік камералары
Dialogue: 0,0:17:51.10,0:17:54.14,Default,,0000,0000,0000,,Біз қосыла аламыз
Dialogue: 0,0:17:51.10,0:17:54.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:54.14,0:17:57.58,Default,,0000,0000,0000,,Бұдан былай
Dialogue: 0,0:17:54.14,0:17:57.58,Default,,0000,0000,0000,,Дүние жүзіндегі камералар
Dialogue: 0,0:17:54.14,0:17:57.58,Default,,0000,0000,0000,,Қосылуды жоспарлау
Dialogue: 0,0:17:54.14,0:17:57.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:57.58,0:18:00.61,Default,,0000,0000,0000,,Интерпол мекемесінен күткендей.
Dialogue: 0,0:17:57.58,0:18:00.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:00.61,0:18:03.08,Default,,0000,0000,0000,,
Dialogue: 0,0:18:00.61,0:18:03.08,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:18:00.61,0:18:03.08,Default,,0000,0000,0000,,Бұл Интерпол.
Dialogue: 0,0:18:00.61,0:18:03.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:03.08,0:18:05.58,Default,,0000,0000,0000,,
Dialogue: 0,0:18:03.08,0:18:05.58,Default,,0000,0000,0000,,Бірақ неге жапон полициясы бар?
Dialogue: 0,0:18:05.58,0:18:09.09,Default,,0000,0000,0000,,Франкфуртте
Dialogue: 0,0:18:05.58,0:18:09.09,Default,,0000,0000,0000,,Себебі бұзу оқиғасы болды, солай ма?
Dialogue: 0,0:18:05.58,0:18:09.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:09.09,0:18:10.59,Default,,0000,0000,0000,,Неапольдың ең үздік жиһаз шебері Марионың ұлы болып дүниеге келген
Dialogue: 0,0:18:09.09,0:18:10.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:10.59,0:18:15.13,Default,,0000,0000,0000,,Бізге де бірдеңе болған жағдайда
Dialogue: 0,0:18:10.59,0:18:15.13,Default,,0000,0000,0000,,Маған елордалық полиция бөлімі келді.
Dialogue: 0,0:18:10.59,0:18:15.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:15.13,0:18:19.16,Default,,0000,0000,0000,,Соңғы технология тек жапон полициясына арналған
Dialogue: 0,0:18:15.13,0:18:19.16,Default,,0000,0000,0000,,Оны жариялауға қалай батылы барады➡
Dialogue: 0,0:18:19.16,0:18:21.10,Default,,0000,0000,0000,,Бұл әділетсіздік емес пе!
Dialogue: 0,0:18:21.10,0:18:23.64,Default,,0000,0000,0000,,Жапония Интерполдың мүшесі.
Dialogue: 0,0:18:21.10,0:18:23.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:23.64,0:18:27.57,Default,,0000,0000,0000,,If necessary
Dialogue: 0,0:18:23.64,0:18:27.57,Default,,0000,0000,0000,,Технологиямен қамтамасыз ету заңды.
Dialogue: 0,0:18:23.64,0:18:27.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:27.57,0:18:31.58,Default,,0000,0000,0000,,Өйткені мұндағы ең басты адам жапон.
Dialogue: 0,0:18:27.57,0:18:31.58,Default,,0000,0000,0000,,Демек, сіз жапоншылсыз ба?
Dialogue: 0,0:18:27.57,0:18:31.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:31.58,0:18:33.08,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:18:31.58,0:18:33.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:33.08,0:18:35.11,Default,,0000,0000,0000,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:18:33.08,0:18:35.11,Default,,0000,0000,0000,,If you say so➡
Dialogue: 0,0:18:35.11,0:18:37.08,Default,,0000,0000,0000,,Тіпті мен жарыммын
Dialogue: 0,0:18:35.11,0:18:37.08,Default,,0000,0000,0000,,Жапон халқы
Dialogue: 0,0:18:35.11,0:18:37.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:37.08,0:18:40.12,Default,,0000,0000,0000,,(Каори) Эмм… есіктер сағат 3-те ашылады, ал жарыс 3:30-да басталады.
Dialogue: 0,0:18:37.08,0:18:40.12,Default,,0000,0000,0000,,Мен оны құлықсыз әйел деп ойладым.
Dialogue: 0,0:18:37.08,0:18:40.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:40.12,0:18:43.59,Default,,0000,0000,0000,,Жаңа айтқаныңызды кері қайтарыңыз.
Dialogue: 0,0:18:40.12,0:18:43.59,Default,,0000,0000,0000,,Нәсілшілдік
Dialogue: 0,0:18:40.12,0:18:43.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:43.59,0:18:47.06,Default,,0000,0000,0000,,Юкине-кун, барсың ба?
Dialogue: 0,0:18:43.59,0:18:47.06,Default,,0000,0000,0000,,Сіз…
Dialogue: 0,0:18:43.59,0:18:47.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:43.59,0:18:47.06,Default,,0000,0000,0000,,Осымен
Dialogue: 0,0:18:43.59,0:18:47.06,Default,,0000,0000,0000,,Уақыт келді емес пе?
Dialogue: 0,0:18:47.06,0:18:50.56,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:18:47.06,0:18:50.56,Default,,0000,0000,0000,,Жалпы мүшелер
Dialogue: 0,0:18:47.06,0:18:50.56,Default,,0000,0000,0000,,Орналастыру үшін!
Dialogue: 0,0:18:55.07,0:18:58.60,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:18:55.07,0:18:58.60,Default,,0000,0000,0000,,Леонхардт
Dialogue: 0,0:18:55.07,0:18:58.60,Default,,0000,0000,0000,,Біз келгенше➡
Dialogue: 0,0:18:58.60,0:19:02.07,Default,,0000,0000,0000,,Еуропа елдеріндегі полиция және
Dialogue: 0,0:18:58.60,0:19:02.07,Default,,0000,0000,0000,,Көп нәрсе болған сияқты.
Dialogue: 0,0:18:58.60,0:19:02.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:07.58,0:19:09.58,Default,,0000,0000,0000,,Бірінші рұқсат!
Dialogue: 0,0:19:09.58,0:19:25.60,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
