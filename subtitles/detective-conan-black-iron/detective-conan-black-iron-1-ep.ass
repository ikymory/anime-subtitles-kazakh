Dialogue: 0,0:33:00.01,0:33:02.51,Default,,0000,0000,0000,,Мүмкін емес!
Dialogue: 0,0:33:02.51,0:33:04.52,Default,,0000,0000,0000,,Кит туралы сұрақ-жауап!
Dialogue: 0,0:33:04.52,0:33:07.02,Default,,0000,0000,0000,,Қарын тоқуға арналған тест дегеніміз не?
Dialogue: 0,0:33:04.52,0:33:07.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:33:07.02,0:33:09.49,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:33:07.02,0:33:09.49,Default,,0000,0000,0000,,Мен сені сүйемін кит!
Dialogue: 0,0:33:09.49,0:33:14.99,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:33:09.49,0:33:14.99,Default,,0000,0000,0000,,Кит ашуланды ма
Dialogue: 0,0:33:09.49,0:33:14.99,Default,,0000,0000,0000,,Мен қайда қарауым керек?
Dialogue: 0,0:33:14.99,0:33:17.56,Default,,0000,0000,0000,,№ 1
Dialogue: 0,0:33:14.99,0:33:17.56,Default,,0000,0000,0000,,Құлақ
Dialogue: 0,0:33:14.99,0:33:17.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:33:17.56,0:33:20.10,Default,,0000,0000,0000,,№ 2
Dialogue: 0,0:33:17.56,0:33:20.10,Default,,0000,0000,0000,,Мұрын
Dialogue: 0,0:33:17.56,0:33:20.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:33:20.10,0:33:22.00,Default,,0000,0000,0000,,№ 3
Dialogue: 0,0:33:20.10,0:33:22.00,Default,,0000,0000,0000,,Ауыз
Dialogue: 0,0:33:20.10,0:33:22.00,Default,,0000,0000,0000,,.
Dialogue: 0,0:33:22.00,0:33:24.50,Default,,0000,0000,0000,,№ 4
Dialogue: 0,0:33:22.00,0:33:24.50,Default,,0000,0000,0000,,Шығыс Патшалығының астанасы – Баррингтон
Dialogue: 0,0:33:22.00,0:33:24.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:33:24.50,0:33:27.01,Default,,0000,0000,0000,,Цукуёми, тез бол, тез бол
Dialogue: 0,0:33:24.50,0:33:27.01,Default,,0000,0000,0000,,Қайсысы?
Dialogue: 0,0:33:27.01,0:33:31.01,Default,,0000,0000,0000,,(
Dialogue: 0,0:33:27.01,0:33:31.01,Default,,0000,0000,0000,,Гента
Dialogue: 0,0:33:27.01,0:33:31.01,Default,,0000,0000,0000,,)
Dialogue: 0,0:33:27.01,0:33:31.01,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:33:27.01,0:33:31.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:33:27.01,0:33:31.01,Default,,0000,0000,0000,,Э~?
Dialogue: 0,0:33:27.01,0:33:31.01,Default,,0000,0000,0000,,Мистер Кит қашан ашуланады?
Dialogue: 0,0:33:31.01,0:33:34.01,Default,,0000,0000,0000,,Құлақ
Dialogue: 0,0:33:31.01,0:33:34.01,Default,,0000,0000,0000,,Мұрын
Dialogue: 0,0:33:31.01,0:33:34.01,Default,,0000,0000,0000,,Ауыз
Dialogue: 0,0:33:31.01,0:33:34.01,Default,,0000,0000,0000,,Көз…
Dialogue: 0,0:33:31.01,0:33:34.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:33:34.01,0:33:37.05,Default,,0000,0000,0000,,Мен түсінбеймін!
Dialogue: 0,0:33:34.01,0:33:37.05,Default,,0000,0000,0000,,Сізде қандай да бір кеңестер бар ма?
Dialogue: 0,0:33:34.01,0:33:37.05,Default,,0000,0000,0000,,Конан
Dialogue: 0,0:33:34.01,0:33:37.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:33:37.05,0:33:41.12,Default,,0000,0000,0000,,That's right.
Dialogue: 0,0:33:37.05,0:33:41.12,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:33:37.05,0:33:41.12,Default,,0000,0000,0000,,Ашулану
Dialogue: 0,0:33:37.05,0:33:41.12,Default,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:33:37.05,0:33:41.12,Default,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:33:37.05,0:33:41.12,Default,,0000,0000,0000,,Оны айтудың басқа жолы қандай?
Dialogue: 0,0:33:41.12,0:33:43.59,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:33:41.12,0:33:43.59,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:33:41.12,0:33:43.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:33:45.02,0:33:47.49,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:33:45.02,0:33:47.49,Default,,0000,0000,0000,,Йошида мырза
Dialogue: 0,0:33:45.02,0:33:47.49,Default,,0000,0000,0000,,Ашуланған бетті көрсетіп көріңіз
Dialogue: 0,0:33:45.02,0:33:47.49,Default,,0000,0000,0000,,.
Dialogue: 0,0:33:47.49,0:33:49.49,Default,,0000,0000,0000,,Ашулы бет?
Dialogue: 0,0:33:49.49,0:33:51.50,Default,,0000,0000,0000,,Мағынасыздық
Dialogue: 0,0:33:51.50,0:33:54.00,Default,,0000,0000,0000,,Бұл саусақ
Dialogue: 0,0:33:51.50,0:33:54.00,Default,,0000,0000,0000,,Сіз оны қайда ұстайсыз?
Dialogue: 0,0:33:54.00,0:33:56.00,Default,,0000,0000,0000,,Бұл көздің сыртқы бұрышы ма?
Dialogue: 0,0:33:56.00,0:33:59.00,Default,,0000,0000,0000,,Көздің сыртқы бұрышы
Dialogue: 0,0:33:56.00,0:33:59.00,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:33:56.00,0:33:59.00,Default,,0000,0000,0000,,Соқыр көз
Оны
Dialogue: 0,0:33:56.00,0:33:59.00,Default,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:33:56.00,0:33:59.00,Default,,0000,0000,0000,,деп те атайды.
Dialogue: 0,0:33:56.00,0:33:59.00,Default,,0000,0000,0000,,.
Dialogue: 0,0:33:59.00,0:34:02.07,Default,,0000,0000,0000,,Соқыр көз?
Dialogue: 0,0:33:59.00,0:34:02.07,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:33:59.00,0:34:02.07,Default,,0000,0000,0000,,Түсіндім!
Dialogue: 0,0:34:02.07,0:34:05.51,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:34:02.07,0:34:05.51,Default,,0000,0000,0000,,Сол сөз
Dialogue: 0,0:34:02.07,0:34:05.51,Default,,0000,0000,0000,,Бұл қайдан шыққан.
Dialogue: 0,0:34:02.07,0:34:05.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:34:05.51,0:34:07.51,Default,,0000,0000,0000,,Соқыр көз…
Dialogue: 0,0:34:05.51,0:34:07.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:34:07.51,0:34:09.98,Default,,0000,0000,0000,,Қандай азап…
Dialogue: 0,0:34:07.51,0:34:09.98,Default,,0000,0000,0000,,Көздің жауын алады!
Dialogue: 0,0:34:09.98,0:34:12.02,Default,,0000,0000,0000,,Жауабы
Dialogue: 0,0:34:09.98,0:34:12.02,Default,,0000,0000,0000,,№ 4
Dialogue: 0,0:34:09.98,0:34:12.02,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:34:09.98,0:34:12.02,Default,,0000,0000,0000,,Шығыс Патшалығының астанасы – Баррингтон
Dialogue: 0,0:34:09.98,0:34:12.02,Default,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:34:09.98,0:34:12.02,Default,,0000,0000,0000,,Рұқсатсыз не істеп жатырсың!
Dialogue: 0,0:34:12.02,0:34:15.49,Default,,0000,0000,0000,,Пинг теннис!
Dialogue: 0,0:34:12.02,0:34:15.49,Default,,0000,0000,0000,,Мицухико-кун
Dialogue: 0,0:34:12.02,0:34:15.49,Default,,0000,0000,0000,,Бұл дұрыс!
Dialogue: 0,0:34:15.49,0:34:16.99,Default,,0000,0000,0000,,Мен жасадым!
Dialogue: 0,0:34:16.99,0:34:21.56,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:34:16.99,0:34:21.56,Default,,0000,0000,0000,,Жауап дерлік
Dialogue: 0,0:34:16.99,0:34:21.56,Default,,0000,0000,0000,,Бұл туралы маған айтпадың ба?
Dialogue: 0,0:34:16.99,0:34:21.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:34:21.56,0:34:24.10,Default,,0000,0000,0000,,Қара…
Dialogue: 0,0:34:21.56,0:34:24.10,Default,,0000,0000,0000,,Dr.
Dialogue: 0,0:34:21.56,0:34:24.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:34:21.56,0:34:24.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:34:24.10,0:34:26.03,Default,,0000,0000,0000,,Мен кейінірек орала аламын ба?
Dialogue: 0,0:34:26.03,0:34:29.50,Default,,0000,0000,0000,,(
Dialogue: 0,0:34:26.03,0:34:29.50,Default,,0000,0000,0000,,Агаса
Dialogue: 0,0:34:26.03,0:34:29.50,Default,,0000,0000,0000,,)
Dialogue: 0,0:34:26.03,0:34:29.50,Default,,0000,0000,0000,,О
Dialogue: 0,0:34:26.03,0:34:29.50,Default,,0000,0000,0000,,Бұл бір нәрсе үшін бе?
Dialogue: 0,0:34:26.03,0:34:29.50,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:34:26.03,0:34:29.50,Default,,0000,0000,0000,,Біраз
Dialogue: 0,0:34:26.03,0:34:29.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:34:33.00,0:34:35.51,Default,,0000,0000,0000,,(
Dialogue: 0,0:34:33.00,0:34:35.51,Default,,0000,0000,0000,,Агаса
Dialogue: 0,0:34:33.00,0:34:35.51,Default,,0000,0000,0000,,)
Dialogue: 0,0:34:33.00,0:34:35.51,Default,,0000,0000,0000,,Бұл не?!
Dialogue: 0,0:34:33.00,0:34:35.51,Default,,0000,0000,0000,,Даусыңыз өте қатты
Dialogue: 0,0:34:33.00,0:34:35.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:34:35.51,0:34:37.01,Default,,0000,0000,0000,,А...
Dialogue: 0,0:34:35.51,0:34:37.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:34:37.01,0:34:40.04,Default,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:34:37.01,0:34:40.04,Default,,0000,0000,0000,,Қара киінгендердің ісі ме?
Dialogue: 0,0:34:40.04,0:34:42.08,Default,,0000,0000,0000,,Менің ойымша.
Dialogue: 0,0:34:40.04,0:34:42.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:34:42.08,0:34:44.02,Default,,0000,0000,0000,,⚟Мен көремін⚞
Dialogue: 0,0:34:42.08,0:34:44.02,Default,,0000,0000,0000,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:34:44.02,0:34:46.52,Default,,0000,0000,0000,,Міне, осыны білдіреді.
Dialogue: 0,0:34:44.02,0:34:46.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:34:46.52,0:34:48.49,Default,,0000,0000,0000,,Мұны қайдан естідің?
Dialogue: 0,0:34:48.49,0:34:51.49,Default,,0000,0000,0000,,Инженер әйел
Dialogue: 0,0:34:48.49,0:34:51.49,Default,,0000,0000,0000,,Мені ұрлап әкеткен сәттен бастап
Dialogue: 0,0:34:48.49,0:34:51.49,Default,,0000,0000,0000,,.
Dialogue: 0,0:34:51.49,0:34:53.52,Default,,0000,0000,0000,,Барлығы емес
Dialogue: 0,0:34:51.49,0:34:53.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:34:53.52,0:34:56.49,Default,,0000,0000,0000,,Кім ұрлады
Dialogue: 0,0:34:53.52,0:34:56.49,Default,,0000,0000,0000,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:34:53.52,0:34:56.49,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:34:53.52,0:34:56.49,Default,,0000,0000,0000,,Ұйымдастыру
Dialogue: 0,0:34:53.52,0:34:56.49,Default,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:34:53.52,0:34:56.49,Default,,0000,0000,0000,,Бұл?
Dialogue: 0,0:34:56.49,0:34:58.50,Default,,0000,0000,0000,,Жоғары мүмкіндік
Dialogue: 0,0:34:56.49,0:34:58.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:34:58.50,0:35:02.07,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:34:58.50,0:35:02.07,Default,,0000,0000,0000,,Ертең келгенде
Dialogue: 0,0:34:58.50,0:35:02.07,Default,,0000,0000,0000,,Балаларыңызбен дереу оралыңыз.
Dialogue: 0,0:34:58.50,0:35:02.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:35:02.07,0:35:04.60,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:35:02.07,0:35:04.60,Default,,0000,0000,0000,,Айтпасаң да істеймін
Dialogue: 0,0:35:02.07,0:35:04.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:35:04.60,0:35:07.61,Default,,0000,0000,0000,,Әрине
Dialogue: 0,0:35:04.60,0:35:07.61,Default,,0000,0000,0000,,Сіз де.
Dialogue: 0,0:35:04.60,0:35:07.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:35:13.51,0:35:15.51,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:35:13.51,0:35:15.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:35:15.51,0:35:18.98,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:35:15.51,0:35:18.98,Default,,0000,0000,0000,,Менде қосалқы көзілдірік бар.
Dialogue: 0,0:35:15.51,0:35:18.98,Default,,0000,0000,0000,,.
Dialogue: 0,0:35:18.98,0:35:22.99,Default,,0000,0000,0000,,Бұл көзілдірік
Dialogue: 0,0:35:18.98,0:35:22.99,Default,,0000,0000,0000,,Бірінші машинаны доктор.
Dialogue: 0,0:35:18.98,0:35:22.99,Default,,0000,0000,0000,,.
Dialogue: 0,0:35:22.99,0:35:26.02,Default,,0000,0000,0000,,Мен саған айттым ба?
Dialogue: 0,0:35:22.99,0:35:26.02,Default,,0000,0000,0000,,Оны киген кезде➡
Dialogue: 0,0:35:26.02,0:35:28.99,Default,,0000,0000,0000,,Менің шынайы болмысым ешқашан ашылмайды.
Dialogue: 0,0:35:26.02,0:35:28.99,Default,,0000,0000,0000,,.
Dialogue: 0,0:35:30.53,0:35:35.50,Default,,0000,0000,0000,,...
Dialogue: 0,0:35:30.53,0:35:35.50,Default,,0000,0000,0000,,Жеңіл
Dialogue: 0,0:35:30.53,0:35:35.50,Default,,0000,0000,0000,,Писко біледі
Dialogue: 0,0:35:30.53,0:35:35.50,Default,,0000,0000,0000,,Мені ұрлап кетті ме?
Dialogue: 0,0:35:37.00,0:35:40.00,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:35:37.00,0:35:40.00,Default,,0000,0000,0000,,Мен темекі шегуді тастадым
Dialogue: 0,0:35:37.00,0:35:40.00,Default,,0000,0000,0000,,Сіз құтқарылдыңыз, солай ма?
Dialogue: 0,0:35:40.00,0:35:44.51,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:35:40.00,0:35:44.51,Default,,0000,0000,0000,,Тұмар деп ойладым.
Dialogue: 0,0:35:40.00,0:35:44.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:35:44.51,0:35:48.01,Default,,0000,0000,0000,,Менің қосалқы көзілдірігім және
Dialogue: 0,0:35:44.51,0:35:48.01,Default,,0000,0000,0000,,Алмасайық.
Dialogue: 0,0:35:44.51,0:35:48.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:35:49.51,0:35:53.48,Default,,0000,0000,0000,,Цукуёми, тез бол, тез бол
Dialogue: 0,0:35:49.51,0:35:53.48,Default,,0000,0000,0000,,Біз де қайтайық, Айкүн.
Dialogue: 0,0:35:49.51,0:35:53.48,Default,,0000,0000,0000,,.
Dialogue: 0,0:35:49.51,0:35:53.48,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:35:49.51,0:35:53.48,Default,,0000,0000,0000,,.
Dialogue: 0,0:35:57.59,0:35:59.59,Default,,0000,0000,0000,,《Талисман...》
Dialogue: 0,0:36:02.06,0:36:10.03,Default,,0000,0000,0000,,📱
Dialogue: 0,0:36:02.06,0:36:10.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:36:02.06,0:36:10.03,Default,,0000,0000,0000,,Діріл дыбысы
Dialogue: 0,0:36:02.06,0:36:10.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:36:12.54,0:36:16.01,Default,,0000,0000,0000,,Мысал
Dialogue: 0,0:36:12.54,0:36:16.01,Default,,0000,0000,0000,,Оны жүйеде тапқанын айтты.
Dialogue: 0,0:36:12.54,0:36:16.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:36:21.01,0:36:22.48,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:36:21.01,0:36:22.48,Default,,0000,0000,0000,,.
Dialogue: 0,0:36:23.98,0:36:26.48,Default,,0000,0000,0000,,
Dialogue: 0,0:36:23.98,0:36:26.48,Default,,0000,0000,0000,,Мен де өзімді таптым
Dialogue: 0,0:36:23.98,0:36:26.48,Default,,0000,0000,0000,,Джин
Dialogue: 0,0:36:23.98,0:36:26.48,Default,,0000,0000,0000,,.
Dialogue: 0,0:36:26.48,0:36:31.52,Default,,0000,0000,0000,,
Dialogue: 0,0:36:26.48,0:36:31.52,Default,,0000,0000,0000,,Мен ешқашан Хачижодзимадамын деп ойламадым
Dialogue: 0,0:36:26.48,0:36:31.52,Default,,0000,0000,0000,,Сәттілік біз жақта
Dialogue: 0,0:36:26.48,0:36:31.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:36:31.52,0:36:35.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:36:31.52,0:36:35.03,Default,,0000,0000,0000,,Ұйқыдағы тыныс
Dialogue: 0,0:36:31.52,0:36:35.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:36:35.03,0:36:37.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:36:35.03,0:36:37.03,Default,,0000,0000,0000,,Аюми
Dialogue: 0,0:36:35.03,0:36:37.03,Default,,0000,0000,0000,,)
