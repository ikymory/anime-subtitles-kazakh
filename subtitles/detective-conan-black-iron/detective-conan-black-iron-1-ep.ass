Dialogue: 0,0:19:36.07,0:19:41.08,Default,,0000,0000,0000,,Солардың бірі
Dialogue: 0,0:19:36.07,0:19:41.08,Default,,0000,0000,0000,,Наоми жасаған ескі және жас сертификат
Dialogue: 0,0:19:36.07,0:19:41.08,Default,,0000,0000,0000,,Бірден
Dialogue: 0,0:19:36.07,0:19:41.08,Default,,0000,0000,0000,,Тест
Dialogue: 0,0:19:36.07,0:19:41.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:44.08,0:19:47.09,Default,,0000,0000,0000,,(
Dialogue: 0,0:19:44.08,0:19:47.09,Default,,0000,0000,0000,,Аққу
Dialogue: 0,0:19:44.08,0:19:47.09,Default,,0000,0000,0000,,)
Dialogue: 0,0:19:44.08,0:19:47.09,Default,,0000,0000,0000,,Жас және кәрі аутентификация?
Dialogue: 0,0:19:47.09,0:19:51.66,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,0:19:47.09,0:19:51.66,Default,,0000,0000,0000,,Итальяндық әкесімен
Dialogue: 0,0:19:47.09,0:19:51.66,Default,,0000,0000,0000,,Жапон анасынан туған➡
