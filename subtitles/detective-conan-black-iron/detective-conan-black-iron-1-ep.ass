Dialogue: 0,1:05:40.00,1:05:42.47,Default,,0000,0000,0000,,Бас директор
Dialogue: 0,1:05:40.00,1:05:42.47,Default,,0000,0000,0000,,Сонар жауап беруде
Dialogue: 0,1:05:40.00,1:05:42.47,Default,,0000,0000,0000,,.
Dialogue: 0,1:05:42.47,1:05:44.01,Default,,0000,0000,0000,,(
Dialogue: 0,1:05:42.47,1:05:44.01,Default,,0000,0000,0000,,Макино
Dialogue: 0,1:05:42.47,1:05:44.01,Default,,0000,0000,0000,,)
Dialogue: 0,1:05:42.47,1:05:44.01,Default,,0000,0000,0000,,Не?
Dialogue: 0,1:05:44.01,1:05:46.51,Default,,0000,0000,0000,,(
Dialogue: 0,1:05:44.01,1:05:46.51,Default,,0000,0000,0000,,Инженер
Dialogue: 0,1:05:44.01,1:05:46.51,Default,,0000,0000,0000,,)
Dialogue: 0,1:05:44.01,1:05:46.51,Default,,0000,0000,0000,,Осы жерден 2 км қашықтықта
Dialogue: 0,1:05:44.01,1:05:46.51,Default,,0000,0000,0000,,Бұрандалы дыбыс
Dialogue: 0,1:05:44.01,1:05:46.51,Default,,0000,0000,0000,,.
Dialogue: 0,1:05:46.51,1:05:49.11,Default,,0000,0000,0000,,Бұрандалы дыбыс…
Dialogue: 0,1:05:46.51,1:05:49.11,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:05:49.11,1:05:53.12,Default,,0000,0000,0000,,｟Ол бізге аспаннан қосылады
Dialogue: 0,1:05:49.11,1:05:53.12,Default,,0000,0000,0000,,Басқаша айтқанда
Dialogue: 0,1:05:49.11,1:05:53.12,Default,,0000,0000,0000,,Сол кезде…｠
Dialogue: 0,1:06:00.96,1:06:02.96,Default,,0000,0000,0000,,《Ол беткей ме? 》
Dialogue: 0,1:06:02.96,1:06:04.99,Default,,0000,0000,0000,,🎙
Dialogue: 0,1:06:02.96,1:06:04.99,Default,,0000,0000,0000,,Хайбара
Dialogue: 0,1:06:02.96,1:06:04.99,Default,,0000,0000,0000,,Haibara!
Dialogue: 0,1:06:02.96,1:06:04.99,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:06:04.99,1:06:06.96,Default,,0000,0000,0000,,🎙
Dialogue: 0,1:06:04.99,1:06:06.96,Default,,0000,0000,0000,,Сіз мені естисіз бе?
Dialogue: 0,1:06:04.99,1:06:06.96,Default,,0000,0000,0000,,Эдогава-кун⁉
Dialogue: 0,1:06:06.96,1:06:11.00,Default,,0000,0000,0000,,🎙
Dialogue: 0,1:06:06.96,1:06:11.00,Default,,0000,0000,0000,,Хайбара
Dialogue: 0,1:06:06.96,1:06:11.00,Default,,0000,0000,0000,,Сіз мені естисіз бе?
Dialogue: 0,1:06:06.96,1:06:11.00,Default,,0000,0000,0000,,Edogawa-kun
Dialogue: 0,1:06:06.96,1:06:11.00,Default,,0000,0000,0000,,I can hear it!
Dialogue: 0,1:06:11.00,1:06:14.50,Default,,0000,0000,0000,,🎙
Dialogue: 0,1:06:11.00,1:06:14.50,Default,,0000,0000,0000,,Көп емес екен, иә?
Dialogue: 0,1:06:11.00,1:06:14.50,Default,,0000,0000,0000,,In a submarine?
Dialogue: 0,1:06:11.00,1:06:14.50,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,1:06:11.00,1:06:14.50,Default,,0000,0000,0000,,Бұл?
Dialogue: 0,1:06:14.50,1:06:16.54,Default,,0000,0000,0000,,Haibara
Dialogue: 0,1:06:14.50,1:06:16.54,Default,,0000,0000,0000,,тіпті ол өзі де білмейтін Титантарға қатысты бір құпия жатыр дейді.
Dialogue: 0,1:06:14.50,1:06:16.54,Default,,0000,0000,0000,,.
Dialogue: 0,1:06:16.54,1:06:20.08,Default,,0000,0000,0000,,After I kidnapped you
Dialogue: 0,1:06:16.54,1:06:20.08,Default,,0000,0000,0000,,They jumped into the sea with the car.
Dialogue: 0,1:06:16.54,1:06:20.08,Default,,0000,0000,0000,,.
Dialogue: 0,1:06:20.08,1:06:22.98,Default,,0000,0000,0000,,(Conan
Dialogue: 0,1:06:20.08,1:06:22.98,Default,,0000,0000,0000,,Дауыс
Dialogue: 0,1:06:20.08,1:06:22.98,Default,,0000,0000,0000,,)
Dialogue: 0,1:06:20.08,1:06:22.98,Default,,0000,0000,0000,,From the bridge
Dialogue: 0,1:06:20.08,1:06:22.98,Default,,0000,0000,0000,,There was no sign of boarding.
Dialogue: 0,1:06:20.08,1:06:22.98,Default,,0000,0000,0000,,.
Dialogue: 0,1:06:22.98,1:06:27.02,Default,,0000,0000,0000,,Escape from car underwater
Dialogue: 0,1:06:22.98,1:06:27.02,Default,,0000,0000,0000,,Мен жаңа ғана кірдім.
Dialogue: 0,1:06:22.98,1:06:27.02,Default,,0000,0000,0000,,.
Dialogue: 0,1:06:27.02,1:06:31.49,Default,,0000,0000,0000,,Басқаша айтқанда
Dialogue: 0,1:06:27.02,1:06:31.49,Default,,0000,0000,0000,,The submarine was out of the water.
Dialogue: 0,1:06:27.02,1:06:31.49,Default,,0000,0000,0000,,You should be able to get in and out!
Dialogue: 0,1:06:31.49,1:06:34.99,Default,,0000,0000,0000,,Ұрланған кезде
Dialogue: 0,1:06:31.49,1:06:34.99,Default,,0000,0000,0000,,I was put to sleep
Dialogue: 0,1:06:31.49,1:06:34.99,Default,,0000,0000,0000,,.
Dialogue: 0,1:06:34.99,1:06:38.49,Default,,0000,0000,0000,,⚟From where to the submarine
Dialogue: 0,1:06:34.99,1:06:38.49,Default,,0000,0000,0000,,I don’t remember if I rode it⚞
Dialogue: 0,1:06:43.57,1:06:45.97,Default,,0000,0000,0000,,Ойланып көрейікші
Dialogue: 0,1:06:43.57,1:06:45.97,Default,,0000,0000,0000,,I was just curious.
Dialogue: 0,1:06:43.57,1:06:45.97,Default,,0000,0000,0000,,.
Dialogue: 0,1:06:45.97,1:06:49.47,Default,,0000,0000,0000,,Әй?
Dialogue: 0,1:06:45.97,1:06:49.47,Default,,0000,0000,0000,,Jin is
Dialogue: 0,1:06:45.97,1:06:49.47,Default,,0000,0000,0000,,Where do I board the vehicle?
Dialogue: 0,1:06:49.47,1:06:51.97,Default,,0000,0000,0000,,From a torpedo tube like yesterday?
Dialogue: 0,1:06:51.97,1:06:55.51,Default,,0000,0000,0000,,Ха…
Dialogue: 0,1:06:51.97,1:06:55.51,Default,,0000,0000,0000,,Торпеда түтігі
Dialogue: 0,1:06:51.97,1:06:55.51,Default,,0000,0000,0000,,.
Dialogue: 0,1:06:51.97,1:06:55.51,Default,,0000,0000,0000,,🎙
Dialogue: 0,1:06:51.97,1:06:55.51,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:06:55.51,1:06:59.48,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,1:06:55.51,1:06:59.48,Default,,0000,0000,0000,,Looks like he rode from there.
Dialogue: 0,1:06:55.51,1:06:59.48,Default,,0000,0000,0000,,.
Dialogue: 0,1:06:55.51,1:06:59.48,Default,,0000,0000,0000,,🎙
Dialogue: 0,1:06:55.51,1:06:59.48,Default,,0000,0000,0000,,Divers can enter and exit➡
Dialogue: 0,1:06:59.48,1:07:03.52,Default,,0000,0000,0000,,Torpedo tube…
Dialogue: 0,1:06:59.48,1:07:03.52,Default,,0000,0000,0000,,Теңізді ластайтын ешқандай ірі қалалар жоқ—
Dialogue: 0,1:06:59.48,1:07:03.52,Default,,0000,0000,0000,,.
Dialogue: 0,1:07:03.52,1:07:07.09,Default,,0000,0000,0000,,For Aniki
Dialogue: 0,1:07:03.52,1:07:07.09,Default,,0000,0000,0000,,Мен сені көпірден аман-есен отырғызамын.
Dialogue: 0,1:07:03.52,1:07:07.09,Default,,0000,0000,0000,,.
Dialogue: 0,1:07:07.09,1:07:08.99,Default,,0000,0000,0000,,That's why I surfaced.
Dialogue: 0,1:07:07.09,1:07:08.99,Default,,0000,0000,0000,,.
Dialogue: 0,1:07:08.99,1:07:14.00,Default,,0000,0000,0000,,Who goes in and out from there?
Dialogue: 0,1:07:08.99,1:07:14.00,Default,,0000,0000,0000,,Бұл қазірдің өзінде қиын
Dialogue: 0,1:07:08.99,1:07:14.00,Default,,0000,0000,0000,,Менің бауырым суық.
Dialogue: 0,1:07:08.99,1:07:14.00,Default,,0000,0000,0000,,.
Dialogue: 0,1:07:14.00,1:07:16.00,Default,,0000,0000,0000,,О.
Dialogue: 0,1:07:14.00,1:07:16.00,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,1:07:16.00,1:07:19.00,Default,,0000,0000,0000,,🦻
Dialogue: 0,1:07:16.00,1:07:19.00,Default,,0000,0000,0000,,(киль)
Dialogue: 0,1:07:16.00,1:07:19.00,Default,,0000,0000,0000,,Сары түймені бассаңыз
Dialogue: 0,1:07:16.00,1:07:19.00,Default,,0000,0000,0000,,Оны ұшыру түтігіне салыңыз, солай ма?
Dialogue: 0,1:07:19.00,1:07:25.01,Default,,0000,0000,0000,,🦻
Dialogue: 0,1:07:19.00,1:07:25.01,Default,,0000,0000,0000,,Осыдан кейін теңіз суы автоматты түрде ішке кіреді.
Dialogue: 0,1:07:19.00,1:07:25.01,Default,,0000,0000,0000,,Есік де автоматты түрде ашылады...
Dialogue: 0,1:07:19.00,1:07:25.01,Default,,0000,0000,0000,,Бұл оңай емес
Dialogue: 0,1:07:19.00,1:07:25.01,Default,,0000,0000,0000,,.
Dialogue: 0,1:07:25.01,1:07:27.04,Default,,0000,0000,0000,,Автоматты түрде теңізге бару...
Dialogue: 0,1:07:25.01,1:07:27.04,Default,,0000,0000,0000,,.
Dialogue: 0,1:07:27.04,1:07:30.48,Default,,0000,0000,0000,,Ба-ка
Dialogue: 0,1:07:27.04,1:07:30.48,Default,,0000,0000,0000,,Сіз әдетте торпедаларды атасыз, солай ма?
Dialogue: 0,1:07:30.48,1:07:35.02,Default,,0000,0000,0000,,Біреу қателесті
Dialogue: 0,1:07:30.48,1:07:35.02,Default,,0000,0000,0000,,Егер сіз сол тұтқаны тартсаңыз
Dialogue: 0,1:07:30.48,1:07:35.02,Default,,0000,0000,0000,,Паа
Dialogue: 0,1:07:30.48,1:07:35.02,Default,,0000,0000,0000,,.
Dialogue: 0,1:07:35.02,1:07:36.49,Default,,0000,0000,0000,,Тетік?
Dialogue: 0,1:07:36.49,1:07:41.49,Default,,0000,0000,0000,,Не!?
Dialogue: 0,1:07:36.49,1:07:41.49,Default,,0000,0000,0000,,Оны тіпті білмеймін
Dialogue: 0,1:07:36.49,1:07:41.49,Default,,0000,0000,0000,,Сіз бортта болдыңыз ба?
Dialogue: 0,1:07:36.49,1:07:41.49,Default,,0000,0000,0000,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,1:07:42.99,1:07:45.49,Default,,0000,0000,0000,,
Dialogue: 0,1:07:42.99,1:07:45.49,Default,,0000,0000,0000,,Осы жасыл тұтқаны ➡ тартыңыз
Dialogue: 0,1:07:45.49,1:07:48.50,Default,,0000,0000,0000,,Іске қосу түтігінде
Dialogue: 0,1:07:45.49,1:07:48.50,Default,,0000,0000,0000,,Қысылған ауа сыртқа шығарылады
Dialogue: 0,1:07:45.49,1:07:48.50,Default,,0000,0000,0000,,.
Dialogue: 0,1:07:48.50,1:07:52.07,Default,,0000,0000,0000,,Егер
Dialogue: 0,1:07:48.50,1:07:52.07,Default,,0000,0000,0000,,Сол кезде
Dialogue: 0,1:07:48.50,1:07:52.07,Default,,0000,0000,0000,,Ішінде адамдар болса...
Dialogue: 0,1:07:48.50,1:07:52.07,Default,,0000,0000,0000,,.
Dialogue: 0,1:07:52.07,1:07:55.00,Default,,0000,0000,0000,,(киль)
Dialogue: 0,1:07:52.07,1:07:55.00,Default,,0000,0000,0000,,Өміріңізді жоғалту…
Dialogue: 0,1:07:52.07,1:07:55.00,Default,,0000,0000,0000,,Мен ұмытып қалдым
Dialogue: 0,1:07:52.07,1:07:55.00,Default,,0000,0000,0000,,.
Dialogue: 0,1:07:55.00,1:07:58.01,Default,,0000,0000,0000,,
Dialogue: 0,1:07:55.00,1:07:58.01,Default,,0000,0000,0000,,Яғни, қарапайым есептеу бойынша да ол тек екі минуттан кейін ғана пайда болуы тиіс еді.
Dialogue: 0,1:07:55.00,1:07:58.01,Default,,0000,0000,0000,,Алып тасташы, өтінемін...?
Dialogue: 0,1:07:55.00,1:07:58.01,Default,,0000,0000,0000,,.
Dialogue: 0,1:07:58.01,1:08:01.01,Default,,0000,0000,0000,,Мен қашудың жолын білдім
Dialogue: 0,1:07:58.01,1:08:01.01,Default,,0000,0000,0000,,.
Dialogue: 0,1:07:58.01,1:08:01.01,Default,,0000,0000,0000,,🎙
Dialogue: 0,1:07:58.01,1:08:01.01,Default,,0000,0000,0000,,Дегенмен, мен әлі күн бойы Толық шоғырланған тыныс алуды ұстап тұра алмаймын.
Dialogue: 0,1:08:01.01,1:08:03.48,Default,,0000,0000,0000,,🎙
Dialogue: 0,1:08:01.01,1:08:03.48,Default,,0000,0000,0000,,Жарайды
Dialogue: 0,1:08:01.01,1:08:03.48,Default,,0000,0000,0000,,Сіз және Наоми ➡
Dialogue: 0,1:08:03.48,1:08:06.45,Default,,0000,0000,0000,,Маған көмектесіңізші!
Dialogue: 0,1:08:06.45,1:08:10.02,Default,,0000,0000,0000,,《Қалғаны
Dialogue: 0,1:08:06.45,1:08:10.02,Default,,0000,0000,0000,,Осы жұмысты жасай алсаңыз...》
Dialogue: 0,1:08:10.02,1:08:14.09,Default,,0000,0000,0000,,(
Dialogue: 0,1:08:10.02,1:08:14.09,Default,,0000,0000,0000,,Орхидея
Dialogue: 0,1:08:10.02,1:08:14.09,Default,,0000,0000,0000,,)
Dialogue: 0,1:08:10.02,1:08:14.09,Default,,0000,0000,0000,,⚟Конан! ⚞
Dialogue: 0,1:08:10.02,1:08:14.09,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:08:10.02,1:08:14.09,Default,,0000,0000,0000,,♬~
Dialogue: 0,1:08:10.02,1:08:14.09,Default,,0000,0000,0000,,.
Dialogue: 0,1:08:14.09,1:08:15.56,Default,,0000,0000,0000,,Орхидея?
Dialogue: 0,1:08:16.96,1:08:20.96,Default,,0000,0000,0000,,Тікұшақ жақында келеді.
Dialogue: 0,1:08:16.96,1:08:20.96,Default,,0000,0000,0000,,.
Dialogue: 0,1:08:16.96,1:08:20.96,Default,,0000,0000,0000,,Жарайды
Dialogue: 0,1:08:16.96,1:08:20.96,Default,,0000,0000,0000,,.
Dialogue: 0,1:08:20.96,1:08:23.47,Default,,0000,0000,0000,,(арақ
Dialogue: 0,1:08:20.96,1:08:23.47,Default,,0000,0000,0000,,Дауыс
Dialogue: 0,1:08:20.96,1:08:23.47,Default,,0000,0000,0000,,)
Dialogue: 0,1:08:20.96,1:08:23.47,Default,,0000,0000,0000,,Джин Аникимен кездесу.
Dialogue: 0,1:08:20.96,1:08:23.47,Default,,0000,0000,0000,,.
Dialogue: 0,1:08:30.97,1:08:33.48,Default,,0000,0000,0000,,Келеді...
Dialogue: 0,1:08:30.97,1:08:33.48,Default,,0000,0000,0000,,.
Dialogue: 0,1:08:33.48,1:08:36.01,Default,,0000,0000,0000,,Мен қашып кетемін.
Dialogue: 0,1:08:33.48,1:08:36.01,Default,,0000,0000,0000,,.
Dialogue: 0,1:08:36.01,1:08:37.55,Default,,0000,0000,0000,,Оның қуыршаққа айналдырған рухтары да керемет екенін естідім.
Dialogue: 0,1:08:36.01,1:08:37.55,Default,,0000,0000,0000,,.
Dialogue: 0,1:08:37.55,1:08:39.52,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,1:08:37.55,1:08:39.52,Default,,0000,0000,0000,,.
Dialogue: 0,1:08:40.45,1:08:41.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:08:41.98,1:08:44.49,Default,,0000,0000,0000,,Түсінуге оңай позада
Dialogue: 0,1:08:41.98,1:08:44.49,Default,,0000,0000,0000,,Жаңа ғана байланған
Dialogue: 0,1:08:41.98,1:08:44.49,Default,,0000,0000,0000,,.
Dialogue: 0,1:08:44.49,1:08:48.46,Default,,0000,0000,0000,,Сиқыршы
Dialogue: 0,1:08:44.49,1:08:48.46,Default,,0000,0000,0000,,Бұл мен жиі қолданатын қимыл.
Dialogue: 0,1:08:44.49,1:08:48.46,Default,,0000,0000,0000,,.
Dialogue: 0,1:08:44.49,1:08:48.46,Default,,0000,0000,0000,,Не керек, Крюгер мырза?
Dialogue: 0,1:08:44.49,1:08:48.46,Default,,0000,0000,0000,,Өзіңді тым биік ұстама! (Какиёин) Қойсаңшы енді!
Dialogue: 0,1:08:44.49,1:08:48.46,Default,,0000,0000,0000,,.
Dialogue: 0,1:08:48.46,1:08:50.96,Default,,0000,0000,0000,,Мұнда екеніңе сенбеймін
Dialogue: 0,1:08:48.46,1:08:50.96,Default,,0000,0000,0000,,Барайық
Dialogue: 0,1:08:48.46,1:08:50.96,Default,,0000,0000,0000,,.
Dialogue: 0,1:08:50.96,1:08:53.96,Default,,0000,0000,0000,,Оны көп айтпа
Dialogue: 0,1:08:50.96,1:08:53.96,Default,,0000,0000,0000,,Мүлде мүмкін емес!
Dialogue: 0,1:08:53.96,1:08:56.50,Default,,0000,0000,0000,,(
Dialogue: 0,1:08:53.96,1:08:56.50,Default,,0000,0000,0000,,Хайбардың дауысы
Dialogue: 0,1:08:53.96,1:08:56.50,Default,,0000,0000,0000,,)
Dialogue: 0,1:08:53.96,1:08:56.50,Default,,0000,0000,0000,,Нәсілден тыс әлем тыныштығы
Dialogue: 0,1:08:53.96,1:08:56.50,Default,,0000,0000,0000,,.
Dialogue: 0,1:08:56.50,1:09:00.04,Default,,0000,0000,0000,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,1:08:56.50,1:09:00.04,Default,,0000,0000,0000,,Сіз және сіздің әкеңіз
Dialogue: 0,1:08:56.50,1:09:00.04,Default,,0000,0000,0000,,Бұл арман, солай ма?
Dialogue: 0,1:09:00.04,1:09:01.97,Default,,0000,0000,0000,,(
Dialogue: 0,1:09:00.04,1:09:01.97,Default,,0000,0000,0000,,Наомидің дауысы
Dialogue: 0,1:09:00.04,1:09:01.97,Default,,0000,0000,0000,,)
Dialogue: 0,1:09:00.04,1:09:01.97,Default,,0000,0000,0000,,Тіпті оның әкесі
Dialogue: 0,1:09:00.04,1:09:01.97,Default,,0000,0000,0000,,Қазірдің өзінде...
Dialogue: 0,1:09:00.04,1:09:01.97,Default,,0000,0000,0000,,.
Dialogue: 0,1:09:01.97,1:09:04.97,Default,,0000,0000,0000,,Өмір сүруге міндеттісің
Dialogue: 0,1:09:01.97,1:09:04.97,Default,,0000,0000,0000,,.
Dialogue: 0,1:09:04.97,1:09:09.48,Default,,0000,0000,0000,,Ай-чан мен Конан-кун сияқты
Dialogue: 0,1:09:04.97,1:09:09.48,Default,,0000,0000,0000,,Балалар не істей алады?
Dialogue: 0,1:09:09.48,1:09:12.45,Default,,0000,0000,0000,,Сіз не істей аласыз?
Dialogue: 0,1:09:14.45,1:09:16.45,Default,,0000,0000,0000,,О.
Dialogue: 0,1:09:14.45,1:09:16.45,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:09:14.45,1:09:16.45,Default,,0000,0000,0000,,.
