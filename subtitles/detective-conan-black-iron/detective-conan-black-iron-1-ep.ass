Dialogue: 0,0:46:28.49,0:46:31.49,Default,,0000,0000,0000,,Мені ұрлап әкетті.
Dialogue: 0,0:46:28.49,0:46:31.49,Default,,0000,0000,0000,,.
Dialogue: 0,0:46:31.49,0:46:32.99,Default,,0000,0000,0000,,(
Dialogue: 0,0:46:31.49,0:46:32.99,Default,,0000,0000,0000,,Дауысты өзгерткіш
Dialogue: 0,0:46:31.49,0:46:32.99,Default,,0000,0000,0000,,)
Dialogue: 0,0:46:31.49,0:46:32.99,Default,,0000,0000,0000,,Мен білемін
Dialogue: 0,0:46:31.49,0:46:32.99,Default,,0000,0000,0000,,.
Dialogue: 0,0:46:32.99,0:46:36.53,Default,,0000,0000,0000,,(
Dialogue: 0,0:46:32.99,0:46:36.53,Default,,0000,0000,0000,,Дауысты өзгертуші
Dialogue: 0,0:46:32.99,0:46:36.53,Default,,0000,0000,0000,,)
Dialogue: 0,0:46:32.99,0:46:36.53,Default,,0000,0000,0000,,Жоқ, бұл 70 пайызға жетеді, бұл
Dialogue: 0,0:46:32.99,0:46:36.53,Default,,0000,0000,0000,,Мен сол жаққа барып, сен үшін жасаймын.
Dialogue: 0,0:46:32.99,0:46:36.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:46:36.53,0:46:39.03,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:46:36.53,0:46:39.03,Default,,0000,0000,0000,,Бұл уәде.
Dialogue: 0,0:46:36.53,0:46:39.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:46:39.03,0:46:40.56,Default,,0000,0000,0000,,(
Dialogue: 0,0:46:39.03,0:46:40.56,Default,,0000,0000,0000,,Дауысты өзгерткіш
Dialogue: 0,0:46:39.03,0:46:40.56,Default,,0000,0000,0000,,)
Dialogue: 0,0:46:39.03,0:46:40.56,Default,,0000,0000,0000,,О
Dialogue: 0,0:46:39.03,0:46:40.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:46:40.56,0:46:42.03,Default,,0000,0000,0000,,📱
Dialogue: 0,0:46:40.56,0:46:42.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:46:40.56,0:46:42.03,Default,,0000,0000,0000,,Қоңыраудың аяқталу дыбысы
Dialogue: 0,0:46:40.56,0:46:42.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:46:43.60,0:46:47.57,Default,,0000,0000,0000,,
Dialogue: 0,0:46:43.60,0:46:47.57,Default,,0000,0000,0000,,Төтенше жағдайда...
Dialogue: 0,0:46:43.60,0:46:47.57,Default,,0000,0000,0000,,На
Dialogue: 0,0:46:43.60,0:46:47.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:46:50.61,0:46:57.58,Default,,0000,0000,0000,,｟Қол кісеннің тартылған дыбысы｠
Dialogue: 0,0:47:00.58,0:47:04.09,Default,,0000,0000,0000,,｟Га
Dialogue: 0,0:47:00.58,0:47:04.09,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:47:00.58,0:47:04.09,Default,,0000,0000,0000,,Аа...｠
Dialogue: 0,0:47:12.06,0:47:13.60,Default,,0000,0000,0000,,｟Уф! ｠
Dialogue: 0,0:47:13.60,0:47:17.10,Default,,0000,0000,0000,,｟Гах!
Dialogue: 0,0:47:13.60,0:47:17.10,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:47:13.60,0:47:17.10,Default,,0000,0000,0000,,Ах...! ｠
Dialogue: 0,0:47:17.10,0:47:20.50,Default,,0000,0000,0000,,｟Уф
Dialogue: 0,0:47:17.10,0:47:20.50,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:47:17.10,0:47:20.50,Default,,0000,0000,0000,,Ах! ｠
Dialogue: 0,0:47:20.50,0:47:33.42,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:47:37.09,0:47:40.09,Default,,0000,0000,0000,,｟Га
Dialogue: 0,0:47:37.09,0:47:40.09,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:47:37.09,0:47:40.09,Default,,0000,0000,0000,,Аа...｠
Dialogue: 0,0:47:42.03,0:47:45.03,Default,,0000,0000,0000,,｟Мен сияқты
Dialogue: 0,0:47:42.03,0:47:45.03,Default,,0000,0000,0000,,Сәби болу мүмкіндігі жоғары➡
Dialogue: 0,0:47:45.03,0:47:47.03,Default,,0000,0000,0000,,Шиничи Кудо｠
Dialogue: 0,0:47:52.17,0:47:54.20,Default,,0000,0000,0000,,｟Егер бұл Шиничи Кудо болса…｠
Dialogue: 0,0:47:54.20,0:47:56.17,Default,,0000,0000,0000,,｜Адамдар｠
Dialogue: 0,0:47:58.61,0:48:01.08,Default,,0000,0000,0000,,｟Мм...
Dialogue: 0,0:47:58.61,0:48:01.08,Default,,0000,0000,0000,,Ах! ｠
Dialogue: 0,0:48:05.58,0:48:07.08,Default,,0000,0000,0000,,｟Ах! ｠
Dialogue: 0,0:48:09.09,0:48:12.06,Default,,0000,0000,0000,,｟Темекі шегу дыбысы｠
Dialogue: 0,0:48:09.09,0:48:12.06,Default,,0000,0000,0000,,(
Dialogue: 0,0:48:09.09,0:48:12.06,Default,,0000,0000,0000,,Джин
Dialogue: 0,0:48:09.09,0:48:12.06,Default,,0000,0000,0000,,)
Dialogue: 0,0:48:09.09,0:48:12.06,Default,,0000,0000,0000,,｟Мен сені сағындым➡
Dialogue: 0,0:48:12.06,0:48:14.69,Default,,0000,0000,0000,,Шерри｠
Dialogue: 0,0:48:14.69,0:48:16.59,Default,,0000,0000,0000,,｟Ха! ｠
Dialogue: 0,0:48:16.59,0:48:18.60,Default,,0000,0000,0000,,｟Мылтық｠
Dialogue: 0,0:48:16.59,0:48:18.60,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:48:21.50,0:48:25.50,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:48:21.50,0:48:25.50,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:48:21.50,0:48:25.50,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:48:21.50,0:48:25.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:48:27.50,0:48:29.57,Default,,0000,0000,0000,,Жақсы
Dialogue: 0,0:48:27.50,0:48:29.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:48:29.57,0:48:31.94,Default,,0000,0000,0000,,Е...!
Dialogue: 0,0:48:29.57,0:48:31.94,Default,,0000,0000,0000,,ал екіншісі – «бар күшіңді салу»!
Dialogue: 0,0:48:29.57,0:48:31.94,Default,,0000,0000,0000,,Who?
Dialogue: 0,0:48:33.61,0:48:36.11,Default,,0000,0000,0000,,Бұл қорқынышты болды, солай емес пе?
Dialogue: 0,0:48:33.61,0:48:36.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:48:38.02,0:48:40.98,Default,,0000,0000,0000,,Не керек, Крюгер мырза?
Dialogue: 0,0:48:38.02,0:48:40.98,Default,,0000,0000,0000,,Бұл жаңалық екеніне сенімдімін...
Dialogue: 0,0:48:38.02,0:48:40.98,Default,,0000,0000,0000,,.
Dialogue: 0,0:48:40.98,0:48:43.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:48:40.98,0:48:43.02,Default,,0000,0000,0000,,Не дедің?
Dialogue: 0,0:48:43.02,0:48:45.52,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:48:43.02,0:48:45.52,Default,,0000,0000,0000,,Бұл қайда?
Dialogue: 0,0:48:45.52,0:48:50.53,Default,,0000,0000,0000,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:48:45.52,0:48:50.53,Default,,0000,0000,0000,,Менің ойымша, бұл сүңгуір қайық.
Dialogue: 0,0:48:45.52,0:48:50.53,Default,,0000,0000,0000,,Мен де түсінбеймін
Dialogue: 0,0:48:45.52,0:48:50.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:48:54.53,0:48:56.60,Default,,0000,0000,0000,,Кім...
Dialogue: 0,0:48:54.53,0:48:56.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:48:56.60,0:48:58.00,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:48:58.00,0:49:02.51,Default,,0000,0000,0000,,Шихо
Dialogue: 0,0:48:58.00,0:49:02.51,Default,,0000,0000,0000,,Не керек, Крюгер мырза?
Dialogue: 0,0:48:58.00,0:49:02.51,Default,,0000,0000,0000,,Шынымен ұқсас
Dialogue: 0,0:48:58.00,0:49:02.51,Default,,0000,0000,0000,,Шихоға
Dialogue: 0,0:48:58.00,0:49:02.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:49:02.51,0:49:04.04,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:49:04.04,0:49:08.51,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:49:04.04,0:49:08.51,Default,,0000,0000,0000,,Шихо
Dialogue: 0,0:49:04.04,0:49:08.51,Default,,0000,0000,0000,,Өйткені мен ересек адаммын
Dialogue: 0,0:49:04.04,0:49:08.51,Default,,0000,0000,0000,,Шихо кішкентай кезінде.
Dialogue: 0,0:49:04.04,0:49:08.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:49:08.51,0:49:10.98,Default,,0000,0000,0000,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:49:08.51,0:49:10.98,Default,,0000,0000,0000,,Бұл дұрыс
Dialogue: 0,0:49:08.51,0:49:10.98,Default,,0000,0000,0000,,.
Dialogue: 0,0:49:13.02,0:49:17.59,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:49:13.02,0:49:17.59,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:49:13.02,0:49:17.59,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:49:13.02,0:49:17.59,Default,,0000,0000,0000,,Мені байламаңыз.
Dialogue: 0,0:49:13.02,0:49:17.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:49:17.59,0:49:19.99,Default,,0000,0000,0000,,(киль)
Dialogue: 0,0:49:17.59,0:49:19.99,Default,,0000,0000,0000,,Бұндай балаға оның керегі жоқ.
Dialogue: 0,0:49:17.59,0:49:19.99,Default,,0000,0000,0000,,.
Dialogue: 0,0:49:19.99,0:49:21.99,Default,,0000,0000,0000,,
Dialogue: 0,0:49:19.99,0:49:21.99,Default,,0000,0000,0000,,Әйтеуір, әйтеуір.
Dialogue: 0,0:49:19.99,0:49:21.99,Default,,0000,0000,0000,,.
Dialogue: 0,0:49:21.99,0:49:23.99,Default,,0000,0000,0000,,(киль)
Dialogue: 0,0:49:21.99,0:49:23.99,Default,,0000,0000,0000,,...
Dialogue: 0,0:49:21.99,0:49:23.99,Default,,0000,0000,0000,,Мен мұны істеймін
Dialogue: 0,0:49:21.99,0:49:23.99,Default,,0000,0000,0000,,.
Dialogue: 0,0:49:23.99,0:49:27.03,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:49:23.99,0:49:27.03,Default,,0000,0000,0000,,Сіз мұны растағыңыз келеді, солай ма?
Dialogue: 0,0:49:27.03,0:49:29.03,Default,,0000,0000,0000,,
Dialogue: 0,0:49:27.03,0:49:29.03,Default,,0000,0000,0000,,Иә, бір жағынан солай.
Dialogue: 0,0:49:27.03,0:49:29.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:49:29.03,0:49:30.90,Default,,0000,0000,0000,,(киль)
Dialogue: 0,0:49:29.03,0:49:30.90,Default,,0000,0000,0000,,Аяқтан.
Dialogue: 0,0:49:29.03,0:49:30.90,Default,,0000,0000,0000,,.
Dialogue: 0,0:49:39.11,0:49:41.08,Default,,0000,0000,0000,,(киль)
Dialogue: 0,0:49:39.11,0:49:41.08,Default,,0000,0000,0000,,Қол
Dialogue: 0,0:49:39.11,0:49:41.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:49:53.06,0:49:56.53,Default,,0000,0000,0000,,
Dialogue: 0,0:49:53.06,0:49:56.53,Default,,0000,0000,0000,,«Осы баланың Қвиркі болмаса да—»
Dialogue: 0,0:49:53.06,0:49:56.53,Default,,0000,0000,0000,,Мен бұған сенбеймін.
Dialogue: 0,0:49:53.06,0:49:56.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:49:58.03,0:50:00.53,Default,,0000,0000,0000,,Алып тасташы, өтінемін...?
Dialogue: 0,0:49:58.03,0:50:00.53,Default,,0000,0000,0000,,Бұл Шерри ме?
Dialogue: 0,0:50:03.03,0:50:05.04,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:50:05.04,0:50:08.61,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:50:05.04,0:50:08.61,Default,,0000,0000,0000,,Мұндайды есту өте сирек
Dialogue: 0,0:50:05.04,0:50:08.61,Default,,0000,0000,0000,,Сіз бұл әйелді айтып тұрсыз ба?
Dialogue: 0,0:50:08.61,0:50:10.57,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:50:08.61,0:50:10.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:50:13.54,0:50:16.01,Default,,0000,0000,0000,,
Dialogue: 0,0:50:13.54,0:50:16.01,Default,,0000,0000,0000,,Тс!
Dialogue: 0,0:50:13.54,0:50:16.01,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:50:13.54,0:50:16.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:50:16.01,0:50:18.52,Default,,0000,0000,0000,,Енді үндемейтін уақыт.
Dialogue: 0,0:50:16.01,0:50:18.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:50:18.52,0:50:21.99,Default,,0000,0000,0000,,(киль)
Dialogue: 0,0:50:18.52,0:50:21.99,Default,,0000,0000,0000,,Тірі қал
Dialogue: 0,0:50:18.52,0:50:21.99,Default,,0000,0000,0000,,Раммен кездесуге рұқсат етуден басқа амалым жоқ.
Dialogue: 0,0:50:18.52,0:50:21.99,Default,,0000,0000,0000,,.
Dialogue: 0,0:50:21.99,0:50:24.49,Default,,0000,0000,0000,,
Dialogue: 0,0:50:21.99,0:50:24.49,Default,,0000,0000,0000,,Бірінші қадам - ​​Джин Аникимен кездесу.
Dialogue: 0,0:50:21.99,0:50:24.49,Default,,0000,0000,0000,,.
Dialogue: 0,0:50:24.49,0:50:27.99,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:50:24.49,0:50:27.99,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:50:24.49,0:50:27.99,Default,,0000,0000,0000,,.
Dialogue: 0,0:50:33.53,0:50:35.50,Default,,0000,0000,0000,,(
Dialogue: 0,0:50:33.53,0:50:35.50,Default,,0000,0000,0000,,Аюми
Dialogue: 0,0:50:33.53,0:50:35.50,Default,,0000,0000,0000,,)
Dialogue: 0,0:50:33.53,0:50:35.50,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:50:33.53,0:50:35.50,Default,,0000,0000,0000,,Ай-чан⁉
Dialogue: 0,0:50:35.50,0:50:37.50,Default,,0000,0000,0000,,Мен кеше жақсы болдым.
Dialogue: 0,0:50:35.50,0:50:37.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:50:37.50,0:50:40.00,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:50:37.50,0:50:40.00,Default,,0000,0000,0000,,Біз
Dialogue: 0,0:50:37.50,0:50:40.00,Default,,0000,0000,0000,,Мен сізге қонаққа барамын!
Dialogue: 0,0:50:40.00,0:50:41.51,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:50:40.00,0:50:41.51,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:50:41.51,0:50:43.51,Default,,0000,0000,0000,,(
Dialogue: 0,0:50:41.51,0:50:43.51,Default,,0000,0000,0000,,Гента
Dialogue: 0,0:50:41.51,0:50:43.51,Default,,0000,0000,0000,,)
Dialogue: 0,0:50:41.51,0:50:43.51,Default,,0000,0000,0000,,Унаджу
Dialogue: 0,0:50:41.51,0:50:43.51,Default,,0000,0000,0000,,Оны кіргізейік.
Dialogue: 0,0:50:41.51,0:50:43.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:50:43.51,0:50:47.01,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:50:43.51,0:50:47.01,Default,,0000,0000,0000,,Сіз суық тиіп қаласыз, солай ма?
Dialogue: 0,0:50:43.51,0:50:47.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:50:47.01,0:50:49.58,Default,,0000,0000,0000,,Ай-чан
Dialogue: 0,0:50:47.01,0:50:49.58,Default,,0000,0000,0000,,Бұл соншалықты нашар ма?
Dialogue: 0,0:50:49.58,0:50:51.62,Default,,0000,0000,0000,,Мен ауруханада емделіп жатырмын.
Dialogue: 0,0:50:49.58,0:50:51.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:50:51.62,0:50:53.48,Default,,0000,0000,0000,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:50:51.62,0:50:53.48,Default,,0000,0000,0000,,.
Dialogue: 0,0:50:51.62,0:50:53.48,Default,,0000,0000,0000,,(
Dialogue: 0,0:50:51.62,0:50:53.48,Default,,0000,0000,0000,,Аюми
Dialogue: 0,0:50:51.62,0:50:53.48,Default,,0000,0000,0000,,)
Dialogue: 0,0:50:51.62,0:50:53.48,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:50:51.62,0:50:53.48,Default,,0000,0000,0000,,.
Dialogue: 0,0:50:53.48,0:50:57.02,Default,,0000,0000,0000,,(
Dialogue: 0,0:50:53.48,0:50:57.02,Default,,0000,0000,0000,,Соноко
Dialogue: 0,0:50:53.48,0:50:57.02,Default,,0000,0000,0000,,)
Dialogue: 0,0:50:53.48,0:50:57.02,Default,,0000,0000,0000,,Өйткені мен крейсер ұйымдастырдым
Dialogue: 0,0:50:53.48,0:50:57.02,Default,,0000,0000,0000,,Барлығы дайындал
Dialogue: 0,0:50:53.48,0:50:57.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:50:57.02,0:50:59.52,Default,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:50:57.02,0:50:59.52,Default,,0000,0000,0000,,(
Dialogue: 0,0:50:57.02,0:50:59.52,Default,,0000,0000,0000,,3 адам
Dialogue: 0,0:50:57.02,0:50:59.52,Default,,0000,0000,0000,,)
Dialogue: 0,0:50:57.02,0:50:59.52,Default,,0000,0000,0000,,(Hol Horse) 'Құдай-ай! Бізді қамап тастады. ➡
Dialogue: 0,0:50:57.02,0:50:59.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:50:59.52,0:51:02.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:50:59.52,0:51:02.03,Default,,0000,0000,0000,,Мегур
Dialogue: 0,0:50:59.52,0:51:02.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:50:59.52,0:51:02.03,Default,,0000,0000,0000,,Мори-кун
Dialogue: 0,0:50:59.52,0:51:02.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:50:59.52,0:51:02.03,Default,,0000,0000,0000,,Инспектор
Dialogue: 0,0:50:59.52,0:51:02.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:51:02.03,0:51:05.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:51:02.03,0:51:05.03,Default,,0000,0000,0000,,Мегур
Dialogue: 0,0:51:02.03,0:51:05.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:51:02.03,0:51:05.03,Default,,0000,0000,0000,,Кешіріңіз, бірақ
Dialogue: 0,0:51:02.03,0:51:05.03,Default,,0000,0000,0000,,Конан-кунмен
Dialogue: 0,0:51:02.03,0:51:05.03,Default,,0000,0000,0000,,Менімен келесің бе?
Dialogue: 0,0:51:05.03,0:51:06.50,Default,,0000,0000,0000,,(
Dialogue: 0,0:51:05.03,0:51:06.50,Default,,0000,0000,0000,,2 адам
Dialogue: 0,0:51:05.03,0:51:06.50,Default,,0000,0000,0000,,)
Dialogue: 0,0:51:05.03,0:51:06.50,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:51:09.53,0:51:12.10,Default,,0000,0000,0000,,📱
Dialogue: 0,0:51:09.53,0:51:12.10,Default,,0000,0000,0000,,(
Dialogue: 0,0:51:09.53,0:51:12.10,Default,,0000,0000,0000,,Діріл дыбысы
Dialogue: 0,0:51:09.53,0:51:12.10,Default,,0000,0000,0000,,)
Dialogue: 0,0:51:09.53,0:51:12.10,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:51:09.53,0:51:12.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:51:12.10,0:51:13.50,Default,,0000,0000,0000,,📱
Dialogue: 0,0:51:12.10,0:51:13.50,Default,,0000,0000,0000,,(
Dialogue: 0,0:51:12.10,0:51:13.50,Default,,0000,0000,0000,,Діріл дыбысы
Dialogue: 0,0:51:12.10,0:51:13.50,Default,,0000,0000,0000,,)
Dialogue: 0,0:51:13.50,0:51:16.51,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:51:13.50,0:51:16.51,Default,,0000,0000,0000,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:51:13.50,0:51:16.51,Default,,0000,0000,0000,,Қазір аяқтаңыз
Dialogue: 0,0:51:13.50,0:51:16.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:51:16.51,0:51:19.01,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:51:16.51,0:51:19.01,Default,,0000,0000,0000,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:51:16.51,0:51:19.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:51:19.01,0:51:22.51,Default,,0000,0000,0000,,Мен…
Dialogue: 0,0:51:19.01,0:51:22.51,Default,,0000,0000,0000,,Itata!
Dialogue: 0,0:51:19.01,0:51:22.51,Default,,0000,0000,0000,,Әйтеуір, ол жақында ғана қорқынышты сынақтан өтті
Dialogue: 0,0:51:19.01,0:51:22.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:51:19.01,0:51:22.51,Default,,0000,0000,0000,,(
Dialogue: 0,0:51:19.01,0:51:22.51,Default,,0000,0000,0000,,Мегур
Dialogue: 0,0:51:19.01,0:51:22.51,Default,,0000,0000,0000,,)
Dialogue: 0,0:51:19.01,0:51:22.51,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:51:22.51,0:51:25.02,Default,,0000,0000,0000,,📱
Dialogue: 0,0:51:22.51,0:51:25.02,Default,,0000,0000,0000,,(
Dialogue: 0,0:51:22.51,0:51:25.02,Default,,0000,0000,0000,,Діріл дыбысы
Dialogue: 0,0:51:22.51,0:51:25.02,Default,,0000,0000,0000,,)
Dialogue: 0,0:51:22.51,0:51:25.02,Default,,0000,0000,0000,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:51:22.51,0:51:25.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:51:25.02,0:51:27.02,Default,,0000,0000,0000,,Амуро
Dialogue: 0,0:51:25.02,0:51:27.02,Default,,0000,0000,0000,,📱
Dialogue: 0,0:51:25.02,0:51:27.02,Default,,0000,0000,0000,,Амуро мырза
Dialogue: 0,0:51:25.02,0:51:27.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:51:27.02,0:51:30.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:51:27.02,0:51:30.05,Default,,0000,0000,0000,,Амуро
Dialogue: 0,0:51:27.02,0:51:30.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:51:27.02,0:51:30.05,Default,,0000,0000,0000,,Қонақүйде ұрланған қыз
Dialogue: 0,0:51:27.02,0:51:30.05,Default,,0000,0000,0000,,Ол сіз білетін адам, солай ма?
Dialogue: 0,0:51:30.05,0:51:32.12,Default,,0000,0000,0000,,Мен кеше телефон соғуды күтпедім...
Dialogue: 0,0:51:30.05,0:51:32.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:51:32.12,0:51:34.49,Default,,0000,0000,0000,,📱
Dialogue: 0,0:51:32.12,0:51:34.49,Default,,0000,0000,0000,,Кешке Джин бізге қосылады.
Dialogue: 0,0:51:32.12,0:51:34.49,Default,,0000,0000,0000,,.
Dialogue: 0,0:51:34.49,0:51:36.99,Default,,0000,0000,0000,,Сіз сүңгуір қайыққа отырғыңыз келе ме?
Dialogue: 0,0:51:36.99,0:51:40.53,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:51:36.99,0:51:40.53,Default,,0000,0000,0000,,Өйткені есіктің арғы жағында жалаңаш қыз тұр.
Dialogue: 0,0:51:36.99,0:51:40.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:51:40.53,0:51:44.00,Default,,0000,0000,0000,,Ол бізге аспаннан қосылады
Dialogue: 0,0:51:40.53,0:51:44.00,Default,,0000,0000,0000,,Басқаша айтқанда
Dialogue: 0,0:51:40.53,0:51:44.00,Default,,0000,0000,0000,,Сол кезде
Dialogue: 0,0:51:40.53,0:51:44.00,Default,,0000,0000,0000,,.
Dialogue: 0,0:51:44.00,0:51:47.54,Default,,0000,0000,0000,,Сүңгуір қайықтың су бетіне шығудан басқа амалы жоқ.
Dialogue: 0,0:51:44.00,0:51:47.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:51:47.54,0:51:49.01,Default,,0000,0000,0000,,📱
Dialogue: 0,0:51:47.54,0:51:49.01,Default,,0000,0000,0000,,О
Dialogue: 0,0:51:47.54,0:51:49.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:51:49.01,0:51:51.01,Default,,0000,0000,0000,,(
Dialogue: 0,0:51:49.01,0:51:51.01,Default,,0000,0000,0000,,Когоро
Dialogue: 0,0:51:49.01,0:51:51.01,Default,,0000,0000,0000,,)
Dialogue: 0,0:51:49.01,0:51:51.01,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:51:49.01,0:51:51.01,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:51:52.61,0:51:55.58,Default,,0000,0000,0000,,(
Dialogue: 0,0:51:52.61,0:51:55.58,Default,,0000,0000,0000,,Амуро
Dialogue: 0,0:51:52.61,0:51:55.58,Default,,0000,0000,0000,,)
Dialogue: 0,0:51:52.61,0:51:55.58,Default,,0000,0000,0000,,｟Егер сіз оған көмектессеңіз
Dialogue: 0,0:51:52.61,0:51:55.58,Default,,0000,0000,0000,,Бұл жалғыз орын｠
Dialogue: 0,0:51:58.08,0:52:00.98,Default,,0000,0000,0000,,(
Dialogue: 0,0:51:58.08,0:52:00.98,Default,,0000,0000,0000,,Курода
Dialogue: 0,0:51:58.08,0:52:00.98,Default,,0000,0000,0000,,)
Dialogue: 0,0:51:58.08,0:52:00.98,Default,,0000,0000,0000,,Мен растауыңызды қалаймын.
Dialogue: 0,0:51:58.08,0:52:00.98,Default,,0000,0000,0000,,.
Dialogue: 0,0:52:00.98,0:52:03.99,Default,,0000,0000,0000,,Маяктың қауіпсіздік камерасы
Dialogue: 0,0:52:00.98,0:52:03.99,Default,,0000,0000,0000,,Мен оны қарап шықтым➡
Dialogue: 0,0:52:03.99,0:52:08.02,Default,,0000,0000,0000,,Сүңгуір қайық көрсетілмеген
Dialogue: 0,0:52:03.99,0:52:08.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:52:08.02,0:52:10.99,Default,,0000,0000,0000,,А...
Dialogue: 0,0:52:08.02,0:52:10.99,Default,,0000,0000,0000,,Түн болғаны бұл дегенді білдірмейді
Dialogue: 0,0:52:08.02,0:52:10.99,Default,,0000,0000,0000,,Жоқ, солай ма?
Dialogue: 0,0:52:10.99,0:52:13.50,Default,,0000,0000,0000,,Ажыратымдылығы жоғары полиция камерасы.
Dialogue: 0,0:52:10.99,0:52:13.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:52:13.50,0:52:18.54,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:52:13.50,0:52:18.54,Default,,0000,0000,0000,,Осы жігіттің арқасында
Dialogue: 0,0:52:13.50,0:52:18.54,Default,,0000,0000,0000,,Мен сізге қажетсіз қиындық тудырдым.
Dialogue: 0,0:52:13.50,0:52:18.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:52:18.54,0:52:21.10,Default,,0000,0000,0000,,Осы жүйеге қосылған
Dialogue: 0,0:52:18.54,0:52:21.10,Default,,0000,0000,0000,,Камера дегеніміз не➡
Dialogue: 0,0:52:21.10,0:52:24.01,Default,,0000,0000,0000,,Полиция бақылауындағы заттар
Бұл тек
Dialogue: 0,0:52:21.10,0:52:24.01,Default,,0000,0000,0000,,болды, солай ма?
Dialogue: 0,0:52:24.01,0:52:26.98,Default,,0000,0000,0000,,Иә, бірақ
Dialogue: 0,0:52:24.01,0:52:26.98,Default,,0000,0000,0000,,.
Dialogue: 0,0:52:24.01,0:52:26.98,Default,,0000,0000,0000,,Қарсы боласыз ба?
Dialogue: 0,0:52:29.01,0:52:31.01,Default,,0000,0000,0000,,Бұл қылмыскер қашып кеткен жол.
Dialogue: 0,0:52:29.01,0:52:31.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:52:31.01,0:52:32.52,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:52:32.52,0:52:34.48,Default,,0000,0000,0000,,Осы жолда
Dialogue: 0,0:52:32.52,0:52:34.48,Default,,0000,0000,0000,,Полиция камераларын тексеріңіз!
Dialogue: 0,0:52:34.48,0:52:36.02,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:52:34.48,0:52:36.02,Default,,0000,0000,0000,,Қандай да бір себеппен...
Dialogue: 0,0:52:34.48,0:52:36.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:52:36.02,0:52:38.99,Default,,0000,0000,0000,,Кеше түнгі сағат 11 шамасында болды.
Dialogue: 0,0:52:36.02,0:52:38.99,Default,,0000,0000,0000,,.
Dialogue: 0,0:52:40.56,0:52:43.59,Default,,0000,0000,0000,,Леонхардт
Dialogue: 0,0:52:40.56,0:52:43.59,Default,,0000,0000,0000,,Бұл A-6 камерасы.
Dialogue: 0,0:52:40.56,0:52:43.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:52:43.59,0:52:46.03,Default,,0000,0000,0000,,Бұл жолы баланың айтқанын орындайсың ба?
Dialogue: 0,0:52:43.59,0:52:46.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:52:46.03,0:52:49.00,Default,,0000,0000,0000,,(
Dialogue: 0,0:52:46.03,0:52:49.00,Default,,0000,0000,0000,,Пернетақтаны соғу дыбысы
Dialogue: 0,0:52:46.03,0:52:49.00,Default,,0000,0000,0000,,)
Dialogue: 0,0:52:51.00,0:52:53.00,Default,,0000,0000,0000,,(
Dialogue: 0,0:52:51.00,0:52:53.00,Default,,0000,0000,0000,,Макино
Dialogue: 0,0:52:51.00,0:52:53.00,Default,,0000,0000,0000,,)
Dialogue: 0,0:52:51.00,0:52:53.00,Default,,0000,0000,0000,,Бұл камера.
Dialogue: 0,0:52:51.00,0:52:53.00,Default,,0000,0000,0000,,.
Dialogue: 0,0:52:56.01,0:52:59.51,Default,,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,0:52:56.01,0:52:59.51,Default,,0000,0000,0000,,Суретте қылмыскердің көлігі көрінбейді.
Dialogue: 0,0:52:56.01,0:52:59.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:52:59.51,0:53:02.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:52:59.51,0:53:02.05,Default,,0000,0000,0000,,Мегур
Dialogue: 0,0:52:59.51,0:53:02.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:52:59.51,0:53:02.05,Default,,0000,0000,0000,,Агаса-санның көлігі де жоқ.
Dialogue: 0,0:52:59.51,0:53:02.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:53:02.05,0:53:04.11,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:53:04.11,0:53:06.52,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:53:04.11,0:53:06.52,Default,,0000,0000,0000,,Қайта жазылды ма?
Dialogue: 0,0:53:06.52,0:53:08.49,Default,,0000,0000,0000,,《Күмән жоқ》
Dialogue: 0,0:53:12.99,0:53:16.49,Default,,0000,0000,0000,,(
Dialogue: 0,0:53:12.99,0:53:16.49,Default,,0000,0000,0000,,Наоми
Dialogue: 0,0:53:12.99,0:53:16.49,Default,,0000,0000,0000,,)
Dialogue: 0,0:53:12.99,0:53:16.49,Default,,0000,0000,0000,,Жер
Dialogue: 0,0:53:12.99,0:53:16.49,Default,,0000,0000,0000,,Не керек, Крюгер мырза?
Dialogue: 0,0:53:12.99,0:53:16.49,Default,,0000,0000,0000,,Шихоның қызы?
Dialogue: 0,0:53:16.49,0:53:20.50,Default,,0000,0000,0000,,Мияно
Dialogue: 0,0:53:16.49,0:53:20.50,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:53:16.49,0:53:20.50,Default,,0000,0000,0000,,Шихо Мияно ше?
Dialogue: 0,0:53:16.49,0:53:20.50,Default,,0000,0000,0000,,Сіз білмеймін дедіңіз, солай ма?
Dialogue: 0,0:53:20.50,0:53:22.53,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:53:20.50,0:53:22.53,Default,,0000,0000,0000,,Сабыр сақта.
Dialogue: 0,0:53:20.50,0:53:22.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:53:22.53,0:53:26.10,Default,,0000,0000,0000,,Шихоға
Dialogue: 0,0:53:22.53,0:53:26.10,Default,,0000,0000,0000,,Сондай үлкен бала
Dialogue: 0,0:53:22.53,0:53:26.10,Default,,0000,0000,0000,,Біреуі болуы мүмкін емес.
Dialogue: 0,0:53:22.53,0:53:26.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:53:26.10,0:53:30.97,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:53:26.10,0:53:30.97,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:53:26.10,0:53:30.97,Default,,0000,0000,0000,,Ол дәл мен кездескендегідей.
Dialogue: 0,0:53:26.10,0:53:30.97,Default,,0000,0000,0000,,.
Dialogue: 0,0:53:30.97,0:53:34.01,Default,,0000,0000,0000,,Сіз кездестірдіңіз бе?
Dialogue: 0,0:53:30.97,0:53:34.01,Default,,0000,0000,0000,,Қайда?
Dialogue: 0,0:53:34.01,0:53:39.02,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:53:34.01,0:53:39.02,Default,,0000,0000,0000,,Кішкентай кезімде
Dialogue: 0,0:53:34.01,0:53:39.02,Default,,0000,0000,0000,,Мен Америкада болдым.
Dialogue: 0,0:53:34.01,0:53:39.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:53:39.02,0:53:44.49,Default,,0000,0000,0000,,Шығыс адамдары сирек болғандықтан ба?
Dialogue: 0,0:53:39.02,0:53:44.49,Default,,0000,0000,0000,,Күн сайын
Dialogue: 0,0:53:39.02,0:53:44.49,Default,,0000,0000,0000,,Қорқыту
Dialogue: 0,0:53:39.02,0:53:44.49,Default,,0000,0000,0000,,.
Dialogue: 0,0:53:48.12,0:53:51.13,Default,,0000,0000,0000,,｟Хахаха…｠
Dialogue: 0,0:53:51.13,0:53:53.63,Default,,0000,0000,0000,,｟Ах
Dialogue: 0,0:53:51.13,0:53:53.63,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:53:55.30,0:53:59.04,Default,,0000,0000,0000,,｟Хахаха…｠
Dialogue: 0,0:53:55.30,0:53:59.04,Default,,0000,0000,0000,,｟Хихехи…｠
Dialogue: 0,0:53:59.04,0:54:02.61,Default,,0000,0000,0000,,(
Dialogue: 0,0:53:59.04,0:54:02.61,Default,,0000,0000,0000,,Наомидің дауысы
Dialogue: 0,0:53:59.04,0:54:02.61,Default,,0000,0000,0000,,)
Dialogue: 0,0:53:59.04,0:54:02.61,Default,,0000,0000,0000,,Осындай кездері
Dialogue: 0,0:53:59.04,0:54:02.61,Default,,0000,0000,0000,,Мені қорғаған...
Dialogue: 0,0:53:59.04,0:54:02.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:54:02.61,0:54:04.01,Default,,0000,0000,0000,,｟Ах｠
Dialogue: 0,0:54:04.01,0:54:07.11,Default,,0000,0000,0000,,(
Dialogue: 0,0:54:04.01,0:54:07.11,Default,,0000,0000,0000,,Наомидің дауысы
Dialogue: 0,0:54:04.01,0:54:07.11,Default,,0000,0000,0000,,)
Dialogue: 0,0:54:04.01,0:54:07.11,Default,,0000,0000,0000,,Бұл Жапониядан келген Шихо болатын.
Dialogue: 0,0:54:04.01,0:54:07.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:54:07.11,0:54:09.08,Default,,0000,0000,0000,,｟осында
Dialogue: 0,0:54:07.11,0:54:09.08,Default,,0000,0000,0000,,Отыр｠
Dialogue: 0,0:54:12.52,0:54:16.09,Default,,0000,0000,0000,,(
Dialogue: 0,0:54:12.52,0:54:16.09,Default,,0000,0000,0000,,Наомидің дауысы
Dialogue: 0,0:54:12.52,0:54:16.09,Default,,0000,0000,0000,,)
Dialogue: 0,0:54:12.52,0:54:16.09,Default,,0000,0000,0000,,Сол күннен бастап
Dialogue: 0,0:54:12.52,0:54:16.09,Default,,0000,0000,0000,,Қорқыту мақсаты➡
Dialogue: 0,0:54:16.09,0:54:18.56,Default,,0000,0000,0000,,Мен қызға айналдым...
Dialogue: 0,0:54:16.09,0:54:18.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:54:20.52,0:54:24.49,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:54:20.52,0:54:24.49,Default,,0000,0000,0000,,(Қол Перісі) Құтқарып болмайды… Соңғы көргенім – демон өлтірушінің жүзі болар деп кім ойлаған…
Dialogue: 0,0:54:20.52,0:54:24.49,Default,,0000,0000,0000,,.
Dialogue: 0,0:54:24.49,0:54:27.50,Default,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:54:24.49,0:54:27.50,Default,,0000,0000,0000,,Мен қорқытудан қорқамын
Dialogue: 0,0:54:24.49,0:54:27.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:54:29.03,0:54:31.00,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:54:29.03,0:54:31.00,Default,,0000,0000,0000,,Нәсіл бойынша➡
Dialogue: 0,0:54:31.00,0:54:34.50,Default,,0000,0000,0000,,Біз бір-бірімізді жек көрмейміз
Dialogue: 0,0:54:31.00,0:54:34.50,Default,,0000,0000,0000,,Мен әлемге не істегім келеді...
Dialogue: 0,0:54:31.00,0:54:34.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:54:34.50,0:54:36.57,Default,,0000,0000,0000,,Сіз білмейсіз бе?
Dialogue: 0,0:54:36.57,0:54:39.61,Default,,0000,0000,0000,,Сондықтан сіз ескі-жас сертификатын жасадыңыз ба?
Dialogue: 0,0:54:39.61,0:54:43.51,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:54:39.61,0:54:43.51,Default,,0000,0000,0000,,Антропология және АИ
Dialogue: 0,0:54:39.61,0:54:43.51,Default,,0000,0000,0000,,Оқу барысында➡
Dialogue: 0,0:54:43.51,0:54:46.98,Default,,0000,0000,0000,,Нәсілі мен жасына қарамастан
Dialogue: 0,0:54:43.51,0:54:46.98,Default,,0000,0000,0000,,Сертификаттауға болатын бағдарламалар➡
Dialogue: 0,0:54:46.98,0:54:49.02,Default,,0000,0000,0000,,Менің ойыма бір ой келді.
Dialogue: 0,0:54:46.98,0:54:49.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:54:49.02,0:54:52.49,Default,,0000,0000,0000,,Содан кейін Интерполдан
Dialogue: 0,0:54:49.02,0:54:52.49,Default,,0000,0000,0000,,Мен дауыс естідім➡
Dialogue: 0,0:54:52.49,0:54:54.99,Default,,0000,0000,0000,,Жас және кәрі аутентификацияны тексеру үшін➡
Dialogue: 0,0:54:54.99,0:54:59.03,Default,,0000,0000,0000,,Жапондық қауіпсіздік камералары
Dialogue: 0,0:54:54.99,0:54:59.03,Default,,0000,0000,0000,,Сіз кіруге рұқсат алдыңыз ба?
Dialogue: 0,0:54:54.99,0:54:59.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:54:59.03,0:55:02.60,Default,,0000,0000,0000,,Сол кезде
Dialogue: 0,0:54:59.03,0:55:02.60,Default,,0000,0000,0000,,Ең бірінші ойға келгені➡ болды
Dialogue: 0,0:55:02.60,0:55:04.50,Default,,0000,0000,0000,,Бұл Шихо болатын
Dialogue: 0,0:55:02.60,0:55:04.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:55:04.50,0:55:07.00,Default,,0000,0000,0000,,Шихоға
Dialogue: 0,0:55:04.50,0:55:07.00,Default,,0000,0000,0000,,Мен сенімен тағы кездескім келді
Dialogue: 0,0:55:04.50,0:55:07.00,Default,,0000,0000,0000,,.
Dialogue: 0,0:55:07.00,0:55:11.51,Default,,0000,0000,0000,,<Эрен басынан бері мүлде өзгерген жоқ. ➡
Dialogue: 0,0:55:07.00,0:55:11.51,Default,,0000,0000,0000,,Мен әрқашан кешірім сұрағым келді
Dialogue: 0,0:55:07.00,0:55:11.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:55:13.18,0:55:15.15,Default,,0000,0000,0000,,📺｟Анықтау дыбысы｠
Dialogue: 0,0:55:13.18,0:55:15.15,Default,,0000,0000,0000,,｟Ха｠
Dialogue: 0,0:55:18.11,0:55:21.15,Default,,0000,0000,0000,,｟Хаха
Dialogue: 0,0:55:18.11,0:55:21.15,Default,,0000,0000,0000,,Хахаха...! ｠
Dialogue: 0,0:55:21.15,0:55:24.52,Default,,0000,0000,0000,,📺｟Анықтау дыбысы｠
Dialogue: 0,0:55:24.52,0:55:29.99,Default,,0000,0000,0000,,(
Dialogue: 0,0:55:24.52,0:55:29.99,Default,,0000,0000,0000,,Наомидің дауысы
Dialogue: 0,0:55:24.52,0:55:29.99,Default,,0000,0000,0000,,)
Dialogue: 0,0:55:24.52,0:55:29.99,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:55:24.52,0:55:29.99,Default,,0000,0000,0000,,Аударма: Xianyu Experience Blackfeather | Авторлары: Xiao Wu, Cuo Nan | Тексерген: Kuma Star's Wayward Sheep
Dialogue: 0,0:55:24.52,0:55:29.99,Default,,0000,0000,0000,,Оны да басыңыз
Dialogue: 0,0:55:24.52,0:55:29.99,Default,,0000,0000,0000,,.
Dialogue: 0,0:55:29.99,0:55:35.50,Default,,0000,0000,0000,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:55:29.99,0:55:35.50,Default,,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,0:55:29.99,0:55:35.50,Default,,0000,0000,0000,,Мен әлі түсінбеймін.
Dialogue: 0,0:55:29.99,0:55:35.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:55:35.50,0:55:40.07,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:55:35.50,0:55:40.07,Default,,0000,0000,0000,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:55:35.50,0:55:40.07,Default,,0000,0000,0000,,Мен үшін
Dialogue: 0,0:55:35.50,0:55:40.07,Default,,0000,0000,0000,,Менің ойымша, мен соған түсіп қалдым.
Dialogue: 0,0:55:35.50,0:55:40.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:55:40.07,0:55:44.04,Default,,0000,0000,0000,,《Жоқ
Dialogue: 0,0:55:40.07,0:55:44.04,Default,,0000,0000,0000,,Не қатысты болды?
Dialogue: 0,0:55:40.07,0:55:44.04,Default,,0000,0000,0000,,Менің жағым》
Dialogue: 0,0:55:48.51,0:55:51.51,Default,,0000,0000,0000,,📱
Dialogue: 0,0:55:48.51,0:55:51.51,Default,,0000,0000,0000,,(
Dialogue: 0,0:55:48.51,0:55:51.51,Default,,0000,0000,0000,,Діріл дыбысы
Dialogue: 0,0:55:48.51,0:55:51.51,Default,,0000,0000,0000,,)
Dialogue: 0,0:55:52.55,0:55:54.02,Default,,0000,0000,0000,,📱
Dialogue: 0,0:55:52.55,0:55:54.02,Default,,0000,0000,0000,,(
Dialogue: 0,0:55:52.55,0:55:54.02,Default,,0000,0000,0000,,Операция дыбыстары
Dialogue: 0,0:55:52.55,0:55:54.02,Default,,0000,0000,0000,,)
Dialogue: 0,0:55:55.52,0:55:59.56,Default,,0000,0000,0000,,《Хехе!
Dialogue: 0,0:55:55.52,0:55:59.56,Default,,0000,0000,0000,,Мен сен айттым деп ойладым》
Dialogue: 0,0:55:59.56,0:56:02.53,Default,,0000,0000,0000,,📱
Dialogue: 0,0:55:59.56,0:56:02.53,Default,,0000,0000,0000,,(
Dialogue: 0,0:55:59.56,0:56:02.53,Default,,0000,0000,0000,,Операция дыбыстары
Dialogue: 0,0:55:59.56,0:56:02.53,Default,,0000,0000,0000,,)
Dialogue: 0,0:56:14.04,0:56:16.01,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:56:14.04,0:56:16.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:56:16.01,0:56:19.51,Default,,0000,0000,0000,,(
Dialogue: 0,0:56:16.01,0:56:19.51,Default,,0000,0000,0000,,Жылау
Dialogue: 0,0:56:16.01,0:56:19.51,Default,,0000,0000,0000,,)
Dialogue: 0,0:56:16.01,0:56:19.51,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:56:16.01,0:56:19.51,Default,,0000,0000,0000,,Маған кедергі жасама
Dialogue: 0,0:56:16.01,0:56:19.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:56:29.55,0:56:32.09,Default,,0000,0000,0000,,Яғни
Dialogue: 0,0:56:29.55,0:56:32.09,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:56:32.09,0:56:34.59,Default,,0000,0000,0000,,Егер сіз бірдеңе айтсаңыз
Dialogue: 0,0:56:32.09,0:56:34.59,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:56:36.03,0:56:40.03,Default,,0000,0000,0000,,Бұл журнал
Dialogue: 0,0:56:36.03,0:56:40.03,Default,,0000,0000,0000,,Юбе
Dialogue: 0,0:56:36.03,0:56:40.03,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:56:36.03,0:56:40.03,Default,,0000,0000,0000,,Мен негізгі бөлмеде болған кезде...
Dialogue: 0,0:56:36.03,0:56:40.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:56:40.03,0:56:43.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:56:40.03,0:56:43.03,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:56:40.03,0:56:43.03,Default,,0000,0000,0000,,Алып тасташы, өтінемін...?
Dialogue: 0,0:56:40.03,0:56:43.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:56:43.03,0:56:44.53,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:56:43.03,0:56:44.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:56:44.53,0:56:46.54,Default,,0000,0000,0000,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,0:56:46.54,0:57:03.52,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:57:03.52,0:57:06.52,Default,,0000,0000,0000,,(
Dialogue: 0,0:57:03.52,0:57:06.52,Default,,0000,0000,0000,,Соноко
Dialogue: 0,0:57:03.52,0:57:06.52,Default,,0000,0000,0000,,)
Dialogue: 0,0:57:03.52,0:57:06.52,Default,,0000,0000,0000,,Орхидеялар шынымен өмір сүре ме?
Dialogue: 0,0:57:06.52,0:57:10.03,Default,,0000,0000,0000,,Мен Ай Чан үшін уайымдап жүрмін...
Dialogue: 0,0:57:06.52,0:57:10.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:57:06.52,0:57:10.03,Default,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:57:06.52,0:57:10.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:57:10.03,0:57:13.53,Default,,0000,0000,0000,,О, түсіндім. Ол жер жергілікті көрікті жерге айналған екен, иә?
Dialogue: 0,0:57:10.03,0:57:13.53,Default,,0000,0000,0000,,Дәрігер де қалады.
Dialogue: 0,0:57:10.03,0:57:13.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:57:13.53,0:57:16.53,Default,,0000,0000,0000,,Кешіріңіз, бірақ маған балалар керек.
Dialogue: 0,0:57:13.53,0:57:16.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:57:16.53,0:57:23.07,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:57:16.53,0:57:23.07,Default,,0000,0000,0000,,Сен сол бәйбішелерге қалай қарайсың?
Dialogue: 0,0:57:16.53,0:57:23.07,Default,,0000,0000,0000,,Маған қалдырыңыз
Dialogue: 0,0:57:16.53,0:57:23.07,Default,,0000,0000,0000,,Мен үйреніп қалдым.
Dialogue: 0,0:57:16.53,0:57:23.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:57:23.07,0:57:25.61,Default,,0000,0000,0000,,Соноко
Dialogue: 0,0:57:23.07,0:57:25.61,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:57:23.07,0:57:25.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:57:25.61,0:57:27.51,Default,,0000,0000,0000,,(
Dialogue: 0,0:57:25.61,0:57:27.51,Default,,0000,0000,0000,,Аюми
Dialogue: 0,0:57:25.61,0:57:27.51,Default,,0000,0000,0000,,)
Dialogue: 0,0:57:25.61,0:57:27.51,Default,,0000,0000,0000,,Сау болыңыз!
Dialogue: 0,0:57:25.61,0:57:27.51,Default,,0000,0000,0000,,(
Dialogue: 0,0:57:25.61,0:57:27.51,Default,,0000,0000,0000,,Гента
Dialogue: 0,0:57:25.61,0:57:27.51,Default,,0000,0000,0000,,)
Dialogue: 0,0:57:25.61,0:57:27.51,Default,,0000,0000,0000,,Мен... Мен ондай жігіттерді шын жек көремін!
Dialogue: 0,0:57:27.51,0:57:30.01,Default,,0000,0000,0000,,Сувенирлер
Dialogue: 0,0:57:27.51,0:57:30.01,Default,,0000,0000,0000,,Көп сатып алыңыз!
Dialogue: 0,0:57:30.01,0:57:32.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:57:30.01,0:57:32.05,Default,,0000,0000,0000,,Аюми
Dialogue: 0,0:57:30.01,0:57:32.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:57:30.01,0:57:32.05,Default,,0000,0000,0000,,Сау болыңыз!
Dialogue: 0,0:57:30.01,0:57:32.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:57:30.01,0:57:32.05,Default,,0000,0000,0000,,Гента
Dialogue: 0,0:57:30.01,0:57:32.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:57:30.01,0:57:32.05,Default,,0000,0000,0000,,Мүлдем!
Dialogue: 0,0:57:32.05,0:57:35.52,Default,,0000,0000,0000,,(
Dialogue: 0,0:57:32.05,0:57:35.52,Default,,0000,0000,0000,,Соноко
Dialogue: 0,0:57:32.05,0:57:35.52,Default,,0000,0000,0000,,)
Dialogue: 0,0:57:32.05,0:57:35.52,Default,,0000,0000,0000,,Мориёх қандай әдемі қала.
Dialogue: 0,0:57:32.05,0:57:35.52,Default,,0000,0000,0000,,Бұл қауіпті!
Dialogue: 0,0:57:32.05,0:57:35.52,Default,,0000,0000,0000,,(
Dialogue: 0,0:57:32.05,0:57:35.52,Default,,0000,0000,0000,,Аюми
Dialogue: 0,0:57:32.05,0:57:35.52,Default,,0000,0000,0000,,)
Dialogue: 0,0:57:32.05,0:57:35.52,Default,,0000,0000,0000,,Ах~
Dialogue: 0,0:57:32.05,0:57:35.52,Default,,0000,0000,0000,,Гента-кун!
Dialogue: 0,0:57:37.02,0:57:40.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:57:37.02,0:57:40.02,Default,,0000,0000,0000,,Біраз
Dialogue: 0,0:57:37.02,0:57:40.02,Default,,0000,0000,0000,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:57:37.02,0:57:40.02,Default,,0000,0000,0000,,Мынаны қараңыз!
Dialogue: 0,0:57:40.02,0:57:41.99,Default,,0000,0000,0000,,Бұл Леонхардттан!
Dialogue: 0,0:57:45.53,0:57:49.10,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:57:45.53,0:57:49.10,Default,,0000,0000,0000,,Неге...
Dialogue: 0,0:57:45.53,0:57:49.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:57:45.53,0:57:49.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:57:45.53,0:57:49.10,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:57:45.53,0:57:49.10,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:57:49.10,0:57:52.00,Default,,0000,0000,0000,,Наомиді ұрлап кеткен қылмыскер
Dialogue: 0,0:57:49.10,0:57:52.00,Default,,0000,0000,0000,,Нұсқаулық үшін➡
Dialogue: 0,0:57:52.00,0:57:54.50,Default,,0000,0000,0000,,Жүйеге
Dialogue: 0,0:57:52.00,0:57:54.50,Default,,0000,0000,0000,,Тіпті егер сіз бэк есік орнатсаңыз да
Dialogue: 0,0:57:52.00,0:57:54.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:57:54.50,0:57:57.01,Default,,0000,0000,0000,,(
Dialogue: 0,0:57:54.50,0:57:57.01,Default,,0000,0000,0000,,Макино
Dialogue: 0,0:57:54.50,0:57:57.01,Default,,0000,0000,0000,,)
Dialogue: 0,0:57:54.50,0:57:57.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:57:54.50,0:57:57.01,Default,,0000,0000,0000,,(
Dialogue: 0,0:57:54.50,0:57:57.01,Default,,0000,0000,0000,,Когоро
Dialogue: 0,0:57:54.50,0:57:57.01,Default,,0000,0000,0000,,)
Dialogue: 0,0:57:54.50,0:57:57.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:57:54.50,0:57:57.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:57:57.01,0:57:59.01,Default,,0000,0000,0000,,Ұрлауды жасаған адам ше?
Dialogue: 0,0:57:59.01,0:58:02.51,Default,,0000,0000,0000,,Ол ақшаға жұмысқа алынғандықтан белгісіз сияқты.
Dialogue: 0,0:57:59.01,0:58:02.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:58:02.51,0:58:06.02,Default,,0000,0000,0000,,Леонхардты тапты
Dialogue: 0,0:58:02.51,0:58:06.02,Default,,0000,0000,0000,,Мен кафедемін
Dialogue: 0,0:58:02.51,0:58:06.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:58:11.12,0:58:13.52,Default,,0000,0000,0000,,(
Dialogue: 0,0:58:11.12,0:58:13.52,Default,,0000,0000,0000,,Мегур
Dialogue: 0,0:58:11.12,0:58:13.52,Default,,0000,0000,0000,,)
Dialogue: 0,0:58:11.12,0:58:13.52,Default,,0000,0000,0000,,Бұл дәрі ме?
Dialogue: 0,0:58:13.52,0:58:15.49,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:58:19.00,0:58:21.50,Default,,0000,0000,0000,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:58:19.00,0:58:21.50,Default,,0000,0000,0000,,Солай сияқты.
Dialogue: 0,0:58:19.00,0:58:21.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:58:21.50,0:58:23.50,Default,,0000,0000,0000,,Біртүрлі.
Dialogue: 0,0:58:21.50,0:58:23.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:58:23.50,0:58:26.00,Default,,0000,0000,0000,,(
Dialogue: 0,0:58:23.50,0:58:26.00,Default,,0000,0000,0000,,Ред
Dialogue: 0,0:58:23.50,0:58:26.00,Default,,0000,0000,0000,,)
Dialogue: 0,0:58:23.50,0:58:26.00,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:58:23.50,0:58:26.00,Default,,0000,0000,0000,,италиялықтарға тән —
Dialogue: 0,0:58:23.50,0:58:26.00,Default,,0000,0000,0000,,Эй, эй!
Dialogue: 0,0:58:26.00,0:58:28.54,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:58:26.00,0:58:28.54,Default,,0000,0000,0000,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:58:28.54,0:58:31.94,Default,,0000,0000,0000,,Леонхард!
Dialogue: 0,0:58:28.54,0:58:31.94,Default,,0000,0000,0000,,Басқа камера!
Dialogue: 0,0:58:28.54,0:58:31.94,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,0:58:36.51,0:58:38.51,Default,,0000,0000,0000,,《Не⁉》
Dialogue: 0,0:58:38.51,0:58:42.52,Default,,0000,0000,0000,,(
Dialogue: 0,0:58:38.51,0:58:42.52,Default,,0000,0000,0000,,Қызметкерлер
Dialogue: 0,0:58:38.51,0:58:42.52,Default,,0000,0000,0000,,)
Dialogue: 0,0:58:38.51,0:58:42.52,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:58:38.51,0:58:42.52,Default,,0000,0000,0000,,Леонхардт?
Dialogue: 0,0:58:38.51,0:58:42.52,Default,,0000,0000,0000,,(
Dialogue: 0,0:58:38.51,0:58:42.52,Default,,0000,0000,0000,,Қызметкерлер
Dialogue: 0,0:58:38.51,0:58:42.52,Default,,0000,0000,0000,,)
Dialogue: 0,0:58:38.51,0:58:42.52,Default,,0000,0000,0000,,Өтірік…
Dialogue: 0,0:58:38.51,0:58:42.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:58:42.52,0:58:47.02,Default,,0000,0000,0000,,Қызметкер кімді бақылап тұрды?
Dialogue: 0,0:58:42.52,0:58:47.02,Default,,0000,0000,0000,,Сіз сондасыз ба?
Dialogue: 0,0:58:42.52,0:58:47.02,Default,,0000,0000,0000,,Бұл әдеттегі тазалау уақыты болатын.
Dialogue: 0,0:58:42.52,0:58:47.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:58:47.02,0:58:50.99,Default,,0000,0000,0000,,А...
Dialogue: 0,0:58:47.02,0:58:50.99,Default,,0000,0000,0000,,Ойланып көрейікші
Dialogue: 0,0:58:47.02,0:58:50.99,Default,,0000,0000,0000,,Солай болды ма?
Dialogue: 0,0:58:47.02,0:58:50.99,Default,,0000,0000,0000,,.
Dialogue: 0,0:58:54.60,0:58:59.00,Default,,0000,0000,0000,,(
Dialogue: 0,0:58:54.60,0:58:59.00,Default,,0000,0000,0000,,Сато
Dialogue: 0,0:58:54.60,0:58:59.00,Default,,0000,0000,0000,,)
Dialogue: 0,0:58:54.60,0:58:59.00,Default,,0000,0000,0000,,Ауыз айналасы
Dialogue: 0,0:58:54.60,0:58:59.00,Default,,0000,0000,0000,,Ауырсыну
Dialogue: 0,0:58:54.60,0:58:59.00,Default,,0000,0000,0000,,Бұл улы ма?
Dialogue: 0,0:58:59.00,0:59:01.04,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:58:59.00,0:59:01.04,Default,,0000,0000,0000,,Бұл иіс...
Dialogue: 0,0:58:59.00,0:59:01.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:59:01.04,0:59:03.01,Default,,0000,0000,0000,,Бұл кофенің иісі.
Dialogue: 0,0:59:01.04,0:59:03.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:59:03.01,0:59:06.51,Default,,0000,0000,0000,,Мен де солай істеймін.
Dialogue: 0,0:59:03.01,0:59:06.51,Default,,0000,0000,0000,,Жай ғана
Dialogue: 0,0:59:03.01,0:59:06.51,Default,,0000,0000,0000,,Бояу еріткіштің иісі емес пе?
Dialogue: 0,0:59:06.51,0:59:08.01,Default,,0000,0000,0000,,(
Dialogue: 0,0:59:06.51,0:59:08.01,Default,,0000,0000,0000,,Когоро
Dialogue: 0,0:59:06.51,0:59:08.01,Default,,0000,0000,0000,,)
Dialogue: 0,0:59:06.51,0:59:08.01,Default,,0000,0000,0000,,Менің атым Джоэстар. Өмірімді сақтап қалғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,0:59:06.51,0:59:08.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:59:08.01,0:59:10.01,Default,,0000,0000,0000,,Мата
Dialogue: 0,0:59:08.01,0:59:10.01,Default,,0000,0000,0000,,Әрқашан
Dialogue: 0,0:59:08.01,0:59:10.01,Default,,0000,0000,0000,,Әрқашан➡
Dialogue: 0,0:59:10.01,0:59:12.52,Default,,0000,0000,0000,,Сахнаны шатастыруы мүмкін нәрселер
Dialogue: 0,0:59:10.01,0:59:12.52,Default,,0000,0000,0000,,Айтыңызшы!
Dialogue: 0,0:59:12.52,0:59:16.05,Default,,0000,0000,0000,,Қалай қарасаң да, улану арқылы өзін-өзі өлтіру!
Dialogue: 0,0:59:12.52,0:59:16.05,Default,,0000,0000,0000,,Жақсы, жақсы
Dialogue: 0,0:59:12.52,0:59:16.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:59:16.05,0:59:18.59,Default,,0000,0000,0000,,Бірақ бұл біртүрлі емес пе?
Dialogue: 0,0:59:16.05,0:59:18.59,Default,,0000,0000,0000,,Не⁉
Dialogue: 0,0:59:18.59,0:59:22.53,Default,,0000,0000,0000,,Леонхардт мырза
Dialogue: 0,0:59:18.59,0:59:22.53,Default,,0000,0000,0000,,Сіздің жеке бөлмеңіз бар, солай ма?
Dialogue: 0,0:59:22.53,0:59:25.03,Default,,0000,0000,0000,,Неге кафеде?
Dialogue: 0,0:59:22.53,0:59:25.03,Default,,0000,0000,0000,,Қызық, ол өлді ме?
Dialogue: 0,0:59:25.03,0:59:28.00,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:59:25.03,0:59:28.00,Default,,0000,0000,0000,,Әрине
Dialogue: 0,0:59:25.03,0:59:28.00,Default,,0000,0000,0000,,Сабыр сақта.
Dialogue: 0,0:59:25.03,0:59:28.00,Default,,0000,0000,0000,,.
Dialogue: 0,0:59:28.00,0:59:30.00,Default,,0000,0000,0000,,Бұл әлдеқашан шешілді, солай ма?
Dialogue: 0,0:59:28.00,0:59:30.00,Default,,0000,0000,0000,,.
Dialogue: 0,0:59:30.00,0:59:33.50,Default,,0000,0000,0000,,Өлім алдында
Dialogue: 0,0:59:30.00,0:59:33.50,Default,,0000,0000,0000,,Жақсы кофе
Dialogue: 0,0:59:30.00,0:59:33.50,Default,,0000,0000,0000,,Менің ішкім келді
Dialogue: 0,0:59:30.00,0:59:33.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:59:33.50,0:59:35.51,Default,,0000,0000,0000,,《Ей, эй...》
Dialogue: 0,0:59:35.51,0:59:38.54,Default,,0000,0000,0000,,(
Dialogue: 0,0:59:35.51,0:59:38.54,Default,,0000,0000,0000,,Курода
Dialogue: 0,0:59:35.51,0:59:38.54,Default,,0000,0000,0000,,)
Dialogue: 0,0:59:35.51,0:59:38.54,Default,,0000,0000,0000,,Мәйіт тікұшақпен жеткізілді.
Dialogue: 0,0:59:35.51,0:59:38.54,Default,,0000,0000,0000,,Аутопсияны талап ету
Dialogue: 0,0:59:35.51,0:59:38.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:59:38.54,0:59:41.68,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:59:38.54,0:59:41.68,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:59:38.54,0:59:41.68,Default,,0000,0000,0000,,Жапон полициясы ➡
Dialogue: 0,0:59:41.68,0:59:45.05,Default,,0000,0000,0000,,Суицидтің денесі
Dialogue: 0,0:59:41.68,0:59:45.05,Default,,0000,0000,0000,,Сот сараптамасы болуы керек емес пе?
Dialogue: 0,0:59:45.05,0:59:48.02,Default,,0000,0000,0000,,Кез келген жағдайда
Dialogue: 0,0:59:45.05,0:59:48.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:59:51.02,0:59:54.52,Default,,0000,0000,0000,,Сізді неліктен ұрлап кеткенін білесіз бе?
Dialogue: 0,0:59:54.52,1:00:00.06,Default,,0000,0000,0000,,(
Dialogue: 0,0:59:54.52,1:00:00.06,Default,,0000,0000,0000,,Наоми
Dialogue: 0,0:59:54.52,1:00:00.06,Default,,0000,0000,0000,,)
Dialogue: 0,0:59:54.52,1:00:00.06,Default,,0000,0000,0000,,Жасты тексеру аяқталған кезде
Dialogue: 0,0:59:54.52,1:00:00.06,Default,,0000,0000,0000,,Маған біреу хабарласты.
Dialogue: 0,0:59:54.52,1:00:00.06,Default,,0000,0000,0000,,.
Dialogue: 0,1:00:00.06,1:00:02.60,Default,,0000,0000,0000,,Сіз кездестірдіңіз бе?
Dialogue: 0,1:00:02.60,1:00:06.54,Default,,0000,0000,0000,,Бұл электрондық пошта болғандықтан...
Dialogue: 0,1:00:02.60,1:00:06.54,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,1:00:02.60,1:00:06.54,Default,,0000,0000,0000,,Оның аты Пинга болатын.
Dialogue: 0,1:00:02.60,1:00:06.54,Default,,0000,0000,0000,,.
Dialogue: 0,1:00:06.54,1:00:08.04,Default,,0000,0000,0000,,Пинга
Dialogue: 0,1:00:06.54,1:00:08.04,Default,,0000,0000,0000,,.
Dialogue: 0,1:00:08.04,1:00:10.54,Default,,0000,0000,0000,,《Бразилиядан шыққан тазартылған ликер》
Dialogue: 0,1:00:10.54,1:00:12.54,Default,,0000,0000,0000,,Экспозиция
Dialogue: 0,1:00:10.54,1:00:12.54,Default,,0000,0000,0000,,Үлкен сыйлық ұсынылды➡
Dialogue: 0,1:00:12.54,1:00:17.05,Default,,0000,0000,0000,,Жүйені эксклюзивті пайдалану және жетілдіру
Dialogue: 0,1:00:12.54,1:00:17.05,Default,,0000,0000,0000,,Маған жақындады, бірақ мен бас тарттым.
Dialogue: 0,1:00:12.54,1:00:17.05,Default,,0000,0000,0000,,.
Dialogue: 0,1:00:17.05,1:00:19.02,Default,,0000,0000,0000,,Сол кезде
Dialogue: 0,1:00:17.05,1:00:19.02,Default,,0000,0000,0000,,Қазірдің өзінде➡
Dialogue: 0,1:00:19.02,1:00:23.09,Default,,0000,0000,0000,,Интерпол үшін пайдалану
Dialogue: 0,1:00:19.02,1:00:23.09,Default,,0000,0000,0000,,Өйткені мен бұл жүйе деп шештім.
Dialogue: 0,1:00:19.02,1:00:23.09,Default,,0000,0000,0000,,.
Dialogue: 0,1:00:23.09,1:00:28.02,Default,,0000,0000,0000,,Басқаша айтқанда
Dialogue: 0,1:00:23.09,1:00:28.02,Default,,0000,0000,0000,,Ескі және жас сертификаттау
Dialogue: 0,1:00:23.09,1:00:28.02,Default,,0000,0000,0000,,Барлығы осы
Dialogue: 0,1:00:23.09,1:00:28.02,Default,,0000,0000,0000,,олар үшін құнды
Dialogue: 0,1:00:23.09,1:00:28.02,Default,,0000,0000,0000,,.
Dialogue: 0,1:00:28.02,1:00:30.53,Default,,0000,0000,0000,,
Dialogue: 0,1:00:28.02,1:00:30.53,Default,,0000,0000,0000,,⚟Олар? ⚞
Dialogue: 0,1:00:28.02,1:00:30.53,Default,,0000,0000,0000,,Ха…
Dialogue: 0,1:00:28.02,1:00:30.53,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:00:30.53,1:00:35.03,Default,,0000,0000,0000,,Бұл
Dialogue: 0,1:00:30.53,1:00:35.03,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,1:00:30.53,1:00:35.03,Default,,0000,0000,0000,,Олар
Dialogue: 0,1:00:30.53,1:00:35.03,Default,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,1:00:30.53,1:00:35.03,Default,,0000,0000,0000,,қалай айтылады?
Dialogue: 0,1:00:30.53,1:00:35.03,Default,,0000,0000,0000,,Шынымен Шерриге ұқсайды
Dialogue: 0,1:00:30.53,1:00:35.03,Default,,0000,0000,0000,,.
Dialogue: 0,1:00:35.03,1:00:39.04,Default,,0000,0000,0000,,Ежелгі заманнан бері
Dialogue: 0,1:00:35.03,1:00:39.04,Default,,0000,0000,0000,,Титанның алдында сарбаздар бірінен соң бірі құлады.
Dialogue: 0,1:00:35.03,1:00:39.04,Default,,0000,0000,0000,,Себебі мен оған үйренбеген едім.
Dialogue: 0,1:00:35.03,1:00:39.04,Default,,0000,0000,0000,,.
Dialogue: 0,1:00:40.04,1:00:45.54,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,1:00:40.04,1:00:45.54,Default,,0000,0000,0000,,Біз үшін жүйе
Dialogue: 0,1:00:40.04,1:00:45.54,Default,,0000,0000,0000,,Сіз жақсартуды шештіңіз бе?
Dialogue: 0,1:00:46.61,1:00:50.15,Default,,0000,0000,0000,,
Dialogue: 0,1:00:46.61,1:00:50.15,Default,,0000,0000,0000,,Тексеру
Dialogue: 0,1:00:46.61,1:00:50.15,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,1:00:46.61,1:00:50.15,Default,,0000,0000,0000,,.
Dialogue: 0,1:00:46.61,1:00:50.15,Default,,0000,0000,0000,,♬~
Dialogue: 0,1:00:46.61,1:00:50.15,Default,,0000,0000,0000,,Ол – Лорд Широ.
Dialogue: 0,1:00:50.15,1:00:52.02,Default,,0000,0000,0000,,
Dialogue: 0,1:00:50.15,1:00:52.02,Default,,0000,0000,0000,,Өзі соққыны қабылдауға дайын қарсы шабуыл!
Dialogue: 0,1:00:50.15,1:00:52.02,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:00:52.02,1:00:54.52,Default,,0000,0000,0000,,Қою
Dialogue: 0,1:00:52.02,1:00:54.52,Default,,0000,0000,0000,,.
Dialogue: 0,1:00:52.02,1:00:54.52,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:00:52.02,1:00:54.52,Default,,0000,0000,0000,,Уф...
Dialogue: 0,1:00:52.02,1:00:54.52,Default,,0000,0000,0000,,.
Dialogue: 0,1:00:54.52,1:00:56.52,Default,,0000,0000,0000,,(keel)
Dialogue: 0,1:00:54.52,1:00:56.52,Default,,0000,0000,0000,,Vodka
Dialogue: 0,1:00:54.52,1:00:56.52,Default,,0000,0000,0000,,.
Dialogue: 0,1:00:56.52,1:00:59.52,Default,,0000,0000,0000,,(
Dialogue: 0,1:00:56.52,1:00:59.52,Default,,0000,0000,0000,,Сыбырда
Dialogue: 0,1:00:56.52,1:00:59.52,Default,,0000,0000,0000,,)
Dialogue: 0,1:00:56.52,1:00:59.52,Default,,0000,0000,0000,,Мен сенен құтылсам да
Dialogue: 0,1:00:56.52,1:00:59.52,Default,,0000,0000,0000,,.
Dialogue: 0,1:00:56.52,1:00:59.52,Default,,0000,0000,0000,,Не?
Dialogue: 0,1:00:59.52,1:01:03.03,Default,,0000,0000,0000,,🦻
Dialogue: 0,1:00:59.52,1:01:03.03,Default,,0000,0000,0000,,
Dialogue: 0,1:00:59.52,1:01:03.03,Default,,0000,0000,0000,,Пинга жігіті
Dialogue: 0,1:00:59.52,1:01:03.03,Default,,0000,0000,0000,,Acting unplanned
Dialogue: 0,1:00:59.52,1:01:03.03,Default,,0000,0000,0000,,.
