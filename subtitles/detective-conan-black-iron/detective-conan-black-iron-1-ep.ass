Dialogue: 0,0:04:45.59,0:04:48.09,Default,,0000,0000,0000,,Бұл өте қызықты!
Dialogue: 0,0:04:48.09,0:04:51.62,Default,,0000,0000,0000,,Хачидодзима
Dialogue: 0,0:04:48.09,0:04:51.62,Default,,0000,0000,0000,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:04:48.09,0:04:51.62,Default,,0000,0000,0000,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:04:48.09,0:04:51.62,Default,,0000,0000,0000,,Хачидодзима
Dialogue: 0,0:04:48.09,0:04:51.62,Default,,0000,0000,0000,,Киттерді көру туры➡
Dialogue: 0,0:04:51.62,0:04:53.16,Default,,0000,0000,0000,,Барғыңыз келеді, солай ма?
Dialogue: 0,0:04:53.16,0:04:56.10,Default,,0000,0000,0000,,(
Dialogue: 0,0:04:53.16,0:04:56.10,Default,,0000,0000,0000,,Мицухико
Dialogue: 0,0:04:53.16,0:04:56.10,Default,,0000,0000,0000,,)
Dialogue: 0,0:04:53.16,0:04:56.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:53.16,0:04:56.10,Default,,0000,0000,0000,,Неліктен бұл?
Dialogue: 0,0:04:53.16,0:04:56.10,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:04:53.16,0:04:56.10,Default,,0000,0000,0000,,Эспер?
Dialogue: 0,0:04:56.10,0:04:57.60,Default,,0000,0000,0000,,Хмф
Dialogue: 0,0:04:56.10,0:04:57.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:57.60,0:05:01.07,Default,,0000,0000,0000,,(
Dialogue: 0,0:04:57.60,0:05:01.07,Default,,0000,0000,0000,,Орхидея
Dialogue: 0,0:04:57.60,0:05:01.07,Default,,0000,0000,0000,,)
Dialogue: 0,0:04:57.60,0:05:01.07,Default,,0000,0000,0000,,Соноконың әкесінің қонақ үйі
Dialogue: 0,0:04:57.60,0:05:01.07,Default,,0000,0000,0000,,Ол Хачижодзимада.
Dialogue: 0,0:04:57.60,0:05:01.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:01.07,0:05:03.60,Default,,0000,0000,0000,,《Келеді деп ойладым.
Dialogue: 0,0:05:01.07,0:05:03.60,Default,,0000,0000,0000,,Бұл даму...》
Dialogue: 0,0:05:03.60,0:05:06.11,Default,,0000,0000,0000,,Жер
Dialogue: 0,0:05:03.60,0:05:06.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:03.60,0:05:06.11,Default,,0000,0000,0000,,Біз
Dialogue: 0,0:05:03.60,0:05:06.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:06.11,0:05:07.57,Default,,0000,0000,0000,,Мені өзіңізбен бірге алып кетесіз бе?
Dialogue: 0,0:05:07.57,0:05:12.11,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:05:07.57,0:05:12.11,Default,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:05:07.57,0:05:12.11,Default,,0000,0000,0000,,Бұл бала үшін сыйлық, солай ма?
Dialogue: 0,0:05:12.11,0:05:13.65,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:13.65,0:05:16.58,Default,,0000,0000,0000,,Біраз
Dialogue: 0,0:05:13.65,0:05:16.58,Default,,0000,0000,0000,,Егер сіз өмірден өткен бала болсаңыз
Dialogue: 0,0:05:13.65,0:05:16.58,Default,,0000,0000,0000,,Мен солай ойладым➡
Dialogue: 0,0:05:16.58,0:05:19.09,Default,,0000,0000,0000,,Бұл жұмсақ жер.
Dialogue: 0,0:05:16.58,0:05:19.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:21.62,0:05:25.12,Default,,0000,0000,0000,,🦻
Dialogue: 0,0:05:21.62,0:05:25.12,Default,,0000,0000,0000,,(
Dialogue: 0,0:05:21.62,0:05:25.12,Default,,0000,0000,0000,,Агаса
Dialogue: 0,0:05:21.62,0:05:25.12,Default,,0000,0000,0000,,)
Dialogue: 0,0:05:21.62,0:05:25.12,Default,,0000,0000,0000,,Сукуна мен қондырғы — табиғи жаулар, түсінесің бе.
Dialogue: 0,0:05:21.62,0:05:25.12,Default,,0000,0000,0000,,Бұл тек балаларға арналған
Dialogue: 0,0:05:21.62,0:05:25.12,Default,,0000,0000,0000,,Бұл сыйлық па?
Dialogue: 0,0:05:25.12,0:05:28.63,Default,,0000,0000,0000,,🦻
Dialogue: 0,0:05:25.12,0:05:28.63,Default,,0000,0000,0000,,(
Dialogue: 0,0:05:25.12,0:05:28.63,Default,,0000,0000,0000,,Соноко
Dialogue: 0,0:05:25.12,0:05:28.63,Default,,0000,0000,0000,,)
Dialogue: 0,0:05:25.12,0:05:28.63,Default,,0000,0000,0000,,Әрине, Dr.
Dialogue: 0,0:05:25.12,0:05:28.63,Default,,0000,0000,0000,,Көшбасшы ретінде келуіңізді сұраймын!
Dialogue: 0,0:05:28.63,0:05:31.13,Default,,0000,0000,0000,,(
Dialogue: 0,0:05:28.63,0:05:31.13,Default,,0000,0000,0000,,Агаса
Dialogue: 0,0:05:28.63,0:05:31.13,Default,,0000,0000,0000,,:
Dialogue: 0,0:05:28.63,0:05:31.13,Default,,0000,0000,0000,,Мицухико
Dialogue: 0,0:05:28.63,0:05:31.13,Default,,0000,0000,0000,,)
Dialogue: 0,0:05:28.63,0:05:31.13,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:05:28.63,0:05:31.13,Default,,0000,0000,0000,,🦻
Dialogue: 0,0:05:28.63,0:05:31.13,Default,,0000,0000,0000,,(
Dialogue: 0,0:05:28.63,0:05:31.13,Default,,0000,0000,0000,,Аюми
Dialogue: 0,0:05:28.63,0:05:31.13,Default,,0000,0000,0000,,)
Dialogue: 0,0:05:28.63,0:05:31.13,Default,,0000,0000,0000,,Сізге жақсы.
Dialogue: 0,0:05:28.63,0:05:31.13,Default,,0000,0000,0000,,Дәрігер!
Dialogue: 0,0:05:31.13,0:05:34.13,Default,,0000,0000,0000,,🦻
Dialogue: 0,0:05:31.13,0:05:34.13,Default,,0000,0000,0000,,(
Dialogue: 0,0:05:31.13,0:05:34.13,Default,,0000,0000,0000,,Агаса
Dialogue: 0,0:05:31.13,0:05:34.13,Default,,0000,0000,0000,,)
Dialogue: 0,0:05:31.13,0:05:34.13,Default,,0000,0000,0000,,Соноко-сан
Dialogue: 0,0:05:31.13,0:05:34.13,Default,,0000,0000,0000,,Мейірімділік
Dialogue: 0,0:05:31.13,0:05:34.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:36.67,0:05:40.17,Default,,0000,0000,0000,,(
Dialogue: 0,0:05:36.67,0:05:40.17,Default,,0000,0000,0000,,Жылау
Dialogue: 0,0:05:36.67,0:05:40.17,Default,,0000,0000,0000,,)
Dialogue: 0,0:05:42.61,0:05:45.61,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:05:42.61,0:05:45.61,Default,,0000,0000,0000,,Мен оны көрдім!
Dialogue: 0,0:05:42.61,0:05:45.61,Default,,0000,0000,0000,,Хачидодзима
Dialogue: 0,0:05:42.61,0:05:45.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:45.61,0:05:48.58,Default,,0000,0000,0000,,(
Dialogue: 0,0:05:45.61,0:05:48.58,Default,,0000,0000,0000,,Гента
Dialogue: 0,0:05:45.61,0:05:48.58,Default,,0000,0000,0000,,)
Dialogue: 0,0:05:45.61,0:05:48.58,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:45.61,0:05:48.58,Default,,0000,0000,0000,,Үлкен тау бар!
Dialogue: 0,0:05:48.58,0:05:52.12,Default,,0000,0000,0000,,Хачиджо Фудзи
Dialogue: 0,0:05:48.58,0:05:52.12,Default,,0000,0000,0000,,Белгілі
Dialogue: 0,0:05:48.58,0:05:52.12,Default,,0000,0000,0000,,Бұл Хачижо Фудзи деген тау.
Dialogue: 0,0:05:48.58,0:05:52.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:52.12,0:05:54.12,Default,,0000,0000,0000,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:05:52.12,0:05:54.12,Default,,0000,0000,0000,,Бұл рас!
Dialogue: 0,0:05:54.12,0:05:57.09,Default,,0000,0000,0000,,Оны асыға күтеміз!
Dialogue: 0,0:05:54.12,0:05:57.09,Default,,0000,0000,0000,,(
Dialogue: 0,0:05:54.12,0:05:57.09,Default,,0000,0000,0000,,Мицухико
Dialogue: 0,0:05:54.12,0:05:57.09,Default,,0000,0000,0000,,)
Dialogue: 0,0:05:54.12,0:05:57.09,Default,,0000,0000,0000,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:05:57.09,0:06:05.60,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:05.60,0:06:08.60,Default,,0000,0000,0000,,Хачиджо Фудзи
Dialogue: 0,0:06:05.60,0:06:08.60,Default,,0000,0000,0000,,Декки~
Dialogue: 0,0:06:05.60,0:06:08.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:05.60,0:06:08.60,Default,,0000,0000,0000,,Керемет
Dialogue: 0,0:06:05.60,0:06:08.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:08.60,0:06:10.60,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:08.60,0:06:10.60,Default,,0000,0000,0000,,Сіз не қарап тұрсыз?
Dialogue: 0,0:06:10.60,0:06:14.11,Default,,0000,0000,0000,,Интерпол жақын жерде
Dialogue: 0,0:06:10.60,0:06:14.11,Default,,0000,0000,0000,,Жаңа нысан ашылды.
Dialogue: 0,0:06:10.60,0:06:14.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:14.11,0:06:15.61,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:14.11,0:06:15.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:15.61,0:06:19.61,Default,,0000,0000,0000,,Макино
Dialogue: 0,0:06:15.61,0:06:19.61,Default,,0000,0000,0000,,📱
Dialogue: 0,0:06:15.61,0:06:19.61,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:15.61,0:06:19.61,Default,,0000,0000,0000,,Макино
Dialogue: 0,0:06:15.61,0:06:19.61,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:15.61,0:06:19.61,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:15.61,0:06:19.61,Default,,0000,0000,0000,,Дүние жүзіндегі полиция күштері бар
Dialogue: 0,0:06:15.61,0:06:19.61,Default,,0000,0000,0000,,Қауіпсіздік камерасын қосыңыз➡
Dialogue: 0,0:06:19.61,0:06:21.61,Default,,0000,0000,0000,,Дүние жүзіндегі бірінші нысан
Dialogue: 0,0:06:19.61,0:06:21.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:21.61,0:06:23.65,Default,,0000,0000,0000,,📱
Dialogue: 0,0:06:21.61,0:06:23.65,Default,,0000,0000,0000,,Бұл Тынық мұхиты
Dialogue: 0,0:06:21.61,0:06:23.65,Default,,0000,0000,0000,,
Dialogue: 0,0:06:21.61,0:06:23.65,Default,,0000,0000,0000,,Бұл қалқыма
Dialogue: 0,0:06:21.61,0:06:23.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:23.65,0:06:28.59,Default,,0000,0000,0000,,📱
Dialogue: 0,0:06:23.65,0:06:28.59,Default,,0000,0000,0000,,Қауіпсіздік камерасының суреттеріне негізделген
Dialogue: 0,0:06:23.65,0:06:28.59,Default,,0000,0000,0000,,Бет-әлпетті тану бүкіл әлемде мүмкін
Dialogue: 0,0:06:23.65,0:06:28.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:28.59,0:06:32.09,Default,,0000,0000,0000,,📱
Dialogue: 0,0:06:28.59,0:06:32.09,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:28.59,0:06:32.09,Default,,0000,0000,0000,,Ол сонымен қатар әзірлеуші➡
Dialogue: 0,0:06:32.09,0:06:34.63,Default,,0000,0000,0000,,Тынық мұхиты
Dialogue: 0,0:06:32.09,0:06:34.63,Default,,0000,0000,0000,,
Dialogue: 0,0:06:32.09,0:06:34.63,Default,,0000,0000,0000,,Буйдың мүшесі ретінде
Dialogue: 0,0:06:32.09,0:06:34.63,Default,,0000,0000,0000,,Қатысу
Dialogue: 0,0:06:32.09,0:06:34.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:34.63,0:06:37.13,Default,,0000,0000,0000,,Бұл адам
Dialogue: 0,0:06:34.63,0:06:37.13,Default,,0000,0000,0000,,Бір жерде…
Dialogue: 0,0:06:34.63,0:06:37.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:41.10,0:06:43.14,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:41.10,0:06:43.14,Default,,0000,0000,0000,,Агаса
Dialogue: 0,0:06:41.10,0:06:43.14,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:41.10,0:06:43.14,Default,,0000,0000,0000,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:06:41.10,0:06:43.14,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:06:43.14,0:06:45.67,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:43.14,0:06:45.67,Default,,0000,0000,0000,,Гента
Dialogue: 0,0:06:43.14,0:06:45.67,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:43.14,0:06:45.67,Default,,0000,0000,0000,,Охохо
Dialogue: 0,0:06:43.14,0:06:45.67,Default,,0000,0000,0000,,келді!
Dialogue: 0,0:06:43.14,0:06:45.67,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:43.14,0:06:45.67,Default,,0000,0000,0000,,Мицухико
Dialogue: 0,0:06:43.14,0:06:45.67,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:43.14,0:06:45.67,Default,,0000,0000,0000,,Хахахаха…
Dialogue: 0,0:06:45.67,0:06:47.71,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:45.67,0:06:47.71,Default,,0000,0000,0000,,Гента
Dialogue: 0,0:06:45.67,0:06:47.71,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:45.67,0:06:47.71,Default,,0000,0000,0000,,Ал, дәл қазір осы жерде бір-біріңді сүйіңдер.
Dialogue: 0,0:06:45.67,0:06:47.71,Default,,0000,0000,0000,,Dekkee қонақ үйі!
Dialogue: 0,0:06:47.71,0:06:51.11,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:47.71,0:06:51.11,Default,,0000,0000,0000,,Керемет~
Dialogue: 0,0:06:47.71,0:06:51.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:47.71,0:06:51.11,Default,,0000,0000,0000,,Бұл әдемі!
Dialogue: 0,0:06:51.11,0:06:53.11,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:51.11,0:06:53.11,Default,,0000,0000,0000,,Аюми
Dialogue: 0,0:06:51.11,0:06:53.11,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:51.11,0:06:53.11,Default,,0000,0000,0000,,Сен… кімсің?
Dialogue: 0,0:06:51.11,0:06:53.11,Default,,0000,0000,0000,,Әдемі!
Dialogue: 0,0:06:54.61,0:06:57.12,Default,,0000,0000,0000,,Ширатори
Dialogue: 0,0:06:54.61,0:06:57.12,Default,,0000,0000,0000,,《Неге инспектор Ширатори...》
Dialogue: 0,0:06:57.12,0:07:00.62,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:57.12,0:07:00.62,Default,,0000,0000,0000,,Гента
Dialogue: 0,0:06:57.12,0:07:00.62,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:57.12,0:07:00.62,Default,,0000,0000,0000,,О!
Dialogue: 0,0:06:57.12,0:07:00.62,Default,,0000,0000,0000,,Үлкен кит!
Dialogue: 0,0:07:00.62,0:07:02.12,Default,,0000,0000,0000,,(
Dialogue: 0,0:07:00.62,0:07:02.12,Default,,0000,0000,0000,,Мицухико
Dialogue: 0,0:07:00.62,0:07:02.12,Default,,0000,0000,0000,,)
Dialogue: 0,0:07:00.62,0:07:02.12,Default,,0000,0000,0000,,Тасбақалар да бар!
Dialogue: 0,0:07:02.12,0:07:04.09,Default,,0000,0000,0000,,Ирука мырза
Dialogue: 0,0:07:02.12,0:07:04.09,Default,,0000,0000,0000,,Сүйкімді
Dialogue: 0,0:07:02.12,0:07:04.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:04.09,0:07:07.16,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:07:04.09,0:07:07.16,Default,,0000,0000,0000,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:07:04.09,0:07:07.16,Default,,0000,0000,0000,,Егер сіз багажыңызды бөлмеде қалдырсаңыз➡
Dialogue: 0,0:07:07.16,0:07:09.16,Default,,0000,0000,0000,,1 сағаттан кейін
Dialogue: 0,0:07:07.16,0:07:09.16,Default,,0000,0000,0000,,Осы жерде тағы кездесейік!
Dialogue: 0,0:07:09.16,0:07:11.20,Default,,0000,0000,0000,,(
Dialogue: 0,0:07:09.16,0:07:11.20,Default,,0000,0000,0000,,Гента
Dialogue: 0,0:07:09.16,0:07:11.20,Default,,0000,0000,0000,,:
Dialogue: 0,0:07:09.16,0:07:11.20,Default,,0000,0000,0000,,Мицухико
Dialogue: 0,0:07:09.16,0:07:11.20,Default,,0000,0000,0000,,:
Dialogue: 0,0:07:09.16,0:07:11.20,Default,,0000,0000,0000,,Аюми
Dialogue: 0,0:07:09.16,0:07:11.20,Default,,0000,0000,0000,,)
Dialogue: 0,0:07:09.16,0:07:11.20,Default,,0000,0000,0000,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:07:11.20,0:07:13.10,Default,,0000,0000,0000,,Ширатори инспекторы?
Dialogue: 0,0:07:13.10,0:07:15.10,Default,,0000,0000,0000,,Мен қателесіп жатырмын ба?
Dialogue: 0,0:07:15.10,0:07:18.10,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:07:15.10,0:07:18.10,Default,,0000,0000,0000,,Бұл міндетті түрде инспектор Ширатори болды.
Dialogue: 0,0:07:15.10,0:07:18.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:18.10,0:07:21.11,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:07:18.10,0:07:21.11,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:07:21.11,0:07:25.14,Default,,0000,0000,0000,,📱
Dialogue: 0,0:07:21.11,0:07:25.14,Default,,0000,0000,0000,,(
Dialogue: 0,0:07:21.11,0:07:25.14,Default,,0000,0000,0000,,Діріл дыбысы
Dialogue: 0,0:07:21.11,0:07:25.14,Default,,0000,0000,0000,,)
Dialogue: 0,0:07:25.14,0:07:29.15,Default,,0000,0000,0000,,Окия
Dialogue: 0,0:07:25.14,0:07:29.15,Default,,0000,0000,0000,,📱
