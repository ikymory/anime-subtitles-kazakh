Dialogue: 0,1:20:10.47,1:20:14.41,Default,,0000,0000,0000,,.
Dialogue: 0,1:20:14.41,1:20:16.41,Default,,0000,0000,0000,,(
Dialogue: 0,1:20:14.41,1:20:16.41,Default,,0000,0000,0000,,Орхидея
Dialogue: 0,1:20:14.41,1:20:16.41,Default,,0000,0000,0000,,)
Dialogue: 0,1:20:14.41,1:20:16.41,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:20:14.41,1:20:16.41,Default,,0000,0000,0000,,Өтірік?
Dialogue: 0,1:20:16.41,1:20:18.95,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:20:16.41,1:20:18.95,Default,,0000,0000,0000,,Бұл кафе болды ма?
Dialogue: 0,1:20:16.41,1:20:18.95,Default,,0000,0000,0000,,.
Dialogue: 0,1:20:18.95,1:20:22.88,Default,,0000,0000,0000,,(
Dialogue: 0,1:20:18.95,1:20:22.88,Default,,0000,0000,0000,,Дауысты өзгерткіш
Dialogue: 0,1:20:18.95,1:20:22.88,Default,,0000,0000,0000,,)
Dialogue: 0,1:20:18.95,1:20:22.88,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:20:18.95,1:20:22.88,Default,,0000,0000,0000,,Жеке бөлмеде
Dialogue: 0,1:20:18.95,1:20:22.88,Default,,0000,0000,0000,,Бақылау камералары жоқ➡
Dialogue: 0,1:20:22.88,1:20:26.89,Default,,0000,0000,0000,,Кәдімгі дәмхана
Dialogue: 0,1:20:22.88,1:20:26.89,Default,,0000,0000,0000,,Мен тазалау уақытын тиімді пайдаландым.
Dialogue: 0,1:20:22.88,1:20:26.89,Default,,0000,0000,0000,,.
Dialogue: 0,1:20:26.89,1:20:31.46,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,1:20:26.89,1:20:31.46,Default,,0000,0000,0000,,Шындығында, тазалау
Dialogue: 0,1:20:26.89,1:20:31.46,Default,,0000,0000,0000,,Бұл орындалмағанын білдіре ме?
Dialogue: 0,1:20:26.89,1:20:31.46,Default,,0000,0000,0000,,.
Dialogue: 0,1:20:31.46,1:20:35.03,Default,,0000,0000,0000,,(
Dialogue: 0,1:20:31.46,1:20:35.03,Default,,0000,0000,0000,,Дауысты өзгерткіш
Dialogue: 0,1:20:31.46,1:20:35.03,Default,,0000,0000,0000,,)
Dialogue: 0,1:20:31.46,1:20:35.03,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:20:31.46,1:20:35.03,Default,,0000,0000,0000,,Бас тарту
Dialogue: 0,1:20:31.46,1:20:35.03,Default,,0000,0000,0000,,Олар сізбен байланысуы керек еді.
Dialogue: 0,1:20:31.46,1:20:35.03,Default,,0000,0000,0000,,.
Dialogue: 0,1:20:35.03,1:20:38.90,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,1:20:35.03,1:20:38.90,Default,,0000,0000,0000,,Қылмыскердің кейінгі қимылдары
Dialogue: 0,1:20:35.03,1:20:38.90,Default,,0000,0000,0000,,Міне
Dialogue: 0,1:20:35.03,1:20:38.90,Default,,0000,0000,0000,,.
Dialogue: 0,1:20:38.90,1:20:41.44,Default,,0000,0000,0000,,Наомидің ұрлануы сияқты➡
Dialogue: 0,1:20:41.44,1:20:45.41,Default,,0000,0000,0000,,Тазалау арбасына
Dialogue: 0,1:20:41.44,1:20:45.41,Default,,0000,0000,0000,,ұйықтау
Dialogue: 0,1:20:41.44,1:20:45.41,Default,,0000,0000,0000,,Леонхард мырзаны➡ қосыңыз
Dialogue: 0,1:20:45.41,1:20:51.41,Default,,0000,0000,0000,,Кафеге тазалықшы болып барыңыз
Dialogue: 0,1:20:45.41,1:20:51.41,Default,,0000,0000,0000,,Ешкімге кіруге рұқсат етілмеді.
Dialogue: 0,1:20:45.41,1:20:51.41,Default,,0000,0000,0000,,.
Dialogue: 0,1:20:51.41,1:20:54.42,Default,,0000,0000,0000,,Әрине, бақылау камералары
Dialogue: 0,1:20:51.41,1:20:54.42,Default,,0000,0000,0000,,Оны циклдік бейнеге айналдырыңыз
Dialogue: 0,1:20:51.41,1:20:54.42,Default,,0000,0000,0000,,.
Dialogue: 0,1:20:54.42,1:21:00.52,Default,,0000,0000,0000,,Онда
Dialogue: 0,1:20:54.42,1:21:00.52,Default,,0000,0000,0000,,Кінәлі Леонхардт мырза.
Dialogue: 0,1:20:54.42,1:21:00.52,Default,,0000,0000,0000,,У беру арқылы кісі өлтіру
Dialogue: 0,1:20:54.42,1:21:00.52,Default,,0000,0000,0000,,.
Dialogue: 0,1:21:00.52,1:21:03.43,Default,,0000,0000,0000,,Соңғы демім шыққанша
Dialogue: 0,1:21:00.52,1:21:03.43,Default,,0000,0000,0000,,Сол жерде болуы керек
Dialogue: 0,1:21:00.52,1:21:03.43,Default,,0000,0000,0000,,.
Dialogue: 0,1:21:03.43,1:21:06.93,Default,,0000,0000,0000,,Өлімді бақылау.
Dialogue: 0,1:21:03.43,1:21:06.93,Default,,0000,0000,0000,,.
Dialogue: 0,1:21:06.93,1:21:08.43,Default,,0000,0000,0000,,Қорқынышты...
Dialogue: 0,1:21:06.93,1:21:08.43,Default,,0000,0000,0000,,.
Dialogue: 0,1:21:08.43,1:21:10.90,Default,,0000,0000,0000,,(
Dialogue: 0,1:21:08.43,1:21:10.90,Default,,0000,0000,0000,,Дауысты өзгертуші
Dialogue: 0,1:21:08.43,1:21:10.90,Default,,0000,0000,0000,,)
Dialogue: 0,1:21:08.43,1:21:10.90,Default,,0000,0000,0000,,Алдымен бейнені жасасаңыз➡
Dialogue: 0,1:21:10.90,1:21:14.40,Default,,0000,0000,0000,,Қалай өлесің?
Dialogue: 0,1:21:10.90,1:21:14.40,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,1:21:10.90,1:21:14.40,Default,,0000,0000,0000,,.
Dialogue: 0,1:21:14.40,1:21:18.44,Default,,0000,0000,0000,,Мен темекі шегуді тастадым
Dialogue: 0,1:21:14.40,1:21:18.44,Default,,0000,0000,0000,,Кінәлі
Dialogue: 0,1:21:14.40,1:21:18.44,Default,,0000,0000,0000,,Леонхардт
Dialogue: 0,1:21:14.40,1:21:18.44,Default,,0000,0000,0000,,➡-ге ұқсас киімдерді ауыстырыңыз
Dialogue: 0,1:21:18.44,1:21:21.98,Default,,0000,0000,0000,,Мен улы дәрілерден зардап шегу туралы спектакль қойдым.
Dialogue: 0,1:21:18.44,1:21:21.98,Default,,0000,0000,0000,,.
Dialogue: 0,1:21:21.98,1:21:24.91,Default,,0000,0000,0000,,Үстелдің артында жасырылған
Dialogue: 0,1:21:21.98,1:21:24.91,Default,,0000,0000,0000,,Құлаған адам➡ болды
Dialogue: 0,1:21:24.91,1:21:27.42,Default,,0000,0000,0000,,Нақты
Dialogue: 0,1:21:24.91,1:21:27.42,Default,,0000,0000,0000,,Кафеде
Dialogue: 0,1:21:24.91,1:21:27.42,Default,,0000,0000,0000,,Бақылау камерасының түсірілімі және ➡
Dialogue: 0,1:21:27.42,1:21:29.42,Default,,0000,0000,0000,,Нақты уақытта ауысқанда➡
Dialogue: 0,1:21:29.42,1:21:32.42,Default,,0000,0000,0000,,Сого
Dialogue: 0,1:21:29.42,1:21:32.42,Default,,0000,0000,0000,,Сәйкессіздіктер
Dialogue: 0,1:21:29.42,1:21:32.42,Default,,0000,0000,0000,,Мұның алдын алу үшін.
Dialogue: 0,1:21:29.42,1:21:32.42,Default,,0000,0000,0000,,.
Dialogue: 0,1:21:32.42,1:21:34.39,Default,,0000,0000,0000,,Ұқсас киім дегенді қалай түсінесіңдер?
Dialogue: 0,1:21:34.39,1:21:37.43,Default,,0000,0000,0000,,(
Dialogue: 0,1:21:34.39,1:21:37.43,Default,,0000,0000,0000,,Дауысты өзгерткіш
Dialogue: 0,1:21:34.39,1:21:37.43,Default,,0000,0000,0000,,)
Dialogue: 0,1:21:34.39,1:21:37.43,Default,,0000,0000,0000,,Ах
Dialogue: 0,1:21:34.39,1:21:37.43,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,1:21:34.39,1:21:37.43,Default,,0000,0000,0000,,Бұл бейне ➡
Dialogue: 0,1:21:37.43,1:21:40.93,Default,,0000,0000,0000,,Тек бет жағы CG
Dialogue: 0,1:21:37.43,1:21:40.93,Default,,0000,0000,0000,,Дене кінәлі
Dialogue: 0,1:21:37.43,1:21:40.93,Default,,0000,0000,0000,,.
Dialogue: 0,1:21:40.93,1:21:43.50,Default,,0000,0000,0000,,(
Dialogue: 0,1:21:40.93,1:21:43.50,Default,,0000,0000,0000,,Мегур
Dialogue: 0,1:21:40.93,1:21:43.50,Default,,0000,0000,0000,,)
Dialogue: 0,1:21:40.93,1:21:43.50,Default,,0000,0000,0000,,Не?
Dialogue: 0,1:21:40.93,1:21:43.50,Default,,0000,0000,0000,,(
Dialogue: 0,1:21:40.93,1:21:43.50,Default,,0000,0000,0000,,Шырылдау
Dialogue: 0,1:21:40.93,1:21:43.50,Default,,0000,0000,0000,,)
Dialogue: 0,1:21:43.50,1:21:47.44,Default,,0000,0000,0000,,(
Dialogue: 0,1:21:43.50,1:21:47.44,Default,,0000,0000,0000,,Дауысты өзгерткіш
Dialogue: 0,1:21:43.50,1:21:47.44,Default,,0000,0000,0000,,)
Dialogue: 0,1:21:43.50,1:21:47.44,Default,,0000,0000,0000,,КГ-мен денені құру жолы
Dialogue: 0,1:21:43.50,1:21:47.44,Default,,0000,0000,0000,,Менің уақытым жетпеді деп ойлаймын.
Dialogue: 0,1:21:43.50,1:21:47.44,Default,,0000,0000,0000,,.
Dialogue: 0,1:21:47.44,1:21:50.91,Default,,0000,0000,0000,,(
Dialogue: 0,1:21:47.44,1:21:50.91,Default,,0000,0000,0000,,Аққу
Dialogue: 0,1:21:47.44,1:21:50.91,Default,,0000,0000,0000,,)
Dialogue: 0,1:21:47.44,1:21:50.91,Default,,0000,0000,0000,,Дегенмен
Dialogue: 0,1:21:47.44,1:21:50.91,Default,,0000,0000,0000,,тіпті Эден кампусында да — қайдағы қырағы көздердің қашан қарап тұрғанын білмейсің.
Dialogue: 0,1:21:47.44,1:21:50.91,Default,,0000,0000,0000,,Сен мұны істедің бе?
Dialogue: 0,1:21:50.91,1:21:52.94,Default,,0000,0000,0000,,(
Dialogue: 0,1:21:50.91,1:21:52.94,Default,,0000,0000,0000,,Дауысты өзгерткіш
Dialogue: 0,1:21:50.91,1:21:52.94,Default,,0000,0000,0000,,)
Dialogue: 0,1:21:50.91,1:21:52.94,Default,,0000,0000,0000,,Наоми➡ әзірлеген
Dialogue: 0,1:21:52.94,1:21:55.91,Default,,0000,0000,0000,,Біз жасты растау технологиясын қолдандық.
Dialogue: 0,1:21:52.94,1:21:55.91,Default,,0000,0000,0000,,.
Dialogue: 0,1:21:55.91,1:21:58.91,Default,,0000,0000,0000,,(
Dialogue: 0,1:21:55.91,1:21:58.91,Default,,0000,0000,0000,,Курода
Dialogue: 0,1:21:55.91,1:21:58.91,Default,,0000,0000,0000,,)
Dialogue: 0,1:21:55.91,1:21:58.91,Default,,0000,0000,0000,,Бұл CG көмегімен беттерді жасау технологиясы ма?
Dialogue: 0,1:21:55.91,1:21:58.91,Default,,0000,0000,0000,,.
Dialogue: 0,1:21:58.91,1:22:03.99,Default,,0000,0000,0000,,Қызметкер деректері үшін, алдын ала
Dialogue: 0,1:21:58.91,1:22:03.99,Default,,0000,0000,0000,,Оның алу мүмкіндігі жоғары.
Dialogue: 0,1:21:58.91,1:22:03.99,Default,,0000,0000,0000,,.
Dialogue: 0,1:22:03.99,1:22:07.92,Default,,0000,0000,0000,,Дегенмен
Dialogue: 0,1:22:03.99,1:22:07.92,Default,,0000,0000,0000,,Мори-кун
Dialogue: 0,1:22:03.99,1:22:07.92,Default,,0000,0000,0000,,Маған шынайы болып көрінеді
Dialogue: 0,1:22:03.99,1:22:07.92,Default,,0000,0000,0000,,.
Dialogue: 0,1:22:07.92,1:22:10.93,Default,,0000,0000,0000,,Бұл жалған бейне деуге не негіз болды?
Dialogue: 0,1:22:10.93,1:22:13.93,Default,,0000,0000,0000,,(
Dialogue: 0,1:22:10.93,1:22:13.93,Default,,0000,0000,0000,,Дауысты өзгерткіш
Dialogue: 0,1:22:10.93,1:22:13.93,Default,,0000,0000,0000,,)
Dialogue: 0,1:22:10.93,1:22:13.93,Default,,0000,0000,0000,,Мен біріншімін
Dialogue: 0,1:22:10.93,1:22:13.93,Default,,0000,0000,0000,,Бұл бейнені көргенде➡
Dialogue: 0,1:22:13.93,1:22:18.43,Default,,0000,0000,0000,,Мен қатты жайсыздық сезімін сезіндім.
Dialogue: 0,1:22:13.93,1:22:18.43,Default,,0000,0000,0000,,.
Dialogue: 0,1:22:13.93,1:22:18.43,Default,,0000,0000,0000,,Өзіңізді жайсыз сезінесіз бе?
Dialogue: 0,1:22:18.43,1:22:21.90,Default,,0000,0000,0000,,(
Dialogue: 0,1:22:18.43,1:22:21.90,Default,,0000,0000,0000,,Дауысты өзгерткіш
Dialogue: 0,1:22:18.43,1:22:21.90,Default,,0000,0000,0000,,)
Dialogue: 0,1:22:18.43,1:22:21.90,Default,,0000,0000,0000,,Оның қолы
Dialogue: 0,1:22:18.43,1:22:21.90,Default,,0000,0000,0000,,Мұқият қараңыз
Dialogue: 0,1:22:18.43,1:22:21.90,Default,,0000,0000,0000,,.
Dialogue: 0,1:22:27.01,1:22:29.91,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:22:27.01,1:22:29.91,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,1:22:27.01,1:22:29.91,Default,,0000,0000,0000,,.
Dialogue: 0,1:22:29.91,1:22:34.92,Default,,0000,0000,0000,,Далап жағатын әйелдерге тән қимылдар
Dialogue: 0,1:22:29.91,1:22:34.92,Default,,0000,0000,0000,,Ана да
Dialogue: 0,1:22:29.91,1:22:34.92,Default,,0000,0000,0000,,Жарайсыңдар
Dialogue: 0,1:22:29.91,1:22:34.92,Default,,0000,0000,0000,,.
Dialogue: 0,1:22:34.92,1:22:39.92,Default,,0000,0000,0000,,(
Dialogue: 0,1:22:34.92,1:22:39.92,Default,,0000,0000,0000,,Дауысты өзгерткіш
Dialogue: 0,1:22:34.92,1:22:39.92,Default,,0000,0000,0000,,)
Dialogue: 0,1:22:34.92,1:22:39.92,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,1:22:34.92,1:22:39.92,Default,,0000,0000,0000,,Мына кесенің аузын сүрту қимылы➡
Dialogue: 0,1:22:39.92,1:22:44.96,Default,,0000,0000,0000,,Сен
Dialogue: 0,1:22:39.92,1:22:44.96,Default,,0000,0000,0000,,Мұнда
Dialogue: 0,1:22:39.92,1:22:44.96,Default,,0000,0000,0000,,жақсы
Dialogue: 0,1:22:39.92,1:22:44.96,Default,,0000,0000,0000,,Сіз мұны істедіңіз, солай ма?
Dialogue: 0,1:22:39.92,1:22:44.96,Default,,0000,0000,0000,,.
Dialogue: 0,1:22:44.96,1:22:46.43,Default,,0000,0000,0000,,Грейс
Dialogue: 0,1:22:44.96,1:22:46.43,Default,,0000,0000,0000,,.
Dialogue: 0,1:22:48.50,1:22:52.40,Default,,0000,0000,0000,,(
Dialogue: 0,1:22:48.50,1:22:52.40,Default,,0000,0000,0000,,Дауысты өзгерткіш
Dialogue: 0,1:22:48.50,1:22:52.40,Default,,0000,0000,0000,,)
Dialogue: 0,1:22:48.50,1:22:52.40,Default,,0000,0000,0000,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,1:22:48.50,1:22:52.40,Default,,0000,0000,0000,,Қимыл
Dialogue: 0,1:22:48.50,1:22:52.40,Default,,0000,0000,0000,,Бұл әдетке айналған болуы керек.
Dialogue: 0,1:22:48.50,1:22:52.40,Default,,0000,0000,0000,,.
Dialogue: 0,1:22:52.40,1:22:56.94,Default,,0000,0000,0000,,Әйел болу үшін тым көп тырысу
Dialogue: 0,1:22:52.40,1:22:56.94,Default,,0000,0000,0000,,.
Dialogue: 0,1:22:52.40,1:22:56.94,Default,,0000,0000,0000,,Әйел болуға тырыстың ба?
Dialogue: 0,1:22:56.94,1:23:02.41,Default,,0000,0000,0000,,(
Dialogue: 0,1:22:56.94,1:23:02.41,Default,,0000,0000,0000,,Дауысты өзгерткіш
Dialogue: 0,1:22:56.94,1:23:02.41,Default,,0000,0000,0000,,)
Dialogue: 0,1:22:56.94,1:23:02.41,Default,,0000,0000,0000,,Иә
Dialogue: 0,1:22:56.94,1:23:02.41,Default,,0000,0000,0000,,Менің болжамым дұрыс болса
Dialogue: 0,1:22:56.94,1:23:02.41,Default,,0000,0000,0000,,Бұл адам, бәлкім,➡
Dialogue: 0,1:23:02.41,1:23:05.41,Default,,0000,0000,0000,,Менің ойымша, бұл әйел емес.
Dialogue: 0,1:23:02.41,1:23:05.41,Default,,0000,0000,0000,,.
Dialogue: 0,1:23:02.41,1:23:05.41,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:23:05.41,1:23:07.45,Default,,0000,0000,0000,,(
Dialogue: 0,1:23:05.41,1:23:07.45,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,1:23:05.41,1:23:07.45,Default,,0000,0000,0000,,)
Dialogue: 0,1:23:05.41,1:23:07.45,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:23:07.45,1:23:12.42,Default,,0000,0000,0000,,(
Dialogue: 0,1:23:07.45,1:23:12.42,Default,,0000,0000,0000,,Дауысты өзгерткіш
Dialogue: 0,1:23:07.45,1:23:12.42,Default,,0000,0000,0000,,)
Dialogue: 0,1:23:07.45,1:23:12.42,Default,,0000,0000,0000,,Қарсылық білдірмеу құралдары
Dialogue: 0,1:23:07.45,1:23:12.42,Default,,0000,0000,0000,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,1:23:07.45,1:23:12.42,Default,,0000,0000,0000,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,1:23:07.45,1:23:12.42,Default,,0000,0000,0000,,.
Dialogue: 0,1:23:12.42,1:23:14.42,Default,,0000,0000,0000,,Мен қатты таңғалып, дыбыс шығара алмай қалдым.
Dialogue: 0,1:23:12.42,1:23:14.42,Default,,0000,0000,0000,,.
Dialogue: 0,1:23:14.42,1:23:16.93,Default,,0000,0000,0000,,Әйел емес
Dialogue: 0,1:23:14.42,1:23:16.93,Default,,0000,0000,0000,,Маған айтасың деп күтпедім...
Dialogue: 0,1:23:14.42,1:23:16.93,Default,,0000,0000,0000,,.
Dialogue: 0,1:23:16.93,1:23:20.93,Default,,0000,0000,0000,,(
Dialogue: 0,1:23:16.93,1:23:20.93,Default,,0000,0000,0000,,Дауысты өзгерткіш
