Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.33,0:00:09.95,Default,,0,0,0,,NETFLIX түпнұсқалық аниме сериясы
Dialogue: 0,0:00:27.75,0:00:29.91,Default,,0,0,0,,Тауық патшасы 3-бөлім
Dialogue: 0,0:00:44.00,0:00:46.08,Default,,0,0,0,,Бұл бәрібір бір көзқарас
Dialogue: 0,0:00:46.20,0:00:48.45,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:01:21.41,0:01:22.54,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:01:22.70,0:01:24.45,Default,,0,0,0,,Мен әбден жынданып кеттім.
Dialogue: 0,0:01:34.58,0:01:36.79,Default,,0,0,0,,Өрт сөндіру!
Dialogue: 0,0:02:11.87,0:02:13.91,Default,,0,0,0,,Жақсы, көк тауық!
Dialogue: 0,0:02:14.04,0:02:15.08,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:02:15.50,0:02:16.66,Default,,0,0,0,,Оны ұрыңыз
Dialogue: 0,0:02:16.79,0:02:17.62,Default,,0,0,0,,Оны ұрыңыз
Dialogue: 0,0:02:35.08,0:02:36.58,Default,,0,0,0,,Жалқау болмаңыз
Dialogue: 0,0:02:58.66,0:03:00.50,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:01.25,0:03:06.25,Default,,0,0,0,,Жеуге жарамды Егер мені жеңсең, жауынгер бола аламын деп ойлайсың ба?
Dialogue: 0,0:03:06.58,0:03:09.50,Default,,0,0,0,,Сіз ең жақсы өмір сүре аласыз ба?
Dialogue: 0,0:03:12.95,0:03:17.50,Default,,0,0,0,,Жауынгер болсаң да, жекпе-жекке шыдамайтын күн келеді.
Dialogue: 0,0:03:17.70,0:03:20.41,Default,,0,0,0,,Егер бұлай болса, сізді жеп қояды.
Dialogue: 0,0:03:21.25,0:03:25.04,Default,,0,0,0,,Тауықтың тағдыры бәрібір жеу керек.
Dialogue: 0,0:03:25.66,0:03:31.45,Default,,0,0,0,,Адамдар бір-бірімізді өлтіргенімізді көргісі келеді.
Dialogue: 0,0:03:35.33,0:03:38.79,Default,,0,0,0,,Менің мақсатым сен емес.
Dialogue: 0,0:03:41.62,0:03:42.20,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:03:49.83,0:03:50.95,Default,,0,0,0,,Қарсы шабуыл?
Dialogue: 0,0:04:11.83,0:04:13.12,Default,,0,0,0,,Ол жаққа көшпеңіз
Dialogue: 0,0:04:16.79,0:04:19.41,Default,,0,0,0,,Маған тауық қорасының есігін ашайын.
Dialogue: 0,0:04:19.91,0:04:22.45,Default,,0,0,0,,Әйтпесе тамағыңды кесемін.
Dialogue: 0,0:04:23.54,0:04:25.66,Default,,0,0,0,,Барлық тауықтарды жіберіңіз
Dialogue: 0,0:04:30.87,0:04:32.70,Default,,0,0,0,,Барыңдар, ақымақтар.
Dialogue: 0,0:04:32.83,0:04:35.37,Default,,0,0,0,,Мен өлсем жалақымды кім береді?
Dialogue: 0,0:05:14.70,0:05:16.87,Default,,0,0,0,,Қашқаннан пайда жоқ
Dialogue: 0,0:05:17.87,0:05:22.00,Default,,0,0,0,,Сені жегісі келетіндер көп.
Dialogue: 0,0:05:22.62,0:05:26.08,Default,,0,0,0,,Қайда барсам да жейді.
Dialogue: 0,0:05:28.25,0:05:31.25,Default,,0,0,0,,Адамдарға мейірімділік қажет емес.
Dialogue: 0,0:05:31.70,0:05:36.41,Default,,0,0,0,,Мен сен қорқатын ең күшті тауық боламын.
Dialogue: 0,0:05:38.33,0:05:40.00,Default,,0,0,0,,Тауық қашып кетті.
Dialogue: 0,0:05:40.95,0:05:42.66,Default,,0,0,0,,Қолымды жібер
Dialogue: 0,0:05:43.20,0:05:47.37,Default,,0,0,0,,Мен сендерден бір нәрсе үйрендім.
Dialogue: 0,0:05:47.75,0:05:51.70,Default,,0,0,0,,Бұл дүние әділетсіз
Dialogue: 0,0:05:52.20,0:05:53.54,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:06:31.45,0:06:32.29,Default,,0,0,0,,Дайбо
Dialogue: 0,0:06:33.08,0:06:34.83,Default,,0,0,0,,Сяо Фэйді жайына қалдыр.
Dialogue: 0,0:06:49.91,0:06:52.91,Default,,0,0,0,,Бұл баланың жүрегін жаралау мүмкін емес.
Dialogue: 0,0:06:53.66,0:06:57.04,Default,,0,0,0,,Дүниеде әдемі жерлер бар. Барайық.
Dialogue: 0,0:06:57.66,0:07:00.29,Default,,0,0,0,,Мен саған көрсетемін
Dialogue: 0,0:07:00.83,0:07:05.25,Default,,0,0,0,,Тауықтар оңай өмір сүретін тауық аралы бар сияқты.
Dialogue: 0,0:07:05.45,0:07:06.50,Default,,0,0,0,,Бару...
Dialogue: 0,0:07:18.66,0:07:20.16,Default,,0,0,0,,Балапан бала
Dialogue: 0,0:07:20.54,0:07:23.20,Default,,0,0,0,,Мен сені бүгін кешке якитори жасаймын.
Dialogue: 0,0:07:28.83,0:07:30.95,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:07:31.66,0:07:34.12,Default,,0,0,0,,Не болды? Шынымен де біреу бізді аңдап жүрген екен ғой?
Dialogue: 0,0:08:08.70,0:08:09.79,Default,,0,0,0,,Біз келдік
Dialogue: 0,0:08:11.58,0:08:12.33,Default,,0,0,0,,5 юань
Dialogue: 0,0:08:14.16,0:08:15.04,Default,,0,0,0,,Балық аулаудың қажеті жоқ
Dialogue: 0,0:08:20.62,0:08:22.50,Default,,0,0,0,,«Аралға кіру процедуралары»
Dialogue: 0,0:08:24.95,0:08:26.91,Default,,0,0,0,,Эй, мен аралға қосылғым келеді.
Dialogue: 0,0:08:27.29,0:08:29.08,Default,,0,0,0,,Қажетті процедуралар
Dialogue: 0,0:08:29.20,0:08:30.83,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:08:31.08,0:08:34.62,Default,,0,0,0,,Ол тауықтардың патшасы. Мені «Тауық патшасы» деп атаңыз.
Dialogue: 0,0:08:41.33,0:08:43.87,Default,,0,0,0,,Екі майлы етті тауық
Dialogue: 0,0:08:48.33,0:08:50.91,Default,,0,0,0,,Әдемі аралды қорғау
Dialogue: 0,0:08:51.04,0:08:53.33,Default,,0,0,0,,Әдемі жүректі сақта
Dialogue: 0,0:08:53.45,0:08:55.83,Default,,0,0,0,,Тауық етін ешкім жемейтін сияқты.
Dialogue: 0,0:08:56.33,0:08:57.54,Default,,0,0,0,,Осы жерде тұрайық
Dialogue: 0,0:08:57.66,0:08:59.91,Default,,0,0,0,,Қоқыс тастау - 800 юань айыппұл
Dialogue: 0,0:09:10.29,0:09:11.16,Default,,0,0,0,,〝Толқындардан сақ бол〞
Dialogue: 0,0:09:11.16,0:09:13.79,Default,,0,0,0,,〝Толқындардан сақ бол〞
Dialogue: 0,0:09:11.16,0:09:13.79,Default,,0,0,0,,Сяо Фэй күту.
Dialogue: 0,0:09:25.37,0:09:28.04,Default,,0,0,0,,Маңызды емес, оны жайына қалдырыңыз
Dialogue: 0,0:09:29.04,0:09:29.91,Default,,0,0,0,,Кеттік
Dialogue: 0,0:09:30.37,0:09:32.95,Default,,0,0,0,,Адамдар пайдалы ма?
Dialogue: 0,0:09:53.62,0:09:55.75,Default,,0,0,0,,Балалармен жұмыс істеу қиын.
Dialogue: 0,0:09:58.12,0:10:00.20,Default,,0,0,0,,Мен оны бірінші тартамын.
Dialogue: 0,0:10:00.58,0:10:02.95,Default,,0,0,0,,Ол өлген шығар.
Dialogue: 0,0:10:05.29,0:10:06.58,Default,,0,0,0,,Тыныс бар
Dialogue: 0,0:10:07.08,0:10:08.58,Default,,0,0,0,,Дәрігерді табыңыз
Dialogue: 0,0:12:16.33,0:12:19.33,Default,,0,0,0,,Жапон субтитрлері Тецуко Икегая
Dialogue: 0,0:12:20.83,0:12:26.83,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory