Dialogue: 0,1:02:11.09,1:02:15.12,Default,,0000,0000,0000,,Англияда жартылай.➡
Dialogue: 0,1:02:15.12,1:02:19.90,Default,,0000,0000,0000,,Маньчжуриядағы жапондық бақылауда
Dialogue: 0,1:02:15.12,1:02:19.90,Default,,0000,0000,0000,,Джуно кездескен осы екі адам➡
Dialogue: 0,1:02:19.90,1:02:24.10,Default,,0000,0000,0000,,Дәрілік заттармен қамтамасыз етуде
Dialogue: 0,1:02:19.90,1:02:24.10,Default,,0000,0000,0000,,Рөлді орындады>
Dialogue: 0,1:02:25.92,1:02:29.66,Default,,0000,0000,0000,,<8 қыркүйек
Dialogue: 0,1:02:25.92,1:02:29.66,Rubi,,0000,0000,0000,,Атсуги
Dialogue: 0,1:02:25.92,1:02:29.66,Default,,0000,0000,0000,,Дәрілер Ацуги әуежайынан жеткізіледі➡
Dialogue: 0,1:02:29.66,1:02:33.56,Default,,0000,0000,0000,,АҚШ-тың 6 әскери ұшағымен тасымалданады.➡
Dialogue: 0,1:02:33.56,1:02:41.45,Default,,0000,0000,0000,,Шамамен 4 күнде Джуно Хиросима қаласында болды.
