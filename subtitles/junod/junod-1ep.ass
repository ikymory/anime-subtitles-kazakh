Dialogue: 0,1:02:41.45,1:02:45.85,Default,,0000,0000,0000,,Бұл Фукуромачи бастауыш мектебі
Dialogue: 0,1:02:41.45,1:02:45.85,Default,,0000,0000,0000,,Оларға Джуноның медициналық көмек көрсеткенін айт➡
Dialogue: 0,1:02:45.85,1:02:48.95,Default,,0000,0000,0000,,Шаршы бар>
Dialogue: 0,1:02:51.56,1:02:55.91,Default,,0000,0000,0000,,<Нөлден шамамен 500 м
Dialogue: 0,1:02:51.56,1:02:55.91,Default,,0000,0000,0000,,Күшейтілген мектеп ғимараты➡
Dialogue: 0,1:02:55.91,1:03:01.80,Default,,0000,0000,0000,,Уақытша құрылыс, себебі ол бастапқы пішінін сақтап қалды
Dialogue: 0,1:02:55.91,1:03:01.80,Default,,0000,0000,0000,,Жедел жәрдем станциясы ретінде пайдаланылады.➡
Dialogue: 0,1:03:01.80,1:03:04.26,Default,,0000,0000,0000,,Көптеген науқастар тасымалданды➡
Dialogue: 0,1:03:04.26,1:03:07.43,Default,,0000,0000,0000,,Медициналық бұйымдар
Dialogue: 0,1:03:04.26,1:03:07.43,Default,,0000,0000,0000,,Жоқ дерлік.➡
Dialogue: 0,1:03:07.43,1:03:11.53,Default,,0000,0000,0000,,Онда жаңа дәрі бар.
Dialogue: 0,1:03:07.43,1:03:11.53,Default,,0000,0000,0000,,Таратылды>
Dialogue: 0,1:03:14.25,1:03:18.87,Default,,0000,0000,0000,,<Сансыз өмірден айырылған.
Dialogue: 0,1:03:14.25,1:03:18.87,Default,,0000,0000,0000,,Атом бомбасы｡➡
Dialogue: 0,1:03:18.87,1:03:24.37,Default,,0000,0000,0000,,Юно ядролық қаруды қолдануды жоспарлайды
Dialogue: 0,1:03:18.87,1:03:24.37,Default,,0000,0000,0000,,Мен қатты сынға аламын>
Dialogue: 0,1:03:43.55,1:03:48.02,Default,,0000,0000,0000,,<Юно ақырында болады
Dialogue: 0,1:03:43.55,1:03:48.02,Default,,0000,0000,0000,,Халықаралық Қызыл Крест Комитеті
Dialogue: 0,1:03:43.55,1:03:48.02,Default,,0000,0000,0000,,Вице-президент болу➡
Dialogue: 0,1:03:48.02,1:03:53.92,Default,,0000,0000,0000,,1961 ж
Dialogue: 0,1:03:48.02,1:03:53.92,Default,,0000,0000,0000,,57 жасында қайтыс болды>
Dialogue: 0,1:03:59.96,1:04:04.85,Default,,0000,0000,0000,,<Хиросимада ғана емес, Нагасакиде де
Dialogue: 0,1:03:59.96,1:04:04.85,Default,,0000,0000,0000,,Медициналық көмек көрсетпеу➡
Dialogue: 0,1:04:04.85,1:04:08.25,Default,,0000,0000,0000,,Мен өкіне бердім>
Dialogue: 0,1:04:13.43,1:04:16.15,Default,,0000,0000,0000,,<Соғыс пен зорлық-зомбылық үстемдік еткен дәуірде➡
Dialogue: 0,1:04:16.15,1:04:20.15,Default,,0000,0000,0000,,Жәбірленушіге көмектесу
Dialogue: 0,1:04:16.15,1:04:20.15,Default,,0000,0000,0000,,Джуно қатты жүгірді.➡
Dialogue: 0,1:04:20.15,1:04:25.75,Default,,0000,0000,0000,,Ол өзін «үшінші солдат» деп атайды.
Dialogue: 0,1:04:20.15,1:04:25.75,Default,,0000,0000,0000,,Мен қоңырау шалдым.➡
Dialogue: 0,1:04:25.75,1:04:31.19,Default,,0000,0000,0000,,Тек жаулар мен одақтастар бар ұрыс алаңында пайда болады
Dialogue: 0,1:04:25.75,1:04:31.19,Default,,0000,0000,0000,,Үшінші солдат.➡
Dialogue: 0,1:04:31.19,1:04:35.98,Default,,0000,0000,0000,,«Бұл қарусыз солдат
Dialogue: 0,1:04:31.19,1:04:35.98,Default,,0000,0000,0000,,Бір ғана мақсат бар.➡
Dialogue: 0,1:04:35.98,1:04:39.82,Default,,0000,0000,0000,,Бұл жеңімпазға байланысты
Dialogue: 0,1:04:35.98,1:04:39.82,Default,,0000,0000,0000,,Аяусыз қарым-қатынастан➡
Dialogue: 0,1:04:39.82,1:04:42.57,Default,,0000,0000,0000,,Бұл жеңілгендерді қорғау туралы.”｡➡
Dialogue: 0,1:04:42.57,1:04:45.87,Default,,0000,0000,0000,,Иә, өз өмірбаянымда жаздым>
