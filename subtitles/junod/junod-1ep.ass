Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.08,0:00:07.58,Default,,0000,0000,0000,,<Хиросима қаласындағы Бейбітшілік мемориалдық саябағы.➡
Dialogue: 0,0:00:07.58,0:00:12.31,Default,,0000,0000,0000,,оның жанында
Dialogue: 0,0:00:07.58,0:00:12.31,Default,,0000,0000,0000,,Шетелдіктің ескерткіші бар.➡
Dialogue: 0,0:00:12.31,0:00:17.24,Default,,0000,0000,0000,,Бұл Марсель Гено, швейцариялық дәрігер.➡
Dialogue: 0,0:00:17.24,0:00:21.98,Default,,0000,0000,0000,,Соғыстың соңында Халықаралық Қызыл Крест комитеті
Dialogue: 0,0:00:17.24,0:00:21.98,Default,,0000,0000,0000,,Жапониядағы өкіл ретінде➡
Dialogue: 0,0:00:21.98,0:00:24.95,Default,,0000,0000,0000,,Атом бомбасынан зардап шеккен Хиросимаға кіру➡
Dialogue: 0,0:00:24.95,0:00:28.55,Default,,0000,0000,0000,,Ол бірінші шетелдік дәрігер болады.➡
Dialogue: 0,0:00:28.55,0:00:35.71,Default,,0000,0000,0000,,Джуно оны американдық әскерилерге берді.
Dialogue: 0,0:00:28.55,0:00:35.71,Default,,0000,0000,0000,,Дәрі-дәрмекпен медициналық қамтамасыз етеміз.➡
Dialogue: 0,0:00:35.71,0:00:38.66,Default,,0000,0000,0000,,Бұдан былай хабар тарату
Dialogue: 0,0:00:35.71,0:00:38.66,Default,,0000,0000,0000,,Анимациялық фильмдер➡
Dialogue: 0,0:00:38.66,0:00:43.06,Default,,0000,0000,0000,,Юноның өмірі
Dialogue: 0,0:00:38.66,0:00:43.06,Default,,0000,0000,0000,,Мынау мен сурет салдым>
Dialogue: 0,0:00:49.84,0:00:59.12,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:00:59.12,0:01:02.29,Default,,0000,0000,0000,,(ｱﾅｳﾝｽ)
Dialogue: 0,0:00:59.12,0:01:02.29,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:00:59.12,0:01:02.29,Default,,0000,0000,0000,,"Хиросима. Хиросима."
Dialogue: 0,0:01:02.29,0:01:40.89,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:40.89,0:01:44.69,Default,,0000,0000,0000,,Уау, керемет
Dialogue: 0,0:01:46.38,0:01:48.88,Default,,0000,0000,0000,,Үлкен өлшем
Dialogue: 0,0:01:46.38,0:01:48.88,Default,,0000,0000,0000,,Шағын өлшем бар.
Dialogue: 0,0:01:48.88,0:01:51.68,Default,,0000,0000,0000,,Бұл шетелден келеді.
Dialogue: 0,0:01:48.88,0:01:51.68,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:01:56.11,0:01:58.91,Default,,0000,0000,0000,,Сувенирлер
Dialogue: 0,0:01:56.11,0:01:58.91,Default,,0000,0000,0000,,Мен не сатып алуым керек?
Dialogue: 0,0:02:01.88,0:02:05.38,Rubi,,0000,0000,0000,,Mii
Dialogue: 0,0:02:01.88,0:02:05.38,Default,,0000,0000,0000,,Не болды, Мии?
Dialogue: 0,0:02:01.88,0:02:05.38,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:05.38,0:02:08.39,Default,,0000,0000,0000,,Тез кел, Мии.
Dialogue: 0,0:02:05.38,0:02:08.39,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:02:08.39,0:02:12.43,Default,,0000,0000,0000,,Мии!
Dialogue: 0,0:02:12.43,0:02:15.91,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,0:02:12.43,0:02:15.91,Default,,0000,0000,0000,,Жалғыз сен қалдың
Dialogue: 0,0:02:15.91,0:02:18.91,Default,,0000,0000,0000,,Не? А... иә!
Dialogue: 0,0:02:23.52,0:02:27.41,Rubi,,0000,0000,0000,,Юуко
Dialogue: 0,0:02:23.52,0:02:27.41,Default,,0000,0000,0000,,Иә, Сәлем!
Dialogue: 0,0:02:23.52,0:02:27.41,Default,,0000,0000,0000,,ﾁｰｽﾞ！
Dialogue: 0,0:02:27.41,0:02:30.84,Default,,0000,0000,0000,,Олай болса, тағы біреуі! Ах...
Dialogue: 0,0:02:30.84,0:02:34.34,Default,,0000,0000,0000,,(Ер оқушы А)
Dialogue: 0,0:02:30.84,0:02:34.34,Default,,0000,0000,0000,,Сөйлеуді тоқтатып, тез кет.
Dialogue: 0,0:02:30.84,0:02:34.34,Default,,0000,0000,0000,,Ол тағы да...
Dialogue: 0,0:02:35.97,0:02:40.07,Default,,0000,0000,0000,,(Қыз студент В)
Dialogue: 0,0:02:35.97,0:02:40.07,Default,,0000,0000,0000,,Юко! Жақында суретке түсіріңіз~
Dialogue: 0,0:02:35.97,0:02:40.07,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:02:47.61,0:02:50.81,Default,,0000,0000,0000,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:02:47.61,0:02:50.81,Default,,0000,0000,0000,,Неге күрсініп тұрсың?
Dialogue: 0,0:02:50.81,0:02:53.18,Default,,0000,0000,0000,,Ах Юко-чан
Dialogue: 0,0:02:50.81,0:02:53.18,Default,,0000,0000,0000,,Не болды? Миі
Dialogue: 0,0:02:53.18,0:02:56.32,Default,,0000,0000,0000,,Юко-чан…｡ Әсіресе
Dialogue: 0,0:02:56.32,0:02:59.39,Default,,0000,0000,0000,,Бұл бәрібір ақымақ нәрсе.
Dialogue: 0,0:02:59.39,0:03:03.03,Default,,0000,0000,0000,,Юко-чан сенің досың ба?
Dialogue: 0,0:02:59.39,0:03:03.03,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:03:03.03,0:03:07.36,Default,,0000,0000,0000,,Бұл қиындық туғызады.
Dialogue: 0,0:03:03.03,0:03:07.36,Default,,0000,0000,0000,,Саябақты өзім аралап жүрмін.
Dialogue: 0,0:03:07.36,0:03:10.25,Default,,0000,0000,0000,,Иә. Юко-чанға ұқсайды.\NМен
Dialogue: 0,0:03:10.25,0:03:15.92,Default,,0000,0000,0000,,-де көп нәрсені көрдім
Dialogue: 0,0:03:10.25,0:03:15.92,Default,,0000,0000,0000,,Шынымды айтсам, маған мағынасы жоқ.
Dialogue: 0,0:03:15.92,0:03:20.16,Default,,0000,0000,0000,,Соғыс туралы не айтса да
Dialogue: 0,0:03:15.92,0:03:20.16,Default,,0000,0000,0000,,Бұл баяғыда.
Dialogue: 0,0:03:20.16,0:03:24.10,Default,,0000,0000,0000,,Бұл қиын болған шығар.
Dialogue: 0,0:03:20.16,0:03:24.10,Default,,0000,0000,0000,,Оқулықта да солай делінген.
Dialogue: 0,0:03:24.10,0:03:29.45,Default,,0000,0000,0000,,Сен бұрынғыдай байсалдысың, Мии.
Dialogue: 0,0:03:24.10,0:03:29.45,Default,,0000,0000,0000,,Өйткені ол шынымен жазылған...
Dialogue: 0,0:03:29.45,0:03:32.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:29.45,0:03:32.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:32.86,0:03:36.56,Default,,0000,0000,0000,,Ол қандай тас ескерткіш?
Dialogue: 0,0:03:32.86,0:03:36.56,Default,,0000,0000,0000,,Келіңіздер...
Dialogue: 0,0:03:40.31,0:03:45.23,Default,,0000,0000,0000,,｢ﾄﾞｸﾀｰ ﾏﾙｾﾙ･ｼﾞｭﾉｰ｣｡
Dialogue: 0,0:03:40.31,0:03:45.23,Default,,0000,0000,0000,,Кім...? Ол не істеді?
Dialogue: 0,0:03:45.23,0:03:49.66,Default,,0000,0000,0000,,Не? Ал...
Dialogue: 0,0:03:45.23,0:03:49.66,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:03:49.66,0:03:54.26,Default,,0000,0000,0000,,Бұл бұрынғыдай...
Dialogue: 0,0:03:49.66,0:03:54.26,Default,,0000,0000,0000,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:03:57.28,0:03:59.28,Default,,0000,0000,0000,,(Көрермен) Оның стратегиясы болмады ма — жай ғана барып оны қоздырды?
Dialogue: 0,0:03:57.28,0:03:59.28,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:04:01.18,0:04:04.88,Default,,0000,0000,0000,,Уау! Аа!?
Dialogue: 0,0:04:06.69,0:04:11.19,Default,,0000,0000,0000,,Қандай азап…
Dialogue: 0,0:04:26.33,0:04:28.63,Default,,0000,0000,0000,,Уф... Бұл жақсы.
Dialogue: 0,0:04:31.41,0:04:37.37,Default,,0000,0000,0000,,Доктор Юно. Мен Женевадан қоңырау шалып жатырмын.
Dialogue: 0,0:04:31.41,0:04:37.37,Default,,0000,0000,0000,,Женевадан?
Dialogue: 0,0:04:37.37,0:04:40.07,Default,,0000,0000,0000,,Джуно ше?
Dialogue: 0,0:04:40.07,0:04:42.96,Default,,0000,0000,0000,,ұқсайды
Dialogue: 0,0:04:40.07,0:04:42.96,Default,,0000,0000,0000,,Рельефтен әлдеқайда жас болса да
Dialogue: 0,0:04:42.96,0:04:47.85,Default,,0000,0000,0000,,Дәлірек айтсақ, бұл не! Мұнда қайда?
Dialogue: 0,0:04:42.96,0:04:47.85,Default,,0000,0000,0000,,Бізге не болды?
Dialogue: 0,0:04:47.85,0:04:50.65,Default,,0000,0000,0000,,Не болса да...
Dialogue: 0,0:04:52.32,0:04:56.69,Default,,0000,0000,0000,,Эфиопияға!?
Dialogue: 0,0:04:52.32,0:04:56.69,Default,,0000,0000,0000,,Сіз кенеттен осындай бірдеңені айтып қалсаңыз да➡
Dialogue: 0,0:04:56.69,0:04:59.19,Default,,0000,0000,0000,,Мен әлі де стажермін...
Dialogue: 0,0:04:59.19,0:05:01.54,Default,,0000,0000,0000,,☎(Ер) Бұл менің дос ретінде өтінішім.➡
Dialogue: 0,0:05:01.54,0:05:05.98,Default,,0000,0000,0000,,Ресей балаларын құтқару
Dialogue: 0,0:05:01.54,0:05:05.98,Default,,0000,0000,0000,,Біз бірге жұмыс жасамадық па?
Dialogue: 0,0:05:05.98,0:05:09.92,Default,,0000,0000,0000,,Бұл дұрыс, бірақ...
Dialogue: 0,0:05:05.98,0:05:09.92,Default,,0000,0000,0000,,☎Бізге дәрігер керек.➡
Dialogue: 0,0:05:09.92,0:05:13.69,Default,,0000,0000,0000,,Жұм! Уф…
Dialogue: 0,0:05:09.92,0:05:13.69,Default,,0000,0000,0000,,Жас әрі құмар дәрігер.➡
Dialogue: 0,0:05:13.69,0:05:17.19,Default,,0000,0000,0000,,Қызыл Крест сіздің күшіңіз
Dialogue: 0,0:05:13.69,0:05:17.19,Default,,0000,0000,0000,,Маған керек!
Dialogue: 0,0:05:17.19,0:05:20.05,Default,,0000,0000,0000,,Қызыл Крест!?
Dialogue: 0,0:05:17.19,0:05:20.05,Default,,0000,0000,0000,,☎Өтінемін. Доктор Джуно!
Dialogue: 0,0:05:20.05,0:05:23.55,Default,,0000,0000,0000,,Хмм, Эфиопия...
Dialogue: 0,0:05:25.08,0:05:44.18,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:05:46.17,0:05:53.45,Default,,0000,0000,0000,,Қызыл Крест ұйымынан Эфиопияға жөнелтуді сұрау?
Dialogue: 0,0:05:46.17,0:05:53.45,Default,,0000,0000,0000,,Бұл да өте тосын оқиға.
Dialogue: 0,0:05:53.45,0:05:58.42,Default,,0000,0000,0000,,Иә. Жеткізу мерзімі ұзақ болса да
Dialogue: 0,0:05:53.45,0:05:58.42,Default,,0000,0000,0000,,Шамамен 6 ай болады деп ойлаймын➡
Dialogue: 0,0:05:58.42,0:06:02.12,Default,,0000,0000,0000,,(Есік ашылған дыбыс) Автоматты жазу қуыршақтарды даярлау мектебіне қош келдіңіздер
Dialogue: 0,0:05:58.42,0:06:02.12,Default,,0000,0000,0000,,Міне, нені үйренуге болады
Dialogue: 0,0:06:02.12,0:06:05.72,Default,,0000,0000,0000,,Содан кейін сізге
Dialogue: 0,0:06:02.12,0:06:05.72,Default,,0000,0000,0000,,Мен саған 6 ай демалыс беремін.
Dialogue: 0,0:06:05.72,0:06:08.21,Default,,0000,0000,0000,,Иә!? Директор
Dialogue: 0,0:06:05.72,0:06:08.21,Default,,0000,0000,0000,,ﾌﾌﾌﾌ｡
Dialogue: 0,0:06:08.21,0:06:12.35,Default,,0000,0000,0000,,Әлемді қараңыз Марсель
Dialogue: 0,0:06:12.35,0:06:16.99,Default,,0000,0000,0000,,Сізге
Dialogue: 0,0:06:12.35,0:06:16.99,Default,,0000,0000,0000,,Бұл жақсы тәжірибе болады
Dialogue: 0,0:06:16.99,0:06:21.47,Default,,0000,0000,0000,,«Әлем»... хаха
Dialogue: 0,0:06:21.47,0:06:23.98,Default,,0000,0000,0000,,Керемет~ Джуно
Dialogue: 0,0:06:23.98,0:06:28.61,Default,,0000,0000,0000,,Маған алты ай демалыс берілді.
Dialogue: 0,0:06:23.98,0:06:28.61,Default,,0000,0000,0000,,Тіпті Эфиопия
Dialogue: 0,0:06:28.61,0:06:32.72,Default,,0000,0000,0000,,Айтпақшы, Эфиопия қайда орналасқан?
Dialogue: 0,0:06:28.61,0:06:32.72,Default,,0000,0000,0000,,Тіпті олай емес!
Dialogue: 0,0:06:32.72,0:06:37.61,Default,,0000,0000,0000,,Шамасы, біз 70 жылдан астам уақыт бұрын
Dialogue: 0,0:06:32.72,0:06:37.61,Default,,0000,0000,0000,,Менің уақытым баяғыда сырғып кеткен сияқты.
Dialogue: 0,0:06:37.61,0:06:40.41,Default,,0000,0000,0000,,Және...
Dialogue: 0,0:06:37.61,0:06:40.41,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:06:42.08,0:06:44.08,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:47.08,0:06:51.24,Default,,0000,0000,0000,,Бізді ешкім байқамайды
Dialogue: 0,0:06:47.08,0:06:51.24,Default,,0000,0000,0000,,Мен оны көрмеймін, қолым тимейді!
Dialogue: 0,0:06:51.24,0:06:56.63,Default,,0000,0000,0000,,Не істеу керек!? Денеден тыс уақыт саяхатшысы болыңыз
Dialogue: 0,0:06:51.24,0:06:56.63,Default,,0000,0000,0000,,Біз айналдық
Dialogue: 0,0:06:56.63,0:07:01.28,Default,,0000,0000,0000,,Қызық емес сияқты
Dialogue: 0,0:06:56.63,0:07:01.28,Default,,0000,0000,0000,,Үйге қалай жететінімді де білмеймін.
Dialogue: 0,0:07:01.28,0:07:05.28,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:01.28,0:07:05.28,Default,,0000,0000,0000,,Онымен біраз уақыт ойнаңыз…｡ Уф~
Dialogue: 0,0:07:05.28,0:07:10.79,Default,,0000,0000,0000,,Маған үйге баратын жолды табу керек.
Dialogue: 0,0:07:05.28,0:07:10.79,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:07:10.79,0:07:16.49,Default,,0000,0000,0000,,Не, бұл сол кезден.
Dialogue: 0,0:07:10.79,0:07:16.49,Default,,0000,0000,0000,,Міне! Мені ұстаңыз Мии
Dialogue: 0,0:07:18.78,0:07:20.88,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:07:20.88,0:07:23.89,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:23.89,0:07:29.61,Default,,0000,0000,0000,,<Досының телефон қоңырауы және
Dialogue: 0,0:07:23.89,0:07:29.61,Default,,0000,0000,0000,,Директордың кеңесі бойынша➡
Dialogue: 0,0:07:29.61,0:07:35.40,Default,,0000,0000,0000,,Мен Халықаралық Қызыл Крест комитетінің мүшесімін.
Dialogue: 0,0:07:29.61,0:07:35.40,Default,,0000,0000,0000,,Мен диспетчер болып тағайындалдым.➡
Dialogue: 0,0:07:35.40,0:07:38.45,Default,,0000,0000,0000,,Алда қандай қиыншылық сапары күтіп тұр?
Dialogue: 0,0:07:35.40,0:07:38.45,Default,,0000,0000,0000,,Күтіп жүрсіз бе?➡
Dialogue: 0,0:07:38.45,0:07:41.75,Default,,0000,0000,0000,,Оған дейін білуге мүмкіндік болмады>
Dialogue: 0,0:07:47.34,0:07:52.15,Default,,0000,0000,0000,,<Штаб-пәтері Женевада
Dialogue: 0,0:07:47.34,0:07:52.15,Default,,0000,0000,0000,,Халықаралық Қызыл Крест Комитеті.➡
Dialogue: 0,0:07:52.15,0:07:56.89,Default,,0000,0000,0000,,Бірнеше қызметкер ғана жұмыс істейді
Dialogue: 0,0:07:52.15,0:07:56.89,Rubi,,0000,0000,0000,,Форт
Dialogue: 0,0:07:52.15,0:07:56.89,Default,,0000,0000,0000,,Осы шағын бекініске тиесілі қару-жарақ➡
Dialogue: 0,0:07:56.89,0:08:00.29,Default,,0000,0000,0000,,Екі ғана келісім болды>
Dialogue: 0,0:08:06.23,0:08:09.28,Default,,0000,0000,0000,,<Осы екі шарт және
Dialogue: 0,0:08:06.23,0:08:09.28,Default,,0000,0000,0000,,Бірнеше адаммен➡
Dialogue: 0,0:08:09.28,0:08:12.35,Default,,0000,0000,0000,,«Соғыс» деп аталатын үлкен жынға
Dialogue: 0,0:08:09.28,0:08:12.35,Default,,0000,0000,0000,,Оған қарсы тұру➡
Dialogue: 0,0:08:12.35,0:08:15.25,Default,,0000,0000,0000,,Бұл шынымен мүмкін бе?>
Dialogue: 0,0:08:15.25,0:08:18.76,Default,,0000,0000,0000,,Қызыл Крест миссиясын орындау
Dialogue: 0,0:08:15.25,0:08:18.76,Default,,0000,0000,0000,,Маңызды нәрселер:➡
Dialogue: 0,0:08:18.76,0:08:22.66,Default,,0000,0000,0000,,Басқалары да бар Доктор Джуно
Dialogue: 0,0:08:18.76,0:08:22.66,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:22.66,0:08:25.91,Default,,0000,0000,0000,,Бұл адамның жүрегі
Dialogue: 0,0:08:25.91,0:08:29.11,Default,,0000,0000,0000,,Адамның жүрегі...
Dialogue: 0,0:08:32.49,0:08:35.79,Default,,0000,0000,0000,,Адамның…
Dialogue: 0,0:08:32.49,0:08:35.79,Default,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:08:38.48,0:08:42.38,Default,,0000,0000,0000,,<Ресми халықаралық көмек көрсету персоналы
Dialogue: 0,0:08:38.48,0:08:42.38,Default,,0000,0000,0000,,Мен тағайындалдым➡
Dialogue: 0,0:08:42.38,0:08:47.18,Default,,0000,0000,0000,,Жанжалдан шайқалған Эфиопияға тағайындалдым>
Dialogue: 0,0:08:58.95,0:09:01.25,Default,,0000,0000,0000,,Уау! Мұнда қайда!?
Dialogue: 0,0:09:01.25,0:09:03.75,Default,,0000,0000,0000,,Уау... аа...
Dialogue: 0,0:09:03.75,0:09:07.49,Default,,0000,0000,0000,,Ал... әлі емес пе?
Dialogue: 0,0:09:03.75,0:09:07.49,Default,,0000,0000,0000,,Қызыл Крест ауруханалары
Dialogue: 0,0:09:07.49,0:09:12.61,Default,,0000,0000,0000,,Сөйлеспегеніңіз дұрыс, доктор.
Dialogue: 0,0:09:07.49,0:09:12.61,Default,,0000,0000,0000,,Тіліңді тістейсің.
Dialogue: 0,0:09:07.49,0:09:12.61,Default,,0000,0000,0000,,Олар жай ғана тірі қалуға тиіс емес.
Dialogue: 0,0:09:12.61,0:09:16.25,Default,,0000,0000,0000,,Доктор Джуно? Тағы да!?➡
Dialogue: 0,0:09:16.25,0:09:20.15,Default,,0000,0000,0000,,Неліктен сіз доктор Джуномен біргесіз?!
Dialogue: 0,0:09:30.58,0:09:34.68,Default,,0000,0000,0000,,(жүргізуші)
Dialogue: 0,0:09:30.58,0:09:34.68,Default,,0000,0000,0000,,Эфиопияға қош келдіңіз. Доктор Джуно
Dialogue: 0,0:09:36.30,0:09:51.78,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:09:51.78,0:09:54.75,Default,,0000,0000,0000,,Бұл аурухана ма? Мен сене алар емеспін
Dialogue: 0,0:09:54.75,0:09:59.94,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:09:54.75,0:09:59.94,Default,,0000,0000,0000,,Бұл Қызыл Крест далалық ауруханасы сияқты.
Dialogue: 0,0:09:59.94,0:10:03.20,Default,,0000,0000,0000,,Ағай, жаңа дәрігер?
Dialogue: 0,0:10:03.20,0:10:05.51,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:03.20,0:10:05.51,Default,,0000,0000,0000,,Сіз дәрігерсіз бе?
Dialogue: 0,0:10:05.51,0:10:08.55,Default,,0000,0000,0000,,Барлығына
Dialogue: 0,0:10:05.51,0:10:08.55,Default,,0000,0000,0000,,Сіз менің жарақатымды немесе ауруымды емдей аласыз ба?
Dialogue: 0,0:10:08.55,0:10:12.32,Default,,0000,0000,0000,,Ах. Бүгіннен бастап бұл орын.
Dialogue: 0,0:10:08.55,0:10:12.32,Default,,0000,0000,0000,,Бұл менің жұмыс орным.
Dialogue: 0,0:10:12.32,0:10:15.82,Default,,0000,0000,0000,,Барлығының көңіл-күйін көтеру
Dialogue: 0,0:10:12.32,0:10:15.82,Default,,0000,0000,0000,,Мен келдім
Dialogue: 0,0:10:15.82,0:10:20.65,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:10:15.82,0:10:20.65,Default,,0000,0000,0000,,Ағай, шынымен бәрі.
Dialogue: 0,0:10:15.82,0:10:20.65,Default,,0000,0000,0000,,Жағдайыңыз жақсы ма?
Dialogue: 0,0:10:20.65,0:10:22.75,Default,,0000,0000,0000,,О. Маған сеніңіз.
Dialogue: 0,0:10:22.75,0:10:27.49,Default,,0000,0000,0000,,Не десең де, мен
Dialogue: 0,0:10:22.75,0:10:27.49,Default,,0000,0000,0000,,Сиқыршы сияқты...
Dialogue: 0,0:10:27.49,0:10:30.52,Default,,0000,0000,0000,,ﾄﾞｸﾀｰ･ｼﾞｭﾉｰ？
Dialogue: 0,0:10:30.52,0:10:34.46,Default,,0000,0000,0000,,Мына арқанға қараңдар. Йо...
Dialogue: 0,0:10:34.46,0:10:38.38,Default,,0000,0000,0000,,Бұл арқан үшін бұл түйін
Dialogue: 0,0:10:34.46,0:10:38.38,Default,,0000,0000,0000,,Бұл ауру сияқты...
Dialogue: 0,0:10:38.38,0:10:43.40,Default,,0000,0000,0000,,Осыны бір сәтке ұстаңыз.
Dialogue: 0,0:10:38.38,0:10:43.40,Default,,0000,0000,0000,,Жүр, маған қара.
Dialogue: 0,0:10:43.40,0:10:46.92,Default,,0000,0000,0000,,«Әй, бұл түйін кетіп қалса
Dialogue: 0,0:10:43.40,0:10:46.92,Default,,0000,0000,0000,,Сіз өзіңізді жақсы сезінесіз.
Dialogue: 0,0:10:46.92,0:10:51.39,Default,,0000,0000,0000,,«Онда мен сені емдеймін.
Dialogue: 0,0:10:46.92,0:10:51.39,Default,,0000,0000,0000,,Көңіліңізді көтеруге рұқсат етіңіз».
Dialogue: 0,0:10:51.39,0:10:54.81,Default,,0000,0000,0000,,Чичинпипипи... Иә!
Dialogue: 0,0:10:54.81,0:11:00.55,Default,,0000,0000,0000,,(Балалар)
Dialogue: 0,0:10:54.81,0:11:00.55,Default,,0000,0000,0000,,Ах! О, керемет!
Dialogue: 0,0:11:00.55,0:11:06.55,Default,,0000,0000,0000,,Мен доктор Джуномын
Dialogue: 0,0:11:00.55,0:11:06.55,Default,,0000,0000,0000,,Барлығыңызға рахмет
Dialogue: 0,0:11:17.35,0:11:21.32,Default,,0000,0000,0000,,Улы газ. Императорлық газ?
Dialogue: 0,0:11:21.32,0:11:26.04,Default,,0000,0000,0000,,<Иперит газы. Байланыс сәті
Dialogue: 0,0:11:21.32,0:11:26.04,Default,,0000,0000,0000,,Ауырсынбайды➡
Dialogue: 0,0:11:26.04,0:11:28.96,Default,,0000,0000,0000,,баяу
Dialogue: 0,0:11:26.04,0:11:28.96,Default,,0000,0000,0000,,Теріге әсер етеді.➡
Dialogue: 0,0:11:28.96,0:11:32.97,Default,,0000,0000,0000,,Оның әсері киімге, былғарыға, резеңкеге де қатысты.
Dialogue: 0,0:11:28.96,0:11:32.97,Default,,0000,0000,0000,,Енеді.➡
Dialogue: 0,0:11:32.97,0:11:37.41,Default,,0000,0000,0000,,Ластанған киімді мүмкіндігінше тезірек шешіңіз
Dialogue: 0,0:11:32.97,0:11:37.41,Default,,0000,0000,0000,,Киімдерді шешу керек.➡
Dialogue: 0,0:11:37.41,0:11:42.56,Default,,0000,0000,0000,,Қорғау үшін арнайы түрлерін қолданыңыз
Dialogue: 0,0:11:37.41,0:11:42.56,Default,,0000,0000,0000,,Қорғаныс маскалары мен киімдері қажет>
Dialogue: 0,0:11:42.56,0:11:46.25,Default,,0000,0000,0000,,Кальций хлориді
Dialogue: 0,0:11:42.56,0:11:46.25,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:46.25,0:11:50.30,Default,,0000,0000,0000,,Калий перманганатының ерітіндісі ше?
Dialogue: 0,0:11:46.25,0:11:50.30,Default,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:50.30,0:11:54.66,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:50.30,0:11:54.66,Default,,0000,0000,0000,,Алкоголь туралы не айтасыз? Этел...бензен де жақсы
Dialogue: 0,0:11:54.66,0:11:58.88,Default,,0000,0000,0000,,Иә, бар.
Dialogue: 0,0:11:54.66,0:11:58.88,Default,,0000,0000,0000,,Жақсы
Dialogue: 0,0:11:58.88,0:12:05.98,Default,,0000,0000,0000,,Бірақ бұл жеткіліксіз деп ойлаймын. Қызыл Крестке.
Dialogue: 0,0:11:58.88,0:12:05.98,Default,,0000,0000,0000,,Біз көмекке қажетті заттарды сұрауымыз керек.
Dialogue: 0,0:12:05.98,0:12:08.82,Default,,0000,0000,0000,,Келгенше...
Dialogue: 0,0:12:08.82,0:12:13.49,Default,,0000,0000,0000,,Біз не істеуіміз керек, доктор Джуно?
Dialogue: 0,0:12:08.82,0:12:13.49,Default,,0000,0000,0000,,Барлығына көмектес, Джуно-сан
Dialogue: 0,0:12:13.49,0:12:15.59,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:12:18.41,0:12:22.58,Default,,0000,0000,0000,,Иперит суда ериді.
Dialogue: 0,0:12:18.41,0:12:22.58,Default,,0000,0000,0000,,Алғашқы көмек көрсету шаралары➡
Dialogue: 0,0:12:22.58,0:12:25.47,Default,,0000,0000,0000,,Осы ыстық су мен сабынмен
Dialogue: 0,0:12:22.58,0:12:25.47,Default,,0000,0000,0000,,Оны жуыңыз
Dialogue: 0,0:12:25.47,0:12:30.53,Default,,0000,0000,0000,,Жақсы. Бұл жақсы.
Dialogue: 0,0:12:25.47,0:12:30.53,Default,,0000,0000,0000,,Доктор Джуно күткендей.
Dialogue: 0,0:12:30.53,0:12:33.76,Default,,0000,0000,0000,,Бірақ неліктен улы газ?
Dialogue: 0,0:12:30.53,0:12:33.76,Default,,0000,0000,0000,,Ол себілді ме?
Dialogue: 0,0:12:33.76,0:12:39.15,Default,,0000,0000,0000,,Соғыс болғандықтан шығар.
Dialogue: 0,0:12:33.76,0:12:39.15,Default,,0000,0000,0000,,Біз мұнда соғысып жатырмыз.
Dialogue: 0,0:12:39.15,0:12:42.96,Default,,0000,0000,0000,,Бірақ Қызыл Крест ауруханасы бар.
Dialogue: 0,0:12:39.15,0:12:42.96,Default,,0000,0000,0000,,Әзірге қауіпсіз.
Dialogue: 0,0:12:42.96,0:12:47.13,Default,,0000,0000,0000,,Ә? Шынында ма?
Dialogue: 0,0:12:42.96,0:12:47.13,Default,,0000,0000,0000,,Сіз оны фильмнен немесе теледидардан көрдіңіз бе?
Dialogue: 0,0:12:47.13,0:12:51.68,Default,,0000,0000,0000,,Соғыс кезінде де Қызыл Крест нысандары
Dialogue: 0,0:12:47.13,0:12:51.68,Default,,0000,0000,0000,,Шабуыл жасамаңыз➡
Dialogue: 0,0:12:51.68,0:12:55.05,Default,,0000,0000,0000,,Тіпті дүниенің ережелері
Dialogue: 0,0:12:51.68,0:12:55.05,Default,,0000,0000,0000,,Иә~ Дұрыс.
Dialogue: 0,0:12:55.05,0:12:58.05,Default,,0000,0000,0000,,Бұл қауіпсіз.
Dialogue: 0,0:13:06.24,0:13:08.34,Default,,0000,0000,0000,,Жоқ...!
Dialogue: 0,0:13:18.12,0:13:20.32,Default,,0000,0000,0000,,(бомба дыбысы)
Dialogue: 0,0:13:22.56,0:13:28.98,Default,,0000,0000,0000,,<Женева конвенциясымен қорғалуы керек
Dialogue: 0,0:13:22.56,0:13:28.98,Default,,0000,0000,0000,,Демалу оңай бұзылды>
Dialogue: 0,0:13:28.98,0:13:41.48,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:13:41.48,0:13:44.32,Default,,0000,0000,0000,,<Осы екінші Эфиопия соғысында➡
Dialogue: 0,0:13:44.32,0:13:50.16,Default,,0000,0000,0000,,Адамзат тарихындағы бірінші ретсіз бомбалау
Dialogue: 0,0:13:44.32,0:13:50.16,Default,,0000,0000,0000,,Орындалды>
Dialogue: 0,0:13:50.16,0:13:55.08,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:50.16,0:13:55.08,Default,,0000,0000,0000,,(Оқ атылған дыбыс)
Dialogue: 0,0:13:55.08,0:14:05.89,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:14:05.89,0:14:08.67,Default,,0000,0000,0000,,<Соғыс одан сайын күшейе түседі➡
Dialogue: 0,0:14:08.67,0:14:15.48,Default,,0000,0000,0000,,Тіпті Қызыл Крест нысандары мен керек-жарақтары
Dialogue: 0,0:14:08.67,0:14:15.48,Default,,0000,0000,0000,,Шабуыл нысанасына айналды>
Dialogue: 0,0:14:15.48,0:14:49.98,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:14:49.98,0:14:52.58,Default,,0000,0000,0000,,Танжиро~!
Dialogue: 0,0:14:52.58,0:14:57.08,Default,,0000,0000,0000,,Неге... неге...
Dialogue: 0,0:14:59.49,0:15:02.71,Default,,0000,0000,0000,,Неліктен? Егер Қызыл Крест
Dialogue: 0,0:14:59.49,0:15:02.71,Default,,0000,0000,0000,,Бұл қауіпсіз емес пе?
Dialogue: 0,0:15:02.71,0:15:04.71,Default,,0000,0000,0000,,Неліктен? Неге!?
Dialogue: 0,0:15:04.71,0:15:07.15,Default,,0000,0000,0000,,Мен білмеймін...
Dialogue: 0,0:15:04.71,0:15:07.15,Default,,0000,0000,0000,,Мен де түсінбеймін!
Dialogue: 0,0:15:07.15,0:15:09.85,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:15:32.56,0:15:35.69,Default,,0000,0000,0000,,Сіз тамаша жұмыс жасадыңыз. Қазір бәрі жақсы.
Dialogue: 0,0:15:35.69,0:15:39.21,Default,,0000,0000,0000,,Рақмет сізге доктор Джуно
Dialogue: 0,0:15:39.21,0:15:41.22,Default,,0000,0000,0000,,Сау болыңыз
Dialogue: 0,0:15:41.22,0:15:45.89,Default,,0000,0000,0000,,Жақсы
Dialogue: 0,0:15:41.22,0:15:45.89,Default,,0000,0000,0000,,Шынымен. Бір уақытта
Dialogue: 0,0:15:41.22,0:15:45.89,Default,,0000,0000,0000,,Не болар екен деп ойладым.
Dialogue: 0,0:15:45.89,0:15:48.47,Default,,0000,0000,0000,,Бірақ жақсы ма?
Dialogue: 0,0:15:45.89,0:15:48.47,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:15:48.47,0:15:52.48,Default,,0000,0000,0000,,Бұл Доктор Джуно.
Dialogue: 0,0:15:48.47,0:15:52.48,Default,,0000,0000,0000,,Мен үзіліссіз емделіп жүрмін.
Dialogue: 0,0:15:52.48,0:15:57.85,Default,,0000,0000,0000,,Ойланып көрейікші, иә.
Dialogue: 0,0:15:52.48,0:15:57.85,Default,,0000,0000,0000,,Жұмыс болғандықтан тым көп жұмыс істеу
Dialogue: 0,0:15:57.85,0:16:01.45,Default,,0000,0000,0000,,Уф... аа~
Dialogue: 0,0:16:05.27,0:16:07.77,Default,,0000,0000,0000,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:16:14.48,0:16:18.09,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:16:18.09,0:16:20.82,Default,,0000,0000,0000,,Қандай сурет?
Dialogue: 0,0:16:20.82,0:16:24.26,Default,,0000,0000,0000,,Джуноныкі шығар
Dialogue: 0,0:16:20.82,0:16:24.26,Default,,0000,0000,0000,,Бұл отбасылық сурет емес пе?
Dialogue: 0,0:16:24.26,0:16:28.40,Default,,0000,0000,0000,,Әй, бұл сондай сезім!
Dialogue: 0,0:16:24.26,0:16:28.40,Default,,0000,0000,0000,,Бұл бала Джуно мырза емес пе?
Dialogue: 0,0:16:28.40,0:16:31.12,Default,,0000,0000,0000,,Аа, дұрыс. Сондай сүйкімді!
Dialogue: 0,0:16:31.12,0:16:33.42,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:16:31.12,0:16:33.42,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:16:35.84,0:16:38.44,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:16:46.01,0:16:50.49,Default,,0000,0000,0000,,Мынаны пайдаланыңыз
Dialogue: 0,0:16:46.01,0:16:50.49,Default,,0000,0000,0000,,О...
Dialogue: 0,0:16:50.49,0:16:55.49,Default,,0000,0000,0000,,Бірақ, пастор мырза, кешіріңіз.
Dialogue: 0,0:16:50.49,0:16:55.49,Default,,0000,0000,0000,,Қарызға алсаң да, қайтаратын ештеңем жоқ...
Dialogue: 0,0:16:55.49,0:16:59.19,Default,,0000,0000,0000,,Бұл кез келген уақытта жақсы.
Dialogue: 0,0:16:55.49,0:16:59.19,Default,,0000,0000,0000,,Балаңызға көбірек➡
Dialogue: 0,0:16:59.19,0:17:01.68,Default,,0000,0000,0000,,Дәмді нәрсе
Dialogue: 0,0:16:59.19,0:17:01.68,Default,,0000,0000,0000,,Мені тамақтандырыңыз
Dialogue: 0,0:17:01.68,0:17:05.88,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:17:01.68,0:17:05.88,Default,,0000,0000,0000,,Сондықтан сақ болыңыз
Dialogue: 0,0:17:07.69,0:17:10.44,Default,,0000,0000,0000,,Әке!
Dialogue: 0,0:17:07.69,0:17:10.44,Default,,0000,0000,0000,,Марсельге не болды?
Dialogue: 0,0:17:10.44,0:17:14.64,Default,,0000,0000,0000,,Неліктен? неге
Dialogue: 0,0:17:10.44,0:17:14.64,Default,,0000,0000,0000,,Сіз басқаларға қарыз бересіз бе?
Dialogue: 0,0:17:14.64,0:17:19.08,Default,,0000,0000,0000,,Үй
Dialogue: 0,0:17:14.64,0:17:19.08,Default,,0000,0000,0000,,Сізде сонша ақша жоқ, солай ма?
Dialogue: 0,0:17:19.08,0:17:23.55,Default,,0000,0000,0000,,Тыңда, Марсель. Жақсылық жасасаң,
Dialogue: 0,0:17:19.08,0:17:23.55,Default,,0000,0000,0000,,Мен біреуге сенімдімін ...
Dialogue: 0,0:17:23.55,0:17:26.99,Default,,0000,0000,0000,,Құдай қарап тұр
Dialogue: 0,0:17:23.55,0:17:26.99,Default,,0000,0000,0000,,Құдай?
Dialogue: 0,0:17:26.99,0:17:30.74,Default,,0000,0000,0000,,Ах. Сонымен сен де.
Dialogue: 0,0:17:26.99,0:17:30.74,Default,,0000,0000,0000,,Егер біреу мұқтаж болса➡
Dialogue: 0,0:17:30.74,0:17:36.11,Default,,0000,0000,0000,,Қолыңызды созыңыз.
Dialogue: 0,0:17:30.74,0:17:36.11,Default,,0000,0000,0000,,Өйткені мұны тек сіз жасай аласыз.
Dialogue: 0,0:17:36.11,0:17:42.82,Default,,0000,0000,0000,,Қол жеткізу...
Dialogue: 0,0:17:36.11,0:17:42.82,Default,,0000,0000,0000,,Мен не істей аламын
Dialogue: 0,0:17:42.82,0:17:46.93,Default,,0000,0000,0000,,Джуноның балалық шағы туралы бірдеңе.
Dialogue: 0,0:17:42.82,0:17:46.93,Default,,0000,0000,0000,,Сіз келген сияқтысыз.
Dialogue: 0,0:17:42.82,0:17:46.93,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:17:46.93,0:17:51.13,Default,,0000,0000,0000,,Қалай болғанда да, Джуноның әкесі
Dialogue: 0,0:17:46.93,0:17:51.13,Default,,0000,0000,0000,,Сіз біртүрлі адам сияқтысыз.
Dialogue: 0,0:17:51.13,0:17:54.62,Default,,0000,0000,0000,,Дұрыс. Бейтаныс адамға
Dialogue: 0,0:17:51.13,0:17:54.62,Default,,0000,0000,0000,,Қарызға ақша бермеу➡
Dialogue: 0,0:17:54.62,0:17:56.92,Default,,0000,0000,0000,,Егер сіз оны қайтармасаңыз
Dialogue: 0,0:17:54.62,0:17:56.92,Default,,0000,0000,0000,,Біз не істейміз?
Dialogue: 0,0:17:56.92,0:17:59.62,Default,,0000,0000,0000,,Не істеуім керек...
Dialogue: 0,0:17:56.92,0:17:59.62,Default,,0000,0000,0000,,Біз не істейміз?
Dialogue: 0,0:17:59.62,0:18:01.92,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:18:07.58,0:18:11.75,Default,,0000,0000,0000,,Жүрек үні
Dialogue: 0,0:18:07.58,0:18:11.75,Default,,0000,0000,0000,,Мен ол кісіге қарызға ақша беруім керек.
Dialogue: 0,0:18:07.58,0:18:11.75,Default,,0000,0000,0000,,Көбірек…｡ Бірақ бәрібір…
Dialogue: 0,0:18:11.75,0:18:14.19,Default,,0000,0000,0000,,≪(Әйел) Джуно-сан
Dialogue: 0,0:18:11.75,0:18:14.19,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:18:14.19,0:18:16.79,Default,,0000,0000,0000,,Азық-түлік
Dialogue: 0,0:18:14.19,0:18:16.79,Default,,0000,0000,0000,,Мен тым көп жасадым.➡
Dialogue: 0,0:18:16.79,0:18:21.19,Default,,0000,0000,0000,,Қаласаңыз, солай жасаңыз.
Dialogue: 0,0:18:16.79,0:18:21.19,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:18:21.19,0:18:23.59,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:18:27.38,0:18:30.69,Default,,0000,0000,0000,,Әке!
Dialogue: 0,0:18:27.38,0:18:30.69,Default,,0000,0000,0000,,Құдай осыны көріп тұр ма?
Dialogue: 0,0:18:30.69,0:18:34.36,Default,,0000,0000,0000,,Тіпті солай. Қолыңызды созыңыз.
Dialogue: 0,0:18:30.69,0:18:34.36,Default,,0000,0000,0000,,Сіз не істей аласыз➡
Dialogue: 0,0:18:34.36,0:18:39.48,Default,,0000,0000,0000,,Егер сіз мұны жасасаңыз, ол міндетті түрде пішінін өзгертеді.
Dialogue: 0,0:18:34.36,0:18:39.48,Default,,0000,0000,0000,,Бұл сізге қайтарылатын нәрсе.
Dialogue: 0,0:18:39.48,0:18:44.38,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:18:39.48,0:18:44.38,Default,,0000,0000,0000,,Маған да тәнті болды.
Dialogue: 0,0:18:44.38,0:18:46.68,Default,,0000,0000,0000,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:18:50.47,0:18:52.76,Default,,0000,0000,0000,,Мені көп жұмыс істеуге мәжбүрлейтін нәрсе – ➡
Dialogue: 0,0:18:52.76,0:18:57.68,Default,,0000,0000,0000,,Әке сөзі
Dialogue: 0,0:18:52.76,0:18:57.68,Default,,0000,0000,0000,,Мен оның болғанына сенімдімін
Dialogue: 0,0:18:57.68,0:19:02.12,Default,,0000,0000,0000,,Бірақ солай сақтаңыз
Dialogue: 0,0:18:57.68,0:19:02.12,Default,,0000,0000,0000,,Сіз істеп жатқан нәрсе таңқаларлық болуы мүмкін
Dialogue: 0,0:18:57.68,0:19:02.12,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:02.12,0:19:06.67,Default,,0000,0000,0000,,Өйткені мен өте
Dialogue: 0,0:19:02.12,0:19:06.67,Default,,0000,0000,0000,,Мен бұған еліктей алмаймын.
Dialogue: 0,0:19:06.67,0:19:10.78,Default,,0000,0000,0000,,Иә. Әрине
Dialogue: 0,0:19:06.67,0:19:10.78,Default,,0000,0000,0000,,Бұл оңай емес, солай ма?
Dialogue: 0,0:19:10.78,0:19:17.10,Default,,0000,0000,0000,,Және соғыс кезінде
Dialogue: 0,0:19:10.78,0:19:17.10,Default,,0000,0000,0000,,Бұл мүмкін емес...
Dialogue: 0,0:19:17.10,0:19:22.10,Default,,0000,0000,0000,,<Эфиопия соғысы аяқталды.➡
Dialogue: 0,0:19:22.10,0:19:24.71,Default,,0000,0000,0000,,Мен Женеваға оралдым және бұл жолы ➡
Dialogue: 0,0:19:24.71,0:19:29.61,Default,,0000,0000,0000,,Испанияда азамат соғысы басталды.
Dialogue: 0,0:19:24.71,0:19:29.61,Default,,0000,0000,0000,,Жіберілді>
Dialogue: 0,0:19:31.71,0:19:35.48,Default,,0000,0000,0000,,<Азаматтық соғыста
Dialogue: 0,0:19:31.71,0:19:35.48,Default,,0000,0000,0000,,Шекараның арғы жағындағы соғысу сияқты➡
Dialogue: 0,0:19:35.48,0:19:39.49,Default,,0000,0000,0000,,Айқын ұрыс сызығы болған жоқ>
Dialogue: 0,0:19:39.49,0:19:41.69,Default,,0000,0000,0000,,(ﾉｯｸ)
Dialogue: 0,0:19:43.46,0:19:46.75,Default,,0000,0000,0000,,Жеке куәлік
Dialogue: 0,0:19:43.46,0:19:46.75,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:19:46.75,0:19:54.45,Default,,0000,0000,0000,,<Сансыз жауап алу және
Dialogue: 0,0:19:46.75,0:19:54.45,Default,,0000,0000,0000,,Бұл азамат соғысының шындығы болды>
Dialogue: 0,0:19:56.15,0:20:02.04,Default,,0000,0000,0000,,Хмм... аа... Тек тексеру.
Dialogue: 0,0:19:56.15,0:20:02.04,Default,,0000,0000,0000,,Бұл неше рет болды?
Dialogue: 0,0:20:02.04,0:20:06.41,Default,,0000,0000,0000,,Ал, мен сенімдімін 140...
Dialogue: 0,0:20:02.04,0:20:06.41,Default,,0000,0000,0000,,Мұқият санаудың қажеті жоқ.
Dialogue: 0,0:20:06.41,0:20:08.41,Default,,0000,0000,0000,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:20:14.59,0:20:19.59,Default,,0000,0000,0000,,<Бір елде ойлау тәсілі мен
Dialogue: 0,0:20:14.59,0:20:19.59,Default,,0000,0000,0000,,Этникалық және таптық айырмашылықтар, т.б.➡
Dialogue: 0,0:20:19.59,0:20:24.12,Default,,0000,0000,0000,,Әртүрлі себептермен
Dialogue: 0,0:20:19.59,0:20:24.12,Default,,0000,0000,0000,,Олар одақтас және жау болып бөлініп, соғысты.➡
Dialogue: 0,0:20:24.12,0:20:29.14,Default,,0000,0000,0000,,Және олардың талаптарының айырмашылығына байланысты
Dialogue: 0,0:20:24.12,0:20:29.14,Default,,0000,0000,0000,,Әрбір көрші тұтқынға айналады➡
Dialogue: 0,0:20:29.14,0:20:34.28,Default,,0000,0000,0000,,Орындалу керек
Dialogue: 0,0:20:29.14,0:20:34.28,Default,,0000,0000,0000,,Қайғылы жағдай орын алды>
Dialogue: 0,0:20:34.28,0:20:43.52,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:20:43.52,0:20:59.12,Default,,0000,0000,0000,,(аяқ дыбыстары)
Dialogue: 0,0:21:02.99,0:21:06.09,Default,,0000,0000,0000,,Бұл тағы да сенсің. Доктор Джуно
Dialogue: 0,0:21:06.09,0:21:08.41,Default,,0000,0000,0000,,Қайта-қайта келемін
Dialogue: 0,0:21:08.41,0:21:12.61,Default,,0000,0000,0000,,Республикашылдар мен франкоистер
Dialogue: 0,0:21:08.41,0:21:12.61,Default,,0000,0000,0000,,Екі жақтағы тұтқындар алмасылғанға дейін.
Dialogue: 0,0:21:12.61,0:21:15.25,Default,,0000,0000,0000,,Оны жек көрушілікке қалдырыңыз
Dialogue: 0,0:21:12.61,0:21:15.25,Default,,0000,0000,0000,,Егер тұтқындар өлім жазасына кесілсе➡
Dialogue: 0,0:21:15.25,0:21:18.69,Default,,0000,0000,0000,,Әрине, дәл солай
Dialogue: 0,0:21:15.25,0:21:18.69,Default,,0000,0000,0000,,Бұл жерде де орындалады.
Dialogue: 0,0:21:18.69,0:21:22.34,Default,,0000,0000,0000,,Бұл өшпенділік тізбегі
Dialogue: 0,0:21:18.69,0:21:22.34,Default,,0000,0000,0000,,Кесілген болуы керек
Dialogue: 0,0:21:22.34,0:21:25.64,Default,,0000,0000,0000,,Егер сіз көп жұмыс істеуге дайын болсаңыз
Dialogue: 0,0:21:22.34,0:21:25.64,Default,,0000,0000,0000,,Бұл менің тілегім➡
Dialogue: 0,0:21:25.64,0:21:28.41,Default,,0000,0000,0000,,Оның орындалатынына сенімдімін
Dialogue: 0,0:21:25.64,0:21:28.41,Default,,0000,0000,0000,,Мен сенемін
Dialogue: 0,0:21:28.41,0:21:30.73,Default,,0000,0000,0000,,Қараңдар! Джуно да
Dialogue: 0,0:21:28.41,0:21:30.73,Default,,0000,0000,0000,,Менің айтып тұрғаным осы
Dialogue: 0,0:21:30.73,0:21:33.35,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:21:30.73,0:21:33.35,Default,,0000,0000,0000,,Тұтқындарға тез көмектесейік.
Dialogue: 0,0:21:33.35,0:21:37.39,Default,,0000,0000,0000,,Бірақ біз
Dialogue: 0,0:21:33.35,0:21:37.39,Default,,0000,0000,0000,,Тіпті тұтқындарды босатуға келісесіз➡
Dialogue: 0,0:21:37.39,0:21:40.36,Default,,0000,0000,0000,,Ақымақ франкистер
Dialogue: 0,0:21:37.39,0:21:40.36,Default,,0000,0000,0000,,Міндетті емес
Dialogue: 0,0:21:40.36,0:21:44.01,Default,,0000,0000,0000,,Иә! Мұндай ақымақ келіссөздер
Dialogue: 0,0:21:40.36,0:21:44.01,Default,,0000,0000,0000,,Мен жауап бере алмаймын!
Dialogue: 0,0:21:44.01,0:21:46.18,Default,,0000,0000,0000,,Бізді республикашылдар мазақ етпеңдер!
Dialogue: 0,0:21:46.18,0:21:50.39,Default,,0000,0000,0000,,Франко мектебінен
Dialogue: 0,0:21:46.18,0:21:50.39,Default,,0000,0000,0000,,130 тұтқынның босатылуына жауап ретінде➡
Dialogue: 0,0:21:50.39,0:21:52.37,Default,,0000,0000,0000,,Уәде алды
Dialogue: 0,0:21:52.37,0:21:57.93,Default,,0000,0000,0000,,Қалғаны сенсің.
Dialogue: 0,0:21:52.37,0:21:57.93,Default,,0000,0000,0000,,Тек республикашылдар шешеді!
Dialogue: 0,0:21:57.93,0:22:02.40,Default,,0000,0000,0000,,А, мен қатты ашуландым! Неге бір сөз?
Dialogue: 0,0:21:57.93,0:22:02.40,Default,,0000,0000,0000,,Жарайды деп айта алмайсың!
Dialogue: 0,0:22:02.40,0:22:04.42,Default,,0000,0000,0000,,Сабыр ет, Юко-чан
Dialogue: 0,0:22:04.42,0:22:06.95,Default,,0000,0000,0000,,Бізге Қызыл Крестке сеніңіз
Dialogue: 0,0:22:06.95,0:22:10.57,Default,,0000,0000,0000,,Қызыл Крест арқылы
Dialogue: 0,0:22:06.95,0:22:10.57,Default,,0000,0000,0000,,Мен тұтқын алмасуды аяқтағым келеді.
Dialogue: 0,0:22:10.57,0:22:14.99,Default,,0000,0000,0000,,Бірақ азамат соғысында
Dialogue: 0,0:22:10.57,0:22:14.99,Default,,0000,0000,0000,,Женева конвенциясы қолданылмайды
Dialogue: 0,0:22:14.99,0:22:20.08,Default,,0000,0000,0000,,Қызыл Крест болса да
Dialogue: 0,0:22:14.99,0:22:20.08,Default,,0000,0000,0000,,Сіз бізге араласпауыңыз керек.
Dialogue: 0,0:22:20.08,0:22:23.75,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:22:20.08,0:22:23.75,Default,,0000,0000,0000,,Солай көрінеді.
Dialogue: 0,0:22:23.75,0:22:27.21,Default,,0000,0000,0000,,Әлі де I
Dialogue: 0,0:22:23.75,0:22:27.21,Default,,0000,0000,0000,,Мен адамдарға көмектескім келеді
Dialogue: 0,0:22:27.21,0:22:30.21,Default,,0000,0000,0000,,Адам ретінде!
Dialogue: 0,0:22:33.09,0:22:37.52,Default,,0000,0000,0000,,<Қызыл Крест позициясын еңсерді
Dialogue: 0,0:22:33.09,0:22:37.52,Default,,0000,0000,0000,,Джуно мырзаның шағымы бойынша...>
Dialogue: 0,0:22:43.74,0:22:50.54,Default,,0000,0000,0000,,Жарты күн…?
Dialogue: 0,0:22:57.39,0:23:02.24,Default,,0000,0000,0000,,Сіз қызық адамсыз.
Dialogue: 0,0:22:57.39,0:23:02.24,Default,,0000,0000,0000,,Испания балансында➡
Dialogue: 0,0:23:02.24,0:23:06.14,Default,,0000,0000,0000,,Екеуін теңестіруге тырысу
Dialogue: 0,0:23:02.24,0:23:06.14,Default,,0000,0000,0000,,Барлық жерде ұшу➡
Dialogue: 0,0:23:06.14,0:23:09.08,Default,,0000,0000,0000,,Доктор Джуноға ешкім еліктей алмайды.
Dialogue: 0,0:23:09.08,0:23:13.22,Default,,0000,0000,0000,,Егер менің бір жағында 10 тұтқын болса,
Dialogue: 0,0:23:09.08,0:23:13.22,Default,,0000,0000,0000,,Екінші жағынан➡
Dialogue: 0,0:23:13.22,0:23:16.65,Default,,0000,0000,0000,,Мені 10 тұтқынға айырбастауыңызды өтінемін.
Dialogue: 0,0:23:13.22,0:23:16.65,Default,,0000,0000,0000,,Мен жай ғана сұрадым.
Dialogue: 0,0:23:16.65,0:23:21.25,Default,,0000,0000,0000,,және көптеген адамдардың өмірін сақтайды
Dialogue: 0,0:23:16.65,0:23:21.25,Default,,0000,0000,0000,,Ол өте мейірімді адам.
Dialogue: 0,0:23:31.05,0:23:34.02,Default,,0000,0000,0000,,ﾄﾞｸﾀｰ･ｼﾞｭﾉｰ！
Dialogue: 0,0:23:31.05,0:23:34.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:23:34.02,0:23:39.08,Default,,0000,0000,0000,,ﾄﾞｸﾀｰ･ｼﾞｭﾉｰ｡
Dialogue: 0,0:23:34.02,0:23:39.08,Default,,0000,0000,0000,,Біздің отбасымыз... Біздің отбасымыз➡
Dialogue: 0,0:23:39.08,0:23:42.91,Default,,0000,0000,0000,,Мені міндетті түрде қайтаруыңызды өтінемін!
Dialogue: 0,0:23:42.91,0:23:47.11,Default,,0000,0000,0000,,Сенің әрекетің тым балалық… немесе жай ғана қысқа көзді.
Dialogue: 0,0:23:42.91,0:23:47.11,Default,,0000,0000,0000,,Мен сенімен міндетті түрде қайтамын!
Dialogue: 0,0:23:53.11,0:23:57.71,Default,,0000,0000,0000,,Барлығыңыз күтіңіздер!
Dialogue: 0,0:23:53.11,0:23:57.71,Default,,0000,0000,0000,,Мен отбасымды үйге әкелемін!
Dialogue: 0,0:23:57.71,0:23:59.71,Default,,0000,0000,0000,,Барлығы оны асыға күтеді.
Dialogue: 0,0:23:59.71,0:24:04.51,Default,,0000,0000,0000,,Маған қалдырыңыз! мұнда
Dialogue: 0,0:23:59.71,0:24:04.51,Default,,0000,0000,0000,,Себебі Джуно мырза осында.
Dialogue: 0,0:24:09.26,0:24:14.86,Default,,0000,0000,0000,,<Бірақ бұл уәде
Dialogue: 0,0:24:09.26,0:24:14.86,Default,,0000,0000,0000,,Орындалмаған>
Dialogue: 0,0:24:25.76,0:24:28.89,Default,,0000,0000,0000,,Неліктен!?
Dialogue: 0,0:24:25.76,0:24:28.89,Default,,0000,0000,0000,,Республикашылар уәде етілгендей➡
Dialogue: 0,0:24:28.89,0:24:32.68,Default,,0000,0000,0000,,Мен тұтқындарды босатуға келістім.
Dialogue: 0,0:24:28.89,0:24:32.68,Default,,0000,0000,0000,,Сонда сіз де...
Dialogue: 0,0:24:32.68,0:24:37.14,Default,,0000,0000,0000,,Иә, бізде бұрыннан бар
Dialogue: 0,0:24:32.68,0:24:37.14,Default,,0000,0000,0000,,Көптеген кепілге алынғандарды босатқан
Dialogue: 0,0:24:37.14,0:24:41.41,Default,,0000,0000,0000,,Бірақ ешкім жоқ
Dialogue: 0,0:24:37.14,0:24:41.41,Default,,0000,0000,0000,,Ол үйге барғысы келмейді.
Dialogue: 0,0:24:41.41,0:24:45.34,Default,,0000,0000,0000,,Әрине, Бильбаодан
Dialogue: 0,0:24:41.41,0:24:45.34,Default,,0000,0000,0000,,Менің ойымша, бұл ыңғайлырақ.
Dialogue: 0,0:24:45.34,0:24:47.43,Default,,0000,0000,0000,,Ақымақ республикашылардан жақсы.
Dialogue: 0,0:24:47.43,0:24:50.45,Default,,0000,0000,0000,,Міне, бастаймын!
Dialogue: 0,0:24:47.43,0:24:50.45,Default,,0000,0000,0000,,Мұндай ақымақпен уәде➡
Dialogue: 0,0:24:50.45,0:24:53.89,Default,,0000,0000,0000,,Әу бастан ештеңе бұрынғыдай емес.
Dialogue: 0,0:24:50.45,0:24:53.89,Default,,0000,0000,0000,,ﾌﾌﾌﾌ｡
Dialogue: 0,0:24:53.89,0:24:57.91,Default,,0000,0000,0000,,Қорқынышты!
Dialogue: 0,0:24:53.89,0:24:57.91,Default,,0000,0000,0000,,Басынан бастап
Dialogue: 0,0:24:53.89,0:24:57.91,Default,,0000,0000,0000,,Сіз уәдеңізді бұзуды жоспарлағансыз!
Dialogue: 0,0:24:57.91,0:25:18.74,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:25:18.74,0:25:21.68,Default,,0000,0000,0000,,Сіз уәде бердіңіз!
Dialogue: 0,0:25:18.74,0:25:21.68,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:25:21.68,0:25:26.42,Default,,0000,0000,0000,,Сіз қайтып келемін дедіңіз!
Dialogue: 0,0:25:21.68,0:25:26.42,Default,,0000,0000,0000,,Сіз өтірікшісіз!
Dialogue: 0,0:25:26.42,0:25:30.62,Default,,0000,0000,0000,,Сәлем! Бірдене айтыңыз!
Dialogue: 0,0:25:32.26,0:25:36.48,Default,,0000,0000,0000,,Өтірікші!
Dialogue: 0,0:25:32.26,0:25:36.48,Default,,0000,0000,0000,,Қызыл крест ренжітеді!
Dialogue: 0,0:25:36.48,0:25:39.85,Default,,0000,0000,0000,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:25:36.48,0:25:39.85,Default,,0000,0000,0000,,Бұл пайдасыз Қызыл Крест!
Dialogue: 0,0:25:39.85,0:25:42.45,Default,,0000,0000,0000,,Өтірікші!
Dialogue: 0,0:25:45.94,0:25:49.12,Default,,0000,0000,0000,,Жоқ... Джуно-сан кінәлі емес!
Dialogue: 0,0:25:45.94,0:25:49.12,Default,,0000,0000,0000,,Mii
Dialogue: 0,0:25:49.12,0:25:51.51,Default,,0000,0000,0000,,Джуно-сан мүлде жаман емес!
Dialogue: 0,0:25:51.51,0:25:55.25,Default,,0000,0000,0000,,Барлығына лайықты
Dialogue: 0,0:25:51.51,0:25:55.25,Default,,0000,0000,0000,,Сіз қолыңыздан келгеннің бәрін жасадыңыз!
Dialogue: 0,0:25:55.25,0:25:58.85,Default,,0000,0000,0000,,Бұл мүлдем басқа!
Dialogue: 0,0:25:55.25,0:25:58.85,Default,,0000,0000,0000,,(Каэбуки) Күтпегендей, дайындықты ескерсек, аса әсерлі болған жоқ.
Dialogue: 0,0:25:58.85,0:26:02.75,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:25:58.85,0:26:02.75,Default,,0000,0000,0000,,Джуно мырза барлығына арналған...
Dialogue: 0,0:26:10.81,0:26:13.21,Default,,0000,0000,0000,,Бұл көздер...
Dialogue: 0,0:26:19.49,0:26:22.16,Default,,0000,0000,0000,,(А оқушы қыз)
Dialogue: 0,0:26:19.49,0:26:22.16,Default,,0000,0000,0000,,Еске алу
Dialogue: 0,0:26:19.49,0:26:22.16,Default,,0000,0000,0000,,Ол тітіркендіргіш, солай емес пе?
Dialogue: 0,0:26:22.16,0:26:24.14,Default,,0000,0000,0000,,Иә? Негізі мен де
Dialogue: 0,0:26:24.14,0:26:26.83,Default,,0000,0000,0000,,(Қыз студент D)
Dialogue: 0,0:26:24.14,0:26:26.83,Default,,0000,0000,0000,,Дұрыс. Соған ұқсас, солай емес пе?
Dialogue: 0,0:26:26.83,0:26:30.15,Default,,0000,0000,0000,,Қараңғы емес пе?
Dialogue: 0,0:26:30.15,0:26:32.85,Default,,0000,0000,0000,,Мен Егер солай болса
Dialogue: 0,0:26:30.15,0:26:32.85,Default,,0000,0000,0000,,Мен өмір сүре алмаймын
Dialogue: 0,0:26:32.85,0:26:35.35,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:26:39.49,0:26:41.89,Default,,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:26:46.75,0:26:50.82,Default,,0000,0000,0000,,Ол кезде... Дәл солай
Dialogue: 0,0:26:50.82,0:26:52.92,Default,,0000,0000,0000,,Мен дұрыс шоғырлана алмай жатырмын—
Dialogue: 0,0:26:57.19,0:27:01.99,Default,,0000,0000,0000,,Мен... мен... мен...
Dialogue: 0,0:27:04.22,0:27:06.72,Default,,0000,0000,0000,,Сол кездегі көздер
Dialogue: 0,0:27:06.72,0:27:10.02,Default,,0000,0000,0000,,Джуно-сан кінәлі емес. Кінәлі менмін.
Dialogue: 0,0:27:10.02,0:27:16.78,Default,,0000,0000,0000,,Мен ол кезде ештеңе айта алмадым.
Dialogue: 0,0:27:10.02,0:27:16.78,Default,,0000,0000,0000,,Ештеңе істей алмағаны үшін менің кінәм.
Dialogue: 0,0:27:16.78,0:27:19.15,Default,,0000,0000,0000,,Mii. Сен не туралы айтып тұрсың?
Dialogue: 0,0:27:19.15,0:27:21.15,Default,,0000,0000,0000,,Сол кезде...
Dialogue: 0,0:27:19.15,0:27:21.15,Default,,0000,0000,0000,,Mii
Dialogue: 0,0:27:21.15,0:27:39.48,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:27:39.48,0:27:43.24,Default,,0000,0000,0000,,Ха ха ха ха...
Dialogue: 0,0:27:39.48,0:27:43.24,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:27:43.24,0:27:53.84,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:27:55.65,0:28:00.25,Default,,0000,0000,0000,,Мен оны тыңдағаныңызды қалаймын.
Dialogue: 0,0:27:55.65,0:28:00.25,Default,,0000,0000,0000,,Мазасыздықтар бар
Dialogue: 0,0:28:03.16,0:28:05.73,Default,,0000,0000,0000,,Бұл неше рет болды? Доктор Джуно
Dialogue: 0,0:28:05.73,0:28:10.00,Default,,0000,0000,0000,,Қанша рет қаласаңыз, сонша рет
Dialogue: 0,0:28:05.73,0:28:10.00,Default,,0000,0000,0000,,Мен уәде бердім
Dialogue: 0,0:28:10.00,0:28:14.20,Default,,0000,0000,0000,,Тұтқындармен алмасуды жүзеге асыру
Dialogue: 0,0:28:10.00,0:28:14.20,Default,,0000,0000,0000,,Көптеген адамдардың өмірін құтқару
Dialogue: 0,0:28:14.20,0:28:17.22,Default,,0000,0000,0000,,Сіз табанды адамсыз.
Dialogue: 0,0:28:17.22,0:28:22.21,Default,,0000,0000,0000,,Иә. Ең біріншіден.
Dialogue: 0,0:28:17.22,0:28:22.21,Default,,0000,0000,0000,,Біздің жаңа сиқырлы амалдарымызды қараңыз...
Dialogue: 0,0:28:17.22,0:28:22.21,Default,,0000,0000,0000,,Қ-Қандай?
Dialogue: 0,0:28:22.21,0:28:27.22,Default,,0000,0000,0000,,Бүгін менмін
Dialogue: 0,0:28:22.21,0:28:27.22,Default,,0000,0000,0000,,Мен сендерге сиқырлы трюк көрсетейін
Dialogue: 0,0:28:27.22,0:28:29.98,Default,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:28:27.22,0:28:29.98,Default,,0000,0000,0000,,Бұл... Ах!
Dialogue: 0,0:28:29.98,0:28:37.58,Default,,0000,0000,0000,,Жарты күн…?
Dialogue: 0,0:28:39.64,0:28:43.78,Default,,0000,0000,0000,,Тұтқындарды айырбастауға арналған тізім мен құжаттар.
Dialogue: 0,0:28:43.78,0:28:48.28,Default,,0000,0000,0000,,Иә. Сіздің сиқырыңызға.
Dialogue: 0,0:28:43.78,0:28:48.28,Default,,0000,0000,0000,,Мен сізге қатысуға рұқсат етемін, доктор Джуно.
Dialogue: 0,0:28:51.57,0:28:56.59,Default,,0000,0000,0000,,Ах… Ах…
Dialogue: 0,0:28:56.59,0:28:58.59,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:29:04.72,0:29:09.14,Default,,0000,0000,0000,,Иә, бәріңіз тынышталыңыздар.
Dialogue: 0,0:29:04.72,0:29:09.14,Default,,0000,0000,0000,,Сабыр сақтаңыз және сапқа тұрыңыз.
Dialogue: 0,0:29:09.14,0:29:14.16,Default,,0000,0000,0000,,Біріншіден, Луиза ханым
Dialogue: 0,0:29:09.14,0:29:14.16,Default,,0000,0000,0000,,Митчелл-чан. Анна-чан
Dialogue: 0,0:29:14.16,0:29:18.66,Default,,0000,0000,0000,,Сіз тамаша жұмыс жасадыңыз. Үйге қош келдіңіз.
Dialogue: 0,0:29:21.39,0:29:24.09,Default,,0000,0000,0000,,О...
Dialogue: 0,0:29:24.09,0:29:27.09,Default,,0000,0000,0000,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,0:29:24.09,0:29:27.09,Default,,0000,0000,0000,,Жылдам болшы! Уақыт машинасын көпке дейін сол жерде қалдыра алмаймын.
Dialogue: 0,0:29:31.01,0:29:33.01,Default,,0000,0000,0000,,Сен!
Dialogue: 0,0:29:38.39,0:29:42.62,Default,,0000,0000,0000,,(аяқ дыбыстары)
Dialogue: 0,0:29:38.39,0:29:42.62,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:29:42.62,0:29:47.11,Default,,0000,0000,0000,,(қуаныш)
Dialogue: 0,0:29:47.11,0:29:53.62,Default,,0000,0000,0000,,Иә! Әсерлі кездесу
Dialogue: 0,0:29:47.11,0:29:53.62,Default,,0000,0000,0000,,Иә! бәрі бақытты
Dialogue: 0,0:29:53.62,0:29:58.42,Default,,0000,0000,0000,,Жүрек үні
Dialogue: 0,0:29:53.62,0:29:58.42,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:29:53.62,0:29:58.42,Default,,0000,0000,0000,,Сіз жеңдіңіз, доктор Джуно.
Dialogue: 0,0:30:03.09,0:30:06.58,Default,,0000,0000,0000,,<Осы ащы тәжірибеден сабақ алдым.➡
Dialogue: 0,0:30:06.58,0:30:11.54,Default,,0000,0000,0000,,Әскери тұтқындардың өмірін қалай құтқаруға болады
Dialogue: 0,0:30:06.58,0:30:11.54,Default,,0000,0000,0000,,Шыдамдылық пен әрекет қажет.➡
Dialogue: 0,0:30:11.54,0:30:14.46,Default,,0000,0000,0000,,Қалай опасыздық жасады
Dialogue: 0,0:30:11.54,0:30:14.46,Default,,0000,0000,0000,,Түсінбесеңіз де➡
Dialogue: 0,0:30:14.46,0:30:17.56,Default,,0000,0000,0000,,Қалай болғанда да
Dialogue: 0,0:30:14.46,0:30:17.56,Default,,0000,0000,0000,,Жүгіруді жалғастыру керек>
Dialogue: 0,0:30:20.81,0:30:26.92,Default,,0000,0000,0000,,<Әскери тұтқындарды емдеуді жақсарту үшін табандылық танытамын.
Dialogue: 0,0:30:20.81,0:30:26.92,Default,,0000,0000,0000,,Ынталандырылған алмасу.➡
Dialogue: 0,0:30:26.92,0:30:33.82,Default,,0000,0000,0000,,Нәтижесінде әскери тұтқындар өлім жазасына кесілді
Dialogue: 0,0:30:26.92,0:30:33.82,Default,,0000,0000,0000,,Мыңдаған адамның өмірін сақтап қалуға болады>
Dialogue: 0,0:30:37.11,0:30:41.65,Default,,0000,0000,0000,,<1939 ж. Екінші дүниежүзілік соғыс басталады.➡
Dialogue: 0,0:30:41.65,0:30:46.42,Default,,0000,0000,0000,,Мен Халықаралық Қызыл Крест комитетінің мүшесімін.
Dialogue: 0,0:30:41.65,0:30:46.42,Default,,0000,0000,0000,,Халықаралық көмек қызметкері ретінде➡
Dialogue: 0,0:30:46.42,0:30:50.09,Default,,0000,0000,0000,,Бүкіл Еуропа бойынша
Dialogue: 0,0:30:46.42,0:30:50.09,Default,,0000,0000,0000,,Айналада ұшып шықтым.➡
Dialogue: 0,0:30:50.09,0:30:53.14,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,0:30:50.09,0:30:53.14,Default,,0000,0000,0000,,Елдер тұтқындарды алмастыру үшін көп жұмыс істеді.➡
Dialogue: 0,0:30:53.14,0:30:57.48,Default,,0000,0000,0000,,Кейде Германия мен Франция арасында
Dialogue: 0,0:30:53.14,0:30:57.48,Default,,0000,0000,0000,,10 күннен кейін бару➡
Dialogue: 0,0:30:57.48,0:31:01.72,Default,,0000,0000,0000,,Тұтқынға түскен француз солдаттарын өлтіру
Dialogue: 0,0:30:57.48,0:31:01.72,Default,,0000,0000,0000,,Біз де оны тоқтата алдық.➡
Dialogue: 0,0:31:01.72,0:31:06.74,Default,,0000,0000,0000,,Бірақ соғыс жалыны
Dialogue: 0,0:31:01.72,0:31:06.74,Default,,0000,0000,0000,,Дүние жүзіне тараған.➡
Dialogue: 0,0:31:06.74,0:31:08.74,Default,,0000,0000,0000,,Және…>
Dialogue: 0,0:31:16.02,0:31:18.22,Default,,0000,0000,0000,,(Оқ атылған дыбыс)
Dialogue: 0,0:31:21.39,0:31:25.83,Default,,0000,0000,0000,,Не!? Тұтқындар мен олардың отбасыларына
Dialogue: 0,0:31:21.39,0:31:25.83,Default,,0000,0000,0000,,Менің карта жазғанымды қалайсың ба?
Dialogue: 0,0:31:25.83,0:31:31.58,Default,,0000,0000,0000,,Дұрыс. Тұтқындарға аты-жөніңізді айтыңыз және
Dialogue: 0,0:31:25.83,0:31:31.58,Default,,0000,0000,0000,,Осы картаға мекенжайыңызды жазыңыз➡
Dialogue: 0,0:31:31.58,0:31:37.47,Default,,0000,0000,0000,,Қызыл Крест, Женева арқылы
Dialogue: 0,0:31:31.58,0:31:37.47,Default,,0000,0000,0000,,Оны отбасыңызға жіберіңіз. Бұл қарапайым.
Dialogue: 0,0:31:37.47,0:31:43.56,Default,,0000,0000,0000,,Алайда, Женева конвенциясына сәйкес, әскери тұтқындар
Dialogue: 0,0:31:37.47,0:31:43.56,Default,,0000,0000,0000,,Сіз өзіңіздің отбасыңызға ашық хаттар жібере аласыз.
Dialogue: 0,0:31:43.56,0:31:45.88,Default,,0000,0000,0000,,Қатынасты үзу ме? Қатынасты үзу... Хе-хе-хе-хе.
Dialogue: 0,0:31:43.56,0:31:45.88,Default,,0000,0000,0000,,Отбасы мүшелері хабарсыз кетті➡
Dialogue: 0,0:31:45.88,0:31:50.62,Default,,0000,0000,0000,,Мекенжайыңызды өзгертсеңіз де
Dialogue: 0,0:31:45.88,0:31:50.62,Default,,0000,0000,0000,,Бұл біздің жауапкершілігіміз емес.➡
Dialogue: 0,0:31:50.62,0:31:55.29,Default,,0000,0000,0000,,Бұл тіпті шартта да жоқ.
Dialogue: 0,0:31:50.62,0:31:55.29,Default,,0000,0000,0000,,Нақтылаудың қажеті жоқ деп ойлаймын
Dialogue: 0,0:31:55.29,0:31:57.29,Default,,0000,0000,0000,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:31:57.29,0:32:01.98,Default,,0000,0000,0000,,Мыңдаған ашық хаттар адресаттарына ешқашан жетпейді
Dialogue: 0,0:31:57.29,0:32:01.98,Default,,0000,0000,0000,,Әскери тұтқындар да, олардың отбасылары да➡
Dialogue: 0,0:32:01.98,0:32:06.02,Default,,0000,0000,0000,,Байланыс мүмкін емес
Dialogue: 0,0:32:01.98,0:32:06.02,Default,,0000,0000,0000,,Мазасыздықтан зардап шегу
Dialogue: 0,0:32:06.02,0:32:12.02,Default,,0000,0000,0000,,Аа, көп ескертпелер
Dialogue: 0,0:32:06.02,0:32:12.02,Default,,0000,0000,0000,,Бұл қандай жадынама?
Dialogue: 0,0:32:14.98,0:32:19.98,Default,,0000,0000,0000,,Хмм... Мен оны жақсы оқи алмаймын.
Dialogue: 0,0:32:14.98,0:32:19.98,Default,,0000,0000,0000,,Бұл мекенжайға ұқсайды.
Dialogue: 0,0:32:21.88,0:32:24.45,Default,,0000,0000,0000,,Бірақ тіпті бұл карталар алмасу
Dialogue: 0,0:32:21.88,0:32:24.45,Default,,0000,0000,0000,,Үміттенемін➡
Dialogue: 0,0:32:24.45,0:32:26.75,Default,,0000,0000,0000,,Бұл алаңдаушылықтар да шешіледі.
Dialogue: 0,0:32:26.75,0:32:31.88,Default,,0000,0000,0000,,Пошта поштаны тасымалдайды.
Dialogue: 0,0:32:26.75,0:32:31.88,Default,,0000,0000,0000,,Біздің жұмыс емес!
Dialogue: 0,0:32:31.88,0:32:35.50,Default,,0000,0000,0000,,Және мұндай қиындық
Dialogue: 0,0:32:31.88,0:32:35.50,Default,,0000,0000,0000,,Мен оны киюім керек➡
Dialogue: 0,0:32:35.50,0:32:38.65,Default,,0000,0000,0000,,Женева конвенциясына
Dialogue: 0,0:32:35.50,0:32:38.65,Default,,0000,0000,0000,,Мен бір ауыз сөз жазған жоқпын.
Dialogue: 0,0:32:38.65,0:32:43.19,Default,,0000,0000,0000,,Тыңдау. Шарт бойынша... Ах.
Dialogue: 0,0:32:43.19,0:32:45.56,Default,,0000,0000,0000,,Не істеу керек!
Dialogue: 0,0:32:45.56,0:32:51.26,Default,,0000,0000,0000,,Шарт Киелі кітап емес
Dialogue: 0,0:32:45.56,0:32:51.26,Default,,0000,0000,0000,,Шарттың рухы маңызды.
Dialogue: 0,0:32:53.98,0:32:57.15,Default,,0000,0000,0000,,Бұл өте әсерлі көрінеді.
Dialogue: 0,0:32:53.98,0:32:57.15,Default,,0000,0000,0000,,Джуно мырза
Dialogue: 0,0:32:57.15,0:32:59.15,Default,,0000,0000,0000,,Жақсы... бұл дұрыс.
Dialogue: 0,0:32:59.15,0:33:03.64,Default,,0000,0000,0000,,<Осылайша Женеваның Қызыл Кресті
Dialogue: 0,0:32:59.15,0:33:03.64,Default,,0000,0000,0000,,Медиатор ретінде әрекет ету➡
Dialogue: 0,0:33:03.64,0:33:06.56,Default,,0000,0000,0000,,Әскери тұтқындар мен олардың отбасылары арасында
Dialogue: 0,0:33:03.64,0:33:06.56,Default,,0000,0000,0000,,Карталарды ауыстыруға болады➡
Dialogue: 0,0:33:06.56,0:33:13.15,Default,,0000,0000,0000,,Еуропадағы байланыс жүйесі
Dialogue: 0,0:33:06.56,0:33:13.15,Default,,0000,0000,0000,,Қызыл Крест байланысы орнатылды>
Dialogue: 0,0:33:13.15,0:33:30.18,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:33:30.18,0:33:32.72,Default,,0000,0000,0000,,А...
Dialogue: 0,0:33:32.72,0:33:37.81,Default,,0000,0000,0000,,(жылау)
Dialogue: 0,0:33:37.81,0:33:41.45,Default,,0000,0000,0000,,Бұл махаббат ұшағы
Dialogue: 0,0:33:37.81,0:33:41.45,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:33:41.45,0:33:47.48,Default,,0000,0000,0000,,<Бұл карта менің отбасым үшін көпір болды.
Dialogue: 0,0:33:41.45,0:33:47.48,Default,,0000,0000,0000,,5 миллионнан астам хат алмасылды.➡
Dialogue: 0,0:33:47.48,0:33:53.68,Default,,0000,0000,0000,,Бірақ сізге не істеу керек
Dialogue: 0,0:33:47.48,0:33:53.68,Default,,0000,0000,0000,,Көп болды>
Dialogue: 0,0:33:55.64,0:33:58.08,Default,,0000,0000,0000,,<Әртүрлі тұтқындар лагерлеріне бару.➡
Dialogue: 0,0:33:58.08,0:34:02.88,Default,,0000,0000,0000,,Олардың емделуін жақсартуды мақсат ету
Dialogue: 0,0:33:58.08,0:34:02.88,Default,,0000,0000,0000,,Сендіруді жалғастыру>
Dialogue: 0,0:34:05.62,0:34:08.61,Default,,0000,0000,0000,,<Қосымша медициналық мақсаттағы бұйымдар және т.б.
Dialogue: 0,0:34:05.62,0:34:08.61,Default,,0000,0000,0000,,Тасымалдау➡
Dialogue: 0,0:34:08.61,0:34:12.71,Default,,0000,0000,0000,,Қызыл Крест көлік кемелері және
Dialogue: 0,0:34:08.61,0:34:12.71,Default,,0000,0000,0000,,Қауіпсіз тасымалдау бағыттары.➡
Dialogue: 0,0:34:12.71,0:34:16.98,Default,,0000,0000,0000,,Соғыс салдарынан жоқшылықтан зардап шеккендерге
Dialogue: 0,0:34:12.71,0:34:16.98,Default,,0000,0000,0000,,Көмек құралдарын жіберу➡
Dialogue: 0,0:34:16.98,0:34:23.58,Default,,0000,0000,0000,,Жалғастырылған қолдау шаралары
Dialogue: 0,0:34:16.98,0:34:23.58,Default,,0000,0000,0000,,Жұмыс бітпейтін еді>
Dialogue: 0,0:34:27.83,0:34:30.08,Default,,0000,0000,0000,,(ﾉｯｸ)
Dialogue: 0,0:34:30.08,0:34:34.11,Default,,0000,0000,0000,,≪ﾐｽﾀｰ ｼﾞｭﾉｰ｡
Dialogue: 0,0:34:30.08,0:34:34.11,Default,,0000,0000,0000,,Оны ашыңыз, Джуно мырза.
Dialogue: 0,0:34:34.11,0:34:38.39,Default,,0000,0000,0000,,Осы құжатқа қол қою...
Dialogue: 0,0:34:38.39,0:34:44.96,Default,,0000,0000,0000,,(Ұйқыда)
Dialogue: 0,0:34:44.96,0:34:48.96,Default,,0000,0000,0000,,Осылай қарады
Dialogue: 0,0:34:44.96,0:34:48.96,Default,,0000,0000,0000,,Бала сияқты
Dialogue: 0,0:34:44.96,0:34:48.96,Default,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:34:48.96,0:34:53.95,Default,,0000,0000,0000,,Бірақ неге? Неліктен?
Dialogue: 0,0:34:48.96,0:34:53.95,Default,,0000,0000,0000,,Бұл кісінің қолынан осыншама көп нәрсе бар ма деп ойлаймын.
Dialogue: 0,0:34:53.95,0:34:58.35,Default,,0000,0000,0000,,Мен түсінуге мүмкіндік жоқ.
Dialogue: 0,0:34:53.95,0:34:58.35,Default,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:35:10.42,0:35:12.49,Default,,0000,0000,0000,,Бұл таңқаларлық, солай емес пе?
Dialogue: 0,0:35:12.49,0:35:15.92,Default,,0000,0000,0000,,Бірақ түптеп келгенде бұл мағынасыз, солай емес пе?
Dialogue: 0,0:35:12.49,0:35:15.92,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:35:15.92,0:35:19.66,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:35:15.92,0:35:19.66,Default,,0000,0000,0000,,Иә? Ах...
Dialogue: 0,0:35:19.66,0:36:20.55,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:36:20.55,0:36:24.76,Default,,0000,0000,0000,,(Жаңбыр дыбысы)
Dialogue: 0,0:36:24.76,0:36:28.26,Default,,0000,0000,0000,,Эй...｡ Ах~!
Dialogue: 0,0:36:28.26,0:36:55.06,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:36:55.06,0:37:01.16,Default,,0000,0000,0000,,Бұл не? Жалғыз қанша тырыссам да
Dialogue: 0,0:36:55.06,0:37:01.16,Default,,0000,0000,0000,,Бұл ештеңені білдірмейді.
Dialogue: 0,0:37:03.68,0:37:05.68,Default,,0000,0000,0000,,Еске алу
Dialogue: 0,0:37:03.68,0:37:05.68,Default,,0000,0000,0000,,Ақымақ болма!
Dialogue: 0,0:37:05.68,0:37:08.25,Default,,0000,0000,0000,,(Ер оқушы В)
Dialogue: 0,0:37:05.68,0:37:08.25,Default,,0000,0000,0000,,Бұл ұят!
Dialogue: 0,0:37:05.68,0:37:08.25,Default,,0000,0000,0000,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,0:37:08.25,0:37:11.04,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:37:08.25,0:37:11.04,Default,,0000,0000,0000,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:37:11.04,0:37:13.06,Default,,0000,0000,0000,,Бұл туралы алаңдамаңыз!
Dialogue: 0,0:37:13.06,0:37:16.43,Default,,0000,0000,0000,,Эй, сен кіммен сөйлесіп тұрсың!?
Dialogue: 0,0:37:16.43,0:37:18.81,Default,,0000,0000,0000,,(Генри) Құрметті қыздар мен жігіттер, аралық емтихандар ақыры келесі аптадан кейінгі аптада өтеді.
Dialogue: 0,0:37:16.43,0:37:18.81,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:37:18.81,0:37:23.28,Default,,0000,0000,0000,,Сіз мұны жасадыңыз!
Dialogue: 0,0:37:18.81,0:37:23.28,Default,,0000,0000,0000,,Сонымен не болды!
Dialogue: 0,0:37:23.28,0:37:26.95,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:37:23.28,0:37:26.95,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:37:26.95,0:37:30.42,Default,,0000,0000,0000,,Тоқта десем де
Dialogue: 0,0:37:26.95,0:37:30.42,Default,,0000,0000,0000,,Мен сұрамаймын...
Dialogue: 0,0:37:30.42,0:37:33.43,Default,,0000,0000,0000,,Неліктен төбелес көп?
Dialogue: 0,0:37:30.42,0:37:33.43,Default,,0000,0000,0000,,Менің ойымша, сіз мұны істеп жатырсыз.
Dialogue: 0,0:37:33.43,0:37:36.53,Default,,0000,0000,0000,,Жарайды, мен оны жай қалдыруым керек шығар.
Dialogue: 0,0:37:38.15,0:37:44.02,Default,,0000,0000,0000,,Алдыңыздағы адамға қанша көмектессеңіз де
Dialogue: 0,0:37:38.15,0:37:44.02,Default,,0000,0000,0000,,Соғыс ешқашан аяқталмайды
Dialogue: 0,0:37:44.02,0:37:47.62,Default,,0000,0000,0000,,Қанша тырыссаң да пайдасы жоқ.
Dialogue: 0,0:37:56.38,0:38:02.94,Default,,0000,0000,0000,,<1945 ж. Халықаралық Қызыл Крест комитеті
Dialogue: 0,0:37:56.38,0:38:02.94,Default,,0000,0000,0000,,Мен Жапониядағы Бас өкіл болып тағайындалдым➡
Dialogue: 0,0:38:02.94,0:38:05.03,Default,,0000,0000,0000,,Жапонияға бет алды.➡
Dialogue: 0,0:38:05.03,0:38:10.18,Default,,0000,0000,0000,,Алайда жапон әскерлері елге тікелей кіреді.
Dialogue: 0,0:38:05.03,0:38:10.18,Default,,0000,0000,0000,,Олар маған рұқсат бермеді>
Dialogue: 0,0:38:10.18,0:38:13.85,Default,,0000,0000,0000,,Жарты күн…?
Dialogue: 0,0:38:13.85,0:38:19.32,Default,,0000,0000,0000,,< Токиоға бағытталған нәтиже
Dialogue: 0,0:38:13.85,0:38:19.32,Default,,0000,0000,0000,,Каирден Сібір мен Маньчжурия арқылы➡
Dialogue: 0,0:38:19.32,0:38:23.64,Rubi,,0000,0000,0000,,Укай
Dialogue: 0,0:38:19.32,0:38:23.64,Default,,0000,0000,0000,,Өте айналмалы жол
Dialogue: 0,0:38:19.32,0:38:23.64,Default,,0000,0000,0000,,Орындауға тура келді >
Dialogue: 0,0:38:23.64,0:38:28.67,Default,,0000,0000,0000,,Бұл жақсы фото. Бұл сіздің әйеліңіз бе?
Dialogue: 0,0:38:28.67,0:38:33.30,Default,,0000,0000,0000,,Ах... иә. Бұл менің әйелім Евгений.
Dialogue: 0,0:38:33.30,0:38:38.06,Default,,0000,0000,0000,,Сол Қызыл Крест қызметкерлері
Dialogue: 0,0:38:33.30,0:38:38.06,Default,,0000,0000,0000,,Өткен жылдың маусым айында үйлендік.
Dialogue: 0,0:38:38.06,0:38:41.75,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:38:38.06,0:38:41.75,Default,,0000,0000,0000,,Көңілді көрінеді, күлімсірейді
Dialogue: 0,0:38:41.75,0:38:46.95,Default,,0000,0000,0000,,Қай заманда болсаң да, Бақытты ұмытпа.
Dialogue: 0,0:38:41.75,0:38:46.95,Default,,0000,0000,0000,,Бұл дұрыс емес. Иә иә
Dialogue: 0,0:38:46.95,0:38:51.66,Default,,0000,0000,0000,,Сонымен…
Dialogue: 0,0:38:46.95,0:38:51.66,Default,,0000,0000,0000,,Қай дәуір болса да
Dialogue: 0,0:38:51.66,0:38:54.27,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:38:54.27,0:38:58.78,Default,,0000,0000,0000,,Қай заманда болмасын...
Dialogue: 0,0:38:54.27,0:38:58.78,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:38:58.78,0:39:01.35,Default,,0000,0000,0000,,Жарты күн…?
Dialogue: 0,0:39:01.35,0:39:04.32,Default,,0000,0000,0000,,<Токиоға ұмтылу
Dialogue: 0,0:39:01.35,0:39:04.32,Default,,0000,0000,0000,,Құрлықта жүргенде➡
Dialogue: 0,0:39:04.32,0:39:09.06,Default,,0000,0000,0000,,Әртүрлі жерлерде жапон әскери тұтқындарының лагерлері
Dialogue: 0,0:39:04.32,0:39:09.06,Default,,0000,0000,0000,,Мүмкіндігінше барыңыз.➡
Dialogue: 0,0:39:09.06,0:39:12.56,Default,,0000,0000,0000,,Әскери тұтқындармен қарым-қатынасты жақсарту туралы өтініш>
Dialogue: 0,0:39:14.68,0:39:18.28,Default,,0000,0000,0000,,(ｻｲﾚﾝ)
Dialogue: 0,0:39:18.28,0:39:35.98,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:39:35.98,0:39:40.29,Default,,0000,0000,0000,,<Күшейіп бара жатқан соғыс кезінде
Dialogue: 0,0:39:35.98,0:39:40.29,Default,,0000,0000,0000,,Тұтқындармен алмасу, емдеуді жақсарту және т.б.➡
Dialogue: 0,0:39:40.29,0:39:43.89,Default,,0000,0000,0000,,Қалай тыңдауға болады
Dialogue: 0,0:39:40.29,0:39:43.89,Default,,0000,0000,0000,,Өте қиын болды.➡
Dialogue: 0,0:39:43.89,0:39:46.38,Default,,0000,0000,0000,,Бірақ менің қолымнан келетіні –➡
Dialogue: 0,0:39:46.38,0:39:51.35,Default,,0000,0000,0000,,Берілмей
Dialogue: 0,0:39:46.38,0:39:51.35,Default,,0000,0000,0000,,Бар болғаны шағымдану болды>
Dialogue: 0,0:39:51.35,0:40:07.35,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:40:07.35,0:40:11.62,Default,,0000,0000,0000,,< Осы уақытта
Dialogue: 0,0:40:07.35,0:40:11.62,Default,,0000,0000,0000,,Генерал Персивал және басқа одақтас әскери офицерлер➡
Dialogue: 0,0:40:11.62,0:40:15.62,Default,,0000,0000,0000,,Мен соғыс тұтқыны болғанымды білгенде,
Dialogue: 0,0:40:11.62,0:40:15.62,Default,,0000,0000,0000,,Олармен кездесу үшін➡
Dialogue: 0,0:40:15.62,0:40:18.99,Rubi,,0000,0000,0000,,Сейан
Dialogue: 0,0:40:15.62,0:40:18.99,Default,,0000,0000,0000,,Сианьдағы тұтқындар лагерінде болды>
Dialogue: 0,0:40:18.99,0:40:22.36,Default,,0000,0000,0000,,Әскери тұтқын дегеніміз не?
Dialogue: 0,0:40:18.99,0:40:22.36,Default,,0000,0000,0000,,Көп сөйлеме
Dialogue: 0,0:40:22.36,0:40:26.92,Default,,0000,0000,0000,,Егер уәде орындалмаса
Dialogue: 0,0:40:22.36,0:40:26.92,Default,,0000,0000,0000,,Қызыл Кресттің Жапониядағы орны➡
Dialogue: 0,0:40:26.92,0:40:30.50,Default,,0000,0000,0000,,Бұл өте қауіпті болар еді.
Dialogue: 0,0:40:26.92,0:40:30.50,Default,,0000,0000,0000,,ﾄﾞｸﾀｰ･ｼﾞｭﾉｰ｡
Dialogue: 0,0:40:30.50,0:40:35.06,Default,,0000,0000,0000,,Түсінді. Бірақ мен
Dialogue: 0,0:40:30.50,0:40:35.06,Default,,0000,0000,0000,,Денсаулығын сұраңыз➡
Dialogue: 0,0:40:35.06,0:40:38.91,Default,,0000,0000,0000,,Олардың отбасы
Dialogue: 0,0:40:35.06,0:40:38.91,Default,,0000,0000,0000,,Оларға хатты алғаныңызды айтыңыз➡
Dialogue: 0,0:40:38.91,0:40:42.68,Default,,0000,0000,0000,,Олардың өтініштері бар ма?
Dialogue: 0,0:40:38.91,0:40:42.68,Default,,0000,0000,0000,,Тыңдау керек
Dialogue: 0,0:40:42.68,0:40:44.69,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:40:44.69,0:40:48.46,Default,,0000,0000,0000,,Бұл қорқынышты
Dialogue: 0,0:40:44.69,0:40:48.46,Default,,0000,0000,0000,,Не... не! Сіз мотивациясыз ба?
Dialogue: 0,0:40:48.46,0:40:51.86,Default,,0000,0000,0000,,Хмф! Міне
Dialogue: 0,0:40:54.18,0:40:57.38,Default,,0000,0000,0000,,(Цубаки) Еркек болсаң, батылыңды сынап көр! Бұл әлемді өзгертеді!
Dialogue: 0,0:40:54.18,0:40:57.38,Default,,0000,0000,0000,,Мен біраз шаршадым.
Dialogue: 0,0:41:10.19,0:41:14.89,Default,,0000,0000,0000,,Неге екені белгісіз, бәрі мұңайып көрінеді.
Dialogue: 0,0:41:10.19,0:41:14.89,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:41:22.14,0:41:28.44,Default,,0000,0000,0000,,Жүрек үні
Dialogue: 0,0:41:22.14,0:41:28.44,Default,,0000,0000,0000,,Бұл… Адамның қадір-қасиеті, т.б.
Dialogue: 0,0:41:22.14,0:41:28.44,Default,,0000,0000,0000,,Бұл емдеу ештеңеге ұқсамайды ма?
Dialogue: 0,0:41:35.25,0:41:37.25,Default,,0000,0000,0000,,Сіздің атыңыз кім?
Dialogue: 0,0:41:37.25,0:41:42.26,Default,,0000,0000,0000,,Бұл генерал Венрейт.
Dialogue: 0,0:41:37.25,0:41:42.26,Default,,0000,0000,0000,,Жалпы персивал
Dialogue: 0,0:41:42.26,0:41:47.26,Default,,0000,0000,0000,,Қалайсың...?
Dialogue: 0,0:41:48.88,0:41:53.25,Default,,0000,0000,0000,,жеткілікті.
Dialogue: 0,0:41:48.88,0:41:53.25,Default,,0000,0000,0000,,Оң жақ белімнің ауыруы да басылды.
Dialogue: 0,0:41:53.25,0:41:56.74,Default,,0000,0000,0000,,<Еуропадан алыс
Dialogue: 0,0:41:53.25,0:41:56.74,Default,,0000,0000,0000,,Азия жерінде➡
Dialogue: 0,0:41:56.74,0:42:01.31,Default,,0000,0000,0000,,Біздің кездесу
Dialogue: 0,0:41:56.74,0:42:01.31,Default,,0000,0000,0000,,Бірнеше минутта аяқталды>
Dialogue: 0,0:42:01.31,0:42:04.31,Default,,0000,0000,0000,,Доктор Джуноның уақыты келді
Dialogue: 0,0:42:01.31,0:42:04.31,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:42:04.31,0:42:06.33,Default,,0000,0000,0000,,Келіңіздер.
Dialogue: 0,0:42:04.31,0:42:06.33,Default,,0000,0000,0000,,Эй...
Dialogue: 0,0:42:06.33,0:42:09.80,Default,,0000,0000,0000,,Келесі жолы қашан келесіз?
Dialogue: 0,0:42:09.80,0:42:12.09,Default,,0000,0000,0000,,Тезірек!
Dialogue: 0,0:42:12.09,0:42:15.93,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:42:12.09,0:42:15.93,Default,,0000,0000,0000,,Қайта келуге уәде беріңіз.➡
Dialogue: 0,0:42:15.93,0:42:21.73,Default,,0000,0000,0000,,Маған тағы келемін деп уәде бер!
Dialogue: 0,0:42:15.93,0:42:21.73,Default,,0000,0000,0000,,Қайта кел!
Dialogue: 0,0:42:34.54,0:42:40.22,Default,,0000,0000,0000,,Не болады? сол адамдар
Dialogue: 0,0:42:34.54,0:42:40.22,Default,,0000,0000,0000,,Жарайды, мен сенімдімін
Dialogue: 0,0:42:40.22,0:42:43.42,Default,,0000,0000,0000,,<«Қайтып келу» уәдесі
Dialogue: 0,0:42:40.22,0:42:43.42,Default,,0000,0000,0000,,Қорғау мүмкін болмады.➡
Dialogue: 0,0:42:43.42,0:42:47.16,Default,,0000,0000,0000,,Жоқ, мен кетуім керек.
Dialogue: 0,0:42:43.42,0:42:47.16,Default,,0000,0000,0000,,Жоқ.>
Dialogue: 0,0:42:47.16,0:42:49.89,Default,,0000,0000,0000,,(Бомбалау дыбысы)
Dialogue: 0,0:42:49.89,0:42:53.48,Default,,0000,0000,0000,,<6 тамыз 1945 ж.➡
Dialogue: 0,0:42:53.48,0:42:59.69,Default,,0000,0000,0000,,Әлемде бірінші американдық әскерилер
Dialogue: 0,0:42:53.48,0:42:59.69,Default,,0000,0000,0000,,Хиросимаға атом бомбасы тасталды.➡
Dialogue: 0,0:42:59.69,0:43:07.49,Default,,0000,0000,0000,,Сондай-ақ 9 тамыз. Екінші
Dialogue: 0,0:42:59.69,0:43:07.49,Default,,0000,0000,0000,,Нагасакиге тасталған атом бомбасы>
Dialogue: 0,0:43:09.31,0:43:17.31,Default,,0000,0000,0000,,< Сол күні, ұзақ жолдан кейін
Dialogue: 0,0:43:09.31,0:43:17.31,Default,,0000,0000,0000,,Мен Жапонияға келдім>
Dialogue: 0,0:43:22.11,0:43:28.85,Default,,0000,0000,0000,,<1945 жыл, 15 тамыз
Dialogue: 0,0:43:22.11,0:43:28.85,Default,,0000,0000,0000,,Екінші дүниежүзілік соғыстың аяқталуы.➡
Dialogue: 0,0:43:28.85,0:43:33.65,Default,,0000,0000,0000,,Соғыс ұзақ және ауыр болды.
Dialogue: 0,0:43:28.85,0:43:33.65,Default,,0000,0000,0000,,Ақыры ақыры келді>
Dialogue: 0,0:43:40.01,0:43:46.82,Default,,0000,0000,0000,,<Бірақ біздің күресіміз
Dialogue: 0,0:43:40.01,0:43:46.82,Default,,0000,0000,0000,,Әлі жалғасуда>
Dialogue: 0,0:43:46.82,0:43:50.82,Default,,0000,0000,0000,,Бұл... Мен мұндай нәрсе болады деп күткен жоқпын!
Dialogue: 0,0:43:50.82,0:44:30.53,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:44:30.53,0:44:34.68,Default,,0000,0000,0000,,«Хиросима қорқынышты жағдайда.➡
Dialogue: 0,0:44:34.68,0:44:37.82,Default,,0000,0000,0000,,Қаланың 90% қираған.➡
Dialogue: 0,0:44:37.82,0:44:42.89,Default,,0000,0000,0000,,Барлық ауруханалар қирады
Dialogue: 0,0:44:37.82,0:44:42.89,Default,,0000,0000,0000,,немесе үлкен зақым келтіріңіз➡
Dialogue: 0,0:44:42.89,0:44:47.98,Default,,0000,0000,0000,,Жаңа бомбаның күші
Dialogue: 0,0:44:42.89,0:44:47.98,Default,,0000,0000,0000,,Қаһарлы, орасан зор…”
Dialogue: 0,0:44:47.98,0:44:52.08,Default,,0000,0000,0000,,А... а...
Dialogue: 0,0:44:52.08,0:44:56.69,Default,,0000,0000,0000,,«Көшелер өлгендерге де, жараланғандарға да толы➡
Dialogue: 0,0:44:56.69,0:45:04.09,Default,,0000,0000,0000,,Уақытша стационарларға арналған жабдықтар бинттер
Dialogue: 0,0:44:56.69,0:45:04.09,Default,,0000,0000,0000,,Дәрі-дәрмектің толық жетіспеушілігі.➡
Dialogue: 0,0:45:04.09,0:45:08.20,Default,,0000,0000,0000,,Дереу одақтастардың штабына
Dialogue: 0,0:45:04.09,0:45:08.20,Default,,0000,0000,0000,,Хиросима қаласының орталығына➡
Dialogue: 0,0:45:08.20,0:45:12.80,Default,,0000,0000,0000,,Құтқару парашютін түсіру
Dialogue: 0,0:45:08.20,0:45:12.80,Default,,0000,0000,0000,,Бұл сұралды».
Dialogue: 0,0:45:21.53,0:45:26.92,Default,,0000,0000,0000,,Неліктен!? Неліктен Хиросима мен Нагасаки?
Dialogue: 0,0:45:21.53,0:45:26.92,Default,,0000,0000,0000,,Көмек жібермейсіз бе?
Dialogue: 0,0:45:26.92,0:45:29.62,Default,,0000,0000,0000,,Жаңа бомбаның арқасында адамдар...
Dialogue: 0,0:45:29.62,0:45:34.02,Default,,0000,0000,0000,,Ондаған мың немесе жүз мың болуы мүмкін.
Dialogue: 0,0:45:29.62,0:45:34.02,Default,,0000,0000,0000,,Адамдар қиналып жатыр!
Dialogue: 0,0:45:35.81,0:45:38.93,Default,,0000,0000,0000,,Бұл қазір мүмкін емес. Доктор Джуно
Dialogue: 0,0:45:38.93,0:45:43.42,Default,,0000,0000,0000,,Атом бомбасын одақтас күштер пайдаланды.
Dialogue: 0,0:45:38.93,0:45:43.42,Default,,0000,0000,0000,,Бұл өте құпия.
Dialogue: 0,0:45:43.42,0:45:47.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:45:43.42,0:45:47.02,Default,,0000,0000,0000,,Міне! Мені жалғыз қалдыр дейсің бе!?
Dialogue: 0,0:45:47.02,0:45:51.14,Default,,0000,0000,0000,,Бір минут күтіңіз! Міне!
Dialogue: 0,0:45:47.02,0:45:51.14,Default,,0000,0000,0000,,Сіз барлығын тастап кетуді жоспарлап отырсыз ба!?
Dialogue: 0,0:45:51.14,0:45:58.45,Default,,0000,0000,0000,,Атом бомбасының келтірген зияны және оның масштабы
Dialogue: 0,0:45:51.14,0:45:58.45,Default,,0000,0000,0000,,Барлығын жалпыға жария ете алмайсыз.
Dialogue: 0,0:45:58.45,0:46:02.22,Default,,0000,0000,0000,,Әскери құпияларға қатысты...
Dialogue: 0,0:45:58.45,0:46:02.22,Default,,0000,0000,0000,,(үстелді түрту дыбысы)
Dialogue: 0,0:46:02.22,0:46:05.19,Default,,0000,0000,0000,,Джуно мырза...
Dialogue: 0,0:46:05.19,0:46:08.66,Default,,0000,0000,0000,,Өте құпия... Әскери құпия...
Dialogue: 0,0:46:08.66,0:46:11.86,Default,,0000,0000,0000,,Адам өмірі және
Dialogue: 0,0:46:08.66,0:46:11.86,Default,,0000,0000,0000,,Қайсысы маңызды?
Dialogue: 0,0:46:24.46,0:46:27.66,Default,,0000,0000,0000,,ﾏﾙｾﾙ･ｼﾞｭﾉｰ…｡
Dialogue: 0,0:46:29.41,0:46:32.98,Default,,0000,0000,0000,,Қазірдің өзінде! Әскери құпия неде?
Dialogue: 0,0:46:32.98,0:46:35.79,Default,,0000,0000,0000,,Иә. Мен мұнымен келісе алмаймын!
Dialogue: 0,0:46:35.79,0:46:38.59,Default,,0000,0000,0000,,Доктор Джуноны күтіңіз
Dialogue: 0,0:46:41.81,0:46:43.83,Default,,0000,0000,0000,,Өкінішке орай, американдық әскерилер ➡
Dialogue: 0,0:46:43.83,0:46:46.75,Default,,0000,0000,0000,,Тікелей көмек көрсету операциялары
Dialogue: 0,0:46:43.83,0:46:46.75,Default,,0000,0000,0000,,Ұйымдастыру мүмкін емес
Dialogue: 0,0:46:46.75,0:46:50.38,Default,,0000,0000,0000,,Дегенмен
Dialogue: 0,0:46:46.75,0:46:50.38,Default,,0000,0000,0000,,15 тонна дәрілік заттар мен медициналық техника➡
Dialogue: 0,0:46:50.38,0:46:53.45,Default,,0000,0000,0000,,Сізге қамтамасыз ету
Dialogue: 0,0:46:50.38,0:46:53.45,Default,,0000,0000,0000,,Енді
Dialogue: 0,0:46:50.38,0:46:53.45,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:46:53.45,0:46:59.74,Default,,0000,0000,0000,,Оның таралу әдісіне қатысты.
Dialogue: 0,0:46:53.45,0:46:59.74,Default,,0000,0000,0000,,Қызыл Крест басшылығы мен жауапкершілігіне бағынады
Dialogue: 0,0:46:59.74,0:47:03.08,Default,,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:47:03.08,0:47:06.58,Default,,0000,0000,0000,,Иә. Генерал Макартурдың бұйрықтары.
Dialogue: 0,0:47:06.58,0:47:09.30,Default,,0000,0000,0000,,Генерал МакАртур!?
Dialogue: 0,0:47:09.30,0:47:23.58,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:47:23.58,0:47:28.92,Default,,0000,0000,0000,,Жақсы~｡ Мен сізге бұл істе көмектесе аламын.
Dialogue: 0,0:47:23.58,0:47:28.92,Default,,0000,0000,0000,,Сенің қолыңнан келеді, Хиросима тұрғындары.
Dialogue: 0,0:47:28.92,0:47:32.32,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:47:28.92,0:47:32.32,Default,,0000,0000,0000,,ﾄﾞｸﾀｰ･ｼﾞｭﾉｰ！
Dialogue: 0,0:47:40.12,0:47:42.12,Default,,0000,0000,0000,,Бұл не өзі…?>
Dialogue: 0,0:47:42.12,0:47:44.65,Default,,0000,0000,0000,,Сен... Ах!
Dialogue: 0,0:47:44.65,0:47:46.91,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:47:44.65,0:47:46.91,Default,,0000,0000,0000,,Ах! Бұл адамдар...
Dialogue: 0,0:47:46.91,0:47:52.73,Default,,0000,0000,0000,,Еске алу
Dialogue: 0,0:47:46.91,0:47:52.73,Default,,0000,0000,0000,,Келесі жолы қашан келесіз?
Dialogue: 0,0:47:46.91,0:47:52.73,Default,,0000,0000,0000,,Мүмкіндігінше тезірек!
Dialogue: 0,0:47:52.73,0:47:58.22,Default,,0000,0000,0000,,Маған тағы келемін деп уәде бер
Dialogue: 0,0:47:52.73,0:47:58.22,Default,,0000,0000,0000,,Маған тағы келемін деп уәде бер!
Dialogue: 0,0:47:58.22,0:48:02.29,Default,,0000,0000,0000,,Генерал Вэнрайт! Жалпы Персивал!
Dialogue: 0,0:48:02.29,0:48:05.28,Default,,0000,0000,0000,,Екеуіңіздің де қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:48:05.28,0:48:09.05,Default,,0000,0000,0000,,Мен сізді тағы да көргеніме қуаныштымын.
Dialogue: 0,0:48:05.28,0:48:09.05,Default,,0000,0000,0000,,Бірақ... неге?
Dialogue: 0,0:48:09.05,0:48:13.38,Default,,0000,0000,0000,,Макартур сізге қайта барады.
Dialogue: 0,0:48:09.05,0:48:13.38,Default,,0000,0000,0000,,Мені кешіріңіз
Dialogue: 0,0:48:13.38,0:48:16.52,Default,,0000,0000,0000,,Генерал МакАртур?
Dialogue: 0,0:48:13.38,0:48:16.52,Default,,0000,0000,0000,,Ол былай деді.➡
Dialogue: 0,0:48:16.52,0:48:21.54,Default,,0000,0000,0000,,Сіз одақтастардың әскери тұтқынысыз.
Dialogue: 0,0:48:16.52,0:48:21.54,Default,,0000,0000,0000,,Ол менің қайырымды адамым.➡
Dialogue: 0,0:48:21.54,0:48:25.48,Default,,0000,0000,0000,,Ал қайырымды адамға
Dialogue: 0,0:48:21.54,0:48:25.48,Default,,0000,0000,0000,,Мен сізге өтеуім керек.
Dialogue: 0,0:48:25.48,0:48:28.78,Default,,0000,0000,0000,,Италиялықтар тегіне мақтанады
Dialogue: 0,0:48:28.78,0:48:33.18,Default,,0000,0000,0000,,Әке!
Dialogue: 0,0:48:28.78,0:48:33.18,Default,,0000,0000,0000,,Еске алу
Dialogue: 0,0:48:28.78,0:48:33.18,Default,,0000,0000,0000,,Құдай осыны көріп тұр ма?
Dialogue: 0,0:48:36.92,0:48:40.04,Default,,0000,0000,0000,,Жүрек үні
Dialogue: 0,0:48:36.92,0:48:40.04,Default,,0000,0000,0000,,Әкем айтқандай.
Dialogue: 0,0:48:40.04,0:48:42.35,Default,,0000,0000,0000,,Екеуіңізге де рахмет.
Dialogue: 0,0:48:42.35,0:48:45.85,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:48:45.85,0:48:51.25,Default,,0000,0000,0000,,Бұл жолы ақырын
Dialogue: 0,0:48:45.85,0:48:51.25,Default,,0000,0000,0000,,Біз сөйлесе аламыз, доктор Джуно.
Dialogue: 0,0:48:45.85,0:48:51.25,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:48:54.52,0:48:58.85,Default,,0000,0000,0000,,Біз қосылдық
Dialogue: 0,0:48:54.52,0:48:58.85,Default,,0000,0000,0000,,Бұл босқа кеткен жоқ.
Dialogue: 0,0:48:58.85,0:49:01.51,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:49:01.51,0:49:03.52,Default,,0000,0000,0000,,<Адам нені шығарады➡
Dialogue: 0,0:49:03.52,0:49:07.79,Default,,0000,0000,0000,,«Соғыс» деп аталатын қайғы мен өшпенділік
Dialogue: 0,0:49:03.52,0:49:07.79,Default,,0000,0000,0000,,Тек тізбек емес.➡
Dialogue: 0,0:49:07.79,0:49:11.46,Default,,0000,0000,0000,,Гудвилл тізбегі де
Dialogue: 0,0:49:07.79,0:49:11.46,Default,,0000,0000,0000,,Ол әлі де бар.➡
Dialogue: 0,0:49:11.46,0:49:15.13,Default,,0000,0000,0000,,Және 8 қыркүйек 1945 ж.➡
Dialogue: 0,0:49:15.13,0:49:20.88,Default,,0000,0000,0000,,15 тонна американдық әскерилер дайындаған
Dialogue: 0,0:49:15.13,0:49:20.88,Default,,0000,0000,0000,,Хиросимаға көмек жөнелтілді.➡
Dialogue: 0,0:49:20.88,0:49:27.41,Default,,0000,0000,0000,,Мен де Хиросимада емделетін боламын.
Dialogue: 0,0:49:20.88,0:49:27.41,Default,,0000,0000,0000,,Ол көлік ұшағында жолаушы болған>
Dialogue: 0,0:49:27.41,0:49:30.71,Default,,0000,0000,0000,,Доктор Джуно! Мен оны қазір көріп тұрмын
Dialogue: 0,0:49:27.41,0:49:30.71,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:50:10.58,0:50:14.08,Default,,0000,0000,0000,,Бұл... Хиросима...
Dialogue: 0,0:50:19.01,0:50:32.41,Default,,0000,0000,0000,,(енеді)
Dialogue: 0,0:50:32.41,0:50:34.59,Default,,0000,0000,0000,,Ой...
Dialogue: 0,0:50:32.41,0:50:34.59,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:50:34.59,0:50:41.29,Default,,0000,0000,0000,,Әке, сіз қайдасыз?
Dialogue: 0,0:50:34.59,0:50:41.29,Default,,0000,0000,0000,,Әкем…
Dialogue: 0,0:50:44.45,0:50:49.41,Default,,0000,0000,0000,,Жарайды
Dialogue: 0,0:50:44.45,0:50:49.41,Default,,0000,0000,0000,,Сіз мені естисіз бе? бәрі осында
Dialogue: 0,0:50:49.41,0:50:52.33,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:50:52.33,0:50:57.23,Default,,0000,0000,0000,,Жоқ, мен ештеңе істей алмаймын.
Dialogue: 0,0:51:02.90,0:51:07.20,Default,,0000,0000,0000,,Жарайды. Қазір бәрі жақсы.
Dialogue: 0,0:51:10.14,0:51:12.44,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:51:21.39,0:51:31.09,Default,,0000,0000,0000,,(Юко мен Мии жылайды)
Dialogue: 0,0:51:32.75,0:51:57.84,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:51:57.84,0:52:01.64,Default,,0000,0000,0000,,<Хиросимаға жеткізілді
Dialogue: 0,0:51:57.84,0:52:01.64,Default,,0000,0000,0000,,Дезинфекциялау құралдары мен таңғыштардың көп мөлшері ➡
Dialogue: 0,0:52:01.64,0:52:05.24,Default,,0000,0000,0000,,Үлкен емдік әсер>
Dialogue: 0,0:52:07.12,0:52:12.62,Rubi,,0000,0000,0000,,Кесшо
Dialogue: 0,0:52:07.12,0:52:12.62,Default,,0000,0000,0000,,<Әсіресе пенициллин және кептірілген плазма
Dialogue: 0,0:52:07.12,0:52:12.62,Default,,0000,0000,0000,,Бірінші рет Жапонияда сол кезде қолданылған➡
Dialogue: 0,0:52:12.62,0:52:16.83,Default,,0000,0000,0000,,Көптеген адамдардың өмірін сақтап қалуға көмектесті.➡
Dialogue: 0,0:52:16.83,0:52:22.85,Default,,0000,0000,0000,,6 тамыз 1945 жыл 8 сағат 15 минут.➡
Dialogue: 0,0:52:22.85,0:52:27.95,Default,,0000,0000,0000,,Адамгершілік
Dialogue: 0,0:52:22.85,0:52:27.95,Default,,0000,0000,0000,,Бұл уақытты ешқашан ұмытпау керек>
Dialogue: 0,0:52:39.82,0:52:46.61,Default,,0000,0000,0000,,Атом бомбасы тасталғаннан кейін <4 ай
Dialogue: 0,0:52:39.82,0:52:46.61,Default,,0000,0000,0000,,Жапониядан кетуден бірнеше күн бұрын.➡
