Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:12.89,0:01:14.89,Default,,0,0,0,,Өтініш жазылған конверт жоғалып кетті.
Dialogue: 0,0:01:16.83,0:01:18.83,Default,,0,0,0,,Иә...
Dialogue: 0,0:01:18.83,0:01:20.83,Default,,0,0,0,,Өтініш жазылған конверт жоғалып кетті.
Dialogue: 0,0:01:20.83,0:01:22.83,Default,,0,0,0,,Олардың мүлде қозғалмай жатқаны оғаш екен
Dialogue: 0,0:01:22.83,0:01:25.83,Default,,0,0,0,,Әдемі күлу туралы зерттеу, солай ма?
Dialogue: 0,0:01:25.83,0:01:27.83,Default,,0,0,0,,Өтініш жазылған конверт жоғалып кетті.
Dialogue: 0,0:02:47.83,0:02:54.84,Default,,0,0,0,,Ла ла ла ла ла ла ла ла ла ла ла
Dialogue: 0,0:02:54.84,0:02:59.83,Default,,0,0,0,,Ла ла ла ла ла ла ла ла
Dialogue: 0,0:02:59.83,0:03:02.83,Default,,0,0,0,,Ла ла ла ла...
Dialogue: 0,0:03:02.83,0:03:04.83,Default,,0,0,0,,Міне, Абдул.
Dialogue: 0,0:03:21.83,0:03:23.83,Default,,0,0,0,,А...
Dialogue: 0,0:03:25.84,0:03:27.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:39.84,0:03:46.84,Default,,0,0,0,,Лала ла ла ла ла ла ла ла ла ла
Dialogue: 0,0:03:46.84,0:03:52.83,Default,,0,0,0,,Ла ла ла ла ла ла ла ла
Dialogue: 0,0:03:52.83,0:03:55.83,Default,,0,0,0,,Ла ла ла ла ла ла
Dialogue: 0,0:03:59.84,0:04:02.84,Default,,0,0,0,,Әкемнің шұлығы тағы менің тартпада...
Dialogue: 0,0:04:05.83,0:04:08.83,Default,,0,0,0,,Ла ла ла ла…
Dialogue: 0,0:04:08.83,0:04:10.83,Default,,0,0,0,,Міне, Абдул.
Dialogue: 0,0:04:10.83,0:04:13.83,Default,,0,0,0,,Юзухико, кететін уақыт келді.
Dialogue: 0,0:04:15.84,0:04:19.84,Default,,0,0,0,,Әкем мен менікі қосылды.
Dialogue: 0,0:04:19.84,0:04:23.83,Default,,0,0,0,,Әртүрлі шұлықтарды біріктіруді тоқтатыңыз!
Dialogue: 0,0:04:23.83,0:04:25.83,Default,,0,0,0,,Қазір жақсы емес пе?
Dialogue: 0,0:04:25.83,0:04:27.83,Default,,0,0,0,,Оларды киіп, тез жүріңіз.
Dialogue: 0,0:04:27.83,0:04:29.84,Default,,0,0,0,,Мен оны уақытында жасауым керек, жоқ.
Dialogue: 0,0:04:29.84,0:04:31.84,Default,,0,0,0,,О
Dialogue: 0,0:04:31.84,0:04:33.84,Default,,0,0,0,,Бұны кигеннен кейін
Dialogue: 0,0:04:33.84,0:04:35.84,Default,,0,0,0,,Бұл жиынтық ретінде жуылады.
Dialogue: 0,0:04:35.84,0:04:38.83,Default,,0,0,0,,Мен бұл жиынтықты келесі жолы тағы да киетін шығармын.
Dialogue: 0,0:04:38.83,0:04:41.83,Default,,0,0,0,,Тісті берілістер мәңгілікке істен шығады
Dialogue: 0,0:04:41.83,0:04:44.83,Default,,0,0,0,,Бұл бала қисынды сияқты.
Dialogue: 0,0:04:44.83,0:04:46.84,Default,,0,0,0,,Анашым, не?
Dialogue: 0,0:04:46.84,0:04:49.84,Default,,0,0,0,,Кәне, менің шкафыма кіріңіз
Dialogue: 0,0:04:51.84,0:04:54.84,Default,,0,0,0,,Өз шалбарыңызды киюді доғарыңыз.
Dialogue: 0,0:04:54.84,0:04:56.83,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:56.83,0:04:59.83,Default,,0,0,0,,Хехе, мен көмектесе алмаймын.
Dialogue: 0,0:04:59.83,0:05:01.83,Default,,0,0,0,,Резеңке созылса, солай айтуға болады.
Dialogue: 0,0:05:01.83,0:05:03.84,Default,,0,0,0,,Bue
Dialogue: 0,0:05:03.84,0:05:06.84,Default,,0,0,0,,Му! Бұл шындық болуы мүмкін емес!
Dialogue: 0,0:05:06.84,0:05:09.84,Default,,0,0,0,,Әйтеуір, үйдегі кірдің бәрі
Dialogue: 0,0:05:09.84,0:05:11.84,Default,,0,0,0,,Бәрі шатасыпты.
Dialogue: 0,0:05:11.84,0:05:13.83,Default,,0,0,0,,Иә, қазірдің өзінде!
Dialogue: 0,0:05:13.83,0:05:16.83,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:05:16.83,0:05:18.83,Default,,0,0,0,,Неліктен ата-аналарға ұнайды?
Dialogue: 0,0:05:18.83,0:05:20.84,Default,,0,0,0,,Мен сені қинауым керек пе?
Dialogue: 0,0:05:20.84,0:05:24.84,Default,,0,0,0,,Бұл балалар өте жақсы!
Dialogue: 0,0:05:24.84,0:05:28.84,Default,,0,0,0,,Сіз шынымен ештеңе түсінбейсіз.
Dialogue: 0,0:05:28.84,0:05:30.83,Default,,0,0,0,,Осы уақытқа дейін айтпадым.
Dialogue: 0,0:05:30.83,0:05:32.83,Default,,0,0,0,,Ана жақында
Dialogue: 0,0:05:32.83,0:05:35.83,Default,,0,0,0,,Менің көру қабілетім барған сайын нашарлап барады.
Dialogue: 0,0:05:35.83,0:05:37.84,Default,,0,0,0,,Бұл жақсы сезім.
Dialogue: 0,0:05:37.84,0:05:39.84,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:05:39.84,0:05:41.84,Default,,0,0,0,,Әй, анашым!
Dialogue: 0,0:05:41.84,0:05:43.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:48.83,0:05:50.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:56.84,0:05:58.84,Default,,0,0,0,,Осыны айтсақ, анашым
Dialogue: 0,0:05:58.84,0:06:00.84,Default,,0,0,0,,Кофе шыныаяқында
Dialogue: 0,0:06:00.84,0:06:02.84,Default,,0,0,0,,Сіз оны басқа табақшамен ұсындыңыз ба?
Dialogue: 0,0:06:05.83,0:06:09.84,Default,,0,0,0,,Күні кеше досым қонаққа келгенде
Dialogue: 0,0:06:09.84,0:06:12.84,Default,,0,0,0,,Кофе тарелкасында шанышқы болды.
Dialogue: 0,0:06:14.84,0:06:17.84,Default,,0,0,0,,Анамның көзі шынымен де бар...
Dialogue: 0,0:06:19.85,0:06:22.85,Default,,0,0,0,,Бұл шынымен де себеп пе...
Dialogue: 0,0:06:25.83,0:06:30.84,Default,,0,0,0,,Құмарлықтың қызыл раушан гүлі
Dialogue: 0,0:06:30.84,0:06:32.84,Default,,0,0,0,,Ах
Dialogue: 0,0:06:32.84,0:06:34.84,Default,,0,0,0,,және қызғаныш
Dialogue: 0,0:06:34.84,0:06:36.85,Default,,0,0,0,,Қақпақ сәйкес келмейді...
Dialogue: 0,0:06:36.85,0:06:41.83,Default,,0,0,0,,Махаббат гүлдері гүлдейді
Dialogue: 0,0:06:41.83,0:06:43.83,Default,,0,0,0,,А... шыны бар...
Dialogue: 0,0:06:47.84,0:06:49.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:51.84,0:06:54.85,Default,,0,0,0,,Бұл ваннаға арналған төсеніш емес пе?
Dialogue: 0,0:06:54.85,0:06:56.83,Default,,0,0,0,,Ана жақында
Dialogue: 0,0:06:56.83,0:06:58.83,Default,,0,0,0,,Менің көру қабілетім барған сайын нашарлап барады.
Dialogue: 0,0:06:58.83,0:07:02.84,Default,,0,0,0,,Құмарлықтың қызыл раушан гүлі
Dialogue: 0,0:07:02.84,0:07:05.84,Default,,0,0,0,,Әке, не?
Dialogue: 0,0:07:05.84,0:07:08.84,Default,,0,0,0,,Білесің бе, анаңның...
Dialogue: 0,0:07:08.84,0:07:10.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:10.85,0:07:12.85,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:07:12.85,0:07:16.84,Default,,0,0,0,,Махаббат гүлдері гүлдейді
Dialogue: 0,0:07:16.84,0:07:18.84,Default,,0,0,0,,Қалайсың? Уф...
Dialogue: 0,0:07:18.84,0:07:20.84,Default,,0,0,0,,Құмарлық...
Dialogue: 0,0:07:20.84,0:07:22.84,Default,,0,0,0,,Микан! Уаа...
Dialogue: 0,0:07:22.84,0:07:24.84,Default,,0,0,0,,Мен қазір дайынмын, сондықтан мені жалғыз қалдыра аласыз ба?
Dialogue: 0,0:07:24.84,0:07:26.85,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:07:26.85,0:07:28.85,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:07:28.85,0:07:30.85,Default,,0,0,0,,Құмарлықтың қызыл раушан гүлі
Dialogue: 0,0:07:30.85,0:07:32.83,Default,,0,0,0,,Ал, күріш қасық...
Dialogue: 0,0:07:32.83,0:07:34.83,Default,,0,0,0,,Иә, бұл күріш ыдысы.
Dialogue: 0,0:07:36.84,0:07:38.84,Default,,0,0,0,,Мынау күріш орамалына ұқсайды ма?
Dialogue: 0,0:07:38.84,0:07:42.84,Default,,0,0,0,,Ла ла ла ла ла...
Dialogue: 0,0:07:42.84,0:07:44.85,Default,,0,0,0,,(Итадори) Ол менің жұдырығымды толық жеделдемей тұрып маңдайына алды!
Dialogue: 0,0:07:44.85,0:07:46.85,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:07:46.85,0:07:49.85,Default,,0,0,0,,Бұл өте маңызды.
Dialogue: 0,0:07:53.84,0:07:56.84,Default,,0,0,0,,Жоқ, мен саған кеше айтқан жоқпын ба? Лукако – нағыз жігіт.
Dialogue: 0,0:07:56.84,0:07:58.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:00.85,0:08:05.83,Default,,0,0,0,,Құмарлықтың қызыл раушан гүлі
Dialogue: 0,0:08:05.83,0:08:07.84,Default,,0,0,0,,Әй, таяқшалар қайтадан сәйкес келмейді.
Dialogue: 0,0:08:07.84,0:08:10.84,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:08:10.84,0:08:12.84,Default,,0,0,0,,О, ау!
Dialogue: 0,0:08:12.84,0:08:14.84,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:08:14.84,0:08:16.85,Default,,0,0,0,,Бұл күндері менің көзіме бір нәрсе...
Dialogue: 0,0:08:16.85,0:08:18.85,Default,,0,0,0,,Көздеріңе не болды?
Dialogue: 0,0:08:18.85,0:08:20.85,Default,,0,0,0,,Менің көзім бұлыңғыр
Dialogue: 0,0:08:22.85,0:08:24.84,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:08:24.84,0:08:26.84,Default,,0,0,0,,Үйленгеннен кейін көзің маған
Dialogue: 0,0:08:26.84,0:08:28.84,Default,,0,0,0,,Әрқашан бұлыңғыр.
Dialogue: 0,0:08:28.84,0:08:31.84,Default,,0,0,0,,Тұрмысқа шыққаннан бері... өзіңізді бұлыңғыр сезінесіз бе?
Dialogue: 0,0:08:31.84,0:08:33.85,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:33.85,0:08:35.85,Default,,0,0,0,,Ахахахаха
Dialogue: 0,0:08:35.85,0:08:38.85,Default,,0,0,0,,Дұрыс, мен қазірдің өзінде шарасыздықпен қарап отырмын.
Dialogue: 0,0:08:38.85,0:08:41.84,Default,,0,0,0,,Қане, таяқша, таяқша, ләли ла ла ла
Dialogue: 0,0:08:41.84,0:08:43.84,Default,,0,0,0,,Алдамаңыз
Dialogue: 0,0:08:43.84,0:08:45.84,Default,,0,0,0,,Не?
Dialogue: 0,0:08:45.84,0:08:47.84,Default,,0,0,0,,Бұл өтірік пе?
Dialogue: 0,0:08:47.84,0:08:50.85,Default,,0,0,0,,Хехехехехехехехехе
Dialogue: 0,0:08:50.85,0:08:52.85,Default,,0,0,0,,Бұл рас, бұл өте қиын.
Dialogue: 0,0:08:52.85,0:08:54.85,Default,,0,0,0,,Себебі менің көзім бұлыңғыр
Dialogue: 0,0:08:54.85,0:08:56.85,Default,,0,0,0,,Мен қате таяқшаларды қолдандым.
Dialogue: 0,0:08:56.85,0:08:58.84,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:08:58.84,0:09:01.84,Default,,0,0,0,,Әйтсе де, менің анам қашанда дөрекі болды.
Dialogue: 0,0:09:01.84,0:09:03.84,Default,,0,0,0,,Ла ла ла ла ла
Dialogue: 0,0:09:08.85,0:09:10.85,Default,,0,0,0,,Ал, бұл мандарин апельсині.
Dialogue: 0,0:09:10.85,0:09:12.85,Default,,0,0,0,,Нерима Уордтан, Токиодан Шио Масудадан
Dialogue: 0,0:09:12.85,0:09:14.84,Default,,0,0,0,,Мен ашықхат алдым.
Dialogue: 0,0:09:14.84,0:09:16.84,Default,,0,0,0,,Сәлем Микан-сан
Dialogue: 0,0:09:16.84,0:09:18.84,Default,,0,0,0,,«Аташыншыны» тамашалап ләззат аламын
Dialogue: 0,0:09:18.84,0:09:22.84,Default,,0,0,0,,Айтпақшы, 1 бөлімде бенто туралы әңгіме болды.
Dialogue: 0,0:09:22.84,0:09:25.85,Default,,0,0,0,,Әй, солай болды, бәрі есінде ме?
Dialogue: 0,0:09:25.85,0:09:28.85,Default,,0,0,0,,«Маған түрлі-түсті түскі ас қорапшасын жасап бер» дегенде.
Dialogue: 0,0:09:28.85,0:09:30.85,Default,,0,0,0,,Менің анам көкөністерді араластырды
Dialogue: 0,0:09:30.85,0:09:32.84,Default,,0,0,0,,Қане, түскі ас қорапшасын жасайық.
Dialogue: 0,0:09:32.84,0:09:35.84,Default,,0,0,0,,А, бұл ұят болды.
Dialogue: 0,0:09:35.84,0:09:38.84,Default,,0,0,0,,Микан-сан, менің де анамның түскі ас қорабы.
Dialogue: 0,0:09:38.84,0:09:41.85,Default,,0,0,0,,Бұл өте аз. Қарап көріңізші.
Dialogue: 0,0:09:41.85,0:09:45.85,Default,,0,0,0,,Ол маған түскі ас қорабын да жіберді.
Dialogue: 0,0:09:45.85,0:09:48.85,Default,,0,0,0,,Бұл Масуданың анасының түскі ас қорабы.
Dialogue: 0,0:09:48.85,0:09:51.85,Default,,0,0,0,,Оны ашайық.
Dialogue: 0,0:09:53.84,0:09:55.84,Default,,0,0,0,,Эй... бұл оден.
Dialogue: 0,0:09:55.84,0:09:58.85,Default,,0,0,0,,Оден күрішке салынған...
Dialogue: 0,0:09:58.85,0:10:00.85,Default,,0,0,0,,А...
Dialogue: 0,0:10:00.85,0:10:03.85,Default,,0,0,0,,үшінна да қиналып жатыр.
Dialogue: 0,0:10:16.85,0:10:19.85,Default,,0,0,0,,Ууу...
Dialogue: 0,0:10:21.85,0:10:24.84,Default,,0,0,0,,Иә? біреу келді
Dialogue: 0,0:10:24.84,0:10:27.84,Default,,0,0,0,,Иә
Dialogue: 0,0:10:33.85,0:10:35.85,Default,,0,0,0,,Майдо, мен саған сыра әкелдім.
Dialogue: 0,0:10:35.85,0:10:37.85,Default,,0,0,0,,А, сәлем
Dialogue: 0,0:10:39.85,0:10:41.84,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:10:41.84,0:10:43.84,Default,,0,0,0,,Не? иә?
Dialogue: 0,0:10:46.85,0:10:48.85,Default,,0,0,0,,Уууу... Гуфууу...
Dialogue: 0,0:10:48.85,0:10:50.85,Default,,0,0,0,,Не?
Dialogue: 0,0:10:50.85,0:10:52.85,Default,,0,0,0,,Хехе...
Dialogue: 0,0:10:54.85,0:10:57.86,Default,,0,0,0,,А, енді? Иә
Dialogue: 0,0:10:57.86,0:10:59.84,Default,,0,0,0,,Ішімдік дүкені
Dialogue: 0,0:10:59.84,0:11:02.84,Default,,0,0,0,,Каа! Бар болғаны!
Dialogue: 0,0:11:02.84,0:11:05.85,Default,,0,0,0,,Неліктен бір сәтте жауап бере алмайсың?
Dialogue: 0,0:11:05.85,0:11:07.85,Default,,0,0,0,,Тороға барсаңыз...
Dialogue: 0,0:11:07.85,0:11:09.85,Default,,0,0,0,,Анаң нашар тыңдаған болуы керек.
Dialogue: 0,0:11:09.85,0:11:12.85,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:12.85,0:11:14.86,Default,,0,0,0,,«Не?» «Ішімдік дүкені».
Dialogue: 0,0:11:14.86,0:11:17.84,Default,,0,0,0,,Тез жауап беріңіз, солай ма?
Dialogue: 0,0:11:17.84,0:11:19.84,Default,,0,0,0,,үшінна бірден жауап беру
Dialogue: 0,0:11:19.84,0:11:21.85,Default,,0,0,0,,Күрсін... сен шынымен солайсың.
Dialogue: 0,0:11:21.85,0:11:23.85,Default,,0,0,0,,Себебі мен мұқият емеспін.
Dialogue: 0,0:11:23.85,0:11:26.85,Default,,0,0,0,,Шынымен де соншалықты көп айтуға тұрарлық па?
Dialogue: 0,0:11:26.85,0:11:28.85,Default,,0,0,0,,Иә, қазірдің өзінде... анам.
Dialogue: 0,0:11:28.85,0:11:30.86,Default,,0,0,0,,Екі денем болса екен.
Dialogue: 0,0:11:30.86,0:11:32.84,Default,,0,0,0,,Хун хун хун хун а...
Dialogue: 0,0:11:32.84,0:11:35.84,Default,,0,0,0,,Ғұн ғұн хун хун
Dialogue: 0,0:11:35.84,0:11:38.85,Default,,0,0,0,,Ғұн ғұн хун хун
Dialogue: 0,0:11:38.85,0:11:40.85,Default,,0,0,0,,Ештеңе жоқ...
Dialogue: 0,0:11:40.85,0:11:42.85,Default,,0,0,0,,Иә, хун, хе.
Dialogue: 0,0:11:42.85,0:11:44.85,Default,,0,0,0,,Хун хей хун ху
Dialogue: 0,0:11:44.85,0:11:46.86,Default,,0,0,0,,О!
Dialogue: 0,0:11:46.86,0:11:48.86,Default,,0,0,0,,Менің аяғым... кернеу.
Dialogue: 0,0:11:48.86,0:11:50.84,Default,,0,0,0,,А, а, а...
Dialogue: 0,0:11:50.84,0:11:52.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:52.84,0:11:54.84,Default,,0,0,0,,Шығыңыз.
Dialogue: 0,0:11:57.85,0:11:59.85,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:11:59.85,0:12:01.85,Default,,0,0,0,,Ууу
Dialogue: 0,0:12:01.85,0:12:03.86,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:03.86,0:12:06.86,Default,,0,0,0,,Иә...
Dialogue: 0,0:12:06.86,0:12:09.86,Default,,0,0,0,,Не? Сіз не аласыз
Dialogue: 0,0:12:11.85,0:12:13.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:13.85,0:12:15.85,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:12:15.85,0:12:17.85,Default,,0,0,0,,Иә?О
Dialogue: 0,0:12:17.85,0:12:20.86,Default,,0,0,0,,Мм, Роза әмбебап дүкені
Dialogue: 0,0:12:20.86,0:12:23.86,Default,,0,0,0,,Қағазға қарап айта алмайсың!
Dialogue: 0,0:12:23.86,0:12:26.85,Default,,0,0,0,,Менен ол жерден не шыққанын сұрап тұрсың ба?
Dialogue: 0,0:12:26.85,0:12:29.85,Default,,0,0,0,,Хмм... Аа, ішінде не бар?
Dialogue: 0,0:12:32.85,0:12:35.85,Default,,0,0,0,,Каа! Қазірдің өзінде өте ыстық!
Dialogue: 0,0:12:35.85,0:12:37.86,Default,,0,0,0,,Жыртпасаң да слипке жазылған ғой, солай ма?
Dialogue: 0,0:12:37.86,0:12:39.86,Default,,0,0,0,,Слипке қараңыз
Dialogue: 0,0:12:39.86,0:12:41.86,Default,,0,0,0,,Соншадан не алдың?
Dialogue: 0,0:12:41.86,0:12:43.85,Default,,0,0,0,,Жауап берсем екен...
Dialogue: 0,0:12:43.85,0:12:46.85,Default,,0,0,0,,Бұл рас, келешекте қиындыққа тап боласың.
Dialogue: 0,0:12:46.85,0:12:49.85,Default,,0,0,0,,Қыздар көбірек хабардар болуы керек
Dialogue: 0,0:12:49.85,0:12:51.85,Default,,0,0,0,,«Қыздар – қыздар»
Dialogue: 0,0:12:51.85,0:12:54.86,Default,,0,0,0,,Бұл кемсітушілік емес пе?
Dialogue: 0,0:12:54.86,0:12:56.86,Default,,0,0,0,,Дискриминация дегеніміз не? нақты проблемалар
Dialogue: 0,0:12:56.86,0:12:58.86,Default,,0,0,0,,Әйел байқамаса
Dialogue: 0,0:12:58.86,0:13:00.85,Default,,0,0,0,,Бұл дүниемен не болады деп ойлайсың?
Dialogue: 0,0:13:00.85,0:13:02.85,Default,,0,0,0,,Тодороки, сен не айтып тұрсың өзің?
Dialogue: 0,0:13:02.85,0:13:05.85,Default,,0,0,0,,Сіз басқа адамның не айтқысы келетінін тез түсінуіңіз керек.
Dialogue: 0,0:13:05.85,0:13:09.85,Default,,0,0,0,,«Иә» тыныс алу
Dialogue: 0,0:13:09.85,0:13:11.86,Default,,0,0,0,,Егер сіз «цу» десеңіз
Dialogue: 0,0:13:11.86,0:13:13.86,Default,,0,0,0,,«Ка»
Dialogue: 0,0:13:13.86,0:13:15.86,Default,,0,0,0,,1-ді тыңда, 10-ды біл
Dialogue: 0,0:13:15.86,0:13:17.85,Default,,0,0,0,,Соқсаң жаңғырық, ей
Dialogue: 0,0:13:17.85,0:13:20.85,Default,,0,0,0,,Қыздарға керегі де сол
Dialogue: 0,0:13:20.85,0:13:23.85,Default,,0,0,0,,Мақсатсыз өмір сүру жақсы емес, Микан.
Dialogue: 0,0:13:23.85,0:13:26.86,Default,,0,0,0,,Анасы қолдарын қимылдатады
Dialogue: 0,0:13:26.86,0:13:28.86,Default,,0,0,0,,Басшы ары қарай не істеуі керек?
Dialogue: 0,0:13:28.86,0:13:30.86,Default,,0,0,0,,Өйткені мен әрқашан дұрыс ойланамын
Dialogue: 0,0:13:30.86,0:13:32.86,Default,,0,0,0,,О...
Dialogue: 0,0:13:40.85,0:13:45.86,Default,,0,0,0,,Құмарлықтың қызыл раушан гүлі
Dialogue: 0,0:13:45.86,0:13:50.86,Default,,0,0,0,,және қызғаныш
Dialogue: 0,0:13:50.86,0:13:52.85,Default,,0,0,0,,А, бүгін қоқыс күні.
Dialogue: 0,0:13:52.85,0:13:55.85,Default,,0,0,0,,О, менің ойымша, сіз осындасыз ба?
Dialogue: 0,0:13:55.85,0:13:58.85,Default,,0,0,0,,А... Мен бұл жерден көрінбеймін, солай ма?
Dialogue: 0,0:13:58.85,0:14:00.86,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:14:00.86,0:14:02.86,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:14:02.86,0:14:04.86,Default,,0,0,0,,А, апельсиндер
Dialogue: 0,0:14:04.86,0:14:07.86,Default,,0,0,0,,Қоқыс таситын машина, ол әлі келді ме?
Dialogue: 0,0:14:07.86,0:14:09.85,Default,,0,0,0,,Қоқыс? Әлі сонда болды ма?
Dialogue: 0,0:14:09.85,0:14:11.85,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:14:13.85,0:14:16.86,Default,,0,0,0,,Сіз бұрын келген жоқсыз ба?
Dialogue: 0,0:14:16.86,0:14:18.86,Default,,0,0,0,,А... иә, бірақ
Dialogue: 0,0:14:18.86,0:14:20.86,Default,,0,0,0,,Онда неге көрмейсің?
Dialogue: 0,0:14:20.86,0:14:22.86,Default,,0,0,0,,Қалыпты адамдар алдымызда жай жүрмейді.
Dialogue: 0,0:14:22.86,0:14:24.86,Default,,0,0,0,,Бүйір жақтарын да қарау керек, солай ма?
Dialogue: 0,0:14:24.86,0:14:26.85,Default,,0,0,0,,Жоқ, солай деп ойлаймын.
Dialogue: 0,0:14:26.85,0:14:28.85,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:14:31.85,0:14:33.85,Default,,0,0,0,,Қараңдар, есікті ашыңдар Ах...
Dialogue: 0,0:14:35.86,0:14:37.86,Default,,0,0,0,,Ммм, мен көмектесе алмаймын.
Dialogue: 0,0:14:37.86,0:14:40.86,Default,,0,0,0,,Өйткені бұл баланың ойы жоқ.
Dialogue: 0,0:14:42.86,0:14:45.86,Default,,0,0,0,,Мен үнемі қоқысқа қарап жүрмеймін.Әдетте.
Dialogue: 0,0:14:47.85,0:14:49.85,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:14:49.85,0:14:53.86,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:14:53.86,0:14:56.86,Default,,0,0,0,,Хаха...
Dialogue: 0,0:14:56.86,0:14:58.86,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:15:08.86,0:15:10.86,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:15:10.86,0:15:12.86,Default,,0,0,0,,Қазірдің өзінде! Ол кетіп қалды.
Dialogue: 0,0:15:12.86,0:15:15.86,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:15:15.86,0:15:17.85,Default,,0,0,0,,Мұқият қарасаңыз
Dialogue: 0,0:15:17.85,0:15:19.85,Default,,0,0,0,,Мен оны босқа басудан аулақ болар едім.
Dialogue: 0,0:15:19.85,0:15:21.85,Default,,0,0,0,,Микан, бұл жақсы емес.
Dialogue: 0,0:15:21.85,0:15:24.86,Default,,0,0,0,,Ондай қыз ше?
Dialogue: 0,0:15:24.86,0:15:26.86,Default,,0,0,0,,Егер сіз бір нәрсе жасасаңыз
Dialogue: 0,0:15:26.86,0:15:29.86,Default,,0,0,0,,Бұл жақсы нәрсе емес, түсіндің бе?
Dialogue: 0,0:15:29.86,0:15:31.86,Default,,0,0,0,,Маған көбірек нәрселерді байқау керек.
Dialogue: 0,0:15:31.86,0:15:33.87,Default,,0,0,0,,Ханзада Шотоку
Dialogue: 0,0:15:33.87,0:15:35.85,Default,,0,0,0,,Бір уақытта көп адам туралы айту
Dialogue: 0,0:15:35.85,0:15:37.85,Default,,0,0,0,,Мен айта аламын.
Dialogue: 0,0:15:37.85,0:15:40.86,Default,,0,0,0,,Сонымен, сіз нені айтасыз?
Dialogue: 0,0:15:40.86,0:15:42.86,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:15:45.86,0:15:48.86,Default,,0,0,0,,Уау... не?
Dialogue: 0,0:15:48.86,0:15:50.87,Default,,0,0,0,,Қараңдаршы, анашым.
Dialogue: 0,0:15:50.87,0:15:52.85,Default,,0,0,0,,Миканды ұрысып жатқанда
Dialogue: 0,0:15:52.85,0:15:54.85,Default,,0,0,0,,Сіз шыбындарды көресіз, солай ма?
Dialogue: 0,0:15:54.85,0:15:56.85,Default,,0,0,0,,Әй
Dialogue: 0,0:15:58.86,0:16:00.86,Default,,0,0,0,,Мұның несі керемет?
Dialogue: 0,0:16:07.87,0:16:10.85,Default,,0,0,0,,Кешіріңіз, иә.
Dialogue: 0,0:16:10.85,0:16:12.85,Default,,0,0,0,,Әй
Dialogue: 0,0:16:15.86,0:16:17.86,Default,,0,0,0,,Хун
Dialogue: 0,0:16:17.86,0:16:19.86,Default,,0,0,0,,Бірдеңе тапсырыс берші
Dialogue: 0,0:16:25.87,0:16:27.85,Default,,0,0,0,,Мама, ертең кездескенше...
Dialogue: 0,0:16:27.85,0:16:29.85,Default,,0,0,0,,Варипу оны киеді.
Dialogue: 0,0:16:29.85,0:16:31.86,Default,,0,0,0,,Мен оны жуып жатқандықтан, түймесі өшіп қала жаздады.
Dialogue: 0,0:16:31.86,0:16:33.86,Default,,0,0,0,,Мен оны дұрыстап қайта тіркедім.
Dialogue: 0,0:16:33.86,0:16:35.86,Default,,0,0,0,,Тез
Dialogue: 0,0:16:35.86,0:16:37.86,Default,,0,0,0,,Бұл тыныс
Dialogue: 0,0:16:37.86,0:16:39.86,Default,,0,0,0,,Міне, солай...
Dialogue: 0,0:16:41.87,0:16:43.87,Default,,0,0,0,,Эй иә ванна?
Dialogue: 0,0:16:43.87,0:16:46.85,Default,,0,0,0,,Мен оны қазір саламын. Апельсин, жаңа сабын.
Dialogue: 0,0:16:46.85,0:16:48.86,Default,,0,0,0,,Сен оны сонда қалдырдың ба? шығару
Dialogue: 0,0:16:48.86,0:16:51.86,Default,,0,0,0,,Жоқ, ол қайда кетті? сол сол
Dialogue: 0,0:16:51.86,0:16:53.86,Default,,0,0,0,,О, күте тұрыңыз.
Dialogue: 0,0:16:56.86,0:16:58.87,Default,,0,0,0,,Иә, иә... Иә.
Dialogue: 0,0:16:58.87,0:17:02.87,Default,,0,0,0,,Қонақ бөлмеде тырнақ қайшы болуы керек
Dialogue: 0,0:17:04.86,0:17:06.86,Default,,0,0,0,,Әй, бұл басқаша.
Dialogue: 0,0:17:06.86,0:17:08.86,Default,,0,0,0,,Ертең сабақтан кейін достарыммен...
Dialogue: 0,0:17:08.86,0:17:10.86,Default,,0,0,0,,Мен саған ақша бермеймін
Dialogue: 0,0:17:10.86,0:17:12.86,Default,,0,0,0,,Тырнақ қайшы емес
Dialogue: 0,0:17:12.86,0:17:14.87,Default,,0,0,0,,Қараңызшы, мен оны кеше алдым... А?
Dialogue: 0,0:17:14.87,0:17:17.87,Default,,0,0,0,,А, шұлық, иә, иә.
Dialogue: 0,0:17:19.85,0:17:21.86,Default,,0,0,0,,≪Бұл жігіт не өзі?!≫
Dialogue: 0,0:17:21.86,0:17:23.86,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:17:23.86,0:17:26.86,Default,,0,0,0,,Хаа ха ха ха ха
Dialogue: 0,0:17:26.86,0:17:28.86,Default,,0,0,0,,Мен ертең досыммен тапсырма орындаймын.
Dialogue: 0,0:17:28.86,0:17:31.87,Default,,0,0,0,,Кеш болады!
Dialogue: 0,0:17:31.87,0:17:34.87,Default,,0,0,0,,Портативті күлсалғыш қайда кетті?
Dialogue: 0,0:17:34.87,0:17:37.87,Default,,0,0,0,,Басқалардың айтқанын сабырмен тыңдаңыз Басқалардың айтқанын сабырмен тыңдаңыз
Dialogue: 0,0:17:39.86,0:17:41.86,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:17:41.86,0:17:43.86,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:17:50.87,0:17:53.86,Default,,0,0,0,,Ал, бенто туралы әңгіме үлкен жауап алды.
Dialogue: 0,0:17:53.86,0:17:55.86,Default,,0,0,0,,Мен тағы бір ашықхат алдым.
Dialogue: 0,0:17:55.86,0:17:58.86,Default,,0,0,0,,Ал, Кусацу қаласынан Юкико Ишида, Киото қаласы.
Dialogue: 0,0:17:58.86,0:18:00.86,Default,,0,0,0,,Қайырлы кеш Микан-сан
Dialogue: 0,0:18:00.86,0:18:02.86,Default,,0,0,0,,Анамның түскі ас қорабына да назар аударыңызшы.
Dialogue: 0,0:18:02.86,0:18:06.87,Default,,0,0,0,,Бұл маған қатты ұнайтыны рас...
Dialogue: 0,0:18:06.87,0:18:09.87,Default,,0,0,0,,Аа, бұл қандай түскі ас қорабы?
Dialogue: 0,0:18:09.87,0:18:11.87,Default,,0,0,0,,Қарап көрейік
Dialogue: 0,0:18:14.86,0:18:16.86,Default,,0,0,0,,Би… Бисквит…
Dialogue: 0,0:18:16.86,0:18:19.86,Default,,0,0,0,,Печенье және күріш...
Dialogue: 0,0:18:21.87,0:18:24.87,Default,,0,0,0,,үшінна қиналып жатыр, солай емес пе?
Dialogue: 0,0:19:19.86,0:19:21.86,Default,,0,0,0,,Ал... шын мәнінде
Dialogue: 0,0:19:21.86,0:19:23.86,Default,,0,0,0,,Тағы бір қорап келе жатыр.
Dialogue: 0,0:19:23.86,0:19:25.86,Default,,0,0,0,,Такасаки қаласы, Гунма префектурасы
Dialogue: 0,0:19:25.86,0:19:27.87,Default,,0,0,0,,Бұл Акира Коикеден.
Dialogue: 0,0:19:27.87,0:19:29.87,Default,,0,0,0,,Микан-сан Менің анамның түскі ас қорабы
Dialogue: 0,0:19:29.87,0:19:31.87,Default,,0,0,0,,Қарап көріңіз
Dialogue: 0,0:19:31.87,0:19:33.87,Default,,0,0,0,,Бір нәрсе өте қорқынышты.
Dialogue: 0,0:19:33.87,0:19:36.86,Default,,0,0,0,,Қарап көрейік
Dialogue: 0,0:19:36.86,0:19:38.86,Default,,0,0,0,,Даа!
Dialogue: 0,0:19:38.86,0:19:41.86,Default,,0,0,0,,Жоқ... Натто наттоға толы
Dialogue: 0,0:19:41.86,0:19:44.87,Default,,0,0,0,,Мен күрішті көре алмаймын
Dialogue: 0,0:19:44.87,0:19:46.87,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:19:46.87,0:19:48.80,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:19:48.80,0:19:50.80,Default,,0,0,0,,Қиын болып жатырсың ғой, солай ма?
