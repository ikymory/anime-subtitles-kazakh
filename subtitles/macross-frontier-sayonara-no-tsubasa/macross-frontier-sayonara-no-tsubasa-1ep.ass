Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.91,0:00:12.24,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:13.57,0:00:15.74,Default,,0,0,0,,Мен ән айтуды өмір деп ойладым...
Dialogue: 0,0:00:17.54,0:00:22.47,Default,,0,0,0,,Мен бәріміз мәңгі бірге болатынымызға сендім...
Dialogue: 0,0:00:24.21,0:00:29.64,Default,,0,0,0,,Бір нәрсені таңдау - бір нәрсені жоғалту дегенді білдіреді...
Dialogue: 0,0:00:31.57,0:00:33.01,Default,,0,0,0,,Сонда да мен...
Dialogue: 0,0:00:33.81,0:00:34.74,Default,,0,0,0,,Мен...
Dialogue: 0,0:00:35.77,0:00:36.87,Default,,0,0,0,,Мен...
Dialogue: 0,0:01:09.07,0:01:12.31,Default,,0,0,0,,Сіздің гендеріңіз
Dialogue: 0,0:01:12.51,0:01:18.44,Default,,0,0,0,,Менің ішімде аралас
Dialogue: 0,0:01:33.64,0:01:36.31,Default,,0,0,0,,Колбаның жұмсақ қисығы
Dialogue: 0,0:01:36.51,0:01:38.61,Default,,0,0,0,,Құмардан тамшылау
Dialogue: 0,0:01:39.11,0:01:41.41,Default,,0,0,0,,Әлемді өзгерту күші
Dialogue: 0,0:01:41.61,0:01:46.41,Default,,0,0,0,,Менің жүрегімді елжірететін алыс уәде
Dialogue: 0,0:01:47.51,0:01:50.11,Default,,0,0,0,,Кек - себеп сияқты
Dialogue: 0,0:01:50.34,0:01:52.87,Default,,0,0,0,,Жоғары-төмен шайқау
Dialogue: 0,0:01:53.11,0:01:55.24,Default,,0,0,0,,Өлтіретін қару емес.
Dialogue: 0,0:01:55.34,0:02:00.77,Default,,0,0,0,,Маған керегі – бір күрсіну
Dialogue: 0,0:02:00.91,0:02:03.64,Default,,0,0,0,,Жараны ашық қалдыру
Dialogue: 0,0:02:03.91,0:02:06.31,Default,,0,0,0,,Жеңіл симфония
Dialogue: 0,0:02:06.41,0:02:10.34,Default,,0,0,0,,Ерін сигналы әлдеқашан көк түсті
Dialogue: 0,0:02:10.67,0:02:13.37,Default,,0,0,0,,Тыйым салынған эликсир
Dialogue: 0,0:02:13.44,0:02:17.14,Default,,0,0,0,,Күнәнің ақырының нұры
Dialogue: 0,0:02:17.41,0:02:23.01,Default,,0,0,0,,Махаббат тудырған ғылым
Dialogue: 0,0:02:23.44,0:02:28.54,Default,,0,0,0,,Мен өліп жатырмын
Dialogue: 0,0:02:28.94,0:02:37.54,Default,,0,0,0,,Бір ғана түйме қалды
Dialogue: 0,0:02:38.14,0:02:42.77,Default,,0,0,0,,Синтетикалық
Dialogue: 0,0:02:43.84,0:02:47.14,Default,,0,0,0,,Бас сүйек 2-ден 4-ке дейін Қарсыластың күтілетін кездесу аймағына кіріңіз
Dialogue: 0,0:02:47.47,0:02:48.41,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:02:48.47,0:02:49.57,Default,,0,0,0,,Бұл келе жатыр!
Dialogue: 0,0:02:49.64,0:02:50.37,Default,,0,0,0,,Не?
Dialogue: 0,0:02:52.44,0:02:53.17,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,0:02:55.97,0:02:57.01,Default,,0,0,0,,Важра!
Dialogue: 0,0:02:59.67,0:03:00.91,Default,,0,0,0,,Арқаңызды маған қалдырыңыз!
Dialogue: 0,0:03:02.61,0:03:03.57,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:03:03.84,0:03:06.61,Default,,0,0,0,,Махаббат деген керемет нәрсе емес пе?
Dialogue: 0,0:03:06.67,0:03:09.07,Default,,0,0,0,,Тірі қайтып келсем ғой
Dialogue: 0,0:03:09.44,0:03:11.51,Default,,0,0,0,,Аңғал материалдар
Dialogue: 0,0:03:12.51,0:03:13.47,Default,,0,0,0,,...Шерил
Dialogue: 0,0:03:14.31,0:03:16.37,Default,,0,0,0,,Ранка-чан кешігіп келеді.
Dialogue: 0,0:03:16.47,0:03:17.24,Default,,0,0,0,,Бұл қандай да бір «Гя●ган» ба?!
Dialogue: 0,0:03:17.57,0:03:20.41,Default,,0,0,0,,миссиясы – мутация
Dialogue: 0,0:03:20.54,0:03:22.91,Default,,0,0,0,,Маған бүгін түннің шегінен шығуға рұқсат етіңіз
Dialogue: 0,0:03:23.07,0:03:25.54,Default,,0,0,0,,кезеңдегі қысқа жол
Dialogue: 0,0:03:25.64,0:03:30.84,Default,,0,0,0,,Богиня Кішкентай Ібіліс жұмбақтар мен жұмбақтар
Dialogue: 0,0:03:31.07,0:03:34.71,Default,,0,0,0,,Спиральдар айналады
Dialogue: 0,0:03:34.77,0:03:35.61,Default,,0,0,0,,Ән?
Dialogue: 0,0:03:36.47,0:03:40.67,Default,,0,0,0,,Қаласаң өміріңді босқа өткізбе.
Dialogue: 0,0:03:40.81,0:03:43.51,Default,,0,0,0,,Тыйым салынған эликсир
Dialogue: 0,0:03:43.71,0:03:47.41,Default,,0,0,0,,Аз жылу және жарық
Dialogue: 0,0:03:47.64,0:03:53.21,Default,,0,0,0,,Махаббат тудырған ғылым
Dialogue: 0,0:03:53.64,0:03:58.64,Default,,0,0,0,,Ашу
Dialogue: 0,0:03:59.14,0:04:08.54,Default,,0,0,0,,Мен шекара сызығынан асып жатырмын
Dialogue: 0,0:04:08.61,0:04:14.34,Default,,0,0,0,,Меланхолия
Dialogue: 0,0:04:18.11,0:04:18.91,Default,,0,0,0,,Және…
Dialogue: 0,0:04:19.31,0:04:20.91,Default,,0,0,0,,Ах! Шерил!
Dialogue: 0,0:04:46.41,0:04:49.17,Default,,0,0,0,,2059 ж
Dialogue: 0,0:04:50.14,0:04:56.84,Default,,0,0,0,,Макросс шекарасына кеңейту үшін жаңа орын іздеу үшін галактика арқылы саяхаттап жүрген өте үлкен иммигранттар флоты
Dialogue: 0,0:04:57.61,0:05:01.04,Default,,0,0,0,,Галактикалық ертегі Шерил Ном төмендейді...
Dialogue: 0,0:05:03.51,0:05:09.51,Default,,0,0,0,,Бірде әдемі, бірде сиқырлы, сырлы ән айтып, билейді
Dialogue: 0,0:05:12.31,0:05:17.11,Default,,0,0,0,,Шерилге тәнті болған Ранка Ли әнші болуға ұмтылады
Dialogue: 0,0:05:19.44,0:05:22.71,Default,,0,0,0,,Бізді де, шекараны да қорғау.
Dialogue: 0,0:05:23.47,0:05:28.44,Default,,0,0,0,,Аруто Саотоме жеке әскери компания S.M.S.
Dialogue: 0,0:05:32.87,0:05:37.74,Default,,0,0,0,,Ақпарат пен энергияны уақыт пен кеңістіктен тыс тасымалдайтын сирек кен.
Dialogue: 0,0:05:38.07,0:05:39.71,Default,,0,0,0,,Бүктелген кварц ресурстары және
Dialogue: 0,0:05:40.34,0:05:45.94,Default,,0,0,0,,Бүктелген толқынмен резонанс тудыратын және оны басқаруға күші бар диваның құпиясы.
Dialogue: 0,0:05:46.44,0:05:49.51,Default,,0,0,0,,Әртүрлі ойлар тоғысады
Dialogue: 0,0:05:52.61,0:05:57.27,Default,,0,0,0,,Сол кезде белгісіз өте өлшемді тіршілік формаларының шоғыры, Важра,
Dialogue: 0,0:05:57.61,0:05:59.97,Default,,0,0,0,,Шекара флотына қайтадан шабуыл жасаңыз
Dialogue: 0,0:06:03.87,0:06:04.97,Default,,0,0,0,,Мен бұны бұрыннан-ақ есіме түсіріп қойдым, білесің бе.
Dialogue: 0,0:06:05.11,0:06:07.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:07.77,0:06:08.51,Default,,0,0,0,,Ранка-чан!
Dialogue: 0,0:06:09.07,0:06:11.11,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:06:11.24,0:06:12.21,Default,,0,0,0,,Альто... сіз
Dialogue: 0,0:06:13.04,0:06:18.27,Default,,0,0,0,,Қиян-кескі ұрыс кезінде колоннаны Важра шабуылынан қорғау үшін.
Dialogue: 0,0:06:18.97,0:06:23.27,Default,,0,0,0,,Ранка ән айтып, өз өмірімен күреседі.
Dialogue: 0,0:06:23.94,0:06:24.94,Default,,0,0,0,,Шерил
Dialogue: 0,0:06:25.41,0:06:28.17,Default,,0,0,0,,Ал Альто және достары
Dialogue: 0,0:06:40.84,0:06:43.64,Default,,0,0,0,,Рахмет... Альто... Ранка-чан...
Dialogue: 0,0:06:46.74,0:06:50.21,Default,,0,0,0,,Енді мен жалғыз емес екенімді білемін...
Dialogue: 0,0:06:55.87,0:06:57.07,Default,,0,0,0,,Шерил
Dialogue: 0,0:06:58.94,0:07:01.31,Default,,0,0,0,,...Мен жалғыз емеспін... иә...
Dialogue: 0,0:07:10.57,0:07:13.94,Default,,0,0,0,,Олардың болашағы қазір...
Dialogue: 0,0:07:17.37,0:07:20.24,Default,,0,0,0,,Шерил Ном кеше концерт кезінде құлап қалды.
Dialogue: 0,0:07:20.47,0:07:23.51,Default,,0,0,0,,Бұл жай ғана шамадан тыс жұмыс емес, бұл қандай да бір ауыр дерт...
Dialogue: 0,0:07:24.64,0:07:27.64,Default,,0,0,0,,Олар не қаласа, соны жазды...
Dialogue: 0,0:07:30.24,0:07:31.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:33.47,0:07:34.44,Default,,0,0,0,,Шерил мырза?
Dialogue: 0,0:07:34.67,0:07:35.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:36.71,0:07:38.87,Default,,0,0,0,,О, Ранка-чан, қалайсың?
Dialogue: 0,0:07:39.34,0:07:40.57,Default,,0,0,0,,Менде бәрі жақсы... Сонымен...
Dialogue: 0,0:07:41.21,0:07:44.41,Default,,0,0,0,,Шерил сол! Физикалық тұрғыдан өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:07:45.01,0:07:48.71,Default,,0,0,0,,Кішкене анемия, тым қатты ән салдым.
Dialogue: 0,0:07:49.41,0:07:51.01,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:07:51.41,0:07:55.14,Default,,0,0,0,,Аа, дұрыс, мен кемпірқосақ түсті аюды естідім.
Dialogue: 0,0:07:55.61,0:07:57.14,Default,,0,0,0,,Бұл сүйкімді ән емес
Dialogue: 0,0:07:57.74,0:08:00.37,Default,,0,0,0,,Ах... Рахмет!
Dialogue: 0,0:08:01.31,0:08:03.97,Default,,0,0,0,,Қараңызшы, сіз де бірдеңе айтуыңыз керек.
Dialogue: 0,0:08:04.34,0:08:05.14,Default,,0,0,0,,А...?
Dialogue: 0,0:08:05.71,0:08:06.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:07.14,0:08:09.94,Default,,0,0,0,,А... бұл Альто-кун ба?
Dialogue: 0,0:08:10.54,0:08:12.21,Default,,0,0,0,,Бұл жақшалар қандай?
Dialogue: 0,0:08:12.51,0:08:15.91,Default,,0,0,0,,Мен сол операциядан бері осы жігітке жұмысқа тұрдым.
Dialogue: 0,0:08:16.21,0:08:19.11,Default,,0,0,0,,S.M.S Шекара бөлімшесінің мүшелері кезектесіп отырады
Dialogue: 0,0:08:19.51,0:08:21.87,Default,,0,0,0,,Тыңшылық жасады деген күдік толығымен жойылған жоқ.
Dialogue: 0,0:08:22.17,0:08:23.57,Default,,0,0,0,,Оның бақылау мағынасы да бар.
Dialogue: 0,0:08:23.64,0:08:25.91,Default,,0,0,0,,Мен шынымен де күдіктенемін.
Dialogue: 0,0:08:26.24,0:08:27.64,Default,,0,0,0,,Себебі мен күдіктерімнен арылғым келеді
Dialogue: 0,0:08:27.71,0:08:30.74,Default,,0,0,0,,Менің артымнан оққағар болып ерген болуыңыз керек!
Dialogue: 0,0:08:31.27,0:08:33.11,Default,,0,0,0,,Мен қаламақы төлеймін.
Dialogue: 0,0:08:33.44,0:08:36.14,Default,,0,0,0,,Басқаша айтқанда, менің бұйрықтарымды толығымен орындаңыз.
Dialogue: 0,0:08:36.37,0:08:38.51,Default,,0,0,0,,Демек, альто менікі.
Dialogue: 0,0:08:38.71,0:08:40.14,Default,,0,0,0,,...
Dialogue: 0,0:08:40.54,0:08:41.54,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:08:41.77,0:08:44.67,Default,,0,0,0,,Міне! Дәл қазір не елестедіңіз?
Dialogue: 0,0:08:45.37,0:08:46.81,Default,,0,0,0,,-ге... Осымен.
Dialogue: 0,0:08:46.94,0:08:49.24,Default,,0,0,0,,Хех сүйкімді
Dialogue: 0,0:08:50.51,0:08:51.71,Default,,0,0,0,,Гохо, гохо…
Dialogue: 0,0:08:51.84,0:08:52.44,Default,,0,0,0,,Шерил!
Dialogue: 0,0:08:52.57,0:08:53.61,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:08:53.77,0:08:55.71,Default,,0,0,0,,Неге үрейленесің? Жарайды.\NТіпті
Dialogue: 0,0:08:56.54,0:08:59.04,Default,,0,0,0,,тым көп созылу.
Dialogue: 0,0:08:59.57,0:09:01.41,Default,,0,0,0,,Сіз шынымен осылай ән айтқыңыз келе ме?
Dialogue: 0,0:09:01.74,0:09:05.37,Default,,0,0,0,,Айқын емес.Ән айту менің бар болу себебім.
Dialogue: 0,0:09:06.74,0:09:08.91,Default,,0,0,0,,Мен ән айту үшін өмір сүремін
Dialogue: 0,0:09:09.87,0:09:12.31,Default,,0,0,0,,Сіз де солай, солай ма? Ранка-чан
Dialogue: 0,0:09:12.47,0:09:13.04,Default,,0,0,0,,А...
Dialogue: 0,0:09:13.17,0:09:15.07,Default,,0,0,0,,Әндеріңізде де құдірет бар
Dialogue: 0,0:09:15.67,0:09:17.07,Default,,0,0,0,,О... дұрыс.
Dialogue: 0,0:09:19.31,0:09:19.91,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:20.14,0:09:23.64,Default,,0,0,0,,Шерил мен қазір кетуім керек.
Dialogue: 0,0:09:24.97,0:09:27.07,Default,,0,0,0,,О, Шерил-сан.
Dialogue: 0,0:09:28.81,0:09:34.17,Default,,0,0,0,,Бұл! Бұл келесі демалыс күндері менің алғашқы тікелей шоуыма шақыру...
Dialogue: 0,0:09:34.77,0:09:37.37,Default,,0,0,0,,Аа, сен мұны істеуге тым бос емессің...
Dialogue: 0,0:09:37.64,0:09:38.31,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:09:38.41,0:09:39.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:39.81,0:09:42.37,Default,,0,0,0,,Грейс, кестеңізді дереу реттеңіз.
Dialogue: 0,0:09:42.61,0:09:43.41,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:44.01,0:09:46.47,Default,,0,0,0,,Олай болса, мен тікелей эфирді асыға күтемін.
Dialogue: 0,0:09:50.31,0:09:51.04,Default,,0,0,0,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,0:09:51.11,0:09:52.51,Default,,0,0,0,,Ах... Альто-кун
Dialogue: 0,0:09:54.17,0:09:55.77,Default,,0,0,0,,Мен оны ағамнан естідім.
Dialogue: 0,0:09:55.97,0:09:59.51,Default,,0,0,0,,S.M.S тобының барлығы Майя аралына жайлы саяхатқа барады, солай ма?
Dialogue: 0,0:09:59.77,0:10:00.77,Default,,0,0,0,,Ааа
Dialogue: 0,0:10:00.91,0:10:03.97,Default,,0,0,0,,Мен де, түстен кейін кеттім.
Dialogue: 0,0:10:04.61,0:10:06.77,Default,,0,0,0,,Қарсы болмасаңыз, мен сізбен кездесе алмаймын...мүмкін?
Dialogue: 0,0:10:07.04,0:10:08.84,Default,,0,0,0,,Жүр, сондай адам.
Dialogue: 0,0:10:13.14,0:10:14.44,Default,,0,0,0,,Брера мырза...
Dialogue: 0,0:10:14.81,0:10:16.94,Default,,0,0,0,,Эй Брелла, бұл нені білдіреді?
Dialogue: 0,0:10:17.17,0:10:20.57,Default,,0,0,0,,Қолдарың жақсы, бірақ жүрегің жоқ.
Dialogue: 0,0:10:21.04,0:10:22.87,Default,,0,0,0,,Барлығы жартылай пісірілген
Dialogue: 0,0:10:23.31,0:10:24.37,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:10:24.81,0:10:27.67,Default,,0,0,0,,Эй, сен не істеп жатырсың? Барайық!
Dialogue: 0,0:10:30.61,0:10:31.74,Default,,0,0,0,,Кейінірек электрондық пошта
Dialogue: 0,0:10:32.01,0:10:33.24,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:10:37.61,0:10:42.41,Default,,0,0,0,,Код Q1 Ранка Ли тұрақты өсіп келе жатқан сияқты.
Dialogue: 0,0:10:42.87,0:10:47.74,Default,,0,0,0,,Егер бәрі осылай жалғаса берсе, кодты талдау тағы бірнеше шайқаста аяқталады.
Dialogue: 0,0:10:49.37,0:10:53.97,Default,,0,0,0,,Соңында екеуінің қайсысын орта ретінде пайдалануды жоспарлайсыз?
Dialogue: 0,0:10:55.01,0:10:57.61,Default,,0,0,0,,Шерилдің тамағы енді шыдамайды, солай ма?
Dialogue: 0,0:10:58.01,0:11:02.41,Default,,0,0,0,,Қатпарлы бактериялар Ранка Лимен байланыста болғандықтан тез көбейеді.
Dialogue: 0,0:11:03.11,0:11:06.51,Default,,0,0,0,,Дауыс байламдары дереу жойылмаса, тірі қалуға мүмкіндік жоқ.
Dialogue: 0,0:11:07.27,0:11:12.14,Default,,0,0,0,,Бірақ егер патшайым мен пері бір-біріне айналса...
Dialogue: 0,0:11:12.44,0:11:15.67,Default,,0,0,0,,Ваджраға бақылау күшейетін сияқты.
Dialogue: 0,0:11:16.67,0:11:17.77,Default,,0,0,0,,Портинг?
Dialogue: 0,0:11:17.91,0:11:21.51,Default,,0,0,0,,Хмф, екеуін де жоғалту ықтималдығы жоғары.
Dialogue: 0,0:11:21.91,0:11:24.77,Default,,0,0,0,,Жоқ... қатпарлы бактериялардың күші
Dialogue: 0,0:11:24.84,0:11:28.54,Default,,0,0,0,,Бұл қабылдаушы диваның еркімен болмаса, ол көрінбейді.
Dialogue: 0,0:11:29.27,0:11:33.44,Default,,0,0,0,,Сонда есте сақтау қабілетінің төмендеуіне байланысты Ранка Лидің күші тұрақсыз.
Dialogue: 0,0:11:33.81,0:11:36.17,Default,,0,0,0,,Шерилдің еркіне қосыла алсам...
Dialogue: 0,0:11:36.81,0:11:41.67,Default,,0,0,0,,Қалай болғанда да, біз қайту үшін конвойдан айырылып қалдық, сондықтан біз Ваджрадан шықтық.
Dialogue: 0,0:11:42.17,0:11:45.94,Default,,0,0,0,,Біз олардың патшайымы тұратын планетаны алуымыз керек.
Dialogue: 0,0:11:47.07,0:11:50.77,Default,,0,0,0,,Тіпті Протокультур қорқатын супер-уақыттық тіршілік иелері
Dialogue: 0,0:11:51.41,0:11:54.14,Default,,0,0,0,,Важраның қатпарлы желісі
Dialogue: 0,0:11:54.87,0:11:56.71,Default,,0,0,0,,Содан кейін галактика
Dialogue: 0,0:11:57.41,0:11:59.44,Default,,0,0,0,,Біздікі бол
Dialogue: 0,0:12:01.61,0:12:04.04,Default,,0,0,0,,Уақытымыз аз қалды.
Dialogue: 0,0:12:05.24,0:12:07.41,Default,,0,0,0,,Жақсы, полковник Грейс.
Dialogue: 0,0:12:08.17,0:12:09.31,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:12:14.11,0:12:17.47,Default,,0,0,0,,Қанша күн болса да, сұлулықты өшіру мүмкін емес...
Dialogue: 0,0:12:18.67,0:12:20.94,Default,,0,0,0,,Терімді қорғаңыз!
Dialogue: 0,0:12:21.47,0:12:25.27,Default,,0,0,0,,Жарқырау Gnome Pure Shield өлшемінен алынған
Dialogue: 0,0:12:26.41,0:12:27.91,Default,,0,0,0,,Ио~
Dialogue: 0,0:12:29.74,0:12:30.87,Default,,0,0,0,,Альто-кун?
Dialogue: 0,0:12:32.27,0:12:33.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:33.84,0:12:35.81,Default,,0,0,0,,Уфуфу күтесіз бе?
Dialogue: 0,0:12:36.27,0:12:39.04,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:12:40.04,0:12:43.44,Default,,0,0,0,,Әй, жоқ, маған көп қарап қалма!
Dialogue: 0,0:12:43.57,0:12:44.94,Default,,0,0,0,,Қарама!
Dialogue: 0,0:12:45.57,0:12:46.24,Default,,0,0,0,,Өтірік
Dialogue: 0,0:12:46.37,0:12:47.64,Default,,0,0,0,,Бұл өтірік емес!
Dialogue: 0,0:12:47.77,0:12:48.41,Default,,0,0,0,,Pi?
Dialogue: 0,0:12:48.47,0:12:49.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:10.04,0:13:11.14,Default,,0,0,0,,...
Dialogue: 0,0:13:13.77,0:13:14.64,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:13:16.47,0:13:17.64,Default,,0,0,0,,Қазірдің өзінде!
Dialogue: 0,0:13:24.34,0:13:25.24,Default,,0,0,0,,Хмф...!
Dialogue: 0,0:13:25.94,0:13:27.07,Default,,0,0,0,,Иә
Dialogue: 0,0:13:27.57,0:13:29.17,Default,,0,0,0,,Қайда болдың, әпке?
Dialogue: 0,0:13:31.94,0:13:32.94,Default,,0,0,0,,Уау...
Dialogue: 0,0:13:35.27,0:13:36.87,Default,,0,0,0,,Егер мұны істесеңіз...
Dialogue: 0,0:13:37.07,0:13:40.54,Default,,0,0,0,,Важрамен төбелесіп жатқаның өтірік сияқты.
Dialogue: 0,0:13:40.64,0:13:41.67,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:13:42.27,0:13:43.81,Default,,0,0,0,,Сіз қалай ойлайсыз? Жұмыс істейтіндерге
Dialogue: 0,0:13:44.21,0:13:47.41,Default,,0,0,0,,Мен күн сайын қолымнан келгеннің бәрін істеп жатқандай сезінемін.
Dialogue: 0,0:13:47.71,0:13:50.27,Default,,0,0,0,,Теледидарда, журналдарда, сабақтарда...
Dialogue: 0,0:13:50.47,0:13:54.87,Default,,0,0,0,,Әй, өйткені кешегі күні шығарма мұғалімі шыңды көтере берді.
Dialogue: 0,0:13:55.04,0:13:56.97,Default,,0,0,0,,Оның өте жоғары дауысы бар еді...
Dialogue: 0,0:13:57.34,0:14:00.04,Default,,0,0,0,,Менің көзім айналып тұрғандай.
Dialogue: 0,0:14:01.14,0:14:02.54,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:14:02.84,0:14:07.17,Default,,0,0,0,,Шерилмен бірге шекара флотын дағдарыстан құтқарған үміт жұлдызы.
Dialogue: 0,0:14:07.47,0:14:09.61,Default,,0,0,0,,«Супер өлшемді Золушканың» танымалдығы
Dialogue: 0,0:14:10.21,0:14:11.64,Default,,0,0,0,,бітті
Dialogue: 0,0:14:12.14,0:14:15.37,Default,,0,0,0,,Жаңа ғана ойымнан шығып кеттім.
Dialogue: 0,0:14:15.94,0:14:18.64,Default,,0,0,0,,Неліктен бұлай істегенім есімде жоқ...
Dialogue: 0,0:14:20.14,0:14:24.71,Default,,0,0,0,,Сонда да Альто-кун маған көмектеспесе...
Dialogue: 0,0:14:25.57,0:14:26.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:28.77,0:14:29.87,Default,,0,0,0,,Сіз Важра туралы айтып отырсыз ба?
Dialogue: 0,0:14:30.07,0:14:30.94,Default,,0,0,0,,Не? …
Dialogue: 0,0:14:31.37,0:14:34.64,Default,,0,0,0,,Маған уайымдайтын нәрсе бар деп қоңырау шалмадыңыз ба?
Dialogue: 0,0:14:35.57,0:14:36.44,Default,,0,0,0,,…Неге?
Dialogue: 0,0:14:36.77,0:14:40.14,Default,,0,0,0,,Себебі сен бүгін тым толқып тұрсың.
Dialogue: 0,0:14:41.31,0:14:42.54,Default,,0,0,0,,Альто-кун...
Dialogue: 0,0:14:51.37,0:14:56.97,Default,,0,0,0,,...Ей, Альто-кун, сен неге мені Важра өлтірмеді деп ойлайсың?
Dialogue: 0,0:14:57.17,0:14:57.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:58.04,0:15:02.14,Default,,0,0,0,,Неге мені өлтірмей, ұстап алып, үйге апармайсың?
Dialogue: 0,0:15:03.47,0:15:05.81,Default,,0,0,0,,Ойланып қарасаң, мынаны айтасың...
Dialogue: 0,0:15:07.57,0:15:12.51,Default,,0,0,0,,Сол кез есіме түссе, мен біртүрлі сезімде боламын...
Dialogue: 0,0:15:13.11,0:15:13.97,Default,,0,0,0,,Қызық?
Dialogue: 0,0:15:14.11,0:15:14.97,Default,,0,0,0,,Иә
Dialogue: 0,0:15:16.07,0:15:17.64,Default,,0,0,0,,Күлмей тыңдай аласыз ба?
Dialogue: 0,0:15:18.34,0:15:19.84,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:15:25.84,0:15:31.74,Default,,0,0,0,,Сол кезде мені Важра ұстап алып, оның асқазанына қамап тастаған кезде...
Dialogue: 0,0:15:32.41,0:15:37.07,Default,,0,0,0,,Бұл қорқынышты болуы керек, бірақ әйтеуір сағыныш сезімі бар...
Dialogue: 0,0:15:37.87,0:15:41.11,Default,,0,0,0,,Маған олар ақырын үйге қайт деп айтып жатқандай...
Dialogue: 0,0:15:41.21,0:15:44.47,Default,,0,0,0,,Бух хаха... Бұлай болуы мүмкін емес.
Dialogue: 0,0:15:44.91,0:15:46.34,Default,,0,0,0,,Қараңдаршы, мен күлдім.
Dialogue: 0,0:15:46.44,0:15:50.01,Default,,0,0,0,,Дұрыс, Ваджраның миы жоқ...
Dialogue: 0,0:15:50.67,0:15:55.04,Default,,0,0,0,,Ондай ақымақ нәрселерді ойлама... Қалағаныңды істейсің.
Dialogue: 0,0:15:55.34,0:15:56.81,Default,,0,0,0,,-Ән туралы... -Ақымақ нәрсе ме?
Dialogue: 0,0:15:56.87,0:15:57.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:58.61,0:16:02.61,Default,,0,0,0,,Миың кішкентай болса... жүрегің жоқ шығар...
Dialogue: 0,0:16:03.91,0:16:08.01,Default,,0,0,0,,Қазір шырылдаған жәндіктердің сезімі де, жүрегі де жоқ дейсіз бе?
Dialogue: 0,0:16:08.61,0:16:12.31,Default,,0,0,0,,Қызық, анау пальмалар мен гүлдер ештеңені сезбейді ме...
Dialogue: 0,0:16:13.37,0:16:14.41,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:16.31,0:16:17.07,Default,,0,0,0,,Pi…
Dialogue: 0,0:16:18.44,0:16:20.24,Default,,0,0,0,,Дыбыстық сигнал…
Dialogue: 0,0:16:28.31,0:16:34.64,Default,,0,0,0,,Аймо Аймо Надер Руше
Dialogue: 0,0:16:35.21,0:16:42.11,Default,,0,0,0,,Ноина Милия Эндер Продеа
Dialogue: 0,0:16:42.64,0:16:45.41,Default,,0,0,0,,Фотоми
Dialogue: 0,0:16:46.44,0:16:55.54,Default,,0,0,0,,Бұл жылы теңіз.
Dialogue: 0,0:17:04.61,0:17:09.57,Default,,0,0,0,,Лулея Лелея
Dialogue: 0,0:17:09.84,0:17:14.54,Default,,0,0,0,,Аспанда билеген Хибари Ханами
Dialogue: 0,0:17:15.27,0:17:20.24,Default,,0,0,0,,Лулея Лелея
Dialogue: 0,0:17:20.64,0:17:25.64,Default,,0,0,0,,Мейірімдісің, жасыл бала
Dialogue: 0,0:17:26.37,0:17:31.64,Default,,0,0,0,,Аймо Аймо Надер Руше
Dialogue: 0,0:17:32.14,0:17:37.87,Default,,0,0,0,,Ноина Милия Эндер Продеа
Dialogue: 0,0:17:38.67,0:17:40.37,Default,,0,0,0,,Фотоми
Dialogue: 0,0:17:40.74,0:17:41.67,Default,,0,0,0,,Ранка…
Dialogue: 0,0:17:59.21,0:18:03.01,Default,,0,0,0,,Сіз не істеп жатырсыз? Рұқсатсыз төсектен тұрыңыз!
Dialogue: 0,0:18:04.31,0:18:05.94,Default,,0,0,0,,Жауап Шерил
Dialogue: 0,0:18:06.87,0:18:08.21,Default,,0,0,0,,Гохо! Гохо…
Dialogue: 0,0:18:08.67,0:18:09.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:09.94,0:18:14.24,Default,,0,0,0,,Гохо! Гохо…
Dialogue: 0,0:18:14.97,0:18:15.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:21.81,0:18:23.94,Default,,0,0,0,,Тағдырдың айласы...
Dialogue: 0,0:18:28.34,0:18:31.04,Default,,0,0,0,,Шерил... сенің тамағың...
Dialogue: 0,0:18:31.17,0:18:35.74,Default,,0,0,0,,Осы уақытқа дейін жеткен V типті инфекцияның толық емделуіне үміт жоқ...
Dialogue: 0,0:18:35.81,0:18:37.61,Default,,0,0,0,,Сонда сіз маған ота жасатыңыз деп жатырсыз ба?
Dialogue: 0,0:18:37.94,0:18:40.34,Default,,0,0,0,,Дауыс байламдарын кесу операциясы.
Dialogue: 0,0:18:40.97,0:18:42.97,Default,,0,0,0,,Келісімшарт бастапқыда солай емес пе?
Dialogue: 0,0:18:44.27,0:18:45.51,Default,,0,0,0,,Q-1 коды
Dialogue: 0,0:18:45.81,0:18:49.34,Default,,0,0,0,,V типті инфекцияларға иммунитетпен туылған
Dialogue: 0,0:18:49.41,0:18:52.11,Default,,0,0,0,,Қуатты қатпарлы толқын генерациялау қабілетіне ие
Dialogue: 0,0:18:52.24,0:18:56.07,Default,,0,0,0,,Біз Важраға қарсы операция үшін диваны тапқанша, стенд ретінде...
Dialogue: 0,0:18:56.17,0:18:57.47,Default,,0,0,0,,Мен мұны білемін!
Dialogue: 0,0:18:58.24,0:19:00.54,Default,,0,0,0,,Өлеңді тастай сал деп жатсың ғой!
Dialogue: 0,0:19:00.91,0:19:05.41,Default,,0,0,0,,Жоқ, мен ешқашан ән айта алмағанша өлгенім артық!
Dialogue: 0,0:19:05.64,0:19:07.07,Default,,0,0,0,,Гохо гохо гохо гохо…
Dialogue: 0,0:19:07.17,0:19:08.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:08.47,0:19:10.11,Default,,0,0,0,,Гохо гохо гохо гохо…
Dialogue: 0,0:19:10.67,0:19:12.54,Default,,0,0,0,,...Мен оны көрмесем де...
Dialogue: 0,0:19:12.71,0:19:16.07,Default,,0,0,0,,А... бұл...
Dialogue: 0,0:19:20.94,0:19:24.97,Default,,0,0,0,,Әнді де, өмірді де сақтап қалудың жолы болса...
Dialogue: 0,0:19:25.17,0:19:26.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:28.84,0:19:34.04,Default,,0,0,0,,Мен... Мен Ваджрада да... сезімдер мен жүректер бар сияқты...
Dialogue: 0,0:19:34.37,0:19:35.31,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:37.44,0:19:39.47,Default,,0,0,0,,Ондай нәрсе болуы мүмкін емес!
Dialogue: 0,0:19:44.47,0:19:48.94,Default,,0,0,0,,Ал оның ақылы болса да, неге олай маған шабуыл жасайды?
Dialogue: 0,0:19:49.61,0:19:54.21,Default,,0,0,0,,Көптеген адамдар Шекарада да, Галактикада да құрбан болды.
Dialogue: 0,0:19:55.21,0:19:56.31,Default,,0,0,0,,...Бұл...
Dialogue: 0,0:19:57.21,0:19:58.64,Default,,0,0,0,,Қарау...
Dialogue: 0,0:19:58.87,0:20:00.21,Default,,0,0,0,,Мен сені қорғаймын.
Dialogue: 0,0:20:00.74,0:20:05.61,Default,,0,0,0,,Қалай ойласаң да, өмірім болса да, сені Важрадан қорғаймын.
Dialogue: 0,0:20:06.67,0:20:07.61,Default,,0,0,0,,...Альто-кун...
Dialogue: 0,0:20:09.54,0:20:10.74,Default,,0,0,0,,Мен саған ешқашан осы туралы сұрастырамын деп айтқан жоқпын
Dialogue: 0,0:20:11.81,0:20:12.84,Default,,0,0,0,,−Уау! -Ах!
Dialogue: 0,0:20:13.47,0:20:14.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:14.44,0:20:15.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:15.64,0:20:16.94,Default,,0,0,0,,Балалар, не істеп жатырсыңдар?!
Dialogue: 0,0:20:17.07,0:20:17.84,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:20:20.97,0:20:22.21,Default,,0,0,0,,Ол маған айтты
Dialogue: 0,0:20:22.41,0:20:24.11,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:20:24.27,0:20:27.81,Default,,0,0,0,,қалпақ! Ол мен үшін оны жауып тастады! Ол ұшатын сияқты болды!
Dialogue: 0,0:20:28.44,0:20:29.44,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:20:29.57,0:20:30.41,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:20:30.71,0:20:32.71,Default,,0,0,0,,Бұл не, ағайын?
Dialogue: 0,0:20:32.91,0:20:34.07,Default,,0,0,0,,Төтенше жағдайды жөнелту.
Dialogue: 0,0:20:34.31,0:20:38.07,Default,,0,0,0,,Мен телефонын өшіріп тастаған ақымақты табу үшін жол бойы келдім!
Dialogue: 0,0:20:38.54,0:20:39.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:40.47,0:20:41.57,Default,,0,0,0,,…Жіберу?
Dialogue: 0,0:20:48.57,0:20:54.04,Default,,0,0,0,,Егер біз Ранканың барлық қанын, оның ішінде оның иммундық жүйесі мен ішкі мүшелерін ауыстырсақ...
Dialogue: 0,0:20:54.44,0:20:58.14,Default,,0,0,0,,Бұл иммунитет сізді құтқаруы мүмкін.
Dialogue: 0,0:20:59.57,0:21:01.57,Default,,0,0,0,,Өмір мен жырлар...
Dialogue: 0,0:21:06.21,0:21:07.41,Default,,0,0,0,,Жақында келеді
Dialogue: 0,0:21:07.47,0:21:08.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:09.54,0:21:11.37,Default,,0,0,0,,Ендеше мұқият қарайық
Dialogue: 0,0:21:11.54,0:21:15.14,Default,,0,0,0,,Super Dimension Золушканың соңғы кезеңі
Dialogue: 0,0:21:17.51,0:21:19.24,Default,,0,0,0,,Сіз бір нәрсеге алаңдайсыз ба?
Dialogue: 0,0:21:19.47,0:21:20.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:20.84,0:21:22.74,Default,,0,0,0,,Өйткені сіз бетіңізде бос көзқарасты сақтайсыз
Dialogue: 0,0:21:23.27,0:21:25.27,Default,,0,0,0,,…Иә, жақсы.
Dialogue: 0,0:21:25.67,0:21:27.04,Default,,0,0,0,,Олай болса күлейік
Dialogue: 0,0:21:27.41,0:21:30.07,Default,,0,0,0,,Барлығы Ранка-санның күлкісін күтуде.
Dialogue: 0,0:21:31.07,0:21:33.01,Default,,0,0,0,,Иә, рахмет Нанасе-сан.
Dialogue: 0,0:21:47.11,0:21:49.01,Default,,0,0,0,,Бодльзар класындағы бекініс?
Dialogue: 0,0:21:58.27,0:22:04.01,Default,,0,0,0,,Лиламель Ларамель жүгіру Лула жүгіру Лиламель Ларамель жүгіру Лула жүгіру
Dialogue: 0,0:22:04.54,0:22:10.51,Default,,0,0,0,,Лиламель Ларамель жүгіру Лула жүгіру Лиламель Ларамель жүгіру Лула жүгіру
Dialogue: 0,0:22:12.07,0:22:17.01,Default,,0,0,0,,Лиламель Ларамель жүгіру Лула жүгіру Лиламель Ларамель жүгіру Лула жүгіру
Dialogue: 0,0:22:17.17,0:22:21.87,Default,,0,0,0,,Лиламель Ларамель жүгіру Лула жүгіру Лиламель Ларамель жүгіру Лула жүгіру
Dialogue: 0,0:22:29.14,0:22:31.81,Default,,0,0,0,,Ұзақ уақыт аспан болды
Dialogue: 0,0:22:32.21,0:22:34.31,Default,,0,0,0,,Мен өзімді жалғыз сезіндім.
Dialogue: 0,0:22:36.41,0:22:42.84,Default,,0,0,0,,Қолыңнан ұстап күлгенімде де
Dialogue: 0,0:22:43.01,0:22:50.47,Default,,0,0,0,,Біз неден қорқтық, нені жасырдық?
Dialogue: 0,0:22:50.61,0:22:56.21,Default,,0,0,0,,Қазір кеуденің кілтін ашыңыз!
Dialogue: 0,0:22:56.54,0:22:57.91,Default,,0,0,0,,«Ланканы ашыңыз!»
Dialogue: 0,0:22:58.41,0:23:01.34,Default,,0,0,0,,Қала гүлге толы
Dialogue: 0,0:23:01.67,0:23:05.07,Default,,0,0,0,,Тастар тәттіге айналады
Dialogue: 0,0:23:05.54,0:23:08.34,Default,,0,0,0,,Көз жасыңды сүрт
Dialogue: 0,0:23:08.87,0:23:12.14,Default,,0,0,0,,Орамал кішкентай құсқа айналады.
Dialogue: 0,0:23:12.74,0:23:15.97,Default,,0,0,0,,Жоғалған баланың махаббаты
Dialogue: 0,0:23:16.41,0:23:19.47,Default,,0,0,0,,Кемпірқосақ арқылы
Dialogue: 0,0:23:19.97,0:23:23.37,Default,,0,0,0,,Саған жетеді, міндетті түрде жетеді.
Dialogue: 0,0:23:27.11,0:23:30.61,Default,,0,0,0,,Қыз жүрек, батыл бол
Dialogue: 0,0:23:44.84,0:23:49.74,Default,,0,0,0,,Тірі болсам жүрегімді елжіретеді.
Dialogue: 0,0:23:52.07,0:23:56.74,Default,,0,0,0,,Болашақтың салмағын сөздікпен өлшеу кірпіштей
Dialogue: 0,0:23:56.81,0:23:57.94,Default,,0,0,0,,Барлығы бірге!
Dialogue: 0,0:23:58.57,0:24:02.71,Default,,0,0,0,,Мен өмір сүру үшін бар күшімді салуым керек.
Dialogue: 0,0:24:03.04,0:24:08.21,Default,,0,0,0,,Іздегеніңіз осы сандықта екені сөзсіз
Dialogue: 0,0:24:08.54,0:24:11.84,Default,,0,0,0,,Енді аюды ашыңыз
Dialogue: 0,0:24:12.07,0:24:13.64,Default,,0,0,0,,"Ланканы ашыңыз!"
Dialogue: 0,0:24:14.01,0:24:17.11,Default,,0,0,0,,Біркелкі киім көйлек болады
Dialogue: 0,0:24:17.31,0:24:20.57,Default,,0,0,0,,Менің сөмкемде мұхит бар
Dialogue: 0,0:24:21.01,0:24:24.07,Default,,0,0,0,,Шөлге түсіп кет
Dialogue: 0,0:24:24.54,0:24:27.84,Default,,0,0,0,,Теңізде дельфиндермен ойнайық
Dialogue: 0,0:24:28.37,0:24:35.04,Default,,0,0,0,,Армандар жүру ырғағымен орындалады
Dialogue: 0,0:24:35.54,0:24:38.84,Default,,0,0,0,,Қыз жүрек, батыл бол
Dialogue: 0,0:24:39.14,0:24:42.34,Default,,0,0,0,,Фортепиано аспанда ұшады
Dialogue: 0,0:24:42.47,0:24:45.84,Default,,0,0,0,,Хошикуззу музыкалық нотаға айналады
Dialogue: 0,0:24:46.34,0:24:49.47,Default,,0,0,0,,Құбыжықтар ән айтады
Dialogue: 0,0:24:49.71,0:24:53.11,Default,,0,0,0,,Суретті кітапта билейік
Dialogue: 0,0:24:53.61,0:25:00.21,Default,,0,0,0,,Махаббат ғажайыбы кемпірқосақты кесіп өтеді
Dialogue: 0,0:25:00.74,0:25:04.34,Default,,0,0,0,,Саған жетеді, міндетті түрде жетеді.
Dialogue: 0,0:25:06.64,0:25:07.74,Default,,0,0,0,,Ранка-чан...
Dialogue: 0,0:25:08.01,0:25:11.67,Default,,0,0,0,,Қыз жүрек, батыл бол
Dialogue: 0,0:25:18.51,0:25:22.61,Default,,0,0,0,,Бұл орташа Бодрусар бекінісін алдын ала барлау бөлімі ашты.
Dialogue: 0,0:25:22.94,0:25:28.31,Default,,0,0,0,,Оны жарты ғасыр бұрын важра қиратып, оның ұясы екені анықталды.
Dialogue: 0,0:25:29.27,0:25:30.51,Default,,0,0,0,,ЛАИ талдауында
Dialogue: 0,0:25:30.84,0:25:35.44,Default,,0,0,0,,Важраның өсетін және көбейетіні бүктелген отынмен қоректенеді деп есептеледі.
Dialogue: 0,0:25:36.44,0:25:40.34,Default,,0,0,0,,Оны қазір тоқтатпасақ, тағы бір шекара флоты пайда болады...
Dialogue: 0,0:25:41.61,0:25:42.47,Default,,0,0,0,,Важра…
Dialogue: 0,0:25:51.64,0:25:52.64,Default,,0,0,0,,Қандай сан...
Dialogue: 0,0:25:54.34,0:25:58.41,Default,,0,0,0,,Антарес 1-ден Жаңа Біріккен Күштерге және S.M.S.
Dialogue: 0,0:25:59.47,0:26:01.27,Default,,0,0,0,,Бұл жолы біз де сізді қолдаймыз.
Dialogue: 0,0:26:01.94,0:26:05.11,Default,,0,0,0,,Дегенмен, менімен келе алсаңыз...
Dialogue: 0,0:26:05.17,0:26:06.04,Default,,0,0,0,,Брера
Dialogue: 0,0:26:06.11,0:26:06.87,Default,,0,0,0,,Келеді!
Dialogue: 0,0:26:07.64,0:26:09.61,Default,,0,0,0,,Барлық кемелер шабуыл жасайды!
Dialogue: 0,0:26:11.44,0:26:13.07,Default,,0,0,0,,Барлық взводтық ұрыс ашық!
Dialogue: 0,0:26:15.54,0:26:17.44,Default,,0,0,0,,Барлық машиналар! Өртке қарсы оқ!
Dialogue: 0,0:26:33.04,0:26:33.77,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:26:34.21,0:26:35.41,Default,,0,0,0,,Құрылым кері!
Dialogue: 0,0:26:36.61,0:26:39.07,Default,,0,0,0,,Салыстырмалы жылдамдықты реттеп, жекпе-жек шайқасына қатысыңыз.
Dialogue: 0,0:26:57.31,0:26:58.31,Default,,0,0,0,,Жаңа үлгі?
Dialogue: 0,0:26:58.77,0:26:59.67,Default,,0,0,0,,Пинсер шабуылы!
Dialogue: 0,0:27:18.34,0:27:20.91,Default,,0,0,0,,Бүктеу толқын сигналын арттыру Бұл ол.
Dialogue: 0,0:27:21.74,0:27:24.14,Default,,0,0,0,,Ол Важра табын бақылайды.
Dialogue: 0,0:27:24.47,0:27:27.21,Default,,0,0,0,,Жарайды! Itadadaki!
Dialogue: 0,0:27:27.94,0:27:31.47,Default,,0,0,0,,Әрбір бөлім Қуатты мұздату Барлығы жасыл Негізгі тапанша Энергия зарядының критикалық деңгейі
Dialogue: 0,0:27:31.51,0:27:34.81,Default,,0,0,0,,Төтенше жағдай қызметкерлерінен басқа барлық техникалық қызмет көрсету топтары баспанаға эвакуацияланды.
Dialogue: 0,0:27:34.84,0:27:39.41,Default,,0,0,0,,Апаттық реттеу X-3.67 Y-4.49! Мен бара аламын!
Dialogue: 0,0:27:55.57,0:27:57.21,Default,,0,0,0,,Қандай түзу адам!
Dialogue: 0,0:27:57.84,0:28:02.41,Default,,0,0,0,,Бұл Антарес 1. Біз енді жау тасымалдаушысының ішіне күшпен кіреміз.
Dialogue: 0,0:28:09.91,0:28:10.84,Default,,0,0,0,,Брера!
Dialogue: 0,0:28:18.11,0:28:19.61,Default,,0,0,0,,Альто! Алысқа бармаңыз!
Dialogue: 0,0:28:20.07,0:28:22.77,Default,,0,0,0,,Бірақ біз мұны осы жерден тоқтатуымыз керек!
Dialogue: 0,0:28:32.37,0:28:34.94,Default,,0,0,0,,Жылағым келгені сонша
Dialogue: 0,0:28:35.14,0:28:38.94,Default,,0,0,0,,Қараңғыда да, жаңбыр жауса да
Dialogue: 0,0:28:39.37,0:28:47.11,Default,,0,0,0,,Бұлттардың үстінде, тамсанған көк аспан
Dialogue: 0,0:28:50.24,0:28:52.01,Default,,0,0,0,,Енді ұшыңыз
Dialogue: 0,0:28:52.64,0:28:55.57,Default,,0,0,0,,Жауапсыз махаббат жұлдызынан
Dialogue: 0,0:28:55.67,0:29:00.31,Default,,0,0,0,,Екілену бұлтынан өту
Dialogue: 0,0:29:01.31,0:29:06.51,Default,,0,0,0,,Жүрек соғуы
Dialogue: 0,0:29:06.57,0:29:08.74,Default,,0,0,0,,Ол... Қарғыс атсын!
Dialogue: 0,0:29:13.14,0:29:14.97,Default,,0,0,0,,Сөздерден де жылдам
Dialogue: 0,0:29:15.04,0:29:16.34,Default,,0,0,0,,Ах! Бұл ән?
Dialogue: 0,0:29:18.61,0:29:19.47,Default,,0,0,0,,Ранка…
Dialogue: 0,0:29:27.01,0:29:28.71,Default,,0,0,0,,Бұл қандай балалар?
Dialogue: 0,0:29:29.11,0:29:31.04,Default,,0,0,0,,Ән... Ән келді.
Dialogue: 0,0:29:31.47,0:29:35.07,Default,,0,0,0,,Әннің қатпарлы толқындық табиғаты Важраның коммуникацияларына кедергі келтіруде.
Dialogue: 0,0:29:35.94,0:29:39.34,Default,,0,0,0,,Неге екенін білмеймін, бірақ қимылдарым баяу! Қазір!
Dialogue: 0,0:29:39.74,0:29:40.84,Default,,0,0,0,,Кеттік, Мишель.
Dialogue: 0,0:29:40.91,0:29:42.17,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:29:45.94,0:29:48.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:04.41,0:30:06.31,Default,,0,0,0,,Ха!
Dialogue: 0,0:30:07.64,0:30:08.47,Default,,0,0,0,,Бұл...
Dialogue: 0,0:30:09.04,0:30:11.77,Default,,0,0,0,,Ханшайымның ән салған дауысы жаңғырық!
Dialogue: 0,0:30:11.91,0:30:13.27,Default,,0,0,0,,Хаттаманы түсініңіз
Dialogue: 0,0:30:13.41,0:30:14.47,Default,,0,0,0,,Мен істеп жатырмын!
Dialogue: 0,0:30:14.84,0:30:16.47,Default,,0,0,0,,Енді мұрнын жоғары көтер.
Dialogue: 0,0:30:17.31,0:30:20.17,Default,,0,0,0,,Жалғыздықтың қараңғылығынан
Dialogue: 0,0:30:20.34,0:30:24.84,Default,,0,0,0,,Кеуде қуысын шектегішті босату
Dialogue: 0,0:30:25.91,0:30:31.37,Default,,0,0,0,,Бетпе-бет
Dialogue: 0,0:30:31.67,0:30:37.14,Default,,0,0,0,,Супер шетелдік махаббат
Dialogue: 0,0:30:37.41,0:30:42.97,Default,,0,0,0,,Мен махаббатты жарықтан тезірек сезгім келеді
Dialogue: 0,0:30:43.17,0:30:44.11,Default,,0,0,0,,Не?
Dialogue: 0,0:30:44.47,0:30:45.71,Default,,0,0,0,,Альто Маған қол ұшын беріңіз!
Dialogue: 0,0:30:45.87,0:30:47.11,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:30:48.51,0:30:51.01,Default,,0,0,0,,Әнді кептелу әлі жұмыс істеп тұрғанда асығыңыз!
Dialogue: 0,0:30:51.74,0:30:52.61,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:30:54.21,0:30:58.64,Default,,0,0,0,,Мен Ваджраның да...сезімдері...жүрегі бар сияқты...
Dialogue: 0,0:30:59.77,0:31:01.04,Default,,0,0,0,,Атыра алмасаң, кет!
Dialogue: 0,0:31:01.47,0:31:04.37,Default,,0,0,0,,Қажет кезде триггерді баса алмайтын адамға пайда жоқ!
Dialogue: 0,0:31:05.84,0:31:08.47,Default,,0,0,0,,Жаса! Мен ұшқышпын!
Dialogue: 0,0:31:11.74,0:31:16.04,Default,,0,0,0,,Оң жақтағы топты сүртіңіз. Қарсы жақтан асығу керек!
Dialogue: 0,0:31:16.81,0:31:20.24,Default,,0,0,0,,Санақ 3 2 1
Dialogue: 0,0:31:21.07,0:31:24.17,Default,,0,0,0,,Ууууууу!
Dialogue: 0,0:31:26.27,0:31:29.34,Default,,0,0,0,,Нуоооо~
Dialogue: 0,0:31:32.71,0:31:33.64,Default,,0,0,0,,Уф!
Dialogue: 0,0:31:36.91,0:31:37.74,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:31:46.61,0:31:49.31,Default,,0,0,0,,Дыбыстық сигнал
Dialogue: 0,0:31:53.57,0:31:57.01,Default,,0,0,0,,Важра... оның серіктері...
Dialogue: 0,0:32:13.14,0:32:16.87,Default,,0,0,0,,Гяаааааааааааааааааааа
Dialogue: 0,0:32:19.41,0:32:20.77,Default,,0,0,0,,Ах! Уф...
Dialogue: 0,0:32:21.11,0:32:23.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:31.67,0:32:33.77,Default,,0,0,0,,Супербағытты қатпар толқыны...?
Dialogue: 0,0:32:33.97,0:32:35.31,Default,,0,0,0,,Э? Тұр... не?
Dialogue: 0,0:32:35.44,0:32:37.14,Default,,0,0,0,,Мен бұл бағытты күтпедім...
Dialogue: 0,0:32:38.54,0:32:39.71,Default,,0,0,0,,Важра жұлдызы?
Dialogue: 0,0:32:43.51,0:32:46.54,Default,,0,0,0,,Не? Қазір...
Dialogue: 0,0:32:55.81,0:32:58.47,Default,,0,0,0,,Күте тұрыңыз! Сіз достарыңызды тастап кетуді жоспарлап отырсыз ба?
Dialogue: 0,0:32:59.01,0:33:00.77,Default,,0,0,0,,Сондай-ақ зақымдалған
Dialogue: 0,0:33:01.07,0:33:05.07,Default,,0,0,0,,Мен сенің жараланғандарды жинайтыныңды білдім.
Dialogue: 0,0:33:05.24,0:33:06.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:33:09.04,0:33:10.61,Default,,0,0,0,,Дельта 1-ден 1-бас сүйекке дейін
Dialogue: 0,0:33:11.04,0:33:13.01,Default,,0,0,0,,Важраның сырты бүктеліп, шегінеді
Dialogue: 0,0:33:13.17,0:33:16.91,Default,,0,0,0,,Түсіндім, бұл Skull 4 ұшағын жоғалтып жатыр.
Dialogue: 0,0:33:17.14,0:33:18.47,Default,,0,0,0,,Ұшқыш туралы не деуге болады?
Dialogue: 0,0:33:19.21,0:33:20.41,Default,,0,0,0,,Тірі қалғаныңызды растаңыз!
Dialogue: 0,0:33:20.51,0:33:22.21,Default,,0,0,0,,Дегенмен көптеген жарақаттар
Dialogue: 0,0:33:22.64,0:33:24.14,Default,,0,0,0,,Медициналық топтың күту режимін сұраңыз
Dialogue: 0,0:33:24.37,0:33:25.37,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:33:45.24,0:33:46.07,Default,,0,0,0,,Түнгі күзетші келеді. Көзіңді жұмшы.
Dialogue: 0,0:33:50.47,0:33:51.57,Default,,0,0,0,,Альто!
Dialogue: 0,0:33:53.84,0:33:54.74,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:33:55.67,0:33:58.57,Default,,0,0,0,,Оян! Дұрыс жауап беруіңізді өтінемін!
Dialogue: 0,0:33:59.07,0:34:02.41,Default,,0,0,0,,Альто… Альто…
Dialogue: 0,0:34:02.67,0:34:04.61,Default,,0,0,0,,Дауысыңыз жақсы естіледі.
Dialogue: 0,0:34:04.71,0:34:06.04,Default,,0,0,0,,​​О... не?
Dialogue: 0,0:34:06.47,0:34:08.64,Default,,0,0,0,,Басым жарылып кетеді деп ойладым.
Dialogue: 0,0:34:08.91,0:34:09.77,Default,,0,0,0,,Альто…
Dialogue: 0,0:34:10.77,0:34:12.34,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:34:13.11,0:34:14.64,Default,,0,0,0,,Ол оқ тигендіктен...
Dialogue: 0,0:34:15.67,0:34:18.34,Default,,0,0,0,,Көгерулер мен ішкі қан кетулер нашар болды.
Dialogue: 0,0:34:18.67,0:34:21.77,Default,,0,0,0,,Мынаны киіп алсаң 2-3 күнде жазылады дейді.
Dialogue: 0,0:34:23.37,0:34:27.17,Default,,0,0,0,,Не...! Олай болса, дүрбелеңнің зияны жоқ!
Dialogue: 0,0:34:27.37,0:34:29.14,Default,,0,0,0,,Не? Сіз дүрбелең болдыңыз ба?
Dialogue: 0,0:34:29.44,0:34:30.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:32.01,0:34:34.11,Default,,0,0,0,,Шулы! Альтоның әдеті!
Dialogue: 0,0:34:35.51,0:34:37.27,Default,,0,0,0,,Хаттамалық талдаудың жағдайы қандай?
Dialogue: 0,0:34:37.67,0:34:40.37,Default,,0,0,0,,98,5% талданған
Dialogue: 0,0:34:40.77,0:34:43.81,Default,,0,0,0,,Соңына жарты күн қалды деп ойлаймын.
Dialogue: 0,0:34:44.21,0:34:46.97,Default,,0,0,0,,Жарайды, жасырын операциялар ше?
Dialogue: 0,0:34:47.74,0:34:51.47,Default,,0,0,0,,Босқын атын жамылған агенттер жоспарлағандай әрекет етті.
Dialogue: 0,0:34:51.61,0:34:53.41,Default,,0,0,0,,Әр бөлімге еніп кетті
Dialogue: 0,0:34:54.51,0:34:57.44,Default,,0,0,0,,Жарайды, LAI инженерлері.
Dialogue: 0,0:34:57.84,0:35:00.87,Default,,0,0,0,,Бүктелген желілердің шынайы күшін түсінбес бұрын
Dialogue: 0,0:35:01.21,0:35:03.51,Default,,0,0,0,,Шекараны жаулап алу операциясын бастау
Dialogue: 0,0:35:03.87,0:35:04.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:35:09.51,0:35:11.34,Default,,0,0,0,,Кью Шерилдің әні
Dialogue: 0,0:35:11.94,0:35:18.27,Default,,0,0,0,,Ән аяқталғанда, бұл кеме біздің жаңа мүшелерімізге айналады.
Dialogue: 0,0:35:25.61,0:35:28.47,Default,,0,0,0,,Жарайды ма? Мен осындай жерде әлсіреп жүрмін
Dialogue: 0,0:35:28.91,0:35:29.97,Default,,0,0,0,,Тыныштық
Dialogue: 0,0:35:30.44,0:35:32.94,Default,,0,0,0,,Мен мұндай нәрселерді сирек істеймін.
Dialogue: 0,0:35:33.61,0:35:35.67,Default,,0,0,0,,Шын жүректен алғыс айтыңыз...
Dialogue: 0,0:35:35.74,0:35:36.44,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:35:36.54,0:35:37.37,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:35:38.94,0:35:39.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:41.84,0:35:42.74,Default,,0,0,0,,Әй
Dialogue: 0,0:35:46.24,0:35:49.27,Default,,0,0,0,,Ол керемет әйел болар еді.
Dialogue: 0,0:35:50.11,0:35:55.17,Default,,0,0,0,,Оны маған бала кезімнен...тазалау, кір жуу, тамақ пісіру... үйретті.
Dialogue: 0,0:35:55.54,0:35:57.21,Default,,0,0,0,,Әйелдің жұмысы кез келген нәрсе.
Dialogue: 0,0:35:58.51,0:36:00.21,Default,,0,0,0,,Кабукидің әйел формасы...
Dialogue: 0,0:36:00.47,0:36:02.27,Default,,0,0,0,,Жоқ! Сіз білдіңіз бе...?
Dialogue: 0,0:36:02.47,0:36:04.94,Default,,0,0,0,,А... бұл анық емес.
Dialogue: 0,0:36:05.44,0:36:07.87,Default,,0,0,0,,Галактика Кабукидің данышпан бала актері.
Dialogue: 0,0:36:08.47,0:36:11.01,Default,,0,0,0,,Сіз Галактикада да өте танымал болдыңыз.
Dialogue: 0,0:36:11.67,0:36:15.77,Default,,0,0,0,,Хмм, осымен әңгіме аяқталды.
Dialogue: 0,0:36:17.61,0:36:18.24,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:36:18.41,0:36:19.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:19.17,0:36:19.84,Default,,0,0,0,,Киин
Dialogue: 0,0:36:19.97,0:36:20.97,Default,,0,0,0,,Оинго-Боинго бауырлары!
Dialogue: 0,0:36:21.44,0:36:22.41,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:36:22.54,0:36:23.51,Default,,0,0,0,,Эхехе
Dialogue: 0,0:36:24.57,0:36:25.41,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:36:26.01,0:36:28.31,Default,,0,0,0,,Қауырсын...?
Dialogue: 0,0:36:28.81,0:36:29.74,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:36:31.67,0:36:33.41,Default,,0,0,0,,Неге сонша ұшқың келеді?
Dialogue: 0,0:36:33.61,0:36:34.47,Default,,0,0,0,,А...
Dialogue: 0,0:36:38.24,0:36:40.41,Default,,0,0,0,,Неліктен әнші болдыңыз?
Dialogue: 0,0:36:40.71,0:36:43.11,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:36:44.27,0:36:45.44,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:36:51.84,0:36:54.67,Default,,0,0,0,,Әуелде өмір сүру үшін ән айттым
Dialogue: 0,0:36:55.71,0:36:58.44,Default,,0,0,0,,Бірақ қазір мен ән айту үшін өмір сүремін
Dialogue: 0,0:37:01.77,0:37:04.77,Default,,0,0,0,,Маған сахна алдындағы тыныштық ұнайды
Dialogue: 0,0:37:05.57,0:37:08.04,Default,,0,0,0,,Мен шымылдық ашылған сәттегі толқуды жақсы көремін.
Dialogue: 0,0:37:09.81,0:37:12.67,Default,,0,0,0,,Кіріспе басталғанда жүрек соғысы
Dialogue: 0,0:37:13.84,0:37:15.81,Default,,0,0,0,,Кеңістігімді тербетеді әнім
Dialogue: 0,0:37:16.17,0:37:18.91,Default,,0,0,0,,Түрлі-түсті дыбыстар мен толқындар билейді!
Dialogue: 0,0:37:20.71,0:37:25.04,Default,,0,0,0,,Уау~ Уау~
Dialogue: 0,0:37:25.61,0:37:29.81,Default,,0,0,0,,Және бәрінің ынтасы мені басып алды
Dialogue: 0,0:37:30.31,0:37:35.77,Default,,0,0,0,,Мен сол тасқынға мас болып, галактиканың арғы бетіне кетемін.
Dialogue: 0,0:37:38.47,0:37:39.97,Default,,0,0,0,,Ха ха...
Dialogue: 0,0:37:45.57,0:37:50.01,Default,,0,0,0,,Мен сахнамын... Сахна деп аталатын құбыжықтың қолына түскен тұтқынмын...
Dialogue: 0,0:37:50.91,0:37:53.21,Default,,0,0,0,,Бірақ мен еш өкінбеймін
Dialogue: 0,0:37:53.57,0:37:56.27,Default,,0,0,0,,Бұл жердің несі қызықты?
Dialogue: 0,0:37:58.94,0:38:00.27,Default,,0,0,0,,Ах ха ха
Dialogue: 0,0:38:05.84,0:38:07.27,Default,,0,0,0,,Сәлем Альто
Dialogue: 0,0:38:07.61,0:38:08.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:08.97,0:38:10.44,Default,,0,0,0,,Қазір ұшуды тоқтатыңыз
Dialogue: 0,0:38:11.21,0:38:13.54,Default,,0,0,0,,Өз өміріңді құрбан етудің қажеті жоқ.
Dialogue: 0,0:38:13.71,0:38:14.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:14.81,0:38:16.67,Default,,0,0,0,,Ұшқыштар көп.
Dialogue: 0,0:38:16.94,0:38:21.27,Default,,0,0,0,,Бірақ Альто... Бір ғана Альто Саотоме бар!
Dialogue: 0,0:38:21.41,0:38:22.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:28.97,0:38:30.97,Default,,0,0,0,,Әй, Альто-кун!
Dialogue: 0,0:38:31.04,0:38:31.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:31.81,0:38:32.57,Default,,0,0,0,,Ах
Dialogue: 0,0:38:35.74,0:38:36.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:38:51.21,0:38:55.04,Default,,0,0,0,,Уау Уау Уау...
Dialogue: 0,0:38:55.41,0:38:56.31,Default,,0,0,0,,Хе...
Dialogue: 0,0:38:56.54,0:38:57.77,Default,,0,0,0,,Басталып жатыр.
Dialogue: 0,0:38:58.57,0:39:01.21,Default,,0,0,0,,Брера Ранка мен Шерилді қамтамасыз етті.
Dialogue: 0,0:39:01.51,0:39:02.47,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:39:04.31,0:39:05.57,Default,,0,0,0,,Хехе...
Dialogue: 0,0:39:06.01,0:39:11.54,Default,,0,0,0,,Құдайға ғашық болған кезім
Dialogue: 0,0:39:11.71,0:39:21.37,Default,,0,0,0,,Мен мұндай қоштасуды күткен жоқпын.
Dialogue: 0,0:39:26.17,0:39:34.34,Default,,0,0,0,,Егер мен саған енді ешқашан тиісе алмасам, тым болмаса соңғы рет
Dialogue: 0,0:39:35.14,0:39:38.64,Default,,0,0,0,,Мен сенің мені қайтадан құшақтауыңды қаладым
Dialogue: 0,0:39:38.71,0:39:42.04,Default,,0,0,0,,Шекаралық бақылау операциясы басталады...
Dialogue: 0,0:39:42.51,0:39:43.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:43.54,0:39:44.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:44.54,0:39:45.31,Default,,0,0,0,,Гува…
Dialogue: 0,0:39:46.77,0:39:47.14,Default,,0,0,0,,Ха!
Dialogue: 0,0:39:47.21,0:39:52.31,Default,,0,0,0,,Қош бол, қош, қайта-қайта
Dialogue: 0,0:39:53.71,0:39:54.67,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:39:58.74,0:40:00.24,Default,,0,0,0,,Полковник Грейс!
Dialogue: 0,0:40:02.24,0:40:04.14,Default,,0,0,0,,Полковник! Неге жауап бермейсің...
Dialogue: 0,0:40:09.27,0:40:12.64,Default,,0,0,0,,Ха! Имплант желісі ажыратылды...
Dialogue: 0,0:40:13.51,0:40:15.67,Default,,0,0,0,,Күрсін... Күрсін!
Dialogue: 0,0:40:19.17,0:40:24.77,Default,,0,0,0,,Сүйсең ғана, i бар болса ғана
Dialogue: 0,0:40:24.84,0:40:26.24,Default,,0,0,0,,Уф! Апыр-ай!
Dialogue: 0,0:40:34.67,0:40:35.51,Default,,0,0,0,,О!
Dialogue: 0,0:40:38.84,0:40:41.04,Default,,0,0,0,,Кешіріңіз... Кя!
Dialogue: 0,0:40:41.81,0:40:43.44,Default,,0,0,0,,Жоқ! Ранка!
Dialogue: 0,0:40:47.61,0:40:51.07,Default,,0,0,0,,Жоқ, жоқ, бұл тамаша үшбұрыш.
Dialogue: 0,0:40:52.24,0:40:56.81,Default,,0,0,0,,Мүмкін болса, мен оны ұзағырақ көргім келеді, бірақ бұл мүмкін емес.
Dialogue: 0,0:40:59.94,0:41:01.17,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:41:04.01,0:41:10.04,Default,,0,0,0,,Шерил Ном сізге тыңшылық жасады, құпиялылық туралы заңдарды бұзды, тәртіпсіздікті дайындады және т.б.
Dialogue: 0,0:41:10.44,0:41:12.87,Default,,0,0,0,,Барлығы 12 құқық бұзушылық үшін қамауға алу!
Dialogue: 0,0:41:13.64,0:41:14.51,Default,,0,0,0,,Ха!
Dialogue: 0,0:41:18.94,0:41:21.41,Default,,0,0,0,,Неге...
Dialogue: 0,0:41:22.37,0:41:27.54,Default,,0,0,0,,Бүктелген кварц технологиясы тек сізге арналған емес.
Dialogue: 0,0:41:27.61,0:41:28.41,Default,,0,0,0,,Е...
Dialogue: 0,0:41:28.67,0:41:29.91,Default,,0,0,0,,Жарайды, бұл!
Dialogue: 0,0:41:30.04,0:41:31.64,Default,,0,0,0,,Енді біз
Dialogue: 0,0:41:32.17,0:41:36.11,Default,,0,0,0,,Бүктелген толқындарды қалауыңызша күшейтіңіз немесе басыңыз
Dialogue: 0,0:41:39.01,0:41:40.14,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:41:42.61,0:41:46.71,Default,,0,0,0,,Бұл өкінішті, полковник Грейс Годунува...
Dialogue: 0,0:41:48.31,0:41:52.61,Default,,0,0,0,,No 117-зерттеу тобының бас ғылыми қызметкерінің бірі.
Dialogue: 0,0:41:53.24,0:41:54.91,Default,,0,0,0,,Доктор Годунува
Dialogue: 0,0:41:55.01,0:41:55.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:41:57.37,0:41:58.81,Default,,0,0,0,,Барлық агенттер ме?
Dialogue: 0,0:41:59.51,0:42:04.21,Default,,0,0,0,,Брела Стерн деген тағы бір адам қашып жүр, бірақ біз оның орналасқан жерін анықтай алдық.
Dialogue: 0,0:42:04.67,0:42:07.31,Default,,0,0,0,,Мені тез ұстап ал, өлтірсең бәрібір.
Dialogue: 0,0:42:07.57,0:42:08.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:42:09.71,0:42:12.74,Default,,0,0,0,,Хмм... бұл сізге жарасады.
Dialogue: 0,0:42:13.27,0:42:14.71,Default,,0,0,0,,Күте тұрыңыз, қарғыс атсын!
Dialogue: 0,0:42:14.97,0:42:18.04,Default,,0,0,0,,Дәлел бар ма? Оны шпион дейді!
Dialogue: 0,0:42:18.87,0:42:19.74,Default,,0,0,0,,Ха!
Dialogue: 0,0:42:21.64,0:42:23.87,Default,,0,0,0,,Көмекші: Кварцты күткендей бүктеңіз.
Dialogue: 0,0:42:25.81,0:42:27.11,Default,,0,0,0,,Дәл ойлағанымдай
Dialogue: 0,0:42:27.97,0:42:33.77,Default,,0,0,0,,Мен олардың Важраларды шекараға тарту үшін осы кварцпен ән айтатын дауыстарын күшейтетінін ешқашан білмедім.
Dialogue: 0,0:42:35.07,0:42:37.24,Default,,0,0,0,,Бұл өтірік...? Шерил!
Dialogue: 0,0:42:38.31,0:42:42.74,Default,,0,0,0,,Мен ертеңгі жаңалықты асыға күтемін, Галактикалық пері.
Dialogue: 0,0:42:43.01,0:42:44.94,Default,,0,0,0,,...
Dialogue: 0,0:42:45.01,0:42:46.47,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:42:46.57,0:42:48.97,Default,,0,0,0,,Тәтті... күте тұрыңыз! Шерил!
Dialogue: 0,0:42:50.14,0:42:51.44,Default,,0,0,0,,Шерилоу!
Dialogue: 0,0:43:14.44,0:43:18.34,Default,,0,0,0,,Тарихи тұрғыдан атақты адамдар өздерінің бос орындарын пайдаланған
Dialogue: 0,0:43:18.77,0:43:22.87,Default,,0,0,0,,Тыңшылықтың сансыз мысалдары бар.
Dialogue: 0,0:43:23.41,0:43:27.47,Default,,0,0,0,,Шерил Номе, менің ойымша, ол да солай болған.
Dialogue: 0,0:43:28.57,0:43:32.07,Default,,0,0,0,,Үкімет қазіргі уақытты соғыс уақыты деп анықтайды.
Dialogue: 0,0:43:32.61,0:43:34.91,Default,,0,0,0,,Соғыс уақытының арнайы заңы бойынша
Dialogue: 0,0:43:35.01,0:43:39.87,Default,,0,0,0,,Мен дос қызым Шерил Номды соғыс уақытындағы барлау агенті ретінде қарастыруды шештім.
Dialogue: 0,0:43:39.97,0:43:40.74,Default,,0,0,0,,Иә
Dialogue: 0,0:43:40.87,0:43:43.07,Default,,0,0,0,,Күте тұрыңыз! Яғни...
Dialogue: 0,0:43:43.14,0:43:49.11,Default,,0,0,0,,Мен оны сотсыз өлім жазасына кескеніме қатты өкінемін.
Dialogue: 0,0:43:49.17,0:43:51.21,Default,,0,0,0,,Е-е... Ақымақ болма!
Dialogue: 0,0:44:12.24,0:44:13.11,Default,,0,0,0,,Құт
Dialogue: 0,0:45:13.04,0:45:13.87,Default,,0,0,0,,Ах
Dialogue: 0,0:45:15.51,0:45:17.07,Default,,0,0,0,,Оны қайтар! мен...
Dialogue: 0,0:45:17.31,0:45:18.37,Default,,0,0,0,,Сіз қашып бара жатырсыз ба?
Dialogue: 0,0:45:18.61,0:45:19.44,Default,,0,0,0,,Ах
Dialogue: 0,0:45:19.57,0:45:21.31,Default,,0,0,0,,Альто-кун, сен жараланып қалдың.
Dialogue: 0,0:45:21.87,0:45:23.61,Default,,0,0,0,,Мені Шерил сатып жіберді.
Dialogue: 0,0:45:24.74,0:45:25.74,Default,,0,0,0,,Жанкүйерлер де
Dialogue: 0,0:45:26.07,0:45:30.04,Default,,0,0,0,,Бұл туралы армандамаңыз! Мен галактикалық пері немесе басқа нәрсе емеспін.
Dialogue: 0,0:45:30.24,0:45:32.11,Default,,0,0,0,,Сіз жай ғана арзан адамсыз!
Dialogue: 0,0:45:33.61,0:45:34.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:45:35.11,0:45:35.97,Default,,0,0,0,,Ах
Dialogue: 0,0:45:38.61,0:45:42.97,Default,,0,0,0,,Мен Шерилді күшті адам деп ойладым.
Dialogue: 0,0:45:44.61,0:45:49.41,Default,,0,0,0,,Бірақ сол кезде, Гриффит саябағының төбесінде, Важрамен шайқас кезінде.
Dialogue: 0,0:45:49.84,0:45:52.54,Default,,0,0,0,,Мен мұны сенімен ән айтуға рұқсат бергенде сезіндім.
Dialogue: 0,0:45:53.34,0:45:56.51,Default,,0,0,0,,Менің ойымша, Шерил де жалғыз болды...
Dialogue: 0,0:45:58.24,0:45:59.67,Default,,0,0,0,,Қателессем кешіріңіз.
Dialogue: 0,0:46:00.57,0:46:04.07,Default,,0,0,0,,Бірақ мен Шерилді керемет деп ойладым.
Dialogue: 0,0:46:05.41,0:46:07.84,Default,,0,0,0,,Шеріл қашанда мықты, жарқырап тұрады.
Dialogue: 0,0:46:08.64,0:46:13.21,Default,,0,0,0,,Мен жалғызбын және қайғылымын... жалғызбын...
Dialogue: 0,0:46:14.07,0:46:18.47,Default,,0,0,0,,Бірақ мен бұған берілмеу үшін бар күшімді салып ән айттым...
Dialogue: 0,0:46:21.41,0:46:23.64,Default,,0,0,0,,Мен бақытты болдым.
Dialogue: 0,0:46:24.71,0:46:29.11,Default,,0,0,0,,Шерилмен ән айту... әндеріміз біртұтас болады
Dialogue: 0,0:46:29.77,0:46:31.57,Default,,0,0,0,,Ішімнің түбі қалтырап
Dialogue: 0,0:46:32.64,0:46:35.97,Default,,0,0,0,,Мен де жалғыз емеспін...
Dialogue: 0,0:46:38.91,0:46:42.94,Default,,0,0,0,,Өзімшілдік айтқаным үшін кешіріңіз, бірақ соңғы бір нәрсе бар...
Dialogue: 0,0:46:43.81,0:46:45.77,Default,,0,0,0,,Маған шындықты айтыңызшы
Dialogue: 0,0:46:47.94,0:46:50.61,Default,,0,0,0,,Шерил-сан Альто-кун туралы айтып жатыр...
Dialogue: 0,0:46:56.51,0:46:57.44,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:46:58.71,0:47:00.64,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:47:00.77,0:47:01.47,Default,,0,0,0,,Га
Dialogue: 0,0:47:01.91,0:47:05.71,Default,,0,0,0,,Бірақ... бұл тек екеуміздің арамыздағы құпия.
Dialogue: 0,0:47:06.77,0:47:10.31,Default,,0,0,0,,Өйткені мен өлейін деп тұрмын
Dialogue: 0,0:47:26.21,0:47:29.27,Default,,0,0,0,,Бұл басқа әңгіме! Шерилді қалай өлім жазасына кесуге болады?
Dialogue: 0,0:47:29.67,0:47:32.71,Default,,0,0,0,,Оған көмектесуге болмайды, бұл заңды.
Dialogue: 0,0:47:32.91,0:47:36.61,Default,,0,0,0,,Өйткені, адамзатты Ваджрадан қорғау – бұл жай ғана әңгіме.
Dialogue: 0,0:47:36.84,0:47:39.71,Default,,0,0,0,,Ол шын мәнінде Галактиканың жоспарларын ұрлады.
Dialogue: 0,0:47:39.84,0:47:42.07,Default,,0,0,0,,Сіз Ваджраны басқаруды жоспарлағансыз!
Dialogue: 0,0:47:43.24,0:47:45.71,Default,,0,0,0,,Бұлай айту дұрыс па?
Dialogue: 0,0:47:46.67,0:47:49.44,Default,,0,0,0,,Юлия қиындыққа тап болуы мүмкін.
Dialogue: 0,0:47:51.37,0:47:52.97,Default,,0,0,0,,Сіз мені күштеп алмақшысыз ба?
Dialogue: 0,0:47:53.64,0:47:56.87,Default,,0,0,0,,Әпкеме бірдеңе болса, менде де бір ой бар.
Dialogue: 0,0:48:42.37,0:48:43.17,Default,,0,0,0,,<Қабылдау хатын алғаннан кейінгі кеш>
Dialogue: 0,0:48:44.31,0:48:45.27,Default,,0,0,0,,Хаааахх
Dialogue: 0,0:48:47.61,0:48:49.54,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:48:49.87,0:48:51.41,Default,,0,0,0,,Тыныш Ранка Ли
Dialogue: 0,0:48:51.51,0:48:52.81,Default,,0,0,0,,Иә
Dialogue: 0,0:48:53.51,0:48:54.27,Default,,0,0,0,,Брера мырза?
Dialogue: 0,0:48:55.41,0:48:56.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:48:56.54,0:49:00.11,Default,,0,0,0,,Мен сізге бір нәрсе айтуым керек.
Dialogue: 0,0:49:01.04,0:49:02.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:03.17,0:49:08.41,Default,,0,0,0,,Шекара Ваджраны жойып, оның ресурстарын тонауға тырысады.
Dialogue: 0,0:49:09.27,0:49:12.31,Default,,0,0,0,,Өлеңіңді қару ретінде қолдану арқылы
Dialogue: 0,0:49:12.37,0:49:13.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:14.27,0:49:19.34,Default,,0,0,0,,Сіз Шерилдің орнына Важрамен байланыса алатын жалғыз адамсыз.
Dialogue: 0,0:49:20.84,0:49:21.97,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:49:22.81,0:49:24.47,Default,,0,0,0,,Шерил жақында өледі
Dialogue: 0,0:49:25.01,0:49:26.81,Default,,0,0,0,,Өлім жазасына кесілмесе де
Dialogue: 0,0:49:27.04,0:49:30.54,Default,,0,0,0,,V типті инфекциядан зардап шеккен дауыс сымдары жойылмаса
Dialogue: 0,0:49:30.64,0:49:31.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:49:32.17,0:49:37.97,Default,,0,0,0,,Бірақ сіз... Ваджраны зерттеп жүрген сізге Ранче Мей ананың денесіне жұқтырған.
Dialogue: 0,0:49:38.51,0:49:42.07,Default,,0,0,0,,Бактериялардың қатпарлы иммунитетімен туады
Dialogue: 0,0:49:42.74,0:49:46.01,Default,,0,0,0,,Және... Ваджраны басқару күші.
Dialogue: 0,0:49:49.27,0:49:50.67,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:49:53.07,0:49:54.97,Default,,0,0,0,,Мен сенің ағаңмын
Dialogue: 0,0:49:55.17,0:49:56.27,Default,,0,0,0,,Не!
Dialogue: 0,0:49:57.41,0:50:00.71,Default,,0,0,0,,Өлеңнің құдіретін тек өз еркіңмен ғана жеткізеді.
Dialogue: 0,0:50:01.47,0:50:05.94,Default,,0,0,0,,Сондықтан мен сіздің естеліктеріңізді өзіңіз қалпына келтіргенше күтуді жоспарладым, бірақ...
Dialogue: 0,0:50:06.34,0:50:07.97,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:50:08.41,0:50:12.87,Default,,0,0,0,,11 жыл бұрын 4 Галлияда маған Важра шабуыл жасап, өліп қала жаздадым.
Dialogue: 0,0:50:13.34,0:50:15.24,Default,,0,0,0,,Галактика құтқарды
Dialogue: 0,0:50:15.81,0:50:19.87,Default,,0,0,0,,Ал Ранка, мен сенімен қайта кездесетін күн келетініне сенемін.
Dialogue: 0,0:50:20.04,0:50:21.64,Default,,0,0,0,,Мен аман қалдым
Dialogue: 0,0:50:21.77,0:50:22.77,Default,,0,0,0,,Бұл...
Dialogue: 0,0:50:34.34,0:50:35.34,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:50:42.77,0:50:43.67,Default,,0,0,0,,Кууу!
Dialogue: 0,0:50:44.77,0:50:45.94,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:50:46.81,0:50:47.64,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:50:57.71,0:50:58.77,Default,,0,0,0,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,0:51:03.34,0:51:06.54,Default,,0,0,0,,Бұл жақсы ұшақ емес пе? YF-29\NБұл
Dialogue: 0,0:51:07.34,0:51:11.71,Default,,0,0,0,,25 негізінде әзірленетін Важраға қарсы шайқасқа арналған машинаның прототипі.
Dialogue: 0,0:51:12.51,0:51:14.57,Default,,0,0,0,,Қозғалтқыштың төртеуі ғана болған жоқ
Dialogue: 0,0:51:15.01,0:51:17.94,Default,,0,0,0,,Важра қалдықтарынан жиналған бүктелген кварцты пайдалану
Dialogue: 0,0:51:18.47,0:51:22.01,Default,,0,0,0,,Шабуыл күші де, энергияны қорғау қабілеті де айтарлықтай артты.
Dialogue: 0,0:51:25.37,0:51:28.07,Default,,0,0,0,,Хм... Шығарғыңыз келе ме?
Dialogue: 0,0:51:31.84,0:51:35.67,Default,,0,0,0,,Сіз не үшін ұшып жатырсыз? Сіз не үшін күресіп жатырсыз?
Dialogue: 0,0:51:36.27,0:51:40.31,Default,,0,0,0,,Мен жай ғана ұшқыштың рөлін ойнап жүрмін бе деп ойлаймын.
Dialogue: 0,0:51:42.11,0:51:45.71,Default,,0,0,0,,Мен сен сияқты баланың тереңін көремін.
Dialogue: 0,0:51:46.74,0:51:50.07,Default,,0,0,0,,Альто Мен саған қалай қараймын?
Dialogue: 0,0:51:50.21,0:51:53.37,Default,,0,0,0,,Не? Капитан - капитан...
Dialogue: 0,0:51:53.47,0:51:55.77,Default,,0,0,0,,Ха! Мен түсінбедім.
Dialogue: 0,0:51:56.07,0:51:58.57,Default,,0,0,0,,Гала маған бәрібір, бірақ ішімде не бар...
Dialogue: 0,0:51:59.54,0:52:00.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:00.44,0:52:01.27,Default,,0,0,0,,Уф!
Dialogue: 0,0:52:04.01,0:52:06.37,Default,,0,0,0,,Нағыз мен – бала!
Dialogue: 0,0:52:06.67,0:52:08.47,Default,,0,0,0,,Сіз сияқты жақсы!
Dialogue: 0,0:52:09.24,0:52:14.94,Default,,0,0,0,,Капитан рөлі, ағаның рөлі, сарбаздың рөлі, ғашық рөлі
Dialogue: 0,0:52:15.87,0:52:19.41,Default,,0,0,0,,Ал бұл мен ғанамын, мен бәрімін!
Dialogue: 0,0:52:19.84,0:52:22.84,Default,,0,0,0,,Мен әрекет етпейтін адамдарды қаламаймын!
Dialogue: 0,0:52:25.01,0:52:26.07,Default,,0,0,0,,Капитан...
Dialogue: 0,0:52:28.01,0:52:30.24,Default,,0,0,0,,Мен тек күресе алатын адаммын.
Dialogue: 0,0:52:31.01,0:52:33.34,Default,,0,0,0,,Бірақ Альто, сен басқашасың.
Dialogue: 0,0:52:33.84,0:52:36.21,Default,,0,0,0,,Ал біз S.M.S әскер емеспіз.
Dialogue: 0,0:52:36.64,0:52:40.61,Default,,0,0,0,,Егер сіз шайқаста болмасаңыз, кез келген уақытта өз еркіңізбен шығуға болады.
Dialogue: 0,0:52:41.04,0:52:46.44,Default,,0,0,0,,Екінші жағынан, өз бетіңізше шешім қабылдау ешкімді кінәлай алмайтыныңызды білдіреді.
Dialogue: 0,0:52:47.94,0:52:49.41,Default,,0,0,0,,Сондықтан өзіңізге сұрақтар қойыңыз!
Dialogue: 0,0:52:49.81,0:52:52.87,Default,,0,0,0,,Енді мен қандай рөл ойнаймын?
Dialogue: 0,0:52:53.01,0:52:53.87,Default,,0,0,0,,Га
Dialogue: 0,0:52:58.27,0:53:01.57,Default,,0,0,0,,Хаоки Лай Лай Мэй Куньян
Dialogue: 0,0:53:01.71,0:53:02.54,Default,,0,0,0,,Ранка!
Dialogue: 0,0:53:06.77,0:53:07.74,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:53:10.07,0:53:11.41,Default,,0,0,0,,Еңбегіңіз үшін рахмет, Люк.
Dialogue: 0,0:53:12.11,0:53:14.97,Default,,0,0,0,,Мишима... әлі де Куро болатын
Dialogue: 0,0:53:15.81,0:53:17.81,Default,,0,0,0,,Мен апама ризамын.
Dialogue: 0,0:53:18.31,0:53:23.61,Default,,0,0,0,,Біз S.M.S компаниясында сіздің әпкеңізді қорғау жауапкершілігін аламыз.
Dialogue: 0,0:53:23.67,0:53:24.47,Default,,0,0,0,,Әй
Dialogue: 0,0:53:29.34,0:53:32.31,Default,,0,0,0,,Әпкеңді өз денеңмен құтқардың.
Dialogue: 0,0:53:33.41,0:53:34.41,Default,,0,0,0,,Аға
Dialogue: 0,0:53:35.21,0:53:37.91,Default,,0,0,0,,Менің әкем... Президент Гласс та.
Dialogue: 0,0:53:38.01,0:53:42.11,Default,,0,0,0,,Маған Мишима есімді көмекші өз жолын іздеп жатқан сияқты.
Dialogue: 0,0:53:42.57,0:53:44.61,Default,,0,0,0,,Бірақ бұл рас па?
Dialogue: 0,0:53:45.01,0:53:47.87,Default,,0,0,0,,Брера Стерн Ранка-санға не айтты?
Dialogue: 0,0:53:48.41,0:53:50.01,Default,,0,0,0,,Рас сияқты
Dialogue: 0,0:53:50.84,0:53:52.81,Default,,0,0,0,,Бұл Ранканың сынақ нәтижесі.
Dialogue: 0,0:53:53.47,0:53:58.61,Default,,0,0,0,,Брера айтқандай, Ранканың денесінен де қатпарлы бактериялар табылды.
Dialogue: 0,0:53:59.31,0:54:03.21,Default,,0,0,0,,Жіңішке ішек! Бұл оның Важра мен басқалары сияқты екенін білдіре ме?
Dialogue: 0,0:54:03.67,0:54:04.57,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:54:04.87,0:54:09.14,Default,,0,0,0,,Иә Важраның денесін LAI көмегімен зерттеу нәтижесінде
Dialogue: 0,0:54:09.61,0:54:12.74,Default,,0,0,0,,Қатпарлы бактериялар әсіресе аш ішекте жақсы өседі.
Dialogue: 0,0:54:13.41,0:54:18.61,Default,,0,0,0,,Біз олардың гиперкеңістіктік қатпарлар желісін құрап, бір-бірімен байланысқанын анықтадық.
Dialogue: 0,0:54:20.04,0:54:23.34,Default,,0,0,0,,Мен Ранканың денесіндегі бактерияларды да көрдім.
Dialogue: 0,0:54:23.84,0:54:28.24,Default,,0,0,0,,Адамның әндеріне немесе күшті эмоцияларына жауап ретінде қатпар толқындарын шығару
Dialogue: 0,0:54:28.37,0:54:30.51,Default,,0,0,0,,Әндер мен эмоциялар…
Dialogue: 0,0:54:31.27,0:54:34.77,Default,,0,0,0,,Сондықтан мен де оны сезінемін деп ойлаймын.
Dialogue: 0,0:54:35.31,0:54:37.44,Default,,0,0,0,,Важра мен басқалардың сезімін ішімде сезіну
Dialogue: 0,0:54:37.91,0:54:39.21,Default,,0,0,0,,Ваджраның сезімі?
Dialogue: 0,0:54:39.74,0:54:42.67,Default,,0,0,0,,Ранка! Олардың миы дерлік жоқ.
Dialogue: 0,0:54:43.31,0:54:46.07,Default,,0,0,0,,Ақыл... висцеральды шығу гипотезасы
Dialogue: 0,0:54:46.17,0:54:47.11,Default,,0,0,0,,Уф
Dialogue: 0,0:54:47.21,0:54:52.47,Default,,0,0,0,,Гипотеза – ақыл тек мидан ғана емес, ас қорыту жүйесі мен ішкі мүшелерден де пайда болады.
Dialogue: 0,0:54:52.74,0:54:55.77,Default,,0,0,0,,Иә? Жүрегіңіз ішкі ағзалардан ба?
Dialogue: 0,0:54:57.24,0:54:59.21,Default,,0,0,0,,Әкем маған үнемі осылай айтатын
Dialogue: 0,0:55:00.11,0:55:04.07,Default,,0,0,0,,Актерлер ішімен сезініп, асқазаннан қозғалуы керек.
Dialogue: 0,0:55:06.31,0:55:09.77,Default,,0,0,0,,Иә, адам қайғырса, жүрегі ауырады.
Dialogue: 0,0:55:10.24,0:55:13.27,Default,,0,0,0,,Ішіңде күш болмаса, қайрат жоқ.
Dialogue: 0,0:55:14.14,0:55:15.74,Default,,0,0,0,,Ваджра мүмкін
Dialogue: 0,0:55:16.14,0:55:19.91,Default,,0,0,0,,Біз сияқты асқазанынан қатпар толқындарын шығаратын Ранка-сан.
Dialogue: 0,0:55:20.01,0:55:22.04,Default,,0,0,0,,Мүмкін ол бізді доспыз деп ойлаған шығар.
Dialogue: 0,0:55:22.27,0:55:24.97,Default,,0,0,0,,Жоқ! Ваджра Ранка-чанды алып кетеді...
Dialogue: 0,0:55:25.84,0:55:29.11,Default,,0,0,0,,Белгісіз адамнан біреуді құтқаруға тырысасыз ба?
Dialogue: 0,0:55:29.47,0:55:30.31,Default,,0,0,0,,Иә
Dialogue: 0,0:55:30.87,0:55:35.41,Default,,0,0,0,,Бірақ егер Ваджра ақыл-ойы мен эмоциясы бар интеллектуалды тіршілік иесі болса,
Dialogue: 0,0:55:36.01,0:55:37.91,Default,,0,0,0,,Мишиманың әрекеті...
Dialogue: 0,0:55:38.74,0:55:40.14,Default,,0,0,0,,Галактикалық келісімді бұзу
Dialogue: 0,0:55:40.61,0:55:42.77,Default,,0,0,0,,Бұл агрессияның айқын әрекеті.
Dialogue: 0,0:55:44.31,0:55:48.24,Default,,0,0,0,,Ал егер Ваджра қарым-қатынас жасай алатын тіршілік иесі болса.
Dialogue: 0,0:55:49.21,0:55:52.17,Default,,0,0,0,,Ранка мен Шерилдің әндері... Важрада
Dialogue: 0,0:56:01.11,0:56:05.71,Default,,0,0,0,,Мен... Шерилмен бірге ән айтқаныма қуандым.
Dialogue: 0,0:56:19.01,0:56:21.74,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:56:24.67,0:56:25.57,Default,,0,0,0,,Га
Dialogue: 0,0:56:34.71,0:56:37.21,Default,,0,0,0,,Ал, мырзалар, енді біз
Dialogue: 0,0:56:37.57,0:56:41.44,Default,,0,0,0,,Біз адамзат пен Важра тағдырын анықтайтын қиын кезеңде тұрмыз.
Dialogue: 0,0:56:41.97,0:56:44.61,Default,,0,0,0,,Важрамен байланыс мүмкіндігін зерттеу мақсатында.
Dialogue: 0,0:56:45.11,0:56:49.14,Default,,0,0,0,,Біз клиентіміз Шерил Номды құтқаруға тырысып жатырмыз.
Dialogue: 0,0:56:49.97,0:56:52.94,Default,,0,0,0,,Шерилмен еріп жүру келісімшарты әлі жойылған жоқ.
Dialogue: 0,0:56:53.24,0:56:55.24,Default,,0,0,0,,Баланс алынбады.
Dialogue: 0,0:56:55.34,0:56:56.17,Default,,0,0,0,,Иә
Dialogue: 0,0:56:57.14,0:57:00.84,Default,,0,0,0,,Алайда бұл әрекетті Мишима мен шекара үкіметі жүзеге асырды.
Dialogue: 0,0:57:00.94,0:57:03.04,Default,,0,0,0,,сатқындық әрекеті ретінде қарастырылады
Dialogue: 0,0:57:03.51,0:57:07.44,Default,,0,0,0,,Әрине, біз, тіпті адамдар арасындағы шайқастарға да қатысамыз,
Dialogue: 0,0:57:07.71,0:57:12.04,Default,,0,0,0,,Мұндай игі мақсат үшін әрекет ету екіжүзділіктен басқа ештеңе болмауы мүмкін.
Dialogue: 0,0:57:12.97,0:57:15.41,Default,,0,0,0,,Менімен бірге келесің бе?
Dialogue: 0,0:57:16.74,0:57:17.71,Default,,0,0,0,,Иә
Dialogue: 0,0:57:19.21,0:57:20.47,Default,,0,0,0,,Бірақ қалай?
Dialogue: 0,0:57:21.04,0:57:23.11,Default,,0,0,0,,Алькатраста қауіпсіздік қатаң...
Dialogue: 0,0:57:23.71,0:57:27.87,Default,,0,0,0,,Желіге оны ішіне қою арқылы оны ішінен қосыңыз
Dialogue: 0,0:57:28.57,0:57:30.84,Default,,0,0,0,,Қауіпсіздік жүйесі өте жақсы.
Dialogue: 0,0:57:31.51,0:57:33.01,Default,,0,0,0,,Сіз өте сенімді сияқтысыз.
Dialogue: 0,0:57:33.61,0:57:37.21,Default,,0,0,0,,Ол жақтағы жүйе менікі... LAI жасаған.
Dialogue: 0,0:57:37.51,0:57:40.74,Default,,0,0,0,,Иә, бұл сіз үшін ең жақсы компания
Dialogue: 0,0:57:41.01,0:57:42.94,Default,,0,0,0,,Олай болса, қалай...
Dialogue: 0,0:57:43.41,0:57:45.04,Default,,0,0,0,,Маған орындауға рұқсат етіңіз
Dialogue: 0,0:57:45.97,0:57:46.77,Default,,0,0,0,,Ранка!
Dialogue: 0,0:57:47.74,0:57:50.21,Default,,0,0,0,,Менде бір идея бар!
Dialogue: 0,0:57:51.04,0:58:04.21,Default,,0,0,0,,Ланка-Ланка…
Dialogue: 0,0:58:04.34,0:58:10.01,Default,,0,0,0,,Уау
Dialogue: 0,0:58:10.07,0:58:12.57,Default,,0,0,0,,Қайырлы кеш, Алькатрастағы баршаңызға!
Dialogue: 0,0:58:13.11,0:58:14.51,Default,,0,0,0,,Бұл Ранка Ли.
Dialogue: 0,0:58:16.67,0:58:21.77,Default,,0,0,0,,Бүгін кешке директордың рұқсатымен тікелей эфирде жұбататын боламын!
Dialogue: 0,0:58:21.91,0:58:26.07,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:58:27.17,0:58:29.64,Default,,0,0,0,,Ей, бұл жақсы идея.
Dialogue: 0,0:58:30.34,0:58:35.14,Default,,0,0,0,,Важра сияқты қатпарлы бактериялар жұқтырған адамның ән айту дауысын пайдалану.
Dialogue: 0,0:58:35.61,0:58:38.74,Default,,0,0,0,,Важраның байланыс протоколын талдауға тырысу...
Dialogue: 0,0:58:41.14,0:58:44.74,Default,,0,0,0,,Мына балаға не болды... Шерил?
Dialogue: 0,0:58:45.97,0:58:49.54,Default,,0,0,0,,Қабырғаға өлең жазып жатқан сияқты.
Dialogue: 0,0:58:50.21,0:58:51.11,Default,,0,0,0,,Поэзия...
Dialogue: 0,0:58:51.51,0:58:52.94,Default,,0,0,0,,Пайдасыз заттар
Dialogue: 0,0:58:53.51,0:58:56.51,Default,,0,0,0,,Хаттама талданғанша бұл менің өмірім болса да.
Dialogue: 0,0:58:57.64,0:58:59.94,Default,,0,0,0,,Иә... ән...
Dialogue: 0,0:59:00.71,0:59:05.91,Default,,0,0,0,,Дұрыс, сізге нұсқау беріп тұрған желі шеберлері.
Dialogue: 0,0:59:06.34,0:59:10.27,Default,,0,0,0,,Ол өз өмірін кепілдендіруге айырбас ретінде ынтымақтастықты ұсынды.
Dialogue: 0,0:59:10.44,0:59:11.34,Default,,0,0,0,,Иә
Dialogue: 0,0:59:12.64,0:59:17.44,Default,,0,0,0,,Протоколды талдаудан кейін Важраны қалай басқаруға болады.
Dialogue: 0,0:59:21.94,0:59:22.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:26.57,0:59:28.47,Default,,0,0,0,,Бірақ бұл аянышты.
Dialogue: 0,0:59:29.01,0:59:33.14,Default,,0,0,0,,Мен сондай аянышты күйге түссем де аман қалғым келеді.
Dialogue: 0,0:59:38.57,0:59:40.81,Default,,0,0,0,,Бәрің мені құшақтап алыңдар!
Dialogue: 0,0:59:41.34,0:59:44.31,Default,,0,0,0,,Галактиканың шетіне дейін!
Dialogue: 0,1:00:03.14,1:00:06.41,Default,,0,0,0,,Су беті тербеледі
Dialogue: 0,1:00:06.54,1:00:10.21,Default,,0,0,0,,Жел сақинасы кеңейеді
Dialogue: 0,1:00:10.44,1:00:13.71,Default,,0,0,0,,Бір-біріне тиген саусақ ұштары
Dialogue: 0,1:00:13.87,1:00:16.24,Default,,0,0,0,,Көк ток
Dialogue: 0,1:00:17.71,1:00:21.04,Default,,0,0,0,,Тек бір-біріне қарап
Dialogue: 0,1:00:35.81,1:00:38.64,Default,,0,0,0,,Ауада қалқып тұрған жас
Dialogue: 0,1:00:38.84,1:00:42.81,Default,,0,0,0,,Маған бұл қайғылы оқиға ма, бәрібір
Dialogue: 0,1:00:42.97,1:00:45.57,Default,,0,0,0,,Мен сенімен бірге тұрғым келеді
Dialogue: 0,1:00:45.64,1:00:46.41,Default,,0,0,0,,Барлығына!
Dialogue: 0,1:00:46.47,1:00:47.27,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,1:00:47.37,1:00:50.27,Default,,0,0,0,,Метеорға міну
Dialogue: 0,1:00:50.37,1:00:54.04,Default,,0,0,0,,Саған құлап бара жатырмын
Dialogue: 0,1:00:54.37,1:00:57.61,Default,,0,0,0,,Қою көк жұлдызды аспанда
Dialogue: 0,1:00:57.67,1:01:01.07,Default,,0,0,0,,Біз отшашу сияқтымыз
Dialogue: 0,1:01:01.14,1:01:05.91,Default,,0,0,0,,Жүрек нұрдың жебесін атады
Dialogue: 0,1:01:22.54,1:01:23.57,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:01:29.74,1:01:30.74,Default,,0,0,0,,Тағы бір қадам...
Dialogue: 0,1:01:38.41,1:01:40.34,Default,,0,0,0,,Ешқандай әңгімесіз
Dialogue: 0,1:01:40.41,1:01:43.11,Default,,0,0,0,,Көңіліңді түсірме, қарғыс атсын!
Dialogue: 0,1:01:45.71,1:01:48.81,Default,,0,0,0,,Ойларын оқи алады
Dialogue: 0,1:01:49.31,1:01:51.54,Default,,0,0,0,,Жұмбақ түн
Dialogue: 0,1:01:52.41,1:01:56.44,Default,,0,0,0,,Сенің атың сиқыр сияқты
Dialogue: 0,1:01:56.54,1:01:59.17,Default,,0,0,0,,Шексіз қайталау
Dialogue: 0,1:01:59.47,1:02:01.34,Default,,0,0,0,,Бұл жиіркенішті...
Dialogue: 0,1:02:01.41,1:02:02.71,Default,,0,0,0,,Бұл ән...
Dialogue: 0,1:02:03.54,1:02:05.44,Default,,0,0,0,,Тырнақтарыңызды жасап көріңіз
Dialogue: 0,1:02:05.51,1:02:06.17,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,1:02:06.27,1:02:07.11,Default,,0,0,0,,Бірге!
Dialogue: 0,1:02:07.17,1:02:07.77,Default,,0,0,0,,Кира!
Dialogue: 0,1:02:07.91,1:02:10.87,Default,,0,0,0,,Бүкіл денесі мөлдір
Dialogue: 0,1:02:10.94,1:02:14.44,Default,,0,0,0,,Кескіндемедей қалқып жүр
Dialogue: 0,1:02:15.04,1:02:18.21,Default,,0,0,0,,Тіпті өмірдің көкнәр дәні
Dialogue: 0,1:02:18.27,1:02:21.64,Default,,0,0,0,,Біз жыпылықтаймыз
Dialogue: 0,1:02:21.77,1:02:25.84,Default,,0,0,0,,Менің жаныма галактикалар құлайды
Dialogue: 0,1:02:26.04,1:02:29.04,Default,,0,0,0,,Метеорға міну
Dialogue: 0,1:02:29.21,1:02:31.44,Default,,0,0,0,,Сіз ұшасыз...
Dialogue: 0,1:02:31.51,1:02:32.87,Default,,0,0,0,,Тоқта! Эй
Dialogue: 0,1:02:33.27,1:02:36.44,Default,,0,0,0,,Қою көк жұлдызды аспанда
Dialogue: 0,1:02:36.57,1:02:39.87,Default,,0,0,0,,Біз отшашу сияқтымыз
Dialogue: 0,1:02:40.14,1:02:46.51,Default,,0,0,0,,Жүрек нұрдың жебесін атады
Dialogue: 0,1:02:51.67,1:02:54.77,Default,,0,0,0,,Тіпті өмірдің көкнәр дәні
Dialogue: 0,1:02:54.94,1:02:58.11,Default,,0,0,0,,Біз жыпылықтаймыз
Dialogue: 0,1:02:58.17,1:02:58.87,Default,,0,0,0,,Дабыл!
Dialogue: 0,1:02:58.94,1:02:59.91,Default,,0,0,0,,Жоғарыда!
Dialogue: 0,1:03:00.61,1:03:01.61,Default,,0,0,0,,Уау!
Dialogue: 0,1:03:04.94,1:03:05.77,Default,,0,0,0,,Шерил
Dialogue: 0,1:03:07.67,1:03:08.51,Default,,0,0,0,,Шерил!
Dialogue: 0,1:03:08.84,1:03:09.64,Default,,0,0,0,,Ах!
Dialogue: 0,1:03:10.37,1:03:11.77,Default,,0,0,0,,Қайтып, еденге жат!
Dialogue: 0,1:03:12.07,1:03:13.27,Default,,0,0,0,,Ха, бұл дауыс!
Dialogue: 0,1:03:14.97,1:03:15.94,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:03:22.54,1:03:23.44,Default,,0,0,0,,Альто…
Dialogue: 0,1:03:24.07,1:03:26.97,Default,,0,0,0,,Ух... Поэзия... Сондай уақытқа дейін
Dialogue: 0,1:03:28.01,1:03:29.94,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,1:03:30.31,1:03:34.14,Default,,0,0,0,,Эй, сен жалғыз емессің дедім ғой.
Dialogue: 0,1:03:34.77,1:03:37.14,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:03:37.97,1:03:38.84,Default,,0,0,0,,Идиот!
Dialogue: 0,1:03:40.01,1:03:43.61,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,1:03:47.91,1:03:50.54,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,1:03:50.74,1:03:54.84,Default,,0,0,0,,Комета тәрізді таза бұрышпен
Dialogue: 0,1:03:55.47,1:03:59.31,Default,,0,0,0,,Сенің етегің желбіреп тұр
Dialogue: 0,1:03:59.37,1:04:00.84,Default,,0,0,0,,оны алыңыз
Dialogue: 0,1:04:04.11,1:04:09.14,Default,,0,0,0,,... шарықтау шегіне дейін
Dialogue: 0,1:04:10.41,1:04:12.67,Default,,0,0,0,,Шерил Номаның қатпар толқыны артып келеді
Dialogue: 0,1:04:13.11,1:04:14.97,Default,,0,0,0,,Ранка Ли толқынымен резонанста
Dialogue: 0,1:04:15.04,1:04:17.74,Default,,0,0,0,,Біз Важраның қатпарлы торына кедергі жасаймыз.
Dialogue: 0,1:04:18.21,1:04:20.87,Default,,0,0,0,,Протоколды талдау жылдамдығы 97,5%
Dialogue: 0,1:04:21.34,1:04:23.61,Default,,0,0,0,,Талдаудың аяқталуына 90 секунд қалды
Dialogue: 0,1:04:23.84,1:04:24.57,Default,,0,0,0,,Жарайды
Dialogue: 0,1:04:26.27,1:04:30.41,Default,,0,0,0,,Алайда тұтқын қашып кетті, түрмеде тәртіпсіздік орнады.
Dialogue: 0,1:04:30.84,1:04:34.24,Default,,0,0,0,,Дүрбелең емес! Бұл дәреже қазірдің өзінде күтілуде.
Dialogue: 0,1:04:34.74,1:04:37.04,Default,,0,0,0,,Нәжіс бактерияларды қатпарлайды
Dialogue: 0,1:04:37.24,1:04:40.61,Default,,0,0,0,,Жүргізуші қанша ән айтса, соғұрлым белсенді болады.
Dialogue: 0,1:04:41.51,1:04:44.24,Default,,0,0,0,,Жақсы, сол тонмен ән айт.
Dialogue: 0,1:04:45.81,1:04:46.67,Default,,0,0,0,,О? Сіздер әлдеқашан бастадыңыздар ма? Әңгіме
Dialogue: 0,1:04:47.17,1:04:48.07,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:04:48.44,1:04:49.27,Default,,0,0,0,,Ұшайық!
Dialogue: 0,1:04:49.47,1:04:49.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:50.54,1:04:51.07,Default,,0,0,0,,Әй!
Dialogue: 0,1:04:52.07,1:04:53.07,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,1:04:55.61,1:04:56.57,Default,,0,0,0,,Бұл...
Dialogue: 0,1:04:56.81,1:04:57.67,Default,,0,0,0,,Бір нәрсені қайтарыңыз
Dialogue: 0,1:05:03.87,1:05:04.71,Default,,0,0,0,,Ах!
Dialogue: 0,1:05:09.04,1:05:10.11,Default,,0,0,0,,Шерил!
Dialogue: 0,1:05:11.57,1:05:13.51,Default,,0,0,0,,Рахмет сізге Ранка-чан
Dialogue: 0,1:05:14.01,1:05:15.84,Default,,0,0,0,,Шерилоу!
Dialogue: 0,1:05:16.41,1:05:17.77,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,1:05:17.84,1:05:19.87,Default,,0,0,0,,Құрметті Шерил
Dialogue: 0,1:05:19.94,1:05:22.54,Default,,0,0,0,,Барлығымыз, қашайық!
Dialogue: 0,1:05:22.74,1:05:25.27,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,1:05:25.81,1:05:30.44,Default,,0,0,0,,оны киіп алыңыз
Dialogue: 0,1:05:30.91,1:05:32.77,Default,,0,0,0,,Бүктелген толқынның қосылуын растаңыз
Dialogue: 0,1:05:34.67,1:05:36.34,Default,,0,0,0,,Протоколды талдаудың соңы
Dialogue: 0,1:05:36.81,1:05:38.97,Default,,0,0,0,,Хе, басу күшін жібер.
Dialogue: 0,1:05:41.87,1:05:43.37,Default,,0,0,0,,Көптеген қатпарлану реакциялары расталды
Dialogue: 0,1:05:43.77,1:05:44.57,Default,,0,0,0,,Бұл...
Dialogue: 0,1:05:45.27,1:05:46.11,Default,,0,0,0,,Бұл Ваджра!
Dialogue: 0,1:05:51.21,1:05:54.41,Default,,0,0,0,,Өзгерістер...
Dialogue: 0,1:05:54.61,1:05:55.64,Default,,0,0,0,,Уф!
Dialogue: 0,1:05:55.74,1:05:58.14,Default,,0,0,0,,А, а
Dialogue: 0,1:05:58.87,1:05:59.47,Default,,0,0,0,,Иә!
Dialogue: 0,1:05:59.77,1:06:00.64,Default,,0,0,0,,Уф...
Dialogue: 0,1:06:01.11,1:06:02.94,Default,,0,0,0,,Мұны маған қалдырыңыз. Асығыңыз!
Dialogue: 0,1:06:04.01,1:06:05.01,Default,,0,0,0,,Өлме
Dialogue: 0,1:06:05.37,1:06:07.81,Default,,0,0,0,,Осы екеуін дұрыстап қорғау керек адам.
Dialogue: 0,1:06:08.71,1:06:12.17,Default,,0,0,0,,ешқашан жалғыз емес
Dialogue: 0,1:06:12.24,1:06:13.04,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:06:13.34,1:06:17.54,Default,,0,0,0,,Сен жұлдызсың
Dialogue: 0,1:06:22.74,1:06:25.17,Default,,0,0,0,,Бірінші дәрежелі төтенше жағдайдағы барлық әскерлер
Dialogue: 0,1:06:25.57,1:06:27.47,Default,,0,0,0,,Ваджраны дереу тоқтатыңыз
Dialogue: 0,1:06:27.81,1:06:32.17,Default,,0,0,0,,Бірінші дәрежелі төтенше жағдайдағы барлық күштер Бірінші дәрежелі төтенше жағдайдағы барлық күштер
Dialogue: 0,1:06:32.41,1:06:34.01,Default,,0,0,0,,Бұл жаттығуды қайталау емес
Dialogue: 0,1:06:34.11,1:06:36.21,Default,,0,0,0,,Pegasus Griffon взводының ұшыру күту режимі
Dialogue: 0,1:06:36.34,1:06:38.34,Default,,0,0,0,,Катапультті орналастыру Жолды тазалау
Dialogue: 0,1:06:42.51,1:06:47.67,Default,,0,0,0,,1-аралдың барлық энергиясын пайдаланып кептеліс кодтарын жіберуге рұқсат етіңіз.
Dialogue: 0,1:06:48.71,1:06:51.01,Default,,0,0,0,,Бірақ бұл шынымен жұмыс істей ме?
Dialogue: 0,1:06:51.97,1:06:54.41,Default,,0,0,0,,Қоғамға қауіп төндірудің қажеті жоқ...
Dialogue: 0,1:06:55.97,1:07:00.57,Default,,0,0,0,,Важра - тіпті Галактика флотын жойған жау.
Dialogue: 0,1:07:01.07,1:07:05.71,Default,,0,0,0,,Егер бұл жұмыс істемесе, біздің аман қалудың жолы жоқ.
Dialogue: 0,1:07:06.27,1:07:07.31,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,1:07:08.14,1:07:09.77,Default,,0,0,0,,Күлгін взвод жойылды!
Dialogue: 0,1:07:09.87,1:07:10.74,Default,,0,0,0,,Иә? О!
Dialogue: 0,1:07:15.27,1:07:17.31,Default,,0,0,0,,CV47 Урага батып кетті!
Dialogue: 0,1:07:19.74,1:07:20.74,Default,,0,0,0,,Уф...
Dialogue: 0,1:07:26.94,1:07:29.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:34.64,1:07:36.01,Default,,0,0,0,,Важра…
Dialogue: 0,1:07:37.91,1:07:39.11,Default,,0,0,0,,Шешім қабылда
Dialogue: 0,1:07:40.07,1:07:41.04,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:41.84,1:07:42.84,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:07:43.61,1:07:46.91,Default,,0,0,0,,Важраға қарсы «Гипноз» қарсы шабуылы басталады!
Dialogue: 0,1:08:12.67,1:08:14.71,Default,,0,0,0,,Менің әжем Вайра зерттеушісі болған.
Dialogue: 0,1:08:15.64,1:08:17.21,Default,,0,0,0,,Мен оны көптен бері іздеп жүрмін
Dialogue: 0,1:08:18.94,1:08:21.97,Default,,0,0,0,,Жоғалған әпкесі сияқты
Dialogue: 0,1:08:22.67,1:08:27.67,Default,,0,0,0,,Адамдар ғана емес, құстар мен аңдар, шөптер мен гүлдер...
Dialogue: 0,1:08:28.47,1:08:33.17,Default,,0,0,0,,Ал желмен, теңізбен тілдесетін әнші.
Dialogue: 0,1:08:34.24,1:08:35.71,Default,,0,0,0,,«Жел бағыттаушы»…
Dialogue: 0,1:08:36.51,1:08:38.94,Default,,0,0,0,,Құстар, жел және жүрек...
Dialogue: 0,1:08:39.24,1:08:42.54,Default,,0,0,0,,Иә, бұл Ранка-чанға ұқсайды.
Dialogue: 0,1:08:44.01,1:08:45.04,Default,,0,0,0,,Мен...
Dialogue: 0,1:08:45.67,1:08:47.37,Default,,0,0,0,,Әже ойланып қалды
Dialogue: 0,1:08:48.04,1:08:49.64,Default,,0,0,0,,«Жел бағыттаушы»
Dialogue: 0,1:08:49.74,1:08:53.04,Default,,0,0,0,,Менің ойымша, мен Ваджрамен сөйлесе аламын.
Dialogue: 0,1:08:53.34,1:08:57.44,Default,,0,0,0,,Бірақ жоспар сәтсіз аяқталып, Важра зерттеу тобына шабуыл жасады.
Dialogue: 0,1:08:59.24,1:09:01.57,Default,,0,0,0,,Иә, деді Грейс.
Dialogue: 0,1:09:02.27,1:09:04.27,Default,,0,0,0,,Жоқ, мен саған шабуыл жасаған жоқпын...
Dialogue: 0,1:09:04.41,1:09:05.24,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:05.34,1:09:07.04,Default,,0,0,0,,есіме түсті
Dialogue: 0,1:09:07.47,1:09:10.74,Default,,0,0,0,,Ваджра бұл жолы да маған шабуыл жасаған жоқ.
Dialogue: 0,1:09:11.01,1:09:13.41,Default,,0,0,0,,Мүмкін ол көмектескісі келген шығар
Dialogue: 0,1:09:14.04,1:09:14.97,Default,,0,0,0,,Анықтама…
Dialogue: 0,1:09:15.07,1:09:16.91,Default,,0,0,0,,Менің есімде жақсы, Ранка.
Dialogue: 0,1:09:17.01,1:09:17.87,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:19.14,1:09:20.07,Default,,0,0,0,,Брера
Dialogue: 0,1:09:27.17,1:09:29.41,Default,,0,0,0,,Мен сені алып кетуге келдім, Ранка.
Dialogue: 0,1:09:30.14,1:09:32.51,Default,,0,0,0,,Важрамен соғысты аяқтау
Dialogue: 0,1:09:34.01,1:09:35.27,Default,,0,0,0,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,1:09:37.21,1:09:38.04,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:38.14,1:09:40.01,Default,,0,0,0,,Жүр, кел, Ранка.
Dialogue: 0,1:09:41.87,1:09:42.71,Default,,0,0,0,,Ранка!
Dialogue: 0,1:09:43.61,1:09:48.07,Default,,0,0,0,,Жоқ, Ранка-чан! Ол енді сенің ағаң емес.
Dialogue: 0,1:09:48.71,1:09:52.01,Default,,0,0,0,,Мен саған жол көрсету үшін ағаңа имплант салдым.
Dialogue: 0,1:09:52.11,1:09:55.74,Default,,0,0,0,,Галактика армиясы басқаратын қуыршақ!
Dialogue: 0,1:09:55.87,1:09:56.74,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:57.64,1:10:00.07,Default,,0,0,0,,Маған опасыздық жасайсың ба? Ертегі 9
Dialogue: 0,1:10:00.34,1:10:05.34,Default,,0,0,0,,Олар сені өлтіріп, барлық иммундық ағзаларыңды менің денеме ауыстырады.
Dialogue: 0,1:10:05.44,1:10:05.84,Default,,0,0,0,,Не!
Dialogue: 0,1:10:05.94,1:10:06.71,Default,,0,0,0,,Не!
Dialogue: 0,1:10:10.17,1:10:11.64,Default,,0,0,0,,Мен сені атып аламын ба?
Dialogue: 0,1:10:12.01,1:10:14.57,Default,,0,0,0,,Әй, осы екеуін қорғау үшін!
Dialogue: 0,1:10:15.24,1:10:16.17,Default,,0,0,0,,Әй
Dialogue: 0,1:10:19.17,1:10:19.97,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:10:20.54,1:10:21.31,Default,,0,0,0,,Аһ!
Dialogue: 0,1:10:21.81,1:10:22.74,Default,,0,0,0,,Га
Dialogue: 0,1:10:22.94,1:10:23.84,Default,,0,0,0,,Альто!
Dialogue: 0,1:10:24.14,1:10:26.61,Default,,0,0,0,,Жүр, кеттік, Ранка.
Dialogue: 0,1:10:28.54,1:10:29.34,Default,,0,0,0,,Е...
Dialogue: 0,1:10:32.31,1:10:33.14,Default,,0,0,0,,Ранка!
Dialogue: 0,1:10:33.27,1:10:34.17,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,1:10:34.27,1:10:35.07,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,1:10:35.57,1:10:38.34,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, Ранка, асығыңыз және тоқсанға барыңыз!
Dialogue: 0,1:10:42.41,1:10:43.47,Default,,0,0,0,,Озма Ли
Dialogue: 0,1:10:46.87,1:10:47.74,Default,,0,0,0,,Уф!
Dialogue: 0,1:11:00.14,1:11:00.97,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:11:15.87,1:11:17.04,Default,,0,0,0,,Уау...
Dialogue: 0,1:11:17.31,1:11:19.34,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:34.31,1:11:37.21,Default,,0,0,0,,Бұл үлкен мәселе. Не болып жатыр?
Dialogue: 0,1:11:37.61,1:11:39.81,Default,,0,0,0,,Мен білмеймін! Сен үніңді...
Dialogue: 0,1:11:39.87,1:11:40.74,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:50.84,1:11:51.87,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:52.37,1:11:53.24,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:54.97,1:11:56.17,Default,,0,0,0,,Ей!
Dialogue: 0,1:11:58.51,1:11:59.54,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,1:11:59.94,1:12:01.14,Default,,0,0,0,,Асығыңыз! Ранка!
Dialogue: 0,1:12:05.31,1:12:06.17,Default,,0,0,0,,Құт
Dialogue: 0,1:12:06.24,1:12:07.11,Default,,0,0,0,,Уау!
Dialogue: 0,1:12:07.87,1:12:09.04,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,1:12:16.37,1:12:17.21,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:18.17,1:12:20.61,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:12:24.34,1:12:25.24,Default,,0,0,0,,2-раунд, 1-жекпе-жек
Dialogue: 0,1:12:27.67,1:12:28.97,Default,,0,0,0,,Уф...
Dialogue: 0,1:12:30.34,1:12:31.64,Default,,0,0,0,,Ах! Tsk
Dialogue: 0,1:12:37.21,1:12:38.71,Default,,0,0,0,,Ах... Капитан...
Dialogue: 0,1:12:42.41,1:12:45.34,Default,,0,0,0,,Мен осыдан кейін өлгенше шыдамаймын!
Dialogue: 0,1:12:50.04,1:12:54.31,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,1:12:54.77,1:12:55.51,Default,,0,0,0,,Кя!
Dialogue: 0,1:12:56.67,1:12:57.71,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:02.51,1:13:04.34,Default,,0,0,0,,Қ-қарай берсең де, мен жылап тұрғаным жоқ
Dialogue: 0,1:13:05.57,1:13:06.41,Default,,0,0,0,,Альто!
Dialogue: 0,1:13:06.54,1:13:07.21,Default,,0,0,0,,Дабыл!
Dialogue: 0,1:13:07.34,1:13:08.24,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:08.74,1:13:09.81,Default,,0,0,0,,Кяах!
Dialogue: 0,1:13:11.17,1:13:13.71,Default,,0,0,0,,Шерил! Рейтингші!
Dialogue: 0,1:13:14.37,1:13:15.24,Default,,0,0,0,,Ах
Dialogue: 0,1:13:16.21,1:13:17.27,Default,,0,0,0,,Шерил
Dialogue: 0,1:13:22.04,1:13:22.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:32.97,1:13:33.87,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:36.64,1:13:37.37,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:13:41.17,1:13:43.44,Default,,0,0,0,,Шерилоу!
Dialogue: 0,1:13:46.91,1:13:49.24,Default,,0,0,0,,Anti-Vajra кептеліс кодын орнату аяқталды
Dialogue: 0,1:13:50.07,1:13:52.34,Default,,0,0,0,,Кептелу жүйесі Шығыс күту режимі
Dialogue: 0,1:13:52.64,1:13:54.51,Default,,0,0,0,,Барлық реакторлардың максималды шығуы
Dialogue: 0,1:13:56.07,1:13:56.91,Default,,0,0,0,,Сәулелену!
Dialogue: 0,1:14:03.97,1:14:05.07,Default,,0,0,0,,А... Келме.
Dialogue: 0,1:14:05.24,1:14:07.47,Default,,0,0,0,,А... Келме!
Dialogue: 0,1:14:18.87,1:14:19.94,Default,,0,0,0,,Ол тоқтады ма?
Dialogue: 0,1:14:21.01,1:14:23.57,Default,,0,0,0,,Важра энергиялық қалқаны жоғалады
Dialogue: 0,1:14:25.74,1:14:26.91,Default,,0,0,0,,Ол жұмыс істейді
Dialogue: 0,1:14:27.37,1:14:29.71,Default,,0,0,0,,Сенің кезегің, бейбақ!
Dialogue: 0,1:14:30.21,1:14:32.31,Default,,0,0,0,,Білсін!
Dialogue: 0,1:14:36.91,1:14:38.34,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,1:14:39.34,1:14:40.24,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,1:14:44.11,1:14:46.14,Default,,0,0,0,,Екінші фазаға барлық күштер!
Dialogue: 0,1:14:46.77,1:14:48.61,Default,,0,0,0,,Барлық күштер екінші фаза
Dialogue: 0,1:14:48.74,1:14:51.34,Default,,0,0,0,,Важра импланттарына шабуыл жасай бастаңыз.
Dialogue: 0,1:15:14.91,1:15:18.94,Default,,0,0,0,,Vajra fold желіге қосылу жылдамдығы 93,5%
Dialogue: 0,1:15:22.24,1:15:23.47,Default,,0,0,0,,Важра...
Dialogue: 0,1:15:24.21,1:15:28.21,Default,,0,0,0,,Hmph, сіз мұнымен жеңе аласыз. Сіз жеңе аласыз, Важра!
Dialogue: 0,1:15:28.84,1:15:33.04,Default,,0,0,0,,Жалғыз нәрсе - бұл импульсті Важраның туған планетасын тастау үшін пайдалану!
Dialogue: 0,1:15:46.24,1:15:49.37,Default,,0,0,0,,Уф... Капитан... Шерил...
Dialogue: 0,1:15:50.14,1:15:51.51,Default,,0,0,0,,Уф...
Dialogue: 0,1:15:52.77,1:15:54.47,Default,,0,0,0,,Қалағаныңды істе, Альто.
Dialogue: 0,1:15:55.17,1:15:58.64,Default,,0,0,0,,Қазір қайғыратын уақыт емес. Оян!
Dialogue: 0,1:15:59.24,1:16:00.04,Default,,0,0,0,,Уф!
Dialogue: 0,1:16:00.11,1:16:00.97,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:03.47,1:16:05.11,Default,,0,0,0,,Қайғылы болғанның несі жаман?
Dialogue: 0,1:16:06.71,1:16:10.34,Default,,0,0,0,,Қанша мұңайсам да, енді қашпаймын.
Dialogue: 0,1:16:11.54,1:16:14.91,Default,,0,0,0,,Мен бұл шайқас біткенше ұшамын!
Dialogue: 0,1:16:16.51,1:16:17.61,Default,,0,0,0,,Альто
Dialogue: 0,1:16:19.34,1:16:20.34,Default,,0,0,0,,Альто-кун...
Dialogue: 0,1:16:22.34,1:16:23.21,Default,,0,0,0,,Хмм...
Dialogue: 0,1:16:24.01,1:16:26.24,Default,,0,0,0,,Мен сені енді ханшайым деп айта алмаймын.
Dialogue: 0,1:16:29.61,1:16:32.51,Default,,0,0,0,,Кеме жақын арада төтенше жағдайға түседі.
Dialogue: 0,1:16:32.71,1:16:36.57,Default,,0,0,0,,Қайталап айтамын, кеме жақын арада апаттық қатпарға түседі.
Dialogue: 0,1:16:58.14,1:17:02.74,Default,,0,0,0,,Макросс кварталының капитаны Джеффри Уайлдер бүкіл экипажға айтып береді
Dialogue: 0,1:17:03.84,1:17:06.74,Default,,0,0,0,,Шекара күштері 1-аралды бөледі
Dialogue: 0,1:17:07.11,1:17:10.11,Default,,0,0,0,,Важраның негізгі жұлдыз секторына бүгу байқалды.
Dialogue: 0,1:17:10.87,1:17:14.77,Default,,0,0,0,,Олар енді Важраның байланыс протоколын талдады.
Dialogue: 0,1:17:15.07,1:17:16.81,Default,,0,0,0,,Күшті қатпарлы толқындар арқылы
Dialogue: 0,1:17:17.11,1:17:20.41,Default,,0,0,0,,Важра бақылауда деп болжануда.
Dialogue: 0,1:17:22.14,1:17:26.31,Default,,0,0,0,,Егер шекара әскері Важраның басты планетасына басып кіруді жалғастыра берсе,
Dialogue: 0,1:17:27.11,1:17:30.21,Default,,0,0,0,,Отбасыңыз бен достарыңызды қоса
Dialogue: 0,1:17:30.41,1:17:34.27,Default,,0,0,0,,Миллиондаған адамдардың өміріне қауіп төнеді
Dialogue: 0,1:17:35.34,1:17:36.77,Default,,0,0,0,,Және олар
Dialogue: 0,1:17:36.97,1:17:40.47,Default,,0,0,0,,Егер барлық Ваджраларды бақылауға алу мүмкін болса,
Dialogue: 0,1:17:40.87,1:17:44.47,Default,,0,0,0,,Бұл бүкіл галактикаға үстемдік ету дегенді білдіреді.
Dialogue: 0,1:17:45.64,1:17:48.87,Default,,0,0,0,,Алайда, қатпарлы ақаулардан туындаған бұзылуларға байланысты
Dialogue: 0,1:17:49.17,1:17:54.74,Default,,0,0,0,,Бірыңғай үкіметке немесе SMS штабына жіберілген көмек сұрауларына жауап жоқ.
Dialogue: 0,1:17:56.21,1:17:59.27,Default,,0,0,0,,Енді Шерил Номды құтқару сәтсіз аяқталды.
Dialogue: 0,1:17:59.41,1:18:02.51,Default,,0,0,0,,Бізге бір ғана мүмкіндік қалды
Dialogue: 0,1:18:03.14,1:18:07.37,Default,,0,0,0,,Басқа дива Ранка Ли айтқан бүктелген әнмен.
Dialogue: 0,1:18:07.77,1:18:10.04,Default,,0,0,0,,Важрамен сөйлесу
Dialogue: 0,1:18:10.47,1:18:13.64,Default,,0,0,0,,Осы бекер соғысты тоқтату
Dialogue: 0,1:18:14.87,1:18:19.24,Default,,0,0,0,,Кепілге алынған арал 1 азаматтарының өмірі және галактиканың тағдыры.
Dialogue: 0,1:18:19.47,1:18:21.54,Default,,0,0,0,,Бұл сіздің жұмысыңызға байланысты.
Dialogue: 0,1:18:24.44,1:18:26.64,Default,,0,0,0,,Барлық жеке құрам шешуші шайқасқа жіберілді!
Dialogue: 0,1:18:27.07,1:18:28.07,Default,,0,0,0,,Польнарефф?
Dialogue: 0,1:18:34.57,1:18:37.11,Default,,0,0,0,,Түсу жылдамдығы секундына 800 метрге дейін төмендетілді
Dialogue: 0,1:18:37.31,1:18:39.44,Default,,0,0,0,,Гравитацияны басқару жүйесі Аномалия жоқ
Dialogue: 0,1:18:39.54,1:18:42.37,Default,,0,0,0,,Атмосфералық құрамы Азот 77,9%
Dialogue: 0,1:18:42.51,1:18:47.14,Default,,0,0,0,,Оттегі 21,2% Көмірқышқыл газы 0,037%
Dialogue: 0,1:18:47.71,1:18:49.77,Default,,0,0,0,,Бұл жердегі планета
Dialogue: 0,1:18:50.11,1:18:51.04,Default,,0,0,0,,Ой
Dialogue: 0,1:18:51.44,1:18:52.57,Default,,0,0,0,,Керемет
Dialogue: 0,1:18:52.97,1:18:58.11,Default,,0,0,0,,Бұл жұлдыз 500 жыл бұрынғы Колумб пен Магелланнан кейінгі ең үлкен жаңалық.
Dialogue: 0,1:18:58.47,1:19:02.61,Default,,0,0,0,,Қатпарлы кварцтың бай ресурстары мен өмір сүруге жарамды жері бар.
Dialogue: 0,1:19:02.74,1:19:04.57,Default,,0,0,0,,Керемет шекара!
Dialogue: 0,1:19:05.74,1:19:07.47,Default,,0,0,0,,Президент Ховард Гласс
Dialogue: 0,1:19:08.07,1:19:14.31,Default,,0,0,0,,Сенің есімің галактика тарихында мәңгі жарқырайды.
Dialogue: 0,1:19:14.51,1:19:17.14,Default,,0,0,0,,А, рахмет саған, Мишима-кун.
Dialogue: 0,1:19:17.57,1:19:19.97,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,1:19:22.84,1:19:25.47,Default,,0,0,0,,Енді өз әскерлеріңді ұяларына жіберіңдер.
Dialogue: 0,1:19:25.91,1:19:28.01,Default,,0,0,0,,Тек Ваджра патшайымын басқарыңыз
Dialogue: 0,1:19:28.77,1:19:31.61,Default,,0,0,0,,Сонда галактика біздікі болады!
Dialogue: 0,1:19:31.71,1:19:34.44,Default,,0,0,0,,Иә, бұл біздікі!
Dialogue: 0,1:19:35.57,1:19:36.87,Default,,0,0,0,,Бұл не...
Dialogue: 0,1:19:37.54,1:19:38.37,Default,,0,0,0,,Ах!
Dialogue: 0,1:19:38.71,1:19:39.57,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:19:43.14,1:19:44.07,Default,,0,0,0,,Кяах!
Dialogue: 0,1:19:44.31,1:19:45.34,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,1:19:45.57,1:19:47.21,Default,,0,0,0,,Ах!
Dialogue: 0,1:20:01.54,1:20:03.91,Default,,0,0,0,,Жарайсың Антарес 1
Dialogue: 0,1:20:04.51,1:20:07.74,Default,,0,0,0,,Төтенше тәуелсіз бағдарлама орындалғанға дейін.
Dialogue: 0,1:20:15.64,1:20:17.64,Default,,0,0,0,,Әй, тар болды.
Dialogue: 0,1:20:18.07,1:20:20.57,Default,,0,0,0,,Бұл сізге біраз орын береді.
Dialogue: 0,1:20:20.94,1:20:23.64,Default,,0,0,0,,Ой... менің қуғыншым келген сияқты.
Dialogue: 0,1:20:30.04,1:20:33.01,Default,,0,0,0,,Мен заттарды жақсы көремін, тек бір кеме.
Dialogue: 0,1:20:33.77,1:20:35.41,Default,,0,0,0,,Біз тосқауылға барамыз ба?
Dialogue: 0,1:20:35.97,1:20:40.37,Default,,0,0,0,,Хмм, олармен Важра жігіттері айналыссын.
Dialogue: 0,1:20:40.94,1:20:46.37,Default,,0,0,0,,Біз соғыс шекарасындағы Королеваның ұясына кіреміз.
Dialogue: 0,1:21:07.84,1:21:10.67,Default,,0,0,0,,Хахахаха... Альто-кун!
Dialogue: 0,1:21:10.87,1:21:11.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:11.81,1:21:16.67,Default,,0,0,0,,Хахаха...
Dialogue: 0,1:21:16.84,1:21:20.37,Default,,0,0,0,,Сорт алдында сізді тағы көргеніме қуаныштымын.
Dialogue: 0,1:21:21.11,1:21:23.64,Default,,0,0,0,,Ранка Соно Какко...
Dialogue: 0,1:21:24.07,1:21:25.04,Default,,0,0,0,,Сізге сәйкес келе ме?
Dialogue: 0,1:21:26.17,1:21:29.64,Default,,0,0,0,,Бұл келесі жаңа әнге арналған сурет костюмі.
Dialogue: 0,1:21:29.91,1:21:30.97,Default,,0,0,0,,Жаңа ән?
Dialogue: 0,1:21:31.11,1:21:35.47,Default,,0,0,0,,Хехе... Мен мұндай уақытта ән айтамын деп ойламаппын.
Dialogue: 0,1:21:35.91,1:21:40.04,Default,,0,0,0,,Сондай-ақ, бұл менің сөзін жазуға ләззат алған алғашқы әнім.
Dialogue: 0,1:21:40.51,1:21:41.91,Default,,0,0,0,,Түсіндім, сені
Dialogue: 0,1:21:42.14,1:21:48.87,Default,,0,0,0,,Мм... бұл мен үшін өте маңызды адамға деген сезіміммен жазған өлең жолдары...
Dialogue: 0,1:21:49.57,1:21:53.41,Default,,0,0,0,,Сондықтан мен оның Важраға жететініне сенімдімін...
Dialogue: 0,1:21:53.94,1:21:54.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:55.44,1:21:57.61,Default,,0,0,0,,Маңызды... адам...
Dialogue: 0,1:21:58.77,1:21:59.91,Default,,0,0,0,,Мен...
Dialogue: 0,1:22:02.04,1:22:04.04,Default,,0,0,0,,Мен Альтоны жақсы көремін!
Dialogue: 0,1:22:04.67,1:22:05.51,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:06.31,1:22:07.27,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:08.77,1:22:10.04,Default,,0,0,0,,Мен айттым...
Dialogue: 0,1:22:10.74,1:22:12.77,Default,,0,0,0,,Ранка... Мен...
Dialogue: 0,1:22:12.97,1:22:14.07,Default,,0,0,0,,Айтпа!
Dialogue: 0,1:22:14.17,1:22:15.01,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:17.57,1:22:21.81,Default,,0,0,0,,Шайқаста ән айтқаннан да біртүрлі.
Dialogue: 0,1:22:22.07,1:22:26.74,Default,,0,0,0,,Альто-кунның сезімін есту әлдеқайда қорқынышты...
Dialogue: 0,1:22:30.47,1:22:34.97,Default,,0,0,0,,Қазір тыңдасам, ән айта алмай қалуым мүмкін...
Dialogue: 0,1:22:35.87,1:22:38.07,Default,,0,0,0,,Мен дұрыс ән айтамын...
Dialogue: 0,1:22:38.51,1:22:41.27,Default,,0,0,0,,Шерил мен сенің ағаң үшін
Dialogue: 0,1:22:41.44,1:22:44.04,Default,,0,0,0,,Әнді міндетті түрде Важраға жеткіземін.
Dialogue: 0,1:22:44.31,1:22:48.11,Default,,0,0,0,,Сондықтан... Альто-кун да сенімді.
Dialogue: 0,1:22:49.64,1:22:52.21,Default,,0,0,0,,Маған міндетті түрде қайтатыныңызға уәде беріңіз!
Dialogue: 0,1:22:53.64,1:22:54.64,Default,,0,0,0,,Ланка
Dialogue: 0,1:23:06.11,1:23:10.21,Default,,0,0,0,,Күту режимін бүктеңіз
Dialogue: 0,1:23:10.31,1:23:12.07,Default,,0,0,0,,…Диваны қорғаңыз!
Dialogue: 0,1:23:12.87,1:23:16.14,Default,,0,0,0,,…Толқын күшейткішінің деректер сілтемесі жақсы жұмыс істейді!
Dialogue: 0,1:23:16.81,1:23:18.27,Default,,0,0,0,,…Бастау аймағы тазартылды!
Dialogue: 0,1:23:19.87,1:23:20.94,Default,,0,0,0,,Альто-кун
Dialogue: 0,1:23:21.77,1:23:23.51,Default,,0,0,0,,Кеттік, Ланка
Dialogue: 0,1:23:24.37,1:23:25.67,Default,,0,0,0,,Хмм... мм
Dialogue: 0,1:23:32.74,1:23:38.47,Default,,0,0,0,,Өйткені сен өте мейірімдісің
Dialogue: 0,1:23:38.74,1:23:45.24,Default,,0,0,0,,Ауырсынуды өзіңізбен ауыстырыңыз
Dialogue: 0,1:23:45.57,1:23:51.17,Default,,0,0,0,,Мен қолдауды ойнаған сайын ол шынайы болады.
Dialogue: 0,1:23:51.44,1:23:54.44,Default,,0,0,0,,Әлсіздіктен қиналсам да
Dialogue: 0,1:23:54.87,1:24:00.04,Default,,0,0,0,,Ештеңе айтпайтыныңызға сенімдімін.
Dialogue: 0,1:24:00.34,1:24:06.97,Default,,0,0,0,,Қарапайым күнде де көрінетін профиль
Dialogue: 0,1:24:07.17,1:24:12.97,Default,,0,0,0,,Бұл ерекше болды.
Dialogue: 0,1:24:13.07,1:24:19.47,Default,,0,0,0,,Сабақтан кейін қоштассақ, ертең не болады?
Dialogue: 0,1:24:20.11,1:24:23.17,Default,,0,0,0,,Біз енді ешқашан кездеспеуіміз мүмкін...
Dialogue: 0,1:24:23.27,1:24:25.04,Default,,0,0,0,,Ранканың әні жұмыс істемейді?
Dialogue: 0,1:24:25.64,1:24:26.44,Default,,0,0,0,,(Польнарефф) Ә? Бұл не? Бұл жабысқақ не?
Dialogue: 0,1:24:26.57,1:24:31.44,Default,,0,0,0,,Жаңбыр жауды қабағымды
Dialogue: 0,1:24:32.97,1:24:34.64,Default,,0,0,0,,Альто! Ол тым қатты секіреді!
Dialogue: 0,1:24:35.77,1:24:40.51,Default,,0,0,0,,Толығырақ... Жақын барып, әнімді жеткізуім керек...
Dialogue: 0,1:24:40.57,1:24:42.97,Default,,0,0,0,,Фотосуретке айналды
Dialogue: 0,1:24:44.37,1:24:48.04,Default,,0,0,0,,Ах... 1-аралдан келген бақылау толқыны тым күшті болды.
Dialogue: 0,1:24:48.31,1:24:50.44,Default,,0,0,0,,Ранканың ән айтуына кедергі келтірілуде
Dialogue: 0,1:24:51.11,1:24:53.61,Default,,0,0,0,,Біз күткендей 1-аралға кірдік.
Dialogue: 0,1:24:54.01,1:24:56.81,Default,,0,0,0,,Бізде қатпарлы тарату станциясын басқарудан басқа амал жоқ...
Dialogue: 0,1:24:57.27,1:24:58.84,Default,,0,0,0,,Моника, сіздің жеңу мүмкіндігіңіз қандай?
Dialogue: 0,1:24:59.14,1:25:02.51,Default,,0,0,0,,Важра тобының ортасында тесік жасау үшін жоғары макросс зеңбірегін пайдаланыңыз.
Dialogue: 0,1:25:02.81,1:25:05.74,Default,,0,0,0,,Егер сіз ол жерден максималды жылдамдықпен өтіп кетсеңіз немесе...
Dialogue: 0,1:25:06.31,1:25:10.51,Default,,0,0,0,,Бірақ мұндай жылдамдықта кеме атмосфераға енген кезде жанып кетер еді...
Dialogue: 0,1:25:12.34,1:25:13.94,Default,,0,0,0,,Қарғыс атсын, бұл жаман!
Dialogue: 0,1:25:21.81,1:25:24.51,Default,,0,0,0,,Уф... Бұл Ваджраның азабы...
Dialogue: 0,1:25:24.91,1:25:28.57,Default,,0,0,0,,Құшақтау
Dialogue: 0,1:25:29.51,1:25:32.84,Default,,0,0,0,,Қалыптастыру «Үлкен сәрсенбі» Қане кеттік!
Dialogue: 0,1:25:33.07,1:25:34.24,Default,,0,0,0,,Иә!
Dialogue: 0,1:25:34.34,1:25:35.44,Default,,0,0,0,,Жарайды
Dialogue: 0,1:25:35.84,1:25:37.47,Default,,0,0,0,,Үлкен сәрсенбі деген не? …
Dialogue: 0,1:25:38.91,1:25:39.81,Default,,0,0,0,,Кяаа!
Dialogue: 0,1:25:45.11,1:25:45.97,Default,,0,0,0,,Хамф!
Dialogue: 0,1:25:49.97,1:25:51.51,Default,,0,0,0,,Мені ұр!
Dialogue: 0,1:25:58.91,1:26:03.34,Default,,0,0,0,,Көк түс өтіп жатыр
Dialogue: 0,1:26:03.67,1:26:09.54,Default,,0,0,0,,Заманның дауылы бетімнен ұрады
Dialogue: 0,1:26:09.77,1:26:10.64,Default,,0,0,0,,Тоқсан?
Dialogue: 0,1:26:10.74,1:26:22.01,Default,,0,0,0,,Мен сені мәңгі сүйемін Мен сені сүйемін
Dialogue: 0,1:26:24.24,1:26:25.14,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,1:26:36.01,1:26:37.84,Default,,0,0,0,,Уф... уф...
Dialogue: 0,1:26:49.61,1:26:51.91,Default,,0,0,0,,Бейбақтар, толқынға мінейік!
Dialogue: 0,1:26:51.97,1:26:52.74,Default,,0,0,0,,Ах
Dialogue: 0,1:26:54.14,1:27:00.84,Default,,0,0,0,,Сабақтан кейін қоштассақ, ертең не болады?
Dialogue: 0,1:27:01.17,1:27:07.07,Default,,0,0,0,,Біз енді ешқашан кездеспеуіміз мүмкін
Dialogue: 0,1:27:07.47,1:27:12.67,Default,,0,0,0,,Мен оянғанға дейін
Dialogue: 0,1:27:14.51,1:27:15.37,Default,,0,0,0,,Қу!
Dialogue: 0,1:27:15.74,1:27:19.44,Default,,0,0,0,,Неге... Мен сенімен ұрысқым келмейді...
Dialogue: 0,1:27:23.37,1:27:24.77,Default,,0,0,0,,Неге...
Dialogue: 0,1:27:27.24,1:27:28.11,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,1:27:28.77,1:27:29.91,Default,,0,0,0,,Қайғы?
Dialogue: 0,1:27:34.01,1:27:36.04,Default,,0,0,0,,О... бұл Ваджра ма?
Dialogue: 0,1:27:38.37,1:27:39.37,Default,,0,0,0,,Немесе солай!
Dialogue: 0,1:27:53.64,1:27:54.74,Default,,0,0,0,,Ах!
Dialogue: 0,1:27:55.21,1:27:56.51,Default,,0,0,0,,Әнді түсіндің бе?
Dialogue: 0,1:27:57.01,1:27:58.17,Default,,0,0,0,,Керемет, Ранка!
Dialogue: 0,1:27:58.44,1:28:01.07,Default,,0,0,0,,Важра имплант оқымен атылды...
Dialogue: 0,1:28:01.14,1:28:01.84,Default,,0,0,0,,Уф!
Dialogue: 0,1:28:02.24,1:28:05.74,Default,,0,0,0,,А... өтірік! Альто-кун?
Dialogue: 0,1:28:25.81,1:28:28.17,Default,,0,0,0,,Уау... өте әдемі...
Dialogue: 0,1:28:39.87,1:28:41.64,Default,,0,0,0,,Ол шынымен де адамның баласы.
Dialogue: 0,1:28:41.91,1:28:42.87,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:43.31,1:28:44.24,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:45.14,1:28:47.84,Default,,0,0,0,,А... сенің кабукиң керемет болды...
Dialogue: 0,1:28:48.21,1:28:51.71,Default,,0,0,0,,Бұл шынымен... шынымен де аспанда ұшатын аспан қызы сияқты...
Dialogue: 0,1:28:53.04,1:28:54.71,Default,,0,0,0,,Хмм... аспан? …
Dialogue: 0,1:28:58.24,1:28:59.04,Default,,0,0,0,,Хмм...
Dialogue: 0,1:28:59.61,1:29:04.11,Default,,0,0,0,,Рахмет, жас ханым, бірақ Альто әлі жаттығуда.
Dialogue: 0,1:29:12.31,1:29:14.27,Default,,0,0,0,,Мен де бір күні ән салатыныма сенімдімін!
Dialogue: 0,1:29:14.74,1:29:19.27,Default,,0,0,0,,Өзің қандай жақсы болсаң... Әніммен дүбірлетемін!
Dialogue: 0,1:29:26.11,1:29:28.04,Default,,0,0,0,,Мықты бол, Шерил!
Dialogue: 0,1:29:29.07,1:29:30.07,Default,,0,0,0,,Шерил!
Dialogue: 0,1:29:30.24,1:29:31.24,Default,,0,0,0,,Альто…
Dialogue: 0,1:29:32.21,1:29:35.57,Default,,0,0,0,,Мықты бол, Шерил! Эй! Шерил!
Dialogue: 0,1:29:37.44,1:29:38.97,Default,,0,0,0,,Оз... Ма...?
Dialogue: 0,1:29:39.97,1:29:41.74,Default,,0,0,0,,Жақсы, жақсысың ба?
Dialogue: 0,1:29:42.51,1:29:44.31,Default,,0,0,0,,Неге мен...?
Dialogue: 0,1:29:45.21,1:29:47.11,Default,,0,0,0,,Мына жігіт мені құтқарды.
Dialogue: 0,1:29:52.24,1:29:56.64,Default,,0,0,0,,Қараңдар!
Dialogue: 0,1:30:01.41,1:30:02.67,Default,,0,0,0,,Бұл бала...
Dialogue: 0,1:30:04.61,1:30:05.81,Default,,0,0,0,,Бейшара жігіт...
Dialogue: 0,1:30:06.37,1:30:09.24,Default,,0,0,0,,Ол қатпарлы кептеліс толқынынан зақымдалған сияқты...
Dialogue: 0,1:30:09.54,1:30:12.84,Default,,0,0,0,,Мүмкін оның Ваджраға қатысы бар шығар...
Dialogue: 0,1:30:15.24,1:30:17.21,Default,,0,0,0,,Аруто мен Ранка-чан ше?
Dialogue: 0,1:30:18.97,1:30:20.04,Default,,0,0,0,,Грейс...?
Dialogue: 0,1:30:21.47,1:30:22.31,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:30:22.74,1:30:23.97,Default,,0,0,0,,Аһ!
Dialogue: 0,1:30:27.77,1:30:28.74,Default,,0,0,0,,Рақым!
Dialogue: 0,1:30:30.61,1:30:31.74,Default,,0,0,0,,А...
Dialogue: 0,1:30:32.04,1:30:34.77,Default,,0,0,0,,Кел, ән сал, Шерил...
Dialogue: 0,1:30:35.14,1:30:39.17,Default,,0,0,0,,Мен шіркеу сахнасында бүктеме күшейткішті іске қостым.
Dialogue: 0,1:30:39.47,1:30:40.87,Default,,0,0,0,,Уф... неге?
Dialogue: 0,1:30:41.87,1:30:43.21,Default,,0,0,0,,Бұл ирониялық.
Dialogue: 0,1:30:44.37,1:30:48.91,Default,,0,0,0,,Осылай қарап, ақыры импланттан босатылдым...
Dialogue: 0,1:30:49.74,1:30:50.61,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:51.37,1:30:52.31,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:53.27,1:30:54.14,Default,,0,0,0,,Грейс…
Dialogue: 0,1:30:54.81,1:30:58.97,Default,,0,0,0,,Ал... сен... мен сені өсірдім.
Dialogue: 0,1:31:01.64,1:31:04.37,Default,,0,0,0,,Енді қайта тыңдайын.
Dialogue: 0,1:31:05.24,1:31:06.61,Default,,0,0,0,,Сіздің әніңіз...
Dialogue: 0,1:31:14.31,1:31:18.37,Default,,0,0,0,,Жүр, Грейс, мен саған ән айтамын.
Dialogue: 0,1:31:19.57,1:31:23.67,Default,,0,0,0,,Жарайды, Шерил, келесі жолы ән айтсаң, денең...
Dialogue: 0,1:31:28.47,1:31:32.14,Default,,0,0,0,,Өлсем де...өлең өлмейді!
Dialogue: 0,1:31:33.47,1:31:34.27,Default,,0,0,0,,Уф...
Dialogue: 0,1:31:40.37,1:31:48.71,Default,,0,0,0,,Біреу бос орынды белгілейді
Dialogue: 0,1:31:50.51,1:31:58.37,Default,,0,0,0,,Сіз мені ақырын сипап жібере аласыз ба?
Dialogue: 0,1:31:59.01,1:32:02.71,Default,,0,0,0,,Жүрек соғуынан басталды
Dialogue: 0,1:32:03.07,1:32:05.54,Default,,0,0,0,,Сүйіспеншілікті білдіретін сөздер
Dialogue: 0,1:32:05.64,1:32:07.54,Default,,0,0,0,,Галактикалық…ертегі…
Dialogue: 0,1:32:08.37,1:32:15.64,Default,,0,0,0,,Бірақ мен қиналдым, жауап жоқ.
Dialogue: 0,1:32:16.91,1:32:30.74,Default,,0,0,0,,Тағдырға байланған Солтүстік жұлдыз жанып тұр
Dialogue: 0,1:32:30.87,1:32:31.84,Default,,0,0,0,,Шерил?
Dialogue: 0,1:32:32.44,1:32:35.01,Default,,0,0,0,,А... неге ән?
Dialogue: 0,1:32:40.04,1:32:40.84,Default,,0,0,0,,Ах!
Dialogue: 0,1:32:42.17,1:32:43.11,Default,,0,0,0,,Уф...
Dialogue: 0,1:32:43.91,1:32:45.07,Default,,0,0,0,,Бұл ән...
Dialogue: 0,1:32:45.64,1:32:46.74,Default,,0,0,0,,Шерил мырза?
Dialogue: 0,1:32:49.24,1:32:50.77,Default,,0,0,0,,Шерилоу!
Dialogue: 0,1:32:53.17,1:32:55.04,Default,,0,0,0,,Ах... Альто!
Dialogue: 0,1:32:56.04,1:33:04.04,Default,,0,0,0,,Бірақ маған сенің сүйкімді күлгенің ұнады.
Dialogue: 0,1:33:04.34,1:33:08.04,Default,,0,0,0,,А... Шерил... Капитан?
Dialogue: 0,1:33:10.54,1:33:12.01,Default,,0,0,0,,4-ші бас сүйектен ширекке дейін
Dialogue: 0,1:33:12.41,1:33:16.17,Default,,0,0,0,,Шерил Ном мен капитан Озманың тірі екенін растады.
Dialogue: 0,1:33:16.84,1:33:18.37,Default,,0,0,0,,Мен қазір құтқаруға бара жатырмын!
Dialogue: 0,1:33:18.77,1:33:19.91,Default,,0,0,0,,Аха…
Dialogue: 0,1:33:20.17,1:33:21.27,Default,,0,0,0,,Озма!
Dialogue: 0,1:33:21.64,1:33:23.54,Default,,0,0,0,,А... аға!
Dialogue: 0,1:33:24.01,1:33:25.27,Default,,0,0,0,,Ланканы ашыңыз!
Dialogue: 0,1:33:25.77,1:33:30.41,Default,,0,0,0,,Еріндердегі симфония
Dialogue: 0,1:33:30.77,1:33:31.67,Default,,0,0,0,,Жүр!
Dialogue: 0,1:33:33.47,1:33:35.84,Default,,0,0,0,,Альто төбедегі сахнаға ұшыңыз!
Dialogue: 0,1:33:36.41,1:33:39.11,Default,,0,0,0,,Мен сол жерде ән айтатын дауысымды күшейте аламын!
Dialogue: 0,1:33:39.47,1:33:41.14,Default,,0,0,0,,Бірақ мұндай денемен...
Dialogue: 0,1:33:41.77,1:33:45.84,Default,,0,0,0,,Сіз түсінесіз! Мен өлсем, ол сахнада болады!
Dialogue: 0,1:33:46.21,1:33:47.04,Default,,0,0,0,,А...
Dialogue: 0,1:33:47.41,1:33:51.17,Default,,0,0,0,,Оның үстіне мен әніммен галактиканы тербеткім келеді!
Dialogue: 0,1:33:51.57,1:33:52.44,Default,,0,0,0,,Ах...
Dialogue: 0,1:33:52.87,1:33:55.84,Default,,0,0,0,,Мен әніммен галактиканы тербетемін!
Dialogue: 0,1:33:58.31,1:34:00.37,Default,,0,0,0,,Сіз... Ол кезде...
Dialogue: 0,1:34:01.01,1:34:03.47,Default,,0,0,0,,Мен мұны қазір түсінгеніме сене алар емеспін!
Dialogue: 0,1:34:05.91,1:34:09.41,Default,,0,0,0,,Енді, Альто, сенің сахнаң нағыз аспан болса ше?
Dialogue: 0,1:34:09.64,1:34:11.01,Default,,0,0,0,,Тағы да билеп, көрсет
Dialogue: 0,1:34:11.61,1:34:14.27,Default,,0,0,0,,Альто Саотоменің нағыз биі!
Dialogue: 0,1:34:18.54,1:34:24.61,Default,,0,0,0,,Жұлдыздарды әлемнің ортасында айналдыр
Dialogue: 0,1:34:25.14,1:34:30.84,Default,,0,0,0,,Түшкірсең, орманда бір жерде көбелектер билейді.
Dialogue: 0,1:34:31.14,1:34:37.34,Default,,0,0,0,,Сіз қорғайтын есіктің кілті - ақымақтық
Dialogue: 0,1:34:37.87,1:34:40.11,Default,,0,0,0,,Ұят оқиға
Dialogue: 0,1:34:40.44,1:34:47.11,Default,,0,0,0,,Арыстандар бірін-бірі жалап кетсе де күшті
Dialogue: 0,1:34:47.44,1:34:50.51,Default,,0,0,0,,Мен аман қалғым келеді Мен аман қалғым келеді
Dialogue: 0,1:34:50.67,1:34:53.64,Default,,0,0,0,,Мен әлі де тірі қалғым келеді
Dialogue: 0,1:34:53.71,1:34:59.51,Default,,0,0,0,,Шоқжұлдыздардың нұсқауымен біз бір-бірімізге қарап қалдық
Dialogue: 0,1:34:59.67,1:35:00.54,Default,,0,0,0,,Уаа!
Dialogue: 0,1:35:01.34,1:35:02.27,Default,,0,0,0,,Уау!
Dialogue: 0,1:35:02.91,1:35:04.17,Default,,0,0,0,,Ух... мм... аа!
Dialogue: 0,1:35:04.34,1:35:05.07,Default,,0,0,0,,Ах!
Dialogue: 0,1:35:05.37,1:35:07.34,Default,,0,0,0,,Уау, тамаша толқындар!
Dialogue: 0,1:35:07.57,1:35:08.57,Default,,0,0,0,,Иә, капитан!
Dialogue: 0,1:35:08.91,1:35:11.84,Default,,0,0,0,,Бәрің, тісіңді қайраңдар!
Dialogue: 0,1:35:21.14,1:35:22.87,Default,,0,0,0,,♬~
Dialogue: 0,1:35:28.14,1:35:30.64,Default,,0,0,0,,Ах... жау флотына жақындап келе жатыр.
Dialogue: 0,1:35:30.84,1:35:31.67,Default,,0,0,0,,Қоршалған
Dialogue: 0,1:35:31.74,1:35:32.34,Default,,0,0,0,,Әй!
Dialogue: 0,1:35:41.47,1:35:42.57,Default,,0,0,0,,Не?
Dialogue: 0,1:35:43.07,1:35:45.07,Default,,0,0,0,,S.M.S күшейткіштерінен шақыру!
Dialogue: 0,1:35:45.67,1:35:47.27,Default,,0,0,0,,Енді мен сенің кемеңді қолдаймын...
Dialogue: 0,1:35:48.54,1:35:51.64,Default,,0,0,0,,Спутниктік орбитада расталған көптеген қатпарлану реакциялары!
Dialogue: 0,1:35:52.24,1:35:54.94,Default,,0,0,0,,Бұл S.M.S және Жаңа Біріккен Күштердің біріккен флоты!
Dialogue: 0,1:35:55.14,1:35:56.14,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:35:56.34,1:35:57.67,Default,,0,0,0,,Сіз оны уақытында орындадыңыз!
Dialogue: 0,1:35:58.17,1:36:00.01,Default,,0,0,0,,Кеттік, сүйкімді.
Dialogue: 0,1:36:00.24,1:36:01.87,Default,,0,0,0,,Хияхо!
Dialogue: 0,1:36:04.44,1:36:05.91,Default,,0,0,0,,4-бас сүйектен әр отрядқа
Dialogue: 0,1:36:06.27,1:36:09.04,Default,,0,0,0,,Важра имплант оқтары арқылы басқарылады.
Dialogue: 0,1:36:09.71,1:36:12.97,Default,,0,0,0,,Егер сіз буынға атылған импланттың оқтарын жойсаңыз!
Dialogue: 0,1:36:13.31,1:36:14.51,Default,,0,0,0,,Имплант оқтары?
Dialogue: 0,1:36:15.01,1:36:17.74,Default,,0,0,0,,О, егер сіз мұны білсеңіз!
Dialogue: 0,1:36:19.84,1:36:22.71,Default,,0,0,0,,Мен аман қалғым келеді, шетте болса да болады
Dialogue: 0,1:36:22.87,1:36:25.71,Default,,0,0,0,,Мен сені жақсы көремін.
Dialogue: 0,1:36:25.91,1:36:31.47,Default,,0,0,0,,Шоқжұлдыздардың жетекшілігімен...
Dialogue: 0,1:36:33.67,1:36:34.41,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:36:34.71,1:36:36.94,Default,,0,0,0,,Ozma Сіздің ұшақыңыз!
Dialogue: 0,1:36:38.01,1:36:39.21,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:36:40.07,1:36:43.44,Default,,0,0,0,,Код Q-1 және Fairy 9 қатпарлы резонанстық толқындарын растаңыз
Dialogue: 0,1:36:43.97,1:36:47.31,Default,,0,0,0,,Сіз Важраның имплантты басқаруын да байқаған сияқтысыз.
Dialogue: 0,1:36:47.67,1:36:49.37,Default,,0,0,0,,Қазір тым кеш.
Dialogue: 0,1:36:49.71,1:36:51.77,Default,,0,0,0,,Қанша күшейту келсе де
Dialogue: 0,1:36:51.94,1:36:54.84,Default,,0,0,0,,Патшайым Важраны қолға түсірсек, біз жеңеміз.
Dialogue: 0,1:36:55.37,1:36:58.51,Default,,0,0,0,,Ал Шерил ұзаққа бармайды.
Dialogue: 0,1:36:59.37,1:37:02.24,Default,,0,0,0,,Важра мен жауынгерлік шекараны біріктіруге асығыңыз
Dialogue: 0,1:37:02.81,1:37:07.74,Default,,0,0,0,,Сымды кабель арқылы қоссаңыз, сырттан ешқандай кедергі болмайды.
Dialogue: 0,1:37:15.81,1:37:21.47,Default,,0,0,0,,Важрамен біріктіру аяқталғаннан кейін зиянкестерді сүртіңіз.
Dialogue: 0,1:37:22.57,1:37:25.81,Default,,0,0,0,,Бүкіл аралдың батып кеткені маңызды емес.
Dialogue: 0,1:37:27.14,1:37:33.04,Default,,0,0,0,,Тым көп Теншин, Ранман 1000% Теннен, Дайтан 1000%
Dialogue: 0,1:37:33.87,1:37:36.61,Default,,0,0,0,,Ішінде қорғалмаған
Dialogue: 0,1:37:38.11,1:37:39.27,Default,,0,0,0,,Шерил!
Dialogue: 0,1:37:41.81,1:37:42.81,Default,,0,0,0,,Ранка-чан!
Dialogue: 0,1:37:45.34,1:37:46.14,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:48.11,1:37:50.94,Default,,0,0,0,,Уайымдама, нағыз оқиға болғалы тұр!
Dialogue: 0,1:37:51.31,1:37:52.44,Default,,0,0,0,,Шерил мырза...
Dialogue: 0,1:37:53.44,1:37:56.94,Default,,0,0,0,,Сол көз жасына ант ет
Dialogue: 0,1:37:57.24,1:38:00.11,Default,,0,0,0,,Ғажайыптарға баурап алған
Dialogue: 0,1:38:00.24,1:38:05.81,Default,,0,0,0,,Үйінділердің үстінен секіру және қисық сызықпен көтерілу
Dialogue: 0,1:38:05.87,1:38:12.34,Default,,0,0,0,,Маған өмірімді қайтарғанша, жүрегіңнен соғу ізде.
Dialogue: 0,1:38:12.44,1:38:15.37,Default,,0,0,0,,Біз оны уақытында орындаймыз ба?
Dialogue: 0,1:38:15.47,1:38:16.51,Default,,0,0,0,,Уау!
Dialogue: 0,1:38:16.77,1:38:17.54,Default,,0,0,0,,Клан!
Dialogue: 0,1:38:18.17,1:38:20.21,Default,,0,0,0,,Тәтті~
Dialogue: 0,1:38:20.67,1:38:22.87,Default,,0,0,0,,Мен сенің жалғыз өлуіңе жол бермеймін!
Dialogue: 0,1:38:29.44,1:38:30.37,Default,,0,0,0,,Уф!
Dialogue: 0,1:38:30.51,1:38:31.44,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:38:31.54,1:38:32.97,Default,,0,0,0,,Уф! ...Бұл не?
Dialogue: 0,1:38:34.01,1:38:37.04,Default,,0,0,0,,Жауынгерлік шекара мен Важра патшайымы біріктірілді!
Dialogue: 0,1:38:37.91,1:38:42.14,Default,,0,0,0,,Нашар! Олар Ваджраны тікелей бақылауға алып, әннің дыбысын өшіргісі келеді!
Dialogue: 0,1:38:42.54,1:38:44.04,Default,,0,0,0,,Бұл...
Dialogue: 0,1:38:45.11,1:38:46.04,Default,,0,0,0,,Мен барамын
Dialogue: 0,1:38:46.71,1:38:49.67,Default,,0,0,0,,Осы «сезімдерді жеткізетін таспен» қатар
Dialogue: 0,1:38:50.01,1:38:51.81,Default,,0,0,0,,Әнімізді көтеріп ұш!
Dialogue: 0,1:38:52.41,1:38:53.34,Default,,0,0,0,,Альто!
Dialogue: 0,1:38:53.54,1:38:54.44,Default,,0,0,0,,Альто-кун!
Dialogue: 0,1:38:55.24,1:38:58.44,Default,,0,0,0,,Бұл менің қанатымның биі!
Dialogue: 0,1:39:03.17,1:39:04.81,Default,,0,0,0,,Қанаттарыңа жел соғады!
Dialogue: 0,1:39:05.84,1:39:07.64,Default,,0,0,0,,Галактикаға ән айт!
Dialogue: 0,1:39:26.34,1:39:29.34,Default,,0,0,0,,Қарғыс атсын... Брелла! сен неге...
Dialogue: 0,1:39:29.44,1:39:33.44,Default,,0,0,0,,Біз, Галактика, Ваджра мен Шекараны бағындырдық.
Dialogue: 0,1:39:33.67,1:39:34.67,Default,,0,0,0,,Не?
Dialogue: 0,1:39:35.07,1:39:40.94,Default,,0,0,0,,Көкжиекті тербеткен жел
Dialogue: 0,1:39:41.01,1:39:44.51,Default,,0,0,0,,Адамның еті мен қаны бізге қарсы соғыссын!
Dialogue: 0,1:39:44.91,1:39:52.67,Default,,0,0,0,,Жалын әлі жанып тұр ма?
Dialogue: 0,1:39:54.24,1:40:02.14,Default,,0,0,0,,Дүниенің кіре берісінде қалтырап тұрып
Dialogue: 0,1:40:02.21,1:40:10.44,Default,,0,0,0,,Сезімімді саған жеткізбейінше өле алмаймын
Dialogue: 0,1:40:10.67,1:40:14.07,Default,,0,0,0,,Бұл қанаттар - Валькирия
Dialogue: 0,1:40:14.14,1:40:19.01,Default,,0,0,0,,Жаралы жауынгер Валкирияның алдында
Dialogue: 0,1:40:19.07,1:40:23.97,Default,,0,0,0,,Жығылып жатқан елес ғашық
Dialogue: 0,1:40:24.04,1:40:32.31,Default,,0,0,0,,Сол жанға жол көрсету үшін кемпірқосақ көпірден өт
Dialogue: 0,1:40:32.37,1:40:33.97,Default,,0,0,0,,Валькирия
Dialogue: 0,1:40:35.31,1:40:36.71,Default,,0,0,0,,Спектакль аяқталды
Dialogue: 0,1:40:39.04,1:40:39.81,Default,,0,0,0,,Гах!
Dialogue: 0,1:40:42.07,1:40:45.07,Default,,0,0,0,,Ахх... мынау... бұл қайғы...
Dialogue: 0,1:40:45.54,1:40:46.74,Default,,0,0,0,,Важра сияқты...
Dialogue: 0,1:40:47.67,1:40:48.97,Default,,0,0,0,,Имплант?
Dialogue: 0,1:40:49.64,1:40:50.74,Default,,0,0,0,,Оян, Брелла!
Dialogue: 0,1:40:51.04,1:40:53.24,Default,,0,0,0,,Шынайы жүрегіңізді қалпына келтіріңіз!
Dialogue: 0,1:40:53.41,1:40:57.01,Default,,0,0,0,,Уф! Бұл бос сөз. Сіздің шынайы жүрегіңіз қандай?
Dialogue: 0,1:40:58.57,1:41:01.34,Default,,0,0,0,,Аспанда ұшу
Dialogue: 0,1:41:01.81,1:41:07.47,Default,,0,0,0,,Валькирия Қош бол Цубаса
Dialogue: 0,1:41:11.84,1:41:12.84,Default,,0,0,0,,Раковина!
Dialogue: 0,1:41:17.41,1:41:18.24,Default,,0,0,0,,Уф!
Dialogue: 0,1:41:18.37,1:41:19.21,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:19.71,1:41:20.64,Default,,0,0,0,,Ах!
Dialogue: 0,1:41:38.87,1:41:39.74,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:47.71,1:41:48.64,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:54.94,1:41:56.07,Default,,0,0,0,,Ән...
Dialogue: 0,1:41:57.71,1:41:59.71,Default,,0,0,0,,Ах... Ваджра...
Dialogue: 0,1:42:00.24,1:42:01.11,Default,,0,0,0,,Ән айту...
Dialogue: 0,1:42:01.24,1:42:02.14,Default,,0,0,0,,Pi
Dialogue: 0,1:42:02.71,1:42:03.61,Default,,0,0,0,,Ай-кун...
Dialogue: 0,1:42:04.31,1:42:05.54,Default,,0,0,0,,Сіз мені қорғадыңыз!
Dialogue: 0,1:42:06.61,1:42:07.51,Default,,0,0,0,,Pi!
Dialogue: 0,1:42:08.07,1:42:10.67,Default,,0,0,0,,Важра... Эй!
Dialogue: 0,1:42:14.71,1:42:16.31,Default,,0,0,0,,Чи! Мені сүйсін
Dialogue: 0,1:42:16.57,1:42:24.77,Default,,0,0,0,,Көздер қазір нені көздеп тұр?
Dialogue: 0,1:42:26.04,1:42:28.41,Default,,0,0,0,,Бұл... Ваджраның азабы...
Dialogue: 0,1:42:30.51,1:42:33.01,Default,,0,0,0,,Түсіндім! Егер сіз өзіңізді Важра сияқты сезінсеңіз!
Dialogue: 0,1:42:35.67,1:42:43.37,Default,,0,0,0,,Кездесетінімізге сеніп ән айта бердім
Dialogue: 0,1:42:43.51,1:42:52.01,Default,,0,0,0,,Барлығы төленгенше, құрбандыққа шалынғанша
Dialogue: 0,1:42:52.31,1:42:56.24,Default,,0,0,0,,Ол қанаттар – Валькирия
Dialogue: 0,1:42:56.31,1:42:59.37,Default,,0,0,0,,Сол қозғалыс... сіздің іс-әрекеттеріңізді болжайды ма?
Dialogue: 0,1:43:00.61,1:43:05.21,Default,,0,0,0,,Жығылып жатқан елес ғашық
Dialogue: 0,1:43:05.44,1:43:08.87,Default,,0,0,0,,Көк аспанда
Dialogue: 0,1:43:09.21,1:43:13.74,Default,,0,0,0,,Еріп кетпес үшін
Dialogue: 0,1:43:13.81,1:43:15.31,Default,,0,0,0,,Валькирия
Dialogue: 0,1:43:15.37,1:43:20.44,Default,,0,0,0,,Валькирия екі қолымен көтерді
Dialogue: 0,1:43:21.27,1:43:22.37,Default,,0,0,0,,...ақымақ...
Dialogue: 0,1:43:22.77,1:43:24.71,Default,,0,0,0,,Бұл ақпарат хаосы...
Dialogue: 0,1:43:27.81,1:43:29.67,Default,,0,0,0,,Галактика дірілдеп тұр...
Dialogue: 0,1:43:34.77,1:43:36.11,Default,,0,0,0,,Жарық биі...
Dialogue: 0,1:43:37.01,1:43:39.17,Default,,0,0,0,,Ол... еңкейіп отыр!
Dialogue: 0,1:43:39.37,1:43:41.57,Default,,0,0,0,,Не... бұл сезім...
Dialogue: 0,1:43:45.17,1:43:47.31,Default,,0,0,0,,Сенің маған деген сезімің бар ма? …
Dialogue: 0,1:43:50.94,1:43:52.14,Default,,0,0,0,,Әдемі...
Dialogue: 0,1:43:52.21,1:43:53.64,Default,,0,0,0,,Біріккен флоттан қоңырау шалыңыз!
Dialogue: 0,1:43:54.97,1:44:00.71,Default,,0,0,0,,Жаудың абдырап қалғанын пайдаланып, мен Макросс зеңбіректерімен барлық кемелерге бірден шабуыл жасауды ұйғардым...
Dialogue: 0,1:44:00.77,1:44:01.51,Default,,0,0,0,,Не!
Dialogue: 0,1:44:01.57,1:44:02.31,Default,,0,0,0,,Өтірік!
Dialogue: 0,1:44:02.57,1:44:04.54,Default,,0,0,0,,Сіз бір қадам ғана қалдым дейсіз!
Dialogue: 0,1:44:07.37,1:44:10.74,Default,,0,0,0,,Бас сүйек 4 Қаш! Жүгіріп кету!
Dialogue: 0,1:44:12.91,1:44:17.61,Default,,0,0,0,,Заманның дауылы бетімнен ұрады
Dialogue: 0,1:44:17.74,1:44:22.04,Default,,0,0,0,,Мен сені мәңгілікке сүйемін
Dialogue: 0,1:44:22.11,1:44:26.61,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,1:44:27.51,1:44:29.54,Default,,0,0,0,,Бұл ән... Ранка?
Dialogue: 0,1:44:32.47,1:44:33.71,Default,,0,0,0,,Уф!
Dialogue: 0,1:44:34.41,1:44:36.27,Default,,0,0,0,,Ууууууууу~
Dialogue: 0,1:44:38.11,1:44:39.27,Default,,0,0,0,,Рейтингші!
Dialogue: 0,1:44:39.51,1:44:41.24,Default,,0,0,0,,А... ағайын?
Dialogue: 0,1:44:41.51,1:44:43.47,Default,,0,0,0,,Ооооооо!
Dialogue: 0,1:44:43.64,1:44:46.54,Default,,0,0,0,,Имплантты өзіңіз жасатуды жоспарлап отырсыз ба?
Dialogue: 0,1:44:46.77,1:44:49.61,Default,,0,0,0,,Мен енді сіздің қуыршақ емеспін!
Dialogue: 0,1:44:57.97,1:44:58.94,Default,,0,0,0,,Ранка…
Dialogue: 0,1:45:08.57,1:45:12.67,Default,,0,0,0,,Маған сеніңіз, Важра... біз жау емеспіз!
Dialogue: 0,1:45:16.87,1:45:18.54,Default,,0,0,0,,Валькирия
Dialogue: 0,1:45:22.37,1:45:23.11,Default,,0,0,0,,Ха...
Dialogue: 0,1:45:30.34,1:45:32.84,Default,,0,0,0,,Қош бол Цубаса
Dialogue: 0,1:45:35.41,1:45:37.84,Default,,0,0,0,,Ах... Ваджра...
Dialogue: 0,1:45:46.34,1:45:47.21,Default,,0,0,0,,Ланка
Dialogue: 0,1:45:49.94,1:45:53.54,Default,,0,0,0,,Сезіміңізге жауап бере алмағаным үшін кешіріңіз...
Dialogue: 0,1:45:54.74,1:45:57.67,Default,,0,0,0,,Бірақ... Рахмет...
Dialogue: 0,1:45:58.74,1:46:00.61,Default,,0,0,0,,Уф...
Dialogue: 0,1:46:02.34,1:46:03.27,Default,,0,0,0,,Хмм...
Dialogue: 0,1:46:04.74,1:46:05.61,Default,,0,0,0,,Шерил
Dialogue: 0,1:46:05.77,1:46:06.64,Default,,0,0,0,,Ах
Dialogue: 0,1:46:07.04,1:46:09.11,Default,,0,0,0,,Сәл кеш болуы мүмкін
Dialogue: 0,1:46:09.81,1:46:10.71,Default,,0,0,0,,Ах!
Dialogue: 0,1:46:10.91,1:46:12.34,Default,,0,0,0,,Мен сен туралы айтып отырмын...
Dialogue: 0,1:46:14.01,1:46:15.11,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,1:46:24.77,1:46:27.41,Default,,0,0,0,,Арто!
Dialogue: 0,1:46:27.94,1:46:29.17,Default,,0,0,0,,Шерил!
Dialogue: 0,1:46:30.97,1:46:32.91,Default,,0,0,0,,Сәлем Шерил!
Dialogue: 0,1:46:37.37,1:46:43.87,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,1:47:16.07,1:47:18.97,Default,,0,0,0,,Содан бері бір ай өтті.
Dialogue: 0,1:47:21.27,1:47:26.51,Default,,0,0,0,,Тірі қалғандар Ваджра қалдырған осы планетаның жеріне аяқ басты.
Dialogue: 0,1:47:27.34,1:47:30.04,Default,,0,0,0,,Жаңа өмір бастағалы...
Dialogue: 0,1:47:33.47,1:47:37.61,Default,,0,0,0,,Біз Ваджраға бұл сұрақты қойып отырған шығармыз.
Dialogue: 0,1:47:39.71,1:47:44.94,Default,,0,0,0,,Осы жасыл ғаламшарды мәңгі әдемі етіп сақтай алсақ...
Dialogue: 0,1:47:46.81,1:47:51.17,Default,,0,0,0,,Адамдар мен Важра бірге өмір сүретін күн міндетті түрде келеді...
Dialogue: 0,1:48:04.41,1:48:09.44,Default,,0,0,0,,Галактиканы дүр сілкіндірген ән дауысымен өмірін өртеп жіберген Шерил-сан...
Dialogue: 0,1:48:11.64,1:48:13.07,Default,,0,0,0,,Әлі ұйықтап жатыр...
Dialogue: 0,1:48:35.17,1:48:38.14,Default,,0,0,0,,...бірақ мен сенемін...
Dialogue: 0,1:48:39.91,1:48:43.47,Default,,0,0,0,,Мен Альтоның бір күні қайтып келетініне сенімдімін.
Dialogue: 0,1:48:44.84,1:48:48.34,Default,,0,0,0,,Шерил оянғанда...
Dialogue: 0,1:48:52.64,1:48:57.31,Default,,0,0,0,,Бұл міндетті түрде осында.
Dialogue: 0,1:48:57.64,1:49:03.41,Default,,0,0,0,,Бақылаусыз толып кету
Dialogue: 0,1:49:04.27,1:49:13.27,Default,,0,0,0,,Сені ойласам, Жүрегім ғаламға айналады
Dialogue: 0,1:49:13.97,1:49:18.01,Default,,0,0,0,,Жұлдыздарды құшақтау
Dialogue: 0,1:49:19.11,1:49:24.74,Default,,0,0,0,,Шектеулі уақыт, күндер
Dialogue: 0,1:49:24.81,1:49:30.04,Default,,0,0,0,,Мен оны сені жақсы көру үшін қолданамын
Dialogue: 0,1:49:30.71,1:49:41.51,Default,,0,0,0,,Мен сені сүйемін деп айта алудың күшін біле бастадым
Dialogue: 0,1:49:41.71,1:49:45.77,Default,,0,0,0,,Бұл ұзақ жол
Dialogue: 0,1:49:45.91,1:49:55.74,Default,,0,0,0,,Алыстағы жарықтың жетегінде
Dialogue: 0,1:49:57.61,1:50:03.07,Default,,0,0,0,,Қайта-қайта кездесейік.
Dialogue: 0,1:50:04.14,1:50:08.97,Default,,0,0,0,,Сүйуді мен таңдадым
Dialogue: 0,1:50:10.44,1:50:17.04,Default,,0,0,0,,Мен сенің бақытың үшін дұға ете беремін
Dialogue: 0,1:50:17.17,1:50:22.87,Default,,0,0,0,,Мөлдір көздерімен
Dialogue: 0,1:50:23.01,1:50:27.77,Default,,0,0,0,,Енді түнде артыңа қарама
Dialogue: 0,1:50:29.31,1:50:34.47,Default,,0,0,0,,Осылайша біз қайтадан кездесе аламыз
Dialogue: 0,1:50:35.57,1:50:42.17,Default,,0,0,0,,Ылғал қанаттарыңды кептірсең
Dialogue: 0,1:50:42.24,1:50:45.11,Default,,0,0,0,,Менің жанымда
Dialogue: 0,1:50:45.31,1:50:48.17,Default,,0,0,0,,Менің жүрегіме жақын
Dialogue: 0,1:50:48.51,1:50:51.34,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,1:50:51.67,1:50:56.34,Default,,0,0,0,,сені жақсы көремін
Dialogue: 0,1:51:00.51,1:51:04.87,Default,,0,0,0,,Шексіз кеңістікте
Dialogue: 0,1:51:05.47,1:51:11.67,Default,,0,0,0,,Саған деген махаббатымды жырласам
Dialogue: 0,1:51:12.17,1:51:22.21,Default,,0,0,0,,Мәңгіліктен тыс жұлдыздар жарқырайды
Dialogue: 0,1:51:33.94,1:51:40.67,Default,,0,0,0,,Шерил! Шерил! Шерил! Шерил! Шерил! Апыр-ай!
Dialogue: 0,1:51:42.77,1:51:44.57,Default,,0,0,0,,Тағы да сәлем!
Dialogue: 0,1:51:44.97,1:51:48.54,Default,,0,0,0,,Барлығы шақырса, ғажайыптар әрқашан болады.
Dialogue: 0,1:51:49.37,1:51:50.87,Default,,0,0,0,,Кеттік, Ранка-чан.
Dialogue: 0,1:51:51.07,1:51:52.27,Default,,0,0,0,,Иә, Шерил!
Dialogue: 0,1:51:53.37,1:51:54.71,Default,,0,0,0,,Сено…
Dialogue: 0,1:51:54.91,1:51:57.91,Default,,0,0,0,,Біздің әнді тыңдаңыздар!
Dialogue: 0,1:51:58.37,1:52:02.94,Default,,0,0,0,,Қызықты нәрсе: Бір нәрсе басталғанда
Dialogue: 0,1:52:03.64,1:52:08.34,Default,,0,0,0,,Көзді қысып бастаңыз! Мені алшақтық сияқты азғыр
Dialogue: 0,1:52:08.47,1:52:13.31,Default,,0,0,0,,Сіз үшін барлық уақыттағы ең жақсы әуен
Dialogue: 0,1:52:13.64,1:52:18.14,Default,,0,0,0,,Музыка және романтика! Ауа ағындарында қалықтау
Dialogue: 0,1:52:18.61,1:52:23.14,Default,,0,0,0,,Біз сол жұлдызға бара аламыз ба?
Dialogue: 0,1:52:24.44,1:52:27.71,Default,,0,0,0,,Ғарышқа ұшуды жылдамдату
Dialogue: 0,1:52:27.77,1:52:31.44,Default,,0,0,0,,Роликтердің айналуы бір-бірімен байланысты
Dialogue: 0,1:52:31.67,1:52:37.64,Default,,0,0,0,,Тәртіпсіздік жасаңыз! Екеуміз ұшып кетеміз
Dialogue: 0,1:52:40.14,1:52:45.44,Default,,0,0,0,,Халлелужамен әлемді өзгертейік!
Dialogue: 0,1:52:46.44,1:52:49.67,Default,,0,0,0,,Сиқыр көргіңіз келе ме!? Жап-жапырақпен сырласу
Dialogue: 0,1:52:49.77,1:52:53.47,Default,,0,0,0,,Бір сәттік ғажайып аққан жұлдыз☆
Dialogue: 0,1:52:53.81,1:52:56.97,Default,,0,0,0,,Айтқаныма, өз ұстанымыма күлемін
Dialogue: 0,1:52:57.17,1:53:00.34,Default,,0,0,0,,Мені тартымды өніммен шығарып салыңызшы, жігіт☆
Dialogue: 0,1:53:00.41,1:53:05.51,Default,,0,0,0,,Арқаңда кемпірқосақ түсті қауырсындары бар
Dialogue: 0,1:53:06.41,1:53:08.91,Default,,0,0,0,,Ұш! Шайқаңыз! Фристайл!
Dialogue: 0,1:53:08.97,1:53:11.31,Default,,0,0,0,,Мен түнде билегім келеді
Dialogue: 0,1:53:12.31,1:53:18.97,Default,,0,0,0,,Екеуміздің әлі алда әлі алда.
Dialogue: 0,1:53:19.27,1:53:27.54,Default,,0,0,0,,Ешқашан бітпейтін оқиға басталады!
Dialogue: 0,1:53:30.44,1:53:35.47,Default,,0,0,0,,Халлелужамен әлемді өзгертіңіз!
Dialogue: 0,1:53:36.91,1:53:39.97,Default,,0,0,0,,Сен де, мен де
Dialogue: 0,1:53:40.11,1:53:43.71,Default,,0,0,0,,Шешуші ғажайып жарық жұлдыз☆
Dialogue: 0,1:53:44.11,1:53:47.41,Default,,0,0,0,,Махаббат әрқашан солай
Dialogue: 0,1:53:47.47,1:53:50.74,Default,,0,0,0,,Маған тартымды тәсілмен жаттықтырыңыз☆
Dialogue: 0,1:53:50.81,1:53:52.51,Default,,0,0,0,,Өмірде көптеген мүмкіндіктер
Dialogue: 0,1:53:52.57,1:53:54.21,Default,,0,0,0,,Көбірек қиындықтар мен бейбітшілік
Dialogue: 0,1:53:54.27,1:54:02.01,Default,,0,0,0,,Тартымды күлкі ғана стильмен бақытты өмір☆
Dialogue: 0,1:54:03.51,1:54:09.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory