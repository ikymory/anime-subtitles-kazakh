Dialogue: 0,0:00:58.95,0:01:08.46,JPOP,,0000,0000,0000,,Жүрегімді өртеп жіберген үмітсіздіктің қасында
Dialogue: 0,0:01:09.33,0:01:19.97,JPOP,,0000,0000,0000,,Сіз маған әрқашан күлкі сыйладыңыз, ол бәрін жоғалтты.
Dialogue: 1,0:01:20.05,0:01:22.93,JPOP,,0000,0000,0000,,Күңгірт дауыс
Dialogue: 2,0:01:22.93,0:01:25.35,JPOP,,0000,0000,0000,,Қол жетпейтін сөздер
Dialogue: 0,0:01:25.35,0:01:30.90,JPOP,,0000,0000,0000,,Қайта сүрініп кете жаздаған сайын
Dialogue: 0,0:01:30.90,0:01:35.15,JPOP,,0000,0000,0000,,Мен саған талай рет жабыстым
Dialogue: 0,0:01:35.15,0:01:40.74,JPOP,,0000,0000,0000,,Ақ, ақ, таза ақ болашақ
Dialogue: 0,0:01:40.74,0:01:46.08,JPOP,,0000,0000,0000,,Біздің жалғыз үмітіміз
Dialogue: 0,0:01:46.08,0:01:57.01,JPOP,,0000,0000,0000,,Дәл қазір менде бар соқыр сезім бар.
Dialogue: 0,0:01:57.01,0:02:02.22,JPOP,,0000,0000,0000,,Бір дұрыс жауап жоқ
Dialogue: 0,0:02:02.22,0:02:11.40,JPOP,,0000,0000,0000,,Мен өз ертеңімді іздедім
Dialogue: 0,0:20:02.30,0:20:08.10,JPED,,0000,0000,0000,,Екеуміз әлі ештеңе білмедік.
Dialogue: 0,0:20:08.46,0:20:14.61,JPED,,0000,0000,0000,,Мен сол қолыммен өткінші жоқтықпен ойнадым.
Dialogue: 0,0:20:14.62,0:20:20.40,JPED,,0000,0000,0000,,Кішкене қақтығыс қолдарыңызды байлайды
Dialogue: 0,0:20:20.73,0:20:25.02,JPED,,0000,0000,0000,,Болашақты алдау
Dialogue: 0,0:20:25.36,0:20:31.94,JPED,,0000,0000,0000,,Мен оны қалай қорғау керектігін де білмеймін
Dialogue: 0,0:20:31.94,0:20:37.76,JPED,,0000,0000,0000,,Бұл жалған идеал болса, бәрібір
Dialogue: 0,0:20:38.08,0:20:46.92,JPED,,0000,0000,0000,,Мен өзім өмір сүргім келеді
Dialogue: 0,0:20:46.98,0:20:53.65,JPED,,0000,0000,0000,,Уақыт өте келе кездестік
Dialogue: 0,0:20:53.65,0:20:59.66,JPED,,0000,0000,0000,,Мен сенімен бірге болған маған сенемін
Dialogue: 0,0:20:59.85,0:21:05.84,JPED,,0000,0000,0000,,Бұл арман ақырын аяқталғанша
Dialogue: 0,0:21:05.94,0:21:14.48,JPED,,0000,0000,0000,,Көгілдір күндерді ашып, тағдырыңмен күрес
Dialogue: 0,0:00:03.96,0:00:06.62,JPDB,,0000,0000,0000,,Сіз мені естіген жоқсыз ба? Мен сізге артқа шегініңіз дедім.
Dialogue: 0,0:00:06.74,0:00:08.70,JPDB,,0000,0000,0000,,Менің саған пайдасы жоқ Ассасин
Dialogue: 0,0:00:09.08,0:00:12.52,JPDB,,0000,0000,0000,,Сонда менің саған итеріп өт дегенімді естімедің бе?
Dialogue: 0,0:00:13.06,0:00:16.46,JPDB,,0000,0000,0000,,Асықпасаң, қожайын аман қалмайды.
Dialogue: 0,0:00:18.46,0:00:21.52,JPDB,,0000,0000,0000,,Ассасиндерге келгенде ашуланбаңыз, Кастер.
Dialogue: 0,0:00:21.94,0:00:23.96,JPDB,,0000,0000,0000,,Ол Саберге қарап тұр.
Dialogue: 0,0:00:24.22,0:00:26.82,JPDB,,0000,0000,0000,,Анау самурай, оның кім екенін білмеймін.
Dialogue: 0,0:00:26.90,0:00:29.64,JPDB,,0000,0000,0000,,Саберді ұстап тұру үшін керемет қылышшы керек.
Dialogue: 0,0:00:29.92,0:00:31.92,JPDB,,0000,0000,0000,,Оны мақтағаныңыз жөн емес пе?
Dialogue: 0,0:00:33.40,0:00:34.74,JPDB,,0000,0000,0000,,Әзіл
Dialogue: 0,0:00:35.26,0:00:39.32,JPDB,,0000,0000,0000,,Мен сені тоқтата алмасам, сені батыр дей алмаймын.
Dialogue: 0,0:00:39.54,0:00:43.66,JPDB,,0000,0000,0000,,Ол кісі өзін қылышшы деп атауға жарамайды.
Dialogue: 0,0:00:44.04,0:00:45.66,JPDB,,0000,0000,0000,,Сабер осында ма?
Dialogue: 0,0:02:31.96,0:02:33.02,JPDB,,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,0:02:33.50,0:02:37.58,JPDB,,0000,0000,0000,,Салмақта, күште, жылдамдықта біз артық болсақ та.
Dialogue: 0,0:02:38.10,0:02:39.48,JPDB,,0000,0000,0000,,Неліктен біз шабуыл жасай алмаймыз?
Dialogue: 0,0:02:47.66,0:02:49.07,JPDB,,0000,0000,0000,,Жоқ, тамаша жұмыс.
Dialogue: 0,0:02:49.68,0:02:51.96,JPDB,,0000,0000,0000,,Мен бұл басынан жеті рет айырылдым деп ойладым, бірақ
Dialogue: 0,0:02:52.06,0:02:53.70,JPDB,,0000,0000,0000,,Ол әлі де тіркелген бе?
Dialogue: 0,0:02:53.86,0:02:56.78,JPDB,,0000,0000,0000,,Менің ойымша, батыстық таяқпен тербелудің де өзіндік принциптері болған.
Dialogue: 0,0:02:57.18,0:03:00.56,JPDB,,0000,0000,0000,,Бұл кішкентай сарбаздың техникасын көруге тұрарлық.
Dialogue: 0,0:03:00.84,0:03:02.58,JPDB,,0000,0000,0000,,Ол кішігірім айлалардың білгірі сияқты.
Dialogue: 0,0:03:02.70,0:03:06.24,JPDB,,0000,0000,0000,,Жауап: Күш те, рух та жақсы.
Dialogue: 0,0:03:06.42,0:03:09.28,JPDB,,0000,0000,0000,,Мұндағы бірден-бір ерекшелік - дәмділік.
Dialogue: 0,0:03:09.64,0:03:12.46,JPDB,,0000,0000,0000,,Сенің көзге көрінбейтін қылышқа үйренетін кезің болды.
Dialogue: 0,0:03:13.98,0:03:15.42,JPDB,,0000,0000,0000,,Дәл осы кездесу...
Dialogue: 0,0:03:15.90,0:03:19.54,JPDB,,0000,0000,0000,,Бұл қызметші қылыш шеберлігі жағынан менен әлдеқайда жоғары ма?
Dialogue: 0,0:03:20.30,0:03:21.82,JPDB,,0000,0000,0000,,Әрі қарай жалғастырайық
Dialogue: 0,0:03:21.96,0:03:24.56,JPDB,,0000,0000,0000,,Қосу мен азайтуды тоқтататын кез келді, Сабер.
Dialogue: 0,0:03:26.20,0:03:27.98,JPDB,,0000,0000,0000,,Ширу, өтінемін...
Dialogue: 0,0:03:30.80,0:03:35.48,JPDB,,0000,0000,0000,,Сіз әлі де осы мәлімдемемен жұмыс істеп жатырсыз ба? Сіздің қожайыныңыз
Dialogue: 0,0:03:36.10,0:03:37.64,JPDB,,0000,0000,0000,,Сіз ынтымақтастықтасыз ба?
Dialogue: 0,0:03:37.94,0:03:43.24,JPDB,,0000,0000,0000,,Әй, қақпаның сыртын қорғайтын өлтіруші мен іште аңдып жүрген құймашы.
Dialogue: 0,0:03:43.52,0:03:46.24,JPDB,,0000,0000,0000,,Екеуінің ынтымақтастық қарым-қатынаста екені анық.
Dialogue: 0,0:03:46.70,0:03:48.62,JPDB,,0000,0000,0000,,Ерекше емес
Dialogue: 0,0:03:49.02,0:03:51.60,JPDB,,0000,0000,0000,,Мен шын мәнінде сізбен қол ұстасып жатырмын.
Dialogue: 0,0:03:58.18,0:04:00.88,JPDB,,0000,0000,0000,,Мен ол итпен жұмыс істеймін.
Dialogue: 0,0:04:01.52,0:04:04.46,JPDB,,0000,0000,0000,,Менің қолымдағы қаскүнеммен?
Dialogue: 0,0:04:04.66,0:04:05.80,JPDB,,0000,0000,0000,,Пешка ретінде
Dialogue: 0,0:04:06.18,0:04:06.92,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:04:07.26,0:04:11.18,JPDB,,0000,0000,0000,,Біріншіден, ол иттің қожасы жоқ.
Dialogue: 0,0:04:11.35,0:04:12.04,JPDB,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:04:12.12,0:04:15.34,JPDB,,0000,0000,0000,,Кастер, сіз ережені бұздыңыз.
Dialogue: 0,0:04:16.68,0:04:21.64,JPDB,,0000,0000,0000,,Сиқыршы ретінде қызметшіні шақырудың қандай зияны бар?
Dialogue: 0,0:04:21.80,0:04:24.12,JPDB,,0000,0000,0000,,Кастер - өлтіруші...
Dialogue: 0,0:04:24.92,0:04:28.50,JPDB,,0000,0000,0000,,Қызметші қызметшіні шақырды?
Dialogue: 0,0:04:28.94,0:04:32.18,JPDB,,0000,0000,0000,,Әділ қожайын шақырмаған сол қақпашы
Dialogue: 0,0:04:32.30,0:04:34.06,JPDB,,0000,0000,0000,,Нағыз өлтіруші емес
Dialogue: 0,0:04:35.10,0:04:39.24,JPDB,,0000,0000,0000,,Ережені бұзып, өз қолыңызбен өлтіруші қызметшіні шақырыңыз
Dialogue: 0,0:04:39.72,0:04:43.78,JPDB,,0000,0000,0000,,Осы елге қоныс қондырып, қала тұрғындарынан жан жина.
Dialogue: 0,0:04:44.14,0:04:48.94,JPDB,,0000,0000,0000,,Өзіңізбен соғыспаңыз, қаланы бақылаңыз және соғыс жағдайын бақылаңыз
Dialogue: 0,0:04:49.44,0:04:52.84,JPDB,,0000,0000,0000,,Магия Сабер сияқты үш негізгі рыцарь класына қарсы жұмыс істеу қиын.
Dialogue: 0,0:04:53.24,0:04:57.86,JPDB,,0000,0000,0000,,Сиқыршылар класы болғандықтан, сіз айлакерлікке баруыңыз табиғи нәрсе.
Dialogue: 0,0:04:59.00,0:05:02.72,JPDB,,0000,0000,0000,,Бірақ бұл сіздің қалауыңыз емес пе, Кастер?
Dialogue: 0,0:05:03.10,0:05:05.16,JPDB,,0000,0000,0000,,Қызық, негізі неде?
Dialogue: 0,0:05:05.90,0:05:07.52,JPDB,,0000,0000,0000,,Шебер – сиқыршы.
Dialogue: 0,0:05:07.82,0:05:10.98,JPDB,,0000,0000,0000,,Егер сіз өзіңізден күшті сиқыршыны шақырсаңыз
Dialogue: 0,0:05:11.16,0:05:13.16,JPDB,,0000,0000,0000,,Бұйрық сиқыры болса да сақ болыңыз
Dialogue: 0,0:05:13.54,0:05:14.60,JPDB,,0000,0000,0000,,Бұл жағдайда
Dialogue: 0,0:05:14.84,0:05:18.96,JPDB,,0000,0000,0000,,Сізге өз мүшелеріңізге айналатын қызметшіні шақыруға рұқсат етілгенін елестету қиын.
Dialogue: 0,0:05:19.44,0:05:20.52,JPDB,,0000,0000,0000,,Егер...
Dialogue: 0,0:05:20.92,0:05:22.70,JPDB,,0000,0000,0000,,Мына ақымақ қожайын сияқты
Dialogue: 0,0:05:22.88,0:05:26.02,JPDB,,0000,0000,0000,,Сізді қуыршаққа айналдырғаныңызды болжау қиын.
Dialogue: 0,0:05:27.82,0:05:31.04,JPDB,,0000,0000,0000,,Қасиетті Граил соғысында жеңіске жету оңай.
Dialogue: 0,0:05:31.28,0:05:35.66,JPDB,,0000,0000,0000,,Менің істеп жатқаным тек ары қарай не болатынын ойлау.
Dialogue: 0,0:05:36.66,0:05:39.16,JPDB,,0000,0000,0000,,Бізді жеңу оңай болады.
Dialogue: 0,0:05:39.52,0:05:42.16,JPDB,,0000,0000,0000,,Бір ғана мамандығы қашатын бақсы.
Dialogue: 0,0:05:44.14,0:05:49.19,JPDB,,0000,0000,0000,,Иә, бұл жерде маған сызат та бере алмайсың.
Dialogue: 0,0:05:49.84,0:05:53.92,JPDB,,0000,0000,0000,,Мені бақсы деп атаған адам тиісті жазасын алады.
Dialogue: 0,0:05:55.66,0:05:57.82,JPDB,,0000,0000,0000,,Сіз бұл тіпті сызат деп айттыңыз.
Dialogue: 0,0:05:58.26,0:05:59.96,JPDB,,0000,0000,0000,,Сонда бір ғана соққы
Dialogue: 0,0:06:00.62,0:06:03.62,JPDB,,0000,0000,0000,,Бұл жұмыс істемесе, қалғанын Саберге қалдырыңыз.
Dialogue: 0,0:06:22.22,0:06:24.26,JPDB,,0000,0000,0000,,Өте өкінішті, Арчер.
Dialogue: 0,0:06:35.30,0:06:38.11,JPDB,,0000,0000,0000,,Кеңістікті тасымалдау немесе уақытты дұрыс бақылау?
Dialogue: 0,0:06:38.84,0:06:42.50,JPDB,,0000,0000,0000,,Бұл тіпті осы учаскеде сиқырға еліктеуге болатынын білдіре ме?
Dialogue: 0,0:06:45.22,0:06:46.75,JPDB,,0000,0000,0000,,Қаралған Кастер
Dialogue: 0,0:06:47.20,0:06:49.68,JPDB,,0000,0000,0000,,Мен Арчерге төмен қарадым.
Dialogue: 0,0:06:50.36,0:06:52.38,JPDB,,0000,0000,0000,,Мен бұл жұмыс істейді деп ойладым, сондықтан мен оны қолданып көрдім.
Dialogue: 0,0:06:52.44,0:06:53.98,JPDB,,0000,0000,0000,,Бұл өлтірушіден төмен.
Dialogue: 0,0:06:54.42,0:06:56.00,JPDB,,0000,0000,0000,,Жоқ, құлағым ауырады.
Dialogue: 0,0:06:56.48,0:06:59.42,JPDB,,0000,0000,0000,,Келесі жолы болса, мен сәл абай боламын.
Dialogue: 0,0:07:14.55,0:07:17.58,JPDB,,0000,0000,0000,,Виксен, сен көп сиқырлы күш жинадың.
Dialogue: 0,0:07:26.23,0:07:27.82,JPDB,,0000,0000,0000,,Сіз қашып кете аламын деп ойлайсыз ба?
Dialogue: 0,0:07:35.02,0:07:36.24,JPDB,,0000,0000,0000,,Әлгі ақымақ
Dialogue: 0,0:07:36.39,0:07:37.06,JPDB,,0000,0000,0000,,Яббе
Dialogue: 0,0:07:47.28,0:07:48.46,JPDB,,0000,0000,0000,,Менен түс, ақымақ.
Dialogue: 0,0:07:48.50,0:07:50.14,JPDB,,0000,0000,0000,,Сіз не ойлап отырсыз?
Dialogue: 0,0:07:51.19,0:07:52.26,JPDB,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:07:52.66,0:07:56.96,JPDB,,0000,0000,0000,,Олай айтсаң, менің ақымақ болғаныма менің басым ауырады, ақымақ.
Dialogue: 0,0:07:57.07,0:07:57.90,JPDB,,0000,0000,0000,,Идиот?
Dialogue: 0,0:07:58.44,0:08:03.26,JPDB,,0000,0000,0000,,Сіз ақымақ екеніңізді біле тұра, адамдарды ақымақ дейсіз бе?
Dialogue: 0,0:08:03.30,0:08:04.00,JPDB,,0000,0000,0000,,Мына ақымақ
Dialogue: 0,0:08:04.84,0:08:05.82,JPDB,,0000,0000,0000,,Сіз баласыз ба?
Dialogue: 0,0:08:06.06,0:08:08.38,JPDB,,0000,0000,0000,,Мен енді бұл ақымақ бәйбішеге шыдай алмаймын.
Dialogue: 0,0:08:08.58,0:08:11.10,JPDB,,0000,0000,0000,,Кем дегенде біреуін шешіңіз.
Dialogue: 0,0:08:11.18,0:08:12.56,JPDB,,0000,0000,0000,,Бұл...
Dialogue: 0,0:08:17.82,0:08:19.10,JPDB,,0000,0000,0000,,Мені жіберіңізші.
Dialogue: 0,0:08:19.48,0:08:21.10,JPDB,,0000,0000,0000,,Мен мұны өзім шеше аламын.
Dialogue: 0,0:08:21.18,0:08:21.78,JPDB,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:08:25.94,0:08:26.78,JPDB,,0000,0000,0000,,Теме...
Dialogue: 0,0:08:31.71,0:08:33.62,JPDB,,0000,0000,0000,,Қалайсың, Арчер?
Dialogue: 0,0:08:34.14,0:08:35.78,JPDB,,0000,0000,0000,,Қанша үш рыцарь болса да
Dialogue: 0,0:08:36.00,0:08:39.66,JPDB,,0000,0000,0000,,Кеңістіктің өзі бекітілген болса, жылжу мүмкін емес пе?
Dialogue: 0,0:08:41.18,0:08:43.04,JPDB,,0000,0000,0000,,Бұл соңы сияқты.
Dialogue: 0,0:08:43.50,0:08:45.94,JPDB,,0000,0000,0000,,Оның қай батыр екенін білмеймін, бірақ
Dialogue: 0,0:08:46.04,0:08:47.30,JPDB,,0000,0000,0000,,Бұл қоштасу
Dialogue: 0,0:08:51.70,0:08:53.24,JPDB,,0000,0000,0000,,Садақшы
Dialogue: 0,0:08:53.47,0:08:55.18,JPDB,,0000,0000,0000,,Өміріңді сұрасаң, тыңдаймын...
Dialogue: 0,0:08:55.18,0:08:55.78,JPDB,,0000,0000,0000,,Таваке
Dialogue: 0,0:08:56.44,0:08:58.22,JPDB,,0000,0000,0000,,Мен саған одан аулақ бол дедім, Кастер.
Dialogue: 0,0:09:09.91,0:09:10.72,JPDB,,0000,0000,0000,,Бұл...
Dialogue: 0,0:09:15.92,0:09:18.82,JPDB,,0000,0000,0000,,Мен қылышымның сүйегімін
Dialogue: 0,0:09:22.35,0:09:23.47,JPDB,,0000,0000,0000,,Каладболг
Dialogue: 0,0:09:34.28,0:09:37.30,JPDB,,0000,0000,0000,,Жоғарыда айтылғандар күткендей емес, жоғарыда айтылған сияқты.
Dialogue: 0,0:09:37.92,0:09:42.44,JPDB,,0000,0000,0000,,Бұл да өз ниетін жасыруға шамасы келмесе де, шебер үшін дағдарыс.
Dialogue: 0,0:09:42.84,0:09:45.74,JPDB,,0000,0000,0000,,Ол осы кезеңнен кейін де өзінің асыл фантасмасын ашпады.
Dialogue: 0,0:09:47.04,0:09:51.40,JPDB,,0000,0000,0000,,Бұл қожайын тәжірибесіз адам болса да, бұл оның құдайлық бақытына байланысты дегенді білдіре ме?
Dialogue: 0,0:09:52.16,0:09:53.82,JPDB,,0000,0000,0000,,Жақсы сенім қарым-қатынасы.
Dialogue: 0,0:09:54.28,0:09:56.60,JPDB,,0000,0000,0000,,Бұны жартылай талпыныспен бұзу мүмкін емес.
Dialogue: 0,0:09:58.88,0:10:00.48,JPDB,,0000,0000,0000,,Бірақ бұл мәселе
Dialogue: 0,0:10:00.76,0:10:02.50,JPDB,,0000,0000,0000,,Сіз өзіңіздің артықшылығыңыздан бас тартасыз ба?
Dialogue: 0,0:10:03.14,0:10:04.24,JPDB,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:10:04.58,0:10:07.86,JPDB,,0000,0000,0000,,Аноним болсам да, өмірім қылышқа арналды.
Dialogue: 0,0:10:08.12,0:10:09.98,JPDB,,0000,0000,0000,,Қолыңнан келгеннің бәрін жасай алмасаң
Dialogue: 0,0:10:10.28,0:10:13.70,JPDB,,0000,0000,0000,,Мен бұл сенімді күшпен ашуым керек пе?
Dialogue: 0,0:10:17.15,0:10:17.68,JPDB,,0000,0000,0000,,Құпия қылыш
Dialogue: 0,0:10:22.91,0:10:23.94,JPDB,,0000,0000,0000,,Қарлығаштың қайтарылуы
Dialogue: 0,0:10:24.00,0:10:24.90,JPDB,,0000,0000,0000,,Көрінгендей, алыптың ұлы мен жоғары шенді командирлер астанаға шақырылып жатыр.
Dialogue: 0,0:10:39.84,0:10:43.52,JPDB,,0000,0000,0000,,Арчер, неге мені аяқтамайсың?
Dialogue: 0,0:10:45.04,0:10:47.26,JPDB,,0000,0000,0000,,Мен сізге тек бір рет атуға тырысамын дедім.
Dialogue: 0,0:10:51.60,0:10:54.04,JPDB,,0000,0000,0000,,Сонда мені өлтірмек ойың жоқ па?
Dialogue: 0,0:10:54.74,0:10:57.84,JPDB,,0000,0000,0000,,Менің мақсатым осы кісімен болды.
Dialogue: 0,0:10:58.36,0:11:01.10,JPDB,,0000,0000,0000,,Принцип - қажетсіз шайқастарды болдырмау.
Dialogue: 0,0:11:01.83,0:11:02.56,JPDB,,0000,0000,0000,,Эй
Dialogue: 0,0:11:05.59,0:11:09.48,JPDB,,0000,0000,0000,,Егер солай болса, бұл екеуіңнің ұқсас екеніңді білдіре ме?
Dialogue: 0,0:11:10.90,0:11:17.20,JPDB,,0000,0000,0000,,Ол бала мен сияқты туысы жоқ адамдарға жем болған қызметшіге шыдай алмайды.
Dialogue: 0,0:11:17.74,0:11:20.32,JPDB,,0000,0000,0000,,Ақылсыз сойғанды ​​ұнатпайсың.
Dialogue: 0,0:11:20.60,0:11:23.04,JPDB,,0000,0000,0000,,Қараңыз, олар мүлдем бірдей емес.
Dialogue: 0,0:11:23.96,0:11:25.96,JPDB,,0000,0000,0000,,Бұл жігітпен кім бар?
Dialogue: 0,0:11:26.00,0:11:26.86,JPDB,,0000,0000,0000,,Біз бәріміз құтқарылар едік
Dialogue: 0,0:11:27.14,0:11:31.00,JPDB,,0000,0000,0000,,Мен пацифист екенімді мойындаймын, бірақ негіздері мүлдем басқа.
Dialogue: 0,0:11:31.08,0:11:32.68,JPDB,,0000,0000,0000,,Пацифист деген не?
Dialogue: 0,0:11:33.04,0:11:34.50,JPDB,,0000,0000,0000,,Мен ұмытқан жоқпын
Dialogue: 0,0:11:34.75,0:11:37.20,JPDB,,0000,0000,0000,,Сіз Саберді Берсеркермен ойнайсыз...
Dialogue: 0,0:11:37.24,0:11:39.84,JPDB,,0000,0000,0000,,Ол кезде біз әлі кооперативтік қарым-қатынаста емес едік.
Dialogue: 0,0:11:40.30,0:11:44.34,JPDB,,0000,0000,0000,,Мен саған көрген нәрсеңнің бәріне көмектес деп айтпаймын.
Dialogue: 0,0:11:45.46,0:11:48.84,JPDB,,0000,0000,0000,,Олай болса, Берсеркер жеңетін мақсат емес.
Dialogue: 0,0:11:52.38,0:11:57.14,JPDB,,0000,0000,0000,,Маған ұнайды. Сіздің күштеріңіз бен болмысыңыз сирек кездеседі.
Dialogue: 0,0:11:58.04,0:11:59.76,JPDB,,0000,0000,0000,,Менімен қол ұстасып
Dialogue: 0,0:12:00.14,0:12:03.28,JPDB,,0000,0000,0000,,Мен бұл жекпе-жекті аяқтауға дайынмын
Dialogue: 0,0:12:03.55,0:12:04.34,JPDB,,0000,0000,0000,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:12:04.68,0:12:07.04,JPDB,,0000,0000,0000,,Мен сен сияқтылармен күш біріктірмеймін.
Dialogue: 0,0:12:09.58,0:12:11.38,JPDB,,0000,0000,0000,,Сәлем Арчер, сен...
Dialogue: 0,0:12:11.48,0:12:12.44,JPDB,,0000,0000,0000,,Бас тарту
Dialogue: 0,0:12:13.04,0:12:15.56,JPDB,,0000,0000,0000,,Сіздің лагеріңіздің күші аз.
Dialogue: 0,0:12:16.35,0:12:20.02,JPDB,,0000,0000,0000,,Күшіңізді қаншалықты кеңейтсеңіз де, бұл жалғыз Берсеркерге тең келмейді.
Dialogue: 0,0:12:20.38,0:12:22.94,JPDB,,0000,0000,0000,,Шарттар әлі жұптасу үшін жеткіліксіз.
Dialogue: 0,0:12:23.30,0:12:26.68,JPDB,,0000,0000,0000,,Сонымен, бұл келіссөздер үзілді дегенді білдіре ме?
Dialogue: 0,0:12:26.82,0:12:27.52,JPDB,,0000,0000,0000,,Иә.
Dialogue: 0,0:12:28.18,0:12:31.38,JPDB,,0000,0000,0000,,Мен мұнда өз бетіммен болдым.
Dialogue: 0,0:12:31.74,0:12:35.04,JPDB,,0000,0000,0000,,Бұл менің қожайынымның бұйрығы емес, сондықтан сені өлтіруге себеп жоқ.
Dialogue: 0,0:12:35.66,0:12:38.20,JPDB,,0000,0000,0000,,Неліктен ауырсынуды ажырату үшін бұл туралы бірдеңе жасамасқа?
Dialogue: 0,0:12:38.47,0:12:39.16,JPDB,,0000,0000,0000,,Эй
Dialogue: 0,0:12:39.24,0:12:43.26,JPDB,,0000,0000,0000,,Бұл таңқаларлық. Қожайыныңыз мені аңдып жүрген болуы керек.
Dialogue: 0,0:12:43.78,0:12:46.34,JPDB,,0000,0000,0000,,Бірақ сен мені сағынамын дейсің бе?
Dialogue: 0,0:12:47.79,0:12:52.04,JPDB,,0000,0000,0000,,Маған мұнда қанша адамды өлтіргеніңіз маңызды емес.
Dialogue: 0,0:12:52.24,0:12:55.04,JPDB,,0000,0000,0000,,О, қандай сұмдық адам.
Dialogue: 0,0:12:57.54,0:12:58.70,JPDB,,0000,0000,0000,,Күте тұрыңыз, Кастер
Dialogue: 0,0:13:06.76,0:13:09.50,JPDB,,0000,0000,0000,,Садақшы Неліктен Кастердің қашып кетуіне жол бердіңіз?
Dialogue: 0,0:13:10.20,0:13:14.28,JPDB,,0000,0000,0000,,Осы жерден кесіп тастасам, бірден қашып кетер еді.
Dialogue: 0,0:13:14.90,0:13:18.08,JPDB,,0000,0000,0000,,Кастерді жеңгіңіз келсе, Мастер бірінші келуі керек.
Dialogue: 0,0:13:20.32,0:13:23.90,JPDB,,0000,0000,0000,,Бірақ қалада болып жатқан оқиғалар оның ісі.
Dialogue: 0,0:13:24.43,0:13:27.64,JPDB,,0000,0000,0000,,Біз оны тоқтатпасақ, құрбандар бола береді.
Dialogue: 0,0:13:27.91,0:13:31.36,JPDB,,0000,0000,0000,,Мен оның осылай жалғастырғанын қалаймын.
Dialogue: 0,0:13:32.74,0:13:35.28,JPDB,,0000,0000,0000,,Дөңгелекшілер адамдардың өмірін сорып алады.
Dialogue: 0,0:13:35.44,0:13:37.52,JPDB,,0000,0000,0000,,Берсеркерді осы күшпен жеңіңіз
Dialogue: 0,0:13:38.28,0:13:41.06,JPDB,,0000,0000,0000,,Біз Кастерді кейін жеңуіміз керек.
Dialogue: 0,0:13:41.60,0:13:43.72,JPDB,,0000,0000,0000,,Тохсака ондай саясат ұстанбайды.
Dialogue: 0,0:13:43.82,0:13:48.94,JPDB,,0000,0000,0000,,Дұрыс, сондықтан мен құйғыш тез бітірсе екен деймін.
Dialogue: 0,0:13:49.42,0:13:51.40,JPDB,,0000,0000,0000,,Қанша адам өлетінін білмеймін.
Dialogue: 0,0:13:51.68,0:13:53.98,JPDB,,0000,0000,0000,,Ақырында өлетін тіршілік иелері, мысалы, адамдар
Dialogue: 0,0:13:54.54,0:13:57.84,JPDB,,0000,0000,0000,,Мені кім және қалай өлтірсе де, бұл нәтижені өзгертпейді.
Dialogue: 0,0:14:05.95,0:14:08.44,JPDB,,0000,0000,0000,,Сен менің құпия қылышымды басып өттің.
Dialogue: 0,0:14:10.32,0:14:12.70,JPDB,,0000,0000,0000,,Не? Бұл соншалықты үлкен қулық емес.
Dialogue: 0,0:14:13.34,0:14:17.38,JPDB,,0000,0000,0000,,Мен мұны қарлығашты өлтіруді ойлаған кезде кездейсоқ білдім.
Dialogue: 0,0:14:18.06,0:14:22.24,JPDB,,0000,0000,0000,,Сап қана ұзын қылышым аспанда ұшқан қарлығашты ұстай алмайды.
Dialogue: 0,0:14:22.66,0:14:26.34,JPDB,,0000,0000,0000,,Бірақ екі-үш жол болса, әңгіме басқа.
Dialogue: 0,0:14:26.72,0:14:29.18,JPDB,,0000,0000,0000,,Бірақ олар жылдам болды.
Dialogue: 0,0:14:29.55,0:14:33.78,JPDB,,0000,0000,0000,,Егер сіз бірдеңені орындағыңыз келсе, оның бәрін бір деммен орындауыңыз керек еді.
Dialogue: 0,0:14:34.20,0:14:36.40,JPDB,,0000,0000,0000,,Мұндай еліктеу адамдық дағды емес.
Dialogue: 0,0:14:38.66,0:14:41.96,JPDB,,0000,0000,0000,,Бірақ, өкінішке орай, басқа шаруам болмады.
Dialogue: 0,0:14:42.44,0:14:45.06,JPDB,,0000,0000,0000,,Ичинен Кішінмен тіл табыса алады дейді.
Dialogue: 0,0:14:47.06,0:14:48.66,JPDB,,0000,0000,0000,,Білмей тұрып, мынандай
Dialogue: 0,0:14:49.19,0:14:49.83,JPDB,,0000,0000,0000,,Жоқ
Dialogue: 0,0:14:50.24,0:14:52.22,JPDB,,0000,0000,0000,,Бір демде қабаттассаңыз
Dialogue: 0,0:14:52.83,0:14:54.42,JPDB,,0000,0000,0000,,Дәл сол уақыт болды.
Dialogue: 0,0:14:55.00,0:14:57.82,JPDB,,0000,0000,0000,,Бұл кезде міндетті түрде үш қылыш болды.
Dialogue: 0,0:14:58.34,0:14:59.40,JPDB,,0000,0000,0000,,Сену қиын
Dialogue: 0,0:15:00.02,0:15:02.58,JPDB,,0000,0000,0000,,Енді... өлшемді сыну құбылысы...
Dialogue: 0,0:15:03.28,0:15:08.56,JPDB,,0000,0000,0000,,Ешбір сиқырды қолданбай, тек қылыш шеберлігімен Асыл Фантазм деңгейіне жеткен қызметші.
Dialogue: 0,0:15:11.76,0:15:13.36,JPDB,,0000,0000,0000,,Дөңгелекшілер де жайбарақат
Dialogue: 0,0:15:13.86,0:15:16.34,JPDB,,0000,0000,0000,,Жаныңды алып кеткенің дұрыс болар еді.
Dialogue: 0,0:15:16.68,0:15:20.60,JPDB,,0000,0000,0000,,Егер қаладағы барлық адамдар өлсе, шайқасу жеңілірек болады.
Dialogue: 0,0:15:20.71,0:15:21.76,JPDB,,0000,0000,0000,,Сіз...
Dialogue: 0,0:15:25.48,0:15:28.34,JPDB,,0000,0000,0000,,Біз ынтымақтастық қарым-қатынаста емеспіз бе?
Dialogue: 0,0:15:28.46,0:15:29.58,JPDB,,0000,0000,0000,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:15:29.90,0:15:31.50,JPDB,,0000,0000,0000,,Мен сенен басқашамын
Dialogue: 0,0:15:32.06,0:15:37.84,JPDB,,0000,0000,0000,,Жеңіске жету үшін немесе нәтиже үшін айналаңыздағыларды құрбан етер ме едіңіз?
Dialogue: 0,0:15:38.18,0:15:40.86,JPDB,,0000,0000,0000,,Мен үшін де солай, Ширу Эмия.
Dialogue: 0,0:15:41.60,0:15:44.20,JPDB,,0000,0000,0000,,Бірақ барлығын құтқару мүмкін емес
Dialogue: 0,0:15:44.94,0:15:47.18,JPDB,,0000,0000,0000,,Кастер Қасиетті Граалды алған кезде
Dialogue: 0,0:15:47.50,0:15:49.54,JPDB,,0000,0000,0000,,Зақым осы қаламен шектелмейді.
Dialogue: 0,0:15:50.11,0:15:53.64,JPDB,,0000,0000,0000,,Жеңіске жетпесек, зиян одан да көп болады.
Dialogue: 0,0:15:54.11,0:15:57.90,JPDB,,0000,0000,0000,,Ондай жағдайда бұл қала тұрғындарының өздерін құрбан етуден басқа амалы жоқ.
Dialogue: 0,0:15:58.42,0:16:02.78,JPDB,,0000,0000,0000,,Нәтиже зиянды азайта алса, сіздің саясатыңыз бірдей болады.
Dialogue: 0,0:16:04.11,0:16:08.08,JPDB,,0000,0000,0000,,Біреуді құтқару - біреуді құтқармау.
Dialogue: 0,0:16:09.60,0:16:12.54,JPDB,,0000,0000,0000,,Сіз байланыссыз адамдарды тартқыңыз келмейтінін айттыңыз.
Dialogue: 0,0:16:13.46,0:16:14.60,JPDB,,0000,0000,0000,,Содан кейін мойындаңыз.
Dialogue: 0,0:16:15.30,0:16:19.56,JPDB,,0000,0000,0000,,Ешкімді өлтірмесең, соңында ешкімді құтқара алмайсың.
Dialogue: 0,0:16:24.55,0:16:26.10,JPDB,,0000,0000,0000,,Сіз Кастерді қууды жоспарлап отырсыз ба?
Dialogue: 0,0:16:27.39,0:16:29.50,JPDB,,0000,0000,0000,,Мен сақтап қалған өмірімді босқа жұмсадым...
Dialogue: 0,0:16:29.56,0:16:30.20,JPDB,,0000,0000,0000,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:16:30.64,0:16:33.70,JPDB,,0000,0000,0000,,Менен сұрасаң да, көмек бар ма?
Dialogue: 0,0:16:34.60,0:16:37.67,JPDB,,0000,0000,0000,,Түсіндім, мені сағынбағаның қандай жақсы
Dialogue: 0,0:17:15.96,0:17:16.76,JPDB,,0000,0000,0000,,Садақшы?
Dialogue: 0,0:17:17.35,0:17:18.36,JPDB,,0000,0000,0000,,Сіз...
Dialogue: 0,0:17:19.02,0:17:22.02,JPDB,,0000,0000,0000,,Ұрыстың пайдасы жоқ, сондықтан Ширу Эмия осында өлуі керек.
Dialogue: 0,0:17:24.99,0:17:27.96,JPDB,,0000,0000,0000,,Өзің үшін емес, басқа біреу үшін күресу, т.б.
Dialogue: 0,0:17:28.23,0:17:29.48,JPDB,,0000,0000,0000,,Тек екіжүзділік
Dialogue: 0,0:17:30.24,0:17:33.26,JPDB,,0000,0000,0000,,Қалағаныңыз – жеңіс емес, бейбітшілік.
Dialogue: 0,0:17:33.70,0:17:37.52,JPDB,,0000,0000,0000,,Мұндай нәрсе бұл дүниеде еш жерде жоқ.
Dialogue: 0,0:17:39.76,0:17:40.94,JPDB,,0000,0000,0000,,Келесі шайқас!
Dialogue: 0,0:17:41.06,0:17:42.06,JPDB,,0000,0000,0000,,Спидвегон, мен мұнда келдім —
Dialogue: 0,0:17:42.38,0:17:44.30,JPDB,,0000,0000,0000,,Өзіңізді идеалдарыңызбен суға батырыңыз
Dialogue: 0,0:17:51.46,0:17:52.18,JPDB,,0000,0000,0000,,Ширу
Dialogue: 0,0:17:54.87,0:17:57.26,JPDB,,0000,0000,0000,,Виксен, сен шегіндің бе?
Dialogue: 0,0:17:57.48,0:17:58.50,JPDB,,0000,0000,0000,,Сабер…
Dialogue: 0,0:18:03.68,0:18:07.02,JPDB,,0000,0000,0000,,Ассасин, сен неге мені қазір өлтірмедің?
Dialogue: 0,0:18:07.60,0:18:10.18,JPDB,,0000,0000,0000,,Не, сенен көңілім қалды.
Dialogue: 0,0:18:10.63,0:18:12.32,JPDB,,0000,0000,0000,,Олардың бір-бірімен қалай ойнағанын көру өте жақсы болды.
Dialogue: 0,0:18:12.46,0:18:15.22,JPDB,,0000,0000,0000,,Тәңірді ойлауға тырыссам да, оны жіберу қиын.
Dialogue: 0,0:18:15.74,0:18:17.60,JPDB,,0000,0000,0000,,Мен саған ғашық болдым
Dialogue: 0,0:18:20.26,0:18:23.48,JPDB,,0000,0000,0000,,Бүгін кешке жетеді, кет.
Dialogue: 0,0:18:23.98,0:18:25.74,JPDB,,0000,0000,0000,,Бізді сағындың ба?
Dialogue: 0,0:18:26.08,0:18:27.26,JPDB,,0000,0000,0000,,Сағынып қалсаң да
Dialogue: 0,0:18:27.68,0:18:29.80,JPDB,,0000,0000,0000,,Жақсы қарсыластарды табу қиын.
Dialogue: 0,0:18:30.04,0:18:33.36,JPDB,,0000,0000,0000,,Егер ол мінсіз күйде болмаса, ол ысырапшыл және өлтірілмейді.
Dialogue: 0,0:18:33.94,0:18:36.54,JPDB,,0000,0000,0000,,Немесе бұл несие деп ойлайсыз ба? Сабер
Dialogue: 0,0:18:37.06,0:18:39.40,JPDB,,0000,0000,0000,,Әрине Кодзиро Сасаки
Dialogue: 0,0:18:40.74,0:18:41.82,JPDB,,0000,0000,0000,,сыйламаушылық үшін кешірім сұраңыз
Dialogue: 0,0:18:42.24,0:18:45.16,JPDB,,0000,0000,0000,,Сен, әрине, мен қолымнан келгеннің бәрін істеуім керек жау едің.
Dialogue: 0,0:18:46.94,0:18:49.08,JPDB,,0000,0000,0000,,Мен сенімен міндетті түрде мәселені шешемін.
Dialogue: 0,0:18:49.80,0:18:53.92,JPDB,,0000,0000,0000,,Бұл Қасиетті Граил соғысы қалай аяқталса да,
Dialogue: 0,0:19:01.40,0:19:03.82,JPDB,,0000,0000,0000,,Сен менің жолыма бөгет болып тұрсың ба, Самурай?
Dialogue: 0,0:19:04.19,0:19:06.16,JPDB,,0000,0000,0000,,Міне, осы жол.
Dialogue: 0,0:19:06.58,0:19:09.46,JPDB,,0000,0000,0000,,Мен оны сағынып қаламын десем, сен менің жолыма кедергі жасамақшысың ба?
Dialogue: 0,0:19:09.86,0:19:12.08,JPDB,,0000,0000,0000,,Менің міндетім - мұнда қақпашы болу.
Dialogue: 0,0:19:12.60,0:19:14.86,JPDB,,0000,0000,0000,,Жолда сағындым, бірақ қайту басқаша.
Dialogue: 0,0:19:15.30,0:19:17.66,JPDB,,0000,0000,0000,,Мойынның әсемдігі біршама жетіспесе де.
Dialogue: 0,0:19:17.86,0:19:19.70,JPDB,,0000,0000,0000,,Осыны бүгін кешке шешейік.
Dialogue: 0,0:19:19.94,0:19:23.28,JPDB,,0000,0000,0000,,Кастердің пешкасы Фуджо менімен соғысса ше?
Dialogue: 0,0:19:23.75,0:19:28.92,JPDB,,0000,0000,0000,,Мені сол құлынның бауырын суытуға жіберген сен едің.
Dialogue: 0,0:19:29.18,0:19:32.28,JPDB,,0000,0000,0000,,Менің сүйкімділігіммен қашып кеткеніңе көңілім қалды.
Dialogue: 0,0:19:40.56,0:19:41.92,JPDB,,0000,0000,0000,,Ширу қазір
Dialogue: 0,0:19:42.71,0:19:43.20,JPDB,,0000,0000,0000,,Не болды, Ниа?
Dialogue: 0,0:21:23.16,0:21:23.92,JPDB,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:21:24.34,0:21:26.80,JPDB,,0000,0000,0000,,Сонымен Арчер Кастерді сағынды ма?
Dialogue: 0,0:21:27.16,0:21:30.62,JPDB,,0000,0000,0000,,О, мен оны сағындым. Әлгі жігіт сұмдық.
Dialogue: 0,0:21:30.80,0:21:34.50,JPDB,,0000,0000,0000,,Қаншалықты ұтқыңыз келсе де, Кастер сияқты біреуді пайдаланасыз.
Dialogue: 0,0:21:34.70,0:21:37.20,JPDB,,0000,0000,0000,,Сонда оның Кастерден айырмашылығы жоқ, солай ма?
Dialogue: 0,0:21:39.76,0:21:41.38,JPDB,,0000,0000,0000,,Бұған неге күлесің?
Dialogue: 0,0:21:41.66,0:21:46.04,JPDB,,0000,0000,0000,,Жоқ, менің ойымша, Ширудың адамдар туралы жаман сөздер айтуы сирек.
Dialogue: 0,0:21:46.50,0:21:51.16,JPDB,,0000,0000,0000,,Бірақ сіз Арчердің кескеніне ашуланбайсыз.
Dialogue: 0,0:21:54.88,0:21:58.56,JPDB,,0000,0000,0000,,Мен Тохсакамен тек ынтымақтастық қарым-қатынас орнаттым.
Dialogue: 0,0:21:59.34,0:22:02.48,JPDB,,0000,0000,0000,,Бұл тұрғыда оның әрекеті сатқындық емес.
Dialogue: 0,0:22:04.22,0:22:06.52,JPDB,,0000,0000,0000,,Ширу шынымен де біртүрлі екен.
Dialogue: 0,0:22:07.76,0:22:10.28,JPDB,,0000,0000,0000,,Кастердің жалғыз қалуға болмайтын жау екені рас.
Dialogue: 0,0:22:10.36,0:22:12.90,JPDB,,0000,0000,0000,,Мен Арчерді шектен шыққан деп ойламаймын.
Dialogue: 0,0:22:13.92,0:22:18.06,JPDB,,0000,0000,0000,,Біраз күте тұршы, Сабер, адамдар не айтып жатыр?
Dialogue: 0,0:22:18.52,0:22:19.96,JPDB,,0000,0000,0000,,Оны Ширу да көрген шығар.
Dialogue: 0,0:22:20.46,0:22:22.50,JPDB,,0000,0000,0000,,Оның қылыш шеберлігі мөлдір ағындай болды.
Dialogue: 0,0:22:23.24,0:22:25.20,JPDB,,0000,0000,0000,,Сенің жүрегіңде жамандық жоқ деп ойлаймын.
Dialogue: 0,0:22:29.30,0:22:31.58,JPDB,,0000,0000,0000,,Оның семсері маңызды емес.
Dialogue: 0,0:22:31.84,0:22:35.00,JPDB,,0000,0000,0000,,Сіз маған тосыннан шабуыл жасасаңыз да, мені жалғыз өлтіре алмадыңыз.
Dialogue: 0,0:22:35.12,0:22:35.64,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:22:36.02,0:22:38.20,JPDB,,0000,0000,0000,,Сондықтан Ширудың да жақсы ойы бар.
Dialogue: 0,0:22:38.96,0:22:42.06,JPDB,,0000,0000,0000,,Ұзақ күтсең, садақшының шеберлігіне жетеді.
Dialogue: 0,0:22:45.92,0:22:46.70,JPDB,,0000,0000,0000,,Шешім
Dialogue: 0,0:22:50.54,0:22:51.22,JPDB,,0000,0000,0000,,Сабер
Dialogue: 0,0:22:51.58,0:22:53.92,JPDB,,0000,0000,0000,,Жараң жазыла салысымен, маған қылышты үйрет.
Dialogue: 0,0:22:54.40,0:22:57.18,JPDB,,0000,0000,0000,,Жаттығу ғана емес, күресу тәсілі
Dialogue: 0,0:22:59.40,0:23:01.88,JPDB,,0000,0000,0000,,Иә, егер Ширу солай айтса.
Dialogue: 0,0:23:03.35,0:23:04.82,JPDB,,0000,0000,0000,,Жарайды, шешілді.
Dialogue: 0,0:23:08.07,0:23:10.34,JPDB,,0000,0000,0000,,Мен бүгінгі түндегідей қателікті қайталай алмаймын.
Dialogue: 0,0:23:10.66,0:23:12.74,JPDB,,0000,0000,0000,,Қашып кетсең ештеңе өзгермейді.
Dialogue: 0,0:23:13.86,0:23:14.56,JPDB,,0000,0000,0000,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:23:14.86,0:23:18.78,JPDB,,0000,0000,0000,,Құрбандардың санын азайту үшін құрбандықтардың көп болуына себепші боламын деген жігітке ғана.
Dialogue: 0,0:23:19.00,0:23:20.56,JPDB,,0000,0000,0000,,Жеңілуге жол берілмейді
Dialogue: 0,0:23:23.46,0:23:24.92,JPDB,,0000,0000,0000,,Ах...
Dialogue: 0,0:23:26.80,0:23:28.40,JPDB,,0000,0000,0000,,Біз кедергіні бұзамыз.
Dialogue: 0,0:23:28.46,0:23:30.12,JPDB,,0000,0000,0000,,Жау осында анықталды.
Dialogue: 0,0:23:30.16,0:23:33.54,JPDB,,0000,0000,0000,,Мен саған не істесең де төлейтін боламын.
Dialogue: 0,0:23:33.58,0:23:37.76,JPDB,,0000,0000,0000,,Жақсы, қызметші осындай болуы керек.
Dialogue: 0,0:23:39.26,0:23:45.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
