Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.01,0:00:27.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:00:27.03,0:00:31.20,Default,,0000,0000,0000,,Оноши түсінеді.
Dialogue: 0,0:00:31.20,0:00:35.10,Default,,0000,0000,0000,,Шинджиді кім өлтірді?
Dialogue: 0,0:00:39.87,0:00:46.15,Default,,0000,0000,0000,,Әй... Көрмеген сияқтымын.
Dialogue: 0,0:00:39.87,0:00:46.15,Default,,0000,0000,0000,,Сіз бас тартқан сияқтысыз.
Dialogue: 0,0:00:46.15,0:00:52.49,Default,,0000,0000,0000,,Олай емес, шыдамдылық.
Dialogue: 0,0:00:46.15,0:00:52.49,Default,,0000,0000,0000,,Өскен нәрсені жою үшін көп күш қажет.
Dialogue: 0,0:00:52.49,0:00:58.16,Default,,0000,0000,0000,,Қалағаныңды айтсаң, Онушидің қолы
Dialogue: 0,0:00:52.49,0:00:58.16,Default,,0000,0000,0000,,Сакураның маған опасыздық жасауын қаладым➡
Dialogue: 0,0:00:58.16,0:01:01.33,Default,,0000,0000,0000,,Сізде сақтандыру болуы керек.
Dialogue: 0,0:01:01.33,0:01:04.00,Default,,0000,0000,0000,,Сақтандыру...?
Dialogue: 0,0:01:04.00,0:01:08.00,Default,,0000,0000,0000,,Адамдық келбетін сақтайтын біртүрлі ояну болса да➡
Dialogue: 0,0:01:08.00,0:01:13.11,Default,,0000,0000,0000,,Мен оны бірінші рет мақтасам да,
Dialogue: 0,0:01:08.00,0:01:13.11,Default,,0000,0000,0000,,Бұл жақсы болуы мүмкін.
Dialogue: 0,0:01:16.01,0:01:18.85,Default,,0000,0000,0000,,Зоукен Сакура қайда?
Dialogue: 0,0:01:18.85,0:01:22.05,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:01:25.02,0:01:28.62,Default,,0000,0000,0000,,Әй, әпке?
Dialogue: 0,0:01:25.02,0:01:28.62,Default,,0000,0000,0000,,Бұл қандай сезімде?
Dialogue: 0,0:01:36.70,0:01:38.70,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:01:47.14,0:01:49.14,Default,,0000,0000,0000,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:01:49.14,0:01:52.48,Default,,0000,0000,0000,,Мен де Онушиге ризамын.
Dialogue: 0,0:01:52.48,0:01:56.48,Default,,0000,0000,0000,,Мен бәріне шыдауға тура келді.
Dialogue: 0,0:01:52.48,0:01:56.48,Default,,0000,0000,0000,,Сол қызға➡
Dialogue: 0,0:01:56.48,0:02:03.32,Default,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:01:56.48,0:02:03.32,Default,,0000,0000,0000,,Маған басқаларға құштар болуды үйреткен
Dialogue: 0,0:01:56.48,0:02:03.32,Default,,0000,0000,0000,,Онушиден басқа ешкім.
Dialogue: 0,0:02:03.32,0:02:08.16,Default,,0000,0000,0000,,Менің ағамды өлтірген ол қазір жоқ
Dialogue: 0,0:02:03.32,0:02:08.16,Default,,0000,0000,0000,,Бір орында тұра алмайсың.
Dialogue: 0,0:02:08.16,0:02:15.00,Default,,0000,0000,0000,,Эйнцберннің Қасиетті Грейлі басып алынды
Dialogue: 0,0:02:08.16,0:02:15.00,Default,,0000,0000,0000,,Садақшының жаны... және ➡
Dialogue: 0,0:02:15.00,0:02:19.34,Default,,0000,0000,0000,,Ол қақпаның кілтін алып кетеді!
Dialogue: 0,0:02:19.34,0:02:21.34,Default,,0000,0000,0000,,Мм... Зоукен!
Dialogue: 0,0:02:23.34,0:02:25.35,Default,,0000,0000,0000,,Нух….
Dialogue: 0,0:02:31.85,0:02:35.36,Default,,0000,0000,0000,,Кукакака...!
Dialogue: 0,0:02:37.36,0:02:41.19,Default,,0000,0000,0000,,Енді сол көлеңке
Dialogue: 0,0:02:37.36,0:02:41.19,Default,,0000,0000,0000,,Оны қабылдаңыз➡
Dialogue: 0,0:02:41.19,0:02:43.70,Default,,0000,0000,0000,,Шие гүлдері!
Dialogue: 0,0:02:48.13,0:02:51.30,Default,,0000,0000,0000,,Иә, ата.
Dialogue: 0,0:02:51.30,0:03:02.65,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:02.65,0:03:04.65,Default,,0000,0000,0000,,Сакура….
Dialogue: 0,0:03:13.83,0:03:15.83,Default,,0000,0000,0000,,(Мылтық ату дыбысы)
Dialogue: 0,0:03:18.00,0:03:22.50,Default,,0000,0000,0000,,Иә... менің әпкем
Dialogue: 0,0:03:18.00,0:03:22.50,Default,,0000,0000,0000,,Сіз үйде болдыңыз.
Dialogue: 0,0:03:22.50,0:03:28.17,Default,,0000,0000,0000,,Жақсы. Мен Широдан басқашамын
Dialogue: 0,0:03:22.50,0:03:28.17,Default,,0000,0000,0000,,Сізге көмектесуге ешқандай себеп жоқ.
Dialogue: 0,0:03:28.17,0:03:30.51,Default,,0000,0000,0000,,Уақыты келгенде➡
Dialogue: 0,0:03:30.51,0:03:32.81,Default,,0000,0000,0000,,Ілиясты ұрлауға кім келеді?
Dialogue: 0,0:03:30.51,0:03:32.81,Default,,0000,0000,0000,,Бұл анық.
Dialogue: 0,0:03:34.85,0:03:36.85,Default,,0000,0000,0000,,Бұл қорқынышты, әпке.
Dialogue: 0,0:03:36.85,0:03:42.96,Default,,0000,0000,0000,,Мен шынымен де жаманмын ба?
Dialogue: 0,0:03:36.85,0:03:42.96,Default,,0000,0000,0000,,Бұл анық емес.
Dialogue: 0,0:03:42.96,0:03:46.63,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:03:42.96,0:03:46.63,Default,,0000,0000,0000,,Сакура Матуды қорғағысы келген жігіт➡
Dialogue: 0,0:03:46.63,0:03:49.53,Default,,0000,0000,0000,,сөзсіз Лорд Дэмиан болары анық.
Dialogue: 0,0:03:46.63,0:03:49.53,Default,,0000,0000,0000,,Себебі мен бұған сенбедім.
Dialogue: 0,0:03:52.13,0:03:56.97,Default,,0000,0000,0000,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:03:52.13,0:03:56.97,Default,,0000,0000,0000,,Бұл, әрине, осы уақытқа дейін болды.
Dialogue: 0,0:03:56.97,0:04:02.14,Default,,0000,0000,0000,,Бірақ мен
Dialogue: 0,0:03:56.97,0:04:02.14,Default,,0000,0000,0000,,Енді әлсіз болмайды.
Dialogue: 0,0:04:02.14,0:04:05.98,Default,,0000,0000,0000,,Мен сені қорғаймын, Сенпай.
Dialogue: 0,0:04:05.98,0:04:07.98,Default,,0000,0000,0000,,Өйткені...
Dialogue: 0,0:04:07.98,0:04:11.48,Default,,0000,0000,0000,,Мен күштімін.
Dialogue: 0,0:04:14.65,0:04:17.66,Default,,0000,0000,0000,,Вершмерцен!
Dialogue: 0,0:04:17.66,0:04:19.86,Default,,0000,0000,0000,,№.
Dialogue: 0,0:04:22.16,0:04:29.00,Default,,0000,0000,0000,,Егер сіз осындай сиқырды қолдансаңыз.
Dialogue: 0,0:04:22.16,0:04:29.00,Default,,0000,0000,0000,,Үй бұзылады, солай ма?
Dialogue: 0,0:04:29.00,0:04:36.34,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:04:36.34,0:04:38.68,Default,,0000,0000,0000,,Аға… Көмектес маған
Dialogue: 0,0:04:38.68,0:04:42.12,Default,,0000,0000,0000,,Уф… уф….
Dialogue: 0,0:04:42.12,0:04:46.12,Default,,0000,0000,0000,,Уф… уф….
Dialogue: 0,0:04:42.12,0:04:46.12,Default,,0000,0000,0000,,А... уф...
Dialogue: 0,0:04:46.12,0:04:51.52,Default,,0000,0000,0000,,Дәмді.
Dialogue: 0,0:04:46.12,0:04:51.52,Default,,0000,0000,0000,,Бұл сенің апаңның сиқырлы күші.
Dialogue: 0,0:04:53.46,0:04:58.80,Default,,0000,0000,0000,,Бірақ... бұл жеткіліксіз.
Dialogue: 0,0:04:58.80,0:05:02.80,Default,,0000,0000,0000,,Апа орнынан тұрады.
Dialogue: 0,0:05:02.80,0:05:08.64,Default,,0000,0000,0000,,Өйткені... менің апам – батыр.
Dialogue: 0,0:05:08.64,0:05:15.65,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:15.65,0:05:17.65,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:05:20.82,0:05:23.66,Default,,0000,0000,0000,,Шие гүлдері! Ха… ха….
Dialogue: 0,0:05:23.66,0:05:27.33,Default,,0000,0000,0000,,Сен... Пай.
Dialogue: 0,0:05:27.33,0:05:30.66,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:05:30.66,0:05:34.00,Default,,0000,0000,0000,,Енді… Уф….
Dialogue: 0,0:05:30.66,0:05:34.00,Default,,0000,0000,0000,,Ух... уф...
Dialogue: 0,0:05:34.00,0:05:36.50,Default,,0000,0000,0000,,Тохсака!
Dialogue: 0,0:05:38.50,0:05:41.17,Default,,0000,0000,0000,,Бұл не...?
Dialogue: 0,0:05:41.17,0:05:43.94,Default,,0000,0000,0000,,Уф... Гах!
Dialogue: 0,0:05:43.94,0:05:46.78,Default,,0000,0000,0000,,Аа... аа... иә.
Dialogue: 0,0:05:46.78,0:05:49.98,Default,,0000,0000,0000,,Неге апаңды қорғайсың?
Dialogue: 0,0:05:51.95,0:05:54.29,Default,,0000,0000,0000,,Неге ештеңе айтпайсың?
Dialogue: 0,0:05:54.29,0:05:57.62,Default,,0000,0000,0000,,Неге мені ұрыспайсың?
Dialogue: 0,0:05:57.62,0:06:02.13,Default,,0000,0000,0000,,Менің ағама не болды?
Dialogue: 0,0:05:57.62,0:06:02.13,Default,,0000,0000,0000,,Мен оны көрдім.
Dialogue: 0,0:06:02.13,0:06:06.80,Default,,0000,0000,0000,,Жоқ. Мұны Зоукен жоспарлаған...
Dialogue: 0,0:06:02.13,0:06:06.80,Default,,0000,0000,0000,,№.
Dialogue: 0,0:06:06.80,0:06:10.14,Default,,0000,0000,0000,,Қарашы, сенпай.
Dialogue: 0,0:06:10.14,0:06:13.97,Default,,0000,0000,0000,,Мен әу бастан жынды болдым.
Dialogue: 0,0:06:13.97,0:06:17.31,Default,,0000,0000,0000,,Саку…ра….
Dialogue: 0,0:06:17.31,0:06:19.81,Default,,0000,0000,0000,,Менімен бірге болу өте ауыр, солай ма?
Dialogue: 0,0:06:19.81,0:06:25.32,Default,,0000,0000,0000,,Сонымен, менің ағамның алдында
Dialogue: 0,0:06:19.81,0:06:25.32,Default,,0000,0000,0000,,Ол жоғалып кетуі керек еді.
Dialogue: 0,0:06:25.32,0:06:27.99,Default,,0000,0000,0000,,Бірақ мен алмаймын.
Dialogue: 0,0:06:27.99,0:06:32.99,Default,,0000,0000,0000,,Мені бақытты ететін нәрсе
Dialogue: 0,0:06:27.99,0:06:32.99,Default,,0000,0000,0000,,Тек қарт адамдар.
Dialogue: 0,0:06:32.99,0:06:36.33,Default,,0000,0000,0000,,Сенпай да мені тастап кете алмайды.
Dialogue: 0,0:06:36.33,0:06:40.03,Default,,0000,0000,0000,,Мен енді өзімді сата алмаймын
Dialogue: 0,0:06:36.33,0:06:40.03,Default,,0000,0000,0000,,Себебі мен алмаймын.
Dialogue: 0,0:06:47.61,0:06:51.44,Default,,0000,0000,0000,,Сондықтан мен сені өлтіремін.
Dialogue: 0,0:06:51.44,0:06:56.25,Default,,0000,0000,0000,,Қиналма
Dialogue: 0,0:06:51.44,0:06:56.25,Default,,0000,0000,0000,,Мен сенің жаныңда мәңгі болуым үшін.
Dialogue: 0,0:07:00.45,0:07:02.46,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:07:05.29,0:07:09.63,Default,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:07:05.29,0:07:09.63,Default,,0000,0000,0000,,Сіздің бұйрық. сакура.
Dialogue: 0,0:07:09.63,0:07:13.53,Default,,0000,0000,0000,,Ширу Эмиияны қандай жағдай болса да қорғаңыз.
Dialogue: 0,0:07:15.47,0:07:18.47,Default,,0000,0000,0000,,Сен жаман баласың, Шабандоз.
Dialogue: 0,0:07:22.14,0:07:27.98,Default,,0000,0000,0000,,Сакура Онда барма.
Dialogue: 0,0:07:22.14,0:07:27.98,Default,,0000,0000,0000,,Онда ештеңе жоқ.
Dialogue: 0,0:07:27.98,0:07:33.15,Default,,0000,0000,0000,,Қараңғы және жалғыз.
Dialogue: 0,0:07:33.15,0:07:37.66,Default,,0000,0000,0000,,Мен сені қалаймын
Dialogue: 0,0:07:33.15,0:07:37.66,Default,,0000,0000,0000,,Олай етпеу үшін.
Dialogue: 0,0:07:41.66,0:07:43.66,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:07:48.60,0:07:50.60,Default,,0000,0000,0000,,Гах... Кук.
Dialogue: 0,0:07:56.11,0:08:00.45,Default,,0000,0000,0000,,Сакура….
Dialogue: 0,0:08:00.45,0:08:03.28,Default,,0000,0000,0000,,Гах… Вау….
Dialogue: 0,0:08:03.28,0:08:07.09,Default,,0000,0000,0000,,Сіздің рөліңіз осы жерде аяқталады.
Dialogue: 0,0:08:12.96,0:08:17.96,Default,,0000,0000,0000,,Шабандоз Мен сені кіргіземін.
Dialogue: 0,0:08:12.96,0:08:17.96,Default,,0000,0000,0000,,Уф... жоқ.
Dialogue: 0,0:08:17.96,0:08:22.97,Default,,0000,0000,0000,,Маған артық қажет емес.
Dialogue: 0,0:08:17.96,0:08:22.97,Default,,0000,0000,0000,,Мен оны арнайы Сабермен бірдей етіп жасаймын.
Dialogue: 0,0:08:28.14,0:08:32.14,Default,,0000,0000,0000,,Міне, Сакура.
Dialogue: 0,0:08:32.14,0:08:35.15,Default,,0000,0000,0000,,Мен сенімен бірге барамын.
Dialogue: 0,0:08:35.15,0:08:37.15,Default,,0000,0000,0000,,Илья!
Dialogue: 0,0:08:37.15,0:08:39.99,Default,,0000,0000,0000,,​​Есіңіз дұрыс па?
Dialogue: 0,0:08:39.99,0:08:43.26,Default,,0000,0000,0000,,Өлтірілсе де
Dialogue: 0,0:08:39.99,0:08:43.26,Default,,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:08:43.26,0:08:49.46,Default,,0000,0000,0000,,Қарсылық жасаудың пайдасы жоқ.
Dialogue: 0,0:08:43.26,0:08:49.46,Default,,0000,0000,0000,,Мұндағы ең күшті шие гүлдері.
Dialogue: 0,0:08:51.60,0:08:55.60,Default,,0000,0000,0000,,Мен… ең….
Dialogue: 0,0:09:00.77,0:09:04.61,Default,,0000,0000,0000,,Соңғы кілт мұнда жоқ.
Dialogue: 0,0:09:04.61,0:09:08.11,Default,,0000,0000,0000,,Сакура мұрагер ретінде
Dialogue: 0,0:09:04.61,0:09:08.11,Default,,0000,0000,0000,,Қақпаны ашқыңыз келсе➡
Dialogue: 0,0:09:08.11,0:09:11.32,Default,,0000,0000,0000,,Оны алу үшін мен сарайыма баруым керек.
Dialogue: 0,0:09:13.29,0:09:17.79,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:09:13.29,0:09:17.79,Default,,0000,0000,0000,,Мен сіздің мүмкіндігіңізді пайдаланамын.
Dialogue: 0,0:09:23.30,0:09:26.10,Default,,0000,0000,0000,,Ух... уф....
Dialogue: 0,0:09:28.13,0:09:35.98,Default,,0000,0000,0000,,Өтінемін, енді менің алдыма келме.
Dialogue: 0,0:09:28.13,0:09:35.98,Default,,0000,0000,0000,,Одан кейін оларды өлтіруден басқа амалыңыз қалмайды.
Dialogue: 0,0:09:35.98,0:09:38.14,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:09:38.14,0:09:44.65,Default,,0000,0000,0000,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:09:38.14,0:09:44.65,Default,,0000,0000,0000,,Осы уақытқа дейін қызық болды, ағайын.
Dialogue: 0,0:09:44.65,0:09:46.65,Default,,0000,0000,0000,,Кейін қалсаң, капитан мені сөгіп тастайды.
Dialogue: 0,0:09:49.16,0:09:58.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:09:58.00,0:10:00.17,Default,,0000,0000,0000,,Кет, Сабер.
Dialogue: 0,0:10:00.17,0:10:03.17,Default,,0000,0000,0000,,Енді не істей аласыз?
Dialogue: 0,0:10:03.17,0:10:07.34,Default,,0000,0000,0000,,Кез келген нысанда
Dialogue: 0,0:10:03.17,0:10:07.34,Default,,0000,0000,0000,,Сакура Қасиетті Граалды алады.
Dialogue: 0,0:10:07.34,0:10:10.68,Default,,0000,0000,0000,,Нәтиже
Dialogue: 0,0:10:07.34,0:10:10.68,Default,,0000,0000,0000,,Тіпті оның өлімі болса да➡
Dialogue: 0,0:10:10.68,0:10:14.08,Default,,0000,0000,0000,,Осылайша Сакура Мату құтқарылды.
Dialogue: 0,0:10:16.18,0:10:18.35,Default,,0000,0000,0000,,Соңғы кеңес.
Dialogue: 0,0:10:18.35,0:10:22.19,Default,,0000,0000,0000,,Егер сіз әлі де мені қуып жүрсеңіз
Dialogue: 0,0:10:18.35,0:10:22.19,Default,,0000,0000,0000,,Бұл уақыт➡
Dialogue: 0,0:10:22.19,0:10:24.69,Default,,0000,0000,0000,,Оның басын ұрып тастаңыз.
Dialogue: 0,0:10:40.04,0:10:42.31,Default,,0000,0000,0000,,Жақсы… Жақсы….
Dialogue: 0,0:10:42.31,0:10:44.31,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:10:47.98,0:10:49.98,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:10:51.98,0:10:55.09,Default,,0000,0000,0000,,《Кирей: Жеңіс немесе жеңіліс әлдеқашан шешілді》
Dialogue: 0,0:10:59.66,0:11:04.66,Default,,0000,0000,0000,,《Жоқ, мұндай нәрсе
Dialogue: 0,0:10:59.66,0:11:04.66,Default,,0000,0000,0000,,Ол бұрыннан болған.
Dialogue: 0,0:11:04.66,0:11:10.84,Default,,0000,0000,0000,,Бұрмаланған Қасиетті Граил соғысы.
Dialogue: 0,0:11:04.66,0:11:10.84,Default,,0000,0000,0000,,Қасиетті Граил бастапқыда бір.
Dialogue: 0,0:11:10.84,0:11:16.01,Default,,0000,0000,0000,,Бірақ екінші Қасиетті Граил
Dialogue: 0,0:11:10.84,0:11:16.01,Default,,0000,0000,0000,,Бұл жерде болды.
Dialogue: 0,0:11:16.01,0:11:24.35,Default,,0000,0000,0000,,Ал ыдыс Қасиетті Граильге бейімделген.
Dialogue: 0,0:11:16.01,0:11:24.35,Default,,0000,0000,0000,,Оның мазмұны қандай?
Dialogue: 0,0:11:24.35,0:11:26.69,Default,,0000,0000,0000,,Егер ыдыс жарамсыз болса➡
Dialogue: 0,0:11:26.69,0:11:30.69,Default,,0000,0000,0000,,Жай көбейту
Dialogue: 0,0:11:26.69,0:11:30.69,Default,,0000,0000,0000,,Бір кесек етке айналар еді.
Dialogue: 0,0:11:30.69,0:11:33.86,Default,,0000,0000,0000,,Сахна қойылды.
Dialogue: 0,0:11:33.86,0:11:39.37,Default,,0000,0000,0000,,Жауап бере алатын заттар
Dialogue: 0,0:11:33.86,0:11:39.37,Default,,0000,0000,0000,,Оның туылуы жақын》
Dialogue: 0,0:11:41.97,0:11:47.31,Default,,0000,0000,0000,,《Аудиториядан көрінбейтін нәрсе
Dialogue: 0,0:11:41.97,0:11:47.31,Default,,0000,0000,0000,,➡ болса
Dialogue: 0,0:11:47.31,0:11:53.11,Default,,0000,0000,0000,,Мен де сахнаға шықтым делік.
Dialogue: 0,0:11:58.65,0:12:00.65,Default,,0000,0000,0000,,Котомине….
Dialogue: 0,0:12:00.65,0:12:03.86,Default,,0000,0000,0000,,Тохсака... өтінемін.
Dialogue: 0,0:12:06.83,0:12:10.33,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:12:10.33,0:12:23.54,Default,,0000,0000,0000,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:12:26.18,0:12:33.35,Default,,0000,0000,0000,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:12:33.35,0:12:43.86,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:12:54.64,0:12:57.14,Default,,0000,0000,0000,,А... у...
Dialogue: 0,0:12:57.14,0:13:02.82,Default,,0000,0000,0000,,Сіз ояндыңыз ба? Менің денем қозғалады ма?
Dialogue: 0,0:12:57.14,0:13:02.82,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:02.82,0:13:05.82,Default,,0000,0000,0000,,Котомине….
Dialogue: 0,0:13:05.82,0:13:08.02,Default,,0000,0000,0000,,Тохсака!
Dialogue: 0,0:13:09.99,0:13:13.66,Default,,0000,0000,0000,,Сізден де жаман
Dialogue: 0,0:13:09.99,0:13:13.66,Default,,0000,0000,0000,,Өйткені ол әлсіз болды.
Dialogue: 0,0:13:13.66,0:13:17.66,Default,,0000,0000,0000,,Мен оны Тохсақаның бақшасына жерледім.
Dialogue: 0,0:13:17.66,0:13:20.83,Default,,0000,0000,0000,,Иә? Толтырыңыз...?
Dialogue: 0,0:13:20.83,0:13:25.34,Default,,0000,0000,0000,,Ертең таңертең
Dialogue: 0,0:13:20.83,0:13:25.34,Default,,0000,0000,0000,,Аузыңды кемітпей қайта аласың.
Dialogue: 0,0:13:25.34,0:13:28.34,Default,,0000,0000,0000,,жақсы.
Dialogue: 0,0:13:28.34,0:13:33.01,Default,,0000,0000,0000,,Көмегің үшін рахмет. Мен қазір кетуім керек.
Dialogue: 0,0:13:33.01,0:13:35.82,Default,,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:13:38.35,0:13:44.29,Default,,0000,0000,0000,,Ілияс бізді қорғайды
Dialogue: 0,0:13:38.35,0:13:44.29,Default,,0000,0000,0000,,Сакурамен бірге. сондықтан….
Dialogue: 0,0:13:44.29,0:13:49.09,Default,,0000,0000,0000,,Сакура Мату жауға айналды.
Dialogue: 0,0:13:44.29,0:13:49.09,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:13:58.97,0:14:01.27,Default,,0000,0000,0000,,Менің артымнан жүр.
Dialogue: 0,0:14:04.14,0:14:07.15,Default,,0000,0000,0000,,Мату Зукеннің мақсаты➡
Dialogue: 0,0:14:07.15,0:14:12.32,Default,,0000,0000,0000,,Бос Мату шие ағашына
Dialogue: 0,0:14:07.15,0:14:12.32,Default,,0000,0000,0000,,Ол тасымалдануы мүмкін.
Dialogue: 0,0:14:07.15,0:14:12.32,Default,,0000,0000,0000,,Дұрыс, болды!
Dialogue: 0,0:14:12.32,0:14:18.32,Default,,0000,0000,0000,,Сондықтан Ильясвиелді қайтарып алыңыз
Dialogue: 0,0:14:12.32,0:14:18.32,Default,,0000,0000,0000,,Мату Сакура бос болғанға дейін➡
Dialogue: 0,0:14:18.32,0:14:20.83,Default,,0000,0000,0000,,Зоукен Матуды жеңіңіз.
Dialogue: 0,0:14:20.83,0:14:25.83,Default,,0000,0000,0000,,Әзірге
Dialogue: 0,0:14:20.83,0:14:25.83,Default,,0000,0000,0000,,Сіздің және менің мақсаттарым бір.
Dialogue: 0,0:14:25.83,0:14:28.33,Default,,0000,0000,0000,,Мақсат...
Dialogue: 0,0:14:34.67,0:14:39.08,Default,,0000,0000,0000,,Ынтымақтастық жасайтынын айтады.
Dialogue: 0,0:14:44.78,0:14:47.79,Default,,0000,0000,0000,,А, дұрыс, Шабандоз.
Dialogue: 0,0:14:47.79,0:14:53.13,Default,,0000,0000,0000,,Тоқта, сенде әлі рұқсат жоқ.
Dialogue: 0,0:14:47.79,0:14:53.13,Default,,0000,0000,0000,,Қосылған болуы мүмкін.
Dialogue: 0,0:14:53.13,0:14:57.53,Default,,0000,0000,0000,,Қамалға жақындамас бұрын
Dialogue: 0,0:14:53.13,0:14:57.53,Default,,0000,0000,0000,,Байқамау мүмкін емес.
Dialogue: 0,0:15:11.64,0:15:15.65,Default,,0000,0000,0000,,📻Кеше түнде Фуюки қаласында болды.
Dialogue: 0,0:15:11.64,0:15:15.65,Default,,0000,0000,0000,,Хабар-ошарсыз кеткендер туралы істер бойынша➡
Dialogue: 0,0:15:15.65,0:15:20.32,Default,,0000,0000,0000,,Құрбандардың саны мен себептері белгісіз.
Dialogue: 0,0:15:15.65,0:15:20.32,Default,,0000,0000,0000,,Қазіргі уақытта тергеу жүріп жатыр.
Dialogue: 0,0:15:20.32,0:15:23.16,Default,,0000,0000,0000,,📻Сонымен қатар бір уақытта
Dialogue: 0,0:15:20.32,0:15:23.16,Default,,0000,0000,0000,,Синто стансасының алдындағы ауданда➡
Dialogue: 0,0:15:23.16,0:15:25.16,Default,,0000,0000,0000,,бірнеше сағат ішінде
Dialogue: 0,0:15:23.16,0:15:25.16,Default,,0000,0000,0000,,Үлкен көлемде электр қуатының үзілуі орын алды...
Dialogue: 0,0:15:25.16,0:15:32.06,Default,,0000,0000,0000,,Оған дейін адам осылай болады
Dialogue: 0,0:15:25.16,0:15:32.06,Default,,0000,0000,0000,,Ол Сакура Матуды өлтіретін еді.
Dialogue: 0,0:15:35.17,0:15:38.84,Default,,0000,0000,0000,,Сенің әкең
Dialogue: 0,0:15:35.17,0:15:38.84,Default,,0000,0000,0000,,Әділдік үшін➡
Dialogue: 0,0:15:38.84,0:15:42.94,Default,,0000,0000,0000,,Адамның сезімдері
Dialogue: 0,0:15:38.84,0:15:42.94,Default,,0000,0000,0000,,Ол кесілген адам еді.
Dialogue: 0,0:15:42.94,0:15:48.28,Default,,0000,0000,0000,,Кирицугу Эмиияның өмір жолы
Dialogue: 0,0:15:42.94,0:15:48.28,Default,,0000,0000,0000,,Бұл мен үшін жағымсыз болды.
Dialogue: 0,0:15:48.28,0:15:52.12,Default,,0000,0000,0000,,Басынан бастап не болды
Dialogue: 0,0:15:48.28,0:15:52.12,Default,,0000,0000,0000,,Қысқарту➡
Dialogue: 0,0:15:52.12,0:15:55.96,Default,,0000,0000,0000,,Менде қысқарту керек нәрсе бар
Dialogue: 0,0:15:52.12,0:15:55.96,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:15:55.96,0:16:01.63,Default,,0000,0000,0000,,Нәтиже бірдей болғанымен
Dialogue: 0,0:15:55.96,0:16:01.63,Default,,0000,0000,0000,,Процесс басқаша болды.
Dialogue: 0,0:16:01.63,0:16:05.80,Default,,0000,0000,0000,,Бұл айырмашылық шешуші болды.
Dialogue: 0,0:16:05.80,0:16:09.64,Default,,0000,0000,0000,,Егер сіз оны кесіп тастасаңыз
Dialogue: 0,0:16:05.80,0:16:09.64,Default,,0000,0000,0000,,Басынан бастап болуы керек.
Dialogue: 0,0:16:09.64,0:16:13.31,Default,,0000,0000,0000,,Бірақ ол ұстай берді.
Dialogue: 0,0:16:13.31,0:16:17.64,Default,,0000,0000,0000,,Кесілгеннен кейін де жиналады.
Dialogue: 0,0:16:17.64,0:16:22.15,Default,,0000,0000,0000,,Мүлде жоқ. Ол бақытты адам.
Dialogue: 0,0:16:22.15,0:16:26.49,Default,,0000,0000,0000,,Кирицугу бақытты...?
Dialogue: 0,0:16:26.49,0:16:30.16,Default,,0000,0000,0000,,Өзіңді сүй, жақыныңды сүй➡
Dialogue: 0,0:16:30.16,0:16:37.16,Default,,0000,0000,0000,,Күнәні кешір, жазасын мойында
Dialogue: 0,0:16:30.16,0:16:37.16,Default,,0000,0000,0000,,Салауатты өмір сүруге тәрбиелеу... Әй.
Dialogue: 0,0:16:37.16,0:16:43.94,Default,,0000,0000,0000,,Бақыт деп атайтын нәрсе емес
Dialogue: 0,0:16:37.16,0:16:43.94,Default,,0000,0000,0000,,Бұл маған қуаныш сыйламады.
Dialogue: 0,0:16:43.94,0:16:46.44,Default,,0000,0000,0000,,Барлығы осы.
Dialogue: 0,0:16:52.44,0:16:57.12,Default,,0000,0000,0000,,Неліктен бұл уақыт?
Dialogue: 0,0:16:52.44,0:16:57.12,Default,,0000,0000,0000,,Сакураға көмектестің бе?
Dialogue: 0,0:16:57.12,0:16:59.45,Default,,0000,0000,0000,,Адамдар өледі.
Dialogue: 0,0:16:59.45,0:17:02.96,Default,,0000,0000,0000,,Жалғыз ол өліп жатса➡
Dialogue: 0,0:17:02.96,0:17:07.46,Default,,0000,0000,0000,,Мен де сол жердемін
Dialogue: 0,0:17:02.96,0:17:07.46,Default,,0000,0000,0000,,Мен барынша тырыспадым.
Dialogue: 0,0:17:07.46,0:17:14.80,Default,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:17:07.46,0:17:14.80,Default,,0000,0000,0000,,Мен Сакура Матудың құрсағындамын
Dialogue: 0,0:17:07.46,0:17:14.80,Default,,0000,0000,0000,,Қараңғылықтың туған күнін тойлау.
Dialogue: 0,0:17:14.80,0:17:20.31,Default,,0000,0000,0000,,Сол көлеңке?
Dialogue: 0,0:17:14.80,0:17:20.31,Default,,0000,0000,0000,,Бұл нәрсе адамдарды өлтіреді.
Dialogue: 0,0:17:20.31,0:17:25.48,Default,,0000,0000,0000,,Бірақ ол әлі туылған жоқ.
Dialogue: 0,0:17:20.31,0:17:25.48,Default,,0000,0000,0000,,Егер туғаннан кейін➡
Dialogue: 0,0:17:25.48,0:17:28.65,Default,,0000,0000,0000,,Қылмыс пен жаза
Dialogue: 0,0:17:25.48,0:17:28.65,Default,,0000,0000,0000,,Беру керек➡
Dialogue: 0,0:17:28.65,0:17:31.98,Default,,0000,0000,0000,,«Босанба» деп айта алмайсың.
Dialogue: 0,0:17:31.98,0:17:37.49,Default,,0000,0000,0000,,Әлде қылмыскердің баласы ма?
Dialogue: 0,0:17:31.98,0:17:37.49,Default,,0000,0000,0000,,Сіз туылмай тұрып-ақ қылмыскерсіз бе?
Dialogue: 0,0:17:37.49,0:17:43.00,Default,,0000,0000,0000,,Сондықтан сені өлтіруімді қалайсың ба?
Dialogue: 0,0:17:37.49,0:17:43.00,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:17:48.10,0:17:51.94,Default,,0000,0000,0000,,Мен де бір нәрсе сұрайын.
Dialogue: 0,0:17:51.94,0:17:53.94,Default,,0000,0000,0000,,Сакура Мату.
Dialogue: 0,0:17:53.94,0:17:59.45,Default,,0000,0000,0000,,Ол қазірдің өзінде «каннибал»
Dialogue: 0,0:17:53.94,0:17:59.45,Default,,0000,0000,0000,,Ешқандай айырмашылық жоқ.
Dialogue: 0,0:17:59.45,0:18:04.45,Default,,0000,0000,0000,,Әлі де сен
Dialogue: 0,0:17:59.45,0:18:04.45,Default,,0000,0000,0000,,Қорғау?
Dialogue: 0,0:18:10.29,0:18:14.29,Default,,0000,0000,0000,,Ол көптеген адамдарды өлтірді.
Dialogue: 0,0:18:14.29,0:18:18.63,Default,,0000,0000,0000,,Мен осындаймын
Dialogue: 0,0:18:14.29,0:18:18.63,Default,,0000,0000,0000,,Менің ойымша, бұл қолайлы емес.
Dialogue: 0,0:18:18.63,0:18:23.64,Default,,0000,0000,0000,,Ондай жағдайда оны өлтірген дұрыс.
Dialogue: 0,0:18:18.63,0:18:23.64,Default,,0000,0000,0000,,Сіз бақытты емессіз бе?
Dialogue: 0,0:18:23.64,0:18:27.84,Default,,0000,0000,0000,,Тоналғандарға
Dialogue: 0,0:18:23.64,0:18:27.84,Default,,0000,0000,0000,,Бұл да қылмыс болып табылады.
Dialogue: 0,0:18:30.14,0:18:37.48,Default,,0000,0000,0000,,Бірақ... бұл өтеу емес.
Dialogue: 0,0:18:30.14,0:18:37.48,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:18:37.48,0:18:42.99,Default,,0000,0000,0000,,Кирицугу Эмиияның іздері
Dialogue: 0,0:18:37.48,0:18:42.99,Default,,0000,0000,0000,,Бұл сабақтастық жоқ дегенді білдіреді.
Dialogue: 0,0:18:53.10,0:19:15.12,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:15.12,0:19:17.12,Default,,0000,0000,0000,,Оны қарастырайық.
Dialogue: 0,0:19:23.63,0:19:27.30,Default,,0000,0000,0000,,Сәйкестендіру… Бастау.
Dialogue: 0,0:19:27.30,0:19:31.30,Default,,0000,0000,0000,,Негізгі жоспар… Түсіндіру.
Dialogue: 0,0:19:31.30,0:19:34.81,Default,,0000,0000,0000,,Құрылысты түсіндіру материалдары.
Dialogue: 0,0:19:37.98,0:19:40.31,Default,,0000,0000,0000,,Үшінші қабатта...
Dialogue: 0,0:19:40.31,0:19:43.52,Default,,0000,0000,0000,,Сол жақтағы бөлме….
Dialogue: 0,0:19:45.98,0:19:48.09,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:19:50.16,0:19:53.49,Default,,0000,0000,0000,,Сакура….
Dialogue: 0,0:19:53.49,0:19:55.83,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:19:55.83,0:20:03.34,Default,,0000,0000,0000,,Өз басымдықтарыңызды қате қабылдамаңыз.
Dialogue: 0,0:19:55.83,0:20:03.34,Default,,0000,0000,0000,,Мен білемін.
Dialogue: 0,0:20:03.34,0:20:07.01,Default,,0000,0000,0000,,Со Ширу Эмия.
Dialogue: 0,0:20:07.01,0:20:10.51,Default,,0000,0000,0000,,Тауға өрмелеуден тәжірибеңіз бар ма?
Dialogue: 0,0:20:17.85,0:20:22.19,Default,,0000,0000,0000,,Шынымен сол адамдар үшін
Dialogue: 0,0:20:17.85,0:20:22.19,Default,,0000,0000,0000,,Сіз салтанатты киім дайындайсыз ба?
Dialogue: 0,0:20:22.19,0:20:29.70,Default,,0000,0000,0000,,Сіз ұмыттыңыз ба? біздің рөліміз
Dialogue: 0,0:20:22.19,0:20:29.70,Default,,0000,0000,0000,,Қасиетті Граильді аяқтау.
Dialogue: 0,0:20:29.70,0:20:34.70,Default,,0000,0000,0000,,Егер ыдыс жарамды болса
Dialogue: 0,0:20:29.70,0:20:34.70,Default,,0000,0000,0000,,Мен болмасам, бәрібір.
Dialogue: 0,0:21:02.16,0:21:04.16,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:04.16,0:21:06.67,Default,,0000,0000,0000,,(Терезе әйнегі сынған дыбыс)
Dialogue: 0,0:21:06.67,0:21:09.50,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:21:09.50,0:21:14.84,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,0:21:09.50,0:21:14.84,Default,,0000,0000,0000,,Терезеге лақтыратын нәрсе бар ма?
Dialogue: 0,0:21:14.84,0:21:17.18,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:21:17.18,0:21:23.68,Default,,0000,0000,0000,,Бір қолымен қабырғаға жабысқан фигура
Dialogue: 0,0:21:17.18,0:21:23.68,Default,,0000,0000,0000,,Бұл өте аянышты болды.
Dialogue: 0,0:21:23.68,0:21:27.19,Default,,0000,0000,0000,,Балалар, сендерге не болды?
Dialogue: 0,0:21:23.68,0:21:27.19,Default,,0000,0000,0000,,A habitual person.
Dialogue: 0,0:21:27.19,0:21:30.52,Default,,0000,0000,0000,,Oh no... no we...
Dialogue: 0,0:21:30.52,0:21:32.86,Default,,0000,0000,0000,,Shirou.
Dialogue: 0,0:21:32.86,0:21:34.86,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:36.86,0:21:39.87,Default,,0000,0000,0000,,Илья….
Dialogue: 0,0:21:36.86,0:21:39.87,Default,,0000,0000,0000,,Why did you come?
Dialogue: 0,0:21:39.87,0:21:42.13,Default,,0000,0000,0000,,Go home.
Dialogue: 0,0:21:42.13,0:21:45.97,Default,,0000,0000,0000,,Енді сіздің кезегіңіз емес.
Dialogue: 0,0:21:45.97,0:21:50.14,Default,,0000,0000,0000,,Сакураны маған қалдыра аласыз.
Dialogue: 0,0:21:50.14,0:21:54.85,Default,,0000,0000,0000,,This is my role.
Dialogue: 0,0:21:56.82,0:21:59.12,Default,,0000,0000,0000,,Бақайырия.
Dialogue: 0,0:22:05.66,0:22:10.36,Default,,0000,0000,0000,,Негізгісі – ой.
Dialogue: 0,0:22:05.66,0:22:10.36,Default,,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:22:13.00,0:22:15.50,Default,,0000,0000,0000,,Ильяның рөлі қандай екенін білмеймін!
Dialogue: 0,0:22:15.50,0:22:20.01,Default,,0000,0000,0000,,Ілияс қаншалықты күшті болды?
Dialogue: 0,0:22:15.50,0:22:20.01,Default,,0000,0000,0000,,Қаншалықты жақсы болып көрінсең де➡
Dialogue: 0,0:22:20.01,0:22:23.18,Default,,0000,0000,0000,,Мен алдау үшін ештеңе істемеймін.
Dialogue: 0,0:22:20.01,0:22:23.18,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:22:23.18,0:22:26.85,Default,,0000,0000,0000,,Мықты болу дегенді қалай түсінесіңдер?
Dialogue: 0,0:22:23.18,0:22:26.85,Default,,0000,0000,0000,,Өйткені мен Қасиетті Граилмын...
Dialogue: 0,0:22:26.85,0:22:28.85,Default,,0000,0000,0000,,Сонымен, сен сол аралда не істеп жүрдің?
Dialogue: 0,0:22:26.85,0:22:28.85,Default,,0000,0000,0000,,Мықты болайын деп тұрсың, ақымақ!
Dialogue: 0,0:22:28.85,0:22:32.18,Default,,0000,0000,0000,,Illya is Illya!
Dialogue: 0,0:22:32.18,0:22:37.02,Default,,0000,0000,0000,,Өзіңнен басқа нәрсе үшін
Dialogue: 0,0:22:32.18,0:22:37.02,Default,,0000,0000,0000,,Өзіңді құрбан етпе!
Dialogue: 0,0:22:37.02,0:22:41.63,Default,,0000,0000,0000,,Хм... сөреге қой...
Dialogue: 0,0:22:51.47,0:22:53.97,Default,,0000,0000,0000,,Elijah.
Dialogue: 0,0:22:58.31,0:23:03.52,Default,,0000,0000,0000,,《Like this...
Dialogue: 0,0:22:58.31,0:23:03.52,Default,,0000,0000,0000,,Оның жұмыс істеуге мүмкіндігі жоқ.
Dialogue: 0,0:23:06.82,0:23:09.99,Default,,0000,0000,0000,,Cat.
Dialogue: 0,0:23:06.82,0:23:09.99,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:23:09.99,0:23:14.16,Default,,0000,0000,0000,,Бір сәтке босатыңыз.
Dialogue: 0,0:23:09.99,0:23:14.16,Default,,0000,0000,0000,,А, бірақ...
Dialogue: 0,0:23:14.16,0:23:21.07,Default,,0000,0000,0000,,Бұл біздің сарай. Уайымдама.
Dialogue: 0,0:23:14.16,0:23:21.07,Default,,0000,0000,0000,,Ілиясқа қамқор бол.
Dialogue: 0,0:23:27.17,0:23:30.84,Default,,0000,0000,0000,,Oooh… oh….
Dialogue: 0,0:23:27.17,0:23:30.84,Default,,0000,0000,0000,,Ширу?
Dialogue: 0,0:23:30.84,0:23:36.35,Default,,0000,0000,0000,,Сол биіктіктен
Dialogue: 0,0:23:30.84,0:23:36.35,Default,,0000,0000,0000,,Сиқырсыз құлау қорқынышты.
Dialogue: 0,0:23:36.35,0:23:40.02,Default,,0000,0000,0000,,Is it bad?
Dialogue: 0,0:23:36.35,0:23:40.02,Default,,0000,0000,0000,,Too bad!
Dialogue: 0,0:23:40.02,0:23:45.29,Default,,0000,0000,0000,,Мен мұны істей аламын деп ойладым... Иә?
Dialogue: 0,0:23:45.29,0:23:48.09,Default,,0000,0000,0000,,Сізді Арчер тартып жатыр.
Dialogue: 0,0:23:54.30,0:23:56.64,Default,,0000,0000,0000,,So you came.
Dialogue: 0,0:23:56.64,0:23:58.64,Default,,0000,0000,0000,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,0:23:58.64,0:24:08.81,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:08.81,0:24:10.82,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:24:10.82,0:24:14.99,Default,,0000,0000,0000,,(Берсеркердің айқайы)
Dialogue: 0,0:24:14.99,0:24:17.32,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:24:14.99,0:24:17.32,Default,,0000,0000,0000,,Дұрыс, болды!
Dialogue: 0,0:24:17.32,0:24:20.13,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:24:17.32,0:24:20.13,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:24:25.00,0:24:27.00,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:24:27.00,0:24:29.50,Default,,0000,0000,0000,,Ха ха ха... тез!
Dialogue: 0,0:24:29.50,0:24:31.50,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:24:31.50,0:24:33.51,Default,,0000,0000,0000,,If this.
Dialogue: 0,0:24:35.51,0:24:38.51,Default,,0000,0000,0000,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:24:38.51,0:24:42.11,Default,,0000,0000,0000,,Берсеркер….
Dialogue: 0,0:24:38.51,0:24:42.11,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:24:45.78,0:24:47.79,Default,,0000,0000,0000,,Кукуку.
Dialogue: 0,0:24:54.46,0:24:57.46,Default,,0000,0000,0000,,Қамқорлық!
Dialogue: 0,0:24:57.46,0:24:59.46,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:24:59.46,0:25:16.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:25:16.98,0:25:18.98,Default,,0000,0000,0000,,Шықыр!
Dialogue: 0,0:25:26.32,0:25:30.33,Default,,0000,0000,0000,,А... бұл жай қуыршақ емес
Dialogue: 0,0:25:26.32,0:25:30.33,Default,,0000,0000,0000,,Бұл дегеніміз?
Dialogue: 0,0:25:30.33,0:25:32.63,Default,,0000,0000,0000,,Hmph….
Dialogue: 0,0:25:35.83,0:25:38.64,Default,,0000,0000,0000,,Мені ал.
Dialogue: 0,0:25:35.83,0:25:38.64,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:25:40.84,0:25:45.78,Default,,0000,0000,0000,,Эмия
Dialogue: 0,0:25:40.84,0:25:45.78,Default,,0000,0000,0000,,Егер сіз құтқарған адам әйел болса, оны өлтірмеңіз.
Dialogue: 0,0:25:45.78,0:25:51.58,Default,,0000,0000,0000,,Менің алдымда кім өлуі мүмкін?
Dialogue: 0,0:25:45.78,0:25:51.58,Default,,0000,0000,0000,,Бұл өте жақсы жауап.
Dialogue: 0,0:25:54.95,0:25:56.96,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:25:54.95,0:25:56.96,Default,,0000,0000,0000,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:25:56.96,0:25:59.56,Default,,0000,0000,0000,,Кеттік, Илья.
Dialogue: 0,0:25:56.96,0:25:59.56,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:26:08.63,0:26:11.47,Default,,0000,0000,0000,,Ақ дәрет қашып құтылмайды.
Dialogue: 0,0:26:11.47,0:26:17.31,Default,,0000,0000,0000,,Мен де
Dialogue: 0,0:26:11.47,0:26:17.31,Default,,0000,0000,0000,,Өйткені менің орындағым келетін тілегім бар.
Dialogue: 0,0:26:17.31,0:26:19.31,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:26:23.98,0:26:26.32,Default,,0000,0000,0000,,Қарғыс атсын... ха ха….
Dialogue: 0,0:26:26.32,0:26:29.65,Default,,0000,0000,0000,,Маған қарап тұрсың ба?
Dialogue: 0,0:26:29.65,0:26:37.06,Default,,0000,0000,0000,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:26:40.17,0:26:42.10,Default,,0000,0000,0000,,Ширу.
Dialogue: 0,0:26:42.10,0:26:44.10,Default,,0000,0000,0000,,Мені тастап қашып кет.
Dialogue: 0,0:26:44.10,0:26:46.10,Default,,0000,0000,0000,,Сонымен... мүмкін...
Dialogue: 0,0:26:59.95,0:27:01.95,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:27:05.62,0:27:11.03,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:27:15.97,0:27:19.47,Default,,0000,0000,0000,,Бұл айтарлықтай көрсеткіш.
Dialogue: 0,0:27:15.97,0:27:19.47,Default,,0000,0000,0000,,Кирей.
Dialogue: 0,0:27:19.47,0:27:23.14,Default,,0000,0000,0000,,Мату Зукен.
Dialogue: 0,0:27:23.14,0:27:28.81,Default,,0000,0000,0000,,Леви… бұл сенің кінәң.
Dialogue: 0,0:27:23.14,0:27:28.81,Default,,0000,0000,0000,,Сіз мұнда келдіңіз бе?
Dialogue: 0,0:27:28.81,0:27:35.52,Default,,0000,0000,0000,,Бұл перде.
Dialogue: 0,0:27:28.81,0:27:35.52,Default,,0000,0000,0000,,Маған мейірімділік таныт. Ассасин.
Dialogue: 0,0:27:43.60,0:27:47.10,Default,,0000,0000,0000,,《Кирей: Қазір есімде
Dialogue: 0,0:27:43.60,0:27:47.10,Default,,0000,0000,0000,,Бұл маңызды емес➡
Dialogue: 0,0:27:47.10,0:27:51.10,Default,,0000,0000,0000,,Мен тудым
Dialogue: 0,0:27:47.10,0:27:51.10,Default,,0000,0000,0000,,Ақаулы.
Dialogue: 0,0:27:51.10,0:27:54.77,Default,,0000,0000,0000,,Мен үшін
Dialogue: 0,0:27:51.10,0:27:54.77,Default,,0000,0000,0000,,Бақыт – қасірет➡
Dialogue: 0,0:27:54.77,0:27:58.11,Default,,0000,0000,0000,,Үмітсіздік қуаныш болды.
Dialogue: 0,0:27:58.11,0:28:01.45,Default,,0000,0000,0000,,Менің жеке болмысым➡
Dialogue: 0,0:28:01.45,0:28:05.45,Default,,0000,0000,0000,,Тірі зат ретінде бұл жаман нәрсе.
Dialogue: 0,0:28:01.45,0:28:05.45,Default,,0000,0000,0000,,Түсінді.
Dialogue: 0,0:28:05.45,0:28:08.95,Default,,0000,0000,0000,,Қорқынышты кемшілік.
Dialogue: 0,0:28:08.95,0:28:14.29,Default,,0000,0000,0000,,Шетелдік болсаңыз да
Dialogue: 0,0:28:08.95,0:28:14.29,Default,,0000,0000,0000,,Оның парасаттылығы болды.
Dialogue: 0,0:28:14.29,0:28:19.13,Default,,0000,0000,0000,,Мен қалап, түзетуге тырыстым.
Dialogue: 0,0:28:19.13,0:28:25.30,Default,,0000,0000,0000,,Соңғы әрекетте
Dialogue: 0,0:28:19.13,0:28:25.30,Default,,0000,0000,0000,,Әйелді жақсы көрдім》
Dialogue: 0,0:28:25.30,0:28:33.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:28:33.98,0:28:38.15,Default,,0000,0000,0000,,《Нақтырақ айтсақ
Dialogue: 0,0:28:33.98,0:28:38.15,Default,,0000,0000,0000,,Мен мұны істей алғым келеді➡
Dialogue: 0,0:28:38.15,0:28:41.65,Default,,0000,0000,0000,,Сүйуге тырыстым, балалы болдым.
Dialogue: 0,0:28:41.65,0:28:44.36,Default,,0000,0000,0000,,Нәтиже…》
Dialogue: 0,0:28:46.26,0:28:51.26,Default,,0000,0000,0000,,｟Кирей: Маған
Dialogue: 0,0:28:46.26,0:28:51.26,Default,,0000,0000,0000,,Мен сені сүйе алмадым.
Dialogue: 0,0:28:51.26,0:28:56.57,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:28:51.26,0:28:56.57,Default,,0000,0000,0000,,Сен мені сүйесің｠
Dialogue: 0,0:29:01.61,0:29:03.61,Default,,0000,0000,0000,,(пышақ сұққан дыбысы)
Dialogue: 0,0:29:05.61,0:29:07.61,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:29:09.61,0:29:12.78,Default,,0000,0000,0000,,Асыл фантасма.
Dialogue: 0,0:29:12.78,0:29:14.99,Default,,0000,0000,0000,,Забания!
Dialogue: 0,0:29:21.29,0:29:23.50,Default,,0000,0000,0000,,Бітті.
Dialogue: 0,0:29:25.63,0:29:28.97,Default,,0000,0000,0000,,Хэхе...
Dialogue: 0,0:29:28.97,0:29:30.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:29:30.97,0:29:33.64,Default,,0000,0000,0000,,Сіз! Мүмкін емес!
Dialogue: 0,0:29:33.64,0:29:36.04,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:29:33.64,0:29:36.04,Default,,0000,0000,0000,,Гаха!
Dialogue: 0,0:29:38.81,0:29:40.81,Default,,0000,0000,0000,,Gi…! ?
Dialogue: 0,0:29:40.81,0:29:42.81,Default,,0000,0000,0000,,Гах!
Dialogue: 0,0:29:45.98,0:29:47.99,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:29:49.99,0:29:52.99,Default,,0000,0000,0000,,О...! ?
Dialogue: 0,0:29:49.99,0:29:52.99,Default,,0000,0000,0000,,Айт.
Dialogue: 0,0:29:54.99,0:30:01.17,Default,,0000,0000,0000,,Мен сені өлтіремін. Мен оны пайдаланамын.
Dialogue: 0,0:29:54.99,0:30:01.17,Default,,0000,0000,0000,,Мен ауырдым және емделемін.
Dialogue: 0,0:30:01.17,0:30:05.00,Default,,0000,0000,0000,,Менің қолымнан құтыла алатындар
Dialogue: 0,0:30:01.17,0:30:05.00,Default,,0000,0000,0000,,Бір адам емес.
Dialogue: 0,0:30:05.00,0:30:09.17,Default,,0000,0000,0000,,Көз алдымнан асқан ешкім жоқ.
Dialogue: 0,0:30:05.00,0:30:09.17,Default,,0000,0000,0000,,Мен, сен, сен...
Dialogue: 0,0:30:09.17,0:30:11.18,Default,,0000,0000,0000,,Бүліну.
Dialogue: 0,0:30:11.18,0:30:15.01,Default,,0000,0000,0000,,Жеңілгенді Қарт шақырамын.
Dialogue: 0,0:30:15.01,0:30:19.52,Default,,0000,0000,0000,,Өзіңді маған сеніп, менен үйрен, артымнан ер.
Dialogue: 0,0:30:19.52,0:30:25.19,Default,,0000,0000,0000,,Демалу. Әнді ұмытпа
Dialogue: 0,0:30:19.52,0:30:25.19,Default,,0000,0000,0000,,Намаз оқуды ұмытпа, мені ұмытпа➡
Dialogue: 0,0:30:25.19,0:30:29.53,Default,,0000,0000,0000,,Мен жеңілмін
Dialogue: 0,0:30:25.19,0:30:29.53,Default,,0000,0000,0000,,Барлық салмақты ұмытады.
Dialogue: 0,0:30:29.53,0:30:32.36,Default,,0000,0000,0000,,Ал, қыранды өлтір!
Dialogue: 0,0:30:32.36,0:30:34.70,Default,,0000,0000,0000,,Демалыс менің қолымда.
Dialogue: 0,0:30:34.70,0:30:38.54,Default,,0000,0000,0000,,Күнәларыңды маймен майлап, мөр басамын.
Dialogue: 0,0:30:38.54,0:30:44.64,Default,,0000,0000,0000,,Мәңгілік өмір
Dialogue: 0,0:30:38.54,0:30:44.64,Default,,0000,0000,0000,,Өлім кезінде ғана беріледі.
Dialogue: 0,0:30:44.64,0:30:48.65,Default,,0000,0000,0000,,Кешірімділік осында. Мен, инкарнация, бұл туралы ант етемін.
Dialogue: 0,0:30:48.65,0:30:53.48,Default,,0000,0000,0000,,Хахаха Бұл нені өзгертеді?
Dialogue: 0,0:30:48.65,0:30:53.48,Default,,0000,0000,0000,,Сізге құтқарылу жоқ!
Dialogue: 0,0:30:53.48,0:30:56.59,Default,,0000,0000,0000,,Кайри Элейсон
Dialogue: 0,0:30:53.48,0:30:56.59,Default,,0000,0000,0000,,Осы жанға рақым ет.
Dialogue: 0,0:31:12.67,0:31:17.58,Default,,0000,0000,0000,,Жазбалардың қасиетті сөздері бойынша
Dialogue: 0,0:31:12.67,0:31:17.58,Default,,0000,0000,0000,,Бұл рухтың өзіне шабуыл ма?
Dialogue: 0,0:31:20.35,0:31:26.02,Default,,0000,0000,0000,,Сиқыршы залында
Dialogue: 0,0:31:20.35,0:31:26.02,Default,,0000,0000,0000,,Сонымен олар табиғи жау болды.
Dialogue: 0,0:31:26.02,0:31:28.69,Default,,0000,0000,0000,,Ал сіз...
Dialogue: 0,0:31:28.69,0:31:32.52,Default,,0000,0000,0000,,Ол әлдеқашан ластанған, солай емес пе?
Dialogue: 0,0:31:32.52,0:31:34.53,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:31:34.53,0:31:38.33,Default,,0000,0000,0000,,Цк, бұл менің қателігім.
Dialogue: 0,0:31:50.31,0:31:55.65,Default,,0000,0000,0000,,｟Клаудия: Қараңызшы.
Dialogue: 0,0:31:50.31,0:31:55.65,Default,,0000,0000,0000,,Сен, жылап тұрғансың｠
Dialogue: 0,0:31:55.65,0:31:59.35,Default,,0000,0000,0000,,《Бұл түсінбеушілік》
Dialogue: 0,0:32:02.82,0:32:05.82,Default,,0000,0000,0000,,《Мен, әрине, қайғылы деп ойладым.
Dialogue: 0,0:32:05.82,0:32:09.13,Default,,0000,0000,0000,,Бірақ бұл әйелдің өлімі емес.
Dialogue: 0,0:32:13.50,0:32:19.60,Default,,0000,0000,0000,,``Егер мен бәрібір өлетін болсам
Dialogue: 0,0:32:13.50,0:32:19.60,Default,,0000,0000,0000,,Мен оны өз қолыммен өлтіргім келді.''
Dialogue: 0,0:32:31.85,0:32:33.85,Default,,0000,0000,0000,,Ширу?
Dialogue: 0,0:32:33.85,0:32:38.52,Default,,0000,0000,0000,,Амансың ба? Илья.
Dialogue: 0,0:32:33.85,0:32:38.52,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:32:38.52,0:32:41.63,Default,,0000,0000,0000,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:32:44.63,0:32:48.97,Default,,0000,0000,0000,,Ширу, қаш.
Dialogue: 0,0:32:44.63,0:32:48.97,Default,,0000,0000,0000,,Берсеркер мені іздеп жатыр.
Dialogue: 0,0:32:48.97,0:32:51.47,Default,,0000,0000,0000,,Ширу!
Dialogue: 0,0:32:53.47,0:32:56.64,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:32:56.64,0:33:00.65,Default,,0000,0000,0000,,Үлкен ағасы сіңлісіне көмектеседі.
Dialogue: 0,0:33:00.65,0:33:02.98,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:33:02.98,0:33:04.98,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:33:04.98,0:33:08.99,Default,,0000,0000,0000,,Бір рет болса да, мен ешқашан аға болған емеспін.
Dialogue: 0,0:33:04.98,0:33:08.99,Default,,0000,0000,0000,,Маған біреу қоңырау шалса, үлкен аға.
Dialogue: 0,0:33:08.99,0:33:10.99,Default,,0000,0000,0000,,Нақыл ➡
Dialogue: 0,0:33:10.99,0:33:13.09,Default,,0000,0000,0000,,Қанмен туыс болмаса да.
Dialogue: 0,0:33:22.67,0:33:27.67,Default,,0000,0000,0000,,Ширу: Арчердің қолын пайдалансаңыз
Dialogue: 0,0:33:22.67,0:33:27.67,Default,,0000,0000,0000,,Сіз қайтып орала алмайсыз.
Dialogue: 0,0:33:27.67,0:33:30.51,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:33:30.51,0:33:34.35,Default,,0000,0000,0000,,Мен өлемін...
Dialogue: 0,0:33:30.51,0:33:34.35,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:33:34.35,0:33:38.52,Default,,0000,0000,0000,,Өліп қалмау үшін пайдаланыңыз.
Dialogue: 0,0:33:38.52,0:33:41.69,Default,,0000,0000,0000,,Неге...
Dialogue: 0,0:33:41.69,0:33:44.96,Default,,0000,0000,0000,,Неліктен Широ?
Dialogue: 0,0:33:41.69,0:33:44.96,Default,,0000,0000,0000,,Осы уақытқа дейін бару керек! ?
Dialogue: 0,0:33:44.96,0:33:49.26,Default,,0000,0000,0000,,Ширу
Dialogue: 0,0:33:44.96,0:33:49.26,Default,,0000,0000,0000,,Мен қателеспесем де!
Dialogue: 0,0:33:52.46,0:33:54.47,Default,,0000,0000,0000,,№.
Dialogue: 0,0:33:54.47,0:33:58.64,Default,,0000,0000,0000,,Қандай жаман нәрсе
Dialogue: 0,0:33:54.47,0:33:58.64,Default,,0000,0000,0000,,Мен көп нәрсе жасадым.
Dialogue: 0,0:33:58.64,0:34:02.84,Default,,0000,0000,0000,,Бірақ рахмет.
Dialogue: 0,0:34:08.81,0:34:13.48,Default,,0000,0000,0000,,《Егер мен осы қолды қолдансам
Dialogue: 0,0:34:08.81,0:34:13.48,Default,,0000,0000,0000,,Мен не болатынын білмеймін.
Dialogue: 0,0:34:13.48,0:34:15.82,Default,,0000,0000,0000,,Мен де шие гүлдерін қорғауға ант бердім➡
Dialogue: 0,0:34:15.82,0:34:20.49,Default,,0000,0000,0000,,Мен де Ілиясты қайтаруды жөн көрдім.
Dialogue: 0,0:34:15.82,0:34:20.49,Default,,0000,0000,0000,,Қалғанының бәрі➡
Dialogue: 0,0:34:20.49,0:34:23.16,Default,,0000,0000,0000,,Сіз есте сақтай алмауыңыз мүмкін.
Dialogue: 0,0:34:23.16,0:34:29.17,Default,,0000,0000,0000,,Бірақ ол маған керек.
Dialogue: 0,0:34:23.16,0:34:29.17,Default,,0000,0000,0000,,Бұл қолды маған сеніп тапсырды》
Dialogue: 0,0:34:32.00,0:34:35.01,Default,,0000,0000,0000,,Сіз Ильяны жеңе аласыз.
Dialogue: 0,0:34:39.34,0:34:41.85,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:34:41.85,0:34:58.13,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:34:58.13,0:35:04.30,Default,,0000,0000,0000,,《Дене де, сана да
Dialogue: 0,0:34:58.13,0:35:04.30,Default,,0000,0000,0000,,Эмоциясыз құлау.
Dialogue: 0,0:35:04.30,0:35:08.97,Default,,0000,0000,0000,,Неге мұндасың?
Dialogue: 0,0:35:08.97,0:35:13.48,Default,,0000,0000,0000,,Неліктен бұлай болды?
Dialogue: 0,0:35:13.48,0:35:16.98,Default,,0000,0000,0000,,Біз не үшін күресеміз?
Dialogue: 0,0:35:16.98,0:35:38.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:35:38.00,0:35:41.34,Default,,0000,0000,0000,,｟Арчер: Сіз маған ере аласыз ба｠
Dialogue: 0,0:35:41.34,0:35:50.78,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:35:50.78,0:35:54.62,Default,,0000,0000,0000,,Менің артымнан келе аласыз ба... онда!
Dialogue: 0,0:35:54.62,0:35:57.96,Default,,0000,0000,0000,,Теми - бұл!
Dialogue: 0,0:35:57.96,0:36:06.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:36:06.96,0:36:09.47,Default,,0000,0000,0000,,Менің артымнан жүр!
Dialogue: 0,0:36:09.47,0:36:21.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:36:21.98,0:36:24.78,Default,,0000,0000,0000,,Гурул….
Dialogue: 0,0:36:26.82,0:36:28.82,Default,,0000,0000,0000,,Із
Dialogue: 0,0:36:26.82,0:36:28.82,Default,,0000,0000,0000,,Қосулы
Dialogue: 0,0:36:26.82,0:36:28.82,Default,,0000,0000,0000,,Проекцияның басталуы.
Dialogue: 0,0:36:28.82,0:36:48.94,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:36:48.94,0:36:52.44,Default,,0000,0000,0000,,Триггер
Dialogue: 0,0:36:48.94,0:36:52.44,Default,,0000,0000,0000,,Өшірулі
Dialogue: 0,0:36:48.94,0:36:52.44,Default,,0000,0000,0000,,Проекциялық жүктеме.
Dialogue: 0,0:36:55.95,0:36:58.25,Default,,0000,0000,0000,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:37:06.62,0:37:10.46,Default,,0000,0000,0000,,Nine Lives Blade жұмыс істейді!
Dialogue: 0,0:37:10.46,0:37:33.48,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:37:33.48,0:37:35.59,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:37:39.49,0:37:43.59,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:37:43.59,0:37:56.81,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:38:15.46,0:38:18.06,Default,,0000,0000,0000,,Сіз оны қорғайсыз.
Dialogue: 0,0:38:38.15,0:38:40.15,Default,,0000,0000,0000,,Ширу.
Dialogue: 0,0:38:49.26,0:38:51.26,Default,,0000,0000,0000,,Сабер.
Dialogue: 0,0:39:02.61,0:39:04.94,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:39:04.94,0:39:08.95,Default,,0000,0000,0000,,Жүрегіңді басып алғанда қандай сезімде болдың?
Dialogue: 0,0:39:13.95,0:39:18.46,Default,,0000,0000,0000,,Fr.
Dialogue: 0,0:39:13.95,0:39:18.46,Default,,0000,0000,0000,,Сіз он жыл бұрын қайтыс болдыңыз.
Dialogue: 0,0:39:18.46,0:39:21.46,Default,,0000,0000,0000,,Соған қарамастан мен аман қалдым➡
Dialogue: 0,0:39:21.46,0:39:25.30,Default,,0000,0000,0000,,Ал, мен оны кеше жедім...
Dialogue: 0,0:39:25.30,0:39:29.80,Default,,0000,0000,0000,,Сол алтын адам
Dialogue: 0,0:39:25.30,0:39:29.80,Default,,0000,0000,0000,,Қасиетті Граилдың мазмұнына шомылды ...
Dialogue: 0,0:39:29.80,0:39:32.64,Default,,0000,0000,0000,,Бірақ ол адам ластай алмайды➡
Dialogue: 0,0:39:32.64,0:39:37.48,Default,,0000,0000,0000,,Сізге, шебер
Dialogue: 0,0:39:32.64,0:39:37.48,Default,,0000,0000,0000,,Ағып кетті... солай ма?
Dialogue: 0,0:39:37.48,0:39:42.15,Default,,0000,0000,0000,,Сакура Мату өзгерді.
Dialogue: 0,0:39:42.15,0:39:45.82,Default,,0000,0000,0000,,Ол өзгерді.
Dialogue: 0,0:39:45.82,0:39:51.16,Default,,0000,0000,0000,,Мен бұрынғы Мату Сакура емеспін.
Dialogue: 0,0:39:51.16,0:39:55.56,Default,,0000,0000,0000,,Ондай әлсіз балалар жоқ.
Dialogue: 0,0:39:58.16,0:40:01.83,Default,,0000,0000,0000,,Я, оны жасырудың қажеті жоқ.
Dialogue: 0,0:40:01.83,0:40:04.84,Default,,0000,0000,0000,,Не...?
Dialogue: 0,0:40:04.84,0:40:08.01,Default,,0000,0000,0000,,Сіз басқа тұлға емессіз.
Dialogue: 0,0:40:08.01,0:40:14.18,Default,,0000,0000,0000,,Зорлық-зомбылықтан мас күйінде
Dialogue: 0,0:40:08.01,0:40:14.18,Default,,0000,0000,0000,,Сіз де қазір Сакура Матусыз.
Dialogue: 0,0:40:14.18,0:40:18.85,Default,,0000,0000,0000,,Сіз мені бұны жасауға мәжбүр еттіңіз!
Dialogue: 0,0:40:14.18,0:40:18.85,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:40:18.85,0:40:23.85,Default,,0000,0000,0000,,Мен оны жоққа шығармаймын. Мен сені тірі қалдырдым.
Dialogue: 0,0:40:23.85,0:40:26.36,Default,,0000,0000,0000,,Бұл үміттерді ақтау➡
Dialogue: 0,0:40:26.36,0:40:31.20,Default,,0000,0000,0000,,Сіз керемет кек алушысыз
Dialogue: 0,0:40:26.36,0:40:31.20,Default,,0000,0000,0000,,Босануға тырысу.
Dialogue: 0,0:40:31.20,0:40:33.20,Default,,0000,0000,0000,,Мәселе жоқ.
Dialogue: 0,0:40:33.20,0:40:35.20,Default,,0000,0000,0000,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:40:35.20,0:40:38.37,Default,,0000,0000,0000,,Ха... Бұл оңай емес!
Dialogue: 0,0:40:38.37,0:40:42.64,Default,,0000,0000,0000,,Мен қанша азап шектім?
Dialogue: 0,0:40:38.37,0:40:42.64,Default,,0000,0000,0000,,Тіпті білмеймін!
Dialogue: 0,0:40:42.64,0:40:46.14,Default,,0000,0000,0000,,Мен білмеймін және білудің де қажеті жоқ.
Dialogue: 0,0:40:46.14,0:40:49.15,Default,,0000,0000,0000,,Маған жауап бер.
Dialogue: 0,0:40:49.15,0:40:51.15,Default,,0000,0000,0000,,Гү!
Dialogue: 0,0:40:51.15,0:40:53.15,Default,,0000,0000,0000,,Гугу... Гаха!
Dialogue: 0,0:40:57.66,0:41:04.66,Default,,0000,0000,0000,,А... ха... ха... ха....
Dialogue: 0,0:41:07.00,0:41:09.00,Default,,0000,0000,0000,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:41:09.00,0:41:12.00,Default,,0000,0000,0000,,О... Ах...
Dialogue: 0,0:41:12.00,0:41:16.01,Default,,0000,0000,0000,,Бар... Сарқар...?
Dialogue: 0,0:41:16.01,0:41:19.51,Default,,0000,0000,0000,,Жоқ... кірме.
Dialogue: 0,0:41:19.51,0:41:23.11,Default,,0000,0000,0000,,Ух... аа... а...
Dialogue: 0,0:41:29.02,0:41:34.02,Default,,0000,0000,0000,,Сіз бақыттысыз. Сакура маған қоңырау шалады.
Dialogue: 0,0:41:38.03,0:41:45.34,Default,,0000,0000,0000,,Жоқ, бұл сәттілік емес.
Dialogue: 0,0:41:38.03,0:41:45.34,Default,,0000,0000,0000,,Бұл сіздің жеке жеңісіңіздің нәтижесі болды ма?
Dialogue: 0,0:41:53.31,0:41:56.51,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:41:53.31,0:41:56.51,Default,,0000,0000,0000,,Ширу!
Dialogue: 0,0:41:58.48,0:42:01.99,Default,,0000,0000,0000,,Ширу….
Dialogue: 0,0:42:01.99,0:42:04.82,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:42:04.82,0:42:09.63,Default,,0000,0000,0000,,Жарайды...үйге қайтайық.
Dialogue: 0,0:42:13.83,0:42:16.53,Default,,0000,0000,0000,,Кейін қалсаң, капитан мені сөгіп тастайды.
Dialogue: 0,0:42:18.67,0:42:20.67,Default,,0000,0000,0000,,Уф! Ах!
Dialogue: 0,0:42:20.67,0:42:22.67,Default,,0000,0000,0000,,Гуха….
Dialogue: 0,0:42:22.67,0:42:25.38,Default,,0000,0000,0000,,Гуах!
Dialogue: 0,0:42:29.35,0:42:39.86,Default,,0000,0000,0000,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:42:39.86,0:42:42.63,Default,,0000,0000,0000,,Гррр... Аа...
Dialogue: 0,0:42:42.63,0:42:45.96,Default,,0000,0000,0000,,Ха ха... ха....
Dialogue: 0,0:42:45.96,0:42:47.97,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:42:47.97,0:42:53.97,Default,,0000,0000,0000,,А... хмм... иә...
Dialogue: 0,0:42:53.97,0:42:57.07,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:42:59.31,0:43:06.82,Default,,0000,0000,0000,,Ха... ха... ха... ха....
Dialogue: 0,0:43:06.82,0:43:13.49,Default,,0000,0000,0000,,А... ха... Қолымды пайдаланғаны үшін бе?
Dialogue: 0,0:43:13.49,0:43:16.49,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:43:13.49,0:43:16.49,Default,,0000,0000,0000,,(Шодзи ашу дыбысы)
Dialogue: 0,0:43:22.17,0:43:24.84,Default,,0000,0000,0000,,Сіз ояусыз ба? Ширу.
Dialogue: 0,0:43:24.84,0:43:28.17,Default,,0000,0000,0000,,Тохсака...! ? Жарайды ма?
Dialogue: 0,0:43:28.17,0:43:33.34,Default,,0000,0000,0000,,Ал, сенімен салыстырғанда... солай ма?
Dialogue: 0,0:43:33.34,0:43:36.35,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:43:36.35,0:43:39.18,Default,,0000,0000,0000,,Жарайды, жақсы екеніңізге қуаныштымын.
Dialogue: 0,0:43:39.18,0:43:41.52,Default,,0000,0000,0000,,Бұл...!
Dialogue: 0,0:43:41.52,0:43:45.62,Default,,0000,0000,0000,,Не? А, бұл...
Dialogue: 0,0:43:45.62,0:43:50.13,Default,,0000,0000,0000,,Бұл маңызды.
Dialogue: 0,0:43:50.13,0:43:55.13,Default,,0000,0000,0000,,Соңына дейін болмаса...
Dialogue: 0,0:43:55.13,0:44:00.14,Default,,0000,0000,0000,,Иә? Мен жаңа ғана не айттым?
Dialogue: 0,0:44:00.14,0:44:06.48,Default,,0000,0000,0000,,Әлі сиқырлы күш бар...
Dialogue: 0,0:44:00.14,0:44:06.48,Default,,0000,0000,0000,,Алыңыз.
Dialogue: 0,0:44:06.48,0:44:12.28,Default,,0000,0000,0000,,Өйткені ол бір нәрсеге пайдалы болуы мүмкін.
Dialogue: 0,0:44:06.48,0:44:12.28,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:44:15.15,0:44:19.36,Default,,0000,0000,0000,,Олай болса, дайындал.
Dialogue: 0,0:44:15.15,0:44:19.36,Default,,0000,0000,0000,,Мен шығамын.
Dialogue: 0,0:44:29.33,0:44:35.84,Default,,0000,0000,0000,,Қасиетті Граиль соғысына қатысқан соңғы шебер
Dialogue: 0,0:44:29.33,0:44:35.84,Default,,0000,0000,0000,,Тек фактілерді айтыңыз.
Dialogue: 0,0:44:35.84,0:44:41.68,Default,,0000,0000,0000,,Мен қазір не туралы айтайын
Dialogue: 0,0:44:35.84,0:44:41.68,Default,,0000,0000,0000,,Біздің өзегіміз. Бірақ➡
Dialogue: 0,0:44:41.68,0:44:45.38,Default,,0000,0000,0000,,Балалар
Dialogue: 0,0:44:41.68,0:44:45.38,Default,,0000,0000,0000,,Бұл сіздің алып жүруіңіз керек нәрсе емес.
Dialogue: 0,0:44:47.28,0:44:51.46,Default,,0000,0000,0000,,Қасиетті Граил соғысы дегеніміз не?
Dialogue: 0,0:44:47.28,0:44:51.46,Default,,0000,0000,0000,,7 батыр рухын шақыру➡
Dialogue: 0,0:44:51.46,0:44:54.79,Default,,0000,0000,0000,,Қасиетті Граилға меншік құқығын анықтау үшін бір-бірін өлтіру.
Dialogue: 0,0:44:54.79,0:44:59.60,Default,,0000,0000,0000,,Бірақ бұл жай ғана ресми ереже.
Dialogue: 0,0:45:01.63,0:45:07.14,Default,,0000,0000,0000,,Иә. Қожайын бұл дүниеге қызметшісін әкеледі
Dialogue: 0,0:45:01.63,0:45:07.14,Default,,0000,0000,0000,,Бұл жай ғана қоңырау шалу мүмкіндігі.
Dialogue: 0,0:45:07.14,0:45:10.81,Default,,0000,0000,0000,,Қасиетті Граильді аяқтау үшін не қажет?➡
Dialogue: 0,0:45:10.81,0:45:12.98,Default,,0000,0000,0000,,Тек батыр рухтар...
Dialogue: 0,0:45:12.98,0:45:18.32,Default,,0000,0000,0000,,Сол жан Эйнцбернді дайындайды.
Dialogue: 0,0:45:12.98,0:45:18.32,Default,,0000,0000,0000,,Қасиетті Граильде жиналған➡
Dialogue: 0,0:45:18.32,0:45:23.15,Default,,0000,0000,0000,,Ұлы грильді іске қосу
Dialogue: 0,0:45:18.32,0:45:23.15,Default,,0000,0000,0000,,Реактордың өзегі болыңыз.
Dialogue: 0,0:45:23.15,0:45:25.82,Default,,0000,0000,0000,,Ұлы Қасиетті Граил?
Dialogue: 0,0:45:25.82,0:45:29.66,Default,,0000,0000,0000,,Тохсака басқаратын жерді пайдаланатын сиқырлы құрал.
Dialogue: 0,0:45:29.66,0:45:34.16,Default,,0000,0000,0000,,Бұл Қасиетті Граил соғысының жүйесі.
Dialogue: 0,0:45:29.66,0:45:34.16,Default,,0000,0000,0000,,Басқарылады.
Dialogue: 0,0:45:34.16,0:45:37.17,Default,,0000,0000,0000,,Бұл 300 жыл бұрын болған➡
Dialogue: 0,0:45:37.17,0:45:41.51,Default,,0000,0000,0000,,Эйнцберн мен Макири Тохсаканың үш тұқымдастары➡
Dialogue: 0,0:45:41.51,0:45:46.61,Default,,0000,0000,0000,,Қасиетті Граилдың күшімен
Dialogue: 0,0:45:41.51,0:45:46.61,Default,,0000,0000,0000,,Сыртқы әлемге шығуға тырысты.
Dialogue: 0,0:45:46.61,0:45:49.28,Default,,0000,0000,0000,,Міне, нағыз мақсат.
Dialogue: 0,0:45:49.28,0:45:53.28,Default,,0000,0000,0000,,Эйнцберннен
Dialogue: 0,0:45:49.28,0:45:53.28,Default,,0000,0000,0000,,Жоғалған жұмбақ ой.
Dialogue: 0,0:45:53.28,0:45:56.79,Default,,0000,0000,0000,,Нағыз өлместікке жетудің ұлы рәсімі.
Dialogue: 0,0:45:56.79,0:46:00.79,Default,,0000,0000,0000,,«Аспан кесе» Аспан сезімі.
Dialogue: 0,0:46:00.79,0:46:05.00,Default,,0000,0000,0000,,Жанды заттандыратын сиқыр.
Dialogue: 0,0:46:00.79,0:46:05.00,Default,,0000,0000,0000,,Ах...! ?
Dialogue: 0,0:46:08.13,0:46:12.14,Default,,0000,0000,0000,,Осыдан кейін
Dialogue: 0,0:46:08.13,0:46:12.14,Default,,0000,0000,0000,,Бұл оқиғаның Ширу мен Ринге де қатысы бар.
Dialogue: 0,0:46:14.14,0:46:16.14,Default,,0000,0000,0000,,Сіз шие гүлін айтып тұрсыз ба?
Dialogue: 0,0:46:16.14,0:46:19.81,Default,,0000,0000,0000,,Маған тыңдауға рұқсат етіңіз.
Dialogue: 0,0:46:16.14,0:46:19.81,Default,,0000,0000,0000,,Сакура не болып жатыр?
Dialogue: 0,0:46:19.81,0:46:26.65,Default,,0000,0000,0000,,Шие гүлін, сия тасты түрлендіру
Dialogue: 0,0:46:19.81,0:46:26.65,Default,,0000,0000,0000,,Сіз не алуға тырысасыз.
Dialogue: 0,0:46:26.65,0:46:29.49,Default,,0000,0000,0000,,Бұл... Кек алушы.
Dialogue: 0,0:46:29.49,0:46:35.33,Default,,0000,0000,0000,,Қасиетті Граил соғысындағы сегізінші сынып
Dialogue: 0,0:46:29.49,0:46:35.33,Default,,0000,0000,0000,,Шие гүлдерімен ассимиляциялау➡
Dialogue: 0,0:46:35.33,0:46:38.66,Default,,0000,0000,0000,,«Қара көлеңке» түсіретін негізгі дене...
Dialogue: 0,0:46:38.66,0:46:41.83,Default,,0000,0000,0000,,Анри Маю.
Dialogue: 0,0:46:41.83,0:46:46.94,Default,,0000,0000,0000,,Отқа табынуға сенетін ауыл туралы әңгіме.
Dialogue: 0,0:46:46.94,0:46:52.44,Default,,0000,0000,0000,,Ол адамдардың барлығы да адамдар.
Dialogue: 0,0:46:46.94,0:46:52.44,Default,,0000,0000,0000,,Қатерлі ісіктен құтылды➡
Dialogue: 0,0:46:52.44,0:46:56.45,Default,,0000,0000,0000,,Сіз таза және әділ өмір сүре алмайсыз ба?
Dialogue: 0,0:46:52.44,0:46:56.45,Default,,0000,0000,0000,,Мен ойладым.
Dialogue: 0,0:46:56.45,0:47:01.62,Default,,0000,0000,0000,,Онда олар
Dialogue: 0,0:46:56.45,0:47:01.62,Default,,0000,0000,0000,,Тек бір жас жігітті таңдаңыз➡
Dialogue: 0,0:47:01.62,0:47:06.12,Default,,0000,0000,0000,,Оған бүкіл әлем
Dialogue: 0,0:47:01.62,0:47:06.12,Default,,0000,0000,0000,,Кінә жүгін көтеру➡
Dialogue: 0,0:47:06.12,0:47:12.80,Default,,0000,0000,0000,,одан басқа барлық адамдар
Dialogue: 0,0:47:06.12,0:47:12.80,Default,,0000,0000,0000,,Жақсылықты дәлелдеуге тырысты.
Dialogue: 0,0:47:12.80,0:47:17.80,Default,,0000,0000,0000,,Осылайша батыр дүниеге келді.
Dialogue: 0,0:47:17.80,0:47:23.64,Default,,0000,0000,0000,,адамдар зұлымдық ретінде жек көреді
Dialogue: 0,0:47:17.80,0:47:23.64,Default,,0000,0000,0000,,Тәңір ретінде де табынған➡
Dialogue: 0,0:47:23.64,0:47:26.98,Default,,0000,0000,0000,,Ешкім емес...
Dialogue: 0,0:47:26.98,0:47:32.48,Default,,0000,0000,0000,,Бұл Анри Маюға қарсы кейіпкер.
Dialogue: 0,0:47:32.48,0:47:34.99,Default,,0000,0000,0000,,Үшінші шайқаста➡
Dialogue: 0,0:47:34.99,0:47:39.99,Default,,0000,0000,0000,,Эйнцберн қызметші ретінде
Dialogue: 0,0:47:34.99,0:47:39.99,Default,,0000,0000,0000,,Анри Маюды шақырды.
Dialogue: 0,0:47:39.99,0:47:43.59,Default,,0000,0000,0000,,Бірақ ол әлсіз болды.
Dialogue: 0,0:47:43.59,0:47:49.77,Default,,0000,0000,0000,,Анри Маю ерте кезеңде жеңіліп қалды.
Dialogue: 0,0:47:43.59,0:47:49.77,Default,,0000,0000,0000,,Қасиетті Граилға енгізілген.
Dialogue: 0,0:47:49.77,0:47:53.60,Default,,0000,0000,0000,,Ол кезде Қасиетті Граил ➡ болып табылады
Dialogue: 0,0:47:53.60,0:47:58.11,Default,,0000,0000,0000,,Мен бір тілекті қабылдадым.
Dialogue: 0,0:47:58.11,0:48:02.95,Default,,0000,0000,0000,,Адамдар «жаман болғың келсе»
Dialogue: 0,0:47:58.11,0:48:02.95,Default,,0000,0000,0000,,Туған болмыс.
Dialogue: 0,0:48:02.95,0:48:08.62,Default,,0000,0000,0000,,Бұл Қасиетті Граилде
Dialogue: 0,0:48:02.95,0:48:08.62,Default,,0000,0000,0000,,Бұл ақыры болды.
Dialogue: 0,0:48:08.62,0:48:12.12,Default,,0000,0000,0000,,«Осы дүниедегі барлық зұлымдықты» бейнелеу➡
Dialogue: 0,0:48:12.12,0:48:17.29,Default,,0000,0000,0000,,Барлығы 6 миллиард адам
Dialogue: 0,0:48:12.12,0:48:17.29,Default,,0000,0000,0000,,Қарғыс айтуға болатын болмыс.
Dialogue: 0,0:48:17.29,0:48:21.80,Default,,0000,0000,0000,,Бұл сол көлеңкенің денесі.
Dialogue: 0,0:48:24.30,0:48:29.97,Default,,0000,0000,0000,,Кирицугу соңғы рет Қасиетті Граалды жойды.
Dialogue: 0,0:48:29.97,0:48:32.14,Default,,0000,0000,0000,,Анри Маю бұл➡
Dialogue: 0,0:48:32.14,0:48:38.98,Default,,0000,0000,0000,,Кирицугуның батыл шешіміне байланысты босану болмады.
Dialogue: 0,0:48:32.14,0:48:38.98,Default,,0000,0000,0000,,Ұлы Қасиетті Граилде қалды.
Dialogue: 0,0:48:38.98,0:48:43.09,Default,,0000,0000,0000,,Оның бір бөлігін алғандар
Dialogue: 0,0:48:38.98,0:48:43.09,Default,,0000,0000,0000,,Бұл Котомине➡
Dialogue: 0,0:48:43.09,0:48:46.92,Default,,0000,0000,0000,,Қасиетті Граил мазмұнының фрагменті
Dialogue: 0,0:48:43.09,0:48:46.92,Default,,0000,0000,0000,,Сия тасқа отырғызылған➡
Dialogue: 0,0:48:46.92,0:48:51.76,Default,,0000,0000,0000,,Шие гүлдері жасанды Қасиетті Граилға айналды.
Dialogue: 0,0:48:51.76,0:48:58.10,Default,,0000,0000,0000,,Анри Маю қандай болса да
Dialogue: 0,0:48:51.76,0:48:58.10,Default,,0000,0000,0000,,Ол әлі де қызметші.
Dialogue: 0,0:48:58.10,0:49:04.27,Default,,0000,0000,0000,,Сондықтан оны бағындыру үшін,
Dialogue: 0,0:48:58.10,0:49:04.27,Default,,0000,0000,0000,,Сакураны игерді.
Dialogue: 0,0:49:04.27,0:49:06.28,Default,,0000,0000,0000,,А...?
Dialogue: 0,0:49:06.28,0:49:10.61,Default,,0000,0000,0000,,《Қоса мен қызметші...》
Dialogue: 0,0:49:10.61,0:49:14.12,Default,,0000,0000,0000,,Сізде жарты күн қалды ма?
Dialogue: 0,0:49:14.12,0:49:18.96,Default,,0000,0000,0000,,Сол зат туылғаннан кейін
Dialogue: 0,0:49:14.12,0:49:18.96,Default,,0000,0000,0000,,Сакура мүлде өзгерді➡
Dialogue: 0,0:49:18.96,0:49:23.96,Default,,0000,0000,0000,,Сізге ешкім көмектесе алмайды
Dialogue: 0,0:49:18.96,0:49:23.96,Default,,0000,0000,0000,,Ешкім құтқарылмайды.
Dialogue: 0,0:49:28.47,0:49:31.97,Default,,0000,0000,0000,,Сондықтан базаға отырар алдында➡
Dialogue: 0,0:49:31.97,0:49:35.14,Default,,0000,0000,0000,,Мен Ширудың бір нәрсе істегенін қалаймын.
Dialogue: 0,0:49:35.14,0:49:40.31,Default,,0000,0000,0000,,Шынымды айтсам, Ширу Ильяны алады
Dialogue: 0,0:49:35.14,0:49:40.31,Default,,0000,0000,0000,,Мені қайтарғаныңызға рахмет.
Dialogue: 0,0:49:40.31,0:49:43.15,Default,,0000,0000,0000,,Ильямен ынтымақтасу керек➡
Dialogue: 0,0:49:43.15,0:49:48.32,Default,,0000,0000,0000,,Эйнцберн туралы естеліктер және
Dialogue: 0,0:49:43.15,0:49:48.32,Default,,0000,0000,0000,,Осы рухани тамыр арқылы ағып жатқан ел туралы естелік.
Dialogue: 0,0:49:48.32,0:49:52.99,Default,,0000,0000,0000,,Осы екеуін пайдалану
Dialogue: 0,0:49:48.32,0:49:52.99,Default,,0000,0000,0000,,Мен сенің асыл қылышты проекциялауыңды қалаймын.
Dialogue: 0,0:49:52.99,0:49:55.99,Default,,0000,0000,0000,,Зергерлік қылыш….
Dialogue: 0,0:49:55.99,0:50:00.00,Default,,0000,0000,0000,,Тохсақа тұқымы арқылы тараған
Dialogue: 0,0:49:55.99,0:50:00.00,Default,,0000,0000,0000,,Қазына қазынасы.
Dialogue: 0,0:50:00.00,0:50:02.83,Default,,0000,0000,0000,,Және….
Dialogue: 0,0:50:02.83,0:50:06.64,Default,,0000,0000,0000,,Сакурамен күресуге арналған қару.
Dialogue: 0,0:50:08.67,0:50:11.07,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:50:16.68,0:50:19.35,Default,,0000,0000,0000,,Зергерлік семсерге ұқсайтын азот қылыш.
Dialogue: 0,0:50:19.35,0:50:22.85,Default,,0000,0000,0000,,Менің 10 жылдық сиқырлы күшім
Dialogue: 0,0:50:19.35,0:50:22.85,Default,,0000,0000,0000,,Ол инвестицияланады.
Dialogue: 0,0:50:22.85,0:50:25.56,Default,,0000,0000,0000,,Проекцияны қолдау үшін қолданылады.
Dialogue: 0,0:50:30.19,0:50:32.86,Default,,0000,0000,0000,,Ширу.
Dialogue: 0,0:50:32.86,0:50:36.57,Default,,0000,0000,0000,,Шынымды айтсам, ол қанша уақытқа созылады?
Dialogue: 0,0:50:40.70,0:50:44.47,Default,,0000,0000,0000,,Мен тіпті білмеймін.
Dialogue: 0,0:50:44.47,0:50:48.08,Default,,0000,0000,0000,,Бірақ мен тірі кезде
Dialogue: 0,0:50:44.47,0:50:48.08,Default,,0000,0000,0000,,Мен бірдеңе істеймін.
Dialogue: 0,0:50:55.32,0:50:57.62,Default,,0000,0000,0000,,Менде бәрі жақсы.
Dialogue: 0,0:51:06.50,0:51:08.50,Default,,0000,0000,0000,,Өз ойларыңызды тастаңыз.
Dialogue: 0,0:51:08.50,0:51:11.33,Default,,0000,0000,0000,,Қажетсіз нәрселерге қарамаңыз.
Dialogue: 0,0:51:11.33,0:51:14.64,Default,,0000,0000,0000,,Ах... а.
Dialogue: 0,0:51:24.35,0:51:29.02,Default,,0000,0000,0000,,Теңіз?
Dialogue: 0,0:51:24.35,0:51:29.02,Default,,0000,0000,0000,,Ах... Ширу.
Dialogue: 0,0:51:29.02,0:51:42.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:51:42.97,0:51:46.97,Default,,0000,0000,0000,,Синдзи? жоқ….
Dialogue: 0,0:51:46.97,0:51:50.97,Default,,0000,0000,0000,,Мұнда емес...
Dialogue: 0,0:51:46.97,0:51:50.97,Default,,0000,0000,0000,,Алға секірейік.
Dialogue: 0,0:51:54.14,0:51:56.15,Default,,0000,0000,0000,,Уау! Ах...
Dialogue: 0,0:51:58.15,0:52:00.15,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:52:07.66,0:52:11.16,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:52:07.66,0:52:11.16,Default,,0000,0000,0000,,Тағы да.
Dialogue: 0,0:52:11.16,0:52:13.56,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:52:11.16,0:52:13.56,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:52:18.67,0:52:22.01,Default,,0000,0000,0000,,Сізді жою үшін➡
Dialogue: 0,0:52:22.01,0:52:24.01,Default,,0000,0000,0000,,Бұл ғажайыпты қажет етті...
Dialogue: 0,0:52:22.01,0:52:24.01,Default,,0000,0000,0000,,Біз де жеттік.
Dialogue: 0,0:52:24.01,0:52:28.85,Default,,0000,0000,0000,,Ширу Оны бақылаңыз.
Dialogue: 0,0:52:28.85,0:52:32.35,Default,,0000,0000,0000,,Сол философияға сеніңіз.
Dialogue: 0,0:52:32.35,0:52:38.69,Default,,0000,0000,0000,,Түбірге жету
Dialogue: 0,0:52:32.35,0:52:38.69,Default,,0000,0000,0000,,Тохсака Эйнцберн Макиридің үш адамы➡
Dialogue: 0,0:52:38.69,0:52:45.80,Default,,0000,0000,0000,,Бір-бірімен ынтымақтаса, жол ашады.
Dialogue: 0,0:52:38.69,0:52:45.80,Default,,0000,0000,0000,,Әрқайсысы не ұсынады.
Dialogue: 0,0:52:45.80,0:52:51.97,Default,,0000,0000,0000,,Тохсакада Қасиетті Граил бар
Dialogue: 0,0:52:45.80,0:52:51.97,Default,,0000,0000,0000,,Төсеу үшін қасиетті жер беру.
Dialogue: 0,0:52:51.97,0:52:58.81,Default,,0000,0000,0000,,Не
Dialogue: 0,0:52:51.97,0:52:58.81,Default,,0000,0000,0000,,Макири қызметшісін құрбандыққа шалды
Dialogue: 0,0:52:51.97,0:52:58.81,Default,,0000,0000,0000,,Байланыстыру үшін пәрмен емлесін береді.
Dialogue: 0,0:52:58.81,0:53:05.48,Default,,0000,0000,0000,,Эйнцберн үшінші сиқырға айналады
Dialogue: 0,0:52:58.81,0:53:05.48,Default,,0000,0000,0000,,Жету үшін лагерьмен қамтамасыз етіңіз.
Dialogue: 0,0:53:05.48,0:53:08.82,Default,,0000,0000,0000,,Хмм. Қатысу➡
Dialogue: 0,0:53:08.82,0:53:12.99,Default,,0000,0000,0000,,Кишуа Зелретч Швайорг
Dialogue: 0,0:53:08.82,0:53:12.99,Default,,0000,0000,0000,,Бөлек.
Dialogue: 0,0:53:12.99,0:53:15.33,Default,,0000,0000,0000,,Жұмысты бастау.
Dialogue: 0,0:53:15.33,0:53:27.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:53:27.00,0:53:30.01,Default,,0000,0000,0000,,(пресс машинасының төмен түсу дыбысы)
Dialogue: 0,0:53:30.01,0:53:36.18,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:53:36.18,0:53:47.79,Default,,0000,0000,0000,,(пресс машинасының төмен түсу дыбысы)
Dialogue: 0,0:53:47.79,0:53:51.96,Default,,0000,0000,0000,,Тамырларға қосылатын қақпа.
Dialogue: 0,0:53:51.96,0:53:54.56,Default,,0000,0000,0000,,Азат ету….
Dialogue: 0,0:54:00.97,0:54:03.47,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:54:03.47,0:54:07.08,Default,,0000,0000,0000,,Хм... мені босатыңыз.
Dialogue: 0,0:54:11.65,0:54:14.05,Default,,0000,0000,0000,,Азат ету….
Dialogue: 0,0:54:29.17,0:54:31.67,Default,,0000,0000,0000,,Ширу!
Dialogue: 0,0:54:29.17,0:54:31.67,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:54:48.62,0:54:51.79,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:54:51.79,0:54:57.29,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:54:57.29,0:55:02.80,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:55:02.80,0:55:04.80,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:55:04.80,0:55:09.31,Default,,0000,0000,0000,,Жағдайы өте ауыр.
Dialogue: 0,0:55:04.80,0:55:09.31,Default,,0000,0000,0000,,Ширу Эмия.
Dialogue: 0,0:55:09.31,0:55:12.81,Default,,0000,0000,0000,,Ах... Шабандоз.
Dialogue: 0,0:55:12.81,0:55:16.31,Default,,0000,0000,0000,,Мен сені үнемі бақылап жүрдім.
Dialogue: 0,0:55:18.65,0:55:22.49,Default,,0000,0000,0000,,Менің міндетім
Dialogue: 0,0:55:18.65,0:55:22.49,Default,,0000,0000,0000,,Ширу Эмиияның қорғанысы➡
Dialogue: 0,0:55:22.49,0:55:26.49,Default,,0000,0000,0000,,Сакурамен күресетін қаруың бар.
Dialogue: 0,0:55:22.49,0:55:26.49,Default,,0000,0000,0000,,Жасалған.
Dialogue: 0,0:55:28.99,0:55:34.80,Default,,0000,0000,0000,,Сакураға зиян тигізуден де артық
Dialogue: 0,0:55:28.99,0:55:34.80,Default,,0000,0000,0000,,Мен сені қорғай алмаймын.
Dialogue: 0,0:55:38.84,0:55:42.94,Default,,0000,0000,0000,,Сен мені өлтіруге келдің бе?
Dialogue: 0,0:55:42.94,0:55:45.44,Default,,0000,0000,0000,,Ширу….
Dialogue: 0,0:55:45.44,0:55:51.95,Default,,0000,0000,0000,,Шие ешқандай катализаторсыз гүлдейді
Dialogue: 0,0:55:45.44,0:55:51.95,Default,,0000,0000,0000,,Сіз мені шақырдыңыз.
Dialogue: 0,0:55:51.95,0:55:53.95,Default,,0000,0000,0000,,Егер солай жасасаңыз➡
Dialogue: 0,0:55:53.95,0:55:58.79,Default,,0000,0000,0000,,Қызметші және қожайын
Dialogue: 0,0:55:53.95,0:55:58.79,Default,,0000,0000,0000,,Тұлғасы ұқсас адамдар таңдалады.
Dialogue: 0,0:55:58.79,0:56:05.80,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:55:58.79,0:56:05.80,Default,,0000,0000,0000,,Сакураны құбыжыққа айналдырғым келмеді.
Dialogue: 0,0:56:05.80,0:56:09.63,Default,,0000,0000,0000,,Бірақ қазірдің өзінде...
Dialogue: 0,0:56:09.63,0:56:12.64,Default,,0000,0000,0000,,Мм... Ширу.
Dialogue: 0,0:56:12.64,0:56:18.48,Default,,0000,0000,0000,,Егер сіз де Сакураны азаптап жатсаңыз...
Dialogue: 0,0:56:12.64,0:56:18.48,Default,,0000,0000,0000,,Өлтірмеу.
Dialogue: 0,0:56:18.48,0:56:20.98,Default,,0000,0000,0000,,Мен сені құтқарамын.
Dialogue: 0,0:56:20.98,0:56:24.98,Default,,0000,0000,0000,,Мен Сакураны соңына дейін қорғаймын.
Dialogue: 0,0:56:24.98,0:56:27.32,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:56:27.32,0:56:31.65,Default,,0000,0000,0000,,Қандай жағдай болса да, шие гүлдерін таңда.
Dialogue: 0,0:56:31.65,0:56:33.66,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:56:33.66,0:56:40.00,Default,,0000,0000,0000,,Қашан... деген сұраққа жауап.
Dialogue: 0,0:56:33.66,0:56:40.00,Default,,0000,0000,0000,,дейсіз бе?
Dialogue: 0,0:56:40.00,0:56:44.93,Default,,0000,0000,0000,,Сол себепті
Dialogue: 0,0:56:40.00,0:56:44.93,Default,,0000,0000,0000,,Сіз жеңуіңіз керек қарсылас бар.
Dialogue: 0,0:56:44.93,0:56:48.44,Default,,0000,0000,0000,,Маған күшіңізді беріңізші.
Dialogue: 0,0:56:48.44,0:56:51.94,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:56:51.94,0:56:55.95,Default,,0000,0000,0000,,Менің жеңіске жету мүмкіндігіміз бар деп ойлаймын, солай ма?
Dialogue: 0,0:56:51.94,0:56:55.95,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:56:57.95,0:57:00.25,Default,,0000,0000,0000,,Түсінді.
Dialogue: 0,0:57:06.12,0:57:08.63,Default,,0000,0000,0000,,Қызметші шабандоз➡
Dialogue: 0,0:57:08.63,0:57:12.63,Default,,0000,0000,0000,,Біраз уақытқа
Dialogue: 0,0:57:08.63,0:57:12.63,Default,,0000,0000,0000,,Қанаттарың бол➡
Dialogue: 0,0:57:12.63,0:57:16.63,Default,,0000,0000,0000,,Соңына дейін жүгіру
Dialogue: 0,0:57:12.63,0:57:16.63,Default,,0000,0000,0000,,Уәде берейік.
Dialogue: 0,0:57:24.81,0:57:27.01,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:57:32.15,0:57:37.65,Default,,0000,0000,0000,,Хмф, мен қайта оралғым келеді.
Dialogue: 0,0:57:32.15,0:57:37.65,Default,,0000,0000,0000,,Мен солай болды деп ойладым.
Dialogue: 0,0:57:37.65,0:57:43.76,Default,,0000,0000,0000,,Көлеңкелер ұшады
Dialogue: 0,0:57:37.65,0:57:43.76,Default,,0000,0000,0000,,Сен керемет болып кеттің, Сакура.
Dialogue: 0,0:57:43.76,0:57:49.43,Default,,0000,0000,0000,,Апа
Dialogue: 0,0:57:43.76,0:57:49.43,Default,,0000,0000,0000,,Ағаңызды алып қашыңыз.
Dialogue: 0,0:57:49.43,0:57:51.43,Default,,0000,0000,0000,,Егер мұны істесеңіз➡
Dialogue: 0,0:57:51.43,0:57:55.44,Default,,0000,0000,0000,,Мен бұл қызбен жолымды кесіп өтемін.
Dialogue: 0,0:57:55.44,0:57:57.61,Default,,0000,0000,0000,,(импульстік дыбыс)
Dialogue: 0,0:57:57.61,0:58:04.51,Default,,0000,0000,0000,,Шие гүлдері. Мен сізден сұраймын.
Dialogue: 0,0:57:57.61,0:58:04.51,Default,,0000,0000,0000,,Анри Маюмен жолдарыңызды бөлуді жоспарлап отырсыз ба?
Dialogue: 0,0:58:09.12,0:58:11.12,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:58:11.12,0:58:18.80,Default,,0000,0000,0000,,Бұл сіз тапқан күш.
Dialogue: 0,0:58:11.12,0:58:18.80,Default,,0000,0000,0000,,Мен кеткім келмейді, мен кете алмаймын.
Dialogue: 0,0:58:18.80,0:58:21.63,Default,,0000,0000,0000,,Ширумен қашып кетсем➡
Dialogue: 0,0:58:21.63,0:58:27.14,Default,,0000,0000,0000,,Сіз және Анри Маю
Dialogue: 0,0:58:21.63,0:58:27.14,Default,,0000,0000,0000,,Сіз өзіңізді жоюға болады дейсіз бе?
Dialogue: 0,0:58:27.14,0:58:31.14,Default,,0000,0000,0000,,Дұрыс... сондықтан...
Dialogue: 0,0:58:33.14,0:58:38.15,Default,,0000,0000,0000,,Ол ``Мен енді оны қашан көтере алмаймын?''
Dialogue: 0,0:58:33.14,0:58:38.15,Default,,0000,0000,0000,,«Мен түсінбеймін» дұрыс емес.
Dialogue: 0,0:58:40.15,0:58:42.42,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:58:42.42,0:58:46.09,Default,,0000,0000,0000,,Не керек, Крюгер мырза?
Dialogue: 0,0:58:42.42,0:58:46.09,Default,,0000,0000,0000,,Сіздің мінез-құлқыңыз біраз уақыттан бері беймаза болды.
Dialogue: 0,0:58:46.09,0:58:51.29,Default,,0000,0000,0000,,Арғы жағын пышақтаймын деген Ясакиге.
Dialogue: 0,0:58:46.09,0:58:51.29,Default,,0000,0000,0000,,Мен қолымды кесіп алайын деген жоқпын.
Dialogue: 0,0:58:57.10,0:59:01.77,Default,,0000,0000,0000,,Дүрбелеңге түспеңіз
Dialogue: 0,0:58:57.10,0:59:01.77,Default,,0000,0000,0000,,Мен сені көруге бірден келемін.
Dialogue: 0,0:59:01.77,0:59:05.98,Default,,0000,0000,0000,,Мен сені міндетті түрде барып өлтіремін.
Dialogue: 0,0:59:07.94,0:59:10.95,Default,,0000,0000,0000,,Иә, мен сені күтемін➡
Dialogue: 0,0:59:10.95,0:59:13.05,Default,,0000,0000,0000,,Әпке.
Dialogue: 0,0:59:16.12,0:59:19.79,Default,,0000,0000,0000,,Қарғыс атсын… Әпке….
Dialogue: 0,0:59:19.79,0:59:22.09,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:59:30.63,0:59:37.31,Default,,0000,0000,0000,,Қайтып оралғаныма қуаныштымын, Ассасин.
Dialogue: 0,0:59:30.63,0:59:37.31,Default,,0000,0000,0000,,Сиқыршы-доно. Ол әлі тірі ме?
Dialogue: 0,0:59:37.31,0:59:40.81,Default,,0000,0000,0000,,Дегенмен.
Dialogue: 0,0:59:37.31,0:59:40.81,Default,,0000,0000,0000,,Бірақ менің қазіргі күйімде➡
Dialogue: 0,0:59:40.81,0:59:44.48,Default,,0000,0000,0000,,Мен Онушиге жіберетін сиқырлы күшті де жасай алмаймын.
Dialogue: 0,0:59:44.48,0:59:50.49,Default,,0000,0000,0000,,Сакура Бұл ауыртпалық, бірақ
Dialogue: 0,0:59:44.48,0:59:50.49,Default,,0000,0000,0000,,Ассасинмен мәміле жаса.
Dialogue: 0,0:59:52.66,0:59:54.66,Default,,0000,0000,0000,,Шие гүлдері.
Dialogue: 0,0:59:58.33,1:00:01.66,Default,,0000,0000,0000,,Сиқыршы-доно. Бұл әйел➡
Dialogue: 0,1:00:01.66,1:00:04.83,Default,,0000,0000,0000,,Енді жоқ...
Dialogue: 0,1:00:04.83,1:00:09.17,Default,,0000,0000,0000,,Хмм, шымылдық қосылды
Dialogue: 0,1:00:04.83,1:00:09.17,Default,,0000,0000,0000,,Бұл ақылсыз болды.
Dialogue: 0,1:00:09.17,1:00:13.18,Default,,0000,0000,0000,,Жоспарлағандай бұл қыз ше?
Dialogue: 0,1:00:13.18,1:00:18.35,Default,,0000,0000,0000,,Нашар тыңдаушы.
Dialogue: 0,1:00:13.18,1:00:18.35,Default,,0000,0000,0000,,Бұл тек таңдау мәселесі.
Dialogue: 0,1:00:18.35,1:00:21.68,Default,,0000,0000,0000,,Сакурамен қоштасу.
Dialogue: 0,1:00:18.35,1:00:21.68,Default,,0000,0000,0000,,(жәндіктердің шырылдаған дыбысы)
Dialogue: 0,1:00:21.68,1:00:25.19,Default,,0000,0000,0000,,Тәжірибелік жұмыс ретінде табанды.
Dialogue: 0,1:00:21.68,1:00:25.19,Default,,0000,0000,0000,,(жәндіктердің шырылдаған дыбысы)
Dialogue: 0,1:00:25.19,1:00:28.36,Default,,0000,0000,0000,,Жақсы жұмыс, сен мені қуанттың.
Dialogue: 0,1:00:25.19,1:00:28.36,Default,,0000,0000,0000,,(Жәндіктердің шырылдаған дыбысы)
Dialogue: 0,1:00:28.36,1:00:30.86,Default,,0000,0000,0000,,Мұның қажеті жоқ.
Dialogue: 0,1:00:30.86,1:00:33.06,Default,,0000,0000,0000,,А...?
Dialogue: 0,1:00:35.03,1:00:37.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:00:41.97,1:00:45.78,Default,,0000,0000,0000,,Жақсы! Гах... Гах...
Dialogue: 0,1:00:49.81,1:00:54.98,Default,,0000,0000,0000,,Гааааааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,1:00:54.98,1:01:00.49,Default,,0000,0000,0000,,Бастапқыда бұл не?
Dialogue: 0,1:00:54.98,1:01:00.49,Default,,0000,0000,0000,,Беті жоқ адам еді.
Dialogue: 0,1:01:00.49,1:01:04.16,Default,,0000,0000,0000,,Құрметті мырза….
Dialogue: 0,1:01:04.16,1:01:07.66,Default,,0000,0000,0000,,Сен ештеңе емессің.
Dialogue: 0,1:01:07.66,1:01:10.87,Default,,0000,0000,0000,,Мен жалғыз шынайы бола алмаймын.
Dialogue: 0,1:01:12.84,1:01:18.04,Default,,0000,0000,0000,,Менің… на мае….
Dialogue: 0,1:01:20.84,1:01:25.05,Default,,0000,0000,0000,,Не істеп жатырсың, Сакура?
Dialogue: 0,1:01:27.02,1:01:29.85,Default,,0000,0000,0000,,Өйткені қарт адам➡
Dialogue: 0,1:01:29.85,1:01:33.36,Default,,0000,0000,0000,,Оның мені қорғауы маған керек емес.
Dialogue: 0,1:01:29.85,1:01:33.36,Default,,0000,0000,0000,,Жоқ, солай ма?
Dialogue: 0,1:01:36.03,1:01:38.03,Default,,0000,0000,0000,,Дұрыс, болды!
Dialogue: 0,1:01:38.03,1:01:40.03,Default,,0000,0000,0000,,Неліктен қарт➡
Dialogue: 0,1:01:40.03,1:01:43.63,Default,,0000,0000,0000,,Мен үшін
Dialogue: 0,1:01:40.03,1:01:43.63,Default,,0000,0000,0000,,Осындай үлкен тіршілікпен➡
Dialogue: 0,1:01:43.63,1:01:47.14,Default,,0000,0000,0000,,Сіз мені босата аласыз ба?
Dialogue: 0,1:01:49.31,1:01:51.81,Default,,0000,0000,0000,,Мен мұқият тексердім.
Dialogue: 0,1:01:55.81,1:02:00.48,Default,,0000,0000,0000,,Менің кейбір жүйкем
Dialogue: 0,1:01:55.81,1:02:00.48,Default,,0000,0000,0000,,Ол ауыстырылды.
Dialogue: 0,1:02:00.48,1:02:04.49,Default,,0000,0000,0000,,Хехе. Ата➡
Dialogue: 0,1:02:04.49,1:02:07.79,Default,,0000,0000,0000,,Мен оны үлкенірек деп ойладым.
Dialogue: 0,1:02:09.99,1:02:14.16,Default,,0000,0000,0000,,Тоқта, күт, Сакура...!
Dialogue: 0,1:02:14.16,1:02:18.07,Default,,0000,0000,0000,,Қош бол, қария.
Dialogue: 0,1:02:25.84,1:02:27.84,Default,,0000,0000,0000,,А... иә...
Dialogue: 0,1:02:27.84,1:02:31.35,Default,,0000,0000,0000,,Менің ағам да, атам да
Dialogue: 0,1:02:27.84,1:02:31.35,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,1:02:31.35,1:02:33.68,Default,,0000,0000,0000,,Қазір...
Dialogue: 0,1:02:33.68,1:02:37.19,Default,,0000,0000,0000,,Қазір...
Dialogue: 0,1:02:37.19,1:02:40.69,Default,,0000,0000,0000,,Тек… бала сенің жаныңнан алыстап бара жатқанда…
Dialogue: 0,1:02:40.69,1:02:44.69,Default,,0000,0000,0000,,Мен не істеуім керек...?
Dialogue: 0,1:02:46.96,1:02:52.80,Default,,0000,0000,0000,,Ууууууууууууууууууууууууууууууууууу...
Dialogue: 0,1:02:52.80,1:02:58.64,Default,,0000,0000,0000,,Әлі жоқ.
Dialogue: 0,1:02:52.80,1:02:58.64,Default,,0000,0000,0000,,Олар әлі де сол жерде.
Dialogue: 0,1:02:58.64,1:03:01.64,Default,,0000,0000,0000,,Олар келе жатыр.
Dialogue: 0,1:03:04.98,1:03:09.32,Default,,0000,0000,0000,,Бару.
Dialogue: 0,1:03:04.98,1:03:09.32,Default,,0000,0000,0000,,Мұнда менің әпкем ғана келе алады.
Dialogue: 0,1:03:09.32,1:03:11.62,Default,,0000,0000,0000,,Ширу Эмия ше?
Dialogue: 0,1:03:13.82,1:03:16.03,Default,,0000,0000,0000,,Бұл….
Dialogue: 0,1:03:20.50,1:04:11.81,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:04:11.81,1:04:16.52,Default,,0000,0000,0000,,《Мен таң қалдым. Мен осылаймын...》
Dialogue: 0,1:04:19.16,1:04:24.06,Default,,0000,0000,0000,,《Шие гүлдері маңызды болды》
Dialogue: 0,1:04:28.16,1:04:31.50,Default,,0000,0000,0000,,Олай болса, кеттік.
Dialogue: 0,1:04:31.50,1:04:37.01,Default,,0000,0000,0000,,Рин Райдер Ширу.
Dialogue: 0,1:04:41.01,1:04:44.95,Default,,0000,0000,0000,,Илья Осы шайқас біткен соң➡
Dialogue: 0,1:04:44.95,1:04:48.12,Default,,0000,0000,0000,,Қайтаратын жеріңіз болмаса➡
Dialogue: 0,1:04:48.12,1:04:51.79,Default,,0000,0000,0000,,Неге үйде отырмайсың?
Dialogue: 0,1:04:51.79,1:04:55.12,Default,,0000,0000,0000,,Кирицугу орнына?
Dialogue: 0,1:04:55.12,1:05:00.96,Default,,0000,0000,0000,,Жоқ, Кирицугу екеуміз басқа адамдармыз.
Dialogue: 0,1:05:00.96,1:05:03.57,Default,,0000,0000,0000,,Бірақ мен...
Dialogue: 0,1:05:10.81,1:05:13.48,Default,,0000,0000,0000,,Широ еңкейіп отыр.
Dialogue: 0,1:05:13.48,1:05:16.98,Default,,0000,0000,0000,,Не? А... аа.
Dialogue: 0,1:05:24.82,1:05:28.49,Default,,0000,0000,0000,,Эхехе... Қайтадан қош келдіңіз, Ширу.
Dialogue: 0,1:05:28.49,1:05:33.00,Default,,0000,0000,0000,,Таң атқанша
Dialogue: 0,1:05:28.49,1:05:33.00,Default,,0000,0000,0000,,Сакураны үйге әкеліңіз.
Dialogue: 0,1:05:35.16,1:05:37.17,Default,,0000,0000,0000,,Иә….
Dialogue: 0,1:05:49.95,1:05:56.29,Default,,0000,0000,0000,,Жоғарғы тоғанда бір оқиға болды.
Dialogue: 0,1:05:49.95,1:05:56.29,Default,,0000,0000,0000,,Мен оны жасап жатқандай сезінемін.
Dialogue: 0,1:05:56.29,1:05:58.95,Default,,0000,0000,0000,,Ол жер сыртқы қақпа.
Dialogue: 0,1:05:58.95,1:06:03.63,Default,,0000,0000,0000,,Ұлы Қасиетті Граилға барғыңыз келсе...
Dialogue: 0,1:06:03.63,1:06:06.46,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:06:06.46,1:06:09.97,Default,,0000,0000,0000,,Сіз жоғары емес, төмен түсуіңіз керек.
Dialogue: 0,1:06:13.97,1:06:15.97,Default,,0000,0000,0000,,Төмен….
Dialogue: 0,1:06:15.97,1:06:38.16,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:06:38.16,1:06:40.16,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:06:48.27,1:06:52.78,Default,,0000,0000,0000,,Ширу?
Dialogue: 0,1:06:48.27,1:06:52.78,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,1:06:52.78,1:06:57.45,Default,,0000,0000,0000,,Сақтықты төмендетпеңіз. Осыдан бастап
Dialogue: 0,1:06:52.78,1:06:57.45,Default,,0000,0000,0000,,Өміріңізге басымдық беріңіз.
Dialogue: 0,1:06:57.45,1:07:12.46,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:07:16.97,1:07:19.27,Default,,0000,0000,0000,,Сабер.
Dialogue: 0,1:07:21.64,1:07:23.84,Default,,0000,0000,0000,,Рин.
Dialogue: 0,1:07:26.64,1:07:28.64,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:07:30.81,1:07:34.32,Default,,0000,0000,0000,,Сакура, шын айтасың ба?
Dialogue: 0,1:07:39.82,1:07:43.13,Default,,0000,0000,0000,,Бұл өте жаман. Мен сені бірінші жіберемін.
Dialogue: 0,1:07:46.43,1:07:51.27,Default,,0000,0000,0000,,Сакураға көмектескіңіз келсе
Dialogue: 0,1:07:46.43,1:07:51.27,Default,,0000,0000,0000,,Кеш қалмаңыз.
Dialogue: 0,1:07:51.27,1:08:09.79,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:08:09.79,1:08:14.29,Default,,0000,0000,0000,,Сабер Қандай болмасын
Dialogue: 0,1:08:09.79,1:08:14.29,Default,,0000,0000,0000,,Бұл сізді ұстамайды.
Dialogue: 0,1:08:14.29,1:08:17.79,Default,,0000,0000,0000,,Шаршадым. Бұл менің рөлім.
Dialogue: 0,1:08:20.30,1:08:24.30,Default,,0000,0000,0000,,Бар күшіңді салсаң
Dialogue: 0,1:08:20.30,1:08:24.30,Default,,0000,0000,0000,,Екі минутты теңестіруге болады.
Dialogue: 0,1:08:24.30,1:08:27.10,Default,,0000,0000,0000,,Жағдайды жасаймын.
Dialogue: 0,1:08:29.31,1:08:33.11,Default,,0000,0000,0000,,Сіз қозғалмайсыз
Dialogue: 0,1:08:29.31,1:08:33.11,Default,,0000,0000,0000,,Өз мүмкіндігіңізді жіберіп алмаңыз.
Dialogue: 0,1:08:36.98,1:08:42.42,Default,,0000,0000,0000,,Сабер Мен сені осында құртамын.
Dialogue: 0,1:08:42.42,1:08:45.22,Default,,0000,0000,0000,,Сакураға көмектесу үшін...
Dialogue: 0,1:08:47.92,1:08:51.09,Default,,0000,0000,0000,,Сіз мазасыз адамсыз.
Dialogue: 0,1:08:51.09,1:08:53.43,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:08:53.43,1:10:08.34,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:10:08.34,1:10:12.64,Default,,0000,0000,0000,,Бұл... Ұлы Қасиетті Граил.
Dialogue: 0,1:10:20.18,1:10:23.89,Default,,0000,0000,0000,,Сонымен қашпай келдің.
Dialogue: 0,1:10:28.36,1:10:31.06,Default,,0000,0000,0000,,Мен бұл туралы ойладым.
Dialogue: 0,1:10:33.03,1:10:36.87,Default,,0000,0000,0000,,Мен бұл дүниені жек көремін.
Dialogue: 0,1:10:36.87,1:10:43.47,Default,,0000,0000,0000,,Менің үйім, әпкем және атам.
Dialogue: 0,1:10:36.87,1:10:43.47,Default,,0000,0000,0000,,Бейшара аға➡
Dialogue: 0,1:10:43.47,1:10:45.81,Default,,0000,0000,0000,,Бейбіт қала көрінісі.
Dialogue: 0,1:10:45.81,1:10:51.15,Default,,0000,0000,0000,,Сен маған осы уақытқа дейін көмектескен жоқсың.
Dialogue: 0,1:10:45.81,1:10:51.15,Default,,0000,0000,0000,,Барлығы қабылданбайды.
Dialogue: 0,1:10:51.15,1:10:56.49,Default,,0000,0000,0000,,Бұл хит
Dialogue: 0,1:10:51.15,1:10:56.49,Default,,0000,0000,0000,,Мен оның жаман екенін білемін.
Dialogue: 0,1:10:56.49,1:11:00.66,Default,,0000,0000,0000,,Бірақ мен күшейіп кеттім.
Dialogue: 0,1:11:00.66,1:11:03.83,Default,,0000,0000,0000,,Қорқып қалмаңдар
Dialogue: 0,1:11:00.66,1:11:03.83,Default,,0000,0000,0000,,Енді мен мұны істей аламын.
Dialogue: 0,1:11:03.83,1:11:08.16,Default,,0000,0000,0000,,Иә. Сіз әлі адамдарды өлтіруге үйрендіңіз бе?
Dialogue: 0,1:11:08.16,1:11:14.17,Default,,0000,0000,0000,,Иә. Ассасин және қарт
Dialogue: 0,1:11:08.16,1:11:14.17,Default,,0000,0000,0000,,Ол кетті. Қалғаны...
Dialogue: 0,1:11:14.17,1:11:17.34,Default,,0000,0000,0000,,Бірақ Ширу ше?
Dialogue: 0,1:11:17.34,1:11:23.35,Default,,0000,0000,0000,,Ол сені әлі де жақсы көреді
Dialogue: 0,1:11:17.34,1:11:23.35,Default,,0000,0000,0000,,Мен сізге көмектесе алатыныма сенемін.
Dialogue: 0,1:11:23.35,1:11:28.02,Default,,0000,0000,0000,,Менің өлтіргім келетін нәрсе
Dialogue: 0,1:11:23.35,1:11:28.02,Default,,0000,0000,0000,,Тек сол адам.
Dialogue: 0,1:11:28.02,1:11:32.69,Default,,0000,0000,0000,,Иә. Сіз баяғыда адам болуды қойғансыз.
Dialogue: 0,1:11:32.69,1:11:35.52,Default,,0000,0000,0000,,Бұл батылдық.
Dialogue: 0,1:11:35.52,1:11:38.03,Default,,0000,0000,0000,,Сіз бұл күшті қызғанасыз ба?
Dialogue: 0,1:11:38.03,1:11:43.33,Default,,0000,0000,0000,,Ендеше, оны алып кет, сонда мен ғана боламын
Dialogue: 0,1:11:38.03,1:11:43.33,Default,,0000,0000,0000,,Мен бақытты болғым келеді.
Dialogue: 0,1:11:52.98,1:11:59.98,Default,,0000,0000,0000,,Берілмеген. Әпкеңізге не беру керек
Dialogue: 0,1:11:52.98,1:11:59.98,Default,,0000,0000,0000,,Тек өкініш пен үмітсіздік.
Dialogue: 0,1:11:59.98,1:12:09.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:12:09.99,1:12:16.60,Default,,0000,0000,0000,,Көлге құлаған бөтендей
Dialogue: 0,1:12:09.99,1:12:16.60,Default,,0000,0000,0000,,Көктегі тостағанға батып кет.
Dialogue: 0,1:12:19.67,1:12:40.86,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:12:40.86,1:12:44.46,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:12:40.86,1:12:44.46,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:12:44.46,1:12:46.96,Default,,0000,0000,0000,,Әй!
Dialogue: 0,1:12:46.96,1:13:05.31,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:13:05.31,1:13:07.32,Default,,0000,0000,0000,,Дұрыс, болды!
Dialogue: 0,1:13:07.32,1:13:15.32,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:13:15.32,1:13:17.66,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,1:13:17.66,1:13:27.84,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:13:27.84,1:13:31.01,Default,,0000,0000,0000,,Жаман көздің қарғысы...!
Dialogue: 0,1:13:31.01,1:13:33.01,Default,,0000,0000,0000,,Әй!
Dialogue: 0,1:13:36.35,1:13:38.55,Default,,0000,0000,0000,,Уф!
Dialogue: 0,1:13:42.28,1:13:45.45,Default,,0000,0000,0000,,｟Шартшы Менің сенен сұрайтыным бар.
Dialogue: 0,1:13:45.45,1:13:50.96,Default,,0000,0000,0000,,Сабер қызметші болуы керек
Dialogue: 0,1:13:45.45,1:13:50.96,Default,,0000,0000,0000,,Сіз мені ренжіте алмайсыз ба?
Dialogue: 0,1:13:50.96,1:13:55.96,Default,,0000,0000,0000,,Жоқ, шие гүлі ұстап алған қызметші
Dialogue: 0,1:13:50.96,1:13:55.96,Default,,0000,0000,0000,,Инкарнация.
Dialogue: 0,1:13:55.96,1:13:59.07,Default,,0000,0000,0000,,Күшті салтанатты көйлек болса, ол...
Dialogue: 0,1:14:01.47,1:14:06.07,Default,,0000,0000,0000,,Тағы бір нәрсе
Dialogue: 0,1:14:01.47,1:14:06.07,Default,,0000,0000,0000,,Бұл ұрыс кезіндегі стратегия.
Dialogue: 0,1:14:12.65,1:14:16.32,Default,,0000,0000,0000,,Сіз бұл әдісті жеңе алатыныңыз рас.
Dialogue: 0,1:14:16.32,1:14:19.15,Default,,0000,0000,0000,,Дұрыс? Мәселе мынада...
Dialogue: 0,1:14:19.15,1:14:24.83,Default,,0000,0000,0000,,Бұл өзара сенім, Ширу.
Dialogue: 0,1:14:24.83,1:14:31.67,Default,,0000,0000,0000,,Сіздің одақтасыңызға қауіп төнсе де,
Dialogue: 0,1:14:24.83,1:14:31.67,Default,,0000,0000,0000,,Сіз бір орында тұра аласыз ба?
Dialogue: 0,1:14:31.67,1:14:36.17,Default,,0000,0000,0000,,Сізге ең ұнамайтын нәрсе
Dialogue: 0,1:14:31.67,1:14:36.17,Default,,0000,0000,0000,,Сұраныс｠
Dialogue: 0,1:14:39.17,1:14:41.51,Default,,0000,0000,0000,,Ух... Каха.
Dialogue: 0,1:14:41.51,1:14:43.45,Default,,0000,0000,0000,,Ах... Уф!
Dialogue: 0,1:14:43.45,1:14:49.45,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:14:49.45,1:14:51.62,Default,,0000,0000,0000,,Мен сенемін!
Dialogue: 0,1:14:51.62,1:15:08.14,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:15:08.14,1:15:11.14,Default,,0000,0000,0000,,Сізге Ширу қызық па?
Dialogue: 0,1:15:11.14,1:15:13.31,Default,,0000,0000,0000,,Ол қозғалмайды.
Dialogue: 0,1:15:13.31,1:15:17.65,Default,,0000,0000,0000,,Өйткені маған сенеді.
Dialogue: 0,1:15:17.65,1:15:22.48,Default,,0000,0000,0000,,А, мен сенемін...
Dialogue: 0,1:15:22.48,1:15:24.49,Default,,0000,0000,0000,,Боқ.
Dialogue: 0,1:15:30.99,1:15:33.33,Default,,0000,0000,0000,,Уф!
Dialogue: 0,1:15:33.33,1:16:49.44,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:16:49.44,1:16:51.74,Default,,0000,0000,0000,,Тоқыраудың осы деңгейімен!
Dialogue: 0,1:16:56.61,1:16:58.61,Default,,0000,0000,0000,,Асыл фантасма.
Dialogue: 0,1:17:04.12,1:17:06.62,Default,,0000,0000,0000,,Келесің бе?
Dialogue: 0,1:17:06.62,1:17:15.63,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:17:15.63,1:17:18.80,Default,,0000,0000,0000,,Проекцияның басталуы.
Dialogue: 0,1:17:18.80,1:17:21.47,Default,,0000,0000,0000,,Іздеу сайлауы.
Dialogue: 0,1:17:21.47,1:17:23.77,Default,,0000,0000,0000,,Талдау.
Dialogue: 0,1:17:27.14,1:17:31.05,Default,,0000,0000,0000,,Мен сөздің сүйегімін.
Dialogue: 0,1:17:32.98,1:17:34.98,Default,,0000,0000,0000,,Заң.
Dialogue: 0,1:17:34.98,1:17:37.09,Default,,0000,0000,0000,,Ex!
Dialogue: 0,1:17:39.49,1:17:42.59,Default,,0000,0000,0000,,Аия!
Dialogue: 0,1:17:42.59,1:17:44.59,Default,,0000,0000,0000,,Калибур!
Dialogue: 0,1:17:46.76,1:17:54.94,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:17:54.94,1:18:00.28,Default,,0000,0000,0000,,Ааааааааааааааааааааа!
Dialogue: 0,1:18:00.28,1:18:02.28,Default,,0000,0000,0000,,Берле….
Dialogue: 0,1:18:04.78,1:18:07.45,Default,,0000,0000,0000,,Қоян!
Dialogue: 0,1:18:07.45,1:18:09.45,Default,,0000,0000,0000,,
Dialogue: 0,1:18:09.45,1:18:40.78,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:18:54.10,1:18:58.00,Default,,0000,0000,0000,,А... Ширу?
Dialogue: 0,1:19:09.95,1:19:11.95,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,1:19:11.95,1:19:16.25,Default,,0000,0000,0000,,Сен мені талай рет құтқардың.
Dialogue: 0,1:19:38.31,1:19:42.01,Default,,0000,0000,0000,,Алға.
Dialogue: 0,1:19:38.31,1:19:42.01,Default,,0000,0000,0000,,Жүгіре алатын кезде маған кел.
Dialogue: 0,1:19:45.48,1:19:50.99,Default,,0000,0000,0000,,Хмм... мен ойлағаннан да көп.
Dialogue: 0,1:19:45.48,1:19:50.99,Default,,0000,0000,0000,,Сіз адамдармен дөрекісіз, солай емес пе?
Dialogue: 0,1:20:08.84,1:20:10.84,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,1:20:17.18,1:20:31.36,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:20:31.36,1:20:33.36,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:20:36.87,1:20:38.87,Default,,0000,0000,0000,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,1:20:45.64,1:20:47.81,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:20:47.81,1:21:08.33,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:21:08.33,1:21:10.83,Default,,0000,0000,0000,,Өтірік….
Dialogue: 0,1:21:14.50,1:21:18.67,Default,,0000,0000,0000,,Неге...
Dialogue: 0,1:21:14.50,1:21:18.67,Default,,0000,0000,0000,,Ештеңе➡
Dialogue: 0,1:21:18.67,1:21:22.34,Default,,0000,0000,0000,,Бұл тек таза күш ойыны.
Dialogue: 0,1:21:22.34,1:21:27.02,Default,,0000,0000,0000,,Бұл... және бірдеңе...!
Dialogue: 0,1:21:27.02,1:21:29.68,Default,,0000,0000,0000,,Түсінбейсіз бе? сакура.
Dialogue: 0,1:21:29.68,1:21:34.52,Default,,0000,0000,0000,,Бұл Тохсакада өткен зерлі қылыш.
Dialogue: 0,1:21:29.68,1:21:34.52,Default,,0000,0000,0000,,Зелретч.
Dialogue: 0,1:21:34.52,1:21:38.69,Default,,0000,0000,0000,,шексіз үздіксіз болуы керек
Dialogue: 0,1:21:34.52,1:21:38.69,Default,,0000,0000,0000,,Жолды параллель әлемдерге қосу➡
Dialogue: 0,1:21:38.69,1:21:41.36,Default,,0000,0000,0000,,Сиқырлы күшті бағыттайтын нәрсе.
Dialogue: 0,1:21:41.36,1:21:46.07,Default,,0000,0000,0000,,Иә? Зеру... Болсын ба?
Dialogue: 0,1:21:48.30,1:21:52.31,Default,,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,1:21:48.30,1:21:52.31,Default,,0000,0000,0000,,Мен тіпті Зелретчтің атын да білмеймін.
Dialogue: 0,1:21:52.31,1:21:54.61,Default,,0000,0000,0000,,Мені мазақ ет!
Dialogue: 0,1:21:58.81,1:22:00.82,Default,,0000,0000,0000,,Қанша жад орныңыз болса да➡
Dialogue: 0,1:22:00.82,1:22:03.99,Default,,0000,0000,0000,,Сакура бір уақытта шығаратын сиқырлы күштің мөлшері ➡
Dialogue: 0,1:22:03.99,1:22:06.32,Default,,0000,0000,0000,,Менен көп айырмашылығы жоқ.
Dialogue: 0,1:22:06.32,1:22:08.82,Default,,0000,0000,0000,,Сондықтан мен ➡ дайындаламын
Dialogue: 0,1:22:08.82,1:22:11.63,Default,,0000,0000,0000,,Сиқырдың бұл мөлшері әр жолы жеткілікті.
Dialogue: 0,1:22:17.17,1:22:20.17,Default,,0000,0000,0000,,Сиқырлы күштің осындай ақымақ бассейні➡
Dialogue: 0,1:22:20.17,1:22:23.17,Default,,0000,0000,0000,,Бар болса да қазынаңды ұстама!
Dialogue: 0,1:22:32.68,1:22:34.88,Default,,0000,0000,0000,,Қулық.
Dialogue: 0,1:22:37.02,1:22:39.52,Default,,0000,0000,0000,,Айла ....
Dialogue: 0,1:22:46.29,1:22:48.80,Default,,0000,0000,0000,,Бұл жасырын ...
Dialogue: 0,1:22:48.80,1:23:08.48,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:23:08.48,1:23:13.09,Default,,0000,0000,0000,,Жоғары ұшып бара жатқан бас
Dialogue: 0,1:23:08.48,1:23:13.09,Default,,0000,0000,0000,,Аздап суыды ма?
Dialogue: 0,1:23:16.16,1:23:20.50,Default,,0000,0000,0000,,Бұл әділ емес.
Dialogue: 0,1:23:20.50,1:23:22.50,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,1:23:22.50,1:23:27.67,Default,,0000,0000,0000,,Бір апалы-сіңлілі болсақ та, содан бері көп уақыт өтті
Dialogue: 0,1:23:22.50,1:23:27.67,Default,,0000,0000,0000,,Маған адам сияқты қараған жоқ!
Dialogue: 0,1:23:27.67,1:23:34.01,Default,,0000,0000,0000,,Денеме ойып алған Макири сиқыры
Dialogue: 0,1:23:27.67,1:23:34.01,Default,,0000,0000,0000,,Тағам да уланды.
Dialogue: 0,1:23:34.01,1:23:38.68,Default,,0000,0000,0000,,Тамақтану
Dialogue: 0,1:23:34.01,1:23:38.68,Default,,0000,0000,0000,,Бұл жай ғана қорқынышты және азапты.
Dialogue: 0,1:23:38.68,1:23:44.62,Default,,0000,0000,0000,,Мушикурада, тіпті жай тыныс алу
Dialogue: 0,1:23:38.68,1:23:44.62,Default,,0000,0000,0000,,Кешірім қажет.
Dialogue: 0,1:23:44.62,1:23:46.62,Default,,0000,0000,0000,,Жылаған сайын➡
Dialogue: 0,1:23:46.62,1:23:51.13,Default,,0000,0000,0000,,Сол адамдар
Dialogue: 0,1:23:46.62,1:23:51.13,Default,,0000,0000,0000,,Ол қуана менің денеммен ойнай берді...!
Dialogue: 0,1:23:51.13,1:23:55.30,Default,,0000,0000,0000,,Осы арада, әпкем
Dialogue: 0,1:23:51.13,1:23:55.30,Default,,0000,0000,0000,,Әрқашан жарқырап➡
Dialogue: 0,1:23:55.30,1:23:59.47,Default,,0000,0000,0000,,Қиындықты білмей өстім.
Dialogue: 0,1:23:55.30,1:23:59.47,Default,,0000,0000,0000,,Бұл жиіркенішті болды.
Dialogue: 0,1:23:59.47,1:24:02.64,Default,,0000,0000,0000,,Мен жеңгім келді.
Dialogue: 0,1:24:02.64,1:24:08.31,Default,,0000,0000,0000,,Бірде әпкем маған оның керемет екенін айтты.
Dialogue: 0,1:24:02.64,1:24:08.31,Default,,0000,0000,0000,,Мені мақтауларыңызды сұрадым!
Dialogue: 0,1:24:08.31,1:24:12.98,Default,,0000,0000,0000,,Өйткені мен шын мәнінде Тохсақаның баласымын.
Dialogue: 0,1:24:12.98,1:24:16.15,Default,,0000,0000,0000,,Сіздің әпкеңіз
Dialogue: 0,1:24:12.98,1:24:16.15,Default,,0000,0000,0000,,Ол маған көмектесуге келеді➡
Dialogue: 0,1:24:16.15,1:24:18.49,Default,,0000,0000,0000,,Мен сендім...!
Dialogue: 0,1:24:18.49,1:24:23.32,Default,,0000,0000,0000,,Бірақ менің әпкем
Dialogue: 0,1:24:18.49,1:24:23.32,Default,,0000,0000,0000,,Ол келмеді...!
Dialogue: 0,1:24:23.32,1:24:28.83,Default,,0000,0000,0000,,11 жыл болды. Бұл ақылсыз, солай емес пе?
Dialogue: 0,1:24:28.83,1:24:32.33,Default,,0000,0000,0000,,Бірақ бұл менің кінәм бе?
Dialogue: 0,1:24:32.33,1:24:37.67,Default,,0000,0000,0000,,Күнде ауырады, ауырады, ауырады, ауырады.
Dialogue: 0,1:24:37.67,1:24:41.84,Default,,0000,0000,0000,,Мен сені ұнатқандықтан мұндай болмадым.
Dialogue: 0,1:24:41.84,1:24:45.85,Default,,0000,0000,0000,,Бұлай болудан басқа амал қалмады...!
Dialogue: 0,1:24:49.28,1:24:53.49,Default,,0000,0000,0000,,Сонымен не керек?
Dialogue: 0,1:24:49.28,1:24:53.49,Default,,0000,0000,0000,,Бұл.
Dialogue: 0,1:24:56.46,1:24:58.79,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:24:58.79,1:25:02.80,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,1:24:58.79,1:25:02.80,Default,,0000,0000,0000,,Енді ауырмайды, солай ма?
Dialogue: 0,1:25:05.47,1:25:10.97,Default,,0000,0000,0000,,Жарайды... менің апам осындай!
Dialogue: 0,1:25:10.97,1:25:15.31,Default,,0000,0000,0000,,Мен басқалардың қайғысына мән бермеймін.
Dialogue: 0,1:25:10.97,1:25:15.31,Default,,0000,0000,0000,,Мен түсінбеймін.
Dialogue: 0,1:25:15.31,1:25:17.98,Default,,0000,0000,0000,,Сондықтан шие гүлдейді➡
Dialogue: 0,1:25:17.98,1:25:20.48,Default,,0000,0000,0000,,Күндер қанша жаман болса да
Dialogue: 0,1:25:17.98,1:25:20.48,Default,,0000,0000,0000,,Олар сізге жіберсе де➡
Dialogue: 0,1:25:20.48,1:25:23.59,Default,,0000,0000,0000,,Мен тіпті түсінуге тырыспаймын.
Dialogue: 0,1:25:26.32,1:25:31.83,Default,,0000,0000,0000,,Бірақ шие гүлдейді
Dialogue: 0,1:25:26.32,1:25:31.83,Default,,0000,0000,0000,,Тіпті мұндай сезімсіз адам.
Dialogue: 0,1:25:31.83,1:25:36.50,Default,,0000,0000,0000,,Мен қаншалықты бақытты екенімді сене алар емеспін➡
Dialogue: 0,1:25:36.50,1:25:41.00,Default,,0000,0000,0000,,Бұл менің ойыма да келмеді.
Dialogue: 0,1:25:41.00,1:25:43.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:25:47.94,1:25:50.25,Default,,0000,0000,0000,,Ал...
Dialogue: 0,1:25:52.28,1:25:55.28,Default,,0000,0000,0000,,Міне... болды!
Dialogue: 0,1:25:57.29,1:25:59.29,Default,,0000,0000,0000,,Шие гүлдері.
Dialogue: 0,1:26:03.29,1:26:06.79,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:26:06.79,1:26:10.63,Default,,0000,0000,0000,,Уэлт, Энде.
Dialogue: 0,1:26:10.63,1:26:12.63,Default,,0000,0000,0000,,Уф!
Dialogue: 0,1:26:12.63,1:26:15.04,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:26:24.65,1:26:41.33,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:26:41.33,1:26:43.33,Default,,0000,0000,0000,,｟Ха!
Dialogue: 0,1:26:50.94,1:26:54.54,Default,,0000,0000,0000,,Хе хи!
Dialogue: 0,1:27:02.45,1:27:05.45,Default,,0000,0000,0000,,《Жоқ, бұл》｠
Dialogue: 0,1:27:14.80,1:27:18.47,Default,,0000,0000,0000,,Ах... Ха!
Dialogue: 0,1:27:18.47,1:27:22.47,Default,,0000,0000,0000,,Эй... мырза...?
Dialogue: 0,1:27:26.47,1:27:28.48,Default,,0000,0000,0000,,Ха!
Dialogue: 0,1:27:30.48,1:27:32.81,Default,,0000,0000,0000,,Мен ақымақпын.
Dialogue: 0,1:27:32.81,1:27:37.82,Default,,0000,0000,0000,,Бірақ барынша тырысқандар үшін
Dialogue: 0,1:27:32.81,1:27:37.82,Default,,0000,0000,0000,,Сыйлық болмаса, шыдай алмаймын.
Dialogue: 0,1:27:37.82,1:27:40.99,Default,,0000,0000,0000,,Маған Сакура ұнайды.
Dialogue: 0,1:27:40.99,1:27:44.49,Default,,0000,0000,0000,,Мен сенің әрқашан күліп жүргеніңді қалаймын.
Dialogue: 0,1:27:48.10,1:27:50.60,Default,,0000,0000,0000,,Мен үшін соғұрлым ауыр болады➡
Dialogue: 0,1:27:50.60,1:27:55.10,Default,,0000,0000,0000,,Мен сені жақсы өткізіп жатырсың деп естідім.
Dialogue: 0,1:27:50.60,1:27:55.10,Default,,0000,0000,0000,,Мен сенгім келді.
Dialogue: 0,1:27:55.10,1:28:00.11,Default,,0000,0000,0000,,Ширу туралы да олай айта алмаймын.
Dialogue: 0,1:28:04.11,1:28:09.12,Default,,0000,0000,0000,,Шие гүлін жақыннан көргенде
Dialogue: 0,1:28:04.11,1:28:09.12,Default,,0000,0000,0000,,Мен сені өлтіре алмайтынымды түсіндім.
Dialogue: 0,1:28:09.12,1:28:14.79,Default,,0000,0000,0000,,Өзімшіл апа болғаным үшін кешіріңіз...
Dialogue: 0,1:28:14.79,1:28:18.96,Default,,0000,0000,0000,,Ал... мына лента...
Dialogue: 0,1:28:18.96,1:28:23.97,Default,,0000,0000,0000,,Оны үнемі киіп жүргеніңіз үшін рахмет.
Dialogue: 0,1:28:18.96,1:28:23.97,Default,,0000,0000,0000,,​​Мен бақытты болдым.
Dialogue: 0,1:28:29.80,1:28:31.81,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:28:47.76,1:28:54.26,Default,,0000,0000,0000,,А... Менде болды...
Dialogue: 0,1:28:54.26,1:28:58.47,Default,,0000,0000,0000,,Менде де болды... бірақ...
Dialogue: 0,1:29:00.77,1:29:06.57,Default,,0000,0000,0000,,Мен... сындырдым... оны.
Dialogue: 0,1:29:08.61,1:29:13.11,Default,,0000,0000,0000,,Ах... Ах... Ах....
Dialogue: 0,1:29:13.11,1:29:17.12,Default,,0000,0000,0000,,Ааааааааааааааааааааааааааааааааа...!
Dialogue: 0,1:29:17.12,1:29:30.97,Default,,0000,0000,0000,,(жылау)
Dialogue: 0,1:29:30.97,1:29:33.97,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,1:29:40.81,1:29:44.11,Default,,0000,0000,0000,,Сенпай….
Dialogue: 0,1:29:49.32,1:29:54.16,Default,,0000,0000,0000,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,1:29:54.16,1:29:57.16,Default,,0000,0000,0000,,Уф... Уф.
Dialogue: 0,1:29:59.99,1:30:05.50,Default,,0000,0000,0000,,Мен өлтірдім... Өлтірдім...
Dialogue: 0,1:30:05.50,1:30:08.67,Default,,0000,0000,0000,,Менің әпкем...
Dialogue: 0,1:30:08.67,1:30:14.34,Default,,0000,0000,0000,,Жоғалтпа
Dialogue: 0,1:30:08.67,1:30:14.34,Default,,0000,0000,0000,,Сіз мұны маған көптен бері айтып жүрсіз...
Dialogue: 0,1:30:14.34,1:30:21.35,Default,,0000,0000,0000,,Жоқ, мен тоқтатуым керек.
Dialogue: 0,1:30:21.35,1:30:24.19,Default,,0000,0000,0000,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,1:30:24.19,1:30:29.09,Default,,0000,0000,0000,,Тохсака жігіті жеңді.
Dialogue: 0,1:30:31.19,1:30:35.20,Default,,0000,0000,0000,,Сакура Тохсака өлген жоқ!
Dialogue: 0,1:30:35.20,1:30:37.20,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:30:37.20,1:30:41.20,Default,,0000,0000,0000,,Әлі сақталды!
Dialogue: 0,1:30:37.20,1:30:41.20,Default,,0000,0000,0000,,Сіз және мен көмектесеміз!
Dialogue: 0,1:30:41.20,1:30:43.70,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:30:45.97,1:30:51.48,Default,,0000,0000,0000,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,1:30:51.48,1:30:54.15,Default,,0000,0000,0000,,Жоқ, қаш, Сенпай!
Dialogue: 0,1:30:54.15,1:31:02.82,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:31:02.82,1:31:07.83,Default,,0000,0000,0000,,А... жоқ... басқа сенпай. мен...!
Dialogue: 0,1:31:07.83,1:31:12.13,Default,,0000,0000,0000,,Мен білемін.
Dialogue: 0,1:31:07.83,1:31:12.13,Default,,0000,0000,0000,,Өліп бара жатқан жаман баланың ісі еді.
Dialogue: 0,1:31:17.34,1:31:20.84,Default,,0000,0000,0000,,Не?
Dialogue: 0,1:31:28.02,1:31:32.02,Default,,0000,0000,0000,,Сенпай! Әпкеңді алып қаш!
Dialogue: 0,1:31:32.02,1:31:47.13,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:31:47.13,1:31:51.64,Default,,0000,0000,0000,,Сендер, үндемеңдер!➡
Dialogue: 0,1:31:51.64,1:31:55.64,Default,,0000,0000,0000,,Жоқ... Мен оны ұстай алмаймын.
Dialogue: 0,1:31:55.64,1:31:58.35,Default,,0000,0000,0000,,Қаш, Сенпай!
Dialogue: 0,1:32:03.32,1:32:05.49,Default,,0000,0000,0000,,Тоқтаңыз….
Dialogue: 0,1:32:05.49,1:32:08.32,Default,,0000,0000,0000,,Өйткені мен өлемін...
Dialogue: 0,1:32:08.32,1:32:11.99,Default,,0000,0000,0000,,Өзің ғана өлесің!
Dialogue: 0,1:32:11.99,1:32:14.50,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:32:20.00,1:32:22.84,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,1:32:22.84,1:32:25.17,Default,,0000,0000,0000,,Мен құтқара алмаймын.
Dialogue: 0,1:32:25.17,1:32:28.88,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,1:32:25.17,1:32:28.88,Default,,0000,0000,0000,,Мен сізге көмектесе алмаймын!
Dialogue: 0,1:32:37.69,1:32:39.69,Default,,0000,0000,0000,,Уг! Гү!
Dialogue: 0,1:32:52.47,1:32:55.14,Default,,0000,0000,0000,,Шие гүлдері.
Dialogue: 0,1:32:55.14,1:32:57.54,Default,,0000,0000,0000,,Кейін қалсаң, капитан мені сөгіп тастайды.
Dialogue: 0,1:33:03.64,1:33:08.48,Default,,0000,0000,0000,,Әй... Көрдің ғой, Сенпай.
Dialogue: 0,1:33:08.48,1:33:12.32,Default,,0000,0000,0000,,Мен... Мен
Dialogue: 0,1:33:08.48,1:33:12.32,Default,,0000,0000,0000,,Мен осындай адаммын.
Dialogue: 0,1:33:12.32,1:33:14.32,Default,,0000,0000,0000,,Сол себепті!
Dialogue: 0,1:33:23.00,1:33:27.17,Default,,0000,0000,0000,,Мен көп адамды өлтірдім.
Dialogue: 0,1:33:27.17,1:33:31.01,Default,,0000,0000,0000,,Менің ағам да, атам да.
Dialogue: 0,1:33:31.01,1:33:34.68,Default,,0000,0000,0000,,Менің әпкем де.
Dialogue: 0,1:33:34.68,1:33:38.35,Default,,0000,0000,0000,,Сонда да... Сонда да сенпайым ➡
Dialogue: 0,1:33:38.35,1:33:40.51,Default,,0000,0000,0000,,Сіз аман қалуыңыз мүмкін дейсіз бе?
Dialogue: 0,1:33:40.51,1:33:42.45,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:33:42.45,1:33:47.96,Default,,0000,0000,0000,,Әрине.
Dialogue: 0,1:33:42.45,1:33:47.96,Default,,0000,0000,0000,,Жауапкершілігіңізді орындаңыз, өйткені сіз оны ұрлағансыз!
Dialogue: 0,1:33:54.30,1:33:57.50,Default,,0000,0000,0000,,Сенпай….
Dialogue: 0,1:34:02.80,1:34:04.81,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:34:06.81,1:34:13.15,Default,,0000,0000,0000,,Қылмыстың орны және жазаның ауырлығы
Dialogue: 0,1:34:06.81,1:34:13.15,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,1:34:13.15,1:34:16.48,Default,,0000,0000,0000,,Бірақ қорғаңыз. Бұдан былай➡
Dialogue: 0,1:34:16.48,1:34:20.82,Default,,0000,0000,0000,,Сакура қойған барлық сұрақтардан
Dialogue: 0,1:34:16.48,1:34:20.82,Default,,0000,0000,0000,,Шие гүлдерін қорғау.
Dialogue: 0,1:34:20.82,1:34:24.83,Default,,0000,0000,0000,,Екіжүзділік болса да➡
Dialogue: 0,1:34:24.83,1:34:27.63,Default,,0000,0000,0000,,Сүйген адамыңызды қорғаңыз!
Dialogue: 0,1:34:30.66,1:34:34.07,Default,,0000,0000,0000,,Бақылау қосулы
Dialogue: 0,1:34:30.66,1:34:34.07,Default,,0000,0000,0000,,Проекцияны бастау.
Dialogue: 0,1:34:37.34,1:34:40.68,Default,,0000,0000,0000,,Бұл жаза.
Dialogue: 0,1:34:40.68,1:34:44.95,Default,,0000,0000,0000,,Өйткені бұл қиын
Dialogue: 0,1:34:40.68,1:34:44.95,Default,,0000,0000,0000,,Тістеріңізді қайраңыз.
Dialogue: 0,1:34:44.95,1:34:55.46,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:34:55.46,1:34:58.13,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:34:58.13,1:35:06.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:35:06.97,1:35:12.97,Default,,0000,0000,0000,,Үйге қайтайық, Сакура.
Dialogue: 0,1:35:06.97,1:35:12.97,Default,,0000,0000,0000,,Мұндай адамдармен қарым-қатынасты үзіңіз.
Dialogue: 0,1:36:17.30,1:36:21.01,Default,,0000,0000,0000,,Бұл тоқтамайды... иә?
Dialogue: 0,1:36:42.43,1:36:46.10,Default,,0000,0000,0000,,Ширу.
Dialogue: 0,1:36:46.10,1:36:50.44,Default,,0000,0000,0000,,А, сен бе? Мен құтқарылдым.
Dialogue: 0,1:36:50.44,1:36:53.44,Default,,0000,0000,0000,,Төмендегі Сакура мен Тохсаканы алыңыз➡
Dialogue: 0,1:36:53.44,1:36:56.28,Default,,0000,0000,0000,,Мен далаға шыға аламын ба?
Dialogue: 0,1:36:56.28,1:37:00.98,Default,,0000,0000,0000,,Ум, ла… ла….
Dialogue: 0,1:37:03.45,1:37:05.55,Default,,0000,0000,0000,,Түсінді.
Dialogue: 0,1:37:09.62,1:37:11.96,Default,,0000,0000,0000,,Өтінемін.
Dialogue: 0,1:37:11.96,1:37:14.63,Default,,0000,0000,0000,,Ах... Сондай-ақ.
Dialogue: 0,1:37:14.63,1:37:19.83,Default,,0000,0000,0000,,Бұл... бұл шие гүлдері үшін….
Dialogue: 0,1:37:22.47,1:37:25.27,Default,,0000,0000,0000,,Бұл сізге байланысты.
Dialogue: 0,1:37:30.48,1:37:34.28,Default,,0000,0000,0000,,Жоқ, сәттілік.
Dialogue: 0,1:37:42.92,1:38:13.95,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:38:13.95,1:38:18.96,Default,,0000,0000,0000,,Котомине... Кирей.
Dialogue: 0,1:38:18.96,1:38:25.47,Default,,0000,0000,0000,,Әй, әрең бір-біріне.
Dialogue: 0,1:38:18.96,1:38:25.47,Default,,0000,0000,0000,,Сіз аман қалған сияқтысыз.
Dialogue: 0,1:38:25.47,1:38:29.07,Default,,0000,0000,0000,,Эмия... Ширу.
Dialogue: 0,1:38:32.31,1:38:37.65,Default,,0000,0000,0000,,Мұны сыртқа шығарсаңыз да
Dialogue: 0,1:38:32.31,1:38:37.65,Default,,0000,0000,0000,,Тілегің орындалмайды.
Dialogue: 0,1:38:37.65,1:38:43.25,Default,,0000,0000,0000,,Тіпті ол орындалса да.
Dialogue: 0,1:38:37.65,1:38:43.25,Default,,0000,0000,0000,,Менің мақсатым біреу ғана➡
Dialogue: 0,1:38:43.25,1:38:47.25,Default,,0000,0000,0000,,Тек осы қарғысты тудыру үшін.
Dialogue: 0,1:38:47.25,1:38:51.09,Default,,0000,0000,0000,,Неге... неге сонша қорғайсың?
Dialogue: 0,1:38:51.09,1:38:54.43,Default,,0000,0000,0000,,Бұл зұлымдықтың өзі.
Dialogue: 0,1:38:54.43,1:39:00.10,Default,,0000,0000,0000,,Әлі жаман емес. Бұл да жақсы емес.
Dialogue: 0,1:39:00.10,1:39:05.61,Default,,0000,0000,0000,,Адамдар нөлден басталады
Dialogue: 0,1:39:00.10,1:39:05.61,Default,,0000,0000,0000,,«Не дұрыс» деп біліңіз.
Dialogue: 0,1:39:05.61,1:39:09.11,Default,,0000,0000,0000,,Басы нөлге тең.
Dialogue: 0,1:39:09.11,1:39:13.81,Default,,0000,0000,0000,,Бар болғаны
Dialogue: 0,1:39:09.11,1:39:13.81,Default,,0000,0000,0000,,Тек «бар» деген факті бар.
Dialogue: 0,1:39:19.29,1:39:22.12,Default,,0000,0000,0000,,Егер сіз жауапты болсаңыз➡
Dialogue: 0,1:39:22.12,1:39:25.79,Default,,0000,0000,0000,,Сол адамды тәрбиелеген орта➡
Dialogue: 0,1:39:25.79,1:39:29.46,Default,,0000,0000,0000,,Оның ішінде тек «мен» бар.
Dialogue: 0,1:39:29.46,1:39:32.47,Default,,0000,0000,0000,,Шығарғысы келетін өмір болса ➡
Dialogue: 0,1:39:32.47,1:39:36.30,Default,,0000,0000,0000,,Сенің пайда болуына мүмкіндік беретін махаббат.
Dialogue: 0,1:39:36.30,1:39:39.64,Default,,0000,0000,0000,,Махаббат деген не?
Dialogue: 0,1:39:39.64,1:39:43.81,Default,,0000,0000,0000,,Мен үшін Ширу Эмия.
Dialogue: 0,1:39:43.81,1:39:46.15,Default,,0000,0000,0000,,Басқалардың бақытына үлес қосасыз➡
Dialogue: 0,1:39:46.15,1:39:48.48,Default,,0000,0000,0000,,Бақытты сезіну➡
Dialogue: 0,1:39:48.48,1:39:54.29,Default,,0000,0000,0000,,Мен басқалардың мейіріміне бөленемін
Dialogue: 0,1:39:48.48,1:39:54.29,Default,,0000,0000,0000,,Тек бақытты сезін.
Dialogue: 0,1:40:06.00,1:40:08.34,Default,,0000,0000,0000,,(Жерге құлаған дыбыс)
Dialogue: 0,1:40:08.34,1:40:10.64,Default,,0000,0000,0000,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,1:40:08.34,1:40:10.64,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:40:12.84,1:40:15.64,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:40:12.84,1:40:15.64,Default,,0000,0000,0000,,Абай бол, ДжоДжо!
Dialogue: 0,1:40:21.52,1:40:24.69,Default,,0000,0000,0000,,Бұл қиын дене.
Dialogue: 0,1:40:24.69,1:40:28.19,Default,,0000,0000,0000,,Сіздің өміріңізге қауіп төндіру ықтималдығы жоғары ма?
Dialogue: 0,1:40:28.19,1:40:30.39,Default,,0000,0000,0000,,Яаа!
Dialogue: 0,1:40:33.53,1:40:36.70,Default,,0000,0000,0000,,Нуу! Зуааа!
Dialogue: 0,1:40:36.70,1:40:39.40,Default,,0000,0000,0000,,Гү!
Dialogue: 0,1:40:41.54,1:40:46.81,Default,,0000,0000,0000,,Біреуді өлтіру шынымен дұрыс емес пе?
Dialogue: 0,1:40:46.81,1:40:51.11,Default,,0000,0000,0000,,Сіз Сакура Матуды қорғауға тырысып жатырсыз.
Dialogue: 0,1:40:55.15,1:40:58.65,Default,,0000,0000,0000,,Адамдардың өзі осындай.
Dialogue: 0,1:40:58.65,1:41:01.99,Default,,0000,0000,0000,,Зұлымдардың ізгі ниеті.
Dialogue: 0,1:41:01.99,1:41:05.49,Default,,0000,0000,0000,,Әулиелердің еріксіз жасаған зұлымдық істері.
Dialogue: 0,1:41:05.49,1:41:10.00,Default,,0000,0000,0000,,Бұл қайшылық бізді адам етеді.
Dialogue: 0,1:41:10.00,1:41:16.50,Default,,0000,0000,0000,,Өмір сүру деген нені білдіреді
Dialogue: 0,1:41:10.00,1:41:16.50,Default,,0000,0000,0000,,Жақсылық пен жамандықты қамтитын нәрсе.
Dialogue: 0,1:41:16.50,1:41:19.34,Default,,0000,0000,0000,,Пех.
Dialogue: 0,1:41:19.34,1:41:23.01,Default,,0000,0000,0000,,Nu! ?
Dialogue: 0,1:41:19.34,1:41:23.01,Default,,0000,0000,0000,,(Қабырғалардың сынған дыбысы)
Dialogue: 0,1:41:23.01,1:41:27.01,Default,,0000,0000,0000,,Бірақ бұл жігіт басынан бастады.
Dialogue: 0,1:41:23.01,1:41:27.01,Default,,0000,0000,0000,,Тек өлтіру үшін!
Dialogue: 0,1:41:27.01,1:41:29.68,Default,,0000,0000,0000,,Жақсы... Дұрыс.
Dialogue: 0,1:41:29.68,1:41:33.35,Default,,0000,0000,0000,,Бірақ адамның өзі
Dialogue: 0,1:41:29.68,1:41:33.35,Default,,0000,0000,0000,,Бұл туралы не ойлайсыз?
Dialogue: 0,1:41:33.35,1:41:35.36,Default,,0000,0000,0000,,Мен әлі білмеймін.
Dialogue: 0,1:41:35.36,1:41:39.69,Default,,0000,0000,0000,,Сіз өзіңізді жаман деп санайсыз ба, әлде жақсы деп санайсыз ба?
Dialogue: 0,1:41:39.69,1:41:43.96,Default,,0000,0000,0000,,Нені қалайды
Dialogue: 0,1:41:39.69,1:41:43.96,Default,,0000,0000,0000,,Өз функцияларына➡
Dialogue: 0,1:41:43.96,1:41:48.30,Default,,0000,0000,0000,,Егер күмәніңіз болмаса
Dialogue: 0,1:41:43.96,1:41:48.30,Default,,0000,0000,0000,,Жаман емес.
Dialogue: 0,1:41:48.30,1:41:50.30,Default,,0000,0000,0000,,Жоқ! ? Жақсы!
Dialogue: 0,1:41:50.30,1:41:56.48,Default,,0000,0000,0000,,Туылса, қалағандай болады.
Dialogue: 0,1:41:50.30,1:41:56.48,Default,,0000,0000,0000,,Бұл сізді өлтіреді.
Dialogue: 0,1:41:56.48,1:42:04.32,Default,,0000,0000,0000,,Ал жалғыз қалды
Dialogue: 0,1:41:56.48,1:42:04.32,Default,,0000,0000,0000,,Сіз өзіңізді шынымен кешіре аласыз ба?
Dialogue: 0,1:42:04.32,1:42:09.99,Default,,0000,0000,0000,,Мен мұны білгім келеді.
Dialogue: 0,1:42:09.99,1:42:15.00,Default,,0000,0000,0000,,Жақсы... осындай нәрсе үшін...
Dialogue: 0,1:42:15.00,1:42:17.00,Default,,0000,0000,0000,,Сен!
Dialogue: 0,1:42:29.18,1:42:36.02,Default,,0000,0000,0000,,Иә, бұл менің мақсатым.
Dialogue: 0,1:42:29.18,1:42:36.02,Default,,0000,0000,0000,,Ширу Эмия.
Dialogue: 0,1:42:36.02,1:42:42.46,Default,,0000,0000,0000,,Өзіңе оралуға үміті жоқ сенімен
Dialogue: 0,1:42:36.02,1:42:42.46,Default,,0000,0000,0000,,Спектрдің қарама-қарсы жағында.
Dialogue: 0,1:42:42.46,1:42:44.46,Default,,0000,0000,0000,,Гах!
Dialogue: 0,1:42:42.46,1:42:44.46,Default,,0000,0000,0000,,Бірақ!
Dialogue: 0,1:42:44.46,1:42:46.46,Default,,0000,0000,0000,,Біркелкі тілек!
Dialogue: 0,1:42:46.46,1:42:58.47,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:42:58.47,1:43:03.31,Default,,0000,0000,0000,,Гах гах... гах.
Dialogue: 0,1:43:03.31,1:43:07.15,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,1:43:07.15,1:43:11.15,Default,,0000,0000,0000,,《А, түсіндім.
Dialogue: 0,1:43:11.15,1:43:15.82,Default,,0000,0000,0000,,Екеуміз де өзімізді күнәһар санаймыз➡
Dialogue: 0,1:43:15.82,1:43:21.53,Default,,0000,0000,0000,,Оны шайқау үшін
Dialogue: 0,1:43:15.82,1:43:21.53,Default,,0000,0000,0000,,Бір өмір жолын жалғастыру》
Dialogue: 0,1:43:25.50,1:43:29.10,Default,,0000,0000,0000,,Бұл сізге тимейді.
Dialogue: 0,1:43:31.34,1:43:36.01,Default,,0000,0000,0000,,Мойындасаң, жолың болады.
Dialogue: 0,1:43:36.01,1:43:40.35,Default,,0000,0000,0000,,Мен сені қызғанамын.
Dialogue: 0,1:43:40.35,1:43:45.45,Default,,0000,0000,0000,,көремін. Мен уақытымды босқа өткіздім.
Dialogue: 0,1:43:45.45,1:43:51.56,Default,,0000,0000,0000,,Маған бәрібір.
Dialogue: 0,1:43:45.45,1:43:51.56,Default,,0000,0000,0000,,Екеуіміздің де уақытымыз жоқ.
Dialogue: 0,1:44:01.97,1:44:05.14,Default,,0000,0000,0000,,Ооо... ой...
Dialogue: 0,1:44:05.14,1:44:09.98,Default,,0000,0000,0000,,Менің өлгім келмейді. Менің өлгім келмейді.
Dialogue: 0,1:44:09.98,1:44:14.78,Default,,0000,0000,0000,,Менің өлгім келмейді. Өлімге...
Dialogue: 0,1:44:18.99,1:44:22.82,Default,,0000,0000,0000,,Сенен сұрайын, жауым.
Dialogue: 0,1:44:22.82,1:44:26.63,Default,,0000,0000,0000,,Сен неге?
Dialogue: 0,1:44:22.82,1:44:26.63,Default,,0000,0000,0000,,Өлгің келмейді деп ойладың ба?
Dialogue: 0,1:44:34.17,1:44:38.01,Default,,0000,0000,0000,,｟Зелретч: Кез келген
Dialogue: 0,1:44:34.17,1:44:38.01,Default,,0000,0000,0000,,Зұлымдықты жою үшін➡
Dialogue: 0,1:44:38.01,1:44:42.01,Default,,0000,0000,0000,,Сізге керемет керек еді.
Dialogue: 0,1:44:44.44,1:44:46.61,Default,,0000,0000,0000,,Адам әлемінде құтқарылу жоқ➡
Dialogue: 0,1:44:46.61,1:44:51.52,Default,,0000,0000,0000,,Адам болғанша
Dialogue: 0,1:44:46.61,1:44:51.52,Default,,0000,0000,0000,,Егер зұлымдықты ажырату мүмкін болмаса...
Dialogue: 0,1:44:54.29,1:45:00.96,Default,,0000,0000,0000,,Утопия бастапқыда адамға тән
Dialogue: 0,1:44:54.29,1:45:00.96,Default,,0000,0000,0000,,Егер ол жетуге болмайтын нүкте болса.
Dialogue: 0,1:45:00.96,1:45:07.80,Default,,0000,0000,0000,,Адамнан артық
Dialogue: 0,1:45:00.96,1:45:07.80,Default,,0000,0000,0000,,Адамның жаңа пішінін іздеу.
Dialogue: 0,1:45:07.80,1:45:13.81,Default,,0000,0000,0000,,Иә, бұл дүниенің бәрі
Dialogue: 0,1:45:07.80,1:45:13.81,Default,,0000,0000,0000,,Зұлымдықты болдырмау үшін➡
Dialogue: 0,1:45:13.81,1:45:19.11,Default,,0000,0000,0000,,Осы тілекке өмірімізді бәс тігеміз.
Dialogue: 0,1:45:22.65,1:45:30.56,Default,,0000,0000,0000,,500 жылды ойласаңыз
Dialogue: 0,1:45:22.65,1:45:30.56,Default,,0000,0000,0000,,Бұл көптен күткен тілек еді.
Dialogue: 0,1:45:32.99,1:45:39.50,Default,,0000,0000,0000,,Ал, дәл қазір осы жерде бір-біріңді сүйіңдер.
Dialogue: 0,1:45:32.99,1:45:39.50,Default,,0000,0000,0000,,Мен бір қадам ғана қалдым...
Dialogue: 0,1:45:51.95,1:45:53.95,Default,,0000,0000,0000,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,1:45:53.95,1:45:59.95,Default,,0000,0000,0000,,Менің ойымша, уақыт бойынша жай ғана айырмашылық жоқ.
Dialogue: 0,1:45:59.95,1:46:02.06,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:46:05.79,1:46:08.63,Default,,0000,0000,0000,,Сіз соңғы шеберсіз.
Dialogue: 0,1:46:08.63,1:46:12.53,Default,,0000,0000,0000,,Өз міндетіңді орында.
Dialogue: 0,1:46:41.16,1:46:45.77,Default,,0000,0000,0000,,Бұл... бұл соңы...
Dialogue: 0,1:46:45.77,1:46:48.47,Default,,0000,0000,0000,,Проекция….
Dialogue: 0,1:46:58.95,1:47:02.12,Default,,0000,0000,0000,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,1:47:02.12,1:47:06.02,Default,,0000,0000,0000,,Жақсы ма?
Dialogue: 0,1:47:12.13,1:47:18.63,Default,,0000,0000,0000,,Жоқ, Ширу өлмейді.
Dialogue: 0,1:47:25.64,1:47:29.48,Default,,0000,0000,0000,,Мына қақпаны жауып тұрған менмін.
Dialogue: 0,1:47:29.48,1:47:36.32,Default,,0000,0000,0000,,Ширу өмір сүргісі келеді ме?
Dialogue: 0,1:47:29.48,1:47:36.32,Default,,0000,0000,0000,,Өмір қандай болмасын.
Dialogue: 0,1:47:36.32,1:47:40.02,Default,,0000,0000,0000,,Қандай формада болса да...
Dialogue: 0,1:47:42.76,1:47:45.59,Default,,0000,0000,0000,,Өмір сүргің келе ме?
Dialogue: 0,1:47:45.59,1:47:50.43,Default,,0000,0000,0000,,А... жоқ...
Dialogue: 0,1:47:50.43,1:47:59.77,Default,,0000,0000,0000,,Жақсы... өйткені.
Dialogue: 0,1:47:50.43,1:47:59.77,Default,,0000,0000,0000,,Мен сені өзіммен бірге алып кетемін...
Dialogue: 0,1:47:59.77,1:48:02.58,Default,,0000,0000,0000,,Өмір сүргің келе ме?
Dialogue: 0,1:48:08.95,1:48:13.45,Default,,0000,0000,0000,,Уф… Уф….
Dialogue: 0,1:48:13.45,1:48:16.46,Default,,0000,0000,0000,,Мен ... қалаймын.
Dialogue: 0,1:48:16.46,1:48:21.46,Default,,0000,0000,0000,,Мен тірі болғым келеді!
Dialogue: 0,1:48:21.46,1:48:24.26,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,1:48:27.13,1:48:32.97,Default,,0000,0000,0000,,Жоқ, жоқ... қайту...
Dialogue: 0,1:48:32.97,1:48:36.14,Default,,0000,0000,0000,,Мен саған бір ғажайып көрсетемін.
Dialogue: 0,1:48:36.14,1:48:38.98,Default,,0000,0000,0000,,Бұл жолы керемет.
Dialogue: 0,1:48:38.98,1:48:44.42,Default,,0000,0000,0000,,Сіз не айтасыз?
Dialogue: 0,1:48:38.98,1:48:44.42,Default,,0000,0000,0000,,Бұл нағыз сиқыр.
Dialogue: 0,1:48:44.42,1:48:47.59,Default,,0000,0000,0000,,Жақсы...
Dialogue: 0,1:48:47.59,1:48:51.09,Default,,0000,0000,0000,,Жарайды, қайт...
Dialogue: 0,1:48:51.09,1:48:56.10,Default,,0000,0000,0000,,Боқ... Аты-жөні...
Dialogue: 0,1:49:00.10,1:49:03.80,Default,,0000,0000,0000,,Үлкен аға қарындасын қорғайды, солай ма?
Dialogue: 0,1:49:06.11,1:49:08.11,Default,,0000,0000,0000,,Я….
Dialogue: 0,1:49:10.11,1:49:14.78,Default,,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,1:49:10.11,1:49:14.78,Default,,0000,0000,0000,,Мен Ширудың әпкесімін.
Dialogue: 0,1:49:14.78,1:49:19.49,Default,,0000,0000,0000,,Онда мен ағамды қорғауым керек.
Dialogue: 0,1:49:21.96,1:49:24.26,Default,,0000,0000,0000,,Илья!
Dialogue: 0,1:49:29.13,1:49:37.64,Default,,0000,0000,0000,,Ілияс... Ілияс Ілияс Ілияс Ілияс.
Dialogue: 0,1:49:37.64,1:49:41.14,Default,,0000,0000,0000,,Илья~!
Dialogue: 0,1:49:41.14,1:49:43.14,Default,,0000,0000,0000,,(Есік жабылған дыбысы)
Dialogue: 0,1:49:43.14,1:51:06.36,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:51:36.69,1:51:41.59,Default,,0000,0000,0000,,Сенпай….
Dialogue: 0,1:51:46.30,1:51:56.01,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,1:52:14.49,1:52:16.66,Default,,0000,0000,0000,,Жарайсың, келесі менеджер.
Dialogue: 0,1:52:16.66,1:52:19.67,Default,,0000,0000,0000,,Сіз жан тыныштығымен зейнетке шыға аласыз
Dialogue: 0,1:52:16.66,1:52:19.67,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,1:52:19.67,1:52:23.57,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:52:27.34,1:52:31.85,Default,,0000,0000,0000,,Қашан
Dialogue: 0,1:52:27.34,1:52:31.85,Default,,0000,0000,0000,,Қайтып келер ме екен...
Dialogue: 0,1:52:47.79,1:52:52.97,Default,,0000,0000,0000,,《Осы елде болды.
Dialogue: 0,1:52:47.79,1:52:52.97,Default,,0000,0000,0000,,Қасиетті Граил соғысы аяқталды.
Dialogue: 0,1:52:52.97,1:52:58.14,Default,,0000,0000,0000,,Ұлы Қасиетті Граил құлады
Dialogue: 0,1:52:52.97,1:52:58.14,Default,,0000,0000,0000,,Барлығына шымылдық ашылды.
Dialogue: 0,1:52:58.14,1:53:03.31,Default,,0000,0000,0000,,Бұдан кейін
Dialogue: 0,1:52:58.14,1:53:03.31,Default,,0000,0000,0000,,Сиқырлы қауымдастықпен күресу үшін көп жұмыс істеу кезінде➡
Dialogue: 0,1:53:03.31,1:53:07.65,Default,,0000,0000,0000,,Мен Сакураның қалпына келуін күттім.
Dialogue: 0,1:53:07.65,1:53:13.15,Default,,0000,0000,0000,,Ал қазір мен Сакурамен бірге жүрмін.
Dialogue: 0,1:53:13.15,1:53:16.66,Default,,0000,0000,0000,,11 жыл уақытына оралайық➡
Dialogue: 0,1:53:16.66,1:53:22.66,Default,,0000,0000,0000,,Уақыт қозғала бастағанда шие гүлімен бірге жүру.
Dialogue: 0,1:53:22.66,1:53:28.00,Default,,0000,0000,0000,,Иә, бұл онсыз уақыт.
Dialogue: 0,1:53:28.00,1:53:33.17,Default,,0000,0000,0000,,Ширу Эмиияның денесі
Dialogue: 0,1:53:28.00,1:53:33.17,Default,,0000,0000,0000,,Себебі ол жоғалып кетті》
Dialogue: 0,1:53:33.17,1:54:11.81,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:54:11.81,1:54:14.48,Default,,0000,0000,0000,,Егер бұл жігіт өлетін болғысы келмесе, денесін Сукунаға тапсырғаны дұрыс—
Dialogue: 0,1:54:14.48,1:54:19.82,Default,,0000,0000,0000,,Сакура Рин қайтып келді.
Dialogue: 0,1:54:19.82,1:54:24.62,Default,,0000,0000,0000,,Иә, рахмет, шабандоз.
Dialogue: 0,1:54:26.99,1:54:31.50,Default,,0000,0000,0000,,Аа... Сакура ше? жақында.
Dialogue: 0,1:54:31.50,1:54:36.34,Default,,0000,0000,0000,,Иә, бірақ бірте-бірте.
Dialogue: 0,1:54:31.50,1:54:36.34,Default,,0000,0000,0000,,Әртүрлі заттар➡
Dialogue: 0,1:54:36.34,1:54:39.67,Default,,0000,0000,0000,,Адал қабылдау
Dialogue: 0,1:54:36.34,1:54:39.67,Default,,0000,0000,0000,,Қазір.
Dialogue: 0,1:54:39.67,1:54:45.38,Default,,0000,0000,0000,,Кінә сезімімен жаншылып қалу
Dialogue: 0,1:54:39.67,1:54:45.38,Default,,0000,0000,0000,,Бұл қашу.
Dialogue: 0,1:54:53.62,1:54:56.12,Default,,0000,0000,0000,,《Ерекше заттар.
Dialogue: 0,1:54:56.12,1:55:00.13,Default,,0000,0000,0000,,Нені өзгерту керек.
Dialogue: 0,1:55:00.13,1:55:03.80,Default,,0000,0000,0000,,Немен?
Dialogue: 0,1:55:00.13,1:55:03.80,Default,,0000,0000,0000,,Сіз өзгерді деп айта аласыз ба?➡
Dialogue: 0,1:55:03.80,1:55:11.14,Default,,0000,0000,0000,,Әлі де сенімді емеспін
Dialogue: 0,1:55:03.80,1:55:11.14,Default,,0000,0000,0000,,Жол іздеу.
Dialogue: 0,1:55:11.14,1:55:13.64,Default,,0000,0000,0000,,Бірақ…》
Dialogue: 0,1:55:13.64,1:55:33.16,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:55:33.16,1:55:35.16,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:55:40.50,1:55:44.30,Default,,0000,0000,0000,,《Үздіксіз өзгеретін әлемде...》
Dialogue: 0,1:55:46.94,1:55:50.28,Default,,0000,0000,0000,,《Сіз сол қалпында қалдыңыз.
Dialogue: 0,1:55:46.94,1:55:50.28,Default,,0000,0000,0000,,Заттар…》
Dialogue: 0,1:55:50.28,1:56:07.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:56:07.96,1:56:10.56,Default,,0000,0000,0000,,Не болды? сакура.
Dialogue: 0,1:56:16.14,1:56:18.84,Default,,0000,0000,0000,,Жоқ….
Dialogue: 0,1:56:21.31,1:56:25.81,Default,,0000,0000,0000,,Жүр, кеттік.
Dialogue: 0,1:56:21.31,1:56:25.81,Default,,0000,0000,0000,,Толық толқыдым.
Dialogue: 0,1:56:25.81,1:56:28.51,Default,,0000,0000,0000,,Эй.
Dialogue: 0,1:56:33.65,1:56:37.66,Default,,0000,0000,0000,,Сакура бақытты ма?
Dialogue: 0,1:56:47.43,1:56:51.10,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:56:51.10,1:58:21.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:58:22.53,1:58:28.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory