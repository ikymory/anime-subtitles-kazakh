Dialogue: 0,0:00:11.04,0:00:14.05,Default,,0000,0000,0000,,[Әлем шын мәнінде ұлы қарақшылардың ғасыры]
Dialogue: 0,0:00:14.05,0:00:17.05,Default,,0000,0000,0000,,[Байлық, атақ, билік іздеу➡
Dialogue: 0,0:00:17.05,0:00:20.05,Default,,0000,0000,0000,,Амбициясы барлар
Dialogue: 0,0:00:17.05,0:00:20.05,Default,,0000,0000,0000,,Теңізге шығу]
Dialogue: 0,0:00:20.05,0:00:24.06,Default,,0000,0000,0000,,[Қарақшылар үшін
Dialogue: 0,0:00:20.05,0:00:24.06,Default,,0000,0000,0000,,Бұл армандар дәуірі]
Dialogue: 0,0:00:24.06,0:00:26.06,Default,,0000,0000,0000,,[Бірақ олардың кейбіреулері ➡
Dialogue: 0,0:00:26.06,0:00:30.06,Default,,0000,0000,0000,,Тек алып кету үшін
Dialogue: 0,0:00:26.06,0:00:30.06,Default,,0000,0000,0000,,Кейбір адамдарға ұнады]
Dialogue: 0,0:00:30.06,0:00:33.07,Default,,0000,0000,0000,,[Бұл
Dialogue: 0,0:00:30.06,0:00:33.07,Default,,0000,0000,0000,,Қуаты жоқтар үшін➡
Dialogue: 0,0:00:33.07,0:00:37.07,Default,,0000,0000,0000,,Қуғын-сүргін күндері жалғаса берсін
Dialogue: 0,0:00:33.07,0:00:37.07,Default,,0000,0000,0000,,білдіреді]
Dialogue: 0,0:00:37.07,0:00:40.07,Default,,0000,0000,0000,,Дүниежүзілік Сейфу
Dialogue: 0,0:00:37.07,0:00:40.07,Default,,0000,0000,0000,,[Әлемдік үкіметтің юрисдикциясында]
Dialogue: 0,0:00:37.07,0:00:40.07,Default,,0000,0000,0000,,Әскери-теңіз күштері де➡
Dialogue: 0,0:00:40.07,0:00:44.08,Default,,0000,0000,0000,,Барлық әлсіздерге көмектесу
Dialogue: 0,0:00:40.07,0:00:44.08,Default,,0000,0000,0000,,мүмкін емес]
Dialogue: 0,0:00:44.08,0:00:47.08,Default,,0000,0000,0000,,[Сосын олар
Dialogue: 0,0:00:44.08,0:00:47.08,Default,,0000,0000,0000,,Біз кімге жүгіне аламыз? ]
Dialogue: 0,0:00:47.08,0:00:52.09,Default,,0000,0000,0000,,[Не жабысуым керек?
Dialogue: 0,0:00:47.08,0:00:52.09,Default,,0000,0000,0000,,Сіз құтқарыласыз ба? ]
Dialogue: 0,0:00:52.09,0:00:54.09,Default,,0000,0000,0000,,🔊Мен шынымен қиналып жүрмін.
Dialogue: 0,0:00:54.09,0:00:58.09,Default,,0000,0000,0000,,дүйсенб
Dialogue: 0,0:00:54.09,0:00:58.09,Default,,0000,0000,0000,,🔊Ешкім біз сияқтыларды ойламайды.
Dialogue: 0,0:00:54.09,0:00:58.09,Default,,0000,0000,0000,,Маған бәрібір.
Dialogue: 0,0:00:58.09,0:01:02.03,Default,,0000,0000,0000,,🔊Аа...
Dialogue: 0,0:00:58.09,0:01:02.03,Default,,0000,0000,0000,,Мен үнемі жылаймын.
Dialogue: 0,0:01:02.03,0:01:04.03,Default,,0000,0000,0000,,🔊Бәрі айтып жатыр. ➡
Dialogue: 0,0:01:04.03,0:01:06.03,Default,,0000,0000,0000,,Бұған теңіз флоты да кінәлі.
Dialogue: 0,0:01:04.03,0:01:06.03,Default,,0000,0000,0000,,Бұдан артық не болды...
Dialogue: 0,0:01:06.03,0:01:08.03,Default,,0000,0000,0000,,🔊Менің қарным ашты.
Dialogue: 0,0:01:08.03,0:01:12.04,Default,,0000,0000,0000,,🔊Оған көмектесу мүмкін емес. Қарақшылар
Dialogue: 0,0:01:08.03,0:01:12.04,Default,,0000,0000,0000,,Себебі мен бәрін қабылдадым.
Dialogue: 0,0:01:12.04,0:01:13.71,Default,,0000,0000,0000,,🔊Иә! Қарақшы!
Dialogue: 0,0:01:13.71,0:01:15.38,Default,,0000,0000,0000,,🔊Бәрі өзімшіл адамдардың кесірінен!
Dialogue: 0,0:01:15.38,0:01:18.04,Default,,0000,0000,0000,,🔊Барлығы
Dialogue: 0,0:01:15.38,0:01:18.04,Default,,0000,0000,0000,,Бұл енді қызық емес.
Dialogue: 0,0:01:18.04,0:01:20.05,Default,,0000,0000,0000,,🔊 (Барлығы жылайды)
Dialogue: 0,0:01:20.05,0:01:23.05,Default,,0000,0000,0000,,🔊Сіз түсінесіз бе?
Dialogue: 0,0:01:23.05,0:01:26.05,Default,,0000,0000,0000,,🔊 (Ер адам) Өтінемін
Dialogue: 0,0:01:23.05,0:01:26.05,Default,,0000,0000,0000,,Біздің қасіретіміз...
Dialogue: 0,0:01:26.05,0:01:29.06,Default,,0000,0000,0000,,🔊Тек сен...
Dialogue: 0,0:01:26.05,0:01:29.06,Default,,0000,0000,0000,,Сен жалғызсың!
Dialogue: 0,0:01:29.06,0:01:31.06,Default,,0000,0000,0000,,🔊 (Әйел) Өтінемін.
Dialogue: 0,0:01:29.06,0:01:31.06,Default,,0000,0000,0000,,🔊 (Ер адам) Егер сіз...
Dialogue: 0,0:01:31.06,0:01:33.06,Default,,0000,0000,0000,,🔊 (Ер адам) Өтінемін!
Dialogue: 0,0:01:31.06,0:01:33.06,Default,,0000,0000,0000,,🔊 (Әйел) Тек сен!
Dialogue: 0,0:01:33.06,0:01:35.06,Default,,0000,0000,0000,,🔊 (Барлығы) Өтінемін!
Dialogue: 0,0:01:35.06,0:01:38.06,Default,,0000,0000,0000,,Мен білемін.
Dialogue: 0,0:01:35.06,0:01:38.06,Default,,0000,0000,0000,,Мен бәрін білемін. ➡
Dialogue: 0,0:01:38.06,0:01:40.07,Default,,0000,0000,0000,,Мен➡
Dialogue: 0,0:01:40.07,0:01:45.07,Default,,0000,0000,0000,,Барлығы бақытты болатын жаңа дәуір
Dialogue: 0,0:01:40.07,0:01:45.07,Default,,0000,0000,0000,,Мен оны сізге жасаймын.
Dialogue: 0,0:01:45.07,0:02:04.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:08.03,0:02:11.03,Default,,0000,0000,0000,,Мұнда адам көп емес пе?
Dialogue: 0,0:02:11.03,0:02:15.03,Default,,0000,0000,0000,,Бұл Ута мен үшін бірінші рет болды
Dialogue: 0,0:02:11.03,0:02:15.03,Default,,0000,0000,0000,,Өйткені бұл жанкүйерлер алдында жанды қойылым.
Dialogue: 0,0:02:15.03,0:02:19.04,Default,,0000,0000,0000,,Эйзоденденмуши
Dialogue: 0,0:02:15.03,0:02:19.04,Default,,0000,0000,0000,,Осы уақытқа дейін бұл тек Эйзо Денден Муши болатын.
Dialogue: 0,0:02:15.03,0:02:19.04,Default,,0000,0000,0000,,Мен мұны бұрын ешқашан көрген емеспін!
Dialogue: 0,0:02:19.04,0:02:20.71,Default,,0000,0000,0000,,Тікелей эфирде!
Dialogue: 0,0:02:20.71,0:02:25.98,Default,,0000,0000,0000,,Сондай жақсы жерде
Dialogue: 0,0:02:20.71,0:02:25.98,Default,,0000,0000,0000,,Мені көргеніне сенбеймін... Мен!
Dialogue: 0,0:02:29.05,0:02:33.05,Default,,0000,0000,0000,,Су перілері де бар.
Dialogue: 0,0:02:29.05,0:02:33.05,Default,,0000,0000,0000,,Көңілді сияқты...
Dialogue: 0,0:02:33.05,0:02:35.05,Default,,0000,0000,0000,,Неліктен біз осылай киінеміз?
Dialogue: 0,0:02:35.05,0:02:38.06,Default,,0000,0000,0000,,Алғашқы жанды орындауды жандандыру үшін
Dialogue: 0,0:02:35.05,0:02:38.06,Default,,0000,0000,0000,,Костюмді киген кезде➡
Dialogue: 0,0:02:38.06,0:02:40.06,Default,,0000,0000,0000,,Сіз мұны ала аласыз!
Dialogue: 0,0:02:40.06,0:02:43.06,Default,,0000,0000,0000,,Сонымен?
Dialogue: 0,0:02:40.06,0:02:43.06,Default,,0000,0000,0000,,Бұл қызық. ➡
Dialogue: 0,0:02:43.06,0:02:46.07,Default,,0000,0000,0000,,Қазір әлемде
Dialogue: 0,0:02:43.06,0:02:46.07,Default,,0000,0000,0000,,Ол ең сүйікті адам.
Dialogue: 0,0:02:46.07,0:02:48.07,Default,,0000,0000,0000,,Бұл шынымен де ғажап па?
Dialogue: 0,0:02:48.07,0:02:53.07,Default,,0000,0000,0000,,Осыны мен, Жан патшасы айтамын.
Dialogue: 0,0:02:48.07,0:02:53.07,Default,,0000,0000,0000,,Оның әндері басқа деңгейде.
Dialogue: 0,0:02:53.07,0:02:57.08,Default,,0000,0000,0000,,U! Т! А!
Dialogue: 0,0:02:53.07,0:02:57.08,Default,,0000,0000,0000,,Утачуван!
Dialogue: 0,0:02:57.08,0:02:59.08,Default,,0000,0000,0000,,Бұл қоқыс.
Dialogue: 0,0:02:57.08,0:02:59.08,Default,,0000,0000,0000,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:02:59.08,0:03:02.02,Default,,0000,0000,0000,,Қарғыс атқыр қылышшы!
Dialogue: 0,0:02:59.08,0:03:02.02,Default,,0000,0000,0000,,Тағы да айтыңыз!
Dialogue: 0,0:03:02.02,0:03:04.02,Default,,0000,0000,0000,,Темео
Dialogue: 0,0:03:02.02,0:03:04.02,Default,,0000,0000,0000,,Мен оны шырынды етіп пісіремін!
Dialogue: 0,0:03:04.02,0:03:06.02,Default,,0000,0000,0000,,Байқап көріңіз, Гуру Гуру Марк.
Dialogue: 0,0:03:06.02,0:03:07.69,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:07.69,0:03:10.69,Default,,0000,0000,0000,,Уау! Басталып жатыр!
Dialogue: 0,0:03:07.69,0:03:10.69,Default,,0000,0000,0000,,Хаха!
Dialogue: 0,0:03:10.69,0:03:14.03,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:03:10.69,0:03:14.03,Default,,0000,0000,0000,,Тікелей эфир басталғалы жатыр, Луффи!
Dialogue: 0,0:03:14.03,0:03:16.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:16.03,0:03:20.03,Default,,0000,0000,0000,,♬ «Жаңа дәуір – бұл болашақ» ➡
Dialogue: 0,0:03:20.03,0:03:27.04,Default,,0000,0000,0000,,♬ «Егер біз бүкіл әлемді өзгерте алсақ» ➡
Dialogue: 0,0:03:27.04,0:03:36.05,Default,,0000,0000,0000,,♬ «Егер сіз оны өзгертсеңіз...»
Dialogue: 0,0:03:36.05,0:03:45.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:45.06,0:03:47.06,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:03:47.06,0:03:48.73,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:48.73,0:03:59.07,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:59.07,0:04:02.01,Default,,0000,0000,0000,,♬ «Джамамоно Ямоно»
Dialogue: 0,0:03:59.07,0:04:02.01,Default,,0000,0000,0000,,Оны өшіріңіз”➡
Dialogue: 0,0:04:02.01,0:04:05.01,Default,,0000,0000,0000,,♬ «Бұл әлем және
Dialogue: 0,0:04:02.01,0:04:05.01,Default,,0000,0000,0000,,Метаморфоза жасайық»➡
Dialogue: 0,0:04:05.01,0:04:10.02,Default,,0000,0000,0000,,♬«Музыка
Dialogue: 0,0:04:05.01,0:04:10.02,Default,,0000,0000,0000,,Сіз жасаған сиқыр»
Dialogue: 0,0:04:10.02,0:04:13.02,Default,,0000,0000,0000,,♬ «Көзіңді жұмсаң, болашақ ашылады».
Dialogue: 0,0:04:13.02,0:04:17.02,Default,,0000,0000,0000,,♬ «Мәңгілік
Dialogue: 0,0:04:13.02,0:04:17.02,Default,,0000,0000,0000,,Ақырзаман ешқашан келмесін».
Dialogue: 0,0:04:17.02,0:04:22.03,Default,,0000,0000,0000,,♬ «Мен бұл әнді айтамын» ➡
Dialogue: 0,0:04:22.03,0:04:24.03,Default,,0000,0000,0000,,♬ «Сіз ойнағыңыз келе ме?
Dialogue: 0,0:04:22.03,0:04:24.03,Default,,0000,0000,0000,,Нағыз ойын соңғы минут»➡
Dialogue: 0,0:04:24.03,0:04:30.04,Default,,0000,0000,0000,,♬ «Арқан серуендей әуен
Dialogue: 0,0:04:24.03,0:04:30.04,Default,,0000,0000,0000,,Мен оны қабылдамаймын, қайта алмаймын, ұмытқым келеді.»➡
Dialogue: 0,0:04:30.04,0:04:32.04,Default,,0000,0000,0000,,♬ «Сіздің арманыңызда қалуға рұқсат етіңіз»
Dialogue: 0,0:04:32.04,0:04:34.04,Default,,0000,0000,0000,,♬ «Мен еркін болғым келеді» ➡
Dialogue: 0,0:04:34.04,0:04:40.05,Default,,0000,0000,0000,,♬ «Мен жаңа дәуірді көріп тұрмын.
Dialogue: 0,0:04:34.04,0:04:40.05,Default,,0000,0000,0000,,Әлемнің сыртында»➡
Dialogue: 0,0:04:40.05,0:04:43.05,Default,,0000,0000,0000,,♬ «Жаңа әлемге барайық» ➡
Dialogue: 0,0:04:43.05,0:04:46.05,Default,,0000,0000,0000,,♬ «Жаңа дәуір – бұл болашақ».
Dialogue: 0,0:04:46.05,0:04:54.06,Default,,0000,0000,0000,,♬ «Егер біз бүкіл әлемді өзгертетін болсақ
Dialogue: 0,0:04:46.05,0:04:54.06,Default,,0000,0000,0000,,Егер сіз оны өзгертсеңіз»➡
Dialogue: 0,0:04:54.06,0:04:59.07,Default,,0000,0000,0000,,♬ «Бақытсыз музыка
Dialogue: 0,0:04:54.06,0:04:59.07,Default,,0000,0000,0000,,Көбірек жетейік»➡
Dialogue: 0,0:04:59.07,0:05:04.00,Default,,0000,0000,0000,,♬ «Мен армандамаймын. Сіз маған айттыңыз ».
Dialogue: 0,0:05:04.00,0:05:06.01,Default,,0000,0000,0000,,♬ ""Маған сеніңіз""
Dialogue: 0,0:05:06.01,0:05:16.02,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:16.02,0:05:27.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:27.03,0:05:30.03,Default,,0000,0000,0000,,♬ «Сізге қажет емес заттар
Dialogue: 0,0:05:27.03,0:05:30.03,Default,,0000,0000,0000,,Өшіру”➡
Dialogue: 0,0:05:30.03,0:05:33.03,Default,,0000,0000,0000,,♬«Нағыз
Dialogue: 0,0:05:30.03,0:05:33.03,Default,,0000,0000,0000,,Оны түрлі-түсті етіп жеңейік».
Dialogue: 0,0:05:33.03,0:05:38.04,Default,,0000,0000,0000,,♬«Музыка
Dialogue: 0,0:05:33.03,0:05:38.04,Default,,0000,0000,0000,,Көтерілу қазір басталады»➡
Dialogue: 0,0:05:38.04,0:05:41.04,Default,,0000,0000,0000,,♬ «Көздеріңді жұмыңдар
Dialogue: 0,0:05:38.04,0:05:41.04,Default,,0000,0000,0000,,Бәріміз қашайық»➡
Dialogue: 0,0:05:41.04,0:05:45.04,Default,,0000,0000,0000,,♬ «Қазіргіден жақсы»
Dialogue: 0,0:05:41.04,0:05:45.04,Default,,0000,0000,0000,,мен саған көрсетемін».
Dialogue: 0,0:05:45.04,0:05:49.72,Default,,0000,0000,0000,,♬ «Осы әнді айтсаң» ➡
Dialogue: 0,0:05:49.72,0:05:52.05,Default,,0000,0000,0000,,♬ «Сіз ойнағыңыз келе ме?
