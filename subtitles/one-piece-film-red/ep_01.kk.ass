Dialogue: 0,0:06:11.00,0:06:14.01,Default,,0000,0000,0000,,♬ «Мен осы болашаққа сенгім келеді» ➡
Dialogue: 0,0:06:14.01,0:06:22.01,Default,,0000,0000,0000,,♬ «Егер біз бүкіл әлемді өзгертетін болсақ
Dialogue: 0,0:06:14.01,0:06:22.01,Default,,0000,0000,0000,,Егер сіз оны өзгертсеңіз»➡
Dialogue: 0,0:06:22.01,0:06:27.02,Default,,0000,0000,0000,,♬ «Бақысыз музыка
Dialogue: 0,0:06:22.01,0:06:27.02,Default,,0000,0000,0000,,Көбірек қол жеткізу»➡
Dialogue: 0,0:06:27.02,0:06:32.02,Default,,0000,0000,0000,,♬ «Мен саған түс көрсетемін, мен саған түс көрсетемін».
Dialogue: 0,0:06:32.02,0:06:34.03,Default,,0000,0000,0000,,♬ «Бұл жаңа дәуір».
Dialogue: 0,0:06:34.03,0:06:54.05,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:54.05,0:06:57.05,Default,,0000,0000,0000,,♬ «Бұл жаңа дәуір.»
Dialogue: 0,0:06:57.05,0:07:06.99,Default,,0000,0000,0000,,(қолдау/қол шапалақтау)
Dialogue: 0,0:07:06.99,0:07:11.00,Default,,0000,0000,0000,,Барлығымыз, біз ақыры кездестік!
Dialogue: 0,0:07:06.99,0:07:11.00,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:07:11.00,0:07:14.00,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:14.00,0:07:16.00,Default,,0000,0000,0000,,(қолдау/қол шапалақтау)
Dialogue: 0,0:07:16.00,0:07:20.01,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:07:16.00,0:07:20.01,Default,,0000,0000,0000,,Маған біраз әсер қалдырды.
Dialogue: 0,0:07:20.01,0:07:23.01,Default,,0000,0000,0000,,(қолдау/шапалақтау)
Dialogue: 0,0:07:23.01,0:07:26.01,Default,,0000,0000,0000,,⚟ (қолдау/қол шапалақтау)
Dialogue: 0,0:07:26.01,0:07:29.02,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:07:29.02,0:07:33.02,Default,,0000,0000,0000,,🔊Барлығы
Dialogue: 0,0:07:29.02,0:07:33.02,Default,,0000,0000,0000,,Бүгінгі күнді көңілді өткізейік!
Dialogue: 0,0:07:33.02,0:07:36.02,Default,,0000,0000,0000,,Бейбақтар, дайынсыңдар ма?
Dialogue: 0,0:07:36.02,0:07:39.03,Default,,0000,0000,0000,,О.
Dialogue: 0,0:07:36.02,0:07:39.03,Default,,0000,0000,0000,,Сол танымал адамды алып кетсеңіз➡
Dialogue: 0,0:07:39.03,0:07:45.03,Default,,0000,0000,0000,,Үлкен ақша мен үлкен атақ қол жетімді.
Dialogue: 0,0:07:39.03,0:07:45.03,Default,,0000,0000,0000,,Бұл өте жаман, Ута-чан.
Dialogue: 0,0:07:45.03,0:07:50.04,Default,,0000,0000,0000,,(аудитория)
Dialogue: 0,0:07:45.03,0:07:50.04,Default,,0000,0000,0000,,Пайдаланушы
Dialogue: 0,0:07:45.03,0:07:50.04,Default,,0000,0000,0000,,UTA! UTA! UTA!
Dialogue: 0,0:07:50.04,0:07:53.04,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:07:50.04,0:07:53.04,Default,,0000,0000,0000,,Сәлем, Луффи!
Dialogue: 0,0:07:53.04,0:07:55.04,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:55.04,0:07:57.04,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:07:57.04,0:08:00.05,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:57.04,0:08:00.05,Default,,0000,0000,0000,,Ол да Утаны көздеп отыр ма?
Dialogue: 0,0:08:00.05,0:08:01.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:01.98,0:08:03.98,Default,,0000,0000,0000,,Ах! Күткендей!
Dialogue: 0,0:08:03.98,0:08:05.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:03.98,0:08:05.99,Default,,0000,0000,0000,,Юта... Сіз Ютасыз, солай ма?
Dialogue: 0,0:08:05.99,0:08:08.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:05.99,0:08:08.99,Default,,0000,0000,0000,,Бұл менмін! Бұл мен!
Dialogue: 0,0:08:08.99,0:08:10.99,Default,,0000,0000,0000,,Мен?
Dialogue: 0,0:08:10.99,0:08:13.99,Default,,0000,0000,0000,,Мүмкін Луффи! ?
Dialogue: 0,0:08:13.99,0:08:17.00,Default,,0000,0000,0000,,Біраз уақыт болды, Ута!
Dialogue: 0,0:08:13.99,0:08:17.00,Default,,0000,0000,0000,,Луффи~!
Dialogue: 0,0:08:17.00,0:08:18.97,Default,,0000,0000,0000,,(Кашиваги) Олай деу дұрыс па?
Dialogue: 0,0:08:21.00,0:08:24.00,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:24.00,0:08:26.01,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:08:26.01,0:08:31.01,Default,,0000,0000,0000,,Ахх— бұл мені қатты қорқытты
Dialogue: 0,0:08:31.01,0:08:34.01,Default,,0000,0000,0000,,Эй, мына сабан қалпақ...
Dialogue: 0,0:08:31.01,0:08:34.01,Default,,0000,0000,0000,,Жоқ, бесінші император! ?
Dialogue: 0,0:08:34.01,0:08:39.02,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:08:34.01,0:08:39.02,Default,,0000,0000,0000,,Ута қарақшылармен дос бола алмайды!
Dialogue: 0,0:08:39.02,0:08:42.02,Default,,0000,0000,0000,,Луффи
Dialogue: 0,0:08:39.02,0:08:42.02,Default,,0000,0000,0000,,Сіз Ютаны білесіз бе?
Dialogue: 0,0:08:42.02,0:08:45.02,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:08:42.02,0:08:45.02,Default,,0000,0000,0000,,Олай болса, өзіңізді таныстырыңыз!
Dialogue: 0,0:08:45.02,0:08:47.03,Default,,0000,0000,0000,,
Dialogue: 0,0:08:45.02,0:08:47.03,Default,,0000,0000,0000,,Неліктен Юта ханшайыммен доссың?
Dialogue: 0,0:08:47.03,0:08:48.69,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:08:48.69,0:08:51.03,Default,,0000,0000,0000,,Өйткені бұл жігіт
Dialogue: 0,0:08:48.69,0:08:51.03,Default,,0000,0000,0000,,Ол Шэнкстің қызы.
Dialogue: 0,0:08:51.03,0:08:54.03,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:08:51.03,0:08:54.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:54.03,0:08:56.04,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:08:56.04,0:08:59.04,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:08:59.04,0:09:00.97,Default,,0000,0000,0000,,Хи хи хи....
Dialogue: 0,0:09:00.97,0:09:02.98,Default,,0000,0000,0000,,Шенкс...
Dialogue: 0,0:09:02.98,0:09:04.98,Default,,0000,0000,0000,,Йонко
Dialogue: 0,0:09:02.98,0:09:04.98,Default,,0000,0000,0000,,Төрт императордың қарақшылары. Ол өте зұлым адам.
Dialogue: 0,0:09:04.98,0:09:06.98,Default,,0000,0000,0000,,Мен баяғыда сенімдімін...
Dialogue: 0,0:09:06.98,0:09:10.98,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:09:06.98,0:09:10.98,Default,,0000,0000,0000,,Ол осы Элегияға шабуыл жасаған.
Dialogue: 0,0:09:10.98,0:09:12.99,Default,,0000,0000,0000,,Юта….
Dialogue: 0,0:09:12.99,0:09:15.99,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:09:15.99,0:09:19.99,Default,,0000,0000,0000,,Тікелей эфир Элегия екенін естігенде
Dialogue: 0,0:09:15.99,0:09:19.99,Default,,0000,0000,0000,,Мен не істеймін деп ойладым.
Dialogue: 0,0:09:19.99,0:09:23.00,Default,,0000,0000,0000,,Сіз сол аңыз туралы айтып отырсыз ба?
Dialogue: 0,0:09:19.99,0:09:23.00,Default,,0000,0000,0000,,Иә. ➡
Dialogue: 0,0:09:23.00,0:09:26.00,Default,,0000,0000,0000,,Бірақ мүмкін емес
Dialogue: 0,0:09:23.00,0:09:26.00,Default,,0000,0000,0000,,Одан асқан әңгіме бар екеніне сене алмаймын.
Dialogue: 0,0:09:26.00,0:09:28.00,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:09:26.00,0:09:28.00,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:28.00,0:09:30.00,Default,,0000,0000,0000,,Хехе….
Dialogue: 0,0:09:30.00,0:09:32.00,Default,,0000,0000,0000,,Не? Сіз жігіттер.
Dialogue: 0,0:09:32.00,0:09:35.01,Default,,0000,0000,0000,,Акагами
Dialogue: 0,0:09:32.00,0:09:35.01,Default,,0000,0000,0000,,Йонко Қызыл шашты Шэнкс
Dialogue: 0,0:09:32.00,0:09:35.01,Default,,0000,0000,0000,,Сіздің қызыңыз болды ма?
Dialogue: 0,0:09:35.01,0:09:38.01,Default,,0000,0000,0000,,Егер бұл рас болса
Dialogue: 0,0:09:35.01,0:09:38.01,Default,,0000,0000,0000,,Сіз біздің ең әлсіз жеріміз боласыз. ➡
Dialogue: 0,0:09:38.01,0:09:40.01,Default,,0000,0000,0000,,Қызыл шаш!
Dialogue: 0,0:09:40.01,0:09:42.01,Default,,0000,0000,0000,,
Dialogue: 0,0:09:40.01,0:09:42.01,Default,,0000,0000,0000,,Егер сіз өзіңіздің жеке басыңызды басқа күшті қарақшыға тапсырсаңыз➡
Dialogue: 0,0:09:42.01,0:09:44.02,Default,,0000,0000,0000,,Бұл жақсы ақша.
Dialogue: 0,0:09:44.02,0:09:48.02,Default,,0000,0000,0000,,Бұл өте өкінішті.
Dialogue: 0,0:09:44.02,0:09:48.02,Default,,0000,0000,0000,,Тікелей эфир тоқтатылды!
Dialogue: 0,0:09:48.02,0:09:50.02,Default,,0000,0000,0000,,Жылу де Насси
Dialogue: 0,0:09:48.02,0:09:50.02,Default,,0000,0000,0000,,Ыстық ауа жұдырығы!
Dialogue: 0,0:09:50.02,0:09:53.03,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:50.02,0:09:53.03,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:09:53.03,0:09:58.03,Default,,0000,0000,0000,,Ақыл-парасат...!
Dialogue: 0,0:09:53.03,0:09:58.03,Default,,0000,0000,0000,,Ол бала біздің олжамыз!
Dialogue: 0,0:09:58.03,0:10:01.03,Default,,0000,0000,0000,,Сіз филиалсыз!
Dialogue: 0,0:09:58.03,0:10:01.03,Default,,0000,0000,0000,,Филиал?
Dialogue: 0,0:10:01.03,0:10:03.04,Default,,0000,0000,0000,,Бұл брюле
Dialogue: 0,0:10:01.03,0:10:03.04,Default,,0000,0000,0000,,Үлкен қарақшылар!
Dialogue: 0,0:10:03.04,0:10:05.04,Default,,0000,0000,0000,,Көрші үйде кім бар?
Dialogue: 0,0:10:05.04,0:10:09.04,Default,,0000,0000,0000,,Шарлотта Линлиннің 4-ұлы, сонымен қатар Үлкен Ана деген атпен белгілі
Dialogue: 0,0:10:05.04,0:10:09.04,Default,,0000,0000,0000,,Пеш.
Dialogue: 0,0:10:09.04,0:10:11.04,Default,,0000,0000,0000,,Көңілді сияқты. Оны араластырыңыз.
Dialogue: 0,0:10:11.04,0:10:13.05,Default,,0000,0000,0000,,Хаунт.
Dialogue: 0,0:10:11.04,0:10:13.05,Default,,0000,0000,0000,,Мен барлаушыға келгенде➡
Dialogue: 0,0:10:13.05,0:10:16.05,Default,,0000,0000,0000,,Бұл қызықты нәрсе
Dialogue: 0,0:10:13.05,0:10:16.05,Default,,0000,0000,0000,,Мен оны естісем ғой.
Dialogue: 0,0:10:16.05,0:10:17.72,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:10:16.05,0:10:17.72,Default,,0000,0000,0000,,Юта. ➡
Dialogue: 0,0:10:17.72,0:10:21.05,Default,,0000,0000,0000,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:10:17.72,0:10:21.05,Default,,0000,0000,0000,,Мен саған анама сыйлық ретінде беремін.
Dialogue: 0,0:10:21.05,0:10:22.72,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:10:21.05,0:10:22.72,Default,,0000,0000,0000,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:10:22.72,0:10:24.39,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:10:24.39,0:10:27.06,Default,,0000,0000,0000,,Эй, эй! Ута-чан
Dialogue: 0,0:10:24.39,0:10:27.06,Default,,0000,0000,0000,,Мақсат қоюға батылы барлар➡
Dialogue: 0,0:10:27.06,0:10:29.06,Default,,0000,0000,0000,,Мен сенімен айналысамын!
Dialogue: 0,0:10:29.06,0:10:33.07,Default,,0000,0000,0000,,Тамаша сахнаға қарсы шығу
Dialogue: 0,0:10:29.06,0:10:33.07,Default,,0000,0000,0000,,Жеткізілмеген адамдарды жалғыз қалдыруға болмайды.
Dialogue: 0,0:10:33.07,0:10:36.07,Default,,0000,0000,0000,,Соңында
Dialogue: 0,0:10:33.07,0:10:36.07,Default,,0000,0000,0000,,Қызық болып барады!
Dialogue: 0,0:10:36.07,0:10:39.07,Default,,0000,0000,0000,,Медуза қарақшыларын бағаламаңыз!
Dialogue: 0,0:10:39.07,0:10:40.74,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:10:39.07,0:10:40.74,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:10:40.74,0:10:43.08,Default,,0000,0000,0000,,Шөгінділер
Dialogue: 0,0:10:40.74,0:10:43.08,Default,,0000,0000,0000,,Ән
Dialogue: 0,0:10:40.74,0:10:43.08,Default,,0000,0000,0000,,Фубукиги
Dialogue: 0,0:10:40.74,0:10:43.08,Default,,0000,0000,0000,,Кури Ута Фубуки Кири!
Dialogue: 0,0:10:43.08,0:10:45.08,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:10:45.08,0:10:46.75,Default,,0000,0000,0000,,Бас
Dialogue: 0,0:10:45.08,0:10:46.75,Default,,0000,0000,0000,,Кларфист!
Dialogue: 0,0:10:46.75,0:10:48.41,Default,,0000,0000,0000,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:10:48.41,0:10:50.08,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:10:50.08,0:10:53.09,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес!
Dialogue: 0,0:10:50.08,0:10:53.09,Default,,0000,0000,0000,,Жанды орындау енді ғана басталды!
Dialogue: 0,0:10:53.09,0:10:56.09,Default,,0000,0000,0000,,Жасайық! Утаны қорғау үшін!
Dialogue: 0,0:10:56.09,0:11:01.69,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:10:56.09,0:11:01.69,Default,,0000,0000,0000,,Джоджинкаратэ
Dialogue: 0,0:10:56.09,0:11:01.69,Default,,0000,0000,0000,,Жаттығу
Dialogue: 0,0:10:56.09,0:11:01.69,Default,,0000,0000,0000,,Балықшы каратэ найза толқыны!
Dialogue: 0,0:11:01.69,0:11:03.36,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:11:03.36,0:11:06.03,Default,,0000,0000,0000,,Қалғанын Super-ға қалдырыңыз!
Dialogue: 0,0:11:06.03,0:11:09.04,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:11:09.04,0:11:13.04,Default,,0000,0000,0000,,Реактивті гетлинг
Dialogue: 0,0:11:09.04,0:11:13.04,Default,,0000,0000,0000,,Гому Гомуның JET оқ атуы!
Dialogue: 0,0:11:13.04,0:11:16.04,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:16.04,0:11:20.05,Default,,0000,0000,0000,,Cienfleur
Dialogue: 0,0:11:16.04,0:11:20.05,Default,,0000,0000,0000,,Өрмекші торы
Dialogue: 0,0:11:16.04,0:11:20.05,Default,,0000,0000,0000,,Жүз гүл: Өрмекші гүлдер!
Dialogue: 0,0:11:20.05,0:11:21.71,Default,,0000,0000,0000,,Ал Хинацуру…
Dialogue: 0,0:11:21.71,0:11:23.38,Default,,0000,0000,0000,,Иә, солай!
Dialogue: 0,0:11:23.38,0:11:25.05,Default,,0000,0000,0000,,Луффи және барлығы
Dialogue: 0,0:11:23.38,0:11:25.05,Default,,0000,0000,0000,,Мені қорғағаныңыз үшін рахмет.
Dialogue: 0,0:11:25.05,0:11:28.72,Default,,0000,0000,0000,,Бірақ күрес аяқталды.
Dialogue: 0,0:11:25.05,0:11:28.72,Default,,0000,0000,0000,,Ұрыс?
Dialogue: 0,0:11:28.72,0:11:30.72,Default,,0000,0000,0000,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:11:28.72,0:11:30.72,Default,,0000,0000,0000,,Өйткені сен менің жанкүйерімсің➡
Dialogue: 0,0:11:30.72,0:11:33.06,Default,,0000,0000,0000,,Тікелей эфирден ләззат алыңыз және тіл табысыңыз.
Dialogue: 0,0:11:33.06,0:11:37.06,Default,,0000,0000,0000,,Жоқ, бірақ бұл балалар Юта ханшайымы.
Dialogue: 0,0:11:33.06,0:11:37.06,Default,,0000,0000,0000,,Олар мені алып кетпекші!
Dialogue: 0,0:11:37.06,0:11:40.07,Default,,0000,0000,0000,,Юкине-кун, барсың ба?
Dialogue: 0,0:11:37.06,0:11:40.07,Default,,0000,0000,0000,,Сіз сөйлесіп, түсінетін адам емес!
Dialogue: 0,0:11:40.07,0:11:45.07,Default,,0000,0000,0000,,Егер біз бір нәрсені қаласақ
Dialogue: 0,0:11:40.07,0:11:45.07,Default,,0000,0000,0000,,Төбелес және ұрла! Өйткені ол қарақшы!
Dialogue: 0,0:11:45.07,0:11:47.07,Default,,0000,0000,0000,,Онда қарақшы болуды доғар.
Dialogue: 0,0:11:47.07,0:11:50.08,Default,,0000,0000,0000,,Сіз жасаған жаман істер
Dialogue: 0,0:11:47.07,0:11:50.08,Default,,0000,0000,0000,,Мен сені кешіремін.
Dialogue: 0,0:11:50.08,0:11:54.08,Default,,0000,0000,0000,,Әй, бәрі де.
Dialogue: 0,0:11:50.08,0:11:54.08,Default,,0000,0000,0000,,Жаман қарақшыларды тоқтатыңыз➡
Dialogue: 0,0:11:54.08,0:11:58.08,Default,,0000,0000,0000,,Менімен бірге көңіл көтер
Dialogue: 0,0:11:54.08,0:11:58.08,Default,,0000,0000,0000,,Заманға толы әлемде уақыт өткізейік!
Dialogue: 0,0:11:58.08,0:12:00.09,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:11:58.08,0:12:00.09,Default,,0000,0000,0000,,Менің әнім болса➡
Dialogue: 0,0:12:00.09,0:12:03.02,Default,,0000,0000,0000,,Әр адам тыныш және бақытты бола алады!
Dialogue: 0,0:12:03.02,0:12:05.02,Default,,0000,0000,0000,,(Қарақшылардың күлкісі)
Dialogue: 0,0:12:05.02,0:12:08.03,Default,,0000,0000,0000,,(Пеш)
Dialogue: 0,0:12:05.02,0:12:08.03,Default,,0000,0000,0000,,Бұл дүниеде тыныштық жоқ.
Dialogue: 0,0:12:08.03,0:12:11.03,Default,,0000,0000,0000,,Ақымақ сөздер айтатын бала
Dialogue: 0,0:12:08.03,0:12:11.03,Default,,0000,0000,0000,,Бетіңді кесіп алайын ба?
Dialogue: 0,0:12:11.03,0:12:14.03,Default,,0000,0000,0000,,Ой, бұл менің олжам.
Dialogue: 0,0:12:14.03,0:12:15.70,Default,,0000,0000,0000,,Ута!
Dialogue: 0,0:12:14.03,0:12:15.70,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:12:15.70,0:12:17.37,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:12:15.70,0:12:17.37,Default,,0000,0000,0000,,Барлығың менің әнімді айтыңдар➡
Dialogue: 0,0:12:17.37,0:12:19.04,Default,,0000,0000,0000,,Сен мұнда көңіл көтеру үшін келдің ғой, солай ма?
Dialogue: 0,0:12:19.04,0:12:21.04,Default,,0000,0000,0000,,Хехе. Біз қарақшылармыз.
Dialogue: 0,0:12:21.04,0:12:24.04,Default,,0000,0000,0000,,Әннен де артық
Dialogue: 0,0:12:21.04,0:12:24.04,Default,,0000,0000,0000,,Маңызды нәрсе бар.
Dialogue: 0,0:12:24.04,0:12:27.05,Default,,0000,0000,0000,,Қорқынышты!
Dialogue: 0,0:12:24.04,0:12:27.05,Default,,0000,0000,0000,,Жанды дауыста тамаша өнер көрсетіңіз...
Dialogue: 0,0:12:27.05,0:12:30.05,Default,,0000,0000,0000,,Ута және біздің сезімдеріміз
Dialogue: 0,0:12:27.05,0:12:30.05,Default,,0000,0000,0000,,Оны тапта!
Dialogue: 0,0:12:30.05,0:12:33.05,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:12:30.05,0:12:33.05,Default,,0000,0000,0000,,Олай болса, мен оны әнге айналдырамын.
Dialogue: 0,0:12:33.05,0:12:35.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:38.06,0:12:40.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:12:40.06,0:12:46.07,Default,,0000,0000,0000,,♬ «Жүр, қорықпа.
Dialogue: 0,0:12:40.06,0:12:46.07,Default,,0000,0000,0000,,Мазасыздық жоқ».
Dialogue: 0,0:12:46.07,0:12:51.07,Default,,0000,0000,0000,,♬ «Менің арманым – әркімнің қалауы» ➡
Dialogue: 0,0:12:51.07,0:12:56.08,Default,,0000,0000,0000,,Ән
Dialogue: 0,0:12:51.07,0:12:56.08,Default,,0000,0000,0000,,♬ «Ән айтсаң, жүрегің тазарады».
Dialogue: 0,0:12:56.08,0:13:03.02,Default,,0000,0000,0000,,♬ «Жарайды, мен ең күштімін».
Dialogue: 0,0:13:03.02,0:13:06.02,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:06.02,0:13:07.69,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:13:06.02,0:13:07.69,Default,,0000,0000,0000,,О!
Dialogue: 0,0:13:07.69,0:13:10.02,Default,,0000,0000,0000,,Вахахаха!
Dialogue: 0,0:13:10.02,0:13:15.03,Default,,0000,0000,0000,,♬«Менің дауысым
Dialogue: 0,0:13:10.02,0:13:15.03,Default,,0000,0000,0000,,Кішкентай құсты аспанға алып шығу»➡
Dialogue: 0,0:13:15.03,0:13:20.03,Default,,0000,0000,0000,,Navi
Dialogue: 0,0:13:15.03,0:13:20.03,Default,,0000,0000,0000,,♬ «Тіпті желпілдеген киімдер де бишіге ұқсайды».
Dialogue: 0,0:13:20.03,0:13:26.04,Default,,0000,0000,0000,,♬ «Сенің дауысың
Dialogue: 0,0:13:20.03,0:13:26.04,Default,,0000,0000,0000,,Маған шабыт бер».
Dialogue: 0,0:13:26.04,0:13:30.04,Default,,0000,0000,0000,,♬ «Егер мені тікен тесіп кетсе,
Dialogue: 0,0:13:26.04,0:13:30.04,Default,,0000,0000,0000,,Кел, кел»➡
Dialogue: 0,0:13:30.04,0:13:35.05,Default,,0000,0000,0000,,♬ «Бұрын көрмеген жаңа декорация» ➡
Dialogue: 0,0:13:35.05,0:13:40.05,Default,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:13:35.05,0:13:40.05,Default,,0000,0000,0000,,♬ «Мен оны міндетті түрде көре аламын.
Dialogue: 0,0:13:35.05,0:13:40.05,Default,,0000,0000,0000,,Өйткені”➡
Dialogue: 0,0:13:40.05,0:13:43.06,Default,,0000,0000,0000,,♬ «Мен де бүгін тірімін» ➡
Dialogue: 0,0:13:43.06,0:13:49.06,Default,,0000,0000,0000,,♬ «Енді қол ұстасып көрейік
Dialogue: 0,0:13:43.06,0:13:49.06,Default,,0000,0000,0000,,Хикариге қарай».
Dialogue: 0,0:13:49.06,0:13:53.07,Default,,0000,0000,0000,,♬ «Әркімнің арманы – менің бақытым» ➡
Dialogue: 0,0:13:53.07,0:13:58.07,Default,,0000,0000,0000,,♬ «О, мен оның еш жерде жоқ екеніне сенімдімін.
Dialogue: 0,0:13:53.07,0:13:58.07,Default,,0000,0000,0000,,Тек сізде бар»➡
Dialogue: 0,0:13:58.07,0:14:06.01,Default,,0000,0000,0000,,Нуку
Dialogue: 0,0:13:58.07,0:14:06.01,Default,,0000,0000,0000,,♬ «Сол жылулықпен мен ең күштімін».
Dialogue: 0,0:14:06.01,0:14:12.02,Default,,0000,0000,0000,,♬ "'Сіз және ең күштісіз'"
Dialogue: 0,0:14:12.02,0:14:14.02,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:14:14.02,0:14:19.02,Default,,0000,0000,0000,,Барлығына! жаман қарақшы
Dialogue: 0,0:14:14.02,0:14:19.02,Default,,0000,0000,0000,,Бұл көңілді ән болды! ➡
Dialogue: 0,0:14:19.02,0:14:22.03,Default,,0000,0000,0000,,Қазір тыныш
Dialogue: 0,0:14:19.02,0:14:22.03,Default,,0000,0000,0000,,Уайымдамаңыз!
Dialogue: 0,0:14:22.03,0:14:26.03,Default,,0000,0000,0000,,(қолдау/қол шапалақтау)
Dialogue: 0,0:14:26.03,0:14:30.04,Default,,0000,0000,0000,,Иә! Тіпті ата-ана мен бала
Dialogue: 0,0:14:26.03,0:14:30.04,Default,,0000,0000,0000,,Шенкс пен Юта басқа!
Dialogue: 0,0:14:30.04,0:14:32.04,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:14:32.04,0:14:34.01,Default,,0000,0000,0000,,Сен күшті болып кеттің, Ута!
Dialogue: 0,0:14:38.04,0:14:44.05,Default,,0000,0000,0000,,(қолдау/қол шапалақтау)
Dialogue: 0,0:14:44.05,0:14:49.05,Default,,0000,0000,0000,,Оның қандай да бір қабілеті бар ма?
Dialogue: 0,0:14:44.05,0:14:49.05,Default,,0000,0000,0000,,Ал... Мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:14:49.05,0:14:51.06,Default,,0000,0000,0000,,О! Не? бұл.
Dialogue: 0,0:14:51.06,0:14:54.06,Default,,0000,0000,0000,,
Dialogue: 0,0:14:51.06,0:14:54.06,Default,,0000,0000,0000,,Не істеп жатырсың! Мен жақында ораламын!
Dialogue: 0,0:14:54.06,0:14:56.06,Default,,0000,0000,0000,,Хахаха.
Dialogue: 0,0:14:56.06,0:15:00.07,Default,,0000,0000,0000,,Барлығына
Dialogue: 0,0:14:56.06,0:15:00.07,Default,,0000,0000,0000,,Бізде жақсы жаңалық бар. ➡
Dialogue: 0,0:15:00.07,0:15:04.07,Default,,0000,0000,0000,,Мен кәдімгі Эйдоденден Мушиді қолдандым
Dialogue: 0,0:15:00.07,0:15:04.07,Default,,0000,0000,0000,,Тікелей трансляция➡
Dialogue: 0,0:15:04.07,0:15:08.07,Default,,0000,0000,0000,,Себебі мен шаршадым, ұйықтаймын
Dialogue: 0,0:15:04.07,0:15:08.07,Default,,0000,0000,0000,,Жақында аяқталады➡
Dialogue: 0,0:15:08.07,0:15:11.08,Default,,0000,0000,0000,,Бұл тікелей шоу шексіз.
Dialogue: 0,0:15:08.07,0:15:11.08,Default,,0000,0000,0000,,Ол мәңгілікке жалғасады!
Dialogue: 0,0:15:11.08,0:15:12.75,Default,,0000,0000,0000,,🔊 (Эйзо Денден Муши) Шықыр!
Dialogue: 0,0:15:12.75,0:15:16.08,Default,,0000,0000,0000,,🔊Иә! Барлығымен
Dialogue: 0,0:15:12.75,0:15:16.08,Default,,0000,0000,0000,,Біз мәңгі бірге бола аламыз. ➡
Dialogue: 0,0:15:16.08,0:15:18.08,Default,,0000,0000,0000,,Барлығы ағынды ұнатады➡
Dialogue: 0,0:15:18.08,0:15:22.02,Default,,0000,0000,0000,,Сіздердің де осы жерде отырғандарыңыз.
Dialogue: 0,0:15:18.08,0:15:22.02,Default,,0000,0000,0000,,Көбірек көңіл көтерейік!
Dialogue: 0,0:15:22.02,0:15:24.02,Default,,0000,0000,0000,,(қолдау/шапалақтау)
Dialogue: 0,0:15:24.02,0:15:26.03,Default,,0000,0000,0000,,Гвааах!
Dialogue: 0,0:15:24.02,0:15:26.03,Default,,0000,0000,0000,,Біз~!
Dialogue: 0,0:15:26.03,0:15:30.03,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:15:26.03,0:15:30.03,Default,,0000,0000,0000,,Жалғыз тікелей эфирде өнер көрсетуді жоспарлайсыз ба?
Dialogue: 0,0:15:30.03,0:15:32.03,Default,,0000,0000,0000,,Бұл ең жақсы!
Dialogue: 0,0:15:32.03,0:15:39.04,Default,,0000,0000,0000,,UTA! UTA!
Dialogue: 0,0:15:32.03,0:15:39.04,Default,,0000,0000,0000,,UTA! UTA! UTA! ➡
Dialogue: 0,0:15:39.04,0:15:43.04,Default,,0000,0000,0000,,UTA! UTA!
Dialogue: 0,0:15:43.04,0:15:45.04,Default,,0000,0000,0000,,Сондай-ақ, маңызды оқиға. ➡
Dialogue: 0,0:15:45.04,0:15:50.05,Default,,0000,0000,0000,,Қарақшылар
Dialogue: 0,0:15:45.04,0:15:50.05,Default,,0000,0000,0000,,Және Әскери-теңіз күштері мен Әлемдік үкімет адамдары➡
Dialogue: 0,0:15:50.05,0:15:52.05,Default,,0000,0000,0000,,Бұл тікелей орындауға кедергі жасамаңыз. ➡
Dialogue: 0,0:15:52.05,0:15:56.06,Default,,0000,0000,0000,,Барлығына арналған қызықты нәрселер
Dialogue: 0,0:15:52.05,0:15:56.06,Default,,0000,0000,0000,,Мен қуанатын нәрсе іздеймін.
Dialogue: 0,0:15:56.06,0:15:59.06,Default,,0000,0000,0000,,Егер сіз қорқынышты нәрсе жасасаңыз
Dialogue: 0,0:15:56.06,0:15:59.06,Default,,0000,0000,0000,,Дайын болыңыз. ➡
Dialogue: 0,0:15:59.06,0:16:04.06,Default,,0000,0000,0000,,Мен Утамын, жаңа дәуірді жасайтын әйелмін.
Dialogue: 0,0:15:59.06,0:16:04.06,Default,,0000,0000,0000,,Баршаңызды әндеріңізбен қуантыңыз!
Dialogue: 0,0:16:04.06,0:16:06.07,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:06.07,0:16:10.04,Default,,0000,0000,0000,,Олай болса, келесі әнге көшейік.
Dialogue: 0,0:16:12.07,0:16:15.07,Default,,0000,0000,0000,,Горосеи
Dialogue: 0,0:16:12.07,0:16:15.07,Default,,0000,0000,0000,,Қызыл шаштың қызы болды ма?
Dialogue: 0,0:16:15.07,0:16:17.08,Default,,0000,0000,0000,,Cipherpol➡ хабарлағандай
Dialogue: 0,0:16:17.08,0:16:23.02,Default,,0000,0000,0000,,Ұлы қарақшылар дәуірін толығымен жоққа шығару
Dialogue: 0,0:16:17.08,0:16:23.02,Default,,0000,0000,0000,,Мүлде жаңа жау пайда болады.
Dialogue: 0,0:16:23.02,0:16:26.02,Default,,0000,0000,0000,,Мәселе
Dialogue: 0,0:16:23.02,0:16:26.02,Default,,0000,0000,0000,,Оның соңынан адамдар да келе жатыр. ➡
Dialogue: 0,0:16:26.02,0:16:30.02,Default,,0000,0000,0000,,Төңкеріс тұқымын ерте қағу керек.
Dialogue: 0,0:16:26.02,0:16:30.02,Default,,0000,0000,0000,,тым кеш болады.
Dialogue: 0,0:16:30.02,0:16:35.03,Default,,0000,0000,0000,,Сол қыз
Dialogue: 0,0:16:30.02,0:16:35.03,Default,,0000,0000,0000,,Бұл Фигеранд әулетінің қаны ма?
Dialogue: 0,0:16:35.03,0:16:38.03,Default,,0000,0000,0000,,Маған Totto Musica бар екені де қызық.
Dialogue: 0,0:16:38.03,0:16:40.03,Default,,0000,0000,0000,,Тот музыка. ➡
Dialogue: 0,0:16:40.03,0:16:43.04,Default,,0000,0000,0000,,Егер сол зат қайта оянса➡
Dialogue: 0,0:16:43.04,0:16:46.00,Default,,0000,0000,0000,,Оны жеңілдетуге ешқандай себеп жоқ
Dialogue: 0,0:16:43.04,0:16:46.00,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:16:48.04,0:16:52.04,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:16:48.04,0:16:52.04,Default,,0000,0000,0000,,Утаны бағындыру туралы шешім қабылданды. ➡
Dialogue: 0,0:16:52.04,0:16:55.05,Default,,0000,0000,0000,,Ол қауіпті.
Dialogue: 0,0:16:52.04,0:16:55.05,Default,,0000,0000,0000,,🔊 (Борсалино) Бұл қорқынышты. ➡
Dialogue: 0,0:16:55.05,0:16:59.05,Default,,0000,0000,0000,,Тек бір қыз
Dialogue: 0,0:16:55.05,0:16:59.05,Default,,0000,0000,0000,,Бүкіл әлем назар аударып отыр.
Dialogue: 0,0:16:59.05,0:17:02.05,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:16:59.05,0:17:02.05,Default,,0000,0000,0000,,Неге жеңіл қарамайсың? ➡
Dialogue: 0,0:17:02.05,0:17:05.06,Default,,0000,0000,0000,,Орналасқан жері Элегия, музыка аралы. ➡
Dialogue: 0,0:17:05.06,0:17:09.06,Default,,0000,0000,0000,,Ертеде ол жерде мөр басылған.
Dialogue: 0,0:17:05.06,0:17:09.06,Default,,0000,0000,0000,,Totto Musica бар.
Dialogue: 0,0:17:09.06,0:17:12.06,Default,,0000,0000,0000,,🔊
Dialogue: 0,0:17:09.06,0:17:12.06,Default,,0000,0000,0000,,Сіз қанша жұмсайсыз?
Dialogue: 0,0:17:12.06,0:17:15.07,Default,,0000,0000,0000,,Элегияға
Dialogue: 0,0:17:12.06,0:17:15.07,Default,,0000,0000,0000,,Дәл қазір қандай әскери кемелерді жіберуге болады?
Dialogue: 0,0:17:15.07,0:17:17.07,Default,,0000,0000,0000,,🔊30 кеме.
Dialogue: 0,0:17:17.07,0:17:21.07,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:17:17.07,0:17:21.07,Default,,0000,0000,0000,,Рота мен взводты басқарып, барлық кемелерді жібер!
Dialogue: 0,0:17:21.07,0:17:23.08,Default,,0000,0000,0000,,Денден қатесі
Dialogue: 0,0:17:21.07,0:17:23.08,Default,,0000,0000,0000,,🔊 (Теңіз) Денден Мушидің жағдайы нашар болғанда...
Dialogue: 0,0:17:23.08,0:17:43.10,Default,,0000,0000,0000,,🔊 (Байланысқа кедергі келтіретін дауыс)
Dialogue: 0,0:17:43.10,0:17:47.10,Default,,0000,0000,0000,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:17:43.10,0:17:47.10,Default,,0000,0000,0000,,Сіз аштыңыз ба? ➡
Dialogue: 0,0:17:47.10,0:17:53.11,Default,,0000,0000,0000,,Жарайды. Тамақ қызық сияқты
Dialogue: 0,0:17:47.10,0:17:53.11,Default,,0000,0000,0000,,Мен көп нәрсе жасаймын!
Dialogue: 0,0:17:53.11,0:17:57.11,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:17:53.11,0:17:57.11,Default,,0000,0000,0000,,Осыны қалайтыныңызға сенімдісіз бе?
Dialogue: 0,0:17:57.11,0:18:01.11,Default,,0000,0000,0000,,Әрине! барлығы осында
Dialogue: 0,0:17:57.11,0:18:01.11,Default,,0000,0000,0000,,Өзіңізге ұнайтын нәрсені, ұнаған кезде жеңіз➡
Dialogue: 0,0:18:01.11,0:18:05.12,Default,,0000,0000,0000,,Менімен бірге ән айт, би биле
Dialogue: 0,0:18:01.11,0:18:05.12,Default,,0000,0000,0000,,Тек көңіл көтеріңіз!
Dialogue: 0,0:18:05.12,0:18:07.12,Default,,0000,0000,0000,,Бұл арман сияқты...
Dialogue: 0,0:18:07.12,0:18:10.12,Default,,0000,0000,0000,,Егер сен менімен болсаң
Dialogue: 0,0:18:07.12,0:18:10.12,Default,,0000,0000,0000,,Кез келген арман орындалады!
Dialogue: 0,0:18:10.12,0:18:14.13,Default,,0000,0000,0000,,Барлығын не қорқытады?
Dialogue: 0,0:18:10.12,0:18:14.13,Default,,0000,0000,0000,,Ешқайда!
Dialogue: 0,0:18:14.13,0:18:16.13,Default,,0000,0000,0000,,Жаңа дәуір ең жақсы!
Dialogue: 0,0:18:16.13,0:18:19.06,Default,,0000,0000,0000,,(қолдау/қол шапалақтау)
Dialogue: 0,0:18:16.13,0:18:19.06,Default,,0000,0000,0000,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:18:19.06,0:18:21.33,Default,,0000,0000,0000,,(қолдау/қол шапалақтау)
Dialogue: 0,0:18:23.07,0:18:26.07,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:18:23.07,0:18:26.07,Default,,0000,0000,0000,,Бұл мен күткеннен де қабілетті.
Dialogue: 0,0:18:26.07,0:18:29.07,Default,,0000,0000,0000,,Мен оны тым төмен бағаладым ба?
Dialogue: 0,0:18:29.07,0:18:31.08,Default,,0000,0000,0000,,Мама мама!
Dialogue: 0,0:18:31.08,0:18:35.08,Default,,0000,0000,0000,,Тек бұл қабілет емес
Dialogue: 0,0:18:31.08,0:18:35.08,Default,,0000,0000,0000,,Қызыл шашты қыз?
Dialogue: 0,0:18:35.08,0:18:38.08,Default,,0000,0000,0000,,Не болса да аламын.
Dialogue: 0,0:18:38.08,0:18:42.09,Default,,0000,0000,0000,,Және бұл қарғыс
Dialogue: 0,0:18:38.08,0:18:42.09,Default,,0000,0000,0000,,Бидай
Dialogue: 0,0:18:38.08,0:18:42.09,Default,,0000,0000,0000,,Тіпті сабан шляпа қарақшылары оны жек көреді.
Dialogue: 0,0:18:42.09,0:18:44.09,Default,,0000,0000,0000,,Жалаңаш, Перорин.
Dialogue: 0,0:18:44.09,0:18:48.09,Default,,0000,0000,0000,,Мен Элегияға барамын.
Dialogue: 0,0:18:48.09,0:18:53.07,Default,,0000,0000,0000,,Менің әпкемді қолымнан алып кетті
Dialogue: 0,0:18:48.09,0:18:53.07,Default,,0000,0000,0000,,Біз үнсіз қала алмаймыз.
Dialogue: 0,0:18:56.10,0:18:58.10,Default,,0000,0000,0000,,Бұл жер аспаздар үшін жұмақ.
Dialogue: 0,0:18:58.10,0:19:01.11,Default,,0000,0000,0000,,Ютадан сұрасаң, ол да саған қызмет етеді.
Dialogue: 0,0:19:01.11,0:19:04.11,Default,,0000,0000,0000,,​​О, түсіндім!
Dialogue: 0,0:19:01.11,0:19:04.11,Default,,0000,0000,0000,,Ута болса, қазыналар бірінен соң бірі болады!
Dialogue: 0,0:19:04.11,0:19:07.45,Default,,0000,0000,0000,,Бұл қандай қабілет?
Dialogue: 0,0:19:04.11,0:19:07.45,Default,,0000,0000,0000,,Ой.
Dialogue: 0,0:19:07.45,0:19:10.12,Default,,0000,0000,0000,,Оны шайтанның жемісі қабілетіне айналдыр
Dialogue: 0,0:19:07.45,0:19:10.12,Default,,0000,0000,0000,,Кез келген нәрсе тым көп болар еді.
Dialogue: 0,0:19:10.12,0:19:12.12,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:19:12.12,0:19:14.12,Default,,0000,0000,0000,,Осындай жан-жақты қабілет
Dialogue: 0,0:19:12.12,0:19:14.12,Default,,0000,0000,0000,,Мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:19:14.12,0:19:17.12,Default,,0000,0000,0000,,Луффи.
Dialogue: 0,0:19:14.12,0:19:17.12,Default,,0000,0000,0000,,Сіз Ютаның досысыз ба?
Dialogue: 0,0:19:17.12,0:19:18.72,Default,,0000,0000,0000,,Сіз бірдеңе білмейсіз бе?
Dialogue: 0,0:19:18.72,0:19:23.06,Default,,0000,0000,0000,,Ол көптен бері жүр.
Dialogue: 0,0:19:18.72,0:19:23.06,Default,,0000,0000,0000,,Маған ән қатты ұнады!
Dialogue: 0,0:19:23.06,0:19:25.06,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:23.06,0:19:25.06,Default,,0000,0000,0000,,Йохохохо...!
Dialogue: 0,0:19:25.06,0:19:27.07,Default,,0000,0000,0000,,Мүмкін Ута-сан➡
Dialogue: 0,0:19:27.07,0:19:30.07,Default,,0000,0000,0000,,Құдіретті күш
Dialogue: 0,0:19:27.07,0:19:30.07,Default,,0000,0000,0000,,Бұл берілген болуы мүмкін. ➡
Dialogue: 0,0:19:30.07,0:19:32.07,Default,,0000,0000,0000,,Музыка құдайына.
Dialogue: 0,0:19:32.07,0:19:35.07,Default,,0000,0000,0000,,Луффи. Барлығы көңілді ме?
Dialogue: 0,0:19:35.07,0:19:37.08,Default,,0000,0000,0000,,Иә! Юта ханшайымы!
Dialogue: 0,0:19:37.08,0:19:40.08,Default,,0000,0000,0000,,Кейбір ерекше ингредиенттер де бар.
Dialogue: 0,0:19:37.08,0:19:40.08,Default,,0000,0000,0000,,Бұл жерде жұмақ.
Dialogue: 0,0:19:40.08,0:19:42.08,Default,,0000,0000,0000,,Көп көңілді!
Dialogue: 0,0:19:42.08,0:19:46.08,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:19:42.08,0:19:46.08,Default,,0000,0000,0000,,Луффидің достары қуанып қалды.
Dialogue: 0,0:19:46.08,0:19:48.75,Default,,0000,0000,0000,,Эй, бәрі осы ма?
Dialogue: 0,0:19:46.08,0:19:48.75,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:19:48.75,0:19:51.09,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:19:48.75,0:19:51.09,Default,,0000,0000,0000,,Сол қалпақ...
Dialogue: 0,0:19:51.09,0:19:53.09,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:19:51.09,0:19:53.09,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:19:53.09,0:19:59.10,Default,,0000,0000,0000,,Луффи, неге біраз уақыттан кейін бірінші рет төбелеспейсің?
Dialogue: 0,0:19:53.09,0:19:59.10,Default,,0000,0000,0000,,Дәл қазір мені жеңу мүмкін емес.
Dialogue: 0,0:19:59.10,0:20:03.10,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:19:59.10,0:20:03.10,Default,,0000,0000,0000,,Мен 183 ойындық жеңіс сериясында болсам да!
Dialogue: 0,0:20:03.10,0:20:06.10,Default,,0000,0000,0000,,Жоқ! Менде қатарынан 183 жеңіс бар!
Dialogue: 0,0:20:06.10,0:20:10.11,Default,,0000,0000,0000,,Қабылдаудағы айырмашылық тым күрт.
Dialogue: 0,0:20:06.10,0:20:10.11,Default,,0000,0000,0000,,Жарыс дегеніміз не?
Dialogue: 0,0:20:10.11,0:20:15.11,Default,,0000,0000,0000,,Ұзақ уақыт бұрын мен Луффимен көптеген қақтығыстарға тап болдым.
Dialogue: 0,0:20:10.11,0:20:15.11,Default,,0000,0000,0000,,Пышақ лақтыру, қол күресі, т.б. ➡
Dialogue: 0,0:20:15.11,0:20:18.12,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:20:15.11,0:20:18.12,Default,,0000,0000,0000,,Бүгінгі шара ретінде осыны таңдайық!
Dialogue: 0,0:20:18.12,0:20:20.09,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:20:24.06,0:20:26.06,Default,,0000,0000,0000,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:20:26.06,0:20:29.06,Default,,0000,0000,0000,,Тауық жарысы!
Dialogue: 0,0:20:26.06,0:20:29.06,Default,,0000,0000,0000,,Оны тез жеген адам жеңеді.
Dialogue: 0,0:20:29.06,0:20:33.07,Default,,0000,0000,0000,,О, бұл сондай сағыныш. Қалғаны...
Dialogue: 0,0:20:29.06,0:20:33.07,Default,,0000,0000,0000,,Жарайды. ➡
Dialogue: 0,0:20:33.07,0:20:35.07,Default,,0000,0000,0000,,Себебі мен оны дұрыс дайындадым.
Dialogue: 0,0:20:35.07,0:20:37.07,Default,,0000,0000,0000,,Муу!
Dialogue: 0,0:20:37.07,0:20:38.74,Default,,0000,0000,0000,,Жасайық!
Dialogue: 0,0:20:38.74,0:20:41.01,Default,,0000,0000,0000,,Жарайды….
Dialogue: 0,0:20:38.74,0:20:41.01,Default,,0000,0000,0000,,3 2 1!
Dialogue: 0,0:20:52.08,0:20:56.09,Default,,0000,0000,0000,,Беру.
Dialogue: 0,0:20:52.08,0:20:56.09,Default,,0000,0000,0000,,Уау! Рақмет сізге!
Dialogue: 0,0:20:56.09,0:20:58.09,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:20:58.09,0:20:59.76,Default,,0000,0000,0000,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:20:59.76,0:21:01.43,Default,,0000,0000,0000,,Муу~!
Dialogue: 0,0:21:01.43,0:21:04.10,Default,,0000,0000,0000,,Юта жеңді!
Dialogue: 0,0:21:01.43,0:21:04.10,Default,,0000,0000,0000,,Жеңіс!
Dialogue: 0,0:21:04.10,0:21:06.10,Default,,0000,0000,0000,,Уайымдамаңыз!
Dialogue: 0,0:21:06.10,0:21:07.77,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:21:07.77,0:21:09.43,Default,,0000,0000,0000,,Ах. Теңіз ақылсыз.
Dialogue: 0,0:21:09.43,0:21:13.11,Default,,0000,0000,0000,,Хабадеби Бобоба….
Dialogue: 0,0:21:13.11,0:21:17.11,Default,,0000,0000,0000,,Хаха~! Апыр-ай!
Dialogue: 0,0:21:17.11,0:21:20.05,Default,,0000,0000,0000,,көремін. Луффи де
Dialogue: 0,0:21:17.11,0:21:20.05,Default,,0000,0000,0000,,Сен шайтанның жемісін жедің.
Dialogue: 0,0:21:20.05,0:21:22.38,Default,,0000,0000,0000,,Кешіріңіз. Кешіріңіз.
Dialogue: 0,0:21:20.05,0:21:22.38,Default,,0000,0000,0000,,Бұрын болған оқиға заң бұзушылық болды!
Dialogue: 0,0:21:22.38,0:21:23.95,Default,,0000,0000,0000,,Тағы бір рет!
Dialogue: 0,0:21:22.38,0:21:23.95,Default,,0000,0000,0000,,Бұл шықты! Мен жеңілгеніме өкінемін.
Dialogue: 0,0:21:28.05,0:21:30.06,Default,,0000,0000,0000,,Себебі мен жеңдім
Dialogue: 0,0:21:28.05,0:21:30.06,Default,,0000,0000,0000,,Айтыңызшы. Шенкс қайда?
Dialogue: 0,0:21:30.06,0:21:31.72,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:21:30.06,0:21:31.72,Default,,0000,0000,0000,,Егер солай болса➡
Dialogue: 0,0:21:31.72,0:21:34.06,Default,,0000,0000,0000,,Мынау сабаннан жасалған қалпақ не?
Dialogue: 0,0:21:31.72,0:21:34.06,Default,,0000,0000,0000,,Мен оны сақтаймын.
Dialogue: 0,0:21:34.06,0:21:37.06,Default,,0000,0000,0000,,Эй, Луффи және Юта
Dialogue: 0,0:21:34.06,0:21:37.06,Default,,0000,0000,0000,,Сіз қай жерде кездестіңіз?
Dialogue: 0,0:21:37.06,0:21:42.07,Default,,0000,0000,0000,,Біркелкі емес
Dialogue: 0,0:21:37.06,0:21:42.07,Default,,0000,0000,0000,,А? Бұл жігіт Фуша ауылында.
Dialogue: 0,0:21:37.06,0:21:42.07,Default,,0000,0000,0000,,Ол Шэнкспен және басқалармен бірге келді.
Dialogue: 0,0:21:42.07,0:21:45.07,Default,,0000,0000,0000,,Фуша ауылы дегеніміз не?
Dialogue: 0,0:21:42.07,0:21:45.07,Default,,0000,0000,0000,,Бұл Луффидің туған қаласы болды, солай ма?
Dialogue: 0,0:21:45.07,0:21:47.04,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:21:52.01,0:21:55.01,Default,,0000,0000,0000,,Юта тағы да түсінде!
Dialogue: 0,0:21:55.01,0:21:57.02,Default,,0000,0000,0000,,Сенің де келуің керек.
Dialogue: 0,0:21:57.02,0:22:00.02,Default,,0000,0000,0000,,Маған ұнамайды. Бұл қызықсыз.
Dialogue: 0,0:21:57.02,0:22:00.02,Default,,0000,0000,0000,,Оның орнына жарысайық!
Dialogue: 0,0:22:00.02,0:22:05.36,Default,,0000,0000,0000,,Ол бала ғой.
Dialogue: 0,0:22:00.02,0:22:05.36,Default,,0000,0000,0000,,Олай болса, шайқас...
Dialogue: 0,0:22:05.36,0:22:07.03,Default,,0000,0000,0000,,Тауық жарысы!
Dialogue: 0,0:22:07.03,0:22:09.03,Default,,0000,0000,0000,,Бір!
Dialogue: 0,0:22:09.03,0:22:11.03,Default,,0000,0000,0000,,Тез тамақтаныңыз
Dialogue: 0,0:22:09.03,0:22:11.03,Default,,0000,0000,0000,,Қашқан жеңеді!
Dialogue: 0,0:22:11.03,0:22:15.03,Default,,0000,0000,0000,,О!
Dialogue: 0,0:22:11.03,0:22:15.03,Default,,0000,0000,0000,,Қауіпті! Тоқта, екеуің де!
Dialogue: 0,0:22:15.03,0:22:17.04,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:22:15.03,0:22:17.04,Default,,0000,0000,0000,,Ута! Луффи!
Dialogue: 0,0:22:17.04,0:22:20.04,Default,,0000,0000,0000,,
Dialogue: 0,0:22:17.04,0:22:20.04,Default,,0000,0000,0000,,Олар қалағанын істесін.
Dialogue: 0,0:22:20.04,0:22:21.71,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:22:21.71,0:22:24.04,Default,,0000,0000,0000,,Осы жігіттер үшін
Dialogue: 0,0:22:21.71,0:22:24.04,Default,,0000,0000,0000,,Бұл маңызды ойын.
Dialogue: 0,0:22:24.04,0:22:26.04,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:22:24.04,0:22:26.04,Default,,0000,0000,0000,,Жасайық!
Dialogue: 0,0:22:26.04,0:22:29.05,Default,,0000,0000,0000,,Жарайды….
Dialogue: 0,0:22:26.04,0:22:29.05,Default,,0000,0000,0000,,3 2 1!
Dialogue: 0,0:22:29.05,0:22:32.05,Default,,0000,0000,0000,,
Dialogue: 0,0:22:29.05,0:22:32.05,Default,,0000,0000,0000,,Сіз не үшін ұрысып жатырсыз?
Dialogue: 0,0:22:32.05,0:22:35.02,Default,,0000,0000,0000,,Қайсысы?
Dialogue: 0,0:22:32.05,0:22:35.02,Default,,0000,0000,0000,,Сіз керемет қарақшы бола аласыз ба?
Dialogue: 0,0:22:38.06,0:22:41.06,Default,,0000,0000,0000,,Луффи жеңе ме?
Dialogue: 0,0:22:41.06,0:22:44.06,Default,,0000,0000,0000,,Мен саған шырын беремін.
Dialogue: 0,0:22:41.06,0:22:44.06,Default,,0000,0000,0000,,Уау, рахмет!
Dialogue: 0,0:22:44.06,0:22:46.06,Default,,0000,0000,0000,,Бір!
Dialogue: 0,0:22:44.06,0:22:46.06,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:46.06,0:22:48.07,Default,,0000,0000,0000,,Луффи!
Dialogue: 0,0:22:46.06,0:22:48.07,Default,,0000,0000,0000,,Даа~!
Dialogue: 0,0:22:48.07,0:22:50.00,Default,,0000,0000,0000,,Бұл тағы да болды!
Dialogue: 0,0:22:50.00,0:22:54.01,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:22:50.00,0:22:54.01,Default,,0000,0000,0000,,Әлі жоқ... қорытынды әлі жеткен жоқ!
Dialogue: 0,0:22:54.01,0:22:57.01,Default,,0000,0000,0000,,шықты! Мен жеңілгеніме өкінемін.
Dialogue: 0,0:22:54.01,0:22:57.01,Default,,0000,0000,0000,,Алдау үшін сен кінәлісің!
Dialogue: 0,0:22:57.01,0:23:00.01,Default,,0000,0000,0000,,Мен қарақшымын.
Dialogue: 0,0:22:57.01,0:23:00.01,Default,,0000,0000,0000,,Бұл жерде жасырын ештеңе жоқ.
Dialogue: 0,0:23:00.01,0:23:03.01,Default,,0000,0000,0000,,Күрделі матчта сақтықты түсірдіңіз.
Dialogue: 0,0:23:00.01,0:23:03.01,Default,,0000,0000,0000,,Ол жай ғана бала ғой, солай ма?
Dialogue: 0,0:23:03.01,0:23:07.02,Default,,0000,0000,0000,,Сіз әлі Шенкссіз.
Dialogue: 0,0:23:03.01,0:23:07.02,Default,,0000,0000,0000,,Олар қарақшылар деп танылмаса да!
Dialogue: 0,0:23:07.02,0:23:10.02,Default,,0000,0000,0000,,Шулы!
Dialogue: 0,0:23:07.02,0:23:10.02,Default,,0000,0000,0000,,Мен Шэнкстің қызымын! ➡
Dialogue: 0,0:23:10.02,0:23:14.03,Default,,0000,0000,0000,,Сіздей емес, біз жылдар бойы біргеміз.
Dialogue: 0,0:23:10.02,0:23:14.03,Default,,0000,0000,0000,,Қайықта шытырман оқиғаға бару! ➡
Dialogue: 0,0:23:14.03,0:23:16.36,Default,,0000,0000,0000,,Үлкен айырмашылық бар!
Dialogue: 0,0:23:14.03,0:23:16.36,Default,,0000,0000,0000,,Мен саған кір жудым.
Dialogue: 0,0:23:16.36,0:23:18.03,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:23:16.36,0:23:18.03,Default,,0000,0000,0000,,Олай болса➡
Dialogue: 0,0:23:18.03,0:23:22.03,Default,,0000,0000,0000,,Қарақшы сияқты шайқасып, жеңіске жет!
Dialogue: 0,0:23:18.03,0:23:22.03,Default,,0000,0000,0000,,Сіз қайда болғыңыз келеді!
Dialogue: 0,0:23:22.03,0:23:23.70,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:23:23.70,0:23:27.04,Default,,0000,0000,0000,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:23:27.04,0:23:30.04,Default,,0000,0000,0000,,Қалағаныңды істе.
Dialogue: 0,0:23:30.04,0:23:34.05,Default,,0000,0000,0000,,Балаға қылыш қолдануға қалай батылы барады?
Dialogue: 0,0:23:30.04,0:23:34.05,Default,,0000,0000,0000,,Сіз оны қарақшылардың желіне қарсы қоя алмайсыз, Шенкс.
Dialogue: 0,0:23:34.05,0:23:37.05,Default,,0000,0000,0000,,Идиот.
Dialogue: 0,0:23:34.05,0:23:37.05,Default,,0000,0000,0000,,Қазіргісі махаббат қамшысы деп аталады.
Dialogue: 0,0:23:37.05,0:23:39.05,Default,,0000,0000,0000,,Бұл қамшы емес, қылыш болды.
Dialogue: 0,0:23:39.05,0:23:41.05,Default,,0000,0000,0000,,Бұл қазірдің өзінде... махаббат~➡
Dialogue: 0,0:23:41.05,0:23:45.06,Default,,0000,0000,0000,,Бұл мені жақсы көретініңді білдіре ме?
Dialogue: 0,0:23:41.05,0:23:45.06,Default,,0000,0000,0000,,Шенкс~.
Dialogue: 0,0:23:45.06,0:23:48.06,Default,,0000,0000,0000,,Шенкс~.
Dialogue: 0,0:23:48.06,0:23:51.00,Default,,0000,0000,0000,,Ютаға немесе Луффиге жабыспа.
Dialogue: 0,0:23:51.00,0:23:55.00,Default,,0000,0000,0000,,Әке туралы не айтып тұрсыз?
Dialogue: 0,0:23:51.00,0:23:55.00,Default,,0000,0000,0000,,Сіз мені Шенкс деп атайсыз ба?
Dialogue: 0,0:23:55.00,0:23:58.00,Default,,0000,0000,0000,,Бұл менің әкем болса да.
Dialogue: 0,0:23:55.00,0:23:58.00,Default,,0000,0000,0000,,Өйткені ол менің арманымның капитаны.
Dialogue: 0,0:23:58.00,0:24:00.01,Default,,0000,0000,0000,,Керемет, солай ма?
Dialogue: 0,0:24:00.01,0:24:02.01,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:24:02.01,0:24:06.68,Default,,0000,0000,0000,,Ах~ Мен бүгін тағы да Луффиді жеңдім.
Dialogue: 0,0:24:02.01,0:24:06.68,Default,,0000,0000,0000,,Мен өзімді жақсы сезінемін, ендеше ән айтайық!
Dialogue: 0,0:24:06.68,0:24:09.01,Default,,0000,0000,0000,,Шенкс!
Dialogue: 0,0:24:06.68,0:24:09.01,Default,,0000,0000,0000,,Мен де жүзуім керек!
Dialogue: 0,0:24:09.01,0:24:12.02,Default,,0000,0000,0000,,Сіздей қызу қанды жігіт
Dialogue: 0,0:24:09.01,0:24:12.02,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:24:12.02,0:24:15.02,Default,,0000,0000,0000,,Юта ше?
Dialogue: 0,0:24:12.02,0:24:15.02,Default,,0000,0000,0000,,Ұрыс кезінде бұл сіздің кеменің нөмірі.
Dialogue: 0,0:24:15.02,0:24:18.02,Default,,0000,0000,0000,,Мұны істеу мүмкін емес.
Dialogue: 0,0:24:15.02,0:24:18.02,Default,,0000,0000,0000,,Уф... ой...
Dialogue: 0,0:24:18.02,0:24:20.03,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:24:18.02,0:24:20.03,Default,,0000,0000,0000,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:24:20.03,0:24:23.03,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:24:20.03,0:24:23.03,Default,,0000,0000,0000,,Акагами
Dialogue: 0,0:24:20.03,0:24:23.03,Default,,0000,0000,0000,,Ута, Қызыл шашты қарақшылардың музыканты.
Dialogue: 0,0:24:23.03,0:24:28.03,Default,,0000,0000,0000,,Әр адам еркін бола алатын жаңа дәуір
Dialogue: 0,0:24:23.03,0:24:28.03,Default,,0000,0000,0000,,Жырдан жаралған әйел.
Dialogue: 0,0:24:28.03,0:24:30.04,Default,,0000,0000,0000,,Енді біздің музыканттың сахнасы!
Dialogue: 0,0:24:30.04,0:24:36.04,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:36.04,0:24:44.05,Default,,0000,0000,0000,,♬ «Бұл жел қайдан шықты?» ➡
Dialogue: 0,0:24:44.05,0:24:49.99,Default,,0000,0000,0000,,♬«Сұрасаң да
Dialogue: 0,0:24:44.05,0:24:49.99,Default,,0000,0000,0000,,Аспан ештеңе айтпайды»➡
Dialogue: 0,0:24:49.99,0:24:57.00,Default,,0000,0000,0000,,...
Dialogue: 0,0:24:49.99,0:24:57.00,Default,,0000,0000,0000,,♬ «Бұл ән бізді қайда апарады?» ➡
Dialogue: 0,0:24:57.00,0:25:04.00,Default,,0000,0000,0000,,♬ «Мен оны тапқым келеді.
Dialogue: 0,0:24:57.00,0:25:04.00,Default,,0000,0000,0000,,Сіздің жеке жауапыңыз»➡
Dialogue: 0,0:25:04.00,0:25:16.01,Default,,0000,0000,0000,,♬ «Мен әлі білмеген теңіздің соңына дейін
Dialogue: 0,0:25:04.00,0:25:16.01,Default,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:25:04.00,0:25:16.01,Default,,0000,0000,0000,,Есікті бастайық»➡
Dialogue: 0,0:25:16.01,0:25:19.02,Default,,0000,0000,0000,,♬ “Тек бір…”
Dialogue: 0,0:25:19.02,0:25:22.02,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:25:22.02,0:25:23.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:25:29.03,0:25:31.00,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:25:33.03,0:25:35.03,Default,,0000,0000,0000,,Содан кейін мен ән айтамын!
Dialogue: 0,0:25:35.03,0:25:39.04,Default,,0000,0000,0000,,Жарайды, ән айт!
Dialogue: 0,0:25:35.03,0:25:39.04,Default,,0000,0000,0000,,О!
Dialogue: 0,0:25:39.04,0:25:41.04,Default,,0000,0000,0000,,Хэхехе...
Dialogue: 0,0:25:41.04,0:25:44.04,Default,,0000,0000,0000,,Иә, сіз
Dialogue: 0,0:25:41.04,0:25:44.04,Default,,0000,0000,0000,,Ол кенет жоғалып кетті.
Dialogue: 0,0:25:44.04,0:25:46.04,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:25:46.04,0:25:48.05,Default,,0000,0000,0000,,Сіз кенеттен нені айтасыз?
Dialogue: 0,0:25:48.05,0:25:52.05,Default,,0000,0000,0000,,Мен сенімдімін...
Dialogue: 0,0:25:52.05,0:25:56.05,Default,,0000,0000,0000,,Мен Шэнкс пен басқалардың қайтып келуін күтемін.
Dialogue: 0,0:25:52.05,0:25:56.05,Default,,0000,0000,0000,,Мен сені күттім.
Dialogue: 0,0:25:56.05,0:25:58.06,Default,,0000,0000,0000,,Бірақ сол күні...
Dialogue: 0,0:25:58.06,0:26:02.06,Default,,0000,0000,0000,,Қайтадан қош келдіңіз!
Dialogue: 0,0:25:58.06,0:26:02.06,Default,,0000,0000,0000,,Бүгін қандай шытырман оқиғаға тап болдыңыз?
Dialogue: 0,0:26:02.06,0:26:04.06,Default,,0000,0000,0000,,Иә? Бұл не?
Dialogue: 0,0:26:04.06,0:26:07.07,Default,,0000,0000,0000,,Жақсы, мен Ютадан сұраймын!
Dialogue: 0,0:26:07.07,0:26:10.07,Default,,0000,0000,0000,,Ута~! Керемет~!
Dialogue: 0,0:26:10.07,0:26:16.07,Default,,0000,0000,0000,,Мен сіздің шытырман оқиғаларыңыз туралы тағы да мақтанғаныңызды тыңдаймын.
Dialogue: 0,0:26:10.07,0:26:16.07,Default,,0000,0000,0000,,Қай жерде? Ута!
Dialogue: 0,0:26:16.07,0:26:20.05,Default,,0000,0000,0000,,Шенкс
Dialogue: 0,0:26:16.07,0:26:20.05,Default,,0000,0000,0000,,Юта қайда кетті?
Dialogue: 0,0:26:23.08,0:26:28.09,Default,,0000,0000,0000,,Жер
Dialogue: 0,0:26:23.08,0:26:28.09,Default,,0000,0000,0000,,Ютаға бірдеңе болды ма?
Dialogue: 0,0:26:28.09,0:26:30.09,Default,,0000,0000,0000,,Уайымдама, Луффи. ➡
Dialogue: 0,0:26:30.09,0:26:34.09,Default,,0000,0000,0000,,Ютахана
Dialogue: 0,0:26:30.09,0:26:34.09,Default,,0000,0000,0000,,Әнші болу үшін кемеден шықтым. ➡
Dialogue: 0,0:26:34.09,0:26:36.06,Default,,0000,0000,0000,,Барлығы осы.
Dialogue: 0,0:26:38.10,0:26:42.10,Default,,0000,0000,0000,,Сәлем, Юта. Сіз
Dialogue: 0,0:26:38.10,0:26:42.10,Default,,0000,0000,0000,,Неліктен қарақшы болуды қойдыңыз?
Dialogue: 0,0:26:42.10,0:26:46.10,Default,,0000,0000,0000,,Міне, қызыл шашты қарақшылар
Dialogue: 0,0:26:42.10,0:26:46.10,Default,,0000,0000,0000,,Маған ұнады.
Dialogue: 0,0:26:46.10,0:26:50.04,Default,,0000,0000,0000,,Қарақшы болғаннан гөрі әнші болғаным артық
Dialogue: 0,0:26:46.10,0:26:50.04,Default,,0000,0000,0000,,Өйткені мен солай ойладым.
Dialogue: 0,0:26:50.04,0:26:54.05,Default,,0000,0000,0000,,Қараңызшы, мен екі жылдай белсенді болдым.
Dialogue: 0,0:26:50.04,0:26:54.05,Default,,0000,0000,0000,,Оның бүкіл әлемде жанкүйерлері бар.
Dialogue: 0,0:26:54.05,0:26:56.05,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:26:56.05,0:26:59.05,Default,,0000,0000,0000,,Луффи ше?
Dialogue: 0,0:26:56.05,0:26:59.05,Default,,0000,0000,0000,,Қазір не істеп жатырсың?
Dialogue: 0,0:26:59.05,0:27:02.05,Default,,0000,0000,0000,,Қарақшы екені көрініп тұр.
Dialogue: 0,0:27:02.05,0:27:05.06,Default,,0000,0000,0000,,Мен көремін. Қарақшы?
Dialogue: 0,0:27:05.06,0:27:08.06,Default,,0000,0000,0000,,Ах. Мен қарақшылардың патшасы боламын.
Dialogue: 0,0:27:08.06,0:27:11.06,Default,,0000,0000,0000,,Эй, Луффи, қарақшы болуды доғар.
Dialogue: 0,0:27:11.06,0:27:14.07,Default,,0000,0000,0000,,Осы жерде бірге бақытты өмір сүрейік.
Dialogue: 0,0:27:14.07,0:27:17.07,Default,,0000,0000,0000,,Менің барлық достарым
Dialogue: 0,0:27:14.07,0:27:17.07,Default,,0000,0000,0000,,Сен менің жанкүйерімсің, солай ма?
Dialogue: 0,0:27:17.07,0:27:19.07,Default,,0000,0000,0000,,Бірге болу қызықтырақ!
Dialogue: 0,0:27:19.07,0:27:22.07,Default,,0000,0000,0000,,Ей!
Dialogue: 0,0:27:19.07,0:27:22.07,Default,,0000,0000,0000,,Тыңдап тұрсың ба! ? Луффи!
Dialogue: 0,0:27:22.07,0:27:23.74,Default,,0000,0000,0000,,Хаха.
Dialogue: 0,0:27:23.74,0:27:26.08,Default,,0000,0000,0000,,Юта
Dialogue: 0,0:27:23.74,0:27:26.08,Default,,0000,0000,0000,,Мен сізбен ұзақ уақыттан кейін танысқаныма қуаныштымын!
Dialogue: 0,0:27:26.08,0:27:29.08,Default,,0000,0000,0000,,Мен де ет жедім.
Dialogue: 0,0:27:26.08,0:27:29.08,Default,,0000,0000,0000,,Күншуаққа қайтып, ұйықтаймын.
Dialogue: 0,0:27:29.08,0:27:31.42,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:27:29.08,0:27:31.42,Default,,0000,0000,0000,,Сіз де жасай аласыз➡
Dialogue: 0,0:27:31.42,0:27:32.98,Default,,0000,0000,0000,,Мұны істеп жатқаныңызды көру өте жақсы!
Dialogue: 0,0:27:31.42,0:27:32.98,Default,,0000,0000,0000,,Мен... Мен ондай жігіттерді шын жек көремін!
Dialogue: 0,0:27:37.06,0:27:39.06,Default,,0000,0000,0000,,Мен сені үйге жібермеймін.
Dialogue: 0,0:27:37.06,0:27:39.06,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:27:39.06,0:27:42.06,Default,,0000,0000,0000,,Луффи және сендер
Dialogue: 0,0:27:39.06,0:27:42.06,Default,,0000,0000,0000,,Мұнда мәңгі және мәңгі➡
Dialogue: 0,0:27:42.06,0:27:44.06,Default,,0000,0000,0000,,Менімен бақытты өмір сүр.
Dialogue: 0,0:27:44.06,0:27:46.06,Default,,0000,0000,0000,,Сіз не айттыңыз? сен.
Dialogue: 0,0:27:46.06,0:27:50.00,Default,,0000,0000,0000,,Ута Маған сіздің әніңіз ұнайды.
Dialogue: 0,0:27:46.06,0:27:50.00,Default,,0000,0000,0000,,Күткендей көп уақыт өтті...
Dialogue: 0,0:27:50.00,0:27:52.00,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:27:50.00,0:27:52.00,Default,,0000,0000,0000,,Нами-сан!
Dialogue: 0,0:27:52.00,0:27:56.01,Default,,0000,0000,0000,,Барлығына!
Dialogue: 0,0:27:52.00,0:27:56.01,Default,,0000,0000,0000,,Мен тағы бір қарақшы таптым!
Dialogue: 0,0:27:56.01,0:27:58.01,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:27:58.01,0:28:00.01,Default,,0000,0000,0000,,Уф... уф. ➡
Dialogue: 0,0:28:00.01,0:28:04.02,Default,,0000,0000,0000,,UTA!
Dialogue: 0,0:28:00.01,0:28:04.02,Default,,0000,0000,0000,,UTA! UTA! ➡
Dialogue: 0,0:28:04.02,0:28:08.02,Default,,0000,0000,0000,,UTA! UTA! UTA!
Dialogue: 0,0:28:08.02,0:28:10.02,Default,,0000,0000,0000,,Жарайды! ➡
Dialogue: 0,0:28:10.02,0:28:14.03,Default,,0000,0000,0000,,Олай болса, бәріміз үшін И
Dialogue: 0,0:28:10.02,0:28:14.03,Default,,0000,0000,0000,,Біз қарақшыларды жеңеміз!
Dialogue: 0,0:28:14.03,0:28:18.03,Default,,0000,0000,0000,,♬ (музыкалық аспаптарда ойнау)
Dialogue: 0,0:28:18.03,0:28:25.04,Default,,0000,0000,0000,,(қол шапалақтау)
Dialogue: 0,0:28:25.04,0:28:28.04,Default,,0000,0000,0000,,Қанша
Dialogue: 0,0:28:25.04,0:28:28.04,Default,,0000,0000,0000,,Өйткені ол Луффидің бала кезден досы➡
Dialogue: 0,0:28:28.04,0:28:30.04,Default,,0000,0000,0000,,Бұл тым көп еркіндік беріп жатқан жоқ па?
Dialogue: 0,0:28:30.04,0:28:31.71,Default,,0000,0000,0000,,(қол шапалақтау)
Dialogue: 0,0:28:31.71,0:28:33.71,Default,,0000,0000,0000,,Жасау~.
Dialogue: 0,0:28:33.71,0:28:35.38,Default,,0000,0000,0000,,Не! ? Бұл жігіттер! ➡
Dialogue: 0,0:28:35.38,0:28:38.05,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:28:35.38,0:28:38.05,Default,,0000,0000,0000,,Саны өсіп келеді!
Dialogue: 0,0:28:38.05,0:28:41.02,Default,,0000,0000,0000,,Караксагава Сейкен
Dialogue: 0,0:28:38.05,0:28:41.02,Default,,0000,0000,0000,,Арабеск плиткасы оң жұдырық!
Dialogue: 0,0:28:43.05,0:28:45.06,Default,,0000,0000,0000,,Орындау~.
Dialogue: 0,0:28:45.06,0:28:48.06,Default,,0000,0000,0000,,Саусақ шығарыңыз!
Dialogue: 0,0:28:48.06,0:28:49.99,Default,,0000,0000,0000,,Луффи.
Dialogue: 0,0:28:49.99,0:28:53.00,Default,,0000,0000,0000,,Өйткені сен қарақшымын дейсің.
Dialogue: 0,0:28:49.99,0:28:53.00,Default,,0000,0000,0000,,Сіз алмайсыз.
Dialogue: 0,0:28:53.00,0:28:56.00,Default,,0000,0000,0000,,Егер сен менің досым болсаң
Dialogue: 0,0:28:53.00,0:28:56.00,Default,,0000,0000,0000,,Қарақшылар бас тартуы керек.
Dialogue: 0,0:28:56.00,0:28:58.00,Default,,0000,0000,0000,,Сіз не айтып тұрсыз?
Dialogue: 0,0:28:58.00,0:29:03.01,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:28:58.00,0:29:03.01,Default,,0000,0000,0000,,Өйткені, мен бас тарттым. Мінбе.
Dialogue: 0,0:29:03.01,0:29:05.01,Default,,0000,0000,0000,,Ұрысуға себеп жоқ.
Dialogue: 0,0:29:05.01,0:29:09.01,Default,,0000,0000,0000,,Сіз мұны жасамасаңыз да
Dialogue: 0,0:29:05.01,0:29:09.01,Default,,0000,0000,0000,,Мен мұны істеймін!
Dialogue: 0,0:29:09.01,0:29:15.02,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:29:15.02,0:29:17.02,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:29:15.02,0:29:17.02,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:29:17.02,0:29:26.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:29:26.03,0:29:29.03,Default,,0000,0000,0000,,Сейсфлер
Dialogue: 0,0:29:26.03,0:29:29.03,Default,,0000,0000,0000,,Алты гүлді шапалақ!
Dialogue: 0,0:29:29.03,0:29:33.04,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:29:33.04,0:29:37.04,Default,,0000,0000,0000,,Ойнауды доғар, Ута!
Dialogue: 0,0:29:37.04,0:29:43.05,Default,,0000,0000,0000,,♬ «Шашыраңқы естеліктер
Dialogue: 0,0:29:37.04,0:29:43.05,Default,,0000,0000,0000,,Уга
Dialogue: 0,0:29:37.04,0:29:43.05,Default,,0000,0000,0000,,Мұңды тесіп өтетіні сонша».
Dialogue: 0,0:29:43.05,0:29:48.05,Default,,0000,0000,0000,,♬ «Төзгісіз өшпенділік
Dialogue: 0,0:29:43.05,0:29:48.05,Default,,0000,0000,0000,,Ол үшін»➡
Dialogue: 0,0:29:48.05,0:29:49.99,Default,,0000,0000,0000,,♬ «Мен оны артта қалдырдым» ➡
Dialogue: 0,0:29:49.99,0:29:52.99,Default,,0000,0000,0000,,♬ «Сіз түсінбейсіз.
Dialogue: 0,0:29:49.99,0:29:52.99,Default,,0000,0000,0000,,Жалғыздық шынымен ауыртады»➡
Dialogue: 0,0:29:52.99,0:29:55.99,Default,,0000,0000,0000,,Құрсау
Dialogue: 0,0:29:52.99,0:29:55.99,Default,,0000,0000,0000,,♬ «Әзірше оны шығарып алыңыз.»
Dialogue: 0,0:29:55.99,0:30:00.67,Default,,0000,0000,0000,,♬ «Қазір ашулан
Dialogue: 0,0:29:55.99,0:30:00.67,Default,,0000,0000,0000,,Зұлымдықты нокаутқа түсіріңіз».
Dialogue: 0,0:30:00.67,0:30:03.00,Default,,0000,0000,0000,,♬ «Бұл сүйіспеншілікке толы жаза». ➡
Dialogue: 0,0:30:03.00,0:30:06.00,Default,,0000,0000,0000,,♬ «Мен енді ұйықтамаймын.
Dialogue: 0,0:30:03.00,0:30:06.00,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ»➡
Dialogue: 0,0:30:06.00,0:30:09.01,Default,,0000,0000,0000,,♬ «Мен енді мұңаймаймын
Dialogue: 0,0:30:06.00,0:30:09.01,Default,,0000,0000,0000,,No.»
Dialogue: 0,0:30:09.01,0:30:14.01,Default,,0000,0000,0000,,♬ «Иә, қазір ашу.
Dialogue: 0,0:30:09.01,0:30:14.01,Default,,0000,0000,0000,,Зұлымдықты қуып жіберіңіз».
Dialogue: 0,0:30:14.01,0:30:16.01,Default,,0000,0000,0000,,♬ «Махаббаттың жазасы осы».
Dialogue: 0,0:30:16.01,0:30:19.02,Default,,0000,0000,0000,,♬ «Мен енді ұйықтамаймын.
Dialogue: 0,0:30:16.01,0:30:19.02,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ»➡
Dialogue: 0,0:30:19.02,0:30:22.02,Default,,0000,0000,0000,,♬ «Мен енді жалғыз емеспін
Dialogue: 0,0:30:19.02,0:30:22.02,Default,,0000,0000,0000,,Жоқ”➡
Dialogue: 0,0:30:22.02,0:30:29.03,Default,,0000,0000,0000,,♬ "Артқы жарық"
Dialogue: 0,0:30:29.03,0:30:37.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:30:39.04,0:30:42.04,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? Жіберу!
Dialogue: 0,0:30:42.04,0:30:46.04,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:30:42.04,0:30:46.04,Default,,0000,0000,0000,,Луффи қарақшылар патшасы болады.
Dialogue: 0,0:30:46.04,0:30:48.05,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:30:48.05,0:30:50.98,Default,,0000,0000,0000,,
Dialogue: 0,0:30:48.05,0:30:50.98,Default,,0000,0000,0000,,Қарақшылар туралы не ойлайсыңдар?
Dialogue: 0,0:30:50.98,0:30:53.99,Default,,0000,0000,0000,,Менің қаламды қарақшылар өртеп жіберді!
Dialogue: 0,0:30:53.99,0:30:56.99,Default,,0000,0000,0000,,(әйел)
Dialogue: 0,0:30:53.99,0:30:56.99,Default,,0000,0000,0000,,Менің күйеуімді қарақшылар өлтірді!
Dialogue: 0,0:30:56.99,0:30:58.99,Default,,0000,0000,0000,,Анамды қайтар!
Dialogue: 0,0:30:58.99,0:31:01.99,Default,,0000,0000,0000,,Бізге қарақшылар керек емес!
Dialogue: 0,0:30:58.99,0:31:01.99,Default,,0000,0000,0000,,Қарақшылар, қуып жіберіңіздер! ➡
Dialogue: 0,0:31:01.99,0:31:04.00,Default,,0000,0000,0000,,Бізге қарақшылар керек емес!
Dialogue: 0,0:31:01.99,0:31:04.00,Default,,0000,0000,0000,,Қарақшылар, қуып жіберіңіздер!
Dialogue: 0,0:31:04.00,0:31:08.00,Default,,0000,0000,0000,,Юта ханшайымы!
Dialogue: 0,0:31:04.00,0:31:08.00,Default,,0000,0000,0000,,Луффи мұны жасамас еді!
Dialogue: 0,0:31:08.00,0:31:11.00,Default,,0000,0000,0000,,Ута! Менің достарым...
Dialogue: 0,0:31:11.00,0:31:13.00,Default,,0000,0000,0000,,Пуруру…. Аа….
Dialogue: 0,0:31:13.00,0:31:15.67,Default,,0000,0000,0000,,Ута-чанға жақындама, қарақшы!
Dialogue: 0,0:31:15.67,0:31:17.34,Default,,0000,0000,0000,,А... аа....
Dialogue: 0,0:31:17.34,0:31:20.68,Default,,0000,0000,0000,,Теңіз суында әлсіремейтін қабілеті бар адамдар бар.
Dialogue: 0,0:31:17.34,0:31:20.68,Default,,0000,0000,0000,,Қорықпа.
Dialogue: 0,0:31:20.68,0:31:22.35,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:31:22.35,0:31:24.02,Default,,0000,0000,0000,,Енді жоқ!
Dialogue: 0,0:31:22.35,0:31:24.02,Default,,0000,0000,0000,,Күте тұрыңыз.
Dialogue: 0,0:31:24.02,0:31:28.02,Default,,0000,0000,0000,,Мұнда бәрі жақсы.
Dialogue: 0,0:31:24.02,0:31:28.02,Default,,0000,0000,0000,,Келесі реттеулерді жасайық.
Dialogue: 0,0:31:28.02,0:31:30.02,Default,,0000,0000,0000,,Кедергі доп!
Dialogue: 0,0:31:30.02,0:31:32.02,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:31:32.02,0:31:34.03,Default,,0000,0000,0000,,О.
Dialogue: 0,0:31:32.02,0:31:34.03,Default,,0000,0000,0000,,Мына... Lome man?
Dialogue: 0,0:31:34.03,0:31:37.03,Default,,0000,0000,0000,,Луффи-сенпай
Dialogue: 0,0:31:34.03,0:31:37.03,Default,,0000,0000,0000,,Ута-сама - ақылсыз нәрсе. ➡
Dialogue: 0,0:31:37.03,0:31:39.03,Default,,0000,0000,0000,,Мен жеңе алатынымды сезбеймін.
Dialogue: 0,0:31:39.03,0:31:41.03,Default,,0000,0000,0000,,Мен... мен жеңілмеймін...
Dialogue: 0,0:31:41.03,0:31:44.04,Default,,0000,0000,0000,,Бұл шықты! Мен жеңілгеніме өкінемін.
Dialogue: 0,0:31:44.04,0:31:46.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:31:48.04,0:31:52.98,Default,,0000,0000,0000,,
Dialogue: 0,0:31:52.98,0:31:55.95,Default,,0000,0000,0000,,Ол жерде басқа қарақшылар жасырынған ба?
Dialogue: 0,0:32:00.99,0:32:03.99,Default,,0000,0000,0000,,
Dialogue: 0,0:32:00.99,0:32:03.99,Default,,0000,0000,0000,,Бұл не? Бұл қайда? ➡
Dialogue: 0,0:32:03.99,0:32:07.99,Default,,0000,0000,0000,,Иә? Ааа….
Dialogue: 0,0:32:07.99,0:32:09.99,Default,,0000,0000,0000,,Құрметті Ута-сама
Dialogue: 0,0:32:07.99,0:32:09.99,Default,,0000,0000,0000,,Сіз жанкүйер болдыңыз ба➡
Dialogue: 0,0:32:09.99,0:32:12.00,Default,,0000,0000,0000,,Трафальгар.
Dialogue: 0,0:32:12.00,0:32:14.00,Default,,0000,0000,0000,,Жоқ. Біз кездесіп жатырмыз...
Бепоның
Dialogue: 0,0:32:14.00,0:32:18.00,Default,,0000,0000,0000,,🔊♬ (музыка)
Dialogue: 0,0:32:18.00,0:32:20.00,Default,,0000,0000,0000,,.
Dialogue: 0,0:32:18.00,0:32:20.00,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:32:20.00,0:32:23.01,Default,,0000,0000,0000,,О.
Dialogue: 0,0:32:20.00,0:32:23.01,Default,,0000,0000,0000,,Жолбарыс адам Рахмет. Хехехе.
Dialogue: 0,0:32:23.01,0:32:25.01,Default,,0000,0000,0000,,Бидай
Dialogue: 0,0:32:23.01,0:32:25.01,Default,,0000,0000,0000,,Күлген кезде ме? Мугиварая.
Dialogue: 0,0:32:25.01,0:32:28.01,Default,,0000,0000,0000,,Сол әйелдің қабілеті
Dialogue: 0,0:32:25.01,0:32:28.01,Default,,0000,0000,0000,,Егер біз оны анықтамайынша...
Dialogue: 0,0:32:28.01,0:32:33.02,Default,,0000,0000,0000,,Буруруру...!
Dialogue: 0,0:32:28.01,0:32:33.02,Default,,0000,0000,0000,,Маған қалдырыңыз! Ол Ютаға қарсы 184 рет жеңіске жетті!
Dialogue: 0,0:32:33.02,0:32:36.02,Default,,0000,0000,0000,,🎤О, болды! менде сен барсың!
Dialogue: 0,0:32:36.02,0:32:38.02,Default,,0000,0000,0000,,Луффи-сенпай~!
Dialogue: 0,0:32:36.02,0:32:38.02,Default,,0000,0000,0000,,Ута-чан!
Dialogue: 0,0:32:38.02,0:32:40.02,Default,,0000,0000,0000,,Тартайық!
Dialogue: 0,0:32:38.02,0:32:40.02,Default,,0000,0000,0000,,🎤Қарақшылар қашып кетті! ➡
Dialogue: 0,0:32:40.02,0:32:44.03,Default,,0000,0000,0000,,Келіңіздер, бәріңіз
Dialogue: 0,0:32:40.02,0:32:44.03,Default,,0000,0000,0000,,Қарақшыларды аулауға барайық!
Dialogue: 0,0:32:44.03,0:32:48.97,Default,,0000,0000,0000,,🔊♬ (музыка)
Dialogue: 0,0:32:48.97,0:33:07.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:33:07.99,0:33:11.99,Default,,0000,0000,0000,,Қылыш
Dialogue: 0,0:33:07.99,0:33:11.99,Default,,0000,0000,0000,,ҚЫЛЫШ Денден Муши жауап бермейді.
Dialogue: 0,0:33:07.99,0:33:11.99,Default,,0000,0000,0000,,Бұл жаман.
Dialogue: 0,0:33:11.99,0:33:14.99,Default,,0000,0000,0000,,Юта ауыр
Dialogue: 0,0:33:11.99,0:33:14.99,Default,,0000,0000,0000,,Сіз бұл жоспарды жүзеге асыруды жоспарлап отырсыз ба?
Dialogue: 0,0:33:14.99,0:33:19.00,Default,,0000,0000,0000,,О... ҚЫЛЫШ та
Dialogue: 0,0:33:14.99,0:33:19.00,Default,,0000,0000,0000,,Сіз Ютаны бақылап отырдыңыз ба?
Dialogue: 0,0:33:19.00,0:33:22.00,Default,,0000,0000,0000,,Шифр ​​Пол, солай ма?
Dialogue: 0,0:33:19.00,0:33:22.00,Default,,0000,0000,0000,,«Міне, менің электрондық поштамның мекенжайы.»
Dialogue: 0,0:33:22.00,0:33:26.00,Default,,0000,0000,0000,,Енді бұл шымтезек соғысы
Dialogue: 0,0:33:22.00,0:33:26.00,Default,,0000,0000,0000,,Бұлай жасайтын уақыт емес.
Dialogue: 0,0:33:26.00,0:33:28.01,Default,,0000,0000,0000,,Door Door мүмкіндігін пайдалана аламын ба?
Dialogue: 0,0:33:28.01,0:33:32.01,Default,,0000,0000,0000,,Сіз тым көп білмейсіз бе?
Dialogue: 0,0:33:28.01,0:33:32.01,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:33:32.01,0:33:37.02,Default,,0000,0000,0000,,Сіз оны пайдалана аласыз, бірақ мұнда емес.
Dialogue: 0,0:33:32.01,0:33:37.02,Default,,0000,0000,0000,,Менің физикалық күшім тым көп жұмсалуда.
Dialogue: 0,0:33:37.02,0:33:39.02,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:33:37.02,0:33:39.02,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:33:39.02,0:33:42.02,Default,,0000,0000,0000,,тым кеш болады.
Dialogue: 0,0:33:42.02,0:33:46.02,Default,,0000,0000,0000,,Күштерді жинаңыз.
Dialogue: 0,0:33:42.02,0:33:46.02,Default,,0000,0000,0000,,Әзірше менде осы ғана...
Dialogue: 0,0:33:46.02,0:33:50.03,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:33:46.02,0:33:50.03,Default,,0000,0000,0000,,Олар ұсталды.
Dialogue: 0,0:33:50.03,0:33:54.03,Default,,0000,0000,0000,,Ол жай ғана сызыққа бекітілген сияқты.
Dialogue: 0,0:33:50.03,0:33:54.03,Default,,0000,0000,0000,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:33:54.03,0:33:58.04,Default,,0000,0000,0000,,Мен Люффи-сенпайды ешқашан күткен емеспін.
Dialogue: 0,0:33:54.03,0:33:58.04,Default,,0000,0000,0000,,Мен оны алып жүруге рұқсат етілгеніне сене алмаймын➡
Dialogue: 0,0:33:58.04,0:34:00.37,Default,,0000,0000,0000,,Көңілім толқығаным сонша, алда не күтіп тұрғанын көре алмаймын!
Dialogue: 0,0:34:00.37,0:34:02.04,Default,,0000,0000,0000,,Бұл!
Dialogue: 0,0:34:00.37,0:34:02.04,Default,,0000,0000,0000,,Бидай
Dialogue: 0,0:34:00.37,0:34:02.04,Default,,0000,0000,0000,,Мугивара!
Dialogue: 0,0:34:02.04,0:34:04.04,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:34:04.04,0:34:06.04,Default,,0000,0000,0000,,Ой... Бол! Бол-бол-бол….
Dialogue: 0,0:34:06.04,0:34:08.01,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? Тез қашайық!
Dialogue: 0,0:34:24.00,0:34:36.01,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:34:36.01,0:34:40.01,Default,,0000,0000,0000,,Уау. Ол бір нәрсеге толы!
Dialogue: 0,0:34:40.01,0:34:42.01,Default,,0000,0000,0000,,
Dialogue: 0,0:34:40.01,0:34:42.01,Default,,0000,0000,0000,,Бұлай жалғаса берсе, бізді қоршап алады.
Dialogue: 0,0:34:42.01,0:34:43.98,Default,,0000,0000,0000,,⚟(Гордон) Жігіттер.
Dialogue: 0,0:34:53.02,0:34:55.03,Default,,0000,0000,0000,,Phew~ Көмегіңе рахмет.
Dialogue: 0,0:34:55.03,0:34:58.03,Default,,0000,0000,0000,,Луффи-кун.
Dialogue: 0,0:34:55.03,0:34:58.03,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:34:58.03,0:34:59.70,Default,,0000,0000,0000,,Сіз...
Dialogue: 0,0:34:58.03,0:34:59.70,Default,,0000,0000,0000,,Қария кім?
Dialogue: 0,0:34:59.70,0:35:01.37,Default,,0000,0000,0000,,Ой.
Dialogue: 0,0:35:01.37,0:35:05.04,Default,,0000,0000,0000,,Мен бір рет
Dialogue: 0,0:35:01.37,0:35:05.04,Default,,0000,0000,0000,,Бұл ел Елегияны биледі➡
Dialogue: 0,0:35:05.04,0:35:07.04,Default,,0000,0000,0000,,Оның аты Гордон.
Dialogue: 0,0:35:07.04,0:35:10.04,Default,,0000,0000,0000,,Ел дегеніміз...
Dialogue: 0,0:35:07.04,0:35:10.04,Default,,0000,0000,0000,,Бұл аралда ғимараттар бар, бірақ➡
Dialogue: 0,0:35:10.04,0:35:12.04,Default,,0000,0000,0000,,Бір ғана бала қалды.
Dialogue: 0,0:35:12.04,0:35:14.05,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:35:12.04,0:35:14.05,Default,,0000,0000,0000,,Бір кездері Элегия➡ болған
Dialogue: 0,0:35:14.05,0:35:17.05,Default,,0000,0000,0000,,Әлемдегі нөмірі бірінші музыка астанасы ретінде
Dialogue: 0,0:35:14.05,0:35:17.05,Default,,0000,0000,0000,,Өркендеу керек еді. ➡
Dialogue: 0,0:35:17.05,0:35:19.98,Default,,0000,0000,0000,,Бір күн, түнде
Dialogue: 0,0:35:17.05,0:35:19.98,Default,,0000,0000,0000,,Бәрі жойылғанша.
Dialogue: 0,0:35:19.98,0:35:21.99,Default,,0000,0000,0000,,Бір түнде ел ғайып болды...
Dialogue: 0,0:35:21.99,0:35:25.96,Default,,0000,0000,0000,,Белгілі бір үлкен қарақшыға
Dialogue: 0,0:35:21.99,0:35:25.96,Default,,0000,0000,0000,,Оған шабуыл жасалды деген қауесеттер бар...
Dialogue: 0,0:35:33.00,0:35:35.00,Default,,0000,0000,0000,,Юта туралы сөйлесейік. ➡
Dialogue: 0,0:35:35.00,0:35:40.00,Default,,0000,0000,0000,,Адамдар кеткен Элегияда
Dialogue: 0,0:35:35.00,0:35:40.00,Default,,0000,0000,0000,,Мен Ютаны өсірдім.
Dialogue: 0,0:35:40.00,0:35:42.01,Default,,0000,0000,0000,,Қария! ?
Dialogue: 0,0:35:42.01,0:35:47.01,Default,,0000,0000,0000,,Бірақ біз мұндамыз
Dialogue: 0,0:35:42.01,0:35:47.01,Default,,0000,0000,0000,,Тек мен және сол қыз. ➡
Dialogue: 0,0:35:47.01,0:35:49.01,Default,,0000,0000,0000,,Ол жалғыз болған болуы керек. ➡
Dialogue: 0,0:35:49.01,0:35:51.68,Default,,0000,0000,0000,,Менің алдымда
Dialogue: 0,0:35:49.01,0:35:51.68,Default,,0000,0000,0000,,Ол батыл әрекет етті, бірақ➡
Dialogue: 0,0:35:51.68,0:35:53.35,Default,,0000,0000,0000,,Жалғыз қалғанда➡
Dialogue: 0,0:35:53.35,0:35:58.02,Default,,0000,0000,0000,,Әрқашан достарымен естелік әндерді айту
Dialogue: 0,0:35:53.35,0:35:58.02,Default,,0000,0000,0000,,Ол ызылдады.
Dialogue: 0,0:35:58.02,0:36:10.03,Default,,0000,0000,0000,,♬ «Неге?
Dialogue: 0,0:35:58.02,0:36:10.03,Default,,0000,0000,0000,,Сол күні біз ойнаған теңіздің иісі»➡
Dialogue: 0,0:36:10.03,0:36:21.98,Default,,0000,0000,0000,,♬ «Неге?
Dialogue: 0,0:36:10.03,0:36:21.98,Default,,0000,0000,0000,,Маусым өткенде жоғалады»➡
Dialogue: 0,0:36:21.98,0:36:27.99,Default,,0000,0000,0000,,♬ «Бір әнді қайта айтқан сайын» ➡
Dialogue: 0,0:36:27.99,0:36:33.99,Default,,0000,0000,0000,,♬ «Мен сені шақырамын».
Dialogue: 0,0:36:33.99,0:36:38.00,Default,,0000,0000,0000,,(Гордон)
Dialogue: 0,0:36:33.99,0:36:38.00,Default,,0000,0000,0000,,Ондай адамдарды жігерлендіремін➡
Dialogue: 0,0:36:38.00,0:36:41.97,Default,,0000,0000,0000,,Оны әлемдегі ең жақсы әнші ету
Dialogue: 0,0:36:38.00,0:36:41.97,Default,,0000,0000,0000,,Мен оны көтердім.
Dialogue: 0,0:36:45.00,0:36:47.00,Default,,0000,0000,0000,,Ум! Сіз тыңдайсыз ба? ?
Dialogue: 0,0:36:47.00,0:36:49.01,Default,,0000,0000,0000,,Жарайды, әрі қарай жүрейік.
Dialogue: 0,0:36:49.01,0:36:52.68,Default,,0000,0000,0000,,🔊♬ (музыка)
Dialogue: 0,0:36:49.01,0:36:52.68,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:36:52.68,0:36:54.35,Default,,0000,0000,0000,,Цк.
Dialogue: 0,0:36:52.68,0:36:54.35,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:36:54.35,0:36:56.01,Default,,0000,0000,0000,,Қалай болғанда да, Ута-сама➡
Dialogue: 0,0:36:56.01,0:36:59.02,Default,,0000,0000,0000,,Сіз қазіргі Луффи-сенпайды білмейсіз.
Dialogue: 0,0:36:56.01,0:36:59.02,Default,,0000,0000,0000,,Бұл рас сияқты.
Dialogue: 0,0:36:59.02,0:37:02.99,Default,,0000,0000,0000,,🔊♬ (музыка)
Dialogue: 0,0:36:59.02,0:37:02.99,Default,,0000,0000,0000,,Уау, аа... Кешіріңіз...
Dialogue: 0,0:37:05.02,0:37:07.69,Default,,0000,0000,0000,,Сұрақ қашан және қалай➡
Dialogue: 0,0:37:07.69,0:37:12.03,Default,,0000,0000,0000,,Оның тамаша әні
Dialogue: 0,0:37:07.69,0:37:12.03,Default,,0000,0000,0000,,Мен оны әлемге жеткізгім келді. ➡
Dialogue: 0,0:37:12.03,0:37:16.03,Default,,0000,0000,0000,,Ол сыртқы әлемді көреді
Dialogue: 0,0:37:12.03,0:37:16.03,Default,,0000,0000,0000,,Себебі мен бұл туралы көп білмей өстім... ➡
Dialogue: 0,0:37:16.03,0:37:22.01,Default,,0000,0000,0000,,Бірақ уақыт
Dialogue: 0,0:37:16.03,0:37:22.01,Default,,0000,0000,0000,,Бұл күтпеген жерден келді.
Dialogue: 0,0:37:24.98,0:37:28.98,Default,,0000,0000,0000,,Шамамен 2 жыл бұрын
Dialogue: 0,0:37:24.98,0:37:28.98,Default,,0000,0000,0000,,Ол оны кездейсоқ көтеріп алды. ➡
Dialogue: 0,0:37:28.98,0:37:33.99,Default,,0000,0000,0000,,Эйдоден жәндіктерінің жаңа түрі шайып кетті. ➡
Dialogue: 0,0:37:33.99,0:37:36.99,Default,,0000,0000,0000,,Юта бостандыққа шыққандай➡
Dialogue: 0,0:37:36.99,0:37:40.99,Default,,0000,0000,0000,,Ән айтып жатқан дауысыңызды сыртқа бұрыңыз
Dialogue: 0,0:37:36.99,0:37:40.99,Default,,0000,0000,0000,,Енді жібереді. ➡
Dialogue: 0,0:37:40.99,0:37:44.00,Default,,0000,0000,0000,,Оның дауысы жанкүйерлерді баурап алады➡
Dialogue: 0,0:37:44.00,0:37:50.00,Default,,0000,0000,0000,,Дүниені қамтығандай
Dialogue: 0,0:37:44.00,0:37:50.00,Default,,0000,0000,0000,,Ол тез тарады.
Dialogue: 0,0:37:50.00,0:37:52.00,Default,,0000,0000,0000,,🔊 (Ер адам) Ута! рақмет сізге!
Dialogue: 0,0:37:52.00,0:37:54.01,Default,,0000,0000,0000,,🔊Мен өзімді жақсы сезінемін!
Dialogue: 0,0:37:52.00,0:37:54.01,Default,,0000,0000,0000,,🔊(Ер) Утаға рахмет➡
Dialogue: 0,0:37:54.01,0:37:58.01,Default,,0000,0000,0000,,Ертең де
Dialogue: 0,0:37:54.01,0:37:58.01,Default,,0000,0000,0000,,Сіз аман қала алатын сияқтысыз.
Dialogue: 0,0:37:58.01,0:38:01.98,Default,,0000,0000,0000,,Мен де! Мен де, бәрі
Dialogue: 0,0:37:58.01,0:38:01.98,Default,,0000,0000,0000,,Сізге ұнағанына қуаныштымын.
Dialogue: 0,0:38:04.02,0:38:09.02,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:38:04.02,0:38:09.02,Default,,0000,0000,0000,,Сыртқы дүниенің шындығы туралы білетініміздей➡
Dialogue: 0,0:38:09.02,0:38:13.02,Default,,0000,0000,0000,,Оның ішінде
Dialogue: 0,0:38:09.02,0:38:13.02,Default,,0000,0000,0000,,Жаңа сана пайда бола бастады. ➡
Dialogue: 0,0:38:13.02,0:38:18.03,Default,,0000,0000,0000,,Ұлы қарақшылар дәуірі
Dialogue: 0,0:38:13.02,0:38:18.03,Default,,0000,0000,0000,,Соғыс пен қан ешқашан бітпейді. ➡
Dialogue: 0,0:38:18.03,0:38:21.97,Default,,0000,0000,0000,,Бастапқыда ән
Dialogue: 0,0:38:18.03,0:38:21.97,Default,,0000,0000,0000,,Бұл тыңдауға арналды➡
Dialogue: 0,0:38:21.97,0:38:23.97,Default,,0000,0000,0000,,Мен білмей тұрып, мен Ута➡ туралы ойладым
Dialogue: 0,0:38:23.97,0:38:27.97,Default,,0000,0000,0000,,Жанкүйерлер оған құтқарушы ретінде табынады
Dialogue: 0,0:38:23.97,0:38:27.97,Default,,0000,0000,0000,,ұлғайтылған. ➡
Dialogue: 0,0:38:27.97,0:38:29.97,Default,,0000,0000,0000,,Сондықтан Uta...
Dialogue: 0,0:38:29.97,0:38:32.98,Default,,0000,0000,0000,,🔊Әр адамның сезімі
Dialogue: 0,0:38:29.97,0:38:32.98,Default,,0000,0000,0000,,Мен түсіндім. ➡
Dialogue: 0,0:38:32.98,0:38:35.98,Default,,0000,0000,0000,,Егер мен керек болсам, мен саған жасап беремін.
Dialogue: 0,0:38:32.98,0:38:35.98,Default,,0000,0000,0000,,Жаңа дәуір.
Dialogue: 0,0:38:35.98,0:38:39.98,Default,,0000,0000,0000,,Өтінемін!
Dialogue: 0,0:38:35.98,0:38:39.98,Default,,0000,0000,0000,,Ютаның жоспарын тоқтатыңыз! ➡
Dialogue: 0,0:38:39.98,0:38:42.99,Default,,0000,0000,0000,,Ютаның досы болған Луффи
Dialogue: 0,0:38:39.98,0:38:42.99,Default,,0000,0000,0000,,Мүмкін болуы керек.
Dialogue: 0,0:38:42.99,0:38:44.99,Default,,0000,0000,0000,,Жоспар дегеніміз не?
Dialogue: 0,0:38:42.99,0:38:44.99,Default,,0000,0000,0000,,Сіз осы тікелей шоу туралы айтып отырсыз ба?
Dialogue: 0,0:38:44.99,0:38:46.99,Default,,0000,0000,0000,,🔊♬ (музыка)
Dialogue: 0,0:38:44.99,0:38:46.99,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:38:46.99,0:38:48.99,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:38:48.99,0:38:50.96,Default,,0000,0000,0000,,Bepo!
Dialogue: 0,0:38:53.00,0:38:55.00,Default,,0000,0000,0000,,Ачо~!
Dialogue: 0,0:38:55.00,0:38:57.00,Default,,0000,0000,0000,,Bepo~!
Dialogue: 0,0:38:55.00,0:38:57.00,Default,,0000,0000,0000,,Аю!
Dialogue: 0,0:38:57.00,0:38:58.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:39:01.01,0:39:03.01,Default,,0000,0000,0000,,Юта….
Dialogue: 0,0:39:03.01,0:39:06.01,Default,,0000,0000,0000,,Гордон
Dialogue: 0,0:39:03.01,0:39:06.01,Default,,0000,0000,0000,,Неліктен қарақшылармен біргесің?
Dialogue: 0,0:39:06.01,0:39:08.01,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:39:06.01,0:39:08.01,Default,,0000,0000,0000,,Юта.
Dialogue: 0,0:39:08.01,0:39:11.02,Default,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:39:08.01,0:39:11.02,Default,,0000,0000,0000,,Шенкстің кемесі түсті ме?
Dialogue: 0,0:39:11.02,0:39:15.02,Default,,0000,0000,0000,,Қызыл шашты қарақшылардың музыканттары кімдер?
Dialogue: 0,0:39:11.02,0:39:15.02,Default,,0000,0000,0000,,Мен осылай дедім➡
Dialogue: 0,0:39:15.02,0:39:17.02,Default,,0000,0000,0000,,Сізге қайту керек.
Dialogue: 0,0:39:15.02,0:39:17.02,Default,,0000,0000,0000,,Шенкстің орнында.
Dialogue: 0,0:39:17.02,0:39:20.96,Default,,0000,0000,0000,,Шулы….
Dialogue: 0,0:39:17.02,0:39:20.96,Default,,0000,0000,0000,,Енді Шенкс➡ туралы
Dialogue: 0,0:39:20.96,0:39:23.96,Default,,0000,0000,0000,,Тоқта! !
Dialogue: 0,0:39:23.96,0:39:25.93,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:39:28.97,0:39:30.97,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:39:30.97,0:39:32.97,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:39:32.97,0:39:34.97,Default,,0000,0000,0000,,Эй, Луффи➡
Dialogue: 0,0:39:34.97,0:39:38.98,Default,,0000,0000,0000,,One Piece, Pirate King және т.б.
Dialogue: 0,0:39:34.97,0:39:38.98,Default,,0000,0000,0000,,Шенкс қалпағы➡
Dialogue: 0,0:39:38.98,0:39:42.98,Default,,0000,0000,0000,,Барлық пайдасыз заттарды тастаңыз
Dialogue: 0,0:39:38.98,0:39:42.98,Default,,0000,0000,0000,,Менімен бірге бақытты өмір сүрейік.
Dialogue: 0,0:39:42.98,0:39:44.98,Default,,0000,0000,0000,,Сәлем! Бұл тым күлкілі!
Dialogue: 0,0:39:44.98,0:39:48.99,Default,,0000,0000,0000,,Дәмді нәрсе жеңіз
Dialogue: 0,0:39:44.98,0:39:48.99,Default,,0000,0000,0000,,Тауық жарысын және қол күресін жасаңыз➡
Dialogue: 0,0:39:48.99,0:39:51.99,Default,,0000,0000,0000,,Бұрынғыдай күліп, уақыт өткізейік.
Dialogue: 0,0:39:51.99,0:39:55.99,Default,,0000,0000,0000,,Маған қалпақты қайтарыңыз! Shanks қалпағы!
Dialogue: 0,0:39:55.99,0:40:01.00,Default,,0000,0000,0000,,​​Түсіндім.
Dialogue: 0,0:39:55.99,0:40:01.00,Default,,0000,0000,0000,,Луффи, сен жаңа дәуірдесің➡
Dialogue: 0,0:40:01.00,0:40:03.00,Default,,0000,0000,0000,,Қажет емес.
Dialogue: 0,0:40:03.00,0:40:04.97,Default,,0000,0000,0000,,Бөлме
Dialogue: 0,0:40:03.00,0:40:04.97,Default,,0000,0000,0000,,БӨЛМЕ! Shambles!
Dialogue: 0,0:40:07.00,0:40:11.01,Default,,0000,0000,0000,,Иә? Қайда бардың?
Dialogue: 0,0:40:07.00,0:40:11.01,Default,,0000,0000,0000,,Сіз қашып кеттіңіз бе? Қарақшы.
Dialogue: 0,0:40:11.01,0:40:14.01,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:40:11.01,0:40:14.01,Default,,0000,0000,0000,,Сізде әртүрлі қабілеттер бар.
Dialogue: 0,0:40:14.01,0:40:15.68,Default,,0000,0000,0000,,Жарайды! ➡
Dialogue: 0,0:40:15.68,0:40:18.95,Default,,0000,0000,0000,,Оны ойынға айналдырайық!
Dialogue: 0,0:40:15.68,0:40:18.95,Default,,0000,0000,0000,,Қашып кеткен қарақшыны табыңыз!
Dialogue: 0,0:41:14.00,0:41:16.01,Default,,0000,0000,0000,,Шығар! Шляпаңызды қайтарыңыз!
Dialogue: 0,0:41:14.00,0:41:16.01,Default,,0000,0000,0000,,Аузыңды жап! ➡
Dialogue: 0,0:41:16.01,0:41:18.94,Default,,0000,0000,0000,,Себебі мен мұны істей алмаймын.
Dialogue: 0,0:41:16.01,0:41:18.94,Default,,0000,0000,0000,,Мен сені осында қойдым!
Dialogue: 0,0:41:18.94,0:41:20.95,Default,,0000,0000,0000,,Бірақ сіз жай ғана қашып кеттіңіз...
Dialogue: 0,0:41:20.95,0:41:23.95,Default,,0000,0000,0000,,Портқа аралдың екінші жағынан кіріңіз.
Dialogue: 0,0:41:20.95,0:41:23.95,Default,,0000,0000,0000,,Порт?
Dialogue: 0,0:41:23.95,0:41:27.95,Default,,0000,0000,0000,,Тікелей эфирде
Dialogue: 0,0:41:23.95,0:41:27.95,Default,,0000,0000,0000,,Чохоу
Dialogue: 0,0:41:23.95,0:41:27.95,Default,,0000,0000,0000,,Теңіз жаяу әскерлері мен барлау агенттері де болды.
Dialogue: 0,0:41:27.95,0:41:30.96,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:41:27.95,0:41:30.96,Default,,0000,0000,0000,,Дүниежүзілік үкімет және флот ➡
Dialogue: 0,0:41:30.96,0:41:32.96,Default,,0000,0000,0000,,Ұзақ уақыт бойы
Dialogue: 0,0:41:30.96,0:41:32.96,Default,,0000,0000,0000,,Ютаның қабілетіне назар аударыңыз➡
Dialogue: 0,0:41:32.96,0:41:35.96,Default,,0000,0000,0000,,Бұл олардың оны қауіпті деп санағанын білдіреді.
Dialogue: 0,0:41:35.96,0:41:37.96,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:41:35.96,0:41:37.96,Default,,0000,0000,0000,,Сонда сіз барлау үшін болдыңыз ба?
Dialogue: 0,0:41:37.96,0:41:39.96,Default,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:41:37.96,0:41:39.96,Default,,0000,0000,0000,,Осы аралға жақындау➡
Dialogue: 0,0:41:39.96,0:41:43.97,Default,,0000,0000,0000,,If you grab someone in the navy and make them vomit.
Dialogue: 0,0:41:39.96,0:41:43.97,Default,,0000,0000,0000,,Ютаның қабілеті де...
Dialogue: 0,0:41:43.97,0:41:45.97,Default,,0000,0000,0000,,Ол емес!
Dialogue: 0,0:41:45.97,0:41:47.97,Default,,0000,0000,0000,,Иә? Эй! ➡
Dialogue: 0,0:41:47.97,0:41:51.98,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:41:47.97,0:41:51.98,Default,,0000,0000,0000,,Менің тосқауылым керемет! ➡
Dialogue: 0,0:41:51.98,0:41:55.98,Default,,0000,0000,0000,,Ах, бірақ ол тоқтамайды!
Dialogue: 0,0:41:51.98,0:41:55.98,Default,,0000,0000,0000,,Надаба! Ахх!
Dialogue: 0,0:41:55.98,0:41:57.95,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:42:00.99,0:42:03.95,Default,,0000,0000,0000,,Бұл қымбат!
Dialogue: 0,0:42:00.99,0:42:03.95,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:42:06.99,0:42:09.96,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:42:06.99,0:42:09.96,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:42:14.00,0:42:16.00,Default,,0000,0000,0000,,Хехе. иә? ➡
Dialogue: 0,0:42:16.00,0:42:18.94,Default,,0000,0000,0000,,Луффи-сенпай!
Dialogue: 0,0:42:16.00,0:42:18.94,Default,,0000,0000,0000,,Сабырлық! Сабырлы болыңыз! ➡
Dialogue: 0,0:42:18.94,0:42:20.94,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:42:20.94,0:42:22.94,Default,,0000,0000,0000,,Уф... ой...
Dialogue: 0,0:42:20.94,0:42:22.94,Default,,0000,0000,0000,,А... аа....
Dialogue: 0,0:42:22.94,0:42:24.91,Default,,0000,0000,0000,,А... аа!
Dialogue: 0,0:42:27.95,0:42:29.95,Default,,0000,0000,0000,,Сәлем Гордон
Dialogue: 0,0:42:27.95,0:42:29.95,Default,,0000,0000,0000,,Сіз ашулысыз ба? ➡
Dialogue: 0,0:42:29.95,0:42:32.95,Default,,0000,0000,0000,,Кеңессіз
Dialogue: 0,0:42:29.95,0:42:32.95,Default,,0000,0000,0000,,Мен рұқсатсыз тікелей эфир өткіздім.
Dialogue: 0,0:42:32.95,0:42:35.95,Default,,0000,0000,0000,,(Гордон)
Dialogue: 0,0:42:32.95,0:42:35.95,Default,,0000,0000,0000,,Бұл жай ғана тікелей шоу емес, солай ма?
Dialogue: 0,0:42:35.95,0:42:39.96,Default,,0000,0000,0000,,Мен байқадым...
Егер бұл
Dialogue: 0,0:42:35.95,0:42:39.96,Default,,0000,0000,0000,,болса, сіз мені қолдайсыз, солай ма?
Dialogue: 0,0:42:39.96,0:42:44.96,Default,,0000,0000,0000,,Мен... Мен...
Dialogue: 0,0:42:44.96,0:42:47.97,Default,,0000,0000,0000,,Осылайша қашасың.
Dialogue: 0,0:42:44.96,0:42:47.97,Default,,0000,0000,0000,,Ештеңе етпейді.
Dialogue: 0,0:42:47.97,0:42:51.97,Default,,0000,0000,0000,,Мен саған
Dialogue: 0,0:42:47.97,0:42:51.97,Default,,0000,0000,0000,,Мен сенің бұлай істегеніңді қаламаймын!
Dialogue: 0,0:42:51.97,0:42:53.64,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:42:53.64,0:42:55.64,Default,,0000,0000,0000,,Сол жерде біраз уақыт болыңыз.
Dialogue: 0,0:42:55.64,0:42:57.98,Default,,0000,0000,0000,,The world government and navy will not remain silent!
Dialogue: 0,0:42:57.98,0:43:00.98,Default,,0000,0000,0000,,Жарайды, менде мынау бар.
Dialogue: 0,0:43:00.98,0:43:04.98,Default,,0000,0000,0000,,Ха! Жоқ, бұл Totto Musica...
Dialogue: 0,0:43:04.98,0:43:09.99,Default,,0000,0000,0000,,Мен білдім
Dialogue: 0,0:43:04.98,0:43:09.99,Default,,0000,0000,0000,,It's hidden in the basement of the castle.
Dialogue: 0,0:43:09.99,0:43:12.99,Default,,0000,0000,0000,,Неліктен оны тастамадың?
Dialogue: 0,0:43:09.99,0:43:12.99,Default,,0000,0000,0000,,Мүмкін ➡
Dialogue: 0,0:43:12.99,0:43:16.99,Default,,0000,0000,0000,,Сізде де жаңа дәуір идеалдары бар.
Dialogue: 0,0:43:12.99,0:43:16.99,Default,,0000,0000,0000,,Онда болды ма?
Dialogue: 0,0:43:16.99,0:43:19.93,Default,,0000,0000,0000,,Ута!
Dialogue: 0,0:43:16.99,0:43:19.93,Default,,0000,0000,0000,,Мұны қолданбаңыз! ➡
Dialogue: 0,0:43:19.93,0:43:22.93,Default,,0000,0000,0000,,Ута~!
Dialogue: 0,0:43:22.93,0:43:24.90,Default,,0000,0000,0000,,Ачо...
Dialogue: 0,0:43:26.94,0:43:30.94,Default,,0000,0000,0000,,
Dialogue: 0,0:43:26.94,0:43:30.94,Default,,0000,0000,0000,,Теңіз кең. Бұл үлкен. ➡
Dialogue: 0,0:43:30.94,0:43:33.94,Default,,0000,0000,0000,,Бірақ флотты былай қойғанда.
Dialogue: 0,0:43:30.94,0:43:33.94,Default,,0000,0000,0000,,Ешкім.
Dialogue: 0,0:43:33.94,0:43:35.95,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:43:33.94,0:43:35.95,Default,,0000,0000,0000,,Надабе.
Dialogue: 0,0:43:35.95,0:43:38.92,Default,,0000,0000,0000,,Күн жоқ!
Dialogue: 0,0:43:35.95,0:43:38.92,Default,,0000,0000,0000,,Люффи-сенпайдың кемесі! ?
Dialogue: 0,0:43:40.95,0:43:42.95,Default,,0000,0000,0000,,⚟Күн шуақты!
Dialogue: 0,0:43:42.95,0:43:44.62,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:43:44.62,0:43:48.63,Default,,0000,0000,0000,,⚟Сани Сани….
Dialogue: 0,0:43:44.62,0:43:48.63,Default,,0000,0000,0000,,Ни сэр. Ха...
Dialogue: 0,0:43:48.63,0:43:50.29,Default,,0000,0000,0000,,Күн шуақты!
Dialogue: 0,0:43:50.29,0:43:52.96,Default,,0000,0000,0000,,Мүмкін емес!
Dialogue: 0,0:43:50.29,0:43:52.96,Default,,0000,0000,0000,,Сіз Күншуақсыз ба? ?
Dialogue: 0,0:43:52.96,0:43:55.97,Default,,0000,0000,0000,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:43:52.96,0:43:55.97,Default,,0000,0000,0000,,Бұл Ута-саманың қабілеті ме? ➡
Dialogue: 0,0:43:55.97,0:44:00.97,Default,,0000,0000,0000,,Менің басым үрейлене бастады!
Dialogue: 0,0:43:55.97,0:44:00.97,Default,,0000,0000,0000,,Күн шуақты.
Dialogue: 0,0:44:00.97,0:44:02.97,Default,,0000,0000,0000,,🔊 (теңіз)
Dialogue: 0,0:44:00.97,0:44:02.97,Default,,0000,0000,0000,,Болжамдағы барлаушыдан есеп. ➡
Dialogue: 0,0:44:02.97,0:44:05.98,Default,,0000,0000,0000,,Айналадағы жаулар расталмады.
Dialogue: 0,0:44:02.97,0:44:05.98,Default,,0000,0000,0000,,Қайталау.
Dialogue: 0,0:44:05.98,0:44:07.98,Default,,0000,0000,0000,,🔊 (Теңіз жаяу) Арт жақта болса да сақтығыңызды түсірмеңіз.
Dialogue: 0,0:44:05.98,0:44:07.98,Default,,0000,0000,0000,,Тосын шабуылға дайындал.
Dialogue: 0,0:44:07.98,0:44:10.98,Default,,0000,0000,0000,,🔊 (Теңіз жаяу) Құрлықтағы шайқасқа дайындалыңыз.
Dialogue: 0,0:44:07.98,0:44:10.98,Default,,0000,0000,0000,,Бірінші топ қонғаннан кейін орналасады...
Dialogue: 0,0:44:10.98,0:44:15.99,Default,,0000,0000,0000,,🔊 (Теңіз) Қарулы барлау 1
Dialogue: 0,0:44:10.98,0:44:15.99,Default,,0000,0000,0000,,Үйінділерді аралап жүру. Жау көрінбейді.
Dialogue: 0,0:44:15.99,0:44:19.92,Default,,0000,0000,0000,,🔊 (теңіз жаяу) қарулы барлау 2
Dialogue: 0,0:44:15.99,0:44:19.92,Default,,0000,0000,0000,,Іздеу жалғасуда. Әлі де жау көрінбейді.
Dialogue: 0,0:44:19.92,0:44:23.93,Default,,0000,0000,0000,,🔊 (Теңіз) Миссияны жалғастырады
Dialogue: 0,0:44:19.92,0:44:23.93,Default,,0000,0000,0000,,Ашық жау расталмады➡
Dialogue: 0,0:44:23.93,0:44:27.90,Default,,0000,0000,0000,,Жаулар немесе жауға ұқсас заттар
Dialogue: 0,0:44:23.93,0:44:27.90,Default,,0000,0000,0000,,Ашуға болмайды. Қосымша тапсырыстар іздеуде.
Dialogue: 0,0:44:32.94,0:44:35.94,Default,,0000,0000,0000,,Бұл не...?
Dialogue: 0,0:44:35.94,0:44:52.96,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:44:52.96,0:44:55.96,Default,,0000,0000,0000,,🔊 (Теңіз) Мұнда басыңыз
Dialogue: 0,0:44:52.96,0:44:55.96,Default,,0000,0000,0000,,7 қарулы барлау жасағы орындалуда➡
Dialogue: 0,0:44:55.96,0:44:57.63,Default,,0000,0000,0000,,Элегияда ұлттық ақпарат жоқ.
Dialogue: 0,0:44:57.63,0:44:59.30,Default,,0000,0000,0000,,🔊(Теңіз) қарулы барлау тобы 2➡
Dialogue: 0,0:44:59.30,0:45:00.96,Default,,0000,0000,0000,,Айналадағы
Dialogue: 0,0:44:59.30,0:45:00.96,Default,,0000,0000,0000,,Жауға ұқсайтын ештеңе таппадық.
Dialogue: 0,0:45:00.96,0:45:03.97,Default,,0000,0000,0000,,🔊 (Теңіз) 4-ші қарулы барлау тобы
Dialogue: 0,0:45:00.96,0:45:03.97,Default,,0000,0000,0000,,Генерал-лейтенант Момонгаға➡
Dialogue: 0,0:45:03.97,0:45:05.97,Default,,0000,0000,0000,,Аудиторияның санасы қайтып келмейді. Есін жиған жоқ.
Dialogue: 0,0:45:05.97,0:45:09.97,Default,,0000,0000,0000,,Бұл шынымен өлді ме?
Dialogue: 0,0:45:05.97,0:45:09.97,Default,,0000,0000,0000,,⚟Тек ұйықтап жатырмын.
Dialogue: 0,0:45:09.97,0:45:11.98,Default,,0000,0000,0000,,Бірақ бұл болмайды, ешқашан.
Dialogue: 0,0:45:11.98,0:45:13.64,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:45:13.64,0:45:15.31,Default,,0000,0000,0000,,Егер мені өлтірсең➡
Dialogue: 0,0:45:15.31,0:45:18.92,Default,,0000,0000,0000,,Мұндағы әрбір адамның жүрегі
Dialogue: 0,0:45:15.31,0:45:18.92,Default,,0000,0000,0000,,Мен мәңгілікке оралмаймын➡
Dialogue: 0,0:45:18.92,0:45:21.92,Default,,0000,0000,0000,,Бұл әлі де жақсы ма?
Dialogue: 0,0:45:18.92,0:45:21.92,Default,,0000,0000,0000,,⚟Мисс.
Dialogue: 0,0:45:21.92,0:45:25.92,Default,,0000,0000,0000,,Жас келіншектікі
Dialogue: 0,0:45:21.92,0:45:25.92,Default,,0000,0000,0000,,Шайтанның жеміс қабілеттеріне қатысты➡
Dialogue: 0,0:45:25.92,0:45:27.93,Default,,0000,0000,0000,,Түсіну өте оңай.
Егер бұл
Dialogue: 0,0:45:27.93,0:45:31.93,Default,,0000,0000,0000,,болса, онда түсіндірудің қажеті жоқ.
Dialogue: 0,0:45:27.93,0:45:31.93,Default,,0000,0000,0000,,Иә, қайтып кел.
Dialogue: 0,0:45:31.93,0:45:35.60,Default,,0000,0000,0000,,Оның үстіне, бұл бәрібір аздап көп.
Dialogue: 0,0:45:31.93,0:45:35.60,Default,,0000,0000,0000,,Мен осы жерденмін➡
Dialogue: 0,0:45:35.60,0:45:37.94,Default,,0000,0000,0000,,Өйткені ол жоғалады.
Dialogue: 0,0:45:37.94,0:45:41.94,Default,,0000,0000,0000,,Бұл иіс
Dialogue: 0,0:45:37.94,0:45:41.94,Default,,0000,0000,0000,,Бұл арша саңырауқұлағы ма?
Dialogue: 0,0:45:41.94,0:45:43.94,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:45:41.94,0:45:43.94,Default,,0000,0000,0000,,Арша саңырауқұлағы?
Dialogue: 0,0:45:43.94,0:45:46.94,Default,,0000,0000,0000,,Саңырауқұлақты жегендер
Dialogue: 0,0:45:43.94,0:45:46.94,Default,,0000,0000,0000,,Ұйықтау мүмкін емес➡
Dialogue: 0,0:45:46.94,0:45:49.95,Default,,0000,0000,0000,,Ақырында ол өлімге әкеледі.
Dialogue: 0,0:45:49.95,0:45:53.95,Default,,0000,0000,0000,,Сіз! Көрермендер де
Dialogue: 0,0:45:49.95,0:45:53.95,Default,,0000,0000,0000,,Сіз араласып, өлуді жоспарлап отырсыз ба? ?
Dialogue: 0,0:45:53.95,0:45:57.96,Default,,0000,0000,0000,,Өлім дегеніміз не?
Dialogue: 0,0:45:53.95,0:45:57.96,Default,,0000,0000,0000,,Ақыл денеден маңыздырақ емес пе?
Dialogue: 0,0:45:57.96,0:46:03.96,Default,,0000,0000,0000,,Жаңа заманда бәріміз бірге боламыз
Dialogue: 0,0:45:57.96,0:46:03.96,Default,,0000,0000,0000,,Бұл сіздің жүрегіңізде өмір сүретін нәрсе.
Dialogue: 0,0:46:03.96,0:46:06.96,Default,,0000,0000,0000,,Мүмкін болса, қан төккім келмейді➡
Dialogue: 0,0:46:06.96,0:46:11.97,Default,,0000,0000,0000,,Тоқтату үшін не сұрау керек
Dialogue: 0,0:46:06.96,0:46:11.97,Default,,0000,0000,0000,,Сіз мұны істей аласыз ба? Әлемді құлату жоспары.
Dialogue: 0,0:46:11.97,0:46:13.64,Default,,0000,0000,0000,,Не? не? сол. ➡
Dialogue: 0,0:46:13.64,0:46:16.64,Default,,0000,0000,0000,,Мен бәріне бірдеймін
Dialogue: 0,0:46:13.64,0:46:16.64,Default,,0000,0000,0000,,Ол сенің бақытты болғаныңды қалайды.
Dialogue: 0,0:46:16.64,0:46:18.24,Default,,0000,0000,0000,,Шамасы➡
Dialogue: 0,0:46:18.24,0:46:20.91,Default,,0000,0000,0000,,Сіз сөйлесе алатын адам
Dialogue: 0,0:46:18.24,0:46:20.91,Default,,0000,0000,0000,,Жоқ сияқты.
Dialogue: 0,0:46:20.91,0:46:23.91,Default,,0000,0000,0000,,Бұл сендерсіңдер, балалар.
Dialogue: 0,0:46:20.91,0:46:23.91,Default,,0000,0000,0000,,(Тыныс алу дыбысы)
Dialogue: 0,0:46:23.91,0:46:25.92,Default,,0000,0000,0000,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:46:25.92,0:46:29.59,Default,,0000,0000,0000,,Ән айтатын даусымды басып алсам ғой
Dialogue: 0,0:46:25.92,0:46:29.59,Default,,0000,0000,0000,,Сіз дәрменсізсіз!
Dialogue: 0,0:46:29.59,0:46:32.26,Default,,0000,0000,0000,,Кешіріңіз. Қазірдің өзінде кеш.
Dialogue: 0,0:46:32.26,0:46:33.92,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:46:33.92,0:46:38.93,Default,,0000,0000,0000,,Полковник Коби
Dialogue: 0,0:46:33.92,0:46:38.93,Default,,0000,0000,0000,,Бұл жігіттің қандай келісімі бар?
Dialogue: 0,0:46:38.93,0:46:40.93,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:46:40.93,0:46:43.93,Default,,0000,0000,0000,,Барлығына!
Dialogue: 0,0:46:40.93,0:46:43.93,Default,,0000,0000,0000,,Жаман адамдар бар! ➡
Dialogue: 0,0:46:43.93,0:46:46.94,Default,,0000,0000,0000,,Жаңа дәуір үшін
Dialogue: 0,0:46:43.93,0:46:46.94,Default,,0000,0000,0000,,Бәріміз оны жеңейік!
Dialogue: 0,0:46:46.94,0:46:48.94,Default,,0000,0000,0000,,Уау! Ах...
Dialogue: 0,0:46:48.94,0:46:50.61,Default,,0000,0000,0000,,Мені ренжітпе!
Dialogue: 0,0:46:50.61,0:46:53.94,Default,,0000,0000,0000,,Кім манипуляцияланады?
Dialogue: 0,0:46:50.61,0:46:53.94,Default,,0000,0000,0000,,Жазықсыз бейбіт тұрғындар!
Dialogue: 0,0:46:53.94,0:46:55.95,Default,,0000,0000,0000,,Ах... уау. Ах! ➡
Dialogue: 0,0:46:55.95,0:46:57.95,Default,,0000,0000,0000,,О, бұл…
Dialogue: 0,0:46:55.95,0:46:57.95,Default,,0000,0000,0000,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:46:57.95,0:46:59.95,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:46:57.95,0:46:59.95,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:46:59.95,0:47:03.62,Default,,0000,0000,0000,,♬ «Жалғыз болу
Dialogue: 0,0:46:59.95,0:47:03.62,Default,,0000,0000,0000,,Мен одан шаршадым».
Dialogue: 0,0:47:03.62,0:47:05.96,Default,,0000,0000,0000,,Мен не істеуім керек деп ойлайсың?
Dialogue: 0,0:47:03.62,0:47:05.96,Default,,0000,0000,0000,,♬ «Мен байланыста болғым келеді».
Dialogue: 0,0:47:05.96,0:47:09.96,Default,,0000,0000,0000,,Джуншинмуку
Dialogue: 0,0:47:05.96,0:47:09.96,Default,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:47:05.96,0:47:09.96,Default,,0000,0000,0000,,♬«Таза және пәк сезімдеріммен
Dialogue: 0,0:47:05.96,0:47:09.96,Default,,0000,0000,0000,,Дауыс шығару»
Dialogue: 0,0:47:09.96,0:47:12.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:47:12.96,0:47:15.63,Default,,0000,0000,0000,,♬ «Тыңда, балақай
Dialogue: 0,0:47:12.96,0:47:15.63,Default,,0000,0000,0000,,Бақыт өшпес дақ сияқты».
Dialogue: 0,0:47:15.63,0:47:17.97,Default,,0000,0000,0000,,♬ «Құлағыңызға үй салу
Dialogue: 0,0:47:15.63,0:47:17.97,Default,,0000,0000,0000,,Қашпа, шомыл»➡
Dialogue: 0,0:47:17.97,0:47:20.90,Default,,0000,0000,0000,,♬ «Бәсекелесі жоқ
Dialogue: 0,0:47:17.97,0:47:20.90,Default,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:47:17.97,0:47:20.90,Default,,0000,0000,0000,,Ута жазған тосынсый»➡
Dialogue: 0,0:47:20.90,0:47:23.91,Default,,0000,0000,0000,,♬「жақсы жақсы жақсы балалар &
Dialogue: 0,0:47:20.90,0:47:23.91,Default,,0000,0000,0000,,қыздар»➡
Dialogue: 0,0:47:23.91,0:47:27.91,Default,,0000,0000,0000,,Алдау
Dialogue: 0,0:47:23.91,0:47:27.91,Default,,0000,0000,0000,,♬ «Мені алдап тым күшті болма».
Dialogue: 0,0:47:27.91,0:47:29.58,Default,,0000,0000,0000,,♬ «Тез кел» ➡
Dialogue: 0,0:47:29.58,0:47:36.92,Default,,0000,0000,0000,,♬ «Бұл сахнада бәрі қызық
Dialogue: 0,0:47:29.58,0:47:36.92,Default,,0000,0000,0000,,Бірге ән салайық»➡
Dialogue: 0,0:47:36.92,0:47:39.92,Default,,0000,0000,0000,,♬«Мен сіздің күніңізді өткізгім келеді,
Dialogue: 0,0:47:36.92,0:47:39.92,Default,,0000,0000,0000,,Менің ісімді мақтанышпен орында»➡
Dialogue: 0,0:47:39.92,0:47:41.93,Default,,0000,0000,0000,,♬ «Ей, айтшы
Dialogue: 0,0:47:39.92,0:47:41.93,Default,,0000,0000,0000,,Не болды? ”➡
Dialogue: 0,0:47:41.93,0:47:47.93,Default,,0000,0000,0000,,♬ «Бұл жер – утопия
Dialogue: 0,0:47:41.93,0:47:47.93,Default,,0000,0000,0000,,Өйткені бұл сіз қалаған нәрсе, солай ма? ”➡
Dialogue: 0,0:47:47.93,0:47:52.94,Default,,0000,0000,0000,,Ән
Dialogue: 0,0:47:47.93,0:47:52.94,Default,,0000,0000,0000,,♬ «Кенеттен шыққан көбік
Dialogue: 0,0:47:47.93,0:47:52.94,Default,,0000,0000,0000,,Айтуға рұқсат етпе»➡
Dialogue: 0,0:47:52.94,0:47:55.94,Default,,0000,0000,0000,,О.
Dialogue: 0,0:47:52.94,0:47:55.94,Default,,0000,0000,0000,,♬ «Мейірімді болғаның үшін мені өртеп жібердің.
Dialogue: 0,0:47:52.94,0:47:55.94,Default,,0000,0000,0000,,Мен қазір тоқтай алмаймын»➡
Dialogue: 0,0:47:55.94,0:47:59.94,Default,,0000,0000,0000,,♬ «Менде жоқ нәрсені сұрамаймын.
Dialogue: 0,0:47:55.94,0:47:59.94,Default,,0000,0000,0000,,Бұл тілек»➡
Dialogue: 0,0:47:59.94,0:48:04.95,Default,,0000,0000,0000,,♬ «Бұл заманда айғайлайды
Dialogue: 0,0:47:59.94,0:48:04.95,Default,,0000,0000,0000,,Мен көмек іздедім.»➡
Dialogue: 0,0:48:04.95,0:48:09.95,Default,,0000,0000,0000,,♬ «Ешкім
Dialogue: 0,0:48:04.95,0:48:09.95,Default,,0000,0000,0000,,Себебі мен байқамадым».
Dialogue: 0,0:48:09.95,0:48:14.96,Default,,0000,0000,0000,,♬ «Мен мұны істеуім керек
Dialogue: 0,0:48:09.95,0:48:14.96,Default,,0000,0000,0000,,Маған кедергі жасамаңыз. ... ... ”➡
Dialogue: 0,0:48:14.96,0:48:19.90,Default,,0000,0000,0000,,♬ «Мен енді қайта алмаймын.
Dialogue: 0,0:48:14.96,0:48:19.90,Default,,0000,0000,0000,,Това
Dialogue: 0,0:48:14.96,0:48:19.90,Default,,0000,0000,0000,,Ендеше мәңгі бірге ән шырқайық»➡
Dialogue: 0,0:48:19.90,0:48:22.90,Default,,0000,0000,0000,,Тікелей
Dialogue: 0,0:48:19.90,0:48:22.90,Default,,0000,0000,0000,,♬ «Миды тікелей тербететін бас
Dialogue: 0,0:48:19.90,0:48:22.90,Default,,0000,0000,0000,,Дабыл жарғағын бұзатын барабан»➡
Dialogue: 0,0:48:22.90,0:48:25.57,Default,,0000,0000,0000,,На
Dialogue: 0,0:48:22.90,0:48:25.57,Default,,0000,0000,0000,,♬ «Жүректі тебірентетін жез фортепиано
Dialogue: 0,0:48:22.90,0:48:25.57,Default,,0000,0000,0000,,Макафери»
Dialogue: 0,0:48:25.57,0:48:30.91,Default,,0000,0000,0000,,♬ «Айқайлаңдар!
Dialogue: 0,0:48:25.57,0:48:30.91,Default,,0000,0000,0000,,Ду-у-у-у-уа! »
Dialogue: 0,0:48:30.91,0:48:33.91,Default,,0000,0000,0000,,♬ «Алдау және миды жуу сіздің шақыруыңыз емес».
Dialogue: 0,0:48:33.91,0:48:38.92,Default,,0000,0000,0000,,♬ «Тек сеніп, намаз оқып, ән салатын менен
Dialogue: 0,0:48:33.91,0:48:38.92,Default,,0000,0000,0000,,Құлағыңызды алыс ұстаңыз».
Dialogue: 0,0:48:38.92,0:48:42.92,Default,,0000,0000,0000,,♬ «Бұл жеткілікті
Dialogue: 0,0:48:38.92,0:48:42.92,Default,,0000,0000,0000,,Менің шын дауысымды есті
Dialogue: 0,0:48:42.92,0:48:46.92,Default,,0000,0000,0000,,(теңіз құстарының айқайы)
Dialogue: 0,0:48:46.92,0:48:49.93,Default,,0000,0000,0000,,Қате, жоқ!
Dialogue: 0,0:48:46.92,0:48:49.93,Default,,0000,0000,0000,,Шықпа!
Dialogue: 0,0:48:49.93,0:48:51.93,Default,,0000,0000,0000,,Әлгі аянышты қастар.
Dialogue: 0,0:48:51.93,0:48:54.93,Default,,0000,0000,0000,,Тіпті сен де
Dialogue: 0,0:48:51.93,0:48:54.93,Default,,0000,0000,0000,,Сіз оны шеше алмайсыз, Маримо!
Dialogue: 0,0:48:54.93,0:48:57.60,Default,,0000,0000,0000,,Фрэнки мен Джинбе ше?
Dialogue: 0,0:48:57.60,0:48:59.94,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:48:57.60,0:48:59.94,Default,,0000,0000,0000,,Бас тартпаңыз.
Dialogue: 0,0:48:59.94,0:49:02.94,Default,,0000,0000,0000,,Бұл мен үшін де жақсы емес.
Dialogue: 0,0:48:59.94,0:49:02.94,Default,,0000,0000,0000,,Брук туралы не деуге болады?
Dialogue: 0,0:49:02.94,0:49:05.94,Default,,0000,0000,0000,,Сондай-ақ… дерлік….
Dialogue: 0,0:49:02.94,0:49:05.94,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:49:05.94,0:49:07.95,Default,,0000,0000,0000,,Оның шығуы мүмкін бе?
Dialogue: 0,0:49:05.94,0:49:07.95,Default,,0000,0000,0000,,Соған ұқсайды➡
Dialogue: 0,0:49:07.95,0:49:10.95,Default,,0000,0000,0000,,Намидің шалбары.
Dialogue: 0,0:49:07.95,0:49:10.95,Default,,0000,0000,0000,,Жаңа велосипедтің қуанышына ештеңе жетпейді, иә?
Dialogue: 0,0:49:10.95,0:49:12.95,Default,,0000,0000,0000,,Көрсем, үрлеймін!
Dialogue: 0,0:49:10.95,0:49:12.95,Default,,0000,0000,0000,,Йохохохо...!
Dialogue: 0,0:49:12.95,0:49:14.95,Default,,0000,0000,0000,,Қарсы боласыз ба?
Dialogue: 0,0:49:14.95,0:49:17.95,Default,,0000,0000,0000,,«Мен оны әнге айналдырамын»
Dialogue: 0,0:49:14.95,0:49:17.95,Default,,0000,0000,0000,,Юта осылай деді, солай ма?
Dialogue: 0,0:49:17.95,0:49:20.96,Default,,0000,0000,0000,,Мүмкін бұл қызметкерлердің белгісі
Dialogue: 0,0:49:17.95,0:49:20.96,Default,,0000,0000,0000,,Бұл мағынасы жоқ па?
Dialogue: 0,0:49:20.96,0:49:24.96,Default,,0000,0000,0000,,Әрине, қандай да бір әуен
Dialogue: 0,0:49:20.96,0:49:24.96,Default,,0000,0000,0000,,Ол бейнелейтін сияқты.
Dialogue: 0,0:49:24.96,0:49:27.97,Default,,0000,0000,0000,,Бастың орналасуы
Dialogue: 0,0:49:24.96,0:49:27.97,Default,,0000,0000,0000,,Бұл до-ре-ми сияқты ма?
Dialogue: 0,0:49:27.97,0:49:29.97,Default,,0000,0000,0000,,Брук, сен ән айтып көре аласың ба?
Dialogue: 0,0:49:29.97,0:49:32.97,Default,,0000,0000,0000,,Мен ұпайды толық көре алмаймын.
Dialogue: 0,0:49:32.97,0:49:34.97,Default,,0000,0000,0000,,Менің қазір көріп тұрғаным...➡
Dialogue: 0,0:49:34.97,0:49:36.97,Default,,0000,0000,0000,,Тек шалбар.
Dialogue: 0,0:49:34.97,0:49:36.97,Default,,0000,0000,0000,,Шулы! Қарама!
Dialogue: 0,0:49:36.97,0:49:40.98,Default,,0000,0000,0000,,Музыкалық партитураға мән беру деген нені білдіреді?
Dialogue: 0,0:49:36.97,0:49:40.98,Default,,0000,0000,0000,,Саман қалпақ қарақшыларынан күткендей.
Dialogue: 0,0:49:40.98,0:49:42.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:49:42.98,0:49:44.98,Default,,0000,0000,0000,,Сендер
Dialogue: 0,0:49:42.98,0:49:44.98,Default,,0000,0000,0000,,Неліктен Бруномен...?
Dialogue: 0,0:49:44.98,0:49:46.98,Default,,0000,0000,0000,,Кейінірек түсіндіру. ➡
Dialogue: 0,0:49:46.98,0:49:48.99,Default,,0000,0000,0000,,Иә, ән айтыңызшы.
Dialogue: 0,0:49:48.99,0:49:52.99,Default,,0000,0000,0000,,♬ “Mi~re~”
Dialogue: 0,0:49:52.99,0:49:54.99,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:49:52.99,0:49:54.99,Default,,0000,0000,0000,,Ухун!
Dialogue: 0,0:49:54.99,0:49:56.99,Default,,0000,0000,0000,,Дәл тимеді!
Dialogue: 0,0:49:56.99,0:50:00.00,Default,,0000,0000,0000,,Олай болса, Брук.
Dialogue: 0,0:49:56.99,0:50:00.00,Default,,0000,0000,0000,,Әрі қарай жалғастырайық.
Dialogue: 0,0:50:00.00,0:50:04.00,Default,,0000,0000,0000,,Балалар, ол баланың қабілеті қандай?
Dialogue: 0,0:50:00.00,0:50:04.00,Default,,0000,0000,0000,,Сіз білетін сияқтысыз.
Dialogue: 0,0:50:04.00,0:50:08.01,Default,,0000,0000,0000,,Сәлем! Тіпті менің әпкем
Dialogue: 0,0:50:04.00,0:50:08.01,Default,,0000,0000,0000,,Маған көмектесе аласыз ба?
Dialogue: 0,0:50:08.01,0:50:11.01,Default,,0000,0000,0000,,Үлкен аға...
Dialogue: 0,0:50:11.01,0:50:15.01,Default,,0000,0000,0000,,Бұл жер жақсы.
Dialogue: 0,0:50:11.01,0:50:15.01,Default,,0000,0000,0000,,Шарт - теңіз флотымен ынтымақтасу.
Dialogue: 0,0:50:15.01,0:50:17.01,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:50:17.01,0:50:18.95,Default,,0000,0000,0000,,♬ “ми”
Dialogue: 0,0:50:17.01,0:50:18.95,Default,,0000,0000,0000,,Ачо~.
Dialogue: 0,0:50:18.95,0:50:20.95,Default,,0000,0000,0000,,♬ “ми”
Dialogue: 0,0:50:18.95,0:50:20.95,Default,,0000,0000,0000,,Ачо~.
Dialogue: 0,0:50:20.95,0:50:22.95,Default,,0000,0000,0000,,♬ “ми”
Dialogue: 0,0:50:20.95,0:50:22.95,Default,,0000,0000,0000,,Ачо!
Dialogue: 0,0:50:22.95,0:50:25.96,Default,,0000,0000,0000,,♬ «Дре»
Dialogue: 0,0:50:22.95,0:50:25.96,Default,,0000,0000,0000,,Мен.
Dialogue: 0,0:50:25.96,0:50:28.96,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:50:25.96,0:50:28.96,Default,,0000,0000,0000,,Сіз керемет аюсыз.
Dialogue: 0,0:50:28.96,0:50:30.96,Default,,0000,0000,0000,,Иә, иә!
Dialogue: 0,0:50:30.96,0:50:35.97,Default,,0000,0000,0000,,Oh... Oh my...
Dialogue: 0,0:50:30.96,0:50:35.97,Default,,0000,0000,0000,,Мен сенбеймін...
Dialogue: 0,0:50:35.97,0:50:38.97,Default,,0000,0000,0000,,Неге... тағы да осында?
Dialogue: 0,0:50:38.97,0:50:41.97,Default,,0000,0000,0000,,Uta-sama's ability
Dialogue: 0,0:50:38.97,0:50:41.97,Default,,0000,0000,0000,,Білмесем де➡
Dialogue: 0,0:50:41.97,0:50:44.98,Default,,0000,0000,0000,,Luffy-senpai
Dialogue: 0,0:50:41.97,0:50:44.98,Default,,0000,0000,0000,,Мен сені бостандыққа жібере алмаймын.
Dialogue: 0,0:50:44.98,0:50:46.64,Default,,0000,0000,0000,,Sunny.
Dialogue: 0,0:50:46.64,0:50:48.98,Default,,0000,0000,0000,,Sa… Sani?
Dialogue: 0,0:50:48.98,0:50:50.98,Default,,0000,0000,0000,,ал Ол Майтпен шайқасу – қауіпті ғана емес,
Dialogue: 0,0:50:48.98,0:50:50.98,Default,,0000,0000,0000,,Не! ? Эй, жігіттер!
Dialogue: 0,0:50:50.98,0:50:52.98,Default,,0000,0000,0000,,Біраз уақыт болды, Луффи-сан!
Dialogue: 0,0:50:52.98,0:50:57.99,Default,,0000,0000,0000,,Coby…. Оны... осы жерден...
Dialogue: 0,0:50:57.99,0:50:59.99,Default,,0000,0000,0000,,Бұл жерді қалай таптың?
Dialogue: 0,0:50:59.99,0:51:01.99,Default,,0000,0000,0000,,(Coby)
Dialogue: 0,0:50:59.99,0:51:01.99,Default,,0000,0000,0000,,Мен Луффидің қатысуын сеземін.
Dialogue: 0,0:51:01.99,0:51:03.99,Default,,0000,0000,0000,,Knowledge
Dialogue: 0,0:51:01.99,0:51:03.99,Default,,0000,0000,0000,,Haki
Dialogue: 0,0:51:01.99,0:51:03.99,Default,,0000,0000,0000,,Бұл Кенбуншоку Хаки ме?
Dialogue: 0,0:51:03.99,0:51:08.00,Default,,0000,0000,0000,,Қалғаны Бруно мырза.
Dialogue: 0,0:51:03.99,0:51:08.00,Default,,0000,0000,0000,,I borrowed the ability of the door door fruit.
Dialogue: 0,0:51:08.00,0:51:13.00,Default,,0000,0000,0000,,Есік есігі…мені шығарыңыз….
Dialogue: 0,0:51:08.00,0:51:13.00,Default,,0000,0000,0000,,Уау... Уау...
Dialogue: 0,0:51:13.00,0:51:18.01,Default,,0000,0000,0000,,Шифр Павел мен Әскери-теңіз күштері араласады ма?
Dialogue: 0,0:51:13.00,0:51:18.01,Default,,0000,0000,0000,,Ол қандай жел соғады?
Dialogue: 0,0:51:18.01,0:51:21.95,Default,,0000,0000,0000,,Білгіңіз келетін нәрсе
Dialogue: 0,0:51:18.01,0:51:21.95,Default,,0000,0000,0000,,Бұл Ютаның қабілеті туралы, солай ма?
Dialogue: 0,0:51:21.95,0:51:23.95,Default,,0000,0000,0000,,Ута-саманың күші туралы білесің бе?
Dialogue: 0,0:51:23.95,0:51:25.95,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:51:25.95,0:51:27.95,Default,,0000,0000,0000,,Сенесіз бе, сенбесеңіз➡
Dialogue: 0,0:51:27.95,0:51:31.96,Default,,0000,0000,0000,,Бұл біз қазір тұрған әлем
Dialogue: 0,0:51:27.95,0:51:31.96,Default,,0000,0000,0000,,Not reality.
Dialogue: 0,0:51:31.96,0:51:33.62,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:51:33.62,0:51:35.96,Default,,0000,0000,0000,,(Coby)
Dialogue: 0,0:51:33.62,0:51:35.96,Default,,0000,0000,0000,,Сіз не көріп тұрсыз➡
Dialogue: 0,0:51:35.96,0:51:38.96,Default,,0000,0000,0000,,All Utaga
Dialogue: 0,0:51:35.96,0:51:38.96,Default,,0000,0000,0000,,Created with the ability of Utauta no Mi➡
Dialogue: 0,0:51:38.96,0:51:42.97,Default,,0000,0000,0000,,тек санада
Dialogue: 0,0:51:38.96,0:51:42.97,Default,,0000,0000,0000,,Бұл ойдан шығарылған дүние. ➡
Dialogue: 0,0:51:42.97,0:51:44.97,Default,,0000,0000,0000,,Утаута но Мидың қабілеті қандай?➡
Dialogue: 0,0:51:44.97,0:51:49.97,Default,,0000,0000,0000,,The heart of the person who heard the singing voice
Dialogue: 0,0:51:44.97,0:51:49.97,Default,,0000,0000,0000,,The power to bring you into the world of Nasty. ➡
Dialogue: 0,0:51:49.97,0:51:54.98,Default,,0000,0000,0000,,Жүрегі қабылданатын адам
Dialogue: 0,0:51:49.97,0:51:54.98,Default,,0000,0000,0000,,Шынайы әлем емес➡
Dialogue: 0,0:51:54.98,0:51:57.98,Default,,0000,0000,0000,,In the world that Uta wanted
Dialogue: 0,0:51:54.98,0:51:57.98,Default,,0000,0000,0000,,I feel like I'm alive. ➡
Dialogue: 0,0:51:57.98,0:52:03.99,Default,,0000,0000,0000,,As if everyone
Dialogue: 0,0:51:57.98,0:52:03.99,Default,,0000,0000,0000,,As if we were having the same dream...
Dialogue: 0,0:52:03.99,0:52:05.99,Default,,0000,0000,0000,,By the way, Uta's one➡
Dialogue: 0,0:52:05.99,0:52:08.99,Default,,0000,0000,0000,,Do you have that kind of power?
Dialogue: 0,0:52:05.99,0:52:08.99,Default,,0000,0000,0000,,That's what I said.
Dialogue: 0,0:52:08.99,0:52:10.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:52:08.99,0:52:10.99,Default,,0000,0000,0000,,Сондықтан!
Dialogue: 0,0:52:10.99,0:52:14.00,Default,,0000,0000,0000,,When I listen to his song
Dialogue: 0,0:52:10.99,0:52:14.00,Default,,0000,0000,0000,,Before we knew it, everyone was asleep.
Dialogue: 0,0:52:14.00,0:52:17.00,Default,,0000,0000,0000,,If you knew
Dialogue: 0,0:52:14.00,0:52:17.00,Default,,0000,0000,0000,,I wish you told me sooner!
Dialogue: 0,0:52:17.00,0:52:19.94,Default,,0000,0000,0000,,Nahaha! Мен ұмыттым.
Dialogue: 0,0:52:19.94,0:52:22.94,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:52:19.94,0:52:22.94,Default,,0000,0000,0000,,What is the real world like?
Dialogue: 0,0:52:22.94,0:52:26.94,Default,,0000,0000,0000,,In the real world
Dialogue: 0,0:52:22.94,0:52:26.94,Default,,0000,0000,0000,,Only our bodies remain. ➡
Dialogue: 0,0:52:26.94,0:52:30.95,Default,,0000,0000,0000,,But the body
Dialogue: 0,0:52:26.94,0:52:30.95,Default,,0000,0000,0000,,It should be controlled by Uta.
Dialogue: 0,0:52:30.95,0:52:32.95,Default,,0000,0000,0000,,(Law)
Dialogue: 0,0:52:30.95,0:52:32.95,Default,,0000,0000,0000,,How can I return to reality?
Dialogue: 0,0:52:32.95,0:52:35.95,Default,,0000,0000,0000,,If Uta sleeps
Dialogue: 0,0:52:32.95,0:52:35.95,Default,,0000,0000,0000,,Ability is canceled. ➡
Dialogue: 0,0:52:35.95,0:52:40.96,Default,,0000,0000,0000,,But already in the real world of Utauta no Mi.
Dialogue: 0,0:52:35.95,0:52:40.96,Default,,0000,0000,0000,,We who have been taken in➡
Dialogue: 0,0:52:40.96,0:52:43.96,Default,,0000,0000,0000,,In reality
Dialogue: 0,0:52:40.96,0:52:43.96,Default,,0000,0000,0000,,You cannot touch it.
Dialogue: 0,0:52:43.96,0:52:46.96,Default,,0000,0000,0000,,Devil fruit abilities include
Dialogue: 0,0:52:43.96,0:52:46.96,Default,,0000,0000,0000,,There must be a limit.
Dialogue: 0,0:52:46.96,0:52:48.97,Default,,0000,0000,0000,,Иә. ➡
Dialogue: 0,0:52:48.97,0:52:52.97,Default,,0000,0000,0000,,In order to maintain the world of napping
Dialogue: 0,0:52:48.97,0:52:52.97,Default,,0000,0000,0000,,Severely consumes physical strength. ➡
Dialogue: 0,0:52:52.97,0:52:57.97,Default,,0000,0000,0000,,I always use the ability of the door door fruit.
Dialogue: 0,0:52:52.97,0:52:57.97,Default,,0000,0000,0000,,So that you can't keep using it.
Dialogue: 0,0:52:57.97,0:53:00.98,Default,,0000,0000,0000,,Well then, Uta-sama is tired.
Dialogue: 0,0:52:57.97,0:53:00.98,Default,,0000,0000,0000,,Should I just sleep?
Dialogue: 0,0:53:00.98,0:53:03.98,Default,,0000,0000,0000,,Бұл қиын.
Dialogue: 0,0:53:00.98,0:53:03.98,Default,,0000,0000,0000,,Before the live performance starts➡
Dialogue: 0,0:53:03.98,0:53:06.98,Default,,0000,0000,0000,,I watched him eat a juniper mushroom.
Dialogue: 0,0:53:03.98,0:53:06.98,Default,,0000,0000,0000,,Confirmed. ➡
Dialogue: 0,0:53:06.98,0:53:09.99,Default,,0000,0000,0000,,Those who ate
Dialogue: 0,0:53:06.98,0:53:09.99,Default,,0000,0000,0000,,Бұл ұйықтауға болмайтын нәрсе.
Dialogue: 0,0:53:09.99,0:53:14.99,Default,,0000,0000,0000,,Soon, Uta in the real world will be
Dialogue: 0,0:53:09.99,0:53:14.99,Default,,0000,0000,0000,,Қуат таусылып өлесің.
Dialogue: 0,0:53:14.99,0:53:17.99,Default,,0000,0000,0000,,Die! ?
Dialogue: 0,0:53:14.99,0:53:17.99,Default,,0000,0000,0000,,Bae~!
Dialogue: 0,0:53:17.99,0:53:19.60,Default,,0000,0000,0000,,Uta! ?
Dialogue: 0,0:53:19.60,0:53:21.93,Default,,0000,0000,0000,,Ә? Рика?
Dialogue: 0,0:53:19.60,0:53:21.93,Default,,0000,0000,0000,,Біз бостандыққа шығамыз ба?
Dialogue: 0,0:53:21.93,0:53:23.60,Default,,0000,0000,0000,,Жоқ, керісінше.
Dialogue: 0,0:53:23.60,0:53:26.94,Default,,0000,0000,0000,,If Uta dies
Dialogue: 0,0:53:23.60,0:53:26.94,Default,,0000,0000,0000,,Бұл дүние жабылады. ➡
Dialogue: 0,0:53:26.94,0:53:29.94,Default,,0000,0000,0000,,And then
Dialogue: 0,0:53:26.94,0:53:29.94,Default,,0000,0000,0000,,Бұл дүниедегілер➡
Dialogue: 0,0:53:29.94,0:53:33.94,Default,,0000,0000,0000,,Басқаша айтқанда, біз
Dialogue: 0,0:53:29.94,0:53:33.94,Default,,0000,0000,0000,,Ол сол күйінде қалады. ➡
Dialogue: 0,0:53:33.94,0:53:37.95,Default,,0000,0000,0000,,Fans forever
Dialogue: 0,0:53:33.94,0:53:37.95,Default,,0000,0000,0000,,Ұйқы әлемінде қамау. ➡
Dialogue: 0,0:53:37.95,0:53:41.95,Default,,0000,0000,0000,,Бұл Ютаның жоспары.
Dialogue: 0,0:53:41.95,0:53:43.95,Default,,0000,0000,0000,,
Dialogue: 0,0:53:41.95,0:53:43.95,Default,,0000,0000,0000,,That's crazy...
Dialogue: 0,0:53:43.95,0:53:46.96,Default,,0000,0000,0000,,Coby
Dialogue: 0,0:53:43.95,0:53:46.96,Default,,0000,0000,0000,,Ән айтуды қалай тоқтатуға болады?
Dialogue: 0,0:53:46.96,0:53:49.96,Default,,0000,0000,0000,,To find out
Dialogue: 0,0:53:46.96,0:53:49.96,Default,,0000,0000,0000,,Мен жасырын жүрдім➡
Dialogue: 0,0:53:49.96,0:53:51.96,Default,,0000,0000,0000,,Мен әлі ештеңе білмеймін. ➡
Dialogue: 0,0:53:51.96,0:53:55.97,Default,,0000,0000,0000,,Бірақ әскери күш болғаны жақсы.
Dialogue: 0,0:53:51.96,0:53:55.97,Default,,0000,0000,0000,,Mr. Helmeppo➡
Dialogue: 0,0:53:55.97,0:53:57.97,Default,,0000,0000,0000,,The pirates here
Dialogue: 0,0:53:55.97,0:53:57.97,Default,,0000,0000,0000,,Collecting. ➡
Dialogue: 0,0:53:57.97,0:54:01.97,Default,,0000,0000,0000,,Және сабан қалпақ қарақшылары
Dialogue: 0,0:53:57.97,0:54:01.97,Default,,0000,0000,0000,,Басқаша әрекет ету.
Dialogue: 0,0:54:01.97,0:54:03.97,Default,,0000,0000,0000,,Are they safe?
Dialogue: 0,0:54:03.97,0:54:06.98,Default,,0000,0000,0000,,They are
Dialogue: 0,0:54:03.97,0:54:06.98,Default,,0000,0000,0000,,Элегия қамалына бет алды. ➡
Dialogue: 0,0:54:06.98,0:54:10.65,Default,,0000,0000,0000,,Нико Робин баяғыда
Dialogue: 0,0:54:06.98,0:54:10.65,Default,,0000,0000,0000,,About the incident that happened on this island➡
Dialogue: 0,0:54:10.65,0:54:12.98,Default,,0000,0000,0000,,Сіз бір нәрсені білетін сияқтысыз.
Dialogue: 0,0:54:12.98,0:54:15.99,Default,,0000,0000,0000,,Сол кездегі жазбалар болса
Dialogue: 0,0:54:12.98,0:54:15.99,Default,,0000,0000,0000,,If I stay here➡
Dialogue: 0,0:54:15.99,0:54:19.92,Default,,0000,0000,0000,,Утаның қабілетін бұзудың жолы бар.
Dialogue: 0,0:54:15.99,0:54:19.92,Default,,0000,0000,0000,,Түсінетін шығарсыз.
Dialogue: 0,0:54:19.92,0:54:21.93,Default,,0000,0000,0000,,Бұл үміт тым әлсіз.
Dialogue: 0,0:54:21.93,0:54:23.93,Default,,0000,0000,0000,,Believe in Robin-chan
Dialogue: 0,0:54:21.93,0:54:23.93,Default,,0000,0000,0000,,Bakamarimo!
Dialogue: 0,0:54:23.93,0:54:26.60,Default,,0000,0000,0000,,Дұрыс айтпадым ба, Крюгер мырза?
Dialogue: 0,0:54:23.93,0:54:26.60,Default,,0000,0000,0000,,It's true, nice Mayuge!
Dialogue: 0,0:54:26.60,0:54:28.93,Default,,0000,0000,0000,,Over there
Dialogue: 0,0:54:26.60,0:54:28.93,Default,,0000,0000,0000,,There's a room full of books!
Dialogue: 0,0:54:28.93,0:54:33.94,Default,,0000,0000,0000,,🔊♬ (музыка)
Dialogue: 0,0:54:33.94,0:54:36.94,Default,,0000,0000,0000,,Барлығына!
Dialogue: 0,0:54:33.94,0:54:36.94,Default,,0000,0000,0000,,Қарақшыларды жайына қалдырыңыз➡
Dialogue: 0,0:54:36.94,0:54:39.94,Default,,0000,0000,0000,,Біз
Dialogue: 0,0:54:36.94,0:54:39.94,Default,,0000,0000,0000,,Let's wait for the birth of a new era!
Dialogue: 0,0:54:39.94,0:54:41.91,Default,,0000,0000,0000,,(cheers/applause)
Dialogue: 0,0:54:45.98,0:54:47.98,Default,,0000,0000,0000,,In the real world
Dialogue: 0,0:54:45.98,0:54:47.98,Default,,0000,0000,0000,,How long does it take for Uta to die?
Dialogue: 0,0:54:47.98,0:54:49.99,Default,,0000,0000,0000,,Екі сағаттан аз уақыт қалды.
Dialogue: 0,0:54:47.98,0:54:49.99,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:54:49.99,0:54:54.99,Default,,0000,0000,0000,,(соққы дыбысы)
Dialogue: 0,0:54:54.99,0:54:57.99,Default,,0000,0000,0000,,Барлық осы дыбыс оқшаулау
Dialogue: 0,0:54:54.99,0:54:57.99,Default,,0000,0000,0000,,If it was solid➡
Dialogue: 0,0:54:57.99,0:55:00.00,Default,,0000,0000,0000,,Утаның да қабілеті шарықтау шегіне жетпеген сияқты.
Dialogue: 0,0:55:00.00,0:55:05.00,Default,,0000,0000,0000,,Әнші дауыс жетпеген жерде жарайды
Dialogue: 0,0:55:00.00,0:55:05.00,Default,,0000,0000,0000,,Әскери-теңіз күшінің жігіті де солай деді.
Dialogue: 0,0:55:05.00,0:55:08.00,Default,,0000,0000,0000,,Бұлардың бәрі ескі жазбалар ма?
Dialogue: 0,0:55:08.00,0:55:11.01,Default,,0000,0000,0000,,Қаншама көп болса да
Dialogue: 0,0:55:08.00,0:55:11.01,Default,,0000,0000,0000,,How do I search?
Dialogue: 0,0:55:11.01,0:55:12.98,Default,,0000,0000,0000,,《Оның күші одан сайын артуда》
Dialogue: 0,0:55:11.01,0:55:12.98,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:55:16.01,0:55:18.95,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:55:18.95,0:55:22.92,Default,,0000,0000,0000,,Ur
Dialogue: 0,0:55:18.95,0:55:22.92,Default,,0000,0000,0000,,Жолбарыс
Dialogue: 0,0:55:18.95,0:55:22.92,Default,,0000,0000,0000,,Үш қылыш стиліндегі экстремалды жолбарыс аулау!
Dialogue: 0,0:55:24.95,0:55:30.96,Default,,0000,0000,0000,,
Dialogue: 0,0:55:24.95,0:55:30.96,Default,,0000,0000,0000,,Diable Jambu
Dialogue: 0,0:55:24.95,0:55:30.96,Default,,0000,0000,0000,,Frit
Dialogue: 0,0:55:24.95,0:55:30.96,Default,,0000,0000,0000,,Assorti
Dialogue: 0,0:55:24.95,0:55:30.96,Default,,0000,0000,0000,,Ібіліс стиліндегі аяқтар Ассорти қуырылған тағамдар!
Dialogue: 0,0:55:30.96,0:55:35.97,Default,,0000,0000,0000,,Light
Dialogue: 0,0:55:30.96,0:55:35.97,Default,,0000,0000,0000,,Left
Dialogue: 0,0:55:30.96,0:55:35.97,Default,,0000,0000,0000,,Strong right! Weapons left!
Dialogue: 0,0:55:35.97,0:55:38.97,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:55:35.97,0:55:38.97,Default,,0000,0000,0000,,Робин кітап іздеп жүр!
Dialogue: 0,0:55:38.97,0:55:40.97,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:55:38.97,0:55:40.97,Default,,0000,0000,0000,,Робин!
Dialogue: 0,0:55:40.97,0:55:43.94,Default,,0000,0000,0000,,Мен саған бір саусақты тигізуге рұқсат бермеймін
Dialogue: 0,0:55:40.97,0:55:43.94,Default,,0000,0000,0000,,Don't worry!
Dialogue: 0,0:55:53.98,0:55:55.99,Default,,0000,0000,0000,,《Soon➡
Dialogue: 0,0:55:55.99,0:55:59.99,Default,,0000,0000,0000,,Жаман адам болмайды
Dialogue: 0,0:55:55.99,0:55:59.99,Default,,0000,0000,0000,,Жаңа дәуір келе жатыр》
Dialogue: 0,0:55:59.99,0:56:03.99,Default,,0000,0000,0000,,Сіз мені ести аласыз ба?
Dialogue: 0,0:55:59.99,0:56:03.99,Default,,0000,0000,0000,,Ютаның өмір сүруіне бір сағат қана қалды.
Dialogue: 0,0:56:03.99,0:56:08.00,Default,,0000,0000,0000,,Алайда Эйзо Денден Муши менің жүрегімді ұрлап алды.
Dialogue: 0,0:56:03.99,0:56:08.00,Default,,0000,0000,0000,,Out of control. ➡
Dialogue: 0,0:56:08.00,0:56:11.00,Default,,0000,0000,0000,,Насти әлемінің бейнелері
Dialogue: 0,0:56:08.00,0:56:11.00,Default,,0000,0000,0000,,Ол ағуды жалғастырады. ➡
Dialogue: 0,0:56:11.00,0:56:14.00,Default,,0000,0000,0000,,If the audio is not turned off
Dialogue: 0,0:56:11.00,0:56:14.00,Default,,0000,0000,0000,,Қауіпті. ➡
Dialogue: 0,0:56:14.00,0:56:18.94,Default,,0000,0000,0000,,The moment I heard the singing voice
Dialogue: 0,0:56:14.00,0:56:18.94,Default,,0000,0000,0000,,It captures my heart.
Dialogue: 0,0:56:18.94,0:56:21.61,Default,,0000,0000,0000,,🔊♬ “Listen up baby
Dialogue: 0,0:56:18.94,0:56:21.61,Default,,0000,0000,0000,,Happiness is like an indelible stain”➡
Dialogue: 0,0:56:21.61,0:56:23.95,Default,,0000,0000,0000,,♬ “Homing into your ear
Dialogue: 0,0:56:21.61,0:56:23.95,Default,,0000,0000,0000,,Don’t run away, take a bath”➡
Dialogue: 0,0:56:23.95,0:56:26.95,Default,,0000,0000,0000,,♬ «Бәсекелесі жоқ
Dialogue: 0,0:56:23.95,0:56:26.95,Default,,0000,0000,0000,,Surprise written by Uta”➡
Dialogue: 0,0:56:26.95,0:56:29.95,Default,,0000,0000,0000,,♬「good good good boys &
Dialogue: 0,0:56:26.95,0:56:29.95,Default,,0000,0000,0000,,girls”➡
Dialogue: 0,0:56:29.95,0:56:33.96,Default,,0000,0000,0000,,♬ “Deceive me
Dialogue: 0,0:56:29.95,0:56:33.96,Default,,0000,0000,0000,,Don’t be too strong”➡
Dialogue: 0,0:56:33.96,0:56:35.96,Default,,0000,0000,0000,,♬ “Come here quickly” ➡
Dialogue: 0,0:56:35.96,0:56:43.63,Default,,0000,0000,0000,,♬ “Everything is fun on this stage
Dialogue: 0,0:56:35.96,0:56:43.63,Default,,0000,0000,0000,,Let's sing together."
Dialogue: 0,0:56:43.63,0:56:46.97,Default,,0000,0000,0000,,Since Uta started performing live
Dialogue: 0,0:56:43.63,0:56:46.97,Default,,0000,0000,0000,,It took over 6 hours. ➡
Dialogue: 0,0:56:46.97,0:56:49.97,Default,,0000,0000,0000,,Құрбандар саны жеделдетілген жылдамдықпен өсуде.
Dialogue: 0,0:56:49.97,0:56:52.98,Default,,0000,0000,0000,,1 сағат қалды
Dialogue: 0,0:56:49.97,0:56:52.98,Default,,0000,0000,0000,,If this condition is left alone➡
Dialogue: 0,0:56:52.98,0:56:56.98,Default,,0000,0000,0000,,70% of the world is asleep
Dialogue: 0,0:56:52.98,0:56:56.98,Default,,0000,0000,0000,,Calculation for becoming a resident.
Dialogue: 0,0:56:56.98,0:56:59.98,Default,,0000,0000,0000,,70%! ? Бұл күтпеген жағдай.
Dialogue: 0,0:56:59.98,0:57:01.99,Default,,0000,0000,0000,,Isn't this a crisis of world destruction?
Dialogue: 0,0:57:01.99,0:57:04.95,Default,,0000,0000,0000,,We have to do something to stop it.
Dialogue: 0,0:57:06.99,0:57:08.99,Default,,0000,0000,0000,,⚟Dae~.
Dialogue: 0,0:57:08.99,0:57:12.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:57:08.99,0:57:12.00,Default,,0000,0000,0000,,⚟I liked it. ➡
Dialogue: 0,0:57:12.00,0:57:16.00,Default,,0000,0000,0000,,Come to my house for me
Dialogue: 0,0:57:12.00,0:57:16.00,Default,,0000,0000,0000,,Sing me a lullaby.
Dialogue: 0,0:57:16.00,0:57:18.00,Default,,0000,0000,0000,,Дехехехе….
Dialogue: 0,0:57:18.00,0:57:19.97,Default,,0000,0000,0000,,Тенрюбито
Dialogue: 0,0:57:18.00,0:57:19.97,Default,,0000,0000,0000,,It's Tenryujin...
Dialogue: 0,0:57:22.01,0:57:24.01,Default,,0000,0000,0000,,Saint Charles
Dialogue: 0,0:57:22.01,0:57:24.01,Default,,0000,0000,0000,,I want you.
Dialogue: 0,0:57:24.01,0:57:26.01,Default,,0000,0000,0000,,Thank you for your kindness.
Dialogue: 0,0:57:26.01,0:57:29.01,Default,,0000,0000,0000,,I'll buy you for 1 billion.
Dialogue: 0,0:57:29.01,0:57:33.02,Default,,0000,0000,0000,,Жер
Dialogue: 0,0:57:29.01,0:57:33.02,Default,,0000,0000,0000,,You're a Tenryujin! ?
Dialogue: 0,0:57:33.02,0:57:35.02,Default,,0000,0000,0000,,
Dialogue: 0,0:57:35.02,0:57:39.02,Default,,0000,0000,0000,,Мен білемін. It was in the book.
Dialogue: 0,0:57:35.02,0:57:39.02,Default,,0000,0000,0000,,Ruler of the world➡
Dialogue: 0,0:57:39.02,0:57:43.03,Default,,0000,0000,0000,,...
Dialogue: 0,0:57:39.02,0:57:43.03,Default,,0000,0000,0000,,...
Dialogue: 0,0:57:43.03,0:57:45.03,Default,,0000,0000,0000,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:57:45.03,0:57:47.70,Default,,0000,0000,0000,,Don't worry about it.
Dialogue: 0,0:57:45.03,0:57:47.70,Default,,0000,0000,0000,,Gekirin
Dialogue: 0,0:57:45.03,0:57:47.70,Default,,0000,0000,0000,,...
Dialogue: 0,0:57:47.70,0:57:49.70,Default,,0000,0000,0000,,...
Dialogue: 0,0:57:49.70,0:57:53.04,Default,,0000,0000,0000,,...
Dialogue: 0,0:57:49.70,0:57:53.04,Default,,0000,0000,0000,,...
Dialogue: 0,0:57:53.04,0:57:56.71,Default,,0000,0000,0000,,Rather than that, Saint Charles
Dialogue: 0,0:57:53.04,0:57:56.71,Default,,0000,0000,0000,,...
Dialogue: 0,0:57:56.71,0:57:58.37,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:57:56.71,0:57:58.37,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:57:58.37,0:58:00.04,Default,,0000,0000,0000,,We're all together here! ➡
Dialogue: 0,0:58:00.04,0:58:03.71,Default,,0000,0000,0000,,...
Dialogue: 0,0:58:00.04,0:58:03.71,Default,,0000,0000,0000,,...
Dialogue: 0,0:58:03.71,0:58:07.05,Default,,0000,0000,0000,,Ағай! ?
Dialogue: 0,0:58:03.71,0:58:07.05,Default,,0000,0000,0000,,...
Dialogue: 0,0:58:07.05,0:58:09.05,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:58:09.05,0:58:12.06,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:58:09.05,0:58:12.06,Default,,0000,0000,0000,,That doesn't make any sense.
Dialogue: 0,0:58:12.06,0:58:14.06,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:58:14.06,0:58:17.06,Default,,0000,0000,0000,,Иә! Ах!
Dialogue: 0,0:58:17.06,0:58:20.00,Default,,0000,0000,0000,,...
Dialogue: 0,0:58:17.06,0:58:20.00,Default,,0000,0000,0000,,～
Dialogue: 0,0:58:20.00,0:58:23.00,Default,,0000,0000,0000,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:58:20.00,0:58:23.00,Default,,0000,0000,0000,,...
Dialogue: 0,0:58:23.00,0:58:25.97,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:58:23.00,0:58:25.97,Default,,0000,0000,0000,,I'll help you.
Dialogue: 0,0:58:28.00,0:58:34.01,Default,,0000,0000,0000,,...
Dialogue: 0,0:58:28.00,0:58:34.01,Default,,0000,0000,0000,,...
Dialogue: 0,0:58:34.01,0:58:37.01,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:58:34.01,0:58:37.01,Default,,0000,0000,0000,,➡
Dialogue: 0,0:58:37.01,0:58:40.02,Default,,0000,0000,0000,,...
Dialogue: 0,0:58:37.01,0:58:40.02,Default,,0000,0000,0000,,...
Dialogue: 0,0:58:40.02,0:58:42.02,Default,,0000,0000,0000,,Қарғыс атсын... ➡
Dialogue: 0,0:58:42.02,0:58:45.02,Default,,0000,0000,0000,,Тенрюжиндер осы дүниенің құдайларына тең.
Dialogue: 0,0:58:45.02,0:58:47.02,Default,,0000,0000,0000,,Түсіндім! ➡
Dialogue: 0,0:58:47.02,0:58:50.03,Default,,0000,0000,0000,,...
Dialogue: 0,0:58:47.02,0:58:50.03,Default,,0000,0000,0000,,➡
Dialogue: 0,0:58:50.03,0:58:51.69,Default,,0000,0000,0000,,➡
Dialogue: 0,0:58:51.69,0:58:56.03,Default,,0000,0000,0000,,...
Dialogue: 0,0:58:51.69,0:58:56.03,Default,,0000,0000,0000,,...
Dialogue: 0,0:58:56.03,0:59:02.04,Default,,0000,0000,0000,,It's the same! ? лас!
Dialogue: 0,0:58:56.03,0:59:02.04,Default,,0000,0000,0000,,...
Dialogue: 0,0:59:02.04,0:59:04.04,Default,,0000,0000,0000,,...
Dialogue: 0,0:59:04.04,0:59:06.01,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:59:09.05,0:59:13.05,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:59:09.05,0:59:13.05,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:59:13.05,0:59:16.72,Default,,0000,0000,0000,,Gobo! Gebo! Апыр-ай!
Dialogue: 0,0:59:16.72,0:59:18.32,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:59:18.32,0:59:23.99,Default,,0000,0000,0000,,Мынадай бірдеңе... Тегін құтылсам ғой...
Dialogue: 0,0:59:18.32,0:59:23.99,Default,,0000,0000,0000,,～➡
Dialogue: 0,0:59:23.99,0:59:25.66,Default,,0000,0000,0000,,Аһ!
Dialogue: 0,0:59:25.66,0:59:29.00,Default,,0000,0000,0000,,...
Dialogue: 0,0:59:25.66,0:59:29.00,Default,,0000,0000,0000,,Қорықпа!
Dialogue: 0,0:59:29.00,0:59:32.00,Default,,0000,0000,0000,,
Dialogue: 0,0:59:32.00,0:59:35.67,Default,,0000,0000,0000,,Ум! Егер сіз мұны жасасаңыз
Dialogue: 0,0:59:32.00,0:59:35.67,Default,,0000,0000,0000,,Бұл жаман!
Dialogue: 0,0:59:35.67,0:59:37.67,Default,,0000,0000,0000,,Тенрюжинге қол тигізсем...
Dialogue: 0,0:59:37.67,0:59:40.01,Default,,0000,0000,0000,,(аудитория)
Dialogue: 0,0:59:37.67,0:59:40.01,Default,,0000,0000,0000,,The world government and navy will attack!
Dialogue: 0,0:59:40.01,0:59:42.01,Default,,0000,0000,0000,,...
Dialogue: 0,0:59:40.01,0:59:42.01,Default,,0000,0000,0000,,...
Dialogue: 0,0:59:42.01,0:59:43.68,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:59:43.68,0:59:46.02,Default,,0000,0000,0000,,I have to go home soon.
Dialogue: 0,0:59:46.02,0:59:49.02,Default,,0000,0000,0000,,Мен қой бағуым керек.
Dialogue: 0,0:59:46.02,0:59:49.02,Default,,0000,0000,0000,,№.
Dialogue: 0,0:59:49.02,0:59:51.02,Default,,0000,0000,0000,,Рахмет! Бұл көңілді болды!
Dialogue: 0,0:59:51.02,0:59:53.69,Default,,0000,0000,0000,,Бір минут күтіңіз.
Dialogue: 0,0:59:51.02,0:59:53.69,Default,,0000,0000,0000,,...
Dialogue: 0,0:59:53.69,0:59:55.36,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:59:55.36,0:59:58.03,Default,,0000,0000,0000,,Why is it painful?
Dialogue: 0,0:59:55.36,0:59:58.03,Default,,0000,0000,0000,,Сіз ауыр өмірге қайта оралғыңыз келе ме? ➡
Dialogue: 0,0:59:58.03,1:00:02.03,Default,,0000,0000,0000,,Мен мұнда бақытты өмір сүре алар едім.
Dialogue: 0,0:59:58.03,1:00:02.03,Default,,0000,0000,0000,,Одан да көп➡
Dialogue: 0,1:00:02.03,1:00:06.04,Default,,0000,0000,0000,,...
Dialogue: 0,1:00:02.03,1:00:06.04,Default,,0000,0000,0000,,Білмейсіз бе?
Dialogue: 0,1:00:06.04,1:00:07.70,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:00:07.70,1:00:11.04,Default,,0000,0000,0000,,Ута-сан, енді бұлай істеме.
Dialogue: 0,1:00:07.70,1:00:11.04,Default,,0000,0000,0000,,...
Dialogue: 0,1:00:11.04,1:00:14.04,Default,,0000,0000,0000,,...
Dialogue: 0,1:00:11.04,1:00:14.04,Default,,0000,0000,0000,,Сен Тенрюжинге көмектесуге келдің бе?
Dialogue: 0,1:00:14.04,1:00:17.05,Default,,0000,0000,0000,,I came to save everyone. ➡
Dialogue: 0,1:00:17.05,1:00:21.99,Default,,0000,0000,0000,,Барлық адамдардың жүрегі
Dialogue: 0,1:00:17.05,1:00:21.99,Default,,0000,0000,0000,,Return it to the real world now!
Dialogue: 0,1:00:21.99,1:00:23.99,Default,,0000,0000,0000,,Полковник Кови?
Dialogue: 0,1:00:23.99,1:00:27.99,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:00:27.99,1:00:30.99,Default,,0000,0000,0000,,Иә? Ол әйгілі адам ма?
Dialogue: 0,1:00:30.99,1:00:36.00,Default,,0000,0000,0000,,...
Dialogue: 0,1:00:30.99,1:00:36.00,Default,,0000,0000,0000,,Халықты құтқарған батыр!
Dialogue: 0,1:00:36.00,1:00:40.00,Default,,0000,0000,0000,,...
Dialogue: 0,1:00:36.00,1:00:40.00,Default,,0000,0000,0000,,Өйткені мен үнемі осы Элегияда болдым➡
Dialogue: 0,1:00:40.00,1:00:42.01,Default,,0000,0000,0000,,Кәдімгі жаңалықтар
Dialogue: 0,1:00:40.00,1:00:42.01,Default,,0000,0000,0000,,Мен бұл туралы көп білмеймін.
Dialogue: 0,1:00:42.01,1:00:45.01,Default,,0000,0000,0000,,О, жоқ...
Dialogue: 0,1:00:42.01,1:00:45.01,Default,,0000,0000,0000,,Ей, батыр.
Dialogue: 0,1:00:45.01,1:00:49.01,Default,,0000,0000,0000,,...
Dialogue: 0,1:00:45.01,1:00:49.01,Default,,0000,0000,0000,,...
Dialogue: 0,1:00:49.01,1:00:51.01,Default,,0000,0000,0000,,Иә. ➡
Dialogue: 0,1:00:51.01,1:00:53.02,Default,,0000,0000,0000,,➡
Dialogue: 0,1:00:53.02,1:00:58.02,Default,,0000,0000,0000,,Шын мәнінде, бұл біз өмір сүріп жатқан әлем
Dialogue: 0,1:00:53.02,1:00:58.02,Default,,0000,0000,0000,,...
Dialogue: 0,1:00:58.02,1:01:01.02,Default,,0000,0000,0000,,
Dialogue: 0,1:01:01.02,1:01:04.03,Default,,0000,0000,0000,,
Dialogue: 0,1:01:04.03,1:01:07.03,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,1:01:04.03,1:01:07.03,Default,,0000,0000,0000,,➡
Dialogue: 0,1:01:07.03,1:01:11.03,Default,,0000,0000,0000,,Осы жерден
Dialogue: 0,1:01:07.03,1:01:11.03,Default,,0000,0000,0000,,...
Dialogue: 0,1:01:11.03,1:01:15.04,Default,,0000,0000,0000,,Ута!
Dialogue: 0,1:01:11.03,1:01:15.04,Default,,0000,0000,0000,,Сіз оны шынымен алдап қамап тастадыңыз ба?
Dialogue: 0,1:01:15.04,1:01:18.04,Default,,0000,0000,0000,,...
Dialogue: 0,1:01:15.04,1:01:18.04,Default,,0000,0000,0000,,Мен бәрін алдамаймын!
Dialogue: 0,1:01:18.04,1:01:19.98,Default,,0000,0000,0000,,Жоқ, балалар!
Dialogue: 0,1:01:19.98,1:01:23.98,Default,,0000,0000,0000,,...
Dialogue: 0,1:01:19.98,1:01:23.98,Default,,0000,0000,0000,,Мен сені бақытты болуға бағыттаймын.
Dialogue: 0,1:01:23.98,1:01:26.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:01:26.98,1:01:29.99,Default,,0000,0000,0000,,Бұл
Dialogue: 0,1:01:26.98,1:01:29.99,Default,,0000,0000,0000,,Барлығы осыдан үміттенді.
Dialogue: 0,1:01:29.99,1:01:34.66,Default,,0000,0000,0000,,Ұлы қарақшылар дәуірі аяқталды!
Dialogue: 0,1:01:29.99,1:01:34.66,Default,,0000,0000,0000,,Бейбітшілік пен еркіндік дәуірі келе жатыр!
Dialogue: 0,1:01:34.66,1:01:36.66,Default,,0000,0000,0000,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,1:01:36.66,1:01:40.00,Default,,0000,0000,0000,,Бұл керемет емес пе?
Dialogue: 0,1:01:36.66,1:01:40.00,Default,,0000,0000,0000,,Көптеген тағамдар мен ойындар! ➡
Dialogue: 0,1:01:40.00,1:01:45.00,Default,,0000,0000,0000,,Ал жан түршігерлік істер жасайтындар
Dialogue: 0,1:01:40.00,1:01:45.00,Default,,0000,0000,0000,,...
Dialogue: 0,1:01:45.00,1:01:47.67,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:01:45.00,1:01:47.67,Default,,0000,0000,0000,,Мен осында өмір сүрсем бақыттырақ болар ма едім?
Dialogue: 0,1:01:47.67,1:01:49.34,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,1:01:49.34,1:01:52.01,Default,,0000,0000,0000,,...
Dialogue: 0,1:01:49.34,1:01:52.01,Default,,0000,0000,0000,,…
Dialogue: 0,1:01:52.01,1:01:56.01,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,1:01:52.01,1:01:56.01,Default,,0000,0000,0000,,Сізге жұмыс істеудің қажеті жоқ.
Dialogue: 0,1:01:56.01,1:01:59.02,Default,,0000,0000,0000,,...
Dialogue: 0,1:01:56.01,1:01:59.02,Default,,0000,0000,0000,,...
Dialogue: 0,1:01:59.02,1:02:03.02,Default,,0000,0000,0000,,...
Dialogue: 0,1:01:59.02,1:02:03.02,Default,,0000,0000,0000,,...
Dialogue: 0,1:02:03.02,1:02:05.02,Default,,0000,0000,0000,,...
Dialogue: 0,1:02:05.02,1:02:07.02,Default,,0000,0000,0000,,(аудитория)
Dialogue: 0,1:02:05.02,1:02:07.02,Default,,0000,0000,0000,,Қоғам мүлде өзгереді...
Dialogue: 0,1:02:07.02,1:02:10.03,Default,,0000,0000,0000,,Мен үлгере алмауым мүмкін.
Dialogue: 0,1:02:07.02,1:02:10.03,Default,,0000,0000,0000,,...
Dialogue: 0,1:02:10.03,1:02:13.03,Default,,0000,0000,0000,,Ута-сан
Dialogue: 0,1:02:10.03,1:02:13.03,Default,,0000,0000,0000,,Жоспарлардан бас тарту керек….
Dialogue: 0,1:02:13.03,1:02:15.03,Default,,0000,0000,0000,,Бір минут күтіңіз! барлығы! ➡
Dialogue: 0,1:02:15.03,1:02:18.03,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,1:02:15.03,1:02:18.03,Default,,0000,0000,0000,,Бостан болғың келмеді ме?
Dialogue: 0,1:02:18.03,1:02:21.97,Default,,0000,0000,0000,,...
Dialogue: 0,1:02:18.03,1:02:21.97,Default,,0000,0000,0000,,Бостандыққа шығамын дегеніңіз өтірік болды ма?
Dialogue: 0,1:02:21.97,1:02:24.97,Default,,0000,0000,0000,,Күн сайын қарақшылардан қорқудың қажеті жоқ
Dialogue: 0,1:02:21.97,1:02:24.97,Default,,0000,0000,0000,,Сіз мұны қалайтыныңызды айттыңыз!
Dialogue: 0,1:02:24.97,1:02:27.98,Default,,0000,0000,0000,,...
Dialogue: 0,1:02:27.98,1:02:29.65,Default,,0000,0000,0000,,Аа...
Dialogue: 0,1:02:29.65,1:02:31.31,Default,,0000,0000,0000,,Тоқта! Юта бұл➡
Dialogue: 0,1:02:31.31,1:02:32.98,Default,,0000,0000,0000,,Барлығына арналған
Dialogue: 0,1:02:31.31,1:02:32.98,Default,,0000,0000,0000,,Ол мен үшін істеп жатыр.
Dialogue: 0,1:02:32.98,1:02:34.98,Default,,0000,0000,0000,,Мен сұрамадым!
Dialogue: 0,1:02:32.98,1:02:34.98,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,1:02:34.98,1:02:36.99,Default,,0000,0000,0000,,Сіз өте шулысыз!
Dialogue: 0,1:02:34.98,1:02:36.99,Default,,0000,0000,0000,,Мен Ютамен келісемін.
Dialogue: 0,1:02:36.99,1:02:39.99,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,1:02:36.99,1:02:39.99,Default,,0000,0000,0000,,Мен мектепті жақсы көремін!
Dialogue: 0,1:02:39.99,1:02:42.99,Default,,0000,0000,0000,,Бұл маңызды емес, солай ма?
Dialogue: 0,1:02:39.99,1:02:42.99,Default,,0000,0000,0000,,Бұл маңызды емес!
Dialogue: 0,1:02:42.99,1:02:44.99,Default,,0000,0000,0000,,Бұл тым көп, Ута!
Dialogue: 0,1:02:42.99,1:02:44.99,Default,,0000,0000,0000,,Қорқынышты!
Dialogue: 0,1:02:44.99,1:02:47.00,Default,,0000,0000,0000,,А? Эй, бұл жігіт.
Dialogue: 0,1:02:47.00,1:02:51.00,Default,,0000,0000,0000,,Түсіндім!
Dialogue: 0,1:02:47.00,1:02:51.00,Default,,0000,0000,0000,,Кешіріңіз! Мен оны түсіндім! ➡
Dialogue: 0,1:02:51.00,1:02:55.00,Default,,0000,0000,0000,,Егер одан да қызықты нәрсе болса
Dialogue: 0,1:02:51.00,1:02:55.00,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,1:02:55.00,1:02:57.97,Default,,0000,0000,0000,,(Көрермендердің айқайы)
Dialogue: 0,1:03:02.01,1:03:06.98,Default,,0000,0000,0000,,Қараңдар! Енді бәрі
Dialogue: 0,1:03:02.01,1:03:06.98,Default,,0000,0000,0000,,Бұл қызық болады, солай ма?
Dialogue: 0,1:03:14.02,1:03:18.03,Default,,0000,0000,0000,,Барлығына!
Dialogue: 0,1:03:14.02,1:03:18.03,Default,,0000,0000,0000,,Бейбітшілік пен еркіндіктің жаңа дәуірінде➡
Dialogue: 0,1:03:18.03,1:03:20.96,Default,,0000,0000,0000,,Мәңгілік бірге бақытты өмір сүрейік!
Dialogue: 0,1:03:20.96,1:03:23.97,Default,,0000,0000,0000,,Эй!
Dialogue: 0,1:03:23.97,1:03:25.64,Default,,0000,0000,0000,,Әулие Чарльз!
Dialogue: 0,1:03:25.64,1:03:28.97,Default,,0000,0000,0000,,Бұдан артық құрбандық жасау мүмкін емес.
Dialogue: 0,1:03:25.64,1:03:28.97,Default,,0000,0000,0000,,Мен шешім қабылдауым керек.
Dialogue: 0,1:03:28.97,1:03:31.94,Default,,0000,0000,0000,,Мақал-мәтел
Dialogue: 0,1:03:28.97,1:03:31.94,Default,,0000,0000,0000,,Тэнрюджиннің қатысы болса да...
Dialogue: 0,1:03:38.98,1:03:42.99,Default,,0000,0000,0000,,Уф...
Dialogue: 0,1:03:38.98,1:03:42.99,Default,,0000,0000,0000,,Хмм… мм… мм!
Dialogue: 0,1:03:42.99,1:03:44.99,Default,,0000,0000,0000,,Мен қашып үлгердім, бірақ...
Dialogue: 0,1:03:44.99,1:03:47.99,Default,,0000,0000,0000,,Сіз кімсіз? ?
Dialogue: 0,1:03:44.99,1:03:47.99,Default,,0000,0000,0000,,Бруно.
Dialogue: 0,1:03:47.99,1:03:50.99,Default,,0000,0000,0000,,Коби: Сіз Ютамен кездестіңіз бе?
Dialogue: 0,1:03:47.99,1:03:50.99,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,1:03:50.99,1:03:53.00,Default,,0000,0000,0000,,Шамасы
Dialogue: 0,1:03:50.99,1:03:53.00,Default,,0000,0000,0000,,Сіздің сендіруіңіз сәтсіз болған сияқты.
Dialogue: 0,1:03:53.00,1:03:55.00,Default,,0000,0000,0000,,(Ранпа) Зұлымдар Альянсы, иә? Тамаша! Кел, байқап көрейік!
Dialogue: 0,1:03:53.00,1:03:55.00,Default,,0000,0000,0000,,Қараңыз.
Dialogue: 0,1:03:55.00,1:03:57.00,Default,,0000,0000,0000,,(Қарақшылар рухы)
Dialogue: 0,1:03:57.00,1:04:00.00,Default,,0000,0000,0000,,Күте тұрыңыз Мугиварато
Dialogue: 0,1:03:57.00,1:04:00.00,Default,,0000,0000,0000,,Қол ұстасу дегенді естімеппін.
Dialogue: 0,1:04:00.00,1:04:03.01,Default,,0000,0000,0000,,Өлсем де кешір.
Dialogue: 0,1:04:00.00,1:04:03.01,Default,,0000,0000,0000,,Сонда кездескенше.
Dialogue: 0,1:04:03.01,1:04:05.01,Default,,0000,0000,0000,,Мені жайбарақаттармен бірге қоспа
Dialogue: 0,1:04:03.01,1:04:05.01,Default,,0000,0000,0000,,Утаны жеңу➡
Dialogue: 0,1:04:05.01,1:04:09.01,Default,,0000,0000,0000,,Мен қалағанымды істеймін.
Dialogue: 0,1:04:05.01,1:04:09.01,Default,,0000,0000,0000,,Күн шуақты….
Dialogue: 0,1:04:09.01,1:04:12.01,Default,,0000,0000,0000,,Менің достарым кім?
Dialogue: 0,1:04:09.01,1:04:12.01,Default,,0000,0000,0000,,Ол әлі оралған жоқ.
Dialogue: 0,1:04:12.01,1:04:15.02,Default,,0000,0000,0000,,Олар Утаның әлсіздігін анықтады.
Dialogue: 0,1:04:12.01,1:04:15.02,Default,,0000,0000,0000,,Мені табуларыңыз керек➡
Dialogue: 0,1:04:15.02,1:04:17.02,Default,,0000,0000,0000,,Бұл жарыс емес.
Dialogue: 0,1:04:15.02,1:04:17.02,Default,,0000,0000,0000,,Ах.
Dialogue: 0,1:04:17.02,1:04:20.02,Default,,0000,0000,0000,,Door Door қабілеті де осы денеде...
Dialogue: 0,1:04:20.02,1:04:22.02,Default,,0000,0000,0000,,Жарайды, әлгі балалар.
Dialogue: 0,1:04:22.02,1:04:27.03,Default,,0000,0000,0000,,Домалау
Dialogue: 0,1:04:22.02,1:04:27.03,Default,,0000,0000,0000,,Каякубоши
Dialogue: 0,1:04:22.02,1:04:27.03,Default,,0000,0000,0000,,Айналмалы зеңбірек жұлдызы! ➡
Dialogue: 0,1:04:27.03,1:04:31.03,Default,,0000,0000,0000,,Гвуууух!
Dialogue: 0,1:04:27.03,1:04:31.03,Default,,0000,0000,0000,,«Адамдардың үрейі, адамдардың абдырап қалуы➡
Dialogue: 0,1:04:31.03,1:04:35.97,Default,,0000,0000,0000,,Totto Musica атымен
Dialogue: 0,1:04:31.03,1:04:35.97,Default,,0000,0000,0000,,Қорқып, қашып кет».
Dialogue: 0,1:04:35.97,1:04:37.97,Default,,0000,0000,0000,,Кунг-фу нүктесі!
Dialogue: 0,1:04:35.97,1:04:37.97,Default,,0000,0000,0000,,Вататата!
Dialogue: 0,1:04:37.97,1:04:39.94,Default,,0000,0000,0000,,Мираж
Dialogue: 0,1:04:37.97,1:04:39.94,Default,,0000,0000,0000,,Мираж = Темп!
Dialogue: 0,1:04:45.98,1:04:49.99,Default,,0000,0000,0000,,Джамбуды өшіру
Dialogue: 0,1:04:45.98,1:04:49.99,Default,,0000,0000,0000,,Ібіліс стиліндегі аяқтар!
Dialogue: 0,1:04:45.98,1:04:49.99,Default,,0000,0000,0000,,Кольер
Dialogue: 0,1:04:45.98,1:04:49.99,Default,,0000,0000,0000,,Мойын еті ереуіл!
Dialogue: 0,1:04:49.99,1:04:51.95,Default,,0000,0000,0000,,Баки
Dialogue: 0,1:04:49.99,1:04:51.95,Default,,0000,0000,0000,,Итто-рю Умаони!
Dialogue: 0,1:04:55.99,1:04:59.96,Default,,0000,0000,0000,,
Dialogue: 0,1:04:55.99,1:04:59.96,Default,,0000,0000,0000,,Жан
Dialogue: 0,1:04:55.99,1:04:59.96,Default,,0000,0000,0000,,«Мұз күйі» жан шеруі!
Dialogue: 0,1:05:02.00,1:05:06.00,Default,,0000,0000,0000,,Самеда Шутеи
Dialogue: 0,1:05:02.00,1:05:06.00,Default,,0000,0000,0000,,Балықшы каратэ Самеда алақан табаны!
Dialogue: 0,1:05:06.00,1:05:11.01,Default,,0000,0000,0000,,(Фрэнки)
Dialogue: 0,1:05:06.00,1:05:11.01,Default,,0000,0000,0000,,Үлкен слалом
Dialogue: 0,1:05:06.00,1:05:11.01,Default,,0000,0000,0000,,Радикалды сәуленің гигант айналымы!
Dialogue: 0,1:05:11.01,1:05:13.01,Default,,0000,0000,0000,,Сұмдық, құлап бара жатыр!
Dialogue: 0,1:05:13.01,1:05:16.01,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,1:05:13.01,1:05:16.01,Default,,0000,0000,0000,,Жарқылдап жасаған!
Dialogue: 0,1:05:16.01,1:05:18.98,Default,,0000,0000,0000,,Кешіріңіз!
Dialogue: 0,1:05:22.02,1:05:26.02,Default,,0000,0000,0000,,Сені тірідей көмеді!
Dialogue: 0,1:05:22.02,1:05:26.02,Default,,0000,0000,0000,,Әй, мен тірідей көмілген сияқтымын!
Dialogue: 0,1:05:26.02,1:05:28.99,Default,,0000,0000,0000,,Робин осылай!
Dialogue: 0,1:05:26.02,1:05:28.99,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,1:05:31.03,1:05:33.03,Default,,0000,0000,0000,,Брюли!
Dialogue: 0,1:05:31.03,1:05:33.03,Default,,0000,0000,0000,,Сіз сондасыз, солай ма?
Dialogue: 0,1:05:33.03,1:05:36.00,Default,,0000,0000,0000,,Мило әлемі
Dialogue: 0,1:05:33.03,1:05:36.00,Default,,0000,0000,0000,,Айнаға салып, айна әлеміне кір!
Dialogue: 0,1:05:37.97,1:05:39.97,Default,,0000,0000,0000,,Мені назардан тыс қалдырмаңыз!
Dialogue: 0,1:05:37.97,1:05:39.97,Default,,0000,0000,0000,,Бұл ақпаратсыз➡
Dialogue: 0,1:05:39.97,1:05:41.97,Default,,0000,0000,0000,,Сіз және басқалар
Dialogue: 0,1:05:39.97,1:05:41.97,Default,,0000,0000,0000,,Утаутаның шынайы әлемінен no Mi ➡
Dialogue: 0,1:05:41.97,1:05:44.97,Default,,0000,0000,0000,,Сіз кете алмайсыз.
Dialogue: 0,1:05:41.97,1:05:44.97,Default,,0000,0000,0000,,Құрметті отбасыңыз бен достарыңызға➡
Dialogue: 0,1:05:44.97,1:05:46.98,Default,,0000,0000,0000,,Біз енді ешқашан кездеспейміз.
Dialogue: 0,1:05:44.97,1:05:46.98,Default,,0000,0000,0000,,Жарайды! ?
Dialogue: 0,1:05:46.98,1:05:48.98,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,1:05:46.98,1:05:48.98,Default,,0000,0000,0000,,Кя!
Dialogue: 0,1:05:48.98,1:05:51.98,Default,,0000,0000,0000,,Катакури-оний-чан үшін де?
Dialogue: 0,1:05:48.98,1:05:51.98,Default,,0000,0000,0000,,Не? Иә.
Dialogue: 0,1:05:51.98,1:05:53.95,Default,,0000,0000,0000,,Уф...!
Dialogue: 0,1:06:06.00,1:06:08.00,Default,,0000,0000,0000,,Бәрің аман болдыңдар ма?
Dialogue: 0,1:06:08.00,1:06:10.00,Default,,0000,0000,0000,,Луффи~!
Dialogue: 0,1:06:08.00,1:06:10.00,Default,,0000,0000,0000,,Күн шуақты!
Dialogue: 0,1:06:10.00,1:06:12.00,Default,,0000,0000,0000,,Уф!
Dialogue: 0,1:06:12.00,1:06:15.00,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,1:06:12.00,1:06:15.00,Default,,0000,0000,0000,,Бұл күн шуақты.
Dialogue: 0,1:06:15.00,1:06:17.01,Default,,0000,0000,0000,,​​О?
Dialogue: 0,1:06:15.00,1:06:17.01,Default,,0000,0000,0000,,Сүйкімді!
Dialogue: 0,1:06:17.01,1:06:19.01,Default,,0000,0000,0000,,Сіз қандай түрлендіру жасадыңыз? ?
Dialogue: 0,1:06:19.01,1:06:22.01,Default,,0000,0000,0000,,Tsk
Dialogue: 0,1:06:19.01,1:06:22.01,Default,,0000,0000,0000,,Егер мен қайтып оралуым керек болса ше?
Dialogue: 0,1:06:22.01,1:06:24.01,Default,,0000,0000,0000,,Кешіріңіз, пешші жігіт.
Dialogue: 0,1:06:24.01,1:06:28.02,Default,,0000,0000,0000,,Робин
Dialogue: 0,1:06:24.01,1:06:28.02,Default,,0000,0000,0000,,Ютаны қалай жеңуге болатынын білдіңіз бе?
Dialogue: 0,1:06:28.02,1:06:32.02,Default,,0000,0000,0000,,Ежелгі жазбалар бойынша
Dialogue: 0,1:06:28.02,1:06:32.02,Default,,0000,0000,0000,,Утаута әлеміне қабылданғандар➡
Dialogue: 0,1:06:32.02,1:06:34.96,Default,,0000,0000,0000,,Өз күшімен
Dialogue: 0,1:06:32.02,1:06:34.96,Default,,0000,0000,0000,,Сіз шындыққа орала алмайсыз.
Dialogue: 0,1:06:34.96,1:06:36.96,Default,,0000,0000,0000,,Мүлдем.
Dialogue: 0,1:06:36.96,1:06:38.96,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,1:06:36.96,1:06:38.96,Default,,0000,0000,0000,,Алайда➡
Dialogue: 0,1:06:38.96,1:06:41.96,Default,,0000,0000,0000,,Utauta no Mi қабілеті барлар
Dialogue: 0,1:06:38.96,1:06:41.96,Default,,0000,0000,0000,,Totto Musica➡ қолдансаңыз
Dialogue: 0,1:06:41.96,1:06:44.97,Default,,0000,0000,0000,,Мүмкіндіктер келеді.
Dialogue: 0,1:06:41.96,1:06:44.97,Default,,0000,0000,0000,,Тот музыка?
Dialogue: 0,1:06:44.97,1:06:48.97,Default,,0000,0000,0000,,Көне заманнан жалғасы
Dialogue: 0,1:06:44.97,1:06:48.97,Default,,0000,0000,0000,,Адамдардың ойларының жинағы. ➡
Dialogue: 0,1:06:48.97,1:06:52.98,Default,,0000,0000,0000,,Жалғыздық, қиыншылық, т.б.
Dialogue: 0,1:06:48.97,1:06:52.98,Default,,0000,0000,0000,,Жүрегіме түскен көлеңке➡
Dialogue: 0,1:06:52.98,1:06:56.98,Default,,0000,0000,0000,,Кейде жын патшасы деп те аталады.
Dialogue: 0,1:06:52.98,1:06:56.98,Default,,0000,0000,0000,,Бұл қару ма?
Dialogue: 0,1:06:56.98,1:07:00.98,Default,,0000,0000,0000,,Тек қол тигізбеу керек нәрселер
Dialogue: 0,1:06:56.98,1:07:00.98,Default,,0000,0000,0000,,Мен оны оқи алмаймын.
Dialogue: 0,1:07:00.98,1:07:04.99,Default,,0000,0000,0000,,Бұл тыйым
Dialogue: 0,1:07:00.98,1:07:04.99,Default,,0000,0000,0000,,Утаута Mi қабілеті жоқ біреу қолданған кезде➡
Dialogue: 0,1:07:04.99,1:07:06.99,Default,,0000,0000,0000,,Мүмкіндіктер қандай?
Dialogue: 0,1:07:04.99,1:07:06.99,Default,,0000,0000,0000,,Жазбаларға сәйкес➡
Dialogue: 0,1:07:06.99,1:07:09.99,Default,,0000,0000,0000,,Totto Musica қолдану
Dialogue: 0,1:07:06.99,1:07:09.99,Default,,0000,0000,0000,,Шақырылған жын патшасы➡
Dialogue: 0,1:07:09.99,1:07:13.00,Default,,0000,0000,0000,,Осы Утаута жемісі арқылы
Dialogue: 0,1:07:09.99,1:07:13.00,Default,,0000,0000,0000,,Тек Utaworld емес➡
Dialogue: 0,1:07:13.00,1:07:17.00,Default,,0000,0000,0000,,Шынайы әлемде
Dialogue: 0,1:07:13.00,1:07:17.00,Default,,0000,0000,0000,,Ол өзін көрсеткісі келетін сияқты. ➡
Dialogue: 0,1:07:17.00,1:07:19.00,Default,,0000,0000,0000,,Сондықтан, жын патшасын байланыс нүктесі ретінде пайдалану➡
Dialogue: 0,1:07:19.00,1:07:22.00,Default,,0000,0000,0000,,Утаәлем және шындық
Dialogue: 0,1:07:19.00,1:07:22.00,Default,,0000,0000,0000,,Олар бір-бірімен байланысқан сияқты. ➡
Dialogue: 0,1:07:22.00,1:07:27.01,Default,,0000,0000,0000,,Ол кезде екі дүниенің жын патшасы
Dialogue: 0,1:07:22.00,1:07:27.01,Default,,0000,0000,0000,,Егер сіз бір уақытта шабуыл жасасаңыз➡
Dialogue: 0,1:07:27.01,1:07:31.01,Default,,0000,0000,0000,,Жын патшасын жеңу
Dialogue: 0,1:07:27.01,1:07:31.01,Default,,0000,0000,0000,,Utaworld өшірілуі мүмкін.
Dialogue: 0,1:07:31.01,1:07:32.68,Default,,0000,0000,0000,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,1:07:32.68,1:07:35.95,Default,,0000,0000,0000,,Өйткені ол жақсы жұмыс істеді
Dialogue: 0,1:07:32.68,1:07:35.95,Default,,0000,0000,0000,,Сіз оны рекорд ретінде қалдырдыңыз, солай ма?
Dialogue: 0,1:07:35.95,1:07:38.92,Default,,0000,0000,0000,,Тек тырысу керек.
Dialogue: 0,1:07:35.95,1:07:38.92,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:07:40.96,1:07:43.96,Default,,0000,0000,0000,,Уау...
Dialogue: 0,1:07:40.96,1:07:43.96,Default,,0000,0000,0000,,Бірақ нақты әлемде➡
Dialogue: 0,1:07:43.96,1:07:45.96,Default,,0000,0000,0000,,Ута-самаға кім шабуыл жасайды?
Dialogue: 0,1:07:45.96,1:07:49.97,Default,,0000,0000,0000,,Шынында да, бәріміз
Dialogue: 0,1:07:45.96,1:07:49.97,Default,,0000,0000,0000,,Ұйқысыз дүниедемін.
Dialogue: 0,1:07:49.97,1:07:51.97,Default,,0000,0000,0000,,Нақты әлемдегі Юта
Dialogue: 0,1:07:49.97,1:07:51.97,Default,,0000,0000,0000,,Егер шабуыл жасай алсаңыз➡
Dialogue: 0,1:07:51.97,1:07:53.97,Default,,0000,0000,0000,,Әскери-теңіз күштері?
Dialogue: 0,1:07:51.97,1:07:53.97,Default,,0000,0000,0000,,Бұл мүмкін емес. ➡
Dialogue: 0,1:07:53.97,1:07:56.97,Default,,0000,0000,0000,,Қарапайым азаматтар бар болғанша
Dialogue: 0,1:07:53.97,1:07:56.97,Default,,0000,0000,0000,,Сіз оны ұстай алмайсыз.
Dialogue: 0,1:07:56.97,1:08:00.98,Default,,0000,0000,0000,,Ақпаратыңыз үшін рахмет.
Dialogue: 0,1:07:56.97,1:08:00.98,Default,,0000,0000,0000,,Шынайы әлемде біреу болуы керек...
Dialogue: 0,1:08:00.98,1:08:03.98,Default,,0000,0000,0000,,⚟Бір адам бар.
Dialogue: 0,1:08:00.98,1:08:03.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:08:03.98,1:08:07.98,Default,,0000,0000,0000,,Капитан!
Dialogue: 0,1:08:07.98,1:08:10.99,Default,,0000,0000,0000,,Bepo? Бұл не?
Dialogue: 0,1:08:07.98,1:08:10.99,Default,,0000,0000,0000,,Ал ол кім? Сол қария.
Dialogue: 0,1:08:10.99,1:08:13.99,Default,,0000,0000,0000,,Ута-саманың патронаттық ата-анасы
Dialogue: 0,1:08:10.99,1:08:13.99,Default,,0000,0000,0000,,Гордон мырза.
Dialogue: 0,1:08:13.99,1:08:15.99,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,1:08:13.99,1:08:15.99,Default,,0000,0000,0000,,Ута-Чандікі?
Dialogue: 0,1:08:15.99,1:08:18.99,Default,,0000,0000,0000,,Эй
Dialogue: 0,1:08:15.99,1:08:18.99,Default,,0000,0000,0000,,Бір адам дегенді қалай түсінесіңдер?
Dialogue: 0,1:08:18.99,1:08:21.00,Default,,0000,0000,0000,,Шенкс.
Dialogue: 0,1:08:18.99,1:08:21.00,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,1:08:21.00,1:08:24.00,Default,,0000,0000,0000,,Шенкс?
Dialogue: 0,1:08:21.00,1:08:24.00,Default,,0000,0000,0000,,Егер Шенкс келсе➡
Dialogue: 0,1:08:24.00,1:08:27.00,Default,,0000,0000,0000,,Нақты әлемдегі Юта
Dialogue: 0,1:08:24.00,1:08:27.00,Default,,0000,0000,0000,,Олар сені тоқтататынына сенімдімін.
Dialogue: 0,1:08:27.00,1:08:31.01,Default,,0000,0000,0000,,Шэнкс пен Ютаға қарт
Dialogue: 0,1:08:27.00,1:08:31.01,Default,,0000,0000,0000,,Шынымен бірдеңе болды ма?
Dialogue: 0,1:08:31.01,1:08:34.01,Default,,0000,0000,0000,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,1:08:34.01,1:08:35.98,Default,,0000,0000,0000,,Қария!
Dialogue: 0,1:08:37.95,1:08:41.95,Default,,0000,0000,0000,,А, бұл ақылсыз!
Dialogue: 0,1:08:37.95,1:08:41.95,Default,,0000,0000,0000,,Мен Ута-самаға бардым!
Dialogue: 0,1:08:41.95,1:08:43.95,Default,,0000,0000,0000,,Мен әлі жеңген жоқпын!
Dialogue: 0,1:08:43.95,1:08:45.96,Default,,0000,0000,0000,,Оны тоқтатудың қажеті жоқ.
Dialogue: 0,1:08:43.95,1:08:45.96,Default,,0000,0000,0000,,Менің капитаным.
Dialogue: 0,1:08:45.96,1:08:49.96,Default,,0000,0000,0000,,Менің бәрібір уақытым жоқ.
Dialogue: 0,1:08:45.96,1:08:49.96,Default,,0000,0000,0000,,Жүр, оны да жинап алайық.
Dialogue: 0,1:08:49.96,1:08:51.96,Default,,0000,0000,0000,,Бірақ қалай?
Dialogue: 0,1:08:51.96,1:08:55.97,Default,,0000,0000,0000,,Бір мезгілде шабуыл жасау қажет болса
Dialogue: 0,1:08:51.96,1:08:55.97,Default,,0000,0000,0000,,Тек шабуылды жалғастырыңыз.
Dialogue: 0,1:08:55.97,1:09:00.97,Default,,0000,0000,0000,,Шабуыл нақты әлемде басталады
Dialogue: 0,1:08:55.97,1:09:00.97,Default,,0000,0000,0000,,Уақыт менімен сәйкес келгенше.
Dialogue: 0,1:09:00.97,1:09:03.97,Default,,0000,0000,0000,,О
Dialogue: 0,1:09:00.97,1:09:03.97,Default,,0000,0000,0000,,Мен қатты қорықтым, сондай аяныштымын!
Dialogue: 0,1:09:03.97,1:09:07.98,Default,,0000,0000,0000,,Саман қалпақ қарақшылары осында болса ғой
Dialogue: 0,1:09:03.97,1:09:07.98,Default,,0000,0000,0000,,Өзіңізді жоғалтқыңыз келмейді!
Dialogue: 0,1:09:07.98,1:09:10.98,Default,,0000,0000,0000,,Бізде мұны істеуден басқа амал жоқ!
Dialogue: 0,1:09:07.98,1:09:10.98,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:09:10.98,1:09:13.95,Default,,0000,0000,0000,,Айтпақшы, бұл не?
Dialogue: 0,1:09:10.98,1:09:13.95,Default,,0000,0000,0000,,Тым кеш пе?
Dialogue: 0,1:09:32.94,1:09:35.94,Default,,0000,0000,0000,,«Мен ол кісіге берген уәдемді орындай алмадым».
Dialogue: 0,1:09:32.94,1:09:35.94,Default,,0000,0000,0000,,Мурой
Dialogue: 0,1:09:32.94,1:09:35.94,Default,,0000,0000,0000,,«Бұл қауіпті, бұл қауіпті, Мурой-сан!»
Dialogue: 0,1:09:35.94,1:09:37.94,Default,,0000,0000,0000,,«Бірдеңе болды!»
Dialogue: 0,1:09:35.94,1:09:37.94,Default,,0000,0000,0000,,«Күте!»
Dialogue: 0,1:09:37.94,1:09:40.91,Default,,0000,0000,0000,,«Таңғажайып мәйіт.
Dialogue: 0,1:09:37.94,1:09:40.91,Default,,0000,0000,0000,,Сіз таптыңыз, Мурой мырза».
Dialogue: 0,1:09:42.95,1:09:45.92,Default,,0000,0000,0000,,«Бұл да Мурой мырзаның ісі».
Dialogue: 0,1:10:01.96,1:10:06.90,Default,,0000,0000,0000,,Сен не үшін келдің? Қанша төбелессек те
Dialogue: 0,1:10:01.96,1:10:06.90,Default,,0000,0000,0000,,Сен мені жеңе алмайсың.
Dialogue: 0,1:10:06.90,1:10:11.87,Default,,0000,0000,0000,,Бұл әлі шешілген жоқ.
Dialogue: 0,1:10:06.90,1:10:11.87,Default,,0000,0000,0000,,Мен жеңілгеніме қынжыламын!
Dialogue: 0,1:10:14.91,1:10:18.91,Default,,0000,0000,0000,,Олай болса, бұрынғы кездегідей.
Dialogue: 0,1:10:14.91,1:10:18.91,Default,,0000,0000,0000,,Бізде күресуден басқа амал жоқ, Луффи.
Dialogue: 0,1:10:18.91,1:10:20.88,Default,,0000,0000,0000,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,1:10:31.93,1:10:35.90,Default,,0000,0000,0000,,Оооооооооуу!
Dialogue: 0,1:10:38.93,1:10:41.94,Default,,0000,0000,0000,,Олар қосымша күш әкелді.
Dialogue: 0,1:10:41.94,1:10:43.91,Default,,0000,0000,0000,,Менің соғу ойым болмаса да.
Dialogue: 0,1:10:48.94,1:10:52.95,Default,,0000,0000,0000,,Сіз қателесесіз!
Dialogue: 0,1:10:48.94,1:10:52.95,Default,,0000,0000,0000,,Бұл Луффи.
Dialogue: 0,1:10:52.95,1:10:58.95,Default,,0000,0000,0000,,Мен шынымен түсінбеймін.
Dialogue: 0,1:10:52.95,1:10:58.95,Default,,0000,0000,0000,,Ұлы қарақшылардың дәуірі аяқталды.
Dialogue: 0,1:10:58.95,1:11:01.96,Default,,0000,0000,0000,,Неге сонша?
Dialogue: 0,1:10:58.95,1:11:01.96,Default,,0000,0000,0000,,Сіз қарақшылардың патшасы болғыңыз келе ме?
Dialogue: 0,1:11:01.96,1:11:03.96,Default,,0000,0000,0000,,Жаңа дәуір құру.
Dialogue: 0,1:11:03.96,1:11:06.96,Default,,0000,0000,0000,,Қарғыс атсын... Луффи!
Dialogue: 0,1:11:06.96,1:11:08.93,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:11:11.97,1:11:16.97,Default,,0000,0000,0000,,Роджердің өлім жазасына кесілуінен басталды
Dialogue: 0,1:11:11.97,1:11:16.97,Default,,0000,0000,0000,,Ұлы қарақшылар дәуірі.
Dialogue: 0,1:11:16.97,1:11:20.98,Default,,0000,0000,0000,,Луффи, сіздің өліміңізбен.
Dialogue: 0,1:11:16.97,1:11:20.98,Default,,0000,0000,0000,,Аяқтаңыз!
Dialogue: 0,1:11:20.98,1:11:23.98,Default,,0000,0000,0000,,Тоқта...
Dialogue: 0,1:11:23.98,1:11:26.98,Default,,0000,0000,0000,,Ута~! !
Dialogue: 0,1:11:26.98,1:11:29.99,Default,,0000,0000,0000,,Сіз! Сонша…➡
Dialogue: 0,1:11:29.99,1:11:33.99,Default,,0000,0000,0000,,Қанша қызыл шашты қарақшылар
Dialogue: 0,1:11:29.99,1:11:33.99,Default,,0000,0000,0000,,Сізге ұнады!
Dialogue: 0,1:11:33.99,1:11:36.99,Default,,0000,0000,0000,,Шенкс
Dialogue: 0,1:11:33.99,1:11:36.99,Default,,0000,0000,0000,,Сізге ұнады!
Dialogue: 0,1:11:36.99,1:11:40.00,Default,,0000,0000,0000,,Неліктен қарақшыларды жек көрдің!
Dialogue: 0,1:11:40.00,1:11:42.00,Default,,0000,0000,0000,,(теңіз құстарының айқайы)
Dialogue: 0,1:11:42.00,1:11:45.00,Default,,0000,0000,0000,,Бұл Шэнкстің кінәсі.
Dialogue: 0,1:11:42.00,1:11:45.00,Default,,0000,0000,0000,,Аа...
Dialogue: 0,1:11:45.00,1:11:50.01,Default,,0000,0000,0000,,
Dialogue: 0,1:11:45.00,1:11:50.01,Default,,0000,0000,0000,,Мен Шенкс туралы айтып отырмын...➡
Dialogue: 0,1:11:50.01,1:11:52.98,Default,,0000,0000,0000,,Мен оны нағыз әкем деп ойладым!
Dialogue: 0,1:12:00.02,1:12:04.95,Default,,0000,0000,0000,,Мен, сол кеме және менің серіктерім.
Dialogue: 0,1:12:00.02,1:12:04.95,Default,,0000,0000,0000,,Мен барлығын отбасы деп ойладым. ➡
Dialogue: 0,1:12:04.95,1:12:08.96,Default,,0000,0000,0000,,Бірақ бұл
Dialogue: 0,1:12:04.95,1:12:08.96,Default,,0000,0000,0000,,Бұл оларға өтірік болды. ➡
Dialogue: 0,1:12:08.96,1:12:12.96,Default,,0000,0000,0000,,Сонымен Шенкс
Dialogue: 0,1:12:08.96,1:12:12.96,Default,,0000,0000,0000,,Сен мені тастап кеттің. ➡
Dialogue: 0,1:12:12.96,1:12:15.96,Default,,0000,0000,0000,,Бұл элегияда И
Dialogue: 0,1:12:12.96,1:12:15.96,Default,,0000,0000,0000,,Ол мені жалғыз қалдырды!
Dialogue: 0,1:12:15.96,1:12:19.97,Default,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,1:12:15.96,1:12:19.97,Default,,0000,0000,0000,,Әнші болу үшін!
Dialogue: 0,1:12:19.97,1:12:21.97,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:12:21.97,1:12:28.98,Default,,0000,0000,0000,,(Шапалақтау)
Dialogue: 0,1:12:28.98,1:12:33.98,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,1:12:28.98,1:12:33.98,Default,,0000,0000,0000,,Әнші даусыңыз шынында да дүние қазынасы. ➡
Dialogue: 0,1:12:33.98,1:12:38.99,Default,,0000,0000,0000,,Көптеген сарапшылар және
Dialogue: 0,1:12:33.98,1:12:38.99,Default,,0000,0000,0000,,Музыкалық аспаптар Ноталар жинағы. ➡
Dialogue: 0,1:12:38.99,1:12:41.99,Default,,0000,0000,0000,,Сізге бұл элегия ұнайды деп үміттенемін.
Dialogue: 0,1:12:38.99,1:12:41.99,Default,,0000,0000,0000,,Мен сенің қалғаныңды қалаймын! ➡
Dialogue: 0,1:12:41.99,1:12:43.96,Default,,0000,0000,0000,,Біз сізді ел ретінде қарсы аламыз!
Dialogue: 0,1:12:45.99,1:12:49.00,Default,,0000,0000,0000,,Бұл өте қызық көрінді.
Dialogue: 0,1:12:45.99,1:12:49.00,Default,,0000,0000,0000,,Мен осында ән айтып жүрген кезім.
Dialogue: 0,1:12:49.00,1:12:53.00,Default,,0000,0000,0000,,Иә?Иә.
Dialogue: 0,1:12:49.00,1:12:53.00,Default,,0000,0000,0000,,Біздің алдымызда ән айтудан гөрі➡
Dialogue: 0,1:12:53.00,1:12:57.01,Default,,0000,0000,0000,,Көп адамнан сұраған дұрыс
Dialogue: 0,1:12:53.00,1:12:57.01,Default,,0000,0000,0000,,Бұл қызық емес пе?
Dialogue: 0,1:12:57.01,1:13:00.01,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,1:12:57.01,1:13:00.01,Default,,0000,0000,0000,,Сәлем, Юта.
Dialogue: 0,1:13:00.01,1:13:04.01,Default,,0000,0000,0000,,Бұл әлемдегі бейбітшілік
Dialogue: 0,1:13:00.01,1:13:04.01,Default,,0000,0000,0000,,Теңдік деген ұғым жоқ.
Dialogue: 0,1:13:04.01,1:13:06.95,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:13:04.01,1:13:06.95,Default,,0000,0000,0000,,Бірақ ән салатын дауысыңыз➡
Dialogue: 0,1:13:06.95,1:13:10.95,Default,,0000,0000,0000,,Дүниедегі барлық адамдар
Dialogue: 0,1:13:06.95,1:13:10.95,Default,,0000,0000,0000,,Сізді бақытты ете алады.
Dialogue: 0,1:13:10.95,1:13:12.96,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,1:13:10.95,1:13:12.96,Default,,0000,0000,0000,,Жарайды➡
Dialogue: 0,1:13:12.96,1:13:16.96,Default,,0000,0000,0000,,Мен осында қалсам да.
Dialogue: 0,1:13:12.96,1:13:16.96,Default,,0000,0000,0000,,Әлемдегі ең жақсы әнші болған кезде не болады➡
Dialogue: 0,1:13:16.96,1:13:18.96,Default,,0000,0000,0000,,Мен келіп сені алып кетейін.
Dialogue: 0,1:13:16.96,1:13:18.96,Default,,0000,0000,0000,,Идиот!
Dialogue: 0,1:13:18.96,1:13:20.96,Default,,0000,0000,0000,,Мен
Dialogue: 0,1:13:18.96,1:13:20.96,Default,,0000,0000,0000,,Ол қызыл шашты қарақшылар тобының музыканты!
Dialogue: 0,1:13:20.96,1:13:24.97,Default,,0000,0000,0000,,Әндерді оқу және
Dialogue: 0,1:13:20.96,1:13:24.97,Default,,0000,0000,0000,,Шенксті және басқаларды қалдыру➡
Dialogue: 0,1:13:24.97,1:13:26.97,Default,,0000,0000,0000,,Шығу...
Dialogue: 0,1:13:24.97,1:13:26.97,Default,,0000,0000,0000,,Мен көремін. ➡
Dialogue: 0,1:13:26.97,1:13:30.94,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,1:13:26.97,1:13:30.94,Default,,0000,0000,0000,,Мен бұл жерден ертең кетемін.
Dialogue: 0,1:13:32.98,1:13:35.94,Default,,0000,0000,0000,,Бірақ сол түнде...
Dialogue: 0,1:13:41.98,1:13:44.99,Default,,0000,0000,0000,,Гордон мырза?
Dialogue: 0,1:13:44.99,1:13:46.96,Default,,0000,0000,0000,,Сіз ояусыз ба?
Dialogue: 0,1:13:49.99,1:13:54.00,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,1:13:49.99,1:13:54.00,Default,,0000,0000,0000,,Хашанкс! ?
Dialogue: 0,1:13:54.00,1:14:00.00,Default,,0000,0000,0000,,Барлығы ұрланған!
Dialogue: 0,1:13:54.00,1:14:00.00,Default,,0000,0000,0000,,Барлығы... бәрі өлтірілді.
Dialogue: 0,1:14:00.00,1:14:02.00,Default,,0000,0000,0000,,Шенкс! ?
Dialogue: 0,1:14:02.00,1:14:05.94,Default,,0000,0000,0000,,Олар сіздің ән айту дауысыңызды пайдаланып жатыр
Dialogue: 0,1:14:02.00,1:14:05.94,Default,,0000,0000,0000,,Осы элегияға жақындаңыз➡
Dialogue: 0,1:14:05.94,1:14:08.94,Default,,0000,0000,0000,,Жоспар қазынаны ұрлау болды.
Dialogue: 0,1:14:08.94,1:14:12.92,Default,,0000,0000,0000,,Сол жігіттер...
Dialogue: 0,1:14:08.94,1:14:12.92,Default,,0000,0000,0000,,Бұл қызыл шашты қарақшылар.
Dialogue: 0,1:14:15.95,1:14:22.96,Default,,0000,0000,0000,,Сіз де осы уақыт бойы алданып қалдыңыз!
Dialogue: 0,1:14:15.95,1:14:22.96,Default,,0000,0000,0000,,Қызыл шашты қарақшылар мен шұңқырларға!
Dialogue: 0,1:14:22.96,1:14:24.93,Default,,0000,0000,0000,,Уф!
Dialogue: 0,1:14:28.96,1:14:32.97,Default,,0000,0000,0000,,Шенкс~!
Dialogue: 0,1:14:28.96,1:14:32.97,Default,,0000,0000,0000,,Мені артта қалдырма!
Dialogue: 0,1:14:32.97,1:14:34.97,Default,,0000,0000,0000,,Ах! Уф...
Dialogue: 0,1:14:34.97,1:14:37.97,Default,,0000,0000,0000,,(Қызыл шашты қарақшылардың барлық мүшелерінің күлкілері)
Dialogue: 0,1:14:34.97,1:14:37.97,Default,,0000,0000,0000,,Танк шайқасы басталады!
Dialogue: 0,1:14:37.97,1:14:44.98,Default,,0000,0000,0000,,Ах! ! Ах~! ! Ах~! !
Dialogue: 0,1:14:44.98,1:14:46.98,Default,,0000,0000,0000,,Неге...?
Dialogue: 0,1:14:46.98,1:14:49.99,Default,,0000,0000,0000,,Неліктен? !
Dialogue: 0,1:14:46.98,1:14:49.99,Default,,0000,0000,0000,,Танк шайқасы басталады!
Dialogue: 0,1:14:49.99,1:14:53.99,Default,,0000,0000,0000,,Ах! !
Dialogue: 0,1:14:49.99,1:14:53.99,Default,,0000,0000,0000,,Танк шайқасы басталады!
Dialogue: 0,1:14:53.99,1:14:57.96,Default,,0000,0000,0000,,Танк шайқасы басталады!
Dialogue: 0,1:15:05.93,1:15:07.94,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,1:15:07.94,1:15:11.94,Default,,0000,0000,0000,,Шенкс осылай істейтін еді!
Dialogue: 0,1:15:07.94,1:15:11.94,Default,,0000,0000,0000,,Мұны сіз де білесіз!
Dialogue: 0,1:15:11.94,1:15:14.94,Default,,0000,0000,0000,,Сонда менің 12 жасым ше? ➡
Dialogue: 0,1:15:14.94,1:15:16.95,Default,,0000,0000,0000,,Луффи! Тіпті сен➡
Dialogue: 0,1:15:16.95,1:15:18.95,Default,,0000,0000,0000,,Шенкс үшін
Dialogue: 0,1:15:16.95,1:15:18.95,Default,,0000,0000,0000,,Бұл жай ғана құрал!
Dialogue: 0,1:15:18.95,1:15:21.95,Default,,0000,0000,0000,,Шенкс келе жатыр!
Dialogue: 0,1:15:18.95,1:15:21.95,Default,,0000,0000,0000,,Сізге көмектесу үшін бе?
Dialogue: 0,1:15:21.95,1:15:25.95,Default,,0000,0000,0000,,Сізге көмектесу үшін.
Dialogue: 0,1:15:21.95,1:15:25.95,Default,,0000,0000,0000,,Мен? Неліктен?
Dialogue: 0,1:15:25.95,1:15:27.96,Default,,0000,0000,0000,,Менің қызым осылай істеп жатыр➡
Dialogue: 0,1:15:27.96,1:15:31.93,Default,,0000,0000,0000,,Шенкс
Dialogue: 0,1:15:27.96,1:15:31.93,Default,,0000,0000,0000,,Сіз үндемей тұра алмайсыз!
Dialogue: 0,1:15:36.93,1:15:39.94,Default,,0000,0000,0000,,Ол мені тастап кетті ме?
Dialogue: 0,1:15:39.94,1:15:41.94,Default,,0000,0000,0000,,Оның келер жолы жоқ.
Dialogue: 0,1:15:41.94,1:15:46.91,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,1:15:48.94,1:15:52.95,Default,,0000,0000,0000,,Жетер, Луффи.
Dialogue: 0,1:15:52.95,1:15:54.92,Default,,0000,0000,0000,,Қош бол.
Dialogue: 0,1:15:58.95,1:16:00.92,Default,,0000,0000,0000,,Қарғыс атсын... Ха!
Dialogue: 0,1:16:04.96,1:16:10.97,Default,,0000,0000,0000,,Шенкс…. Неліктен?
Dialogue: 0,1:16:10.97,1:16:15.97,Default,,0000,0000,0000,,Біраз уақыттан бері бірінші рет тыңдауға келдім.
Dialogue: 0,1:16:10.97,1:16:15.97,Default,,0000,0000,0000,,Сіздің әніңіз.
Dialogue: 0,1:16:15.97,1:16:18.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:16:18.97,1:16:20.94,Default,,0000,0000,0000,,Уф...
Dialogue: 0,1:16:23.98,1:16:25.95,Default,,0000,0000,0000,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,1:16:27.98,1:16:32.99,Default,,0000,0000,0000,,Ахахаха...!
Dialogue: 0,1:16:27.98,1:16:32.99,Default,,0000,0000,0000,,Ахахаха Ахахаха...! ➡
Dialogue: 0,1:16:32.99,1:16:36.93,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,1:16:32.99,1:16:36.93,Default,,0000,0000,0000,,Жақында менімен➡
Dialogue: 0,1:16:36.93,1:16:38.93,Default,,0000,0000,0000,,Дүние жүзіндегі жанкүйерлер жаңа дәуірді бастайды.
Dialogue: 0,1:16:38.93,1:16:43.90,Default,,0000,0000,0000,,Бұған дейін сіздермен бірге
Dialogue: 0,1:16:38.93,1:16:43.90,Default,,0000,0000,0000,,Өйткені мен бір нәрсені реттегім келді!
Dialogue: 0,1:16:45.93,1:16:49.94,Default,,0000,0000,0000,,Барлығына!
Dialogue: 0,1:16:45.93,1:16:49.94,Default,,0000,0000,0000,,Ең жаман қарақшы осында! ➡
Dialogue: 0,1:16:49.94,1:16:51.91,Default,,0000,0000,0000,,Оны бірге жеңейік!
Dialogue: 0,1:16:55.94,1:16:57.95,Default,,0000,0000,0000,,Шенкс келе ме?
Dialogue: 0,1:16:55.94,1:16:57.95,Default,,0000,0000,0000,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,1:16:57.95,1:16:59.92,Default,,0000,0000,0000,,Қазір!
Dialogue: 0,1:17:01.95,1:17:04.92,Default,,0000,0000,0000,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,1:17:01.95,1:17:04.92,Default,,0000,0000,0000,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,1:17:06.96,1:17:09.96,Default,,0000,0000,0000,,Гуг….
Dialogue: 0,1:17:09.96,1:17:11.93,Default,,0000,0000,0000,,Аһ!
Dialogue: 0,1:17:14.96,1:17:16.97,Default,,0000,0000,0000,,Ха, сен әлі істеп жатырсың ба?
Dialogue: 0,1:17:16.97,1:17:18.97,Default,,0000,0000,0000,,Содан кейін...
Dialogue: 0,1:17:16.97,1:17:18.97,Default,,0000,0000,0000,,(Тыныс алу дыбысы)
Dialogue: 0,1:17:18.97,1:17:21.97,Default,,0000,0000,0000,,♬ «Жаңа дәуір – бұл болашақ».
Dialogue: 0,1:17:21.97,1:17:23.97,Default,,0000,0000,0000,,Осы үш кадрды қайтадан қатар қойып көрсетіңізші.
Dialogue: 0,1:17:21.97,1:17:23.97,Default,,0000,0000,0000,,Ai!
Dialogue: 0,1:17:23.97,1:17:27.98,Default,,0000,0000,0000,,Күн шуақты! Сани...
Dialogue: 0,1:17:27.98,1:17:29.98,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,1:17:27.98,1:17:29.98,Default,,0000,0000,0000,,Күзет пункті
Dialogue: 0,1:17:27.98,1:17:29.98,Default,,0000,0000,0000,,Жүнді күшейту! ➡
Dialogue: 0,1:17:29.98,1:17:33.98,Default,,0000,0000,0000,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,1:17:29.98,1:17:33.98,Default,,0000,0000,0000,,ROOM Shambles!
Dialogue: 0,1:17:33.98,1:17:36.92,Default,,0000,0000,0000,,Тосқауыл шарының дыбысы!
Dialogue: 0,1:17:36.92,1:17:38.92,Default,,0000,0000,0000,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,1:17:36.92,1:17:38.92,Default,,0000,0000,0000,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,1:17:38.92,1:17:43.89,Default,,0000,0000,0000,,Ута-сама
Dialogue: 0,1:17:38.92,1:17:43.89,Default,,0000,0000,0000,,Енді сіздің ән айтатын дауысыңыз сыртқа шықпайды!
Dialogue: 0,1:17:45.93,1:17:48.90,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,1:17:45.93,1:17:48.90,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,1:17:57.94,1:17:59.94,Default,,0000,0000,0000,,Нух... Гааааааааааа!
Dialogue: 0,1:17:59.94,1:18:03.95,Default,,0000,0000,0000,,Күте тұр, Ғабу!
Dialogue: 0,1:17:59.94,1:18:03.95,Default,,0000,0000,0000,,Мен өлсем де тиіспе!
Dialogue: 0,1:18:03.95,1:18:05.91,Default,,0000,0000,0000,,Бұл қылыш не өзі?!➡
Dialogue: 0,1:18:07.95,1:18:10.95,Default,,0000,0000,0000,,Ха! Жоқ! Жоқ! ➡
Dialogue: 0,1:18:10.95,1:18:13.96,Default,,0000,0000,0000,,Қарғыс атсын! Уф...!
Dialogue: 0,1:18:13.96,1:18:17.96,Default,,0000,0000,0000,,Мықты болыңыз!
Dialogue: 0,1:18:13.96,1:18:17.96,Default,,0000,0000,0000,,Жаңа дәуір жақындап қалды! ➡
Dialogue: 0,1:18:17.96,1:18:19.96,Default,,0000,0000,0000,,Уф! Хаха….
Dialogue: 0,1:18:19.96,1:18:24.97,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:18:24.97,1:18:27.97,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:18:24.97,1:18:27.97,Default,,0000,0000,0000,,Әскери-теңіз күштерінің барлық күшін орналастырыңыз➡
Dialogue: 0,1:18:27.97,1:18:31.97,Default,,0000,0000,0000,,Юта өлсін.
Dialogue: 0,1:18:27.97,1:18:31.97,Default,,0000,0000,0000,,Маған аудитория араласса бәрібір! ➡
Dialogue: 0,1:18:31.97,1:18:36.98,Default,,0000,0000,0000,,Енді көп құрбандық жасамайық
Dialogue: 0,1:18:31.97,1:18:36.98,Default,,0000,0000,0000,,Әлемді қорғау үшін!
Dialogue: 0,1:18:36.98,1:18:38.98,Default,,0000,0000,0000,,Жою!
Dialogue: 0,1:18:38.98,1:18:41.98,Default,,0000,0000,0000,,Өзін әділ деп атайтын флот
Dialogue: 0,1:18:38.98,1:18:41.98,Default,,0000,0000,0000,,Сіз бейбіт тұрғындарды өлтіруді жоспарлап отырсыз ба? ➡
Dialogue: 0,1:18:41.98,1:18:43.99,Default,,0000,0000,0000,,Кизару
Dialogue: 0,1:18:41.98,1:18:43.99,Default,,0000,0000,0000,,Кизаруға жауап беріңіз!
Dialogue: 0,1:18:43.99,1:18:47.99,Default,,0000,0000,0000,,Құрбандықсыз әділеттілік және т.б.
Dialogue: 0,1:18:43.99,1:18:47.99,Default,,0000,0000,0000,,Мүмкін емес. ➡
Dialogue: 0,1:18:47.99,1:18:49.99,Default,,0000,0000,0000,,Бұл қиын. ➡
Dialogue: 0,1:18:49.99,1:18:54.00,Default,,0000,0000,0000,,Бір бала тоқтайды
Dialogue: 0,1:18:49.99,1:18:54.00,Default,,0000,0000,0000,,Он мың адамды құрбандыққа шалу.
Dialogue: 0,1:18:54.00,1:18:56.00,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:18:56.00,1:18:58.97,Default,,0000,0000,0000,,Бұтаның магатамасы
Dialogue: 0,1:18:56.00,1:18:58.97,Default,,0000,0000,0000,,Хасшаку Ционг Магатама.
Dialogue: 0,1:19:01.00,1:19:02.97,Default,,0000,0000,0000,,Ура.
Dialogue: 0,1:19:10.01,1:19:15.02,Default,,0000,0000,0000,,Кешіріңіз, мен ата-ана мен бала төбелесінің ортасында қалдым.
Dialogue: 0,1:19:15.02,1:19:17.99,Default,,0000,0000,0000,,Мойынды сыртқа шығармай аласыз ба?
Dialogue: 0,1:19:20.02,1:19:22.02,Default,,0000,0000,0000,,Уф... Уф...
Dialogue: 0,1:19:22.02,1:19:27.03,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,1:19:22.02,1:19:27.03,Default,,0000,0000,0000,,Дүниені иығымызда көтереміз.
Dialogue: 0,1:19:27.03,1:19:29.03,Default,,0000,0000,0000,,Ух... а...
Dialogue: 0,1:19:29.03,1:19:32.00,Default,,0000,0000,0000,,
Dialogue: 0,1:19:29.03,1:19:32.00,Default,,0000,0000,0000,,Сонда да артқа тартпайсың ба?
Dialogue: 0,1:19:34.04,1:19:39.01,Default,,0000,0000,0000,,Мен мұны істей алсам ғой
Dialogue: 0,1:19:34.04,1:19:39.01,Default,,0000,0000,0000,,Бұл көздер әлі де көре алады.
Dialogue: 0,1:19:41.98,1:19:44.98,Default,,0000,0000,0000,,Хонгу мырза….
Dialogue: 0,1:19:44.98,1:19:47.98,Default,,0000,0000,0000,,Шамасы, нақты әлемде
Dialogue: 0,1:19:44.98,1:19:47.98,Default,,0000,0000,0000,,Бірдеңе болып жатқан сияқты.
Dialogue: 0,1:19:47.98,1:19:49.95,Default,,0000,0000,0000,,...
Dialogue: 0,1:19:53.99,1:19:56.99,Default,,0000,0000,0000,,Сіз арша саңырауқұлақтарын жедіңіз бе?
Dialogue: 0,1:19:53.99,1:19:56.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:19:56.99,1:20:00.00,Default,,0000,0000,0000,,Егер сіз оны жесеңіз
Dialogue: 0,1:19:56.99,1:20:00.00,Default,,0000,0000,0000,,Бұл жай ғана ұйықтай алмау емес.
Dialogue: 0,1:20:00.00,1:20:03.00,Default,,0000,0000,0000,,Адамдар қатыгез болады
Dialogue: 0,1:20:00.00,1:20:03.00,Default,,0000,0000,0000,,Сіз тіпті эмоцияларыңызды басқара алмайсыз.
Dialogue: 0,1:20:03.00,1:20:05.00,Default,,0000,0000,0000,,Не? Уау...
Dialogue: 0,1:20:05.00,1:20:08.00,Default,,0000,0000,0000,,Иә! ? Ха! ?
Dialogue: 0,1:20:05.00,1:20:08.00,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,1:20:08.00,1:20:11.01,Default,,0000,0000,0000,,Ах!?
Dialogue: 0,1:20:08.00,1:20:11.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:20:11.01,1:20:14.01,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,1:20:14.01,1:20:18.98,Default,,0000,0000,0000,,Жаман адамдарға жаман белгі
Dialogue: 0,1:20:14.01,1:20:18.98,Default,,0000,0000,0000,,Мен тезірек шешім қабылдауым керек еді.
Dialogue: 0,1:20:21.02,1:20:22.98,Default,,0000,0000,0000,,Ута~!
Dialogue: 0,1:20:26.02,1:20:32.03,Default,,0000,0000,0000,,Өйткені батылдығым жетпеді
Dialogue: 0,1:20:26.02,1:20:32.03,Default,,0000,0000,0000,,Менде мұны қолдануға батылдық бар...
Dialogue: 0,1:20:32.03,1:20:35.00,Default,,0000,0000,0000,,Бірақ бұдан былай тартынбаңыз!
Dialogue: 0,1:20:36.97,1:20:38.97,Default,,0000,0000,0000,,Сақ болыңыз, бұл сол шығар!
Dialogue: 0,1:20:38.97,1:20:41.97,Default,,0000,0000,0000,,♬ (Утаның ән салған дауысы)
Dialogue: 0,1:20:41.97,1:20:44.97,Default,,0000,0000,0000,,Менің тамаша тосқауылым!
Dialogue: 0,1:20:44.97,1:20:48.98,Default,,0000,0000,0000,,♬ (ән айту)
Dialogue: 0,1:20:48.98,1:20:50.98,Default,,0000,0000,0000,,Иә! ? Бұл...
Dialogue: 0,1:20:50.98,1:20:52.98,Default,,0000,0000,0000,,Мен қиындыққа тап болдым.
Dialogue: 0,1:20:52.98,1:20:59.99,Default,,0000,0000,0000,,Мен мұны да дайындадым.
Dialogue: 0,1:20:52.98,1:20:59.99,Default,,0000,0000,0000,,Егер бұл орын алса, мағынасы жоқ.
Dialogue: 0,1:20:59.99,1:21:01.99,Default,,0000,0000,0000,,UTA!
Dialogue: 0,1:21:01.99,1:21:03.99,Default,,0000,0000,0000,,
Dialogue: 0,1:21:01.99,1:21:03.99,Default,,0000,0000,0000,,♬ «Тілектер мен ешқашан сөнбейтін көз жасы»
Dialogue: 0,1:21:03.99,1:21:07.00,Default,,0000,0000,0000,,О, құдай!
Dialogue: 0,1:21:03.99,1:21:07.00,Default,,0000,0000,0000,,іске қосылды.
Dialogue: 0,1:21:07.00,1:21:13.00,Default,,0000,0000,0000,,Утаута ми қабілеті жоқ адам ән айтса,
Dialogue: 0,1:21:07.00,1:21:13.00,Default,,0000,0000,0000,,Ежелгі жын патша заттанады➡
Dialogue: 0,1:21:13.00,1:21:16.00,Default,,0000,0000,0000,,Totto Musica!
Dialogue: 0,1:21:16.00,1:21:22.01,Default,,0000,0000,0000,,Санка
Dialogue: 0,1:21:16.00,1:21:22.01,Default,,0000,0000,0000,,♬ «Өлімді де жоққа шығаратын құтқарылу гимні»
Dialogue: 0,1:21:16.00,1:21:22.01,Default,,0000,0000,0000,,Мәсіх
Dialogue: 0,1:21:16.00,1:21:22.01,Default,,0000,0000,0000,,Құтқарушы көрінді»
Dialogue: 0,1:21:22.01,1:21:24.01,Default,,0000,0000,0000,,Fa~!
Dialogue: 0,1:21:24.01,1:21:30.02,Default,,0000,0000,0000,,Интерференция
Dialogue: 0,1:21:24.01,1:21:30.02,Default,,0000,0000,0000,,♬ «Намазда адасу» ➡
Dialogue: 0,1:21:30.02,1:21:36.96,Default,,0000,0000,0000,,На
Dialogue: 0,1:21:30.02,1:21:36.96,Default,,0000,0000,0000,,♬ «Юй теңіз тыныш болатын болашақты сұрайды» ➡
Dialogue: 0,1:21:36.96,1:21:39.96,Default,,0000,0000,0000,,♬ «Деніңіз таусылғанша ойнаңыз».
Dialogue: 0,1:21:39.96,1:21:41.96,Default,,0000,0000,0000,,Куу….
Dialogue: 0,1:21:41.96,1:21:43.97,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:21:43.97,1:21:51.97,Default,,0000,0000,0000,,♬ «Бәрін нұрландыратын нұр
Dialogue: 0,1:21:43.97,1:21:51.97,Default,,0000,0000,0000,,Муге
Dialogue: 0,1:21:43.97,1:21:51.97,Default,,0000,0000,0000,,Бля бла бла! ”➡
Dialogue: 0,1:21:51.97,1:21:55.98,Default,,0000,0000,0000,,Гоганбюрей
Dialogue: 0,1:21:51.97,1:21:55.98,Default,,0000,0000,0000,,Дококу
Dialogue: 0,1:21:51.97,1:21:55.98,Default,,0000,0000,0000,,♬ «Сол тәкаппар және менсінбейтін айқай».
Dialogue: 0,1:21:55.98,1:21:58.98,Default,,0000,0000,0000,,Уау! Қат!
Dialogue: 0,1:21:55.98,1:21:58.98,Default,,0000,0000,0000,,Хмф! Уау!
Dialogue: 0,1:21:58.98,1:22:01.98,Default,,0000,0000,0000,,
Dialogue: 0,1:21:58.98,1:22:01.98,Default,,0000,0000,0000,,♬ «Енді, хаос дәуірін тоқтатыңыз».
Dialogue: 0,1:22:01.98,1:22:03.99,Default,,0000,0000,0000,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,1:22:01.98,1:22:03.99,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:22:03.99,1:22:05.99,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:22:03.99,1:22:05.99,Default,,0000,0000,0000,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,1:22:05.99,1:22:08.99,Default,,0000,0000,0000,,Иә, иә!
Dialogue: 0,1:22:05.99,1:22:08.99,Default,,0000,0000,0000,,Ой!
Dialogue: 0,1:22:08.99,1:22:10.99,Default,,0000,0000,0000,,
Dialogue: 0,1:22:08.99,1:22:10.99,Default,,0000,0000,0000,,Гекикоу
Dialogue: 0,1:22:08.99,1:22:10.99,Default,,0000,0000,0000,,♬ «Ашулансаң, ән айт» ➡
Dialogue: 0,1:22:10.99,1:22:14.00,Default,,0000,0000,0000,,(Серо) Бастамас бұрын мен бұл жай ғана әуесқой деңгейде болады деп уайымдадым—
Dialogue: 0,1:22:10.99,1:22:14.00,Default,,0000,0000,0000,,Бали пілі
Dialogue: 0,1:22:10.99,1:22:14.00,Default,,0000,0000,0000,,♬ «Қандай қиянат жасаса да
Dialogue: 0,1:22:10.99,1:22:14.00,Default,,0000,0000,0000,,Әнді айту»➡
Dialogue: 0,1:22:14.00,1:22:17.00,Default,,0000,0000,0000,,♬ «Үлкен жарылыс, көрінетін де, көрінбейтін де»
Dialogue: 0,1:22:17.00,1:22:20.00,Default,,0000,0000,0000,,🔊♬ «Мейірімді»
Dialogue: 0,1:22:20.00,1:22:22.00,Default,,0000,0000,0000,,Аудионы өшіру мүмкін емес.
Dialogue: 0,1:22:20.00,1:22:22.00,Default,,0000,0000,0000,,Қоғамдық махаббат хатынан бері —
Dialogue: 0,1:22:22.00,1:22:26.01,Default,,0000,0000,0000,,Оның мағынасы жоқ.
Dialogue: 0,1:22:22.00,1:22:26.01,Default,,0000,0000,0000,,Жын патшасы арқылы➡
Dialogue: 0,1:22:26.01,1:22:27.98,Default,,0000,0000,0000,,Шындық пен Утаәлем
Dialogue: 0,1:22:26.01,1:22:27.98,Default,,0000,0000,0000,,Өйткені олар байланысқан.
Dialogue: 0,1:22:46.93,1:22:49.93,Default,,0000,0000,0000,,Чх!! Барис…!!
Dialogue: 0,1:22:46.93,1:22:49.93,Default,,0000,0000,0000,,Изуко
Dialogue: 0,1:22:46.93,1:22:49.93,Default,,0000,0000,0000,,♬ «Жаңбыр жауған жүрек қайда кетеді?»
Dialogue: 0,1:22:49.93,1:22:51.60,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:22:51.60,1:22:53.94,Default,,0000,0000,0000,,Ута!
Dialogue: 0,1:22:51.60,1:22:53.94,Default,,0000,0000,0000,,Ута, тоқтат!
Dialogue: 0,1:22:53.94,1:22:57.94,Default,,0000,0000,0000,,Юта, сен мені естисің бе?
Dialogue: 0,1:22:53.94,1:22:57.94,Default,,0000,0000,0000,,Бұл дүниеде басқа нәрсе бар!
Dialogue: 0,1:22:57.94,1:22:59.94,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,1:22:59.94,1:23:04.95,Default,,0000,0000,0000,,♬ (Утаның ән салған дауысы)
Dialogue: 0,1:23:04.95,1:23:08.95,Default,,0000,0000,0000,,
Dialogue: 0,1:23:04.95,1:23:08.95,Default,,0000,0000,0000,,♬ «Тіпті өлімді де жоққа шығаратын құтқарылу гимні»
Dialogue: 0,1:23:08.95,1:23:13.92,Default,,0000,0000,0000,,Ооо!
Dialogue: 0,1:23:16.96,1:23:18.96,Default,,0000,0000,0000,,Ута~! !
Dialogue: 0,1:23:18.96,1:23:24.97,Default,,0000,0000,0000,,♬ «Юй теңіз тыныш болатын болашақты сұрайды»
Dialogue: 0,1:23:24.97,1:23:26.97,Default,,0000,0000,0000,,Жоқ! ➡
Dialogue: 0,1:23:26.97,1:23:29.97,Default,,0000,0000,0000,,Хмф! Алыңыз!
Dialogue: 0,1:23:29.97,1:23:33.98,Default,,0000,0000,0000,,Хмм! Мінеки біз! ➡
Dialogue: 0,1:23:33.98,1:23:36.91,Default,,0000,0000,0000,,О, о!
Dialogue: 0,1:23:36.91,1:23:40.92,Default,,0000,0000,0000,,♬ «Ешқандай уайымдамай жасайық»
Dialogue: 0,1:23:36.91,1:23:40.92,Default,,0000,0000,0000,,Бля бла бла! ”➡
Dialogue: 0,1:23:40.92,1:23:45.92,Default,,0000,0000,0000,,♬ «Сол менмен және менсінбей айқай».
Dialogue: 0,1:23:45.92,1:23:47.89,Default,,0000,0000,0000,,Йохо.
Dialogue: 0,1:23:49.92,1:23:51.93,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,1:23:51.93,1:23:57.93,Default,,0000,0000,0000,,Жылу де Насси
Dialogue: 0,1:23:51.93,1:23:57.93,Default,,0000,0000,0000,,Уау! Ыстық ауа жұдырығы!
Dialogue: 0,1:23:57.93,1:23:59.93,Default,,0000,0000,0000,,(барлығы)
Dialogue: 0,1:23:57.93,1:23:59.93,Default,,0000,0000,0000,,Уау! Уау! Уау! Уау!
Dialogue: 0,1:23:59.93,1:24:03.94,Default,,0000,0000,0000,,♬ «Қанша балағаттап айтсаң да,
Dialogue: 0,1:23:59.93,1:24:03.94,Default,,0000,0000,0000,,Әнді айту»➡
Dialogue: 0,1:24:03.94,1:24:05.94,Default,,0000,0000,0000,,♬ «Көрінетін де, көрінбейтін де Үлкен жарылыс»
Dialogue: 0,1:24:05.94,1:24:07.94,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:24:07.94,1:24:09.94,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,1:24:07.94,1:24:09.94,Default,,0000,0000,0000,,《Қандай жаман, шіріген иіс》
Dialogue: 0,1:24:09.94,1:24:11.91,Default,,0000,0000,0000,,Фунуу~!
Dialogue: 0,1:24:13.95,1:24:16.95,Default,,0000,0000,0000,,Ах... Гаха!
Dialogue: 0,1:24:16.95,1:24:20.96,Default,,0000,0000,0000,,Қат! Күткендей, Юта
Dialogue: 0,1:24:16.95,1:24:20.96,Default,,0000,0000,0000,,Бір мезгілде шабуыл жасауымыз керек пе?
Dialogue: 0,1:24:20.96,1:24:22.96,Default,,0000,0000,0000,,Юта ханшайымы!
Dialogue: 0,1:24:22.96,1:24:26.96,Default,,0000,0000,0000,,Барлығын құтқаратын ән айтатын дауыс
Dialogue: 0,1:24:22.96,1:24:26.96,Default,,0000,0000,0000,,Бұл болды!
Dialogue: 0,1:24:26.96,1:24:28.96,Default,,0000,0000,0000,,2-раунд, 1-жекпе-жек
Dialogue: 0,1:24:28.96,1:24:31.97,Default,,0000,0000,0000,,Усоп!
Dialogue: 0,1:24:28.96,1:24:31.97,Default,,0000,0000,0000,,Жарайды. ➡
Dialogue: 0,1:24:31.97,1:24:34.90,Default,,0000,0000,0000,,Totto Musica бізге қалдырыңыз.
Dialogue: 0,1:24:34.90,1:24:37.91,Default,,0000,0000,0000,,Сол себепті!
Dialogue: 0,1:24:34.90,1:24:37.91,Default,,0000,0000,0000,,Ута-чанды жалғыз қалдырмаңыз.
Dialogue: 0,1:24:37.91,1:24:39.91,Default,,0000,0000,0000,,Соқыңыз.
Dialogue: 0,1:24:39.91,1:24:41.88,Default,,0000,0000,0000,,♬ (ән айту)
Dialogue: 0,1:24:43.91,1:24:45.91,Default,,0000,0000,0000,,Хунга!
Dialogue: 0,1:24:45.91,1:24:48.92,Default,,0000,0000,0000,,Мен... Бұл Риппл! Ол Рипплді қолдануда!
Dialogue: 0,1:24:48.92,1:24:52.92,Default,,0000,0000,0000,,Сәлем! Оны қазір естисің, Ута!
Dialogue: 0,1:24:48.92,1:24:52.92,Default,,0000,0000,0000,,Мынадай нәрсе...
Dialogue: 0,1:24:52.92,1:24:54.92,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:24:52.92,1:24:54.92,Default,,0000,0000,0000,,Луффи-сенпай!
Dialogue: 0,1:24:54.92,1:24:56.89,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,1:24:58.93,1:25:01.93,Default,,0000,0000,0000,,Луффи!
Dialogue: 0,1:24:58.93,1:25:01.93,Default,,0000,0000,0000,,Не істеп жатырсың! Кері күрес!
Dialogue: 0,1:25:01.93,1:25:04.90,Default,,0000,0000,0000,,Ута! Тыңдаңыз! !
Dialogue: 0,1:25:07.94,1:25:09.94,Default,,0000,0000,0000,,Юта сөйлесейік...
Dialogue: 0,1:25:09.94,1:25:13.91,Default,,0000,0000,0000,,
Dialogue: 0,1:25:09.94,1:25:13.91,Default,,0000,0000,0000,,Қарақшылармен сөйлесетін ештеңе жоқ!
Dialogue: 0,1:25:18.95,1:25:20.95,Default,,0000,0000,0000,,Қария!
Dialogue: 0,1:25:18.95,1:25:20.95,Default,,0000,0000,0000,,Bepo!
Dialogue: 0,1:25:20.95,1:25:23.95,Default,,0000,0000,0000,,Ютаға… қымбатты дос➡
Dialogue: 0,1:25:23.95,1:25:27.96,Default,,0000,0000,0000,,Тоқтаңдар, екеуің де
Dialogue: 0,1:25:23.95,1:25:27.96,Default,,0000,0000,0000,,Мен сені ренжітуге жол бере алмаймын...
Dialogue: 0,1:25:27.96,1:25:30.96,Default,,0000,0000,0000,,Шенкс
Dialogue: 0,1:25:27.96,1:25:30.96,Default,,0000,0000,0000,,Бұл сенетін нәрсе, солай ма?
Dialogue: 0,1:25:30.96,1:25:33.96,Default,,0000,0000,0000,,Бұл дұрыс емес, Юта.
Dialogue: 0,1:25:30.96,1:25:33.96,Default,,0000,0000,0000,,Бұл өтірік. ➡
Dialogue: 0,1:25:33.96,1:25:36.90,Default,,0000,0000,0000,,Осыдан 12 жыл бұрынғы түн➡
Dialogue: 0,1:25:36.90,1:25:42.90,Default,,0000,0000,0000,,Элегияны кім жойды?
Dialogue: 0,1:25:36.90,1:25:42.90,Default,,0000,0000,0000,,Қызыл шашты қарақшылар емес➡
Dialogue: 0,1:25:42.90,1:25:45.91,Default,,0000,0000,0000,,Бұл Totto Musica.
Dialogue: 0,1:25:45.91,1:25:50.91,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,1:25:45.91,1:25:50.91,Default,,0000,0000,0000,,Мен саған осы уақытқа дейін шындықты айта алмадым...
Dialogue: 0,1:25:50.91,1:25:55.92,Default,,0000,0000,0000,,Есіңде ме?
Dialogue: 0,1:25:50.91,1:25:55.92,Default,,0000,0000,0000,,Сол күнгі кеш туралы. ➡
Dialogue: 0,1:25:55.92,1:25:59.92,Default,,0000,0000,0000,,Сіз Шэнксті бақылайсыз.
Dialogue: 0,1:25:55.92,1:25:59.92,Default,,0000,0000,0000,,Мен білетін музыкалық консерваториядағы адамдар➡
Dialogue: 0,1:25:59.92,1:26:03.93,Default,,0000,0000,0000,,Соңғы мүмкіндік және оларды бірінен соң бірі ән айтуға мәжбүр етті. ➡
Dialogue: 0,1:26:03.93,1:26:06.93,Default,,0000,0000,0000,,Бұл тамаша мүмкіндік.
Dialogue: 0,1:26:03.93,1:26:06.93,Default,,0000,0000,0000,,Оны халық естісін➡
Dialogue: 0,1:26:06.93,1:26:10.93,Default,,0000,0000,0000,,Сіздің ән айтуыңыз
Dialogue: 0,1:26:06.93,1:26:10.93,Default,,0000,0000,0000,,Бүкіл елге тыңдау үшін жасалды. ➡
Dialogue: 0,1:26:10.93,1:26:14.94,Default,,0000,0000,0000,,Бұл дұрыс емес шығар. ➡
Dialogue: 0,1:26:14.94,1:26:18.94,Default,,0000,0000,0000,,Бұл ән салған дауыс сарайда жер астында.
Dialogue: 0,1:26:14.94,1:26:18.94,Default,,0000,0000,0000,,Жабық нота➡
Dialogue: 0,1:26:18.94,1:26:21.91,Default,,0000,0000,0000,,Мен сені шақырған сияқтымын.
Dialogue: 0,1:26:28.95,1:26:32.95,Default,,0000,0000,0000,,Totto Musica партитурасы➡
Dialogue: 0,1:26:32.95,1:26:36.89,Default,,0000,0000,0000,,Сен білмей тұрып, қасыңда боламын
Dialogue: 0,1:26:32.95,1:26:36.89,Default,,0000,0000,0000,,Бұл болды. ➡
Dialogue: 0,1:26:36.89,1:26:40.90,Default,,0000,0000,0000,,Утаута но Ми қабілетімен
Dialogue: 0,1:26:36.89,1:26:40.90,Default,,0000,0000,0000,,Еркін болу.
Dialogue: 0,1:26:40.90,1:26:43.87,Default,,0000,0000,0000,,(Тыныс алу дыбысы)
Dialogue: 0,1:26:40.90,1:26:43.87,Default,,0000,0000,0000,,О! ?
Dialogue: 0,1:26:46.90,1:26:50.91,Default,,0000,0000,0000,,Нотадағы мөрді бұзған жын патша
Dialogue: 0,1:26:46.90,1:26:50.91,Default,,0000,0000,0000,,Кішкентайыңызды алыңыз➡
Dialogue: 0,1:26:50.91,1:26:55.88,Default,,0000,0000,0000,,Осы елдің халқына
Dialogue: 0,1:26:50.91,1:26:55.88,Default,,0000,0000,0000,,Ол сол билікті пайдалана бастады.
Dialogue: 0,1:26:58.91,1:27:00.92,Default,,0000,0000,0000,,Оян, Ута!
Dialogue: 0,1:27:00.92,1:27:03.92,Default,,0000,0000,0000,,Ішке кірмеңіз!
Dialogue: 0,1:27:00.92,1:27:03.92,Default,,0000,0000,0000,,Шықыр!
Dialogue: 0,1:27:03.92,1:27:05.92,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:27:05.92,1:27:08.92,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:27:08.92,1:27:10.89,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,1:27:17.93,1:27:20.94,Default,,0000,0000,0000,,Сіз әлі жас кезіңізде
Dialogue: 0,1:27:17.93,1:27:20.94,Default,,0000,0000,0000,,Бақытымызға орай. ➡
Dialogue: 0,1:27:20.94,1:27:26.91,Default,,0000,0000,0000,,Күш-қуатым таусылып, ұйықтап қалдым.
Dialogue: 0,1:27:20.94,1:27:26.91,Default,,0000,0000,0000,,Бірақ бұл ел...
Dialogue: 0,1:27:28.94,1:27:30.91,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:27:34.95,1:27:37.95,Default,,0000,0000,0000,,Әскери-теңіз күштері келді ме?
Dialogue: 0,1:27:37.95,1:27:40.96,Default,,0000,0000,0000,,Ютада
Dialogue: 0,1:27:37.95,1:27:40.96,Default,,0000,0000,0000,,Өтінемін, аузыңды жауып қоясың ба? ➡
Dialogue: 0,1:27:40.96,1:27:44.96,Default,,0000,0000,0000,,Адамдарға фактілерді білу тым қатыгездік.
Dialogue: 0,1:27:40.96,1:27:44.96,Default,,0000,0000,0000,,Ах. ➡
Dialogue: 0,1:27:44.96,1:27:49.96,Default,,0000,0000,0000,,Әскери-теңіз күштеріне бұл менің кінәм екенін айтамын.
Dialogue: 0,1:27:44.96,1:27:49.96,Default,,0000,0000,0000,,Жоқ, бұл бізбіз.
Dialogue: 0,1:27:49.96,1:27:54.97,Default,,0000,0000,0000,,Қызыл шашты Шенкс және оның бандасы
Dialogue: 0,1:27:49.96,1:27:54.97,Default,,0000,0000,0000,,Мұны қызыл шашты қарақшылар жасады.
Dialogue: 0,1:27:54.97,1:27:57.97,Default,,0000,0000,0000,,Мұны Ютаға айт.
Dialogue: 0,1:27:57.97,1:27:59.97,Default,,0000,0000,0000,,Сіз сол баланы тастап кетуді жоспарлап отырсыз ба?
Dialogue: 0,1:27:59.97,1:28:04.98,Default,,0000,0000,0000,,Ол жігіттің ән айтуы керемет.
Dialogue: 0,1:27:59.97,1:28:04.98,Default,,0000,0000,0000,,Бізді теңіз флоты қуып келеді➡
Dialogue: 0,1:28:04.98,1:28:07.98,Default,,0000,0000,0000,,Әрбір талант үшін
Dialogue: 0,1:28:04.98,1:28:07.98,Default,,0000,0000,0000,,Біз өзімізді қоршай алмаймыз. ➡
Dialogue: 0,1:28:07.98,1:28:12.99,Default,,0000,0000,0000,,Қолдарыңызбен
Dialogue: 0,1:28:07.98,1:28:12.99,Default,,0000,0000,0000,,Мені ең жақсы әнші етіп тәрбиеле. ➡
Dialogue: 0,1:28:12.99,1:28:15.99,Default,,0000,0000,0000,,Әлгі жігіттің ән айтатын даусының еш кемшілігі жоқ.
Dialogue: 0,1:28:15.99,1:28:18.99,Default,,0000,0000,0000,,Шенкс…. ➡
Dialogue: 0,1:28:18.99,1:28:23.00,Default,,0000,0000,0000,,Түсінікті!
Dialogue: 0,1:28:18.99,1:28:23.00,Default,,0000,0000,0000,,Элегия королі Гордон➡
Dialogue: 0,1:28:23.00,1:28:26.00,Default,,0000,0000,0000,,Сүйікті музыка
Dialogue: 0,1:28:23.00,1:28:26.00,Default,,0000,0000,0000,,Барша халыққа ант берейік! ➡
Dialogue: 0,1:28:26.00,1:28:32.97,Default,,0000,0000,0000,,Ута міндетті түрде әлемді бақытты етеді
Dialogue: 0,1:28:26.00,1:28:32.97,Default,,0000,0000,0000,,Ең жақсы әнші болу үшін өзіңізді көтеріңіз!
Dialogue: 0,1:28:34.94,1:28:40.95,Default,,0000,0000,0000,,Бір-бірімізден алшақ болсақ та
Dialogue: 0,1:28:34.94,1:28:40.95,Default,,0000,0000,0000,,Мәңгі менің қызым боласың. ➡
Dialogue: 0,1:28:40.95,1:28:43.95,Default,,0000,0000,0000,,Ендеше күліп, қоштасайық!
Dialogue: 0,1:28:43.95,1:28:47.96,Default,,0000,0000,0000,,Бұл біздің музыканттар үшін маңызды бастама!
Dialogue: 0,1:28:47.96,1:28:51.96,Default,,0000,0000,0000,,(Барлығы жылайды және күледі)
Dialogue: 0,1:28:51.96,1:28:54.96,Default,,0000,0000,0000,,Юта, сен оны естідің!
Dialogue: 0,1:28:54.96,1:28:56.93,Default,,0000,0000,0000,,Өйткені, Шенкс...
Dialogue: 0,1:29:00.97,1:29:02.94,Default,,0000,0000,0000,,Сен екеуің алда барыңдар!
Dialogue: 0,1:29:04.97,1:29:06.94,Default,,0000,0000,0000,,Ах, гаха!
Dialogue: 0,1:29:12.91,1:29:15.92,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:29:15.92,1:29:18.89,Default,,0000,0000,0000,,Мұны мен жаздым ба?
Dialogue: 0,1:29:23.93,1:29:25.93,Default,,0000,0000,0000,,Дайын!
Dialogue: 0,1:29:23.93,1:29:25.93,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:29:25.93,1:29:27.93,Default,,0000,0000,0000,,Дабыр!
Dialogue: 0,1:29:25.93,1:29:27.93,Default,,0000,0000,0000,,Уау~
Dialogue: 0,1:29:27.93,1:29:30.93,Default,,0000,0000,0000,,Шенкстің сабан қалпағы!
Dialogue: 0,1:29:30.93,1:29:34.87,Default,,0000,0000,0000,,Шляпа?
Dialogue: 0,1:29:30.93,1:29:34.87,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:29:34.87,1:29:38.87,Default,,0000,0000,0000,,Нашар.
Dialogue: 0,1:29:34.87,1:29:38.87,Default,,0000,0000,0000,,Жаңа дәуіріміздің белгісін жасайық!
Dialogue: 0,1:29:38.87,1:29:40.84,Default,,0000,0000,0000,,Мен мұны істеймін. Алыңыз.
Dialogue: 0,1:29:43.88,1:29:46.88,Default,,0000,0000,0000,,Тоқта, Юта.
Dialogue: 0,1:29:46.88,1:29:49.88,Default,,0000,0000,0000,,Бұл тегін емес!
Dialogue: 0,1:29:49.88,1:29:53.89,Default,,0000,0000,0000,,Бұл жаңа дәуір емес!
Dialogue: 0,1:29:53.89,1:29:56.86,Default,,0000,0000,0000,,Сіз бәрінен де жақсы білесіз! !
Dialogue: 0,1:29:59.89,1:30:01.90,Default,,0000,0000,0000,,Луффи….
Dialogue: 0,1:29:59.89,1:30:01.90,Default,,0000,0000,0000,,Ах! Апыр-ай!
Dialogue: 0,1:30:01.90,1:30:03.90,Default,,0000,0000,0000,,Луффи!
Dialogue: 0,1:30:01.90,1:30:03.90,Default,,0000,0000,0000,,тым кеш болды.
Dialogue: 0,1:30:03.90,1:30:05.87,Default,,0000,0000,0000,,(Косей) «Мен музыка дайындау бөлмесіне келсем, сені көремін деп ойладым.»
Dialogue: 0,1:30:11.91,1:30:14.88,Default,,0000,0000,0000,,Бұл не...?
Dialogue: 0,1:30:17.91,1:30:19.91,Default,,0000,0000,0000,,Әй, көшіп бара жатқандар.
Dialogue: 0,1:30:17.91,1:30:19.91,Default,,0000,0000,0000,,Мұнда кел!
Dialogue: 0,1:30:19.91,1:30:22.92,Default,,0000,0000,0000,,Эй!
Dialogue: 0,1:30:19.91,1:30:22.92,Default,,0000,0000,0000,,Мұндай нәрсемен қалай күресуге болады?
Dialogue: 0,1:30:22.92,1:30:26.92,Default,,0000,0000,0000,,Тіпті бір мезгілдегі шабуылдардың уақыты
Dialogue: 0,1:30:22.92,1:30:26.92,Default,,0000,0000,0000,,Түсінгенімді қалаймын...
Dialogue: 0,1:30:26.92,1:30:28.89,Default,,0000,0000,0000,,(Ібілістің айқайы)
Dialogue: 0,1:30:37.87,1:30:39.87,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:30:39.87,1:30:43.87,Default,,0000,0000,0000,,О? Бұл біртүрлі. ➡
Dialogue: 0,1:30:43.87,1:30:48.88,Default,,0000,0000,0000,,Әскери-теңіз күштері бейбіт тұрғындарды өлтіруге әрекеттенді
Dialogue: 0,1:30:43.87,1:30:48.88,Default,,0000,0000,0000,,Қарақшылар оны қалай қорғайды?
Dialogue: 0,1:30:48.88,1:30:53.88,Default,,0000,0000,0000,,Атаулардың мағынасы жоқ.
Dialogue: 0,1:30:48.88,1:30:53.88,Default,,0000,0000,0000,,Оны не үшін қорғау керек?
Dialogue: 0,1:30:53.88,1:30:56.88,Default,,0000,0000,0000,,Тоқтаңдар, екеуің де
Dialogue: 0,1:30:53.88,1:30:56.88,Default,,0000,0000,0000,,Бұл күнәға арланбау үшін. ➡
Dialogue: 0,1:30:56.88,1:30:59.89,Default,,0000,0000,0000,,Қызымызға.
Dialogue: 0,1:30:59.89,1:31:04.89,Default,,0000,0000,0000,,Стейннен алған жарақаттарым әлі толық жазылмағандықтан—
Dialogue: 0,1:30:59.89,1:31:04.89,Default,,0000,0000,0000,,Ешкімнің өлуіне жол берме!
Dialogue: 0,1:31:04.89,1:31:10.87,Default,,0000,0000,0000,,Мұндағы мәселе Жын патшасын тоқтату.
Dialogue: 0,1:31:04.89,1:31:10.87,Default,,0000,0000,0000,,Мүмкін кейінірек.
Dialogue: 0,1:31:12.90,1:31:14.90,Default,,0000,0000,0000,,Юта
Dialogue: 0,1:31:12.90,1:31:14.90,Default,,0000,0000,0000,,Мен арша саңырауқұлағын жедім. ➡
Dialogue: 0,1:31:14.90,1:31:18.87,Default,,0000,0000,0000,,Енді мен Totto Musica-мен интеграцияландым
Dialogue: 0,1:31:14.90,1:31:18.87,Default,,0000,0000,0000,,Оны қалай жеңуге болады...
Dialogue: 0,1:31:20.91,1:31:22.91,Default,,0000,0000,0000,,Uta?
Dialogue: 0,1:31:20.91,1:31:22.91,Default,,0000,0000,0000,,Бұл сенсің. Бұл сенің кінәң. ➡
Dialogue: 0,1:31:22.91,1:31:24.91,Default,,0000,0000,0000,,Сіз мұны жасадыңыз. сенің күнәң.
Dialogue: 0,1:31:24.91,1:31:28.92,Default,,0000,0000,0000,,Шулы!
Dialogue: 0,1:31:24.91,1:31:28.92,Default,,0000,0000,0000,,Мен бәрін білдім. ➡
Dialogue: 0,1:31:28.92,1:31:31.92,Default,,0000,0000,0000,,Бұл барлығына арналған
Dialogue: 0,1:31:28.92,1:31:31.92,Default,,0000,0000,0000,,Әндерді жеткізе бастадым➡
Dialogue: 0,1:31:31.92,1:31:35.86,Default,,0000,0000,0000,,Бір жылдан кейін
Dialogue: 0,1:31:31.92,1:31:35.86,Default,,0000,0000,0000,,Мен оны алдым. ➡
Dialogue: 0,1:31:35.86,1:31:39.86,Default,,0000,0000,0000,,Бейне Денден Муши оқиға болған күннен.
Dialogue: 0,1:31:39.86,1:31:42.86,Default,,0000,0000,0000,,🔊 (Мұғалім) Бұл бейнені көріп отырған адамдар!
Dialogue: 0,1:31:39.86,1:31:42.86,Default,,0000,0000,0000,,Абайлаңыз. ➡
Dialogue: 0,1:31:42.86,1:31:47.87,Default,,0000,0000,0000,,Ута деген қыз қауіпті!
Dialogue: 0,1:31:42.86,1:31:47.87,Default,,0000,0000,0000,,Сол баланың әні дүниені бұзады!
Dialogue: 0,1:31:47.87,1:31:49.87,Default,,0000,0000,0000,,Сол себепті
Dialogue: 0,1:31:47.87,1:31:49.87,Default,,0000,0000,0000,,Енді не істеуім керек? ➡
Dialogue: 0,1:31:49.87,1:31:53.88,Default,,0000,0000,0000,,Дүние жүзіндегі әнім
Dialogue: 0,1:31:49.87,1:31:53.88,Default,,0000,0000,0000,,Адамдар күтіп тұр!
Dialogue: 0,1:31:53.88,1:31:56.88,Default,,0000,0000,0000,,Сәлем Ута-чан
Dialogue: 0,1:31:53.88,1:31:56.88,Default,,0000,0000,0000,,Мен бұл жерден қашқым келеді.
Dialogue: 0,1:31:56.88,1:31:59.88,Default,,0000,0000,0000,,Тек Ута-чанның әндері
Dialogue: 0,1:31:56.88,1:31:59.88,Default,,0000,0000,0000,,Мәңгі тыңдай алатын әлем➡
Dialogue: 0,1:31:59.88,1:32:01.88,Default,,0000,0000,0000,,Мүмкін емес пе?
Dialogue: 0,1:31:59.88,1:32:01.88,Default,,0000,0000,0000,,Иә! ➡
Dialogue: 0,1:32:01.88,1:32:03.89,Default,,0000,0000,0000,,Мен қарақшыларды жек көремін! ➡
Dialogue: 0,1:32:03.89,1:32:06.89,Default,,0000,0000,0000,,Сіз мені таптыңыз
Dialogue: 0,1:32:03.89,1:32:06.89,Default,,0000,0000,0000,,Барлығы үшін!
Dialogue: 0,1:32:06.89,1:32:09.89,Default,,0000,0000,0000,,《Мен енді бұрыла алмаймын...》
Dialogue: 0,1:32:09.89,1:32:13.90,Default,,0000,0000,0000,,Жаңа дәуір!
Dialogue: 0,1:32:09.89,1:32:13.90,Default,,0000,0000,0000,,Уау.
Dialogue: 0,1:32:13.90,1:32:16.90,Default,,0000,0000,0000,,Жылу ешкі
Dialogue: 0,1:32:13.90,1:32:16.90,Default,,0000,0000,0000,,Жылы ешкі! ➡
Dialogue: 0,1:32:16.90,1:32:19.90,Default,,0000,0000,0000,,Уф... Уф... ➡
Dialogue: 0,1:32:19.90,1:32:22.90,Default,,0000,0000,0000,,Гах!
Dialogue: 0,1:32:19.90,1:32:22.90,Default,,0000,0000,0000,,Пеш аға!
Dialogue: 0,1:32:22.90,1:32:26.91,Default,,0000,0000,0000,,Бұл оңай-ақ болар, иә? Хех, хе-хех, хе
Dialogue: 0,1:32:22.90,1:32:26.91,Default,,0000,0000,0000,,Иә...! ?
Dialogue: 0,1:32:26.91,1:32:29.91,Default,,0000,0000,0000,,Ханымға
Dialogue: 0,1:32:26.91,1:32:29.91,Default,,0000,0000,0000,,Мен сені ренжітуге жол бере алмаймын.
Dialogue: 0,1:32:29.91,1:32:31.91,Default,,0000,0000,0000,,Аа...
Dialogue: 0,1:32:29.91,1:32:31.91,Default,,0000,0000,0000,,Және➡
Dialogue: 0,1:32:31.91,1:32:36.85,Default,,0000,0000,0000,,Тек сіз жасай алатын нәрсе бар.
Dialogue: 0,1:32:31.91,1:32:36.85,Default,,0000,0000,0000,,Уф… Ах…
Dialogue: 0,1:32:36.85,1:32:38.85,Default,,0000,0000,0000,,Коби Команданы қабылдаңыз!
Dialogue: 0,1:32:38.85,1:32:43.86,Default,,0000,0000,0000,,Иә! Қорғаныс қалыптастыру!
Dialogue: 0,1:32:38.85,1:32:43.86,Default,,0000,0000,0000,,Көрермендерді қорғау – біздің басты міндетіміз. ➡
Dialogue: 0,1:32:43.86,1:32:46.86,Default,,0000,0000,0000,,Нами мен Робин
Dialogue: 0,1:32:43.86,1:32:46.86,Default,,0000,0000,0000,,Эвакуация үшін сап түзіңіз! ➡
Dialogue: 0,1:32:46.86,1:32:49.86,Default,,0000,0000,0000,,Құрметті көрермендер
Dialogue: 0,1:32:46.86,1:32:49.86,Default,,0000,0000,0000,,Сабырланып, айнаға қара! ➡
Dialogue: 0,1:32:49.86,1:32:54.87,Default,,0000,0000,0000,,Брюли мырза - бұл кілт!
Dialogue: 0,1:32:49.86,1:32:54.87,Default,,0000,0000,0000,,Бруно мен басқаларды қалдырмаңыз және күзетіңіз! ➡
Dialogue: 0,1:32:54.87,1:32:56.87,Default,,0000,0000,0000,,Фрэнкимен
Dialogue: 0,1:32:54.87,1:32:56.87,Default,,0000,0000,0000,,Джинби – бүйірлік күзетші. ➡
Dialogue: 0,1:32:56.87,1:33:00.88,Default,,0000,0000,0000,,Чоппер және Луффи
Dialogue: 0,1:32:56.87,1:33:00.88,Default,,0000,0000,0000,,Гордон мырзаны қорғаңыз. ➡
Dialogue: 0,1:33:00.88,1:33:02.88,Default,,0000,0000,0000,,Мен және Хельмеппо да
Dialogue: 0,1:33:00.88,1:33:02.88,Default,,0000,0000,0000,,Бүйірлік қорғанысты енгізіңіз. ➡
Dialogue: 0,1:33:02.88,1:33:05.88,Default,,0000,0000,0000,,Усоп мырза
Dialogue: 0,1:33:02.88,1:33:05.88,Default,,0000,0000,0000,,Артқы жақтан атыс тірегі➡
Dialogue: 0,1:33:05.88,1:33:08.88,Default,,0000,0000,0000,,Брук пен Санджи мырза
Dialogue: 0,1:33:05.88,1:33:08.88,Default,,0000,0000,0000,,Қорғанысқа бағытталған авангард! ➡
Dialogue: 0,1:33:08.88,1:33:11.89,Default,,0000,0000,0000,,Зоро – авангардты орталықтандыратын шабуыл➡
Dialogue: 0,1:33:11.89,1:33:14.89,Default,,0000,0000,0000,,Ал мистер Овен мен Лоу мырзаға.
Dialogue: 0,1:33:11.89,1:33:14.89,Default,,0000,0000,0000,,Мен мұны сізге қалдырамын!
Dialogue: 0,1:33:14.89,1:33:17.86,Default,,0000,0000,0000,,Аа... Бастаймыз ба?
Dialogue: 0,1:33:19.89,1:33:24.87,Default,,0000,0000,0000,,(Фрэнки)
Dialogue: 0,1:33:19.89,1:33:24.87,Default,,0000,0000,0000,,Фрэнки зымыран ұшырғышы!
Dialogue: 0,1:33:27.90,1:33:32.91,Default,,0000,0000,0000,,Дәмді Дәмді Дәмді
Dialogue: 0,1:33:27.90,1:33:32.91,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:33:32.91,1:33:35.88,Default,,0000,0000,0000,,Зевс Бриз қарқыны!
Dialogue: 0,1:33:37.85,1:33:39.85,Default,,0000,0000,0000,,ROOM!
Dialogue: 0,1:33:39.85,1:33:41.85,Default,,0000,0000,0000,,Не!
Dialogue: 0,1:33:39.85,1:33:41.85,Default,,0000,0000,0000,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,1:33:41.85,1:33:44.85,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:33:41.85,1:33:44.85,Default,,0000,0000,0000,,Ута Бұл менің кінәм болды! ➡
Dialogue: 0,1:33:44.85,1:33:48.86,Default,,0000,0000,0000,,Өз қабілеттеріңізден қорқу
Dialogue: 0,1:33:44.85,1:33:48.86,Default,,0000,0000,0000,,Мен өзімді көпшілік алдында көрсету мүмкіндігінен айырылдым. ➡
Dialogue: 0,1:33:48.86,1:33:53.86,Default,,0000,0000,0000,,Ал... және мен
Dialogue: 0,1:33:48.86,1:33:53.86,Default,,0000,0000,0000,,Музыканы жақсы көретін адам ретінде➡
Dialogue: 0,1:33:53.86,1:33:57.87,Default,,0000,0000,0000,,Totto Musica ноталары
Dialogue: 0,1:33:53.86,1:33:57.87,Default,,0000,0000,0000,,Мен оны тастай да алмадым.
Dialogue: 0,1:33:57.87,1:34:00.87,Default,,0000,0000,0000,,Мен... Мен ақымақпын!
Dialogue: 0,1:34:00.87,1:34:04.87,Default,,0000,0000,0000,,Дәлел келтіріңіз
Dialogue: 0,1:34:00.87,1:34:04.87,Default,,0000,0000,0000,,Ол қашып кеткен.
Dialogue: 0,1:34:04.87,1:34:06.87,Default,,0000,0000,0000,,Жаза тек менікі...
Dialogue: 0,1:34:06.87,1:34:10.88,Default,,0000,0000,0000,,Менің әкем әрқашан жақсы.
Dialogue: 0,1:34:06.87,1:34:10.88,Default,,0000,0000,0000,,Сен мені жалғыз қалдырдың. ➡
Dialogue: 0,1:34:10.88,1:34:15.88,Default,,0000,0000,0000,,Бірақ сіз Юта ханшайымының қасындасыз.
Dialogue: 0,1:34:10.88,1:34:15.88,Default,,0000,0000,0000,,Сен менімен бірге болдың, солай ма?
Dialogue: 0,1:34:15.88,1:34:18.89,Default,,0000,0000,0000,,
Dialogue: 0,1:34:15.88,1:34:18.89,Default,,0000,0000,0000,,Елің ойран болса да антыңды сақта...
Dialogue: 0,1:34:18.89,1:34:20.89,Default,,0000,0000,0000,,Сіз таңданарлықсыз!
Dialogue: 0,1:34:20.89,1:34:22.86,Default,,0000,0000,0000,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,1:34:24.89,1:34:26.89,Default,,0000,0000,0000,,Жарайды, мен барамын.
Dialogue: 0,1:34:24.89,1:34:26.89,Default,,0000,0000,0000,,Луффи...
Dialogue: 0,1:34:26.89,1:34:29.90,Default,,0000,0000,0000,,Луффи-кун! Мына қыздың ән айтатын дауысы➡
Dialogue: 0,1:34:29.90,1:34:35.84,Default,,0000,0000,0000,,Дүние жүзіндегі барлық адамдарды бақытты ететін күш
Dialogue: 0,1:34:29.90,1:34:35.84,Default,,0000,0000,0000,,Менде бар. ➡
Dialogue: 0,1:34:35.84,1:34:39.84,Default,,0000,0000,0000,,Бірақ бұл?
Dialogue: 0,1:34:35.84,1:34:39.84,Default,,0000,0000,0000,,Бұл бала өте ақымақ болды!
Dialogue: 0,1:34:39.84,1:34:45.85,Default,,0000,0000,0000,,Өтінемін!
Dialogue: 0,1:34:39.84,1:34:45.85,Default,,0000,0000,0000,,Луффи-кун, Утаны құтқар!
Dialogue: 0,1:34:45.85,1:34:47.82,Default,,0000,0000,0000,,Бұл анық.
Dialogue: 0,1:34:49.85,1:34:52.85,Default,,0000,0000,0000,,Луффи-сан!
Dialogue: 0,1:34:49.85,1:34:52.85,Default,,0000,0000,0000,,Мені жіберіңізші! ➡
Dialogue: 0,1:34:52.85,1:34:58.86,Default,,0000,0000,0000,,Көп уақыт қалды!
Dialogue: 0,1:34:52.85,1:34:58.86,Default,,0000,0000,0000,,Оны жасамасаң, шындыққа қайта орала алмайсың!
Dialogue: 0,1:34:58.86,1:35:01.86,Default,,0000,0000,0000,,Мен... Бұл Риппл! Ол Рипплді қолдануда!
Dialogue: 0,1:35:01.86,1:35:06.87,Default,,0000,0000,0000,,Джиджи... Уау!
Dialogue: 0,1:35:06.87,1:35:10.87,Default,,0000,0000,0000,,Гаха!
Dialogue: 0,1:35:06.87,1:35:10.87,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,1:35:10.87,1:35:27.89,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:35:27.89,1:35:29.89,Default,,0000,0000,0000,,Қызыл шаш! ➡
Dialogue: 0,1:35:29.89,1:35:33.89,Default,,0000,0000,0000,,Бір мезгілде шабуыл жасау қажет.
Dialogue: 0,1:35:29.89,1:35:33.89,Default,,0000,0000,0000,,Ұйқы әлемімен бір мезгілде➡
Dialogue: 0,1:35:33.89,1:35:36.86,Default,,0000,0000,0000,,Бір жерде шабуыл жасау.
Dialogue: 0,1:35:38.90,1:35:40.90,Default,,0000,0000,0000,,
Dialogue: 0,1:35:38.90,1:35:40.90,Default,,0000,0000,0000,,Үлкен Ананың ұлының мәні неде?
Dialogue: 0,1:35:40.90,1:35:44.87,Default,,0000,0000,0000,,Мен апама көмектесуге келдім!
Dialogue: 0,1:35:51.91,1:35:53.91,Default,,0000,0000,0000,,Кенбуншоку Хакимен➡
Dialogue: 0,1:35:53.91,1:35:56.92,Default,,0000,0000,0000,,Басқа әлемде
Dialogue: 0,1:35:53.91,1:35:56.92,Default,,0000,0000,0000,,Бір сәт апамның не қарап тұрғанын байқадым. ➡
Dialogue: 0,1:35:56.92,1:35:59.92,Default,,0000,0000,0000,,Осыған
Dialogue: 0,1:35:56.92,1:35:59.92,Default,,0000,0000,0000,,Ол жағы мен мына жағы...
Dialogue: 0,1:35:59.92,1:36:01.92,Default,,0000,0000,0000,,Мен білемін. ➡
Dialogue: 0,1:36:01.92,1:36:04.93,Default,,0000,0000,0000,,Кенбуншоку Хаки қолданушысы
Dialogue: 0,1:36:01.92,1:36:04.93,Default,,0000,0000,0000,,Сіз жалғыз емессіз.
Dialogue: 0,1:36:04.93,1:36:08.93,Default,,0000,0000,0000,,Бірақ оның әлі көп жолы бар!
Dialogue: 0,1:36:04.93,1:36:08.93,Default,,0000,0000,0000,,Сабыр сақтай алмайсың!
Dialogue: 0,1:36:08.93,1:36:11.93,Default,,0000,0000,0000,,Бірақ Катакури
Dialogue: 0,1:36:08.93,1:36:11.93,Default,,0000,0000,0000,,Келгендеріңізге рахмет. ➡
Dialogue: 0,1:36:11.93,1:36:14.94,Default,,0000,0000,0000,,Әскери-теңіз күштері
Dialogue: 0,1:36:11.93,1:36:14.94,Default,,0000,0000,0000,,Менің қолым құтқару жұмыстарына толы.
Dialogue: 0,1:36:14.94,1:36:16.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:36:16.94,1:36:19.94,Default,,0000,0000,0000,,Өтінемін, тыныш отыра аласыз ба?
Dialogue: 0,1:36:19.94,1:36:21.94,Default,,0000,0000,0000,,Мм.
Dialogue: 0,1:36:21.94,1:36:25.95,Default,,0000,0000,0000,,Уау! !
Dialogue: 0,1:36:25.95,1:36:27.92,Default,,0000,0000,0000,,Танжиро! Сақ бол!
Dialogue: 0,1:36:29.95,1:36:31.95,Default,,0000,0000,0000,,О!
Dialogue: 0,1:36:31.95,1:36:34.89,Default,,0000,0000,0000,,Луффи?
Dialogue: 0,1:36:31.95,1:36:34.89,Default,,0000,0000,0000,,Шенкс!
Dialogue: 0,1:36:34.89,1:36:37.89,Default,,0000,0000,0000,,Бұл жұмыс істеді!
Dialogue: 0,1:36:34.89,1:36:37.89,Default,,0000,0000,0000,,Бұл нақты әлеммен бір уақытта болды!
Dialogue: 0,1:36:37.89,1:36:41.86,Default,,0000,0000,0000,,Оооооооооуу! !
Dialogue: 0,1:36:44.90,1:36:46.90,Default,,0000,0000,0000,,Дұрыс, болды!
Dialogue: 0,1:36:44.90,1:36:46.90,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:36:46.90,1:36:49.90,Default,,0000,0000,0000,,Ха! ? Теме!
Dialogue: 0,1:36:49.90,1:36:53.87,Default,,0000,0000,0000,,Рокудо
Dialogue: 0,1:36:49.90,1:36:53.87,Default,,0000,0000,0000,,Азалия
Dialogue: 0,1:36:49.90,1:36:53.87,Default,,0000,0000,0000,,Үш қылыш стиліндегі құпия әдіс: алты жолдың Цудзи!
Dialogue: 0,1:36:55.91,1:36:57.91,Default,,0000,0000,0000,,Оны кесуге болмайды!
Dialogue: 0,1:36:57.91,1:37:02.92,Default,,0000,0000,0000,,Адамдарды таптау
Dialogue: 0,1:36:57.91,1:37:02.92,Default,,0000,0000,0000,,Әлгі қарғыс атқыр қылышшы! Есіңізде болсын!
Dialogue: 0,1:37:02.92,1:37:05.92,Default,,0000,0000,0000,,Менің уақытым жоқ!
Dialogue: 0,1:37:05.92,1:37:08.92,Default,,0000,0000,0000,,Tsk! Ах!
Dialogue: 0,1:37:08.92,1:37:13.93,Default,,0000,0000,0000,,Қарғыс атсын... тым болмаса сол мүшелер.
Dialogue: 0,1:37:08.92,1:37:13.93,Default,,0000,0000,0000,,Менің қолымнан бірдеңе келсе ғой! ➡
Dialogue: 0,1:37:13.93,1:37:17.93,Default,,0000,0000,0000,,Жоқ, күте тұрыңыз, капитан Усоп
Dialogue: 0,1:37:13.93,1:37:17.93,Default,,0000,0000,0000,,Осындай кезде сабыр сақтаңыз! ➡
Dialogue: 0,1:37:17.93,1:37:20.94,Default,,0000,0000,0000,,Ммммммм….
Dialogue: 0,1:37:20.94,1:37:23.94,Default,,0000,0000,0000,,Ха! әке! ?
Dialogue: 0,1:37:23.94,1:37:26.91,Default,,0000,0000,0000,,Ақымақ балам, түсіндің бе?
Dialogue: 0,1:37:31.95,1:37:34.88,Default,,0000,0000,0000,,Мен оны көріп тұрмын!
Dialogue: 0,1:37:31.95,1:37:34.88,Default,,0000,0000,0000,,Әкем қарап тұрған табиғат!
Dialogue: 0,1:37:34.88,1:37:37.89,Default,,0000,0000,0000,,Луффи~! !
Dialogue: 0,1:37:37.89,1:37:42.89,Default,,0000,0000,0000,,Уши, бейбақтар!
Dialogue: 0,1:37:37.89,1:37:42.89,Default,,0000,0000,0000,,Қуаныңыз! !
Dialogue: 0,1:37:42.89,1:37:44.56,Default,,0000,0000,0000,,О!
Dialogue: 0,1:37:44.56,1:37:47.90,Default,,0000,0000,0000,,Жарайсыңдар, бейбақтар.
Dialogue: 0,1:37:44.56,1:37:47.90,Default,,0000,0000,0000,,Қуаныңыз!
Dialogue: 0,1:37:47.90,1:37:50.86,Default,,0000,0000,0000,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,1:37:53.90,1:37:56.90,Default,,0000,0000,0000,,Мен Тотто Мюзиканың аяқ-қолын тоқтатамын!
Dialogue: 0,1:37:56.90,1:37:59.91,Default,,0000,0000,0000,,Нұсқауларды орындаңыз.
Dialogue: 0,1:37:56.90,1:37:59.91,Default,,0000,0000,0000,,Оң аяғыңыздан бастаңыз!
Dialogue: 0,1:37:59.91,1:38:01.88,Default,,0000,0000,0000,,Оң аяқ!
Dialogue: 0,1:38:04.91,1:38:06.91,Default,,0000,0000,0000,,Ооооо!
Dialogue: 0,1:38:06.91,1:38:08.88,Default,,0000,0000,0000,,Хах.
Dialogue: 0,1:38:11.92,1:38:14.89,Default,,0000,0000,0000,,Мен... Бұл Риппл! Ол Рипплді қолдануда!
Dialogue: 0,1:38:11.92,1:38:14.89,Default,,0000,0000,0000,,《Қандай жаман, шіріген иіс》
Dialogue: 0,1:38:16.92,1:38:18.93,Default,,0000,0000,0000,,Сол қол!
Dialogue: 0,1:38:16.92,1:38:18.93,Default,,0000,0000,0000,,Сол қол!
Dialogue: 0,1:38:18.93,1:38:20.90,Default,,0000,0000,0000,,Хааах!
Dialogue: 0,1:38:24.93,1:38:26.93,Default,,0000,0000,0000,,Дааааа!
Dialogue: 0,1:38:26.93,1:38:29.94,Default,,0000,0000,0000,,Бұл тістерімді қақыратады, ақымақ! Ал, ал да кет.
Dialogue: 0,1:38:26.93,1:38:29.94,Default,,0000,0000,0000,,Дааааааааааааа! ➡
Dialogue: 0,1:38:29.94,1:38:31.94,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,1:38:31.94,1:38:33.94,Default,,0000,0000,0000,,Сол аяқ!
Dialogue: 0,1:38:31.94,1:38:33.94,Default,,0000,0000,0000,,Сол аяқ!
Dialogue: 0,1:38:33.94,1:38:35.88,Default,,0000,0000,0000,,Мен көмектесе алмаймын!
Dialogue: 0,1:38:35.88,1:38:38.88,Default,,0000,0000,0000,,
Dialogue: 0,1:38:35.88,1:38:38.88,Default,,0000,0000,0000,,Мен саған осы жерді қарызға беремін.
Dialogue: 0,1:38:38.88,1:38:41.88,Default,,0000,0000,0000,,Олар қосымша күш әкелді.
Dialogue: 0,1:38:41.88,1:38:43.85,Default,,0000,0000,0000,,Олар қосымша күш әкелді.
Dialogue: 0,1:38:46.89,1:38:48.89,Default,,0000,0000,0000,,Ортаңғы оң жақта!
Dialogue: 0,1:38:48.89,1:38:53.86,Default,,0000,0000,0000,,Иә! Ачо! !
Dialogue: 0,1:38:55.90,1:38:57.90,Default,,0000,0000,0000,,Ортаңғы сол жақта!
Dialogue: 0,1:38:57.90,1:38:59.90,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:38:57.90,1:38:59.90,Default,,0000,0000,0000,,(Зевс Бруктың рухы)
Dialogue: 0,1:38:59.90,1:39:02.87,Default,,0000,0000,0000,,(Изуку) Ах! (Гран Торино) Уа!
Dialogue: 0,1:38:59.90,1:39:02.87,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,1:39:05.91,1:39:08.91,Default,,0000,0000,0000,,Ясоптың бірі
Dialogue: 0,1:39:05.91,1:39:08.91,Default,,0000,0000,0000,,Біз жақсы доспыз, солай емес пе?
Dialogue: 0,1:39:08.91,1:39:10.91,Default,,0000,0000,0000,,Оң қол!
Dialogue: 0,1:39:08.91,1:39:10.91,Default,,0000,0000,0000,,Хах.
Dialogue: 0,1:39:10.91,1:39:12.88,Default,,0000,0000,0000,,Мен... Бұл Риппл! Ол Рипплді қолдануда!
Dialogue: 0,1:39:16.92,1:39:21.92,Default,,0000,0000,0000,,(Фрэнки)
Dialogue: 0,1:39:16.92,1:39:21.92,Default,,0000,0000,0000,,Фрэнки Fresh Fire!
Dialogue: 0,1:39:21.92,1:39:24.89,Default,,0000,0000,0000,,Мен... Бұл Риппл! Ол Рипплді қолдануда!
Dialogue: 0,1:39:30.93,1:39:32.93,Default,,0000,0000,0000,,Луффи!
Dialogue: 0,1:39:30.93,1:39:32.93,Default,,0000,0000,0000,,Шенкс!
Dialogue: 0,1:39:32.93,1:39:34.90,Default,,0000,0000,0000,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,1:39:38.87,1:39:43.88,Default,,0000,0000,0000,,Ууууууу! !
Dialogue: 0,1:39:43.88,1:39:58.89,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:39:58.89,1:40:04.90,Default,,0000,0000,0000,,Ууууууууу! !
Dialogue: 0,1:40:04.90,1:40:10.90,Default,,0000,0000,0000,,Оооооооооооооуу! !
Dialogue: 0,1:40:04.90,1:40:10.90,Default,,0000,0000,0000,,Ууууууу! !
Dialogue: 0,1:40:10.90,1:40:24.92,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:40:24.92,1:40:27.92,Default,,0000,0000,0000,,Гугугугу...!
Dialogue: 0,1:40:27.92,1:40:37.87,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:40:37.87,1:40:41.87,Default,,0000,0000,0000,,(Қызыл шашты қарақшылардың барлық мүшелерінің күлкілері)
Dialogue: 0,1:40:41.87,1:40:44.87,Default,,0000,0000,0000,,Сіз оны көрдіңіз бе?
Dialogue: 0,1:40:41.87,1:40:44.87,Default,,0000,0000,0000,,Өйткені сіз бізді шайқасқа шақырасыз!
Dialogue: 0,1:40:44.87,1:40:47.88,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,1:40:44.87,1:40:47.88,Default,,0000,0000,0000,,Бұл маған біраз уақытқа жетеді!
Dialogue: 0,1:40:47.88,1:40:51.88,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:40:47.88,1:40:51.88,Default,,0000,0000,0000,,♬ «Қазына қазынасы қазына»
Dialogue: 0,1:40:51.88,1:40:55.88,Default,,0000,0000,0000,,⚟(нәресте жылады)
Dialogue: 0,1:40:55.88,1:40:57.89,Default,,0000,0000,0000,,Уа...
Dialogue: 0,1:40:55.88,1:40:57.89,Default,,0000,0000,0000,,Кілт?
Dialogue: 0,1:40:57.89,1:40:59.89,Default,,0000,0000,0000,,
Dialogue: 0,1:40:57.89,1:40:59.89,Default,,0000,0000,0000,,Сіз қай жерде араласып кеттіңіз?
Dialogue: 0,1:40:59.89,1:41:03.89,Default,,0000,0000,0000,,Бұл қарақшылар болмайды
Dialogue: 0,1:40:59.89,1:41:03.89,Default,,0000,0000,0000,,Оны бір жерден ұрлап кеткен болуы керек...
Dialogue: 0,1:41:03.89,1:41:05.89,Default,,0000,0000,0000,,Кяхаха Кяхахаха.
Dialogue: 0,1:41:05.89,1:41:07.90,Default,,0000,0000,0000,,Бұл өтірік, ей.
Dialogue: 0,1:41:05.89,1:41:07.90,Default,,0000,0000,0000,,(Утаның айқайы)
Dialogue: 0,1:41:07.90,1:41:10.90,Default,,0000,0000,0000,,Түсіндім! Тыныш бол.
Dialogue: 0,1:41:07.90,1:41:10.90,Default,,0000,0000,0000,,Ал...
Dialogue: 0,1:41:10.90,1:41:16.87,Default,,0000,0000,0000,,♬ «Қайырлы түн балам, тыныш бол».
Dialogue: 0,1:41:18.91,1:41:20.91,Default,,0000,0000,0000,,Кяхаха кяхаха кяха. ➡
Dialogue: 0,1:41:20.91,1:41:25.91,Default,,0000,0000,0000,,Кяхахаха….
Dialogue: 0,1:41:25.91,1:41:28.88,Default,,0000,0000,0000,,Бұл да байланыстың бір түрі ме?
Dialogue: 0,1:41:30.92,1:41:33.92,Default,,0000,0000,0000,,Гррр!
Dialogue: 0,1:41:33.92,1:41:50.87,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:41:50.87,1:41:55.84,Default,,0000,0000,0000,,Оххх! !
Dialogue: 0,1:42:05.89,1:42:08.86,Default,,0000,0000,0000,,Гах! !
Dialogue: 0,1:42:10.89,1:42:14.86,Default,,0000,0000,0000,,Не?
Dialogue: 0,1:42:10.89,1:42:14.86,Default,,0000,0000,0000,,Сіз де жалғыз болған шығарсыз.
Dialogue: 0,1:42:53.90,1:42:58.91,Default,,0000,0000,0000,,Шенкс I...
Dialogue: 0,1:42:53.90,1:42:58.91,Default,,0000,0000,0000,,Жетер, бітті. Хонгу!
Dialogue: 0,1:42:58.91,1:43:01.91,Default,,0000,0000,0000,,(Қақпақты ашқан дыбыс)
Dialogue: 0,1:42:58.91,1:43:01.91,Default,,0000,0000,0000,,Бұл дәріні дереу қабылдаңыз➡
Dialogue: 0,1:43:01.91,1:43:03.91,Default,,0000,0000,0000,,Ұйықтасаңыз, бәрібір құтқарыласыз.
Dialogue: 0,1:43:03.91,1:43:07.92,Default,,0000,0000,0000,,Шенкс... Мен сені сағындым.
Dialogue: 0,1:43:07.92,1:43:10.92,Default,,0000,0000,0000,,Бірақ... мен сенімен танысқым келді.
Dialogue: 0,1:43:10.92,1:43:13.92,Default,,0000,0000,0000,,(Саяма мен басқалардың күлкісі)
Dialogue: 0,1:43:10.92,1:43:13.92,Default,,0000,0000,0000,,Жарайды, тез іш.
Dialogue: 0,1:43:13.92,1:43:15.92,Default,,0000,0000,0000,,⚟(мылтық дыбысы)
Dialogue: 0,1:43:15.92,1:43:17.93,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:43:15.92,1:43:17.93,Default,,0000,0000,0000,,Сіз нені айтып тұрсыз! ➡
Dialogue: 0,1:43:17.93,1:43:23.93,Default,,0000,0000,0000,,Егер сіз жын патшасын жеңсеңіз
Dialogue: 0,1:43:17.93,1:43:23.93,Default,,0000,0000,0000,,Бәлкім жүрегім қайтер! ?
Dialogue: 0,1:43:23.93,1:43:25.93,Default,,0000,0000,0000,,Тоқта... ➡
Dialogue: 0,1:43:25.93,1:43:31.94,Default,,0000,0000,0000,,Ұрысты қазір аяқтаңыз.
Dialogue: 0,1:43:25.93,1:43:31.94,Default,,0000,0000,0000,,Ол – Лорд Широ.
Dialogue: 0,1:43:31.94,1:43:33.94,Default,,0000,0000,0000,,Мен неге қайтып орала алмаймын? Неге!
Dialogue: 0,1:43:33.94,1:43:38.95,Default,,0000,0000,0000,,Мен уақытында үлгермедім.
Dialogue: 0,1:43:33.94,1:43:38.95,Default,,0000,0000,0000,,Totto Musica күшіне➡
Dialogue: 0,1:43:38.95,1:43:42.95,Default,,0000,0000,0000,,Жүрегіміз жұтылды.
Dialogue: 0,1:43:38.95,1:43:42.95,Default,,0000,0000,0000,,Міне!
Dialogue: 0,1:43:42.95,1:43:47.92,Default,,0000,0000,0000,,(Утаның қанмен жөтел дыбысы)
Dialogue: 0,1:43:42.95,1:43:47.92,Default,,0000,0000,0000,,Жақсы! Дәрі-дәрмекті тез қабылдаңыз!
Dialogue: 0,1:43:49.96,1:43:51.96,Default,,0000,0000,0000,,(Су бөтелкесінің сынған дыбысы)
Dialogue: 0,1:43:51.96,1:43:56.93,Default,,0000,0000,0000,,Мен ән айтуым керек...
Dialogue: 0,1:43:51.96,1:43:56.93,Default,,0000,0000,0000,,Біз барлығын біріктіруіміз керек.
Dialogue: 0,1:43:58.97,1:44:02.97,Default,,0000,0000,0000,,Шенкс…
Dialogue: 0,1:43:58.97,1:44:02.97,Default,,0000,0000,0000,,Сіз бұл туралы маған баяғыда айттыңыз, солай ма? ➡
Dialogue: 0,1:44:02.97,1:44:08.98,Default,,0000,0000,0000,,Менің әнімде
Dialogue: 0,1:44:02.97,1:44:08.98,Default,,0000,0000,0000,,Барлығын бақытты ете алатын құдіретіңіз бар дейді.
Dialogue: 0,1:44:08.98,1:44:11.98,Default,,0000,0000,0000,,(аудитория айқайлайды)
Dialogue: 0,1:44:08.98,1:44:11.98,Default,,0000,0000,0000,,Уау. Уф…. Эй!
Dialogue: 0,1:44:11.98,1:44:13.98,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1:44:13.98,1:44:15.95,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,1:44:17.99,1:44:19.99,Default,,0000,0000,0000,,(Утаның қанмен жөтел дыбысы)
Dialogue: 0,1:44:19.99,1:44:25.96,Default,,0000,0000,0000,,Мен
Dialogue: 0,1:44:19.99,1:44:25.96,Default,,0000,0000,0000,,Бұл Ута, Қызыл шашты қарақшылардың музыканты!
Dialogue: 0,1:44:36.94,1:44:50.95,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:44:50.95,1:44:52.95,Default,,0000,0000,0000,,...
Dialogue: 0,1:44:52.95,1:45:02.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:45:02.96,1:45:15.98,Default,,0000,0000,0000,,♬ «Неге?
Dialogue: 0,1:45:02.96,1:45:15.98,Default,,0000,0000,0000,,Сол күні біз ойнаған теңіздің иісі»➡
Dialogue: 0,1:45:15.98,1:45:28.99,Default,,0000,0000,0000,,♬ «Неге?
Dialogue: 0,1:45:15.98,1:45:28.99,Default,,0000,0000,0000,,Жыл мезгілі өткенде жоғалады»➡
Dialogue: 0,1:45:28.99,1:45:35.93,Default,,0000,0000,0000,,♬ «Бір әнді қайта айтқан сайын» ➡
Dialogue: 0,1:45:35.93,1:45:43.94,Default,,0000,0000,0000,,♬ «Мен сені шақырамын» ➡
Dialogue: 0,1:45:43.94,1:45:49.94,Default,,0000,0000,0000,,♬ "Сене аласың ба? Сене аласың ба?"
Dialogue: 0,1:45:49.94,1:45:56.95,Default,,0000,0000,0000,,♬ «Сол жұлдыз жарығы, теңіздің кеңдігі» ➡
Dialogue: 0,1:45:56.95,1:46:03.96,Default,,0000,0000,0000,,♬ «Сене аласыз ба?
Dialogue: 0,1:45:56.95,1:46:03.96,Default,,0000,0000,0000,,Сене аласыз ба? ”➡
Dialogue: 0,1:46:03.96,1:46:09.96,Default,,0000,0000,0000,,♬ «Таңды күтіп, мына қанаттарды үрлеп» ➡
Dialogue: 0,1:46:09.96,1:46:18.97,Default,,0000,0000,0000,,♬ «Артқы желді шақыратын аспан»
Dialogue: 0,1:46:18.97,1:46:21.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:46:21.98,1:46:25.98,Default,,0000,0000,0000,,Періштенің ән салған дауысы... Бұл Ута.
Dialogue: 0,1:46:25.98,1:46:31.99,Default,,0000,0000,0000,,
Dialogue: 0,1:46:25.98,1:46:31.99,Default,,0000,0000,0000,,♬ "Сене аласың ба? Сене аласың ба?" ➡
Dialogue: 0,1:46:31.99,1:46:38.93,Default,,0000,0000,0000,,♬ «Сол жұлдыз жарығы, теңіздің кеңдігі» ➡
Dialogue: 0,1:46:38.93,1:46:44.93,Default,,0000,0000,0000,,♬ «Мен сене аламын, сене аламын»
Dialogue: 0,1:46:44.93,1:46:50.94,Default,,0000,0000,0000,,♬ «Армандарымыздың жалғасы болып бірге өмір сүрейік» ➡
Dialogue: 0,1:46:50.94,1:47:03.95,Default,,0000,0000,0000,,♬ «Бүгін таң атқанда»
Dialogue: 0,1:47:03.95,1:47:23.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:47:23.97,1:47:29.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:47:29.98,1:47:34.92,Default,,0000,0000,0000,,Әй, сен неге мені ұрмадың?
Dialogue: 0,1:47:29.98,1:47:34.92,Default,,0000,0000,0000,,Мен туралы.
Dialogue: 0,1:47:34.92,1:47:37.92,Default,,0000,0000,0000,,Менің соққым
Dialogue: 0,1:47:34.92,1:47:37.92,Default,,0000,0000,0000,,Мен оның тапаншадан күшті екенін айттым ба?
Dialogue: 0,1:47:37.92,1:47:41.92,Default,,0000,0000,0000,,Біз мұны бұрыннан жасайтынбыз.
Dialogue: 0,1:47:37.92,1:47:41.92,Default,,0000,0000,0000,,Хеначоконың дөңгелек соққысы.
Dialogue: 0,1:47:41.92,1:47:44.93,Default,,0000,0000,0000,,Бұл маңызды емес!
Dialogue: 0,1:47:41.92,1:47:44.93,Default,,0000,0000,0000,,Ойнайық. Әйтеуір біз пианисттер ғой.
Dialogue: 0,1:47:44.93,1:47:47.89,Default,,0000,0000,0000,,Шықты, жеңілгеніме қынжыламын!
Dialogue: 0,1:47:50.93,1:47:54.90,Default,,0000,0000,0000,,Мен мұны білмей тұрып, Луффи болды
Dialogue: 0,1:47:50.93,1:47:54.90,Default,,0000,0000,0000,,Бойыңыз өсті.
Dialogue: 0,1:48:06.95,1:48:09.92,Default,,0000,0000,0000,,
Dialogue: 0,1:48:06.95,1:48:09.92,Default,,0000,0000,0000,,Бұл қалпақ мен үшін өте маңызды.
Dialogue: 0,1:48:11.95,1:48:15.92,Default,,0000,0000,0000,,Бір күні бұлай болатынына сенімдімін
Dialogue: 0,1:48:11.95,1:48:15.92,Default,,0000,0000,0000,,Сіз лайықтырақ адам боласыз.
Dialogue: 0,1:48:23.96,1:48:27.97,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,1:48:23.96,1:48:27.97,Default,,0000,0000,0000,,Шенкс... Луффи ше?
Dialogue: 0,1:48:27.97,1:48:31.94,Default,,0000,0000,0000,,Мен қайтып келдім.
Dialogue: 0,1:48:27.97,1:48:31.94,Default,,0000,0000,0000,,Барлық көрермендер қауіпсіз.
Dialogue: 0,1:48:34.91,1:48:36.88,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,1:48:38.91,1:48:42.92,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:48:38.91,1:48:42.92,Default,,0000,0000,0000,,Шанкс және қызыл шашты қарақшылар➡
Dialogue: 0,1:48:42.92,1:48:44.89,Default,,0000,0000,0000,,Мен сене алар емеспін.
Dialogue: 0,1:48:46.92,1:48:51.89,Default,,0000,0000,0000,,Бірақ рахмет.
Dialogue: 0,1:48:46.92,1:48:51.89,Default,,0000,0000,0000,,Маған көмекке келгені үшін.
Dialogue: 0,1:48:54.93,1:48:57.93,Default,,0000,0000,0000,,(Борсалино)
Dialogue: 0,1:48:54.93,1:48:57.93,Default,,0000,0000,0000,,Жүр, ұйықтайтын кез келді➡
Dialogue: 0,1:48:57.93,1:49:03.90,Default,,0000,0000,0000,,Дүниені құртпақ болған жауыз
Dialogue: 0,1:48:57.93,1:49:03.90,Default,,0000,0000,0000,,Маған бере аласыз ба?
Dialogue: 0,1:49:05.94,1:49:07.94,Default,,0000,0000,0000,,Хо, балалар...
Dialogue: 0,1:49:07.94,1:49:12.95,Default,,0000,0000,0000,,Қарсы болу
Dialogue: 0,1:49:07.94,1:49:12.95,Default,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,1:49:12.95,1:49:16.95,Default,,0000,0000,0000,,Барлығы….
Dialogue: 0,1:49:12.95,1:49:16.95,Default,,0000,0000,0000,,Бұл жігіт➡
Dialogue: 0,1:49:16.95,1:49:19.95,Default,,0000,0000,0000,,Ол менің қызым. ➡
Dialogue: 0,1:49:19.95,1:49:22.96,Default,,0000,0000,0000,,Олар біздің асыл отбасымыз. ➡
Dialogue: 0,1:49:22.96,1:49:26.96,Default,,0000,0000,0000,,Егер сіз оны алып кеткіңіз келсе➡
Dialogue: 0,1:49:26.96,1:49:28.93,Default,,0000,0000,0000,,Өлім ниетімен кел!
Dialogue: 0,1:49:33.97,1:49:35.90,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,1:49:35.90,1:49:38.91,Default,,0000,0000,0000,,генерал-лейтенанттың бөлігіне дейін.
Dialogue: 0,1:49:35.90,1:49:38.91,Default,,0000,0000,0000,,Мен оны өзіммен бірге алып кетемін деп ойламаймын. ➡
Dialogue: 0,1:49:38.91,1:49:43.91,Default,,0000,0000,0000,,Бұл Йонко Шэнкстің Хакиі ме?
Dialogue: 0,1:49:43.91,1:49:45.91,Default,,0000,0000,0000,,Тоқтау уақыты келді. ➡
Dialogue: 0,1:49:45.91,1:49:51.89,Default,,0000,0000,0000,,Азаматтар да бар жерде
Dialogue: 0,1:49:45.91,1:49:51.89,Default,,0000,0000,0000,,Соғыс неден басталады...
Dialogue: 0,1:50:09.94,1:50:13.94,Default,,0000,0000,0000,,
Dialogue: 0,1:50:09.94,1:50:13.94,Default,,0000,0000,0000,,Барлық жанкүйерлерге... жақсысың ба?
Dialogue: 0,1:50:13.94,1:50:17.94,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,1:50:13.94,1:50:17.94,Default,,0000,0000,0000,,Адамдар соншалықты жұмсақ емес.
Dialogue: 0,1:50:17.94,1:50:22.92,Default,,0000,0000,0000,,Ал жаңа дәуір дәл алдымызда.
Dialogue: 0,1:50:28.96,1:50:36.90,Default,,0000,0000,0000,,♬ «Бұл жел қайдан шықты?» ➡
Dialogue: 0,1:50:36.90,1:50:44.90,Default,,0000,0000,0000,,♬«Сұрасаң да
Dialogue: 0,1:50:36.90,1:50:44.90,Default,,0000,0000,0000,,Аспан ештеңе айтпайды»➡
Dialogue: 0,1:50:44.90,1:50:52.91,Default,,0000,0000,0000,,♬ «Бұл ән бізді қайда апарады?» ➡
Dialogue: 0,1:50:52.91,1:51:01.92,Default,,0000,0000,0000,,♬ «Мен оны тапқым келеді.
Dialogue: 0,1:50:52.91,1:51:01.92,Default,,0000,0000,0000,,Өз жауабыңды бер».
Dialogue: 0,1:51:01.92,1:51:12.90,Default,,0000,0000,0000,,♬ «Мен әлі білмеген теңіздің соңына дейін
Dialogue: 0,1:51:01.92,1:51:12.90,Default,,0000,0000,0000,,Есікті бастайық».
Dialogue: 0,1:51:14.93,1:51:28.95,Default,,0000,0000,0000,,♬ «Бір ғана арман
Dialogue: 0,1:51:14.93,1:51:28.95,Default,,0000,0000,0000,,Ешқашан берілме»➡
Dialogue: 0,1:51:28.95,1:51:39.89,Default,,0000,0000,0000,,♬ «Жүрегіңде жүз
Dialogue: 0,1:51:28.95,1:51:39.89,Default,,0000,0000,0000,,Қалауыңызша жүріңіз»➡
Dialogue: 0,1:51:39.89,1:51:45.87,Default,,0000,0000,0000,,♬ «Әрқашан саған»
Dialogue: 0,1:51:49.90,1:51:51.91,Default,,0000,0000,0000,,Сіз жақсы ұйықтадыңыз.
Dialogue: 0,1:51:51.91,1:51:55.88,Default,,0000,0000,0000,,Юта ше? Шенкс те.
Dialogue: 0,1:51:51.91,1:51:55.88,Default,,0000,0000,0000,,О.
Dialogue: 0,1:52:18.93,1:52:28.91,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:56:49.94,1:56:53.91,Default,,0000,0000,0000,,Сәлем, Санни!
Dialogue: 0,1:56:49.94,1:56:53.91,Default,,0000,0000,0000,,Күн шуақты ма?
Dialogue: 0,1:57:04.95,1:57:07.95,Default,,0000,0000,0000,,Жарайды...
Dialogue: 0,1:57:07.95,1:57:09.96,Default,,0000,0000,0000,,Қарақшылар патшасы бол!
Dialogue: 0,1:57:09.96,1:57:12.93,Default,,0000,0000,0000,,Мен боламын! !
Dialogue: 0,1:57:19.90,1:57:31.91,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:57:31.91,1:57:33.91,Default,,0000,0000,0000,,Аххххххх!
Dialogue: 0,1:57:33.91,1:57:46.93,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:57:46.93,1:57:48.93,Default,,0000,0000,0000,,Не болды!
Dialogue: 0,1:57:48.93,1:57:51.93,Default,,0000,0000,0000,,Маған көмектесіңізші...
Dialogue: 0,1:57:48.93,1:57:51.93,Default,,0000,0000,0000,,Әке!
Dialogue: 0,1:57:51.93,1:57:56.94,Default,,0000,0000,0000,,Мен ешқашан әлемнің шыңында боламын деп ойламадым
Dialogue: 0,1:57:51.93,1:57:56.94,Default,,0000,0000,0000,,Тозақ бар.
Dialogue: 0,1:57:56.94,1:57:58.94,Default,,0000,0000,0000,,Хи хи.
Dialogue: 0,1:57:56.94,1:57:58.94,Default,,0000,0000,0000,,Ди
Dialogue: 0,1:57:56.94,1:57:58.94,Default,,0000,0000,0000,,«Д» деген не... Бір кездері➡
Dialogue: 0,1:57:58.94,1:58:02.91,Default,,0000,0000,0000,,Біз
Dialogue: 0,1:57:58.94,1:58:02.91,Default,,0000,0000,0000,,Маған қарсы шыққандардың аты-жөні.
Dialogue: 0,1:58:08.95,1:58:12.95,Default,,0000,0000,0000,,Сіз кеткелі тұрған хабарлама
Dialogue: 0,1:58:08.95,1:58:12.95,Default,,0000,0000,0000,,Барлығы таң қалады деп ойлаймын➡
Dialogue: 0,1:58:12.95,1:58:15.92,Default,,0000,0000,0000,,Дүниенің ақиқаты осы.
Dialogue: 0,1:58:17.42,1:58:23.42,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory