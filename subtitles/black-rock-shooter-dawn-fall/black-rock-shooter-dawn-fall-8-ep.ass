Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.13,0:00:09.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:23.39,0:00:25.98,Default,,0,0,0,,Стандартты мән өшірілді. Сіз масканы алып тастай аласыз.
Dialogue: 0,0:00:26.31,0:00:28.98,Default,,0,0,0,,Фаа! Ұзақ уақыттан кейін таза ауа
Dialogue: 0,0:00:29.82,0:00:30.69,Default,,0,0,0,,Әй!
Dialogue: 0,0:00:32.36,0:00:35.57,Default,,0,0,0,,Адамзат небәрі 4 айда машиналардан жеңілді
Dialogue: 0,0:00:35.70,0:00:37.91,Default,,0,0,0,,Шегіну үшін бітпейтін шайқасқа мәжбүр болды
Dialogue: 0,0:00:38.03,0:00:41.24,Default,,0,0,0,,Және олар Жерді өзгерте бастады.
Dialogue: 0,0:00:41.37,0:00:44.83,Default,,0,0,0,,Жобаны аяқтау үшін орбиталық элеватор Жер мен айды байланыстырады.
Dialogue: 0,0:00:44.96,0:00:46.25,Default,,0,0,0,,бірдеңе жасауға тырысу
Dialogue: 0,0:00:47.96,0:00:50.55,Default,,0,0,0,,Полковник, мен орбиталық элеватордамын.
Dialogue: 0,0:00:50.67,0:00:53.13,Default,,0,0,0,,Мен оған жетуім керек дедім...
Dialogue: 0,0:00:57.30,0:00:58.14,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:00:58.30,0:00:59.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:01.39,0:01:04.43,Default,,0,0,0,,Айдан Жердің геосинхронды орбитасына дейін
Dialogue: 0,0:01:04.56,0:01:06.14,Default,,0,0,0,,Кабель өсуде
Dialogue: 0,0:01:06.44,0:01:07.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:07.60,0:01:11.73,Default,,0,0,0,,Есептеулер бойынша жалпы ұзындығы 360 000 км бұрмаланған кабельдер бар.
Dialogue: 0,0:01:11.86,0:01:16.49,Default,,0,0,0,,Жер жағындағы орбиталық элеваторға қосылғанша тағы екі апта қалды.
Dialogue: 0,0:01:16.61,0:01:19.28,Default,,0,0,0,,Бұл «Таң атқан күн»
Dialogue: 0,0:01:19.49,0:01:23.24,Default,,0,0,0,,Жердегі соңғы күн, адамзаттың соңғы күні
Dialogue: 0,0:01:23.45,0:01:24.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:25.16,0:01:26.75,Default,,0,0,0,,Егер сіз оған оң көзқараспен қарасаңыз
Dialogue: 0,0:01:26.87,0:01:30.17,Default,,0,0,0,,Жер бетіндегі орбиталық элеваторға белгіленген мерзімге дейін жетіңіз
Dialogue: 0,0:01:30.29,0:01:33.09,Default,,0,0,0,,Бұны жойсақ, жеңіліске ұшырай аламыз ба?
Dialogue: 0,0:01:33.21,0:01:36.13,Default,,0,0,0,,Иә, сондықтан біз Теккайдан өтеміз.
Dialogue: 0,0:01:36.26,0:01:38.84,Default,,0,0,0,,Алайда, екінші жағы - Лунатикалық армияның территориясы.
Dialogue: 0,0:01:38.97,0:01:41.97,Default,,0,0,0,,Сіз кесіп өткеннен кейін аман-есен оралатыныңызға кепілдік жоқ.
Dialogue: 0,0:01:42.10,0:01:42.93,Default,,0,0,0,,Хома...
Dialogue: 0,0:01:43.06,0:01:46.14,Default,,0,0,0,,Мен мұнда өмір сүру үшін ақша табу үшін келдім!
Dialogue: 0,0:01:46.27,0:01:47.69,Default,,0,0,0,,Не? үшін да
Dialogue: 0,0:01:47.81,0:01:50.36,Default,,0,0,0,,Тірі қайтып келмейтін мәселе емес пе?
Dialogue: 0,0:01:50.48,0:01:52.32,Default,,0,0,0,,Әсіресе бұл миссия болғандықтан.
Dialogue: 0,0:01:52.77,0:01:54.90,Default,,0,0,0,,Маяк Мен оны табуым керек
Dialogue: 0,0:01:55.53,0:01:57.32,Default,,0,0,0,,Императрицаға еріңіз
Dialogue: 0,0:01:57.65,0:01:59.32,Default,,0,0,0,,Жындыны өлтіру
Dialogue: 0,0:01:59.61,0:02:01.83,Default,,0,0,0,,О, шындап айтсам, мына жігіттер
Dialogue: 0,0:02:03.66,0:02:06.62,Default,,0,0,0,,Егер сіз кері бұрылғыңыз келсе, қазір сіздің соңғы мүмкіндігіңіз.
Dialogue: 0,0:02:06.75,0:02:09.25,Default,,0,0,0,,Өкінішке орай, мен сіздің таңдауыңызды күтпеймін.
Dialogue: 0,0:02:09.37,0:02:10.33,Default,,0,0,0,,О!
Dialogue: 0,0:02:10.50,0:02:11.84,Default,,0,0,0,,(Сенсор дабылы)
Dialogue: 0,0:02:12.38,0:02:13.84,Default,,0,0,0,,Не? Не болып жатыр?
Dialogue: 0,0:02:14.71,0:02:17.92,Default,,0,0,0,,Аа, кешіріңіз, бұл бізбіз.
Dialogue: 0,0:02:18.05,0:02:21.85,Default,,0,0,0,,Темір теңізде балық аулау кезінде сіз міндетті түрде Архемен ластанасыз.
Dialogue: 0,0:02:22.26,0:02:23.10,Default,,0,0,0,,Иә? Ғай...
Dialogue: 0,0:02:24.01,0:02:26.02,Default,,0,0,0,,(Мониканың ысқырығы)
Dialogue: 0,0:02:26.14,0:02:29.35,Default,,0,0,0,,Сіз темір теңіз өткелінен өтетін балықшының міндетісіз бе?
Dialogue: 0,0:02:29.81,0:02:31.94,Default,,0,0,0,,Иә, бұл көшбасшы.
Dialogue: 0,0:02:32.06,0:02:34.86,Default,,0,0,0,,Менің атым Исана. Менімен танысуыңызды өтінемін.
Dialogue: 0,0:02:35.90,0:02:37.86,Default,,0,0,0,,Сіз мен ойлағаннан да жассыз.
Dialogue: 0,0:02:37.99,0:02:38.95,Default,,0,0,0,,Сіз уайымдап тұрсыз ба?
Dialogue: 0,0:02:39.07,0:02:42.20,Default,,0,0,0,,Жоқ, менің тәжірибемнен, қажетсіз шағымданбайтын адамдар
Dialogue: 0,0:02:42.32,0:02:43.87,Default,,0,0,0,,Құзыретті және сенімді
Dialogue: 0,0:02:44.37,0:02:46.62,Default,,0,0,0,,Енді жұмысқа кірісейік.
Dialogue: 0,0:02:46.74,0:02:49.83,Default,,0,0,0,,Кеме доктан кез келген уақытта шыға алады.
Dialogue: 0,0:02:50.08,0:02:51.37,Default,,0,0,0,,Маған жол көрсетіңізші.
Dialogue: 0,0:02:56.13,0:02:56.96,Default,,0,0,0,,Хехе
Dialogue: 0,0:02:57.30,0:02:58.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:59.80,0:03:00.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:03.72,0:03:05.22,Default,,0,0,0,,Ей, ей, ей! Бар дейсің бе? Қайда, нақты қай жерде?
Dialogue: 0,0:03:05.35,0:03:08.64,Default,,0,0,0,,Бұл менің өмірімдегі ең үлкен қателік.
Dialogue: 0,0:03:14.31,0:03:15.52,Default,,0,0,0,,Моника...
Dialogue: 0,0:03:15.86,0:03:18.15,Default,,0,0,0,,Сізге оқу ұнайды.
Dialogue: 0,0:03:18.86,0:03:20.86,Default,,0,0,0,,Басқа ештеңе жоқ
Dialogue: 0,0:03:20.99,0:03:22.74,Default,,0,0,0,,Менің айтайын дегенім, ол соншалықты әлсіз.
Dialogue: 0,0:03:22.86,0:03:24.66,Default,,0,0,0,,Теңізге түскеннен кейін есі дұрыс па?
Dialogue: 0,0:03:24.91,0:03:27.29,Default,,0,0,0,,Жарайды, теңізге барайық.
Dialogue: 0,0:03:27.41,0:03:29.66,Default,,0,0,0,,Неліктен достығымызды еске алу үшін жақсы нәрсе жасамасқа?
Dialogue: 0,0:03:30.12,0:03:31.16,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:03:34.67,0:03:36.67,Default,,0,0,0,,Уф! Уау...
Dialogue: 0,0:03:40.38,0:03:41.22,Default,,0,0,0,,Буха!
Dialogue: 0,0:03:41.34,0:03:43.05,Default,,0,0,0,,Не істеп жатырсың, ақымақ?
Dialogue: 0,0:03:44.18,0:03:45.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:46.64,0:03:49.31,Default,,0,0,0,,Ылғал Моника сүйкімді сияқты
Dialogue: 0,0:03:49.81,0:03:53.31,Default,,0,0,0,,Әдемі болсаң, бірдеңе айтуға болады деп ойламайсың ба?
Dialogue: 0,0:03:53.77,0:03:55.02,Default,,0,0,0,,Мен мұны түсінемін.
Dialogue: 0,0:03:55.15,0:03:57.82,Default,,0,0,0,,Мен де Мониканың орнында болсам, бәрін кешірер едім.
Dialogue: 0,0:03:58.11,0:03:59.36,Default,,0,0,0,,Ах~
Dialogue: 0,0:04:00.19,0:04:01.03,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:04:03.70,0:04:04.91,Default,,0,0,0,,Деміңізді ұстаңыз
Dialogue: 0,0:04:13.92,0:04:16.21,Default,,0,0,0,,Бұл көп ұзамай болды.
Dialogue: 0,0:04:16.50,0:04:18.25,Default,,0,0,0,,«Мен жақында өлемін».
Dialogue: 0,0:04:18.63,0:04:22.84,Default,,0,0,0,,Соны жазып болған соң ол менің көз алдымнан ғайып болды.
Dialogue: 0,0:04:30.68,0:04:31.52,Default,,0,0,0,,Моника
Dialogue: 0,0:04:32.68,0:04:33.77,Default,,0,0,0,,А... балалар
Dialogue: 0,0:04:37.31,0:04:38.44,Default,,0,0,0,,Теңіз ауруы?
Dialogue: 0,0:04:38.56,0:04:41.78,Default,,0,0,0,,Сіз мұны істегіңіз келуі мүмкін.
Dialogue: 0,0:04:41.90,0:04:43.82,Default,,0,0,0,,Ол адаммен бірдеңе болды ма?
Dialogue: 0,0:04:43.95,0:04:46.28,Default,,0,0,0,,Баяғыда... жақсы, аздап.
Dialogue: 0,0:04:46.95,0:04:48.70,Default,,0,0,0,,Әлбетте баяғыда
Dialogue: 0,0:04:48.83,0:04:51.74,Default,,0,0,0,,Мен сені өлді деп ойладым.
Dialogue: 0,0:04:54.08,0:04:57.71,Default,,0,0,0,,Біз түн ортасы шамасында арғы бетке жетуді жоспарлап отырмыз.
Dialogue: 0,0:04:57.83,0:04:59.59,Default,,0,0,0,,Сіз қаншалықты алысқа барғыңыз келеді?
Dialogue: 0,0:04:59.71,0:05:01.80,Default,,0,0,0,,Айға дейін.
Dialogue: 0,0:05:02.09,0:05:04.72,Default,,0,0,0,,Бұл ұзақ сапар болады.
Dialogue: 0,0:05:04.92,0:05:08.30,Default,,0,0,0,,Тецукайватари оны ең қысқа жолмен жеткізеді.
Dialogue: 0,0:05:08.43,0:05:12.93,Default,,0,0,0,,Бұл кеме әбден тозған көрінеді, бірақ жақсы ма?
Dialogue: 0,0:05:13.06,0:05:17.02,Default,,0,0,0,,Кеменің корпусын темір теңіз жәндіктері әдейі басып алған.
Dialogue: 0,0:05:17.31,0:05:20.82,Default,,0,0,0,,Археге қарсы шара ретінде және Гигантеске бетперде ретінде...
Dialogue: 0,0:05:20.94,0:05:22.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:22.48,0:05:23.61,Default,,0,0,0,,Қандай жағымсыз иіс! Тамағымның арты ұстап, ауырып барады.
Dialogue: 0,0:05:24.61,0:05:25.49,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:27.07,0:05:28.41,Default,,0,0,0,,Архенің ластануы…
Dialogue: 0,0:05:28.53,0:05:31.08,Default,,0,0,0,,Кристалдарды түкіру өте қауіпті емес пе?
Dialogue: 0,0:05:32.41,0:05:35.83,Default,,0,0,0,,Темір теңізінің атмосферасында сілтілердің жоғары концентрациясы бар.
Dialogue: 0,0:05:35.96,0:05:39.21,Default,,0,0,0,,Противогаз киіп жүрсең де, ол жерде ұзақ тұрсаң жұмыс істемейді.
Dialogue: 0,0:05:39.92,0:05:42.84,Default,,0,0,0,,Батареяларға шикізат ретінде пайдаланылатын темір теңіз жәндіктерін браконьерлікпен аулау
Dialogue: 0,0:05:42.96,0:05:46.59,Default,,0,0,0,,Сіз ақша таба аласыз, бірақ өміріңіз одан да көп жоғалады.
Dialogue: 0,0:05:46.92,0:05:50.55,Default,,0,0,0,,Сонымен, сіз Бейбітшілікті құрушы күштерден өтініш алдыңыз ба?
Dialogue: 0,0:05:50.76,0:05:52.89,Default,,0,0,0,,Тіршілікке және есеп айырысуларға арналған ақша
Dialogue: 0,0:05:53.01,0:05:56.98,Default,,0,0,0,,Осы арқылы мен көшбасшы ретінде өз міндетімді орындай аламын.
Dialogue: 0,0:05:57.89,0:05:58.98,Default,,0,0,0,,Жыныстық қатынас?
Dialogue: 0,0:05:59.52,0:06:01.36,Default,,0,0,0,,Кю... Кенеттен не болды?
Dialogue: 0,0:06:01.73,0:06:03.07,Default,,0,0,0,,Махаббат әрекеттері
Dialogue: 0,0:06:03.19,0:06:07.74,Default,,0,0,0,,Соңғы рет уайымдағанымда, Моника егер мен мұны істесем, сауығып кетуім мүмкін екенін айтты.
Dialogue: 0,0:06:09.86,0:06:11.45,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:11.57,0:06:15.66,Default,,0,0,0,,Жоқ, бұл жыныстық қатынас арқылы емделмейтін ересек адамның мәселесі...
Dialogue: 0,0:06:15.79,0:06:16.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:18.00,0:06:19.00,Default,,0,0,0,,Кенет осында?
Dialogue: 0,0:06:19.29,0:06:20.50,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:06:23.88,0:06:25.42,Default,,0,0,0,,Темір теңіз жануарлары...
Dialogue: 0,0:06:25.84,0:06:26.96,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:06:30.72,0:06:32.47,Default,,0,0,0,,Гиганттар!
Dialogue: 0,0:06:40.81,0:06:42.73,Default,,0,0,0,,Сәлем~ Бір шаштың ені
Dialogue: 0,0:06:55.70,0:06:57.54,Default,,0,0,0,,Уау... Мен жеп жатырмын.
Dialogue: 0,0:06:57.66,0:07:00.37,Default,,0,0,0,,Шамасы, мұхит шұңқырында жасырынған.
Dialogue: 0,0:07:00.50,0:07:01.37,Default,,0,0,0,,Моника! иә?
Dialogue: 0,0:07:01.75,0:07:03.71,Default,,0,0,0,,Бұл сенің тағы да әрекетің!
Dialogue: 0,0:07:03.84,0:07:06.75,Default,,0,0,0,,Тағы не? Бұл басқаша
Dialogue: 0,0:07:10.76,0:07:11.59,Default,,0,0,0,,Қияметсіз...
Dialogue: 0,0:07:11.72,0:07:12.89,Default,,0,0,0,,Тоқта
Dialogue: 0,0:07:13.34,0:07:15.05,Default,,0,0,0,,Мылтық қолданбаңыз
Dialogue: 0,0:07:18.31,0:07:19.52,Default,,0,0,0,,Мылтық дауысын есту
Dialogue: 0,0:07:19.64,0:07:22.27,Default,,0,0,0,,Үйір бөлімшесі топ-тобымен жақындап келеді.
Dialogue: 0,0:07:22.48,0:07:25.86,Default,,0,0,0,,Қалай болғанда да, егер жағдай осылай жалғаса берсе, мені Гигантес жеп қояды.
Dialogue: 0,0:07:25.98,0:07:28.82,Default,,0,0,0,,Гигантес бізді әлі байқаған жоқ.
Dialogue: 0,0:07:28.94,0:07:29.78,Default,,0,0,0,,Не?
Dialogue: 0,0:07:30.03,0:07:33.20,Default,,0,0,0,,Кеме риф деп жалған ойлайды.
Dialogue: 0,0:07:33.32,0:07:34.66,Default,,0,0,0,,Мұны маған қалдырыңыз.
Dialogue: 0,0:07:34.95,0:07:37.03,Default,,0,0,0,,А... жарайды.
Dialogue: 0,0:07:37.79,0:07:39.91,Default,,0,0,0,,Бұл менмін. Қозғалтқыш тоқтады.
Dialogue: 0,0:07:46.00,0:07:47.67,Default,,0,0,0,,Оның өтуін күтіңіз
Dialogue: 0,0:08:01.93,0:08:03.39,Default,,0,0,0,,Бардың ба...
Dialogue: 0,0:08:11.15,0:08:13.15,Default,,0,0,0,,Үйір бөлімі...
Dialogue: 0,0:08:13.36,0:08:16.32,Default,,0,0,0,,Онымен күресу біршама қиын.
Dialogue: 0,0:08:16.45,0:08:19.08,Default,,0,0,0,,Үндемей қалсаңыз, олар сізге шабуыл жасамайды, сондықтан жақсы.
Dialogue: 0,0:08:19.20,0:08:20.50,Default,,0,0,0,,Қазір! (2 адам) Эй...
Dialogue: 0,0:08:22.46,0:08:25.21,Default,,0,0,0,,Моника! Жүр, мен сені Темір теңізге батырамын.
Dialogue: 0,0:08:25.33,0:08:27.46,Default,,0,0,0,,Мынаны қараңыз.
Dialogue: 0,0:08:30.30,0:08:34.76,Default,,0,0,0,,Хехехе... бұл өте үлкен ақшаның иісі.
Dialogue: 0,0:08:39.31,0:08:40.26,Default,,0,0,0,,Сақ бол
Dialogue: 0,0:08:40.39,0:08:42.06,Default,,0,0,0,,А, мен келемін.
Dialogue: 0,0:08:45.06,0:08:46.27,Default,,0,0,0,,шынымен де осында
Dialogue: 0,0:08:46.40,0:08:49.77,Default,,0,0,0,,Императрицаны нығайту үшін биологиялық бөліктерді алуға болады деп ойлаймын?
Dialogue: 0,0:08:49.90,0:08:50.73,Default,,0,0,0,,Иә
Dialogue: 0,0:08:51.19,0:08:53.99,Default,,0,0,0,,Бұл айтарлықтай үлкен биологиялық бөліктердің реакциясы.
Dialogue: 0,0:08:54.15,0:08:55.86,Default,,0,0,0,,Императрица оны сіңірсе
Dialogue: 0,0:08:55.99,0:08:58.74,Default,,0,0,0,,Алдағы шайқас әлдеқайда жеңіл болады.
Dialogue: 0,0:08:59.03,0:09:02.79,Default,,0,0,0,,Сіз сирек кездесетін бөлшектерді ғана қаламайсыз, солай ма?
Dialogue: 0,0:09:02.91,0:09:03.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:09.84,0:09:11.25,Default,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:09:11.38,0:09:14.26,Default,,0,0,0,,Өлең көлеміне қарап тыныш.
Dialogue: 0,0:09:14.38,0:09:17.13,Default,,0,0,0,,Темір теңіз жәндіктері таңқаларлықтай ұстамды.
Dialogue: 0,0:09:17.89,0:09:19.97,Default,,0,0,0,,Бірақ олардың кейбіреулері жауыз, сондықтан
Dialogue: 0,0:09:20.10,0:09:24.23,Default,,0,0,0,,Мониканың қазынасын алып, тез қайтарайық.
Dialogue: 0,0:09:24.35,0:09:26.64,Default,,0,0,0,,Әңгіме айта бастаса да әлгі бейбақ.
Dialogue: 0,0:09:26.77,0:09:28.35,Default,,0,0,0,,Кемеде қалғандар
Dialogue: 0,0:09:28.65,0:09:31.52,Default,,0,0,0,,Жарайды... бұл менің кінәм шығар.
Dialogue: 0,0:09:31.65,0:09:32.61,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:34.74,0:09:36.65,Default,,0,0,0,,Жәндіктерге толы емес пе?
Dialogue: 0,0:09:36.78,0:09:39.12,Default,,0,0,0,,Өлген қожайыны артта қалдыру дұрыс таңдау болды.
Dialogue: 0,0:09:39.78,0:09:40.87,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:09:41.20,0:09:42.37,Default,,0,0,0,,Ол көптен бері болды
Dialogue: 0,0:09:42.49,0:09:43.83,Default,,0,0,0,,Мен жәндіктерді жек көремін
Dialogue: 0,0:09:43.95,0:09:46.50,Default,,0,0,0,,Егер сіз осында болсаңыз, сіз жынды сияқты атасыз.
Dialogue: 0,0:09:46.87,0:09:50.79,Default,,0,0,0,,Жәндіктер... Мен жәндіктерден қорқамын, қорқынышты, жиіркенішті...
Dialogue: 0,0:09:50.92,0:09:51.88,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:09:52.42,0:09:57.13,Default,,0,0,0,,Баяғыда... №8 Маякта болған кезіңде Сегіз саны.
Dialogue: 0,0:09:57.30,0:09:59.30,Default,,0,0,0,,Сіз менің бұрын кім болғанымды білуіңіз керек.
Dialogue: 0,0:09:59.43,0:10:01.14,Default,,0,0,0,,Бұл сіздің жасыңыз.
Dialogue: 0,0:10:01.26,0:10:02.89,Default,,0,0,0,,Маяк туралы ештеңе жоқ.
Dialogue: 0,0:10:03.01,0:10:04.60,Default,,0,0,0,,Көп нәрсе есімде жоқ...
Dialogue: 0,0:10:08.19,0:10:11.65,Default,,0,0,0,,Айтпақшы, сен неге кішкентайсың?
Dialogue: 0,0:10:12.44,0:10:14.65,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:10:15.03,0:10:16.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:22.03,0:10:23.62,Default,,0,0,0,,Бір нәрсе есіңізде ме?
Dialogue: 0,0:10:23.74,0:10:26.91,Default,,0,0,0,,Біз «Карнеадтар тақтасы» тақырыбын талқылағанда
Dialogue: 0,0:10:27.33,0:10:32.42,Default,,0,0,0,,Кеме суға батып, теңізге лақтырылған адамды жалғыз тақтай ұстап тұр.
Dialogue: 0,0:10:33.09,0:10:35.42,Default,,0,0,0,,Бірақ ол екі адамнан артық жұмыс істей алмайды.
Dialogue: 0,0:10:35.55,0:10:39.01,Default,,0,0,0,,Бұл жағдайда аман қалу үшін қарсыласыңызды тақтадан итеріңіз.
Dialogue: 0,0:10:39.13,0:10:41.68,Default,,0,0,0,,Біреудің суға батып сықырлауына жол беруге бола ма?
Dialogue: 0,0:10:41.89,0:10:43.18,Default,,0,0,0,,Сіздің жауабыңыз қандай?
Dialogue: 0,0:10:44.97,0:10:46.68,Default,,0,0,0,,үшінн итеріп жіберіңіз
Dialogue: 0,0:10:47.93,0:10:48.93,Default,,0,0,0,,Мен...
Dialogue: 0,0:10:50.60,0:10:52.19,Default,,0,0,0,,Күш! Исана!
Dialogue: 0,0:10:52.40,0:10:53.56,Default,,0,0,0,,Чи…
Dialogue: 0,0:11:01.61,0:11:02.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:03.91,0:11:04.91,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:08.83,0:11:10.79,Default,,0,0,0,,Уф! Боқ...
Dialogue: 0,0:11:13.83,0:11:15.67,Default,,0,0,0,,Мен сені итеріп жібермеймін
Dialogue: 0,0:11:16.63,0:11:17.92,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:11:18.30,0:11:19.84,Default,,0,0,0,,Алдыңғы жауап
Dialogue: 0,0:11:20.13,0:11:23.72,Default,,0,0,0,,Өйткені біз гемиттік бірлікпіз және өлмейміз.
Dialogue: 0,0:11:23.89,0:11:26.56,Default,,0,0,0,,үшінна аман қалудың жолын табыңыз
Dialogue: 0,0:11:29.77,0:11:30.81,Default,,0,0,0,,Ол өзгерген жоқ
Dialogue: 0,0:11:31.27,0:11:32.23,Default,,0,0,0,,Не?
Dialogue: 0,0:11:32.35,0:11:34.48,Default,,0,0,0,,Шулы, сен кедергісің, жолдан кет.
Dialogue: 0,0:11:37.23,0:11:38.78,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:11:39.19,0:11:41.32,Default,,0,0,0,,Мәселе жоқ, алдымен кері қайтыңыз.
Dialogue: 0,0:11:41.61,0:11:43.45,Default,,0,0,0,,Кешіріңіз, танысқаныма қуаныштымын.
Dialogue: 0,0:11:48.87,0:11:53.04,Default,,0,0,0,,«Мен теңізге өзім құлап кеткен шығармын».
Dialogue: 0,0:12:03.13,0:12:04.80,Default,,0,0,0,,Мен аздап қышиды.
Dialogue: 0,0:12:04.93,0:12:07.89,Default,,0,0,0,,Темір теңізді жалаңаш теріңізбен ұстаңыз, ол қышымайды.
Dialogue: 0,0:12:08.01,0:12:09.72,Default,,0,0,0,,Бұл дене шынында да қатты.
Dialogue: 0,0:12:10.52,0:12:13.60,Default,,0,0,0,,Жақын маңдағы биологиялық бөліктердің реакциясын сезіну
Dialogue: 0,0:12:13.73,0:12:16.69,Default,,0,0,0,,Аралда қазына сандығы жасырылған ба?
Dialogue: 0,0:12:16.81,0:12:18.15,Default,,0,0,0,,Ал, күте тұрыңыз.
Dialogue: 0,0:12:18.27,0:12:21.78,Default,,0,0,0,,Неліктен Гигантес мұндай ақымақ реакцияны елемеді?
Dialogue: 0,0:12:21.90,0:12:23.11,Default,,0,0,0,,Менен сұрасаңыз...
Dialogue: 0,0:12:23.57,0:12:25.91,Default,,0,0,0,,Мен өзімді жынды сезіне бастадым.
Dialogue: 0,0:12:31.04,0:12:32.12,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:12:32.25,0:12:34.87,Default,,0,0,0,,Гигант... Бірақ ол өлді.
Dialogue: 0,0:12:38.59,0:12:40.76,Default,,0,0,0,,Жарайды ма? Өлген болса да
Dialogue: 0,0:12:40.88,0:12:42.84,Default,,0,0,0,,Ол өлді, сондықтан бәрі жақсы.
Dialogue: 0,0:12:42.97,0:12:46.26,Default,,0,0,0,,Ең болмаса, біз оны тиімді пайдалануымыз керек.
Dialogue: 0,0:12:49.60,0:12:50.60,Default,,0,0,0,,қою қара
Dialogue: 0,0:12:50.72,0:12:54.35,Default,,0,0,0,,Мұқият қарасаңыз, бізді көре алуыңыз керек.
Dialogue: 0,0:12:54.48,0:12:56.15,Default,,0,0,0,,Кеттік, иә.
Dialogue: 0,0:13:04.90,0:13:06.28,Default,,0,0,0,,Капитан қайтып келді
Dialogue: 0,0:13:07.11,0:13:09.78,Default,,0,0,0,,Императрицалар жоқ. Не болды?
Dialogue: 0,0:13:13.70,0:13:14.54,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:13:14.66,0:13:18.04,Default,,0,0,0,,Гигант қол кептеліп қалды, мен өте алмаймын. Бірдеңе болды ма?
Dialogue: 0,0:13:18.67,0:13:20.04,Default,,0,0,0,,Иә, таптым.
Dialogue: 0,0:13:25.47,0:13:26.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:27.84,0:13:29.68,Default,,0,0,0,,Императрица кодын тексеріңіз
Dialogue: 0,0:13:29.80,0:13:31.81,Default,,0,0,0,,Жүйені қайта жүктеңіз
Dialogue: 0,0:13:32.14,0:13:33.93,Default,,0,0,0,,Не?
Dialogue: 0,0:13:34.06,0:13:35.48,Default,,0,0,0,,Бұл жігіт әлі тірі!
Dialogue: 0,0:13:35.60,0:13:36.44,Default,,0,0,0,,тартып шығарыңыз
Dialogue: 0,0:13:37.52,0:13:38.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:38.60,0:13:39.52,Default,,0,0,0,,Міне, осылайша-ақ қырылып қалады!
Dialogue: 0,0:13:39.81,0:13:40.77,Default,,0,0,0,,Ооо... (полковник) Ооо!
Dialogue: 0,0:13:41.40,0:13:42.23,Default,,0,0,0,,Не?
Dialogue: 0,0:13:42.48,0:13:45.11,Default,,0,0,0,,Шайқау әдеттен тыс. Жақында жүземіз.
Dialogue: 0,0:13:45.65,0:13:46.99,Default,,0,0,0,,Императрицалар әлі де...
Dialogue: 0,0:13:47.45,0:13:49.66,Default,,0,0,0,,Кеме қауіпсіздігі бірінші орында
Dialogue: 0,0:13:50.41,0:13:51.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:53.58,0:13:55.87,Default,,0,0,0,,Мен оны қабылдай алмаймын.
Dialogue: 0,0:14:00.25,0:14:02.88,Default,,0,0,0,,Empress кодын жаңарту қатесі
Dialogue: 0,0:14:03.00,0:14:05.05,Default,,0,0,0,,Empress кодын жаңарту қатесі
Dialogue: 0,0:14:05.71,0:14:10.05,Default,,0,0,0,,Императрица кодын қатесі Императрица коды…
Dialogue: 0,0:14:13.43,0:14:14.81,Default,,0,0,0,,Енді сіз өзіңізді еркін сезінесіз.
Dialogue: 0,0:14:22.57,0:14:24.07,Default,,0,0,0,,Жан тыныштығы...
Dialogue: 0,0:14:24.32,0:14:25.65,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:14:30.53,0:14:32.07,Default,,0,0,0,,Гррр... Жүр!
Dialogue: 0,0:14:32.62,0:14:35.37,Default,,0,0,0,,Сіз қатты қышудан құтылдыңыз.
Dialogue: 0,0:14:35.49,0:14:36.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:38.33,0:14:40.17,Default,,0,0,0,,Діріл басылды.
Dialogue: 0,0:14:40.29,0:14:41.96,Default,,0,0,0,,Императрицаны күтіңіз
Dialogue: 0,0:14:42.08,0:14:44.75,Default,,0,0,0,,Дәл қазір діріл қалыпты емес.
Dialogue: 0,0:14:44.88,0:14:47.67,Default,,0,0,0,,Қауіпсіздікті растау мүмкін болмаса, дереу кетіңіз
Dialogue: 0,0:14:48.01,0:14:49.43,Default,,0,0,0,,Күте тұрыңыз, күтіңіз
Dialogue: 0,0:14:49.55,0:14:52.39,Default,,0,0,0,,Жағдайларды ескерсек, ол жігіттер бірдеңе істеген болуы керек.
Dialogue: 0,0:14:52.51,0:14:54.93,Default,,0,0,0,,Мен өз есегімді сүртейін, желкенді жіберейін.
Dialogue: 0,0:14:55.26,0:14:58.06,Default,,0,0,0,,Полковник, сіз шынымен өлгіңіз келе ме?
Dialogue: 0,0:14:58.18,0:14:59.18,Default,,0,0,0,,Міне, осылайша-ақ қырылып қалады!
Dialogue: 0,0:15:01.31,0:15:02.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:02.90,0:15:04.06,Default,,0,0,0,,Императрица!
Dialogue: 0,0:15:05.86,0:15:07.03,Default,,0,0,0,,Ай…
Dialogue: 0,0:15:11.36,0:15:13.03,Default,,0,0,0,,Мына қарғыс атқыр жәндіктерді аулаушы!
Dialogue: 0,0:15:13.32,0:15:15.20,Default,,0,0,0,,Тоқта, ақымақ!
Dialogue: 0,0:15:15.53,0:15:16.79,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:15:24.34,0:15:25.17,Default,,0,0,0,,Желкенді жібер!
Dialogue: 0,0:15:31.18,0:15:34.05,Default,,0,0,0,,Міне, үйір бөлімі келеді.
Dialogue: 0,0:15:34.47,0:15:38.18,Default,,0,0,0,,Ойланып қарасам, қарудың заңсыз екенін ұмытып кетіппін.
Dialogue: 0,0:15:38.35,0:15:39.68,Default,,0,0,0,,Олар да бізді осы жерден қуып келеді!
Dialogue: 0,0:15:41.69,0:15:43.31,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:15:44.23,0:15:45.31,Default,,0,0,0,,Эй!
Dialogue: 0,0:15:46.23,0:15:47.82,Default,,0,0,0,,Көзіңді жұм!
Dialogue: 0,0:15:48.36,0:15:50.36,Default,,0,0,0,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,0:15:50.61,0:15:51.49,Default,,0,0,0,,О, күте тұрыңыз ...
Dialogue: 0,0:15:51.90,0:15:53.49,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:15:55.16,0:15:56.66,Default,,0,0,0,,О, рахмет.
Dialogue: 0,0:15:56.78,0:15:57.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:00.62,0:16:02.46,Default,,0,0,0,,ше? Сен не істеп жатырсың?
Dialogue: 0,0:16:02.83,0:16:06.21,Default,,0,0,0,,Мен өміріме өкінемін. Мен мұны алып қашып кетемін деп ойлаймын.
Dialogue: 0,0:16:08.59,0:16:09.96,Default,,0,0,0,,...
Dialogue: 0,0:16:11.55,0:16:14.34,Default,,0,0,0,,Менен осылай жоғалып кетуді жоспарлап отырсыз ба?
Dialogue: 0,0:16:18.89,0:16:21.43,Default,,0,0,0,,Менің өмірім ұзақ емес
Dialogue: 0,0:16:21.56,0:16:23.64,Default,,0,0,0,,Сондықтан мен қармақпын
Dialogue: 0,0:16:23.85,0:16:25.35,Default,,0,0,0,,Мен Мониканың өлуіне жол бермеймін
Dialogue: 0,0:16:25.69,0:16:26.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:28.23,0:16:30.40,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:16:31.74,0:16:32.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:33.40,0:16:34.86,Default,,0,0,0,,Уф... Исана
Dialogue: 0,0:16:35.03,0:16:36.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:37.32,0:16:38.87,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:16:40.41,0:16:41.79,Default,,0,0,0,,Өзімді жоғалтып алған сияқтымын.
Dialogue: 0,0:16:43.96,0:16:44.92,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:16:47.13,0:16:48.04,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:52.97,0:16:54.05,Default,,0,0,0,,Императрица Топ!
Dialogue: 0,0:16:54.59,0:16:55.59,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:16:59.56,0:17:00.85,Default,,0,0,0,,Ол шықты...
Dialogue: 0,0:17:01.35,0:17:04.39,Default,,0,0,0,,Қашып кететін жер жоқ. Осылай кете берсек, құрып кетеміз!
Dialogue: 0,0:17:07.27,0:17:08.65,Default,,0,0,0,,Моника! Сен не істеп жатырсың!
Dialogue: 0,0:17:08.98,0:17:11.94,Default,,0,0,0,,Қауіпті көрінеді, сондықтан мен бағалы затты алып қашамын.
Dialogue: 0,0:17:12.07,0:17:12.90,Default,,0,0,0,,Іздемеңіз!
Dialogue: 0,0:17:13.15,0:17:15.40,Default,,0,0,0,,Әлгі бейбақ отты ұры!
Dialogue: 0,0:17:15.99,0:17:17.78,Default,,0,0,0,,Жоқ, маған жем болып жатыр.
Dialogue: 0,0:17:19.83,0:17:21.33,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:17:21.45,0:17:22.29,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:17:22.75,0:17:25.00,Default,,0,0,0,,Иттер өз боқтарын жинамайды
Dialogue: 0,0:17:25.12,0:17:28.04,Default,,0,0,0,,Бірақ иттің тезегін жинау иесінің міндеті.
Dialogue: 0,0:17:28.38,0:17:29.79,Default,,0,0,0,,Онда... (Полковник) Барыңыз.
Dialogue: 0,0:17:29.92,0:17:31.34,Default,,0,0,0,,Дезертирді ұстаңыз!
Dialogue: 0,0:17:31.46,0:17:32.80,Default,,0,0,0,,Иә, мен барамын.
Dialogue: 0,0:17:37.63,0:17:38.76,Default,,0,0,0,,Императрица!
Dialogue: 0,0:17:43.47,0:17:44.31,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:52.27,0:17:56.36,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:57.74,0:17:58.86,Default,,0,0,0,,Салқындату
Dialogue: 0,0:18:05.91,0:18:07.83,Default,,0,0,0,,Енді белгіге жету оңайырақ.
Dialogue: 0,0:18:10.17,0:18:11.17,Default,,0,0,0,,Оны жеме!
Dialogue: 0,0:18:11.34,0:18:12.42,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:18:14.80,0:18:15.88,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:19.26,0:18:21.30,Default,,0,0,0,,Баяғыда... Жоғалып кеткен саған
Dialogue: 0,0:18:21.43,0:18:22.47,Default,,0,0,0,,Менің айтарым бар еді.
Dialogue: 0,0:18:23.47,0:18:25.47,Default,,0,0,0,,Кенет... не?
Dialogue: 0,0:18:26.39,0:18:28.48,Default,,0,0,0,,Өлсең көз алдымда өл.
Dialogue: 0,0:18:30.73,0:18:32.94,Default,,0,0,0,,Иә... Мен мұны істеймін.
Dialogue: 0,0:18:36.49,0:18:38.70,Default,,0,0,0,,Өлейін, ақымақ.
Dialogue: 0,0:18:38.86,0:18:42.45,Default,,0,0,0,,Мен енді өмірімнің мәнінен айырылғым келмейді.
Dialogue: 0,0:18:48.12,0:18:49.25,Default,,0,0,0,,Қалай болғанда да, бастайық!
Dialogue: 0,0:19:03.26,0:19:04.14,Default,,0,0,0,,Гррр…
Dialogue: 0,0:19:07.27,0:19:08.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:16.69,0:19:18.78,Default,,0,0,0,,Исана~!
Dialogue: 0,0:19:25.45,0:19:26.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:26.66,0:19:27.54,Default,,0,0,0,,Императрица…
Dialogue: 0,0:19:28.12,0:19:29.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:39.17,0:19:41.38,Default,,0,0,0,,Императрица коды жаңартуларын тексеріңіз
Dialogue: 0,0:19:41.51,0:19:43.80,Default,,0,0,0,,РНҚ транскрипциясының басталуы
Dialogue: 0,0:19:58.11,0:19:59.94,Default,,0,0,0,,Жақсартуды орындау
Dialogue: 0,0:20:12.50,0:20:13.33,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:20:22.76,0:20:23.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:31.27,0:20:32.23,Default,,0,0,0,,Аа...
Dialogue: 0,0:20:40.19,0:20:42.99,Default,,0,0,0,,Сабу! Жақсы болды, мен куртка алып келдім.
Dialogue: 0,0:20:43.45,0:20:44.95,Default,,0,0,0,,Хе-хе-хе
Dialogue: 0,0:20:45.16,0:20:46.53,Default,,0,0,0,,Осыдан кейін орбиталық элеватор шабуылы...
Dialogue: 0,0:20:46.66,0:20:49.12,Default,,0,0,0,,Біз сізді кездесу орнына апарамыз.
Dialogue: 0,0:20:49.24,0:20:50.66,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:20:50.79,0:20:53.29,Default,,0,0,0,,Сондай-ақ, осыны сұрады.
Dialogue: 0,0:20:54.62,0:20:56.25,Default,,0,0,0,,Императрица ше?
Dialogue: 0,0:20:56.38,0:20:59.17,Default,,0,0,0,,Мен ұйықтап жатырмын. Меніңше, менде аздап қызу бар.
Dialogue: 0,0:20:59.67,0:21:00.92,Default,,0,0,0,,Осыншама энергия
Dialogue: 0,0:21:01.05,0:21:04.09,Default,,0,0,0,,Мен бәрін бірден сіңірдім, сондықтан бұл таңқаларлық емес.
Dialogue: 0,0:21:04.97,0:21:07.34,Default,,0,0,0,,Күтпеген қиыншылықтар болды.
Dialogue: 0,0:21:07.47,0:21:09.85,Default,,0,0,0,,Жоспар бойынша Темір теңізінен өтті.
Dialogue: 0,0:21:10.18,0:21:11.77,Default,,0,0,0,,Уәде етілген сыйлық.
Dialogue: 0,0:21:14.64,0:21:16.23,Default,,0,0,0,,үшін осы ма?
Dialogue: 0,0:21:16.81,0:21:21.23,Default,,0,0,0,,Бұл қауіпті төлем. Сондай-ақ өтемақы алуға құқығы бар.
Dialogue: 0,0:21:24.15,0:21:24.99,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:25.40,0:21:27.49,Default,,0,0,0,,Сан-Диего елді мекені…
Dialogue: 0,0:21:27.91,0:21:29.74,Default,,0,0,0,,Сізді бір нәрсе мазалайды ма?
Dialogue: 0,0:21:30.83,0:21:32.74,Default,,0,0,0,,А... жоқ
Dialogue: 0,0:21:33.66,0:21:37.00,Default,,0,0,0,,Мен оны шынымен де алдым, бәріңіз аман-есенсіздер деп үміттенемін.
Dialogue: 0,0:21:37.75,0:21:40.25,Default,,0,0,0,,Сонымен, сіз не істейсіз?
Dialogue: 0,0:21:40.38,0:21:43.38,Default,,0,0,0,,Сонымен? Әрине, мен сенің соңынан еремін.
Dialogue: 0,0:21:43.51,0:21:45.51,Default,,0,0,0,,Осы темір теңізге көзім жетті.
Dialogue: 0,0:21:45.63,0:21:48.84,Default,,0,0,0,,Болашақта бұдан да құнды дүниелер алатыныңызға сенімдімін!
Dialogue: 0,0:21:48.97,0:21:49.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:50.43,0:21:51.39,Default,,0,0,0,,Моника
Dialogue: 0,0:21:52.56,0:21:53.39,Default,,0,0,0,,Не?
Dialogue: 0,0:21:53.93,0:21:55.14,Default,,0,0,0,,Тағы кездескенше...
Dialogue: 0,0:21:55.52,0:21:56.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:58.35,0:22:00.65,Default,,0,0,0,,Ах, мен қайтып келгенде...
Dialogue: 0,0:22:01.19,0:22:02.65,Default,,0,0,0,,Теңізге барайық
Dialogue: 0,0:22:03.23,0:22:05.74,Default,,0,0,0,,Бұл жолы махаббатты еске алу
Dialogue: 0,0:22:08.28,0:22:10.07,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:22:11.07,0:22:13.08,Default,,0,0,0,,♪～
Dialogue: 0,0:23:36.95,0:23:38.95,Default,,0,0,0,,～♪
