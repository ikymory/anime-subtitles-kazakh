Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.72,0:00:14.34,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:00:18.60,0:00:19.43,Default,,0,0,0,,Иә
Dialogue: 0,0:00:19.89,0:00:22.93,Default,,0,0,0,,Енді біз мәңгі бірге күресе аламыз.
Dialogue: 0,0:00:26.48,0:00:29.94,Default,,0,0,0,,Мәңгілік өмір сүру өте қиын
Dialogue: 0,0:00:30.61,0:00:31.44,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:00:33.24,0:00:35.41,Default,,0,0,0,,Уф... әф!
Dialogue: 0,0:00:38.07,0:00:41.95,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:00:42.20,0:00:44.83,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:00:44.96,0:00:46.96,Default,,0,0,0,,Менің басым... ауырып тұр.
Dialogue: 0,0:00:49.50,0:00:51.50,Default,,0,0,0,,♪～
Dialogue: 0,0:02:16.92,0:02:18.93,Default,,0,0,0,,～♪
Dialogue: 0,0:02:29.06,0:02:30.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:32.23,0:02:33.65,Default,,0,0,0,,Кяа~!
Dialogue: 0,0:02:35.69,0:02:36.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:38.36,0:02:40.70,Default,,0,0,0,,(ішу дыбысы)
Dialogue: 0,0:02:41.20,0:02:42.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:46.08,0:02:47.95,Default,,0,0,0,,Қария... бұл екінші көмек.
Dialogue: 0,0:02:51.71,0:02:55.59,Default,,0,0,0,,Менің артымнан ермеңіз, мұның бәрі дұрыс емес.
Dialogue: 0,0:02:56.71,0:02:59.88,Default,,0,0,0,,Эй, сен басқа тұтынушылардан қорқасың.
Dialogue: 0,0:03:00.01,0:03:01.97,Default,,0,0,0,,Үйге кететін уақыт болды... Эй!
Dialogue: 0,0:03:02.47,0:03:03.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:04.14,0:03:05.51,Default,,0,0,0,,(Адамды қалдыру)
Dialogue: 0,0:03:05.64,0:03:06.47,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:03:07.02,0:03:08.27,Default,,0,0,0,,Иә~
Dialogue: 0,0:03:08.39,0:03:10.98,Default,,0,0,0,,Дүкеннің алдында құсуға болмайды!
Dialogue: 0,0:03:14.48,0:03:18.48,Default,,0,0,0,,Сен кімсің өзі…
Dialogue: 0,0:03:18.65,0:03:19.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:24.32,0:03:28.16,Default,,0,0,0,,Өз құсығыңа қатты батып бара жатырсың, қарғыс атсын...
Dialogue: 0,0:03:28.29,0:03:29.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:31.75,0:03:36.50,Default,,0,0,0,,Маған көмектесіңізші... Бекініс қалаға шабуыл жасалып жатыр...
Dialogue: 0,0:03:39.38,0:03:42.47,Default,,0,0,0,,Бұл қолданыста, оны жоғалтпаңыз.
Dialogue: 0,0:03:42.59,0:03:44.26,Default,,0,0,0,,Қалай болғанда да, бастайық!
Dialogue: 0,0:03:47.18,0:03:48.26,Default,,0,0,0,,≫ Тап-тап-тап (аяқ дыбысы) (Ол Майт) Һм?
Dialogue: 0,0:03:50.93,0:03:52.77,Default,,0,0,0,,Сен... Күш
Dialogue: 0,0:03:53.35,0:03:55.65,Default,,0,0,0,,Сіз бұл баласыз ба? Мен сені өлтіремін.
Dialogue: 0,0:03:56.06,0:03:57.23,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:57.65,0:03:58.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:59.40,0:04:02.24,Default,,0,0,0,,Императрицаға дереу қоңырау шалыңыз.
Dialogue: 0,0:04:02.40,0:04:03.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:03.53,0:04:07.99,Default,,0,0,0,,Бұл есімді естігенде тітіркенеміз!
Dialogue: 0,0:04:08.16,0:04:09.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:09.54,0:04:10.37,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:12.04,0:04:15.54,Default,,0,0,0,,Менің әпкемді оқу орны ұрлап әкетті.
Dialogue: 0,0:04:15.67,0:04:16.75,Default,,0,0,0,,Біз сізге тез көмектесуіміз керек!
Dialogue: 0,0:04:16.96,0:04:19.25,Default,,0,0,0,,Кет, балам! Оған тиме!
Dialogue: 0,0:04:19.42,0:04:21.05,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:04:24.09,0:04:24.93,Default,,0,0,0,,Чи…
Dialogue: 0,0:04:27.64,0:04:29.89,Default,,0,0,0,,Эй, сен оқу орнының агентісің бе?
Dialogue: 0,0:04:30.01,0:04:32.43,Default,,0,0,0,,Жоқ! Бірақ олар менің әпкемнен айырылды...
Dialogue: 0,0:04:46.53,0:04:47.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:59.88,0:05:02.26,Default,,0,0,0,,Сөзсіз гемиттер бірлігі.
Dialogue: 0,0:05:02.38,0:05:03.21,Default,,0,0,0,,Онымен айналысыңыз.
Dialogue: 0,0:05:03.46,0:05:06.80,Default,,0,0,0,,ше? Мен сені өлтірмейтініне сенімдімін.
Dialogue: 0,0:05:07.05,0:05:09.22,Default,,0,0,0,,Ах... уау!
Dialogue: 0,0:05:09.80,0:05:10.72,Default,,0,0,0,,Мен... Бұл Риппл! Ол Рипплді қолдануда!
Dialogue: 0,0:05:12.14,0:05:14.73,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:05:16.73,0:05:18.02,Default,,0,0,0,,Не болды!
Dialogue: 0,0:05:18.19,0:05:21.11,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:05:21.27,0:05:22.11,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:23.07,0:05:25.19,Default,,0,0,0,,Пу...
Dialogue: 0,0:05:25.36,0:05:27.07,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:05:31.37,0:05:32.37,Default,,0,0,0,,Хаха!
Dialogue: 0,0:05:35.12,0:05:36.62,Default,,0,0,0,,Тамақ... Не!
Dialogue: 0,0:05:44.21,0:05:45.76,Default,,0,0,0,,Арче! Боқ...
Dialogue: 0,0:06:04.78,0:06:06.24,Default,,0,0,0,,(сорғыш дыбыс)
Dialogue: 0,0:06:16.79,0:06:17.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:18.00,0:06:20.12,Default,,0,0,0,,Хе... у...
Dialogue: 0,0:06:21.25,0:06:23.88,Default,,0,0,0,,Уф... зорлық-зомбылыққа қарсы.
Dialogue: 0,0:06:26.76,0:06:27.63,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:32.97,0:06:33.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:37.73,0:06:42.15,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:06:42.56,0:06:43.65,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:06:50.28,0:06:51.28,Default,,0,0,0,,Жеңіс
Dialogue: 0,0:07:05.46,0:07:06.75,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:07:30.19,0:07:32.82,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:07:35.28,0:07:38.58,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:07:39.75,0:07:43.54,Default,,0,0,0,,Turquoise Blue Overdrive — су астында қолдануға арналған толқын!
Dialogue: 0,0:07:46.17,0:07:49.59,Default,,0,0,0,,Императрица Барлық дронның дұшпандық реакциялары Жоғалу
Dialogue: 0,0:07:50.17,0:07:51.59,Default,,0,0,0,,Шайқас аяқталды.
Dialogue: 0,0:07:52.26,0:07:53.09,Default,,0,0,0,,Иә
Dialogue: 0,0:07:56.51,0:07:58.22,Default,,0,0,0,,Базаны бақылауды растау
Dialogue: 0,0:07:58.35,0:08:00.27,Default,,0,0,0,,Қарсыластың бей-берекет әуе соққылары салдарынан
Dialogue: 0,0:08:00.39,0:08:04.52,Default,,0,0,0,,Солдаттар да, оқу орындарының ұрланғандары да
Dialogue: 0,0:08:05.35,0:08:07.40,Default,,0,0,0,,Survivor Zero
Dialogue: 0,0:08:18.87,0:08:20.70,Default,,0,0,0,,Мен сені қайтадан құтқара алмадым
Dialogue: 0,0:08:23.37,0:08:25.29,Default,,0,0,0,,Полковник Шарлотта?
Dialogue: 0,0:08:26.88,0:08:30.51,Default,,0,0,0,,Қудалау аймағынан құтылу өте жылдам болды.
Dialogue: 0,0:08:32.55,0:08:34.30,Default,,0,0,0,,Көлік пойызында қалды -
Dialogue: 0,0:08:34.43,0:08:38.72,Default,,0,0,0,,Мен құрбандыққа шалынатын қыздардың дерекқорын құтқардым.
Dialogue: 0,0:08:38.97,0:08:41.77,Default,,0,0,0,,Мен жақсы және жаман жаңалықтар алдым.
Dialogue: 0,0:08:41.89,0:08:43.60,Default,,0,0,0,,Сіз қайсысын тыңдағыңыз келеді?
Dialogue: 0,0:08:43.73,0:08:44.56,Default,,0,0,0,,Жақсы жаңалық
Dialogue: 0,0:08:45.02,0:08:46.60,Default,,0,0,0,,Мен мұны істеуім керек.
Dialogue: 0,0:08:46.73,0:08:50.65,Default,,0,0,0,,Енді GPS қол жетімді емес, пойыз операциялары
Dialogue: 0,0:08:50.78,0:08:54.32,Default,,0,0,0,,Мен оны дәстүрлі диаграмма құру арқылы басқарамын...
Dialogue: 0,0:08:54.78,0:08:56.95,Default,,0,0,0,,Сіз не білдіңіз?
Dialogue: 0,0:08:57.37,0:08:59.91,Default,,0,0,0,,Көлік пойыздары және оқу орнының штабы
Dialogue: 0,0:09:00.03,0:09:02.58,Default,,0,0,0,,Біріктіру координаталарын анықтай алдық.
Dialogue: 0,0:09:03.00,0:09:04.83,Default,,0,0,0,,Басқаша айтқанда, пойызбен жүрсеңіз...
Dialogue: 0,0:09:05.25,0:09:09.34,Default,,0,0,0,,Смайл бар, оқу орнының жетекшісі.
Dialogue: 0,0:09:12.76,0:09:13.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:18.76,0:09:19.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:23.85,0:09:25.85,Default,,0,0,0,,Ал жаман жаңалық?
Dialogue: 0,0:09:27.27,0:09:28.69,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:09:30.69,0:09:34.11,Default,,0,0,0,,Бұл әлсіз көзге қарғыс...
Dialogue: 0,0:09:36.24,0:09:37.07,Default,,0,0,0,,Мия…
Dialogue: 0,0:09:37.57,0:09:38.53,Default,,0,0,0,,Норито ше?
Dialogue: 0,0:09:38.66,0:09:41.24,Default,,0,0,0,,Өйткені құрбандық тек қыздарға арналған.
Dialogue: 0,0:09:41.37,0:09:42.79,Default,,0,0,0,,Мүмкін қазірдің өзінде...
Dialogue: 0,0:09:46.46,0:09:47.29,Default,,0,0,0,,Кеттік
Dialogue: 0,0:09:47.42,0:09:48.79,Default,,0,0,0,,Егер сіз тоқтасаңыз
Dialogue: 0,0:09:48.92,0:09:51.71,Default,,0,0,0,,Көмек бере алатын адам көмектесе алмай қалады.
Dialogue: 0,0:10:14.78,0:10:17.36,Default,,0,0,0,,Иә? А, күте тұрыңыз.
Dialogue: 0,0:10:17.49,0:10:19.16,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:10:19.28,0:10:20.82,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:10:20.99,0:10:23.83,Default,,0,0,0,,А... сен мені ұмыттың!
Dialogue: 0,0:10:23.95,0:10:27.66,Default,,0,0,0,,Әй, маған мінгіз! Өтінемін, маған көлік беріңізші!
Dialogue: 0,0:10:35.96,0:10:37.72,Default,,0,0,0,,Олар барлық жерде.
Dialogue: 0,0:10:38.34,0:10:41.97,Default,,0,0,0,,Уф... мен оны тауып алғанша уақыт мәселесі.
Dialogue: 0,0:10:42.64,0:10:46.14,Default,,0,0,0,,Берілмеңіз және келесі жолды іздеңіз
Dialogue: 0,0:10:46.27,0:10:47.60,Default,,0,0,0,,Иә...
Dialogue: 0,0:10:49.85,0:10:50.81,Default,,0,0,0,,Ум...
Dialogue: 0,0:10:50.94,0:10:52.44,Default,,0,0,0,,Не?
Dialogue: 0,0:10:52.56,0:10:55.19,Default,,0,0,0,,Жоқ, атмосфера мүлдем өзгермейді.
Dialogue: 0,0:10:55.32,0:10:59.24,Default,,0,0,0,,Оның Гигант қолы болған кезде ол өте күшті болып көрінді.
Dialogue: 0,0:10:59.49,0:11:02.07,Default,,0,0,0,,Өйткені онсыз біртүрлі болар еді...
Dialogue: 0,0:11:02.41,0:11:04.24,Default,,0,0,0,,А, жоқ, олай емес...
Dialogue: 0,0:11:04.37,0:11:06.83,Default,,0,0,0,,Бұл кішкентай және сүйкімді.
Dialogue: 0,0:11:07.04,0:11:08.12,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:11:09.00,0:11:10.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:11.67,0:11:13.13,Default,,0,0,0,,О... Эй!
Dialogue: 0,0:11:14.88,0:11:15.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:30.89,0:11:33.98,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:11:35.36,0:11:36.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:38.36,0:11:39.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:40.15,0:11:40.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:46.74,0:11:48.83,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:11:50.50,0:11:51.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:52.37,0:11:53.50,Default,,0,0,0,,Жақсы
Dialogue: 0,0:11:58.88,0:12:02.09,Default,,0,0,0,,Кеттік. Егер біз осында қалсақ, олар бізді табады.
Dialogue: 0,0:12:02.63,0:12:05.43,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,0:12:05.64,0:12:07.30,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:12:08.97,0:12:11.31,Default,,0,0,0,,Маған императрица орналасқан жерге нұсқау беріңізші.
Dialogue: 0,0:12:11.68,0:12:12.94,Default,,0,0,0,,Императрица…
Dialogue: 0,0:12:16.94,0:12:18.07,Default,,0,0,0,,Бұл қиын ба?
Dialogue: 0,0:12:18.19,0:12:20.57,Default,,0,0,0,,А... бұл біраз...
Dialogue: 0,0:12:26.37,0:12:27.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:28.53,0:12:31.12,Default,,0,0,0,,Hemiteos бірлігі күшті болса да.
Dialogue: 0,0:12:31.25,0:12:32.96,Default,,0,0,0,,Әркімге қиналып жатыр.
Dialogue: 0,0:12:33.33,0:12:36.46,Default,,0,0,0,,Жоқ, императрица ерекше.
Dialogue: 0,0:12:36.58,0:12:38.34,Default,,0,0,0,,Ол сонда болғандықтан, біз...
Dialogue: 0,0:12:39.67,0:12:42.63,Default,,0,0,0,,Уф... есімде жоқ.
Dialogue: 0,0:12:42.76,0:12:46.59,Default,,0,0,0,,Неге... неге жоғалып кеттің? императрица
Dialogue: 0,0:12:47.47,0:12:50.85,Default,,0,0,0,,Сіз шынымен императрицаның қайда екенін білмейсіз бе?
Dialogue: 0,0:12:51.52,0:12:55.14,Default,,0,0,0,,Мен ештеңе білмеймін және есімде де жоқ
Dialogue: 0,0:12:59.02,0:13:00.82,Default,,0,0,0,,Ах... Эй!
Dialogue: 0,0:13:01.78,0:13:02.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:03.07,0:13:06.11,Default,,0,0,0,,Кішкене демалсам да, ауыратын сияқты.
Dialogue: 0,0:13:07.57,0:13:10.20,Default,,0,0,0,,Қуғыншы келе жатыр. Мен қашуым керек.
Dialogue: 0,0:13:11.24,0:13:12.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:19.00,0:13:21.21,Default,,0,0,0,,Идиоттар абайсызда байқайды
Dialogue: 0,0:13:21.34,0:13:23.38,Default,,0,0,0,,Ол бала сені сатып жіберді.
Dialogue: 0,0:13:24.05,0:13:24.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:30.47,0:13:31.64,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:34.89,0:13:36.14,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:36.81,0:13:40.15,Default,,0,0,0,,Мойынсұнсаң, мен саған әпкемді қайтарамын...
Dialogue: 0,0:13:40.61,0:13:42.15,Default,,0,0,0,,Қаруды үнемдемеңіз
Dialogue: 0,0:13:42.27,0:13:46.15,Default,,0,0,0,,Бұл Ұлы соғыста аман қалған ерекше жауынгерлік машина.
Dialogue: 0,0:13:46.49,0:13:49.16,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:13:52.58,0:13:55.96,Default,,0,0,0,,(Күштің жылдам тынысы)
Dialogue: 0,0:13:57.33,0:14:00.17,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:14:00.50,0:14:02.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:02.55,0:14:05.26,Default,,0,0,0,,Қаш! Бәріне менің кінәм
Dialogue: 0,0:14:05.38,0:14:07.63,Default,,0,0,0,,Бірақ менің әпкем... Мия жалғыз!
Dialogue: 0,0:14:08.05,0:14:09.18,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:14:10.01,0:14:10.89,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:12.35,0:14:15.64,Default,,0,0,0,,Уф... әф!
Dialogue: 0,0:14:17.31,0:14:19.14,Default,,0,0,0,,Уууу!
Dialogue: 0,0:14:20.44,0:14:21.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:24.19,0:14:25.78,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:14:26.36,0:14:27.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:38.16,0:14:41.79,Default,,0,0,0,,Ол осы биіктіктен тастың астында қалып қойды. Ол өлген шығар.
Dialogue: 0,0:14:42.17,0:14:43.04,Default,,0,0,0,,Ха…
Dialogue: 0,0:14:43.38,0:14:44.67,Default,,0,0,0,,Мені ал
Dialogue: 0,0:14:44.80,0:14:47.88,Default,,0,0,0,,Уф... Шіркін, жібер!
Dialogue: 0,0:14:48.42,0:14:51.09,Default,,0,0,0,,Мия~!
Dialogue: 0,0:14:57.68,0:15:02.10,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:15:04.15,0:15:07.48,Default,,0,0,0,,Жоқ, жоқ... Мен әлі де адамдарды жек көремін.
Dialogue: 0,0:15:09.74,0:15:12.41,Default,,0,0,0,,Тез опасыздық, тез сындыру
Dialogue: 0,0:15:12.53,0:15:14.78,Default,,0,0,0,,Тәтті, адамдар ақымақ!
Dialogue: 0,0:15:17.33,0:15:21.00,Default,,0,0,0,,Бірақ бұлай жалғаса берсе, ол бала өлтіріледі.
Dialogue: 0,0:15:21.12,0:15:22.67,Default,,0,0,0,,Менің әпкемнің де...
Dialogue: 0,0:15:23.08,0:15:26.63,Default,,0,0,0,,Оған мән бермеңіз. Көмектессең де өлтіресің.
Dialogue: 0,0:15:26.75,0:15:27.92,Default,,0,0,0,,Әрқашан солай болған.
Dialogue: 0,0:15:28.80,0:15:33.68,Default,,0,0,0,,Гемиттер бірлігі мәңгілік, бірақ адамдар мәңгілік емес...
Dialogue: 0,0:15:34.35,0:15:35.76,Default,,0,0,0,,Адамдар тым нәзік
Dialogue: 0,0:15:35.89,0:15:38.43,Default,,0,0,0,,Барлығы соғыста қаза тапты. Соңы жоқ!
Dialogue: 0,0:15:39.85,0:15:43.94,Default,,0,0,0,,Сондықтан... Мен адамдарды ұнатпаймын.
Dialogue: 0,0:15:44.36,0:15:46.82,Default,,0,0,0,,Сонда да басымдағы ауырсыну кетпейді!
Dialogue: 0,0:15:52.28,0:15:54.16,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:15:56.70,0:16:01.96,Default,,0,0,0,,Сіз бұлай болатынын әу бастан білдіңіз бе? императрица
Dialogue: 0,0:16:02.50,0:16:05.96,Default,,0,0,0,,Мәңгілік өмір сүру өте қиын
Dialogue: 0,0:16:06.63,0:16:07.46,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:07.71,0:16:11.09,Default,,0,0,0,,Дегенмен! Неге тағы ұрысып жатырсың?
Dialogue: 0,0:16:11.22,0:16:12.84,Default,,0,0,0,,Адамдарды қорғауға тырысу!
Dialogue: 0,0:16:13.97,0:16:15.34,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:16:25.77,0:16:28.48,Default,,0,0,0,,...
Dialogue: 0,0:16:28.61,0:16:29.69,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:16:37.62,0:16:39.16,Default,,0,0,0,,Жауабы...
Dialogue: 0,0:16:48.42,0:16:51.05,Default,,0,0,0,,Ол маған опасыздық жасай алатын бала.
Dialogue: 0,0:16:51.17,0:16:53.30,Default,,0,0,0,,Білім беруге тұрарлық емес
Dialogue: 0,0:16:53.55,0:16:54.63,Default,,0,0,0,,Мен оны шешемін.
Dialogue: 0,0:16:55.01,0:16:57.30,Default,,0,0,0,,Мм... Маған бәрібір.
Dialogue: 0,0:16:57.43,0:17:00.31,Default,,0,0,0,,Тэцукайға қабілетсіз адамдар жем болады.
Dialogue: 0,0:17:01.52,0:17:02.93,Default,,0,0,0,,Мен келісемін.
Dialogue: 0,0:17:03.60,0:17:04.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:05.69,0:17:07.73,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:17:16.95,0:17:19.53,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:17:22.20,0:17:23.25,Default,,0,0,0,,Күш…
Dialogue: 0,0:17:23.37,0:17:25.71,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:17:26.17,0:17:28.79,Default,,0,0,0,,Менің қолымнан келеді, менің қолымнан келеді... Мен мұны мүлдем істей аламын
Dialogue: 0,0:17:28.92,0:17:29.79,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:17:33.17,0:17:34.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:37.84,0:17:38.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:40.85,0:17:42.68,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:47.85,0:17:49.44,Default,,0,0,0,,Иә? (мылтық)
Dialogue: 0,0:17:49.69,0:17:50.56,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:00.87,0:18:01.91,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:18:02.03,0:18:05.20,Default,,0,0,0,,Күш – нағыз бақытты бала.
Dialogue: 0,0:18:05.91,0:18:08.21,Default,,0,0,0,,Даусыңыз естілді
Dialogue: 0,0:18:16.97,0:18:19.05,Default,,0,0,0,,Императрица Энергия
Dialogue: 0,0:18:36.90,0:18:38.45,Default,,0,0,0,,Фуккатсу!
Dialogue: 0,0:18:40.24,0:18:42.57,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:18:48.04,0:18:50.58,Default,,0,0,0,,Архемен түгел жұт
Dialogue: 0,0:18:51.04,0:18:54.67,Default,,0,0,0,,Бір қозғалысты екі рет жасайсыз ба?
Dialogue: 0,0:18:58.26,0:18:59.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:00.68,0:19:01.51,Default,,0,0,0,,Мені ұр!
Dialogue: 0,0:19:04.47,0:19:05.39,Default,,0,0,0,,Ұстаңыз!
Dialogue: 0,0:19:05.56,0:19:06.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:06.60,0:19:09.02,Default,,0,0,0,,Жою!
Dialogue: 0,0:19:09.52,0:19:10.73,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:13.02,0:19:15.15,Default,,0,0,0,,Бұл бәрібір.
Dialogue: 0,0:19:15.65,0:19:18.40,Default,,0,0,0,,Зорлық-зомбылықты жақтау!
Dialogue: 0,0:19:27.54,0:19:30.25,Default,,0,0,0,,Дүние сәл жақсарған соң
Dialogue: 0,0:19:30.37,0:19:32.00,Default,,0,0,0,,Қайта туылғанымды қалаймын
Dialogue: 0,0:19:36.13,0:19:39.09,Default,,0,0,0,,Біз енді оқу орнының штаб-пәтеріне шабуыл жасаймыз
Dialogue: 0,0:19:39.42,0:19:41.01,Default,,0,0,0,,Сенің де келгеніңді қалаймын.
Dialogue: 0,0:19:41.93,0:19:44.14,Default,,0,0,0,,Сізбен бірге болғаныма өкінемін.
Dialogue: 0,0:19:44.51,0:19:45.60,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:19:47.06,0:19:48.14,Default,,0,0,0,,Норито
Dialogue: 0,0:19:49.43,0:19:50.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:52.19,0:19:53.02,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:53.65,0:19:57.82,Default,,0,0,0,,Ұрланған пойыз бен оқу орнының штаб-пәтері арасындағы түйісу нүктесі
Dialogue: 0,0:19:58.23,0:20:01.57,Default,,0,0,0,,Мия апаңды осында алып кетті.
Dialogue: 0,0:20:02.03,0:20:03.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:03.91,0:20:05.82,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасайсыз ба?
Dialogue: 0,0:20:05.95,0:20:09.08,Default,,0,0,0,,Бұл мейірімділіктің үлкен қимылы сияқты сезіледі және бұл жиіркенішті.
Dialogue: 0,0:20:09.75,0:20:11.75,Default,,0,0,0,,Күш!
Dialogue: 0,0:20:12.29,0:20:14.46,Default,,0,0,0,,Иә, өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:20:15.96,0:20:19.46,Default,,0,0,0,,Мен сенімен тағы да күресе алатынымды сездім.
Dialogue: 0,0:20:29.81,0:20:33.35,Default,,0,0,0,,Ей, сендер болмасаңдар мен өлетін едім.
Dialogue: 0,0:20:33.48,0:20:35.23,Default,,0,0,0,,Бұл қарыз өтеледі
Dialogue: 0,0:20:42.32,0:20:44.36,Default,,0,0,0,,Бас ауруым басылды.
Dialogue: 0,0:20:50.37,0:20:51.83,Default,,0,0,0,,Енді бұл сізге керек емес пе?
Dialogue: 0,0:20:56.08,0:20:58.17,Default,,0,0,0,,Кешіріңіз... сізді алдағаным үшін.
Dialogue: 0,0:20:59.88,0:21:01.67,Default,,0,0,0,,Не болатынын білесіз бе?
Dialogue: 0,0:21:03.47,0:21:04.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:08.68,0:21:12.14,Default,,0,0,0,,Сізге тек әпкеңізді қайтару туралы ойлануыңыз керек.
Dialogue: 0,0:21:13.18,0:21:15.19,Default,,0,0,0,,Оқу орындары жойылады.
Dialogue: 0,0:21:15.31,0:21:16.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:16.31,0:21:17.15,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:21:26.53,0:21:30.16,Default,,0,0,0,,Мәңгілік өмір сүру өте қиын
Dialogue: 0,0:21:30.83,0:21:31.66,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:33.83,0:21:35.04,Default,,0,0,0,,Саған үйрететін кез келді
Dialogue: 0,0:21:35.46,0:21:38.46,Default,,0,0,0,,Сіз таптырмайтын және маңызды достарды кездестіре аласыз.
Dialogue: 0,0:21:49.39,0:21:51.68,Default,,0,0,0,,Аман болыңыз... Мия!
Dialogue: 0,0:21:58.15,0:21:59.56,Default,,0,0,0,,Аа...
Dialogue: 0,0:22:11.07,0:22:13.08,Default,,0,0,0,,♪～
Dialogue: 0,0:23:36.91,0:23:38.91,Default,,0,0,0,,～♪
