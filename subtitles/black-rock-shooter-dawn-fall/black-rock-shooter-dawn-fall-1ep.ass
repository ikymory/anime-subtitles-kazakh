Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:21.77,0:00:24.44,Default,,0,0,0,,«Сиркемен өзін-өзі өлтіру оқиғасы»
Dialogue: 0,0:00:30.69,0:00:31.78,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:00:31.94,0:00:34.20,Default,,0,0,0,,Металл сынықтары!
Dialogue: 0,0:00:41.58,0:00:42.95,Default,,0,0,0,,Тс!
Dialogue: 0,0:00:48.17,0:00:50.50,Default,,0,0,0,,Императрица қайда және не істеп жатыр?
Dialogue: 0,0:00:51.63,0:00:53.84,Default,,0,0,0,,Қат!
Dialogue: 0,0:01:03.89,0:01:05.64,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:01:34.17,0:01:36.38,Default,,0,0,0,,Эй, сен қайдасың?
Dialogue: 0,0:01:42.81,0:01:44.22,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:01:45.93,0:01:46.77,Default,,0,0,0,,Уф!
Dialogue: 0,0:01:49.98,0:01:51.27,Default,,0,0,0,,Маған жауап беріңіз!
Dialogue: 0,0:02:04.49,0:02:06.91,Default,,0,0,0,,...
Dialogue: 0,0:02:26.43,0:02:28.31,Default,,0,0,0,,Қазірдің өзінде берілме
Dialogue: 0,0:02:35.32,0:02:39.20,Default,,0,0,0,,Бәрі бекер болды, бәрі.
Dialogue: 0,0:02:42.32,0:02:45.33,Default,,0,0,0,,Өмір сүруге де, күресуге де
Dialogue: 0,0:02:47.83,0:02:50.42,Default,,0,0,0,,Мән жоқ...
Dialogue: 0,0:03:13.15,0:03:14.40,Default,,0,0,0,,Міне, осылайша-ақ қырылып қалады!
Dialogue: 0,0:03:23.49,0:03:26.24,Default,,0,0,0,,Біз адамдарды Темір мұхитына жеткізіп жатырмыз.
Dialogue: 0,0:03:30.75,0:03:32.83,Default,,0,0,0,,Ах, 1 Гигант
Dialogue: 0,0:03:33.42,0:03:36.09,Default,,0,0,0,,Ал оққағарлар сансыз.
Dialogue: 0,0:03:36.21,0:03:37.09,Default,,0,0,0,,Маған көмектесе аласыз ба?
Dialogue: 0,0:03:37.42,0:03:39.21,Default,,0,0,0,,Сенің есі дұрыс па?
Dialogue: 0,0:03:49.39,0:03:53.10,Default,,0,0,0,,Кеттік. Бұл жағдайда оны жалғыз қалдыру дұрыс.
Dialogue: 0,0:03:59.86,0:04:01.86,Default,,0,0,0,,♪～
Dialogue: 0,0:05:10.97,0:05:12.97,Default,,0,0,0,,～♪
Dialogue: 0,0:05:20.11,0:05:20.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:21.69,0:05:23.57,Default,,0,0,0,,Ах... Ха!
Dialogue: 0,0:05:24.07,0:05:25.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:26.74,0:05:27.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:34.00,0:05:34.83,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:35.58,0:05:38.42,Default,,0,0,0,,Гохо! Гаха…
Dialogue: 0,0:05:38.71,0:05:40.59,Default,,0,0,0,,(цистернаның ашылған дыбысы)
Dialogue: 0,0:05:44.13,0:05:46.47,Default,,0,0,0,,Ах!Ха ха ха...
Dialogue: 0,0:05:50.35,0:05:51.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:59.15,0:06:01.65,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:06:05.94,0:06:06.94,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:06:07.90,0:06:09.41,Default,,0,0,0,,Сіз дәл қазіргі дыбысты естідіңіз ғой, иә?
Dialogue: 0,0:06:10.45,0:06:12.91,Default,,0,0,0,,Маяк No8 Сегіз саны...
Dialogue: 0,0:06:14.04,0:06:16.37,Default,,0,0,0,,Жоқ, есімде жоқ.
Dialogue: 0,0:06:16.75,0:06:22.54,Default,,0,0,0,,Бірақ мен сонда баруым керек сияқты... Неге?
Dialogue: 0,0:06:22.88,0:06:23.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:25.51,0:06:26.42,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:29.43,0:06:31.55,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:06:33.68,0:06:35.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:38.85,0:06:41.10,Default,,0,0,0,,Бауырым, шөлдеп тұрмын.
Dialogue: 0,0:06:41.60,0:06:44.69,Default,,0,0,0,,Мұндағы сілтілі концентрация стандартты мәннен әлдеқайда жоғары.
Dialogue: 0,0:06:45.02,0:06:48.78,Default,,0,0,0,,Мен қалаға оралғанда суды тексеремін. Оған дейін күтіңіз.
Dialogue: 0,0:06:50.49,0:06:51.86,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:06:54.95,0:06:56.12,Default,,0,0,0,,Жарқырап тұр...
Dialogue: 0,0:06:56.70,0:06:58.62,Default,,0,0,0,,Бұл менің бірінші рет.
Dialogue: 0,0:07:01.46,0:07:02.88,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:07:03.92,0:07:04.96,Default,,0,0,0,,О... Эй!
Dialogue: 0,0:07:07.59,0:07:08.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:09.30,0:07:11.34,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:07:14.10,0:07:18.27,Default,,0,0,0,,Өтінемін, бірдеңе кептеліп қалып, есік ашылмайды.
Dialogue: 0,0:07:19.06,0:07:20.89,Default,,0,0,0,,Біреу құлыптаулы
Dialogue: 0,0:07:21.02,0:07:22.60,Default,,0,0,0,,Кеттік, бұл ақылсыз сияқты.
Dialogue: 0,0:07:22.98,0:07:23.98,Default,,0,0,0,,Бірақ... а
Dialogue: 0,0:07:27.61,0:07:30.24,Default,,0,0,0,,Титандар... бұрынғы жігіттер?
Dialogue: 0,0:07:31.82,0:07:32.99,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:07:35.58,0:07:36.58,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:07:49.42,0:07:50.51,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:51.13,0:07:51.97,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:07:55.43,0:07:57.26,Default,,0,0,0,,Уф... қашып кет, Мия.
Dialogue: 0,0:07:57.60,0:07:58.43,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:04.65,0:08:05.86,Default,,0,0,0,,Осы есікті ашыңыз
Dialogue: 0,0:08:05.98,0:08:06.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:07.40,0:08:10.44,Default,,0,0,0,,Мүмкін мен ұрысатын шығармын...
Dialogue: 0,0:08:11.11,0:08:11.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:14.41,0:08:15.45,Default,,0,0,0,,Есіктен аулақ болыңыз!
Dialogue: 0,0:08:16.57,0:08:17.62,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:08:24.25,0:08:25.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:37.22,0:08:39.64,Default,,0,0,0,,О, біраз болды.
Dialogue: 0,0:08:46.69,0:08:47.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:52.78,0:08:53.61,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:00.16,0:09:00.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:03.70,0:09:06.00,Default,,0,0,0,,Мына бала адам емес пе?
Dialogue: 0,0:09:09.67,0:09:10.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:11.63,0:09:12.46,Default,,0,0,0,,Артында қауіпті!
Dialogue: 0,0:09:22.77,0:09:23.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:24.52,0:09:25.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:27.31,0:09:28.15,Default,,0,0,0,,Эй
Dialogue: 0,0:09:29.23,0:09:31.65,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:09:32.94,0:09:36.86,Default,,0,0,0,,Жоқ, бұл менің жолым...
Dialogue: 0,0:09:41.49,0:09:44.62,Default,,0,0,0,,Маска тақпағаныңыз дұрыс па?
Dialogue: 0,0:09:45.00,0:09:46.21,Default,,0,0,0,,Маска?
Dialogue: 0,0:09:46.54,0:09:48.62,Default,,0,0,0,,Бұл адам емес пе?
Dialogue: 0,0:09:51.34,0:09:52.46,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:09:52.75,0:09:54.34,Default,,0,0,0,,«Мен бірде сенімен жақсылап сөйлескім келеді.»
Dialogue: 0,0:09:54.55,0:09:56.84,Default,,0,0,0,,Артемиданың адам аулайтын ұшқышсыз ұшағы.
Dialogue: 0,0:09:57.05,0:10:00.64,Default,,0,0,0,,Машинаны тамақтандыру үшін оны Темір мұхитына құйыңыз.
Dialogue: 0,0:10:01.26,0:10:02.14,Default,,0,0,0,,Артемида…
Dialogue: 0,0:10:02.89,0:10:05.02,Default,,0,0,0,,Бағана. ➡
Dialogue: 0,0:10:05.31,0:10:07.56,Default,,0,0,0,,О, менің есімде қалған сияқты...
Dialogue: 0,0:10:07.69,0:10:09.56,Default,,0,0,0,,Мен біраз абдырап қалдым
Dialogue: 0,0:10:10.31,0:10:11.77,Default,,0,0,0,,Маған мылтықты көрсетіңіз
Dialogue: 0,0:10:12.77,0:10:15.69,Default,,0,0,0,,Оқ таусылды, солай ма? Егер оқтар болса, оларды толықтырыңыз.
Dialogue: 0,0:10:18.28,0:10:20.91,Default,,0,0,0,,Мен бұрын-соңды мұндай қаруды көрген емеспін.
Dialogue: 0,0:10:22.37,0:10:23.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:24.74,0:10:27.16,Default,,0,0,0,,Бұл мылтық оқтан емес пе еді?
Dialogue: 0,0:10:27.46,0:10:29.75,Default,,0,0,0,,Қалай пайдалану керектігін ұмытып қалдым
Dialogue: 0,0:10:30.25,0:10:32.84,Default,,0,0,0,,Бірақ рахмет, есіме енді түсті.
Dialogue: 0,0:10:33.25,0:10:36.05,Default,,0,0,0,,Сіз өзіңізді де білмейсіз бе?
Dialogue: 0,0:10:36.84,0:10:38.72,Default,,0,0,0,,Түсінбегенім үшін қиналып қалдым
Dialogue: 0,0:10:39.13,0:10:42.01,Default,,0,0,0,,Мен Миямын, бұл менің ағам.
Dialogue: 0,0:10:42.30,0:10:43.64,Default,,0,0,0,,Үлкен аға...
Dialogue: 0,0:10:43.76,0:10:46.72,Default,,0,0,0,,Бұл Норито. Сіз осында тұрдыңыз ба?
Dialogue: 0,0:10:47.43,0:10:48.48,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:49.64,0:10:53.36,Default,,0,0,0,,Менің үйім №8 Маяк сегіз саны
Dialogue: 0,0:10:53.52,0:10:54.82,Default,,0,0,0,,Мен сонда баруым керек
Dialogue: 0,0:10:54.94,0:10:55.86,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:10:56.11,0:10:57.69,Default,,0,0,0,,А... Иіскеп алдың ба?
Dialogue: 0,0:10:58.24,0:11:01.99,Default,,0,0,0,,Мені жерге апарып, осында төбелессең, мен бұрышта қалып қоямын.
Dialogue: 0,0:11:02.41,0:11:03.45,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:11:08.16,0:11:10.25,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:11:10.41,0:11:12.25,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:11:12.71,0:11:13.54,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:11:16.63,0:11:17.63,Default,,0,0,0,,(оқтардың тойтарыс беру дыбысы)
Dialogue: 0,0:11:22.22,0:11:23.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:28.60,0:11:29.48,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:11:29.60,0:11:30.69,Default,,0,0,0,,Эй, сен
Dialogue: 0,0:11:31.48,0:11:33.94,Default,,0,0,0,,Өтінемін, апамды алып қашып кетші.
Dialogue: 0,0:11:34.06,0:11:35.06,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:11:35.19,0:11:38.44,Default,,0,0,0,,Әпкеңді көтеріп алып қашып кететін шығарсың.
Dialogue: 0,0:11:39.03,0:11:40.49,Default,,0,0,0,,Бас тарту...
Dialogue: 0,0:11:40.99,0:11:45.74,Default,,0,0,0,,үшінның өлгені жақсы ма, әлде бәрінің аман қалғаны жақсы ма?
Dialogue: 0,0:11:46.37,0:11:48.70,Default,,0,0,0,,Мен солай болуы керек сияқты.
Dialogue: 0,0:11:55.96,0:11:57.00,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:12:13.02,0:12:14.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:14.98,0:12:18.57,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:12:22.40,0:12:23.65,Default,,0,0,0,,Гемиттер бірлігі
Dialogue: 0,0:12:23.78,0:12:25.57,Default,,0,0,0,,Нөл бірінші түрін тексеріңіз
Dialogue: 0,0:12:25.91,0:12:27.70,Default,,0,0,0,,Сіз сөйледіңіз бе? Біз сөйлестік!
Dialogue: 0,0:12:28.12,0:12:30.37,Default,,0,0,0,,Біраз уақыт болды, императрица.
Dialogue: 0,0:12:31.29,0:12:32.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:35.29,0:12:36.46,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:12:59.36,0:13:03.86,Default,,0,0,0,,Хи хи хи хи хи хи
Dialogue: 0,0:13:04.28,0:13:05.11,Default,,0,0,0,,Джо!
Dialogue: 0,0:13:06.03,0:13:07.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:13.37,0:13:15.16,Default,,0,0,0,,А... А?
Dialogue: 0,0:13:16.21,0:13:18.46,Default,,0,0,0,,Сәлем Лунатик
Dialogue: 0,0:13:18.58,0:13:21.05,Default,,0,0,0,,Мен өзімді жақсы сезінемін
Dialogue: 0,0:13:21.17,0:13:22.38,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:13:22.88,0:13:25.38,Default,,0,0,0,,Айтпақшы, оны тастаңыз.
Dialogue: 0,0:13:26.13,0:13:27.64,Default,,0,0,0,,Бұл құрметсіздік
Dialogue: 0,0:13:28.26,0:13:30.85,Default,,0,0,0,,Нұсқауларды өзегімнен жеткіземін~
Dialogue: 0,0:13:30.97,0:13:32.52,Default,,0,0,0,,Кенеттен негізгі тақырып?
Dialogue: 0,0:13:33.31,0:13:36.73,Default,,0,0,0,,Hemiteos құрылғысының қайта іске қосылуы расталды
Dialogue: 0,0:13:36.89,0:13:42.02,Default,,0,0,0,,Ұйымыңыздың/оқу мекемесінің ресурстарын осы мақсатқа арнаңыз.
Dialogue: 0,0:13:42.36,0:13:43.78,Default,,0,0,0,,Күштің мөлшері қандай?
Dialogue: 0,0:13:44.19,0:13:46.11,Default,,0,0,0,,Мүмкіндігінше
Dialogue: 0,0:13:46.65,0:13:48.11,Default,,0,0,0,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:13:57.25,0:14:01.50,Default,,0,0,0,,Тыңдаңдар, мырзалар, менің нақыл сөздерімді.
Dialogue: 0,0:14:01.84,0:14:04.26,Default,,0,0,0,,Адамдар дүниеге келгенде хайуаннан басқа ештеңе емес.
Dialogue: 0,0:14:05.38,0:14:07.68,Default,,0,0,0,,Адамды адам ететін не?
Dialogue: 0,0:14:07.80,0:14:11.76,Default,,0,0,0,,Бұл білім, бұл қоршаған орта, бұл механика.
Dialogue: 0,0:14:12.56,0:14:17.60,Default,,0,0,0,,Адам өзінің адамдық қасиетін сыртқы құрылғыларға сеніп тапсыра алады.
Dialogue: 0,0:14:18.48,0:14:23.61,Default,,0,0,0,,Кигеннің бәрі адамдығыңа кіреді.
Dialogue: 0,0:14:23.94,0:14:27.24,Default,,0,0,0,,Механизаторы жоқ, білімі жоқ адам
Dialogue: 0,0:14:27.36,0:14:30.28,Default,,0,0,0,,Оларды шынымен адам деп атауға бола ма?
Dialogue: 0,0:14:30.78,0:14:35.29,Default,,0,0,0,,Мен, мектеп мұғалімі Смайл, сізге бағыт-бағдар беремін.
Dialogue: 0,0:14:35.41,0:14:39.21,Default,,0,0,0,,Адам болып кемелдену жолы!
Dialogue: 0,0:14:39.33,0:14:41.13,Default,,0,0,0,,Құрметті Смайл!
Dialogue: 0,0:15:02.65,0:15:03.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:03.65,0:15:04.73,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:15:07.69,0:15:09.61,Default,,0,0,0,,Хаха!
Dialogue: 0,0:15:14.62,0:15:15.83,Default,,0,0,0,,А, бұрын!
Dialogue: 0,0:15:17.58,0:15:19.37,Default,,0,0,0,,Қиыршық тас режимі
Dialogue: 0,0:15:28.13,0:15:29.72,Default,,0,0,0,,Fa…
Dialogue: 0,0:15:36.68,0:15:39.14,Default,,0,0,0,,Тармак режимі!
Dialogue: 0,0:15:39.56,0:15:42.90,Default,,0,0,0,,Бұл қандай велосипед? Неге сонша күштісің?
Dialogue: 0,0:15:43.27,0:15:45.44,Default,,0,0,0,,Бұл қандай велосипед?
Dialogue: 0,0:15:45.56,0:15:46.77,Default,,0,0,0,,Гемиттер бірлігі
Dialogue: 0,0:15:46.90,0:15:49.61,Default,,0,0,0,,Ұтқырлығы жоғары көлік құралының қара трикін қолдау
Dialogue: 0,0:15:49.74,0:15:53.41,Default,,0,0,0,,Сізге тағы да рахмет, императрица.
Dialogue: 0,0:15:53.95,0:15:56.41,Default,,0,0,0,,Сіз императрицасыз, бұл біртүрлі есім.
Dialogue: 0,0:15:56.95,0:15:58.91,Default,,0,0,0,,Мен... иә?
Dialogue: 0,0:16:01.46,0:16:02.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:11.38,0:16:14.59,Default,,0,0,0,,Бірінен соң бірі... Бұл жолы не болды?
Dialogue: 0,0:16:16.51,0:16:19.10,Default,,0,0,0,,Бейбітшілік құрушы күш! Сондай шалғай жерде
Dialogue: 0,0:16:22.94,0:16:24.94,Default,,0,0,0,,Бұл сөзсіз ол.
Dialogue: 0,0:16:25.60,0:16:27.11,Default,,0,0,0,,Сізді бірден қуып жатыр.
Dialogue: 0,0:16:27.31,0:16:30.86,Default,,0,0,0,,Хаа... Бала баланы қорғап тұрған сияқты.
Dialogue: 0,0:16:31.03,0:16:32.36,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:16:32.61,0:16:33.86,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:16:34.03,0:16:35.49,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:16:40.24,0:16:42.29,Default,,0,0,0,,Мен оны жеңдім. Керемет...
Dialogue: 0,0:16:57.85,0:17:00.01,Default,,0,0,0,,...
Dialogue: 0,0:17:00.18,0:17:01.64,Default,,0,0,0,,Императрица.
Dialogue: 0,0:17:02.18,0:17:03.02,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:17:03.60,0:17:05.39,Default,,0,0,0,,Оны полковник деп атайды.
Dialogue: 0,0:17:05.98,0:17:07.31,Default,,0,0,0,,Бұл атау ма?
Dialogue: 0,0:17:07.44,0:17:08.98,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:17:09.31,0:17:10.40,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:10.69,0:17:14.03,Default,,0,0,0,,Адамзаттың қамқоршысы Hemiteos бөлімі
Dialogue: 0,0:17:14.15,0:17:16.91,Default,,0,0,0,,Аман қалған императрица
Dialogue: 0,0:17:17.53,0:17:22.41,Default,,0,0,0,,Бейбітшілікті құрушы күштер желісі қайта іске қосу импульсін алды.
Dialogue: 0,0:17:22.66,0:17:23.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:25.71,0:17:27.29,Default,,0,0,0,,Бұл қандай бет?
Dialogue: 0,0:17:27.96,0:17:32.38,Default,,0,0,0,,А... мына бала есінен танып қалды, абдырап қалды.
Dialogue: 0,0:17:32.67,0:17:34.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:34.72,0:17:37.43,Default,,0,0,0,,Мен сіздің қаншалықты шатастырғаныңызды білмеймін.
Dialogue: 0,0:17:37.97,0:17:39.47,Default,,0,0,0,,Мына көріністі қараңыз
Dialogue: 0,0:17:39.60,0:17:42.64,Default,,0,0,0,,Дүниеде не болғанын білесіз бе?
Dialogue: 0,0:17:44.02,0:17:48.27,Default,,0,0,0,,Ұзақ уақыт бұрын бірнеше ұлттан жоғары корпорациялардың күшімен.
Dialogue: 0,0:17:48.40,0:17:51.15,Default,,0,0,0,,Жұмыс күшін автоматтандырудың маңызды жобасы
Dialogue: 0,0:17:51.57,0:17:53.65,Default,,0,0,0,,Элизия басталды
Dialogue: 0,0:17:54.07,0:17:56.20,Default,,0,0,0,,Бұл... сәтсіз болды ма?
Dialogue: 0,0:17:56.32,0:17:57.15,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:57.91,0:18:01.66,Default,,0,0,0,,Артемида, Элизиумның өзегіндегі жасанды интеллект
Dialogue: 0,0:18:02.03,0:18:04.16,Default,,0,0,0,,Адамзатқа қарсы соғысты таңдады
Dialogue: 0,0:18:04.75,0:18:08.17,Default,,0,0,0,,Себебі... жарайды, бұл күрделі, сондықтан мен оны әзірше өткізіп жіберемін.
Dialogue: 0,0:18:08.92,0:18:12.13,Default,,0,0,0,,Қазіргі уақытта Артемида және оның ұшқышсыз әскері
Dialogue: 0,0:18:12.25,0:18:16.13,Default,,0,0,0,,Ай мен жерді байланыстыратын орбиталық элеватор салынуда.
Dialogue: 0,0:18:16.80,0:18:18.47,Default,,0,0,0,,Бұл аяқталғаннан кейін
Dialogue: 0,0:18:18.59,0:18:23.06,Default,,0,0,0,,Айда жаппай өндіріліп жатқан алып механикалық армия топ-топ болып келеді.
Dialogue: 0,0:18:23.64,0:18:27.18,Default,,0,0,0,,Уақыт шегі - орбиталық элеваторды аяқтау.
Dialogue: 0,0:18:27.77,0:18:29.48,Default,,0,0,0,,Ал біз болсақ, жай ғана
Dialogue: 0,0:18:29.60,0:18:33.07,Default,,0,0,0,,Мен әңгіменің қай жеріне енемін?
Dialogue: 0,0:18:34.07,0:18:38.03,Default,,0,0,0,,Сіз салынып жатқан орбиталық элеваторды қиратасыз.
Dialogue: 0,0:18:38.36,0:18:39.45,Default,,0,0,0,,Императрица
Dialogue: 0,0:18:40.24,0:18:42.62,Default,,0,0,0,,Сен осы үшін дүниеге келдің
Dialogue: 0,0:18:43.03,0:18:43.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:44.45,0:18:46.29,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:51.42,0:18:54.29,Default,,0,0,0,,Бұл жаман. Өте үлкен келе жатыр.
Dialogue: 0,0:18:54.42,0:18:56.42,Default,,0,0,0,,Жылжыту Жылжыту?
Dialogue: 0,0:18:56.59,0:18:58.76,Default,,0,0,0,,Алдыңғы Закодан айырмашылығы
Dialogue: 0,0:18:58.88,0:19:00.55,Default,,0,0,0,,Қолыңыздағы атыс қаруымен ештеңе істей алмайсыз.
Dialogue: 0,0:19:01.47,0:19:04.10,Default,,0,0,0,,Ол балалар кедергі, оларды жайына қалдыр.
Dialogue: 0,0:19:04.26,0:19:05.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:05.93,0:19:08.10,Default,,0,0,0,,Балалар сендер қайда тұрасыңдар?
Dialogue: 0,0:19:08.52,0:19:09.35,Default,,0,0,0,,Эй!
Dialogue: 0,0:19:09.73,0:19:12.02,Default,,0,0,0,,Бұл жерден бірнеше шақырым жерде таулар бар.
Dialogue: 0,0:19:12.15,0:19:15.61,Default,,0,0,0,,Тірі қалғандар одан ойылып жасалған бекіністі қалада тұрады.
Dialogue: 0,0:19:15.94,0:19:17.61,Default,,0,0,0,,Сол жерге жіберіңіз
Dialogue: 0,0:19:17.78,0:19:18.61,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:19:23.53,0:19:26.49,Default,,0,0,0,,Мен сізге көмектесуге тырысамын.
Dialogue: 0,0:19:27.45,0:19:30.12,Default,,0,0,0,,Мен бір нәрсені тастағым келмейді...
Dialogue: 0,0:19:30.87,0:19:34.21,Default,,0,0,0,,Лақтырғанда қалған тыртықтар өте терең.
Dialogue: 0,0:19:34.84,0:19:36.25,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:19:36.42,0:19:37.34,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:19:45.01,0:19:46.18,Default,,0,0,0,,Артыңнан тез қуамын!
Dialogue: 0,0:19:49.60,0:19:50.43,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:57.57,0:19:58.40,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:20:08.45,0:20:09.87,Default,,0,0,0,,Эй! Ах...
Dialogue: 0,0:20:14.37,0:20:15.46,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:20:16.92,0:20:19.63,Default,,0,0,0,,Ештеңе дұрыс болмауы мүмкін!
Dialogue: 0,0:20:26.72,0:20:27.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:45.99,0:20:47.20,Default,,0,0,0,,Қасиетті…
Dialogue: 0,0:20:48.78,0:20:50.24,Default,,0,0,0,,Мия! Сенімен бәрі жақсы ма?
Dialogue: 0,0:20:50.37,0:20:51.95,Default,,0,0,0,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,0:21:00.21,0:21:03.09,Default,,0,0,0,,Дәл қазір мен мұны қалай жасау керектігін есіме түсірдім.
Dialogue: 0,0:21:05.34,0:21:06.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:14.23,0:21:16.35,Default,,0,0,0,,Арчты басқарасыз ба?
Dialogue: 0,0:21:26.95,0:21:28.28,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:21:28.49,0:21:29.53,Default,,0,0,0,,Уау...
Dialogue: 0,0:21:34.12,0:21:34.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:37.29,0:21:38.71,Default,,0,0,0,,Әлі де жұмыс істейді
Dialogue: 0,0:21:43.17,0:21:44.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:53.35,0:21:54.64,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:21:59.19,0:22:00.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:06.07,0:22:07.86,Default,,0,0,0,,Императрица
Dialogue: 0,0:22:08.03,0:22:09.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:11.12,0:22:13.12,Default,,0,0,0,,♪～
Dialogue: 0,0:23:36.41,0:23:38.41,Default,,0,0,0,,～♪
