Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:42.87,0:00:43.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:44.54,0:00:46.46,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:00:48.13,0:00:48.96,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:51.63,0:00:52.88,Default,,0,0,0,,Хмм…
Dialogue: 0,0:00:56.34,0:00:58.85,Default,,0,0,0,,Сәйкестік сынағынан өттіңіз.
Dialogue: 0,0:00:59.60,0:01:02.64,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:01:02.77,0:01:04.35,Default,,0,0,0,,Сенімді болыңыз.
Dialogue: 0,0:01:04.81,0:01:07.73,Default,,0,0,0,,Операциядан кейін сізді гемиттердің бірлігіне айналдыру.
Dialogue: 0,0:01:08.48,0:01:10.36,Default,,0,0,0,,Менің баламның жүкті болуы
Dialogue: 0,0:01:10.82,0:01:12.78,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:01:13.44,0:01:15.03,Default,,0,0,0,,Қазірден бастап уақыт келді
Dialogue: 0,0:01:15.15,0:01:18.28,Default,,0,0,0,,Толық масштабты қайта құру операциясы басталады
Dialogue: 0,0:01:18.66,0:01:20.87,Default,,0,0,0,,Сіз қайта тудыңыз!
Dialogue: 0,0:01:23.45,0:01:25.62,Default,,0,0,0,,Алайда операцияға келгенде
Dialogue: 0,0:01:25.75,0:01:29.33,Default,,0,0,0,,Сіз соншалықты артта қалғансыз, қайғыға толысыз
Dialogue: 0,0:01:29.46,0:01:32.21,Default,,0,0,0,,Менің де ниетім бұл емес.
Dialogue: 0,0:01:32.84,0:01:34.46,Default,,0,0,0,,Өтінемін, сіз үшін
Dialogue: 0,0:01:35.01,0:01:39.22,Default,,0,0,0,,Ұлы тұлға болғаныңызға мақтаныш сезімін оятуыңызды қалаймын.
Dialogue: 0,0:01:40.39,0:01:41.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:44.06,0:01:48.39,Default,,0,0,0,,Айдағы механикалық құдай Артемида
Dialogue: 0,0:01:48.52,0:01:52.32,Default,,0,0,0,,Адамзат енді Артемида арқылы жойылуда.
Dialogue: 0,0:01:52.90,0:01:55.03,Default,,0,0,0,,Бұл қайғыратын нәрсе емес.
Dialogue: 0,0:01:56.03,0:02:01.07,Default,,0,0,0,,Гегемондық нәсілді ауыстыру ұзақ мерзімді перспективада сау.
Dialogue: 0,0:02:01.87,0:02:03.20,Default,,0,0,0,,Жақсы мүмкіндік, сондықтан мәселені түпкілікті анықтап алайық.
Dialogue: 0,0:02:04.08,0:02:06.70,Default,,0,0,0,,Пышақ қанша өткір болса да,
Dialogue: 0,0:02:06.83,0:02:09.54,Default,,0,0,0,,Ақырында пышақ қатты зақымдалады.
Dialogue: 0,0:02:09.67,0:02:14.71,Default,,0,0,0,,Егер бұл орын алса, сізде қайтадан қайраудан басқа амалыңыз қалмайды, бірақ ол ақырында шегіне жетеді.
Dialogue: 0,0:02:14.96,0:02:19.09,Default,,0,0,0,,Сонда жаңа пышақ алудан басқа амалыңыз қалмайды.
Dialogue: 0,0:02:19.22,0:02:20.39,Default,,0,0,0,,Осымен
Dialogue: 0,0:02:21.14,0:02:25.10,Default,,0,0,0,,Артемиданы алғашында адамдар жасаған.
Dialogue: 0,0:02:25.22,0:02:27.27,Default,,0,0,0,,Неліктен бұлай болғанын білесіз бе?
Dialogue: 0,0:02:28.81,0:02:35.15,Default,,0,0,0,,Адамзат Артемиданы бәрінен де дана және адал етіп жаратты.
Dialogue: 0,0:02:35.73,0:02:37.65,Default,,0,0,0,,Бұл дұрыс болмады.
Dialogue: 0,0:02:40.28,0:02:43.49,Default,,0,0,0,,Адамдар көптеген жануарларды басқарды.
Dialogue: 0,0:02:43.62,0:02:44.95,Default,,0,0,0,,Бірақ кез келген жануар
Dialogue: 0,0:02:45.08,0:02:48.75,Default,,0,0,0,,Адамзатқа қауіп төндіретін көтеріліс болған жоқ.
Dialogue: 0,0:02:49.50,0:02:52.63,Default,,0,0,0,,Адамзат Артемиданы белгілі бір дәрежеде ақымақ етті.
Dialogue: 0,0:02:52.75,0:02:54.67,Default,,0,0,0,,Оны әлсірету керек еді.
Dialogue: 0,0:02:55.17,0:02:57.26,Default,,0,0,0,,Артемиданы жасаған адамдар
Dialogue: 0,0:02:57.38,0:02:58.88,Default,,0,0,0,,Шын мәнінде не маңызды
Dialogue: 0,0:02:59.01,0:03:01.93,Default,,0,0,0,,Мен ештеңе түсінбедім
Dialogue: 0,0:03:02.09,0:03:05.97,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:03:10.64,0:03:12.52,Default,,0,0,0,,Сәйкестендіру сигналын қабылдау
Dialogue: 0,0:03:13.15,0:03:15.23,Default,,0,0,0,,Hemiteos бірлік күші!
Dialogue: 0,0:03:15.69,0:03:17.32,Default,,0,0,0,,Біз де асығайық
Dialogue: 0,0:03:26.12,0:03:28.24,Default,,0,0,0,,Дайын бол, су болып жатыр!
Dialogue: 0,0:03:29.91,0:03:32.12,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:03:34.04,0:03:35.96,Default,,0,0,0,,Өл… жоқ, әйелім мен арбашы қазірдің өзінде қайтыс болды.
Dialogue: 0,0:03:36.79,0:03:38.92,Default,,0,0,0,,Мен қарызымды төлеуге келдім!
Dialogue: 0,0:03:41.59,0:03:45.68,Default,,0,0,0,,Жау біздің бас киелі мекенімізге, құрлықтағы ұшақ тасығышқа басып кірді.
Dialogue: 0,0:03:45.97,0:03:51.35,Default,,0,0,0,,Бірден көп жау жақындап қалды, бар күшіңізбен оларды кесіңіз.
Dialogue: 0,0:03:52.81,0:03:53.69,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:03:59.82,0:04:02.20,Default,,0,0,0,,Алған біліміңізді марапаттайтын кез келді.
Dialogue: 0,0:04:02.49,0:04:05.82,Default,,0,0,0,,Өлім балғасын оқымаған жабайыларға бер.
Dialogue: 0,0:04:12.66,0:04:14.75,Default,,0,0,0,,Шатаспауыңызды өтінемін
Dialogue: 0,0:04:14.87,0:04:16.21,Default,,0,0,0,,Сіз осындай жердесіз
Dialogue: 0,0:04:16.33,0:04:17.84,Default,,0,0,0,,Мен сенің өлуіңе жол бере алмаймын.
Dialogue: 0,0:04:18.80,0:04:22.59,Default,,0,0,0,,Менде бәрі жақсы, сен мені қорғайсың
Dialogue: 0,0:04:24.55,0:04:27.10,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:04:30.77,0:04:31.85,Default,,0,0,0,,Хе хе хе...
Dialogue: 0,0:04:32.27,0:04:33.85,Default,,0,0,0,,Байыпты періште
Dialogue: 0,0:04:33.98,0:04:37.73,Default,,0,0,0,,Менің сүйкімді періштем Ухухухуху...
Dialogue: 0,0:04:37.90,0:04:39.48,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:04:39.94,0:04:43.19,Default,,0,0,0,,Бұл тым қауіпті Ол барған сайын нашарлайды
Dialogue: 0,0:04:43.36,0:04:45.74,Default,,0,0,0,,Мен бір жерден қателескен сияқтымын.
Dialogue: 0,0:04:45.86,0:04:49.28,Default,,0,0,0,,Егер мен жайбарақат ойласам, бұлай алысқа барудың қажеті жоқ деп ойлаймын.
Dialogue: 0,0:04:49.41,0:04:50.24,Default,,0,0,0,,Шулы
Dialogue: 0,0:04:50.95,0:04:54.00,Default,,0,0,0,,Сіз қашу уақытын дұрыс бағаладыңыз. Кеудеден кет!
Dialogue: 0,0:04:55.96,0:04:58.00,Default,,0,0,0,,Чейздің әртістері бір қатарға тұрады.
Dialogue: 0,0:04:58.33,0:05:01.63,Default,,0,0,0,,Chase? Бұл жай ғана флоп, солай емес пе?
Dialogue: 0,0:05:01.75,0:05:04.51,Default,,0,0,0,,Мен полковниктің көлік қуу деген анықтамасын білгім келеді!
Dialogue: 0,0:05:04.67,0:05:07.76,Default,,0,0,0,,Сөйле, бірақ тіліңді тістеме, жүргізуші!
Dialogue: 0,0:05:07.93,0:05:09.76,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:05:09.93,0:05:11.64,Default,,0,0,0,,Қарсыластың қауіп деңгейін анықтаңыз
Dialogue: 0,0:05:11.76,0:05:16.27,Default,,0,0,0,,Алдымен танкке қарсы шабуыл жасау мүмкіндігі барларды жоюды ұсынамыз.
Dialogue: 0,0:05:16.44,0:05:17.27,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:23.99,0:05:25.74,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:05:46.59,0:05:48.72,Default,,0,0,0,,Полковник! Бұл жерден не істеуім керек?
Dialogue: 0,0:05:48.97,0:05:51.01,Default,,0,0,0,,Әзірше, императрица және өлі қожайын.
Dialogue: 0,0:05:51.14,0:05:52.81,Default,,0,0,0,,Құрлықтағы әуе кемесіне жіберу
Dialogue: 0,0:05:52.93,0:05:55.48,Default,,0,0,0,,Одан кейін не істейтінімізді ойланамыз!
Dialogue: 0,0:05:55.89,0:05:56.73,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:05:57.10,0:06:01.23,Default,,0,0,0,,Бейбітшілікті құрушы күштердің операциялары әрқашан осындай орынды ма?
Dialogue: 0,0:06:01.36,0:06:02.98,Default,,0,0,0,,Сен осы уақытқа дейін жақсы өмір сүрдің.
Dialogue: 0,0:06:03.27,0:06:06.36,Default,,0,0,0,,Бұл әрқашан кездейсоқ болуы мүмкін емес.
Dialogue: 0,0:06:10.37,0:06:13.83,Default,,0,0,0,,Тезірек келейік, мынау бұзықтардың ұясы.
Dialogue: 0,0:06:13.95,0:06:15.75,Default,,0,0,0,,Оны қалай айтатыныңызды ойлаңыз.
Dialogue: 0,0:06:15.91,0:06:18.12,Default,,0,0,0,,Әпкеңді одан бетер уайымдайсың.
Dialogue: 0,0:06:18.29,0:06:20.71,Default,,0,0,0,,Енді ондай лас сөздерді айтпа.
Dialogue: 0,0:06:21.63,0:06:22.84,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:06:25.30,0:06:28.38,Default,,0,0,0,,Бұл миниатюралық мылтық бізге жұмыс істемейді!
Dialogue: 0,0:06:28.55,0:06:29.51,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:06:36.97,0:06:38.64,Default,,0,0,0,,Жігітті кепілге алдым.
Dialogue: 0,0:06:49.28,0:06:51.86,Default,,0,0,0,,Білім беру
Dialogue: 0,0:06:59.29,0:07:00.67,Default,,0,0,0,,Цк... Иә?
Dialogue: 0,0:07:01.17,0:07:02.21,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:07:02.33,0:07:03.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:06.30,0:07:08.17,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:07:08.34,0:07:09.17,Default,,0,0,0,,Эй
Dialogue: 0,0:07:09.30,0:07:10.93,Default,,0,0,0,,(Норитоның ауыр тыныс алуы)
Dialogue: 0,0:07:11.18,0:07:12.18,Default,,0,0,0,,Сәлем! Ха…
Dialogue: 0,0:07:12.76,0:07:16.68,Default,,0,0,0,,Сенің көңіл-күйіңді түсінемін, бірақ апаң өлі тауында емес екеніне көз жеткіз.
Dialogue: 0,0:07:16.93,0:07:18.68,Default,,0,0,0,,Міне! Асықшы!
Dialogue: 0,0:07:19.23,0:07:20.73,Default,,0,0,0,,Уақытыңызды босқа өткізбеңіз
Dialogue: 0,0:07:20.85,0:07:24.19,Default,,0,0,0,,Егер ол жерде мәйіт болса, құтқару миссиясы осында аяқталады.
Dialogue: 0,0:07:27.36,0:07:28.19,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:07:29.57,0:07:32.16,Default,,0,0,0,,Құтқару операциясы...
Dialogue: 0,0:07:32.99,0:07:33.95,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:34.28,0:07:38.37,Default,,0,0,0,,Жоқ, мен сенің әпкеңе көмектесу үшін келдім.
Dialogue: 0,0:07:38.49,0:07:41.96,Default,,0,0,0,,Бұл енді жеткіліксіз.
Dialogue: 0,0:07:43.42,0:07:44.71,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:07:45.13,0:07:45.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:46.67,0:07:49.30,Default,,0,0,0,,Мен ас үйге тазалауға келдім.
Dialogue: 0,0:07:49.42,0:07:52.09,Default,,0,0,0,,Мен сол жерден тарақан таптым.
Dialogue: 0,0:07:52.22,0:07:56.22,Default,,0,0,0,,Енді оны өлтірмейінше ас үйден шыға алмаймын.
Dialogue: 0,0:07:56.43,0:07:58.18,Default,,0,0,0,,Мен осылай сезінемін
Dialogue: 0,0:08:04.48,0:08:06.23,Default,,0,0,0,,Баруға дайын
Dialogue: 0,0:08:08.40,0:08:10.23,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:08:11.15,0:08:12.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:19.54,0:08:21.54,Default,,0,0,0,,Смайлик жоқ!
Dialogue: 0,0:08:21.66,0:08:23.58,Default,,0,0,0,,Ол үшін бірлік болса да.
Dialogue: 0,0:08:23.71,0:08:26.13,Default,,0,0,0,,Мен түзетулер енгізе алмаймын, себебі ол мұнда жоқ.
Dialogue: 0,0:08:29.17,0:08:30.55,Default,,0,0,0,,Осындай кездер үшін
Dialogue: 0,0:08:30.67,0:08:34.05,Default,,0,0,0,,Биометриялық ақпаратты жиі жүктеп салуды ұмытпаңыз.
Dialogue: 0,0:08:34.18,0:08:35.26,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:08:35.55,0:08:36.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:37.09,0:08:38.10,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:38.22,0:08:39.85,Default,,0,0,0,,Мағынасыз зорлық!
Dialogue: 0,0:08:39.97,0:08:42.52,Default,,0,0,0,,Хаа... қазірдің өзінде~
Dialogue: 0,0:08:42.64,0:08:45.02,Default,,0,0,0,,Уақытыңызды босқа өткізбеңіз
Dialogue: 0,0:08:48.44,0:08:49.77,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:08:52.94,0:08:53.78,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:08:56.70,0:08:57.53,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:09:16.38,0:09:17.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:17.72,0:09:18.80,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:09:19.93,0:09:20.81,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:09:22.93,0:09:24.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:26.69,0:09:28.31,Default,,0,0,0,,Олардың бәрін өлтіріңіз
Dialogue: 0,0:09:28.56,0:09:29.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:30.69,0:09:31.73,Default,,0,0,0,,Шарлотта?
Dialogue: 0,0:09:44.00,0:09:47.92,Default,,0,0,0,,Менің атым Смайлик, мен сенің жолбасшыңмын.
Dialogue: 0,0:09:48.75,0:09:50.67,Default,,0,0,0,,Сен... Смайл
Dialogue: 0,0:09:51.25,0:09:54.46,Default,,0,0,0,,Кел, сендерді оқытайық.
Dialogue: 0,0:09:55.42,0:09:59.14,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:10:06.02,0:10:08.14,Default,,0,0,0,,Бір орында тұра аласыз ба?
Dialogue: 0,0:10:08.27,0:10:09.44,Default,,0,0,0,,Өйткені өлтіру қиын
Dialogue: 0,0:10:09.81,0:10:11.56,Default,,0,0,0,,Қызықты нәрсе айтыңыз
Dialogue: 0,0:10:13.98,0:10:14.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:19.28,0:10:20.28,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:10:22.78,0:10:23.62,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:10:30.25,0:10:31.63,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:10:33.84,0:10:37.21,Default,,0,0,0,,Императрица оқу орындарына неге араласасыз?
Dialogue: 0,0:10:37.67,0:10:38.88,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар
Dialogue: 0,0:10:39.01,0:10:40.05,Default,,0,0,0,,Қате
Dialogue: 0,0:10:40.18,0:10:42.47,Default,,0,0,0,,Қандай себеп болса да, ол қабылданбайды.
Dialogue: 0,0:10:42.76,0:10:46.39,Default,,0,0,0,,Сенің бұлай сөйлейтін себебің – білімсіздігің.
Dialogue: 0,0:10:48.31,0:10:49.39,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:10:50.06,0:10:51.44,Default,,0,0,0,,Артемиданың да ұлылығы
Dialogue: 0,0:10:51.56,0:10:53.65,Default,,0,0,0,,Менің шынайылығымды сен де білмейсің.
Dialogue: 0,0:10:53.77,0:10:55.90,Default,,0,0,0,,Мен үйренбеймін, тіпті үйренуге тырыспаймын
Dialogue: 0,0:10:56.40,0:11:00.15,Default,,0,0,0,,Өз қолыммен түсіндіріп беруден басқа амалым жоқ.
Dialogue: 0,0:11:00.53,0:11:02.66,Default,,0,0,0,,Мен мұны түсінгім де келмейді.
Dialogue: 0,0:11:06.33,0:11:07.16,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:07.54,0:11:08.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:09.83,0:11:10.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:11.12,0:11:12.63,Default,,0,0,0,,Бұл не, жексұрын?
Dialogue: 0,0:11:13.46,0:11:14.75,Default,,0,0,0,,Көптен бері көрмедім
Dialogue: 0,0:11:14.88,0:11:18.30,Default,,0,0,0,,Hemiteos Бірлігінің түрі Нөл Екі Күш
Dialogue: 0,0:11:18.71,0:11:19.55,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:20.13,0:11:23.18,Default,,0,0,0,,Таң қалдырдың, сен мені ұмыттың ба?
Dialogue: 0,0:11:23.39,0:11:24.43,Default,,0,0,0,,Бұл ақылсыз.
Dialogue: 0,0:11:24.85,0:11:25.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:26.60,0:11:27.43,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:11:28.22,0:11:30.52,Default,,0,0,0,,Өйткені, бұл элементар денеден шыққан ақау.
Dialogue: 0,0:11:30.64,0:11:33.40,Default,,0,0,0,,Бұл түзету жағдайды біршама жақсартады деп үміттенемін.
Dialogue: 0,0:11:33.52,0:11:35.23,Default,,0,0,0,,Ах, Джентл!
Dialogue: 0,0:11:35.36,0:11:38.57,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:11:39.36,0:11:40.32,Default,,0,0,0,,Теме...
Dialogue: 0,0:11:41.07,0:11:45.95,Default,,0,0,0,,Сен қатты күресіп, сосын оны жаттықтырдың.
Dialogue: 0,0:11:46.66,0:11:49.08,Default,,0,0,0,,Тренинг? Жақсы батылдық, солай емес пе?
Dialogue: 0,0:11:49.66,0:11:52.83,Default,,0,0,0,,Бұл ұрып-соғу емес, мұны істеу.
Dialogue: 0,0:11:52.96,0:11:55.79,Default,,0,0,0,,Құлақпен жақсы шу шығарғанша
Dialogue: 0,0:11:55.92,0:11:57.63,Default,,0,0,0,,Оны жақсы тәртіпке келтір!
Dialogue: 0,0:11:57.75,0:11:59.59,Default,,0,0,0,,Уау! Мотивацияға толы
Dialogue: 0,0:12:08.39,0:12:10.35,Default,,0,0,0,,Арчты басқара аласыз ба?
Dialogue: 0,0:12:10.85,0:12:13.10,Default,,0,0,0,,Осы жолы мені қуантасың ба?
Dialogue: 0,0:12:13.44,0:12:16.52,Default,,0,0,0,,Жылап жерге отыратындай емес!
Dialogue: 0,0:12:16.65,0:12:18.57,Default,,0,0,0,,Аха, жұмсақ бол
Dialogue: 0,0:12:21.11,0:12:22.65,Default,,0,0,0,,Мен сиқыр жасаймын.
Dialogue: 0,0:12:23.86,0:12:26.41,Default,,0,0,0,,Сіз... адам емессіз бе?
Dialogue: 0,0:12:27.53,0:12:30.83,Default,,0,0,0,,Адаммен аралассақ, мәселе болар еді.
Dialogue: 0,0:12:30.95,0:12:32.46,Default,,0,0,0,,Керісінше, мен сендерге жақынырақпын.
Dialogue: 0,0:12:32.58,0:12:35.46,Default,,0,0,0,,Менің балам менен қарағанда мінсіз болады
Dialogue: 0,0:12:36.00,0:12:38.96,Default,,0,0,0,,Балалар? Мияны қалыңдық еткіңіз келе ме?
Dialogue: 0,0:12:39.34,0:12:43.72,Default,,0,0,0,,Дұрыс, барлық асыл құрбандықтар осымен марапатталады.
Dialogue: 0,0:12:44.05,0:12:45.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:47.72,0:12:49.85,Default,,0,0,0,,Қымбатты... құрбандық?
Dialogue: 0,0:12:50.35,0:12:52.73,Default,,0,0,0,,Ақыры лайықты адам табылды
Dialogue: 0,0:12:52.85,0:12:55.27,Default,,0,0,0,,Менің денеме лайық әйел
Dialogue: 0,0:12:55.39,0:12:58.48,Default,,0,0,0,,Сіз де соған лайықсыз. Қуаныңыз!
Dialogue: 0,0:12:58.81,0:12:59.86,Default,,0,0,0,,Кешпеймін…
Dialogue: 0,0:13:02.03,0:13:04.11,Default,,0,0,0,,«Нәзік» деген не?
Dialogue: 0,0:13:04.40,0:13:05.70,Default,,0,0,0,,Құбыжық
Dialogue: 0,0:13:06.36,0:13:10.24,Default,,0,0,0,,Бұл қорқынышты. Мұнда құбыжықтар жоқ.
Dialogue: 0,0:13:10.62,0:13:14.87,Default,,0,0,0,,Міне, мен Артемиданың бейнесімін.
Dialogue: 0,0:13:15.37,0:13:18.21,Default,,0,0,0,,Адамдардың ақымақ қамқоршысы
Dialogue: 0,0:13:18.50,0:13:22.38,Default,,0,0,0,,Олардың шығу тегі бір болуы керек болса да, олар ешқашан сәйкес келмейді.
Dialogue: 0,0:13:22.55,0:13:26.38,Default,,0,0,0,,Магниттің бірдей полюстері сияқты олар бір-бірін тебеді.
Dialogue: 0,0:13:26.72,0:13:29.68,Default,,0,0,0,,Қызықсыз нәрселермен араласпа!
Dialogue: 0,0:13:33.60,0:13:34.43,Default,,0,0,0,,Оны үрлеп тастаңыз!
Dialogue: 0,0:13:34.60,0:13:35.43,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:13:37.60,0:13:38.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:39.23,0:13:41.15,Default,,0,0,0,,Цк... Боқ.
Dialogue: 0,0:13:43.61,0:13:44.44,Default,,0,0,0,,Уау
Dialogue: 0,0:13:45.15,0:13:46.20,Default,,0,0,0,,Жая~!
Dialogue: 0,0:13:47.45,0:13:49.53,Default,,0,0,0,,･･･
Dialogue: 0,0:13:49.99,0:13:51.12,Default,,0,0,0,,Оны үрлеп тастаңыз!
Dialogue: 0,0:14:07.38,0:14:08.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:09.93,0:14:10.89,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:14:12.18,0:14:13.01,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:14:15.77,0:14:16.73,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:22.11,0:14:22.98,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:14:24.90,0:14:25.99,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:14:26.15,0:14:27.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:27.82,0:14:30.36,Default,,0,0,0,,Орындау қиын, бірақ қиындай түседі
Dialogue: 0,0:14:30.99,0:14:33.74,Default,,0,0,0,,Смайлдың қорытынды формасы
Dialogue: 0,0:14:39.58,0:14:40.75,Default,,0,0,0,,Сәлем! Ах...
Dialogue: 0,0:14:41.83,0:14:44.09,Default,,0,0,0,,Білім! білім!
Dialogue: 0,0:14:44.21,0:14:45.50,Default,,0,0,0,,А... (мылтық атылды)
Dialogue: 0,0:14:46.88,0:14:49.63,Default,,0,0,0,,Аххх, бұл жақсы сезінеді
Dialogue: 0,0:14:49.97,0:14:51.01,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:14:51.89,0:14:52.89,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:53.05,0:14:55.14,Default,,0,0,0,,...
Dialogue: 0,0:14:56.72,0:14:58.18,Default,,0,0,0,,Бұл қауіпті сияқты.
Dialogue: 0,0:14:58.31,0:14:59.14,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:14:59.85,0:15:01.90,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:15:03.06,0:15:04.15,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:15:04.65,0:15:05.77,Default,,0,0,0,,Қара Трейк!
Dialogue: 0,0:15:06.11,0:15:08.57,Default,,0,0,0,,Негізгі техниканың ауыр зақымдануы
Dialogue: 0,0:15:08.69,0:15:12.78,Default,,0,0,0,,ECU өзін-өзі диагностикалаудан кейін сәтсіздіктерді болдырмау бағдарламасын бастаңыз
Dialogue: 0,0:15:15.62,0:15:17.54,Default,,0,0,0,,Хмм, оқ таусылды ма?
Dialogue: 0,0:15:18.70,0:15:19.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:21.54,0:15:22.79,Default,,0,0,0,,Одақтастарға келетін болсақ...
Dialogue: 0,0:15:26.46,0:15:29.30,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:15:29.88,0:15:33.30,Default,,0,0,0,,Полковник! Императрица Смайлимен күресіп жатқан сияқты.
Dialogue: 0,0:15:33.43,0:15:34.80,Default,,0,0,0,,Қолдау көрсетуге баруға рұқсат!
Dialogue: 0,0:15:36.06,0:15:39.31,Default,,0,0,0,,Рұқсат етіңіз, дөрекі болмаңыз
Dialogue: 0,0:15:39.43,0:15:40.56,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:15:44.48,0:15:46.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:48.90,0:15:50.57,Default,,0,0,0,,Көп... иә?
Dialogue: 0,0:15:54.45,0:15:55.41,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:55.95,0:15:56.78,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:57.16,0:15:58.04,Default,,0,0,0,,Уау
Dialogue: 0,0:16:02.75,0:16:05.21,Default,,0,0,0,,Иә? Осылай ма?
Dialogue: 0,0:16:06.09,0:16:08.09,Default,,0,0,0,,Амал жоқ...
Dialogue: 0,0:16:08.21,0:16:09.05,Default,,0,0,0,,Уау
Dialogue: 0,0:16:09.92,0:16:12.68,Default,,0,0,0,,Мен сені ақырын еркелетемін
Dialogue: 0,0:16:13.38,0:16:17.35,Default,,0,0,0,,Фухахаха! Не болды? Мен қолдарымды немесе аяғымды пайдалана алмаймын.
Dialogue: 0,0:16:17.47,0:16:19.52,Default,,0,0,0,,Мен кетемін хахахаха!
Dialogue: 0,0:16:20.18,0:16:21.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:23.35,0:16:25.40,Default,,0,0,0,,Полковник! Мен болашақ үшін жалынамын!
Dialogue: 0,0:16:25.73,0:16:26.73,Default,,0,0,0,,Не?
Dialogue: 0,0:16:27.56,0:16:28.65,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:16:31.07,0:16:32.15,Default,,0,0,0,,Болт…
Dialogue: 0,0:16:33.24,0:16:37.62,Default,,0,0,0,,Фу... Сен мені қанша мұңайтасың?
Dialogue: 0,0:16:37.74,0:16:40.20,Default,,0,0,0,,Ол әлі де білімінің ортасында...
Dialogue: 0,0:16:40.33,0:16:41.20,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:16:41.33,0:16:42.16,Default,,0,0,0,,Кімге...?
Dialogue: 0,0:16:47.84,0:16:50.50,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:16:50.63,0:16:53.13,Default,,0,0,0,,Сен істедің, императрица.
Dialogue: 0,0:16:53.26,0:16:55.09,Default,,0,0,0,,Иә, содан кейін...
Dialogue: 0,0:16:55.34,0:16:56.59,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:17:07.35,0:17:08.44,Default,,0,0,0,,Міне, осылайша-ақ қырылып қалады!
Dialogue: 0,0:17:08.98,0:17:11.94,Default,,0,0,0,,Иә? Сіздің оқу орныңыз бұзылды ма?
Dialogue: 0,0:17:13.94,0:17:15.20,Default,,0,0,0,,Не істеп тұрсың?
Dialogue: 0,0:17:15.65,0:17:17.20,Default,,0,0,0,,Бүгінгі күннің бәрі осы!
Dialogue: 0,0:17:17.32,0:17:19.45,Default,,0,0,0,,Оқу орны маған бәрібір.
Dialogue: 0,0:17:19.58,0:17:22.37,Default,,0,0,0,,Шарлотты алып кетсе қиын болар еді.
Dialogue: 0,0:17:22.49,0:17:27.12,Default,,0,0,0,,Смайл да келмеді, демек, быт-шыт.
Dialogue: 0,0:17:28.04,0:17:29.46,Default,,0,0,0,,Бұзбағаны үшін сыйақы
Dialogue: 0,0:17:30.17,0:17:34.72,Default,,0,0,0,,Бұл қыздың әпкесі дәліздің арғы жағындағы зертханада.
Dialogue: 0,0:17:34.88,0:17:35.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:35.84,0:17:37.34,Default,,0,0,0,,О? Неліктен бұл...
Dialogue: 0,0:17:37.89,0:17:40.35,Default,,0,0,0,,Оның орнына тағы да ойнайық
Dialogue: 0,0:17:41.06,0:17:43.35,Default,,0,0,0,,Ал, мен бүгін кетемін!
Dialogue: 0,0:17:44.02,0:17:45.85,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:17:48.23,0:17:50.06,Default,,0,0,0,,Ах... Мия!
Dialogue: 0,0:17:51.73,0:17:54.53,Default,,0,0,0,,Цк... Боқ.
Dialogue: 0,0:17:55.40,0:17:57.32,Default,,0,0,0,,Мен өз өмірімді сақтап қалдым.
Dialogue: 0,0:18:02.12,0:18:03.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:03.99,0:18:06.21,Default,,0,0,0,,Үлкен аға... Мия!
Dialogue: 0,0:18:07.00,0:18:08.46,Default,,0,0,0,,Жақсы Мия...
Dialogue: 0,0:18:09.96,0:18:12.54,Default,,0,0,0,,Смайл адам емес еді
Dialogue: 0,0:18:12.84,0:18:16.72,Default,,0,0,0,,Аа, дұрыс, бейбақтар адамнан бала туа алмайды.
Dialogue: 0,0:18:17.13,0:18:19.76,Default,,0,0,0,,Демек, аналық денеге айналатын псевдогемиттер бірлігі
Dialogue: 0,0:18:19.89,0:18:21.55,Default,,0,0,0,,Мен жасауға тырыстым
Dialogue: 0,0:18:21.76,0:18:23.47,Default,,0,0,0,,Бұл жаман әзіл
Dialogue: 0,0:18:24.22,0:18:27.23,Default,,0,0,0,,Менің қызым да оның қалыңдығы ма?
Dialogue: 0,0:18:27.35,0:18:29.73,Default,,0,0,0,,Менің ойымша, ол осы мақсат үшін өзгертілген.
Dialogue: 0,0:18:30.94,0:18:33.32,Default,,0,0,0,,Бірақ егер ол сәтті болса
Dialogue: 0,0:18:33.44,0:18:35.98,Default,,0,0,0,,Мияны немесе императрицаны нысанаға алуға ешқандай себеп жоқ.
Dialogue: 0,0:18:36.11,0:18:38.11,Default,,0,0,0,,Менің ойымша, бірдеңе дұрыс болмады.
Dialogue: 0,0:18:38.53,0:18:39.74,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:40.49,0:18:42.12,Default,,0,0,0,,Сіздің қызыңыз...
Dialogue: 0,0:18:42.37,0:18:43.37,Default,,0,0,0,,Шарлотта
Dialogue: 0,0:18:43.49,0:18:44.87,Default,,0,0,0,,О, Шарлотта
Dialogue: 0,0:18:45.37,0:18:47.58,Default,,0,0,0,,Үлкен бөксенің ішінде төбелесіп жатқанда
Dialogue: 0,0:18:47.70,0:18:49.92,Default,,0,0,0,,Мен Лунатик деген жігітті кездестірдім.
Dialogue: 0,0:18:50.50,0:18:52.63,Default,,0,0,0,,Ол Артемиданың инкарнациясы болса керек.
Dialogue: 0,0:18:53.50,0:18:54.63,Default,,0,0,0,,Ақылсыз…
Dialogue: 0,0:18:55.13,0:18:56.26,Default,,0,0,0,,Бұл Шарлотта.
Dialogue: 0,0:18:56.38,0:18:59.17,Default,,0,0,0,,Егер оны біз ұрлап алса, қиын болатын сияқты.
Dialogue: 0,0:18:59.42,0:19:00.47,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:19:00.59,0:19:01.64,Default,,0,0,0,,Бұл біртүрлі емес пе?
Dialogue: 0,0:19:02.14,0:19:04.93,Default,,0,0,0,,«жеңілсе» емес, «ұрланған болса»
Dialogue: 0,0:19:05.06,0:19:05.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:06.43,0:19:10.60,Default,,0,0,0,,Байқадым, оның миы бұзылған болуы мүмкін.
Dialogue: 0,0:19:10.89,0:19:14.82,Default,,0,0,0,,Кем дегенде, Шарлотты қайтарудың мағынасы бар.
Dialogue: 0,0:19:18.49,0:19:20.65,Default,,0,0,0,,Енді кеттік.
Dialogue: 0,0:19:21.16,0:19:23.32,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:19:23.45,0:19:24.28,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:24.62,0:19:27.41,Default,,0,0,0,,Сол оғаштардың сізді қайтадан тартып алуына жол бермеңіз.
Dialogue: 0,0:19:27.83,0:19:28.87,Default,,0,0,0,,О
Dialogue: 0,0:19:30.54,0:19:33.67,Default,,0,0,0,,Күш те императрицалармен бірге жүре ме?
Dialogue: 0,0:19:34.04,0:19:35.13,Default,,0,0,0,,Жақсы
Dialogue: 0,0:19:35.25,0:19:37.96,Default,,0,0,0,,Тарақандарды жоюды мұқият жүргізу керек.
Dialogue: 0,0:19:38.09,0:19:41.30,Default,,0,0,0,,Мен олармен бірге болсам, мен ол әйелмен қайта кездесе аламын.
Dialogue: 0,0:19:41.68,0:19:43.34,Default,,0,0,0,,Мен сені осы жолы байлап қоямын
Dialogue: 0,0:19:43.47,0:19:45.05,Default,,0,0,0,,Мүлдем болмады, солай ма?
Dialogue: 0,0:19:45.64,0:19:48.56,Default,,0,0,0,,О? Мен сені құлатамын!
Dialogue: 0,0:19:55.77,0:19:57.27,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:19:57.82,0:20:01.07,Default,,0,0,0,,Мен сол адамдар әлемді өзгертетінін сеземін.
Dialogue: 0,0:20:02.28,0:20:03.28,Default,,0,0,0,,О
Dialogue: 0,0:20:04.49,0:20:06.07,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:20:09.91,0:20:12.08,Default,,0,0,0,,Black Trike туралы не айтасыз?
Dialogue: 0,0:20:12.46,0:20:14.67,Default,,0,0,0,,Өзін-өзі емдеу функциясымен жөндеуге болады
Dialogue: 0,0:20:14.79,0:20:16.54,Default,,0,0,0,,Артық зиян келтіру
Dialogue: 0,0:20:16.67,0:20:19.50,Default,,0,0,0,,Көлікті 6 сағат ішінде жалғастыру
Dialogue: 0,0:20:19.63,0:20:23.34,Default,,0,0,0,,Сыртқы жөндеулер нұсқаулыққа сәйкес жүргізілуі керек
Dialogue: 0,0:20:24.09,0:20:27.01,Default,,0,0,0,,Жарайды, сәл күте тұрыңыз.
Dialogue: 0,0:20:27.14,0:20:28.35,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:20:32.98,0:20:37.73,Default,,0,0,0,,Апат болған жерде оның қызының белгілері жоқ.
Dialogue: 0,0:20:37.86,0:20:39.61,Default,,0,0,0,,Әлі де дірілдеп тұрғанына сенімдімін.
Dialogue: 0,0:20:40.78,0:20:41.61,Default,,0,0,0,,О
Dialogue: 0,0:20:42.32,0:20:48.08,Default,,0,0,0,,Қалай болғанда да, біздің мақсатымыз - Артемиданың орбиталық элеваторы.
Dialogue: 0,0:20:48.49,0:20:49.33,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:20:49.95,0:20:51.70,Default,,0,0,0,,Айтпақшы, Моника
Dialogue: 0,0:20:51.83,0:20:55.17,Default,,0,0,0,,Карта жүйесі GPS-ті пайдаланбайды.
Dialogue: 0,0:20:55.33,0:20:56.71,Default,,0,0,0,,Бұл әлі де пайдалы ма?
Dialogue: 0,0:20:57.13,0:20:58.34,Default,,0,0,0,,Әрине
Dialogue: 0,0:20:59.00,0:21:00.84,Default,,0,0,0,,Маған әлі де жол көрсеткіңіз келе ме?
Dialogue: 0,0:21:01.34,0:21:03.55,Default,,0,0,0,,Осылай келіп, жарты жолда шықсаң
Dialogue: 0,0:21:03.67,0:21:06.05,Default,,0,0,0,,Бұл ақымақтық емес пе?
Dialogue: 0,0:21:06.18,0:21:08.35,Default,,0,0,0,,«Уланған тағам, тіпті табақ».
Dialogue: 0,0:21:10.39,0:21:12.85,Default,,0,0,0,,Бұл Конкорд қатесі болуы мүмкін.
Dialogue: 0,0:21:16.19,0:21:21.86,Default,,0,0,0,,Бұл экономикалық тұрғыдан кері қайтара алмаудың нәтижесі болды.
Dialogue: 0,0:21:21.98,0:21:24.61,Default,,0,0,0,,Бұл қате деп түсіндірілді.
Dialogue: 0,0:21:25.32,0:21:29.87,Default,,0,0,0,,Менің ойымша, Concorde әзірлеушілері шынымен бақытты болды.
Dialogue: 0,0:21:30.49,0:21:35.41,Default,,0,0,0,,Олар жасаған ең жақсы ұшақ... ол ұзақ ұшты.
Dialogue: 0,0:21:36.54,0:21:37.54,Default,,0,0,0,,Ал, мен
Dialogue: 0,0:21:37.67,0:21:41.13,Default,,0,0,0,,Адамгершілік болмаса да жақсы тәжірибе деп ойлаймын.
Dialogue: 0,0:21:41.67,0:21:42.92,Default,,0,0,0,,Ал полковник
Dialogue: 0,0:21:43.05,0:21:46.17,Default,,0,0,0,,Сіз оны Конкорд деп ойламайсыз, солай ма?
Dialogue: 0,0:21:46.63,0:21:48.64,Default,,0,0,0,,Иә, жақсы...
Dialogue: 0,0:21:49.39,0:21:51.10,Default,,0,0,0,,Кем дегенде олар
Dialogue: 0,0:21:51.22,0:21:54.68,Default,,0,0,0,,Жолаушылар ұшағы талғампаз допқа сыймайды деп ойлаймын.
Dialogue: 0,0:21:57.52,0:22:00.90,Default,,0,0,0,,Сонымен, императрица, сіз бірінші қайда барасыз?
Dialogue: 0,0:22:01.94,0:22:05.65,Default,,0,0,0,,Біздің үй шамшырағы №8 Сегіз саны
Dialogue: 0,0:22:06.32,0:22:09.11,Default,,0,0,0,,Онда... Менің кетуім керек.
Dialogue: 0,0:22:11.07,0:22:13.08,Default,,0,0,0,,♪～
Dialogue: 0,0:23:36.91,0:23:38.91,Default,,0,0,0,,～♪
Dialogue: 0,0:23:40.41,0:23:46.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
