Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Астыңғы ағынға жақын
Dialogue: 0,0:00:06.03,0:00:12.01,Default,,0,0,0,,Егер сіз қисық сызықты бұрсаңыз
Dialogue: 0,0:00:13.02,0:00:17.06,Default,,0,0,0,,Мен су құбырына түсіп бара жатқан сияқтымын.
Dialogue: 0,0:00:18.05,0:00:29.04,Default,,0,0,0,,Не көріп тұрсың? Не жаңғырық? Маған жауап бер
Dialogue: 0,0:00:39.06,0:00:41.03,Default,,0,0,0,,Қала рекорд болып табылады
Dialogue: 0,0:00:41.03,0:00:44.05,Default,,0,0,0,,Күнді алып бара жатқан қолдың шуы
Dialogue: 0,0:00:45.00,0:00:48.02,Default,,0,0,0,,Мен саған фон боламын
Dialogue: 0,0:00:48.02,0:00:50.00,Default,,0,0,0,,Қоқыс шығару
Dialogue: 0,0:00:50.02,0:00:55.03,Default,,0,0,0,,Жақсы құрылымдалған түйіндеме арқылы шешілмейтін жұмбақ ырғаққа үйреніңіз.
Dialogue: 0,0:00:55.07,0:00:59.00,Default,,0,0,0,,Қаламен қоршалған өзіңді таны
Dialogue: 0,0:00:59.03,0:01:00.05,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,0:01:00.00,0:01:04.05,Default,,0,0,0,,Орынсыз естеліктер
Dialogue: 0,0:01:03.04,0:01:05.07,Default,,0,0,0,,Қайырлы таң Аспан бұлтты болудан шаршады
Dialogue: 0,0:01:05.03,0:01:13.00,Default,,0,0,0,,Араласпаған көру сызығынан тыс
Dialogue: 0,0:01:14.06,0:01:17.03,Default,,0,0,0,,Сіз сонда жете аласыз ба?
Dialogue: 0,0:01:31.07,0:01:38.03,Default,,0,0,0,,Айқайлаған пұт
Dialogue: 0,0:01:32.03,0:01:34.05,Default,,0,0,0,,Сәлем, Мицуя, қазір қайдасың?
Dialogue: 0,0:01:35.00,0:01:37.01,Default,,0,0,0,,Сабақ 7-де басталады дедіңіз.
Dialogue: 0,0:01:37.05,0:01:39.06,Default,,0,0,0,,Мен қазір сені алып кетейін, сонда қал.
Dialogue: 0,0:01:46.04,0:01:48.00,Default,,0,0,0,,Кешіріңіз, Хараджуку станциясына
Dialogue: 0,0:01:48.07,0:01:51.02,Default,,0,0,0,,Асығыс, заңды жылдамдықта дерлік
Dialogue: 0,0:01:51.02,0:01:52.04,Default,,0,0,0,,Неге асығып тұрсың?
Dialogue: 0,0:01:52.04,0:01:56.00,Default,,0,0,0,,Адамдарды алып, сағат 7-де Сасазуканың студиясында болыңыз.
Dialogue: 0,0:01:56.00,0:01:57.02,Default,,0,0,0,,Сіз оны уақытында жасайсыз.
Dialogue: 0,0:01:57.02,0:01:58.09,Default,,0,0,0,,Жоқ, мен екі адамды алып кетейін.
Dialogue: 0,0:02:18.03,0:02:19.04,Default,,0,0,0,,Кочи Кокчи
Dialogue: 0,0:02:22.07,0:02:26.07,Default,,0,0,0,,Жүргізуші, асығыс, бірақ аман-есен Сасазуканың студиясына бара жатыр.
Dialogue: 0,0:02:31.03,0:02:33.02,Default,,0,0,0,,Ямамото мырза қуырылған тауық еті
Dialogue: 0,0:02:33.02,0:02:33.52,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:02:34.00,0:02:36.04,Default,,0,0,0,,Ия, мен аламын.
Dialogue: 0,0:02:36.04,0:02:37.08,Default,,0,0,0,,Көп жемеңіз
Dialogue: 0,0:02:37.08,0:02:39.06,Default,,0,0,0,,5 кг қоссаңыз, жұмыстан шығарыласыз.
Dialogue: 0,0:02:39.09,0:02:40.09,Default,,0,0,0,,Yes
Dialogue: 0,0:02:42.06,0:02:44.00,Default,,0,0,0,,Маған қуырылған тауық еті ұнайды.
Dialogue: 0,0:02:44.02,0:02:46.07,Default,,0,0,0,,Иә, мен Ойтаданмын.
Dialogue: 0,0:02:46.09,0:02:48.06,Default,,0,0,0,,Мұның бұған қатысы бар ма?
Dialogue: 0,0:02:48.08,0:02:52.04,Default,,0,0,0,,Сонымен, Хоккайдо тұрғындары карри сорпасын жақсы көреді ме?
Dialogue: 0,0:02:53.01,0:02:56.01,Default,,0,0,0,,Бұл өзіңді жақсы сезінетін нәрсе, жан азығы.
Dialogue: 0,0:02:58.07,0:03:00.02,Default,,0,0,0,,Жан азығы дегеніміз не?
Dialogue: 0,0:03:01.01,0:03:03.06,Default,,0,0,0,,Мен білмеймін, бірақ атмосфера
Dialogue: 0,0:03:04.00,0:03:06.08,Default,,0,0,0,,Жергілікті тағамдар немесе сүйікті тағамыңыздың дәмі.
Dialogue: 0,0:03:06.08,0:03:07.06,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:07.08,0:03:11.08,Default,,0,0,0,,Иә, қуырылған тағам дәмді болды, себебі оны анам жасады.
Dialogue: 0,0:03:14.00,0:03:15.07,Default,,0,0,0,,Бүгін Никайдо мырза
Dialogue: 0,0:03:16.00,0:03:17.02,Default,,0,0,0,,Мен кейінірек келемін.
Dialogue: 0,0:03:17.02,0:03:19.00,Default,,0,0,0,,Тым ерекше емес
Dialogue: 0,0:03:19.04,0:03:21.05,Default,,0,0,0,,Бұл жақсы, маған таңданба.
Dialogue: 0,0:03:21.05,0:03:22.06,Default,,0,0,0,,Мицуяға да сәттілік!
Dialogue: 0,0:03:23.00,0:03:25.06,Default,,0,0,0,,Сіз армандарыңызды орындаймын деп анаңызға уәде бергеннен кейін Токиоға келдіңіз.
Dialogue: 0,0:03:25.06,0:03:27.01,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:03:27.09,0:03:28.09,Default,,0,0,0,,Қуырылған тауық мейрамханасы
Dialogue: 0,0:03:36.04,0:03:38.05,Default,,0,0,0,,Олай болса өз бетіңізше жаттығу жасаңыз.
Dialogue: 0,0:03:39.02,0:03:40.04,Default,,0,0,0,,Иә
Dialogue: 0,0:03:40.04,0:03:41.02,Default,,0,0,0,,Иә, олай емес.
Dialogue: 0,0:03:41.06,0:03:43.05,Default,,0,0,0,,Мицуя – менің ең кенжесім.
Dialogue: 0,0:03:43.05,0:03:45.01,Default,,0,0,0,,Басқа балаларға қарағанда көбірек тырысу керек
Dialogue: 0,0:03:45.03,0:03:46.04,Default,,0,0,0,,Yes
Dialogue: 0,0:03:47.06,0:03:49.03,Default,,0,0,0,,Бір минут күтіңіз, жүргізуші.
Dialogue: 0,0:03:49.07,0:03:51.05,Default,,0,0,0,,Ихимура қазір қайда?
Dialogue: 0,0:03:52.04,0:03:53.09,Default,,0,0,0,,Огикубодағы супер қоғамдық монша?
Dialogue: 0,0:03:54.05,0:03:56.07,Default,,0,0,0,,Кешіріңіз, Огикубоға барыңыз.
Dialogue: 0,0:03:56.09,0:03:58.03,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:03:58.03,0:04:00.02,Default,,0,0,0,,Сасазуканың студиясын сағат 7-де айттыңыз.
Dialogue: 0,0:04:01.01,0:04:02.08,Default,,0,0,0,,Жарайды, түсінуге оңай нәрсе айтыңыз.
Dialogue: 0,0:04:07.03,0:04:08.06,Default,,0,0,0,,Бұл қиын сияқты.
Dialogue: 0,0:04:09.04,0:04:11.08,Default,,0,0,0,,Қыздармен қарым-қатынаста абай болу керек.
Dialogue: 0,0:04:12.01,0:04:14.09,Default,,0,0,0,,Сіз оларды бөлек алып кетесіз деп ойламадым.
Dialogue: 0,0:04:15.08,0:04:17.02,Default,,0,0,0,,Мұндай нәрселер көп.
Dialogue: 0,0:04:17.07,0:04:19.03,Default,,0,0,0,,Комбинациялар және отыру тәртібі
Dialogue: 0,0:04:19.06,0:04:21.06,Default,,0,0,0,,Олай болса, мен оларды ажыратқан дұрыс деп ойладым.
Dialogue: 0,0:04:27.07,0:04:29.02,Default,,0,0,0,,Мен қайтадан суға шомылдым.
Dialogue: 0,0:04:29.05,0:04:30.00,Default,,0,0,0,,Иә
Dialogue: 0,0:04:32.01,0:04:34.04,Default,,0,0,0,,Жүргізуші, студияға ертерек.
Dialogue: 0,0:04:35.05,0:04:37.06,Default,,0,0,0,,Қараңызшы, бұл мен бұрын айтқан ванна тұздары.
Dialogue: 0,0:04:37.09,0:04:38.08,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:04:41.02,0:04:43.05,Default,,0,0,0,,Не болды, жүргізуші, мені тез шығарып жіберші?
Dialogue: 0,0:04:44.01,0:04:46.09,Default,,0,0,0,,Мен ол қызды бұрын көргендей сезінемін.
Dialogue: 0,0:04:47.04,0:04:48.02,Default,,0,0,0,,Қайда
Dialogue: 0,0:04:48.02,0:04:50.08,Default,,0,0,0,,Ол қайда болды? Мүмкін теледидар?
Dialogue: 0,0:04:51.02,0:04:52.08,Default,,0,0,0,,Менің жүзімді білсең
Dialogue: 0,0:04:52.08,0:04:55.00,Default,,0,0,0,,Бір ғана айтарым, ол дебют алдында тікелей эфирге келген.
Dialogue: 0,0:04:55.04,0:04:56.09,Default,,0,0,0,,Бұл бала бетін көрсетпей тұр.
Dialogue: 0,0:04:57.08,0:04:59.04,Default,,0,0,0,,Сіз кумирсіз бе?
Dialogue: 0,0:04:59.09,0:05:01.01,Default,,0,0,0,,Содан кейін, жоқ.
Dialogue: 0,0:05:01.01,0:05:02.08,Default,,0,0,0,,Мен ешқашан тікелей эфирде болған емеспін.
Dialogue: 0,0:05:03.09,0:05:05.07,Default,,0,0,0,,Бүгінгі күнді ұмыт, жүргізуші.
Dialogue: 0,0:05:06.00,0:05:08.00,Default,,0,0,0,,Өйткені иілсе де қырын көрсететін бала.
Dialogue: 0,0:05:08.02,0:05:11.04,Default,,0,0,0,,Мен оны шынайы бармен сияқты білемін.
Dialogue: 0,0:05:11.06,0:05:13.08,Default,,0,0,0,,Бір қызығы, ол тыңдап тұр.
Dialogue: 0,0:05:19.06,0:05:20.08,Default,,0,0,0,,Шаршадыңыз ба?
Dialogue: 0,0:05:22.08,0:05:24.02,Default,,0,0,0,,Никайдо мырза
Dialogue: 0,0:05:24.04,0:05:25.04,Default,,0,0,0,,Кейінірек келеді
Dialogue: 0,0:05:26.04,0:05:29.03,Default,,0,0,0,,Мен ол адамның жақсартуға деген ұмтылысына ілесе алмаймын.
Dialogue: 0,0:05:29.07,0:05:31.09,Default,,0,0,0,,Ихимура өз қарқынымен жұмыс істеуі керек.
Dialogue: 0,0:05:32.03,0:05:33.08,Default,,0,0,0,,Бұл адам керемет
Dialogue: 0,0:05:33.08,0:05:36.08,Default,,0,0,0,,Мен алға жету үшін кісі өлтіруім мүмкін деп ойлаймын.
Dialogue: 0,0:05:36.08,0:05:38.01,Default,,0,0,0,,Мен мұны істеп жатырмын дегенім.
Dialogue: 0,0:05:38.01,0:05:39.01,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:05:41.05,0:05:45.02,Default,,0,0,0,,Мен бұл жұмысқа дайын емеспін деп ойлаймын.
Dialogue: 0,0:05:45.02,0:05:46.09,Default,,0,0,0,,Мұны тағы да айтыңыз
Dialogue: 0,0:05:48.00,0:05:50.01,Default,,0,0,0,,Мен енді болмыстың мәнін түсінбеймін
Dialogue: 0,0:05:50.05,0:05:52.08,Default,,0,0,0,,Ол Никайдо-сан сияқты әдемі емес.
Dialogue: 0,0:05:52.08,0:05:55.02,Default,,0,0,0,,Мен Мицуя сияқты билеуге шебер емеспін.
Dialogue: 0,0:05:55.06,0:05:58.00,Default,,0,0,0,,Өйткені Ихимураның жақсы жақтары бар.
Dialogue: 0,0:05:58.04,0:05:59.01,Default,,0,0,0,,басқа біреудің ұялы телефоны қоңырау шалғанда шыдай алмаймын.
Dialogue: 0,0:05:59.04,0:06:02.08,Default,,0,0,0,,Ал...
Dialogue: 0,0:06:02.08,0:06:03.04,Default,,0,0,0,,Міне
Dialogue: 0,0:06:03.07,0:06:06.09,Default,,0,0,0,,Сүйкімді немесе дәлірек айтқанда, кінәсіз
Dialogue: 0,0:06:07.04,0:06:08.06,Default,,0,0,0,,Оның да түрі сүйкімді
Dialogue: 0,0:06:08.06,0:06:10.04,Default,,0,0,0,,Сүйкімді емес болғандықтан маска киіп алдың.
Dialogue: 0,0:06:10.04,0:06:12.06,Default,,0,0,0,,Жоқ, бұл агенттіктің стратегиясы.
Dialogue: 0,0:06:12.06,0:06:13.09,Default,,0,0,0,,Түсініңіз.
Dialogue: 0,0:06:13.09,0:06:16.01,Default,,0,0,0,,Ағаммен хат жазу әбден шаршады...
Dialogue: 0,0:06:16.01,0:06:16.51,Default,,0,0,0,,Эй
Dialogue: 0,0:06:21.09,0:06:23.06,Default,,0,0,0,,Мицуя бірінші болды.
Dialogue: 0,0:06:24.05,0:06:26.02,Default,,0,0,0,,Мен ол балаға жақсы емеспін.
Dialogue: 0,0:06:26.02,0:06:27.05,Default,,0,0,0,,Алдыңғысы жақсырақ болды
Dialogue: 0,0:06:27.05,0:06:28.04,Default,,0,0,0,,Ихимура
Dialogue: 0,0:06:29.00,0:06:30.09,Default,,0,0,0,,Мұндай кінәсіздік артықшылық болып табылады.
Dialogue: 0,0:06:31.02,0:06:32.07,Default,,0,0,0,,ТПО-ны біледі
Dialogue: 0,0:06:34.02,0:06:37.00,Default,,0,0,0,,Камимегуро кеңсесіне жүргізуші
Dialogue: 0,0:06:37.07,0:06:39.07,Default,,0,0,0,,Жоқ, мен бақыттымын.
Dialogue: 0,0:06:39.07,0:06:42.04,Default,,0,0,0,,Бұл тапсырманы орындау барысында маған айтқым келетін ең жақсы жол.
Dialogue: 0,0:06:42.07,0:06:44.05,Default,,0,0,0,,«Алдындағы көліктің соңынан еріңіз»
Dialogue: 0,0:06:47.06,0:06:48.08,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:06:49.02,0:06:50.08,Default,,0,0,0,,Бұл қиын, жүргізуші.
Dialogue: 0,0:06:51.02,0:06:54.09,Default,,0,0,0,,Бірақ мен оларға жоғарыдан көріністі көрсеткім келеді.
Dialogue: 0,0:06:56.09,0:06:58.02,Default,,0,0,0,,Мүмкіндіктер сізге қарсы
Dialogue: 0,0:06:58.07,0:06:59.07,Default,,0,0,0,,Жеңіске жету мүмкіндігі?
Dialogue: 0,0:06:59.07,0:07:04.01,Default,,0,0,0,,Мен жоғарыда айтқан Руи Никайдо бала - Важра Тас.
Dialogue: 0,0:07:04.07,0:07:07.03,Default,,0,0,0,,Сіз Руи Никайдо туралы естідіңіз бе?
Dialogue: 0,0:07:07.05,0:07:09.02,Default,,0,0,0,,Тұтынушы айтқандай
Dialogue: 0,0:07:09.02,0:07:13.01,Default,,0,0,0,,Бұл өрескел тас немесе басқа да нәрсе емес, бұл гауһар тас.
Dialogue: 0,0:07:13.01,0:07:15.08,Default,,0,0,0,,Олай болса, баланы өз бетімен сату керек емес пе?
Dialogue: 0,0:07:15.08,0:07:17.05,Default,,0,0,0,,Қазір уақыт емес.
Dialogue: 0,0:07:17.09,0:07:19.06,Default,,0,0,0,,Біз жиынтықтарды сатуымыз керек.
Dialogue: 0,0:07:19.09,0:07:22.05,Default,,0,0,0,,Сонымен қатар, мен бұрын қолыма алған балаларыма өкінемін.
Dialogue: 0,0:07:22.07,0:07:26.00,Default,,0,0,0,,Гауһар көбірек жарқырату үшін бізге қосымша керек.
Dialogue: 0,0:07:26.04,0:07:29.07,Default,,0,0,0,,Сонымен, мен гауһар тастарды қолданатын зергерлік бұйымдардың дизайнерімін.
Dialogue: 0,0:07:30.00,0:07:32.00,Default,,0,0,0,,Әйтпесе, адамдар сізді табу қиын болады.
Dialogue: 0,0:07:32.04,0:07:34.00,Default,,0,0,0,,Алмаз тас деген ұғым жоқ.
Dialogue: 0,0:07:34.00,0:07:36.00,Default,,0,0,0,,Тек гауһар тастаңыз.
Dialogue: 0,0:07:38.07,0:07:40.00,Default,,0,0,0,,Иә, жүргізуші.
Dialogue: 0,0:07:40.00,0:07:41.01,Default,,0,0,0,,Менде визит карточкасы болуы мүмкін бе?
Dialogue: 0,0:07:41.04,0:07:44.03,Default,,0,0,0,,Оларды жылжыту Мен мүмкіндігінше бір адамды пайдаланғым келеді.
Dialogue: 0,0:07:44.06,0:07:46.03,Default,,0,0,0,,Жүргізуші қатал сияқты.
Dialogue: 0,0:07:46.03,0:07:49.02,Default,,0,0,0,,Сіз бара алмауыңыз мүмкін, сондықтан үміт артпаңыз.
Dialogue: 0,0:07:52.06,0:07:55.02,Default,,0,0,0,,Кейінірек, жүргізуші, жарнамалаңыз.
Dialogue: 0,0:07:55.06,0:07:57.06,Default,,0,0,0,,Олар бұл таксиде флайер қалдырмайды.
Dialogue: 0,0:07:59.02,0:08:00.03,Default,,0,0,0,,Бұл сатылады
Dialogue: 0,0:08:00.03,0:08:02.06,Default,,0,0,0,,Сату оңай болса, азап болмас еді.
Dialogue: 0,0:08:03.01,0:08:07.07,Default,,0,0,0,,Камимегуродағы кеңсенің бірінші қабатында бар жалға алушысы бар ма?
Dialogue: 0,0:08:07.07,0:08:09.03,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,0:08:10.00,0:08:13.07,Default,,0,0,0,,Мен бұған дейін қызды алып кеттім деп ойладым.
Dialogue: 0,0:08:15.07,0:08:16.03,Default,,0,0,0,,Біз біраз нәрсеге шыдай аламыз
Dialogue: 0,0:08:16.07,0:08:18.04,Default,,0,0,0,,Шамамен екі апта бұрын
Dialogue: 0,0:08:19.01,0:08:22.00,Default,,0,0,0,,Ол қыз сенімен бірге осы кеңседен болды.
Dialogue: 0,0:08:24.06,0:08:25.06,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:08:26.00,0:08:27.08,Default,,0,0,0,,Бұл мен бүгін қолыма алған балалардың бірі.
Dialogue: 0,0:08:27.08,0:08:30.02,Default,,0,0,0,,Жұмбақ сүйіспеншілік – топтың жалғыз мүшесі.
Dialogue: 0,0:08:30.07,0:08:32.00,Default,,0,0,0,,Түстен кейін Фудзисаваға қайтасың да, мектепке барасың, иә?
Dialogue: 0,0:08:32.03,0:08:35.08,Default,,0,0,0,,Әсіресе, кумир болғысы келетін сол жастағы балалар.
Dialogue: 0,0:08:36.02,0:08:38.06,Default,,0,0,0,,Маған олардың барлығы бір-біріне ұқсайды.
Dialogue: 0,0:08:40.03,0:08:42.04,Default,,0,0,0,,Шихо Ичимура, екінші шабандоз
Dialogue: 0,0:08:42.04,0:08:44.02,Default,,0,0,0,,Сіз мұны бұрын көргенімді айттыңыз.
Dialogue: 0,0:08:44.02,0:08:45.00,Default,,0,0,0,,Бұл бала, солай ма?
Dialogue: 0,0:08:45.03,0:08:47.00,Default,,0,0,0,,Әлгі қыз - мысық мысық.
Dialogue: 0,0:08:47.04,0:08:49.04,Default,,0,0,0,,Бұл сәл басқаша.
Dialogue: 0,0:08:57.02,0:08:59.02,Default,,0,0,0,,Мен дәл осы жерге келдім.
Dialogue: 0,0:08:59.04,0:09:00.04,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:09:00.08,0:09:01.05,Default,,0,0,0,,Не?
Dialogue: 0,0:09:02.00,0:09:03.02,Default,,0,0,0,,Баланы түсірген жер
Dialogue: 0,0:09:03.06,0:09:04.07,Default,,0,0,0,,Бұл шынымен кеңсе ме?
Dialogue: 0,0:09:05.00,0:09:05.50,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:09:11.00,0:09:16.05,Default,,0,0,0,,Директор Хироси Кокогава 11940 иен
Dialogue: 0,0:09:13.08,0:09:15.00,Default,,0,0,0,,Сәлем, жүргізуші.
Dialogue: 0,0:09:17.01,0:09:19.08,Default,,0,0,0,,Бұл көлікте жазу функциясы бар ма?
Dialogue: 0,0:09:23.00,0:09:23.50,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:24.06,0:09:26.05,Default,,0,0,0,,Кейде жаңалықтардан көресің.
Dialogue: 0,0:09:26.09,0:09:28.04,Default,,0,0,0,,Тонау сияқты нәрсе.
Dialogue: 0,0:09:29.02,0:09:31.00,Default,,0,0,0,,А, мінекей.
Dialogue: 0,0:09:31.03,0:09:32.08,Default,,0,0,0,,Деректер алынбады
Dialogue: 0,0:09:33.03,0:09:35.04,Default,,0,0,0,,Өйткені келесі PV-да
Dialogue: 0,0:09:35.04,0:09:38.05,Default,,0,0,0,,Мен таксиге мінген адамның суретін қосу қызықты болар деп ойладым.
Dialogue: 0,0:09:38.05,0:09:39.07,Default,,0,0,0,,Бетіңіз көрініп тұр.
Dialogue: 0,0:09:39.07,0:09:41.01,Default,,0,0,0,,Бұл бөлік өңделеді және пайдаланылады.
Dialogue: 0,0:09:41.06,0:09:42.08,Default,,0,0,0,,Әрине рахмет айтамын.
Dialogue: 0,0:09:44.03,0:09:46.05,Default,,0,0,0,,Олардың деректері жақсы.
Dialogue: 0,0:09:46.08,0:09:48.05,Default,,0,0,0,,Жоқ, мен бәрін қалаймын.
Dialogue: 0,0:09:50.09,0:09:53.00,Default,,0,0,0,,Мен өз бетімше шешім қабылдай алмаймын.
Dialogue: 0,0:09:53.04,0:09:57.01,Default,,0,0,0,,Мен құпиялылық мәселелерін шешкеннен кейін ойланамын.
Dialogue: 0,0:09:58.02,0:09:59.02,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:10:03.02,0:10:04.07,Default,,0,0,0,,Мен бәрібір сізбен қайта хабарласамын.
Dialogue: 0,0:10:05.00,0:10:07.06,Default,,0,0,0,,Бүгінгі әңгіме, болашақ әңгіме, ақ тілек
Dialogue: 0,0:10:08.00,0:10:11.06,Default,,0,0,0,,А, мені онша қызықтырмайды, уайымдама.
Dialogue: 0,0:10:34.02,0:10:36.03,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:10:53.02,0:10:55.00,Default,,0,0,0,,Сізге қоңырау шалғаным үшін кешіріңіз.
Dialogue: 0,0:10:55.09,0:10:58.02,Default,,0,0,0,,Түнгі ауруханалар тым қорқынышты.
Dialogue: 0,0:10:59.01,0:11:01.04,Default,,0,0,0,,Қалай? Кодогава, ұйықтап жатырсың ба?
Dialogue: 0,0:11:02.00,0:11:04.01,Default,,0,0,0,,Сізге рахмет, мен ұйықтай алмадым.
Dialogue: 0,0:11:04.06,0:11:07.01,Default,,0,0,0,,Менің дәріге рецептім жоқ.
Dialogue: 0,0:11:07.05,0:11:09.06,Default,,0,0,0,,Дәлірек айтқанда, дәрігердің қабылдауы осы сағатта ма?
Dialogue: 0,0:11:09.06,0:11:11.06,Default,,0,0,0,,Басқа ауруханаға баруға болады.
Dialogue: 0,0:11:11.06,0:11:13.04,Default,,0,0,0,,Сіз алатын дәрілер бірдей.
Dialogue: 0,0:11:13.06,0:11:15.01,Default,,0,0,0,,Егер мен шаштараз болсам
Dialogue: 0,0:11:15.01,0:11:18.02,Default,,0,0,0,,Мен Конояроның ұзын шаш үлгісін салғанмын.
Dialogue: 0,0:11:18.02,0:11:20.07,Default,,0,0,0,,Басқа шаштаразға бару сіздің өміріңізді құртып жатқан жоқ па?
Dialogue: 0,0:11:20.07,0:11:22.05,Default,,0,0,0,,Сіз солай ойлауыңыз мүмкін.
Dialogue: 0,0:11:23.03,0:11:26.01,Default,,0,0,0,,Бұл сұлулық салоны емес, бұл аурухана.
Dialogue: 0,0:11:26.01,0:11:28.03,Default,,0,0,0,,Ұзақ болса да қызықсыз.
Dialogue: 0,0:11:30.04,0:11:33.01,Default,,0,0,0,,Аурухана біраз уақытқа жабылуға шешім қабылдады.
Dialogue: 0,0:11:33.06,0:11:34.05,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:34.08,0:11:37.00,Default,,0,0,0,,Дәрілердің саны сәйкес келмейді.
Dialogue: 0,0:11:38.01,0:11:39.05,Default,,0,0,0,,Ол ұрланған ба?
Dialogue: 0,0:11:40.02,0:11:43.04,Default,,0,0,0,,Иә, бұл көптен бері жасалған сияқты.
Dialogue: 0,0:11:43.08,0:11:44.08,Default,,0,0,0,,Полиция
Dialogue: 0,0:11:44.08,0:11:45.05,Default,,0,0,0,,Мен ол жерде болған жоқпын.
Dialogue: 0,0:11:46.01,0:11:48.02,Default,,0,0,0,,Қылмысты туысы жасаған көрінеді.
Dialogue: 0,0:11:48.02,0:11:52.04,Default,,0,0,0,,Бұл туралы дүние білсе, мен құрбан болудан қылмыскер болуға өтемін.
Dialogue: 0,0:11:52.07,0:11:56.06,Default,,0,0,0,,Сондықтан мен оны жауып, ешқашан болмағандай кейіп танытамын деп ойладым.
Dialogue: 0,0:11:57.00,0:11:59.04,Default,,0,0,0,,Сіз өзіңізді қорғауды қалайсыз ба?
Dialogue: 0,0:11:59.06,0:12:02.04,Default,,0,0,0,,Бұл ұят, бірақ иә.
Dialogue: 0,0:12:03.07,0:12:06.01,Default,,0,0,0,,Ширакава-санды қорғау емес пе?
Dialogue: 0,0:12:06.08,0:12:09.06,Default,,0,0,0,,Ешкім Ширакава мырзаны кінәлі деп айтқан жоқ.
Dialogue: 0,0:12:10.01,0:12:12.07,Default,,0,0,0,,Ширакава мырза ақша үшін қиындыққа тап болды.
Dialogue: 0,0:12:13.00,0:12:15.09,Default,,0,0,0,,Тек осы негізде не айтып отырсыз?
Dialogue: 0,0:12:17.08,0:12:19.01,Default,,0,0,0,,Қандай ашуландырарлық, бірақ жасырынған жер табуым керек
Dialogue: 0,0:12:19.01,0:12:22.00,Default,,0,0,0,,Біраз бұрын гиппопотамға ұқсаған тұтынушыны алып кеткеннен кейін.
Dialogue: 0,0:12:22.04,0:12:26.06,Default,,0,0,0,,Мен Добу мен Ширакава мырзаны түнде артқы аллеяда бірге көрдім.
Dialogue: 0,0:12:27.02,0:12:30.07,Default,,0,0,0,,Добу Ширакава мырза туралы білген, сондықтан мағынасы бар.
Dialogue: 0,0:12:31.07,0:12:32.08,Default,,0,0,0,,Сіз анық көрдіңіз бе?
Dialogue: 0,0:12:32.08,0:12:34.09,Default,,0,0,0,,Артынан Ширакава мырза көрінді.
Dialogue: 0,0:12:34.09,0:12:36.03,Default,,0,0,0,,Сонда сіз түсінбейсіз.
Dialogue: 0,0:12:36.06,0:12:38.00,Default,,0,0,0,,Әсіресе түнде
Dialogue: 0,0:12:38.00,0:12:40.07,Default,,0,0,0,,Артқы жағынан ұқсас адамдар көп.
Dialogue: 0,0:12:41.06,0:12:43.02,Default,,0,0,0,,Жоқ, түсіндің.
Dialogue: 0,0:12:47.04,0:12:50.08,Default,,0,0,0,,Бір нәрсе өзгерді, Кодогава.
Dialogue: 0,0:12:52.01,0:12:54.05,Default,,0,0,0,,Температура көтерілді.
Dialogue: 0,0:12:55.07,0:12:57.01,Default,,0,0,0,,Баратын уақыт келді
Dialogue: 0,0:12:57.06,0:12:58.08,Default,,0,0,0,,Мінез-құлқы: Талғампаз
Dialogue: 0,0:13:01.06,0:13:04.07,Default,,0,0,0,,Бүгін мені әдеттен тыс екі адам шақырды.
Dialogue: 0,0:13:05.00,0:13:06.00,Default,,0,0,0,,Сізбен...
Dialogue: 0,0:13:22.00,0:13:24.07,Default,,0,0,0,,Кездесу орны туралы ойланыңыз.
Dialogue: 0,0:13:24.07,0:13:26.01,Default,,0,0,0,,Бұл жерде жаман ба?
Dialogue: 0,0:13:30.00,0:13:32.09,Default,,0,0,0,,Драйв жазбаңыздағы деректерді кім қалайтынын білесіз бе?
Dialogue: 0,0:13:33.02,0:13:36.00,Default,,0,0,0,,Осының алдында сізден сұрайын дегенім бар.
Dialogue: 0,0:13:36.00,0:13:38.06,Default,,0,0,0,,Аа, бірақ мен олардың біреуіне ғана жауап бере аламын.
Dialogue: 0,0:13:38.06,0:13:42.00,Default,,0,0,0,,Сіз әрқашан осылай басымдыққа ие болуға тырысасыз.
Dialogue: 0,0:13:42.00,0:13:44.02,Default,,0,0,0,,Мәміле осылай болады.
Dialogue: 0,0:13:44.02,0:13:47.05,Default,,0,0,0,,Біріншіден, біз кооперативтік позициядамыз.
Dialogue: 0,0:13:48.00,0:13:50.00,Default,,0,0,0,,Келіссөздер аяқталуы керек еді.
Dialogue: 0,0:13:50.00,0:13:52.03,Default,,0,0,0,,Осындай жерде Орбис болды ма?
Dialogue: 0,0:13:52.03,0:13:54.03,Default,,0,0,0,,Сіз бір сұрақты қолданып қойғансыз, солай емес пе?
Dialogue: 0,0:13:54.03,0:13:57.00,Default,,0,0,0,,Сіз сиқырлы шамдармен ақша жоғалтатын типсіз.
Dialogue: 0,0:13:57.08,0:13:59.05,Default,,0,0,0,,Бұл сұрақ емес.
Dialogue: 0,0:13:59.05,0:14:02.00,Default,,0,0,0,,Бұл жай ғана жылдам сұрақ болса, шайтан да түсінеді.
Dialogue: 0,0:14:02.02,0:14:03.02,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:14:03.05,0:14:05.02,Default,,0,0,0,,Сіздің сұрағыңыз қандай?
Dialogue: 0,0:14:05.06,0:14:09.02,Default,,0,0,0,,Ширакава мырзамен сіз байланыстасыз, солай ма?
Dialogue: 0,0:14:12.02,0:14:14.07,Default,,0,0,0,,Адал жауап бермесең, айтпаймын.
Dialogue: 0,0:14:15.01,0:14:19.02,Default,,0,0,0,,Біріншіден, сіз Ширакава мырзаны маған қорқыту үшін пешке ретінде пайдаландыңыз.
Dialogue: 0,0:14:19.06,0:14:22.03,Default,,0,0,0,,Егер сіз Ширакава мырзаға қосылсаңыз
Dialogue: 0,0:14:22.03,0:14:24.03,Default,,0,0,0,,Алғышарт орындалмайды
Dialogue: 0,0:14:25.02,0:14:26.08,Default,,0,0,0,,Иә
Dialogue: 0,0:14:27.01,0:14:30.06,Default,,0,0,0,,Ширакава мырзаны менімен байланыстырған сіздің нұсқауларыңыз болды.
Dialogue: 0,0:14:30.08,0:14:32.00,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:14:32.00,0:14:34.00,Default,,0,0,0,,Ол мұны рұқсатсыз жасады.
Dialogue: 0,0:14:34.06,0:14:37.08,Default,,0,0,0,,Ширакава мырза Горики клиникасынан дәрі ұрлаған.
Dialogue: 0,0:14:38.02,0:14:42.00,Default,,0,0,0,,Ал сіз оны басқа біреуге беріп, ақшаға айналдырып жатырсыз.
Dialogue: 0,0:14:42.04,0:14:43.00,Default,,0,0,0,,Бұл дұрыс па?
Dialogue: 0,0:14:43.00,0:14:44.05,Default,,0,0,0,,Сұрақтарыңыз көп емес пе?
Dialogue: 0,0:14:44.05,0:14:46.06,Default,,0,0,0,,Орбисті салсаңыз, бұл 4-ші.
Dialogue: 0,0:14:46.06,0:14:47.07,Default,,0,0,0,,Э? Ой! Вау!
Dialogue: 0,0:14:48.04,0:14:50.03,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:50.03,0:14:52.03,Default,,0,0,0,,Кішкентай шиногилердің арқасында
Dialogue: 0,0:14:52.08,0:14:55.00,Default,,0,0,0,,Жарайды, Яно да сені мазақ етеді.
Dialogue: 0,0:14:55.00,0:14:57.08,Default,,0,0,0,,Ширакаваның қарызын алған мен болдым.
Dialogue: 0,0:14:57.08,0:15:00.01,Default,,0,0,0,,Ол төлеп жатыр, болды.
Dialogue: 0,0:15:00.01,0:15:01.04,Default,,0,0,0,,Шиноги емес
Dialogue: 0,0:15:02.00,0:15:03.02,Default,,0,0,0,,Жақсы, мен оған жауап бердім.
Dialogue: 0,0:15:03.02,0:15:04.05,Default,,0,0,0,,Енді сіздің кезегіңіз
Dialogue: 0,0:15:05.02,0:15:08.05,Default,,0,0,0,,Егер мұндай жағдайлар орын алса, мен енді уәдемді орындаудың қажеті жоқ.
Dialogue: 0,0:15:08.08,0:15:11.05,Default,,0,0,0,,Қазір мен барлық жағынан қиыншылыққа тап болдым.
Dialogue: 0,0:15:11.05,0:15:13.07,Default,,0,0,0,,Бірқатар қателіктерден кейін мен шаршадым.
Dialogue: 0,0:15:14.01,0:15:16.08,Default,,0,0,0,,Мен бастығым берген маңызды нәрседен айырылдым.
Dialogue: 0,0:15:16.08,0:15:20.07,Default,,0,0,0,,Жақында бір әуесқойдың мені ұстаймын деп жатқан видеосы шықты.
Dialogue: 0,0:15:20.07,0:15:23.06,Default,,0,0,0,,Ол 10 миллион рет ойналған сияқты, бұл қорқынышты.
Dialogue: 0,0:15:25.00,0:15:26.00,Default,,0,0,0,,Ол атақты адам.
Dialogue: 0,0:15:26.06,0:15:31.01,Default,,0,0,0,,Маған Кодогова-кунның диск жазба деректерін алғысы келген адамның атын білуім керек.
Dialogue: 0,0:15:31.01,0:15:34.01,Default,,0,0,0,,Енді сені өлтіруден басқа амалым жоқ.
Dialogue: 0,0:15:34.05,0:15:36.08,Default,,0,0,0,,Сіз осылай өлтіресіз...
Dialogue: 0,0:15:37.09,0:15:41.02,Default,,0,0,0,,Қол-аяғымды байлап, бос ваннаға лақтыр
Dialogue: 0,0:15:41.06,0:15:45.05,Default,,0,0,0,,Суды аз-аздап қоссақ қалай болады?
Dialogue: 0,0:15:46.08,0:15:50.08,Default,,0,0,0,,Мен адамдарға ұнамайтын нәрсеге сезімталмын, сізге рахмет.
Dialogue: 0,0:15:53.04,0:15:55.06,Default,,0,0,0,,Мен Mystery Kiss менеджерімін.
Dialogue: 0,0:15:55.06,0:15:57.01,Default,,0,0,0,,Жұмбақ поцелу?
Dialogue: 0,0:15:58.00,0:16:00.00,Default,,0,0,0,,Онда флайер бар.
Dialogue: 0,0:16:02.02,0:16:05.07,Default,,0,0,0,,Яноның мыңжапырақшасы Сіз осындай нәрсемен араласқыңыз келе ме?
Dialogue: 0,0:16:05.09,0:16:06.06,Default,,0,0,0,,Сонымен
Dialogue: 0,0:16:06.09,0:16:08.09,Default,,0,0,0,,Менеджер не деді?
Dialogue: 0,0:16:08.09,0:16:11.06,Default,,0,0,0,,Маған сатып алуға рұқсат етіңіз, өйткені мен оны PV үшін қолданамын.
Dialogue: 0,0:16:11.09,0:16:16.05,Default,,0,0,0,,Бұл үш адамның бірі бастықтың сыныптасының қызы екенін білдіре ме?
Dialogue: 0,0:16:17.00,0:16:21.05,Default,,0,0,0,,Деректерді тек кесіп тастағысы келетін бөліктерімен сату жақсы идея болуы мүмкін.
Dialogue: 0,0:16:22.00,0:16:24.03,Default,,0,0,0,,Қанша жұмсауға болатынын келісіңіз.
Dialogue: 0,0:16:24.06,0:16:27.01,Default,,0,0,0,,Мен сіздің Шиногилеріңізге қосылатын ойым жоқ.
Dialogue: 0,0:16:27.01,0:16:28.09,Default,,0,0,0,,Қалғанын қалауыңызша орындаңыз.
Dialogue: 0,0:16:28.09,0:16:32.00,Default,,0,0,0,,Маған бәрібір. Мен үшін енді уайымдама.
Dialogue: 0,0:16:32.04,0:16:37.01,Default,,0,0,0,,Эй, сен таң қалдың ба? Ширакава туралы
Dialogue: 0,0:16:53.04,0:16:55.07,Default,,0,0,0,,Какки үнемі осы жерге келе ме?
Dialogue: 0,0:16:56.04,0:16:58.01,Default,,0,0,0,,Дұрыс, жақсы...
Dialogue: 0,0:16:58.01,0:17:00.06,Default,,0,0,0,,Айына бір барамын ба, бармаймын ба.
Dialogue: 0,0:17:00.06,0:17:01.06,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:17:01.06,0:17:03.02,Default,,0,0,0,,Бұл менің мұнда бірінші рет келуім
Dialogue: 0,0:17:03.05,0:17:03.55,Default,,0,0,0,,Иә
Dialogue: 0,0:17:09.00,0:17:11.02,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:12.00,0:17:14.01,Default,,0,0,0,,Біраз Күлетін жаман
Dialogue: 0,0:17:16.05,0:17:17.08,Default,,0,0,0,,Шихо-чан хаса
Dialogue: 0,0:17:17.08,0:17:20.08,Default,,0,0,0,,Сіз немен айналысасыз?
Dialogue: 0,0:17:20.08,0:17:22.00,Default,,0,0,0,,Ванна қабылдау кезінде
Dialogue: 0,0:17:23.08,0:17:25.04,Default,,0,0,0,,Мен ванна қабылдағанды ұнатамын.
Dialogue: 0,0:17:28.02,0:17:31.06,Default,,0,0,0,,Менің отбасым кедей және көп ағайынды болатын.
Dialogue: 0,0:17:31.06,0:17:35.02,Default,,0,0,0,,Ұзақ уақыт бойы жалғыз тұратын жерім монша болды.
Dialogue: 0,0:17:36.04,0:17:37.03,Default,,0,0,0,,Кедейлік…
Dialogue: 0,0:17:37.03,0:17:40.08,Default,,0,0,0,,Мен Аяз атадан Рождестволық сыйлық ретінде ванна тұздарын сұрадым.
Dialogue: 0,0:17:40.08,0:17:42.03,Default,,0,0,0,,Шыңғырлаған дыбыс шығаратын
Dialogue: 0,0:17:42.09,0:17:44.01,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:17:44.06,0:17:46.04,Default,,0,0,0,,Бұл біртүрлі... сүйкімді.
Dialogue: 0,0:17:46.06,0:17:48.06,Default,,0,0,0,,Каккинчи моншасы керемет.
Dialogue: 0,0:17:48.09,0:17:50.03,Default,,0,0,0,,Аяғыңызды созуға болатыны?
Dialogue: 0,0:17:50.07,0:17:53.09,Default,,0,0,0,,Иә, иә, джакузи бар, әрине.
Dialogue: 0,0:17:54.06,0:17:56.03,Default,,0,0,0,,Тіпті теледидар көре алмайсыз ба?
Dialogue: 0,0:17:57.00,0:17:58.08,Default,,0,0,0,,Әрине
Dialogue: 0,0:17:59.01,0:18:00.08,Default,,0,0,0,,Менің барғым келеді
Dialogue: 0,0:18:01.02,0:18:02.08,Default,,0,0,0,,Жоқ, бұл әлі біраз...
Dialogue: 0,0:18:02.08,0:18:04.02,Default,,0,0,0,,Қарашы, тез... Ерте деп айту керек.
Dialogue: 0,0:18:04.02,0:18:07.07,Default,,0,0,0,,Олай болса... Олай болса, келесі жолы Юфуинге бармаймын.
Dialogue: 0,0:18:08.03,0:18:09.01,Default,,0,0,0,,Менің барғым келеді
Dialogue: 0,0:18:09.01,0:18:10.04,Default,,0,0,0,,Юфуин қайда?
Dialogue: 0,0:18:10.04,0:18:12.08,Default,,0,0,0,,Ойта префектурасы қысқа рейс қалды
Dialogue: 0,0:18:13.01,0:18:15.06,Default,,0,0,0,,Сізде жеке ұшағы бар ма?
Dialogue: 0,0:18:16.04,0:18:18.07,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:18:19.02,0:18:20.04,Default,,0,0,0,,Не?
Dialogue: 0,0:18:23.06,0:18:26.09,Default,,0,0,0,,Шихо-чан қазір университет студенті, солай ма?
Dialogue: 0,0:18:27.04,0:18:28.05,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:29.07,0:18:31.06,Default,,0,0,0,,Жас болсаң да
Dialogue: 0,0:18:32.00,0:18:35.06,Default,,0,0,0,,Әлгі кекеке...
Dialogue: 0,0:18:35.06,0:18:36.06,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:18:38.00,0:18:38.50,Default,,0,0,0,,Сәлем
Dialogue: 0,0:18:39.01,0:18:41.01,Default,,0,0,0,,Оны әкелудің қажеті жоқ.
Dialogue: 0,0:18:42.02,0:18:43.07,Default,,0,0,0,,Бұл үлгі.
Dialogue: 0,0:18:46.08,0:18:47.06,Default,,0,0,0,,Уақытыңызды алыңыз
Dialogue: 0,0:18:48.08,0:18:50.05,Default,,0,0,0,,Сонымен, сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:51.05,0:18:56.01,Default,,0,0,0,,Шихо-чан шынымен үйленгісі келеді ме?
Dialogue: 0,0:18:56.06,0:18:59.05,Default,,0,0,0,,Иә, мен бұрыннан әйел болуды армандайтынмын.
Dialogue: 0,0:18:59.05,0:19:01.09,Default,,0,0,0,,Менің ойымша, неғұрлым тезірек болса, соғұрлым жақсы.
Dialogue: 0,0:19:02.01,0:19:04.09,Default,,0,0,0,,Тосын сый ретінде сақина беріліп, ұсыныс жасалды.
Dialogue: 0,0:19:04.09,0:19:06.00,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:19:09.07,0:19:10.08,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:19:10.08,0:19:11.07,Default,,0,0,0,,Мен және...
Dialogue: 0,0:19:11.07,0:19:13.01,Default,,0,0,0,,Эй, мынаны қарашы.
Dialogue: 0,0:19:14.03,0:19:20.00,Default,,0,0,0,,Imai@Nidadou қолдау нөмірі 1 күн бұрын, ол тоқтаған жоқ….
Dialogue: 0,0:19:15.06,0:19:17.07,Default,,0,0,0,,Сіз 1 миллиард иен ұтып алдыңыз.
Dialogue: 0,0:19:17.07,0:19:18.08,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:19:20.00,0:19:21.06,Default,,0,0,0,,1 миллиард иен Бұл таңқаларлық
Dialogue: 0,0:19:21.06,0:19:25.05,Default,,0,0,0,,Менде де онша көп емес шығар.
Dialogue: 0,0:19:26.05,0:19:28.02,Default,,0,0,0,,Руи Никайдоның сүйіктісі
Dialogue: 0,0:19:29.08,0:19:30.06,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:19:31.07,0:19:33.00,Default,,0,0,0,,Сонымен, сіз мұны білесіз бе?
Dialogue: 0,0:19:33.00,0:19:35.01,Default,,0,0,0,,Бұл қазір қызу тақырып.
Dialogue: 0,0:19:35.05,0:20:27.02,Default,,0,0,0,,[Соғыс туралы мәлімдеме] Биылғы ішкі қоршау қызу жүріп жатыр! [Тайчи Катсура] Сәлеметсіз бе, бұл Тайчи Кабасава.
Dialogue: 0,0:19:37.06,0:19:39.02,Default,,0,0,0,,Осымен мәлімдеймін
Dialogue: 0,0:19:39.02,0:19:42.09,Default,,0,0,0,,Мен, Тайчи Кабасава, Добуды осы жылдың ішінде ұстаймын.
Dialogue: 0,0:19:42.09,0:19:43.09,Default,,0,0,0,,Себебі
Dialogue: 0,0:19:43.09,0:19:47.03,Default,,0,0,0,,10 күн бұрын интернетке салған суретімде кездейсоқ су ағыны болды.
Dialogue: 0,0:19:47.03,0:19:49.03,Default,,0,0,0,,Мен БАҚ өкілдеріне сұхбат бердім.
Dialogue: 0,0:19:49.03,0:19:52.04,Default,,0,0,0,,Менің ойымша, бұл туралы білетіндер бар, өйткені бұл біраз шуға айналды.
Dialogue: 0,0:19:52.04,0:19:53.04,Default,,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:19:53.04,0:19:57.06,Default,,0,0,0,,Осындай сенсациялық атаумен кейбір адамдар оны қауіпті емес деп ойлауы мүмкін.
Dialogue: 0,0:19:57.06,0:20:00.03,Default,,0,0,0,,Бұл менің әділеттілік сезімім.
Dialogue: 0,0:20:00.03,0:20:02.04,Default,,0,0,0,,Добу туралы білмейтіндерге мен сізге түсіндіргім келеді.
Dialogue: 0,0:20:02.04,0:20:04.04,Default,,0,0,0,,Ал, сен жартылай сұрсың ба әлде якудзасың ба?
Dialogue: 0,0:20:04.04,0:20:05.09,Default,,0,0,0,,Мен егжей-тегжейлі білмеймін, бірақ
Dialogue: 0,0:20:05.09,0:20:07.05,Default,,0,0,0,,Полиция қуып келе жатқан адам
Dialogue: 0,0:20:07.05,0:20:10.00,Default,,0,0,0,,Бірақ менде бар ақпарат бойынша,
Dialogue: 0,0:20:10.00,0:20:13.01,Default,,0,0,0,,Полиция Добуды ұстай алмайтын сияқты.
Dialogue: 0,0:20:13.01,0:20:15.09,Default,,0,0,0,,Артында маңызды біреу бар ма, білмеймін.
Dialogue: 0,0:20:15.09,0:20:17.07,Default,,0,0,0,,Ал мына лас жігіт әлдеқашан
Dialogue: 0,0:20:17.07,0:20:21.02,Default,,0,0,0,,Оның зұлым адамы сонша, сіз оны әлемдегі барлық қылмысты жасады деп ойлауыңыз мүмкін.
Dialogue: 0,0:20:21.02,0:20:22.08,Default,,0,0,0,,Ұрлық, тонау, алаяқтық
Dialogue: 0,0:20:22.08,0:20:24.04,Default,,0,0,0,,Жарақат алу бопсалау Зорлау
Dialogue: 0,0:20:24.04,0:20:25.04,Default,,0,0,0,,Тас өртеу
Dialogue: 0,0:20:25.04,0:20:27.02,Default,,0,0,0,,Адам ұрлау және өлтіру
Dialogue: 0,0:20:27.05,0:20:29.08,Default,,0,0,0,,Жарайды, тізіп шығу өте көп.
Dialogue: 0,0:20:30.04,0:20:32.02,Default,,0,0,0,,Тек тас қалқып тұрды.
Dialogue: 0,0:20:32.04,0:20:34.00,Default,,0,0,0,,Негізі менің де айналамда. Міне, мен осындамын
Dialogue: 0,0:20:34.00,0:20:36.08,Default,,0,0,0,,Мен оны осында төмендетемін. Арық суынан жартылай өлген бір жігіт болды.
Dialogue: 0,0:20:35.04,0:20:35.54,Default,,0,0,0,,Иә
Dialogue: 0,0:20:36.08,0:20:38.08,Default,,0,0,0,,Мен мұны бір досымның досынан естідім. Досыңыз туралы естігенім үшін кешіріңіз.
Dialogue: 0,0:20:38.08,0:20:41.00,Default,,0,0,0,,Мүмкін сіздердің де тыңдаушыларыңыз бар шығар. Оқиғамен таныс еместер үшін мына сайтқа кіріңіз
Dialogue: 0,0:20:41.00,0:20:43.00,Default,,0,0,0,,Кейбір адамдар құрбан болған болуы мүмкін. Сондай-ақ жәбірленуші
Dialogue: 0,0:20:43.00,0:20:46.06,Default,,0,0,0,,Тікелей болмаса да, бұл жәбірленушінің жұмысы болуы мүмкін. Мүмкін емес, мүмкін емес, сонымен қатар мүмкін.
Dialogue: 0,0:20:46.06,0:20:49.00,Default,,0,0,0,,Кейбір адамдардың велосипед ершігі ұрланған болуы мүмкін. Өз көлігінде отырған адам
Dialogue: 0,0:20:49.00,0:20:52.00,Default,,0,0,0,,Ал мен, Тайчи Кабасава, ол жігітті ұстаймын. Бұл мақаланы Souta Gabe және т.б.
Dialogue: 0,0:20:52.03,0:20:55.05,Default,,0,0,0,,Менің ойымша, мен үнемі жұмыс іздеуде болдым. Мен бұрын не істедім
Dialogue: 0,0:20:54.00,0:20:55.01,Default,,0,0,0,,Мен айтқандай істесең, сен оны жасай аласың.
Dialogue: 0,0:20:55.04,0:20:58.08,Default,,0,0,0,,Сол шағын касса Бірақ сіз шынымен не істегіңіз келеді? Дегенмен, мен мән-жайды ойлап отырмын.
Dialogue: 0,0:20:57.06,0:20:59.00,Default,,0,0,0,,Орныңызда күтіңіз.
Dialogue: 0,0:20:58.08,0:21:00.09,Default,,0,0,0,,Бұл компанияда тісті болу туралы емес. Қалыпты әлеуметтік қызметкер емес
Dialogue: 0,0:21:00.03,0:21:02.00,Default,,0,0,0,,Бұл үлгі.
Dialogue: 0,0:21:01.03,0:21:02.04,Default,,0,0,0,,Толып жатқан пойызға міну Күн сайын отыратын қызметкерлер пойызы
Dialogue: 0,0:21:02.05,0:21:05.02,Default,,0,0,0,,Сіз шынымен тірімін деп айта аласыз ба?
Dialogue: 0,0:21:05.02,0:21:07.01,Default,,0,0,0,,Мен өз өмірім туралы ойлаған кезде
Dialogue: 0,0:21:07.01,0:21:09.05,Default,,0,0,0,,Осылайша кішкентай кезімдегі бір түс есіме түсті.
Dialogue: 0,0:21:09.05,0:21:11.03,Default,,0,0,0,,Қиындыққа тап болған адамдарға көмектескім келеді.
Dialogue: 0,0:21:11.03,0:21:13.02,Default,,0,0,0,,Батырларға бәрі де тәнті болды.
Dialogue: 0,0:21:13.04,0:21:14.07,Default,,0,0,0,,Сондықтан мен сені ұстаймын
Dialogue: 0,0:21:14.07,0:21:17.03,Default,,0,0,0,,Мен жұмыс іздеу мен мектепті елемеймін.
Dialogue: 0,0:21:17.03,0:21:19.02,Default,,0,0,0,,Сіз оны ұстаған кезде не істейсіз?
Dialogue: 0,0:21:19.02,0:21:21.07,Default,,0,0,0,,Кешірім сұраймын. Мен кешірім сұраймын.
Dialogue: 0,0:21:21.07,0:21:23.02,Default,,0,0,0,,Мен сәжде туралы бейне жүктеймін
Dialogue: 0,0:21:23.02,0:21:27.02,Default,,0,0,0,,Оңалту Егер заң мені жазалай алмаса, мен сізге санкция беремін.
Dialogue: 0,0:21:27.02,0:21:28.04,Default,,0,0,0,,Жоқ, бұл біз.
Dialogue: 0,0:21:28.04,0:21:29.09,Default,,0,0,0,,Сіз де мұны көріп отырсыз.
Dialogue: 0,0:21:29.09,0:21:31.06,Default,,0,0,0,,Біз ағынды ұстаймыз
Dialogue: 0,0:21:31.06,0:21:34.04,Default,,0,0,0,,Мен Мейси университетінен Тайчи Кабасавамын.
Dialogue: 0,0:21:34.04,0:21:37.06,Default,,0,0,0,,Мен жүгірмеймін, жасырмаймын, ауыртпалықты көтеремін.
Dialogue: 0,0:21:37.06,0:21:40.00,Default,,0,0,0,,Сондықтан кез келген ақпарат құпталады, ынтымақтастықта болыңыз.
Dialogue: 0,0:21:40.00,0:21:41.01,Default,,0,0,0,,Қылмыс үшін жаза
Dialogue: 0,0:21:41.01,0:21:42.04,Default,,0,0,0,,Біз зұлымдықты жеңеміз
Dialogue: 0,0:21:42.04,0:21:44.05,Default,,0,0,0,,Әділдік әрқашан жеңеді
Dialogue: 0,0:21:45.06,0:21:47.06,Default,,0,0,0,,Бұл мақтаудың дауылы.
Dialogue: 0,0:21:47.06,0:21:49.05,Default,,0,0,0,,10 миллион қаралды
Dialogue: 0,0:21:49.05,0:21:50.08,Default,,0,0,0,,«Шынымен, бұл Құдай».
Dialogue: 0,0:21:50.08,0:21:52.09,Default,,0,0,0,,«Кабасава мырза, мен сізді қолдаймын».
Dialogue: 0,0:21:52.09,0:21:54.02,Default,,0,0,0,,Бұл қауіпті, солай емес пе?
Dialogue: 0,0:21:55.03,0:21:56.06,Default,,0,0,0,,Міне осылай
Dialogue: 0,0:21:56.06,0:21:57.07,Default,,0,0,0,,Иә
Dialogue: 0,0:22:01.00,0:22:02.00,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:22:03.08,0:22:04.08,Default,,0,0,0,,Осыған ұқсас нәрсе бар ма?
Dialogue: 0,0:22:05.02,0:22:06.08,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:22:10.00,0:22:11.06,Default,,0,0,0,,Бұл карта немесе басқа нәрсе емес.
Dialogue: 0,0:22:12.00,0:22:15.04,Default,,0,0,0,,Иә, мен әдетте тек сандық сандарды қараймын.
Dialogue: 0,0:22:15.04,0:22:18.05,Default,,0,0,0,,Адамдармен қарым-қатынас жасағанда, сіз қолма-қол ақшаны пайдаланғыңыз келеді.
Dialogue: 0,0:22:18.05,0:22:19.08,Default,,0,0,0,,Менің әмияным да жоқ
Dialogue: 0,0:22:20.01,0:22:22.07,Default,,0,0,0,,Мм... Менде Боттега Венета болды.
Dialogue: 0,0:22:22.07,0:22:23.08,Default,,0,0,0,,Мен оны бағыныштыға бердім.
Dialogue: 0,0:22:30.09,0:22:34.09,Default,,0,0,0,,Түсіндіру Тұтынушыларға қызмет көрсету нөмірі Сауда мәліметтері Пайыз мөлшерлемесі (нақты жылдық пайыздық мөлшерлеме) Берешек (жылдық пайыздық мөлшерлеме) Тапсырыс беру күні Тапсырыс дәрежесі Балық несие тарауы
Dialogue: 0,0:22:32.02,0:22:35.00,Default,,0,0,0,,Бұл субтитрді Менг Чая жазған. Коммерциялық мақсатта пайдалану үшін қосымша алмасу сынағы және мониторингі арқылы шығарылған Аударма: таң қалдыратын редакция: Ронни Уақыты мен өсуі: Қытай тарапы Кеш кезең: MIR
Dialogue: 0,0:22:45.06,0:22:46.06,Default,,0,0,0,,Келіңіздер, той
Dialogue: 0,0:22:46.06,0:22:47.06,Default,,0,0,0,,Шампанға
Dialogue: 0,0:22:47.06,0:22:49.05,Default,,0,0,0,,Мені ал
Dialogue: 0,0:22:49.05,0:22:51.08,Default,,0,0,0,,Тәтті болу қызық емес, солай ма?
Dialogue: 0,0:22:51.08,0:22:53.04,Default,,0,0,0,,Сіз және Мен көбірек ынталандыру
Dialogue: 0,0:22:54.04,0:22:55.04,Default,,0,0,0,,Бұл Бэнси ме?
Dialogue: 0,0:22:55.04,0:22:57.03,Default,,0,0,0,,Маған көбірек дәмді беріңіз
Dialogue: 0,0:22:57.03,0:22:59.02,Default,,0,0,0,,Жоғарғы жолдар
Dialogue: 0,0:22:59.02,0:23:01.03,Default,,0,0,0,,Менің сезімім қазірдің өзінде бұлыңғыр
Dialogue: 0,0:23:03.03,0:23:06.03,Default,,0,0,0,,Жұлдызбен билеу
Dialogue: 0,0:23:08.08,0:23:10.09,Default,,0,0,0,,Жұмбақ поцелу
Dialogue: 0,0:23:10.09,0:23:14.00,Default,,0,0,0,,Би билеу Өтінемін, тоқтамаңыз
Dialogue: 0,0:23:14.00,0:23:16.02,Default,,0,0,0,,Түнде ериді
Dialogue: 0,0:23:16.05,0:23:18.06,Default,,0,0,0,,Махаббат сияқты сезім
Dialogue: 0,0:23:18.09,0:23:22.02,Default,,0,0,0,,Ол теңселіп тұр
Dialogue: 0,0:23:22.06,0:23:26.03,Default,,0,0,0,,Бүгін кешке үйге барғым келмейді
Dialogue: 0,0:23:26.03,0:23:29.04,Default,,0,0,0,,Мейірімді болып көріну
Dialogue: 0,0:23:29.04,0:23:32.04,Default,,0,0,0,,Жүрек - құпия қашықтық
Dialogue: 0,0:23:34.09,0:23:49.09,Default,,0,0,0,,Мен не ойлаймын?
Dialogue: 0,0:23:35.04,0:23:38.04,Default,,0,0,0,,Жоқ, Кодогава мырза, сіздің жақсы болғаныңызға қуаныштымын.
Dialogue: 0,0:23:38.04,0:23:39.06,Default,,0,0,0,,Мені олай атама.
Dialogue: 0,0:23:39.06,0:23:41.01,Default,,0,0,0,,Бұл жай ғана сәттілік деп ойламайсыз ба?
Dialogue: 0,0:23:41.01,0:23:44.02,Default,,0,0,0,,Тағдырдың жазуымен мен Кодогава-саманы осылай қайта кездестірдім.
Dialogue: 0,0:23:44.02,0:23:46.09,Default,,0,0,0,,Егер біз сол аймақты кезіп жүрсек, бірдей жолаушыларды алып кету әдеттегідей...
Dialogue: 0,0:23:46.09,0:23:47.06,Default,,0,0,0,,Бірақ 1 млрд...
Dialogue: 0,0:23:47.06,0:23:49.06,Default,,0,0,0,,Тш, қатты сөйлеме.
Dialogue: 0,0:23:50.59,0:23:55.59,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
