Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.42,0:00:08.88,Default,,0,0,0,,Адамдар сұрайды
Dialogue: 0,0:00:09.46,0:00:11.26,Default,,0,0,0,,«Өзі дегеніміз не?»
Dialogue: 0,0:00:11.76,0:00:13.63,Default,,0,0,0,,«Өмір дегеніміз не?»
Dialogue: 0,0:00:14.22,0:00:16.22,Default,,0,0,0,,«Ғалам дегеніміз не?»
Dialogue: 0,0:00:16.80,0:00:19.35,Default,,0,0,0,,Адамдар жауабын білмей өледі.
Dialogue: 0,0:00:19.85,0:00:23.18,Default,,0,0,0,,Адамдардың тағдыры осындай
Dialogue: 0,0:00:31.65,0:00:33.74,Default,,0,0,0,,Мен бір рет көрген көрініс
Dialogue: 0,0:00:34.57,0:00:38.66,Default,,0,0,0,,Сәл тыныштық, кішкене үміт
Dialogue: 0,0:00:46.17,0:00:50.59,Default,,0,0,0,,Оны таптағанда, адам тұрады
Dialogue: 0,0:01:15.20,0:01:16.95,Default,,0,0,0,,Үміт сенің қолыңда
Dialogue: 0,0:01:17.78,0:01:19.78,Default,,0,0,0,,Жақсы эволюция
Dialogue: 0,0:01:20.37,0:01:22.49,Default,,0,0,0,,Үлкен күшті көтеріңіз
Dialogue: 0,0:01:23.29,0:01:24.70,Default,,0,0,0,,Ер адам ұрысады...
Dialogue: 0,0:01:25.29,0:01:29.50,Default,,0,0,0,,Үмітсіздікті біл
Dialogue: 0,0:01:33.96,0:01:35.38,Default,,0,0,0,,Адамдар сұрайды
Dialogue: 0,0:01:35.88,0:01:37.18,Default,,0,0,0,,«Неге ұрысу керек?»
Dialogue: 0,0:01:38.01,0:01:39.09,Default,,0,0,0,,«Неге өлтіру керек?»
Dialogue: 0,0:01:39.89,0:01:40.93,Default,,0,0,0,,«Неге өлу керек»
Dialogue: 0,0:01:42.39,0:01:45.23,Default,,0,0,0,,Адамдар жауабын білмей өледі.
Dialogue: 0,0:01:46.48,0:01:49.81,Default,,0,0,0,,Бұл адам бақыты
Dialogue: 0,0:02:14.80,0:02:18.84,Default,,0,0,0,,Ей, адамдар, ақымақ түрлер.
Dialogue: 0,0:02:19.34,0:02:23.68,Default,,0,0,0,,Осы абсолютті билік алдында қорқыңыз.
Dialogue: 0,0:02:24.51,0:02:29.02,Default,,0,0,0,,Қатты қорқыныш пен үмітсіздіктің алдында тағзым ет!
Dialogue: 0,0:02:29.52,0:02:32.44,Default,,0,0,0,,Спиральды патша есімінің алдында
Dialogue: 0,0:02:39.74,0:02:44.49,Default,,0,0,0,,Жер қойнауында ұйықта, ақымақ нәсіл.
Dialogue: 0,0:02:45.45,0:02:49.33,Default,,0,0,0,,Бұл планетаның тағдыры
Dialogue: 0,0:03:05.89,0:03:09.64,Default,,0,0,0,,Менің жұмысым күнде қазу.
Dialogue: 0,0:03:10.64,0:03:13.61,Default,,0,0,0,,Неғұрлым көп ор қазсаң, сонша ауылың кеңейеді.
Dialogue: 0,0:03:14.40,0:03:18.53,Default,,0,0,0,,Ауыл бастығы шошқа меңінен жасалған стейк жеуге рұқсат бергеніне қуанады.
Dialogue: 0,0:03:19.19,0:03:21.15,Default,,0,0,0,,Сіз стейк іздеп жатырсыз ба?
Dialogue: 0,0:03:21.65,0:03:23.11,Default,,0,0,0,,Бұл да басқа.
Dialogue: 0,0:03:23.62,0:03:24.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:26.49,0:03:27.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:33.04,0:03:34.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:35.59,0:03:38.00,Default,,0,0,0,,Кейде қазына табуға болады
Dialogue: 0,0:03:48.60,0:03:50.60,Default,,0,0,0,,Сора Сора, қазып ал!
Dialogue: 0,0:03:50.68,0:03:52.44,Default,,0,0,0,,(Бұрғылау дыбысы)
Dialogue: 0,0:03:52.52,0:03:53.94,Default,,0,0,0,,- (Ауыл тұрғындары) О! -Уау...
Dialogue: 0,0:03:56.11,0:03:59.03,Default,,0,0,0,,Сора! Балалар, неге сонша қазуға болмайды?
Dialogue: 0,0:03:59.11,0:04:00.74,Default,,0,0,0,,Стейк жегіңіз келмейді ме?
Dialogue: 0,0:04:00.82,0:04:01.65,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:03.95,0:04:05.99,Default,,0,0,0,,Жоқ, қазушы Саймон
Dialogue: 0,0:04:06.07,0:04:09.62,Default,,0,0,0,,Күнделікті кір басып жүрудің қандай қызығы бар?
Dialogue: 0,0:04:09.70,0:04:11.58,Default,,0,0,0,,Менде біртүрлі нәрсе бар.
Dialogue: 0,0:04:11.66,0:04:13.96,Default,,0,0,0,,-(А қызы) Бұл жиіркенішті, солай емес пе? -(Қызы Б) Сасық.
Dialogue: 0,0:04:14.04,0:04:15.12,Default,,0,0,0,,А, мен саған қарап тұрмын.
Dialogue: 0,0:04:15.21,0:04:17.75,Default,,0,0,0,,Егер абай болмасаңыз, сізді қазып алуыңыз мүмкін.
Dialogue: 0,0:04:17.84,0:04:20.46,Default,,0,0,0,,Уау, бұл жиіркенішті
Dialogue: 0,0:04:20.55,0:04:21.51,Default,,0,0,0,,Хаа…
Dialogue: 0,0:04:28.47,0:04:30.68,Default,,0,0,0,,Жоғары қарап, жүр, Саймон
Dialogue: 0,0:04:32.18,0:04:33.35,Default,,0,0,0,,Ах Камина
Dialogue: 0,0:04:34.81,0:04:37.36,Default,,0,0,0,,Камина деме, аға де.
Dialogue: 0,0:04:38.61,0:04:41.19,Default,,0,0,0,,Ұсқынсыз әйел не дейді деп уайымдама.
Dialogue: 0,0:04:42.28,0:04:44.36,Default,,0,0,0,,Бұл сізге сәйкес келеді.
Dialogue: 0,0:04:45.74,0:04:48.91,Default,,0,0,0,,Өйткені сенің бұрғың аспанға тиетін бұрғы.
Dialogue: 0,0:04:50.49,0:04:53.37,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:04:53.45,0:04:55.25,Default,,0,0,0,,(Шошқа меңінің айқайы)
Dialogue: 0,0:04:55.75,0:04:57.79,Default,,0,0,0,,Yaho!
Dialogue: 0,0:04:58.29,0:05:01.63,Default,,0,0,0,,Бірақ, уайымдамаңыз! Гленн командасы жолда келе жатыр!
Dialogue: 0,0:05:01.71,0:05:03.34,Default,,0,0,0,,Боу!
Dialogue: 0,0:05:03.42,0:05:04.30,Default,,0,0,0,,Боота!
Dialogue: 0,0:05:04.38,0:05:05.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:06.01,0:05:07.59,Default,,0,0,0,,Күте тұрыңыз... не істеуіміз керек?
Dialogue: 0,0:05:07.68,0:05:08.39,Default,,0,0,0,,Тыңда, Саймон.
Dialogue: 0,0:05:08.47,0:05:11.10,Default,,0,0,0,,Төбені тесіп өту үшін бұрғыны пайдаланыңыз.
Dialogue: 0,0:05:11.18,0:05:13.18,Default,,0,0,0,,Сіз оны жойғаннан кейін, жоғарыда жер бар.
Dialogue: 0,0:05:13.27,0:05:15.52,Default,,0,0,0,,Осылай жүре бер!
Dialogue: 0,0:05:16.02,0:05:17.40,Default,,0,0,0,,Бұл ақылсыз!
Dialogue: 0,0:05:17.48,0:05:18.90,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:05:18.98,0:05:20.77,Default,,0,0,0,,Ақылға қонымсыздық арқылы ақылды жою
Dialogue: 0,0:05:20.86,0:05:22.82,Default,,0,0,0,,-Уау! -(Боота) Бұл... Буу.
Dialogue: 0,0:05:22.90,0:05:26.53,Default,,0,0,0,,Бұл біз, Гленн командасы!
Dialogue: 0,0:05:28.16,0:05:30.78,Default,,0,0,0,,-Сәлем... -Yaho~i!
Dialogue: 0,0:05:30.87,0:05:32.99,Default,,0,0,0,,Камина! Бұл қайтадан сенсің!
Dialogue: 0,0:05:33.58,0:05:34.79,Default,,0,0,0,,Жолдан кет, ауыл бастығы!
Dialogue: 0,0:05:34.87,0:05:36.21,Default,,0,0,0,,Ей, ақымақтар!
Dialogue: 0,0:05:36.29,0:05:38.58,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:05:40.13,0:05:42.42,Default,,0,0,0,,Оян!
Dialogue: 0,0:05:42.50,0:05:45.05,Default,,0,0,0,,Сіз айтып отырған жер жоқ.
Dialogue: 0,0:05:45.13,0:05:46.42,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:05:46.51,0:05:48.01,Default,,0,0,0,,Мен оны көрдім
Dialogue: 0,0:05:48.09,0:05:50.14,Default,,0,0,0,,Жерде қабырғалар, төбелер жоқ.
Dialogue: 0,0:05:50.22,0:05:52.85,Default,,0,0,0,,Оның орнында жарқыраған көк аспан.
Dialogue: 0,0:05:52.93,0:05:55.10,Default,,0,0,0,,Өтіріктің баласы өтірікші.
Dialogue: 0,0:05:55.18,0:05:56.02,Default,,0,0,0,,Ағам саған айтпады ма?
Dialogue: 0,0:05:56.10,0:05:59.10,Default,,0,0,0,,Сенің әкең де түс сияқты нәрселерді айтатын.
Dialogue: 0,0:05:59.19,0:06:02.82,Default,,0,0,0,,Күннің аяғында, бір жерде, тастың астында қалдым.
Dialogue: 0,0:06:02.90,0:06:06.28,Default,,0,0,0,,Жоқ! Әкем жерге түсті, мен онымен бірге бардым!
Dialogue: 0,0:06:06.36,0:06:08.95,Default,,0,0,0,,Онда не үшін келдің?
Dialogue: 0,0:06:09.03,0:06:09.74,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:10.32,0:06:12.03,Default,,0,0,0,,Тыңда, жақсылап есте сақта.
Dialogue: 0,0:06:12.12,0:06:14.29,Default,,0,0,0,,Бізде бар болғаны осы ауыл.
Dialogue: 0,0:06:14.37,0:06:16.41,Default,,0,0,0,,Бұл ашылмаған төбе ұрпақтан-ұрпаққа жеткен.
Dialogue: 0,0:06:16.50,0:06:18.71,Default,,0,0,0,,Ашуға болмайтын заттар
Dialogue: 0,0:06:18.79,0:06:21.92,Default,,0,0,0,,Ережені түсінбегендерге тамақ жоқ!
Dialogue: 0,0:06:22.00,0:06:24.09,Default,,0,0,0,,Мені түрмеге таста, тамақ ішуге рұқсат етпе.
Dialogue: 0,0:06:24.17,0:06:25.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:25.25,0:06:27.63,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:06:28.22,0:06:29.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:29.34,0:06:31.14,Default,,0,0,0,,Бұл... жер сілкінісі!
Dialogue: 0,0:06:31.22,0:06:32.85,Default,,0,0,0,,Барлығы, жасырын!
Dialogue: 0,0:06:36.10,0:06:38.48,Default,,0,0,0,,Камина Қашайық Камина!
Dialogue: 0,0:06:39.10,0:06:40.60,Default,,0,0,0,,-Маған ұнамайды -бірақ...
Dialogue: 0,0:06:40.69,0:06:42.15,Default,,0,0,0,,Мен қашпаймын
Dialogue: 0,0:06:47.15,0:06:49.61,Default,,0,0,0,,Қашпасаң жаншылып өлесің!
Dialogue: 0,0:06:49.70,0:06:50.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:51.36,0:06:54.83,Default,,0,0,0,,Түсіндім... Дұрыс, сен.
Dialogue: 0,0:06:55.70,0:06:57.83,Default,,0,0,0,,Уайымдама, енді бітті.
Dialogue: 0,0:07:01.83,0:07:06.09,Default,,0,0,0,,Күнде осылай жер сілкінісінен қорқып өмір сүресің бе?
Dialogue: 0,0:07:06.67,0:07:08.97,Default,,0,0,0,,Жер үстінде төбе жоқ!
Dialogue: 0,0:07:10.38,0:07:11.43,Default,,0,0,0,,Ғрр! Б-бұл жігіт…
Dialogue: 0,0:07:12.09,0:07:15.14,Default,,0,0,0,,Жетім балаларды өсіру саған садақа емес.
Dialogue: 0,0:07:15.22,0:07:17.06,Default,,0,0,0,,Өйткені мен ауыл бастығымын.
Dialogue: 0,0:07:17.14,0:07:19.60,Default,,0,0,0,,Мен осы ауылды, оның халқын қорғауға міндеттімін.
Dialogue: 0,0:07:20.43,0:07:23.06,Default,,0,0,0,,Бірақ мені тыңдамайтындар
Dialogue: 0,0:07:23.15,0:07:26.32,Default,,0,0,0,,Бұл ауылға керегі жоқ...
Dialogue: 0,0:07:26.40,0:07:26.90,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:26.98,0:07:30.28,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:07:30.36,0:07:30.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:38.91,0:07:40.12,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:44.29,0:07:46.38,Default,,0,0,0,,-(Ауылдық) Бұл бет... -(Ауылдық) Бұл бет!
Dialogue: 0,0:07:46.46,0:07:47.84,Default,,0,0,0,,Бұл үлкен тұлға.
Dialogue: 0,0:07:47.92,0:07:49.34,Default,,0,0,0,,Тістер... үлкен
Dialogue: 0,0:07:49.42,0:07:51.59,Default,,0,0,0,,А... а...
Dialogue: 0,0:07:51.67,0:07:54.05,Default,,0,0,0,,Ал сақина тәрізді күн тұтылуы туралы оқиға ше?
Dialogue: 0,0:07:54.84,0:07:56.10,Default,,0,0,0,,Жоғары!
Dialogue: 0,0:07:58.01,0:07:59.60,Default,,0,0,0,,Ол жерде.
Dialogue: 0,0:07:59.68,0:08:01.98,Default,,0,0,0,,Жердің үстінде жер болған болуы керек.
Dialogue: 0,0:08:02.06,0:08:05.10,Default,,0,0,0,,Мына үлкен жүзім жерден... жоғарыдан құлады.
Dialogue: 0,0:08:05.69,0:08:07.61,Default,,0,0,0,,Дұрыс, ауыл бастығы!
Dialogue: 0,0:08:09.40,0:08:12.82,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:08:14.28,0:08:16.16,Default,,0,0,0,,Бұл құбыжық!
Dialogue: 0,0:08:16.66,0:08:19.62,Default,,0,0,0,,А, жүгір, жүгір! Сіз жейсіз!
Dialogue: 0,0:08:20.12,0:08:22.00,Default,,0,0,0,,- (Ауыл бастығы) Ааа... - Хе.
Dialogue: 0,0:08:25.21,0:08:27.25,Default,,0,0,0,,Камина, асығыс, мына жаққа кел.
Dialogue: 0,0:08:27.34,0:08:28.09,Default,,0,0,0,,Камина?
Dialogue: 0,0:08:28.67,0:08:30.42,Default,,0,0,0,,Оу Оу Оу Оу!
Dialogue: 0,0:08:31.05,0:08:33.30,Default,,0,0,0,,Кенет ол адам ауылына келді.
Dialogue: 0,0:08:33.38,0:08:36.89,Default,,0,0,0,,Осындай ауыр азапты алу үшін сізде батылдық болуы керек.
Dialogue: 0,0:08:37.60,0:08:39.06,Default,,0,0,0,,Эй... эй! Қашу...
Dialogue: 0,0:08:39.81,0:08:40.81,Default,,0,0,0,,Мен сиқыр жасаймын.
Dialogue: 0,0:08:40.89,0:08:43.94,Default,,0,0,0,,Одан артық өзімшілдікке шыдамаймын.
Dialogue: 0,0:08:44.02,0:08:47.44,Default,,0,0,0,,Иә? Ол не, сен?
Dialogue: 0,0:08:48.02,0:08:49.11,Default,,0,0,0,,…Бұл мүмкін емес қой?
Dialogue: 0,0:08:49.19,0:08:51.07,Default,,0,0,0,,Ой! Мен саған үйретемін
Dialogue: 0,0:08:51.15,0:08:53.90,Default,,0,0,0,,Сол үлкен құлақтарды мұқият тыңда.
Dialogue: 0,0:08:54.57,0:08:57.37,Default,,0,0,0,,Гленн тобы Джиха ауылында танымал болуда.
Dialogue: 0,0:08:57.45,0:08:59.95,Default,,0,0,0,,Адамның жаны арқада
Dialogue: 0,0:09:00.03,0:09:03.25,Default,,0,0,0,,Қайсар... Әй, жын көсем.
Dialogue: 0,0:09:04.12,0:09:06.46,Default,,0,0,0,,Камина-сама, бұл мен туралы!
Dialogue: 0,0:09:07.21,0:09:11.34,Default,,0,0,0,,Камина-сама енді бұл ауылдағы заңсыздыққа шыдамайды!
Dialogue: 0,0:09:11.42,0:09:12.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:13.01,0:09:15.51,Default,,0,0,0,,Бвахахаха!
Dialogue: 0,0:09:15.59,0:09:18.59,Default,,0,0,0,,Кішкентай адамдар не істей алады?
Dialogue: 0,0:09:18.68,0:09:19.39,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:09:19.47,0:09:20.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:20.51,0:09:21.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:21.76,0:09:24.18,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:09:30.15,0:09:32.36,Default,,0,0,0,,Балалар, артқа тұрыңдар!
Dialogue: 0,0:09:32.44,0:09:33.65,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:09:33.73,0:09:34.74,Default,,0,0,0,,Сондай-ақ жерден
Dialogue: 0,0:09:35.36,0:09:35.90,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:09:35.99,0:09:37.78,Default,,0,0,0,,(Night Eye) Не істесең де, олар бізді сол жақта байқамай қалсын.
Dialogue: 0,0:09:37.86,0:09:40.37,Default,,0,0,0,,жағдай Хонецукидің Қвиркінің арқасында өзгерді.
Dialogue: 0,0:09:42.12,0:09:45.04,Default,,0,0,0,,Менде жабысқақ бөксе бар, бірден тұрамын.
Dialogue: 0,0:09:45.12,0:09:46.58,Default,,0,0,0,,-Йо Беппин-сан-(Йоко)?
Dialogue: 0,0:09:47.16,0:09:48.62,Default,,0,0,0,,Сіз онымен ұрысып жатырсыз ба?
Dialogue: 0,0:09:48.71,0:09:49.79,Default,,0,0,0,,Мен саған қол ұшын созамын.
Dialogue: 0,0:09:49.88,0:09:51.04,Default,,0,0,0,,Не?
Dialogue: 0,0:09:51.13,0:09:53.59,Default,,0,0,0,,Қандай жақсы дос.
Dialogue: 0,0:09:53.67,0:09:56.05,Default,,0,0,0,,Жер бетіндегі әйелдер әртүрлі.
Dialogue: 0,0:09:56.63,0:09:58.84,Default,,0,0,0,,Мен талай рет айттым, бірақ қашып кет.
Dialogue: 0,0:09:58.93,0:10:00.26,Default,,0,0,0,,Өлгің келе ме?
Dialogue: 0,0:10:00.34,0:10:01.39,Default,,0,0,0,,- Жақсы! - (Йоко) Иә?
Dialogue: 0,0:10:01.47,0:10:02.56,Default,,0,0,0,,- (Йоко) Ах! -Ух...
Dialogue: 0,0:10:05.64,0:10:07.73,Default,,0,0,0,,-(Йоко) Уф... -Аа...
Dialogue: 0,0:10:07.81,0:10:09.98,Default,,0,0,0,,Рахмет Саймон, сен маған көмектестің.
Dialogue: 0,0:10:10.06,0:10:11.27,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:10:11.36,0:10:13.36,Default,,0,0,0,,- (Йоко) Бұл қайда? -Бұл Джиха ауылы.
Dialogue: 0,0:10:13.44,0:10:15.94,Default,,0,0,0,,-(Йоко) Сосын көрші үй... -Көрші үй?
Dialogue: 0,0:10:16.03,0:10:18.49,Default,,0,0,0,,Мен көршілес Литтнер ауылынан келдім.
Dialogue: 0,0:10:18.57,0:10:19.53,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:19.61,0:10:22.28,Default,,0,0,0,,Жерден келдім дедің, бірақ қоймада өстің бе?
Dialogue: 0,0:10:22.37,0:10:25.62,Default,,0,0,0,,Мен жерге жаңа ғана келдім, бірақ мен Риттнерденмін.
Dialogue: 0,0:10:25.70,0:10:28.41,Default,,0,0,0,,Бұл анагура әйел. Кет жолдан, сен үлкен сиқыр!
Dialogue: 0,0:10:28.50,0:10:31.00,Default,,0,0,0,,Олардың көзқарастарында қандай айырмашылық бар?
Dialogue: 0,0:10:31.08,0:10:31.88,Default,,0,0,0,,Міне осылай
Dialogue: 0,0:10:31.96,0:10:34.34,Default,,0,0,0,,Сонымен не? Қайда бара жатырсың?
Dialogue: 0,0:10:34.42,0:10:35.38,Default,,0,0,0,,-Бет - (Йоко) Бет?
Dialogue: 0,0:10:35.46,0:10:36.80,Default,,0,0,0,,Үлкен бет!
Dialogue: 0,0:10:36.88,0:10:38.17,Default,,0,0,0,,Қарулы адамдар туралы не деуге болады?
Dialogue: 0,0:10:38.26,0:10:39.51,Default,,0,0,0,,Не? Gunmen дегеніміз не?
Dialogue: 0,0:10:39.59,0:10:40.68,Default,,0,0,0,,Сол жігіт
Dialogue: 0,0:10:40.76,0:10:43.22,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:10:43.30,0:10:46.81,Default,,0,0,0,,Сәл күте тұрыңыз, осы жерден электр құбырын көздеуге болады.
Dialogue: 0,0:10:46.89,0:10:48.93,Default,,0,0,0,,Осылай жасасаңыз, қозғалысты тоқтатуға болады.
Dialogue: 0,0:10:50.06,0:10:50.98,Default,,0,0,0,,Итадаки
Dialogue: 0,0:10:51.06,0:10:52.90,Default,,0,0,0,,Ей, анау анау үлкен жүзім бұтасы!
Dialogue: 0,0:10:52.98,0:10:55.61,Default,,0,0,0,,Мен саған бір оқ беремін, сондықтан дайын бол.
Dialogue: 0,0:10:55.69,0:10:56.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:56.73,0:10:57.32,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:57.94,0:10:58.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:58.65,0:11:00.11,Default,,0,0,0,,Хмф!
Dialogue: 0,0:11:01.03,0:11:02.62,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:11:02.70,0:11:05.62,Default,,0,0,0,,Басыңды ұрмайтын адам!
Dialogue: 0,0:11:06.20,0:11:07.83,Default,,0,0,0,,Мен әйелмін!
Dialogue: 0,0:11:07.91,0:11:10.96,Default,,0,0,0,,Әйелдер ерлердің шайқасына араласпауы керек!
Dialogue: 0,0:11:11.04,0:11:13.00,Default,,0,0,0,,Мен ұрысамын
Dialogue: 0,0:11:13.08,0:11:15.80,Default,,0,0,0,,Эй, маған ұнады, қыз.
Dialogue: 0,0:11:16.59,0:11:18.09,Default,,0,0,0,,- (Йоко) Иә? Ах! -иә?
Dialogue: 0,0:11:18.17,0:11:20.80,Default,,0,0,0,,Маған көрсеткіңіз келгені осы ма?
Dialogue: 0,0:11:20.88,0:11:21.38,Default,,0,0,0,,Иә
Dialogue: 0,0:11:21.47,0:11:23.93,Default,,0,0,0,,Сіз тағы бір керемет нәрсе таптыңыз.
Dialogue: 0,0:11:24.01,0:11:25.01,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:25.10,0:11:27.85,Default,,0,0,0,,Бұл да жоғарыдағы қаруластардың досы ма?
Dialogue: 0,0:11:27.93,0:11:31.19,Default,,0,0,0,,Бұл жоғарыдағыдан кішірек, бірақ әдемі көрінеді.
Dialogue: 0,0:11:31.27,0:11:32.52,Default,,0,0,0,,Бірақ қараңыз!
Dialogue: 0,0:11:32.60,0:11:34.94,Default,,0,0,0,,Адамдар мінеді ме? Бұл дұрыс емес...
Dialogue: 0,0:11:35.02,0:11:35.86,Default,,0,0,0,,Мінуге болмайды ма?
Dialogue: 0,0:11:38.11,0:11:40.03,Default,,0,0,0,,Аа, ол қозғалып бара жатқан сияқты.
Dialogue: 0,0:11:40.11,0:11:41.07,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:11:41.15,0:11:42.07,Default,,0,0,0,,Бауырым, мін
Dialogue: 0,0:11:43.95,0:11:45.53,Default,,0,0,0,,Сен істейсің, Саймон.
Dialogue: 0,0:11:45.62,0:11:46.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:46.62,0:11:49.95,Default,,0,0,0,,Сен оны қазып алдың. Ол сенікі.
Dialogue: 0,0:11:50.04,0:11:50.91,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:51.00,0:11:55.63,Default,,0,0,0,,Ағаның інісінің заттарын ұрлауы керек емес.
Dialogue: 0,0:11:55.71,0:11:57.46,Default,,0,0,0,,-Тыңдаңыздар! -(Бута) Бөксе
Dialogue: 0,0:11:58.84,0:12:00.72,Default,,0,0,0,,Жасай бер! сіз жасай аласыз
Dialogue: 0,0:12:00.80,0:12:02.80,Default,,0,0,0,,Иә? Бірақ... Бірақ...
Dialogue: 0,0:12:02.88,0:12:05.18,Default,,0,0,0,,Тыңда, Саймон, өзіңе сенбе.
Dialogue: 0,0:12:05.26,0:12:06.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:06.18,0:12:07.47,Default,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:12:07.56,0:12:09.56,Default,,0,0,0,,Маған сен, мен саған сенемін!
Dialogue: 0,0:12:09.64,0:12:10.18,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:12:13.14,0:12:14.10,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:12:25.61,0:12:26.45,Default,,0,0,0,,Бірақ
Dialogue: 0,0:12:28.62,0:12:29.49,Default,,0,0,0,,Бухи
Dialogue: 0,0:12:43.13,0:12:45.34,Default,,0,0,0,,(Инъекция дыбысы)
Dialogue: 0,0:12:49.85,0:12:51.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:51.60,0:12:53.43,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:12:54.85,0:12:55.35,Default,,0,0,0,,Бухи
Dialogue: 0,0:12:55.44,0:13:00.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:00.77,0:13:01.65,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:13:01.73,0:13:02.90,Default,,0,0,0,,Қый!
Dialogue: 0,0:13:03.69,0:13:04.82,Default,,0,0,0,,Жақсы, Саймон.
Dialogue: 0,0:13:04.90,0:13:05.95,Default,,0,0,0,,Гррр…
Dialogue: 0,0:13:06.03,0:13:07.36,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:13:07.45,0:13:09.74,Default,,0,0,0,,Таң қалдың ба, қарулы жігіт?
Dialogue: 0,0:13:09.83,0:13:14.54,Default,,0,0,0,,Аспан сенің озбырлығыңды кешірсе де, Лаған-сама кешірмейді.
Dialogue: 0,0:13:14.62,0:13:16.12,Default,,0,0,0,,Лаган дегеніміз не?
Dialogue: 0,0:13:16.21,0:13:18.75,Default,,0,0,0,,Бұл оның аты. Мен қазір шештім.
Dialogue: 0,0:13:18.83,0:13:19.75,Default,,0,0,0,,- Жақсы! -Жарайды...
Dialogue: 0,0:13:19.84,0:13:20.79,Default,,0,0,0,,Қый!
Dialogue: 0,0:13:21.50,0:13:23.67,Default,,0,0,0,,Ух... таа!
Dialogue: 0,0:13:23.76,0:13:24.80,Default,,0,0,0,,Бұл!
Dialogue: 0,0:13:26.80,0:13:27.97,Default,,0,0,0,,Хмф!
Dialogue: 0,0:13:28.47,0:13:29.68,Default,,0,0,0,,Хаха
Dialogue: 0,0:13:30.68,0:13:31.60,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:31.68,0:13:34.35,Default,,0,0,0,,Ах! О... сенің басың ба?
Dialogue: 0,0:13:34.85,0:13:35.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:35.77,0:13:36.39,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:37.35,0:13:38.69,Default,,0,0,0,,Кяа~!
Dialogue: 0,0:13:40.23,0:13:40.73,Default,,0,0,0,,Тұрақты түрде құрмет көрсет, Анджело.
Dialogue: 0,0:13:43.90,0:13:45.74,Default,,0,0,0,,Арх! Қарғыс атқыр...
Dialogue: 0,0:13:47.53,0:13:48.78,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:13:49.99,0:13:54.04,Default,,0,0,0,,Хмм... мүмкін емес, себепсіз арқылы.
Dialogue: 0,0:13:54.75,0:13:57.04,Default,,0,0,0,,Бұл біз, Гленн командасы!
Dialogue: 0,0:13:58.92,0:14:01.71,Default,,0,0,0,,Уау, аа, уау...
Dialogue: 0,0:14:01.79,0:14:04.96,Default,,0,0,0,,～
Dialogue: 0,0:14:05.84,0:14:06.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:07.97,0:14:09.84,Default,,0,0,0,,-Хаа ха... -Симон Сен істейсің.
Dialogue: 0,0:14:09.93,0:14:12.35,Default,,0,0,0,,Тез секір! секіру
Dialogue: 0,0:14:13.06,0:14:15.10,Default,,0,0,0,,Асығыңыз! Қараңдар, қараңдар!
Dialogue: 0,0:14:15.18,0:14:17.18,Default,,0,0,0,,- (Йоко) Ой... - Уф...
Dialogue: 0,0:14:17.27,0:14:18.39,Default,,0,0,0,,Хамф!
Dialogue: 0,0:14:19.85,0:14:22.36,Default,,0,0,0,,Уау! О... ой...
Dialogue: 0,0:14:24.15,0:14:24.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:25.73,0:14:28.61,Default,,0,0,0,,Гахаха хаха
Dialogue: 0,0:14:28.70,0:14:30.53,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:14:33.58,0:14:37.12,Default,,0,0,0,,Уф... Менің енді қолымнан келмейді, бұл өте қиын...
Dialogue: 0,0:14:37.20,0:14:39.62,Default,,0,0,0,,Ондай жерлерде оғаш дауыс шығармаңдар!
Dialogue: 0,0:14:39.71,0:14:42.75,Default,,0,0,0,,Боқ, тағы... көбірек қуат...
Dialogue: 0,0:14:43.63,0:14:44.50,Default,,0,0,0,,Бұл…
Dialogue: 0,0:14:51.14,0:14:52.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:54.72,0:14:56.35,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:14:56.93,0:14:57.89,Default,,0,0,0,,Бұрғылау!
Dialogue: 0,0:14:57.98,0:14:59.31,Default,,0,0,0,,Бірдеңе болды.
Dialogue: 0,0:14:59.39,0:15:01.90,Default,,0,0,0,,Бұл сізге жарасатын қару.
Dialogue: 0,0:15:03.94,0:15:06.40,Default,,0,0,0,,Бауырым, мен мұны істей аламын деп ойлаймын.
Dialogue: 0,0:15:06.48,0:15:10.24,Default,,0,0,0,,Жарайды, оны анау үлкен сиқырға салайық.
Dialogue: 0,0:15:10.32,0:15:12.87,Default,,0,0,0,,Біздің Гленн командасының жаттығуларының күші!
Dialogue: 0,0:15:12.95,0:15:13.78,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:15.58,0:15:18.95,Default,,0,0,0,,Уууу!
Dialogue: 0,0:15:19.04,0:15:20.41,Default,,0,0,0,,Саймонға барыңыз
Dialogue: 0,0:15:20.50,0:15:23.75,Default,,0,0,0,,Сенің бұрғың аспанды тесіп өтетін бұрғы!
Dialogue: 0,0:15:24.50,0:15:26.42,Default,,0,0,0,,Арқаңа көтер мені
Dialogue: 0,0:15:29.38,0:15:31.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:31.13,0:15:35.01,Default,,0,0,0,,Уау! Агага...
Dialogue: 0,0:15:35.60,0:15:38.93,Default,,0,0,0,,Уууу!
Dialogue: 0,0:15:39.02,0:15:41.19,Default,,0,0,0,,Уф! Гах...
Dialogue: 0,0:15:41.27,0:15:45.11,Default,,0,0,0,,Агага... уф...
Dialogue: 0,0:15:46.40,0:15:48.40,Default,,0,0,0,,Ах, а... арх
Dialogue: 0,0:15:48.48,0:15:50.95,Default,,0,0,0,,Гугагага…
Dialogue: 0,0:15:51.03,0:15:54.87,Default,,0,0,0,,Қош бол, Джиха ауылы, біз жер бетіне шығамыз.
Dialogue: 0,0:15:54.95,0:15:56.83,Default,,0,0,0,,Бала кезімде көрген жерге оралу!
Dialogue: 0,0:15:56.91,0:15:58.79,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:01.21,0:16:02.33,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:02.41,0:16:03.79,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:16:05.96,0:16:09.17,Default,,0,0,0,,Уау! Гагага...
Dialogue: 0,0:16:09.25,0:16:11.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:14.55,0:16:15.55,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:16:20.02,0:16:23.06,Default,,0,0,0,,Бұл... негіз осы ма?
Dialogue: 0,0:16:23.14,0:16:24.35,Default,,0,0,0,,Уау...
Dialogue: 0,0:16:34.78,0:16:36.66,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:16:36.74,0:16:38.16,Default,,0,0,0,,- (Йоко) Йоко - Иә?
Dialogue: 0,0:16:39.03,0:16:42.12,Default,,0,0,0,,Сіз менің атымды әлі айтқан жоқсыз.
Dialogue: 0,0:16:42.71,0:16:43.71,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,0:16:44.21,0:16:46.63,Default,,0,0,0,,Камина мен Саймон.
Dialogue: 0,0:16:47.21,0:16:48.42,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:16:48.50,0:16:49.38,Default,,0,0,0,,Бухи
Dialogue: 0,0:16:49.46,0:16:53.30,Default,,0,0,0,,Сонда... мына түкті нәрсе кеудеме жорғалап жатқан не?
Dialogue: 0,0:16:53.38,0:16:55.18,Default,,0,0,0,,Сәлем, Боота!
Dialogue: 0,0:16:55.26,0:16:58.01,Default,,0,0,0,,Тауға да, аңғарға да көзің жетпейді.
Dialogue: 0,0:16:58.10,0:17:00.47,Default,,0,0,0,,Сонымен... Ей, құлап жатқан жоқпыз ба?
Dialogue: 0,0:17:00.56,0:17:02.64,Default,,0,0,0,,Инъекция тоқтатылды. Бірдеңе істе, Саймон!
Dialogue: 0,0:17:02.73,0:17:04.52,Default,,0,0,0,,Иә? Қазір ғана қозғалды
Dialogue: 0,0:17:04.60,0:17:06.73,Default,,0,0,0,,-Уф... Амал жоқ - (Йоко) Бас тартыңыз Тезірек!
Dialogue: 0,0:17:06.81,0:17:09.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:09.11,0:17:11.73,Default,,0,0,0,,Сіз құлап жатырсыз! Қатты ұстаңыз!
Dialogue: 0,0:17:12.32,0:17:13.49,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:14.78,0:17:16.16,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:17:26.87,0:17:29.63,Default,,0,0,0,,Ха! Кешіріңіз... кешіріңіз
Dialogue: 0,0:17:31.92,0:17:32.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:32.50,0:17:33.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:35.22,0:17:37.68,Default,,0,0,0,,Абайлаңыз, ол әлі де бар сияқты.
Dialogue: 0,0:17:37.76,0:17:42.60,Default,,0,0,0,,(Қарушылардың дауысы)
Dialogue: 0,0:17:42.68,0:17:43.77,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:17:43.85,0:17:46.89,Default,,0,0,0,,(Қарушылардың ыңылауы)
Dialogue: 0,0:17:49.19,0:17:51.11,Default,,0,0,0,,-Не? -Сәлем!
Dialogue: 0,0:17:53.86,0:17:55.57,Default,,0,0,0,,О, Йоко!
Dialogue: 0,0:17:55.65,0:17:56.82,Default,,0,0,0,,Даякка!
Dialogue: 0,0:17:56.90,0:17:58.03,Default,,0,0,0,,Сіз доссыз ба?
Dialogue: 0,0:17:58.82,0:18:02.41,Default,,0,0,0,,Дұрыс, менің Риттнер ауылындағы достарым жерде соғысып жатыр.
Dialogue: 0,0:18:06.75,0:18:08.62,Default,,0,0,0,,Бухи
Dialogue: 0,0:18:08.71,0:18:10.38,Default,,0,0,0,,Жақсы жұмыс Саймон
Dialogue: 0,0:18:11.25,0:18:13.38,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:18:13.46,0:18:16.34,Default,,0,0,0,,Қиын кезде маған көмектесетін сенсің.
Dialogue: 0,0:18:17.47,0:18:18.05,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:26.10,0:18:28.27,Default,,0,0,0,,Қандай керемет көрініс
Dialogue: 0,0:18:28.35,0:18:29.19,Default,,0,0,0,,Иә
Dialogue: 0,0:18:30.02,0:18:31.94,Default,,0,0,0,,Өйткені, бұл жерде басқаша.
Dialogue: 0,0:18:32.44,0:18:33.27,Default,,0,0,0,,Иә
Dialogue: 0,0:18:34.40,0:18:38.53,Default,,0,0,0,,Сол үлкен дөңгелек жарық және сансыз кішкентай шамдар
Dialogue: 0,0:18:38.61,0:18:41.16,Default,,0,0,0,,Түнде де нұрға толы емес пе?
Dialogue: 0,0:18:41.24,0:18:43.83,Default,,0,0,0,,Аназоның қараңғылығынан өзгеше.
Dialogue: 0,0:18:44.37,0:18:45.24,Default,,0,0,0,,Иә
Dialogue: 0,0:18:45.33,0:18:49.08,Default,,0,0,0,,Жоғарыдан шығу дұрыс жауап болды.
Dialogue: 0,0:18:52.08,0:18:55.34,Default,,0,0,0,,Үлкен нәрсе – «ай» Сансыз нәрсе – «жұлдыздар»
Dialogue: 0,0:18:55.84,0:18:58.30,Default,,0,0,0,,Бұрынғы адамдар осылай атаса керек.
Dialogue: 0,0:18:58.38,0:19:01.80,Default,,0,0,0,,«Ай» және «жұлдыздар»? Бұл өте қарапайым.
Dialogue: 0,0:19:02.30,0:19:04.30,Default,,0,0,0,,Неліктен оның аты бар?
Dialogue: 0,0:19:04.39,0:19:04.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:05.60,0:19:07.60,Default,,0,0,0,,Атаудың болуы деген мағынаны білдіреді
Dialogue: 0,0:19:07.68,0:19:12.19,Default,,0,0,0,,Бұрынғы адамдар сол жарықты аспаннан үнемі көретін бе деп ойлаймын.
Dialogue: 0,0:19:12.27,0:19:15.98,Default,,0,0,0,,Ой, сен мүлде ақымақ емессің, балам.
Dialogue: 0,0:19:16.07,0:19:17.23,Default,,0,0,0,,-Уау! -(Боота) Буу!
Dialogue: 0,0:19:17.73,0:19:20.86,Default,,0,0,0,,Мүмкін, бұрын адамдар
Dialogue: 0,0:19:20.95,0:19:23.12,Default,,0,0,0,,Мүмкін ол жерде өмір сүрген шығар.
Dialogue: 0,0:19:23.20,0:19:24.70,Default,,0,0,0,,- Иә? -Бұл рас па?
Dialogue: 0,0:19:24.78,0:19:27.41,Default,,0,0,0,,Ондай жазбалар жоқ деп ойлаймын...
Dialogue: 0,0:19:27.49,0:19:28.70,Default,,0,0,0,,​​Қайсысы?
Dialogue: 0,0:19:28.79,0:19:31.25,Default,,0,0,0,,Мен еркек сияқтымын, әйел сияқтымын...
Dialogue: 0,0:19:31.33,0:19:33.17,Default,,0,0,0,,Екеуі де жақсы! Сен ше?
Dialogue: 0,0:19:33.25,0:19:36.25,Default,,0,0,0,,Лейрон, мені Рон деп атаңыз.
Dialogue: 0,0:19:36.34,0:19:38.01,Default,,0,0,0,,Әдемі ханшайым да жақсы
Dialogue: 0,0:19:38.09,0:19:39.30,Default,,0,0,0,,Мен өлсем де хабарласасың ба?
Dialogue: 0,0:19:39.38,0:19:42.13,Default,,0,0,0,,Мен сенен бір нәрсе сұрайын деп едім.
Dialogue: 0,0:19:42.22,0:19:42.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:42.80,0:19:45.18,Default,,0,0,0,,Оны мен үшін алып кете аласыз ба?
Dialogue: 0,0:19:45.76,0:19:46.26,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:46.35,0:19:49.10,Default,,0,0,0,,- (Лирон) Маған қоңырау шалып көріңіз - мен сізге қоңырау шалмаймын ...
Dialogue: 0,0:19:49.18,0:19:50.77,Default,,0,0,0,,Не?ол
Dialogue: 0,0:19:51.27,0:19:54.35,Default,,0,0,0,,Аа... қандай әдемі.
Dialogue: 0,0:19:57.32,0:19:58.28,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:59.82,0:20:00.69,Default,,0,0,0,,- (Боота) Буу? -(Йоко) Ах...
Dialogue: 0,0:20:00.78,0:20:01.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:11.62,0:20:13.62,Default,,0,0,0,,Не, ол қозғалмайды?
Dialogue: 0,0:20:14.12,0:20:15.54,Default,,0,0,0,,Олай болса, мұнда, осында
Dialogue: 0,0:20:19.30,0:20:21.30,Default,,0,0,0,,Ер адамдар құмар ма?
Dialogue: 0,0:20:21.38,0:20:23.34,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:20:24.13,0:20:27.80,Default,,0,0,0,,Бұл да сіз ойлағандай жақсы жер емес.
Dialogue: 0,0:20:28.72,0:20:31.23,Default,,0,0,0,,Тіпті біз мұнда өмір сүрмейміз, өйткені ол бізге ұнайды.
Dialogue: 0,0:20:31.31,0:20:32.77,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:20:32.85,0:20:34.48,Default,,0,0,0,,-Аа... -Хмм?
Dialogue: 0,0:20:35.48,0:20:38.23,Default,,0,0,0,,Біздің Литтнер де жерасты ауылы болды.
Dialogue: 0,0:20:38.73,0:20:41.74,Default,,0,0,0,,Бірақ жазатайым оқиға болды, мен бұдан былай ол жерде тұра алмадым.
Dialogue: 0,0:20:42.24,0:20:44.40,Default,,0,0,0,,Менің шыңға шығудан басқа амалым қалмады.
Dialogue: 0,0:20:44.49,0:20:47.66,Default,,0,0,0,,Міне, сол қарулы адамдар мені күтіп тұрды.
Dialogue: 0,0:20:48.16,0:20:51.04,Default,,0,0,0,,Жер бетіндегі барлық адамдарды жою.
Dialogue: 0,0:20:51.12,0:20:55.46,Default,,0,0,0,,Жақсы, мен іздеген дүние сол еді.
Dialogue: 0,0:20:55.54,0:20:57.46,Default,,0,0,0,,Жауап бермейтін адам.
Dialogue: 0,0:21:01.67,0:21:03.72,Default,,0,0,0,,(Камина мен Саймонның ұйқысы)
Dialogue: 0,0:21:03.80,0:21:04.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:04.63,0:21:06.51,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:21:10.06,0:21:11.89,Default,,0,0,0,,Шаршадыңыз ба?
Dialogue: 0,0:21:12.39,0:21:14.89,Default,,0,0,0,,Мұның бәрі бірінші рет болды.
Dialogue: 0,0:21:22.48,0:21:24.90,Default,,0,0,0,,Келіңдер, арсыз адамдар...
Dialogue: 0,0:21:24.99,0:21:27.86,Default,,0,0,0,,Мен де бүгін тазалаймын.
Dialogue: 0,0:21:27.95,0:21:29.83,Default,,0,0,0,,Екі күн қатарынан қиын.
Dialogue: 0,0:21:29.91,0:21:31.54,Default,,0,0,0,,Бұл кешегі күн үшін кек пе?
Dialogue: 0,0:21:31.62,0:21:33.37,Default,,0,0,0,,Жауынгерлік орналастыру Сіз дайынсыз ба?
Dialogue: 0,0:21:37.08,0:21:39.25,Default,,0,0,0,,Иә? иә? иә?
Dialogue: 0,0:21:39.33,0:21:40.46,Default,,0,0,0,,Тағы емес пе?
Dialogue: 0,0:21:40.54,0:21:42.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:43.55,0:21:45.22,Default,,0,0,0,,Цк... міне, тағы да келдік
Dialogue: 0,0:21:45.30,0:21:46.01,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,0:21:46.09,0:21:48.47,Default,,0,0,0,,Құлағыңызды жабу керек.
Dialogue: 0,0:21:49.14,0:21:49.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:50.43,0:21:50.93,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:21:51.51,0:21:53.02,Default,,0,0,0,,Сенің айтқаныңдай болмайды
Dialogue: 0,0:21:53.10,0:21:54.81,Default,,0,0,0,,- (Ли Рон) Ах... - Уау!
Dialogue: 0,0:21:56.94,0:21:57.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:58.60,0:22:00.23,Default,,0,0,0,,Бұл діріл...
Dialogue: 0,0:22:02.19,0:22:03.11,Default,,0,0,0,,Сол жігіттер.
Dialogue: 0,0:22:04.44,0:22:06.36,Default,,0,0,0,,Олар себепші.
Dialogue: 0,0:22:07.65,0:22:10.53,Default,,0,0,0,,Жер сілкінісі олардың кінәсі болды.
Dialogue: 0,0:22:11.53,0:22:13.49,Default,,0,0,0,,Сен менің курткамды ұшырып, мені де ұшырып жібердің ғой!
Dialogue: 0,0:22:13.58,0:22:17.33,Default,,0,0,0,,Олар менің әкем мен анамды өлтірді...
Dialogue: 0,0:22:20.71,0:22:21.63,Default,,0,0,0,,Бұл өте үлкен.
Dialogue: 0,0:22:21.71,0:22:23.05,Default,,0,0,0,,Мен оны бірінші рет көріп тұрмын.
Dialogue: 0,0:22:23.13,0:22:24.92,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:25.01,0:22:26.80,Default,,0,0,0,,Мен сізге қиын уақыт салып жатырмын.
Dialogue: 0,0:22:27.72,0:22:30.72,Default,,0,0,0,,Шешім қабылданды! Мен сол қарулы адамды аламын
Dialogue: 0,0:22:31.26,0:22:32.14,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:22:32.22,0:22:34.64,Default,,0,0,0,,Мен оған мінемін деді.
Dialogue: 0,0:22:36.60,0:22:37.10,Default,,0,0,0,,Тұрақты түрде құрмет көрсет, Анджело.
Dialogue: 0,0:22:37.18,0:22:40.56,Default,,0,0,0,,Жақсы жерге келдің, ағайын!
Dialogue: 0,0:22:41.40,0:22:43.65,Default,,0,0,0,,Бұл жігіт не ойлады?
Dialogue: 0,0:22:46.61,0:22:47.44,Default,,0,0,0,,(Мысықтың ырылы)
Dialogue: 0,0:22:48.53,0:22:49.53,Default,,0,0,0,,Риппель Овердрайв Брэфордтың маңдайына жай ғана тиіп өтті ме?
Dialogue: 0,0:22:51.74,0:22:53.33,Default,,0,0,0,,Гррр…
Dialogue: 0,0:22:53.41,0:22:54.74,Default,,0,0,0,,Риппель Овердрайв Брэфордтың маңдайына жай ғана тиіп өтті ме?
Dialogue: 0,0:22:55.54,0:22:57.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:57.20,0:22:59.46,Default,,0,0,0,,- (Қарушылар C) Гуах! - (Мылтық Б) Ой, кешіріңіз!
Dialogue: 0,0:23:02.04,0:23:03.59,Default,,0,0,0,,Сәлем! Йотто
Dialogue: 0,0:23:04.59,0:23:07.30,Default,,0,0,0,,Оның денесіне қараған сайын, жансызданады.
Dialogue: 0,0:23:07.92,0:23:08.72,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:23:09.55,0:23:11.43,Default,,0,0,0,,Адамдарға алданып қалмаңыз
Dialogue: 0,0:23:12.68,0:23:14.05,Default,,0,0,0,,Саймон!
Dialogue: 0,0:23:14.14,0:23:16.77,Default,,0,0,0,,Ағаң саған тиіспесін
Dialogue: 0,0:23:16.85,0:23:18.98,Default,,0,0,0,,Тұрғындар балық аулау мен егіншілікпен күнкөреді—
Dialogue: 0,0:23:20.94,0:23:22.44,Default,,0,0,0,,Күте тұрыңыз, ағайын.
Dialogue: 0,0:23:22.52,0:23:24.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:24.98,0:23:26.86,Default,,0,0,0,,Қандай өзгеріс!
Dialogue: 0,0:23:26.94,0:23:29.32,Default,,0,0,0,,Уф, уау...
Dialogue: 0,0:23:29.90,0:23:31.57,Default,,0,0,0,,Енді, адам жанып кетті!
Dialogue: 0,0:23:31.66,0:23:33.28,Default,,0,0,0,,Біраз ашық емес пе?
Dialogue: 0,0:23:33.37,0:23:33.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:34.03,0:23:36.87,Default,,0,0,0,,Біраз ашық емес пе?
Dialogue: 0,0:23:39.41,0:23:40.46,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:23:40.54,0:23:43.25,Default,,0,0,0,,Взвод командирі Гузак өлтірілді.
Dialogue: 0,0:23:43.33,0:23:46.04,Default,,0,0,0,,Кешір мені, адам.
Dialogue: 0,0:23:46.13,0:23:49.01,Default,,0,0,0,,Қарғыс атсын! Мен әлі ұрған жоқпын...
Dialogue: 0,0:23:49.09,0:23:50.01,Default,,0,0,0,,О!
Dialogue: 0,0:23:50.09,0:23:52.26,Default,,0,0,0,,Жарайсың, взвод командирі Гузак!
Dialogue: 0,0:23:52.34,0:23:53.47,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:23:53.55,0:23:55.55,Default,,0,0,0,,Взвод командирінің жауы!
Dialogue: 0,0:23:55.64,0:23:56.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:56.51,0:23:58.97,Default,,0,0,0,,Гррр… Уау!
Dialogue: 0,0:24:00.93,0:24:02.89,Default,,0,0,0,,Үлкен аға! Уф...
Dialogue: 0,0:24:02.98,0:24:07.27,Default,,0,0,0,,Кішкентай, мен сені де о дүниеге аттандырамын!
Dialogue: 0,0:24:07.36,0:24:09.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:14.41,0:24:18.29,Default,,0,0,0,,Шүкір... не деген, Камина.
Dialogue: 0,0:24:18.87,0:24:20.75,Default,,0,0,0,,Сенде рух жетпейді!
Dialogue: 0,0:24:21.79,0:24:22.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:25.17,0:24:27.54,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:24:27.63,0:24:31.92,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:24:32.01,0:24:36.30,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:24:42.89,0:24:46.69,Default,,0,0,0,,А... Айып етпеңіздер, қарулылар.
Dialogue: 0,0:24:49.77,0:24:51.53,Default,,0,0,0,,Бітті, кішкентайым.
Dialogue: 0,0:24:51.61,0:24:53.99,Default,,0,0,0,,Сіз мені кім деп ойлайсыз?
Dialogue: 0,0:24:54.07,0:24:55.28,Default,,0,0,0,,Аһ!
Dialogue: 0,0:24:55.36,0:24:58.78,Default,,0,0,0,,Сүйкімді ініңізді жұдырықпен ұрыңыз!
Dialogue: 0,0:24:58.87,0:25:01.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:02.16,0:25:04.04,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:25:04.12,0:25:06.04,Default,,0,0,0,,- Саймон! -Аа...
Dialogue: 0,0:25:06.12,0:25:08.04,Default,,0,0,0,,А... ағайын?
Dialogue: 0,0:25:08.13,0:25:10.00,Default,,0,0,0,,-Бірден шешемін -А?
Dialogue: 0,0:25:10.09,0:25:14.84,Default,,0,0,0,,Арнайы зеңбірек оғымен шабуыл жасаңыз!
Dialogue: 0,0:25:14.93,0:25:16.97,Default,,0,0,0,,Бұл тәртіпсіздік!
Dialogue: 0,0:25:21.18,0:25:21.77,Default,,0,0,0,,Уау
Dialogue: 0,0:25:22.89,0:25:24.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:24.73,0:25:26.77,Default,,0,0,0,,Иә! Жоғалған~
Dialogue: 0,0:25:28.81,0:25:30.40,Default,,0,0,0,,Иә...
Dialogue: 0,0:25:36.20,0:25:37.41,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:25:37.49,0:25:39.32,Default,,0,0,0,,Қарулы адамдар басып алу туралы не деуге болады?
Dialogue: 0,0:25:39.41,0:25:41.53,Default,,0,0,0,,Бұл менің ойыма келетін нәрсе емес.
Dialogue: 0,0:25:41.62,0:25:45.21,Default,,0,0,0,,Бұл екеуі өте қызықты.
Dialogue: 0,0:25:52.38,0:25:53.96,Default,,0,0,0,,Сіз керемет болдыңыз.
Dialogue: 0,0:25:54.05,0:25:56.42,Default,,0,0,0,,Бұл үш нәрсенің қосындысы.
Dialogue: 0,0:25:56.51,0:25:58.51,Default,,0,0,0,,- (Йоко) Не? Артқы жағында - (2 адам) Иә?
Dialogue: 0,0:25:59.76,0:26:00.97,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:26:01.05,0:26:02.97,Default,,0,0,0,,Бұл біздің Гленн командасының белгісі.
Dialogue: 0,0:26:03.06,0:26:04.10,Default,,0,0,0,,Хмм.
Dialogue: 0,0:26:04.18,0:26:06.69,Default,,0,0,0,,Айтпақшы, мен қазір аңға шығамын.
Dialogue: 0,0:26:06.77,0:26:08.06,Default,,0,0,0,,Сіз араласқыңыз келе ме?
Dialogue: 0,0:26:08.14,0:26:10.48,Default,,0,0,0,,Мен аздап жаяу барамын, сондықтан маған мінгізіңіз.
Dialogue: 0,0:26:10.56,0:26:14.07,Default,,0,0,0,,О, тамақ! Жақсы, түсінемін.
Dialogue: 0,0:26:14.57,0:26:15.78,Default,,0,0,0,,-Симон кеттік -(Йоко) Иә?
Dialogue: 0,0:26:15.86,0:26:17.24,Default,,0,0,0,,Иә, мен де?
Dialogue: 0,0:26:17.99,0:26:20.87,Default,,0,0,0,,Жақсы ма? Мен де сенімен бірге келемін.
Dialogue: 0,0:26:20.95,0:26:21.95,Default,,0,0,0,,Ал...
Dialogue: 0,0:26:28.08,0:26:29.08,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:26:31.04,0:26:32.17,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:26:36.17,0:26:40.68,Default,,0,0,0,,Менің ату дағдыларым ауылдағы ең жақсы, сондықтан мен оларды пайдалануға рұқсат етемін.
Dialogue: 0,0:26:41.18,0:26:42.97,Default,,0,0,0,,Сіз қалай ойлайсыз? Оны түсіріп көргіңіз келе ме?
Dialogue: 0,0:26:43.05,0:26:43.72,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:26:51.06,0:26:51.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:53.61,0:26:54.69,Default,,0,0,0,,Иә!
Dialogue: 0,0:26:54.77,0:26:55.48,Default,,0,0,0,,Арама
Dialogue: 0,0:27:00.03,0:27:02.41,Default,,0,0,0,,О, ана жерде.
Dialogue: 0,0:27:03.83,0:27:04.66,Default,,0,0,0,,Хехе
Dialogue: 0,0:27:05.16,0:27:07.58,Default,,0,0,0,,Иә? екі көрсеткі
Dialogue: 0,0:27:08.16,0:27:09.75,Default,,0,0,0,,Иә? Уф...
Dialogue: 0,0:27:16.30,0:27:17.30,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:27:21.76,0:27:23.97,Default,,0,0,0,,Иә! Хаа!
Dialogue: 0,0:27:24.05,0:27:24.60,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:27:26.93,0:27:30.27,Default,,0,0,0,,Хехехе... Бұлай етпе, адам.
Dialogue: 0,0:27:30.35,0:27:31.85,Default,,0,0,0,,Шоичи-куннан күткендей, сен өте сенімдісің!
Dialogue: 0,0:27:33.10,0:27:36.52,Default,,0,0,0,,Қиыр Шығыстағы адам сыпырушы күштер дивизиясының командирі
Dialogue: 0,0:27:37.23,0:27:37.73,Default,,0,0,0,,Виллар
Dialogue: 0,0:27:37.82,0:27:38.78,Default,,0,0,0,,Ағам саған айтпады ма?
Dialogue: 0,0:27:39.40,0:27:42.82,Default,,0,0,0,,Бұл аулау менің кешкі асым, мен оны саған қайтарамын.
Dialogue: 0,0:27:42.91,0:27:44.70,Default,,0,0,0,,Иә, бұл жаман болды.
Dialogue: 0,0:27:45.28,0:27:47.04,Default,,0,0,0,,Мен оны қазір сізге қайтарамын!
Dialogue: 0,0:27:47.12,0:27:47.95,Default,,0,0,0,,(Тобитанукидің айқайы)
Dialogue: 0,0:27:48.04,0:27:49.91,Default,,0,0,0,,Қарғыс атсын! Ол әлі тірі ме еді?
Dialogue: 0,0:27:50.00,0:27:51.75,Default,,0,0,0,,(ауада атыс дыбысы)
Dialogue: 0,0:27:52.25,0:27:52.75,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:27:53.79,0:27:54.58,Default,,0,0,0,,Қашпа!
Dialogue: 0,0:27:55.09,0:27:56.92,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:27:57.00,0:28:00.30,Default,,0,0,0,,Мені кінәлама, мені кім деп ойлайсың?
Dialogue: 0,0:28:00.38,0:28:02.47,Default,,0,0,0,,Тіпті жылап жатқан баланы, Гленн командасынан Камина-саманы да өшіріңіз.
Dialogue: 0,0:28:03.89,0:28:05.43,Default,,0,0,0,,Жауға арқаңды көрсетпе!
Dialogue: 0,0:28:06.05,0:28:08.39,Default,,0,0,0,,Сол тәкаппарлық өлімге әкеледі.
Dialogue: 0,0:28:14.90,0:28:18.11,Default,,0,0,0,,Біз жер бетіне шыққан барлық адамдарды құртамыз.
Dialogue: 0,0:28:18.19,0:28:19.15,Default,,0,0,0,,Сізге де солай!
Dialogue: 0,0:28:20.36,0:28:21.49,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:28:21.57,0:28:25.28,Default,,0,0,0,,Қалағаныңды істейін, шыдай алмаймын!
Dialogue: 0,0:28:27.03,0:28:27.99,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:28:29.33,0:28:29.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:30.58,0:28:33.25,Default,,0,0,0,,А, сен одан жалтардың ба?
Dialogue: 0,0:28:33.33,0:28:36.38,Default,,0,0,0,,Мені ренжітемін деп ойлама
Dialogue: 0,0:28:36.46,0:28:39.46,Default,,0,0,0,,Бірақ күтпеген шабуыл - бұл жай ғана тосын шабуыл, ешқашан екінші рет болмайды.
Dialogue: 0,0:28:40.92,0:28:41.67,Default,,0,0,0,,Фу…
Dialogue: 0,0:28:41.76,0:28:43.63,Default,,0,0,0,,Бітті!
Dialogue: 0,0:28:45.51,0:28:47.18,Default,,0,0,0,,А... аға!
Dialogue: 0,0:28:48.30,0:28:49.97,Default,,0,0,0,,Саймон! Мен құтқарылдым
Dialogue: 0,0:28:50.06,0:28:51.31,Default,,0,0,0,,Өйткені мен атысты естідім...
Dialogue: 0,0:28:52.27,0:28:53.69,Default,,0,0,0,,Кіші қарулы адамдар?
Dialogue: 0,0:28:54.64,0:28:55.44,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:28:55.52,0:28:56.90,Default,,0,0,0,,Мен мұны байқадым!
Dialogue: 0,0:28:56.98,0:28:59.86,Default,,0,0,0,,Ғұндар, көтерілісшілер? Дұрыс.
Dialogue: 0,0:28:59.94,0:29:02.57,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:29:08.37,0:29:09.95,Default,,0,0,0,,Бұл жара жақсы ма?
Dialogue: 0,0:29:10.03,0:29:10.79,Default,,0,0,0,,О
Dialogue: 0,0:29:10.87,0:29:13.12,Default,,0,0,0,,Оның орнына, бұл Гленнде де пайда болады.
Dialogue: 0,0:29:17.75,0:29:20.00,Default,,0,0,0,,Мен қарулы адамдарды ұрлаған біреу бар деп естідім.
Dialogue: 0,0:29:20.09,0:29:21.92,Default,,0,0,0,,Мені осы уақытқа дейін қайта шақырды, бірақ
Dialogue: 0,0:29:22.01,0:29:24.09,Default,,0,0,0,,Кешкі асқа дейін іс бітетін сияқты.
Dialogue: 0,0:29:24.17,0:29:25.09,Default,,0,0,0,,Уф!
Dialogue: 0,0:29:25.72,0:29:29.01,Default,,0,0,0,,Қарулы адамдар? Бұл соншалықты ақымақ атау емес.
Dialogue: 0,0:29:29.10,0:29:30.43,Default,,0,0,0,,Бұл Гленн.
Dialogue: 0,0:29:30.51,0:29:34.60,Default,,0,0,0,,Өзі хайуан болса да, екі жүзді мұқалмас бейбақ!
Dialogue: 0,0:29:36.39,0:29:39.15,Default,,0,0,0,,Мен… мен істедім! Мен жылдамырақпын! ➡
Dialogue: 0,0:29:39.23,0:29:43.57,Default,,0,0,0,,Ет пен қанға қарамастан, қарулы адамдарды емдеуге әлі көп жол бар!
Dialogue: 0,0:29:45.28,0:29:46.20,Default,,0,0,0,,Аһ!
Dialogue: 0,0:29:47.20,0:29:48.99,Default,,0,0,0,,Ах... Саймон!
Dialogue: 0,0:29:49.07,0:29:49.82,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:29:50.49,0:29:54.04,Default,,0,0,0,,Тааааааааа!
Dialogue: 0,0:29:55.33,0:29:56.71,Default,,0,0,0,,Аһ!
Dialogue: 0,0:29:57.29,0:29:57.79,Default,,0,0,0,,Қый!
Dialogue: 0,0:29:57.87,0:30:00.00,Default,,0,0,0,,Артында бол, Йоко.
Dialogue: 0,0:30:01.13,0:30:05.67,Default,,0,0,0,,Арнайы зеңбірек оғымен шабуыл жасаңыз!
Dialogue: 0,0:30:05.76,0:30:07.38,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:30:07.47,0:30:08.68,Default,,0,0,0,,Хе... Хе!
Dialogue: 0,0:30:08.76,0:30:11.22,Default,,0,0,0,,Иә!
Dialogue: 0,0:30:11.30,0:30:12.31,Default,,0,0,0,,- (Вирусты) Иә! -Уф...
Dialogue: 0,0:30:13.35,0:30:14.81,Default,,0,0,0,,Няру!
Dialogue: 0,0:30:14.89,0:30:16.18,Default,,0,0,0,,- (вирустық) Иә! -Уау...
Dialogue: 0,0:30:19.15,0:30:20.06,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:30:22.27,0:30:23.61,Default,,0,0,0,,- (Вирусты) Сәлем! -Апыр-ай!
Dialogue: 0,0:30:27.40,0:30:28.95,Default,,0,0,0,,Саймон! Камина!
Dialogue: 0,0:30:29.03,0:30:30.03,Default,,0,0,0,,Бұл біржақты емес...
Dialogue: 0,0:30:30.11,0:30:32.33,Default,,0,0,0,,Бітті, өл!
Dialogue: 0,0:30:33.03,0:30:34.49,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:30:35.95,0:30:37.00,Default,,0,0,0,,Ха!
Dialogue: 0,0:30:41.42,0:30:42.38,Default,,0,0,0,,Онда жоқ!
Dialogue: 0,0:30:42.88,0:30:46.71,Default,,0,0,0,,Цк... Қашуға шебер сияқтысың.
Dialogue: 0,0:30:46.80,0:30:47.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:49.34,0:30:52.05,Default,,0,0,0,,Жарайды, ертең бітіремін.
Dialogue: 0,0:30:55.77,0:30:56.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:01.81,0:31:02.73,Default,,0,0,0,,Хаа…
Dialogue: 0,0:31:08.86,0:31:09.74,Default,,0,0,0,,Саймон
Dialogue: 0,0:31:10.24,0:31:12.82,Default,,0,0,0,,Неге ор қазып, жасырдың?
Dialogue: 0,0:31:14.24,0:31:18.00,Default,,0,0,0,,Мен... Мен қорқып кеттім. Мен қашып кеткім келді.
Dialogue: 0,0:31:18.75,0:31:21.62,Default,,0,0,0,,Мен онымен біттім. Ауылға қайтайық.
Dialogue: 0,0:31:22.33,0:31:24.21,Default,,0,0,0,,Сондай күшті адамдар бар.
Dialogue: 0,0:31:24.71,0:31:27.55,Default,,0,0,0,,Өйткені, біз мұны істей алмаймыз.
Dialogue: 0,0:31:28.55,0:31:32.55,Default,,0,0,0,,Өлгім келмейді, ағамның да өлгенін көргім келмейді.
Dialogue: 0,0:31:33.05,0:31:36.31,Default,,0,0,0,,Өйткені, бұл біз тұратын жер емес.
Dialogue: 0,0:31:36.39,0:31:36.89,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:31:37.68,0:31:38.85,Default,,0,0,0,,Саймон!
Dialogue: 0,0:31:39.35,0:31:42.35,Default,,0,0,0,,Сіздің бұрғыңыз аспанға қарай қазатын бұрғы.
Dialogue: 0,0:31:42.44,0:31:43.48,Default,,0,0,0,,Қашып кетпеу
Dialogue: 0,0:31:43.56,0:31:44.06,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:31:44.65,0:31:46.77,Default,,0,0,0,,Ертең шешуші шайқас. Мен ұйықтауға барамын.
Dialogue: 0,0:31:47.36,0:31:48.65,Default,,0,0,0,,Сіз де ұйықтауыңыз керек.
Dialogue: 0,0:31:54.82,0:31:56.20,Default,,0,0,0,,Оны Лаганнға қойыңыз
Dialogue: 0,0:31:59.25,0:32:02.50,Default,,0,0,0,,Ертең мен Саймонның орнына мінемін.
Dialogue: 0,0:32:02.58,0:32:04.63,Default,,0,0,0,,Олай етпесем, осы жолы істеймін.
Dialogue: 0,0:32:04.71,0:32:07.34,Default,,0,0,0,,Мен оны жұмысқа алу үшін Ронға реттеуді сұраймын.
Dialogue: 0,0:32:07.84,0:32:11.09,Default,,0,0,0,,Жекпе-жекке келгенде, мен оған ана баладан гөрі үйреніп қалдым.
Dialogue: 0,0:32:11.59,0:32:14.72,Default,,0,0,0,,Саймон мұны істей алмайды. Ол ұрысатын түрі емес.
Dialogue: 0,0:32:15.22,0:32:16.47,Default,,0,0,0,,Сен де бүгін қаштың.
Dialogue: 0,0:32:17.10,0:32:18.77,Default,,0,0,0,,Саймон мұны жасайды.
Dialogue: 0,0:32:19.35,0:32:21.94,Default,,0,0,0,,Неліктен? Мұны қалай айта аласыз?
Dialogue: 0,0:32:22.02,0:32:23.77,Default,,0,0,0,,Неге сонша сенесің?
Dialogue: 0,0:32:23.85,0:32:26.52,Default,,0,0,0,,А... бұл логикалық емес.
Dialogue: 0,0:32:27.61,0:32:28.98,Default,,0,0,0,,Сонда не?
Dialogue: 0,0:32:29.07,0:32:30.61,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:32:30.69,0:32:33.24,Default,,0,0,0,,Себебі мен саған сенемін, мен оған сенемін.
Dialogue: 0,0:32:33.32,0:32:36.16,Default,,0,0,0,,Себебі мен оған сене аламын, мен саған сене аламын.
Dialogue: 0,0:32:36.66,0:32:39.20,Default,,0,0,0,,Мен үшін де солай
Dialogue: 0,0:32:41.58,0:32:44.17,Default,,0,0,0,,Менің серіктесім осындай.
Dialogue: 0,0:32:57.30,0:32:59.18,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:33:00.93,0:33:01.77,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:33:10.36,0:33:13.57,Default,,0,0,0,,Қашып кетпей, күткеніңді мақтаймын.
Dialogue: 0,0:33:13.65,0:33:14.61,Default,,0,0,0,,Айтамын ғой, қой!
Dialogue: 0,0:33:14.70,0:33:17.91,Default,,0,0,0,,Қашып кетпей, жасырынғаныңыз үшін мақтаймын.
Dialogue: 0,0:33:17.99,0:33:19.74,Default,,0,0,0,,Аң немесе адам? Түсініксіз жігіт
Dialogue: 0,0:33:19.83,0:33:20.70,Default,,0,0,0,,Какаре!
Dialogue: 0,0:33:20.79,0:33:22.41,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:33:27.75,0:33:28.29,Default,,0,0,0,,Қышу
Dialogue: 0,0:33:29.17,0:33:30.00,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:33:30.09,0:33:31.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:34.76,0:33:35.63,Default,,0,0,0,,Камина!
Dialogue: 0,0:33:36.22,0:33:36.76,Default,,0,0,0,,Уау
Dialogue: 0,0:33:36.84,0:33:38.72,Default,,0,0,0,,Өсу жоқ…
Dialogue: 0,0:33:38.80,0:33:39.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:40.68,0:33:42.14,Default,,0,0,0,,Бұл ол!
Dialogue: 0,0:33:42.22,0:33:44.10,Default,,0,0,0,,Дааа!
Dialogue: 0,0:33:44.18,0:33:45.02,Default,,0,0,0,,Камина!
Dialogue: 0,0:33:46.94,0:33:47.56,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:33:49.31,0:33:50.19,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:33:50.27,0:33:51.82,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:33:52.61,0:33:53.53,Default,,0,0,0,,- (Вирусты) Қарғыс атсын! -Ух...
Dialogue: 0,0:33:55.32,0:33:56.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:58.45,0:33:59.20,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:33:59.28,0:34:00.16,Default,,0,0,0,,Ғү!
Dialogue: 0,0:34:06.12,0:34:07.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:11.50,0:34:13.21,Default,,0,0,0,,Бұл әлі де жақсы емес.
Dialogue: 0,0:34:16.05,0:34:17.59,Default,,0,0,0,,Бұл мүмкін емес, бәрі.
Dialogue: 0,0:34:18.09,0:34:19.68,Default,,0,0,0,,Тоқта, ағайын.
Dialogue: 0,0:34:20.43,0:34:21.51,Default,,0,0,0,,Ха!
Dialogue: 0,0:34:23.31,0:34:27.69,Default,,0,0,0,,Қараңызшы, ол қайта-қайта көтеріледі.
Dialogue: 0,0:34:28.31,0:34:29.15,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:34:29.23,0:34:31.61,Default,,0,0,0,,Келгенше қанша рет қаласаң, сонша рет
Dialogue: 0,0:34:32.11,0:34:33.94,Default,,0,0,0,,Камина айтты, солай ма?
Dialogue: 0,0:34:34.03,0:34:37.70,Default,,0,0,0,,«Өзіңе сенбе, саған сенетін маған сен»
Dialogue: 0,0:34:38.36,0:34:39.99,Default,,0,0,0,,Сонда сіз ше?
Dialogue: 0,0:34:40.82,0:34:41.87,Default,,0,0,0,,Мен...
Dialogue: 0,0:34:43.45,0:34:46.33,Default,,0,0,0,,Кууууууууууууууууп
Dialogue: 0,0:34:46.91,0:34:48.04,Default,,0,0,0,,Мен...
Dialogue: 0,0:34:54.63,0:34:55.76,Default,,0,0,0,,Мен ЖоЖомен шайқасуға оралдым!
Dialogue: 0,0:34:58.97,0:35:01.84,Default,,0,0,0,,Әй, сен әлі тұрсың ба?
Dialogue: 0,0:35:01.93,0:35:05.31,Default,,0,0,0,,Мен енді ештеңенің мені жеңуіне жол бере алмаймын.
Dialogue: 0,0:35:05.39,0:35:06.81,Default,,0,0,0,,ақымақ
Dialogue: 0,0:35:06.89,0:35:08.35,Default,,0,0,0,,Қуат айырмашылығы…
Dialogue: 0,0:35:08.43,0:35:09.64,Default,,0,0,0,,Келесі аптаның қолжазбасын аяқтауға тек екі бет қана қалды.
Dialogue: 0,0:35:10.14,0:35:13.02,Default,,0,0,0,,Тозақта... Ойлан!
Dialogue: 0,0:35:17.28,0:35:18.44,Default,,0,0,0,,Камина!
Dialogue: 0,0:35:18.53,0:35:19.40,Default,,0,0,0,,Менің тістерім шығып тұрған сияқты
Dialogue: 0,0:35:19.49,0:35:21.36,Default,,0,0,0,,Қараңызшы, жарқырап тұр!
Dialogue: 0,0:35:21.45,0:35:23.78,Default,,0,0,0,,Бұл уақыт бітті
Dialogue: 0,0:35:23.87,0:35:24.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:24.74,0:35:25.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:35:27.70,0:35:28.75,Default,,0,0,0,,Не?
Dialogue: 0,0:35:36.21,0:35:38.34,Default,,0,0,0,,Уф, сен келдіңіз, Саймон.
Dialogue: 0,0:35:38.97,0:35:41.93,Default,,0,0,0,,Мен қорқамын... Төзгісіз қорқамын.
Dialogue: 0,0:35:42.01,0:35:45.26,Default,,0,0,0,,Бірақ ағамның өлуіне жол берсем, одан бетер жек көретін едім!
Dialogue: 0,0:35:45.35,0:35:47.14,Default,,0,0,0,,Жақсы айттың аға
Dialogue: 0,0:35:47.22,0:35:49.48,Default,,0,0,0,,If this happens, it's your last resort.
Dialogue: 0,0:35:49.56,0:35:50.39,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:35:50.48,0:35:51.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:51.85,0:35:52.56,Default,,0,0,0,,Жоспарды алдын ала талқылағанымызға қуаныштымын
Dialogue: 0,0:35:52.65,0:35:53.56,Default,,0,0,0,,Комбинация?
Dialogue: 0,0:35:53.65,0:35:54.69,Default,,0,0,0,,- (вирустық) комбинация? - Біріктірілген!
Dialogue: 0,0:35:54.77,0:35:56.52,Default,,0,0,0,,- (Йоко) Біріктіру... - (Ли Рон) Бұл мүмкін емес.
Dialogue: 0,0:35:56.61,0:35:58.57,Default,,0,0,0,,Сіз тырыспайынша ешқашан білмейсіз!
Dialogue: 0,0:35:58.65,0:36:01.03,Default,,0,0,0,,Уууу!
Dialogue: 0,0:36:08.04,0:36:10.66,Default,,0,0,0,,Көрдіңіз бе? Енді біздің де екі жүзіміз бар.
Dialogue: 0,0:36:10.75,0:36:12.87,Default,,0,0,0,,Сен сияқты, айуан!
Dialogue: 0,0:36:12.96,0:36:14.71,Default,,0,0,0,,- (Йоко) Ух... - (Ли Рон) Иә...
Dialogue: 0,0:36:14.79,0:36:17.17,Default,,0,0,0,,Қандай ақымақ адам.
Dialogue: 0,0:36:17.84,0:36:20.72,Default,,0,0,0,,Қанша жүз болғаны маңызды емес, бұл тек әртүрлі қолдар.
Dialogue: 0,0:36:20.80,0:36:21.63,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:36:23.93,0:36:24.80,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:36:26.35,0:36:27.97,Default,,0,0,0,,Камина! Саймон!
Dialogue: 0,0:36:31.02,0:36:31.89,Default,,0,0,0,,Сонымен... керемет
Dialogue: 0,0:36:32.73,0:36:33.85,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:36:42.40,0:36:45.53,Default,,0,0,0,,Дұрыс айтасың, олар шынымен де бірге болды.
Dialogue: 0,0:36:45.62,0:36:46.99,Default,,0,0,0,,Сол сияқты.
Dialogue: 0,0:36:50.29,0:36:52.08,Default,,0,0,0,,... біріктіріліп жатыр ма?
Dialogue: 0,0:36:52.16,0:36:53.54,Default,,0,0,0,,Адамға ұқсайды!
Dialogue: 0,0:36:54.42,0:36:58.25,Default,,0,0,0,,Не айтасың, Айуан, енді Таппа бізбен бірге болады.
Dialogue: 0,0:36:58.34,0:37:00.96,Default,,0,0,0,,Цк... бля!
Dialogue: 0,0:37:01.05,0:37:03.67,Default,,0,0,0,,Мдамуда Мдамуда!
Dialogue: 0,0:37:06.68,0:37:09.06,Default,,0,0,0,,Ку... Айқас санағыш!
Dialogue: 0,0:37:09.14,0:37:11.27,Default,,0,0,0,,Есіңе ал, хайуан.
Dialogue: 0,0:37:12.06,0:37:16.27,Default,,0,0,0,,Одақ – рух пен рухтың соқтығысуы!
Dialogue: 0,0:37:20.15,0:37:22.36,Default,,0,0,0,,Адамның жаны жанады
Dialogue: 0,0:37:22.44,0:37:25.82,Default,,0,0,0,,Батыл комбинация Гуррен Лаганн!
Dialogue: 0,0:37:26.57,0:37:28.78,Default,,0,0,0,,Сіз мені кім деп ойлайсыз?
Dialogue: 0,0:37:29.66,0:37:33.12,Default,,0,0,0,,Есіңізде болсын, бұл жігіттің аты Гуррен Лаганн!
Dialogue: 0,0:37:33.87,0:37:35.67,Default,,0,0,0,,- (Йоко) Гленн... - Лаганн
Dialogue: 0,0:37:35.75,0:37:37.00,Default,,0,0,0,,Манмане
Dialogue: 0,0:37:38.38,0:37:41.42,Default,,0,0,0,,Мен семсер қолданамын деп ешқашан ойламадым.
Dialogue: 0,0:37:41.50,0:37:43.59,Default,,0,0,0,,Мен сендерді төмен бағаладым, адамдар!
Dialogue: 0,0:37:44.09,0:37:47.93,Default,,0,0,0,,Менің ойымша, сіз Гуррен Лаганн деп айттыңыз!
Dialogue: 0,0:37:50.18,0:37:51.18,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:37:51.68,0:37:52.56,Default,,0,0,0,,Аһ!
Dialogue: 0,0:37:52.64,0:37:56.35,Default,,0,0,0,,Неге... Неге кенеттен қуат қосылды!
Dialogue: 0,0:37:56.85,0:37:59.73,Default,,0,0,0,,Кішкентай қарулы адамдармен жиналу арқылы... неге!
Dialogue: 0,0:37:59.81,0:38:02.69,Default,,0,0,0,,Сіз ешқашан түсінбейсіз!
Dialogue: 0,0:38:03.28,0:38:04.15,Default,,0,0,0,,Мен...
Dialogue: 0,0:38:05.19,0:38:06.20,Default,,0,0,0,,Екінші жартысында басқалар әлсіреп жатқанда, олар өздерінің көз тартымды Квиркімен жауды өздеріне тартты ➡
Dialogue: 0,0:38:06.70,0:38:08.70,Default,,0,0,0,,Сұмдық... Уау!
Dialogue: 0,0:38:08.78,0:38:10.16,Default,,0,0,0,,Камина!
Dialogue: 0,0:38:10.66,0:38:11.45,Default,,0,0,0,,Қый!
Dialogue: 0,0:38:14.16,0:38:15.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:16.37,0:38:19.33,Default,,0,0,0,,Уау... Бұл керемет. Көптеген шабуылдармен ...
Dialogue: 0,0:38:19.83,0:38:21.38,Default,,0,0,0,,Қандай қатал
Dialogue: 0,0:38:21.88,0:38:25.72,Default,,0,0,0,,Арнайы энергетикалық өріс жаудың шабуылын бейтараптайды ма деп ойлаймын.
Dialogue: 0,0:38:26.72,0:38:29.01,Default,,0,0,0,,шынымен ерекше болуы мүмкін
Dialogue: 0,0:38:33.89,0:38:35.89,Default,,0,0,0,,Ол жақсы серік болуы мүмкін.
Dialogue: 0,0:38:35.98,0:38:36.48,Default,,0,0,0,,Бұл?
Dialogue: 0,0:38:37.14,0:38:38.52,Default,,0,0,0,,Сіз және Камина
Dialogue: 0,0:38:38.60,0:38:39.35,Default,,0,0,0,,Иә
Dialogue: 0,0:38:40.02,0:38:41.02,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:38:42.02,0:38:44.73,Default,,0,0,0,,Кешіріңіз, мен қорқынышты нәрсе айттым.\NСондай-ақ
Dialogue: 0,0:38:45.23,0:38:46.15,Default,,0,0,0,,қаралған
Dialogue: 0,0:38:46.24,0:38:47.49,Default,,0,0,0,,-Ах... -(Боота) Бухи
Dialogue: 0,0:38:47.57,0:38:48.40,Default,,0,0,0,,Жоқ... жоқ.
Dialogue: 0,0:38:48.49,0:38:49.86,Default,,0,0,0,,- (Ли Рон) Эй - (Бута) Бұл?
Dialogue: 0,0:38:49.95,0:38:52.41,Default,,0,0,0,,Мен қызықты нәрсе таптым.
Dialogue: 0,0:38:52.49,0:38:54.04,Default,,0,0,0,,Қызықты нәрсе бар ма?
Dialogue: 0,0:38:54.12,0:38:57.83,Default,,0,0,0,,Гленн бағдарламасында қайтару нүктелері туралы деректер болды.
Dialogue: 0,0:38:57.91,0:38:58.83,Default,,0,0,0,,Қайтару нүктесі?
Dialogue: 0,0:38:59.46,0:39:02.38,Default,,0,0,0,,Гүрен бастапқыда жаудың қарушысы болған, солай ма?
Dialogue: 0,0:39:02.46,0:39:04.30,Default,,0,0,0,,Сіз қайтып баратын үй...
Dialogue: 0,0:39:05.09,0:39:07.72,Default,,0,0,0,,Бұл олардың негізгі базасы ма?
Dialogue: 0,0:39:13.93,0:39:15.51,Default,,0,0,0,,Баратыныңызға сенімдісіз бе?
Dialogue: 0,0:39:15.60,0:39:16.39,Default,,0,0,0,,Иә
Dialogue: 0,0:39:16.47,0:39:18.31,Default,,0,0,0,,Енді жаудың бекіністерін білеміз
Dialogue: 0,0:39:18.39,0:39:20.48,Default,,0,0,0,,Ең жылдам жол - оны жою.
Dialogue: 0,0:39:21.48,0:39:24.44,Default,,0,0,0,,Қазір бәрі жақсы, сондықтан қорықсаң да, жай ғана демалып ал.
Dialogue: 0,0:39:24.52,0:39:25.27,Default,,0,0,0,,Боо~
Dialogue: 0,0:39:26.28,0:39:27.49,Default,,0,0,0,,Қоштасу
Dialogue: 0,0:39:27.57,0:39:30.32,Default,,0,0,0,,Кешіріңіз, мен бірге барғым келетін адам - ​​Ямаяма.
Dialogue: 0,0:39:30.40,0:39:32.66,Default,,0,0,0,,Әйел: Балаларды қорғау да маңызды жұмыс.
Dialogue: 0,0:39:32.74,0:39:37.37,Default,,0,0,0,,Бірақ саған қарап, біз де қолымыздан келгеннің бәрін жасай алатындай сезінемін.
Dialogue: 0,0:39:37.45,0:39:38.16,Default,,0,0,0,,О!
Dialogue: 0,0:39:38.66,0:39:40.12,Default,,0,0,0,,-Жарайды... -Неге?
Dialogue: 0,0:39:40.21,0:39:41.75,Default,,0,0,0,,-Сол жүк... -(Ли Рон) Фу...
Dialogue: 0,0:39:41.83,0:39:45.21,Default,,0,0,0,,Әй, сауатты механик керек емес пе?
Dialogue: 0,0:39:45.29,0:39:46.84,Default,,0,0,0,,Бұл... түсіндім.
Dialogue: 0,0:39:47.63,0:39:49.05,Default,,0,0,0,,Даякка, жақсысың ба?
Dialogue: 0,0:39:49.13,0:39:52.26,Default,,0,0,0,,Бұл тек Ронның қалауы. Еш нәрсе істей алмайсың.
Dialogue: 0,0:39:52.34,0:39:53.18,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:39:53.26,0:39:56.18,Default,,0,0,0,,Сіз соншалықты қызықты нәрсені жіберіп алмайсыз, солай ма?
Dialogue: 0,0:39:56.26,0:39:59.48,Default,,0,0,0,,Мүмкін сол балалар бір нәрсені өзгертетін шығар.
Dialogue: 0,0:39:59.56,0:40:00.06,Default,,0,0,0,,Қый!
Dialogue: 0,0:40:00.68,0:40:02.40,Default,,0,0,0,,«Бірдеңе»
Dialogue: 0,0:40:02.48,0:40:04.90,Default,,0,0,0,,Иә, бұл багажды беріңізші.
Dialogue: 0,0:40:05.82,0:40:06.98,Default,,0,0,0,,Иә...
Dialogue: 0,0:40:09.11,0:40:09.94,Default,,0,0,0,,Мен... Мен ондай жігіттерді шын жек көремін!
Dialogue: 0,0:40:14.87,0:40:16.78,Default,,0,0,0,,-Сен бара аласың.-(Йоко) Иә?
Dialogue: 0,0:40:17.74,0:40:20.12,Default,,0,0,0,,Біз Литтнер ауылын қорғаймыз.
Dialogue: 0,0:40:20.79,0:40:22.33,Default,,0,0,0,,Өз жолыңызбен жүріңіз
Dialogue: 0,0:40:23.00,0:40:26.04,Default,,0,0,0,,Мен Йоко мұндай адамға әлсіз болады деп ешқашан ойламадым.
Dialogue: 0,0:40:26.13,0:40:27.00,Default,,0,0,0,,(Ауыл тұрғындарының күлкісі)
Dialogue: 0,0:40:27.09,0:40:29.05,Default,,0,0,0,,Қазірдің өзінде! Бұл сол емес.
Dialogue: 0,0:40:30.76,0:40:31.76,Default,,0,0,0,,Рахмет сізге Даякка!
Dialogue: 0,0:40:31.84,0:40:33.97,Default,,0,0,0,,Кездескенше Йоко!
Dialogue: 0,0:40:35.05,0:40:35.97,Default,,0,0,0,,Хехе
Dialogue: 0,0:40:37.01,0:40:39.85,Default,,0,0,0,,Кеттік, хайуандар.
Dialogue: 0,0:40:39.93,0:40:42.52,Default,,0,0,0,,Енді шабуыл кезегі бізде!
Dialogue: 0,0:40:49.53,0:40:51.53,Default,,0,0,0,,♪~
Dialogue: 0,0:41:08.79,0:41:09.34,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:41:11.42,0:41:13.17,Default,,0,0,0,,Мен Китанмын!
Dialogue: 0,0:41:13.88,0:41:14.68,Default,,0,0,0,,Біз
Dialogue: 0,0:41:14.76,0:41:15.68,Default,,0,0,0,,Жыртқыш...
Dialogue: 0,0:41:15.76,0:41:16.84,Default,,0,0,0,,Аңшы
Dialogue: 0,0:41:16.93,0:41:17.97,Default,,0,0,0,,...
Dialogue: 0,0:41:18.05,0:41:18.93,Default,,0,0,0,,Қара...
Dialogue: 0,0:41:19.01,0:41:20.89,Default,,0,0,0,,- Бауырлар! -Олар ағайынды!
Dialogue: 0,0:41:20.97,0:41:22.98,Default,,0,0,0,,♪~
Dialogue: 0,0:41:46.92,0:41:49.71,Default,,0,0,0,,Мен Адай ауылынан келген Росиумын.
Dialogue: 0,0:41:50.59,0:41:51.59,Default,,0,0,0,,Бұл?
Dialogue: 0,0:41:51.67,0:41:53.05,Default,,0,0,0,,Бұл ойын
Dialogue: 0,0:41:53.13,0:41:54.38,Default,,0,0,0,,- Иә? -(Далли) Бұл Далли.
Dialogue: 0,0:41:54.47,0:41:56.47,Default,,0,0,0,,♪~
Dialogue: 0,0:42:16.82,0:42:17.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:42:19.32,0:42:20.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:42:20.37,0:42:22.37,Default,,0,0,0,,♪~
Dialogue: 0,0:42:44.35,0:42:44.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:07.41,0:43:08.37,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:43:38.78,0:43:40.78,Default,,0,0,0,,~♪
Dialogue: 0,0:43:58.67,0:44:03.05,Default,,0,0,0,,Жерде қатты шу бар сияқты.
Dialogue: 0,0:44:03.14,0:44:07.77,Default,,0,0,0,,Иә, Қиыр Шығыс әскерлеріне үлкен шығын келтірілді.
Dialogue: 0,0:44:07.85,0:44:10.18,Default,,0,0,0,,Даңқты Спираль патшасының әскері
Dialogue: 0,0:44:10.27,0:44:12.06,Default,,0,0,0,,Бұл аянышты.
Dialogue: 0,0:44:12.14,0:44:14.23,Default,,0,0,0,,Қаһарлы Тимилф те құлады.
Dialogue: 0,0:44:14.31,0:44:16.15,Default,,0,0,0,,Жыл мезгілдерінің ауысуы кезінде
Dialogue: 0,0:44:16.23,0:44:19.65,Default,,0,0,0,,Жер астынан келе жатқан ақымақтар көбейеді.
Dialogue: 0,0:44:20.99,0:44:22.95,Default,,0,0,0,,Осы аймақта бір рет мұқият
Dialogue: 0,0:44:23.03,0:44:25.95,Default,,0,0,0,,Оны нокаутқа түсіру жақсы идея болуы мүмкін.
Dialogue: 0,0:44:26.03,0:44:27.99,Default,,0,0,0,,Сонымен, сетте алты ойынды бірінші жеңген адам жеңеді, иә?
Dialogue: 0,0:44:28.08,0:44:31.91,Default,,0,0,0,,Спиральды патшаның төрт аспан патшасы шайқасқа аттанғалы тұр.
Dialogue: 0,0:44:32.62,0:44:33.92,Default,,0,0,0,,Дүрбелеңге түспеңіз
Dialogue: 0,0:44:34.54,0:44:37.75,Default,,0,0,0,,Сендердің араларыңда ұятты ең жақсы білетін адам
Dialogue: 0,0:44:37.84,0:44:40.71,Default,,0,0,0,,Сол қорлықтан арылуға барады
Dialogue: 0,0:44:40.80,0:44:44.34,Default,,0,0,0,,Оның менің үмітімді орындамауы мүмкін емес.
Dialogue: 0,0:44:44.43,0:44:45.26,Default,,0,0,0,,Га
Dialogue: 0,0:44:45.97,0:44:49.26,Default,,0,0,0,,Бұл спираль патшаның мың жылдық зерігуі
Dialogue: 0,0:44:49.35,0:44:51.93,Default,,0,0,0,,Оны бұзатын ештеңе жасамаңыз.
Dialogue: 0,0:44:52.02,0:44:54.94,Default,,0,0,0,,Спиральды патшаны түсіндім
Dialogue: 0,0:45:04.41,0:45:05.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:45:07.70,0:45:11.25,Default,,0,0,0,,Хахахаха сен Каминаны көрдің бе?
Dialogue: 0,0:45:11.33,0:45:14.62,Default,,0,0,0,,Бұл Gunmen Daiganzan типті жылжымалы бекініс!
Dialogue: 0,0:45:15.96,0:45:17.79,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:45:17.88,0:45:20.63,Default,,0,0,0,,Үлкен... тым үлкен, аға.
Dialogue: 0,0:45:21.21,0:45:23.80,Default,,0,0,0,,Әй, қызық емес пе?
Dialogue: 0,0:45:25.88,0:45:27.72,Default,,0,0,0,,Мен жерді тастаған кезден осы уақытқа дейін
Dialogue: 0,0:45:27.80,0:45:30.81,Default,,0,0,0,,Маған сондай үлкен көлеңке түсірген
Dialogue: 0,0:45:30.89,0:45:32.68,Default,,0,0,0,,Сіз біріншісіз
Dialogue: 0,0:45:33.18,0:45:36.23,Default,,0,0,0,,Мен мынаны аламын!
Dialogue: 0,0:45:36.31,0:45:37.19,Default,,0,0,0,,Үлкен аға?
Dialogue: 0,0:45:37.27,0:45:38.23,Default,,0,0,0,,Бұл тым көп, Камина
Dialogue: 0,0:45:39.90,0:45:40.86,Default,,0,0,0,,Хехе
Dialogue: 0,0:45:40.94,0:45:42.36,Default,,0,0,0,,Онда!
Dialogue: 0,0:45:42.44,0:45:43.44,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:45:55.16,0:45:57.79,Default,,0,0,0,,Фухахаха!
Dialogue: 0,0:45:57.88,0:45:59.13,Default,,0,0,0,,Гуррен Лаган да
Dialogue: 0,0:45:59.21,0:46:02.00,Default,,0,0,0,,Дайганзанның алдында іс жеңіл.
Dialogue: 0,0:46:02.09,0:46:03.09,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:46:04.92,0:46:05.97,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:46:06.05,0:46:09.09,Default,,0,0,0,,Ату, ату, ату!
Dialogue: 0,0:46:14.68,0:46:16.31,Default,,0,0,0,,Фуфуфуфуфуфуфуфуфуфуфу!
Dialogue: 0,0:46:16.39,0:46:18.27,Default,,0,0,0,,Егер бұл орын алса...
Dialogue: 0,0:46:18.35,0:46:20.44,Default,,0,0,0,,Энкидудың өлімге әкелетін Ұлы Кабуто...
Dialogue: 0,0:46:20.52,0:46:21.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:46:23.78,0:46:26.90,Default,,0,0,0,,Сонда... Теме бастық па?
Dialogue: 0,0:46:26.99,0:46:27.95,Default,,0,0,0,,О!
Dialogue: 0,0:46:28.03,0:46:30.57,Default,,0,0,0,,Мен мұны ақыры түсіндім.
Dialogue: 0,0:46:30.66,0:46:34.16,Default,,0,0,0,,Мен Спиральды Патшаның Төрт Аспан Патшаларының бірімін.
Dialogue: 0,0:46:34.66,0:46:36.87,Default,,0,0,0,,О, ашулы Тимилф-сама.
Dialogue: 0,0:46:36.96,0:46:37.83,Default,,0,0,0,,Неапольдың ең үздік жиһаз шебері Марионың ұлы болып дүниеге келген
Dialogue: 0,0:46:37.92,0:46:40.08,Default,,0,0,0,,Мен бұл Аспандағы Төрт Патша ма, әлде басқа нәрсе ме, білмеймін.
Dialogue: 0,0:46:40.17,0:46:42.34,Default,,0,0,0,,Құлағыңыздың тесіктері арқылы мұқият тыңдаңыз.
Dialogue: 0,0:46:43.30,0:46:47.05,Default,,0,0,0,,Жанып тұрған күнді қолыммен ұстасам, шынында ыстық болады, бірақ шыдаймын.
Dialogue: 0,0:46:47.13,0:46:49.51,Default,,0,0,0,,Ерік күші қолдайтын қытайлық буддизм
Dialogue: 0,0:46:49.59,0:46:52.47,Default,,0,0,0,,Камина-сама, бұл мен туралы!
Dialogue: 0,0:46:53.06,0:46:55.14,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:46:55.22,0:46:55.89,Default,,0,0,0,,Иә
Dialogue: 0,0:46:55.97,0:46:57.89,Default,,0,0,0,,-Хмф! -Гаха!
Dialogue: 0,0:46:57.98,0:46:59.85,Default,,0,0,0,,-Хмф! -Гоооо!
Dialogue: 0,0:46:59.94,0:47:04.02,Default,,0,0,0,,Кішкентай! Бұл тым кішкентай Гуррен Лаганн
Dialogue: 0,0:47:04.11,0:47:07.99,Default,,0,0,0,,Егер ол адам жаман болса, оны жұлып алайық.
Dialogue: 0,0:47:08.07,0:47:09.49,Default,,0,0,0,,Мен ұстай алмаймын
Dialogue: 0,0:47:09.57,0:47:11.28,Default,,0,0,0,,Бөлінген~
Dialogue: 0,0:47:11.37,0:47:12.87,Default,,0,0,0,,Көз жасы…
Dialogue: 0,0:47:14.49,0:47:17.12,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:47:19.00,0:47:20.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:20.46,0:47:21.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:22.04,0:47:23.34,Default,,0,0,0,,(Маки) Мақсат болған бірінші курс студенті Итадори қаза тапты.
Dialogue: 0,0:47:23.42,0:47:25.34,Default,,0,0,0,,Арх! Уф...
Dialogue: 0,0:47:26.42,0:47:27.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:31.89,0:47:33.30,Default,,0,0,0,,Сен менің курткамды ұшырып, мені де ұшырып жібердің ғой!
Dialogue: 0,0:47:33.89,0:47:35.01,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:47:36.77,0:47:38.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:47:38.18,0:47:39.69,Default,,0,0,0,,Не?! Һмм…
Dialogue: 0,0:47:39.77,0:47:41.40,Default,,0,0,0,,А... бұл кім!
Dialogue: 0,0:47:41.48,0:47:44.77,Default,,0,0,0,,Лорд Тимилф, мына жерде қарулы адам бар!
Dialogue: 0,0:47:46.11,0:47:48.32,Default,,0,0,0,,Сізге қарулы адамдар көмектесті ме?
Dialogue: 0,0:47:48.40,0:47:49.95,Default,,0,0,0,,Қазір қашыңыз!
Dialogue: 0,0:47:50.03,0:47:51.45,Default,,0,0,0,,Бұл дауыс...
Dialogue: 0,0:47:51.53,0:47:53.87,Default,,0,0,0,,Ах, Литтнердің Даяккасы.
Dialogue: 0,0:47:53.95,0:47:54.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:54.62,0:47:57.49,Default,,0,0,0,,Қара ағасы Китан да бар.
Dialogue: 0,0:47:58.16,0:47:59.71,Default,,0,0,0,,Мені күттірдің, Камина!
Dialogue: 0,0:48:00.71,0:48:01.92,Default,,0,0,0,,Кім? Сіз
Dialogue: 0,0:48:02.00,0:48:05.17,Default,,0,0,0,,Бұл Китан-сама! Сіз қазірдің өзінде ұмыттыңыз ба? Эй!
Dialogue: 0,0:48:05.25,0:48:07.50,Default,,0,0,0,,Неге қарулысыңдар...
Dialogue: 0,0:48:07.59,0:48:08.80,Default,,0,0,0,,Бұл сенің кінәң
Dialogue: 0,0:48:08.88,0:48:09.38,Default,,0,0,0,,Мен?
Dialogue: 0,0:48:09.97,0:48:11.93,Default,,0,0,0,,Өйткені Камина Гленнді алды.
Dialogue: 0,0:48:12.01,0:48:13.22,Default,,0,0,0,,Барлығы да көшіріп жатыр.
Dialogue: 0,0:48:13.30,0:48:15.35,Default,,0,0,0,,Мен сені көшіріп жатқан жоқпын!
Dialogue: 0,0:48:15.43,0:48:15.93,Default,,0,0,0,,Барлығы?
Dialogue: 0,0:48:16.01,0:48:19.89,Default,,0,0,0,,Иә, жақын арада басқа достар да келетін сияқты.
Dialogue: 0,0:48:19.98,0:48:20.93,Default,,0,0,0,,(Шинобу) Мұнда тірі қалғандар жоқ сияқты.
Dialogue: 0,0:48:21.44,0:48:25.31,Default,,0,0,0,,Ух... адамдар
Dialogue: 0,0:48:25.40,0:48:26.77,Default,,0,0,0,,Бұл ыңғайсыз!
Dialogue: 0,0:48:26.86,0:48:29.11,Default,,0,0,0,,Ату, ату, ату!
Dialogue: 0,0:48:30.57,0:48:31.90,Default,,0,0,0,,Какаре!
Dialogue: 0,0:48:33.24,0:48:34.32,Default,,0,0,0,,Неапольдың ең үздік жиһаз шебері Марионың ұлы болып дүниеге келген
Dialogue: 0,0:48:34.41,0:48:36.83,Default,,0,0,0,,Осы заттардың бәрі қайтадан қатарға қойылған.
Dialogue: 0,0:48:36.91,0:48:38.37,Default,,0,0,0,,Тағы да... Уау!
Dialogue: 0,0:48:38.95,0:48:40.33,Default,,0,0,0,,А, жоқ.
Dialogue: 0,0:48:40.41,0:48:42.58,Default,,0,0,0,,Камина-сан және басқаларға сегізаяқ шабуыл жасайды.
Dialogue: 0,0:48:42.66,0:48:45.96,Default,,0,0,0,,Сәлеметсіз бе? Камина! Эй, сен мені естисің бе?
Dialogue: 0,0:48:46.04,0:48:48.30,Default,,0,0,0,,Қарсылас тым үлкен, бір рет артқа тартыңыз
Dialogue: 0,0:48:48.38,0:48:49.25,Default,,0,0,0,,Сонымен…
Dialogue: 0,0:48:49.96,0:48:53.47,Default,,0,0,0,,Қазір Камина құлап қалса, достарын кім тартады?
Dialogue: 0,0:48:54.05,0:48:55.55,Default,,0,0,0,,Камина өлсе ше?
Dialogue: 0,0:48:55.64,0:48:58.06,Default,,0,0,0,,Бізді кім басқарады?
Dialogue: 0,0:48:58.14,0:48:59.39,Default,,0,0,0,,- Шу! -(Йоко) Ах...
Dialogue: 0,0:48:59.47,0:49:01.85,Default,,0,0,0,,Қашып кетсең, ештеңе ұстай алмайсың!
Dialogue: 0,0:49:01.93,0:49:02.94,Default,,0,0,0,,Гвааах!
Dialogue: 0,0:49:03.02,0:49:03.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:04.02,0:49:06.44,Default,,0,0,0,,Амон, кел!
Dialogue: 0,0:49:07.06,0:49:07.94,Default,,0,0,0,,Уф!
Dialogue: 0,0:49:08.57,0:49:11.11,Default,,0,0,0,,Йоконың айтқаны орынды, ағайын.
Dialogue: 0,0:49:11.19,0:49:12.74,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:49:12.82,0:49:14.70,Default,,0,0,0,,Жауға беліңді көрсету деген нені білдіреді?
Dialogue: 0,0:49:14.78,0:49:17.95,Default,,0,0,0,,Бұл біздің оларға не алып жүргенімізді көрсету туралы.
Dialogue: 0,0:49:18.03,0:49:20.20,Default,,0,0,0,,Ертең біз қолға алғымыз келеді
Dialogue: 0,0:49:20.29,0:49:23.29,Default,,0,0,0,,Мен сені олардың нысанасына айналдырамын!
Dialogue: 0,0:49:23.79,0:49:27.13,Default,,0,0,0,,Бұл дұрыс болуы мүмкін, бірақ басқа нұсқалар бар...
Dialogue: 0,0:49:27.83,0:49:28.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:29.13,0:49:31.42,Default,,0,0,0,,Ағай, мен бірдеңе жасап көрейін.
Dialogue: 0,0:49:31.51,0:49:32.01,Default,,0,0,0,,Не?
Dialogue: 0,0:49:32.76,0:49:33.55,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:49:39.35,0:49:41.64,Default,,0,0,0,,А... Түсіндім.
Dialogue: 0,0:49:41.72,0:49:44.10,Default,,0,0,0,,Бұл жекпе-жек сізге байланысты!
Dialogue: 0,0:49:44.18,0:49:45.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:49:47.10,0:49:49.27,Default,,0,0,0,,Теня да батыр ма?
Dialogue: 0,0:49:49.77,0:49:52.40,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:49:52.98,0:49:55.78,Default,,0,0,0,,Не? Ол не істемекші?
Dialogue: 0,0:49:56.45,0:49:57.32,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:49:57.41,0:49:58.78,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:50:06.42,0:50:06.92,Default,,0,0,0,,Аһ!
Dialogue: 0,0:50:07.96,0:50:09.84,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:50:09.92,0:50:10.79,Default,,0,0,0,,Уф!
Dialogue: 0,0:50:12.46,0:50:13.42,Default,,0,0,0,,Гррр…
Dialogue: 0,0:50:17.43,0:50:20.18,Default,,0,0,0,,Иә? Енді қашатын жер жоқ
Dialogue: 0,0:50:20.26,0:50:21.72,Default,,0,0,0,,Ол жартастың шетінде.
Dialogue: 0,0:50:21.81,0:50:24.60,Default,,0,0,0,,Бұл балалар шынымен ақымақ болды ма?
Dialogue: 0,0:50:25.60,0:50:28.56,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:50:29.73,0:50:33.69,Default,,0,0,0,,Осы Дайганзанның ұтқырлығын бағаламаған сияқтысыз.
Dialogue: 0,0:50:34.19,0:50:36.19,Default,,0,0,0,,Бұрышта қалдың, Камина.
Dialogue: 0,0:50:36.78,0:50:37.86,Default,,0,0,0,,Қазір...
Dialogue: 0,0:50:39.07,0:50:40.32,Default,,0,0,0,,Бітті
Dialogue: 0,0:50:40.41,0:50:42.78,Default,,0,0,0,,Хехе... мінекей.
Dialogue: 0,0:50:44.62,0:50:45.20,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:50:49.29,0:50:52.92,Default,,0,0,0,,Уууу!
Dialogue: 0,0:50:58.13,0:50:59.72,Default,,0,0,0,,- (Құбыжық) Ах! -Уф...
Dialogue: 0,0:51:03.26,0:51:06.22,Default,,0,0,0,,Гуаа Камина... Жақсы жұмыс!
Dialogue: 0,0:51:06.31,0:51:07.64,Default,,0,0,0,,Мен емес
Dialogue: 0,0:51:07.73,0:51:09.31,Default,,0,0,0,,Мектептен шығарылу үшін қажет найзағайлар: 7 қалды
Dialogue: 0,0:51:09.39,0:51:12.11,Default,,0,0,0,,Бәрің де Спираль патшасының күшін жауға айналдырдыңдар.
Dialogue: 0,0:51:12.19,0:51:14.98,Default,,0,0,0,,Қараңдар! Мен ертең тағы келемін
Dialogue: 0,0:51:15.07,0:51:18.11,Default,,0,0,0,,Дайын болыңыз!
Dialogue: 0,0:51:19.36,0:51:23.16,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:51:23.24,0:51:26.33,Default,,0,0,0,,Шұңқыр қазған Саймон күткендей, ол мұны жасайды.
Dialogue: 0,0:51:26.41,0:51:27.75,Default,,0,0,0,,Эххе
Dialogue: 0,0:51:42.89,0:51:44.18,Default,,0,0,0,,-Үлкен аға... -Не болды!
Dialogue: 0,0:51:45.22,0:51:48.14,Default,,0,0,0,,Міне, мылтыққа қарсы тұрған жігіттер.
Dialogue: 0,0:51:48.64,0:51:52.90,Default,,0,0,0,,Мен аңшылардан қарулы адамдарды ұрлау үшін күрескен ақымақ туралы қауесетті естідім.
Dialogue: 0,0:51:52.98,0:51:55.32,Default,,0,0,0,,Осылайша олар жиналды.
Dialogue: 0,0:51:56.69,0:51:59.69,Default,,0,0,0,,Сенің ақымақтығың жұқпалы.
Dialogue: 0,0:52:09.25,0:52:10.91,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:52:11.00,0:52:13.25,Default,,0,0,0,,- (мүше) Иә! -(мүше) Сәке Сәке!
Dialogue: 0,0:52:13.33,0:52:14.79,Default,,0,0,0,,О, мен оны төгіп алдым.
Dialogue: 0,0:52:14.88,0:52:16.34,Default,,0,0,0,,Қарт осы жерде
Dialogue: 0,0:52:16.42,0:52:17.67,Default,,0,0,0,,Хаха~!
Dialogue: 0,0:52:30.73,0:52:33.27,Default,,0,0,0,,Йоко, біз жеңеміз.
Dialogue: 0,0:52:33.77,0:52:34.86,Default,,0,0,0,,Жең, жең
Dialogue: 0,0:52:34.94,0:52:37.86,Default,,0,0,0,,Олар сізге шабуыл жасаудан бас тартқанша жеңе беріңіз.
Dialogue: 0,0:52:37.94,0:52:41.70,Default,,0,0,0,,Ал, Саймон, Декосуке, Гимме, Далли, т.б.
Dialogue: 0,0:52:41.78,0:52:43.70,Default,,0,0,0,,Мен балалардың бейбіт өмір сүретініне көз жеткіземін.
Dialogue: 0,0:52:44.36,0:52:48.74,Default,,0,0,0,,Міне, біздің арамыздағы төбелес, Гленн тобы... жоқ, Ұлы Гленн тобы!
Dialogue: 0,0:52:51.96,0:52:54.75,Default,,0,0,0,,Бірақ қайта бүгінгідей ештеңе жасама.
Dialogue: 0,0:52:55.83,0:52:58.84,Default,,0,0,0,,Мен қорқып кеттім.
Dialogue: 0,0:53:02.59,0:53:05.18,Default,,0,0,0,,Ей, батыл ақымақтар!
Dialogue: 0,0:53:06.55,0:53:07.93,Default,,0,0,0,,Бірге келгендеріңізге көп рахмет.
Dialogue: 0,0:53:09.72,0:53:12.18,Default,,0,0,0,,Күндізгі үлкен қарулы адам.
Dialogue: 0,0:53:12.77,0:53:14.98,Default,,0,0,0,,Ол міндетті түрде ертең қайтадан қозғала бастайды
Dialogue: 0,0:53:16.48,0:53:18.40,Default,,0,0,0,,Сонымен... қалай?
Dialogue: 0,0:53:18.48,0:53:21.61,Default,,0,0,0,,Сол үлкен мылтықты да бағып алайық!
Dialogue: 0,0:53:21.69,0:53:22.94,Default,,0,0,0,,
Dialogue: 0,0:53:23.03,0:53:25.20,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:53:25.28,0:53:28.41,Default,,0,0,0,,Ендеше ертеңнен бастап бұл біздің қорғанымыз болады.
Dialogue: 0,0:53:28.49,0:53:30.45,Default,,0,0,0,,Менің ойымша, ол ақылсыз!
Dialogue: 0,0:53:30.54,0:53:32.29,Default,,0,0,0,,О!
Dialogue: 0,0:53:32.79,0:53:34.54,Default,,0,0,0,,Аңшыдан қарулыларды алып кет.
Dialogue: 0,0:53:34.62,0:53:36.08,Default,,0,0,0,,Біз осы уақытқа дейін жеттік
Dialogue: 0,0:53:36.17,0:53:37.71,Default,,0,0,0,,Қорқатын ештеңе жоқ!
Dialogue: 0,0:53:37.79,0:53:39.13,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:53:39.21,0:53:41.09,Default,,0,0,0,,Бірақ мұны қалай істейміз, ағайын?
Dialogue: 0,0:53:41.76,0:53:44.55,Default,,0,0,0,,Эй, сен солай істейсің.
Dialogue: 0,0:53:45.13,0:53:47.68,Default,,0,0,0,,Иә! О... мен?
Dialogue: 0,0:53:47.76,0:53:48.55,Default,,0,0,0,,Хехехе
Dialogue: 0,0:53:52.77,0:53:55.94,Default,,0,0,0,,(Боотаның қорылдауы)
Dialogue: 0,0:53:56.02,0:53:57.65,Default,,0,0,0,,(ысырманы түрту дыбысы)
Dialogue: 0,0:53:58.27,0:53:59.52,Default,,0,0,0,,Йо... Йоко!
Dialogue: 0,0:53:59.61,0:54:01.36,Default,,0,0,0,,Қайырлы таң, қалдарыңыз қалай? Қалыңыз қалай?
Dialogue: 0,0:54:02.03,0:54:02.57,Default,,0,0,0,,Иә
Dialogue: 0,0:54:03.32,0:54:04.65,Default,,0,0,0,,Күн ыстық, абай болыңыз
Dialogue: 0,0:54:05.15,0:54:08.70,Default,,0,0,0,,Лаганның қарны ашса, күші болмайды.
Dialogue: 0,0:54:08.78,0:54:10.28,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:54:13.83,0:54:15.00,Default,,0,0,0,,Сәлем Саймон
Dialogue: 0,0:54:15.08,0:54:15.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:16.71,0:54:17.21,Default,,0,0,0,,Бұл?
Dialogue: 0,0:54:18.79,0:54:19.58,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:54:19.67,0:54:21.29,Default,,0,0,0,,Жоқ, ештеңе.
Dialogue: 0,0:54:21.92,0:54:22.96,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:54:26.47,0:54:27.76,Default,,0,0,0,,-Ачичичи! -(Боота) Буу!
Dialogue: 0,0:54:28.34,0:54:29.47,Default,,0,0,0,,Тек бір-екі жастағы бала үшін
Dialogue: 0,0:54:31.22,0:54:35.60,Default,,0,0,0,,Иә, Леерон күткендей, мен мұны шешкім келмейді.
Dialogue: 0,0:54:35.68,0:54:40.06,Default,,0,0,0,,Басқа біреуден мылтықыңызды күтіп ұстауды сұрауыңыз әдеттен тыс.
Dialogue: 0,0:54:40.69,0:54:42.86,Default,,0,0,0,,Сәтсіздік бүгінгі таңда мүмкін емес
Dialogue: 0,0:54:42.94,0:54:44.11,Default,,0,0,0,,Сіз түсінген сияқтысыз.
Dialogue: 0,0:54:44.19,0:54:46.19,Default,,0,0,0,,Гуррен Лаган мен Гурен жалғыз
Dialogue: 0,0:54:46.28,0:54:47.90,Default,,0,0,0,,Күш мүлде басқа.
Dialogue: 0,0:54:47.99,0:54:49.16,Default,,0,0,0,,Қорғаныс күші де.
Dialogue: 0,0:54:49.66,0:54:52.78,Default,,0,0,0,,Камина кешегідей шабуылын жалғастыра берсе не болады...
Dialogue: 0,0:54:53.28,0:54:54.74,Default,,0,0,0,,Біз қазір не айтып жатырмыз?
Dialogue: 0,0:54:54.83,0:54:56.45,Default,,0,0,0,,Ол тоқтайтын адам емес.
Dialogue: 0,0:54:56.54,0:54:57.91,Default,,0,0,0,,Қалғаны мен...
Dialogue: 0,0:54:58.42,0:55:00.08,Default,,0,0,0,,Қандай қиын адам!
Dialogue: 0,0:55:01.96,0:55:05.34,Default,,0,0,0,,Сіз де өте қиын әйелсіз.
Dialogue: 0,0:55:06.97,0:55:10.30,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:55:10.80,0:55:11.51,Default,,0,0,0,,Гррр…
Dialogue: 0,0:55:11.59,0:55:13.35,Default,,0,0,0,,
Dialogue: 0,0:55:13.43,0:55:14.31,Default,,0,0,0,,Иә
Dialogue: 0,0:55:14.89,0:55:18.52,Default,,0,0,0,,Егер сіз көп жесеңіз, сіз қозғала алмайсыз ба?
Dialogue: 0,0:55:18.60,0:55:20.27,Default,,0,0,0,,(ауыз судың дыбысы)
Dialogue: 0,0:55:20.35,0:55:21.48,Default,,0,0,0,,Хаа…
Dialogue: 0,0:55:22.06,0:55:25.28,Default,,0,0,0,,Маған күш керек, әсіресе бүгін.
Dialogue: 0,0:55:25.36,0:55:26.11,Default,,0,0,0,,Иә
Dialogue: 0,0:55:26.19,0:55:28.53,Default,,0,0,0,,Йоко, мен артқы жағын сұрадым.
Dialogue: 0,0:55:28.61,0:55:29.28,Default,,0,0,0,,Иә
Dialogue: 0,0:55:29.36,0:55:32.32,Default,,0,0,0,,Мен бұрыннан келген жігіттердің барлығын талқандаймын.
Dialogue: 0,0:55:32.41,0:55:34.20,Default,,0,0,0,,Сол себепті артымдағы жаудан сұраймын.
Dialogue: 0,0:55:34.28,0:55:35.29,Default,,0,0,0,,Камина
Dialogue: 0,0:55:35.37,0:55:36.12,Default,,0,0,0,,Әй?
Dialogue: 0,0:55:40.17,0:55:43.29,Default,,0,0,0,,Расында да арқа қорғансыз.
Dialogue: 0,0:55:43.92,0:55:44.96,Default,,0,0,0,,Сіз...
Dialogue: 0,0:55:59.18,0:56:00.35,Default,,0,0,0,,10x қайтару
Dialogue: 0,0:56:00.44,0:56:01.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:01.77,0:56:03.56,Default,,0,0,0,,Қайтып келсем, 10 рет қайтарамын.
Dialogue: 0,0:56:03.65,0:56:05.27,Default,,0,0,0,,(Ол Майт) Уг!? (Презент Майк) Эй, эй, не болып жатыр!?
Dialogue: 0,0:56:06.02,0:56:06.65,Default,,0,0,0,,Фу…
Dialogue: 0,0:56:08.07,0:56:08.82,Default,,0,0,0,,Не?
Dialogue: 0,0:56:08.90,0:56:11.78,Default,,0,0,0,,Оны айтудың басқа жолы бар емес пе?
Dialogue: 0,0:56:13.24,0:56:16.45,Default,,0,0,0,,Енді, жабайы жүрейік!
Dialogue: 0,0:56:16.53,0:56:20.16,Default,,0,0,0,,Камина, асыға күтемін, 10 есе қайтар.
Dialogue: 0,0:56:20.25,0:56:21.46,Default,,0,0,0,,О
Dialogue: 0,0:56:26.00,0:56:26.50,Default,,0,0,0,,Фу…
Dialogue: 0,0:56:31.51,0:56:33.89,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:56:33.97,0:56:36.43,Default,,0,0,0,,Қараңдар! Стратегия қарапайым
Dialogue: 0,0:56:36.93,0:56:39.60,Default,,0,0,0,,Алдымен, біз қарулы шабандоздар шабуылға шықтық.
Dialogue: 0,0:56:39.68,0:56:41.48,Default,,0,0,0,,Қарсылас қарулы адамдарды азғырыңыз
Dialogue: 0,0:56:41.56,0:56:45.56,Default,,0,0,0,,Сол кезде Саймон Лаганнды сол үлкен бөксенің басымен біріктіру үшін пайдаланды.
Dialogue: 0,0:56:45.65,0:56:46.94,Default,,0,0,0,,бақылауды басып алу
Dialogue: 0,0:56:47.52,0:56:50.24,Default,,0,0,0,,Ұрлаған үлкен затыңызбен жауды талқандаңыз.
Dialogue: 0,0:56:50.32,0:56:53.40,Default,,0,0,0,,Енді біз бұл жекпе-жекті жеңгенімізді білеміз!
Dialogue: 0,0:56:53.49,0:56:54.41,Default,,0,0,0,,О!
Dialogue: 0,0:56:54.49,0:56:55.32,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:56:55.41,0:56:56.87,Default,,0,0,0,,Мен сені өлтіремін, мен сені өлтіремін.
Dialogue: 0,0:56:56.95,0:57:00.75,Default,,0,0,0,,Мен қарулы адамдардың бір-бірімен байланысуына мүмкіндік жасадым.
Dialogue: 0,0:57:00.83,0:57:04.92,Default,,0,0,0,,Менің ойымша, олар басқа адамдарды онша тыңдайтын адамдар емес.
Dialogue: 0,0:57:05.00,0:57:07.79,Default,,0,0,0,,Ұзақ өмір сүргің келсе, аралас.
Dialogue: 0,0:57:07.88,0:57:09.09,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:57:09.17,0:57:09.84,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:57:09.92,0:57:12.30,Default,,0,0,0,,Мен сізге хабарласамын. Мен сені ұрамын. Мен жасаймын!
Dialogue: 0,0:57:12.38,0:57:14.51,Default,,0,0,0,,Жарайды! Кеттік, бейбақтар.
Dialogue: 0,0:57:15.14,0:57:17.22,Default,,0,0,0,,Дайгурен командасы шықты!
Dialogue: 0,0:57:17.30,0:57:19.26,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:57:19.35,0:57:22.18,Default,,0,0,0,,Қош келдіңіз! сақ болыңыз!
Dialogue: 0,0:57:26.23,0:57:28.19,Default,,0,0,0,,Тым көп ойламаңыз
Dialogue: 0,0:57:28.27,0:57:30.11,Default,,0,0,0,,Ойыңды жинақта, мен.
Dialogue: 0,0:57:40.16,0:57:41.08,Default,,0,0,0,,Бұл...
Dialogue: 0,0:57:41.16,0:57:42.20,Default,,0,0,0,,Бірі - Лаганн
Dialogue: 0,0:57:42.29,0:57:45.00,Default,,0,0,0,,Біреуі Гленн жүйесіне қосылған.
Dialogue: 0,0:57:45.08,0:57:47.00,Default,,0,0,0,,- (Ли Рон) Көмек бергіңіз келе ме? -Иә
Dialogue: 0,0:57:47.08,0:57:49.46,Default,,0,0,0,,Маған да бер, маған да бер! жасаңыз!
Dialogue: 0,0:57:56.59,0:57:57.84,Default,,0,0,0,,Жарайды
Dialogue: 0,0:58:02.72,0:58:03.77,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:58:03.85,0:58:04.98,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:58:06.44,0:58:07.56,Default,,0,0,0,,Мен сені күттім!
Dialogue: 0,0:58:07.65,0:58:08.81,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:58:08.90,0:58:11.52,Default,,0,0,0,,Мен сендердің келе жатқандарыңды білдім.
Dialogue: 0,0:58:11.61,0:58:13.48,Default,,0,0,0,,Мен солай болады деп ойладым.
Dialogue: 0,0:58:15.95,0:58:17.16,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:58:17.74,0:58:18.82,Default,,0,0,0,,Бұл жартас!
Dialogue: 0,0:58:18.91,0:58:20.49,Default,,0,0,0,,Жеңдер, хайуан!
Dialogue: 0,0:58:20.58,0:58:22.58,Default,,0,0,0,,Қарғыс атсын сендерге жабайы адамдар.
Dialogue: 0,0:58:22.66,0:58:24.70,Default,,0,0,0,,Жұдырықтай да дұрыс алмаса алмайсың ба?
Dialogue: 0,0:58:24.79,0:58:27.12,Default,,0,0,0,,Бұл жартас менің жұдырығым!
Dialogue: 0,0:58:27.21,0:58:29.58,Default,,0,0,0,,Хахаха бұл ыңғайсыз
Dialogue: 0,0:58:30.17,0:58:32.05,Default,,0,0,0,,Дайганзан іске қосылды!
Dialogue: 0,0:58:32.13,0:58:33.71,Default,,0,0,0,,Барлық қару порттары ашық
Dialogue: 0,0:58:33.80,0:58:36.01,Default,,0,0,0,,Оларды тастаңыз!
Dialogue: 0,0:58:36.09,0:58:37.59,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:58:37.68,0:58:38.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:38.47,0:58:40.55,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:58:41.05,0:58:42.93,Default,,0,0,0,,Катапульт қолы
Dialogue: 0,0:58:43.01,0:58:45.68,Default,,0,0,0,,Күту режимі
Dialogue: 0,0:58:46.68,0:58:48.14,Default,,0,0,0,,Лақтыр!
Dialogue: 0,0:58:51.15,0:58:52.57,Default,,0,0,0,,Яаааа!
Dialogue: 0,0:58:53.73,0:58:56.19,Default,,0,0,0,,Теяаааааааааа!
Dialogue: 0,0:58:56.28,0:58:57.24,Default,,0,0,0,,Нвааах!
Dialogue: 0,0:58:59.24,0:59:00.99,Default,,0,0,0,,Уф... Менің басым жоқ!
Dialogue: 0,0:59:01.57,0:59:03.49,Default,,0,0,0,,Сіздің басыңызға не болды?
Dialogue: 0,0:59:03.99,0:59:05.95,Default,,0,0,0,,Қазір! Симон жүр!
Dialogue: 0,0:59:07.21,0:59:09.67,Default,,0,0,0,,Уууу!
Dialogue: 0,0:59:09.75,0:59:12.21,Default,,0,0,0,,Тез кел, Саймон!
Dialogue: 0,0:59:12.29,0:59:14.71,Default,,0,0,0,,​​Лаган әсері!
Dialogue: 0,0:59:14.80,0:59:16.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:16.17,0:59:18.42,Default,,0,0,0,,Мен бұл үлкен нәрсені аламын.
Dialogue: 0,0:59:18.51,0:59:21.14,Default,,0,0,0,,Камина, сен жоспар құрдың!
Dialogue: 0,0:59:23.76,0:59:25.56,Default,,0,0,0,,О, бұл жұмыс істеді.
Dialogue: 0,0:59:27.02,0:59:30.65,Default,,0,0,0,,Біздің жолымыз бен ер ерлігіміз!
Dialogue: 0,0:59:30.73,0:59:32.44,Default,,0,0,0,,Хе... Хе!
Dialogue: 0,0:59:32.52,0:59:34.27,Default,,0,0,0,,Сәлем! Ха!
Dialogue: 0,0:59:34.36,0:59:37.74,Default,,0,0,0,,Мына жігіт... қашан қолын сонша көтерді!
Dialogue: 0,0:59:37.82,0:59:38.78,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:59:42.45,0:59:43.57,Default,,0,0,0,,Маған мұны істеуге рұқсат етпеңіз
Dialogue: 0,0:59:47.79,0:59:50.71,Default,,0,0,0,,Жасайық. Біз де ұтыла алмаймыз.
Dialogue: 0,0:59:50.79,0:59:51.92,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:59:53.92,0:59:54.67,Default,,0,0,0,,Хехе
Dialogue: 0,0:59:54.75,0:59:55.38,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:59:55.46,0:59:56.25,Default,,0,0,0,,Не!
Dialogue: 0,0:59:57.84,1:00:00.13,Default,,0,0,0,,Эй, сен не істеп жатырсың, Саймон?
Dialogue: 0,1:00:00.22,1:00:02.51,Default,,0,0,0,,Кешіріңіз! Бұл әдейі емес
Dialogue: 0,1:00:02.59,1:00:03.97,Default,,0,0,0,,Бірақ мен оны іске қоса алмаймын...
Dialogue: 0,1:00:04.05,1:00:05.85,Default,,0,0,0,,Не болды, Саймон? не істеп жатырсың
Dialogue: 0,1:00:05.93,1:00:07.68,Default,,0,0,0,,Мен білемін! Мен білемін, бірақ...
Dialogue: 0,1:00:11.77,1:00:15.65,Default,,0,0,0,,Неліктен... Неліктен мен осындай нәрсеге назар аудара алмаймын? Қат!
Dialogue: 0,1:00:15.73,1:00:19.36,Default,,0,0,0,,Бұл туралы уайымдамаңыз! Барлығыңыз, Дайганзанға оралыңыз!
Dialogue: 0,1:00:20.19,1:00:21.15,Default,,0,0,0,,Уау!
Dialogue: 0,1:00:21.65,1:00:23.41,Default,,0,0,0,,Мені жіберме
Dialogue: 0,1:00:23.91,1:00:27.70,Default,,0,0,0,,Қарулы адамдарды тоқтатыңыз! Мен Саймон туралы бірдеңе істеймін!
Dialogue: 0,1:00:27.79,1:00:28.29,Default,,0,0,0,,О!
Dialogue: 0,1:00:29.29,1:00:30.00,Default,,0,0,0,,Гррр…
Dialogue: 0,1:00:31.71,1:00:32.21,Default,,0,0,0,,Гррр…
Dialogue: 0,1:00:32.92,1:00:36.04,Default,,0,0,0,,Ал аааааааааа!
Dialogue: 0,1:00:36.13,1:00:38.63,Default,,0,0,0,,Уф! Гах...
Dialogue: 0,1:00:40.34,1:00:41.63,Default,,0,0,0,,-Гах... -Уау!
Dialogue: 0,1:00:41.72,1:00:43.18,Default,,0,0,0,,Мына жерді аш, Саймон!
Dialogue: 0,1:00:44.22,1:00:46.85,Default,,0,0,0,,Тістеріңізді қысыңыз!
Dialogue: 0,1:00:47.97,1:00:49.10,Default,,0,0,0,,Аһ!
Dialogue: 0,1:00:53.35,1:00:55.02,Default,,0,0,0,,А... ағайын?
Dialogue: 0,1:00:57.36,1:00:58.52,Default,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,1:01:00.07,1:01:03.49,Default,,0,0,0,,Адасып қалсаң, міндетті түрде келіп соғамын.
Dialogue: 0,1:01:03.99,1:01:07.87,Default,,0,0,0,,Сондықтан уайымдама, мен сенің жаныңдамын.
Dialogue: 0,1:01:07.95,1:01:09.33,Default,,0,0,0,,Саған сену
Dialogue: 0,1:01:09.87,1:01:11.95,Default,,0,0,0,,Мен саған кім сенетініме сен.
Dialogue: 0,1:01:17.63,1:01:18.54,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,1:01:23.59,1:01:24.59,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,1:01:24.68,1:01:26.47,Default,,0,0,0,,Жарайды, Саймон, бұл тамаша!
Dialogue: 0,1:01:26.55,1:01:29.64,Default,,0,0,0,,Мен барған сайын синхрондау үстіндемін. Кішкене ғана.
Dialogue: 0,1:01:33.89,1:01:34.69,Default,,0,0,0,,Фу…
Dialogue: 0,1:01:37.77,1:01:39.48,Default,,0,0,0,,Мен мұны істей аламын деп ойлаймын.
Dialogue: 0,1:01:43.99,1:01:45.11,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:48.28,1:01:50.41,Default,,0,0,0,,Ахх!
Dialogue: 0,1:01:52.37,1:01:53.87,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:01:53.96,1:01:55.08,Default,,0,0,0,,Тұрақты түрде құрмет көрсет, Анджело.
Dialogue: 0,1:01:55.67,1:01:56.29,Default,,0,0,0,,Камина!
Dialogue: 0,1:01:57.33,1:01:59.59,Default,,0,0,0,,Гухахаха!
Dialogue: 0,1:01:59.67,1:02:03.84,Default,,0,0,0,,Дайганзанымды оңайлықпен бермеймін.
Dialogue: 0,1:02:03.92,1:02:05.63,Default,,0,0,0,,Тимилф! Тоқта...
Dialogue: 0,1:02:05.72,1:02:06.30,Default,,0,0,0,,Аһ!
Dialogue: 0,1:02:10.26,1:02:12.64,Default,,0,0,0,,Мен бір нәрсені ұмытып қалдым. Мен оны қайтардым.
Dialogue: 0,1:02:12.72,1:02:14.10,Default,,0,0,0,,Теме...
Dialogue: 0,1:02:14.18,1:02:16.52,Default,,0,0,0,,Жүзі жойылатын найза (Arkaid Glaive)!
Dialogue: 0,1:02:18.31,1:02:19.44,Default,,0,0,0,,Уф... уф
Dialogue: 0,1:02:19.52,1:02:21.61,Default,,0,0,0,,Ол қыңыр адам.
Dialogue: 0,1:02:21.69,1:02:24.86,Default,,0,0,0,,Бірақ солай!
Dialogue: 0,1:02:31.58,1:02:38.17,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, All Might-ты басып озуға міндетті.
Dialogue: 0,1:02:45.84,1:02:47.13,Default,,0,0,0,,Бұл...
Dialogue: 0,1:02:47.22,1:02:48.59,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:55.35,1:02:56.60,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:02:56.68,1:03:01.31,Default,,0,0,0,,Ааа... аа... а...
Dialogue: 0,1:03:01.94,1:03:04.57,Default,,0,0,0,,～
Dialogue: 0,1:03:11.37,1:03:12.74,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,1:03:12.83,1:03:14.20,Default,,0,0,0,,- (вирустық) Арх! -Уау...
Dialogue: 0,1:03:19.92,1:03:21.54,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:03:30.89,1:03:33.35,Default,,0,0,0,,Не... не болды?
Dialogue: 0,1:03:33.43,1:03:34.51,Default,,0,0,0,,Лорд Тимилф, бұл қауіпті!
Dialogue: 0,1:03:35.14,1:03:36.43,Default,,0,0,0,,Уф... әф!
Dialogue: 0,1:03:36.52,1:03:39.14,Default,,0,0,0,,О, вирустық! Қайда бара жатырсың?
Dialogue: 0,1:03:39.23,1:03:40.44,Default,,0,0,0,,Не болды? Леерон
Dialogue: 0,1:03:40.52,1:03:42.19,Default,,0,0,0,,Дайганзан жабайы жүгіреді!
Dialogue: 0,1:03:42.69,1:03:44.48,Default,,0,0,0,,Осылай жүре берсек, жанартау кратеріне түсеміз...
Dialogue: 0,1:03:44.57,1:03:45.90,Default,,0,0,0,,Джоган Баринбо айналып жүр
Dialogue: 0,1:03:45.98,1:03:46.98,Default,,0,0,0,,Тоқта, Камина ше?
Dialogue: 0,1:03:47.49,1:03:50.57,Default,,0,0,0,,Камина жауап беріңізші! Камина!
Dialogue: 0,1:03:50.66,1:03:53.20,Default,,0,0,0,,Сізге жақсы ұйықтаудың қажеті жоқ...
Dialogue: 0,1:03:58.79,1:04:00.16,Default,,0,0,0,,Саймон, тоқта! Саймон!
Dialogue: 0,1:04:01.33,1:04:02.38,Default,,0,0,0,,Жоқ...
Dialogue: 0,1:04:03.96,1:04:07.84,Default,,0,0,0,,Мен енді ештеңе істей алмаймын.
Dialogue: 0,1:04:08.38,1:04:11.47,Default,,0,0,0,,Саймон! Тістеріңізді қысыңыз!
Dialogue: 0,1:04:11.55,1:04:12.30,Default,,0,0,0,,Ха!
Dialogue: 0,1:04:13.01,1:04:13.51,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:13.59,1:04:14.76,Default,,0,0,0,,Уф!
Dialogue: 0,1:04:15.64,1:04:16.85,Default,,0,0,0,,Бұл сенің мәселең — яғни, жадыңның!
Dialogue: 0,1:04:16.93,1:04:18.39,Default,,0,0,0,,Не?! Һмм…
Dialogue: 0,1:04:21.52,1:04:23.06,Default,,0,0,0,,Ол тірі болды ма? Үлкен аға!
Dialogue: 0,1:04:23.15,1:04:26.52,Default,,0,0,0,,Саймон, сен өзіңді кім деп ойлайсың?
Dialogue: 0,1:04:26.61,1:04:27.48,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:28.44,1:04:33.70,Default,,0,0,0,,Аспанды, жерді, ертеңді тесіп өтетін бұрғы емес пе?
Dialogue: 0,1:04:34.62,1:04:37.33,Default,,0,0,0,,Сен мұндай жерде не істеп жүрсің?
Dialogue: 0,1:04:37.41,1:04:39.12,Default,,0,0,0,,Біз жеңдік
Dialogue: 0,1:04:39.20,1:04:41.50,Default,,0,0,0,,Анау үлкен бөксе сенікі.
Dialogue: 0,1:04:41.58,1:04:43.37,Default,,0,0,0,,Уайымдайтын ештеңе жоқ!
Dialogue: 0,1:04:43.96,1:04:44.96,Default,,0,0,0,,Жоқ, біз бұлай істей алмаймыз!
Dialogue: 0,1:04:45.59,1:04:46.09,Default,,0,0,0,,Иә!
Dialogue: 0,1:04:51.88,1:04:54.05,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,1:04:54.14,1:04:56.14,Default,,0,0,0,,Мына Дайғанзан біздікі.
Dialogue: 0,1:04:56.22,1:04:57.56,Default,,0,0,0,,Жүр, жүр!
Dialogue: 0,1:04:57.64,1:04:59.06,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,1:04:59.56,1:05:00.60,Default,,0,0,0,,Уау!
Dialogue: 0,1:05:00.68,1:05:02.81,Default,,0,0,0,,Жағымсыз адамдар
Dialogue: 0,1:05:02.89,1:05:06.44,Default,,0,0,0,,Бұл Тимилфаға Спираль патшасы берген.
Dialogue: 0,1:05:06.52,1:05:10.28,Default,,0,0,0,,Мен оны сендерге бергенше, құртқаным артық!
Dialogue: 0,1:05:11.36,1:05:12.11,Default,,0,0,0,,Уау!
Dialogue: 0,1:05:12.19,1:05:14.95,Default,,0,0,0,,Көңіл көтеруден бас тартқан аң
Dialogue: 0,1:05:15.62,1:05:19.16,Default,,0,0,0,,Саймон, кел, мен бәріңді бір теуіп жіберемін.
Dialogue: 0,1:05:19.24,1:05:20.08,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:20.16,1:05:21.50,Default,,0,0,0,,Бұл комбинация.
Dialogue: 0,1:05:21.58,1:05:24.96,Default,,0,0,0,,Соңғы қорытындыны Гуррен Лаганн шешеді!
Dialogue: 0,1:05:25.04,1:05:26.54,Default,,0,0,0,,Түсіндім, аға.
Dialogue: 0,1:05:34.88,1:05:35.38,Default,,0,0,0,,Оларды осы жаққа жіберіңізші.
Dialogue: 0,1:05:43.68,1:05:46.15,Default,,0,0,0,,Ақылсыз, бейқам деп күлу
Dialogue: 0,1:05:46.65,1:05:48.98,Default,,0,0,0,,Ерік-жігерге негізделген күрес стилі
Dialogue: 0,1:05:49.48,1:05:51.90,Default,,0,0,0,,Қабырға болса, соғып, сындырыңыз
Dialogue: 0,1:05:52.40,1:05:54.70,Default,,0,0,0,,Жол болмаса, қолыммен жасаймын
Dialogue: 0,1:05:55.70,1:05:58.24,Default,,0,0,0,,Жүрегімдегі магма жалынмен жанады
Dialogue: 0,1:05:58.32,1:06:01.74,Default,,0,0,0,,Супер комбинация Гуррен Лаганн!
Dialogue: 0,1:06:02.24,1:06:02.87,Default,,0,0,0,,барлығы дерлік өлімге ұшырауға жақын қалды, бұл менің кінәм.
Dialogue: 0,1:06:03.45,1:06:04.08,Default,,0,0,0,,Біз...
Dialogue: 0,1:06:05.29,1:06:08.29,Default,,0,0,0,,Өзіңді кіммін деп ойлайсың?
Dialogue: 0,1:06:10.13,1:06:12.51,Default,,0,0,0,,(Топ мүшелерінің қошеметтері)
Dialogue: 0,1:06:14.01,1:06:15.51,Default,,0,0,0,,Мен оны жеңе алмаймын.
Dialogue: 0,1:06:16.05,1:06:18.97,Default,,0,0,0,,Ешқандай болмаңыз! Жаса! Жаса!
Dialogue: 0,1:06:19.97,1:06:21.85,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,1:06:35.90,1:06:37.99,Default,,0,0,0,,Уф... Жеңдер, жеңдер
Dialogue: 0,1:06:38.07,1:06:39.82,Default,,0,0,0,,Айыптау жалыны (Condem Blaze)!
Dialogue: 0,1:06:40.70,1:06:43.24,Default,,0,0,0,,Ол қолды жеме!
Dialogue: 0,1:06:45.16,1:06:46.79,Default,,0,0,0,,– деді Джосукэ Хигасиката. Гү…
Dialogue: 0,1:06:47.42,1:06:49.83,Default,,0,0,0,,Тыңда, Саймон, ұмытпа.
Dialogue: 0,1:06:50.33,1:06:51.71,Default,,0,0,0,,Саған сену
Dialogue: 0,1:06:52.21,1:06:54.30,Default,,0,0,0,,Мен сенетін адам сен емессің
Dialogue: 0,1:06:54.38,1:06:56.30,Default,,0,0,0,,Мен тіпті сенбейтін адам емеспін
Dialogue: 0,1:06:56.80,1:07:00.05,Default,,0,0,0,,Кімге сенетініңізге сеніңіз.
Dialogue: 0,1:07:01.05,1:07:02.26,Default,,0,0,0,,А... ағайын?
Dialogue: 0,1:07:04.52,1:07:06.64,Default,,0,0,0,,Өлім!
Dialogue: 0,1:07:14.94,1:07:17.53,Default,,0,0,0,,Гига…
Dialogue: 0,1:07:18.65,1:07:21.45,Default,,0,0,0,,Бұрғылау…
Dialogue: 0,1:07:22.03,1:07:25.87,Default,,0,0,0,,Үзіліс!
Dialogue: 0,1:07:26.37,1:07:30.33,Default,,0,0,0,,Аһ!
Dialogue: 0,1:07:33.84,1:07:34.84,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:07:45.72,1:07:48.10,Default,,0,0,0,,Абайо Дачико
Dialogue: 0,1:07:48.60,1:07:49.23,Default,,0,0,0,,Хмм...
Dialogue: 0,1:07:50.73,1:07:51.77,Default,,0,0,0,,Үлкен аға?
Dialogue: 0,1:07:53.19,1:07:54.61,Default,,0,0,0,,Жоқ, біз бұлай істей алмаймыз!
Dialogue: 0,1:08:11.46,1:08:13.83,Default,,0,0,0,,Сол күні біз
Dialogue: 0,1:08:14.46,1:08:17.17,Default,,0,0,0,,Орны толтырылмайтын нәрсені жоғалтты
Dialogue: 0,1:08:34.73,1:08:35.86,Default,,0,0,0,,Құрметті Адина
Dialogue: 0,1:08:35.94,1:08:39.11,Default,,0,0,0,,Аспандағы төрт патшаның барлығына сұрыптауға бұйрық берілгенін естідім.
Dialogue: 0,1:08:39.82,1:08:41.20,Default,,0,0,0,,Мен де...
Dialogue: 0,1:08:41.28,1:08:41.95,Default,,0,0,0,,Уф!
Dialogue: 0,1:08:45.24,1:08:46.78,Default,,0,0,0,,А... Адин ханым?
Dialogue: 0,1:08:46.87,1:08:49.25,Default,,0,0,0,,Жүр, мен сені тыңдаймын.
Dialogue: 0,1:08:50.66,1:08:51.83,Default,,0,0,0,,Мен де...
Dialogue: 0,1:08:51.91,1:08:52.54,Default,,0,0,0,,Аһ!
Dialogue: 0,1:08:53.62,1:08:54.21,Default,,0,0,0,,Уф!
Dialogue: 0,1:08:54.79,1:08:57.63,Default,,0,0,0,,Әскерлерге... Уф! Мен қостым...
Dialogue: 0,1:08:57.71,1:08:59.17,Default,,0,0,0,,Мен мұны қалаймын ...
Dialogue: 0,1:08:59.67,1:09:00.92,Default,,0,0,0,,Тайто... Уау!
Dialogue: 0,1:09:01.51,1:09:04.18,Default,,0,0,0,,Мен Тимилфке бір нәрсе қарыз едім.
Dialogue: 0,1:09:04.26,1:09:07.14,Default,,0,0,0,,Адам сияқты өлтірілу - ұят.
Dialogue: 0,1:09:07.22,1:09:10.18,Default,,0,0,0,,Менің көңілім қалды! Ол үшін де, сіз үшін де.
Dialogue: 0,1:09:10.27,1:09:13.19,Default,,0,0,0,,Сондықтан менің де кек алуға мүмкіндігім бар...
Dialogue: 0,1:09:13.69,1:09:15.81,Default,,0,0,0,,Спиральды патшаға алғыс айту керек.
Dialogue: 0,1:09:15.90,1:09:19.11,Default,,0,0,0,,Саған бір Дайгун беретін сияқты.
Dialogue: 0,1:09:19.78,1:09:23.24,Default,,0,0,0,,Бірақ мені ұстама!
Dialogue: 0,1:09:35.67,1:09:37.54,Default,,0,0,0,,Жаңбыр көп жауады.
Dialogue: 0,1:09:37.63,1:09:38.88,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,1:09:38.96,1:09:40.25,Default,,0,0,0,,7 күн болды ма?
Dialogue: 0,1:09:50.60,1:09:52.60,Default,,0,0,0,,Мен бұған әлі сенбеймін.
Dialogue: 0,1:09:56.10,1:09:57.06,Default,,0,0,0,,Иә
Dialogue: 0,1:10:10.08,1:10:10.99,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:10:16.37,1:10:18.67,Default,,0,0,0,,Өйткені, тек Китан бар.
Dialogue: 0,1:10:18.75,1:10:20.04,Default,,0,0,0,,Біз
Dialogue: 0,1:10:20.13,1:10:23.71,Default,,0,0,0,,Әу баста оның айқайынан олар жиналды.
Dialogue: 0,1:10:23.80,1:10:25.84,Default,,0,0,0,,Саймон сенімсіз.
Dialogue: 0,1:10:25.93,1:10:27.34,Default,,0,0,0,,Мына қызықсыз жігіт
Dialogue: 0,1:10:27.43,1:10:29.64,Default,,0,0,0,,Мен Лаганнды жылжыта алатындықтан.
Dialogue: 0,1:10:30.22,1:10:32.77,Default,,0,0,0,,Сондай ащы адам басшы болып кетсе ше?
Dialogue: 0,1:10:32.85,1:10:34.43,Default,,0,0,0,,Гленн командасы аяқталды.
Dialogue: 0,1:10:34.52,1:10:35.35,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:35.94,1:10:37.35,Default,,0,0,0,,- (Йоко) Дайгурэн-дан - (Зоши) Ху...
Dialogue: 0,1:10:37.44,1:10:40.81,Default,,0,0,0,,Гленн командасы емес, Дай-Гуррен командасы.
Dialogue: 0,1:10:50.41,1:10:52.83,Default,,0,0,0,,Мен саған 10 рет қайтарамын дедім.
Dialogue: 0,1:10:52.91,1:10:57.00,Default,,0,0,0,,Менің жүрегімді 10 есе көп тесіңіз... Нені айтасыз?
Dialogue: 0,1:10:57.58,1:10:58.58,Default,,0,0,0,,Бакакамина
Dialogue: 0,1:11:02.25,1:11:05.84,Default,,0,0,0,,(Дабыл сигналы)
Dialogue: 0,1:11:05.92,1:11:06.97,Default,,0,0,0,,Қарулы адамдар табылды!
Dialogue: 0,1:11:07.05,1:11:09.05,Default,,0,0,0,,Ол сізге алдыңғы оң жақтан келе жатыр.
Dialogue: 0,1:11:09.13,1:11:11.01,Default,,0,0,0,,Мен ренжігенді жек көремін!
Dialogue: 0,1:11:11.10,1:11:13.06,Default,,0,0,0,,Мен Гленнге мінемін.
Dialogue: 0,1:11:13.14,1:11:14.39,Default,,0,0,0,,Өтінемін, Россиу.
Dialogue: 0,1:11:14.47,1:11:16.64,Default,,0,0,0,,Саймон мырза... Саймон мырза ше?
Dialogue: 0,1:11:18.23,1:11:20.52,Default,,0,0,0,,Сен мініп барасың ба, Росиу?
Dialogue: 0,1:11:21.52,1:11:25.28,Default,,0,0,0,,Мен сені жаттықтырып жатырмын. Мен сені жалғыз қалдыра алмаймын.
Dialogue: 0,1:11:27.19,1:11:28.40,Default,,0,0,0,,Мен түсіндім...
Dialogue: 0,1:11:40.79,1:11:43.17,Default,,0,0,0,,Саймон мырза, сіз тым итермеледіңіз!
Dialogue: 0,1:11:43.25,1:11:46.63,Default,,0,0,0,,Бірінші қадам – жеңіске кепілдік беріледі! Менің ағам осылай істейтін еді!
Dialogue: 0,1:11:49.17,1:11:52.14,Default,,0,0,0,,Ах... шығысы тұрақсыз.
Dialogue: 0,1:11:59.81,1:12:02.10,Default,,0,0,0,,Мынау мынау! Мынау мынау!
Dialogue: 0,1:12:02.19,1:12:02.69,Default,,0,0,0,,Уф...
Dialogue: 0,1:12:05.19,1:12:06.03,Default,,0,0,0,,Уау!
Dialogue: 0,1:12:06.11,1:12:06.98,Default,,0,0,0,,Еш қағыспа!
Dialogue: 0,1:12:07.07,1:12:09.90,Default,,0,0,0,,Үлкен аға айқайламады!
Dialogue: 0,1:12:11.95,1:12:14.03,Default,,0,0,0,,Саймон, сабыр ет!
Dialogue: 0,1:12:14.12,1:12:17.24,Default,,0,0,0,,Осылай ұрыссаң, келесі жолы...
Dialogue: 0,1:12:17.91,1:12:19.33,Default,,0,0,0,,Үлкен аға қашпайды
Dialogue: 0,1:12:19.41,1:12:20.46,Default,,0,0,0,,Егер сен менің ағам болсаң...
Dialogue: 0,1:12:20.54,1:12:23.25,Default,,0,0,0,,Егер сен менің ағам болсаң!
Dialogue: 0,1:12:26.80,1:12:30.84,Default,,0,0,0,,Уау!
Dialogue: 0,1:12:48.07,1:12:49.23,Default,,0,0,0,,Buha!
Dialogue: 0,1:12:52.65,1:12:54.49,Default,,0,0,0,,Не болды? Саймон!
Dialogue: 0,1:12:58.37,1:13:00.37,Default,,0,0,0,,Кері ағып жатқан энергия?
Dialogue: 0,1:13:03.21,1:13:04.58,Default,,0,0,0,,... жаттығу жасаңыз!
Dialogue: 0,1:13:13.68,1:13:14.22,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:16.10,1:13:18.76,Default,,0,0,0,,Не? Күте тұрыңыз! Эй!
Dialogue: 0,1:13:20.85,1:13:22.89,Default,,0,0,0,,Росиу! Сенімен бәрі жақсы ма?
Dialogue: 0,1:13:22.98,1:13:24.44,Default,,0,0,0,,Не болды, Росиу!
Dialogue: 0,1:13:24.52,1:13:27.36,Default,,0,0,0,,Сосын кенеттен Лаганн бөлініп кетті...
Dialogue: 0,1:13:27.44,1:13:28.32,Default,,0,0,0,,Ол құлады ма?
Dialogue: 0,1:13:28.82,1:13:31.78,Default,,0,0,0,,Россиуды жалғыз қалдырып, жаудың алдынан қашу?
Dialogue: 0,1:13:31.86,1:13:34.20,Default,,0,0,0,,Раган бақылаудан шығып кеткендей болды.
Dialogue: 0,1:13:34.28,1:13:37.24,Default,,0,0,0,,Қашқын ба? Бұл рас па?
Dialogue: 0,1:13:37.32,1:13:38.28,Default,,0,0,0,,Онда тас, қағаз, қайшы ойнайық.
Dialogue: 0,1:13:38.78,1:13:39.79,Default,,0,0,0,,Саймон…
Dialogue: 0,1:13:50.96,1:13:51.84,Default,,0,0,0,,Хмм...
Dialogue: 0,1:13:59.97,1:14:01.60,Default,,0,0,0,,Неліктен бақылау...
Dialogue: 0,1:14:05.48,1:14:06.15,Default,,0,0,0,,(Ойын музыкасы ұялы телефоннан ойнап тұр)
Dialogue: 0,1:14:25.66,1:14:27.33,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:14:31.38,1:14:32.09,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:15.55,1:15:16.55,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:29.60,1:15:31.23,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:42.82,1:15:43.70,Default,,0,0,0,,Ах!
Dialogue: 0,1:15:44.87,1:15:45.70,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:50.62,1:15:52.58,Default,,0,0,0,,Я... Қайырлы күн.
Dialogue: 0,1:15:52.67,1:15:55.05,Default,,0,0,0,,Go…goki…gokigen?
Dialogue: 0,1:15:55.92,1:15:57.55,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:15:57.63,1:16:01.68,Default,,0,0,0,,Уа, ау... Кім жақсы?
Dialogue: 0,1:16:01.76,1:16:04.26,Default,,0,0,0,,Ах! Бұл сыртта
Dialogue: 0,1:16:05.18,1:16:06.22,Default,,0,0,0,,Бұл жаңбыр
Dialogue: 0,1:16:09.73,1:16:10.60,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:11.10,1:16:12.06,Default,,0,0,0,,(қону дыбысы)
Dialogue: 0,1:16:13.40,1:16:16.02,Default,,0,0,0,,Суық... Бұл не?
Dialogue: 0,1:16:16.73,1:16:20.07,Default,,0,0,0,,Бұл топырақ... жарайды ма? Жалаң аяқ
Dialogue: 0,1:16:20.15,1:16:25.08,Default,,0,0,0,,Суық, лай-батпақты, оған жабысып тұрғанда жақсы сезіледі.
Dialogue: 0,1:16:25.58,1:16:27.45,Default,,0,0,0,,Сезім... жарай ма?
Dialogue: 0,1:16:28.20,1:16:30.25,Default,,0,0,0,,Уф... аа!
Dialogue: 0,1:16:31.16,1:16:34.75,Default,,0,0,0,,Сен неге мен сияқтысың?
Dialogue: 0,1:16:34.84,1:16:35.54,Default,,0,0,0,,А...
Dialogue: 0,1:16:35.63,1:16:38.55,Default,,0,0,0,,Құйрық, азу, қабыршақ жоқ.
Dialogue: 0,1:16:38.63,1:16:41.01,Default,,0,0,0,,Сіздің теріңіз де жұмсақ.
Dialogue: 0,1:16:41.09,1:16:44.89,Default,,0,0,0,,Дұрыс, өйткені мен адаммын.
Dialogue: 0,1:16:44.97,1:16:45.97,Default,,0,0,0,,Адам?
Dialogue: 0,1:16:46.05,1:16:49.06,Default,,0,0,0,,Иә, адамдар...адамдар, адамдар.
Dialogue: 0,1:16:50.81,1:16:53.44,Default,,0,0,0,,Адам дегеніміз не?
Dialogue: 0,1:16:53.52,1:16:54.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:54.77,1:16:58.36,Default,,0,0,0,,Міне, адамдар да біз сияқты...
Dialogue: 0,1:16:58.44,1:17:00.82,Default,,0,0,0,,Осылай киінген оның беті...
Dialogue: 0,1:17:00.90,1:17:02.28,Default,,0,0,0,,Басқалары бар ма?
Dialogue: 0,1:17:02.36,1:17:05.49,Default,,0,0,0,,А-а... иә, мен бармын.
Dialogue: 0,1:17:05.57,1:17:06.78,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:17:06.87,1:17:09.49,Default,,0,0,0,,Бәрі сенікімен бірдей ме?
Dialogue: 0,1:17:09.58,1:17:11.41,Default,,0,0,0,,Олардың беттері бірдей ме?
Dialogue: 0,1:17:11.50,1:17:13.25,Default,,0,0,0,,Бұл бірдей емес
Dialogue: 0,1:17:13.33,1:17:15.75,Default,,0,0,0,,Бетіміз бірдей болса, жиіркенішті болар еді
Dialogue: 0,1:17:16.25,1:17:18.88,Default,,0,0,0,,Сізге ыңғайсыз ба?
Dialogue: 0,1:17:18.96,1:17:21.59,Default,,0,0,0,,А, жаңбыр басылды.
Dialogue: 0,1:17:22.84,1:17:26.09,Default,,0,0,0,,Иә? Аа, бұл рас
Dialogue: 0,1:17:30.14,1:17:33.44,Default,,0,0,0,,Мен неге сырттамын?
Dialogue: 0,1:17:33.52,1:17:36.36,Default,,0,0,0,,Не? Жоқ, неге...
Dialogue: 0,1:17:36.44,1:17:38.90,Default,,0,0,0,,Ал... Мен бәрібір бұл жерден кетуім керек.
Dialogue: 0,1:17:38.98,1:17:40.98,Default,,0,0,0,,-Бұл... -Иә?
Dialogue: 0,1:17:41.07,1:17:42.82,Default,,0,0,0,,Бұлай жүре алмайсың.
Dialogue: 0,1:17:42.90,1:17:43.95,Default,,0,0,0,,Мынаны киіңіз
Dialogue: 0,1:17:44.03,1:17:44.82,Default,,0,0,0,,Иә
Dialogue: 0,1:17:49.24,1:17:51.33,Default,,0,0,0,,Мен Ниамын. Сен ше?
Dialogue: 0,1:17:51.41,1:17:54.29,Default,,0,0,0,,О, мен? Мен Саймонмын
Dialogue: 0,1:17:54.87,1:17:57.88,Default,,0,0,0,,Саймон, бұл жақсы есім.
Dialogue: 0,1:18:00.13,1:18:01.71,Default,,0,0,0,,Рахмет
Dialogue: 0,1:18:01.80,1:18:02.84,Default,,0,0,0,,Сәлем Саймон
Dialogue: 0,1:18:02.92,1:18:03.47,Default,,0,0,0,,Не?
Dialogue: 0,1:18:03.55,1:18:05.34,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:18:05.43,1:18:05.93,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:06.01,1:18:07.26,Default,,0,0,0,,Уау!
Dialogue: 0,1:18:07.34,1:18:08.39,Default,,0,0,0,,Уф!
Dialogue: 0,1:18:08.47,1:18:09.93,Default,,0,0,0,,Тез, мұнда кел!
Dialogue: 0,1:18:10.93,1:18:12.31,Default,,0,0,0,,Хехехе
Dialogue: 0,1:18:12.39,1:18:14.89,Default,,0,0,0,,Саймон Бұл не?
Dialogue: 0,1:18:14.98,1:18:15.77,Default,,0,0,0,,Қарулы адамдар!
Dialogue: 0,1:18:15.85,1:18:19.31,Default,,0,0,0,,Сол жігіттер жердегі барлық адамдарды нысанаға алады.
Dialogue: 0,1:18:19.40,1:18:22.03,Default,,0,0,0,,Сондықтан біз олармен күресіп жатырмыз.
Dialogue: 0,1:18:22.11,1:18:22.73,Default,,0,0,0,,Ұрыс?
Dialogue: 0,1:18:22.82,1:18:24.69,Default,,0,0,0,,Соғыспасаң, өлтіресің!
Dialogue: 0,1:18:25.90,1:18:27.24,Default,,0,0,0,,Раганнан сұраңыз
Dialogue: 0,1:18:29.07,1:18:29.70,Default,,0,0,0,,Иә!
Dialogue: 0,1:18:29.78,1:18:32.29,Default,,0,0,0,,Ух...хех!
Dialogue: 0,1:18:33.25,1:18:34.37,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:18:36.29,1:18:38.83,Default,,0,0,0,,Уууу!
Dialogue: 0,1:18:39.84,1:18:41.29,Default,,0,0,0,,Гах гах...
Dialogue: 0,1:18:41.88,1:18:43.13,Default,,0,0,0,,Иә? Хехе
Dialogue: 0,1:18:50.14,1:18:52.10,Default,,0,0,0,,Саймон! Жарайды?
Dialogue: 0,1:18:52.18,1:18:53.77,Default,,0,0,0,,Боқ... тағы да.
Dialogue: 0,1:18:53.85,1:18:57.73,Default,,0,0,0,,Неге... неге мені тыңдамайсың?
Dialogue: 0,1:18:57.81,1:18:58.81,Default,,0,0,0,,Лаган!
Dialogue: 0,1:19:03.57,1:19:05.11,Default,,0,0,0,,Жүгір, Ниа
Dialogue: 0,1:19:05.86,1:19:06.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:06.78,1:19:09.78,Default,,0,0,0,,Бір рет жүгірсең, артыңа қарамай қаш.
Dialogue: 0,1:19:10.28,1:19:12.12,Default,,0,0,0,,Мен зеңбірекшілерді тоқтатамын.
Dialogue: 0,1:19:12.70,1:19:13.24,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:19:13.33,1:19:16.58,Default,,0,0,0,,Олар менің жақын адамдарымды өлтіреді
Dialogue: 0,1:19:17.08,1:19:19.75,Default,,0,0,0,,Әкесі, анасы және ағасы да.
Dialogue: 0,1:19:20.33,1:19:22.71,Default,,0,0,0,,Маған ұнамайды! Мен енді адамдардың өлгенін көргім келмейді
Dialogue: 0,1:19:23.42,1:19:26.63,Default,,0,0,0,,Маған басқа біреу өлсе бәрібір!
Dialogue: 0,1:19:27.72,1:19:29.34,Default,,0,0,0,,Гухаа~
Dialogue: 0,1:19:34.68,1:19:36.27,Default,,0,0,0,,Өлгің келе ме?
Dialogue: 0,1:19:36.35,1:19:37.43,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:37.52,1:19:41.06,Default,,0,0,0,,Қорықсаң, қаш. Өлме.
Dialogue: 0,1:19:41.15,1:19:43.36,Default,,0,0,0,,Бұл... қорқынышты...
Dialogue: 0,1:19:43.44,1:19:45.11,Default,,0,0,0,,Өтірік айтпа
Dialogue: 0,1:19:46.07,1:19:48.90,Default,,0,0,0,,Екеуміз бірге қашайық
Dialogue: 0,1:19:48.99,1:19:49.61,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:55.87,1:19:56.50,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:19:57.58,1:19:58.83,Default,,0,0,0,,Басқа ешкім...
Dialogue: 0,1:19:59.62,1:20:00.75,Default,,0,0,0,,Мен сенің өлуге жол бермеймін!
Dialogue: 0,1:20:01.42,1:20:02.71,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:20:03.71,1:20:05.63,Default,,0,0,0,,Мен де осындамын!
Dialogue: 0,1:20:05.71,1:20:08.26,Default,,0,0,0,,Китан Стингер!
Dialogue: 0,1:20:08.97,1:20:12.51,Default,,0,0,0,,Миыңды тозақтан жұлып ал!
Dialogue: 0,1:20:12.59,1:20:13.64,Default,,0,0,0,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,1:20:15.39,1:20:17.22,Default,,0,0,0,,Сіз қалай ойлайсыз? Ол шешілді.
Dialogue: 0,1:20:26.90,1:20:28.99,Default,,0,0,0,,Барлығыңызбен танысқаныма қуаныштымын.
Dialogue: 0,1:20:29.07,1:20:30.95,Default,,0,0,0,,Менің атым Ниа
Dialogue: 0,1:20:31.03,1:20:33.62,Default,,0,0,0,,Ол спираль патша Лоргеномның бірінші ханшайымы.
Dialogue: 0,1:20:34.12,1:20:35.78,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,1:20:36.79,1:20:38.50,Default,,0,0,0,,Не?
Dialogue: 0,1:20:38.58,1:20:40.91,Default,,0,0,0,,Спираль патшасы жаудың бастығы, солай ма?
Dialogue: 0,1:20:41.00,1:20:41.75,Default,,0,0,0,,
Dialogue: 0,1:20:41.83,1:20:43.54,Default,,0,0,0,,Әй, бұл жау, бұл жау.
Dialogue: 0,1:20:43.63,1:20:45.04,Default,,0,0,0,,Жаудың қызы!
Dialogue: 0,1:20:45.13,1:20:46.84,Default,,0,0,0,,Ол қашып кеткен Симонның серігі.
Dialogue: 0,1:20:46.92,1:20:47.96,Default,,0,0,0,,Сіз шпионсыз ба?
Dialogue: 0,1:20:48.46,1:20:49.84,Default,,0,0,0,,Бірақ сүйкімді
Dialogue: 0,1:20:50.38,1:20:54.72,Default,,0,0,0,,Сәлем! Бұл туралы толығырақ айтып берейін.
Dialogue: 0,1:20:56.26,1:20:57.18,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,1:20:57.97,1:20:59.64,Default,,0,0,0,,- (Gimme) Itadakimasu! -(Далли) Итадакимасу
Dialogue: 0,1:21:00.39,1:21:02.10,Default,,0,0,0,,Дәмді! Уми
Dialogue: 0,1:21:02.19,1:21:04.77,Default,,0,0,0,,- (Далли) Мынаны ал - Иә, иә.
Dialogue: 0,1:21:05.40,1:21:08.44,Default,,0,0,0,,Бұл өте дәмді! Рахмет ата
Dialogue: 0,1:21:08.53,1:21:09.36,Default,,0,0,0,,Хмм
Dialogue: 0,1:21:10.15,1:21:12.20,Default,,0,0,0,,...Сәлем!
Dialogue: 0,1:21:12.74,1:21:16.70,Default,,0,0,0,,Ей, ақымақтар! Неге сіз достық кешкі ас ішіп жатырсыз?
Dialogue: 0,1:21:16.78,1:21:18.99,Default,,0,0,0,,Ондай қонақжайлылық жақсы.
Dialogue: 0,1:21:19.08,1:21:22.54,Default,,0,0,0,,Менің ойымша, сіз мұнда мені жауап алу үшін келдіңіз, бірақ мені жауап алу үшін!
Dialogue: 0,1:21:23.58,1:21:24.33,Default,,0,0,0,,Фу…
Dialogue: 0,1:21:25.67,1:21:28.84,Default,,0,0,0,,Ол өте жігерлі адам.
Dialogue: 0,1:21:28.92,1:21:30.38,Default,,0,0,0,,Ха!
Dialogue: 0,1:21:30.46,1:21:31.26,Default,,0,0,0,,Хмм...
Dialogue: 0,1:21:31.34,1:21:33.88,Default,,0,0,0,,Эй, мен Китанмын!
Dialogue: 0,1:21:33.97,1:21:37.60,Default,,0,0,0,,Ол Қара ағайындылардың үлкені және қазіргі уақытта Гленн командасының жын жетекшісі.
Dialogue: 0,1:21:37.68,1:21:40.56,Default,,0,0,0,,Құрметпен, Китан-сан
Dialogue: 0,1:21:40.64,1:21:42.89,Default,,0,0,0,,Уф... Эй!
Dialogue: 0,1:21:42.98,1:21:46.77,Default,,0,0,0,,Жүзің сондай сүйкімді болса да, шын мәнінде сен жаудың әйелісің!
Dialogue: 0,1:21:46.86,1:21:48.86,Default,,0,0,0,,- (Джоган) Иә - (Баринбо) Иә.
Dialogue: 0,1:21:48.94,1:21:49.98,Default,,0,0,0,,Жау! Жау!
Dialogue: 0,1:21:50.07,1:21:50.78,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,1:21:50.86,1:21:53.74,Default,,0,0,0,,Китан-сан, Теки деген не?
Dialogue: 0,1:21:54.65,1:21:59.58,Default,,0,0,0,,Жарайды... жау – жаман адам, жеңгісі келетін адам.
Dialogue: 0,1:21:59.66,1:22:01.83,Default,,0,0,0,,Буттаос дегеніміз не?
Dialogue: 0,1:22:02.58,1:22:04.50,Default,,0,0,0,,Біреуді ұру деген осы...
Dialogue: 0,1:22:04.58,1:22:07.42,Default,,0,0,0,,Жерге теуіп, жұдырықпен ұр...
Dialogue: 0,1:22:07.50,1:22:08.75,Default,,0,0,0,,Генкоцу дегеніміз не?
Dialogue: 0,1:22:08.84,1:22:10.59,Default,,0,0,0,,Мен жауап алуды ойладым...
Dialogue: 0,1:22:10.67,1:22:12.84,Default,,0,0,0,,Керісінше, мені сұрақтар жаулап алады.
Dialogue: 0,1:22:12.92,1:22:15.68,Default,,0,0,0,,Бауырым, маған ондай адам ұнамайды.
Dialogue: 0,1:22:15.76,1:22:17.09,Default,,0,0,0,,- Урухи! -Апыр-ай!
Dialogue: 0,1:22:17.18,1:22:22.14,Default,,0,0,0,,Китан мырза, сіз жігерлі ғана емес, сонымен қатар өте мейірімдісіз.
Dialogue: 0,1:22:22.22,1:22:24.64,Default,,0,0,0,,Маған көп нәрсені үйреткеніңіз үшін рахмет.
Dialogue: 0,1:22:24.73,1:22:26.81,Default,,0,0,0,,Ал... жарайды (топ мүшелері) хахахаха
Dialogue: 0,1:22:26.90,1:22:30.15,Default,,0,0,0,,Спираль патшаның қызы? Ол жаман қызға ұқсамайды, бірақ...
Dialogue: 0,1:22:30.23,1:22:32.78,Default,,0,0,0,,Саймонмен бірге алқапта маған қарулы адамдар шабуыл жасады.
Dialogue: 0,1:22:32.86,1:22:34.36,Default,,0,0,0,,Бұл сөзсіз
Dialogue: 0,1:22:34.44,1:22:37.03,Default,,0,0,0,,Хм, күтейік, не болатынын көрейік.
Dialogue: 0,1:22:37.66,1:22:41.41,Default,,0,0,0,,(Сүйретілген тастардың дыбысы)
Dialogue: 0,1:22:41.49,1:22:42.16,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:54.63,1:22:57.43,Default,,0,0,0,,Жақсысың ба, Саймон?
Dialogue: 0,1:22:57.51,1:23:00.18,Default,,0,0,0,,Мүмкін сіз басқа біреу туралы алаңдасаңыз.
Dialogue: 0,1:23:00.68,1:23:04.10,Default,,0,0,0,,Маған бәрібір, мына Дайгүрен көшуі керек.
Dialogue: 0,1:23:04.18,1:23:06.27,Default,,0,0,0,,Мен жай ғана жылай алмаймын
Dialogue: 0,1:23:06.77,1:23:08.98,Default,,0,0,0,,Бірақ Саймонның жағдайында...
Dialogue: 0,1:23:10.31,1:23:12.52,Default,,0,0,0,,Біз бәріміз бір нәрсемен күресіп жатырмыз.
Dialogue: 0,1:23:12.61,1:23:14.15,Default,,0,0,0,,Сіз де, солай ма?
Dialogue: 0,1:23:14.65,1:23:15.36,Default,,0,0,0,,Иә
Dialogue: 0,1:23:15.94,1:23:18.36,Default,,0,0,0,,Сонымен қатар, Лаган қозғалмайды.
Dialogue: 0,1:23:18.45,1:23:21.83,Default,,0,0,0,,Тірі қалуға ниеті жоқ балаға күшіңді бергің келмесе.
Dialogue: 0,1:23:21.91,1:23:24.49,Default,,0,0,0,,Менің ойымша, бұл дұрыс емес.
Dialogue: 0,1:23:33.75,1:23:36.17,Default,,0,0,0,,Бұл адам Аники мырза ма?
Dialogue: 0,1:23:36.26,1:23:36.76,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:37.80,1:23:41.01,Default,,0,0,0,,Мен сенімен сөйлескім келеді.
Dialogue: 0,1:23:43.01,1:23:45.35,Default,,0,0,0,,Барлығынан естідік.
Dialogue: 0,1:23:45.43,1:23:49.23,Default,,0,0,0,,Менің әкем саған қандай сұмдық жасады?
Dialogue: 0,1:23:49.31,1:23:51.35,Default,,0,0,0,,Жек көруден пайда жоқ.
Dialogue: 0,1:23:51.44,1:23:52.31,Default,,0,0,0,,Жақын…
Dialogue: 0,1:23:52.40,1:23:53.69,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:23:54.19,1:23:58.82,Default,,0,0,0,,Сен сондай мейірімдісің, неге әкең сені өлтіргісі келеді?
Dialogue: 0,1:23:59.90,1:24:03.87,Default,,0,0,0,,Саймон соншалықты күшті, ол неге өлгісі келеді?
Dialogue: 0,1:24:03.95,1:24:05.45,Default,,0,0,0,,Күшті емес
Dialogue: 0,1:24:05.54,1:24:07.58,Default,,0,0,0,,Мен мүлде күшті емеспін...
Dialogue: 0,1:24:08.37,1:24:09.50,Default,,0,0,0,,Өте жақсы
Dialogue: 0,1:24:09.58,1:24:10.46,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:10.54,1:24:12.46,Default,,0,0,0,,Оны пішінге келтіру арқылы түсінуге болады.
Dialogue: 0,1:24:12.54,1:24:15.67,Default,,0,0,0,,Саймон бұл адамды жақсы көреді.
Dialogue: 0,1:24:17.30,1:24:19.38,Default,,0,0,0,,Кешіріңіз, Саймон.
Dialogue: 0,1:24:19.88,1:24:21.93,Default,,0,0,0,,Бұл Нианың кешірім сұрауы туралы емес.
Dialogue: 0,1:24:22.01,1:24:25.18,Default,,0,0,0,,Бәлкім, сенің де ағаң мұны қаламайтын шығар.
Dialogue: 0,1:24:25.26,1:24:28.35,Default,,0,0,0,,Жақсы айта алмаймын, бірақ ағам үнемі күліп жүретін.
Dialogue: 0,1:24:28.85,1:24:31.39,Default,,0,0,0,,Қанша қиын болса да, алға қарап күлдім.
Dialogue: 0,1:24:31.48,1:24:32.94,Default,,0,0,0,,Алға күту...
Dialogue: 0,1:24:33.73,1:24:35.44,Default,,0,0,0,,Мен Йокомен танысқанда көп болды.
Dialogue: 0,1:24:35.52,1:24:38.69,Default,,0,0,0,,Балалар жер асты ауылынан өздері қашып кетпек болды.
Dialogue: 0,1:24:38.78,1:24:41.78,Default,,0,0,0,,Бірақ жер сілкінісі болды, мен құрсауда қалдым...
Dialogue: 0,1:24:41.86,1:24:43.41,Default,,0,0,0,,- (Йоко) Бұл туралы... - А?
Dialogue: 0,1:24:43.49,1:24:44.91,Default,,0,0,0,,Жоқ, жалғастырыңыз.
Dialogue: 0,1:24:45.66,1:24:48.87,Default,,0,0,0,,Мен әкем мен шешем сияқтымын.
Dialogue: 0,1:24:48.95,1:24:51.46,Default,,0,0,0,,Мен жерленіп өлемін деп қорықтым.
Dialogue: 0,1:24:52.21,1:24:56.75,Default,,0,0,0,,Бірақ ағам бізді жігерлендіріп, алға ұмтылу керектігін айтты.
Dialogue: 0,1:24:57.46,1:24:58.84,Default,,0,0,0,,Күліп тұрғанда
Dialogue: 0,1:24:59.88,1:25:01.97,Default,,0,0,0,,Менің қолым дірілдеп қалды.
Dialogue: 0,1:25:02.63,1:25:04.51,Default,,0,0,0,,Қайтадан қазылды
Dialogue: 0,1:25:05.64,1:25:09.06,Default,,0,0,0,,Сол кезде ағам бас тартса, өліп қалар едік.
Dialogue: 0,1:25:09.68,1:25:11.35,Default,,0,0,0,,Әрқашан солай болатын.
Dialogue: 0,1:25:11.43,1:25:13.27,Default,,0,0,0,,Өзімнен үлкен ағам бар болғандықтан, қолымнан келгенді істей алдым.
Dialogue: 0,1:25:14.02,1:25:16.73,Default,,0,0,0,,Мен болсам жақсы емес...
Dialogue: 0,1:25:16.82,1:25:18.19,Default,,0,0,0,,Сене сені сөккенде себептерін түсіндіремін.
Dialogue: 0,1:25:18.27,1:25:21.57,Default,,0,0,0,,Саймон жалғыз болса да маған көмектесті.
Dialogue: 0,1:25:22.11,1:25:23.36,Default,,0,0,0,,Біреуді қаншалықты жақсы көрсең де
Dialogue: 0,1:25:23.45,1:25:25.82,Default,,0,0,0,,Кеткен адамдар сізге көмектесе алмайды.
Dialogue: 0,1:25:26.49,1:25:27.16,Default,,0,0,0,,Мен білемін.
Dialogue: 0,1:25:27.74,1:25:32.96,Default,,0,0,0,,Сондықтан ағамнан айырылғанда мен де сол кісідей адам болғым келді.
Dialogue: 0,1:25:33.04,1:25:34.62,Default,,0,0,0,,Бірақ мен мұны істей алмаймын.
Dialogue: 0,1:25:34.71,1:25:37.59,Default,,0,0,0,,Бұл да басқа. Саймон - Саймон.
Dialogue: 0,1:25:38.17,1:25:39.21,Default,,0,0,0,,Аники-сан емес
Dialogue: 0,1:25:39.30,1:25:42.05,Default,,0,0,0,,Мәңгілік жоқ адамға тоқталма
Dialogue: 0,1:25:42.13,1:25:43.13,Default,,0,0,0,,Жақын…
Dialogue: 0,1:25:43.22,1:25:44.76,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,1:25:44.84,1:25:47.05,Default,,0,0,0,,Саймон туралы не білесіңдер?
Dialogue: 0,1:25:47.14,1:25:48.51,Default,,0,0,0,,Камина туралы не білесіңдер?
Dialogue: 0,1:25:48.60,1:25:51.98,Default,,0,0,0,,Бірақ Саймон мұның бәрін өз бетімен жасай алатын адам.
Dialogue: 0,1:25:52.06,1:25:55.02,Default,,0,0,0,,Саймон - Саймон, мұны өз қалауыңыз бойынша жасаңыз.
Dialogue: 0,1:25:55.56,1:25:56.98,Default,,0,0,0,,Бұл мүмкін емес, мен...
Dialogue: 0,1:25:57.81,1:26:01.19,Default,,0,0,0,,Неге бұлай сөйлеп тұрсың?
Dialogue: 0,1:26:01.28,1:26:03.74,Default,,0,0,0,,Каминаның өліміне кім себеп болғанын білесіз бе?
Dialogue: 0,1:26:03.82,1:26:06.28,Default,,0,0,0,,Бірақ бұл ақылға қонымды уағыз емес.
Dialogue: 0,1:26:07.03,1:26:09.28,Default,,0,0,0,,Сонда сіз нақты кімсіз?
Dialogue: 0,1:26:09.37,1:26:12.12,Default,,0,0,0,,Мен бе? Мен...
Dialogue: 0,1:26:13.08,1:26:14.16,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:20.55,1:26:22.80,Default,,0,0,0,,Мен де «неге» деп сұрадым.
Dialogue: 0,1:26:22.88,1:26:27.22,Default,,0,0,0,,Әкеңізден «Мен не үшін дүниеге келдім?» деп сұраңыз.
Dialogue: 0,1:26:28.18,1:26:30.97,Default,,0,0,0,,Келесі рет оянғанымда жерде жатырмын.
Dialogue: 0,1:26:31.47,1:26:34.06,Default,,0,0,0,,Алқап түбінде қорапқа салынған
Dialogue: 0,1:26:34.56,1:26:37.65,Default,,0,0,0,,Ал Симон маған көмектесті
Dialogue: 0,1:26:38.90,1:26:40.15,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:26:41.11,1:26:43.65,Default,,0,0,0,,Мен көбірек білгім келеді
Dialogue: 0,1:26:43.74,1:26:48.74,Default,,0,0,0,,Саймон туралы Йоко туралы Аники туралы Жер туралы
Dialogue: 0,1:26:50.12,1:26:51.49,Default,,0,0,0,,Мен көбірек білгім келеді
Dialogue: 0,1:26:52.16,1:26:53.12,Default,,0,0,0,,Уау!
Dialogue: 0,1:26:56.71,1:26:58.71,Default,,0,0,0,,Не болып жатыр? Ах!
Dialogue: 0,1:27:08.55,1:27:10.01,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:16.23,1:27:19.02,Default,,0,0,0,,Қашып құтыла алмайсыңдар, адамдар.
Dialogue: 0,1:27:19.94,1:27:20.69,Default,,0,0,0,,Жау шабуылы?
Dialogue: 0,1:27:20.77,1:27:21.77,Default,,0,0,0,,Бұл дауыс...
Dialogue: 0,1:27:25.07,1:27:27.82,Default,,0,0,0,,Бұл кеме Тимилфтің Дайганзаны.
Dialogue: 0,1:27:29.36,1:27:32.08,Default,,0,0,0,,Оған лас адамдарға қол тигізбеңіз!
Dialogue: 0,1:27:33.74,1:27:35.08,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:27:37.16,1:27:38.08,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:39.83,1:27:41.33,Default,,0,0,0,,Қош келдіңіз Адина
Dialogue: 0,1:27:41.42,1:27:42.09,Default,,0,0,0,,Ах!
Dialogue: 0,1:27:42.17,1:27:42.96,Default,,0,0,0,,- (Артенборо) Ах! -(Ли Рон) Не?
Dialogue: 0,1:27:43.04,1:27:43.96,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:45.21,1:27:49.13,Default,,0,0,0,,Бұл Спиральды король Лоргеномның бірінші ханшайымы Нианың өмірі.
Dialogue: 0,1:27:49.22,1:27:53.93,Default,,0,0,0,,Мен бұл адамдарға ешқандай зорлық-зомбылыққа жол бермеймін!
Dialogue: 0,1:27:54.01,1:27:58.10,Default,,0,0,0,,Әйтеуір... Ниа ханшайым неге мұнда...
Dialogue: 0,1:28:00.81,1:28:02.69,Default,,0,0,0,,Түсіндім, солай ма?
Dialogue: 0,1:28:03.48,1:28:05.23,Default,,0,0,0,,Адин, айтшы.
Dialogue: 0,1:28:05.32,1:28:07.32,Default,,0,0,0,,Шынымен сен бұл жер бетіндесің
Dialogue: 0,1:28:07.40,1:28:10.15,Default,,0,0,0,,Сіз адамдарды қинауға тырысасыз ба?
Dialogue: 0,1:28:14.58,1:28:18.62,Default,,0,0,0,,Иә, бұл Спираль патшасының бұйрығы.
Dialogue: 0,1:28:19.37,1:28:20.62,Default,,0,0,0,,Әкенің?
Dialogue: 0,1:28:21.12,1:28:21.96,Default,,0,0,0,,Спиральды патша
Dialogue: 0,1:28:22.04,1:28:26.05,Default,,0,0,0,,Мен жер бетінде пайда болған адамдардың өмір сүруіне шыдамаймын.
Dialogue: 0,1:28:26.55,1:28:28.72,Default,,0,0,0,,Біз, мақтаншақ аңдар,
Dialogue: 0,1:28:28.80,1:28:31.34,Default,,0,0,0,,Адам тәрізді қоқыс
Dialogue: 0,1:28:31.43,1:28:35.35,Default,,0,0,0,,Біздің міндетіміз – оны жер бетінен жою.
Dialogue: 0,1:28:35.43,1:28:36.47,Default,,0,0,0,,Қоқыс па?
Dialogue: 0,1:28:36.56,1:28:39.23,Default,,0,0,0,,Міне... адам қоқыс емес
Dialogue: 0,1:28:39.85,1:28:41.56,Default,,0,0,0,,Мен сенің әкеңмен сөйлескім келеді.
Dialogue: 0,1:28:41.64,1:28:44.06,Default,,0,0,0,,Мені әкеңе апар
Dialogue: 0,1:28:45.23,1:28:49.15,Default,,0,0,0,,Уайымдама, өз жолыңмен кете аласың!
Dialogue: 0,1:28:49.78,1:28:51.28,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:28:51.36,1:28:53.36,Default,,0,0,0,,Мен саған жақсы нәрсе айтайын.
Dialogue: 0,1:28:53.45,1:28:56.12,Default,,0,0,0,,Сен енді ханшайым да емессің.
Dialogue: 0,1:28:56.20,1:28:57.74,Default,,0,0,0,,Спираль патшасы тастап кеткен
Dialogue: 0,1:28:57.83,1:28:58.49,Default,,0,0,0,,Тастанды
Dialogue: 0,1:28:58.58,1:29:00.29,Default,,0,0,0,,Оны тастап кетті!
Dialogue: 0,1:29:01.58,1:29:05.88,Default,,0,0,0,,Мен сенің не істегеніңді білмеймін, бірақ сен маған енді керек емессің.
Dialogue: 0,1:29:05.96,1:29:10.76,Default,,0,0,0,,Мен бұл талғампаз леди Аддинді қоқыспен бірге алып тастаймын.
Dialogue: 0,1:29:10.84,1:29:14.05,Default,,0,0,0,,Тастанды ма? Саған керек емес пе?
Dialogue: 0,1:29:14.14,1:29:15.47,Default,,0,0,0,,Сенің әкең мен бе?
Dialogue: 0,1:29:16.30,1:29:18.97,Default,,0,0,0,,Тастанды ма? Сізге не қажет емес?
Dialogue: 0,1:29:19.06,1:29:19.93,Default,,0,0,0,,Жақын?
Dialogue: 0,1:29:20.81,1:29:22.98,Default,,0,0,0,,Бауырым, мен...
Dialogue: 0,1:29:24.60,1:29:25.40,Default,,0,0,0,,Мен...
Dialogue: 0,1:29:25.48,1:29:29.11,Default,,0,0,0,,Бұл өтірік. Әкеңнің мұндай әрекетке баруы мүмкін емес.
Dialogue: 0,1:29:29.19,1:29:31.53,Default,,0,0,0,,Сенгің келмесе сенудің қажеті жоқ.
Dialogue: 0,1:29:31.61,1:29:34.03,Default,,0,0,0,,Қалай болғанда да өлесің!
Dialogue: 0,1:29:35.28,1:29:36.78,Default,,0,0,0,,Уф… Ой, жоқ!
Dialogue: 0,1:29:36.87,1:29:38.12,Default,,0,0,0,,Мінекей!
Dialogue: 0,1:29:38.20,1:29:40.29,Default,,0,0,0,,Адина, күте тұрыңыз.
Dialogue: 0,1:29:40.37,1:29:43.62,Default,,0,0,0,,Хахахаха Ниа ханшайымның айқайы
Dialogue: 0,1:29:43.71,1:29:47.38,Default,,0,0,0,,Мен жасаған тамаша сахна соған лайық.
Dialogue: 0,1:29:47.46,1:29:53.22,Default,,0,0,0,,Осы құдай жылдамдығы Ситмандра-сама жасаған бос орындау платформасы деп аталатын кезең бар!
Dialogue: 0,1:29:53.30,1:29:54.13,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,1:29:54.22,1:29:57.26,Default,,0,0,0,,Да... Даглен үстіндегі аспандағы алып ұшатын зат!
Dialogue: 0,1:29:57.35,1:30:01.35,Default,,0,0,0,,Жерде сансыз қарулы және одан да ірілері болды...
Dialogue: 0,1:30:01.43,1:30:03.27,Default,,0,0,0,,Бұл жаппай соғыс па?
Dialogue: 0,1:30:04.06,1:30:06.94,Default,,0,0,0,,Мен қазіргі жағдайда Гуррен Лаганнға сене алмаймын!
Dialogue: 0,1:30:07.02,1:30:07.90,Default,,0,0,0,,Уф!
Dialogue: 0,1:30:08.98,1:30:09.65,Default,,0,0,0,,Чи…
Dialogue: 0,1:30:10.23,1:30:13.44,Default,,0,0,0,,Ху... Спираль патшасына қарсы шыққандар үлгі болады.
Dialogue: 0,1:30:13.53,1:30:15.15,Default,,0,0,0,,Бұл патшаның өсиеті.
Dialogue: 0,1:30:15.24,1:30:16.16,Default,,0,0,0,,Не? Не...
Dialogue: 0,1:30:16.24,1:30:17.87,Default,,0,0,0,,Бұл көпшілік алдында өлім жазасына кесу.
Dialogue: 0,1:30:18.53,1:30:20.66,Default,,0,0,0,,Жаңа ғана Дайганзанды басып алды
Dialogue: 0,1:30:20.74,1:30:26.33,Default,,0,0,0,,Спиральды патшаның әскерін жеңемін деп ойлайтын ақымақ адамдармен не болады?
Dialogue: 0,1:30:26.42,1:30:30.29,Default,,0,0,0,,Жер астында жасырынып жатқан барлық адамдарға көрсетіңіз
Dialogue: 0,1:30:30.38,1:30:35.22,Default,,0,0,0,,Ол менің туған қызым болса да, қажет болмаса, өшіремін.
Dialogue: 0,1:30:35.30,1:30:37.26,Default,,0,0,0,,Бұл спираль патшасы
Dialogue: 0,1:30:37.34,1:30:41.68,Default,,0,0,0,,Адамдар оның күшінен қорқып тұрсын.
Dialogue: 0,1:30:42.27,1:30:44.52,Default,,0,0,0,,Қалағаныңды айт
Dialogue: 0,1:30:44.60,1:30:47.27,Default,,0,0,0,,Адамдар мен биологиялық қыздарға қоқыс сияқты қарайды ма?
Dialogue: 0,1:30:47.35,1:30:48.94,Default,,0,0,0,,Ол жігіттерге ұнамайды.
Dialogue: 0,1:30:49.02,1:30:50.52,Default,,0,0,0,,О, маған ұнамайды!
Dialogue: 0,1:30:51.11,1:30:53.94,Default,,0,0,0,,Қара ағалардың шынайы рухын көрсетейін!
Dialogue: 0,1:30:54.03,1:30:56.99,Default,,0,0,0,,Мен өзімді аңшы аңшы деп бекер айтпаймын!
Dialogue: 0,1:30:57.07,1:30:59.57,Default,,0,0,0,,Дайглен шығысының критикалық деңгейі
Dialogue: 0,1:30:59.66,1:31:00.95,Default,,0,0,0,,Мұнда кез келген уақытта келуге болады.
Dialogue: 0,1:31:01.03,1:31:04.16,Default,,0,0,0,,Сен маған жақсы сөздер айтасың, Лейте.
Dialogue: 0,1:31:04.25,1:31:05.58,Default,,0,0,0,,Бізде мұны істеуден басқа амал жоқ.
Dialogue: 0,1:31:05.66,1:31:06.91,Default,,0,0,0,,- (Ли Рон) Даякка! -Жақсы.
Dialogue: 0,1:31:07.00,1:31:08.17,Default,,0,0,0,,Түсіндім, негізгі мылтық атылды!
Dialogue: 0,1:31:08.25,1:31:09.67,Default,,0,0,0,,-Ах! -Идиот, Ниа әлі осында...
Dialogue: 0,1:31:10.59,1:31:12.04,Default,,0,0,0,,Иә? Шықпа
Dialogue: 0,1:31:12.13,1:31:13.13,Default,,0,0,0,,Қанша адам келдіңдер? Төртеу ме?
Dialogue: 0,1:31:13.21,1:31:14.80,Default,,0,0,0,,Мен баладан бас тартпаймын.
Dialogue: 0,1:31:15.42,1:31:18.89,Default,,0,0,0,,Мына Шузаққа мұндай оқ тиімді ме?
Dialogue: 0,1:31:19.97,1:31:24.02,Default,,0,0,0,,Адамдар, естеріңізге саламын!
Dialogue: 0,1:31:32.90,1:31:33.77,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:41.03,1:31:42.41,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:47.37,1:31:48.75,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:55.34,1:31:56.71,Default,,0,0,0,,Уау!
Dialogue: 0,1:31:56.80,1:31:58.93,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,1:31:59.01,1:32:00.68,Default,,0,0,0,,Не болды, адамдар!
Dialogue: 0,1:32:01.39,1:32:04.14,Default,,0,0,0,,Бұл менің жаңа күшім
Dialogue: 0,1:32:04.22,1:32:06.10,Default,,0,0,0,,Бұл Дайганзанду!
Dialogue: 0,1:32:12.90,1:32:17.65,Default,,0,0,0,,Бұл Солтүстік Канандома үстірті сіздің адам зиратыңызға айналады!
Dialogue: 0,1:32:19.32,1:32:21.20,Default,,0,0,0,,Менің денемнің төменгі бөлігі жабысып қалды, мен қозғала алмаймын.
Dialogue: 0,1:32:21.28,1:32:23.41,Default,,0,0,0,,Жаудың көп қарулылары келе жатыр!
Dialogue: 0,1:32:23.49,1:32:25.62,Default,,0,0,0,,Бәрің Дайгуренді қорғайсыңдар!
Dialogue: 0,1:32:25.70,1:32:26.33,Default,,0,0,0,,Қорғау?
Dialogue: 0,1:32:26.41,1:32:27.79,Default,,0,0,0,,Оны қалай қорғайсыз?
Dialogue: 0,1:32:27.87,1:32:29.37,Default,,0,0,0,,Жарайды, алдымен шығарып алайық!
Dialogue: 0,1:32:29.46,1:32:32.75,Default,,0,0,0,,Қарулы топ лақтыру!
Dialogue: 0,1:32:36.25,1:32:37.09,Default,,0,0,0,,Хмф!
Dialogue: 0,1:32:37.59,1:32:38.34,Default,,0,0,0,,Уф!
Dialogue: 0,1:32:38.84,1:32:40.72,Default,,0,0,0,,Жасайық, Декосуке
Dialogue: 0,1:32:47.81,1:32:49.77,Default,,0,0,0,,Мен баладан жеңіле алмаймын
Dialogue: 0,1:32:50.27,1:32:50.94,Default,,0,0,0,,Мен сені күттім, Батыр. ➡
Dialogue: 0,1:32:51.98,1:32:53.15,Default,,0,0,0,,Зан!
Dialogue: 0,1:32:54.31,1:32:55.19,Default,,0,0,0,,Зан!
Dialogue: 0,1:32:56.86,1:32:57.82,Default,,0,0,0,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,1:32:57.90,1:32:58.78,Default,,0,0,0,,Уф...
Dialogue: 0,1:32:58.86,1:33:00.86,Default,,0,0,0,,Сіз дәл қазіргі дыбысты естідіңіз ғой, иә?
Dialogue: 0,1:33:01.86,1:33:03.32,Default,,0,0,0,,Не болды Не болды!
Dialogue: 0,1:33:04.32,1:33:06.70,Default,,0,0,0,,Қолың түсіп қалды, Камина!
Dialogue: 0,1:33:06.78,1:33:08.91,Default,,0,0,0,,Сіз мүлде қателесесіз.
Dialogue: 0,1:33:09.00,1:33:11.66,Default,,0,0,0,,Китан Стингер!
Dialogue: 0,1:33:11.75,1:33:12.83,Default,,0,0,0,,Ой…
Dialogue: 0,1:33:12.92,1:33:15.38,Default,,0,0,0,,Жыл мезгілдері бөлек, жас.
Dialogue: 0,1:33:16.67,1:33:20.34,Default,,0,0,0,,Үмітсіздік белгісі (Desperado Grave)!
Dialogue: 0,1:33:22.13,1:33:24.80,Default,,0,0,0,,А... а... а
Dialogue: 0,1:33:24.89,1:33:25.93,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,1:33:27.51,1:33:30.77,Default,,0,0,0,,Чи... Чикишо~!
Dialogue: 0,1:33:32.85,1:33:34.85,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:33:45.61,1:33:46.87,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:33:50.24,1:33:52.83,Default,,0,0,0,,Уф... жаулар тым көп.
Dialogue: 0,1:33:52.91,1:33:54.83,Default,,0,0,0,,Алдын алу өте қиын
Dialogue: 0,1:33:54.92,1:33:55.88,Default,,0,0,0,,Ах!
Dialogue: 0,1:33:58.84,1:34:02.01,Default,,0,0,0,,Тыңда, кемеге бұдан былай зиян келтірме.
Dialogue: 0,1:34:02.09,1:34:04.43,Default,,0,0,0,,Мен жай ғана ішіндегі қоқысты тазалаймын.
Dialogue: 0,1:34:05.26,1:34:06.22,Default,,0,0,0,,(оқтардың тойтарыс беру дыбысы)
Dialogue: 0,1:34:07.09,1:34:07.68,Default,,0,0,0,,Хун
Dialogue: 0,1:34:07.76,1:34:09.35,Default,,0,0,0,,Қарғыс... қоян-қолтық ұрыс?
Dialogue: 0,1:34:12.10,1:34:13.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:34:13.73,1:34:16.02,Default,,0,0,0,,Мүмкін сіз басқа біреуді уайымдасаңыз.
Dialogue: 0,1:34:16.10,1:34:18.90,Default,,0,0,0,,Неліктен? Сенің әкең неге бұлай істеп жатыр?
Dialogue: 0,1:34:18.98,1:34:20.15,Default,,0,0,0,,Бұл жай ғана ойын-сауық.
Dialogue: 0,1:34:21.19,1:34:24.36,Default,,0,0,0,,Патша мың жыл өмір сүрді
Dialogue: 0,1:34:24.45,1:34:27.74,Default,,0,0,0,,Балалы болу, тәрбиелеу де ермек
Dialogue: 0,1:34:27.82,1:34:31.29,Default,,0,0,0,,Сондықтан шаршаған кезде қуыршақ сияқты лақтыр.
Dialogue: 0,1:34:32.20,1:34:33.20,Default,,0,0,0,,Қуыршақ…
Dialogue: 0,1:34:33.70,1:34:37.38,Default,,0,0,0,,Сіз патшадан: «Мен не үшін дүниеге келдім?» деп сұрадыңыз.
Dialogue: 0,1:34:37.46,1:34:39.04,Default,,0,0,0,,Мен сіздің сұрағаныңызды естідім.
Dialogue: 0,1:34:39.13,1:34:40.80,Default,,0,0,0,,Бұл жаман болды.
Dialogue: 0,1:34:40.88,1:34:45.63,Default,,0,0,0,,Олардың сізді жек көруі табиғи нәрсе, өйткені қуыршақтарға эго керек емес.
Dialogue: 0,1:34:45.72,1:34:47.51,Default,,0,0,0,,Мен қуыршақпын...
Dialogue: 0,1:34:47.59,1:34:48.51,Default,,0,0,0,,Иә
Dialogue: 0,1:34:48.59,1:34:52.22,Default,,0,0,0,,Ал әдемі қуыршақтар ауаға шашылады
Dialogue: 0,1:34:52.31,1:34:54.64,Default,,0,0,0,,Ақымақ адамдар
Dialogue: 0,1:34:54.73,1:34:57.60,Default,,0,0,0,,Қызықты шоудың уақыты келді!
Dialogue: 0,1:34:57.69,1:34:58.56,Default,,0,0,0,,Сонымен... мені ұмытып қалғың келе ме?
Dialogue: 0,1:34:58.65,1:34:59.77,Default,,0,0,0,,Міне!
Dialogue: 0,1:34:59.86,1:35:00.98,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:35:02.86,1:35:03.44,Default,,0,0,0,,Саймон!
Dialogue: 0,1:35:05.53,1:35:07.86,Default,,0,0,0,,Ниа... мен оны саған бермеймін.
Dialogue: 0,1:35:07.95,1:35:08.95,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:35:09.45,1:35:10.32,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,1:35:11.41,1:35:13.62,Default,,0,0,0,,Адамдар, әрине, кішкентай.
Dialogue: 0,1:35:14.33,1:35:18.71,Default,,0,0,0,,Бұл кішкентай адамның үлкен, үлкен жүрегі бар.
Dialogue: 0,1:35:19.42,1:35:20.96,Default,,0,0,0,,Олар қуыршақ емес
Dialogue: 0,1:35:21.04,1:35:22.17,Default,,0,0,0,,Мен де
Dialogue: 0,1:35:22.25,1:35:23.63,Default,,0,0,0,,Кукеееее!
Dialogue: 0,1:35:23.71,1:35:27.30,Default,,0,0,0,,Ал, мына Шузақтың денесін лас бұрғымен бұрғылайық!
Dialogue: 0,1:35:27.38,1:35:28.76,Default,,0,0,0,,Ол сені жаншып тастайды
Dialogue: 0,1:35:28.84,1:35:30.59,Default,,0,0,0,,Бұл!бұл!
Dialogue: 0,1:35:33.10,1:35:35.64,Default,,0,0,0,,Ниа, күте тұрыңыз.
Dialogue: 0,1:35:42.11,1:35:44.78,Default,,0,0,0,,Түсіндім... Солай ма?
Dialogue: 0,1:35:46.15,1:35:47.74,Default,,0,0,0,,Мен өзіме сенімді емес едім
Dialogue: 0,1:35:48.57,1:35:50.07,Default,,0,0,0,,Мен жай ғана қатал болдым.
Dialogue: 0,1:35:50.66,1:35:54.37,Default,,0,0,0,,«Алға жылжу» дегенді ғана айта аламын.
Dialogue: 0,1:35:57.54,1:36:00.12,Default,,0,0,0,,Бірақ Саймон үнсіз қазуды жалғастырды.
Dialogue: 0,1:36:00.21,1:36:02.46,Default,,0,0,0,,Менің батылдығымды қолдады
Dialogue: 0,1:36:03.42,1:36:05.80,Default,,0,0,0,,Оны жер бетіне шығарған оның күші болды.
Dialogue: 0,1:36:05.88,1:36:08.30,Default,,0,0,0,,Сол кезде мен шештім
Dialogue: 0,1:36:09.18,1:36:12.05,Default,,0,0,0,,Алдыңа мақсат қойған соң, ешқашан тайсалмайсың...
Dialogue: 0,1:36:14.05,1:36:15.06,Default,,0,0,0,,Уау!
Dialogue: 0,1:36:15.64,1:36:18.43,Default,,0,0,0,,Сол артыңнан күлмейтін адам болғаныңда
Dialogue: 0,1:36:18.52,1:36:19.56,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:36:19.64,1:36:22.90,Default,,0,0,0,,Тыңда, Саймон, сен мен сенетін адам емессің.
Dialogue: 0,1:36:23.52,1:36:25.61,Default,,0,0,0,,Мен тіпті сенбейтін адам емеспін
Dialogue: 0,1:36:26.44,1:36:29.07,Default,,0,0,0,,«Кімге сенетініне сен».
Dialogue: 0,1:36:33.99,1:36:34.49,Default,,0,0,0,,Уау!
Dialogue: 0,1:36:36.08,1:36:37.62,Default,,0,0,0,,Жақын!
Dialogue: 0,1:36:37.70,1:36:38.91,Default,,0,0,0,,Ах!
Dialogue: 0,1:36:39.71,1:36:41.00,Default,,0,0,0,,Саймон!
Dialogue: 0,1:36:45.21,1:36:49.84,Default,,0,0,0,,Қалай ойлайсың, Ниа, бұл кішкентай адамның ақыры.
Dialogue: 0,1:36:49.92,1:36:51.18,Default,,0,0,0,,Жоқ
Dialogue: 0,1:36:51.26,1:36:53.30,Default,,0,0,0,,Саймонның Аники-санға сенгені сияқты.
Dialogue: 0,1:36:53.39,1:36:55.55,Default,,0,0,0,,Мен де Симонға сенемін!
Dialogue: 0,1:36:55.64,1:36:57.52,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:36:59.10,1:36:59.93,Default,,0,0,0,,Уф...
Dialogue: 0,1:37:00.64,1:37:02.69,Default,,0,0,0,,Қарғыс атсын... Уау
Dialogue: 0,1:37:03.19,1:37:05.15,Default,,0,0,0,,Уау!
Dialogue: 0,1:37:05.81,1:37:06.61,Default,,0,0,0,,Гррр…
Dialogue: 0,1:37:08.11,1:37:10.53,Default,,0,0,0,,Ниа... Ниа...
Dialogue: 0,1:37:11.32,1:37:12.45,Default,,0,0,0,,Мен күтемін!
Dialogue: 0,1:37:13.28,1:37:14.16,Default,,0,0,0,,Ха…
Dialogue: 0,1:37:31.17,1:37:32.01,Default,,0,0,0,,Лаган…
Dialogue: 0,1:37:35.93,1:37:37.01,Default,,0,0,0,,Лаган!
Dialogue: 0,1:37:38.56,1:37:40.35,Default,,0,0,0,,Хя~хахахаха!
Dialogue: 0,1:37:40.43,1:37:43.77,Default,,0,0,0,,Қараңдар, қорқыңдар және өліңдер!
Dialogue: 0,1:37:43.85,1:37:46.40,Default,,0,0,0,,Majestic Big Chopper...
Dialogue: 0,1:37:52.86,1:37:53.36,Default,,0,0,0,,Ах!
Dialogue: 0,1:37:54.28,1:37:55.82,Default,,0,0,0,,Ниа, мен саған көмектесуге келдім.
Dialogue: 0,1:37:55.91,1:37:56.70,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:37:56.78,1:37:58.33,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:59.29,1:38:00.62,Default,,0,0,0,,Саймон!
Dialogue: 0,1:38:15.30,1:38:16.84,Default,,0,0,0,,Ах, менің Джентль…
Dialogue: 0,1:38:17.34,1:38:18.10,Default,,0,0,0,,Жоқ
Dialogue: 0,1:38:18.18,1:38:20.18,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,1:38:20.26,1:38:22.06,Default,,0,0,0,,Раган да маған айтты
Dialogue: 0,1:38:22.14,1:38:24.23,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,1:38:26.02,1:38:27.02,Default,,0,0,0,,Мен де
Dialogue: 0,1:38:29.23,1:38:31.48,Default,,0,0,0,,Рахмет Саймон
Dialogue: 0,1:38:31.57,1:38:32.94,Default,,0,0,0,,Джо!
Dialogue: 0,1:38:33.03,1:38:35.61,Default,,0,0,0,,Уф... ха!
Dialogue: 0,1:38:35.70,1:38:36.74,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:38:38.20,1:38:39.62,Default,,0,0,0,,Кя!
Dialogue: 0,1:38:40.16,1:38:41.54,Default,,0,0,0,,Не?! Һмм…
Dialogue: 0,1:38:43.08,1:38:44.75,Default,,0,0,0,,Ал, Тимилфтің Дайганзанында.
Dialogue: 0,1:38:44.83,1:38:47.00,Default,,0,0,0,,Сіз қалағаныңызды істедіңіз.
Dialogue: 0,1:38:47.08,1:38:50.34,Default,,0,0,0,,Адам сияқты адам хайуан кемесін қалай ұстай алады?
Dialogue: 0,1:38:50.42,1:38:52.46,Default,,0,0,0,,Бұл 100 жыл ерте.
Dialogue: 0,1:38:52.55,1:38:55.34,Default,,0,0,0,,Бұл талғампаз Адин ханым сізбен айналысады.
Dialogue: 0,1:38:55.42,1:38:57.30,Default,,0,0,0,,Құрметті болыңыз!
Dialogue: 0,1:38:58.26,1:39:01.22,Default,,0,0,0,,Гяааах!
Dialogue: 0,1:39:04.06,1:39:04.73,Default,,0,0,0,,Жұмыс істемейді ме?
Dialogue: 0,1:39:04.81,1:39:08.15,Default,,0,0,0,,Қандай ысырап, кішкентай қыз!
Dialogue: 0,1:39:08.98,1:39:10.52,Default,,0,0,0,,Сіз дәл қазіргі дыбысты естідіңіз ғой, иә?
Dialogue: 0,1:39:11.44,1:39:12.15,Default,,0,0,0,,Уф...
Dialogue: 0,1:39:12.65,1:39:13.36,Default,,0,0,0,,Қый!
Dialogue: 0,1:39:14.49,1:39:15.24,Default,,0,0,0,,Уф!
Dialogue: 0,1:39:16.32,1:39:17.82,Default,,0,0,0,,Қарапайым
Dialogue: 0,1:39:17.91,1:39:19.70,Default,,0,0,0,,Мұның тез болғанына сене алар емеспін.
Dialogue: 0,1:39:19.78,1:39:22.16,Default,,0,0,0,,Бұл ұят, Камина.
Dialogue: 0,1:39:23.20,1:39:25.62,Default,,0,0,0,,Түсініспеушіліктің кесірінен өлтіресің бе?
Dialogue: 0,1:39:27.37,1:39:27.87,Default,,0,0,0,,Россиу!
Dialogue: 0,1:39:27.96,1:39:29.96,Default,,0,0,0,,А... Саймон мырза?
Dialogue: 0,1:39:30.46,1:39:31.59,Default,,0,0,0,,Жоспарды алдын ала талқылағанымызға қуаныштымын
Dialogue: 0,1:39:32.21,1:39:32.84,Default,,0,0,0,,Иә!
Dialogue: 0,1:39:32.92,1:39:36.59,Default,,0,0,0,,жағдай Хонецукидің Қвиркінің арқасында өзгерді.
Dialogue: 0,1:39:37.34,1:39:38.97,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,1:39:39.05,1:39:39.93,Default,,0,0,0,,Ах...
Dialogue: 0,1:39:41.76,1:39:43.06,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:39:44.26,1:39:45.89,Default,,0,0,0,,Не! Амал жоқ...
Dialogue: 0,1:39:45.97,1:39:47.60,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:39:56.82,1:39:57.70,Default,,0,0,0,,Не!
Dialogue: 0,1:40:00.99,1:40:03.70,Default,,0,0,0,,Менің ағам өлді, ол жоқ.
Dialogue: 0,1:40:04.24,1:40:04.79,Default,,0,0,0,,Бірақ…
Dialogue: 0,1:40:05.45,1:40:07.71,Default,,0,0,0,,Менің арқамда... Мына кеудеде
Dialogue: 0,1:40:07.79,1:40:10.42,Default,,0,0,0,,Бір адамдай аман болыңыз!
Dialogue: 0,1:40:13.59,1:40:15.67,Default,,0,0,0,,Ор қазғың келсе, аспанға қаз.
Dialogue: 0,1:40:16.17,1:40:18.22,Default,,0,0,0,,Мола қазсаң да, қазып ал.
Dialogue: 0,1:40:18.30,1:40:20.34,Default,,0,0,0,,Мен бұзып өте алсам, мен жеңемін!
Dialogue: 0,1:40:21.18,1:40:23.26,Default,,0,0,0,,Мені кім деп ойлайсың?
Dialogue: 0,1:40:23.35,1:40:24.97,Default,,0,0,0,,Мен Саймонмын
Dialogue: 0,1:40:25.06,1:40:26.93,Default,,0,0,0,,Каминаның үлкен ағасы емес
Dialogue: 0,1:40:27.02,1:40:28.39,Default,,0,0,0,,Мен менмін
Dialogue: 0,1:40:28.98,1:40:31.52,Default,,0,0,0,,Бұл Саймон Диггинг!
Dialogue: 0,1:40:33.48,1:40:35.82,Default,,0,0,0,,Ей, же!
Dialogue: 0,1:40:35.90,1:40:37.86,Default,,0,0,0,,Бұзу…
Dialogue: 0,1:40:38.86,1:40:41.74,Default,,0,0,0,,Prue…
Dialogue: 0,1:40:41.82,1:40:42.87,Default,,0,0,0,,Мугю!
Dialogue: 0,1:40:46.54,1:40:47.62,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:41:03.34,1:41:04.14,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:41:05.01,1:41:05.89,Default,,0,0,0,,Hissatsu…
Dialogue: 0,1:41:06.89,1:41:13.65,Default,,0,0,0,,Мусо спиральының кері айналуы!
Dialogue: 0,1:41:14.35,1:41:16.11,Default,,0,0,0,,Киеееее!
Dialogue: 0,1:41:19.11,1:41:21.07,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:41:21.15,1:41:23.28,Default,,0,0,0,,(Топ мүшелерінің қошеметтері)
Dialogue: 0,1:41:24.91,1:41:27.99,Default,,0,0,0,,Ақымақ... Камина өліп қалды ма?
Dialogue: 0,1:41:28.08,1:41:31.41,Default,,0,0,0,,Ғұн, құстар ғана әнді тез аяқтайды.
Dialogue: 0,1:41:31.50,1:41:32.21,Default,,0,0,0,,Гррр…
Dialogue: 0,1:41:32.29,1:41:36.92,Default,,0,0,0,,Король Киттан...
Dialogue: 0,1:41:37.42,1:41:38.92,Default,,0,0,0,,Deluxe!
Dialogue: 0,1:41:39.71,1:41:40.71,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,1:41:41.22,1:41:43.72,Default,,0,0,0,,Саймон мұның бәрін істеп жатыр.
Dialogue: 0,1:41:44.22,1:41:46.76,Default,,0,0,0,,Біздің сонша әбігерге түсуімізге еш себеп жоқ...
Dialogue: 0,1:41:46.85,1:41:49.10,Default,,0,0,0,,-Мен бара алмаймын! -Бұл (Киёу Киял)!
Dialogue: 0,1:41:49.68,1:41:51.10,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:41:53.35,1:41:54.56,Default,,0,0,0,,Міне!
Dialogue: 0,1:41:55.69,1:41:57.52,Default,,0,0,0,,Міне!
Dialogue: 0,1:41:58.15,1:41:58.73,Default,,0,0,0,,Уф!
Dialogue: 0,1:42:00.57,1:42:01.82,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,1:42:06.53,1:42:07.41,Default,,0,0,0,,Гррр…
Dialogue: 0,1:42:11.45,1:42:14.08,Default,,0,0,0,,Кешіріңіз, бірақ бұл Дайгурен командасының кемесі.
Dialogue: 0,1:42:14.71,1:42:18.54,Default,,0,0,0,,Ол кісі өз өмірін қатерге тігіп бізге берген жер.
Dialogue: 0,1:42:19.34,1:42:20.75,Default,,0,0,0,,Мен оны саған бере алмаймын!
Dialogue: 0,1:42:22.05,1:42:23.09,Default,,0,0,0,,Чи…
Dialogue: 0,1:42:23.17,1:42:26.68,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:42:28.14,1:42:28.76,Default,,0,0,0,,Ах!
Dialogue: 0,1:42:28.85,1:42:31.43,Default,,0,0,0,,Сіздің қаруластарыңыз, оны қолданыңыз!
Dialogue: 0,1:42:31.52,1:42:32.64,Default,,0,0,0,,Лейронға рахмет!
Dialogue: 0,1:42:32.72,1:42:34.10,Default,,0,0,0,,Буу~!
Dialogue: 0,1:42:35.27,1:42:39.11,Default,,0,0,0,,Хмф, сіз нені білдіреді? Сіз кенеттен сондай батыл болып кеттіңіз.
Dialogue: 0,1:42:39.19,1:42:42.15,Default,,0,0,0,,Адин, егер бұлай болса, мен бәріңді бірден қуамын.
Dialogue: 0,1:42:42.23,1:42:44.70,Default,,0,0,0,,Аспандағы төрт патшаның соңғы пішіні
Dialogue: 0,1:42:44.78,1:42:46.49,Default,,0,0,0,,Бар болғаны екі адам.
Dialogue: 0,1:42:46.57,1:42:48.07,Default,,0,0,0,,Құрметті Адина, мен де!
Dialogue: 0,1:42:59.71,1:43:00.67,Default,,0,0,0,,Біріктіріңіз!
Dialogue: 0,1:43:03.09,1:43:05.05,Default,,0,0,0,,Дотен Кайзан!
Dialogue: 0,1:43:07.55,1:43:09.76,Default,,0,0,0,,Жеңдер!
Dialogue: 0,1:43:16.81,1:43:17.98,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:43:21.19,1:43:24.11,Default,,0,0,0,,Бухахаха, таң қалдыңыз ба, адамдар?
Dialogue: 0,1:43:24.19,1:43:27.57,Default,,0,0,0,,Спиральды патшаның төрт аспан патшасын қатты ашуландырған сияқтысыз.
Dialogue: 0,1:43:27.65,1:43:32.33,Default,,0,0,0,,Шығыста, батыста, солтүстікте, оңтүстікте, құрлықта, теңізде, ауада үш дүниеде де соқыр нүкте жоқ.
Dialogue: 0,1:43:32.41,1:43:35.29,Default,,0,0,0,,Толық бекініс Дотенкайзанның күші
Dialogue: 0,1:43:35.37,1:43:38.79,Default,,0,0,0,,Тіпті тесіктеріңіздің тереңдігін біліңіз!
Dialogue: 0,1:43:40.58,1:43:43.21,Default,,0,0,0,,Ештеңеден бас тартпаңдар.
Dialogue: 0,1:43:43.30,1:43:44.96,Default,,0,0,0,,Жарайды
Dialogue: 0,1:43:45.05,1:43:48.68,Default,,0,0,0,,Достарың көп болса, неден қорқу керек?
Dialogue: 0,1:43:48.76,1:43:51.39,Default,,0,0,0,,Қара ағайындылардың үлкен ағасы Китан
Dialogue: 0,1:43:52.30,1:43:52.85,Default,,0,0,0,,Киёу
Dialogue: 0,1:43:53.51,1:43:54.06,Default,,0,0,0,,Қял
Dialogue: 0,1:43:54.64,1:43:55.27,Default,,0,0,0,,Зоши
Dialogue: 0,1:43:55.35,1:43:56.73,Default,,0,0,0,,-Бала -Айлак
Dialogue: 0,1:43:57.43,1:43:57.94,Default,,0,0,0,,Маккен
Dialogue: 0,1:43:58.48,1:43:59.65,Default,,0,0,0,,- (Джоган) Джоган - (Баринбо) Баринбо
Dialogue: 0,1:44:00.27,1:44:00.85,Default,,0,0,0,,Росиу
Dialogue: 0,1:44:01.44,1:44:02.27,Default,,0,0,0,,Бубубу
Dialogue: 0,1:44:02.36,1:44:03.32,Default,,0,0,0,,Боота және Йоко
Dialogue: 0,1:44:03.90,1:44:04.86,Default,,0,0,0,,-Ниа -Ах...
Dialogue: 0,1:44:04.94,1:44:06.65,Default,,0,0,0,,Және Саймон
Dialogue: 0,1:44:07.15,1:44:08.53,Default,,0,0,0,,Біз...
Dialogue: 0,1:44:09.15,1:44:13.28,Default,,0,0,0,,Өзіңді кіммін деп ойлайсың?
Dialogue: 0,1:44:13.37,1:44:14.41,Default,,0,0,0,,Хисацу
Dialogue: 0,1:44:14.91,1:44:16.08,Default,,0,0,0,,Гига…
Dialogue: 0,1:44:16.91,1:44:18.41,Default,,0,0,0,,Бұрғылау…
Dialogue: 0,1:44:18.50,1:44:21.33,Default,,0,0,0,,Үзіліс!
Dialogue: 0,1:44:21.42,1:44:25.92,Default,,0,0,0,,Арнайы Дайгурен командасы!
Dialogue: 0,1:44:26.00,1:44:28.05,Default,,0,0,0,,Буу~!
Dialogue: 0,1:44:32.51,1:44:36.10,Default,,0,0,0,,Аһ!
Dialogue: 0,1:44:38.73,1:44:40.31,Default,,0,0,0,,Уау!
Dialogue: 0,1:44:40.39,1:44:41.31,Default,,0,0,0,,Аһ!
Dialogue: 0,1:44:46.53,1:44:48.03,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:44:53.99,1:44:55.87,Default,,0,0,0,,(Ауыл тұрғындары қолдайды)
Dialogue: 0,1:44:57.91,1:44:59.79,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,1:45:11.76,1:45:13.26,Default,,0,0,0,,Неліктен...
Dialogue: 0,1:45:14.55,1:45:17.60,Default,,0,0,0,,Неге... Мен ғана аман қалдым
Dialogue: 0,1:45:21.48,1:45:25.23,Default,,0,0,0,,Кешір мені, адамдар.
Dialogue: 0,1:45:33.66,1:45:35.66,Default,,0,0,0,,Аники-сан осында...
Dialogue: 0,1:45:44.75,1:45:48.05,Default,,0,0,0,,Мен үшін Әкем бүкіл әлемді білдірді.
Dialogue: 0,1:45:49.00,1:45:53.30,Default,,0,0,0,,Мен Әкеге ғана сендім және Әкеге ғана арқа сүйеп өмір сүрдім.
Dialogue: 0,1:45:53.80,1:45:58.51,Default,,0,0,0,,Сондықтан мен саған соңына дейін сенгім келді.
Dialogue: 0,1:45:59.60,1:46:03.06,Default,,0,0,0,,Біз не үшін дүниеге келдік?
Dialogue: 0,1:46:03.14,1:46:04.48,Default,,0,0,0,,Осының жанында...
Dialogue: 0,1:46:05.27,1:46:06.15,Default,,0,0,0,,(Роко) Һм? (Масато) Хехехе
Dialogue: 0,1:46:06.81,1:46:07.52,Default,,0,0,0,,Иә?
Dialogue: 0,1:46:09.69,1:46:13.15,Default,,0,0,0,,Мен оны ағаларыммен қамауға алған кезде таптым.
Dialogue: 0,1:46:15.36,1:46:16.20,Default,,0,0,0,,Сен әзілдескің келгенін түсіндім—
Dialogue: 0,1:46:18.49,1:46:20.20,Default,,0,0,0,,Мен шынымен түсінбеймін...
Dialogue: 0,1:46:20.29,1:46:22.54,Default,,0,0,0,,Қай жерде туылғаның, ханшайым болғаның маңызды емес.
Dialogue: 0,1:46:22.62,1:46:25.08,Default,,0,0,0,,Дәл қазір осында тұрған Ниа - Ниа.
Dialogue: 0,1:46:25.71,1:46:28.63,Default,,0,0,0,,Сондықтан Ниа Ниа сияқты өмір сүруі керек.
Dialogue: 0,1:46:29.29,1:46:30.05,Default,,0,0,0,,Иә
Dialogue: 0,1:46:30.13,1:46:32.17,Default,,0,0,0,,Мен де өз өмірімді өткіземін.
Dialogue: 0,1:46:32.67,1:46:35.01,Default,,0,0,0,,Мен сенің үлкен ағаң бола алмаймын, бірақ мұны менің жолыммен істе
Dialogue: 0,1:46:36.09,1:46:37.89,Default,,0,0,0,,Мен ақымақпын
Dialogue: 0,1:46:37.97,1:46:41.97,Default,,0,0,0,,Мен сенің жаныңда болсам да, саған ең аз сенім артқан адам мен болған шығармын.
Dialogue: 0,1:46:42.47,1:46:44.68,Default,,0,0,0,,Камина мен Саймон туралы
Dialogue: 0,1:46:44.77,1:46:46.90,Default,,0,0,0,,Өзім туралы да.
Dialogue: 0,1:46:46.98,1:46:47.48,Default,,0,0,0,,Йоко…
Dialogue: 0,1:46:47.56,1:46:52.19,Default,,0,0,0,,Қолдауыңызға, жаңа достарыңызға және жаңа көшбасшыңызға рахмет.
Dialogue: 0,1:46:52.28,1:46:52.86,Default,,0,0,0,,Бубу~
Dialogue: 0,1:46:52.94,1:46:54.07,Default,,0,0,0,,Не!
Dialogue: 0,1:46:55.45,1:46:58.03,Default,,0,0,0,,Сіз Камина таңдаған адамсыз, солай емес пе?
Dialogue: 0,1:46:58.12,1:47:00.70,Default,,0,0,0,,Көңіліңді көтер, Саймон!
Dialogue: 0,1:47:00.78,1:47:02.54,Default,,0,0,0,,Хахаха!
Dialogue: 0,1:47:09.63,1:47:11.63,Default,,0,0,0,,Ұрыс жалғасуда, солай ма?
Dialogue: 0,1:47:11.71,1:47:14.26,Default,,0,0,0,,Иә, бірақ қазір күліңіз.
Dialogue: 0,1:47:14.84,1:47:16.13,Default,,0,0,0,,Бұл жақсырақ
Dialogue: 0,1:47:26.52,1:47:28.52,Default,,0,0,0,,♪~
Dialogue: 0,1:51:26.80,1:51:28.80,Default,,0,0,0,,~♪
Dialogue: 0,1:51:30.18,1:51:31.35,Default,,0,0,0,,Аспандағы төрт патша
Dialogue: 0,1:51:31.43,1:51:35.14,Default,,0,0,0,,Барлығын жас спираль адам жойды.
Dialogue: 0,1:51:35.23,1:51:37.10,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,1:51:37.19,1:51:41.15,Default,,0,0,0,,Ол әлі де шынайы қорқынышты білмейді.
Dialogue: 0,1:51:41.73,1:51:46.95,Default,,0,0,0,,Спиральды патша деп аталатын қорқыныш
Dialogue: 0,1:51:48.45,1:51:54.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory