Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.70,0:00:15.70,staff,NTP,0000,0000,0000,,Түпнұсқа бейне және аудио нұсқасы жарияланады, жарияланады, субтитрлер қойылады және академиялық алмасу үшін пайдаланылады. Жарияланғаннан кейін жарияланым 24 минут ішінде жойылады және бизнес мүдделерін жариялау немесе өндіру жүзеге асырылады. Егер сіз заңға немесе басқа міндеттерге жауапты болсаңыз, субтитрлерді қабылдамаңыз.
Dialogue: 0,0:04:06.24,0:04:10.93,staff,NTP,0000,0000,0000,,  
Dialogue: 0,0:04:19.86,0:04:24.84,staff,NTP,0000,0000,0000,,Аударма: Windless Waves Windless Waves
Dialogue: 0,0:04:25.12,0:04:30.15,staff,NTP,0000,0000,0000,,Жапон жүйесі Наксиа ересек
Dialogue: 0,0:04:30.27,0:04:35.61,staff,NTP,0000,0000,0000,,Калибрлеу және уақыт Люсифер
Dialogue: 0,0:03:52.76,0:04:01.19,logo,NTP,0000,0000,0000,,Құдайдың субтитр жұбы
Dialogue: 0,0:01:48.05,0:01:48.77,cn.sub,NTP,0000,0000,0000,,Кайто
Dialogue: 0,0:01:48.87,0:01:50.68,cn.sub,NTP,0000,0000,0000,,Келу
Dialogue: 0,0:02:16.57,0:02:17.09,cn.sub,NTP,0000,0000,0000,,Масуми және т.б.
Dialogue: 0,0:02:17.89,0:02:19.22,cn.sub,NTP,0000,0000,0000,,Еденнің түбіне құлайсың
Dialogue: 0,0:02:46.71,0:02:47.69,cn.sub,NTP,0000,0000,0000,,Бұл көз жасын ағызатын газ
Dialogue: 0,0:02:59.17,0:03:00.36,cn.sub,NTP,0000,0000,0000,,Жылтырату қызметі
Dialogue: 0,0:03:00.41,0:03:02.12,cn.sub,NTP,0000,0000,0000,,Қолайсыздық
Dialogue: 0,0:03:10.60,0:03:12.45,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:03:14.15,0:03:15.04,cn.sub,NTP,0000,0000,0000,,Таптым.
Dialogue: 0,0:03:16.06,0:03:18.62,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:03:19.16,0:03:21.31,cn.sub,NTP,0000,0000,0000,,Оңай өмір сүру тәжірибесі
Dialogue: 0,0:03:21.34,0:03:24.27,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:03:25.74,0:03:27.20,cn.sub,NTP,0000,0000,0000,,Бұл тастың аты.
Dialogue: 0,0:03:27.30,0:03:28.56,cn.sub,NTP,0000,0000,0000,,Аралық камераны алу
Dialogue: 0,0:03:28.59,0:03:31.10,cn.sub,NTP,0000,0000,0000,,Назэ Тогиосэки
Dialogue: 0,0:03:39.52,0:03:41.73,cn.sub,NTP,0000,0000,0000,,Аяқталған ұшатын тас…
Dialogue: 0,0:06:22.68,0:06:24.63,cn.sub,NTP,0000,0000,0000,,Ескі тақта
Dialogue: 0,0:06:24.70,0:06:26.46,cn.sub,NTP,0000,0000,0000,,Ағымдағы жағдайға қосымша
Dialogue: 0,0:06:26.55,0:06:29.37,cn.sub,NTP,0000,0000,0000,,Бұл Йошихисаның өлі бейнесі.
Dialogue: 0,0:06:29.99,0:06:30.95,cn.sub,NTP,0000,0000,0000,,Қалай жалғастыру керек?
Dialogue: 0,0:06:31.00,0:06:31.53,cn.sub,NTP,0000,0000,0000,,Қайырымдылық
Dialogue: 0,0:06:42.51,0:06:43.54,cn.sub,NTP,0000,0000,0000,,Накореджия
Dialogue: 0,0:06:51.39,0:06:52.31,cn.sub,NTP,0000,0000,0000,,Бұл адам кім?
Dialogue: 0,0:07:46.97,0:07:47.53,cn.sub,NTP,0000,0000,0000,,Томое
Dialogue: 0,0:07:48.34,0:07:49.85,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:07:49.93,0:07:51.73,cn.sub,NTP,0000,0000,0000,,Азық-түлік сатып алу аяқталды.
Dialogue: 0,0:07:51.81,0:07:53.03,cn.sub,NTP,0000,0000,0000,,Лаодай
Dialogue: 0,0:07:53.88,0:07:55.35,cn.sub,NTP,0000,0000,0000,,Жәннатта балалы қыз...
Dialogue: 0,0:07:59.22,0:08:00.85,cn.sub,NTP,0000,0000,0000,,Майя Майя
Dialogue: 0,0:08:15.65,0:08:17.41,cn.sub,NTP,0000,0000,0000,,Жәннатта балалы жас келіншек...
Dialogue: 0,0:08:20.78,0:08:22.72,cn.sub,NTP,0000,0000,0000,,Бұзуға болады
Dialogue: 0,0:08:23.31,0:08:25.18,cn.sub,NTP,0000,0000,0000,,Лао Дай, қыз бала...
Dialogue: 0,0:08:25.52,0:08:27.22,cn.sub,NTP,0000,0000,0000,,Жоғарғы екінші қақпа
Dialogue: 0,0:08:36.81,0:08:37.61,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:38.08,0:08:39.34,cn.sub,NTP,0000,0000,0000,,Томенің қолы
Dialogue: 0,0:08:39.39,0:08:39.95,cn.sub,NTP,0000,0000,0000,,Қазірге дейін
Dialogue: 0,0:08:44.35,0:08:46.09,cn.sub,NTP,0000,0000,0000,,Мен қазір операцияны аша алмаймын.
Dialogue: 0,0:08:46.80,0:08:48.48,cn.sub,NTP,0000,0000,0000,,Қажетсіз түсіндіру
Dialogue: 0,0:08:48.50,0:08:49.06,cn.sub,NTP,0000,0000,0000,,Қазірге дейін
Dialogue: 0,0:08:51.77,0:08:53.39,cn.sub,NTP,0000,0000,0000,,Қорқақ және айлалы әңгіме де мүмкін.
Dialogue: 0,0:08:53.42,0:08:53.81,cn.sub,NTP,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:09:11.31,0:09:12.05,cn.sub,NTP,0000,0000,0000,,Автокөлік! !
Dialogue: 0,0:09:24.94,0:09:25.66,cn.sub,NTP,0000,0000,0000,,Сеніңше, қалай?
Dialogue: 0,0:09:25.85,0:09:26.62,cn.sub,NTP,0000,0000,0000,,Тәртіпсіздік
Dialogue: 0,0:09:26.67,0:09:28.43,cn.sub,NTP,0000,0000,0000,,Қосылым қол жетімді емес.
Dialogue: 0,0:09:28.51,0:09:30.56,cn.sub,NTP,0000,0000,0000,,Хакусей Рёу
Dialogue: 0,0:09:30.64,0:09:33.42,cn.sub,NTP,0000,0000,0000,,Сян Шығыс қауымдастығының жақсы жақтары
Dialogue: 0,0:09:33.50,0:09:35.70,cn.sub,NTP,0000,0000,0000,,Квайи астана келгенге дейін
Dialogue: 0,0:09:35.76,0:09:38.13,cn.sub,NTP,0000,0000,0000,,Жақсы бастама
Dialogue: 0,0:09:39.07,0:09:40.13,cn.sub,NTP,0000,0000,0000,,Сіз кеткен кезде
Dialogue: 0,0:09:53.55,0:09:54.80,cn.sub,NTP,0000,0000,0000,,Бу машинасы жанып кетті
Dialogue: 0,0:09:54.92,0:09:56.03,cn.sub,NTP,0000,0000,0000,,Жою және толықтыру аяқталды
Dialogue: 0,0:09:56.14,0:09:57.84,cn.sub,NTP,0000,0000,0000,,Мұндай апатта заманның шындығы
Dialogue: 0,0:10:02.72,0:10:05.58,cn.sub,NTP,0000,0000,0000,,Томое бұзылған жабдықтың майын ұмытып қалды
Dialogue: 0,0:10:05.68,0:10:06.19,cn.sub,NTP,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:10:21.90,0:10:23.00,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:10:23.11,0:10:25.26,cn.sub,NTP,0000,0000,0000,,Қара лак кесіндісі.
Dialogue: 0,0:10:25.35,0:10:27.55,cn.sub,NTP,0000,0000,0000,,Толық мәліметтер
Dialogue: 0,0:10:27.63,0:10:30.76,cn.sub,NTP,0000,0000,0000,,Жою заңы Тенриодан кейін қайту
Dialogue: 0,0:13:11.40,0:13:12.61,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:13:13.70,0:13:15.23,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:13:22.32,0:13:25.37,cn.sub,NTP,0000,0000,0000,,Адам өмір сүріп жатқанда аспанға сайраймын.
Dialogue: 0,0:13:26.40,0:13:28.09,cn.sub,NTP,0000,0000,0000,,Тамақты үрлеп болған соң, тамақты жеймін.
Dialogue: 0,0:13:38.47,0:13:40.89,cn.sub,NTP,0000,0000,0000,,Мен мүлдем бейхабармын.
Dialogue: 0,0:13:40.99,0:13:44.65,cn.sub,NTP,0000,0000,0000,,Талантың бар болса, періштесің.
Dialogue: 0,0:13:44.75,0:13:46.73,cn.sub,NTP,0000,0000,0000,,Мені құтқар
Dialogue: 0,0:13:46.78,0:13:48.76,cn.sub,NTP,0000,0000,0000,,Менің фамилиям айқайлап тұр
Dialogue: 0,0:13:48.88,0:13:50.94,cn.sub,NTP,0000,0000,0000,,Сіздің қалаған есіміңіз дұрыс емес пе?
Dialogue: 0,0:13:51.00,0:13:53.77,cn.sub,NTP,0000,0000,0000,,Аспан шыңына жеткенде секіруге болады.
Dialogue: 0,0:13:53.84,0:13:57.80,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:13:57.88,0:14:00.22,cn.sub,NTP,0000,0000,0000,,Мин Мин кемеге келді.
Dialogue: 0,0:14:00.35,0:14:01.88,cn.sub,NTP,0000,0000,0000,,Жазылмаған
Dialogue: 0,0:14:01.96,0:14:03.12,cn.sub,NTP,0000,0000,0000,,Қайырымдылық
Dialogue: 0,0:14:09.04,0:14:10.68,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:11.44,0:14:12.43,cn.sub,NTP,0000,0000,0000,,Бұл бет
Dialogue: 0,0:14:16.46,0:14:19.10,cn.sub,NTP,0000,0000,0000,,Бұл менің отбасымның Шығыс пен Батыспен ұрпақ қатынасы.
Dialogue: 0,0:14:19.96,0:14:21.39,cn.sub,NTP,0000,0000,0000,,Ақиқат – ағып жатқан нұрдың тас басы
Dialogue: 0,0:14:22.27,0:14:22.81,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:34.80,0:14:35.37,cn.sub,NTP,0000,0000,0000,,Мейірбике күтімі
Dialogue: 0,0:14:41.21,0:14:41.77,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:59.01,0:15:00.55,cn.sub,NTP,0000,0000,0000,,Мұны көрмеу үшін
Dialogue: 0,0:15:17.44,0:15:18.34,cn.sub,NTP,0000,0000,0000,,Томое
Dialogue: 0,0:15:23.83,0:15:24.87,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:27.81,0:15:28.55,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:28.63,0:15:29.61,cn.sub,NTP,0000,0000,0000,,Ынта
Dialogue: 0,0:15:29.70,0:15:30.42,cn.sub,NTP,0000,0000,0000,,Маған ұнайды
Dialogue: 0,0:15:30.56,0:15:31.73,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:31.79,0:15:35.63,cn.sub,NTP,0000,0000,0000,,Басым емес, басым, басым, жұдырығым, күшім.
Dialogue: 0,0:15:41.31,0:15:43.64,cn.sub,NTP,0000,0000,0000,,Мен айырмашылықты ұмытып қалдым.
Dialogue: 0,0:15:43.75,0:15:45.55,cn.sub,NTP,0000,0000,0000,,Тамақты ерте бастаңыз.
Dialogue: 0,0:15:45.62,0:15:47.11,cn.sub,NTP,0000,0000,0000,,Сеннари жуу
Dialogue: 0,0:15:50.42,0:15:51.27,cn.sub,NTP,0000,0000,0000,,Сондай-ақ шашқа арналған сүлгі
Dialogue: 0,0:15:51.43,0:15:52.56,cn.sub,NTP,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:16:11.47,0:16:12.55,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:16:16.24,0:16:19.81,cn.sub,NTP,0000,0000,0000,,Нозоми Нозоми
Dialogue: 0,0:16:29.13,0:16:31.67,cn.sub,NTP,0000,0000,0000,,Бұл менің кемедегі әкем.
Dialogue: 0,0:16:32.55,0:16:34.84,cn.sub,NTP,0000,0000,0000,,Ауада қалқымалы арал
Dialogue: 0,0:16:34.92,0:16:36.67,cn.sub,NTP,0000,0000,0000,,Ауада қалқымалы арал?
Dialogue: 0,0:16:36.77,0:16:39.30,cn.sub,NTP,0000,0000,0000,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:16:39.38,0:16:41.30,cn.sub,NTP,0000,0000,0000,,Алайда мен оны көрдім.
Dialogue: 0,0:17:19.32,0:17:21.30,cn.sub,NTP,0000,0000,0000,,Бұл сол кезде болған оқиға.
Dialogue: 0,0:17:22.23,0:17:25.06,cn.sub,NTP,0000,0000,0000,,《》
Dialogue: 0,0:17:25.14,0:17:26.99,cn.sub,NTP,0000,0000,0000,,Дегенмен, бұл жай ғана елес.
Dialogue: 0,0:17:27.06,0:17:28.87,cn.sub,NTP,0000,0000,0000,,Бұл менің әкемнің бейнелі қиялы
Dialogue: 0,0:17:29.94,0:17:31.81,cn.sub,NTP,0000,0000,0000,,Басқа сөздер Қазіргі уақытта адам тұрмайтын қамал ауылы
Dialogue: 0,0:17:31.84,0:17:34.19,cn.sub,NTP,0000,0000,0000,,Алтын-күміс қазынасының көп мөлшері
Dialogue: 0,0:17:34.26,0:17:36.18,cn.sub,NTP,0000,0000,0000,,Басқалармен қарым-қатынас жасауға болады ма?
Dialogue: 0,0:17:38.93,0:17:41.33,cn.sub,NTP,0000,0000,0000,,Бұл жұмыс басқа жұмыстарға байланысты өткен.
Dialogue: 0,0:17:48.05,0:17:50.29,cn.sub,NTP,0000,0000,0000,,Бұл менің кінәм емес.
Dialogue: 0,0:17:51.30,0:17:52.93,cn.sub,NTP,0000,0000,0000,,Қазіргі уақытта мен ұшақтамын
Dialogue: 0,0:17:53.00,0:17:55.19,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:06.47,0:18:08.67,cn.sub,NTP,0000,0000,0000,,Бұл пойыз.
Dialogue: 0,0:18:08.95,0:18:10.39,cn.sub,NTP,0000,0000,0000,,Насаи халқы теңіз ұрылары
Dialogue: 0,0:18:11.80,0:18:13.62,cn.sub,NTP,0000,0000,0000,,Басқа ұшатын қайықтар
Dialogue: 0,0:18:14.66,0:18:15.96,cn.sub,NTP,0000,0000,0000,,Басқа мақсаттар осында.
Dialogue: 0,0:18:16.05,0:18:16.63,cn.sub,NTP,0000,0000,0000,,Жақсы сурет
Dialogue: 0,0:18:16.71,0:18:17.56,cn.sub,NTP,0000,0000,0000,,Сәттілік
Dialogue: 0,0:18:24.20,0:18:24.67,cn.sub,NTP,0000,0000,0000,,Йошиёши Хаяками
Dialogue: 0,0:18:25.40,0:18:26.36,cn.sub,NTP,0000,0000,0000,,Ол өзінің Стэндін шығарды. Оған кім қарсы шығады?
Dialogue: 0,0:18:27.29,0:18:29.15,cn.sub,NTP,0000,0000,0000,,Ондық, біздің төтенше жағдай, жақсы жақтары
Dialogue: 0,0:18:29.23,0:18:31.56,cn.sub,NTP,0000,0000,0000,,Кішкентай қыз көптен бері жүр
Dialogue: 0,0:18:31.62,0:18:33.47,cn.sub,NTP,0000,0000,0000,,Кешегі жақсы бейне бар еді.
Dialogue: 0,0:18:33.50,0:18:35.59,cn.sub,NTP,0000,0000,0000,,Гаро Оясатоның Корейі
Dialogue: 0,0:18:36.49,0:18:37.95,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:37.99,0:18:38.73,cn.sub,NTP,0000,0000,0000,,Сау болыңыз
Dialogue: 0,0:18:40.89,0:18:42.92,cn.sub,NTP,0000,0000,0000,,Басқа адамдардың нақты мақсаты қандай?
Dialogue: 0,0:18:43.82,0:18:45.91,cn.sub,NTP,0000,0000,0000,,Лу Йи Бұл әйелдер мен балаларға арналған киім.
Dialogue: 0,0:18:45.99,0:18:47.47,cn.sub,NTP,0000,0000,0000,,Ойымды өзгерткеніме көп болды
Dialogue: 0,0:18:47.55,0:18:49.27,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:49.35,0:18:49.93,cn.sub,NTP,0000,0000,0000,,Сәттілік
Dialogue: 0,0:18:57.24,0:18:58.38,cn.sub,NTP,0000,0000,0000,,Әлі көрмеген
Dialogue: 0,0:18:58.47,0:19:01.88,cn.sub,NTP,0000,0000,0000,,Сүйкімді кішкентай мектеп
Dialogue: 0,0:19:01.95,0:19:04.98,cn.sub,NTP,0000,0000,0000,,Лаодай Лаодай
Dialogue: 0,0:19:06.84,0:19:08.76,cn.sub,NTP,0000,0000,0000,,2017 негізінен мүсіндер мен басқа да фигуралар
Dialogue: 0,0:19:12.69,0:19:15.22,cn.sub,NTP,0000,0000,0000,,Керемет жұмыс.
Dialogue: 0,0:19:19.48,0:19:20.39,cn.sub,NTP,0000,0000,0000,,Насаи халқы теңіз ұрылары
Dialogue: 0,0:19:20.46,0:19:21.67,cn.sub,NTP,0000,0000,0000,,Балаға қажетті ақпарат
Dialogue: 0,0:19:25.38,0:19:27.40,cn.sub,NTP,0000,0000,0000,,Теңіз ұрлығы? Маған мән беремін
Dialogue: 0,0:19:29.51,0:19:30.92,cn.sub,NTP,0000,0000,0000,,Рұқсат етілмейді
Dialogue: 0,0:19:32.59,0:19:33.63,cn.sub,NTP,0000,0000,0000,,Бізбен байланыс орнату
Dialogue: 0,0:19:33.75,0:19:34.81,cn.sub,NTP,0000,0000,0000,,Теңіз қарақшысы
Dialogue: 0,0:19:34.86,0:19:35.79,cn.sub,NTP,0000,0000,0000,,Бұл Була отбасы.
Dialogue: 0,0:19:35.85,0:19:38.39,cn.sub,NTP,0000,0000,0000,,Мен кеткенде мен жай ғана адам едім.
Dialogue: 0,0:19:39.74,0:19:40.55,cn.sub,NTP,0000,0000,0000,,Қарт тақта қыз
Dialogue: 0,0:19:40.62,0:19:42.09,cn.sub,NTP,0000,0000,0000,,Тезірек қашып кет
Dialogue: 0,0:19:42.12,0:19:42.83,cn.sub,NTP,0000,0000,0000,,Гайя Канамеге қатысу шайқасы
Dialogue: 0,0:19:43.78,0:19:45.35,cn.sub,NTP,0000,0000,0000,,Қандай қаруды қолдануға болады?
Dialogue: 0,0:19:45.46,0:19:46.10,cn.sub,NTP,0000,0000,0000,,Мүмкін...
Dialogue: 0,0:19:46.44,0:19:49.08,cn.sub,NTP,0000,0000,0000,,Бұл қызға ұнайды.
Dialogue: 0,0:19:52.89,0:19:54.40,cn.sub,NTP,0000,0000,0000,,Елордаға барғыңыз келмейді.
Dialogue: 0,0:19:54.46,0:19:56.38,cn.sub,NTP,0000,0000,0000,,Бұл ер адамның жұдырықтай сөйлеген сөзі.
Dialogue: 0,0:19:56.46,0:19:58.14,cn.sub,NTP,0000,0000,0000,,Иә! Мағыналы!
Dialogue: 0,0:19:59.56,0:20:00.76,cn.sub,NTP,0000,0000,0000,,Дайжді құлату және т.б.
Dialogue: 0,0:20:13.04,0:20:15.26,cn.sub,NTP,0000,0000,0000,,Жоғарғы жаққа қарау
Dialogue: 0,0:20:23.74,0:20:24.61,cn.sub,NTP,0000,0000,0000,,және интернатта тұратын оқушылар мен күндізгі бөлімде оқитындар арасында шиеленіс бар.
Dialogue: 0,0:20:27.53,0:20:29.60,cn.sub,NTP,0000,0000,0000,,Бізге қонаққа кім келді?
Dialogue: 0,0:20:48.35,0:20:49.60,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:20:57.47,0:20:58.56,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:21:25.36,0:21:27.47,cn.sub,NTP,0000,0000,0000,,Мен осы жерден жұмысқа тұра аламын ба?
Dialogue: 0,0:21:27.55,0:21:28.22,cn.sub,NTP,0000,0000,0000,,Менің артымнан жүр
Dialogue: 0,0:21:41.59,0:21:42.17,cn.sub,NTP,0000,0000,0000,,Алайда, әрқашан аңсаған полиция қызметкері болғаннан кейін көп ұзамай
Dialogue: 0,0:21:44.17,0:21:46.96,cn.sub,NTP,0000,0000,0000,,Томое Банның кету кездесуі?
Dialogue: 0,0:21:47.05,0:21:47.97,cn.sub,NTP,0000,0000,0000,,Сұрақтарыңыз болса, бізге хабарласыңыз.
Dialogue: 0,0:21:51.83,0:21:53.01,cn.sub,NTP,0000,0000,0000,,Бұл Була отбасы.
Dialogue: 0,0:21:53.09,0:21:54.42,cn.sub,NTP,0000,0000,0000,,Теңіз ұры емес
Dialogue: 0,0:21:54.47,0:21:55.81,cn.sub,NTP,0000,0000,0000,,Бөлме ауылы
Dialogue: 0,0:21:55.86,0:21:56.74,cn.sub,NTP,0000,0000,0000,,Полиция бөлімі
Dialogue: 0,0:21:56.76,0:21:58.50,cn.sub,NTP,0000,0000,0000,,Гачидёрё, келесі ұрпақ
Dialogue: 0,0:21:58.58,0:21:59.09,cn.sub,NTP,0000,0000,0000,,Қайырымдылық
Dialogue: 0,0:22:05.62,0:22:06.89,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:22:10.41,0:22:12.17,cn.sub,NTP,0000,0000,0000,,Балаларым!
Dialogue: 0,0:22:12.23,0:22:13.35,cn.sub,NTP,0000,0000,0000,,Жеңіл тасымалдау
Dialogue: 0,0:22:13.38,0:22:15.53,cn.sub,NTP,0000,0000,0000,,Алайда бұл әйелдер мен балаларға қатысты.
Dialogue: 0,0:22:15.62,0:22:18.65,cn.sub,NTP,0000,0000,0000,,Қақпаға келгеннен кейін жылдам жүгіру
Dialogue: 0,0:22:21.43,0:22:22.63,cn.sub,NTP,0000,0000,0000,,Уолтер Эванс (59)
Dialogue: 0,0:22:49.40,0:22:51.11,cn.sub,NTP,0000,0000,0000,,Томое және басқалар келді
Dialogue: 0,0:22:52.65,0:22:54.41,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:22:54.47,0:22:56.73,cn.sub,NTP,0000,0000,0000,,Бұл қызметті пайдаланудың ең жақсы уақыты.
Dialogue: 0,0:22:59.97,0:23:01.13,cn.sub,NTP,0000,0000,0000,,Мен осындамын
Dialogue: 0,0:23:10.82,0:23:13.03,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:23:27.80,0:23:29.88,cn.sub,NTP,0000,0000,0000,,Масу Гао пароходтары жетті! !
Dialogue: 0,0:23:32.97,0:23:34.20,cn.sub,NTP,0000,0000,0000,,Қайта ашу нүктесі
Dialogue: 0,0:23:35.16,0:23:35.99,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:23:38.63,0:23:39.19,cn.sub,NTP,0000,0000,0000,,Керамикалық пеш
Dialogue: 0,0:23:39.29,0:23:40.02,cn.sub,NTP,0000,0000,0000,,Қазірге дейін
Dialogue: 0,0:24:00.01,0:24:02.14,cn.sub,NTP,0000,0000,0000,,Жеңіл іздену
Dialogue: 0,0:24:14.25,0:24:15.47,cn.sub,NTP,0000,0000,0000,,Бөлек
Dialogue: 0,0:24:20.06,0:24:21.32,cn.sub,NTP,0000,0000,0000,,Мен сені ешқашан кездестірмедім.
Dialogue: 0,0:24:21.48,0:24:23.99,cn.sub,NTP,0000,0000,0000,,Тривиальды көлік тау мен аңғардың түбіне түсті.
Dialogue: 0,0:24:24.14,0:24:24.92,cn.sub,NTP,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:25.56,0:24:29.29,cn.sub,NTP,0000,0000,0000,,Сәтті табыс
Dialogue: 0,0:24:29.61,0:24:30.23,cn.sub,NTP,0000,0000,0000,,Мен саған келемін.
Dialogue: 0,0:24:30.33,0:24:31.44,cn.sub,NTP,0000,0000,0000,,Ұмытылған жүйе
Dialogue: 0,0:24:38.22,0:24:38.96,cn.sub,NTP,0000,0000,0000,,Ол өзінің Стэндін шығарды. Оған кім қарсы шығады?
Dialogue: 0,0:24:43.98,0:24:45.59,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:24:45.64,0:24:46.91,cn.sub,NTP,0000,0000,0000,,Мұны істеу мүмкін емес
Dialogue: 0,0:24:46.99,0:24:47.78,cn.sub,NTP,0000,0000,0000,,Көзге түсу
Dialogue: 0,0:24:56.43,0:24:57.01,cn.sub,NTP,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:25:03.02,0:25:06.35,cn.sub,NTP,0000,0000,0000,,Шындық - әскер келді.
Балаңызды қорғау үшін
Dialogue: 0,0:25:12.13,0:25:15.23,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:25:15.33,0:25:17.47,cn.sub,NTP,0000,0000,0000,,Қарақшылар тобын және т.б
Dialogue: 0,0:25:28.18,0:25:28.80,cn.sub,NTP,0000,0000,0000,,Сирек
Dialogue: 0,0:25:30.11,0:25:30.61,cn.sub,NTP,0000,0000,0000,,15-ші эпизод: Батырлық өлім – Екінші бөлім
Dialogue: 0,0:25:31.65,0:25:32.26,cn.sub,NTP,0000,0000,0000,,Уолтер Эванс (59)
Dialogue: 0,0:25:35.41,0:25:36.62,cn.sub,NTP,0000,0000,0000,,Сирек
Dialogue: 0,0:25:37.60,0:25:39.21,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:25:45.09,0:25:46.32,cn.sub,NTP,0000,0000,0000,,Бронды пойыз
Dialogue: 0,0:25:46.40,0:25:47.89,cn.sub,NTP,0000,0000,0000,,Автокөлікті жалға алу
Dialogue: 0,0:25:51.57,0:25:52.29,cn.sub,NTP,0000,0000,0000,,Оған күмән жоқ
Dialogue: 0,0:25:52.37,0:25:53.97,cn.sub,NTP,0000,0000,0000,,Қажетсіз таптау
Dialogue: 0,0:26:35.71,0:26:36.54,cn.sub,NTP,0000,0000,0000,,Басқалары жойылды
Dialogue: 0,0:26:36.82,0:26:39.17,cn.sub,NTP,0000,0000,0000,,Басқа көрініс
Dialogue: 0,0:27:04.31,0:27:05.11,cn.sub,NTP,0000,0000,0000,,Біз ауада қалқып келеміз
Dialogue: 0,0:27:11.66,0:27:13.87,cn.sub,NTP,0000,0000,0000,,Сізде ұшу қабілеті бар.
Dialogue: 0,0:27:16.38,0:27:18.07,cn.sub,NTP,0000,0000,0000,,Мүлдем тастың құдіреті
Dialogue: 0,0:27:18.17,0:27:19.20,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:27:36.30,0:27:38.03,cn.sub,NTP,0000,0000,0000,,Қажет емес жолдар толығымен жойылды
Dialogue: 0,0:27:44.89,0:27:46.94,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:27:47.18,0:27:48.48,cn.sub,NTP,0000,0000,0000,,Түсіру
Dialogue: 0,0:27:56.81,0:27:59.64,cn.sub,NTP,0000,0000,0000,,Не десем де, не істерімді білмеймін.
Dialogue: 0,0:28:22.21,0:28:23.41,cn.sub,NTP,0000,0000,0000,,Жану оңай
Dialogue: 0,0:28:23.50,0:28:24.59,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:28:33.65,0:28:35.57,cn.sub,NTP,0000,0000,0000,,Аспаннан аспанға келген және кеткен уақыттың сирек суреттері.
Dialogue: 0,0:28:38.50,0:28:40.06,cn.sub,NTP,0000,0000,0000,,Изеннанан бастауыш мектебінің кіреберісі
Dialogue: 0,0:28:40.22,0:28:44.95,cn.sub,NTP,0000,0000,0000,,Егер сіз ескі Ямато жүргізушісімен және басқалармен кездеспесеңіз
Dialogue: 0,0:28:45.04,0:28:47.86,cn.sub,NTP,0000,0000,0000,,Қиямадай кісіге көңіл бөлмеу
Dialogue: 0,0:28:47.95,0:28:50.19,cn.sub,NTP,0000,0000,0000,,Шығудың белгілі бір нүктесіне дейін жүгіру
Dialogue: 0,0:28:53.47,0:28:56.26,cn.sub,NTP,0000,0000,0000,,Ариза Какияма
Dialogue: 0,0:28:56.35,0:28:57.49,cn.sub,NTP,0000,0000,0000,,Үңгір бар
Dialogue: 0,0:29:10.83,0:29:11.49,cn.sub,NTP,0000,0000,0000,,Неаполь, таңғы 11:26
Dialogue: 0,0:29:12.63,0:29:14.93,cn.sub,NTP,0000,0000,0000,,Тамағымды жейтін уақыт келді.
Dialogue: 0,0:29:15.94,0:29:18.58,cn.sub,NTP,0000,0000,0000,,Бір алма, бір алма болсын
Dialogue: 0,0:29:18.71,0:29:22.22,cn.sub,NTP,0000,0000,0000,,Томенің сөмкесінің бейнесі - сиқырлы қапшық
Dialogue: 0,0:29:22.34,0:29:23.49,cn.sub,NTP,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:29:38.11,0:29:40.91,cn.sub,NTP,0000,0000,0000,,Лас таулар мен аңғарлар? Қиыр солтүстіктегі терең тау ауылы
Dialogue: 0,0:29:41.01,0:29:44.13,cn.sub,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:29:44.19,0:29:46.21,cn.sub,NTP,0000,0000,0000,,Дегенмен, бұл Фусако Вадачи орналасқан жер.
Dialogue: 0,0:29:46.29,0:29:48.27,cn.sub,NTP,0000,0000,0000,,Содан бері мен әр адамның талантын зерттей алдым.
Dialogue: 0,0:30:11.03,0:30:13.25,cn.sub,NTP,0000,0000,0000,,Қара көзілдірік ше?
Dialogue: 0,0:30:13.30,0:30:13.89,cn.sub,NTP,0000,0000,0000,,Ауырды! Өте қатты ауырды! Тоқта, тоқта! Қол тигізбе!
Dialogue: 0,0:30:14.21,0:30:15.49,cn.sub,NTP,0000,0000,0000,,Дарынды адам - ​​оның бірінші таңдауы.
Dialogue: 0,0:30:16.43,0:30:19.60,cn.sub,NTP,0000,0000,0000,,Екіншісі - әскерилермен араласқан әскерилер.
Dialogue: 0,0:30:20.95,0:30:24.21,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:30:24.31,0:30:28.90,cn.sub,NTP,0000,0000,0000,,Алдыңғы Гато Ширандоның тылсым күші.
Dialogue: 0,0:30:29.03,0:30:32.95,cn.sub,NTP,0000,0000,0000,,Бұл – ұрпақ қазынасы
Dialogue: 0,0:30:33.03,0:30:35.51,cn.sub,NTP,0000,0000,0000,,Анам мен әкем өлер алдында қайтыс болды.
Dialogue: 0,0:30:35.60,0:30:39.28,cn.sub,NTP,0000,0000,0000,,Түсіну мүмкін емес
Dialogue: 0,0:30:39.36,0:30:44.77,cn.sub,NTP,0000,0000,0000,,Бұл менің әкемнің әкесінің баласы.
Dialogue: 0,0:30:44.88,0:30:48.71,cn.sub,NTP,0000,0000,0000,,Бұл менде жоқ болғандықтан болмайды.
Dialogue: 0,0:30:48.79,0:30:51.06,cn.sub,NTP,0000,0000,0000,,Сенің көкке келгеніңді көргенде мені көрмеу
Dialogue: 0,0:30:51.12,0:30:51.94,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:30:52.03,0:30:54.64,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:31:09.63,0:31:12.08,cn.sub,NTP,0000,0000,0000,,Гоблин
Dialogue: 0,0:31:12.20,0:31:14.88,cn.sub,NTP,0000,0000,0000,,Фума коко! Өлгенді ұнататын адам
Dialogue: 0,0:31:14.96,0:31:15.78,cn.sub,NTP,0000,0000,0000,,Фума коко!
Dialogue: 0,0:31:16.69,0:31:18.64,cn.sub,NTP,0000,0000,0000,,Менің лабиринтім
Dialogue: 0,0:31:18.74,0:31:22.39,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:31:23.51,0:31:27.54,cn.sub,NTP,0000,0000,0000,,Кішкентай қыз бар
Dialogue: 0,0:31:27.54,0:31:29.37,cn.sub,NTP,0000,0000,0000,,Қарақшылардың ізіне түсу
Dialogue: 0,0:31:32.19,0:31:32.19,cn.sub,NTP,0000,0000,0000,,Онда да әскерилер бар.
Dialogue: 0,0:31:32.19,0:31:36.33,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:31:47.66,0:31:49.22,cn.sub,NTP,0000,0000,0000,,Сәттілік
Dialogue: 0,0:31:49.34,0:31:50.18,cn.sub,NTP,0000,0000,0000,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:31:51.67,0:31:53.82,cn.sub,NTP,0000,0000,0000,,Экиичи Эйичидің жертөлесі?
Dialogue: 0,0:31:53.90,0:31:56.82,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:31:56.94,0:32:00.65,cn.sub,NTP,0000,0000,0000,,Кеше түнде болған оғаш операция
Dialogue: 0,0:32:01.37,0:32:04.34,cn.sub,NTP,0000,0000,0000,,Бұл мүмкін деп үміттенемін.
Dialogue: 0,0:32:04.46,0:32:05.77,cn.sub,NTP,0000,0000,0000,,Тастан шыққан жұмбақ дауыс?
Dialogue: 0,0:32:15.45,0:32:19.78,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:32:53.99,0:32:54.89,cn.sub,NTP,0000,0000,0000,,Райо Коуки
Dialogue: 0,0:32:55.88,0:32:57.30,cn.sub,NTP,0000,0000,0000,,Томое! жоғарғы көрініс
Dialogue: 0,0:32:58.28,0:32:58.93,cn.sub,NTP,0000,0000,0000,,Айқай!
Dialogue: 0,0:33:09.63,0:33:11.70,cn.sub,NTP,0000,0000,0000,,Бұл кәдімгі таланттың аз ғана бөлігі.
Dialogue: 0,0:33:12.37,0:33:13.17,cn.sub,NTP,0000,0000,0000,,Шин кетіп бара жатыр
Dialogue: 0,0:33:13.54,0:33:16.02,cn.sub,NTP,0000,0000,0000,,Ағымдағы дәстүрлі күтім
Dialogue: 0,0:33:26.94,0:33:27.86,cn.sub,NTP,0000,0000,0000,,Жану
Dialogue: 0,0:33:27.95,0:33:31.97,cn.sub,NTP,0000,0000,0000,,Құрамында тас бөлшектері бар ұшатын тас тәрізді компоненттер
Dialogue: 0,0:33:32.13,0:33:32.86,cn.sub,NTP,0000,0000,0000,,Ұшатын тас?
Dialogue: 0,0:33:35.92,0:33:40.34,cn.sub,NTP,0000,0000,0000,,Ұшқан тастың бейнесі кәдімгі тасқа өзгертілген.
Dialogue: 0,0:33:46.30,0:33:47.22,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:33:48.91,0:33:50.80,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:33:51.02,0:33:53.78,cn.sub,NTP,0000,0000,0000,,Сіз тас хрусталь ұшып бара жатырсыз
Dialogue: 0,0:33:53.97,0:33:56.80,cn.sub,NTP,0000,0000,0000,,Бұл менің бірінші келуім.
Dialogue: 0,0:33:59.38,0:34:01.98,cn.sub,NTP,0000,0000,0000,,Бұл біртүрлі сезім
Dialogue: 0,0:34:02.26,0:34:04.67,cn.sub,NTP,0000,0000,0000,,тылсым күш
Dialogue: 0,0:34:05.76,0:34:11.60,cn.sub,NTP,0000,0000,0000,,Ауданның шығысы мен батысында жасалған және жасалған адам талантының бейнесі
Dialogue: 0,0:34:11.76,0:34:13.06,cn.sub,NTP,0000,0000,0000,,Ұрлаушы?
Dialogue: 0,0:34:13.15,0:34:17.49,cn.sub,NTP,0000,0000,0000,,Күндізгі ауада ұшу
Dialogue: 0,0:34:17.49,0:34:19.21,cn.sub,NTP,0000,0000,0000,,Жалпы! Нағыз тіршілік!
Dialogue: 0,0:34:19.48,0:34:21.42,cn.sub,NTP,0000,0000,0000,,сирек кездесетіні анық
Dialogue: 0,0:34:21.66,0:34:24.90,cn.sub,NTP,0000,0000,0000,,Сіз аралдың қай жеріндесіз?
Dialogue: 0,0:34:26.92,0:34:27.85,cn.sub,NTP,0000,0000,0000,,Фума коко?
Dialogue: 0,0:34:28.89,0:34:32.09,cn.sub,NTP,0000,0000,0000,,Оны қабылдаңыз.
Dialogue: 0,0:34:32.19,0:34:33.51,cn.sub,NTP,0000,0000,0000,,Мен сені асыға күтемін
Dialogue: 0,0:34:34.97,0:34:35.69,cn.sub,NTP,0000,0000,0000,,Жақсы дәм
Dialogue: 0,0:34:37.37,0:34:38.65,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:34:49.40,0:34:51.66,cn.sub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:34:51.77,0:34:56.49,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:34:56.63,0:35:00.54,cn.sub,NTP,0000,0000,0000,,Мен ұшағымның өткенін осылай көрдім.
Dialogue: 0,0:35:00.62,0:35:03.13,cn.sub,NTP,0000,0000,0000,,Әкемнің өлімі сирек
Dialogue: 0,0:35:04.04,0:35:08.22,cn.sub,NTP,0000,0000,0000,,…
Dialogue: 0,0:35:08.31,0:35:09.29,cn.sub,NTP,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:35:10.97,0:35:13.69,cn.sub,NTP,0000,0000,0000,,Сіздің қабілетіңіз күшті
Dialogue: 0,0:35:13.88,0:35:18.52,cn.sub,NTP,0000,0000,0000,,Менің әкеммен бірге тұрғаным көп жылдан бері белгілі болды.
Dialogue: 0,0:35:19.20,0:35:26.23,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:35:26.40,0:35:27.04,cn.sub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:35:28.04,0:35:31.42,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:35:31.55,0:35:34.65,cn.sub,NTP,0000,0000,0000,,Өзіңізді күтіңіз.
Dialogue: 0,0:35:35.26,0:35:40.06,cn.sub,NTP,0000,0000,0000,,Сайфу кездесуі 3.
Dialogue: 0,0:35:40.17,0:35:43.64,cn.sub,NTP,0000,0000,0000,,Үлкен таяқ! Шынайы болмыс
Dialogue: 0,0:35:52.90,0:35:54.21,cn.sub,NTP,0000,0000,0000,,Басқаларды сағыну
Dialogue: 0,0:35:54.31,0:35:56.45,cn.sub,NTP,0000,0000,0000,,Мен кемеден шыққан кезде
Dialogue: 0,0:35:56.58,0:36:00.37,cn.sub,NTP,0000,0000,0000,,Жатқан жерің жайлы, қазір белсенді емеспін.
Dialogue: 0,0:36:02.50,0:36:04.19,cn.sub,NTP,0000,0000,0000,,Сюзи жақсы тамақ
Dialogue: 0,0:36:05.89,0:36:07.47,cn.sub,NTP,0000,0000,0000,,Мен өмірден айырылдым.
Dialogue: 0,0:36:08.42,0:36:09.79,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:36:09.90,0:36:11.59,cn.sub,NTP,0000,0000,0000,,Көп тұрғын үй
Dialogue: 0,0:36:32.18,0:36:33.70,cn.sub,NTP,0000,0000,0000,,Керемет!
Dialogue: 0,0:36:49.54,0:36:53.95,cn.sub,NTP,0000,0000,0000,,Наката аралындағы жағажайға келгенде, аралды көрмей қалдым.
Dialogue: 0,0:36:55.94,0:36:57.60,cn.sub,NTP,0000,0000,0000,,Каюун!
Dialogue: 0,0:36:57.66,0:36:59.38,cn.sub,NTP,0000,0000,0000,,Мен сені кездестіретініме сенімдімін.
Dialogue: 0,0:36:59.44,0:37:00.27,cn.sub,NTP,0000,0000,0000,,Томое!
Dialogue: 0,0:37:01.73,0:37:04.03,cn.sub,NTP,0000,0000,0000,,Қолайсыздықтар үшін кешірім сұраймын.
Dialogue: 0,0:37:05.01,0:37:08.27,cn.sub,NTP,0000,0000,0000,,Накореку алдындағы менің отбасымның құпия тегі
Dialogue: 0,0:37:08.37,0:37:12.13,cn.sub,NTP,0000,0000,0000,,Осы кезде мен де тас бастың атын қабылдадым.
Dialogue: 0,0:37:13.33,0:37:16.37,cn.sub,NTP,0000,0000,0000,,Бұл атау есімнің аты.
Dialogue: 0,0:37:16.50,0:37:19.89,cn.sub,NTP,0000,0000,0000,,···
Dialogue: 0,0:37:20.19,0:37:22.53,cn.sub,NTP,0000,0000,0000,,…
Dialogue: 0,0:37:26.27,0:37:28.16,cn.sub,NTP,0000,0000,0000,,Бұл әскер! Туылған күніңмен!
Dialogue: 0,0:37:33.94,0:37:34.74,cn.sub,NTP,0000,0000,0000,,Кайудо ауылы!
Dialogue: 0,0:37:37.30,0:37:38.59,cn.sub,NTP,0000,0000,0000,,Тағы бір қадам!
Dialogue: 0,0:37:38.72,0:37:39.71,cn.sub,NTP,0000,0000,0000,,Сіз бұл туралы ойладыңыз!
Dialogue: 0,0:37:42.43,0:37:43.84,cn.sub,NTP,0000,0000,0000,,Томое! Жіберу!
Dialogue: 0,0:37:46.35,0:37:49.44,cn.sub,NTP,0000,0000,0000,,Томое! Томое! Томое! Томое!
Dialogue: 0,0:37:51.06,0:37:52.14,cn.sub,NTP,0000,0000,0000,,Кешіріңіз!
Dialogue: 0,0:37:52.24,0:37:53.76,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:38:29.04,0:38:30.22,cn.sub,NTP,0000,0000,0000,,Маған ашуға рұқсат етіңіз! Ашу оңай!
Dialogue: 0,0:38:35.84,0:38:36.53,cn.sub,NTP,0000,0000,0000,,Сирек!
Dialogue: 0,0:38:41.67,0:38:43.81,cn.sub,NTP,0000,0000,0000,,Командалар жолы! Тапсырыс беріңіз!
Dialogue: 0,0:39:14.55,0:39:19.24,cn.sub,NTP,0000,0000,0000,,Қалың жауап! Өзімнің әңгімемнің шығу тегі кездесуге шақыру
Dialogue: 0,0:39:19.43,0:39:21.67,cn.sub,NTP,0000,0000,0000,,На - әскери адам
Dialogue: 0,0:39:21.85,0:39:25.37,cn.sub,NTP,0000,0000,0000,,Ашкөздік пен жылдамдық
Dialogue: 0,0:39:25.43,0:39:28.15,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:39:28.23,0:39:31.04,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:39:31.84,0:39:35.09,cn.sub,NTP,0000,0000,0000,,Бұл құпия ақпаратты пайдаланудың басқаларға жарияланбауымен байланысты.
Dialogue: 0,0:39:35.22,0:39:35.99,cn.sub,NTP,0000,0000,0000,,Қайырымдылық? Оннан бір бөлігі?
Dialogue: 0,0:39:36.23,0:39:38.58,cn.sub,NTP,0000,0000,0000,,Бұл менің ішкі жұмысым.
Dialogue: 0,0:39:38.69,0:39:43.29,cn.sub,NTP,0000,0000,0000,,Әскер қажет болған жағдайда ғана қол жетімді.
Dialogue: 0,0:39:45.53,0:39:49.48,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:39:50.25,0:39:54.40,cn.sub,NTP,0000,0000,0000,,Әрине, бірақ мені тікелей үкімет тағайындайды.
Dialogue: 0,0:39:57.83,0:40:00.69,cn.sub,NTP,0000,0000,0000,,Иә! Арнайы бөлімнің түкті баласы!
Dialogue: 0,0:40:18.39,0:40:19.67,cn.sub,NTP,0000,0000,0000,,Сіз жақсы ұйықтай аласыз ба?
Dialogue: 0,0:40:19.75,0:40:21.99,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:40:22.12,0:40:24.13,cn.sub,NTP,0000,0000,0000,,Киіміңізге көңіліңіз толмай ма?
Dialogue: 0,0:40:24.25,0:40:26.28,cn.sub,NTP,0000,0000,0000,,Қажетсіз төлемдер және т.б.
Dialogue: 0,0:40:26.37,0:40:29.19,cn.sub,NTP,0000,0000,0000,,Нагано тас дорбасын салыстыру
Dialogue: 0,0:40:29.30,0:40:33.05,cn.sub,NTP,0000,0000,0000,,Шығыс Батысқа келу
Dialogue: 0,0:40:47.76,0:40:48.66,cn.sub,NTP,0000,0000,0000,,Жалғасы
Dialogue: 0,0:40:54.68,0:40:55.28,cn.sub,NTP,0000,0000,0000,,Ах!
Dialogue: 0,0:41:08.18,0:41:08.71,cn.sub,NTP,0000,0000,0000,,Бұл…
Dialogue: 0,0:41:09.62,0:41:12.68,cn.sub,NTP,0000,0000,0000,,Шығыс пен Батыста жеткілікті билік болуы керек.
Dialogue: 0,0:41:12.79,0:41:15.16,cn.sub,NTP,0000,0000,0000,,Ауадан түсудің қажеті жоқ
Dialogue: 0,0:41:15.19,0:41:17.72,cn.sub,NTP,0000,0000,0000,,Қайтыс болған адамдардың болуы
Dialogue: 0,0:41:34.90,0:41:37.41,cn.sub,NTP,0000,0000,0000,,Шығыс пен Батыстың айырмашылығы неде?
Dialogue: 0,0:41:37.56,0:41:40.52,cn.sub,NTP,0000,0000,0000,,Физикалық денесі металл, денесі саз.
Dialogue: 0,0:41:40.56,0:41:44.01,cn.sub,NTP,0000,0000,0000,,Менің ғылыми қабілетім тегін.
Dialogue: 0,0:41:44.74,0:41:45.84,cn.sub,NTP,0000,0000,0000,,Қайдан келдің
Dialogue: 0,0:41:45.96,0:41:49.83,cn.sub,NTP,0000,0000,0000,,Мен болған кезде қажетсіз зиян
Dialogue: 0,0:41:56.92,0:41:57.75,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:42:03.75,0:42:07.01,cn.sub,NTP,0000,0000,0000,,Үйдің қабырғасындағы мөр
Dialogue: 0,0:42:07.13,0:42:09.51,cn.sub,NTP,0000,0000,0000,,Тас басы да бар
Dialogue: 0,0:42:10.65,0:42:13.36,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:42:16.39,0:42:17.69,cn.sub,NTP,0000,0000,0000,,Бірлестік иесі
Dialogue: 0,0:42:17.78,0:42:22.80,cn.sub,NTP,0000,0000,0000,,Ауаға жету үшін саусақты тікелей ұстаңыз
Dialogue: 0,0:42:22.88,0:42:24.97,cn.sub,NTP,0000,0000,0000,,Сайбуқай! Мен Шираничимін!
Dialogue: 0,0:42:26.76,0:42:27.61,cn.sub,NTP,0000,0000,0000,,Бұл туралы ойлану керек.
Dialogue: 0,0:42:27.69,0:42:29.96,cn.sub,NTP,0000,0000,0000,,Маған жүгіруге рұқсат етіңіз
Dialogue: 0,0:42:33.99,0:42:39.09,cn.sub,NTP,0000,0000,0000,,Сізге қазына аралына назар аударудың қажеті жоқ.
Dialogue: 0,0:42:39.19,0:42:43.03,cn.sub,NTP,0000,0000,0000,,Ауаға келген адамның ғылыми қабілеті
Dialogue: 0,0:42:43.09,0:42:46.45,cn.sub,NTP,0000,0000,0000,,Бүкіл жер тежелген, бұл қорқынышты империя
Dialogue: 0,0:42:47.62,0:42:51.88,cn.sub,NTP,0000,0000,0000,,Бейне шығыстың шығысында және ауада.
Dialogue: 0,0:42:51.97,0:42:56.18,cn.sub,NTP,0000,0000,0000,,Бейбітшіліктің біз үшін маңызы қандай?
Dialogue: 0,0:42:56.26,0:42:58.32,cn.sub,NTP,0000,0000,0000,,Сіз мұны бірге жасай аласыз деп үміттенемін.
Dialogue: 0,0:42:58.40,0:43:01.62,cn.sub,NTP,0000,0000,0000,,Ұшатын тастың орнын көрсету
Dialogue: 0,0:43:01.72,0:43:04.74,cn.sub,NTP,0000,0000,0000,,Сіз мынаны оқи аласыз
Dialogue: 0,0:43:04.84,0:43:08.95,cn.sub,NTP,0000,0000,0000,,Мен шындықты білмеймін.
Dialogue: 0,0:43:09.06,0:43:12.25,cn.sub,NTP,0000,0000,0000,,Мені елестету мүмкін емес
Dialogue: 0,0:43:12.34,0:43:15.72,cn.sub,NTP,0000,0000,0000,,Сіз өз тағдырыңызды басқарасыз.
Dialogue: 0,0:43:17.86,0:43:20.22,cn.sub,NTP,0000,0000,0000,,Бізбен келісуіңіз қажет.
Dialogue: 0,0:43:20.30,0:43:22.61,cn.sub,NTP,0000,0000,0000,,Біз басқалармен кездесе аламыз.
Dialogue: 0,0:43:23.38,0:43:26.92,cn.sub,NTP,0000,0000,0000,,···
Dialogue: 0,0:43:28.31,0:43:29.62,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:43:29.74,0:43:31.45,cn.sub,NTP,0000,0000,0000,,""""
Dialogue: 0,0:43:31.54,0:43:33.24,cn.sub,NTP,0000,0000,0000,,«Таяка» «шын»
Dialogue: 0,0:43:33.35,0:43:37.75,cn.sub,NTP,0000,0000,0000,,Сіз Император үйінің ресми мұрагерісіз, патшайым Лу Сида.
Dialogue: 0,0:43:57.50,0:43:58.01,cn.sub,NTP,0000,0000,0000,,Дайын!
Dialogue: 0,0:44:01.02,0:44:02.21,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:44:02.94,0:44:04.35,cn.sub,NTP,0000,0000,0000,,Томое үшін жақсы ма?
Dialogue: 0,0:44:04.43,0:44:07.42,cn.sub,NTP,0000,0000,0000,,Сізге не ұнайды? Тағы кімге барғың келді?
Dialogue: 0,0:44:07.61,0:44:11.10,cn.sub,NTP,0000,0000,0000,,Томое-кун, маған хабарлаңыз.
Dialogue: 0,0:44:11.17,0:44:16.86,cn.sub,NTP,0000,0000,0000,,Мен сіздің теңіз ұрысын құтқару үшін келген жолыңыздан бейхабармын.
Dialogue: 0,0:44:16.96,0:44:18.14,cn.sub,NTP,0000,0000,0000,,Менің көңілім қалды
Dialogue: 0,0:44:18.99,0:44:20.54,cn.sub,NTP,0000,0000,0000,,Томе жауаптары
Dialogue: 0,0:44:20.64,0:44:22.48,cn.sub,NTP,0000,0000,0000,,Ұмыттың ба?
Dialogue: 0,0:44:23.18,0:44:24.35,cn.sub,NTP,0000,0000,0000,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:44:24.45,0:44:27.36,cn.sub,NTP,0000,0000,0000,,Әскери қамтамасыз ету
Dialogue: 0,0:44:27.42,0:44:30.16,cn.sub,NTP,0000,0000,0000,,Әскери шешім қабылдау жиналысының құпия прецеденті
Dialogue: 0,0:44:30.25,0:44:32.09,cn.sub,NTP,0000,0000,0000,,Ақылдың өзін-өзі тануы
Dialogue: 0,0:44:32.16,0:44:33.58,cn.sub,NTP,0000,0000,0000,,Алайда мен бұл оқиғаға араласқым келмейді.
Dialogue: 0,0:44:33.65,0:44:35.29,cn.sub,NTP,0000,0000,0000,,Бұл рас па? На…
Dialogue: 0,0:44:35.36,0:44:38.03,cn.sub,NTP,0000,0000,0000,,Оны қабылдаңыз
Dialogue: 0,0:44:38.13,0:44:40.48,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:44:40.57,0:44:44.28,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:44:45.10,0:44:45.85,cn.sub,NTP,0000,0000,0000,,Қайта кездескенше!
Dialogue: 0,0:44:45.90,0:44:48.53,cn.sub,NTP,0000,0000,0000,,Сирек! т.б.!
Dialogue: 0,0:44:48.59,0:44:51.40,cn.sub,NTP,0000,0000,0000,,Уақытыңызды алыңыз!
Dialogue: 0,0:44:52.51,0:44:53.82,cn.sub,NTP,0000,0000,0000,,Сирек!
Dialogue: 0,0:45:01.85,0:45:05.92,cn.sub,NTP,0000,0000,0000,,Бұл кішігірім ниет, ниеттің қысқаша көрінісі, содан кейін ол босатылады!
Dialogue: 0,0:45:43.58,0:45:47.08,cn.sub,NTP,0000,0000,0000,,Тас басынан шыққан жағымды сөздер
Dialogue: 0,0:45:48.17,0:45:51.42,cn.sub,NTP,0000,0000,0000,,Тек сеніп, сеніміңді сақтау керек.
Dialogue: 0,0:45:57.76,0:45:59.07,cn.sub,NTP,0000,0000,0000,,Томое!
Dialogue: 0,0:46:19.03,0:46:22.65,cn.sub,NTP,0000,0000,0000,,Бұл Томое, Томое қайтып келді.
Dialogue: 0,0:46:24.83,0:46:25.72,cn.sub,NTP,0000,0000,0000,,Томое!
Dialogue: 0,0:46:27.04,0:46:30.46,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:46:32.25,0:46:33.40,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:46:33.50,0:46:34.60,cn.sub,NTP,0000,0000,0000,,Тағы бір сұрақ
Dialogue: 0,0:46:36.31,0:46:38.04,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:47:12.54,0:47:13.85,cn.sub,NTP,0000,0000,0000,,Жібер! Оқасы жоқ!
Dialogue: 0,0:47:13.92,0:47:16.92,cn.sub,NTP,0000,0000,0000,,Нақты өзгерістер
Dialogue: 0,0:47:17.42,0:47:19.11,cn.sub,NTP,0000,0000,0000,,Алдын ала қарыз алу
Dialogue: 0,0:47:19.18,0:47:24.32,cn.sub,NTP,0000,0000,0000,,Кетіңіз! Бұл менің үйім!
Dialogue: 0,0:47:24.41,0:47:27.10,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:47:27.34,0:47:30.03,cn.sub,NTP,0000,0000,0000,,Балаларды балалардан қорғай алмау
Dialogue: 0,0:47:30.14,0:47:30.73,cn.sub,NTP,0000,0000,0000,,ол ешқашан да жақсы ана болған жоқ
Dialogue: 0,0:47:30.81,0:47:32.65,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:47:32.75,0:47:35.63,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:47:35.71,0:47:37.61,cn.sub,NTP,0000,0000,0000,,Талант жоқ! Мен өте дарындымын!
Dialogue: 0,0:47:37.71,0:47:40.85,cn.sub,NTP,0000,0000,0000,,Егер мұны басқалармен растағыңыз келсе, төмендегіні оқыңыз.
Dialogue: 0,0:47:40.96,0:47:45.60,cn.sub,NTP,0000,0000,0000,,Сондықтан мен кеттім...
Dialogue: 0,0:47:45.69,0:47:49.93,cn.sub,NTP,0000,0000,0000,,Адам! Сондықтан мен тағы да осындамын.
Dialogue: 0,0:47:50.06,0:47:53.15,cn.sub,NTP,0000,0000,0000,,Сіз ұлсыз ба? Қамшы?
Dialogue: 0,0:47:53.29,0:47:56.84,cn.sub,NTP,0000,0000,0000,,Тағы бір шайқас! Сізге де келу керек пе?
Dialogue: 0,0:47:56.96,0:47:58.25,cn.sub,NTP,0000,0000,0000,,Әрине
Dialogue: 0,0:47:58.33,0:48:01.81,cn.sub,NTP,0000,0000,0000,,Бүкіл әлем теңіз ұры!
Dialogue: 0,0:48:01.88,0:48:06.59,cn.sub,NTP,0000,0000,0000,,Шағын отбасы туралы оғаш оқиға.
Dialogue: 0,0:48:11.07,0:48:15.16,cn.sub,NTP,0000,0000,0000,,Басқа адамдармен танысқыңыз келе ме?
Dialogue: 0,0:48:19.90,0:48:21.34,cn.sub,NTP,0000,0000,0000,,Бұл сирек кездеседі ме?
Dialogue: 0,0:48:21.44,0:48:26.05,cn.sub,NTP,0000,0000,0000,,Идиот! Әрине, мен жеңілдетуді қажет ететін жұмыс жасауды шештім!
Dialogue: 0,0:48:26.14,0:48:27.74,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:48:27.85,0:48:30.73,cn.sub,NTP,0000,0000,0000,,Бұл 50 жастағы әйел.
Dialogue: 0,0:48:30.81,0:48:32.38,cn.sub,NTP,0000,0000,0000,,Айқайлау
Dialogue: 0,0:48:32.48,0:48:35.10,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:48:35.18,0:48:37.24,cn.sub,NTP,0000,0000,0000,,Менің жыл уақытым бірдей!
Dialogue: 0,0:48:38.30,0:48:41.50,cn.sub,NTP,0000,0000,0000,,Күйеуіңіздің бейнесі туралы айту керек.
Dialogue: 0,0:48:41.61,0:48:45.84,cn.sub,NTP,0000,0000,0000,,Сурет дегеніміз не? Қызының мүсіні?
Dialogue: 0,0:48:50.94,0:48:52.00,cn.sub,NTP,0000,0000,0000,,Манами алымы!
Dialogue: 0,0:48:56.25,0:48:59.02,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:49:00.89,0:49:03.08,cn.sub,NTP,0000,0000,0000,,Сіз кемені басқаруға басқа біреуді шақырып жатырсыз ба?
Dialogue: 0,0:49:11.87,0:49:13.75,cn.sub,NTP,0000,0000,0000,,Дисквалификацияланған әйелдердің басқа талаптары ашық
Dialogue: 0,0:49:13.85,0:49:15.60,cn.sub,NTP,0000,0000,0000,,Егер қандай да бір жағымсыз тұстар болса, бізге хабарласыңыз.
Dialogue: 0,0:49:15.68,0:49:17.92,cn.sub,NTP,0000,0000,0000,,Сәттілік! Қашан келесіз?
Dialogue: 0,0:49:17.98,0:49:19.61,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:49:21.74,0:49:23.58,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:49:23.66,0:49:25.96,cn.sub,NTP,0000,0000,0000,,Мен сенің әйел дос болғаныңды қаламаймын, бірақ сенің ұшатын асыл тас болғаныңды қалаймын!
Dialogue: 0,0:49:26.06,0:49:27.60,cn.sub,NTP,0000,0000,0000,,Жарығың түкке тұрғысыз!
Dialogue: 0,0:49:27.68,0:49:30.09,cn.sub,NTP,0000,0000,0000,,Нашику өте талантты және пайдалы!
Dialogue: 0,0:49:30.16,0:49:33.02,cn.sub,NTP,0000,0000,0000,,Менің жазбамды кемпір оқи алады
Dialogue: 0,0:49:33.08,0:49:35.00,cn.sub,NTP,0000,0000,0000,,Мен сені құтқарғым келеді
Dialogue: 0,0:49:35.08,0:49:38.94,cn.sub,NTP,0000,0000,0000,,Тағы бір балалық шешім, мұндай жағдайды сіз өзіңіз шешесіз
Dialogue: 0,0:49:39.40,0:49:39.92,cn.sub,NTP,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:49:40.25,0:49:43.00,cn.sub,NTP,0000,0000,0000,,Мен де қабілетсіз мұрагермін.
Dialogue: 0,0:49:43.08,0:49:45.88,cn.sub,NTP,0000,0000,0000,,Менің жоқтығымның қазына санаты! Мені ұрлап кетті
Dialogue: 0,0:49:45.96,0:49:47.82,cn.sub,NTP,0000,0000,0000,,Ха! Эмоционалды жылау!
Dialogue: 0,0:49:47.87,0:49:48.40,cn.sub,NTP,0000,0000,0000,,Жабық тұмсық!
Dialogue: 0,0:49:48.48,0:49:49.61,cn.sub,NTP,0000,0000,0000,,Иә!
Dialogue: 0,0:49:50.59,0:49:59.85,cn.sub,NTP,0000,0000,0000,,Анықталмаған тіл.
Dialogue: 0,0:50:01.84,0:50:03.47,cn.sub,NTP,0000,0000,0000,,Біз осы уақытқа дейін қайта кездескен жоқпыз.
Dialogue: 0,0:50:03.53,0:50:04.11,cn.sub,NTP,0000,0000,0000,,Айқын!
Dialogue: 0,0:50:04.19,0:50:05.45,cn.sub,NTP,0000,0000,0000,,Негізінен жақсы психологиялық дайындық!
Dialogue: 0,0:50:05.60,0:50:06.57,cn.sub,NTP,0000,0000,0000,,Иә!
Dialogue: 0,0:50:08.70,0:50:09.95,cn.sub,NTP,0000,0000,0000,,Дайындық уақыты: 40 секунд
Dialogue: 0,0:50:19.21,0:50:20.59,cn.sub,NTP,0000,0000,0000,,Сізде үлкен қорғаныс бар
Dialogue: 0,0:50:29.40,0:50:32.67,cn.sub,NTP,0000,0000,0000,,Ясуко! Сіз үстелде күтіп отырсыз!
Dialogue: 0,0:51:05.04,0:51:06.59,cn.sub,NTP,0000,0000,0000,,Кеме жүзіп келеді!
Dialogue: 0,0:51:06.68,0:51:09.13,cn.sub,NTP,0000,0000,0000,,Анасы мен қызының ауысуы аяқталды ма?
Dialogue: 0,0:51:09.23,0:51:10.99,cn.sub,NTP,0000,0000,0000,,Клирингке сұраныс нүктесінің уақыты
Dialogue: 0,0:51:11.08,0:51:14.32,cn.sub,NTP,0000,0000,0000,,Жою жүйесі Аспанда бар уақыт азабы
Dialogue: 0,0:51:14.41,0:51:17.31,cn.sub,NTP,0000,0000,0000,,Тенрёның бірінші қызы мектептен кетеді!
Dialogue: 0,0:51:37.67,0:51:40.45,cn.sub,NTP,0000,0000,0000,,Қайта жылтыратылған Теншу Йорё
Dialogue: 0,0:51:46.76,0:51:47.51,cn.sub,NTP,0000,0000,0000,,Сирек!
Dialogue: 0,0:52:11.92,0:52:13.90,cn.sub,NTP,0000,0000,0000,,Нама касуги
Dialogue: 0,0:52:17.12,0:52:20.69,cn.sub,NTP,0000,0000,0000,,Сізге сәттілік тілеймін.
Dialogue: 0,0:52:21.52,0:52:23.78,cn.sub,NTP,0000,0000,0000,,Жарақат алған кездегі сөйлеу
Dialogue: 0,0:52:23.87,0:52:24.78,cn.sub,NTP,0000,0000,0000,,жапон?
Dialogue: 0,0:52:24.89,0:52:28.50,cn.sub,NTP,0000,0000,0000,,Өте көне құпия айтылу
Dialogue: 0,0:52:29.49,0:52:34.38,cn.sub,NTP,0000,0000,0000,,«Ли императоры, Ла Дуо Бали, Юлуо Фу, Алианаиси, Бару, Амитали»
Dialogue: 0,0:52:35.28,0:52:36.90,cn.sub,NTP,0000,0000,0000,,Император Ли Ах?
Dialogue: 0,0:52:37.97,0:52:42.67,cn.sub,NTP,0000,0000,0000,,Ниет - ``Жарықпен ояну, маған көмектесу''.
Dialogue: 0,0:52:42.78,0:52:48.69,cn.sub,NTP,0000,0000,0000,,·····
Dialogue: 0,0:52:50.03,0:52:55.55,cn.sub,NTP,0000,0000,0000,,·····
Dialogue: 0,0:53:20.26,0:53:21.23,cn.sub,NTP,0000,0000,0000,,Қалың таяқ
Dialogue: 0,0:53:28.72,0:53:30.24,cn.sub,NTP,0000,0000,0000,,Көне кітаптың көшірмесі
Dialogue: 0,0:53:30.32,0:53:32.31,cn.sub,NTP,0000,0000,0000,,Құдайдың нұры
Dialogue: 0,0:53:32.40,0:53:33.83,cn.sub,NTP,0000,0000,0000,,Құдайдың нұры?
Dialogue: 0,0:53:39.68,0:53:42.82,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:53:52.72,0:53:53.35,cn.sub,NTP,0000,0000,0000,,Оның күйеуі италиялық болды.
Dialogue: 0,0:54:04.74,0:54:05.65,cn.sub,NTP,0000,0000,0000,,Толығымен жылжытылды!
Dialogue: 0,0:54:11.22,0:54:14.67,cn.sub,NTP,0000,0000,0000,,…
Dialogue: 0,0:54:28.74,0:54:29.78,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:54:35.25,0:54:35.80,cn.sub,NTP,0000,0000,0000,,Бастау!
Dialogue: 0,0:54:36.10,0:54:36.69,cn.sub,NTP,0000,0000,0000,,Сәлеметсіз бе!
Dialogue: 0,0:54:36.80,0:54:37.62,cn.sub,NTP,0000,0000,0000,,Бұл машина адамы
Dialogue: 0,0:54:45.11,0:54:45.67,cn.sub,NTP,0000,0000,0000,,Сіз машина адамсыз ба?
Dialogue: 0,0:54:58.63,0:55:00.07,cn.sub,NTP,0000,0000,0000,,Қайдан келдің?
Dialogue: 0,0:55:05.67,0:55:06.36,cn.sub,NTP,0000,0000,0000,,Ләззат!
Dialogue: 0,0:55:13.92,0:55:16.07,cn.sub,NTP,0000,0000,0000,,Үй иесі зейнетке шығады!
Dialogue: 0,0:55:18.21,0:55:19.07,cn.sub,NTP,0000,0000,0000,,Таири зиян келтірілді!
Dialogue: 0,0:55:27.19,0:55:28.23,cn.sub,NTP,0000,0000,0000,,Түсінемін
Dialogue: 0,0:55:30.50,0:55:35.20,cn.sub,NTP,0000,0000,0000,,Бұл шамды құрылғының және адам мөрінің құлпын ашу үшін пайдаланыңыз.
Dialogue: 0,0:55:36.11,0:55:38.40,cn.sub,NTP,0000,0000,0000,,Жолдың ашылуы келді!
Dialogue: 0,0:55:38.55,0:55:39.28,cn.sub,NTP,0000,0000,0000,,Қажет емес!
Dialogue: 0,0:56:00.40,0:56:01.35,cn.sub,NTP,0000,0000,0000,,Ұшу керек пе?
Dialogue: 0,0:56:54.04,0:56:55.19,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:57:00.39,0:57:03.11,cn.sub,NTP,0000,0000,0000,,Жарықтың бағыты қайда?
Dialogue: 0,0:57:03.85,0:57:04.84,cn.sub,NTP,0000,0000,0000,,Сәттілік! Жақсы нүкте!
Dialogue: 0,0:57:04.90,0:57:09.47,cn.sub,NTP,0000,0000,0000,,Міндетті атыс? Сен ақымақсың! Бекініске барғыңыз келетініне сенімдісіз бе?
Dialogue: 0,0:57:10.31,0:57:13.37,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:57:14.38,0:57:14.89,cn.sub,NTP,0000,0000,0000,,Жақсы нәтиже
Dialogue: 0,0:57:14.98,0:57:16.07,cn.sub,NTP,0000,0000,0000,,Қосылым аяқталды
Dialogue: 0,0:57:16.14,0:57:18.41,cn.sub,NTP,0000,0000,0000,,Мен орта мектеп оқушысымын.
Dialogue: 0,0:57:18.47,0:57:20.65,cn.sub,NTP,0000,0000,0000,,Жабдықтың жойылуының аяқталу сигналы
Dialogue: 0,0:57:20.73,0:57:24.01,cn.sub,NTP,0000,0000,0000,,Жағдай шұғыл болған кезде, мен сіздің атыңыздан бағыт беремін.
Dialogue: 0,0:57:24.12,0:57:26.46,cn.sub,NTP,0000,0000,0000,,Машина адамы Охокуто Кожо Цуна биі
Dialogue: 0,0:57:26.54,0:57:30.48,cn.sub,NTP,0000,0000,0000,,Қару мен адам ресурстарын дереу іске қосу
Dialogue: 0,0:57:30.57,0:57:32.17,cn.sub,NTP,0000,0000,0000,,Тағы бір әйел қайтыс болды
Dialogue: 0,0:57:38.25,0:57:39.72,cn.sub,NTP,0000,0000,0000,,Ләззат! Жақсы нүкте!
Dialogue: 0,0:58:00.84,0:58:01.74,cn.sub,NTP,0000,0000,0000,,Ату!
Dialogue: 0,0:58:19.82,0:58:20.62,cn.sub,NTP,0000,0000,0000,,Сәлеметсіз бе!
Dialogue: 0,0:58:24.22,0:58:25.27,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:58:25.34,0:58:25.91,cn.sub,NTP,0000,0000,0000,,Үлкен таяқ!
Dialogue: 0,0:58:25.98,0:58:27.39,cn.sub,NTP,0000,0000,0000,,Қызы мен қызы!
Dialogue: 0,0:58:31.51,0:58:32.28,cn.sub,NTP,0000,0000,0000,,Өлді ме?
Dialogue: 0,0:58:33.08,0:58:33.98,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,0:58:36.46,0:58:37.96,cn.sub,NTP,0000,0000,0000,,Бітті!
Dialogue: 0,0:58:38.04,0:58:38.68,cn.sub,NTP,0000,0000,0000,,Тұр!
Dialogue: 0,0:58:40.68,0:58:41.35,cn.sub,NTP,0000,0000,0000,,Гай! Қазірдің өзінде әрекетте!
Dialogue: 0,0:59:31.67,0:59:33.59,cn.sub,NTP,0000,0000,0000,,1
Dialogue: 0,0:59:33.69,0:59:34.62,cn.sub,NTP,0000,0000,0000,,Бақытты өткен күн! Кемпір!
Dialogue: 0,0:59:34.70,0:59:36.19,cn.sub,NTP,0000,0000,0000,,Капитанға айқайлаңыз!
Dialogue: 0,0:59:42.70,0:59:44.56,cn.sub,NTP,0000,0000,0000,,Жазғы төменгі нүкте
Dialogue: 0,1:00:03.58,1:00:06.76,cn.sub,NTP,0000,0000,0000,,Sumite тағы бір шабуылды аяқтады!
Dialogue: 0,1:00:16.04,1:00:18.25,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:00:25.37,1:00:27.93,cn.sub,NTP,0000,0000,0000,,Сіздің алдыңыздағы аймаққа қайта кіру
Dialogue: 0,1:00:28.02,1:00:28.97,cn.sub,NTP,0000,0000,0000,,Ұшып өту
Dialogue: 0,1:00:29.06,1:00:30.44,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:00:30.54,1:00:31.18,cn.sub,NTP,0000,0000,0000,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,1:00:33.40,1:00:34.38,cn.sub,NTP,0000,0000,0000,,Сіз сондасыз ба?
Dialogue: 0,1:00:34.47,1:00:37.48,cn.sub,NTP,0000,0000,0000,,Зайназа шағын мұнарасының жоғарғы беті
Dialogue: 0,1:00:46.36,1:00:49.21,cn.sub,NTP,0000,0000,0000,,Бала болсаң, аман қаласың.
Dialogue: 0,1:01:01.86,1:01:03.34,cn.sub,NTP,0000,0000,0000,,Сирек
Dialogue: 0,1:01:05.87,1:01:07.23,cn.sub,NTP,0000,0000,0000,,Ағымдағы жағдайды құтқару
Dialogue: 0,1:01:07.33,1:01:08.69,cn.sub,NTP,0000,0000,0000,,Томое
Dialogue: 0,1:01:10.88,1:01:12.32,cn.sub,NTP,0000,0000,0000,,Кемпір
Dialogue: 0,1:01:16.79,1:01:20.66,cn.sub,NTP,0000,0000,0000,,Томе!
Dialogue: 0,1:01:41.65,1:01:42.43,cn.sub,NTP,0000,0000,0000,,Сирек
Dialogue: 0,1:01:45.49,1:01:46.26,cn.sub,NTP,0000,0000,0000,,Кемпір
Dialogue: 0,1:01:51.52,1:01:52.77,cn.sub,NTP,0000,0000,0000,,Томое
Dialogue: 0,1:02:03.92,1:02:05.03,cn.sub,NTP,0000,0000,0000,,Томое
Dialogue: 0,1:02:24.91,1:02:26.83,cn.sub,NTP,0000,0000,0000,,Ұшу келе жатыр!!!!!
Dialogue: 0,1:02:32.88,1:02:35.57,cn.sub,NTP,0000,0000,0000,,Бұл қайтудың соңғы мүмкіндігі.
Dialogue: 0,1:02:35.62,1:02:36.23,cn.sub,NTP,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,1:02:37.78,1:02:38.93,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:02:39.14,1:02:39.25,cn.sub,NTP,0000,0000,0000,,Мен кеттім
Dialogue: 0,1:02:39.31,1:02:40.23,cn.sub,NTP,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,1:02:42.98,1:02:44.79,cn.sub,NTP,0000,0000,0000,,Оқыңыз! үгінділер
Dialogue: 0,1:02:44.90,1:02:46.53,cn.sub,NTP,0000,0000,0000,,Сирек
Dialogue: 0,1:02:52.19,1:02:53.63,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:03:00.53,1:03:01.47,cn.sub,NTP,0000,0000,0000,,Түтін пердесі?
Dialogue: 0,1:03:15.50,1:03:17.20,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:03:17.31,1:03:20.03,cn.sub,NTP,0000,0000,0000,,Келіннің жүйрігін аяқтады
Dialogue: 0,1:03:20.10,1:03:20.82,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:03:26.21,1:03:28.35,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:03:28.43,1:03:29.89,cn.sub,NTP,0000,0000,0000,,Ұйымдастыру-іздестіру бөлімі
Dialogue: 0,1:03:44.74,1:03:46.61,cn.sub,NTP,0000,0000,0000,,Тәңірлік нұрдың жоғалуы
Dialogue: 0,1:03:49.54,1:03:51.15,cn.sub,NTP,0000,0000,0000,,Аспандағы қамалға бағдарлау
Dialogue: 0,1:03:52.87,1:03:56.31,cn.sub,NTP,0000,0000,0000,,Қолбасшының аспандағы қамалға бару туралы шешімін жариялау
Dialogue: 0,1:04:34.58,1:04:35.81,cn.sub,NTP,0000,0000,0000,,Шынайы махаббат
Dialogue: 0,1:04:36.34,1:04:40.43,cn.sub,NTP,0000,0000,0000,,Сенім және сенімсіздік.
Dialogue: 0,1:04:44.90,1:04:48.98,cn.sub,NTP,0000,0000,0000,,Сіз тұрғылықты жеріңіздің тауы мен аңғарына жеттіңіз.
Dialogue: 0,1:04:50.96,1:04:53.36,cn.sub,NTP,0000,0000,0000,,Кемпір
Dialogue: 0,1:04:53.44,1:04:54.75,cn.sub,NTP,0000,0000,0000,,Шоуга қайық ұзындығы
Dialogue: 0,1:04:54.83,1:04:58.59,cn.sub,NTP,0000,0000,0000,,Егер сізде ұшатын тас болмаса, оны пайдалануға болады.
Dialogue: 0,1:04:58.70,1:04:59.81,cn.sub,NTP,0000,0000,0000,,Менің жұмысым
Dialogue: 0,1:04:59.92,1:05:03.59,cn.sub,NTP,0000,0000,0000,,Мен аспандағы құлыптың шынайы екеніне сенемін.
Dialogue: 0,1:05:10.27,1:05:14.59,cn.sub,NTP,0000,0000,0000,,Қажетсіз қазына Аспандағы құлыптың маңызды себебін растаңыз
Dialogue: 0,1:05:14.70,1:05:17.36,cn.sub,NTP,0000,0000,0000,,Шанхайда ұрланған кеме туралы ойлайсыз ба?
Dialogue: 0,1:05:17.49,1:05:19.17,cn.sub,NTP,0000,0000,0000,,Тағы кім бар?
Dialogue: 0,1:05:19.26,1:05:22.31,cn.sub,NTP,0000,0000,0000,,Егер сізде кішігірім операция болса, оны мүмкіндігінше тез арада қабылдауға болады.
Dialogue: 0,1:05:22.48,1:05:23.04,cn.sub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,1:05:23.18,1:05:26.43,cn.sub,NTP,0000,0000,0000,,Киімді жумай-ақ жууға болады.
Dialogue: 0,1:05:26.56,1:05:28.10,cn.sub,NTP,0000,0000,0000,,Ас пісіруге арналған ыдыстардың қажеті жоқ
Dialogue: 0,1:05:28.19,1:05:31.55,cn.sub,NTP,0000,0000,0000,,Қажетсіз пиллинг
Dialogue: 0,1:05:32.03,1:05:33.11,cn.sub,NTP,0000,0000,0000,,---
Dialogue: 0,1:05:35.81,1:05:37.30,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:05:37.42,1:05:38.08,cn.sub,NTP,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,1:05:38.19,1:05:40.87,cn.sub,NTP,0000,0000,0000,,Гаман кикин етінен жасалған тоқаш
Dialogue: 0,1:05:40.99,1:05:44.66,cn.sub,NTP,0000,0000,0000,,Мен осындамын. Мен мындамын.
Dialogue: 0,1:05:44.92,1:05:46.25,cn.sub,NTP,0000,0000,0000,,Кешіріңіз!
Dialogue: 0,1:05:46.35,1:05:49.26,cn.sub,NTP,0000,0000,0000,,Қандай шындық?
Dialogue: 0,1:06:36.15,1:06:36.65,cn.sub,NTP,0000,0000,0000,,Төмен түсу
Dialogue: 0,1:06:41.27,1:06:43.37,cn.sub,NTP,0000,0000,0000,,Шүберек Қайықтарға арналған матаны орау
Dialogue: 0,1:06:43.48,1:06:44.55,cn.sub,NTP,0000,0000,0000,,Қажетсіз ойын
Dialogue: 0,1:06:46.04,1:06:48.33,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:06:54.83,1:06:56.36,cn.sub,NTP,0000,0000,0000,,Жақсы жақтары
Dialogue: 0,1:06:57.80,1:06:58.76,cn.sub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,1:07:00.10,1:07:01.15,cn.sub,NTP,0000,0000,0000,,Сіз қайдасыз
Dialogue: 0,1:07:01.29,1:07:01.88,cn.sub,NTP,0000,0000,0000,,Томое
Dialogue: 0,1:07:02.60,1:07:04.26,cn.sub,NTP,0000,0000,0000,,Сізбен кездеспедім
Dialogue: 0,1:07:05.29,1:07:06.95,cn.sub,NTP,0000,0000,0000,,Білімге келмеу
Dialogue: 0,1:07:12.07,1:07:13.48,cn.sub,NTP,0000,0000,0000,,Хикиса Синбо
Dialogue: 0,1:07:14.17,1:07:17.88,cn.sub,NTP,0000,0000,0000,,Үлкен аға Ұлы аға
Dialogue: 0,1:07:19.66,1:07:22.57,cn.sub,NTP,0000,0000,0000,,Ұлы аға Бұл сіздің көмекшіңіз
Dialogue: 0,1:07:23.32,1:07:26.95,cn.sub,NTP,0000,0000,0000,,Тағы да қатты айқай
Dialogue: 0,1:07:30.22,1:07:33.18,cn.sub,NTP,0000,0000,0000,,Қорқыныш пен ұялшақтықтан қорқады
Dialogue: 0,1:07:38.62,1:07:40.42,cn.sub,NTP,0000,0000,0000,,Ешқандай прогресс жоқ
Dialogue: 0,1:07:42.58,1:07:43.82,cn.sub,NTP,0000,0000,0000,,Бұл екінші өріс.
Dialogue: 0,1:07:43.91,1:07:44.57,cn.sub,NTP,0000,0000,0000,,Айқайлау
Dialogue: 0,1:07:44.68,1:07:45.24,cn.sub,NTP,0000,0000,0000,,Томое
Dialogue: 0,1:07:47.99,1:07:51.40,cn.sub,NTP,0000,0000,0000,,Үлкен жетістік түзету шығыс бағыты жарыққа бағытталған ұшатын тас
Dialogue: 0,1:07:51.93,1:07:53.31,cn.sub,NTP,0000,0000,0000,,Тұрақты шығын
Dialogue: 0,1:07:54.26,1:07:56.73,cn.sub,NTP,0000,0000,0000,,Мен мұнарадан күннің шығуын көрдім
Dialogue: 0,1:07:56.82,1:07:59.82,cn.sub,NTP,0000,0000,0000,,Өйткені қазір арамшөптерді жоюдың соңғы маусымы.
Dialogue: 0,1:07:59.90,1:08:03.19,cn.sub,NTP,0000,0000,0000,,Хиджихимаса шығыс пен оңтүстікте бір нүкте.
Dialogue: 0,1:08:03.31,1:08:06.71,cn.sub,NTP,0000,0000,0000,,Жарық бағыты Хиджияма төбесінің сол жағы
Dialogue: 0,1:08:06.82,1:08:09.26,cn.sub,NTP,0000,0000,0000,,Жауаптар
Dialogue: 0,1:08:09.34,1:08:11.67,cn.sub,NTP,0000,0000,0000,,Сіз неше рет тағайындалдыңыз?
Dialogue: 0,1:08:11.77,1:08:14.14,cn.sub,NTP,0000,0000,0000,,Еркін қосылу
Dialogue: 0,1:08:14.20,1:08:17.83,cn.sub,NTP,0000,0000,0000,,Сіз өз өнеріңізге ризасыз ба?
Dialogue: 0,1:08:17.90,1:08:20.60,cn.sub,NTP,0000,0000,0000,,Менің үйімнің жоғарғы желі
Dialogue: 0,1:08:20.70,1:08:23.35,cn.sub,NTP,0000,0000,0000,,Біз қалай сатып аламыз және сатамыз
Dialogue: 0,1:08:24.22,1:08:26.84,cn.sub,NTP,0000,0000,0000,,Бұл шығыс компьютері.
Dialogue: 0,1:08:26.92,1:08:31.83,cn.sub,NTP,0000,0000,0000,,Жел қуаты 10 қабат Негізгі нүкте әрекет әдісі
Dialogue: 0,1:08:33.80,1:08:36.25,cn.sub,NTP,0000,0000,0000,,Үй иесі Томойоши
Dialogue: 0,1:08:36.28,1:08:39.02,cn.sub,NTP,0000,0000,0000,,Қайридің аспандағы құлыптан кетуі
Dialogue: 0,1:08:39.10,1:08:41.58,cn.sub,NTP,0000,0000,0000,,Кеме қазір жоқ
Dialogue: 0,1:08:41.68,1:08:45.00,cn.sub,NTP,0000,0000,0000,,Желдің қалай пайда болғаны туралы әңгіме.
Dialogue: 0,1:08:45.08,1:08:48.99,cn.sub,NTP,0000,0000,0000,,Аспандағы құлыпқа арналған 10 алтын монета
Dialogue: 0,1:08:49.05,1:08:50.20,cn.sub,NTP,0000,0000,0000,,10 дана! ! !
Dialogue: 0,1:08:50.28,1:08:52.46,cn.sub,NTP,0000,0000,0000,,Аспандағы қамал – аспандағы арал
Dialogue: 0,1:08:52.54,1:08:56.08,cn.sub,NTP,0000,0000,0000,,Сатып алу үшін төлеуге құқығыңыз болса
Dialogue: 0,1:08:56.17,1:08:59.08,cn.sub,NTP,0000,0000,0000,,Сәттілік.
Dialogue: 0,1:09:07.66,1:09:08.27,cn.sub,NTP,0000,0000,0000,,Қозғалыс
Dialogue: 0,1:09:16.14,1:09:18.67,cn.sub,NTP,0000,0000,0000,,Бағыт 98 Жылдамдық 40
Dialogue: 0,1:09:49.28,1:09:53.96,cn.sub,NTP,0000,0000,0000,,Егер мұны істегіңіз келмесе, оны сол жерде қалдырмаңыз.
Dialogue: 0,1:10:01.10,1:10:01.90,cn.sub,NTP,0000,0000,0000,,Қамшы?
Dialogue: 0,1:10:05.55,1:10:06.58,cn.sub,NTP,0000,0000,0000,,Бұл сіздің жұмыс аймағыңыз
Dialogue: 0,1:10:11.04,1:10:11.94,cn.sub,NTP,0000,0000,0000,,Шынайы махаббат
Dialogue: 0,1:10:18.32,1:10:22.43,cn.sub,NTP,0000,0000,0000,,1 күн 5 тағам
Dialogue: 0,1:10:27.31,1:10:28.75,cn.sub,NTP,0000,0000,0000,,ха ха ха
Dialogue: 0,1:10:30.24,1:10:33.33,cn.sub,NTP,0000,0000,0000,,Бұл топтың мақсаты.
Dialogue: 0,1:11:24.92,1:11:25.39,cn.sub,NTP,0000,0000,0000,,Нұсқаулық 3: Аралдағы дискетаны алғаннан кейін он бес минут ішінде кемеге оралуыңыз керек.
Dialogue: 0,1:11:30.16,1:11:32.88,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:11:33.53,1:11:35.95,cn.sub,NTP,0000,0000,0000,,дирижабль стиліндегі асхана Бұл бірінші рет келу.
Dialogue: 0,1:11:38.48,1:11:39.34,cn.sub,NTP,0000,0000,0000,,Жағдайлар қандай?
Dialogue: 0,1:11:41.79,1:11:42.57,cn.sub,NTP,0000,0000,0000,,Шынайы махаббат
Dialogue: 0,1:11:42.70,1:11:43.39,cn.sub,NTP,0000,0000,0000,,Қамшы?
Dialogue: 0,1:11:44.33,1:11:48.52,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:11:48.59,1:11:51.90,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:11:52.01,1:11:54.01,cn.sub,NTP,0000,0000,0000,,…
Dialogue: 0,1:11:57.61,1:11:59.63,cn.sub,NTP,0000,0000,0000,,…
Dialogue: 0,1:12:00.64,1:12:02.52,cn.sub,NTP,0000,0000,0000,,Мен қазір қайдамын?
Dialogue: 0,1:12:04.72,1:12:06.08,cn.sub,NTP,0000,0000,0000,,Шындықты оқы
Dialogue: 0,1:12:06.17,1:12:08.52,cn.sub,NTP,0000,0000,0000,,Бұл аралас жұмыртқа
Dialogue: 0,1:12:08.59,1:12:10.05,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:12:20.32,1:12:24.43,cn.sub,NTP,0000,0000,0000,,Егер сіз сонда болу бақытына ие болсаңыз...
Dialogue: 0,1:12:25.28,1:12:26.56,cn.sub,NTP,0000,0000,0000,,Жеңіс салтанаты
Dialogue: 0,1:12:26.64,1:12:29.10,cn.sub,NTP,0000,0000,0000,,Аспандағы қамал – қазына.
Dialogue: 0,1:12:29.21,1:12:33.42,cn.sub,NTP,0000,0000,0000,,Жақсы бала екеніне сенімдімін.
Dialogue: 0,1:12:33.50,1:12:35.77,cn.sub,NTP,0000,0000,0000,,Сіз бұл туралы ойлайсыз ба?
Dialogue: 0,1:12:35.90,1:12:39.98,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:12:40.08,1:12:41.48,cn.sub,NTP,0000,0000,0000,,Жарайды, бұл тек менің жеке пікірім ғана.
Dialogue: 0,1:12:41.56,1:12:44.48,cn.sub,NTP,0000,0000,0000,,Өлім генералы
Dialogue: 0,1:12:45.62,1:12:49.96,cn.sub,NTP,0000,0000,0000,,Бұл нағыз дәм.
Dialogue: 0,1:12:51.98,1:12:53.62,cn.sub,NTP,0000,0000,0000,,Ішінара қолжетімді
Dialogue: 0,1:12:53.71,1:12:54.97,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:12:55.03,1:12:56.97,cn.sub,NTP,0000,0000,0000,,Гайособа гайособа
Dialogue: 0,1:13:15.58,1:13:16.36,cn.sub,NTP,0000,0000,0000,,Әрине, мен ашуланамын — мен сонша…
Dialogue: 0,1:13:16.49,1:13:16.89,cn.sub,NTP,0000,0000,0000,,Қайырлы таң
Dialogue: 0,1:13:20.73,1:13:23.94,cn.sub,NTP,0000,0000,0000,,Бұл топтың өте суық болатын кезі келді.
Dialogue: 0,1:13:24.22,1:13:25.10,cn.sub,NTP,0000,0000,0000,,Сөйлем?
Dialogue: 0,1:13:25.18,1:13:25.70,cn.sub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,1:13:31.80,1:13:33.45,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:13:41.98,1:13:42.60,cn.sub,NTP,0000,0000,0000,,Орындалды
Dialogue: 0,1:13:42.71,1:13:44.04,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:13:57.22,1:13:58.11,cn.sub,NTP,0000,0000,0000,,Сирек
Dialogue: 0,1:14:02.99,1:14:07.56,cn.sub,NTP,0000,0000,0000,,---
Dialogue: 0,1:14:19.50,1:14:20.07,cn.sub,NTP,0000,0000,0000,,Сирек
Dialogue: 0,1:14:20.28,1:14:21.10,cn.sub,NTP,0000,0000,0000,,Келу
Dialogue: 0,1:14:25.75,1:14:26.65,cn.sub,NTP,0000,0000,0000,,Мәселе жоқ
Dialogue: 0,1:14:28.17,1:14:29.31,cn.sub,NTP,0000,0000,0000,,шынайы температура
Dialogue: 0,1:14:30.14,1:14:31.43,cn.sub,NTP,0000,0000,0000,,Түрме күзетшісінің артқы беті
Dialogue: 0,1:14:35.54,1:14:36.07,cn.sub,NTP,0000,0000,0000,,Томое
Dialogue: 0,1:14:38.60,1:14:40.62,cn.sub,NTP,0000,0000,0000,,Өзімшіл зиян
Dialogue: 0,1:14:42.07,1:14:44.27,cn.sub,NTP,0000,0000,0000,,Бұл аспандағы қамалдың оқиғасы.
Dialogue: 0,1:14:44.41,1:14:47.82,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:14:47.93,1:14:48.71,cn.sub,NTP,0000,0000,0000,,На…
Dialogue: 0,1:14:48.81,1:14:51.74,cn.sub,NTP,0000,0000,0000,,Бірде-бір жарыққа бағытталған бағыт жоқ
Dialogue: 0,1:14:52.73,1:14:53.43,cn.sub,NTP,0000,0000,0000,,Бұл рөл де біраз қиын екен…
Dialogue: 0,1:14:54.62,1:14:56.11,cn.sub,NTP,0000,0000,0000,,Жабдық үшін жауапты адам
Dialogue: 0,1:14:57.71,1:14:59.69,cn.sub,NTP,0000,0000,0000,,Тайка Рей Рё
Dialogue: 0,1:14:59.80,1:15:05.45,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:15:07.42,1:15:10.58,cn.sub,NTP,0000,0000,0000,,Мен көптеген басқа тілдерді үйрендім.
Dialogue: 0,1:15:10.71,1:15:13.24,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:15:13.35,1:15:15.71,cn.sub,NTP,0000,0000,0000,,Тілді қолдану мүлде мүмкін емес
Dialogue: 0,1:15:15.82,1:15:17.34,cn.sub,NTP,0000,0000,0000,,Мүмкін емес мақал?
Dialogue: 0,1:15:17.45,1:15:18.87,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:15:18.98,1:15:21.50,cn.sub,NTP,0000,0000,0000,,Дұрыс сөйлеу қабілетін алумен қатар
Dialogue: 0,1:15:21.61,1:15:23.86,cn.sub,NTP,0000,0000,0000,,Жаман сөздер мен жолды білу керек
Dialogue: 0,1:15:23.96,1:15:25.77,cn.sub,NTP,0000,0000,0000,,Алайда оны пайдалану мүмкін емес
Dialogue: 0,1:15:25.90,1:15:28.81,cn.sub,NTP,0000,0000,0000,,Академиялық хронометраж, зиянды ұйқысыздық
Dialogue: 0,1:15:30.20,1:15:32.81,cn.sub,NTP,0000,0000,0000,,Жалғыз тас түзуге қабілетсіз
Dialogue: 0,1:15:32.94,1:15:36.03,cn.sub,NTP,0000,0000,0000,,Камин осы жерде орналасқан.
Dialogue: 0,1:15:36.14,1:15:38.41,cn.sub,NTP,0000,0000,0000,,Тек үйлену тойларына арналған
Dialogue: 0,1:15:38.54,1:15:42.22,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:15:42.30,1:15:43.50,cn.sub,NTP,0000,0000,0000,,Астанасы – осы жер.
Dialogue: 0,1:15:44.68,1:15:46.84,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:15:46.95,1:15:51.03,cn.sub,NTP,0000,0000,0000,,Бұл тұрарлық емес.
Dialogue: 0,1:15:52.22,1:15:54.58,cn.sub,NTP,0000,0000,0000,,Аспан тасқа толы болса, аспандағы қамал бар.
Dialogue: 0,1:15:55.71,1:15:57.80,cn.sub,NTP,0000,0000,0000,,Ұшатын құрылғы
Dialogue: 0,1:15:57.91,1:16:00.01,cn.sub,NTP,0000,0000,0000,,Кіммен кездескеніңізді қараңыз
Dialogue: 0,1:16:01.15,1:16:03.21,cn.sub,NTP,0000,0000,0000,,Тек Ширандоқай үшін
Dialogue: 0,1:16:03.32,1:16:05.91,cn.sub,NTP,0000,0000,0000,,Аспан сарайы – Бір труппаның қорқынышты аралы
Dialogue: 0,1:16:06.02,1:16:08.44,cn.sub,NTP,0000,0000,0000,,Бір-бірімен сөйлесе алмайтын адамдар
Dialogue: 0,1:16:09.15,1:16:09.62,cn.sub,NTP,0000,0000,0000,,Және
Dialogue: 0,1:16:11.13,1:16:14.38,cn.sub,NTP,0000,0000,0000,,Қазір қашу туралы айтыңыз.
Dialogue: 0,1:16:14.50,1:16:17.43,cn.sub,NTP,0000,0000,0000,,Алайда мен бұл туралы білмеймін.
Dialogue: 0,1:16:18.09,1:16:19.90,cn.sub,NTP,0000,0000,0000,,Мен не істерімді білмеймін
Dialogue: 0,1:16:20.03,1:16:22.07,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:16:22.55,1:16:23.59,cn.sub,NTP,0000,0000,0000,,Сырт келбетіңіз адам ретінде жақсы.
Dialogue: 0,1:16:24.45,1:16:25.80,cn.sub,NTP,0000,0000,0000,,т.б. барлығы қорытындыланады.
Dialogue: 0,1:16:25.88,1:16:28.17,cn.sub,NTP,0000,0000,0000,,Оқиғалардың белгілі бір саны
Dialogue: 0,1:16:29.03,1:16:33.16,cn.sub,NTP,0000,0000,0000,,Мен Васанья тудым деп ойлаған ескі үй
Dialogue: 0,1:16:34.14,1:16:35.73,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:16:37.64,1:16:38.44,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:16:39.30,1:16:41.14,cn.sub,NTP,0000,0000,0000,,Кеменің астыңғы жағы
Dialogue: 0,1:16:48.95,1:16:51.15,cn.sub,NTP,0000,0000,0000,,Қалия Засейха-мён
Dialogue: 0,1:16:56.24,1:16:58.05,cn.sub,NTP,0000,0000,0000,,Рульден қашу
Dialogue: 0,1:17:28.18,1:17:31.11,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:17:31.20,1:17:33.62,cn.sub,NTP,0000,0000,0000,,Күн ортасында өлім үшін
Dialogue: 0,1:17:34.37,1:17:37.43,cn.sub,NTP,0000,0000,0000,,Менің қауымдастықтың заңы, әділдікке қарсы және басқалары қашып құтыла алмайды.
Dialogue: 0,1:17:38.24,1:17:40.11,cn.sub,NTP,0000,0000,0000,,Өте жылдам навигация
Dialogue: 0,1:17:52.88,1:17:57.44,cn.sub,NTP,0000,0000,0000,,Салыстырмалы жол сызығының солтүстікке ауытқуы.
Dialogue: 0,1:17:57.52,1:17:59.89,cn.sub,NTP,0000,0000,0000,,Тақырыпты меңгеруді аяқтады
Dialogue: 0,1:17:59.97,1:18:03.60,cn.sub,NTP,0000,0000,0000,,Талантты жақсы көресің.
Dialogue: 0,1:18:03.67,1:18:04.71,cn.sub,NTP,0000,0000,0000,,Талаптар
Dialogue: 0,1:18:04.79,1:18:08.21,cn.sub,NTP,0000,0000,0000,,Ортада бір машина бар.
Dialogue: 0,1:18:08.29,1:18:09.31,cn.sub,NTP,0000,0000,0000,,Қаралған
Dialogue: 0,1:18:09.38,1:18:10.72,cn.sub,NTP,0000,0000,0000,,Уақыттың айналуы
Dialogue: 0,1:18:14.61,1:18:17.81,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:18:23.09,1:18:26.16,cn.sub,NTP,0000,0000,0000,,Сымды ашқаннан кейін оны өзіңіз пайдалана аласыз.
Dialogue: 0,1:18:26.95,1:18:28.37,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:18:28.47,1:18:28.95,cn.sub,NTP,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,1:18:29.04,1:18:30.63,cn.sub,NTP,0000,0000,0000,,Сен қайтып кел
Dialogue: 0,1:18:30.69,1:18:31.43,cn.sub,NTP,0000,0000,0000,,Жылдамдық
Dialogue: 0,1:18:32.18,1:18:34.29,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:18:34.37,1:18:36.80,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:18:36.90,1:18:39.30,cn.sub,NTP,0000,0000,0000,,Бірақ менің де таулы ауылда көптен бері тамаша көзім бар.
Dialogue: 0,1:18:39.38,1:18:39.80,cn.sub,NTP,0000,0000,0000,,Сирек
Dialogue: 0,1:18:40.42,1:18:40.92,cn.sub,NTP,0000,0000,0000,,Мені ұрлап кетті
Dialogue: 0,1:18:41.00,1:18:42.56,cn.sub,NTP,0000,0000,0000,,Томое Ичия келіседі.
Dialogue: 0,1:18:43.31,1:18:45.91,cn.sub,NTP,0000,0000,0000,,ха ха ха
Dialogue: 0,1:18:45.97,1:18:49.41,cn.sub,NTP,0000,0000,0000,,Жоғарыда айтылғаннан кейін сіз дауыс түтігін пайдалана алмайсыз.
Dialogue: 0,1:18:51.96,1:18:53.55,cn.sub,NTP,0000,0000,0000,,Бұл кемпірге телефон соғу.
Dialogue: 0,1:18:53.67,1:18:54.75,cn.sub,NTP,0000,0000,0000,,Нағыз зиян
Dialogue: 0,1:18:54.84,1:18:57.83,cn.sub,NTP,0000,0000,0000,,Жақсы үлгі Мен оны қолданып көрдім
Dialogue: 0,1:18:57.92,1:18:59.22,cn.sub,NTP,0000,0000,0000,,Кету
Dialogue: 0,1:19:19.52,1:19:20.20,cn.sub,NTP,0000,0000,0000,,Қолжетімсіз
Dialogue: 0,1:19:21.03,1:19:22.43,cn.sub,NTP,0000,0000,0000,,Потенциалды прогресс
Dialogue: 0,1:19:23.16,1:19:25.20,cn.sub,NTP,0000,0000,0000,,Қажетсіз әрекет Тұрақсыз қатысу алдыңғы
Dialogue: 0,1:19:25.99,1:19:26.85,cn.sub,NTP,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,1:19:29.95,1:19:30.76,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:19:37.64,1:19:38.79,cn.sub,NTP,0000,0000,0000,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,1:19:38.87,1:19:40.20,cn.sub,NTP,0000,0000,0000,,Желдің кенеттен көтерілуі және өлім
Dialogue: 0,1:19:41.59,1:19:45.95,cn.sub,NTP,0000,0000,0000,,Бұл әрекетке риза болғаным ғана.
Dialogue: 0,1:19:47.38,1:19:47.86,cn.sub,NTP,0000,0000,0000,,Зиян?
Dialogue: 0,1:19:49.52,1:19:52.40,cn.sub,NTP,0000,0000,0000,,Мен оның қалай жұмыс істейтінін түсінемін, бірақ бұл мүмкін.
Dialogue: 0,1:19:56.13,1:19:58.53,cn.sub,NTP,0000,0000,0000,,Сирек аузымның байланысы болды ма?
Dialogue: 0,1:20:01.06,1:20:02.78,cn.sub,NTP,0000,0000,0000,,Ақшамды қайдан аламын?
Dialogue: 0,1:20:02.86,1:20:03.39,cn.sub,NTP,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,1:20:07.09,1:20:09.39,cn.sub,NTP,0000,0000,0000,,Су бағанының үздіксіз түсуі
Dialogue: 0,1:20:09.45,1:20:12.96,cn.sub,NTP,0000,0000,0000,,Нағыз ұшу жүгірді, бұл жолы жел соқты, аспан жарқырайды
Dialogue: 0,1:20:13.00,1:20:14.16,cn.sub,NTP,0000,0000,0000,,Бір сағаттан кейін
Dialogue: 0,1:20:31.47,1:20:32.21,cn.sub,NTP,0000,0000,0000,,Тенрио Рио
Dialogue: 0,1:20:32.37,1:20:36.39,cn.sub,NTP,0000,0000,0000,,Томое Кішкене оғаш әңгіме Аспан жағының жарығы ашық
Dialogue: 0,1:20:36.45,1:20:40.18,cn.sub,NTP,0000,0000,0000,,Бұл мен алға апарған кеме.
Dialogue: 0,1:20:40.26,1:20:42.69,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:20:42.77,1:20:44.79,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:20:44.88,1:20:48.40,cn.sub,NTP,0000,0000,0000,,Жел өзгеріп, Кокоя ұшып кетті.
Dialogue: 0,1:20:48.51,1:20:49.59,cn.sub,NTP,0000,0000,0000,,Бақылау
Dialogue: 0,1:20:49.67,1:20:51.54,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:20:51.61,1:20:54.42,cn.sub,NTP,0000,0000,0000,,Бұл үлкен ән.
Dialogue: 0,1:20:55.08,1:20:55.76,cn.sub,NTP,0000,0000,0000,,Бұлт?
Dialogue: 0,1:20:56.59,1:20:58.42,cn.sub,NTP,0000,0000,0000,,Саяхат аяқталуға жақын
Dialogue: 0,1:21:12.96,1:21:13.84,cn.sub,NTP,0000,0000,0000,,Аспандағы қамал
26-бөлім
Dialogue: 0,1:21:13.94,1:21:18.02,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:21:18.10,1:21:19.38,cn.sub,NTP,0000,0000,0000,,Кездесу жалғасты
Dialogue: 0,1:21:38.07,1:21:39.59,cn.sub,NTP,0000,0000,0000,,Мәңгі ұрлау
Dialogue: 0,1:21:39.72,1:21:41.51,cn.sub,NTP,0000,0000,0000,,Тасымалдау мүмкін емес
Dialogue: 0,1:21:49.33,1:21:50.59,cn.sub,NTP,0000,0000,0000,,Руль ақауы
Dialogue: 0,1:21:50.68,1:21:52.93,cn.sub,NTP,0000,0000,0000,,Бейбіт уақыттың айуандық күші жойылды.
Dialogue: 0,1:21:53.01,1:21:55.80,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:21:55.89,1:21:58.90,cn.sub,NTP,0000,0000,0000,,Өзіндік ой нүктесі әрекет әдісі
Dialogue: 0,1:22:00.55,1:22:01.84,cn.sub,NTP,0000,0000,0000,,Мен мұнымен біттім.
Dialogue: 0,1:22:09.08,1:22:10.21,cn.sub,NTP,0000,0000,0000,,Кида Кай
Dialogue: 0,1:22:23.46,1:22:24.74,cn.sub,NTP,0000,0000,0000,,Айдаһар сарайы
Dialogue: 0,1:22:24.80,1:22:27.04,cn.sub,NTP,0000,0000,0000,,Айдаһар қайда?
Dialogue: 0,1:22:38.26,1:22:41.22,cn.sub,NTP,0000,0000,0000,,Жапон әкесінің желді айтуы
Dialogue: 0,1:22:45.59,1:22:47.68,cn.sub,NTP,0000,0000,0000,,Мавагами Нари жел қабырғасы
Dialogue: 0,1:22:47.80,1:22:50.05,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:22:50.15,1:22:52.76,cn.sub,NTP,0000,0000,0000,,Ер адам болу шарт емес.
Dialogue: 0,1:22:52.82,1:22:55.33,cn.sub,NTP,0000,0000,0000,,Аспандағы қамалдағы кеме көпірі
Dialogue: 0,1:22:55.43,1:22:56.10,cn.sub,NTP,0000,0000,0000,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,1:22:56.93,1:22:59.44,cn.sub,NTP,0000,0000,0000,,Әкем екеуміз айдаһардың қойнауында жүргенде аспандағы қамалды тамашаладық.
Dialogue: 0,1:23:00.24,1:23:03.22,cn.sub,NTP,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,1:23:03.33,1:23:05.41,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:23:05.47,1:23:06.21,cn.sub,NTP,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,1:23:09.73,1:23:11.08,cn.sub,NTP,0000,0000,0000,,Бұл бос емес уақыт...
Dialogue: 0,1:23:22.77,1:23:25.58,cn.sub,NTP,0000,0000,0000,,Кемпір мен әкесінің жүріп өткен жолы.
Dialogue: 0,1:23:25.66,1:23:27.21,cn.sub,NTP,0000,0000,0000,,Әкенің жағаға қайту жолы аяқталды
Dialogue: 0,1:23:27.26,1:23:29.41,cn.sub,NTP,0000,0000,0000,,Жақсы алға жылжу
Dialogue: 0,1:23:42.83,1:23:43.85,cn.sub,NTP,0000,0000,0000,,Кептірілген
Dialogue: 0,1:23:44.72,1:23:46.94,cn.sub,NTP,0000,0000,0000,,Бұл кеме эвакуациялану қаупінде.
Dialogue: 0,1:23:47.01,1:23:48.08,cn.sub,NTP,0000,0000,0000,,Жұмысқа дайындық
Dialogue: 0,1:23:48.14,1:23:48.83,cn.sub,NTP,0000,0000,0000,,Қамшы?
Dialogue: 0,1:23:48.89,1:23:51.89,cn.sub,NTP,0000,0000,0000,,Жарық бағыттағы бұлт орталығы
Dialogue: 0,1:23:53.36,1:23:55.52,cn.sub,NTP,0000,0000,0000,,Аспандағы құлыптың орталығы
Dialogue: 0,1:23:55.76,1:24:00.27,cn.sub,NTP,0000,0000,0000,,Белгілі бір уақытта келу
Dialogue: 0,1:24:12.82,1:24:13.73,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:24:13.82,1:24:14.37,cn.sub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,1:27:13.16,1:27:16.21,cn.sub,NTP,0000,0000,0000,,Асыл өлім
Dialogue: 0,1:27:22.24,1:27:23.08,cn.sub,NTP,0000,0000,0000,,Егер мен бастапқы өлшемге оралмаған болсам, өліп қалар едім.
Dialogue: 0,1:27:38.11,1:27:38.70,cn.sub,NTP,0000,0000,0000,,Аспандағы қамал
Dialogue: 0,1:27:39.84,1:27:41.65,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:27:43.10,1:27:45.85,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:27:49.90,1:27:50.89,cn.sub,NTP,0000,0000,0000,,Қол ұстасып
Dialogue: 0,1:28:10.44,1:28:11.61,cn.sub,NTP,0000,0000,0000,,Сәтті
Dialogue: 0,1:28:11.71,1:28:15.82,cn.sub,NTP,0000,0000,0000,,ха ха ха
Dialogue: 0,1:28:31.55,1:28:32.33,cn.sub,NTP,0000,0000,0000,,Құс
Dialogue: 0,1:28:34.17,1:28:35.42,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:28:46.73,1:28:47.88,cn.sub,NTP,0000,0000,0000,,Менімен қашан таныстың?
Dialogue: 0,1:28:48.01,1:28:50.49,cn.sub,NTP,0000,0000,0000,,Әйтсе де мен ұшқан тасқа адасып қалдым.
Dialogue: 0,1:28:50.59,1:28:51.39,cn.sub,NTP,0000,0000,0000,,Қылыш кесілген
Dialogue: 0,1:29:12.41,1:29:13.15,cn.sub,NTP,0000,0000,0000,,Оны кептіру керек.
Dialogue: 0,1:29:13.24,1:29:18.49,cn.sub,NTP,0000,0000,0000,,т.б. Мен қажетсіз сынған бөлікті іздеп жатырмын, сондықтан оны қайталай алмаймын.
Dialogue: 0,1:29:34.64,1:29:36.10,cn.sub,NTP,0000,0000,0000,,Мөр
Dialogue: 0,1:29:36.16,1:29:37.74,cn.sub,NTP,0000,0000,0000,,Бұл қай жерде?
Dialogue: 0,1:29:43.97,1:29:46.38,cn.sub,NTP,0000,0000,0000,,Тайкорё
Dialogue: 0,1:29:46.50,1:29:48.32,cn.sub,NTP,0000,0000,0000,,Имансыз адам
Dialogue: 0,1:29:56.11,1:29:57.09,cn.sub,NTP,0000,0000,0000,,Мен төмен түсіп бара жатқанда
Dialogue: 0,1:29:57.15,1:29:58.18,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:29:58.23,1:29:59.36,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:30:12.63,1:30:13.73,cn.sub,NTP,0000,0000,0000,,Гай
Dialogue: 0,1:30:23.89,1:30:25.15,cn.sub,NTP,0000,0000,0000,,Қамал қамалы
Dialogue: 0,1:30:53.35,1:30:55.28,cn.sub,NTP,0000,0000,0000,,Меймей – құрылыстың орта тұсы.
Dialogue: 0,1:30:59.22,1:31:00.95,cn.sub,NTP,0000,0000,0000,,...
Dialogue: 0,1:31:01.04,1:31:01.60,cn.sub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,1:31:11.35,1:31:12.61,cn.sub,NTP,0000,0000,0000,,Рас - қалқымалы қамал.
