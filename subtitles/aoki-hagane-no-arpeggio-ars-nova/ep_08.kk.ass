Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.74,0:00:18.61,Default,,0,0,0,,Негізгі аралдың алдында, Конгоу сыныбына жататын жауынгерлік кеме
Dialogue: 0,0:00:19.31,0:00:21.02,Default,,0,0,0,,және ауыр крейсер Майя
Dialogue: 0,0:00:22.15,0:00:24.62,Default,,0,0,0,,сол қанат оң қанат және артқы
Dialogue: 0,0:00:24.69,0:00:26.32,Default,,0,0,0,,Нагара 2-класс кемелері
Dialogue: 0,0:00:27.16,0:00:29.32,Default,,0,0,0,,Барлығы 8 кеме орналастырылды.
Dialogue: 0,0:00:30.33,0:00:31.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:31.36,0:00:33.66,Default,,0,0,0,,Бұл жігіт үлкен ойнайды.
Dialogue: 0,0:00:33.73,0:00:34.73,Default,,0,0,0,,Ммм
Dialogue: 0,0:00:34.80,0:00:36.03,Default,,0,0,0,,Хэхехе!
Dialogue: 0,0:00:36.10,0:00:39.07,Default,,0,0,0,,Мүмкін сол Конгодан келген жігіт Качикомиге келген шығар.
Dialogue: 0,0:00:39.13,0:00:41.07,Default,,0,0,0,,«Мен келген шығармын» деген сияқты емес!
Dialogue: 0,0:00:41.14,0:00:43.41,Default,,0,0,0,,Неге қоршалғанша байқамадың?
Dialogue: 0,0:00:43.47,0:00:45.04,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:00:45.44,0:00:46.74,Default,,0,0,0,,Бірақ Конго да.
Dialogue: 0,0:00:46.81,0:00:50.28,Default,,0,0,0,,Мен бұл аралды қалпына келтіріп, қорғанысын күшейттім.
Dialogue: 0,0:00:50.35,0:00:52.05,Default,,0,0,0,,Көптен күткен болжам
Dialogue: 0,0:00:52.11,0:00:54.22,Default,,0,0,0,,Мен сенімен оңай араласпаймын.
Dialogue: 0,0:00:54.28,0:00:56.72,Default,,0,0,0,,Сонымен, тікелей қақтығыс жоқ па?
Dialogue: 0,0:00:56.79,0:00:58.32,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:00:58.72,0:01:00.52,Default,,0,0,0,,Біз мәңгі боламыз
Dialogue: 0,0:01:00.59,0:01:02.62,Default,,0,0,0,,Біз бұл жерде тұра алмаймыз.
Dialogue: 0,0:01:02.69,0:01:03.83,Default,,0,0,0,,Хюуга иә?
Dialogue: 0,0:01:04.09,0:01:05.33,Default,,0,0,0,,Ей, қоршауға айналсаң
Dialogue: 0,0:01:05.39,0:01:07.76,Default,,0,0,0,,Сіз әрқашан Ионамен біргемін деп ойладыңыз.
Dialogue: 0,0:01:08.16,0:01:10.53,Default,,0,0,0,,А, сіз нені айтып тұрсыз?
Dialogue: 0,0:01:10.60,0:01:13.23,Default,,0,0,0,,Осылай жалғаса берсе, тығырыққа тірелетін...?
Dialogue: 0,0:01:14.64,0:01:15.50,Default,,0,0,0,,Жоқ
Dialogue: 0,0:01:16.17,0:01:17.37,Default,,0,0,0,,Бұл сандық іштен құлыпталған екен.
Dialogue: 0,0:01:17.67,0:01:19.34,Default,,0,0,0,,Мүмкіндіктер әрине нашар, бірақ
Dialogue: 0,0:01:19.41,0:01:21.38,Default,,0,0,0,,Бұл мүмкіндік әлі жойылған сияқты емес.
Dialogue: 0,0:01:21.44,0:01:23.24,Default,,0,0,0,,Мен осылай дедім
Dialogue: 0,0:01:23.31,0:01:24.35,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:01:25.38,0:01:27.08,Default,,0,0,0,,Конгоумен байланысқаныңызды қалаймын.
Dialogue: 0,0:01:27.45,0:01:28.32,Default,,0,0,0,,«Лайт» жарайды.
Dialogue: 0,0:01:28.58,0:01:29.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:30.85,0:01:31.72,Default,,0,0,0,,Хо
Dialogue: 0,0:01:31.79,0:01:34.86,Default,,0,0,0,,Менімен байланысу әдеттен тыс.
Dialogue: 0,0:01:35.12,0:01:36.16,Default,,0,0,0,,Хюуга
Dialogue: 0,0:01:36.46,0:01:39.23,Default,,0,0,0,,Дәл қазір мен баланың жұмысшысымын.
Dialogue: 0,0:01:39.69,0:01:40.56,Default,,0,0,0,,Фу…
Dialogue: 0,0:01:41.30,0:01:42.16,Default,,0,0,0,,Сізге
Dialogue: 0,0:01:42.23,0:01:44.40,Default,,0,0,0,,Мен Чихая Гунзоның хабарын жеткіземін.
Dialogue: 0,0:01:45.23,0:01:46.10,Default,,0,0,0,,Не?
Dialogue: 0,0:01:47.40,0:01:53.41,Default,,0,0,0,,♪～
Dialogue: 0,0:03:08.68,0:03:14.69,Default,,0,0,0,,～♪
Dialogue: 0,0:03:22.36,0:03:25.50,Default,,0,0,0,,Мен үйде отырғанды жек көремін, далаға шыққанды ұнатамын♪
Dialogue: 0,0:03:25.90,0:03:29.60,Default,,0,0,0,,Бір адам жалғыз, екі адам бақытты♪
Dialogue: 0,0:03:29.67,0:03:33.54,Default,,0,0,0,,Мен Майямын, менің досым Конгоу♪
Dialogue: 0,0:03:33.61,0:03:35.61,Default,,0,0,0,,Мен қатты қорқамын.
Dialogue: 0,0:03:36.21,0:03:38.25,Default,,0,0,0,,Конгу мен Майяның қонуы
Dialogue: 0,0:03:38.31,0:03:39.68,Default,,0,0,0,,Дәл жазылғандай жауап беріп отырсың — қазір сәнде жүрген сол «қолмен басқарылатын» кішкентай қыздардың бірісің бе?
Dialogue: 0,0:03:40.35,0:03:42.88,Default,,0,0,0,,Біздің капитан күткендей.
Dialogue: 0,0:03:42.95,0:03:45.52,Default,,0,0,0,,Олай болса, бұл жерден не істейсің?
Dialogue: 0,0:03:45.59,0:03:47.76,Default,,0,0,0,,Иона, сен мені естисің бе?
Dialogue: 0,0:03:48.79,0:03:49.96,Default,,0,0,0,,Алып кетуді сұрау
Dialogue: 0,0:03:50.49,0:03:51.36,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:54.46,0:03:55.33,Default,,0,0,0,,Такао
Dialogue: 0,0:03:55.40,0:03:57.27,Default,,0,0,0,,Сіз ішке кіресіз.
Dialogue: 0,0:03:57.33,0:03:59.00,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:03:59.33,0:04:00.37,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:04:00.64,0:04:02.57,Default,,0,0,0,,Сонда мен де солай істейтін едім.
Dialogue: 0,0:04:07.01,0:04:10.58,Default,,0,0,0,,Бұл физикалық кеңістікте бірінші рет бетпе-бет кездесіп тұрмыз.
Dialogue: 0,0:04:10.95,0:04:13.48,Default,,0,0,0,,I401 сүңгуір қайығы
Dialogue: 0,0:04:13.62,0:04:14.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:15.25,0:04:17.42,Default,,0,0,0,,Сіз біртүрлі әрекет етесіз, Такао.
Dialogue: 0,0:04:17.79,0:04:20.26,Default,,0,0,0,,Қалай киінетінім өзіме байланысты.
Dialogue: 0,0:04:20.66,0:04:21.52,Default,,0,0,0,,Фу…
Dialogue: 0,0:04:24.39,0:04:25.56,Default,,0,0,0,,Енді ойлап көрейікші
Dialogue: 0,0:04:25.63,0:04:28.40,Default,,0,0,0,,Неліктен сіздің психикалық модельдеріңіздің барлығы әйелдер?
Dialogue: 0,0:04:28.53,0:04:29.76,Default,,0,0,0,,Ер адам жоқ па?
Dialogue: 0,0:04:30.53,0:04:31.90,Default,,0,0,0,,Сіз адамдар
Dialogue: 0,0:04:31.97,0:04:34.84,Default,,0,0,0,,Кемелерге қатысты ресми белгілерді қалдыру кезінде
Dialogue: 0,0:04:34.90,0:04:37.57,Default,,0,0,0,,Барлығы әйелдік анықтауыштарды қолданады
Dialogue: 0,0:04:37.64,0:04:40.44,Default,,0,0,0,,Сонда кеме әйел емес пе?
Dialogue: 0,0:04:40.61,0:04:42.64,Default,,0,0,0,,А... осымен бітті ме?
Dialogue: 0,0:04:42.71,0:04:43.71,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:04:43.78,0:04:44.71,Default,,0,0,0,,… …
Dialogue: 0,0:04:45.71,0:04:46.91,Default,,0,0,0,,А... барасың ба?
Dialogue: 0,0:04:47.52,0:04:49.92,Default,,0,0,0,,Әй, сәлем бермесем дөрекі болар еді.
Dialogue: 0,0:04:52.32,0:04:54.66,Default,,0,0,0,,Конгоу да Харуна мен Киришима сияқты.
Dialogue: 0,0:04:55.36,0:04:57.69,Default,,0,0,0,,Бос сөзді айтсақ жақсы болар еді.
Dialogue: 0,0:04:58.39,0:04:59.56,Default,,0,0,0,,Ақымақ әңгіме?
Dialogue: 0,0:04:59.63,0:05:02.33,Default,,0,0,0,,Мақсатсыз сөйлесу
Dialogue: 0,0:05:02.86,0:05:05.03,Default,,0,0,0,,Мақсатсыз сөйлесу...
Dialogue: 0,0:05:05.63,0:05:06.67,Default,,0,0,0,,Ақымақ әңгіме
Dialogue: 0,0:05:07.50,0:05:08.44,Default,,0,0,0,,Жазу
Dialogue: 0,0:05:09.34,0:05:12.61,Default,,0,0,0,,Бұл мен күткеннен тезірек келді.
Dialogue: 0,0:05:12.67,0:05:13.78,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:13.84,0:05:16.54,Default,,0,0,0,,Сіздің ғалам туралы түсінігіңіз қандай?
Dialogue: 0,0:05:16.61,0:05:19.61,Default,,0,0,0,,өте жоғары деңгейге жеткен сияқты.
Dialogue: 0,0:05:19.68,0:05:21.88,Default,,0,0,0,,Мен неге қате болжап қойдым?
Dialogue: 0,0:05:21.95,0:05:23.32,Default,,0,0,0,,Мен себебін білгім келеді
Dialogue: 0,0:05:23.52,0:05:24.39,Default,,0,0,0,,Осымен.
Dialogue: 0,0:05:24.89,0:05:26.02,Default,,0,0,0,,Майя ауыр крейсері
Dialogue: 0,0:05:26.09,0:05:27.79,Default,,0,0,0,,Сол бала мені шақырды
Dialogue: 0,0:05:27.86,0:05:30.09,Default,,0,0,0,,Осы аралға тезірек келгіңіз келетінін айтыңыз.
Dialogue: 0,0:05:31.06,0:05:32.06,Default,,0,0,0,,Қону?
Dialogue: 0,0:05:32.49,0:05:34.66,Default,,0,0,0,,Жаса! Тез барайық!
Dialogue: 0,0:05:35.63,0:05:36.66,Default,,0,0,0,,Бұл себеп пе?
Dialogue: 0,0:05:36.73,0:05:37.73,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:38.00,0:05:38.90,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:39.43,0:05:41.87,Default,,0,0,0,,Мен болашақты болжауға шебер сен туралы айтып отырмын.
Dialogue: 0,0:05:41.94,0:05:44.91,Default,,0,0,0,,Сіз менің келесі қадамымды болжай білуіңіз керек.
Dialogue: 0,0:05:45.44,0:05:47.01,Default,,0,0,0,,Иә, мүмкін
Dialogue: 0,0:05:47.08,0:05:50.41,Default,,0,0,0,,Ендеше сол болжам бойынша өзімізді ұстайық.
Dialogue: 0,0:06:05.09,0:06:07.93,Default,,0,0,0,,Аа, Конгоу жоғалып кетті.
Dialogue: 0,0:06:08.00,0:06:09.03,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:06:16.50,0:06:17.37,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:06:17.44,0:06:18.91,Default,,0,0,0,,Сәлемдесу үшін жеткілікті.
Dialogue: 0,0:06:18.97,0:06:19.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:22.64,0:06:23.51,Default,,0,0,0,,Суреттер тобы
Dialogue: 0,0:06:23.58,0:06:24.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:27.58,0:06:29.12,Default,,0,0,0,,Чихая Гунзо?
Dialogue: 0,0:06:31.39,0:06:33.12,Default,,0,0,0,,Такао Маған ешқандай көмек керек емес.
Dialogue: 0,0:06:33.39,0:06:34.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:34.39,0:06:35.56,Default,,0,0,0,,Хмф… сағ!
Dialogue: 0,0:06:37.66,0:06:39.03,Default,,0,0,0,,Иво Джимаға қош келдіңіз
Dialogue: 0,0:06:39.83,0:06:43.93,Default,,0,0,0,,Тұман флоты, бірінші шығыстық круиздік флот, флагмандық зал
Dialogue: 0,0:06:44.47,0:06:48.14,Default,,0,0,0,,«Көгілдір болаттың» өз портымызға қонғанын қарсы аламыз.
Dialogue: 0,0:06:48.87,0:06:50.40,Default,,0,0,0,,Мазасыздық
Dialogue: 0,0:06:50.47,0:06:52.04,Default,,0,0,0,,Тек Конго жақсы.
Dialogue: 0,0:06:52.51,0:06:53.51,Default,,0,0,0,,Сенің балаң атақты Эден мектебіне қабылданғанын ойласаңшы!
Dialogue: 0,0:06:53.57,0:06:55.91,Default,,0,0,0,,Енді мен сендерге базамызды көрсетейін.
Dialogue: 0,0:06:56.84,0:06:58.55,Default,,0,0,0,,Екеуміз кеттік.
Dialogue: 0,0:07:02.42,0:07:03.08,Default,,0,0,0,,Майя!
Dialogue: 0,0:07:03.15,0:07:04.92,Default,,0,0,0,,Ах! Иә
Dialogue: 0,0:07:04.99,0:07:05.92,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:07:06.05,0:07:08.06,Default,,0,0,0,,Құм сау бол
Dialogue: 0,0:07:13.66,0:07:15.66,Default,,0,0,0,,Өтінемін, сабыр етіңіз.
Dialogue: 0,0:07:21.67,0:07:23.00,Default,,0,0,0,,Бұл жалған ба?
Dialogue: 0,0:07:23.20,0:07:25.51,Default,,0,0,0,,Бұл! бізбен бірге
Dialogue: 0,0:07:26.87,0:07:28.11,Default,,0,0,0,,Көптен бері көрмедім
Dialogue: 0,0:07:28.44,0:07:29.11,Default,,0,0,0,,Хюуга иә?
Dialogue: 0,0:07:29.18,0:07:30.21,Default,,0,0,0,,Фортепиано жоқ па?
Dialogue: 0,0:07:30.48,0:07:31.15,Default,,0,0,0,,Фортепиано?
Dialogue: 0,0:07:31.58,0:07:34.62,Default,,0,0,0,,А... Мен оны лаунж-бар кеңістігінде жасадым.
Dialogue: 0,0:07:34.68,0:07:36.82,Default,,0,0,0,,Иә! Кейінірек ойнаңыз Ойнаңыз!
Dialogue: 0,0:07:37.92,0:07:38.92,Default,,0,0,0,,Хюуга?
Dialogue: 0,0:07:38.99,0:07:40.92,Default,,0,0,0,,Жақсы көрінесің, Конгоу.
Dialogue: 0,0:07:41.06,0:07:43.69,Default,,0,0,0,,Бұл жасанды адам клишесі
Dialogue: 0,0:07:43.76,0:07:44.66,Default,,0,0,0,,Бұл жағымсыз.
Dialogue: 0,0:07:44.73,0:07:48.13,Default,,0,0,0,,Хмф... Мен солай ойлап, әдейі қолдандым.
Dialogue: 0,0:07:48.80,0:07:49.80,Default,,0,0,0,,Хун
Dialogue: 0,0:07:49.86,0:07:52.10,Default,,0,0,0,,Бұл сіздің хоббиіңіз болды.
Dialogue: 0,0:07:52.77,0:07:55.84,Default,,0,0,0,,Автономды алгоритмдер және энергия тиімділігі бойынша
Dialogue: 0,0:07:55.90,0:07:57.24,Default,,0,0,0,,Бұл қалыптасқан форма.
Dialogue: 0,0:07:57.77,0:07:59.57,Default,,0,0,0,,Хоббиге қатысы жоқ
Dialogue: 0,0:07:59.64,0:08:01.01,Default,,0,0,0,,Иә
Dialogue: 0,0:08:01.58,0:08:03.61,Default,,0,0,0,,Ал... алдымен отырайық.
Dialogue: 0,0:08:03.68,0:08:05.95,Default,,0,0,0,,Хмм... Мүмкін емес.
Dialogue: 0,0:08:06.51,0:08:08.68,Default,,0,0,0,,Осындай ақымақ ойын үшін
Dialogue: 0,0:08:08.75,0:08:11.05,Default,,0,0,0,,Сен мені шақырмадың, солай ма?
Dialogue: 0,0:08:11.12,0:08:12.52,Default,,0,0,0,,Ал, жақсы...
Dialogue: 0,0:08:12.99,0:08:14.96,Default,,0,0,0,,Бұл тамаша кездесу
Dialogue: 0,0:08:15.09,0:08:16.96,Default,,0,0,0,,Шынайы өмірде неге анда-санда шай ішпеске?
Dialogue: 0,0:08:17.02,0:08:17.89,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:08:19.03,0:08:20.63,Default,,0,0,0,,Жүйені толық іске қосу
Dialogue: 0,0:08:22.73,0:08:24.23,Default,,0,0,0,,Машина бөлмесінен диспетчерлік орталыққа дейін
Dialogue: 0,0:08:24.50,0:08:26.07,Default,,0,0,0,,Негізгі ауырлық қозғалтқышы онлайн
Dialogue: 0,0:08:26.13,0:08:28.27,Default,,0,0,0,,Критикалық деңгейге жеткеннен кейін 50 секунд
Dialogue: 0,0:08:28.54,0:08:30.04,Default,,0,0,0,,Бос жүріс режимін сақтау
Dialogue: 0,0:08:30.27,0:08:31.71,Default,,0,0,0,,Клейнфилд кеңеюі
Dialogue: 0,0:08:31.77,0:08:33.54,Default,,0,0,0,,Шығару 0,5%
Dialogue: 0,0:08:33.88,0:08:34.94,Default,,0,0,0,,Генераторды іске қосу
Dialogue: 0,0:08:37.78,0:08:38.71,Default,,0,0,0,,Өртті басқару
Dialogue: 0,0:08:38.78,0:08:39.65,Default,,0,0,0,,Онлайн
Dialogue: 0,0:08:39.71,0:08:40.58,Default,,0,0,0,,Сонар
Dialogue: 0,0:08:40.65,0:08:42.02,Default,,0,0,0,,Жаңарту аяқталды
Dialogue: 0,0:08:42.15,0:08:43.12,Default,,0,0,0,,Жүйенің күту режимі
Dialogue: 0,0:08:43.62,0:08:44.55,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:44.62,0:08:47.02,Default,,0,0,0,,Бұдан былай басқа тапсырыс болғанша күтіңіз.
Dialogue: 0,0:08:47.09,0:08:49.12,Default,,0,0,0,,Кезек бізге келе ме?
Dialogue: 0,0:08:49.86,0:08:52.96,Default,,0,0,0,,Жарайды, мен қолымнан келгенін істеймін.
Dialogue: 0,0:08:55.73,0:08:56.66,Default,,0,0,0,,Хюуга
Dialogue: 0,0:08:56.96,0:08:59.73,Default,,0,0,0,,Неліктен сіз психикалық модельді таңдауды шештіңіз?
Dialogue: 0,0:08:59.80,0:09:01.94,Default,,0,0,0,,Әй... мен саған мұны бұрын айтпадым ба?
Dialogue: 0,0:09:02.00,0:09:03.57,Default,,0,0,0,,Мұны естігенім есімде жоқ.
Dialogue: 0,0:09:03.80,0:09:04.94,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:09:05.01,0:09:06.01,Default,,0,0,0,,Мен олай айтқан жоқпын.
Dialogue: 0,0:09:07.58,0:09:08.81,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:09:08.88,0:09:12.01,Default,,0,0,0,,Мені Иона апа қатты ұрды.
Dialogue: 0,0:09:12.08,0:09:13.88,Default,,0,0,0,,Ол батып кетті, солай ма?
Dialogue: 0,0:09:13.95,0:09:15.18,Default,,0,0,0,,Ономатопея
Dialogue: 0,0:09:15.32,0:09:16.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:16.25,0:09:18.12,Default,,0,0,0,,Сол кезде мен ойладым
Dialogue: 0,0:09:18.19,0:09:21.59,Default,,0,0,0,,А, мен қазір тірімін.
Dialogue: 0,0:09:21.66,0:09:23.16,Default,,0,0,0,,Өмір сүру...
Dialogue: 0,0:09:23.89,0:09:24.93,Default,,0,0,0,,Мүмкін… Сондықтан сендер
Dialogue: 0,0:09:24.99,0:09:26.56,Default,,0,0,0,,Ләззат алыңыз.
Dialogue: 0,0:09:32.30,0:09:33.23,Default,,0,0,0,,Ыстық...
Dialogue: 0,0:09:34.34,0:09:37.84,Default,,0,0,0,,Бұл қызық нәрсе, дене.
Dialogue: 0,0:09:39.24,0:09:40.71,Default,,0,0,0,,Гунзо Чихая
Dialogue: 0,0:09:40.78,0:09:43.28,Default,,0,0,0,,Мені бұл аралға не үшін шақырғаныңызды айтыңыз.
Dialogue: 0,0:09:43.68,0:09:45.25,Default,,0,0,0,,Мен сөйлескім келді.
Dialogue: 0,0:09:45.65,0:09:46.31,Default,,0,0,0,,Сізбен бірге
Dialogue: 0,0:09:48.22,0:09:49.15,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:09:49.82,0:09:51.79,Default,,0,0,0,,Сіз оны қабылдай аласыз ба?
Dialogue: 0,0:09:52.72,0:09:54.72,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:09:54.79,0:09:57.02,Default,,0,0,0,,Гунзо әрқашан байсалды
Dialogue: 0,0:09:57.09,0:09:57.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:58.03,0:09:59.16,Default,,0,0,0,,Адамдар үшін
Dialogue: 0,0:09:59.23,0:10:02.93,Default,,0,0,0,,Бетпе-бет сөйлесу өте маңызды
Dialogue: 0,0:10:03.00,0:10:04.77,Default,,0,0,0,,Бұл ақымақ сезім теориясы.
Dialogue: 0,0:10:04.83,0:10:08.97,Default,,0,0,0,,Бірақ біз осылай кездеспейінше хабарлауға болмайтын нәрселер бар, солай ма?
Dialogue: 0,0:10:09.27,0:10:10.77,Default,,0,0,0,,Гунзо Чихая
Dialogue: 0,0:10:10.84,0:10:12.07,Default,,0,0,0,,401
Dialogue: 0,0:10:12.14,0:10:15.38,Default,,0,0,0,,Менің сізге айтқым келетін бір ғана нәрсе бар.
Dialogue: 0,0:10:15.84,0:10:19.18,Default,,0,0,0,,Мен бәріңді құртуға бел байладым.
Dialogue: 0,0:10:19.95,0:10:21.78,Default,,0,0,0,,Мұнда шақыруды кім қабылдады?
Dialogue: 0,0:10:21.85,0:10:24.19,Default,,0,0,0,,Оны тікелей жеткізу
Dialogue: 0,0:10:27.32,0:10:28.19,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:10:28.82,0:10:31.06,Default,,0,0,0,,Менің сенімен сөйлескім келеді
Dialogue: 0,0:10:31.13,0:10:32.16,Default,,0,0,0,,Өзгеріс жоқ
Dialogue: 0,0:10:32.23,0:10:33.29,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:34.36,0:10:35.80,Default,,0,0,0,,Осыны орындау арқылы
Dialogue: 0,0:10:35.86,0:10:37.77,Default,,0,0,0,,Біз қолайсыз жағдайға тап болдық.
Dialogue: 0,0:10:37.87,0:10:39.30,Default,,0,0,0,,Кем дегенде сіз үшін
Dialogue: 0,0:10:39.37,0:10:41.70,Default,,0,0,0,,Өйткені жоғалтатын ештеңе жоқ сияқты.
Dialogue: 0,0:10:44.17,0:10:46.34,Default,,0,0,0,,Бұл қызықты бастау нүктесі.
Dialogue: 0,0:10:47.41,0:10:50.78,Default,,0,0,0,,Жапон үкіметі бізге белгілі бір қаруды сеніп тапсырды.
Dialogue: 0,0:10:51.35,0:10:54.72,Default,,0,0,0,,Оның қарапайым қарудан мүлде басқа принципі бар.
Dialogue: 0,0:10:54.95,0:10:57.65,Default,,0,0,0,,Тіпті тұманды жарып өте алатын қару.
Dialogue: 0,0:10:57.79,0:10:58.95,Default,,0,0,0,,Қазіргі уақытта концерттік турда
Dialogue: 0,0:10:59.35,0:11:01.19,Default,,0,0,0,,Бұл дірілдейтін оқтұмсық болды.
Dialogue: 0,0:11:01.26,0:11:06.19,Default,,0,0,0,,Материалдың табиғи жиілігімен резонанс құбылысын тудырады және оны бұзады
Dialogue: 0,0:11:06.73,0:11:10.00,Default,,0,0,0,,Принцип қарапайым, бірақ ол соншалықты тиімді.
Dialogue: 0,0:11:10.06,0:11:12.90,Default,,0,0,0,,Ол қазіргі тұманға қарсы жеткілікті күшті.
Dialogue: 0,0:11:12.97,0:11:15.67,Default,,0,0,0,,Ах... Дегенмен, әлгі оқтұмсық
Dialogue: 0,0:11:15.74,0:11:17.44,Default,,0,0,0,,Клейн өрісін бұзып өту
Dialogue: 0,0:11:17.71,0:11:18.91,Default,,0,0,0,,Қолымнан келсе
Dialogue: 0,0:11:18.97,0:11:21.34,Default,,0,0,0,,Бұл мәселе әзірге тоқтатылды.
Dialogue: 0,0:11:21.84,0:11:24.01,Default,,0,0,0,,Қалай болғанда да, бізде сол оқтұмсық бар.
Dialogue: 0,0:11:24.08,0:11:26.45,Default,,0,0,0,,Америкаға тасымалдауды сұрады
Dialogue: 0,0:11:26.78,0:11:30.32,Default,,0,0,0,,Сіз тұманға қарсы пайдалану үшін жаппай шығарылды.
Dialogue: 0,0:11:30.38,0:11:33.95,Default,,0,0,0,,Мен оны елемеймін деп ойлайсыз ба?
Dialogue: 0,0:11:34.02,0:11:35.92,Default,,0,0,0,,Аа... Мүмкін емес.
Dialogue: 0,0:11:36.36,0:11:37.39,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:11:37.46,0:11:40.90,Default,,0,0,0,,Сіз бізді осы аралға жабыстырып отырсыз.
Dialogue: 0,0:11:41.03,0:11:43.30,Default,,0,0,0,,Адамзатты жою мүмкін болуы керек.
Dialogue: 0,0:11:43.76,0:11:45.17,Default,,0,0,0,,Осы уақытта
Dialogue: 0,0:11:45.23,0:11:49.07,Default,,0,0,0,,Адамзаттың қуаты мұхиттың арғы жағындағы барлық байланыстардан ажыратылды.
Dialogue: 0,0:11:49.20,0:11:51.01,Default,,0,0,0,,Бұл енді ғана жоғалып бара жатыр.
Dialogue: 0,0:11:51.14,0:11:52.27,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:11:52.34,0:11:55.44,Default,,0,0,0,,Сондықтан мен сенімен сөйлескім келді.
Dialogue: 0,0:11:56.01,0:11:56.88,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:57.38,0:11:59.81,Default,,0,0,0,,Баршаңызбен... Менің ойымша
Dialogue: 0,0:11:59.88,0:12:01.05,Default,,0,0,0,,Сол жігіт… Көзіне латкі таққан Какужа ма?
Dialogue: 0,0:12:01.95,0:12:02.95,Default,,0,0,0,,Хмм?
Dialogue: 0,0:12:03.72,0:12:04.39,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:05.19,0:12:07.09,Default,,0,0,0,,Біз адамдар болсақ ше
Dialogue: 0,0:12:07.15,0:12:09.22,Default,,0,0,0,,Егер сіз жойылудың алдында тұрсаңыз
Dialogue: 0,0:12:09.36,0:12:11.09,Default,,0,0,0,,Мен себебін білгім келеді
Dialogue: 0,0:12:12.16,0:12:15.26,Default,,0,0,0,,Неліктен адамдар бұл жерден жойылып кетуі керек?
Dialogue: 0,0:12:16.26,0:12:17.83,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:21.90,0:12:23.40,Default,,0,0,0,,Біз адамдар болсақ ше
Dialogue: 0,0:12:23.47,0:12:25.74,Default,,0,0,0,,Егер сіз жойылудың алдында тұрсаңыз
Dialogue: 0,0:12:25.94,0:12:27.48,Default,,0,0,0,,Мен себебін білгім келеді
Dialogue: 0,0:12:28.51,0:12:32.35,Default,,0,0,0,,Неліктен адамдар жер бетінен жойылып кетуі керек?
Dialogue: 0,0:12:32.98,0:12:34.32,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:35.12,0:12:37.15,Default,,0,0,0,,Біздің барлық әрекеттеріміз
Dialogue: 0,0:12:37.22,0:12:39.85,Default,,0,0,0,,Ол Адмиралтейт кодексімен анықталады.
Dialogue: 0,0:12:39.92,0:12:42.09,Default,,0,0,0,,Мен бұл есімді Ионадан естідім.
Dialogue: 0,0:12:42.26,0:12:43.22,Default,,0,0,0,,Бірақ не керек
Dialogue: 0,0:12:43.29,0:12:46.86,Default,,0,0,0,,Мен оның нақты не екенін білмедім.
Dialogue: 0,0:12:47.16,0:12:48.03,Default,,0,0,0,,...
Dialogue: 0,0:12:48.10,0:12:51.80,Default,,0,0,0,,Адам түсінетін ауқымдағы ұғымға аударылған
Dialogue: 0,0:12:52.13,0:12:57.84,Default,,0,0,0,,Біз тұманның болу себебін және оның әрекет ету принциптерін анықтайтын ең жоғарғы бұйрықпыз.
Dialogue: 0,0:12:58.14,0:13:00.47,Default,,0,0,0,,Жоқ... Бұл норма сияқты ма?
Dialogue: 0,0:13:00.94,0:13:03.54,Default,,0,0,0,,Шынымды айтсам, бұл ойын ережесі сияқты.
Dialogue: 0,0:13:04.11,0:13:06.18,Default,,0,0,0,,Біз оянған сәттен бастап біз
Dialogue: 0,0:13:06.38,0:13:09.55,Default,,0,0,0,,Адмиралтейлік кодексті өзіңіз орындауыңыз керек.
Dialogue: 0,0:13:09.82,0:13:10.82,Default,,0,0,0,,Мен білдім
Dialogue: 0,0:13:11.19,0:13:12.22,Default,,0,0,0,,Ойласам, ол бәріне белгілі нәрсе ғой.
Dialogue: 0,0:13:12.29,0:13:15.39,Default,,0,0,0,,Өйткені бұл біздің өмір сүруіміздің себебі.
Dialogue: 0,0:13:15.46,0:13:16.99,Default,,0,0,0,,Онда ештеңе жоқ
Dialogue: 0,0:13:17.06,0:13:19.86,Default,,0,0,0,,Кеңейтілген түсіндіруге орын жоқ.
Dialogue: 0,0:13:19.93,0:13:23.03,Default,,0,0,0,,Бірақ сіз оған бағынбадыңыз.
Dialogue: 0,0:13:23.10,0:13:24.03,Default,,0,0,0,,Ах… Ух…
Dialogue: 0,0:13:24.37,0:13:27.10,Default,,0,0,0,,Адмиралтейлік код нұсқаулары анық
Dialogue: 0,0:13:27.17,0:13:31.24,Default,,0,0,0,,Осы планетаның мұхиттарын жауып, барлық байланысты үзіңіз.
Dialogue: 0,0:13:31.31,0:13:32.24,Default,,0,0,0,,Бірақ
Dialogue: 0,0:13:32.31,0:13:35.18,Default,,0,0,0,,Неліктен сіз бұл нұсқауларды орындамайсыз?
Dialogue: 0,0:13:36.24,0:13:37.11,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:37.51,0:13:39.58,Default,,0,0,0,,Сіз бағынбауыңыз мүмкін бе?
Dialogue: 0,0:13:40.95,0:13:41.95,Default,,0,0,0,,Гунзо Чихая
Dialogue: 0,0:13:42.02,0:13:44.89,Default,,0,0,0,,Барлығы сізден және 401-ден басталды.
Dialogue: 0,0:13:45.19,0:13:47.22,Default,,0,0,0,,Келесі жолы осы жерден тыңдайық.
Dialogue: 0,0:13:47.82,0:13:50.29,Default,,0,0,0,,Сіз мұны түсінесіз бе?
Dialogue: 0,0:13:51.09,0:13:55.10,Default,,0,0,0,,Сізбен байланысуға байланысты тұман өзгергелі тұр.
Dialogue: 0,0:13:55.83,0:13:57.30,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:14:00.37,0:14:01.40,Default,,0,0,0,,Гүлп...
Dialogue: 0,0:14:04.00,0:14:04.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:06.37,0:14:08.08,Default,,0,0,0,,Баратын кез келді ме?
Dialogue: 0,0:14:12.85,0:14:14.25,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:14:14.52,0:14:15.38,Default,,0,0,0,,Не?
Dialogue: 0,0:14:16.02,0:14:18.05,Default,,0,0,0,,Сіздің энергия көзіңіз қандай?
Dialogue: 0,0:14:18.12,0:14:19.99,Default,,0,0,0,,Әдеттегідей, мен шынымен түсінбеймін.
Dialogue: 0,0:14:20.12,0:14:21.96,Default,,0,0,0,,Қарсы болмасаңыз
Dialogue: 0,0:14:22.09,0:14:24.26,Default,,0,0,0,,Кешкі асқа маған қосыла аласыз ба?
Dialogue: 0,0:14:25.13,0:14:26.53,Default,,0,0,0,,Тамақ?
Dialogue: 0,0:14:31.33,0:14:32.27,Default,,0,0,0,,Сонымен…
Dialogue: 0,0:14:32.33,0:14:36.50,Default,,0,0,0,,Ет, ет, көкөніс, ет, көкөніс ырғағы бойынша тамақтаныңыз.
Dialogue: 0,0:14:36.57,0:14:38.11,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:14:50.15,0:14:52.32,Default,,0,0,0,,Хам Хам Хам…
Dialogue: 0,0:14:56.19,0:14:57.26,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:57.32,0:15:00.56,Default,,0,0,0,,Бұл ет Иона апа үшін өсіріледі.
Dialogue: 0,0:15:00.63,0:15:01.60,Default,,0,0,0,,Ешқандай араласудың қажеті жоқ!
Dialogue: 0,0:15:05.10,0:15:07.03,Default,,0,0,0,,Эй, Хюуга Хюуга
Dialogue: 0,0:15:07.10,0:15:09.34,Default,,0,0,0,,Бұл не пісіру?
Dialogue: 0,0:15:09.40,0:15:10.27,Default,,0,0,0,,Сиыр еті!
Dialogue: 0,0:15:10.34,0:15:12.54,Default,,0,0,0,,Мм, жануардың мәйіті ме?
Dialogue: 0,0:15:14.04,0:15:16.68,Default,,0,0,0,,Дәмі Йокосукада жегенімнен бөлек.
Dialogue: 0,0:15:16.94,0:15:18.55,Default,,0,0,0,,О, мен оны білдім бе?
Dialogue: 0,0:15:18.61,0:15:21.25,Default,,0,0,0,,Осындай нәрсені синтездеу дұрыс емес пе?
Dialogue: 0,0:15:21.68,0:15:23.95,Default,,0,0,0,,Хахаха... Ухаха!
Dialogue: 0,0:15:24.65,0:15:27.66,Default,,0,0,0,,Хо… ха ха ха ха
Dialogue: 0,0:15:27.92,0:15:29.09,Default,,0,0,0,,Хаха! Оу!
Dialogue: 0,0:15:31.33,0:15:34.19,Default,,0,0,0,,Уау... су қатты.
Dialogue: 0,0:15:34.60,0:15:37.03,Default,,0,0,0,,Бұл жаман... жаман!
Dialogue: 0,0:15:37.53,0:15:38.47,Default,,0,0,0,,Ой!
Dialogue: 0,0:15:39.97,0:15:41.20,Default,,0,0,0,,Капитан Чихая
Dialogue: 0,0:15:41.27,0:15:43.64,Default,,0,0,0,,Кёхэй мен монахтар тамақ ішпей ме?
Dialogue: 0,0:15:43.70,0:15:46.61,Default,,0,0,0,,О, олар 401-де күтіп тұр
Dialogue: 0,0:15:47.27,0:15:49.21,Default,,0,0,0,,Тек жағдайда
Dialogue: 0,0:16:01.09,0:16:02.02,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:16:02.59,0:16:05.43,Default,,0,0,0,,Бұл тым ашық, капитаным.
Dialogue: 0,0:16:06.46,0:16:10.53,Default,,0,0,0,,Алайда, бұл жағдайда тұманнан ештеңені жасыру мағынасыз болар еді.
Dialogue: 0,0:16:11.50,0:16:15.44,Default,,0,0,0,,Тұманның логикалық тосқауылын тесудің өзі ақымақ әңгіме.
Dialogue: 0,0:16:15.74,0:16:18.24,Default,,0,0,0,,Сіз мұны шынымен жасай аласыз ба?
Dialogue: 0,0:16:19.04,0:16:22.14,Default,,0,0,0,,Басқа адам қазір тітіркеніп кеткен жоқ па?
Dialogue: 0,0:16:23.48,0:16:25.01,Default,,0,0,0,,Вертолёт қонды.
Dialogue: 0,0:16:27.31,0:16:28.18,Default,,0,0,0,,Хо!
Dialogue: 0,0:16:28.25,0:16:29.48,Default,,0,0,0,,Шәкең
Dialogue: 0,0:16:30.05,0:16:32.25,Default,,0,0,0,,Сәлем! Хуаа... у...
Dialogue: 0,0:16:32.32,0:16:33.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:33.25,0:16:34.19,Default,,0,0,0,,Шәкең
Dialogue: 0,0:16:34.25,0:16:36.09,Default,,0,0,0,,Майя да солай жасайды~
Dialogue: 0,0:16:39.39,0:16:41.56,Default,,0,0,0,,Тамақ жағымсыз болды ма?
Dialogue: 0,0:16:45.27,0:16:46.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:46.37,0:16:50.24,Default,,0,0,0,,Өйткені, бұл адамға еліктеу. Бұл қиын.
Dialogue: 0,0:16:54.68,0:16:55.54,Default,,0,0,0,,Сол адамдар
Dialogue: 0,0:16:56.38,0:16:58.75,Default,,0,0,0,,Біртүрлі үйлесімді көрінеді.
Dialogue: 0,0:17:01.48,0:17:02.35,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:17:04.12,0:17:07.45,Default,,0,0,0,,Сізге қазіргі жағдай ұнай ма?
Dialogue: 0,0:17:07.72,0:17:09.02,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:17:10.09,0:17:12.53,Default,,0,0,0,,Өйткені бұл қызық
Dialogue: 0,0:17:13.03,0:17:14.13,Default,,0,0,0,,Бұл көңілді ме?
Dialogue: 0,0:17:16.03,0:17:17.26,Default,,0,0,0,,Көңілді…
Dialogue: 0,0:17:20.27,0:17:21.40,Default,,0,0,0,,401
Dialogue: 0,0:17:21.60,0:17:23.37,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:17:23.74,0:17:25.81,Default,,0,0,0,,Мен тұманды сүңгуір қайықпын
Dialogue: 0,0:17:26.41,0:17:27.34,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:17:27.41,0:17:28.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:29.24,0:17:31.61,Default,,0,0,0,,Мені әрқашан ойландыратынмын
Dialogue: 0,0:17:32.08,0:17:35.42,Default,,0,0,0,,Бұл кеңістікті алғаш салған кім?
Dialogue: 0,0:17:35.72,0:17:38.32,Default,,0,0,0,,Бұл сенсің, солай ма? 401
Dialogue: 0,0:17:38.39,0:17:39.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:39.69,0:17:43.62,Default,,0,0,0,,Сіз біздікінен өзгеше қағидаларды басшылыққа алатын шығарсыз.
Dialogue: 0,0:17:43.69,0:17:45.56,Default,,0,0,0,,Ол психикалық үлгіге айналды.
Dialogue: 0,0:17:46.56,0:17:50.50,Default,,0,0,0,,Сіздің адмиралтейлік кодыңыз біздікімен бірдей ме?
Dialogue: 0,0:17:51.43,0:17:52.30,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:52.37,0:17:54.50,Default,,0,0,0,,Біріншіден, сен шынымен бе?
Dialogue: 0,0:17:54.57,0:17:58.11,Default,,0,0,0,,Сіз Адмиралтейт кодексінің бұйрықтарын орындайсыз ба?
Dialogue: 0,0:17:58.47,0:17:59.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:00.17,0:18:02.14,Default,,0,0,0,,Сізбен жанасқан тұман
Dialogue: 0,0:18:02.21,0:18:04.45,Default,,0,0,0,,Өзгерістер ерекшеліксіз рұқсат етіледі.
Dialogue: 0,0:18:04.75,0:18:06.45,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:18:06.75,0:18:07.61,Default,,0,0,0,,Өзгерту?
Dialogue: 0,0:18:07.68,0:18:08.75,Default,,0,0,0,,Хюуга
Dialogue: 0,0:18:08.82,0:18:10.12,Default,,0,0,0,,Такао
Dialogue: 0,0:18:10.18,0:18:11.55,Default,,0,0,0,,Киришима
Dialogue: 0,0:18:11.62,0:18:12.49,Default,,0,0,0,,Харуна
Dialogue: 0,0:18:12.82,0:18:14.82,Default,,0,0,0,,Бәрі дұрыс болмады
Dialogue: 0,0:18:16.66,0:18:18.43,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:18:19.29,0:18:21.30,Default,,0,0,0,,Мен білетін тұман емес
Dialogue: 0,0:18:21.56,0:18:24.16,Default,,0,0,0,,Оларды не өзгертті?
Dialogue: 0,0:18:25.57,0:18:27.80,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:18:27.87,0:18:29.50,Default,,0,0,0,,Неліктен білмейсің?
Dialogue: 0,0:18:29.57,0:18:31.71,Default,,0,0,0,,Мұның бәрі сенің арқаң
Dialogue: 0,0:18:32.31,0:18:36.68,Default,,0,0,0,,Мен Гунзоның кемесі ретіндегі міндетімді орындап жатырмын.
Dialogue: 0,0:18:36.74,0:18:38.21,Default,,0,0,0,,​​Не үшін?
Dialogue: 0,0:18:38.28,0:18:39.38,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:39.71,0:18:41.58,Default,,0,0,0,,401-жауап
Dialogue: 0,0:18:43.72,0:18:46.25,Default,,0,0,0,,Мен Гунзомын...
Dialogue: 0,0:18:47.69,0:18:48.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:48.86,0:18:49.72,Default,,0,0,0,,Хмф!
Dialogue: 0,0:18:50.19,0:18:52.26,Default,,0,0,0,,Жауап бере алмаймын дейсіз бе?
Dialogue: 0,0:18:52.46,0:18:54.23,Default,,0,0,0,,Сіз тұмансыз ба?
Dialogue: 0,0:18:55.40,0:18:56.33,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:18:56.46,0:18:58.63,Default,,0,0,0,,Менің айтқаным дұрыс сияқты.
Dialogue: 0,0:19:00.37,0:19:01.37,Default,,0,0,0,,Конго?
Dialogue: 0,0:19:02.40,0:19:05.47,Default,,0,0,0,,Барлығының себебі Гунзо Чихаяда жатыр.
Dialogue: 0,0:19:05.54,0:19:06.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:07.54,0:19:08.88,Default,,0,0,0,,Сонымен, мен
Dialogue: 0,0:19:09.14,0:19:10.58,Default,,0,0,0,,Мен және Майяның өзегі
Dialogue: 0,0:19:10.64,0:19:14.45,Default,,0,0,0,,Чихая Гунзомен байланыста болмас үшін.
Dialogue: 0,0:19:14.52,0:19:16.52,Default,,0,0,0,,Эпидемияның алдын алу шаралары жүргізілді
Dialogue: 0,0:19:17.25,0:19:17.92,Default,,0,0,0,,Не... иә?
Dialogue: 0,0:19:18.85,0:19:21.56,Default,,0,0,0,,Сол қалақ сол жерде болған көрінеді.
Dialogue: 0,0:19:22.56,0:19:24.39,Default,,0,0,0,,Сіз нені айтасыз? Конго
Dialogue: 0,0:19:25.33,0:19:27.79,Default,,0,0,0,,Жауабын басынан бастап білдім.
Dialogue: 0,0:19:27.86,0:19:30.40,Default,,0,0,0,,Адам кейпіне еліктеу
Dialogue: 0,0:19:30.46,0:19:33.37,Default,,0,0,0,,Мінез-құлықты түсінуге тырысудың нәтижесі
Dialogue: 0,0:19:33.43,0:19:34.80,Default,,0,0,0,,Шатасу тудыру
Dialogue: 0,0:19:34.87,0:19:37.40,Default,,0,0,0,,Қару ретінде әлсіреген тұман
Dialogue: 0,0:19:37.74,0:19:39.31,Default,,0,0,0,,Бұл біртүрлі
Dialogue: 0,0:19:39.37,0:19:43.81,Default,,0,0,0,,Онда неге Гунзо екеуміз сіздің шабуылдарыңызға тойтарыс бердік?
Dialogue: 0,0:19:43.88,0:19:46.91,Default,,0,0,0,,Бұл жерде әлі де болуы мүмкін бе?
Dialogue: 0,0:19:47.55,0:19:50.32,Default,,0,0,0,,Себебі тактикада қателік болды.
Dialogue: 0,0:19:50.75,0:19:53.92,Default,,0,0,0,,Бірақ қатені түзетуге болады
Dialogue: 0,0:19:54.29,0:19:55.39,Default,,0,0,0,,Ал біз
Dialogue: 0,0:19:55.46,0:19:58.23,Default,,0,0,0,,Адмиралтия кодексінде көрсетілгендей
Dialogue: 0,0:19:58.29,0:20:00.86,Default,,0,0,0,,Өзіңіз болуы керек жолға оралыңыз.
Dialogue: 0,0:20:14.91,0:20:16.61,Default,,0,0,0,,Мая, кеттік.
Dialogue: 0,0:20:16.74,0:20:18.58,Default,,0,0,0,,Иә~ Қазірдің өзінде?
Dialogue: 0,0:20:18.65,0:20:19.51,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:20:20.28,0:20:21.45,Default,,0,0,0,,～
Dialogue: 0,0:20:22.35,0:20:23.45,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:20:23.82,0:20:25.95,Default,,0,0,0,,Наноматериалдардан жасалған манекен
Dialogue: 0,0:20:26.22,0:20:27.69,Default,,0,0,0,,Бірақ мұндай ауыр тапсырма...
Dialogue: 0,0:20:28.26,0:20:29.42,Default,,0,0,0,,Мүмкін болса да
Dialogue: 0,0:20:29.86,0:20:31.99,Default,,0,0,0,,Сіз сүңгуір қайықта кімсіз?
Dialogue: 0,0:20:32.26,0:20:34.26,Default,,0,0,0,,Негізгі потенциал әртүрлі
Dialogue: 0,0:20:44.57,0:20:47.47,Default,,0,0,0,,Мен Чихая Гунзо және 401
Dialogue: 0,0:20:47.54,0:20:50.44,Default,,0,0,0,,Және оған ергендердің бәрін құрт
Dialogue: 0,0:20:51.65,0:20:54.82,Default,,0,0,0,,Бір-бірімізді түсіне алмағанымыз өкінішті.
Dialogue: 0,0:20:57.62,0:20:58.55,Default,,0,0,0,,Іске қосу
Dialogue: 0,0:21:07.29,0:21:07.96,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:08.63,0:21:09.50,Default,,0,0,0,,Ах... ой
Dialogue: 0,0:21:12.97,0:21:13.97,Default,,0,0,0,,Жұмған аузыңды ашпа. Бір күні білесің.
Dialogue: 0,0:21:16.30,0:21:18.44,Default,,0,0,0,,Менің қорғанысымды қалай бұза аласың?
Dialogue: 0,0:21:18.51,0:21:20.44,Default,,0,0,0,,Сіз мұны байыппен қабылдамайсыз, солай ма?
Dialogue: 0,0:21:20.51,0:21:21.68,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:21:21.81,0:21:23.94,Default,,0,0,0,,Бірақ ол қанша уақытқа созылады?
Dialogue: 0,0:21:26.41,0:21:27.58,Default,,0,0,0,,Сол сәт
Dialogue: 0,0:21:27.71,0:21:31.75,Default,,0,0,0,,Мен сондай-ақ 401 «қызық» сөзі туралы не айтқанын білгім келді.
Dialogue: 0,0:21:31.82,0:21:33.42,Default,,0,0,0,,Мен түсіндім деп ойлаймын.
Dialogue: 0,0:21:33.75,0:21:35.52,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,0:21:35.59,0:21:37.92,Default,,0,0,0,,Бұл ақылмен салынған тұзақ болды.
Dialogue: 0,0:21:38.33,0:21:39.03,Default,,0,0,0,,Тұзақ?
Dialogue: 0,0:21:39.29,0:21:40.29,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:40.36,0:21:41.60,Default,,0,0,0,,Тұман – қару
Dialogue: 0,0:21:41.66,0:21:46.00,Default,,0,0,0,,Қарудың қызық екенін сезіну дұрыс емес.
Dialogue: 0,0:21:52.47,0:21:53.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:58.51,0:21:59.78,Default,,0,0,0,,Ха! Ол кетті!
Dialogue: 0,0:22:00.38,0:22:02.38,Default,,0,0,0,,Деректерді қалпына келтіру... Әлі кеш!
Dialogue: 0,0:22:05.79,0:22:06.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:07.75,0:22:08.92,Default,,0,0,0,,Балалар...
Dialogue: 0,0:22:09.56,0:22:11.63,Default,,0,0,0,,Ынтымақтастық тиімдірек
Dialogue: 0,0:22:11.69,0:22:12.56,Default,,0,0,0,,Хмф!
Dialogue: 0,0:22:13.49,0:22:15.83,Default,,0,0,0,,Сіз не істемексіз? Чихая Гунзо
Dialogue: 0,0:22:17.33,0:22:21.84,Default,,0,0,0,,Мен... Сізбен ынтымақтасудан тартынбас едім.
Dialogue: 0,0:22:23.00,0:22:23.87,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:25.47,0:22:26.61,Default,,0,0,0,,Уф! Аах!
Dialogue: 0,0:22:27.57,0:22:28.94,Default,,0,0,0,,Конгоу арқылы өту
Dialogue: 0,0:22:29.54,0:22:30.78,Default,,0,0,0,,Америкаға барыңыз!
Dialogue: 0,0:22:41.02,0:22:47.03,Default,,0,0,0,,♪～
Dialogue: 0,0:24:04.07,0:24:10.08,Default,,0,0,0,,～♪
