Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.00,0:00:11.51,Default,,0,0,0,,(Торпеда қозғалтқышының дыбысы)
Dialogue: 0,0:00:11.74,0:00:12.74,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:00:40.74,0:00:41.74,Default,,0,0,0,,Жау тірі, аман!
Dialogue: 0,0:00:41.80,0:00:44.37,Default,,0,0,0,,Барлық шабуылдар өшірілген
Dialogue: 0,0:00:45.31,0:00:49.31,Default,,0,0,0,,Сіз адамзатта қалған барлық от күшін шоғырландырып жатырсыз, солай ма?
Dialogue: 0,0:00:49.78,0:00:51.45,Default,,0,0,0,,Осы мөлшермен де...
Dialogue: 0,0:00:51.51,0:00:52.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:22.54,0:01:24.85,Default,,0,0,0,,21 ғасырдың басы
Dialogue: 0,0:01:25.11,0:01:28.12,Default,,0,0,0,,Ғаламдық жылыну әсерінен және т.б.
Dialogue: 0,0:01:28.18,0:01:31.19,Default,,0,0,0,,Көптеген жерүсті базасын жоғалтты
Dialogue: 0,0:01:32.12,0:01:34.29,Default,,0,0,0,,Және жауап ретінде
Dialogue: 0,0:01:34.36,0:01:37.53,Default,,0,0,0,,Белгісіз «Тұман флоты» пайда болады
Dialogue: 0,0:01:37.79,0:01:40.16,Default,,0,0,0,,Көлік жолдары жабық
Dialogue: 0,0:01:40.40,0:01:44.27,Default,,0,0,0,,Адамдар барлық мұхиттардан қуылды.
Dialogue: 0,0:01:46.23,0:01:48.40,Default,,0,0,0,,Соңғы шайқасқа 7 жыл
Dialogue: 0,0:01:48.77,0:01:50.84,Default,,0,0,0,,Саяси экономия күйреді
Dialogue: 0,0:01:51.27,0:01:55.14,Default,,0,0,0,,Байланыс спутниктері мен суасты телеграф кабельдері жойылды.
Dialogue: 0,0:01:55.21,0:01:58.15,Default,,0,0,0,,Сонымен қатар, олар шығаратын кедергі толқындары арқылы
Dialogue: 0,0:01:58.28,0:02:00.68,Default,,0,0,0,,Барлық байланыстар бұғатталды.
Dialogue: 0,0:02:01.15,0:02:03.65,Default,,0,0,0,,Елдер өздерін оқшаулауға мәжбүр
Dialogue: 0,0:02:03.72,0:02:07.86,Default,,0,0,0,,Тіпті бір-бірінің аман қалғанын растау қиынға соқты.
Dialogue: 0,0:02:18.73,0:02:20.27,Default,,0,0,0,,Жағдайды бақылау
Dialogue: 0,0:02:22.47,0:02:23.51,Default,,0,0,0,,Тұман...
Dialogue: 0,0:02:24.77,0:02:27.31,Default,,0,0,0,,Сіз жүктің ішіндегісін иіскедіңіз бе?
Dialogue: 0,0:02:28.18,0:02:29.21,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:02:29.28,0:02:31.28,Default,,0,0,0,,Іске қосуға дейін уақыт сатып алыңыз!
Dialogue: 0,0:02:31.41,0:02:32.41,Default,,0,0,0,,ＳＳＴＯ！
Dialogue: 0,0:02:32.48,0:02:33.35,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:02:57.17,0:02:59.37,Default,,0,0,0,,Аматсуказэ Тачиказэ батып бара жатыр!
Dialogue: 0,0:02:59.64,0:03:01.41,Default,,0,0,0,,Мина алаңынан өтетін тұман!
Dialogue: 0,0:03:02.21,0:03:04.45,Default,,0,0,0,,Біз ештеңе істей алмаймыз ба?
Dialogue: 0,0:03:04.51,0:03:07.68,Default,,0,0,0,,Ах...! Белгісіз тиесілігі сүңгуір қайық тез жақындап келеді!
Dialogue: 0,0:03:07.82,0:03:09.48,Default,,0,0,0,,Жоқ... бұл жаңалық?
Dialogue: 0,0:03:09.55,0:03:10.42,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:03:10.95,0:03:12.32,Default,,0,0,0,,Бұл сигнал
Dialogue: 0,0:03:12.59,0:03:13.96,Default,,0,0,0,,«I № 401»!
Dialogue: 0,0:03:23.46,0:03:24.97,Default,,0,0,0,,Бұл жолы бізге өтініш
Dialogue: 0,0:03:25.53,0:03:26.87,Default,,0,0,0,,Тұманның алға жылжуын тоқтату
Dialogue: 0,0:03:26.94,0:03:28.24,Default,,0,0,0,,Немесе батып кетті
Dialogue: 0,0:03:28.64,0:03:31.81,Default,,0,0,0,,SSTO сәтті іске қосу үшін.
Dialogue: 0,0:03:31.94,0:03:33.88,Default,,0,0,0,,Iona деректері...
Dialogue: 0,0:03:36.84,0:03:38.21,Default,,0,0,0,,Нагара сыныбы Нагара
Dialogue: 0,0:03:38.28,0:03:39.45,Default,,0,0,0,,Жеңіл крейсер
Dialogue: 0,0:03:39.81,0:03:41.52,Default,,0,0,0,,Ауыстыру 6010 т
Dialogue: 0,0:03:41.92,0:03:43.69,Default,,0,0,0,,Толқынды броньды мәжбүрлі жабдық
Dialogue: 0,0:03:44.35,0:03:46.99,Default,,0,0,0,,12,3 см қос белсенді мұнаралар
Dialogue: 0,0:03:47.26,0:03:47.92,Default,,0,0,0,,3 топ және 6 қақпа
Dialogue: 0,0:03:48.66,0:03:50.89,Default,,0,0,0,,Кеме түбіндегі 12 торпедалық түтік
Dialogue: 0,0:03:51.59,0:03:53.76,Default,,0,0,0,,Басқалары 3 жоғары бұрышты лазерлік мылтық
Dialogue: 0,0:03:54.80,0:03:55.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:56.63,0:03:58.73,Default,,0,0,0,,Зымыран ұшыру модулі және
Dialogue: 0,0:03:58.87,0:04:00.57,Default,,0,0,0,,Көптеген шабуыл жүйелері
Dialogue: 0,0:04:01.24,0:04:03.24,Default,,0,0,0,,Максималды жылдамдық 60 түйін
Dialogue: 0,0:04:03.67,0:04:05.24,Default,,0,0,0,,Сүңгуір қабілеті жоқ
Dialogue: 0,0:04:06.51,0:04:08.81,Default,,0,0,0,,Тұманға қарсы стандартты крейсер
Dialogue: 0,0:04:08.88,0:04:11.71,Default,,0,0,0,,Иә, шайқас басталды, Кёхэй!
Dialogue: 0,0:04:11.88,0:04:12.78,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:04:13.51,0:04:14.85,Default,,0,0,0,,Әртүрлі торпедаларды тиеу!
Dialogue: 0,0:04:21.42,0:04:23.42,Default,,0,0,0,,No 7 Эрозиялық торпедо ұшыру!
Dialogue: 0,0:04:28.56,0:04:29.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:29.83,0:04:32.27,Default,,0,0,0,,Жоғары жылдамдықты қозғалтқыш дыбысы Торпедо 2 Жақындап келе жатыр!
Dialogue: 0,0:04:32.40,0:04:33.27,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,0:04:33.33,0:04:34.90,Default,,0,0,0,,1 № 2 Сурет!
Dialogue: 0,0:04:34.97,0:04:36.54,Default,,0,0,0,,Қозғалтқыш тоқтады Дайв!
Dialogue: 0,0:04:37.01,0:04:38.37,Default,,0,0,0,,Жылдам сүңгу
Dialogue: 0,0:04:47.78,0:04:49.55,Default,,0,0,0,,Клейнфилд кеңеюі
Dialogue: 0,0:04:51.42,0:04:52.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:52.35,0:04:53.55,Default,,0,0,0,,Торпедо 5 соғу үшін...
Dialogue: 0,0:04:53.92,0:04:54.79,Default,,0,0,0,,４…
Dialogue: 0,0:04:55.29,0:04:55.96,Default,,0,0,0,,３…
Dialogue: 0,0:04:56.02,0:04:58.39,Default,,0,0,0,,Торпеданың эрозиясының соққылары
Dialogue: 0,0:04:58.46,0:05:00.46,Default,,0,0,0,,Ха! Нагара оң жақ жаққа бұрылуда
Dialogue: 0,0:05:00.60,0:05:02.36,Default,,0,0,0,,Клейнфилд кеңеюі!
Dialogue: 0,0:05:02.50,0:05:03.36,Default,,0,0,0,,Мен жай ғана жағдайды біраз бақылап тұрамын.
Dialogue: 0,0:05:20.98,0:05:23.55,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:05:23.79,0:05:24.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:29.39,0:05:30.43,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:33.46,0:05:36.86,Default,,0,0,0,,«I № 401 Көк болат»
Dialogue: 0,0:05:50.41,0:05:52.71,Default,,0,0,0,,Континентаралық байланысқа арналған ССТО
Dialogue: 0,0:05:52.81,0:05:54.75,Default,,0,0,0,,ұшыру сәтті өтті!
Dialogue: 0,0:05:54.88,0:05:57.05,Default,,0,0,0,,Хаа... О, құдай-ау.
Dialogue: 0,0:05:57.69,0:06:00.09,Default,,0,0,0,,Жапониядан басқа елдерге жіберілген заттар
Dialogue: 0,0:06:00.35,0:06:01.86,Default,,0,0,0,,Бұл шынымен бар ма?
Dialogue: 0,0:06:02.12,0:06:04.13,Default,,0,0,0,,Сіз оны іске қосып жатырсыз, себебі ол сонда, солай ма?
Dialogue: 0,0:06:14.10,0:06:15.07,Default,,0,0,0,,Нагара
Dialogue: 0,0:06:15.60,0:06:17.97,Default,,0,0,0,,Сіз жай ғана бұйрықтарды орындадыңыз.
Dialogue: 0,0:06:19.14,0:06:20.01,Default,,0,0,0,,Иона
Dialogue: 0,0:06:21.78,0:06:22.94,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:06:23.98,0:06:25.91,Default,,0,0,0,,Клейнфилдте шаршадым
Dialogue: 0,0:06:26.05,0:06:26.91,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:30.02,0:06:32.39,Default,,0,0,0,,Тұман неліктен пайда болды?
Dialogue: 0,0:06:33.09,0:06:35.02,Default,,0,0,0,,Ол не үшін бар?
Dialogue: 0,0:06:35.86,0:06:36.92,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:06:37.39,0:06:40.43,Default,,0,0,0,,Біз жай ғана бұйрықтарды орындаймыз.
Dialogue: 0,0:06:40.73,0:06:41.73,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:06:42.06,0:06:44.17,Default,,0,0,0,,Менің бұйрығым болғандықтан ұрысып жатырсың ба?
Dialogue: 0,0:06:44.80,0:06:45.67,Default,,0,0,0,,Иә
Dialogue: 0,0:06:46.57,0:06:47.57,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:48.40,0:06:49.90,Default,,0,0,0,,Мен сенің кемеңмін
Dialogue: 0,0:06:50.74,0:06:52.91,Default,,0,0,0,,Мен екі жыл бұрын оянғаннан бері
Dialogue: 0,0:07:02.98,0:07:04.49,Default,,0,0,0,,Чихая Гунзо да
Dialogue: 0,0:07:04.55,0:07:07.05,Default,,0,0,0,,Сіз осы инспекцияның мүшесі ретінде таңдадыңыз ба?
Dialogue: 0,0:07:07.62,0:07:09.62,Default,,0,0,0,,Өйткені оның бағалары өте жақсы.
Dialogue: 0,0:07:09.76,0:07:11.56,Default,,0,0,0,,Бұл бәрі емес, солай ма?
Dialogue: 0,0:07:11.69,0:07:14.86,Default,,0,0,0,,Чихая – капитанның шайқаста қаза тапқан жалғыз ұлы.
Dialogue: 0,0:07:15.00,0:07:17.70,Default,,0,0,0,,Бізден айырмашылығы, оларға артықшылық беріледі.
Dialogue: 0,0:07:18.10,0:07:19.67,Default,,0,0,0,,Міне...
Dialogue: 0,0:07:19.87,0:07:23.57,Default,,0,0,0,,Әкем Тұманға бұрылды деген өсек рас па?
Dialogue: 0,0:07:23.77,0:07:24.97,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:07:25.04,0:07:28.04,Default,,0,0,0,,Ұлы теңіз шайқасы туралы ақпарат жария етілмеді.
Dialogue: 0,0:07:28.18,0:07:31.71,Default,,0,0,0,,Не болса да Чихаяның иісі сұмдық.
Dialogue: 0,0:07:33.82,0:07:37.79,Default,,0,0,0,,Сіз көретін нәрсе - бұл өте әскери құпия.
Dialogue: 0,0:07:37.85,0:07:42.56,Default,,0,0,0,,Сіздердің болашағыңыз зор деп есептелетіндерге ғана бұны жария етуге рұқсат етіледі.
Dialogue: 0,0:07:42.89,0:07:44.46,Default,,0,0,0,,Өте құпия…
Dialogue: 0,0:07:44.86,0:07:46.86,Default,,0,0,0,,Сен офицер боласың
Dialogue: 0,0:07:46.99,0:07:48.70,Default,,0,0,0,,Мұны білуге құқығыңыз бар.
Dialogue: 0,0:07:48.76,0:07:49.76,Default,,0,0,0,,Жеңіл
Dialogue: 0,0:07:50.03,0:07:52.60,Default,,0,0,0,,Бұл ұйымның ұсынысы емес пе?
Dialogue: 0,0:08:02.51,0:08:04.51,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:08:04.98,0:08:05.98,Default,,0,0,0,,О...
Dialogue: 0,0:08:10.99,0:08:13.92,Default,,0,0,0,,I-401 сүңгуір қайығы.
Dialogue: 0,0:08:14.56,0:08:15.72,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:08:16.59,0:08:19.09,Default,,0,0,0,,Бұл тұтқынға алынған тұман кемесі.
Dialogue: 0,0:08:19.76,0:08:23.93,Default,,0,0,0,,Пішін Тынық мұхиты соғысындағы сүңгуір қайықтың үлгісінде жасалған.
Dialogue: 0,0:08:24.00,0:08:25.70,Default,,0,0,0,,Адамгершілік емес
Dialogue: 0,0:08:26.60,0:08:29.27,Default,,0,0,0,,Жоғарғы басшылық осындай нәрсені жасырып отырды.
Dialogue: 0,0:08:29.54,0:08:32.04,Default,,0,0,0,,Көпшілік алдында жасай алмайтының рас.
Dialogue: 0,0:08:32.51,0:08:33.67,Default,,0,0,0,,Ұлы теңізден кейін
Dialogue: 0,0:08:33.74,0:08:37.51,Default,,0,0,0,,Бұл портта қару-жарақпен жабылған жалғыз суасты қайық пайда болды.
Dialogue: 0,0:08:37.88,0:08:40.11,Default,,0,0,0,,Себеп пен мақсат белгісіз
Dialogue: 0,0:08:40.58,0:08:43.92,Default,,0,0,0,,Оны біз қарсылықсыз қолға түсірдік.
Dialogue: 0,0:08:44.65,0:08:46.22,Default,,0,0,0,,Егер бұл кеме шешілсе
Dialogue: 0,0:08:46.29,0:08:47.99,Default,,0,0,0,,Сондай-ақ тұман жігіттердің әлсіз жақтары?
Dialogue: 0,0:08:48.12,0:08:49.12,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:49.26,0:08:51.26,Default,,0,0,0,,Дегенмен, зерттеудің басталғанына 7 жыл болды.
Dialogue: 0,0:08:51.66,0:08:54.06,Default,,0,0,0,,Барлық мүмкін болатын құралдар қолданылғанымен
Dialogue: 0,0:08:54.53,0:08:56.30,Default,,0,0,0,,Бұл жігіт бізді қабылдамайды.
Dialogue: 0,0:08:56.56,0:08:57.30,Default,,0,0,0,,А...?
Dialogue: 0,0:08:57.83,0:08:59.83,Default,,0,0,0,,Бұл оны бөлшектеуге болмайтынын білдіре ме?
Dialogue: 0,0:09:00.17,0:09:01.74,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:09:02.67,0:09:03.84,Default,,0,0,0,,Тұман кемесі…
Dialogue: 0,0:09:04.54,0:09:05.57,Default,,0,0,0,,Адамгершілік
Dialogue: 0,0:09:05.91,0:09:06.77,Default,,0,0,0,,Жау…
Dialogue: 0,0:09:09.14,0:09:10.08,Default,,0,0,0,,Айтамын ғой, қой!
Dialogue: 0,0:09:12.68,0:09:14.62,Default,,0,0,0,,Чихая... Гунзо
Dialogue: 0,0:09:17.18,0:09:18.55,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:09:18.72,0:09:19.59,Default,,0,0,0,,Деректерді алыңыз!
Dialogue: 0,0:09:19.99,0:09:21.99,Default,,0,0,0,,Бұл... ауырлық шамасының реакциясы ма?
Dialogue: 0,0:09:22.06,0:09:23.62,Default,,0,0,0,,401 іске қосылды!
Dialogue: 0,0:09:23.82,0:09:24.99,Default,,0,0,0,,Не! Неге қазір?
Dialogue: 0,0:09:25.06,0:09:26.09,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:09:26.16,0:09:27.93,Default,,0,0,0,,Қат! Оны сыртқа ағызбаңыз!
Dialogue: 0,0:09:28.06,0:09:29.63,Default,,0,0,0,,Төбенің сауыттарын дереу жабыңыз!
Dialogue: 0,0:09:30.73,0:09:32.07,Default,,0,0,0,,Бұл — сенің бастығыңның бұйрығы. Айтылғанды орында
Dialogue: 0,0:09:37.27,0:09:38.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:50.85,0:09:52.72,Default,,0,0,0,,Кім? Сізде осындай бала болды ма?
Dialogue: 0,0:09:52.79,0:09:54.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:03.83,0:10:04.83,Default,,0,0,0,,Табылды
Dialogue: 0,0:10:05.30,0:10:06.90,Default,,0,0,0,,Гунзо Чихая
Dialogue: 0,0:10:13.37,0:10:14.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:15.01,0:10:16.71,Default,,0,0,0,,Сіз... Сіз кімсіз?
Dialogue: 0,0:10:16.78,0:10:18.25,Default,,0,0,0,,Біреуді іздеп жатырмын... Уа!
Dialogue: 0,0:10:18.38,0:10:20.31,Default,,0,0,0,,Қандай әдемі қыз!
Dialogue: 0,0:10:20.68,0:10:22.82,Default,,0,0,0,,Жоқ, сізге пайда жоқ.
Dialogue: 0,0:10:22.88,0:10:24.05,Default,,0,0,0,,Не? Күте тұрыңыз...
Dialogue: 0,0:10:26.99,0:10:27.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:28.26,0:10:31.26,Default,,0,0,0,,О! Сен әдемісің. Сізге бірдеңе керек пе?
Dialogue: 0,0:10:32.23,0:10:33.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:33.83,0:10:34.83,Default,,0,0,0,,Фалко, мен саған бір өтінішпен жүгінер едім…
Dialogue: 0,0:10:35.10,0:10:36.20,Default,,0,0,0,,Гунзо Чихая
Dialogue: 0,0:10:36.70,0:10:37.73,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:10:38.07,0:10:40.13,Default,,0,0,0,,Шо Чихаяның ұлы
Dialogue: 0,0:10:41.07,0:10:43.00,Default,,0,0,0,,Әке... не?
Dialogue: 0,0:10:43.37,0:10:47.21,Default,,0,0,0,,Маған Чихая Шо мүсінінің ұлымен кездесу бұйырылды.
Dialogue: 0,0:10:47.68,0:10:48.71,Default,,0,0,0,,Бұйрық?
Dialogue: 0,0:10:49.88,0:10:50.75,Default,,0,0,0,,Хаа…
Dialogue: 0,0:10:51.01,0:10:52.88,Default,,0,0,0,,Бұл жаңа қудалау ма?
Dialogue: 0,0:10:53.18,0:10:55.12,Default,,0,0,0,,Бос нәрселер туралы ойлау
Dialogue: 0,0:10:55.18,0:10:56.12,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:56.32,0:10:57.75,Default,,0,0,0,,Қудалау емес
Dialogue: 0,0:10:57.82,0:11:00.22,Default,,0,0,0,,Онда неге қайтыс болған әкенің атын атадың?
Dialogue: 0,0:11:00.82,0:11:01.99,Default,,0,0,0,,Өйткені бұл факт
Dialogue: 0,0:11:02.86,0:11:04.16,Default,,0,0,0,,Бұл не? сен
Dialogue: 0,0:11:04.69,0:11:07.19,Default,,0,0,0,,Иона Иә, мен оны тіркедім.
Dialogue: 0,0:11:07.76,0:11:08.43,Default,,0,0,0,,Иона?
Dialogue: 0,0:11:08.86,0:11:10.23,Default,,0,0,0,,Мен бұл жерде сөйлесе алмаймын.
Dialogue: 0,0:11:13.87,0:11:14.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:14.90,0:11:15.94,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:11:16.34,0:11:18.21,Default,,0,0,0,,Түнде жалғыз кел
Dialogue: 0,0:11:18.27,0:11:19.14,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:19.21,0:11:20.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:20.71,0:11:22.78,Default,,0,0,0,,Гунзо! Не болып жатыр?
Dialogue: 0,0:11:23.01,0:11:25.71,Default,,0,0,0,,Сен сияқты түзу жігіттің алданып қалатынына сенбеймін.
Dialogue: 0,0:11:39.19,0:11:40.23,Default,,0,0,0,,Пунипуни?
Dialogue: 0,0:11:44.33,0:11:45.40,Default,,0,0,0,,Сезім…
Dialogue: 0,0:11:46.70,0:11:48.77,Default,,0,0,0,,Бұл... адам
Dialogue: 0,0:12:00.82,0:12:01.82,Default,,0,0,0,,Міне, келдік
Dialogue: 0,0:12:02.08,0:12:04.25,Default,,0,0,0,,Сізге қоңырау шалу себебін айта аласыз ба?
Dialogue: 0,0:12:04.75,0:12:07.15,Default,,0,0,0,,Нақтырақ айтсам, мен күттім.
Dialogue: 0,0:12:07.46,0:12:09.46,Default,,0,0,0,,Ха... Мен үйге бара жатырмын.
Dialogue: 0,0:12:09.79,0:12:10.46,Default,,0,0,0,,No
Dialogue: 0,0:12:10.72,0:12:14.06,Default,,0,0,0,,Менің басқалардың ойынына қатысуға уақытым жоқ.
Dialogue: 0,0:12:14.20,0:12:16.73,Default,,0,0,0,,Ұйқыдан тұруға 11 сағат қалды.
Dialogue: 0,0:12:16.93,0:12:17.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:18.30,0:12:20.17,Default,,0,0,0,,Менің айтып отырғаным бұл емес.
Dialogue: 0,0:12:20.73,0:12:23.40,Default,,0,0,0,,Мен қажетсіз нәрселермен айналысқым келмейді деймін.
Dialogue: 0,0:12:23.87,0:12:25.04,Default,,0,0,0,,Мен босқа кеттім бе?
Dialogue: 0,0:12:26.74,0:12:28.08,Default,,0,0,0,,Маған өз ісіңді айт
Dialogue: 0,0:12:28.74,0:12:30.48,Default,,0,0,0,,Шо Чихаяның ұлы
Dialogue: 0,0:12:30.74,0:12:33.08,Default,,0,0,0,,Гунзомен кездесіп, соңынан еріңіз
Dialogue: 0,0:12:33.45,0:12:35.48,Default,,0,0,0,,Бұл менің ішімде
Dialogue: 0,0:12:35.75,0:12:37.32,Default,,0,0,0,,Бір ғана команда
Dialogue: 0,0:12:38.02,0:12:39.39,Default,,0,0,0,,Мен жеті жыл болдым
Dialogue: 0,0:12:39.45,0:12:41.39,Default,,0,0,0,,Сыртқы әлемнен бөлінген
Dialogue: 0,0:12:41.79,0:12:42.52,Default,,0,0,0,,7 жыл?
Dialogue: 0,0:12:43.02,0:12:44.39,Default,,0,0,0,,Бұл не? сен
Dialogue: 0,0:12:45.03,0:12:47.43,Default,,0,0,0,,Мен маған берілген бұйрықтарды орындаймын
Dialogue: 0,0:12:47.76,0:12:48.50,Default,,0,0,0,,Құралдар
Dialogue: 0,0:12:50.26,0:12:51.13,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:54.50,0:12:56.37,Default,,0,0,0,,Сіз ше...?
Dialogue: 0,0:12:57.04,0:12:58.27,Default,,0,0,0,,Гунзо Чихая
Dialogue: 0,0:12:59.01,0:13:01.34,Default,,0,0,0,,Маған сенің соңынан еруімді айтты
Dialogue: 0,0:13:01.81,0:13:03.48,Default,,0,0,0,,Мен басқа ештеңе білмеймін
Dialogue: 0,0:13:04.11,0:13:04.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:05.78,0:13:06.45,Default,,0,0,0,,Растау
Dialogue: 0,0:13:06.78,0:13:08.28,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:13:09.02,0:13:10.38,Default,,0,0,0,,Менің мақсатым?
Dialogue: 0,0:13:14.42,0:13:15.46,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:19.99,0:13:20.93,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:21.20,0:13:22.96,Default,,0,0,0,,Қазіргі тоқырауды бұзып...
Dialogue: 0,0:13:23.10,0:13:24.47,Default,,0,0,0,,Мен күш алғым келеді
Dialogue: 0,0:13:25.50,0:13:27.07,Default,,0,0,0,,Тіпті осындай жерде
Dialogue: 0,0:13:27.40,0:13:30.00,Default,,0,0,0,,Бейбітшілік пен бос өткен уақыт өтіп жатыр
Dialogue: 0,0:13:30.07,0:13:30.94,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:13:31.01,0:13:33.34,Default,,0,0,0,,Мен мұны істеу үшін өмір сүрмеймін.
Dialogue: 0,0:13:33.84,0:13:34.58,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:35.28,0:13:37.98,Default,,0,0,0,,Соңында мен іске кірісе аламын.
Dialogue: 0,0:13:46.42,0:13:48.12,Default,,0,0,0,,Қаш!
Dialogue: 0,0:13:49.92,0:13:51.26,Default,,0,0,0,,(Зымыран ұшыру дыбысы)
Dialogue: 0,0:14:05.34,0:14:08.04,Default,,0,0,0,,A401 Бастау
Dialogue: 0,0:14:12.31,0:14:14.18,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:14:14.58,0:14:17.59,Default,,0,0,0,,I401 Жасырын иттен кеткен
Dialogue: 0,0:14:17.92,0:14:19.32,Default,,0,0,0,,Ақымақтық деген бар ма?
Dialogue: 0,0:14:19.39,0:14:20.55,Default,,0,0,0,,Бірақ шын мәнінде...
Dialogue: 0,0:14:21.22,0:14:22.39,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:14:22.52,0:14:24.36,Default,,0,0,0,,Уау... аа...
Dialogue: 0,0:14:26.09,0:14:26.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:34.94,0:14:35.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:39.24,0:14:40.41,Default,,0,0,0,,401…
Dialogue: 0,0:14:41.21,0:14:42.24,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:14:42.98,0:14:44.98,Default,,0,0,0,,Сен тұмансың...
Dialogue: 0,0:14:45.31,0:14:46.25,Default,,0,0,0,,Бұл?
Dialogue: 0,0:14:46.38,0:14:47.25,Default,,0,0,0,,Иә
Dialogue: 0,0:14:48.22,0:14:49.08,Default,,0,0,0,,Жау?
Dialogue: 0,0:14:49.38,0:14:50.32,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:14:51.22,0:14:52.55,Default,,0,0,0,,Мен білетін жалғыз нәрсе
Dialogue: 0,0:14:53.19,0:14:55.56,Default,,0,0,0,,Сізбен байланысу және бағыну
Dialogue: 0,0:14:56.26,0:14:59.66,Default,,0,0,0,,Бұл менің ішімде өмір сүретін жалғыз бұйрық
Dialogue: 0,0:15:02.00,0:15:03.56,Default,,0,0,0,,Біз қарумыз
Dialogue: 0,0:15:04.00,0:15:05.67,Default,,0,0,0,,Бұйрық бойынша шайқас
Dialogue: 0,0:15:06.00,0:15:07.57,Default,,0,0,0,,Мұның бәрі бар
Dialogue: 0,0:15:08.34,0:15:11.27,Default,,0,0,0,,Сонымен, бізге пәрмен керек
Dialogue: 0,0:15:11.41,0:15:14.11,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:15:19.65,0:15:21.02,Default,,0,0,0,,401
Dialogue: 0,0:15:23.52,0:15:25.95,Default,,0,0,0,,Сен менің кемем бола аласың.
Dialogue: 0,0:15:35.36,0:15:36.30,Default,,0,0,0,,Суреттер тобы
Dialogue: 0,0:15:38.60,0:15:40.60,Default,,0,0,0,,Маған мін
Dialogue: 0,0:15:42.50,0:15:43.94,Default,,0,0,0,,Қорғаныс қабырғасынан өту
Dialogue: 0,0:15:44.24,0:15:45.41,Default,,0,0,0,,Қарсыласпаңыз
Dialogue: 0,0:15:45.57,0:15:46.44,Default,,0,0,0,,Иә
Dialogue: 0,0:15:52.71,0:15:54.32,Default,,0,0,0,,А... сізде бар ма?
Dialogue: 0,0:15:54.68,0:15:55.68,Default,,0,0,0,,Аз
Dialogue: 0,0:15:56.02,0:15:57.05,Default,,0,0,0,,Қанша?
Dialogue: 0,0:15:57.12,0:15:58.05,Default,,0,0,0,,30 секунд
Dialogue: 0,0:15:58.15,0:15:59.02,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:59.45,0:16:01.46,Default,,0,0,0,,Бұл адам денесі алғаш рет енгізілген.
Dialogue: 0,0:16:01.59,0:16:03.12,Default,,0,0,0,,Есеп уақытында жасалмаған
Dialogue: 0,0:16:03.19,0:16:04.06,Default,,0,0,0,,Жыртқыш туралы не айтасыз?
Dialogue: 0,0:16:04.39,0:16:06.99,Default,,0,0,0,,Гравитонды балласттың бастапқы параметрлері әлі орнатылмаған.
Dialogue: 0,0:16:15.47,0:16:17.30,Default,,0,0,0,,өріс жоғалғанша 5 секунд
Dialogue: 0,0:16:17.64,0:16:19.37,Default,,0,0,0,,４… ３…
Dialogue: 0,0:16:19.51,0:16:21.08,Default,,0,0,0,,２… １…
Dialogue: 0,0:16:21.71,0:16:22.71,Default,,0,0,0,,Клейнфилд
Dialogue: 0,0:16:23.04,0:16:24.21,Default,,0,0,0,,Жоғалып кету (Гунзо) Ах!
Dialogue: 0,0:16:27.18,0:16:28.18,Default,,0,0,0,,Артқы жағынан ұру
Dialogue: 0,0:16:28.28,0:16:29.15,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:16:30.02,0:16:32.05,Default,,0,0,0,,Егер сіз қазір ештеңені өзгерте алмасаңыз
Dialogue: 0,0:16:32.25,0:16:34.29,Default,,0,0,0,,Бұл өлгенмен бірдей.
Dialogue: 0,0:16:35.06,0:16:35.99,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:16:37.09,0:16:38.33,Default,,0,0,0,,Гравитонды балласт
Dialogue: 0,0:16:39.13,0:16:40.13,Default,,0,0,0,,Параметр аяқталды
Dialogue: 0,0:16:40.19,0:16:41.06,Default,,0,0,0,,Күту режимі
Dialogue: 0,0:16:41.23,0:16:42.26,Default,,0,0,0,,Сүңгу!
Dialogue: 0,0:16:52.54,0:16:54.24,Default,,0,0,0,,401 Жоғалған
Dialogue: 0,0:16:55.54,0:16:56.61,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:16:57.11,0:16:58.21,Default,,0,0,0,,Бұл сізсіз
Dialogue: 0,0:16:58.28,0:17:00.25,Default,,0,0,0,,Пассивті сонар қалай әрекет етеді?
Dialogue: 0,0:17:00.45,0:17:03.45,Default,,0,0,0,,Іздеу ауқымында кеме жаңғырығы жоқ
Dialogue: 0,0:17:04.05,0:17:05.42,Default,,0,0,0,,Ұрыстың соңы
Dialogue: 0,0:17:08.26,0:17:09.62,Default,,0,0,0,,Хаа... (Гунзо) Эй, эй!
Dialogue: 0,0:17:10.09,0:17:11.26,Default,,0,0,0,,жүйке
Dialogue: 0,0:17:11.76,0:17:13.46,Default,,0,0,0,,Бірінші капитан
Dialogue: 0,0:17:14.06,0:17:15.10,Default,,0,0,0,,401…
Dialogue: 0,0:17:15.50,0:17:16.73,Default,,0,0,0,,Мен Ионамын
Dialogue: 0,0:17:17.06,0:17:17.73,Default,,0,0,0,,Е...
Dialogue: 0,0:17:18.07,0:17:20.10,Default,,0,0,0,,Маған берілгені жазылған.
Dialogue: 0,0:17:20.50,0:17:21.44,Default,,0,0,0,,Иона…
Dialogue: 0,0:17:25.24,0:17:27.64,Default,,0,0,0,,Содан бері бізді іздеуде.
Dialogue: 0,0:17:28.11,0:17:28.78,Default,,0,0,0,,Иә
Dialogue: 0,0:17:29.38,0:17:32.25,Default,,0,0,0,,Мен кеме капитанымын
Dialogue: 0,0:17:32.55,0:17:34.31,Default,,0,0,0,,Мені алып кетіңіз
Dialogue: 0,0:17:34.65,0:17:36.35,Default,,0,0,0,,Гунцоның жауабына
Dialogue: 0,0:17:37.45,0:17:38.32,Default,,0,0,0,,О
Dialogue: 0,0:17:40.75,0:17:41.76,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:17:42.59,0:17:44.29,Default,,0,0,0,,Тұманға опасыздық жасаған
Dialogue: 0,0:17:45.06,0:17:46.56,Default,,0,0,0,,Бұл үлкен жетістік.
Dialogue: 0,0:17:58.34,0:18:01.68,Default,,0,0,0,,Бұл жолы ССТО мәселесі ауыр болды.
Dialogue: 0,0:18:02.21,0:18:03.44,Default,,0,0,0,,Чихая Гунзо-кун
Dialogue: 0,0:18:04.18,0:18:06.35,Default,,0,0,0,,Сіз клиентсіз бе, Уэйн мырза?
Dialogue: 0,0:18:06.75,0:18:08.82,Default,,0,0,0,,Егер сіз оны тезірек сұрасаңыз.
Dialogue: 0,0:18:09.28,0:18:11.35,Default,,0,0,0,,Біз әскерилерге келтірілген шығынды азайта алдық.
Dialogue: 0,0:18:11.49,0:18:14.82,Default,,0,0,0,,Тұманның кептелуі қалааралық байланысты болдырмайды.
Dialogue: 0,0:18:15.52,0:18:16.86,Default,,0,0,0,,Өзіңізді қатты итермеңіз.
Dialogue: 0,0:18:17.42,0:18:18.29,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:18:18.49,0:18:20.36,Default,,0,0,0,,Ересектерге ыңғайлы
Dialogue: 0,0:18:20.56,0:18:22.33,Default,,0,0,0,,Саясат...?
Dialogue: 0,0:18:22.86,0:18:24.10,Default,,0,0,0,,Бұл софистика.
Dialogue: 0,0:18:24.20,0:18:25.83,Default,,0,0,0,,Бұл жай ғана айналма жол емес пе?
Dialogue: 0,0:18:26.43,0:18:27.30,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:27.87,0:18:30.80,Default,,0,0,0,,Сіз сияқты әркімнің қолынан келе бермейді.
Dialogue: 0,0:18:31.11,0:18:33.24,Default,,0,0,0,,Аралас жұмыс деген де бар.
Dialogue: 0,0:18:33.54,0:18:34.48,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:34.58,0:18:35.44,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:18:36.48,0:18:38.35,Default,,0,0,0,,Содан кейін сұрау аяқталды.
Dialogue: 0,0:18:38.55,0:18:39.71,Default,,0,0,0,,Біз барамыз
Dialogue: 0,0:18:40.55,0:18:41.58,Default,,0,0,0,,Келісесіз бе?
Dialogue: 0,0:18:42.12,0:18:43.68,Default,,0,0,0,,Егер оған бірдеңе болса ше?
Dialogue: 0,0:18:44.79,0:18:47.15,Default,,0,0,0,,Ол бізге шабуыл жасады
Dialogue: 0,0:18:48.62,0:18:49.79,Default,,0,0,0,,Чихая-кун
Dialogue: 0,0:18:50.46,0:18:53.46,Default,,0,0,0,,Сіздің шайқасыңыздан шығудың жолы бар ма?
Dialogue: 0,0:18:54.19,0:18:55.70,Default,,0,0,0,,Мені қате түсінбеңіз
Dialogue: 0,0:18:56.23,0:18:57.46,Default,,0,0,0,,Керісінше I
Dialogue: 0,0:18:57.66,0:19:02.24,Default,,0,0,0,,Мен сіздің соңғы екі жылдағы тұманмен күресудегі жетістіктеріңізді жоғары бағалаймын.
Dialogue: 0,0:19:02.57,0:19:04.34,Default,,0,0,0,,(Фушигиро) Мұндай болмайды. Ақыры пайдалана алатын жабдықтаушыларымыз шектеулі ғой.
Dialogue: 0,0:19:04.81,0:19:05.74,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:06.14,0:19:06.87,Default,,0,0,0,,Мұндайды қалай байқадың, Рюзаки?
Dialogue: 0,0:19:07.27,0:19:11.28,Default,,0,0,0,,Бізге орбитада SSTO атып түсірілгені туралы хабарлады.
Dialogue: 0,0:19:11.65,0:19:12.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:13.28,0:19:14.25,Default,,0,0,0,,Ол үшін
Dialogue: 0,0:19:14.31,0:19:16.88,Default,,0,0,0,,Жапонияда зерттелген және жасалған жаңа қарулар
Dialogue: 0,0:19:17.15,0:19:19.39,Default,,0,0,0,,Құрамында дірілдейтін оқтұмсықтың үлгісі бар
Dialogue: 0,0:19:19.65,0:19:20.92,Default,,0,0,0,,Дірілдейтін оқтұмсық?
Dialogue: 0,0:19:21.26,0:19:22.19,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:22.49,0:19:23.66,Default,,0,0,0,,Соңғы екі жыл
Dialogue: 0,0:19:23.86,0:19:26.29,Default,,0,0,0,,Сен жалғыз күресіп жүргенде
Dialogue: 0,0:19:26.56,0:19:29.26,Default,,0,0,0,,Біз де бос отырған жоқпыз.
Dialogue: 0,0:19:29.43,0:19:30.73,Default,,0,0,0,,Неліктен Америка?
Dialogue: 0,0:19:30.80,0:19:32.43,Default,,0,0,0,,Қазірдің өзінде Жапонияда
Dialogue: 0,0:19:32.50,0:19:34.33,Default,,0,0,0,,Оны жаппай өндіретін ұлттық күш жоқ.
Dialogue: 0,0:19:35.57,0:19:37.27,Default,,0,0,0,,Чихая Гунзо-кун
Dialogue: 0,0:19:37.87,0:19:39.81,Default,,0,0,0,,Мен сізден қайтадан жұмыс істеуіңізді сұраймын.
Dialogue: 0,0:19:40.47,0:19:42.71,Default,,0,0,0,,Сіз адамзаттың үмітісіз...
Dialogue: 0,0:19:43.44,0:19:45.85,Default,,0,0,0,,Менің соңғы үмітімді арқалағаныңды қалаймын.
Dialogue: 0,0:19:46.88,0:19:49.75,Default,,0,0,0,,Жаңа қару... торпедо ма?
Dialogue: 0,0:19:50.35,0:19:53.25,Default,,0,0,0,,Сіз тұман эрозиясының торпедасын талдаған сияқтысыз.
Dialogue: 0,0:19:53.32,0:19:55.49,Default,,0,0,0,,Одан әрі күшейген сияқты.
Dialogue: 0,0:19:55.82,0:19:57.62,Default,,0,0,0,,Қара жәшіктер көп болса да
Dialogue: 0,0:19:57.69,0:19:59.89,Default,,0,0,0,,Әрине, егер бұл жаппай өндірілсе
Dialogue: 0,0:19:59.96,0:20:02.66,Default,,0,0,0,,Адамзатта қарсы шабуылдың дәні болуы мүмкін.
Dialogue: 0,0:20:03.40,0:20:05.33,Default,,0,0,0,,Америка ғана қалса
Dialogue: 0,0:20:05.60,0:20:07.53,Default,,0,0,0,,Біртүрлі сөздер айтпа
Dialogue: 0,0:20:07.83,0:20:10.34,Default,,0,0,0,,Бұл мәселеге қатысты Америка Құрама Штаттарымен де құпия келісім бар.
Dialogue: 0,0:20:10.40,0:20:11.91,Default,,0,0,0,,Бұл үш ай бұрын болды.
Dialogue: 0,0:20:12.24,0:20:13.54,Default,,0,0,0,,Осыдан кейін байланыс үзілді.
Dialogue: 0,0:20:13.61,0:20:15.84,Default,,0,0,0,,Мен қазір не болып жатқанын білмеймін.
Dialogue: 0,0:20:16.28,0:20:18.65,Default,,0,0,0,,Иона Білмейтініңізге сенімдісіз бе?
Dialogue: 0,0:20:18.78,0:20:22.35,Default,,0,0,0,,Мен басқа кемелерден алынған ақпаратқа тыйым салдым.
Dialogue: 0,0:20:22.48,0:20:23.65,Default,,0,0,0,,Біз не білеміз
Dialogue: 0,0:20:23.72,0:20:25.65,Default,,0,0,0,,Тек мен қабылдаған нәрсе
Dialogue: 0,0:20:25.99,0:20:26.92,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:20:27.52,0:20:29.92,Default,,0,0,0,,Жалғыз жол - теңіз арқылы тікелей тасымалдау, солай ма?
Dialogue: 0,0:20:30.56,0:20:33.56,Default,,0,0,0,,Континентте жантүршігерлік азаматтық соғыстар тізбегі жүріп жатқаны айтылады.
Dialogue: 0,0:20:33.76,0:20:36.76,Default,,0,0,0,,Оны ішке алып жүру өте қауіпті.
Dialogue: 0,0:20:37.36,0:20:39.93,Default,,0,0,0,,Бір адамға сенуге де болмайды...
Dialogue: 0,0:20:40.50,0:20:42.87,Default,,0,0,0,,Сонымен капитан өтінішті қабылдады ма?
Dialogue: 0,0:20:43.37,0:20:44.24,Default,,0,0,0,,О
Dialogue: 0,0:20:44.37,0:20:45.37,Default,,0,0,0,,Бұл жұмыс
Dialogue: 0,0:20:45.44,0:20:47.01,Default,,0,0,0,,Табысты орындауға болатын нәрсе
Dialogue: 0,0:20:47.27,0:20:48.44,Default,,0,0,0,,Тек біз
Dialogue: 0,0:20:48.81,0:20:51.68,Default,,0,0,0,,Жаңа қару үлгілері Йокосука портында жеткізіледі
Dialogue: 0,0:20:51.91,0:20:52.91,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:20:53.31,0:20:55.25,Default,,0,0,0,,Йокосука бағытын орнатыңыз
Dialogue: 0,0:20:55.75,0:20:57.62,Default,,0,0,0,,Адамзаттың үміті
Dialogue: 0,0:20:57.68,0:20:58.92,Default,,0,0,0,,Мен барып алып кетейін.
Dialogue: 0,0:21:02.99,0:21:05.53,Default,,0,0,0,,Адамзат үміті... немесе...
Dialogue: 0,0:21:06.66,0:21:10.66,Default,,0,0,0,,I-401-нің өзін басып тастаған дұрыс емес пе?
Dialogue: 0,0:21:10.90,0:21:13.47,Default,,0,0,0,,401 еркі бар
Dialogue: 0,0:21:13.60,0:21:16.47,Default,,0,0,0,,Тек Чихая Гунзоның бұйрықтарын орындаңыз
Dialogue: 0,0:21:16.74,0:21:18.67,Default,,0,0,0,,Психикалық модель...?
Dialogue: 0,0:21:19.04,0:21:22.41,Default,,0,0,0,,Тұманның сатқыны және адамзаттың сатқыны
Dialogue: 0,0:21:23.44,0:21:25.38,Default,,0,0,0,,Бұл қызықты комбинация емес пе?
Dialogue: 0,0:21:40.99,0:21:42.76,Default,,0,0,0,,Нагара батып кетті ме?
Dialogue: 0,0:21:44.67,0:21:47.83,Default,,0,0,0,,Мен бұл денеге үйреніп қалдым.
Dialogue: 0,0:21:48.54,0:21:49.84,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:21:50.04,0:21:51.91,Default,,0,0,0,,Біз қару болсақ та
Dialogue: 0,0:21:52.04,0:21:53.51,Default,,0,0,0,,Конгоу!
Dialogue: 0,0:21:53.64,0:21:55.01,Default,,0,0,0,,Майя, не болды?
Dialogue: 0,0:21:55.54,0:21:57.44,Default,,0,0,0,,Бұл қызықсыз~
Dialogue: 0,0:21:57.58,0:21:59.81,Default,,0,0,0,,401 қозғала бастады, солай ма?
Dialogue: 0,0:21:59.98,0:22:02.35,Default,,0,0,0,,Сенің шаруаң жоқ па?
Dialogue: 0,0:22:02.98,0:22:05.92,Default,,0,0,0,,Егер сіз солтүстікке бара жатсаңыз, Такао юрисдикциясына ие.
Dialogue: 0,0:22:06.39,0:22:08.39,Default,,0,0,0,,Оны сол балаға қалдырыңыз.
Dialogue: 0,0:22:09.42,0:22:12.66,Default,,0,0,0,,А, қазірдің өзінде! Неге юрисдикциямен тоқтамайсыз?
Dialogue: 0,0:22:12.89,0:22:14.53,Default,,0,0,0,,Біз әскери кемелерміз
Dialogue: 0,0:22:14.59,0:22:17.03,Default,,0,0,0,,Адмиралтия кодексінің бұйрықтарын орындаңыз
Dialogue: 0,0:22:17.10,0:22:18.47,Default,,0,0,0,,Осымен
Dialogue: 0,0:22:18.63,0:22:19.87,Default,,0,0,0,,А, қазірдің өзінде!
Dialogue: 0,0:22:19.93,0:22:22.87,Default,,0,0,0,,Конгоудың тас басы! Бая~!
Dialogue: 0,0:22:24.00,0:22:26.07,Default,,0,0,0,,Я... бұл тітіркендіргіш.
Dialogue: 0,0:22:26.81,0:22:27.74,Default,,0,0,0,,Такао
Dialogue: 0,0:22:28.01,0:22:29.01,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:22:29.74,0:22:32.08,Default,,0,0,0,,401 осы бағытта келе ме?
Dialogue: 0,0:22:33.08,0:22:35.52,Default,,0,0,0,,Адамзатқа опасыздық жасаушы
Dialogue: 0,0:22:35.95,0:22:37.42,Default,,0,0,0,,Бұл Такао
Dialogue: 0,0:22:37.55,0:22:39.42,Default,,0,0,0,,Мен сені шаңға айналдырамын
Dialogue: 0,0:22:40.45,0:22:46.46,Default,,0,0,0,,♪～
Dialogue: 0,0:24:02.20,0:24:08.21,Default,,0,0,0,,～♪
