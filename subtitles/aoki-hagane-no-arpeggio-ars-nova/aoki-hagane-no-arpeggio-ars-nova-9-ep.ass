Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.51,0:00:18.61,Default,,0,0,0,,Біз қателерді түзетеміз
Dialogue: 0,0:00:19.31,0:00:22.35,Default,,0,0,0,,Біз бастапқы пішінімізге оралуымыз керек.
Dialogue: 0,0:00:24.45,0:00:27.42,Default,,0,0,0,,Хюуга Такао Киришима
Dialogue: 0,0:00:27.49,0:00:29.72,Default,,0,0,0,,Тіпті Харуна өзін әдеттен тыс ұстайды.
Dialogue: 0,0:00:30.09,0:00:31.39,Default,,0,0,0,,Мұның бәрі
Dialogue: 0,0:00:31.46,0:00:34.56,Default,,0,0,0,,Бұл адаммен байланыс фактор болып саналады.
Dialogue: 0,0:00:35.56,0:00:38.37,Default,,0,0,0,,Содан кейін Гунзо Чихаяны жойыңыз
Dialogue: 0,0:00:41.37,0:00:44.07,Default,,0,0,0,,Конгу мен тұманмен бірге жүретін дүние
Dialogue: 0,0:00:44.27,0:00:45.71,Default,,0,0,0,,Мүмкіндік
Dialogue: 0,0:00:45.77,0:00:47.58,Default,,0,0,0,,Бұл шынымен нөл ме?
Dialogue: 0,0:00:47.64,0:00:49.31,Default,,0,0,0,,Психикалық модельдер де
Dialogue: 0,0:00:49.38,0:00:50.38,Default,,0,0,0,,Бірін-бірі түсінетін адаммен
Dialogue: 0,0:00:50.45,0:00:52.78,Default,,0,0,0,,Менің ойымша, жоқ адамдар бар.
Dialogue: 0,0:00:53.28,0:00:55.08,Default,,0,0,0,,Адамдар сияқты
Dialogue: 0,0:00:55.15,0:00:57.42,Default,,0,0,0,,Бірақ көбірек сөйлесе алатын болсақ
Dialogue: 0,0:00:57.49,0:00:58.35,Default,,0,0,0,,Қазірге дейінгі тәжірибелердің нәтижелеріне сүйене отырып,
Dialogue: 0,0:00:58.42,0:00:59.79,Default,,0,0,0,,Гунзо Чихая!
Dialogue: 0,0:01:00.19,0:01:02.59,Default,,0,0,0,,Иона апаны алып, тез қашып кет!
Dialogue: 0,0:01:03.06,0:01:05.23,Default,,0,0,0,,Кешір, мен саған тапсырдым, Хюуга!
Dialogue: 0,0:01:05.29,0:01:07.10,Default,,0,0,0,,Сізге емес
Dialogue: 0,0:01:07.16,0:01:08.40,Default,,0,0,0,,Бұл Иона апаға арналған.
Dialogue: 0,0:01:08.66,0:01:10.60,Default,,0,0,0,,Рахмет саған Хюуга
Dialogue: 0,0:01:10.70,0:01:12.37,Default,,0,0,0,,Ах! Иона апа!
Dialogue: 0,0:01:12.43,0:01:13.33,Default,,0,0,0,,Сол сүйкімді көздерімен
Dialogue: 0,0:01:13.40,0:01:14.60,Default,,0,0,0,,Өтінемін, қарап қалмаңыз!
Dialogue: 0,0:01:15.07,0:01:16.47,Default,,0,0,0,,Осындай сүйкімді көздерімен!
Dialogue: 0,0:01:16.64,0:01:17.67,Default,,0,0,0,,Мен сені бірден қуамын.
Dialogue: 0,0:01:17.74,0:01:19.54,Default,,0,0,0,,Сенімді болыңыз!
Dialogue: 0,0:01:19.61,0:01:22.08,Default,,0,0,0,,Қараңдар! Сендер де тез кетіңдер.
Dialogue: 0,0:01:22.21,0:01:23.81,Default,,0,0,0,,Мен бұл жерде менімен жақсымын.
Dialogue: 0,0:01:24.25,0:01:25.65,Default,,0,0,0,,Жоқ... бұл қауіпті!
Dialogue: 0,0:01:25.71,0:01:28.78,Default,,0,0,0,,Ақымақ, мені кім деп ойлайсың?
Dialogue: 0,0:01:28.85,0:01:30.52,Default,,0,0,0,,Жүр, асығыңыз!
Dialogue: 0,0:01:30.79,0:01:31.69,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:01:40.73,0:01:43.40,Default,,0,0,0,,Мүлдем... Киришиматара
Dialogue: 0,0:01:43.73,0:01:45.17,Default,,0,0,0,,Конго
Dialogue: 0,0:01:45.23,0:01:46.33,Default,,0,0,0,,Сіз де
Dialogue: 0,0:01:46.40,0:01:50.41,Default,,0,0,0,,Сіз мені қазіргі келбетіме қарап ғана бағалап отырған жоқсыз, солай ма?
Dialogue: 0,0:01:52.61,0:01:55.41,Default,,0,0,0,,Жауынгерлік кеме класындағы есептеу қуаты
Dialogue: 0,0:01:55.48,0:01:57.51,Default,,0,0,0,,Сіз оны қолданып көруіңіз керек.
Dialogue: 0,0:02:13.66,0:02:17.43,Default,,0,0,0,,Ағымдағы уақытта жағдайды жою операциясына көшу
Dialogue: 0,0:02:17.63,0:02:19.80,Default,,0,0,0,,Біз Конго флотын бұзып өттік.
Dialogue: 0,0:02:19.87,0:02:21.47,Default,,0,0,0,,Америкаға бару
Dialogue: 0,0:02:21.54,0:02:23.67,Default,,0,0,0,,Иво Джима жоспарланғандай жойылады.
Dialogue: 0,0:02:23.74,0:02:24.61,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:02:24.87,0:02:28.48,Default,,0,0,0,,Бірақ аралдың бүкіл аумағы қоршалған болуы керек.
Dialogue: 0,0:02:28.54,0:02:29.81,Default,,0,0,0,,Майя да келе жатыр
Dialogue: 0,0:02:29.88,0:02:32.55,Default,,0,0,0,,Сонымен... жақсысың ба? Хару Хару
Dialogue: 0,0:02:32.61,0:02:35.75,Default,,0,0,0,,Уайымдама, мен Макиді қорғаймын.
Dialogue: 0,0:02:36.15,0:02:38.39,Default,,0,0,0,,Хюуга жол жасайды
Dialogue: 0,0:02:38.45,0:02:39.32,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:02:39.42,0:02:40.56,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:02:40.62,0:02:43.89,Default,,0,0,0,,Енді мен Иона апаның махаббатын сезініп тұрмын!
Dialogue: 0,0:02:44.16,0:02:47.43,Default,,0,0,0,,Бәрін мына Хьюгаға қалдыр!
Dialogue: 0,0:02:48.90,0:02:50.70,Default,,0,0,0,,Такао, кемеңмен не істеу керек?
Dialogue: 0,0:02:50.77,0:02:51.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:52.83,0:02:54.17,Default,,0,0,0,,Ал...
Dialogue: 0,0:02:56.67,0:02:57.54,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:57.61,0:03:00.74,Default,,0,0,0,,Мен бәріңе бір жатақхана, бір тамағын қарыздармын.
Dialogue: 0,0:03:02.71,0:03:04.51,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:03:04.58,0:03:06.38,Default,,0,0,0,,Мен саған көмектесемін.
Dialogue: 0,0:03:06.88,0:03:07.78,Default,,0,0,0,,«Барлығын мен үшін» мұрагері…
Dialogue: 0,0:03:08.58,0:03:11.29,Default,,0,0,0,,Мен қашан кететінімді шешемін.
Dialogue: 0,0:03:11.89,0:03:13.32,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:03:14.49,0:03:16.79,Default,,0,0,0,,«Көк болатқа» қош келдіңіз
Dialogue: 0,0:03:25.23,0:03:26.60,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:30.44,0:03:32.37,Default,,0,0,0,,Ах... (Гунзо) Бірден, Такао.
Dialogue: 0,0:03:32.44,0:03:33.98,Default,,0,0,0,,Ех! не?
Dialogue: 0,0:03:34.24,0:03:35.68,Default,,0,0,0,,Менің бір өтінішім бар.
Dialogue: 0,0:03:35.74,0:03:36.88,Default,,0,0,0,,Өтінемін?
Dialogue: 0,0:03:36.95,0:03:38.85,Default,,0,0,0,,Бұл бұйрық емес пе...?
Dialogue: 0,0:03:39.35,0:03:41.55,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:03:41.65,0:03:43.35,Default,,0,0,0,,Мен сізден мұны ғана сұрай аламын.
Dialogue: 0,0:03:43.62,0:03:44.62,Default,,0,0,0,,Ха...
Dialogue: 0,0:03:46.75,0:03:49.52,Default,,0,0,0,,Жақсы, мен тыңдаймын.
Dialogue: 0,0:03:53.70,0:03:55.53,Default,,0,0,0,,Осындай уақытта шай
Dialogue: 0,0:03:55.60,0:03:57.53,Default,,0,0,0,,Өте талғампаз.
Dialogue: 0,0:03:57.60,0:03:58.93,Default,,0,0,0,,Адамзаттан не үйрендік
Dialogue: 0,0:03:59.00,0:04:02.27,Default,,0,0,0,,Сонымен, өзіңіздің еркіндігіңізді көрсету әдістемесі?
Dialogue: 0,0:04:03.50,0:04:05.61,Default,,0,0,0,,Мен бос сөз айтайын дегенім жоқ.
Dialogue: 0,0:04:06.27,0:04:07.81,Default,,0,0,0,,401-ден құтылыңыз
Dialogue: 0,0:04:08.68,0:04:11.45,Default,,0,0,0,,Бір-бірімізбен ұрысуымыз уақытты босқа кетірер еді.
Dialogue: 0,0:04:11.51,0:04:13.85,Default,,0,0,0,,Бір ғана үлгі сөзбен
Dialogue: 0,0:04:13.92,0:04:16.92,Default,,0,0,0,,Менің айтқанымнан қайтуға амалым жоқ.
Dialogue: 0,0:04:17.25,0:04:19.32,Default,,0,0,0,,Міне, мен үздік оқушымын!
Dialogue: 0,0:04:19.92,0:04:23.29,Default,,0,0,0,,Неліктен 401-ге жазыласыз?
Dialogue: 0,0:04:23.36,0:04:25.63,Default,,0,0,0,,Сол жауынгерлік кемелер класының қабілеті
Dialogue: 0,0:04:25.69,0:04:28.46,Default,,0,0,0,,Оны тиімді пайдаланғыңыз келмей ме?
Dialogue: 0,0:04:28.63,0:04:31.53,Default,,0,0,0,,Менің де бос сөз айтайын дегенім жоқ.
Dialogue: 0,0:04:32.27,0:04:34.74,Default,,0,0,0,,Мен Иона апаны жақсы көремін, сондықтан оны қорғаймын.
Dialogue: 0,0:04:34.80,0:04:36.00,Default,,0,0,0,,Логика
Dialogue: 0,0:04:36.27,0:04:39.47,Default,,0,0,0,,Кез келген мінез-құлық стандартын жоққа шығарады
Dialogue: 0,0:04:39.54,0:04:42.98,Default,,0,0,0,,Концептуалды ойлау мінез-құлық принципіне айналуы мүмкін, т.б.
Dialogue: 0,0:04:43.28,0:04:44.85,Default,,0,0,0,,Бұл түсініксіз.
Dialogue: 0,0:04:44.91,0:04:48.65,Default,,0,0,0,,Бұл түсініксіз емес, ол ойлауды тоқтатады.
Dialogue: 0,0:04:48.72,0:04:52.72,Default,,0,0,0,,Сен тым қыңырсың деп бәрі сені тастап кетеді.
Dialogue: 0,0:04:52.79,0:04:54.42,Default,,0,0,0,,Атау денені білдіреді ме?
Dialogue: 0,0:04:54.52,0:04:56.69,Default,,0,0,0,,Бұл жақсы нәрсе, Конгоу.
Dialogue: 0,0:04:56.82,0:04:57.73,Default,,0,0,0,,Хо
Dialogue: 0,0:04:58.43,0:05:01.30,Default,,0,0,0,,Сіз мұны арандатушылық деп атайсыз ба?
Dialogue: 0,0:05:01.60,0:05:04.67,Default,,0,0,0,,Айнаға бір рет қарауды ұсынамын.
Dialogue: 0,0:05:04.73,0:05:08.47,Default,,0,0,0,,Қазір қандай сұмдық жүзіңіз бар?
Dialogue: 0,0:05:08.54,0:05:11.91,Default,,0,0,0,,Ол жағада ойнап жүргенде біраз көңілді болған сияқты.
Dialogue: 0,0:05:13.01,0:05:14.78,Default,,0,0,0,,ләззат алу және т.б.
Dialogue: 0,0:05:14.84,0:05:18.55,Default,,0,0,0,,Біз тұман үшін ең қажет емес айнымалымыз.
Dialogue: 0,0:05:18.61,0:05:21.78,Default,,0,0,0,,Дұрыс алынған нәтижелер - бәрі.
Dialogue: 0,0:05:21.85,0:05:23.32,Default,,0,0,0,,Процесс маңызды емес
Dialogue: 0,0:05:25.02,0:05:28.96,Default,,0,0,0,,Мен сенің арифметикалық қабілетіңді де бағаладым.
Dialogue: 0,0:05:29.02,0:05:30.33,Default,,0,0,0,,Хюуга
Dialogue: 0,0:05:30.63,0:05:33.66,Default,,0,0,0,,Ауыр гравитациялық зеңбірекпен қорқыту әрекеті
Dialogue: 0,0:05:33.73,0:05:37.43,Default,,0,0,0,,Өйткені, бұл сізде бар жалғыз карта.
Dialogue: 0,0:05:37.70,0:05:40.07,Default,,0,0,0,,Менің ойымша, бұл қару ретінде дұрыс.
Dialogue: 0,0:05:40.57,0:05:41.44,Default,,0,0,0,,Дұрыс…
Dialogue: 0,0:05:41.97,0:05:43.94,Default,,0,0,0,,Иә, дұрыс айтамын.
Dialogue: 0,0:05:44.01,0:05:46.77,Default,,0,0,0,,Тек Адмиралти кодексін орындаңыз.
Dialogue: 0,0:05:46.84,0:05:47.98,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:05:48.04,0:05:51.78,Default,,0,0,0,,Сонда бұл сіздің сезімдеріңізге негізделген емес пе?
Dialogue: 0,0:05:52.71,0:05:54.35,Default,,0,0,0,,Мазасыздық
Dialogue: 0,0:05:54.45,0:05:55.82,Default,,0,0,0,,Жоғалып кету
Dialogue: 0,0:06:01.49,0:06:02.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:02.52,0:06:03.76,Default,,0,0,0,,Ммм!
Dialogue: 0,0:06:03.86,0:06:05.76,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:06:12.80,0:06:14.04,Default,,0,0,0,,Егер Урарака Качанға тиіп қалса—
Dialogue: 0,0:06:14.47,0:06:16.14,Default,,0,0,0,,Керемет әскери кеме класы!
Dialogue: 0,0:06:16.50,0:06:19.01,Default,,0,0,0,,Иона апаға махаббат!
Dialogue: 0,0:06:19.61,0:06:23.11,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:06:25.61,0:06:27.48,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:06:27.58,0:06:28.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:28.68,0:06:29.82,Default,,0,0,0,,Хюуга!
Dialogue: 0,0:06:31.45,0:06:32.72,Default,,0,0,0,,Жарайды
Dialogue: 0,0:06:32.85,0:06:35.49,Default,,0,0,0,,Бұл нағыз махаббаттың жеңісі!
Dialogue: 0,0:06:36.12,0:06:38.86,Default,,0,0,0,,Мен әлі жеңген жоқпын, жеңілген жоқпын.
Dialogue: 0,0:06:39.53,0:06:41.16,Default,,0,0,0,,Бірақ қажырлы еңбегіңіз үшін рахмет.
Dialogue: 0,0:06:41.43,0:06:43.53,Default,,0,0,0,,Ахх! Неткен бос сөз!
Dialogue: 0,0:06:43.60,0:06:45.87,Default,,0,0,0,,Хюуга! Хюуга - бақытты адам!
Dialogue: 0,0:06:46.10,0:06:48.64,Default,,0,0,0,,Бірақ асығыңыз, Иона апа.
Dialogue: 0,0:06:48.70,0:06:50.81,Default,,0,0,0,,Мен ауырлық күшінің зеңбірегін атуға рұқсат етсем де.
Dialogue: 0,0:06:50.91,0:06:53.98,Default,,0,0,0,,Конгоу кемесі ішінде азғындау жылдамдығы тез артып келеді.
Dialogue: 0,0:06:54.18,0:06:56.81,Default,,0,0,0,,93% сыни нүктеге дейін
Dialogue: 0,0:06:56.88,0:06:58.08,Default,,0,0,0,,Басқа кеме туралы не деуге болады?
Dialogue: 0,0:06:58.91,0:07:01.45,Default,,0,0,0,,Хюуганың реакциясы жойылған жоқ
Dialogue: 0,0:07:01.52,0:07:02.18,Default,,0,0,0,,Майя!
Dialogue: 0,0:07:02.45,0:07:03.48,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:07:03.75,0:07:04.99,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:07:05.05,0:07:07.49,Default,,0,0,0,,Масштабтау!
Dialogue: 0,0:07:10.12,0:07:10.99,Default,,0,0,0,,Тс!
Dialogue: 0,0:07:12.16,0:07:13.69,Default,,0,0,0,,Өте ауырлық зеңбірегі
Dialogue: 0,0:07:13.96,0:07:15.76,Default,,0,0,0,,Іске қосу~!
Dialogue: 0,0:07:19.53,0:07:20.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:46.23,0:07:49.63,Default,,0,0,0,,Енді мен ол кісінің кемесімін!
Dialogue: 0,0:07:50.60,0:07:52.13,Default,,0,0,0,,Көк болат!
Dialogue: 0,0:07:52.90,0:07:55.50,Default,,0,0,0,,Біз бір типтегі кемелерден ұтыла алмаймыз!
Dialogue: 0,0:07:55.84,0:07:59.11,Default,,0,0,0,,Такаоның ақымақ! Батып кетпеңіз!
Dialogue: 0,0:07:59.67,0:08:01.91,Default,,0,0,0,,Махаббат ешқашан батпайды!
Dialogue: 0,0:08:08.85,0:08:09.72,Default,,0,0,0,,Ей!
Dialogue: 0,0:08:09.92,0:08:11.72,Default,,0,0,0,,Қазір бос емессіз бе?
Dialogue: 0,0:08:11.79,0:08:14.82,Default,,0,0,0,,Біздің ұрыс қимылдарымызға кедергі келтіре ме?
Dialogue: 0,0:08:14.89,0:08:17.23,Default,,0,0,0,,Қандай себеп? Такао
Dialogue: 0,0:08:17.49,0:08:18.53,Default,,0,0,0,,Бөлек
Dialogue: 0,0:08:18.59,0:08:20.93,Default,,0,0,0,,Мен тек өзіме ұнайтын нәрсені істеп жатырмын
Dialogue: 0,0:08:21.23,0:08:23.66,Default,,0,0,0,,Хюуга жақсы, саған жақсы
Dialogue: 0,0:08:23.73,0:08:25.73,Default,,0,0,0,,Сіз тұман екенін ұмыттыңыз ба?
Dialogue: 0,0:08:26.20,0:08:28.74,Default,,0,0,0,,Адам тілінде жақсы сөздер бар.
Dialogue: 0,0:08:29.54,0:08:30.67,Default,,0,0,0,,«Болды»
Dialogue: 0,0:08:31.04,0:08:32.67,Default,,0,0,0,,«Бұл осы»
Dialogue: 0,0:08:34.61,0:08:37.55,Default,,0,0,0,,Адамзатпен қарым-қатынасқа түсу арқылы сіз
Dialogue: 0,0:08:37.61,0:08:39.78,Default,,0,0,0,,Мен өзімді көрмей қалдым
Dialogue: 0,0:08:40.68,0:08:43.18,Default,,0,0,0,,Мен оны дұрыстауым керек
Dialogue: 0,0:08:43.62,0:08:46.29,Default,,0,0,0,,Бұл не? Өзіңіз шешім қабылдамаңыз!
Dialogue: 0,0:08:46.85,0:08:50.09,Default,,0,0,0,,Мен өзімді жақсы білемін
Dialogue: 0,0:08:50.56,0:08:53.59,Default,,0,0,0,,Махаббатты біліп ояндым
Dialogue: 0,0:08:54.20,0:08:57.70,Default,,0,0,0,,Міне, адамдар да, мен де дамимыз.
Dialogue: 0,0:08:58.53,0:09:01.04,Default,,0,0,0,,Иона Корпус пен қозғалтқыштың жағдайы қандай?
Dialogue: 0,0:09:01.54,0:09:02.57,Default,,0,0,0,,Жарайды… Маған 18-демін, сенімен бір жастамын.
Dialogue: 0,0:09:02.64,0:09:04.97,Default,,0,0,0,,Хюуга оны тамаша жөндеп берді.
Dialogue: 0,0:09:05.04,0:09:07.24,Default,,0,0,0,,Жарайды, екі жақта да баяу жылдамдық.
Dialogue: 0,0:09:07.54,0:09:09.04,Default,,0,0,0,,401 Іске қосу!
Dialogue: 0,0:09:21.19,0:09:23.02,Default,,0,0,0,,Руру Руру Руру~♪
Dialogue: 0,0:09:24.89,0:09:26.66,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,0:09:27.09,0:09:28.23,Default,,0,0,0,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:09:28.60,0:09:30.90,Default,,0,0,0,,Бұл карнавал!
Dialogue: 0,0:09:31.27,0:09:33.83,Default,,0,0,0,,Шулы! Фестиваль әйелі!
Dialogue: 0,0:09:37.34,0:09:38.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:38.27,0:09:40.84,Default,,0,0,0,,Ақыр соңында, біз оны әдеттен тыс деп бағалаудан басқа амалымыз жоқ.
Dialogue: 0,0:09:40.91,0:09:43.88,Default,,0,0,0,,Адмиралтистік кодекстен ауытқыған эволюция және т.б.
Dialogue: 0,0:09:43.95,0:09:45.05,Default,,0,0,0,,Бұл қажет емес.
Dialogue: 0,0:09:45.35,0:09:47.88,Default,,0,0,0,,Мұны абсолютті деп айта аласыз ба?
Dialogue: 0,0:09:48.25,0:09:53.92,Default,,0,0,0,,Соғыс жағдайы мен ақпаратты талдап, қорытынды жасадым.
Dialogue: 0,0:09:54.06,0:09:56.96,Default,,0,0,0,,Эмоциялар сияқты белгісіз элементтердің қажеті жоқ.
Dialogue: 0,0:09:57.26,0:09:58.59,Default,,0,0,0,,Міне
Dialogue: 0,0:09:58.66,0:10:01.60,Default,,0,0,0,,Конго өзін ғана дұрыс деп есептейтін шығар.
Dialogue: 0,0:10:01.66,0:10:04.77,Default,,0,0,0,,Қару болу үшін қару қандай болуы керек?
Dialogue: 0,0:10:05.30,0:10:08.64,Default,,0,0,0,,Бұл енді маған маңызды емес.
Dialogue: 0,0:10:09.07,0:10:11.71,Default,,0,0,0,,Бұл тұманның сөзі ме?
Dialogue: 0,0:10:11.77,0:10:13.98,Default,,0,0,0,,Чихая Гунзомен байланыс
Dialogue: 0,0:10:14.04,0:10:16.28,Default,,0,0,0,,Бұл сізді соншалықты өзгертті ме?
Dialogue: 0,0:10:16.78,0:10:19.61,Default,,0,0,0,,Өзіңе ұнайтын адамдар үшін қалағандай өмір сүр
Dialogue: 0,0:10:19.68,0:10:22.22,Default,,0,0,0,,Қарапайым нәрсені қалай түсінбейсің?
Dialogue: 0,0:10:22.28,0:10:24.35,Default,,0,0,0,,Біз адам емеспіз
Dialogue: 0,0:10:24.62,0:10:27.32,Default,,0,0,0,,Оның өзі триггерсіз қару болуы керек.
Dialogue: 0,0:10:27.39,0:10:29.36,Default,,0,0,0,,Сондықтан мен «керек» деймін.
Dialogue: 0,0:10:29.62,0:10:31.09,Default,,0,0,0,,Бұл өте шулы!
Dialogue: 0,0:10:31.16,0:10:32.03,Default,,0,0,0,,О!
Dialogue: 0,0:10:32.36,0:10:34.80,Default,,0,0,0,,Қанша алыс жүрсең де, параллель түзулер бар.
Dialogue: 0,0:10:35.26,0:10:36.80,Default,,0,0,0,,Сондай күндердің бірінде сен де.
Dialogue: 0,0:10:36.86,0:10:39.40,Default,,0,0,0,,Сіз бұл сезімді түсінесіз деп үміттенемін.
Dialogue: 0,0:10:39.77,0:10:42.20,Default,,0,0,0,,Дүниенің түсі басқаша көрінеді.
Dialogue: 0,0:10:44.87,0:10:47.71,Default,,0,0,0,,Барлығы бұзылып жатыр.
Dialogue: 0,0:10:47.84,0:10:48.71,Default,,0,0,0,,Майя
Dialogue: 0,0:10:49.04,0:10:50.91,Default,,0,0,0,,Иә, иә! Сіз қоңырау шалдыңыз ба?
Dialogue: 0,0:10:51.35,0:10:54.75,Default,,0,0,0,,Такао да, Хюуга да - бұл анық ауытқулар.
Dialogue: 0,0:10:54.82,0:10:56.68,Default,,0,0,0,,Оны жай қалдырыңыз.
Dialogue: 0,0:10:56.92,0:11:01.69,Default,,0,0,0,,Мұның орнына барлығына кінәлі 401 және Чихая Гунзо.
Dialogue: 0,0:11:01.76,0:11:03.82,Default,,0,0,0,,Конгоу Сіз шаршаған сияқтысыз.
Dialogue: 0,0:11:03.89,0:11:06.26,Default,,0,0,0,,Барлығы, менің айтқаныма құлақ аспау қиын.
Dialogue: 0,0:11:06.33,0:11:08.83,Default,,0,0,0,,Сіз ше? мая
Dialogue: 0,0:11:09.03,0:11:10.00,Default,,0,0,0,,Мен?
Dialogue: 0,0:11:10.06,0:11:14.24,Default,,0,0,0,,Мен жай ғана Адмиралти кодексін және Конго~ды ұстанамын!
Dialogue: 0,0:11:15.74,0:11:18.37,Default,,0,0,0,,Иә, солай
Dialogue: 0,0:11:18.97,0:11:21.08,Default,,0,0,0,,Бұл тұманның дұрыс түрі.
Dialogue: 0,0:11:21.68,0:11:25.71,Default,,0,0,0,,Бүкіл флот Қарсыластың іздеу ауқымын кеңейту 401-ді табыңыз!
Dialogue: 0,0:11:26.28,0:11:28.72,Default,,0,0,0,,Хюуга тудырған кептеліс шуы қорқынышты.
Dialogue: 0,0:11:29.02,0:11:31.02,Default,,0,0,0,,Нагараны дұрыс таратыңыз.
Dialogue: 0,0:11:32.19,0:11:34.46,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:11:45.20,0:11:46.43,Default,,0,0,0,,Аа...
Dialogue: 0,0:11:46.83,0:11:48.87,Default,,0,0,0,,Әзірге жоспар бойынша
Dialogue: 0,0:11:48.94,0:11:51.11,Default,,0,0,0,,Қалғаны өзіңізге байланысты.
Dialogue: 0,0:11:51.17,0:11:54.21,Default,,0,0,0,,401 Чихая Гунзо
Dialogue: 0,0:11:56.31,0:11:59.18,Default,,0,0,0,,Iona Жоспарланған бағытты растауды сұрау
Dialogue: 0,0:11:59.85,0:12:02.82,Default,,0,0,0,,Маршрут пен координаттар Хюуга көрсеткендей.
Dialogue: 0,0:12:02.88,0:12:05.15,Default,,0,0,0,,Толқынға мініп, қауіпті аймақтан шығу
Dialogue: 0,0:12:05.22,0:12:08.06,Default,,0,0,0,,Такаоның кездесу нүктесін мақсат етіңіз
Dialogue: 0,0:12:08.72,0:12:10.93,Default,,0,0,0,,Бұл иненің жіптерін тігумен бірдей
Dialogue: 0,0:12:10.99,0:12:11.93,Default,,0,0,0,,Шыдайсың ба?
Dialogue: 0,0:12:11.99,0:12:13.86,Default,,0,0,0,,Жарайды, маған сеніңіз
Dialogue: 0,0:12:14.43,0:12:16.83,Default,,0,0,0,,Қайда? 401
Dialogue: 0,0:12:16.90,0:12:19.17,Default,,0,0,0,,Мен бұлай қашып құтыла алмаймын деп ойлаймын.
Dialogue: 0,0:12:20.23,0:12:23.37,Default,,0,0,0,,Такао бізге қашу үшін уақыт сатып алды.
Dialogue: 0,0:12:23.87,0:12:24.84,Default,,0,0,0,,Қалғандары
Dialogue: 0,0:12:24.91,0:12:27.91,Default,,0,0,0,,Конгу мен басқалары мұны елемейді деп үміттенемін.
Dialogue: 0,0:12:27.98,0:12:29.81,Default,,0,0,0,,Бұл мүмкін емес кеңес.
Dialogue: 0,0:12:29.88,0:12:31.28,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:12:31.48,0:12:34.42,Default,,0,0,0,,Толық жарылыс режимінде бірден кетуге әрекеттеніңіз
Dialogue: 0,0:12:34.78,0:12:35.85,Default,,0,0,0,,Оны дайындаңыз.
Dialogue: 0,0:12:35.92,0:12:36.78,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:12:37.49,0:12:39.99,Default,,0,0,0,,410 секундта толық жарылыстың критикалық деңгейі
Dialogue: 0,0:12:41.09,0:12:42.52,Default,,0,0,0,,Түсірілді
Dialogue: 0,0:12:54.27,0:12:55.30,Default,,0,0,0,,Конгоу келді
Dialogue: 0,0:12:56.04,0:12:58.27,Default,,0,0,0,,Модельдеуден 18 секунд жылдамырақ
Dialogue: 0,0:12:58.34,0:12:59.77,Default,,0,0,0,,Конгоу күткендей
Dialogue: 0,0:13:00.07,0:13:02.91,Default,,0,0,0,,Такао оны тоқтатуға барса, қауіпсіз бе?
Dialogue: 0,0:13:02.98,0:13:04.21,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:04.28,0:13:07.11,Default,,0,0,0,,Жолда Конгу біздің ниетімізді байқады.
Dialogue: 0,0:13:07.18,0:13:08.35,Default,,0,0,0,,Менің ойымша, бұл керісінше болды.
Dialogue: 0,0:13:08.42,0:13:09.28,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:09.85,0:13:11.29,Default,,0,0,0,,Сүңгу тереңдігі
Dialogue: 0,0:13:11.35,0:13:13.49,Default,,0,0,0,,№ 5 № 6 Түтікке су айдау
Dialogue: 0,0:13:13.55,0:13:15.22,Default,,0,0,0,,Белсенді жалған ату!
Dialogue: 0,0:13:15.29,0:13:16.86,Default,,0,0,0,,Decoy ұшыру
Dialogue: 0,0:13:23.40,0:13:25.27,Default,,0,0,0,,Конгоудың қазіргі орны қандай?
Dialogue: 0,0:13:25.57,0:13:27.07,Default,,0,0,0,,6 сағат бағыты
Dialogue: 0,0:13:27.13,0:13:31.14,Default,,0,0,0,,Қашықтық 9600 Сағатына 50 түйінмен жақындау
Dialogue: 0,0:13:31.54,0:13:33.21,Default,,0,0,0,,Бұл өте жылдам.
Dialogue: 0,0:13:33.27,0:13:34.14,Default,,0,0,0,,Хаа… Хаа… Хаа…
Dialogue: 0,0:13:34.21,0:13:36.48,Default,,0,0,0,,Толық жарылыс алдында жетті
Dialogue: 0,0:13:42.32,0:13:44.32,Default,,0,0,0,,Танатоний реакциясы 20
Dialogue: 0,0:13:44.52,0:13:47.25,Default,,0,0,0,,5 секундтан кейін алаяқ соңына түседі.
Dialogue: 0,0:13:47.42,0:13:49.56,Default,,0,0,0,,Әсерге дайындық кезіндегі Клейн өрісін орналастыру
Dialogue: 0,0:13:57.10,0:13:58.00,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:58.07,0:14:01.37,Default,,0,0,0,,331 секунд толық сынилық күйге дейін
Dialogue: 0,0:14:01.54,0:14:04.14,Default,,0,0,0,,Қысқарту үшін есепті сол бағытқа ауыстырсақ
Dialogue: 0,0:14:04.21,0:14:05.91,Default,,0,0,0,,Қорғаныс ресурстары таусылды
Dialogue: 0,0:14:05.97,0:14:08.08,Default,,0,0,0,,Түсіндім, маршрут сол қалпында.
Dialogue: 0,0:14:08.41,0:14:11.58,Default,,0,0,0,,Конгоу жақын арада жұмыс аймағына кіруі керек.
Dialogue: 0,0:14:13.58,0:14:14.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:21.96,0:14:23.12,Default,,0,0,0,,Хюуга ерекше
Dialogue: 0,0:14:23.19,0:14:26.09,Default,,0,0,0,,Бұл эрозияға ұшыраған торпедаларға негізделген жасырын мина.
Dialogue: 0,0:14:26.39,0:14:28.90,Default,,0,0,0,,Бұл сізге біраз уақыт алуы мүмкін.
Dialogue: 0,0:14:29.23,0:14:30.93,Default,,0,0,0,,Хюуганың тұзағы
Dialogue: 0,0:14:31.00,0:14:32.50,Default,,0,0,0,,Жан түршігерлік еліктеу
Dialogue: 0,0:14:33.27,0:14:36.10,Default,,0,0,0,,Аймақтан кететін уақыт таяп қалды, бірақ абай болыңыз.
Dialogue: 0,0:14:36.40,0:14:39.91,Default,,0,0,0,,Жолдан тайсаң, минаның құрбаны боласың.
Dialogue: 0,0:14:40.41,0:14:42.04,Default,,0,0,0,,Ах... (Гунзо) Не ​​болды?
Dialogue: 0,0:14:42.11,0:14:43.14,Default,,0,0,0,,Күлкілі
Dialogue: 0,0:14:43.21,0:14:45.11,Default,,0,0,0,,Конгоу қашықтықты жабуда
Dialogue: 0,0:14:48.58,0:14:50.99,Default,,0,0,0,,«Сарбаздар құдайдың жылдамдығын құрметтейді»
Dialogue: 0,0:14:51.15,0:14:53.52,Default,,0,0,0,,Адамзат кітабынан алынған сөз болды ма?
Dialogue: 0,0:14:54.02,0:14:57.19,Default,,0,0,0,,Иә, біз қарумыз.
Dialogue: 0,0:14:57.26,0:14:59.53,Default,,0,0,0,,Ештеңе артық, кем емес.
Dialogue: 0,0:15:00.63,0:15:03.13,Default,,0,0,0,,Миналар мені ұстап тұрған жоқ
Dialogue: 0,0:15:07.33,0:15:08.44,Default,,0,0,0,,Конго
Dialogue: 0,0:15:09.00,0:15:11.34,Default,,0,0,0,,Соншалықты бейқамдық ауыртпай ма?
Dialogue: 0,0:15:11.47,0:15:15.18,Default,,0,0,0,,Ауырсыну бізге қажет емес ұғым.
Dialogue: 0,0:15:15.34,0:15:17.38,Default,,0,0,0,,Бұйрықтарды орындау
Dialogue: 0,0:15:17.44,0:15:19.58,Default,,0,0,0,,Кез келген сыйақыны төлеңіз
Dialogue: 0,0:15:20.25,0:15:23.02,Default,,0,0,0,,Мұның мәні неде? 401
Dialogue: 0,0:15:23.38,0:15:26.09,Default,,0,0,0,,Ақырында өкінгіңіз келді ме?
Dialogue: 0,0:15:26.52,0:15:29.36,Default,,0,0,0,,Себебі мен сенімен көбірек сөйлескім келді.
Dialogue: 0,0:15:29.42,0:15:33.36,Default,,0,0,0,,Мен сені суға батырамын және Гунзо Чихаяны өлтіремін.
Dialogue: 0,0:15:33.43,0:15:36.50,Default,,0,0,0,,Біз тұманның болуын қалыпқа келтіруіміз керек.
Dialogue: 0,0:15:37.40,0:15:38.50,Default,,0,0,0,,Осымен
Dialogue: 0,0:15:41.20,0:15:43.04,Default,,0,0,0,,Танатоний реакциясы 12
Dialogue: 0,0:15:43.10,0:15:44.20,Default,,0,0,0,,Пассивті жалғанды ​​іске қосу!
Dialogue: 0,0:15:57.25,0:15:59.52,Default,,0,0,0,,А... неге?
Dialogue: 0,0:15:59.59,0:16:02.69,Default,,0,0,0,,Адамдардың да, біздің де мүмкіндіктеріміз әртүрлі...
Dialogue: 0,0:16:02.96,0:16:04.63,Default,,0,0,0,,Түсіну үшін неше рет айтуым керек?
Dialogue: 0,0:16:04.69,0:16:05.56,Default,,0,0,0,,Біз
Dialogue: 0,0:16:05.63,0:16:08.63,Default,,0,0,0,,Бұл адмиралтейлік кодекске сәйкес келетін қару.
Dialogue: 0,0:16:08.70,0:16:10.60,Default,,0,0,0,,Бұл шынымен сізге керек пе?
Dialogue: 0,0:16:11.23,0:16:14.10,Default,,0,0,0,,Мен Гунзомен жүзіп келе жатқанда
Dialogue: 0,0:16:14.17,0:16:17.34,Default,,0,0,0,,Мен өз болмысымды білдім.
Dialogue: 0,0:16:17.40,0:16:19.44,Default,,0,0,0,,Қуыршақтай болдың
Dialogue: 0,0:16:19.51,0:16:22.24,Default,,0,0,0,,Ол көп сөйлей бастады.
Dialogue: 0,0:16:22.48,0:16:26.11,Default,,0,0,0,,Мұның қалыпты емес екенін неге түсінбейсіз?
Dialogue: 0,0:16:26.18,0:16:28.68,Default,,0,0,0,,Сіз сынғансыз.
Dialogue: 0,0:16:28.75,0:16:30.65,Default,,0,0,0,,Мен өзімді сындырғандай сезінемін ...
Dialogue: 0,0:16:32.45,0:16:35.76,Default,,0,0,0,,Ең алдымен сол адамды жою керек.
Dialogue: 0,0:16:38.59,0:16:40.06,Default,,0,0,0,,Тоқта
Dialogue: 0,0:16:40.56,0:16:44.10,Default,,0,0,0,,Маған Гунзомен уақыт керек.
Dialogue: 0,0:16:44.73,0:16:47.57,Default,,0,0,0,,Біздің болмысымыз қандай?
Dialogue: 0,0:16:47.77,0:16:50.34,Default,,0,0,0,,Жауап алу үшін
Dialogue: 0,0:16:50.57,0:16:52.47,Default,,0,0,0,,Конгоу Тіпті сен!
Dialogue: 0,0:16:52.54,0:16:56.44,Default,,0,0,0,,Райсон д'етрді іздеу - түкке тұрғысыз әрекет.
Dialogue: 0,0:16:56.51,0:16:58.48,Default,,0,0,0,,Бұл түкке тұрғысыз және мағынасыз сұрақ.
Dialogue: 0,0:16:59.45,0:17:01.08,Default,,0,0,0,,Оның мағынасы бар.
Dialogue: 0,0:17:02.15,0:17:03.72,Default,,0,0,0,,Мен жалғыз екеніме сенімдімін
Dialogue: 0,0:17:04.42,0:17:06.35,Default,,0,0,0,,Өйткені ол өте әлсіз
Dialogue: 0,0:17:10.32,0:17:12.56,Default,,0,0,0,,Мен де, жалғыз қалғанда
Dialogue: 0,0:17:12.63,0:17:15.56,Default,,0,0,0,,Мен бұл дүниеде не істерімді білмедім
Dialogue: 0,0:17:16.23,0:17:18.17,Default,,0,0,0,,Мен сенемін, сен де қазір...
Dialogue: 0,0:17:18.67,0:17:20.20,Default,,0,0,0,,Мен әлсіз емеспін
Dialogue: 0,0:17:20.70,0:17:22.54,Default,,0,0,0,,Бірақ қазір сен
Dialogue: 0,0:17:22.60,0:17:24.24,Default,,0,0,0,,Жалғыз
Dialogue: 0,0:17:24.30,0:17:26.21,Default,,0,0,0,,Бұрынғы маған ұқсайды
Dialogue: 0,0:17:26.27,0:17:27.27,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:27.34,0:17:30.14,Default,,0,0,0,,Менде адмиралтейлік кодекс бар
Dialogue: 0,0:17:30.21,0:17:31.55,Default,,0,0,0,,Майя да сонда
Dialogue: 0,0:17:31.61,0:17:32.68,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:17:32.75,0:17:35.78,Default,,0,0,0,,Мұны өзіңе ғана айтып тұрған жоқсың ба?
Dialogue: 0,0:17:36.08,0:17:39.19,Default,,0,0,0,,Енді сізде психикалық үлгі бар басқа ештеңе сезінбейсіз бе?
Dialogue: 0,0:17:39.25,0:17:40.12,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:17:40.35,0:17:43.22,Default,,0,0,0,,Менің ойымша, біз бәрібір ұқсаспыз.
Dialogue: 0,0:17:43.29,0:17:44.83,Default,,0,0,0,,Бұлай сөйлесу мені одан сайын қатты сезінеді...
Dialogue: 0,0:17:45.13,0:17:45.79,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:17:47.09,0:17:49.43,Default,,0,0,0,,Маған жеңіл-желпі таныстардың керегі жоқ.
Dialogue: 0,0:17:49.50,0:17:51.23,Default,,0,0,0,,Түсінгенше мен неше рет айтуым керек?
Dialogue: 0,0:17:51.30,0:17:53.20,Default,,0,0,0,,Бұл да уақыт ұту әрекеті ме?
Dialogue: 0,0:17:53.53,0:17:54.84,Default,,0,0,0,,Конго жоқ!
Dialogue: 0,0:17:55.10,0:17:56.70,Default,,0,0,0,,Мен сенімен біргемін...
Dialogue: 0,0:17:58.84,0:18:00.84,Default,,0,0,0,,Шынында да, мен қазірмін
Dialogue: 0,0:18:01.11,0:18:03.64,Default,,0,0,0,,Адмиралтейт кодексіне қатысы жоқ
Dialogue: 0,0:18:03.71,0:18:07.18,Default,,0,0,0,,Мүмкін сізде сезім бар шығар.
Dialogue: 0,0:18:07.38,0:18:09.78,Default,,0,0,0,,Бірақ мұны есте сақтаңыз
Dialogue: 0,0:18:11.25,0:18:13.59,Default,,0,0,0,,Мен сені жек көремін
Dialogue: 0,0:18:30.27,0:18:31.87,Default,,0,0,0,,Сіз де сүңгіп көрдіңіз бе?
Dialogue: 0,0:18:32.37,0:18:33.87,Default,,0,0,0,,Сіз суға түсіп, мені қуып барасыз ба?
Dialogue: 0,0:18:34.68,0:18:37.34,Default,,0,0,0,,Толық жарылысқа дейін 52 секунд қалды
Dialogue: 0,0:18:40.21,0:18:42.75,Default,,0,0,0,,Конгоу кемесінде гравитон реакциясы расталды
Dialogue: 0,0:18:43.45,0:18:45.89,Default,,0,0,0,,Сіз нөлдік қашықтықтан супер гравитациялық зеңбірек атқыңыз келе ме?
Dialogue: 0,0:18:46.35,0:18:47.22,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:18:47.29,0:18:49.76,Default,,0,0,0,,Сіз ішке кіресіз бе?
Dialogue: 0,0:18:49.89,0:18:52.59,Default,,0,0,0,,Klein өрісінің есептеулерін де толық жарылысқа айналдырыңыз.
Dialogue: 0,0:18:53.13,0:18:53.86,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:18:54.13,0:18:57.36,Default,,0,0,0,,Толық жарылыстан басқа барлық есептеулер
Dialogue: 0,0:18:59.70,0:19:01.80,Default,,0,0,0,,жетуге 30 секунд қалды
Dialogue: 0,0:19:02.37,0:19:03.54,Default,,0,0,0,,29…
Dialogue: 0,0:19:04.20,0:19:04.91,Default,,0,0,0,,28…
Dialogue: 0,0:19:05.57,0:19:06.81,Default,,0,0,0,,27…
Dialogue: 0,0:19:08.61,0:19:09.84,Default,,0,0,0,,Іске қосу
Dialogue: 0,0:19:13.88,0:19:15.15,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:16.92,0:19:18.49,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:19:23.46,0:19:27.29,Default,,0,0,0,,５… ４… ３…
Dialogue: 0,0:19:27.49,0:19:29.76,Default,,0,0,0,,２… １…
Dialogue: 0,0:19:30.23,0:19:32.30,Default,,0,0,0,,Толық жарылыс сыни дәрежесіне жетті
Dialogue: 0,0:19:32.37,0:19:34.77,Default,,0,0,0,,Бұл аймақтан толық жылдамдықпен кетіңіз!
Dialogue: 0,0:19:44.75,0:19:46.31,Default,,0,0,0,,Ах... ха!
Dialogue: 0,0:19:47.31,0:19:48.32,Default,,0,0,0,,Хюуга
Dialogue: 0,0:19:48.92,0:19:52.35,Default,,0,0,0,,Сіз менің назарымды ұрлап, оны бұздыңыз ба?
Dialogue: 0,0:19:52.69,0:19:54.62,Default,,0,0,0,,Эй... бұл қауіпті болды.
Dialogue: 0,0:19:55.36,0:19:56.89,Default,,0,0,0,,Егер бұл кәдімгі Конго болса
Dialogue: 0,0:19:56.96,0:20:00.39,Default,,0,0,0,,Мен мұндай қарапайым қимылға түспес едім.
Dialogue: 0,0:20:00.83,0:20:04.90,Default,,0,0,0,,Адамгершілігі мол үлкен соғыс кемесі сияқты сезіне ме?
Dialogue: 0,0:20:05.43,0:20:08.34,Default,,0,0,0,,Ей, шаршадым, шаршадым.
Dialogue: 0,0:20:08.64,0:20:10.97,Default,,0,0,0,,Ол маған соңғы соққыны да бермеді.
Dialogue: 0,0:20:11.51,0:20:13.87,Default,,0,0,0,,Бұл сіз айтып отырған ауытқушылық емес пе?
Dialogue: 0,0:20:14.37,0:20:16.61,Default,,0,0,0,,Бұл шешімдегі қателік болды, солай ма?
Dialogue: 0,0:20:16.98,0:20:19.28,Default,,0,0,0,,Мен саған тағы бір нәрсе айтайын.
Dialogue: 0,0:20:19.35,0:20:21.88,Default,,0,0,0,,Сендер қуып келе жатқан адамзаттың козыры
Dialogue: 0,0:20:22.45,0:20:24.95,Default,,0,0,0,,Бұл менің орнымда.
Dialogue: 0,0:20:25.22,0:20:26.62,Default,,0,0,0,,Эй... балалар!
Dialogue: 0,0:20:26.69,0:20:28.29,Default,,0,0,0,,Бейтаныс жерлерді ұстамаңыз!
Dialogue: 0,0:20:28.36,0:20:31.39,Default,,0,0,0,,Ха! Бұл орындық жақсы емес! Сол адамның кесірінен!
Dialogue: 0,0:20:31.83,0:20:33.29,Default,,0,0,0,,Және... бәрібір
Dialogue: 0,0:20:33.36,0:20:35.83,Default,,0,0,0,,401 көбірек жем болды.
Dialogue: 0,0:20:35.90,0:20:36.76,Default,,0,0,0,,Бірақ
Dialogue: 0,0:20:37.23,0:20:38.77,Default,,0,0,0,,Басына қан жүгірген біреу
Dialogue: 0,0:20:38.83,0:20:42.34,Default,,0,0,0,,Мен тіпті екінші супер гравитациялық зеңбіректі асығыс атып жібердім.
Dialogue: 0,0:20:42.40,0:20:44.61,Default,,0,0,0,,Бұл керемет әскери кеме болса да.
Dialogue: 0,0:20:44.67,0:20:47.61,Default,,0,0,0,,Есептеу шегінен асып кетті, солай ма?
Dialogue: 0,0:20:47.91,0:20:49.01,Default,,0,0,0,,Міне!
Dialogue: 0,0:20:49.28,0:20:51.45,Default,,0,0,0,,Мен ол адаммен тез кездесуім керек!
Dialogue: 0,0:20:51.88,0:20:54.41,Default,,0,0,0,,Сізге зиян тигізбейді деп үміттенемін.
Dialogue: 0,0:20:54.88,0:20:55.85,Default,,0,0,0,,Сәлем Такао!
Dialogue: 0,0:20:55.92,0:20:57.25,Default,,0,0,0,,Мәңгі Иона-сама
Dialogue: 0,0:20:57.32,0:20:59.75,Default,,0,0,0,,Мен сені ол кісімен жалғыз қалдыра алмаймын!
Dialogue: 0,0:20:59.82,0:21:01.76,Default,,0,0,0,,Маған да жинап беріңізші!
Dialogue: 0,0:21:01.82,0:21:02.69,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:21:06.63,0:21:07.96,Default,,0,0,0,,Конго…
Dialogue: 0,0:21:21.28,0:21:24.34,Default,,0,0,0,,Балалар сендер қателесесіңдер
Dialogue: 0,0:21:25.45,0:21:27.38,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:21:31.32,0:21:37.32,Default,,0,0,0,,♪～
Dialogue: 0,0:22:33.68,0:22:39.69,Default,,0,0,0,,～♪
Dialogue: 0,0:22:42.76,0:22:45.59,Default,,0,0,0,,Хаа...Майтака
Dialogue: 0,0:22:45.66,0:22:46.86,Default,,0,0,0,,Қалғанының бәрі жоспарланғандай болды
Dialogue: 0,0:22:46.93,0:22:48.66,Default,,0,0,0,,Такао және оның достарымен қосылып, Америкаға бардық...
Dialogue: 0,0:22:48.86,0:22:49.86,Default,,0,0,0,,Ха...
Dialogue: 0,0:22:49.93,0:22:51.90,Default,,0,0,0,,Иона! Сенімен бәрі жақсы ма?
Dialogue: 0,0:22:52.37,0:22:53.50,Default,,0,0,0,,Мен жақсымын
Dialogue: 0,0:22:53.57,0:22:56.47,Default,,0,0,0,,Жүк сәл ауыр болды, мен жай ғана шаршадым.
Dialogue: 0,0:22:56.54,0:22:57.47,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:58.67,0:23:01.68,Default,,0,0,0,,Өйткені мен Гунцоның кемесімін
Dialogue: 0,0:23:01.74,0:23:02.61,Default,,0,0,0,,Ехе
Dialogue: 0,0:23:04.85,0:23:05.71,Default,,0,0,0,,Иә
Dialogue: 0,0:23:07.45,0:23:08.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:13.79,0:23:14.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:14.72,0:23:15.59,Default,,0,0,0,,Не?
Dialogue: 0,0:23:16.59,0:23:18.99,Default,,0,0,0,,Торпедоның эрозиясының соққысы! №2!
Dialogue: 0,0:23:21.39,0:23:23.93,Default,,0,0,0,,Кляйн өрісінің қанығуы жоғалады!
Dialogue: 0,0:23:24.80,0:23:26.80,Default,,0,0,0,,Сағат 4-тен жақындап келе жатқан эрозия торпедасы!
Dialogue: 0,0:23:27.63,0:23:29.97,Default,,0,0,0,,Сондай-ақ сағат 12-ден... Ах!
Dialogue: 0,0:23:34.54,0:23:36.01,Default,,0,0,0,,Қарғыс атсын! Уф...
Dialogue: 0,0:23:36.88,0:23:38.78,Default,,0,0,0,,Тұтқынға түсті ме?
Dialogue: 0,0:23:45.45,0:23:47.72,Default,,0,0,0,,401-нің батуы расталды
Dialogue: 0,0:23:48.82,0:23:50.66,Default,,0,0,0,,Тапсырма орындалды
Dialogue: 0,0:23:54.43,0:23:56.56,Default,,0,0,0,,Адмиралтейлік кодекске сәйкес
Dialogue: 0,0:23:57.63,0:24:00.70,Default,,0,0,0,,Біз тұман флоты
Dialogue: 0,0:24:02.20,0:24:08.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
