Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.14,0:00:14.64,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:00:15.28,0:00:17.28,Default,,0,0,0,,Иона Зақымдану жағдайы қандай?
Dialogue: 0,0:00:17.48,0:00:20.02,Default,,0,0,0,,Жабдықтың 40% жоғалды
Dialogue: 0,0:00:20.25,0:00:22.18,Default,,0,0,0,,Хмм... Бұл қиын.
Dialogue: 0,0:00:22.62,0:00:23.62,Default,,0,0,0,,Жөндеу?
Dialogue: 0,0:00:24.02,0:00:26.19,Default,,0,0,0,,Наноматериалдардың айтарлықтай тапшылығы
Dialogue: 0,0:00:26.39,0:00:27.76,Default,,0,0,0,,Алғашқы көмек көрсету шаралары үшін
Dialogue: 0,0:00:28.16,0:00:30.53,Default,,0,0,0,,Эрозиялық торпедаларда да нөлдік оқ қалды.
Dialogue: 0,0:00:30.79,0:00:33.50,Default,,0,0,0,,Бізге қазір тұман жігіттер шабуыл жасаса, бітті.
Dialogue: 0,0:00:33.70,0:00:37.57,Default,,0,0,0,,Хмм... Иво Джимаға бару керек сияқты.
Dialogue: 0,0:00:37.70,0:00:40.44,Default,,0,0,0,,Сіз базаға аман-есен ораласыз деп үміттенемін.
Dialogue: 0,0:00:43.47,0:00:45.17,Default,,0,0,0,,Басқарудан кіріс қоңырауы
Dialogue: 0,0:00:45.44,0:00:49.21,Default,,0,0,0,,Біз енді дірілдеп тұрған оқтұмсықты тиеуді және тексеруді бастаймыз.
Dialogue: 0,0:00:49.68,0:00:52.55,Default,,0,0,0,,Жоспарлы жұмыстың аяқталуы 2000
Dialogue: 0,0:01:06.80,0:01:08.73,Default,,0,0,0,,Бұл дірілдейтін оқтұмсық
Dialogue: 0,0:01:09.33,0:01:12.73,Default,,0,0,0,,Бұл эрозияға ұшыраған торпедаға қарағанда күштірек екенін білдіреді.
Dialogue: 0,0:01:13.07,0:01:16.30,Default,,0,0,0,,Америка біздің жеткізуімізді асыға күтуі керек.
Dialogue: 0,0:01:16.47,0:01:18.47,Default,,0,0,0,,Бұл бір рет атылатын кері қару ма?
Dialogue: 0,0:01:18.54,0:01:21.24,Default,,0,0,0,,Сіз сондай ғажайып нәрсе жасадыңыз.
Dialogue: 0,0:01:21.81,0:01:22.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:25.15,0:01:26.15,Default,,0,0,0,,Сол қыз...
Dialogue: 0,0:01:27.38,0:01:29.72,Default,,0,0,0,,Иона Бұл қыз есіңде ме?
Dialogue: 0,0:01:30.72,0:01:31.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:39.79,0:01:45.80,Default,,0,0,0,,♪～
Dialogue: 0,0:03:00.91,0:03:06.92,Default,,0,0,0,,～♪
Dialogue: 0,0:03:21.96,0:03:24.83,Default,,0,0,0,,Әй, саған не болды? (ойыншық пианино дыбысы)
Dialogue: 0,0:03:24.90,0:03:27.34,Default,,0,0,0,,Суға батқан Киришима мен Харуна
Dialogue: 0,0:03:28.87,0:03:31.81,Default,,0,0,0,,Мен Майяның тезірек белсенді болғанын қалаймын~
Dialogue: 0,0:03:32.61,0:03:33.64,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:03:33.88,0:03:35.74,Default,,0,0,0,,Ойлар ағылды
Dialogue: 0,0:03:36.41,0:03:37.78,Default,,0,0,0,,Тек өкіну емес
Dialogue: 0,0:03:38.31,0:03:39.65,Default,,0,0,0,,Аздап қанағаттану
Dialogue: 0,0:03:40.28,0:03:40.95,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:03:41.42,0:03:43.75,Default,,0,0,0,,Досыңа көмектесе алғаның үшін бе?
Dialogue: 0,0:03:44.39,0:03:45.42,Default,,0,0,0,,Сау бол, Джоджо!
Dialogue: 0,0:03:46.85,0:03:47.86,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:04:07.41,0:04:09.58,Default,,0,0,0,,Тұтынушы әлі жабық.
Dialogue: 0,0:04:09.64,0:04:10.65,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:10.78,0:04:12.48,Default,,0,0,0,,Сіз ешкімге айтқан жоқсыз, солай ма?
Dialogue: 0,0:04:12.58,0:04:13.45,Default,,0,0,0,,Иә
Dialogue: 0,0:04:14.42,0:04:15.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:15.62,0:04:16.48,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:04:19.49,0:04:22.49,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:04:28.26,0:04:29.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:31.33,0:04:35.27,Default,,0,0,0,,А... а... а
Dialogue: 0,0:04:43.44,0:04:45.85,Default,,0,0,0,,А... анау пальто...
Dialogue: 0,0:04:45.95,0:04:47.92,Default,,0,0,0,,Бұл сіздікі ме?
Dialogue: 0,0:04:47.98,0:04:49.75,Default,,0,0,0,,Бұл өте үлкен?
Dialogue: 0,0:04:50.42,0:04:51.75,Default,,0,0,0,,Қайтарыңыз...
Dialogue: 0,0:04:52.49,0:04:54.42,Default,,0,0,0,,А... у... иә!
Dialogue: 0,0:04:57.49,0:04:59.73,Default,,0,0,0,,Шику… Шику Шику…
Dialogue: 0,0:05:00.50,0:05:02.56,Default,,0,0,0,,Сик Сик Сик…
Dialogue: 0,0:05:03.03,0:05:03.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:05.87,0:05:07.30,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:07.87,0:05:09.30,Default,,0,0,0,,Шәкең
Dialogue: 0,0:05:09.67,0:05:11.74,Default,,0,0,0,,Ум... у...
Dialogue: 0,0:05:13.31,0:05:15.88,Default,,0,0,0,,Мен Маки Джобумын. Сен ше?
Dialogue: 0,0:05:16.34,0:05:17.01,Default,,0,0,0,,Харуна
Dialogue: 0,0:05:17.08,0:05:18.65,Default,,0,0,0,,Не, Харуна-сан?
Dialogue: 0,0:05:19.41,0:05:20.08,Default,,0,0,0,,Харуна
Dialogue: 0,0:05:21.38,0:05:22.38,Default,,0,0,0,,Хмм?
Dialogue: 0,0:05:22.75,0:05:24.32,Default,,0,0,0,,Аа, дұрыс, Харуна.
Dialogue: 0,0:05:24.95,0:05:26.89,Default,,0,0,0,,Бұл құлады.
Dialogue: 0,0:05:27.46,0:05:28.39,Default,,0,0,0,,Сіздікі?
Dialogue: 0,0:05:28.69,0:05:29.56,Default,,0,0,0,,Иә
Dialogue: 0,0:05:29.62,0:05:31.56,Default,,0,0,0,,Бұл мен бұрын көрмеген материал.
Dialogue: 0,0:05:31.83,0:05:35.00,Default,,0,0,0,,Металға ұқсайды, бірақ өте жеңіл.
Dialogue: 0,0:05:38.43,0:05:39.83,Default,,0,0,0,,Киришима, жақсысың ба?
Dialogue: 0,0:05:40.60,0:05:41.47,Default,,0,0,0,,О
Dialogue: 0,0:05:41.70,0:05:44.04,Default,,0,0,0,,Одақ өзегіне зақым келмесе де
Dialogue: 0,0:05:44.44,0:05:45.81,Default,,0,0,0,,Бұл қандай жағдай?
Dialogue: 0,0:05:46.51,0:05:47.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:47.94,0:05:51.95,Default,,0,0,0,,Бұл бала оны кемеден лақтырып жібергеннен кейін құтқарған сияқты.
Dialogue: 0,0:05:52.08,0:05:53.51,Default,,0,0,0,,Мәліметтер белгісіз
Dialogue: 0,0:05:53.65,0:05:54.62,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:05:54.75,0:05:56.85,Default,,0,0,0,,Жағдайды қосымша растауды сұрау
Dialogue: 0,0:05:56.98,0:05:57.85,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:05:58.72,0:05:59.59,Default,,0,0,0,,Эй...
Dialogue: 0,0:06:00.35,0:06:01.56,Default,,0,0,0,,Ой... уау!
Dialogue: 0,0:06:02.76,0:06:03.62,Default,,0,0,0,,Не?
Dialogue: 0,0:06:03.69,0:06:06.86,Default,,0,0,0,,Өйткені ол кенеттен жұмысын тоқтатады.
Dialogue: 0,0:06:07.10,0:06:09.00,Default,,0,0,0,,Мен жай ғана ойладым.
Dialogue: 0,0:06:09.06,0:06:10.53,Default,,0,0,0,,жақсы болар еді.
Dialogue: 0,0:06:11.10,0:06:12.47,Default,,0,0,0,,Айтпақшы, сіз
Dialogue: 0,0:06:12.63,0:06:14.80,Default,,0,0,0,,Неге менің мүлкіме құладың?
Dialogue: 0,0:06:15.60,0:06:16.70,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:21.94,0:06:24.38,Default,,0,0,0,,Ол жалаңаш сияқты.
Dialogue: 0,0:06:24.58,0:06:26.15,Default,,0,0,0,,Киім материалдары
Dialogue: 0,0:06:26.41,0:06:27.92,Default,,0,0,0,,Ұсақталған құрылым ретінде
Dialogue: 0,0:06:27.98,0:06:30.05,Default,,0,0,0,,Соққыларды сіңіру үшін қолданылады
Dialogue: 0,0:06:30.59,0:06:33.02,Default,,0,0,0,,Муфталанатын… Не?
Dialogue: 0,0:06:33.09,0:06:34.62,Default,,0,0,0,,Ұсақталған құрылым
Dialogue: 0,0:06:34.69,0:06:35.62,Default,,0,0,0,,Әй, қой, маңызды емес.
Dialogue: 0,0:06:36.39,0:06:37.66,Default,,0,0,0,,Әй, міне сен.
Dialogue: 0,0:06:37.73,0:06:39.53,Default,,0,0,0,,Осы жерде біраз тұрсам ше?
Dialogue: 0,0:06:39.59,0:06:41.16,Default,,0,0,0,,Бір себеп бар сияқты.
Dialogue: 0,0:06:41.80,0:06:43.73,Default,,0,0,0,,Серуенге шықсам да
Dialogue: 0,0:06:43.80,0:06:45.70,Default,,0,0,0,,Пальтомен іш киім кию жаман емес пе?
Dialogue: 0,0:06:46.13,0:06:47.00,Default,,0,0,0,,Жаман ба?
Dialogue: 0,0:06:48.94,0:06:49.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:49.87,0:06:50.74,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:55.91,0:06:58.08,Default,,0,0,0,,Адам киімінің тарихы туралы мәліметтерді жіберу
Dialogue: 0,0:06:58.65,0:07:01.02,Default,,0,0,0,,Бұдан былай жерде не істейтінімізді қарастыру.
Dialogue: 0,0:07:01.15,0:07:02.92,Default,,0,0,0,,жақсартқан дұрыс сияқты
Dialogue: 0,0:07:03.55,0:07:05.72,Default,,0,0,0,,Біз де осындай қорытындыға келдік.
Dialogue: 0,0:07:06.59,0:07:07.92,Default,,0,0,0,,Сіздің көзқарасыңыз бойынша
Dialogue: 0,0:07:08.16,0:07:10.12,Default,,0,0,0,,Қалай дұрыс киінуге болады?
Dialogue: 0,0:07:10.19,0:07:11.56,Default,,0,0,0,,Ха! Содан кейін
Dialogue: 0,0:07:11.63,0:07:13.73,Default,,0,0,0,,Үйде ешкім кимейтін киімдеріміз көп.
Dialogue: 0,0:07:13.80,0:07:14.66,Default,,0,0,0,,Мен саған беремін!
Dialogue: 0,0:07:14.76,0:07:17.93,Default,,0,0,0,,Сізге сәйкес келетін өлшемдер көп екеніне сенімдімін.
Dialogue: 0,0:07:18.10,0:07:20.97,Default,,0,0,0,,Мм... ол қайда болды?
Dialogue: 0,0:07:21.74,0:07:22.97,Default,,0,0,0,,Джобу Маки
Dialogue: 0,0:07:23.14,0:07:25.71,Default,,0,0,0,,Маған неге көмектесесің?
Dialogue: 0,0:07:25.94,0:07:27.04,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:07:27.64,0:07:30.45,Default,,0,0,0,,Иә, бұл да байланыстың бір түрі.
Dialogue: 0,0:07:30.65,0:07:31.51,Default,,0,0,0,,Edge?
Dialogue: 0,0:07:31.58,0:07:33.75,Default,,0,0,0,,Иә! Сіз білмейсіз бе?
Dialogue: 0,0:07:34.18,0:07:35.05,Default,,0,0,0,,Шет
Dialogue: 0,0:07:36.88,0:07:38.79,Default,,0,0,0,,Адамдар арасындағы байланыстар
Dialogue: 0,0:07:38.99,0:07:40.92,Default,,0,0,0,,Тағдырлы сәйкестік
Dialogue: 0,0:07:41.66,0:07:42.72,Default,,0,0,0,,Тег қосымшасы
Dialogue: 0,0:07:42.99,0:07:44.86,Default,,0,0,0,,Классификациялық жазбалар
Dialogue: 0,0:07:45.69,0:07:49.46,Default,,0,0,0,,Харуна жапон сөздігі сияқты сөйлейді.
Dialogue: 0,0:07:49.53,0:07:51.57,Default,,0,0,0,,Машина сияқты нәрсе бар ма?
Dialogue: 0,0:07:51.63,0:07:53.57,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:07:53.63,0:07:54.77,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:07:55.20,0:07:58.64,Default,,0,0,0,,Уфуфу... Бірақ мұндай нәрсе қызық.
Dialogue: 0,0:07:58.71,0:07:59.97,Default,,0,0,0,,(Ge)
Dialogue: 0,0:08:07.15,0:08:09.72,Default,,0,0,0,,Ерм~ Ерм~
Dialogue: 0,0:08:10.05,0:08:12.49,Default,,0,0,0,,Хм, бұл ма?
Dialogue: 0,0:08:13.52,0:08:15.92,Default,,0,0,0,,Хмм, бұл да емес.
Dialogue: 0,0:08:16.86,0:08:19.03,Default,,0,0,0,,Немесе бұл мүмкін бе?
Dialogue: 0,0:08:19.93,0:08:22.50,Default,,0,0,0,,Жоқ, жоқ, мен мұны да тастай алмаймын.
Dialogue: 0,0:08:22.83,0:08:23.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:25.23,0:08:28.04,Default,,0,0,0,,Сабырлы бол...
Dialogue: 0,0:08:28.10,0:08:29.27,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:08:29.54,0:08:32.04,Default,,0,0,0,,Киіміңді ауыстырсаң, шаш үлгісін де өзгертуге тура келеді.
Dialogue: 0,0:08:32.67,0:08:34.01,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:08:34.28,0:08:35.84,Default,,0,0,0,,Осындай нәрсе бар ма?
Dialogue: 0,0:08:36.28,0:08:38.01,Default,,0,0,0,,Бұл да жақсы~
Dialogue: 0,0:08:38.91,0:08:39.95,Default,,0,0,0,,Хару Хару - ~
Dialogue: 0,0:08:40.01,0:08:43.02,Default,,0,0,0,,Сәнді болғаны дұрыс болар еді деп ойлаймын.
Dialogue: 0,0:08:43.75,0:08:47.02,Default,,0,0,0,,Дұрыс, ертең бірге дүкен аралайық.
Dialogue: 0,0:08:47.09,0:08:49.12,Default,,0,0,0,,Сыртқа шыға аласың ба деп сұраймын.
Dialogue: 0,0:08:49.19,0:08:50.26,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:08:51.59,0:08:52.59,Default,,0,0,0,,Иә
Dialogue: 0,0:08:55.20,0:08:57.90,Default,,0,0,0,,Ханым, сіздің тексеру уақыты келді.
Dialogue: 0,0:08:58.13,0:09:00.13,Default,,0,0,0,,Иә, мен қазір барамын.
Dialogue: 0,0:09:00.54,0:09:01.27,Default,,0,0,0,,Хархару
Dialogue: 0,0:09:01.54,0:09:03.77,Default,,0,0,0,,Киімді баяу таңдаңыз.
Dialogue: 0,0:09:10.61,0:09:11.98,Default,,0,0,0,,Шәкең
Dialogue: 0,0:09:12.05,0:09:13.28,Default,,0,0,0,,Хехе...
Dialogue: 0,0:09:13.92,0:09:14.92,Default,,0,0,0,,Хару Хару~
Dialogue: 0,0:09:15.18,0:09:17.05,Default,,0,0,0,,Сізге ұнады ма? Хару Хару~
Dialogue: 0,0:09:17.12,0:09:18.25,Default,,0,0,0,,Хехе...
Dialogue: 0,0:09:20.05,0:09:21.06,Default,,0,0,0,,Айтпақшы, Харуна
Dialogue: 0,0:09:21.12,0:09:23.69,Default,,0,0,0,,Маған наноматериалдарды беріңізші.
Dialogue: 0,0:09:23.99,0:09:26.59,Default,,0,0,0,,Күтілгендей, мен бұл күйде қозғала алмаймын.
Dialogue: 0,0:09:34.80,0:09:35.67,Default,,0,0,0,,Хмф!
Dialogue: 0,0:09:39.01,0:09:39.87,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:09:41.01,0:09:43.08,Default,,0,0,0,,А... Мен... Көне алмай жүрмін.
Dialogue: 0,0:09:43.74,0:09:44.61,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:45.18,0:09:46.35,Default,,0,0,0,,Бұл сарай...
Dialogue: 0,0:09:52.89,0:09:54.96,Default,,0,0,0,,Биологиялық реакция Жоқ
Dialogue: 0,0:09:55.66,0:09:57.06,Default,,0,0,0,,Бұл жерде ғана емес
Dialogue: 0,0:09:57.19,0:10:00.13,Default,,0,0,0,,Үлкен ғимарат болғанымен, биологиялық реакциялар аз.
Dialogue: 0,0:10:00.19,0:10:01.13,Default,,0,0,0,,Тұтынушы
Dialogue: 0,0:10:01.73,0:10:02.73,Default,,0,0,0,,Өлі ойна!
Dialogue: 0,0:10:02.80,0:10:04.17,Default,,0,0,0,,Сізді жас ханым күтіп тұр.
Dialogue: 0,0:10:04.73,0:10:06.23,Default,,0,0,0,,Мен сені асханаға апарамын.
Dialogue: 0,0:10:10.81,0:10:11.67,Default,,0,0,0,,Эй
Dialogue: 0,0:10:11.74,0:10:12.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:12.67,0:10:13.84,Default,,0,0,0,,Мені өзіңізбен бірге алыңыз.
Dialogue: 0,0:10:14.04,0:10:16.28,Default,,0,0,0,,Мен күткендей, мен қоғамдық орындарда жүре алмаймын...
Dialogue: 0,0:10:18.68,0:10:19.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:19.75,0:10:21.32,Default,,0,0,0,,Ол балаға не болды?
Dialogue: 0,0:10:21.72,0:10:22.75,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:10:22.95,0:10:24.95,Default,,0,0,0,,Жоқ, бұл дұрыс емес...
Dialogue: 0,0:10:25.02,0:10:26.25,Default,,0,0,0,,Онсыз болмайды.
Dialogue: 0,0:10:26.69,0:10:27.36,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:10:27.62,0:10:28.76,Default,,0,0,0,,Ха! Бұл дұрыс
Dialogue: 0,0:10:32.03,0:10:33.96,Default,,0,0,0,,Бәріміз бірге тамақтанайық
Dialogue: 0,0:10:34.03,0:10:35.16,Default,,0,0,0,,Ihihi…
Dialogue: 0,0:10:35.23,0:10:37.37,Default,,0,0,0,,Осындай нәрсе қызық.
Dialogue: 0,0:10:37.87,0:10:39.37,Default,,0,0,0,,Біреумен кешкі ас ішіп жатырсыз ба?
Dialogue: 0,0:10:40.80,0:10:42.87,Default,,0,0,0,,Басқа адамдар бар ма?
Dialogue: 0,0:10:43.17,0:10:45.11,Default,,0,0,0,,Қызметшіден басқа барлығы
Dialogue: 0,0:10:45.64,0:10:47.38,Default,,0,0,0,,Сенің анаң білмейді.
Dialogue: 0,0:10:47.84,0:10:49.71,Default,,0,0,0,,Әкесі де қайтыс болды.
Dialogue: 0,0:10:49.98,0:10:52.38,Default,,0,0,0,,Сондықтан мен үнемі жалғыз тамақтанамын.
Dialogue: 0,0:10:52.65,0:10:53.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:53.78,0:10:55.08,Default,,0,0,0,,Қазір тамақтанайық
Dialogue: 0,0:10:55.15,0:10:58.12,Default,,0,0,0,,Мен саған көп нәрсе жасадым, сондықтан көп жеп ал!
Dialogue: 0,0:11:08.03,0:11:09.20,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:09.83,0:11:10.83,Default,,0,0,0,,Медицина
Dialogue: 0,0:11:11.03,0:11:13.07,Default,,0,0,0,,Ішуді ұмытып кетсең қиын.
Dialogue: 0,0:11:13.13,0:11:14.14,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:11:17.44,0:11:20.04,Default,,0,0,0,,Ханым, сіздің тексеру уақыты келді.
Dialogue: 0,0:11:20.27,0:11:22.08,Default,,0,0,0,,Иә, мен қазір барамын.
Dialogue: 0,0:11:22.28,0:11:23.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:23.91,0:11:25.41,Default,,0,0,0,,Иә? Хару Хару
Dialogue: 0,0:11:26.15,0:11:27.78,Default,,0,0,0,,Мүмкін сіз сәбізді ұнатпайсыз ба?
Dialogue: 0,0:11:27.85,0:11:28.82,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:11:28.88,0:11:30.12,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:11:30.18,0:11:33.35,Default,,0,0,0,,Сәбіз жемесең, өспейсің.
Dialogue: 0,0:11:33.42,0:11:34.29,Default,,0,0,0,,Эй?
Dialogue: 0,0:11:34.36,0:11:35.46,Default,,0,0,0,,Иә Йотаро
Dialogue: 0,0:11:35.72,0:11:38.73,Default,,0,0,0,,Түсіндім... Бұл жігіттің аты Йотаро ма?
Dialogue: 0,0:11:39.36,0:11:40.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:40.29,0:11:41.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:41.36,0:11:45.23,Default,,0,0,0,,Киришима тұлыптары сәбіз жемейді
Dialogue: 0,0:11:45.43,0:11:47.00,Default,,0,0,0,,Таныс
Dialogue: 0,0:11:47.94,0:11:48.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:48.87,0:11:49.80,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:11:49.87,0:11:51.44,Default,,0,0,0,,Мен оны тез ашылады деп күтпедім.
Dialogue: 0,0:11:52.27,0:11:54.21,Default,,0,0,0,,Егер бұл орын алса, оған көмектесу мүмкін емес!
Dialogue: 0,0:11:54.44,0:11:55.91,Default,,0,0,0,,Кешір мені, Маки!
Dialogue: 0,0:11:56.81,0:11:57.48,Default,,0,0,0,,Керемет!
Dialogue: 0,0:11:58.98,0:11:59.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:00.01,0:12:02.15,Default,,0,0,0,,Уау! Апыр-ай! Апыр-ай!
Dialogue: 0,0:12:02.22,0:12:04.05,Default,,0,0,0,,Сәлем! Мұны Харухару жасады ма?
Dialogue: 0,0:12:04.12,0:12:05.82,Default,,0,0,0,,Е... а... жақсы.
Dialogue: 0,0:12:05.89,0:12:07.99,Default,,0,0,0,,Реңк~ Бұл қашан болды?
Dialogue: 0,0:12:08.32,0:12:10.76,Default,,0,0,0,,Харухару робот дәрігер ме?
Dialogue: 0,0:12:10.83,0:12:13.99,Default,,0,0,0,,Мен сияқты құпия бизнес серіктес пе?
Dialogue: 0,0:12:14.16,0:12:15.03,Default,,0,0,0,,Е...
Dialogue: 0,0:12:15.16,0:12:16.33,Default,,0,0,0,,(Юки) Бірақ Хори, сен мықтысың ғой, иә? (Хидэ Иура) Һмм…
Dialogue: 0,0:12:16.40,0:12:17.80,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:12:17.87,0:12:20.47,Default,,0,0,0,,Мен сені біртүрлі бала деп ойладым.
Dialogue: 0,0:12:20.73,0:12:23.00,Default,,0,0,0,,Түсіндім, сен мен сияқтысың ба?
Dialogue: 0,0:12:23.74,0:12:24.74,Default,,0,0,0,,Бұл да…
Dialogue: 0,0:12:24.87,0:12:26.94,Default,,0,0,0,,Солай болса да, бұл таңқаларлық~
Dialogue: 0,0:12:27.01,0:12:28.38,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:12:28.44,0:12:30.01,Default,,0,0,0,,Мен оны саған беремін
Dialogue: 0,0:12:30.08,0:12:30.95,Default,,0,0,0,,Эх!
Dialogue: 0,0:12:31.15,0:12:32.85,Default,,0,0,0,,Мен үшін жасаған барлық істеріңіз үшін рахмет
Dialogue: 0,0:12:32.91,0:12:33.78,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:12:33.85,0:12:34.52,Default,,0,0,0,,Иә
Dialogue: 0,0:12:34.78,0:12:36.95,Default,,0,0,0,,Мм... Сәлеметсіз бе? Харуна мырза?
Dialogue: 0,0:12:37.79,0:12:38.79,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:12:38.99,0:12:39.85,Default,,0,0,0,,Йотаро
Dialogue: 0,0:12:39.92,0:12:41.42,Default,,0,0,0,,Сізде сәттілік
Dialogue: 0,0:12:41.49,0:12:44.76,Default,,0,0,0,,Мен өз аяғыммен жүруге еркіндік алдым.
Dialogue: 0,0:12:45.06,0:12:47.29,Default,,0,0,0,,Сізге жақсы, Йотару.
Dialogue: 0,0:12:47.86,0:12:49.50,Default,,0,0,0,,Шулы! Хару Хару
Dialogue: 0,0:12:52.77,0:12:53.43,Default,,0,0,0,,Хехе…
Dialogue: 0,0:12:53.50,0:12:55.37,Default,,0,0,0,,Қара, қара, мына жаққа қара.
Dialogue: 0,0:12:55.44,0:12:57.17,Default,,0,0,0,,Шыдамдылық танытып, оны қолданыңыз
Dialogue: 0,0:12:57.24,0:12:59.24,Default,,0,0,0,,Хи хи... Ух...
Dialogue: 0,0:13:00.41,0:13:03.28,Default,,0,0,0,,Хехе... хехеха... хехехе...
Dialogue: 0,0:13:03.44,0:13:04.88,Default,,0,0,0,,Жапонияда
Dialogue: 0,0:13:04.95,0:13:08.28,Default,,0,0,0,,Достар бір-бірінің арқасын осылай жуады.
Dialogue: 0,0:13:08.95,0:13:10.89,Default,,0,0,0,,Хэхехе... Достар...
Dialogue: 0,0:13:10.95,0:13:12.79,Default,,0,0,0,,Сіз жақын араласатын адам
Dialogue: 0,0:13:12.85,0:13:14.16,Default,,0,0,0,,Маңызды адам
Dialogue: 0,0:13:14.22,0:13:15.39,Default,,0,0,0,,Тег қосымшасы
Dialogue: 0,0:13:15.46,0:13:16.39,Default,,0,0,0,,Классификация
Dialogue: 0,0:13:16.46,0:13:18.23,Default,,0,0,0,,Жазба Ах... Ах!
Dialogue: 0,0:13:23.30,0:13:24.53,Default,,0,0,0,,Забун
Dialogue: 0,0:13:24.80,0:13:27.03,Default,,0,0,0,,Ақ кит су бетіне шықты.
Dialogue: 0,0:13:27.47,0:13:30.00,Default,,0,0,0,,Енді қайтадан суға түсеміз.
Dialogue: 0,0:13:31.47,0:13:33.84,Default,,0,0,0,,Маки тегін.
Dialogue: 0,0:13:34.07,0:13:35.04,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:13:35.11,0:13:38.25,Default,,0,0,0,,Шын мәнінде емес. Сіз бұл туралы бір кездері ойладыңыз ба?
Dialogue: 0,0:13:42.18,0:13:43.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:52.59,0:13:53.89,Default,,0,0,0,,Хехе...
Dialogue: 0,0:13:53.96,0:13:55.53,Default,,0,0,0,,Қайырлы түн Йотаро
Dialogue: 0,0:13:55.93,0:13:57.43,Default,,0,0,0,,Қайырлы түн Харухару
Dialogue: 0,0:13:57.90,0:13:59.27,Default,,0,0,0,,Қайырлы түн Маки
Dialogue: 0,0:13:59.87,0:14:00.53,Default,,0,0,0,,Хехе...
Dialogue: 0,0:14:01.04,0:14:02.10,Default,,0,0,0,,Хару Хару~
Dialogue: 0,0:14:06.21,0:14:08.58,Default,,0,0,0,,Харухару өте жылы
Dialogue: 0,0:14:15.35,0:14:16.28,Default,,0,0,0,,Харуна
Dialogue: 0,0:14:16.62,0:14:19.05,Default,,0,0,0,,Конгоға қазіргі жағдайды айтуымыз керек.
Dialogue: 0,0:14:19.89,0:14:20.55,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:14:20.92,0:14:24.09,Default,,0,0,0,,Мен хабарлауды қалайтын тағы бір қызықты нәрсені білдім.
Dialogue: 0,0:14:24.19,0:14:25.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:31.40,0:14:34.07,Default,,0,0,0,,Сізге бұл көрініс ұнай ма?
Dialogue: 0,0:14:34.13,0:14:36.07,Default,,0,0,0,,Жоқ... бұл уақытша!
Dialogue: 0,0:14:36.14,0:14:37.47,Default,,0,0,0,,Ах... хмм...
Dialogue: 0,0:14:37.87,0:14:40.04,Default,,0,0,0,,Одан да ұят
Dialogue: 0,0:14:40.27,0:14:42.38,Default,,0,0,0,,Мен ешқашан жеңілеміз деп ойламаппын...
Dialogue: 0,0:14:42.44,0:14:44.98,Default,,0,0,0,,Екі адамның жағдайы қадағаланып отырды.
Dialogue: 0,0:14:45.05,0:14:47.65,Default,,0,0,0,,Өзегі ғана болса да, қашып құтылу керемет.
Dialogue: 0,0:14:47.92,0:14:48.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:49.42,0:14:51.95,Default,,0,0,0,,Әзірше екеуің Сагами шығанағына баруларың керек.
Dialogue: 0,0:14:52.32,0:14:55.32,Default,,0,0,0,,Майя Камакура жағалауында күту режимінде.
Dialogue: 0,0:14:55.39,0:14:56.59,Default,,0,0,0,,Күте тұрыңыз, Конгоу.
Dialogue: 0,0:14:56.66,0:14:58.56,Default,,0,0,0,,Негізі маған қызық болды.
Dialogue: 0,0:14:58.63,0:14:59.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:00.23,0:15:01.43,Default,,0,0,0,,Ағымдағы ақпарат
Dialogue: 0,0:15:01.50,0:15:03.50,Default,,0,0,0,,Ортақ желіге жүктеп салу
Dialogue: 0,0:15:04.63,0:15:06.33,Default,,0,0,0,,Дірілдейтін оқтұмсық
Dialogue: 0,0:15:06.93,0:15:09.67,Default,,0,0,0,,Бұл адамдар жасаған торпеданың жаңа түрі ме?
Dialogue: 0,0:15:10.20,0:15:11.17,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:15:12.07,0:15:13.24,Default,,0,0,0,,Енді біз
Dialogue: 0,0:15:13.31,0:15:16.98,Default,,0,0,0,,Мен оның бас әзірлеушісі болған Тоджуро Гиобудың үйіндемін.
Dialogue: 0,0:15:17.91,0:15:19.48,Default,,0,0,0,,Қылмыстық бөлім қазірдің өзінде өлді.
Dialogue: 0,0:15:19.55,0:15:22.55,Default,,0,0,0,,Жаңа торпедалар туралы деректерді қалпына келтіру мүмкіндігі
Dialogue: 0,0:15:23.35,0:15:25.35,Default,,0,0,0,,Мен мұны өз беделін қайтару деп атағым келмейді, бірақ
Dialogue: 0,0:15:26.35,0:15:28.36,Default,,0,0,0,,Жарайды, мен саған қалдырамын.
Dialogue: 0,0:15:28.69,0:15:30.69,Default,,0,0,0,,Майя күте береді.
Dialogue: 0,0:15:31.26,0:15:33.13,Default,,0,0,0,,Енді операциялық әрекетке көшеміз.
Dialogue: 0,0:15:34.50,0:15:35.50,Default,,0,0,0,,Кеттік, Харуна.
Dialogue: 0,0:15:39.57,0:15:43.30,Default,,0,0,0,,Адамзат өзінің табиғатын эмоция арқылы өзгертеді.
Dialogue: 0,0:15:43.37,0:15:45.97,Default,,0,0,0,,Бірақ біз тұманбыз
Dialogue: 0,0:15:46.04,0:15:49.04,Default,,0,0,0,,Ол жай ғана кездейсоқ тұлға ретінде әрекет етеді.
Dialogue: 0,0:16:03.96,0:16:06.09,Default,,0,0,0,,Мен оны көріп тұрмын! Иво Джима!
Dialogue: 0,0:16:06.16,0:16:09.13,Default,,0,0,0,,Жоспарланғандай, сол адамның кемесі алда.
Dialogue: 0,0:16:09.33,0:16:10.23,Default,,0,0,0,,Уху…
Dialogue: 0,0:16:10.30,0:16:11.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:11.23,0:16:12.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:14.70,0:16:15.64,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:16:15.70,0:16:17.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:18.01,0:16:20.01,Default,,0,0,0,,Бұл шабуыл алгоритмі...
Dialogue: 0,0:16:20.61,0:16:21.74,Default,,0,0,0,,Адам емес пе?
Dialogue: 0,0:16:22.01,0:16:22.68,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:23.21,0:16:24.08,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:16:24.38,0:16:25.38,Default,,0,0,0,,Кя!
Dialogue: 0,0:16:30.42,0:16:34.12,Default,,0,0,0,,Үйдің жертөлесінде электр қуатын тұтынатын үлкен қондырғы бар сияқты.
Dialogue: 0,0:16:34.42,0:16:35.69,Default,,0,0,0,,(Ge)
Dialogue: 0,0:16:36.36,0:16:37.39,Default,,0,0,0,,Бұл жерде.
Dialogue: 0,0:16:37.73,0:16:39.29,Default,,0,0,0,,Деректер жинауға барайық.
Dialogue: 0,0:16:45.50,0:16:46.37,Default,,0,0,0,,Не?
Dialogue: 0,0:16:46.67,0:16:48.37,Default,,0,0,0,,Хе-хе-хе
Dialogue: 0,0:16:48.67,0:16:50.10,Default,,0,0,0,,Мен сен демалыс үйін сатып аламыз дедің деп анық естідім.
Dialogue: 0,0:16:59.68,0:17:01.08,Default,,0,0,0,,Мініңіз
Dialogue: 0,0:17:02.08,0:17:03.25,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:17:05.35,0:17:06.35,Default,,0,0,0,,(лифттің келу дыбысы)
Dialogue: 0,0:17:12.36,0:17:13.69,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:17:25.64,0:17:27.34,Default,,0,0,0,,Хаа, міне
Dialogue: 0,0:17:29.34,0:17:30.28,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:17:31.15,0:17:32.71,Default,,0,0,0,,Джобу Тоджуро
Dialogue: 0,0:17:33.41,0:17:35.12,Default,,0,0,0,,Бұл жердің иесі.
Dialogue: 0,0:17:36.48,0:17:38.39,Default,,0,0,0,,Ол өлген жоқ па?
Dialogue: 0,0:17:38.72,0:17:41.09,Default,,0,0,0,,Бұл адам деректерінде де болды.
Dialogue: 0,0:17:41.62,0:17:44.22,Default,,0,0,0,,Жарайды... тірі болса ыңғайлы болар еді.
Dialogue: 0,0:17:44.29,0:17:47.29,Default,,0,0,0,,Маған дірілдеген оқтұмсықтың әзірлеу деректерін бере аласыз ба?
Dialogue: 0,0:17:47.80,0:17:49.36,Default,,0,0,0,,Дірілдейтін оқтұмсық
Dialogue: 0,0:17:50.10,0:17:51.13,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:51.47,0:17:54.64,Default,,0,0,0,,Ол қаруды жасаған мен емес едім.
Dialogue: 0,0:17:55.07,0:17:57.14,Default,,0,0,0,,Жоқ... нені айтасыз?
Dialogue: 0,0:17:58.21,0:17:59.24,Default,,0,0,0,,Маки?
Dialogue: 0,0:18:00.17,0:18:01.54,Default,,0,0,0,,Байқадыңыз ба?
Dialogue: 0,0:18:02.18,0:18:03.18,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:03.24,0:18:07.58,Default,,0,0,0,,Маки менікінен әлдеқайда жоғары қабілеттерге ие.
Dialogue: 0,0:18:07.65,0:18:08.52,Default,,0,0,0,,Ойласам, ол бәріне белгілі нәрсе ғой.
Dialogue: 0,0:18:10.85,0:18:13.52,Default,,0,0,0,,Өйткені ол бала адам емес.
Dialogue: 0,0:18:13.59,0:18:14.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:20.13,0:18:21.63,Default,,0,0,0,,Бір кездері I
Dialogue: 0,0:18:21.76,0:18:24.70,Default,,0,0,0,,Олар тұманға қарсы қару жасап жатты.
Dialogue: 0,0:18:26.23,0:18:27.30,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:18:27.60,0:18:30.47,Default,,0,0,0,,Бұл сәтсіздіктер мен сәтсіздіктер қатары болды.
Dialogue: 0,0:18:30.87,0:18:33.11,Default,,0,0,0,,Мен мұны сол кезде түсіндім.
Dialogue: 0,0:18:33.37,0:18:37.38,Default,,0,0,0,,Тұлға ретіндегі өз шектеулерім.
Dialogue: 0,0:18:37.78,0:18:41.48,Default,,0,0,0,,Мен жобаны бастадым
Dialogue: 0,0:18:43.22,0:18:45.35,Default,,0,0,0,,Адамдар мұны істей алмаса
Dialogue: 0,0:18:45.42,0:18:46.79,Default,,0,0,0,,Қол жеткізе алатындар
Dialogue: 0,0:18:47.19,0:18:52.13,Default,,0,0,0,,Бар болғаны табиғаттан тыс талантты адамды жасау керек...
Dialogue: 0,0:18:52.73,0:18:55.70,Default,,0,0,0,,Баланы жобалау арқылы жасалған өмірлер
Dialogue: 0,0:18:56.13,0:18:57.13,Default,,0,0,0,,109
Dialogue: 0,0:19:02.47,0:19:05.47,Default,,0,0,0,,Олардың ішінде 7 өсті.
Dialogue: 0,0:19:05.81,0:19:09.38,Default,,0,0,0,,Ал үш жылдан астам өмір сүргендер
Dialogue: 0,0:19:09.58,0:19:10.64,Default,,0,0,0,,１
Dialogue: 0,0:19:12.45,0:19:14.28,Default,,0,0,0,,Бұл Маки
Dialogue: 0,0:19:16.75,0:19:17.92,Default,,0,0,0,,Нәтижесінде
Dialogue: 0,0:19:18.35,0:19:21.66,Default,,0,0,0,,Маки мен күткеннен де көп нәрсеге қол жеткізді.
Dialogue: 0,0:19:22.39,0:19:25.39,Default,,0,0,0,,Бірақ мемлекет немқұрайлы қарады
Dialogue: 0,0:19:26.23,0:19:26.89,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:27.36,0:19:29.90,Default,,0,0,0,,Сол баланың күшінен қорықтым.
Dialogue: 0,0:19:30.53,0:19:32.30,Default,,0,0,0,,Тұман сияқты.
Dialogue: 0,0:19:33.33,0:19:36.50,Default,,0,0,0,,Бізді осы сарайға мәжбүр етті.
Dialogue: 0,0:19:36.57,0:19:39.51,Default,,0,0,0,,Үкімет бақылауында тірі қалу
Dialogue: 0,0:19:41.21,0:19:44.55,Default,,0,0,0,,Сіз баланың бос екенін айттыңыз.
Dialogue: 0,0:19:45.58,0:19:47.95,Default,,0,0,0,,Бөтен адамдармен байланысқа жол берілмейді
Dialogue: 0,0:19:48.28,0:19:51.65,Default,,0,0,0,,Мен өз жасымдағы бала сияқты өмір сүремін деп үміттене алмаймын.
Dialogue: 0,0:19:55.26,0:19:58.46,Default,,0,0,0,,Бірақ... Мен бәрібір бақытты болдым.
Dialogue: 0,0:20:01.70,0:20:04.87,Default,,0,0,0,,Әлгі бала күліп тұрғанша, жақсы.
Dialogue: 0,0:20:05.73,0:20:10.60,Default,,0,0,0,,Мен ол баланы қызымдай жақсы көрдім.
Dialogue: 0,0:20:11.31,0:20:11.97,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:12.87,0:20:15.88,Default,,0,0,0,,Бір күні үкімет маған бұйрық берді
Dialogue: 0,0:20:16.68,0:20:20.88,Default,,0,0,0,,Makie сақтық көшірмесін жасау үшін дизайн еншілесін жасау.
Dialogue: 0,0:20:21.65,0:20:24.92,Default,,0,0,0,,Олар ескі компьютерлерді де өңдейді.
Dialogue: 0,0:20:24.99,0:20:26.99,Default,,0,0,0,,Мен ол баланы кәдеге жаратуды шештім.
Dialogue: 0,0:20:28.66,0:20:29.52,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:20:30.69,0:20:33.23,Default,,0,0,0,,Жазатайым жағдайда өліп қалдым деп көрсету
Dialogue: 0,0:20:33.36,0:20:36.70,Default,,0,0,0,,Дизайн Баласының деректерімен бірге жоғалып кетті
Dialogue: 0,0:20:37.73,0:20:41.30,Default,,0,0,0,,Сол баланы бірегей ету
Dialogue: 0,0:20:42.37,0:20:44.47,Default,,0,0,0,,Дірілдейтін оқтұмсықты реттеуге арналған
Dialogue: 0,0:20:44.54,0:20:46.87,Default,,0,0,0,,Сол баланың күші бізге әлі керек.
Dialogue: 0,0:20:47.37,0:20:50.24,Default,,0,0,0,,Сондықтан баланы қорғайды.
Dialogue: 0,0:20:50.88,0:20:51.98,Default,,0,0,0,,​​Мен түсінбеймін.
Dialogue: 0,0:20:52.65,0:20:55.35,Default,,0,0,0,,Неге шынымен өлмедің?
Dialogue: 0,0:20:55.75,0:20:58.69,Default,,0,0,0,,Білсеңіз, жағдайыңыз одан да нашар болмай ма?
Dialogue: 0,0:20:58.82,0:21:01.42,Default,,0,0,0,,Оны созылу деп атайды.
Dialogue: 0,0:21:02.46,0:21:04.63,Default,,0,0,0,,өкініш
Dialogue: 0,0:21:04.86,0:21:06.39,Default,,0,0,0,,Сіз шеше алмайтын нәрселер
Dialogue: 0,0:21:06.69,0:21:07.73,Default,,0,0,0,,Тег қосымшасы
Dialogue: 0,0:21:07.96,0:21:08.90,Default,,0,0,0,,Классификация
Dialogue: 0,0:21:09.56,0:21:10.43,Default,,0,0,0,,Жазбалар
Dialogue: 0,0:21:10.50,0:21:12.43,Default,,0,0,0,,Сол баланың өсуі
Dialogue: 0,0:21:12.63,0:21:15.34,Default,,0,0,0,,Мен сенің күлкіңді бақылап отырғым келді
Dialogue: 0,0:21:15.74,0:21:19.67,Default,,0,0,0,,Адамдар өзімшіл сөздерді көп айтуға бейім.
Dialogue: 0,0:21:20.01,0:21:21.71,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:21:22.41,0:21:25.45,Default,,0,0,0,,Көріп тұрғаныңыздай, менің уақытым аз.
Dialogue: 0,0:21:25.91,0:21:28.92,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:21:30.02,0:21:32.02,Default,,0,0,0,,Өтініш дегеніміз не?
Dialogue: 0,0:21:32.62,0:21:35.79,Default,,0,0,0,,Макидің досы бол.
Dialogue: 0,0:21:36.76,0:21:38.63,Default,,0,0,0,,Ол шынымен өзімшіл.
Dialogue: 0,0:21:38.69,0:21:40.56,Default,,0,0,0,,Менің досым болшы, т.б.
Dialogue: 0,0:21:40.63,0:21:43.96,Default,,0,0,0,,Сіз менің тұманды психикалық модель екенімді білесіз бе?
Dialogue: 0,0:21:44.03,0:21:46.33,Default,,0,0,0,,Сізбен бірге болыңыз
Dialogue: 0,0:21:46.40,0:21:48.57,Default,,0,0,0,,Сол бала мені қатты күлдірді.
Dialogue: 0,0:21:48.90,0:21:50.57,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:21:51.87,0:21:52.81,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:21:57.04,0:21:58.61,Default,,0,0,0,,Хару Хару…
Dialogue: 0,0:22:05.62,0:22:06.55,Default,,0,0,0,,Маки
Dialogue: 0,0:22:07.32,0:22:08.32,Default,,0,0,0,,Жарай бер, жарай бер — сен ауаны тұншықтырып жатырсың, шетке жыл.
Dialogue: 0,0:22:21.80,0:22:23.80,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:22:24.07,0:22:25.34,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:22:25.67,0:22:28.58,Default,,0,0,0,,Психикалық модельмен байланысқа түскен бала
Dialogue: 0,0:22:28.64,0:22:30.68,Default,,0,0,0,,Мені жалғыз қалдыра аласыз ба?
Dialogue: 0,0:22:40.42,0:22:46.43,Default,,0,0,0,,♪～
Dialogue: 0,0:24:03.57,0:24:09.58,Default,,0,0,0,,～♪
