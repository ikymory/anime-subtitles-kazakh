Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:08.59,Default,,0,0,0,,Төрағаның жалғыз ұлы бар.
Dialogue: 0,0:00:09.42,0:00:13.05,Default,,0,0,0,,Бұл дүние маған жараспады, сондықтан мен үйден шықтым.
Dialogue: 0,0:00:13.26,0:00:15.84,Default,,0,0,0,,Сол кезде мен күйзеліске түскен кезде,
Dialogue: 0,0:00:16.30,0:00:17.60,Default,,0,0,0,,Хаа…
Dialogue: 0,0:00:18.56,0:00:22.56,Default,,0,0,0,,Ащылығыңыз ұқсас болуы мүмкін.
Dialogue: 0,0:00:23.39,0:00:29.40,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:21.08,0:01:27.08,Default,,0,0,0,,~♪
Dialogue: 0,0:01:35.17,0:01:36.09,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:01:36.84,0:01:39.09,Default,,0,0,0,,Халықаралық алаяқтық тобы?
Dialogue: 0,0:01:39.59,0:01:42.85,Default,,0,0,0,,Бұл реалити-шоу болса, одан да қызық болар еді.
Dialogue: 0,0:01:43.26,0:01:45.23,Default,,0,0,0,,Бва! Мен дәл тиетіндей едім...
Dialogue: 0,0:01:45.39,0:01:46.73,Default,,0,0,0,,Сіздің жазаңыз кейінірек келеді.
Dialogue: 0,0:01:46.85,0:01:47.69,Default,,0,0,0,,Иә
Dialogue: 0,0:01:47.98,0:01:51.44,Default,,0,0,0,,Ең алдымен сізге рахмет Оз.
Dialogue: 0,0:01:51.56,0:01:52.40,Default,,0,0,0,,Га
Dialogue: 0,0:01:55.49,0:01:57.82,Default,,0,0,0,,Ал, жарайды, ханшайыммен, т.б.
Dialogue: 0,0:01:59.57,0:02:02.91,Default,,0,0,0,,Өмірің үшін жалбарынатын болсаң, бұл туралы ойланудың қажеті жоқ.
Dialogue: 0,0:02:03.03,0:02:06.29,Default,,0,0,0,,Өмірді қаласаң, ойлану керек.
Dialogue: 0,0:02:06.83,0:02:08.04,Default,,0,0,0,,<Тез өлтіру>
Dialogue: 0,0:02:08.37,0:02:09.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:09.42,0:02:11.13,Default,,0,0,0,,«Мені тез өлтір»
Dialogue: 0,0:02:11.25,0:02:13.13,Default,,0,0,0,,Қандай қызықсыз бала.
Dialogue: 0,0:02:17.80,0:02:19.13,Default,,0,0,0,,Сіз қозғалмайсыз
Dialogue: 0,0:02:19.84,0:02:22.30,Default,,0,0,0,,<Әтірді өзгерту>
Dialogue: 0,0:02:22.51,0:02:24.35,Default,,0,0,0,,〈Мұны өзің де білмейсің〉
Dialogue: 0,0:02:24.47,0:02:25.93,Default,,0,0,0,,<Сен қарт адам сияқтысың>
Dialogue: 0,0:02:28.10,0:02:30.48,Default,,0,0,0,,Қалай айтасың...
Dialogue: 0,0:02:31.06,0:02:33.73,Default,,0,0,0,,Айтпа, бос сөз ғой
Dialogue: 0,0:02:34.40,0:02:37.24,Default,,0,0,0,,Енді мен сені не істеймін?
Dialogue: 0,0:02:37.36,0:02:40.57,Default,,0,0,0,,Әкем маған көмектесуімді сұрайды.
Dialogue: 0,0:02:41.03,0:02:44.58,Default,,0,0,0,,Мен тым шыншылмын, бірақ сізге пайдалы болатынына сенімдімін.
Dialogue: 0,0:02:44.83,0:02:47.04,Default,,0,0,0,,Ал, сіз қалай ойлайсыз?
Dialogue: 0,0:02:51.25,0:02:54.67,Default,,0,0,0,,Маған жеңіл жақындаудың нәтижесінде, бұл нәтиже.
Dialogue: 0,0:02:54.79,0:02:56.00,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:02:56.13,0:02:57.67,Default,,0,0,0,,Президентке шынайылық көрсетіңіз
Dialogue: 0,0:02:58.26,0:03:00.01,Default,,0,0,0,,Сол екеуінен құтыласың.
Dialogue: 0,0:03:00.55,0:03:01.97,Default,,0,0,0,,Өлсем де істеймін!
Dialogue: 0,0:03:02.09,0:03:03.51,Default,,0,0,0,,Жетер, едамаме
Dialogue: 0,0:03:04.14,0:03:07.18,Default,,0,0,0,,Сәтсіздікке ұшырағандарды тастаңыз, солай емес пе?
Dialogue: 0,0:03:07.31,0:03:08.93,Default,,0,0,0,,Сіз сәтсіздікке ұшырадыңыз.
Dialogue: 0,0:03:09.31,0:03:10.64,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:03:10.77,0:03:14.11,Default,,0,0,0,,Ең соңғысы жақсы болған адам аман қалады.
Dialogue: 0,0:03:14.23,0:03:15.32,Default,,0,0,0,,Мені тез өлтір
Dialogue: 0,0:03:15.90,0:03:16.98,Default,,0,0,0,,Эбби
Dialogue: 0,0:03:17.11,0:03:20.49,Default,,0,0,0,,Мен сенің орнында болсам, сені баяғыда өлтірер едім.
Dialogue: 0,0:03:21.20,0:03:22.49,Default,,0,0,0,,Тым күшті болмаңыз
Dialogue: 0,0:03:23.91,0:03:25.33,Default,,0,0,0,,Сен мені өлтіре де алмайсың.
Dialogue: 0,0:03:26.83,0:03:28.91,Default,,0,0,0,,Біз дос емеспіз
Dialogue: 0,0:03:29.75,0:03:32.37,Default,,0,0,0,,Достар немесе отбасы емес.
Dialogue: 0,0:03:33.63,0:03:35.63,Default,,0,0,0,,Балалар, сендерді ренжіту үшін
Dialogue: 0,0:03:35.92,0:03:37.59,Default,,0,0,0,,Мен мұны істей алмаймын ...
Dialogue: 0,0:03:37.71,0:03:38.67,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:38.88,0:03:39.71,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:50.39,0:03:52.77,Default,,0,0,0,,（）
Dialogue: 0,0:03:54.35,0:03:55.27,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:03:55.61,0:03:59.07,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:03:59.19,0:04:00.69,Default,,0,0,0,,Фуфуфу…
Dialogue: 0,0:04:00.94,0:04:03.61,Default,,0,0,0,,Балаларының бөксесін сүртуге ата-ана жауапты...
Dialogue: 0,0:04:03.82,0:04:04.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:04.99,0:04:06.87,Default,,0,0,0,,Эй, Эдамура, тоқта! Апыр-ай!
Dialogue: 0,0:04:06.99,0:04:09.08,Default,,0,0,0,,Мен сені өлтіремін! Жіберу! (Ишигами) Эдамура!
Dialogue: 0,0:04:09.20,0:04:11.33,Default,,0,0,0,,Тек тыныш бол! Жолдан кет! Қат!
Dialogue: 0,0:04:11.45,0:04:13.08,Default,,0,0,0,,Көрінбейтін жерлерді тастаңыз!
Dialogue: 0,0:04:13.21,0:04:16.75,Default,,0,0,0,,Бұл үшін Масатоны кешіріңіз.
Dialogue: 0,0:04:17.21,0:04:18.59,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:04:18.71,0:04:19.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:20.00,0:04:22.47,Default,,0,0,0,,Шанхайдағы бұл адамдар шынымен жабайы адамдар.
Dialogue: 0,0:04:22.59,0:04:23.42,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:04:23.97,0:04:26.34,Default,,0,0,0,,Сіз Эдамураны жек көресіз бе? а?
Dialogue: 0,0:04:26.72,0:04:29.14,Default,,0,0,0,,Достарымды аяймын.
Dialogue: 0,0:04:29.26,0:04:32.48,Default,,0,0,0,,Мен сіз үшін маңызды адамды жоғалту қаншалықты ауыр екенін білемін.
Dialogue: 0,0:04:33.27,0:04:36.52,Default,,0,0,0,,Ең болмаса жұбаныш болар. Сіз ол адамды сүйе аласыз.
Dialogue: 0,0:04:36.65,0:04:37.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:37.94,0:04:41.40,Default,,0,0,0,,Әлде... Төраға, бұл тым көп әзіл.
Dialogue: 0,0:04:41.90,0:04:45.66,Default,,0,0,0,,Қараңдаршы, бүгін де ақпарат бердіңіздер.
Dialogue: 0,0:04:45.78,0:04:46.66,Default,,0,0,0,,Иә
Dialogue: 0,0:04:46.99,0:04:51.37,Default,,0,0,0,,Қайтып келуге рұқсат етсем, Шанхайда жағдай бұдан да жақсы болады.
Dialogue: 0,0:04:51.74,0:04:56.42,Default,,0,0,0,,Махаббат бітті. Мистер Оз, бұл сізге.
Dialogue: 0,0:04:57.21,0:05:01.05,Default,,0,0,0,,Лю үндемейді. Сіз Шанхаймен соғысуды жоспарлап отырсыз ба?
Dialogue: 0,0:05:01.25,0:05:05.93,Default,,0,0,0,,Ой... Жоғалып кетсең соғыс бола ма?
Dialogue: 0,0:05:06.68,0:05:08.01,Default,,0,0,0,,Ол бақытты жігіт.
Dialogue: 0,0:05:08.14,0:05:10.93,Default,,0,0,0,,Бұл дүниеден жоғалып кетсең де, ештеңе өзгермейді.
Dialogue: 0,0:05:11.72,0:05:13.10,Default,,0,0,0,,Мені жіберіңізші
Dialogue: 0,0:05:22.03,0:05:23.99,Default,,0,0,0,,Масато, сабыр ет.
Dialogue: 0,0:05:25.03,0:05:27.45,Default,,0,0,0,,Мен сені және анамды жақсы көрдім.
Dialogue: 0,0:05:27.57,0:05:29.32,Default,,0,0,0,,Әрине, қазір де.
Dialogue: 0,0:05:30.03,0:05:33.70,Default,,0,0,0,,Қараңызшы, сіз әкеңізден кінәлі болғаныңыз үшін кешірім сұрайсыз, солай ма?
Dialogue: 0,0:05:34.16,0:05:37.75,Default,,0,0,0,,Бұрынғы алаяқтар да дос емеспіз деді.
Dialogue: 0,0:05:38.25,0:05:39.83,Default,,0,0,0,,Менің таңдауым болмады.
Dialogue: 0,0:05:39.96,0:05:42.25,Default,,0,0,0,,Шанхайдағы ұйымға кіруден басқа амалым қалмады...
Dialogue: 0,0:05:42.55,0:05:44.13,Default,,0,0,0,,Енді мылтықты қойыңыз.
Dialogue: 0,0:05:45.05,0:05:47.38,Default,,0,0,0,,Маған сеніңіз, өтінемін!
Dialogue: 0,0:05:49.09,0:05:50.89,Default,,0,0,0,,«Әрқашан дұрыс бол»
Dialogue: 0,0:05:51.30,0:05:53.14,Default,,0,0,0,,«Әлемге пайдалы болу»
Dialogue: 0,0:05:53.68,0:05:56.89,Default,,0,0,0,,«Өзгелер сыйлайтын адам бол»
Dialogue: 0,0:05:59.15,0:06:00.61,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:00.81,0:06:01.77,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:04.32,0:06:05.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:08.78,0:06:10.11,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:06:27.88,0:06:28.72,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:28.84,0:06:30.51,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:06:31.93,0:06:36.22,Default,,0,0,0,,Содан бері үш күн бойы ештеңе айтпадым.
Dialogue: 0,0:06:36.35,0:06:39.06,Default,,0,0,0,,Мен әртүрлі нәрселерді қолданып көрдім, бірақ...
Dialogue: 0,0:06:40.10,0:06:41.73,Default,,0,0,0,,Бізді жайына қалдырыңыз.
Dialogue: 0,0:06:41.85,0:06:42.69,Default,,0,0,0,,Га
Dialogue: 0,0:06:43.19,0:06:45.78,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:06:57.83,0:06:59.29,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:59.50,0:07:01.37,Default,,0,0,0,,Гехо Гехо...
Dialogue: 0,0:07:02.13,0:07:02.96,Default,,0,0,0,,Ах
Dialogue: 0,0:07:03.38,0:07:05.21,Default,,0,0,0,,Гехо Гехо...
Dialogue: 0,0:07:05.80,0:07:08.76,Default,,0,0,0,,Масато Қатты болған болуы керек.
Dialogue: 0,0:07:08.88,0:07:12.68,Default,,0,0,0,,Баяу, өз қарқыныңызбен тамақтаныңыз.
Dialogue: 0,0:07:12.97,0:07:14.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:25.98,0:07:27.69,Default,,0,0,0,,(сорпаның шырылдаған дыбысы)
Dialogue: 0,0:07:27.94,0:07:32.61,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:07:32.74,0:07:34.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:35.91,0:07:37.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:38.04,0:07:42.04,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:07:57.31,0:07:58.56,Default,,0,0,0,,Мен кофе алдым.
Dialogue: 0,0:08:09.19,0:08:11.24,Default,,0,0,0,,Саған сүт әкелгенімді қалайсың ба?
Dialogue: 0,0:08:11.40,0:08:13.99,Default,,0,0,0,,Жоқ, одан да көп, Масато.
Dialogue: 0,0:08:14.11,0:08:16.82,Default,,0,0,0,,Сіздің аукцион үйінде жұмыс істегеніңізді естідім.
Dialogue: 0,0:08:16.95,0:08:18.16,Default,,0,0,0,,Иә, Лондонда
Dialogue: 0,0:08:18.62,0:08:21.62,Default,,0,0,0,,Бүгін айналдыра аласыз ба?
Dialogue: 0,0:08:21.75,0:08:22.58,Default,,0,0,0,,Иә
Dialogue: 0,0:08:32.47,0:08:34.30,Default,,0,0,0,,Сіз тікұшақтарға үйреніп қалдыңыз ба?
Dialogue: 0,0:08:34.43,0:08:36.59,Default,,0,0,0,,Мен төмен қарамауға тырысамын.
Dialogue: 0,0:08:39.31,0:08:40.85,Default,,0,0,0,,Ум... иә?
Dialogue: 0,0:08:41.47,0:08:42.85,Default,,0,0,0,,Қолдар жақсы ма?
Dialogue: 0,0:08:42.98,0:08:43.85,Default,,0,0,0,,Hand?
Dialogue: 0,0:08:43.98,0:08:45.69,Default,,0,0,0,,Алақаныңызға қараңыз
Dialogue: 0,0:08:46.73,0:08:47.86,Default,,0,0,0,,Аралау
Dialogue: 0,0:08:47.98,0:08:49.44,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:50.94,0:08:53.57,Default,,0,0,0,,Саған осындай нәрсе ұнай ма деп сұрадым.
Dialogue: 0,0:08:55.45,0:08:57.66,Default,,0,0,0,,Менмендік жасағаным үшін кешірім сұраймын.
Dialogue: 0,0:08:58.66,0:09:00.54,Default,,0,0,0,,Мен анамды жақсы көретінмін.
Dialogue: 0,0:09:06.37,0:09:08.46,Default,,0,0,0,,Шанхайдан келген агари бар ма?
Dialogue: 0,0:09:08.58,0:09:11.17,Default,,0,0,0,,Жоқ, ештеңе хаха...
Dialogue: 0,0:09:11.30,0:09:15.13,Default,,0,0,0,,Бейне қоңырауды пайдаланып, Люмен тікелей сөйлесетін уақыт келді...
Dialogue: 0,0:09:15.26,0:09:17.76,Default,,0,0,0,,Әр кезде айтпа, ойланып жүрмін
Dialogue: 0,0:09:17.89,0:09:19.35,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:09:19.47,0:09:21.81,Default,,0,0,0,,Масато қатты
Dialogue: 0,0:09:21.93,0:09:22.77,Default,,0,0,0,,Иә
Dialogue: 0,0:09:25.98,0:09:27.98,Default,,0,0,0,,Күлімсіреу Дэйб Күлімсіреу
Dialogue: 0,0:09:28.10,0:09:29.02,Default,,0,0,0,,Күлімсіре!
Dialogue: 0,0:09:29.73,0:09:31.52,Default,,0,0,0,,Мені қайта-қайта айтуға мәжбүрлеме
Dialogue: 0,0:09:31.65,0:09:34.03,Default,,0,0,0,,Күлімсіреу және позинг Осыны есте сақтаңыз!
Dialogue: 0,0:09:34.90,0:09:38.03,Default,,0,0,0,,Егер сізден жақсы тұтынушы сатып алса, сіздің өміріңізде ешқандай проблема болмайды.
Dialogue: 0,0:09:38.57,0:09:41.95,Default,,0,0,0,,Таңдауыңыз жоқ, назарыңызды өнімге аударыңыз.
Dialogue: 0,0:09:42.99,0:09:46.04,Default,,0,0,0,,<Кейінгі жазба №3>
Dialogue: 0,0:09:46.37,0:09:49.21,Default,,0,0,0,,<Кавин, 15 жаста, Тайландтан>
Dialogue: 0,0:09:49.33,0:09:51.63,Default,,0,0,0,,〈Жіңішке, бірақ аяқ-қолы ұзын және тепе-теңдігі жақсы〉
Dialogue: 0,0:09:52.84,0:09:55.26,Default,,0,0,0,,〈Тыныш және байсалды тұлға〉
Dialogue: 0,0:09:55.38,0:09:57.72,Default,,0,0,0,,<Шешімді қайсарлықпен орындаймын>
Dialogue: 0,0:09:58.26,0:10:00.93,Default,,0,0,0,,〈Үйрену оңай және үйрену пайдалы〉
Dialogue: 0,0:10:01.05,0:10:03.22,Default,,0,0,0,,<2 миллион иенден>
Dialogue: 0,0:10:04.02,0:10:04.85,Default,,0,0,0,,〈300〉
Dialogue: 0,0:10:05.64,0:10:06.48,Default,,0,0,0,,〈400〉
Dialogue: 0,0:10:07.48,0:10:08.81,Default,,0,0,0,,〈450〉
Dialogue: 0,0:10:09.06,0:10:10.02,Default,,0,0,0,,<480>
Dialogue: 0,0:10:10.98,0:10:12.65,Default,,0,0,0,,〈Енді Кавиннің болашағы шешіледі...〉
Dialogue: 0,0:10:12.77,0:10:14.98,Default,,0,0,0,,〈Ой, 5 миллион иен! 〉
Dialogue: 0,0:10:16.15,0:10:18.28,Default,,0,0,0,,〈Келіңіздер! Тағы бар ма? 〉
Dialogue: 0,0:10:18.65,0:10:20.28,Default,,0,0,0,,<Бұл жерде шешілді, жарай ма? 〉
Dialogue: 0,0:10:20.49,0:10:22.66,Default,,0,0,0,,〈Тендер сәтті өтті! Құттықтаймыз〉
Dialogue: 0,0:10:22.78,0:10:23.62,Default,,0,0,0,,Хаха
Dialogue: 0,0:10:23.74,0:10:26.00,Default,,0,0,0,,<Жалғастырайық>
Dialogue: 0,0:10:26.12,0:10:29.00,Default,,0,0,0,,<Кіру нөмірі 4 Нина 13 жаста>
Dialogue: 0,0:10:29.12,0:10:31.46,Default,,0,0,0,,<Үндістан, жұмбақ әсерлі сұлу әйел>
Dialogue: 0,0:10:31.58,0:10:33.79,Default,,0,0,0,,<Тұлға қарапайым және мойынсұнғыш>
Dialogue: 0,0:10:33.92,0:10:35.71,Default,,0,0,0,,<5 миллион иенден>
Dialogue: 0,0:10:35.84,0:10:37.72,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:10:39.05,0:10:41.39,Default,,0,0,0,,Шамамен айтқанда, бұл 70 миллионнан аз.
Dialogue: 0,0:10:41.51,0:10:44.68,Default,,0,0,0,,Иә! Бізде мұндай сатылымдар болғанына біраз болды.
Dialogue: 0,0:10:44.81,0:10:47.64,Default,,0,0,0,,Мен сауда-саттықты бұдан былай Масатоға қалдырамын.
Dialogue: 0,0:10:47.81,0:10:48.64,Default,,0,0,0,,Иә
Dialogue: 0,0:10:48.77,0:10:52.69,Default,,0,0,0,,Ал мен саған үйімнен бөлме дайындап берейін.
Dialogue: 0,0:10:52.81,0:10:54.44,Default,,0,0,0,,Жақсы жерден кесіп өтіңіз
Dialogue: 0,0:10:54.86,0:10:57.15,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:10:59.57,0:11:01.66,Default,,0,0,0,,Сен менің ұлыма ұқсайсың ба?
Dialogue: 0,0:11:02.49,0:11:04.24,Default,,0,0,0,,Жоқ, бұл осылай
Dialogue: 0,0:11:04.37,0:11:07.41,Default,,0,0,0,,Қысым, дәлірек айтсақ, қысым керемет.
Dialogue: 0,0:11:07.79,0:11:08.75,Default,,0,0,0,,Мен ешқашан өмір сүремін деп ойламадым...
Dialogue: 0,0:11:08.87,0:11:11.08,Default,,0,0,0,,Қысым - бұл марапат! а?
Dialogue: 0,0:11:11.21,0:11:12.50,Default,,0,0,0,,Мен... Исигами мырза
Dialogue: 0,0:11:12.71,0:11:15.46,Default,,0,0,0,,Соңғы төрағаға не болды?
Dialogue: 0,0:11:15.59,0:11:17.21,Default,,0,0,0,,Сіз туралы
Dialogue: 0,0:11:17.34,0:11:18.17,Default,,0,0,0,,Ах
Dialogue: 0,0:11:19.30,0:11:22.01,Default,,0,0,0,,Хаа... кешіріңіз.
Dialogue: 0,0:11:22.26,0:11:23.76,Default,,0,0,0,,Көлікте сөйлесейік
Dialogue: 0,0:11:25.05,0:11:27.64,Default,,0,0,0,,Шанхайдағы Чен есіңде ме?
Dialogue: 0,0:11:27.81,0:11:28.64,Default,,0,0,0,,Иә
Dialogue: 0,0:11:28.77,0:11:31.64,Default,,0,0,0,,Бұл кезде төрағаның рухы басым болатын.
Dialogue: 0,0:11:31.77,0:11:34.56,Default,,0,0,0,,Мен сынға ұшыраған соң шегінетін адам емеспін.
Dialogue: 0,0:11:34.69,0:11:36.77,Default,,0,0,0,,Мен мұны жақын арада орындайтынына сенімдімін.
Dialogue: 0,0:11:36.90,0:11:39.32,Default,,0,0,0,,Мен бұл болмай тұрып бірдеңе істегім келеді.
Dialogue: 0,0:11:39.86,0:11:40.69,Default,,0,0,0,,О
Dialogue: 0,0:11:41.32,0:11:44.12,Default,,0,0,0,,Төрағаны сол жігіттерден қорғаңыз.
Dialogue: 0,0:11:44.62,0:11:46.45,Default,,0,0,0,,Төрағаны қорғаңыз
Dialogue: 0,0:11:56.59,0:11:57.96,Default,,0,0,0,,Сіз жоғарылатылған сияқтысыз.
Dialogue: 0,0:12:02.05,0:12:03.47,Default,,0,0,0,,Кішкене сөйлесейік
Dialogue: 0,0:12:04.30,0:12:07.18,Default,,0,0,0,,Жоқ, бұл ұзақ әңгіме.
Dialogue: 0,0:12:16.81,0:12:19.02,Default,,0,0,0,,Бұл әйелдің Қанды Пері Шығармасы ма?
Dialogue: 0,0:12:19.78,0:12:21.32,Default,,0,0,0,,Сот ~
Dialogue: 0,0:12:21.44,0:12:22.82,Default,,0,0,0,,Хаа~
Dialogue: 0,0:12:23.53,0:12:25.49,Default,,0,0,0,,Хмм хмм хмм
Dialogue: 0,0:12:26.95,0:12:27.99,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:12:29.95,0:12:31.58,Default,,0,0,0,,<Оның қайда екенін білдіңіз бе? 〉
Dialogue: 0,0:12:31.70,0:12:35.42,Default,,0,0,0,,〈Енді, сенің осында оралғаныңа сенімдімін.〉
Dialogue: 0,0:12:35.88,0:12:39.55,Default,,0,0,0,,<Хаа... Неге сол жерде тексермедің? 〉
Dialogue: 0,0:12:39.67,0:12:41.63,Default,,0,0,0,,<Мазасыз>
Dialogue: 0,0:12:42.26,0:12:44.68,Default,,0,0,0,,〈...жалғыз аудармашы жоғалып кетті〉
Dialogue: 0,0:12:44.80,0:12:45.93,Default,,0,0,0,,<Бұл маңызды емес, солай емес пе?>
Dialogue: 0,0:12:46.80,0:12:48.51,Default,,0,0,0,,<Міне, сен ақымақсың...>
Dialogue: 0,0:12:48.80,0:12:49.64,Default,,0,0,0,,〈Не? 〉
Dialogue: 0,0:12:49.76,0:12:51.22,Default,,0,0,0,,<Біраз уақыт бұрын...>
Dialogue: 0,0:12:51.35,0:12:55.35,Default,,0,0,0,,〈Мен байлығымды айту үшін шетелдегі танымал инстаграммерге қоңырау шалдым〉
Dialogue: 0,0:12:55.64,0:12:57.40,Default,,0,0,0,,〈Тамаша хит сияқты〉
Dialogue: 0,0:12:57.69,0:12:58.86,Default,,0,0,0,,<Егер жеңгіңіз келсе>
Dialogue: 0,0:12:58.98,0:13:01.90,Default,,0,0,0,,〈Қазір мұндай уақыт жоқ сияқты.〉
Dialogue: 0,0:13:02.03,0:13:03.94,Default,,0,0,0,,〈Сіз нені айтып тұрсыз? 〉
Dialogue: 0,0:13:04.07,0:13:05.36,Default,,0,0,0,,〈Уақыт жетті〉
Dialogue: 0,0:13:05.49,0:13:06.36,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:13:06.86,0:13:09.37,Default,,0,0,0,,<Алайда бір мәселе бар>
Dialogue: 0,0:13:09.49,0:13:10.33,Default,,0,0,0,,<Мәселе? 〉
Dialogue: 0,0:13:11.24,0:13:12.87,Default,,0,0,0,,<Сен Мишиманы білесің бе? 〉
Dialogue: 0,0:13:13.00,0:13:16.04,Default,,0,0,0,,Не? Жоқ, бұл одан да көп мәселе.
Dialogue: 0,0:13:16.58,0:13:19.08,Default,,0,0,0,,<Юкио Мишима - жапон жазушысы>
Dialogue: 0,0:13:19.21,0:13:23.96,Default,,0,0,0,,〈Ол әдебиет бойынша Нобель сыйлығын алған Азиядағы алғашқы адам ретінде қарастырылды〉
Dialogue: 0,0:13:24.13,0:13:27.93,Default,,0,0,0,,(Алайда, марапат менің ағам Ясунари Кавабатаға берілді.)
Dialogue: 0,0:13:28.05,0:13:30.30,Default,,0,0,0,,<Екеуінің айырмашылығы неде деп ойлайсыңдар? 〉
Dialogue: 0,0:13:30.72,0:13:34.06,Default,,0,0,0,,<Ах~ Кавабата ақшаны жүктеді ме? 〉
Dialogue: 0,0:13:34.18,0:13:36.85,Default,,0,0,0,,<Бұл басқа аударма>
Dialogue: 0,0:13:36.98,0:13:38.15,Default,,0,0,0,,(Бір теория бойынша)
Dialogue: 0,0:13:38.27,0:13:41.32,Default,,0,0,0,,〈Кавабата шығармасының аудармашысы жақсырақ болған сияқты〉
Dialogue: 0,0:13:41.44,0:13:43.28,Default,,0,0,0,,〈Не? Солай ма?〉
Dialogue: 0,0:13:44.11,0:13:49.16,Default,,0,0,0,,<Шетелде соғысқанда тілдік кедергі күткеннен жоғары>
Dialogue: 0,0:13:49.32,0:13:52.12,Default,,0,0,0,,〈Әңгіменің кішігірім нюанстарынан〉
Dialogue: 0,0:13:52.24,0:13:53.74,Default,,0,0,0,,<Жүректің нәзік сырларын оқу>
Dialogue: 0,0:13:53.87,0:13:57.54,Default,,0,0,0,,<Тілді таңдау және динамика арқылы қарсыласты шайқаңыз>
Dialogue: 0,0:13:58.33,0:14:00.71,Default,,0,0,0,,<Осы мен қалайтын аудармашы>
Dialogue: 0,0:14:01.13,0:14:04.80,Default,,0,0,0,,〈Аудармашы – нағыз келіссөздер жүргізушісі.〉
Dialogue: 0,0:14:04.92,0:14:07.05,Default,,0,0,0,,<Бұл жай ғана аударма қолданбасының мәселесі емес>
Dialogue: 0,0:14:07.47,0:14:09.22,Default,,0,0,0,,<Сіз түсінесіз бе? 〉
Dialogue: 0,0:14:09.47,0:14:12.64,Default,,0,0,0,,〈Озды жоғалтуымыздың мәні〉
Dialogue: 0,0:14:12.85,0:14:14.06,Default,,0,0,0,,〈Әйтеуір〉
Dialogue: 0,0:14:14.18,0:14:15.35,Default,,0,0,0,,〈Басқаша айтқанда〉
Dialogue: 0,0:14:15.47,0:14:20.48,Default,,0,0,0,,Егер сізде сенімді аудармашы болмаса, келіссөзді қалай тиімді түрде алға жылжытуға болады? 〉
Dialogue: 0,0:14:20.60,0:14:22.06,Default,,0,0,0,,<Мүмкін емес>
Dialogue: 0,0:14:22.19,0:14:24.69,Default,,0,0,0,,〈Жарайды, мен таныстарымнан сұрайын.〉
Dialogue: 0,0:14:27.40,0:14:28.74,Default,,0,0,0,,Ахх
Dialogue: 0,0:14:28.86,0:14:29.70,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:30.03,0:14:30.99,Default,,0,0,0,,Кай, тыңдашы
Dialogue: 0,0:14:31.74,0:14:33.74,Default,,0,0,0,,Мен құтқарылдым (оңай адам) Пепе Пепе...
Dialogue: 0,0:14:33.87,0:14:35.37,Default,,0,0,0,,Осы туралы
Dialogue: 0,0:14:35.49,0:14:36.95,Default,,0,0,0,,Сіз де тамақтанғыңыз келе ме?
Dialogue: 0,0:14:37.20,0:14:39.21,Default,,0,0,0,,Менің талғамыма сай емес
Dialogue: 0,0:14:39.46,0:14:41.54,Default,,0,0,0,,Кел, Дарко-чан...
Dialogue: 0,0:14:41.67,0:14:44.67,Default,,0,0,0,,Менің тәтті балыма бірдеңе сатып алуым керек пе?
Dialogue: 0,0:14:44.80,0:14:48.01,Default,,0,0,0,,Қалған екеуіне... Мынаны алып тастай аламын ба?
Dialogue: 0,0:14:48.13,0:14:50.09,Default,,0,0,0,,Уф... О!
Dialogue: 0,0:14:54.60,0:14:55.43,Default,,0,0,0,,(Чак!)
Dialogue: 0,0:15:03.40,0:15:05.40,Default,,0,0,0,,〈Қайда бара жатырсың? 〉
Dialogue: 0,0:15:05.86,0:15:06.69,Default,,0,0,0,,〈А, бұл...〉
Dialogue: 0,0:15:07.19,0:15:08.65,Default,,0,0,0,,〈Қай жолмен? 〉
Dialogue: 0,0:15:08.78,0:15:10.03,Default,,0,0,0,,<Мен бастықты көруге келдім>
Dialogue: 0,0:15:10.15,0:15:10.99,Default,,0,0,0,,<Бастық? 〉
Dialogue: 0,0:15:11.53,0:15:13.37,Default,,0,0,0,,<Мен маджонг ойнауды ойлап жүрмін.>
Dialogue: 0,0:15:13.49,0:15:15.53,Default,,0,0,0,,<Егер сен ақымақтық айтсаң, мен сені өлтіремін>
Dialogue: 0,0:15:15.99,0:15:17.08,Default,,0,0,0,,〈Кешіріңіз〉
Dialogue: 0,0:15:17.54,0:15:20.79,Default,,0,0,0,,〈Люге «Лорен келді» деп айта аласыз ба? 〉
Dialogue: 0,0:15:25.21,0:15:28.38,Default,,0,0,0,,Бір кездері Брюссельде, Бельгияда
Dialogue: 0,0:15:28.51,0:15:31.84,Default,,0,0,0,,Анасымен бақытты өмір сүрген бір бала болды.
Dialogue: 0,0:15:37.64,0:15:40.35,Default,,0,0,0,,О, бұл керемет емес пе?
Dialogue: 0,0:15:40.48,0:15:42.52,Default,,0,0,0,,Бүгін не оқып жатырсың?
Dialogue: 0,0:15:42.65,0:15:44.77,Default,,0,0,0,,Математика, ағылшын және қытай тілдері
Dialogue: 0,0:15:44.90,0:15:48.69,Default,,0,0,0,,Хехе, олай оқу ақша таппайды.
Dialogue: 0,0:15:48.82,0:15:51.20,Default,,0,0,0,,Иә, айтыңыз.
Dialogue: 0,0:15:51.32,0:15:53.74,Default,,0,0,0,,Мен дүкенде көмектеспеймін, тек сабақ оқимын.
Dialogue: 0,0:15:53.86,0:15:55.66,Default,,0,0,0,,Себебі, егер сіз жоғарылатылып, керемет болсаңыз,
Dialogue: 0,0:15:55.78,0:15:58.74,Default,,0,0,0,,Бұл дүкенде көмектескеннен әлдеқайда тиімді.
Dialogue: 0,0:15:58.87,0:16:00.08,Default,,0,0,0,,Бұл тиімді.
Dialogue: 0,0:16:00.20,0:16:03.25,Default,,0,0,0,,Олай айтсаң, есеймейсің.
Dialogue: 0,0:16:03.71,0:16:05.83,Default,,0,0,0,,Мен болашақта қандай бола аламын?
Dialogue: 0,0:16:05.96,0:16:06.79,Default,,0,0,0,,Дипломат
Dialogue: 0,0:16:07.13,0:16:09.96,Default,,0,0,0,,Ей, жігіт болсаң, футболшысың.
Dialogue: 0,0:16:10.09,0:16:11.22,Default,,0,0,0,,It's okay.
Dialogue: 0,0:16:11.34,0:16:13.80,Default,,0,0,0,,Осы уақытқа дейін аянбай еңбек еткен анама.
Dialogue: 0,0:16:14.26,0:16:16.18,Default,,0,0,0,,Мен сендерге әртүрлі елдерді көрсетемін.
Dialogue: 0,0:16:16.30,0:16:18.01,Default,,0,0,0,,Хмм, әрине.
Dialogue: 0,0:16:18.14,0:16:21.23,Default,,0,0,0,,Тақуалық Тақуалық Қаласаң ата-анаң жоқ
Dialogue: 0,0:16:21.35,0:16:23.31,Default,,0,0,0,,Хахахаха Одан да көп
Dialogue: 0,0:16:23.44,0:16:25.85,Default,,0,0,0,,Мен сіздің қазіргі өміріңіз туралы бірдеңе жасағаныңызды қалаймын.
Dialogue: 0,0:16:26.36,0:16:28.27,Default,,0,0,0,,Кішкене шыдамдылық.
Dialogue: 0,0:16:28.40,0:16:30.07,Default,,0,0,0,,Мен сізге міндетті түрде жеңілдетемін.
Dialogue: 0,0:16:30.23,0:16:34.03,Default,,0,0,0,,Керісінше, қазір бар күшіңізді салып, көп жұмыс істеңіз.
Dialogue: 0,0:16:35.28,0:16:37.99,Default,,0,0,0,,Сіз өте жақсы сөйлейсіз.
Dialogue: 0,0:16:38.12,0:16:40.08,Default,,0,0,0,,Эххе Рори
Dialogue: 0,0:16:42.04,0:16:44.46,Default,,0,0,0,,Бұл түсініктеме үшін.
Dialogue: 0,0:16:44.58,0:16:45.42,Default,,0,0,0,,Сұрақтар?
Dialogue: 0,0:16:45.67,0:16:48.46,Default,,0,0,0,,Жарайды, бәрі үшін кешірім сұраймын.
Dialogue: 0,0:16:48.59,0:16:49.42,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:49.55,0:16:53.13,Default,,0,0,0,,Дислексия ұялатын ештеңе емес.
Dialogue: 0,0:16:53.55,0:16:57.22,Default,,0,0,0,,Сіз ұлыңыздың болашағына осылай инвестиция салуға қалай батылыңыз бар?
Dialogue: 0,0:16:57.34,0:16:58.55,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:16:59.05,0:17:03.06,Default,,0,0,0,,Лори! сенің анаң өте керемет адам
Dialogue: 0,0:17:03.18,0:17:05.27,Default,,0,0,0,,Мен сізге дұрыс көмектесемін.
Dialogue: 0,0:17:05.77,0:17:07.60,Default,,0,0,0,,Онда қайда жазуым керек...
Dialogue: 0,0:17:07.73,0:17:10.11,Default,,0,0,0,,О, мұнда қол қойыңыз.
Dialogue: 0,0:17:10.23,0:17:11.69,Default,,0,0,0,,(Кёко) Үйге бара жатып, кемінде пиджагыңды шешіп алсаңшы!
Dialogue: 0,0:17:11.82,0:17:14.11,Default,,0,0,0,,Иә, әрине
Dialogue: 0,0:17:15.90,0:17:17.41,Default,,0,0,0,,Бұл шындық болуы мүмкін емес!
Dialogue: 0,0:17:17.53,0:17:19.70,Default,,0,0,0,,Сіздің компанияңыздағы біреудің түсініктемесі...
Dialogue: 0,0:17:20.45,0:17:25.25,Default,,0,0,0,,Иә, бірақ мен оны оқи алмаймын, сондықтан түсініктеме ...
Dialogue: 0,0:17:26.37,0:17:28.71,Default,,0,0,0,,Міне! Көп емес!
Dialogue: 0,0:17:29.21,0:17:31.88,Default,,0,0,0,,Иә, қол қойдым, бірақ...
Dialogue: 0,0:17:32.00,0:17:34.76,Default,,0,0,0,,Олай болса... күте тұрыңыз! Эй!
Dialogue: 0,0:17:34.88,0:17:36.55,Default,,0,0,0,,Хаа... (телефонды қою)
Dialogue: 0,0:17:39.85,0:17:41.68,Default,,0,0,0,,Біраз уақыттан кейін орындалады.
Dialogue: 0,0:17:42.26,0:17:43.47,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:17:43.60,0:17:46.89,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сіз оқуыңыз керек.
Dialogue: 0,0:17:47.48,0:17:48.65,Default,,0,0,0,,Дипломат болу...
Dialogue: 0,0:17:48.77,0:17:49.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:57.78,0:18:02.79,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:18:12.46,0:18:14.13,Default,,0,0,0,,Уау
Dialogue: 0,0:18:17.88,0:18:19.84,Default,,0,0,0,,Мен түстім (Б адам) Мен де
Dialogue: 0,0:18:19.97,0:18:21.93,Default,,0,0,0,,Хехе, мен аламын.
Dialogue: 0,0:18:22.22,0:18:24.56,Default,,0,0,0,,Екі жұп: патша және эйс.
Dialogue: 0,0:18:24.72,0:18:25.64,Default,,0,0,0,,О!
Dialogue: 0,0:18:26.43,0:18:27.77,Default,,0,0,0,,Толық үй
Dialogue: 0,0:18:27.94,0:18:30.02,Default,,0,0,0,,О~ Хахаха!
Dialogue: 0,0:18:30.15,0:18:31.52,Default,,0,0,0,,Керемет!
Dialogue: 0,0:18:32.19,0:18:34.19,Default,,0,0,0,,Эй, бұл керемет.
Dialogue: 0,0:18:34.94,0:18:35.86,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:18:35.98,0:18:38.32,Default,,0,0,0,,Мен мысықтарды жақсы көремін.
Dialogue: 0,0:18:38.74,0:18:41.41,Default,,0,0,0,,Әр түрлі мысықтар қоршап... А?
Dialogue: 0,0:18:42.66,0:18:44.37,Default,,0,0,0,,О? Сен барасың ба?
Dialogue: 0,0:18:44.58,0:18:47.25,Default,,0,0,0,,Хаха, бұл ықтималдық теориясы мен психологиясы...
Dialogue: 0,0:18:47.37,0:18:48.25,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:48.37,0:18:49.87,Default,,0,0,0,,Құт комбинациясы...
Dialogue: 0,0:18:50.00,0:18:50.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:51.13,0:18:53.09,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:18:53.21,0:18:54.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:54.67,0:18:57.05,Default,,0,0,0,,Гехо, Гехо, Гехо...
Dialogue: 0,0:18:57.59,0:19:00.80,Default,,0,0,0,,Кек сақтасақ, өз басымыз...
Dialogue: 0,0:19:00.93,0:19:02.05,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:19:05.85,0:19:06.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:08.77,0:19:10.81,Default,,0,0,0,,Осы арада...
Dialogue: 0,0:19:13.73,0:19:14.94,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:19.65,0:19:20.65,Default,,0,0,0,,(жану дыбысы жеңілірек)
Dialogue: 0,0:19:23.87,0:19:25.66,Default,,0,0,0,,Аа...
Dialogue: 0,0:19:26.49,0:19:29.37,Default,,0,0,0,,Хехехе, бірақ ертең жоқ.
Dialogue: 0,0:19:29.62,0:19:31.21,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:19:31.33,0:19:33.96,Default,,0,0,0,,Жұмыртқа жоқ, хаха
Dialogue: 0,0:19:34.08,0:19:36.38,Default,,0,0,0,,Жұмыртқаны кез келген жерден сатып алуға болады.
Dialogue: 0,0:19:36.50,0:19:38.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:23.51,0:20:24.84,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:25.30,0:20:26.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:27.60,0:20:28.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:37.06,0:20:38.11,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:20:38.32,0:20:40.98,Default,,0,0,0,,Ах! Дороти!
Dialogue: 0,0:20:41.36,0:20:42.65,Default,,0,0,0,,500 метр радиустағы тұрғындар да көшірілді.
Dialogue: 0,0:20:43.53,0:20:45.91,Default,,0,0,0,,Дороти! Дороти!
Dialogue: 0,0:20:46.82,0:20:47.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:48.99,0:20:50.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:51.04,0:20:57.04,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.36,0:22:50.36,Default,,0,0,0,,~♪
Dialogue: 0,0:22:51.86,0:22:57.86,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory