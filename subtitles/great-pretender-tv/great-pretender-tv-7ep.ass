Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.33,0:00:05.33,Default,,0,0,0,,(Ұшақтың ұшу дыбысы)
Dialogue: 0,0:00:16.93,0:00:17.76,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:17.89,0:00:21.89,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:00:25.19,0:00:28.77,Default,,0,0,0,,Фу хаа…
Dialogue: 0,0:00:32.03,0:00:34.74,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:00:34.86,0:00:38.87,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:55.76,0:00:57.89,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:19.07,0:01:21.28,Default,,0,0,0,,Өте әсерлі!
Dialogue: 0,0:01:21.99,0:01:24.58,Default,,0,0,0,,Осындай қаланың басында ит төбелесіңіз
Dialogue: 0,0:01:25.00,0:01:27.17,Default,,0,0,0,,Ең ақылсыз жарыс
Dialogue: 0,0:01:31.42,0:01:37.43,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:29.56,0:02:35.57,Default,,0,0,0,,~♪
Dialogue: 0,0:02:41.03,0:02:43.91,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:02:44.03,0:02:46.29,Default,,0,0,0,,Мен әлі де көп орын бар сияқтымын.
Dialogue: 0,0:02:46.70,0:02:48.71,Default,,0,0,0,,Паразольдар сирек кездеседі, солай емес пе?
Dialogue: 0,0:02:48.83,0:02:50.62,Default,,0,0,0,,Қартаюға қарсы
Dialogue: 0,0:02:55.80,0:02:59.80,Default,,0,0,0,,Кларк!
Dialogue: 0,0:03:01.01,0:03:03.34,Default,,0,0,0,,Ол фотодан да әдемі емес пе?
Dialogue: 0,0:03:03.47,0:03:05.51,Default,,0,0,0,,25 жаста жеңілмеген чемпион
Dialogue: 0,0:03:06.10,0:03:08.43,Default,,0,0,0,,Айтпақшы, мен де әуе жарысының кумирімін.
Dialogue: 0,0:03:08.56,0:03:10.23,Default,,0,0,0,,Жақында ән айта бастайтын сияқты.
Dialogue: 0,0:03:11.27,0:03:13.98,Default,,0,0,0,,Мына жерде VIP орындықтағы менің ағам Сэм.
Dialogue: 0,0:03:14.77,0:03:16.23,Default,,0,0,0,,27 жаста
Dialogue: 0,0:03:16.36,0:03:19.74,Default,,0,0,0,,Кларктың командасының иесі және турнир ұйымдастырушысы
Dialogue: 0,0:03:20.19,0:03:24.45,Default,,0,0,0,,Өз елінде ханзада болған екі адамды елден қуып, бас тартты.
Dialogue: 0,0:03:24.57,0:03:25.62,Default,,0,0,0,,Зама Амирода
Dialogue: 0,0:03:26.16,0:03:29.12,Default,,0,0,0,,Бірақ менің інім талғамы жоғары ұшқыш.
Dialogue: 0,0:03:29.70,0:03:32.37,Default,,0,0,0,,Менің ағамның промоутер қабілеті бар еді.
Dialogue: 0,0:03:33.17,0:03:35.21,Default,,0,0,0,,бірнеше жыл бұрын аяқталған әуе жарысын түсіндіреді.
Dialogue: 0,0:03:35.34,0:03:37.92,Default,,0,0,0,,Мен бәрін сатып алып, оны қайта жүктедім.
Dialogue: 0,0:03:38.05,0:03:39.88,Default,,0,0,0,,Бұл Pathfinder әуе жарысы.
Dialogue: 0,0:03:40.76,0:03:43.51,Default,,0,0,0,,Дегенмен, бұл бастапқыда өте қиын болған сияқты.
Dialogue: 0,0:03:45.05,0:03:46.85,Default,,0,0,0,,Оны орбитаға қалай шығардыңыз?
Dialogue: 0,0:03:47.14,0:03:48.14,Default,,0,0,0,,Бұл алтын.
Dialogue: 0,0:03:49.72,0:03:52.10,Default,,0,0,0,,Қарсы жаққа пара беріп, оларды жеңіліске ұшырату.
Dialogue: 0,0:03:52.52,0:03:54.31,Default,,0,0,0,,Бұл сәйкестік емес пе?
Dialogue: 0,0:03:54.69,0:03:55.86,Default,,0,0,0,,Кем дегенде
Dialogue: 0,0:03:55.98,0:03:56.81,Default,,0,0,0,,Жақсырақ айтсақ?
Dialogue: 0,0:03:57.69,0:04:00.07,Default,,0,0,0,,Сценарийленген ойын-сауық
Dialogue: 0,0:04:00.74,0:04:03.70,Default,,0,0,0,,Жеңіс пен жеңіліс толық бақылауында Сэммен
Dialogue: 0,0:04:03.82,0:04:07.62,Default,,0,0,0,,Кларк жеңілмейтін ханзада ретінде жарқырайды
Dialogue: 0,0:04:08.12,0:04:09.62,Default,,0,0,0,,Промоутердің келісімі бойынша
Dialogue: 0,0:04:09.74,0:04:12.50,Default,,0,0,0,,Әуе жарыстарының танымал болуы жыланбалықтардың өрмелеуімен байланысты.
Dialogue: 0,0:04:13.37,0:04:15.00,Default,,0,0,0,,Жасы, балалар.
Dialogue: 0,0:04:15.83,0:04:18.67,Default,,0,0,0,,Клиенттер менімен қаншалықты алысқа барады деп ойлаймын.
Dialogue: 0,0:04:20.88,0:04:22.30,Default,,0,0,0,,Басқа ұшқыштар ше?
Dialogue: 0,0:04:22.47,0:04:24.97,Default,,0,0,0,,Барлығы бақытты және бақытты
Dialogue: 0,0:04:25.09,0:04:27.14,Default,,0,0,0,,Басқаша ешкім айта алмайды
Dialogue: 0,0:04:27.89,0:04:29.64,Default,,0,0,0,,Бір адамнан басқа.
Dialogue: 0,0:04:29.76,0:04:30.81,Default,,0,0,0,,Жалғыз ба?
Dialogue: 0,0:04:31.02,0:04:35.02,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:04:36.06,0:04:38.40,Default,,0,0,0,,Тағдырдың жазуымен Кларктың қарсыласы болды.
Dialogue: 0,0:04:38.52,0:04:39.36,Default,,0,0,0,,Ах
Dialogue: 0,0:04:40.78,0:04:41.78,Default,,0,0,0,,Қоңыр сиыр
Dialogue: 0,0:04:42.28,0:04:43.82,Default,,0,0,0,,Луи Мюллер
Dialogue: 0,0:04:44.65,0:04:47.95,Default,,0,0,0,,Ол жеңу үшін бәрін жасаймын деп айтты, бірақ
Dialogue: 0,0:04:48.24,0:04:52.04,Default,,0,0,0,,Шындығында мен финалда Кларктан жеңіліп жүрдім.
Dialogue: 0,0:04:52.79,0:04:56.58,Default,,0,0,0,,«Сіз әрқашан финалда ұтыласыз, солай ма?»
Dialogue: 0,0:04:56.96,0:04:59.29,Default,,0,0,0,,Мен жеңіл жүрмін...
Dialogue: 0,0:04:59.42,0:05:01.55,Default,,0,0,0,,Ол жай ғана өкшесін ойнап жүрді.
Dialogue: 0,0:05:01.67,0:05:02.63,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:05:03.42,0:05:04.84,Default,,0,0,0,,Көрініске қарама-қайшы
Dialogue: 0,0:05:04.97,0:05:08.14,Default,,0,0,0,,Ол тапқан табысының көп бөлігін гуманитарлық көмекке аударған көрінеді.
Dialogue: 0,0:05:11.76,0:05:12.93,Default,,0,0,0,,Хмм, бұл шылау ма?
Dialogue: 0,0:05:13.06,0:05:14.10,Default,,0,0,0,,Кіргіңіз келе ме?
Dialogue: 0,0:05:15.31,0:05:16.14,Default,,0,0,0,,Хун
Dialogue: 0,0:05:19.11,0:05:21.73,Default,,0,0,0,,Ең болмаса ол сенен жақсы.
Dialogue: 0,0:05:21.86,0:05:24.32,Default,,0,0,0,,Театрлық сезім және жауыз жүз
Dialogue: 0,0:05:24.44,0:05:26.61,Default,,0,0,0,,Бұл өкшелі аяқ киімге өте ыңғайлы болды.
Dialogue: 0,0:05:26.74,0:05:29.99,Default,,0,0,0,,-дегі сценарий бойынша жеңіліп қалсаңыз, жанкүйерлердің қуанышында шек жоқ.
Dialogue: 0,0:05:30.74,0:05:31.58,Default,,0,0,0,,Бірақ
Dialogue: 0,0:05:31.70,0:05:35.71,Default,,0,0,0,,Льюис австралиялық раундтың финалында басқаша көрінді.
Dialogue: 0,0:05:36.41,0:05:38.50,Default,,0,0,0,,Сіз келісілген ойыннан шаршадыңыз ба?
Dialogue: 0,0:05:38.96,0:05:41.25,Default,,0,0,0,,Жүлде ақшасы сізді соқыр етті ме?
Dialogue: 0,0:05:41.67,0:05:44.96,Default,,0,0,0,,Қалай болғанда да, Льюис көтеріліске шыққан бірінші және соңғы болды.
Dialogue: 0,0:05:45.30,0:05:48.09,Default,,0,0,0,,Мен Кларктан өтіп, мақсатты жалғастырдым...
Dialogue: 0,0:05:48.30,0:05:50.22,Default,,0,0,0,,Барлығы солай ойлады.
Dialogue: 0,0:05:50.64,0:05:52.01,Default,,0,0,0,,Дәл сол сәтте,
Dialogue: 0,0:05:52.47,0:05:54.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:05.82,0:06:08.24,Default,,0,0,0,,(Жедел жәрдем сигналы)
Dialogue: 0,0:06:08.36,0:06:09.57,Default,,0,0,0,,Мен бұған сенбеймін...
Dialogue: 0,0:06:09.70,0:06:10.53,Default,,0,0,0,,О
Dialogue: 0,0:06:10.99,0:06:13.62,Default,,0,0,0,,Сэмнің көтерілісті сезгені үшін жазасы
Dialogue: 0,0:06:15.66,0:06:17.12,Default,,0,0,0,,Льюиспен не болды?
Dialogue: 0,0:06:19.50,0:06:21.63,Default,,0,0,0,,Әйтеуір аман қалдым, бірақ
Dialogue: 0,0:06:22.13,0:06:24.00,Default,,0,0,0,,Мен өмір бойы мүгедектер арбасында өтетін сияқтымын.
Dialogue: 0,0:06:25.76,0:06:26.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:28.76,0:06:29.72,Default,,0,0,0,,Бітті.
Dialogue: 0,0:06:31.01,0:06:34.43,Default,,0,0,0,,Нгг... мм... мм...
Dialogue: 0,0:06:34.56,0:06:37.77,Default,,0,0,0,,Нгу~
Dialogue: 0,0:06:38.64,0:06:40.06,Default,,0,0,0,,Тек осы жолы
Dialogue: 0,0:06:40.19,0:06:41.85,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:06:41.98,0:06:45.07,Default,,0,0,0,,Ал, оған Кларкты жеңуге рұқсат етейік.
Dialogue: 0,0:06:45.44,0:06:47.03,Default,,0,0,0,,Бірақ осы мақсат үшін
Dialogue: 0,0:06:47.15,0:06:49.03,Default,,0,0,0,,Алдымен біз алдын ала кезеңдерден өтуіміз керек.
Dialogue: 0,0:06:49.15,0:06:50.74,Default,,0,0,0,,Өтінемін, Эбби.
Dialogue: 0,0:07:07.71,0:07:08.55,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:08.67,0:07:11.05,Default,,0,0,0,,(жүрек соғу дыбысы)
Dialogue: 0,0:07:11.18,0:07:12.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:13.05,0:07:13.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:15.64,0:07:17.39,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:07:17.52,0:07:18.64,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:07:18.77,0:07:20.73,Default,,0,0,0,,Сіз қанша жұмсаймын деп ойлайсыз?
Dialogue: 0,0:07:21.39,0:07:23.06,Default,,0,0,0,,Мықты болыңыз.
Dialogue: 0,0:07:29.69,0:07:33.03,Default,,0,0,0,,1 минут 23 секунд?
Dialogue: 0,0:07:33.87,0:07:37.16,Default,,0,0,0,,Жақсы, мен іріктеу критерийлерін жойдым, сондықтан бұл жақсы деп ойлаймын.
Dialogue: 0,0:07:37.45,0:07:40.37,Default,,0,0,0,,Керісінше, нағыз турнир ертең басталады.
Dialogue: 0,0:07:45.50,0:07:46.75,Default,,0,0,0,,Ол шықпайды.
Dialogue: 0,0:07:46.88,0:07:47.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:48.46,0:07:49.67,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:49.88,0:07:52.22,Default,,0,0,0,,Алдын ала тексеруде ақаулар болған жоқ.
Dialogue: 0,0:07:52.34,0:07:54.05,Default,,0,0,0,,Сіз жай ғана шаршадыңыз.
Dialogue: 0,0:07:55.26,0:07:57.51,Default,,0,0,0,,Сіз әрқашан соншалықты бейқамсыз
Dialogue: 0,0:07:57.64,0:07:58.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:59.35,0:08:00.56,Default,,0,0,0,,Мынаны қараңыз!
Dialogue: 0,0:08:00.68,0:08:03.85,Default,,0,0,0,,Біріншіден, ол жай ғана ұша алады!
Dialogue: 0,0:08:03.98,0:08:05.69,Default,,0,0,0,,Сондай-ақ, бұл жай ғана абайсызда.
Dialogue: 0,0:08:06.44,0:08:07.36,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:08:07.94,0:08:10.11,Default,,0,0,0,,Турнир – ит төбелесі.
Dialogue: 0,0:08:10.23,0:08:12.95,Default,,0,0,0,,Кларкқа қарсы финалға дейін қанша жеңіске жетуім керек?
Dialogue: 0,0:08:13.53,0:08:15.95,Default,,0,0,0,,Оңай жеңу мүмкін емес!
Dialogue: 0,0:08:16.32,0:08:18.03,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:08:18.16,0:08:19.83,Default,,0,0,0,,Неге!
Dialogue: 0,0:08:19.95,0:08:21.45,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:08:24.12,0:08:25.42,Default,,0,0,0,,Бірінші турнир
Dialogue: 0,0:08:25.63,0:08:26.79,Default,,0,0,0,,және тек
Dialogue: 0,0:08:27.13,0:08:30.25,Default,,0,0,0,,Өйткені бұл әйел иесі және әйел ұшқыш.
Dialogue: 0,0:08:30.55,0:08:31.38,Default,,0,0,0,,Чуу!
Dialogue: 0,0:08:31.51,0:08:32.88,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:33.01,0:08:34.30,Default,,0,0,0,,Эбби Смайл
Dialogue: 0,0:08:34.43,0:08:35.26,Default,,0,0,0,,Tsk
Dialogue: 0,0:08:36.34,0:08:39.14,Default,,0,0,0,,Ағайынды Доракулардың сүйікті тағамы қандай деп ойлайсың?
Dialogue: 0,0:08:39.35,0:08:40.26,Default,,0,0,0,,Сүйікті тағам?
Dialogue: 0,0:08:40.72,0:08:41.97,Default,,0,0,0,,Спорттық көлік
Dialogue: 0,0:08:42.10,0:08:43.52,Default,,0,0,0,,Салқын ұшақ
Dialogue: 0,0:08:43.68,0:08:44.52,Default,,0,0,0,,Лазанья
Dialogue: 0,0:08:44.89,0:08:45.98,Default,,0,0,0,,Интернет ойындары
Dialogue: 0,0:08:46.10,0:08:47.52,Default,,0,0,0,,және құмар ойындар
Dialogue: 0,0:08:48.02,0:08:48.98,Default,,0,0,0,,Vanilla Ice айтты
Dialogue: 0,0:08:55.99,0:08:56.82,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:08:57.11,0:09:00.08,Default,,0,0,0,,Жоғарыдан көрінетін табиғат өте әдемі
Dialogue: 0,0:09:01.62,0:09:04.83,Default,,0,0,0,,Жер шіркін шындыққа толы.
Dialogue: 0,0:09:05.87,0:09:11.38,Default,,0,0,0,,Әлем этникалық қақтығыстарға, нәсілдік кемсітушілікке және кедейлік теңсіздіктеріне байланысты нашарлап барады.
Dialogue: 0,0:09:12.05,0:09:14.80,Default,,0,0,0,,Барлық адамдар тең болуы керек, солай ма?
Dialogue: 0,0:09:15.30,0:09:16.93,Default,,0,0,0,,Сондықтан мен шешім қабылдадым
Dialogue: 0,0:09:18.34,0:09:20.81,Default,,0,0,0,,Мен бәріңді бірдей құшақтаймын!
Dialogue: 0,0:09:20.93,0:09:22.93,Default,,0,0,0,,Ол аздап ақымақ...
Dialogue: 0,0:09:23.06,0:09:25.81,Default,,0,0,0,,Сәлем! Оны аздап қабылдап, ертеңгі күнге дайындалыңыз.
Dialogue: 0,0:09:26.48,0:09:27.56,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:27.69,0:09:29.90,Default,,0,0,0,,Бүгінгі жарысқа көңіліңіз толмады ма?
Dialogue: 0,0:09:30.36,0:09:32.82,Default,,0,0,0,,Жарайды, жағдай қалай болғанымен, мен жеңемін.
Dialogue: 0,0:09:33.90,0:09:36.24,Default,,0,0,0,,Жеңіске жеткенің бәрі жақсы дегенді білдірмейді.
Dialogue: 0,0:09:36.74,0:09:37.70,Default,,0,0,0,,О...
Dialogue: 0,0:09:38.03,0:09:39.95,Default,,0,0,0,,SNS өрескел
Dialogue: 0,0:09:40.28,0:09:42.62,Default,,0,0,0,,Сіз уайымдайсыз ба? Не...
Dialogue: 0,0:09:43.33,0:09:46.12,Default,,0,0,0,,«Кларк биылғы әуе жарысында да жеңіске жетеді».
Dialogue: 0,0:09:46.25,0:09:47.37,Default,,0,0,0,,«Қараудың қажеті жоқ»
Dialogue: 0,0:09:47.50,0:09:48.58,Default,,0,0,0,,Һм… Ха-ха-ха
Dialogue: 0,0:09:49.33,0:09:51.67,Default,,0,0,0,,«Мен оны түсінсем де көргім келмейді»
Dialogue: 0,0:09:52.55,0:09:54.55,Default,,0,0,0,,«Осы жылы одан да көп...» «Мен қуанбаймын.»
Dialogue: 0,0:09:55.46,0:09:56.80,Default,,0,0,0,,«Шынымды айтсам, бұл қызықсыз».
Dialogue: 0,0:09:56.92,0:09:58.13,Default,,0,0,0,,«Мен оны қайта көрмеуім мүмкін»
Dialogue: 0,0:09:58.72,0:10:00.72,Default,,0,0,0,,«Бәсекелесі бар...»
Dialogue: 0,0:10:00.85,0:10:02.85,Default,,0,0,0,,Эй, сен де солай істе!
Dialogue: 0,0:10:03.26,0:10:06.10,Default,,0,0,0,,«Мен бұқа Луи Мюллерді көргім келді».
Dialogue: 0,0:10:07.10,0:10:08.06,Default,,0,0,0,,Мен келісемін.
Dialogue: 0,0:10:08.19,0:10:09.73,Default,,0,0,0,,I'm sorry.
Dialogue: 0,0:10:09.85,0:10:11.81,Default,,0,0,0,,Қазіргі уақытта жеке пайдалану үшін сақталған.
Dialogue: 0,0:10:12.19,0:10:14.98,Default,,0,0,0,,Не! Мен оның резервтелгенін ешқашан естіген емеспін.
Dialogue: 0,0:10:15.11,0:10:16.74,Default,,0,0,0,,Біз түнеп жатырмыз.
Dialogue: 0,0:10:17.49,0:10:19.95,Default,,0,0,0,,Атақты адамдар келе ме?
Dialogue: 0,0:10:20.07,0:10:20.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:22.16,0:10:23.33,Default,,0,0,0,,О, құдайым.
Dialogue: 0,0:10:23.91,0:10:25.16,Default,,0,0,0,,Мен мұны қайталаймын
Dialogue: 0,0:10:25.29,0:10:27.00,Default,,0,0,0,,Эбби, қайтайық.
Dialogue: 0,0:10:27.46,0:10:28.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:28.87,0:10:31.13,Default,,0,0,0,,Күндіз ұшқан ұшқыштың баласы шығар?
Dialogue: 0,0:10:31.79,0:10:33.54,Default,,0,0,0,,Бұл бала - Абигейл
Dialogue: 0,0:10:33.67,0:10:35.67,Default,,0,0,0,,Мен Синтиямын, топ иесімін.
Dialogue: 0,0:10:37.38,0:10:39.97,Default,,0,0,0,,Кларк, қыздарды үйлеріне жібер.
Dialogue: 0,0:10:40.09,0:10:40.93,Default,,0,0,0,,Иә~Иә
Dialogue: 0,0:10:41.68,0:10:44.22,Default,,0,0,0,,Даяшы! екеумізге де шампан
Dialogue: 0,0:10:46.14,0:10:49.02,Default,,0,0,0,,«Ол ұшқыш әйел сүйкімді еді»
Dialogue: 0,0:10:49.14,0:10:51.02,Default,,0,0,0,,«Иесі де жақсы әйел»
Dialogue: 0,0:10:51.15,0:10:52.94,Default,,0,0,0,,«Харизма керемет»
Dialogue: 0,0:10:53.06,0:10:55.27,Default,,0,0,0,,Ұйықтама!
Dialogue: 0,0:10:55.65,0:10:56.90,Default,,0,0,0,,Шындық
Dialogue: 0,0:10:57.03,0:10:59.36,Default,,0,0,0,,Сіздің жарысыңыз керемет болды.
Dialogue: 0,0:10:59.65,0:11:03.28,Default,,0,0,0,,Ол әлі қалыптасу сатысында, бірақ болашаққа үлкен мүмкіндіктер бар.
Dialogue: 0,0:11:05.03,0:11:06.54,Default,,0,0,0,,Көңіл-күйіңіз нашар ма?
Dialogue: 0,0:11:06.66,0:11:07.54,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:08.33,0:11:11.04,Default,,0,0,0,,Мен сенің айналаңда қобалжыдым.
Dialogue: 0,0:11:11.17,0:11:12.25,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:11:12.54,0:11:13.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:14.71,0:11:16.55,Default,,0,0,0,,(бассейнге кіру дыбысы)
Dialogue: 0,0:11:17.71,0:11:19.59,Default,,0,0,0,,Абигейл! Келіңіздер
Dialogue: 0,0:11:19.72,0:11:21.30,Default,,0,0,0,,Жоқ (Кларк) Неліктен?
Dialogue: 0,0:11:21.72,0:11:23.22,Default,,0,0,0,,Менде купальник жоқ
Dialogue: 0,0:11:23.43,0:11:25.81,Default,,0,0,0,,Маған керегі жоқ, қара!
Dialogue: 0,0:11:26.93,0:11:27.77,Default,,0,0,0,,Tsk
Dialogue: 0,0:11:30.10,0:11:30.94,Default,,0,0,0,,Иә~Иә
Dialogue: 0,0:11:31.23,0:11:32.48,Default,,0,0,0,,(бассейнге кіру дыбысы)
Dialogue: 0,0:11:38.65,0:11:39.65,Default,,0,0,0,,Пу...
Dialogue: 0,0:11:39.82,0:11:41.15,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:11:41.28,0:11:42.74,Default,,0,0,0,,Ал, мен де.
Dialogue: 0,0:11:45.78,0:11:46.66,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:11:46.78,0:11:48.54,Default,,0,0,0,,Фухахаха~
Dialogue: 0,0:11:48.91,0:11:49.75,Default,,0,0,0,,Сәлем Сэм
Dialogue: 0,0:11:50.70,0:11:53.87,Default,,0,0,0,,Турнир комбинациялары әлі шешілді ме?
Dialogue: 0,0:11:54.08,0:11:57.75,Default,,0,0,0,,Төрешілер кездейсоқ шешім қабылдауы керек еді.
Dialogue: 0,0:11:57.96,0:11:59.13,Default,,0,0,0,,Ммм
Dialogue: 0,0:11:59.71,0:12:03.13,Default,,0,0,0,,Енді ойлап қарасам, біртүрлі өсек естідім.
Dialogue: 0,0:12:03.26,0:12:04.14,Default,,0,0,0,,Не?
Dialogue: 0,0:12:04.30,0:12:05.18,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:12:05.89,0:12:07.56,Default,,0,0,0,,Өтінемін, ашуланбауға болады ма?
Dialogue: 0,0:12:08.01,0:12:09.52,Default,,0,0,0,,Бұл жай ғана өсек
Dialogue: 0,0:12:10.02,0:12:12.94,Default,,0,0,0,,Бұл әуе жарысының сценарийі бар.
Dialogue: 0,0:12:14.06,0:12:18.07,Default,,0,0,0,,Жеңісті немесе жеңілісті өз еркімен басқаратын адам бар.
Dialogue: 0,0:12:18.19,0:12:19.02,Default,,0,0,0,,Хун
Dialogue: 0,0:12:19.15,0:12:21.74,Default,,0,0,0,,Бұл промоутер бизнесіндегі әдеттегі қадам.
Dialogue: 0,0:12:21.86,0:12:25.82,Default,,0,0,0,,Дегенмен, менің кеңсе қызметкеріме ешқандай айла қажет емес.
Dialogue: 0,0:12:26.37,0:12:28.62,Default,,0,0,0,,Мен сценарийді жоққа шығармаймын.
Dialogue: 0,0:12:28.87,0:12:31.75,Default,,0,0,0,,Спорт - бұл ойын-сауық, солай ма?
Dialogue: 0,0:12:32.25,0:12:34.83,Default,,0,0,0,,Мен бұл пікірмен толықтай келісемін.
Dialogue: 0,0:12:34.96,0:12:37.59,Default,,0,0,0,,Қызық болмаса, жұрттың жүрегі қимылдамайды.
Dialogue: 0,0:12:39.34,0:12:43.92,Default,,0,0,0,,Промоутердің көзқарасы бойынша менің Абигейлім туралы не ойлайсыз?
Dialogue: 0,0:12:44.38,0:12:45.34,Default,,0,0,0,,Сіздің қабілетіңізге байланысты
Dialogue: 0,0:12:45.97,0:12:47.85,Default,,0,0,0,,Сол қыз танымал болады.
Dialogue: 0,0:12:48.18,0:12:50.60,Default,,0,0,0,,Жоқ, ол қазірдің өзінде пайда бола бастады.
Dialogue: 0,0:12:50.81,0:12:52.81,Default,,0,0,0,,Турнирде жеңіске жету
Dialogue: 0,0:12:52.93,0:12:56.40,Default,,0,0,0,,Егер мен финалда Кларк мырзамен бәсекелесетін болсам.
Dialogue: 0,0:12:56.52,0:12:58.86,Default,,0,0,0,,Бұл өте қызықты болатынына сенімдімін.
Dialogue: 0,0:12:59.94,0:13:01.86,Default,,0,0,0,,Мен баяу сөйлескім келеді.
Dialogue: 0,0:13:03.03,0:13:04.11,Default,,0,0,0,,Осы нөмірге
Dialogue: 0,0:13:06.16,0:13:07.78,Default,,0,0,0,,Эбби! Мен үйге бара жатырмын
Dialogue: 0,0:13:07.99,0:13:09.83,Default,,0,0,0,,А, әлдеқашан?
Dialogue: 0,0:13:09.95,0:13:12.87,Default,,0,0,0,,Эй, менің бөлмемде тағы бір сусын ішейік.
Dialogue: 0,0:13:13.33,0:13:16.46,Default,,0,0,0,,Кешіріңіз, бірақ баланың ұйықтайтын уақыты келді.
Dialogue: 0,0:13:18.00,0:13:19.92,Default,,0,0,0,,Қайтадан ойнайық~
Dialogue: 0,0:13:20.67,0:13:21.55,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:13:21.67,0:13:22.96,Default,,0,0,0,,(өкшелі аяқ дыбыстары)
Dialogue: 0,0:13:23.09,0:13:24.30,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:13:24.42,0:13:25.42,Default,,0,0,0,,Эбби ше?
Dialogue: 0,0:13:25.67,0:13:28.18,Default,,0,0,0,,Мен қайтып келдім. Мен қазір ұйықтаймын.
Dialogue: 0,0:13:28.30,0:13:29.55,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:13:29.68,0:13:30.51,Default,,0,0,0,,Иә
Dialogue: 0,0:13:31.81,0:13:34.85,Default,,0,0,0,,О, Сэм, ертерек тамақтанғаныңызға рахмет.
Dialogue: 0,0:13:35.18,0:13:36.02,Default,,0,0,0,,Ертең?
Dialogue: 0,0:13:36.81,0:13:38.10,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:13:38.27,0:13:39.90,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:13:40.77,0:13:41.65,Default,,0,0,0,,Мен балық ұстадым.
Dialogue: 0,0:13:41.77,0:13:43.11,Default,,0,0,0,,Керемет жұмыс!
Dialogue: 0,0:13:43.48,0:13:44.61,Default,,0,0,0,,Мен душты қарызға аламын.
Dialogue: 0,0:13:44.74,0:13:45.57,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:13:47.28,0:13:48.20,Default,,0,0,0,,(ДК жабылу дыбысы)
Dialogue: 0,0:13:50.07,0:13:52.79,Default,,0,0,0,,Енді финалға дейін қауіпсіз боламыз.
Dialogue: 0,0:13:52.91,0:13:55.29,Default,,0,0,0,,Мына кесірткеге қара! Сіз көп балық ауладыңыз.
Dialogue: 0,0:13:56.04,0:13:57.33,Default,,0,0,0,,Бұл таңқаларлық (шайлау дыбысы)
Dialogue: 0,0:13:57.46,0:13:59.42,Default,,0,0,0,,Ол сенімді әйел.
Dialogue: 0,0:13:59.54,0:14:00.58,Default,,0,0,0,,Синтия
Dialogue: 0,0:14:01.17,0:14:04.21,Default,,0,0,0,,Сіз де толқып тұрсыз ба?
Dialogue: 0,0:14:04.34,0:14:05.26,Default,,0,0,0,,Орага?
Dialogue: 0,0:14:06.05,0:14:08.38,Default,,0,0,0,,Негізі егінші сияқты өмір сүру қандай?
Dialogue: 0,0:14:08.51,0:14:11.55,Default,,0,0,0,,Бұл сізге сәйкес келмейді және мұны істеу мүмкін емес.
Dialogue: 0,0:14:12.43,0:14:14.81,Default,,0,0,0,,Сіз табиғи алдамшысыз.
Dialogue: 0,0:14:18.14,0:14:19.31,Default,,0,0,0,,Ол жігітке не болды?
Dialogue: 0,0:14:19.44,0:14:20.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:21.06,0:14:23.19,Default,,0,0,0,,Эбби саған қарап тұр, Синтия.
Dialogue: 0,0:14:23.32,0:14:25.40,Default,,0,0,0,,Нағыз алаяққа ұқсамайды
Dialogue: 0,0:14:25.86,0:14:27.90,Default,,0,0,0,,Сіз әрқашан өзіңізді мұны істеуге мәжбүрлейтін сияқтысыз.
Dialogue: 0,0:14:29.53,0:14:31.37,Default,,0,0,0,,Неліктен ол...
Dialogue: 0,0:15:02.56,0:15:03.98,Default,,0,0,0,,Ха~!
Dialogue: 0,0:15:04.44,0:15:06.36,Default,,0,0,0,,Бұл шынымен де қауіпті жарыс.
Dialogue: 0,0:15:06.48,0:15:09.03,Default,,0,0,0,,Апат болса, көп нәрсе болар еді.
Dialogue: 0,0:15:09.15,0:15:10.45,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:10.57,0:15:12.07,Default,,0,0,0,,Уа, менің кезегімді қарашы!
Dialogue: 0,0:15:12.87,0:15:15.95,Default,,0,0,0,,Қарсылас Тото Виалли
Dialogue: 0,0:15:16.08,0:15:18.54,Default,,0,0,0,,Мына жігіт... ардагер дейді.
Dialogue: 0,0:15:18.66,0:15:19.75,Default,,0,0,0,,Сол үшін рахмет.
Dialogue: 0,0:15:20.33,0:15:21.25,Default,,0,0,0,,Онсыз?
Dialogue: 0,0:15:21.62,0:15:24.42,Default,,0,0,0,,Тәжірибелі қарсылас болсаңыз, жақсы жетекшілік ете аласыз.
Dialogue: 0,0:15:24.54,0:15:27.46,Default,,0,0,0,,Мені бірінші жібергені өте жақсы.
Dialogue: 0,0:15:28.05,0:15:30.38,Default,,0,0,0,,Бұл керемет ұқсастық.
Dialogue: 0,0:15:34.35,0:15:35.18,Default,,0,0,0,,(әйнек сықырлаған дыбыс)
Dialogue: 0,0:15:35.85,0:15:39.77,Default,,0,0,0,,Асыл ұшқыш әйел Абигейл Джонсқа
Dialogue: 0,0:15:40.43,0:15:42.73,Default,,0,0,0,,Жаңа жұлдыз әрекетте
Dialogue: 0,0:15:43.27,0:15:45.19,Default,,0,0,0,,Колонтитул?
Dialogue: 0,0:16:00.08,0:16:00.91,Default,,0,0,0,,Хун
Dialogue: 0,0:16:01.12,0:16:02.41,Default,,0,0,0,,Ол шығарылды.
Dialogue: 0,0:16:02.62,0:16:04.29,Default,,0,0,0,,Бұл атмосфераны жандандырады, солай емес пе?
Dialogue: 0,0:16:13.13,0:16:15.47,Default,,0,0,0,,Фуфуфуфуфу... ау, менің?
Dialogue: 0,0:16:15.59,0:16:18.89,Default,,0,0,0,,Тотоның жігіті жақсы жүрген сияқты.
Dialogue: 0,0:16:19.64,0:16:20.47,Default,,0,0,0,,Уф
Dialogue: 0,0:16:24.60,0:16:25.81,Default,,0,0,0,,Куу…
Dialogue: 0,0:16:26.94,0:16:28.44,Default,,0,0,0,,Тото күткендей
Dialogue: 0,0:16:28.57,0:16:30.86,Default,,0,0,0,,Кішкентай қызбен жарыса алмадың ба?
Dialogue: 0,0:16:31.69,0:16:33.07,Default,,0,0,0,,Сэм Хух?
Dialogue: 0,0:16:33.20,0:16:34.82,Default,,0,0,0,,Бұл басқа әңгіме.
Dialogue: 0,0:16:34.99,0:16:36.03,Default,,0,0,0,,Әңгіме?
Dialogue: 0,0:16:38.16,0:16:40.12,Default,,0,0,0,,Сіз қандай да бір уәде бердіңіз бе?
Dialogue: 0,0:16:40.37,0:16:41.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:42.79,0:16:44.87,Default,,0,0,0,,Фу... Айтайын дегенім, қарашы.
Dialogue: 0,0:16:45.54,0:16:48.63,Default,,0,0,0,,Эбби - әуе жарысын жандандыратын жаңа жұлдыз.
Dialogue: 0,0:16:49.25,0:16:50.92,Default,,0,0,0,,Бұл бала жеңіліп қалса ше?
Dialogue: 0,0:16:51.05,0:16:53.88,Default,,0,0,0,,Екеуміз үшін де үлкен шығын, солай емес пе?
Dialogue: 0,0:16:54.01,0:16:54.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:57.47,0:17:01.06,Default,,0,0,0,,Салбырап тұрған кеудеңіз бен құндылықтарыңызды өзіңізге күштеп салмаңыз!
Dialogue: 0,0:17:01.18,0:17:03.39,Default,,0,0,0,,Бұл оның жұлдыз екенін білдіре ме?
Dialogue: 0,0:17:03.52,0:17:06.31,Default,,0,0,0,,Ол тайыз әйел. Мені күлдіреді.
Dialogue: 0,0:17:06.65,0:17:10.07,Default,,0,0,0,,Тыңда, бәрін шешетін менмін.
Dialogue: 0,0:17:10.23,0:17:11.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:11.28,0:17:14.32,Default,,0,0,0,,Мен Тотоға оны мүлде құртуды айттым.
Dialogue: 0,0:17:14.99,0:17:18.74,Default,,0,0,0,,Мен үшінші дәрежелі сүтті команданың мені алуға тырысып жатқанына сене алар емеспін.
Dialogue: 0,0:17:18.87,0:17:21.24,Default,,0,0,0,,10 жыл, жоқ, 100 жыл ерте
Dialogue: 0,0:17:21.91,0:17:24.04,Default,,0,0,0,,Қанша жас әйел бар
Dialogue: 0,0:17:24.16,0:17:26.96,Default,,0,0,0,,Сіз маған ақша сұрап келе жатырсыз ба? Түсінесіз бе?
Dialogue: 0,0:17:28.13,0:17:29.71,Default,,0,0,0,,Әй, ақымақ
Dialogue: 0,0:17:30.42,0:17:34.51,Default,,0,0,0,,Тыңдаңыз, әуе жарысы – өз өміріне қауіп төндіретін ерлерге арналған спорт түрі.
Dialogue: 0,0:17:34.72,0:17:37.68,Default,,0,0,0,,Өтірік күлімсіреп, ауыр макияжбен өзін көрсетпе!
Dialogue: 0,0:17:38.22,0:17:41.14,Default,,0,0,0,,Әйелдер үндемей, үй шаруасымен айналысуы керек.
Dialogue: 0,0:17:41.85,0:17:43.02,Default,,0,0,0,,Ah~ah
Dialogue: 0,0:17:43.14,0:17:46.27,Default,,0,0,0,,Қазіргі кезде әйелдерді ашуландыру қорқынышты.
Dialogue: 0,0:17:46.60,0:17:47.69,Default,,0,0,0,,Біз не істейміз?
Dialogue: 0,0:17:48.19,0:17:49.31,Default,,0,0,0,,Олай болса
Dialogue: 0,0:17:49.44,0:17:51.69,Default,,0,0,0,,Әзірше бәрі жақсы.
Dialogue: 0,0:17:52.65,0:17:53.82,Default,,0,0,0,,Әлгі сұм бала...
Dialogue: 0,0:17:54.94,0:17:59.95,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:18:08.21,0:18:10.58,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:10.71,0:18:12.71,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:17.13,0:18:17.97,Default,,0,0,0,,Уф
Dialogue: 0,0:18:20.84,0:18:22.14,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:18:25.64,0:18:27.10,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:18:32.73,0:18:34.11,Default,,0,0,0,,Эбби!
Dialogue: 0,0:18:34.23,0:18:35.15,Default,,0,0,0,,Ха! Хаа...
Dialogue: 0,0:18:35.86,0:18:36.74,Default,,0,0,0,,Уф…
Dialogue: 0,0:18:44.87,0:18:48.50,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:51.42,0:18:53.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:53.71,0:18:56.84,Default,,0,0,0,,Соқтығысайық!
Dialogue: 0,0:18:56.96,0:18:59.72,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:16.02,0:19:17.69,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:17.82,0:19:21.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:25.83,0:19:29.62,Default,,0,0,0,,
Dialogue: 0,0:19:29.75,0:19:31.25,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:19:31.37,0:19:32.29,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:19:32.42,0:19:33.25,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:34.13,0:19:36.38,Default,,0,0,0,,Сэм Сіз мұны қазір көрдіңіз бе?
Dialogue: 0,0:19:36.50,0:19:37.38,Default,,0,0,0,,Ол керемет
Dialogue: 0,0:19:38.05,0:19:40.42,Default,,0,0,0,,Мен ұшқыштың мұндай тәртіпсіздік жасағанын көрген емеспін.
Dialogue: 0,0:19:40.67,0:19:42.72,Default,,0,0,0,,Бұдан былай қызықты болатыны сөзсіз!
Dialogue: 0,0:19:42.84,0:19:46.85,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:49.56,0:19:51.56,Default,,0,0,0,,Әйел бе, жоқ па
Dialogue: 0,0:19:51.69,0:19:54.40,Default,,0,0,0,,Бұл жарысты қызықты ете алатын жалғыз адам – сол бала.
Dialogue: 0,0:19:54.98,0:19:56.44,Default,,0,0,0,,Мына бала жұлдыз
Dialogue: 0,0:19:59.90,0:20:02.95,Default,,0,0,0,,Финал – Кларк Абигейлге қарсы.
Dialogue: 0,0:20:06.66,0:20:08.87,Default,,0,0,0,,Мені қорлағаныңыз үшін кешірім сұрауыңызды қалаймын.
Dialogue: 0,0:20:09.54,0:20:10.66,Default,,0,0,0,,Қате түсінбеңіз.
Dialogue: 0,0:20:10.79,0:20:13.58,Default,,0,0,0,,Мен ешбір жағдайда мизогинист емеспін.
Dialogue: 0,0:20:13.71,0:20:15.13,Default,,0,0,0,,Шын мәнінде, бұл керісінше.
Dialogue: 0,0:20:15.58,0:20:18.46,Default,,0,0,0,,Әйел – ер адамды емдейтін муза.
Dialogue: 0,0:20:18.59,0:20:21.47,Default,,0,0,0,,Сондықтан мен сіздің айуандық майданға келгеніңізді қаламаймын.
Dialogue: 0,0:20:22.13,0:20:23.72,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:20:23.84,0:20:27.43,Default,,0,0,0,,Бірақ қабілетің болса, олай емес.
Dialogue: 0,0:20:27.93,0:20:29.51,Default,,0,0,0,,Жақсы ұшқыш.
Dialogue: 0,0:20:40.86,0:20:42.65,Default,,0,0,0,,Айтайын ба? иә?
Dialogue: 0,0:20:43.24,0:20:45.95,Default,,0,0,0,,Неліктен ол мұны істеп жатыр?
Dialogue: 0,0:20:47.07,0:20:47.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:49.03,0:20:50.66,Default,,0,0,0,,Өлу
Dialogue: 0,0:20:51.08,0:20:57.08,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.78,0:22:50.78,Default,,0,0,0,,~♪
Dialogue: 0,0:22:52.28,0:22:58.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory