Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.41,0:00:05.29,Default,,0,0,0,,Эфиопия әулетінің ханшайымы
Dialogue: 0,0:00:05.42,0:00:07.00,Default,,0,0,0,,Сіз оны жейсіз бе?
Dialogue: 0,0:00:07.13,0:00:10.13,Default,,0,0,0,,Өзіңізді тұтынушы ретінде көрсетіңіз және өз қажеттіліктеріңізді тікелей жеткізіңіз.
Dialogue: 0,0:00:10.55,0:00:12.26,Default,,0,0,0,,Бұл қалай шынайы?
Dialogue: 0,0:00:12.59,0:00:14.22,Default,,0,0,0,,Дәлелдеу мүмкін емес.
Dialogue: 0,0:00:14.34,0:00:16.26,Default,,0,0,0,,Бұл оларға байланысты.
Dialogue: 0,0:00:16.39,0:00:18.93,Default,,0,0,0,,Мұндай қауіпті әңгімеге бару мүмкін емес.
Dialogue: 0,0:00:19.31,0:00:22.27,Default,,0,0,0,,Мен Оз сиқырына сенемін.
Dialogue: 0,0:00:22.43,0:00:25.02,Default,,0,0,0,,Иә, мақсат – 10 миллион доллар!
Dialogue: 0,0:00:25.15,0:00:27.81,Default,,0,0,0,,Жүр, жүр, түссең, қазір істе.
Dialogue: 0,0:00:27.94,0:00:28.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:29.36,0:00:30.23,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:00:32.65,0:00:35.20,Default,,0,0,0,,Бұл сіздің соңғы жұмысыңыз.
Dialogue: 0,0:00:35.32,0:00:36.49,Default,,0,0,0,,Көңілді болайық!
Dialogue: 0,0:00:36.61,0:00:38.99,Default,,0,0,0,,Сәтсіз қалғандар тасталады.
Dialogue: 0,0:00:43.25,0:00:44.33,Default,,0,0,0,,Мені қорға
Dialogue: 0,0:00:48.33,0:00:54.34,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:46.85,0:01:52.86,Default,,0,0,0,,~♪
Dialogue: 0,0:01:56.86,0:01:58.57,Default,,0,0,0,,<Бұл дәлелдеме ме? 〉
Dialogue: 0,0:01:58.70,0:01:59.86,Default,,0,0,0,,Бұл дәлелдеме ме?
Dialogue: 0,0:02:00.37,0:02:01.20,Default,,0,0,0,,Иә
Dialogue: 0,0:02:01.87,0:02:02.87,Default,,0,0,0,,〈Бұл туралы не деуге болады? 〉
Dialogue: 0,0:02:02.99,0:02:03.87,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:02:04.08,0:02:06.83,Default,,0,0,0,,Ол Кореяда сатып алушы болған кезде заңгер болған.
Dialogue: 0,0:02:06.96,0:02:08.33,Default,,0,0,0,,Мен жапонмын.
Dialogue: 0,0:02:08.87,0:02:10.63,Default,,0,0,0,,〈Оны мафия сатып жіберді〉
Dialogue: 0,0:02:10.75,0:02:12.59,Default,,0,0,0,,<Мен Оңтүстік Кореяда қамауға алындым>
Dialogue: 0,0:02:13.25,0:02:16.97,Default,,0,0,0,,〈Біздің қарым-қатынасымыз сол кезде мен басшылықты қолға алған соң басталды.〉
Dialogue: 0,0:02:17.26,0:02:21.09,Default,,0,0,0,,Бұл ыңғайлы, себебі қытай тілін осылай қолдануға болады.
Dialogue: 0,0:02:21.22,0:02:22.51,Default,,0,0,0,,Мен одан менімен бірге жүруін өтіндім.
Dialogue: 0,0:02:23.39,0:02:24.68,Default,,0,0,0,,〈Қайдасың?〉
Dialogue: 0,0:02:24.81,0:02:29.14,Default,,0,0,0,,Сонымен Эфиопия әулетінің ұрпақтары Жапонияның қай жерінде?
Dialogue: 0,0:02:29.27,0:02:30.10,Default,,0,0,0,,Киото.
Dialogue: 0,0:02:30.81,0:02:31.94,Default,,0,0,0,,Киотода не істеу керек?
Dialogue: 0,0:02:32.31,0:02:33.44,Default,,0,0,0,,Мен студентпін.
Dialogue: 0,0:02:33.57,0:02:36.28,Default,,0,0,0,,Мен Жапонияның императорлық отбасының тарихын зерттеп жатырмын.
Dialogue: 0,0:02:36.94,0:02:40.49,Default,,0,0,0,,〈Оның атасы Эфиопияның соңғы императоры болған〉
Dialogue: 0,0:02:40.95,0:02:43.83,Default,,0,0,0,,<Жапонияны экономикалық дамудың үлгісіне айналдырды>
Dialogue: 0,0:02:43.95,0:02:46.49,Default,,0,0,0,,〈Содан бері терең байланыс орнады〉
Dialogue: 0,0:02:46.62,0:02:48.00,Default,,0,0,0,,<Жасырынуға жақсы жер>
Dialogue: 0,0:02:48.41,0:02:49.54,Default,,0,0,0,,<Сенусіз>
Dialogue: 0,0:02:49.79,0:02:50.83,Default,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:02:51.17,0:02:53.54,Default,,0,0,0,,Керек болмаса, Созакуға апарып таста.
Dialogue: 0,0:02:53.75,0:02:56.30,Default,,0,0,0,,〈Керек болмаса, Созакуға апарады.〉
Dialogue: 0,0:02:56.42,0:02:58.09,Default,,0,0,0,,<Ақымақ болма! 〉
Dialogue: 0,0:02:58.51,0:03:01.68,Default,,0,0,0,,Егер сіз бұл туралы ойласаңыз, бұл жақсы.
Dialogue: 0,0:03:01.80,0:03:03.05,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:08.14,0:03:10.52,Default,,0,0,0,,<10 миллион АҚШ доллары>
Dialogue: 0,0:03:10.69,0:03:12.06,Default,,0,0,0,,<Мені дереу әкел>
Dialogue: 0,0:03:12.23,0:03:14.86,Default,,0,0,0,,(ағынды дыбыс)
Dialogue: 0,0:03:24.66,0:03:26.33,Default,,0,0,0,,〈Бұл қызық болды.〉
Dialogue: 0,0:03:26.74,0:03:27.58,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:03:30.20,0:03:32.08,Default,,0,0,0,,Бұл оққағар ғой.
Dialogue: 0,0:03:32.87,0:03:35.71,Default,,0,0,0,,Бейбіт Жапонияда мен толығымен босаңсыдым.
Dialogue: 0,0:03:36.00,0:03:38.17,Default,,0,0,0,,Мені ренжітудің қажеті жоқ.
Dialogue: 0,0:03:56.44,0:03:57.27,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:57.90,0:03:59.15,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:04:12.33,0:04:13.16,Default,,0,0,0,,Ihi~
Dialogue: 0,0:04:13.54,0:04:16.58,Default,,0,0,0,,Мен сізді тағы да африкалық тағамдарға тоқтатамын.
Dialogue: 0,0:04:23.42,0:04:26.59,Default,,0,0,0,,<Бұл Эфиопия әулетінің ұрпағы>
Dialogue: 0,0:04:26.80,0:04:29.26,Default,,0,0,0,,〈Ганнет Муруган Тасфайе ханшайымы〉
Dialogue: 0,0:04:40.73,0:04:41.57,Default,,0,0,0,,(Шапалақ)
Dialogue: 0,0:04:41.90,0:04:42.74,Default,,0,0,0,,Дөрекі!
Dialogue: 0,0:04:43.74,0:04:44.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:45.11,0:04:46.66,Default,,0,0,0,,〈Ал... жақсы, жақсы, жақсы〉
Dialogue: 0,0:04:48.53,0:04:49.87,Default,,0,0,0,,<Тіркелгіні тексеру>
Dialogue: 0,0:04:50.54,0:04:51.87,Default,,0,0,0,,Тіркелгіңізді тексеріңіз
Dialogue: 0,0:04:52.87,0:04:55.12,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:04:58.88,0:04:59.88,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:05:00.17,0:05:02.38,Default,,0,0,0,,Мен 10 миллион доллар алдым.
Dialogue: 0,0:05:02.96,0:05:04.34,Default,,0,0,0,,<Кетіңіз> (Сэйджи) <Ха! 〉
Dialogue: 0,0:05:05.13,0:05:07.97,Default,,0,0,0,,〈Егер сізде басқа мүмкіндік болса, бізге хабарласыңыз〉
Dialogue: 0,0:05:08.09,0:05:09.47,Default,,0,0,0,,〈Рахмет〉
Dialogue: 0,0:05:10.64,0:05:13.52,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:05:14.23,0:05:15.06,Default,,0,0,0,,Қалғандары
Dialogue: 0,0:05:15.18,0:05:18.19,Default,,0,0,0,,Лоран Доротиге қашып кетуге мүмкіндік берсе, аяқталады
Dialogue: 0,0:05:18.65,0:05:21.27,Default,,0,0,0,,Мен Масатомен ойнай аламын.
Dialogue: 0,0:05:21.40,0:05:24.28,Default,,0,0,0,,Маған адал сенім артқаныңыз үшін рахмет.
Dialogue: 0,0:05:25.07,0:05:26.78,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:05:26.90,0:05:29.07,Default,,0,0,0,,Сеулде біраз уақыт өткізіңіз
Dialogue: 0,0:05:29.24,0:05:31.37,Default,,0,0,0,,Мен Жапонияға анда-санда баратын шығармын.
Dialogue: 0,0:05:32.20,0:05:33.04,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:05:34.00,0:05:35.25,Default,,0,0,0,,Барлығы үшін рахмет
Dialogue: 0,0:05:35.37,0:05:36.21,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:05:36.33,0:05:38.12,Default,,0,0,0,,Маңызды нәрсені ұмытпаңыз.
Dialogue: 0,0:05:38.25,0:05:39.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:39.50,0:05:41.75,Default,,0,0,0,,Мен барлығына жауаптымын, солай ма?
Dialogue: 0,0:05:42.42,0:05:44.59,Default,,0,0,0,,Ахахха солай.
Dialogue: 0,0:05:44.88,0:05:47.38,Default,,0,0,0,,Екеуің кездескенше оны менде сақтаңдар.
Dialogue: 0,0:05:47.76,0:05:49.72,Default,,0,0,0,,Оны пайдаланбаңыз.
Dialogue: 0,0:05:49.84,0:05:51.80,Default,,0,0,0,,Ал, сіз қалай ойлайсыз?
Dialogue: 0,0:05:52.18,0:05:53.77,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:05:53.89,0:05:55.68,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:06:01.44,0:06:03.44,Default,,0,0,0,,
Dialogue: 0,0:06:03.57,0:06:05.49,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:06:08.45,0:06:09.36,Default,,0,0,0,,(қысқа ысқырық)
Dialogue: 0,0:06:10.62,0:06:13.08,Default,,0,0,0,,(үзік-үзік ысқырық)
Dialogue: 0,0:06:13.28,0:06:15.45,Default,,0,0,0,,Мм... Уф~
Dialogue: 0,0:06:24.13,0:06:25.59,Default,,0,0,0,,Бұл қорқынышты бөлме.
Dialogue: 0,0:06:25.71,0:06:28.76,Default,,0,0,0,,Іштей суық, теледидар жоқ, радио жоқ.
Dialogue: 0,0:06:28.88,0:06:31.55,Default,,0,0,0,,Айтпақшы, әжетхана анау горшок.
Dialogue: 0,0:06:32.05,0:06:33.81,Default,,0,0,0,,Ал, егеуқұйрықтар да болады.
Dialogue: 0,0:06:33.93,0:06:36.31,Default,,0,0,0,,Сонымен қатар, мен Еуропада ешқашан көрмеген кейбір жәндіктер.
Dialogue: 0,0:06:36.43,0:06:37.27,Default,,0,0,0,,
Dialogue: 0,0:06:37.39,0:06:40.31,Default,,0,0,0,,Ол жерде ұйықтау үшін қандай жүйкелер бар?
Dialogue: 0,0:06:40.48,0:06:41.98,Default,,0,0,0,,Тез қашайық
Dialogue: 0,0:06:42.11,0:06:45.02,Default,,0,0,0,,Мен әлі түпнұсқа қытай тағамын жеген жоқпын, бірақ бас тартамын.
Dialogue: 0,0:06:45.44,0:06:47.90,Default,,0,0,0,,Оны әлемнің кез келген жерінде жеуге болады.
Dialogue: 0,0:06:48.78,0:06:52.49,Default,,0,0,0,,Оз мен Сивон қашатын көлік пен қайық дайындап жатыр.
Dialogue: 0,0:06:52.78,0:06:53.91,Default,,0,0,0,,Ертең таңертеңге дейін күтіңіз
Dialogue: 0,0:06:54.91,0:06:57.29,Default,,0,0,0,,Хмм... Уф...
Dialogue: 0,0:06:58.12,0:07:00.46,Default,,0,0,0,,Таңертең бірінші болып маған шяолунбаоны әкелсеңіз.
Dialogue: 0,0:07:00.58,0:07:01.75,Default,,0,0,0,,Мен күтемін
Dialogue: 0,0:07:03.38,0:07:05.17,Default,,0,0,0,,Істің жақсы өткеніне көңілім толды.
Dialogue: 0,0:07:05.46,0:07:06.75,Default,,0,0,0,,Әрине
Dialogue: 0,0:07:06.88,0:07:09.80,Default,,0,0,0,,Қайда қарасаң да, мен ханшайыммын.
Dialogue: 0,0:07:09.92,0:07:10.93,Default,,0,0,0,,Ихихихи…
Dialogue: 0,0:07:36.24,0:07:37.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:53.72,0:07:55.55,Default,,0,0,0,,Ммм... Мм.
Dialogue: 0,0:07:56.93,0:07:58.76,Default,,0,0,0,,…
Dialogue: 0,0:07:58.89,0:07:59.97,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:08:01.18,0:08:02.23,Default,,0,0,0,,<Алдыңғы Қара және жүгір! 〉
Dialogue: 0,0:08:04.02,0:08:05.06,Default,,0,0,0,,Ууууу!
Dialogue: 0,0:08:05.44,0:08:07.86,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:08:07.98,0:08:08.86,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:08:09.53,0:08:10.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:10.53,0:08:13.32,Default,,0,0,0,,（）
Dialogue: 0,0:08:13.82,0:08:14.86,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:08:14.99,0:08:17.16,Default,,0,0,0,,<О, бұл Лоран емес пе?>
Dialogue: 0,0:08:17.37,0:08:18.58,Default,,0,0,0,,<Газетті де көрдіңіз бе?>
Dialogue: 0,0:08:18.87,0:08:19.70,Default,,0,0,0,,〈А...〉
Dialogue: 0,0:08:19.83,0:08:22.71,Default,,0,0,0,,〈...сен мені көптеген қажетсіз қиындықтардан өткізіп жатырсың〉
Dialogue: 0,0:08:23.75,0:08:24.83,Default,,0,0,0,,<Менімен бірге кел>
Dialogue: 0,0:08:26.46,0:08:27.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:33.80,0:08:35.68,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:08:41.43,0:08:43.77,Default,,0,0,0,,Сивон, бірдеңе болды.
Dialogue: 0,0:08:44.14,0:08:47.19,Default,,0,0,0,,Бұл сіз салған сурет. Онымен не істеуіміз керек?
Dialogue: 0,0:08:51.73,0:08:52.57,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:09:18.89,0:09:21.68,Default,,0,0,0,,<Ақша мен корей әйелдері қайда екенін айтыңыз>
Dialogue: 0,0:09:22.97,0:09:24.14,Default,,0,0,0,,<мырза. Лю>
Dialogue: 0,0:09:24.39,0:09:26.06,Default,,0,0,0,,<Қандай арзан алаяқ>
Dialogue: 0,0:09:26.19,0:09:28.06,Default,,0,0,0,,〈Олармен дұрыс әрекет етсеңіз де көмектесе алмайды.〉
Dialogue: 0,0:09:28.48,0:09:30.77,Default,,0,0,0,,〈Бұл жігіт жай ғана ысырап, солай ма?〉
Dialogue: 0,0:09:30.90,0:09:32.73,Default,,0,0,0,,<Лорентті аударыңыз>
Dialogue: 0,0:09:33.99,0:09:36.45,Default,,0,0,0,,Егер сіз маған брокердің ақшасын және қайда екенін айтсаңыз
Dialogue: 0,0:09:36.57,0:09:38.57,Default,,0,0,0,,Сіз ең болмағанда өз өміріңізді сақтай аласыз.
Dialogue: 0,0:09:39.95,0:09:43.83,Default,,0,0,0,,Мұнда суға батқандардың ешқайсысы қайтып оралмаған.
Dialogue: 0,0:09:45.20,0:09:47.16,Default,,0,0,0,,<Білсең жауап бер.>
Dialogue: 0,0:09:48.67,0:09:49.50,Default,,0,0,0,,<Лю Са…>
Dialogue: 0,0:09:49.63,0:09:50.84,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:09:51.75,0:09:53.71,Default,,0,0,0,,Жарайды, мен айтайын.
Dialogue: 0,0:09:53.84,0:09:54.80,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:09:54.92,0:09:57.26,Default,,0,0,0,,Мінезі қысқа еркектердің танымал емес екенін білмейсің бе?
Dialogue: 0,0:09:57.88,0:10:00.68,Default,,0,0,0,,Ақша бір жерде жасырылған.
Dialogue: 0,0:10:00.80,0:10:02.81,Default,,0,0,0,,Ешкімнің ойына бірден келмейтін жер.
Dialogue: 0,0:10:02.93,0:10:04.18,Default,,0,0,0,,Бұл қайда деп ойлайсың?
Dialogue: 0,0:10:04.31,0:10:06.06,Default,,0,0,0,,Шанхай вокзалындағы әйелдер дәретханасы.
Dialogue: 0,0:10:06.18,0:10:07.98,Default,,0,0,0,,Хехе, сен түсінбедің, солай ма?
Dialogue: 0,0:10:08.10,0:10:08.94,Default,,0,0,0,,Толық есепшот
Dialogue: 0,0:10:09.06,0:10:10.69,Default,,0,0,0,,Одан дәретхана қағазы жасалып, үйіліп жатыр.
Dialogue: 0,0:10:10.81,0:10:14.36,Default,,0,0,0,,Асықпай, жинап алмасаң, есегіңді сүртіп, жуып кетесің.
Dialogue: 0,0:10:14.61,0:10:18.40,Default,,0,0,0,,Сонымен, делдал әйел Юпитерде кимчи сатады.
Dialogue: 0,0:10:18.53,0:10:20.41,Default,,0,0,0,,Бұл өте дәмді.
Dialogue: 0,0:10:20.53,0:10:22.70,Default,,0,0,0,,Юпитердің көкөністері кимчиге жарамды дейді!
Dialogue: 0,0:10:22.83,0:10:24.12,Default,,0,0,0,,Ахаха...!
Dialogue: 0,0:10:24.24,0:10:25.37,Default,,0,0,0,,<Не туралы айтып тұрсың? 〉
Dialogue: 0,0:10:25.49,0:10:27.96,Default,,0,0,0,,Хахаха... Аха...
Dialogue: 0,0:10:28.66,0:10:29.50,Default,,0,0,0,,Хмм…
Dialogue: 0,0:10:31.67,0:10:33.59,Default,,0,0,0,,Сәтсіздікке ұшырағандар тасталады
Dialogue: 0,0:10:35.42,0:10:37.47,Default,,0,0,0,,Біздің ережелер абсолютті.
Dialogue: 0,0:10:39.93,0:10:41.39,Default,,0,0,0,,Көңілді болды
Dialogue: 0,0:10:41.84,0:10:42.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:47.60,0:10:48.43,Default,,0,0,0,,<Laurent>
Dialogue: 0,0:10:49.23,0:10:51.15,Default,,0,0,0,,<Не? Сен не айтып тұрсың? 〉
Dialogue: 0,0:10:51.56,0:10:53.31,Default,,0,0,0,,<Бақыт, қателіктер! 〉
Dialogue: 0,0:11:00.49,0:11:01.32,Default,,0,0,0,,<Бастық>
Dialogue: 0,0:11:02.16,0:11:03.87,Default,,0,0,0,,<Менімен жапондық адам хабарласты>
Dialogue: 0,0:11:07.12,0:11:08.70,Default,,0,0,0,,<Газеттен оқығанда таң қалдым>
Dialogue: 0,0:11:08.87,0:11:12.17,Default,,0,0,0,,<Мен оның жалған екеніне сене алмаймын>
Dialogue: 0,0:11:12.79,0:11:15.71,Default,,0,0,0,,〈Мені кешіріңіз, мен шынымен де білмедім! 〉
Dialogue: 0,0:11:16.42,0:11:19.17,Default,,0,0,0,,〈Мені жаңа ғана әлгі қарғыс атқыр қарғыс сұрады.〉
Dialogue: 0,0:11:19.97,0:11:22.18,Default,,0,0,0,,〈Сол жалған ханшайымға да солай болатынына сенімдімін.〉
Dialogue: 0,0:11:22.89,0:11:24.60,Default,,0,0,0,,〈Мені жаңа ғана қарт бәйбіше пайдаланды! 〉
Dialogue: 0,0:11:25.51,0:11:27.72,Default,,0,0,0,,<А... Мен оның қайда екенін білемін>
Dialogue: 0,0:11:27.97,0:11:29.52,Default,,0,0,0,,〈Ақша да сонда болуы керек! 〉
Dialogue: 0,0:11:29.85,0:11:31.48,Default,,0,0,0,,〈Мекен жайы Сеулде...〉
Dialogue: 0,0:11:37.53,0:11:38.36,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:39.53,0:11:40.95,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:11:41.07,0:11:42.61,Default,,0,0,0,,<Қатты! Оны қу! 〉
Dialogue: 0,0:11:53.50,0:11:54.83,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:11:59.59,0:12:01.34,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:18.73,0:12:19.57,Default,,0,0,0,,<Растау? 〉
Dialogue: 0,0:12:20.53,0:12:21.44,Default,,0,0,0,,<Түсінікті>
Dialogue: 0,0:12:21.99,0:12:23.86,Default,,0,0,0,,<Ақша аман-есен өндірілді>
Dialogue: 0,0:12:24.16,0:12:27.32,Default,,0,0,0,,<Кемпір жол апатына ұшырап, күйіп кеткен.>
Dialogue: 0,0:12:31.37,0:12:33.41,Default,,0,0,0,,<Жарайды, мен қайтайын>
Dialogue: 0,0:12:34.00,0:12:35.75,Default,,0,0,0,,<Жапондықтар не істейді? 〉
Dialogue: 0,0:12:35.88,0:12:38.25,Default,,0,0,0,,〈Өз-өзіне қол жұмсау туралы хат жазып, оны ғимараттан тастап кетсін〉
Dialogue: 0,0:12:39.84,0:12:40.88,Default,,0,0,0,,<Бұл әйел кім? 〉
Dialogue: 0,0:12:41.42,0:12:43.55,Default,,0,0,0,,<Аузы жаман әйелдерді жек көремін>
Dialogue: 0,0:12:44.43,0:12:46.59,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:12:58.02,0:12:59.61,Default,,0,0,0,,<Осы уақыт туралы ештеңе берме>
Dialogue: 0,0:12:59.73,0:13:01.78,Default,,0,0,0,,(Әсіресе Созаку үшін емес)
Dialogue: 0,0:13:01.90,0:13:02.86,Default,,0,0,0,,<Түсіну>
Dialogue: 0,0:13:03.03,0:13:05.95,Default,,0,0,0,,〈Сәлем! Енді қайтып, спиртпен дезинфекциялаңыз! 〉
Dialogue: 0,0:13:06.07,0:13:06.99,Default,,0,0,0,,<Хахаха...>
Dialogue: 0,0:13:08.37,0:13:09.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:37.48,0:13:38.31,Default,,0,0,0,,Тағы 500 рет!
Dialogue: 0,0:13:44.49,0:13:46.90,Default,,0,0,0,,Ал адвокат Сейджи Озаки...
Dialogue: 0,0:13:47.53,0:13:50.66,Default,,0,0,0,,Бұл сіз салған сурет. Онымен не істеуіміз керек?
Dialogue: 0,0:13:51.03,0:13:54.16,Default,,0,0,0,,Созаку жігіттерін әдейі қолға түсіру үшін пайдаланып жатырмыз.
Dialogue: 0,0:13:54.83,0:13:57.16,Default,,0,0,0,,Мен сізден Лоранның соңынан еруіңізді сұраймын.
Dialogue: 0,0:13:57.29,0:13:58.12,Default,,0,0,0,,О
Dialogue: 0,0:13:58.71,0:14:00.46,Default,,0,0,0,,Олай болса, сау болыңыз.
Dialogue: 0,0:14:00.58,0:14:01.42,Default,,0,0,0,,(Қоңыраудың дыбысы ажыратылады)
Dialogue: 0,0:14:02.00,0:14:02.88,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:14:07.13,0:14:09.18,Default,,0,0,0,,<Лорен, сенің кезегің>
Dialogue: 0,0:14:15.98,0:14:16.89,Default,,0,0,0,,<Асығыңыз>
Dialogue: 0,0:14:18.69,0:14:19.94,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:29.61,0:14:30.45,Default,,0,0,0,,<Laurent>
Dialogue: 0,0:14:30.57,0:14:31.41,Default,,0,0,0,,<Laurent! 〉
Dialogue: 0,0:14:33.20,0:14:35.29,Default,,0,0,0,,〈Не болды? Бірдеңе болды ма? 〉
Dialogue: 0,0:14:41.79,0:14:45.92,Default,,0,0,0,,〈Франциядағы анамның жағдайы нашар сияқты...〉
Dialogue: 0,0:14:46.51,0:14:48.42,Default,,0,0,0,,〈Маған көп ұзамайды деп айтты...〉
Dialogue: 0,0:14:48.92,0:14:51.55,Default,,0,0,0,,<Түсіндім... бұл алаңдаушылық.>
Dialogue: 0,0:14:53.18,0:14:54.97,Default,,0,0,0,,<Сенің отбасың да менің отбасым>
Dialogue: 0,0:14:55.64,0:14:56.93,Default,,0,0,0,,〈Оған қамқор болма〉
Dialogue: 0,0:15:04.61,0:15:08.74,Default,,0,0,0,,(ағынды дыбыс)
Dialogue: 0,0:15:12.07,0:15:12.91,Default,,0,0,0,,Дороти!
Dialogue: 0,0:15:14.87,0:15:15.70,Default,,0,0,0,,Дороти!
Dialogue: 0,0:15:17.87,0:15:19.20,Default,,0,0,0,,Дороти, солай ма?
Dialogue: 0,0:15:19.83,0:15:21.75,Default,,0,0,0,,Мені қашанға дейін алдайсың?
Dialogue: 0,0:15:22.71,0:15:23.75,Default,,0,0,0,,Жетеді
Dialogue: 0,0:15:25.54,0:15:28.05,Default,,0,0,0,,Алдаудың қажеті жоқ, шық!
Dialogue: 0,0:15:30.63,0:15:33.51,Default,,0,0,0,,Өтінемін... шығыңызшы.
Dialogue: 0,0:15:34.60,0:15:36.68,Default,,0,0,0,,Менімен қайта сөйлесіңіз.
Dialogue: 0,0:15:37.39,0:15:38.60,Default,,0,0,0,,Дороти…
Dialogue: 0,0:15:54.53,0:15:56.70,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:15:58.16,0:16:01.00,Default,,0,0,0,,Эй, сен тірісің бе? Лоран!
Dialogue: 0,0:16:01.29,0:16:02.29,Default,,0,0,0,,Ким Сивон
Dialogue: 0,0:16:02.41,0:16:05.33,Default,,0,0,0,,Мен тозақтың шетінен оралдым!
Dialogue: 0,0:16:05.75,0:16:06.59,Default,,0,0,0,,Ах
Dialogue: 0,0:16:07.67,0:16:09.00,Default,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:16:09.13,0:16:10.01,Default,,0,0,0,,Біз қашаннан бері келдік?
Dialogue: 0,0:16:10.13,0:16:12.30,Default,,0,0,0,,Сіз үйсіздер үйіне түстіңіз бе?
Dialogue: 0,0:16:12.80,0:16:16.39,Default,,0,0,0,,Сонда да мен көп уайымдаған болуым керек.
Dialogue: 0,0:16:16.76,0:16:18.18,Default,,0,0,0,,Қандай қарапайымдылық
Dialogue: 0,0:16:18.31,0:16:20.47,Default,,0,0,0,,Танысының ауруханасынан белгісіз дене...
Dialogue: 0,0:16:20.60,0:16:22.31,Default,,0,0,0,,Мен қоқыспын
Dialogue: 0,0:16:23.69,0:16:25.56,Default,,0,0,0,,Мен қорқып, қашып кеттім.
Dialogue: 0,0:16:26.19,0:16:29.78,Default,,0,0,0,,Ол Люді өлтіруі мүмкін еді.
Dialogue: 0,0:16:29.90,0:16:30.73,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:16:33.07,0:16:35.11,Default,,0,0,0,,Ешқашан өлтірмеңіз
Dialogue: 0,0:16:36.45,0:16:38.83,Default,,0,0,0,,Бұл біздің ережелеріміз, солай ма?
Dialogue: 0,0:16:39.87,0:16:43.33,Default,,0,0,0,,Хаа... Дороти күлуге келді.
Dialogue: 0,0:16:43.87,0:16:45.04,Default,,0,0,0,,Мына бала?
Dialogue: 0,0:16:45.25,0:16:48.88,Default,,0,0,0,,Ол мен үшін сүйкімді қыз сияқты болды.
Dialogue: 0,0:16:49.13,0:16:51.84,Default,,0,0,0,,Жоқ, жиенім... апам.
Dialogue: 0,0:16:52.67,0:16:55.18,Default,,0,0,0,,Жарайды, Оз сені уайымдады.
Dialogue: 0,0:16:55.59,0:16:59.47,Default,,0,0,0,,Маған тірі екеніңді білдіретін махаббат хатын жаз
Dialogue: 0,0:17:01.18,0:17:03.77,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:17:10.69,0:17:12.07,Default,,0,0,0,,Дороти…
Dialogue: 0,0:17:12.78,0:17:13.86,Default,,0,0,0,,Цезарь жастығын да, болашағын да босқа өткізді
Dialogue: 0,0:17:15.49,0:17:16.53,Default,,0,0,0,,Дороти?
Dialogue: 0,0:17:17.45,0:17:18.53,Default,,0,0,0,,Дороти
Dialogue: 0,0:17:26.46,0:17:27.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:27.46,0:17:28.29,Default,,0,0,0,,Доро…
Dialogue: 0,0:17:38.14,0:17:41.60,Default,,0,0,0,,Хаа... хахаха...
Dialogue: 0,0:17:56.90,0:18:00.12,Default,,0,0,0,,Қанша жыл немесе ондаған жылдар қажет болса да маңызды емес.
Dialogue: 0,0:18:01.16,0:18:04.29,Default,,0,0,0,,Доротиді қалай қуантуға болатынын айт
Dialogue: 0,0:18:04.41,0:18:05.41,Default,,0,0,0,,Шебер
Dialogue: 0,0:18:18.47,0:18:22.01,Default,,0,0,0,,Енді не істеуім керек?
Dialogue: 0,0:18:22.97,0:18:27.27,Default,,0,0,0,,Бүгін ақша жинамасақ, әкем аман қалмайды.
Dialogue: 0,0:18:27.81,0:18:30.23,Default,,0,0,0,,Донор тапсам да
Dialogue: 0,0:18:30.35,0:18:31.40,Default,,0,0,0,,О!
Dialogue: 0,0:18:31.52,0:18:33.48,Default,,0,0,0,,Мұны естігенім үшін кешіріңіз.
Dialogue: 0,0:18:34.19,0:18:35.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:35.90,0:18:38.03,Default,,0,0,0,,Осы ақшаға жарайсың ба?
Dialogue: 0,0:18:38.32,0:18:39.86,Default,,0,0,0,,О, әрине
Dialogue: 0,0:18:40.11,0:18:41.62,Default,,0,0,0,,Бұл мен үшін көп ақша
Dialogue: 0,0:18:42.24,0:18:44.79,Default,,0,0,0,,Хаа... бұл менің әкемді құтқарады!
Dialogue: 0,0:18:44.91,0:18:47.00,Default,,0,0,0,,Иә? Ол 10 жыл бұрын қайтыс болса да?
Dialogue: 0,0:18:47.37,0:18:48.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:48.66,0:18:50.17,Default,,0,0,0,,Жұмыс істеу әдісі ең нашар
Dialogue: 0,0:18:50.29,0:18:52.04,Default,,0,0,0,,Актерлік қабілеті соншалықты
Dialogue: 0,0:18:52.29,0:18:56.38,Default,,0,0,0,,Оның кеудесі түйіршіктелген сүт болса керек, бірақ оның мүмкіндігі бар сияқты.
Dialogue: 0,0:18:58.63,0:19:00.63,Default,,0,0,0,,Бұл барлаушының салымы.
Dialogue: 0,0:19:01.22,0:19:02.22,Default,,0,0,0,,Не?
Dialogue: 0,0:19:02.93,0:19:04.72,Default,,0,0,0,,Сенімді адам
Dialogue: 0,0:19:11.15,0:19:14.11,Default,,0,0,0,,Егер солай болса, неге маған келмедің?
Dialogue: 0,0:19:14.27,0:19:16.32,Default,,0,0,0,,Ол жазасын бітіріп, түрмеден шығуы керек еді, солай ма?
Dialogue: 0,0:19:18.15,0:19:19.53,Default,,0,0,0,,Ол қашып кетті.
Dialogue: 0,0:19:20.82,0:19:21.95,Default,,0,0,0,,Оны қазірдің өзінде ұмытыңыз
Dialogue: 0,0:19:31.29,0:19:33.42,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:19:33.58,0:19:35.71,Default,,0,0,0,,Барлығы 20 доллар төледі.
Dialogue: 0,0:19:35.88,0:19:38.42,Default,,0,0,0,,Енді сіз шынымен де өзіңіз қалаған нәрсені жасай аласыз.
Dialogue: 0,0:19:38.55,0:19:39.42,Default,,0,0,0,,Қыз бала…
Dialogue: 0,0:19:39.80,0:19:41.93,Default,,0,0,0,,О, не істесең де
Dialogue: 0,0:19:42.22,0:19:43.68,Default,,0,0,0,,Бірақ мен қарсы боламын.
Dialogue: 0,0:19:44.05,0:19:44.97,Default,,0,0,0,,Жұмсақ…
Dialogue: 0,0:19:45.10,0:19:48.93,Default,,0,0,0,,Қарсылық көрсеткен әйелді күштеп көрсетуге шыдай алмаймын.
Dialogue: 0,0:19:49.06,0:19:50.18,Default,,0,0,0,,Олай болса өтінемін
Dialogue: 0,0:19:50.56,0:19:51.69,Default,,0,0,0,,Яхаха~! (соққы дыбысы)
Dialogue: 0,0:19:53.85,0:19:55.98,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:19:58.19,0:19:59.94,Default,,0,0,0,,Не? полиция?
Dialogue: 0,0:20:00.07,0:20:01.20,Default,,0,0,0,,Бұл өзін-өзі қорғау.
Dialogue: 0,0:20:04.70,0:20:05.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:06.12,0:20:07.87,Default,,0,0,0,,Сіздің денеңіз... жоқ
Dialogue: 0,0:20:07.99,0:20:10.75,Default,,0,0,0,,Бұл талант 20 долларға тым арзан.
Dialogue: 0,0:20:12.08,0:20:13.21,Default,,0,0,0,,(бұл түсінбеушілік болса да)
Dialogue: 0,0:20:13.58,0:20:17.42,Default,,0,0,0,,<Бастықты сыйламағаным үшін кешірім сұраймын>
Dialogue: 0,0:20:17.84,0:20:20.21,Default,,0,0,0,,<Мені шақырғаныңызға рахмет>
Dialogue: 0,0:20:21.17,0:20:24.26,Default,,0,0,0,,(Түсіндіруге, құқықтық мәселелерге және басқа келіссөздерге қатысты)
Dialogue: 0,0:20:24.38,0:20:26.18,Default,,0,0,0,,<Маған хабарлаңыз>
Dialogue: 0,0:20:26.68,0:20:29.89,Default,,0,0,0,,<Бастыққа көмектесуге рұқсат етіңіз>
Dialogue: 0,0:20:32.56,0:20:35.19,Default,,0,0,0,,Өйткені, Эдамура мырза данышпан.
Dialogue: 0,0:20:35.44,0:20:38.69,Default,,0,0,0,,Жоқ, солай деп ойлаймын.
Dialogue: 0,0:20:41.82,0:20:42.78,Default,,0,0,0,,〈Кешіріңіз〉
Dialogue: 0,0:20:43.95,0:20:45.28,Default,,0,0,0,,<Мұны тастадың ба? 〉
Dialogue: 0,0:20:49.08,0:20:49.91,Default,,0,0,0,,Иә
Dialogue: 0,0:20:51.04,0:20:57.04,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.86,0:22:50.86,Default,,0,0,0,,~♪
