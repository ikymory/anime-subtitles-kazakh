Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.58,0:00:07.75,Default,,0,0,0,,(қуырылған дыбыс)
Dialogue: 0,0:00:10.05,0:00:10.96,Default,,0,0,0,,Хаа…
Dialogue: 0,0:00:12.51,0:00:13.34,Default,,0,0,0,,(басылған дыбыс)
Dialogue: 0,0:00:15.55,0:00:16.93,Default,,0,0,0,,Хаа~
Dialogue: 0,0:00:17.39,0:00:19.18,Default,,0,0,0,,Сатылым төмендеуде
Dialogue: 0,0:00:19.39,0:00:21.31,Default,,0,0,0,,Мен оның осылай қала беретінін білемін.
Dialogue: 0,0:00:35.11,0:00:36.45,Default,,0,0,0,,Тамақ дайын.
Dialogue: 0,0:00:36.61,0:00:37.45,Default,,0,0,0,,О
Dialogue: 0,0:00:42.12,0:00:43.71,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:00:47.79,0:00:49.29,Default,,0,0,0,,Түскі ас.
Dialogue: 0,0:00:50.71,0:00:53.42,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:53.55,0:00:54.38,Default,,0,0,0,,(Табақ қою дыбысы)
Dialogue: 0,0:00:56.59,0:00:58.01,Default,,0,0,0,,Көп тамақтаныңыз
Dialogue: 0,0:00:58.14,0:00:59.76,Default,,0,0,0,,Барлығы тым арық
Dialogue: 0,0:01:00.18,0:01:01.68,Default,,0,0,0,,Аударған Эдамура мырза
Dialogue: 0,0:01:02.22,0:01:04.52,Default,,0,0,0,,(Эдамама: ағылшын)
Dialogue: 0,0:01:07.44,0:01:08.35,Default,,0,0,0,,Хаа…
Dialogue: 0,0:01:08.90,0:01:09.73,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:01:10.77,0:01:13.28,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:01:17.24,0:01:18.11,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:01:18.24,0:01:21.49,Default,,0,0,0,,Сасық. Сіз ваннаны дұрыс қабылдайсыз ба?
Dialogue: 0,0:01:21.62,0:01:22.79,Default,,0,0,0,,Аптасына бір рет
Dialogue: 0,0:01:22.99,0:01:24.91,Default,,0,0,0,,Аптасына екі рет жасаңыз (қызметкер) Иә.
Dialogue: 0,0:01:26.25,0:01:27.21,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:01:30.92,0:01:32.75,Default,,0,0,0,,Оны қайтадан қорапқа салыңыз.
Dialogue: 0,0:01:40.93,0:01:42.51,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:01:42.76,0:01:45.68,Default,,0,0,0,,Бұл мен жасаған ең қиын жұмыс.
Dialogue: 0,0:01:46.18,0:01:48.44,Default,,0,0,0,,Әкемі Созаку неге ұқсайды?
Dialogue: 0,0:01:48.65,0:01:49.65,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:01:49.77,0:01:53.32,Default,,0,0,0,,Бұл әсерлі, бірақ соншалықты қорқынышты емес.
Dialogue: 0,0:01:53.65,0:01:56.74,Default,,0,0,0,,Лоран, мүмкіндігінше тезірек түс.
Dialogue: 0,0:01:57.40,0:01:58.74,Default,,0,0,0,,Түсуге болады.
Dialogue: 0,0:01:59.28,0:02:03.24,Default,,0,0,0,,Бірақ сіз бала сатуды көрдіңіз және ол туралы ештеңе ойламадыңыз ба?
Dialogue: 0,0:02:03.83,0:02:05.62,Default,,0,0,0,,Сіз қандай әдістерді қолданғыңыз келеді?
Dialogue: 0,0:02:06.08,0:02:08.67,Default,,0,0,0,,Синтияның қозғалатын уақыты келді.
Dialogue: 0,0:02:08.83,0:02:12.71,Default,,0,0,0,,(ағынды дыбыс)
Dialogue: 0,0:02:13.71,0:02:16.42,Default,,0,0,0,,Әй, анау бала жақсы жүр ме екен.
Dialogue: 0,0:02:16.55,0:02:18.34,Default,,0,0,0,,Сіз жас қарлығаштарға алаңдайсыз ба?
Dialogue: 0,0:02:18.47,0:02:20.97,Default,,0,0,0,,Өйткені мен сүйкімді ақымақпын.
Dialogue: 0,0:02:21.72,0:02:23.26,Default,,0,0,0,,Бірақ бұған дейін
Dialogue: 0,0:02:23.43,0:02:25.77,Default,,0,0,0,,Бір кесе.
Dialogue: 0,0:02:27.31,0:02:33.31,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:25.78,0:03:31.79,Default,,0,0,0,,~♪
Dialogue: 0,0:03:34.79,0:03:37.88,Default,,0,0,0,,Осы қарқынмен мен бұл айда да өз квотаға жете алмаймын.
Dialogue: 0,0:03:38.00,0:03:39.26,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:39.38,0:03:40.26,Default,,0,0,0,,<Сәлеметсіз бе>
Dialogue: 0,0:03:40.38,0:03:41.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:41.51,0:03:43.34,Default,,0,0,0,,Президент, тапсырыс беруші.
Dialogue: 0,0:03:43.55,0:03:45.68,Default,,0,0,0,,<Сәлеметсіз бе, танысқаныма қуаныштымын>
Dialogue: 0,0:03:46.14,0:03:47.01,Default,,0,0,0,,<Сіз президентсіз! 〉
Dialogue: 0,0:03:47.14,0:03:49.97,Default,,0,0,0,,<Мен Синтия Йорошикумын! 〉
Dialogue: 0,0:03:50.43,0:03:53.19,Default,,0,0,0,,Танысқаныма қуаныштымын, Синтия...
Dialogue: 0,0:03:53.81,0:03:56.56,Default,,0,0,0,,Синтия саудасы
Dialogue: 0,0:03:57.11,0:04:00.99,Default,,0,0,0,,Бұл бізбен бизнес жасағыңыз келетінін білдіре ме?
Dialogue: 0,0:04:01.19,0:04:02.65,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:04:03.20,0:04:06.32,Default,,0,0,0,,Сіз қандай бұйымдарды өңдейсіз?
Dialogue: 0,0:04:06.45,0:04:07.70,Default,,0,0,0,,Әртүрлі
Dialogue: 0,0:04:07.91,0:04:10.41,Default,,0,0,0,,Ол Еуропада және Таяу Шығыста жұмыс істеді.
Dialogue: 0,0:04:10.54,0:04:12.66,Default,,0,0,0,,Бұл жерде айтарлықтай рецессия.
Dialogue: 0,0:04:12.79,0:04:15.92,Default,,0,0,0,,Осылайша мен Азияға келдім.
Dialogue: 0,0:04:16.88,0:04:18.75,Default,,0,0,0,,Сөйлейтін брокер шығар.
Dialogue: 0,0:04:18.88,0:04:19.84,Default,,0,0,0,,О
Dialogue: 0,0:04:20.26,0:04:23.38,Default,,0,0,0,,〈Бізде өте жақсы өнімдер бар〉
Dialogue: 0,0:04:23.51,0:04:24.63,Default,,0,0,0,,«Жақсы өнім»
Dialogue: 0,0:04:24.76,0:04:26.47,Default,,0,0,0,,Өнер туындысы немесе сол сияқты нәрсе?
Dialogue: 0,0:04:26.68,0:04:27.80,Default,,0,0,0,,<Бұл қыз>
Dialogue: 0,0:04:27.93,0:04:28.97,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:04:29.85,0:04:31.18,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:04:33.43,0:04:34.69,Default,,0,0,0,,Сіз нені айтасыз...
Dialogue: 0,0:04:34.81,0:04:36.40,Default,,0,0,0,,〈Түйсіну〉
Dialogue: 0,0:04:36.52,0:04:37.36,Default,,0,0,0,,〈Жоқ.〉
Dialogue: 0,0:04:37.48,0:04:38.40,Default,,0,0,0,,<Сатып алмасаңыз>
Dialogue: 0,0:04:38.52,0:04:40.69,Default,,0,0,0,,<Мен оны Шанхайдағы жігіттерге апарамын, жарай ма?>
Dialogue: 0,0:04:40.82,0:04:43.11,Default,,0,0,0,,Мұны айтудың жақсы тәсілі емес.
Dialogue: 0,0:04:43.44,0:04:44.49,Default,,0,0,0,,Не?
Dialogue: 0,0:04:44.70,0:04:47.28,Default,,0,0,0,,Үйде қажет болмаса, басқа жерге апарыңыз.
Dialogue: 0,0:04:47.41,0:04:48.24,Default,,0,0,0,,(Балалардың шуы)
Dialogue: 0,0:04:48.66,0:04:50.37,Default,,0,0,0,,Шанхай ұйымы т.б.
Dialogue: 0,0:04:50.49,0:04:51.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:51.45,0:04:53.54,Default,,0,0,0,,<Ал, бұл арзан сатып алу емес.>
Dialogue: 0,0:04:53.66,0:04:57.17,Default,,0,0,0,,<Шанхайдағы жігіттер бірден сатып алар еді.>
Dialogue: 0,0:04:58.29,0:05:00.21,Default,,0,0,0,,Менің тұтынушыларым қатал.
Dialogue: 0,0:05:00.34,0:05:03.46,Default,,0,0,0,,Біз тек Berry Expensive өнімдерін тасымалдаймыз...
Dialogue: 0,0:05:03.59,0:05:05.97,Default,,0,0,0,,<Менің өнімім өте ерекше>
Dialogue: 0,0:05:06.80,0:05:07.64,Default,,0,0,0,,басқа біреудің ұялы телефоны қоңырау шалғанда шыдай алмаймын.
Dialogue: 0,0:05:07.76,0:05:09.01,Default,,0,0,0,,<Ханшайым>
Dialogue: 0,0:05:09.35,0:05:10.22,Default,,0,0,0,,Ханшайым?
Dialogue: 0,0:05:10.35,0:05:12.10,Default,,0,0,0,,<Иә, ханшайым>
Dialogue: 0,0:05:12.22,0:05:14.48,Default,,0,0,0,,Мұндай нәрсе қайда?
Dialogue: 0,0:05:14.73,0:05:17.85,Default,,0,0,0,,Мен қазір басып алуға барамын, менімен бірге келгің келе ме?
Dialogue: 0,0:05:18.48,0:05:19.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:23.82,0:05:26.32,Default,,0,0,0,,Иә, барлығы ағылшын тілінде сөйлейді.
Dialogue: 0,0:05:26.45,0:05:28.49,Default,,0,0,0,,Бұл адамдар көп әйелді, солай емес пе?
Dialogue: 0,0:05:28.87,0:05:29.82,Default,,0,0,0,,Соның арқасында
Dialogue: 0,0:05:29.95,0:05:33.45,Default,,0,0,0,,15 ханзада мен 18 ханшайым бірінен соң бірі
Dialogue: 0,0:05:33.58,0:05:34.41,Default,,0,0,0,,Сивон-сан
Dialogue: 0,0:05:35.00,0:05:36.58,Default,,0,0,0,,Осы уақытқа дейін келудің мәні неде?
Dialogue: 0,0:05:36.71,0:05:38.46,Default,,0,0,0,,Қателер және сол сияқты нәрселер...
Dialogue: 0,0:05:38.58,0:05:41.84,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:05:43.96,0:05:46.88,Default,,0,0,0,,О, бұл өте жарқыраған ұшақ.
Dialogue: 0,0:05:47.88,0:05:50.22,Default,,0,0,0,,<Сіз Кларк Ибрахимді білесіз бе? 〉
Dialogue: 0,0:05:50.34,0:05:54.06,Default,,0,0,0,,〈Ол әйгілі әуе жарысшысы және ол күнде жаттығу жасайды.〉
Dialogue: 0,0:05:54.18,0:05:55.48,Default,,0,0,0,,Әуе жарысы?
Dialogue: 0,0:05:55.60,0:05:57.52,Default,,0,0,0,,Тәжірибеден оралуды мақсат етіңіз
Dialogue: 0,0:06:06.53,0:06:07.99,Default,,0,0,0,,(саусақ ысқырығы)
Dialogue: 0,0:06:13.95,0:06:17.04,Default,,0,0,0,,(Жылдам дыбыс)
Dialogue: 0,0:06:19.96,0:06:20.92,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:06:24.63,0:06:26.92,Default,,0,0,0,,Эй... Жындысың ба?
Dialogue: 0,0:06:36.39,0:06:38.60,Default,,0,0,0,,Бұл Кларк Ибрагим ме?
Dialogue: 0,0:06:38.73,0:06:39.56,Default,,0,0,0,,Иә
Dialogue: 0,0:06:39.81,0:06:42.44,Default,,0,0,0,,Мен лимузиннің артқы орындығында отырмын.
Dialogue: 0,0:06:42.56,0:06:44.65,Default,,0,0,0,,Түсінемін, бұл нанымды.
Dialogue: 0,0:06:44.86,0:06:47.44,Default,,0,0,0,,Бірақ ол өнім бола алмайды.
Dialogue: 0,0:06:47.61,0:06:48.99,Default,,0,0,0,,〈Тағы бір адам бар〉
Dialogue: 0,0:06:49.11,0:06:52.07,Default,,0,0,0,,Кларк мені күнде жаттығуға апарады.
Dialogue: 0,0:06:52.24,0:06:54.58,Default,,0,0,0,,Менің мінезі қысқа, сөйлемейтін апам
Dialogue: 0,0:06:54.87,0:06:55.70,Default,,0,0,0,,Наги…
Dialogue: 0,0:06:56.54,0:06:57.58,Default,,0,0,0,,〈Қараңдар! 〉
Dialogue: 0,0:06:58.58,0:07:02.96,Default,,0,0,0,,〈Ол 14-ші ханшайым, Абигейл Ибрахим! 〉
Dialogue: 0,0:07:03.21,0:07:05.63,Default,,0,0,0,,Абигейл Ибрахим
Dialogue: 0,0:07:09.17,0:07:10.30,Default,,0,0,0,,Сол жігіт Умина
Dialogue: 0,0:07:19.56,0:07:21.35,Default,,0,0,0,,〈Енді тұр〉
Dialogue: 0,0:07:21.48,0:07:23.56,Default,,0,0,0,,<Ханшайыммен аудитория болайық>
Dialogue: 0,0:07:25.98,0:07:28.57,Default,,0,0,0,,О... мен мұндамын...
Dialogue: 0,0:07:28.69,0:07:30.82,Default,,0,0,0,,Біреудің тепкені маған қатты тиді.
Dialogue: 0,0:07:31.20,0:07:32.91,Default,,0,0,0,,Іс-әрекеттер кәсіби емес.
Dialogue: 0,0:07:33.03,0:07:34.78,Default,,0,0,0,,Ух...ха
Dialogue: 0,0:07:35.37,0:07:39.04,Default,,0,0,0,,Солай болса да, ол дәл Сэмге ұқсайды.
Dialogue: 0,0:07:39.45,0:07:41.33,Default,,0,0,0,,Жүр, сен жараланасың.
Dialogue: 0,0:07:41.46,0:07:43.37,Default,,0,0,0,,Ха, бұл мақтау.
Dialogue: 0,0:07:43.50,0:07:45.04,Default,,0,0,0,,Хаха...
Dialogue: 0,0:07:55.05,0:07:56.55,Default,,0,0,0,,…
Dialogue: 0,0:07:59.18,0:08:02.14,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:08:03.23,0:08:04.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:07.06,0:08:09.40,Default,,0,0,0,,Нағыз ханшайым
Dialogue: 0,0:08:09.53,0:08:11.61,Default,,0,0,0,,Бұл ең үлкен нәрсе.
Dialogue: 0,0:08:12.70,0:08:13.53,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:08:21.62,0:08:24.54,Default,,0,0,0,,Ибраһим әулетінің 14-ханшайымы
Dialogue: 0,0:08:25.17,0:08:26.00,Default,,0,0,0,,Иә
Dialogue: 0,0:08:26.17,0:08:28.42,Default,,0,0,0,,Мен оны өз көзіммен көрдім.
Dialogue: 0,0:08:28.54,0:08:29.92,Default,,0,0,0,,Жарайды, абайлайық.
Dialogue: 0,0:08:30.05,0:08:31.26,Default,,0,0,0,,Фу~
Dialogue: 0,0:08:33.51,0:08:34.55,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:08:35.18,0:08:36.14,Default,,0,0,0,,(Эдамама: ағылшын)
Dialogue: 0,0:08:36.89,0:08:37.85,Default,,0,0,0,,Абигейл
Dialogue: 0,0:08:38.43,0:08:39.35,Default,,0,0,0,,Жыл?
Dialogue: 0,0:08:39.56,0:08:40.56,Default,,0,0,0,,(Эдамама: ағылшын)
Dialogue: 0,0:08:40.68,0:08:41.52,Default,,0,0,0,,Он алты
Dialogue: 0,0:08:41.89,0:08:42.81,Default,,0,0,0,,Оны шешіңіз.
Dialogue: 0,0:08:43.02,0:08:44.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:44.14,0:08:45.52,Default,,0,0,0,,А... иә
Dialogue: 0,0:08:48.94,0:08:49.77,Default,,0,0,0,,〈Дөрекі! 〉
Dialogue: 0,0:08:50.15,0:08:51.19,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:51.32,0:08:52.15,Default,,0,0,0,,Жаса!
Dialogue: 0,0:08:57.66,0:08:59.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:06.62,0:09:07.67,Default,,0,0,0,,О...
Dialogue: 0,0:09:12.00,0:09:12.88,Default,,0,0,0,,Барлығы.
Dialogue: 0,0:09:14.17,0:09:15.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:15.42,0:09:16.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:18.14,0:09:18.97,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:09:19.72,0:09:21.89,Default,,0,0,0,,Эй, не, эй...
Dialogue: 0,0:09:29.40,0:09:30.23,Default,,0,0,0,,Айналыңыз
Dialogue: 0,0:09:30.86,0:09:31.82,Default,,0,0,0,,(Эдамама: ағылшын)
Dialogue: 0,0:09:35.19,0:09:37.61,Default,,0,0,0,,Хмм… мм… мм…
Dialogue: 0,0:09:42.70,0:09:43.58,Default,,0,0,0,,Қанша?
Dialogue: 0,0:09:44.41,0:09:46.46,Default,,0,0,0,,(Синтия: ағылшын)
Dialogue: 0,0:09:47.33,0:09:49.33,Default,,0,0,0,,Ол үшін қанша төлейсіз?
Dialogue: 0,0:09:50.96,0:09:52.00,Default,,0,0,0,,Фу~
Dialogue: 0,0:09:59.80,0:10:02.22,Default,,0,0,0,,(Синтия: ағылшын)
Dialogue: 0,0:10:02.35,0:10:04.31,Default,,0,0,0,,Бұл иен емес, солай ма?
Dialogue: 0,0:10:05.14,0:10:07.85,Default,,0,0,0,,Сөйлегеніңе абай бол, қызым.
Dialogue: 0,0:10:08.19,0:10:09.27,Default,,0,0,0,,Бірақ Төраға
Dialogue: 0,0:10:09.44,0:10:10.77,Default,,0,0,0,,Бұл өнімнің құны
Dialogue: 0,0:10:10.90,0:10:13.32,Default,,0,0,0,,Бұзылған ойыншық емес
Dialogue: 0,0:10:13.44,0:10:16.94,Default,,0,0,0,,Ибрагим отбасы оны кез келген бағамен қайтарып алатын.
Dialogue: 0,0:10:17.28,0:10:18.15,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:10:18.40,0:10:21.66,Default,,0,0,0,,Кейбір елдер де оны дипломатиялық карта ретінде алғысы келетініне сенімдімін.
Dialogue: 0,0:10:22.03,0:10:24.24,Default,,0,0,0,,Мен сіздің пікіріңізді тыңдамаймын.
Dialogue: 0,0:10:24.58,0:10:28.08,Default,,0,0,0,,(Синтия: ағылшын)
Dialogue: 0,0:10:28.46,0:10:31.29,Default,,0,0,0,,Сатып алмасаң, Шанхайға апарамыз дейді.
Dialogue: 0,0:10:32.75,0:10:33.67,Default,,0,0,0,,Аа...
Dialogue: 0,0:10:34.75,0:10:36.34,Default,,0,0,0,,Бұл жай ғана «таптан шыққанды ұру» ойыны емес пе?
Dialogue: 0,0:10:39.97,0:10:41.80,Default,,0,0,0,,Фу~
Dialogue: 0,0:10:44.43,0:10:45.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:46.93,0:10:47.77,Default,,0,0,0,,Ах
Dialogue: 0,0:10:49.94,0:10:53.40,Default,,0,0,0,,Менің ойымша, егер ол сәл жас болса, жақсырақ баға алар еді.
Dialogue: 0,0:10:59.40,0:11:00.78,Default,,0,0,0,,Мұны қалдырыңыз.
Dialogue: 0,0:11:03.82,0:11:05.79,Default,,0,0,0,,(Синтия: ағылшын)
Dialogue: 0,0:11:06.54,0:11:07.50,Default,,0,0,0,,Хаа…
Dialogue: 0,0:11:11.92,0:11:14.46,Default,,0,0,0,,Бұл сіз үшін арнайы бөлме.
Dialogue: 0,0:11:14.59,0:11:17.38,Default,,0,0,0,,Бұл әдетте менің ұйықтайтын бөлмем.
Dialogue: 0,0:11:18.92,0:11:21.76,Default,,0,0,0,,Жарайсың ба? Теледидар мен ойындар бар
Dialogue: 0,0:11:21.88,0:11:24.85,Default,,0,0,0,,Аа, бұл менің жеке меншігім, оны құртпауларыңызды өтінемін.
Dialogue: 0,0:11:25.14,0:11:26.97,Default,,0,0,0,,Соның бәрін кейінірек айтып беріңізші.
Dialogue: 0,0:11:27.35,0:11:28.31,Default,,0,0,0,,Иә
Dialogue: 0,0:11:28.43,0:11:31.48,Default,,0,0,0,,Жарайды, бүгін шаршаған шығарсың, ендеше жүре бер.
Dialogue: 0,0:11:34.36,0:11:35.44,Default,,0,0,0,,(құлыптау дыбысы)
Dialogue: 0,0:11:43.11,0:11:44.37,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:11:44.49,0:11:45.70,Default,,0,0,0,,Бақылау камераларына сенбеңіз
Dialogue: 0,0:11:46.33,0:11:48.33,Default,,0,0,0,,Айналаңызға сағатына бір рет қараңыз
Dialogue: 0,0:11:48.49,0:11:51.29,Default,,0,0,0,,Егер бірдеңе болса, біз Сагами шығанағында саяхаттаймыз.
Dialogue: 0,0:11:51.46,0:11:52.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:52.42,0:11:53.62,Default,,0,0,0,,Сагами шығанағы?
Dialogue: 0,0:11:53.79,0:11:54.63,Default,,0,0,0,,Өйткені ол сасық.
Dialogue: 0,0:11:54.75,0:11:57.21,Default,,0,0,0,,Шимамурадан киім сатып ал, мен киім ауыстырайын.
Dialogue: 0,0:11:57.84,0:11:59.92,Default,,0,0,0,,Түбіртекті де алуды ұмытпаңыз.
Dialogue: 0,0:12:01.42,0:12:02.30,Default,,0,0,0,,Иә
Dialogue: 0,0:12:02.84,0:12:03.68,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:12:12.27,0:12:13.19,Default,,0,0,0,,(еденге қойылған пластинаның дыбысы)
Dialogue: 0,0:12:13.31,0:12:14.27,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:12:20.44,0:12:21.90,Default,,0,0,0,,Тамақ ішесіз бе?
Dialogue: 0,0:12:22.32,0:12:23.57,Default,,0,0,0,,Менің өлгім келеді
Dialogue: 0,0:12:35.62,0:12:36.50,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:12:37.63,0:12:39.13,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:40.63,0:12:41.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:41.59,0:12:43.34,Default,,0,0,0,,Қайтадан қош келдіңіз, Эдамаме!
Dialogue: 0,0:12:43.47,0:12:44.88,Default,,0,0,0,,Жақсы жұмыс...
Dialogue: 0,0:12:45.13,0:12:47.51,Default,,0,0,0,,1 миллиард, бұл ең жақсы!
Dialogue: 0,0:12:47.64,0:12:49.39,Default,,0,0,0,,Бұл өте ауыр жұмыс болды, солай емес пе?
Dialogue: 0,0:12:50.39,0:12:53.23,Default,,0,0,0,,Сәлем, балалар, мұнда не істеп жатырсыңдар?
Dialogue: 0,0:12:54.06,0:12:54.89,Default,,0,0,0,,Аяқ киіммен
Dialogue: 0,0:12:55.23,0:12:56.40,Default,,0,0,0,,Бұл Татами
Dialogue: 0,0:12:56.52,0:12:57.40,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:12:57.52,0:12:58.65,Default,,0,0,0,,Секірме!
Dialogue: 0,0:12:58.77,0:13:00.86,Default,,0,0,0,,Қарашы, ауыр сөз айтпа.
Dialogue: 0,0:13:00.98,0:13:02.78,Default,,0,0,0,,Бұл емес!
Dialogue: 0,0:13:02.90,0:13:04.99,Default,,0,0,0,,Егер олар сенің менің досым екеніңді білсе, сені өлтіреді.
Dialogue: 0,0:13:05.11,0:13:06.36,Default,,0,0,0,,Қазір шығыңыз!
Dialogue: 0,0:13:06.61,0:13:08.82,Default,,0,0,0,,Түсіндім, түсіндім, сосын...
Dialogue: 0,0:13:09.20,0:13:10.95,Default,,0,0,0,,Мен сенен менің артымнан тазалауды өтіндім.
Dialogue: 0,0:13:11.08,0:13:12.12,Default,,0,0,0,,Тазалау?
Dialogue: 0,0:13:12.24,0:13:14.00,Default,,0,0,0,,Эбби қашып кетсін.
Dialogue: 0,0:13:14.21,0:13:16.58,Default,,0,0,0,,Сонымен, бұл жолы тапсырма аяқталды
Dialogue: 0,0:13:16.71,0:13:17.75,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,0:13:18.54,0:13:20.04,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:20.17,0:13:21.55,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:13:23.09,0:13:25.01,Default,,0,0,0,,Хаа~
Dialogue: 0,0:13:25.22,0:13:27.26,Default,,0,0,0,,(қонақ күлкі)
Dialogue: 0,0:13:27.38,0:13:28.55,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:29.01,0:13:33.56,Default,,0,0,0,,Мәселе мынада: әлгі қарт қаңбақ мұрасы кімге беріледі?
Dialogue: 0,0:13:33.68,0:13:36.06,Default,,0,0,0,,Бұл президент Ишигами емес пе?
Dialogue: 0,0:13:36.19,0:13:37.90,Default,,0,0,0,,Бұл сөзсіз.
Dialogue: 0,0:13:38.06,0:13:40.69,Default,,0,0,0,,Басқаша айтқанда, тағдырдың қызыл бауы
Dialogue: 0,0:13:42.36,0:13:44.94,Default,,0,0,0,,Сол себепті, әлгі қарт қаңбақ
Dialogue: 0,0:13:45.61,0:13:48.49,Default,,0,0,0,,Хекора Хеко Хеко Бұл Хеко.
Dialogue: 0,0:13:49.03,0:13:50.82,Default,,0,0,0,,Бұл өте жаман...
Dialogue: 0,0:13:51.16,0:13:52.91,Default,,0,0,0,,Менің де депрессияға түскім келеді
Dialogue: 0,0:13:53.16,0:13:54.79,Default,,0,0,0,,Жоқ! Дұрыс па?
Dialogue: 0,0:13:56.87,0:13:58.87,Default,,0,0,0,,Нодогоши~
Dialogue: 0,0:13:59.25,0:14:01.46,Default,,0,0,0,,Бірақ сіз көріндіңіз
Dialogue: 0,0:14:01.84,0:14:02.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:03.09,0:14:04.46,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:04.67,0:14:08.09,Default,,0,0,0,,Сізді кемпір жақсы көреді, солай ма?
Dialogue: 0,0:14:08.30,0:14:10.14,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:14:10.26,0:14:12.22,Default,,0,0,0,,Мен жаңадан келген адаммын.
Dialogue: 0,0:14:12.35,0:14:13.47,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:13.60,0:14:18.60,Default,,0,0,0,,Мен бұрынғыдан бері еңбек етіп келемін.
Dialogue: 0,0:14:18.85,0:14:23.69,Default,,0,0,0,,Созақудың ақырында... болатынына сенімдімін.
Dialogue: 0,0:14:23.94,0:14:26.69,Default,,0,0,0,,
Dialogue: 0,0:14:27.57,0:14:28.99,Default,,0,0,0,,Президент
Dialogue: 0,0:14:34.99,0:14:35.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:36.54,0:14:38.41,Default,,0,0,0,,
Dialogue: 0,0:14:40.67,0:14:41.50,Default,,0,0,0,,(Тақтаны соғу дыбысы)
Dialogue: 0,0:14:41.83,0:14:42.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:46.38,0:14:48.13,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:14:49.76,0:14:50.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:53.14,0:14:54.85,Default,,0,0,0,,Масамун күні?
Dialogue: 0,0:14:55.06,0:14:59.69,Default,,0,0,0,,Мен осылай көрінсем де, мен «Абиция» сериясына қызығушылық танытпаймын.
Dialogue: 0,0:14:59.94,0:15:01.23,Default,,0,0,0,,Менің ағам – ескі мектептің адамы – алдау мен айла-шарғы арқылы жеңетіндерден—
Dialogue: 0,0:15:01.35,0:15:04.82,Default,,0,0,0,,Масамуна өз әкесін өлтірді.
Dialogue: 0,0:15:06.65,0:15:07.65,Default,,0,0,0,,Ах~
Dialogue: 0,0:15:09.03,0:15:09.99,Default,,0,0,0,,Хаа…
Dialogue: 0,0:15:10.36,0:15:12.62,Default,,0,0,0,,
Dialogue: 0,0:15:26.42,0:15:27.84,Default,,0,0,0,,
Dialogue: 0,0:15:28.17,0:15:29.67,Default,,0,0,0,,(баспалдақтан түскен аяқ дыбыстары)
Dialogue: 0,0:15:51.90,0:15:53.74,Default,,0,0,0,,(кеспенің шырылдаған дыбысы)
Dialogue: 0,0:15:59.04,0:16:01.21,Default,,0,0,0,,Жүйкелері жуан ханшайым.
Dialogue: 0,0:16:01.41,0:16:02.29,Default,,0,0,0,,(сорпаның шырылдаған дыбысы)
Dialogue: 0,0:16:03.04,0:16:04.75,Default,,0,0,0,,Хаа~
Dialogue: 0,0:16:06.42,0:16:07.54,Default,,0,0,0,,ауыстырыңыз
Dialogue: 0,0:16:07.67,0:16:08.50,Default,,0,0,0,,О
Dialogue: 0,0:16:08.63,0:16:10.88,Default,,0,0,0,,Жарайды, мен айналама бір қарап алайын деп ойлаймын.
Dialogue: 0,0:16:11.01,0:16:12.05,Default,,0,0,0,,О, жарайды.
Dialogue: 0,0:16:13.01,0:16:15.55,Default,,0,0,0,,Мен келемін, сондықтан бүгін үйге қайтыңыз.
Dialogue: 0,0:16:15.68,0:16:16.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:16.64,0:16:17.68,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:16:18.14,0:16:20.27,Default,,0,0,0,,Сіз маған әрқашан көп нәрсені үйретесіз.
Dialogue: 0,0:16:20.39,0:16:21.64,Default,,0,0,0,,Біз өзара.
Dialogue: 0,0:16:22.81,0:16:23.77,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:16:33.40,0:16:34.86,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:16:39.08,0:16:40.37,Default,,0,0,0,,Эбби, жүгір!
Dialogue: 0,0:16:40.49,0:16:41.50,Default,,0,0,0,,Тағы біраз
Dialogue: 0,0:16:41.62,0:16:43.25,Default,,0,0,0,,Өзіңді алдама, кеттік!
Dialogue: 0,0:16:51.30,0:16:52.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:52.67,0:16:53.51,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:55.97,0:16:56.80,Default,,0,0,0,,Эй!
Dialogue: 0,0:16:59.51,0:17:00.93,Default,,0,0,0,,Йоккойшо
Dialogue: 0,0:17:01.27,0:17:03.48,Default,,0,0,0,,Қош келдіңіз, киген киіміңізге не болды?
Dialogue: 0,0:17:03.60,0:17:04.94,Default,,0,0,0,,Киімді жуу
Dialogue: 0,0:17:05.10,0:17:05.94,Default,,0,0,0,,Ал екіншісі ше?
Dialogue: 0,0:17:08.69,0:17:10.57,Default,,0,0,0,,Эдамаме, тез шық
Dialogue: 0,0:17:13.49,0:17:15.82,Default,,0,0,0,,Қызықсыз нәрселерді айтпа
Dialogue: 0,0:17:16.11,0:17:19.12,Default,,0,0,0,,Барлық ұсталған балаларды бірге босатайық.
Dialogue: 0,0:17:19.24,0:17:20.74,Default,,0,0,0,,Міне келдік
Dialogue: 0,0:17:21.08,0:17:22.62,Default,,0,0,0,,Және қанша?
Dialogue: 0,0:17:22.75,0:17:24.58,Default,,0,0,0,,Біз әкелген бес адаммен
Dialogue: 0,0:17:24.71,0:17:27.37,Default,,0,0,0,,Бұрынғы 5 адамды қосқанда 10 адам.
Dialogue: 0,0:17:27.75,0:17:29.04,Default,,0,0,0,,Бұл 5 орындық
Dialogue: 0,0:17:29.17,0:17:30.63,Default,,0,0,0,,Кемеге мінсек те, екі адам ғана қалды.
Dialogue: 0,0:17:30.75,0:17:32.05,Default,,0,0,0,,Сіз көбірек міне аласыз!
Dialogue: 0,0:17:32.38,0:17:34.05,Default,,0,0,0,,Бұл жол қозғалысы ережесін бұзу.
Dialogue: 0,0:17:34.17,0:17:35.09,Default,,0,0,0,,Ұнамаса, бар!
Dialogue: 0,0:17:35.22,0:17:37.05,Default,,0,0,0,,Біз қашып кете аламыз!
Dialogue: 0,0:17:37.55,0:17:39.51,Default,,0,0,0,,Ааа, солай деп ойлаймын.
Dialogue: 0,0:17:39.64,0:17:41.06,Default,,0,0,0,,Маған айтпа.
Dialogue: 0,0:17:44.89,0:17:45.73,Default,,0,0,0,,Ах
Dialogue: 0,0:17:47.39,0:17:48.31,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:55.49,0:17:56.40,Default,,0,0,0,,Эбби!
Dialogue: 0,0:17:57.70,0:17:59.03,Default,,0,0,0,,Сол бөлмені сұраңыз.
Dialogue: 0,0:18:01.49,0:18:02.33,Default,,0,0,0,,Оян!
Dialogue: 0,0:18:02.79,0:18:04.91,Default,,0,0,0,,Барлығы ояныңдар! Жүгіріп кету!
Dialogue: 0,0:18:05.16,0:18:06.91,Default,,0,0,0,,Кел, оян!
Dialogue: 0,0:18:07.12,0:18:09.42,Default,,0,0,0,,Қараңызшы, сіз боссыз.
Dialogue: 0,0:18:09.54,0:18:11.17,Default,,0,0,0,,Менімен бірге жүр!
Dialogue: 0,0:18:12.00,0:18:14.30,Default,,0,0,0,,Don't be distracted, hurry!
Dialogue: 0,0:18:15.42,0:18:17.80,Default,,0,0,0,,Не болды? Сіз қашып кете аласыз!
Dialogue: 0,0:18:26.35,0:18:27.43,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:18:29.98,0:18:30.81,Default,,0,0,0,,Ах
Dialogue: 0,0:18:31.11,0:18:31.94,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:18:32.27,0:18:33.86,Default,,0,0,0,,Мен сатылып кетті!
Dialogue: 0,0:18:33.98,0:18:34.82,Default,,0,0,0,,Қайда?
Dialogue: 0,0:18:34.94,0:18:35.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:36.11,0:18:38.32,Default,,0,0,0,,Сен қайда қашасың?
Dialogue: 0,0:18:41.37,0:18:45.12,Default,,0,0,0,,Ата-анамыз бізді тастап кеткен немесе сатып жібергендіктен бәріміз осындамыз.
Dialogue: 0,0:18:45.91,0:18:50.50,Default,,0,0,0,,Бізді ешкім ойламайды, қайда барсақ та, біз тиесілі емеспіз
Dialogue: 0,0:18:51.13,0:18:54.84,Default,,0,0,0,,Тірі ме, өлі ме бәрібір.
Dialogue: 0,0:18:56.13,0:18:57.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:02.64,0:19:04.64,Default,,0,0,0,,О, ана жерде.
Dialogue: 0,0:19:07.89,0:19:08.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:10.35,0:19:11.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:12.86,0:19:13.98,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:19:17.61,0:19:21.03,Default,,0,0,0,,(Тарих ойыны шайқас дыбыстары)
Dialogue: 0,0:19:21.16,0:19:21.99,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:28.54,0:19:29.75,Default,,0,0,0,,(Ағын су дыбысы)
Dialogue: 0,0:19:29.87,0:19:32.04,Default,,0,0,0,,Не, әжетханадасың ба?
Dialogue: 0,0:19:32.25,0:19:34.25,Default,,0,0,0,,Сіз бір нәрсені ұмыттыңыз ба?
Dialogue: 0,0:19:34.71,0:19:37.63,Default,,0,0,0,,Әй, одан гөрі ханшайым дәл қазір...
Dialogue: 0,0:19:39.97,0:19:41.34,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:19:41.76,0:19:44.05,Default,,0,0,0,,Мен кезекші боламын.
Dialogue: 0,0:19:44.26,0:19:46.05,Default,,0,0,0,,Үйге бару қиынға түсті.
Dialogue: 0,0:19:47.97,0:19:48.93,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:50.10,0:19:51.14,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:19:55.36,0:19:56.98,Default,,0,0,0,,Фу~
Dialogue: 0,0:19:59.53,0:20:01.74,Default,,0,0,0,,Хмм, жоқ, темекі...
Dialogue: 0,0:20:01.86,0:20:02.70,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:11.00,0:20:13.79,Default,,0,0,0,,
Dialogue: 0,0:20:13.92,0:20:14.75,Default,,0,0,0,,Хэ-хэ
Dialogue: 0,0:20:28.06,0:20:31.68,Default,,0,0,0,,Ата-анамыз бізді тастап кеткен немесе сатып жібергендіктен бәріміз осындамыз.
Dialogue: 0,0:20:32.39,0:20:34.69,Default,,0,0,0,,Қайда барсаң да, тиесілі жер жоқ
Dialogue: 0,0:20:51.04,0:20:57.04,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.78,0:22:50.78,Default,,0,0,0,,~♪
Dialogue: 0,0:22:52.28,0:22:58.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory