Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.90,0:00:03.43,Default,,0000,0000,0000,,Аяқ иық енінен бөлек
Dialogue: 0,0:00:03.47,0:00:05.97,Default,,0000,0000,0000,,Жаныңда қалып, жауды атып таста
Dialogue: 0,0:00:05.97,0:00:08.07,Default,,0000,0000,0000,,Бұл жерде кішкентай саусақ маңызды.
Dialogue: 0,0:00:08.34,0:00:11.68,Default,,0000,0000,0000,,Онда соғу керек, соғу керек, соғу керек...
Dialogue: 0,0:00:11.95,0:00:13.61,Default,,0000,0000,0000,,Кәкең!
Dialogue: 0,0:00:13.92,0:00:15.28,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:00:15.32,0:00:18.38,Default,,0000,0000,0000,,Солды басқаратын адам әлемді басқарады.
Dialogue: 0,0:00:20.05,0:00:23.89,Default,,0000,0000,0000,,Параметрлерді бастапқы орнату қиын.
Dialogue: 0,0:00:24.86,0:00:26.66,Default,,0000,0000,0000,,Біз тағы да ойындар туралы айтамыз ба?
Dialogue: 0,0:00:28.23,0:00:30.20,Default,,0000,0000,0000,,Так-кун, сен не істеп жатырсың?
Dialogue: 0,0:00:30.63,0:00:31.56,Default,,0000,0000,0000,,Үйге тапсырма
Dialogue: 0,0:00:31.60,0:00:33.73,Default,,0000,0000,0000,,Неге үйде жасамайсың?
Dialogue: 0,0:00:34.34,0:00:35.60,Default,,0000,0000,0000,,Өйткені бұл керемет емес
Dialogue: 0,0:00:35.64,0:00:38.47,Default,,0000,0000,0000,,Мамимиді де істей аласың ба?
Dialogue: 0,0:00:39.57,0:00:41.10,Default,,0000,0000,0000,,Менің қолым төңкеріліп тұр
Dialogue: 0,0:00:44.98,0:00:47.47,Default,,0000,0000,0000,,Мен Таккунның да бейсбол ойнағанын қалаймын.
Dialogue: 0,0:00:48.62,0:00:51.02,Default,,0000,0000,0000,,Неліктен сіз әрқашан жарғанақты алып жүресіз?
Dialogue: 0,0:00:51.62,0:00:54.92,Default,,0000,0000,0000,,Мен неге үнемі осында келемін?
Dialogue: 0,0:00:56.02,0:00:57.69,Default,,0000,0000,0000,,Бұл дұрыс емес...
Dialogue: 0,0:00:58.13,0:01:00.36,Default,,0000,0000,0000,,Иә? Неліктен?
Dialogue: 0,0:01:00.36,0:01:01.95,Default,,0000,0000,0000,,Бұл оңай.
Dialogue: 0,0:01:11.94,0:01:13.24,Default,,0000,0000,0000,,Темекі иісі бар
Dialogue: 0,0:01:13.27,0:01:15.07,Default,,0000,0000,0000,,Мен темекі шекпеймін.
Dialogue: 0,0:01:18.98,0:01:22.21,Default,,0000,0000,0000,,Эй, сен неге үнемі осылай істейсің...
Dialogue: 0,0:01:23.05,0:01:24.38,Default,,0000,0000,0000,,Құлақ құлақшалары…
Dialogue: 0,0:01:24.42,0:01:26.15,Default,,0000,0000,0000,,Құлақ? …Ита!
Dialogue: 0,0:01:26.59,0:01:29.22,Default,,0000,0000,0000,,Олай етпесең, Мәмими толып кетеді.
Dialogue: 0,0:01:29.26,0:01:32.06,Default,,0000,0000,0000,,Ол асып кетсе не болады?
Dialogue: 0,0:01:32.19,0:01:35.69,Default,,0000,0000,0000,,Бұл керемет болатынына сенімдімін
Dialogue: 0,0:01:44.34,0:01:48.67,Default,,0000,0000,0000,,Таңғажайып ештеңе болмайды, қарапайым нәрселер ғана болады.
Dialogue: 0,0:01:49.98,0:01:53.78,Default,,0000,0000,0000,,Біздің қаладан көрінетін күлкілі үлкен зауыт
Dialogue: 0,0:01:54.72,0:01:58.45,Default,,0000,0000,0000,,Медициналық құрал-жабдықтарды өндіруші «Medical Mechanica» зауыты салынған кезде...
Dialogue: 0,0:01:58.69,0:02:00.78,Default,,0000,0000,0000,,Үлкендер әбігерге түсті.
Dialogue: 0,0:02:09.16,0:02:12.26,Default,,0000,0000,0000,,Күн сайын белгіленген уақытта ақ түтін шығарылады...
Dialogue: 0,0:02:12.80,0:02:15.83,Default,,0000,0000,0000,,Маған зұлым елік сияқты көрінеді.
Dialogue: 0,0:02:16.57,0:02:20.34,Default,,0000,0000,0000,,Жіңішке жайылып, қаланы жауып тұрады.
Dialogue: 0,0:02:41.10,0:02:43.15,Default,,0000,0000,0000,,Мен қышқыл тамақты ұнатпаймын.
Dialogue: 0,0:02:47.84,0:02:49.89,Default,,0000,0000,0000,,Маған хабарлама келді, не істеуім керек?
Dialogue: 0,0:02:50.27,0:02:52.07,Default,,0000,0000,0000,,Таңғышпен тығылу?
Dialogue: 0,0:02:52.84,0:02:53.64,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:02:53.67,0:02:54.61,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:02:54.64,0:02:56.30,Default,,0000,0000,0000,,Нені айтып тұрсың, Таккун?
Dialogue: 0,0:02:56.61,0:02:58.60,Default,,0000,0000,0000,,Оның жартысы қалды.
Dialogue: 0,0:03:15.53,0:03:16.86,Default,,0000,0000,0000,,Осымен
Dialogue: 0,0:03:18.73,0:03:19.67,Default,,0000,0000,0000,,…
Dialogue: 0,0:03:19.87,0:03:20.96,Default,,0000,0000,0000,,Сол жерде...
Dialogue: 0,0:03:38.72,0:03:39.75,Default,,0000,0000,0000,,Итадаки Марс!
Dialogue: 0,0:03:39.75,0:03:42.59,Default,,0000,0000,0000,,Итадаки Марс!
Dialogue: 0,0:03:48.06,0:03:49.15,Default,,0000,0000,0000,,Ikinari?
Dialogue: 0,0:03:53.90,0:03:54.99,Default,,0000,0000,0000,,Так-кун!
Dialogue: 0,0:03:55.10,0:03:56.36,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:04:01.38,0:04:03.31,Default,,0000,0000,0000,,Төсекті тоқтатыңыз
Dialogue: 0,0:04:04.45,0:04:08.28,Default,,0000,0000,0000,,Таро-кун жай ғана басын соқты, сондықтан оны қатты қозғалтпаған дұрыс.
Dialogue: 0,0:04:13.49,0:04:15.18,Default,,0000,0000,0000,,Бірақ бұл Таро емес...
Dialogue: 0,0:04:21.20,0:04:22.29,Default,,0000,0000,0000,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,0:04:22.43,0:04:25.89,Default,,0000,0000,0000,,Бұл бала Таро сияқты мүлде өлді.
Dialogue: 0,0:04:25.93,0:04:28.06,Default,,0000,0000,0000,,Сондықтан бұл Таро емес...
Dialogue: 0,0:04:28.84,0:04:29.77,Default,,0000,0000,0000,,- Оның аты Наота-кун.
Dialogue: 0,0:04:29.77,0:04:30.64,Default,,0000,0000,0000,,- Мен оны өлтірдім - Оның аты Наота-кун.
Dialogue: 0,0:04:30.64,0:04:30.91,Default,,0000,0000,0000,,- өлтірілді
Dialogue: 0,0:04:30.91,0:04:31.57,Default,,0000,0000,0000,,- Мен өлтірдім - Мамими "Наота" мен "Таккунда" "Та" дейді...
Dialogue: 0,0:04:31.57,0:04:31.67,Default,,0000,0000,0000,,- Мамими «Наота» мен «Таккунда» «Та» дейді...
Dialogue: 0,0:04:31.67,0:04:33.88,Default,,0000,0000,0000,,- Кончикушоны табу үшін қиналдым - Мамими "Наота" мен "Таккунда" "Та" дейді...
Dialogue: 0,0:04:33.88,0:04:36.40,Default,,0000,0000,0000,,Мен оны өлтірдім!
Dialogue: 0,0:04:36.51,0:04:37.74,Default,,0000,0000,0000,,Мені тез өлтір...
Dialogue: 0,0:04:38.51,0:04:39.74,Default,,0000,0000,0000,,Мені ұрып өлтір...?
Dialogue: 0,0:04:39.98,0:04:42.35,Default,,0000,0000,0000,,Жоқ, дәл...?
Dialogue: 0,0:04:45.75,0:04:48.62,Default,,0000,0000,0000,,Жоқ, жоқ, иә...
Dialogue: 0,0:04:56.20,0:04:57.56,Default,,0000,0000,0000,,Ikikaere!
Dialogue: 0,0:05:15.35,0:05:17.65,Default,,0000,0000,0000,,Қане, қатал емес пе?
Dialogue: 0,0:05:18.05,0:05:20.28,Default,,0000,0000,0000,,Тыныс алу керек.
Dialogue: 0,0:05:20.56,0:05:22.58,Default,,0000,0000,0000,,Оның көптеген жолақтары бар.
Dialogue: 0,0:05:22.79,0:05:25.69,Default,,0000,0000,0000,,Иә! Бұл жай ғана өздігінен баяу қозғала ма?
Dialogue: 0,0:05:33.77,0:05:35.53,Default,,0000,0000,0000,,Иә! Таро өмірге қайта оралды!
Dialogue: 0,0:05:35.57,0:05:37.13,Default,,0000,0000,0000,,Сондықтан бұл Таро емес.
Dialogue: 0,0:05:37.34,0:05:38.00,Default,,0000,0000,0000,,А... солай ма?
Dialogue: 0,0:05:38.21,0:05:40.40,Default,,0000,0000,0000,,Бұл Таро болмағаны жақсы.
Dialogue: 0,0:05:40.54,0:05:44.14,Default,,0000,0000,0000,,Егер бұл Таро болса, қауіпті болар еді. Ол өлетін еді.
Dialogue: 0,0:05:44.55,0:05:45.67,Default,,0000,0000,0000,,Бұл твиттер
Dialogue: 0,0:05:46.58,0:05:47.67,Default,,0000,0000,0000,,Мен!
Dialogue: 0,0:05:50.38,0:05:51.72,Default,,0000,0000,0000,,Соңғы соққы?
Dialogue: 0,0:05:57.12,0:05:59.22,Default,,0000,0000,0000,,Йойшо...
Dialogue: 0,0:06:00.46,0:06:02.99,Default,,0000,0000,0000,,Не? Ол шықпайды
Dialogue: 0,0:06:04.13,0:06:05.43,Default,,0000,0000,0000,,Тағы бір рет көрейік пе?
Dialogue: 0,0:06:05.47,0:06:06.69,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:06:07.87,0:06:10.80,Default,,0000,0000,0000,,Мен сіздің басыңыздан ұрып жатырмын, сондықтан оны абайсызда жылжытпаңыз.
Dialogue: 0,0:06:16.44,0:06:17.81,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:17.85,0:06:21.25,Default,,0000,0000,0000,,... жасанды тыныс алу дегенді қалай түсінесіңдер?
Dialogue: 0,0:06:21.32,0:06:22.75,Default,,0000,0000,0000,,Оны жібермеуім керек еді....
Dialogue: 0,0:06:24.25,0:06:26.19,Default,,0000,0000,0000,,Тіліңізді салдыңыз ба?
Dialogue: 0,0:06:26.82,0:06:28.02,Default,,0000,0000,0000,,Пайдасыз!
Dialogue: 0,0:06:28.06,0:06:29.72,Default,,0000,0000,0000,,Не айтып тұрсың!
Dialogue: 0,0:06:36.96,0:06:38.30,Default,,0000,0000,0000,,жылдам
Dialogue: 0,0:06:39.33,0:06:41.39,Default,,0000,0000,0000,,Ол кезде оның жасы жиырмадан асқан болатын.
Dialogue: 0,0:06:42.67,0:06:44.23,Default,,0000,0000,0000,,Ауруханаға барғыңыз келе ме?
Dialogue: 0,0:06:44.27,0:06:47.10,Default,,0000,0000,0000,,Іштей өспеген ақымақ ересек адам.
Dialogue: 0,0:06:48.34,0:06:49.81,Default,,0000,0000,0000,,Ита соо
Dialogue: 0,0:06:54.65,0:06:56.64,Default,,0000,0000,0000,,Қалай қарасаң да, бұл кесек емес...
Dialogue: 0,0:06:56.72,0:06:59.19,Default,,0000,0000,0000,,Осыған байланысты мен ауруханаға бара алмаймын.
Dialogue: 0,0:07:07.46,0:07:09.33,Default,,0000,0000,0000,,Оны ұстап тұру дұрыс па?
Dialogue: 0,0:07:10.03,0:07:12.70,Default,,0000,0000,0000,,Ах! Ертең мектеп туралы не істеуім керек?
Dialogue: 0,0:07:17.00,0:07:18.70,Default,,0000,0000,0000,,Тыңдыңыз Сіз естідіңіз бе? шыққанын естідім.
Dialogue: 0,0:07:19.04,0:07:20.97,Default,,0000,0000,0000,,Біртүрлі екен, маған жараспайды
Dialogue: 0,0:07:21.58,0:07:23.48,Default,,0000,0000,0000,,Сіз бірдеңені жасырып тұрсыз ба? …бұл
Dialogue: 0,0:07:24.95,0:07:26.34,Default,,0000,0000,0000,,Лас жігіт
Dialogue: 0,0:07:26.38,0:07:28.68,Default,,0000,0000,0000,,Наота Наота! Сен білесің бе?
Dialogue: 0,0:07:28.88,0:07:29.45,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:07:29.45,0:07:30.28,Default,,0000,0000,0000,,Веспа әйелі
Dialogue: 0,0:07:30.58,0:07:31.22,Default,,0000,0000,0000,,Веспа... ара әйел?
Dialogue: 0,0:07:32.79,0:07:33.89,Default,,0000,0000,0000,,- Гитара бар
Dialogue: 0,0:07:33.89,0:07:35.29,Default,,0000,0000,0000,,- Юсаку мотоцикліне міну - Гитара алып жүру
Dialogue: 0,0:07:35.36,0:07:36.48,Default,,0000,0000,0000,,No, but
Dialogue: 0,0:07:36.59,0:07:39.08,Default,,0000,0000,0000,,Екі топ қызды өте ащы карри нанымен ұстағаны айтылды.
Dialogue: 0,0:07:39.13,0:07:40.06,Default,,0000,0000,0000,,Өте ащы?
Dialogue: 0,0:07:40.19,0:07:42.59,Default,,0000,0000,0000,,Содан кейін, ол адам маған шаншу бергенде,
Dialogue: 0,0:07:42.70,0:07:45.86,Default,,0000,0000,0000,,Жамандық жасағандарға Шируши шайтан көрінеді дейді.
Dialogue: 0,0:07:46.43,0:07:47.67,Default,,0000,0000,0000,,Жаман деген не?
Dialogue: 0,0:07:47.77,0:07:49.87,Default,,0000,0000,0000,,Жоқ, дұрыс...
Dialogue: 0,0:07:49.87,0:07:51.41,Default,,0000,0000,0000,,Бұзық нәрсе
Dialogue: 0,0:07:52.64,0:07:53.77,Default,,0000,0000,0000,,Бұзық...?
Dialogue: 0,0:07:54.18,0:07:55.84,Default,,0000,0000,0000,,Бұл көгерудің қандай түрі?
Dialogue: 0,0:07:56.14,0:07:57.34,Default,,0000,0000,0000,,Бұл шайтанның Ширушиі!
Dialogue: 0,0:07:57.48,0:07:58.64,Default,,0000,0000,0000,,Керемет, маған да көрсет!
Dialogue: 0,0:07:58.68,0:07:59.91,Default,,0000,0000,0000,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:07:59.95,0:08:01.02,Default,,0000,0000,0000,,Көрдің бе, Наота?
Dialogue: 0,0:08:01.02,0:08:01.95,Default,,0000,0000,0000,,Сізге шаншу болды ма?
Dialogue: 0,0:08:01.98,0:08:03.14,Default,,0000,0000,0000,,Жыныстық қатынас! Наота тентек!
Dialogue: 0,0:08:03.18,0:08:03.91,Default,,0000,0000,0000,,Мен білмеймін!
Dialogue: 0,0:08:03.95,0:08:05.15,Default,,0000,0000,0000,,Сізге қай жерде соққы болды?
Dialogue: 0,0:08:05.15,0:08:05.69,Default,,0000,0000,0000,,- Жыныстық қатынас! - Бұл қайда? Айтыңызшы.
Dialogue: 0,0:08:05.69,0:08:06.58,Default,,0000,0000,0000,,- Ол қайда? Айтыңызшы.
Dialogue: 0,0:08:06.62,0:08:08.18,Default,,0000,0000,0000,,Керемет ештеңе жоқ
Dialogue: 0,0:08:08.46,0:08:10.75,Default,,0000,0000,0000,,Тек қарапайым нәрселер болады
Dialogue: 0,0:08:11.23,0:08:13.19,Default,,0000,0000,0000,,Демек, бұл жаза емес
Dialogue: 0,0:08:13.66,0:08:17.53,Default,,0000,0000,0000,,Самедзима Мамимимен кездесу қалыпты жағдай.
Dialogue: 0,0:08:20.00,0:08:22.09,Default,,0000,0000,0000,,Сабақтан кейін мен ауруханаға баруды шештім.
Dialogue: 0,0:08:22.84,0:08:24.60,Default,,0000,0000,0000,,Ара әйелдің бұған қатысы жоқ.
Dialogue: 0,0:08:29.24,0:08:32.04,Default,,0000,0000,0000,,Хмм, бұл дұрыс сияқты.
Dialogue: 0,0:08:32.91,0:08:36.01,Default,,0000,0000,0000,,Әй, кешеден бері не болды? Бірдеңе болған жоқ па?
Dialogue: 0,0:08:36.82,0:08:40.12,Default,,0000,0000,0000,,Эй, бірдеңе болды, солай ма? Біртүрлі нәрсе...
Dialogue: 0,0:08:40.69,0:08:42.35,Default,,0000,0000,0000,,Бұл не қызық?
Dialogue: 0,0:08:42.49,0:08:44.39,Default,,0000,0000,0000,,Бұл не, безеу?
Dialogue: 0,0:08:44.96,0:08:46.98,Default,,0000,0000,0000,,Біртүрлі екен, маған жараспайды
Dialogue: 0,0:08:47.70,0:08:50.06,Default,,0000,0000,0000,,Сен бірдеңені жасырып тұрған сияқтысың, мияу.
Dialogue: 0,0:09:04.15,0:09:06.34,Default,,0000,0000,0000,,«Фликтник Крипп Вебер синдромы»
Dialogue: 0,0:09:07.31,0:09:09.18,Default,,0000,0000,0000,,Тегін? Талшын?
Dialogue: 0,0:09:09.62,0:09:12.05,Default,,0000,0000,0000,,«Жасөспірімдік психогендік дерматосклероз»
Dialogue: 0,0:09:12.29,0:09:15.65,Default,,0000,0000,0000,,Кішкентай болсаң да тым қатты итерсең мүйізі шығатын ауру.
Dialogue: 0,0:09:16.49,0:09:18.72,Default,,0000,0000,0000,,Бұл өтірік! Мен бұл туралы ешқашан естіген емеспін
Dialogue: 0,0:09:18.96,0:09:19.95,Default,,0000,0000,0000,,Қараңыз, жас ханым.
Dialogue: 0,0:09:20.26,0:09:23.03,Default,,0000,0000,0000,,...Ал нақты жағдай ше?
Dialogue: 0,0:09:23.03,0:09:24.90,Default,,0000,0000,0000,,Бансуко астында…
Dialogue: 0,0:09:28.07,0:09:29.70,Default,,0000,0000,0000,,Неге мұндасың?
Dialogue: 0,0:09:30.04,0:09:32.03,Default,,0000,0000,0000,,Медбике қашып бара жатыр
Dialogue: 0,0:09:33.04,0:09:35.27,Default,,0000,0000,0000,,Мейірбике болып қалыңыз
Dialogue: 0,0:09:36.61,0:09:38.34,Default,,0000,0000,0000,,Енді сізді жайлы сезінетін медбике.
Dialogue: 0,0:09:45.32,0:09:47.49,Default,,0000,0000,0000,,Иә? Қайда бардың?
Dialogue: 0,0:09:47.99,0:09:49.22,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:09:50.02,0:09:52.93,Default,,0000,0000,0000,,Сәлем Таро-кун
Dialogue: 0,0:09:58.93,0:10:01.60,Default,,0000,0000,0000,,Фото? Қарау үшін қиналудың қажеті жоқ
Dialogue: 0,0:10:01.87,0:10:03.96,Default,,0000,0000,0000,,Бұл жерде ондай ештеңе жоқ.
Dialogue: 0,0:10:05.54,0:10:08.13,Default,,0000,0000,0000,,Мен білмеймін! Достарыңызбен ойнаңыз!
Dialogue: 0,0:10:27.63,0:10:29.49,Default,,0000,0000,0000,,Мен ағамды армандадым.
Dialogue: 0,0:10:29.96,0:10:31.93,Default,,0000,0000,0000,,Түсімде ағамның әткеншегі
Dialogue: 0,0:10:32.40,0:10:34.89,Default,,0000,0000,0000,,Дәл сол күндер мен аңсағандай
Dialogue: 0,0:10:49.15,0:10:51.34,Default,,0000,0000,0000,,Нао! Бұл тамақ!
Dialogue: 0,0:11:01.66,0:11:03.63,Default,,0000,0000,0000,,Сіз күндізгі Vespa әйелсіз!
Dialogue: 0,0:11:03.66,0:11:05.03,Default,,0000,0000,0000,,Не деп айқайлап тұрсың?
Dialogue: 0,0:11:05.07,0:11:06.50,Default,,0000,0000,0000,,Тезірек отырыңыз.
Dialogue: 0,0:11:06.60,0:11:07.50,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:08.84,0:11:11.53,Default,,0000,0000,0000,,А... Мен бүгіннен бастап осында жұмыс істеймін, Харухара...
Dialogue: 0,0:11:11.67,0:11:13.23,Default,,0000,0000,0000,,Regards, Haruko
Dialogue: 0,0:11:15.18,0:11:17.14,Default,,0000,0000,0000,,Әкемді басып қалды.
Dialogue: 0,0:11:17.18,0:11:18.17,Default,,0000,0000,0000,,By bike?
Dialogue: 0,0:11:18.38,0:11:19.97,Default,,0000,0000,0000,,Өлгенімді қалаймын
Dialogue: 0,0:11:20.01,0:11:22.88,Default,,0000,0000,0000,,Мен қайын атама осылай көмекші жалдадым...
Dialogue: 0,0:11:22.92,0:11:24.78,Default,,0000,0000,0000,,Ата, денеңіз жақсы ма?
Dialogue: 0,0:11:24.89,0:11:25.85,Default,,0000,0000,0000,,Иә! Үй қызметкері?
Dialogue: 0,0:11:26.25,0:11:27.32,Default,,0000,0000,0000,,Үй қызметкері?
Dialogue: 0,0:11:27.32,0:11:30.55,Default,,0000,0000,0000,,Үй қызметкері қарап тұрды... Қызбен қиналып жүрген Таро.
Dialogue: 0,0:11:30.69,0:11:31.59,Default,,0000,0000,0000,,Кури Кури Чичи?
Dialogue: 0,0:11:31.59,0:11:32.62,Default,,0000,0000,0000,,Сондықтан бұл Таро емес!
Dialogue: 0,0:11:32.69,0:11:33.96,Default,,0000,0000,0000,,Шыңырау!
Dialogue: 0,0:11:34.86,0:11:36.42,Default,,0000,0000,0000,,Мынау мектеп оқушысы кім?
Dialogue: 0,0:11:37.06,0:11:39.59,Default,,0000,0000,0000,,Сонымен...Мен Самеджи мама Мимимен кездесіп тұрдым.
Dialogue: 0,0:11:39.77,0:11:40.76,Default,,0000,0000,0000,,Мамими-кунмен?
Dialogue: 0,0:11:40.80,0:11:44.13,Default,,0000,0000,0000,,Жарайды, бұл №1 Сагеман!
Dialogue: 0,0:11:44.20,0:11:46.93,Default,,0000,0000,0000,,Менің ағам жоқ кезде! Тіпті Наотаның улы тістері бар ма?
Dialogue: 0,0:11:46.97,0:11:48.03,Default,,0000,0000,0000,,Чи-Чи түймесін басыңыз!
Dialogue: 0,0:11:48.08,0:11:49.13,Default,,0000,0000,0000,,Чи-Чи түймесін басыңыз!
Dialogue: 0,0:11:49.18,0:11:51.41,Default,,0000,0000,0000,,Чи-Чиді сипап өтіңіз!
Dialogue: 0,0:11:52.61,0:11:53.51,Default,,0000,0000,0000,,- FLCL дегеніміз не?
Dialogue: 0,0:11:53.51,0:11:54.67,Default,,0000,0000,0000,,- Сіз білесіз бе! Міне бітті! - FLCL дегеніміз не?
Dialogue: 0,0:11:54.92,0:11:56.82,Default,,0000,0000,0000,,Бастауыш сынып оқушылары әдетте не туралы ән айтады?
Dialogue: 0,0:11:57.15,0:11:58.45,Default,,0000,0000,0000,,Хахан
Dialogue: 0,0:11:58.99,0:12:00.95,Default,,0000,0000,0000,,Хахан
Dialogue: 0,0:12:01.02,0:12:01.82,Default,,0000,0000,0000,,Бұл солай ма?
Dialogue: 0,0:12:01.86,0:12:04.12,Default,,0000,0000,0000,,Бұл Наотаның Гундам балғасы ма?
Dialogue: 0,0:12:04.22,0:12:06.76,Default,,0000,0000,0000,,Жоқ, бұл Гундам, бірақ бұл робот аниме.
Dialogue: 0,0:12:06.79,0:12:08.53,Default,,0000,0000,0000,,Бұл... Томино сияқты нәрсе емес пе?
Dialogue: 0,0:12:08.63,0:12:10.03,Default,,0000,0000,0000,,Мен сенің не айтып тұрғаныңды білмеймін.
Dialogue: 0,0:12:10.06,0:12:11.36,Default,,0000,0000,0000,,Себебі Нао маған ұқсайды
Dialogue: 0,0:12:11.47,0:12:13.13,Default,,0000,0000,0000,,Мен мұны істеп жатқаныма сенімдімін Мен оны міндетті түрде орындаймын
Dialogue: 0,0:12:13.17,0:12:14.73,Default,,0000,0000,0000,,Мен мұны істеп жатырмын және көңілім көтеріліп жатыр
Dialogue: 0,0:12:14.80,0:12:17.00,Default,,0000,0000,0000,,Иә, дұрыс, мен істеймін, інім.
Dialogue: 0,0:12:17.94,0:12:19.61,Default,,0000,0000,0000,,- А... Айтпақшы, Харуко ше?
Dialogue: 0,0:12:19.61,0:12:20.00,Default,,0000,0000,0000,,- Мыс? - А... Айтпақшы, Харуко ше?
Dialogue: 0,0:12:20.04,0:12:21.98,Default,,0000,0000,0000,,- Кури Кури немесе сол сияқты...
Dialogue: 0,0:12:21.98,0:12:22.34,Default,,0000,0000,0000,,- каштан? - Кури Кури немесе сол сияқты...
Dialogue: 0,0:12:22.38,0:12:25.04,Default,,0000,0000,0000,,Жоқ, жоқ, бұл каштан немесе тиін немесе сол сияқтылар туралы емес.
Dialogue: 0,0:12:25.08,0:12:25.48,Default,,0000,0000,0000,,ӨЛІМ?
Dialogue: 0,0:12:25.51,0:12:28.05,Default,,0000,0000,0000,,- Бұл түрту...
Dialogue: 0,0:12:28.05,0:12:28.54,Default,,0000,0000,0000,,- Кеспе? - Осындай ақпарат алу үшін мына жерді басыңыз...
Dialogue: 0,0:12:28.58,0:12:29.35,Default,,0000,0000,0000,,- Сонымен!
Dialogue: 0,0:12:29.35,0:12:29.91,Default,,0000,0000,0000,,- Аспан? - сондықтан!
Dialogue: 0,0:12:29.95,0:12:33.98,Default,,0000,0000,0000,,Алан Бұрынғы Бас редактор Сіздің сүйкімді жас әйеліңіз осында ма?
Dialogue: 0,0:12:34.12,0:12:39.56,Default,,0000,0000,0000,,Нмоу Крикуриееее! Бұл арманшыл аспект!
Dialogue: 0,0:12:39.96,0:12:43.66,Default,,0000,0000,0000,,Дұрыс, мынандай шерту...
Dialogue: 0,0:12:43.70,0:12:44.43,Default,,0000,0000,0000,,(Панда) Бірінші курс студентін жіберуді қамтитын Арнайы сынып ісі — бұл төтенше жағдай.
Dialogue: 0,0:12:44.47,0:12:47.20,Default,,0000,0000,0000,,А... Мен Таккунмен қарым-қатынастамын.
Dialogue: 0,0:12:47.33,0:12:49.30,Default,,0000,0000,0000,,«Бұл»! Сіз нені айтасыз...?
Dialogue: 0,0:12:49.94,0:12:51.63,Default,,0000,0000,0000,,Ауыздан ауызға!
Dialogue: 0,0:12:52.47,0:12:53.96,Default,,0000,0000,0000,,Mac... Mac... Mac...
Dialogue: 0,0:12:54.01,0:12:55.28,Default,,0000,0000,0000,,- Mac... Mac... Mac...
Dialogue: 0,0:12:55.28,0:12:56.47,Default,,0000,0000,0000,,- басыңыз... басыңыз... - Mac...mac...mac...
Dialogue: 0,0:12:56.51,0:12:58.10,Default,,0000,0000,0000,,Аузыңды жап!
Dialogue: 0,0:12:58.15,0:13:01.58,Default,,0000,0000,0000,,Дұрыс...Нао, екеуміз бір шаңырақтың астында болып жүрміз.
Dialogue: 0,0:13:01.58,0:13:03.64,Default,,0000,0000,0000,,Маған бәрібір, сіз өзіңіздің кейіптеңіз бе, клиторсыз ба!
Dialogue: 0,0:13:03.75,0:13:05.72,Default,,0000,0000,0000,,Демек, сіз мұны бүгін кешке жасауды ойлап жатырсыз.
Dialogue: 0,0:13:05.75,0:13:07.02,Default,,0000,0000,0000,,Бала сияқты сөйлеме!
Dialogue: 0,0:13:07.05,0:13:10.08,Default,,0000,0000,0000,,Осындай амбициямен бұл... мынау...
Dialogue: 0,0:13:10.32,0:13:12.55,Default,,0000,0000,0000,,Бұл таңғыштың астында жасырылған!
Dialogue: 0,0:13:12.79,0:13:14.19,Default,,0000,0000,0000,,Уау! Мен ондай ештеңені жасырмаймын!
Dialogue: 0,0:13:14.40,0:13:15.38,Default,,0000,0000,0000,,Бангсуку…
Dialogue: 0,0:13:15.43,0:13:16.90,Default,,0000,0000,0000,,Басыңыз... түймесін басыңыз.
Dialogue: 0,0:13:25.11,0:13:26.57,Default,,0000,0000,0000,,Уайымсыз бейбақ
Dialogue: 0,0:13:27.07,0:13:32.64,Default,,0000,0000,0000,,Олар медициналық құрал-жабдықтардың бір түрін жасап жатырмыз дейді.
Dialogue: 0,0:13:33.28,0:13:34.94,Default,,0000,0000,0000,,Қайдасың?
Dialogue: 0,0:13:35.32,0:13:37.48,Default,,0000,0000,0000,,Бұл рас...
Dialogue: 0,0:13:39.19,0:13:42.21,Default,,0000,0000,0000,,Арна атмосферасы жақсы емес пе?
Dialogue: 0,0:13:42.36,0:13:45.85,Default,,0000,0000,0000,,Мен осында орнатқан баланы немесе басқа нәрсені пайдалана алмаймын.
Dialogue: 0,0:13:54.03,0:13:55.56,Default,,0000,0000,0000,,Рұқсатсыз кіруге болмайды
Dialogue: 0,0:13:58.04,0:14:00.47,Default,,0000,0000,0000,,Так-кун төменгі болып көрінеді, сондықтан мен жоғарымын.
Dialogue: 0,0:14:01.94,0:14:04.41,Default,,0000,0000,0000,,Рас Сіз кімсіз?
Dialogue: 0,0:14:05.71,0:14:07.44,Default,,0000,0000,0000,,Сасурайдың көмекшісі
Dialogue: 0,0:14:07.95,0:14:09.28,Default,,0000,0000,0000,,Шындықты айт
Dialogue: 0,0:14:10.15,0:14:11.34,Default,,0000,0000,0000,,Бөтен
Dialogue: 0,0:14:11.39,0:14:13.62,Default,,0000,0000,0000,,Күндіз жалған медбике болу әдеті
Dialogue: 0,0:14:13.65,0:14:15.21,Default,,0000,0000,0000,,Бансуко астында…
Dialogue: 0,0:14:16.36,0:14:17.82,Default,,0000,0000,0000,,...Сен біртүрлі екенсің.
Dialogue: 0,0:14:18.16,0:14:20.52,Default,,0000,0000,0000,,Не болып жатыр? Бансуко астында ма?
Dialogue: 0,0:14:21.50,0:14:22.43,Default,,0000,0000,0000,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:14:22.50,0:14:24.62,Default,,0000,0000,0000,,Өтірік Сіз оны көрдіңіз, солай ма?
Dialogue: 0,0:14:25.07,0:14:26.76,Default,,0000,0000,0000,,Бұл не болып жатыр?
Dialogue: 0,0:14:26.93,0:14:29.10,Default,,0000,0000,0000,,Сонымен не болып жатыр?
Dialogue: 0,0:14:29.24,0:14:30.29,Default,,0000,0000,0000,,Бұл сен кінәлі.
Dialogue: 0,0:14:30.34,0:14:31.80,Default,,0000,0000,0000,,Өз басым болса да
Dialogue: 0,0:14:31.97,0:14:33.10,Default,,0000,0000,0000,,Бұл мені соққыға жыққаны үшін.
Dialogue: 0,0:14:33.21,0:14:34.30,Default,,0000,0000,0000,,Оны шешіп көріңіз.
Dialogue: 0,0:14:35.64,0:14:38.30,Default,,0000,0000,0000,,Сіз әкеңіздің соңынан келе жатырсыз, солай ма? Оның орнына барайық!
Dialogue: 0,0:14:47.92,0:14:49.01,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:14:50.16,0:14:52.59,Default,,0000,0000,0000,,Мен бірінші кездестірген адам Таккун болды.
Dialogue: 0,0:14:55.13,0:14:59.62,Default,,0000,0000,0000,,Қалай болғанда да! Жоғарғы қабаттағы ағамның орны, сондықтан ол жерде ешкім жатпауы керек!
Dialogue: 0,0:15:02.10,0:15:03.69,Default,,0000,0000,0000,,Міне солай
Dialogue: 0,0:15:04.27,0:15:05.90,Default,,0000,0000,0000,,Сіздің ағаңыз нешеде?
Dialogue: 0,0:15:06.91,0:15:07.90,Default,,0000,0000,0000,,Қайдасың?
Dialogue: 0,0:15:09.14,0:15:10.01,Default,,0000,0000,0000,,Америка
Dialogue: 0,0:15:10.41,0:15:11.57,Default,,0000,0000,0000,,Не үшін?
Dialogue: 0,0:15:11.75,0:15:12.87,Default,,0000,0000,0000,,Бейсбол
Dialogue: 0,0:15:13.48,0:15:15.45,Default,,0000,0000,0000,,Эй, сен бейсболда жақсысың.
Dialogue: 0,0:15:17.89,0:15:19.94,Default,,0000,0000,0000,,Сіз осында ұйықтайсыз ба? Сіз осында ұйықтайсыз ба?
Dialogue: 0,0:15:20.75,0:15:24.45,Default,,0000,0000,0000,,Жоғарыдағы менің ағамдікі, солай ма?
Dialogue: 0,0:15:27.19,0:15:29.39,Default,,0000,0000,0000,,Қат! Жай ойнам айттым!
Dialogue: 0,0:15:30.16,0:15:31.39,Default,,0000,0000,0000,,Наота-кун
Dialogue: 0,0:15:32.63,0:15:34.62,Default,,0000,0000,0000,,Салиқалы әңгіме айтайық
Dialogue: 0,0:15:35.44,0:15:36.66,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:15:37.40,0:15:41.07,Default,,0000,0000,0000,,Харуко-санға қатысты, Наота-кун бұған қарсы ма?
Dialogue: 0,0:15:42.31,0:15:43.90,Default,,0000,0000,0000,,Жоқ, олар шын мәнінде тамақтанбай-ақ қоятындай деңгейге дейін дамыды, бірақ…
Dialogue: 0,0:15:45.65,0:15:48.38,Default,,0000,0000,0000,,Наотаның «Нао» - «адалдың» «Наосы»
Dialogue: 0,0:15:49.08,0:15:51.68,Default,,0000,0000,0000,,Нао да жүгіріп кетті.
Dialogue: 0,0:15:52.92,0:15:54.15,Default,,0000,0000,0000,,Қашан келдің?
Dialogue: 0,0:15:54.62,0:15:57.35,Default,,0000,0000,0000,,«Маған нанның құлағын бер» дегендей сөз айтты.
Dialogue: 0,0:15:58.29,0:16:01.59,Default,,0000,0000,0000,,Бұл ескі әңгіме. Бұл тыйым салынған оқиға.
Dialogue: 0,0:16:02.10,0:16:05.22,Default,,0000,0000,0000,,Мамими-кунның отбасы осындай ма? Кедей ме?
Dialogue: 0,0:16:12.81,0:16:14.14,Default,,0000,0000,0000,,Менде бәрі жақсы.
Dialogue: 0,0:16:47.64,0:16:50.13,Default,,0000,0000,0000,,Мен минет алдым
Dialogue: 0,0:16:52.25,0:16:53.71,Default,,0000,0000,0000,,Маған хат келді.
Dialogue: 0,0:16:55.32,0:16:57.11,Default,,0000,0000,0000,,Сіз олармен байланысқан жоқсыз ба?
Dialogue: 0,0:17:01.22,0:17:03.71,Default,,0000,0000,0000,,Сізге ағаңызды қаншалықты ұнатасыз?
Dialogue: 0,0:17:10.16,0:17:11.65,Default,,0000,0000,0000,,Катай...
Dialogue: 0,0:17:11.70,0:17:14.96,Default,,0000,0000,0000,,Дүкендегі белгіні қараңыз. Бұл ескі.
Dialogue: 0,0:17:22.81,0:17:23.74,Default,,0000,0000,0000,,Қарбыз
Dialogue: 0,0:17:25.55,0:17:29.11,Default,,0000,0000,0000,,Әлде бұл панданың бетін білдіреді ме?
Dialogue: 0,0:17:29.55,0:17:32.35,Default,,0000,0000,0000,,Сау сандалдар, қысым нүктелері жазылған.
Dialogue: 0,0:17:32.82,0:17:34.58,Default,,0000,0000,0000,,Тақта өшіргішінің иісі
Dialogue: 0,0:17:34.86,0:17:37.65,Default,,0000,0000,0000,,Таңертең оянсам, жексенбі күні жаңбыр жауып тұр екен.
Dialogue: 0,0:17:38.49,0:17:41.55,Default,,0000,0000,0000,,Маған нанның құлағынан да ұнайды.
Dialogue: 0,0:17:44.87,0:17:47.33,Default,,0000,0000,0000,,Олай болса тоқтатайық.
Dialogue: 0,0:17:51.14,0:17:53.50,Default,,0000,0000,0000,,Бауырым, ана жерде...
Dialogue: 0,0:17:54.01,0:17:54.80,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:18:01.38,0:18:05.84,Default,,0000,0000,0000,,Жоқ! Біз бір-біріміздің жеке өмірімізді құрметтеуіміз керек.
Dialogue: 0,0:18:09.52,0:18:10.32,Default,,0000,0000,0000,,Неге сен Окуцу музыка колледжінің жанындағы орта мектепке өтініш бердің?—
Dialogue: 0,0:18:11.69,0:18:12.75,Default,,0000,0000,0000,,Толып кете жаздады
Dialogue: 0,0:18:14.56,0:18:15.60,Default,,0000,0000,0000,,Толып жатыр!
Dialogue: 0,0:18:15.60,0:18:16.89,Default,,0000,0000,0000,,Сонымен не?
Dialogue: 0,0:18:18.80,0:18:19.56,Default,,0000,0000,0000,,Ана сұлу!
Dialogue: 0,0:18:19.60,0:18:20.69,Default,,0000,0000,0000,,Мамими!
Dialogue: 0,0:18:50.00,0:18:51.99,Default,,0000,0000,0000,,Бұрынғыға қарағанда еріндірек.
Dialogue: 0,0:19:36.61,0:19:37.80,Default,,0000,0000,0000,,Мамими ше?
Dialogue: 0,0:19:47.39,0:19:49.15,Default,,0000,0000,0000,,Бұл не болып жатыр!
Dialogue: 0,0:20:29.76,0:20:30.66,Default,,0000,0000,0000,,Харуко!
Dialogue: 0,0:20:42.88,0:20:43.77,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:20:44.38,0:20:48.04,Default,,0000,0000,0000,,Осы сөзді аузымнан шығарған сәтте: «Біттім» деп ойладым.
Dialogue: 0,0:20:49.82,0:20:53.18,Default,,0000,0000,0000,,Сіз бір сәтке де өз ағаңызға ұқсаймын деп ойлайсыз ба?
Dialogue: 0,0:20:55.86,0:20:57.42,Default,,0000,0000,0000,,және және және және қабылданбайды.
Dialogue: 0,0:20:57.42,0:20:57.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:58.06,0:20:59.43,Default,,0000,0000,0000,,Білесің бе, мен кедергімін.
Dialogue: 0,0:20:59.43,0:21:00.26,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:01.56,0:21:02.03,Default,,0000,0000,0000,,Сонымен...?
Dialogue: 0,0:21:06.73,0:21:07.63,Default,,0000,0000,0000,,Мен таңғышты әзірге ала алдым.
Dialogue: 0,0:21:07.63,0:21:09.07,Default,,0000,0000,0000,,Мен таңғышты әзірге ала алдым.
Dialogue: 0,0:21:10.30,0:21:11.96,Default,,0000,0000,0000,,Қазір мүйіздер жоқ.
Dialogue: 0,0:21:12.14,0:21:12.74,Default,,0000,0000,0000,,Керемет ештеңе жоқ
Dialogue: 0,0:21:12.74,0:21:14.10,Default,,0000,0000,0000,,Керемет ештеңе жоқ
Dialogue: 0,0:21:15.74,0:21:18.34,Default,,0000,0000,0000,,Тек қарапайым нәрселер болады.
Dialogue: 0,0:21:19.88,0:21:21.14,Default,,0000,0000,0000,,Неліктен ұялшақсың?
Dialogue: 0,0:21:21.85,0:21:23.04,Default,,0000,0000,0000,,Жүректеріңізді құрбан етіңіздер!! Жүректеріңізді құрбан етіңіздер!! (Әскери полиция) Хич
Dialogue: 0,0:21:31.79,0:21:33.78,Default,,0000,0000,0000,,Сізге жүгіріп келудің қажеті жоқ.
Dialogue: 0,0:21:33.99,0:21:35.05,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:21:44.67,0:21:47.80,Default,,0000,0000,0000,,Сондықтан мен қышқыл тамақты ұнатпаймын.
Dialogue: 0,0:22:05.94,0:22:11.40,Default,,0000,0000,0000,,♪ Қызғылт сары слайд аспанды көрсетеді
Dialogue: 0,0:22:12.81,0:22:17.80,Default,,0000,0000,0000,,♪ Губканың мақтанышы ілулі
Dialogue: 0,0:22:18.15,0:22:19.51,Default,,0000,0000,0000,,♪ Өрмекші
Dialogue: 0,0:22:19.62,0:22:26.25,Default,,0000,0000,0000,,♪ Тірідей ұсталдым деген алдын ала ескертуді жасырудың қажеті жоқ.
Dialogue: 0,0:22:26.36,0:22:30.88,Default,,0000,0000,0000,,♪ Түсті түс көргім келеді
Dialogue: 0,0:22:32.56,0:22:35.09,Default,,0000,0000,0000,,♪ Аққан жұлдызға міну
Dialogue: 0,0:22:35.90,0:22:46.60,Default,,0000,0000,0000,,♪ Жүрегімнің үнімен мылтықтай ән сала бердім
Dialogue: 0,0:22:54.52,0:22:59.68,Default,,0000,0000,0000,,♪ гранж хомяктары жетілген
Dialogue: 0,0:23:01.42,0:23:06.59,Default,,0000,0000,0000,,♪ Кек лобсты әкел
Dialogue: 0,0:23:06.70,0:23:08.03,Default,,0000,0000,0000,,♪ Мерген
Dialogue: 0,0:23:08.13,0:23:14.84,Default,,0000,0000,0000,,♪ Сол жиектелген әлемде не көруге болады?
Dialogue: 0,0:23:14.94,0:23:18.93,Default,,0000,0000,0000,,♪ Мен оны көздеу алдында түрткім келеді
Dialogue: 0,0:23:21.01,0:23:23.74,Default,,0000,0000,0000,,♪ Аққан жұлдызға міну
Dialogue: 0,0:23:24.58,0:23:28.02,Default,,0000,0000,0000,,♪ Сізді іздеп, менде абстиненттік симптомдар болды, мен өтірік айттым.
Dialogue: 0,0:23:28.02,0:23:34.96,Default,,0000,0000,0000,,♪ Сізді іздеп, менде абстиненттік симптомдар болды, мен өтірік айттым.
Dialogue: 0,0:23:35.06,0:23:37.89,Default,,0000,0000,0000,,♪ Аққан жұлдызға міну
Dialogue: 0,0:23:38.36,0:23:49.20,Default,,0000,0000,0000,,♪ Жүрегімнің үнімен мылтықтай ән сала бердім
Dialogue: 0,0:24:15.76,0:24:19.45,Default,,0000,0000,0000,,«Еркектер басымен ойлайды, ал әйелдер құрсағынмен ойлайды» деп кім айтты?
Dialogue: 0,0:24:19.49,0:24:20.32,Default,,0000,0000,0000,,Мизуно Харуо?
Dialogue: 0,0:24:20.66,0:24:24.12,Default,,0000,0000,0000,,Сонда бұл адам Фудзио Фудзио, Эйс емес, Флэш.
Dialogue: 0,0:24:24.16,0:24:25.15,Default,,0000,0000,0000,,Өтірік өтірік
Dialogue: 0,0:24:25.20,0:24:27.63,Default,,0000,0000,0000,,Бірақ, мен де солай сезіне бастадым, сондықтан Фушиги
Dialogue: 0,0:24:28.23,0:24:30.43,Default,,0000,0000,0000,,Келесі жолы FLCL 2-сериясы «Файста»
Dialogue: 0,0:24:30.70,0:24:32.67,Default,,0000,0000,0000,,Өтірік пе, шындық па бәрібір.
Dialogue: 0,0:24:34.17,0:24:40.17,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
