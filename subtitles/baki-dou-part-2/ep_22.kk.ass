Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.51,0:00:13.51,Default,,0,0,0,,♪～
Dialogue: 0,0:01:37.05,0:01:39.05,Default,,0,0,0,,～♪
Dialogue: 0,0:01:42.89,0:01:44.18,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:01:44.77,0:01:47.69,Default,,0,0,0,,Сіздің қолыңызда болған нәрселер
Dialogue: 0,0:01:48.27,0:01:51.06,Default,,0,0,0,,Мен шыдай алмаймын, беремін.
Dialogue: 0,0:01:53.40,0:01:55.32,Default,,0,0,0,,Алданба, Самурай
Dialogue: 0,0:01:59.91,0:02:00.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:01.28,0:02:02.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:07.66,0:02:09.33,Default,,0,0,0,,(қылыштың шырылдаған дыбысы)
Dialogue: 0,0:02:13.04,0:02:14.55,Default,,0,0,0,,- (Қала адамы) Мен ұстадым! -(Қаладағылар) Сен лақтырдың ба?
Dialogue: 0,0:02:14.63,0:02:16.34,Default,,0,0,0,,- (Қаладағы адамдар) Сол қашықтықта ма? -(Қаладағылар) Шынымен!
Dialogue: 0,0:02:18.80,0:02:20.84,Default,,0,0,0,,Сіз мені алаңдатты.
Dialogue: 0,0:02:22.26,0:02:24.47,Default,,0,0,0,,Мұны қабылдау оңай
Dialogue: 0,0:02:30.15,0:02:32.44,Default,,0,0,0,,Қан көп ағып жатыр.
Dialogue: 0,0:02:32.52,0:02:34.48,Default,,0,0,0,,Сіз бір жерді кесіп алдыңыз ба?
Dialogue: 0,0:02:37.61,0:02:41.49,Default,,0,0,0,,Уцуми-кун, сен қалай ойлайсың?
Dialogue: 0,0:02:42.03,0:02:42.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:44.41,0:02:48.08,Default,,0,0,0,,Мен өзімді... «Бұл жақсы нәрсе ме?»
Dialogue: 0,0:02:48.16,0:02:49.00,Default,,0,0,0,,Тек...
Dialogue: 0,0:02:50.42,0:02:53.08,Default,,0,0,0,,Мен өте ризамын...
Dialogue: 0,0:02:54.54,0:02:55.38,Default,,0,0,0,,Иә
Dialogue: 0,0:02:58.59,0:03:00.63,Default,,0,0,0,,Сәлем, Ханаяма мырза.
Dialogue: 0,0:03:01.13,0:03:04.89,Default,,0,0,0,,Мен Нушидің таңғажайып бөліктерін түсінемін.
Dialogue: 0,0:03:04.97,0:03:07.14,Default,,0,0,0,,Ал қазірдің өзінде...
Dialogue: 0,0:03:11.35,0:03:13.90,Default,,0,0,0,,Кейбір әрекеттерді орындауға болмайды...
Dialogue: 0,0:03:13.98,0:03:15.40,Default,,0,0,0,,О...
Dialogue: 0,0:03:25.99,0:03:27.99,Default,,0,0,0,,- (Қаладағы адамдар) Ябба! - (Қаладағылар) Мен өлтірдім!
Dialogue: 0,0:03:28.08,0:03:29.79,Default,,0,0,0,,-(Қаладағылар) Қайтадан кесіп алдым -(Қаладағылар) Эй!
Dialogue: 0,0:03:29.87,0:03:31.54,Default,,0,0,0,,Сен оны неше рет кестің?
Dialogue: 0,0:03:33.04,0:03:34.79,Default,,0,0,0,,Біреуді өлтіру
Dialogue: 0,0:03:35.67,0:03:37.80,Default,,0,0,0,,Ерекше оқиға, ол...
Dialogue: 0,0:03:38.42,0:03:41.59,Default,,0,0,0,,Мен мұны тек тарихи драмалардан көрдім.
Dialogue: 0,0:03:42.80,0:03:46.97,Default,,0,0,0,,Шуичи Нумадате, 22 жаста, оқиғаның куәгері
Dialogue: 0,0:03:47.06,0:03:49.81,Default,,0,0,0,,Иә, мен көрдім.
Dialogue: 0,0:03:49.89,0:03:52.06,Default,,0,0,0,,Әрине, бұл бірінші рет.
Dialogue: 0,0:03:52.14,0:03:54.56,Default,,0,0,0,,Мен оны екі рет көрген емеспін, сондықтан бұл хитокири.
Dialogue: 0,0:03:54.65,0:03:57.44,Default,,0,0,0,,Мен бірінші кезекте ешқандай қылыш көрмеймін, сондықтан бұл қалыпты жағдай.
Dialogue: 0,0:03:58.40,0:04:00.44,Default,,0,0,0,,Дыбыс... дыбыс?
Dialogue: 0,0:04:01.61,0:04:02.99,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:04:03.07,0:04:06.70,Default,,0,0,0,,Ол шынымен қатты дыбыс шығарды. Ол әлдеқашан болды...
Dialogue: 0,0:04:06.78,0:04:07.99,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:04:08.08,0:04:11.70,Default,,0,0,0,,Мен қатты дыбысты айтып тұрған жоқпын, бірақ нені айтасыз...
Dialogue: 0,0:04:12.46,0:04:14.83,Default,,0,0,0,,А... оның терісі бар.
Dialogue: 0,0:04:14.92,0:04:18.21,Default,,0,0,0,,Оның астында бұлшықеттер бар...
Dialogue: 0,0:04:18.29,0:04:19.34,Default,,0,0,0,,Мен қызық...
Dialogue: 0,0:04:20.00,0:04:24.47,Default,,0,0,0,,Адамның денесі судан жасалған.
Dialogue: 0,0:04:24.55,0:04:25.18,Default,,0,0,0,,(ылғалды кесу дыбысы)
Dialogue: 0,0:04:25.18,0:04:27.39,Default,,0,0,0,,(дымқыл кесу дыбысы)
Dialogue: 0,0:04:25.18,0:04:27.39,Default,,0,0,0,,«Егер сіз осындай нәрсені пышақпен кессеңіз»
Dialogue: 0,0:04:27.39,0:04:27.47,Default,,0,0,0,,(ылғалды кесу дыбысы)
Dialogue: 0,0:04:27.47,0:04:29.47,Default,,0,0,0,,(ылғалды кесу дыбысы)
Dialogue: 0,0:04:27.47,0:04:29.47,Default,,0,0,0,,«Бұл солай естіледі»
Dialogue: 0,0:04:30.81,0:04:32.60,Default,,0,0,0,,Бұл шынайы болды...
Dialogue: 0,0:04:33.43,0:04:35.27,Default,,0,0,0,,-(Қаладағы адамдар) Жарылып кетті -(Қаладағы адамдар) Уау!
Dialogue: 0,0:04:35.35,0:04:37.06,Default,,0,0,0,,- (Қаладағы адамдар) О - (Қаладағы адамдар) Hie~
Dialogue: 0,0:04:37.15,0:04:38.86,Default,,0,0,0,,Өлмейсің бе? (Ер Эзуки)
Dialogue: 0,0:04:41.07,0:04:42.69,Default,,0,0,0,,Ауырады.
Dialogue: 0,0:04:43.90,0:04:45.28,Default,,0,0,0,,Ал оны өзгерте алмасам…
Dialogue: 0,0:04:45.36,0:04:48.37,Default,,0,0,0,,Сіз ауырады дейсіз бе? Ханаяма
Dialogue: 0,0:04:48.45,0:04:50.99,Default,,0,0,0,,Ұзақ жол жүрсем де,
Dialogue: 0,0:04:51.08,0:04:54.87,Default,,0,0,0,,Мен кесіп алғаннан кейін кім өзінің ауырғанын бірінші рет айтып отыр.
Dialogue: 0,0:04:55.46,0:04:56.92,Default,,0,0,0,,Ауырсыну алдында…
Dialogue: 0,0:04:57.00,0:05:00.38,Default,,0,0,0,,Немесе айтайын десең де, ол жоғалып кетті.
Dialogue: 0,0:05:01.25,0:05:05.38,Default,,0,0,0,,Ерекше күш болмаса, ауырсынуды да сезе алмайсыз.
Dialogue: 0,0:05:06.55,0:05:09.39,Default,,0,0,0,,Сен мені қанша рет осылай айтуға мәжбүрлейсің, Ханаяма?
Dialogue: 0,0:05:10.47,0:05:11.89,Default,,0,0,0,,Аппарат
Dialogue: 0,0:05:13.73,0:05:14.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:15.73,0:05:17.65,Default,,0,0,0,,Не? әсері?
Dialogue: 0,0:05:19.98,0:05:21.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:23.40,0:05:24.65,Default,,0,0,0,,Жек көру...
Dialogue: 0,0:05:24.74,0:05:26.15,Default,,0,0,0,,Төрт қол
Dialogue: 0,0:05:26.74,0:05:29.16,Default,,0,0,0,,Бұл жерде әдет пе?
Dialogue: 0,0:05:30.16,0:05:31.91,Default,,0,0,0,,Мен оны Пиклмен де жасадым.
Dialogue: 0,0:05:31.99,0:05:34.29,Default,,0,0,0,,- (Полиция қызметкері 1) Әй... - (Қала тұрғындары) Бұл күш сайысы.
Dialogue: 0,0:05:34.37,0:05:36.16,Default,,0,0,0,,Бұл ұстау күші сайысы.
Dialogue: 0,0:05:36.87,0:05:39.67,Default,,0,0,0,,Уцуми, бұл көруге болатын нәрсе.
Dialogue: 0,0:05:40.46,0:05:45.05,Default,,0,0,0,,Шикі жасыл бамбуктың түйіндерін оңай ұсақтайтын ұстау күші.
Dialogue: 0,0:05:45.67,0:05:49.43,Default,,0,0,0,,500 иендік монетаны бұрау – ұстау күші ойыны
Dialogue: 0,0:05:50.18,0:05:51.68,Default,,0,0,0,,Егер қаласаңыз, мен оны сіздің атыңыздан жеткізе аламын.
Dialogue: 0,0:05:52.97,0:05:54.93,Default,,0,0,0,,Сіз уақытындасыз ба?
Dialogue: 0,0:05:55.52,0:05:57.89,Default,,0,0,0,,Сен менің қолымдасың.
Dialogue: 0,0:05:57.98,0:05:59.19,Default,,0,0,0,,(сықырлау)
Dialogue: 0,0:05:59.27,0:06:00.44,Default,,0,0,0,,Хмм!
Dialogue: 0,0:06:01.02,0:06:03.44,Default,,0,0,0,,О ну... о...
Dialogue: 0,0:06:03.52,0:06:07.45,Default,,0,0,0,,Жоқ... өте жақсы.
Dialogue: 0,0:06:08.03,0:06:09.45,Default,,0,0,0,,Бұл сіздің қолыңызда.
Dialogue: 0,0:06:10.03,0:06:12.37,Default,,0,0,0,,Ngggg...
Dialogue: 0,0:06:15.33,0:06:17.33,Default,,0,0,0,,(Мұсашидің ыңырануы)
Dialogue: 0,0:06:17.41,0:06:19.83,Default,,0,0,0,,Темір тырнақ?
Dialogue: 0,0:06:19.92,0:06:21.33,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:06:21.42,0:06:24.09,Default,,0,0,0,,О! темір тырнақ қалақ
Dialogue: 0,0:06:25.17,0:06:27.97,Default,,0,0,0,,Темір тырнақ «Темір тырнақ»
Dialogue: 0,0:06:28.72,0:06:32.60,Default,,0,0,0,,1966-1975 жж
Dialogue: 0,0:06:33.10,0:06:35.39,Default,,0,0,0,,Ауыр салмақтағы NWA чемпионы
Dialogue: 0,0:06:35.47,0:06:37.98,Default,,0,0,0,,Фриц фон Эричтің мамандығы
Dialogue: 0,0:06:38.48,0:06:40.48,Default,,0,0,0,,Бұл тамаша күрес қимылы.
Dialogue: 0,0:06:41.31,0:06:43.73,Default,,0,0,0,,Теріні тістеп, сыртқа ағып кететін қан
Dialogue: 0,0:06:43.82,0:06:45.73,Default,,0,0,0,,Мүмкін бұл жалған шығар...
Dialogue: 0,0:06:46.44,0:06:49.90,Default,,0,0,0,,Алманы ұсақтау үшін ұстау күші 130 кг?
Dialogue: 0,0:06:49.99,0:06:51.74,Default,,0,0,0,,Хмм... күдікті.
Dialogue: 0,0:06:52.70,0:06:54.58,Default,,0,0,0,,Автор өзін-өзі қорғау күштерінің офицері болған кезде
Dialogue: 0,0:06:55.08,0:06:57.79,Default,,0,0,0,,Өзінің күшімен ғана мақтанатын IQ деңгейі төмен аға буыннан.
Dialogue: 0,0:06:57.87,0:06:59.33,Default,,0,0,0,,Сізді шақырған кез болды ма?
Dialogue: 0,0:07:00.42,0:07:04.25,Default,,0,0,0,,Әділетсіз қудалауды болдырмау үшін ақылмен түртіңіз
Dialogue: 0,0:07:04.84,0:07:07.26,Default,,0,0,0,,Ол өзінің ағасының кінәсін қатаң түрде әшкерелегенімен,
Dialogue: 0,0:07:07.34,0:07:09.26,Default,,0,0,0,,Зақым келген жоқ.
Dialogue: 0,0:07:09.97,0:07:13.30,Default,,0,0,0,,Аралас жекпе-жек спорт түрі ретінде дамуын жалғастыруда
Dialogue: 0,0:07:13.39,0:07:15.51,Default,,0,0,0,,Басталғаннан кейін ондаған жылдар
Dialogue: 0,0:07:16.39,0:07:19.10,Default,,0,0,0,,Темір тырнақтарды көрген жоқ.
Dialogue: 0,0:07:19.98,0:07:22.73,Default,,0,0,0,,Тек кәсіпқой күресте болатын әдістер
Dialogue: 0,0:07:23.23,0:07:24.44,Default,,0,0,0,,Тырнақ
Dialogue: 0,0:07:24.94,0:07:27.48,Default,,0,0,0,,Нақты ұрыста қолданылатындары бар ма?
Dialogue: 0,0:07:28.73,0:07:30.19,Default,,0,0,0,,(сығу дыбысы)
Dialogue: 0,0:07:30.28,0:07:31.32,Default,,0,0,0,,Онда...
Dialogue: 0,0:07:31.86,0:07:33.53,Default,,0,0,0,,(Мусашидің ырылдауы)
Dialogue: 0,0:07:34.49,0:07:36.53,Default,,0,0,0,,Каору Ханаяма
Dialogue: 0,0:07:37.24,0:07:38.54,Default,,0,0,0,,Бұл ұят
Dialogue: 0,0:07:39.70,0:07:43.54,Default,,0,0,0,,Осы Мусашиді жеңетін физикалық күш
Dialogue: 0,0:07:44.13,0:07:48.05,Default,,0,0,0,,Менің бас сүйегімді сындыратындай күшті ұстама.
Dialogue: 0,0:07:48.13,0:07:49.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:49.71,0:07:51.80,Default,,0,0,0,,Мен қылышпен жеңемін!
Dialogue: 0,0:07:51.88,0:07:53.63,Default,,0,0,0,,Өте күшті~
Dialogue: 0,0:07:53.72,0:07:55.55,Default,,0,0,0,,Сіз кәсіпқой күресте жеңіске жете аласыз ба?
Dialogue: 0,0:07:55.64,0:07:57.51,Default,,0,0,0,,Мен мұны жеңемін
Dialogue: 0,0:07:57.60,0:07:58.81,Default,,0,0,0,,Шешілді.
Dialogue: 0,0:07:58.89,0:08:01.18,Default,,0,0,0,,Ата…
Dialogue: 0,0:08:02.02,0:08:03.19,Default,,0,0,0,,Тамаша жұмыс
Dialogue: 0,0:08:04.19,0:08:06.69,Default,,0,0,0,,Бұл сөзсіз қабылданбайды.
Dialogue: 0,0:08:07.61,0:08:08.94,Default,,0,0,0,,Ұят болды...
Dialogue: 0,0:08:09.03,0:08:11.94,Default,,0,0,0,,(Адамдардың айқайы мен айқайы)
Dialogue: 0,0:08:12.03,0:08:13.82,Default,,0,0,0,,Жарылғыш заттар!
Dialogue: 0,0:08:14.41,0:08:15.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:15.41,0:08:16.82,Default,,0,0,0,,- (Қаладағы адамдар) Не? -(Қаладағы адамдар) Не?
Dialogue: 0,0:08:16.91,0:08:17.83,Default,,0,0,0,,Террорист пе?
Dialogue: 0,0:08:29.42,0:08:31.34,Default,,0,0,0,,Каору Ханаяма
Dialogue: 0,0:08:32.05,0:08:33.51,Default,,0,0,0,,Өшіру үшін...
Dialogue: 0,0:08:33.59,0:08:35.34,Default,,0,0,0,,Өте өкінішті!
Dialogue: 0,0:08:35.43,0:08:36.34,Default,,0,0,0,,Уф
Dialogue: 0,0:08:36.43,0:08:38.18,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:08:39.68,0:08:42.10,Default,,0,0,0,,Сирек кездесетін заттар
Dialogue: 0,0:08:44.98,0:08:46.73,Default,,0,0,0,,Іші кесілген!
Dialogue: 0,0:08:47.56,0:08:49.61,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:08:52.78,0:08:56.36,Default,,0,0,0,,Сарашиді орау үшін жақсы дайындық болды.
Dialogue: 0,0:08:56.95,0:08:59.62,Default,,0,0,0,,Егер орамаса, ішектер шығып кетеді.
Dialogue: 0,0:08:59.70,0:09:01.62,Default,,0,0,0,,Осымен аяқталды.
Dialogue: 0,0:09:01.70,0:09:03.12,Default,,0,0,0,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық, мағынасыз әңгіме.
Dialogue: 0,0:09:04.12,0:09:05.87,Default,,0,0,0,,Бітті!
Dialogue: 0,0:09:06.46,0:09:09.13,Default,,0,0,0,,Азума-сан, бұл өте жаман.
Dialogue: 0,0:09:09.21,0:09:10.34,Default,,0,0,0,,Барған дұрыс...
Dialogue: 0,0:09:10.84,0:09:13.71,Default,,0,0,0,,STAT жойылды.
Dialogue: 0,0:09:14.22,0:09:17.13,Default,,0,0,0,,Мылтық қолданатын адам емес.
Dialogue: 0,0:09:19.22,0:09:21.76,Default,,0,0,0,,Хмм, мен тұра алдым.
Dialogue: 0,0:09:21.85,0:09:23.35,Default,,0,0,0,,Қазір...
Dialogue: 0,0:09:23.43,0:09:26.64,Default,,0,0,0,,Жалғастырғыңыз келе ме? Каору Ханаяма
Dialogue: 0,0:09:26.73,0:09:29.90,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:09:30.52,0:09:32.40,Default,,0,0,0,,Бұл ойын
Dialogue: 0,0:09:32.98,0:09:34.78,Default,,0,0,0,,Иә, Уцуми
Dialogue: 0,0:09:35.82,0:09:37.28,Default,,0,0,0,,Жетеді
Dialogue: 0,0:09:39.62,0:09:40.66,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:09:40.74,0:09:41.91,Default,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,0:09:42.49,0:09:46.41,Default,,0,0,0,,Мен оны өзім қатайту оңай деп қорқамын.
Dialogue: 0,0:09:49.25,0:09:50.42,Default,,0,0,0,,бинт?
Dialogue: 0,0:09:50.50,0:09:51.92,Default,,0,0,0,,Басқаша ма?
Dialogue: 0,0:09:52.00,0:09:53.92,Default,,0,0,0,,Фестивальде немесе бірдеңеде...
Dialogue: 0,0:09:54.01,0:09:56.42,Default,,0,0,0,,Тарихи драмалардан көретіндеріңіз бе?
Dialogue: 0,0:09:56.51,0:10:00.68,Default,,0,0,0,,Мен қиятынымды әу бастан білдім.
Dialogue: 0,0:10:01.51,0:10:04.93,Default,,0,0,0,,Қалжың емес, менің қарсыласым – шебер қылышшы Мұсаши.
Dialogue: 0,0:10:08.02,0:10:09.94,Default,,0,0,0,,Жалғастырғыңыз келе ме?
Dialogue: 0,0:10:10.65,0:10:15.65,Default,,0,0,0,,Жақсы, бірақ мен оның сулы болғанын қалаймын.
Dialogue: 0,0:10:16.28,0:10:17.70,Default,,0,0,0,,Баки-сан!
Dialogue: 0,0:10:19.53,0:10:21.70,Default,,0,0,0,,Әй... Бақи!
Dialogue: 0,0:10:22.33,0:10:25.29,Default,,0,0,0,,Бұл Огренің ұлы.
Dialogue: 0,0:10:26.29,0:10:29.21,Default,,0,0,0,,Мен Буддаға уағыз айтып жатырмын, бірақ растағым келеді.
Dialogue: 0,0:10:29.92,0:10:33.59,Default,,0,0,0,,Ұрыс кезінде киімді қатайтудың үш себебі бар.
Dialogue: 0,0:10:34.63,0:10:37.97,Default,,0,0,0,,Шеберсіз қылышпен шабуыл жасасаңыз, ішіңізді қорғай аласыз.
Dialogue: 0,0:10:38.63,0:10:39.97,Default,,0,0,0,,Қан тоқтату әсері
Dialogue: 0,0:10:40.76,0:10:43.72,Default,,0,0,0,,Кескенде ішкі ағзалардың сыртқа шығуын болдырмайды
Dialogue: 0,0:10:44.31,0:10:47.48,Default,,0,0,0,,Олай болса, мен оны тағы да қатайтқым келеді.
Dialogue: 0,0:10:49.85,0:10:50.98,Default,,0,0,0,,Bon…
Dialogue: 0,0:10:51.85,0:10:52.90,Default,,0,0,0,,Ханаяма мырза
Dialogue: 0,0:10:52.98,0:10:54.61,Default,,0,0,0,,Ұстап тұру
Dialogue: 0,0:11:00.61,0:11:01.74,Default,,0,0,0,,Міне.
Dialogue: 0,0:11:02.37,0:11:03.62,Default,,0,0,0,,Осымен аяқтағым келеді.
Dialogue: 0,0:11:04.20,0:11:05.37,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:09.46,0:11:10.96,Default,,0,0,0,,(Халықтың лебізі)
Dialogue: 0,0:11:11.04,0:11:12.67,Default,,0,0,0,,Кәке~
Dialogue: 0,0:11:12.75,0:11:13.88,Default,,0,0,0,,Рыцарьлық?
Dialogue: 0,0:11:13.96,0:11:15.42,Default,,0,0,0,,Э-э, сіз шетелдіксіз бе?
Dialogue: 0,0:11:15.96,0:11:17.13,Default,,0,0,0,,Баки
Dialogue: 0,0:11:17.84,0:11:20.13,Default,,0,0,0,,Мен буккакеден гөрі ішкенді ұнатамын
Dialogue: 0,0:11:20.72,0:11:22.09,Default,,0,0,0,,Бұл кейінірек
Dialogue: 0,0:11:23.34,0:11:25.76,Default,,0,0,0,,Біз қанша уақыттан бері сырластық?
Dialogue: 0,0:11:26.43,0:11:29.52,Default,,0,0,0,,Мен өте қызғаншақпын Бонра.
Dialogue: 0,0:11:30.60,0:11:32.77,Default,,0,0,0,,Мен өзім сияқты жігерлі емеспін
Dialogue: 0,0:11:33.65,0:11:36.15,Default,,0,0,0,,Келесі түсірілім - соңы
Dialogue: 0,0:11:36.23,0:11:38.23,Default,,0,0,0,,...Сонымен бұл бес минут, солай ма?
Dialogue: 0,0:11:40.82,0:11:43.24,Default,,0,0,0,,Мен күшті тудым.
Dialogue: 0,0:11:44.28,0:11:47.66,Default,,0,0,0,,Мен қолымда «күш» болып тудым.
Dialogue: 0,0:11:48.49,0:11:50.62,Default,,0,0,0,,Сізге тағы не керек?
Dialogue: 0,0:11:51.12,0:11:53.42,Default,,0,0,0,,Бұдан артықты қалама
Dialogue: 0,0:11:54.21,0:11:56.67,Default,,0,0,0,,Күшті болуға жаттықпа
Dialogue: 0,0:11:57.50,0:12:00.92,Default,,0,0,0,,Бұл күштінің ары қарай жаттығуы үшін негізсіздігі ретінде белгілі.
Dialogue: 0,0:12:01.88,0:12:04.18,Default,,0,0,0,,Арыстан жаттыға ма?
Dialogue: 0,0:12:04.80,0:12:06.51,Default,,0,0,0,,«шикі» болып қалады
Dialogue: 0,0:12:06.60,0:12:08.68,Default,,0,0,0,,Сіз «шикі» болғанша күшті болуыңыз керек ...
Dialogue: 0,0:12:12.23,0:12:14.94,Default,,0,0,0,,Бұл жерде
Dialogue: 0,0:12:15.60,0:12:18.69,Default,,0,0,0,,Оның Будда сияқты көздері бар.
Dialogue: 0,0:12:18.77,0:12:23.20,Default,,0,0,0,,Сіз тіпті өшпенділіктен асып кеттіңіз бе? Каору Ханаяма
Dialogue: 0,0:12:23.28,0:12:25.82,Default,,0,0,0,,Баки-сан, бұл...
Dialogue: 0,0:12:25.91,0:12:28.58,Default,,0,0,0,,Иә, бұл соңғы тарау.
Dialogue: 0,0:12:29.62,0:12:31.04,Default,,0,0,0,,Менің оны көруден басқа амалым жоқ.
Dialogue: 0,0:12:32.25,0:12:33.83,Default,,0,0,0,,Қате түсінбе.
Dialogue: 0,0:12:37.29,0:12:40.34,Default,,0,0,0,,Мен енді ессіз бола алмаймын.
Dialogue: 0,0:12:40.42,0:12:42.42,Default,,0,0,0,,- (Қаладағы адамдар) сыртта! -(Қала халқы) Екі қолды!
Dialogue: 0,0:12:42.51,0:12:44.59,Default,,0,0,0,,Мен бұл суретті бұрыннан көргенмін!
Dialogue: 0,0:12:45.30,0:12:47.85,Default,,0,0,0,,Фуфуфуфуфу Ол танымал.
Dialogue: 0,0:12:48.72,0:12:50.35,Default,,0,0,0,,Мен толқып тұрмын
Dialogue: 0,0:12:50.93,0:12:52.98,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:12:54.02,0:12:55.48,Default,,0,0,0,,Мен құрметке бөлендім
Dialogue: 0,0:13:01.07,0:13:02.65,Default,,0,0,0,,Ал...
Dialogue: 0,0:13:02.74,0:13:03.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:03.69,0:13:05.99,Default,,0,0,0,,Мен оны лақтырып жібердім! «Ойын»…
Dialogue: 0,0:13:06.66,0:13:08.78,Default,,0,0,0,,Біз енді күшті жақтарды салыстыра алмаймыз.
Dialogue: 0,0:13:08.87,0:13:10.12,Default,,0,0,0,,Бұл ойын
Dialogue: 0,0:13:10.20,0:13:11.24,Default,,0,0,0,,Гуо!
Dialogue: 0,0:13:11.79,0:13:12.87,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:13:16.21,0:13:17.63,Default,,0,0,0,,Жақсы! Бұл жынның көзі
Dialogue: 0,0:13:21.63,0:13:23.01,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:13:23.88,0:13:26.51,Default,,0,0,0,,Ах... Уцуми мырза
Dialogue: 0,0:13:26.59,0:13:27.72,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:13:27.80,0:13:30.89,Default,,0,0,0,,Сіз ішіп жатырсыз ба?
Dialogue: 0,0:13:33.31,0:13:34.64,Default,,0,0,0,,Өте рахмет! (Ол Майт) Ахахаха!
Dialogue: 0,0:13:36.85,0:13:39.77,Default,,0,0,0,,Ыңғайлылық Он қиғаш сызық
Dialogue: 0,0:13:40.52,0:13:42.82,Default,,0,0,0,,Кодачи төменнен атылды
Dialogue: 0,0:13:42.90,0:13:44.78,Default,,0,0,0,,Сол бір қылыштан басқа...
Dialogue: 0,0:13:45.65,0:13:47.53,Default,,0,0,0,,Ешқайсысы келмеді
Dialogue: 0,0:13:50.07,0:13:50.78,Default,,0,0,0,,Алайда, иудей...
Dialogue: 0,0:13:50.78,0:13:53.04,Default,,0,0,0,,Алайда, иудей...
Dialogue: 0,0:13:50.78,0:13:53.04,Default,,0,0,0,,(Ханаяманың ауыр тыныс алуы)
Dialogue: 0,0:14:03.88,0:14:04.88,Default,,0,0,0,,Эй...
Dialogue: 0,0:14:04.96,0:14:06.05,Default,,0,0,0,,Басшы?
Dialogue: 0,0:14:06.84,0:14:09.55,Default,,0,0,0,,Полиция бастығы Уцуми...
Dialogue: 0,0:14:10.39,0:14:11.80,Default,,0,0,0,,Уцуми мырза
Dialogue: 0,0:14:12.56,0:14:15.27,Default,,0,0,0,,Бұл менің саған берген уәдем туралы.
Dialogue: 0,0:14:15.77,0:14:17.64,Default,,0,0,0,,Тек орындаңыз, мен оны қолданып көрдім.
Dialogue: 0,0:14:18.64,0:14:20.98,Default,,0,0,0,,Мен оқиғаны толық көрдім.
Dialogue: 0,0:14:21.48,0:14:24.40,Default,,0,0,0,,Үйде кешкі ішімдік ішкен менімен салыстырғанда.
Dialogue: 0,0:14:24.48,0:14:27.82,Default,,0,0,0,,Уәделер орындалды.
Dialogue: 0,0:14:29.49,0:14:30.32,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:14:31.53,0:14:33.08,Default,,0,0,0,,Өтірікші
Dialogue: 0,0:14:34.24,0:14:35.58,Default,,0,0,0,,Ханаяма мырза
Dialogue: 0,0:14:37.41,0:14:38.83,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:14:39.54,0:14:40.83,Default,,0,0,0,,…және
Dialogue: 0,0:14:41.54,0:14:43.59,Default,,0,0,0,,Басыңды көтерме
Dialogue: 0,0:14:44.71,0:14:46.59,Default,,0,0,0,,Адамдар қарап тұр
Dialogue: 0,0:14:47.30,0:14:49.97,Default,,0,0,0,,Бұдан басқа, мұны жасамаңыз.
Dialogue: 0,0:14:51.80,0:14:53.97,Default,,0,0,0,,Жеңілмейтін самурай
Dialogue: 0,0:14:54.47,0:14:57.06,Default,,0,0,0,,Мен мұны бала кезімнен естідім.
Dialogue: 0,0:14:57.56,0:14:59.56,Default,,0,0,0,,Күшті деген күшті...
Dialogue: 0,0:15:01.56,0:15:03.81,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:15:04.86,0:15:07.99,Default,,0,0,0,,Уцуми-сан, маған демалыс бер.
Dialogue: 0,0:15:08.07,0:15:09.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:09.19,0:15:10.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:11.41,0:15:12.36,Default,,0,0,0,,Не!
Dialogue: 0,0:15:13.12,0:15:15.62,Default,,0,0,0,,Рахмет, Ханаяма мырза.
Dialogue: 0,0:15:17.08,0:15:18.62,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:15:20.12,0:15:22.25,Default,,0,0,0,,Яцудуды кесіп тастады
Dialogue: 0,0:15:23.17,0:15:24.25,Default,,0,0,0,,Бөтелкені сындырыңыз
Dialogue: 0,0:15:24.88,0:15:26.25,Default,,0,0,0,,Тастарды кесу
Dialogue: 0,0:15:26.84,0:15:29.01,Default,,0,0,0,,Мылтық атудан бас тарту
Dialogue: 0,0:15:29.63,0:15:31.84,Default,,0,0,0,,Қиылмайтын нәрсе жоқ
Dialogue: 0,0:15:31.93,0:15:33.26,Default,,0,0,0,,...болуы керек
Dialogue: 0,0:15:34.30,0:15:35.85,Default,,0,0,0,,Бұл дүние кең
Dialogue: 0,0:15:35.93,0:15:38.27,Default,,0,0,0,,Және ұзақ тарихы бар
Dialogue: 0,0:15:39.81,0:15:42.02,Default,,0,0,0,,Мұндай адамдар да бар.
Dialogue: 0,0:15:42.90,0:15:44.77,Default,,0,0,0,,Содан кейін сияқты
Dialogue: 0,0:15:44.86,0:15:47.19,Default,,0,0,0,,Жеңілгенін мойындағандай
Dialogue: 0,0:15:47.27,0:15:50.03,Default,,0,0,0,,Қаншама босаға арқам болса да
Dialogue: 0,0:15:50.69,0:15:53.78,Default,,0,0,0,,Бұл жігіттің ет сарайы қорғалған.
Dialogue: 0,0:15:53.86,0:15:57.53,Default,,0,0,0,,Кесілген тері астындағы
Dialogue: 0,0:15:58.99,0:16:00.87,Default,,0,0,0,,«Сүйек сарайында»!
Dialogue: 0,0:16:03.00,0:16:03.87,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:07.13,0:16:09.05,Default,,0,0,0,,Қалған қылыш...
Dialogue: 0,0:16:09.92,0:16:11.38,Default,,0,0,0,,«Шөлмек»?
Dialogue: 0,0:16:12.01,0:16:13.68,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:16.14,0:16:17.76,Default,,0,0,0,,Егер мен оны алып тастасам...
Dialogue: 0,0:16:18.93,0:16:21.56,Default,,0,0,0,,Мен сені өлтіремін.
Dialogue: 0,0:16:21.64,0:16:22.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:23.81,0:16:24.81,Default,,0,0,0,,Хмм?
Dialogue: 0,0:16:26.15,0:16:29.19,Default,,0,0,0,,Оны алып тастау дұрыс па?
Dialogue: 0,0:16:29.82,0:16:32.07,Default,,0,0,0,,Сіз тағы да кеспексіз бе?
Dialogue: 0,0:16:32.65,0:16:35.07,Default,,0,0,0,,Өлтірмесең, шеше алмайсың.
Dialogue: 0,0:16:36.37,0:16:37.91,Default,,0,0,0,,Қазір шешілді.
Dialogue: 0,0:16:38.41,0:16:41.37,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:16:42.41,0:16:43.58,Default,,0,0,0,,Бонн
Dialogue: 0,0:16:44.08,0:16:46.33,Default,,0,0,0,,Бұл есеп айырысу емес.
Dialogue: 0,0:16:47.67,0:16:49.17,Default,,0,0,0,,Миямото Мусаши
Dialogue: 0,0:16:50.42,0:16:54.55,Default,,0,0,0,,Әр самурай қылыш ұстаған сенің кезіңнен бөлек.
Dialogue: 0,0:16:55.05,0:16:58.22,Default,,0,0,0,,Бұл жерде орналасты!
Dialogue: 0,0:16:58.30,0:16:59.72,Default,,0,0,0,,- (Қаладағы адамдар) Уау! -(Қаладағылар) Эй!
Dialogue: 0,0:16:59.81,0:17:01.22,Default,,0,0,0,,(Таңданған адамдардың дауысы)
Dialogue: 0,0:17:01.31,0:17:02.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:03.43,0:17:05.81,Default,,0,0,0,,Рахмет Баки
Dialogue: 0,0:17:06.31,0:17:07.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:11.48,0:17:14.07,Default,,0,0,0,,Керемет болды, Ханаяма мырза.
Dialogue: 0,0:17:15.36,0:17:18.37,Default,,0,0,0,,Өтінемін, құлап кетіңізші.
Dialogue: 0,0:17:19.07,0:17:22.75,Default,,0,0,0,,- (Қаладағы адамдар) А? -(Қаладағылар) Бұл кішкентай нәрсе...
Dialogue: 0,0:17:22.83,0:17:25.29,Default,,0,0,0,,Мен ол баланы бұрын да көргенмін.
Dialogue: 0,0:17:25.37,0:17:27.75,Default,,0,0,0,,«Ата-ана мен бала ұрысы» емес пе?
Dialogue: 0,0:17:29.21,0:17:31.75,Default,,0,0,0,,Сәлем Баки
Dialogue: 0,0:17:32.59,0:17:35.84,Default,,0,0,0,,«Тұрып тұр» Сіз әлі тұрасыз ба?
Dialogue: 0,0:17:40.26,0:17:41.76,Default,,0,0,0,,Ханаяма мырза
Dialogue: 0,0:17:42.64,0:17:45.27,Default,,0,0,0,,Қалай қарасаң да тұр
Dialogue: 0,0:17:45.35,0:17:48.02,Default,,0,0,0,,Бұрын кейін
Dialogue: 0,0:17:48.60,0:17:52.27,Default,,0,0,0,,Ол бұрынғыдан әлдеқайда жақсы "шауэр".
Dialogue: 0,0:17:53.65,0:17:55.61,Default,,0,0,0,,Бүгін түнде...
Dialogue: 0,0:17:57.36,0:18:00.12,Default,,0,0,0,,Жай өтірікші
Dialogue: 0,0:18:02.37,0:18:04.24,Default,,0,0,0,,Полковник!
Dialogue: 0,0:18:04.33,0:18:06.08,Default,,0,0,0,,(Таңданған адамдардың дауысы)
Dialogue: 0,0:18:06.16,0:18:07.29,Default,,0,0,0,,Не?
Dialogue: 0,0:18:07.37,0:18:09.12,Default,,0,0,0,,Бұл полиция.
Dialogue: 0,0:18:09.21,0:18:10.54,Default,,0,0,0,,Ол сонда болды ма?
Dialogue: 0,0:18:10.63,0:18:12.34,Default,,0,0,0,,Мен жасырынып жүрдім!
Dialogue: 0,0:18:12.42,0:18:13.80,Default,,0,0,0,,Сонша...
Dialogue: 0,0:18:13.88,0:18:16.34,Default,,0,0,0,,Сондай-ақ азаматтық киімді детективтер де қатысады.
Dialogue: 0,0:18:16.42,0:18:18.43,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:18:19.01,0:18:21.43,Default,,0,0,0,,Ханаяма мырзаны дереу тасымалдаңыз.
Dialogue: 0,0:18:22.01,0:18:23.68,Default,,0,0,0,,Маған ешқашан өлуге жол берме!
Dialogue: 0,0:18:23.76,0:18:25.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:30.19,0:18:33.44,Default,,0,0,0,,Біздің кейіпкеріміз Каору Ханаяма өлмесін.
Dialogue: 0,0:18:33.94,0:18:35.19,Default,,0,0,0,,Рыцарьлық Ханаяма
Dialogue: 0,0:18:35.28,0:18:37.78,Default,,0,0,0,,Машинада Мах жылдамдығымен адам бол
Dialogue: 0,0:18:39.74,0:18:41.70,Default,,0,0,0,,Жарайды, мен кетуім керек.
Dialogue: 0,0:18:44.79,0:18:46.95,Default,,0,0,0,,Күтілгендей, Ханаяма мырза
Dialogue: 0,0:18:49.12,0:18:50.50,Default,,0,0,0,,Сонша...
Dialogue: 0,0:18:54.96,0:18:56.96,Default,,0,0,0,,Сіз оның ағуына мүмкіндік бересіз
Dialogue: 0,0:18:57.63,0:19:00.22,Default,,0,0,0,,Кім келеді?
Dialogue: 0,0:19:01.09,0:19:03.18,Default,,0,0,0,,Жеңіске жетуге болмайды
Dialogue: 0,0:19:04.60,0:19:06.97,Default,,0,0,0,,Оны мына дүниеден көм
Dialogue: 0,0:19:07.89,0:19:08.73,Default,,0,0,0,,Бонн
Dialogue: 0,0:19:09.60,0:19:11.65,Default,,0,0,0,,Мені өлтіресің бе?
Dialogue: 0,0:19:12.98,0:19:16.02,Default,,0,0,0,,Мұны айту өте қиын, бірақ
Dialogue: 0,0:19:16.61,0:19:19.82,Default,,0,0,0,,Мұсаши мырза, сіз бұл жерде болмауыңыз керек.
Dialogue: 0,0:19:21.24,0:19:22.24,Default,,0,0,0,,Бонн
Dialogue: 0,0:19:23.99,0:19:26.87,Default,,0,0,0,,Мен де түсінемін.
Dialogue: 0,0:19:26.95,0:19:27.74,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:27.83,0:19:29.87,Default,,0,0,0,,(Уцуми мен Мицунаридің шатастырылған дауыстары)
Dialogue: 0,0:19:30.46,0:19:33.13,Default,,0,0,0,,Бұл қиғаш жер емес.
Dialogue: 0,0:19:33.71,0:19:35.34,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:19:35.88,0:19:37.63,Default,,0,0,0,,Бұл тым көп.
Dialogue: 0,0:19:38.26,0:19:39.13,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:39.88,0:19:42.38,Default,,0,0,0,,Мен бұл үшін кек алғым келеді.
Dialogue: 0,0:19:43.05,0:19:46.14,Default,,0,0,0,,Ал, мен мұны істеймін.
Dialogue: 0,0:19:49.02,0:19:50.23,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:19:50.31,0:19:52.23,Default,,0,0,0,,Кел де, осында ұрла.
Dialogue: 0,0:19:55.15,0:19:57.02,Default,,0,0,0,,Тіпті жоғарғы жағын да өлтіріңіз
Dialogue: 0,0:19:57.65,0:19:59.36,Default,,0,0,0,,Мен басқа ештеңе білмеймін
Dialogue: 0,0:19:59.86,0:20:01.36,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:20:03.36,0:20:06.41,Default,,0,0,0,,Мен сені жеңсем де, шаршадым...
Dialogue: 0,0:20:06.49,0:20:07.49,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:20:08.49,0:20:09.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:10.25,0:20:11.25,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:20:13.46,0:20:14.79,Default,,0,0,0,,Бұл Зама
Dialogue: 0,0:20:17.75,0:20:19.59,Default,,0,0,0,,Бастапқыда ол екіге бөлінген.
Dialogue: 0,0:20:21.01,0:20:23.55,Default,,0,0,0,,Енді Миямото Мусаши емес
Dialogue: 0,0:20:26.18,0:20:27.89,Default,,0,0,0,,Балалар…
Dialogue: 0,0:20:28.39,0:20:29.47,Default,,0,0,0,,Иә
Dialogue: 0,0:20:29.56,0:20:32.81,Default,,0,0,0,,Сол баланы қия алмайтын сенсің.
Dialogue: 0,0:20:36.77,0:20:38.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:39.48,0:20:42.07,Default,,0,0,0,,Кейде Бон қалағанын айтады
Dialogue: 0,0:20:42.82,0:20:46.20,Default,,0,0,0,,Хахаха... Бұл да қызық па?
Dialogue: 0,0:20:46.28,0:20:47.28,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:20:48.28,0:20:49.58,Default,,0,0,0,,(Уцуми мен оның достарының таңданған дауыстары)
Dialogue: 0,0:20:53.46,0:20:55.79,Default,,0,0,0,,Мейірімділіктеріңізге рахмет.
Dialogue: 0,0:20:57.88,0:20:59.09,Default,,0,0,0,,Сол жақтағы адам бәрін егжей-тегжейлі түсіндіреді. Содан кейін оның нұсқауларын орындаңыз
Dialogue: 0,0:20:59.88,0:21:01.71,Default,,0,0,0,,Келіп, осында ұрла.
Dialogue: 0,0:21:02.42,0:21:04.72,Default,,0,0,0,,Қазір және қазір
Dialogue: 0,0:21:07.47,0:21:09.39,Default,,0,0,0,,Иә, қорламаңыз.
Dialogue: 0,0:21:09.47,0:21:10.47,Default,,0,0,0,,- (Мусаши) Әй... - (Баки) Джи...
Dialogue: 0,0:21:13.10,0:21:15.85,Default,,0,0,0,,Токугава кездескеніме қуаныштымын
Dialogue: 0,0:21:16.44,0:21:18.23,Default,,0,0,0,,Ванна да қайнап жатыр.
Dialogue: 0,0:21:18.31,0:21:20.23,Default,,0,0,0,,Мен бүгін кешке үйге барамын.
Dialogue: 0,0:21:20.90,0:21:22.23,Default,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,0:21:23.32,0:21:25.07,Default,,0,0,0,,Жібер!
Dialogue: 0,0:21:27.95,0:21:29.32,Default,,0,0,0,,Хаха...
Dialogue: 0,0:21:29.41,0:21:31.62,Default,,0,0,0,,Үлкен мансаптық өсу.
Dialogue: 0,0:21:32.83,0:21:35.83,Default,,0,0,0,,Бұл тамаша кесінді емес пе?
Dialogue: 0,0:21:37.62,0:21:39.63,Default,,0,0,0,,♪～
Dialogue: 0,0:23:04.00,0:23:06.00,Default,,0,0,0,,～♪
