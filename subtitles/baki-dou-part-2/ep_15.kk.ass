Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.01,0:00:13.01,Default,,0,0,0,,♪～
Dialogue: 0,0:01:37.13,0:01:39.14,Default,,0,0,0,,～♪
Dialogue: 0,0:01:43.93,0:01:46.77,Default,,0,0,0,,Әйгілі қылыш Мумей Канешиге
Dialogue: 0,0:01:47.39,0:01:50.81,Default,,0,0,0,,Кумамото Хигоға шұғыл түрде тапсырыс берді.
Dialogue: 0,0:01:50.90,0:01:52.77,Default,,0,0,0,,Сіздің сүйікті қылышыңыз
Dialogue: 0,0:01:53.73,0:01:57.28,Default,,0,0,0,,Мен шыдай алмадым, Токугава-доно.
Dialogue: 0,0:01:57.36,0:01:59.20,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:01:59.28,0:02:02.74,Default,,0,0,0,,Адал иесі емес пе?
Dialogue: 0,0:02:02.83,0:02:04.29,Default,,0,0,0,,Иә? (фрикативті)
Dialogue: 0,0:02:07.12,0:02:09.54,Default,,0,0,0,,Не... не?
Dialogue: 0,0:02:09.62,0:02:11.04,Default,,0,0,0,,Жіп өздігінен қозғалады...
Dialogue: 0,0:02:11.13,0:02:14.80,Default,,0,0,0,,Хахахаха мен өзім шешіп алдым.
Dialogue: 0,0:02:15.84,0:02:18.17,Default,,0,0,0,,Менің беліме оралғың келе ме?
Dialogue: 0,0:02:21.34,0:02:22.43,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:22.51,0:02:24.93,Default,,0,0,0,,Бұл Цувамононың киімі.
Dialogue: 0,0:02:25.01,0:02:27.60,Default,,0,0,0,,Мен оны қуыршақ балшықпен жабуға тырыстым.
Dialogue: 0,0:02:27.68,0:02:29.52,Default,,0,0,0,,Бұл костюм, киім.
Dialogue: 0,0:02:30.23,0:02:32.69,Default,,0,0,0,,Оқ өткізбейтін киім киген полиция қызметкері
Dialogue: 0,0:02:32.77,0:02:34.86,Default,,0,0,0,,Қалқанды тәртіп сақшылары
Dialogue: 0,0:02:34.94,0:02:37.19,Default,,0,0,0,,Өзін-өзі қорғау күштерінің жауынгерлік формасы
Dialogue: 0,0:02:37.28,0:02:39.86,Default,,0,0,0,,Және макивара
Dialogue: 0,0:02:39.95,0:02:41.45,Default,,0,0,0,,Макивара?
Dialogue: 0,0:02:41.53,0:02:44.37,Default,,0,0,0,,Сіз адамдарды өлтіре алмайсыз
Dialogue: 0,0:02:44.45,0:02:47.33,Default,,0,0,0,,Бұл да шарасыз шара.
Dialogue: 0,0:02:48.00,0:02:51.08,Default,,0,0,0,,Жасыл бамбуктың айналасына татами төсеніштерін орау
Dialogue: 0,0:02:51.67,0:02:54.00,Default,,0,0,0,,Арқанға оралған картоп
Dialogue: 0,0:02:54.09,0:02:58.09,Default,,0,0,0,,Төзімділік адамның мойнындағы мойын омыртқаларының төзімділігімен салыстырылады дейді.
Dialogue: 0,0:02:58.17,0:02:59.47,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:02:59.55,0:03:02.97,Default,,0,0,0,,Мұсашиденде, сіз Хитокириді шынымен сезіне аласыз,
Dialogue: 0,0:03:03.05,0:03:05.39,Default,,0,0,0,,Бұл аздап қанағаттанарлықсыз болуы мүмкін, бірақ
Dialogue: 0,0:03:05.47,0:03:08.73,Default,,0,0,0,,Мүмкін сіз ауырып тұрған шығарсыз?
Dialogue: 0,0:03:08.81,0:03:11.23,Default,,0,0,0,,Мусашидононың өзі
Dialogue: 0,0:03:11.31,0:03:13.48,Default,,0,0,0,,Канеджу да белде
Dialogue: 0,0:03:17.82,0:03:20.99,Default,,0,0,0,,- (Мицунари) Уау... - (Мусаши) Белмен кесу Белмен тартып шығару
Dialogue: 0,0:03:21.57,0:03:22.70,Default,,0,0,0,,Хмм…
Dialogue: 0,0:03:28.83,0:03:30.75,Default,,0,0,0,,О...
Dialogue: 0,0:03:35.88,0:03:37.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:37.21,0:03:41.26,Default,,0,0,0,,Өткірліктің қандай түріне жатады? Бұл тофу сияқты ...
Dialogue: 0,0:03:41.84,0:03:43.64,Default,,0,0,0,,Алыс жүр, Токугава.
Dialogue: 0,0:03:43.72,0:03:45.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:50.43,0:03:51.27,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:03:55.36,0:03:57.52,Default,,0,0,0,,Бұл... қалқан сияқты!
Dialogue: 0,0:03:58.86,0:03:59.69,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:04:01.11,0:04:03.28,Default,,0,0,0,,Екі қол!
Dialogue: 0,0:04:05.87,0:04:06.95,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:04:08.95,0:04:11.29,Default,,0,0,0,,Алдыңғы және кейінгі тік бөлу!
Dialogue: 0,0:04:12.21,0:04:13.29,Default,,0,0,0,,(қуыршақтың құлаған дыбысы)
Dialogue: 0,0:04:17.38,0:04:18.59,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:04:19.46,0:04:22.80,Default,,0,0,0,,Пышақтың бағытын өзгертіп, жоғары-төмен кесіп тастадым!
Dialogue: 0,0:04:24.13,0:04:25.13,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:04:33.39,0:04:36.56,Default,,0,0,0,,Бұл өте жақсы!
Dialogue: 0,0:04:36.65,0:04:38.06,Default,,0,0,0,,Ооо...
Dialogue: 0,0:04:38.15,0:04:39.65,Default,,0,0,0,,Эй, сен келгеннен бері бәрі осылай болып тұр, иә?
Dialogue: 0,0:04:40.15,0:04:43.07,Default,,0,0,0,,Мұны тоқтатайық...
Dialogue: 0,0:04:43.15,0:04:45.57,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:04:48.70,0:04:50.33,Default,,0,0,0,,Тұздалған қияр?
Dialogue: 0,0:04:50.41,0:04:52.58,Default,,0,0,0,,Рұқсат етілген қару
Dialogue: 0,0:04:52.66,0:04:54.58,Default,,0,0,0,,Мусаши және Пикл
Dialogue: 0,0:04:57.58,0:04:58.67,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:04:59.17,0:05:00.67,Default,,0,0,0,,(Штаб-пәтер күрсіну)
Dialogue: 0,0:05:01.17,0:05:02.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:03.17,0:05:04.51,Default,,0,0,0,,Жақсы емес, солай ма?
Dialogue: 0,0:05:04.59,0:05:06.09,Default,,0,0,0,,О...
Dialogue: 0,0:05:06.18,0:05:09.10,Default,,0,0,0,,Мен әлі түсінбеймін
Dialogue: 0,0:05:13.18,0:05:16.85,Default,,0,0,0,,Миямото Мусаши қылыш ұстайды
Dialogue: 0,0:05:16.94,0:05:19.73,Default,,0,0,0,,Өлшемді түсінбеу
Dialogue: 0,0:05:23.19,0:05:25.95,Default,,0,0,0,,Оның тұздалған қияр болуы оның нашар екенін білдірмейді.
Dialogue: 0,0:05:26.03,0:05:27.86,Default,,0,0,0,,Ешкім сыртқа шықпауы керек
Dialogue: 0,0:05:27.95,0:05:31.99,Default,,0,0,0,,Қылыш шебері Мұсашидің алдында тұра алмаймын.
Dialogue: 0,0:05:34.79,0:05:37.25,Default,,0,0,0,,«Мотобу Изодан басқа»?
Dialogue: 0,0:05:37.33,0:05:41.00,Default,,0,0,0,,Бұл ұтып алу мүмкіндігі жоғары ұсыныс деп ойлайсыз ба?
Dialogue: 0,0:05:41.59,0:05:44.01,Default,,0,0,0,,Мені мазақ етпе, Токугава-сан.
Dialogue: 0,0:05:47.05,0:05:49.34,Default,,0,0,0,,Мен қашып құтыла алмаймын
Dialogue: 0,0:05:50.51,0:05:53.18,Default,,0,0,0,,Сол дәуірдің студенті ретінде
Dialogue: 0,0:05:53.26,0:05:55.77,Default,,0,0,0,,Сол дәуірден, байланыстырушы ретінде
Dialogue: 0,0:05:55.85,0:05:58.27,Default,,0,0,0,,Сол дәуірді жалғастырушы ретінде
Dialogue: 0,0:05:58.35,0:06:01.23,Default,,0,0,0,,Миямото Мусашимен қарсыласу
Dialogue: 0,0:06:01.31,0:06:04.40,Default,,0,0,0,,Бұл менің еріксіз жауапкершілігім.
Dialogue: 0,0:06:04.48,0:06:08.24,Default,,0,0,0,,Мен... Бұл жақсы. Бас кеңсе.
Dialogue: 0,0:06:12.24,0:06:15.41,Default,,0,0,0,,Үлкен - үлкен
Dialogue: 0,0:06:15.50,0:06:19.17,Default,,0,0,0,,...бірақ ауырлық центрі барлығы бір жағында тігінен
Dialogue: 0,0:06:20.04,0:06:21.42,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:20.04,0:06:21.42,Default,,0,0,0,,Бастың төрт бұрышы Сүйектері кесілсе
Dialogue: 0,0:06:21.42,0:06:22.63,Default,,0,0,0,,Бастың төрт бұрышы Сүйектері кесілсе
Dialogue: 0,0:06:22.63,0:06:23.13,Default,,0,0,0,,Бастың төрт бұрышы Сүйектері кесілсе
Dialogue: 0,0:06:22.63,0:06:23.13,Default,,0,0,0,,(ғимараттың құлау дыбысы)
Dialogue: 0,0:06:23.13,0:06:23.21,Default,,0,0,0,,(ғимараттың құлау дыбысы)
Dialogue: 0,0:06:23.21,0:06:25.46,Default,,0,0,0,,(ғимараттың құлау дыбысы)
Dialogue: 0,0:06:23.21,0:06:25.46,Default,,0,0,0,,Басы иығына түскен шығар.
Dialogue: 0,0:06:25.46,0:06:26.13,Default,,0,0,0,,Басы иығына түскен шығар.
Dialogue: 0,0:06:26.21,0:06:28.47,Default,,0,0,0,,Иықтар соққыға төтеп бере алмайды.
Dialogue: 0,0:06:28.55,0:06:30.68,Default,,0,0,0,,Кеуде қуысына құлау
Dialogue: 0,0:06:31.26,0:06:32.80,Default,,0,0,0,,Кеудеден ішке дейін
Dialogue: 0,0:06:32.89,0:06:34.85,Default,,0,0,0,,Іштен белге дейін
Dialogue: 0,0:06:34.93,0:06:37.06,Default,,0,0,0,,Төменгі арқа аяққа айналады...
Dialogue: 0,0:06:38.56,0:06:42.02,Default,,0,0,0,,Өз салмағыңның астына түсу тым керемет
Dialogue: 0,0:06:42.11,0:06:45.73,Default,,0,0,0,,Тоқтата алмай, жерге құлады
Dialogue: 0,0:06:49.20,0:06:50.49,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:06:51.28,0:06:54.45,Default,,0,0,0,,Сүйікті қылыш Мумей Қанашиге
Dialogue: 0,0:06:54.53,0:06:57.45,Default,,0,0,0,,Пышақтың төгілуі сөзсіз.
Dialogue: 0,0:07:07.05,0:07:08.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:08.55,0:07:13.47,Default,,0,0,0,,Бұл ең күшті және беделді Миямото Мусаши...
Dialogue: 0,0:07:14.05,0:07:17.97,Default,,0,0,0,,Егер мен сені өлтіретін болсам
Dialogue: 0,0:07:18.06,0:07:20.60,Default,,0,0,0,,Менде бірнеше мүмкіндік болды.
Dialogue: 0,0:07:20.69,0:07:25.86,Default,,0,0,0,,Хмм, оның жүзі балаша, бірақ ол бірінші туған күнінен үлкен бе?
Dialogue: 0,0:07:25.94,0:07:29.03,Default,,0,0,0,,Мен оны жарты сағаттай киіп жүрмін.
Dialogue: 0,0:07:29.11,0:07:30.36,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:07:30.45,0:07:32.24,Default,,0,0,0,,Блант...
Dialogue: 0,0:07:32.32,0:07:34.12,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,0:07:34.20,0:07:38.12,Default,,0,0,0,,Менің қатысуым жасырын емес екенін байқаймын.
Dialogue: 0,0:07:38.79,0:07:41.37,Default,,0,0,0,,Сізді бақылап жатыр
Dialogue: 0,0:07:41.46,0:07:44.96,Default,,0,0,0,,Хахахаха Дұрыс.
Dialogue: 0,0:07:45.50,0:07:47.63,Default,,0,0,0,,Сізге қауіп төніп тұрған жоқ
Dialogue: 0,0:07:47.71,0:07:50.47,Default,,0,0,0,,Сіздің тәрелкеңізде көп нәрсе бар сияқты.
Dialogue: 0,0:07:50.55,0:07:52.01,Default,,0,0,0,,Бұл қауіпті емес.
Dialogue: 0,0:07:52.84,0:07:53.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:55.18,0:07:56.85,Default,,0,0,0,,Сіңірлеріңізді кесіп алдыңыз ба?
Dialogue: 0,0:07:57.35,0:08:00.06,Default,,0,0,0,,Егер ол қысқа түтік болса, біз де солай істейтін едік.
Dialogue: 0,0:08:00.14,0:08:01.52,Default,,0,0,0,,Не істеуім керек, балам?
Dialogue: 0,0:08:01.60,0:08:03.90,Default,,0,0,0,,Сізді осы жерден байқайды.
Dialogue: 0,0:08:03.98,0:08:05.10,Default,,0,0,0,,Хахаха
Dialogue: 0,0:08:05.19,0:08:08.40,Default,,0,0,0,,Адамдар сізді көруі үшін орныңыздан тұруды жоспарлайсыз ба?
Dialogue: 0,0:08:11.99,0:08:15.66,Default,,0,0,0,,Қандай жын аура...
Dialogue: 0,0:08:15.74,0:08:17.41,Default,,0,0,0,,Бұл тұман сияқты!
Dialogue: 0,0:08:19.29,0:08:20.29,Default,,0,0,0,,Әскерлер
Dialogue: 0,0:08:21.75,0:08:25.04,Default,,0,0,0,,Біз шетелдегі әскери қызметкерлерді бірнеше рет қарсы алдық.
Dialogue: 0,0:08:25.54,0:08:27.04,Default,,0,0,0,,Нақты ұрыс тәжірибесі бар адам
Dialogue: 0,0:08:27.13,0:08:29.05,Default,,0,0,0,,Жауынгерлік сынақтан өткен шығарма...
Dialogue: 0,0:08:29.75,0:08:30.63,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:31.13,0:08:33.17,Default,,0,0,0,,Салыстыру жоқ
Dialogue: 0,0:08:34.18,0:08:37.26,Default,,0,0,0,,Шайқаста күн көретін адам мәртебесі
Dialogue: 0,0:08:37.35,0:08:39.31,Default,,0,0,0,,Өлшемдері тым әртүрлі
Dialogue: 0,0:08:40.01,0:08:42.06,Default,,0,0,0,,Бет тік
Dialogue: 0,0:08:42.14,0:08:45.06,Default,,0,0,0,,Атқанда иығыңды жұлып алғандай алға қара.
Dialogue: 0,0:08:45.73,0:08:48.65,Default,,0,0,0,,Қолдар оңға және солға салбырап тұрады
Dialogue: 0,0:08:49.15,0:08:52.53,Default,,0,0,0,,Мен өзімді әлсіз сезінемін, сондықтан ол мөлдір болады.
Dialogue: 0,0:08:53.15,0:08:56.32,Default,,0,0,0,,Артқы жағындағы жарық
Dialogue: 0,0:08:56.99,0:08:58.07,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:58.66,0:09:00.33,Default,,0,0,0,,Осылай болды ма?
Dialogue: 0,0:09:00.95,0:09:02.83,Default,,0,0,0,,Қатесіз
Dialogue: 0,0:09:02.91,0:09:07.33,Default,,0,0,0,,Мен қазір нағыз Миямото Мусашимен бетпе-бет келіп тұрмын.
Dialogue: 0,0:09:07.42,0:09:10.09,Default,,0,0,0,,Бірақ Қылыш шебері Мусаши
Dialogue: 0,0:09:10.67,0:09:13.34,Default,,0,0,0,,Қазіргі әлемді бағаламау
Dialogue: 0,0:09:13.42,0:09:15.84,Default,,0,0,0,,Кіші емес, үлкен
Dialogue: 0,0:09:15.93,0:09:18.34,Default,,0,0,0,,Қысқа қылыш үшін кішкене ғана, бірақ
Dialogue: 0,0:09:18.43,0:09:20.05,Default,,0,0,0,,Жек көру...
Dialogue: 0,0:09:22.43,0:09:24.43,Default,,0,0,0,,​​Мен түсінбеймін.
Dialogue: 0,0:09:25.48,0:09:26.85,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:09:26.94,0:09:28.94,Default,,0,0,0,,Менің шабуыл жасау ойым жоқ
Dialogue: 0,0:09:29.44,0:09:30.48,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:09:31.19,0:09:33.86,Default,,0,0,0,,Менің оны кесіп тастау немесе босату ниетім жоқ.
Dialogue: 0,0:09:33.94,0:09:36.61,Default,,0,0,0,,Мен... Мен оны көрдім!
Dialogue: 0,0:09:36.70,0:09:39.37,Default,,0,0,0,,Қысқа қылышқа еліктеген қысқа оқпан ба?
Dialogue: 0,0:09:39.95,0:09:41.91,Default,,0,0,0,,Түсінген кезде
Dialogue: 0,0:09:42.45,0:09:43.87,Default,,0,0,0,,Бетінде бір атмосфера.
Dialogue: 0,0:09:46.71,0:09:47.87,Default,,0,0,0,,…және
Dialogue: 0,0:09:49.17,0:09:50.63,Default,,0,0,0,,Бұл қауіпті...
Dialogue: 0,0:09:51.21,0:09:52.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:52.71,0:09:55.38,Default,,0,0,0,,Хмм, бұл қызықты құрал.
Dialogue: 0,0:09:55.46,0:09:56.80,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:09:56.88,0:09:58.55,Default,,0,0,0,,Жақын диапазон 5 метр
Dialogue: 0,0:09:58.63,0:10:01.51,Default,,0,0,0,,60км/сағ жылдамдықпен пышақ ұстау!
Dialogue: 0,0:10:01.60,0:10:02.64,Default,,0,0,0,,Құбыжық!
Dialogue: 0,0:10:02.72,0:10:04.60,Default,,0,0,0,,- (Мусаши) Қайсысы... - А?
Dialogue: 0,0:10:04.68,0:10:06.64,Default,,0,0,0,,- (Мусаши) Қарап тұрсың ба? -Жоқ...
Dialogue: 0,0:10:06.73,0:10:08.89,Default,,0,0,0,,Ол болаттан жасалған ба?
Dialogue: 0,0:10:08.98,0:10:11.48,Default,,0,0,0,,Не... нені айтып тұрсың?
Dialogue: 0,0:10:11.56,0:10:13.90,Default,,0,0,0,,Бұл біртүрлі, дәл шайқастың ортасында ма?
Dialogue: 0,0:10:14.53,0:10:15.65,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:10:15.74,0:10:18.15,Default,,0,0,0,,Неге жақындамайсың?
Dialogue: 0,0:10:19.86,0:10:21.20,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:10:22.37,0:10:23.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:24.49,0:10:25.41,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:10:36.88,0:10:39.43,Default,,0,0,0,,- Ха - (Мұсаши) Сіз таң қалдыңыз
Dialogue: 0,0:10:40.13,0:10:43.18,Default,,0,0,0,,Бір адам төрт адамға айналады, біртүрлі
Dialogue: 0,0:10:43.26,0:10:44.93,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:10:45.60,0:10:47.68,Default,,0,0,0,,Алдыңғы жағынан екіге бөлу
Dialogue: 0,0:10:47.77,0:10:51.06,Default,,0,0,0,,Одан әрі көлденеңінен қайтадан тікке қарай екіге бөлінген.
Dialogue: 0,0:10:51.15,0:10:53.44,Default,,0,0,0,,Сіз баланы көрдіңіз бе?
Dialogue: 0,0:10:54.36,0:10:55.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:56.23,0:10:57.40,Default,,0,0,0,,Мен көрдім
Dialogue: 0,0:10:57.90,0:11:01.32,Default,,0,0,0,,Менің бес денем төрт бөлікке бөлінген
Dialogue: 0,0:11:01.82,0:11:03.82,Default,,0,0,0,,Менің көзіме анық
Dialogue: 0,0:11:04.45,0:11:06.58,Default,,0,0,0,,Хмм, жалғастырғыңыз келе ме?
Dialogue: 0,0:11:06.66,0:11:11.08,Default,,0,0,0,,Жалғастырамын десем күлетініне сенімдімін.
Dialogue: 0,0:11:11.17,0:11:12.83,Default,,0,0,0,,Хаха...
Dialogue: 0,0:11:12.92,0:11:14.84,Default,,0,0,0,,Бұл күлкілі.
Dialogue: 0,0:11:15.42,0:11:16.96,Default,,0,0,0,,Қаруды қолдану
Dialogue: 0,0:11:17.55,0:11:19.22,Default,,0,0,0,,Снарядтарды қолдану
Dialogue: 0,0:11:19.30,0:11:21.18,Default,,0,0,0,,Бірақ Мусаши мырза
Dialogue: 0,0:11:21.26,0:11:23.47,Default,,0,0,0,,Қолыңызда ештеңе жоқ
Dialogue: 0,0:11:24.51,0:11:27.31,Default,,0,0,0,,«Мені кесіп тастау керек еді» деп түсіндірдім.
Dialogue: 0,0:11:27.39,0:11:28.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:29.39,0:11:31.73,Default,,0,0,0,,Қылыш тәнде
Dialogue: 0,0:11:32.56,0:11:34.27,Default,,0,0,0,,Бұл басынан бері болды
Dialogue: 0,0:11:34.36,0:11:35.23,Default,,0,0,0,,Ах
Dialogue: 0,0:11:36.36,0:11:37.23,Default,,0,0,0,,Ессіз Патшаның зорлық-зомбылығына соңына нүкте қоятын – дәл сіздерсіздер!
Dialogue: 0,0:11:40.82,0:11:42.24,Default,,0,0,0,,Тым басқа
Dialogue: 0,0:11:42.74,0:11:44.87,Default,,0,0,0,,Жауынгер мәртебесі
Dialogue: 0,0:11:44.95,0:11:46.08,Default,,0,0,0,,Тым қымбат...
Dialogue: 0,0:11:46.58,0:11:49.75,Default,,0,0,0,,Сіз енді жоғарғы жағын көре алмайсыз.
Dialogue: 0,0:11:50.83,0:11:52.50,Default,,0,0,0,,Сіз...
Dialogue: 0,0:11:52.58,0:11:53.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:55.08,0:11:58.13,Default,,0,0,0,,Пиклмен матчта қылышты қайтадан алыңыз
Dialogue: 0,0:11:58.21,0:11:59.55,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:59.63,0:12:01.38,Default,,0,0,0,,Бұл қажет пе?
Dialogue: 0,0:12:02.38,0:12:04.14,Default,,0,0,0,,Сіз Токугавадан сұрадыңыз ба?
Dialogue: 0,0:12:05.05,0:12:07.01,Default,,0,0,0,,Бұл шынымен қажет пе?
Dialogue: 0,0:12:08.01,0:12:09.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:11.52,0:12:15.02,Default,,0,0,0,,Бала, қиюдың мағынасын түсіндің.
Dialogue: 0,0:12:17.73,0:12:21.15,Default,,0,0,0,,Бала: Пикле деген кім?
Dialogue: 0,0:12:21.24,0:12:23.36,Default,,0,0,0,,Жоқ... жоқ...
Dialogue: 0,0:12:24.86,0:12:26.03,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:12:26.62,0:12:28.99,Default,,0,0,0,,Бұл мүлдем түсіндіруге болатын нәрсе емес.
Dialogue: 0,0:12:30.04,0:12:33.21,Default,,0,0,0,,Мүмкін сіз білмейсіз бе? Сол жігіт
Dialogue: 0,0:12:33.29,0:12:35.54,Default,,0,0,0,,Қылыш та, мына Мұсашы да
Dialogue: 0,0:12:36.17,0:12:37.79,Default,,0,0,0,,Ура!
Dialogue: 0,0:12:39.88,0:12:43.05,Default,,0,0,0,,Мені кесіп тастады, Сүйегіме дейін білдім.
Dialogue: 0,0:12:43.13,0:12:44.80,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:12:45.80,0:12:47.05,Default,,0,0,0,,Қылыш да...
Dialogue: 0,0:12:47.80,0:12:49.72,Default,,0,0,0,,Бұл Мусаши де...
Dialogue: 0,0:12:53.52,0:12:55.14,Default,,0,0,0,,Қашаннан бері?
Dialogue: 0,0:12:55.23,0:12:56.52,Default,,0,0,0,,Мәңгі
Dialogue: 0,0:12:56.60,0:13:00.27,Default,,0,0,0,,Негізі мен мұнда қайтып келгеннен бері тамақ ішкен жоқпын.
Dialogue: 0,0:13:00.86,0:13:03.28,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:13:03.36,0:13:07.41,Default,,0,0,0,,Нағыз динозавр еті
Dialogue: 0,0:13:11.49,0:13:14.66,Default,,0,0,0,,Менің келгеніме 4 күн болды.
Dialogue: 0,0:13:14.75,0:13:17.42,Default,,0,0,0,,Дүниежүзілік мұра қазынасы
Dialogue: 0,0:13:17.50,0:13:20.17,Default,,0,0,0,,Мен Т.Рекстің етін бір тістеп жемеймін.
Dialogue: 0,0:13:24.26,0:13:25.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:26.38,0:13:27.64,Default,,0,0,0,,Эй!
Dialogue: 0,0:13:38.94,0:13:40.02,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:13:48.53,0:13:49.91,Default,,0,0,0,,О...
Dialogue: 0,0:13:53.04,0:13:55.00,Default,,0,0,0,,Эй, сен маған үйрете аласың ба?
Dialogue: 0,0:13:55.08,0:13:56.96,Default,,0,0,0,,Сіз не туралы айттыңыз?
Dialogue: 0,0:13:57.04,0:13:58.67,Default,,0,0,0,,Сөйлеме
Dialogue: 0,0:13:58.75,0:14:00.96,Default,,0,0,0,,Мен сөйлей алмайтындықтан,
Dialogue: 0,0:14:01.04,0:14:01.88,Default,,0,0,0,,Тек...
Dialogue: 0,0:14:01.96,0:14:02.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:02.92,0:14:05.59,Default,,0,0,0,,Тұздалған қияр ынталы.
Dialogue: 0,0:14:05.67,0:14:06.51,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:07.84,0:14:09.13,Default,,0,0,0,,Мен мойындаймын.
Dialogue: 0,0:14:09.22,0:14:10.22,Default,,0,0,0,,Ми…
Dialogue: 0,0:14:10.30,0:14:11.68,Default,,0,0,0,,Жеміс
Dialogue: 0,0:14:12.18,0:14:15.47,Default,,0,0,0,,Ол Миямото Мусашидің жем болғанын мойындады.
Dialogue: 0,0:14:17.31,0:14:19.81,Default,,0,0,0,,Байт Мусаши?
Dialogue: 0,0:14:20.90,0:14:22.48,Default,,0,0,0,,Бұл көруге болатын нәрсе.
Dialogue: 0,0:14:22.57,0:14:23.98,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:24.69,0:14:26.24,Default,,0,0,0,,Әлгі Мусаши-сан
Dialogue: 0,0:14:26.86,0:14:28.99,Default,,0,0,0,,Тұздалған қиярды қай жерде беруге болады
Dialogue: 0,0:14:29.07,0:14:31.49,Default,,0,0,0,,Мусашиді жеу...
Dialogue: 0,0:14:31.57,0:14:33.74,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:14:33.83,0:14:35.74,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:14:35.83,0:14:40.00,Default,,0,0,0,,Оның үстіне әлсіреген, тіпті жей алмайтын тұздық.
Dialogue: 0,0:14:40.58,0:14:42.29,Default,,0,0,0,,Оны жеуге болмайды.
Dialogue: 0,0:14:42.38,0:14:43.50,Default,,0,0,0,,Тамақ ішпеңіз
Dialogue: 0,0:14:44.09,0:14:47.13,Default,,0,0,0,,Менің жегім келгені ас емес, той.
Dialogue: 0,0:14:48.01,0:14:50.38,Default,,0,0,0,,Мен оны қатты жегім келеді.
Dialogue: 0,0:14:51.34,0:14:55.64,Default,,0,0,0,,Доппо Гучиден баяғыда естіген сөздеріме көзім жетті.
Dialogue: 0,0:14:55.72,0:14:56.39,Default,,0,0,0,,(Жолбарыстың үруі)
Dialogue: 0,0:14:56.39,0:14:57.73,Default,,0,0,0,,(Жолбарыстың үруі)
Dialogue: 0,0:14:56.39,0:14:57.73,Default,,0,0,0,,Аштық табиғатта
Dialogue: 0,0:14:57.73,0:14:58.60,Default,,0,0,0,,Аштық – табиғатта болатын нәрсе.
Dialogue: 0,0:14:58.68,0:15:00.39,Default,,0,0,0,,Ол ең жақсы жағдайда.
Dialogue: 0,0:15:01.23,0:15:02.40,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:02.98,0:15:05.90,Default,,0,0,0,,Сүйікті қылыш Мусаши-санның қолына оралды.
Dialogue: 0,0:15:05.98,0:15:06.98,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:08.03,0:15:10.65,Default,,0,0,0,,Сонда да мен бұл туралы ойлаймын.
Dialogue: 0,0:15:11.32,0:15:15.16,Default,,0,0,0,,Т.Рекс, бор кезеңінің ең күшті динозавры
Dialogue: 0,0:15:15.24,0:15:15.83,Default,,0,0,0,,(Динозаврлардың айқайы)
Dialogue: 0,0:15:15.83,0:15:17.24,Default,,0,0,0,,(Динозаврлардың айқайы)
Dialogue: 0,0:15:15.83,0:15:17.24,Default,,0,0,0,,Олардың азу тістері қылыштан кіші ме?
Dialogue: 0,0:15:17.24,0:15:19.91,Default,,0,0,0,,Олардың азу тістері қылыштан кіші ме?
Dialogue: 0,0:15:32.55,0:15:35.18,Default,,0,0,0,,Бұл керемет Шаосин шарабы.
Dialogue: 0,0:15:35.26,0:15:37.68,Default,,0,0,0,,Бұл өте ескі саке...
Dialogue: 0,0:15:38.27,0:15:41.94,Default,,0,0,0,,Иә, бұл 30 жылдық асыл тас.
Dialogue: 0,0:15:49.99,0:15:53.20,Default,,0,0,0,,Бұл гиоза ма?
Dialogue: 0,0:15:53.28,0:15:56.62,Default,,0,0,0,,Иә... тәтті
Dialogue: 0,0:15:56.70,0:15:59.45,Default,,0,0,0,,Бұл шынымен тәтті дәмге ие.
Dialogue: 0,0:15:59.54,0:16:02.50,Default,,0,0,0,,Ха~ Көремін, көремін.
Dialogue: 0,0:16:02.58,0:16:04.29,Default,,0,0,0,,Көкөністердің тәттілігі
Dialogue: 0,0:16:04.38,0:16:07.46,Default,,0,0,0,,Етке қарағанда орамжапырақ пен пияз көп
Dialogue: 0,0:16:07.54,0:16:09.00,Default,,0,0,0,,Көкөністер…
Dialogue: 0,0:16:13.05,0:16:16.72,Default,,0,0,0,,Түсіндім, бұл сөзсіз тәтті және шырынды.
Dialogue: 0,0:16:16.80,0:16:21.56,Default,,0,0,0,,Ет жеуге шектен тыс сенгендіктен, оны дұрыс түсінбейді.
Dialogue: 0,0:16:21.64,0:16:24.85,Default,,0,0,0,,Гиоза – көкөністен жасалған тағам.
Dialogue: 0,0:16:24.94,0:16:27.73,Default,,0,0,0,,Хмм, бұл таңқаларлық.
Dialogue: 0,0:16:27.82,0:16:29.61,Default,,0,0,0,,Бұл ет тағамы емес пе?
Dialogue: 0,0:16:29.69,0:16:32.57,Default,,0,0,0,,Соғыстағы жеңіліске байланысты Батысқа қарай кешен
Dialogue: 0,0:16:32.65,0:16:34.78,Default,,0,0,0,,Келтірілген зиян
Dialogue: 0,0:16:38.37,0:16:39.62,Default,,0,0,0,,Баки?
Dialogue: 0,0:16:40.20,0:16:41.04,Default,,0,0,0,,Хехе
Dialogue: 0,0:16:41.12,0:16:44.12,Default,,0,0,0,,Сіз мұны айттыңыз ба? Ол...
Dialogue: 0,0:16:45.17,0:16:47.17,Default,,0,0,0,,Мен сізден естідім.
Dialogue: 0,0:16:47.25,0:16:50.75,Default,,0,0,0,,«Аштық міндетті түрде кемшілік емес»
Dialogue: 0,0:16:51.38,0:16:53.30,Default,,0,0,0,,Осындай ас ішіп отырғанда
Dialogue: 0,0:16:53.38,0:16:57.22,Default,,0,0,0,,Айтуға қиын, бірақ мен айттым.
Dialogue: 0,0:16:58.30,0:17:01.89,Default,,0,0,0,,Табиғаттағы ең жақсы жағдай аштық.
Dialogue: 0,0:17:02.73,0:17:04.39,Default,,0,0,0,,Мен мұны әрине айттым.
Dialogue: 0,0:17:04.98,0:17:08.27,Default,,0,0,0,,Сіз өзіңізді кіммін деп ойлайсыз?
Dialogue: 0,0:17:09.15,0:17:10.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:10.86,0:17:13.28,Default,,0,0,0,,Мусашидің жүзі және
Dialogue: 0,0:17:13.36,0:17:15.78,Default,,0,0,0,,Тиранозавр азу
Dialogue: 0,0:17:15.86,0:17:18.16,Default,,0,0,0,,Қайсысы жоғары?
Dialogue: 0,0:17:20.91,0:17:23.08,Default,,0,0,0,,Күлкілі ештеңе айтпа~
Dialogue: 0,0:17:23.16,0:17:24.54,Default,,0,0,0,,Ммм
Dialogue: 0,0:17:27.50,0:17:29.33,Default,,0,0,0,,Осындай әңгіме бар
Dialogue: 0,0:17:29.42,0:17:32.42,Default,,0,0,0,,Аңшылықты өміріне айналдырған жазушы
Dialogue: 0,0:17:32.50,0:17:35.55,Default,,0,0,0,,Харухико Оябу сөзі
Dialogue: 0,0:17:36.13,0:17:39.26,Default,,0,0,0,,«Егер адамдар мен аңдар бір-біріне қарсы тұрса»
Dialogue: 0,0:17:39.34,0:17:42.56,Default,,0,0,0,,«Біз қолымызға мылтық ұстағанда ғана тең боламыз».
Dialogue: 0,0:17:42.64,0:17:43.68,Default,,0,0,0,,Ммм
Dialogue: 0,0:17:44.27,0:17:46.56,Default,,0,0,0,,Сіз теңсіз бе?
Dialogue: 0,0:17:46.64,0:17:48.06,Default,,0,0,0,,Хаха
Dialogue: 0,0:17:50.02,0:17:52.94,Default,,0,0,0,,Ал, ұтыс ставкасын ескере отырып
Dialogue: 0,0:17:53.03,0:17:56.07,Default,,0,0,0,,Оларды тең деп айту қиын...
Dialogue: 0,0:17:56.65,0:18:02.08,Default,,0,0,0,,Әйтсе де, адамның өзі қаһарлы хайуандармен талай рет кездескен болуы керек.
Dialogue: 0,0:18:02.16,0:18:05.08,Default,,0,0,0,,Мен олардан сезінетін қорқыныштылық
Dialogue: 0,0:18:05.91,0:18:08.58,Default,,0,0,0,,Қолында жоғары өнімді винтовка болса да...
Dialogue: 0,0:18:09.29,0:18:12.46,Default,,0,0,0,,Жабайы табиғат соншалықты қорқынышты
Dialogue: 0,0:18:12.54,0:18:15.21,Default,,0,0,0,,Мм, түсіндім.
Dialogue: 0,0:18:15.30,0:18:19.30,Default,,0,0,0,,Қоңыр аюдың ұзындығы 3 метр, салмағы 1 тонна болсын.
Dialogue: 0,0:18:19.38,0:18:21.47,Default,,0,0,0,,Мұсаши қарсы шыққанда
Dialogue: 0,0:18:22.26,0:18:23.97,Default,,0,0,0,,Тіпті сіріңке де емес
Dialogue: 0,0:18:25.10,0:18:28.73,Default,,0,0,0,,Егер бұл 1 тонналық класс болса, тіпті күресу қиын.
Dialogue: 0,0:18:29.31,0:18:30.73,Default,,0,0,0,,Яру на
Dialogue: 0,0:18:30.81,0:18:32.77,Default,,0,0,0,,Алайда,
Dialogue: 0,0:18:32.86,0:18:34.73,Default,,0,0,0,,Уақыт – бор
Dialogue: 0,0:18:34.82,0:18:38.11,Default,,0,0,0,,Пиклмен бетпе-бет келген жабайы өлшем
Dialogue: 0,0:18:38.20,0:18:41.24,Default,,0,0,0,,Дене ұзындығы 13 метр Салмағы 6 тонна
Dialogue: 0,0:18:41.32,0:18:43.99,Default,,0,0,0,,Бұл жыртқыш бақылаушы кесіртке.
Dialogue: 0,0:18:44.08,0:18:49.50,Default,,0,0,0,,Азу тістердің өткірлігі мен онда түсірілген массатер күші...
Dialogue: 0,0:18:50.17,0:18:52.25,Default,,0,0,0,,Катая Сенгоку кезеңі
Dialogue: 0,0:18:52.33,0:18:56.88,Default,,0,0,0,,Уақыт бренді Йошиока отбасы мен Мусашидің қақтығысы
Dialogue: 0,0:18:57.46,0:19:00.63,Default,,0,0,0,,Бүкіл отбасынан бірнеше ондаған адам жіберілді.
Dialogue: 0,0:19:00.72,0:19:03.39,Default,,0,0,0,,Найзалар, қылыштарды айтпағанда.
Dialogue: 0,0:19:03.89,0:19:07.02,Default,,0,0,0,,Тіпті садақтар мен мылтықтарды да таныстыратын топ
Dialogue: 0,0:19:07.10,0:19:08.89,Default,,0,0,0,,Олардың барлығын кесіңіз
Dialogue: 0,0:19:08.98,0:19:12.77,Default,,0,0,0,,Мұсашидің жеңіске жеткен жын-шайтандық күштері
Dialogue: 0,0:19:12.86,0:19:14.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:16.86,0:19:19.28,Default,,0,0,0,,Ммм
Dialogue: 0,0:19:22.07,0:19:24.28,Default,,0,0,0,,Қайсысы жоғарыда?
Dialogue: 0,0:19:29.37,0:19:31.42,Default,,0,0,0,,Тоғанға қарау
Dialogue: 0,0:19:31.50,0:19:34.17,Default,,0,0,0,,Бұлай түскі асты анда-санда ішіп тұрған дұрыс.
Dialogue: 0,0:19:34.25,0:19:36.75,Default,,0,0,0,,Ммм
Dialogue: 0,0:19:37.25,0:19:39.76,Default,,0,0,0,,Бірнеше шыбын бар.
Dialogue: 0,0:19:41.13,0:19:42.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:45.26,0:19:48.18,Default,,0,0,0,,Ой! Мынау... мынау!
Dialogue: 0,0:19:55.23,0:19:56.36,Default,,0,0,0,,Қауырсындар…
Dialogue: 0,0:20:07.58,0:20:12.25,Default,,0,0,0,,Мынау... осылай болды ма?
Dialogue: 0,0:20:12.92,0:20:15.13,Default,,0,0,0,,Тамақтану кезінде айнала ұшатын шыбындар
Dialogue: 0,0:20:15.21,0:20:17.88,Default,,0,0,0,,Оны таяқпен ұстады деген анекдот
Dialogue: 0,0:20:18.50,0:20:20.26,Default,,0,0,0,,Күткендей, бұл күлкілі.
Dialogue: 0,0:20:20.34,0:20:22.63,Default,,0,0,0,,Мен оны фантастика деп қабылдамадым.
Dialogue: 0,0:20:23.34,0:20:25.72,Default,,0,0,0,,Оны таяқпен ұстаудан алыс
Dialogue: 0,0:20:25.80,0:20:29.39,Default,,0,0,0,,Ұсталған нәрсе шыбынның өзі емес.
Dialogue: 0,0:20:29.47,0:20:33.02,Default,,0,0,0,,Ұшатын қауырсынды ұстадың ба?
Dialogue: 0,0:20:35.10,0:20:36.61,Default,,0,0,0,,«Ку»?
Dialogue: 0,0:20:37.11,0:20:39.52,Default,,0,0,0,,Ендеше... жей бер
Dialogue: 0,0:20:39.61,0:20:43.03,Default,,0,0,0,,«Куу»… Мынаны жегің келе ме?
Dialogue: 0,0:20:43.61,0:20:45.78,Default,,0,0,0,,Мен оны жеймін.
Dialogue: 0,0:20:46.74,0:20:48.28,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:48.37,0:20:51.79,Default,,0,0,0,,Тамақ ал... Мені жейсің бе?
Dialogue: 0,0:20:52.37,0:20:54.79,Default,,0,0,0,,Теңдесі жоқ Миямото Мусаши
Dialogue: 0,0:20:55.37,0:20:57.29,Default,,0,0,0,,Оны басынан же!
Dialogue: 0,0:20:57.38,0:21:00.50,Default,,0,0,0,,Бух ха ха ха…
Dialogue: 0,0:21:01.34,0:21:02.42,Default,,0,0,0,,Жек көру...
Dialogue: 0,0:21:03.01,0:21:05.18,Default,,0,0,0,,Сіз оны жей аласыз ба? мен
Dialogue: 0,0:21:05.26,0:21:08.35,Default,,0,0,0,,Кем дегенде Пиклдің көзінен
Dialogue: 0,0:21:08.43,0:21:10.68,Default,,0,0,0,,Бұл сіз үшін тамаша мереке.
Dialogue: 0,0:21:12.52,0:21:15.85,Default,,0,0,0,,Жеңуге жол жоқ Жеңуге жол жоқ
Dialogue: 0,0:21:15.94,0:21:16.94,Default,,0,0,0,,Тамақтану
Dialogue: 0,0:21:17.98,0:21:19.52,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,0:21:32.33,0:21:33.75,Default,,0,0,0,,Ум...
Dialogue: 0,0:21:34.54,0:21:37.08,Default,,0,0,0,,Мұндағы темекі аздап...
Dialogue: 0,0:21:37.17,0:21:38.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:38.46,0:21:40.84,Default,,0,0,0,,Ол елорданың жарлығымен анықталады.
Dialogue: 0,0:21:40.92,0:21:42.50,Default,,0,0,0,,Темекі шегетін жерде
Dialogue: 0,0:21:42.59,0:21:44.05,Default,,0,0,0,,А... иә
Dialogue: 0,0:21:44.13,0:21:45.67,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:21:58.23,0:21:59.56,Default,,0,0,0,,Ертең...
Dialogue: 0,0:22:05.82,0:22:07.40,Default,,0,0,0,,6-күн…
Dialogue: 0,0:22:07.49,0:22:10.49,Default,,0,0,0,,Ішпейді, тамақ жемейді, ұйықтамайды
Dialogue: 0,0:22:10.57,0:22:13.12,Default,,0,0,0,,Жабайы жағдайлар жасау…
Dialogue: 0,0:22:13.20,0:22:15.37,Default,,0,0,0,,Ертең ең жақсысы
Dialogue: 0,0:22:21.21,0:22:23.21,Default,,0,0,0,,♪～
Dialogue: 0,0:23:48.09,0:23:50.09,Default,,0,0,0,,～♪
Dialogue: 0,0:23:51.59,0:23:57.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory