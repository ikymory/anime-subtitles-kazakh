Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.51,0:00:13.51,Default,,0,0,0,,♪～
Dialogue: 0,0:01:37.09,0:01:39.09,Default,,0,0,0,,～♪
Dialogue: 0,0:01:43.35,0:01:46.35,Default,,0,0,0,,(Медициналық құрылғының электронды дыбыстары)
Dialogue: 0,0:01:49.85,0:01:53.78,Default,,0,0,0,,Құйылған қан мөлшері ваннаны толтыруға жеткілікті болды.
Dialogue: 0,0:01:54.44,0:01:56.28,Default,,0,0,0,,Барлығы 10 жара
Dialogue: 0,0:01:57.28,0:02:01.70,Default,,0,0,0,,Барлық тігістер терең, 1000-нан астам тігіспен.
Dialogue: 0,0:02:01.78,0:02:03.54,Default,,0,0,0,,Бұл менің де бірінші рет болды.
Dialogue: 0,0:02:03.62,0:02:08.04,Default,,0,0,0,,Қан құюға арналған бір ваннаға 1000 тігіс
Dialogue: 0,0:02:08.12,0:02:10.21,Default,,0,0,0,,Ханаямаға ұқсайды.
Dialogue: 0,0:02:10.29,0:02:12.42,Default,,0,0,0,,Күшті адам болып өмір сүру
Dialogue: 0,0:02:12.50,0:02:14.55,Default,,0,0,0,,Бұл өте азап.
Dialogue: 0,0:02:16.38,0:02:17.47,Default,,0,0,0,,(Сота) Жарайды. (Есіктің ашылып, жабылуының дыбысы)
Dialogue: 0,0:02:18.59,0:02:22.05,Default,,0,0,0,,Баки өзінің атын ресми түрде жариялады.
Dialogue: 0,0:02:24.22,0:02:26.10,Default,,0,0,0,,Мен таң қалған жоқпын.
Dialogue: 0,0:02:26.18,0:02:28.06,Default,,0,0,0,,Қаруға тыйым салынады деген ереже бар ма?
Dialogue: 0,0:02:31.23,0:02:34.90,Default,,0,0,0,,Мен шешпеймін, бірақ менің қарсыласым самурай.
Dialogue: 0,0:02:34.98,0:02:38.82,Default,,0,0,0,,Қолыңа қылыш ұстағанда ғана өзіңді Миямото Мусаши деп айта аласың ба?
Dialogue: 0,0:02:39.40,0:02:43.32,Default,,0,0,0,,Қылышты қолға алудың күші жеткілікті түрде дәлелденді.
Dialogue: 0,0:02:43.41,0:02:47.83,Default,,0,0,0,,Егер сіз жалаң қолыңызбен самурайға тап болсаңыз,
Dialogue: 0,0:02:51.92,0:02:54.84,Default,,0,0,0,,Менімен бетпе-бет келудің мәні жоқ.
Dialogue: 0,0:02:55.71,0:02:58.84,Default,,0,0,0,,«Мен сені бұл дүниеден жерлеймін» деді.
Dialogue: 0,0:02:59.72,0:03:02.09,Default,,0,0,0,,Әлгі Бақи-сан солай істеді ме?
Dialogue: 0,0:03:02.18,0:03:06.60,Default,,0,0,0,,Мен Миямото Мусашиге бетіне айттым.
Dialogue: 0,0:03:06.68,0:03:07.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:10.19,0:03:11.10,Default,,0,0,0,,Бұл...
Dialogue: 0,0:03:12.06,0:03:13.35,Default,,0,0,0,,Ол сияқты емес
Dialogue: 0,0:03:13.44,0:03:15.19,Default,,0,0,0,,"Дегенмен ол жүгірді."
Dialogue: 0,0:03:15.69,0:03:18.61,Default,,0,0,0,,Бұл блеф болса, жігітке ұқсамайды.
Dialogue: 0,0:03:18.69,0:03:20.49,Default,,0,0,0,,Сіз бұл хора емес дейсіз бе?
Dialogue: 0,0:03:21.36,0:03:22.49,Default,,0,0,0,,Күзгі жапырақтар
Dialogue: 0,0:03:23.32,0:03:25.83,Default,,0,0,0,,Ханма Бакидің блефтері жоқ.
Dialogue: 0,0:03:34.96,0:03:36.25,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:03:37.09,0:03:38.76,Default,,0,0,0,,Сіз неше күн босадыңыз?
Dialogue: 0,0:03:39.67,0:03:40.92,Default,,0,0,0,,Тренинг…
Dialogue: 0,0:03:43.72,0:03:44.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:44.84,0:03:46.39,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:46.89,0:03:47.76,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:03:48.43,0:03:52.27,Default,,0,0,0,,Шебер қылышшы Мұсаши күнін арнайы дайындықпен өткізбейді.
Dialogue: 0,0:03:53.19,0:03:55.27,Default,,0,0,0,,«Әдеттегідей» өмір сүру
Dialogue: 0,0:03:56.15,0:03:58.27,Default,,0,0,0,,Сонда бұл да тең болады.
Dialogue: 0,0:03:59.11,0:04:00.78,Default,,0,0,0,,Арнайы дайындық жоқ
Dialogue: 0,0:04:00.86,0:04:02.74,Default,,0,0,0,,- (Ер) А - (Әйел) А?
Dialogue: 0,0:04:03.28,0:04:05.28,Default,,0,0,0,,-(Ер) Ахх -(Әйел) Иә?
Dialogue: 0,0:04:05.37,0:04:07.87,Default,,0,0,0,,Бірақ ол үлкенірек.
Dialogue: 0,0:04:08.87,0:04:10.79,Default,,0,0,0,,Кеуде және иық
Dialogue: 0,0:04:11.37,0:04:13.29,Default,,0,0,0,,Қол аяқтары
Dialogue: 0,0:04:13.37,0:04:14.54,Default,,0,0,0,,Менің аяғым...
Dialogue: 0,0:04:15.12,0:04:16.79,Default,,0,0,0,,Алдындағы футболкадағы адам
Dialogue: 0,0:04:16.88,0:04:18.13,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:04:18.21,0:04:19.80,Default,,0,0,0,,Қарап көріңіз.
Dialogue: 0,0:04:20.46,0:04:23.30,Default,,0,0,0,,Дене дайын емес
Dialogue: 0,0:04:24.38,0:04:25.64,Default,,0,0,0,,(Балалардың шуы)
Dialogue: 0,0:04:26.18,0:04:28.05,Default,,0,0,0,,Егер сізді кенеттен біреу қағып кетсе
Dialogue: 0,0:04:28.97,0:04:30.06,Default,,0,0,0,,Егер сізді теуіп кетсе
Dialogue: 0,0:04:30.89,0:04:32.31,Default,,0,0,0,,Егер сізді біреу ұстап алса
Dialogue: 0,0:04:32.89,0:04:35.56,Default,,0,0,0,,Әсіресе егер сіз кесілген болсаңыз...
Dialogue: 0,0:04:36.65,0:04:38.52,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:04:38.61,0:04:40.57,Default,,0,0,0,,Менің денем қазірдің өзінде әрекет етуде
Dialogue: 0,0:04:40.65,0:04:41.65,Default,,0,0,0,,Не!
Dialogue: 0,0:04:41.73,0:04:43.03,Default,,0,0,0,,Не?Не?
Dialogue: 0,0:04:43.53,0:04:45.15,Default,,0,0,0,,Үстіңгі жағы жоғалып кетті
Dialogue: 0,0:04:46.57,0:04:48.16,Default,,0,0,0,,Егер сізді қоршап алған болсаңыз...
Dialogue: 0,0:04:49.20,0:04:51.58,Default,,0,0,0,,Егер сізді қоршап, шабуыл жасаса...
Dialogue: 0,0:04:51.66,0:04:52.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:53.41,0:04:55.25,Default,,0,0,0,,Эх!
Dialogue: 0,0:04:56.50,0:04:57.88,Default,,0,0,0,,Хэ~
Dialogue: 0,0:04:57.96,0:04:59.84,Default,,0,0,0,,Мен осылай қозғаламын ба?
Dialogue: 0,0:04:59.92,0:05:01.09,Default,,0,0,0,,Ки…
Dialogue: 0,0:05:01.88,0:05:03.59,Default,,0,0,0,,Ол жоғалды.
Dialogue: 0,0:05:04.17,0:05:06.76,Default,,0,0,0,,Әй... Меніңше, солай.
Dialogue: 0,0:05:07.14,0:05:09.60,Default,,0,0,0,,Көрмегендей кейіпте...
Dialogue: 0,0:05:10.10,0:05:11.18,Default,,0,0,0,,Осымен.
Dialogue: 0,0:05:15.73,0:05:16.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:17.44,0:05:18.48,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:21.02,0:05:22.11,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:26.95,0:05:27.78,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:29.45,0:05:34.87,Default,,0,0,0,,Неліктен пышақпен емес, тірі мүшемен кесуге болады?
Dialogue: 0,0:05:36.46,0:05:39.58,Default,,0,0,0,,Баки-сан мұны ойлап табуы керек еді.
Dialogue: 0,0:05:39.67,0:05:41.63,Default,,0,0,0,,Ұшақтың жұмысы…
Dialogue: 0,0:05:42.50,0:05:45.84,Default,,0,0,0,,Білекке дейін
Dialogue: 0,0:05:45.92,0:05:48.38,Default,,0,0,0,,Дұрыс, бұл ұшы операциясы.
Dialogue: 0,0:05:49.18,0:05:51.89,Default,,0,0,0,,Бокс және муай-тай сияқты жекпе-жек өнері
Dialogue: 0,0:05:53.06,0:05:55.89,Default,,0,0,0,,Бұл спорт түрі болғанымен, А сыныбының қабілеті
Dialogue: 0,0:05:55.98,0:05:59.48,Default,,0,0,0,,Қарусыз жекпе-жек шеберлеріне қауіп.
Dialogue: 0,0:05:59.98,0:06:01.15,Default,,0,0,0,,Тек...
Dialogue: 0,0:06:01.77,0:06:02.90,Default,,0,0,0,,Тек...
Dialogue: 0,0:06:02.98,0:06:06.65,Default,,0,0,0,,Қол жағының артықшылығы болса
Dialogue: 0,0:06:06.74,0:06:08.65,Default,,0,0,0,,Дәл осы икемділік
Dialogue: 0,0:06:09.66,0:06:12.37,Default,,0,0,0,,Қолғаппен соққылау, соғудан немесе соғудан басқа таңдауыңыз жоқ
Dialogue: 0,0:06:12.87,0:06:16.16,Default,,0,0,0,,Аяқтың үстіңгі немесе табаны ғана қолданылатын тебу техникасы
Dialogue: 0,0:06:16.91,0:06:20.17,Default,,0,0,0,,Екінші жағынан, қолдың ұштары тым әртүрлі.
Dialogue: 0,0:06:21.13,0:06:23.63,Default,,0,0,0,,Мен матч туралы естідім.
Dialogue: 0,0:06:23.71,0:06:26.01,Default,,0,0,0,,Қылыш таққан Миямото Мусашиге қарсы
Dialogue: 0,0:06:26.09,0:06:27.42,Default,,0,0,0,,Баки-санның қолы бос
Dialogue: 0,0:06:27.51,0:06:30.68,Default,,0,0,0,,Меніңше...
Dialogue: 0,0:06:31.72,0:06:34.22,Default,,0,0,0,,Мысалы, Бақи-сан саяхаттайды.
Dialogue: 0,0:06:34.31,0:06:37.10,Default,,0,0,0,,Әуежайдағы детектор қақпасынан өту
Dialogue: 0,0:06:37.18,0:06:39.19,Default,,0,0,0,,Детектор жауап бермейді
Dialogue: 0,0:06:39.85,0:06:40.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:41.27,0:06:42.90,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:06:42.98,0:06:45.69,Default,,0,0,0,,Бұл қаншалықты қорқынышты...
Dialogue: 0,0:06:46.57,0:06:48.99,Default,,0,0,0,,Өлім қаруы Доғал қару Пышақ
Dialogue: 0,0:06:49.07,0:06:51.61,Default,,0,0,0,,Балта қылыш Найза қамшы
Dialogue: 0,0:06:51.70,0:06:53.70,Default,,0,0,0,,Жарылғыш заттарға дейін
Dialogue: 0,0:06:53.78,0:06:56.95,Default,,0,0,0,,Осы заттардың барлығына ие дене
Dialogue: 0,0:06:57.04,0:07:00.46,Default,,0,0,0,,Детекторды ақаусыз тазалаңыз
Dialogue: 0,0:07:01.37,0:07:04.54,Default,,0,0,0,,Сізге ұнаған кезде, ұрлау аяқталды.
Dialogue: 0,0:07:05.55,0:07:06.46,Default,,0,0,0,,Баки-сан
Dialogue: 0,0:07:07.38,0:07:10.47,Default,,0,0,0,,Міне, сіз қазір кімсіз.
Dialogue: 0,0:07:13.80,0:07:15.47,Default,,0,0,0,,Ноу Мусаши
Dialogue: 0,0:07:15.56,0:07:18.98,Default,,0,0,0,,Каору Ханаяма туралы не ойладың?
Dialogue: 0,0:07:21.06,0:07:22.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:27.94,0:07:29.57,Default,,0,0,0,,Нені кесуге болмайды
Dialogue: 0,0:07:31.32,0:07:32.99,Default,,0,0,0,,Кесілмейтін
Dialogue: 0,0:07:33.57,0:07:34.99,Default,,0,0,0,,адам ағашы
Dialogue: 0,0:07:35.07,0:07:36.99,Default,,0,0,0,,Тас болат
Dialogue: 0,0:07:37.79,0:07:40.75,Default,,0,0,0,,Мен қия алмайтын нәрсе жоқ деп мақтандым.
Dialogue: 0,0:07:40.83,0:07:44.13,Default,,0,0,0,,Хмм, мен өлтіре алмайтын ештеңе жоқ.
Dialogue: 0,0:07:45.38,0:07:47.00,Default,,0,0,0,,Мен оны кесіп тастадым, бірақ
Dialogue: 0,0:07:47.09,0:07:50.01,Default,,0,0,0,,Қысқарту
Dialogue: 0,0:07:50.97,0:07:54.09,Default,,0,0,0,,Мысықтың ет сарайы сауытынан асып түседі
Dialogue: 0,0:07:54.59,0:07:56.10,Default,,0,0,0,,Бұл тым қауіпті! Біз Сантананы өлтіруіміз керек.
Dialogue: 0,0:07:56.60,0:07:58.76,Default,,0,0,0,,Етті турай алады
Dialogue: 0,0:07:59.39,0:08:00.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:00.85,0:08:02.23,Default,,0,0,0,,Ммм
Dialogue: 0,0:08:03.90,0:08:06.77,Default,,0,0,0,,Ниет, ой, ой...
Dialogue: 0,0:08:07.36,0:08:09.78,Default,,0,0,0,,Сол заттардың қаттылығы
Dialogue: 0,0:08:10.49,0:08:12.78,Default,,0,0,0,,Рухтың қаттылығы жүзді тойтарып жіберді.
Dialogue: 0,0:08:15.62,0:08:17.33,Default,,0,0,0,,... қанағаттандың ба?
Dialogue: 0,0:08:17.41,0:08:19.29,Default,,0,0,0,,(жану дыбысы)
Dialogue: 0,0:08:19.37,0:08:21.62,Default,,0,0,0,,(Дем алу және шығару дыбысы)
Dialogue: 0,0:08:22.50,0:08:24.04,Default,,0,0,0,,Мусаши
Dialogue: 0,0:08:24.12,0:08:28.54,Default,,0,0,0,,Баки сол Ханаямадан күштірек
Dialogue: 0,0:08:29.63,0:08:33.34,Default,,0,0,0,,Сол күш, күш, Ханаяма
Dialogue: 0,0:08:33.42,0:08:37.14,Default,,0,0,0,,Ханаяма сені қатты бұрышқа түсірді.
Dialogue: 0,0:08:38.14,0:08:40.56,Default,,0,0,0,,Ханма Бакидің тістері бар
Dialogue: 0,0:08:40.64,0:08:42.56,Default,,0,0,0,,Бұл қозғалмайтын факт
Dialogue: 0,0:08:46.15,0:08:47.19,Default,,0,0,0,,Хаа…
Dialogue: 0,0:08:50.78,0:08:53.11,Default,,0,0,0,,Бон Ханаямадан күштірек
Dialogue: 0,0:08:54.45,0:08:55.66,Default,,0,0,0,,Қазіргі уақытта концерттік турда
Dialogue: 0,0:08:56.16,0:08:56.99,Default,,0,0,0,,О
Dialogue: 0,0:08:57.87,0:08:59.49,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:08:59.58,0:09:01.83,Default,,0,0,0,,Бұл да біртүрлі
Dialogue: 0,0:09:03.25,0:09:06.83,Default,,0,0,0,,Мусаши-доно Бакиді бір рет жеңді.
Dialogue: 0,0:09:06.92,0:09:10.84,Default,,0,0,0,,Мен айтып отырған жалғыз ой осы деп ойладым.
Dialogue: 0,0:09:11.80,0:09:13.34,Default,,0,0,0,,Бұл ойын емес
Dialogue: 0,0:09:13.42,0:09:14.59,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:09:15.17,0:09:18.84,Default,,0,0,0,,Олар Бонның тәжірибесіздігін пайдаланып, оны қолдан жасады.
Dialogue: 0,0:09:18.93,0:09:20.35,Default,,0,0,0,,Манипуляция?
Dialogue: 0,0:09:20.43,0:09:22.56,Default,,0,0,0,,Күшті көргенде білесің.
Dialogue: 0,0:09:22.64,0:09:24.23,Default,,0,0,0,,Мен тынышталмас бұрын
Dialogue: 0,0:09:24.31,0:09:26.56,Default,,0,0,0,,Қауіпті су таңбасын мазақтау
Dialogue: 0,0:09:26.64,0:09:30.11,Default,,0,0,0,,Ол өз күшін көрсете алмайтындай етіп жай ғана қолданылды.
Dialogue: 0,0:09:32.98,0:09:35.11,Default,,0,0,0,,Оның куәлік етуден айырмашылығы бар.
Dialogue: 0,0:09:37.20,0:09:39.87,Default,,0,0,0,,Мен мұны естігенде
Dialogue: 0,0:09:39.95,0:09:42.37,Default,,0,0,0,,Мен Бакиді құтқармайды деп ойлаймын.
Dialogue: 0,0:09:44.45,0:09:46.83,Default,,0,0,0,,Кім не айтса да
Dialogue: 0,0:09:46.91,0:09:49.38,Default,,0,0,0,,Баки жеңілгенін мойындамайды.
Dialogue: 0,0:09:50.38,0:09:52.34,Default,,0,0,0,,Тосын шабуыл, айлалы шабуыл
Dialogue: 0,0:09:52.42,0:09:54.38,Default,,0,0,0,,Қаруды қолдану көп ойыншы
Dialogue: 0,0:09:54.46,0:09:57.38,Default,,0,0,0,,Ксенобиотикалық соғысқа дейін
Dialogue: 0,0:09:58.01,0:10:00.39,Default,,0,0,0,,Баки ештеңені ұнатпайды.
Dialogue: 0,0:10:00.47,0:10:03.85,Default,,0,0,0,,Мені жеңсең, жеңесің; егер мені жеңсең, ұтыласың.
Dialogue: 0,0:10:03.93,0:10:06.02,Default,,0,0,0,,Бұл қарапайым.
Dialogue: 0,0:10:06.10,0:10:07.39,Default,,0,0,0,,Қарапайым…
Dialogue: 0,0:10:07.48,0:10:09.77,Default,,0,0,0,,Жекпе-жекте сен жеңесің
Dialogue: 0,0:10:09.85,0:10:12.32,Default,,0,0,0,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:10:14.40,0:10:15.40,Default,,0,0,0,,Хехе
Dialogue: 0,0:10:16.49,0:10:19.41,Default,,0,0,0,,Бұл сондай-ақ «Егер бұл сәйкестік болса, сіз ұтыла алмайсыз» сияқты естіледі.
Dialogue: 0,0:10:21.24,0:10:23.41,Default,,0,0,0,,Мен саған бірдеңе айтайын
Dialogue: 0,0:10:27.16,0:10:29.42,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:10:29.50,0:10:35.76,Default,,0,0,0,,«Күшті адам» Юдзиро Ханманы жеңген жер бетіндегі жалғыз тіршілік иесі
Dialogue: 0,0:10:35.84,0:10:38.92,Default,,0,0,0,,Бұл Бон Ханма Баки.
Dialogue: 0,0:10:42.01,0:10:43.93,Default,,0,0,0,,қоғамдық бейбітшілік хатын алмастыру үшін, иә?
Dialogue: 0,0:10:44.93,0:10:45.93,Default,,0,0,0,,мм—
Dialogue: 0,0:10:46.02,0:10:48.93,Default,,0,0,0,,Барлық жол, барлық жол
Dialogue: 0,0:10:49.85,0:10:53.52,Default,,0,0,0,,Жердің шетіне дейін созылған той-томалақ
Dialogue: 0,0:10:55.57,0:10:57.07,Default,,0,0,0,,О...
Dialogue: 0,0:10:58.78,0:11:00.95,Default,,0,0,0,,Қандай жақсы!
Dialogue: 0,0:11:04.58,0:11:06.33,Default,,0,0,0,,Қандай дәмді
Dialogue: 0,0:11:06.41,0:11:08.70,Default,,0,0,0,,Қандай жақсы сәйкестік!
Dialogue: 0,0:11:08.79,0:11:09.96,Default,,0,0,0,,Токугава!
Dialogue: 0,0:11:10.71,0:11:13.46,Default,,0,0,0,,Қазір дайын бол!
Dialogue: 0,0:11:13.54,0:11:14.67,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:11:19.55,0:11:21.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:21.55,0:11:23.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:24.85,0:11:27.47,Default,,0,0,0,,Сонымен... бұл таңқаларлық.
Dialogue: 0,0:11:27.56,0:11:32.06,Default,,0,0,0,,Сағыз таспасы соғылған жерінен емес, артқы жағында қабыршақтанып жатыр.
Dialogue: 0,0:11:32.56,0:11:34.73,Default,,0,0,0,,Кездейсоқ соққы – бұл деңгей.
Dialogue: 0,0:11:36.82,0:11:39.19,Default,,0,0,0,,Миямото Мусашидің күші
Dialogue: 0,0:11:39.28,0:11:41.74,Default,,0,0,0,,Мен әділ соманы білдім деп ойладым, бірақ
Dialogue: 0,0:11:42.32,0:11:45.74,Default,,0,0,0,,Егер сіз осындай деңгейде соққы алсаңыз, тіпті керемет қылышшы болсаңыз да,
Dialogue: 0,0:11:46.33,0:11:48.33,Default,,0,0,0,,Сіз тұра алмайсыз.
Dialogue: 0,0:11:49.66,0:11:50.75,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:51.75,0:11:53.96,Default,,0,0,0,,Негізі сені жеңетін ойым жоқ.
Dialogue: 0,0:11:54.04,0:11:54.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:56.84,0:11:58.92,Default,,0,0,0,,Мен сені өлтіруді ойладым...
Dialogue: 0,0:11:59.84,0:12:01.30,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:04.09,0:12:05.34,Default,,0,0,0,,«Золушка» сұлулық салонына қош келдіңіз.
Dialogue: 0,0:12:07.60,0:12:10.77,Default,,0,0,0,,Бұл Бақи-санның сөзіне ұқсамайды.
Dialogue: 0,0:12:10.85,0:12:13.19,Default,,0,0,0,,Мүмкін мен көп айтпаған шығармын.
Dialogue: 0,0:12:14.48,0:12:15.35,Default,,0,0,0,,Бұл –
Dialogue: 0,0:12:15.86,0:12:18.61,Default,,0,0,0,,Доппо-сан осылай деді...
Dialogue: 0,0:12:19.61,0:12:22.19,Default,,0,0,0,,Өзін Миямото Мусаши деп атайтын адам
Dialogue: 0,0:12:22.28,0:12:24.03,Default,,0,0,0,,Бұл шын ба, жоқ па?
Dialogue: 0,0:12:24.11,0:12:26.78,Default,,0,0,0,,Жарайды, маған бәрібір.
Dialogue: 0,0:12:28.12,0:12:29.79,Default,,0,0,0,,Ең бастысы
Dialogue: 0,0:12:30.41,0:12:33.79,Default,,0,0,0,,Бұл оның өкілеттіктері нақты нәрсеге өте ұқсас екенін білдіреді.
Dialogue: 0,0:12:34.54,0:12:35.46,Default,,0,0,0,,(Изунаның ырылы)
Dialogue: 0,0:12:37.13,0:12:41.67,Default,,0,0,0,,Іс жүзінде болған Доппо мырза өз сезімін білдірді.
Dialogue: 0,0:12:42.59,0:12:44.51,Default,,0,0,0,,Бұл жай ғана айтылған сөздер емес.
Dialogue: 0,0:12:45.01,0:12:49.51,Default,,0,0,0,,Сол теңдесі жоқ адамды жеңгіңіз келе ме? Жеңістің орнына оны өлтіру керек пе?
Dialogue: 0,0:12:50.31,0:12:51.31,Default,,0,0,0,,Иә
Dialogue: 0,0:12:51.39,0:12:53.02,Default,,0,0,0,,өлтіру, көму
Dialogue: 0,0:12:53.98,0:12:55.27,Default,,0,0,0,,сою
Dialogue: 0,0:13:03.82,0:13:05.65,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:13:12.95,0:13:15.58,Default,,0,0,0,,Ол адаммен бірге болмау керек.
Dialogue: 0,0:13:26.51,0:13:28.39,Default,,0,0,0,,Мен кіремін.
Dialogue: 0,0:13:28.89,0:13:30.97,Default,,0,0,0,,«Құпия бақылау»
Dialogue: 0,0:13:31.06,0:13:32.77,Default,,0,0,0,,...Бұл мүмкін емес.
Dialogue: 0,0:13:32.85,0:13:34.81,Default,,0,0,0,,Мұнда 〇１ 〇〇Өтінемін
Dialogue: 0,0:13:35.73,0:13:38.81,Default,,0,0,0,,Мұнда 〇〇 〇1 Өтінемін
Dialogue: 0,0:13:38.90,0:13:41.40,Default,,0,0,0,,〇1 ағымдағы орны
Dialogue: 0,0:13:41.90,0:13:44.90,Default,,0,0,0,,687 №. 358
Dialogue: 0,0:13:44.99,0:13:46.82,Default,,0,0,0,,Ағымдағы орындағы люкте...
Dialogue: 0,0:14:03.92,0:14:04.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:10.39,0:14:11.35,Default,,0,0,0,,Ммм
Dialogue: 0,0:14:15.93,0:14:16.85,Default,,0,0,0,,Ішек
Dialogue: 0,0:14:30.91,0:14:32.62,Default,,0,0,0,,Бұл Рюкюдің хабы ма?
Dialogue: 0,0:14:33.20,0:14:35.04,Default,,0,0,0,,Жыланнан жақсы
Dialogue: 0,0:14:45.21,0:14:48.38,Default,,0,0,0,,Хм, тамақ тапшылығы жоқ.
Dialogue: 0,0:14:58.10,0:15:00.64,Default,,0,0,0,,Хехе, жақсылап тамақтан.
Dialogue: 0,0:15:00.73,0:15:03.15,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:15:09.03,0:15:11.91,Default,,0,0,0,,Ол қайтадан үлкейді ме? тұздалған қияр
Dialogue: 0,0:15:12.70,0:15:14.70,Default,,0,0,0,,Ханаяма да үлкен болды, бірақ
Dialogue: 0,0:15:14.78,0:15:17.91,Default,,0,0,0,,Пикле, сен ең жақсысың!
Dialogue: 0,0:15:20.87,0:15:21.75,Default,,0,0,0,,Хмм
Dialogue: 0,0:15:21.83,0:15:24.92,Default,,0,0,0,,Мен мұнда ешнәрсе үшін келген жоқпын...
Dialogue: 0,0:15:26.84,0:15:28.09,Default,,0,0,0,,Мен сені көруге келдім.
Dialogue: 0,0:15:30.09,0:15:32.97,Default,,0,0,0,,Кувата мырза, мүмкін осында...
Dialogue: 0,0:15:33.05,0:15:34.39,Default,,0,0,0,,Осы жерде...
Dialogue: 0,0:15:34.47,0:15:37.01,Default,,0,0,0,,Не, сен мұны енді түсіндің бе?
Dialogue: 0,0:15:37.10,0:15:39.43,Default,,0,0,0,,Сонымен... бұл тұздалған қияр, солай емес пе?
Dialogue: 0,0:15:39.52,0:15:41.44,Default,,0,0,0,,А... иә? Яғни...
Dialogue: 0,0:15:41.52,0:15:43.40,Default,,0,0,0,,Осымен
Dialogue: 0,0:15:43.48,0:15:45.44,Default,,0,0,0,,Мен қарабайыр адамдар мен самурайлардың кездесуін қалаймын.
Dialogue: 0,0:15:46.32,0:15:49.69,Default,,0,0,0,,Біреу самурайларға осы жер туралы айтып берді.
Dialogue: 0,0:16:01.83,0:16:02.96,Default,,0,0,0,,Бұл…
Dialogue: 0,0:16:03.62,0:16:04.96,Default,,0,0,0,,Мұның бәрі
Dialogue: 0,0:16:05.04,0:16:07.96,Default,,0,0,0,,Сен жалғыз тамақтандың.
Dialogue: 0,0:16:10.05,0:16:13.22,Default,,0,0,0,,От қолданбасаң, шикі жейсің.
Dialogue: 0,0:16:13.30,0:16:14.89,Default,,0,0,0,,Тек сүйектер
Dialogue: 0,0:16:14.97,0:16:17.22,Default,,0,0,0,,Менің де ішектерім таза, балғын.
Dialogue: 0,0:16:17.81,0:16:20.31,Default,,0,0,0,,Көрдім, күшті екен.
Dialogue: 0,0:16:27.31,0:16:28.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:33.36,0:16:35.49,Default,,0,0,0,,Мен мұны жеуім керек пе?
Dialogue: 0,0:16:46.25,0:16:47.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:48.67,0:16:50.25,Default,,0,0,0,,Мм, ми плазмасы?
Dialogue: 0,0:16:51.09,0:16:52.26,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:16:54.34,0:16:55.76,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:56.34,0:16:59.64,Default,,0,0,0,,Пикле Аздап сөйлескіңіз келе ме?
Dialogue: 0,0:17:00.22,0:17:01.52,Default,,0,0,0,,Мен мұны кәдесый ретінде алғым келеді.
Dialogue: 0,0:17:02.35,0:17:05.35,Default,,0,0,0,,Не? Мен оны міндетті түрде кейін жеймін, сондықтан мен оны пісіремін ...
Dialogue: 0,0:17:09.11,0:17:10.77,Default,,0,0,0,,Токугавадан естілді
Dialogue: 0,0:17:12.23,0:17:13.53,Default,,0,0,0,,Мүлдем сөйлеме
Dialogue: 0,0:17:14.49,0:17:16.11,Default,,0,0,0,,Бірақ мен сенімен сөйлесуге келдім.
Dialogue: 0,0:17:19.66,0:17:23.45,Default,,0,0,0,,Тұздақ та алыс, шалғай елден келген.
Dialogue: 0,0:17:24.12,0:17:28.25,Default,,0,0,0,,Мен Токугавадан оның менімен бірдей жағдайда болғанын естідім.
Dialogue: 0,0:17:28.75,0:17:32.05,Default,,0,0,0,,Мен оның қалай жұмыс істейтінін білмеймін...
Dialogue: 0,0:17:34.97,0:17:37.47,Default,,0,0,0,,Сөйлесе алмайтын тұздық
Dialogue: 0,0:17:37.97,0:17:40.05,Default,,0,0,0,,Бірақ мен сені көруге келдім.
Dialogue: 0,0:17:41.72,0:17:45.81,Default,,0,0,0,,Сөйлемейтін адаммен не істеп жүрсің?
Dialogue: 0,0:17:47.64,0:17:49.52,Default,,0,0,0,,Мен мұны түсінемін
Dialogue: 0,0:17:49.61,0:17:52.57,Default,,0,0,0,,Осылай жасасаңыз, мағынасын түсінесіз.
Dialogue: 0,0:17:55.44,0:17:58.57,Default,,0,0,0,,Сіз мен күткендей тынышсыз.
Dialogue: 0,0:17:59.66,0:18:01.33,Default,,0,0,0,,Толық сөйле
Dialogue: 0,0:18:01.95,0:18:03.29,Default,,0,0,0,,созылды
Dialogue: 0,0:18:08.25,0:18:09.33,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:10.42,0:18:13.34,Default,,0,0,0,,Уф... Сонымен... шықты!
Dialogue: 0,0:18:20.26,0:18:23.35,Default,,0,0,0,,Сіз тым дабылсыз, самурай.
Dialogue: 0,0:18:25.52,0:18:27.10,Default,,0,0,0,,Нені шулатып жатырсың?
Dialogue: 0,0:18:27.68,0:18:29.10,Default,,0,0,0,,(дірілдеген тыныс)
Dialogue: 0,0:18:30.02,0:18:31.36,Default,,0,0,0,,Ноу
Dialogue: 0,0:18:32.27,0:18:34.19,Default,,0,0,0,,Мен жай серуендеймін
Dialogue: 0,0:18:34.27,0:18:35.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:35.19,0:18:37.44,Default,,0,0,0,,Ол жақ өздігінен шу шығарады.
Dialogue: 0,0:18:37.53,0:18:38.36,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:39.53,0:18:40.36,Default,,0,0,0,,Ах
Dialogue: 0,0:18:40.45,0:18:41.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:45.99,0:18:48.04,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:18:50.00,0:18:52.08,Default,,0,0,0,,Жүгіру немесе жасырыну
Dialogue: 0,0:18:55.21,0:19:01.05,Default,,0,0,0,,Ха ха ха... Солай ма?
Dialogue: 0,0:19:01.14,0:19:02.68,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:19:02.76,0:19:05.14,Default,,0,0,0,,Егер сіз сол құбыжықты өлтірсеңіз...
Dialogue: 0,0:19:05.72,0:19:08.14,Default,,0,0,0,,Иә, бұл менің ниетім.
Dialogue: 0,0:19:08.98,0:19:10.14,Default,,0,0,0,,Баки-сан
Dialogue: 0,0:19:10.23,0:19:14.15,Default,,0,0,0,,Қылмыскер қанша үлкен болса да,
Dialogue: 0,0:19:14.73,0:19:17.86,Default,,0,0,0,,Егер сіз шынымен солай істесеңіз
Dialogue: 0,0:19:17.94,0:19:21.66,Default,,0,0,0,,Сіз не ұтып, нені жоғалтатыныңызды білесіз бе?
Dialogue: 0,0:19:22.36,0:19:24.03,Default,,0,0,0,,Не болса да
Dialogue: 0,0:19:24.99,0:19:26.66,Default,,0,0,0,,Мен бұл туралы ойламадым.
Dialogue: 0,0:19:26.74,0:19:28.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:29.54,0:19:32.67,Default,,0,0,0,,Оны жібергеннен кейін ойлану керек.
Dialogue: 0,0:19:36.25,0:19:37.21,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:44.64,0:19:45.93,Default,,0,0,0,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:19:46.01,0:19:47.56,Default,,0,0,0,,Ха-ха-ха-ха…
Dialogue: 0,0:19:47.64,0:19:49.93,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:19:52.02,0:19:53.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:57.02,0:19:58.15,Default,,0,0,0,,Ах
Dialogue: 0,0:19:59.99,0:20:01.95,Default,,0,0,0,,Хиди, бұл ата.
Dialogue: 0,0:20:02.03,0:20:04.95,Default,,0,0,0,,Сәлем...сәлем~
Dialogue: 0,0:20:06.49,0:20:08.54,Default,,0,0,0,,Шешуші шайқас алдындағы түн
Dialogue: 0,0:20:39.32,0:20:40.61,Default,,0,0,0,,Хехехе
Dialogue: 0,0:20:41.44,0:20:44.20,Default,,0,0,0,,Әлемнің ең ұлысын қабылдауға тырысқанда
Dialogue: 0,0:20:44.28,0:20:47.07,Default,,0,0,0,,Әдеттегідей
Dialogue: 0,0:20:47.16,0:20:48.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:48.70,0:20:50.20,Default,,0,0,0,,Манга салмас бұрын жаттығулар
Dialogue: 0,0:20:50.29,0:20:54.92,Default,,0,0,0,,Ол Миямото Мусаши-дононы өлім аузына апаратынын мәлімдеді.
Dialogue: 0,0:20:55.50,0:20:58.63,Default,,0,0,0,,Мен сізді шын жүректен таңданамын.
Dialogue: 0,0:20:58.71,0:21:00.17,Default,,0,0,0,,Чо Чо Чо…
Dialogue: 0,0:21:00.25,0:21:02.13,Default,,0,0,0,,Тоқтатыңызшы...
Dialogue: 0,0:21:02.21,0:21:03.88,Default,,0,0,0,,Неліктен сонша көп білесің?
Dialogue: 0,0:21:03.97,0:21:05.18,Default,,0,0,0,,Хаха
Dialogue: 0,0:21:05.76,0:21:07.89,Default,,0,0,0,,Өйткені мен сенің жасырын жанкүйеріңмін.
Dialogue: 0,0:21:08.47,0:21:09.30,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:10.97,0:21:13.64,Default,,0,0,0,,Тенка Мусу ештеңе жоқ
Dialogue: 0,0:21:14.64,0:21:16.14,Default,,0,0,0,,Қауіпсіз қайтару
Dialogue: 0,0:21:16.94,0:21:18.61,Default,,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,0:21:20.86,0:21:23.99,Default,,0,0,0,,Жарыс қаншада басталады?
Dialogue: 0,0:21:40.42,0:21:41.80,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:21:53.64,0:21:54.56,Default,,0,0,0,,Бонн
Dialogue: 0,0:21:55.60,0:21:57.06,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:21:59.19,0:22:00.65,Default,,0,0,0,,Күтуден шаршадым.
Dialogue: 0,0:22:01.65,0:22:02.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:04.44,0:22:07.49,Default,,0,0,0,,Хмм?
Dialogue: 0,0:22:12.66,0:22:14.66,Default,,0,0,0,,(Мусашидің ырылдауы)
Dialogue: 0,0:22:15.54,0:22:19.21,Default,,0,0,0,,Жедің бе, Баки?
Dialogue: 0,0:22:21.67,0:22:23.67,Default,,0,0,0,,♪～
Dialogue: 0,0:23:47.46,0:23:49.55,Default,,0,0,0,,～♪
