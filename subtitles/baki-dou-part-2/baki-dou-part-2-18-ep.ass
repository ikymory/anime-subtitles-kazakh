Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.51,0:00:13.51,Default,,0,0,0,,♪～
Dialogue: 0,0:01:37.09,0:01:39.09,Default,,0,0,0,,～♪
Dialogue: 0,0:02:00.20,0:02:02.74,Default,,0,0,0,,Мотобу мырза, мені кешіріңіз.
Dialogue: 0,0:02:02.83,0:02:04.62,Default,,0,0,0,,Хаа…
Dialogue: 0,0:02:05.25,0:02:06.37,Default,,0,0,0,,«Мен қорғағым келеді»
Dialogue: 0,0:02:06.45,0:02:09.25,Default,,0,0,0,,Мотобу-сан бізге осылай деді.
Dialogue: 0,0:02:09.33,0:02:11.67,Default,,0,0,0,,Сол сөздерге жауап ретінде...
Dialogue: 0,0:02:12.25,0:02:13.09,Default,,0,0,0,,Мен...
Dialogue: 0,0:02:13.59,0:02:15.38,Default,,0,0,0,,Жетер, Баки-сан.
Dialogue: 0,0:02:15.46,0:02:16.80,Default,,0,0,0,,Қате жасамаңыз
Dialogue: 0,0:02:16.88,0:02:18.01,Default,,0,0,0,,(Бакидің тыныс алу дыбысы)
Dialogue: 0,0:02:18.09,0:02:20.30,Default,,0,0,0,,«Мотобу Изомен бұл мүмкін емес».
Dialogue: 0,0:02:20.39,0:02:22.76,Default,,0,0,0,,- (Штаб) Бұл қалыпты шешім - (Баки) Жарайды...
Dialogue: 0,0:02:22.85,0:02:25.56,Default,,0,0,0,,Менің, құр қол адам мен сен, құбыжық.
Dialogue: 0,0:02:25.64,0:02:27.48,Default,,0,0,0,,Бұл өте нашар.
Dialogue: 0,0:02:27.98,0:02:31.60,Default,,0,0,0,,10 рет төбелесіп, 10 рет жеңе алатын орта жастағы ер адам.
Dialogue: 0,0:02:31.69,0:02:35.11,Default,,0,0,0,,Мұндай штаб өзін қорғай ма?
Dialogue: 0,0:02:37.15,0:02:39.28,Default,,0,0,0,,Бұл мені ашуландырады.
Dialogue: 0,0:02:39.36,0:02:40.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:42.66,0:02:44.83,Default,,0,0,0,,Бұл менің бойымнан асып түсті.
Dialogue: 0,0:02:44.91,0:02:47.29,Default,,0,0,0,,Жоқ, біз
Dialogue: 0,0:02:47.37,0:02:50.29,Default,,0,0,0,,Мен жекпе-жек шебері Мотобу Изоны қате бағаладым.
Dialogue: 0,0:02:50.37,0:02:54.79,Default,,0,0,0,,Сондықтан біз Миямото Мусашидің қабілетіне қате баға береміз.
Dialogue: 0,0:02:57.21,0:02:58.42,Default,,0,0,0,,Мен надан едім.
Dialogue: 0,0:02:59.67,0:03:00.88,Default,,0,0,0,,Сізді сонда көргеніме өкінемін
Dialogue: 0,0:03:06.26,0:03:08.43,Default,,0,0,0,,- (Штаб) Баки мырза - (Баки) Ха
Dialogue: 0,0:03:09.31,0:03:11.35,Default,,0,0,0,,Жер бетіндегі ең күшті жігіт
Dialogue: 0,0:03:11.44,0:03:14.94,Default,,0,0,0,,Сен қазынасың, бұл дәуірдің белгісі.
Dialogue: 0,0:03:15.52,0:03:17.19,Default,,0,0,0,,Күш ұғымы болып табылады
Dialogue: 0,0:03:17.28,0:03:19.49,Default,,0,0,0,,Сіз оны мұраға алдыңыз.
Dialogue: 0,0:03:20.95,0:03:22.20,Default,,0,0,0,,Огре
Dialogue: 0,0:03:23.03,0:03:25.20,Default,,0,0,0,,Жер бетіндегі ең күшті тіршілік иесі
Dialogue: 0,0:03:25.95,0:03:28.95,Default,,0,0,0,,Құдай – бұл дүниенің тәртібі.
Dialogue: 0,0:03:29.62,0:03:31.96,Default,,0,0,0,,Құдай жібере алмайды
Dialogue: 0,0:03:32.87,0:03:34.96,Default,,0,0,0,,Гоки Шибукава мырза
Dialogue: 0,0:03:35.59,0:03:38.46,Default,,0,0,0,,Ол технология қазір ұлттық қазына болып табылады.
Dialogue: 0,0:03:39.05,0:03:41.34,Default,,0,0,0,,Материалдық емес мәдени құндылықтар қорғалуы керек
Dialogue: 0,0:03:42.34,0:03:43.84,Default,,0,0,0,,Доппо Гучи
Dialogue: 0,0:03:44.43,0:03:46.35,Default,,0,0,0,,Қазіргі каратэнің атасы
Dialogue: 0,0:03:47.10,0:03:49.22,Default,,0,0,0,,Егер сіз соғыс құдайы Допподан айырылсаңыз
Dialogue: 0,0:03:49.81,0:03:52.23,Default,,0,0,0,,Каратэ күнді жоғалтады
Dialogue: 0,0:03:52.31,0:03:54.73,Default,,0,0,0,,Мұндай жағдай кешірілмейді.
Dialogue: 0,0:03:54.81,0:03:55.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:56.86,0:04:00.82,Default,,0,0,0,,Тек Каору Ханаямада болатын теңдесі жоқ мақтаныш
Dialogue: 0,0:04:01.32,0:04:03.57,Default,,0,0,0,,Үлкен өзгеріс Катцуми Гучи
Dialogue: 0,0:04:03.66,0:04:07.33,Default,,0,0,0,,Каратэ әлемінің керемет екінші күні.
Dialogue: 0,0:04:07.83,0:04:09.37,Default,,0,0,0,,Бұл тұздалған қияр.
Dialogue: 0,0:04:09.45,0:04:11.87,Default,,0,0,0,,Адамзаттың белгілі қазынасы
Dialogue: 0,0:04:11.96,0:04:13.67,Default,,0,0,0,,Және достар
Dialogue: 0,0:04:14.29,0:04:17.79,Default,,0,0,0,,Гайаның Жерге қолайлы ұрыс техникасы
Dialogue: 0,0:04:18.46,0:04:23.17,Default,,0,0,0,,Ол жолдан тайса да, Кийосуми Като каратэде тайсалмай қалады.
Dialogue: 0,0:04:24.38,0:04:27.85,Default,,0,0,0,,Хо Момижи анатомиясы және ұрыс техникасы
Dialogue: 0,0:04:28.89,0:04:31.81,Default,,0,0,0,,Інісі Қошоның шабу мәнері
Dialogue: 0,0:04:32.85,0:04:35.31,Default,,0,0,0,,Қытай жекпе-жек өнерінің инкарнациясы
Dialogue: 0,0:04:35.40,0:04:37.65,Default,,0,0,0,,Император Го Хайдың ұзақ ғұмыры
Dialogue: 0,0:04:38.90,0:04:40.61,Default,,0,0,0,,Өзін-өзі жетілдірудегі ең жоғарғы
Dialogue: 0,0:04:40.69,0:04:43.28,Default,,0,0,0,,Джек балғаның тістеу күші
Dialogue: 0,0:04:43.36,0:04:46.49,Default,,0,0,0,,Бисквит Оливаның сапасыз супер күші
Dialogue: 0,0:04:46.57,0:04:49.99,Default,,0,0,0,,Біздің әрқайсымыз өз заманымыздың қазынасы.
Dialogue: 0,0:04:50.58,0:04:52.25,Default,,0,0,0,,Бұл тағы да «ол қазір басталды» сценарийі ме, кіру емтихандарындағыдай?
Dialogue: 0,0:04:52.33,0:04:53.87,Default,,0,0,0,,Бірақ Баки мырза
Dialogue: 0,0:04:53.96,0:04:56.75,Default,,0,0,0,,Әрқайсысы бір-бірімен байланысқан
Dialogue: 0,0:04:57.50,0:05:00.25,Default,,0,0,0,,Екінші жағынан, ол туралы не деуге болады?
Dialogue: 0,0:05:00.34,0:05:02.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:03.80,0:05:06.55,Default,,0,0,0,,Менің атымның айтылғанын көріп, көңілім көтерілді.
Dialogue: 0,0:05:06.63,0:05:07.64,Default,,0,0,0,,Момижи-сан
Dialogue: 0,0:05:07.72,0:05:09.89,Default,,0,0,0,,Мұсаши мырза теледидарда.
Dialogue: 0,0:05:09.97,0:05:10.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:15.77,0:05:18.81,Default,,0,0,0,,Е, дәл қазір менің алдымда
Dialogue: 0,0:05:18.90,0:05:21.65,Default,,0,0,0,,Төтенше адам отыр
Dialogue: 0,0:05:21.73,0:05:23.11,Default,,0,0,0,,Мен де осы уақытқа дейін
Dialogue: 0,0:05:23.19,0:05:26.99,Default,,0,0,0,,Мен көптеген таңғажайып адамдармен танысуға мүмкіндік алдым.
Dialogue: 0,0:05:27.07,0:05:29.28,Default,,0,0,0,,Мен не айтуым керек...
Dialogue: 0,0:05:29.37,0:05:31.16,Default,,0,0,0,,Е...
Dialogue: 0,0:05:31.24,0:05:33.04,Default,,0,0,0,,Бұл керемет күшті.
Dialogue: 0,0:05:33.91,0:05:35.33,Default,,0,0,0,,Аң сияқты
Dialogue: 0,0:05:35.41,0:05:37.67,Default,,0,0,0,,А... жоқ, кешіріңіз.
Dialogue: 0,0:05:37.75,0:05:38.83,Default,,0,0,0,,Е...
Dialogue: 0,0:05:38.92,0:05:41.54,Default,,0,0,0,,Еңбек жолынан туған абырой ма?
Dialogue: 0,0:05:41.63,0:05:44.21,Default,,0,0,0,,Қалай болғанда да, мен не айтуым керек?
Dialogue: 0,0:05:44.30,0:05:45.30,Default,,0,0,0,,Е...
Dialogue: 0,0:05:45.38,0:05:47.80,Default,,0,0,0,,... күшті сияқты.
Dialogue: 0,0:05:48.38,0:05:51.05,Default,,0,0,0,,Көрермендер де жақсы біледі.
Dialogue: 0,0:05:51.72,0:05:52.81,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:05:53.51,0:05:55.31,Default,,0,0,0,,Миямото Мусаши!
Dialogue: 0,0:05:57.14,0:05:59.31,Default,,0,0,0,,Ача~
Dialogue: 0,0:05:59.40,0:06:00.86,Default,,0,0,0,,Бұл шықты...
Dialogue: 0,0:06:00.94,0:06:02.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:04.15,0:06:06.32,Default,,0,0,0,,- (Қаладағы адамдар) А? -(Қаладағы адамдар) А...
Dialogue: 0,0:06:06.40,0:06:07.90,Default,,0,0,0,,Актер?
Dialogue: 0,0:06:08.40,0:06:10.07,Default,,0,0,0,,Мен бұл жігітті білемін.
Dialogue: 0,0:06:10.16,0:06:12.08,Default,,0,0,0,,Бұл жаңалықтарда болды, солай ма?
Dialogue: 0,0:06:12.16,0:06:13.99,Default,,0,0,0,,Бұл тікелей эфир болғандықтан
Dialogue: 0,0:06:14.08,0:06:16.33,Default,,0,0,0,,Мен де қобалжыдым.
Dialogue: 0,0:06:16.41,0:06:18.58,Default,,0,0,0,,Біз осында кіруіміз керек.
Dialogue: 0,0:06:19.17,0:06:20.71,Default,,0,0,0,,Бірден
Dialogue: 0,0:06:20.79,0:06:23.96,Default,,0,0,0,,Миямото Мусаши мырза?
Dialogue: 0,0:06:24.05,0:06:27.22,Default,,0,0,0,,...Шындық емес пе?
Dialogue: 0,0:06:27.30,0:06:30.22,Default,,0,0,0,,Идиот! Мұндай нәрсе...
Dialogue: 0,0:06:34.14,0:06:36.85,Default,,0,0,0,,Неге қазір менің атымды сұрап тұрсың?
Dialogue: 0,0:06:36.93,0:06:38.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:38.43,0:06:41.19,Default,,0,0,0,,Мұсашидің осында болуының себебі болса керек.
Dialogue: 0,0:06:41.27,0:06:42.36,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:06:44.11,0:06:47.24,Default,,0,0,0,,Иә, бұл рас, бірақ...
Dialogue: 0,0:06:47.82,0:06:49.40,Default,,0,0,0,,Қалыпты Мусаши-сан
Dialogue: 0,0:06:49.49,0:06:53.24,Default,,0,0,0,,400 жыл бұрынғы қылыш шеберіне күмәнім бар.
Dialogue: 0,0:06:53.32,0:06:54.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:54.33,0:06:55.87,Default,,0,0,0,,- (Штаб) Уа! -(Баки) Мен өлтірдім!
Dialogue: 0,0:06:58.79,0:06:59.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:00.12,0:07:01.25,Default,,0,0,0,,Мұсаши мырза
Dialogue: 0,0:07:02.04,0:07:03.84,Default,,0,0,0,,Сіз оны жаңа ғана кесіп тастадыңыз ба?
Dialogue: 0,0:07:04.34,0:07:08.26,Default,,0,0,0,,Нағыз Миямото Мусашиді қабылдадыңыз ба?
Dialogue: 0,0:07:08.34,0:07:10.26,Default,,0,0,0,,Жоқ... иә
Dialogue: 0,0:07:10.34,0:07:12.14,Default,,0,0,0,,Менің сол қолымда бірдеңе...
Dialogue: 0,0:07:12.89,0:07:15.64,Default,,0,0,0,,Жарайды, мен бәріне түсіндіремін.
Dialogue: 0,0:07:15.72,0:07:19.14,Default,,0,0,0,,Менің сол қолым осындай... Көзге көрінбейтін қылыш...
Dialogue: 0,0:07:19.23,0:07:20.39,Default,,0,0,0,,Уф
Dialogue: 0,0:07:22.48,0:07:24.90,Default,,0,0,0,,Ах... енді...
Dialogue: 0,0:07:24.98,0:07:25.90,Default,,0,0,0,,(Қарт әйел) Құдайым-ай, сіз қандай құмар әрі жігерлі талапкерсіз.
Dialogue: 0,0:07:26.52,0:07:28.07,Default,,0,0,0,,Мен қазір, шамасы
Dialogue: 0,0:07:28.15,0:07:31.24,Default,,0,0,0,,Оның басын көзге көрінбейтін қылыш шауып алған сияқты.
Dialogue: 0,0:07:31.32,0:07:33.91,Default,,0,0,0,,Мұсаши мырзада қылыш болса ше?
Dialogue: 0,0:07:33.99,0:07:38.16,Default,,0,0,0,,Менің басым аяғымның астында жатыр.
Dialogue: 0,0:07:38.24,0:07:40.91,Default,,0,0,0,,Мусаши-сан кескенді ұната ма?
Dialogue: 0,0:07:41.00,0:07:41.66,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:43.50,0:07:45.67,Default,,0,0,0,,Кесу дұрыс па?
Dialogue: 0,0:07:46.50,0:07:49.26,Default,,0,0,0,,Ах... м...
Dialogue: 0,0:07:49.34,0:07:50.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:54.01,0:07:55.05,Default,,0,0,0,,- (Кастер) Иә? -(Баки) А...
Dialogue: 0,0:07:55.14,0:07:56.43,Default,,0,0,0,,(Мотобу дыбысы және күзгі жапырақтардың тыныс алуы)
Dialogue: 0,0:07:56.51,0:07:58.68,Default,,0,0,0,,- (Қаладағы адамдар) Иә? -(Қаладағы адамдар) Иә?
Dialogue: 0,0:07:58.76,0:08:00.93,Default,,0,0,0,,Менің белімде бірдеңе...
Dialogue: 0,0:08:01.02,0:08:02.69,Default,,0,0,0,,Бір нәрсе енгізілген
Dialogue: 0,0:08:02.77,0:08:03.94,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:08:04.02,0:08:05.19,Default,,0,0,0,,Уақытында емес
Dialogue: 0,0:08:06.06,0:08:09.69,Default,,0,0,0,,Сол кезде еліміздің түкпір-түкпірінен келген көрермендер көргені айтылды.
Dialogue: 0,0:08:09.78,0:08:14.28,Default,,0,0,0,,Мұсашы белінде мөлдір болып көрінетін нәрсе.
Dialogue: 0,0:08:14.78,0:08:16.53,Default,,0,0,0,,Кесу
Dialogue: 0,0:08:16.62,0:08:18.45,Default,,0,0,0,,Мәселе мынада
Dialogue: 0,0:08:19.08,0:08:21.08,Default,,0,0,0,,Сонымен... солай ма?
Dialogue: 0,0:08:21.16,0:08:23.08,Default,,0,0,0,,Сіздің дөрекілігіңіз
Dialogue: 0,0:08:23.16,0:08:25.75,Default,,0,0,0,,Біраз уақыттан бері өте тыныш.
Dialogue: 0,0:08:25.83,0:08:28.09,Default,,0,0,0,,Неліктен? Неге қылыш?
Dialogue: 0,0:08:28.17,0:08:30.84,Default,,0,0,0,,Егер сенің мақсатың мені ашуландыру болса
Dialogue: 0,0:08:31.42,0:08:33.97,Default,,0,0,0,,Жеткілікті орындалды.
Dialogue: 0,0:08:34.05,0:08:36.34,Default,,0,0,0,,Мұсаши мырза, әлгі қылыш...
Dialogue: 0,0:08:37.22,0:08:38.22,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:08:38.30,0:08:42.02,Default,,0,0,0,,Бейне кейінірек бүкіл әлемге таралады.
Dialogue: 0,0:08:42.10,0:08:44.10,Default,,0,0,0,,Нақты уақыттағы әуе соққысы оқиғасы
Dialogue: 0,0:08:45.90,0:08:49.52,Default,,0,0,0,,Бұл Мусашидің тағдырын шешеді
Dialogue: 0,0:08:49.61,0:08:51.98,Default,,0,0,0,,Токугава мен үйге бара жатырмын!
Dialogue: 0,0:08:55.32,0:08:56.99,Default,,0,0,0,,Осы жерден бастаңыз
Dialogue: 0,0:08:57.95,0:08:59.49,Default,,0,0,0,,...осы жерде
Dialogue: 0,0:09:00.08,0:09:02.95,Default,,0,0,0,,...міне, міне.
Dialogue: 0,0:09:03.04,0:09:06.00,Default,,0,0,0,,Не? Жоқ, шынымен мені кесіп тастағандай болды.
Dialogue: 0,0:09:06.71,0:09:08.00,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:09:08.08,0:09:09.00,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:09:09.09,0:09:10.75,Default,,0,0,0,,Бастың ортасында
Dialogue: 0,0:09:11.34,0:09:12.51,Default,,0,0,0,,Торсо
Dialogue: 0,0:09:13.26,0:09:16.76,Default,,0,0,0,,Мен қылыштың бойымнан өтіп бара жатқанын сезінемін.
Dialogue: 0,0:09:16.84,0:09:18.26,Default,,0,0,0,,Осыдан кейін?
Dialogue: 0,0:09:18.84,0:09:20.26,Default,,0,0,0,,Мен есінен танып бара жатырмын.
Dialogue: 0,0:09:20.35,0:09:22.77,Default,,0,0,0,,Мен мұны білмей тұрып, аурухана төсегінде жаттым.
Dialogue: 0,0:09:23.89,0:09:25.39,Default,,0,0,0,,Ах~
Dialogue: 0,0:09:25.89,0:09:28.27,Default,,0,0,0,,Мен бұл қалыпты деп ойладым.
Dialogue: 0,0:09:28.35,0:09:30.77,Default,,0,0,0,,«Аа... мен өлдім.»
Dialogue: 0,0:09:35.11,0:09:35.65,Default,,0,0,0,,(Қашықтан басқару пультінің дыбысы)
Dialogue: 0,0:09:35.65,0:09:36.20,Default,,0,0,0,,(Қашықтан басқару пультінің дыбысы)
Dialogue: 0,0:09:35.65,0:09:36.20,Default,,0,0,0,,Орныңыздан тұрып, бірнеше сөзбен алмасу...
Dialogue: 0,0:09:36.20,0:09:39.32,Default,,0,0,0,,Орныңыздан тұрып, бірнеше сөзбен алмасу...
Dialogue: 0,0:09:39.82,0:09:40.74,Default,,0,0,0,,осында
Dialogue: 0,0:09:42.16,0:09:44.04,Default,,0,0,0,,Сіз кеткен кезде
Dialogue: 0,0:09:44.12,0:09:47.12,Default,,0,0,0,,Мен қауесет қылышты көрмеймін
Dialogue: 0,0:09:47.21,0:09:49.17,Default,,0,0,0,,Ал мен оны бір саусақпен ұстағаным жоқ.
Dialogue: 0,0:09:49.75,0:09:51.79,Default,,0,0,0,,Бұл шынымен қиын емес пе?
Dialogue: 0,0:09:51.88,0:09:53.96,Default,,0,0,0,,Мен құладым.
Dialogue: 0,0:09:54.05,0:09:56.55,Default,,0,0,0,,Бұл да жоққа шығармайтын факт.
Dialogue: 0,0:09:57.22,0:09:59.43,Default,,0,0,0,,Мұғалім, бұл жағдайда...
Dialogue: 0,0:10:01.26,0:10:02.51,Default,,0,0,0,,Мақсат
Dialogue: 0,0:10:02.60,0:10:05.52,Default,,0,0,0,,Күнә жасау - күнә жасау.
Dialogue: 0,0:10:05.60,0:10:07.27,Default,,0,0,0,,Фактілер маңызды емес
Dialogue: 0,0:10:07.35,0:10:09.81,Default,,0,0,0,,Сіз ұсталғыңыз келе ме, жоқ па?
Dialogue: 0,0:10:09.90,0:10:11.31,Default,,0,0,0,,-(Үй) Ах... -(Хикики) Хмм...
Dialogue: 0,0:10:11.40,0:10:12.82,Default,,0,0,0,,Түсіргіңіз келсе
Dialogue: 0,0:10:12.90,0:10:16.82,Default,,0,0,0,,Көшеде өтіп бара жатқан барлық адамдарға қабырғаның ішіне кіруге рұқсат етіледі.
Dialogue: 0,0:10:16.90,0:10:19.41,Default,,0,0,0,,Біреу жақсы ма, жоқ па деген сұрақ жоқ.
Dialogue: 0,0:10:19.49,0:10:20.32,Default,,0,0,0,,(шатастырылған дауыс)
Dialogue: 0,0:10:21.20,0:10:23.58,Default,,0,0,0,,«Тарихи қаскөйлер»
Dialogue: 0,0:10:24.79,0:10:26.91,Default,,0,0,0,,Ендеше кеттік.
Dialogue: 0,0:10:28.16,0:10:30.33,Default,,0,0,0,,Маңызды анықтамалық тұлға?
Dialogue: 0,0:10:30.42,0:10:31.58,Default,,0,0,0,,Иә
Dialogue: 0,0:10:31.67,0:10:33.34,Default,,0,0,0,,Бұл жолы не болды?
Dialogue: 0,0:10:33.42,0:10:36.09,Default,,0,0,0,,Бұл ұлттық хабардың ортасында болған мысал...
Dialogue: 0,0:10:36.17,0:10:37.51,Default,,0,0,0,,Идиот!
Dialogue: 0,0:10:37.59,0:10:39.38,Default,,0,0,0,,Мен оқиға орнында болдым
Dialogue: 0,0:10:39.47,0:10:40.97,Default,,0,0,0,,Барлығын өз көзіммен көр
Dialogue: 0,0:10:41.59,0:10:42.97,Default,,0,0,0,,Оны бір саусақпен ұстамаңыз
Dialogue: 0,0:10:43.05,0:10:46.47,Default,,0,0,0,,Сонымен... қамауға алу емес...
Dialogue: 0,0:10:46.56,0:10:48.48,Default,,0,0,0,,Полиция бастығы Уцуми
Dialogue: 0,0:10:48.56,0:10:49.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:49.56,0:10:51.73,Default,,0,0,0,,Мәселе адамның өзінде.
Dialogue: 0,0:10:52.44,0:10:55.57,Default,,0,0,0,,Бұл адам сізге еріп жүруден бас тартты делік. Бұл қиындық тудырады.
Dialogue: 0,0:10:55.65,0:10:58.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:58.15,0:10:59.49,Default,,0,0,0,,Ескі герцог...
Dialogue: 0,0:11:02.32,0:11:04.03,Default,,0,0,0,,Сіз...
Dialogue: 0,0:11:04.58,0:11:07.16,Default,,0,0,0,,Сол... қылыш...
Dialogue: 0,0:11:07.24,0:11:09.75,Default,,0,0,0,,Қашып, жасырынып, Алайда...
Dialogue: 0,0:11:10.46,0:11:11.87,Default,,0,0,0,,Пайда болу және өлтіру
Dialogue: 0,0:11:11.96,0:11:13.75,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:11:14.88,0:11:16.46,Default,,0,0,0,,Бастайық, Токугава
Dialogue: 0,0:11:17.38,0:11:18.63,Default,,0,0,0,,Соғыс
Dialogue: 0,0:11:21.26,0:11:22.72,Default,,0,0,0,,Мусаши!
Dialogue: 0,0:11:24.68,0:11:25.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:25.81,0:11:28.10,Default,,0,0,0,,Үйге қайтыңыз.
Dialogue: 0,0:11:28.18,0:11:30.64,Default,,0,0,0,,Бұл қақпаның ішінде не болады?
Dialogue: 0,0:11:30.73,0:11:31.98,Default,,0,0,0,,Не қажет болса да жасаңыз.
Dialogue: 0,0:11:32.69,0:11:35.48,Default,,0,0,0,,Картоп, қақпаның сырты қуаттан тыс
Dialogue: 0,0:11:35.56,0:11:38.48,Default,,0,0,0,,Менің күшім менің күшімнен асып түседі.
Dialogue: 0,0:11:39.07,0:11:42.49,Default,,0,0,0,,Енді сізді құтқару мүмкін емес.
Dialogue: 0,0:11:45.07,0:11:47.20,Default,,0,0,0,,Өте мейірімді Токугава
Dialogue: 0,0:11:47.28,0:11:50.75,Default,,0,0,0,,Мусаши Сіз қақпадан тыс өмір сүре алмайсыз.
Dialogue: 0,0:11:55.58,0:11:56.75,Default,,0,0,0,,Ах
Dialogue: 0,0:11:57.67,0:11:58.50,Default,,0,0,0,,Хаа…
Dialogue: 0,0:12:01.09,0:12:02.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:02.84,0:12:04.01,Default,,0,0,0,,Токугава
Dialogue: 0,0:12:05.59,0:12:06.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:08.10,0:12:08.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:12.18,0:12:13.60,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:14.10,0:12:15.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:21.90,0:12:23.28,Default,,0,0,0,,Мусаши...
Dialogue: 0,0:12:24.74,0:12:26.62,Default,,0,0,0,,Мусаши!
Dialogue: 0,0:12:34.62,0:12:36.29,Default,,0,0,0,,Ммм
Dialogue: 0,0:12:41.96,0:12:45.30,Default,,0,0,0,,Охо! Бұл жігіт керемет
Dialogue: 0,0:12:45.38,0:12:48.55,Default,,0,0,0,,Мен де көптен бері үлкенмін.
Dialogue: 0,0:12:48.64,0:12:51.31,Default,,0,0,0,,Мен мұндай ғажайып допты бірінші рет көріп тұрмын.
Dialogue: 0,0:12:51.39,0:12:53.31,Default,,0,0,0,,Уцумиге не болды?
Dialogue: 0,0:12:53.39,0:12:56.65,Default,,0,0,0,,А, мен даланың адамы емеспін.
Dialogue: 0,0:12:56.73,0:12:58.48,Default,,0,0,0,,Мен сенің қайтып оралуыңды сұрадым.
Dialogue: 0,0:12:58.98,0:13:00.57,Default,,0,0,0,,Айтпақшы, Миямото мырза
Dialogue: 0,0:13:00.65,0:13:02.15,Default,,0,0,0,,Сол екі таяқша
Dialogue: 0,0:13:02.23,0:13:05.07,Default,,0,0,0,,Ерікті сүйемелдеу сызығы жойылды
Dialogue: 0,0:13:05.15,0:13:07.57,Default,,0,0,0,,Мен сені көлікке мінгіземін.
Dialogue: 0,0:13:09.53,0:13:11.45,Default,,0,0,0,,Ұстаудың қажеті жоқ
Dialogue: 0,0:13:12.24,0:13:14.46,Default,,0,0,0,,Иә, мен оны ұстауым керек сияқты.
Dialogue: 0,0:13:14.54,0:13:17.17,Default,,0,0,0,,Сіз үшін маңызды нәрселерге тәуелді болғаныңыз дұрыс.
Dialogue: 0,0:13:17.25,0:13:20.96,Default,,0,0,0,,Еліңді жау қылып жатырсың.
Dialogue: 0,0:13:23.46,0:13:26.47,Default,,0,0,0,,Иә, балалар сендер дұрыссыңдар ма?
Dialogue: 0,0:13:28.09,0:13:30.72,Default,,0,0,0,,Елді мен кессе де?
Dialogue: 0,0:13:32.01,0:13:34.31,Default,,0,0,0,,Бұл жігіт сенімді
Dialogue: 0,0:13:35.64,0:13:37.73,Default,,0,0,0,,Талқылау мүмкін емес пе?
Dialogue: 0,0:13:41.90,0:13:43.90,Default,,0,0,0,,Мен снарядтарды да дайындадым.
Dialogue: 0,0:13:44.53,0:13:46.24,Default,,0,0,0,,Егер сіз оны жұлып алсаңыз, мен сізді атып тастаймын.
Dialogue: 0,0:13:47.07,0:13:48.24,Default,,0,0,0,,Көре алсам ғой
Dialogue: 0,0:13:48.95,0:13:49.87,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:13:54.58,0:13:58.12,Default,,0,0,0,,Ал... осы жерден кетейік.
Dialogue: 0,0:14:00.25,0:14:01.96,Default,,0,0,0,,Неге оны жұлып алмайсың?
Dialogue: 0,0:14:02.04,0:14:03.38,Default,,0,0,0,,Егер ол қозғалса, атыңыз
Dialogue: 0,0:14:07.22,0:14:08.84,Default,,0,0,0,,- (Оцука) Жақсы. - (Полиция қызметкері) А?
Dialogue: 0,0:14:08.93,0:14:11.68,Default,,0,0,0,,Бұл аяқ. Оны шешпе, кесіп кетесің.
Dialogue: 0,0:14:11.76,0:14:12.76,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:14:13.22,0:14:15.14,Default,,0,0,0,,(Полиция қызметкерінің дірілдеген тынысы)
Dialogue: 0,0:14:17.85,0:14:18.69,Default,,0,0,0,,Уф
Dialogue: 0,0:14:19.85,0:14:21.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:24.48,0:14:26.40,Default,,0,0,0,,(Оцуканың ыңырсыуы)
Dialogue: 0,0:14:28.99,0:14:30.16,Default,,0,0,0,,(Полиция қызметкерлерінің күш айқайы)
Dialogue: 0,0:14:30.24,0:14:33.16,Default,,0,0,0,,Шыу!
Dialogue: 0,0:14:33.24,0:14:35.16,Default,,0,0,0,,(Оцуканың ыңырсыуы)
Dialogue: 0,0:14:36.75,0:14:38.91,Default,,0,0,0,,Ол құлады ма...
Dialogue: 0,0:14:39.00,0:14:40.42,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:14:45.88,0:14:49.13,Default,,0,0,0,,Құлаған алты адам бәрі солай айтты.
Dialogue: 0,0:14:49.22,0:14:50.68,Default,,0,0,0,,Менің басым ұшып кетті.
Dialogue: 0,0:14:51.59,0:14:52.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:53.10,0:14:54.85,Default,,0,0,0,,Жоқ, оны тартып алмаңыз.
Dialogue: 0,0:14:54.93,0:14:57.06,Default,,0,0,0,,Ол кейінірек жойылады.
Dialogue: 0,0:14:58.89,0:15:01.98,Default,,0,0,0,,Осыдан кейін? Мен көмектесе алмаймын.
Dialogue: 0,0:15:02.06,0:15:04.69,Default,,0,0,0,,Қандай жағдай болмасын, менде секіруден басқа амал жоқ.
Dialogue: 0,0:15:04.77,0:15:06.32,Default,,0,0,0,,Бұл полиция.
Dialogue: 0,0:15:07.03,0:15:08.94,Default,,0,0,0,,Нәтиже белгілі.
Dialogue: 0,0:15:09.70,0:15:10.53,Default,,0,0,0,,(жану дыбысы)
Dialogue: 0,0:15:12.16,0:15:12.99,Default,,0,0,0,,Хаа…
Dialogue: 0,0:15:13.70,0:15:15.49,Default,,0,0,0,,Күшті полиция қызметкері
Dialogue: 0,0:15:15.58,0:15:18.58,Default,,0,0,0,,Неліктен қалған алты адам да өлтірілді?
Dialogue: 0,0:15:19.08,0:15:22.00,Default,,0,0,0,,Егер олардың бәрі маған секірсе, мағынасыз болар еді, солай ма?
Dialogue: 0,0:15:23.33,0:15:24.59,Default,,0,0,0,,Қызық
Dialogue: 0,0:15:25.17,0:15:28.84,Default,,0,0,0,,Мұнда бес мүше бірдей айтады.
Dialogue: 0,0:15:28.92,0:15:31.84,Default,,0,0,0,,Олардың қоршалғаны анық.
Dialogue: 0,0:15:31.93,0:15:34.09,Default,,0,0,0,,Ендеше секірейік.
Dialogue: 0,0:15:34.93,0:15:36.85,Default,,0,0,0,,Менің алдымда бір досым болды
Dialogue: 0,0:15:37.43,0:15:39.73,Default,,0,0,0,,Егер одақтас кедергіге айналса
Dialogue: 0,0:15:40.31,0:15:42.48,Default,,0,0,0,,Менің кезегім келгенде
Dialogue: 0,0:15:43.15,0:15:46.23,Default,,0,0,0,,Шебер қылышшы Миямото Мусашимен жалғыз
Dialogue: 0,0:15:46.82,0:15:49.49,Default,,0,0,0,,Ал, қазіргі аяқ қимылы дегенді қалай түсінесіңдер?
Dialogue: 0,0:15:49.57,0:15:53.49,Default,,0,0,0,,Менің ойымша, бұл соғыс өнері деп аталады.
Dialogue: 0,0:15:54.24,0:15:55.99,Default,,0,0,0,,Бұл шынайы.
Dialogue: 0,0:15:56.58,0:15:59.95,Default,,0,0,0,,Елордалық полиция департаментіне енді ешкім күдіктене алмайды.
Dialogue: 0,0:16:01.12,0:16:02.83,Default,,0,0,0,,Қазіргі уақытта орындалуда
Dialogue: 0,0:16:03.33,0:16:05.25,Default,,0,0,0,,Келесі жаңалықтар
Dialogue: 0,0:16:05.96,0:16:08.13,Default,,0,0,0,,Әлгі қылышшы төбелесіп жатыр.
Dialogue: 0,0:16:08.80,0:16:12.13,Default,,0,0,0,,Кеше түнде Синдзюку округінде полиция қызметкері
Dialogue: 0,0:16:12.22,0:16:15.51,Default,,0,0,0,,Мен өзін Миямото Мусаши деп атайтын адамнан маған еріп жүруін өтіндім.
Dialogue: 0,0:16:16.14,0:16:17.55,Default,,0,0,0,,Адам қарсылық көрсетеді
Dialogue: 0,0:16:17.64,0:16:19.22,Default,,0,0,0,,Полиция қызметкерлерімен жанжал болды.
Dialogue: 0,0:16:19.31,0:16:21.89,Default,,0,0,0,,Жаңа ғана жоғалып кеткен дейді.
Dialogue: 0,0:16:22.48,0:16:24.27,Default,,0,0,0,,Елордалық полиция департаменті жағдайға байыппен қарады.
Dialogue: 0,0:16:24.35,0:16:26.65,Default,,0,0,0,,Ер адамның ізімен жүру
Dialogue: 0,0:16:26.73,0:16:30.28,Default,,0,0,0,,Біз тергеу ауқымын кеңейтіп, болашаққа дайындалудамыз.
Dialogue: 0,0:16:30.36,0:16:32.40,Default,,0,0,0,,Қазіргі заманда қайта жаңғырған қылышшы
Dialogue: 0,0:16:32.49,0:16:34.03,Default,,0,0,0,,Мұсашымын деген адам
Dialogue: 0,0:16:34.61,0:16:37.37,Default,,0,0,0,,Біз қайда және не жаққа бара жатырмыз?
Dialogue: 0,0:16:37.45,0:16:40.04,Default,,0,0,0,,Ал ол кім?
Dialogue: 0,0:16:40.70,0:16:41.91,Default,,0,0,0,,Келесі жаңалықтар
Dialogue: 0,0:16:42.00,0:16:43.41,Default,,0,0,0,,(Дыбысты өшіру)
Dialogue: 0,0:16:45.12,0:16:46.29,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:16:47.04,0:16:48.63,Default,,0,0,0,,Бірақ Баки мырза
Dialogue: 0,0:16:48.71,0:16:51.67,Default,,0,0,0,,Әрқайсысы бір-бірімен байланысқан
Dialogue: 0,0:16:52.21,0:16:54.01,Default,,0,0,0,,Мотобу-санның сөзі...
Dialogue: 0,0:16:55.09,0:16:56.34,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:16:56.84,0:16:58.30,Default,,0,0,0,,Өмір сүру деген нені білдіреді?
Dialogue: 0,0:16:58.39,0:17:00.93,Default,,0,0,0,,Біреумен байланыста жұмыс істейді
Dialogue: 0,0:17:01.56,0:17:03.93,Default,,0,0,0,,Екінші жағынан, ол туралы не деуге болады?
Dialogue: 0,0:17:04.02,0:17:06.44,Default,,0,0,0,,Мен мұны сен айтқанда ғана түсіндім.
Dialogue: 0,0:17:06.52,0:17:08.81,Default,,0,0,0,,Бұл соншалықты анық Бұл өте айқын
Dialogue: 0,0:17:08.90,0:17:10.44,Default,,0,0,0,,Мусаши-санның жалғыздығы
Dialogue: 0,0:17:11.61,0:17:13.32,Default,,0,0,0,,Көре алмағандай болдым.
Dialogue: 0,0:17:13.90,0:17:17.57,Default,,0,0,0,,Дүниесіз екі көз мені иығымнан қағып жіберді.
Dialogue: 0,0:17:18.20,0:17:21.62,Default,,0,0,0,,Сіз ол адаммен араласудан бас тартқан сияқтысыз.
Dialogue: 0,0:17:21.70,0:17:24.08,Default,,0,0,0,,Бейорганикалық көзқарасыңа таң қалды
Dialogue: 0,0:17:24.79,0:17:24.96,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:17:24.96,0:17:27.79,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:17:24.96,0:17:27.79,Default,,0,0,0,,Сол жалғыздық мені соқыр етті.
Dialogue: 0,0:17:27.79,0:17:29.59,Default,,0,0,0,,Сол жалғыздық мені соқыр етті.
Dialogue: 0,0:17:30.17,0:17:34.17,Default,,0,0,0,,Менің көзім сол басқа өлшемдегі әскери күшке ауды.
Dialogue: 0,0:17:34.26,0:17:37.34,Default,,0,0,0,,Оның қорықпайтын түрі көз алдымда.
Dialogue: 0,0:17:38.39,0:17:40.51,Default,,0,0,0,,Мен тіпті қарауға тырыспаған сияқтымын.
Dialogue: 0,0:17:41.51,0:17:43.56,Default,,0,0,0,,Сол жалғыздық
Dialogue: 0,0:17:44.93,0:17:45.93,Default,,0,0,0,,Ессіздік...
Dialogue: 0,0:17:47.48,0:17:48.69,Default,,0,0,0,,Осы дүниеде дүниеге келген
Dialogue: 0,0:17:49.19,0:17:51.11,Default,,0,0,0,,Осы дүниеден нәр алған
Dialogue: 0,0:17:51.19,0:17:53.23,Default,,0,0,0,,Бұл дүниеде өмір сүре берсек те,
Dialogue: 0,0:17:53.73,0:17:55.11,Default,,0,0,0,,Жалғыздық бар
Dialogue: 0,0:17:55.19,0:17:57.57,Default,,0,0,0,,Отбасы туыстары
Dialogue: 0,0:17:57.65,0:17:59.70,Default,,0,0,0,,ғашық дос
Dialogue: 0,0:18:00.24,0:18:03.62,Default,,0,0,0,,Менің жүрегім кешіретін ешкім жоқ басқа өлшемге барады.
Dialogue: 0,0:18:04.45,0:18:07.08,Default,,0,0,0,,400 жыл бұрынғы Сенгоку дәуірінен
Dialogue: 0,0:18:07.16,0:18:08.62,Default,,0,0,0,,Кенеттен қазіргі заман
Dialogue: 0,0:18:08.71,0:18:10.88,Default,,0,0,0,,Қарапайым айтқанда, бұл бір адамның магниттік күшінің екі есесі.
Dialogue: 0,0:18:10.96,0:18:12.96,Default,,0,0,0,,Сіз қаншалықты жалғызсыз?
Dialogue: 0,0:18:21.72,0:18:23.35,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:18:23.43,0:18:24.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:35.48,0:18:36.90,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:18:38.61,0:18:40.36,Default,,0,0,0,,Мен сені қоршадым
Dialogue: 0,0:18:40.45,0:18:42.91,Default,,0,0,0,,100 адамнан тұратын қарулы топ.
Dialogue: 0,0:18:42.99,0:18:44.70,Default,,0,0,0,,100 адам соңғы құрал-жабдықтармен жабдықталған
Dialogue: 0,0:18:44.79,0:18:49.41,Default,,0,0,0,,Тіпті Миямото Мусаши қолмен ұстап тұрып жеңе алмайды.
Dialogue: 0,0:18:51.25,0:18:53.79,Default,,0,0,0,,Ол тактик болған.
Dialogue: 0,0:18:53.88,0:18:56.55,Default,,0,0,0,,Ақылмен әрекет ет
Dialogue: 0,0:18:58.72,0:19:00.55,Default,,0,0,0,,Арқанға айнал
Dialogue: 0,0:19:02.93,0:19:05.56,Default,,0,0,0,,- (Мусаши) Мен саған айттым деп ойладым - (Оцука) А?
Dialogue: 0,0:19:06.31,0:19:07.89,Default,,0,0,0,,Оны түсіріңіз
Dialogue: 0,0:19:10.39,0:19:13.06,Default,,0,0,0,,Тарихтағы ең мықты қылышшы
Dialogue: 0,0:19:13.15,0:19:15.15,Default,,0,0,0,,Миямото Мусаши
Dialogue: 0,0:19:16.19,0:19:17.90,Default,,0,0,0,,Мен сізді төмендетпеймін
Dialogue: 0,0:19:17.99,0:19:21.57,Default,,0,0,0,,Бұл өз күшін толық білетін ескерту.
Dialogue: 0,0:19:21.66,0:19:22.95,Default,,0,0,0,,Берілмеу
Dialogue: 0,0:19:28.29,0:19:29.79,Default,,0,0,0,,орындалуы керек
Dialogue: 0,0:19:37.80,0:19:40.30,Default,,0,0,0,,О, келіңдер...
Dialogue: 0,0:19:40.80,0:19:41.93,Default,,0,0,0,,Ммм
Dialogue: 0,0:19:42.80,0:19:45.35,Default,,0,0,0,,Мен көптен бері үлкен ойнап жүрсем де
Dialogue: 0,0:19:45.43,0:19:47.72,Default,,0,0,0,,Бұл сергітеді.
Dialogue: 0,0:19:47.81,0:19:49.85,Default,,0,0,0,,Бірақ бұл жұмыс істейді.
Dialogue: 0,0:19:49.93,0:19:51.48,Default,,0,0,0,,Каккаккака
Dialogue: 0,0:19:53.56,0:19:55.98,Default,,0,0,0,,Қылышыңды жерге тигізбе
Dialogue: 0,0:19:58.57,0:19:59.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:00.15,0:20:02.74,Default,,0,0,0,,Мен сенің атыңды сұрамадым.
Dialogue: 0,0:20:06.58,0:20:09.37,Default,,0,0,0,,Марухи, өзін Миямото Мусаши деп атайды
Dialogue: 0,0:20:09.45,0:20:12.58,Default,,0,0,0,,Марухиге дейінгі қашықтық: шамамен 30 метр
Dialogue: 0,0:20:13.08,0:20:16.63,Default,,0,0,0,,Бір-біріне өте жақын болғандықтан нұсқаулар сыбырлап беріледі.
Dialogue: 0,0:20:16.71,0:20:18.38,Default,,0,0,0,,Құлағын ашып тыңда
Dialogue: 0,0:20:20.21,0:20:23.68,Default,,0,0,0,,Қазіргі уақытта инспектор Оцука Марухимен байланыста
Dialogue: 0,0:20:23.76,0:20:24.76,Default,,0,0,0,,Сигнал болған бойда...
Dialogue: 0,0:20:24.84,0:20:26.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:28.85,0:20:29.77,Default,,0,0,0,,Алдыңғы!
Dialogue: 0,0:20:33.73,0:20:34.77,Default,,0,0,0,,Ах
Dialogue: 0,0:20:37.61,0:20:38.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:44.28,0:20:45.11,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:46.62,0:20:47.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:49.87,0:20:52.66,Default,,0,0,0,,- (Ивама) Бұл... - (Мусаши) Бұл Отсуканың қысқа түтігі.
Dialogue: 0,0:20:52.75,0:20:54.04,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:20:55.87,0:20:58.50,Default,,0,0,0,,Жарыс қалыпты өтті.
Dialogue: 0,0:20:58.59,0:21:02.05,Default,,0,0,0,,Оцука бірінші болып өтті, бірақ оны тұзбен алайық.
Dialogue: 0,0:21:05.72,0:21:07.80,Default,,0,0,0,,Мен дәл қазір Реиичи-куннан
Dialogue: 0,0:21:07.89,0:21:09.30,Default,,0,0,0,,(Иваманың дірілдеген тынысы)
Dialogue: 0,0:21:09.39,0:21:12.81,Default,,0,0,0,,(Официант) Ж… Жоқ, мырза. Бұл «Неро» деп аталады➡
Dialogue: 0,0:21:12.89,0:21:15.19,Default,,0,0,0,,Маған қарсы шықты, сондықтан мен оны өлтірдім.
Dialogue: 0,0:21:15.69,0:21:17.81,Default,,0,0,0,,Ештеңе артық, кем емес
Dialogue: 0,0:21:18.44,0:21:19.56,Default,,0,0,0,,Қазір...
Dialogue: 0,0:21:19.65,0:21:22.15,Default,,0,0,0,,Менің берілу немесе бағыну ниетім жоқ.
Dialogue: 0,0:21:22.23,0:21:23.07,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:24.44,0:21:26.36,Default,,0,0,0,,Мұндай Мусаши
Dialogue: 0,0:21:26.45,0:21:28.74,Default,,0,0,0,,(Кондуктор) Сен, сол жерде тұр! Ей! Қауіпті!
Dialogue: 0,0:21:30.70,0:21:32.70,Default,,0,0,0,,♪～
Dialogue: 0,0:22:57.00,0:22:58.96,Default,,0,0,0,,～♪
Dialogue: 0,0:23:00.46,0:23:06.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory