Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.51,0:00:13.51,Default,,0,0,0,,♪～
Dialogue: 0,0:01:37.13,0:01:39.14,Default,,0,0,0,,～♪
Dialogue: 0,0:01:44.72,0:01:46.18,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:01:46.73,0:01:48.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:48.23,0:01:49.23,Default,,0,0,0,,Не?
Dialogue: 0,0:01:52.23,0:01:55.49,Default,,0,0,0,,Нөлге жуық қашықтықтан қиғаш сызық
Dialogue: 0,0:01:55.57,0:01:58.78,Default,,0,0,0,,Сонда да мені осы қашықтықта өлтірер ме едің...
Dialogue: 0,0:01:58.86,0:02:01.53,Default,,0,0,0,,Бала сезінді
Dialogue: 0,0:02:01.62,0:02:02.91,Default,,0,0,0,,Кесілген!
Dialogue: 0,0:02:02.99,0:02:04.79,Default,,0,0,0,,Физикалық түрде кесілмеген
Dialogue: 0,0:02:05.87,0:02:08.79,Default,,0,0,0,,Іс жүзінде қылышпен кесілмеген
Dialogue: 0,0:02:09.67,0:02:10.79,Default,,0,0,0,,Бірақ сіз қалай ойлайсыз?
Dialogue: 0,0:02:10.88,0:02:12.54,Default,,0,0,0,,Бұл...
Dialogue: 0,0:02:12.63,0:02:14.80,Default,,0,0,0,,Ол жұмыс істейді...
Dialogue: 0,0:02:14.88,0:02:17.47,Default,,0,0,0,,Қанша күрессең де, қарсы тұра алмайсың.
Dialogue: 0,0:02:17.55,0:02:20.14,Default,,0,0,0,,Абсолюттік сезім «шайқалып кетті!»
Dialogue: 0,0:02:20.22,0:02:21.55,Default,,0,0,0,,Мен оны жоққа шығарсам да
Dialogue: 0,0:02:22.35,0:02:24.56,Default,,0,0,0,,Дене оны мойындады.
Dialogue: 0,0:02:24.64,0:02:27.43,Default,,0,0,0,,Маған да ұнайды
Dialogue: 0,0:02:28.52,0:02:29.94,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:02:30.52,0:02:31.94,Default,,0,0,0,,Уф
Dialogue: 0,0:02:32.02,0:02:33.82,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:02:35.40,0:02:36.82,Default,,0,0,0,,Мен көп нәрсені білдім.
Dialogue: 0,0:02:38.90,0:02:40.11,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:44.12,0:02:44.95,Default,,0,0,0,,А...
Dialogue: 0,0:02:50.17,0:02:51.58,Default,,0,0,0,,Мунцу
Dialogue: 0,0:02:56.05,0:02:56.92,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:02:59.80,0:03:01.22,Default,,0,0,0,,Шешу?
Dialogue: 0,0:03:01.30,0:03:02.97,Default,,0,0,0,,Бұл ұрыс
Dialogue: 0,0:03:03.05,0:03:04.60,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:05.18,0:03:08.27,Default,,0,0,0,,Бұл мен де көрмеген жаңа жәшік.
Dialogue: 0,0:03:08.35,0:03:12.35,Default,,0,0,0,,Миямото Мусаши соғыс орнында бүгінгі күнге дейін жеткен
Dialogue: 0,0:03:13.19,0:03:15.36,Default,,0,0,0,,Жай ғана кесіп, байлау мүмкін емес
Dialogue: 0,0:03:15.44,0:03:18.61,Default,,0,0,0,,кесу, шаншу, шаншу
Dialogue: 0,0:03:18.69,0:03:20.86,Default,,0,0,0,,Қысып тастау
Dialogue: 0,0:03:21.49,0:03:23.87,Default,,0,0,0,,Жалаң қол Мұсашы мықты емес
Dialogue: 0,0:03:23.95,0:03:26.12,Default,,0,0,0,,Мұндай кереметті күтуге болмайды.
Dialogue: 0,0:03:27.20,0:03:30.37,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:03:37.71,0:03:40.72,Default,,0,0,0,,Естен 0,5 секунд бұрын болады дейді.
Dialogue: 0,0:03:40.80,0:03:42.13,Default,,0,0,0,,Ми сигналдары
Dialogue: 0,0:03:43.34,0:03:46.39,Default,,0,0,0,,Адам есін жиғанша 0,5 секундқа түсіріңіз
Dialogue: 0,0:03:48.22,0:03:51.64,Default,,0,0,0,,Оқиғаның басын басу үшін шебер шайқас
Dialogue: 0,0:03:56.73,0:03:57.73,Default,,0,0,0,,(Жерді тепкен дыбыс)
Dialogue: 0,0:04:07.24,0:04:08.45,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,0:04:08.99,0:04:09.83,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:04:10.62,0:04:13.16,Default,,0,0,0,,Уау... Мен таратып жібердім.
Dialogue: 0,0:04:17.50,0:04:19.46,Default,,0,0,0,,Менің сыныптастарымның бірі
Dialogue: 0,0:04:19.55,0:04:21.55,Default,,0,0,0,,Мен көңіл көтеру үшін орындықты тартып алдым.
Dialogue: 0,0:04:21.63,0:04:23.38,Default,,0,0,0,,- (Ер оқушы) Әй! -(Кубой) Мен қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:04:23.47,0:04:24.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:26.76,0:04:29.31,Default,,0,0,0,,Иә, енді түсіндім.
Dialogue: 0,0:04:30.14,0:04:31.72,Default,,0,0,0,,Иә? сурет?
Dialogue: 0,0:04:31.81,0:04:34.31,Default,,0,0,0,,Бұл жігіт міндетті түрде жаттығады.
Dialogue: 0,0:04:36.15,0:04:38.94,Default,,0,0,0,,Жоқ, мен оны дауыстап айтпаймын.
Dialogue: 0,0:04:39.02,0:04:40.86,Default,,0,0,0,,Мүлдем солай.
Dialogue: 0,0:04:40.94,0:04:42.53,Default,,0,0,0,,Мен мұны бұрын да байқағанмын.
Dialogue: 0,0:04:42.61,0:04:44.07,Default,,0,0,0,,Атлетикалық клуб ойыншыларынан және т.б.
Dialogue: 0,0:04:44.15,0:04:46.32,Default,,0,0,0,,Баки шын мәнінде күштірек.
Dialogue: 0,0:04:46.41,0:04:48.03,Default,,0,0,0,,Мүлдем күшті
Dialogue: 0,0:04:50.54,0:04:52.16,Default,,0,0,0,,Шынымен мықты бол!
Dialogue: 0,0:04:52.25,0:04:53.54,Default,,0,0,0,,Бұл мүмкін емес!
Dialogue: 0,0:04:53.62,0:04:55.12,Default,,0,0,0,,Әртүрлі өлшемдер
Dialogue: 0,0:04:55.71,0:04:58.75,Default,,0,0,0,,Бұл таңқаларлық емес, сен сол жемді тістейсің бе?
Dialogue: 0,0:04:58.84,0:05:01.84,Default,,0,0,0,,Сана алдында шығарылатын ми сигналдары
Dialogue: 0,0:05:02.34,0:05:05.34,Default,,0,0,0,,Адамның өзінен бұрын бейсаналықты сезіну
Dialogue: 0,0:05:05.43,0:05:09.72,Default,,0,0,0,,Адам әрекет етуді шешкен кезде, ол қазірдің өзінде қисық сызықтан озып кетті.
Dialogue: 0,0:05:09.80,0:05:13.77,Default,,0,0,0,,Дебананың Дебанасын өте жоғары өлшемнен тыс бағындыру
Dialogue: 0,0:05:13.85,0:05:15.89,Default,,0,0,0,,Оған дейін әйтеуір...
Dialogue: 0,0:05:15.98,0:05:18.10,Default,,0,0,0,,Әйтеуір менің түсінігім жетті, бірақ
Dialogue: 0,0:05:18.19,0:05:20.27,Default,,0,0,0,,Мұсашидің көрсеткені болашақ еді
Dialogue: 0,0:05:20.36,0:05:22.19,Default,,0,0,0,,Ми сигналдарын жем ретінде пайдалану —
Dialogue: 0,0:05:22.28,0:05:23.53,Default,,0,0,0,,Есептегіш
Dialogue: 0,0:05:24.11,0:05:26.15,Default,,0,0,0,,Егер сіз оны ұстасаңыз, ол бірден реттеледі
Dialogue: 0,0:05:26.24,0:05:29.03,Default,,0,0,0,,Жеңіліс өлімді білдіретін уақыт
Dialogue: 0,0:05:29.70,0:05:31.62,Default,,0,0,0,,Талантты адамдар арасындағы кездесу
Dialogue: 0,0:05:31.70,0:05:36.04,Default,,0,0,0,,Бірін-бірі осылайша оқу табиғи тәжірибе болды деп ойлаймын.
Dialogue: 0,0:05:36.12,0:05:37.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:38.42,0:05:40.54,Default,,0,0,0,,Мен жеңе алмаймын.
Dialogue: 0,0:05:41.71,0:05:43.13,Default,,0,0,0,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:05:43.63,0:05:44.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:44.63,0:05:49.05,Default,,0,0,0,,Қазіргі заманғы жекпе-жек өнері әлі де ізденетін соғыс құдайы
Dialogue: 0,0:05:49.14,0:05:51.68,Default,,0,0,0,,Нағыз Миямото Мусашиге шағымдану
Dialogue: 0,0:05:52.35,0:05:56.68,Default,,0,0,0,,Қазіргі заманғы жекпе-жек шедеврі Сіз осында бересіз бе?
Dialogue: 0,0:05:59.40,0:06:03.07,Default,,0,0,0,,Мотобу Изо Мусашимен кездескен күні таңертең ерте
Dialogue: 0,0:06:03.15,0:06:04.28,Default,,0,0,0,,Мотобу резиденциясы
Dialogue: 0,0:06:04.78,0:06:08.45,Default,,0,0,0,,Күнделікті жаттығу көлемі туралы сұрағанда
Dialogue: 0,0:06:08.53,0:06:11.70,Default,,0,0,0,,Бейбақ, керемет желі
Dialogue: 0,0:06:12.45,0:06:15.95,Default,,0,0,0,,Менің санам күніне бірнеше рет жекпе-жектен алшақтайды.
Dialogue: 0,0:06:16.04,0:06:18.04,Default,,0,0,0,,Джожу зава
Dialogue: 0,0:06:18.12,0:06:20.71,Default,,0,0,0,,Күні бойы Такеши туралы ойлау
Dialogue: 0,0:06:20.79,0:06:22.59,Default,,0,0,0,,Бұл Шибукава Гоуки
Dialogue: 0,0:06:22.67,0:06:25.34,Default,,0,0,0,,Сіздің жекпе-жек өнеріне деген сүйіспеншілігіңіз соншама?
Dialogue: 0,0:06:25.42,0:06:27.84,Default,,0,0,0,,Менің шеберім Микошиба ше?
Dialogue: 0,0:06:27.92,0:06:30.84,Default,,0,0,0,,Айкидің негізін қалаушы Сокаку Такеда ше?
Dialogue: 0,0:06:31.47,0:06:32.60,Default,,0,0,0,,Бас кеңсе.
Dialogue: 0,0:06:32.68,0:06:35.72,Default,,0,0,0,,Мұны саған кім үйретті?
Dialogue: 0,0:06:35.81,0:06:36.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:37.73,0:06:40.94,Default,,0,0,0,,Жаяу жүргендей жауынгер бол.
Dialogue: 0,0:06:41.02,0:06:44.48,Default,,0,0,0,,Мен өмірімді осы оймен өткізуге тырыстым, бірақ...
Dialogue: 0,0:06:45.15,0:06:45.98,Default,,0,0,0,,Не?
Dialogue: 0,0:06:46.57,0:06:49.82,Default,,0,0,0,,Менің оқуға деген көзқарасымды белгілі бір адам жоққа шығарды.
Dialogue: 0,0:06:50.82,0:06:53.57,Default,,0,0,0,,Сіз мен жақсы білетін адамсыз.
Dialogue: 0,0:06:55.66,0:06:57.37,Default,,0,0,0,,Бұл Баки Ханма.
Dialogue: 0,0:06:58.04,0:06:58.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:58.96,0:07:01.87,Default,,0,0,0,,Бұл Джоджу Зага
Dialogue: 0,0:07:02.46,0:07:04.84,Default,,0,0,0,,Еңбек ету, шыдамдылық
Dialogue: 0,0:07:04.92,0:07:07.26,Default,,0,0,0,,Күнделікті өмірде бәрі ойын
Dialogue: 0,0:07:07.34,0:07:10.51,Default,,0,0,0,,Бұтада бір күн -
Dialogue: 0,0:07:11.26,0:07:12.26,Default,,0,0,0,,Ойнау
Dialogue: 0,0:07:13.05,0:07:15.01,Default,,0,0,0,,Мен мұндай жағдайға шыдай алмаймын.
Dialogue: 0,0:07:15.89,0:07:20.02,Default,,0,0,0,,Бір талпыныс жасаған адам одан ләззат алатын адамды жеңе алмайды.
Dialogue: 0,0:07:21.85,0:07:26.52,Default,,0,0,0,,Бон, сен мына Мұсашыға қылышты қандай еліктеп бересің?
Dialogue: 0,0:07:30.70,0:07:32.28,Default,,0,0,0,,Бұл сіздің көшірмеңіз.
Dialogue: 0,0:07:32.36,0:07:34.41,Default,,0,0,0,,Манет не істеу керек
Dialogue: 0,0:07:34.99,0:07:36.91,Default,,0,0,0,,Өйткені бұл сіздің доменіңіз.
Dialogue: 0,0:07:39.00,0:07:41.91,Default,,0,0,0,,Мен қылышсыз талай рет шауылдым
Dialogue: 0,0:07:42.50,0:07:46.17,Default,,0,0,0,,Тіпті денесін шығармай сойғаным үшін өзімді жаман сезінемін.
Dialogue: 0,0:07:46.25,0:07:48.67,Default,,0,0,0,,Хо... сою?
Dialogue: 0,0:07:48.75,0:07:50.17,Default,,0,0,0,,Сою
Dialogue: 0,0:07:50.67,0:07:53.18,Default,,0,0,0,,Сен бұған сенімдісің бе, Бон?
Dialogue: 0,0:07:53.76,0:07:55.43,Default,,0,0,0,,Кім кім?
Dialogue: 0,0:07:55.51,0:07:59.18,Default,,0,0,0,,Мен сендермен қоштасайық деген ниетпен келдім.
Dialogue: 0,0:07:59.27,0:08:03.19,Default,,0,0,0,,Бұл орындалады, бірақ қалғаны Бон емес.
Dialogue: 0,0:08:04.27,0:08:07.02,Default,,0,0,0,,Осы елді қалдырып, кесіп таста.
Dialogue: 0,0:08:07.11,0:08:09.36,Default,,0,0,0,,Кесу, кесу, кесу
Dialogue: 0,0:08:09.44,0:08:11.94,Default,,0,0,0,,Бұл елге жоғарыдан қарап!
Dialogue: 0,0:08:12.57,0:08:13.70,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:08:14.61,0:08:16.45,Default,,0,0,0,,Қиып өрмелейтін ел емес.
Dialogue: 0,0:08:17.66,0:08:20.45,Default,,0,0,0,,Мен мұны әлдеқашан түсіндім.
Dialogue: 0,0:08:21.62,0:08:24.46,Default,,0,0,0,,Мусаши-сан, бұл жерде болмауың керек.
Dialogue: 0,0:08:26.04,0:08:27.88,Default,,0,0,0,,Сол тұтқа...
Dialogue: 0,0:08:27.96,0:08:29.71,Default,,0,0,0,,Мусашиді қалай ұстау керек
Dialogue: 0,0:08:34.30,0:08:35.76,Default,,0,0,0,,- (Көрермендер) Лақтырасың ба? - (Көрермендер) Жақын қалды!
Dialogue: 0,0:08:35.84,0:08:36.97,Default,,0,0,0,,Тым жақын!
Dialogue: 0,0:08:39.06,0:08:40.60,Default,,0,0,0,,Уау! қолмен ұсталды
Dialogue: 0,0:08:40.68,0:08:41.72,Default,,0,0,0,,Ә… Мен келдім бе…
Dialogue: 0,0:08:41.81,0:08:44.35,Default,,0,0,0,,Мусаши-сан, мен саған сендім.
Dialogue: 0,0:08:44.94,0:08:46.60,Default,,0,0,0,,Егер сіз болсаңыз, оны тоқтататыныңызға сенімдімін.
Dialogue: 0,0:08:46.69,0:08:47.61,Default,,0,0,0,,Нәтижелер…
Dialogue: 0,0:08:47.69,0:08:49.19,Default,,0,0,0,,Қатынасты үзу ме? Қатынасты үзу... Хе-хе-хе-хе.
Dialogue: 0,0:08:49.27,0:08:51.11,Default,,0,0,0,,Екі қол да бос!
Dialogue: 0,0:08:56.70,0:08:59.12,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:59.70,0:09:00.74,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:09:02.45,0:09:04.08,Default,,0,0,0,,Қазір
Dialogue: 0,0:09:08.42,0:09:11.00,Default,,0,0,0,,Бала салыстырып отырды
Dialogue: 0,0:09:11.96,0:09:14.01,Default,,0,0,0,,Қазіргі заманғы жекпе-жек матчтары
Dialogue: 0,0:09:14.51,0:09:16.47,Default,,0,0,0,,Қалағаныңызша қайталауға болады
Dialogue: 0,0:09:17.13,0:09:19.64,Default,,0,0,0,,Екінші жағынан, самурай әлемінің ойындары
Dialogue: 0,0:09:20.14,0:09:21.51,Default,,0,0,0,,Өз өміріңізге қауіп төндіріңіз
Dialogue: 0,0:09:22.35,0:09:24.48,Default,,0,0,0,,Бұған ешқандай күмән жоқ.
Dialogue: 0,0:09:25.35,0:09:28.56,Default,,0,0,0,,Бәсекелестіктің ауырлығы жағынан салыстыруға болмайды.
Dialogue: 0,0:09:29.48,0:09:31.52,Default,,0,0,0,,Өз өміріңізді қатерге тігуге сәйкес келмейді
Dialogue: 0,0:09:32.23,0:09:33.07,Default,,0,0,0,,Жарыс қаншада басталады?
Dialogue: 0,0:09:33.15,0:09:36.15,Default,,0,0,0,,Бірақ... сонда ше?
Dialogue: 0,0:09:38.28,0:09:41.53,Default,,0,0,0,,Соғу техникасы бойынша 10 секундқа нокаут
Dialogue: 0,0:09:42.12,0:09:44.54,Default,,0,0,0,,Бірлескен техника бойынша шерту
Dialogue: 0,0:09:45.33,0:09:47.54,Default,,0,0,0,,Тұншығуға байланысты өшіп қалды
Dialogue: 0,0:09:48.25,0:09:49.54,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:09:50.38,0:09:51.84,Default,,0,0,0,,Кез келген есеп айырысу
Dialogue: 0,0:09:51.92,0:09:54.80,Default,,0,0,0,,Жеңімпаздың қолында өмір немесе өлім бар.
Dialogue: 0,0:09:55.97,0:09:57.43,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:09:58.13,0:10:00.93,Default,,0,0,0,,Бұл өмір үшін күрес емес, бірақ—
Dialogue: 0,0:10:01.51,0:10:04.72,Default,,0,0,0,,Қазіргі жауынгерлік өнер кез келген нәрсені өлтіруі мүмкін
Dialogue: 0,0:10:05.47,0:10:06.93,Default,,0,0,0,,Қазір
Dialogue: 0,0:10:08.77,0:10:10.52,Default,,0,0,0,,Иә, Заку!
Dialogue: 0,0:10:13.52,0:10:15.48,Default,,0,0,0,,О!
Dialogue: 0,0:10:17.28,0:10:18.20,Default,,0,0,0,,Мұсаши мырза
Dialogue: 0,0:10:19.16,0:10:20.45,Default,,0,0,0,,Оны рұқсатсыз осы жерге әкелген сіздерсіздер!
Dialogue: 0,0:10:28.62,0:10:29.96,Default,,0,0,0,,Екі қолмен
Dialogue: 0,0:10:30.75,0:10:32.46,Default,,0,0,0,,Қылыш қалды ма?
Dialogue: 0,0:10:35.71,0:10:39.09,Default,,0,0,0,,Сіз жинаған нәрсе артыңызда қалдырған нәрсе ме?
Dialogue: 0,0:10:39.72,0:10:42.35,Default,,0,0,0,,Қолымда ұстасам, Жыртылып кетем.
Dialogue: 0,0:10:43.26,0:10:45.60,Default,,0,0,0,,Мен тіпті кішіпейіл болдым.
Dialogue: 0,0:10:46.93,0:10:48.35,Default,,0,0,0,,Бұдан, Мұсаши мырза
Dialogue: 0,0:10:49.94,0:10:51.48,Default,,0,0,0,,Мен сені жерлеуім керек
Dialogue: 0,0:10:52.27,0:10:53.23,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:10:53.81,0:10:56.57,Default,,0,0,0,,Жерлеу? Мен?
Dialogue: 0,0:10:56.65,0:10:58.24,Default,,0,0,0,,Сол қылышпен бе?
Dialogue: 0,0:10:58.90,0:11:00.24,Default,,0,0,0,,Мүмкін оның мақсаты – Эренді жеп қою.
Dialogue: 0,0:11:04.24,0:11:06.49,Default,,0,0,0,,Мен қылыш қолдана алмаймын деп ойлайсың ба?
Dialogue: 0,0:11:12.50,0:11:13.58,Default,,0,0,0,,(өткір жел шуы)
Dialogue: 0,0:11:14.34,0:11:15.75,Default,,0,0,0,,Ой!
Dialogue: 0,0:11:16.84,0:11:18.01,Default,,0,0,0,,(өткір жел шуы)
Dialogue: 0,0:11:24.10,0:11:25.76,Default,,0,0,0,,Мен әуесқой болсам да
Dialogue: 0,0:11:25.85,0:11:29.02,Default,,0,0,0,,Мен пышақ принципін белгілі бір дәрежеде түсіне аламын.
Dialogue: 0,0:11:29.60,0:11:31.52,Default,,0,0,0,,Оны тіпті әуесқой да қиып алады
Dialogue: 0,0:11:32.10,0:11:33.27,Default,,0,0,0,,Қылыш кесіп алады
Dialogue: 0,0:11:33.85,0:11:34.77,Default,,0,0,0,,Сойылған
Dialogue: 0,0:11:34.86,0:11:36.32,Default,,0,0,0,,Мені өлтіргің келе ме?
Dialogue: 0,0:11:37.36,0:11:38.36,Default,,0,0,0,,Изуку Мидория…
Dialogue: 0,0:11:39.36,0:11:41.03,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:11:41.11,0:11:42.28,Default,,0,0,0,,О...
Dialogue: 0,0:11:42.86,0:11:44.78,Default,,0,0,0,,Мен оны талай рет көрдім.
Dialogue: 0,0:11:46.08,0:11:47.54,Default,,0,0,0,,Қылышты жібер
Dialogue: 0,0:11:48.24,0:11:49.66,Default,,0,0,0,,Жындарға арналған металл шыбық
Dialogue: 0,0:11:50.50,0:11:52.42,Default,,0,0,0,,Сенімділіктің мысалы
Dialogue: 0,0:11:53.33,0:11:56.42,Default,,0,0,0,,Біріншіден, жындар мен канабо әртүрлі заттар.
Dialogue: 0,0:11:57.00,0:11:58.71,Default,,0,0,0,,Біз бірге жүре алмаймыз
Dialogue: 0,0:12:01.01,0:12:02.80,Default,,0,0,0,,Ешқашан кетпейтін қылыш
Dialogue: 0,0:12:03.97,0:12:06.05,Default,,0,0,0,,Мен кетпейтін қылыш қалаймын
Dialogue: 0,0:12:08.14,0:12:12.06,Default,,0,0,0,,Жалғыздыққа шыдаймын, бірақ қылышпен қоштасу мұңды.
Dialogue: 0,0:12:16.06,0:12:17.40,Default,,0,0,0,,Қылыш жоқ
Dialogue: 0,0:12:19.90,0:12:21.07,Default,,0,0,0,,Жалаңаш дүкен
Dialogue: 0,0:12:21.69,0:12:24.95,Default,,0,0,0,,Баяғыда бәріңіздің қолдарыңызда болған нәрсе.
Dialogue: 0,0:12:26.37,0:12:28.95,Default,,0,0,0,,Бес денені қаруға айналдыратын шебер.
Dialogue: 0,0:12:31.79,0:12:33.71,Default,,0,0,0,,Бес дене бөлінбейді
Dialogue: 0,0:12:35.04,0:12:38.21,Default,,0,0,0,,Қылыш жолы, қылышсыз жол
Dialogue: 0,0:12:39.00,0:12:40.34,Default,,0,0,0,,Соңында
Dialogue: 0,0:12:41.38,0:12:44.34,Default,,0,0,0,,Мен оның қандай құрал екенін де білмеймін...
Dialogue: 0,0:12:45.05,0:12:45.89,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:48.47,0:12:50.77,Default,,0,0,0,,Осы жолмен жүріңіз
Dialogue: 0,0:12:51.43,0:12:52.48,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:52.98,0:12:55.44,Default,,0,0,0,,Мм... Кешіріңіз.
Dialogue: 0,0:12:56.44,0:13:00.23,Default,,0,0,0,,Мен жарты жолда қалдым, бірақ бұл өте нашар.
Dialogue: 0,0:13:00.32,0:13:03.49,Default,,0,0,0,,Сіз мұны... сонда істей аласыз ба?
Dialogue: 0,0:13:04.32,0:13:05.49,Default,,0,0,0,,Онда ма?
Dialogue: 0,0:13:05.57,0:13:09.41,Default,,0,0,0,,Мұсаши мырза бұрын болған.
Dialogue: 0,0:13:09.49,0:13:10.99,Default,,0,0,0,,Ол қалқыған ба...
Dialogue: 0,0:13:11.58,0:13:14.00,Default,,0,0,0,,Мұнда емес, ана жақта
Dialogue: 0,0:13:16.17,0:13:17.25,Default,,0,0,0,,...Сондықтан
Dialogue: 0,0:13:19.50,0:13:20.38,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:22.96,0:13:23.88,Default,,0,0,0,,Хамф!
Dialogue: 0,0:13:23.96,0:13:25.22,Default,,0,0,0,,(жоғары металл дыбысы)
Dialogue: 0,0:13:33.22,0:13:35.06,Default,,0,0,0,,Мұны істеу оңай
Dialogue: 0,0:13:35.14,0:13:36.89,Default,,0,0,0,,Мені ұстайтыныңызға сенімдімін.
Dialogue: 0,0:13:38.15,0:13:38.98,Default,,0,0,0,,Мм...!
Dialogue: 0,0:13:40.65,0:13:41.94,Default,,0,0,0,,Хмм!
Dialogue: 0,0:13:50.20,0:13:52.37,Default,,0,0,0,,(сорғыш дыбыс)
Dialogue: 0,0:13:54.45,0:13:56.75,Default,,0,0,0,,Хмм... хааа
Dialogue: 0,0:14:03.09,0:14:05.09,Default,,0,0,0,,Харагьятей Харасо Гятей
Dialogue: 0,0:14:05.09,0:14:06.26,Default,,0,0,0,,Харагьятей Харасо Гятей
Dialogue: 0,0:14:05.09,0:14:06.26,Default,,0,0,0,,- (Кацуми Гучи()) Кім? - (Күзгі жапырақтар) Бұл кім?
Dialogue: 0,0:14:06.26,0:14:06.34,Default,,0,0,0,,- (Кацуми Гучи()) Кім? - (Күзгі жапырақтар) Бұл кім?
Dialogue: 0,0:14:06.34,0:14:07.26,Default,,0,0,0,,- (Кацуми Гучи()) Кім? - (Күзгі жапырақтар) Бұл кім?
Dialogue: 0,0:14:06.34,0:14:07.26,Default,,0,0,0,,Өзіңе құлшылық ет және өзіңді құрбан ет
Dialogue: 0,0:14:07.26,0:14:09.09,Default,,0,0,0,,Өзіңе құлшылық ет және өзіңді құрбан ет
Dialogue: 0,0:14:09.18,0:14:12.01,Default,,0,0,0,,Кашикоми Кашикомиді де айтыңыз.
Dialogue: 0,0:14:12.10,0:14:14.52,Default,,0,0,0,,Миямото Мусашидің жаны...
Dialogue: 0,0:14:12.10,0:14:14.52,Default,,0,0,0,,- (Көрермендер) Кім? -(Көрермендер) Иә?
Dialogue: 0,0:14:14.52,0:14:15.18,Default,,0,0,0,,Миямото Мусашидің жаны...
Dialogue: 0,0:14:15.27,0:14:17.27,Default,,0,0,0,,Маған аспанға қайтуға рұқсат етіңіз
Dialogue: 0,0:14:15.27,0:14:17.27,Default,,0,0,0,,Әже?
Dialogue: 0,0:14:17.27,0:14:17.60,Default,,0,0,0,,Маған аспанға қайтуға рұқсат етіңіз
Dialogue: 0,0:14:17.69,0:14:20.19,Default,,0,0,0,,Қайыр сұрау және тарту
Dialogue: 0,0:14:20.27,0:14:22.31,Default,,0,0,0,,Жақсы жаңалықты тыңда
Dialogue: 0,0:14:22.40,0:14:25.03,Default,,0,0,0,,Жүрегімде мінәжат еткен ұлы тілек
Dialogue: 0,0:14:25.11,0:14:27.53,Default,,0,0,0,,Орындалсын
Dialogue: 0,0:14:27.61,0:14:32.03,Default,,0,0,0,,Кашикоми Кашикоми дейді
Dialogue: 0,0:14:38.62,0:14:40.04,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:14:45.88,0:14:47.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:47.17,0:14:48.22,Default,,0,0,0,,Не?
Dialogue: 0,0:14:54.10,0:14:55.56,Default,,0,0,0,,Өлді ме?
Dialogue: 0,0:14:57.39,0:15:00.77,Default,,0,0,0,,Жеңілген жоқ, өлді ме?
Dialogue: 0,0:15:00.85,0:15:03.56,Default,,0,0,0,,Инфильтрацияланған мүшеден есеп
Dialogue: 0,0:15:04.15,0:15:05.40,Default,,0,0,0,,Әртүрлі заттар бар
Dialogue: 0,0:15:05.48,0:15:09.32,Default,,0,0,0,,Мұсашидің жаны денесінен шықты...
Dialogue: 0,0:15:10.82,0:15:14.33,Default,,0,0,0,,Жан сенсің...
Dialogue: 0,0:15:15.03,0:15:16.99,Default,,0,0,0,,Бұл туралы не істеуім керек?
Dialogue: 0,0:15:17.08,0:15:18.45,Default,,0,0,0,,Бұл 1000 адам
Dialogue: 0,0:15:18.54,0:15:20.33,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:15:20.41,0:15:22.83,Default,,0,0,0,,(шатастырылған дауыс)
Dialogue: 0,0:15:32.68,0:15:34.09,Default,,0,0,0,,Канко-сан
Dialogue: 0,0:15:35.22,0:15:36.47,Default,,0,0,0,,Мәселе үшін кешірім сұраймыз.
Dialogue: 0,0:15:36.97,0:15:40.10,Default,,0,0,0,,Бұл қазір жеткілікті ойластырылған емес.
Dialogue: 0,0:15:40.98,0:15:43.35,Default,,0,0,0,,«Түсіру» Миямото Мусаши
Dialogue: 0,0:15:43.44,0:15:46.40,Default,,0,0,0,,Ол шындыққа айналғанда
Dialogue: 0,0:15:46.48,0:15:48.23,Default,,0,0,0,,Әрқашан болатын нәрселер
Dialogue: 0,0:15:48.32,0:15:50.78,Default,,0,0,0,,Ешқашан болмайтын нәрселер
Dialogue: 0,0:15:50.86,0:15:54.16,Default,,0,0,0,,Сіз екеуін де шамамен елестете алуыңыз керек еді.
Dialogue: 0,0:15:54.24,0:15:56.87,Default,,0,0,0,,Бірақ мен кедергі емеспін
Dialogue: 0,0:15:56.95,0:16:01.87,Default,,0,0,0,,Қауіпті құбыжықты қалаға жібергенде не болады?
Dialogue: 0,0:16:01.96,0:16:06.38,Default,,0,0,0,,Жартысын түсінсем де, қызығымнан бас тарта алмаймын.
Dialogue: 0,0:16:08.46,0:16:12.26,Default,,0,0,0,,Мен де сәтсіз адаммын.
Dialogue: 0,0:16:13.05,0:16:16.26,Default,,0,0,0,,Бұл өлімге лайық іс.
Dialogue: 0,0:16:16.85,0:16:19.52,Default,,0,0,0,,Барлығы шынымен қорқады
Dialogue: 0,0:16:19.60,0:16:20.77,Default,,0,0,0,,Барлығы күтті
Dialogue: 0,0:16:21.77,0:16:23.69,Default,,0,0,0,,Барлығы арандатады
Dialogue: 0,0:16:23.77,0:16:26.77,Default,,0,0,0,,Ал мен оны тексермей тұра алмадым.
Dialogue: 0,0:16:28.02,0:16:29.02,Default,,0,0,0,,Сол қылыштың күші
Dialogue: 0,0:16:29.73,0:16:30.73,Default,,0,0,0,,Айқындық
Dialogue: 0,0:16:31.86,0:16:33.28,Default,,0,0,0,,Толығырақ айтқыңыз келсе...
Dialogue: 0,0:16:34.15,0:16:36.07,Default,,0,0,0,,Тіпті қатыгездік пен адамгершіліксіздік
Dialogue: 0,0:16:37.37,0:16:39.28,Default,,0,0,0,,Біз де сол қылмысқа кінәліміз.
Dialogue: 0,0:16:40.08,0:16:42.58,Default,,0,0,0,,Бұл ел өзін осы ел сияқты ұстайды.
Dialogue: 0,0:16:42.66,0:16:46.04,Default,,0,0,0,,Мұсаши мырзаның Мұсаши мырза сияқты әрекет етуден басқа амалы қалмады.
Dialogue: 0,0:16:53.80,0:16:55.01,Default,,0,0,0,,Барлығы
Dialogue: 0,0:16:55.51,0:16:57.85,Default,,0,0,0,,Бұл саяхат емес.
Dialogue: 0,0:16:57.93,0:17:01.93,Default,,0,0,0,,Ең күшті қылышшы, сирек ағаның кетуі
Dialogue: 0,0:17:02.02,0:17:03.93,Default,,0,0,0,,Қолды біріктіруден гөрі
Dialogue: 0,0:17:04.02,0:17:06.94,Default,,0,0,0,,Сарбаздармен қоштасу
Dialogue: 0,0:17:08.06,0:17:10.90,Default,,0,0,0,,Мен сіздің жағдайға мызғымас көзқараспен қарауыңызды қалаймын.
Dialogue: 0,0:17:18.53,0:17:19.74,Default,,0,0,0,,(Медициналық құрылғылардың электронды дыбыстары)
Dialogue: 0,0:17:19.83,0:17:23.45,Default,,0,0,0,,Импульстік Тыныс алу Қан қысымы Дене температурасы
Dialogue: 0,0:17:24.04,0:17:25.71,Default,,0,0,0,,Барлық қалыпты мәндер
Dialogue: 0,0:17:26.29,0:17:30.09,Default,,0,0,0,,Көріп отырғаныңыздай, ми толқындарының толқын пішіні жоқ.
Dialogue: 0,0:17:30.67,0:17:32.84,Default,,0,0,0,,Мен қайтып келдім
Dialogue: 0,0:17:32.92,0:17:34.55,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:17:34.63,0:17:36.09,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:17:36.68,0:17:39.09,Default,,0,0,0,,Мен сол кезге қайта оралдым.
Dialogue: 0,0:17:39.85,0:17:42.10,Default,,0,0,0,,Амансың ба? Нономура
Dialogue: 0,0:17:42.68,0:17:44.31,Default,,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:17:44.39,0:17:47.06,Default,,0,0,0,,Уақытты осы жерден тоқтатайын.
Dialogue: 0,0:17:56.07,0:17:57.95,Default,,0,0,0,,Бұл қандай сұйықтық?
Dialogue: 0,0:17:58.03,0:17:59.74,Default,,0,0,0,,Сұйық азот
Dialogue: 0,0:18:00.32,0:18:03.24,Default,,0,0,0,,Оны жүз рет минус деп атайды...
Dialogue: 0,0:18:03.33,0:18:07.46,Default,,0,0,0,,Жоқ, қазіргі уақытта біз оны нөлге тең ұстап отырмыз.
Dialogue: 0,0:18:07.54,0:18:11.50,Default,,0,0,0,,Осы жерден бірте-бірте 6 сағат сайын 0,5 градус
Dialogue: 0,0:18:11.59,0:18:15.42,Default,,0,0,0,,Соңғы мән -196 градусқа дейін 6 апта
Dialogue: 0,0:18:15.51,0:18:18.38,Default,,0,0,0,,Біз өте баяу салқындату әдісін қолданамыз.
Dialogue: 0,0:18:18.47,0:18:22.01,Default,,0,0,0,,Мұздату кезінде жасушалар жойылады ма?
Dialogue: 0,0:18:22.10,0:18:27.52,Default,,0,0,0,,Біздің команда бұл мәселені екі жыл бұрын жеңіп шықты.
Dialogue: 0,0:18:28.35,0:18:30.52,Default,,0,0,0,,Ауыз арқылы енгізілген түтік
Dialogue: 0,0:18:30.60,0:18:32.73,Default,,0,0,0,,Мен әлі де хабарландыру жасаудан аулақпын.
Dialogue: 0,0:18:32.82,0:18:35.61,Default,,0,0,0,,Бұл біздің команда жасаған жаңа препарат.
Dialogue: 0,0:18:36.61,0:18:39.82,Default,,0,0,0,,осының минутына 0,9 мг
Dialogue: 0,0:18:39.91,0:18:42.53,Default,,0,0,0,,баяу баяу
Dialogue: 0,0:18:42.62,0:18:43.95,Default,,0,0,0,,Жұту
Dialogue: 0,0:18:44.45,0:18:47.66,Default,,0,0,0,,Қалыпты ас қорыту процесінен кейін 20 л
Dialogue: 0,0:18:47.75,0:18:50.79,Default,,0,0,0,,15 күнде 20000мл қорытыңыз
Dialogue: 0,0:18:51.50,0:18:53.63,Default,,0,0,0,,Сондықтан да кең тараған.
Dialogue: 0,0:18:53.71,0:18:56.05,Default,,0,0,0,,Нанодеңгейдегі ұяшықтың әрбір бұрышы
Dialogue: 0,0:18:56.13,0:18:59.55,Default,,0,0,0,,Мұздамайтын консервант ерітіндісі таратылады.
Dialogue: 0,0:18:59.63,0:19:03.55,Default,,0,0,0,,Басқаша айтқанда, жасушаны жоймайтын сұйықтық...
Dialogue: 0,0:19:03.64,0:19:07.56,Default,,0,0,0,,Біздің команданың ғылымы ешқашан аяқталмайды.
Dialogue: 0,0:19:07.64,0:19:11.06,Default,,0,0,0,,Қанның қатуына қалай жауап бересіз?
Dialogue: 0,0:19:11.15,0:19:13.86,Default,,0,0,0,,Санға қосылған түтік
Dialogue: 0,0:19:13.94,0:19:16.57,Default,,0,0,0,,Қолқа мен қуыс венамен байланысқан
Dialogue: 0,0:19:16.65,0:19:19.15,Default,,0,0,0,,Айналым бірқалыпты жүріп жатыр
Dialogue: 0,0:19:19.65,0:19:21.53,Default,,0,0,0,,77 сағаттан кейін
Dialogue: 0,0:19:21.61,0:19:26.08,Default,,0,0,0,,Аптаның соңына қарай антифриз барлық қан тамырларыңызды толтырады.
Dialogue: 0,0:19:26.16,0:19:27.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:28.29,0:19:30.21,Default,,0,0,0,,Рахмет сізге Нономура-кун
Dialogue: 0,0:19:30.29,0:19:32.21,Default,,0,0,0,,Барша адамның ішінде мен дәл осылай қысылып қалсам…
Dialogue: 0,0:19:34.79,0:19:39.21,Default,,0,0,0,,Мысалы, қазіргі заманда Миямото Мусаши жауапкершілікке тартылуы мүмкін бе?
Dialogue: 0,0:19:39.30,0:19:40.97,Default,,0,0,0,,Сұрау алдында...
Dialogue: 0,0:19:41.05,0:19:43.22,Default,,0,0,0,,Сіз оған қамқорлық жасауыңыз керек!
Dialogue: 0,0:19:43.30,0:19:45.80,Default,,0,0,0,,Өте қымбат нәрсе!
Dialogue: 0,0:19:45.89,0:19:47.68,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:19:48.27,0:19:50.35,Default,,0,0,0,,Мусаши қалады!
Dialogue: 0,0:19:55.77,0:19:57.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:58.78,0:20:02.20,Default,,0,0,0,,Сұйық азотты пайдаланып консервілеу қабылданды.
Dialogue: 0,0:20:02.28,0:20:04.28,Default,,0,0,0,,Сақтау басталған күннен бастап 5-ші күн
Dialogue: 0,0:20:04.36,0:20:07.95,Default,,0,0,0,,Біз оны 24 сағат сайын екі рет төмендетеміз.
Dialogue: 0,0:20:08.54,0:20:11.96,Default,,0,0,0,,5-ші тәулікте сұйықтықтың температурасы -10 градус.
Dialogue: 0,0:20:12.04,0:20:15.29,Default,,0,0,0,,Соңғы мән -196 градусқа жетеді
Dialogue: 0,0:20:15.38,0:20:17.71,Default,,0,0,0,,Шамамен 5 аптадан кейін
Dialogue: 0,0:20:25.34,0:20:27.22,Default,,0,0,0,,Көріп отырғаныңыздай
Dialogue: 0,0:20:27.85,0:20:29.72,Default,,0,0,0,,Мусаши қалды
Dialogue: 0,0:20:29.81,0:20:31.73,Default,,0,0,0,,Бұл сақтау
Dialogue: 0,0:20:32.31,0:20:35.52,Default,,0,0,0,,Күндердің күнінде қайта тірілуді көздей ме?
Dialogue: 0,0:20:35.60,0:20:36.61,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:20:37.19,0:20:39.19,Default,,0,0,0,,Әлде бір нәрсе ме?
Dialogue: 0,0:20:39.86,0:20:42.69,Default,,0,0,0,,Миямото Мусашидің тұрақты сақтау нұсқасы?
Dialogue: 0,0:20:43.65,0:20:46.20,Default,,0,0,0,,Қандай да бір ыңғайсыздық болса, маған көмектесе аласыз ба?
Dialogue: 0,0:20:46.78,0:20:49.45,Default,,0,0,0,,Менің жағдайым туралы айтпа.
Dialogue: 0,0:20:51.79,0:20:53.04,Default,,0,0,0,,Жоқ Джи Чан
Dialogue: 0,0:20:53.54,0:20:56.71,Default,,0,0,0,,Бұдан былай мен бұл адамды өз себептерім үшін пайдаланамын.
Dialogue: 0,0:20:57.54,0:21:00.05,Default,,0,0,0,,Меніңше, оны алып тастау немесе салу керек емес.
Dialogue: 0,0:21:04.26,0:21:05.55,Default,,0,0,0,,Барлығы
Dialogue: 0,0:21:06.05,0:21:09.43,Default,,0,0,0,,Миямото Мусаши тірі ме?
Dialogue: 0,0:21:09.51,0:21:11.52,Default,,0,0,0,,Әрине тірі емес
Dialogue: 0,0:21:11.60,0:21:13.39,Default,,0,0,0,,Сонда ол өлді ме?
Dialogue: 0,0:21:13.48,0:21:14.81,Default,,0,0,0,,Бұл да басқаша.
Dialogue: 0,0:21:14.89,0:21:16.85,Default,,0,0,0,,Мен уақытты тоқтаттым.
Dialogue: 0,0:21:16.94,0:21:20.86,Default,,0,0,0,,Мұнда бар Миямото Мусашидің толық денесі
Dialogue: 0,0:21:20.94,0:21:25.11,Default,,0,0,0,,Сақтықпен кремациялау және жерлеу - еске алу рәсімі ме?
Dialogue: 0,0:21:27.70,0:21:29.87,Default,,0,0,0,,Мақұлдамаймын
Dialogue: 0,0:21:30.45,0:21:34.12,Default,,0,0,0,,Кеткен Мусаши әрқашан қайтып орала алады
Dialogue: 0,0:21:34.20,0:21:37.62,Default,,0,0,0,,Дененің отбасылық үйін сақтауды жалғастырыңыз!
Dialogue: 0,0:21:40.21,0:21:43.67,Default,,0,0,0,,Бұл кететіндерге деген шынайылық.
Dialogue: 0,0:21:43.76,0:21:46.47,Default,,0,0,0,,Табалдырықты енді аттамаса да
Dialogue: 0,0:21:46.55,0:21:48.51,Default,,0,0,0,,Отбасылық үй әлі де бар
Dialogue: 0,0:21:49.68,0:21:53.52,Default,,0,0,0,,Мұны нағыз еске алу кеші деп атауға болмайды ма?
Dialogue: 0,0:22:21.79,0:22:23.80,Default,,0,0,0,,♪～
Dialogue: 0,0:23:48.09,0:23:50.09,Default,,0,0,0,,～♪
Dialogue: 0,0:23:51.59,0:23:57.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory