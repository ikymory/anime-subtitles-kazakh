Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:31.81,0:01:33.48,Default-ja,,0,0,0,,Ахх!
Dialogue: 0,0:01:33.60,0:01:35.15,Default-ja,,0,0,0,,Ах~
Dialogue: 0,0:01:36.79,0:01:37.82,Default,,0,0,0,,Тартыңыз!
Dialogue: 0,0:01:36.81,0:01:37.77,Default-ja,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:01:49.40,0:01:50.67,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:01:49.41,0:01:50.70,Default-ja,,0,0,0,,Асығыңыз! Асығыңыз!
Dialogue: 0,0:01:52.46,0:01:54.08,Default-ja,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:02:08.10,0:02:11.14,Default-ja,,0,0,0,,Жарайды, алыңыз!
Dialogue: 0,0:02:08.22,0:02:11.25,Default,,0,0,0,,Сіздің жазбаларыңызға!
Dialogue: 0,0:02:17.48,0:02:18.82,Default-ja,,0,0,0,,Қауіп
Dialogue: 0,0:02:40.13,0:02:41.55,Default-ja,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:02:52.89,0:02:53.77,Default-ja,,0,0,0,,Ой!
Dialogue: 0,0:02:55.85,0:02:58.31,Default-ja,,0,0,0,,Иә, барлығын бірден итеріңіз!
Dialogue: 0,0:02:55.90,0:02:58.46,Default,,0,0,0,,Жарайды! Жолың алға!
Dialogue: 0,0:02:58.52,0:03:01.52,Default-ja,,0,0,0,,Басын көтерген адамды марапаттаймын!
Dialogue: 0,0:02:58.54,0:03:01.77,Default,,0,0,0,,Маған олардың генералының басын әкелген адам сыйлық алады!
Dialogue: 0,0:03:18.08,0:03:20.63,Default-ja,,0,0,0,,Хехе, бірінші жүр~ (2-солдат) Шүкір, күт!
Dialogue: 0,0:03:18.23,0:03:19.16,Default,,0,0,0,,Не болып жатыр?!
Dialogue: 0,0:03:19.26,0:03:20.19,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:03:23.21,0:03:26.72,Default-ja,,0,0,0,,Ой-ой!
Dialogue: 0,0:03:26.84,0:03:29.93,Default-ja,,0,0,0,,Эй хун
Dialogue: 0,0:03:30.55,0:03:31.55,Default-ja,,0,0,0,,Базусо
Dialogue: 0,0:03:30.67,0:03:31.66,Default,,0,0,0,,Бұл Базусо!
Dialogue: 0,0:03:31.68,0:03:33.72,Default-ja,,0,0,0,,Базусо 30 адамдық шабушы ма?
Dialogue: 0,0:03:31.77,0:03:33.80,Default,,0,0,0,,30 адамды өлтірген адам?!
Dialogue: 0,0:03:33.85,0:03:35.93,Default-ja,,0,0,0,,Аюды жалаң қолмен өлтірген дейді...
Dialogue: 0,0:03:33.88,0:03:35.97,Default,,0,0,0,,Ал аю?!
Dialogue: 0,0:03:36.68,0:03:37.85,Default-ja,,0,0,0,,Не болды?
Dialogue: 0,0:03:36.78,0:03:37.90,Default,,0,0,0,,Ал ше?
Dialogue: 0,0:03:37.98,0:03:41.14,Default,,0,0,0,,Егер сіз басыңызды ұрғыңыз келсе, жоғары көтеріліңіз!
Dialogue: 0,0:03:37.98,0:03:41.19,Default-ja,,0,0,0,,Басыңды жарып алғың келсе, алға шық.
Dialogue: 0,0:03:42.06,0:03:45.69,Default-ja,,0,0,0,,Сіз не істеп жатырсыз? Оны жеңіп, атын шығар.
Dialogue: 0,0:03:42.25,0:03:43.48,Default,,0,0,0,,Мұның бәрі тек менің алаңдаған жүрегімді жылдамдатты
Dialogue: 0,0:03:43.52,0:03:46.15,Default,,0,0,0,,Оны жеңіп, атақты боласың!
Dialogue: 0,0:03:46.03,0:03:47.24,Default-ja,,0,0,0,,Барыңыз
Dialogue: 0,0:03:46.19,0:03:47.12,Default,,0,0,0,,Жалғастырыңыз!
Dialogue: 0,0:03:47.70,0:03:48.70,Default-ja,,0,0,0,,Жоқ, бұл сен...
Dialogue: 0,0:03:47.82,0:03:48.69,Default,,0,0,0,,Сен кет!
Dialogue: 0,0:03:49.32,0:03:51.41,Default-ja,,0,0,0,,Басқа адам тым нашар
Dialogue: 0,0:03:49.42,0:03:51.39,Default,,0,0,0,,Ол мен үшін тым қатал.
Dialogue: 0,0:03:51.53,0:03:56.04,Default-ja,,0,0,0,,Нуу~ мына жалдамалылар
Dialogue: 0,0:03:53.33,0:03:56.16,Default,,0,0,0,,Қарғыс атқыр жалдамалылар тобы!
Dialogue: 0,0:03:56.37,0:03:58.71,Default-ja,,0,0,0,,Хмф! Мен сонша жалқау болсам да
Dialogue: 0,0:03:57.23,0:03:58.82,Default,,0,0,0,,Мына қорқақты тыңда!
Dialogue: 0,0:03:58.83,0:04:00.92,Default-ja,,0,0,0,,Алтын шарлар кішірейіп барады.
Dialogue: 0,0:03:58.87,0:04:00.86,Default,,0,0,0,,Оның доптары оның ішінде кішірейіп кетті!
Dialogue: 0,0:04:01.04,0:04:03.04,Default-ja,,0,0,0,,Адамдар! мейірімділік пайдасыз
Dialogue: 0,0:04:01.17,0:04:03.30,Default,,0,0,0,,Еркектер! Мейірім жоқ!
Dialogue: 0,0:04:03.46,0:04:06.80,Default-ja,,0,0,0,,Мысықтың көз алмасын ойып алып, шүберекті сүйреп шығарыңыз.
Dialogue: 0,0:04:03.64,0:04:06.90,Default,,0,0,0,,Олардың көздерін ойып алыңыз! Іштерін жұлып ал!
Dialogue: 0,0:04:06.92,0:04:09.51,Default-ja,,0,0,0,,Олар оны шошқаларға тамақтандырады.
Dialogue: 0,0:04:07.01,0:04:09.48,Default,,0,0,0,,Біз оларды шошқаларға тамақтандырамыз!
Dialogue: 0,0:04:24.32,0:04:26.73,Default-ja,,0,0,0,,Бұл кім? (2-солдат) Ол әлі бала емес пе?
Dialogue: 0,0:04:24.53,0:04:25.36,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:04:25.43,0:04:26.86,Default,,0,0,0,,Ол әлі бала!
Dialogue: 0,0:04:26.86,0:04:29.36,Default-ja,,0,0,0,,Бұл қай жалдамалы? (4-солдат) Мына қылышқа қараңдаршы.
Dialogue: 0,0:04:26.93,0:04:28.36,Default,,0,0,0,,Ол кіммен?
Dialogue: 0,0:04:28.43,0:04:29.56,Default,,0,0,0,,Қандай қылыш!
Dialogue: 0,0:04:29.49,0:04:32.70,Default-ja,,0,0,0,,Ең бастысы, сіз өзіңізді көрсету үшін миыңызды жарып жібересіз.
Dialogue: 0,0:04:29.63,0:04:32.83,Default,,0,0,0,,Қараңызшы, оның қатал әрекеті. Оның басы жарылып кетеді!
Dialogue: 0,0:04:32.82,0:04:35.28,Default-ja,,0,0,0,,Қарсылас – Базусо.
Dialogue: 0,0:04:32.90,0:04:35.43,Default,,0,0,0,,Ол Базусомен соғысып жатыр!
Dialogue: 0,0:04:36.58,0:04:37.75,Default-ja,,0,0,0,,10 дана
Dialogue: 0,0:04:36.60,0:04:37.90,Default,,0,0,0,,Маған онды беріңіз.
Dialogue: 0,0:04:37.87,0:04:38.96,Default-ja,,0,0,0,,Не?
Dialogue: 0,0:04:37.97,0:04:39.03,Default,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:04:42.42,0:04:44.29,Default-ja,,0,0,0,,Бұл металл сынықтарының бағасы.
Dialogue: 0,0:04:42.44,0:04:44.47,Default,,0,0,0,,Мына темір сынықтарының бағасы мына жерде.
Dialogue: 0,0:04:44.42,0:04:48.17,Default-ja,,0,0,0,,Рыцарлар сияқты біз, жалдамалылар, абыроймен күн көре алмаймыз.
Dialogue: 0,0:04:44.51,0:04:48.45,Default,,0,0,0,,Біз жалдамалылар, рыцарь емеспіз. Мен өзімді даңқпен асырай алмаймын.
Dialogue: 0,0:04:48.30,0:04:49.88,Default-ja,,0,0,0,,Жарайсыз, Базузо мырза.
Dialogue: 0,0:04:48.48,0:04:50.11,Default,,0,0,0,,Базусоға бәс тігу?!
Dialogue: 0,0:04:50.09,0:04:52.47,Default-ja,,0,0,0,,Хохо... бұл жақсы нәрсе.
Dialogue: 0,0:04:50.95,0:04:52.65,Default,,0,0,0,,Батыл сөздер!
Dialogue: 0,0:04:52.59,0:04:53.64,Default-ja,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,0:04:52.72,0:04:57.89,Default,,0,0,0,,Жақсы! Оны түсір, мен саған жеті күміс теңге беремін.
Dialogue: 0,0:04:53.76,0:04:57.77,Default-ja,,0,0,0,,Егер сіз оны сәтті жеңсеңіз, мен сізге 7 күміс теңге беремін.
Dialogue: 0,0:04:57.93,0:05:00.39,Default-ja,,0,0,0,,Цк... Ол қызылшаңырақ.
Dialogue: 0,0:04:58.86,0:05:00.49,Default,,0,0,0,,Арзан бейбақ.
Dialogue: 0,0:05:02.14,0:05:03.60,Default-ja,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:05:02.40,0:05:03.76,Default,,0,0,0,,О. жақсы...
Dialogue: 0,0:05:17.45,0:05:20.16,Default-ja,,0,0,0,,Бала, өкінесің.
Dialogue: 0,0:05:17.61,0:05:22.11,Default,,0,0,0,,Кешірерсің, балам. Басыңнан айырыласың...
Dialogue: 0,0:05:20.29,0:05:23.71,Default-ja,,0,0,0,,Оның басы жеті күміс теңгемен қағылды...
Dialogue: 0,0:05:22.15,0:05:23.88,Default,,0,0,0,,жеті күміс үшін!
Dialogue: 0,0:05:24.00,0:05:26.04,Default-ja,,0,0,0,,Иә!
Dialogue: 0,0:05:28.96,0:05:29.84,Default-ja,,0,0,0,,... жылдам
Dialogue: 0,0:05:29.09,0:05:30.06,Default,,0,0,0,,H-Ол жылдам!
Dialogue: 0,0:05:33.26,0:05:35.43,Default-ja,,0,0,0,,Эй, Базусо қысымда.
Dialogue: 0,0:05:33.43,0:05:35.33,Default,,0,0,0,,Сәлем! Базусо артқа итеріп жатыр!
Dialogue: 0,0:05:35.60,0:05:38.03,Default,,0,0,0,,Не болып жатыр? Бұрын ешкім Базусоға бұлай жасамаған!
Dialogue: 0,0:05:36.14,0:05:38.93,Default-ja,,0,0,0,,Мен мұндай базузоны бұрын-соңды көрген емеспін. (Солдат) Бұл кім?
Dialogue: 0,0:05:38.07,0:05:39.06,Default,,0,0,0,,Ол кім?!
Dialogue: 0,0:05:39.06,0:05:40.93,Default-ja,,0,0,0,,Хамф!
Dialogue: 0,0:05:41.48,0:05:44.85,Default-ja,,0,0,0,,Шүкір, көңіл-күйің жақсы!
Dialogue: 0,0:05:41.54,0:05:42.73,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:05:42.77,0:05:44.80,Default,,0,0,0,,Мен саған қазір тоқтаймын!
Dialogue: 0,0:06:21.89,0:06:23.14,Default-ja,,0,0,0,,Ал... күте тұрыңыз.
Dialogue: 0,0:06:22.01,0:06:23.37,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:06:23.27,0:06:27.23,Default-ja,,0,0,0,,Мен сіздің шеберлігіңізге тәнтімін, бұл базузо...
Dialogue: 0,0:06:23.54,0:06:25.88,Default,,0,0,0,,Сіз ең жақсы адамсыз!
Dialogue: 0,0:06:25.91,0:06:27.40,Default,,0,0,0,,I. Базусо ам-!
Dialogue: 0,0:06:29.69,0:06:31.07,Default-ja,,0,0,0,,Базусо...
Dialogue: 0,0:06:29.78,0:06:31.08,Default,,0,0,0,,Базусо болды!
Dialogue: 0,0:06:38.12,0:06:39.08,Default-ja,,0,0,0,,Уф
Dialogue: 0,0:06:57.25,0:06:59.41,Default,,0,0,0,,Қазір! Олар сенімдерін жоғалтты!
Dialogue: 0,0:06:57.30,0:07:00.93,Default-ja,,0,0,0,,Енді жау дір-дір етеді. Зарядтау!
Dialogue: 0,0:06:59.45,0:07:00.81,Default,,0,0,0,,Зарядтау!
Dialogue: 0,0:07:05.60,0:07:08.77,Default-ja,,0,0,0,,Ей, мұнда керемет жігіттер бар.
Dialogue: 0,0:07:05.72,0:07:10.42,Default,,0,0,0,,Бұл жігіт шынымен де бір нәрсе. Оның кіммен жүргені қызық.
Dialogue: 0,0:07:08.90,0:07:10.48,Default-ja,,0,0,0,,Бұл қай отряд?
Dialogue: 0,0:07:10.46,0:07:13.36,Default,,0,0,0,,Алаңдамаңыз. Біз мұнда тым кеш келдік.
Dialogue: 0,0:07:10.61,0:07:13.19,Default-ja,,0,0,0,,Менен асып кетсең де, таңданғандықтан ба?
Dialogue: 0,0:07:13.32,0:07:15.19,Default-ja,,0,0,0,,Арызыңыз болса, ақымақ генералға айтыңыз.
Dialogue: 0,0:07:13.46,0:07:16.76,Default,,0,0,0,,Оны сол ақымақ генералды айыптаңыз. Бұл біздің кінәміз емес.
Dialogue: 0,0:07:15.32,0:07:16.53,Default-ja,,0,0,0,,Бұл біздің кінәміз емес
Dialogue: 0,0:07:17.11,0:07:20.28,Default-ja,,0,0,0,,Эй, Гриффит, кім күшті, сен бе, мен бе?
Dialogue: 0,0:07:17.13,0:07:20.29,Default,,0,0,0,,Сәлем, Гриффит! Қызық, кім күшті, сен бе, ол ма?
Dialogue: 0,0:07:20.87,0:07:23.95,Default-ja,,0,0,0,,Менен бос сөз сұрамаңыз, бұл сөзсіз Гриффит.
Dialogue: 0,0:07:20.94,0:07:24.00,Default,,0,0,0,,Ақылсыз сұрақтар қоймаңыз. Әрине. бұл Гриффит.
Dialogue: 0,0:09:45.09,0:09:47.01,Default-ja,,0,0,0,,Келесі
Dialogue: 0,0:09:45.21,0:09:47.15,Default,,0,0,0,,Жарайды! Келесі!
Dialogue: 0,0:09:48.76,0:09:54.10,Default-ja,,0,0,0,,Екі айлық жалақы және осы сыйақы.
Dialogue: 0,0:09:48.95,0:09:51.28,Default,,0,0,0,,Екі айлық жалақы...
Dialogue: 0,0:09:51.85,0:09:54.18,Default,,0,0,0,,және осы шайқас үшін сіздің сыйлығыңыз.
Dialogue: 0,0:09:55.73,0:09:59.19,Default-ja,,0,0,0,,Ей, қайта қарастырғың келмей ме?
Dialogue: 0,0:09:55.79,0:09:59.28,Default,,0,0,0,,Қайта қарастырмайтыныңызға сенімдісіз бе?
Dialogue: 0,0:09:59.32,0:10:01.11,Default-ja,,0,0,0,,Жалақы үш есе өсті
Dialogue: 0,0:09:59.36,0:10:06.20,Default,,0,0,0,,Бұл жалақы үш есе көп, мүмкін сіз бір күні сквайр бола аласыз.
Dialogue: 0,0:10:01.57,0:10:06.07,Default-ja,,0,0,0,,Сіз оны самурайға апарған дұрыс деп жатырсыз.
Dialogue: 0,0:10:06.74,0:10:11.79,Default-ja,,0,0,0,,Егер біз жалдамалы жауынгер болсақ, бұл арман орындалмас па еді?
Dialogue: 0,0:10:06.80,0:10:11.93,Default,,0,0,0,,Бұл көптеген жалдамалылар үшін мүмкін емес арман, сіз білесіз.
Dialogue: 0,0:10:15.17,0:10:17.92,Default-ja,,0,0,0,,Арман? Сіз мұны жей алмайсыз ба?
Dialogue: 0,0:10:15.24,0:10:18.04,Default,,0,0,0,,Арман? Сіз армандарды жей алмайсыз.
Dialogue: 0,0:10:23.47,0:10:25.01,Default-ja,,0,0,0,,Ал... күте тұрыңыз.
Dialogue: 0,0:10:23.55,0:10:25.04,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:10:25.22,0:10:28.14,Default-ja,,0,0,0,,Ол сізге мәртебеге де, ақшаға да кепілдік беремін дейді.
Dialogue: 0,0:10:25.29,0:10:30.12,Default,,0,0,0,,Бұл ақша мен мәртебеге кепілдік береді. Бұған қандай проблемаңыз бар?
Dialogue: 0,0:10:28.26,0:10:30.01,Default-ja,,0,0,0,,Сіз неге шағымданасыз?
Dialogue: 0,0:10:31.06,0:10:34.02,Default-ja,,0,0,0,,Мен қысылғанды ​​жек көремін.
Dialogue: 0,0:10:31.16,0:10:33.99,Default,,0,0,0,,Мен ұстамдылықты жек көремін.
Dialogue: 0,0:10:40.82,0:10:42.11,Default-ja,,0,0,0,,Келесі!
Dialogue: 0,0:10:40.97,0:10:42.20,Default,,0,0,0,,Келесі!
Dialogue: 0,0:10:59.25,0:11:00.34,Default-ja,,0,0,0,,Ұры?
Dialogue: 0,0:10:59.32,0:11:00.38,Default,,0,0,0,,Қарақшылар. иә?
Dialogue: 0,0:11:11.60,0:11:13.68,Default-ja,,0,0,0,,Жүр!
Dialogue: 0,0:11:11.73,0:11:13.67,Default,,0,0,0,,Жарайды! Бар!
Dialogue: 0,0:11:13.81,0:11:15.85,Default-ja,,0,0,0,,Хяхаха
Dialogue: 0,0:11:19.31,0:11:22.82,Default-ja,,0,0,0,,Нуаа~!
Dialogue: 0,0:11:28.70,0:11:29.87,Default-ja,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:11:28.82,0:11:29.94,Default,,0,0,0,,Қат!
Dialogue: 0,0:11:30.24,0:11:31.74,Default-ja,,0,0,0,,Қараңдар!
Dialogue: 0,0:11:30.25,0:11:31.84,Default,,0,0,0,,Тек күтіңіз!
Dialogue: 0,0:11:42.92,0:11:45.38,Default-ja,,0,0,0,,Deei (мүше) Wow
Dialogue: 0,0:11:45.92,0:11:47.17,Default-ja,,0,0,0,,Бұл – Огимотоя.
Dialogue: 0,0:11:55.22,0:11:58.73,Default-ja,,0,0,0,,Мынау... бұл жігіт шынымен мықты!
Dialogue: 0,0:11:55.71,0:11:58.70,Default,,0,0,0,,Ол... өте күшті!
Dialogue: 0,0:11:59.77,0:12:01.40,Default-ja,,0,0,0,,Эй, сен жеңілдің.
Dialogue: 0,0:11:59.81,0:12:01.30,Default,,0,0,0,,Ол бізді өлтіріп жатыр.
Dialogue: 0,0:12:01.52,0:12:02.61,Default-ja,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:12:01.62,0:12:02.67,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:12:02.90,0:12:06.40,Default-ja,,0,0,0,,Коркастағы жігіт қатты қорқады.
Dialogue: 0,0:12:02.92,0:12:06.32,Default,,0,0,0,,Коркус өз-өзін боқтап жатыр.
Dialogue: 0,0:12:06.53,0:12:08.82,Default-ja,,0,0,0,,Бірақ ол өте күшті.
Dialogue: 0,0:12:06.62,0:12:08.85,Default,,0,0,0,,Жігіт өте қатал.
Dialogue: 0,0:12:08.92,0:12:12.09,Default,,0,0,0,,Оның Базусоны құлатуы кездейсоқ емес еді.
Dialogue: 0,0:12:08.95,0:12:12.12,Default-ja,,0,0,0,,Ах... Базусоны өлтірген Дата емес еді.
Dialogue: 0,0:12:12.19,0:12:13.68,Default,,0,0,0,,Біз не істейміз?
Dialogue: 0,0:12:12.24,0:12:13.62,Default-ja,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,0:12:13.78,0:12:15.74,Default-ja,,0,0,0,,Хмф, мен сізге айтпаймын.
Dialogue: 0,0:12:13.83,0:12:15.80,Default,,0,0,0,,айттым ғой.
Dialogue: 0,0:12:15.87,0:12:18.33,Default-ja,,0,0,0,,Каска, кет.
Dialogue: 0,0:12:15.96,0:12:16.90,Default,,0,0,0,,Каска...
Dialogue: 0,0:12:17.10,0:12:18.26,Default,,0,0,0,,Оған көмектесіңіз.
Dialogue: 0,0:12:18.43,0:12:20.99,Default,,0,0,0,,Неліктен? Бұл Коркустың идеясы еді!
Dialogue: 0,0:12:18.46,0:12:21.00,Default-ja,,0,0,0,,Неліктен Коркус мұны рұқсатсыз жасады?
Dialogue: 0,0:12:24.63,0:12:26.09,Default-ja,,0,0,0,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,0:12:24.71,0:12:26.14,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:12:27.63,0:12:29.05,Default-ja,,0,0,0,,Эй, бара бер.
Dialogue: 0,0:12:27.68,0:12:29.07,Default,,0,0,0,,Барыңыз, оны алыңыз!
Dialogue: 0,0:12:29.14,0:12:31.98,Default,,0,0,0,,Неліктен? Сіз мұны бастадыңыз! Сіз оны аласыз!
Dialogue: 0,0:12:29.17,0:12:31.80,Default-ja,,0,0,0,,Неліктен? Оны айтқан сен едің ғой, солай ма?
Dialogue: 0,0:12:33.35,0:12:34.30,Default-ja,,0,0,0,,Жоқ!
Dialogue: 0,0:12:33.38,0:12:34.35,Default,,0,0,0,,О. жоқ!
Dialogue: 0,0:12:34.93,0:12:36.06,Default-ja,,0,0,0,,Сәлем! ақымақ!
Dialogue: 0,0:12:35.02,0:12:36.11,Default,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,0:12:36.18,0:12:37.34,Default,,0,0,0,,О. боқ!
Dialogue: 0,0:12:36.18,0:12:37.22,Default-ja,,0,0,0,,Жоқ!
Dialogue: 0,0:12:43.90,0:12:45.07,Default-ja,,0,0,0,,Төмен түсіңіз.
Dialogue: 0,0:12:43.99,0:12:45.05,Default,,0,0,0,,Артқа тартыңыз!
Dialogue: 0,0:12:45.13,0:12:46.39,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:12:45.19,0:12:46.48,Default-ja,,0,0,0,,олардың әрекеттерін күшейту қаупі бар.
Dialogue: 0,0:12:54.66,0:12:56.45,Default-ja,,0,0,0,,Қандай ұзындық!
Dialogue: 0,0:12:54.74,0:12:56.20,Default,,0,0,0,,Бұл ұзындық нені білдіреді?
Dialogue: 0,0:13:18.60,0:13:19.43,Default-ja,,0,0,0,,қуыршақтай киімінен мүлде алшақ еді—
Dialogue: 0,0:13:18.79,0:13:19.52,Default,,0,0,0,,Қыз ба?
Dialogue: 0,0:13:19.56,0:13:20.43,Default-ja,,0,0,0,,Сіз
Dialogue: 0,0:13:19.63,0:13:20.62,Default,,0,0,0,,Сен бейбақ!
Dialogue: 0,0:13:28.73,0:13:30.57,Default-ja,,0,0,0,,Каска бұрышта тұр.
Dialogue: 0,0:13:28.90,0:13:30.56,Default,,0,0,0,,Ол тіпті Касканы кері итеріп жатыр.
Dialogue: 0,0:13:30.69,0:13:32.40,Default-ja,,0,0,0,,Әй, бұл өтірік, солай ма?
Dialogue: 0,0:13:30.74,0:13:32.43,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:13:41.33,0:13:42.87,Default-ja,,0,0,0,,Жақсы істедің, Иносукэ!
Dialogue: 0,0:13:41.45,0:13:42.61,Default,,0,0,0,,Мен өлемін!
Dialogue: 0,0:13:50.46,0:13:51.72,Default-ja,,0,0,0,,Гриффит!
Dialogue: 0,0:13:50.52,0:13:51.92,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:13:52.47,0:13:54.97,Default-ja,,0,0,0,,Абайлаңыз, бұл жігіт қатал.
Dialogue: 0,0:13:52.53,0:13:55.12,Default,,0,0,0,,Абайлаңыз! Ол күшті!
Dialogue: 0,0:13:56.51,0:13:57.81,Default-ja,,0,0,0,,Гриффит? Хэхе~
Dialogue: 0,0:13:56.60,0:13:57.76,Default,,0,0,0,,Гриффит?
Dialogue: 0,0:13:58.06,0:14:00.06,Default-ja,,0,0,0,,Бұл сіз үшін аяқталды.
Dialogue: 0,0:13:58.20,0:14:00.19,Default,,0,0,0,,Міне, сіз үшін!
Dialogue: 0,0:14:00.18,0:14:01.85,Default-ja,,0,0,0,,Жаса, Гриффит.
Dialogue: 0,0:14:00.30,0:14:02.03,Default,,0,0,0,,Оны алыңыз. Гриффит!
Dialogue: 0,0:14:07.56,0:14:09.57,Default-ja,,0,0,0,,Өтінемін, қылышыңды суырып аласың ба?
Dialogue: 0,0:14:07.68,0:14:09.51,Default,,0,0,0,,Сен қылышыңды қынап ала аласың ба?
Dialogue: 0,0:14:13.28,0:14:14.66,Default-ja,,0,0,0,,Әлі емес.
Dialogue: 0,0:14:13.38,0:14:14.71,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:14:28.29,0:14:30.21,Default-ja,,0,0,0,,Жылдам...
Dialogue: 0,0:14:28.40,0:14:29.76,Default,,0,0,0,,Ол жылдам!
Dialogue: 0,0:14:36.05,0:14:37.34,Default-ja,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:14:36.10,0:14:37.43,Default,,0,0,0,,Қат!
Dialogue: 0,0:14:40.89,0:14:43.23,Default-ja,,0,0,0,,Керемет! бір ғана соққымен
Dialogue: 0,0:14:41.08,0:14:43.27,Default,,0,0,0,,Керемет! Бір соққыда!
Dialogue: 0,0:14:50.58,0:14:53.05,Default,,0,0,0,,Гриффит...
Dialogue: 0,0:14:50.61,0:14:52.94,Default-ja,,0,0,0,,Гри... фисс
Dialogue: 0,0:15:26.39,0:15:28.58,Default,,0,0,0,,Аяқтарда!
Dialogue: 0,0:15:29.32,0:15:31.52,Default,,0,0,0,,Сіз осылай өмір сүремін деп ойлайсыз ба?
Dialogue: 0,0:15:37.36,0:15:39.70,Default,,0,0,0,,Қараңдар! Мен оны істедім!
Dialogue: 0,0:15:40.53,0:15:42.23,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:15:56.48,0:16:00.11,Default,,0,0,0,,Сіз сатылып кетті!
Dialogue: 0,0:16:04.02,0:16:06.49,Default,,0,0,0,,Гамбино! Бұл рас па?!
Dialogue: 0,0:16:27.55,0:16:29.35,Default,,0,0,0,,Оның артынан!
Dialogue: 0,0:16:34.62,0:16:36.92,Default,,0,0,0,,Ол баланы қабылдады!
Dialogue: 0,0:16:36.99,0:16:38.93,Default,,0,0,0,,Ал, оның ақысын осылай қайтарады ма?!
Dialogue: 0,0:16:55.44,0:16:56.93,Default,,0,0,0,,Гамбино!
Dialogue: 0,0:16:57.41,0:16:59.71,Default,,0,0,0,,Сен тірісің!
Dialogue: 0,0:17:56.17,0:17:57.34,Default-ja,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:17:56.24,0:17:57.36,Default,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:17:58.09,0:17:59.59,Default-ja,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:17:58.17,0:17:59.57,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:18:04.26,0:18:07.26,Default-ja,,0,0,0,,Бұл қай жерде? неге мұндасың?
Dialogue: 0,0:18:04.31,0:18:07.30,Default,,0,0,0,,Мен қайдамын? Неге мұндасың?
Dialogue: 0,0:18:15.10,0:18:18.48,Default-ja,,0,0,0,,Сізді Гриффит өлтіруі керек еді!
Dialogue: 0,0:18:15.19,0:18:18.49,Default,,0,0,0,,Гриффит сені өлтіріп, тастап кетуі керек еді!
Dialogue: 0,0:18:21.60,0:18:22.69,Default,,0,0,0,,Неге, сен...
Dialogue: 0,0:18:21.61,0:18:22.74,Default-ja,,0,0,0,,Бұл… бұл…
Dialogue: 0,0:18:24.53,0:18:26.19,Default,,0,0,0,,Бұл менің атыма арналған!
Dialogue: 0,0:18:24.53,0:18:26.11,Default-ja,,0,0,0,,Бұл атты садақ!
Dialogue: 0,0:18:33.33,0:18:34.21,Default-ja,,0,0,0,,Ақымақ
Dialogue: 0,0:18:33.37,0:18:34.27,Default,,0,0,0,,Боқ...
Dialogue: 0,0:18:34.58,0:18:36.27,Default,,0,0,0,,Мына қаншық!
Dialogue: 0,0:18:34.58,0:18:36.21,Default-ja,,0,0,0,,Сол әуесқой
Dialogue: 0,0:18:46.68,0:18:48.18,Default-ja,,0,0,0,,Жарайды, міне... (2-мүше) Иә!
Dialogue: 0,0:18:46.72,0:18:47.78,Default,,0,0,0,,Жарайды, мынау!
Dialogue: 0,0:18:54.64,0:18:57.06,Default-ja,,0,0,0,,Сіз Каскаға алғыс айтуыңыз керек.
Dialogue: 0,0:18:54.76,0:18:57.29,Default,,0,0,0,,Каскаға риза болыңыз.
Dialogue: 0,0:18:57.31,0:19:00.44,Default-ja,,0,0,0,,Қанның көп төгілуінен денеңіз салқындаған...
Dialogue: 0,0:18:57.40,0:19:00.59,Default,,0,0,0,,Ол сенімен екі күн жатты
Dialogue: 0,0:19:00.57,0:19:02.94,Default-ja,,0,0,0,,Мен сені жылыту үшін екі күн, түн ұйықтадым.
Dialogue: 0,0:19:00.67,0:19:03.07,Default,,0,0,0,,қан жоғалтқаннан кейін сізді жылыту үшін.
Dialogue: 0,0:19:03.07,0:19:04.86,Default-ja,,0,0,0,,Не?
Dialogue: 0,0:19:03.14,0:19:04.93,Default,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:19:06.32,0:19:08.32,Default-ja,,0,0,0,,Гриффит бұйрығы
Dialogue: 0,0:19:06.51,0:19:08.50,Default,,0,0,0,,Гриффиттің бұйрығы бойынша.
Dialogue: 0,0:19:08.70,0:19:11.91,Default-ja,,0,0,0,,Еркекті жылыту әйелдің міндеті...
Dialogue: 0,0:19:08.81,0:19:12.07,Default,,0,0,0,,Ерлерді жылыту әйелдің міндеті дейді.
Dialogue: 0,0:19:14.75,0:19:16.71,Default-ja,,0,0,0,,Яһудея
Dialogue: 0,0:19:14.92,0:19:16.88,Default,,0,0,0,,Қарғыс атсын. Яһудея!
Dialogue: 0,0:19:17.42,0:19:18.88,Default-ja,,0,0,0,,Вари Вари
Dialogue: 0,0:19:17.48,0:19:18.95,Default,,0,0,0,,9-эпизод
Dialogue: 0,0:19:19.00,0:19:21.34,Default-ja,,0,0,0,,Сіз толық ояу сияқтысыз.
Dialogue: 0,0:19:19.25,0:19:21.08,Default,,0,0,0,,Демек, сен ояусың.
Dialogue: 0,0:19:22.55,0:19:24.84,Default-ja,,0,0,0,,Қайырлы таң, Гриффит.
Dialogue: 0,0:19:22.62,0:19:24.65,Default,,0,0,0,,Гриффит! Қайырлы таң.
Dialogue: 0,0:19:40.77,0:19:42.02,Default-ja,,0,0,0,,Мен Гриффитпін
Dialogue: 0,0:19:40.87,0:19:43.50,Default,,0,0,0,,Мен Гриффитпін. Сіздің атыңыз кім?
Dialogue: 0,0:19:42.15,0:19:43.32,Default-ja,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:19:46.48,0:19:47.57,Default,,0,0,0,,Ішек.
Dialogue: 0,0:19:46.49,0:19:47.70,Default-ja,,0,0,0,,Ішек
Dialogue: 0,0:19:52.12,0:19:53.70,Default-ja,,0,0,0,,Қандай керемет қылыш.
Dialogue: 0,0:19:52.35,0:19:53.82,Default,,0,0,0,,Бұл ғажайып қылыш.
Dialogue: 0,0:19:57.22,0:19:59.12,Default,,0,0,0,,Мен оны ешқашан ұстай алмадым.
Dialogue: 0,0:19:57.25,0:19:59.17,Default-ja,,0,0,0,,Мен оны шынымен шайқай алмаймын.
Dialogue: 0,0:20:02.38,0:20:04.67,Default-ja,,0,0,0,,Келесің бе? бірге
Dialogue: 0,0:20:02.50,0:20:04.59,Default,,0,0,0,,Менімен келесің бе?
Dialogue: 0,0:20:10.80,0:20:12.35,Default-ja,,0,0,0,,Гриффит сияқты
Dialogue: 0,0:20:10.84,0:20:12.46,Default,,0,0,0,,Сәлем. Гриффит!
Dialogue: 0,0:20:15.72,0:20:16.93,Default-ja,,0,0,0,,Гриффит
Dialogue: 0,0:20:15.78,0:20:16.94,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:20:22.19,0:20:22.94,Default-ja,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:20:22.22,0:20:23.34,Default,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:20:24.78,0:20:26.90,Default-ja,,0,0,0,,Өте танымал.
Dialogue: 0,0:20:24.82,0:20:26.91,Default,,0,0,0,,Сіз шынымен танымалсыз.
Dialogue: 0,0:20:28.15,0:20:29.65,Default-ja,,0,0,0,,Эй...
Dialogue: 0,0:20:28.59,0:20:29.72,Default,,0,0,0,,Эй...
Dialogue: 0,0:20:31.03,0:20:33.95,Default-ja,,0,0,0,,Хм, мен шыдай алмаймын.
Dialogue: 0,0:20:31.09,0:20:33.82,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:20:34.08,0:20:36.33,Default-ja,,0,0,0,,Иә? Бейбақ...
Dialogue: 0,0:20:35.23,0:20:39.06,Default,,0,0,0,,Сонда әлгі бейбақ жүрді ме?
Dialogue: 0,0:20:36.70,0:20:39.25,Default-ja,,0,0,0,,Сіз қазір көшуге дайынсыз ба?
Dialogue: 0,0:20:41.29,0:20:42.75,Default-ja,,0,0,0,,Гриффит?
Dialogue: 0,0:20:41.30,0:20:42.67,Default,,0,0,0,,Гриффит?
Dialogue: 0,0:20:43.21,0:20:46.76,Default-ja,,0,0,0,,Мұнда біртүрлі атмосфера бар...?
Dialogue: 0,0:20:43.24,0:20:46.60,Default,,0,0,0,,Менде біртүрлі сезім бар... Мен қайдамын?
Dialogue: 0,0:20:47.05,0:20:48.51,Default-ja,,0,0,0,,Сұңқарлар тобы
Dialogue: 0,0:20:47.07,0:20:48.44,Default,,0,0,0,,Сіз Hawk тобымен біргесіз.
Dialogue: 0,0:20:49.74,0:20:50.87,Default,,0,0,0,,Біз туралы естідіңіз бе?
Dialogue: 0,0:20:49.76,0:20:50.93,Default-ja,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:20:51.38,0:20:56.64,Default-ja,,0,0,0,,Ах... Олар ұрыс даласында жау болғың келмейтін жалдамалы топтардың бірі.
Dialogue: 0,0:20:51.45,0:20:56.41,Default,,0,0,0,,Ұрыс даласында тап болғыңыз келетін соңғы жалдамалылар.
Dialogue: 0,0:20:57.35,0:21:00.31,Default-ja,,0,0,0,,Соңғы шайқаста мен көп қиындық көрдім.
Dialogue: 0,0:20:57.42,0:21:00.08,Default,,0,0,0,,Олар бізге соңғы шайқаста көп қиындық әкелді.
Dialogue: 0,0:21:00.60,0:21:03.19,Default-ja,,0,0,0,,Түсіндім, бұл жігіттер...
Dialogue: 0,0:21:00.62,0:21:03.06,Default,,0,0,0,,Сонда бұл балалар болды ма?
Dialogue: 0,0:21:04.11,0:21:07.32,Default-ja,,0,0,0,,Иә, біз сол сұңқарлар тобымыз.
Dialogue: 0,0:21:04.22,0:21:07.22,Default,,0,0,0,,Иә. Біз Hawk тобымыз.
Dialogue: 0,0:21:18.25,0:21:20.04,Default-ja,,0,0,0,,Бұл тамаша көрініс
Dialogue: 0,0:21:18.34,0:21:20.14,Default,,0,0,0,,Керемет көрініс!
Dialogue: 0,0:21:20.16,0:21:21.12,Default-ja,,0,0,0,,Неліктен?
Dialogue: 0,0:21:20.27,0:21:21.24,Default,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:21:23.50,0:21:25.79,Default-ja,,0,0,0,,Неліктен менің маңызды нүктелерімді алып тастадыңыз?
Dialogue: 0,0:21:23.54,0:21:25.37,Default,,0,0,0,,Неге жүрегімді қатты сағындың?
Dialogue: 0,0:21:28.84,0:21:30.47,Default-ja,,0,0,0,,Сіз мұны істей алар едіңіз.
Dialogue: 0,0:21:28.85,0:21:30.18,Default,,0,0,0,,Сіз мұны оңай жасай аласыз.
Dialogue: 0,0:21:35.76,0:21:39.12,Default,,0,0,0,,Себебі мен сені қалаймын, Ішек.
Dialogue: 0,0:21:35.76,0:21:39.10,Default-ja,,0,0,0,,Себебі мен сені қаладым, Ішек.
Dialogue: 0,0:21:43.35,0:21:45.69,Default-ja,,0,0,0,,Эй, ол жақта сіздің хоббиіңіз бар ма?
Dialogue: 0,0:21:43.43,0:21:45.63,Default,,0,0,0,,Не, сен осылай тербелесің бе?
Dialogue: 0,0:21:47.80,0:21:52.40,Default,,0,0,0,,Мен сіздің Базусомен жекпе-жекті көрдім. Бұл өте тамаша болды.
Dialogue: 0,0:21:47.90,0:21:52.49,Default-ja,,0,0,0,,Маған Базусомен жеке жекпе-жек көрсетілді. Бұл таңқаларлық болды.
Dialogue: 0,0:21:53.15,0:21:55.70,Default-ja,,0,0,0,,Бірақ... бұл қауіпті болды.
Dialogue: 0,0:21:53.21,0:21:55.64,Default,,0,0,0,,Бірақ бұл жақын қоңырау болды.
Dialogue: 0,0:21:57.44,0:22:00.35,Default,,0,0,0,,Оның шайқас балтасы жарылып кетпесе...
Dialogue: 0,0:21:57.45,0:22:00.33,Default-ja,,0,0,0,,Егер оның шайқас балтасы жарылып кетпесе...
Dialogue: 0,0:22:01.75,0:22:04.84,Default,,0,0,0,,ол сенің басыңды жарып жіберер еді.
Dialogue: 0,0:22:01.83,0:22:04.96,Default-ja,,0,0,0,,Басы жарылған сен болуың керек еді.
Dialogue: 0,0:22:09.49,0:22:10.75,Default,,0,0,0,,Қандай сәнсіз...
Dialogue: 0,0:22:09.50,0:22:10.55,Default-ja,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:22:10.67,0:22:13.22,Default-ja,,0,0,0,,Хаха...шынайы.
Dialogue: 0,0:22:11.79,0:22:12.99,Default,,0,0,0,,Сіз шыншылсыз.
Dialogue: 0,0:22:14.19,0:22:18.43,Default,,0,0,0,,Қанша жерден құтылуға болатынын көргісі келгендей төбелесесің.
Dialogue: 0,0:22:14.22,0:22:18.35,Default-ja,,0,0,0,,Сіздің ұрысыңыз өз өміріңізді сынап жатқан сияқты.
Dialogue: 0,0:22:20.60,0:22:24.43,Default,,0,0,0,,Маған сіз әдейі қауіп төндіретін сияқтысыз...
Dialogue: 0,0:22:20.64,0:22:24.23,Default-ja,,0,0,0,,Мен өзімді өлім қаупіне ұшырату үшін барын салуға тура келді.
Dialogue: 0,0:22:24.35,0:22:27.19,Default-ja,,0,0,0,,Керісінше, мен ол жерден өмірді құтқару үшін күресіп жатырмын...
Dialogue: 0,0:22:24.47,0:22:27.27,Default,,0,0,0,,бірақ сонымен бірге. сіз де аман қалу үшін күресіп жатырсыз.
Dialogue: 0,0:22:28.36,0:22:30.19,Default-ja,,0,0,0,,Мен осылай сезіндім.
Dialogue: 0,0:22:28.48,0:22:30.07,Default,,0,0,0,,Дәл солай болды.
Dialogue: 0,0:22:33.65,0:22:35.57,Default-ja,,0,0,0,,Маған ұнадың
Dialogue: 0,0:22:33.68,0:22:35.31,Default,,0,0,0,,Маған ұнайсың.
Dialogue: 0,0:22:36.70,0:22:38.78,Default-ja,,0,0,0,,Мен сені қалаймын, Ішек.
Dialogue: 0,0:22:36.72,0:22:38.62,Default,,0,0,0,,Мен сені қалаймын, Ішек.
Dialogue: 0,0:22:46.37,0:22:48.04,Default-ja,,0,0,0,,Жоқ десем ше?
Dialogue: 0,0:22:46.39,0:22:47.79,Default,,0,0,0,,Ал егер мен жоқ десем?
Dialogue: 0,0:22:48.54,0:22:49.42,Default-ja,,0,0,0,,Жоқ?
Dialogue: 0,0:22:48.60,0:22:49.49,Default,,0,0,0,,Қаламайсыз ба?
Dialogue: 0,0:22:50.55,0:22:54.26,Default-ja,,0,0,0,,Жоқ! Бірдеңе үйренген сияқтымын
Dialogue: 0,0:22:50.60,0:22:54.36,Default,,0,0,0,,Иә. Мен бас тартамын! Бәрін білетіндей сөйлеп...
Dialogue: 0,0:22:57.51,0:23:02.43,Default-ja,,0,0,0,,Біреудің денесінде үлкен тесік болуы өте таныс!
Dialogue: 0,0:22:57.57,0:22:59.97,Default,,0,0,0,,біреуді пышақтау...
Dialogue: 0,0:23:00.74,0:23:02.50,Default,,0,0,0,,, содан кейін сіз олардың досы сияқты әрекет етесіз ...
Dialogue: 0,0:23:03.81,0:23:07.01,Default,,0,0,0,,Мен мұнымен шешемін. Жеңсем, сені пышақтап аламын...
Dialogue: 0,0:23:03.81,0:23:07.15,Default-ja,,0,0,0,,Осымен аяқтаңыз! Жеңсем сенің жүрегіңде болады...
Dialogue: 0,0:23:07.08,0:23:09.64,Default,,0,0,0,,кеудеге дәл сен маған жасағандай.
Dialogue: 0,0:23:07.27,0:23:09.61,Default-ja,,0,0,0,,Мен өзім сияқты үлкен тесік жасаймын!
Dialogue: 0,0:23:10.77,0:23:12.15,Default-ja,,0,0,0,,Мен жеңсем ше?
Dialogue: 0,0:23:10.78,0:23:12.08,Default,,0,0,0,,Ал егер мен жеңсем?
Dialogue: 0,0:23:13.49,0:23:16.40,Default-ja,,0,0,0,,Сарбаз бол, шұбар қаз, қалағаныңды істе.
Dialogue: 0,0:23:13.55,0:23:16.49,Default,,0,0,0,,Сіз мені солдат немесе есек ете аласыз... қалағаныңызды жасаңыз.
Dialogue: 0,0:23:22.87,0:23:24.04,Default-ja,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:23:22.96,0:23:24.09,Default,,0,0,0,,Вент ашылғалы үш күн өтті
Dialogue: 0,0:23:28.00,0:23:31.09,Default-ja,,0,0,0,,I don't dislike using force.
Dialogue: 0,0:23:28.17,0:23:30.90,Default,,0,0,0,,Мен күшпен істеуге қарсы емеспін.
Dialogue: 0,0:23:31.25,0:23:32.67,Default-ja,,0,0,0,,Гриффит!
Dialogue: 0,0:23:31.34,0:23:32.40,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:23:32.92,0:23:34.67,Default-ja,,0,0,0,,Менімен араласпа, Каска
Dialogue: 0,0:23:33.01,0:23:34.50,Default,,0,0,0,,Артында бол, Каска.
Dialogue: 0,0:23:35.09,0:23:36.42,Default-ja,,0,0,0,,Бірақ…
Dialogue: 0,0:23:35.21,0:23:36.33,Default,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:23:36.76,0:23:39.93,Default-ja,,0,0,0,,Мен қалағанымды міндетті түрде аламын
Dialogue: 0,0:23:36.78,0:23:39.77,Default,,0,0,0,,Мен әрқашан қалағанымды аламын.
Dialogue: 0,0:23:40.14,0:23:43.93,Default-ja,,0,0,0,,Маған сенің ол адамға жасаған қарым-қатынасың ұнамайды.
Dialogue: 0,0:23:40.15,0:23:44.08,Default,,0,0,0,,Сенің маған ұнамайтын жері осы. Сізде ешқандай құрмет жоқ!
Dialogue: 0,0:23:59.49,0:24:00.32,Default-ja,,0,0,0,,Ақымақ
Dialogue: 0,0:23:59.60,0:24:00.43,Default,,0,0,0,,Қат!
Dialogue: 0,0:24:00.45,0:24:01.37,Default-ja,,0,0,0,,Әй, қара!
Dialogue: 0,0:24:00.47,0:24:01.40,Default,,0,0,0,,Әй, қара!
Dialogue: 0,0:24:01.47,0:24:03.53,Default,,0,0,0,,Жігіт тек тастамайды!
Dialogue: 0,0:24:01.49,0:24:03.49,Default-ja,,0,0,0,,Әлгі бейбақтың проблемасы жоқ!
Dialogue: 0,0:24:03.60,0:24:06.27,Default,,0,0,0,,Гриффит одан аулақ болыңыз дейді.
Dialogue: 0,0:24:03.62,0:24:06.29,Default-ja,,0,0,0,,Менімен араласпа, бұл Гриффиттің бұйрығы.
Dialogue: 0,0:24:06.71,0:24:10.67,Default-ja,,0,0,0,,Күнді өзгертуге болмайды. Аурудан айығу жаман идея.
Dialogue: 0,0:24:06.84,0:24:10.64,Default,,0,0,0,,Біз мұны басқа күні жасай аламыз. Сен әлі әлсізсің.
Dialogue: 0,0:24:10.79,0:24:12.29,Default-ja,,0,0,0,,Нукасее!
Dialogue: 0,0:24:10.81,0:24:12.14,Default,,0,0,0,,Бля саған!
Dialogue: 0,0:24:13.80,0:24:14.67,Default-ja,,0,0,0,,Гриффит
Dialogue: 0,0:24:13.98,0:24:15.31,Default,,0,0,0,,- Гриффит! - Бұл әділет емес!
Dialogue: 0,0:24:14.80,0:24:15.67,Default-ja,,0,0,0,,Ластанбаңыз!
Dialogue: 0,0:24:27.85,0:24:31.27,Default-ja,,0,0,0,,Жеңіске жету үшін бәрін жасаймын, бұл маған көбірек ұнайды
Dialogue: 0,0:24:27.93,0:24:31.26,Default,,0,0,0,,Жеңіске жету үшін бәрін жасайсыз. Мен сені одан сайын жақсы көремін.
Dialogue: 0,0:24:32.13,0:24:34.53,Default,,0,0,0,,Бірақ қазір қылышыңды қозғалта алмайсың.
Dialogue: 0,0:24:32.15,0:24:34.65,Default-ja,,0,0,0,,Бірақ мен қылышты бұлай сермеу мүмкін емес.
Dialogue: 0,0:24:35.40,0:24:38.11,Default-ja,,0,0,0,,Не істеу керек? Сіз қазір тоқтай аласыз.
Dialogue: 0,0:24:35.44,0:24:38.00,Default,,0,0,0,,Сіз не істегіңіз келеді? Қаласаңыз, қазір бас тарта аласыз.
Dialogue: 0,0:24:38.24,0:24:40.04,Default,,0,0,0,,Сіз аузыңызды жүгірткенді ұнатасыз.
Dialogue: 0,0:24:38.24,0:24:40.16,Default-ja,,0,0,0,,Әңгімешіл жігіт.
Dialogue: 0,0:24:40.49,0:24:42.03,Default-ja,,0,0,0,,Олай болса, мен сізге хабарлаймын.
Dialogue: 0,0:24:40.57,0:24:43.54,Default,,0,0,0,,Бірақ нағыз жекпе-жекте ауызды пайдалану керек...
Dialogue: 0,0:24:42.16,0:24:44.91,Default-ja,,0,0,0,,Шайқаста аузыңды осылай пайдаланасың!
Dialogue: 0,0:24:43.58,0:24:44.77,Default,,0,0,0,,осылай!
Dialogue: 0,0:24:49.71,0:24:51.00,Default-ja,,0,0,0,,Гриффит!
Dialogue: 0,0:24:49.78,0:24:50.84,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:25:01.26,0:25:03.42,Default,,0,0,0,,Сіздің қаныңыздың дәмі қандай?
Dialogue: 0,0:25:01.26,0:25:03.39,Default-ja,,0,0,0,,Сіздің қаныңыздың дәмі қандай?
Dialogue: 0,0:25:04.10,0:25:08.35,Default-ja,,0,0,0,,Сол әдемі жүзіңізбен, менің ойымша, сіз әлі соққыға жығылған жоқсыз.
Dialogue: 0,0:25:04.13,0:25:07.90,Default,,0,0,0,,Мен сенің әдемі жүзіңді ешкім ұрмағанына сенімдімін.
Dialogue: 0,0:25:13.81,0:25:15.98,Default-ja,,0,0,0,,Жамандық өз қолбасшыларының алдында...
Dialogue: 0,0:25:13.91,0:25:16.21,Default,,0,0,0,,Мен сені ер адамдарыңның алдына көрсетуді жек көремін,
Dialogue: 0,0:25:16.11,0:25:18.15,Default-ja,,0,0,0,,Міне!
Dialogue: 0,0:25:16.31,0:25:18.17,Default,,0,0,0,,бірақ бұл енді аяқталады!
Dialogue: 0,0:25:24.85,0:25:27.55,Default,,0,0,0,,- Иә! Ол жасады! - Керемет!
Dialogue: 0,0:25:25.03,0:25:26.49,Default-ja,,0,0,0,,Ой! Ол бұрыштан айналып кетті!
Dialogue: 0,0:25:26.62,0:25:27.66,Default-ja,,0,0,0,,Шешілді!
Dialogue: 0,0:25:28.41,0:25:30.46,Default-ja,,0,0,0,,Қазір жұмыс істеді.
Dialogue: 0,0:25:28.49,0:25:30.42,Default,,0,0,0,,Бұл тиімді болды...
Dialogue: 0,0:25:31.12,0:25:34.21,Default-ja,,0,0,0,,Бірақ солай. Біз жеңілгенімізді мойындаймыз ба?
Dialogue: 0,0:25:31.16,0:25:32.52,Default,,0,0,0,,Бірақ бәрі аяқталды.
Dialogue: 0,0:25:32.79,0:25:34.26,Default,,0,0,0,,Сіз бас тартасыз ...
Dialogue: 0,0:25:34.29,0:25:37.63,Default,,0,0,0,,әйтпесе иығыңды жұлып аламын.
Dialogue: 0,0:25:34.33,0:25:37.96,Default-ja,,0,0,0,,Әлде менің иық буыным осылай жойыла ма?
Dialogue: 0,0:25:38.46,0:25:39.46,Default-ja,,0,0,0,,Таңда
Dialogue: 0,0:25:38.50,0:25:39.40,Default,,0,0,0,,Бұл сіздің таңдауыңыз.
Dialogue: 0,0:25:44.34,0:25:45.93,Default-ja,,0,0,0,,Бастаманың соңы және соңының басы
Dialogue: 0,0:25:44.54,0:25:45.84,Default,,0,0,0,,Ей, сұмдық!
Dialogue: 0,0:25:48.81,0:25:52.06,Default-ja,,0,0,0,,Жарайды, мен саған қарап тұрмын!
Dialogue: 0,0:25:49.84,0:25:51.90,Default,,0,0,0,,О, адам! Ол есегін тепті!
Dialogue: 0,0:26:02.53,0:26:05.07,Default-ja,,0,0,0,,Енді сен менікісің
Dialogue: 0,0:26:02.56,0:26:04.75,Default,,0,0,0,,Ал енді сен менікісің.
Dialogue: 0,0:26:13.87,0:26:15.33,Default-ja,,0,0,0,,Мен бұлай айтқан емеспін
Dialogue: 0,0:26:13.90,0:26:15.27,Default,,0,0,0,,Ол ешқашан ешкімге бұлай айтқан емес!
Dialogue: 0,0:26:15.54,0:26:18.40,Default,,0,0,0,,Гриффит ешқашан ешкімге бұлай айтқан емес!
Dialogue: 0,0:26:15.54,0:26:18.59,Default-ja,,0,0,0,,Гриффит ешқашан ешкімге бұлай айтқан емес.
Dialogue: 0,0:26:29.38,0:26:32.55,Default,,0,0,0,,Енді мен Сұңқар тобындамын.
Dialogue: 0,0:26:29.43,0:26:32.64,Default-ja,,0,0,0,,Бұл менің де Hawk тобының мүшесі екенімді білдіре ме?
Dialogue: 0,0:26:34.29,0:26:37.12,Default,,0,0,0,,Ішім, мен сені ұрыстырып алайын...
Dialogue: 0,0:26:34.35,0:26:37.27,Default-ja,,0,0,0,,Ішегім мен саған жұмыс беремін.
Dialogue: 0,0:26:38.29,0:26:40.42,Default,,0,0,0,,Менің жүрегіме қымбат нәрсе үшін.
Dialogue: 0,0:26:38.36,0:26:40.48,Default-ja,,0,0,0,,Менің қымбат заттарым үшін
Dialogue: 0,0:26:45.23,0:26:47.76,Default,,0,0,0,,Мен өз патшалығымды аламын.
Dialogue: 0,0:26:45.28,0:26:47.95,Default-ja,,0,0,0,,Мен елімді аламын
Dialogue: 0,0:26:51.41,0:26:54.75,Default-ja,,0,0,0,,Ішек, қай жерде өлетініңді мен шешемін.
Dialogue: 0,0:26:51.47,0:26:54.60,Default,,0,0,0,,Ішек. Қай жерде өлетініңді мен шешемін.
Dialogue: 0,0:27:23.61,0:27:24.82,Default-ja,,0,0,0,,Қатарларды бұзбаңыз!
Dialogue: 0,0:27:23.87,0:27:25.00,Default,,0,0,0,,Қатарларыңызды ұстаңыздар!
Dialogue: 0,0:27:25.28,0:27:29.07,Default-ja,,0,0,0,,Тюдор иттеріне біз Мидлендтерді мақтан тұтамыз...
Dialogue: 0,0:27:25.37,0:27:29.07,Default,,0,0,0,,Мына Чудер иттеріне Мидлендтердің неден жасалғанын көрсетіңіз!
Dialogue: 0,0:27:41.04,0:27:43.88,Default-ja,,0,0,0,,Маған қашып кетуіме жол берме! Қозғалатынның бәрін өлтіріңіз
Dialogue: 0,0:27:41.15,0:27:44.02,Default,,0,0,0,,Олардың қашып кетуіне жол берме! Қозғалатын кез келген нәрсені өлтіріңіз!
Dialogue: 0,0:28:02.69,0:28:08.28,Default-ja,,0,0,0,,Жау: Қара қой темір найза ауыр атты әскер корпусының қаһарлы күші қорқынышты. Әскерімізге келген шығын орасан зор.
Dialogue: 0,0:28:02.78,0:28:08.24,Default,,0,0,0,,Олардың қара қошқарлы темір найзасының ауыр атты әскері үлкен зиян келтіруде!
Dialogue: 0,0:28:08.86,0:28:11.66,Default-ja,,0,0,0,,Іс осылай жалғаса берсе, тіпті негізгі лагерь де қауіпті болады.
Dialogue: 0,0:28:08.92,0:28:11.68,Default,,0,0,0,,Бұл жағдайда тіпті біздің штаб-пәтерге де қауіп төнуі мүмкін!
Dialogue: 0,0:28:18.49,0:28:20.32,Default,,0,0,0,,Ешкім жоқ па...
Dialogue: 0,0:28:18.54,0:28:20.38,Default-ja,,0,0,0,,Сіз...
Dialogue: 0,0:28:21.71,0:28:25.05,Default-ja,,0,0,0,,Тюдорлық қара шайтанды жеңген адам...
Dialogue: 0,0:28:21.80,0:28:24.92,Default,,0,0,0,,Сол Чудердің қара шайтандарын кім тоқтата алады?
Dialogue: 0,0:28:25.71,0:28:26.80,Default-ja,,0,0,0,,(Медбике) Каори-чан, дайынсың ба?
Dialogue: 0,0:28:25.73,0:28:26.79,Default,,0,0,0,,Алға!
Dialogue: 0,0:28:26.83,0:28:28.93,Default,,0,0,0,,Қара қошқар Темір найзаның ауыр атты әскері
Dialogue: 0,0:28:26.92,0:28:32.05,Default-ja,,0,0,0,,Мидленд патшасының басын қара қой темір найзасының ауыр атты әскері басып алады!
Dialogue: 0,0:28:28.97,0:28:31.84,Default,,0,0,0,,Мидленд королінің басын алады!
Dialogue: 0,0:28:36.31,0:28:41.60,Default-ja,,0,0,0,,Иә? Ақымақ, сен бізге қарсы жүгіресің!
Dialogue: 0,0:28:37.81,0:28:38.94,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:28:38.98,0:28:41.41,Default,,0,0,0,,Бір адам бәрімізге қарсы ма?
Dialogue: 0,0:28:45.40,0:28:48.40,Default-ja,,0,0,0,,Жарайды, мен сені талқандаймын!
Dialogue: 0,0:28:45.45,0:28:48.29,Default,,0,0,0,,Жарайсыңдар! Мен оның үстінен өтемін!
Dialogue: 0,0:29:01.75,0:29:05.13,Default-ja,,0,0,0,,Бір ғана қылышпен, ақымақ генерал Гильен...
Dialogue: 0,0:29:01.77,0:29:05.07,Default,,0,0,0,,- Ол генерал Гиенді өлтірді! - Бір соққымен, өзімен!
Dialogue: 0,0:29:12.09,0:29:14.47,Default-ja,,0,0,0,,Бір ғана жау бар, оны қоршап ал!
Dialogue: 0,0:29:12.11,0:29:14.34,Default,,0,0,0,,Ол жалғыз! Оны қоршаңыз!
Dialogue: 0,0:29:14.71,0:29:15.84,Default,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:29:14.76,0:29:15.85,Default-ja,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:29:17.18,0:29:18.31,Default-ja,,0,0,0,,Не?
Dialogue: 0,0:29:17.22,0:29:18.21,Default,,0,0,0,,Дұрыс емес пе, Ято-но-ками?
Dialogue: 0,0:29:18.82,0:29:20.29,Default,,0,0,0,,Артынан!
Dialogue: 0,0:29:18.89,0:29:20.48,Default-ja,,0,0,0,,Артынан?
Dialogue: 0,0:29:21.45,0:29:22.72,Default,,0,0,0,,Мен сенің дірілдеп тұрған жеріңе асығып барамын
Dialogue: 0,0:29:21.48,0:29:22.56,Default-ja,,0,0,0,,Бұл...
Dialogue: 0,0:29:23.22,0:29:24.32,Default,,0,0,0,,Сұңқар тобы!
Dialogue: 0,0:29:23.27,0:29:24.40,Default-ja,,0,0,0,,Сұңқарлар тобы!
Dialogue: 0,0:29:40.29,0:29:42.46,Default-ja,,0,0,0,,Ұрыс даласындағы өлім құдайлары!
Dialogue: 0,0:29:40.41,0:29:42.43,Default,,0,0,0,,Ұрыс даласының қасіретшілері!
Dialogue: 0,0:29:44.18,0:29:47.08,Default,,0,0,0,,Неліктен олар Мидленд үшін соғысып жатыр?!
Dialogue: 0,0:29:44.25,0:29:47.21,Default-ja,,0,0,0,,Неліктен олар Мидленд армиясына қосылды...
Dialogue: 0,0:29:52.13,0:29:54.51,Default-ja,,0,0,0,,Тюдорлар шегінді.
Dialogue: 0,0:29:52.22,0:29:54.38,Default,,0,0,0,,Чудер шегініп бара жатыр.
Dialogue: 0,0:29:54.95,0:29:56.11,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:29:54.97,0:29:59.22,Default-ja,,0,0,0,,Бір ақымақ жалдамалы топ соғыстың толқынын өзгертуі мүмкін...
Dialogue: 0,0:29:56.16,0:29:59.02,Default,,0,0,0,,Жалдамалылардың бір тобы бүкіл шайқастың толқынын өзгерте алмайды!
Dialogue: 0,0:29:59.47,0:30:02.56,Default-ja,,0,0,0,,Сұңқарлар тобы... соншалықты
Dialogue: 0,0:29:59.53,0:30:02.43,Default,,0,0,0,,Бұл «Сұңқар тобы» күшті ме?
Dialogue: 0,0:30:02.69,0:30:05.65,Default-ja,,0,0,0,,Иә, бұл келісім-шартқа тұрарлық еді.
Dialogue: 0,0:30:02.70,0:30:05.82,Default,,0,0,0,,Иә. Олар бағаға лайықты болды.
Dialogue: 0,0:30:05.77,0:30:08.73,Default-ja,,0,0,0,,Хмф, бұл күтпеген шабуыл болды.
Dialogue: 0,0:30:06.43,0:30:10.33,Default,,0,0,0,,Бір тосын шабуылға тым көп қор қоймаңыз.
Dialogue: 0,0:30:08.86,0:30:10.44,Default-ja,,0,0,0,,Ол сатып алу деп аталады.
Dialogue: 0,0:30:10.57,0:30:14.63,Default,,0,0,0,,Бірақ олар қара қошқарларды жеңді, бірақ біз жеңе алмадық.
Dialogue: 0,0:30:10.57,0:30:14.45,Default-ja,,0,0,0,,Бірақ жеңе алмаған қара қойды жеңгеніміз рас.
Dialogue: 0,0:30:14.82,0:30:19.16,Default-ja,,0,0,0,,Одан кейінгі шабуылдың айқындығы, жаудың қимылын толық оқитын стратегия...
Dialogue: 0,0:30:14.94,0:30:21.04,Default,,0,0,0,,Және олардың шабуылының кереметтігі. және олар жауды қалай күтті ...
Dialogue: 0,0:30:19.29,0:30:21.08,Default-ja,,0,0,0,,Екеуі де... ой
Dialogue: 0,0:30:22.83,0:30:25.46,Default-ja,,0,0,0,,Олардың басшысы не деді?
Dialogue: 0,0:30:22.85,0:30:25.51,Default,,0,0,0,,Оларды кім басқарады?
Dialogue: 0,0:30:25.99,0:30:27.71,Default,,0,0,0,,Оны Гриффит деп атайды. сэр.
Dialogue: 0,0:30:26.00,0:30:28.42,Default-ja,,0,0,0,,Менің атым Гриффит, Мәртебелі.
Dialogue: 0,0:30:29.34,0:30:30.92,Default-ja,,0,0,0,,Гриффит…
Dialogue: 0,0:30:29.49,0:30:30.75,Default,,0,0,0,,«Гриффит»?
Dialogue: 0,0:30:51.57,0:30:52.53,Default-ja,,0,0,0,,Аура Аура
Dialogue: 0,0:30:52.65,0:30:54.20,Default-ja,,0,0,0,,Ішім!
Dialogue: 0,0:30:52.68,0:30:53.94,Default,,0,0,0,,Ішім!
Dialogue: 0,0:30:58.45,0:31:00.58,Default-ja,,0,0,0,,Бұл таңқаларлық болды, Гутс.
Dialogue: 0,0:30:58.48,0:31:00.28,Default,,0,0,0,,Бұл керемет болды!
Dialogue: 0,0:31:01.16,0:31:04.12,Default-ja,,0,0,0,,Бұл тым керемет, жалғыз ат жарысы.
Dialogue: 0,0:31:01.19,0:31:03.95,Default,,0,0,0,,Тым салқын, мүмкін, ол жерде жалғыз жүру.
Dialogue: 0,0:31:04.22,0:31:07.66,Default,,0,0,0,,Кешіріңіз. Мен оларды жалғыз айыптамауым керек еді.
Dialogue: 0,0:31:04.25,0:31:07.75,Default-ja,,0,0,0,,Өкініштісі, мен ғана рұқсатсыз қашып кеттім.
Dialogue: 0,0:31:09.36,0:31:12.06,Default,,0,0,0,,Өкініп қалғандай!
Dialogue: 0,0:31:09.38,0:31:12.13,Default-ja,,0,0,0,,Ке, сен бір нәрсеге өкінетін адамсың ба?
Dialogue: 0,0:31:12.26,0:31:15.47,Default-ja,,0,0,0,,Дұрыс, бұл капитанға ұқсамайды.
Dialogue: 0,0:31:12.27,0:31:15.20,Default,,0,0,0,,Иә! Бұл капитанға ұқсамайды.
Dialogue: 0,0:31:21.97,0:31:25.73,Default-ja,,0,0,0,,Біз бәрібір жеңдік, ендеше тойлайық.
Dialogue: 0,0:31:22.01,0:31:25.81,Default,,0,0,0,,Қалай болғанда да, біз жеңдік. тойлайық.
Dialogue: 0,0:31:25.85,0:31:29.31,Default-ja,,0,0,0,,Солай етейік, бәріміз тост айтайық.
Dialogue: 0,0:31:25.91,0:31:29.21,Default,,0,0,0,,Иә! Бір тост ішейік!
Dialogue: 0,0:31:29.44,0:31:32.40,Default-ja,,0,0,0,,Бұл әйел. Мені әйел деп ата! (Мүше) Мен бүгін кешке мас боламын!
Dialogue: 0,0:31:32.45,0:31:35.15,Default,,0,0,0,,Олай болса артымнан ер!
Dialogue: 0,0:31:32.53,0:31:35.07,Default-ja,,0,0,0,,Жарайды, менің артымнан жүр.
Dialogue: 0,0:31:35.29,0:31:36.92,Default,,0,0,0,,Неліктен Коркус?
Dialogue: 0,0:31:35.32,0:31:36.74,Default-ja,,0,0,0,,Неліктен Коркус басқарады?
Dialogue: 0,0:31:36.86,0:31:39.07,Default-ja,,0,0,0,,Ең бастысы - ішек-қарын. Ережелерді орындайық.
Dialogue: 0,0:31:36.96,0:31:39.02,Default,,0,0,0,,Ұлы ерлік жасаған Гуц еді!
Dialogue: 0,0:31:39.16,0:31:40.22,Default,,0,0,0,,Ішім!
Dialogue: 0,0:31:39.20,0:31:40.32,Default-ja,,0,0,0,,Ішек
Dialogue: 0,0:31:41.12,0:31:44.58,Default-ja,,0,0,0,,Менің айтарым бар. Сіз маған бір сәтке бетіңізді бере аласыз ба?
Dialogue: 0,0:31:41.16,0:31:44.53,Default,,0,0,0,,Мен сенімен сөйлесуім керек. Маған бір минут бересіз бе?
Dialogue: 0,0:31:44.66,0:31:46.33,Default,,0,0,0,,«Капитан Гутс, сэр»?
Dialogue: 0,0:31:44.70,0:31:46.66,Default-ja,,0,0,0,,Капитан Гутс
Dialogue: 0,0:31:54.42,0:31:56.26,Default-ja,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:31:54.47,0:31:56.17,Default,,0,0,0,,Бұл не туралы болды?
Dialogue: 0,0:31:56.76,0:31:57.72,Default-ja,,0,0,0,,Не?
Dialogue: 0,0:31:56.81,0:31:57.78,Default,,0,0,0,,Жер
Dialogue: 0,0:31:57.84,0:31:58.90,Default,,0,0,0,,Мылқау ойнама!
Dialogue: 0,0:31:57.84,0:31:59.05,Default-ja,,0,0,0,,Егер ойында жеңбесең
Dialogue: 0,0:31:59.15,0:32:01.98,Default,,0,0,0,,Сіз бұрыс болу керек едіңіз.
Dialogue: 0,0:31:59.18,0:32:02.10,Default-ja,,0,0,0,,Your mission should have been to keep the enemy in check.
Dialogue: 0,0:32:02.32,0:32:06.41,Default,,0,0,0,,Instead you charged them head-on by yourself.
Dialogue: 0,0:32:02.39,0:32:06.60,Default-ja,,0,0,0,,What if you throw off your allies and run single-handedly directly in front of the enemy?
Dialogue: 0,0:32:06.73,0:32:09.60,Default-ja,,0,0,0,,It's a good thing because it just happened to work out...
Dialogue: 0,0:32:06.79,0:32:09.48,Default,,0,0,0,,Бұл жолы жақсы шықты.
Dialogue: 0,0:32:09.77,0:32:14.69,Default-ja,,0,0,0,,Your actions could endanger the entire Band of the Hawk.
Dialogue: 0,0:32:09.82,0:32:14.35,Default,,0,0,0,,but you could have put the entire Band of the Hawk in danger.
Dialogue: 0,0:32:15.36,0:32:18.07,Default-ja,,0,0,0,,Өз ұстанымыңызды аздап біліп алыңыз!
Dialogue: 0,0:32:15.46,0:32:17.76,Default,,0,0,0,,Өз орныңызды есте сақтаңыз.
Dialogue: 0,0:32:18.86,0:32:21.87,Default-ja,,0,0,0,,Бұл жаман болды. Мен қазірден бастап мұқият боламын.
Dialogue: 0,0:32:18.90,0:32:21.66,Default,,0,0,0,,Кешіріңіз. Мен мұны есте сақтаймын.
Dialogue: 0,0:32:22.33,0:32:24.41,Default-ja,,0,0,0,,Хмф... Әрқашан солай.
Dialogue: 0,0:32:23.44,0:32:24.49,Default,,0,0,0,,Бұл әрқашан бірдей!
Dialogue: 0,0:32:24.79,0:32:29.37,Default-ja,,0,0,0,,Just like that, you're the same as you were three years ago.
Dialogue: 0,0:32:24.84,0:32:26.57,Default,,0,0,0,,Жай сөйлес.
Dialogue: 0,0:32:26.87,0:32:29.50,Default,,0,0,0,,Үш жыл бойы өзгерген жоқсың.
Dialogue: 0,0:32:30.24,0:32:33.74,Default,,0,0,0,,You're satisfied just waving a sword around on the battlefield.
Dialogue: 0,0:32:30.29,0:32:33.92,Default-ja,,0,0,0,,I'm satisfied just swinging my sword around on the battlefield.
Dialogue: 0,0:32:34.38,0:32:38.84,Default,,0,0,0,,You're a mad dog who never thinks about your comrades one bit!
Dialogue: 0,0:32:34.46,0:32:38.93,Default-ja,,0,0,0,,He's just a mad dog who doesn't care about his friends at all.
Dialogue: 0,0:32:42.47,0:32:45.26,Default-ja,,0,0,0,,Жоқ, мен бұрынғыдай емеспін!
Dialogue: 0,0:32:42.62,0:32:45.28,Default,,0,0,0,,Сіз қателесесіз. Мен бұрынғыдай емеспін!
Dialogue: 0,0:32:47.86,0:32:49.92,Default,,0,0,0,,Мен өз жолдастарымды ойлаймын...
Dialogue: 0,0:32:47.89,0:32:49.98,Default-ja,,0,0,0,,Тіпті достарыңыз туралы...
Dialogue: 0,0:32:50.00,0:32:52.26,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:32:50.10,0:32:52.73,Default-ja,,0,0,0,,Екеуіңді де оңаша қалдыр.
Dialogue: 0,0:32:53.48,0:32:54.82,Default-ja,,0,0,0,,Гриффит
Dialogue: 0,0:32:53.50,0:32:54.59,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:32:55.27,0:32:57.74,Default-ja,,0,0,0,,Мен Гуцке жақсы нәрсе айтамын.
Dialogue: 0,0:32:55.34,0:32:57.67,Default,,0,0,0,,Мен Гуцпен сөйлесемін.
Dialogue: 0,0:33:06.15,0:33:08.17,Default,,0,0,0,,Сен оған тым оңайсың, Гриффит.
Dialogue: 0,0:33:06.16,0:33:08.41,Default-ja,,0,0,0,,Гриффит бұл жігітке тым жұмсақ.
Dialogue: 0,0:33:11.17,0:33:12.46,Default-ja,,0,0,0,,Уф
Dialogue: 0,0:33:14.42,0:33:16.82,Default,,0,0,0,,Екеуің шынымен жараспайсыңдар, солай ма?
Dialogue: 0,0:33:14.42,0:33:16.84,Default-ja,,0,0,0,,Балалар, сендер шынымен де тіл табыспайсыңдар.
Dialogue: 0,0:33:16.92,0:33:20.22,Default,,0,0,0,,Бұл мен емес. Ол әрқашан менің ісімде.
Dialogue: 0,0:33:16.96,0:33:20.51,Default-ja,,0,0,0,,Мен емес, ол жігіт үнемі мені таңдайды.
Dialogue: 0,0:33:21.86,0:33:26.30,Default,,0,0,0,,Үш жыл бойы осылай болды. Демалыңыз.
Dialogue: 0,0:33:21.88,0:33:26.43,Default-ja,,0,0,0,,Солай болса да, үш жыл болды...
Dialogue: 0,0:33:26.37,0:33:28.16,Default,,0,0,0,,Үш жыл...
Dialogue: 0,0:33:26.56,0:33:28.43,Default-ja,,0,0,0,,3 жыл...?
Dialogue: 0,0:33:28.67,0:33:32.37,Default,,0,0,0,,Иә, сен екеуміз соғысқаннан бері.
Dialogue: 0,0:33:28.68,0:33:32.52,Default-ja,,0,0,0,,Аа, мен сенімен жекпе-жекке шыққаннан бері.
Dialogue: 0,0:33:33.37,0:33:35.27,Default,,0,0,0,,Маған ұнады.
Dialogue: 0,0:33:33.52,0:33:35.65,Default-ja,,0,0,0,,Бұл жекпе-жек қызық болды.
Dialogue: 0,0:33:35.90,0:33:38.44,Default-ja,,0,0,0,,It's good to have a fight like that.
Dialogue: 0,0:33:35.98,0:33:38.10,Default,,0,0,0,,I like that kind of fight.
Dialogue: 0,0:33:43.52,0:33:48.04,Default,,0,0,0,,Кеттік. You're the man of the hour tonight.
Dialogue: 0,0:33:43.57,0:33:48.20,Default-ja,,0,0,0,,Кеттік, сен бүгінгі кешкі сусынның серігісің.
Dialogue: 0,0:33:50.16,0:33:51.35,Default,,0,0,0,,Гриффит...
Dialogue: 0,0:33:50.20,0:33:51.46,Default-ja,,0,0,0,,Гриффит…
Dialogue: 0,0:33:55.79,0:33:58.67,Default-ja,,0,0,0,,I'm sorry for today's battle.
Dialogue: 0,0:33:55.90,0:33:58.52,Default,,0,0,0,,I'm sorry... about today's battle.
Dialogue: 0,0:34:00.03,0:34:03.30,Default,,0,0,0,,Guts, fight for my sake.
Dialogue: 0,0:34:00.05,0:34:03.51,Default-ja,,0,0,0,,Ішек, сен мен үшін күресесің.
Dialogue: 0,0:34:03.88,0:34:07.05,Default-ja,,0,0,0,,Сен менікісің
Dialogue: 0,0:34:03.90,0:34:06.80,Default,,0,0,0,,Өйткені сен менікісің.
Dialogue: 0,0:34:22.29,0:34:24.59,Default,,0,0,0,,Have you heard about Lord Griffith?
Dialogue: 0,0:34:22.36,0:34:24.70,Default-ja,,0,0,0,,Did you hear about Mr. Griffith?
Dialogue: 0,0:34:24.76,0:34:27.95,Default,,0,0,0,,Yes, it is most disturbing.
Dialogue: 0,0:34:24.82,0:34:27.95,Default-ja,,0,0,0,,Yes, this is a very grave situation.
Dialogue: 0,0:34:28.06,0:34:33.59,Default,,0,0,0,,Шынында, «Сұңқырлар тобы» бізге қосылғаннан бері жеңілген жоқпыз, бірақ...
Dialogue: 0,0:34:28.08,0:34:31.37,Default-ja,,0,0,0,,Шынында да, «Сұңқар тобы» біздің армияға қосылғаннан бері...
Dialogue: 0,0:34:31.50,0:34:33.75,Default-ja,,0,0,0,,Although it's a consecutive victory...
Dialogue: 0,0:34:33.67,0:34:38.00,Default,,0,0,0,,Олар сатып алуға болатын адам басқаратын жалдамалылар.
Dialogue: 0,0:34:33.87,0:34:38.21,Default-ja,,0,0,0,,Өйткені, мен жалдамалымын, мен қызмет ететін қожайын да ақшаға байланысты.
Dialogue: 0,0:34:39.00,0:34:42.30,Default-ja,,0,0,0,,Соғыс болмаса, жалдамалылар ұрылардан артық емес.
Dialogue: 0,0:34:39.01,0:34:42.24,Default,,0,0,0,,Соғыссыз. they are nothing but bandits.
Dialogue: 0,0:34:42.42,0:34:45.59,Default-ja,,0,0,0,,Unnecessarily elevating such people...
Dialogue: 0,0:34:42.58,0:34:45.64,Default,,0,0,0,,Рифф-рафты осылай көтеру үшін...
Dialogue: 0,0:34:45.71,0:34:48.04,Default,,0,0,0,,Иә. The low-born are low-born.
Dialogue: 0,0:34:45.72,0:34:48.10,Default-ja,,0,0,0,,Сол жақ, төменгі деңгей төменгі деңгей
Dialogue: 0,0:34:48.38,0:34:51.35,Default,,0,0,0,,Оларға басқа нәрсе ретінде қараудан жақсы ештеңе болмайды.
Dialogue: 0,0:34:48.47,0:34:51.47,Default-ja,,0,0,0,,Егер сіз басқаша әрекет етсеңіз, сіз қиындыққа тап боласыз ...
Dialogue: 0,0:34:51.60,0:34:53.85,Default-ja,,0,0,0,,Бірақ егер сіз оларды жұмысқа алмасаңыз...
Dialogue: 0,0:34:51.68,0:34:56.92,Default,,0,0,0,,Бірақ оларсыз Чудер бізді осы уақытқа дейін жойып жіберуі мүмкін еді.
Dialogue: 0,0:34:53.98,0:34:56.98,Default-ja,,0,0,0,,Тюдорлар бізге шабуыл жасап, жойылуы мүмкін.
Dialogue: 0,0:34:57.10,0:35:02.40,Default-ja,,0,0,0,,Хм, сондықтан мен Мәртебелі мырзаның араласуын түсіне алмаймын.
Dialogue: 0,0:34:58.09,0:35:02.39,Default,,0,0,0,,Мен ұлы мәртебелі мырзаның осыншама қиындыққа неге барғанын түсінемін...
Dialogue: 0,0:35:02.53,0:35:04.78,Default-ja,,0,0,0,,Бірақ бұл ... дегенді білдірмейді.
Dialogue: 0,0:35:02.60,0:35:04.72,Default,,0,0,0,,Бірақ бәрібір...
Dialogue: 0,0:35:04.95,0:35:09.58,Default-ja,,0,0,0,,Сол мырза... Бұл қарапайым адамды ақсүйектерге айналдыра аласыз деген сөз емес.
Dialogue: 0,0:35:05.03,0:35:09.40,Default,,0,0,0,,Иә. бірақ бәрібір. Қарапайым адамды тектілікке тәрбиелеу...
Dialogue: 0,0:35:09.67,0:35:11.97,Default,,0,0,0,,Бұл ұлы мәртебелілердің эксцентрлік таңдауы.
Dialogue: 0,0:35:09.74,0:35:12.24,Default-ja,,0,0,0,,Мәртебелі де тым мас.
Dialogue: 0,0:35:13.83,0:35:17.92,Default-ja,,0,0,0,,Соңғы шайқаста Сұңқар тобы алға шықты.
Dialogue: 0,0:35:14.01,0:35:17.91,Default,,0,0,0,,Олар соңғы шайқаста Сұңқар тобы біздің әскерлерді басқарды дейді.
Dialogue: 0,0:35:18.04,0:35:22.30,Default-ja,,0,0,0,,Мәртебелі Юлийдің ақ айдаһар рыцарлары туралы не деуге болады?
Dialogue: 0,0:35:18.08,0:35:22.17,Default,,0,0,0,,Then what of Count Julius and his White Dragon Knights?
Dialogue: 0,0:35:22.42,0:35:24.04,Default,,0,0,0,,Ол жеңілдеп жатыр.
Dialogue: 0,0:35:22.42,0:35:24.13,Default-ja,,0,0,0,,Ол қызметінен босатылды...
Dialogue: 0,0:35:24.18,0:35:29.25,Default,,0,0,0,,Чудер оны тұтқынға алған кезде төлем өте жоғары болды...
Dialogue: 0,0:35:24.26,0:35:26.76,Default-ja,,0,0,0,,When your Royal Highness was taken prisoner by the Tudors...
Dialogue: 0,0:35:26.88,0:35:29.47,Default-ja,,0,0,0,,Үлкен төлемге келетін болсақ...
Dialogue: 0,0:35:35.23,0:35:36.19,Default-ja,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:35:46.11,0:35:48.23,Default,,0,0,0,,Жау графы өлді.
Dialogue: 0,0:35:46.15,0:35:51.66,Default-ja,,0,0,0,,The enemy Lord Fordyce has been killed, and Guts' squad is still suppressing the remnants.
Dialogue: 0,0:35:48.34,0:35:51.50,Default,,0,0,0,,Gut's Raiders are still mopping up the resistance.
Dialogue: 0,0:35:51.78,0:35:54.83,Default-ja,,0,0,0,,Хмм, бұл мен үшін әдеттен тыс.
Dialogue: 0,0:35:53.15,0:35:54.77,Default,,0,0,0,,That's unusual for it to be taking so long.
Dialogue: 0,0:35:55.45,0:35:57.67,Default-ja,,0,0,0,,I don't think it's that much of a castle...
Dialogue: 0,0:35:55.52,0:35:57.51,Default,,0,0,0,,Мен бұл қамалды алу қиын болады деп ойламадым.
Dialogue: 0,0:36:01.96,0:36:04.30,Default-ja,,0,0,0,,Why didn't you let me know sooner?
Dialogue: 0,0:36:02.05,0:36:04.22,Default,,0,0,0,,Неге ертерек хабар бермедің?!
Dialogue: 0,0:36:04.42,0:36:05.55,Default-ja,,0,0,0,,Бұл...
Dialogue: 0,0:36:04.46,0:36:08.55,Default,,0,0,0,,Біреу қамалдың тереңінде қазына бар деді.
Dialogue: 0,0:36:05.67,0:36:10.18,Default-ja,,0,0,0,,Someone said there was a treasure down here, so...
Dialogue: 0,0:36:08.96,0:36:12.62,Default,,0,0,0,,Содан кейін біз айқай ести бастадық...
Dialogue: 0,0:36:10.30,0:36:12.64,Default-ja,,0,0,0,,Артқы жақтан бірінен соң бірі айқай естідім.
Dialogue: 0,0:36:12.76,0:36:14.39,Default-ja,,0,0,0,,Those who went to check on the situation...
Dialogue: 0,0:36:13.00,0:36:14.43,Default,,0,0,0,,Ешкім шықпады.
Dialogue: 0,0:36:15.27,0:36:16.50,Default,,0,0,0,,Жетеді! Мен барып көрейін.
Dialogue: 0,0:36:15.35,0:36:16.64,Default-ja,,0,0,0,,Жетеді! мен барамын
Dialogue: 0,0:36:16.77,0:36:17.89,Default-ja,,0,0,0,,Гастонды босат!
Dialogue: 0,0:36:16.80,0:36:17.89,Default,,0,0,0,,Жібер, Гастон!
Dialogue: 0,0:36:18.06,0:36:21.15,Default-ja,,0,0,0,,Ал, генерал Гриффитке қолдау көрсетейік...
Dialogue: 0,0:36:18.24,0:36:21.00,Default,,0,0,0,,We should go ask General Griffith for reinforcements.
Dialogue: 0,0:36:21.61,0:36:24.82,Default-ja,,0,0,0,,Осыны байқап көріңіз! Мен сені өлтіремін!
Dialogue: 0,0:36:21.71,0:36:24.30,Default,,0,0,0,,Мұны істе, мен сені өлтіремін!
Dialogue: 0,0:36:25.07,0:36:26.03,Default-ja,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:36:25.14,0:36:26.01,Default,,0,0,0,,Капитан!
Dialogue: 0,0:36:26.11,0:36:27.41,Default,,0,0,0,,Менің артымнан ерме!
Dialogue: 0,0:36:26.15,0:36:27.65,Default-ja,,0,0,0,,Ешкімнің артыңыздан еруіне жол бермеңіз
Dialogue: 0,0:37:10.36,0:37:12.99,Default-ja,,0,0,0,,Бұл не... мәйіт?
Dialogue: 0,0:37:10.42,0:37:12.91,Default,,0,0,0,,Бұл мәйіттерге не болды?
Dialogue: 0,0:37:15.53,0:37:16.95,Default-ja,,0,0,0,,Гяаааа...
Dialogue: 0,0:37:40.09,0:37:41.18,Default,,0,0,0,,Сен өткенде жақсы нәтиже көрсеттің, сондықтан оны қалай жасау керектігін үйренуге дайынсың деп ойлаймын.
Dialogue: 0,0:37:40.10,0:37:42.52,Default-ja,,0,0,0,,Не? Бұл...
Dialogue: 0,0:37:41.32,0:37:42.48,Default,,0,0,0,,бұл?!
Dialogue: 0,0:37:44.61,0:37:46.36,Default-ja,,0,0,0,,Өлмейтін зод?
Dialogue: 0,0:37:44.66,0:37:46.25,Default,,0,0,0,,Носферату Зодд?
Dialogue: 0,0:37:46.46,0:37:50.95,Default,,0,0,0,,Иә. it looks like he's on the enemy's side in this battle.
Dialogue: 0,0:37:46.48,0:37:51.07,Default-ja,,0,0,0,,Әй, бұл шайқаста жау жағына қосылып жатқан сияқты.
Dialogue: 0,0:37:51.20,0:37:54.26,Default,,0,0,0,,Зодд, аңызға айналған қылышшыны айтып тұрсыз ба?
Dialogue: 0,0:37:51.20,0:37:54.49,Default-ja,,0,0,0,,Зод сол аты аңызға айналған жалдамалы ма?
Dialogue: 0,0:37:54.57,0:37:58.44,Default,,0,0,0,,Ол алған бастармен бүкіл елді толтыруға болады дейді.
Dialogue: 0,0:37:54.62,0:37:58.70,Default-ja,,0,0,0,,Әй, ол берген бастың саны ел болады.
Dialogue: 0,0:37:58.80,0:38:02.37,Default,,0,0,0,,Ол күшті болғандықтан ғана қорықпайды.
Dialogue: 0,0:37:58.87,0:38:02.62,Default-ja,,0,0,0,,Зод күшті болғандықтан ғана қорқады.
Dialogue: 0,0:38:03.71,0:38:07.48,Default,,0,0,0,,Оның шайқастағы жетістіктері туралы ертегілер 200 жыл бұрын басталады.
Dialogue: 0,0:38:03.75,0:38:07.67,Default-ja,,0,0,0,,Оның ерлігі туралы әңгіме екі жүз жылдан бері айтылып келеді.
Dialogue: 0,0:38:09.78,0:38:11.34,Default,,0,0,0,,200 жыл?!
Dialogue: 0,0:38:09.84,0:38:11.55,Default-ja,,0,0,0,,Екі жүз жыл...
Dialogue: 0,0:38:11.67,0:38:15.59,Default-ja,,0,0,0,,Сондықтан Зод өлмес деп аталады.
Dialogue: 0,0:38:11.72,0:38:15.65,Default,,0,0,0,,Сондықтан оны Носферату Зодд деп атайды.
Dialogue: 0,0:38:16.09,0:38:18.28,Default,,0,0,0,,Ол күшті! Тым күшті!
Dialogue: 0,0:38:16.10,0:38:18.35,Default-ja,,0,0,0,,Күшті... тым күшті
Dialogue: 0,0:38:21.23,0:38:26.22,Default,,0,0,0,,Жақсы істедің, балам, маған қарсы тұру үшін осынша уақыт.
Dialogue: 0,0:38:21.31,0:38:26.61,Default-ja,,0,0,0,,Өте жақсы, балам. Мен сенің семсерімді осыншама жерге апарамын деп ойламаппын.
Dialogue: 0,0:38:26.97,0:38:28.43,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:38:26.98,0:38:28.32,Default-ja,,0,0,0,,Мен көремін.
Dialogue: 0,0:38:31.54,0:38:34.27,Default,,0,0,0,,Сонда тек қылыштар біркелкі, иә?
Dialogue: 0,0:38:31.57,0:38:34.24,Default-ja,,0,0,0,,Егер бұл жай ғана қылыш болса, олар біркелкі сәйкес келеді ме?
Dialogue: 0,0:38:37.32,0:38:38.87,Default-ja,,0,0,0,,Хо…
Dialogue: 0,0:39:00.68,0:39:02.68,Default-ja,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:39:00.73,0:39:02.72,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:39:02.89,0:39:05.98,Default-ja,,0,0,0,,Мен ол қылышты көздеп отыр деп ойламадым.
Dialogue: 0,0:39:02.90,0:39:05.80,Default,,0,0,0,,Сен менің қылышымды көздедің.
Dialogue: 0,0:39:06.67,0:39:12.30,Default,,0,0,0,,Сен маған қылыштарын қаққан бірінші адамсың!
Dialogue: 0,0:39:06.69,0:39:12.23,Default-ja,,0,0,0,,Сіз менің денеме осылай терең семсер қаққан бірінші адамсыз.
Dialogue: 0,0:39:17.36,0:39:19.41,Default-ja,,0,0,0,,Мен қуаныштымын
Dialogue: 0,0:39:17.48,0:39:19.51,Default,,0,0,0,,Мен ризамын.
Dialogue: 0,0:39:19.53,0:39:22.87,Default-ja,,0,0,0,,Өзің сияқты жауды қарсы алу үшін...
Dialogue: 0,0:39:19.62,0:39:22.88,Default,,0,0,0,,Сен сияқты жауға қарсы тұру үшін...
Dialogue: 0,0:39:22.92,0:39:28.86,Default,,0,0,0,,осы 300 жыл бойы аман қалуымның себебі шығар!
Dialogue: 0,0:39:23.00,0:39:25.25,Default-ja,,0,0,0,,Мен соңғы үш жүз жыл болдым.
Dialogue: 0,0:39:25.54,0:39:29.00,Default-ja,,0,0,0,,Мүмкін мен көптен аман қалған шығармын
Dialogue: 0,0:39:38.89,0:39:40.01,Default-ja,,0,0,0,,Мүмкін емес
Dialogue: 0,0:39:38.97,0:39:40.06,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:39:44.56,0:39:46.77,Default-ja,,0,0,0,,Осындай құбыжық болуы керек
Dialogue: 0,0:39:44.64,0:39:46.67,Default,,0,0,0,,Мұндай құбыжық бар ма?!
Dialogue: 0,0:39:50.98,0:39:52.78,Default,,0,0,0,,Менімен күрес!
Dialogue: 0,0:39:50.98,0:39:52.86,Default-ja,,0,0,0,,Мавару үшін!
Dialogue: 0,0:39:52.95,0:39:55.22,Default,,0,0,0,,Менің көңілімді қалдырмаңыз!
Dialogue: 0,0:39:52.98,0:39:55.32,Default-ja,,0,0,0,,Мені ренжітпе
Dialogue: 0,0:39:57.74,0:39:58.78,Default-ja,,0,0,0,,Гухаа
Dialogue: 0,0:40:04.58,0:40:08.92,Default-ja,,0,0,0,,Сенің күшің осы ма?
Dialogue: 0,0:40:04.73,0:40:08.89,Default,,0,0,0,,Бар болғаны осы ма?
Dialogue: 0,0:40:09.17,0:40:14.34,Default-ja,,0,0,0,,Жоқ, мен адамға жақсы жұмыс жасадым деп айту керек пе?
Dialogue: 0,0:40:09.24,0:40:14.47,Default,,0,0,0,,Жоқ, сіз адамға жақсылық жасадыңыз деп айтуым керек.
Dialogue: 0,0:40:18.51,0:40:20.18,Default-ja,,0,0,0,,Бұл Зод па?
Dialogue: 0,0:40:18.61,0:40:20.04,Default,,0,0,0,,Бұл Зодд па?!
Dialogue: 0,0:40:22.14,0:40:24.64,Default-ja,,0,0,0,,Сақтықты түсірме, екінші ату
Dialogue: 0,0:40:22.21,0:40:24.65,Default,,0,0,0,,Зейінді болыңыз! Екінші волейбол!
Dialogue: 0,0:40:25.85,0:40:26.88,Default,,0,0,0,,Юкине-кун?
Dialogue: 0,0:40:25.85,0:40:27.02,Default-ja,,0,0,0,,Оқ жаудыр!
Dialogue: 0,0:40:37.49,0:40:42.62,Default-ja,,0,0,0,,Осы шайқасты ластағандарды кешіріңіз!
Dialogue: 0,0:40:37.50,0:40:39.02,Default,,0,0,0,,Менде бұл болмайды!
Dialogue: 0,0:40:39.20,0:40:42.69,Default,,0,0,0,,Бұл жекпе-жекті кім болсаң да, ешкім арамдамауы керек!
Dialogue: 0,0:40:46.66,0:40:48.75,Default-ja,,0,0,0,,Жоқ, қаш.
Dialogue: 0,0:40:46.67,0:40:48.73,Default,,0,0,0,,Пайдасы жоқ! Бұл жерден кет!
Dialogue: 0,0:40:53.67,0:40:56.30,Default-ja,,0,0,0,,Каска, барлығын тарт.
Dialogue: 0,0:40:53.68,0:40:56.17,Default,,0,0,0,,Каска, барлығын кетсін!
Dialogue: 0,0:41:00.63,0:41:02.64,Default-ja,,0,0,0,,Гриффит: Әлгі жігіт...?
Dialogue: 0,0:41:00.65,0:41:02.52,Default,,0,0,0,,Гриффит! Қай жерде?
Dialogue: 0,0:41:04.79,0:41:05.88,Default,,0,0,0,,Ішім!
Dialogue: 0,0:41:04.81,0:41:05.89,Default-ja,,0,0,0,,Ішек
Dialogue: 0,0:41:06.02,0:41:08.48,Default-ja,,0,0,0,,Ақымақ... неге келдің?
Dialogue: 0,0:41:06.06,0:41:08.53,Default,,0,0,0,,Идиот! Сіз мұнда не істеп жүрсіз?!
Dialogue: 0,0:41:08.59,0:41:11.93,Default,,0,0,0,,Оны біз сол құбыжықтан қашқан кезде сақтаңыз.
Dialogue: 0,0:41:08.60,0:41:12.15,Default-ja,,0,0,0,,Егер сіз шағымданатын болсаңыз, оны әлгі құбыжықтан қашқаннан кейін жасаңыз.
Dialogue: 0,0:41:12.65,0:41:14.15,Default-ja,,0,0,0,,Мавару үшін!
Dialogue: 0,0:41:12.67,0:41:14.06,Default,,0,0,0,,Менімен күрес!
Dialogue: 0,0:41:14.80,0:41:17.79,Default,,0,0,0,,Бөлшектерге бөлінгенше!
Dialogue: 0,0:41:14.82,0:41:17.99,Default-ja,,0,0,0,,Денем үзілгенше, менімен бірге
Dialogue: 0,0:41:18.28,0:41:19.49,Default-ja,,0,0,0,,Жоқ
Dialogue: 0,0:41:18.37,0:41:19.53,Default,,0,0,0,,О. боқ!
Dialogue: 0,0:41:19.91,0:41:21.24,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:41:19.95,0:41:21.32,Default-ja,,0,0,0,,Гриффит!
Dialogue: 0,0:41:23.84,0:41:24.74,Default,,0,0,0,,Сіз қозғала аласыз ба?
Dialogue: 0,0:41:23.87,0:41:24.74,Default-ja,,0,0,0,,Сіз қозғала аласыз ба?
Dialogue: 0,0:41:25.28,0:41:27.01,Default,,0,0,0,,Егер жоқ болсам. біз өлдік.
Dialogue: 0,0:41:25.33,0:41:27.08,Default-ja,,0,0,0,,Қозғалмасаң, өлтіресің.
Dialogue: 0,0:41:27.08,0:41:28.57,Default,,0,0,0,,Сол жаққа бұрылыңыз.
Dialogue: 0,0:41:27.20,0:41:28.62,Default-ja,,0,0,0,,Сіз сол жақтасыз
Dialogue: 0,0:41:28.68,0:41:29.67,Default,,0,0,0,,Жер
Dialogue: 0,0:41:28.75,0:41:29.75,Default-ja,,0,0,0,,Кеттік
Dialogue: 0,0:41:42.93,0:41:45.36,Default,,0,0,0,,Ішім! Біз оған жүгіреміз!
Dialogue: 0,0:41:43.01,0:41:45.51,Default-ja,,0,0,0,,Ішек Мен мұның бәрін бірден өткіземін.
Dialogue: 0,0:41:49.43,0:41:50.23,Default-ja,,0,0,0,,Гриффит!
Dialogue: 0,0:41:49.57,0:41:50.36,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:41:53.21,0:41:58.64,Default,,0,0,0,,Мені жаралай алатын екі адамды бір күнде кездестіремін деп ойлау үшін...
Dialogue: 0,0:41:53.35,0:41:55.94,Default-ja,,0,0,0,,Мені ренжіте алатын бұл адамға...
Dialogue: 0,0:41:56.07,0:41:58.94,Default-ja,,0,0,0,,Мен екі адам бір уақытта кездеседі деп ешқашан күтпедім.
Dialogue: 0,0:41:59.01,0:42:03.24,Default,,0,0,0,,, содан кейін екеуін де жоғалту керек.
Dialogue: 0,0:41:59.07,0:42:03.36,Default-ja,,0,0,0,,Ал сол екі адамды бір уақытта жоғалту?
Dialogue: 0,0:42:07.33,0:42:08.58,Default-ja,,0,0,0,,Тоқта!
Dialogue: 0,0:42:07.35,0:42:08.55,Default,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,0:42:08.70,0:42:10.95,Default-ja,,0,0,0,,Бұл менікі...
Dialogue: 0,0:42:08.92,0:42:10.86,Default,,0,0,0,,Ол менің...
Dialogue: 0,0:42:12.00,0:42:12.96,Default-ja,,0,0,0,,Сіз сонша жау жинап алатыныңыз шын мәнінде ауыртпалық.
Dialogue: 0,0:42:12.02,0:42:12.99,Default,,0,0,0,,менің...
Dialogue: 0,0:42:15.50,0:42:18.46,Default-ja,,0,0,0,,Қош бол, адамдар.
Dialogue: 0,0:42:15.59,0:42:19.09,Default,,0,0,0,,Қоштасу. адам!
Dialogue: 0,0:42:22.63,0:42:24.43,Default-ja,,0,0,0,,Бұл...
Dialogue: 0,0:42:22.70,0:42:24.33,Default,,0,0,0,,Бұл?!
Dialogue: 0,0:42:24.55,0:42:26.89,Default-ja,,0,0,0,,Оператордың жұмыртқасы...
Dialogue: 0,0:42:24.74,0:42:26.80,Default,,0,0,0,,Патшаның жұмыртқасы?!
Dialogue: 0,0:42:28.06,0:42:31.48,Default-ja,,0,0,0,,Неліктен бұл жерде қызыл түсті бехелит бар?
Dialogue: 0,0:42:28.11,0:42:31.47,Default,,0,0,0,,Қырмызы Бехелит мұнда не істеп жүр?
Dialogue: 0,0:42:35.81,0:42:41.49,Default-ja,,0,0,0,,Фухахаха... Түсініп тұрмын, бұл қайшылықты ма?
Dialogue: 0,0:42:37.92,0:42:41.35,Default,,0,0,0,,Түсіндім! Демек, бұл осындай қулық!
Dialogue: 0,0:42:49.24,0:42:52.33,Default-ja,,0,0,0,,Бала, бір кеңес...
Dialogue: 0,0:42:49.26,0:42:52.32,Default,,0,0,0,,Бала, мен саған ескерту беремін.
Dialogue: 0,0:42:52.45,0:42:54.92,Default-ja,,0,0,0,,Жоқ, мен оны болжаймын.
Dialogue: 0,0:42:52.46,0:42:54.76,Default,,0,0,0,,Жоқ, пайғамбарлық.
Dialogue: 0,0:42:55.46,0:43:01.26,Default-ja,,0,0,0,,Егер сіз бұл адамға шынайы дос болсаңыз...
Dialogue: 0,0:42:55.50,0:43:00.91,Default,,0,0,0,,Егер сіз бұл адамға шынайы дос болсаңыз...
Dialogue: 0,0:43:01.34,0:43:03.67,Default,,0,0,0,,назар аударыңыз.
Dialogue: 0,0:43:01.38,0:43:03.92,Default-ja,,0,0,0,,Назар аударыңыз
Dialogue: 0,0:43:04.84,0:43:07.97,Default,,0,0,0,,Оның амбициясы оның ішінде өлгенде...
Dialogue: 0,0:43:04.84,0:43:07.59,Default-ja,,0,0,0,,Бұл адамның амбициясы басылғанда -
Dialogue: 0,0:43:08.28,0:43:10.65,Default,,0,0,0,,саған өлім келеді!
Dialogue: 0,0:43:08.30,0:43:10.72,Default-ja,,0,0,0,,Өлім саған келеді
Dialogue: 0,0:43:10.85,0:43:14.43,Default-ja,,0,0,0,,Өлімнен ешқашан құтыла алмайсың!
Dialogue: 0,0:43:10.92,0:43:14.32,Default,,0,0,0,,Қашып құтыла алмайтын өлім!
Dialogue: 0,0:43:28.20,0:43:29.62,Default-ja,,0,0,0,,Бұл не?
Dialogue: 0,0:43:28.23,0:43:29.56,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:43:29.87,0:43:30.95,Default-ja,,0,0,0,,Жын?
Dialogue: 0,0:43:29.97,0:43:30.94,Default,,0,0,0,,Жын?
Dialogue: 0,0:43:32.67,0:43:33.76,Default,,0,0,0,,Ал оның Регалияларының көбі шын мәнінде Нора болып шықты.
Dialogue: 0,0:43:32.70,0:43:34.12,Default-ja,,0,0,0,,Бұл не?
Dialogue: 0,0:43:39.14,0:43:40.27,Default,,0,0,0,,Бұдан басқа...
Dialogue: 0,0:43:39.21,0:43:40.38,Default-ja,,0,0,0,,Және...
Dialogue: 0,0:43:40.55,0:43:43.61,Default,,0,0,0,,«Нағыз дос»? Мен өлемін бе?
Dialogue: 0,0:43:40.59,0:43:43.71,Default-ja,,0,0,0,,Нағыз дос? Мен өлемін бе?
Dialogue: 0,0:43:44.72,0:43:47.18,Default-ja,,0,0,0,,Түсінбедім, жер бетінде не...
Dialogue: 0,0:43:44.75,0:43:47.15,Default,,0,0,0,,Түсінбедім. Не болып жатыр?
Dialogue: 0,0:43:47.30,0:43:49.55,Default-ja,,0,0,0,,Гриффит! Мықты болыңыз
Dialogue: 0,0:43:47.32,0:43:49.29,Default,,0,0,0,,Гриффит! Менімен сөйлес!
Dialogue: 0,0:43:52.42,0:43:54.32,Default,,0,0,0,,Сен сияқты жеңілген адамға ешкім мән бермейді.
Dialogue: 0,0:43:52.43,0:43:54.39,Default-ja,,0,0,0,,Гриффит, жақсысың ба?
Dialogue: 0,0:43:54.52,0:43:55.77,Default-ja,,0,0,0,,Солай ма?
Dialogue: 0,0:43:54.53,0:43:55.58,Default,,0,0,0,,Алыс болыңыз!
Dialogue: 0,0:43:56.81,0:44:00.98,Default-ja,,0,0,0,,Бұл Гриффитпен болғанына сен кінәлісің...
Dialogue: 0,0:43:56.83,0:44:00.53,Default,,0,0,0,,Бұл Гриффитпен болғанына сен кінәлісің!
Dialogue: 0,0:44:03.03,0:44:04.65,Default-ja,,0,0,0,,Бұл сен кінәлісің!
Dialogue: 0,0:44:03.04,0:44:04.40,Default,,0,0,0,,Бұл сен кінәлісің!
Dialogue: 0,0:44:25.84,0:44:28.84,Default-ja,,0,0,0,,Сіз үш жыл бұрынғыдан мүлде өзгерген жоқсыз.
Dialogue: 0,0:44:25.92,0:44:28.52,Default,,0,0,0,,Үш жыл бойы өзгерген жоқсың.
Dialogue: 0,0:44:30.56,0:44:31.72,Default,,0,0,0,,Сен ессіз итсің!
Dialogue: 0,0:44:30.64,0:44:31.47,Default-ja,,0,0,0,,Жынды ит!
Dialogue: 0,0:44:34.22,0:44:38.35,Default-ja,,0,0,0,,Гриффитті басынан өткергеніне сен кінәлісің...
Dialogue: 0,0:44:34.30,0:44:37.96,Default,,0,0,0,,Бұл Гриффитпен болғанына сен кінәлісің!
Dialogue: 0,0:44:38.90,0:44:40.03,Default,,0,0,0,,Бұл сен кінәлісің!
Dialogue: 0,0:44:39.10,0:44:39.94,Default-ja,,0,0,0,,Бұл сен кінәлісің!
Dialogue: 0,0:44:40.56,0:44:41.81,Default-ja,,0,0,0,,Ақымақ
Dialogue: 0,0:44:40.74,0:44:41.76,Default,,0,0,0,,Қат!
Dialogue: 0,0:44:47.15,0:44:48.70,Default-ja,,0,0,0,,Бұл не, анау әуесқой?
Dialogue: 0,0:44:47.25,0:44:48.80,Default,,0,0,0,,Ол не туралы айтып тұр?! Әлгі қаншық!
Dialogue: 0,0:44:48.82,0:44:50.20,Default-ja,,0,0,0,,Бұл өрескел.
Dialogue: 0,0:44:48.85,0:44:49.94,Default,,0,0,0,,Бұлай ренжімеңіз.
Dialogue: 0,0:44:53.37,0:44:55.66,Default-ja,,0,0,0,,Менен әлдеқайда ауыр соққы алсаң да.
Dialogue: 0,0:44:53.45,0:44:55.55,Default,,0,0,0,,Менен де қатты қиналдың.
Dialogue: 0,0:44:56.08,0:44:59.08,Default-ja,,0,0,0,,Ол өте қатал жігіт.
Dialogue: 0,0:44:56.09,0:44:58.89,Default,,0,0,0,,Сен қаталсың.
Dialogue: 0,0:45:01.42,0:45:03.34,Default-ja,,0,0,0,,Носферату Зод?
Dialogue: 0,0:45:01.49,0:45:03.02,Default,,0,0,0,,Носферату Зодд?
Dialogue: 0,0:45:04.33,0:45:08.60,Default,,0,0,0,,Мына дүниеде сондай құбыжық? Бұл ауыр.
Dialogue: 0,0:45:04.34,0:45:08.63,Default-ja,,0,0,0,,Мұндай құбыжықтың шынымен бар екені қызық.
Dialogue: 0,0:45:09.05,0:45:10.68,Default-ja,,0,0,0,,Бірақ керісінше қарасаңыз...
Dialogue: 0,0:45:09.07,0:45:10.76,Default,,0,0,0,,Егер сіз басқаша қарасаңыз, бұл дәлелдеу мүмкін ...
Dialogue: 0,0:45:11.13,0:45:14.26,Default-ja,,0,0,0,,Бұл дүниеде адамның ақыл-ойы жете алмайтын үлкен нәрсе бар.
Dialogue: 0,0:45:11.14,0:45:16.67,Default,,0,0,0,,біз біле алмайтын нәрсенің бар болуы.
Dialogue: 0,0:45:14.39,0:45:17.02,Default-ja,,0,0,0,,Бұл оның бар екендігінің дәлелі болуы мүмкін.
Dialogue: 0,0:45:19.39,0:45:20.81,Default-ja,,0,0,0,,Мысалы, Құдай
Dialogue: 0,0:45:19.41,0:45:20.94,Default,,0,0,0,,Құдай сияқты.
Dialogue: 0,0:45:21.48,0:45:23.24,Default,,0,0,0,,Ібіліс сияқты емес пе?
Dialogue: 0,0:45:21.48,0:45:23.31,Default-ja,,0,0,0,,Сен шайтан емессің бе?
Dialogue: 0,0:45:25.07,0:45:26.73,Default-ja,,0,0,0,,Дәл солай емес пе?
Dialogue: 0,0:45:25.08,0:45:26.64,Default,,0,0,0,,Бұл бірдей нәрсе емес пе?
Dialogue: 0,0:45:27.73,0:45:30.86,Default-ja,,0,0,0,,Айтпақшы, ылғи мойынға тағып жүретін нәрсе...
Dialogue: 0,0:45:27.82,0:45:30.76,Default,,0,0,0,,Біз мұны істеп жатқан кезде. сенің мойныңдағы нәрсе...
Dialogue: 0,0:45:35.70,0:45:39.41,Default-ja,,0,0,0,,Әлгі құбыжық мен көргенде ұшып кетті.
Dialogue: 0,0:45:35.73,0:45:39.06,Default,,0,0,0,,Мұны көрген құбыжық. ол ұшып кетті.
Dialogue: 0,0:45:39.77,0:45:40.89,Default,,0,0,0,,Не болды?
Dialogue: 0,0:45:39.79,0:45:40.96,Default-ja,,0,0,0,,Не болды?
Dialogue: 0,0:45:42.17,0:45:46.87,Default,,0,0,0,,А Бехелит. Бірде бір кәрі көріпкел берді.
Dialogue: 0,0:45:42.17,0:45:47.09,Default-ja,,0,0,0,,Бехелит Баяғыда көріпкел болған кемпірден алдым.
Dialogue: 0,0:45:49.92,0:45:54.09,Default-ja,,0,0,0,,Оған ие болған адам өз еті мен қанын...
Dialogue: 0,0:45:49.98,0:45:54.34,Default,,0,0,0,,Ол дүниені иемдену оны иеленген адамның тағдыры деді
Dialogue: 0,0:45:54.26,0:45:57.43,Default-ja,,0,0,0,,Дүниені иемдену менің тағдырым
Dialogue: 0,0:45:54.38,0:45:57.04,Default,,0,0,0,,оның еті мен қанына айырбастау.
Dialogue: 0,0:46:00.10,0:46:01.98,Default-ja,,0,0,0,,Хмм... әлем.
Dialogue: 0,0:46:00.15,0:46:02.02,Default,,0,0,0,,Дүние. иә?
Dialogue: 0,0:46:14.45,0:46:15.78,Default-ja,,0,0,0,,Фу
Dialogue: 0,0:46:24.34,0:46:27.61,Default,,0,0,0,,Бұл нәрсе мені таң қалдырады! Мені олай қорқытпа.
Dialogue: 0,0:46:24.37,0:46:27.50,Default-ja,,0,0,0,,Мені қорқытпа...
Dialogue: 0,0:46:32.55,0:46:34.14,Default,,0,0,0,,Бұл ұқыпты. иә?
Dialogue: 0,0:46:32.55,0:46:34.05,Default-ja,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:46:37.72,0:46:40.64,Default-ja,,0,0,0,,Сіз туралы мұндай нәрсе өзгерген жоқ.
Dialogue: 0,0:46:37.76,0:46:40.69,Default,,0,0,0,,Сіздің бұл бөлігіңіз ешқашан өзгермейді, солай ма?
Dialogue: 0,0:46:42.81,0:46:46.31,Default-ja,,0,0,0,,Мен өзгермеймін.
Dialogue: 0,0:46:42.83,0:46:46.06,Default,,0,0,0,,Мен ешқашан өзгермеймін.
Dialogue: 0,0:46:54.14,0:46:54.94,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:46:54.15,0:46:54.95,Default-ja,,0,0,0,,Неліктен?
Dialogue: 0,0:46:57.16,0:47:00.83,Default-ja,,0,0,0,,Мен сенің қол астыңдағы қызметкерлердің бірімін, сонда сен маған көмектесуге неге келдің?
Dialogue: 0,0:46:57.21,0:46:59.37,Default,,0,0,0,,Мен жай ғана солдатпын, кем дегенде бағыныштымын.
Dialogue: 0,0:46:59.41,0:47:00.74,Default,,0,0,0,,Неге мені құтқардың?
Dialogue: 0,0:47:07.02,0:47:08.78,Default,,0,0,0,,Ешқандай себеп жоқ.
Dialogue: 0,0:47:07.13,0:47:08.84,Default-ja,,0,0,0,,Ешқандай себеп жоқ
Dialogue: 0,0:47:09.45,0:47:14.02,Default,,0,0,0,,Сен үшін өзімді қиналған сайын себеп керек пе?
Dialogue: 0,0:47:09.50,0:47:14.34,Default-ja,,0,0,0,,Сіз үшін өз денемді желіге қоюымның әр себебі үшін маған себеп керек пе?
Dialogue: 0,0:47:25.10,0:47:27.00,Default,,0,0,0,,Бұл жай ғана...
Dialogue: 0,0:47:25.56,0:47:27.23,Default-ja,,0,0,0,,(Сота) Онда менің үйіме барайық! Апама айтамын!
Dialogue: 0,0:47:27.35,0:47:30.40,Default-ja,,0,0,0,,Сіздің жарақатыңыз жақсы ма?
Dialogue: 0,0:47:27.37,0:47:30.24,Default,,0,0,0,,Жараларыңыз жазылды ма?
Dialogue: 0,0:47:30.51,0:47:31.34,Default,,0,0,0,,Мырза!
Dialogue: 0,0:47:30.52,0:47:31.32,Default-ja,,0,0,0,,Мәртебелі
Dialogue: 0,0:47:43.72,0:47:45.09,Default,,0,0,0,,Әй, іштей!
Dialogue: 0,0:47:43.75,0:47:45.21,Default-ja,,0,0,0,,Сәлеметсіздер ме?
Dialogue: 0,0:47:45.33,0:47:49.21,Default-ja,,0,0,0,,Патшаның алдында дөрекі болуың керек!
Dialogue: 0,0:47:45.49,0:47:48.95,Default,,0,0,0,,Сіз патшаның қасындасыз! Сіз құрметтемейсіз.
Dialogue: 0,0:48:00.30,0:48:03.72,Default-ja,,0,0,0,,Ең болмағанда жоғары қарашы.
Dialogue: 0,0:48:00.31,0:48:03.37,Default,,0,0,0,,Қарсы емес. Бастарыңызды көтеріңіз.
Dialogue: 0,0:48:04.93,0:48:06.06,Default-ja,,0,0,0,,Лорд Гриффитс
Dialogue: 0,0:48:05.08,0:48:10.48,Default,,0,0,0,,Граф Гриффит, сіздің «Сұңқарлар тобы» керемет жұмыс істеп жатыр.
Dialogue: 0,0:48:06.18,0:48:10.44,Default-ja,,0,0,0,,Сіздің «Сұңқарлар тобының» жұмысы әдеттегідей таң қалдырады.
Dialogue: 0,0:48:11.06,0:48:12.11,Default-ja,,0,0,0,,Кешіріңіз
Dialogue: 0,0:48:11.15,0:48:12.17,Default,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,0:48:12.23,0:48:16.19,Default-ja,,0,0,0,,Мәртебелі, жаңадан келгендер тобының жетекшісі ретінде...
Dialogue: 0,0:48:12.28,0:48:16.08,Default,,0,0,0,,Мырза, бізбен соншалықты жаңа адаммен осылай сөйлесу керек пе?
Dialogue: 0,0:48:16.32,0:48:19.07,Default-ja,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:48:16.39,0:48:18.91,Default,,0,0,0,,Неліктен жоқ?
Dialogue: 0,0:48:19.82,0:48:23.41,Default-ja,,0,0,0,,Аға вассалдардың кейбірі қарапайым халықтан шыққан.
Dialogue: 0,0:48:19.83,0:48:23.49,Default,,0,0,0,,Иә. жақсы ойламайтындар да бар
Dialogue: 0,0:48:23.53,0:48:26.22,Default,,0,0,0,,осы қарапайым туылған ерлердің.
Dialogue: 0,0:48:23.54,0:48:26.58,Default-ja,,0,0,0,,Бұған қуанбайтындар да бар екені рас.
Dialogue: 0,0:48:26.90,0:48:30.84,Default,,0,0,0,,Бірақ абырой мен мәртебе шайқаста жеңе алмайды.
Dialogue: 0,0:48:26.91,0:48:30.96,Default-ja,,0,0,0,,Бірақ сіз беделді немесе формальдылықпен шайқаста жеңе алмайсыз.
Dialogue: 0,0:48:30.94,0:48:35.77,Default,,0,0,0,,Мен сендерге үлкен үміт артамын, бәрің сияқты салт-дәстүрге бағынбаймын.
Dialogue: 0,0:48:31.17,0:48:35.96,Default-ja,,0,0,0,,Дәстүрлі емес сендерден үмітім зор.
Dialogue: 0,0:48:36.46,0:48:37.26,Default-ja,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:48:38.09,0:48:41.43,Default-ja,,0,0,0,,Рахмет. Мен сіздің сөздеріңізді бағалаймын.
Dialogue: 0,0:48:38.11,0:48:41.20,Default,,0,0,0,,Жылы сөздеріңізге ризамын.
Dialogue: 0,0:48:44.42,0:48:45.91,Default,,0,0,0,,Бұл ханым кім?
Dialogue: 0,0:48:44.47,0:48:46.06,Default-ja,,0,0,0,,Мына ханым ше?
Dialogue: 0,0:48:49.31,0:48:52.69,Default-ja,,0,0,0,,Әй, қызым Шарлотта.
Dialogue: 0,0:48:50.46,0:48:52.72,Default,,0,0,0,,Менің қызым Шарлотта.
Dialogue: 0,0:48:52.76,0:48:57.66,Default,,0,0,0,,Ол жауынгерлерді ұнатпайтынын, сыртқа сирек шығатынын айтады.
Dialogue: 0,0:48:52.81,0:48:57.94,Default-ja,,0,0,0,,Ол қатал жауынгерлерді ұнатпайтынын және сирек шыққысы келетінін айтады.
Dialogue: 0,0:48:58.07,0:49:00.11,Default-ja,,0,0,0,,О, Шарлотта
Dialogue: 0,0:48:58.76,0:49:00.16,Default,,0,0,0,,Шарлотта...
Dialogue: 0,0:49:02.95,0:49:06.83,Default-ja,,0,0,0,,Жалғыз қызым болғандықтан оны аздап бүлдірдім бе?
Dialogue: 0,0:49:03.07,0:49:06.56,Default,,0,0,0,,Ол менің жалғыз балам. Мүмкін мен оны ренжіткен шығармын.
Dialogue: 0,0:49:07.01,0:49:08.84,Default,,0,0,0,,Сіз мені кешіруіңіз керек граф Гриффит.
Dialogue: 0,0:49:07.04,0:49:09.04,Default-ja,,0,0,0,,Мені кешіріңіз, лорд Гриффитс.
Dialogue: 0,0:49:11.25,0:49:13.25,Default-ja,,0,0,0,,Кеттік, Шарлотта.
Dialogue: 0,0:49:11.28,0:49:13.24,Default,,0,0,0,,Кел, Шарлотта.
Dialogue: 0,0:49:33.94,0:49:35.27,Default-ja,,0,0,0,,Kyaah
Dialogue: 0,0:49:39.57,0:49:41.23,Default,,0,0,0,,Маған көмектес...
Dialogue: 0,0:49:39.61,0:49:41.40,Default-ja,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:49:45.53,0:49:46.74,Default-ja,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:49:45.58,0:49:46.74,Default,,0,0,0,,Онда оны киемін!
Dialogue: 0,0:49:47.24,0:49:48.91,Default-ja,,0,0,0,,сарайдың ар жағында бір жерде қабырғаның құлаған дыбысын естідім.
Dialogue: 0,0:49:47.28,0:49:48.75,Default,,0,0,0,,Сақ болыңыз.
Dialogue: 0,0:49:49.50,0:49:50.71,Default-ja,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:49:50.05,0:49:50.91,Default,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 0,0:49:55.00,0:49:58.05,Default-ja,,0,0,0,,Сіз ханшайымның денесін менсінбеуіңіз керек!
Dialogue: 0,0:49:55.02,0:49:57.99,Default,,0,0,0,,Ханшайымға қол тигізуге қалай дәтің бар!
Dialogue: 0,0:50:01.68,0:50:02.76,Default-ja,,0,0,0,,Әй, қария!
Dialogue: 0,0:50:01.73,0:50:02.79,Default,,0,0,0,,Неге, қартсың...
Dialogue: 0,0:50:05.93,0:50:09.27,Default-ja,,0,0,0,,Кешіріңіз, генерал Юлий.
Dialogue: 0,0:50:05.96,0:50:09.30,Default,,0,0,0,,Кешірім сұраймын, мырза генерал Юлиус.
Dialogue: 0,0:50:11.94,0:50:13.52,Default-ja,,0,0,0,,Сізге тек білу қажет
Dialogue: 0,0:50:11.97,0:50:13.44,Default,,0,0,0,,Түсінгенше, бәрі жақсы.
Dialogue: 0,0:50:13.64,0:50:16.70,Default,,0,0,0,,Ханшайым, сенің әкең күтіп тұр.
Dialogue: 0,0:50:13.65,0:50:16.86,Default-ja,,0,0,0,,Жүр, ханшайым, сені әкең күтіп отыр.
Dialogue: 0,0:50:18.18,0:50:20.34,Default,,0,0,0,,Келе жатыр, ағай!
Dialogue: 0,0:50:18.19,0:50:20.69,Default-ja,,0,0,0,,Бұл... Иә, ағай.
Dialogue: 0,0:50:37.54,0:50:40.05,Default-ja,,0,0,0,,Сен неге асылдың азғындығысың?
Dialogue: 0,0:50:37.60,0:50:42.36,Default,,0,0,0,,Неліктен біз осы асылдармен және олардың спортымен уақытты босқа өткізіп жатырмыз?
Dialogue: 0,0:50:40.17,0:50:42.67,Default-ja,,0,0,0,,Біз танысуымыз керек емес пе?
Dialogue: 0,0:50:43.37,0:50:44.53,Default,,0,0,0,,Бұл ақымақ.
Dialogue: 0,0:50:43.38,0:50:44.59,Default-ja,,0,0,0,,Ақымақ сияқты...
Dialogue: 0,0:50:47.11,0:50:52.10,Default,,0,0,0,,Мұның бәрі жұмыстың бір бөлігі. Және бұл ұрыс даласында болудан артық.
Dialogue: 0,0:50:47.30,0:50:49.76,Default-ja,,0,0,0,,Бұл жұмыстың бір бөлігі.
Dialogue: 0,0:50:49.89,0:50:52.48,Default-ja,,0,0,0,,Бұл ұрыс даласында болғаннан әлдеқайда жақсы, солай ма?
Dialogue: 0,0:50:53.31,0:50:57.25,Default,,0,0,0,,Жебелер жоқ, басы жарылған жоқ...
Dialogue: 0,0:50:53.35,0:50:57.40,Default-ja,,0,0,0,,Саған жебе тимейді немесе басың жарылып кетпейді.
Dialogue: 0,0:50:59.95,0:51:02.39,Default,,0,0,0,,Осы нәрсені пайдалану маған жақсырақ.
Dialogue: 0,0:51:00.03,0:51:02.57,Default-ja,,0,0,0,,Бұл маған көбірек сәйкес келеді.
Dialogue: 0,0:51:02.62,0:51:05.45,Default,,0,0,0,,Барады... қанішер жынды.
Dialogue: 0,0:51:02.69,0:51:05.66,Default-ja,,0,0,0,,Эй, өлтіруші пайда болды.
Dialogue: 0,0:51:05.82,0:51:07.02,Default,,0,0,0,,Тағы емес, Коркус!
Dialogue: 0,0:51:05.86,0:51:07.12,Default-ja,,0,0,0,,Тағы да Коркас...
Dialogue: 0,0:51:07.19,0:51:08.22,Default,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:51:07.24,0:51:08.37,Default-ja,,0,0,0,,Шу!
Dialogue: 0,0:51:08.39,0:51:12.73,Default,,0,0,0,,Аңшылықта тұрақты күзет әрқашан рыцарьларға арналған.
Dialogue: 0,0:51:08.49,0:51:12.58,Default-ja,,0,0,0,,Осы уақытқа дейін бұл аңды тек жергілікті рыцарьлар ғана күзететін.
Dialogue: 0,0:51:12.70,0:51:14.75,Default-ja,,0,0,0,,Бұл құрметті жұмыс.
Dialogue: 0,0:51:12.76,0:51:14.29,Default,,0,0,0,,Бұл құрмет!
Dialogue: 0,0:51:14.83,0:51:20.20,Default,,0,0,0,,Міне, бәріміз шайқас даласының лайында күрестік!
Dialogue: 0,0:51:14.87,0:51:17.50,Default-ja,,0,0,0,,Бұл да, бәріміз, біз ұрыс даласындамыз...
Dialogue: 0,0:51:17.63,0:51:20.34,Default-ja,,0,0,0,,Бұл балшыққа батқаны үшін несие алудың нәтижесі шығар.
Dialogue: 0,0:51:20.46,0:51:23.09,Default-ja,,0,0,0,,Бұл ақымақ сияқты ма?
Dialogue: 0,0:51:20.61,0:51:23.27,Default,,0,0,0,,Ал сен оны ақымақ дейсің бе?!
Dialogue: 0,0:51:23.21,0:51:24.55,Default-ja,,0,0,0,,Коркус
Dialogue: 0,0:51:23.31,0:51:24.37,Default,,0,0,0,,Коркус!
Dialogue: 0,0:51:24.84,0:51:26.76,Default-ja,,0,0,0,,Қылышыңды сонша айналдырғың келсе...
Dialogue: 0,0:51:25.01,0:51:29.95,Default,,0,0,0,,Қылышыңды бұлғағың келсе, жалғыз жүр, жынды!
Dialogue: 0,0:51:26.89,0:51:30.01,Default-ja,,0,0,0,,Жалғыз жаса, ақымақ.
Dialogue: 0,0:51:36.99,0:51:40.55,Default,,0,0,0,,Әрқайсысының өзінше.
Dialogue: 0,0:51:37.10,0:51:40.52,Default-ja,,0,0,0,,Менің ойымша, бұл жай ғана әдептілік.
Dialogue: 0,0:51:40.65,0:51:42.61,Default-ja,,0,0,0,,Хахаха
Dialogue: 0,0:51:41.76,0:51:42.89,Default,,0,0,0,,Олай болса, кешіріңіз.
Dialogue: 0,0:51:59.38,0:52:01.00,Default-ja,,0,0,0,,Аңшылықты жек көресіз бе?
Dialogue: 0,0:51:59.41,0:52:00.90,Default,,0,0,0,,Сіз аң аулағанды ​​ұнатпайсыз ба?
Dialogue: 0,0:52:08.09,0:52:12.93,Default-ja,,0,0,0,,Неліктен ер адамдар қан төккенді ұнатады?
Dialogue: 0,0:52:08.12,0:52:12.85,Default,,0,0,0,,Неліктен мырзалар қан төгуден рахат алады?
Dialogue: 0,0:52:13.06,0:52:14.10,Default-ja,,0,0,0,,Соғыс және аңшылық...
Dialogue: 0,0:52:13.09,0:52:14.82,Default,,0,0,0,,Соғыста, аңшылықта...
Dialogue: 0,0:52:19.98,0:52:21.23,Default-ja,,0,0,0,,Жақсы
Dialogue: 0,0:52:20.07,0:52:21.26,Default,,0,0,0,,О, менің!
Dialogue: 0,0:52:28.99,0:52:31.83,Default-ja,,0,0,0,,Ханшайым, міне... осылай
Dialogue: 0,0:52:29.11,0:52:31.41,Default,,0,0,0,,Мәртебелі, осылай...
Dialogue: 0,0:52:51.83,0:52:52.80,Default,,0,0,0,,Жалпы...
Dialogue: 0,0:52:51.85,0:52:52.80,Default-ja,,0,0,0,,Жоғары мәртебелі
Dialogue: 0,0:52:52.90,0:52:55.06,Default,,0,0,0,,Біз өз мүмкіндігімізді күтеміз.
Dialogue: 0,0:52:52.93,0:52:55.10,Default-ja,,0,0,0,,Күтіңіз, мүмкіндікті күтіңіз.
Dialogue: 0,0:52:55.22,0:52:56.68,Default-ja,,0,0,0,,Эй, мен сонда бардым.
Dialogue: 0,0:52:55.23,0:52:56.76,Default,,0,0,0,,Бұл солай болды!
Dialogue: 0,0:52:56.80,0:52:57.73,Default,,0,0,0,,Одан кейін!
Dialogue: 0,0:52:56.81,0:52:57.73,Default-ja,,0,0,0,,Жүргізу
Dialogue: 0,0:53:01.56,0:53:04.69,Default-ja,,0,0,0,,Не? А, жоқ!
Dialogue: 0,0:53:17.66,0:53:20.04,Default-ja,,0,0,0,,Тоқтаңыз!
Dialogue: 0,0:53:17.69,0:53:19.99,Default,,0,0,0,,Өтінемін! Тоқта!
Dialogue: 0,0:53:34.72,0:53:35.60,Default-ja,,0,0,0,,Енді бәрі жақсы
Dialogue: 0,0:53:34.77,0:53:35.60,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:53:37.61,0:53:40.01,Default,,0,0,0,,Уа! Уа! Уа! Уа! Уа!
Dialogue: 0,0:53:37.64,0:53:40.39,Default-ja,,0,0,0,,Қалай, қалай, қалай, қалай
Dialogue: 0,0:53:45.35,0:53:46.82,Default,,0,0,0,,Сіз ауырып қалдыңыз ба?
Dialogue: 0,0:53:45.40,0:53:47.07,Default-ja,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:53:55.41,0:53:56.99,Default-ja,,0,0,0,,Не болды?
Dialogue: 0,0:53:55.46,0:53:56.93,Default,,0,0,0,,Құдайым, маған көмектес
Dialogue: 0,0:53:57.30,0:54:00.29,Default,,0,0,0,,Мен қатты қорықтым!
Dialogue: 0,0:53:57.33,0:54:00.54,Default-ja,,0,0,0,,Мынау... Мен қатты қорықтым.
Dialogue: 0,0:54:01.04,0:54:03.00,Default-ja,,0,0,0,,Менің жүрегім әлі соғып тұр
Dialogue: 0,0:54:01.07,0:54:03.00,Default,,0,0,0,,Менің жүрегім дүрсілдеп тұр!
Dialogue: 0,0:54:03.57,0:54:05.37,Default,,0,0,0,,Мен ешқашан...
Dialogue: 0,0:54:03.67,0:54:05.42,Default-ja,,0,0,0,,Мен сондаймын...
Dialogue: 0,0:54:10.63,0:54:12.88,Default-ja,,0,0,0,,Сіз аздап алаңдаған сияқтысыз.
Dialogue: 0,0:54:10.64,0:54:12.84,Default,,0,0,0,,Сіз тынышталып жатқан сияқтысыз.
Dialogue: 0,0:54:13.80,0:54:17.89,Default-ja,,0,0,0,,Қайтейік, бәрі уайымдап жатыр.
Dialogue: 0,0:54:13.88,0:54:17.75,Default,,0,0,0,,Қайтып оралайық. Барлығы уайымдайтын болады.
Dialogue: 0,0:54:18.35,0:54:20.01,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:54:18.39,0:54:20.18,Default-ja,,0,0,0,,Гриффит!
Dialogue: 0,0:54:21.60,0:54:22.85,Default-ja,,0,0,0,,Гриффит
Dialogue: 0,0:54:21.62,0:54:22.81,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:54:25.10,0:54:26.11,Default-ja,,0,0,0,,Ішек
Dialogue: 0,0:54:25.12,0:54:26.06,Default,,0,0,0,,Ішек...
Dialogue: 0,0:54:34.11,0:54:35.03,Default-ja,,0,0,0,,Гриффит!
Dialogue: 0,0:54:34.13,0:54:34.96,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:54:42.16,0:54:43.12,Default-ja,,0,0,0,,Ақымақ
Dialogue: 0,0:54:42.27,0:54:43.07,Default,,0,0,0,,Қат!
Dialogue: 0,0:54:43.25,0:54:44.08,Default-ja,,0,0,0,,Гриффит
Dialogue: 0,0:54:43.38,0:54:44.34,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:54:45.24,0:54:46.37,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:54:45.25,0:54:46.54,Default-ja,,0,0,0,,Сәлем ханшайым!
Dialogue: 0,0:54:47.38,0:54:50.75,Default,,0,0,0,,Не болды? Жебе қайдан шықты?!
Dialogue: 0,0:54:47.46,0:54:50.71,Default-ja,,0,0,0,,Не болып жатыр? Бұл жебе қайдан шықты?
Dialogue: 0,0:54:50.78,0:54:51.84,Default,,0,0,0,,Ой!
Dialogue: 0,0:54:50.84,0:54:51.84,Default-ja,,0,0,0,,Жапония мен Батыстың қарапайым ақыл-кеуілі мүлде жарамайды.
Dialogue: 0,0:54:51.97,0:54:54.55,Default-ja,,0,0,0,,Гриффит! Гриффит…
Dialogue: 0,0:54:52.05,0:54:54.42,Default,,0,0,0,,Гриффит! Гриффит!
Dialogue: 0,0:54:56.47,0:54:58.72,Default-ja,,0,0,0,,Жылама, Каска
Dialogue: 0,0:54:56.49,0:54:58.55,Default,,0,0,0,,Жылама, Каска.
Dialogue: 0,0:54:58.86,0:55:00.76,Default,,0,0,0,,- Гриффит! - Гриффит!
Dialogue: 0,0:54:58.97,0:55:00.39,Default-ja,,0,0,0,,Гриффит
Dialogue: 0,0:55:02.93,0:55:05.66,Default,,0,0,0,,Көрсеткі. Сенде бәрі жақсы ма?
Dialogue: 0,0:55:02.93,0:55:05.94,Default-ja,,0,0,0,,Көрсеткілер... дұрыс па?
Dialogue: 0,0:55:07.44,0:55:08.40,Default-ja,,0,0,0,,Оған қол тигізбеңіз
Dialogue: 0,0:55:07.57,0:55:08.53,Default,,0,0,0,,Оған қол тигізбеңіз.
Dialogue: 0,0:55:09.36,0:55:11.23,Default-ja,,0,0,0,,Уланған болуы мүмкін.
Dialogue: 0,0:55:09.40,0:55:11.03,Default,,0,0,0,,Уланған шығар.
Dialogue: 0,0:55:11.36,0:55:12.78,Default-ja,,0,0,0,,Сосын бәрі де...
Dialogue: 0,0:55:11.57,0:55:12.80,Default,,0,0,0,,Барлық басқа себептер...
Dialogue: 0,0:55:13.47,0:55:14.46,Default,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:55:13.49,0:55:14.49,Default-ja,,0,0,0,,Жоқ
Dialogue: 0,0:55:14.77,0:55:16.97,Default,,0,0,0,,Бұл мені қорғады.
Dialogue: 0,0:55:14.82,0:55:17.20,Default-ja,,0,0,0,,Бұл жігіт менің қалқаным болды.
Dialogue: 0,0:55:19.45,0:55:21.04,Default-ja,,0,0,0,,Базардың жұмыртқасы...
Dialogue: 0,0:55:19.48,0:55:20.81,Default,,0,0,0,,Патшаның жұмыртқасы...
Dialogue: 0,0:55:21.20,0:55:22.16,Default-ja,,0,0,0,,Бұл өтірік
Dialogue: 0,0:55:21.35,0:55:22.31,Default,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:55:22.29,0:55:24.16,Default-ja,,0,0,0,,Бұл рас па?
Dialogue: 0,0:55:22.35,0:55:23.84,Default,,0,0,0,,Керемет!
Dialogue: 0,0:55:24.71,0:55:25.92,Default-ja,,0,0,0,,Қорқынышты сәтсіздік
Dialogue: 0,0:55:24.78,0:55:26.08,Default,,0,0,0,,Бұл шайтанның бақыты!
Dialogue: 0,0:55:26.04,0:55:27.33,Default-ja,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:55:26.12,0:55:27.45,Default,,0,0,0,,Мен бұған сене алмаймын!
Dialogue: 0,0:55:27.59,0:55:29.68,Default,,0,0,0,,Бұл «сәттілік» емес.
Dialogue: 0,0:55:27.75,0:55:29.88,Default-ja,,0,0,0,,Қарапайым сәттілік жоқ
Dialogue: 0,0:55:30.04,0:55:31.67,Default-ja,,0,0,0,,Бұл керемет
Dialogue: 0,0:55:30.19,0:55:31.45,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:55:34.01,0:55:37.01,Default-ja,,0,0,0,,Мен адамдарымды алып, жақын жердегі бұталарды басып аламын.
Dialogue: 0,0:55:34.03,0:55:36.79,Default,,0,0,0,,Мен ер адамдармен бірге сол бұталарды іздеуге барамын.
Dialogue: 0,0:55:39.39,0:55:42.68,Default-ja,,0,0,0,,Гриффит, сауытыңды шеш.
Dialogue: 0,0:55:39.40,0:55:44.43,Default,,0,0,0,,Құрышыңызды шешіңіз. Сізге зиян тигізбейтініне көз жеткізуіміз керек.
Dialogue: 0,0:55:43.06,0:55:44.43,Default-ja,,0,0,0,,Жарақат алдыңыз ба, жоқ па...
Dialogue: 0,0:55:57.61,0:55:59.91,Default-ja,,0,0,0,,Бұл қымбат болды.
Dialogue: 0,0:55:58.62,0:55:59.91,Default,,0,0,0,,Бұл у...
Dialogue: 0,0:56:01.58,0:56:02.83,Default-ja,,0,0,0,,Бұл у...
Dialogue: 0,0:56:01.65,0:56:03.05,Default,,0,0,0,,біреуге қымбатқа түседі.
Dialogue: 0,0:56:11.04,0:56:12.42,Default-ja,,0,0,0,,Шынайы ма?
Dialogue: 0,0:56:11.06,0:56:12.22,Default,,0,0,0,,Сіз қалжыңдап тұрсыз!
Dialogue: 0,0:56:12.56,0:56:14.09,Default,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:56:21.89,0:56:24.06,Default-ja,,0,0,0,,Бұл не?
Dialogue: 0,0:56:21.94,0:56:23.81,Default,,0,0,0,,Саған қара!
Dialogue: 0,0:56:24.64,0:56:29.81,Default-ja,,0,0,0,,Менің Ақ Айдаһар рыцарларымның мұрагері боламын деп ойлайсың ба?
Dialogue: 0,0:56:24.68,0:56:28.11,Default,,0,0,0,,Менің Ақ айдаһар рыцарьларымды басқаруға қалай үміттене аласыз?
Dialogue: 0,0:56:28.15,0:56:29.61,Default,,0,0,0,,Осылай төбелесу?!
Dialogue: 0,0:56:29.94,0:56:31.06,Default-ja,,0,0,0,,Жетеді!
Dialogue: 0,0:56:29.95,0:56:30.81,Default,,0,0,0,,Мен жеткілікті болдым!
Dialogue: 0,0:56:34.11,0:56:36.74,Default-ja,,0,0,0,,Тч... Әке! мен әлі
Dialogue: 0,0:56:34.12,0:56:36.52,Default,,0,0,0,,F-Әке! Мен жалғастыра аламын.
Dialogue: 0,0:56:37.74,0:56:41.24,Default-ja,,0,0,0,,Адонис-сама, жарақаттарыңызды тез арада емдеңіз.
Dialogue: 0,0:56:37.76,0:56:40.95,Default,,0,0,0,,Сол жараны көрейік. Мастер Адонис.
Dialogue: 0,0:56:41.73,0:56:45.46,Default,,0,0,0,,Әкең жас кезінде бұйым болған
Dialogue: 0,0:56:41.74,0:56:44.49,Default-ja,,0,0,0,,Әкем жас ұстазды ойлағанда ғана...
Dialogue: 0,0:56:44.62,0:56:47.62,Default-ja,,0,0,0,,Ол қасақана қатаң жаттығуларды жүктейді.
Dialogue: 0,0:56:45.50,0:56:47.47,Default,,0,0,0,,өте ауыр дайындық.
Dialogue: 0,0:56:47.67,0:56:50.26,Default,,0,0,0,,Оны оған қарсы ұстамаңыз.
Dialogue: 0,0:56:47.75,0:56:50.50,Default-ja,,0,0,0,,Өтінемін, маған кек сақтама.
Dialogue: 0,0:56:55.64,0:56:57.77,Default,,0,0,0,,Өлтіру? ДДСҰ?
Dialogue: 0,0:56:55.67,0:56:58.13,Default-ja,,0,0,0,,Өлтіру? кім
Dialogue: 0,0:56:58.91,0:57:01.47,Default,,0,0,0,,Тақтың екінші қатарында.
Dialogue: 0,0:56:58.93,0:57:01.76,Default-ja,,0,0,0,,Осы елдің тағының екінші мұрагері
Dialogue: 0,0:57:02.05,0:57:04.61,Default,,0,0,0,,Ақ айдаһарлардың генералы, граф Юлий.
Dialogue: 0,0:57:02.10,0:57:05.10,Default-ja,,0,0,0,,Ақ айдаһар генерал граф Юлий
Dialogue: 0,0:57:08.15,0:57:11.15,Default,,0,0,0,,Жебедегі улану маған арналған.
Dialogue: 0,0:57:08.23,0:57:11.35,Default-ja,,0,0,0,,Мені атқан жебе умен қапталған.
Dialogue: 0,0:57:12.06,0:57:16.25,Default,,0,0,0,,- бұл патша үйі ұрпақтар бойына қастандық жасау үшін қолданған.
Dialogue: 0,0:57:12.23,0:57:16.69,Default-ja,,0,0,0,,Патша әулеті ұрпақтар бойына өлтіру үшін қолданылған өлімге әкелетін у бар.
Dialogue: 0,0:57:17.82,0:57:19.53,Default-ja,,0,0,0,,Бұл лас жұмыс
Dialogue: 0,0:57:17.86,0:57:19.56,Default,,0,0,0,,Бұл лас жұмыс болады.
Dialogue: 0,0:57:20.61,0:57:22.37,Default-ja,,0,0,0,,Сәтсіздік ешқашан мүмкін емес
Dialogue: 0,0:57:20.63,0:57:22.43,Default,,0,0,0,,Біреуі сәтсіздікке ұшырамайды.
Dialogue: 0,0:57:25.20,0:57:27.00,Default-ja,,0,0,0,,Ешкім сіздің бетіңізді көре алмайды
Dialogue: 0,0:57:25.24,0:57:26.93,Default,,0,0,0,,Немесе көруге болады.
Dialogue: 0,0:57:27.12,0:57:28.41,Default-ja,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:57:32.75,0:57:36.34,Default-ja,,0,0,0,,Сондықтан мен сенің осы тапсырманы орындауыңды қалаймын.
Dialogue: 0,0:57:32.78,0:57:38.31,Default,,0,0,0,,Сондықтан мен сізден сұраймын. Сіз жасайсыз ба?
Dialogue: 0,0:57:36.92,0:57:38.46,Default-ja,,0,0,0,,Менен сұрайсың ба?
Dialogue: 0,0:57:38.55,0:57:39.88,Default,,0,0,0,,Бұл сізге ұқсамайды.
Dialogue: 0,0:57:38.59,0:57:39.97,Default-ja,,0,0,0,,Олай емес сияқты.
Dialogue: 0,0:57:42.55,0:57:45.10,Default-ja,,0,0,0,,Синого айтпай-ақ бұйрық бере аласыз.
Dialogue: 0,0:57:42.69,0:57:46.25,Default,,0,0,0,,Әдеттегідей маған тапсырыс беріңіз.
Dialogue: 0,0:57:45.22,0:57:46.47,Default-ja,,0,0,0,,Әдеттегідей
Dialogue: 0,0:57:47.14,0:57:49.73,Default-ja,,0,0,0,,Мен бұл күндері Мәртебелі...
Dialogue: 0,0:57:47.16,0:57:49.25,Default,,0,0,0,,Кешірім өтінемін, Мәртебелі!
Dialogue: 0,0:57:49.29,0:57:51.85,Default,,0,0,0,,Мүмкін сіз жас шеберге тым дөрекі болып жатқан шығарсыз?
Dialogue: 0,0:57:49.85,0:57:51.64,Default-ja,,0,0,0,,Жас жігіт туралы аздап...
Dialogue: 0,0:57:51.77,0:57:53.19,Default-ja,,0,0,0,,Айтпа, Хасан.
Dialogue: 0,0:57:51.90,0:57:52.99,Default,,0,0,0,,Жетер, Хасан!
Dialogue: 0,0:57:53.65,0:57:56.11,Default-ja,,0,0,0,,Адонис мәңгілік бала болмайды
Dialogue: 0,0:57:53.73,0:57:56.00,Default,,0,0,0,,Адонис мәңгі бала болып қала алмайды.
Dialogue: 0,0:57:56.20,0:57:59.90,Default,,0,0,0,,Ол менің орныма келген кезде. ол дайын болуы керек.
Dialogue: 0,0:57:56.23,0:57:59.82,Default-ja,,0,0,0,,Оның ізбасары жарымжан қызмет етеді деп ойламаймын.
Dialogue: 0,0:57:59.94,0:58:00.93,Default,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:57:59.94,0:58:00.82,Default-ja,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:58:00.95,0:58:02.36,Default-ja,,0,0,0,,Жетер, түс.
Dialogue: 0,0:58:00.97,0:58:02.30,Default,,0,0,0,,Жетеді! Шығар!
Dialogue: 0,0:58:20.05,0:58:21.42,Default-ja,,0,0,0,,Иә!
Dialogue: 0,0:58:24.96,0:58:30.66,Default,,0,0,0,,Мен сәтсіздікке ұшырап қана қоймай, ол қазір ханшайымды құтқарған батыр!
Dialogue: 0,0:58:25.01,0:58:26.30,Default-ja,,0,0,0,,Сәтсіздіктен алыс-
Dialogue: 0,0:58:26.43,0:58:30.77,Default-ja,,0,0,0,,Ханшайымды қорғаған батыр ретінде құрметке ие болады деп ойлау...
Dialogue: 0,0:58:36.98,0:58:38.20,Default,,0,0,0,,Жел?
Dialogue: 0,0:58:36.98,0:58:38.32,Default-ja,,0,0,0,,Жел?
Dialogue: 0,0:58:39.04,0:58:40.27,Default,,0,0,0,,Сәлем, Хасан!
Dialogue: 0,0:58:39.07,0:58:39.98,Default-ja,,0,0,0,,Эй, Хасса...
Dialogue: 0,0:58:45.87,0:58:47.20,Default-ja,,0,0,0,,Сіз үйреншікті адамсыз ба?
Dialogue: 0,0:58:46.02,0:58:47.11,Default,,0,0,0,,Зиянкесуші?!
Dialogue: 0,0:58:51.41,0:58:52.41,Default-ja,,0,0,0,,Жасайық
Dialogue: 0,0:59:12.06,0:59:15.23,Default-ja,,0,0,0,,Мен... білемін.
Dialogue: 0,0:59:12.21,0:59:15.15,Default,,0,0,0,,Мен... сені білемін!
Dialogue: 0,0:59:16.85,0:59:20.23,Default-ja,,0,0,0,,Сіз... Гриффит...
Dialogue: 0,0:59:16.88,0:59:20.51,Default,,0,0,0,,Сіз... Гриффиттікісіз!
Dialogue: 0,1:00:32.47,1:00:33.51,Default-ja,,0,0,0,,Эй
Dialogue: 0,1:00:32.49,1:00:33.46,Default,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,1:01:05.34,1:01:07.34,Default-ja,,0,0,0,,Жоқ, шу шықты...
Dialogue: 0,1:01:05.39,1:01:07.38,Default,,0,0,0,,Мен бірдеңе естідім.
Dialogue: 0,1:01:07.47,1:01:08.22,Default-ja,,0,0,0,,Мұнда біреу бар!
Dialogue: 0,1:01:07.59,1:01:08.56,Default,,0,0,0,,Біреу бар!
Dialogue: 0,1:01:09.88,1:01:10.93,Default-ja,,0,0,0,,Қандай мінез!
Dialogue: 0,1:01:10.03,1:01:11.09,Default,,0,0,0,,Зиянкесуші!
Dialogue: 0,1:01:11.05,1:01:12.39,Default-ja,,0,0,0,,Эй, бұл...
Dialogue: 0,1:01:11.33,1:01:12.42,Default,,0,0,0,,Қараңдар!
Dialogue: 0,1:01:12.72,1:01:13.76,Default-ja,,0,0,0,,Лорд Адонис!
Dialogue: 0,1:01:12.80,1:01:13.82,Default,,0,0,0,,Мастер Адонис!
Dialogue: 0,1:01:14.22,1:01:15.60,Default-ja,,0,0,0,,Эй (2-солдат) Диа!
Dialogue: 0,1:01:14.23,1:01:15.72,Default,,0,0,0,,Қару-жараққа!
Dialogue: 0,1:01:15.81,1:01:17.39,Default-ja,,0,0,0,,Қандай мінез!
Dialogue: 0,1:01:15.87,1:01:17.63,Default,,0,0,0,,Зиянкес!
Dialogue: 0,1:01:19.98,1:01:21.23,Default-ja,,0,0,0,,Қарғыс атсын
Dialogue: 0,1:01:20.04,1:01:21.20,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,1:01:21.37,1:01:22.40,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,1:01:21.40,1:01:22.40,Default-ja,,0,0,0,,Уг!?
Dialogue: 0,1:01:22.61,1:01:24.19,Default-ja,,0,0,0,,Ол әлі де жақын жерде болуы керек!
Dialogue: 0,1:01:22.71,1:01:24.17,Default,,0,0,0,,Ол әлі де жақын болуы керек!
Dialogue: 0,1:01:24.44,1:01:25.70,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,1:01:24.44,1:01:25.69,Default-ja,,0,0,0,,Сақтықты төмендетпеңіз!
Dialogue: 0,1:01:33.74,1:01:39.12,Default-ja,,0,0,0,,Тіпті Лорд Адонис... қандай қатыгез.
Dialogue: 0,1:01:33.92,1:01:38.88,Default,,0,0,0,,Мастер Адонис. да! Қандай қатыгез!
Dialogue: 0,1:01:45.21,1:01:49.09,Default-ja,,0,0,0,,Іздеу! Мен ұрының бұл сарайдан тірі кетуіне жол бермеймін!
Dialogue: 0,1:01:45.23,1:01:49.06,Default,,0,0,0,,Оны табыңыз! Оның тірі қалуына жол бермеңіз!
Dialogue: 0,1:02:00.48,1:02:03.94,Default-ja,,0,0,0,,Ей, міне сен! Бұл батыс қабырға. Қысқыш шабуылын қолданыңыз.
Dialogue: 0,1:02:00.51,1:02:04.07,Default,,0,0,0,,Міне, ол! Ол батыс қабырғада! Оны сол жерден кесіп таста!
Dialogue: 0,1:02:18.87,1:02:20.08,Default-ja,,0,0,0,,Ат!
Dialogue: 0,1:02:18.96,1:02:20.02,Default,,0,0,0,,Юкине-кун?
Dialogue: 0,1:02:38.85,1:02:42.94,Default-ja,,0,0,0,,А, қазір Гриффит ханшайымның банкетінде...
Dialogue: 0,1:02:40.15,1:02:45.35,Default,,0,0,0,,Мен Гриффит ханшайымның банкетте бұдан да жақсы тамақ жейтініне сенімдімін.
Dialogue: 0,1:02:43.06,1:02:45.60,Default-ja,,0,0,0,,Мен сіз жақсы тамақ жеп жатқаныңызға сенімдімін.
Dialogue: 0,1:02:46.81,1:02:49.90,Default-ja,,0,0,0,,Осыны айтып, үйренбеген адамдармен қарым-қатынас...
Dialogue: 0,1:02:46.82,1:02:52.42,Default,,0,0,0,,Иә. бірақ бұл топпен ол босаңсымайды.
Dialogue: 0,1:02:50.03,1:02:52.65,Default-ja,,0,0,0,,Бұл жай ғана ресми, мен сенімдімін.
Dialogue: 0,1:02:53.43,1:02:54.96,Default,,0,0,0,,Сонда не?
Dialogue: 0,1:02:53.45,1:02:54.86,Default-ja,,0,0,0,,Бұған не болды?
Dialogue: 0,1:02:55.16,1:02:56.99,Default-ja,,0,0,0,,Осылайша сіз дәмді тағамдарды көп жей аласыз.
Dialogue: 0,1:02:55.20,1:02:56.86,Default,,0,0,0,,Ол жақсы тамақ жейді,
Dialogue: 0,1:02:56.90,1:02:59.87,Default,,0,0,0,,және хош иісті асыл ханыммен бақытты болыңыз.
Dialogue: 0,1:02:57.12,1:02:59.95,Default-ja,,0,0,0,,Иісі жақсы шыққан асыл әйелмен бір рет атсам...
Dialogue: 0,1:02:59.97,1:03:01.63,Default,,0,0,0,,Кішкене күйзеліс деген не?
Dialogue: 0,1:03:00.08,1:03:01.66,Default-ja,,0,0,0,,Бұл арзан емес пе?
Dialogue: 0,1:03:02.04,1:03:06.79,Default-ja,,0,0,0,,Бір кадр Шарлотта ханым ұйымдастырған кешкі ас, солай ма?
Dialogue: 0,1:03:02.07,1:03:06.74,Default,,0,0,0,,Шарлотта ханшайымның банкетінде асыл ханыммен сәттілікке ие боласыз ба?
Dialogue: 0,1:03:06.91,1:03:08.28,Default,,0,0,0,,Мен бұған күмәнданамын.
Dialogue: 0,1:03:06.92,1:03:08.46,Default-ja,,0,0,0,,Не болса да...
Dialogue: 0,1:03:08.59,1:03:10.63,Default-ja,,0,0,0,,Айтпақшы, Гутс ше?
Dialogue: 0,1:03:08.68,1:03:10.31,Default,,0,0,0,,Guts қайда?
Dialogue: 0,1:03:10.72,1:03:12.77,Default,,0,0,0,,Мен оны күні бойы көрмедім.
Dialogue: 0,1:03:10.76,1:03:12.92,Default-ja,,0,0,0,,Мен сені бүгін таңертеңнен бері көрмедім.
Dialogue: 0,1:03:13.05,1:03:17.32,Default,,0,0,0,,Ол тағы да жаттығудан кеткен шығар. Сол қанішер жынды.
Dialogue: 0,1:03:13.05,1:03:17.01,Default-ja,,0,0,0,,Ке! Әйтеуір, тағы да жалғыз жаттығасың, ақымақ.
Dialogue: 0,1:03:17.76,1:03:18.95,Default,,0,0,0,,Тағы бір, Пипин...
Dialogue: 0,1:03:17.76,1:03:19.01,Default-ja,,0,0,0,,Маған Пипинді беріңіз
Dialogue: 0,1:03:19.97,1:03:24.10,Default-ja,,0,0,0,,Ол мен менің отрядым бүгін бірлескен жаттығуға жоспарланған болатын.
Dialogue: 0,1:03:20.02,1:03:23.98,Default,,0,0,0,,Ол бүгін менің бөлімшемен бірге жаттығуы керек еді.
Dialogue: 0,1:03:24.35,1:03:26.60,Default-ja,,0,0,0,,Бұл ешқандай қарсылықсыз
Dialogue: 0,1:03:24.40,1:03:26.39,Default,,0,0,0,,Бірақ ол келмеді. Сөзсіз.
Dialogue: 0,1:03:33.44,1:03:34.40,Default,,0,0,0,,Міне, ол!
Dialogue: 0,1:03:33.44,1:03:34.40,Default-ja,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,1:03:39.16,1:03:40.24,Default-ja,,0,0,0,,Ішек
Dialogue: 0,1:03:39.18,1:03:40.24,Default,,0,0,0,,Ішім!
Dialogue: 0,1:03:41.31,1:03:43.78,Default,,0,0,0,,Күні бойы қайда болдың?
Dialogue: 0,1:03:41.49,1:03:44.21,Default-ja,,0,0,0,,Бүгін күні бойы қайда жүрдің?
Dialogue: 0,1:03:48.55,1:03:49.75,Default,,0,0,0,,Гриффит қайда?
Dialogue: 0,1:03:48.63,1:03:49.88,Default-ja,,0,0,0,,Гриффит ше?
Dialogue: 0,1:03:49.95,1:03:52.75,Default,,0,0,0,,Шарлотта ханшайым оны шақырды...
Dialogue: 0,1:03:50.00,1:03:52.84,Default-ja,,0,0,0,,Егер бұл Гриффит болса, Шарлотта қонақ болады...
Dialogue: 0,1:03:52.99,1:03:54.98,Default,,0,0,0,,оның банкетіне.
Dialogue: 0,1:03:53.01,1:03:55.30,Default-ja,,0,0,0,,Мені кешкі асқа шақырды...
Dialogue: 0,1:03:56.06,1:03:58.62,Default,,0,0,0,,Ол Промроз Холлда болуы керек...
Dialogue: 0,1:03:56.09,1:03:59.01,Default-ja,,0,0,0,,Ол Промроз Холлға кеткен болуы керек...
Dialogue: 0,1:04:02.35,1:04:03.52,Default-ja,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,1:04:02.43,1:04:03.40,Default,,0,0,0,,Б... бір сызық
Dialogue: 0,1:04:04.30,1:04:07.00,Default,,0,0,0,,Сәлем! Мен сенімен сөйлесіп біткен жоқпын!
Dialogue: 0,1:04:04.48,1:04:06.98,Default-ja,,0,0,0,,Сәлем! Әңгіме әлі біткен жоқ.
Dialogue: 0,1:04:07.07,1:04:08.06,Default,,0,0,0,,Ішім!
Dialogue: 0,1:04:07.10,1:04:08.27,Default-ja,,0,0,0,,Ішім!
Dialogue: 0,1:04:12.38,1:04:13.27,Default,,0,0,0,,Жебе жарақаты ма?
Dialogue: 0,1:04:12.40,1:04:13.48,Default-ja,,0,0,0,,Жебе жарақаты?
Dialogue: 0,1:04:47.95,1:04:49.21,Default,,0,0,0,,Қандай жақсы жел!
Dialogue: 0,1:04:47.98,1:04:49.15,Default-ja,,0,0,0,,Жағымды жел...
Dialogue: 0,1:04:50.19,1:04:54.15,Default-ja,,0,0,0,,Мен мұндай жерге үйрене алмаймын.
Dialogue: 0,1:04:50.28,1:04:53.77,Default,,0,0,0,,Мен мұндай оқиғаларға ешқашан үйренген емеспін.
Dialogue: 0,1:04:56.74,1:04:59.07,Default-ja,,0,0,0,,Мен аздап шаршадым...
Dialogue: 0,1:04:56.82,1:04:58.85,Default,,0,0,0,,Мен біраз шаршадым.
Dialogue: 0,1:05:09.08,1:05:11.38,Default-ja,,0,0,0,,Кел, Шарлотта.
Dialogue: 0,1:05:09.20,1:05:11.26,Default,,0,0,0,,Өтінемін. Шарлотта ханшайым...
Dialogue: 0,1:05:12.59,1:05:15.09,Default-ja,,0,0,0,,Жарайды... Ухуху
Dialogue: 0,1:05:12.60,1:05:13.73,Default,,0,0,0,,О, менің!
Dialogue: 0,1:05:16.17,1:05:17.47,Default,,0,0,0,,Кел де жуынып ал.
Dialogue: 0,1:05:16.21,1:05:17.59,Default-ja,,0,0,0,,Рахмет
Dialogue: 0,1:05:27.85,1:05:28.85,Default-ja,,0,0,0,,Қ-Қандай?
Dialogue: 0,1:05:27.89,1:05:28.87,Default,,0,0,0,,Сен оларды сондай-ақ тастап жібересің.
Dialogue: 0,1:05:29.27,1:05:33.81,Default-ja,,0,0,0,,Сіз осылай киінуді жоспарлап отырсыз ба? Гриффитті ұятқа қалдырмаңыз.
Dialogue: 0,1:05:29.35,1:05:33.45,Default,,0,0,0,,Сіз осылай кіресіз бе? Гриффитті ұятқа қалдырмаңыз.
Dialogue: 0,1:05:33.89,1:05:36.95,Default,,0,0,0,,Олар сөйлесіп болғанша күтіңіз.
Dialogue: 0,1:05:33.94,1:05:37.19,Default-ja,,0,0,0,,Егер сізде бірдеңе болса, екеуіңіз сөйлесіп болғанша күтіңіздер.
Dialogue: 0,1:05:37.90,1:05:38.99,Default,,0,0,0,,Маған мынаны беріңіз.
Dialogue: 0,1:05:37.94,1:05:39.36,Default-ja,,0,0,0,,Мен оны қарызға аламын.
Dialogue: 0,1:05:45.16,1:05:46.49,Default-ja,,0,0,0,,Сәлем...
Dialogue: 0,1:05:45.17,1:05:46.43,Default,,0,0,0,,Эй...
Dialogue: 0,1:05:56.00,1:05:59.84,Default-ja,,0,0,0,,Неліктен ер адамдар тек қана қан төгуді ұнатады?
Dialogue: 0,1:05:56.05,1:05:59.95,Default,,0,0,0,,Сіз мені неге еркектер сонша жақсы көреді деп сұрағаныңыз есімде...
Dialogue: 0,1:06:00.38,1:06:02.65,Default,,0,0,0,,қантөгіс.
Dialogue: 0,1:06:00.47,1:06:02.89,Default-ja,,0,0,0,,Ханшайым осылай деді.
Dialogue: 0,1:06:03.29,1:06:04.19,Default,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,1:06:05.42,1:06:09.72,Default,,0,0,0,,Рас, бұл олардың табиғатының варварлық жағы болуы мүмкін.
Dialogue: 0,1:06:05.43,1:06:09.98,Default-ja,,0,0,0,,Еркектерде мұндай жабайылық болатыны рас.
Dialogue: 0,1:06:10.19,1:06:15.10,Default,,0,0,0,,Бірақ бұл ер адамдарға жүректеріне қымбат нәрсені сақтауға мүмкіндік береді.
Dialogue: 0,1:06:10.23,1:06:15.15,Default-ja,,0,0,0,,Бірақ ол жеңіп, асылды қорғау құралы.
Dialogue: 0,1:06:15.73,1:06:17.89,Default,,0,0,0,,Екі жолды да кесетін қылыш.
Dialogue: 0,1:06:15.81,1:06:17.90,Default-ja,,0,0,0,,Менің ойымша, бұл екі жүзді қылыш.
Dialogue: 0,1:06:19.15,1:06:22.95,Default-ja,,0,0,0,,Асыл зат... ғашық?
Dialogue: 0,1:06:19.24,1:06:22.80,Default,,0,0,0,,«Жүректеріне қымбат»? Ғашық сияқты ма?
Dialogue: 0,1:06:23.01,1:06:25.44,Default,,0,0,0,,Менің айтайын дегенім... намыс деген сияқты ма?
Dialogue: 0,1:06:23.07,1:06:25.28,Default-ja,,0,0,0,,А, рыцарь құрметі ме?
Dialogue: 0,1:06:26.71,1:06:28.77,Default,,0,0,0,,Екеуі де маңызды.
Dialogue: 0,1:06:26.74,1:06:29.04,Default-ja,,0,0,0,,Екеуі де маңызды.
Dialogue: 0,1:06:29.16,1:06:33.67,Default-ja,,0,0,0,,Бұл рыцарьдың махаббат пен намыс үшін күресуге және өлуге деген шынайы ұмтылысы.
Dialogue: 0,1:06:29.18,1:06:33.41,Default,,0,0,0,,Нағыз рыцарь махаббат үшін де, абырой үшін де соғысады және өледі.
Dialogue: 0,1:06:36.92,1:06:41.38,Default-ja,,0,0,0,,Бірақ оның алдында, егер сен ер болсаң, тағы бір асыл нәрсе бар...
Dialogue: 0,1:06:36.95,1:06:41.55,Default,,0,0,0,,Бірақ ер адам тағы бір нәрсеге тап болуы керек
Dialogue: 0,1:06:41.76,1:06:43.75,Default,,0,0,0,,бұл оған қымбат.
Dialogue: 0,1:06:41.92,1:06:43.80,Default-ja,,0,0,0,,Олар кездескен болуы керек.
Dialogue: 0,1:06:44.34,1:06:46.05,Default-ja,,0,0,0,,Тағы...?
Dialogue: 0,1:06:44.36,1:06:46.13,Default,,0,0,0,,Тағы бір нәрсе?
Dialogue: 0,1:06:47.83,1:06:53.93,Default,,0,0,0,,Ол өзі үшін және өзі үшін ғана жүзеге асыруы керек арман.
Dialogue: 0,1:06:47.85,1:06:54.14,Default-ja,,0,0,0,,Өзге емес, өзім үшін жасаған арманым.
Dialogue: 0,1:06:58.23,1:06:59.32,Default-ja,,0,0,0,,Арман...
Dialogue: 0,1:06:58.41,1:06:59.43,Default,,0,0,0,,Арман?
Dialogue: 0,1:06:59.81,1:07:06.01,Default,,0,0,0,,Кім болсаң да, Жаныңды жағатын арман.
Dialogue: 0,1:06:59.94,1:07:03.53,Default-ja,,0,0,0,,Адамның тәрбиесіне қарамастан әлеуметтік жағдайы мен таптық.
Dialogue: 0,1:07:04.15,1:07:06.07,Default-ja,,0,0,0,,Адамдар арманға ұмтылады
Dialogue: 0,1:07:06.78,1:07:11.02,Default,,0,0,0,,Сені асырайтын, қысатын, өмір сүретін арман...
Dialogue: 0,1:07:06.78,1:07:11.08,Default-ja,,0,0,0,,Арманмен тірек, арманмен қиналған, арманмен өмір сүрген.
Dialogue: 0,1:07:11.75,1:07:13.91,Default-ja,,0,0,0,,Түсінде өлтірілді
Dialogue: 0,1:07:11.89,1:07:13.88,Default,,0,0,0,,, содан кейін сізді өлтіреді.
Dialogue: 0,1:07:15.63,1:07:20.33,Default,,0,0,0,,Арман сені тастап кетсе де, жүрегіңде лаулап тұрады.
Dialogue: 0,1:07:15.71,1:07:20.55,Default-ja,,0,0,0,,Арман тастап кетсе де, жүрегімде лаулап тұрады
Dialogue: 0,1:07:21.71,1:07:26.05,Default-ja,,0,0,0,,Мұндай өмірді әрбір адам бір рет болса да елестетуі керек.
Dialogue: 0,1:07:21.83,1:07:25.86,Default,,0,0,0,,At least once. Адамның сол өмірге деген көзқарасы болуы керек...
Dialogue: 0,1:07:27.37,1:07:30.60,Default,,0,0,0,,Арман атты құдайға шейіт ретінде.
Dialogue: 0,1:07:27.39,1:07:30.89,Default-ja,,0,0,0,,Арман деп аталатын құдайға шейіт болған өмір...
Dialogue: 0,1:07:32.98,1:07:35.73,Default-ja,,0,0,0,,Мен дүниеге келгеннен бері жай өмір сүруден басқа амалым жоқ.
Dialogue: 0,1:07:32.98,1:07:37.71,Default,,0,0,0,,Адам өмірде туылғандықтан ғана өмір сүру...
Dialogue: 0,1:07:35.85,1:07:39.19,Default-ja,,0,0,0,,Мен мұндай өмір салтына шыдай алмаймын.
Dialogue: 0,1:07:37.85,1:07:39.37,Default,,0,0,0,,Мен мұны қабылдай алмаймын.
Dialogue: 0,1:07:48.03,1:07:51.76,Default,,0,0,0,,Кешіріңіз. Бұл қыз үшін қызықсыз тақырып болса керек.
Dialogue: 0,1:07:48.12,1:07:51.66,Default-ja,,0,0,0,,Кешіріңіз, бұл әйелдер үшін қызықсыз оқиға болды.
Dialogue: 0,1:07:51.91,1:07:53.75,Default-ja,,0,0,0,,Eh, no...
Dialogue: 0,1:07:52.63,1:07:53.76,Default,,0,0,0,,Мүлде жоқ!
Dialogue: 0,1:07:54.20,1:07:55.21,Default-ja,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,1:07:54.57,1:07:55.93,Default,,0,0,0,,Сіз...
Dialogue: 0,1:07:56.70,1:08:00.36,Default,,0,0,0,,өте жұмбақ джентльмен.
Dialogue: 0,1:07:56.83,1:08:00.63,Default-ja,,0,0,0,,Гриффит мырза біртүрлі адам.
Dialogue: 0,1:08:01.21,1:08:03.94,Default,,0,0,0,,Сен кез келген асылдан асылсың.
Dialogue: 0,1:08:01.21,1:08:04.01,Default-ja,,0,0,0,,Басқа асылдардан да асыл.
Dialogue: 0,1:08:04.38,1:08:08.31,Default,,0,0,0,,Бірақ сіз маған жапырақ ысқырығын қалай ойнау керектігін көрсеткенде,
Dialogue: 0,1:08:04.42,1:08:08.34,Default-ja,,0,0,0,,Бірақ сен маған шөпте ысқырық ойнауды үйреттің...
Dialogue: 0,1:08:08.38,1:08:10.71,Default,,0,0,0,,далада ойнап жүрген баладай болдың.
Dialogue: 0,1:08:08.47,1:08:11.06,Default-ja,,0,0,0,,Далада ойнап үйренген баладай...
Dialogue: 0,1:08:11.35,1:08:14.43,Default-ja,,0,0,0,,Ал енді философ сияқты
Dialogue: 0,1:08:11.45,1:08:14.38,Default,,0,0,0,,Ал енді сіз философ сияқтысыз.
Dialogue: 0,1:08:25.26,1:08:27.39,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,1:08:25.28,1:08:27.45,Default-ja,,0,0,0,,Сіздің достарыңыз да...
Dialogue: 0,1:08:27.47,1:08:31.87,Default,,0,0,0,,Бұл сүйкімділік достарыңды өзіңе тартты.
Dialogue: 0,1:08:27.57,1:08:32.08,Default-ja,,0,0,0,,Сенің сүйкімділігің үшін ол сенің соңынан ерді деп ойлаймын.
Dialogue: 0,1:08:33.37,1:08:37.90,Default,,0,0,0,,Олар менімен талай рет ажалмен бетпе-бет келген асыл жолдастар.
Dialogue: 0,1:08:33.41,1:08:38.12,Default-ja,,0,0,0,,Ажал шебін талай рет бірге аттаған асыл достар.
Dialogue: 0,1:08:39.17,1:08:41.84,Default-ja,,0,0,0,,Бірақ достармен емес
Dialogue: 0,1:08:39.18,1:08:41.84,Default,,0,0,0,,Бірақ олар дос емес.
Dialogue: 0,1:08:43.92,1:08:46.47,Default-ja,,0,0,0,,Біреудің арманына ешқашан жабыспа
Dialogue: 0,1:08:43.98,1:08:46.54,Default,,0,0,0,,Дос – өзгенің арманына жабыспайтын адам.
Dialogue: 0,1:08:46.72,1:08:48.81,Default,,0,0,0,,Ол өзі шешеді.
Dialogue: 0,1:08:46.72,1:08:51.35,Default-ja,,0,0,0,,Өмір сүру себебін өзіңіз шешесіз, ал егер біреу сол арманды таптаса...
Dialogue: 0,1:08:48.85,1:08:51.05,Default,,0,0,0,,және ол кез келген адамға қарсы тұрады
Dialogue: 0,1:08:51.09,1:08:53.45,Default,,0,0,0,,оны жан-тәнімен таптауға дәті барады.
Dialogue: 0,1:08:51.47,1:08:53.76,Default-ja,,0,0,0,,Бар жан-тәніңізбен күресіңіз
Dialogue: 0,1:08:54.81,1:08:57.60,Default-ja,,0,0,0,,Мен болсам да...
Dialogue: 0,1:08:54.86,1:08:57.45,Default,,0,0,0,,Ол адам мен болсам да.
Dialogue: 0,1:08:59.16,1:09:04.10,Default,,0,0,0,,Мен үшін дос, тең.
Dialogue: 0,1:08:59.23,1:09:04.65,Default-ja,,0,0,0,,Мен үшін дос – тең адам.
Dialogue: 0,1:09:23.95,1:09:27.86,Default,,0,0,0,,Лорд Гриффит. сонда бұл сенің арманың не?
Dialogue: 0,1:09:24.04,1:09:28.17,Default-ja,,0,0,0,,Гриффит мырза, сіздің арманыңыз...
Dialogue: 0,1:09:28.29,1:09:29.78,Default,,0,0,0,,Ханшайым!
Dialogue: 0,1:09:28.30,1:09:29.80,Default-ja,,0,0,0,,Ханшайым~
Dialogue: 0,1:09:36.83,1:09:38.20,Default,,0,0,0,,Не болды?
Dialogue: 0,1:09:36.85,1:09:38.14,Default-ja,,0,0,0,,Не болды?
Dialogue: 0,1:09:38.47,1:09:40.33,Default,,0,0,0,,I-Бұл қорқынышты!
Dialogue: 0,1:09:38.52,1:09:40.44,Default-ja,,0,0,0,,Татата Бұл қиын!
Dialogue: 0,1:09:40.54,1:09:43.44,Default,,0,0,0,,Сіздің ағаңыз Граф Юлий. қайтыс болды!
Dialogue: 0,1:09:40.56,1:09:43.69,Default-ja,,0,0,0,,Менің ағам... Мәртебелі Юлий дүниеден өтті!
Dialogue: 0,1:09:43.84,1:09:45.10,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,1:09:43.90,1:09:45.15,Default-ja,,0,0,0,,Оу, бұ да керемет екен. Сендер тез жеп қойыңдар.
Dialogue: 0,1:09:45.24,1:09:46.54,Default,,0,0,0,,Бұл қастандық болды!
Dialogue: 0,1:09:45.27,1:09:48.74,Default-ja,,0,0,0,,Бұл қастандық. Үйге біреу жасырынып кіреді...
Dialogue: 0,1:09:46.58,1:09:48.81,Default,,0,0,0,,Біреу оның үйіне кіріп, оны өлтірді!
Dialogue: 0,1:09:48.85,1:09:50.94,Default,,0,0,0,,Оның ұлы Мастер Адонис. да!
Dialogue: 0,1:09:48.86,1:09:51.32,Default-ja,,0,0,0,,Сіздің ұлыңыз Адониске...
Dialogue: 0,1:09:51.95,1:09:55.49,Default-ja,,0,0,0,,Қамалда шу болып жатыр. Банкет тоқтатылды.
Dialogue: 0,1:09:52.05,1:09:55.58,Default,,0,0,0,,Құлып айқайлап жатыр! Банкет тоқтатылды.
Dialogue: 0,1:09:55.62,1:09:59.08,Default-ja,,0,0,0,,Бұл ұлы мәртебелі патшаның қамалға дереу оралу туралы бұйрығы.
Dialogue: 0,1:09:55.65,1:09:59.35,Default,,0,0,0,,Мәртебелі сізге бірден үйге қайтуыңызды бұйырады!
Dialogue: 0,1:09:59.71,1:10:03.71,Default-ja,,0,0,0,,Жақында солдаттар келеді. Тез дайындал.
Dialogue: 0,1:09:59.76,1:10:03.56,Default,,0,0,0,,Сіздің эскортыңыз келе жатыр. Өтінемін, кетуге дайындалыңыз!
Dialogue: 0,1:10:04.80,1:10:08.36,Default,,0,0,0,,Келіңіздер. Егер бұл Чудердің қолымен жасалған болса, соғыс болады.
Dialogue: 0,1:10:04.84,1:10:08.63,Default-ja,,0,0,0,,Қайтейік, Ішек. Егер бұл Тюдордың әрекеті болса, онда соғыс болады ...
Dialogue: 0,1:10:08.90,1:10:10.03,Default,,0,0,0,,Ішек?
Dialogue: 0,1:10:08.92,1:10:10.05,Default-ja,,0,0,0,,Ішек пе?
Dialogue: 0,1:10:53.68,1:10:55.43,Default-ja,,0,0,0,,Ойлануға уақыт жоқ.
Dialogue: 0,1:10:53.81,1:10:55.44,Default,,0,0,0,,Ойлануға уақыт жоқ.
Dialogue: 0,1:10:55.93,1:10:59.26,Default-ja,,0,0,0,,Қазір қалай өлтіруге болады
Dialogue: 0,1:10:55.95,1:10:59.14,Default,,0,0,0,,Қалай соғысу керек, қалай өлтіру керек...
Dialogue: 0,1:10:59.82,1:11:01.38,Default,,0,0,0,,Бар болғаны осы.
Dialogue: 0,1:10:59.85,1:11:01.14,Default-ja,,0,0,0,,Осымен
Dialogue: 0,1:11:04.26,1:11:07.95,Default,,0,0,0,,Мен оның семсері болғым келді!
Dialogue: 0,1:11:04.27,1:11:07.94,Default-ja,,0,0,0,,Мен ол кісінің қылышы болғым келді...
Dialogue: 0,1:11:10.63,1:11:14.19,Default,,0,0,0,,Бұл сәл үлкенірек сарай ғана. Сонда не?
Dialogue: 0,1:11:10.69,1:11:14.03,Default-ja,,0,0,0,,Не, ақымақ, қамал жай ғана үлкен.
Dialogue: 0,1:11:14.57,1:11:18.13,Default,,0,0,0,,Гриффиттің айтқанын істе, сонда ол біздікі болады.
Dialogue: 0,1:11:14.57,1:11:18.16,Default-ja,,0,0,0,,Әдеттегідей Гриффиттің айтқанын орындасаң, жеңесің.
Dialogue: 0,1:11:30.68,1:11:34.48,Default,,0,0,0,,Өз өміріңізге қауіп төндіріңіз! Сонда ғана аман қаласыз!
Dialogue: 0,1:11:30.71,1:11:34.38,Default-ja,,0,0,0,,Өміріңді таста, аман қалудың басқа жолы жоқ.
Dialogue: 0,1:11:35.25,1:11:37.88,Default,,0,0,0,,Егер біз аман қалсақ. біз жеңеміз!
Dialogue: 0,1:11:35.34,1:11:37.85,Default-ja,,0,0,0,,Аман қалсақ, біз жеңеміз.
Dialogue: 0,1:11:41.13,1:11:45.76,Default,,0,0,0,,Мен жай ғана Гриффит пен Сұңқыр тобының не істеп жатқанын көргім келді.
Dialogue: 0,1:11:41.22,1:11:43.10,Default-ja,,0,0,0,,Мен оны тексеріп көрейін деп ойладым.
Dialogue: 0,1:11:43.43,1:11:45.56,Default-ja,,0,0,0,,Гриффит пен Сұңқырлар тобы не істеді?
Dialogue: 0,1:11:46.00,1:11:48.29,Default,,0,0,0,,Олар өздерімен бірге кімді алып келді
Dialogue: 0,1:11:46.10,1:11:48.81,Default-ja,,0,0,0,,Ол қанша алды және...
Dialogue: 0,1:11:48.33,1:11:51.63,Default,,0,0,0,,және олар тағы не іздеді.
Dialogue: 0,1:11:49.27,1:11:51.69,Default-ja,,0,0,0,,Енді сіз не алуға тырысасыз?
Dialogue: 0,1:11:53.19,1:11:59.19,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory