Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:05.69,0:01:06.64,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:01:07.77,0:01:10.36,Default,,0,0,0,,Ақпарат көзі анықталды
Dialogue: 0,0:01:10.77,0:01:12.28,Default,,0,0,0,,Сол аудан
Dialogue: 0,0:01:12.78,0:01:15.99,Default,,0,0,0,,Бұл жолы біз 5-тен астам андроидпен өтіп жатырмыз.
Dialogue: 0,0:01:16.82,0:01:18.36,Default,,0,0,0,,Өрнек тармақталған
Dialogue: 0,0:01:18.62,0:01:19.49,Default,,0,0,0,,Не...
Dialogue: 0,0:01:19.57,0:01:21.74,Default,,0,0,0,,Тек қабылдау жағын сызыңыз
Dialogue: 0,0:01:24.58,0:01:26.58,Default,,0,0,0,,Қабылдаушы органы анықталды
Dialogue: 0,0:01:26.66,0:01:28.04,Default,,0,0,0,,Мұнда да бақыланады
Dialogue: 0,0:01:32.09,0:01:33.09,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:01:33.80,0:01:36.22,Default,,0,0,0,,Бұл ұшақ Шиоцзукидің кәдесыйы.
Dialogue: 0,0:01:36.55,0:01:37.63,Default,,0,0,0,,Сіз нені білдіреді?
Dialogue: 0,0:01:37.72,0:01:39.01,Default,,0,0,0,,Шиозуки А.И
Dialogue: 0,0:01:39.09,0:01:41.81,Default,,0,0,0,,Codelife іске асыру эксперименті Есіңізде ме?
Dialogue: 0,0:01:41.89,0:01:44.64,Default,,0,0,0,,Жетекші оны күштеп тоқтатты. Солай ма?
Dialogue: 0,0:01:45.23,0:01:47.31,Default,,0,0,0,,Мен оның қайта іске қосылып жатқанын білмедім.
Dialogue: 0,0:01:47.39,0:01:48.60,Default,,0,0,0,,Бұл да мекемеден тыс.
Dialogue: 0,0:01:48.77,0:01:51.69,Default,,0,0,0,,Тиісті қызметкердің үйінде сынақ мерзімі
Dialogue: 0,0:01:52.02,0:01:54.15,Default,,0,0,0,,Біз күтпеген жерден қосылған сияқтымыз.
Dialogue: 0,0:01:54.23,0:01:55.61,Default,,0,0,0,,Кез келген жағдайда —
Dialogue: 0,0:01:55.69,0:01:57.61,Default,,0,0,0,,Осы аймақтағы андроидтер...
Dialogue: 0,0:01:57.70,0:02:00.24,Default,,0,0,0,,Оның бұл дүкен туралы ақпаратты алғаны анық.
Dialogue: 0,0:02:00.32,0:02:02.62,Default,,0,0,0,,Тіпті олардың әңгімесінде...
Dialogue: 0,0:02:03.49,0:02:06.50,Default,,0,0,0,,Шиоцуки Бұл да сенің ісің.
Dialogue: 0,0:02:06.91,0:02:10.29,Default,,0,0,0,,Қолданылатын әуе кемесінің ағымдағы жағдайы Бақылауды бастау
Dialogue: 0,0:02:48.16,0:02:49.00,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:50.08,0:02:52.33,Default,,0,0,0,,Негізгі журнал сәтті экспортталды
Dialogue: 0,0:02:52.42,0:02:53.33,Default,,0,0,0,,Сұрақ
Dialogue: 0,0:02:54.88,0:02:56.21,Default,,0,0,0,,Не?
Dialogue: 0,0:03:00.13,0:03:01.05,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:03:03.09,0:03:05.10,Default,,0,0,0,,Кофе сұрағынан бас тарту
Dialogue: 0,0:03:05.64,0:03:06.97,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:03:14.31,0:03:17.82,Default,,0,0,0,,Әрбір адам статустық отбасы емес
Dialogue: 0,0:03:18.19,0:03:20.95,Default,,0,0,0,,Сіздің әкеңіз жұмыс орнында.
Dialogue: 0,0:03:21.03,0:03:24.82,Default,,0,0,0,,Анам мен күткеннен ерте кетті.
Dialogue: 0,0:03:25.07,0:03:27.37,Default,,0,0,0,,Наоко-сама әлі ұйықтап жатқан шығар.
Dialogue: 0,0:03:28.20,0:03:30.71,Default,,0,0,0,,Үйге бару уақыты: 3:18.
Dialogue: 0,0:03:30.79,0:03:32.92,Default,,0,0,0,,Ах, бұл жиіркенішті.
Dialogue: 0,0:03:33.00,0:03:34.25,Default,,0,0,0,,Онда сіз оны ішпеуіңіз керек.
Dialogue: 0,0:03:34.33,0:03:36.00,Default,,0,0,0,,Алдымен жақсы сезінеді
Dialogue: 0,0:03:40.09,0:03:41.88,Default,,0,0,0,,Кофеңізге тапсырыс беріңіз
Dialogue: 0,0:03:42.22,0:03:45.39,Default,,0,0,0,,Ішімдік ішкен соң мен сені алып кетуге келдім.
Dialogue: 0,0:03:45.47,0:03:47.60,Default,,0,0,0,,Мен қатты ұялдым...
Dialogue: 0,0:03:48.01,0:03:49.06,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:03:49.06,0:03:49.68,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:03:49.06,0:03:49.68,Default,,0,0,0,,Таңғы ас алғыңыз келе ме?
Dialogue: 0,0:03:49.68,0:03:50.14,Default,,0,0,0,,Таңғы ас алғыңыз келе ме?
Dialogue: 0,0:03:50.14,0:03:50.98,Default,,0,0,0,,Таңғы ас ішуді қалайсыз ба?
Dialogue: 0,0:03:50.14,0:03:50.98,Default,,0,0,0,,Таңғы асты тоқтату
Dialogue: 0,0:03:50.98,0:03:52.23,Default,,0,0,0,,Таңғы асты тоқтату
Dialogue: 0,0:03:52.52,0:03:53.73,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:53.81,0:03:55.44,Default,,0,0,0,,Тағы да өтінемін, қазір бір адамға таңғы ас.
Dialogue: 0,0:03:55.56,0:03:56.77,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:03:56.94,0:03:59.32,Default,,0,0,0,,Жапонияда өзін-өзі азық-түлікпен қамтамасыз ету деңгейі...
Dialogue: 0,0:03:59.40,0:04:01.99,Default,,0,0,0,,80%-дан астамы белгілі болды.
Dialogue: 0,0:04:03.15,0:04:05.28,Default,,0,0,0,,Бұл Азық-түлік өнімдерін басқару министрлігінің тергеуіне сәйкес...
Dialogue: 0,0:04:05.37,0:04:06.20,Default,,0,0,0,,(Арналарды ауыстыруға арналған дыбыс)
Dialogue: 0,0:04:15.29,0:04:16.13,Default,,0,0,0,,(Арналарды ауыстыруға арналған дыбыс)
Dialogue: 0,0:04:16.21,0:04:17.54,Default,,0,0,0,,Донтто
Dialogue: 0,0:04:17.63,0:04:19.46,Default,,0,0,0,,Басқаша айтқанда, дори жүйесі дегеніміз не?
Dialogue: 0,0:04:19.55,0:04:22.84,Default,,0,0,0,,Бұл андроидтық психикалық тәуелділіктен туындайды, солай ма?
Dialogue: 0,0:04:22.92,0:04:25.84,Default,,0,0,0,,Бұл күндері жастар Хауероидтерге адам ретінде қарайды.
Dialogue: 0,0:04:25.93,0:04:27.51,Default,,0,0,0,,Мен мұны осылай атаймын.
Dialogue: 0,0:04:27.60,0:04:30.97,Default,,0,0,0,,Біз Дори-кей деген кісілерден сұхбат алдық.
Dialogue: 0,0:04:31.47,0:04:35.81,Default,,0,0,0,,А, бұл қорқынышты. Мен бір жерге бара жатқандай сезінемін. Кяхаха
Dialogue: 0,0:04:36.02,0:04:40.23,Default,,0,0,0,,Ахаха бірдеңе. Қолдарыңызды айқастырыңыз. (Жігіт) Уау, мысық!
Dialogue: 0,0:04:40.32,0:04:43.28,Default,,0,0,0,,Жалғыз емессің бе? Сіздің достарыңыз жоқ.
Dialogue: 0,0:04:43.36,0:04:44.82,Default,,0,0,0,,Сіз де абай болғаныңыз жөн.
Dialogue: 0,0:04:44.90,0:04:46.82,Default,,0,0,0,,Сақ болу деген нені білдіреді?
Dialogue: 0,0:04:48.78,0:04:49.62,Default,,0,0,0,,(пышақ дыбысы)
Dialogue: 0,0:04:49.70,0:04:50.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:59.38,0:05:00.46,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:05:14.64,0:05:16.48,Default,,0,0,0,,(Ер студенттер арасындағы чат)
Dialogue: 0,0:05:19.31,0:05:20.15,Default,,0,0,0,,(Андроид дыбысы)
Dialogue: 0,0:05:20.23,0:05:21.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:22.86,0:05:23.82,Default,,0,0,0,,(Андроид дыбысы)
Dialogue: 0,0:05:25.78,0:05:27.41,Default,,0,0,0,,Бұл, әрине, біртүрлі Кайо
Dialogue: 0,0:05:30.45,0:05:31.28,Default,,0,0,0,,Иә
Dialogue: 0,0:05:32.29,0:05:34.83,Default,,0,0,0,,Рикуо Мен сенің әпкеңді кеше көрдім.
Dialogue: 0,0:05:35.12,0:05:37.62,Default,,0,0,0,,Түн ортасы болды, солай ма? Ол билет қақпасында әбден мас болған.
Dialogue: 0,0:05:37.71,0:05:38.67,Default,,0,0,0,,Мен сені дұрыстап алуға барсам да.
Dialogue: 0,0:05:38.75,0:05:39.63,Default,,0,0,0,,Сіз?
Dialogue: 0,0:05:39.83,0:05:41.00,Default,,0,0,0,,Менің Андроид
Dialogue: 0,0:05:41.21,0:05:43.46,Default,,0,0,0,,Иә, сондықтан
Dialogue: 0,0:05:45.51,0:05:47.38,Default,,0,0,0,,Сіз роботсыз, оған тым сенесіз.
Dialogue: 0,0:05:47.47,0:05:49.76,Default,,0,0,0,,Мен саған шынымен сенбеймін.
Dialogue: 0,0:05:49.89,0:05:51.10,Default,,0,0,0,,Қараңыз, бля принципі.
Dialogue: 0,0:05:51.18,0:05:52.47,Default,,0,0,0,,Роботтардың үш принципі
Dialogue: 0,0:05:52.56,0:05:53.39,Default,,0,0,0,,1-бап
Dialogue: 0,0:05:53.47,0:05:56.14,Default,,0,0,0,,Адамға зиян тигізбе, Адамды қорға
Dialogue: 0,0:05:56.23,0:05:57.94,Default,,0,0,0,,А, сен оны алуға неге бардың?
Dialogue: 0,0:05:58.02,0:06:00.02,Default,,0,0,0,,Мен адамдар үшін алаңдамаймын.
Dialogue: 0,0:06:00.23,0:06:01.73,Default,,0,0,0,,Егер ол сізде жоқ болса, ойланыңыз.
Dialogue: 0,0:06:01.81,0:06:03.82,Default,,0,0,0,,Мұны жоқ адамдар жиі айтады.
Dialogue: 0,0:06:06.07,0:06:07.49,Default,,0,0,0,,Эй, бұл туралы не ойлайсың?
Dialogue: 0,0:06:07.57,0:06:09.74,Default,,0,0,0,,Сандар қатарға қойылған әрекет жазбасы
Dialogue: 0,0:06:09.82,0:06:11.53,Default,,0,0,0,,Менің Андроид құрылғымның қандай бөлігі?
Dialogue: 0,0:06:13.20,0:06:14.24,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:06:15.83,0:06:17.12,Default,,0,0,0,,Осыдан кейін бос уақытыңыз бар ма?
Dialogue: 0,0:06:18.92,0:06:20.58,Default,,0,0,0,,Менімен біраз уақыт араласуыңызды қалаймын.
Dialogue: 0,0:06:20.71,0:06:23.13,Default,,0,0,0,,Қайда? Бұл... білмеймін.
Dialogue: 0,0:06:23.29,0:06:26.30,Default,,0,0,0,,Бұл не? Ол соңғы кезде біртүрлі әрекет етіп жүр.
Dialogue: 0,0:06:26.55,0:06:28.47,Default,,0,0,0,,Менің үйге қайту уақытым өзгереді...
Dialogue: 0,0:06:28.55,0:06:29.72,Default,,0,0,0,,Сіздің роботыңыз?
Dialogue: 0,0:06:29.80,0:06:32.35,Default,,0,0,0,,Сондықтан мен қызығушылық танытып, мінез-құлық жазбаларын қарап шықтым.
Dialogue: 0,0:06:32.43,0:06:33.85,Default,,0,0,0,,Сонда?
Dialogue: 0,0:06:34.01,0:06:37.81,Default,,0,0,0,,20 сағат бұрын болды, сондықтан кеше түске жақын болған шығар?
Dialogue: 0,0:06:38.23,0:06:39.60,Default,,0,0,0,,Мен рұқсатсыз айналма жолмен жүрдім.
Dialogue: 0,0:06:40.65,0:06:43.40,Default,,0,0,0,,Менің ойымша, оның бірдеңе істеуі керек еді.
Dialogue: 0,0:06:48.11,0:06:48.95,Default,,0,0,0,,Мұнда?
Dialogue: 0,0:06:56.54,0:06:57.37,Default,,0,0,0,,Иә
Dialogue: 0,0:06:57.50,0:07:00.00,Default,,0,0,0,,Бұл жерде шын ба? Мүмкін GPS өшірілген шығар?
Dialogue: 0,0:07:00.08,0:07:01.92,Default,,0,0,0,,Бұл роботтар келетін жер емес.
Dialogue: 0,0:07:02.04,0:07:03.21,Default,,0,0,0,,(Андроид дыбысы)
Dialogue: 0,0:07:11.59,0:07:12.72,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:07:19.60,0:07:20.48,Default,,0,0,0,,Эй
Dialogue: 0,0:07:32.16,0:07:33.36,Default,,0,0,0,,Күдікті нәрсе бар ма?
Dialogue: 0,0:07:33.45,0:07:35.16,Default,,0,0,0,,Ал, мен ішке кіруім керек...
Dialogue: 0,0:07:40.25,0:07:42.33,Default,,0,0,0,,Бұл күдікті ме? Сонда мен үйге барайын ба?
Dialogue: 0,0:08:07.44,0:08:09.07,Default,,0,0,0,,Бұл... Қош келдіңіз.
Dialogue: 0,0:08:10.11,0:08:13.11,Default,,0,0,0,,Бос орынға отырыңыз. Мен тапсырысыңды алып кетейін.
Dialogue: 0,0:08:15.03,0:08:17.03,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:08:17.24,0:08:21.70,Default,,0,0,0,,Бұл аз уақыт болуы мүмкін, бірақ ләззат алыңыз.
Dialogue: 0,0:08:33.72,0:08:35.30,Default,,0,0,0,,Кофехана? Бұл кофехана
Dialogue: 0,0:08:35.38,0:08:36.64,Default,,0,0,0,,Андроид кофеханада ма?
Dialogue: 0,0:08:36.72,0:08:38.68,Default,,0,0,0,,Сіз мұнда шай ішуге келген сияқтысыз.
Dialogue: 0,0:08:38.93,0:08:40.22,Default,,0,0,0,,Міне, сол ереже.
Dialogue: 0,0:08:40.31,0:08:41.60,Default,,0,0,0,,Бұл шынымен қауіпті ме?
Dialogue: 0,0:08:42.39,0:08:43.89,Default,,0,0,0,,Робот заңы...
Dialogue: 0,0:08:44.69,0:08:47.10,Default,,0,0,0,,Бұл сұр аймақ. Түсініктеме тым бұлыңғыр.
Dialogue: 0,0:08:47.19,0:08:48.31,Default,,0,0,0,,Әй, мені тыңда.
Dialogue: 0,0:08:48.40,0:08:49.82,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:08:49.90,0:08:52.19,Default,,0,0,0,,Бұл бұрынғы андроид, солай ма?
Dialogue: 0,0:08:52.44,0:08:53.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:00.87,0:09:02.91,Default,,0,0,0,,Қоңырау жоқ... шын ба?
Dialogue: 0,0:09:03.83,0:09:05.21,Default,,0,0,0,,Бұл сұр аймақ па?
Dialogue: 0,0:09:05.29,0:09:07.92,Default,,0,0,0,,Сіз сақинасы жоқ роботты көрдіңіз бе?
Dialogue: 0,0:09:09.04,0:09:10.84,Default,,0,0,0,,Супер робот туралы заңның бұзылуы
Dialogue: 0,0:09:10.92,0:09:12.67,Default,,0,0,0,,Менің ойымша, бұл адамдардан айырмашылығы жоқ.
Dialogue: 0,0:09:14.05,0:09:15.30,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:17.55,0:09:19.35,Default,,0,0,0,,Тапсырысыңыз қалай болды? Ах...
Dialogue: 0,0:09:21.56,0:09:24.10,Default,,0,0,0,,Бұл Хауа Эвелендті араластырады ма?
Dialogue: 0,0:09:25.39,0:09:26.69,Default,,0,0,0,,Бұл да
Dialogue: 0,0:09:26.81,0:09:27.98,Default,,0,0,0,,...
Dialogue: 0,0:09:30.23,0:09:31.69,Default,,0,0,0,,Ережелерді орындаңыз
Dialogue: 0,0:09:31.82,0:09:32.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:35.07,0:09:37.53,Default,,0,0,0,,А... Менің ойыма бір жағымсыз нәрсе келді.
Dialogue: 0,0:09:37.74,0:09:38.57,Default,,0,0,0,,Не?
Dialogue: 0,0:09:38.66,0:09:40.12,Default,,0,0,0,,Осы дүкеннің ережелері
Dialogue: 0,0:09:40.20,0:09:41.99,Default,,0,0,0,,Адамдар мен роботтардың айырмашылығы жоқ па?
Dialogue: 0,0:09:42.29,0:09:43.54,Default,,0,0,0,,Демек, сақина жоқ
Dialogue: 0,0:09:43.62,0:09:45.20,Default,,0,0,0,,Жарайды, мен қазір кетейін
Dialogue: 0,0:09:46.04,0:09:48.04,Default,,0,0,0,,Бірақ егер солай болса,
Dialogue: 0,0:09:48.50,0:09:50.17,Default,,0,0,0,,Мүмкін бұл тек ол емес шығар.
Dialogue: 0,0:09:50.25,0:09:51.29,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:09:51.42,0:09:54.80,Default,,0,0,0,,Басқа қонақтар да ережелерді сақтаса ше?
Dialogue: 0,0:10:00.85,0:10:03.14,Default,,0,0,0,,Мына балалар маған қарап тұр.
Dialogue: 0,0:10:04.22,0:10:05.06,Default,,0,0,0,,Мияу
Dialogue: 0,0:10:09.65,0:10:11.61,Default,,0,0,0,,Бұл қауіпті дүкен ме? Мүмкін
Dialogue: 0,0:10:11.69,0:10:12.82,Default,,0,0,0,,Бұл туралы...
Dialogue: 0,0:10:13.77,0:10:14.61,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:14.73,0:10:16.28,Default,,0,0,0,,Ағаңа айтқың келе ме? Не...
Dialogue: 0,0:10:16.36,0:10:17.82,Default,,0,0,0,,Қарттың бұған қатысы жоқ. Не?
Dialogue: 0,0:10:17.90,0:10:20.20,Default,,0,0,0,,Сіз жаңадан келгенсіз бе? Мен оны Нагиден естідім-chan.
Dialogue: 0,0:10:20.28,0:10:22.24,Default,,0,0,0,,Аа, Наги-чан - кассадағы қыз.
Dialogue: 0,0:10:22.33,0:10:23.78,Default,,0,0,0,,Олай болса, мен осында отыра аламын ба?
Dialogue: 0,0:10:25.49,0:10:28.46,Default,,0,0,0,,Әй, сен мұнда қалай келдің? Біреудің досы ма?
Dialogue: 0,0:10:28.54,0:10:30.37,Default,,0,0,0,,Жарайды, мен жаңа ғана келдім, солай.
Dialogue: 0,0:10:30.46,0:10:32.75,Default,,0,0,0,,Бірақ мен жаңа біреуді кездестіргеніме біраз уақыт болды...
Dialogue: 0,0:10:32.84,0:10:34.55,Default,,0,0,0,,Қашан келсең де, бәрі бір адамдар
Dialogue: 0,0:10:34.63,0:10:36.17,Default,,0,0,0,,Кітапты оқитын адам - ​​Сетро, ​​солай ма?
Dialogue: 0,0:10:36.26,0:10:37.13,Default,,0,0,0,,Екінші қабат - Шимэй-сан және сүйкімді Чи Чан.
Dialogue: 0,0:10:37.13,0:10:37.97,Default,,0,0,0,,Екінші қабат - Шимэй-сан және сүйкімді Чи Чан.
Dialogue: 0,0:10:37.13,0:10:37.97,Default,,0,0,0,,Мияу
Dialogue: 0,0:10:37.97,0:10:39.01,Default,,0,0,0,,Екінші қабат - Шимэй-сан және сүйкімді Чи Чан.
Dialogue: 0,0:10:39.09,0:10:41.39,Default,,0,0,0,,Сонымен, Коджи-кун мен Рина-чан ол жақта жақсы достар.
Dialogue: 0,0:10:41.47,0:10:43.30,Default,,0,0,0,,Бұл Наги Чан, иә...
Dialogue: 0,0:10:43.39,0:10:45.89,Default,,0,0,0,,Қалпақ киген бала Ах, Акико, танысқаныма қуаныштымын.
Dialogue: 0,0:10:48.68,0:10:50.31,Default,,0,0,0,,Бұл Рикуо... Масаки...
Dialogue: 0,0:10:50.39,0:10:52.69,Default,,0,0,0,,Рикуо-кун мен Масаки-кун жаттады
Dialogue: 0,0:10:52.90,0:10:56.48,Default,,0,0,0,,Әй, андроид әйелді көрмедің бе?
Dialogue: 0,0:10:56.57,0:10:57.82,Default,,0,0,0,,1 шегерім
Dialogue: 0,0:10:57.90,0:10:58.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:59.53,0:11:00.78,Default,,0,0,0,,Ережелерді бұзу
Dialogue: 0,0:11:00.99,0:11:01.24,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:11:01.24,0:11:01.99,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:11:01.24,0:11:01.99,Default,,0,0,0,,Бұлай айтудың қажеті жоқ.
Dialogue: 0,0:11:01.99,0:11:03.20,Default,,0,0,0,,Бұлай айтудың қажеті жоқ.
Dialogue: 0,0:11:03.28,0:11:04.99,Default,,0,0,0,,Мен әлі үйренбегенмін.
Dialogue: 0,0:11:05.83,0:11:07.04,Default,,0,0,0,,Хмм... өйткені...
Dialogue: 0,0:11:07.70,0:11:10.12,Default,,0,0,0,,Ережені бұзу - әркім үшін проблема!
Dialogue: 0,0:11:10.79,0:11:12.25,Default,,0,0,0,,Наги-чан...
Dialogue: 0,0:11:14.04,0:11:15.42,Default,,0,0,0,,Мен жақсы қызмын.
Dialogue: 0,0:11:15.50,0:11:17.34,Default,,0,0,0,,Бұл дүкен мен үшін өте маңызды.
Dialogue: 0,0:11:17.42,0:11:19.63,Default,,0,0,0,,Сіз бұл үшін жеткілікті жұмыс істеп жатқан жоқсыз.
Dialogue: 0,0:11:19.97,0:11:20.88,Default,,0,0,0,,Неге ол маған ештеңе айтпады екен?
Dialogue: 0,0:11:22.84,0:11:23.68,Default,,0,0,0,,Уау
Dialogue: 0,0:11:23.76,0:11:25.85,Default,,0,0,0,,Ах~ Сунетеру қайтадан
Dialogue: 0,0:11:26.93,0:11:28.85,Default,,0,0,0,,Наги-чан
Dialogue: 0,0:11:30.02,0:11:31.73,Default,,0,0,0,,Бұл қауіпті дүкен сияқты емес пе?
Dialogue: 0,0:11:31.81,0:11:34.31,Default,,0,0,0,,...Жарайды, мен мұны айтқым келеді.
Dialogue: 0,0:11:34.56,0:11:36.27,Default,,0,0,0,,Ол бұл дүкенге не үшін келді?
Dialogue: 0,0:11:36.36,0:11:38.32,Default,,0,0,0,,Неге... түсіндім.
Dialogue: 0,0:11:38.82,0:11:39.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:40.11,0:11:41.90,Default,,0,0,0,,Менің ойымша, сіз роботтармен танысқыңыз келгендіктен осында отырсыз.
Dialogue: 0,0:11:41.99,0:11:42.99,Default,,0,0,0,,Бұл дори түріндегі нәрсе.
Dialogue: 0,0:11:43.07,0:11:44.28,Default,,0,0,0,,Иә? Иықтарыңыз бар ма?
Dialogue: 0,0:11:44.37,0:11:46.03,Default,,0,0,0,,Жоқ, бұл менің айтқым келгені емес...
Dialogue: 0,0:11:46.12,0:11:48.37,Default,,0,0,0,,Жарайды, тыңдасаң түсінесің.
Dialogue: 0,0:11:48.74,0:11:50.54,Default,,0,0,0,,Сізге бұл ережеге қайшы екені тағы айтылады
Dialogue: 0,0:11:50.62,0:11:52.83,Default,,0,0,0,,Тыңдаудың бір ғана жолы бар.
Dialogue: 0,0:11:53.12,0:11:54.04,Default,,0,0,0,,Сен келдің
Dialogue: 0,0:11:54.83,0:11:56.59,Default,,0,0,0,,Мен оны қайтардым~
Dialogue: 0,0:11:56.96,0:11:58.46,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:11:58.63,0:11:59.46,Default,,0,0,0,,Иә
Dialogue: 0,0:12:03.55,0:12:05.80,Default,,0,0,0,,Жоқ, менің де кінәм болды.
Dialogue: 0,0:12:06.47,0:12:08.14,Default,,0,0,0,,Теледидарда не айтып жатырсың?
Dialogue: 0,0:12:08.81,0:12:09.68,Default,,0,0,0,,Мына қалпақ саған жарасады
Dialogue: 0,0:12:09.77,0:12:12.39,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:12:12.48,0:12:13.44,Default,,0,0,0,,Сонымен…
Dialogue: 0,0:12:14.06,0:12:14.90,Default,,0,0,0,,Не?
Dialogue: 0,0:12:14.98,0:12:17.69,Default,,0,0,0,,Біз дүкеннен тыс нәрселер туралы айтып жатырмыз...
Dialogue: 0,0:12:17.77,0:12:19.57,Default,,0,0,0,,Мен андроид емеспін.
Dialogue: 0,0:12:19.65,0:12:21.15,Default,,0,0,0,,Бұл күндері сирек кездеседі.
Dialogue: 0,0:12:23.90,0:12:26.32,Default,,0,0,0,,Сіз сондасыз ба? Акиконың отбасы
Dialogue: 0,0:12:29.62,0:12:32.41,Default,,0,0,0,,Иә, мен, сондықтан мен мұндамын.
Dialogue: 0,0:12:34.96,0:12:36.04,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:36.25,0:12:38.79,Default,,0,0,0,,Мұнда кез келген адаммен сөйлесуге болады.
Dialogue: 0,0:12:39.21,0:12:41.01,Default,,0,0,0,,Сен көп нәрсені білесің.
Dialogue: 0,0:12:41.13,0:12:41.96,Default,,0,0,0,,Қый!
Dialogue: 0,0:12:42.05,0:12:45.47,Default,,0,0,0,,Басқа адамның сезімі... Қызық
Dialogue: 0,0:12:46.01,0:12:48.18,Default,,0,0,0,,Бұл менің оқиғам.
Dialogue: 0,0:12:48.39,0:12:52.10,Default,,0,0,0,,Мен барлық адамдар мен андроидтерді отбасы деп санаймын.
Dialogue: 0,0:12:52.18,0:12:57.15,Default,,0,0,0,,Бірақ сен маған қаншалықты ұқсасаң да, іштей біз мүлдем басқамыз.
Dialogue: 0,0:12:57.40,0:13:00.36,Default,,0,0,0,,Олар ұқсас, бірақ мүлдем басқаша.
Dialogue: 0,0:13:00.86,0:13:02.86,Default,,0,0,0,,Сондықтан мен жиі осылай ойлаймын.
Dialogue: 0,0:13:03.28,0:13:06.49,Default,,0,0,0,,Мен туралы не ойлайсың?
Dialogue: 0,0:13:08.03,0:13:10.12,Default,,0,0,0,,Сондықтан біз осындамыз
Dialogue: 0,0:13:10.83,0:13:13.95,Default,,0,0,0,,Мен сізбен әртүрлі нәрселер туралы сөйлескім келеді және сізге көбірек түсінуге көмектескім келеді.
Dialogue: 0,0:13:14.04,0:13:15.87,Default,,0,0,0,,Өйткені біз отбасымыз...
Dialogue: 0,0:13:18.21,0:13:19.84,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:13:22.59,0:13:24.47,Default,,0,0,0,,Жаңбыр жауып тұр
Dialogue: 0,0:13:26.93,0:13:28.72,Default,,0,0,0,,Рикуон екеуміз келмейміз бе?
Dialogue: 0,0:13:29.80,0:13:32.89,Default,,0,0,0,,Олардың не ойлайтынын білгіңіз келетініне қалай қарайсыз?
Dialogue: 0,0:13:32.97,0:13:34.56,Default,,0,0,0,,Иә? Акико-сан қарым-қатынасы
Dialogue: 0,0:13:34.64,0:13:36.14,Default,,0,0,0,,Ах, кешегі оқиға
Dialogue: 0,0:13:36.81,0:13:39.56,Default,,0,0,0,,Менің ойымша, ол сияқты адамдар да Дори типті.
Dialogue: 0,0:13:39.94,0:13:42.32,Default,,0,0,0,,Менде жоқ, сондықтан білмеймін.
Dialogue: 0,0:13:43.03,0:13:43.73,Default,,0,0,0,,Мен сізге қолшатыр әкелдім, ұстаз.
Dialogue: 0,0:13:43.73,0:13:44.49,Default,,0,0,0,,Мен сізге қолшатыр әкелдім, ұстаз.
Dialogue: 0,0:13:43.73,0:13:44.49,Default,,0,0,0,,Осылай пайдаланғаннан жақсы емес пе?
Dialogue: 0,0:13:44.49,0:13:46.36,Default,,0,0,0,,Осылай пайдаланғаннан жақсы емес пе?
Dialogue: 0,0:13:50.24,0:13:53.20,Default,,0,0,0,,Бір нәрсенің қамын жейтін адам... Шамасы
Dialogue: 0,0:13:53.29,0:13:54.62,Default,,0,0,0,,Жарайды, сен жақсы адамсың, солай ма?
Dialogue: 0,0:13:54.95,0:13:57.25,Default,,0,0,0,,Дұрыс, мен жеңілдеп қалдым.
Dialogue: 0,0:13:57.33,0:13:59.04,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:13:59.12,0:14:00.88,Default,,0,0,0,,Бұл сөзсіз сүйкімді болды.
Dialogue: 0,0:14:00.96,0:14:03.30,Default,,0,0,0,,Мен де бүгін барамын, сондықтан басқаша...
Dialogue: 0,0:14:03.46,0:14:04.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:11.64,0:14:12.56,Default,,0,0,0,,Аки…
Dialogue: 0,0:14:19.44,0:14:20.27,Default,,0,0,0,,(Андроид дыбысы)
Dialogue: 0,0:14:22.98,0:14:25.44,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз. Жаппай...
Dialogue: 0,0:14:26.03,0:14:28.24,Default,,0,0,0,,Су өткізбейтін сөмке Үйге тек сіз бара аласыз
Dialogue: 0,0:14:28.36,0:14:29.66,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:14:48.22,0:14:49.43,Default,,0,0,0,,Кофе
Dialogue: 0,0:14:56.22,0:14:57.64,Default,,0,0,0,,Өйткені, сол дәм...
Dialogue: 0,0:14:58.73,0:15:00.23,Default,,0,0,0,,Енгізу әдісі өзгертілді.
Dialogue: 0,0:15:00.39,0:15:02.06,Default,,0,0,0,,ше? Мен саған ондай бұйрық берген жоқпын.
Dialogue: 0,0:15:02.15,0:15:03.56,Default,,0,0,0,,Шебер риза болды деп үміттенемін.
Dialogue: 0,0:15:07.03,0:15:08.65,Default,,0,0,0,,Сіз өз бетіңізше не істеп жатырсыз?
Dialogue: 0,0:15:09.57,0:15:11.32,Default,,0,0,0,,Сіз тіпті адамдарға еліктейсіз бе?
Dialogue: 0,0:15:11.41,0:15:13.07,Default,,0,0,0,,Мен андроидпін
Dialogue: 0,0:15:13.16,0:15:15.37,Default,,0,0,0,,Адам шебері емес
Dialogue: 0,0:15:19.50,0:15:20.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:20.83,0:15:24.25,Default,,0,0,0,,Мен туралы не ойлайсың?
Dialogue: 0,0:15:25.42,0:15:27.42,Default,,0,0,0,,Бірдей болса да, ішкі жағынан мүлде басқа.
Dialogue: 0,0:15:27.42,0:15:28.30,Default,,0,0,0,,Бірдей болса да, ішкі жағынан мүлде басқа.
Dialogue: 0,0:15:27.42,0:15:28.30,Default,,0,0,0,,Бұл керісінше ме?
Dialogue: 0,0:15:28.51,0:15:31.18,Default,,0,0,0,,Олар ұқсайды, бірақ олар мүлдем басқаша.
Dialogue: 0,0:15:31.84,0:15:33.68,Default,,0,0,0,,Мен көбірек түсінгім келеді
Dialogue: 0,0:15:34.05,0:15:35.64,Default,,0,0,0,,Өйткені біз отбасымыз.
Dialogue: 0,0:15:42.31,0:15:45.19,Default,,0,0,0,,Кішкене... Дори тәрізді.
Dialogue: 0,0:15:55.03,0:15:55.95,Default,,0,0,0,,
Dialogue: 0,0:16:00.37,0:16:01.87,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:16:12.09,0:16:13.68,Default,,0,0,0,,Мен оны үйден әкелгенім жөн
Dialogue: 0,0:16:13.76,0:16:15.09,Default,,0,0,0,,А, солай емес пе?
Dialogue: 0,0:16:15.18,0:16:17.35,Default,,0,0,0,,А, мен таныс сияқтымын. (Әйел студент А) Міне, келді.
Dialogue: 0,0:16:17.43,0:16:19.39,Default,,0,0,0,,Мен сізге ауыстыратын киім әкелдім, ұстаз.
Dialogue: 0,0:16:19.52,0:16:20.60,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:21.39,0:16:23.77,Default,,0,0,0,,Рахмет айттыңыз ба? (Оқушы қыз А) Өтірік айтпайсың ба?
Dialogue: 0,0:16:23.85,0:16:25.52,Default,,0,0,0,,Мен бұлай айтуға амалым жоқ (Студент В) Иә? Бұл дори түрі ме?
Dialogue: 0,0:16:25.60,0:16:26.44,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:26.52,0:16:28.98,Default,,0,0,0,,Сондықтан мен ол дүкенге бармадым.
Dialogue: 0,0:16:29.11,0:16:31.32,Default,,0,0,0,,Сіз бұйырылғаннан басқа нәрсе істедіңіз бе? Мен істеген жоқпын.
Dialogue: 0,0:16:31.44,0:16:33.90,Default,,0,0,0,,Бұл туралы не деуге болады? Қараңызшы, бұл ұялы телефон ба?
Dialogue: 0,0:16:33.99,0:16:35.53,Default,,0,0,0,,Мінез-құлық жазбасы? Болды
Dialogue: 0,0:16:35.61,0:16:36.91,Default,,0,0,0,,Мүмкін бұл дұрыс емес шығар?
Dialogue: 0,0:16:36.99,0:16:39.79,Default,,0,0,0,,Сондықтан сіз роботтарға тым көп сенесіз.
Dialogue: 0,0:16:39.87,0:16:41.33,Default,,0,0,0,,Сонда Сэмми өтірік айтып тұр ма?
Dialogue: 0,0:16:41.33,0:16:41.91,Default,,0,0,0,,Сонда Сэмми өтірік айтып тұр ма?
Dialogue: 0,0:16:41.33,0:16:41.91,Default,,0,0,0,,Қызмет…
Dialogue: 0,0:16:41.91,0:16:42.16,Default,,0,0,0,,Қызмет…
Dialogue: 0,0:16:42.71,0:16:43.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:44.67,0:16:46.04,Default,,0,0,0,,Жоқ, менің Андроид телефоным...
Dialogue: 0,0:16:46.13,0:16:47.63,Default,,0,0,0,,Бұл Сэмми ме?
Dialogue: 0,0:16:47.71,0:16:49.55,Default,,0,0,0,,Сондықтан мен саған сенбеймін.
Dialogue: 0,0:16:50.21,0:16:51.71,Default,,0,0,0,,Роботтардың үш принципін айт.
Dialogue: 0,0:16:51.80,0:16:52.97,Default,,0,0,0,,Әсіресе заң факультетінде...
Dialogue: 0,0:16:53.05,0:16:55.13,Default,,0,0,0,,Мұқият есте сақтаңыз, ұстаз.
Dialogue: 0,0:16:55.30,0:16:56.80,Default,,0,0,0,,Ум, Ичиджо
Dialogue: 0,0:16:57.26,0:16:58.80,Default,,0,0,0,,Адамға зияны жоқ
Dialogue: 0,0:16:58.89,0:16:59.72,Default,,0,0,0,,Оши
Dialogue: 0,0:16:59.85,0:17:00.68,Default,,0,0,0,,2-бап
Dialogue: 0,0:17:00.85,0:17:03.64,Default,,0,0,0,,1-бапты бұзбайтын болса, адамның бұйрығына бағыну.
Dialogue: 0,0:17:03.73,0:17:04.73,Default,,0,0,0,,О, есіңде ме.
Dialogue: 0,0:17:05.02,0:17:08.90,Default,,0,0,0,,Санджо... сонда болды ма?
Dialogue: 0,0:17:09.02,0:17:10.65,Default,,0,0,0,,Өзіңізді қорғаңыз
Dialogue: 0,0:17:10.73,0:17:12.44,Default,,0,0,0,,Бұл робот әрекетінің принципі.
Dialogue: 0,0:17:12.53,0:17:13.78,Default,,0,0,0,,Басқаша айтқанда, солай болды.
Dialogue: 0,0:17:13.86,0:17:14.99,Default,,0,0,0,,Мәміле қандай?
Dialogue: 0,0:17:15.20,0:17:16.07,Default,,0,0,0,,Сонымен—
Dialogue: 0,0:17:16.32,0:17:18.61,Default,,0,0,0,,Өтірік айтпау принципі.
Dialogue: 0,0:17:19.70,0:17:20.28,Default,,0,0,0,,Ах.
Dialogue: 0,0:17:20.28,0:17:20.53,Default,,0,0,0,,Ах.
Dialogue: 0,0:17:20.28,0:17:20.53,Default,,0,0,0,,Бір қызығы, сіз мұны білмейсіз.
Dialogue: 0,0:17:20.53,0:17:22.29,Default,,0,0,0,,Бір қызығы, сіз мұны білмейсіз.
Dialogue: 0,0:17:22.87,0:17:27.17,Default,,0,0,0,,Мен Сэммидің айтқанына сене алмаймын.
Dialogue: 0,0:17:27.58,0:17:29.08,Default,,0,0,0,,Мен түстен кейін дүкенге бардым.
Dialogue: 0,0:17:29.17,0:17:30.00,Default,,0,0,0,,Не?
Dialogue: 0,0:17:30.13,0:17:31.80,Default,,0,0,0,,Бұл Сэмми
Dialogue: 0,0:17:31.92,0:17:33.13,Default,,0,0,0,,Жай сатып алу
Dialogue: 0,0:17:33.21,0:17:37.34,Default,,0,0,0,,Оның рас екенін білудің жалғыз жолы - тікелей анықтау.
Dialogue: 0,0:17:40.64,0:17:41.81,Default,,0,0,0,,Сіз барасыз ба?
Dialogue: 0,0:17:41.89,0:17:43.60,Default,,0,0,0,,Ал, сенгің келмей ме?
Dialogue: 0,0:17:43.68,0:17:44.77,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:17:44.85,0:17:45.77,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:46.60,0:17:48.10,Default,,0,0,0,,Иә, жарайды, бұл не?
Dialogue: 0,0:17:48.19,0:17:49.02,Default,,0,0,0,,Сондықтан мен барамын!
Dialogue: 0,0:17:49.10,0:17:50.31,Default,,0,0,0,,Олай болса кеттік, о, кеттік.
Dialogue: 0,0:17:52.32,0:17:53.65,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:17:55.69,0:17:57.32,Default,,0,0,0,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,0:18:01.53,0:18:04.20,Default,,0,0,0,,Күрсін... Жеңілдеп кетуге әлі ерте.
Dialogue: 0,0:18:04.41,0:18:06.66,Default,,0,0,0,,Ол жақында келмеуі мүмкін. Хи хи.
Dialogue: 0,0:18:10.92,0:18:11.79,Default,,0,0,0,,Сіз осында күтесіз бе?
Dialogue: 0,0:18:11.88,0:18:13.88,Default,,0,0,0,,Бәрібір кешкі асқа дейін шыдауым керек пе?
Dialogue: 0,0:18:13.96,0:18:15.84,Default,,0,0,0,,Мен сенімен кездескім келмейді.
Dialogue: 0,0:18:16.09,0:18:16.92,Default,,0,0,0,,О!
Dialogue: 0,0:18:22.64,0:18:24.18,Default,,0,0,0,,Менің ойымша, бұл жерде бәрі жақсы. Ах...
Dialogue: 0,0:18:24.81,0:18:26.64,Default,,0,0,0,,Мен өте шолақ адаммын.
Dialogue: 0,0:18:26.81,0:18:27.98,Default,,0,0,0,,Сіз оны осы жерден көре алмайсыз ба?
Dialogue: 0,0:18:28.06,0:18:29.94,Default,,0,0,0,,Өйткені бұл жай көзбен қарағанда 0,1-ден аз.
Dialogue: 0,0:18:30.02,0:18:30.98,Default,,0,0,0,,Ах! сурет?
Dialogue: 0,0:18:36.40,0:18:37.44,Default,,0,0,0,,Мияу
Dialogue: 0,0:18:38.61,0:18:39.91,Default,,0,0,0,,Мияу мияу
Dialogue: 0,0:18:40.66,0:18:42.95,Default,,0,0,0,,Чии-чан, төмен түс.
Dialogue: 0,0:18:43.03,0:18:44.24,Default,,0,0,0,,Бұл мысық па?
Dialogue: 0,0:18:45.41,0:18:48.12,Default,,0,0,0,,Жарайды, кешіріңіздер, ағайындар.
Dialogue: 0,0:18:48.21,0:18:52.42,Default,,0,0,0,,Балалардың еркін ойнағаны жақсы... иә?
Dialogue: 0,0:18:52.50,0:18:53.34,Default,,0,0,0,,О, жоқ... бостандық.
Dialogue: 0,0:18:53.42,0:18:54.29,Default,,0,0,0,,Мияу, қара...
Dialogue: 0,0:18:54.38,0:18:55.59,Default,,0,0,0,,Өтінемін, орындаңыз.
Dialogue: 0,0:18:55.67,0:18:56.92,Default,,0,0,0,,Дөңгелек болғаны біртүрлі.
Dialogue: 0,0:18:57.46,0:18:59.93,Default,,0,0,0,,Чии-чан, сенің бірдеңе жегің келеді, солай ма?
Dialogue: 0,0:19:00.01,0:19:02.14,Default,,0,0,0,,Бұл мысық! Анна балмұздақ!
Dialogue: 0,0:19:02.22,0:19:04.85,Default,,0,0,0,,Орындыққа отырмайынша тамақ жеуге болмайды.
Dialogue: 0,0:19:04.93,0:19:06.68,Default,,0,0,0,,Мұзды мұз, кешіріңіз.
Dialogue: 0,0:19:06.77,0:19:10.44,Default,,0,0,0,,Егер сізді қызықтырса, басқа ештеңеге алаңдамаңыз...
Dialogue: 0,0:19:14.73,0:19:16.23,Default,,0,0,0,,Бұл фортепиано. Сіз оны ойнайсыз ба?
Dialogue: 0,0:19:16.32,0:19:19.07,Default,,0,0,0,,Сондықтан мен ойнауды тоқтатсам да ойнай беремін.
Dialogue: 0,0:19:22.57,0:19:24.37,Default,,0,0,0,,Анау қарт пен бала адам ғой, солай ма?
Dialogue: 0,0:19:24.45,0:19:27.08,Default,,0,0,0,,Қалай қарасаң да адамсың...
Dialogue: 0,0:19:27.16,0:19:28.00,Default,,0,0,0,,Не?
Dialogue: 0,0:19:28.08,0:19:30.91,Default,,0,0,0,,Бұл жерде Акико да адам болып көрінді.
Dialogue: 0,0:19:31.62,0:19:33.33,Default,,0,0,0,,О, мен жалғызбын...
Dialogue: 0,0:19:33.46,0:19:36.00,Default,,0,0,0,,Мен де жалғызбын. Бұл күнде жақсы емес пе?
Dialogue: 0,0:19:36.25,0:19:37.67,Default,,0,0,0,,Иә, менің де жұмысым бар...
Dialogue: 0,0:19:37.75,0:19:39.51,Default,,0,0,0,,Сіз сыртта әйелді кездестіресіз бе?
Dialogue: 0,0:19:39.59,0:19:41.05,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:19:41.38,0:19:43.68,Default,,0,0,0,,Өтінемін, мені жалғыз қалдырмаңыз
Dialogue: 0,0:19:43.76,0:19:45.18,Default,,0,0,0,,Мүмкін сіз, мырза, сөгіс естігенді ұнататын сол қиын мінезді жандардың бірісіз бе?
Dialogue: 0,0:19:46.39,0:19:47.22,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:49.22,0:19:50.93,Default,,0,0,0,,Орынды өзгерту керек пе...
Dialogue: 0,0:19:51.56,0:19:54.02,Default,,0,0,0,,Сіз не істеп жатырсыз? Біраз уақыттан бері қарым-қатынасымызды тереңдетіп келеміз.
Dialogue: 0,0:19:54.10,0:19:55.90,Default,,0,0,0,,Екі қоспаға тапсырыс беріңіз.
Dialogue: 0,0:19:55.98,0:19:57.57,Default,,0,0,0,,Екінші Эвеленд
Dialogue: 0,0:20:03.41,0:20:04.41,Default,,0,0,0,,А, балмұздақ.
Dialogue: 0,0:20:04.49,0:20:06.49,Default,,0,0,0,,Иә, күткеніңізге рахмет, Чи Чан.
Dialogue: 0,0:20:06.58,0:20:08.83,Default,,0,0,0,,Мысықтың тілі суық болғаны дұрыс па?
Dialogue: 0,0:20:08.91,0:20:10.83,Default,,0,0,0,,Сіз қорқыныштысыз, солай емес пе?
Dialogue: 0,0:20:12.46,0:20:13.42,Default,,0,0,0,,Не?
Dialogue: 0,0:20:13.67,0:20:15.13,Default,,0,0,0,,Сэмми келе жатыр
Dialogue: 0,0:20:16.08,0:20:16.92,Default,,0,0,0,,Бәрі жақсы, Буккирати
Dialogue: 0,0:20:17.00,0:20:20.63,Default,,0,0,0,,Менің роботым мен білмей бірдеңе жасаса ше?
Dialogue: 0,0:20:20.71,0:20:22.72,Default,,0,0,0,,Адамның қадір-қасиеті бұзылған
Dialogue: 0,0:20:22.97,0:20:24.13,Default,,0,0,0,,...Бұл ағай ма?
Dialogue: 0,0:20:24.22,0:20:26.30,Default,,0,0,0,,Ал, мен білмеймін.
Dialogue: 0,0:20:26.39,0:20:27.47,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:20:28.10,0:20:29.64,Default,,0,0,0,,Неліктен ол сізде жоқ?
Dialogue: 0,0:20:35.52,0:20:36.90,Default,,0,0,0,,Ах
Dialogue: 0,0:20:37.31,0:20:39.32,Default,,0,0,0,,А, міне, осында. Мұнда.
Dialogue: 0,0:20:41.32,0:20:42.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:45.61,0:20:47.28,Default,,0,0,0,,Мен Сэммидің неге өтірік айтып жатқанын түсінбеймін.
Dialogue: 0,0:20:47.37,0:20:50.04,Default,,0,0,0,,Мен сақинасыз роботтарды жақсы түсінбеймін.
Dialogue: 0,0:20:50.24,0:20:51.08,Default,,0,0,0,,Мен біраз уақытқа барамын.
Dialogue: 0,0:20:51.16,0:20:52.41,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:21:00.42,0:21:02.01,Default,,0,0,0,,Ах, Рикуо-кун
Dialogue: 0,0:21:03.26,0:21:06.13,Default,,0,0,0,,Не? не болды? Ия қазірдің өзінде
Dialogue: 0,0:21:06.22,0:21:08.80,Default,,0,0,0,,Мүлдем емес... Иә? иә? бақытты!
Dialogue: 0,0:21:10.47,0:21:13.48,Default,,0,0,0,,О, білесің бе... бұл сұрақ емес.
Dialogue: 0,0:21:13.56,0:21:15.60,Default,,0,0,0,,Иә, бұл... сақина ше? бастың
Dialogue: 0,0:21:15.69,0:21:18.98,Default,,0,0,0,,Мен оны өшіріп жатырмын. Адамдар сияқты, егер сіз оны көре алмасаңыз, бұл ережеге қайшы келеді.
Dialogue: 0,0:21:19.06,0:21:21.19,Default,,0,0,0,,Бірақ робот... Иә, әңгіменің соңы!
Dialogue: 0,0:21:21.36,0:21:24.28,Default,,0,0,0,,Хмм... эхехе
Dialogue: 0,0:21:25.36,0:21:26.20,Default,,0,0,0,,А? сурет?
Dialogue: 0,0:21:27.24,0:21:29.83,Default,,0,0,0,,Ах, Чи Чан, бұл мысық.
Dialogue: 0,0:21:29.99,0:21:31.62,Default,,0,0,0,,Эй, не болды? Чи-чан
Dialogue: 0,0:21:31.70,0:21:32.91,Default,,0,0,0,,Мен біртүрлі нәрсе киіп жүрмін.
Dialogue: 0,0:21:33.00,0:21:34.04,Default,,0,0,0,,Не қызық?
Dialogue: 0,0:21:34.54,0:21:35.37,Default,,0,0,0,,Уау...
Dialogue: 0,0:21:41.09,0:21:42.63,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:21:44.38,0:21:46.43,Default,,0,0,0,,Хэхе ахахаха
Dialogue: 0,0:21:46.51,0:21:48.05,Default,,0,0,0,,Мияу Мияу
Dialogue: 0,0:21:49.55,0:21:51.18,Default,,0,0,0,,Мияу Мияу Мияу
Dialogue: 0,0:21:58.44,0:22:00.48,Default,,0,0,0,,Мен үшін бірдеңе бар ма? пышақ жүгіргіші
Dialogue: 0,0:22:00.56,0:22:01.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:01.48,0:22:03.48,Default,,0,0,0,,Жақсырақ бақылау туралы не айтасыз?
Dialogue: 0,0:22:03.57,0:22:07.82,Default,,0,0,0,,Ер адамның ілінген көзқарасы ұнамайды.
Dialogue: 0,0:22:07.99,0:22:08.91,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:11.74,0:22:14.45,Default,,0,0,0,,Ережеге қарсылық танытсаңыз, мұнда көңілді болмайды.
Dialogue: 0,0:22:14.54,0:22:17.00,Default,,0,0,0,,Жоқ, бұл жерде болудың қажеті жоқ сияқты.
Dialogue: 0,0:22:17.79,0:22:19.79,Default,,0,0,0,,Бұл екінші қолды сату.
Dialogue: 0,0:22:21.00,0:22:22.21,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:22:22.29,0:22:23.34,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:22:23.71,0:22:25.09,Default,,0,0,0,,Аа, бүгін қалайсың?
Dialogue: 0,0:22:25.38,0:22:28.55,Default,,0,0,0,,Олай болса, досыңа сәлем айт.
Dialogue: 0,0:22:32.51,0:22:34.64,Default,,0,0,0,,Менің ойымша, сіз оны кейін қайтара аласыз, мүмкін.
Dialogue: 0,0:22:34.72,0:22:35.56,Default,,0,0,0,,Мүмкін?
Dialogue: 0,0:22:35.64,0:22:37.23,Default,,0,0,0,,Мен бұрын қалпағымды тығып қойғанмын...
Dialogue: 0,0:22:37.31,0:22:38.52,Default,,0,0,0,,Көзілдірік шешілді
Dialogue: 0,0:22:39.10,0:22:40.56,Default,,0,0,0,,Ал бас киімдер ше? Шляпа дегеніміз не?
Dialogue: 0,0:22:40.65,0:22:42.06,Default,,0,0,0,,Жасырын, иә
Dialogue: 0,0:22:42.15,0:22:44.44,Default,,0,0,0,,Сосын мен оны қайда жасырғанын сұрадым.
Dialogue: 0,0:22:44.52,0:22:46.23,Default,,0,0,0,,Қайта келіңіз
Dialogue: 0,0:22:44.52,0:22:46.23,Default,,0,0,0,,Чи Чанның басынан бері солай болды.
Dialogue: 0,0:22:49.45,0:22:51.16,Default,,0,0,0,,Сізде болды ма? Ол менің шалбарыма жабысып қалды
Dialogue: 0,0:22:51.24,0:22:52.32,Default,,0,0,0,,Ах ха ха ха
Dialogue: 0,0:22:52.41,0:22:54.79,Default,,0,0,0,,Хмм... Маған қатты ұнады, солай емес пе?
Dialogue: 0,0:22:54.87,0:22:56.75,Default,,0,0,0,,Өкініштісі менде бірдеңе болды.
Dialogue: 0,0:22:57.33,0:22:58.54,Default,,0,0,0,,Бұл жақсы атмосфера.
Dialogue: 0,0:23:00.04,0:23:03.96,Default,,0,0,0,,Масаки-кун, не болды? Иә, келші?
Dialogue: 0,0:23:08.01,0:23:08.84,Default,,0,0,0,,Әй?
Dialogue: 0,0:23:09.55,0:23:10.68,Default,,0,0,0,,Мен оны енді ашпаймын.
Dialogue: 0,0:23:10.76,0:23:11.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:11.84,0:23:14.05,Default,,0,0,0,,Егер біреу кетсе, ол біраз уақытқа құлыпталады.
Dialogue: 0,0:23:14.14,0:23:15.18,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:23:15.26,0:23:17.06,Default,,0,0,0,,Құпиялылық маңызды
Dialogue: 0,0:23:20.94,0:23:21.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:23.77,0:23:24.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:25.86,0:23:28.07,Default,,0,0,0,,Мм, бұл өлшем дұрыс па?
Dialogue: 0,0:23:28.28,0:23:30.15,Default,,0,0,0,,Иә, үлкендері де бар.
Dialogue: 0,0:23:30.40,0:23:31.57,Default,,0,0,0,,Тым үлкен болса, үйдегілер тауып алады.
Dialogue: 0,0:23:31.57,0:23:32.41,Default,,0,0,0,,Тым үлкен болса, үйдегілер тауып алады.
Dialogue: 0,0:23:31.57,0:23:32.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:32.41,0:23:33.57,Default,,0,0,0,,Тым үлкен болса, үйдегілер тауып алады.
Dialogue: 0,0:23:33.66,0:23:34.57,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:23:34.66,0:23:37.54,Default,,0,0,0,,Күте тұрыңыз, мен сізге жақсы бұршақ әкелемін.
Dialogue: 0,0:23:37.66,0:23:39.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:45.79,0:23:46.80,Default,,0,0,0,,Мен не істеуім керек, Лина-чан?
Dialogue: 0,0:23:46.88,0:23:50.13,Default,,0,0,0,,Кешіріңіз, алдымен өтіңіз.
Dialogue: 0,0:23:52.47,0:23:53.80,Default,,0,0,0,,Бүгінгі күн үшін иә
Dialogue: 0,0:23:53.89,0:23:56.10,Default,,0,0,0,,Дүкендегі заттарға үнемі өкінемін.
Dialogue: 0,0:23:56.18,0:23:57.47,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:23:58.01,0:24:00.31,Default,,0,0,0,,Сізге ұнады ма деп ойлаймын...
Dialogue: 0,0:24:00.64,0:24:02.31,Default,,0,0,0,,Оны өзіңіз де сұрай аласыз.
Dialogue: 0,0:24:02.39,0:24:03.98,Default,,0,0,0,,Бұл жақсы емес. Неліктен?
Dialogue: 0,0:24:05.11,0:24:08.15,Default,,0,0,0,,Маған бір нәрсе істегенде ұнамайды.
Dialogue: 0,0:24:08.28,0:24:09.86,Default,,0,0,0,,Қалағаныңды істеме
Dialogue: 0,0:24:10.90,0:24:12.78,Default,,0,0,0,,Жарайды, түсінетіндеріңізге сенімдімін.
Dialogue: 0,0:24:12.86,0:24:14.91,Default,,0,0,0,,Бірақ бұл тек жергілікті ереже.
Dialogue: 0,0:24:15.07,0:24:16.16,Default,,0,0,0,,Оны робот заңымен салыстыруға болмайды.
Dialogue: 0,0:24:16.16,0:24:16.83,Default,,0,0,0,,Оны робот заңымен салыстыруға болмайды.
Dialogue: 0,0:24:16.16,0:24:16.83,Default,,0,0,0,,Сондай-ақ ережелерді бұзу
Dialogue: 0,0:24:16.83,0:24:17.16,Default,,0,0,0,,Сондай-ақ ережелерді бұзу
Dialogue: 0,0:24:17.24,0:24:18.83,Default,,0,0,0,,Мен сізге айтамын, бұл жұмыс істемейді ...
Dialogue: 0,0:24:18.91,0:24:20.70,Default,,0,0,0,,Мен Наги-чанды жалғыз қалдырамын.
Dialogue: 0,0:24:20.79,0:24:21.96,Default,,0,0,0,,Бұл оқиға аяқталды!
Dialogue: 0,0:24:22.79,0:24:24.21,Default,,0,0,0,,Жоқ... иә?
Dialogue: 0,0:24:25.13,0:24:26.92,Default,,0,0,0,,Өйткені, біз мұны бір-бірімізсіз жасай аламыз.
Dialogue: 0,0:24:27.00,0:24:30.13,Default,,0,0,0,,Сіз біртүрлі сөйлеп тұрсыз.
Dialogue: 0,0:24:30.38,0:24:33.30,Default,,0,0,0,,Әр адамның бір-екі сыры бар.
Dialogue: 0,0:24:33.38,0:24:35.14,Default,,0,0,0,,Жоқ, өйткені ол...
Dialogue: 0,0:24:35.59,0:24:37.18,Default,,0,0,0,,Ah, um...
Dialogue: 0,0:24:37.64,0:24:41.22,Default,,0,0,0,,Менің де бұл баладан жасыратын сырым бар.
Dialogue: 0,0:24:41.31,0:24:43.69,Default,,0,0,0,,Өтірік айта алмайтын сияқтымын
Dialogue: 0,0:24:45.27,0:24:47.65,Default,,0,0,0,,Бірақ бұл балаға арналған.
Dialogue: 0,0:24:47.94,0:24:51.57,Default,,0,0,0,,Акико-санның кеткені Рикуокун үшін, солай ма?
Dialogue: 0,0:24:51.65,0:24:52.90,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:24:54.03,0:24:55.03,Default,,0,0,0,,Адамға зияны жоқ...
Dialogue: 0,0:24:55.03,0:24:55.57,Default,,0,0,0,,Адамға зиянын тигізбеу... Роботтың мінез-құлқының принципі...
Dialogue: 0,0:24:55.57,0:24:56.24,Default,,0,0,0,,Бұл робот әрекетінің принципі...
Dialogue: 0,0:24:56.24,0:24:56.74,Default,,0,0,0,,Бұл роботтың мінез-құлқының принципі... Ол командадан басқа ештеңе істеді ме?
Dialogue: 0,0:24:56.74,0:24:57.16,Default,,0,0,0,,Сіз бұйырылғаннан басқа нәрсе істедіңіз бе?
Dialogue: 0,0:24:57.16,0:24:57.57,Default,,0,0,0,,Сіз бұйырылғаннан басқа нәрсе істедіңіз бе? Менде жоқ
Dialogue: 0,0:24:57.57,0:24:58.28,Default,,0,0,0,,Орындалмады
Dialogue: 0,0:24:58.78,0:25:00.24,Default,,0,0,0,,Себебі бұл мені ауыртады...
Dialogue: 0,0:25:01.29,0:25:02.33,Default,,0,0,0,,Мен үшін!
Dialogue: 0,0:25:02.75,0:25:06.96,Default,,0,0,0,,Көзілдіріктің қайда екенін айтпаған...
Dialogue: 0,0:25:07.08,0:25:10.34,Default,,0,0,0,,Хаха, менімен ойнағаныңды қалағандықтан шығар...
Dialogue: 0,0:25:10.63,0:25:12.05,Default,,0,0,0,,Менің шалбарымда...
Dialogue: 0,0:25:12.42,0:25:14.38,Default,,0,0,0,,Оны біреуге берген көрінеді.
Dialogue: 0,0:25:14.55,0:25:15.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:19.89,0:25:21.77,Default,,0,0,0,,Үйге осыншама ұзақ барасыз ба?
Dialogue: 0,0:25:21.85,0:25:25.27,Default,,0,0,0,,Мен кешкі ас әзірлеуім керек. Бұл үшін рахмет.
Dialogue: 0,0:25:25.35,0:25:27.69,Default,,0,0,0,,Мм... Ах, мен ақыры байқадым.
Dialogue: 0,0:25:27.77,0:25:29.27,Default,,0,0,0,,Неге үндемедің?
Dialogue: 0,0:25:29.36,0:25:30.65,Default,,0,0,0,,Өйткені мені сұраған жоқ.
Dialogue: 0,0:25:30.86,0:25:33.49,Default,,0,0,0,,Сонымен, тұтынушылар мен қызметкерлер жақсы достар ма?
Dialogue: 0,0:25:38.95,0:25:40.41,Default,,0,0,0,,Ха! Ах!
Dialogue: 0,0:25:41.03,0:25:41.99,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:25:51.59,0:25:52.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:53.17,0:25:54.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:57.97,0:25:59.26,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:26:03.43,0:26:04.27,Default,,0,0,0,,(Құлыптау дыбысы)
Dialogue: 0,0:26:09.02,0:26:10.27,Default,,0,0,0,,(Рикуо жүгіру дыбысы)
Dialogue: 0,0:26:13.11,0:26:14.65,Default,,0,0,0,,Иә? Боқ
Dialogue: 0,0:26:14.73,0:26:16.90,Default,,0,0,0,,Рикуо-кун? Сатан алғыр?
Dialogue: 0,0:26:16.99,0:26:18.07,Default,,0,0,0,,Рикуо-кун!
Dialogue: 0,0:26:18.32,0:26:19.78,Default,,0,0,0,,Қалағаныңды істеу
Dialogue: 0,0:26:20.37,0:26:22.49,Default,,0,0,0,,Ол менікі... отыр!
Dialogue: 0,0:26:25.04,0:26:25.87,Default,,0,0,0,,Иә
Dialogue: 0,0:26:37.01,0:26:39.30,Default,,0,0,0,,Мен сізге бір сусын беремін.
Dialogue: 0,0:26:45.43,0:26:49.39,Default,,0,0,0,,Бұл бала алғаш қашан келді?
Dialogue: 0,0:26:49.69,0:26:51.69,Default,,0,0,0,,Мен басында абдырап қалдым, бірақ...
Dialogue: 0,0:26:51.86,0:26:53.73,Default,,0,0,0,,Бірте-бірте олар бір-біріне ашық бола бастады.
Dialogue: 0,0:26:54.15,0:26:55.73,Default,,0,0,0,,Аша аламыз ба? Иә
Dialogue: 0,0:26:55.82,0:26:57.82,Default,,0,0,0,,Ол менімен әртүрлі нәрселер туралы сөйлесе бастады.
Dialogue: 0,0:26:58.45,0:27:00.28,Default,,0,0,0,,Киім алатын ана
Dialogue: 0,0:27:00.86,0:27:02.74,Default,,0,0,0,,Кейде қорқынышты армандар
Dialogue: 0,0:27:03.24,0:27:05.33,Default,,0,0,0,,Пианинода ойнауды тоқтатқан бала
Dialogue: 0,0:27:06.29,0:27:08.20,Default,,0,0,0,,Сол үшін мен саған өткен күні айттым.
Dialogue: 0,0:27:08.33,0:27:10.58,Default,,0,0,0,,Мен кофені жақсы дайындағым келеді.
Dialogue: 0,0:27:12.29,0:27:14.04,Default,,0,0,0,,Сіз көп нәрсеге алаңдайтын сияқтысыз.
Dialogue: 0,0:27:14.46,0:27:15.50,Default,,0,0,0,,Сіз уайымдап тұрсыз ба?
Dialogue: 0,0:27:15.67,0:27:17.13,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:27:17.21,0:27:21.63,Default,,0,0,0,,Менің істеп жатқаным дұрыс па, әлде бұрыс па?
Dialogue: 0,0:27:23.18,0:27:24.01,Default,,0,0,0,,Иә
Dialogue: 0,0:27:29.18,0:27:31.35,Default,,0,0,0,,Егер сіз жай ғана ережелерді орындасаңыз -
Dialogue: 0,0:27:31.60,0:27:35.27,Default,,0,0,0,,Біз сіздің келуіңізді «Ева Уақыты» кез келген уақытта күтеміз
Dialogue: 0,0:27:38.69,0:27:39.53,Default,,0,0,0,,(құлыпты ашу дыбысы)
Dialogue: 0,0:27:53.21,0:27:55.79,Default,,0,0,0,,...және мен оны сол жерде жоғалтып алдым.
Dialogue: 0,0:27:55.88,0:27:56.80,Default,,0,0,0,,Менің артымнан сыртта жүрдің бе?
Dialogue: 0,0:27:56.88,0:27:59.34,Default,,0,0,0,,Мен сол ноппоның басының жоғарғы жағын тексергім келді.
Dialogue: 0,0:27:59.71,0:28:01.80,Default,,0,0,0,,Дүкенде бірдеңе болып жатқаны сөзсіз.
Dialogue: 0,0:28:01.88,0:28:02.84,Default,,0,0,0,,Ум...
Dialogue: 0,0:28:03.68,0:28:06.22,Default,,0,0,0,,Мен тағы баруды ойлап жүрмін.
Dialogue: 0,0:28:06.35,0:28:07.47,Default,,0,0,0,,Екеуміз далаға шығайық.
Dialogue: 0,0:28:08.01,0:28:09.93,Default,,0,0,0,,Егер бұлай болса, мен жұмбақтарды мұқият ашамын.
Dialogue: 0,0:28:10.02,0:28:11.39,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:28:11.48,0:28:12.56,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:28:12.98,0:28:14.94,Default,,0,0,0,,Робот Сэммиге сәлем айтыңыз
Dialogue: 0,0:28:15.15,0:28:16.15,Default,,0,0,0,,(Ұялы телефонның өшіп тұрған дыбысы)
Dialogue: 0,0:28:23.03,0:28:24.91,Default,,0,0,0,,Сұрақ Бұл не?
Dialogue: 0,0:28:24.99,0:28:26.99,Default,,0,0,0,,Мынау дүкен...
Dialogue: 0,0:28:31.25,0:28:33.54,Default,,0,0,0,,Ұстаз, кешіріңіз...кофе.
Dialogue: 0,0:28:33.96,0:28:35.25,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:28:38.42,0:28:40.09,Default,,0,0,0,,Соңғы кофе
Dialogue: 0,0:28:40.84,0:28:42.76,Default,,0,0,0,,Бұл дәмді болуы мүмкін...
Dialogue: 0,0:28:45.01,0:28:46.43,Default,,0,0,0,,Рахмет
Dialogue: 0,0:28:47.76,0:28:48.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:50.56,0:28:53.18,Default,,0,0,0,,Мен көптеген қызықты нәрселерді көрдім.
Dialogue: 0,0:28:53.27,0:28:54.81,Default,,0,0,0,,Әлі анықталмаса да...
Dialogue: 0,0:28:54.89,0:28:56.60,Default,,0,0,0,,Оның Этика комитетіне қатысы жоқ.
Dialogue: 0,0:28:56.69,0:28:59.36,Default,,0,0,0,,Сонда ол маған соншалықты нашар ілеспес еді.
Dialogue: 0,0:28:59.61,0:29:01.99,Default,,0,0,0,,Біраз уақыт жүзіп, не болатынын көрейік.
Dialogue: 0,0:29:02.40,0:29:03.36,Default,,0,0,0,,Иә.
Dialogue: 0,0:29:05.45,0:29:06.57,Default,,0,0,0,,Бас Ашимори
Dialogue: 0,0:29:06.74,0:29:09.83,Default,,0,0,0,,Қазіргі уақытта даралық қалыптасуда.
Dialogue: 0,0:29:10.20,0:29:11.70,Default,,0,0,0,,Бұл әлдеқашан басылған...
Dialogue: 0,0:29:11.79,0:29:14.21,Default,,0,0,0,,Алдын ала түсінік бізді шындықтан алшақтатады
Dialogue: 0,0:29:14.83,0:29:17.00,Default,,0,0,0,,Шиоцуки осылай айтар еді.
Dialogue: 0,0:29:18.38,0:29:19.75,Default,,0,0,0,,Жалғастыру
Dialogue: 0,0:29:59.38,0:30:01.50,Default,,0,0,0,,Ау, мен ауырып тұрмын.
Dialogue: 0,0:30:16.52,0:30:19.31,Default,,0,0,0,,Соңғы кездері көп емес пе? Бұл жарнама
Dialogue: 0,0:30:19.73,0:30:20.56,Default,,0,0,0,,Ах
Dialogue: 0,0:30:22.15,0:30:23.61,Default,,0,0,0,,Рикуо мәртебесі
Dialogue: 0,0:30:23.69,0:30:26.44,Default,,0,0,0,,Мен 12:03-тен бері даладамын.
Dialogue: 0,0:30:26.57,0:30:28.32,Default,,0,0,0,,Түскі асты сыртта ішетін сияқтымын.
Dialogue: 0,0:30:30.32,0:30:34.79,Default,,0,0,0,,Не айтарымды білмеймін, бірақ мен мұнда күндіз жиі келемін.
Dialogue: 0,0:30:36.16,0:30:37.83,Default,,0,0,0,,Иә... әлсіреп жатырсыз ба?
Dialogue: 0,0:30:38.46,0:30:39.71,Default,,0,0,0,,Мерекелерді ауыстырыңыз
Dialogue: 0,0:30:39.79,0:30:41.54,Default,,0,0,0,,Клерктің айтқаны олай емес.
Dialogue: 0,0:30:41.63,0:30:43.84,Default,,0,0,0,,Кешіріңіз, Рикуо-кун, бәрібір.
Dialogue: 0,0:30:43.92,0:30:46.01,Default,,0,0,0,,Мен Масаки-кунды жаман бала деп ойладым.
Dialogue: 0,0:30:46.09,0:30:48.34,Default,,0,0,0,,Мен стипендиатпын, сіз таң қалатын шығарсыз.
Dialogue: 0,0:30:48.42,0:30:49.68,Default,,0,0,0,,Қажетсіз ештеңе айтпаңыз.
Dialogue: 0,0:30:49.76,0:30:51.09,Default,,0,0,0,,Менің жасыратын ештеңем жоқ
Dialogue: 0,0:30:51.43,0:30:54.60,Default,,0,0,0,,Әй, сөйлесетін басқа біреу бар.
Dialogue: 0,0:30:55.22,0:30:56.39,Default,,0,0,0,,Бұл мүлде ақылға сыймайды
Dialogue: 0,0:30:59.19,0:31:00.52,Default,,0,0,0,,Ақыр соңында
Dialogue: 0,0:31:00.60,0:31:02.61,Default,,0,0,0,,Тамақ бергеніңе рахмет, жарайсың.
Dialogue: 0,0:31:02.69,0:31:04.86,Default,,0,0,0,,Кешкі астан кейін мен саған Эвелендті әкелемін.
Dialogue: 0,0:31:06.53,0:31:07.99,Default,,0,0,0,,Эвеленд Эвеленд
Dialogue: 0,0:31:08.07,0:31:08.90,Default,,0,0,0,,Не?
Dialogue: 0,0:31:08.99,0:31:10.70,Default,,0,0,0,,Қолайсыздық жойылды, хаха...
Dialogue: 0,0:31:10.78,0:31:13.41,Default,,0,0,0,,Ах~ Оқу көзілдірігі жоқ.
Dialogue: 0,0:31:13.49,0:31:14.91,Default,,0,0,0,,Маған Чи Чанды қайтарыңыз~
Dialogue: 0,0:31:14.99,0:31:16.37,Default,,0,0,0,,Бұл мысық~
Dialogue: 0,0:31:17.66,0:31:19.46,Default,,0,0,0,,Бұл жерде жай отырудың қажеті жоқ шығар.
Dialogue: 0,0:31:19.54,0:31:22.08,Default,,0,0,0,,Мен бұл дүкеннің не екенін білгім келеді.
Dialogue: 0,0:31:22.21,0:31:24.63,Default,,0,0,0,,Менің роботтармен танысуға ниетім жоқ.
Dialogue: 0,0:31:25.09,0:31:26.75,Default,,0,0,0,,Акикодан басқа мен әлі білмеймін.
Dialogue: 0,0:31:26.84,0:31:28.76,Default,,0,0,0,,Бұл туралы не деуге болады? дұрысырақ
Dialogue: 0,0:31:29.59,0:31:32.14,Default,,0,0,0,,Дори типті адам андроидін өзімен бірге алып келе жатыр.
Dialogue: 0,0:31:32.43,0:31:33.26,Default,,0,0,0,,А...
Dialogue: 0,0:31:33.34,0:31:36.06,Default,,0,0,0,,Маған қосымша түсініктеме қажет емес.
Dialogue: 0,0:31:39.39,0:31:40.73,Default,,0,0,0,,Қайда қарап тұрсың? Не!
Dialogue: 0,0:31:40.81,0:31:41.98,Default,,0,0,0,,Сен, мен көрген жоқпын.
Dialogue: 0,0:31:42.06,0:31:43.02,Default,,0,0,0,,Көрдім мен көрмедім
Dialogue: 0,0:31:43.10,0:31:44.23,Default,,0,0,0,,Жоқ, мен көрмедім!
Dialogue: 0,0:31:44.31,0:31:45.15,Default,,0,0,0,,Мен көрдім, көрмедім!
Dialogue: 0,0:31:45.23,0:31:46.32,Default,,0,0,0,,Мен сені көрдім. Біз жақсы доспыз.
Dialogue: 0,0:31:46.40,0:31:47.57,Default,,0,0,0,,Маған олай емес деп ешқашан айтқан емес.
Dialogue: 0,0:31:47.65,0:31:49.19,Default,,0,0,0,,Тіпті екі адам көңілді болса да—
Dialogue: 0,0:31:49.28,0:31:50.11,Default,,0,0,0,,Мен сені сағындым...
Dialogue: 0,0:31:50.19,0:31:51.91,Default,,0,0,0,,Келесіде маған біртүрлі қарасаң... Мен саған қарамаймын деймін.
Dialogue: 0,0:31:51.99,0:31:53.20,Default,,0,0,0,,Не...
Dialogue: 0,0:31:54.07,0:31:55.45,Default,,0,0,0,,Мен Коджи-кунды қызғанамын.
Dialogue: 0,0:31:55.53,0:31:58.45,Default,,0,0,0,,Қызық екен, солай емес пе?
Dialogue: 0,0:31:58.62,0:31:59.54,Default,,0,0,0,,Тек осы екі қарапайым белгіні есте сақта.
Dialogue: 0,0:32:00.33,0:32:02.12,Default,,0,0,0,,Эй, сен неге келмейсің?
Dialogue: 0,0:32:09.67,0:32:11.22,Default,,0,0,0,,Қараңғы! Қорқынышты
Dialogue: 0,0:32:11.34,0:32:13.55,Default,,0,0,0,,Қажетсіз ештеңе жасамаған дұрыс емес пе?
Dialogue: 0,0:32:13.64,0:32:14.76,Default,,0,0,0,,Бұл қажет емес пе?
Dialogue: 0,0:32:14.84,0:32:17.06,Default,,0,0,0,,Оны автономияға қалдыру орынды деп ойлаймын.
Dialogue: 0,0:32:17.14,0:32:19.64,Default,,0,0,0,,Төрт адаммен сөйлесу оңай емес пе?
Dialogue: 0,0:32:19.77,0:32:20.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:36.07,0:32:36.91,Default,,0,0,0,,Иә
Dialogue: 0,0:32:38.79,0:32:41.00,Default,,0,0,0,,Оның аты Кожи, ал менің атым Рина.
Dialogue: 0,0:32:41.08,0:32:42.16,Default,,0,0,0,,Сәлем
Dialogue: 0,0:32:45.96,0:32:47.59,Default,,0,0,0,,Мен Масакимін, бұл жігіт Рикуо
Dialogue: 0,0:32:47.67,0:32:48.75,Default,,0,0,0,,Келесі жолы мен оны көремін.
Dialogue: 0,0:32:48.84,0:32:50.00,Default,,0,0,0,,Мен оны көрген жоқпын.
Dialogue: 0,0:32:50.42,0:32:51.71,Default,,0,0,0,,Сіз оны көрдіңіз бе? Бейсаналық?
Dialogue: 0,0:32:51.80,0:32:53.01,Default,,0,0,0,,Біз жақсы доспыз, солай емес пе?
Dialogue: 0,0:32:53.09,0:32:54.47,Default,,0,0,0,,Маған олай емес деп ешқашан айтқан емес.
Dialogue: 0,0:32:54.55,0:32:56.34,Default,,0,0,0,,Солай емес пе... а?
Dialogue: 0,0:33:05.60,0:33:06.44,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:33:06.52,0:33:07.40,Default,,0,0,0,,Иә? Мияу
Dialogue: 0,0:33:13.03,0:33:15.53,Default,,0,0,0,,А, сен мұнда жиі келесің.
Dialogue: 0,0:33:18.03,0:33:18.87,Default,,0,0,0,,Иә
Dialogue: 0,0:33:20.91,0:33:21.74,Default,,0,0,0,,Иә
Dialogue: 0,0:33:25.42,0:33:26.83,Default,,0,0,0,,Екеуің бірге келе жатырсыңдар ма?
Dialogue: 0,0:33:27.04,0:33:28.17,Default,,0,0,0,,Жоқ, олар бөлек.
Dialogue: 0,0:33:35.38,0:33:37.55,Default,,0,0,0,,Әдемі серпіліп жатыр Ахахха
Dialogue: 0,0:33:38.05,0:33:40.22,Default,,0,0,0,,Ах! Бұл Cinematide ма?
Dialogue: 0,0:33:40.35,0:33:42.64,Default,,0,0,0,,Не? Иә
Dialogue: 0,0:33:42.72,0:33:43.89,Default,,0,0,0,,Мен оны көре аламын ба?
Dialogue: 0,0:33:43.98,0:33:46.14,Default,,0,0,0,,А... иә
Dialogue: 0,0:33:46.73,0:33:47.27,Default,,0,0,0,,Ал...
Dialogue: 0,0:33:47.27,0:33:47.56,Default,,0,0,0,,Ал...
Dialogue: 0,0:33:47.27,0:33:47.56,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:33:47.56,0:33:47.65,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:33:47.65,0:33:48.81,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:33:47.65,0:33:48.81,Default,,0,0,0,,Сол жерге ауысыңыз
Dialogue: 0,0:33:48.81,0:33:48.98,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:33:49.31,0:33:52.19,Default,,0,0,0,,Әй, әдемі екен. Мен алдын ала қарауды көре аламын ба?
Dialogue: 0,0:33:52.28,0:33:52.98,Default,,0,0,0,,Иә, сол жерде үшбұрышты басыңыз.
Dialogue: 0,0:33:52.98,0:33:53.61,Default,,0,0,0,,Иә, сол жерде үшбұрышты басыңыз.
Dialogue: 0,0:33:52.98,0:33:53.61,Default,,0,0,0,,Тақырып құру, солай ма?
Dialogue: 0,0:33:53.61,0:33:53.78,Default,,0,0,0,,Тақырып құру, солай ма?
Dialogue: 0,0:33:53.78,0:33:54.24,Default,,0,0,0,,Тақырып құру, солай ма?
Dialogue: 0,0:33:53.78,0:33:54.24,Default,,0,0,0,,өтіңіз
Dialogue: 0,0:33:54.24,0:33:54.78,Default,,0,0,0,,өтіңіз
Dialogue: 0,0:33:55.36,0:33:56.90,Default,,0,0,0,,Өйткені менде 500 жүктелген.
Dialogue: 0,0:33:56.99,0:33:57.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:33:58.49,0:33:59.57,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:34:00.16,0:34:01.87,Default,,0,0,0,,M LINK, сондықтан мүмкін... (Коджи) А, а...
Dialogue: 0,0:34:12.42,0:34:13.34,Default,,0,0,0,,Ах
Dialogue: 0,0:34:13.88,0:34:14.71,Default,,0,0,0,,Ах
Dialogue: 0,0:34:16.30,0:34:18.05,Default,,0,0,0,,(Кёсукэ Хори) Егер әке кетіп қалса—
Dialogue: 0,0:34:23.97,0:34:24.81,Default,,0,0,0,,Иә
Dialogue: 0,0:34:25.52,0:34:27.27,Default,,0,0,0,,Cinematai шынымен жақсы.
Dialogue: 0,0:34:27.69,0:34:29.94,Default,,0,0,0,,Олай болса, осындай нәрсе.
Dialogue: 0,0:34:30.86,0:34:31.90,Default,,0,0,0,,Уау~
Dialogue: 0,0:34:48.29,0:34:49.71,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:34:50.42,0:34:51.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:52.79,0:34:53.80,Default,,0,0,0,,Ол алыс.
Dialogue: 0,0:34:54.38,0:34:55.63,Default,,0,0,0,,Сенің жүрегің
Dialogue: 0,0:34:56.80,0:35:00.68,Default,,0,0,0,,Қанша кездессек те, қанша жақын болсақ та, өзімді жайсыз сезінемін...
Dialogue: 0,0:35:01.89,0:35:04.14,Default,,0,0,0,,Мен оның себебін түсіндім.
Dialogue: 0,0:35:07.06,0:35:08.10,Default,,0,0,0,,Ах
Dialogue: 0,0:35:09.19,0:35:11.81,Default,,0,0,0,,Өтінемін, мені жалғыз қалдырмаңыз
Dialogue: 0,0:35:12.52,0:35:13.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:14.07,0:35:16.73,Default,,0,0,0,,Бұл драма. Бұл менің кінәм... Шамасы.
Dialogue: 0,0:35:16.82,0:35:17.78,Default,,0,0,0,,Бұл сенің кінәң.
Dialogue: 0,0:35:17.99,0:35:19.45,Default,,0,0,0,,Иә, күткенім үшін кешіріңіз.
Dialogue: 0,0:35:19.53,0:35:20.99,Default,,0,0,0,,Не?
Dialogue: 0,0:35:22.07,0:35:23.32,Default,,0,0,0,,Не?
Dialogue: 0,0:35:23.62,0:35:25.16,Default,,0,0,0,,Мен бірдеңе істеймін!
Dialogue: 0,0:35:25.87,0:35:26.74,Default,,0,0,0,,Не болды?
Dialogue: 0,0:35:27.08,0:35:29.54,Default,,0,0,0,,Ал, бұл не, хаос көрінісі?
Dialogue: 0,0:36:12.37,0:36:13.29,Default,,0,0,0,,Мальтаға келу
Dialogue: 0,0:36:21.47,0:36:24.14,Default,,0,0,0,,Мен шебердің жолсерігін орындадым.
Dialogue: 0,0:36:24.22,0:36:26.01,Default,,0,0,0,,Ах, сосын Кожи-сан.
Dialogue: 0,0:36:27.85,0:36:29.22,Default,,0,0,0,,Мен немен айналыстым?
Dialogue: 0,0:36:29.35,0:36:31.64,Default,,0,0,0,,Алғашқы көмек көрсету шаралары толық болмаған сияқты.
Dialogue: 0,0:36:32.27,0:36:34.48,Default,,0,0,0,,Коджи осында...
Dialogue: 0,0:36:34.56,0:36:36.15,Default,,0,0,0,,Сіз қожайыныңыздың күзетшісін айтасыз ба?
Dialogue: 0,0:36:36.23,0:36:38.48,Default,,0,0,0,,Жоқ, бұл менің өз еркім.
Dialogue: 0,0:36:38.57,0:36:41.11,Default,,0,0,0,,Оны жөндеуге өндірушіге жіберген дұрыс...
Dialogue: 0,0:36:44.61,0:36:47.95,Default,,0,0,0,,Мен уәкілетті өндірушімен қарым-қатынас жасай алмаймын
Dialogue: 0,0:36:48.58,0:36:53.12,Default,,0,0,0,,Егер өндіруші мен туралы білсе, шебердің қолайсыз жағдайы болады.
Dialogue: 0,0:36:54.21,0:36:57.75,Default,,0,0,0,,Одан да мен мұнда мүмкіндігінше ұзақ қалғым келеді.
Dialogue: 0,0:36:58.29,0:37:00.09,Default,,0,0,0,,Жөндеу жұмыстары жүргізілмейді
Dialogue: 0,0:37:01.55,0:37:05.72,Default,,0,0,0,,Бұл дүкенде өзін ең аз адамдық ұстайтын адам менмін.
Dialogue: 0,0:37:06.30,0:37:07.30,Default,,0,0,0,,Сонымен қатар, дәптерге қол тимейінше Шinigami-ді көре алмайсың – онда қалай…
Dialogue: 0,0:37:09.10,0:37:12.60,Default,,0,0,0,,Мен кез келген уақытта жойылуы мүмкін.
Dialogue: 0,0:37:13.73,0:37:16.35,Default,,0,0,0,,Сондықтан оқыту функциясы ешқашан қолданылмайды.
Dialogue: 0,0:37:16.44,0:37:19.32,Default,,0,0,0,,Менің ойымша, олар өзін-өзі қамтамасыз ететін қарсылық көрсетеді.
Dialogue: 0,0:37:20.73,0:37:25.99,Default,,0,0,0,,Коджи маған адам әйеліндей қарайды.
Dialogue: 0,0:37:26.61,0:37:30.58,Default,,0,0,0,,Сондықтан мен мұнда бақыттымын деп ойлаймын.
Dialogue: 0,0:37:31.20,0:37:33.79,Default,,0,0,0,,Бірақ фотодағы әйел...
Dialogue: 0,0:37:34.00,0:37:35.46,Default,,0,0,0,,Сен мейірімдісің, солай ма?
Dialogue: 0,0:37:35.96,0:37:37.33,Default,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,0:37:37.79,0:37:40.38,Default,,0,0,0,,Өйткені Коджидің мейірімділігі өзгермейді деп ойлаймын.
Dialogue: 0,0:37:45.42,0:37:47.93,Default,,0,0,0,,Мен қайтып келемін.
Dialogue: 0,0:37:53.60,0:37:54.56,Default,,0,0,0,,Осымен
Dialogue: 0,0:37:56.39,0:37:57.52,Default,,0,0,0,,Кофе...
Dialogue: 0,0:38:00.65,0:38:02.61,Default,,0,0,0,,Кофенің дәмі өзгерді...
Dialogue: 0,0:38:02.78,0:38:04.53,Default,,0,0,0,,Басында мен ашуландым, бірақ—
Dialogue: 0,0:38:04.69,0:38:07.36,Default,,0,0,0,,Мен көп нәрсені білгенде, өзімді біраз бақытты сезіндім...
Dialogue: 0,0:38:07.45,0:38:09.95,Default,,0,0,0,,Ал, басқа адам адам емес...
Dialogue: 0,0:38:11.66,0:38:12.66,Default,,0,0,0,,Айтыңыз
Dialogue: 0,0:38:12.74,0:38:14.95,Default,,0,0,0,,Басқа адам адам болса да не айтқыңыз келеді
Dialogue: 0,0:38:16.46,0:38:18.83,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:38:23.42,0:38:24.26,Default,,0,0,0,,Ах
Dialogue: 0,0:38:25.67,0:38:28.84,Default,,0,0,0,,Менің сол кездегі сезімімді білесің.
Dialogue: 0,0:38:29.43,0:38:30.43,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:38:31.97,0:38:34.06,Default,,0,0,0,,А... Мен осылай айта бастадым...
Dialogue: 0,0:38:34.14,0:38:34.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:36.60,0:38:38.73,Default,,0,0,0,,Сонда бұл сүйіктісі ме?
Dialogue: 0,0:38:38.89,0:38:39.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:40.56,0:38:42.65,Default,,0,0,0,,Мен бұл туралы біраз уақыттан бері қызық болдым.
Dialogue: 0,0:38:42.82,0:38:45.94,Default,,0,0,0,,Лина екеуің бірге түскен бірде-бір сурет жоқ.
Dialogue: 0,0:38:46.40,0:38:48.20,Default,,0,0,0,,Мен суретке түсіре алмаймын.
Dialogue: 0,0:38:48.28,0:38:50.70,Default,,0,0,0,,Ғашық болып ойнайтынымызды білсек, жаман болар еді.
Dialogue: 0,0:38:51.53,0:38:53.53,Default,,0,0,0,,Жоқ. Бұл да робот па?
Dialogue: 0,0:38:53.62,0:38:54.74,Default,,0,0,0,,Робот емес
Dialogue: 0,0:38:54.99,0:38:56.37,Default,,0,0,0,,Сонда бәрі жақсы.
Dialogue: 0,0:38:56.50,0:38:57.58,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:38:57.66,0:38:59.46,Default,,0,0,0,,Біз ғашықтар ойнайтын сияқты емеспіз
Dialogue: 0,0:39:00.17,0:39:02.00,Default,,0,0,0,,Сонда сіз байсалдысыз ба?
Dialogue: 0,0:39:02.08,0:39:02.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:03.29,0:39:06.55,Default,,0,0,0,,Менің ойымша, сізде махаббат бар екенін ескермеу керек.
Dialogue: 0,0:39:13.55,0:39:15.10,Default,,0,0,0,,Мынаны айтқыңыз келеді
Dialogue: 0,0:39:15.93,0:39:18.85,Default,,0,0,0,,Адамның серігі - адамдар үшін ең жақсысы...
Dialogue: 0,0:39:19.14,0:39:20.52,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:39:22.90,0:39:24.07,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:39:24.90,0:39:25.90,Default,,0,0,0,,Мен білемін...
Dialogue: 0,0:39:27.74,0:39:29.65,Default,,0,0,0,,Сіз айтқандай, Лина екеуміз...
Dialogue: 0,0:39:29.74,0:39:31.82,Default,,0,0,0,,Бұл жай ғана адамдар мен андроидтар арасындағы қарым-қатынас.
Dialogue: 0,0:39:32.07,0:39:33.70,Default,,0,0,0,,Менің ойымша, біз түсінбейтін нәрселер бар.
Dialogue: 0,0:39:33.78,0:39:35.49,Default,,0,0,0,,Бір-бірімізді түсінуге мүмкіндік жоқ.
Dialogue: 0,0:39:37.08,0:39:38.12,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:39:39.50,0:39:41.21,Default,,0,0,0,,Мен өз шеберіме көмектескім келеді.
Dialogue: 0,0:39:43.96,0:39:44.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:45.59,0:39:46.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:48.46,0:39:51.22,Default,,0,0,0,,Менің шеберім Линаға өте ұқсас
Dialogue: 0,0:39:51.72,0:39:53.93,Default,,0,0,0,,Мен шеберге көмектескім келеді
Dialogue: 0,0:40:00.18,0:40:02.77,Default,,0,0,0,,Мен кеше де неше түрлі адамдарды көрдім.
Dialogue: 0,0:40:04.02,0:40:05.73,Default,,0,0,0,,Ято-чан мен басқалар қайта оралған сияқты.
Dialogue: 0,0:40:12.24,0:40:13.86,Default,,0,0,0,,Бірақ шебер
Dialogue: 0,0:40:15.49,0:40:18.49,Default,,0,0,0,,Мастер жаңа серіктес табуы керек
Dialogue: 0,0:40:18.87,0:40:20.00,Default,,0,0,0,,Адам... (Әйел) А...
Dialogue: 0,0:40:22.92,0:40:25.08,Default,,0,0,0,,Жетер, мен шаршадым.
Dialogue: 0,0:40:25.75,0:40:27.13,Default,,0,0,0,,Коджи жақсы
Dialogue: 0,0:40:27.84,0:40:29.71,Default,,0,0,0,,Мен робот боламын
Dialogue: 0,0:40:30.80,0:40:32.30,Default,,0,0,0,,Мәңгілік қасымда бол
Dialogue: 0,0:40:33.47,0:40:35.55,Default,,0,0,0,,Ұстаз маған толықтай тәуелді.
Dialogue: 0,0:40:35.93,0:40:38.14,Default,,0,0,0,,Бірақ мен не істерімді білмедім
Dialogue: 0,0:40:39.01,0:40:40.43,Default,,0,0,0,,Мен Линамен кездескен кезде—
Dialogue: 0,0:40:40.52,0:40:42.98,Default,,0,0,0,,Мен бұл кісіні шебердің қасында деп ойладым.
Dialogue: 0,0:40:43.23,0:40:44.73,Default,,0,0,0,,Тіпті маған қол тигізу қимылы -
Dialogue: 0,0:40:44.90,0:40:46.61,Default,,0,0,0,,Мен кейде көрсететін өрнектер—
Dialogue: 0,0:40:46.86,0:40:50.19,Default,,0,0,0,,Мен Лина туралы көбірек білгім келеді және Ұстазды түсінгім келеді.
Dialogue: 0,0:40:50.78,0:40:52.40,Default,,0,0,0,,Мен өз шеберіме көмектескім келеді.
Dialogue: 0,0:40:53.45,0:40:54.74,Default,,0,0,0,,1-бап
Dialogue: 0,0:40:55.95,0:40:58.91,Default,,0,0,0,,Линаны бұл туралы үндемей қоя аласыз ба?
Dialogue: 0,0:41:00.70,0:41:01.79,Default,,0,0,0,,Дүкен ережелері?
Dialogue: 0,0:41:04.12,0:41:06.46,Default,,0,0,0,,Ешкімге зиян келтіруге болмайды.
Dialogue: 0,0:41:07.13,0:41:08.29,Default,,0,0,0,,Бұл өзімшілдік.
Dialogue: 0,0:41:09.38,0:41:10.84,Default,,0,0,0,,Сен керексіз адам емессің бе?
Dialogue: 0,0:41:11.26,0:41:12.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:41:13.51,0:41:16.18,Default,,0,0,0,,Менің ойымша, бәрі бірдей бақытты бола алмайды.
Dialogue: 0,0:41:18.35,0:41:19.18,Default,,0,0,0,,Ах
Dialogue: 0,0:41:30.07,0:41:30.90,Default,,0,0,0,,Рахмет
Dialogue: 0,0:41:32.49,0:41:33.36,Default,,0,0,0,,О
Dialogue: 0,0:41:36.82,0:41:38.41,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:41:38.49,0:41:39.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:45.96,0:41:47.58,Default,,0,0,0,,Заттың түрі көп.
Dialogue: 0,0:41:48.33,0:41:50.21,Default,,0,0,0,,Адамдар? Андроид да
Dialogue: 0,0:41:50.54,0:41:51.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:53.67,0:41:55.42,Default,,0,0,0,,Сені ұрғаным жаман болды, иә?
Dialogue: 0,0:41:55.59,0:41:57.43,Default,,0,0,0,,Көздеріңіз дұрыс болды.
Dialogue: 0,0:41:57.51,0:41:58.89,Default,,0,0,0,,Мен де мұқият қарауым керек еді.
Dialogue: 0,0:41:58.97,0:41:59.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:00.01,0:42:00.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:01.97,0:42:03.60,Default,,0,0,0,,Масаки, иә?
Dialogue: 0,0:42:04.27,0:42:05.10,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:42:05.18,0:42:07.35,Default,,0,0,0,,Мен жасөспірім орта мектеп оқушысымын ба?
Dialogue: 0,0:42:15.36,0:42:16.24,Default,,0,0,0,,Иә? сурет?
Dialogue: 0,0:42:16.82,0:42:18.66,Default,,0,0,0,,Бірақ Лина... жоқ, бәрі керісінше.
Dialogue: 0,0:42:23.37,0:42:25.08,Default,,0,0,0,,- бұл ~
Dialogue: 0,0:42:27.33,0:42:29.79,Default,,0,0,0,,Тоқта, Лина не деді?
Dialogue: 0,0:42:30.17,0:42:31.67,Default,,0,0,0,,Коджи осында келеді
Dialogue: 0,0:42:31.75,0:42:33.92,Default,,0,0,0,,Сонда... қожайыныңыздың күзетшісі ме?
Dialogue: 0,0:42:34.00,0:42:34.84,Default,,0,0,0,,Жоқ
Dialogue: 0,0:42:35.01,0:42:35.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:35.97,0:42:37.63,Default,,0,0,0,,Менің қожайын Кодзи қандай?
Dialogue: 0,0:42:37.72,0:42:39.01,Default,,0,0,0,,Бір ауыз сөз айтпа
Dialogue: 0,0:42:39.09,0:42:39.93,Default,,0,0,0,,(Сора) Ах, бірақ… (Стефани) О!
Dialogue: 0,0:42:40.01,0:42:42.30,Default,,0,0,0,,Дүкеннің сыртындағы екі адам бір-біріне қатысы жоқ.
Dialogue: 0,0:42:42.39,0:42:43.93,Default,,0,0,0,,Ах... Бірақ екеуі де...
Dialogue: 0,0:42:44.01,0:42:45.22,Default,,0,0,0,,Ол адаммын дейді.
Dialogue: 0,0:42:45.31,0:42:47.48,Default,,0,0,0,,Сәйкессіздіктер бар. Yes, күттіргеніме кешірім сұраймын.
Dialogue: 0,0:42:49.23,0:42:51.65,Default,,0,0,0,,Мүмкін біз бір-бірімізді байқамаймыз.
Dialogue: 0,0:42:52.11,0:42:54.11,Default,,0,0,0,,Иә, міне, кеңес
Dialogue: 0,0:42:55.32,0:42:56.15,Default,,0,0,0,,А...
Dialogue: 0,0:42:58.61,0:43:00.74,Default,,0,0,0,,Дәл солай, дұрыс түсіндіріңізші.
Dialogue: 0,0:43:00.86,0:43:04.29,Default,,0,0,0,,Басқа адамның кім екенін білмейтін андроидтерде де солай.
Dialogue: 0,0:43:05.49,0:43:07.79,Default,,0,0,0,,Бұл екеуі бір-біріне қызығады.
Dialogue: 0,0:43:07.87,0:43:09.04,Default,,0,0,0,,Басқа себеппен
Dialogue: 0,0:43:09.12,0:43:10.87,Default,,0,0,0,,Кейде біз заттарды бір-бірімізден жасырамыз
Dialogue: 0,0:43:10.96,0:43:12.17,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:43:12.67,0:43:14.09,Default,,0,0,0,,Кәдімгі махаббат хикаясына ұқсайды
Dialogue: 0,0:43:14.80,0:43:16.17,Default,,0,0,0,,Жақсы нәрсе айтыңыз
Dialogue: 0,0:43:16.34,0:43:19.05,Default,,0,0,0,,Бірақ маған көп кедергі жасама.
Dialogue: 0,0:43:20.30,0:43:22.18,Default,,0,0,0,,Андроидтар арасындағы махаббат
Dialogue: 0,0:43:22.26,0:43:22.93,Default,,0,0,0,,Псевдо махаббат...
Dialogue: 0,0:43:22.93,0:43:23.68,Default,,0,0,0,,Псевдо махаббат...
Dialogue: 0,0:43:22.93,0:43:23.68,Default,,0,0,0,,Сонымен, кешегі фотодағы әйел кім?
Dialogue: 0,0:43:23.68,0:43:25.81,Default,,0,0,0,,Сонымен, кешегі фотодағы әйел кім?
Dialogue: 0,0:43:25.81,0:43:26.52,Default,,0,0,0,,Сонымен, кешегі фотодағы әйел кім?
Dialogue: 0,0:43:25.81,0:43:26.52,Default,,0,0,0,,Ал...
Dialogue: 0,0:43:26.52,0:43:26.64,Default,,0,0,0,,Ал...
Dialogue: 0,0:43:26.81,0:43:28.39,Default,,0,0,0,,Андроид махаббат үшбұрышында
Dialogue: 0,0:43:28.48,0:43:31.77,Default,,0,0,0,,Түсіндіру қиын. Түсіндіру қиын әйел?
Dialogue: 0,0:43:31.85,0:43:33.44,Default,,0,0,0,,Андроид – нәпсіқұмарлықтың шырмауы
Dialogue: 0,0:43:33.52,0:43:35.19,Default,,0,0,0,,Біртүрлі жетістіктерге жол бермеңіз.
Dialogue: 0,0:43:35.48,0:43:36.61,Default,,0,0,0,,Мен оны бір күні түсіндіремін.
Dialogue: 0,0:43:36.69,0:43:38.07,Default,,0,0,0,,Жоқ... солай ма?
Dialogue: 0,0:43:47.66,0:43:49.66,Default,,0,0,0,,Қош келдіңіз, ұстаз.
Dialogue: 0,0:43:57.09,0:43:58.76,Default,,0,0,0,,Басыңа не киіп жүрсің?
Dialogue: 0,0:44:00.67,0:44:02.05,Default,,0,0,0,,Сізге ұнайды ма?
Dialogue: 0,0:44:02.13,0:44:02.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:45:41.40,0:45:43.57,Default,,0,0,0,,Этика жөніндегі комитеттің сұрауы
Dialogue: 0,0:45:44.57,0:45:47.28,Default,,0,0,0,,Қазіргі уақытта Әдеп жөніндегі комитетте—
Dialogue: 0,0:45:47.36,0:45:50.41,Default,,0,0,0,,Шебердің бақылауынан тыс қалды —
Dialogue: 0,0:45:50.49,0:45:53.29,Default,,0,0,0,,Біз кезбе роботтарды өз еркімен қайтарып алуды жалғастырамыз.
Dialogue: 0,0:45:53.62,0:45:57.46,Default,,0,0,0,,Роботтың күдікті әрекетін байқасаңыз, дереу көрсетілген нөмірге хабарласыңыз...
Dialogue: 0,0:46:00.54,0:46:03.84,Default,,0,0,0,,Бұл нені бейнелейді?
Dialogue: 0,0:46:04.21,0:46:06.26,Default,,0,0,0,,Сіз өзіңізді білмейсіз бе?
Dialogue: 0,0:46:06.34,0:46:08.22,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:46:08.30,0:46:10.47,Default,,0,0,0,,Иә, бұл... суреті.
Dialogue: 0,0:46:26.86,0:46:27.74,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:46:28.16,0:46:29.57,Default,,0,0,0,,...Ал, тұтынушылар жоқ.
Dialogue: 0,0:46:29.66,0:46:31.07,Default,,0,0,0,,Жоқ... Иә?
Dialogue: 0,0:46:31.41,0:46:32.70,Default,,0,0,0,,Қызық, ол қайтып кетті ме?
Dialogue: 0,0:46:32.83,0:46:35.58,Default,,0,0,0,,Бұл көптеген жағынан біртүрлі дүкен.
Dialogue: 0,0:46:35.75,0:46:37.50,Default,,0,0,0,,О, сен білесің... мм...
Dialogue: 0,0:46:37.62,0:46:39.75,Default,,0,0,0,,Наги-сан, сен мұнда неге жұмыс істейсің?
Dialogue: 0,0:46:39.83,0:46:42.50,Default,,0,0,0,,Наги жақсы, маған бұл жер ұнайды.
Dialogue: 0,0:46:42.63,0:46:44.17,Default,,0,0,0,,Мұнда да келетін адамдар.
Dialogue: 0,0:46:44.84,0:46:46.22,Default,,0,0,0,,Бүгінгідей -
Dialogue: 0,0:46:46.30,0:46:49.38,Default,,0,0,0,,Сүйікті тұтынушыларымның жүзін көре алмай, өзімді жалғыз сезінемін.
Dialogue: 0,0:46:49.47,0:46:52.14,Default,,0,0,0,,А... біз ше?
Dialogue: 0,0:46:52.22,0:46:53.47,Default,,0,0,0,,Не? не?
Dialogue: 0,0:46:56.64,0:46:58.23,Default,,0,0,0,,Бұл толтыру...
Dialogue: 0,0:46:58.73,0:46:59.56,Default,,0,0,0,,Ах
Dialogue: 0,0:47:00.73,0:47:03.27,Default,,0,0,0,,Мен бұршақты алып шығамын. Сәл күте тұрыңыз.
Dialogue: 0,0:47:03.77,0:47:05.15,Default,,0,0,0,,Сабыр етіңіз.
Dialogue: 0,0:47:09.78,0:47:11.57,Default,,0,0,0,,Бұл шынымен тыныш.
Dialogue: 0,0:47:34.10,0:47:35.89,Default,,0,0,0,,UH түрі иә?
Dialogue: 0,0:47:36.22,0:47:38.52,Default,,0,0,0,,Бастауыш мектепте оқып жүргенде пайда болған хаусероид
Dialogue: 0,0:47:38.60,0:47:39.43,Default,,0,0,0,,Ол әлі де сонда болды.
Dialogue: 0,0:47:39.52,0:47:40.60,Default,,0,0,0,,Мен оны бұрын ешқашан көрген емеспін.
Dialogue: 0,0:47:40.69,0:47:44.11,Default,,0,0,0,,Мен оны көп пайдаланбадым, себебі оны пайдалану қиынға соғады деген шағымдар көп болды.
Dialogue: 0,0:47:51.45,0:47:52.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:55.78,0:47:57.70,Default,,0,0,0,,Уау, дірілдеп тұр.
Dialogue: 0,0:48:12.18,0:48:13.22,Default,,0,0,0,,Дүкендегі бизнес?
Dialogue: 0,0:48:13.39,0:48:16.56,Default,,0,0,0,,Біз тұтынушылармыз. Тұтынушы: Түсінесіз бе?
Dialogue: 0,0:48:16.97,0:48:18.64,Default,,0,0,0,,Мен де тұтынушымын
Dialogue: 0,0:48:18.81,0:48:19.64,Default,,0,0,0,,Иә? сурет?
Dialogue: 0,0:48:20.73,0:48:21.56,Default,,0,0,0,,Хаха
Dialogue: 0,0:48:22.14,0:48:26.27,Default,,0,0,0,,Эй, мен Масакимін, бұл Рикуо, ал сен бе?
Dialogue: 0,0:48:26.36,0:48:27.73,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:48:28.23,0:48:30.82,Default,,0,0,0,,Әдетте адамдар өзін таныстырады.
Dialogue: 0,0:48:31.90,0:48:35.41,Default,,0,0,0,,Өзін-өзі таныстыру маған атымды айту дегенді білдіреді.
Dialogue: 0,0:48:35.41,0:48:37.33,Default,,0,0,0,,Өзін-өзі таныстыру маған атымды айту дегенді білдіреді.
Dialogue: 0,0:48:35.41,0:48:37.33,Default,,0,0,0,,Мына жігіт адам кейіп танытып отыр.
Dialogue: 0,0:48:37.41,0:48:39.29,Default,,0,0,0,,Хаха, мен ережелерді орындадым.
Dialogue: 0,0:48:39.83,0:48:42.16,Default,,0,0,0,,Иә, бұл... суреті.
Dialogue: 0,0:48:43.54,0:48:44.37,Default,,0,0,0,,Мен—
Dialogue: 0,0:48:44.50,0:48:45.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:48:45.42,0:48:46.54,Default,,0,0,0,,Менің атым...
Dialogue: 0,0:48:48.09,0:48:50.26,Default,,0,0,0,,Неліктен құлағыңызды жабасыз?
Dialogue: 0,0:48:50.46,0:48:54.68,Default,,0,0,0,,Бізге аты-жөніңізді айтпайынша, сіздің кіріспеңіз аяқталмайды.
Dialogue: 0,0:48:54.76,0:48:58.89,Default,,0,0,0,,Сондықтан мен адам екенімді дәлелдей алмаймын.
Dialogue: 0,0:48:59.22,0:49:00.81,Default,,0,0,0,,Менің атым-
Dialogue: 0,0:49:00.89,0:49:02.10,Default,,0,0,0,,Уф!
Dialogue: 0,0:49:02.18,0:49:04.27,Default,,0,0,0,,Ештеңе етпейді, оны мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:49:04.35,0:49:05.48,Default,,0,0,0,,Шындығында, 2-сыныпты үш тәжірибеші мен бір 1-сыныпты тәжірибеші қызмет барысында қаза тапты.
Dialogue: 0,0:49:05.56,0:49:06.73,Default,,0,0,0,,Ендеше өзіңізді таныстырыңыз
Dialogue: 0,0:49:06.81,0:49:09.69,Default,,0,0,0,,Неліктен? Масаки-сама бұрын айтты
Dialogue: 0,0:49:09.78,0:49:11.94,Default,,0,0,0,,«Әдетте адамдар өзін таныстырады».
Dialogue: 0,0:49:12.03,0:49:13.70,Default,,0,0,0,,Сіз айттыңыз
Dialogue: 0,0:49:14.24,0:49:16.41,Default,,0,0,0,,Масаки, сен бұл жігітке бұлдыр жауап бере алмайсың.
Dialogue: 0,0:49:16.49,0:49:17.37,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:49:17.45,0:49:18.87,Default,,0,0,0,,Қалай болғанда да, мен сізге өзіңізді таныстыруға рұқсат беруім керек.
Dialogue: 0,0:49:18.95,0:49:20.87,Default,,0,0,0,,Бұл дыбыс? Мен қазір сұрауым керек
Dialogue: 0,0:49:21.24,0:49:23.37,Default,,0,0,0,,Бұл жаман болды, айтыңызшы.
Dialogue: 0,0:49:23.71,0:49:24.62,Default,,0,0,0,,Сол адам – бәрінен әлсіз
Dialogue: 0,0:49:24.71,0:49:26.75,Default,,0,0,0,,Бұл...
Dialogue: 0,0:49:29.38,0:49:31.38,Default,,0,0,0,,Бұл жақсы есім.
Dialogue: 0,0:49:31.46,0:49:34.88,Default,,0,0,0,,Мен де солай ойлаймын. Бұл маңызды атау.
Dialogue: 0,0:49:34.97,0:49:36.34,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:49:36.89,0:49:37.76,Default,,0,0,0,,Уау
Dialogue: 0,0:49:41.56,0:49:43.89,Default,,0,0,0,,Дәретхана қай жерде?
Dialogue: 0,0:49:49.90,0:49:54.15,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:49:58.49,0:49:59.99,Default,,0,0,0,,Бірақ ол бұзылды ...
Dialogue: 0,0:50:00.20,0:50:02.16,Default,,0,0,0,,Бұлай болғанша оны жалғыз қалдырудың қажеті жоқ.
Dialogue: 0,0:50:02.24,0:50:03.37,Default,,0,0,0,,Оны жөндеуге өндірушіге жіберіңіз
Dialogue: 0,0:50:03.45,0:50:05.21,Default,,0,0,0,,Менің тағы айтып отырғаным осы.
Dialogue: 0,0:50:05.37,0:50:06.71,Default,,0,0,0,,Бірақ бүгін...
Dialogue: 0,0:50:06.79,0:50:07.96,Default,,0,0,0,,Рикуо-кун!
Dialogue: 0,0:50:08.92,0:50:11.63,Default,,0,0,0,,Ол тапсырыс берушінің кім екенін біледі, солай ма?
Dialogue: 0,0:50:11.75,0:50:13.59,Default,,0,0,0,,Мұнда келгендердің бәрі бірдей.
Dialogue: 0,0:50:16.51,0:50:18.22,Default,,0,0,0,,Кешіріңіз. Қош келдіңіз.
Dialogue: 0,0:50:18.30,0:50:19.30,Default,,0,0,0,,Тапсырысыңыз ше?
Dialogue: 0,0:50:21.81,0:50:22.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:22.81,0:50:23.89,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:50:23.97,0:50:26.44,Default,,0,0,0,,Бәлкім, сіз оны бағалай алмайсыз, бұл бірінші рет болуы мүмкін.
Dialogue: 0,0:50:26.73,0:50:28.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:50:30.48,0:50:33.02,Default,,0,0,0,,Уау, ыстық... Мынадан тағы бір стақанға тапсырыс беріңіз.
Dialogue: 0,0:50:35.44,0:50:37.99,Default,,0,0,0,,Мен Рикуо мырзамен бірдей тапсырыс беремін.
Dialogue: 0,0:50:38.11,0:50:39.95,Default,,0,0,0,,Иә, екі
Dialogue: 0,0:50:43.41,0:50:44.70,Default,,0,0,0,,Сіз кофе іше аласыз ба?
Dialogue: 0,0:50:44.79,0:50:46.08,Default,,0,0,0,,Үшінші сусын қатты болуы мүмкін.
Dialogue: 0,0:50:46.16,0:50:47.00,Default,,0,0,0,,№. Робот?
Dialogue: 0,0:50:47.08,0:50:47.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:48.17,0:50:49.88,Default,,0,0,0,,Ол ауыз тек сөйлеуші ​​ғана.
Dialogue: 0,0:50:49.96,0:50:51.50,Default,,0,0,0,,Адамға еліктеп ішсең...
Dialogue: 0,0:50:51.96,0:50:52.92,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:50:54.00,0:50:55.26,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:50:55.80,0:50:56.63,Default,,0,0,0,,Күте тұрыңыз, эй.
Dialogue: 0,0:50:56.72,0:50:58.93,Default,,0,0,0,,3-бап Роботтар өз-өзіне қол жұмсай алмайды
Dialogue: 0,0:50:59.18,0:51:01.34,Default,,0,0,0,,Бұл жігіт оны ішудің қауіпті болатынын білуі керек.
Dialogue: 0,0:51:01.64,0:51:05.56,Default,,0,0,0,,Дұрыс, оны ішуге болмайды.
Dialogue: 0,0:51:05.89,0:51:07.77,Default,,0,0,0,,Уау
Dialogue: 0,0:51:13.61,0:51:15.23,Default,,0,0,0,,Не болды?
Dialogue: 0,0:51:15.94,0:51:18.36,Default,,0,0,0,,Кофе ... қауіпті.
Dialogue: 0,0:51:21.66,0:51:23.24,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:51:23.45,0:51:26.41,Default,,0,0,0,,Не? Эвелендо Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:51:26.50,0:51:27.70,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:51:27.79,0:51:30.04,Default,,0,0,0,,Бұл тұтынушыларға ішуге арналған.
Dialogue: 0,0:51:30.12,0:51:31.63,Default,,0,0,0,,Біртүрлі сөздер айтпа
Dialogue: 0,0:51:35.96,0:51:36.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:36.96,0:51:38.17,Default,,0,0,0,,Эй, сәл күте тұрыңыз! Өшіру!
Dialogue: 0,0:51:38.26,0:51:39.22,Default,,0,0,0,,Мен мұны бұрын ешқашан жасаған емеспін.
Dialogue: 0,0:51:39.30,0:51:40.47,Default,,0,0,0,,Бұл тапсырыс. Бұйрық берген дұрыс.
Dialogue: 0,0:51:40.55,0:51:42.84,Default,,0,0,0,,О, түсіндім. Тостағанды ​​қойыңыз. Бұл тапсырыс.
Dialogue: 0,0:51:42.93,0:51:44.14,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,0:51:44.22,0:51:45.39,Default,,0,0,0,,Иә? Неге...
Dialogue: 0,0:51:45.56,0:51:46.68,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:51:46.77,0:51:48.89,Default,,0,0,0,,«Бұл сен үшін».
Dialogue: 0,0:51:48.98,0:51:50.60,Default,,0,0,0,,«Біртүрлі ештеңе айтпа».
Dialogue: 0,0:51:50.69,0:51:52.15,Default,,0,0,0,,деді
Dialogue: 0,0:51:52.60,0:51:54.31,Default,,0,0,0,,Мен тұтынушымын
Dialogue: 0,0:51:56.44,0:51:57.44,Default,,0,0,0,,Аа, сұрақ.
Dialogue: 0,0:51:57.53,0:51:58.74,Default,,0,0,0,,Не?
Dialogue: 0,0:51:58.82,0:52:01.74,Default,,0,0,0,,Мм... жасың нешеде?
Dialogue: 0,0:52:01.82,0:52:05.24,Default,,0,0,0,,Бұл жас туралы. Мен биыл 8 жасқа толамын.
Dialogue: 0,0:52:05.53,0:52:06.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:06.70,0:52:07.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:10.62,0:52:12.75,Default,,0,0,0,,8 жыл бұрын жасалған шығар.
Dialogue: 0,0:52:12.83,0:52:16.17,Default,,0,0,0,,8 жасар балаға үлкен деп ойладым.
Dialogue: 0,0:52:16.25,0:52:18.13,Default,,0,0,0,,Жоқ, олай емес... Жоқ, Масаки-сама.
Dialogue: 0,0:52:18.21,0:52:19.42,Default,,0,0,0,,Оның бетінде осындай көрініс болды.
Dialogue: 0,0:52:19.51,0:52:20.92,Default,,0,0,0,,Неліктен бұл жерде егжей-тегжейлі жазылған?
Dialogue: 0,0:52:21.01,0:52:23.39,Default,,0,0,0,,Дегенмен, мен 8 жастамын
Dialogue: 0,0:52:23.80,0:52:26.05,Default,,0,0,0,,8 жас...
Dialogue: 0,0:52:26.14,0:52:26.51,Default,,0,0,0,,Эй
Dialogue: 0,0:52:26.51,0:52:26.97,Default,,0,0,0,,Ей, логика мен ережелер бір-біріне қайшы келеді. Мен бұл сұраққа жауап бере алмаймын.
Dialogue: 0,0:52:26.97,0:52:29.31,Default,,0,0,0,,Логика мен ережелер бір-біріне қайшы келеді. Мен оған жауап бере алмаймын.
Dialogue: 0,0:52:29.39,0:52:30.23,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:52:30.31,0:52:31.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:31.85,0:52:34.23,Default,,0,0,0,,Жарайды, сен 8 жаста болсаң да, көп нәрсе болып жатыр.
Dialogue: 0,0:52:34.31,0:52:39.44,Default,,0,0,0,,Бұл жасы 8-ге толған, дене бітімдері менімен бірдей адамдар бар дегенді білдіре ме?
Dialogue: 0,0:52:39.53,0:52:40.07,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:52:40.07,0:52:40.36,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:52:40.07,0:52:40.36,Default,,0,0,0,,Менің деректерімде жоқ Толық түсіндіріңіз
Dialogue: 0,0:52:40.36,0:52:43.70,Default,,0,0,0,,Менің деректерімде жоқ Толық түсіндіріңіз
Dialogue: 0,0:52:43.78,0:52:44.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:45.57,0:52:47.37,Default,,0,0,0,,Мынау... Бұл дүкенге жиі келетін адам.
Dialogue: 0,0:52:47.45,0:52:51.29,Default,,0,0,0,,Бұл дүкенге келген адам 8 жаста. Сіздің атыңыз кім?
Dialogue: 0,0:52:51.37,0:52:52.21,Default,,0,0,0,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,0:52:52.96,0:52:56.46,Default,,0,0,0,,Чи, оның аты Чи Чан, оның жасы 8-ге толмаған.
Dialogue: 0,0:52:56.54,0:52:58.92,Default,,0,0,0,,Дұрыс, дауыс зор...
Dialogue: 0,0:53:03.26,0:53:05.76,Default,,0,0,0,,Маған сенім білдіргеніңіз үшін рахмет.
Dialogue: 0,0:53:06.01,0:53:07.18,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:53:07.55,0:53:08.56,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:53:08.97,0:53:09.85,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:53:10.39,0:53:11.81,Default,,0,0,0,,Хмм, жұмыста не істейсің?
Dialogue: 0,0:53:11.89,0:53:14.44,Default,,0,0,0,,Мен бала күтіміне көмектестім.
Dialogue: 0,0:53:14.60,0:53:16.31,Default,,0,0,0,,Бала күтімі?
Dialogue: 0,0:53:16.73,0:53:19.07,Default,,0,0,0,,Иә, бір ата-ана және бір бала.
Dialogue: 0,0:53:19.15,0:53:20.69,Default,,0,0,0,,Менімен сәл сөйлесіңізші. Не?
Dialogue: 0,0:53:20.78,0:53:21.28,Default,,0,0,0,,Жалғыз болу қиын...
Dialogue: 0,0:53:21.28,0:53:22.78,Default,,0,0,0,,Жалғыз болу қиын...
Dialogue: 0,0:53:21.28,0:53:22.78,Default,,0,0,0,,Мен тұтынушымын
Dialogue: 0,0:53:22.78,0:53:23.03,Default,,0,0,0,,Жалғыз болу қиын...
Dialogue: 0,0:53:39.04,0:53:40.75,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:53:45.88,0:53:48.09,Default,,0,0,0,,Хаха хаха...
Dialogue: 0,0:53:48.89,0:53:49.72,Default,,0,0,0,,Су ыдысы
Dialogue: 0,0:53:49.80,0:53:51.39,Default,,0,0,0,,Осы уақытқа дейін қандай қиыншылықтар болды?
Dialogue: 0,0:53:51.47,0:53:52.72,Default,,0,0,0,,Дағдарыс аяқталды ма?
Dialogue: 0,0:53:52.81,0:53:55.52,Default,,0,0,0,,Excuse me, қайсысы Наги-Сан?
Dialogue: 0,0:53:55.94,0:53:58.98,Default,,0,0,0,,Мына баланың ұйқысын бақылап жүрген кезім хахаха
Dialogue: 0,0:53:59.06,0:54:02.44,Default,,0,0,0,,Тіпті мен ұйықтап қалдым.
Dialogue: 0,0:54:07.03,0:54:08.28,Default,,0,0,0,,Біртүрлі нәрсе отыр.
Dialogue: 0,0:54:08.37,0:54:09.99,Default,,0,0,0,,Олай айтпа.
Dialogue: 0,0:54:10.08,0:54:11.20,Default,,0,0,0,,Чи Чан, үйге қайтайық.
Dialogue: 0,0:54:11.28,0:54:13.16,Default,,0,0,0,,Бұл мысық, кешіріңіз...
Dialogue: 0,0:54:13.24,0:54:14.08,Default,,0,0,0,,Чи Чан деп айт
Dialogue: 0,0:54:14.16,0:54:17.33,Default,,0,0,0,,Чи Чан 8 жасқа толмаған ба?
Dialogue: 0,0:54:17.42,0:54:18.25,Default,,0,0,0,,Иә...
Dialogue: 0,0:54:18.33,0:54:19.67,Default,,0,0,0,,Доваа
Dialogue: 0,0:54:20.59,0:54:21.54,Default,,0,0,0,,Бұл адам Чи Чан
Dialogue: 0,0:54:21.75,0:54:23.92,Default,,0,0,0,,Иә? сен не туралы айтып тұрсың
Dialogue: 0,0:54:24.01,0:54:25.26,Default,,0,0,0,,Бұл мысық па? Сен ше?
Dialogue: 0,0:54:25.34,0:54:26.26,Default,,0,0,0,,Бұл мысық
Dialogue: 0,0:54:26.38,0:54:28.76,Default,,0,0,0,,Бұл баланың жақсы көретін тіркесі... Мысық десе де болады.
Dialogue: 0,0:54:28.84,0:54:30.05,Default,,0,0,0,,Жарайды, өйткені ол өзі айтты.
Dialogue: 0,0:54:30.14,0:54:30.97,Default,,0,0,0,,Иә
Dialogue: 0,0:54:31.05,0:54:33.18,Default,,0,0,0,,Бұл мысық па?
Dialogue: 0,0:54:34.98,0:54:36.56,Default,,0,0,0,,Маған шығуға апарыңызшы.
Dialogue: 0,0:54:36.64,0:54:37.64,Default,,0,0,0,,Қош бол~
Dialogue: 0,0:54:37.73,0:54:41.19,Default,,0,0,0,,Қазір ақпарат өте шатастырып тұрған сияқты.
Dialogue: 0,0:54:41.27,0:54:42.61,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:54:43.53,0:54:44.48,Default,,0,0,0,,Біртүрлі нәрсе құлап бара жатты.
Dialogue: 0,0:54:44.57,0:54:45.86,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:54:46.07,0:54:47.74,Default,,0,0,0,,Мияу, мияу, маған бірдеңе көмектесе аласың ба...
Dialogue: 0,0:54:47.82,0:54:49.53,Default,,0,0,0,,Қайтып келіңізші.
Dialogue: 0,0:54:51.24,0:54:52.49,Default,,0,0,0,,Сіз қалай ойлайсыз? Ол жөнделе ме?
Dialogue: 0,0:54:53.45,0:54:54.49,Default,,0,0,0,,Бұл қазірдің өзінде...
Dialogue: 0,0:54:54.58,0:54:56.20,Default,,0,0,0,,Рахмет Рикуо-кун
Dialogue: 0,0:54:56.50,0:55:00.75,Default,,0,0,0,,Бірақ бұл туралы көңілді сөйлесейік.
Dialogue: 0,0:55:06.17,0:55:09.59,Default,,0,0,0,,Хмм, мен ол үйде көптен бері жұмыс істеп жүрмін.
Dialogue: 0,0:55:09.93,0:55:13.05,Default,,0,0,0,,Иә, бұл менің жұмыс орным болатын.
Dialogue: 0,0:55:13.39,0:55:16.89,Default,,0,0,0,,Мен сіздің ұлыңызға қараушы болып жұмысқа қабылдандым, бірақ...
Dialogue: 0,0:55:17.23,0:55:21.65,Default,,0,0,0,,Оның есейгені сонша, мен оған мұқтаж емеспін.
Dialogue: 0,0:55:21.86,0:55:23.90,Default,,0,0,0,,Сізге жұмыс ұнады ма?
Dialogue: 0,0:55:24.02,0:55:27.53,Default,,0,0,0,,Иә, есімді ұлыңыз қойды.
Dialogue: 0,0:55:27.61,0:55:29.70,Default,,0,0,0,,Әлі күнге дейін жақсы есімде.
Dialogue: 0,0:55:30.03,0:55:31.49,Default,,0,0,0,,Маңызды атау
Dialogue: 0,0:55:31.57,0:55:33.66,Default,,0,0,0,,Баланың аты кім?
Dialogue: 0,0:55:33.91,0:55:34.87,Default,,0,0,0,,Сіздің ұлыңыз...
Dialogue: 0,0:55:36.24,0:55:37.91,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,0:55:38.00,0:55:40.29,Default,,0,0,0,,Ол... деп аталады.
Dialogue: 0,0:55:45.84,0:55:48.63,Default,,0,0,0,,Сіздің отбасыңыздың тегі кім? Мекенжай Байланыс жолы?
Dialogue: 0,0:55:53.30,0:55:54.26,Default,,0,0,0,,(ұшқын дыбысы)
Dialogue: 0,0:55:54.60,0:55:55.64,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:55:56.10,0:55:57.06,Default,,0,0,0,,Сіз...
Dialogue: 0,0:55:57.14,0:55:57.97,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:56:01.90,0:56:04.81,Default,,0,0,0,,Менің атымды сұрағаныңызға рахмет.
Dialogue: 0,0:56:09.44,0:56:11.32,Default,,0,0,0,,Мұнда келгендердің бәрі бірдей.
Dialogue: 0,0:56:11.65,0:56:14.53,Default,,0,0,0,,Сіз маған қоңырау шалдыңыз...
Dialogue: 0,0:56:15.03,0:56:16.12,Default,,0,0,0,,...Дұрыс.
Dialogue: 0,0:56:16.28,0:56:17.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:20.87,0:56:24.08,Default,,0,0,0,,Есіңізде болсын... атыңызды...
Dialogue: 0,0:56:26.17,0:56:28.76,Default,,0,0,0,,Иә, бұл Катриннің суреті.
Dialogue: 0,0:56:41.68,0:56:42.56,Default,,0,0,0,,Ол сынған ба?
Dialogue: 0,0:56:43.98,0:56:45.40,Default,,0,0,0,,Ол заңсыз тасталды.
Dialogue: 0,0:56:45.73,0:56:46.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:46.82,0:56:50.57,Default,,0,0,0,,Егер сіз жаңасын алсаңыз, өндіруші ескісін қайтарып алады, солай ма?
Dialogue: 0,0:56:50.86,0:56:51.74,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:56:51.95,0:56:53.11,Default,,0,0,0,,Өтеу шығындары…
Dialogue: 0,0:56:53.82,0:56:57.08,Default,,0,0,0,,Мен төлегім келмейді, сондықтан жеке мәліметтерімді жойдым...
Dialogue: 0,0:56:58.58,0:57:02.08,Default,,0,0,0,,Бұл бала біреудің оны есіне түсіргенін қалады.
Dialogue: 0,0:57:02.91,0:57:04.33,Default,,0,0,0,,Сіздің атыңыз...
Dialogue: 0,0:57:05.54,0:57:08.34,Default,,0,0,0,,Сондықтан мен этика комитетінен қаша берем...
Dialogue: 0,0:57:14.43,0:57:15.84,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:57:16.97,0:57:18.89,Default,,0,0,0,,Сіз менің атымды білмедіңіз.
Dialogue: 0,0:57:18.97,0:57:20.89,Default,,0,0,0,,Мүмкін бұл бөлік те жойылған шығар.
Dialogue: 0,0:57:21.18,0:57:22.77,Default,,0,0,0,,Бұл робот сияқты, солай ма?
Dialogue: 0,0:57:23.31,0:57:26.35,Default,,0,0,0,,Мен оны баяғыда жоғалтып алғанмын, бірақ мен оны байқамай да қалдым.
Dialogue: 0,0:57:26.56,0:57:29.23,Default,,0,0,0,,Бұл баланың жүрегінде мәңгі сақталды.
Dialogue: 0,0:57:29.77,0:57:32.40,Default,,0,0,0,,Есімді алған кезден асыл естеліктер
Dialogue: 0,0:57:32.69,0:57:35.20,Default,,0,0,0,,Жүрек? Жүрек дегеніміз не? Масаки...
Dialogue: 0,0:57:35.28,0:57:36.82,Default,,0,0,0,,Сіз де жақсы айттыңыз, солай емес пе?
Dialogue: 0,0:57:37.20,0:57:39.78,Default,,0,0,0,,Музыканы түсіне алмайсың, өйткені жүрегің жоқ дейді.
Dialogue: 0,0:57:40.41,0:57:42.50,Default,,0,0,0,,Оған мәңгі батып қалма.
Dialogue: 0,0:57:44.21,0:57:45.83,Default,,0,0,0,,Ғрр! Б-бұл жігіт…
Dialogue: 0,0:57:47.29,0:57:48.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:49.84,0:57:51.59,Default,,0,0,0,,...Бұл біртүрлі, солай емес пе?
Dialogue: 0,0:57:52.84,0:57:53.76,Default,,0,0,0,,Эй
Dialogue: 0,0:57:58.43,0:57:59.72,Default,,0,0,0,,Сіз де?
Dialogue: 0,0:58:14.24,0:58:15.20,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:58:25.46,0:58:27.50,Default,,0,0,0,,Біз қалқымалы роботтарды да өңдейміз.
Dialogue: 0,0:58:28.12,0:58:29.38,Default,,0,0,0,,Этика жөніндегі комитет
Dialogue: 0,0:58:29.79,0:58:31.71,Default,,0,0,0,,Мұны мен істеп жатқан жоқпын.
Dialogue: 0,0:58:31.96,0:58:32.80,Default,,0,0,0,,(Андроид дыбысы)
Dialogue: 0,0:58:38.09,0:58:40.35,Default,,0,0,0,,Бұл елеусіз қалды ма? Бұл қалыпты жағдай.
Dialogue: 0,0:58:41.05,0:58:42.93,Default,,0,0,0,,Сэмми үйде де солай.
Dialogue: 0,0:58:43.56,0:58:45.39,Default,,0,0,0,,Бұл дүкен неге басқаша?
Dialogue: 0,0:58:46.85,0:58:49.02,Default,,0,0,0,,Сізде ешқандай сезім болмауы керек.
Dialogue: 0,0:59:08.87,0:59:10.38,Default,,0,0,0,,Мен...? (Бала) Иә.
Dialogue: 0,0:59:10.46,0:59:12.17,Default,,0,0,0,,Бұл Катриннің картинасы.
Dialogue: 0,1:00:14.27,1:00:15.52,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,1:00:15.69,1:00:16.61,Default,,0,0,0,,​​Хмм.
Dialogue: 0,1:00:28.16,1:00:29.20,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:00:33.54,1:00:35.54,Default,,0,0,0,,(теледидар дыбысы)
Dialogue: 0,1:00:35.63,1:00:36.50,Default,,0,0,0,,Сэмми ше?
Dialogue: 0,1:00:36.59,1:00:38.96,Default,,0,0,0,,Ол баяғыда шыққан. Соны жасаңыз.
Dialogue: 0,1:00:39.05,1:00:40.47,Default,,0,0,0,,А, техникалық қызмет көрсету?
Dialogue: 0,1:00:40.55,1:00:42.55,Default,,0,0,0,,Айына бір рет өте қиын.
Dialogue: 0,1:00:43.22,1:00:44.84,Default,,0,0,0,,Бұл зат қайда бара жатыр?
Dialogue: 0,1:00:44.93,1:00:45.93,Default,,0,0,0,,Электрик?
Dialogue: 0,1:00:46.05,1:00:48.72,Default,,0,0,0,,Жүр, әкеңмен бірге емессің бе?
Dialogue: 0,1:00:48.89,1:00:50.06,Default,,0,0,0,,Ммм
Dialogue: 0,1:00:52.14,1:00:56.40,Default,,0,0,0,,Ху~ Менің ұйқым келіп тұр, тамақ жегім келмейді
Dialogue: 0,1:01:13.50,1:01:14.42,Default,,0,0,0,,Фортепиано
Dialogue: 0,1:01:14.50,1:01:15.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:16.75,1:01:20.80,Default,,0,0,0,,Түнде ойнайтын болсаңыз, оны өшіріңіз. Мен мұнда ұйқымды қандырмаймын.
Dialogue: 0,1:01:20.88,1:01:22.42,Default,,0,0,0,,Бұл арман емес
Dialogue: 0,1:01:22.76,1:01:25.18,Default,,0,0,0,,Анам жылап тұрды, хехе.
Dialogue: 0,1:01:25.51,1:01:28.18,Default,,0,0,0,,Сабақ Сіз маған енді көмектесе алмайсыз
Dialogue: 0,1:01:28.76,1:01:31.14,Default,,0,0,0,,Мен сауығып кетсем де, көмектесу мүмкін емес.
Dialogue: 0,1:01:51.37,1:01:53.50,Default,,0,0,0,,Бұл жігіттің ерекше қабілеті бар ма?
Dialogue: 0,1:01:53.58,1:01:55.08,Default,,0,0,0,,Андроид құрылғыларының арнайы дағдылары бар.
Dialogue: 0,1:01:55.62,1:01:57.13,Default,,0,0,0,,Сурет салатын роботтар бар, солай ма?
Dialogue: 0,1:01:57.29,1:01:58.58,Default,,0,0,0,,Я~
Dialogue: 0,1:01:58.88,1:01:59.71,Default,,0,0,0,,А...
Dialogue: 0,1:02:06.26,1:02:07.09,Default,,0,0,0,,Уау
Dialogue: 0,1:02:10.35,1:02:12.68,Default,,0,0,0,,Мен оны қартымның компьютерінің ішінен таптым.
Dialogue: 0,1:02:13.18,1:02:14.35,Default,,0,0,0,,Ал...
Dialogue: 0,1:02:14.52,1:02:18.02,Default,,0,0,0,,Бұл андроид. Бұл адамның ата-анасы болуы керек.
Dialogue: 0,1:02:18.98,1:02:20.02,Default,,0,0,0,,Мен бұл туралы естідім...
Dialogue: 0,1:02:20.11,1:02:22.15,Default,,0,0,0,,Бұл нарықта жоқ.
Dialogue: 0,1:02:22.28,1:02:24.74,Default,,0,0,0,,Ол мұны болашақта жүзеге асырғысы келеді.
Dialogue: 0,1:02:25.78,1:02:27.03,Default,,0,0,0,,Осы жерден оқыңыз
Dialogue: 0,1:02:29.78,1:02:31.70,Default,,0,0,0,,Бұл мағынасы бар.
Dialogue: 0,1:02:32.54,1:02:35.29,Default,,0,0,0,,Ол адам бұлай жасайды деп шешілмеді...
Dialogue: 0,1:02:35.37,1:02:38.54,Default,,0,0,0,,...Роботтар бәрін үзуге жақын.
Dialogue: 0,1:02:39.13,1:02:42.55,Default,,0,0,0,,Өнерден кейін махаббат, иә?
Dialogue: 0,1:02:50.26,1:02:51.10,Default,,0,0,0,,Масаки!
Dialogue: 0,1:03:25.00,1:03:26.38,Default,,0,0,0,,Я~
Dialogue: 0,1:03:43.44,1:03:46.19,Default,,0,0,0,,Қош келдіңіз. Бүгін жалғызсың ба?
Dialogue: 0,1:03:46.53,1:03:48.78,Default,,0,0,0,,Біз әрқашан бірге емеспіз... біз біргеміз, солай ма?
Dialogue: 0,1:03:48.99,1:03:49.86,Default,,0,0,0,,Сен де жалғызсың ба?
Dialogue: 0,1:03:49.95,1:03:53.99,Default,,0,0,0,,А, иә, Шимэй-сан, менің бір ісім бар.
Dialogue: 0,1:04:01.17,1:04:02.46,Default,,0,0,0,,Бізде балабақша жұмыс істейді.
Dialogue: 0,1:04:02.54,1:04:04.46,Default,,0,0,0,,Чи Чан тұтынушы
Dialogue: 0,1:04:04.59,1:04:05.80,Default,,0,0,0,,Сәлем? Мияу
Dialogue: 0,1:04:13.93,1:04:16.01,Default,,0,0,0,,Чи Чанды жалғыз қалдырып не істеп жатырсың?
Dialogue: 0,1:04:16.10,1:04:17.18,Default,,0,0,0,,Бұл қазірдің өзінде мысық -
Dialogue: 0,1:04:17.27,1:04:18.72,Default,,0,0,0,,Олай айтпа.
Dialogue: 0,1:04:18.98,1:04:19.98,Default,,0,0,0,,Иә, иә
Dialogue: 0,1:04:21.56,1:04:23.73,Default,,0,0,0,,Әке, тезірек ораласыз деп үміттенемін.
Dialogue: 0,1:04:23.81,1:04:25.02,Default,,0,0,0,,Менің әкем емес
Dialogue: 0,1:04:25.11,1:04:26.52,Default,,0,0,0,,Сонда ше?
Dialogue: 0,1:04:26.69,1:04:27.53,Default,,0,0,0,,Иә
Dialogue: 0,1:04:27.78,1:04:33.03,Default,,0,0,0,,Патронаттық тәрбиеші дегеніміз не?
Dialogue: 0,1:04:34.49,1:04:35.95,Default,,0,0,0,,Мен қайтып келдім, Чи Чан.
Dialogue: 0,1:04:36.03,1:04:37.95,Default,,0,0,0,,Бұл мысық~ Ах, Рикуо-кун
Dialogue: 0,1:04:38.41,1:04:39.70,Default,,0,0,0,,Сіз ше, Масаки?
Dialogue: 0,1:04:39.79,1:04:41.00,Default,,0,0,0,,Сондықтан біз әрқашан біргеміз...
Dialogue: 0,1:04:41.08,1:04:42.12,Default,,0,0,0,,Біз біргеміз, солай ма?
Dialogue: 0,1:04:42.21,1:04:44.33,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін. Мен өзімді жақсы сезініп тұрған жоқпын.
Dialogue: 0,1:04:44.46,1:04:46.38,Default,,0,0,0,,Бұл дұрыс емес! Ах
Dialogue: 0,1:04:49.46,1:04:50.30,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:51.55,1:04:53.55,Default,,0,0,0,,Чи Чан, кітабыңызды оқығыңыз келе ме?
Dialogue: 0,1:04:53.63,1:04:55.34,Default,,0,0,0,,Мен оны оқығым келмейді.
Dialogue: 0,1:04:55.43,1:04:58.60,Default,,0,0,0,,Шимей атаның сүйікті кітабы қандай екенін білесің бе?
Dialogue: 0,1:04:58.85,1:05:00.18,Default,,0,0,0,,Айтайын ба?
Dialogue: 0,1:05:00.31,1:05:01.56,Default,,0,0,0,,Мияу хехе
Dialogue: 0,1:05:02.23,1:05:04.40,Default,,0,0,0,,Балалармен жақсы қарым-қатынастасың.
Dialogue: 0,1:05:04.77,1:05:08.32,Default,,0,0,0,,Акико мен сияқты ересек адам.
Dialogue: 0,1:05:11.86,1:05:13.70,Default,,0,0,0,,Шимей-сан не істейді?
Dialogue: 0,1:05:14.07,1:05:15.41,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,1:05:15.70,1:05:17.74,Default,,0,0,0,,Чи Чанға құмар болудан басқа.
Dialogue: 0,1:05:17.83,1:05:19.62,Default,,0,0,0,,Мен сені өзіммен бірге алып кетсем ғой.
Dialogue: 0,1:05:19.74,1:05:22.54,Default,,0,0,0,,Қиналған Шимей мырза шығар.
Dialogue: 0,1:05:22.75,1:05:26.08,Default,,0,0,0,,Мен түсіндім, өйткені мен оны бірнеше рет өз қолымда ұстадым.
Dialogue: 0,1:05:26.83,1:05:27.79,Default,,0,0,0,,Бірнеше рет?
Dialogue: 0,1:05:28.04,1:05:29.88,Default,,0,0,0,,Иә, ай сайын.
Dialogue: 0,1:05:34.68,1:05:35.55,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:05:35.64,1:05:36.59,Default,,0,0,0,,Ұйқы аз қалды
Dialogue: 0,1:05:36.68,1:05:38.01,Default,,0,0,0,,Оны жібермеуім керек еді....
Dialogue: 0,1:05:38.93,1:05:40.47,Default,,0,0,0,,Бір нәрсе ұнамаған сияқты
Dialogue: 0,1:05:41.39,1:05:43.14,Default,,0,0,0,,Мен бәрібір жаман адаммын
Dialogue: 0,1:05:43.27,1:05:44.98,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:05:48.69,1:05:52.23,Default,,0,0,0,,Жаңа туғанда жүрегіңде ештеңе жоқ.
Dialogue: 0,1:05:52.36,1:05:54.07,Default,,0,0,0,,Бос мысық та?
Dialogue: 0,1:05:54.20,1:05:56.78,Default,,0,0,0,,Иә, бірақ мен көп адамдармен сөйлестім...
Dialogue: 0,1:05:56.86,1:05:59.58,Default,,0,0,0,,Көп нәрсені көру және сезіну, содан кейін...
Dialogue: 0,1:05:59.74,1:06:01.62,Default,,0,0,0,,Ақыл-ой бірте-бірте дамиды дейді.
Dialogue: 0,1:06:01.70,1:06:02.91,Default,,0,0,0,,Сондай-ақ мысықтар үшін?
Dialogue: 0,1:06:03.00,1:06:04.00,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:06:04.08,1:06:08.17,Default,,0,0,0,,Бірақ одан әрі қалыптасатын жүректердің көптеген түрлері бар.
Dialogue: 0,1:06:08.25,1:06:08.79,Default,,0,0,0,,Мияу
Dialogue: 0,1:06:08.79,1:06:09.21,Default,,0,0,0,,Мияу
Dialogue: 0,1:06:08.79,1:06:09.21,Default,,0,0,0,,Тек Чи Чан, Шимэй-сан және біз ғана емес, және...
Dialogue: 0,1:06:09.21,1:06:12.59,Default,,0,0,0,,Тек Чи Чан, Шимэй-сан және біз ғана емес, және...
Dialogue: 0,1:06:12.67,1:06:13.67,Default,,0,0,0,,Рикуо-сан
Dialogue: 0,1:06:17.51,1:06:19.47,Default,,0,0,0,,Мысық, мен түсіндім, шынымен бе?
Dialogue: 0,1:06:19.55,1:06:20.43,Default,,0,0,0,,Мияу
Dialogue: 0,1:06:20.97,1:06:23.39,Default,,0,0,0,,Чи Чан менен озып кетті.
Dialogue: 0,1:06:25.48,1:06:27.85,Default,,0,0,0,,Шимэй-сансыз өзіңізді жалғыз сезінесіз бе?
Dialogue: 0,1:06:29.31,1:06:31.69,Default,,0,0,0,,Сізге Шимэй-сан ұнай ма?
Dialogue: 0,1:06:32.11,1:06:33.07,Default,,0,0,0,,Мияу
Dialogue: 0,1:06:33.57,1:06:37.15,Default,,0,0,0,,Шимей мырза бір жерге өзі барады, солай ма?
Dialogue: 0,1:06:39.07,1:06:41.49,Default,,0,0,0,,Қайда барасың қызық, Сағындым сені...
Dialogue: 0,1:06:41.58,1:06:42.58,Default,,0,0,0,,Рикуо-кун
Dialogue: 0,1:06:43.70,1:06:46.33,Default,,0,0,0,,Өйткені мен енді ересек емеспін.
Dialogue: 0,1:06:46.41,1:06:48.08,Default,,0,0,0,,А, кешіріңіз, әжетхана.
Dialogue: 0,1:06:48.17,1:06:50.79,Default,,0,0,0,,Эй, енді Чи Чанның кезегі.
Dialogue: 0,1:06:51.13,1:06:52.59,Default,,0,0,0,,Рикуо-кун, кешіріңіз.
Dialogue: 0,1:06:52.67,1:06:53.55,Default,,0,0,0,,Неге ол маған ештеңе айтпады екен?
Dialogue: 0,1:06:54.13,1:06:55.80,Default,,0,0,0,,Негізі мен жалғыз бара аламын.
Dialogue: 0,1:06:55.88,1:06:57.72,Default,,0,0,0,,О~ Жарайсың Чи Чан
Dialogue: 0,1:06:58.26,1:07:00.01,Default,,0,0,0,,Чимай мырзаның бұл дүкенге бірінші рет келуі—
Dialogue: 0,1:07:00.09,1:07:02.76,Default,,0,0,0,,Оны мұнда әкелгеніме көп болды.
Dialogue: 0,1:07:04.14,1:07:05.98,Default,,0,0,0,,Әлгі қарт:
Dialogue: 0,1:07:06.27,1:07:08.81,Default,,0,0,0,,Бұл оның сүйікті жері болса керек.
Dialogue: 0,1:07:09.10,1:07:10.98,Default,,0,0,0,,Мен сені қорлаймын деген жоқпын.
Dialogue: 0,1:07:11.15,1:07:12.36,Default,,0,0,0,,Бірақ мені аздап алаңдататын бір нәрсе бар...
Dialogue: 0,1:07:12.44,1:07:14.07,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,1:07:14.53,1:07:17.07,Default,,0,0,0,,Барлық адамдар кейде басқаларға зиян тигізуі мүмкін.
Dialogue: 0,1:07:17.15,1:07:18.45,Default,,0,0,0,,Бұл нені білдіреді!
Dialogue: 0,1:07:18.65,1:07:19.95,Default,,0,0,0,,Бұл сізді мазалады ма?
Dialogue: 0,1:07:20.03,1:07:22.70,Default,,0,0,0,,Бұл мен адам болғаным үшін жаман адаммын дегенді білдіре ме?
Dialogue: 0,1:07:22.99,1:07:25.16,Default,,0,0,0,,Күлкілі ештеңе айтпа, сен.
Dialogue: 0,1:07:26.95,1:07:30.08,Default,,0,0,0,,Сіздің ойыңызша робот ешқашан басқа адамға зиян тигізбейді ме?
Dialogue: 0,1:07:31.04,1:07:32.92,Default,,0,0,0,,Басқа адамды не ренжітеді?
Dialogue: 0,1:07:33.17,1:07:35.13,Default,,0,0,0,,Мұны түсіну оңай емес.
Dialogue: 0,1:07:35.63,1:07:37.01,Default,,0,0,0,,Сонда қалай ойлайсың?
Dialogue: 0,1:07:37.51,1:07:39.43,Default,,0,0,0,,Мен жарақаттанудан қалай аулақ бола аламын?
Dialogue: 0,1:07:39.59,1:07:41.55,Default,,0,0,0,,Біз нені түсінуіміз керек?
Dialogue: 0,1:07:44.14,1:07:47.64,Default,,0,0,0,,Сөзбен айтсаң, мағынасыз әңгіме.
Dialogue: 0,1:08:00.70,1:08:02.07,Default,,0,0,0,,Рикуо-сан
Dialogue: 0,1:08:06.87,1:08:09.79,Default,,0,0,0,,Мені Рикуо-сан құтқарды
Dialogue: 0,1:08:11.58,1:08:12.71,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,1:08:21.59,1:08:24.35,Default,,0,0,0,,Аа, бұл ең жаманы.
Dialogue: 0,1:08:28.68,1:08:30.68,Default,,0,0,0,,Енді сот істеріне көшейік.
Dialogue: 0,1:08:30.77,1:08:34.10,Default,,0,0,0,,Робот құқығы бойынша маманданған заңгерлер әлі де аз болса керек.
Dialogue: 0,1:08:34.31,1:08:37.73,Default,,0,0,0,,Жарайды, бұл әлі тар қақпа, ал сен ше?
Dialogue: 0,1:08:37.98,1:08:39.15,Default,,0,0,0,,Бұл ма?
Dialogue: 0,1:08:41.03,1:08:42.36,Default,,0,0,0,,Қазір тоқтаңыз
Dialogue: 0,1:08:44.16,1:08:45.32,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:08:45.62,1:08:47.24,Default,,0,0,0,,Өйткені, осы уақыт ішінде солай болды.
Dialogue: 0,1:08:47.33,1:08:48.16,Default,,0,0,0,,Иә
Dialogue: 0,1:08:48.54,1:08:50.45,Default,,0,0,0,,Уайымдайтын ештеңе жоқ.
Dialogue: 0,1:08:50.62,1:08:52.58,Default,,0,0,0,,Менің ойымша, оны дәл ойнауға болады.
Dialogue: 0,1:08:52.71,1:08:55.17,Default,,0,0,0,,Бұл шоудың біразын алып тастады, солай емес пе?
Dialogue: 0,1:08:58.30,1:09:00.21,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,1:09:00.88,1:09:01.76,Default,,0,0,0,,Маған қатты әсер еткен болар...
Dialogue: 0,1:09:01.76,1:09:01.88,Default,,0,0,0,,Маған қатты әсер еткен болар...
Dialogue: 0,1:09:01.76,1:09:01.88,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,1:09:01.88,1:09:03.34,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,1:09:03.34,1:09:04.18,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,1:09:03.34,1:09:04.18,Default,,0,0,0,,Бұл үшін?
Dialogue: 0,1:09:04.18,1:09:04.26,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,1:09:04.26,1:09:05.09,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,1:09:04.26,1:09:05.09,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:05.09,1:09:05.93,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,1:09:06.43,1:09:08.56,Default,,0,0,0,,Бұл өте жаман хахаха
Dialogue: 0,1:09:10.14,1:09:11.43,Default,,0,0,0,,Бұрын… пышақ еді.
Dialogue: 0,1:09:11.85,1:09:13.89,Default,,0,0,0,,(фортепиано дыбысы)
Dialogue: 0,1:09:13.98,1:09:15.48,Default,,0,0,0,,Иә? Ах...
Dialogue: 0,1:09:34.62,1:09:36.08,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:09:36.88,1:09:38.75,Default,,0,0,0,,Кешіріңіз, мен оны ойнай аламын деп өтірік айттым.
Dialogue: 0,1:09:38.75,1:09:40.38,Default,,0,0,0,,Кешіріңіз, мен оны ойнай аламын деп өтірік айттым.
Dialogue: 0,1:09:38.75,1:09:40.38,Default,,0,0,0,,Тағы не? Тағы не?
Dialogue: 0,1:09:40.55,1:09:43.01,Default,,0,0,0,,Сіз оны соңына дейін ойнай алдыңыз ба?
Dialogue: 0,1:09:43.09,1:09:45.80,Default,,0,0,0,,Шындығында, мен тек көргенімді еліктеуге тырысамын.
Dialogue: 0,1:09:46.05,1:09:49.18,Default,,0,0,0,,Мен мұны бұрын бірнеше рет естігенмін.
Dialogue: 0,1:09:49.31,1:09:52.72,Default,,0,0,0,,Көбірек ойна, ойна, ойна, мияу
Dialogue: 0,1:09:52.89,1:09:55.35,Default,,0,0,0,,Чи Чан, оның несі ұнайды?
Dialogue: 0,1:09:55.44,1:09:58.69,Default,,0,0,0,,Мысықтар, әм... шашыраңқы.
Dialogue: 0,1:09:58.90,1:10:00.15,Default,,0,0,0,,Бөлек?
Dialogue: 0,1:10:00.23,1:10:01.07,Default,,0,0,0,,Мұның бәрі бөлек.
Dialogue: 0,1:10:02.15,1:10:02.99,Default,,0,0,0,,Ах
Dialogue: 0,1:10:17.12,1:10:20.50,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:10:54.91,1:10:58.37,Default,,0,0,0,,~♪
Dialogue: 0,1:11:06.17,1:11:08.34,Default,,0,0,0,,Ей, мынаны қарашы, ғажап емес пе?
Dialogue: 0,1:11:08.43,1:11:10.34,Default,,0,0,0,,Өзара қолшатыр? Кяхаха…
Dialogue: 0,1:11:34.29,1:11:36.66,Default,,0,0,0,,Эй, Рикуо-кун, бұл үшін рахмет.
Dialogue: 0,1:11:36.87,1:11:37.71,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:39.12,1:11:41.04,Default,,0,0,0,,Бұл бұрынғыдан өзгеше.
Dialogue: 0,1:11:41.29,1:11:42.42,Default,,0,0,0,,Хехе...
Dialogue: 0,1:11:43.29,1:11:44.46,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:45.88,1:11:47.13,Default,,0,0,0,,Рикуо-сан
Dialogue: 0,1:11:49.80,1:11:54.81,Default,,0,0,0,,Мм... Мен... Рикуо-сан ойнайтын...
Dialogue: 0,1:11:55.10,1:11:57.35,Default,,0,0,0,,Бұл... Маған ұнайды...
Dialogue: 0,1:11:57.98,1:12:00.81,Default,,0,0,0,,Сосын... Чи Чан оны тыңдағысы келді.
Dialogue: 0,1:12:01.23,1:12:03.48,Default,,0,0,0,,Бірақ мен оны ешқашан дұрыс ойнаған емеспін.
Dialogue: 0,1:12:03.90,1:12:07.07,Default,,0,0,0,,Солай болса да... тыңдағанды ​​ұнататын сияқты.
Dialogue: 0,1:12:08.82,1:12:11.70,Default,,0,0,0,,Мен өзімшілдік жасағаным үшін кешірім сұраймын.
Dialogue: 0,1:12:25.29,1:12:27.80,Default,,0,0,0,,Мен оны сіздің алдыңызда ойнамауға тырыстым.
Dialogue: 0,1:12:29.13,1:12:31.38,Default,,0,0,0,,Мен мұны білмей тұрып ойнауды тоқтаттым.
Dialogue: 0,1:12:32.97,1:12:35.47,Default,,0,0,0,,Фортепианода жақсы болсаң, мен мұны қаламас едім...
Dialogue: 0,1:12:35.85,1:12:36.97,Default,,0,0,0,,Рикуо мырза...
Dialogue: 0,1:12:39.85,1:12:42.64,Default,,0,0,0,,Бірақ... бәрібір!
Dialogue: 0,1:12:47.52,1:12:51.53,Default,,0,0,0,,(фортепиано орындауы)
Dialogue: 0,1:13:38.58,1:13:42.08,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:13:43.66,1:13:45.96,Default,,0,0,0,,Мияу мияу...
Dialogue: 0,1:13:47.17,1:13:49.71,Default,,0,0,0,,Чи мен көбірек тыңдағым келеді!
Dialogue: 0,1:13:57.09,1:13:58.68,Default,,0,0,0,,Ал, мен бақыттымын.
Dialogue: 0,1:13:58.85,1:14:02.43,Default,,0,0,0,,Сол баланың қуанғанына көп болды.
Dialogue: 0,1:14:02.89,1:14:04.39,Default,,0,0,0,,Мен емес
Dialogue: 0,1:14:04.73,1:14:10.40,Default,,0,0,0,,Керісінше мен оны қайтадан жалғыз қалдырдым.
Dialogue: 0,1:14:11.40,1:14:13.82,Default,,0,0,0,,Мені өзіңізбен бірге ала алмайсыз ба?
Dialogue: 0,1:14:14.32,1:14:17.11,Default,,0,0,0,,Мен оған әлі көрсеткім келмейді.
Dialogue: 0,1:14:17.70,1:14:19.74,Default,,0,0,0,,Шимэй-сан, мүмкін сен...
Dialogue: 0,1:14:19.83,1:14:22.70,Default,,0,0,0,,Мен сол балаға керекпін
Dialogue: 0,1:14:23.20,1:14:25.96,Default,,0,0,0,,Сондықтан мен ол бала үшін бәрін жасаймын.
Dialogue: 0,1:14:26.67,1:14:28.71,Default,,0,0,0,,Ол бала менің бәрім
Dialogue: 0,1:14:29.50,1:14:33.63,Default,,0,0,0,,Менің бар тілегім – сол баланы бақытты ету.
Dialogue: 0,1:14:34.55,1:14:36.18,Default,,0,0,0,,Сіздің орындауыңыз ұнады...
Dialogue: 0,1:14:36.26,1:14:37.84,Default,,0,0,0,,Сондықтан мен бақытты болдым.
Dialogue: 0,1:14:38.80,1:14:40.89,Default,,0,0,0,,Бұл сезім шынайы
Dialogue: 0,1:14:41.35,1:14:44.48,Default,,0,0,0,,Сізге ант етемін, сіздің орындауыңыз мені қатты әсер етті.
Dialogue: 0,1:14:46.10,1:14:48.31,Default,,0,0,0,,Мен сізге айта аламын ба? Мұндай нәрсе
Dialogue: 0,1:14:48.40,1:14:50.44,Default,,0,0,0,,Наги-санда ол жоқ.
Dialogue: 0,1:14:51.23,1:14:53.03,Default,,0,0,0,,Сэммиді көрмедің бе?
Dialogue: 0,1:14:53.11,1:14:54.99,Default,,0,0,0,,Енді ойлап қарасам, мен келгенде...
Dialogue: 0,1:14:55.07,1:14:57.45,Default,,0,0,0,,Мен олар қателесіп кеткендей сезінемін.
Dialogue: 0,1:14:57.57,1:14:58.86,Default,,0,0,0,,Мен қайтып келдім.
Dialogue: 0,1:15:02.37,1:15:05.00,Default,,0,0,0,,(Сэмми ызылдайды)
Dialogue: 0,1:15:20.84,1:15:21.72,Default,,0,0,0,,Өтініш жазылған конверт жоғалып кетті.
Dialogue: 0,1:15:26.56,1:15:27.73,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,1:15:30.52,1:15:31.61,Default,,0,0,0,,Сэмми...
Dialogue: 0,1:15:32.69,1:15:33.57,Default,,0,0,0,,Не?
Dialogue: 0,1:15:33.65,1:15:36.11,Default,,0,0,0,,Сіз қарым-қатынастың барлық түрін құрып жатқан сияқтысыз.
Dialogue: 0,1:15:37.32,1:15:39.15,Default,,0,0,0,,Мен ерекше ашуланбаймын.
Dialogue: 0,1:15:49.96,1:15:51.29,Default,,0,0,0,,(Иида) Ол тым жылдам — ілесе алмаймын!
Dialogue: 0,1:15:52.46,1:15:53.46,Default,,0,0,0,,Бұл дүкен
Dialogue: 0,1:15:56.17,1:15:58.88,Default,,0,0,0,,Мен сені жек көрмеймін
Dialogue: 0,1:16:00.47,1:16:01.43,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,1:16:03.93,1:16:05.81,Default,,0,0,0,,Рик-кун!
Dialogue: 0,1:16:11.44,1:16:15.02,Default,,0,0,0,,Иә, мен мұны келесі есеп беру сессиясында түсіндіремін.
Dialogue: 0,1:16:15.11,1:16:15.94,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:16:16.02,1:16:18.19,Default,,0,0,0,,Қалай болғанда да, жазбаға назар аударыңыз.
Dialogue: 0,1:16:18.86,1:16:20.40,Default,,0,0,0,,Жоғарыдағылар не айтса да—
Dialogue: 0,1:16:20.90,1:16:25.28,Default,,0,0,0,,Бұл барлық мақсаттарды қарапайым зерттеудің ең жақсы жолы болуы керек.
Dialogue: 0,1:16:54.48,1:16:55.52,Default,,0,0,0,,Әкеңіз ше?
Dialogue: 0,1:16:56.86,1:16:58.90,Default,,0,0,0,,Отбасылық сотқа бару
Dialogue: 0,1:16:59.48,1:17:02.40,Default,,0,0,0,,Жоспарларыңыз бойынша, сіз жақында үйге баруыңыз керек.
Dialogue: 0,1:17:02.65,1:17:04.99,Default,,0,0,0,,Бұл сіздің анаңыздың кінәсі емес.
Dialogue: 0,1:17:06.12,1:17:07.12,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:17:07.49,1:17:10.45,Default,,0,0,0,,Бірақ тек әкеңді кінәлама.
Dialogue: 0,1:17:11.16,1:17:14.63,Default,,0,0,0,,Ешқайсысы да мүлде жаман емес.
Dialogue: 0,1:17:15.08,1:17:16.13,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:17:19.76,1:17:21.88,Default,,0,0,0,,Бұл менің өтінішім.
Dialogue: 0,1:17:22.88,1:17:23.72,Default,,0,0,0,,Иә
Dialogue: 0,1:17:24.01,1:17:27.10,Default,,0,0,0,,Бұл әңгімені сенің әкеңнен сақтайық.
Dialogue: 0,1:17:27.76,1:17:28.60,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,1:17:28.68,1:17:30.52,Default,,0,0,0,,Себебі әкең жараланады.
Dialogue: 0,1:17:31.06,1:17:32.18,Default,,0,0,0,,Саған бұл ұнамайды, солай ма?
Dialogue: 0,1:17:33.69,1:17:36.69,Default,,0,0,0,,Енді менің өтінішім.
Dialogue: 0,1:17:36.77,1:17:37.61,Default,,0,0,0,,Иә
Dialogue: 0,1:17:46.57,1:17:49.99,Default,,0,0,0,,Маған қиналдым, Масаказу, бұзылған шығар?
Dialogue: 0,1:18:00.59,1:18:02.13,Default,,0,0,0,,Қайырлы таң Текс
Dialogue: 0,1:18:05.01,1:18:05.84,Default,,0,0,0,,Текс?
Dialogue: 0,1:18:07.97,1:18:09.60,Default,,0,0,0,,Сәлем Текс...
Dialogue: 0,1:18:09.97,1:18:12.39,Default,,0,0,0,,Текс! Текс!
Dialogue: 0,1:18:18.90,1:18:21.23,Default,,0,0,0,,Келесі - алдын ала тергеу нәтижелері туралы есеп.
Dialogue: 0,1:18:22.28,1:18:24.32,Default,,0,0,0,,андроидтер мен адамдар арасындағы шектен тыс қарым-қатынас —
Dialogue: 0,1:18:24.40,1:18:27.32,Default,,0,0,0,,Индукциялық деп есептелетін нысанның орнын көрсетеді
Dialogue: 0,1:18:28.41,1:18:29.49,Default,,0,0,0,,Бұл тым көп
Dialogue: 0,1:18:29.57,1:18:31.03,Default,,0,0,0,,1408 орындар
Dialogue: 0,1:18:31.54,1:18:34.75,Default,,0,0,0,,Біз ақпараттың барлық түрін жинап, оның барлығын деректерге айналдырдық.
Dialogue: 0,1:18:35.41,1:18:37.87,Default,,0,0,0,,Кейбірі негізсіз қауесет және қалалық аңыз.
Dialogue: 0,1:18:37.96,1:18:39.08,Default,,0,0,0,,Мүмкін енгізілген
Dialogue: 0,1:18:39.17,1:18:40.84,Default,,0,0,0,,Оны аздап қысқарту керек.
Dialogue: 0,1:18:40.92,1:18:43.88,Default,,0,0,0,,Өкінішке орай, бұл нысандар анық -
Dialogue: 0,1:18:43.96,1:18:46.72,Default,,0,0,0,,Робот заңын міндетті түрде бұзбайды
Dialogue: 0,1:18:46.88,1:18:48.18,Default,,0,0,0,,Бұл сұр аймақ
Dialogue: 0,1:18:48.55,1:18:52.06,Default,,0,0,0,,Ал заттардың көптігі...
Dialogue: 0,1:18:52.26,1:18:54.68,Default,,0,0,0,,Бұл да қазіргі робот заңының шегі.
Dialogue: 0,1:18:55.06,1:18:57.56,Default,,0,0,0,,Бірақ... өшіріп тастау керек жер.
Dialogue: 0,1:18:57.77,1:19:00.40,Default,,0,0,0,,Біз осы нысандардың барлығына қарапайым зерттеу жүргіздік.
Dialogue: 0,1:19:00.48,1:19:03.90,Default,,0,0,0,,Нәтижелерге байланысты ол осы зерттеу тақырыбына жаңартылады.
Dialogue: 0,1:19:04.40,1:19:06.40,Default,,0,0,0,,Сондықтан біз оны бұқаралық ақпарат құралдарына іліп қоямыз.
Dialogue: 0,1:19:06.49,1:19:09.82,Default,,0,0,0,,Сондықтан мен бұл санмен мүмкін емес деп отырмын!
Dialogue: 0,1:19:10.03,1:19:13.79,Default,,0,0,0,,Егер сіз бұл туралы адам ресурстары тұрғысынан ойласаңыз, иә...
Dialogue: 0,1:19:15.79,1:19:19.96,Default,,0,0,0,,Бұл қарапайым сауалнама үшін Андроид жүйесін бірінші рет пайдалануым.
Dialogue: 0,1:19:20.08,1:19:22.21,Default,,0,0,0,,Қазірдің өзінде көптеген ұшақтар қамтамасыз етілді
Dialogue: 0,1:19:22.29,1:19:23.71,Default,,0,0,0,,Қазіргі уақытта дайындық үстінде
Dialogue: 0,1:19:23.80,1:19:26.84,Default,,0,0,0,,Хмм, сізде роботтарға аллергияңыз бар емес пе?
Dialogue: 0,1:19:26.92,1:19:30.93,Default,,0,0,0,,Менің ойымша, егер сіз мұны «умен улануды басқару» деп ойласаңыз, дұрыс емес.
Dialogue: 0,1:19:31.30,1:19:33.01,Default,,0,0,0,,Жалғастыру (Тергеуші В) Иә.
Dialogue: 0,1:19:33.10,1:19:35.52,Default,,0,0,0,,Осы Андроид көмегімен қарапайым тергеуде—
Dialogue: 0,1:19:35.60,1:19:38.69,Default,,0,0,0,,Негізгі тергеу тізіміне дәлелденген істер ғана қосылады.
Dialogue: 0,1:19:39.02,1:19:44.19,Default,,0,0,0,,Сонымен қатар, мен оқиға орнында куә болған адам андроидіне қатысты барлығын жазып алдым.
Dialogue: 0,1:19:44.57,1:19:46.19,Default,,0,0,0,,Кейінгі тергеуді жүргізу
Dialogue: 0,1:19:46.53,1:19:50.32,Default,,0,0,0,,Зиянды мінез-құлық болған жағдайда дереу полиция органының қызметкеріне хабарлаңыз.
Dialogue: 0,1:19:50.41,1:19:51.53,Default,,0,0,0,,Қамауға жәрдемдесу
Dialogue: 0,1:19:51.91,1:19:53.66,Default,,0,0,0,,АПК тенденциялары қандай?
Dialogue: 0,1:19:54.03,1:19:56.70,Default,,0,0,0,,Алдын ала тергеу кезінде иіскеп жүрген біреу бар дейді.
Dialogue: 0,1:19:56.79,1:19:57.95,Default,,0,0,0,,Ақпаратты қамтиды
Dialogue: 0,1:19:58.41,1:20:00.25,Default,,0,0,0,,АПК-мен байланысы белгісіз
Dialogue: 0,1:20:00.37,1:20:04.09,Default,,0,0,0,,Сондай-ақ, лоббистік белсенділік соңғы уақытта бәсеңдеген сияқты.
Dialogue: 0,1:20:04.29,1:20:06.88,Default,,0,0,0,,Сіз естігеніңіздей, бұл тергеу мыналарды қамтиды:
Dialogue: 0,1:20:07.05,1:20:09.13,Default,,0,0,0,,Осыны пайдаланып қалуға тырысатындар бар.
Dialogue: 0,1:20:09.22,1:20:10.80,Default,,0,0,0,,Өтінемін, ұмытпаңыз
Dialogue: 0,1:20:11.38,1:20:12.93,Default,,0,0,0,,Андроид тергеушілері үшін—
Dialogue: 0,1:20:13.01,1:20:16.56,Default,,0,0,0,,Осы тергеу мен Этика жөніндегі комитет арасындағы қарым-қатынас қатаң құпияда сақталады.
Dialogue: 0,1:20:16.64,1:20:18.64,Default,,0,0,0,,Абсолюттік командаларды тиянақты орындау
Dialogue: 0,1:20:19.10,1:20:22.60,Default,,0,0,0,,Енді сол жарақат оқиғасы есінен танып қалды...
Dialogue: 0,1:20:23.15,1:20:25.94,Default,,0,0,0,,Ешқашан бір қателікті қайталама
Dialogue: 0,1:20:29.36,1:20:30.40,Default,,0,0,0,,Жалғастыруыңызды өтінеміз.
Dialogue: 0,1:20:30.53,1:20:32.11,Default,,0,0,0,,БАҚ стратегиясы бөлімі
Dialogue: 0,1:20:32.20,1:20:34.83,Default,,0,0,0,,Масаки CIO-да бір теледидар көрсетілімі бар
Dialogue: 0,1:20:34.91,1:20:38.87,Default,,0,0,0,,Әйелім оны үнемі мұрағаттап отырады.
Dialogue: 0,1:20:38.95,1:20:40.46,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:20:41.58,1:20:43.67,Default,,0,0,0,,Осыны атап өтейін
Dialogue: 0,1:20:43.75,1:20:46.63,Default,,0,0,0,,Біз, Этика комитеті, дабыл қағып жатқан нәрсе...
Dialogue: 0,1:20:46.71,1:20:50.76,Default,,0,0,0,,Күнделікті өмірге енетін роботтардың болуы.
Dialogue: 0,1:20:50.88,1:20:53.18,Default,,0,0,0,,О, бұл Мадам Киллер сияқты.
Dialogue: 0,1:20:53.26,1:20:54.59,Default,,0,0,0,,Е, қай жағы?
Dialogue: 0,1:20:54.72,1:20:56.22,Default,,0,0,0,,А, мен рұқсатсыз әбігерге түсіп жатырмын.
Dialogue: 0,1:20:56.30,1:20:57.47,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,1:20:58.18,1:21:02.23,Default,,0,0,0,,Әсіресе балалар, тіпті ол қарапайым жобаланған робот болса да.
Dialogue: 0,1:21:02.31,1:21:04.06,Default,,0,0,0,,Оны антропоморфизациялауға болады.
Dialogue: 0,1:21:04.31,1:21:08.73,Default,,0,0,0,,Бұл адамдар арасындағы қарым-қатынасқа кедергі келтіреді.
Dialogue: 0,1:21:08.82,1:21:09.78,Default,,0,0,0,,Эвеленд
Dialogue: 0,1:21:10.32,1:21:11.32,Default,,0,0,0,,Иә
Dialogue: 0,1:21:14.78,1:21:18.12,Default,,0,0,0,,Ей, сен соңғы кездері келмейсің, Масаки-кун. Неліктен?
Dialogue: 0,1:21:18.20,1:21:19.70,Default,,0,0,0,,Негізінде әртүрлі нәрселер бар...
Dialogue: 0,1:21:19.79,1:21:20.70,Default,,0,0,0,,Оны осылай созып, салбыратып қой.
Dialogue: 0,1:21:20.79,1:21:22.29,Default,,0,0,0,,Ахаха
Dialogue: 0,1:21:22.66,1:21:27.34,Default,,0,0,0,,Ең бастысы, соңғы кездері бұл жүзді жиі көрмейсің бе?
Dialogue: 0,1:21:27.50,1:21:29.55,Default,,0,0,0,,Ендеше, бұрынғы кездер сияқты.
Dialogue: 0,1:21:29.63,1:21:30.46,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,1:21:30.71,1:21:33.26,Default,,0,0,0,,Әдеп жөніндегі комитеттің бас ұйымы:
Dialogue: 0,1:21:33.51,1:21:37.55,Default,,0,0,0,,Роботтар қарапайым үй шаруашылығында танымал бола бастағаннан бері бар
Dialogue: 0,1:21:37.93,1:21:39.68,Default,,0,0,0,,10 жылдан астам уақыт өтті ме?
Dialogue: 0,1:21:40.47,1:21:41.68,Default,,0,0,0,,Ол кезде өте радикалды
Dialogue: 0,1:21:41.77,1:21:44.02,Default,,0,0,0,,Мен бұл роботқа қарсы топ деп естідім.
Dialogue: 0,1:21:44.27,1:21:45.52,Default,,0,0,0,,Мен білмедім
Dialogue: 0,1:21:45.65,1:21:47.94,Default,,0,0,0,,Мен соңғы бірнеше жыл бойы төмен профильді ұстандым.
Dialogue: 0,1:21:48.02,1:21:49.15,Default,,0,0,0,,Олар қарт адамды шынымен сынап жатыр
Dialogue: 0,1:21:49.27,1:21:53.28,Default,,0,0,0,,Баяғыда мен өзімнің шектен шыққан мінез-құлқымнан жарақат алдым.
Dialogue: 0,1:21:53.36,1:21:56.20,Default,,0,0,0,,Сіз Токисака оқиғасы туралы айтып отырсыз, солай ма?
Dialogue: 0,1:21:56.28,1:21:57.32,Default,,0,0,0,,Мен бұл туралы естідім.
Dialogue: 0,1:21:57.41,1:21:59.62,Default,,0,0,0,,Жарайды, бұл оқыс оқиға дейді.
Dialogue: 0,1:21:59.83,1:22:02.54,Default,,0,0,0,,Қалай болғанда да жұртшылықтың сыны сөзсіз.
Dialogue: 0,1:22:02.62,1:22:05.17,Default,,0,0,0,,Жауапкершілікті мойнына алып, сол кездегі төраға қызметінен кетті.
Dialogue: 0,1:22:05.25,1:22:09.75,Default,,0,0,0,,Содан бері, кем дегенде, соңғы уақытқа дейін тыныш болды.
Dialogue: 0,1:22:09.84,1:22:11.96,Default,,0,0,0,,Хмм, қиын оқиға.
Dialogue: 0,1:22:12.05,1:22:14.93,Default,,0,0,0,,Эй, мұның Масаки-кунға қатысы бар ма?
Dialogue: 0,1:22:15.30,1:22:16.13,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:17.30,1:22:19.60,Default,,0,0,0,,Рахмет, Масаки мырза.
Dialogue: 0,1:22:19.97,1:22:21.97,Default,,0,0,0,,Бүгінгі масштабтау шифры –
Dialogue: 0,1:22:22.06,1:22:26.19,Default,,0,0,0,,Біз Этика комитетінің қоғаммен байланыс жөніндегі қызметкері Цуру Масакиді қонақ ретінде қарсы аламыз.
Dialogue: 0,1:22:26.27,1:22:27.69,Default,,0,0,0,,Мен сіздің әңгімеңізді естідім.
Dialogue: 0,1:22:27.77,1:22:29.02,Default,,0,0,0,,Масаки…
Dialogue: 0,1:22:29.48,1:22:30.32,Default,,0,0,0,,Иә
Dialogue: 0,1:22:30.73,1:22:33.69,Default,,0,0,0,,Бұл отбасылық жағдай ма? Бүгін тағы шақырдым...
Dialogue: 0,1:22:33.78,1:22:35.78,Default,,0,0,0,,Сіздің тегіңіз Масаки болды ма?
Dialogue: 0,1:22:37.16,1:22:39.16,Default,,0,0,0,,Солай ма? Бұлай емес.
Dialogue: 0,1:22:49.50,1:22:51.34,Default,,0,0,0,,Әй, қалайсың?
Dialogue: 0,1:22:57.34,1:22:59.51,Default,,0,0,0,,«Ева Уақыты» атты дүкен бар.
Dialogue: 0,1:22:59.84,1:23:01.68,Default,,0,0,0,,Рикуо саған қатты ұнады.
Dialogue: 0,1:23:02.31,1:23:05.35,Default,,0,0,0,,Мен де сонда болдым, сондықтан басқа адамдар туралы айта алмаймын.
Dialogue: 0,1:23:08.52,1:23:11.52,Default,,0,0,0,,Адамдар мен андроидтар қалыпты сөйлейді.
Dialogue: 0,1:23:11.61,1:23:13.23,Default,,0,0,0,,Бұл ақымақтық.
Dialogue: 0,1:23:13.48,1:23:14.32,Default,,0,0,0,,Эй?
Dialogue: 0,1:23:21.95,1:23:22.95,Default,,0,0,0,,Бірдеңе айт
Dialogue: 0,1:23:23.03,1:23:23.91,Default,,0,0,0,,
Dialogue: 0,1:23:23.99,1:23:24.91,Default,,0,0,0,,Кірейік
Dialogue: 0,1:23:25.41,1:23:26.96,Default,,0,0,0,,Сіз кіммен сөйлесіп тұрсыз?
Dialogue: 0,1:23:27.29,1:23:28.58,Default,,0,0,0,,Ah ұялы телефон
Dialogue: 0,1:23:28.75,1:23:29.79,Default,,0,0,0,,Қазірдің өзінде кесілген
Dialogue: 0,1:23:31.33,1:23:33.42,Default,,0,0,0,,Олар сізге кофе дайындады ма?
Dialogue: 0,1:23:33.50,1:23:34.96,Default,,0,0,0,,Неге ол маған ештеңе айтпады екен?
Dialogue: 0,1:23:35.84,1:23:38.55,Default,,0,0,0,,Соңғы кездері үйде көп болдың ғой, солай ма?
Dialogue: 0,1:23:39.09,1:23:40.39,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,1:23:42.30,1:23:44.26,Default,,0,0,0,,Әкеңе бірдеңе айт.
Dialogue: 0,1:23:45.60,1:23:47.39,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,1:23:47.73,1:23:48.73,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:23:50.06,1:23:53.19,Default,,0,0,0,,Аузыңызға не салатыныңызды роботтарға қалдырмаңыз.
Dialogue: 0,1:23:53.90,1:23:57.86,Default,,0,0,0,,THX Бүгінгі кешке есеп беру сессиясының хаттамаларын жасаңыз.
Dialogue: 0,1:23:58.57,1:24:00.66,Default,,0,0,0,,Деректер менің құрылғымда
Dialogue: 0,1:24:06.58,1:24:08.83,Default,,0,0,0,,Масаки-кунға кез келген уақытта келуін айтыңыз.
Dialogue: 0,1:24:08.91,1:24:10.21,Default,,0,0,0,,Иә, айтамын.
Dialogue: 0,1:24:10.33,1:24:12.54,Default,,0,0,0,,Сіз тым үлкен үміт күтпейсіз деп үміттенемін, бірақ...
Dialogue: 0,1:24:12.63,1:24:14.25,Default,,0,0,0,,Қош бол, тағы кел
Dialogue: 0,1:24:16.21,1:24:18.97,Default,,0,0,0,,Мм... мен үйге қайттым.
Dialogue: 0,1:24:20.30,1:24:23.51,Default,,0,0,0,,Эй, Рикуо-кун, саған енді бәрібір деп ойламаймын.
Dialogue: 0,1:24:23.68,1:24:25.47,Default,,0,0,0,,Мен осылай сезінемін
Dialogue: 0,1:24:25.68,1:24:28.85,Default,,0,0,0,,Наги-сан Рикуоны түсінбейді.
Dialogue: 0,1:24:29.27,1:24:31.60,Default,,0,0,0,,Себебі мен сенімен ұзақ уақыт болдым.
Dialogue: 0,1:24:32.48,1:24:35.32,Default,,0,0,0,,Әлі де бетпе-бет кездескіңіз келмейтініне сенімдімін.
Dialogue: 0,1:24:35.40,1:24:36.23,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,1:24:36.32,1:24:39.07,Default,,0,0,0,,Эй, Рикуо-кун маған бәрібір.
Dialogue: 0,1:24:39.15,1:24:40.95,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,1:24:39.15,1:24:40.95,Default,,0,0,0,,Бұлай айтпа.
Dialogue: 0,1:24:41.03,1:24:42.78,Default,,0,0,0,,Хмм, дұрыс.
Dialogue: 0,1:24:42.95,1:24:43.78,Default,,0,0,0,,Нахаха~
Dialogue: 0,1:24:43.87,1:24:45.03,Default,,0,0,0,,Өтінемін, Рикуо-кунға оғаш сөздер айтпаңыз.
Dialogue: 0,1:24:45.03,1:24:46.12,Default,,0,0,0,,Өтінемін, Рикуо-кунға оғаш сөздер айтпа.
Dialogue: 0,1:24:45.03,1:24:46.12,Default,,0,0,0,,Ол айналып өткеннен кейін әлсіз жақтарымнан шағын соққылар береді.
Dialogue: 0,1:24:50.16,1:24:53.29,Default,,0,0,0,,Масаки-кун, сен маған ештеңе айтпайсың.
Dialogue: 0,1:24:58.51,1:24:59.55,Default,,0,0,0,,Мияу
Dialogue: 0,1:25:01.01,1:25:04.64,Default,,0,0,0,,Ондай жағдайда бұл дүкенді жабудан басқа амалымыз қалмайды.
Dialogue: 0,1:25:04.72,1:25:07.06,Default,,0,0,0,,Бұл... өте керемет жер.
Dialogue: 0,1:25:07.22,1:25:08.26,Default,,0,0,0,,Сэмми-чан
Dialogue: 0,1:25:08.89,1:25:12.19,Default,,0,0,0,,Мұнда алғаш рет қалай келгеніңіз есіңізде ме?
Dialogue: 0,1:25:14.31,1:25:17.27,Default,,0,0,0,,Мен Наги-сан шақырды деп ойладым.
Dialogue: 0,1:25:20.99,1:25:24.70,Default,,0,0,0,,Мен өзіммен ешкімді ала алмаймын.
Dialogue: 0,1:25:25.45,1:25:28.37,Default,,0,0,0,,Сізге «Хауа ананың уақытын» үйреткен адам—
Dialogue: 0,1:25:28.45,1:25:30.91,Default,,0,0,0,,Мүмкін бұрын осында болған біреу шығар.
Dialogue: 0,1:25:31.50,1:25:35.58,Default,,0,0,0,,Сосын Сэмми Рикуо мен Масакиді алып келді.
Dialogue: 0,1:25:36.21,1:25:37.09,Default,,0,0,0,,Сол себепті
Dialogue: 0,1:25:37.34,1:25:40.21,Default,,0,0,0,,Масаки этика комитетінен біреуді әкелсе...
Dialogue: 0,1:25:40.30,1:25:42.17,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,1:25:42.55,1:25:44.55,Default,,0,0,0,,Бұл байланыс сонда аяқталады.
Dialogue: 0,1:25:44.84,1:25:46.34,Default,,0,0,0,,Бұл дүкен де жабық.
Dialogue: 0,1:25:46.59,1:25:49.10,Default,,0,0,0,,Наги-сан, жарай ма?
Dialogue: 0,1:25:50.22,1:25:54.06,Default,,0,0,0,,Бұл әр адамның жүрегінде гүлденген дүкен.
Dialogue: 0,1:25:54.77,1:25:56.94,Default,,0,0,0,,Мен жай ғана оны көргім келеді
Dialogue: 0,1:25:57.52,1:26:00.23,Default,,0,0,0,,Бұл шеңбер қаншалықты кеңейе алады?
Dialogue: 0,1:26:06.28,1:26:08.03,Default,,0,0,0,,Сол шебер
Dialogue: 0,1:26:11.24,1:26:12.62,Default,,0,0,0,,Не?
Dialogue: 0,1:26:13.33,1:26:16.21,Default,,0,0,0,,Масаки-саманың қайта келгенін қалайсың ба?
Dialogue: 0,1:26:17.08,1:26:18.38,Default,,0,0,0,,«Хауа уақытында»…
Dialogue: 0,1:26:22.51,1:26:25.30,Default,,0,0,0,,Иә, сенің келгеніңді қалаймын.
Dialogue: 0,1:26:25.88,1:26:27.93,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,1:26:28.30,1:26:31.39,Default,,0,0,0,,Жарайды, мен сені ертең міндетті түрде апарамын!
Dialogue: 0,1:27:05.42,1:27:06.30,Default,,0,0,0,,Ах!
Dialogue: 0,1:27:12.51,1:27:13.47,Default,,0,0,0,,Масаки!
Dialogue: 0,1:27:15.27,1:27:16.89,Default,,0,0,0,,Бүгін... Мен бармаймын.
Dialogue: 0,1:27:19.73,1:27:21.40,Default,,0,0,0,,Сіз менің тағы да келгенімді айттыңыз.
Dialogue: 0,1:27:21.48,1:27:23.69,Default,,0,0,0,,Кездейсоқ нәрселерді айтпа, тіпті бұл шындық болса да
Dialogue: 0,1:27:24.28,1:27:25.24,Default,,0,0,0,,Кім?
Dialogue: 0,1:27:25.36,1:27:27.45,Default,,0,0,0,,Мм... Наги-сан әлде бір нәрсе ме?
Dialogue: 0,1:27:27.61,1:27:29.11,Default,,0,0,0,,Аа, Сэмми де солай деді.
Dialogue: 0,1:27:29.49,1:27:31.12,Default,,0,0,0,,Оның да келгенін қалаймын.
Dialogue: 0,1:27:36.91,1:27:40.79,Default,,0,0,0,,Менің не келгенімді қалайсыз? Бұл Houseroid.
Dialogue: 0,1:27:44.46,1:27:46.30,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,1:27:47.76,1:27:50.51,Default,,0,0,0,,Сіз өзгердіңіз, солай емес пе?
Dialogue: 0,1:27:50.64,1:27:51.47,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:53.05,1:27:55.01,Default,,0,0,0,,Масаки Эй, бұл не?
Dialogue: 0,1:27:55.43,1:27:57.98,Default,,0,0,0,,Сіз ол кезде мен сияқты емессіз бе?
Dialogue: 0,1:27:59.94,1:28:02.98,Default,,0,0,0,,Махаббатты сезсең де, бір күні опасыздық болады
Dialogue: 0,1:28:04.98,1:28:06.90,Default,,0,0,0,,Ондай дүкендер болмаса жақсы болар еді.
Dialogue: 0,1:28:07.90,1:28:10.32,Default,,0,0,0,,Иә, оның болмағаны жақсы.
Dialogue: 0,1:28:18.96,1:28:20.96,Default,,0,0,0,,Қария, менің саған айтар сөзім бар.
Dialogue: 0,1:28:30.17,1:28:32.34,Default,,0,0,0,,THX жоғалды
Dialogue: 0,1:28:33.43,1:28:36.18,Default,,0,0,0,,Масаказу Сіз қандай да бір бұйрық бердіңіз бе?
Dialogue: 0,1:28:38.35,1:28:39.18,Default,,0,0,0,,Жоқ
Dialogue: 0,1:28:39.27,1:28:42.85,Default,,0,0,0,,Сіздің жоғалып кетуіңіз мүлдем ақылсыздық болды ма?
Dialogue: 0,1:28:43.19,1:28:45.15,Default,,0,0,0,,Мен тезірек орынды тауып, оны жоюым керек.
Dialogue: 0,1:28:45.23,1:28:46.07,Default,,0,0,0,,Жою?
Dialogue: 0,1:28:46.15,1:28:50.07,Default,,0,0,0,,Әрине, мұнда этика жөніндегі комиссияның көптеген материалдары да айтылады.
Dialogue: 0,1:28:50.78,1:28:53.41,Default,,0,0,0,,Бірдеңені проблемаға айналдырмай тұрып жасаңыз.
Dialogue: 0,1:29:18.72,1:29:22.23,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,1:29:24.56,1:29:25.52,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:29:32.24,1:29:34.41,Default,,0,0,0,,Масаки
Dialogue: 0,1:29:34.49,1:29:36.99,Default,,0,0,0,,Қазір «Ева Уақыты» болды, маған аздап көмектесе аласыз ба?
Dialogue: 0,1:29:37.08,1:29:38.24,Default,,0,0,0,,Бұл қандай дыбыс?
Dialogue: 0,1:29:38.33,1:29:39.58,Default,,0,0,0,,Өте көне робот
Dialogue: 0,1:29:39.66,1:29:42.91,Default,,0,0,0,,Әй, мұнда көне тұтынушылар бар.
Dialogue: 0,1:29:43.08,1:29:43.96,Default,,0,0,0,,Осы дүкенді жабу...
Dialogue: 0,1:29:44.04,1:29:45.63,Default,,0,0,0,,Сонымен қандай дыбыс?
Dialogue: 0,1:29:45.71,1:29:49.71,Default,,0,0,0,,Мынау экран... Не істесем де тоқтамайды.
Dialogue: 0,1:29:50.25,1:29:53.30,Default,,0,0,0,,Сондай-ақ, бұл THX түрі мүлдем сөйлемейді.
Dialogue: 0,1:29:54.34,1:29:55.64,Default,,0,0,0,,Әй, не?
Dialogue: 0,1:29:55.72,1:29:57.47,Default,,0,0,0,,Бұл дүкен сұр аймақта, солай ма?
Dialogue: 0,1:29:57.55,1:29:59.35,Default,,0,0,0,,Мұнда келіп, сүйікті робот әдісін қолданыңыз—
Dialogue: 0,1:29:59.43,1:30:01.60,Default,,0,0,0,,Сіз бұл туралы бірдеңе істей аласыз ба? Не...
Dialogue: 0,1:30:02.06,1:30:03.39,Default,,0,0,0,,(Эндевор) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,1:30:03.48,1:30:04.31,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:30:14.99,1:30:16.41,Default,,0,0,0,,Текс, тоқтат.
Dialogue: 0,1:30:16.49,1:30:17.41,Default,,0,0,0,,(дыбысты өшіру)
Dialogue: 0,1:30:19.58,1:30:21.08,Default,,0,0,0,,Текс?
Dialogue: 0,1:30:29.29,1:30:31.25,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,1:30:41.10,1:30:43.27,Default,,0,0,0,,О, солай ма?
Dialogue: 0,1:30:43.77,1:30:45.64,Default,,0,0,0,,Адам роботын рұқсатсыз әкелу —
Dialogue: 0,1:30:45.73,1:30:48.48,Default,,0,0,0,,Балалар, сендерге үш тиындық ойын көрсетейік.
Dialogue: 0,1:30:49.11,1:30:51.40,Default,,0,0,0,,Мен сені мұнда қалай әкелгенін білмеймін.
Dialogue: 0,1:30:51.48,1:30:52.61,Default,,0,0,0,,Міне, солай.
Dialogue: 0,1:30:52.82,1:30:54.65,Default,,0,0,0,,Мен тіпті өзіммен бірге Рикуоның роботын алып келдім.
Dialogue: 0,1:30:54.94,1:30:56.32,Default,,0,0,0,,Сіз көп нәрсені істей аласыз, солай ма?
Dialogue: 0,1:30:56.49,1:30:58.20,Default,,0,0,0,,Бұл жұмбақ дүкен не?
Dialogue: 0,1:30:58.28,1:31:00.70,Default,,0,0,0,,Мені мұнда Наги-чан әкелген жоқ деп ойлаймын...
Dialogue: 0,1:31:00.78,1:31:01.66,Default,,0,0,0,,Аки-чан
Dialogue: 0,1:31:01.83,1:31:04.45,Default,,0,0,0,,Сондықтан мені сүйреп шығарғың келеді.
Dialogue: 0,1:31:08.83,1:31:10.08,Default,,0,0,0,,Бұл не болып жатыр?
Dialogue: 0,1:31:11.09,1:31:12.75,Default,,0,0,0,,Мен баяғыда осы жігіттің қолында өстім.
Dialogue: 0,1:31:13.09,1:31:14.92,Default,,0,0,0,,Біз бәрінен де жақын болдық.
Dialogue: 0,1:31:15.30,1:31:17.63,Default,,0,0,0,,Бір күні бұл жігіт кенет сөйлеп қалды.
Dialogue: 0,1:31:17.93,1:31:19.01,Default,,0,0,0,,Мен бала едім
Dialogue: 0,1:31:19.09,1:31:22.47,Default,,0,0,0,,Мені отбасым деп ойлаған жігіт сатқындық жасады, мен ренжідім.
Dialogue: 0,1:31:23.56,1:31:26.06,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,1:31:31.81,1:31:34.86,Default,,0,0,0,,Сөйлеспеуіңіздің себебі болуы керек, солай ма?
Dialogue: 0,1:31:34.94,1:31:36.49,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,1:31:36.78,1:31:39.82,Default,,0,0,0,,Ол сынған сияқты емес.
Dialogue: 0,1:31:39.91,1:31:41.28,Default,,0,0,0,,Мен білемін.
Dialogue: 0,1:31:41.53,1:31:45.12,Default,,0,0,0,,4-5 жылдан кейін мен бала сияқты нәрселерді түсіне бастадым.
Dialogue: 0,1:31:46.95,1:31:48.58,Default,,0,0,0,,Қарт бұйрық берді.
Dialogue: 0,1:31:49.17,1:31:51.21,Default,,0,0,0,,Қандай жағдай болмасын, сөйлеме.
Dialogue: 0,1:31:51.46,1:31:53.59,Default,,0,0,0,,Сіз мені және бұл жігітті ажыратқыңыз келді, солай ма?
Dialogue: 0,1:31:53.84,1:31:55.21,Default,,0,0,0,,Қарт кісі осылай істейтін еді
Dialogue: 0,1:31:55.30,1:31:57.76,Default,,0,0,0,,Ата-ананың бұйрықтары басымдыққа ие
Dialogue: 0,1:31:57.97,1:32:00.01,Default,,0,0,0,,Масаки-кун ақылды.
Dialogue: 0,1:32:00.09,1:32:01.43,Default,,0,0,0,,Somei дегеніміз не?
Dialogue: 0,1:32:01.68,1:32:03.85,Default,,0,0,0,,Бала кезімде түсінбейтінмін!
Dialogue: 0,1:32:04.10,1:32:06.22,Default,,0,0,0,,Мен бұл жігітпен қайтадан сөйлесу үшін бәрін істеймін!
Dialogue: 0,1:32:06.47,1:32:09.10,Default,,0,0,0,,Мен тіпті жылап кешірім сұрадым.
Dialogue: 0,1:32:14.48,1:32:15.73,Default,,0,0,0,,Бұйыртса...
Dialogue: 0,1:32:15.82,1:32:18.40,Default,,0,0,0,,Жылап жатқан баланы елемеуге болмайды.
Dialogue: 0,1:32:18.86,1:32:20.24,Default,,0,0,0,,Көп жылдар бойы
Dialogue: 0,1:32:22.03,1:32:22.95,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:32:23.03,1:32:27.20,Default,,0,0,0,,Бұл жігіттер адамның жүрегін түсінбейді ғой!
Dialogue: 0,1:32:38.21,1:32:39.80,Default,,0,0,0,,Қарапайым зерттеу үшін Андроид жүйесін пайдалану
Dialogue: 0,1:32:39.80,1:32:41.01,Default,,0,0,0,,Қарапайым зерттеу үшін Андроид жүйесін пайдалану
Dialogue: 0,1:32:39.80,1:32:41.01,Default,,0,0,0,,«Ева Уақыты» деп аталатын дүкен бар.
Dialogue: 0,1:32:41.01,1:32:41.30,Default,,0,0,0,,«Ева Уақыты» деп аталатын дүкен бар.
Dialogue: 0,1:32:41.38,1:32:42.84,Default,,0,0,0,,Мен де сонда болдым, сондықтан басқалардың атынан сөйлей алмаймын.
Dialogue: 0,1:32:42.84,1:32:43.64,Default,,0,0,0,,Мен де сонда болдым, сондықтан басқалардың атынан сөйлей алмаймын.
Dialogue: 0,1:32:42.84,1:32:43.64,Default,,0,0,0,,Оқиға орнында куә болған барлық адам андроидтерін жазып алыңыз
Dialogue: 0,1:32:43.64,1:32:45.81,Default,,0,0,0,,Оқиға орнында куә болған барлық адам андроидтерін жазып алыңыз
Dialogue: 0,1:32:45.89,1:32:46.93,Default,,0,0,0,,Қамауға жәрдемдесу
Dialogue: 0,1:32:47.01,1:32:48.72,Default,,0,0,0,,Өшіру керек жер.
Dialogue: 0,1:33:07.33,1:33:11.91,Default,,0,0,0,,Бұдан былай мен бұл дүкеннің ережесін бұзамын.
Dialogue: 0,1:33:13.42,1:33:17.80,Default,,0,0,0,,Сіз робот туралы заңның 9-бабының 3-тармағын бұзасыз.
Dialogue: 0,1:33:18.09,1:33:20.88,Default,,0,0,0,,Өйткені мендегі деректерге сәйкес
Dialogue: 0,1:33:20.97,1:33:22.76,Default,,0,0,0,,Сіз андроидсыз—
Dialogue: 0,1:33:22.84,1:33:25.47,Default,,0,0,0,,Андроид жүктеліп жатқанда қоңырауды қалай өшіруге болады—
Dialogue: 0,1:33:25.55,1:33:27.68,Default,,0,0,0,,Бұл робот туралы заңның бұзылуы.
Dialogue: 0,1:33:33.14,1:33:34.31,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:33:34.73,1:33:36.81,Default,,0,0,0,,Текс не үшін сөйлеп тұр?
Dialogue: 0,1:33:37.36,1:33:39.36,Default,,0,0,0,,Қарияның бұйрығына не болды?
Dialogue: 0,1:33:40.07,1:33:42.70,Default,,0,0,0,,Тапсырысты бұзу
Dialogue: 0,1:33:43.07,1:33:44.66,Default,,0,0,0,,2-бапты бұзу
Dialogue: 0,1:33:45.07,1:33:47.78,Default,,0,0,0,,Тек 1-бап 2-бапты бұза алады.
Dialogue: 0,1:33:48.16,1:33:50.16,Default,,0,0,0,,1-бап Қауіп
Dialogue: 0,1:33:51.62,1:33:53.83,Default,,0,0,0,,Кім? Адам?
Dialogue: 0,1:33:54.37,1:33:56.08,Default,,0,0,0,,Мұндағы адамдарға қауіп төніп тұр ма?
Dialogue: 0,1:33:57.17,1:33:59.84,Default,,0,0,0,,Жоқ, біз Текстің адам екенін білеміз...
Dialogue: 0,1:33:59.96,1:34:02.13,Default,,0,0,0,,Мұнда жалғыз мен ғанамын
Dialogue: 0,1:34:02.51,1:34:03.80,Default,,0,0,0,,Маған қауіп төніп тұр ма?
Dialogue: 0,1:34:03.88,1:34:06.97,Default,,0,0,0,,Сондықтан мені қорғау үшін сөйлейсің
Dialogue: 0,1:34:07.89,1:34:12.93,Default,,0,0,0,,Сондықтан әкімшіңізге қатысты заңды шара қолдануымыз керек.
Dialogue: 0,1:34:14.60,1:34:17.06,Default,,0,0,0,,Әкімші ақпаратын сұраңыз
Dialogue: 0,1:34:17.86,1:34:21.40,Default,,0,0,0,,Осы тергеу мен Этика жөніндегі комитет арасындағы қарым-қатынас қатаң түрде құпия сақталады.
Dialogue: 0,1:34:21.48,1:34:23.57,Default,,0,0,0,,Абсолюттік командаларды тиянақты орындау
Dialogue: 0,1:34:28.74,1:34:30.03,Default,,0,0,0,,Масаки (Чи Акико) Масаки
Dialogue: 0,1:34:32.75,1:34:33.66,Default,,0,0,0,,Масаки-кун Масаки
Dialogue: 0,1:34:33.79,1:34:34.83,Default,,0,0,0,,Мен сені жібермеймін
Dialogue: 0,1:34:37.08,1:34:40.04,Default,,0,0,0,,Сен... менімен сөйлескенше
Dialogue: 0,1:34:40.29,1:34:41.71,Default,,0,0,0,,Мені жіберме!
Dialogue: 0,1:34:44.34,1:34:45.51,Default,,0,0,0,,Бізге жақсылап сөйлесу керек!
Dialogue: 0,1:34:46.38,1:34:49.39,Default,,0,0,0,,Сіз не ойладыңыз?
Dialogue: 0,1:34:49.93,1:34:51.97,Default,,0,0,0,,Көп жылдар бойы
Dialogue: 0,1:34:53.39,1:34:54.23,Default,,0,0,0,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,1:34:54.48,1:34:57.19,Default,,0,0,0,,Маған қарап тұр
Dialogue: 0,1:34:57.94,1:34:59.61,Default,,0,0,0,,Менің қасымда бол
Dialogue: 0,1:35:03.44,1:35:07.32,Default,,0,0,0,,Маған көмектесші, Текс! Маған айқайла!
Dialogue: 0,1:35:24.46,1:35:27.05,Default,,0,0,0,,Мен сенімен сөйлесе алмаймын...
Dialogue: 0,1:35:28.34,1:35:30.80,Default,,0,0,0,,Мен сенің жаныңда мәңгі болғым келеді...
Dialogue: 0,1:35:33.85,1:35:34.77,Default,,0,0,0,,Мен
Dialogue: 0,1:35:38.56,1:35:39.52,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,1:35:43.77,1:35:49.45,Default,,0,0,0,,Мен әрқашан Масаказу-кун туралы ойладым...
Dialogue: 0,1:35:56.33,1:35:57.25,Default,,0,0,0,,Ах...
Dialogue: 0,1:36:03.92,1:36:04.92,Default,,0,0,0,,Қый!
Dialogue: 0,1:36:07.38,1:36:08.22,Default,,0,0,0,,Уф...
Dialogue: 0,1:36:10.34,1:36:11.18,Default,,0,0,0,,Уф...
Dialogue: 0,1:36:32.45,1:36:36.29,Default,,0,0,0,,Менің ойымша, ол мына баланы Масаки-кунды қорғағысы келді.
Dialogue: 0,1:36:37.58,1:36:39.79,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,1:36:41.33,1:36:43.00,Default,,0,0,0,,Қауіп өткен соң сөйлей алмаймын.
Dialogue: 0,1:36:43.58,1:36:47.09,Default,,0,0,0,,Бұл жігіт әлі күнге дейін қарияның бұйрығына байланысты.
Dialogue: 0,1:36:49.05,1:36:51.51,Default,,0,0,0,,Менің де түсінгенімді қалайсың ба?
Dialogue: 0,1:36:53.97,1:36:57.14,Default,,0,0,0,,Бірақ мен оны әлі қабылдай алмаймын.
Dialogue: 0,1:36:59.39,1:37:01.39,Default,,0,0,0,,Бұл қазір мүмкін емес, бірақ—
Dialogue: 0,1:37:02.44,1:37:05.27,Default,,0,0,0,,Мен бір күні сөйлей алатыныма сенімдімін.
Dialogue: 0,1:37:05.90,1:37:07.36,Default,,0,0,0,,Кездейсоқ нәрселерді айтпаңыз
Dialogue: 0,1:37:07.82,1:37:08.69,Default,,0,0,0,,Ол сөзсіз осында—
Dialogue: 0,1:37:09.07,1:37:12.40,Default,,0,0,0,,Бұл себеп жоқ емес, бірақ мен оны айта алмаймын...
Dialogue: 0,1:37:16.08,1:37:20.20,Default,,0,0,0,,Мен мұнда көп нәрсені көрдім, және көптеген мәселелер бар ...
Dialogue: 0,1:37:21.08,1:37:22.41,Default,,0,0,0,,Мен әр жолы уайымдадым...
Dialogue: 0,1:37:23.37,1:37:27.29,Default,,0,0,0,,Бірақ мен біз дұрыс бағытта келе жатқандай сезінемін.
Dialogue: 0,1:37:28.50,1:37:30.92,Default,,0,0,0,,Масакидікі де солай.
Dialogue: 0,1:37:32.01,1:37:33.88,Default,,0,0,0,,Әрине
Dialogue: 0,1:37:46.65,1:37:47.73,Default,,0,0,0,,Түстен кейін Фудзисаваға қайтасың да, мектепке барасың, иә?
Dialogue: 0,1:37:53.45,1:37:56.37,Default,,0,0,0,,Мен оны шығардым деп айтамын, қария.
Dialogue: 0,1:38:02.71,1:38:08.54,Default,,0,0,0,,Мен... Масаказу-кун туралы ойладым...
Dialogue: 0,1:38:13.26,1:38:14.26,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,1:38:38.24,1:38:39.20,Default,,0,0,0,,Сіз қалай кірдіңіз?
Dialogue: 0,1:38:39.28,1:38:40.74,Default,,0,0,0,,Ұстаңыз (Коджи) Жоғары көтеріңіз
Dialogue: 0,1:38:41.41,1:38:43.62,Default,,0,0,0,,...Қолайсыздықтар үшін кешірім сұраймын.
Dialogue: 0,1:38:44.66,1:38:46.83,Default,,0,0,0,,Бір күні мен саған бүгінгі күніңе рахмет айтамын.
Dialogue: 0,1:38:47.83,1:38:48.96,Default,,0,0,0,,Мен бәріңді жақсы көремін
Dialogue: 0,1:38:50.29,1:38:51.46,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,1:38:52.25,1:38:54.01,Default,,0,0,0,,Осы жерде бола білу
Dialogue: 0,1:39:01.47,1:39:02.72,Default,,0,0,0,,Мен сенімен үйге барамын.
Dialogue: 0,1:39:02.81,1:39:04.14,Default,,0,0,0,,А, жарайды.
Dialogue: 0,1:39:14.86,1:39:16.53,Default,,0,0,0,,Мен көмектесуім керек пе еді?
Dialogue: 0,1:39:16.70,1:39:19.07,Default,,0,0,0,,Жоқ, егер сіз оған көз жеткізсеңіз, бәрі жақсы.
Dialogue: 0,1:39:19.53,1:39:22.95,Default,,0,0,0,,Қауіпті оқиға болуы да мүмкін болды.
Dialogue: 0,1:39:26.79,1:39:29.92,Default,,0,0,0,,Шиозуки мұны көп білуі керек.
Dialogue: 0,1:39:31.21,1:39:34.59,Default,,0,0,0,,Сіз шынымен Шиозуки мырзамен туыссыз ба?
Dialogue: 0,1:39:34.67,1:39:35.92,Default,,0,0,0,,Осы дүкеннің ережелері
Dialogue: 0,1:39:38.68,1:39:41.22,Default,,0,0,0,,Бұл шынымен де «1138»
Dialogue: 0,1:39:41.68,1:39:43.43,Default,,0,0,0,,“1138”
Dialogue: 0,1:39:43.56,1:39:47.52,Default,,0,0,0,,Тіпті Жапонияның робот заңынан да асып түсетін тәртіп басымдылығы
Dialogue: 0,1:39:48.14,1:39:49.81,Default,,0,0,0,,Бұл оны түсіндіруі керек.
Dialogue: 0,1:39:50.48,1:39:53.19,Default,,0,0,0,,Кодтың қызмет ету мерзімінде басу тізбегі жұмыс істемейді.
Dialogue: 0,1:39:53.82,1:39:56.49,Default,,0,0,0,,Бәрі де сол заманның арқасы
Dialogue: 0,1:39:57.15,1:40:00.41,Default,,0,0,0,,Мұны Шиоцзукиден басқа кім жасай алды?
Dialogue: 0,1:40:04.08,1:40:05.41,Default,,0,0,0,,Бірақ... (Доктор Ашимори) Тағы бір нәрсе.
Dialogue: 0,1:40:07.50,1:40:10.17,Default,,0,0,0,,Токисака оқиғасы...Бұл сол кездегі мақала ма?
Dialogue: 0,1:40:11.38,1:40:13.00,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,1:40:13.92,1:40:17.84,Default,,0,0,0,,Бұл жарияланар алдында ғана ауыстырылған нағыз мақала.
Dialogue: 0,1:40:19.01,1:40:23.01,Default,,0,0,0,,Сол кезде 5 жасар қыз тірі болса...
Dialogue: 0,1:40:37.74,1:40:40.07,Default,,0,0,0,,Мен бүгін Эвелендті сағындым.
Dialogue: 0,1:40:40.24,1:40:42.07,Default,,0,0,0,,Маған бірдеңе жетіспей тұрғандай болды.
Dialogue: 0,1:40:48.00,1:40:50.96,Default,,0,0,0,,Текс бұл дүкенге қалай келді?
Dialogue: 0,1:40:51.17,1:40:52.50,Default,,0,0,0,,О, мен түсінбедім?
Dialogue: 0,1:40:52.67,1:40:53.50,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,1:40:53.58,1:40:55.88,Default,,0,0,0,,Мен сені кәдімгі адам деп ойладым...
Dialogue: 0,1:40:55.96,1:40:57.50,Default,,0,0,0,,Рикуо-кун, сенде әлі көп жол бар.
Dialogue: 0,1:40:57.59,1:40:59.05,Default,,0,0,0,,Әлі емес...
Dialogue: 0,1:40:59.13,1:41:00.22,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:41:00.76,1:41:02.22,Default,,0,0,0,,Ах, жаңа келді.
Dialogue: 0,1:41:02.59,1:41:04.30,Default,,0,0,0,,Мен жай ғана сәлем беремін.
Dialogue: 0,1:41:05.39,1:41:07.01,Default,,0,0,0,,Бұл менің Хауаның кезіндегі әңгімем
Dialogue: 0,1:41:07.01,1:41:08.06,Default,,0,0,0,,Бұл менің Хауаның кезіндегі әңгімем
Dialogue: 0,1:41:07.01,1:41:08.06,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:41:08.14,1:41:09.43,Default,,0,0,0,,Бос орынға отырыңыз.
Dialogue: 0,1:41:09.60,1:41:10.85,Default,,0,0,0,,Мен тапсырысыңызды алып кетейін.
Dialogue: 0,1:41:11.06,1:41:14.77,Default,,0,0,0,,Мен осыдан кейін көптеген түрлі тәжірибелерге ие боламын...
Dialogue: 0,1:41:14.86,1:41:18.15,Default,,0,0,0,,Бұл аз уақыт болуы мүмкін, бірақ ләззат алыңыз.
Dialogue: 0,1:41:19.15,1:41:22.45,Default,,0,0,0,,Бұл басқа әңгіме...
Dialogue: 0,1:41:23.49,1:41:27.49,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:45:00.21,1:45:04.21,Default,,0,0,0,,~♪
Dialogue: 0,1:45:09.46,1:45:10.72,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:45:12.18,1:45:13.59,Default,,0,0,0,,Әлі де жақсы сияқты
Dialogue: 0,1:45:15.51,1:45:18.02,Default,,0,0,0,,Бұл көп күш жұмсауды талап етеді...
Dialogue: 0,1:45:18.85,1:45:22.39,Default,,0,0,0,,Мұхиттың иісі болмаса да, қазіргі дүкен маған ұнайды.
Dialogue: 0,1:45:23.06,1:45:25.61,Default,,0,0,0,,Қала болғандықтан, әр түрлі балалар жиналады.
Dialogue: 0,1:45:27.02,1:45:29.28,Default,,0,0,0,,Барлығы... Қалдарың қалай?
Dialogue: 0,1:45:30.11,1:45:30.94,Default,,0,0,0,,Иә
Dialogue: 0,1:45:34.53,1:45:36.07,Default,,0,0,0,,Сіз қайғылы көрінесіз...
Dialogue: 0,1:45:37.49,1:45:41.46,Default,,0,0,0,,Сол баланы Ашимори жойып жібергеннен бері...
Dialogue: 0,1:45:41.54,1:45:43.37,Default,,0,0,0,,Мен уайымдап тұрмын.
Dialogue: 0,1:45:44.62,1:45:47.84,Default,,0,0,0,,Бәрі бақытты бола ала ма деп ойлаймын...
Dialogue: 0,1:45:48.71,1:45:50.21,Default,,0,0,0,,Қанша рет тырыссаңыз да
Dialogue: 0,1:45:52.59,1:45:53.97,Default,,0,0,0,,Келесі орын...
Dialogue: 0,1:45:54.22,1:45:55.68,Default,,0,0,0,,Неше рет?
Dialogue: 0,1:45:56.22,1:45:58.26,Default,,0,0,0,,Үшінші рет? Төртінші рет?
Dialogue: 0,1:45:58.68,1:46:02.31,Default,,0,0,0,,Барлығы күле алады ма?
Dialogue: 0,1:46:03.94,1:46:05.02,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,1:46:07.44,1:46:09.82,Default,,0,0,0,,Балаларың күледі
Dialogue: 0,1:46:10.32,1:46:11.61,Default,,0,0,0,,Адамдармен
Dialogue: 0,1:46:13.11,1:46:16.11,Default,,0,0,0,,Мазасызданып тұрмын... Шыдай алмаймын.
Dialogue: 0,1:46:16.53,1:46:17.49,Default,,0,0,0,,Жарайды
Dialogue: 0,1:46:18.28,1:46:21.20,Default,,0,0,0,,Бір күні бұл жай ғана дүкен болмайтынына сенімдімін...
Dialogue: 0,1:46:24.54,1:46:27.38,Default,,0,0,0,,Бүгін мені осылай ойландырған бір нәрсе болды.
Dialogue: 0,1:46:28.04,1:46:30.30,Default,,0,0,0,,Маған айта аласыз ба?
Dialogue: 0,1:46:30.75,1:46:33.05,Default,,0,0,0,,Басты кейіпкер – белгілі бір бала.
Dialogue: 0,1:46:33.72,1:46:35.93,Default,,0,0,0,,Сонымен бүгінгі әңгіме...
Dialogue: 0,1:46:37.43,1:46:43.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
