Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:19.64,0:00:20.27,Default,,0,0,0,,Талула
Dialogue: 0,0:00:21.64,0:00:23.64,Default,,0,0,0,,Барлық шаралар орындалды
Dialogue: 0,0:00:24.98,0:00:26.15,Default,,0,0,0,,Қозғалу уақыты келді ме?
Dialogue: 0,0:00:29.82,0:00:30.44,Default,,0,0,0,,Не?
Dialogue: 0,0:00:31.49,0:00:32.11,Default,,0,0,0,,Әрине
Dialogue: 0,0:00:32.78,0:00:34.15,Default,,0,0,0,,Айдаһар қақпасын алу
Dialogue: 0,0:00:34.95,0:00:36.82,Default,,0,0,0,,Реюньон үшін маңызды
Dialogue: 0,0:00:37.87,0:00:38.49,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:00:39.54,0:00:41.79,Default,,0,0,0,,Тәуекелдер мен шығындар тым үлкен
Dialogue: 0,0:00:43.21,0:00:45.29,Default,,0,0,0,,Рюмонға неге сонша құмарсың?
Dialogue: 0,0:00:47.79,0:00:48.88,Default,,0,0,0,,Тәжі өлтіруші
Dialogue: 0,0:00:51.05,0:00:51.80,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:00:52.17,0:00:53.63,Default,,0,0,0,,Сіз бұл ғимаратты көрдіңіз бе?
Dialogue: 0,0:00:56.30,0:00:58.05,Default,,0,0,0,,Бұл Рюмонның символы.
Dialogue: 0,0:01:00.01,0:01:01.60,Default,,0,0,0,,Мен осында қайтып келдім.
Dialogue: 0,0:01:02.85,0:01:06.19,Default,,0,0,0,,Қолымызда болуы керек нәрсені қайтарып алу
Dialogue: 0,0:01:07.19,0:01:08.15,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:01:08.86,0:01:11.23,Default,,0,0,0,,Оларға төлем жасау.
Dialogue: 0,0:01:12.48,0:01:13.53,Default,,0,0,0,,Бұл жақсырақ
Dialogue: 0,0:01:13.99,0:01:15.82,Default,,0,0,0,,Қызық деп ойламайсыз ба?
Dialogue: 0,0:01:17.57,0:01:18.57,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:01:19.32,0:01:20.70,Default,,0,0,0,,Талула
Dialogue: 0,0:02:56.80,0:02:57.96,Default,,0,0,0,,(Серо) «Өте жылдам адам» деген лақап ат тек сән үшін ғана емес қой?
Dialogue: 0,0:02:58.26,0:02:59.13,Default,,0,0,0,,Родос
Dialogue: 0,0:02:59.63,0:03:01.01,Default,,0,0,0,,Мұнда келе жатқанда
Dialogue: 0,0:03:01.30,0:03:04.43,Default,,0,0,0,,Реюньон бізге талай рет шабуыл жасады.
Dialogue: 0,0:03:05.01,0:03:06.22,Default,,0,0,0,,Ақтау жоқ
Dialogue: 0,0:03:06.39,0:03:07.64,Default,,0,0,0,,Бұл менің ниетім емес.
Dialogue: 0,0:03:09.27,0:03:11.10,Default,,0,0,0,,Реюниондардың айтарлықтай саны
Dialogue: 0,0:03:11.19,0:03:12.73,Default,,0,0,0,,Қашықтықты басып алу
Dialogue: 0,0:03:13.23,0:03:14.56,Default,,0,0,0,,Бұл да қауіпті
Dialogue: 0,0:03:14.82,0:03:16.98,Default,,0,0,0,,Мишаны алып, тез кетіңіз.
Dialogue: 0,0:03:20.07,0:03:21.24,Default,,0,0,0,,Сіз Мишасыз ба?
Dialogue: 0,0:03:22.36,0:03:23.07,Default,,0,0,0,,Иә
Dialogue: 0,0:03:23.16,0:03:25.33,Default,,0,0,0,,Күзет бюросы сізді бұдан былай қорғайды.
Dialogue: 0,0:03:26.58,0:03:27.49,Default,,0,0,0,,Көлікке отырыңыз.
Dialogue: 0,0:03:27.66,0:03:28.29,Default,,0,0,0,,Га
Dialogue: 0,0:03:30.04,0:03:30.91,Default,,0,0,0,,Келіңіз
Dialogue: 0,0:03:32.87,0:03:33.83,Default,,0,0,0,,Миша мырза
Dialogue: 0,0:03:34.84,0:03:36.17,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:03:44.09,0:03:45.05,Default,,0,0,0,,Чен мырза
Dialogue: 0,0:03:45.39,0:03:46.56,Default,,0,0,0,,Менің сенен бір жақсылығым бар.
Dialogue: 0,0:03:47.22,0:03:47.85,Default,,0,0,0,,Не?
Dialogue: 0,0:03:48.52,0:03:50.48,Default,,0,0,0,,Мишаның қауіпсіздігіне кепілдік беріңіз.
Dialogue: 0,0:03:50.81,0:03:53.94,Default,,0,0,0,,Тиісті емдеуді қамтамасыз етуге уәде беріңіз
Dialogue: 0,0:03:54.15,0:03:55.06,Default,,0,0,0,,Әрине.
Dialogue: 0,0:03:55.98,0:03:58.07,Default,,0,0,0,,Мишаның жағдайы ауыр.
Dialogue: 0,0:03:58.98,0:04:00.11,Default,,0,0,0,,Жағдай тынышталған кезде
Dialogue: 0,0:04:00.65,0:04:01.70,Default,,0,0,0,,Мишаға
Dialogue: 0,0:04:01.78,0:04:03.41,Default,,0,0,0,,Мен саған Родоста ем беремін.
Dialogue: 0,0:04:05.82,0:04:06.53,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:04:07.03,0:04:08.49,Default,,0,0,0,,Директор Вэйге айтыңыз
Dialogue: 0,0:04:09.16,0:04:12.83,Default,,0,0,0,,Бұл мәселе шешілгеннен кейін мен оны Родосқа тапсырамын.
Dialogue: 0,0:04:13.79,0:04:16.29,Default,,0,0,0,,Мәселелер болмаса.
Dialogue: 0,0:04:17.00,0:04:18.00,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:04:18.80,0:04:19.84,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:04:20.42,0:04:21.05,Default,,0,0,0,,О
Dialogue: 0,0:04:21.51,0:04:22.17,Default,,0,0,0,,Кеттік
Dialogue: 0,0:04:27.47,0:04:28.47,Default,,0,0,0,,Амия
Dialogue: 0,0:04:29.18,0:04:30.85,Default,,0,0,0,,Сәл қоштасу
Dialogue: 0,0:04:31.14,0:04:32.10,Default,,0,0,0,,Миша
Dialogue: 0,0:04:32.18,0:04:32.81,Default,,0,0,0,,Иә
Dialogue: 0,0:04:38.73,0:04:39.61,Default,,0,0,0,,Родос
Dialogue: 0,0:04:40.61,0:04:43.28,Default,,0,0,0,,Мен сені мәңгі күттім
Dialogue: 0,0:04:43.61,0:04:44.99,Default,,0,0,0,,Тағы кездескенше
Dialogue: 0,0:04:45.45,0:04:46.16,Default,,0,0,0,,Иә
Dialogue: 0,0:04:46.70,0:04:47.78,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:04:48.20,0:04:49.08,Default,,0,0,0,,Олай болса
Dialogue: 0,0:04:49.33,0:04:50.16,Default,,0,0,0,,Бұл
Dialogue: 0,0:04:50.54,0:04:51.83,Default,,0,0,0,,Келесі жолы мен үшін де
Dialogue: 0,0:04:51.91,0:04:54.62,Default,,0,0,0,,Қуыршақтарды сол балалар сияқты қалай жасауға болады
Dialogue: 0,0:04:54.96,0:04:56.25,Default,,0,0,0,,Маған хабарлаңыз.
Dialogue: 0,0:04:56.88,0:04:57.92,Default,,0,0,0,,Қуыршақ
Dialogue: 0,0:05:00.50,0:05:01.38,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:05:01.88,0:05:03.38,Default,,0,0,0,,Бірге жасайық
Dialogue: 0,0:05:13.06,0:05:13.85,Default,,0,0,0,,Амия
Dialogue: 0,0:05:16.23,0:05:17.02,Default,,0,0,0,,Қазір
Dialogue: 0,0:05:17.65,0:05:19.52,Default,,0,0,0,,Сенуден басқа амалың жоқ, солай ма?
Dialogue: 0,0:05:20.15,0:05:20.82,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:05:21.78,0:05:22.40,Default,,0,0,0,,О
Dialogue: 0,0:05:22.90,0:05:23.86,Default,,0,0,0,,Әзірге,
Dialogue: 0,0:05:24.07,0:05:25.53,Default,,0,0,0,,Миссия аяқталды.
Dialogue: 0,0:05:25.74,0:05:27.28,Default,,0,0,0,,Сол жын капитан
Dialogue: 0,0:05:27.36,0:05:30.28,Default,,0,0,0,,Сіз бізге ештеңе үйреткіңіз келмейтін сияқты.
Dialogue: 0,0:05:30.70,0:05:32.29,Default,,0,0,0,,Миша деген кім?
Dialogue: 0,0:05:32.58,0:05:34.04,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:05:34.54,0:05:35.96,Default,,0,0,0,,Біз де
Dialogue: 0,0:05:36.04,0:05:37.29,Default,,0,0,0,,Білу керек
Dialogue: 0,0:05:38.00,0:05:39.25,Default,,0,0,0,,Хуэй~
Dialogue: 0,0:05:39.38,0:05:41.46,Default,,0,0,0,,Бұрынғыдай қорқынышты.
Dialogue: 0,0:05:41.55,0:05:42.80,Default,,0,0,0,,Корольдік гвардиялық бюро
Dialogue: 0,0:05:43.05,0:05:45.47,Default,,0,0,0,,Мен тағы да кінәлі нәрсе істедім бе?
Dialogue: 0,0:05:45.55,0:05:46.68,Default,,0,0,0,,Періште
Dialogue: 0,0:05:46.97,0:05:48.34,Default,,0,0,0,,Бөлек~
Dialogue: 0,0:05:48.72,0:05:51.22,Default,,0,0,0,,Маған назар аударғым келмейді.
Dialogue: 0,0:05:51.47,0:05:52.26,Default,,0,0,0,,Амия
Dialogue: 0,0:05:52.56,0:05:53.81,Default,,0,0,0,,Басқа жұмыс бар ма?
Dialogue: 0,0:05:54.52,0:05:55.23,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:55.31,0:05:57.77,Default,,0,0,0,,Миша-сан аман-есен қаралды.
Dialogue: 0,0:05:57.89,0:05:59.02,Default,,0,0,0,,Әзірге
Dialogue: 0,0:05:59.31,0:05:59.98,Default,,0,0,0,,Егер
Dialogue: 0,0:06:00.11,0:06:01.65,Default,,0,0,0,,Әзірге шегініп алайық.
Dialogue: 0,0:06:01.73,0:06:02.86,Default,,0,0,0,,мен Токио вокзалына дейін шамамен бір жарым сағат Шинкансенге отырдым
Dialogue: 0,0:06:02.94,0:06:04.19,Default,,0,0,0,,Өте қызық!
Dialogue: 0,0:06:04.94,0:06:05.82,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:05.99,0:06:07.95,Default,,0,0,0,,Мен сені Родосқа жіберейін бе?
Dialogue: 0,0:06:08.20,0:06:09.57,Default,,0,0,0,,Сезімдеріңе қуаныштымын.
Dialogue: 0,0:06:09.82,0:06:11.78,Default,,0,0,0,,Penguin Express-тегі барлығына
Dialogue: 0,0:06:12.16,0:06:14.66,Default,,0,0,0,,Реюнионды зерттеуді жалғастырыңыз.
Dialogue: 0,0:06:14.87,0:06:17.29,Default,,0,0,0,,Бұл жерде проблема жоқ!
Dialogue: 0,0:06:17.37,0:06:19.00,Default,,0,0,0,,Оны бізге сеніммен қалдырыңыз!
Dialogue: 0,0:06:19.67,0:06:20.50,Default,,0,0,0,,Exia
Dialogue: 0,0:06:20.79,0:06:21.59,Default,,0,0,0,,Тез барайық
Dialogue: 0,0:06:21.71,0:06:22.46,Default,,0,0,0,,〜
Dialogue: 0,0:06:22.67,0:06:24.50,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:06:24.71,0:06:26.42,Default,,0,0,0,,Қандай да бір қозғалыс болса, дереу хабарлаңыз
Dialogue: 0,0:06:27.05,0:06:28.34,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:06:29.89,0:06:31.14,Default,,0,0,0,,Жақында кездескенше~
Dialogue: 0,0:06:29.09,0:06:29.80,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:06:32.85,0:06:33.76,Default,,0,0,0,,Біз де
Dialogue: 0,0:06:34.06,0:06:35.27,Default,,0,0,0,,Родосқа оралайық
Dialogue: 0,0:06:35.89,0:06:37.31,Default,,0,0,0,,Маршрут туралы не деуге болады?
Dialogue: 0,0:06:37.60,0:06:40.52,Default,,0,0,0,,Айналада көптеген кездесулер бар болса да
Dialogue: 0,0:06:40.65,0:06:41.48,Default,,0,0,0,,(Браффорд) Лорд Дио маған өмір сыйлады—
Dialogue: 0,0:06:41.86,0:06:43.77,Default,,0,0,0,,Егер олар бізден кейін келсе
Dialogue: 0,0:06:44.27,0:06:45.23,Default,,0,0,0,,Бұл ыңғайлы
Dialogue: 0,0:06:46.74,0:06:48.90,Default,,0,0,0,,Сіз бізді сонда апарып жатырсыз.
Dialogue: 0,0:06:49.40,0:06:50.11,Default,,0,0,0,,Иә
Dialogue: 0,0:06:50.49,0:06:53.12,Default,,0,0,0,,Біз сондай-ақ қараңғы аудандарда шашылған операторларды жинаймыз.
Dialogue: 0,0:06:54.08,0:06:55.74,Default,,0,0,0,,Мишаның қауіпсіздігі үшін
Dialogue: 0,0:06:56.04,0:06:57.79,Default,,0,0,0,,Қолымыздан келгенін істейік
Dialogue: 0,0:07:12.76,0:07:13.43,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:07:14.05,0:07:15.85,Default,,0,0,0,,Сіз мені іздедіңіз бе?
Dialogue: 0,0:07:18.02,0:07:19.52,Default,,0,0,0,,Өйткені сіз жұқтырған адамсыз
Dialogue: 0,0:07:19.77,0:07:20.81,Default,,0,0,0,,Бұл?
Dialogue: 0,0:07:21.85,0:07:22.98,Default,,0,0,0,,Адамзат пен Титан арасындағы күш теңсіздігі соншалықты үлкен еді
Dialogue: 0,0:07:23.06,0:07:24.19,Default,,0,0,0,,Қуғындалу
Dialogue: 0,0:07:25.11,0:07:26.82,Default,,0,0,0,,Бұлай істегенім есімде жоқ.
Dialogue: 0,0:07:30.07,0:07:31.11,Default,,0,0,0,,Сізден гөрі
Dialogue: 0,0:07:32.03,0:07:33.57,Default,,0,0,0,,Мәселе әкеңде.
Dialogue: 0,0:07:34.49,0:07:35.24,Default,,0,0,0,,Ž...?
Dialogue: 0,0:07:35.58,0:07:36.62,Default,,0,0,0,,Сенің әкең
Dialogue: 0,0:07:37.49,0:07:39.83,Default,,0,0,0,,Чернобогтағы атақты ғалым.
Dialogue: 0,0:07:40.04,0:07:41.83,Default,,0,0,0,,Сен, оның қызы
Dialogue: 0,0:07:42.42,0:07:44.29,Default,,0,0,0,,Реюнионды өткізуге болады.
Dialogue: 0,0:07:45.17,0:07:47.30,Default,,0,0,0,,Олардың мақсаты әлі түсініксіз.
Dialogue: 0,0:07:47.84,0:07:48.71,Default,,0,0,0,,Біз
Dialogue: 0,0:07:48.96,0:07:52.43,Default,,0,0,0,,Реюньонның қолына түсіп қалмау үшін қажет болды.
Dialogue: 0,0:07:54.59,0:07:55.85,Default,,0,0,0,,Әзірше осы.
Dialogue: 0,0:07:56.76,0:07:59.14,Default,,0,0,0,,Бостандыққа шығуыңыз екіталай.
Dialogue: 0,0:08:01.89,0:08:03.40,Default,,0,0,0,,Айдаһар әпкесі
Dialogue: 0,0:08:04.90,0:08:06.40,Default,,0,0,0,,Бұл сіз туралы, солай ма?
Dialogue: 0,0:08:07.11,0:08:08.11,Default,,0,0,0,,Чен мырза
Dialogue: 0,0:08:08.65,0:08:11.15,Default,,0,0,0,,Қашықтықтың балалары әңгімелесіп отырды.
Dialogue: 0,0:08:11.86,0:08:12.90,Default,,0,0,0,,Әрқашан пайдалы
Dialogue: 0,0:08:12.99,0:08:15.91,Default,,0,0,0,,«Айдаһардың әпкесі» бар
Dialogue: 0,0:08:17.74,0:08:19.45,Default,,0,0,0,,Бұдан былай жалғастырыңыз.
Dialogue: 0,0:08:20.04,0:08:21.45,Default,,0,0,0,,Сол балалар туралы
Dialogue: 0,0:08:22.83,0:08:23.87,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:08:28.88,0:08:29.92,Default,,0,0,0,,Рюмон
Dialogue: 0,0:08:30.38,0:08:31.72,Default,,0,0,0,,Ауру жұқтырғандар да, шалғайдағылар да
Dialogue: 0,0:08:32.67,0:08:34.09,Default,,0,0,0,,Азамат болып есептелмейді
Dialogue: 0,0:08:36.14,0:08:36.85,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:08:37.64,0:08:38.68,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:08:39.22,0:08:40.97,Default,,0,0,0,,Тек мен істеу керек нәрсені істе
Dialogue: 0,0:08:43.56,0:08:44.77,Default,,0,0,0,,Чен мырза
Dialogue: 0,0:08:49.32,0:08:49.94,Default,,0,0,0,,Жау шабуылы!
Dialogue: 0,0:08:56.03,0:08:56.82,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:09:01.70,0:09:02.87,Default,,0,0,0,,Хехехе
Dialogue: 0,0:09:03.75,0:09:04.54,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:09:04.75,0:09:06.50,Default,,0,0,0,,Шақырып ашайық!
Dialogue: 0,0:09:08.92,0:09:10.00,Default,,0,0,0,,Шынында да
Dialogue: 0,0:09:10.55,0:09:11.50,Default,,0,0,0,,Мәңгі
Dialogue: 0,0:09:11.59,0:09:12.71,Default,,0,0,0,,Сіз табандысыз.
Dialogue: 0,0:09:18.14,0:09:19.05,Default,,0,0,0,,Франка!
Dialogue: 0,0:09:22.52,0:09:24.43,Default,,0,0,0,,Олар сонша санды қалай ойлап тапты?
Dialogue: 0,0:09:38.99,0:09:39.78,Default,,0,0,0,,Родос
Dialogue: 0,0:09:41.37,0:09:42.66,Default,,0,0,0,,Сол жігіт
Dialogue: 0,0:09:42.79,0:09:43.91,Default,,0,0,0,,Сіз мұны қай жерде жасадыңыз?
Dialogue: 0,0:09:46.33,0:09:47.42,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:09:49.50,0:09:50.63,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:09:50.84,0:09:52.63,Default,,0,0,0,,Сен оны Рюмонға тапсырдың ба?
Dialogue: 0,0:09:53.42,0:09:54.71,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:09:55.22,0:09:57.05,Default,,0,0,0,,Мұның не қатысы бар
Dialogue: 0,0:09:58.26,0:09:59.72,Default,,0,0,0,,Сіз!
Dialogue: 0,0:09:59.89,0:10:01.51,Default,,0,0,0,,Жұқтырған адам болған кезде
Dialogue: 0,0:10:01.60,0:10:03.18,Default,,0,0,0,,Рюмонға қол ұшын беру!
Dialogue: 0,0:10:03.56,0:10:06.68,Default,,0,0,0,,Сендердің істеп жүргендерің жұқтырғанға опасыздық!
Dialogue: 0,0:10:07.73,0:10:09.23,Default,,0,0,0,,Родос көшбасшысы!
Dialogue: 0,0:10:09.56,0:10:10.90,Default,,0,0,0,,Бауырларымның өмірі
Dialogue: 0,0:10:11.06,0:10:13.02,Default,,0,0,0,,Мен сенің қаныңмен өтемін!
Dialogue: 0,0:10:14.69,0:10:15.82,Default,,0,0,0,,Кездесу
Dialogue: 0,0:10:17.61,0:10:18.49,Default,,0,0,0,,бірінші
Dialogue: 0,0:10:19.20,0:10:20.41,Default,,0,0,0,,Кімге кек сақтады
Dialogue: 0,0:10:22.49,0:10:24.66,Default,,0,0,0,,Біреуді бірінші ренжіткен кім?
Dialogue: 0,0:10:26.08,0:10:28.16,Default,,0,0,0,,Зорлық-зомбылықты бірінші жасаған кім?
Dialogue: 0,0:10:29.67,0:10:31.96,Default,,0,0,0,,Чернобогтағы жігіттер!
Dialogue: 0,0:10:32.38,0:10:33.38,Default,,0,0,0,,Кеттік
Dialogue: 0,0:10:33.46,0:10:34.63,Default,,0,0,0,,Бауырлар!
Dialogue: 0,0:10:36.26,0:10:36.92,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:10:37.42,0:10:38.63,Default,,0,0,0,,Маған бұйрық беріңізші!
Dialogue: 0,0:10:59.65,0:11:01.49,Default,,0,0,0,,Менің қасымнан кетпе
Dialogue: 0,0:11:05.33,0:11:08.04,Default,,0,0,0,,Бұл ханшайымды қорғаған рыцарь сияқты.
Dialogue: 0,0:11:08.33,0:11:09.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:11:09.79,0:11:12.08,Default,,0,0,0,,Мен сенімен өте баяу ойнай алмаймын.
Dialogue: 0,0:11:15.38,0:11:16.17,Default,,0,0,0,,Жүгірейік!
Dialogue: 0,0:11:29.10,0:11:29.77,Default,,0,0,0,,Эй
Dialogue: 0,0:11:29.89,0:11:30.56,Default,,0,0,0,,Миша!
Dialogue: 0,0:11:30.77,0:11:31.69,Default,,0,0,0,,Не болды!
Dialogue: 0,0:11:32.06,0:11:32.73,Default,,0,0,0,,Нет... не істеп жатырсың...
Dialogue: 0,0:11:34.36,0:11:35.02,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:11:46.24,0:11:46.87,Default,,0,0,0,,Цк
Dialogue: 0,0:11:53.00,0:11:53.88,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:11:54.46,0:11:55.34,Default,,0,0,0,,Олай болса
Dialogue: 0,0:11:55.88,0:11:58.21,Default,,0,0,0,,Оны ханшайым алады.
Dialogue: 0,0:11:59.34,0:12:00.09,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:12:10.73,0:12:12.69,Default,,0,0,0,,Арнайы тексеру тобына не болды?
Dialogue: 0,0:12:12.94,0:12:13.60,Default,,0,0,0,,Ha
Dialogue: 0,0:12:13.81,0:12:16.06,Default,,0,0,0,,Мен сені Реюньонда тұрып қалды деп естідім!
Dialogue: 0,0:12:16.40,0:12:17.44,Default,,0,0,0,,Бұл басты күш!
Dialogue: 0,0:12:17.90,0:12:18.86,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:12:19.15,0:12:19.86,Default,,0,0,0,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:12:20.53,0:12:21.24,Default,,0,0,0,,Екінші тарап
Dialogue: 0,0:12:21.74,0:12:22.65,Default,,0,0,0,,Бір ғана адам болды
Dialogue: 0,0:12:26.99,0:12:27.87,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:12:37.75,0:12:39.05,Default,,0,0,0,,Мен сені атуға рұқсат бермеймін.
Dialogue: 0,0:12:39.13,0:12:39.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:41.26,0:12:42.13,Default,,0,0,0,,Бас сүйек ұсақтағыш!
Dialogue: 0,0:12:42.84,0:12:43.93,Default,,0,0,0,,Бұл өте талғамсыз екен.
Dialogue: 0,0:12:44.38,0:12:45.84,Default,,0,0,0,,Әрине күшті
Dialogue: 0,0:12:47.64,0:12:49.06,Default,,0,0,0,,Мен В-дан хабарлама алдым.
Dialogue: 0,0:12:50.01,0:12:51.60,Default,,0,0,0,,Операция сәтті болған сияқты.
Dialogue: 0,0:12:54.64,0:12:56.40,Default,,0,0,0,,Таллулаға белгі жіберіңіз
Dialogue: 0,0:13:04.45,0:13:06.41,Default,,0,0,0,,Үлкен соққыға қарамастан,
Dialogue: 0,0:13:06.49,0:13:07.95,Default,,0,0,0,,Сіз тез қашып бара жатырсыз, солай емес пе?
Dialogue: 0,0:13:09.49,0:13:10.29,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:13:10.37,0:13:11.08,Default,,0,0,0,,Қоян-чан
Dialogue: 0,0:13:11.83,0:13:13.50,Default,,0,0,0,,Бірдеңе дұрыс емес
Dialogue: 0,0:13:14.00,0:13:15.25,Default,,0,0,0,,Соншалықты
Dialogue: 0,0:13:15.33,0:13:16.75,Default,,0,0,0,,Қалайша оңай шегінуге болады?
Dialogue: 0,0:13:20.04,0:13:21.00,Default,,0,0,0,,Яғни
Dialogue: 0,0:13:25.09,0:13:26.76,Default,,0,0,0,,Кездесудің мақсаты
Dialogue: 0,0:13:27.26,0:13:28.39,Default,,0,0,0,,Родос емес
Dialogue: 0,0:13:31.14,0:13:32.22,Default,,0,0,0,,Миша
Dialogue: 0,0:14:01.34,0:14:02.05,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:14:09.72,0:14:10.64,Default,,0,0,0,,Чен мырза
Dialogue: 0,0:14:11.55,0:14:13.06,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:13.85,0:14:15.02,Default,,0,0,0,,Миша мырза
Dialogue: 0,0:14:16.48,0:14:17.44,Default,,0,0,0,,Ұрланған
Dialogue: 0,0:14:17.98,0:14:19.06,Default,,0,0,0,,Кездесуге
Dialogue: 0,0:14:19.65,0:14:20.52,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:14:20.61,0:14:22.23,Default,,0,0,0,,Бұл оның бір шығармада жақсы болғанын білдіре ме?
Dialogue: 0,0:14:23.07,0:14:23.78,Default,,0,0,0,,Мінез-құлқы: Талғампаз
Dialogue: 0,0:14:23.86,0:14:24.94,Default,,0,0,0,,Бардың ба?
Dialogue: 0,0:14:26.99,0:14:29.20,Default,,0,0,0,,Ғимараттың артында бірден жоғалып кетті
Dialogue: 0,0:14:29.82,0:14:32.12,Default,,0,0,0,,Егжей-тегжейлі бағыт әлі белгісіз.
Dialogue: 0,0:14:33.33,0:14:34.33,Default,,0,0,0,,Миша мырза
Dialogue: 0,0:14:35.12,0:14:35.83,Default,,0,0,0,,Барлығы
Dialogue: 0,0:14:37.25,0:14:38.58,Default,,0,0,0,,Бұл менің жауапкершілігім
Dialogue: 0,0:14:40.58,0:14:41.54,Default,,0,0,0,,Амия
Dialogue: 0,0:14:43.00,0:14:43.92,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:44.00,0:14:44.84,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:14:45.09,0:14:47.22,Default,,0,0,0,,Әлі уақыт бар.
Dialogue: 0,0:14:50.30,0:14:51.18,Default,,0,0,0,,Чен мырза
Dialogue: 0,0:14:51.97,0:14:54.22,Default,,0,0,0,,Мишаны не үшін қуып жатыр?
Dialogue: 0,0:14:55.60,0:14:57.43,Default,,0,0,0,,Оны оқытуға міндетті емес
Dialogue: 0,0:14:57.60,0:14:58.31,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:59.19,0:15:00.27,Default,,0,0,0,,Шарт
Dialogue: 0,0:15:00.35,0:15:03.31,Default,,0,0,0,,Родос императорлық гвардиялық бюроға бағынуы керек.
Dialogue: 0,0:15:03.98,0:15:06.15,Default,,0,0,0,,Бір-бірімізге сене алмасақ
Dialogue: 0,0:15:06.40,0:15:08.32,Default,,0,0,0,,Бірлескен операциялар жұмыс істемейді
Dialogue: 0,0:15:09.11,0:15:10.86,Default,,0,0,0,,Айдаһар қақпасын қорғау үшін
Dialogue: 0,0:15:11.11,0:15:13.87,Default,,0,0,0,,Родос императорлық гвардиялық бюромен бірге соғысуға шешім қабылдады.
Dialogue: 0,0:15:14.62,0:15:15.95,Default,,0,0,0,,Дегенмен Рюмон
Dialogue: 0,0:15:16.04,0:15:18.58,Default,,0,0,0,,Родосқа ешқандай ақпарат бермеңіз
Dialogue: 0,0:15:19.37,0:15:21.54,Default,,0,0,0,,Сіздің жауыңыз Родос емес.
Dialogue: 0,0:15:22.25,0:15:23.29,Default,,0,0,0,,Кездесу
Dialogue: 0,0:15:27.30,0:15:28.55,Default,,0,0,0,,Сол мәлімдеме
Dialogue: 0,0:15:29.42,0:15:30.88,Default,,0,0,0,,Сол дәрігерге ұқсайды
Dialogue: 0,0:15:33.14,0:15:33.76,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:15:34.76,0:15:37.93,Default,,0,0,0,,Олар қазір келісім-шартты бұзса, мен қиналмас едім.
Dialogue: 0,0:15:40.31,0:15:41.39,Default,,0,0,0,,Орынды жылжытайық
Dialogue: 0,0:15:44.19,0:15:44.81,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:15:45.52,0:15:47.28,Default,,0,0,0,,Мишаның әкесі
Dialogue: 0,0:15:47.53,0:15:48.32,Default,,0,0,0,,Бұл?
Dialogue: 0,0:15:48.78,0:15:49.40,Default,,0,0,0,,О
Dialogue: 0,0:15:50.11,0:15:52.45,Default,,0,0,0,,Чернобогтағы басты тұлға болып шықты.
Dialogue: 0,0:15:52.95,0:15:54.03,Default,,0,0,0,,VIP?
Dialogue: 0,0:15:54.41,0:15:55.99,Default,,0,0,0,,Атақты ғалым
Dialogue: 0,0:15:56.28,0:15:58.79,Default,,0,0,0,,Ол саяси маңызды тұлға сияқты.
Dialogue: 0,0:15:59.04,0:16:02.29,Default,,0,0,0,,Ол үлкен адамның баласы болғандықтан, ол сені қуып жүр дегенді білдіре ме?
Dialogue: 0,0:16:02.75,0:16:03.96,Default,,0,0,0,,Мишаның өзі
Dialogue: 0,0:16:04.21,0:16:06.09,Default,,0,0,0,,Чернобог туралы мәлімет
Dialogue: 0,0:16:06.46,0:16:07.80,Default,,0,0,0,,...
Dialogue: 0,0:16:08.63,0:16:10.17,Default,,0,0,0,,...
Dialogue: 0,0:16:10.67,0:16:12.84,Default,,0,0,0,,Біз оны қорғауға тырыстық.
Dialogue: 0,0:16:13.68,0:16:14.72,Default,,0,0,0,,Оның өзі
Dialogue: 0,0:16:15.09,0:16:17.47,Default,,0,0,0,,Сізде қандай ақпарат бар екені белгісіз.
Dialogue: 0,0:16:18.35,0:16:19.39,Default,,0,0,0,,Ол 0 болуы мүмкін
Dialogue: 0,0:16:20.06,0:16:21.23,Default,,0,0,0,,100
Dialogue: 0,0:16:22.19,0:16:22.85,Default,,0,0,0,,Бірақ
Dialogue: 0,0:16:23.64,0:16:26.06,Default,,0,0,0,,Олар Рюмонды келесі нысанаға айналдырды.
Dialogue: 0,0:16:26.56,0:16:28.98,Default,,0,0,0,,Осыдан кейін ол Мишаны алып кетуге көшті.
Dialogue: 0,0:16:29.65,0:16:31.61,Default,,0,0,0,,...
Dialogue: 0,0:16:32.28,0:16:34.11,Default,,0,0,0,,Оларға ештеңе берме.
Dialogue: 0,0:16:35.57,0:16:37.12,Default,,0,0,0,,40 000! Хех, хех, хехехехе
Dialogue: 0,0:16:38.12,0:16:39.37,Default,,0,0,0,,Әзірге осымен бітті.
Dialogue: 0,0:16:41.16,0:16:41.95,Default,,0,0,0,,Мінез-құлқы: Талғампаз
Dialogue: 0,0:16:42.37,0:16:43.58,Default,,0,0,0,,...
Dialogue: 0,0:16:44.08,0:16:45.42,Default,,0,0,0,,Біз де барамыз
Dialogue: 0,0:16:46.08,0:16:47.59,Default,,0,0,0,,...
Dialogue: 0,0:16:48.67,0:16:49.55,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:16:50.55,0:16:52.55,Default,,0,0,0,,Оны Реюньон алып кетті.
Dialogue: 0,0:16:53.05,0:16:54.26,Default,,0,0,0,,...
Dialogue: 0,0:16:55.30,0:16:56.30,Default,,0,0,0,,Чен мырза
Dialogue: 0,0:16:57.30,0:16:58.55,Default,,0,0,0,,Демон капитаны деген не?
Dialogue: 0,0:16:58.64,0:17:00.89,Default,,0,0,0,,...
Dialogue: 0,0:17:01.35,0:17:03.68,Default,,0,0,0,,Мен тек өз міндеттерімді орындаймын.
Dialogue: 0,0:17:04.10,0:17:05.27,Default,,0,0,0,,Міне.
Dialogue: 0,0:17:05.39,0:17:07.27,Default,,0,0,0,,Бұл тамаша, бірақ
Dialogue: 0,0:17:07.94,0:17:09.57,Default,,0,0,0,,...
Dialogue: 0,0:17:09.86,0:17:11.82,Default,,0,0,0,,Родос та осындай жауапкершілікке ие
Dialogue: 0,0:17:12.65,0:17:14.45,Default,,0,0,0,,...
Dialogue: 0,0:17:18.03,0:17:19.12,Default,,0,0,0,,Енді осында
Dialogue: 0,0:17:19.66,0:17:22.16,Default,,0,0,0,,Реюнион әскерлері жинала бастады.
Dialogue: 0,0:17:23.08,0:17:24.04,Default,,0,0,0,,...
Dialogue: 0,0:17:24.87,0:17:26.42,Default,,0,0,0,,...
Dialogue: 0,0:17:27.08,0:17:29.04,Default,,0,0,0,,...
Dialogue: 0,0:17:30.21,0:17:31.05,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:17:31.75,0:17:32.38,Default,,0,0,0,,Кеттік
Dialogue: 0,0:17:33.76,0:17:35.01,Default,,0,0,0,,...
Dialogue: 0,0:17:42.60,0:17:43.72,Default,,0,0,0,,Қабырғаны адам қолымен әрі қарай ластайық дейсің бе?
Dialogue: 0,0:17:47.44,0:17:48.73,Default,,0,0,0,,Өл!
Dialogue: 0,0:17:50.90,0:17:51.73,Default,,0,0,0,,Жалғастырыңыз!
Dialogue: 0,0:17:53.15,0:17:55.74,Default,,0,0,0,,Корольдік гвардиялық бюроның күшін еске түсірейік!
Dialogue: 0,0:17:56.49,0:17:57.95,Default,,0,0,0,,Алға!
Dialogue: 0,0:18:01.70,0:18:03.12,Default,,0,0,0,,...
Dialogue: 0,0:18:03.95,0:18:05.16,Default,,0,0,0,,...
Dialogue: 0,0:18:05.79,0:18:06.66,Default,,0,0,0,,Пинсер шабуылы
Dialogue: 0,0:18:10.54,0:18:11.25,Default,,0,0,0,,Капитан!
Dialogue: 0,0:18:11.50,0:18:13.05,Default,,0,0,0,,!
Dialogue: 0,0:18:13.42,0:18:15.26,Default,,0,0,0,,Көмегіңе рахмет!
Dialogue: 0,0:18:15.51,0:18:18.80,Default,,0,0,0,,Рюмонда сіздің тәртіпсіздіктеріңізге жол берілмейді деп ойлаймын!
Dialogue: 0,0:18:19.30,0:18:20.34,Default,,0,0,0,,Уау
Dialogue: 0,0:18:20.76,0:18:22.93,Default,,0,0,0,,...
Dialogue: 0,0:18:23.18,0:18:24.47,Default,,0,0,0,,Керемет рух
Dialogue: 0,0:18:29.85,0:18:31.52,Default,,0,0,0,,...
Dialogue: 0,0:18:31.61,0:18:33.40,Default,,0,0,0,,...
Dialogue: 0,0:18:37.11,0:18:37.82,Default,,0,0,0,,Чен мырза
Dialogue: 0,0:18:43.28,0:18:44.33,Default,,0,0,0,,Сіз келдіңіз бе?
Dialogue: 0,0:18:45.29,0:18:46.04,Default,,0,0,0,,Хосигма
Dialogue: 0,0:18:47.37,0:18:48.04,Default,,0,0,0,,Ha
Dialogue: 0,0:18:48.41,0:18:50.54,Default,,0,0,0,,Кешігу үшін кешірім сұраймыз.
Dialogue: 0,0:18:51.04,0:18:51.96,Default,,0,0,0,,Кешіктіру
Dialogue: 0,0:18:52.42,0:18:53.25,Default,,0,0,0,,Оны қайтарыңыз
Dialogue: 0,0:18:53.59,0:18:54.21,Default,,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 0,0:19:00.51,0:19:02.35,Default,,0,0,0,,Мен бәрін бірден бүктеймін!
Dialogue: 0,0:19:09.39,0:19:10.14,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:19:10.77,0:19:11.52,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:19:13.36,0:19:15.65,Default,,0,0,0,,Рюмон күзет бюросы
Dialogue: 0,0:19:35.04,0:19:36.30,Default,,0,0,0,,...
Dialogue: 0,0:19:37.25,0:19:39.51,Default,,0,0,0,,...
Dialogue: 0,0:19:40.80,0:19:42.18,Default,,0,0,0,,Екі қолда да даңқ; жеңіс – біздің әніміз
Dialogue: 0,0:19:42.80,0:19:45.81,Default,,0,0,0,,Жаудың ерекше күшімен қорғаныста болдық.
Dialogue: 0,0:19:46.81,0:19:49.60,Default,,0,0,0,,Жаудың жүрегі жоқ сияқты.
Dialogue: 0,0:19:50.31,0:19:53.23,Default,,0,0,0,,Олар бізді ойламаған сияқты.
Dialogue: 0,0:19:54.56,0:19:55.27,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:55.94,0:19:56.82,Default,,0,0,0,,Чен мырза
Dialogue: 0,0:19:58.07,0:19:58.98,Default,,0,0,0,,Бұл адам ше?
Dialogue: 0,0:19:59.99,0:20:01.90,Default,,0,0,0,,Арнайы инспекция бөлімінің хосигмасы
Dialogue: 0,0:20:02.70,0:20:04.07,Default,,0,0,0,,Ол Корольдік гвардия бюросының эйсі.
Dialogue: 0,0:20:04.28,0:20:04.99,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:20:05.16,0:20:06.20,Default,,0,0,0,,Ескерту
Dialogue: 0,0:20:07.16,0:20:08.58,Default,,0,0,0,,Бұл Амия
Dialogue: 0,0:20:08.87,0:20:09.95,Default,,0,0,0,,Ол Родостың басшысы.
Dialogue: 0,0:20:10.16,0:20:10.91,Default,,0,0,0,,Қалай
Dialogue: 0,0:20:11.29,0:20:12.58,Default,,0,0,0,,Сіз көшбасшысыз ба?
Dialogue: 0,0:20:13.71,0:20:15.50,Default,,0,0,0,,Бұрынғы көмегіңіз үшін рахмет.
Dialogue: 0,0:20:16.96,0:20:18.30,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:20:18.59,0:20:19.21,Default,,0,0,0,,Не?
Dialogue: 0,0:20:19.92,0:20:20.72,Default,,0,0,0,,Aie
Dialogue: 0,0:20:20.92,0:20:23.13,Default,,0,0,0,,Мен жай ғана табиғи нәрсені жасадым.
Dialogue: 0,0:20:23.47,0:20:24.09,Default,,0,0,0,,Эй
Dialogue: 0,0:20:24.93,0:20:27.26,Default,,0,0,0,,...
Dialogue: 0,0:20:27.39,0:20:29.35,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,0:20:29.43,0:20:31.64,Default,,0,0,0,,...
Dialogue: 0,0:20:32.23,0:20:33.31,Default,,0,0,0,,Иә!?
Dialogue: 0,0:20:33.60,0:20:35.27,Default,,0,0,0,,Бұл ақылға сыймайтын нәрсе емес пе?
Dialogue: 0,0:20:36.27,0:20:37.27,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:20:37.65,0:20:39.69,Default,,0,0,0,,...
Dialogue: 0,0:20:40.03,0:20:42.90,Default,,0,0,0,,...
Dialogue: 0,0:20:43.24,0:20:44.11,Default,,0,0,0,,Чен мырза
Dialogue: 0,0:20:44.99,0:20:45.91,Default,,0,0,0,,Барлық оқтарыңды жауға беріңдер!!
Dialogue: 0,0:20:46.32,0:20:49.33,Default,,0,0,0,,...
Dialogue: 0,0:20:50.45,0:20:51.33,Default,,0,0,0,,Егер олар
Dialogue: 0,0:20:51.83,0:20:54.00,Default,,0,0,0,,...
Dialogue: 0,0:20:54.58,0:20:55.83,Default,,0,0,0,,Мұнда басыңыз
Dialogue: 0,0:20:56.08,0:20:58.00,Default,,0,0,0,,Реюньондағы қараңғы аудандардың айналасында.
Dialogue: 0,0:20:58.17,0:21:01.13,Default,,0,0,0,,Мен Мишаны іздеп жүрмін және оның хабарласуын күтемін.
Dialogue: 0,0:21:01.71,0:21:02.97,Default,,0,0,0,,Осыдан кейін
Dialogue: 0,0:21:03.17,0:21:05.43,Default,,0,0,0,,Біз Родоспен және Императорлық гвардия бюросымен ынтымақтасамыз.
Dialogue: 0,0:21:05.51,0:21:07.05,Default,,0,0,0,,Мишаны іздеу
Dialogue: 0,0:21:07.76,0:21:08.97,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:21:12.35,0:21:14.19,Default,,0,0,0,,Родос басшысы күткендей
Dialogue: 0,0:21:15.19,0:21:17.23,Default,,0,0,0,,Сіздің орындаушылық қабілетіңіз зор.
Dialogue: 0,0:21:19.06,0:21:21.69,Default,,0,0,0,,Капитан бағалаған дүниелер бар.
Dialogue: 0,0:21:21.82,0:21:22.36,Default,,0,0,0,,На
Dialogue: 0,0:21:22.82,0:21:23.49,Default,,0,0,0,,Ала~
Dialogue: 0,0:21:23.57,0:21:24.20,Default,,0,0,0,,Эй
Dialogue: 0,0:21:24.28,0:21:25.07,Default,,0,0,0,,Ой
Dialogue: 0,0:21:25.15,0:21:26.82,Default,,0,0,0,,Аузыңыз сырғып кетті ме?
Dialogue: 0,0:21:28.16,0:21:29.53,Default,,0,0,0,,Чен мырза
Dialogue: 0,0:21:31.99,0:21:33.12,Default,,0,0,0,,Тезірек барайық.
Dialogue: 0,0:21:35.62,0:21:38.63,Default,,0,0,0,,Сізде бір сүйкімділік бар, капитан.
Dialogue: 0,0:21:38.83,0:21:40.38,Default,,0,0,0,,Оны қалдырыңыз.
Dialogue: 0,0:21:43.09,0:21:43.92,Default,,0,0,0,,Миша
Dialogue: 0,0:21:46.63,0:21:47.43,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:21:49.64,0:21:50.47,Default,,0,0,0,,Амия
Dialogue: 0,0:21:51.81,0:21:52.85,Default,,0,0,0,,Оны қайтарайық
Dialogue: 0,0:21:53.97,0:21:54.81,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:21:57.69,0:21:58.31,Default,,0,0,0,,Иә
Dialogue: 0,0:21:59.52,0:22:00.61,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:22:03.23,0:22:04.32,Default,,0,0,0,,Миша мырза
Dialogue: 0,0:22:05.82,0:22:11.82,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory