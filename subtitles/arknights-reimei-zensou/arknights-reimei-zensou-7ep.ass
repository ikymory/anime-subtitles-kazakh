Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.83,0:00:02.21,Default,,0,0,0,,Эй
Dialogue: 0,0:00:02.92,0:00:03.46,Default,,0,0,0,,Миша
Dialogue: 0,0:00:03.67,0:00:04.37,Default,,0,0,0,,Оңтүстік аймақтардың бас қолбасшысы Доти Пиксис
Dialogue: 0,0:00:06.21,0:00:07.09,Default,,0,0,0,,Родос
Dialogue: 0,0:00:07.42,0:00:10.09,Default,,0,0,0,,Мен сені мәңгі күттім.
Dialogue: 0,0:00:10.30,0:00:11.13,Default,,0,0,0,,Миша
Dialogue: 0,0:00:12.05,0:00:12.80,Default,,0,0,0,,Сол екі клонды бір-бірімен шайқастырып отыр—
Dialogue: 0,0:00:14.64,0:00:15.39,Default,,0,0,0,,Миша
Dialogue: 0,0:00:39.54,0:00:40.33,Default,,0,0,0,,Жақсы
Dialogue: 0,0:00:40.54,0:00:41.37,Default,,0,0,0,,байқадым
Dialogue: 0,0:00:42.87,0:00:43.83,Default,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:00:44.00,0:00:44.54,Default,,0,0,0,,Миша
Dialogue: 0,0:00:46.46,0:00:47.33,Default,,0,0,0,,Бас сүйек ұсақтағыштан
Dialogue: 0,0:00:47.42,0:00:48.92,Default,,0,0,0,,Мен сізді тыңдаймын.
Dialogue: 0,0:00:50.46,0:00:51.71,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:00:55.47,0:00:56.13,Default,,0,0,0,,Иван
Dialogue: 0,0:00:56.34,0:00:57.26,Default,,0,0,0,,Патруль сұраңыз
Dialogue: 0,0:00:57.76,0:00:58.43,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:00:59.39,0:01:00.51,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:01:05.94,0:01:07.31,Default,,0,0,0,,Ұстама басылған сияқты.
Dialogue: 0,0:01:09.86,0:01:10.61,Default,,0,0,0,,Сен
Dialogue: 0,0:01:24.66,0:01:25.33,Default,,0,0,0,,Тікелей эфир
Dialogue: 0,0:01:25.66,0:01:26.92,Default,,0,0,0,,Келесі сұрақ: неге мені мейрамханадан бастап осы жерге дейін қуғансың?
Dialogue: 0,0:01:27.46,0:01:28.38,Default,,0,0,0,,Алекс
Dialogue: 0,0:01:28.46,0:01:29.08,Default,,0,0,0,,Жоқ
Dialogue: 0,0:01:30.04,0:01:31.96,Default,,0,0,0,,Бұл есімді адам әлдеқашан өлген.
Dialogue: 0,0:01:33.34,0:01:34.42,Default,,0,0,0,,Менің атым қазір
Dialogue: 0,0:01:35.42,0:01:36.38,Default,,0,0,0,,Бас сүйек ұсақтағыш
Dialogue: 0,0:03:11.10,0:03:11.81,Default,,0,0,0,,Хосигма
Dialogue: 0,0:03:13.36,0:03:13.98,Default,,0,0,0,,Келесі.
Dialogue: 0,0:03:15.90,0:03:16.73,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:03:16.98,0:03:19.44,Default,,0,0,0,,Олар қайдан шыққан?
Dialogue: 0,0:03:20.07,0:03:20.74,Default,,0,0,0,,Амия-сан
Dialogue: 0,0:03:21.28,0:03:23.32,Default,,0,0,0,,Бұл кездесу де басқаша болған сияқты.
Dialogue: 0,0:03:23.45,0:03:24.32,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:03:24.78,0:03:26.62,Default,,0,0,0,,Іздеу аясын одан әрі кеңейтейік.
Dialogue: 0,0:03:27.24,0:03:28.25,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:03:31.42,0:03:32.12,Default,,0,0,0,,Миша
Dialogue: 0,0:03:39.42,0:03:40.22,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:03:41.17,0:03:41.84,Default,,0,0,0,,Арнайы дайындық
Dialogue: 0,0:03:42.47,0:03:43.34,Default,,0,0,0,,Келгеніңді қалаймын
Dialogue: 0,0:03:46.56,0:03:47.43,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:47.93,0:03:49.68,Default,,0,0,0,,Неліктен Реюньонға қосылдыңыз?
Dialogue: 0,0:03:51.35,0:03:54.15,Default,,0,0,0,,Кездесу Чернобогты шатастырды.
Dialogue: 0,0:03:54.48,0:03:56.06,Default,,0,0,0,,Ал енді Рюмон да.
Dialogue: 0,0:03:56.82,0:03:59.74,Default,,0,0,0,,Жазықсыз адамдар мен балаларды құрбан ету.
Dialogue: 0,0:04:00.32,0:04:01.32,Default,,0,0,0,,Дұрыс емес
Dialogue: 0,0:04:02.40,0:04:03.16,Default,,0,0,0,,Құрбан шалу?
Dialogue: 0,0:04:04.87,0:04:06.49,Default,,0,0,0,,Осы уақытқа дейін қанша адам жұқтырды?
Dialogue: 0,0:04:06.58,0:04:08.12,Default,,0,0,0,,Мен өзімді құрбан болғандай сезінемін.
Dialogue: 0,0:04:08.62,0:04:09.66,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:04:10.20,0:04:11.20,Default,,0,0,0,,Көзге көз
Dialogue: 0,0:04:11.66,0:04:12.66,Default,,0,0,0,,Бұл мағынасы бар
Dialogue: 0,0:04:13.75,0:04:14.37,Default,,0,0,0,,Бірақ
Dialogue: 0,0:04:14.67,0:04:16.33,Default,,0,0,0,,Сіз Реюнионға жазылмайсыз.
Dialogue: 0,0:04:16.42,0:04:18.42,Default,,0,0,0,,Тіпті жұқтырған адамдар да құрбандыққа шалынып жатыр.
Dialogue: 0,0:04:19.21,0:04:21.01,Default,,0,0,0,,Реюньон – «оянғандар»
Dialogue: 0,0:04:25.22,0:04:25.97,Default,,0,0,0,,Уф! Аах!
Dialogue: 0,0:04:26.55,0:04:27.22,Default,,0,0,0,,Жұқтырған адамдар
Dialogue: 0,0:04:27.30,0:04:29.51,Default,,0,0,0,,Бостандық үшін күресуге шешім қабылдады
Dialogue: 0,0:04:30.93,0:04:32.18,Default,,0,0,0,,Сіз ұрыспайсыз
Dialogue: 0,0:04:32.64,0:04:34.56,Default,,0,0,0,,Реюньонға қосылмасаңыз да
Dialogue: 0,0:04:34.90,0:04:35.90,Default,,0,0,0,,Менің ойымша, бұл қате емес.
Dialogue: 0,0:04:36.90,0:04:37.52,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:04:38.48,0:04:39.82,Default,,0,0,0,,Мен Реюнионмен біргемін
Dialogue: 0,0:04:40.53,0:04:41.82,Default,,0,0,0,,Бұл қатыгез жер
Dialogue: 0,0:04:41.90,0:04:43.15,Default,,0,0,0,,Мен күресуді шештім.
Dialogue: 0,0:04:45.11,0:04:46.49,Default,,0,0,0,,Кім кінәсіз?
Dialogue: 0,0:04:46.74,0:04:48.20,Default,,0,0,0,,Ол шынымен бар деп ойлайсыз ба?
Dialogue: 0,0:04:50.83,0:04:51.50,Default,,0,0,0,,Жұқтырған адамдар
Dialogue: 0,0:04:51.58,0:04:53.54,Default,,0,0,0,,Кейбір үкіметтер сізге адам ретінде қарамайды.
Dialogue: 0,0:04:54.37,0:04:56.37,Default,,0,0,0,,Көзін жұмған азаматтар
Dialogue: 0,0:04:57.38,0:04:58.42,Default,,0,0,0,,Бұл бірдей қылмыс емес пе?
Dialogue: 0,0:05:00.63,0:05:01.80,Default,,0,0,0,,Мен жұқтырған адам болдым
Dialogue: 0,0:05:02.59,0:05:03.47,Default,,0,0,0,,Олар үшін
Dialogue: 0,0:05:03.55,0:05:05.55,Default,,0,0,0,,Бұл тек жойылуы керек «нәрсе» болды.
Dialogue: 0,0:05:06.64,0:05:07.64,Default,,0,0,0,,Сіз де көрген боларсыз.
Dialogue: 0,0:05:08.76,0:05:09.43,Default,,0,0,0,,Сол күні
Dialogue: 0,0:05:09.89,0:05:11.01,Default,,0,0,0,,Мен әлі кішкентай кезімде
Dialogue: 0,0:05:11.22,0:05:12.02,Default,,0,0,0,,Менің әкем
Dialogue: 0,0:05:13.60,0:05:15.35,Default,,0,0,0,,Үкімет жігіттері мені алып кетуге келді.
Dialogue: 0,0:05:16.52,0:05:18.61,Default,,0,0,0,,Күн аязды, қар жауды.
Dialogue: 0,0:05:19.02,0:05:20.32,Default,,0,0,0,,Мен қатты қарсылық көрсеттім
Dialogue: 0,0:05:21.15,0:05:23.61,Default,,0,0,0,,Анам да мені қорғаймын деп артымнан қуды.
Dialogue: 0,0:05:24.15,0:05:24.78,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:05:25.61,0:05:26.70,Default,,0,0,0,,Тоқта
Dialogue: 0,0:05:27.74,0:05:28.66,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:29.49,0:05:30.33,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:32.95,0:05:33.83,Default,,0,0,0,,Дәл солай. Өте ықтимал.
Dialogue: 0,0:05:38.38,0:05:39.92,Default,,0,0,0,,Мен сені кінәлап отырған жоқпын.
Dialogue: 0,0:05:40.92,0:05:41.84,Default,,0,0,0,,Бәрі сол қорқақтың кесірінен.
Dialogue: 0,0:05:42.05,0:05:43.51,Default,,0,0,0,,Біз жай ғана баламыз
Dialogue: 0,0:05:44.46,0:05:45.38,Default,,0,0,0,,«Сенім артамын.»
Dialogue: 0,0:05:45.80,0:05:47.38,Default,,0,0,0,,Мен ештеңе істей алмадым.
Dialogue: 0,0:05:48.26,0:05:49.34,Default,,0,0,0,,Менің таңдауым болмады.
Dialogue: 0,0:05:50.47,0:05:51.68,Default,,0,0,0,,Бірақ қазір емес
Dialogue: 0,0:05:52.31,0:05:54.35,Default,,0,0,0,,Кездесу маған күресуге батылдық берді
Dialogue: 0,0:05:55.56,0:05:56.73,Default,,0,0,0,,Жұқтырған адамдарға
Dialogue: 0,0:05:57.19,0:05:58.98,Default,,0,0,0,,Бірлік – құтқарылу
Dialogue: 0,0:06:00.40,0:06:01.23,Default,,0,0,0,,Құтқарылу
Dialogue: 0,0:06:04.86,0:06:05.94,Default,,0,0,0,,Амия
Dialogue: 0,0:06:06.40,0:06:07.11,Default,,0,0,0,,Родос
Dialogue: 0,0:06:07.20,0:06:08.86,Default,,0,0,0,,Сен маған көмектесуге келдің.
Dialogue: 0,0:06:09.87,0:06:10.62,Default,,0,0,0,,Родос
Dialogue: 0,0:06:10.82,0:06:11.45,Default,,0,0,0,,ше?
Dialogue: 0,0:06:11.95,0:06:12.95,Default,,0,0,0,,Алданбаңыз
Dialogue: 0,0:06:13.37,0:06:15.37,Default,,0,0,0,,Родос жұқтырғандарды құтқаратынын айтады.
Dialogue: 0,0:06:15.54,0:06:18.37,Default,,0,0,0,,Ол тек билікке ұмтылған сатқын.
Dialogue: 0,0:06:18.87,0:06:22.00,Default,,0,0,0,,Родос қанша отандасымызды зардап шекті деп ойлайсың?
Dialogue: 0,0:06:22.59,0:06:23.55,Default,,0,0,0,,Өйткені
Dialogue: 0,0:06:23.67,0:06:27.01,Default,,0,0,0,,Олар да бізден құтылуды ғана ойлап отыр.
Dialogue: 0,0:06:27.17,0:06:27.92,Default,,0,0,0,,Бірақ
Dialogue: 0,0:06:28.01,0:06:30.18,Default,,0,0,0,,Родос тұрғындары ешкімді өлтірген жоқ.
Dialogue: 0,0:06:30.59,0:06:32.93,Default,,0,0,0,,Төбелессем де, өмірімді қатерге салмаймын.
Dialogue: 0,0:06:35.06,0:06:35.93,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:06:36.14,0:06:38.94,Default,,0,0,0,,Сіз бұл әлемді Родос әдістерімен өзгерте алмайсыз.
Dialogue: 0,0:06:39.31,0:06:41.15,Default,,0,0,0,,Бірақ Реюньон мұны істей алады.
Dialogue: 0,0:06:41.81,0:06:42.81,Default,,0,0,0,,Бұл жер
Dialogue: 0,0:06:43.11,0:06:43.94,Default,,0,0,0,,Дүние қалай жұмыс істейді
Dialogue: 0,0:06:44.02,0:06:45.61,Default,,0,0,0,,Толық өзгертуге болады
Dialogue: 0,0:06:46.11,0:06:47.07,Default,,0,0,0,,Реюньонда
Dialogue: 0,0:06:47.40,0:06:48.82,Default,,0,0,0,,Оның осындай күші бар.
Dialogue: 0,0:06:49.86,0:06:50.91,Default,,0,0,0,,Менімен бірге бол
Dialogue: 0,0:06:51.62,0:06:52.28,Default,,0,0,0,,Миша
Dialogue: 0,0:06:53.03,0:06:54.16,Default,,0,0,0,,Бұдан былай, И
Dialogue: 0,0:06:54.66,0:06:55.70,Default,,0,0,0,,Сізді қорғаңыз
Dialogue: 0,0:06:56.37,0:06:57.45,Default,,0,0,0,,Бас сүйек
Dialogue: 0,0:06:57.70,0:06:58.71,Default,,0,0,0,,Ұсақтағыш
Dialogue: 0,0:07:00.83,0:07:02.38,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:02.96,0:07:05.13,Default,,0,0,0,,Бұл сіздің базаңыз болды ма?
Dialogue: 0,0:07:05.25,0:07:06.21,Default,,0,0,0,,Жаулар
Dialogue: 0,0:07:06.55,0:07:08.05,Default,,0,0,0,,Бұл өте аз сияқты.
Dialogue: 0,0:07:08.38,0:07:09.51,Default,,0,0,0,,Мен бұл туралы ойладым.
Dialogue: 0,0:07:09.72,0:07:11.51,Default,,0,0,0,,Originium кеніші дегеніміз не?
Dialogue: 0,0:07:11.84,0:07:13.05,Default,,0,0,0,,Ешкім жақындағысы келмейді
Dialogue: 0,0:07:13.43,0:07:14.05,Default,,0,0,0,,Бұл
Dialogue: 0,0:07:14.76,0:07:15.43,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:17.06,0:07:17.68,Default,,0,0,0,,Эй
Dialogue: 0,0:07:18.31,0:07:19.14,Default,,0,0,0,,Бұл тым көп
Dialogue: 0,0:07:19.48,0:07:20.19,Default,,0,0,0,,болды
Dialogue: 0,0:07:21.27,0:07:22.06,Default,,0,0,0,,Бұл Миша.
Dialogue: 0,0:07:22.27,0:07:23.36,Default,,0,0,0,,Неге? Хм?
Dialogue: 0,0:07:23.77,0:07:24.73,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:07:25.15,0:07:26.36,Default,,0,0,0,,Мен Амияға хабарлауым керек.
Dialogue: 0,0:07:27.44,0:07:28.11,Default,,0,0,0,,Exia
Dialogue: 0,0:07:28.65,0:07:30.07,Default,,0,0,0,,Мына жолмен келе жатыр.
Dialogue: 0,0:07:31.24,0:07:32.49,Default,,0,0,0,,Мүмкін бұл менің кінәм шығар?
Dialogue: 0,0:07:32.99,0:07:33.74,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:07:34.16,0:07:35.12,Default,,0,0,0,,Ах
Dialogue: 0,0:07:35.95,0:07:36.79,Default,,0,0,0,,Сіз олармен хабарластыңыз ба?
Dialogue: 0,0:07:37.04,0:07:38.29,Default,,0,0,0,,Иә, тамаша
Dialogue: 0,0:07:38.54,0:07:39.45,Default,,0,0,0,,дұрыс
Dialogue: 0,0:07:39.96,0:07:41.00,Default,,0,0,0,,Оларды мүмкіндігінше өлтіріңіз
Dialogue: 0,0:07:41.16,0:07:42.12,Default,,0,0,0,,Мен сені осында қалдырамын.
Dialogue: 0,0:07:44.08,0:07:44.79,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:44.92,0:07:46.34,Default,,0,0,0,,Мен жылынуым керек пе?
Dialogue: 0,0:07:48.34,0:07:49.17,Default,,0,0,0,,Қарашы, Миша.
Dialogue: 0,0:07:50.63,0:07:52.43,Default,,0,0,0,,Бұны солға қарай бұраңыз.
Dialogue: 0,0:07:53.89,0:07:55.10,Default,,0,0,0,,Картриджді салу
Dialogue: 0,0:07:56.93,0:07:57.72,Default,,0,0,0,,Жүктегеннен кейін
Dialogue: 0,0:07:59.68,0:08:00.31,Default,,0,0,0,,Жабу
Dialogue: 0,0:08:02.31,0:08:03.44,Default,,0,0,0,,Осы уақытқа дейін бәрі жақсы ма?
Dialogue: 0,0:08:05.56,0:08:06.90,Default,,0,0,0,,Мақсат ал
Dialogue: 0,0:08:09.57,0:08:10.49,Default,,0,0,0,,триггерді тартыңыз
Dialogue: 0,0:08:22.29,0:08:23.33,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:08:23.96,0:08:25.00,Default,,0,0,0,,Өнер
Dialogue: 0,0:08:25.21,0:08:26.50,Default,,0,0,0,,Жай ғана атпаңыз
Dialogue: 0,0:08:27.42,0:08:29.92,Default,,0,0,0,,Оқтардың жарылуы үшін өнердің күшін пайдаланыңыз.
Dialogue: 0,0:08:32.92,0:08:34.26,Default,,0,0,0,,Сіз де жасай аласыз.
Dialogue: 0,0:08:37.68,0:08:40.77,Default,,0,0,0,,Сіз өзіңізді қорғау әдістерін үйренуіңіз керек
Dialogue: 0,0:08:41.43,0:08:42.06,Default,,0,0,0,,Бірақ
Dialogue: 0,0:08:50.61,0:08:52.07,Default,,0,0,0,,Мықтап ұстаңыз
Dialogue: 0,0:08:52.69,0:08:53.32,Default,,0,0,0,,түзу
Dialogue: 0,0:08:53.65,0:08:54.82,Default,,0,0,0,,Мақсат ал
Dialogue: 0,0:08:55.78,0:08:57.28,Default,,0,0,0,,Ойыңызды шоғырландырыңыз
Dialogue: 0,0:08:58.24,0:08:59.41,Default,,0,0,0,,Тыныс алу уақытында
Dialogue: 0,0:09:04.21,0:09:05.33,Default,,0,0,0,,Дене
Dialogue: 0,0:09:05.87,0:09:06.71,Default,,0,0,0,,Олардың мен адамзаттың күш арасындағы алшақтық аса үлкен еді,
Dialogue: 0,0:09:16.05,0:09:17.59,Default,,0,0,0,,Мұны тым жарқырауға болмайды
Dialogue: 0,0:09:18.05,0:09:18.76,Default,,0,0,0,,мен Токио вокзалына дейін шамамен бір жарым сағат Шинкансенге отырдым
Dialogue: 0,0:09:19.26,0:09:21.35,Default,,0,0,0,,Мен осылай дедім
Dialogue: 0,0:09:26.81,0:09:27.77,Default,,0,0,0,,Тыныш болыңыз
Dialogue: 0,0:09:33.65,0:09:34.36,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:09:34.74,0:09:35.45,Default,,0,0,0,,Өнер
Dialogue: 0,0:09:39.32,0:09:40.87,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:09:41.20,0:09:42.33,Default,,0,0,0,,Керемет Миша!
Dialogue: 0,0:09:42.83,0:09:44.08,Default,,0,0,0,,Өйткені, біз
Dialogue: 0,0:09:44.16,0:09:45.96,Default,,0,0,0,,Біздің күшіміз бірдей!
Dialogue: 0,0:09:48.54,0:09:49.50,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:09:49.58,0:09:50.50,Default,,0,0,0,,Өткенде
Dialogue: 0,0:09:50.88,0:09:52.13,Default,,0,0,0,,Мм, Миша?
Dialogue: 0,0:09:54.01,0:09:54.67,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:09:54.88,0:09:56.59,Default,,0,0,0,,Ұмытқанша тағы бір рет
Dialogue: 0,0:09:56.76,0:09:57.51,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:09:58.80,0:09:59.84,Default,,0,0,0,,Бас сүйек ұсақтағыш!
Dialogue: 0,0:09:58.09,0:09:58.72,Default,,0,0,0,,Бұл жігіт, Джоруноның денесін арқалап
Dialogue: 0,0:10:00.43,0:10:01.05,Default,,0,0,0,,Иван
Dialogue: 0,0:10:04.47,0:10:05.14,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:05.68,0:10:06.56,Default,,0,0,0,,Не болды
Dialogue: 0,0:10:07.10,0:10:08.39,Default,,0,0,0,,Қазір шегініңіз!
Dialogue: 0,0:10:08.52,0:10:09.48,Default,,0,0,0,,Бұл енді белгілі!
Dialogue: 0,0:10:09.77,0:10:10.77,Default,,0,0,0,,Родос келеді!
Dialogue: 0,0:10:11.15,0:10:11.90,Default,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:10:12.77,0:10:14.65,Default,,0,0,0,,Родос қоқысы
Dialogue: 0,0:10:16.53,0:10:17.61,Default,,0,0,0,,Барлығын жинаңыз!
Dialogue: 0,0:10:17.90,0:10:19.16,Default,,0,0,0,,Қарсы күрес
Dialogue: 0,0:10:20.37,0:10:21.32,Default,,0,0,0,,Мишаны алып кетті
Dialogue: 0,0:10:21.41,0:10:23.41,Default,,0,0,0,,Мен Реюньонның жасырынатын жерін таптым.
Dialogue: 0,0:10:23.54,0:10:25.12,Default,,0,0,0,,Орналасқан жері Лонгменнің шетінде
Dialogue: 0,0:10:25.54,0:10:27.12,Default,,0,0,0,,Қараусыз қалған кен орны
Dialogue: 0,0:10:27.50,0:10:28.25,Default,,0,0,0,,Барлығы
Dialogue: 0,0:10:28.33,0:10:29.79,Default,,0,0,0,,Оқиға орнына дереу барыңыз
Dialogue: 0,0:10:31.21,0:10:33.50,Default,,0,0,0,,Мен Мишаны міндетті түрде құтқарамын.
Dialogue: 0,0:10:34.21,0:10:34.96,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:10:35.30,0:10:36.67,Default,,0,0,0,,Шабуылға дайындалу
Dialogue: 0,0:10:57.61,0:10:59.36,Default,,0,0,0,,Сіз шынымен Родоспен күрескіңіз келе ме?
Dialogue: 0,0:11:00.57,0:11:02.32,Default,,0,0,0,,Менімен сөйлессең, түсінетініне сенімдімін.
Dialogue: 0,0:11:02.95,0:11:04.08,Default,,0,0,0,,Егер Амия
Dialogue: 0,0:11:04.28,0:11:05.70,Default,,0,0,0,,Оян, Миша!
Dialogue: 0,0:11:06.37,0:11:07.20,Default,,0,0,0,,Мен айттым ғой!
Dialogue: 0,0:11:07.50,0:11:09.46,Default,,0,0,0,,Олар жұқтырған сатқындар!
Dialogue: 0,0:11:10.21,0:11:12.63,Default,,0,0,0,,Сатқынмен сөйлесетін ештеңе жоқ!
Dialogue: 0,0:11:12.92,0:11:13.67,Default,,0,0,0,,Бірақ
Dialogue: 0,0:11:14.71,0:11:15.55,Default,,0,0,0,,Бірақ
Dialogue: 0,0:11:16.42,0:11:17.96,Default,,0,0,0,,Мен сізбен кездесе алдым.
Dialogue: 0,0:11:18.97,0:11:20.59,Default,,0,0,0,,Неге түсінбейсің?
Dialogue: 0,0:11:22.72,0:11:24.55,Default,,0,0,0,,Қайта кездесуге сенбесеңіз де
Dialogue: 0,0:11:25.51,0:11:26.89,Default,,0,0,0,,Маған сенгеніңді қалаймын
Dialogue: 0,0:11:27.47,0:11:28.18,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:11:36.11,0:11:36.98,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:11:38.69,0:11:40.07,Default,,0,0,0,,Міндетті түрде қайтып келіңіз
Dialogue: 0,0:11:41.28,0:11:41.99,Default,,0,0,0,,О
Dialogue: 0,0:11:42.66,0:11:44.41,Default,,0,0,0,,Мен сені енді жалғыз қалдырмаймын
Dialogue: 0,0:11:45.24,0:11:46.49,Default,,0,0,0,,Бұл шайқас аяқталғанда
Dialogue: 0,0:11:47.24,0:11:48.16,Default,,0,0,0,,Үйге бірге барайық
Dialogue: 0,0:11:56.17,0:11:57.13,Default,,0,0,0,,Алекс
Dialogue: 0,0:12:00.22,0:12:01.22,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:12:03.38,0:12:05.76,Default,,0,0,0,,Сізге әлі де менің көмегім керек пе?
Dialogue: 0,0:12:05.97,0:12:07.10,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:12:08.81,0:12:10.31,Default,,0,0,0,,...
Dialogue: 0,0:12:10.68,0:12:12.27,Default,,0,0,0,,Жау күткеннен де күшті
Dialogue: 0,0:12:12.85,0:12:14.10,Default,,0,0,0,,...
Dialogue: 0,0:12:14.31,0:12:15.23,Default,,0,0,0,,Әртүрлі жағдай
Dialogue: 0,0:12:15.81,0:12:16.65,Default,,0,0,0,,Арама
Dialogue: 0,0:12:17.32,0:12:18.19,Default,,0,0,0,,Сонымен, сіз
Dialogue: 0,0:12:18.86,0:12:20.86,Default,,0,0,0,,Мишаны еш нәрсеге қарамастан қорғаңыз
Dialogue: 0,0:12:22.11,0:12:22.82,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:12:23.40,0:12:25.03,Default,,0,0,0,,...
Dialogue: 0,0:12:25.53,0:12:27.33,Default,,0,0,0,,...
Dialogue: 0,0:12:27.58,0:12:30.25,Default,,0,0,0,,...
Dialogue: 0,0:12:30.87,0:12:32.33,Default,,0,0,0,,...
Dialogue: 0,0:12:33.21,0:12:34.92,Default,,0,0,0,,...
Dialogue: 0,0:12:35.04,0:12:36.92,Default,,0,0,0,,...
Dialogue: 0,0:12:38.80,0:12:40.05,Default,,0,0,0,,Қандай да бір жол бар ма?
Dialogue: 0,0:12:42.92,0:12:44.43,Default,,0,0,0,,...
Dialogue: 0,0:12:44.97,0:12:46.64,Default,,0,0,0,,...
Dialogue: 0,0:12:47.43,0:12:48.10,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:12:48.30,0:12:49.89,Default,,0,0,0,,Оны доктор деп атайтын адам ба?
Dialogue: 0,0:12:50.60,0:12:52.23,Default,,0,0,0,,...
Dialogue: 0,0:12:52.60,0:12:53.98,Default,,0,0,0,,Родос миы
Dialogue: 0,0:12:54.89,0:12:56.56,Default,,0,0,0,,Миымды өшіріп алсам ғой
Dialogue: 0,0:12:56.98,0:12:59.36,Default,,0,0,0,,Ұйымдар көзді ашып-жұмғанша ыдырап кетеді
Dialogue: 0,0:13:00.40,0:13:01.78,Default,,0,0,0,,...
Dialogue: 0,0:13:02.40,0:13:03.57,Default,,0,0,0,,...
Dialogue: 0,0:13:04.03,0:13:05.07,Default,,0,0,0,,бұл дұрыс
Dialogue: 0,0:13:05.36,0:13:06.99,Default,,0,0,0,,Бәрі жақсы болады.
Dialogue: 0,0:13:07.74,0:13:10.16,Default,,0,0,0,,Мен сізге бірлігімді біраз уақытқа қарызға беремін.
Dialogue: 0,0:13:10.79,0:13:12.66,Default,,0,0,0,,Не істеу керек
Dialogue: 0,0:13:13.37,0:13:14.46,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:13:15.46,0:13:16.08,Default,,0,0,0,,О
Dialogue: 0,0:13:16.58,0:13:17.33,Default,,0,0,0,,Мақсат
Dialogue: 0,0:13:17.42,0:13:18.46,Default,,0,0,0,,Родос командирі
Dialogue: 0,0:13:19.34,0:13:20.00,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:13:21.96,0:13:22.76,Default,,0,0,0,,Бұл жер бедері
Dialogue: 0,0:13:23.34,0:13:24.47,Default,,0,0,0,,Тұзақ қойыңыз
Dialogue: 0,0:13:24.63,0:13:27.05,Default,,0,0,0,,Бұл жауларды азғыруға жақсы орын.
Dialogue: 0,0:13:27.64,0:13:28.72,Default,,0,0,0,,Ача~
Dialogue: 0,0:13:28.80,0:13:30.81,Default,,0,0,0,,...
Dialogue: 0,0:13:30.89,0:13:32.14,Default,,0,0,0,,Нашар көріну
Dialogue: 0,0:13:32.68,0:13:33.47,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:13:33.98,0:13:36.48,Default,,0,0,0,,Өйткені, қарсы тарап – аласапыран лаңкестік топ.
Dialogue: 0,0:13:36.60,0:13:37.73,Default,,0,0,0,,Бірден жеңу
Dialogue: 0,0:13:38.44,0:13:40.27,Default,,0,0,0,,...
Dialogue: 0,0:13:40.36,0:13:41.19,Default,,0,0,0,,Осы жерде күтіңіз
Dialogue: 0,0:13:41.65,0:13:42.65,Default,,0,0,0,,Кек алуды сұрау
Dialogue: 0,0:13:42.86,0:13:43.48,Default,,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 0,0:13:43.99,0:13:44.69,Default,,0,0,0,,Барлығы
Dialogue: 0,0:13:44.94,0:13:46.86,Default,,0,0,0,,Өзіңізге қайта құруға уақыт бермеңіз
Dialogue: 0,0:13:46.95,0:13:48.36,Default,,0,0,0,,Қарсыластың күшін азайтыңыз
Dialogue: 0,0:13:49.07,0:13:49.74,Default,,0,0,0,,Мұнда рух бар.
Dialogue: 0,0:13:50.07,0:13:53.29,Default,,0,0,0,,Мишаны құтқаруды басты міндет етіп қойыңыз.
Dialogue: 0,0:13:53.66,0:13:54.87,Default,,0,0,0,,Капитан Они
Dialogue: 0,0:13:54.95,0:13:56.83,Default,,0,0,0,,Тек оны асыра алмаңыз.
Dialogue: 0,0:13:56.96,0:13:57.58,Default,,0,0,0,,Хун
Dialogue: 0,0:13:57.83,0:13:58.54,Default,,0,0,0,,Түсінгенше көрсетемін
Dialogue: 0,0:13:58.71,0:13:59.46,Default,,0,0,0,,Сіз де
Dialogue: 0,0:13:59.58,0:14:00.21,Default,,0,0,0,,Франка
Dialogue: 0,0:14:00.50,0:14:01.79,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:02.46,0:14:03.13,Default,,0,0,0,,Тайбар әулеті келді!!
Dialogue: 0,0:14:18.52,0:14:20.15,Default,,0,0,0,,Жүр!
Dialogue: 0,0:14:23.94,0:14:24.65,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:14:25.32,0:14:25.99,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:14:26.86,0:14:28.99,Default,,0,0,0,,Миссияның басталуы
Dialogue: 0,0:14:29.24,0:14:29.91,Default,,0,0,0,,Дәрігер!
Dialogue: 0,0:14:30.03,0:14:31.49,Default,,0,0,0,,Жоғарыдан пәрмен беріңіз.
Dialogue: 0,0:14:32.87,0:14:34.20,Default,,0,0,0,,Жалғасы
Dialogue: 0,0:14:37.21,0:14:38.37,Default,,0,0,0,,Снайпер операторы
Dialogue: 0,0:14:38.58,0:14:40.00,Default,,0,0,0,,Қарсыластың алдыңғы шебіндегі атыс
Dialogue: 0,0:14:40.54,0:14:41.46,Default,,0,0,0,,Құрылымды бұзу
Dialogue: 0,0:14:41.67,0:14:43.04,Default,,0,0,0,,Рёкай!
Dialogue: 0,0:14:43.84,0:14:44.59,Default,,0,0,0,,Болмау!
Dialogue: 0,0:14:44.67,0:14:45.38,Default,,0,0,0,,Шашырау!
Dialogue: 0,0:14:47.22,0:14:47.88,Default,,0,0,0,,Сиқыршы
Dialogue: 0,0:14:47.97,0:14:48.51,Default,,0,0,0,,Босатыңыз!
Dialogue: 0,0:14:49.30,0:14:49.97,Default,,0,0,0,,Сиқыршы
Dialogue: 0,0:14:50.09,0:14:51.14,Default,,0,0,0,,Снайпер операторы
Dialogue: 0,0:14:51.51,0:14:52.80,Default,,0,0,0,,Қарсыластың тыл күзетін бұзуды жалғастыру.
Dialogue: 0,0:14:53.22,0:14:54.56,Default,,0,0,0,,Қайта құруға уақыт бермеу
Dialogue: 0,0:14:54.89,0:14:56.06,Default,,0,0,0,,...
Dialogue: 0,0:15:01.60,0:15:02.27,Default,,0,0,0,,Техас
Dialogue: 0,0:15:02.36,0:15:03.44,Default,,0,0,0,,10 сағат бағыты
Dialogue: 0,0:15:03.52,0:15:04.57,Default,,0,0,0,,...
Dialogue: 0,0:15:09.95,0:15:11.91,Default,,0,0,0,,...
Dialogue: 0,0:15:12.99,0:15:13.70,Default,,0,0,0,,Лискум
Dialogue: 0,0:15:14.12,0:15:15.24,Default,,0,0,0,,Мен мұны сұрадым.
Dialogue: 0,0:15:15.33,0:15:16.33,Default,,0,0,0,,Тіпті айтпай-ақ
Dialogue: 0,0:15:24.13,0:15:24.88,Default,,0,0,0,,...
Dialogue: 0,0:15:28.67,0:15:29.34,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:29.88,0:15:30.76,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:15:31.59,0:15:32.51,Default,,0,0,0,,...
Dialogue: 0,0:15:38.56,0:15:39.85,Default,,0,0,0,,!
Dialogue: 0,0:15:43.15,0:15:44.69,Default,,0,0,0,,...
Dialogue: 0,0:15:45.69,0:15:46.94,Default,,0,0,0,,Өзіңіз жайлы болыңыз
Dialogue: 0,0:15:47.11,0:15:48.99,Default,,0,0,0,,...
Dialogue: 0,0:15:49.49,0:15:50.45,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:15:51.61,0:15:53.49,Default,,0,0,0,,Менің бір ісім бар, мен кетейін.
Dialogue: 0,0:15:54.28,0:15:56.49,Default,,0,0,0,,Сұрақтарыңыз болса, осында маған хабарласыңыз.
Dialogue: 0,0:15:57.08,0:15:57.74,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:16:03.25,0:16:04.25,Default,,0,0,0,,!
Dialogue: 0,0:16:04.63,0:16:05.33,Default,,0,0,0,,Шашырау!
Dialogue: 0,0:16:06.42,0:16:08.13,Default,,0,0,0,,!
Dialogue: 0,0:16:08.25,0:16:09.21,Default,,0,0,0,,Өлтір!
Dialogue: 0,0:16:16.30,0:16:17.64,Default,,0,0,0,,...
Dialogue: 0,0:16:18.43,0:16:19.43,Default,,0,0,0,,...
Dialogue: 0,0:16:20.52,0:16:22.27,Default,,0,0,0,,...
Dialogue: 0,0:16:22.77,0:16:23.69,Default,,0,0,0,,...
Dialogue: 0,0:16:23.98,0:16:25.10,Default,,0,0,0,,Жау базасына қарай
Dialogue: 0,0:16:25.27,0:16:26.15,Default,,0,0,0,,Әрі қарай жүріңіз
Dialogue: 0,0:16:26.23,0:16:27.15,Default,,0,0,0,,Рёкай
Dialogue: 0,0:16:28.11,0:16:28.77,Default,,0,0,0,,Ерте
Dialogue: 0,0:16:28.86,0:16:30.94,Default,,0,0,0,,Шулы бомба-кунды ұстайық.
Dialogue: 0,0:16:31.44,0:16:34.11,Default,,0,0,0,,Мишаны құтқару – басты міндет.
Dialogue: 0,0:16:34.32,0:16:35.74,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:16:36.49,0:16:37.12,Default,,0,0,0,,Лискум
Dialogue: 0,0:16:37.20,0:16:37.83,Default,,0,0,0,,Артында!
Dialogue: 0,0:16:40.62,0:16:41.25,Default,,0,0,0,,Хе-хе, рақмет
Dialogue: 0,0:16:49.59,0:16:50.34,Default,,0,0,0,,Жарай берсін, қойып қой. Кел, бастайық.
Dialogue: 0,0:17:04.81,0:17:05.60,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:05.98,0:17:07.65,Default,,0,0,0,,...
Dialogue: 0,0:17:08.31,0:17:09.65,Default,,0,0,0,,...
Dialogue: 0,0:17:09.82,0:17:11.23,Default,,0,0,0,,Айналадағы жауларға қамқор болыңыз.
Dialogue: 0,0:17:11.98,0:17:12.94,Default,,0,0,0,,Негізгі күштер
Dialogue: 0,0:17:13.44,0:17:14.07,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:14.36,0:17:15.24,Default,,0,0,0,,Еш қағыспа!
Dialogue: 0,0:17:15.45,0:17:17.07,Default,,0,0,0,,!
Dialogue: 0,0:17:17.95,0:17:19.95,Default,,0,0,0,,々!
Dialogue: 0,0:17:20.58,0:17:21.91,Default,,0,0,0,,!
Dialogue: 0,0:17:22.54,0:17:23.20,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:17:23.58,0:17:24.54,Default,,0,0,0,,Жау жеңгенше
Dialogue: 0,0:17:24.87,0:17:25.92,Default,,0,0,0,,Бар
Dialogue: 0,0:17:26.62,0:17:27.58,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:17:27.83,0:17:29.63,Default,,0,0,0,,Мишаны құтқару
Dialogue: 0,0:17:34.55,0:17:36.76,Default,,0,0,0,,Ескерту. Жылу көзі жақындап келеді.
Dialogue: 0,0:17:45.69,0:17:46.60,Default,,0,0,0,,Дәрігер!
Dialogue: 0,0:17:46.94,0:17:47.81,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:17:47.90,0:17:48.85,Default,,0,0,0,,(Құлақтағы сыңғыру)
Dialogue: 0,0:17:49.73,0:17:50.44,Default,,0,0,0,,О.
Dialogue: 0,0:17:50.90,0:17:52.61,Default,,0,0,0,,Жақсы өткен сияқты.
Dialogue: 0,0:18:04.33,0:18:05.33,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:18:07.37,0:18:08.00,Default,,0,0,0,,Не!?
Dialogue: 0,0:18:08.33,0:18:09.29,Default,,0,0,0,,Бұл қалқан
Dialogue: 0,0:18:09.50,0:18:10.84,Default,,0,0,0,,Менің «Праджна» - бұл
Dialogue: 0,0:18:10.92,0:18:13.30,Default,,0,0,0,,Бұл сіз сияқты біреудің еніп кетуі мүмкін нәрсе емес!
Dialogue: 0,0:18:14.21,0:18:15.84,Default,,0,0,0,,Маған кедергі жасама!
Dialogue: 0,0:18:33.65,0:18:35.44,Default,,0,0,0,,Жалғыз келу деген нені білдіреді?
Dialogue: 0,0:18:35.74,0:18:36.69,Default,,0,0,0,,Бұл ақымақ жоспар болды!
Dialogue: 0,0:18:52.88,0:18:53.63,Default,,0,0,0,,Барлығы
Dialogue: 0,0:18:54.30,0:18:55.84,Default,,0,0,0,,Мен оны ұшырып жіберемін!
Dialogue: 0,0:18:57.38,0:18:58.34,Default,,0,0,0,,Ұстаңыз!
Dialogue: 0,0:18:59.30,0:18:59.93,Default,,0,0,0,,Дәрігер!
Dialogue: 0,0:19:00.09,0:19:00.89,Default,,0,0,0,,иықтарыңызды шайқаңыз
Dialogue: 0,0:19:01.22,0:19:01.89,Default,,0,0,0,,Қаш!
Dialogue: 0,0:19:02.35,0:19:03.05,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:19:07.31,0:19:08.23,Default,,0,0,0,,Бұл жылу
Dialogue: 0,0:19:08.52,0:19:09.35,Default,,0,0,0,,Әрі қарай, Эрен
Dialogue: 0,0:19:09.48,0:19:10.44,Default,,0,0,0,,Мен өзімді құртамын!
Dialogue: 0,0:19:11.06,0:19:11.81,Default,,0,0,0,,Дәрігер!
Dialogue: 0,0:19:13.44,0:19:14.11,Default,,0,0,0,,Миша
Dialogue: 0,0:19:14.65,0:19:15.48,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:16.69,0:19:17.40,Default,,0,0,0,,Сен сияқты — олардың әрқайсысы.
Dialogue: 0,0:19:18.24,0:19:19.40,Default,,0,0,0,,Қорғау мүмкін емес сияқты
Dialogue: 0,0:19:22.82,0:19:23.45,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:19:24.66,0:19:25.28,Default,,0,0,0,,No
Dialogue: 0,0:19:25.53,0:19:26.99,Default,,0,0,0,,Өл!
Dialogue: 0,0:19:27.16,0:19:28.16,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:19:29.41,0:19:30.21,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:19:32.17,0:19:33.71,Default,,0,0,0,,Сені ренжітуге жол берме
Dialogue: 0,0:19:51.77,0:19:52.44,Default,,0,0,0,,Не?
Dialogue: 0,0:20:03.07,0:20:04.20,Default,,0,0,0,,Кана
Dialogue: 0,0:20:06.37,0:20:07.24,Default,,0,0,0,,١١
Dialogue: 0,0:20:10.91,0:20:11.66,Default,,0,0,0,,Мен
Dialogue: 0,0:20:12.67,0:20:13.50,Default,,0,0,0,,Ша
Dialogue: 0,0:20:24.43,0:20:25.01,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:20:26.35,0:20:27.39,Default,,0,0,0,,Яааааа!
Dialogue: 0,0:20:58.75,0:20:59.92,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:21:01.96,0:21:02.67,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:21:06.51,0:21:07.43,Default,,0,0,0,,Амия
Dialogue: 0,0:21:09.01,0:21:09.72,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:21:12.39,0:21:13.77,Default,,0,0,0,,Бас сүйек ұсақтағыш
Dialogue: 0,0:21:14.14,0:21:15.56,Default,,0,0,0,,Бас сүйек ұсақтағыш
Dialogue: 0,0:21:15.77,0:21:16.65,Default,,0,0,0,,(Тодороки) Камино… (Камино) Жарайды, алдым.
Dialogue: 0,0:21:17.06,0:21:18.48,Default,,0,0,0,,Бұл шындық болуы мүмкін емес!
Dialogue: 0,0:21:18.90,0:21:19.77,Default,,0,0,0,,Мен оны қайтарып аламын!
Dialogue: 0,0:21:19.94,0:21:20.78,Default,,0,0,0,,Әлгі жігіт!
Dialogue: 0,0:21:20.90,0:21:22.32,Default,,0,0,0,,Талантты және талантты!
Dialogue: 0,0:21:30.37,0:21:31.33,Default,,0,0,0,,Уақытша шығу.
Dialogue: 0,0:21:32.79,0:21:33.50,Default,,0,0,0,,Алайда, капитан
Dialogue: 0,0:21:34.25,0:21:36.29,Default,,0,0,0,,Қазір Реюньонды жою үшін жақсы уақыт.
Dialogue: 0,0:21:36.96,0:21:39.54,Default,,0,0,0,,Бұл жағдайда Мишаны іздеуді жалғастыру мүмкін емес.
Dialogue: 0,0:21:40.00,0:21:40.84,Default,,0,0,0,,Егер шайқас жалғаса берсе
Dialogue: 0,0:21:40.92,0:21:42.34,Default,,0,0,0,,Бұл тек қажетсіз шығындарға әкеледі.
Dialogue: 0,0:21:42.76,0:21:43.55,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:21:43.84,0:21:45.01,Default,,0,0,0,,Бұл бұйрық
Dialogue: 0,0:21:46.18,0:21:46.80,Default,,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 0,0:21:56.56,0:21:57.35,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:59.86,0:22:01.02,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:22:03.11,0:22:04.15,Default,,0,0,0,,Амия
Dialogue: 0,0:22:05.65,0:22:11.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory