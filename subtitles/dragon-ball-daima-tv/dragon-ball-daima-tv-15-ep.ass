Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.04,0:00:07.04,Default,,0000,0000,0000,,[Айдаһар шары дегеніміз не?
Dialogue: 0,0:00:02.04,0:00:07.04,Default,,0000,0000,0000,,7 бөлікті жинап, құпия сөзді айт➡
Dialogue: 0,0:00:07.04,0:00:15.05,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:00:07.04,0:00:15.05,Default,,0000,0000,0000,,Айдаһар
Dialogue: 0,0:00:07.04,0:00:15.05,Default,,0000,0000,0000,,Шенрон деген айдаһар шығады дейді.
Dialogue: 0,0:00:07.04,0:00:15.05,Default,,0000,0000,0000,,Бұл жұмбақ доп]
Dialogue: 0,0:00:15.05,0:00:21.05,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:00:15.05,0:00:21.05,Default,,0000,0000,0000,,[Шенроннан сұрайтын кез келген тілек
Dialogue: 0,0:00:15.05,0:00:21.05,Default,,0000,0000,0000,,Бұл орындалады]
Dialogue: 0,0:00:21.05,0:00:24.06,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:00:21.05,0:00:24.06,Default,,0000,0000,0000,,Гоку
Dialogue: 0,0:00:21.05,0:00:24.06,Default,,0000,0000,0000,,[Бұл Сон Гоку деген адам➡
Dialogue: 0,0:00:24.06,0:00:27.06,Default,,0000,0000,0000,,Сабырлы болып көрінсе де
Dialogue: 0,0:00:24.06,0:00:27.06,Default,,0000,0000,0000,,Ерекше күшке ие➡
Dialogue: 0,0:00:27.06,0:00:31.06,Default,,0000,0000,0000,,Жауынгер нәсіл - Сайандар]
Dialogue: 0,0:00:31.06,0:00:34.07,Default,,0000,0000,0000,,[Таудың тереңінде тұратын бала кезімде➡
Dialogue: 0,0:00:34.07,0:00:37.07,Default,,0000,0000,0000,,Айдаһар допты іздеу
Dialogue: 0,0:00:34.07,0:00:37.07,Default,,0000,0000,0000,,Достармен танысу➡
Dialogue: 0,0:00:37.07,0:00:42.08,Default,,0000,0000,0000,,Бірге есейіңіз]
Dialogue: 0,0:00:42.08,0:00:44.08,Default,,0000,0000,0000,,[Менің өмірімнің көп бөлігі➡
Dialogue: 0,0:00:44.08,0:00:49.08,Default,,0000,0000,0000,,Жас денені сақтаңыз
Dialogue: 0,0:00:44.08,0:00:49.08,Default,,0000,0000,0000,,Сайян сипаттамалары бар➡
Dialogue: 0,0:00:49.08,0:00:53.09,Default,,0000,0000,0000,,Қазір де
Dialogue: 0,0:00:49.08,0:00:53.09,Default,,0000,0000,0000,,Бұрынғы қарсыластарымен➡
Dialogue: 0,0:00:53.09,0:00:59.09,Default,,0000,0000,0000,,Жаманның қолынан
Dialogue: 0,0:00:53.09,0:00:59.09,Default,,0000,0000,0000,,Жерді қорғауды жалғастыру]
Dialogue: 0,0:00:59.09,0:01:09.07,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:41.03,0:02:43.00,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:02:45.03,0:02:49.00,Default,,0000,0000,0000,,Бірден шабуыл жасаңыз!
Dialogue: 0,0:02:52.04,0:02:55.01,Default,,0000,0000,0000,,Какаре~!
Dialogue: 0,0:03:01.05,0:03:03.02,Default,,0000,0000,0000,,Қарғыс атсын... Уау.
Dialogue: 0,0:03:10.06,0:03:13.06,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:03:13.06,0:03:16.06,Default,,0000,0000,0000,,Кя!
Dialogue: 0,0:03:13.06,0:03:16.06,Default,,0000,0000,0000,,Цк... өте тітіркендіргіш!
Dialogue: 0,0:03:16.06,0:03:19.07,Default,,0000,0000,0000,,Мылтық қолдану заңсыз!
Dialogue: 0,0:03:19.07,0:03:21.07,Default,,0000,0000,0000,,(Амон) Нагачика? (Хайд) Ах, Амон-сан.
Dialogue: 0,0:03:21.07,0:03:23.07,Default,,0000,0000,0000,,Сәлем! Барлығы жақсы ма?
Dialogue: 0,0:03:23.07,0:03:26.74,Default,,0000,0000,0000,,Әйтеуір!
Dialogue: 0,0:03:26.74,0:03:28.71,Default,,0000,0000,0000,,⚟Уау!
Dialogue: 0,0:03:34.01,0:03:35.98,Default,,0000,0000,0000,,Мына жерде!
Dialogue: 0,0:03:38.69,0:03:40.65,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:03:47.03,0:03:50.03,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:03:50.03,0:03:53.03,Default,,0000,0000,0000,,Райнер, кейін кездескенше.
Dialogue: 0,0:03:50.03,0:03:53.03,Default,,0000,0000,0000,,Ауырды...
Dialogue: 0,0:03:53.03,0:03:55.00,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:04:04.04,0:04:06.05,Default,,0000,0000,0000,,Чичичичи….
Dialogue: 0,0:04:06.05,0:04:09.05,Default,,0000,0000,0000,,Дұрыс тамақтансаңыз
Dialogue: 0,0:04:06.05,0:04:09.05,Default,,0000,0000,0000,,Сіз қозғала алмайсыз. Сақ болыңыз!
Dialogue: 0,0:04:09.05,0:04:11.02,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:04:14.05,0:04:17.06,Default,,0000,0000,0000,,Аняр!
Dialogue: 0,0:04:17.06,0:04:19.03,Default,,0000,0000,0000,,Өсу!
Dialogue: 0,0:04:23.06,0:04:25.03,Default,,0000,0000,0000,,Хааа~
Dialogue: 0,0:04:29.07,0:04:33.01,Default,,0000,0000,0000,,Тексеріңіз... Мен оны бұлай қия алмаймын.
Dialogue: 0,0:04:33.01,0:04:35.01,Default,,0000,0000,0000,,Мен олардың көп екеніне сене алар емеспін...
Dialogue: 0,0:04:35.01,0:04:37.01,Default,,0000,0000,0000,,Бірте-бірте жасаудан басқа амалымыз жоқ.
Dialogue: 0,0:04:37.01,0:04:40.01,Default,,0000,0000,0000,,Қарғыс атсын! Бұл сәулелік мылтық деген не?
Dialogue: 0,0:04:40.01,0:04:42.98,Default,,0000,0000,0000,,Маған сайян
Dialogue: 0,0:04:40.01,0:04:42.98,Default,,0000,0000,0000,,Бұл жұмыс істемейді!
Dialogue: 0,0:04:45.02,0:04:46.99,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:04:50.02,0:04:52.03,Default,,0000,0000,0000,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:04:52.03,0:04:54.03,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:04:54.03,0:04:56.00,Default,,0000,0000,0000,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,0:04:58.03,0:05:01.03,Default,,0000,0000,0000,,Ах... Арх!
Dialogue: 0,0:05:01.03,0:05:05.04,Default,,0000,0000,0000,,Сәлем! Сенімен бәрі жақсы ма?
Dialogue: 0,0:05:05.04,0:05:08.04,Default,,0000,0000,0000,,Ка… Какарот….
Dialogue: 0,0:05:08.04,0:05:11.04,Default,,0000,0000,0000,,Ах... бұл қате... сізде әлі бар ма?
Dialogue: 0,0:05:11.04,0:05:15.05,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:11.04,0:05:15.05,Default,,0000,0000,0000,,Фуккасуши
Dialogue: 0,0:05:11.04,0:05:15.05,Default,,0000,0000,0000,,Ах... сіз қайта тірілу қатесін айтасыз ба?
Dialogue: 0,0:05:15.05,0:05:17.05,Default,,0000,0000,0000,,Міне, келдіңіз.
Dialogue: 0,0:05:17.05,0:05:19.05,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:05:19.05,0:05:21.02,Default,,0000,0000,0000,,Күткендей, маған беріңіз.
Dialogue: 0,0:05:25.06,0:05:27.03,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:05:30.06,0:05:35.00,Default,,0000,0000,0000,,Мына қарғыс атқыр қаншықтар!
Dialogue: 0,0:05:30.06,0:05:35.00,Default,,0000,0000,0000,,Осылай ат!
Dialogue: 0,0:05:35.00,0:05:40.01,Default,,0000,0000,0000,,Өйткені бұл баланың денесі.
Dialogue: 0,0:05:35.00,0:05:40.01,Default,,0000,0000,0000,,Бұл қиын сияқты.
Dialogue: 0,0:05:40.01,0:05:42.01,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:05:42.01,0:05:46.01,Default,,0000,0000,0000,,Сол жігіттерден күткендей
Dialogue: 0,0:05:42.01,0:05:46.01,Default,,0000,0000,0000,,Біздің қолымыздан келмейтін сияқты. ➡
Dialogue: 0,0:05:46.01,0:05:50.02,Default,,0000,0000,0000,,Бұл Намекиан
Dialogue: 0,0:05:46.01,0:05:50.02,Default,,0000,0000,0000,,Жерде болған адам. ➡
Dialogue: 0,0:05:50.02,0:05:55.02,Default,,0000,0000,0000,,Бұл қыз үшінші жын әлемінің баласы.
Dialogue: 0,0:05:50.02,0:05:55.02,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:05:55.02,0:05:59.03,Default,,0000,0000,0000,,Бұл жігіт шығар
Dialogue: 0,0:05:55.02,0:05:59.03,Default,,0000,0000,0000,,Бұл үшінші жын әлемінен шыққан.
Dialogue: 0,0:05:59.03,0:06:03.03,Default,,0000,0000,0000,,Мені кешіріңіз!
Dialogue: 0,0:06:03.03,0:06:06.03,Default,,0000,0000,0000,,...
Dialogue: 0,0:06:03.03,0:06:06.03,Default,,0000,0000,0000,,Не ол?
Dialogue: 0,0:06:06.03,0:06:09.04,Default,,0000,0000,0000,,Бұл жігіттің...белбеу...
Dialogue: 0,0:06:09.04,0:06:11.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:13.04,0:06:16.01,Default,,0000,0000,0000,,О... Эй!
Dialogue: 0,0:06:18.04,0:06:22.05,Default,,0000,0000,0000,,Мына жігіттің белдігі
Dialogue: 0,0:06:18.04,0:06:22.05,Default,,0000,0000,0000,,Тоғада не бар?
Dialogue: 0,0:06:22.05,0:06:25.05,Default,,0000,0000,0000,,Бұл үшінші көз емес пе? ?
Dialogue: 0,0:06:22.05,0:06:25.05,Default,,0000,0000,0000,,Үшінші көз?
Dialogue: 0,0:06:25.05,0:06:28.05,Default,,0000,0000,0000,,Бұл аңызға айналған үшінші көз ме?
Dialogue: 0,0:06:28.05,0:06:31.02,Default,,0000,0000,0000,,Мен бұған сенбеймін...
Dialogue: 0,0:06:36.00,0:06:39.00,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:36.00,0:06:39.00,Default,,0000,0000,0000,,Өсу!
Dialogue: 0,0:06:39.00,0:06:42.00,Default,,0000,0000,0000,,Мен ойлағандай болды.
Dialogue: 0,0:06:42.00,0:06:45.00,Default,,0000,0000,0000,,Аһ!
Dialogue: 0,0:06:42.00,0:06:45.00,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:06:45.00,0:06:48.01,Default,,0000,0000,0000,,Хмф! Хаа!
Dialogue: 0,0:06:45.00,0:06:48.01,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:06:48.01,0:06:50.01,Default,,0000,0000,0000,,Аһ!
Dialogue: 0,0:06:50.01,0:06:53.01,Default,,0000,0000,0000,,Сондай-ақ... бұл енді жақсы емес.
Dialogue: 0,0:06:53.01,0:06:56.98,Default,,0000,0000,0000,,То... Қаш!
Dialogue: 0,0:07:01.02,0:07:04.02,Default,,0000,0000,0000,,О...
Dialogue: 0,0:07:04.02,0:07:07.03,Default,,0000,0000,0000,,Сіз шыға аласыз!
Dialogue: 0,0:07:07.03,0:07:10.03,Default,,0000,0000,0000,,Ах~ ақыры шешілді деп ойлаймын.
Dialogue: 0,0:07:10.03,0:07:13.03,Default,,0000,0000,0000,,Эй, мен ештеңе істеп жатқан жоқпын.
Dialogue: 0,0:07:10.03,0:07:13.03,Default,,0000,0000,0000,,Бастық болмаңыз.
Dialogue: 0,0:07:13.03,0:07:17.04,Default,,0000,0000,0000,,Енді сіз қозғала аласыз.
Dialogue: 0,0:07:17.04,0:07:21.01,Default,,0000,0000,0000,,Мына жерде Тамагами бар.
Dialogue: 0,0:07:17.04,0:07:21.01,Default,,0000,0000,0000,,Гомардың патша сарайы бар.
Dialogue: 0,0:07:33.99,0:07:35.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:38.99,0:07:40.99,Default,,0000,0000,0000,,Жау Опал аймағына қарай бет алды!
Dialogue: 0,0:07:40.99,0:07:45.00,Default,,0000,0000,0000,,🔊 (Жоғарғы) Постыңызды дереу алыңыз!
Dialogue: 0,0:07:40.99,0:07:45.00,Default,,0000,0000,0000,,Жау Опал аймағына қарай бет алды!
Dialogue: 0,0:07:45.00,0:07:46.97,Default,,0000,0000,0000,,Мен мұны сізге қалдырамын.
Dialogue: 0,0:07:45.00,0:07:46.97,Default,,0000,0000,0000,,О!
Dialogue: 0,0:07:50.00,0:07:52.67,Default,,0000,0000,0000,,Үшінші көз анық➡
Dialogue: 0,0:07:52.67,0:07:56.01,Default,,0000,0000,0000,,Біраз уақыттан бері
Dialogue: 0,0:07:52.67,0:07:56.01,Default,,0000,0000,0000,,Ол жоқ болуы керек...
Dialogue: 0,0:07:56.01,0:07:58.01,Default,,0000,0000,0000,,Мен оны бұрын көргенмін.
Dialogue: 0,0:07:58.01,0:08:05.02,Default,,0000,0000,0000,,Баяғыда Ұлы жын патша Абра
Dialogue: 0,0:07:58.01,0:08:05.02,Default,,0000,0000,0000,,Маңдайымда болған.
Dialogue: 0,0:08:05.02,0:08:08.02,Default,,0000,0000,0000,,Дәл солай.
Dialogue: 0,0:08:08.02,0:08:11.02,Default,,0000,0000,0000,,Бұл осылай болды!
Dialogue: 0,0:08:11.02,0:08:14.03,Default,,0000,0000,0000,,Көздер әдетте осылай көрінеді, солай емес пе?
Dialogue: 0,0:08:14.03,0:08:17.03,Default,,0000,0000,0000,,Шамамен неге
Dialogue: 0,0:08:14.03,0:08:17.03,Default,,0000,0000,0000,,Бұл адамда бар ма?
Dialogue: 0,0:08:17.03,0:08:19.03,Default,,0000,0000,0000,,біз қайта орала аламыз.
Dialogue: 0,0:08:19.03,0:08:22.03,Default,,0000,0000,0000,,Егер солай болса
Dialogue: 0,0:08:19.03,0:08:22.03,Default,,0000,0000,0000,,Біз тез әрекет етуіміз керек.
Dialogue: 0,0:08:22.03,0:08:24.04,Default,,0000,0000,0000,,Әй, Дегесу! ➡
Dialogue: 0,0:08:24.04,0:08:27.04,Default,,0000,0000,0000,,Сол белбеу
Dialogue: 0,0:08:24.04,0:08:27.04,Default,,0000,0000,0000,,Барып алыңыз!
Dialogue: 0,0:08:27.04,0:08:30.04,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:08:27.04,0:08:30.04,Default,,0000,0000,0000,,Ешкімнің байқамауына жол бермеңіз.
Dialogue: 0,0:08:30.04,0:08:33.05,Default,,0000,0000,0000,,Жақсы! ?
Dialogue: 0,0:08:30.04,0:08:33.05,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:33.05,0:08:37.05,Default,,0000,0000,0000,,Бірақ қалай?
Dialogue: 0,0:08:33.05,0:08:37.05,Default,,0000,0000,0000,,Хмм…. ➡
Dialogue: 0,0:08:37.05,0:08:40.05,Default,,0000,0000,0000,,Сіз ақылдысыз ба? ➡
Dialogue: 0,0:08:40.05,0:08:44.02,Default,,0000,0000,0000,,Ойлан!
Dialogue: 0,0:08:40.05,0:08:44.02,Default,,0000,0000,0000,,Жарайды... Керемет.
Dialogue: 0,0:08:50.06,0:08:52.03,Default,,0000,0000,0000,,Нихи.
Dialogue: 0,0:08:55.07,0:08:59.07,Default,,0000,0000,0000,,[Осы жерде түсіндірейін]
Dialogue: 0,0:08:59.07,0:09:02.07,Default,,0000,0000,0000,,[Үшінші көз
Dialogue: 0,0:08:59.07,0:09:02.07,Default,,0000,0000,0000,,Басқаша айтқанда, үшінші көз дегеніміз не➡
Dialogue: 0,0:09:02.07,0:09:06.08,Default,,0000,0000,0000,,Ұлы жын әлемінің кезекті ұлы жын патшалары
Dialogue: 0,0:09:02.07,0:09:06.08,Default,,0000,0000,0000,,Маңдайыма қойдым➡
Dialogue: 0,0:09:06.08,0:09:10.75,Default,,0000,0000,0000,,Күш пен қуатты тудырыңыз
Dialogue: 0,0:09:06.08,0:09:10.75,Default,,0000,0000,0000,,Қорқынышты сиқырлы күшке ие➡
Dialogue: 0,0:09:10.75,0:09:14.75,Default,,0000,0000,0000,,Оны Ұлы Жын патшаның символы деп те айтуға болады.
Dialogue: 0,0:09:10.75,0:09:14.75,Default,,0000,0000,0000,,Көз]
Dialogue: 0,0:09:14.75,0:09:21.09,Default,,0000,0000,0000,,[Үлкен күш қажет болғанда
Dialogue: 0,0:09:14.75,0:09:21.09,Default,,0000,0000,0000,,Үшінші көзді кисеңіз➡
Dialogue: 0,0:09:21.09,0:09:24.10,Default,,0000,0000,0000,,Құрамында орасан зор сиқырлы күш бар➡
Dialogue: 0,0:09:24.10,0:09:27.10,Default,,0000,0000,0000,,Бұл не дүние?
Dialogue: 0,0:09:24.10,0:09:27.10,Default,,0000,0000,0000,,Адам сенгісіз күш➡
Dialogue: 0,0:09:27.10,0:09:31.04,Default,,0000,0000,0000,,］
Dialogue: 0,0:09:31.04,0:09:36.04,Default,,0000,0000,0000,,[Бірақ алдыңғы буын
Dialogue: 0,0:09:31.04,0:09:36.04,Default,,0000,0000,0000,,Ұлы жын патша Абраның дәуірінде➡
Dialogue: 0,0:09:36.04,0:09:38.04,Default,,0000,0000,0000,,Біреу ұрлаған➡
Dialogue: 0,0:09:38.04,0:09:42.01,Default,,0000,0000,0000,,Мен қайда жүргенімді қадағалай алмай қалдым.
Dialogue: 0,0:09:38.04,0:09:42.01,Default,,0000,0000,0000,,болды]
Dialogue: 0,0:09:45.05,0:09:49.72,Default,,0000,0000,0000,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:09:45.05,0:09:49.72,Default,,0000,0000,0000,,Ұлы жын патша Абра қазір жоқ.
Dialogue: 0,0:09:49.72,0:09:55.06,Default,,0000,0000,0000,,Мен қауіпсіздікті қамтамасыз етемін.
Dialogue: 0,0:09:49.72,0:09:55.06,Default,,0000,0000,0000,,Үшінші көз сейфте.
Dialogue: 0,0:09:55.06,0:09:57.06,Default,,0000,0000,0000,,Үшінші көзді алып тастасаңыз➡
Dialogue: 0,0:09:57.06,0:10:01.07,Default,,0000,0000,0000,,Тіпті оны табу қиын үшінші жын әлемінде де
Dialogue: 0,0:09:57.06,0:10:01.07,Default,,0000,0000,0000,,Барынша тез қашыңыз. ➡
Dialogue: 0,0:10:01.07,0:10:04.07,Default,,0000,0000,0000,,Мен сізге біраз уақыттан кейін қайта хабарласамын.
Dialogue: 0,0:10:04.07,0:10:08.04,Default,,0000,0000,0000,,Кілт!
Dialogue: 0,0:10:04.07,0:10:08.04,Default,,0000,0000,0000,,Түсіндім, Дабура мырза.
Dialogue: 0,0:10:13.08,0:10:16.05,Default,,0000,0000,0000,,Сықырлау... Сықырлау.
Dialogue: 0,0:10:26.76,0:10:29.10,Default,,0000,0000,0000,,🔊 (Дабыл)
Dialogue: 0,0:10:26.76,0:10:29.10,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:10:29.10,0:10:31.06,Default,,0000,0000,0000,,(Стефани) Маған оның бәрі бір! Ең бастысы —
Dialogue: 0,0:10:33.03,0:10:35.00,Default,,0000,0000,0000,,Кики!
Dialogue: 0,0:10:41.04,0:10:44.01,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:10:53.05,0:10:56.06,Default,,0000,0000,0000,,Бұл жұмыс істеді.
Dialogue: 0,0:10:56.06,0:11:00.06,Default,,0000,0000,0000,,Кики Кики….
Dialogue: 0,0:11:00.06,0:11:03.06,Default,,0000,0000,0000,,Ки! ?
Dialogue: 0,0:11:00.06,0:11:03.06,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:11:03.06,0:11:06.03,Default,,0000,0000,0000,,Ки! !
Dialogue: 0,0:11:09.07,0:11:11.07,Default,,0000,0000,0000,,🔊 (байланыс дыбысы)
Dialogue: 0,0:11:09.07,0:11:11.07,Default,,0000,0000,0000,,Иә? ➡
Dialogue: 0,0:11:11.07,0:11:13.07,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:11:13.07,0:11:15.07,Default,,0000,0000,0000,,🔊
Dialogue: 0,0:11:13.07,0:11:15.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:15.07,0:11:19.08,Default,,0000,0000,0000,,Шүкір... не болды?
Dialogue: 0,0:11:19.08,0:11:21.08,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:11:21.08,0:11:26.09,Default,,0000,0000,0000,,Енді үшінші көз
Dialogue: 0,0:11:21.08,0:11:26.09,Default,,0000,0000,0000,,Бұл оның жоғалғанын өзгертпейді.
Dialogue: 0,0:11:26.09,0:11:31.02,Default,,0000,0000,0000,,[үлкен күшке ие]
Dialogue: 0,0:11:26.09,0:11:31.02,Default,,0000,0000,0000,,Ұлы жын патша Абра –➡
Dialogue: 0,0:11:31.02,0:11:36.03,Default,,0000,0000,0000,,Үшінші көздің жоғалуымен
Dialogue: 0,0:11:31.02,0:11:36.03,Default,,0000,0000,0000,,Ұлы Дабурадан жеңілген]
Dialogue: 0,0:11:36.03,0:11:41.03,Default,,0000,0000,0000,,[Алайда ол Ұлы Жын патшаның тағын тартып алды.
Dialogue: 0,0:11:36.03,0:11:41.03,Default,,0000,0000,0000,,Даймау Дабура да➡
Dialogue: 0,0:11:41.03,0:11:44.04,Default,,0000,0000,0000,,Сиқыр
Dialogue: 0,0:11:41.03,0:11:44.04,Default,,0000,0000,0000,,Ақырында Маджин Буудан жеңілді➡
Dialogue: 0,0:11:44.04,0:11:46.04,Default,,0000,0000,0000,,Жаңа ұлы жынның орны ➡
Dialogue: 0,0:11:46.04,0:11:50.01,Default,,0000,0000,0000,,Ұлы жын патшаның орынбасары Гомар,
Dialogue: 0,0:11:46.04,0:11:50.01,Default,,0000,0000,0000,,Мен тағайындалдым]
Dialogue: 0,0:11:53.05,0:11:57.05,Default,,0000,0000,0000,,[Біраз уақыттан кейін...]
Dialogue: 0,0:11:57.05,0:11:59.02,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:12:03.06,0:12:06.03,Default,,0000,0000,0000,,О...
Dialogue: 0,0:12:08.06,0:12:10.06,Default,,0000,0000,0000,,О...!
Dialogue: 0,0:12:10.06,0:12:15.07,Default,,0000,0000,0000,,[Осылайша, шайтанның үшінші көзі
Dialogue: 0,0:12:10.06,0:12:15.07,Default,,0000,0000,0000,,Белдік ілгегі ретінде➡
Dialogue: 0,0:12:15.07,0:12:19.04,Default,,0000,0000,0000,,Бел айналасында
Dialogue: 0,0:12:15.07,0:12:19.04,Default,,0000,0000,0000,,Ол көрсетілуі керек еді]
Dialogue: 0,0:12:23.08,0:12:25.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:25.08,0:12:27.05,Default,,0000,0000,0000,,Бұл патша сарайы.
Dialogue: 0,0:12:37.02,0:12:41.03,Default,,0000,0000,0000,,А... Иә?
Dialogue: 0,0:12:41.03,0:12:43.03,Default,,0000,0000,0000,,Hmph.
Dialogue: 0,0:12:43.03,0:12:46.03,Default,,0000,0000,0000,,Хмм... сен осындасың.
Dialogue: 0,0:12:46.03,0:12:48.03,Default,,0000,0000,0000,,Hmph.
Dialogue: 0,0:12:48.03,0:12:52.04,Default,,0000,0000,0000,,♬~
Dialogue: 0,0:12:52.04,0:12:54.01,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:12:56.04,0:12:59.01,Default,,0000,0000,0000,,Уау! !
Dialogue: 0,0:13:27.04,0:13:30.98,Default,,0000,0000,0000,,А, қараңдаршы! Менің домалақ құлақ балам бар!
Dialogue: 0,0:13:30.98,0:13:33.98,Default,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:13:33.98,0:13:35.98,Default,,0000,0000,0000,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:13:33.98,0:13:35.98,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:13:35.98,0:13:37.98,Default,,0000,0000,0000,,Бұрынғыдан да жау көп.
Dialogue: 0,0:13:37.98,0:13:40.99,Default,,0000,0000,0000,,Кешіріңіз...
Dialogue: 0,0:13:40.99,0:13:43.99,Default,,0000,0000,0000,,Сәлем, ата.
Dialogue: 0,0:13:40.99,0:13:43.99,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:13:43.99,0:13:45.99,Default,,0000,0000,0000,,Анна Шилд
Dialogue: 0,0:13:43.99,0:13:45.99,Default,,0000,0000,0000,,Өйткені мен оны жаңа ғана жасадым➡
Dialogue: 0,0:13:45.99,0:13:48.99,Default,,0000,0000,0000,,Қандай да бір жол бар ма?
Dialogue: 0,0:13:48.99,0:13:53.00,Default,,0000,0000,0000,,Хехехе... Мен қартайдым➡
Dialogue: 0,0:13:53.00,0:13:56.00,Default,,0000,0000,0000,,Сіздің тілектеріңізді орындауға көмектесу
Dialogue: 0,0:13:53.00,0:13:56.00,Default,,0000,0000,0000,,Жаңа ғана келді.
Dialogue: 0,0:13:56.00,0:14:00.01,Default,,0000,0000,0000,,Қандай да бір түрде өзіңізді кінәлаңыз.
Dialogue: 0,0:13:56.00,0:14:00.01,Default,,0000,0000,0000,,Тексеру….
Dialogue: 0,0:14:00.01,0:14:03.01,Default,,0000,0000,0000,,Хмм… мм….
Dialogue: 0,0:14:03.01,0:14:07.01,Default,,0000,0000,0000,,⚟Мм.
Dialogue: 0,0:14:03.01,0:14:07.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:07.01,0:14:10.02,Default,,0000,0000,0000,,⚟Сол белбеуіңіз….
Dialogue: 0,0:14:10.02,0:14:13.02,Default,,0000,0000,0000,,Керемет көрінеді.
Dialogue: 0,0:14:13.02,0:14:16.02,Default,,0000,0000,0000,,Жақсы. Бұл менің сүйіктім.
Dialogue: 0,0:14:16.02,0:14:19.02,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:14:19.02,0:14:22.03,Default,,0000,0000,0000,,Маған берсеңіз➡
Dialogue: 0,0:14:22.03,0:14:26.03,Default,,0000,0000,0000,,Мен мұны істеймін.
Dialogue: 0,0:14:26.03,0:14:30.04,Default,,0000,0000,0000,,Мені ақымақ деп айт. Маған бұл керек емес.
Dialogue: 0,0:14:30.04,0:14:34.97,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:14:30.04,0:14:34.97,Default,,0000,0000,0000,,Оны сол қалпаққа айырбастауға болады.
Dialogue: 0,0:14:34.97,0:14:37.98,Default,,0000,0000,0000,,Не? қалпақ?
Dialogue: 0,0:14:37.98,0:14:40.98,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:14:40.98,0:14:42.98,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:14:42.98,0:14:44.98,Default,,0000,0000,0000,,Ухё~.
Dialogue: 0,0:14:44.98,0:14:47.95,Default,,0000,0000,0000,,Керемет.
Dialogue: 0,0:14:49.99,0:14:51.99,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:14:51.99,0:14:54.99,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:14:54.99,0:15:00.97,Default,,0000,0000,0000,,Жақсы өтті, бірақ...
Dialogue: 0,0:14:54.99,0:15:00.97,Default,,0000,0000,0000,,Мені бір нәрсе мазалайды.
Dialogue: 0,0:15:04.00,0:15:09.01,Default,,0000,0000,0000,,Менің қайта қалпына келу қабілетім бар.
Dialogue: 0,0:15:04.00,0:15:09.01,Default,,0000,0000,0000,,Мен бәрін бірден тазалаймын!
Dialogue: 0,0:15:09.01,0:15:13.01,Default,,0000,0000,0000,,Бұл жақсы. Сондай күндердің бірі
Dialogue: 0,0:15:09.01,0:15:13.01,Default,,0000,0000,0000,,Олардың доптары таусылып қалды.
Dialogue: 0,0:15:13.01,0:15:15.01,Default,,0000,0000,0000,,Тоқта.
Dialogue: 0,0:15:15.01,0:15:21.02,Default,,0000,0000,0000,,Қанша регенерация қабілеті бар болса да
Dialogue: 0,0:15:15.01,0:15:21.02,Default,,0000,0000,0000,,Өмірлік маңызды нүктеге соқса, бітті.
Dialogue: 0,0:15:21.02,0:15:24.02,Default,,0000,0000,0000,,Өкінішке орай, бұл сәулелік мылтық➡
Dialogue: 0,0:15:24.02,0:15:27.03,Default,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:15:24.02,0:15:27.03,Default,,0000,0000,0000,,10 күн бойы теруді жалғастыра аласыз.
Dialogue: 0,0:15:27.03,0:15:28.99,Default,,0000,0000,0000,,Е! ?
Dialogue: 0,0:15:35.03,0:15:48.05,Default,,0000,0000,0000,,(Ку Дудың ұйқысы)
Dialogue: 0,0:15:48.05,0:15:50.05,Default,,0000,0000,0000,,Жақында. ➡
Dialogue: 0,0:15:50.05,0:15:55.05,Default,,0000,0000,0000,,Барлығы жоспар бойынша жүріп жатыр. Хехе….
Dialogue: 0,0:15:55.05,0:15:58.06,Default,,0000,0000,0000,,Хэхехе...
Dialogue: 0,0:15:58.06,0:16:03.03,Default,,0000,0000,0000,,(Ку Дудың ұйқысы)
Dialogue: 0,0:16:05.06,0:16:10.07,Default,,0000,0000,0000,,Боқ... Мен енді шыдай алмаймын.
Dialogue: 0,0:16:05.06,0:16:10.07,Default,,0000,0000,0000,,Барлығын бірден тазалаудан басқа амалымыз жоқ!
Dialogue: 0,0:16:10.07,0:16:12.07,Default,,0000,0000,0000,,Мен ойлағандай болды.
Dialogue: 0,0:16:12.07,0:16:15.04,Default,,0000,0000,0000,,Ой~!
Dialogue: 0,0:16:17.08,0:16:19.75,Default,,0000,0000,0000,,Сәлем….
Dialogue: 0,0:16:17.08,0:16:19.75,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:16:19.75,0:16:21.75,Default,,0000,0000,0000,,Ой!
Dialogue: 0,0:16:21.75,0:16:23.75,Default,,0000,0000,0000,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:16:21.75,0:16:23.75,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:16:23.75,0:16:26.09,Default,,0000,0000,0000,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:16:26.09,0:16:29.09,Default,,0000,0000,0000,,Жақсы! Міне солай!
Dialogue: 0,0:16:29.09,0:16:31.02,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:16:31.02,0:16:33.03,Default,,0000,0000,0000,,⚟ (дыбыс)
Dialogue: 0,0:16:33.03,0:16:36.03,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:36.03,0:16:38.00,Default,,0000,0000,0000,,⚟ (дыбыс)
Dialogue: 0,0:16:36.03,0:16:38.00,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:16:40.03,0:16:42.00,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:47.04,0:16:49.01,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:17:02.05,0:17:05.02,Default,,0000,0000,0000,,Не... Бұл не!
Dialogue: 0,0:17:15.07,0:17:17.04,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:17:26.08,0:17:28.05,Default,,0000,0000,0000,,Ату!
Dialogue: 0,0:17:30.08,0:17:35.02,Default,,0000,0000,0000,,Уау! !
Dialogue: 0,0:17:35.02,0:17:38.02,Default,,0000,0000,0000,,Немесе... Денем жансызданып кетті.
Dialogue: 0,0:17:38.02,0:17:39.99,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:17:45.03,0:17:47.00,Default,,0000,0000,0000,,«Құрғап қалған болар ма?»
Dialogue: 0,0:17:53.04,0:17:55.04,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:17:55.04,0:18:07.05,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:07.05,0:18:09.05,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:09.05,0:18:12.02,Default,,0000,0000,0000,,Ату!
Dialogue: 0,0:18:19.06,0:18:23.07,Default,,0000,0000,0000,,Уау! !
Dialogue: 0,0:18:23.07,0:18:26.07,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:18:26.07,0:18:28.04,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:18:32.01,0:18:33.98,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:18:36.01,0:18:41.02,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:18:41.02,0:18:43.02,Default,,0000,0000,0000,,Хэ-хэ-хэ….
Dialogue: 0,0:18:43.02,0:18:46.02,Default,,0000,0000,0000,,Әкелер!
Dialogue: 0,0:18:43.02,0:18:46.02,Default,,0000,0000,0000,,О...
Dialogue: 0,0:18:46.02,0:18:59.04,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:59.04,0:19:02.01,Default,,0000,0000,0000,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:18:59.04,0:19:02.01,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:19:14.05,0:19:18.02,Default,,0000,0000,0000,,Әке!
Dialogue: 0,0:19:14.05,0:19:18.02,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:26.06,0:19:28.03,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:35.01,0:19:38.98,Default,,0000,0000,0000,,Хе хе хе.
Dialogue: 0,0:19:42.01,0:19:44.02,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:19:44.02,0:19:46.02,Default,,0000,0000,0000,,Әке! барлығы!
Dialogue: 0,0:19:46.02,0:19:49.02,Default,,0000,0000,0000,,О!
Dialogue: 0,0:19:49.02,0:19:52.02,Default,,0000,0000,0000,,Мен сені жабайы жіберемін!
Dialogue: 0,0:19:52.02,0:19:55.03,Default,,0000,0000,0000,,Хохо~!
Dialogue: 0,0:19:55.03,0:19:57.03,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:19:57.03,0:20:00.00,Default,,0000,0000,0000,,Біз де кеттік!
Dialogue: 0,0:19:57.03,0:20:00.00,Default,,0000,0000,0000,,О!
Dialogue: 0,0:20:02.03,0:20:04.04,Default,,0000,0000,0000,,Хаха~!
Dialogue: 0,0:20:04.04,0:20:06.00,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:20:09.04,0:20:11.01,Default,,0000,0000,0000,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:20:19.05,0:20:22.05,Default,,0000,0000,0000,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:20:19.05,0:20:22.05,Default,,0000,0000,0000,,Толқын өзгерді.
Dialogue: 0,0:20:22.05,0:20:24.02,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:30.06,0:20:32.00,Default,,0000,0000,0000,,Аһ!
Dialogue: 0,0:20:30.06,0:20:32.00,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:20:32.00,0:20:34.00,Default,,0000,0000,0000,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:20:34.00,0:20:37.00,Default,,0000,0000,0000,,Хехе….
Dialogue: 0,0:20:37.00,0:20:40.01,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:20:37.00,0:20:40.01,Default,,0000,0000,0000,,Аһ!
Dialogue: 0,0:20:40.01,0:20:42.01,Default,,0000,0000,0000,,Хмф! ➡
Dialogue: 0,0:20:42.01,0:20:45.01,Default,,0000,0000,0000,,Хамф!
Dialogue: 0,0:20:42.01,0:20:45.01,Default,,0000,0000,0000,,Э? Естімеймін.
Dialogue: 0,0:20:45.01,0:20:47.98,Default,,0000,0000,0000,,Жасайық, патша!
Dialogue: 0,0:20:45.01,0:20:47.98,Default,,0000,0000,0000,,О!
Dialogue: 0,0:20:53.02,0:20:55.02,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:20:55.02,0:20:57.02,Default,,0000,0000,0000,,Арх! Апыр-ай!
Dialogue: 0,0:20:57.02,0:20:59.99,Default,,0000,0000,0000,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,0:20:57.02,0:20:59.99,Default,,0000,0000,0000,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:21:04.03,0:21:06.03,Default,,0000,0000,0000,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,0:21:06.03,0:21:08.03,Default,,0000,0000,0000,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:21:06.03,0:21:08.03,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:21:08.03,0:21:10.04,Default,,0000,0000,0000,,Бұл – Демоноруқтар корпусы! Мұнда ойланбастан кіруге болмайды!
Dialogue: 0,0:21:10.04,0:21:13.04,Default,,0000,0000,0000,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:21:13.04,0:21:15.04,Default,,0000,0000,0000,,Бұл – Демоноруқтар корпусы! Мұнда ойланбастан кіруге болмайды!
Dialogue: 0,0:21:13.04,0:21:15.04,Default,,0000,0000,0000,,Аһ!
Dialogue: 0,0:21:15.04,0:21:17.04,Default,,0000,0000,0000,,Бұл тек алдын алу тексерісі ғана
Dialogue: 0,0:21:17.04,0:21:19.01,Default,,0000,0000,0000,,Бұл – Демоноруқтар корпусы! Мұнда ойланбастан кіруге болмайды!
Dialogue: 0,0:21:21.05,0:21:24.02,Default,,0000,0000,0000,,Қабыл ал! Алақай!
Dialogue: 0,0:21:26.05,0:21:29.05,Default,,0000,0000,0000,,Ха! Ха! Дааа!
Dialogue: 0,0:21:29.05,0:21:30.99,Default,,0000,0000,0000,,Рұқсатсыз маған қарама.
Dialogue: 0,0:21:30.99,0:21:35.96,Default,,0000,0000,0000,,Ах! !
Dialogue: 0,0:21:42.00,0:21:45.00,Default,,0000,0000,0000,,Сонымен… солай….
Dialogue: 0,0:21:45.00,0:21:48.01,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:21:48.01,0:21:53.01,Default,,0000,0000,0000,,Куу… Куу….
Dialogue: 0,0:21:53.01,0:21:55.01,Default,,0000,0000,0000,,Бұл жаман.
Dialogue: 0,0:21:55.01,0:21:58.02,Default,,0000,0000,0000,,Иә, мен мұны білемін!
Dialogue: 0,0:21:58.02,0:22:01.02,Default,,0000,0000,0000,,Токусен
Dialogue: 0,0:21:58.02,0:22:01.02,Default,,0000,0000,0000,,Бірақ... әлі де арнайы жасақ бар.
Dialogue: 0,0:22:01.02,0:22:02.99,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:22:05.02,0:22:07.99,Default,,0000,0000,0000,,Жақсы... бұл дұрыс.
Dialogue: 0,0:22:21.04,0:22:23.01,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:22:25.04,0:22:28.05,Default,,0000,0000,0000,,Жасай беріңдер, патшалар!
Dialogue: 0,0:22:28.05,0:22:31.98,Default,,0000,0000,0000,,Әке, уақыт өте жақсы болды!
Dialogue: 0,0:22:31.98,0:22:34.99,Default,,0000,0000,0000,,Хэхе... жақсы.
Dialogue: 0,0:22:34.99,0:22:37.99,Default,,0000,0000,0000,,We too
Dialogue: 0,0:22:34.99,0:22:37.99,Default,,0000,0000,0000,,Бұл аздап көмектескен сияқты.
Dialogue: 0,0:22:37.99,0:22:41.99,Default,,0000,0000,0000,,Ахххххх...!
Dialogue: 0,0:22:37.99,0:22:41.99,Default,,0000,0000,0000,,Хэхехе... хехехе....
Dialogue: 0,0:22:41.99,0:22:45.96,Default,,0000,0000,0000,,Ахххххх...!
Dialogue: 0,0:22:50.00,0:22:59.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:01.48,0:23:07.48,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory