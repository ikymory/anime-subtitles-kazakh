Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.04,0:00:06.04,Default,,0,0,0,,[Айдаһар шары дегеніміз не?➡
Dialogue: 0,0:00:06.04,0:00:09.71,Default,,0,0,0,,7 бөлікті жинап, құпия сөзді айт➡
Dialogue: 0,0:00:09.71,0:00:13.05,Ruby,,0,0,0,,Шенрон
Dialogue: 0,0:00:09.71,0:00:13.05,Default,,0,0,0,,Шенрон деген айдаһар шығады➡ дейді
Dialogue: 0,0:00:13.05,0:00:17.05,Default,,0,0,0,,Бұл жұмбақ доп]
Dialogue: 0,0:00:17.05,0:00:23.06,Default,,0,0,0,,[Шенроннан сұрасаңыз, кез келген тілек орындалады]
Dialogue: 0,0:00:23.06,0:00:28.06,Ruby,,0,0,0,,Гоку
Dialogue: 0,0:00:23.06,0:00:28.06,Ruby,,0,0,0,,Сонымен
Dialogue: 0,0:00:23.06,0:00:28.06,Default,,0,0,0,,[Бұл адам Сон Гоку сабырлы болып көрінсе де➡
Dialogue: 0,0:00:28.06,0:00:33.03,Default,,0,0,0,,Ол ерекше күші бар ең күшті жауынгер]
Dialogue: 0,0:00:35.07,0:00:37.07,Default,,0,0,0,,[Таудың тереңінде тұратын бала кезімде➡
Dialogue: 0,0:00:37.07,0:00:40.07,Default,,0,0,0,,Айдаһар допты іздеңіз және достарыңызбен танысыңыз➡
Dialogue: 0,0:00:40.07,0:00:46.08,Default,,0,0,0,,Бірге шытырман оқиғаларға бару және ересектерге айналу]
Dialogue: 0,0:00:46.08,0:00:52.09,Default,,0,0,0,,[Бір кездері, Сайандар, ғарыштан келген жауыз жауынгер нәсіл➡
Dialogue: 0,0:00:52.09,0:00:56.09,Default,,0,0,0,,Шындығында, Гокудың шынайы тұлғасы да Сайян➡
Dialogue: 0,0:00:56.09,0:01:01.06,Default,,0,0,0,,Мен бала кезімде Жерге жіберілгенімді білемін]
Dialogue: 0,0:01:03.03,0:01:07.03,Default,,0,0,0,,[Жас денеде өмір бойы қалуға болады➡
Dialogue: 0,0:01:07.03,0:01:10.04,Default,,0,0,0,,Сайян сипаттамалары бар➡
Dialogue: 0,0:01:10.04,0:01:15.04,Default,,0,0,0,,Қазірдің өзінде мен көптеген қорқынышты жаулармен күресіп, өсіп жатырмын➡
Dialogue: 0,0:01:15.04,0:01:18.05,Default,,0,0,0,,Бұрынғы қарсыластарымен➡
Dialogue: 0,0:01:18.05,0:01:24.02,Default,,0,0,0,,Бүгін де біз жерді зұлымдық қолынан қорғауды жалғастырамыз.]
Dialogue: 0,0:01:41.03,0:01:47.01,Default,,0,0,0,,[Сол кезде Жер жаңа қауіпке тап болды]
Dialogue: 0,0:01:52.05,0:01:55.05,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:01:55.05,0:02:12.03,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:02:39.03,0:02:44.03,Default,,0,0,0,,Бабиди! Ол сондай айлакер! ➡
Dialogue: 0,0:02:44.03,0:02:47.03,Default,,0,0,0,,Дабура патшаны пайдалану.
Dialogue: 0,0:02:47.03,0:02:50.04,Default,,0,0,0,,Дегенмен, Ұлы Жын патшасы деп атауға болатын біреу бар➡
Dialogue: 0,0:02:50.04,0:02:54.04,Default,,0,0,0,,Бәбидидің бақсылығымен айла-шарғы жасау. ➡
Dialogue: 0,0:02:54.04,0:02:56.04,Default,,0,0,0,,Бұл өте аянышты.
Dialogue: 0,0:02:56.04,0:02:58.01,Default,,0,0,0,,...
Dialogue: 0,0:03:03.05,0:03:06.05,Default,,0,0,0,,Дабура Керемет емес пе? Сол жігіт.
Dialogue: 0,0:03:06.05,0:03:11.06,Ruby,,0,0,0,,Кайошин
Dialogue: 0,0:03:06.05,0:03:11.06,Ruby Spaced,,0,0,0,,Анкокумакай
Dialogue: 0,0:03:06.05,0:03:11.06,Default,,0,0,0,,Әрине. Өйткені, ол қараңғы жын әлемінің патшасы.
Dialogue: 0,0:03:11.06,0:03:17.06,Default,,0,0,0,,Ал... ол жындар әлемінің патшасы! ? Осындай дүние бар ма деп ойлаймын...
Dialogue: 0,0:03:17.06,0:03:19.07,Default,,0,0,0,,🔊Иә!
Dialogue: 0,0:03:19.07,0:03:23.07,Default,,0,0,0,,Қарашы, Дегесу! Бұл сенің ағаң емес пе?
Dialogue: 0,0:03:23.07,0:03:28.08,Default,,0,0,0,,Қарғыс атсын... Ол бұрынғыдай интрузивті.
Dialogue: 0,0:03:28.08,0:03:32.01,Default,,0,0,0,,Кай патша өте бастық сияқты...
Dialogue: 0,0:03:32.01,0:03:35.02,Default,,0,0,0,,Сіз шынымен адамдарға көмектесуді жоспарлап отырсыз ба?
Dialogue: 0,0:03:35.02,0:03:38.99,Default,,0,0,0,,Кішкене қараймыз ба?
Dialogue: 0,0:03:43.02,0:03:45.69,Default,,0,0,0,,Хехе.
Dialogue: 0,0:03:45.69,0:03:47.69,Default,,0,0,0,,Баккаяро….
Dialogue: 0,0:03:47.69,0:03:49.96,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:03:52.03,0:03:58.04,Default,,0,0,0,,Ей ей, сыртқы әлемде неге сондай күшті адамдар бар! ?
Dialogue: 0,0:03:58.04,0:04:01.04,Default,,0,0,0,,Мына жігіттер де жын ба?
Dialogue: 0,0:04:01.04,0:04:03.04,Default,,0,0,0,,Hmph.
Dialogue: 0,0:04:03.04,0:04:06.05,Default,,0,0,0,,Ааа! Қарғыс атқыр... Тааа!
Dialogue: 0,0:04:06.05,0:04:09.05,Default,,0,0,0,,Таа! Уау...
Dialogue: 0,0:04:09.05,0:04:12.05,Default,,0,0,0,,Жоқ, қараңызшы. ➡
Dialogue: 0,0:04:12.05,0:04:14.05,Default,,0,0,0,,Құлақтары дөңгелек.
Dialogue: 0,0:04:14.05,0:04:16.06,Default,,0,0,0,,Бірақ ол ауада ұшып келеді.
Dialogue: 0,0:04:16.06,0:04:19.03,Default,,0,0,0,,Және яааааааааааа!
Dialogue: 0,0:04:21.06,0:04:24.06,Default,,0,0,0,,Ол да қолынан жарық сәулесі тәрізді бірдеңе шығарады➡
Dialogue: 0,0:04:24.06,0:04:27.40,Default,,0,0,0,,Ол сиқырды да қолдана алатын сияқты.
Dialogue: 0,0:04:27.40,0:04:34.01,Default,,0,0,0,,(шығатын будың дыбысы)
Dialogue: 0,0:04:34.01,0:04:36.98,Default,,0,0,0,,Ақырында, Маджин Буу қайтып келді!
Dialogue: 0,0:04:42.02,0:04:44.02,Ruby Spaced,,0,0,0,,Күріш
Dialogue: 0,0:04:42.02,0:04:44.02,Default,,0,0,0,,Ах... а... (Гохан) А... аа... а...
Dialogue: 0,0:04:44.02,0:04:47.02,Default,,0,0,0,,Буу~!
Dialogue: 0,0:04:47.02,0:04:51.02,Default,,0,0,0,,Чи... Буу пайда болды! ➡
Dialogue: 0,0:04:51.02,0:04:52.99,Default,,0,0,0,,Хмф!
Dialogue: 0,0:04:55.03,0:04:58.03,Default,,0,0,0,,Бәбидидің сыртқы әлемі мен ұлы жын дүниесі шығар➡
Dialogue: 0,0:04:58.03,0:05:01.03,Default,,0,0,0,,Мен бүкіл әлемді билегім келеді!
Dialogue: 0,0:05:01.03,0:05:03.04,Default,,0,0,0,,Unnunu….
Dialogue: 0,0:05:03.04,0:05:06.04,Default,,0,0,0,,Тамақ ішу керек.
Dialogue: 0,0:05:06.04,0:05:08.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:12.05,0:05:18.05,Default,,0,0,0,,Гяаааааааааааааааааааааааааааааа...
Dialogue: 0,0:05:18.05,0:05:23.02,Default,,0,0,0,,Сәлем! Дабура жеңілді! Оңай...
Dialogue: 0,0:05:25.06,0:05:29.03,Default,,0,0,0,,Сіз енді Ұлы жын әлемінің патшасысыз.
Dialogue: 0,0:05:31.33,0:05:34.33,Default,,0,0,0,,Ni….
Dialogue: 0,0:05:34.33,0:05:38.00,Default,,0,0,0,,Жоқ, жоқ, жоқ... Мен бұған риза емеспін!
Dialogue: 0,0:05:38.00,0:05:43.01,Default,,0,0,0,,Бабидидің Маджин Буумен бірге қолданатын келесі нысанасы - біз!
Dialogue: 0,0:05:43.01,0:05:44.98,Default,,0,0,0,,Шынында да….
Dialogue: 0,0:05:47.01,0:05:49.02,Default,,0,0,0,,🔊Мм! ? Құрметті Гомер! ➡
Dialogue: 0,0:05:49.02,0:05:52.02,Default,,0,0,0,,Бұл жігіт... Намекиан болуы мүмкін бе?
Dialogue: 0,0:05:52.02,0:05:56.99,Default,,0,0,0,,А? Аа, олар ұқсайды ...
Dialogue: 0,0:06:02.03,0:06:04.03,Default,,0,0,0,,Хмм….
Dialogue: 0,0:06:04.03,0:06:10.04,Default,,0,0,0,,Яаааааааааааааааааааа! !
Dialogue: 0,0:06:10.04,0:06:14.04,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:14.04,0:06:17.04,Default,,0,0,0,,Мен оны жеңдім! Олар Буу...
Dialogue: 0,0:06:17.04,0:06:20.05,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:06:20.05,0:06:24.32,Default,,0,0,0,,(Кішкентай Буудың дауысы)
Dialogue: 0,0:06:26.39,0:06:28.39,Default,,0,0,0,,Ах! ? (Гомер) Чи….
Dialogue: 0,0:06:28.39,0:06:30.96,Default,,0,0,0,,Мен әлі тірі едім...
Dialogue: 0,0:06:32.99,0:06:36.00,Default,,0,0,0,,Сәлем! Аспан кенет қараңғыланды!
Dialogue: 0,0:06:36.00,0:06:38.00,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:38.00,0:06:40.97,Default,,0,0,0,,Иә? Амал жоқ...
Dialogue: 0,0:06:43.00,0:06:47.01,Default,,0,0,0,,Таптым! Бұл себеп! ➡
Dialogue: 0,0:06:47.01,0:06:50.01,Default,,0,0,0,,Қараңдар! Бұл... бұл Айдаһар добы!
Dialogue: 0,0:06:50.01,0:06:53.01,Default,,0,0,0,,Айдаһар добы! ? (Гомер) Қараңдар! ➡
Dialogue: 0,0:06:53.01,0:06:56.02,Default,,0,0,0,,Мұнда шар тәрізді заттар жиналады. ➡
Dialogue: 0,0:06:56.02,0:07:00.02,Default,,0,0,0,,Сөз жоқ. Бұл кішкентай, бірақ бұл Dragon Ball!
Dialogue: 0,0:07:00.02,0:07:03.02,Default,,0,0,0,,1 2 3 4...7 дана.
Dialogue: 0,0:07:03.02,0:07:07.03,Default,,0,0,0,,Мен сенбеймін! Мұнда 7 доп бар! ➡
Dialogue: 0,0:07:07.03,0:07:10.03,Default,,0,0,0,,Бірақ бұл мен кітаптан көрген Порунга➡
Dialogue: 0,0:07:10.03,0:07:15.00,Default,,0,0,0,,Бұл мүлдем басқаша сияқты... (Гомер) Сәл артқа оралайық.
Dialogue: 0,0:07:17.04,0:07:21.04,Ruby,,0,0,0,,Шенрон
Dialogue: 0,0:07:17.04,0:07:21.04,Default,,0,0,0,,🔊Кел, Шенрон!
Dialogue: 0,0:07:21.04,0:07:24.04,Ruby,,0,0,0,,Шенрон
Dialogue: 0,0:07:21.04,0:07:24.04,Default,,0,0,0,,Сіз оны Порунганың орнына Шенрон деп атаған сияқтысыз.
Dialogue: 0,0:07:24.04,0:07:27.05,Default,,0,0,0,,Осы таныс көрініске қарасақ, Айдаһар добы ➡
Dialogue: 0,0:07:27.05,0:07:31.02,Default,,0,0,0,,Оны жинау оңай сияқты.
Dialogue: 0,0:07:32.99,0:07:35.99,Default,,0,0,0,,Енді өз тілегіңді айт.
Dialogue: 0,0:07:35.99,0:07:42.00,Default,,0,0,0,,Кез келген үш тілекті орындаймын.
Dialogue: 0,0:07:42.00,0:07:46.10,Default,,0,0,0,,Үш! ? Жер бетінде орындалатын үш тілек бар.
Dialogue: 0,0:07:46.10,0:07:50.00,Default,,0,0,0,,Бұл үлкен жаңалық.
Dialogue: 0,0:07:50.00,0:07:55.01,Default,,0,0,0,,Иә? Айтпақшы, Бууға не болды?
Dialogue: 0,0:07:55.01,0:07:57.68,Default,,0,0,0,,Енді саған пайда жоқ.
Dialogue: 0,0:07:57.68,0:07:59.68,Default,,0,0,0,,Эй… Эй….
Dialogue: 0,0:07:59.68,0:08:03.02,Default,,0,0,0,,Өл! Барка!
Dialogue: 0,0:08:03.02,0:08:06.02,Default,,0,0,0,,Уау...
Dialogue: 0,0:08:06.02,0:08:10.02,Default,,0,0,0,,Өлтірілді! ? Буудың жігіті, тіпті қожасы Бәбиді!
Dialogue: 0,0:08:10.02,0:08:15.03,Default,,0,0,0,,Ха ха ха! Бұл жақсы! ➡
Dialogue: 0,0:08:15.03,0:08:19.03,Default,,0,0,0,,О! Ухахаха! Хоо~! ➡
Dialogue: 0,0:08:19.03,0:08:21.03,Default,,0,0,0,,О! О! Уха... Иә? ➡
Dialogue: 0,0:08:21.03,0:08:24.04,Default,,0,0,0,,О... о? о….
Dialogue: 0,0:08:24.04,0:08:26.01,Default,,0,0,0,,Жоғалып кетті! ? Бұл қайда!
Dialogue: 0,0:08:28.04,0:08:32.05,Default,,0,0,0,,О, қараңдаршы! Бұл жігіт те намекиялық!
Dialogue: 0,0:08:32.05,0:08:34.05,Default,,0,0,0,,О, сөзсіз!
Dialogue: 0,0:08:34.05,0:08:37.05,Default,,0,0,0,,Қанша іздесең де, таба алмайсың.
Dialogue: 0,0:08:37.05,0:08:40.05,Default,,0,0,0,,Олар сыртқы әлемге көшті ме...?
Dialogue: 0,0:08:40.05,0:08:43.72,Default,,0,0,0,,Иә? Буу өзгеріп жатыр!
Dialogue: 0,0:08:43.72,0:08:45.73,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:45.73,0:08:47.39,Default,,0,0,0,,Уау! Буудың күші -➡
Dialogue: 0,0:08:47.39,0:08:49.06,Default,,0,0,0,,Сан одан әрі көбейген сияқты.
Dialogue: 0,0:08:49.06,0:08:51.06,Default,,0,0,0,,Қарғыс атсын! Ей!
Dialogue: 0,0:08:51.06,0:08:54.03,Ruby,,0,0,0,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:08:51.06,0:08:54.03,Ruby,,0,0,0,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:08:51.06,0:08:54.03,Default,,0,0,0,,Үздіксіз өл, өл, ракета!
Dialogue: 0,0:08:56.07,0:08:58.07,Default,,0,0,0,,Иә! Тааа!
Dialogue: 0,0:08:58.07,0:09:00.74,Default,,0,0,0,,Уорааааааааааааа! Дааааа….
Dialogue: 0,0:09:00.74,0:09:05.08,Default,,0,0,0,,Бұл керемет күшті адамдар кімдер! ?
Dialogue: 0,0:09:05.08,0:09:22.10,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:09:22.10,0:09:24.06,Default,,0,0,0,,Иә? Бұл жерде!
Dialogue: 0,0:09:27.10,0:09:31.04,Default,,0,0,0,,Дораяаааааааааааааааааа! !
Dialogue: 0,0:09:31.04,0:09:35.04,Default,,0,0,0,,Гах... Гах... Гах...
Dialogue: 0,0:09:35.04,0:09:37.04,Default,,0,0,0,,Жақында кездескенше.
Dialogue: 0,0:09:37.04,0:09:41.05,Default,,0,0,0,,Ааааааа! ! Гуаааааааааааааааааааааааааааааааааааааааа...!
Dialogue: 0,0:09:41.05,0:09:59.07,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:09:59.07,0:10:01.07,Default,,0,0,0,,Ааааааааааааааааааааааааааааааа...➡
Dialogue: 0,0:10:01.07,0:10:04.07,Default,,0,0,0,,Гах... у... а...
Dialogue: 0,0:10:04.07,0:10:09.08,Default,,0,0,0,,Олар шынымен Маджин Бууды жеңді!
Dialogue: 0,0:10:09.08,0:10:11.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:13.08,0:10:16.08,Default,,0,0,0,,Барлық қорқыныш жойылды!
Dialogue: 0,0:10:16.08,0:10:19.09,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:10:19.09,0:10:22.06,Default,,0,0,0,,Хи!
Dialogue: 0,0:10:27.09,0:10:29.10,Default,,0,0,0,,Енді есімде де, шындықта да➡
Dialogue: 0,0:10:29.10,0:10:33.03,Default,,0,0,0,,Енді сіз осы ұлы жын әлемінің патшасы болдыңыз.
Dialogue: 0,0:10:33.03,0:10:37.04,Default,,0,0,0,,Құттықтаймыз Король Гомер.
Dialogue: 0,0:10:37.04,0:10:40.04,Default,,0,0,0,,Хи хи хи. ➡
Dialogue: 0,0:10:40.04,0:10:45.04,Default,,0,0,0,,Ахахаха… Ахахаха….
Dialogue: 0,0:10:45.04,0:10:50.05,Default,,0,0,0,,Ахххххх... Ой?
Dialogue: 0,0:10:50.05,0:10:53.05,Default,,0,0,0,,Ха... Әпке! ?
Dialogue: 0,0:10:53.05,0:10:57.06,Default,,0,0,0,,О, кешіріңіз. Дегес Сіз де сонда болдыңыз.
Dialogue: 0,0:10:57.06,0:11:02.06,Default,,0,0,0,,Сәлеметсіз бе, доктор Аринс. Әдеттегідей әдемі.
Dialogue: 0,0:11:02.06,0:11:06.07,Default,,0,0,0,,Сізге көп рахмет. (Гомер) Сіз қалай ойлайсыз? Зерттеу үшін.
Dialogue: 0,0:11:06.07,0:11:10.07,Default,,0,0,0,,Өте жақсы жүріп жатыр. ➡
Dialogue: 0,0:11:10.07,0:11:15.07,Default,,0,0,0,,Құттықтаймыз. Бұл жаңа жын иесінің дүниеге келуі.
Dialogue: 0,0:11:15.07,0:11:17.08,Default,,0,0,0,,Иә! ? Неге олай?
Dialogue: 0,0:11:17.08,0:11:23.08,Default,,0,0,0,,Әпкең де бір жерден көрген сияқты.
Dialogue: 0,0:11:23.08,0:11:26.09,Default,,0,0,0,,Дабура патша сыртқы әлемге барады➡
Dialogue: 0,0:11:26.09,0:11:31.02,Default,,0,0,0,,Бұл сирек кездесетін нәрсе, солай ма? Мен аздап қызықпын. ➡
Dialogue: 0,0:11:31.02,0:11:34.03,Default,,0,0,0,,Сіз де солай емес пе?
Dialogue: 0,0:11:34.03,0:11:37.03,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:11:37.03,0:11:40.03,Default,,0,0,0,,Айтпақшы, бұл ұят болды!
Dialogue: 0,0:11:40.03,0:11:43.04,Default,,0,0,0,,Ол сізге қалағаныңызша зерттеу қаржысын берді➡
Dialogue: 0,0:11:43.04,0:11:47.04,Default,,0,0,0,,Дабура патша өлтірілді...
Dialogue: 0,0:11:47.04,0:11:53.05,Default,,0,0,0,,Әй, Гомер-сама патша болса да, сен мұны істей аласың, солай ма?
Dialogue: 0,0:11:53.05,0:11:56.05,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:11:56.05,0:11:59.05,Default,,0,0,0,,Сақ болыңыз.
Dialogue: 0,0:11:59.05,0:12:01.05,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:12:01.05,0:12:05.06,Default,,0,0,0,,Мен сол керемет аты аңызға айналған Маджин Бууды жеңдім.
Dialogue: 0,0:12:05.06,0:12:09.06,Default,,0,0,0,,Осы ұлы жын әлеміне осындай адамдар кірсе ше...
Dialogue: 0,0:12:09.06,0:12:13.07,Default,,0,0,0,,Әй, бұл туралы ойлаудың өзі қорқынышты!
Dialogue: 0,0:12:13.07,0:12:15.07,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:12:15.07,0:12:18.07,Default,,0,0,0,,Бұл адамдар өздеріне қауіп төндіру үшін барын салды➡
Dialogue: 0,0:12:18.07,0:12:21.07,Default,,0,0,0,,Сіздің Ұлы Жындар әлеміне келуге ешқандай себеп жоқ.
Мен бұл
Dialogue: 0,0:12:21.07,0:12:25.08,Default,,0,0,0,,деп үміттенемін. Енді кешіріңіз. ➡
Dialogue: 0,0:12:25.08,0:12:28.05,Default,,0,0,0,,Король Гомер.
Dialogue: 0,0:12:31.02,0:12:34.99,Default,,0,0,0,,Ух... уф...
Dialogue: 0,0:12:38.02,0:12:41.03,Default,,0,0,0,,Мен шынымен де жақсы ма деп ойлаймын...
Dialogue: 0,0:12:41.03,0:12:43.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:43.03,0:12:45.03,Default,,0,0,0,,Расында да, ол кісілер осында келсе➡
Dialogue: 0,0:12:45.03,0:12:47.03,Default,,0,0,0,,Бұл қауіпті емес пе?
Dialogue: 0,0:12:47.03,0:12:51.04,Default,,0,0,0,,Әпкеңнің айтқанын қабылдамағаның дұрыс.
Dialogue: 0,0:12:51.04,0:12:54.04,Default,,0,0,0,,Тіпті кездейсоқ ол Ұлы жын әлеміне енсе де➡
Dialogue: 0,0:12:54.04,0:12:57.04,Default,,0,0,0,,Сіз бұл жын патшаның сарайына жете алмайсыз.
Dialogue: 0,0:12:57.04,0:13:01.05,Default,,0,0,0,,Хмм….
Dialogue: 0,0:13:01.05,0:13:05.02,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:13:08.05,0:13:13.06,Default,,0,0,0,,Иә! Айдаһар шарларын пайдалануым керек пе?
Dialogue: 0,0:13:13.06,0:13:18.06,Default,,0,0,0,,Әй, Айдаһар доп! ? Шын айтасың ба! ? ➡
Dialogue: 0,0:13:18.06,0:13:23.07,Default,,0,0,0,,Оны үш күшті Тамагами-сама қорғайды, солай ма?
Dialogue: 0,0:13:23.07,0:13:26.07,Default,,0,0,0,,Бұл ұлы жын әлемінің Айдаһар шары емес.
Dialogue: 0,0:13:26.07,0:13:31.01,Default,,0,0,0,,Бұл Жер планетасындағы кішкентай Айдаһар шары.
Dialogue: 0,0:13:31.01,0:13:33.01,Default,,0,0,0,,Жер туралы? (Гомер) Иә.
Dialogue: 0,0:13:33.01,0:13:36.02,Default,,0,0,0,,Сіз оны бұрын көрдіңіз. Егер бұл жерде Айдаһар шары болса➡
Dialogue: 0,0:13:36.02,0:13:39.02,Default,,0,0,0,,Оны реттеу оңай болуы мүмкін.
Dialogue: 0,0:13:39.02,0:13:43.02,Default,,0,0,0,,Бірақ сіз не тілейсіз?
Dialogue: 0,0:13:43.02,0:13:45.02,Default,,0,0,0,,Негізі ақ магия болса керек.➡
Dialogue: 0,0:13:45.02,0:13:47.03,Default,,0,0,0,,Оларды өшірудің қара тілегі➡
Dialogue: 0,0:13:47.03,0:13:50.03,Default,,0,0,0,,Менің ойымша, ол қабылданбайды. (Гомер) Хмф! ➡
Dialogue: 0,0:13:50.03,0:13:55.03,Default,,0,0,0,,Мен мұны білемін! Хехе….
Dialogue: 0,0:13:55.03,0:14:00.04,Default,,0,0,0,,Хехе... Мен сені жасартамын.
Dialogue: 0,0:14:00.04,0:14:04.04,Default,,0,0,0,,Не? (Гомер) Бұл қара тілек емес пе?
Dialogue: 0,0:14:04.04,0:14:06.05,Default,,0,0,0,,Бұл жақсы идея.
Dialogue: 0,0:14:06.05,0:14:08.05,Default,,0,0,0,,Уау! о...!
Dialogue: 0,0:14:08.05,0:14:13.05,Default,,0,0,0,,Ал... сен әлі сондасың ба? Хохохохо….
Dialogue: 0,0:14:13.05,0:14:18.02,Default,,0,0,0,,Мен де жасарғым келеді.
Dialogue: 0,0:14:20.06,0:14:24.06,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:14:24.06,0:14:28.07,Default,,0,0,0,,Жасарту? (Гомер) Дұрыс.
Dialogue: 0,0:14:28.07,0:14:33.01,Default,,0,0,0,,Басқаша айтқанда, олардың барлық достарын братқа айналдыр➡
Dialogue: 0,0:14:33.01,0:14:37.01,Default,,0,0,0,,Бұл сізді күшсіз етеді! О! Мен түсінемін!
Dialogue: 0,0:14:37.01,0:14:40.01,Default,,0,0,0,,Бұл қуатты айтарлықтай азайтады!
Dialogue: 0,0:14:40.01,0:14:43.02,Default,,0,0,0,,Хм... Бұл солай.
Dialogue: 0,0:14:43.02,0:14:46.02,Default,,0,0,0,,Ал менің екінші тілегім...
Dialogue: 0,0:14:46.02,0:14:50.02,Default,,0,0,0,,Мен шайтанның үшінші көзін аламын деп ойлаймын.
Dialogue: 0,0:14:50.02,0:14:55.03,Default,,0,0,0,,Ібілістің үшінші көзі! ? Бұл аңызға айналған үшінші көз бе?
Dialogue: 0,0:14:55.03,0:14:58.03,Default,,0,0,0,,Дабураның әкесі Ұлы жын патша Абра дәуірінде➡
Dialogue: 0,0:14:58.03,0:15:02.03,Default,,0,0,0,,Жоғалғанын айтады... (Гомер) Иә. ➡
Dialogue: 0,0:15:02.03,0:15:06.04,Default,,0,0,0,,Маңдайыңа қойсаң, адам сенгісіз күшке ие болады дейді.
Dialogue: 0,0:15:06.04,0:15:10.04,Default,,0,0,0,,Ежелгі заманнан бері Ұлы Жын патшасы жынның үшінші көзін мұра етті➡
Dialogue: 0,0:15:10.04,0:15:14.05,Default,,0,0,0,,Мен одан да үлкен күшке ие болдым.
Dialogue: 0,0:15:14.05,0:15:18.05,Default,,0,0,0,,Бұл, әрине, сіз ала алатын ең күшті зат, бірақ...
Dialogue: 0,0:15:18.05,0:15:22.05,Default,,0,0,0,,Дұрыс па? Ал менің үшінші тілегім...
Dialogue: 0,0:15:22.05,0:15:26.03,Default,,0,0,0,,Маған да кем дегенде бір тілек айтыңызшы.
Dialogue: 0,0:15:28.06,0:15:31.00,Default,,0,0,0,,Ал, ойланып көрейік.
Dialogue: 0,0:15:31.00,0:15:33.00,Default,,0,0,0,,Біраз уақыт жаңа Ұлы Жын Корольдің тәж кию кеші➡
Dialogue: 0,0:15:33.00,0:15:36.00,Default,,0,0,0,,Және жын әлеміндегі үш сөйлеген сөз және ➡
Dialogue: 0,0:15:36.00,0:15:39.01,Default,,0,0,0,,Ол жындарға жүгінумен айналысса керек.
Dialogue: 0,0:15:39.01,0:15:44.01,Default,,0,0,0,,Осыдан кейін ол дереу орындалады. Ұшағын дайында.
Dialogue: 0,0:15:44.01,0:15:47.01,Default,,0,0,0,,Абыройлы музыка мектептерінде бәрі бәсекелестік рейтингтерге және→
Dialogue: 0,0:15:47.01,0:15:51.02,Default,,0,0,0,,А, мен Намекиан Неваны өзіммен бірге алып кетемін.
Dialogue: 0,0:15:51.02,0:15:54.02,Default,,0,0,0,,Бұл аздап бұлыңғыр, бірақ Dragon Ball туралы ➡
Dialogue: 0,0:15:54.02,0:15:58.99,Default,,0,0,0,,Сіз басқалардан көбірек білуіңіз керек. иә.
Dialogue: 0,0:16:37.00,0:16:39.97,Default,,0,0,0,,Ну... Кууууу...
Dialogue: 0,0:16:43.00,0:16:45.00,Default,,0,0,0,,Мен жай ғана жағдайды біраз бақылап тұрамын.
Dialogue: 0,0:16:45.00,0:16:47.01,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:16:47.01,0:16:50.01,Default,,0,0,0,,Чий! Тезірек жүр!
Dialogue: 0,0:16:50.01,0:16:53.01,Default,,0,0,0,,《Қарғыс атсын! Айдаһар доп осында➡
Dialogue: 0,0:16:53.01,0:16:57.02,Default,,0,0,0,,Оны Тамагами деп атайтындар да жек көреді! 》
Dialogue: 0,0:16:57.02,0:16:59.99,Default,,0,0,0,,Сәттілік...
Dialogue: 0,0:17:05.02,0:17:10.03,Default,,0,0,0,,Тездетіп, ұшаққа отыр. Хмф.
Dialogue: 0,0:17:10.03,0:17:12.03,Default,,0,0,0,,Хи хи хи хи....
Dialogue: 0,0:17:12.03,0:17:16.04,Default,,0,0,0,,Иә? Ал, асықпа.
Dialogue: 0,0:17:16.04,0:17:18.04,Default,,0,0,0,,Уф…. (иіскеу дыбысы)
Dialogue: 0,0:17:18.04,0:17:21.04,Default,,0,0,0,,Біраз иісі бар... Сіз қашан душ қабылдадыңыз?
Dialogue: 0,0:17:21.04,0:17:27.05,Default,,0,0,0,,Душ? Әй, есімде болса, осыдан бірнеше жыл бұрын балшыққа түсіп, оған шомылғанмын...
Dialogue: 0,0:17:27.05,0:17:29.05,Default,,0,0,0,,Не?! ?
Dialogue: 0,0:17:29.05,0:17:32.99,Default,,0,0,0,,Әй, Дегесу! Менің артымнан орныңды ал! Мен оны айдаймын ...
Dialogue: 0,0:17:32.99,0:17:35.99,Default,,0,0,0,,Иә! ? бірақ….
Dialogue: 0,0:17:35.99,0:17:39.99,Default,,0,0,0,,Асығыңыз! Мен сенің орныңды алсам жарайды...
Dialogue: 0,0:17:39.99,0:17:43.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:43.00,0:17:46.00,Default,,0,0,0,,Мені қайда апарасың?
Dialogue: 0,0:17:46.00,0:17:48.00,Default,,0,0,0,,Демек, бұл сыртқы әлем.
Dialogue: 0,0:17:48.00,0:17:52.00,Default,,0,0,0,,Сыртқы әлемге өз бетіңізше бара алмайсыз.
Dialogue: 0,0:17:52.00,0:17:54.01,Default,,0,0,0,,Мен процедураларды дұрыс орындадым.
Dialogue: 0,0:17:54.01,0:17:57.01,Default,,0,0,0,,А, саяхат.
Dialogue: 0,0:17:57.01,0:18:01.01,Default,,0,0,0,,Артқа бұрылыңыз. Мен тіс пастасы жинағымды ұмытып қалдым.
Dialogue: 0,0:18:01.01,0:18:04.02,Default,,0,0,0,,Мен жақында ораламын! Жас Namekians➡ танысыңыз
Dialogue: 0,0:18:04.02,0:18:07.02,Default,,0,0,0,,Шағын тапсырманы орындау.
Dialogue: 0,0:18:07.02,0:18:11.02,Default,,0,0,0,,Намекиндер! Бұл шынымен қызық.
Dialogue: 0,0:18:11.02,0:18:14.99,Default,,0,0,0,,Менен басқа Намекейлер болды ма?
Dialogue: 0,0:18:18.03,0:18:22.00,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:18:30.98,0:18:34.98,Default,,0,0,0,,Сіз кімсіз? Өзіңіздің шынайы болмысыңызды ашыңыз.
Dialogue: 0,0:18:34.98,0:18:38.99,Default,,0,0,0,,Бұл жаңа Ұлы жын патшасы Гомер!
Dialogue: 0,0:18:38.99,0:18:41.99,Default,,0,0,0,,Мені Гомер патша деп атаңыз.
Dialogue: 0,0:18:41.99,0:18:43.99,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:18:43.99,0:18:49.00,Default,,0,0,0,,Бірақ қажетсіз ештеңе айтпаңыз. (Гомер) Әй! ?
Dialogue: 0,0:18:49.00,0:18:52.00,Default,,0,0,0,,Маған PIN кодыңызды тез айтыңыз.
Dialogue: 0,0:18:52.00,0:18:53.10,Default,,0,0,0,,0493.
Dialogue: 0,0:18:53.10,0:18:59.97,Default,,0,0,0,,Не! ? Сіз сыртқы әлемге барасыз ба?
Dialogue: 0,0:19:07.01,0:19:11.02,Default,,0,0,0,,Оған көмектесу мүмкін емес. Мен сені кіргізейін бе?
Dialogue: 0,0:19:11.02,0:19:13.99,Default,,0,0,0,,Иә! ? Ештеңе жоқ!
Dialogue: 0,0:19:33.97,0:19:36.98,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:19:36.98,0:19:45.95,Default,,0,0,0,,Уау... Ааа! Эй...!
Dialogue: 0,0:19:51.99,0:19:54.99,Default,,0,0,0,,Сіз сыртқы әлемге барасыз ба? Бұл қай ғаламда?
Dialogue: 0,0:19:54.99,0:19:57.00,Default,,0,0,0,,Әлем 7.
Dialogue: 0,0:19:57.00,0:19:59.00,Default,,0,0,0,,Ол 7-ші ғаламда қандай сан?
Dialogue: 0,0:19:59.00,0:20:03.00,Default,,0,0,0,,Жер планетасына ең жақын жұлдыз... саны 3.
Dialogue: 0,0:20:03.00,0:20:07.01,Default,,0,0,0,,3 санына барғыңыз келе ме? 3 саны бүгінде танымал.
Dialogue: 0,0:20:07.01,0:20:12.01,Default,,0,0,0,,Не? Дабура мен Бабиди.
Dialogue: 0,0:20:12.01,0:20:14.01,Default,,0,0,0,,Одан кейін тағы бір адам болды.
Dialogue: 0,0:20:14.01,0:20:18.02,Default,,0,0,0,,Иә! ? Ол кім? Эй, атыңды айт!
Dialogue: 0,0:20:18.02,0:20:21.02,Default,,0,0,0,,Қандай бастық!
Dialogue: 0,0:20:21.02,0:20:26.03,Default,,0,0,0,,Кешіріңіз, айтыңызшы...
Dialogue: 0,0:20:26.03,0:20:29.03,Default,,0,0,0,,Мен сенімдімін... бұл доктор Аринс...
Dialogue: 0,0:20:29.03,0:20:30.96,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:20:30.96,0:20:34.97,Default,,0,0,0,,Менің әпкем... Бұл не үшін керек?
Dialogue: 0,0:20:34.97,0:20:37.97,Default,,0,0,0,,Менің ойымша, ол бірдеңе құрып жатқан жоқ...
Dialogue: 0,0:20:37.97,0:20:40.97,Default,,0,0,0,,Сөйлесуді доғар, әрі қарай жүр!
Dialogue: 0,0:20:40.97,0:20:44.94,Default,,0,0,0,,Сіз оқиғаны өзгерткен болсаңыз да...
Dialogue: 0,0:20:54.99,0:20:56.99,Default,,0,0,0,,Сандықтар Құттықтаймыз! ➡
Dialogue: 0,0:20:56.99,0:20:59.99,Default,,0,0,0,,Жердің қайта тірілген күні құтты болсын!
Dialogue: 0,0:20:59.99,0:21:01.99,Default,,0,0,0,,Ой!
Dialogue: 0,0:21:01.99,0:21:05.97,Default,,0,0,0,,Сәттілік! рақмет сізге!
Dialogue: 0,0:21:09.00,0:21:12.00,Default,,0,0,0,,Сәлем, сандықтар. Қазір нешедесің?
Dialogue: 0,0:21:12.00,0:21:15.01,Default,,0,0,0,,Мен 9 жастамын! 9 жаста?
Dialogue: 0,0:21:15.01,0:21:18.01,Default,,0,0,0,,Егер солай болса, сіз өте кішкентайсыз.
Dialogue: 0,0:21:18.01,0:21:20.01,Default,,0,0,0,,Ку... Мен Криллин-санның бұлай айтқанын қаламаймын.
Dialogue: 0,0:21:20.01,0:21:25.02,Default,,0,0,0,,Сайяндар 15 жас шамасында кенет үлкен болып кетеді.
Dialogue: 0,0:21:25.02,0:21:28.02,Default,,0,0,0,,Жарайды, сен де солай болдың.
Dialogue: 0,0:21:28.02,0:21:31.96,Default,,0,0,0,,Вегета онша үлкен болған жоқ.
Құрметті
Dialogue: 0,0:21:31.96,0:21:34.96,Default,,0,0,0,,Сіз төбелесті таңдайсыз ба?
Dialogue: 0,0:21:34.96,0:21:38.96,Default,,0,0,0,,Иә? Кай патша~!
Dialogue: 0,0:21:38.96,0:21:40.97,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:21:40.97,0:21:44.97,Default,,0,0,0,,А, менде тағы бір нәрсе бар...
Dialogue: 0,0:21:44.97,0:21:50.98,Default,,0,0,0,,Иә? Айтпақшы, екеуі Потарада қосылып кеткен жоқ па?
Dialogue: 0,0:21:50.98,0:21:55.98,Default,,0,0,0,,Қайта алмаймын деп қалай айттыңыз? ?
Dialogue: 0,0:21:55.98,0:21:58.98,Default,,0,0,0,,Сіз және Вегета Потарада➡ қосыласыз
Dialogue: 0,0:21:58.98,0:22:00.99,Default,,0,0,0,,Маджин Буу жұтқанда➡
Dialogue: 0,0:22:00.99,0:22:05.99,Default,,0,0,0,,Неге екені белгісіз, екеуің Буудың денесіне оралдыңдар.
Dialogue: 0,0:22:05.99,0:22:07.99,Default,,0,0,0,,Есіңізде болсын➡
Dialogue: 0,0:22:07.99,0:22:12.00,Default,,0,0,0,,Мен жай ғана Буу-саннан сынап көруін өтіндім...
Dialogue: 0,0:22:12.00,0:22:15.00,Default,,0,0,0,,Мен жұтып, дем шығарсам, екі адам болдық.
Dialogue: 0,0:22:15.00,0:22:18.00,Default,,0,0,0,,Маджин Буу денесінің ішінде шығар➡
Dialogue: 0,0:22:18.00,0:22:21.01,Default,,0,0,0,,Тіпті Потараның бірігуі де бұзылуы мүмкін➡
Dialogue: 0,0:22:21.01,0:22:24.01,Default,,0,0,0,,Жұмбақ газ пайда болып жатқан сияқты.
Dialogue: 0,0:22:24.01,0:22:30.02,Default,,0,0,0,,Не? Менің ойымша, олар шынымен біріктіргісі келмеді.
Dialogue: 0,0:22:30.02,0:22:31.95,Default,,0,0,0,,Ал, Кибито қарт адам...
Dialogue: 0,0:22:31.95,0:22:34.95,Default,,0,0,0,,Уау….
Dialogue: 0,0:22:34.95,0:22:36.96,Default,,0,0,0,,Бірақ Гокудан көңілім қалды. ➡
Dialogue: 0,0:22:36.96,0:22:40.96,Ruby,,0,0,0,,Шенрон
Dialogue: 0,0:22:36.96,0:22:40.96,Default,,0,0,0,,Шенроннан Бууды жақсы жігіт етуді сұраңыз➡
Dialogue: 0,0:22:40.96,0:22:43.96,Default,,0,0,0,,Мен оны Жерге қалдырамын.
Dialogue: 0,0:22:43.96,0:22:47.97,Default,,0,0,0,,Ойланып қарасам, Гохан келмеген сияқты.
Dialogue: 0,0:22:47.97,0:22:51.97,Ruby,,0,0,0,,Вари
Dialogue: 0,0:22:47.97,0:22:51.97,Default,,0,0,0,,Гоханның бейбақ, екеуміз жақсы араласпаймыз.
Dialogue: 0,0:22:51.97,0:22:55.98,Default,,0,0,0,,Ол оқумен айналысады. (Каиошин) Шайқаста➡
Dialogue: 0,0:22:55.98,0:23:00.98,Default,,0,0,0,,Сіз біраз уақыт оқи алмаған шығарсыз.
Dialogue: 0,0:23:00.98,0:23:02.98,Default,,0,0,0,,Уф! Мен жедім!
Dialogue: 0,0:23:02.98,0:23:07.99,Default,,0,0,0,,Енді қарным ашты... Вегета, сен неге жаттығу жасамайсың?
Dialogue: 0,0:23:07.99,0:23:10.99,Default,,0,0,0,,Хмф... Жарайды.
Dialogue: 0,0:23:10.99,0:23:12.96,Default,,0,0,0,,Әй!
Dialogue: 0,0:23:14.99,0:23:23.00,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:23.00,0:23:26.01,Default,,0,0,0,,Олар кенет қайта бастады.
Dialogue: 0,0:23:26.01,0:23:29.01,Default,,0,0,0,,Мені жалғыз қалдырыңыз.
Dialogue: 0,0:23:29.01,0:23:34.95,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:34.95,0:23:36.95,Default,,0,0,0,,Хмф! Алақай!
Dialogue: 0,0:23:36.95,0:23:38.95,Default,,0,0,0,,Қарғыс атсын! Дааа!
Dialogue: 0,0:23:38.95,0:23:40.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:42.96,0:23:46.96,Default,,0,0,0,,Ааа!
Dialogue: 0,0:23:46.96,0:23:48.96,Default,,0,0,0,,Хмф! Қанекей мынаны істейік!
Dialogue: 0,0:23:48.96,0:23:52.93,Default,,0,0,0,,Кууууу... Хааа! Апыр-ай!
Dialogue: 0,0:23:55.97,0:23:57.94,Default,,0,0,0,,Да-да-да-да... Таа!
Dialogue: 0,0:24:02.98,0:24:05.98,Default,,0,0,0,,Иә? Хехе.
Dialogue: 0,0:24:05.98,0:24:07.98,Default,,0,0,0,,Сіз тым байсалды болып бара жатырсыз ба?
Dialogue: 0,0:24:07.98,0:24:12.95,Default,,0,0,0,,Шааааа! !
Dialogue: 0,0:24:14.99,0:24:20.99,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:24:20.99,0:24:24.00,Default,,0,0,0,,Нуоооо...
Dialogue: 0,0:24:24.00,0:24:26.97,Default,,0,0,0,,Ааааа! А... аа! ?
Dialogue: 0,0:24:31.94,0:24:33.94,Default,,0,0,0,,Барлығы көңілді жүрген сияқты.
Dialogue: 0,0:24:33.94,0:24:37.94,Default,,0,0,0,,Біз де барамыз ба? Бұл жақсы емес.
Dialogue: 0,0:24:37.94,0:24:40.91,Default,,0,0,0,,Біз қашан және не болатынын білмейміз.
Dialogue: 0,0:24:43.95,0:24:46.95,Default,,0,0,0,,Бұл дұрыс. Бұл болды. иә?
Dialogue: 0,0:24:46.95,0:24:48.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:50.96,0:24:52.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:57.96,0:25:01.97,Default,,0,0,0,,Сәлем! Ақыры келдім...
Dialogue: 0,0:25:01.97,0:25:04.97,Default,,0,0,0,,Аа... Ой... балалар?
Dialogue: 0,0:25:04.97,0:25:09.98,Default,,0,0,0,,О! Ол шынымен де Намекиан.
Dialogue: 0,0:25:09.98,0:25:13.98,Default,,0,0,0,,Менің Намекианмен танысқаныма он мыңдаған жыл болды.
Dialogue: 0,0:25:13.98,0:25:19.99,Default,,0,0,0,,А... сен Кайошин сияқтысың ба?
Dialogue: 0,0:25:19.99,0:25:21.99,Default,,0,0,0,,Бұл сәл басқаша. ➡
Dialogue: 0,0:25:21.99,0:25:25.99,Default,,0,0,0,,Біз Ұлы Жындар әлемінен келдік. ➡
Dialogue: 0,0:25:25.99,0:25:28.99,Default,,0,0,0,,Намекелік ата-бабаларыңда солай емес пе? ➡
Dialogue: 0,0:25:28.99,0:25:31.93,Default,,0,0,0,,Қарашы, сенің құлағың да үшкір екен.
Dialogue: 0,0:25:31.93,0:25:33.93,Default,,0,0,0,,Ах…. Сіз де➡
Dialogue: 0,0:25:33.93,0:25:35.93,Default,,0,0,0,,Сіз Ұлы Жындар әлеміненсіз.
Dialogue: 0,0:25:35.93,0:25:37.94,Default,,0,0,0,,Қарау. Сізге бірдеңе керек пе?
Dialogue: 0,0:25:37.94,0:25:40.94,Default,,0,0,0,,Мен сұрап көрейін, бірақ...
Dialogue: 0,0:25:40.94,0:25:45.94,Default,,0,0,0,,Сіз мұнда Айдаһар шарларына жауаптысыз, солай ма?
Dialogue: 0,0:25:45.94,0:25:47.95,Default,,0,0,0,,Иә? (Гомер) Егер солай болса➡
Dialogue: 0,0:25:47.95,0:25:49.95,Default,,0,0,0,,Енді бәрін осында жинаңыз.
Dialogue: 0,0:25:49.95,0:25:53.95,Default,,0,0,0,,Айдаһар добы! ? Сіз мұны істей алмайсыз!
Dialogue: 0,0:25:53.95,0:25:56.96,Default,,0,0,0,,Мен сен осылай айтасың деп ойладым.
Dialogue: 0,0:25:56.96,0:25:59.96,Default,,0,0,0,,Мына қарияны өзіңізбен бірге алып келгеніңізге қуаныштымын.
Dialogue: 0,0:25:59.96,0:26:02.96,Default,,0,0,0,,Әй, істе. Не?
Dialogue: 0,0:26:02.96,0:26:04.96,Default,,0,0,0,,Мен сізге бұрын айтқанмын!
Dialogue: 0,0:26:04.96,0:26:09.97,Default,,0,0,0,,Жердің айдаһар шарларын жинаңыз, себебі сіздің өмір сүру ұзақтығы 1000 жыл.
Dialogue: 0,0:26:09.97,0:26:13.94,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:26:17.98,0:26:20.98,Default,,0,0,0,,Мм... ол адам...
Dialogue: 0,0:26:20.98,0:26:23.98,Default,,0,0,0,,Ұлы жындар әлемінде айдаһар шарлары да бар.
Dialogue: 0,0:26:23.98,0:26:28.32,Default,,0,0,0,,Ол баяғыда Айдаһар шарларын жасаған.
Dialogue: 0,0:26:28.32,0:26:30.32,Default,,0,0,0,,Не!
Dialogue: 0,0:26:30.32,0:26:32.99,Default,,0,0,0,,Бірақ Тамагами ше?
Dialogue: 0,0:26:32.99,0:26:37.00,Default,,0,0,0,,Тіпті допты қорғау үшін қорқынышты адамдар тобын құрды➡
Dialogue: 0,0:26:37.00,0:26:42.00,Default,,0,0,0,,Ұзақ уақыт бойы ешкім өз тілегін орындай алмайды.
Dialogue: 0,0:26:42.00,0:26:45.00,Default,,0,0,0,,Содан оның Жерде де бар екенін білдім➡
Dialogue: 0,0:26:45.00,0:26:49.01,Default,,0,0,0,,Сол үшін келдім. Әй, болмайды➡
Dialogue: 0,0:26:49.01,0:26:52.01,Default,,0,0,0,,Осы Айдаһар шарлары арқылы тілегіңізді орындауды жоспарлап отырсыз ба? ?
Dialogue: 0,0:26:52.01,0:26:55.01,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:26:55.01,0:26:56.98,Default,,0,0,0,,Хмм….
Dialogue: 0,0:27:04.02,0:27:07.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:07.03,0:27:12.03,Default,,0,0,0,,Аа, міне... Жақында тілегім орындалған сияқты➡
Dialogue: 0,0:27:12.03,0:27:17.04,Default,,0,0,0,,Бұл әлі тек тас. Оны табу қиын...
Dialogue: 0,0:27:17.04,0:27:24.04,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:27:24.04,0:27:27.05,Default,,0,0,0,,Дораа!
Dialogue: 0,0:27:27.05,0:27:47.00,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:27:47.00,0:27:48.97,Default,,0,0,0,,Міне... осымен...
Dialogue: 0,0:27:52.00,0:27:54.67,Default,,0,0,0,,1 2 3 4….
Dialogue: 0,0:27:54.67,0:27:58.01,Default,,0,0,0,,7 дана! (Гомер) Жарайды, бастайық!
Dialogue: 0,0:27:58.01,0:28:01.01,Default,,0,0,0,,Нева Егер бұл сіздің күшіңіз болса➡
Dialogue: 0,0:28:01.01,0:28:04.02,Default,,0,0,0,,Айдаһар допқа ерте болса да оралуға болады, солай ма?
Dialogue: 0,0:28:04.02,0:28:06.02,Default,,0,0,0,,Хе хе хе.
Dialogue: 0,0:28:06.02,0:28:07.99,Default,,0,0,0,,Хе хе хе.
Dialogue: 0,0:28:16.03,0:28:19.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:19.03,0:28:21.03,Default,,0,0,0,,Не тілейтініңді білмеймін, бірақ➡
Dialogue: 0,0:28:21.03,0:28:25.04,Default,,0,0,0,,Мен өлсем де, құпия сөзді айтпаймын!
Dialogue: 0,0:28:25.04,0:28:30.98,Default,,0,0,0,,Балалар, сендердің бейнелерің бар, мен оны жазып алдым.
Dialogue: 0,0:28:30.98,0:28:34.98,Ruby,,0,0,0,,Шен
Dialogue: 0,0:28:30.98,0:28:34.98,Default,,0,0,0,,«Кел, құдай...» Ах! Тоқта!
Dialogue: 0,0:28:34.98,0:28:37.98,Default,,0,0,0,,Дааааааааааааааааааааааааа!
Dialogue: 0,0:28:37.98,0:28:41.99,Default,,0,0,0,,А... Сізде шағым бар ма?
Dialogue: 0,0:28:41.99,0:28:44.99,Default,,0,0,0,,А... иә... шырын алғыңыз келе ме?
Dialogue: 0,0:28:44.99,0:28:47.99,Default,,0,0,0,,Жоқ, жақсы. ➡
Dialogue: 0,0:28:47.99,0:28:54.00,Ruby,,0,0,0,,Шенрон
Dialogue: 0,0:28:47.99,0:28:54.00,Default,,0,0,0,,«Жүр, Шенрон, менің тілегімді орында.
Dialogue: 0,0:28:54.00,0:29:10.02,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:29:10.02,0:29:14.02,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:29:14.02,0:29:17.02,Default,,0,0,0,,Иә? Не, не?
Dialogue: 0,0:29:17.02,0:29:19.02,Default,,0,0,0,,Кенет қараңғы түсті.
Dialogue: 0,0:29:19.02,0:29:22.03,Ruby,,0,0,0,,Шенрон
Dialogue: 0,0:29:19.02,0:29:22.03,Default,,0,0,0,,Бұл Шенронның пайда болғанын білдірмейді ме?
Dialogue: 0,0:29:22.03,0:29:24.03,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:29:24.03,0:29:28.03,Default,,0,0,0,,Айдаһар шарлары әлі де жай ғана тастар.
Dialogue: 0,0:29:28.03,0:29:31.97,Default,,0,0,0,,Күннің тұтылуы дегенді естімеппін, бұл не екені таңқалдырады...
Dialogue: 0,0:29:31.97,0:29:33.97,Default,,0,0,0,,Кай патша. (Каиошин) Кибито.
Dialogue: 0,0:29:33.97,0:29:38.98,Default,,0,0,0,,Сен де сездің бе? Хмм, бұл белгі...
Dialogue: 0,0:29:38.98,0:29:45.98,Ruby,,0,0,0,,Шенрон
Dialogue: 0,0:29:38.98,0:29:45.98,Default,,0,0,0,,Енді өз тілегіңді айт. Кез келген тілекті орындаймын.
Dialogue: 0,0:29:45.98,0:29:48.99,Default,,0,0,0,,Керемет! Сонда...
Dialogue: 0,0:29:48.99,0:29:51.99,Default,,0,0,0,,Маджин Буу мен олардың одақтастарына қарсы соғысқандар➡
Dialogue: 0,0:29:51.99,0:29:54.99,Default,,0,0,0,,Бәрің, мені бала етіңдер!
Dialogue: 0,0:29:54.99,0:29:56.96,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:29:59.00,0:30:01.00,Default,,0,0,0,,Енді не болды!
Dialogue: 0,0:30:01.00,0:30:07.01,Default,,0,0,0,,Балалар неше бала?
Dialogue: 0,0:30:07.01,0:30:10.01,Default,,0,0,0,,Не? А... дұрыс...
Dialogue: 0,0:30:10.01,0:30:13.01,Default,,0,0,0,,1-сыныпта болса керек.
Dialogue: 0,0:30:13.01,0:30:16.01,Ruby,,0,0,0,,Шенрон
Dialogue: 0,0:30:13.01,0:30:16.01,Default,,0,0,0,,Кім бала болды?
Dialogue: 0,0:30:16.01,0:30:20.02,Default,,0,0,0,,Бұл кішкене деталь... у...
Dialogue: 0,0:30:20.02,0:30:22.02,Default,,0,0,0,,Бұл нәресте!
Dialogue: 0,0:30:22.02,0:30:24.02,Ruby,,0,0,0,,Шенрон
Dialogue: 0,0:30:22.02,0:30:24.02,Default,,0,0,0,,Хмм….
Dialogue: 0,0:30:24.02,0:30:28.03,Default,,0,0,0,,Не болды! Кез келген тілек орындалады, солай ма?
Dialogue: 0,0:30:28.03,0:30:31.00,Ruby,,0,0,0,,Шенрон
Dialogue: 0,0:30:28.03,0:30:31.00,Default,,0,0,0,,​​Түсіндім.
Dialogue: 0,0:30:34.97,0:30:43.98,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:30:43.98,0:30:45.98,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,0:30:45.98,0:30:47.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:47.98,0:30:51.98,Default,,0,0,0,,Уау! Ууууу!
Dialogue: 0,0:30:51.98,0:30:54.99,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:30:54.99,0:30:59.99,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,0:30:59.99,0:31:09.97,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:31:56.69,0:32:04.90,Default,,0,0,0,,～♬
