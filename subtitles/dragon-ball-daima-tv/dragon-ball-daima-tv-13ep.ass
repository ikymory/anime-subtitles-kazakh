Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.97,0:00:04.97,Default,,0,0,0,,[Айдаһар шары дегеніміз не?
Dialogue: 0,0:00:01.97,0:00:04.97,Default,,0,0,0,,7 бөлікті жинап, құпия сөзді айт➡
Dialogue: 0,0:00:04.97,0:00:08.98,Default,,0,0,0,,Шенрон
Dialogue: 0,0:00:04.97,0:00:08.98,Default,,0,0,0,,Айдаһар
Dialogue: 0,0:00:04.97,0:00:08.98,Default,,0,0,0,,Шенрон атты айдаһар пайда болады➡
Dialogue: 0,0:00:08.98,0:00:13.98,Default,,0,0,0,,Кез келген тілек орындалады
Dialogue: 0,0:00:08.98,0:00:13.98,Default,,0,0,0,,Бұл жұмбақ доп]
Dialogue: 0,0:00:13.98,0:00:17.98,Default,,0,0,0,,Сонымен
Dialogue: 0,0:00:13.98,0:00:17.98,Default,,0,0,0,,Гоку
Dialogue: 0,0:00:13.98,0:00:17.98,Default,,0,0,0,,[Бұл Сон Гоку адам
Dialogue: 0,0:00:13.98,0:00:17.98,Default,,0,0,0,,Сабырлы болып көрінсе де➡
Dialogue: 0,0:00:17.98,0:00:23.99,Default,,0,0,0,,Ерекше күші бар жауынгер жарысы
Dialogue: 0,0:00:17.98,0:00:23.99,Default,,0,0,0,,Ол – Сайян]
Dialogue: 0,0:00:23.99,0:00:32.00,Default,,0,0,0,,[Достармен кездесіп, бірге шытырман оқиғаларға барыңыз]
Dialogue: 0,0:00:23.99,0:00:32.00,Default,,0,0,0,,Ересек болып өсу]
Dialogue: 0,0:00:32.00,0:00:40.01,Default,,0,0,0,,[және қазір де зұлымдық қолынан]
Dialogue: 0,0:00:32.00,0:00:40.01,Default,,0,0,0,,Жерді қорғауды жалғастыру]
Dialogue: 0,0:00:40.01,0:00:49.98,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:21.94,0:02:24.94,Default,,0,0,0,,Ах... анау жігіттер➡
Dialogue: 0,0:02:24.94,0:02:28.95,Default,,0,0,0,,Сондай-ақ екінші жын әлемінің Айдаһар шары
Dialogue: 0,0:02:24.94,0:02:28.95,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:02:28.95,0:02:32.89,Default,,0,0,0,,Соңында
Dialogue: 0,0:02:28.95,0:02:32.89,Default,,0,0,0,,Мен осы бірінші жын әлеміне келе жатырмын.
Dialogue: 0,0:02:32.89,0:02:36.89,Default,,0,0,0,,Гугугу….
Dialogue: 0,0:02:36.89,0:02:39.86,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:02:41.90,0:02:43.90,Default,,0,0,0,,Құдайға шүкір.
Dialogue: 0,0:02:43.90,0:02:46.87,Default,,0,0,0,,Егер бұл орын алса...
Dialogue: 0,0:02:53.91,0:02:56.91,Default,,0,0,0,,Әскери полиция
Dialogue: 0,0:02:53.91,0:02:56.91,Default,,0,0,0,,Сіз бірінші жын әлеміне жиналдыңыз ба?
Dialogue: 0,0:02:56.91,0:03:00.88,Default,,0,0,0,,Иә! Көбінесе.
Dialogue: 0,0:02:56.91,0:03:00.88,Default,,0,0,0,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:03:02.92,0:03:05.92,Default,,0,0,0,,Warp-саманы тоқтатыңыз!
Dialogue: 0,0:03:05.92,0:03:07.92,Default,,0,0,0,,Warp-sama! ?
Dialogue: 0,0:03:07.92,0:03:11.93,Default,,0,0,0,,Егер мен Warp-sama қолданбасын енді пайдалана алмасам
Dialogue: 0,0:03:07.92,0:03:11.93,Default,,0,0,0,,Олар мұнда келе алмайды!
Dialogue: 0,0:03:11.93,0:03:14.93,Default,,0,0,0,,Бірақ Warp-sama тоқтату керек пе?
Dialogue: 0,0:03:11.93,0:03:14.93,Default,,0,0,0,,Мен бұл туралы ешқашан естіген емеспін!
Dialogue: 0,0:03:14.93,0:03:19.90,Default,,0,0,0,,Шулы!
Dialogue: 0,0:03:14.93,0:03:19.90,Default,,0,0,0,,Тез орындаңыз!
Dialogue: 0,0:03:43.89,0:03:47.86,Default,,0,0,0,,Мен мұны не үшін жасадым...?
Dialogue: 0,0:04:11.92,0:04:13.89,Default,,0,0,0,,Аа...
Dialogue: 0,0:04:24.93,0:04:26.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:26.60,0:04:28.94,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:04:26.60,0:04:28.94,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:04:28.94,0:04:30.87,Default,,0,0,0,,Әй, не болды?!
Dialogue: 0,0:04:30.87,0:04:32.87,Default,,0,0,0,,Биіктік тез төмендейді!
Dialogue: 0,0:04:32.87,0:04:35.88,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:04:32.87,0:04:35.88,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:35.88,0:04:37.88,Default,,0,0,0,,Құсыратын сияқтымын... Әй...
Dialogue: 0,0:04:37.88,0:04:39.88,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:04:39.88,0:04:41.88,Default,,0,0,0,,Нашар! Қозғалтқыш тоқтайды!
Dialogue: 0,0:04:41.88,0:04:43.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:43.88,0:04:45.55,Default,,0,0,0,,Бұл не?!
Dialogue: 0,0:04:43.88,0:04:45.55,Default,,0,0,0,,Жылдам➡
Dialogue: 0,0:04:45.55,0:04:48.89,Default,,0,0,0,,Бір планетада апатты қондыру!
Dialogue: 0,0:04:45.55,0:04:48.89,Default,,0,0,0,,Бір жерде!
Dialogue: 0,0:04:48.89,0:04:51.89,Default,,0,0,0,,Теңізге құлап қалсаңыз
Dialogue: 0,0:04:48.89,0:04:51.89,Default,,0,0,0,,Бұл Кракеннің олжасы.
Dialogue: 0,0:04:51.89,0:04:54.86,Default,,0,0,0,,А... Барлығы ұстансын!
Dialogue: 0,0:04:59.90,0:05:02.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:59.90,0:05:02.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:08.91,0:05:10.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:10.91,0:05:13.91,Default,,0,0,0,,Мен... Мен өлемін деп ойладым.
Dialogue: 0,0:05:13.91,0:05:15.92,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:05:13.91,0:05:15.92,Default,,0,0,0,,Кайошин
Dialogue: 0,0:05:13.91,0:05:15.92,Default,,0,0,0,,Әйтеуір.
Dialogue: 0,0:05:15.92,0:05:18.92,Default,,0,0,0,,Қандай қиындық?
Dialogue: 0,0:05:15.92,0:05:18.92,Default,,0,0,0,,Оны қарастырайық. ➡
Dialogue: 0,0:05:18.92,0:05:21.92,Default,,0,0,0,,Барлығы, мен түзетемін.
Dialogue: 0,0:05:18.92,0:05:21.92,Default,,0,0,0,,Сіз түскеннен кейін.
Dialogue: 0,0:05:21.92,0:05:23.59,Default,,0,0,0,,О, құдайым.
Dialogue: 0,0:05:23.59,0:05:25.86,Default,,0,0,0,,(Кайошин)
Dialogue: 0,0:05:23.59,0:05:25.86,Default,,0,0,0,,Біраз зерттеп көрейік.
Dialogue: 0,0:05:33.87,0:05:35.87,Default,,0,0,0,,Уау. Ах!
Dialogue: 0,0:05:35.87,0:05:37.84,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:05:41.87,0:05:43.88,Default,,0,0,0,,Айқай.
Dialogue: 0,0:05:43.88,0:05:46.85,Default,,0,0,0,,Уау! Апыр-ай...
Dialogue: 0,0:05:48.88,0:05:50.88,Default,,0,0,0,,Уау... Уау.
Dialogue: 0,0:05:50.88,0:05:53.85,Default,,0,0,0,,Иә? иә? иә?
Dialogue: 0,0:06:02.90,0:06:04.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:04.90,0:06:06.90,Default,,0,0,0,,Аа, кетті. ➡
Dialogue: 0,0:06:06.90,0:06:09.90,Default,,0,0,0,,Кракен өлтірген құралдар
Dialogue: 0,0:06:06.90,0:06:09.90,Default,,0,0,0,,Мен оны жоғалтып алдым.
Dialogue: 0,0:06:09.90,0:06:11.90,Default,,0,0,0,,Бұл жігіт пайдалы болуы мүмкін. ➡
Dialogue: 0,0:06:11.90,0:06:17.91,Default,,0,0,0,,Оны хойпой капсуласы деп атайды.
Dialogue: 0,0:06:11.90,0:06:17.91,Default,,0,0,0,,Менің әкемнің өнертабысы.
Dialogue: 0,0:06:17.91,0:06:19.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:19.91,0:06:22.92,Default,,0,0,0,,Бұл не! ? Бұл керемет!
Dialogue: 0,0:06:22.92,0:06:26.92,Default,,0,0,0,,Әртүрлі заттарды кішірейтіңіз
Dialogue: 0,0:06:22.92,0:06:26.92,Default,,0,0,0,,Бұл портативті құрылғы.
Dialogue: 0,0:06:26.92,0:06:29.92,Default,,0,0,0,,
Dialogue: 0,0:06:26.92,0:06:29.92,Default,,0,0,0,,Менің шұлықтарымды кішірейтуге бола ма?
Dialogue: 0,0:06:29.92,0:06:32.86,Default,,0,0,0,,Оны кішірейту үшін не істеу керек?
Dialogue: 0,0:06:32.86,0:06:34.86,Default,,0,0,0,,Мен мұны қарызға аламын!
Dialogue: 0,0:06:32.86,0:06:34.86,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:34.86,0:06:37.86,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:06:34.86,0:06:37.86,Default,,0,0,0,,Тек ұрысқандар➡
Dialogue: 0,0:06:37.86,0:06:39.87,Default,,0,0,0,,Сіз бірінші жын әлеміне ұшасыз ба?
Dialogue: 0,0:06:39.87,0:06:43.87,Default,,0,0,0,,Бұл мүмкін емес. Тек адамдар
Dialogue: 0,0:06:39.87,0:06:43.87,Default,,0,0,0,,Варп-самадан өте алмайды.
Dialogue: 0,0:06:43.87,0:06:46.84,Default,,0,0,0,,Цк. Мен түсінемін.
Dialogue: 0,0:06:48.88,0:06:51.88,Default,,0,0,0,,Ха! Амал жоқ, мұнда...
Dialogue: 0,0:06:51.88,0:06:53.88,Default,,0,0,0,,Ах... а... ➡
Dialogue: 0,0:06:53.88,0:06:57.88,Default,,0,0,0,,Сәлем! Ұшақты тез жөндеңіз
Dialogue: 0,0:06:53.88,0:06:57.88,Default,,0,0,0,,Қаш! ➡
Dialogue: 0,0:06:57.88,0:07:01.89,Default,,0,0,0,,Аа... Міне...➡
Dialogue: 0,0:07:01.89,0:07:04.89,Default,,0,0,0,,Бұл мега жұлдыз...
Dialogue: 0,0:07:04.89,0:07:07.89,Default,,0,0,0,,Мега жұлдыз?
Dialogue: 0,0:07:04.89,0:07:07.89,Default,,0,0,0,,Мен бұл туралы естідім. ➡
Dialogue: 0,0:07:07.89,0:07:10.90,Default,,0,0,0,,Мұнда Мега деп аталатын алыптар тұрады➡
Dialogue: 0,0:07:10.90,0:07:14.90,Default,,0,0,0,,Ұлы жын әлеміндегі ең қорқынышты екінші
Бұл
Dialogue: 0,0:07:10.90,0:07:14.90,Default,,0,0,0,,деп аталатын жұлдыз ма?
Dialogue: 0,0:07:14.90,0:07:18.91,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:07:14.90,0:07:18.91,Default,,0,0,0,,Адамдар ғана емес, бәрі орасан зор.
Dialogue: 0,0:07:18.91,0:07:22.91,Default,,0,0,0,,Ұлы жын патша және әскери полиция
Dialogue: 0,0:07:18.91,0:07:22.91,Default,,0,0,0,,Бұл ешқашан жақындамау керек жұлдыз. ➡
Dialogue: 0,0:07:22.91,0:07:26.91,Default,,0,0,0,,Бұл қауіпті! Бұл ақылсыз!
Dialogue: 0,0:07:22.91,0:07:26.91,Default,,0,0,0,,Бұл жігіт өте қауіпті!
Dialogue: 0,0:07:26.91,0:07:29.92,Default,,0,0,0,,Түсіндім. Түсіндім.
Dialogue: 0,0:07:29.92,0:07:32.85,Default,,0,0,0,,Бұл қауіпті болса
Dialogue: 0,0:07:29.92,0:07:32.85,Default,,0,0,0,,Біз бұл туралы бірдеңе жасаймыз.
Dialogue: 0,0:07:32.85,0:07:34.85,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:07:32.85,0:07:34.85,Default,,0,0,0,,Сіз асығыңыз.
Dialogue: 0,0:07:34.85,0:07:36.86,Default,,0,0,0,,Түсіндім. ➡
Dialogue: 0,0:07:36.86,0:07:40.86,Default,,0,0,0,,Хибис! бір сәт осында кел
Dialogue: 0,0:07:36.86,0:07:40.86,Default,,0,0,0,,Стендке айналдырыңыз!
Dialogue: 0,0:07:40.86,0:07:42.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:42.86,0:07:46.87,Default,,0,0,0,,Менің шалбарым кірленеді.
Dialogue: 0,0:07:46.87,0:07:48.87,Default,,0,0,0,,Warp-sama! ?
Dialogue: 0,0:07:48.87,0:07:51.87,Default,,0,0,0,,Барып, дереу біліңіз!
Dialogue: 0,0:07:51.87,0:07:53.87,Default,,0,0,0,,Бірдеңе болған сияқты.
Dialogue: 0,0:07:53.87,0:07:55.88,Default,,0,0,0,,🔊 (рингтон)
Dialogue: 0,0:07:53.87,0:07:55.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:55.88,0:07:57.84,Default,,0,0,0,,🔊 (рингтон)
Dialogue: 0,0:07:59.88,0:08:03.88,Default,,0,0,0,,Бұл Глорио.
Dialogue: 0,0:07:59.88,0:08:03.88,Default,,0,0,0,,Мен екінші допты алдым.
Dialogue: 0,0:08:03.88,0:08:05.89,Default,,0,0,0,,Енді бірінші жын әлеміне. ➡
Dialogue: 0,0:08:05.89,0:08:08.89,Default,,0,0,0,,Иә. Түсінді. ➡
Dialogue: 0,0:08:08.89,0:08:12.89,Default,,0,0,0,,Сондай-ақ Гомар және т.б. қозғалысында
Dialogue: 0,0:08:08.89,0:08:12.89,Default,,0,0,0,,Абайлаңыз. ➡
Dialogue: 0,0:08:12.89,0:08:14.86,Default,,0,0,0,,Сонымен.
Dialogue: 0,0:08:17.90,0:08:20.90,Default,,0,0,0,,🔊 (кесу дыбысы)
Dialogue: 0,0:08:20.90,0:08:25.91,Default,,0,0,0,,Енді Айдаһар добы
Dialogue: 0,0:08:20.90,0:08:25.91,Default,,0,0,0,,Мен 3 дана алдым.
Dialogue: 0,0:08:25.91,0:08:27.91,Default,,0,0,0,,Уау.
Dialogue: 0,0:08:27.91,0:08:30.91,Default,,0,0,0,,Қолдарың жақсы.
Dialogue: 0,0:08:30.91,0:08:32.91,Default,,0,0,0,,Сіз механиктерге қарсы күштісіз бе?
Dialogue: 0,0:08:32.91,0:08:34.91,Default,,0,0,0,,Өзгерістер және т.б.
Dialogue: 0,0:08:32.91,0:08:34.91,Default,,0,0,0,,Маған ұнайды.
Dialogue: 0,0:08:34.91,0:08:37.92,Default,,0,0,0,,Эй, бұл механизм менде де бар.
Dialogue: 0,0:08:34.91,0:08:37.92,Default,,0,0,0,,Мен оны қарап шықтым➡
Dialogue: 0,0:08:37.92,0:08:42.92,Default,,0,0,0,,Мына жылтыр тас тәрізді зат не?
Dialogue: 0,0:08:37.92,0:08:42.92,Default,,0,0,0,,Не? Бұл? ➡
Dialogue: 0,0:08:42.92,0:08:45.93,Default,,0,0,0,,Бұл Magilight.
Dialogue: 0,0:08:42.92,0:08:45.93,Default,,0,0,0,,Мұның бәрі энергия. ➡
Dialogue: 0,0:08:45.93,0:08:48.93,Default,,0,0,0,,Ауада қалқып жүретін ең маңызды тас.
Dialogue: 0,0:08:48.93,0:08:50.93,Default,,0,0,0,,Солай ма? ➡
Dialogue: 0,0:08:50.93,0:08:52.93,Default,,0,0,0,,Өйткені ол жер бетінде жоқ тас болды.
Dialogue: 0,0:08:50.93,0:08:52.93,Default,,0,0,0,,Бұл жұмбақ болды.
Dialogue: 0,0:08:52.93,0:08:54.93,Default,,0,0,0,,Менің ойымша. ➡
Dialogue: 0,0:08:54.93,0:08:57.94,Default,,0,0,0,,Қышқыл суға жауап ретінде
Dialogue: 0,0:08:54.93,0:08:57.94,Default,,0,0,0,,Ол энергияға айналады. ➡
Dialogue: 0,0:08:57.94,0:08:59.94,Default,,0,0,0,,Оның үстіне ол 30 жылға созылады.
Dialogue: 0,0:08:59.94,0:09:02.94,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:08:59.94,0:09:02.94,Default,,0,0,0,,Бұл тас бағалы ма?
Dialogue: 0,0:09:02.94,0:09:04.94,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:02.94,0:09:04.94,Default,,0,0,0,,Сіз оны мына жерден көре алмасаңыз да➡
Dialogue: 0,0:09:04.94,0:09:09.95,Default,,0,0,0,,Екінші жын әлемінің төбесі...
Dialogue: 0,0:09:04.94,0:09:09.95,Default,,0,0,0,,Басқаша айтқанда, үшінші жын дүниесінің түбі ➡
Dialogue: 0,0:09:09.95,0:09:11.95,Default,,0,0,0,,Магилиттен жасалған.
Dialogue: 0,0:09:09.95,0:09:11.95,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:09:11.95,0:09:14.95,Default,,0,0,0,,Үшінші жын әлемінен шыққан
Dialogue: 0,0:09:11.95,0:09:14.95,Default,,0,0,0,,Қышқыл су әрекеттеседі➡
Dialogue: 0,0:09:14.95,0:09:18.96,Default,,0,0,0,,Күн сияқты
Dialogue: 0,0:09:14.95,0:09:18.96,Default,,0,0,0,,Жарқырап жарқырайды. ➡
Dialogue: 0,0:09:18.96,0:09:22.96,Default,,0,0,0,,Және судың сапасына байланысты
Dialogue: 0,0:09:18.96,0:09:22.96,Default,,0,0,0,,Түстер өзгереді.
Dialogue: 0,0:09:22.96,0:09:26.97,Default,,0,0,0,,Міне, аспан
Dialogue: 0,0:09:22.96,0:09:26.97,Default,,0,0,0,,Мен де бірінші рет көрдім.
Dialogue: 0,0:09:26.97,0:09:28.97,Default,,0,0,0,,Мен енді мұны істей алмаймын ...
Dialogue: 0,0:09:28.97,0:09:31.90,Default,,0,0,0,,Рахмет сізге Хибис.
Dialogue: 0,0:09:31.90,0:09:34.91,Default,,0,0,0,,Сонда Magilight туралы не деуге болады?
Dialogue: 0,0:09:31.90,0:09:34.91,Default,,0,0,0,,Бұл сіз қалағаныңызша ала аласыз дегенді білдіре ме?
Dialogue: 0,0:09:34.91,0:09:38.91,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:09:34.91,0:09:38.91,Default,,0,0,0,,Ұлы жын патша көне заманнан бері басқарған.
Dialogue: 0,0:09:38.91,0:09:42.92,Default,,0,0,0,,Қаншама көп болса да
Dialogue: 0,0:09:38.91,0:09:42.92,Default,,0,0,0,,Бұл үшінші жын әлеміндегі асыл тас➡
Dialogue: 0,0:09:42.92,0:09:45.92,Default,,0,0,0,,Рұқсатсыз алсаң, өлім жазасы.
Dialogue: 0,0:09:42.92,0:09:45.92,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:45.92,0:09:47.92,Default,,0,0,0,,Аз ғана болса жеткілікті
Dialogue: 0,0:09:45.92,0:09:47.92,Default,,0,0,0,,Мен мұны қалаймын.
Dialogue: 0,0:09:47.92,0:09:51.92,Default,,0,0,0,,А, бұл біткеннен кейін.
Dialogue: 0,0:09:47.92,0:09:51.92,Default,,0,0,0,,Мен әкемнен сұраймын.
Dialogue: 0,0:09:51.92,0:09:54.93,Default,,0,0,0,,Бір жерден аздап ұрлап алсам ғой.
Dialogue: 0,0:09:51.92,0:09:54.93,Default,,0,0,0,,Оңай жеңіс!
Dialogue: 0,0:09:54.93,0:09:56.90,Default,,0,0,0,,Аха….
Dialogue: 0,0:10:13.95,0:10:17.92,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:10:22.96,0:10:24.96,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:10:24.96,0:10:26.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:26.63,0:10:28.96,Default,,0,0,0,,Допты жұлып алған адам — біздің Хью Хадсон мектебінің мақтанышы —
Dialogue: 0,0:10:26.63,0:10:28.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:28.96,0:10:30.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:30.90,0:10:33.90,Default,,0,0,0,,Не... не? Сәлем.
Dialogue: 0,0:10:33.90,0:10:35.90,Default,,0,0,0,,Тапсырма! Шырылдаған!
Dialogue: 0,0:10:35.90,0:10:38.90,Default,,0,0,0,,Бұл хомяк!
Dialogue: 0,0:10:38.90,0:10:40.91,Default,,0,0,0,,Өте үлкен!
Dialogue: 0,0:10:40.91,0:10:42.91,Default,,0,0,0,,Тапсырма!
Dialogue: 0,0:10:40.91,0:10:42.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:42.91,0:10:44.58,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:10:44.58,0:10:46.91,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:10:44.58,0:10:46.91,Default,,0,0,0,,Тез орындаңыз!
Dialogue: 0,0:10:46.91,0:10:49.92,Default,,0,0,0,,Мен сені аяймын!
Dialogue: 0,0:10:49.92,0:10:51.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:51.92,0:10:53.92,Default,,0,0,0,,Сықыр...!
Dialogue: 0,0:10:53.92,0:10:55.92,Default,,0,0,0,,Мына жігіт жаман!
Dialogue: 0,0:10:55.92,0:10:57.92,Default,,0,0,0,,Қырсық...!
Dialogue: 0,0:10:57.92,0:10:59.93,Default,,0,0,0,,Қытырлақ!
Dialogue: 0,0:10:59.93,0:11:02.90,Default,,0,0,0,,Хамстерлер тобы! ?
Dialogue: 0,0:11:04.93,0:11:07.93,Default,,0,0,0,,Кюукю!
Dialogue: 0,0:11:04.93,0:11:07.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:07.93,0:11:11.90,Default,,0,0,0,,Ахаха...! Қитықтады!
Dialogue: 0,0:11:14.94,0:11:16.94,Default,,0,0,0,,Хааааааааааааааааааааа!
Dialogue: 0,0:11:16.94,0:11:19.95,Default,,0,0,0,,Мукю~!
Dialogue: 0,0:11:19.95,0:11:22.92,Default,,0,0,0,,Тапсырма!
Dialogue: 0,0:11:19.95,0:11:22.92,Default,,0,0,0,,Қандай қатал балалар.
Dialogue: 0,0:11:25.95,0:11:28.95,Default,,0,0,0,,Әзірге жөндеу жұмыстары жүргізілген жоқ! ?
Dialogue: 0,0:11:28.95,0:11:30.89,Default,,0,0,0,,Бұл өте қауіпті.
Dialogue: 0,0:11:30.89,0:11:34.56,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:11:34.56,0:11:36.53,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:11:39.90,0:11:41.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:43.90,0:11:45.91,Default,,0,0,0,,Cu?
Dialogue: 0,0:11:45.91,0:11:49.91,Default,,0,0,0,,Кюукю!
Dialogue: 0,0:11:49.91,0:11:52.88,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:11:54.91,0:11:57.92,Default,,0,0,0,,⚟ (қатты шу)
Dialogue: 0,0:11:57.92,0:11:59.92,Default,,0,0,0,,Мен оны қадағалаймын.
Dialogue: 0,0:11:59.92,0:12:08.89,Default,,0,0,0,,⚟ (қатты шу)
Dialogue: 0,0:12:15.94,0:12:17.94,Default,,0,0,0,,Құдайға шүкір.
Dialogue: 0,0:12:17.94,0:12:19.91,Default,,0,0,0,,⚟ (қатты шу)
Dialogue: 0,0:12:23.94,0:12:29.95,Default,,0,0,0,,(қатты шу)
Dialogue: 0,0:12:29.95,0:12:32.89,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:12:32.89,0:12:37.89,Default,,0,0,0,,А... А... А...
Dialogue: 0,0:12:32.89,0:12:37.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:37.89,0:12:40.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:40.89,0:12:43.90,Default,,0,0,0,,Мегастың баласы...
Dialogue: 0,0:12:43.90,0:12:50.87,Default,,0,0,0,,Сол өлшемде... бала! ?
Dialogue: 0,0:12:52.91,0:12:55.88,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:13:33.71,0:13:36.72,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:36.72,0:13:39.72,Default,,0,0,0,,
Dialogue: 0,0:13:36.72,0:13:39.72,Default,,0,0,0,,Әй, қара! Менде сөмке бар!
Dialogue: 0,0:13:39.72,0:13:43.72,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:39.72,0:13:43.72,Default,,0,0,0,,Мектеп бітті, мен үйге бара жатырмын.
Dialogue: 0,0:13:43.72,0:13:45.69,Default,,0,0,0,,Анно мектебі! ?
Dialogue: 0,0:13:47.73,0:13:49.70,Default,,0,0,0,,№~.
Dialogue: 0,0:13:51.73,0:13:53.40,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:13:53.40,0:13:55.73,Default,,0,0,0,,
Dialogue: 0,0:13:53.40,0:13:55.73,Default,,0,0,0,,Иә! Неге мұндасың? ?
Dialogue: 0,0:13:55.73,0:13:58.74,Default,,0,0,0,,Әй, біртүрлі жігіт те келді...
Dialogue: 0,0:13:58.74,0:14:01.74,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:01.74,0:14:03.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:05.74,0:14:08.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:08.75,0:14:10.75,Default,,0,0,0,,Бұл тым үлкен.
Dialogue: 0,0:14:10.75,0:14:12.72,Default,,0,0,0,,Аһ!
Dialogue: 0,0:14:14.75,0:14:17.76,Default,,0,0,0,,(Вегета)
Dialogue: 0,0:14:14.75,0:14:17.76,Default,,0,0,0,,Қолына бірдеңе ұстап тамақ ішіп отыр.
Dialogue: 0,0:14:17.76,0:14:20.76,Default,,0,0,0,,Ах~
Dialogue: 0,0:14:17.76,0:14:20.76,Default,,0,0,0,,Жолда мен айналма жолмен дүкенге бардым. ➡
Dialogue: 0,0:14:20.76,0:14:25.76,Default,,0,0,0,,Яғни
Dialogue: 0,0:14:20.76,0:14:25.76,Default,,0,0,0,,Кракеннің аяғын күйдіріп алған.
Dialogue: 0,0:14:25.76,0:14:30.70,Default,,0,0,0,,Ал...
Dialogue: 0,0:14:25.76,0:14:30.70,Default,,0,0,0,,Сен сол құбыжықты жейсің бе?
Dialogue: 0,0:14:30.70,0:14:32.71,Default,,0,0,0,,Менде тағдырға сенуден басқа амал қалмады.
Dialogue: 0,0:14:30.70,0:14:32.71,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:14:32.71,0:14:35.71,Default,,0,0,0,,Уау...
Dialogue: 0,0:14:35.71,0:14:38.71,Default,,0,0,0,,Жөндеуден басқа
Dialogue: 0,0:14:35.71,0:14:38.71,Default,,0,0,0,,Барлығың үндемей, тығылыңдар.
Dialogue: 0,0:14:38.71,0:14:40.71,Default,,0,0,0,,Табылсаң, бітті.
Dialogue: 0,0:14:40.71,0:14:42.68,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:14:46.72,0:14:48.72,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:48.72,0:14:51.72,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:14:51.72,0:15:01.70,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:15:03.74,0:15:05.74,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:15:05.74,0:15:07.74,Default,,0,0,0,,Ха… га… га….
Dialogue: 0,0:15:07.74,0:15:10.74,Default,,0,0,0,,Хакушон!
Dialogue: 0,0:15:07.74,0:15:10.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:10.74,0:15:15.75,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:15:15.75,0:15:17.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:15.75,0:15:17.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:17.75,0:15:19.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:24.76,0:15:26.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:26.76,0:15:28.76,Default,,0,0,0,,Буруруру...!
Dialogue: 0,0:15:28.76,0:15:31.73,Default,,0,0,0,,Гррр….
Dialogue: 0,0:15:36.77,0:15:38.77,Default,,0,0,0,,Уф уф уф...!
Dialogue: 0,0:15:38.77,0:15:40.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:43.78,0:15:46.78,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:15:46.78,0:15:48.78,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:48.78,0:15:50.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:50.78,0:15:52.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:52.79,0:15:55.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:55.79,0:15:57.76,Default,,0,0,0,,Хун.
Dialogue: 0,0:16:00.79,0:16:03.80,Default,,0,0,0,,Амансың ба? Горилло!
Dialogue: 0,0:16:00.79,0:16:03.80,Default,,0,0,0,,Ах.
Dialogue: 0,0:16:03.80,0:16:06.77,Default,,0,0,0,,Мына жігітті ұшақтың жанына жолатпа!
Dialogue: 0,0:16:08.80,0:16:11.80,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:16:11.80,0:16:13.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:11.80,0:16:13.81,Default,,0,0,0,,Мен сенімен айналысамын!
Dialogue: 0,0:16:13.81,0:16:15.81,Default,,0,0,0,,Хахаха... ➡
Dialogue: 0,0:16:15.81,0:16:20.81,Default,,0,0,0,,Уф уф уф...!
Dialogue: 0,0:16:20.81,0:16:22.48,Default,,0,0,0,,Хмф!
Dialogue: 0,0:16:22.48,0:16:24.82,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:24.82,0:16:26.82,Default,,0,0,0,,Ахх!
Dialogue: 0,0:16:26.82,0:16:28.79,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:16:38.76,0:16:41.77,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:16:41.77,0:16:43.74,Default,,0,0,0,,Иттің ішінде?
Dialogue: 0,0:16:45.77,0:16:47.77,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:47.77,0:16:49.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:51.78,0:16:54.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:54.78,0:16:56.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:59.79,0:17:02.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:59.79,0:17:02.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:02.79,0:17:04.76,Default,,0,0,0,,Кене! ?
Dialogue: 0,0:17:06.79,0:17:08.79,Default,,0,0,0,,Теря~!
Dialogue: 0,0:17:06.79,0:17:08.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:08.79,0:17:13.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:15.80,0:17:18.80,Default,,0,0,0,,Хаха! ➡
Dialogue: 0,0:17:18.80,0:17:22.78,Default,,0,0,0,,Уф уф уф...!
Dialogue: 0,0:17:25.81,0:17:28.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:28.81,0:17:30.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:30.42,0:17:33.69,Default,,0,0,0,,Қайтарушы Турбо
Dialogue: 0,0:17:30.42,0:17:33.69,Default,,0,0,0,,Осы қарқынмен біз оны уақытында орындамаймыз!
Dialogue: 0,0:17:39.76,0:17:47.77,Default,,0,0,0,,Ка~ме~ха~ме~➡
Dialogue: 0,0:17:47.77,0:17:51.74,Default,,0,0,0,,болып табылады
Dialogue: 0,0:17:47.77,0:17:51.74,Default,,0,0,0,,Толқындар! !
Dialogue: 0,0:17:54.77,0:17:57.78,Default,,0,0,0,,Гоку!
Dialogue: 0,0:17:57.78,0:18:00.78,Default,,0,0,0,,Иә~. Бұл қауіпті болды.
Dialogue: 0,0:18:00.78,0:18:02.78,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:18:02.78,0:18:04.78,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:18:02.78,0:18:04.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:04.78,0:18:10.76,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:18:18.80,0:18:20.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:23.80,0:18:25.80,Default,,0,0,0,,Уф уф уф...!
Dialogue: 0,0:18:25.80,0:18:27.81,Default,,0,0,0,,Көрінбейтін белгілері жоқ, біртіндеп өршіп бара жатқан ауру сияқты—
Dialogue: 0,0:18:27.81,0:18:30.74,Default,,0,0,0,,Қайтыңыз! Жөндеу аяқталды!
Dialogue: 0,0:18:30.74,0:18:33.75,Default,,0,0,0,,
Dialogue: 0,0:18:30.74,0:18:33.75,Default,,0,0,0,,Ху~ Мен қазбаға айналады деп ойладым.
Dialogue: 0,0:18:33.75,0:18:36.75,Default,,0,0,0,,Асығыңыз! Барлығы асығыңыздар!
Dialogue: 0,0:18:36.75,0:18:38.75,Default,,0,0,0,,Тыныштық
Dialogue: 0,0:18:36.75,0:18:38.75,Default,,0,0,0,,Олардың назарын аударыңыз!
Dialogue: 0,0:18:38.75,0:18:40.75,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:18:40.75,0:18:42.75,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:18:40.75,0:18:42.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:42.75,0:18:47.73,Default,,0,0,0,,Гуруруру….
Dialogue: 0,0:18:52.76,0:18:54.77,Default,,0,0,0,,Хмм.
Dialogue: 0,0:18:54.77,0:18:58.77,Default,,0,0,0,,Қалғанын саған қалдырамын.
Dialogue: 0,0:18:54.77,0:18:58.77,Default,,0,0,0,,Бұлай жалғаса берсе, мен өлтіремін!
Dialogue: 0,0:18:58.77,0:19:00.77,Default,,0,0,0,,Әзірше ұшайық!
Dialogue: 0,0:19:00.77,0:19:02.77,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:02.77,0:19:06.78,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:02.77,0:19:06.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:06.78,0:19:08.45,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:19:08.45,0:19:12.78,Default,,0,0,0,,Уф~.
Dialogue: 0,0:19:08.45,0:19:12.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:12.78,0:19:15.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:12.78,0:19:15.75,Default,,0,0,0,,Дауысың тым бәсең, әрі тым жылдам жүріп келесің!
Dialogue: 0,0:19:22.79,0:19:25.80,Default,,0,0,0,,Қарғыс атсын... Куку....
Dialogue: 0,0:19:25.80,0:19:27.80,Default,,0,0,0,,Немерем!
Dialogue: 0,0:19:27.80,0:19:30.74,Default,,0,0,0,,Мм.
Dialogue: 0,0:19:27.80,0:19:30.74,Default,,0,0,0,,Құдайға шүкір.
Dialogue: 0,0:19:30.74,0:19:32.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:30.74,0:19:32.74,Default,,0,0,0,,Hmph.
Dialogue: 0,0:19:32.74,0:19:35.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:32.74,0:19:35.74,Default,,0,0,0,,Гоку!
Dialogue: 0,0:19:35.74,0:19:38.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:50.76,0:19:52.76,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:19:52.76,0:19:54.73,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:57.76,0:19:59.77,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:59.77,0:20:01.77,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:01.77,0:20:03.74,Default,,0,0,0,,Шығу қай жерде?
Dialogue: 0,0:20:05.77,0:20:07.74,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:09.78,0:20:12.78,Default,,0,0,0,,♬~
Dialogue: 0,0:20:12.78,0:20:15.78,Default,,0,0,0,,Шығу!
Dialogue: 0,0:20:15.78,0:20:21.79,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:20:21.79,0:20:24.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:26.79,0:20:29.80,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:29.80,0:20:31.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:31.73,0:20:34.73,Default,,0,0,0,,Ааа...!
Dialogue: 0,0:20:34.73,0:20:37.74,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:37.74,0:20:40.74,Default,,0,0,0,,Ааа...!
Dialogue: 0,0:20:40.74,0:20:43.74,Default,,0,0,0,,Уф… уф….
Dialogue: 0,0:20:43.74,0:20:46.75,Default,,0,0,0,,Куу… Куууу….
Dialogue: 0,0:20:46.75,0:20:48.75,Default,,0,0,0,,Таяқ
Dialogue: 0,0:20:46.75,0:20:48.75,Default,,0,0,0,,Қарғыс атсын... Мықты бол!
Dialogue: 0,0:20:48.75,0:20:50.75,Default,,0,0,0,,～
Dialogue: 0,0:20:50.75,0:20:52.75,Default,,0,0,0,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:20:52.75,0:20:54.75,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:20:52.75,0:20:54.75,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:54.75,0:20:56.72,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:01.76,0:21:03.73,Default,,0,0,0,,Уф уф уф...!
Dialogue: 0,0:21:08.77,0:21:12.77,Default,,0,0,0,,Сәлем! Қандай тамаша жігіт!
Dialogue: 0,0:21:12.77,0:21:14.74,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:21:17.78,0:21:21.78,Default,,0,0,0,,Уф уф уф...!
Dialogue: 0,0:21:17.78,0:21:21.78,Default,,0,0,0,,Хмм.
Dialogue: 0,0:21:21.78,0:21:24.78,Default,,0,0,0,,Уф~.
Dialogue: 0,0:21:24.78,0:21:26.79,Default,,0,0,0,,Бұл қорқынышты жұлдыз болды.
Dialogue: 0,0:21:26.79,0:21:30.72,Default,,0,0,0,,Ересектерге арналған мегас
Dialogue: 0,0:21:26.79,0:21:30.72,Default,,0,0,0,,Бұл одан да қорқынышты.
Dialogue: 0,0:21:30.72,0:21:34.73,Default,,0,0,0,,Егер бұл керемет болса
Dialogue: 0,0:21:30.72,0:21:34.73,Default,,0,0,0,,Мен Ұлы Жын патшасы болсам ғой.
Dialogue: 0,0:21:34.73,0:21:39.73,Default,,0,0,0,,Мегастың тыныш адамдары
Dialogue: 0,0:21:34.73,0:21:39.73,Default,,0,0,0,,Мені ондай нәрселер қызықтырмайды.
Dialogue: 0,0:21:39.73,0:21:43.74,Default,,0,0,0,,Ол өте сабырлы адам.
Dialogue: 0,0:21:39.73,0:21:43.74,Default,,0,0,0,,Сәлем! Мен қазіргі жұлдыздың➡ екеніне сенімдімін
Dialogue: 0,0:21:43.74,0:21:47.74,Default,,0,0,0,,Бұл Ұлы жын әлеміндегі ең қорқынышты екінші планета.
Dialogue: 0,0:21:43.74,0:21:47.74,Default,,0,0,0,,Сіз мұны айттыңыз.
Dialogue: 0,0:21:47.74,0:21:50.74,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:21:47.74,0:21:50.74,Default,,0,0,0,,Одан да қорқыныштысы бар ма! ?
Dialogue: 0,0:21:50.74,0:21:53.75,Default,,0,0,0,,Ах, Гига➡ деген жұлдыз бар
Dialogue: 0,0:21:53.75,0:21:56.75,Default,,0,0,0,,Одан да үлкен гига деген не?
Dialogue: 0,0:21:53.75,0:21:56.75,Default,,0,0,0,,Өмір сүру.
Dialogue: 0,0:21:56.75,0:21:59.75,Default,,0,0,0,,Бұл одан да үлкен! ?
Dialogue: 0,0:21:56.75,0:21:59.75,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:21:59.75,0:22:01.75,Default,,0,0,0,,Не болды.
Dialogue: 0,0:22:01.75,0:22:03.72,Default,,0,0,0,,Уф….
Dialogue: 0,0:22:07.76,0:22:09.76,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:22:09.76,0:22:13.77,Default,,0,0,0,,Күтілгендей, бұл жындар әлемі болды.
Dialogue: 0,0:22:13.77,0:22:15.77,Default,,0,0,0,,Ах.
Dialogue: 0,0:22:15.77,0:22:17.77,Default,,0,0,0,,Уф….
Dialogue: 0,0:22:17.77,0:22:19.74,Default,,0,0,0,,Хи хи хи....
Dialogue: 0,0:22:26.78,0:22:28.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:34.72,0:22:36.69,Default,,0,0,0,,Уау….
Dialogue: 0,0:22:39.73,0:22:41.69,Default,,0,0,0,,Хи хи хи....
Dialogue: 0,0:22:49.74,0:22:59.71,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:01.21,0:23:07.21,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory