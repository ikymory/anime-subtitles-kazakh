Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.04,0:00:07.04,Default,,0000,0000,0000,,[Айдаһар шары дегеніміз не?
Dialogue: 0,0:00:02.04,0:00:07.04,Default,,0000,0000,0000,,7 бөлікті жинап, құпия сөзді айт➡
Dialogue: 0,0:00:07.04,0:00:15.05,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:00:07.04,0:00:15.05,Default,,0000,0000,0000,,Шенрон деген айдаһар шығады дейді.
Dialogue: 0,0:00:07.04,0:00:15.05,Default,,0000,0000,0000,,Бұл жұмбақ доп]
Dialogue: 0,0:00:15.05,0:00:21.05,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:00:15.05,0:00:21.05,Default,,0000,0000,0000,,[Егер сіз Шенроннан қандай да бір тілек сұрасаңыз,
Dialogue: 0,0:00:15.05,0:00:21.05,Default,,0000,0000,0000,,Бұл орындалады]
Dialogue: 0,0:00:21.05,0:00:25.06,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:00:21.05,0:00:25.06,Default,,0000,0000,0000,,Гоку
Dialogue: 0,0:00:21.05,0:00:25.06,Default,,0000,0000,0000,,[Бұл Сон Гоку адам
Dialogue: 0,0:00:21.05,0:00:25.06,Default,,0000,0000,0000,,Сабырлы болып көрінсе де➡
Dialogue: 0,0:00:25.06,0:00:31.06,Default,,0000,0000,0000,,Төтенше күшке ие
Dialogue: 0,0:00:25.06,0:00:31.06,Default,,0000,0000,0000,,Жауынгер нәсіл - Сайандар]
Dialogue: 0,0:00:31.06,0:00:34.07,Default,,0000,0000,0000,,[Таудың тереңінде тұратын бала кезімде➡
Dialogue: 0,0:00:34.07,0:00:37.07,Default,,0000,0000,0000,,Айдаһар допты іздеу
Dialogue: 0,0:00:34.07,0:00:37.07,Default,,0000,0000,0000,,Достармен танысу➡
Dialogue: 0,0:00:37.07,0:00:40.04,Default,,0000,0000,0000,,Бірге есейген кезде]
Dialogue: 0,0:00:42.08,0:00:44.08,Default,,0000,0000,0000,,[Менің өмірімнің көп бөлігі➡
Dialogue: 0,0:00:44.08,0:00:49.08,Default,,0000,0000,0000,,Жас денені сақтаңыз
Dialogue: 0,0:00:44.08,0:00:49.08,Default,,0000,0000,0000,,Сайян сипаттамалары бар➡
Dialogue: 0,0:00:49.08,0:00:53.09,Default,,0000,0000,0000,,Қазір де
Dialogue: 0,0:00:49.08,0:00:53.09,Default,,0000,0000,0000,,Бұрынғы қарсыластарымен➡
Dialogue: 0,0:00:53.09,0:00:59.09,Default,,0000,0000,0000,,Жаманның қолынан
Dialogue: 0,0:00:53.09,0:00:59.09,Default,,0000,0000,0000,,Жерді қорғауды жалғастыру]
Dialogue: 0,0:00:59.09,0:01:09.07,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:43.03,0:02:45.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:43.03,0:02:45.03,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:02:45.03,0:02:47.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:47.03,0:02:51.04,Default,,0000,0000,0000,,Сен неге баласың?
Dialogue: 0,0:02:47.03,0:02:51.04,Default,,0000,0000,0000,,Ол сондай күшті.
Dialogue: 0,0:02:51.04,0:02:54.04,Default,,0000,0000,0000,,? Жаттығудың арқасында емес пе?
Dialogue: 0,0:02:54.04,0:02:56.04,Default,,0000,0000,0000,,Не? сол.
Dialogue: 0,0:02:56.04,0:03:00.05,Default,,0000,0000,0000,,Хмм... жаттығу - жаттығу.
Dialogue: 0,0:03:00.05,0:03:04.05,Default,,0000,0000,0000,,Не? Жоқ.
Dialogue: 0,0:03:00.05,0:03:04.05,Default,,0000,0000,0000,,Мені құтқарғаныңыз үшін рахмет! ➡
Dialogue: 0,0:03:04.05,0:03:07.05,Default,,0000,0000,0000,,Ах! Сізде дөңгелек құлақ бар!
Dialogue: 0,0:03:07.05,0:03:10.06,Default,,0000,0000,0000,,Қандай жарыс! ?
Dialogue: 0,0:03:07.05,0:03:10.06,Default,,0000,0000,0000,,Эй, мен Сайянмын.
Dialogue: 0,0:03:10.06,0:03:13.06,Default,,0000,0000,0000,,Бұл қандай жын әлемі?
Dialogue: 0,0:03:13.06,0:03:16.06,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:03:13.06,0:03:16.06,Default,,0000,0000,0000,,Екінші.
Dialogue: 0,0:03:16.06,0:03:19.07,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:03:19.07,0:03:22.07,Default,,0000,0000,0000,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:03:19.07,0:03:22.07,Default,,0000,0000,0000,,Сіз батылсыз.
Dialogue: 0,0:03:22.07,0:03:24.07,Default,,0000,0000,0000,,Мен сәтсіздікке ұшырадым.
Dialogue: 0,0:03:24.07,0:03:28.07,Default,,0000,0000,0000,,Шулы! Васаби бомбасының ұнтағы
Dialogue: 0,0:03:24.07,0:03:28.07,Default,,0000,0000,0000,,Ылғалды болды!
Dialogue: 0,0:03:28.07,0:03:32.01,Default,,0000,0000,0000,,Мені жалғыз қалдырыңыз. Барайық.
Dialogue: 0,0:03:28.07,0:03:32.01,Default,,0000,0000,0000,,Кайошин
Dialogue: 0,0:03:28.07,0:03:32.01,Default,,0000,0000,0000,,Ммм, дәмді екен.
Dialogue: 0,0:03:32.01,0:03:34.01,Default,,0000,0000,0000,,​​Қайда бара жатырсың?
Dialogue: 0,0:03:34.01,0:03:36.02,Default,,0000,0000,0000,,Бұл қамал.
Dialogue: 0,0:03:34.01,0:03:36.02,Default,,0000,0000,0000,,Тыныш!
Dialogue: 0,0:03:36.02,0:03:40.02,Default,,0000,0000,0000,,Ах! Мен бара алмаймын.
Dialogue: 0,0:03:36.02,0:03:40.02,Default,,0000,0000,0000,,Джо
Dialogue: 0,0:03:36.02,0:03:40.02,Default,,0000,0000,0000,,қамал Кадан сарайы ма? Неліктен?
Dialogue: 0,0:03:40.02,0:03:43.02,Default,,0000,0000,0000,,Кешіріңіз, мен асығып тұрмын.
Dialogue: 0,0:03:43.02,0:03:44.99,Default,,0000,0000,0000,,Һмм.
Dialogue: 0,0:03:50.03,0:03:52.03,Default,,0000,0000,0000,,Мен де сенімен бірге барамын.
Dialogue: 0,0:03:52.03,0:03:56.04,Default,,0000,0000,0000,,Бас тарту.
Dialogue: 0,0:03:52.03,0:03:56.04,Default,,0000,0000,0000,,Хмф, сен қараңғысың. ➡
Dialogue: 0,0:03:56.04,0:03:58.04,Default,,0000,0000,0000,,Екеуміз бірге болсақ та жарайды!
Dialogue: 0,0:03:58.04,0:04:02.01,Default,,0000,0000,0000,,Мм... Қамалға бағыт
Dialogue: 0,0:03:58.04,0:04:02.01,Default,,0000,0000,0000,,Мен көп нәрсені білсем де.
Dialogue: 0,0:04:05.04,0:04:10.05,Default,,0000,0000,0000,,Қарғыс атсын... Қарғыс атсын, неткен ақымақ! ➡
Dialogue: 0,0:04:10.05,0:04:13.05,Default,,0000,0000,0000,,Сәлем балақай
Dialogue: 0,0:04:10.05,0:04:13.05,Default,,0000,0000,0000,,Қайда бардың! ?
Dialogue: 0,0:04:13.05,0:04:16.06,Default,,0000,0000,0000,,Мен оны жоғалтып алдым.
Dialogue: 0,0:04:13.05,0:04:16.06,Default,,0000,0000,0000,,Мені жағамен қадағалаңыз!
Dialogue: 0,0:04:16.06,0:04:20.06,Default,,0000,0000,0000,,Кенеттен
Dialogue: 0,0:04:16.06,0:04:20.06,Default,,0000,0000,0000,,Мен оның жағасын көре алмадым.
Dialogue: 0,0:04:20.06,0:04:22.06,Default,,0000,0000,0000,,Tsk….
Dialogue: 0,0:04:22.06,0:04:24.06,Default,,0000,0000,0000,,Барлығын табыңыз! ➡
Dialogue: 0,0:04:24.06,0:04:28.07,Default,,0000,0000,0000,,Қызыл таяқшаны ұстау
Dialogue: 0,0:04:24.06,0:04:28.07,Default,,0000,0000,0000,,Басы тозған бала ғой!
Dialogue: 0,0:04:28.07,0:04:33.01,Default,,0000,0000,0000,,А, мен түскі асты өткізіп алдым.
Dialogue: 0,0:04:33.01,0:04:35.01,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:04:35.01,0:04:38.01,Default,,0000,0000,0000,,Сіз аштыңыз ба? ➡
Dialogue: 0,0:04:38.01,0:04:41.01,Default,,0000,0000,0000,,Күріш шарларын жегің келе ме? ➡
Dialogue: 0,0:04:41.01,0:04:44.02,Default,,0000,0000,0000,,Қараңыз.
Dialogue: 0,0:04:41.01,0:04:44.02,Default,,0000,0000,0000,,Уау, шынымен! ? Рақмет сізге.
Dialogue: 0,0:04:44.02,0:04:46.02,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:04:46.02,0:04:49.02,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:04:46.02,0:04:49.02,Default,,0000,0000,0000,,Панци.
Dialogue: 0,0:04:49.02,0:04:51.02,Default,,0000,0000,0000,,Пунджи? Бұл біртүрлі атау.
Dialogue: 0,0:04:51.02,0:04:54.03,Default,,0000,0000,0000,,Сіз ше?
Dialogue: 0,0:04:51.02,0:04:54.03,Default,,0000,0000,0000,,Гоку.
Dialogue: 0,0:04:54.03,0:04:56.03,Default,,0000,0000,0000,,Гоку?
Dialogue: 0,0:04:56.03,0:05:00.03,Default,,0000,0000,0000,,Пфф... сен жақсысың.
Dialogue: 0,0:04:56.03,0:05:00.03,Default,,0000,0000,0000,,Бұл одан да оғаш атау емес пе?
Dialogue: 0,0:05:00.03,0:05:02.04,Default,,0000,0000,0000,,Тағы бір аты – Какарот.
Dialogue: 0,0:05:02.04,0:05:06.04,Default,,0000,0000,0000,,Екі есім бар ма?
Dialogue: 0,0:05:02.04,0:05:06.04,Default,,0000,0000,0000,,Екі есім де біртүрлі.
Dialogue: 0,0:05:06.04,0:05:09.04,Default,,0000,0000,0000,,Хахахаха... Шынымен бе?
Dialogue: 0,0:05:09.04,0:05:13.05,Default,,0000,0000,0000,,Сіз қандай сиқырға шеберсіз?
Dialogue: 0,0:05:09.04,0:05:13.05,Default,,0000,0000,0000,,Сиқыр?
Dialogue: 0,0:05:13.05,0:05:17.05,Default,,0000,0000,0000,,Кез келген адам жын бола алады
Dialogue: 0,0:05:13.05,0:05:17.05,Default,,0000,0000,0000,,Сіз кем дегенде бір сиқыр жасай аласыз.
Dialogue: 0,0:05:17.05,0:05:19.05,Default,,0000,0000,0000,,Сиқыр?
Dialogue: 0,0:05:19.05,0:05:22.06,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:05:22.06,0:05:24.06,Default,,0000,0000,0000,,Мұрнымды тіліммен жалай аламын.
Dialogue: 0,0:05:24.06,0:05:26.06,Default,,0000,0000,0000,,Бұл сиқыр емес.
Dialogue: 0,0:05:26.06,0:05:28.06,Default,,0000,0000,0000,,Сіз мұны істей алмайсыз ба?
Dialogue: 0,0:05:28.06,0:05:30.03,Default,,0000,0000,0000,,Әрине!
Dialogue: 0,0:05:32.00,0:05:35.00,Default,,0000,0000,0000,,Хмм...! Хмм! ➡
Dialogue: 0,0:05:35.00,0:05:40.01,Default,,0000,0000,0000,,Ммм...!
Dialogue: 0,0:05:40.01,0:05:44.01,Default,,0000,0000,0000,,Хмм...!
Dialogue: 0,0:05:44.01,0:05:46.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:44.01,0:05:46.01,Default,,0000,0000,0000,,Уа.
Dialogue: 0,0:05:46.01,0:05:50.02,Default,,0000,0000,0000,,Хмм...! сәуле!
Dialogue: 0,0:05:50.02,0:05:53.02,Default,,0000,0000,0000,,Ха… ха-ха….
Dialogue: 0,0:05:53.02,0:05:57.02,Default,,0000,0000,0000,,Уау, бұл керемет, Панджи!
Dialogue: 0,0:05:53.02,0:05:57.02,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:05:57.02,0:06:02.03,Default,,0000,0000,0000,,Менің ең жақсы нәрсем
Dialogue: 0,0:05:57.02,0:06:02.03,Default,,0000,0000,0000,,Тек машиналармен айналысу!
Dialogue: 0,0:06:02.03,0:06:05.03,Default,,0000,0000,0000,,Hmph.
Dialogue: 0,0:06:05.03,0:06:07.00,Default,,0000,0000,0000,,Гуа~!
Dialogue: 0,0:06:10.04,0:06:14.04,Default,,0000,0000,0000,,Сіздің атыңыз кім?
Dialogue: 0,0:06:10.04,0:06:14.04,Default,,0000,0000,0000,,А... бұл Шин.
Dialogue: 0,0:06:14.04,0:06:17.04,Default,,0000,0000,0000,,Мүмкін Гриндиан?
Dialogue: 0,0:06:14.04,0:06:17.04,Default,,0000,0000,0000,,Иә, жақсы.
Dialogue: 0,0:06:17.04,0:06:21.05,Default,,0000,0000,0000,,Күтілгендей.
Dialogue: 0,0:06:17.04,0:06:21.05,Default,,0000,0000,0000,,Гомердің адъютанты Дегесу➡
Dialogue: 0,0:06:21.05,0:06:25.05,Default,,0000,0000,0000,,Мен гриндианмын.
Dialogue: 0,0:06:21.05,0:06:25.05,Default,,0000,0000,0000,,Бұл сіз сияқты болды.
Dialogue: 0,0:06:25.05,0:06:27.05,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:06:27.05,0:06:29.06,Default,,0000,0000,0000,,Гриндиялықтардың көпшілігі ➡
Dialogue: 0,0:06:29.06,0:06:30.99,Default,,0000,0000,0000,,Баяғыда ол сыртқы әлемге кетті.
Dialogue: 0,0:06:29.06,0:06:30.99,Default,,0000,0000,0000,,Мен естідім➡
Dialogue: 0,0:06:30.99,0:06:33.99,Default,,0000,0000,0000,,Сендей бала
Dialogue: 0,0:06:30.99,0:06:33.99,Default,,0000,0000,0000,,Менің ойымша, ол әлі де сонда. ➡
Dialogue: 0,0:06:33.99,0:06:38.00,Default,,0000,0000,0000,,гриндиандық балалар
Dialogue: 0,0:06:33.99,0:06:38.00,Default,,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,0:06:38.00,0:06:40.00,Default,,0000,0000,0000,,Бұл саяхат.
Dialogue: 0,0:06:40.00,0:06:44.00,Default,,0000,0000,0000,,Саяхаттау?
Dialogue: 0,0:06:40.00,0:06:44.00,Default,,0000,0000,0000,,Хмм... бұл күдікті.
Dialogue: 0,0:06:44.00,0:06:47.01,Default,,0000,0000,0000,,Жұмыстан тыс, осы үшінші жын әлемінде
Dialogue: 0,0:06:44.00,0:06:47.01,Default,,0000,0000,0000,,Кім келеді?
Dialogue: 0,0:06:47.01,0:06:49.01,Default,,0000,0000,0000,,Жоқ дерлік.
Dialogue: 0,0:06:49.01,0:06:51.01,Default,,0000,0000,0000,,Сұрақтың бәрі осы.
Dialogue: 0,0:06:51.01,0:06:54.01,Default,,0000,0000,0000,,Егер сөйлескіңіз келсе
Dialogue: 0,0:06:51.01,0:06:54.01,Default,,0000,0000,0000,,Басқаларды соғыңыз.
Dialogue: 0,0:06:54.01,0:06:57.58,Default,,0000,0000,0000,,Атыңызды сұрасам бола ма?
Dialogue: 0,0:06:59.35,0:07:01.02,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:07:01.02,0:07:03.02,Default,,0000,0000,0000,,Бұл Горилло!
Dialogue: 0,0:07:03.02,0:07:05.02,Default,,0000,0000,0000,,Жоқ. Бұл Глорио.
Dialogue: 0,0:07:05.02,0:07:07.99,Default,,0000,0000,0000,,Гу…го…голори….
Dialogue: 0,0:07:10.03,0:07:14.03,Default,,0000,0000,0000,,Не? Иә.
Dialogue: 0,0:07:10.03,0:07:14.03,Default,,0000,0000,0000,,Көрсеткіш.
Dialogue: 0,0:07:14.03,0:07:16.04,Default,,0000,0000,0000,,Глорио.
Dialogue: 0,0:07:16.04,0:07:18.04,Default,,0000,0000,0000,,Мына тасты жерден өткен дұрыс
Dialogue: 0,0:07:16.04,0:07:18.04,Default,,0000,0000,0000,,Қазір ерте. ➡
Dialogue: 0,0:07:18.04,0:07:20.01,Default,,0000,0000,0000,,Міне, міне!
Dialogue: 0,0:07:22.04,0:07:26.05,Default,,0000,0000,0000,,Әй, бұл жерде!
Dialogue: 0,0:07:26.05,0:07:30.05,Default,,0000,0000,0000,,Сонда да Гомердің әскери полициясы
Dialogue: 0,0:07:26.05,0:07:30.05,Default,,0000,0000,0000,,Олар қорқынышты адамдар.
Dialogue: 0,0:07:30.05,0:07:33.99,Default,,0000,0000,0000,,Егер сіз алтын монеталарды төлей алмасаңыз
Dialogue: 0,0:07:30.05,0:07:33.99,Default,,0000,0000,0000,,Менің өмірімді тонап алуға қалай дәтің бар.
Dialogue: 0,0:07:33.99,0:07:35.99,Default,,0000,0000,0000,,Бұл жынды емес пе?
Dialogue: 0,0:07:35.99,0:07:37.99,Default,,0000,0000,0000,,Бір алтын тиын төлей алмасаңыз➡
Dialogue: 0,0:07:37.99,0:07:40.99,Default,,0000,0000,0000,,Өмір жасыңызды 9 жылға ұзартыңыз
Dialogue: 0,0:07:37.99,0:07:40.99,Default,,0000,0000,0000,,Оны сорып алатын болады. ➡
Dialogue: 0,0:07:40.99,0:07:43.00,Default,,0000,0000,0000,,Дабура да қорқынышты болды➡
Dialogue: 0,0:07:43.00,0:07:45.00,Default,,0000,0000,0000,,Гомермен салыстырғанда
Dialogue: 0,0:07:43.00,0:07:45.00,Default,,0000,0000,0000,,Бұл жақсырақ болды. ➡
Dialogue: 0,0:07:45.00,0:07:49.00,Default,,0000,0000,0000,,Бұл адамдар бар болғаны 1000 жыл болды.
Dialogue: 0,0:07:45.00,0:07:49.00,Default,,0000,0000,0000,,Мен өмір сүре алмасам да.
Dialogue: 0,0:07:49.00,0:07:53.01,Default,,0000,0000,0000,,1000 жыл! ? Мен осыншама ұзақ өмір сүргенімді қалаймын
Dialogue: 0,0:07:49.00,0:07:53.01,Default,,0000,0000,0000,,Бұл жеткілікті емес пе?
Dialogue: 0,0:07:53.01,0:07:55.01,Default,,0000,0000,0000,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:07:53.01,0:07:55.01,Default,,0000,0000,0000,,Эй, сен нешедесің?
Dialogue: 0,0:07:55.01,0:07:57.01,Default,,0000,0000,0000,,82 жаста.
Dialogue: 0,0:07:57.01,0:07:59.98,Default,,0000,0000,0000,,Сәлем! ?
Dialogue: 0,0:07:57.01,0:07:59.98,Default,,0000,0000,0000,,Сен менен үлкенсің!
Dialogue: 0,0:08:02.01,0:08:05.02,Default,,0000,0000,0000,,Уф! Бұл не? ?
Dialogue: 0,0:08:05.02,0:08:08.02,Default,,0000,0000,0000,,Бұл жерден одан да тік болады.
Dialogue: 0,0:08:08.02,0:08:21.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:08:21.03,0:08:24.04,Default,,0000,0000,0000,,Бұл Кадан сарайы.
Dialogue: 0,0:08:24.04,0:08:27.04,Default,,0000,0000,0000,,Неге, оны құлыпқа айналдыр?
Dialogue: 0,0:08:24.04,0:08:27.04,Default,,0000,0000,0000,,Бұл дұрыс емес сияқты.
Dialogue: 0,0:08:27.04,0:08:30.04,Default,,0000,0000,0000,,Бұл дөрекі.
Dialogue: 0,0:08:27.04,0:08:30.04,Default,,0000,0000,0000,,Ол үшінші жын әлеміндегі керемет адам!
Dialogue: 0,0:08:30.04,0:08:33.05,Default,,0000,0000,0000,,Патша қандай адам?
Dialogue: 0,0:08:33.05,0:08:37.05,Default,,0000,0000,0000,,нашар дизайн
Dialogue: 0,0:08:33.05,0:08:37.05,Default,,0000,0000,0000,,Ол мафияның басшысы.
Dialogue: 0,0:08:37.05,0:08:39.05,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:08:37.05,0:08:39.05,Default,,0000,0000,0000,,Ол соншалықты жаман емес.
Dialogue: 0,0:08:39.05,0:08:43.06,Default,,0000,0000,0000,,Мен зұлымдардан тек алтын теңге аламын.
Dialogue: 0,0:08:39.05,0:08:43.06,Default,,0000,0000,0000,,Тек зұлым адамдарды өлтіріңіз.
Dialogue: 0,0:08:43.06,0:08:47.06,Default,,0000,0000,0000,,Мені тез тыңда
Dialogue: 0,0:08:43.06,0:08:47.06,Default,,0000,0000,0000,,Саған ұшақ беруге рұқсат етіңіз.
Dialogue: 0,0:08:47.06,0:08:51.03,Default,,0000,0000,0000,,Иә! Тез арада
Dialogue: 0,0:08:47.06,0:08:51.03,Default,,0000,0000,0000,,Мен саған көмектесуім керек.
Dialogue: 0,0:08:54.07,0:08:56.07,Default,,0000,0000,0000,,(күтуші)
Dialogue: 0,0:08:54.07,0:08:56.07,Default,,0000,0000,0000,,«Кербер айтты»➡
Dialogue: 0,0:08:56.07,0:09:01.07,Default,,0000,0000,0000,,«Қызыл жын мырза Қызыл жын мырза
Dialogue: 0,0:08:56.07,0:09:01.07,Default,,0000,0000,0000,,Сол дәмді тефтели➡
Dialogue: 0,0:09:01.07,0:09:05.08,Default,,0000,0000,0000,,Бір немесе екі
Dialogue: 0,0:09:01.07,0:09:05.08,Default,,0000,0000,0000,,Жоқ, маған 100 дана беріңізші».
Dialogue: 0,0:09:05.08,0:09:07.08,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:09:05.08,0:09:07.08,Default,,0000,0000,0000,,«Қызыл жын...»
Dialogue: 0,0:09:07.08,0:09:10.08,Default,,0000,0000,0000,,Ки... Король Гомер!
Dialogue: 0,0:09:07.08,0:09:10.08,Default,,0000,0000,0000,,Мұны қалай оқисыз? ➡
Dialogue: 0,0:09:10.08,0:09:13.09,Default,,0000,0000,0000,,Көбірек эмоциямен
Dialogue: 0,0:09:10.08,0:09:13.09,Default,,0000,0000,0000,,Оқудан ләззат алыңыз!
Dialogue: 0,0:09:13.09,0:09:16.09,Default,,0000,0000,0000,,Иә, кешіріңіз.
Dialogue: 0,0:09:16.09,0:09:20.09,Default,,0000,0000,0000,,Бұл жігіт ақырында болады
Dialogue: 0,0:09:16.09,0:09:20.09,Default,,0000,0000,0000,,Жаңа Айдаһар шарларын➡ жасайды
Dialogue: 0,0:09:20.09,0:09:22.09,Default,,0000,0000,0000,,Ол асыл Намекиан. ➡
Dialogue: 0,0:09:22.09,0:09:26.10,Default,,0000,0000,0000,,Маған құрметпен қара.
Dialogue: 0,0:09:22.09,0:09:26.10,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:09:26.10,0:09:30.10,Default,,0000,0000,0000,,“Акаони-сан, Акаони-сан”➡
Dialogue: 0,0:09:30.10,0:09:35.04,Default,,0000,0000,0000,,«Мынау дәмді тефтели.
Dialogue: 0,0:09:30.10,0:09:35.04,Default,,0000,0000,0000,,Бір немесе екі, жоқ...»
Dialogue: 0,0:09:35.04,0:09:40.05,Default,,0000,0000,0000,,Бұл Кадан сарайы ма?
Dialogue: 0,0:09:35.04,0:09:40.05,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:09:40.05,0:09:42.05,Default,,0000,0000,0000,,...
Dialogue: 0,0:09:42.05,0:09:47.05,Default,,0000,0000,0000,,Қызым, саған жетеді.
Dialogue: 0,0:09:42.05,0:09:47.05,Default,,0000,0000,0000,,Мен де барамын.
Dialogue: 0,0:09:47.05,0:09:49.06,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:09:49.06,0:09:53.06,Default,,0000,0000,0000,,Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:09:49.06,0:09:53.06,Default,,0000,0000,0000,,Сені қуып жібереді.
Dialogue: 0,0:09:53.06,0:09:57.06,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:09:53.06,0:09:57.06,Default,,0000,0000,0000,,Сізге не керек? ?
Dialogue: 0,0:09:57.06,0:10:02.07,Default,,0000,0000,0000,,Бұл Глорио. Сіз кеше кездестіңіз.
Dialogue: 0,0:09:57.06,0:10:02.07,Default,,0000,0000,0000,,Кадан патшамен танысу.
Dialogue: 0,0:10:02.07,0:10:07.07,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:10:02.07,0:10:07.07,Default,,0000,0000,0000,,-де? Ол балалар қандай?
Dialogue: 0,0:10:07.07,0:10:09.08,Default,,0000,0000,0000,,Бала деген кім?
Dialogue: 0,0:10:09.08,0:10:11.08,Default,,0000,0000,0000,,Ах! Эй... Ханшайым! ?
Dialogue: 0,0:10:11.08,0:10:14.08,Default,,0000,0000,0000,,Кейде жергілікті тұрғынды пайдаланған ыңғайлы.
Dialogue: 0,0:10:14.08,0:10:17.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:14.08,0:10:17.08,Default,,0000,0000,0000,,Иә! ? ханшайым?
Dialogue: 0,0:10:17.08,0:10:19.09,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:10:17.08,0:10:19.09,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:10:19.09,0:10:22.09,Default,,0000,0000,0000,,Өйткені бұл көзқарас
Dialogue: 0,0:10:19.09,0:10:22.09,Default,,0000,0000,0000,,Бұл мафия сарайы➡
Dialogue: 0,0:10:22.09,0:10:24.09,Default,,0000,0000,0000,,Маған солай айтылған.
Dialogue: 0,0:10:24.09,0:10:27.09,Default,,0000,0000,0000,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,0:10:24.09,0:10:27.09,Default,,0000,0000,0000,,Сіз осылай айтасыз.
Dialogue: 0,0:10:27.09,0:10:29.10,Default,,0000,0000,0000,,Жетеді. мен барамын.
Dialogue: 0,0:10:29.10,0:10:32.03,Default,,0000,0000,0000,,Oss.
Dialogue: 0,0:10:29.10,0:10:32.03,Default,,0000,0000,0000,,Сәлеметсіз бе.
Dialogue: 0,0:10:32.03,0:10:36.04,Default,,0000,0000,0000,,Мұнда!
Dialogue: 0,0:10:32.03,0:10:36.04,Default,,0000,0000,0000,,Эй, сен мына сарайдың ханшайымысың ба?
Dialogue: 0,0:10:36.04,0:10:38.04,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:10:38.04,0:10:42.04,Default,,0000,0000,0000,,Олай болса.
Dialogue: 0,0:10:38.04,0:10:42.04,Default,,0000,0000,0000,,Тезірек айтсаңыз.
Dialogue: 0,0:10:42.04,0:10:45.04,Default,,0000,0000,0000,,Хаха бірақ
Dialogue: 0,0:10:42.04,0:10:45.04,Default,,0000,0000,0000,,Мен өзімді ханшайымдай сезінбеймін.
Dialogue: 0,0:10:45.04,0:10:48.05,Default,,0000,0000,0000,,Бұл тым қатты, Гоку! мен барамын.
Dialogue: 0,0:10:48.05,0:10:51.05,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:10:51.05,0:10:54.05,Default,,0000,0000,0000,,Жындар әлемінің сарайы қандай?
Dialogue: 0,0:10:51.05,0:10:54.05,Default,,0000,0000,0000,,Мынадай.
Dialogue: 0,0:10:54.05,0:10:56.02,Default,,0000,0000,0000,,Иә, бұл қалыпты жағдай.
Dialogue: 0,0:10:58.06,0:11:00.03,Default,,0000,0000,0000,,Ерекше ештеңе жоқ.
Dialogue: 0,0:11:03.06,0:11:06.07,Default,,0000,0000,0000,,Ерекше қорқынышты ешкім жоқ.
Dialogue: 0,0:11:06.07,0:11:09.07,Default,,0000,0000,0000,,Барлық жерде солай.
Dialogue: 0,0:11:09.07,0:11:12.07,Default,,0000,0000,0000,,Хмф! Уф...
Dialogue: 0,0:11:09.07,0:11:12.07,Default,,0000,0000,0000,,
Dialogue: 0,0:11:12.07,0:11:15.07,Default,,0000,0000,0000,,⚟Иә Иә.
Dialogue: 0,0:11:15.07,0:11:17.08,Default,,0000,0000,0000,,Мен үйдемін!
Dialogue: 0,0:11:15.07,0:11:17.08,Default,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,0:11:17.08,0:11:20.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:17.08,0:11:20.08,Default,,0000,0000,0000,,Менің әкем қонақта. ➡
Dialogue: 0,0:11:20.08,0:11:22.05,Default,,0000,0000,0000,,Маған өтуге рұқсат етіңіз.
Dialogue: 0,0:11:25.08,0:11:28.05,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:11:32.02,0:11:35.03,Default,,0000,0000,0000,,De!
Dialogue: 0,0:11:35.03,0:11:37.03,Default,,0000,0000,0000,,Глорио келді.
Dialogue: 0,0:11:37.03,0:11:40.00,Default,,0000,0000,0000,,Хмф... Келдің бе?
Dialogue: 0,0:12:12.06,0:12:16.07,Default,,0000,0000,0000,,Сиқыр
Dialogue: 0,0:12:12.06,0:12:16.07,Default,,0000,0000,0000,,Сәлем Маджин Буу
Dialogue: 0,0:12:12.06,0:12:16.07,Default,,0000,0000,0000,,Жеңуге жеткілікті күшті біреу➡
Dialogue: 0,0:12:16.07,0:12:18.07,Default,,0000,0000,0000,,Сіз мені әкелемін дедіңіз.
Dialogue: 0,0:12:18.07,0:12:21.07,Default,,0000,0000,0000,,Бұл екі адам.
Dialogue: 0,0:12:21.07,0:12:25.08,Default,,0000,0000,0000,,Хмм? Ол жай ғана бала!
Dialogue: 0,0:12:25.08,0:12:29.08,Default,,0000,0000,0000,,Мен Гоку сияқты жақсы емеспін.
Dialogue: 0,0:12:25.08,0:12:29.08,Default,,0000,0000,0000,,Жоқ, бірақ жолсерікпен.
Dialogue: 0,0:12:29.08,0:12:34.02,Default,,0000,0000,0000,,Мен оның әскери полицияны жеңгенін көрдім.
Dialogue: 0,0:12:29.08,0:12:34.02,Default,,0000,0000,0000,,Бұл керемет күш.
Dialogue: 0,0:12:34.02,0:12:36.02,Default,,0000,0000,0000,,Хмм? Бұл рас па?
Dialogue: 0,0:12:36.02,0:12:39.02,Default,,0000,0000,0000,,Иә, олар маған көмектесті.
Dialogue: 0,0:12:39.02,0:12:41.03,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:12:41.03,0:12:47.03,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:12:41.03,0:12:47.03,Default,,0000,0000,0000,,Панджиге қамқорлық жасалды.
Dialogue: 0,0:12:47.03,0:12:51.04,Default,,0000,0000,0000,,Әкең сұрады.
Dialogue: 0,0:12:47.03,0:12:51.04,Default,,0000,0000,0000,,Гоку мен басқаларды әкел.
Dialogue: 0,0:12:51.04,0:12:54.04,Default,,0000,0000,0000,,Жоқ, бұл Глорио жігіті➡
Dialogue: 0,0:12:54.04,0:12:57.04,Default,,0000,0000,0000,,Гомерді кім жеңе алады
Dialogue: 0,0:12:54.04,0:12:57.04,Default,,0000,0000,0000,,Мен сені әкелемін дедім. ➡
Dialogue: 0,0:12:57.04,0:13:01.05,Default,,0000,0000,0000,,Сыртқы әлемнен.
Dialogue: 0,0:13:01.05,0:13:05.05,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:13:01.05,0:13:05.05,Default,,0000,0000,0000,,Сіз сыртқы әлемнен келдіңіз бе? ? ➡
Dialogue: 0,0:13:05.05,0:13:09.05,Default,,0000,0000,0000,,Мен бұл біртүрлі болды деп ойладым.
Dialogue: 0,0:13:05.05,0:13:09.05,Default,,0000,0000,0000,,Құлағың домалақ екен ғой!
Dialogue: 0,0:13:09.05,0:13:11.06,Default,,0000,0000,0000,,Хехе, жақсы.
Dialogue: 0,0:13:11.06,0:13:15.06,Default,,0000,0000,0000,,Неліктен сыртқы әлемнен?
Dialogue: 0,0:13:11.06,0:13:15.06,Default,,0000,0000,0000,,Сіз соншалықты күштісіз бе?
Dialogue: 0,0:13:15.06,0:13:19.06,Default,,0000,0000,0000,,Сіз тіпті аспанда ұша аласыз.
Dialogue: 0,0:13:15.06,0:13:19.06,Default,,0000,0000,0000,,Сондықтан мен жаттықтым.
Dialogue: 0,0:13:19.06,0:13:23.07,Default,,0000,0000,0000,,Маған Гомерді жеңу бұйырды.
Dialogue: 0,0:13:19.06,0:13:23.07,Default,,0000,0000,0000,,Бұл сіздің өтінішіңіз бе?
Dialogue: 0,0:13:23.07,0:13:26.07,Default,,0000,0000,0000,,Мен өлсем бола ма?
Dialogue: 0,0:13:23.07,0:13:26.07,Default,,0000,0000,0000,,Мен оны кешіре алмаймын... ➡
Dialogue: 0,0:13:26.07,0:13:29.07,Default,,0000,0000,0000,,Гомер
Dialogue: 0,0:13:26.07,0:13:29.07,Default,,0000,0000,0000,,Ұлы Жын патшасы болмауы керек зұлым адам.
Dialogue: 0,0:13:29.07,0:13:34.01,Default,,0000,0000,0000,,Егер сіз оны жеңсеңіз
Dialogue: 0,0:13:29.07,0:13:34.01,Default,,0000,0000,0000,,Ұлы жын әлеміндегі бейбітшілік үшін➡
Dialogue: 0,0:13:34.01,0:13:37.02,Default,,0000,0000,0000,,Мен Ұлы Жын патшасы боламын!
Dialogue: 0,0:13:37.02,0:13:39.02,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:13:39.02,0:13:42.02,Default,,0000,0000,0000,,Гоку.
Dialogue: 0,0:13:39.02,0:13:42.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:42.02,0:13:46.03,Default,,0000,0000,0000,,Егер істер жақсы болса
Dialogue: 0,0:13:42.02,0:13:46.03,Default,,0000,0000,0000,,Мен сені Панцидің күйеу баласы етемін.
Dialogue: 0,0:13:46.03,0:13:48.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:46.03,0:13:48.03,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:13:48.03,0:13:50.03,Default,,0000,0000,0000,,Кішкене ғана➡
Dialogue: 0,0:13:50.03,0:13:52.03,Default,,0000,0000,0000,,Шешпе, әке!
Dialogue: 0,0:13:52.03,0:13:57.04,Default,,0000,0000,0000,,Дәл қазір емес.
Dialogue: 0,0:13:52.03,0:13:57.04,Default,,0000,0000,0000,,Тек өскенде ғана.
Dialogue: 0,0:13:57.04,0:14:01.04,Default,,0000,0000,0000,,Мм... эй, мен тұрмыстамын.
Dialogue: 0,0:13:57.04,0:14:01.04,Default,,0000,0000,0000,,Менің де балаларым бар.
Dialogue: 0,0:14:01.04,0:14:04.04,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:14:04.04,0:14:08.05,Default,,0000,0000,0000,,А... сен ересек адам едің ғой! ?
Dialogue: 0,0:14:04.04,0:14:08.05,Default,,0000,0000,0000,,Балаларға ұқсайтын жарыс! ?
Dialogue: 0,0:14:08.05,0:14:10.05,Default,,0000,0000,0000,,Мен және Гоку-сан➡
Dialogue: 0,0:14:10.05,0:14:13.05,Default,,0000,0000,0000,,Гомердің арқасында
Dialogue: 0,0:14:10.05,0:14:13.05,Default,,0000,0000,0000,,Балаға айналды.
Dialogue: 0,0:14:13.05,0:14:15.05,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:14:15.05,0:14:18.06,Default,,0000,0000,0000,,(Кайошин)
Dialogue: 0,0:14:15.05,0:14:18.06,Default,,0000,0000,0000,,Сонымен түпнұсқаға оралу үшін ➡
Dialogue: 0,0:14:18.06,0:14:22.06,Default,,0000,0000,0000,,Оның аты Дэнди, оны Гомер ұрлап кеткен.
Dialogue: 0,0:14:18.06,0:14:22.06,Default,,0000,0000,0000,,Намекиялық балаға көмектесесіз бе➡
Dialogue: 0,0:14:22.06,0:14:25.06,Default,,0000,0000,0000,,Жындар әлемінің айдаһар шары
Dialogue: 0,0:14:22.06,0:14:25.06,Default,,0000,0000,0000,,Жиналу керек.
Dialogue: 0,0:14:25.06,0:14:27.07,Default,,0000,0000,0000,,(Пандж Кадан патша)
Dialogue: 0,0:14:25.06,0:14:27.07,Default,,0000,0000,0000,,Иә! ? Айдаһар добы! ?
Dialogue: 0,0:14:27.07,0:14:29.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:29.07,0:14:33.01,Default,,0000,0000,0000,,Жоқ, сен
Dialogue: 0,0:14:29.07,0:14:33.01,Default,,0000,0000,0000,,Тамагамимен күресуді жоспарлап отырсыз ба? ?
Dialogue: 0,0:14:33.01,0:14:35.01,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:14:35.01,0:14:37.01,Default,,0000,0000,0000,,Эй, эй, эй….
Dialogue: 0,0:14:37.01,0:14:40.01,Default,,0000,0000,0000,,Мұндай ақымақ нәрсе
Dialogue: 0,0:14:37.01,0:14:40.01,Default,,0000,0000,0000,,Сіз мұны жоспарладыңыз ба?
Dialogue: 0,0:14:40.01,0:14:43.02,Default,,0000,0000,0000,,Үшпен оңай көрінеді.
Dialogue: 0,0:14:43.02,0:14:45.02,Default,,0000,0000,0000,,У... Уа, түсінемін...
Dialogue: 0,0:14:45.02,0:14:47.02,Default,,0000,0000,0000,,Әзірге
Dialogue: 0,0:14:45.02,0:14:47.02,Default,,0000,0000,0000,,Жындар әлемінің айдаһар шары➡
Dialogue: 0,0:14:47.02,0:14:49.02,Default,,0000,0000,0000,,Кімде үшеуі бар
Dialogue: 0,0:14:47.02,0:14:49.02,Default,,0000,0000,0000,,Ол жоқ. ➡
Dialogue: 0,0:14:49.02,0:14:51.02,Default,,0000,0000,0000,,Тамагами
Dialogue: 0,0:14:49.02,0:14:51.02,Default,,0000,0000,0000,,Өйткені ол тым күшті➡
Dialogue: 0,0:14:51.02,0:14:53.03,Default,,0000,0000,0000,,Оны тіпті Гомар да жинай алмады.
Dialogue: 0,0:14:53.03,0:14:56.03,Default,,0000,0000,0000,,Әйтеуір жақсы болады.
Dialogue: 0,0:14:56.03,0:14:59.03,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:14:56.03,0:14:59.03,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:14:59.03,0:15:02.03,Default,,0000,0000,0000,,《Жоқ...
Dialogue: 0,0:14:59.03,0:15:02.03,Default,,0000,0000,0000,,Маджин Бууды жеңген деген қауесет бар➡
Dialogue: 0,0:15:02.03,0:15:05.04,Default,,0000,0000,0000,,Егер бұл рас болса... Ммм...➡
Dialogue: 0,0:15:05.04,0:15:09.04,Default,,0000,0000,0000,,Бұл мүлдем мүмкін емес болса да
Dialogue: 0,0:15:05.04,0:15:09.04,Default,,0000,0000,0000,,Мүмкін емес...》
Dialogue: 0,0:15:09.04,0:15:13.05,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:15:09.04,0:15:13.05,Default,,0000,0000,0000,,Мүмкін болса, ұшақ болса➡
Dialogue: 0,0:15:13.05,0:15:17.05,Default,,0000,0000,0000,,Сіз маған біреуін бере аласыз ба?
Dialogue: 0,0:15:13.05,0:15:17.05,Default,,0000,0000,0000,,Біздікі ұрланған.
Dialogue: 0,0:15:17.05,0:15:19.05,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:15:19.05,0:15:21.05,Default,,0000,0000,0000,,Бірақ бұған дейін➡
Dialogue: 0,0:15:21.05,0:15:24.06,Default,,0000,0000,0000,,Мен сенің соншалықты күшті екеніңе сене алар емеспін
Dialogue: 0,0:15:21.05,0:15:24.06,Default,,0000,0000,0000,,Мен әлі де сене алар емеспін.
Dialogue: 0,0:15:24.06,0:15:27.06,Default,,0000,0000,0000,,Мен қарап шыға аламын ба?
Dialogue: 0,0:15:27.06,0:15:29.06,Default,,0000,0000,0000,,О, жақсы!
Dialogue: 0,0:15:29.06,0:15:34.03,Default,,0000,0000,0000,,(Труба дыбысы)
Dialogue: 0,0:15:36.07,0:15:38.07,Default,,0000,0000,0000,,Ей, балалар, мұқият тыңдаңдар! ➡
Dialogue: 0,0:15:38.07,0:15:44.08,Default,,0000,0000,0000,,Бұл Гоку-сан кішкентай болып көрінсе де,
Dialogue: 0,0:15:38.07,0:15:44.08,Default,,0000,0000,0000,,Әлемдегі ең жақсы жауынгер!
Dialogue: 0,0:15:44.08,0:15:48.08,Default,,0000,0000,0000,,Бірден төбелесіп, жеңсең
Dialogue: 0,0:15:44.08,0:15:48.08,Default,,0000,0000,0000,,Жалақы өсті!
Dialogue: 0,0:15:48.08,0:15:50.08,Default,,0000,0000,0000,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:15:50.08,0:15:52.08,Default,,0000,0000,0000,,Мұнда
Dialogue: 0,0:15:50.08,0:15:52.08,Default,,0000,0000,0000,,Көп адамға ұқсайды.
Dialogue: 0,0:15:52.08,0:15:55.09,Default,,0000,0000,0000,,Менің көңіл-күйім жоқ, бірақ
Dialogue: 0,0:15:52.08,0:15:55.09,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:15:55.09,0:15:58.09,Default,,0000,0000,0000,,Жарайды. Жақсы жаттығу болады.
Dialogue: 0,0:15:58.09,0:16:01.09,Default,,0000,0000,0000,,Тыңдаңыз! Берілмеңіз, бар күшіңізді салыңыз!
Dialogue: 0,0:16:01.09,0:16:04.10,Default,,0000,0000,0000,,Бірақ өлтіруге болмайды!
Dialogue: 0,0:16:01.09,0:16:04.10,Default,,0000,0000,0000,,Қаруыңызды қойыңыз!
Dialogue: 0,0:16:04.10,0:16:06.10,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:16:06.10,0:16:10.10,Default,,0000,0000,0000,,Бұл жаттығу емес, мылтықтан басқа ештеңе емес.
Dialogue: 0,0:16:06.10,0:16:10.10,Default,,0000,0000,0000,,Шу... жаттығу?
Dialogue: 0,0:16:10.10,0:16:14.11,Default,,0000,0000,0000,,Сіз баласыз.
Dialogue: 0,0:16:10.10,0:16:14.11,Default,,0000,0000,0000,,Өкінбе.
Dialogue: 0,0:16:14.11,0:16:16.08,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:16:24.12,0:16:26.12,Default,,0000,0000,0000,,Кез келген уақыт жақсы.
Dialogue: 0,0:16:26.12,0:16:30.12,Default,,0000,0000,0000,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:16:30.12,0:16:33.09,Default,,0000,0000,0000,,Ура! Ха! Жеңілдік!
Dialogue: 0,0:16:37.06,0:16:39.06,Default,,0000,0000,0000,,Ха! көзқарас!
Dialogue: 0,0:16:39.06,0:16:41.07,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:16:41.07,0:16:43.07,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:41.07,0:16:43.07,Default,,0000,0000,0000,,Бір... күшті.
Dialogue: 0,0:16:43.07,0:16:46.07,Default,,0000,0000,0000,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:16:43.07,0:16:46.07,Default,,0000,0000,0000,,Иә! Ха!
Dialogue: 0,0:16:46.07,0:16:48.07,Default,,0000,0000,0000,,Иә! Тат! Тат!
Dialogue: 0,0:16:48.07,0:16:50.04,Default,,0000,0000,0000,,Tah!
Dialogue: 0,0:16:53.08,0:16:58.08,Default,,0000,0000,0000,,(Жындардың айқайы)
Dialogue: 0,0:16:58.08,0:17:00.05,Default,,0000,0000,0000,,Тория! Тах!
Dialogue: 0,0:17:02.09,0:17:04.09,Default,,0000,0000,0000,,Иә! Да-да-да-да-да!
Dialogue: 0,0:17:04.09,0:17:06.09,Default,,0000,0000,0000,,Қолдарыңызды және аяқтарыңызды ұстаңыз!
Dialogue: 0,0:17:06.09,0:17:08.09,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:17:06.09,0:17:08.09,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:17:08.09,0:17:10.10,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:17:10.10,0:17:13.10,Default,,0000,0000,0000,,Хааааа!
Dialogue: 0,0:17:13.10,0:17:15.07,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:21.11,0:17:23.11,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:17:23.11,0:17:26.11,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:17:26.11,0:17:28.11,Default,,0000,0000,0000,,Мамма миа, мен бара жатырмын
Dialogue: 0,0:17:28.11,0:17:30.12,Default,,0000,0000,0000,,...
Dialogue: 0,0:17:30.12,0:17:33.05,Default,,0000,0000,0000,,Ал Хинацуру…
Dialogue: 0,0:17:33.05,0:17:35.05,Default,,0000,0000,0000,,Иә? иә? Ха... ➡
Dialogue: 0,0:17:35.05,0:17:38.06,Default,,0000,0000,0000,,Міне, келдік!
Dialogue: 0,0:17:38.06,0:17:40.39,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:38.06,0:17:40.39,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:17:40.39,0:17:43.06,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:40.39,0:17:43.06,Default,,0000,0000,0000,,Не... не!
Dialogue: 0,0:17:43.06,0:17:45.06,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:17:45.06,0:17:48.07,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:17:48.07,0:17:51.07,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:17:48.07,0:17:51.07,Default,,0000,0000,0000,,Тек осындай тозған ұшақ➡
Dialogue: 0,0:17:51.07,0:17:53.07,Default,,0000,0000,0000,,Мен оны дайындай алмаймын.
Dialogue: 0,0:17:53.07,0:17:55.07,Default,,0000,0000,0000,,Жоқ, жеткілікті.
Dialogue: 0,0:17:55.07,0:17:57.08,Default,,0000,0000,0000,,Оның орнына су немесе алкоголь➡
Dialogue: 0,0:17:57.08,0:18:01.08,Default,,0000,0000,0000,,Азық-түлік қаруы
Dialogue: 0,0:17:57.08,0:18:01.08,Default,,0000,0000,0000,,Ұйықтау қапшығын пайдаланыңыз.
Dialogue: 0,0:18:01.08,0:18:03.08,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:18:03.08,0:18:06.09,Default,,0000,0000,0000,,Сәлем. Деректерді қайта жазу
Dialogue: 0,0:18:03.08,0:18:06.09,Default,,0000,0000,0000,,Бітірдің бе?
Dialogue: 0,0:18:06.09,0:18:08.09,Default,,0000,0000,0000,,Керемет.
Dialogue: 0,0:18:08.09,0:18:10.09,Default,,0000,0000,0000,,Қайта жазу дегенді қалай түсінесіңдер?
Dialogue: 0,0:18:10.09,0:18:14.09,Default,,0000,0000,0000,,Glorio және тіркеген ұшақ
Dialogue: 0,0:18:10.09,0:18:14.09,Default,,0000,0000,0000,,Өйткені заттар өзгерді.
Dialogue: 0,0:18:14.09,0:18:18.10,Default,,0000,0000,0000,,Бұдан былай ол бірдей PIN нөмірі болады.
Dialogue: 0,0:18:14.09,0:18:18.10,Default,,0000,0000,0000,,Варп-сама мені өткізбейді.
Dialogue: 0,0:18:18.10,0:18:22.10,Default,,0000,0000,0000,,Сонымен, деректер
Dialogue: 0,0:18:18.10,0:18:22.10,Default,,0000,0000,0000,,Кішкене...
Dialogue: 0,0:18:22.10,0:18:25.10,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:18:22.10,0:18:25.10,Default,,0000,0000,0000,,Аа, дұрыс, солай➡
Dialogue: 0,0:18:25.10,0:18:28.11,Default,,0000,0000,0000,,Тағы неше күн?
Dialogue: 0,0:18:25.10,0:18:28.11,Default,,0000,0000,0000,,Біздің достар➡
Dialogue: 0,0:18:28.11,0:18:30.11,Default,,0000,0000,0000,,Қолдау үшін
Dialogue: 0,0:18:28.11,0:18:30.11,Default,,0000,0000,0000,,Олар сізге асығыс жетуі керек.
Dialogue: 0,0:18:30.11,0:18:33.05,Default,,0000,0000,0000,,Хохо….
Dialogue: 0,0:18:30.11,0:18:33.05,Default,,0000,0000,0000,,Бірақ олар ➡
Dialogue: 0,0:18:33.05,0:18:37.05,Default,,0000,0000,0000,,Мен PIN кодымды білмеймін.
Dialogue: 0,0:18:33.05,0:18:37.05,Default,,0000,0000,0000,,Біз бірдеңе істей аламыз ба?
Dialogue: 0,0:18:37.05,0:18:42.05,Default,,0000,0000,0000,,PIN код жоқ па?
Dialogue: 0,0:18:37.05,0:18:42.05,Default,,0000,0000,0000,,Күткендей бұл мүмкін емес...
Dialogue: 0,0:18:42.05,0:18:44.06,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:18:44.06,0:18:46.06,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:44.06,0:18:46.06,Default,,0000,0000,0000,,Хо~ Хо~.
Dialogue: 0,0:18:46.06,0:18:49.06,Default,,0000,0000,0000,,(Кадан патша)
Dialogue: 0,0:18:46.06,0:18:49.06,Default,,0000,0000,0000,,Эй Хивис, сен не істеп жатырсың?
Dialogue: 0,0:18:49.06,0:18:52.06,Default,,0000,0000,0000,,Балет сабақтары.
Dialogue: 0,0:18:49.06,0:18:52.06,Default,,0000,0000,0000,,Бір сәт осында келіңіз.
Dialogue: 0,0:18:52.06,0:18:56.07,Default,,0000,0000,0000,,Иә... иә.
Dialogue: 0,0:18:52.06,0:18:56.07,Default,,0000,0000,0000,,Бұл азап.
Dialogue: 0,0:18:56.07,0:19:00.07,Default,,0000,0000,0000,,Сіз сыртқы әлемге барасыз
Dialogue: 0,0:18:56.07,0:19:00.07,Default,,0000,0000,0000,,Мына қонақтың серігін әкеліңізші.
Dialogue: 0,0:19:00.07,0:19:03.08,Default,,0000,0000,0000,,Иә? Енді? Мен?
Dialogue: 0,0:19:03.08,0:19:07.08,Default,,0000,0000,0000,,Иә. Егер ол сен болсаң
Dialogue: 0,0:19:03.08,0:19:07.08,Default,,0000,0000,0000,,Олар аса сақ болмайтын шығар.
Dialogue: 0,0:19:07.08,0:19:10.05,Default,,0000,0000,0000,,Мен қазір шаштаразға баруды ойлап жүрмін.
Dialogue: 0,0:19:12.08,0:19:14.09,Default,,0000,0000,0000,,Мұны қалдырыңыз!
Dialogue: 0,0:19:14.09,0:19:17.09,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес. Сыртқы әлемде қайда?
Dialogue: 0,0:19:17.09,0:19:20.09,Default,,0000,0000,0000,,Бұл 7 Ғаламдағы Жер планетасы.
Dialogue: 0,0:19:20.09,0:19:23.10,Default,,0000,0000,0000,,Аспанда қалқып тұрған ғибадатханада
Dialogue: 0,0:19:20.09,0:19:23.10,Default,,0000,0000,0000,,Барлығы.
Dialogue: 0,0:19:23.10,0:19:28.07,Default,,0000,0000,0000,,Ібіліс ғибадатханаға бара жатыр.
Dialogue: 0,0:19:23.10,0:19:28.07,Default,,0000,0000,0000,,Сіз соншалықты абайсыздасыз.
Dialogue: 0,0:19:30.10,0:19:32.04,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:19:30.10,0:19:32.04,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:32.04,0:19:35.04,Default,,0000,0000,0000,,Бұл ма?
Dialogue: 0,0:19:32.04,0:19:35.04,Default,,0000,0000,0000,,Әй, міне!
Dialogue: 0,0:19:35.04,0:19:38.04,Default,,0000,0000,0000,,Ол алыс.
Dialogue: 0,0:19:35.04,0:19:38.04,Default,,0000,0000,0000,,Сіз қанша адам әкелесіз?
Dialogue: 0,0:19:38.04,0:19:41.05,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:19:38.04,0:19:41.05,Default,,0000,0000,0000,,Шамамен үш-төрт адам.
Dialogue: 0,0:19:41.05,0:19:45.05,Default,,0000,0000,0000,,Менде орташа өлшемді ұшақ бар.
Dialogue: 0,0:19:41.05,0:19:45.05,Default,,0000,0000,0000,,Қазір кішкентайлары ғана бар.
Dialogue: 0,0:19:45.05,0:19:47.05,Default,,0000,0000,0000,,Түсіндім. Бірдеңе істейік.
Dialogue: 0,0:19:47.05,0:19:50.06,Default,,0000,0000,0000,,(айдаһар дыбысы)
Dialogue: 0,0:19:47.05,0:19:50.06,Default,,0000,0000,0000,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:19:50.06,0:19:53.06,Default,,0000,0000,0000,,Nemofiy бандасына барыңыз
Dialogue: 0,0:19:50.06,0:19:53.06,Default,,0000,0000,0000,,Маған орташа өлшемді ұшақ әкеліңіз!
Dialogue: 0,0:19:53.06,0:19:56.06,Default,,0000,0000,0000,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:19:56.06,0:19:59.06,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:19:56.06,0:19:59.06,Default,,0000,0000,0000,,Бұл біраз уақыт алады ➡
Dialogue: 0,0:19:59.06,0:20:01.07,Default,,0000,0000,0000,,Серіктеріңіз келгенше күткіңіз келе ме?
Dialogue: 0,0:20:01.07,0:20:03.04,Default,,0000,0000,0000,,Біз кейінірек кездесе аламыз.
Dialogue: 0,0:20:05.07,0:20:09.07,Default,,0000,0000,0000,,Иә? Пунду!
Dialogue: 0,0:20:05.07,0:20:09.07,Default,,0000,0000,0000,,Бұл не жүк?
Dialogue: 0,0:20:09.07,0:20:11.08,Default,,0000,0000,0000,,Мен де барамын.
Dialogue: 0,0:20:11.08,0:20:14.08,Default,,0000,0000,0000,,Барсаң да, жолыңды кесіп жібересің!
Dialogue: 0,0:20:14.08,0:20:17.08,Default,,0000,0000,0000,,Гомерді жеңгеніңді көргім келеді.
Dialogue: 0,0:20:17.08,0:20:21.09,Default,,0000,0000,0000,,Оның үстіне мен механиктермен мықтымын.
Dialogue: 0,0:20:17.08,0:20:21.09,Default,,0000,0000,0000,,Менің де құпия қаруым бар.
Dialogue: 0,0:20:21.09,0:20:24.09,Default,,0000,0000,0000,,Осы ескі ұшақ бұзылса ше?
Dialogue: 0,0:20:21.09,0:20:24.09,Default,,0000,0000,0000,,Сіз қиындыққа тап боласыз.
Dialogue: 0,0:20:24.09,0:20:26.09,Default,,0000,0000,0000,,Бірақ... Бірақ...
Dialogue: 0,0:20:26.09,0:20:30.10,Default,,0000,0000,0000,,Эй, Горилло, сен механиктерге қарсысың ба?
Dialogue: 0,0:20:30.10,0:20:34.03,Default,,0000,0000,0000,,Бұл Глорио.
Dialogue: 0,0:20:30.10,0:20:34.03,Default,,0000,0000,0000,,Меха соншалықты керемет емес...
Dialogue: 0,0:20:34.03,0:20:37.04,Default,,0000,0000,0000,,Өзің бар
Dialogue: 0,0:20:34.03,0:20:37.04,Default,,0000,0000,0000,,Панджи менімен бірге болса пайдалы болар еді.
Dialogue: 0,0:20:37.04,0:20:41.04,Default,,0000,0000,0000,,Хэхе Гоку
Dialogue: 0,0:20:37.04,0:20:41.04,Default,,0000,0000,0000,,Сіз оқиғаны түсіндіңіз бе? Хехе.
Dialogue: 0,0:20:41.04,0:20:43.04,Default,,0000,0000,0000,,Хмм… Хмм….
Dialogue: 0,0:20:43.04,0:20:47.01,Default,,0000,0000,0000,,Қауіпті болса, жарайды.
Dialogue: 0,0:20:43.04,0:20:47.01,Default,,0000,0000,0000,,Ола сізді қорғайды.
Dialogue: 0,0:20:55.05,0:20:58.02,Default,,0000,0000,0000,,Хах.
Dialogue: 0,0:20:55.05,0:20:58.02,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:21:00.06,0:21:02.06,Default,,0000,0000,0000,,Хмм… ммм….
Dialogue: 0,0:21:02.06,0:21:05.06,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:21:05.06,0:21:09.07,Default,,0000,0000,0000,,Кездескенше, әке.
Dialogue: 0,0:21:05.06,0:21:09.07,Default,,0000,0000,0000,,О, абай бол.
Dialogue: 0,0:21:09.07,0:21:11.07,Default,,0000,0000,0000,,Гоку мырза.
Dialogue: 0,0:21:11.07,0:21:14.07,Default,,0000,0000,0000,,Өйткені, Глорио мырза
Dialogue: 0,0:21:11.07,0:21:14.07,Default,,0000,0000,0000,,Сіз бірдеңені жасырып отырсыз.
Dialogue: 0,0:21:14.07,0:21:16.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:16.07,0:21:18.08,Default,,0000,0000,0000,,Кадан патша
Dialogue: 0,0:21:16.07,0:21:18.08,Default,,0000,0000,0000,,Біз кішірейіп қалдық➡
Dialogue: 0,0:21:18.08,0:21:20.08,Default,,0000,0000,0000,,Мен мұны білмедім.
Dialogue: 0,0:21:20.08,0:21:23.08,Default,,0000,0000,0000,,Оның үстіне патша маған мұны істеуді өтінді.
Dialogue: 0,0:21:20.08,0:21:23.08,Default,,0000,0000,0000,,Мен айтқанымдай➡
Dialogue: 0,0:21:23.08,0:21:25.08,Default,,0000,0000,0000,,Әңгімені әкелген адам➡ болды
Dialogue: 0,0:21:25.08,0:21:27.09,Default,,0000,0000,0000,,Бұл Глорио мырза болатын.
Dialogue: 0,0:21:25.08,0:21:27.09,Default,,0000,0000,0000,,Солай емес пе?
Dialogue: 0,0:21:27.09,0:21:32.02,Default,,0000,0000,0000,,Мен түсінемін, бірақ...
Dialogue: 0,0:21:27.09,0:21:32.02,Default,,0000,0000,0000,,Жақсы, екеуі де жақсы, солай ма?
Dialogue: 0,0:21:32.02,0:21:34.03,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:21:32.02,0:21:34.03,Default,,0000,0000,0000,,⚟ (аяқ дыбысы)
Dialogue: 0,0:21:34.03,0:21:37.03,Default,,0000,0000,0000,,Тезірек, кеттік.
Dialogue: 0,0:21:34.03,0:21:37.03,Default,,0000,0000,0000,,О.
Dialogue: 0,0:21:37.03,0:21:40.03,Default,,0000,0000,0000,,Мм... Пікір!
Dialogue: 0,0:21:40.03,0:21:42.03,Default,,0000,0000,0000,,Багаж Менде тым көп жүк бар.
Dialogue: 0,0:21:42.03,0:21:45.04,Default,,0000,0000,0000,,Абайлаңыз, Панджи!
Dialogue: 0,0:21:45.04,0:21:47.04,Default,,0000,0000,0000,,Жарайды, мен келемін.
Dialogue: 0,0:21:47.04,0:21:49.01,Default,,0000,0000,0000,,Мен оны сұрадым!
Dialogue: 0,0:21:51.04,0:21:53.01,Default,,0000,0000,0000,,Кету уақыты келді.
Dialogue: 0,0:21:59.05,0:22:03.06,Default,,0000,0000,0000,,Ханшайым!
Dialogue: 0,0:21:59.05,0:22:03.06,Default,,0000,0000,0000,,Түсінгенше көрсетемін
Dialogue: 0,0:22:03.06,0:22:06.06,Default,,0000,0000,0000,,Осы жын әлеміндегі Айдаһар шарларына дейін
Dialogue: 0,0:22:03.06,0:22:06.06,Default,,0000,0000,0000,,Бұл алыс па?
Dialogue: 0,0:22:06.06,0:22:10.06,Default,,0000,0000,0000,,Үзілістерді қоса
Dialogue: 0,0:22:06.06,0:22:10.06,Default,,0000,0000,0000,,Шамамен төрт күн қалды.
Dialogue: 0,0:22:10.06,0:22:13.07,Default,,0000,0000,0000,,Шынымен! ?
Dialogue: 0,0:22:10.06,0:22:13.07,Default,,0000,0000,0000,,Сіз жай ғана тыныш жүресіз ...
Dialogue: 0,0:22:13.07,0:22:17.07,Default,,0000,0000,0000,,Үшінші жын әлемі жындар әлемінде
Dialogue: 0,0:22:13.07,0:22:17.07,Default,,0000,0000,0000,,Бұл ең үлкені.
Dialogue: 0,0:22:17.07,0:22:20.07,Default,,0000,0000,0000,,4 күн бойы шыдамды болыңыз.
Dialogue: 0,0:22:20.07,0:22:22.07,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:22:22.07,0:22:24.08,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:22:24.08,0:22:26.04,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:29.08,0:22:31.02,Default,,0000,0000,0000,,А, қозғалтқыш қорқынышты көрінеді!
Dialogue: 0,0:22:31.02,0:22:33.02,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:22:33.02,0:22:36.02,Default,,0000,0000,0000,,Тозып кетсе де
Dialogue: 0,0:22:33.02,0:22:36.02,Default,,0000,0000,0000,,Менің ойымша, мен тым көп жүк алып кеттім.
Dialogue: 0,0:22:36.02,0:22:37.99,Default,,0000,0000,0000,,Мықтап ұстаңыз!
Dialogue: 0,0:22:41.03,0:22:42.99,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:50.04,0:23:00.01,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:01.51,0:23:07.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory