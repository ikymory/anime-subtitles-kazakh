Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.04,0:00:06.04,Default,,0000,0000,0000,,[Айдаһар шары дегеніміз не?
Dialogue: 0,0:00:02.04,0:00:06.04,Default,,0000,0000,0000,,7 бөлікті жинап, құпия сөзді айт➡
Dialogue: 0,0:00:06.04,0:00:09.04,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:00:06.04,0:00:09.04,Default,,0000,0000,0000,,Айдаһар
Dialogue: 0,0:00:06.04,0:00:09.04,Default,,0000,0000,0000,,Шенрон атты айдаһар пайда болады➡
Dialogue: 0,0:00:09.04,0:00:14.05,Default,,0000,0000,0000,,Кез келген тілек орындалады
Dialogue: 0,0:00:09.04,0:00:14.05,Default,,0000,0000,0000,,Бұл жұмбақ доп]
Dialogue: 0,0:00:14.05,0:00:18.05,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:00:14.05,0:00:18.05,Default,,0000,0000,0000,,Гоку
Dialogue: 0,0:00:14.05,0:00:18.05,Default,,0000,0000,0000,,[Бұл Сон Гоку адам
Dialogue: 0,0:00:14.05,0:00:18.05,Default,,0000,0000,0000,,Сабырлы болып көрінсе де➡
Dialogue: 0,0:00:18.05,0:00:24.06,Default,,0000,0000,0000,,Ерекше күші бар жауынгер жарысы
Dialogue: 0,0:00:18.05,0:00:24.06,Default,,0000,0000,0000,,Ол – Сайян]
Dialogue: 0,0:00:24.06,0:00:28.06,Default,,0000,0000,0000,,[Достармен кездесу]
Dialogue: 0,0:00:24.06,0:00:28.06,Default,,0000,0000,0000,,Бірге шытырман оқиға➡
Dialogue: 0,0:00:28.06,0:00:32.07,Default,,0000,0000,0000,,Ересек болып өсу]
Dialogue: 0,0:00:32.07,0:00:40.07,Default,,0000,0000,0000,,[және қазір де зұлымдық қолынан]
Dialogue: 0,0:00:32.07,0:00:40.07,Default,,0000,0000,0000,,Жерді қорғауды жалғастыру]
Dialogue: 0,0:00:40.07,0:00:50.05,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:22.01,0:02:25.01,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:02:22.01,0:02:25.01,Default,,0000,0000,0000,,(Фушигуро) Ол іссапарда. (Итадори) Ә?
Dialogue: 0,0:02:25.01,0:02:28.01,Default,,0000,0000,0000,,Көзді ашып-жұмғанша жер
Dialogue: 0,0:02:25.01,0:02:28.01,Default,,0000,0000,0000,,Мен енді көре алмаймын.
Dialogue: 0,0:02:28.01,0:02:30.95,Default,,0000,0000,0000,,Жындар әлемінің жазықтығы
Dialogue: 0,0:02:28.01,0:02:30.95,Default,,0000,0000,0000,,Өйткені ол сиқырдан қуат алады➡
Dialogue: 0,0:02:30.95,0:02:32.95,Default,,0000,0000,0000,,Бұл өте жылдам.
Dialogue: 0,0:02:32.95,0:02:34.95,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:02:34.95,0:02:36.96,Default,,0000,0000,0000,,Варп-саманың орнында
Dialogue: 0,0:02:34.95,0:02:36.96,Default,,0000,0000,0000,,Сіз барасыз ба?
Dialogue: 0,0:02:36.96,0:02:38.96,Default,,0000,0000,0000,,А, бұл дұрыс.
Dialogue: 0,0:02:38.96,0:02:40.96,Default,,0000,0000,0000,,Warp-sama?
Dialogue: 0,0:02:40.96,0:02:44.96,Default,,0000,0000,0000,,Ұлы жын әлемі мен сыртқы әлемді байланыстыру
Dialogue: 0,0:02:40.96,0:02:44.96,Default,,0000,0000,0000,,Релелік нүкте. ➡
Dialogue: 0,0:02:44.96,0:02:48.97,Default,,0000,0000,0000,,Мен Варп-самадан өтуім керек.
Dialogue: 0,0:02:44.96,0:02:48.97,Default,,0000,0000,0000,,Сіз Ұлы Жындар әлеміне бара алмайсыз.
Dialogue: 0,0:02:48.97,0:02:50.97,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:02:50.97,0:02:55.98,Default,,0000,0000,0000,,Жерге ең жақын иілу
Dialogue: 0,0:02:50.97,0:02:55.98,Default,,0000,0000,0000,,Қайда?
Dialogue: 0,0:02:55.98,0:02:59.98,Default,,0000,0000,0000,,Мен сенімдімін... Ракка жүйесінде➡
Dialogue: 0,0:02:59.98,0:03:01.98,Default,,0000,0000,0000,,Батапе планетасының жанында.
Dialogue: 0,0:03:01.98,0:03:04.65,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:03:01.98,0:03:04.65,Default,,0000,0000,0000,,Ол сонда болды ма?
Dialogue: 0,0:03:04.65,0:03:06.32,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:04.65,0:03:06.32,Default,,0000,0000,0000,,(жарылған дыбыс)
Dialogue: 0,0:03:06.32,0:03:08.99,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:03:06.32,0:03:08.99,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:03:08.99,0:03:10.99,Default,,0000,0000,0000,,Глорио мырза, сіз➡сіз
Dialogue: 0,0:03:10.99,0:03:14.99,Default,,0000,0000,0000,,Ол маған Гоку-санды әкелуімді өтінді.
Dialogue: 0,0:03:10.99,0:03:14.99,Default,,0000,0000,0000,,Сіз осылай айттыңыз.
Dialogue: 0,0:03:14.99,0:03:18.00,Default,,0000,0000,0000,,Ах. Үшінші жын әлемінің жын патшасы сұраған.
Dialogue: 0,0:03:18.00,0:03:20.00,Default,,0000,0000,0000,,Гомер патшаны жеңу.
Dialogue: 0,0:03:20.00,0:03:24.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:20.00,0:03:24.00,Default,,0000,0000,0000,,Тамар патша ➡
Dialogue: 0,0:03:24.00,0:03:27.01,Default,,0000,0000,0000,,Таяқ
Dialogue: 0,0:03:24.00,0:03:27.01,Default,,0000,0000,0000,,Менің мықты болғанымды қалайсың ба?
Dialogue: 0,0:03:24.00,0:03:27.01,Default,,0000,0000,0000,,Бұл Гомер патша.
Dialogue: 0,0:03:27.01,0:03:31.95,Default,,0000,0000,0000,,Кішкентай, бірақ айлакер
Dialogue: 0,0:03:27.01,0:03:31.95,Default,,0000,0000,0000,,Үлкен сиқырлы күшке ие.
Dialogue: 0,0:03:31.95,0:03:34.95,Default,,0000,0000,0000,,Мажин
Dialogue: 0,0:03:31.95,0:03:34.95,Default,,0000,0000,0000,,Бірақ мен Маджин Бууды жеңдім.
Dialogue: 0,0:03:31.95,0:03:34.95,Default,,0000,0000,0000,,Сізге➡
Dialogue: 0,0:03:34.95,0:03:37.95,Default,,0000,0000,0000,,Сіз Гомер патшаны да жеңе аласыз
Dialogue: 0,0:03:34.95,0:03:37.95,Default,,0000,0000,0000,,Мұны жасауға болады.
Dialogue: 0,0:03:37.95,0:03:40.95,Default,,0000,0000,0000,,Ах. Ола және басқалар
Dialogue: 0,0:03:37.95,0:03:40.95,Default,,0000,0000,0000,,Дендеге тез көмектесіңіз➡
Dialogue: 0,0:03:40.95,0:03:43.96,Default,,0000,0000,0000,,Ол өзінің бастапқы түріне оралады деп үміттенемін.
Dialogue: 0,0:03:43.96,0:03:46.93,Default,,0000,0000,0000,,Кайошин
Dialogue: 0,0:03:43.96,0:03:46.93,Default,,0000,0000,0000,,Сәлем, Кай патша.
Dialogue: 0,0:03:51.97,0:03:54.97,Default,,0000,0000,0000,,Міне. Planet Butterpie.
Dialogue: 0,0:03:54.97,0:03:56.97,Default,,0000,0000,0000,,О?
Dialogue: 0,0:03:54.97,0:03:56.97,Default,,0000,0000,0000,,Мұнда➡
Dialogue: 0,0:03:56.97,0:03:58.97,Default,,0000,0000,0000,,Бір сәтке тоқтаңыз.
Dialogue: 0,0:03:58.97,0:04:00.97,Default,,0000,0000,0000,,Кибитоға, бұл жер.
Dialogue: 0,0:03:58.97,0:04:00.97,Default,,0000,0000,0000,,Мен саған үйретемін.
Dialogue: 0,0:04:00.97,0:04:02.94,Default,,0000,0000,0000,,​​Түсіндім.
Dialogue: 0,0:04:05.98,0:04:08.95,Default,,0000,0000,0000,,Бұл жақсы. Барайық.
Dialogue: 0,0:04:14.99,0:04:17.99,Default,,0000,0000,0000,,Не! ? Иә.
Dialogue: 0,0:04:17.99,0:04:19.99,Default,,0000,0000,0000,,Таңертең ерте тұрып-ақ қазірден-ақ қажырлы еңбек етіп жатырсың ғой.
Dialogue: 0,0:04:17.99,0:04:19.99,Default,,0000,0000,0000,,Бұл Warp-sama.
Dialogue: 0,0:04:19.99,0:04:22.96,Default,,0000,0000,0000,,бұл...
Dialogue: 0,0:04:25.00,0:04:28.00,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:04:28.00,0:04:30.97,Default,,0000,0000,0000,,Ха~ Мына үлкен алтын балықты қараңыз.
Dialogue: 0,0:04:32.94,0:04:34.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:34.94,0:04:37.94,Default,,0000,0000,0000,,Хаха, ескі алтын балық.
Dialogue: 0,0:04:37.94,0:04:39.95,Default,,0000,0000,0000,,Алтын балық емес.
Dialogue: 0,0:04:39.95,0:04:42.95,Default,,0000,0000,0000,,Қалай қарасаң да
Dialogue: 0,0:04:39.95,0:04:42.95,Default,,0000,0000,0000,,Бұл ескі алтын балық.
Dialogue: 0,0:04:42.95,0:04:45.95,Default,,0000,0000,0000,,Оны алтын балық деп атамаңыз!
Dialogue: 0,0:04:45.95,0:04:47.95,Default,,0000,0000,0000,,Ммм….
Dialogue: 0,0:04:47.95,0:04:50.96,Default,,0000,0000,0000,,Өйткені...
Dialogue: 0,0:04:47.95,0:04:50.96,Default,,0000,0000,0000,,Тыныш. Гоку мырза.
Dialogue: 0,0:04:50.96,0:04:53.96,Default,,0000,0000,0000,,Құрметті Уорп
Dialogue: 0,0:04:50.96,0:04:53.96,Default,,0000,0000,0000,,Арандатпаңыз.
Dialogue: 0,0:04:53.96,0:04:57.96,Default,,0000,0000,0000,,Оларға ұнамаса, сізді өткізбейді.
Dialogue: 0,0:04:53.96,0:04:57.96,Default,,0000,0000,0000,,Мүмкін.
Dialogue: 0,0:04:57.96,0:05:01.97,Default,,0000,0000,0000,,Е! ?
Dialogue: 0,0:04:57.96,0:05:01.97,Default,,0000,0000,0000,,Ол таңқаларлықтай қобалжыған деген қауесет бар.
Dialogue: 0,0:05:01.97,0:05:05.97,Default,,0000,0000,0000,,Біреу алтын балықтың сыртқы түрін бұзған кезде
Dialogue: 0,0:05:01.97,0:05:05.97,Default,,0000,0000,0000,,Көңіл-күйіңіз нашар болуы мүмкін...
Dialogue: 0,0:05:05.97,0:05:07.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:05.97,0:05:07.97,Default,,0000,0000,0000,,Нені жасыру керек➡
Dialogue: 0,0:05:07.97,0:05:11.98,Default,,0000,0000,0000,,Әңгімелеу.
Dialogue: 0,0:05:07.97,0:05:11.98,Default,,0000,0000,0000,,А... жоқ, шынымен де емес.
Dialogue: 0,0:05:11.98,0:05:16.98,Default,,0000,0000,0000,,Олай болса, ағай.
Dialogue: 0,0:05:11.98,0:05:16.98,Default,,0000,0000,0000,,Алтын балық болмаса, бұл демең бе?
Dialogue: 0,0:05:16.98,0:05:18.99,Default,,0000,0000,0000,,Демекін де алтын балық!
Dialogue: 0,0:05:18.99,0:05:20.99,Default,,0000,0000,0000,,Мен... кешіріңіз.
Dialogue: 0,0:05:20.99,0:05:22.99,Default,,0000,0000,0000,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:05:20.99,0:05:22.99,Default,,0000,0000,0000,,Тыныш!
Dialogue: 0,0:05:22.99,0:05:24.99,Default,,0000,0000,0000,,Гоку-сан, үніңді бір сәтке жап...
Dialogue: 0,0:05:22.99,0:05:24.99,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:05:24.99,0:05:30.00,Default,,0000,0000,0000,,Сіз кімсіз! Өзіңіздің шынайы болмысыңызды ашыңыз.
Dialogue: 0,0:05:30.00,0:05:32.93,Default,,0000,0000,0000,,Мен бұл жерден біраз бұрын шықтым.
Dialogue: 0,0:05:30.00,0:05:32.93,Default,,0000,0000,0000,,Бұл Глорио.
Dialogue: 0,0:05:32.93,0:05:35.94,Default,,0000,0000,0000,,Адамдар саны көбейді. ➡
Dialogue: 0,0:05:35.94,0:05:37.94,Default,,0000,0000,0000,,Бұл екеуі ше?
Dialogue: 0,0:05:37.94,0:05:40.94,Default,,0000,0000,0000,,Аа, бұл Ұлы жын әлемінен.
Dialogue: 0,0:05:40.94,0:05:44.94,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:05:40.94,0:05:44.94,Default,,0000,0000,0000,,Құлағыңызды көрсетіңіз.
Dialogue: 0,0:05:44.94,0:05:46.61,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:05:46.61,0:05:49.95,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:05:46.61,0:05:49.95,Default,,0000,0000,0000,,Бұл өте анық. ➡
Dialogue: 0,0:05:49.95,0:05:53.95,Default,,0000,0000,0000,,Оның жын-шайтан дүниесінің адамы екені даусыз. ➡
Dialogue: 0,0:05:53.95,0:05:55.96,Default,,0000,0000,0000,,Бұл туралы не деуге болады?
Dialogue: 0,0:05:55.96,0:05:57.96,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:05:57.96,0:06:00.96,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:06:00.96,0:06:03.93,Default,,0000,0000,0000,,Хехехе….
Dialogue: 0,0:06:06.97,0:06:08.97,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:06:08.97,0:06:10.97,Default,,0000,0000,0000,,Маған PIN кодыңызды тез айтыңыз.
Dialogue: 0,0:06:10.97,0:06:12.97,Default,,0000,0000,0000,,PIN нөмірі?
Dialogue: 0,0:06:12.97,0:06:15.98,Default,,0000,0000,0000,,Warp-sama қалай қолданылады
Dialogue: 0,0:06:12.97,0:06:15.98,Default,,0000,0000,0000,,Алдын ала хабарлаңыз➡
Dialogue: 0,0:06:15.98,0:06:18.98,Default,,0000,0000,0000,,PIN кодыңызды алыңыз.
Dialogue: 0,0:06:18.98,0:06:21.98,Default,,0000,0000,0000,,Бұрын PIN нөмірі болмаған.
Dialogue: 0,0:06:18.98,0:06:21.98,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:06:21.98,0:06:24.98,Default,,0000,0000,0000,,Қазір айт!
Dialogue: 0,0:06:24.98,0:06:26.99,Default,,0000,0000,0000,,8821.
Dialogue: 0,0:06:26.99,0:06:30.59,Default,,0000,0000,0000,,Жарайды, енгізіңіз.
Dialogue: 0,0:06:30.59,0:06:32.93,Default,,0000,0000,0000,,Уау! ?
Dialogue: 0,0:06:32.93,0:06:35.90,Default,,0000,0000,0000,,Ой, бұл қызық.
Dialogue: 0,0:06:39.93,0:06:41.93,Default,,0000,0000,0000,,Ал... бұл жаман.
Dialogue: 0,0:06:41.93,0:06:45.91,Default,,0000,0000,0000,,Кибитоға PIN нөмірі туралы айтыңыз.
Dialogue: 0,0:06:41.93,0:06:45.91,Default,,0000,0000,0000,,Мен сізге айтуым керек!
Dialogue: 0,0:06:52.95,0:06:55.95,Default,,0000,0000,0000,,Жоқ! уақытында болуы мүмкін емес!
Dialogue: 0,0:06:55.95,0:06:58.95,Default,,0000,0000,0000,,Га.
Dialogue: 0,0:06:55.95,0:06:58.95,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:58.95,0:07:00.95,Default,,0000,0000,0000,,Не... не! ?
Dialogue: 0,0:07:00.95,0:07:03.96,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:07:00.95,0:07:03.96,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:07:03.96,0:07:06.96,Default,,0000,0000,0000,,Мен жаңа ғана жедім
Dialogue: 0,0:07:03.96,0:07:06.96,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:07:06.96,0:07:09.96,Default,,0000,0000,0000,,Уау... ➡
Dialogue: 0,0:07:09.96,0:07:11.96,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:07:11.96,0:07:13.93,Default,,0000,0000,0000,,Угугу….
Dialogue: 0,0:07:18.97,0:07:20.97,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:07:20.97,0:07:23.98,Default,,0000,0000,0000,,Уф~.
Dialogue: 0,0:07:20.97,0:07:23.98,Default,,0000,0000,0000,,Ухихихи….
Dialogue: 0,0:07:23.98,0:07:26.98,Default,,0000,0000,0000,,О, бұл қызық болды.
Dialogue: 0,0:07:26.98,0:07:29.98,Default,,0000,0000,0000,,Өтінемін, құспаңыз.
Dialogue: 0,0:07:29.98,0:07:31.92,Default,,0000,0000,0000,,Сіз жындар әлеміне жеттіңіз бе?
Dialogue: 0,0:07:31.92,0:07:35.92,Default,,0000,0000,0000,,Жоқ, бұл әлі де релелік нүкте. ➡
Dialogue: 0,0:07:35.92,0:07:38.89,Default,,0000,0000,0000,,Ұлы жын әлемі
Dialogue: 0,0:07:35.92,0:07:38.89,Default,,0000,0000,0000,,Ол үш бөлікке бөлінген...
Dialogue: 0,0:07:40.93,0:07:45.93,Default,,0000,0000,0000,,Бірінші люк бірінші жын әлемінде.
Dialogue: 0,0:07:40.93,0:07:45.93,Default,,0000,0000,0000,,Тек патша сарайындағылар ғана кіре алады. ➡
Dialogue: 0,0:07:45.93,0:07:48.94,Default,,0000,0000,0000,,№3 люк арқылы кіреміз.
Dialogue: 0,0:07:48.94,0:07:51.94,Default,,0000,0000,0000,,3 саны? Гомер сонда
Dialogue: 0,0:07:48.94,0:07:51.94,Default,,0000,0000,0000,,Алғашқы жын әлемінен➡
Dialogue: 0,0:07:51.94,0:07:54.94,Default,,0000,0000,0000,,Бұл ең алыс емес пе?
Dialogue: 0,0:07:54.94,0:07:56.94,Default,,0000,0000,0000,,Сіз кем дегенде 2 нөміріне өтуіңіз керек.
Dialogue: 0,0:07:56.94,0:08:00.95,Default,,0000,0000,0000,,Үшінші жын әлемінен басқа
Dialogue: 0,0:07:56.94,0:08:00.95,Default,,0000,0000,0000,,Рұқсат берілмеді.
Dialogue: 0,0:08:00.95,0:08:02.62,Default,,0000,0000,0000,,Міне...
Dialogue: 0,0:08:02.62,0:08:04.95,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:04.95,0:08:08.96,Default,,0000,0000,0000,,Кішкентай жігіт пайда болды.
Dialogue: 0,0:08:08.96,0:08:11.96,Default,,0000,0000,0000,,Сіз жындар әлеміне қайтасыз ба?
Dialogue: 0,0:08:08.96,0:08:11.96,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:08:11.96,0:08:14.96,Default,,0000,0000,0000,,Жарайды, тез барайық.
Dialogue: 0,0:08:14.96,0:08:26.97,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:08:26.97,0:08:28.98,Default,,0000,0000,0000,,Уау, тағы!
Dialogue: 0,0:08:28.98,0:08:31.98,Default,,0000,0000,0000,,Уау... ➡
Dialogue: 0,0:08:31.98,0:08:36.95,Default,,0000,0000,0000,,Уау, уау….
Dialogue: 0,0:08:31.98,0:08:36.95,Default,,0000,0000,0000,,Ооо!
Dialogue: 0,0:08:54.00,0:08:56.00,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:08:56.00,0:08:59.01,Default,,0000,0000,0000,,Келдің бе?
Dialogue: 0,0:08:59.01,0:09:03.01,Default,,0000,0000,0000,,Ах. Бұл үшінші жын әлемі.
Dialogue: 0,0:09:03.01,0:09:06.01,Default,,0000,0000,0000,,Ооооо!
Dialogue: 0,0:09:06.01,0:09:08.01,Default,,0000,0000,0000,,Мұнда.
Dialogue: 0,0:09:08.01,0:09:09.98,Default,,0000,0000,0000,,Иә?иә?
Dialogue: 0,0:09:19.03,0:09:24.03,Default,,0000,0000,0000,,Керемет! Кай патша!
Dialogue: 0,0:09:19.03,0:09:24.03,Default,,0000,0000,0000,,Иә... иә….
Dialogue: 0,0:09:24.03,0:09:28.03,Default,,0000,0000,0000,,Кибитоға PIN нөмірін беріңіз
Dialogue: 0,0:09:24.03,0:09:28.03,Default,,0000,0000,0000,,Хабарланбаған.
Dialogue: 0,0:09:28.03,0:09:30.97,Default,,0000,0000,0000,,Әйтеуір жақсы болады.
Dialogue: 0,0:09:30.97,0:09:32.94,Default,,0000,0000,0000,,Әлі жарық.
Dialogue: 0,0:09:37.98,0:09:40.98,Default,,0000,0000,0000,,Уау! Бұл жерде не бар?
Dialogue: 0,0:09:40.98,0:09:42.98,Default,,0000,0000,0000,,Киім
Dialogue: 0,0:09:40.98,0:09:42.98,Default,,0000,0000,0000,,Бұл Ұлы жын әлеміндегі тесік. ➡
Dialogue: 0,0:09:42.98,0:09:45.99,Default,,0000,0000,0000,,Жол тесігі ретінде жазылған. ➡
Dialogue: 0,0:09:45.99,0:09:47.99,Default,,0000,0000,0000,,Төмен түссең, екінші жын әлемін табасың➡
Dialogue: 0,0:09:47.99,0:09:50.99,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:09:47.99,0:09:50.99,Default,,0000,0000,0000,,Бірінші жын әлеміне дейін жалғасады. ➡
Dialogue: 0,0:09:50.99,0:09:54.99,Default,,0000,0000,0000,,Өткенде
Dialogue: 0,0:09:50.99,0:09:54.99,Default,,0000,0000,0000,,Еркін келіп-кететін сияқты➡
Dialogue: 0,0:09:54.99,0:09:57.00,Default,,0000,0000,0000,,Есіме түскенше➡
Dialogue: 0,0:09:57.00,0:10:00.00,Default,,0000,0000,0000,,Дәл солай
Dialogue: 0,0:09:57.00,0:10:00.00,Default,,0000,0000,0000,,Біреу жасаған жарық қалқанымен➡
Dialogue: 0,0:10:00.00,0:10:02.00,Default,,0000,0000,0000,,Енді өту мүмкін болмады.
Dialogue: 0,0:10:02.00,0:10:05.00,Default,,0000,0000,0000,,Сол тесіктен
Dialogue: 0,0:10:02.00,0:10:05.00,Default,,0000,0000,0000,,Бұл мен бара алмаймын дегенді білдіре ме?
Dialogue: 0,0:10:05.00,0:10:09.01,Default,,0000,0000,0000,,Ммм, дәмді екен.
Dialogue: 0,0:10:05.00,0:10:09.01,Default,,0000,0000,0000,,Демек, жын-шайтан әлемдері арасында қозғалу да мүмкін➡
Dialogue: 0,0:10:09.01,0:10:13.01,Default,,0000,0000,0000,,Warp-sama пайдалану үшін
Dialogue: 0,0:10:09.01,0:10:13.01,Default,,0000,0000,0000,,Айналып кеткен сияқты.
Dialogue: 0,0:10:13.01,0:10:17.02,Default,,0000,0000,0000,,Бірақ Warp-sama кім пайдалана алады?
Dialogue: 0,0:10:13.01,0:10:17.02,Default,,0000,0000,0000,,Бірінші жын әлемінің жігіттерімен➡
Dialogue: 0,0:10:17.02,0:10:20.02,Default,,0000,0000,0000,,Екінші жын әлемінің кейбір жігіттері ғана.
Dialogue: 0,0:10:20.02,0:10:23.02,Default,,0000,0000,0000,,Егер сен сондай болсаң
Dialogue: 0,0:10:20.02,0:10:23.02,Default,,0000,0000,0000,,Оны қалай пайдалануға болады? ➡
Dialogue: 0,0:10:23.02,0:10:28.03,Default,,0000,0000,0000,,Мен сені қайдан көрдім
Dialogue: 0,0:10:23.02,0:10:28.03,Default,,0000,0000,0000,,Сіз үшінші жын әлемінен шыққан сияқтысыз.
Dialogue: 0,0:10:28.03,0:10:31.96,Default,,0000,0000,0000,,Мен бірінші жын әлеміндемін
Dialogue: 0,0:10:28.03,0:10:31.96,Default,,0000,0000,0000,,Мен жұмыс істеймін.
Dialogue: 0,0:10:31.96,0:10:34.93,Default,,0000,0000,0000,,А... Сенің жұмысың не?
Dialogue: 0,0:10:36.97,0:10:38.94,Default,,0000,0000,0000,,Әртүрлі заттар.
Dialogue: 0,0:10:41.97,0:10:44.98,Default,,0000,0000,0000,,Иә? Онда бір нәрсе тұр.
Dialogue: 0,0:10:41.97,0:10:44.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:44.98,0:10:49.98,Default,,0000,0000,0000,,Ах. Бұл алдыңғы патшаның Дабурасы.
Dialogue: 0,0:10:49.98,0:10:51.98,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:10:51.98,0:10:54.95,Default,,0000,0000,0000,,Бірақ ол тас-талқан.
Dialogue: 0,0:11:04.00,0:11:06.00,Default,,0000,0000,0000,,Аспан қандай ғажап.
Dialogue: 0,0:11:06.00,0:11:08.00,Default,,0000,0000,0000,,Жердің аспаны қандай?
Dialogue: 0,0:11:06.00,0:11:08.00,Default,,0000,0000,0000,,Себебі түстер әртүрлі➡
Dialogue: 0,0:11:08.00,0:11:10.00,Default,,0000,0000,0000,,Сіз мұны көруге дағдыланбайсыз.
Dialogue: 0,0:11:10.00,0:11:12.00,Default,,0000,0000,0000,,Өйткені ол Ұлы жын әлемі деп аталады➡
Dialogue: 0,0:11:12.00,0:11:15.01,Default,,0000,0000,0000,,Бір жерде одан да қорқынышты.
Dialogue: 0,0:11:12.00,0:11:15.01,Default,,0000,0000,0000,,Мен солай ойладым➡
Dialogue: 0,0:11:15.01,0:11:18.01,Default,,0000,0000,0000,,Оның Жерден онша айырмашылығы жоқ.
Dialogue: 0,0:11:18.01,0:11:20.01,Default,,0000,0000,0000,,Сыртқы түрі
Dialogue: 0,0:11:18.01,0:11:20.01,Default,,0000,0000,0000,,Мүмкін➡
Dialogue: 0,0:11:20.01,0:11:22.01,Default,,0000,0000,0000,,Себебі экожүйе әртүрлі➡
Dialogue: 0,0:11:22.01,0:11:26.02,Default,,0000,0000,0000,,Бұрын көрмеген өсімдіктер
Dialogue: 0,0:11:22.01,0:11:26.02,Default,,0000,0000,0000,,Жануарлар да бар. ➡
Dialogue: 0,0:11:26.02,0:11:28.02,Default,,0000,0000,0000,,Үшінші жын әлемінің құрлығы ➡
Dialogue: 0,0:11:28.02,0:11:30.96,Default,,0000,0000,0000,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:11:28.02,0:11:30.96,Default,,0000,0000,0000,,Ол қалқып тұр.
Dialogue: 0,0:11:30.96,0:11:33.96,Default,,0000,0000,0000,,Эй, ә, сәлем...
Dialogue: 0,0:11:33.96,0:11:37.96,Default,,0000,0000,0000,,Бұл Глорио.
Dialogue: 0,0:11:33.96,0:11:37.96,Default,,0000,0000,0000,,Сыртқы ауамен тыныс алыңыз➡
Dialogue: 0,0:11:37.96,0:11:39.97,Default,,0000,0000,0000,,Сіз мені бір сәтке түсіре аласыз ба?
Dialogue: 0,0:11:39.97,0:11:41.97,Default,,0000,0000,0000,,Хи хи...
Dialogue: 0,0:11:41.97,0:11:43.94,Default,,0000,0000,0000,,​​Түсіндім.
Dialogue: 0,0:11:49.98,0:11:51.98,Default,,0000,0000,0000,,Йотто.
Dialogue: 0,0:11:51.98,0:11:53.98,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:11:53.98,0:11:56.95,Default,,0000,0000,0000,,Бұл Ұлы жын әлемі ме?
Dialogue: 0,0:12:01.99,0:12:03.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:03.99,0:12:10.00,Default,,0000,0000,0000,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:12:10.00,0:12:12.00,Default,,0000,0000,0000,,Бірдеңе дұрыс емес.
Dialogue: 0,0:12:12.00,0:12:15.00,Default,,0000,0000,0000,,(иіскеу дыбысы)
Dialogue: 0,0:12:12.00,0:12:15.00,Default,,0000,0000,0000,,(Буши) «Маған қара!» (Эмими) «Маған қара!»
Dialogue: 0,0:12:15.00,0:12:18.00,Default,,0000,0000,0000,,Иә! Ха!
Dialogue: 0,0:12:18.00,0:12:21.01,Default,,0000,0000,0000,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,0:12:21.01,0:12:24.01,Default,,0000,0000,0000,,Ауада бір нәрсе
Dialogue: 0,0:12:21.01,0:12:24.01,Default,,0000,0000,0000,,Қараңғы ➡
Dialogue: 0,0:12:24.01,0:12:26.01,Default,,0000,0000,0000,,Қозғалу өте қиын.
Dialogue: 0,0:12:26.01,0:12:30.95,Default,,0000,0000,0000,,Бұл жерді жауып тұрған газ болғандықтан.
Dialogue: 0,0:12:26.01,0:12:30.95,Default,,0000,0000,0000,,Ауа ауыр.
Dialogue: 0,0:12:30.95,0:12:34.95,Default,,0000,0000,0000,,Газ?
Dialogue: 0,0:12:30.95,0:12:34.95,Default,,0000,0000,0000,,Уайымдамаңыз. Бұл денеге зиянсыз.
Dialogue: 0,0:12:34.95,0:12:36.96,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:12:36.96,0:12:39.96,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:12:36.96,0:12:39.96,Default,,0000,0000,0000,,(жүгіру)
Dialogue: 0,0:12:39.96,0:12:41.93,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:12:45.97,0:12:49.97,Default,,0000,0000,0000,,Үшінші жын әлемі
Dialogue: 0,0:12:45.97,0:12:49.97,Default,,0000,0000,0000,,Менің де мұнда бірінші рет келуім.
Dialogue: 0,0:12:49.97,0:12:51.97,Default,,0000,0000,0000,,Сіз гриндиансыз, солай ма?
Dialogue: 0,0:12:51.97,0:12:53.97,Default,,0000,0000,0000,,Иә, бұл рас...
Dialogue: 0,0:12:53.97,0:12:57.98,Default,,0000,0000,0000,,Баяғыда көптеген гриндиандықтар
Dialogue: 0,0:12:53.97,0:12:57.98,Default,,0000,0000,0000,,➡ тұратын
Dialogue: 0,0:12:57.98,0:12:59.98,Default,,0000,0000,0000,,Бұл екінші жын әлемі болуы керек еді.
Dialogue: 0,0:12:59.98,0:13:03.98,Default,,0000,0000,0000,,Сіз талғампаз адамдарсыз
Dialogue: 0,0:12:59.98,0:13:03.98,Default,,0000,0000,0000,,Менің үшінші жын әлеміне келетін шаруам жоқ➡
Dialogue: 0,0:13:03.98,0:13:05.95,Default,,0000,0000,0000,,Олай болмаған шығар.
Dialogue: 0,0:13:10.99,0:13:13.99,Default,,0000,0000,0000,,Уау! Уау... Уау.
Dialogue: 0,0:13:13.99,0:13:16.00,Default,,0000,0000,0000,,Сәлем! Сақ болыңыз!
Dialogue: 0,0:13:16.00,0:13:18.00,Default,,0000,0000,0000,,Төмендегі қараңғы теңізге түсіп қалсаңыз➡
Dialogue: 0,0:13:18.00,0:13:21.97,Default,,0000,0000,0000,,Сіз тез арада өлесіз!
Dialogue: 0,0:13:18.00,0:13:21.97,Default,,0000,0000,0000,,Уау! Апыр-ай.
Dialogue: 0,0:13:24.00,0:13:26.97,Default,,0000,0000,0000,,Сәлем. Қорықпа.
Dialogue: 0,0:13:29.01,0:13:33.95,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:13:33.95,0:13:36.92,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:13:56.97,0:13:58.97,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:13:58.97,0:14:00.97,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:14:00.97,0:14:02.94,Default,,0000,0000,0000,,Әй! ?
Dialogue: 0,0:14:09.98,0:14:11.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:11.98,0:14:13.99,Default,,0000,0000,0000,,Осе
Dialogue: 0,0:14:11.98,0:14:13.99,Default,,0000,0000,0000,,Сіз кешіктіңіз!
Dialogue: 0,0:14:13.99,0:14:16.99,Default,,0000,0000,0000,,Ауа ауыр деді.
Dialogue: 0,0:14:16.99,0:14:18.99,Default,,0000,0000,0000,,Міне, басталды!
Dialogue: 0,0:14:18.99,0:14:20.99,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:14:18.99,0:14:20.99,Default,,0000,0000,0000,,Не, не! ?
Dialogue: 0,0:14:20.99,0:14:23.00,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:14:23.00,0:14:24.96,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:14:29.00,0:14:31.94,Default,,0000,0000,0000,,(Айқай)
Dialogue: 0,0:14:31.94,0:14:35.94,Default,,0000,0000,0000,,Хмф... Жай ғана ұры.
Dialogue: 0,0:14:35.94,0:14:37.94,Default,,0000,0000,0000,,Бұл қорқынышты жер.
Dialogue: 0,0:14:37.94,0:14:40.91,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:14:37.94,0:14:40.91,Default,,0000,0000,0000,,Бізде әлі талай жол бар.
Dialogue: 0,0:14:43.95,0:14:45.95,Default,,0000,0000,0000,,Глорио мырза.
Dialogue: 0,0:14:45.95,0:14:48.95,Default,,0000,0000,0000,,Бүгін басталады
Dialogue: 0,0:14:45.95,0:14:48.95,Default,,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:14:48.95,0:14:53.96,Default,,0000,0000,0000,,Бұл қала. Мен бүгін қонақүйде тұрамын
Dialogue: 0,0:14:48.95,0:14:53.96,Default,,0000,0000,0000,,Мен сені ертең Кадан патшамен кездестіремін.
Dialogue: 0,0:14:53.96,0:14:56.96,Default,,0000,0000,0000,,Мен сені құпия хабаршы етемін.
Dialogue: 0,0:14:53.96,0:14:56.96,Default,,0000,0000,0000,,Оны жіберген патша осы.
Dialogue: 0,0:14:56.96,0:14:58.93,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:15:05.97,0:15:07.97,Default,,0000,0000,0000,,Баяу
Dialogue: 0,0:15:05.97,0:15:07.97,Default,,0000,0000,0000,,Ол ұшады, солай ма?
Dialogue: 0,0:15:07.97,0:15:12.98,Default,,0000,0000,0000,,Жылдам ұшу
Dialogue: 0,0:15:07.97,0:15:12.98,Default,,0000,0000,0000,,Механизм қарсылықтан үзіледі.
Dialogue: 0,0:15:12.98,0:15:16.98,Default,,0000,0000,0000,,Мына жерге қараңдар.
Dialogue: 0,0:15:12.98,0:15:16.98,Default,,0000,0000,0000,,Біртүрлі жанартау бар.
Dialogue: 0,0:15:16.98,0:15:19.99,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:15:16.98,0:15:19.99,Default,,0000,0000,0000,,Ауада қалқып тұрса да➡
Dialogue: 0,0:15:19.99,0:15:21.99,Default,,0000,0000,0000,,Бұл жанартау екені біртүрлі.
Dialogue: 0,0:15:21.99,0:15:26.99,Default,,0000,0000,0000,,Сол жанартаудан шыққан газ
Dialogue: 0,0:15:21.99,0:15:26.99,Default,,0000,0000,0000,,Ауаны ауыр етеді.
Dialogue: 0,0:15:26.99,0:15:30.00,Default,,0000,0000,0000,,Осы жерде
Dialogue: 0,0:15:26.99,0:15:30.00,Default,,0000,0000,0000,,Жанартаулар барлық жерде.
Dialogue: 0,0:15:30.00,0:15:32.00,Default,,0000,0000,0000,,Сондықтан бұл өте нашар.
Dialogue: 0,0:15:32.00,0:15:36.00,Default,,0000,0000,0000,,Көресіңдер әлі
Dialogue: 0,0:15:32.00,0:15:36.00,Default,,0000,0000,0000,,Мен ысылдасам да, олар білмеуі мүмкін.
Dialogue: 0,0:15:32.00,0:15:36.00,Default,,0000,0000,0000,,Хаха.
Dialogue: 0,0:15:36.00,0:15:38.00,Default,,0000,0000,0000,,Бұл өрескел.
Dialogue: 0,0:15:38.00,0:15:42.01,Default,,0000,0000,0000,,Газдың концентрациясы неғұрлым жоғары болса
Dialogue: 0,0:15:38.00,0:15:42.01,Default,,0000,0000,0000,,Ауа ауыр болады.
Dialogue: 0,0:15:42.01,0:15:45.01,Default,,0000,0000,0000,,Сол себепті
Dialogue: 0,0:15:42.01,0:15:45.01,Default,,0000,0000,0000,,Жанартау жанынан өткенде ➡
Dialogue: 0,0:15:45.01,0:15:47.01,Default,,0000,0000,0000,,Ұшақтың жүруі қиын.
Dialogue: 0,0:15:47.01,0:15:49.01,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:15:49.01,0:15:50.98,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:15:49.01,0:15:50.98,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:15:54.02,0:15:56.02,Default,,0000,0000,0000,,А, мен таң қалдым.
Dialogue: 0,0:15:56.02,0:15:58.02,Default,,0000,0000,0000,,Біраз
Dialogue: 0,0:15:56.02,0:15:58.02,Default,,0000,0000,0000,,Газ енді ғана шықты.
Dialogue: 0,0:15:58.02,0:16:03.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:58.02,0:16:03.03,Default,,0000,0000,0000,,Иә? Иісі күшейе түсті.
Dialogue: 0,0:16:03.03,0:16:05.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:05.03,0:16:08.00,Default,,0000,0000,0000,,Warii Warii. Сіз білдіңіз бе?
Dialogue: 0,0:16:05.03,0:16:08.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:14.04,0:16:16.04,Default,,0000,0000,0000,,Өйткені бұл жер бетінде түн болатын
Dialogue: 0,0:16:14.04,0:16:16.04,Default,,0000,0000,0000,,Сіз де➡
Dialogue: 0,0:16:16.04,0:16:18.04,Default,,0000,0000,0000,,Жақында ұйықтау керек. ➡
Dialogue: 0,0:16:18.04,0:16:21.01,Default,,0000,0000,0000,,Бүгін біз осы жерде бір түн боламыз.
Dialogue: 0,0:16:23.05,0:16:25.02,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:16:30.06,0:16:32.02,Default,,0000,0000,0000,,О? Хаха.
Dialogue: 0,0:16:39.00,0:16:40.97,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:16:50.01,0:16:52.01,Default,,0000,0000,0000,,Сіз қонақсыз ба?
Dialogue: 0,0:16:52.01,0:16:56.01,Default,,0000,0000,0000,,Ах. екеуің
Dialogue: 0,0:16:52.01,0:16:56.01,Default,,0000,0000,0000,,Біз бір бөлмені бөлісе аламыз ба?
Dialogue: 0,0:16:56.01,0:16:57.98,Default,,0000,0000,0000,,Иә, маңызды емес.
Dialogue: 0,0:17:01.02,0:17:03.02,Default,,0000,0000,0000,,Екі бөлме бар ма?
Dialogue: 0,0:17:03.02,0:17:05.02,Default,,0000,0000,0000,,А, мінекей.
Dialogue: 0,0:17:05.02,0:17:07.03,Default,,0000,0000,0000,,Бір бөлменің құны 30 000 бас сүйек.
Dialogue: 0,0:17:07.03,0:17:11.03,Default,,0000,0000,0000,,30 000?
Dialogue: 0,0:17:07.03,0:17:11.03,Default,,0000,0000,0000,,Бұл өте қызық.
Dialogue: 0,0:17:11.03,0:17:15.03,Default,,0000,0000,0000,,Хе-хе... шағымыңыз болса.
Dialogue: 0,0:17:11.03,0:17:15.03,Default,,0000,0000,0000,,Менің ойымша, сіз тағы бірдеңе соғасыз.
Dialogue: 0,0:17:15.03,0:17:18.04,Default,,0000,0000,0000,,Дегенмен, осы жерде
Dialogue: 0,0:17:15.03,0:17:18.04,Default,,0000,0000,0000,,Қонақ үй➡
Dialogue: 0,0:17:18.04,0:17:21.04,Default,,0000,0000,0000,,Тек осында.
Dialogue: 0,0:17:21.04,0:17:23.04,Default,,0000,0000,0000,,Оны жалама.
Dialogue: 0,0:17:23.04,0:17:25.01,Default,,0000,0000,0000,,Не істемекшісің?
Dialogue: 0,0:17:27.05,0:17:29.05,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:17:29.05,0:17:31.98,Default,,0000,0000,0000,,​​Түсіндім.
Dialogue: 0,0:17:29.05,0:17:31.98,Default,,0000,0000,0000,,5000 ше?
Dialogue: 0,0:17:31.98,0:17:33.99,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:17:33.99,0:17:35.95,Default,,0000,0000,0000,,Нуу….
Dialogue: 0,0:17:40.99,0:17:45.00,Default,,0000,0000,0000,,Бөлме жоғарыда.
Dialogue: 0,0:17:40.99,0:17:45.00,Default,,0000,0000,0000,,Мен сені таңертең алып кетемін.
Dialogue: 0,0:17:45.00,0:17:47.00,Default,,0000,0000,0000,,Абыройлы музыка мектептерінде бәрі бәсекелестік рейтингтерге және→
Dialogue: 0,0:17:47.00,0:17:51.00,Default,,0000,0000,0000,,Эй, мен тамақтанып жатқанда.
Dialogue: 0,0:17:47.00,0:17:51.00,Default,,0000,0000,0000,,Сыртқа шыққаннан бері қарным ашты.
Dialogue: 0,0:17:51.00,0:17:53.01,Default,,0000,0000,0000,,Сіз тамақтанғыңыз келе ме?
Dialogue: 0,0:17:53.01,0:17:56.01,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:17:53.01,0:17:56.01,Default,,0000,0000,0000,,Мен көп жесем де, мен әлі де...
Dialogue: 0,0:17:56.01,0:17:59.01,Default,,0000,0000,0000,,Хи хи хи....
Dialogue: 0,0:17:56.01,0:17:59.01,Default,,0000,0000,0000,,Эй, мен жесем болады ма?
Dialogue: 0,0:17:59.01,0:18:03.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:59.01,0:18:03.02,Default,,0000,0000,0000,,А... көшенің арғы жағында бар бар.
Dialogue: 0,0:18:03.02,0:18:07.02,Default,,0000,0000,0000,,Егер бұл жай ғана гамбургер болса
Dialogue: 0,0:18:03.02,0:18:07.02,Default,,0000,0000,0000,,Мен оны жей аламын.
Dialogue: 0,0:18:07.02,0:18:10.02,Default,,0000,0000,0000,,(сөйлеу)
Dialogue: 0,0:18:10.02,0:18:11.99,Default,,0000,0000,0000,,⚟Мм! ?
Dialogue: 0,0:18:14.03,0:18:15.99,Default,,0000,0000,0000,,(есік жабылған дыбыс)
Dialogue: 0,0:18:14.03,0:18:15.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:22.03,0:18:24.04,Default,,0000,0000,0000,,Гамбургер...
Dialogue: 0,0:18:22.03,0:18:24.04,Default,,0000,0000,0000,,Біреуі дұрыс па?
Dialogue: 0,0:18:24.04,0:18:26.04,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:18:26.04,0:18:29.04,Default,,0000,0000,0000,,Біраз уақыт бұрын
Dialogue: 0,0:18:26.04,0:18:29.04,Default,,0000,0000,0000,,Мен оны жедім бе деп ойлаймын.
Dialogue: 0,0:18:29.04,0:18:31.98,Default,,0000,0000,0000,,5 дана жеткілікті!
Dialogue: 0,0:18:31.98,0:18:33.98,Default,,0000,0000,0000,,Сіз ішесіз бе?
Dialogue: 0,0:18:33.98,0:18:35.98,Default,,0000,0000,0000,,Аз болса.
Dialogue: 0,0:18:35.98,0:18:38.95,Default,,0000,0000,0000,,5 гамбургерлер және
Dialogue: 0,0:18:35.98,0:18:38.95,Default,,0000,0000,0000,,Маған екі сусын беріңіз.
Dialogue: 0,0:18:46.99,0:18:51.00,Default,,0000,0000,0000,,Жындар әлемінен келген гамбургерлер де
Dialogue: 0,0:18:46.99,0:18:51.00,Default,,0000,0000,0000,,Бұл өте жақсы.
Dialogue: 0,0:18:51.00,0:18:55.00,Default,,0000,0000,0000,,(жұтыну дыбысы)
Dialogue: 0,0:18:51.00,0:18:55.00,Default,,0000,0000,0000,,Қандай ет? бұл.
Dialogue: 0,0:18:55.00,0:18:57.00,Default,,0000,0000,0000,,Сұрамағаныңыз дұрыс.
Dialogue: 0,0:18:57.00,0:19:00.01,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:19:00.01,0:19:03.01,Default,,0000,0000,0000,,Сәлем балақай.
Dialogue: 0,0:19:00.01,0:19:03.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:03.01,0:19:05.01,Default,,0000,0000,0000,,Құлағыңыз дөңгелек.
Dialogue: 0,0:19:05.01,0:19:07.98,Default,,0000,0000,0000,,Жындар әлемінен шыққан адамдар
Dialogue: 0,0:19:05.01,0:19:07.98,Default,,0000,0000,0000,,солай емес пе?
Dialogue: 0,0:19:10.02,0:19:13.02,Default,,0000,0000,0000,,Мен тамақтанып жатырмын. Отыр.
Dialogue: 0,0:19:13.02,0:19:15.02,Default,,0000,0000,0000,,және ол бұрын сарбаз болған.
Dialogue: 0,0:19:15.02,0:19:18.02,Default,,0000,0000,0000,,біршама
Dialogue: 0,0:19:15.02,0:19:18.02,Default,,0000,0000,0000,,Сіздің көзқарасыңыз үлкен, солай емес пе?
Dialogue: 0,0:19:18.02,0:19:21.03,Default,,0000,0000,0000,,Мен саған ақылыңды жоғалтамын деп жатырмын.
Dialogue: 0,0:19:18.02,0:19:21.03,Default,,0000,0000,0000,,Сіз мені естімейсіз бе?
Dialogue: 0,0:19:21.03,0:19:24.03,Default,,0000,0000,0000,,О? Не?
Dialogue: 0,0:19:24.03,0:19:26.03,Default,,0000,0000,0000,,Иә?иә?
Dialogue: 0,0:19:26.03,0:19:29.03,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:26.03,0:19:29.03,Default,,0000,0000,0000,,Тағы да айтыңыз!
Dialogue: 0,0:19:29.03,0:19:31.97,Default,,0000,0000,0000,,Уф. Гах... ➡
Dialogue: 0,0:19:31.97,0:19:33.97,Default,,0000,0000,0000,,Те... Теме!
Dialogue: 0,0:19:33.97,0:19:35.94,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:19:38.98,0:19:40.65,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:19:40.65,0:19:43.98,Default,,0000,0000,0000,,А? Эй!
Dialogue: 0,0:19:43.98,0:19:46.99,Default,,0000,0000,0000,,Ауыстыру.
Dialogue: 0,0:19:43.98,0:19:46.99,Default,,0000,0000,0000,,Эй... Эй!
Dialogue: 0,0:19:46.99,0:19:49.32,Default,,0000,0000,0000,,Маған жеңіл қарама
Dialogue: 0,0:19:46.99,0:19:49.32,Default,,0000,0000,0000,,Оланың гамбургері...
Dialogue: 0,0:19:49.32,0:19:51.32,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:19:51.32,0:19:52.89,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:19:55.99,0:19:58.00,Default,,0000,0000,0000,,《Міне, басталды!》
Dialogue: 0,0:19:55.99,0:19:58.00,Default,,0000,0000,0000,,Егер ағам мен әпкем әлі тірі болса…
Dialogue: 0,0:19:58.00,0:19:59.97,Default,,0000,0000,0000,,Гах!
Dialogue: 0,0:20:04.00,0:20:06.00,Default,,0000,0000,0000,,Салқын. ➡
Dialogue: 0,0:20:06.00,0:20:07.67,Default,,0000,0000,0000,,Қат! ➡
Dialogue: 0,0:20:07.67,0:20:11.01,Default,,0000,0000,0000,,Бұл!
Dialogue: 0,0:20:11.01,0:20:12.68,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:11.01,0:20:12.68,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:20:12.68,0:20:16.01,Default,,0000,0000,0000,,Уф! Ей!
Dialogue: 0,0:20:16.01,0:20:18.02,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:20:18.02,0:20:19.99,Default,,0000,0000,0000,,Қозғалмаңыз.
Dialogue: 0,0:20:24.02,0:20:27.69,Default,,0000,0000,0000,,(ДжоДжо) Какёин (Анн) Ааах!
Dialogue: 0,0:20:24.02,0:20:27.69,Default,,0000,0000,0000,,Әзіл!
Dialogue: 0,0:20:27.69,0:20:29.96,Default,,0000,0000,0000,,Иә? Апыр-ай!
Dialogue: 0,0:20:31.96,0:20:33.93,Default,,0000,0000,0000,,Бұл солай ма?
Dialogue: 0,0:20:38.97,0:20:40.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:40.97,0:20:43.98,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:43.98,0:20:46.98,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:20:43.98,0:20:46.98,Default,,0000,0000,0000,,Бұл рас па? ?
Dialogue: 0,0:20:46.98,0:20:48.98,Default,,0000,0000,0000,,Бәрі де мүмкін!
Dialogue: 0,0:20:48.98,0:20:50.98,Default,,0000,0000,0000,,Хи хи хи!
Dialogue: 0,0:20:50.98,0:20:53.99,Default,,0000,0000,0000,,Жоқ! ? иә?
Dialogue: 0,0:20:53.99,0:20:56.99,Default,,0000,0000,0000,,О... кукуку….
Dialogue: 0,0:20:53.99,0:20:56.99,Default,,0000,0000,0000,,Иә?Иә?
Dialogue: 0,0:20:56.99,0:21:00.66,Default,,0000,0000,0000,,Gugggggggg~.
Dialogue: 0,0:21:00.66,0:21:02.33,Default,,0000,0000,0000,,Сәлем...
Dialogue: 0,0:21:00.66,0:21:02.33,Default,,0000,0000,0000,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:21:02.33,0:21:04.00,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:21:04.00,0:21:07.00,Default,,0000,0000,0000,,Оған үйреніңіз
Dialogue: 0,0:21:04.00,0:21:07.00,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:21:07.00,0:21:10.00,Default,,0000,0000,0000,,Мен бәріңмен бірге айналысамын.
Dialogue: 0,0:21:10.00,0:21:12.97,Default,,0000,0000,0000,,Сен бейбақ!
Dialogue: 0,0:21:10.00,0:21:12.97,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:20.01,0:21:21.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:25.68,0:21:28.02,Default,,0000,0000,0000,,Бұл сенің мәселең — яғни, жадыңның!
Dialogue: 0,0:21:25.68,0:21:28.02,Default,,0000,0000,0000,,Гохо!
Dialogue: 0,0:21:28.02,0:21:30.02,Default,,0000,0000,0000,,Таяа~!
Dialogue: 0,0:21:28.02,0:21:30.02,Default,,0000,0000,0000,,Уау➡
Dialogue: 0,0:21:30.02,0:21:31.96,Default,,0000,0000,0000,,Гаха! Хаха….
Dialogue: 0,0:21:31.96,0:21:33.96,Default,,0000,0000,0000,,(Құлау дыбысы)
Dialogue: 0,0:21:33.96,0:21:35.96,Default,,0000,0000,0000,,Хмм? иә?
Dialogue: 0,0:21:35.96,0:21:37.96,Default,,0000,0000,0000,,Е! ?
Dialogue: 0,0:21:37.96,0:21:39.97,Default,,0000,0000,0000,,Дене тепе-теңдігі т.б.
Dialogue: 0,0:21:37.96,0:21:39.97,Default,,0000,0000,0000,,Қашықтық сезімі➡
Dialogue: 0,0:21:39.97,0:21:41.97,Default,,0000,0000,0000,,Енді түсіндім.
Dialogue: 0,0:21:41.97,0:21:44.97,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:21:41.97,0:21:44.97,Default,,0000,0000,0000,,Бұл жеткілікті.
Dialogue: 0,0:21:44.97,0:21:49.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:44.97,0:21:49.98,Default,,0000,0000,0000,,Менің әлі де қарным жетпейді.
Dialogue: 0,0:21:49.98,0:21:52.98,Default,,0000,0000,0000,,Қосымша бургермен.
Dialogue: 0,0:21:49.98,0:21:52.98,Default,,0000,0000,0000,,бұл... Иә! Дәл қазір.
Dialogue: 0,0:21:52.98,0:21:55.98,Default,,0000,0000,0000,,Иә? Хехе….
Dialogue: 0,0:21:55.98,0:21:58.98,Default,,0000,0000,0000,,(жүгіру)
Dialogue: 0,0:21:58.98,0:22:05.99,Default,,0000,0000,0000,,
Dialogue: 0,0:21:58.98,0:22:05.99,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:22:05.99,0:22:07.96,Default,,0000,0000,0000,,Қараңдар!
Dialogue: 0,0:22:11.00,0:22:13.00,Default,,0000,0000,0000,,
Dialogue: 0,0:22:11.00,0:22:13.00,Default,,0000,0000,0000,,⚟
Dialogue: 0,0:22:13.00,0:22:15.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:15.00,0:22:20.01,Default,,0000,0000,0000,,
Dialogue: 0,0:22:20.01,0:22:21.97,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:22:24.01,0:22:27.01,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:22:27.01,0:22:29.01,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:22:27.01,0:22:29.01,Default,,0000,0000,0000,,(Оқушы) Қайырлы таң. (Оқушы) Қайырлы таң. Ой, күйіп кеткен екен!
Dialogue: 0,0:22:29.01,0:22:32.95,Default,,0000,0000,0000,,Иә? Глорио мырза
Dialogue: 0,0:22:29.01,0:22:32.95,Default,,0000,0000,0000,,Ха! Сол 100 йендік тиынды таста! Ора!
Dialogue: 0,0:22:32.95,0:22:36.96,Default,,0000,0000,0000,,Ұшақ...
Dialogue: 0,0:22:36.96,0:22:39.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:39.96,0:22:41.93,Default,,0000,0000,0000,,Мүмкін емес...
Dialogue: 0,0:22:43.96,0:22:45.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:45.96,0:22:49.97,Default,,0000,0000,0000,,Е!
Dialogue: 0,0:22:49.97,0:22:59.95,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:01.45,0:23:07.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory