Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.04,0:00:12.01,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:01:47.04,0:01:49.04,Default,,0000,0000,0000,,
Dialogue: 0,0:01:49.04,0:01:51.04,Default,,0000,0000,0000,,Әлі емес пе?
Dialogue: 0,0:01:51.04,0:01:53.05,Default,,0000,0000,0000,,Жақында үзіліс жасаймыз ба?
Dialogue: 0,0:01:53.05,0:01:56.05,Default,,0000,0000,0000,,табу қиын жерлерде
Dialogue: 0,0:01:53.05,0:01:56.05,Default,,0000,0000,0000,,Лагерьге барайық.
Dialogue: 0,0:01:56.05,0:01:57.72,Default,,0000,0000,0000,,Е!
Dialogue: 0,0:01:57.72,0:02:04.06,Default,,0000,0000,0000,,Маған шомылуға рұқсат етіңізші!
Dialogue: 0,0:01:57.72,0:02:04.06,Default,,0000,0000,0000,,Маған төсекте ұйықтауға рұқсат етіңіз~!
Dialogue: 0,0:02:04.06,0:02:08.06,Default,,0000,0000,0000,,Гоку
Dialogue: 0,0:02:04.06,0:02:08.06,Default,,0000,0000,0000,,(Гокудың қорылдауы)
Dialogue: 0,0:02:08.06,0:02:10.06,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:10.06,0:02:14.07,Default,,0000,0000,0000,,Гокуға аю қалпақ кигізсеңіз
Dialogue: 0,0:02:10.06,0:02:14.07,Default,,0000,0000,0000,,Мен сізге хабар бермеймін.
Dialogue: 0,0:02:14.07,0:02:17.07,Default,,0000,0000,0000,,Не? Жарайды.
Dialogue: 0,0:02:17.07,0:02:21.07,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:02:17.07,0:02:21.07,Default,,0000,0000,0000,,Түсіндім. Сіз мұны істейсіз бе?
Dialogue: 0,0:02:21.07,0:02:24.04,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:02:34.02,0:02:36.02,Default,,0000,0000,0000,,Йотто.
Dialogue: 0,0:02:36.02,0:02:40.03,Default,,0000,0000,0000,,Сол қызыл жолақ көзге түседі.
Dialogue: 0,0:02:36.02,0:02:40.03,Default,,0000,0000,0000,,Оны ұшақта қалдырған дұрыс.
Dialogue: 0,0:02:40.03,0:02:41.69,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:02:41.69,0:02:45.03,Default,,0000,0000,0000,,Айдаһар шарларын дорбаға сал.
Dialogue: 0,0:02:41.69,0:02:45.03,Default,,0000,0000,0000,,Өзімізбен бірге алайық.
Dialogue: 0,0:02:45.03,0:02:47.00,Default,,0000,0000,0000,,Мен оны саламын.
Dialogue: 0,0:02:49.04,0:02:51.04,Default,,0000,0000,0000,,Уншо.
Dialogue: 0,0:02:51.04,0:02:53.04,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:02:53.04,0:02:55.01,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:03:13.06,0:03:15.06,Default,,0000,0000,0000,,Сақтық шарасы ретінде. ➡
Dialogue: 0,0:03:15.06,0:03:18.06,Default,,0000,0000,0000,,Бәріміз бірге ұйықтай аламыз.
Dialogue: 0,0:03:15.06,0:03:18.06,Default,,0000,0000,0000,,Үлкен бөлме жасайық. ➡
Dialogue: 0,0:03:18.06,0:03:22.07,Default,,0000,0000,0000,,Тамақтану бөлме қызметі арқылы да қолжетімді.
Dialogue: 0,0:03:18.06,0:03:22.07,Default,,0000,0000,0000,,Оны бөлмеге апарыңыз.
Dialogue: 0,0:03:22.07,0:03:25.07,Default,,0000,0000,0000,,Абыройлы музыка мектептерінде бәрі бәсекелестік рейтингтерге және→
Dialogue: 0,0:03:22.07,0:03:25.07,Default,,0000,0000,0000,,Диванда күтейік.
Dialogue: 0,0:03:25.07,0:03:29.08,Default,,0000,0000,0000,,Ах. Глорио дегеніміз не?
Dialogue: 0,0:03:25.07,0:03:29.08,Default,,0000,0000,0000,,Сізде өте көп ақша бар.
Dialogue: 0,0:03:29.08,0:03:33.01,Default,,0000,0000,0000,,Сіздің әкеңіз Кадан патша
Dialogue: 0,0:03:29.08,0:03:33.01,Default,,0000,0000,0000,,Сіз демеуші емессіз бе?
Dialogue: 0,0:03:33.01,0:03:35.01,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:03:35.01,0:03:36.68,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:03:36.68,0:03:38.35,Default,,0000,0000,0000,,Себебі менің әкем сараң➡
Dialogue: 0,0:03:38.35,0:03:40.02,Default,,0000,0000,0000,,Жұмыс – патша Гомерді жеңу.
Dialogue: 0,0:03:38.35,0:03:40.02,Default,,0000,0000,0000,,Сәтті болуы керек➡
Dialogue: 0,0:03:40.02,0:03:42.02,Default,,0000,0000,0000,,Ештеңе төлеудің қажеті жоқ деп ойлаймын.
Dialogue: 0,0:03:42.02,0:03:45.02,Default,,0000,0000,0000,,Уф~.
Dialogue: 0,0:03:42.02,0:03:45.02,Default,,0000,0000,0000,,Кайошин
Dialogue: 0,0:03:42.02,0:03:45.02,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:03:45.02,0:03:47.03,Default,,0000,0000,0000,,Гоку!
Dialogue: 0,0:03:47.03,0:03:49.03,Default,,0000,0000,0000,,Бұл жақсы емес пе?
Dialogue: 0,0:03:47.03,0:03:49.03,Default,,0000,0000,0000,,Бас киіміңізді шешіңіз!
Dialogue: 0,0:03:49.03,0:03:52.03,Default,,0000,0000,0000,,Бұл қалпақ
Dialogue: 0,0:03:49.03,0:03:52.03,Default,,0000,0000,0000,,Менің басым қышиды.
Dialogue: 0,0:03:52.03,0:03:55.03,Default,,0000,0000,0000,,Жарайды, тез киіңіз!
Dialogue: 0,0:03:55.03,0:03:59.04,Default,,0000,0000,0000,,Эй, көрдің бе?
Dialogue: 0,0:03:55.03,0:03:59.04,Default,,0000,0000,0000,,Анау төбет басы.
Dialogue: 0,0:03:59.04,0:04:05.04,Default,,0000,0000,0000,,О, дұрыс айтасың.
Dialogue: 0,0:03:59.04,0:04:05.04,Default,,0000,0000,0000,,Тамагамиді жеңді деген қауесет бұл бала. ➡
Dialogue: 0,0:04:05.04,0:04:10.05,Default,,0000,0000,0000,,Мына дөңгелек сөмке
Dialogue: 0,0:04:05.04,0:04:10.05,Default,,0000,0000,0000,,Айдаһар добы болуы керек.
Dialogue: 0,0:04:10.05,0:04:14.05,Default,,0000,0000,0000,,Жақсы сатылатын сияқты.
Dialogue: 0,0:04:14.05,0:04:19.06,Default,,0000,0000,0000,,(есік жабылған дыбыс)
Dialogue: 0,0:04:14.05,0:04:19.06,Default,,0000,0000,0000,,О, өте сергітеді!
Dialogue: 0,0:04:19.06,0:04:22.06,Default,,0000,0000,0000,,Гоку Сіз де қосылуыңыз керек.
Dialogue: 0,0:04:22.06,0:04:23.73,Default,,0000,0000,0000,,Эх!
Dialogue: 0,0:04:23.73,0:04:27.07,Default,,0000,0000,0000,,Е! Ол емес!
Dialogue: 0,0:04:23.73,0:04:27.07,Default,,0000,0000,0000,,Талай төбелесіп, көп тер төккен болуыңыз керек!
Dialogue: 0,0:04:27.07,0:04:29.07,Default,,0000,0000,0000,,Бұл тапсырыс!
Dialogue: 0,0:04:29.07,0:04:31.00,Default,,0000,0000,0000,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:04:31.00,0:04:33.97,Default,,0000,0000,0000,,Мен түсіндім...
Dialogue: 0,0:04:37.01,0:04:41.01,Default,,0000,0000,0000,,Киіміңді ауыстырсаңшы?
Dialogue: 0,0:04:37.01,0:04:41.01,Default,,0000,0000,0000,,Оны әкелме.
Dialogue: 0,0:04:41.01,0:04:43.02,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:04:43.02,0:04:48.02,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:04:43.02,0:04:48.02,Default,,0000,0000,0000,,Мен саған өзімді қарызға беремін.
Dialogue: 0,0:04:48.02,0:04:51.02,Default,,0000,0000,0000,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:04:48.02,0:04:51.02,Default,,0000,0000,0000,,Трусикалар кішкене...
Dialogue: 0,0:04:51.02,0:04:53.03,Default,,0000,0000,0000,,Іш киім емес!
Dialogue: 0,0:04:53.03,0:04:56.03,Default,,0000,0000,0000,,(Су дыбысы)
Dialogue: 0,0:04:56.03,0:05:01.03,Default,,0000,0000,0000,,Уф! Бұл өте жақсы сезінді!
Dialogue: 0,0:04:56.03,0:05:01.03,Default,,0000,0000,0000,,О!
Dialogue: 0,0:05:01.03,0:05:04.04,Default,,0000,0000,0000,,Дәмді көрінеді!
Dialogue: 0,0:05:04.04,0:05:05.71,Default,,0000,0000,0000,,Тамақ жейміз бе?
Dialogue: 0,0:05:05.71,0:05:07.67,Default,,0000,0000,0000,,Ах... Мм.
Dialogue: 0,0:05:14.05,0:05:16.05,Default,,0000,0000,0000,,Хмм! дәмді!
Dialogue: 0,0:05:16.05,0:05:19.02,Default,,0000,0000,0000,,Мен мұнда тамаққа үйреніп жатырмын.
Dialogue: 0,0:05:23.06,0:05:25.06,Default,,0000,0000,0000,,⚟Гаруру!
Dialogue: 0,0:05:23.06,0:05:25.06,Default,,0000,0000,0000,,⚟(Тұтынушы) Уау!
Dialogue: 0,0:05:25.06,0:05:27.06,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:25.06,0:05:27.06,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:05:27.06,0:05:29.06,Default,,0000,0000,0000,,Гурул….
Dialogue: 0,0:05:29.06,0:05:30.66,Default,,0000,0000,0000,,Гурара...!
Dialogue: 0,0:05:30.66,0:05:32.33,Default,,0000,0000,0000,,Тоқтаңыз! ➡
Dialogue: 0,0:05:32.33,0:05:35.00,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:32.33,0:05:35.00,Default,,0000,0000,0000,,Орын
Dialogue: 0,0:05:32.33,0:05:35.00,Default,,0000,0000,0000,,Гурул….
Dialogue: 0,0:05:35.00,0:05:36.97,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:05:39.01,0:05:42.01,Default,,0000,0000,0000,,Тұтынушылар эвакуациялануы керек!
Dialogue: 0,0:05:39.01,0:05:42.01,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:05:42.01,0:05:44.98,Default,,0000,0000,0000,,Бұл жаман мінез.
Dialogue: 0,0:05:47.01,0:05:48.98,Default,,0000,0000,0000,,Мен сені үрлеймін бе?
Dialogue: 0,0:05:53.02,0:05:56.02,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:05:53.02,0:05:56.02,Default,,0000,0000,0000,,Хи хи...
Dialogue: 0,0:05:56.02,0:06:00.03,Default,,0000,0000,0000,,(саусақ ысқырығы)
Dialogue: 0,0:06:00.03,0:06:03.03,Default,,0000,0000,0000,,Хи хи!
Dialogue: 0,0:06:03.03,0:06:06.03,Default,,0000,0000,0000,,Хехе. Хахахаха!
Dialogue: 0,0:06:06.03,0:06:09.04,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:09.04,0:06:13.04,Default,,0000,0000,0000,,Бұл не? Ах!
Dialogue: 0,0:06:13.04,0:06:16.04,Default,,0000,0000,0000,,Айдаһар добы түсірілді!
Dialogue: 0,0:06:13.04,0:06:16.04,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:06:16.04,0:06:18.04,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:06:18.04,0:06:20.05,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:06:18.04,0:06:20.05,Default,,0000,0000,0000,,Мен оны алдым!
Dialogue: 0,0:06:20.05,0:06:22.05,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:06:22.05,0:06:25.05,Default,,0000,0000,0000,,Дәліздегі қасқыр мен гуру?
Dialogue: 0,0:06:25.05,0:06:27.05,Default,,0000,0000,0000,,Бұл жоспарланған қылмыс болды.
Dialogue: 0,0:06:27.05,0:06:30.99,Default,,0000,0000,0000,,Жарайды. Маған қалдырыңыз!
Dialogue: 0,0:06:30.99,0:06:32.99,Default,,0000,0000,0000,,Йотто.
Dialogue: 0,0:06:32.99,0:06:34.99,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:34.99,0:06:37.00,Default,,0000,0000,0000,,Не ол?
Dialogue: 0,0:06:34.99,0:06:37.00,Default,,0000,0000,0000,,Тек сенімді болу үшін➡
Dialogue: 0,0:06:37.00,0:06:40.00,Default,,0000,0000,0000,,Мен таратқышты орнаттым.
Dialogue: 0,0:06:40.00,0:06:42.00,Default,,0000,0000,0000,,Шынымен! Мен жасаймын!
Dialogue: 0,0:06:42.00,0:06:45.00,Default,,0000,0000,0000,,🔊 (электрондық дыбыс)
Dialogue: 0,0:06:42.00,0:06:45.00,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:45.00,0:06:47.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:45.00,0:06:47.01,Default,,0000,0000,0000,,Гоку.
Dialogue: 0,0:06:47.01,0:06:48.98,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:06:59.02,0:07:02.02,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:07:02.02,0:07:06.03,Default,,0000,0000,0000,,Хехе…. Жақсы өтті.
Dialogue: 0,0:07:06.03,0:07:10.03,Default,,0000,0000,0000,,Ах. Мен оның тікелей көтерілетінін ешқашан күтпедім.
Dialogue: 0,0:07:06.03,0:07:10.03,Default,,0000,0000,0000,,Мен олай ойламаймын.
Dialogue: 0,0:07:10.03,0:07:15.03,Default,,0000,0000,0000,,Эй, мен саған бірдеңе көрсетейін.
Dialogue: 0,0:07:10.03,0:07:15.03,Default,,0000,0000,0000,,Айдаһар добы! ➡
Dialogue: 0,0:07:15.03,0:07:17.04,Default,,0000,0000,0000,,Охо! Керемет!
Dialogue: 0,0:07:17.04,0:07:21.04,Default,,0000,0000,0000,,Бірақ мен үшеуін жинауым керек.
Dialogue: 0,0:07:17.04,0:07:21.04,Default,,0000,0000,0000,,Бұл мағынасы жоқ па?
Dialogue: 0,0:07:21.04,0:07:24.04,Default,,0000,0000,0000,,Бұл дұрыс➡
Dialogue: 0,0:07:24.04,0:07:27.05,Default,,0000,0000,0000,,Тіпті біреуі ғана
Dialogue: 0,0:07:24.04,0:07:27.05,Default,,0000,0000,0000,,Қазынаның құны жетерлік...
Dialogue: 0,0:07:27.05,0:07:29.05,Default,,0000,0000,0000,,Ол «Fool» картасының белгісін арқалаған Стэнді қолданушы
Dialogue: 0,0:07:29.05,0:07:32.99,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:07:29.05,0:07:32.99,Default,,0000,0000,0000,,Эй, маған Айдаһар шарларын қайтар.
Dialogue: 0,0:07:32.99,0:07:34.99,Default,,0000,0000,0000,,Сен менің абыройымды осы лайға батырдың!
Dialogue: 0,0:07:34.99,0:07:36.96,Default,,0000,0000,0000,,Жарайды... бұл жаман!
Dialogue: 0,0:07:39.99,0:07:41.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:41.99,0:07:43.96,Default,,0000,0000,0000,,Жапония мен Батыстың қарапайым ақыл-кеуілі мүлде жарамайды.
Dialogue: 0,0:07:47.00,0:07:49.00,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:07:49.00,0:07:51.00,Default,,0000,0000,0000,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,0:07:49.00,0:07:51.00,Default,,0000,0000,0000,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,0:07:51.00,0:07:52.97,Default,,0000,0000,0000,,Бұл – Демоноруқтар корпусы! Мұнда ойланбастан кіруге болмайды!
Dialogue: 0,0:07:55.01,0:07:57.98,Default,,0000,0000,0000,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,0:07:55.01,0:07:57.98,Default,,0000,0000,0000,,Да-да-да… да!
Dialogue: 0,0:08:00.01,0:08:02.01,Default,,0000,0000,0000,,Таяа!
Dialogue: 0,0:08:02.01,0:08:04.02,Default,,0000,0000,0000,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:08:04.02,0:08:05.69,Default,,0000,0000,0000,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:08:04.02,0:08:05.69,Default,,0000,0000,0000,,Аһ!
Dialogue: 0,0:08:05.69,0:08:08.02,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:08:08.02,0:08:11.02,Default,,0000,0000,0000,,Стефани
Dialogue: 0,0:08:11.02,0:08:14.03,Default,,0000,0000,0000,,Ааа...!
Dialogue: 0,0:08:14.03,0:08:16.00,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:08:23.04,0:08:25.04,Default,,0000,0000,0000,,Ой, жоқ!
Dialogue: 0,0:08:25.04,0:08:28.04,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:08:28.04,0:08:31.04,Default,,0000,0000,0000,,Ол ешқандай қосымша күш бола алмайды.
Dialogue: 0,0:08:31.04,0:08:33.05,Default,,0000,0000,0000,,Уау! ➡
Dialogue: 0,0:08:33.05,0:08:35.05,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:33.05,0:08:35.05,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:08:35.05,0:08:40.02,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:42.05,0:08:44.06,Default,,0000,0000,0000,,Мен оны қайтардым!
Dialogue: 0,0:08:44.06,0:08:47.06,Default,,0000,0000,0000,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:08:47.06,0:08:50.06,Default,,0000,0000,0000,,Жарайсың, Панджи.
Dialogue: 0,0:08:50.06,0:08:52.03,Default,,0000,0000,0000,,А...
Dialogue: 0,0:08:57.07,0:08:59.07,Default,,0000,0000,0000,,О, әке.
Dialogue: 0,0:08:59.07,0:09:01.07,Default,,0000,0000,0000,,Иә, түсіндім.
Dialogue: 0,0:09:01.07,0:09:04.08,Default,,0000,0000,0000,,Иә, қайырлы түн.
Dialogue: 0,0:09:04.08,0:09:06.08,Default,,0000,0000,0000,,Сонда кездескенше.
Dialogue: 0,0:09:06.08,0:09:10.08,Default,,0000,0000,0000,,Әкеңнен бе?
Dialogue: 0,0:09:06.08,0:09:10.08,Default,,0000,0000,0000,,Иә. Достарың қандай➡
Dialogue: 0,0:09:10.08,0:09:13.09,Default,,0000,0000,0000,,Ертең Варп-сама маңында
Dialogue: 0,0:09:10.08,0:09:13.09,Default,,0000,0000,0000,,Біз кездесуді шештік.
Dialogue: 0,0:09:13.09,0:09:16.09,Default,,0000,0000,0000,,Сіздің достарыңыз да мықты ма?
Dialogue: 0,0:09:16.09,0:09:19.09,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:09:16.09,0:09:19.09,Default,,0000,0000,0000,,Екеуі де көп нәрсе жасайды.
Dialogue: 0,0:09:19.09,0:09:21.09,Default,,0000,0000,0000,,Шынайы ма?
Dialogue: 0,0:09:21.09,0:09:24.10,Default,,0000,0000,0000,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:09:21.09,0:09:24.10,Default,,0000,0000,0000,,Біз сақтықты төмендете алмаймыз.
Dialogue: 0,0:09:24.10,0:09:27.10,Default,,0000,0000,0000,,Қонақ үйден шығу
Dialogue: 0,0:09:24.10,0:09:27.10,Default,,0000,0000,0000,,Табиғатта лагерь жасаймыз ба?
Dialogue: 0,0:09:27.10,0:09:29.10,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:09:27.10,0:09:29.10,Default,,0000,0000,0000,,Қандай ысырап! ➡
Dialogue: 0,0:09:29.10,0:09:32.04,Default,,0000,0000,0000,,Қымбат қонақүй болса да!
Dialogue: 0,0:09:32.04,0:09:36.04,Default,,0000,0000,0000,,Мен сені қадағалаймын.
Dialogue: 0,0:09:32.04,0:09:36.04,Default,,0000,0000,0000,,Балалар сендер төсекке кетіңдер.
Dialogue: 0,0:09:36.04,0:09:40.05,Default,,0000,0000,0000,,Эй, мен ұшақта көп ұйықтадым.
Dialogue: 0,0:09:40.05,0:09:43.05,Default,,0000,0000,0000,,Маған мұны істеуге рұқсат етіңіз.
Dialogue: 0,0:09:43.05,0:09:47.02,Default,,0000,0000,0000,,Бұл өте жаман, Гоку.
Dialogue: 0,0:09:43.05,0:09:47.02,Default,,0000,0000,0000,,Біреудің санасын басып алуға ұқсас күш—
Dialogue: 0,0:09:50.06,0:09:53.03,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:09:59.07,0:10:04.07,Default,,0000,0000,0000,,Тетете...!
Dialogue: 0,0:10:04.07,0:10:07.04,Default,,0000,0000,0000,,
Dialogue: 0,0:10:11.08,0:10:14.05,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:10:16.08,0:10:19.09,Default,,0000,0000,0000,,
Dialogue: 0,0:10:19.09,0:10:23.09,Default,,0000,0000,0000,,Бұл жігіт
Dialogue: 0,0:10:19.09,0:10:23.09,Default,,0000,0000,0000,,Сіз қашаннан бастап ұйықтай бастадыңыз?
Dialogue: 0,0:10:23.09,0:10:27.06,Default,,0000,0000,0000,,Енді, енді.
Dialogue: 0,0:10:23.09,0:10:27.06,Default,,0000,0000,0000,,Өйткені ештеңе болмаған сияқты.
Dialogue: 0,0:10:30.10,0:10:33.03,Default,,0000,0000,0000,,Ах, жақсы!
Dialogue: 0,0:10:33.03,0:10:36.04,Default,,0000,0000,0000,,Бұл жолы ұшақ ұрланған жоқ.
Dialogue: 0,0:10:33.03,0:10:36.04,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:10:36.04,0:10:40.01,Default,,0000,0000,0000,,Күтілгендей, бұл әскери полиция ұшағы болды.
Dialogue: 0,0:10:36.04,0:10:40.01,Default,,0000,0000,0000,,Оны ешкім ұрламайды.
Dialogue: 0,0:10:46.05,0:10:51.05,Default,,0000,0000,0000,,Варп-саманың орнына
Dialogue: 0,0:10:46.05,0:10:51.05,Default,,0000,0000,0000,,Оған қанша уақыт кетеді?
Dialogue: 0,0:10:51.05,0:10:54.02,Default,,0000,0000,0000,,Мен мұны күннің соңына дейін аламын деп ойлаймын.
Dialogue: 0,0:10:57.06,0:10:59.06,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:10:59.06,0:11:03.06,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:11:03.06,0:11:07.03,Default,,0000,0000,0000,,Ұшақтар жоқ! ?
Dialogue: 0,0:11:27.99,0:11:29.99,Default,,0000,0000,0000,,А, сен істедің бе?
Dialogue: 0,0:11:29.99,0:11:33.93,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:11:29.99,0:11:33.93,Default,,0000,0000,0000,,Ұрланған.
Dialogue: 0,0:11:33.93,0:11:36.93,Default,,0000,0000,0000,,Бұл бастапқыда ұрланған ұшақ болды, бірақ
Dialogue: 0,0:11:33.93,0:11:36.93,Default,,0000,0000,0000,,Ұрланған.
Dialogue: 0,0:11:36.93,0:11:38.93,Default,,0000,0000,0000,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:11:38.93,0:11:43.94,Default,,0000,0000,0000,,Мүмкін сіз барда болған шығарсыз.
Dialogue: 0,0:11:38.93,0:11:43.94,Default,,0000,0000,0000,,Оны үрлегендердің ісі.
Dialogue: 0,0:11:43.94,0:11:45.91,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:11:47.94,0:11:50.94,Default,,0000,0000,0000,,《Гяхахаха...! 》
Dialogue: 0,0:11:50.94,0:11:54.95,Default,,0000,0000,0000,,《Иә? Эй! 》
Dialogue: 0,0:11:54.95,0:11:56.95,Default,,0000,0000,0000,,《Иә?》
Dialogue: 0,0:11:56.95,0:11:59.95,Default,,0000,0000,0000,,《Қайда жүрсің?
Dialogue: 0,0:11:56.95,0:11:59.95,Default,,0000,0000,0000,,Иә! 》
Dialogue: 0,0:11:59.95,0:12:01.95,Default,,0000,0000,0000,,Бұл не өзі?!
Dialogue: 0,0:11:59.95,0:12:01.95,Default,,0000,0000,0000,,《Ғұн》
Dialogue: 0,0:12:01.95,0:12:04.96,Default,,0000,0000,0000,,《Уау! Уау…》
Dialogue: 0,0:12:04.96,0:12:07.63,Default,,0000,0000,0000,,《Қарындас бала! 》
Dialogue: 0,0:12:07.63,0:12:10.96,Default,,0000,0000,0000,,《Ябе! 》
Dialogue: 0,0:12:07.63,0:12:10.96,Default,,0000,0000,0000,,《Таа! 》
Dialogue: 0,0:12:10.96,0:12:12.93,Default,,0000,0000,0000,,《Сәлем! 》
Dialogue: 0,0:12:15.97,0:12:17.94,Default,,0000,0000,0000,,《Ғұн》
Dialogue: 0,0:12:23.98,0:12:26.98,Default,,0000,0000,0000,,Қарғыс атсын. Сол жігіттер...
Dialogue: 0,0:12:26.98,0:12:28.98,Default,,0000,0000,0000,,Егер мен бұны қазір айтпасам, кейін қарама-қайшылықтар туындауы мүмкін.
Dialogue: 0,0:12:28.98,0:12:31.92,Default,,0000,0000,0000,,Ханшайымға хабарласыңыз
Dialogue: 0,0:12:28.98,0:12:31.92,Default,,0000,0000,0000,,Мен сені осы жерден айдап берейін.
Dialogue: 0,0:12:31.92,0:12:34.92,Default,,0000,0000,0000,,
Dialogue: 0,0:12:31.92,0:12:34.92,Default,,0000,0000,0000,,Оған дейін осында күту керек.
Dialogue: 0,0:12:34.92,0:12:37.92,Default,,0000,0000,0000,,Күрсін, жалығып бара жатырмын.
Dialogue: 0,0:12:37.92,0:12:41.93,Default,,0000,0000,0000,,Сіз зомби ойындарын да ойнайсыз ба?
Dialogue: 0,0:12:37.92,0:12:41.93,Default,,0000,0000,0000,,Не? сол.
Dialogue: 0,0:12:41.93,0:12:43.93,Default,,0000,0000,0000,,
Dialogue: 0,0:12:41.93,0:12:43.93,Default,,0000,0000,0000,,Жақын жерде зомби орманы бар. ➡
Dialogue: 0,0:12:43.93,0:12:46.93,Default,,0000,0000,0000,,Көптеген зомбилерді өлтірген жігіт
Dialogue: 0,0:12:43.93,0:12:46.93,Default,,0000,0000,0000,,Сіз жеңдіңіз.
Dialogue: 0,0:12:46.93,0:12:50.94,Default,,0000,0000,0000,,Мені тістеп алып, өзім зомби болып кетсем ше?
Dialogue: 0,0:12:46.93,0:12:50.94,Default,,0000,0000,0000,,Сіз дисквалификациясыз.
Dialogue: 0,0:12:50.94,0:12:54.94,Default,,0000,0000,0000,,Мүлдем жоқ!
Dialogue: 0,0:12:50.94,0:12:54.94,Default,,0000,0000,0000,,Мен де тоқтаймын.
Dialogue: 0,0:12:54.94,0:12:57.94,Default,,0000,0000,0000,,Бұл қызық.
Dialogue: 0,0:12:57.94,0:12:59.61,Default,,0000,0000,0000,,Иә? ➡
Dialogue: 0,0:12:59.61,0:13:02.95,Default,,0000,0000,0000,,Бұл белдікте.
Dialogue: 0,0:12:59.61,0:13:02.95,Default,,0000,0000,0000,,Көз алмасы сияқты...
Dialogue: 0,0:13:02.95,0:13:04.95,Default,,0000,0000,0000,,Бұл ма?
Dialogue: 0,0:13:04.95,0:13:08.95,Default,,0000,0000,0000,,Эй... эй! Ол қазір қозғалды! ?
Dialogue: 0,0:13:08.95,0:13:12.96,Default,,0000,0000,0000,,Баяғыда таудан алған тірі көз алмасын.
Dialogue: 0,0:13:08.95,0:13:12.96,Default,,0000,0000,0000,,Мен оны кидім.
Dialogue: 0,0:13:12.96,0:13:15.96,Default,,0000,0000,0000,,Геге... Варру хобби!
Dialogue: 0,0:13:15.96,0:13:18.93,Default,,0000,0000,0000,,Керемет, солай емес пе?
Dialogue: 0,0:13:26.97,0:13:28.97,Default,,0000,0000,0000,,​​Түсіндім.
Dialogue: 0,0:13:28.97,0:13:32.91,Default,,0000,0000,0000,,Ақпарат жинауды жалғастыру.
Dialogue: 0,0:13:32.91,0:13:36.92,Default,,0000,0000,0000,,⚟ (Гомер)
Dialogue: 0,0:13:32.91,0:13:36.92,Default,,0000,0000,0000,,Не? Бірдеңе болды ма?
Dialogue: 0,0:13:36.92,0:13:40.92,Default,,0000,0000,0000,,Шамасы Жерде
Dialogue: 0,0:13:36.92,0:13:40.92,Default,,0000,0000,0000,,Мені балаға айналдырған сол жігіттер➡
Dialogue: 0,0:13:40.92,0:13:42.92,Default,,0000,0000,0000,,Ол Ұлы Жындар әлеміне кірген сияқты.
Dialogue: 0,0:13:42.92,0:13:46.93,Default,,0000,0000,0000,,Не...не?! ?
Dialogue: 0,0:13:42.92,0:13:46.93,Default,,0000,0000,0000,,Сен не үшін келдің? ? ➡
Dialogue: 0,0:13:46.93,0:13:50.93,Default,,0000,0000,0000,,Әлгі Намекиан брат
Dialogue: 0,0:13:46.93,0:13:50.93,Default,,0000,0000,0000,,Құтқарылу! ?
Dialogue: 0,0:13:50.93,0:13:52.60,Default,,0000,0000,0000,,Мен білмеймін➡
Dialogue: 0,0:13:52.60,0:13:55.94,Default,,0000,0000,0000,,Әзірге мұнда Айдаһар шарлары бар.
Dialogue: 0,0:13:52.60,0:13:55.94,Default,,0000,0000,0000,,Олар соған ұмтылған сияқты.
Dialogue: 0,0:13:55.94,0:13:59.94,Default,,0000,0000,0000,,Айдаһар добы! ?
Dialogue: 0,0:13:55.94,0:13:59.94,Default,,0000,0000,0000,,～
Dialogue: 0,0:13:59.94,0:14:04.94,Default,,0000,0000,0000,,Хаха! Мақсаты не екенін білмеймін
Dialogue: 0,0:13:59.94,0:14:04.94,Default,,0000,0000,0000,,Бұл мүмкін емес!
Dialogue: 0,0:14:04.94,0:14:08.95,Default,,0000,0000,0000,,Бұл кеше болды➡
Dialogue: 0,0:14:08.95,0:14:10.95,Default,,0000,0000,0000,,Үшінші жын әлемінің Айдаһар добы
Dialogue: 0,0:14:08.95,0:14:10.95,Default,,0000,0000,0000,,Мен түсіндім...
Dialogue: 0,0:14:10.95,0:14:12.95,Default,,0000,0000,0000,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:14:12.95,0:14:17.96,Default,,0000,0000,0000,,Мынау... Мен мұны балаға жасадым...
Dialogue: 0,0:14:12.95,0:14:17.96,Default,,0000,0000,0000,,Бұл өте ақымақ... Уф….
Dialogue: 0,0:14:17.96,0:14:19.63,Default,,0000,0000,0000,,Иә? ➡
Dialogue: 0,0:14:19.63,0:14:22.96,Default,,0000,0000,0000,,Күте тұрыңыз... Кеше ме?
Dialogue: 0,0:14:19.63,0:14:22.96,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:14:22.96,0:14:28.97,Default,,0000,0000,0000,,Осы уақытқа дейін не істедіңіз?
Dialogue: 0,0:14:22.96,0:14:28.97,Default,,0000,0000,0000,,Ақымақ!
Dialogue: 0,0:14:28.97,0:14:34.91,Default,,0000,0000,0000,,Уф! өте өкінішті!
Dialogue: 0,0:14:28.97,0:14:34.91,Default,,0000,0000,0000,,Әскери полицияның да көңілі қалған сияқты.
Dialogue: 0,0:14:34.91,0:14:36.91,Default,,0000,0000,0000,,Сене алар емеспін... ➡
Dialogue: 0,0:14:36.91,0:14:40.91,Default,,0000,0000,0000,,Сол жігіттер
Dialogue: 0,0:14:36.91,0:14:40.91,Default,,0000,0000,0000,,Тамагамиді жеңдім дедіңіз бе? Уф….
Dialogue: 0,0:14:40.91,0:14:46.92,Default,,0000,0000,0000,,Қазіргі уақытта екінші жын әлемінде болуы мүмкін.
Dialogue: 0,0:14:40.91,0:14:46.92,Default,,0000,0000,0000,,Менің ойымша, олар Айдаһар доптарының артынан жүр...
Dialogue: 0,0:14:46.92,0:14:49.92,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:14:46.92,0:14:49.92,Default,,0000,0000,0000,,...
Dialogue: 0,0:14:49.92,0:14:53.89,Default,,0000,0000,0000,,Өзің бар
Dialogue: 0,0:14:49.92,0:14:53.89,Default,,0000,0000,0000,,Бірдеңені тез істе!
Dialogue: 0,0:14:55.93,0:14:58.93,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:14:58.93,0:15:04.90,Default,,0000,0000,0000,,Өйткені, мен сол үшінші көзді қалаймын.
Dialogue: 0,0:14:58.93,0:15:04.90,Default,,0000,0000,0000,,Ең алдымен соны тілеуім керек еді!
Dialogue: 0,0:15:06.94,0:15:09.94,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:15:09.94,0:15:12.95,Default,,0000,0000,0000,,⚟ (Ұшу дыбысы)
Dialogue: 0,0:15:12.95,0:15:14.95,Default,,0000,0000,0000,,Бұл Какарот.
Dialogue: 0,0:15:14.95,0:15:19.92,Default,,0000,0000,0000,,Сәлем! Эй!
Dialogue: 0,0:15:25.96,0:15:27.96,Default,,0000,0000,0000,,О.
Dialogue: 0,0:15:27.96,0:15:29.63,Default,,0000,0000,0000,,Кешіктің, Какарот!
Dialogue: 0,0:15:29.63,0:15:31.96,Default,,0000,0000,0000,,(Кайошин)
Dialogue: 0,0:15:29.63,0:15:31.96,Default,,0000,0000,0000,,Ұшақ ұрланған сияқты.
Dialogue: 0,0:15:31.96,0:15:35.97,Default,,0000,0000,0000,,Менде қорқынышты оқиға болды.
Dialogue: 0,0:15:35.97,0:15:37.97,Default,,0000,0000,0000,,Сіз ханшайымсыз ба?
Dialogue: 0,0:15:37.97,0:15:39.97,Default,,0000,0000,0000,,Бұл Панджи. сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:15:39.97,0:15:41.97,Default,,0000,0000,0000,,Мен Бұлмамын. ➡
Dialogue: 0,0:15:41.97,0:15:43.98,Default,,0000,0000,0000,,Бұл Вегета➡
Dialogue: 0,0:15:43.98,0:15:45.98,Default,,0000,0000,0000,,Бұл Пикколо.
Dialogue: 0,0:15:45.98,0:15:49.98,Default,,0000,0000,0000,,Әй, бұл Намекиан!
Dialogue: 0,0:15:45.98,0:15:49.98,Default,,0000,0000,0000,,Мен шынайы нәрсені бірінші рет көрдім!
Dialogue: 0,0:15:49.98,0:15:54.99,Default,,0000,0000,0000,,Иә? Кибито ше?
Dialogue: 0,0:15:49.98,0:15:54.99,Default,,0000,0000,0000,,Егер сіз ғибадатханада қалсаңыз.
Dialogue: 0,0:15:54.99,0:15:57.99,Default,,0000,0000,0000,,Сонымен үшеуіңіз келдіңіздер ме?
Dialogue: 0,0:15:57.99,0:16:00.99,Default,,0000,0000,0000,,Жындар әлемінің айдаһар шары
Dialogue: 0,0:15:57.99,0:16:00.99,Default,,0000,0000,0000,,Түсінген сияқтысыз.
Dialogue: 0,0:16:00.99,0:16:03.00,Default,,0000,0000,0000,,О! Бір!
Dialogue: 0,0:16:03.00,0:16:06.00,Default,,0000,0000,0000,,Маған тезірек ат салыңыз.
Dialogue: 0,0:16:06.00,0:16:10.00,Default,,0000,0000,0000,,Мен бұл жерден шаршадым.
Dialogue: 0,0:16:06.00,0:16:10.00,Default,,0000,0000,0000,,Олай айтпа.
Dialogue: 0,0:16:10.00,0:16:13.01,Default,,0000,0000,0000,,Осы жазықтықта
Dialogue: 0,0:16:10.00,0:16:13.01,Default,,0000,0000,0000,,Менің көп уақытым қалмады.
Dialogue: 0,0:16:13.01,0:16:14.67,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:16:14.67,0:16:18.01,Default,,0000,0000,0000,,Ей!
Dialogue: 0,0:16:14.67,0:16:18.01,Default,,0000,0000,0000,,Сіз мені мінгіземін дедіңіз!
Dialogue: 0,0:16:18.01,0:16:21.01,Default,,0000,0000,0000,,Егер сіз жүкті түсірсеңіз
Dialogue: 0,0:16:18.01,0:16:21.01,Default,,0000,0000,0000,,Бұл қалай да болады!
Dialogue: 0,0:16:21.01,0:16:24.02,Default,,0000,0000,0000,,Азық-түлік және шатырлар
Dialogue: 0,0:16:21.01,0:16:24.02,Default,,0000,0000,0000,,Мен оны төмендете алмаймын.
Dialogue: 0,0:16:24.02,0:16:26.02,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:16:26.02,0:16:27.69,Default,,0000,0000,0000,,Олай болса, әкеме➡
Dialogue: 0,0:16:27.69,0:16:31.96,Default,,0000,0000,0000,,Басқа ұшақты сатып алыңыз
Dialogue: 0,0:16:27.69,0:16:31.96,Default,,0000,0000,0000,,Мен сізден тағы біраз күтуіңізді сұраймын.
Dialogue: 0,0:16:31.96,0:16:35.96,Default,,0000,0000,0000,,Олай болса, біз
Dialogue: 0,0:16:31.96,0:16:35.96,Default,,0000,0000,0000,,Айдаһар шарларын жинаңыз➡
Dialogue: 0,0:16:35.96,0:16:37.96,Default,,0000,0000,0000,,Алдымен барайық.
Dialogue: 0,0:16:37.96,0:16:40.97,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:16:37.96,0:16:40.97,Default,,0000,0000,0000,,Өйткені біз асығып жатырмыз.
Dialogue: 0,0:16:40.97,0:16:46.97,Default,,0000,0000,0000,,Гррр... ррр...
Dialogue: 0,0:16:40.97,0:16:46.97,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:16:46.97,0:16:48.97,Default,,0000,0000,0000,,Бірдеңе болса, алдымен сендер➡
Dialogue: 0,0:16:48.97,0:16:51.98,Default,,0000,0000,0000,,Король Гомер
Dialogue: 0,0:16:48.97,0:16:51.98,Default,,0000,0000,0000,,Сіз оны жеңе аласыз.
Dialogue: 0,0:16:51.98,0:16:54.98,Default,,0000,0000,0000,,Бір минут, сен
Dialogue: 0,0:16:51.98,0:16:54.98,Default,,0000,0000,0000,,Суық емес! ?
Dialogue: 0,0:16:54.98,0:16:58.98,Default,,0000,0000,0000,,...
Dialogue: 0,0:16:54.98,0:16:58.98,Default,,0000,0000,0000,,Телепортация жасай алатын Кибито
Dialogue: 0,0:16:54.98,0:16:58.98,Default,,0000,0000,0000,,Мен сені әкелесің деп ойладым...
Dialogue: 0,0:16:58.98,0:17:01.99,Default,,0000,0000,0000,,Өл! (Барабан соғу дыбысы)
Dialogue: 0,0:16:58.98,0:17:01.99,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:17:01.99,0:17:04.96,Default,,0000,0000,0000,,⚟Кейін кездескенше!
Dialogue: 0,0:17:07.99,0:17:11.00,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:11.00,0:17:14.00,Default,,0000,0000,0000,,Әлгі бейбақ...
Dialogue: 0,0:17:14.00,0:17:19.00,Default,,0000,0000,0000,,Тамагами деп аталатын адамдармен.
Dialogue: 0,0:17:14.00,0:17:19.00,Default,,0000,0000,0000,,Бәсекелестікке жынды сияқтысың.
Dialogue: 0,0:17:19.00,0:17:21.01,Default,,0000,0000,0000,,Бұл оның жаман әдеті.
Dialogue: 0,0:17:21.01,0:17:25.01,Default,,0000,0000,0000,,Ұшақ келгенше
Dialogue: 0,0:17:21.01,0:17:25.01,Default,,0000,0000,0000,,Зомби ойынын ойнағыңыз келе ме?
Dialogue: 0,0:17:25.01,0:17:27.01,Default,,0000,0000,0000,,Мен мұны істемеймін!
Dialogue: 0,0:17:27.01,0:17:29.98,Default,,0000,0000,0000,,《Оның күші одан сайын артуда》
Dialogue: 0,0:17:27.01,0:17:29.98,Default,,0000,0000,0000,,⚟(Маджин) Сәлем!
Dialogue: 0,0:17:31.95,0:17:35.95,Default,,0000,0000,0000,,Сіз кеше жақсы жұмыс істедіңіз!
Dialogue: 0,0:17:35.95,0:17:40.96,Default,,0000,0000,0000,,Бала жалағандай
Dialogue: 0,0:17:35.95,0:17:40.96,Default,,0000,0000,0000,,Себебі, асқазанның ісігі кетпейді➡
Dialogue: 0,0:17:40.96,0:17:46.97,Default,,0000,0000,0000,,Барлық қорқынышты ниггаларды жинаңыз
Dialogue: 0,0:17:40.96,0:17:46.97,Default,,0000,0000,0000,,Мен саған өтеуге келдім!
Dialogue: 0,0:17:46.97,0:17:51.97,Default,,0000,0000,0000,,О Юбе
Dialogue: 0,0:17:46.97,0:17:51.97,Default,,0000,0000,0000,,Барда бәлеге түскен шайтандар.
Dialogue: 0,0:17:51.97,0:17:53.97,Default,,0000,0000,0000,,Мен жай ғана гидпін➡
Dialogue: 0,0:17:53.97,0:17:57.98,Default,,0000,0000,0000,,Қашықтықта
Dialogue: 0,0:17:53.97,0:17:57.98,Default,,0000,0000,0000,,Ол тәттілерді де жейді.
Dialogue: 0,0:17:57.98,0:18:01.98,Default,,0000,0000,0000,,Біздің ұшақты кім ұрлады?
Dialogue: 0,0:17:57.98,0:18:01.98,Default,,0000,0000,0000,,Балалар сендерсіңдер ме?
Dialogue: 0,0:18:01.98,0:18:07.99,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:18:01.98,0:18:07.99,Default,,0000,0000,0000,,Мен жарақат алдым. Әрине!
Dialogue: 0,0:18:07.99,0:18:12.99,Default,,0000,0000,0000,,Ие хи хи хи...!
Dialogue: 0,0:18:07.99,0:18:12.99,Default,,0000,0000,0000,,Жылап кешірім сұрасаң да, тым кеш!
Dialogue: 0,0:18:12.99,0:18:14.99,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:18:14.99,0:18:16.96,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:19.00,0:18:26.00,Default,,0000,0000,0000,,Бұл дұрыс болды.
Dialogue: 0,0:18:19.00,0:18:26.00,Default,,0000,0000,0000,,Бұл тітіркендіргіш!
Dialogue: 0,0:18:26.00,0:18:27.97,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:18:30.01,0:18:31.98,Default,,0000,0000,0000,,Хмм... мм.
Dialogue: 0,0:18:33.95,0:18:35.61,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:18:35.61,0:18:37.62,Default,,0000,0000,0000,,Жаса!
Dialogue: 0,0:18:37.62,0:18:40.95,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:18:37.62,0:18:40.95,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:40.95,0:18:43.92,Default,,0000,0000,0000,,Иә? Ах!
Dialogue: 0,0:18:45.96,0:18:48.96,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:18:45.96,0:18:48.96,Default,,0000,0000,0000,,Арх! Гррр!
Dialogue: 0,0:18:48.96,0:18:54.97,Default,,0000,0000,0000,,Уау! Вачо!
Dialogue: 0,0:18:48.96,0:18:54.97,Default,,0000,0000,0000,,Вачача...! Вачо!
Dialogue: 0,0:18:54.97,0:18:56.94,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:18:54.97,0:18:56.94,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:19:01.97,0:19:03.64,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:19:03.64,0:19:05.91,Default,,0000,0000,0000,,Уф! Ахх...
Dialogue: 0,0:19:09.98,0:19:11.98,Default,,0000,0000,0000,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,0:19:11.98,0:19:13.95,Default,,0000,0000,0000,,Абай бол, ДжоДжо!
Dialogue: 0,0:19:18.99,0:19:25.00,Default,,0000,0000,0000,,Әзіл!
Dialogue: 0,0:19:18.99,0:19:25.00,Default,,0000,0000,0000,,Балалар, орындаңдар!
Dialogue: 0,0:19:25.00,0:19:27.00,Default,,0000,0000,0000,,Уф... уф...
Dialogue: 0,0:19:27.00,0:19:30.94,Default,,0000,0000,0000,,А... аа!
Dialogue: 0,0:19:30.94,0:19:33.94,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:19:33.94,0:19:35.94,Default,,0000,0000,0000,,А... ➡
Dialogue: 0,0:19:35.94,0:19:38.94,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:38.94,0:19:40.95,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:19:40.95,0:19:43.92,Default,,0000,0000,0000,,Ах... а...
Dialogue: 0,0:19:46.95,0:19:48.95,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:19:48.95,0:19:50.96,Default,,0000,0000,0000,,Ума ана…. ➡
Dialogue: 0,0:19:50.96,0:19:53.63,Default,,0000,0000,0000,,Иә! Умаумаума...!
Dialogue: 0,0:19:53.63,0:19:56.96,Default,,0000,0000,0000,,Арх! Хин!
Dialogue: 0,0:19:56.96,0:19:59.97,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:19:56.96,0:19:59.97,Default,,0000,0000,0000,,Бұл тіпті уақытты өлтірудің жақсы тәсілі емес еді.
Dialogue: 0,0:19:59.97,0:20:02.97,Default,,0000,0000,0000,,ветчина ветчина.
Dialogue: 0,0:20:02.97,0:20:05.97,Default,,0000,0000,0000,,Уау. Бұл таңқаларлық жылдам емес пе?
Dialogue: 0,0:20:05.97,0:20:09.98,Default,,0000,0000,0000,,Картоп чипсы
Dialogue: 0,0:20:05.97,0:20:09.98,Default,,0000,0000,0000,,Мен тек екі кесе жей алдым.
Dialogue: 0,0:20:09.98,0:20:13.98,Default,,0000,0000,0000,,Ұшақты қайтару.
Dialogue: 0,0:20:09.98,0:20:13.98,Default,,0000,0000,0000,,Иә... Иә.
Dialogue: 0,0:20:13.98,0:20:17.98,Default,,0000,0000,0000,,Сонымен... жақын жерде.
Dialogue: 0,0:20:13.98,0:20:17.98,Default,,0000,0000,0000,,Бұл жасырын...
Dialogue: 0,0:20:17.98,0:20:21.99,Default,,0000,0000,0000,,күрсіну. Бұл қорқынышты жер.
Dialogue: 0,0:20:21.99,0:20:25.96,Default,,0000,0000,0000,,Тек қызығушылықтан
Dialogue: 0,0:20:21.99,0:20:25.96,Default,,0000,0000,0000,,Менің келмеуім керек еді.
Dialogue: 0,0:20:30.93,0:20:32.93,Default,,0000,0000,0000,,Уақыт келді емес пе?
Dialogue: 0,0:20:32.93,0:20:35.93,Default,,0000,0000,0000,,Ах. ➡
Dialogue: 0,0:20:35.93,0:20:37.94,Default,,0000,0000,0000,,О, құдайым.
Dialogue: 0,0:20:37.94,0:20:44.94,Default,,0000,0000,0000,,Бұрын олар тіпті сыртқы әлемге де сататын.
Dialogue: 0,0:20:37.94,0:20:44.94,Default,,0000,0000,0000,,Сайбайман тұқымдары көп болды➡
Dialogue: 0,0:20:44.94,0:20:46.95,Default,,0000,0000,0000,,Тек екі дән қалды.
Dialogue: 0,0:20:46.95,0:20:52.95,Default,,0000,0000,0000,,Бұл орындалмауы мүмкін.
Dialogue: 0,0:20:46.95,0:20:52.95,Default,,0000,0000,0000,,Алдымен бір ғана дәнді сынап көрейік.
Dialogue: 0,0:20:52.95,0:20:55.95,Default,,0000,0000,0000,,Сіз маған сенбейсіз.
Dialogue: 0,0:20:55.95,0:20:59.96,Default,,0000,0000,0000,,Сиқыр
Dialogue: 0,0:20:55.95,0:20:59.96,Default,,0000,0000,0000,,Өйткені Маджин Буу
Dialogue: 0,0:20:55.95,0:20:59.96,Default,,0000,0000,0000,,Бұл кездейсоқ болды, солай ма?
Dialogue: 0,0:20:59.96,0:21:05.96,Default,,0000,0000,0000,,Хун. Жарайды.
Dialogue: 0,0:20:59.96,0:21:05.96,Default,,0000,0000,0000,,Олай болса мына бір дәнді көм. ➡
Dialogue: 0,0:21:05.96,0:21:09.97,Default,,0000,0000,0000,,Оны тым тереңге көммеңіз.
Dialogue: 0,0:21:05.96,0:21:09.97,Default,,0000,0000,0000,,Тереңдігі шамамен 5 см.
Dialogue: 0,0:21:09.97,0:21:11.97,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:11.97,0:21:14.97,Default,,0000,0000,0000,,(Марва)
Dialogue: 0,0:21:11.97,0:21:14.97,Default,,0000,0000,0000,,Маджин Буудың сығындысы артады➡
Dialogue: 0,0:21:14.97,0:21:17.98,Default,,0000,0000,0000,,Сіз оны басқара алмайсыз.
Dialogue: 0,0:21:17.98,0:21:20.95,Default,,0000,0000,0000,,Бұл жақсы ма?
Dialogue: 0,0:21:17.98,0:21:20.95,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:21:22.98,0:21:26.95,Default,,0000,0000,0000,,(терең тыныс алу дыбысы)
Dialogue: 0,0:21:36.93,0:21:38.93,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:21:38.93,0:21:40.90,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:43.94,0:21:46.91,Default,,0000,0000,0000,,Хе хе хи....
Dialogue: 0,0:21:52.94,0:21:54.95,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:21:54.95,0:21:56.95,Default,,0000,0000,0000,,Жақсы көрінеді! ➡
Dialogue: 0,0:21:56.95,0:22:01.95,Default,,0000,0000,0000,,Сайбайманға негізделген
Dialogue: 0,0:21:56.95,0:22:01.95,Default,,0000,0000,0000,,Құбыжықтардың кейбір түрлерін ➡ қосыңыз
Dialogue: 0,0:22:01.95,0:22:07.93,Default,,0000,0000,0000,,Арнайы Majin Buu сығындысымен
Dialogue: 0,0:22:01.95,0:22:07.93,Default,,0000,0000,0000,,Мажин
Dialogue: 0,0:22:01.95,0:22:07.93,Default,,0000,0000,0000,,Мен жасаған жын...
Dialogue: 0,0:22:12.96,0:22:14.93,Default,,0000,0000,0000,,Бұл Куу.
Dialogue: 0,0:22:19.97,0:22:21.97,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:22:21.97,0:22:24.98,Default,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:22:21.97,0:22:24.98,Default,,0000,0000,0000,,Маған бірден жасап көрейін. ➡
Dialogue: 0,0:22:24.98,0:22:28.98,Default,,0000,0000,0000,,Бірінші нөмірлі Тамагамиді жеңіңіз➡
Dialogue: 0,0:22:28.98,0:22:31.92,Default,,0000,0000,0000,,Айдаһар добы
Dialogue: 0,0:22:28.98,0:22:31.92,Default,,0000,0000,0000,,Оны алыңыз!
Dialogue: 0,0:22:31.92,0:22:35.92,Default,,0000,0000,0000,,Жоқ... кенет, Тамагами...
Dialogue: 0,0:22:35.92,0:22:42.89,Default,,0000,0000,0000,,Иә. Сондай күшті болуы керек
Dialogue: 0,0:22:35.92,0:22:42.89,Default,,0000,0000,0000,,Жасалған мағына жоқ.
Dialogue: 0,0:22:45.93,0:22:49.94,Default,,0000,0000,0000,,Иә. Менде бар.
Dialogue: 0,0:22:49.94,0:22:59.91,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:01.41,0:23:07.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory