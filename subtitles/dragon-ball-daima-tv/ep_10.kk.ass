Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.00,0:00:05.00,Default,,0000,0000,0000,,[Айдаһар шары дегеніміз не?
Dialogue: 0,0:00:02.00,0:00:05.00,Default,,0000,0000,0000,,7 бөлікті жинап, құпия сөзді айт➡
Dialogue: 0,0:00:05.00,0:00:07.01,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:00:05.00,0:00:07.01,Default,,0000,0000,0000,,Шенрон пайда болады➡
Dialogue: 0,0:00:07.01,0:00:12.01,Default,,0000,0000,0000,,Кез келген тілек орындалады
Dialogue: 0,0:00:07.01,0:00:12.01,Default,,0000,0000,0000,,Бұл жұмбақ доп]
Dialogue: 0,0:00:12.01,0:00:20.02,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:00:12.01,0:00:20.02,Default,,0000,0000,0000,,Гоку
Dialogue: 0,0:00:12.01,0:00:20.02,Default,,0000,0000,0000,,[Сон Гоку әлі зұлымдық қолынан құтылған.
Dialogue: 0,0:00:12.01,0:00:20.02,Default,,0000,0000,0000,,Жерді қорғауды жалғастыру]
Dialogue: 0,0:00:20.02,0:00:30.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:08.96,0:02:10.93,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:02:12.97,0:02:14.97,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:02:14.97,0:02:17.97,Default,,0000,0000,0000,,Сиқыр
Dialogue: 0,0:02:14.97,0:02:17.97,Default,,0000,0000,0000,,Сәлем. Мен Маджин Куумын.
Dialogue: 0,0:02:17.97,0:02:20.97,Default,,0000,0000,0000,,Сол Айдаһар шары
Dialogue: 0,0:02:17.97,0:02:20.97,Default,,0000,0000,0000,,Мен оны алуға келдім!
Dialogue: 0,0:02:20.97,0:02:22.98,Default,,0000,0000,0000,,Сіз байсалдысыз ба?
Dialogue: 0,0:02:22.98,0:02:24.94,Default,,0000,0000,0000,,Әрине.
Dialogue: 0,0:02:26.98,0:02:29.98,Default,,0000,0000,0000,,(Бірінші нөмір)
Dialogue: 0,0:02:26.98,0:02:29.98,Default,,0000,0000,0000,,Мен Тамагами нөмірі біріншімін.
Dialogue: 0,0:02:29.98,0:02:31.92,Default,,0000,0000,0000,,Олай болса жарысайық.
Dialogue: 0,0:02:31.92,0:02:35.92,Default,,0000,0000,0000,,Хехехе. Дайын бол.
Dialogue: 0,0:02:35.92,0:02:38.93,Default,,0000,0000,0000,,Енді бұл басы!
Dialogue: 0,0:02:38.93,0:02:40.93,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:02:38.93,0:02:40.93,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:02:40.93,0:02:43.93,Default,,0000,0000,0000,,Уау! Хохохохо...!
Dialogue: 0,0:02:43.93,0:02:45.93,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:45.93,0:02:48.94,Default,,0000,0000,0000,,Дааааа! ➡
Dialogue: 0,0:02:48.94,0:02:50.94,Default,,0000,0000,0000,,Шааа!
Dialogue: 0,0:02:50.94,0:02:53.61,Default,,0000,0000,0000,,Дааааааа...! ➡
Dialogue: 0,0:02:53.61,0:02:55.28,Default,,0000,0000,0000,,Сәлем...!
Dialogue: 0,0:02:55.28,0:02:57.24,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:03:00.95,0:03:04.92,Default,,0000,0000,0000,,Куә!
Dialogue: 0,0:03:11.96,0:03:13.93,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:03:22.97,0:03:24.97,Default,,0000,0000,0000,,Райнер, кейін кездескенше.
Dialogue: 0,0:03:22.97,0:03:24.97,Default,,0000,0000,0000,,Иә? Ауырады...
Dialogue: 0,0:03:24.97,0:03:26.97,Default,,0000,0000,0000,,Маған PIN кодыңызды айтыңыз.
Dialogue: 0,0:03:26.97,0:03:28.98,Default,,0000,0000,0000,,1022.
Dialogue: 0,0:03:28.98,0:03:31.91,Default,,0000,0000,0000,,Бұл әскери полиция нөмірі.
Dialogue: 0,0:03:28.98,0:03:31.91,Default,,0000,0000,0000,,Олай емес сияқты.
Dialogue: 0,0:03:31.91,0:03:34.91,Default,,0000,0000,0000,,Біз әскери полицияның отбасымыз.
Dialogue: 0,0:03:34.91,0:03:38.89,Default,,0000,0000,0000,,Джо! Жарайды.
Dialogue: 0,0:03:34.91,0:03:38.89,Default,,0000,0000,0000,,Тез жүр!
Dialogue: 0,0:03:40.92,0:03:42.92,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:03:42.92,0:03:46.93,Default,,0000,0000,0000,,Бұл ұшақ туралы әлі де сенімді емеспін.
Dialogue: 0,0:03:42.92,0:03:46.93,Default,,0000,0000,0000,,Сізге хабарласпаған сияқты.
Dialogue: 0,0:03:46.93,0:03:48.93,Default,,0000,0000,0000,,Кайошин
Dialogue: 0,0:03:46.93,0:03:48.93,Default,,0000,0000,0000,,Күтіңіз.
Dialogue: 0,0:03:48.93,0:03:53.93,Default,,0000,0000,0000,,Бұл ұшақ әскери полицияға тиесілі.
Dialogue: 0,0:03:48.93,0:03:53.93,Default,,0000,0000,0000,,PIN нөмірі әскери полицияға да арналған.
Dialogue: 0,0:03:53.93,0:03:56.94,Default,,0000,0000,0000,,Бірінші жын әлемінде кенеттен
Dialogue: 0,0:03:53.93,0:03:56.94,Default,,0000,0000,0000,,Сіз бара аласыз, солай ма?
Dialogue: 0,0:03:56.94,0:03:58.94,Default,,0000,0000,0000,,Шынында да.
Dialogue: 0,0:03:58.94,0:04:01.94,Default,,0000,0000,0000,,Олай болса, Айдаһар доп.
Dialogue: 0,0:03:58.94,0:04:01.94,Default,,0000,0000,0000,,Сіз оларды жинай алмайсыз, солай ма?
Dialogue: 0,0:04:01.94,0:04:06.95,Default,,0000,0000,0000,,Ораның бастапқы қалпына келуі үшін
Dialogue: 0,0:04:01.94,0:04:06.95,Default,,0000,0000,0000,,Біріншіден, мен екінші жын әлеміне баруым керек.
Dialogue: 0,0:04:06.95,0:04:08.95,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:04:08.95,0:04:12.95,Default,,0000,0000,0000,,Түсінесің, Грилло.
Dialogue: 0,0:04:08.95,0:04:12.95,Default,,0000,0000,0000,,Бұл Глорио.
Dialogue: 0,0:04:12.95,0:04:15.96,Default,,0000,0000,0000,,Бірақ мен Денде үшін уайымдап жүрмін...
Dialogue: 0,0:04:15.96,0:04:20.96,Default,,0000,0000,0000,,Жоқ, мен мұны бұрын айтқанмын.
Dialogue: 0,0:04:15.96,0:04:20.96,Default,,0000,0000,0000,,Кім сені өлтірмей алып кетті➡
Dialogue: 0,0:04:20.96,0:04:22.96,Default,,0000,0000,0000,,Егер оның пайдалы мәні болса
Dialogue: 0,0:04:20.96,0:04:22.96,Default,,0000,0000,0000,,Сіз осылай ойлайтын шығарсыз.
Dialogue: 0,0:04:22.96,0:04:25.97,Default,,0000,0000,0000,,Намекилер қымбат.
Dialogue: 0,0:04:25.97,0:04:28.94,Default,,0000,0000,0000,,Содан кейін шешілді!
Dialogue: 0,0:04:34.91,0:04:36.91,Default,,0000,0000,0000,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:04:36.91,0:04:39.91,Default,,0000,0000,0000,,Ұшақты кім қайтара алды?
Dialogue: 0,0:04:36.91,0:04:39.91,Default,,0000,0000,0000,,Сіздің жолыңыз болды.
Dialogue: 0,0:04:39.91,0:04:41.91,Default,,0000,0000,0000,,Дұрыс! Уху...
Dialogue: 0,0:04:41.91,0:04:43.92,Default,,0000,0000,0000,,Денді құтқарсам да➡
Dialogue: 0,0:04:43.92,0:04:47.92,Default,,0000,0000,0000,,Сәби кезінде
Dialogue: 0,0:04:43.92,0:04:47.92,Default,,0000,0000,0000,,Айдаһар шарларын әзірше пайдалана алмайсыз.
Dialogue: 0,0:04:47.92,0:04:49.92,Default,,0000,0000,0000,,Какароттың боқтығы
Dialogue: 0,0:04:47.92,0:04:49.92,Default,,0000,0000,0000,,Сіз айтқандай➡
Dialogue: 0,0:04:49.92,0:04:53.93,Default,,0000,0000,0000,,Бұл жерде допты қолданған дұрыс
Dialogue: 0,0:04:49.92,0:04:53.93,Default,,0000,0000,0000,,Бұл дұрыс болуы мүмкін.
Dialogue: 0,0:04:53.93,0:04:58.93,Default,,0000,0000,0000,,Теріңіз өте тегіс.
Dialogue: 0,0:04:53.93,0:04:58.93,Default,,0000,0000,0000,,О, сен де солай ойлайсың ба?
Dialogue: 0,0:04:58.93,0:05:02.94,Default,,0000,0000,0000,,Мен де байқадым!
Dialogue: 0,0:04:58.93,0:05:02.94,Default,,0000,0000,0000,,Бұл өте тығыз!
Dialogue: 0,0:05:02.94,0:05:07.94,Default,,0000,0000,0000,,Ересек өмірге оралмасаңыз да, бар күшіңізді салыңыз
Dialogue: 0,0:05:02.94,0:05:07.94,Default,,0000,0000,0000,,Менің ойымша, бұл үлкен мәселе емес.
Dialogue: 0,0:05:07.94,0:05:09.94,Default,,0000,0000,0000,,Мен сені қыз қылайын ба?
Dialogue: 0,0:05:09.94,0:05:11.94,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:05:11.94,0:05:14.95,Default,,0000,0000,0000,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:05:11.94,0:05:14.95,Default,,0000,0000,0000,,Біз үйлендік!
Dialogue: 0,0:05:14.95,0:05:16.95,Default,,0000,0000,0000,,Маған бәрібір.
Dialogue: 0,0:05:16.95,0:05:19.95,Default,,0000,0000,0000,,Маған бәрібір!
Dialogue: 0,0:05:16.95,0:05:19.95,Default,,0000,0000,0000,,Сенің көзге ұрғың келе ме? ?
Dialogue: 0,0:05:19.95,0:05:23.96,Default,,0000,0000,0000,,Сізде біртүрлі шаш үлгісі бар.
Dialogue: 0,0:05:19.95,0:05:23.96,Default,,0000,0000,0000,,Менің ойымша, сіз үйлендіңіз.
Dialogue: 0,0:05:23.96,0:05:27.96,Default,,0000,0000,0000,,Сіз... дейсіз бе?
Dialogue: 0,0:05:23.96,0:05:27.96,Default,,0000,0000,0000,,Өзіңізді мазақ етпеңіз.
Dialogue: 0,0:05:27.96,0:05:29.96,Default,,0000,0000,0000,,Мен мүлдем
Dialogue: 0,0:05:27.96,0:05:29.96,Default,,0000,0000,0000,,Мен бала болып қалғым келмейді!
Dialogue: 0,0:05:29.96,0:05:33.90,Default,,0000,0000,0000,,Сонда ғана Вегета
Dialogue: 0,0:05:29.96,0:05:33.90,Default,,0000,0000,0000,,Сіз мені ересек адамға айналдыра аласыз ба?
Dialogue: 0,0:05:33.90,0:05:35.90,Default,,0000,0000,0000,,Жоқ, Бұлма да солай!
Dialogue: 0,0:05:35.90,0:05:40.91,Default,,0000,0000,0000,,Хаха. Жарайды онда сен
Dialogue: 0,0:05:35.90,0:05:40.91,Default,,0000,0000,0000,,Сізге үлкен кеуделер ұнайды, солай ма?
Dialogue: 0,0:05:40.91,0:05:43.91,Default,,0000,0000,0000,,Ой... шулы! ауызыңды жап!
Dialogue: 0,0:05:43.91,0:05:46.91,Default,,0000,0000,0000,,Менің айтқаным дұрыс сияқты...
Dialogue: 0,0:05:46.91,0:05:48.92,Default,,0000,0000,0000,,Екеуі де жақсы! ➡
Dialogue: 0,0:05:48.92,0:05:51.88,Default,,0000,0000,0000,,Кенеттен ересек адам болу
Dialogue: 0,0:05:48.92,0:05:51.88,Default,,0000,0000,0000,,Жерге оралу!
Dialogue: 0,0:05:53.92,0:05:56.89,Default,,0000,0000,0000,,Ахх...!
Dialogue: 0,0:05:58.93,0:06:00.59,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:06:00.59,0:06:02.86,Default,,0000,0000,0000,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:06:06.93,0:06:08.94,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:06:08.94,0:06:10.94,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:06:10.94,0:06:16.61,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:06:16.61,0:06:20.88,Default,,0000,0000,0000,,Аһ!
Dialogue: 0,0:06:16.61,0:06:20.88,Default,,0000,0000,0000,,Куу... Ху...
Dialogue: 0,0:06:22.95,0:06:24.95,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:06:24.95,0:06:27.92,Default,,0000,0000,0000,,Ха! Хаха!
Dialogue: 0,0:06:29.96,0:06:32.89,Default,,0000,0000,0000,,Коу! ➡
Dialogue: 0,0:06:32.89,0:06:36.90,Default,,0000,0000,0000,,Сәлем! Эййййййййййййййййййййййй...!
Dialogue: 0,0:06:36.90,0:06:38.87,Default,,0000,0000,0000,,Тееее...!
Dialogue: 0,0:06:41.90,0:06:46.91,Default,,0000,0000,0000,,Сау! !
Dialogue: 0,0:06:46.91,0:06:49.91,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:06:49.91,0:06:52.91,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:06:52.91,0:06:56.88,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:06:52.91,0:06:56.88,Default,,0000,0000,0000,,Бұл не? Екінші жын әлемі!
Dialogue: 0,0:07:06.93,0:07:09.93,Default,,0000,0000,0000,,Олар қазірдің өзінде осында!
Dialogue: 0,0:07:09.93,0:07:11.93,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:07:11.93,0:07:14.93,Default,,0000,0000,0000,,Кай патша, біраз уақыт болды, солай емес пе?
Dialogue: 0,0:07:14.93,0:07:18.94,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:07:14.93,0:07:18.94,Default,,0000,0000,0000,,Бұл шынымен ностальгия.
Dialogue: 0,0:07:18.94,0:07:22.94,Default,,0000,0000,0000,,Бірдеңе жылдам емес пе?
Dialogue: 0,0:07:18.94,0:07:22.94,Default,,0000,0000,0000,,Мұнда ауа ауыр емес.
Dialogue: 0,0:07:22.94,0:07:26.95,Default,,0000,0000,0000,,Мен жылдам ұша аламын
Dialogue: 0,0:07:22.94,0:07:26.95,Default,,0000,0000,0000,,Тамагамидің орны да жақын➡
Dialogue: 0,0:07:26.95,0:07:29.95,Default,,0000,0000,0000,,Сіз бірден сонда боласыз.
Dialogue: 0,0:07:29.95,0:07:32.92,Default,,0000,0000,0000,,Айтпақшы
Dialogue: 0,0:07:29.95,0:07:32.92,Default,,0000,0000,0000,,Кракен әлі де бар ма?
Dialogue: 0,0:07:36.89,0:07:39.89,Default,,0000,0000,0000,,О, әрине, көп.
Dialogue: 0,0:07:39.89,0:07:42.90,Default,,0000,0000,0000,,Не? Бұл не?
Dialogue: 0,0:07:42.90,0:07:46.90,Default,,0000,0000,0000,,Кракен.
Dialogue: 0,0:07:42.90,0:07:46.90,Default,,0000,0000,0000,,Бұл шынымен де үлкен теңіз құбыжығы.
Dialogue: 0,0:07:46.90,0:07:48.90,Default,,0000,0000,0000,,(Кайошин)
Dialogue: 0,0:07:46.90,0:07:48.90,Default,,0000,0000,0000,,Егер сіз абайсызда тым төмен ұшсаңыз➡
Dialogue: 0,0:07:48.90,0:07:51.90,Default,,0000,0000,0000,,Шабуыл жасалды
Dialogue: 0,0:07:48.90,0:07:51.90,Default,,0000,0000,0000,,жұтылады.
Dialogue: 0,0:07:51.90,0:07:53.91,Default,,0000,0000,0000,,Мен бұл туралы естідім.
Dialogue: 0,0:07:53.91,0:07:56.91,Default,,0000,0000,0000,,Сол құбыжық
Dialogue: 0,0:07:53.91,0:07:56.91,Default,,0000,0000,0000,,Бұл өте үлкен➡
Dialogue: 0,0:07:56.91,0:07:58.91,Default,,0000,0000,0000,,Сол сияқты
Dialogue: 0,0:07:56.91,0:07:58.91,Default,,0000,0000,0000,,Арал қозғалып бара жатқан сияқты➡
Dialogue: 0,0:07:58.91,0:08:02.92,Default,,0000,0000,0000,,Оның үлкен тырнақтары бар
Dialogue: 0,0:07:58.91,0:08:02.92,Default,,0000,0000,0000,,Бомбамен жарып жіберсең де...
Dialogue: 0,0:08:02.92,0:08:04.92,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:08:04.92,0:08:06.92,Default,,0000,0000,0000,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:08:06.92,0:08:09.92,Default,,0000,0000,0000,,Не... не?! ?
Dialogue: 0,0:08:09.92,0:08:11.92,Default,,0000,0000,0000,,Маған да шабуыл жасама!
Dialogue: 0,0:08:11.92,0:08:13.93,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:08:13.93,0:08:21.93,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:08:21.93,0:08:25.27,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:08:25.27,0:08:26.94,Default,,0000,0000,0000,,(Баспа дыбысы)
Dialogue: 0,0:08:26.94,0:08:29.94,Default,,0000,0000,0000,,Цк.
Dialogue: 0,0:08:26.94,0:08:29.94,Default,,0000,0000,0000,,Бірақ мен әлі біраз уақыт үйге оралмаймын.
Dialogue: 0,0:08:29.94,0:08:31.94,Default,,0000,0000,0000,,Мен үйренбегендіктен қиын!
Dialogue: 0,0:08:31.94,0:08:33.61,Default,,0000,0000,0000,,Бүйірден келе жатыр!
Dialogue: 0,0:08:33.61,0:08:36.28,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:08:36.28,0:08:37.95,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:08:37.95,0:08:39.92,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:08:41.95,0:08:44.96,Default,,0000,0000,0000,,Бірдеңені тез істе!
Dialogue: 0,0:08:44.96,0:08:46.96,Default,,0000,0000,0000,,Уф! Ол аурады! Мен тілімді тістеп алдым!
Dialogue: 0,0:08:46.96,0:08:49.96,Default,,0000,0000,0000,,Сәлем! Артқы есікті ашыңыз!
Dialogue: 0,0:08:49.96,0:08:51.96,Default,,0000,0000,0000,,​​Түсіндім.
Dialogue: 0,0:08:51.96,0:08:55.97,Default,,0000,0000,0000,,Ахх...!
Dialogue: 0,0:08:55.97,0:08:57.97,Default,,0000,0000,0000,,Не... не?! ?
Dialogue: 0,0:08:57.97,0:08:59.97,Default,,0000,0000,0000,,Сәлем...!
Dialogue: 0,0:08:59.97,0:09:01.97,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:01.97,0:09:03.98,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:09:03.98,0:09:07.98,Default,,0000,0000,0000,,Ахх...! Қарғыс атсын!
Dialogue: 0,0:09:07.98,0:09:09.98,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:09:09.98,0:09:11.98,Default,,0000,0000,0000,,Нунуну….
Dialogue: 0,0:09:11.98,0:09:13.95,Default,,0000,0000,0000,,Маған қашуға рұқсат етіңіз!
Dialogue: 0,0:09:15.99,0:09:18.99,Default,,0000,0000,0000,,Жылдамдықты арттырыңыз!
Dialogue: 0,0:09:18.99,0:09:20.96,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:23.00,0:09:25.00,Default,,0000,0000,0000,,Ахх...!
Dialogue: 0,0:09:25.00,0:09:27.00,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:27.00,0:09:29.00,Default,,0000,0000,0000,,Қат!
Dialogue: 0,0:09:29.00,0:09:31.94,Default,,0000,0000,0000,,Уау! Ах! Сен бейбақ!
Dialogue: 0,0:09:31.94,0:09:34.91,Default,,0000,0000,0000,,Иә...!
Dialogue: 0,0:09:37.94,0:09:39.95,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:09:39.95,0:09:43.95,Default,,0000,0000,0000,,О, құдай!
Dialogue: 0,0:09:39.95,0:09:43.95,Default,,0000,0000,0000,,Мені бір бала өлтірді.
Dialogue: 0,0:09:43.95,0:09:47.95,Default,,0000,0000,0000,,Бұл мен күткеннен де көп...
Dialogue: 0,0:09:47.95,0:09:49.96,Default,,0000,0000,0000,,Нуух….
Dialogue: 0,0:09:49.96,0:09:54.96,Default,,0000,0000,0000,,Қазір барлық әскери полиция
Dialogue: 0,0:09:49.96,0:09:54.96,Default,,0000,0000,0000,,Оларды бірінші жын әлеміне жинаңыз!
Dialogue: 0,0:09:54.96,0:09:58.97,Default,,0000,0000,0000,,Хаха! Сіз жасадыңыз!
Dialogue: 0,0:09:54.96,0:09:58.97,Default,,0000,0000,0000,,Бұл жігіт шынымен де керемет!
Dialogue: 0,0:09:58.97,0:10:00.93,Default,,0000,0000,0000,,Уф… Ах…
Dialogue: 0,0:10:11.98,0:10:13.98,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:10:13.98,0:10:18.99,Default,,0000,0000,0000,,Ge~sso~!
Dialogue: 0,0:10:13.98,0:10:18.99,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:10:18.99,0:10:20.95,Default,,0000,0000,0000,,Мұндағы Штрохейм — сен бетпе-бет келетін соңғы қарсыласың.
Dialogue: 0,0:10:23.99,0:10:26.99,Default,,0000,0000,0000,,оған үкім шығарсын деп қалайтынын.
Dialogue: 0,0:10:23.99,0:10:26.99,Default,,0000,0000,0000,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:10:26.99,0:10:28.66,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:28.66,0:10:31.93,Default,,0000,0000,0000,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:10:33.60,0:10:35.94,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:35.94,0:10:38.94,Default,,0000,0000,0000,,О, жоқ!
Dialogue: 0,0:10:35.94,0:10:38.94,Default,,0000,0000,0000,,Уау! Барлығы, асығыңыздар!
Dialogue: 0,0:10:38.94,0:10:40.94,Default,,0000,0000,0000,,Ооооо...!
Dialogue: 0,0:10:40.94,0:10:42.91,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:10:46.95,0:10:48.95,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:48.95,0:10:50.95,Default,,0000,0000,0000,,Пунду мырза!
Dialogue: 0,0:10:48.95,0:10:50.95,Default,,0000,0000,0000,,Не істеп жатырсың! ?
Dialogue: 0,0:10:50.95,0:10:52.92,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:57.29,0:10:58.96,Default,,0000,0000,0000,,Пунду мырза!
Dialogue: 0,0:10:58.96,0:11:00.63,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:11:00.63,0:11:02.96,Default,,0000,0000,0000,,Ооооо...!
Dialogue: 0,0:11:00.63,0:11:02.96,Default,,0000,0000,0000,,Панжи!
Dialogue: 0,0:11:02.96,0:11:04.96,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:11:04.96,0:11:08.63,Default,,0000,0000,0000,,Жақсысың ба??
Dialogue: 0,0:11:08.63,0:11:10.30,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:11:10.30,0:11:12.87,Default,,0000,0000,0000,,Панжи!
Dialogue: 0,0:11:10.30,0:11:12.87,Default,,0000,0000,0000,,Ой... ой...
Dialogue: 0,0:11:16.98,0:11:19.98,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:11:19.98,0:11:21.98,Default,,0000,0000,0000,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:11:21.98,0:11:23.98,Default,,0000,0000,0000,,Ах... а...
Dialogue: 0,0:11:23.98,0:11:26.95,Default,,0000,0000,0000,,Бақыр!
Dialogue: 0,0:11:28.99,0:11:30.59,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:11:30.59,0:11:33.93,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:11:33.93,0:11:35.90,Default,,0000,0000,0000,,Пунду мырза!
Dialogue: 0,0:11:39.93,0:11:43.90,Default,,0000,0000,0000,,А... бұл қауіпті болды...
Dialogue: 0,0:11:47.94,0:11:50.94,Default,,0000,0000,0000,,Ах! Ол кетті!
Dialogue: 0,0:11:47.94,0:11:50.94,Default,,0000,0000,0000,,Айдаһар добы!
Dialogue: 0,0:11:50.94,0:11:52.95,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:11:52.95,0:11:55.95,Default,,0000,0000,0000,,Жарайды...
Dialogue: 0,0:11:55.95,0:11:58.95,Default,,0000,0000,0000,,Бұл.
Dialogue: 0,0:11:55.95,0:11:58.95,Default,,0000,0000,0000,,Ах! Жасайық, Панджи!
Dialogue: 0,0:11:58.95,0:12:00.92,Default,,0000,0000,0000,,Пунду мырза!
Dialogue: 0,0:12:03.96,0:12:05.96,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:12:05.96,0:12:10.93,Default,,0000,0000,0000,,Қарғыс атсын! Шүкір~! кракенге
Dialogue: 0,0:12:05.96,0:12:10.93,Default,,0000,0000,0000,,Мен жеп қойсам ғой!
Dialogue: 0,0:12:18.97,0:12:20.97,Default,,0000,0000,0000,,Мен артынан келіп, оның көзі мен аузын жауып, «Сізді екінші Кира болуы мүмкін деген күдікпен қамауға аламыз» дедім.
Dialogue: 0,0:12:18.97,0:12:20.97,Default,,0000,0000,0000,,Үзіліс➡
Dialogue: 0,0:12:20.97,0:12:24.98,Default,,0000,0000,0000,,Вегета мен оның достарының келуін күту.
Dialogue: 0,0:12:20.97,0:12:24.98,Default,,0000,0000,0000,,Күтеміз бе?
Dialogue: 0,0:12:24.98,0:12:27.98,Default,,0000,0000,0000,,Дұрыс. Бұл жақсы көрінеді.
Dialogue: 0,0:12:27.98,0:12:33.92,Default,,0000,0000,0000,,Ол жоғалды. бұрынғы ұшақ
Dialogue: 0,0:12:27.98,0:12:33.92,Default,,0000,0000,0000,,Бір ұшақ қалып қойды, мен оны тастап кетуім керек еді.
Dialogue: 0,0:12:33.92,0:12:35.92,Default,,0000,0000,0000,,Жақын жерде➡
Dialogue: 0,0:12:35.92,0:12:39.93,Default,,0000,0000,0000,,Баяғыда Намекияндар
Dialogue: 0,0:12:35.92,0:12:39.93,Default,,0000,0000,0000,,Мен өмір сүрген жұлдыз жүзіп тұр. ➡
Dialogue: 0,0:12:39.93,0:12:41.93,Default,,0000,0000,0000,,Сол жерде күтейік.
Dialogue: 0,0:12:41.93,0:12:44.90,Default,,0000,0000,0000,,О!
Dialogue: 0,0:12:41.93,0:12:44.90,Default,,0000,0000,0000,,Бұл Пикколоның туған қаласы ма?
Dialogue: 0,0:12:58.94,0:13:00.91,Default,,0000,0000,0000,,Хэхехе...
Dialogue: 0,0:13:04.95,0:13:07.95,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:13:04.95,0:13:07.95,Default,,0000,0000,0000,,Ха! ?
Dialogue: 0,0:13:07.95,0:13:09.96,Default,,0000,0000,0000,,Куу….
Dialogue: 0,0:13:09.96,0:13:11.92,Default,,0000,0000,0000,,Ахх...!
Dialogue: 0,0:13:13.96,0:13:16.30,Default,,0000,0000,0000,,Қарғыс атсын... Уф...
Dialogue: 0,0:13:16.30,0:13:17.96,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:13:17.96,0:13:19.97,Default,,0000,0000,0000,,​​Кууууу!
Dialogue: 0,0:13:19.97,0:13:24.97,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:13:24.97,0:13:26.97,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:13:26.97,0:13:29.98,Default,,0000,0000,0000,,Куу….
Dialogue: 0,0:13:29.98,0:13:31.94,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:33.91,0:13:35.88,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:13:38.92,0:13:42.92,Default,,0000,0000,0000,,Себеп
Dialogue: 0,0:13:38.92,0:13:42.92,Default,,0000,0000,0000,,Керемет! Мен бұрын барған Намекке
Dialogue: 0,0:13:38.92,0:13:42.92,Default,,0000,0000,0000,,Дәл солай!
Dialogue: 0,0:13:42.92,0:13:44.92,Default,,0000,0000,0000,,Өзіңізбен бірге ағаш көшеттерін әкеліңіз➡
Dialogue: 0,0:13:44.92,0:13:48.93,Default,,0000,0000,0000,,Жаңа дүние мұндағыдай.
Dialogue: 0,0:13:44.92,0:13:48.93,Default,,0000,0000,0000,,Менің ойымша, олар ойдан шығарды.
Dialogue: 0,0:13:48.93,0:13:52.93,Default,,0000,0000,0000,,Бұл үлкен қиындық болғанына сенімдімін.
Dialogue: 0,0:13:52.93,0:13:57.94,Default,,0000,0000,0000,,Бұл да Фризаның арқасы.
Dialogue: 0,0:13:52.93,0:13:57.94,Default,,0000,0000,0000,,Бұл жоғалып кетті.
Dialogue: 0,0:13:57.94,0:13:59.94,Default,,0000,0000,0000,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:13:59.94,0:14:01.94,Default,,0000,0000,0000,,Бірақ менің қарным ашты.
Dialogue: 0,0:14:01.94,0:14:05.95,Default,,0000,0000,0000,,дүйсенб
Dialogue: 0,0:14:01.94,0:14:05.95,Default,,0000,0000,0000,,Қатерлі ісік
Dialogue: 0,0:14:01.94,0:14:05.95,Default,,0000,0000,0000,,Тағам және Манпукумару
Dialogue: 0,0:14:01.94,0:14:05.95,Default,,0000,0000,0000,,Жоғалғаны ауырады.
Dialogue: 0,0:14:05.95,0:14:09.95,Default,,0000,0000,0000,,Сабырлы болыңыз. Таңғы астан кейін
Dialogue: 0,0:14:05.95,0:14:09.95,Default,,0000,0000,0000,,Бұл көп уақыт болған жоқ.
Dialogue: 0,0:14:09.95,0:14:12.95,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:14:12.95,0:14:17.96,Default,,0000,0000,0000,,Фуккасуши
Dialogue: 0,0:14:12.95,0:14:17.96,Default,,0000,0000,0000,,Қайта тірілу қатесі деп аталатын нәрсе бар.
Dialogue: 0,0:14:12.95,0:14:17.96,Default,,0000,0000,0000,,болды.
Dialogue: 0,0:14:17.96,0:14:21.96,Default,,0000,0000,0000,,Сіздің физикалық күшіңіз қалпына келетін сияқты.
Dialogue: 0,0:14:17.96,0:14:21.96,Default,,0000,0000,0000,,Менің де ішім ісіп кете ме?
Dialogue: 0,0:14:21.96,0:14:26.97,Default,,0000,0000,0000,,Бұл сәл басқаша.
Dialogue: 0,0:14:21.96,0:14:26.97,Default,,0000,0000,0000,,Ішің ісіп кетпесін.
Dialogue: 0,0:14:26.97,0:14:29.94,Default,,0000,0000,0000,,Үшеуі бар. Мен басқа біреуді қалаймын.
Dialogue: 0,0:14:34.91,0:14:38.91,Default,,0000,0000,0000,,Гей…. Жақсы болмай жатыр...
Dialogue: 0,0:14:34.91,0:14:38.91,Default,,0000,0000,0000,,А, бірақ...
Dialogue: 0,0:14:38.91,0:14:41.91,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:14:38.91,0:14:41.91,Default,,0000,0000,0000,,Сергіген кезде➡
Dialogue: 0,0:14:41.91,0:14:45.92,Default,,0000,0000,0000,,Кішкене іш
Dialogue: 0,0:14:41.91,0:14:45.92,Default,,0000,0000,0000,,Ісінген көрінеді.
Dialogue: 0,0:14:45.92,0:14:48.92,Default,,0000,0000,0000,,Бұл қазір
Dialogue: 0,0:14:45.92,0:14:48.92,Default,,0000,0000,0000,,Онда ешкім тұрмайтын сияқты.
Dialogue: 0,0:14:48.92,0:14:52.93,Default,,0000,0000,0000,,Сондай бұлдыр сумен
Dialogue: 0,0:14:48.92,0:14:52.93,Default,,0000,0000,0000,,Тек ағаштар өсетін жер➡
Dialogue: 0,0:14:52.93,0:14:56.93,Default,,0000,0000,0000,,Онда ешкім тұрмайды.
Dialogue: 0,0:14:52.93,0:14:56.93,Default,,0000,0000,0000,,Намекиандықтар енді ғана кетіп қалды.
Dialogue: 0,0:14:56.93,0:14:59.93,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:59.93,0:15:03.94,Default,,0000,0000,0000,,О!
Dialogue: 0,0:14:59.93,0:15:03.94,Default,,0000,0000,0000,,Вегета және басқалары келген сияқты.
Dialogue: 0,0:15:03.94,0:15:06.91,Default,,0000,0000,0000,,Мен сені осында әкелемін.
Dialogue: 0,0:15:09.94,0:15:12.95,Default,,0000,0000,0000,,Сол жігіт
Dialogue: 0,0:15:09.94,0:15:12.95,Default,,0000,0000,0000,,Сенің осында екеніңді қайдан білемін?
Dialogue: 0,0:15:12.95,0:15:15.95,Default,,0000,0000,0000,,Мен оны сеземін.
Dialogue: 0,0:15:15.95,0:15:19.95,Default,,0000,0000,0000,,Бұл шынымен де біртүрлі нәрсе.
Dialogue: 0,0:15:19.95,0:15:22.96,Default,,0000,0000,0000,,Уау! Қандай тамаша жер!
Dialogue: 0,0:15:22.96,0:15:27.96,Default,,0000,0000,0000,,Бұл жын әлеміне мүлдем ұқсамайды.
Dialogue: 0,0:15:22.96,0:15:27.96,Default,,0000,0000,0000,,Пикколо Бұл ностальгиялық, солай ма?
Dialogue: 0,0:15:27.96,0:15:30.96,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:15:27.96,0:15:30.96,Default,,0000,0000,0000,,Менің ата-анам осында тұратын.
Dialogue: 0,0:15:30.96,0:15:33.97,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:15:30.96,0:15:33.97,Default,,0000,0000,0000,,Мына жақтан біреу келе жатыр.
Dialogue: 0,0:15:33.97,0:15:35.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:35.97,0:15:37.97,Default,,0000,0000,0000,,Хун. Бұл Какарот.
Dialogue: 0,0:15:37.97,0:15:39.97,Default,,0000,0000,0000,,Жоқ, бұл Гоку.
Dialogue: 0,0:15:39.97,0:15:42.98,Default,,0000,0000,0000,,Какарот пен Гоку да солай.
Dialogue: 0,0:15:42.98,0:15:46.98,Default,,0000,0000,0000,,Екі есім бар ма?
Dialogue: 0,0:15:42.98,0:15:46.98,Default,,0000,0000,0000,,Маған бәрібір.
Dialogue: 0,0:15:46.98,0:15:49.95,Default,,0000,0000,0000,,Сіз бірдеңе айтып тұрған сияқтысыз.
Dialogue: 0,0:15:53.99,0:15:57.99,Default,,0000,0000,0000,,Есікті ашыңыз.
Dialogue: 0,0:15:57.99,0:15:59.99,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:15:59.99,0:16:03.00,Default,,0000,0000,0000,,Биік ұшыңыз!
Dialogue: 0,0:15:59.99,0:16:03.00,Default,,0000,0000,0000,,Сізге құбыжық шабуыл жасайды!
Dialogue: 0,0:16:03.00,0:16:06.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:06.00,0:16:10.00,Default,,0000,0000,0000,,Құбыжық?
Dialogue: 0,0:16:06.00,0:16:10.00,Default,,0000,0000,0000,,Ах. Мен теңіздемін.
Dialogue: 0,0:16:10.00,0:16:12.97,Default,,0000,0000,0000,,Не, құбыжық сияқты?
Dialogue: 0,0:16:10.00,0:16:12.97,Default,,0000,0000,0000,,Мен қорқамын.
Dialogue: 0,0:16:15.01,0:16:17.01,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:16:17.01,0:16:21.98,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:16:17.01,0:16:21.98,Default,,0000,0000,0000,,Ге~ссо~!
Dialogue: 0,0:16:27.02,0:16:30.02,Default,,0000,0000,0000,,Ууууууу...!
Dialogue: 0,0:16:30.02,0:16:31.96,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:16:30.02,0:16:31.96,Default,,0000,0000,0000,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:16:31.96,0:16:35.96,Default,,0000,0000,0000,,Ооооо...!
Dialogue: 0,0:16:35.96,0:16:40.97,Default,,0000,0000,0000,,А... бұл үлкен...
Dialogue: 0,0:16:35.96,0:16:40.97,Default,,0000,0000,0000,,Не? Бұл жынды емес пе?
Dialogue: 0,0:16:40.97,0:16:43.97,Default,,0000,0000,0000,,Бүгінгі жігіттер
Dialogue: 0,0:16:40.97,0:16:43.97,Default,,0000,0000,0000,,Менің ойымша, бұл мүмкін емес.
Dialogue: 0,0:16:43.97,0:16:45.97,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:45.97,0:16:48.97,Default,,0000,0000,0000,,Сәлем, Хибис!
Dialogue: 0,0:16:45.97,0:16:48.97,Default,,0000,0000,0000,,Сіз жеткілікті назар аудармайсыз!
Dialogue: 0,0:16:48.97,0:16:53.98,Default,,0000,0000,0000,,Хун. Мен екінші жын әлеміндемін
Dialogue: 0,0:16:48.97,0:16:53.98,Default,,0000,0000,0000,,Мен мұнда бірінші рет келіп тұрмын. кім біледі.
Dialogue: 0,0:16:53.98,0:16:56.98,Default,,0000,0000,0000,,-де біз құбыжықтар туралы айту үшін барымызды саламыз.
Dialogue: 0,0:16:53.98,0:16:56.98,Default,,0000,0000,0000,,Сен маған айту үшін келдің бе?
Dialogue: 0,0:16:56.98,0:17:01.99,Default,,0000,0000,0000,,Жоқ, біздің ұшақ
Dialogue: 0,0:16:56.98,0:17:01.99,Default,,0000,0000,0000,,Әлгі жігіт мені ұрды➡
Dialogue: 0,0:17:01.99,0:17:03.99,Default,,0000,0000,0000,,Барлығы күтіп тұр.
Dialogue: 0,0:17:01.99,0:17:03.99,Default,,0000,0000,0000,,Менімен бірге мінгеніңді қалаймын.
Dialogue: 0,0:17:03.99,0:17:06.99,Default,,0000,0000,0000,,Цк. Бұл менің ыңғайлылығым үшін бе?
Dialogue: 0,0:17:06.99,0:17:16.97,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:17:19.00,0:17:23.98,Default,,0000,0000,0000,,Аха.
Dialogue: 0,0:17:19.00,0:17:23.98,Default,,0000,0000,0000,,Мен осындамын. Кешіріңіз.
Dialogue: 0,0:17:27.01,0:17:30.02,Default,,0000,0000,0000,,Кешіріңіз. Мен жеңе алмадым.
Dialogue: 0,0:17:30.02,0:17:31.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:37.96,0:17:39.96,Default,,0000,0000,0000,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,0:17:39.96,0:17:43.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:39.96,0:17:43.96,Default,,0000,0000,0000,,Мұнда ешкім жоқ.
Dialogue: 0,0:17:43.96,0:17:48.97,Default,,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,0:17:43.96,0:17:48.97,Default,,0000,0000,0000,,Мен шу болды деп ойладым...
Dialogue: 0,0:17:48.97,0:17:50.97,Default,,0000,0000,0000,,Менің көңілім қалды.
Dialogue: 0,0:17:48.97,0:17:50.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:50.97,0:17:52.97,Default,,0000,0000,0000,,Сіз жұмыстан босатылдыңыз. Жұмыстан шығарылды.
Dialogue: 0,0:17:52.97,0:17:56.98,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:17:52.97,0:17:56.98,Default,,0000,0000,0000,,Ол өте күшті➡
Dialogue: 0,0:17:56.98,0:17:59.98,Default,,0000,0000,0000,,Мен де өте күштімін! ➡
Dialogue: 0,0:17:59.98,0:18:02.65,Default,,0000,0000,0000,,Тіпті әндері де жақсы.
Dialogue: 0,0:17:59.98,0:18:02.65,Default,,0000,0000,0000,,Өйткені жылдамдық жылдам➡
Dialogue: 0,0:18:02.65,0:18:04.98,Default,,0000,0000,0000,,Егер мен саған тапсырма берсем
Dialogue: 0,0:18:02.65,0:18:04.98,Default,,0000,0000,0000,,Бұл пайдалы болады.
Dialogue: 0,0:18:04.98,0:18:06.95,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:18:15.99,0:18:20.00,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Пикколо.
Dialogue: 0,0:18:15.99,0:18:20.00,Default,,0000,0000,0000,,Ностальгиялық, солай ма?
Dialogue: 0,0:18:20.00,0:18:23.00,Default,,0000,0000,0000,,Мен де Бұлмаға айттым.
Dialogue: 0,0:18:20.00,0:18:23.00,Default,,0000,0000,0000,,Мен дүниеге келдім➡
Dialogue: 0,0:18:23.00,0:18:27.01,Default,,0000,0000,0000,,Ата-аналар
Dialogue: 0,0:18:23.00,0:18:27.01,Default,,0000,0000,0000,,Біз бұл жерден шыққан соң. ➡
Dialogue: 0,0:18:27.01,0:18:30.01,Default,,0000,0000,0000,,Бірақ әрине➡
Dialogue: 0,0:18:30.01,0:18:34.95,Default,,0000,0000,0000,,Қандай да бір сағыныш сезімін тудырады.
Dialogue: 0,0:18:30.01,0:18:34.95,Default,,0000,0000,0000,,Керемет жер екен.
Dialogue: 0,0:18:34.95,0:18:37.95,Default,,0000,0000,0000,,Бұл жерден кім кетіп бара жатыр?
Dialogue: 0,0:18:34.95,0:18:37.95,Default,,0000,0000,0000,,Бұл қиын болған болуы керек. ➡
Dialogue: 0,0:18:37.95,0:18:41.95,Default,,0000,0000,0000,,Сол кезден бастап ұлы жын патшалар
Dialogue: 0,0:18:37.95,0:18:41.95,Default,,0000,0000,0000,,Қалағаныңды істе...
Dialogue: 0,0:18:41.95,0:18:46.96,Default,,0000,0000,0000,,Әсіресе әртүрлі қабілеттермен
Dialogue: 0,0:18:41.95,0:18:46.96,Default,,0000,0000,0000,,Намекилер бағаланады➡
Dialogue: 0,0:18:46.96,0:18:50.96,Default,,0000,0000,0000,,Құл болғандай болды.
Dialogue: 0,0:18:50.96,0:18:52.97,Default,,0000,0000,0000,,Бұл туралы айтатын болсақ➡
Dialogue: 0,0:18:52.97,0:18:55.97,Default,,0000,0000,0000,,Нахале тұратын жер
Dialogue: 0,0:18:52.97,0:18:55.97,Default,,0000,0000,0000,,Бұл екінші жын әлемі, солай ма?
Dialogue: 0,0:18:55.97,0:18:58.97,Default,,0000,0000,0000,,Иә. Бұл жерден алыс болса да.
Dialogue: 0,0:18:58.97,0:19:02.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:58.97,0:19:02.98,Default,,0000,0000,0000,,Не? Сол Нахале.
Dialogue: 0,0:19:02.98,0:19:07.98,Default,,0000,0000,0000,,Кай патшаның шын есімі
Dialogue: 0,0:19:02.98,0:19:07.98,Default,,0000,0000,0000,,Оны Нахале деп атаса керек.
Dialogue: 0,0:19:07.98,0:19:10.98,Default,,0000,0000,0000,,Сәлем. Тіпті оның шын есімі де болған.
Dialogue: 0,0:19:10.98,0:19:12.65,Default,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:19:12.65,0:19:16.99,Default,,0000,0000,0000,,-да Кай патша
Dialogue: 0,0:19:12.65,0:19:16.99,Default,,0000,0000,0000,,Бұл жын әлемінен құтылу тобы болды, солай ма?
Dialogue: 0,0:19:16.99,0:19:18.99,Default,,0000,0000,0000,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:19:18.99,0:19:21.99,Default,,0000,0000,0000,,Бұл ұзақ әңгіме.
Dialogue: 0,0:19:18.99,0:19:21.99,Default,,0000,0000,0000,,♪ Вуф-вуф, вуф-вуф
Dialogue: 0,0:19:21.99,0:19:25.00,Default,,0000,0000,0000,,Онда сұраудың қажеті жоқ.
Dialogue: 0,0:19:25.00,0:19:28.00,Default,,0000,0000,0000,,Бұл жақсы. Маған тыңдауға рұқсат етіңіз.
Dialogue: 0,0:19:28.00,0:19:30.94,Default,,0000,0000,0000,,Қысқаша сөйлесейік.
Dialogue: 0,0:19:30.94,0:19:33.94,Default,,0000,0000,0000,,Баяғыда
Dialogue: 0,0:19:30.94,0:19:33.94,Default,,0000,0000,0000,,Сол дәуірдің жақсы жын патшасы➡ болды
Dialogue: 0,0:19:33.94,0:19:35.94,Default,,0000,0000,0000,,Жындар әлемін кеңейтуге тырысу➡
Dialogue: 0,0:19:35.94,0:19:39.95,Default,,0000,0000,0000,,Оның «Рим» атты таңғажайып қабілеті бар.
Dialogue: 0,0:19:35.94,0:19:39.95,Default,,0000,0000,0000,,Аса шайтанға бұйрық беріңіз➡
Dialogue: 0,0:19:39.95,0:19:41.95,Default,,0000,0000,0000,,Әлемнің жаратылуына себепші болды.
Dialogue: 0,0:19:41.95,0:19:43.95,Default,,0000,0000,0000,,Раймс?
Dialogue: 0,0:19:43.95,0:19:46.95,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:19:43.95,0:19:46.95,Default,,0000,0000,0000,,Ол әлі де ғаламдағы ең ұлы адам.
Dialogue: 0,0:19:46.95,0:19:49.96,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:19:49.96,0:19:53.96,Default,,0000,0000,0000,,Көптеген ғаламдарды жасаңыз
Dialogue: 0,0:19:49.96,0:19:53.96,Default,,0000,0000,0000,,Жындар әлеміндегі көптеген шайтандар➡
Dialogue: 0,0:19:53.96,0:19:56.96,Default,,0000,0000,0000,,Біз сол ғаламға көшуді бастадық. ➡
Dialogue: 0,0:19:56.96,0:19:58.96,Default,,0000,0000,0000,,Сонымен, Раймс мырза➡
Dialogue: 0,0:19:58.96,0:20:01.97,Default,,0000,0000,0000,,Біздің арамыздан гриндиялықтар
Dialogue: 0,0:19:58.96,0:20:01.97,Default,,0000,0000,0000,,Кейбір адамдарды таңдаңыз➡
Dialogue: 0,0:20:01.97,0:20:06.97,Default,,0000,0000,0000,,Ғаламның бақылаушысы ретінде, әр ғаламда
Dialogue: 0,0:20:01.97,0:20:06.97,Default,,0000,0000,0000,,Ол Жоғарғы Кай ретінде жіберілді.
Dialogue: 0,0:20:06.97,0:20:08.97,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:20:08.97,0:20:12.98,Default,,0000,0000,0000,,Сонымен, ғарыштағы адамдар ше?
Dialogue: 0,0:20:08.97,0:20:12.98,Default,,0000,0000,0000,,Бұл олардың барлығы жындардың ұрпақтары дегенді білдіре ме?
Dialogue: 0,0:20:12.98,0:20:14.98,Default,,0000,0000,0000,,Барлығы емес.
Dialogue: 0,0:20:14.98,0:20:17.98,Default,,0000,0000,0000,,(Балалардың шуы)
Dialogue: 0,0:20:14.98,0:20:17.98,Default,,0000,0000,0000,,Жердегілер мен Сайандар➡
Dialogue: 0,0:20:17.98,0:20:20.99,Default,,0000,0000,0000,,Әлем дүниеге келгеннен кейін
Dialogue: 0,0:20:17.98,0:20:20.99,Default,,0000,0000,0000,,Табиғатта пайда болған адам.
Dialogue: 0,0:20:20.99,0:20:22.99,Default,,0000,0000,0000,,Сонымен?
Dialogue: 0,0:20:22.99,0:20:25.99,Default,,0000,0000,0000,,Сонымен, біз гриндиялықтар
Dialogue: 0,0:20:22.99,0:20:25.99,Default,,0000,0000,0000,,Көп ата-бабам➡
Dialogue: 0,0:20:25.99,0:20:30.00,Default,,0000,0000,0000,,Раймс мырзаның жанындағы жұлдызға
Dialogue: 0,0:20:25.99,0:20:30.00,Default,,0000,0000,0000,,Мен эмиграцияға кеттім. ➡
Dialogue: 0,0:20:30.00,0:20:32.93,Default,,0000,0000,0000,,Шамамен сол уақытта Warp-sama➡ арқылы
Dialogue: 0,0:20:32.93,0:20:35.93,Default,,0000,0000,0000,,Әр адам жын әлемін және ғаламды еркін зерттейді
Dialogue: 0,0:20:32.93,0:20:35.93,Default,,0000,0000,0000,,Мен алды-артқа кетіп бара жаттым➡
Dialogue: 0,0:20:35.93,0:20:37.94,Default,,0000,0000,0000,,Алдыңғы Ұлы жын патша Абра болды➡
Dialogue: 0,0:20:37.94,0:20:41.94,Default,,0000,0000,0000,,Бүгінгі күні пайда бола бастаған шетелдіктер
Dialogue: 0,0:20:37.94,0:20:41.94,Default,,0000,0000,0000,,Сергек болыңыз➡
Dialogue: 0,0:20:41.94,0:20:44.94,Default,,0000,0000,0000,,Warp-sama қолдану
Dialogue: 0,0:20:41.94,0:20:44.94,Default,,0000,0000,0000,,Мен оны шектедім.
Dialogue: 0,0:20:44.94,0:20:47.95,Default,,0000,0000,0000,,Сіз әлі де жындар әлемінде болдыңыз ба?
Dialogue: 0,0:20:47.95,0:20:51.95,Default,,0000,0000,0000,,Иә. Бірақ Ұлы жын патша Абра
Dialogue: 0,0:20:47.95,0:20:51.95,Default,,0000,0000,0000,,Қорқынышты әдістерге қарсы шығу➡
Dialogue: 0,0:20:51.95,0:20:56.96,Default,,0000,0000,0000,,Қалған гриндиандықтардың көпшілігі
Dialogue: 0,0:20:51.95,0:20:56.96,Default,,0000,0000,0000,,Ғарышқа ұшып кетті.
Dialogue: 0,0:20:56.96,0:20:59.96,Default,,0000,0000,0000,,Кімді Кайошин таңдады
Dialogue: 0,0:20:56.96,0:20:59.96,Default,,0000,0000,0000,,Осыдан кейін.
Dialogue: 0,0:20:59.96,0:21:01.96,Default,,0000,0000,0000,,Соңғы кездері түн-түні оқып жүргендіктен.
Dialogue: 0,0:21:01.96,0:21:04.96,Default,,0000,0000,0000,,Кайошин-самалар дегеніміз не?
Dialogue: 0,0:21:01.96,0:21:04.96,Default,,0000,0000,0000,,Олар ағаштан туады.
Dialogue: 0,0:21:04.96,0:21:07.97,Default,,0000,0000,0000,,Иә! ? Шынымен бе? сол.
Dialogue: 0,0:21:07.97,0:21:09.97,Default,,0000,0000,0000,,Біз Гриндиялықтар➡
Dialogue: 0,0:21:09.97,0:21:12.97,Default,,0000,0000,0000,,Бес ұлы ағаштан
Dialogue: 0,0:21:09.97,0:21:12.97,Default,,0000,0000,0000,,Мен тудым➡
Dialogue: 0,0:21:12.97,0:21:15.97,Default,,0000,0000,0000,,Сол ағаштардың бәрі де қурап қалды➡
Dialogue: 0,0:21:15.97,0:21:18.98,Default,,0000,0000,0000,,Жындар әлемінде қалу себебі
Dialogue: 0,0:21:15.97,0:21:18.98,Default,,0000,0000,0000,,Не жоғалып кетті➡
Dialogue: 0,0:21:18.98,0:21:21.98,Default,,0000,0000,0000,,Ғарышқа көшу мүмкіндігі
Dialogue: 0,0:21:18.98,0:21:21.98,Default,,0000,0000,0000,,Бұл айналды.
Dialogue: 0,0:21:21.98,0:21:24.98,Default,,0000,0000,0000,,Олай болса сендер Гриндиялықтар➡
Dialogue: 0,0:21:24.98,0:21:27.99,Default,,0000,0000,0000,,Соңында
Dialogue: 0,0:21:24.98,0:21:27.99,Default,,0000,0000,0000,,Бұл біздің жойылудан басқа амалымыз жоқ дегенді білдіре ме?
Dialogue: 0,0:21:27.99,0:21:29.99,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:21:29.99,0:21:33.93,Default,,0000,0000,0000,,Бұл таңқаларлық. Сіз гриндиансыз ба?
Dialogue: 0,0:21:33.93,0:21:38.93,Default,,0000,0000,0000,,Сіз ақылды сияқтысыз.
Dialogue: 0,0:21:33.93,0:21:38.93,Default,,0000,0000,0000,,Ол сарайда Дегет пен Аринспен бірге.
Dialogue: 0,0:21:38.93,0:21:41.93,Default,,0000,0000,0000,,Олардың екеуі
Dialogue: 0,0:21:38.93,0:21:41.93,Default,,0000,0000,0000,,Нахалемен бауырлас сияқты.
Dialogue: 0,0:21:41.93,0:21:45.94,Default,,0000,0000,0000,,Шынымен бе? Жарайды онда
Dialogue: 0,0:21:41.93,0:21:45.94,Default,,0000,0000,0000,,Меніңше, олар тәттілер үшін төбелесті.
Dialogue: 0,0:21:45.94,0:21:47.94,Default,,0000,0000,0000,,Жоқ, бұл...
Dialogue: 0,0:21:47.94,0:21:52.94,Default,,0000,0000,0000,,Бірақ бұл екеуі
Dialogue: 0,0:21:47.94,0:21:52.94,Default,,0000,0000,0000,,Ол гриндиан болса да, жиіркенішті көрінеді.
Dialogue: 0,0:21:52.94,0:21:54.95,Default,,0000,0000,0000,,Иә, жақсы….
Dialogue: 0,0:21:54.95,0:21:58.95,Default,,0000,0000,0000,,Кай патша, ол дүниеге келген планета
Dialogue: 0,0:21:54.95,0:21:58.95,Default,,0000,0000,0000,,Мен оны көруге баруым керек пе?
Dialogue: 0,0:21:58.95,0:22:01.95,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:21:58.95,0:22:01.95,Default,,0000,0000,0000,,Ештеңе қалмады.
Dialogue: 0,0:22:01.95,0:22:04.96,Default,,0000,0000,0000,,Тезірек барайық.
Dialogue: 0,0:22:01.95,0:22:04.96,Default,,0000,0000,0000,,Осы шу-шудың бәрімен—
Dialogue: 0,0:22:04.96,0:22:07.96,Default,,0000,0000,0000,,Тез
Dialogue: 0,0:22:04.96,0:22:07.96,Default,,0000,0000,0000,,Келесі Тамагамиге барайық.
Dialogue: 0,0:22:07.96,0:22:10.93,Default,,0000,0000,0000,,Айдаһар добы
Dialogue: 0,0:22:07.96,0:22:10.93,Default,,0000,0000,0000,,Сіз оны аласыз!
Dialogue: 0,0:22:14.97,0:22:18.97,Default,,0000,0000,0000,,Не? Бұл өте кішкентай.
Dialogue: 0,0:22:14.97,0:22:18.97,Default,,0000,0000,0000,,Сіз солай айтасыз ба?
Dialogue: 0,0:22:18.97,0:22:22.97,Default,,0000,0000,0000,,Сіздің атыңыз кім?
Dialogue: 0,0:22:18.97,0:22:22.97,Default,,0000,0000,0000,,Глорио.
Dialogue: 0,0:22:22.97,0:22:25.98,Default,,0000,0000,0000,,Енді Глориоға.
Dialogue: 0,0:22:22.97,0:22:25.98,Default,,0000,0000,0000,,Оны пилоттық түрде қолдансаңыз жақсы болар еді.
Dialogue: 0,0:22:25.98,0:22:29.98,Default,,0000,0000,0000,,Бұл мен туралы.
Dialogue: 0,0:22:25.98,0:22:29.98,Default,,0000,0000,0000,,Сіз ренжідіңіз бе?
Dialogue: 0,0:22:29.98,0:22:32.92,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:22:29.98,0:22:32.92,Default,,0000,0000,0000,,Мұнда бірінші рет келіп тұрсыз.
Dialogue: 0,0:22:32.92,0:22:34.89,Default,,0000,0000,0000,,Олай болса мен мұны саған жасаймын.
Dialogue: 0,0:22:46.93,0:22:49.94,Default,,0000,0000,0000,,Хи хи. Хе хе...
Dialogue: 0,0:22:49.94,0:22:59.91,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:23:01.41,0:23:07.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory