Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.04,0:00:09.04,Default,,0000,0000,0000,,[Айдаһар шары дегеніміз не?
Dialogue: 0,0:00:03.04,0:00:09.04,Default,,0000,0000,0000,,7 бөлікті жинап, құпия сөзді айт➡
Dialogue: 0,0:00:09.04,0:00:17.05,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:00:09.04,0:00:17.05,Default,,0000,0000,0000,,Айдаһар
Dialogue: 0,0:00:09.04,0:00:17.05,Default,,0000,0000,0000,,Шенрон деген айдаһар шығады дейді.
Dialogue: 0,0:00:09.04,0:00:17.05,Default,,0000,0000,0000,,Бұл жұмбақ доп]
Dialogue: 0,0:00:17.05,0:00:23.06,Default,,0000,0000,0000,,Шенрон
Dialogue: 0,0:00:17.05,0:00:23.06,Default,,0000,0000,0000,,[Егер сіз Шенроннан қандай да бір тілек сұрасаңыз,
Dialogue: 0,0:00:17.05,0:00:23.06,Default,,0000,0000,0000,,Бұл орындалады]
Dialogue: 0,0:00:23.06,0:00:26.06,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:00:23.06,0:00:26.06,Default,,0000,0000,0000,,Гоку
Dialogue: 0,0:00:23.06,0:00:26.06,Default,,0000,0000,0000,,[Бұл Сон Гоку деген адам➡
Dialogue: 0,0:00:26.06,0:00:30.06,Default,,0000,0000,0000,,Сабырлы болып көрінсе де
Dialogue: 0,0:00:26.06,0:00:30.06,Default,,0000,0000,0000,,Ерекше күшке ие➡
Dialogue: 0,0:00:30.06,0:00:34.07,Default,,0000,0000,0000,,Ол ең күшті жауынгер]
Dialogue: 0,0:00:34.07,0:00:37.07,Default,,0000,0000,0000,,[Таудың тереңінде тұратын бала кезімде➡
Dialogue: 0,0:00:37.07,0:00:40.07,Default,,0000,0000,0000,,Айдаһар допты іздеу
Dialogue: 0,0:00:37.07,0:00:40.07,Default,,0000,0000,0000,,Достармен танысу➡
Dialogue: 0,0:00:40.07,0:00:46.08,Default,,0000,0000,0000,,Бірге шытырман оқиға
Dialogue: 0,0:00:40.07,0:00:46.08,Default,,0000,0000,0000,,Ересек болып өсу]
Dialogue: 0,0:00:46.08,0:00:52.09,Default,,0000,0000,0000,,[Ертеде бір адам ғарыштан келген.
Dialogue: 0,0:00:46.08,0:00:52.09,Default,,0000,0000,0000,,Қатыгез жауынгер Сайяндар нәсілімен➡
Dialogue: 0,0:00:52.09,0:00:56.09,Default,,0000,0000,0000,,Шындығында, Гокудың шынайы тұлғасы да Сайян➡
Dialogue: 0,0:00:56.09,0:01:01.06,Default,,0000,0000,0000,,Бала кезіндегі жер бетінде
Dialogue: 0,0:00:56.09,0:01:01.06,Default,,0000,0000,0000,,Мен ұшқанымды білдім]
Dialogue: 0,0:01:03.03,0:01:07.03,Default,,0000,0000,0000,,[Менің өмірімнің көп бөлігі
Dialogue: 0,0:01:03.03,0:01:07.03,Default,,0000,0000,0000,,Жас болыңыз➡
Dialogue: 0,0:01:07.03,0:01:10.04,Default,,0000,0000,0000,,Сайян сипаттамалары бар➡
Dialogue: 0,0:01:10.04,0:01:15.04,Default,,0000,0000,0000,,Қазірдің өзінде көптеген қорқынышты жаулары бар,
Dialogue: 0,0:01:10.04,0:01:15.04,Default,,0000,0000,0000,,Соғыс кезінде өсу➡
Dialogue: 0,0:01:15.04,0:01:18.04,Default,,0000,0000,0000,,Бұрынғы қарсыластарымен➡
Dialogue: 0,0:01:18.04,0:01:24.02,Default,,0000,0000,0000,,Бүгін де зұлымдық қолынан
Dialogue: 0,0:01:18.04,0:01:24.02,Default,,0000,0000,0000,,Жерді қорғауды жалғастыру]
Dialogue: 0,0:01:27.05,0:01:37.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:03:09.06,0:03:11.06,Default,,0000,0000,0000,,Hmph.
Dialogue: 0,0:03:11.06,0:03:13.06,Default,,0000,0000,0000,,Біз бәріміз бірге отырып, бір шыныаяқ ішкен күн де болар еді.
Dialogue: 0,0:03:11.06,0:03:13.06,Default,,0000,0000,0000,,Хааах!
Dialogue: 0,0:03:13.06,0:03:15.06,Default,,0000,0000,0000,,Даарааааааааа!
Dialogue: 0,0:03:15.06,0:03:17.03,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:03:40.02,0:03:42.02,Default,,0000,0000,0000,,(Кондуктор) Сен, сол жерде тұр! Ей! Қауіпті!
Dialogue: 0,0:03:42.02,0:03:44.02,Default,,0000,0000,0000,,Алдымен Дендеге көмектесуім керек пе➡
Dialogue: 0,0:03:44.02,0:03:48.03,Default,,0000,0000,0000,,Немесе Тамагамимен жарысыңыз
Dialogue: 0,0:03:44.02,0:03:48.03,Default,,0000,0000,0000,,Соңғы Айдаһар допты аласыз ба?
Dialogue: 0,0:03:48.03,0:03:50.03,Default,,0000,0000,0000,,Денде бірінші келеді.
Dialogue: 0,0:03:50.03,0:03:54.00,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:03:50.03,0:03:54.00,Default,,0000,0000,0000,,Дендеге көмектесейік!
Dialogue: 0,0:04:17.06,0:04:24.06,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:04:24.06,0:04:31.00,Default,,0000,0000,0000,,(Денденің айқайы)
Dialogue: 0,0:04:31.00,0:04:33.97,Default,,0000,0000,0000,,Уау... Қарғыс атсын...
Dialogue: 0,0:04:39.01,0:04:42.02,Default,,0000,0000,0000,,Кайошин
Dialogue: 0,0:04:39.01,0:04:42.02,Default,,0000,0000,0000,,Қақпа жабық.
Dialogue: 0,0:04:42.02,0:04:44.02,Default,,0000,0000,0000,,Оны ашуым керек пе?
Dialogue: 0,0:04:44.02,0:04:47.02,Default,,0000,0000,0000,,Ой!
Dialogue: 0,0:04:44.02,0:04:47.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:47.02,0:04:48.99,Default,,0000,0000,0000,,⚟Ой!
Dialogue: 0,0:04:55.03,0:04:59.03,Default,,0000,0000,0000,,Тым-ау! Алақай!
Dialogue: 0,0:04:59.03,0:05:01.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:01.03,0:05:04.04,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:05:04.04,0:05:08.01,Default,,0000,0000,0000,,Токусен
Dialogue: 0,0:05:04.04,0:05:08.01,Default,,0000,0000,0000,,Арнайы жасақ капитаны Кадем!
Dialogue: 0,0:05:12.05,0:05:15.01,Default,,0000,0000,0000,,Екінші нөмір
Dialogue: 0,0:05:12.05,0:05:15.01,Default,,0000,0000,0000,,№2 арнайы жасақ Данима!
Dialogue: 0,0:05:17.05,0:05:22.02,Default,,0000,0000,0000,,Екі соққы!
Dialogue: 0,0:05:17.05,0:05:22.02,Default,,0000,0000,0000,,Үшінші нөмір
Dialogue: 0,0:05:17.05,0:05:22.02,Default,,0000,0000,0000,,№3 арнайы жасақ Хилия!
Dialogue: 0,0:05:26.06,0:05:30.03,Default,,0000,0000,0000,,Төрт саны
Dialogue: 0,0:05:26.06,0:05:30.03,Default,,0000,0000,0000,,№4 арнайы жасақ Масим!
Dialogue: 0,0:05:33.00,0:05:36.97,Default,,0000,0000,0000,,Бес саны
Dialogue: 0,0:05:33.00,0:05:36.97,Default,,0000,0000,0000,,№5 арнайы жасақ Гаймой!
Dialogue: 0,0:05:40.01,0:05:45.01,Default,,0000,0000,0000,,Кенпей тоқусен
Dialogue: 0,0:05:40.01,0:05:45.01,Default,,0000,0000,0000,,Бесеуіміз де әскери полицияның арнайы жасағымыз!
Dialogue: 0,0:05:45.01,0:05:47.98,Default,,0000,0000,0000,,Ах, мммммм….
Dialogue: 0,0:05:50.02,0:05:53.02,Default,,0000,0000,0000,,Иә? Аа….
Dialogue: 0,0:05:53.02,0:05:55.02,Default,,0000,0000,0000,,Қарғыс атқыр бала!
Dialogue: 0,0:05:55.02,0:05:57.02,Default,,0000,0000,0000,,Осыдан кейін
Dialogue: 0,0:05:55.02,0:05:57.02,Default,,0000,0000,0000,,Біз, әскери полицияның арнайы жасағы,➡
Dialogue: 0,0:05:57.02,0:06:00.99,Default,,0000,0000,0000,,Мен сені бір қадам да өткізбеймін!
Dialogue: 0,0:05:57.02,0:06:00.99,Default,,0000,0000,0000,,Оу!
Dialogue: 0,0:06:03.03,0:06:07.03,Default,,0000,0000,0000,,Ик! (Адамдар айқайлап жатыр)
Dialogue: 0,0:06:03.03,0:06:07.03,Default,,0000,0000,0000,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:06:07.03,0:06:09.04,Default,,0000,0000,0000,,Сіз біз туралы білмейсіз...
Dialogue: 0,0:06:09.04,0:06:14.04,Default,,0000,0000,0000,,Хмф, өлмей тұрып айтамын.
Dialogue: 0,0:06:09.04,0:06:14.04,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:06:14.04,0:06:17.04,Default,,0000,0000,0000,,Қажет емес!
Dialogue: 0,0:06:14.04,0:06:17.04,Default,,0000,0000,0000,,Не... не?! ?
Dialogue: 0,0:06:17.04,0:06:19.05,Default,,0000,0000,0000,,Вегета.
Dialogue: 0,0:06:17.04,0:06:19.05,Default,,0000,0000,0000,,Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:06:19.05,0:06:21.01,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:06:25.05,0:06:29.06,Default,,0000,0000,0000,,О? Солай ма? ➡
Dialogue: 0,0:06:29.06,0:06:31.99,Default,,0000,0000,0000,,Ихе хи хи....
Dialogue: 0,0:06:31.99,0:06:34.99,Default,,0000,0000,0000,,Қайдан бастарын білмеймін.
Dialogue: 0,0:06:31.99,0:06:34.99,Default,,0000,0000,0000,,Мен сені жалап жатырмын, брат!
Dialogue: 0,0:06:34.99,0:06:39.00,Default,,0000,0000,0000,,Сіз мұны істей аласыз.
Dialogue: 0,0:06:34.99,0:06:39.00,Default,,0000,0000,0000,,Хи хи.
Dialogue: 0,0:06:39.00,0:06:46.01,Default,,0000,0000,0000,,Хи хи хи....
Dialogue: 0,0:06:46.01,0:06:49.01,Default,,0000,0000,0000,,Hee... Uryaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!
Dialogue: 0,0:06:49.01,0:06:51.01,Default,,0000,0000,0000,,Иә? Хмм….
Dialogue: 0,0:06:51.01,0:06:52.98,Default,,0000,0000,0000,,Екі соққы.
Dialogue: 0,0:06:57.02,0:06:59.02,Default,,0000,0000,0000,,(Шинобу) Мұнда кездейсоқ біреуді білетін адам бар ма?
Dialogue: 0,0:06:59.02,0:07:02.02,Default,,0000,0000,0000,,Сәлем! ? ➡
Dialogue: 0,0:07:02.02,0:07:06.03,Default,,0000,0000,0000,,Гяаа!
Dialogue: 0,0:07:02.02,0:07:06.03,Default,,0000,0000,0000,,Гаки!
Dialogue: 0,0:07:06.03,0:07:10.00,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:07:12.03,0:07:14.03,Default,,0000,0000,0000,,Аму.
Dialogue: 0,0:07:12.03,0:07:14.03,Default,,0000,0000,0000,,Хехехе….
Dialogue: 0,0:07:14.03,0:07:16.00,Default,,0000,0000,0000,,Хехе... Хмф.
Dialogue: 0,0:07:19.04,0:07:21.04,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:21.04,0:07:23.04,Default,,0000,0000,0000,,Ах!?
Dialogue: 0,0:07:21.04,0:07:23.04,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:07:23.04,0:07:25.01,Default,,0000,0000,0000,,А... О, жоқ...
Dialogue: 0,0:07:34.99,0:07:36.99,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:07:36.99,0:07:39.96,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:36.99,0:07:39.96,Default,,0000,0000,0000,,Ах... а... а...
Dialogue: 0,0:07:41.99,0:07:46.00,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:07:41.99,0:07:46.00,Default,,0000,0000,0000,,Боқ...
Dialogue: 0,0:07:46.00,0:07:49.00,Default,,0000,0000,0000,,Жарайды... болмайды, капитан...
Dialogue: 0,0:07:46.00,0:07:49.00,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:07:49.00,0:07:52.00,Default,,0000,0000,0000,,Сиқыр
Dialogue: 0,0:07:49.00,0:07:52.00,Default,,0000,0000,0000,,Бұл жігіттер Маджин Буу.
Dialogue: 0,0:07:49.00,0:07:52.00,Default,,0000,0000,0000,,Тамагамиді жеңу дегенді қалай түсінесіңдер?
Dialogue: 0,0:07:52.00,0:07:54.01,Default,,0000,0000,0000,,Бұл рас болды...
Dialogue: 0,0:07:54.01,0:07:57.01,Default,,0000,0000,0000,,Ммм... Ммм...
Dialogue: 0,0:07:57.01,0:08:01.01,Default,,0000,0000,0000,,Ақыры менің кезегім келді!
Dialogue: 0,0:07:57.01,0:08:01.01,Default,,0000,0000,0000,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:08:01.01,0:08:03.98,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:09.02,0:08:11.02,Default,,0000,0000,0000,,Таа! Тааа!
Dialogue: 0,0:08:09.02,0:08:11.02,Default,,0000,0000,0000,,Ааа!
Dialogue: 0,0:08:11.02,0:08:13.03,Default,,0000,0000,0000,,Тааааа!
Dialogue: 0,0:08:13.03,0:08:14.99,Default,,0000,0000,0000,,Бағана. ➡
Dialogue: 0,0:08:17.03,0:08:22.03,Default,,0000,0000,0000,,Боқ... егер бұл орын алса
Dialogue: 0,0:08:17.03,0:08:22.03,Default,,0000,0000,0000,,Мен саған сол техниканы көрсетемін!
Dialogue: 0,0:08:22.03,0:08:25.04,Default,,0000,0000,0000,,Қайдан бастарын білмеймін.
Dialogue: 0,0:08:22.03,0:08:25.04,Default,,0000,0000,0000,,Мен күттім!
Dialogue: 0,0:08:25.04,0:08:27.04,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:08:27.04,0:08:32.01,Default,,0000,0000,0000,,Уууоооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо
Dialogue: 0,0:08:34.05,0:08:36.05,Default,,0000,0000,0000,,Сендер, үндемеңдер!➡
Dialogue: 0,0:08:36.05,0:08:38.05,Default,,0000,0000,0000,,Келесі жолы мен үлкенірекке барамын.
Dialogue: 0,0:08:38.05,0:08:40.05,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:38.05,0:08:40.05,Default,,0000,0000,0000,,Қайдан бастарын білмеймін.
Dialogue: 0,0:08:40.05,0:08:45.06,Default,,0000,0000,0000,,Қайдан бастарын білмеймін.
Dialogue: 0,0:08:40.05,0:08:45.06,Default,,0000,0000,0000,,Ахх...! ➡
Dialogue: 0,0:08:45.06,0:08:48.73,Default,,0000,0000,0000,,Яаааа!
Dialogue: 0,0:08:45.06,0:08:48.73,Default,,0000,0000,0000,,Өзіңізді дайындаңыз...
Dialogue: 0,0:08:48.73,0:08:51.00,Default,,0000,0000,0000,,Ах!?
Dialogue: 0,0:08:55.07,0:08:58.04,Default,,0000,0000,0000,,Қарғыс атсын! Ах! ?
Dialogue: 0,0:09:01.07,0:09:03.08,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:03.08,0:09:06.08,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:03.08,0:09:06.08,Default,,0000,0000,0000,,Hmph.
Dialogue: 0,0:09:06.08,0:09:10.08,Default,,0000,0000,0000,,Ачачачача...!
Dialogue: 0,0:09:10.08,0:09:12.08,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:09:12.08,0:09:14.09,Default,,0000,0000,0000,,Капитан! Жарайды?
Dialogue: 0,0:09:14.09,0:09:17.09,Default,,0000,0000,0000,,Әлі де аздап ауырады.
Dialogue: 0,0:09:17.09,0:09:20.09,Default,,0000,0000,0000,,Жарайды, оған көмектесу мүмкін емес.
Dialogue: 0,0:09:17.09,0:09:20.09,Default,,0000,0000,0000,,Мен сені осы жолы ғана кешіремін бе?
Dialogue: 0,0:09:20.09,0:09:22.06,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:09:29.10,0:09:31.04,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:09:31.04,0:09:35.04,Default,,0000,0000,0000,,Мен мына картоп чиптерін ұсынамын.
Dialogue: 0,0:09:31.04,0:09:35.04,Default,,0000,0000,0000,,Қаласаңыз, орындаңыз.
Dialogue: 0,0:09:35.04,0:09:38.01,Default,,0000,0000,0000,,Эй, рахмет.
Dialogue: 0,0:09:35.04,0:09:38.01,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:09:41.05,0:09:42.72,Default,,0000,0000,0000,,Не? Бұл мүсін.
Dialogue: 0,0:09:42.72,0:09:46.05,Default,,0000,0000,0000,,Бұл Гомер.
Dialogue: 0,0:09:46.05,0:09:49.06,Default,,0000,0000,0000,,Гомер….
Dialogue: 0,0:09:49.06,0:09:53.06,Default,,0000,0000,0000,,Хмм... қайсысы?
Dialogue: 0,0:09:53.06,0:09:56.06,Default,,0000,0000,0000,,Хаха...
Dialogue: 0,0:09:53.06,0:09:56.06,Default,,0000,0000,0000,,Арнайы жасақ жеңіліске ұшырады!
Dialogue: 0,0:09:56.06,0:09:59.07,Default,,0000,0000,0000,,Не...не?! ?
Dialogue: 0,0:09:56.06,0:09:59.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:59.07,0:10:03.07,Default,,0000,0000,0000,,Ах... Мм, кешіріңіз.
Dialogue: 0,0:10:03.07,0:10:08.07,Default,,0000,0000,0000,,Дегесу-сама нені сұрады
Dialogue: 0,0:10:03.07,0:10:08.07,Default,,0000,0000,0000,,Мен әкелдім...
Dialogue: 0,0:10:08.07,0:10:11.08,Default,,0000,0000,0000,,А... не! Хмф!
Dialogue: 0,0:10:11.08,0:10:16.08,Default,,0000,0000,0000,,Әй, бұл өте қиын!
Dialogue: 0,0:10:11.08,0:10:16.08,Default,,0000,0000,0000,,Жоқ, осындай нәрсе...
Dialogue: 0,0:10:16.08,0:10:18.08,Default,,0000,0000,0000,,Сәлем! ? ➡
Dialogue: 0,0:10:18.08,0:10:22.09,Default,,0000,0000,0000,,Жарайды...тез жеткізіңіз.
Dialogue: 0,0:10:18.08,0:10:22.09,Default,,0000,0000,0000,,Толық емес жұмыс күнін тауып, үйге қайт!
Dialogue: 0,0:10:22.09,0:10:25.09,Default,,0000,0000,0000,,Уау, тағы бір қабырға бар.
Dialogue: 0,0:10:25.09,0:10:28.09,Default,,0000,0000,0000,,Егер біз осындай үлкен топта көшетін болсақ,
Dialogue: 0,0:10:25.09,0:10:28.09,Default,,0000,0000,0000,,Тым байқалып тұрған жоқ па?
Dialogue: 0,0:10:28.09,0:10:31.03,Default,,0000,0000,0000,,Жарайды, біз келдік.
Dialogue: 0,0:10:28.09,0:10:31.03,Default,,0000,0000,0000,,Мен көмектесуге келе жатырмын.
Dialogue: 0,0:10:31.03,0:10:33.00,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:10:41.04,0:10:44.01,Default,,0000,0000,0000,,Абайлаңыз.
Dialogue: 0,0:10:52.05,0:11:05.03,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:11:08.07,0:11:11.07,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:11:11.07,0:11:13.04,Default,,0000,0000,0000,,Ах!?
Dialogue: 0,0:11:45.97,0:11:47.97,Default,,0000,0000,0000,,Қайсысы? Гоку.
Dialogue: 0,0:11:47.97,0:11:50.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:47.97,0:11:50.98,Default,,0000,0000,0000,,Оны жеме. Концентрат.
Dialogue: 0,0:11:50.98,0:11:55.98,Default,,0000,0000,0000,,Хмм... аа... а...
Dialogue: 0,0:11:55.98,0:11:57.95,Default,,0000,0000,0000,,​​Түсіндім.
Dialogue: 0,0:12:00.99,0:12:02.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:00.99,0:12:02.99,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:12:02.99,0:12:04.99,Default,,0000,0000,0000,,Мен Денденің энергиясын жақыннан сезінемін.
Dialogue: 0,0:12:04.99,0:12:08.99,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:12:04.99,0:12:08.99,Default,,0000,0000,0000,,Мен мұнда қаламын! Өтінемін, менімен бірге шайқасуға рұқсат ет!
Dialogue: 0,0:12:08.99,0:12:11.96,Default,,0000,0000,0000,,Ах... Ха ха...
Dialogue: 0,0:12:18.00,0:12:21.01,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:12:21.01,0:12:24.01,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:12:24.01,0:12:26.98,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:12:44.96,0:12:46.93,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:12:48.97,0:12:51.97,Default,,0000,0000,0000,,Денді босат!
Dialogue: 0,0:12:51.97,0:12:55.98,Default,,0000,0000,0000,,Осы уақытқа дейін жеткеніңізге жарайсың.
Dialogue: 0,0:12:55.98,0:12:57.98,Default,,0000,0000,0000,,Бұл үлкен мәселе. Мен сені мақтаймын.
Dialogue: 0,0:12:57.98,0:13:00.98,Default,,0000,0000,0000,,Бұл не? Эй!
Dialogue: 0,0:12:57.98,0:13:00.98,Default,,0000,0000,0000,,Tsk….
Dialogue: 0,0:13:00.98,0:13:04.98,Default,,0000,0000,0000,,Дегесу!
Dialogue: 0,0:13:00.98,0:13:04.98,Default,,0000,0000,0000,,Бұлай жасамаңыз.
Dialogue: 0,0:13:04.98,0:13:09.99,Default,,0000,0000,0000,,Oh my goodness
Dialogue: 0,0:13:04.98,0:13:09.99,Default,,0000,0000,0000,,Ағаң үздігі емес пе?
Dialogue: 0,0:13:09.99,0:13:11.99,Default,,0000,0000,0000,,Жүздеген жылдар….
Dialogue: 0,0:13:11.99,0:13:14.99,Default,,0000,0000,0000,,Жоқ, 1000 жылдан астам уақыт өтті.
Dialogue: 0,0:13:14.99,0:13:21.00,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:13:14.99,0:13:21.00,Default,,0000,0000,0000,,Сіз Кай патшаның інісісіз бе?
Dialogue: 0,0:13:21.00,0:13:25.00,Default,,0000,0000,0000,,Келіңдер, бәрің.
Dialogue: 0,0:13:21.00,0:13:25.00,Default,,0000,0000,0000,,Өтінемін, маған жақындама.
Dialogue: 0,0:13:25.00,0:13:29.01,Default,,0000,0000,0000,,Дегесу! сен
Dialogue: 0,0:13:25.00,0:13:29.01,Default,,0000,0000,0000,,Не істегіңіз келеді!?
Dialogue: 0,0:13:29.01,0:13:32.95,Default,,0000,0000,0000,,Сізге не керек? Бұл дұрыс емес
Dialogue: 0,0:13:29.01,0:13:32.95,Default,,0000,0000,0000,,Бұл шешілген жоқ па? ➡
Dialogue: 0,0:13:32.95,0:13:38.95,Default,,0000,0000,0000,,Әрине, ақыр соңында
Dialogue: 0,0:13:32.95,0:13:38.95,Default,,0000,0000,0000,,Ол осы ұлы жын әлемінің патшасы.
Dialogue: 0,0:13:38.95,0:13:42.96,Default,,0000,0000,0000,,Гриндиялықтар жындар әлемінің патшасы болды.
Dialogue: 0,0:13:38.95,0:13:42.96,Default,,0000,0000,0000,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:13:42.96,0:13:46.96,Default,,0000,0000,0000,,Біріншіден, сіз
Dialogue: 0,0:13:42.96,0:13:46.96,Default,,0000,0000,0000,,Күшті амбиция және өзін-өзі көрсетуге ұмтылу➡
Dialogue: 0,0:13:46.96,0:13:49.96,Default,,0000,0000,0000,,Ойланбайды
Dialogue: 0,0:13:46.96,0:13:49.96,Default,,0000,0000,0000,,Іс-әрекеттерінен анық көрінеді.
Dialogue: 0,0:13:49.96,0:13:52.97,Default,,0000,0000,0000,,Хмм... Мен түсіндім деп ойлаймын.
Dialogue: 0,0:13:49.96,0:13:52.97,Default,,0000,0000,0000,,Өтінемін, олай айтпаңыз.
Dialogue: 0,0:13:52.97,0:13:56.97,Default,,0000,0000,0000,,Жоғары лауазымға ұмтылу
Dialogue: 0,0:13:52.97,0:13:56.97,Default,,0000,0000,0000,,Гриндиялық темперамент.
Dialogue: 0,0:13:56.97,0:13:58.97,Default,,0000,0000,0000,,Сондай ойлы аға➡
Dialogue: 0,0:13:58.97,0:14:02.98,Default,,0000,0000,0000,,Сыртқы әлемде бастық болу
Dialogue: 0,0:13:58.97,0:14:02.98,Default,,0000,0000,0000,,Сен не істеп жатырсың?
Dialogue: 0,0:14:02.98,0:14:06.98,Default,,0000,0000,0000,,Айтпақшы, Кай патша не істейді...?
Dialogue: 0,0:14:06.98,0:14:10.98,Default,,0000,0000,0000,,Әлемдегі тыныштық пен тәртіп
Dialogue: 0,0:14:06.98,0:14:10.98,Default,,0000,0000,0000,,Мен сені бақылап тұрамын.
Dialogue: 0,0:14:10.98,0:14:12.95,Default,,0000,0000,0000,,Ойнайық. Әйтеуір біз пианисттер ғой.
Dialogue: 0,0:14:10.98,0:14:12.95,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:14:15.99,0:14:17.99,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:14:15.99,0:14:17.99,Default,,0000,0000,0000,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:14:17.99,0:14:19.99,Default,,0000,0000,0000,,Дұрыс, болды!
Dialogue: 0,0:14:19.99,0:14:23.00,Default,,0000,0000,0000,,Анау Дегесу жігіті не істеп жүр?
Dialogue: 0,0:14:23.00,0:14:29.00,Default,,0000,0000,0000,,Бұл қандай да бір стратегия болуы керек.
Dialogue: 0,0:14:23.00,0:14:29.00,Default,,0000,0000,0000,,Жоқ, бірақ...
Dialogue: 0,0:14:29.00,0:14:32.94,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:14:32.94,0:14:35.91,Default,,0000,0000,0000,,Сіз мені тастап кетуді жоспарлап отырсыз ба? ?
Dialogue: 0,0:14:45.95,0:14:47.92,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:14:49.96,0:14:55.63,Default,,0000,0000,0000,,Хмф, үшінші жын әлеміндегі кішкентай қыз...
Dialogue: 0,0:14:49.96,0:14:55.63,Default,,0000,0000,0000,,Әзіл ойнау.
Dialogue: 0,0:14:55.63,0:14:58.63,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:55.63,0:14:58.63,Default,,0000,0000,0000,,Тек төмен түсіңіз.
Dialogue: 0,0:14:58.63,0:15:00.90,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:15:07.97,0:15:10.94,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:15:07.97,0:15:10.94,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:15:13.98,0:15:15.95,Default,,0000,0000,0000,,Ха! Гах...
Dialogue: 0,0:15:18.98,0:15:20.99,Default,,0000,0000,0000,,Қауіпсіз!
Dialogue: 0,0:15:20.99,0:15:23.96,Default,,0000,0000,0000,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,0:15:20.99,0:15:23.96,Default,,0000,0000,0000,,Құдайға шүкір.
Dialogue: 0,0:15:27.99,0:15:30.96,Default,,0000,0000,0000,,Бұл үлкен! Пунду!
Dialogue: 0,0:15:35.00,0:15:37.00,Default,,0000,0000,0000,,Не? бұл.
Dialogue: 0,0:15:37.00,0:15:39.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:37.00,0:15:39.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:39.00,0:15:41.01,Default,,0000,0000,0000,,Глорио!
Dialogue: 0,0:15:41.01,0:15:44.01,Default,,0000,0000,0000,,Менің басым суып кетті.
Dialogue: 0,0:15:44.01,0:15:46.01,Default,,0000,0000,0000,,Hmph….
Dialogue: 0,0:15:46.01,0:15:48.01,Default,,0000,0000,0000,,Мені құтқарғаныңыз үшін рахмет!
Dialogue: 0,0:15:48.01,0:15:53.02,Default,,0000,0000,0000,,Хмм... Иә.
Dialogue: 0,0:15:53.02,0:15:55.02,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:15:53.02,0:15:55.02,Default,,0000,0000,0000,,Сен екеуің алда барыңдар!
Dialogue: 0,0:15:55.02,0:15:59.02,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:15:59.02,0:16:01.99,Default,,0000,0000,0000,,Өте қорқынышты және сүйкімді!
Dialogue: 0,0:16:07.03,0:16:09.03,Default,,0000,0000,0000,,Қараңызшы! Дегесу!
Dialogue: 0,0:16:09.03,0:16:12.04,Default,,0000,0000,0000,,Ахахха! Охохохо!
Dialogue: 0,0:16:12.04,0:16:15.04,Default,,0000,0000,0000,,Бұлай айтатын уақыт емес! ➡
Dialogue: 0,0:16:15.04,0:16:17.04,Default,,0000,0000,0000,,А-ли
Dialogue: 0,0:16:15.04,0:16:17.04,Default,,0000,0000,0000,,Мен не істеуім керек? Не істеуім керек?
Dialogue: 0,0:16:17.04,0:16:20.05,Default,,0000,0000,0000,,Ах... у...
Dialogue: 0,0:16:20.05,0:16:22.05,Default,,0000,0000,0000,,Ах! ?
Dialogue: 0,0:16:22.05,0:16:25.05,Default,,0000,0000,0000,,А? Не... Не!
Dialogue: 0,0:16:25.05,0:16:29.05,Default,,0000,0000,0000,,Дегесу-сама сұраған белбеу.
Dialogue: 0,0:16:25.05,0:16:29.05,Default,,0000,0000,0000,,Мен оны өзіммен бірге алып келдім...
Dialogue: 0,0:16:29.05,0:16:32.99,Default,,0000,0000,0000,,Белдік! О! Белбеу!
Dialogue: 0,0:16:32.99,0:16:34.99,Default,,0000,0000,0000,,Аха!
Dialogue: 0,0:16:34.99,0:16:37.00,Default,,0000,0000,0000,,Гехехехе….
Dialogue: 0,0:16:37.00,0:16:42.00,Default,,0000,0000,0000,,Мм... әлі толық емес ақша
Dialogue: 0,0:16:37.00,0:16:42.00,Default,,0000,0000,0000,,Мен оны әлі алған жоқпын.
Dialogue: 0,0:16:42.00,0:16:45.00,Default,,0000,0000,0000,,Сондай-ақ бұрынғы жігітім маған сыйға тартқан қалпақ.
Dialogue: 0,0:16:42.00,0:16:45.00,Default,,0000,0000,0000,,Оны алып кетті.
Dialogue: 0,0:16:45.00,0:16:47.01,Default,,0000,0000,0000,,Түсіндім, түсінемін. ➡
Dialogue: 0,0:16:47.01,0:16:50.01,Default,,0000,0000,0000,,Басқа бөлмеде не бар?
Dialogue: 0,0:16:47.01,0:16:50.01,Default,,0000,0000,0000,,Қалағаныңызша үйге апарыңыз!
Dialogue: 0,0:16:50.01,0:16:53.01,Default,,0000,0000,0000,,Ха! Алақай!
Dialogue: 0,0:16:53.01,0:16:57.02,Default,,0000,0000,0000,,Күмәнсіз... бұл шын. ➡
Dialogue: 0,0:16:57.02,0:17:01.99,Default,,0000,0000,0000,,Бұл нағыз үшінші көз!
Dialogue: 0,0:17:24.04,0:17:27.05,Default,,0000,0000,0000,,Жарайды, мен де Дендеге көмектестім➡
Dialogue: 0,0:17:27.05,0:17:29.05,Default,,0000,0000,0000,,Қалғандары
Dialogue: 0,0:17:27.05,0:17:29.05,Default,,0000,0000,0000,,Біз жай ғана ересек боламыз.
Dialogue: 0,0:17:29.05,0:17:32.99,Default,,0000,0000,0000,,Айдаһар добы?
Dialogue: 0,0:17:29.05,0:17:32.99,Default,,0000,0000,0000,,Гомер ше?
Dialogue: 0,0:17:32.99,0:17:34.99,Default,,0000,0000,0000,,Алдымен оларды жеңеміз бе?
Dialogue: 0,0:17:34.99,0:17:38.99,Default,,0000,0000,0000,,Жоқ, Гомер.
Dialogue: 0,0:17:34.99,0:17:38.99,Default,,0000,0000,0000,,Оны бағаламаңыз.
Dialogue: 0,0:17:38.99,0:17:41.99,Default,,0000,0000,0000,,Алдымен Тамагамимен күрес.
Dialogue: 0,0:17:38.99,0:17:41.99,Default,,0000,0000,0000,,Ересек болса, сенімдірек болар еді.
Dialogue: 0,0:17:41.99,0:17:45.00,Default,,0000,0000,0000,,Хм... Мұны істейміз бе?
Dialogue: 0,0:17:45.00,0:17:50.97,Default,,0000,0000,0000,,Бірінші жын әлеміндегі Тамагами
Dialogue: 0,0:17:45.00,0:17:50.97,Default,,0000,0000,0000,,Бұл дәл көрші алаңның ішінде.
Dialogue: 0,0:18:13.03,0:18:18.03,Default,,0000,0000,0000,,О! Бұл Тамагами
Dialogue: 0,0:18:13.03,0:18:18.03,Default,,0000,0000,0000,,Одан да күшті көрінеді.
Dialogue: 0,0:18:18.03,0:18:20.03,Default,,0000,0000,0000,,Әй, бұл жолы кім төбелеседі?
Dialogue: 0,0:18:20.03,0:18:24.04,Default,,0000,0000,0000,,Сіз бұған дейін берілгенсіз.
Dialogue: 0,0:18:20.03,0:18:24.04,Default,,0000,0000,0000,,Келесі - Ола.
Dialogue: 0,0:18:24.04,0:18:26.00,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:18:30.98,0:18:36.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:36.98,0:18:38.98,Default,,0000,0000,0000,,Хмм? ➡
Dialogue: 0,0:18:38.98,0:18:40.99,Default,,0000,0000,0000,,Айдаһар шарлары жоқ!
Dialogue: 0,0:18:40.99,0:18:43.96,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:18:40.99,0:18:43.96,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:18:46.99,0:18:48.99,Default,,0000,0000,0000,,Бұл рас!
Dialogue: 0,0:18:46.99,0:18:48.99,Default,,0000,0000,0000,,Не айтып тұрсың! ?
Dialogue: 0,0:18:48.99,0:18:52.66,Default,,0000,0000,0000,,Айдаһар добы
Dialogue: 0,0:18:48.99,0:18:52.66,Default,,0000,0000,0000,,Жеңіске жеткендердің қолына өтті.
Dialogue: 0,0:18:52.66,0:18:54.67,Default,,0000,0000,0000,,және ол бұрын сарбаз болған.
Dialogue: 0,0:18:54.67,0:18:57.94,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:18:54.67,0:18:57.94,Default,,0000,0000,0000,,Huh... ah? Не?
Dialogue: 0,0:19:02.01,0:19:04.98,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:19:02.01,0:19:04.98,Default,,0000,0000,0000,,Білемін, бірақ шынымен сабырымды сақтай аламын ба?
Dialogue: 0,0:19:07.01,0:19:10.02,Default,,0000,0000,0000,,Demon?
Dialogue: 0,0:19:07.01,0:19:10.02,Default,,0000,0000,0000,,Бұл өкінішті болды. ➡
Dialogue: 0,0:19:10.02,0:19:14.02,Default,,0000,0000,0000,,Айдаһар добы осында
Dialogue: 0,0:19:10.02,0:19:14.02,Default,,0000,0000,0000,,We received it.
Dialogue: 0,0:19:14.02,0:19:16.99,Default,,0000,0000,0000,,Ах! ? ауа….
Dialogue: 0,0:19:19.02,0:19:20.99,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:19:28.03,0:19:30.97,Default,,0000,0000,0000,,Иә! Damn... ➡
Dialogue: 0,0:19:30.97,0:19:34.97,Default,,0000,0000,0000,,Оны қалай жоюға болады...
Dialogue: 0,0:19:30.97,0:19:34.97,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:19:34.97,0:19:37.94,Default,,0000,0000,0000,,Бұл да жақсы емес пе? Tet.
Dialogue: 0,0:19:39.98,0:19:42.98,Default,,0000,0000,0000,,Хмм… мм… мм….
Dialogue: 0,0:19:42.98,0:19:45.98,Default,,0000,0000,0000,,Ха ха... ха....
Dialogue: 0,0:19:45.98,0:19:48.99,Default,,0000,0000,0000,,Конояро!
Dialogue: 0,0:19:48.99,0:19:53.99,Default,,0000,0000,0000,,This...!
Dialogue: 0,0:19:53.99,0:19:55.96,Default,,0000,0000,0000,,Қат!
Dialogue: 0,0:20:04.00,0:20:07.97,Default,,0000,0000,0000,,(дәретхананың ағу дыбысы)
Dialogue: 0,0:20:09.68,0:20:11.94,Default,,0000,0000,0000,,Hmm... Ah!
Dialogue: 0,0:20:15.01,0:20:17.02,Default,,0000,0000,0000,,Ku~! Қарғыс атқыр...
Dialogue: 0,0:20:17.02,0:20:20.02,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:20.02,0:20:22.02,Default,,0000,0000,0000,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:20:22.02,0:20:26.02,Default,,0000,0000,0000,,Мынау, мынау, мынау...!
Dialogue: 0,0:20:26.02,0:20:27.99,Default,,0000,0000,0000,,Ах! !
Dialogue: 0,0:20:30.03,0:20:31.96,Default,,0000,0000,0000,,О!
Dialogue: 0,0:20:31.96,0:20:34.97,Default,,0000,0000,0000,,Иә! It's Third Eye!
Dialogue: 0,0:20:34.97,0:20:36.97,Default,,0000,0000,0000,,Сәлем сен!
Dialogue: 0,0:20:34.97,0:20:36.97,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:20:36.97,0:20:38.97,Default,,0000,0000,0000,,Қара, мына жақта да бар.
Dialogue: 0,0:20:38.97,0:20:41.97,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,0:20:38.97,0:20:41.97,Default,,0000,0000,0000,,Сіз өзіңізбен бірге үйге кез келген нәрсені ала аласыз...
Dialogue: 0,0:20:41.97,0:20:43.98,Default,,0000,0000,0000,,Көзіңізді осылай ұстаңыз➡
Dialogue: 0,0:20:43.98,0:20:46.98,Default,,0000,0000,0000,,Маңдайымның ортасында
Dialogue: 0,0:20:43.98,0:20:46.98,Default,,0000,0000,0000,,Оны бір-біріне жабыстырыңыз!
Dialogue: 0,0:20:46.98,0:20:49.98,Default,,0000,0000,0000,,Эх! ?
Dialogue: 0,0:20:46.98,0:20:49.98,Default,,0000,0000,0000,,Келіңіздер! мінеки біз! !
Dialogue: 0,0:20:49.98,0:20:51.98,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:20:51.98,0:20:54.99,Default,,0000,0000,0000,,Өрескел! Мен оны ұнатпаймын! Мүлдем жиіркенішті!
Dialogue: 0,0:20:54.99,0:20:58.99,Default,,0000,0000,0000,,Бұл Ұлы жын патшаның өтініші!
Dialogue: 0,0:20:54.99,0:20:58.99,Default,,0000,0000,0000,,Мен тіпті Ұлы жын патшаны да жек көремін!
Dialogue: 0,0:20:58.99,0:21:01.99,Default,,0000,0000,0000,,Gunugunu….
Dialogue: 0,0:21:01.99,0:21:04.00,Default,,0000,0000,0000,,Түсіндім, 50 000 бас сүйек жасаймын!
Dialogue: 0,0:21:04.00,0:21:06.00,Default,,0000,0000,0000,,100,000 skulls.
Dialogue: 0,0:21:04.00,0:21:06.00,Default,,0000,0000,0000,,Kuu!
Dialogue: 0,0:21:06.00,0:21:09.00,Default,,0000,0000,0000,,Ugh… this….
Dialogue: 0,0:21:09.00,0:21:12.00,Default,,0000,0000,0000,,Okay, fine.
Dialogue: 0,0:21:09.00,0:21:12.00,Default,,0000,0000,0000,,Тез орындаңыз!
Dialogue: 0,0:21:12.00,0:21:14.01,Default,,0000,0000,0000,,Олай болса маған қарызға бер.
Dialogue: 0,0:21:14.01,0:21:17.01,Default,,0000,0000,0000,,Уау... мүмкін емес.
Dialogue: 0,0:21:17.01,0:21:18.98,Default,,0000,0000,0000,,Woohoo.
Dialogue: 0,0:21:22.01,0:21:23.98,Default,,0000,0000,0000,,Ой!
Dialogue: 0,0:21:34.96,0:21:37.96,Default,,0000,0000,0000,,Nwa… ah….
Dialogue: 0,0:21:37.96,0:21:41.97,Default,,0000,0000,0000,,Гуах... бұл...➡
Dialogue: 0,0:21:41.97,0:21:45.97,Default,,0000,0000,0000,,Уф… уф….
Dialogue: 0,0:21:45.97,0:21:54.95,Default,,0000,0000,0000,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:21:58.98,0:22:01.99,Default,,0000,0000,0000,,Уф... өтірік...
Dialogue: 0,0:22:01.99,0:22:17.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:17.00,0:22:20.01,Default,,0000,0000,0000,,Кя!!
Dialogue: 0,0:22:20.01,0:22:30.02,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:30.02,0:22:32.95,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:22:32.95,0:22:39.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:39.96,0:22:49.94,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
