Dialogue: 0,0:00:02.04,0:00:14.05,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:00:14.05,0:00:16.05,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:00:16.05,0:00:18.05,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:00:18.05,0:00:22.02,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:00:29.06,0:00:32.07,Default,,0000,0000,0000,,Міне, басталды!
Dialogue: 0,0:00:32.07,0:00:36.07,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:00:36.07,0:00:39.07,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:00:39.07,0:00:42.04,Default,,0000,0000,0000,,Арх! Гуаа...
Dialogue: 0,0:00:45.08,0:00:47.08,Default,,0000,0000,0000,,Куу...!
Dialogue: 0,0:00:47.08,0:00:49.08,Default,,0000,0000,0000,,Уф... уф!
Dialogue: 0,0:00:49.08,0:00:51.08,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:00:51.08,0:00:53.75,Default,,0000,0000,0000,,Сен… кімсің?
Dialogue: 0,0:00:53.75,0:00:56.09,Default,,0000,0000,0000,,Доя!
Dialogue: 0,0:00:53.75,0:00:56.09,Default,,0000,0000,0000,,Тей! Қарғыс атсын!
Dialogue: 0,0:00:56.09,0:00:58.09,Default,,0000,0000,0000,,Міне, бастаймын!
Dialogue: 0,0:00:56.09,0:00:58.09,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:00:58.09,0:01:02.03,Default,,0000,0000,0000,,Таа! Айтпақшы!
Dialogue: 0,0:01:02.03,0:01:04.03,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:01:02.03,0:01:04.03,Default,,0000,0000,0000,,Иә! Таа!
Dialogue: 0,0:01:04.03,0:01:05.70,Default,,0000,0000,0000,,Міне, бастаймын!
Dialogue: 0,0:01:05.70,0:01:08.03,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:01:05.70,0:01:08.03,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:01:08.03,0:01:10.04,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:01:08.03,0:01:10.04,Default,,0000,0000,0000,,Қарғыс атсын... ➡
Dialogue: 0,0:01:10.04,0:01:12.01,Default,,0000,0000,0000,,Таа!
Dialogue: 0,0:01:15.04,0:01:17.01,Default,,0000,0000,0000,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:01:15.04,0:01:17.01,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:01:19.05,0:01:21.05,Default,,0000,0000,0000,,Таа!
Dialogue: 0,0:01:21.05,0:01:23.05,Default,,0000,0000,0000,,Бірақ мен өз күнәларыммен осылай бетпе-бет келгенім…
Dialogue: 0,0:01:23.05,0:01:25.05,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:01:23.05,0:01:25.05,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:01:25.05,0:01:27.05,Default,,0000,0000,0000,,Ааа!
Dialogue: 0,0:01:27.05,0:01:29.06,Default,,0000,0000,0000,,Уф! ➡
Dialogue: 0,0:01:29.06,0:01:31.06,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:01:31.06,0:01:33.06,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:01:31.06,0:01:33.06,Default,,0000,0000,0000,,Аһ!
Dialogue: 0,0:01:33.06,0:01:35.03,Default,,0000,0000,0000,,Бір-бірден, кезекпен—
Dialogue: 0,0:01:33.06,0:01:35.03,Default,,0000,0000,0000,,Арх!
Dialogue: 0,0:01:37.40,0:01:39.07,Default,,0000,0000,0000,,Хе…. ➡
Dialogue: 0,0:01:39.07,0:01:41.07,Default,,0000,0000,0000,,Қазір он жылға жуық уақыт болды, иә? Ол анама тіпті кешірім сұрауға да келген жоқ
Dialogue: 0,0:01:41.07,0:01:43.04,Default,,0000,0000,0000,,Ах... Қарғыс атсын!
Dialogue: 0,0:01:45.07,0:01:47.07,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:01:47.07,0:01:49.04,Default,,0000,0000,0000,,Қарғыс атсын! Гу~!
Dialogue: 0,0:01:52.08,0:01:55.05,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:01:58.08,0:02:00.09,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:02:00.09,0:02:02.02,Default,,0000,0000,0000,,Уау! ➡
Dialogue: 0,0:02:02.02,0:02:04.02,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:02:04.02,0:02:07.03,Default,,0000,0000,0000,,Ta! мұнара! Тарья!
Dialogue: 0,0:02:07.03,0:02:10.03,Default,,0000,0000,0000,,Ха! Қарғыс атсын!
Dialogue: 0,0:02:10.03,0:02:12.03,Default,,0000,0000,0000,,Дая!
Dialogue: 0,0:02:12.03,0:02:14.03,Default,,0000,0000,0000,,Дая!
Dialogue: 0,0:02:14.03,0:02:16.04,Default,,0000,0000,0000,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:02:14.03,0:02:16.04,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:16.04,0:02:19.04,Default,,0000,0000,0000,,Арх! Ку!
Dialogue: 0,0:02:16.04,0:02:19.04,Default,,0000,0000,0000,,Құдай-ай!
Dialogue: 0,0:02:19.04,0:02:21.04,Default,,0000,0000,0000,,Аһ!
Dialogue: 0,0:02:19.04,0:02:21.04,Default,,0000,0000,0000,,Ааа!
Dialogue: 0,0:02:21.04,0:02:23.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:26.05,0:02:28.05,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:02:26.05,0:02:28.05,Default,,0000,0000,0000,,Таа!
Dialogue: 0,0:02:28.05,0:02:31.05,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:02:31.05,0:02:34.05,Default,,0000,0000,0000,,Ku~! Хмф!
Dialogue: 0,0:02:34.05,0:02:36.02,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:02:39.06,0:02:41.06,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:02:41.06,0:02:43.06,Default,,0000,0000,0000,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:02:43.06,0:02:45.03,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:02:47.07,0:02:50.07,Default,,0000,0000,0000,,Ku…kunu…humph!
Dialogue: 0,0:02:50.07,0:02:52.07,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:52.07,0:02:53.74,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:02:52.07,0:02:53.74,Default,,0000,0000,0000,,Нухахаха….
Dialogue: 0,0:02:53.74,0:03:00.08,Default,,0000,0000,0000,,Сендер, үндемеңдер!➡
Dialogue: 0,0:03:00.08,0:03:02.02,Default,,0000,0000,0000,,Хах.
Dialogue: 0,0:03:02.02,0:03:04.02,Default,,0000,0000,0000,,Tsk….
Dialogue: 0,0:03:04.02,0:03:07.02,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:03:07.02,0:03:10.02,Default,,0000,0000,0000,,Міне — жер астында.
Dialogue: 0,0:03:10.02,0:03:12.03,Default,,0000,0000,0000,,Қарғыс атсын! Алақай!
Dialogue: 0,0:03:12.03,0:03:14.03,Default,,0000,0000,0000,,Ха! Қарғыс атсын!
Dialogue: 0,0:03:14.03,0:03:16.00,Default,,0000,0000,0000,,Ааа!
Dialogue: 0,0:03:19.03,0:03:22.04,Default,,0000,0000,0000,,Нуу….
Dialogue: 0,0:03:19.03,0:03:22.04,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:03:22.04,0:03:23.70,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,0:03:22.04,0:03:23.70,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:03:23.70,0:03:26.04,Default,,0000,0000,0000,,Гррр... Ах! ?
Dialogue: 0,0:03:26.04,0:03:28.04,Default,,0000,0000,0000,,Сен… кімсің?
Dialogue: 0,0:03:28.04,0:03:30.01,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,0:03:32.05,0:03:34.01,Default,,0000,0000,0000,,Уф! ? Апыр-ай!
Dialogue: 0,0:03:36.05,0:03:39.02,Default,,0000,0000,0000,,Уау! Ха!
Dialogue: 0,0:03:42.06,0:03:44.06,Default,,0000,0000,0000,,Иә? Ха! ?
Dialogue: 0,0:03:44.06,0:03:47.06,Default,,0000,0000,0000,,Күрсін! Хаа!
Dialogue: 0,0:03:47.06,0:03:49.03,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:03:52.07,0:03:54.03,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:03:58.07,0:04:01.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:04:01.01,0:04:05.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:04:05.01,0:04:07.98,Default,,0000,0000,0000,,Уряаа~!
Dialogue: 0,0:04:05.01,0:04:07.98,Default,,0000,0000,0000,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:04:15.02,0:04:19.03,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:04:19.03,0:04:22.03,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:04:19.03,0:04:22.03,Default,,0000,0000,0000,,Тория!
Dialogue: 0,0:04:22.03,0:04:24.03,Default,,0000,0000,0000,,Ха! Тарья!
Dialogue: 0,0:04:24.03,0:04:26.03,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:04:26.03,0:04:29.04,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:04:29.04,0:04:31.04,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:04:31.04,0:04:34.04,Default,,0000,0000,0000,,Гуаааааааааааааааааааааааа!
Dialogue: 0,0:04:34.04,0:04:37.04,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:04:37.04,0:04:40.05,Default,,0000,0000,0000,,Не! Уф... Уф...
Dialogue: 0,0:04:40.05,0:04:42.05,Default,,0000,0000,0000,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:04:42.05,0:04:47.05,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:04:47.05,0:04:49.06,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:04:49.06,0:04:51.02,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:04:54.06,0:04:57.06,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,0:04:57.06,0:05:05.00,Default,,0000,0000,0000,,Ахх! !
Dialogue: 0,0:05:05.00,0:05:09.01,Default,,0000,0000,0000,,Уау! Не! ?
Dialogue: 0,0:05:09.01,0:05:16.02,Default,,0000,0000,0000,,Хааааааааааааааааааааааааааааааааа!
Dialogue: 0,0:05:16.02,0:05:17.98,Default,,0000,0000,0000,,Қат!
Dialogue: 0,0:05:20.02,0:05:24.02,Default,,0000,0000,0000,,Хааааааааааааааааааааааааааа! !
Dialogue: 0,0:05:24.02,0:05:37.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:47.05,0:05:52.05,Default,,0000,0000,0000,,Ка~ме~.
Dialogue: 0,0:05:52.05,0:05:55.02,Default,,0000,0000,0000,,Ах... Қарғыс атсын!
Dialogue: 0,0:05:58.06,0:06:04.00,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:06:04.00,0:06:07.97,Default,,0000,0000,0000,,болып табылады
Dialogue: 0,0:06:04.00,0:06:07.97,Default,,0000,0000,0000,,Толқындар! !
Dialogue: 0,0:06:15.01,0:06:17.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:17.01,0:06:19.98,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:06:26.02,0:06:29.02,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:29.02,0:06:33.99,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:06:38.03,0:06:42.03,Default,,0000,0000,0000,,Содан бір күні бір сәуле жарқырап түсті,
Dialogue: 0,0:06:42.03,0:06:45.04,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:06:45.04,0:06:48.01,Default,,0000,0000,0000,,Ахх! !
Dialogue: 0,0:06:50.04,0:06:52.01,Default,,0000,0000,0000,,Ах!?
Dialogue: 0,0:06:56.05,0:06:59.05,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:59.05,0:07:19.01,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:19.01,0:07:36.02,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:36.02,0:07:38.99,Default,,0000,0000,0000,,А... а...
Dialogue: 0,0:07:42.03,0:07:44.03,Default,,0000,0000,0000,,Кайошин
Dialogue: 0,0:07:42.03,0:07:44.03,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:44.03,0:07:48.00,Default,,0000,0000,0000,,Ааа… аа… аа….
Dialogue: 0,0:08:04.02,0:08:07.02,Default,,0000,0000,0000,,Ах... у...
Dialogue: 0,0:08:07.02,0:08:08.99,Default,,0000,0000,0000,,Қазір!
Dialogue: 0,0:08:11.02,0:08:14.03,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:08:11.02,0:08:14.03,Default,,0000,0000,0000,,Мені жеңіл санама!
Dialogue: 0,0:08:14.03,0:08:16.03,Default,,0000,0000,0000,,Күрсін!
Dialogue: 0,0:08:14.03,0:08:16.03,Default,,0000,0000,0000,,Гах!
Dialogue: 0,0:08:16.03,0:08:18.70,Default,,0000,0000,0000,,Бұл соңы!
Dialogue: 0,0:08:18.70,0:08:20.37,Default,,0000,0000,0000,,Уау...!
Dialogue: 0,0:08:20.37,0:08:22.03,Default,,0000,0000,0000,,Аһ!
Dialogue: 0,0:08:20.37,0:08:22.03,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:08:22.03,0:08:24.04,Default,,0000,0000,0000,,Гррр! ➡
Dialogue: 0,0:08:24.04,0:08:26.04,Default,,0000,0000,0000,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:08:26.04,0:08:28.04,Default,,0000,0000,0000,,Мен... Мен сәтсіздікке ұшырадым!
Dialogue: 0,0:08:28.04,0:08:30.01,Default,,0000,0000,0000,,Біз не істеуіміз керек? ?
Dialogue: 0,0:08:32.04,0:08:36.05,Default,,0000,0000,0000,,Қарғыс атсын... Қарғыс атсын!
Dialogue: 0,0:08:32.04,0:08:36.05,Default,,0000,0000,0000,,Үшінші көзді алып тастау әрекеті... ➡
Dialogue: 0,0:08:36.05,0:08:39.05,Default,,0000,0000,0000,,Мен саған бұлай істеуге рұқсат бермеймін! ➡
Dialogue: 0,0:08:39.05,0:08:42.02,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:46.06,0:08:49.06,Default,,0000,0000,0000,,Сол кітапта
Dialogue: 0,0:08:46.06,0:08:49.06,Default,,0000,0000,0000,,Көбірек анықтамалар болуы мүмкін...
Dialogue: 0,0:08:49.06,0:08:51.06,Default,,0000,0000,0000,,Уф... уау!
Dialogue: 0,0:08:51.06,0:08:54.07,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:08:54.07,0:08:56.04,Default,,0000,0000,0000,,Жаман!
Dialogue: 0,0:08:58.07,0:09:00.04,Default,,0000,0000,0000,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:09:06.08,0:09:08.08,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:08.08,0:09:11.08,Default,,0000,0000,0000,,Қарғыс атсын...
Dialogue: 0,0:09:08.08,0:09:11.08,Default,,0000,0000,0000,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:09:11.08,0:09:13.05,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:16.09,0:09:19.06,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:16.09,0:09:19.06,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:21.09,0:09:25.10,Default,,0000,0000,0000,,Хахаха... ➡
Dialogue: 0,0:09:25.10,0:09:28.10,Default,,0000,0000,0000,,Хмм... хехехе...
Dialogue: 0,0:09:28.10,0:09:32.04,Default,,0000,0000,0000,,Ахахаха!
Dialogue: 0,0:09:32.04,0:09:35.04,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:35.04,0:09:38.04,Default,,0000,0000,0000,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:09:35.04,0:09:38.04,Default,,0000,0000,0000,,Польнарефф?
Dialogue: 0,0:09:38.04,0:09:40.05,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:09:40.05,0:09:42.05,Default,,0000,0000,0000,,Ал Хинацуру…
Dialogue: 0,0:09:42.05,0:09:45.05,Default,,0000,0000,0000,,Әй! ?
Dialogue: 0,0:09:45.05,0:09:48.05,Default,,0000,0000,0000,,Ку… Куу!
Dialogue: 0,0:09:48.05,0:09:51.06,Default,,0000,0000,0000,,...
Dialogue: 0,0:09:48.05,0:09:51.06,Default,,0000,0000,0000,,Тория! ➡
Dialogue: 0,0:09:51.06,0:09:53.03,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:09:56.06,0:09:58.06,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:09:58.06,0:10:01.07,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:58.06,0:10:01.07,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:10:01.07,0:10:04.04,Default,,0000,0000,0000,,Ах... аааа!
Dialogue: 0,0:10:09.08,0:10:13.05,Default,,0000,0000,0000,,Ой... Уау!
Dialogue: 0,0:10:15.41,0:10:17.42,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:15.41,0:10:17.42,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:17.42,0:10:18.99,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:17.42,0:10:18.99,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:21.09,0:10:23.09,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:10:23.09,0:10:25.06,Default,,0000,0000,0000,,(сыртқы дыбыс)
Dialogue: 0,0:10:39.04,0:10:42.04,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:10:42.04,0:10:44.04,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:10:44.04,0:10:46.01,Default,,0000,0000,0000,,Глорио!
Dialogue: 0,0:10:52.05,0:10:54.05,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:10:54.05,0:10:56.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:59.06,0:11:03.06,Default,,0000,0000,0000,,Не? Шешім маған бәрібір, солай ма?
Dialogue: 0,0:11:03.06,0:11:06.07,Default,,0000,0000,0000,,Сиқыр
Dialogue: 0,0:11:03.06,0:11:06.07,Default,,0000,0000,0000,,Ах! Керемет, Маджин Куу!
Dialogue: 0,0:11:06.07,0:11:08.07,Default,,0000,0000,0000,,Сіз мұны жасадыңыз!
Dialogue: 0,0:11:08.07,0:11:10.07,Default,,0000,0000,0000,,Жарайсың!
Dialogue: 0,0:11:10.07,0:11:13.04,Default,,0000,0000,0000,,(Жауынгер Ду)
Dialogue: 0,0:11:10.07,0:11:13.04,Default,,0000,0000,0000,,Ха! Ха! Бая!
Dialogue: 0,0:11:15.07,0:11:17.04,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:21.08,0:11:24.05,Default,,0000,0000,0000,,Аринс мырза.
Dialogue: 0,0:11:25.75,0:11:28.09,Default,,0000,0000,0000,,Уф... Ахаха.
Dialogue: 0,0:11:28.09,0:11:31.06,Default,,0000,0000,0000,,Гоку
Dialogue: 0,0:11:28.09,0:11:31.06,Default,,0000,0000,0000,,Ах... Гоку!
Dialogue: 0,0:11:33.03,0:11:35.03,Default,,0000,0000,0000,,Гоку-сан!
Dialogue: 0,0:11:35.03,0:11:37.00,Default,,0000,0000,0000,,Хехе….
Dialogue: 0,0:11:39.03,0:11:42.03,Default,,0000,0000,0000,,Бұл жұмыс істеді!
Dialogue: 0,0:11:42.03,0:11:44.04,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:11:44.04,0:11:46.01,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:12:01.95,0:12:03.96,Default,,0000,0000,0000,,Хмм…
Dialogue: 0,0:12:01.95,0:12:03.96,Default,,0000,0000,0000,,Бұл қысқа дүние болды.
Dialogue: 0,0:12:03.96,0:12:06.96,Default,,0000,0000,0000,,Не... не?! ?
Dialogue: 0,0:12:03.96,0:12:06.96,Default,,0000,0000,0000,,Ұлы жын патшаға!
Dialogue: 0,0:12:06.96,0:12:09.96,Default,,0000,0000,0000,,Қалай болғанда да, сен
Dialogue: 0,0:12:06.96,0:12:09.96,Default,,0000,0000,0000,,Бұлыңғыр болуы керек! ?
Dialogue: 0,0:12:09.96,0:12:11.96,Default,,0000,0000,0000,,Хехехе….
Dialogue: 0,0:12:11.96,0:12:14.97,Default,,0000,0000,0000,,⚟ (Ұшу дыбысы)
Dialogue: 0,0:12:11.96,0:12:14.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:14.97,0:12:16.97,Default,,0000,0000,0000,,О, Гомер.
Dialogue: 0,0:12:16.97,0:12:20.97,Default,,0000,0000,0000,,Оны мына жерге қойыңыз
Dialogue: 0,0:12:16.97,0:12:20.97,Default,,0000,0000,0000,,Маған бұл туралы шамамен 100 жыл ой жүгіртіп көрейін.
Dialogue: 0,0:12:20.97,0:12:22.98,Default,,0000,0000,0000,,Иә! ? Уф….
Dialogue: 0,0:12:22.98,0:12:25.98,Default,,0000,0000,0000,,Бірақ бұл
Dialogue: 0,0:12:22.98,0:12:25.98,Default,,0000,0000,0000,,Денді өлтірген жоқ.
Dialogue: 0,0:12:25.98,0:12:28.98,Default,,0000,0000,0000,,Дұрыс! ?
Dialogue: 0,0:12:25.98,0:12:28.98,Default,,0000,0000,0000,,Мен жақсы адаммын!
Dialogue: 0,0:12:28.98,0:12:31.92,Default,,0000,0000,0000,,Жарайды, 1999 жылы жасайық.
Dialogue: 0,0:12:31.92,0:12:36.92,Default,,0000,0000,0000,,Дұрыс! Тоқта!
Dialogue: 0,0:12:36.92,0:12:39.89,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:12:41.93,0:12:43.93,Default,,0000,0000,0000,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:12:43.93,0:12:45.93,Default,,0000,0000,0000,,Қандай азап…
Dialogue: 0,0:12:43.93,0:12:45.93,Default,,0000,0000,0000,,Марва.
Dialogue: 0,0:12:45.93,0:12:47.93,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:45.93,0:12:47.93,Default,,0000,0000,0000,,Жалғыз қалма➡
Dialogue: 0,0:12:47.93,0:12:50.94,Default,,0000,0000,0000,,Неге Дегесуді де қоспайсың?
Dialogue: 0,0:12:47.93,0:12:50.94,Default,,0000,0000,0000,,Бұл жақсы. ➡
Dialogue: 0,0:12:50.94,0:12:52.91,Default,,0000,0000,0000,,Сен, жансыз құрал—
Dialogue: 0,0:12:56.94,0:12:58.94,Default,,0000,0000,0000,,(Дегес Гомардың қорқынышты дауысы)
Dialogue: 0,0:12:58.94,0:13:00.95,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:13:00.95,0:13:06.92,Default,,0000,0000,0000,,(Дарио) «Ах! Бұл жігіт мені өз құтқарушысы деп ойлайды ғой. ➡
Dialogue: 0,0:13:13.96,0:13:17.96,Default,,0000,0000,0000,,Вазаның іші кішкентай, бірақ
Dialogue: 0,0:13:13.96,0:13:17.96,Default,,0000,0000,0000,,Таң қаларлықтай ыңғайлы емес пе?
Dialogue: 0,0:13:17.96,0:13:21.97,Default,,0000,0000,0000,,Сондай-ақ шағын бақ бар.
Dialogue: 0,0:13:17.96,0:13:21.97,Default,,0000,0000,0000,,Бізде де түрлі ойындар бар.
Dialogue: 0,0:13:21.97,0:13:23.97,Default,,0000,0000,0000,,Оны бұл жерден кетіңіз!
Dialogue: 0,0:13:21.97,0:13:23.97,Default,,0000,0000,0000,,Гомер ханым➡
Dialogue: 0,0:13:23.97,0:13:26.97,Default,,0000,0000,0000,,Бірдеңе жасаңыз!
Dialogue: 0,0:13:23.97,0:13:26.97,Default,,0000,0000,0000,,Қазір….
Dialogue: 0,0:13:26.97,0:13:29.98,Default,,0000,0000,0000,,Гомер де
Dialogue: 0,0:13:26.97,0:13:29.98,Default,,0000,0000,0000,,Дегес те жойылды. ➡
Dialogue: 0,0:13:29.98,0:13:33.91,Default,,0000,0000,0000,,Келесі ұлы шайтан
Dialogue: 0,0:13:29.98,0:13:33.91,Default,,0000,0000,0000,,Не болады екен деп ойлаймын.
Dialogue: 0,0:13:33.91,0:13:36.92,Default,,0000,0000,0000,,Егер сіз болсаңыз
Dialogue: 0,0:13:33.91,0:13:36.92,Default,,0000,0000,0000,,Бұл жақсы емес пе?
Dialogue: 0,0:13:36.92,0:13:39.92,Default,,0000,0000,0000,,Біздің қарсыластарымыздан
Dialogue: 0,0:13:36.92,0:13:39.92,Default,,0000,0000,0000,,Артықшылық құқығы бар. ➡
Dialogue: 0,0:13:39.92,0:13:41.92,Default,,0000,0000,0000,,Сіз мұны бұрыннан мақсат еттіңіз, солай емес пе?
Dialogue: 0,0:13:41.92,0:13:45.93,Default,,0000,0000,0000,,Эй, сен
Dialogue: 0,0:13:41.92,0:13:45.93,Default,,0000,0000,0000,,Сіз бұлай айтатыныңызға таң қалдым.
Dialogue: 0,0:13:45.93,0:13:48.93,Default,,0000,0000,0000,,Сізге де
Dialogue: 0,0:13:45.93,0:13:48.93,Default,,0000,0000,0000,,Менің ар-ұжданым қалды деп➡
Dialogue: 0,0:13:48.93,0:13:50.93,Default,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,0:13:50.93,0:13:53.93,Default,,0000,0000,0000,,жиіркенішті
Dialogue: 0,0:13:50.93,0:13:53.93,Default,,0000,0000,0000,,Олай айтпа.
Dialogue: 0,0:13:53.93,0:13:55.94,Default,,0000,0000,0000,,Мен сізге айтайын➡
Dialogue: 0,0:13:55.94,0:13:59.94,Default,,0000,0000,0000,,Менің амбициям
Dialogue: 0,0:13:55.94,0:13:59.94,Default,,0000,0000,0000,,Ол өзгерген жоқ.
Dialogue: 0,0:13:59.94,0:14:04.94,Default,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:13:59.94,0:14:04.94,Default,,0000,0000,0000,,Бұл сыртқы дүниеден жеңілмейтін күшті жын дүние ме?
Dialogue: 0,0:14:04.94,0:14:06.95,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:06.95,0:14:08.95,Default,,0000,0000,0000,,Бірақ мен бас тартамын.
Dialogue: 0,0:14:08.95,0:14:12.95,Default,,0000,0000,0000,,Айдаһар шарларымен күшті сиқыр
Dialogue: 0,0:14:08.95,0:14:12.95,Default,,0000,0000,0000,,Қол жеткізу мүмкін емес➡
Dialogue: 0,0:14:12.95,0:14:14.95,Default,,0000,0000,0000,,Ұлы Жын патшасы болсаң ше➡
Dialogue: 0,0:14:14.95,0:14:19.96,Default,,0000,0000,0000,,Тез арада біреуге тақты беріңіз
Dialogue: 0,0:14:14.95,0:14:19.96,Default,,0000,0000,0000,,Сізді ұрлап алады.
Dialogue: 0,0:14:19.96,0:14:23.96,Default,,0000,0000,0000,,Мен көремін. Ұлы Жын патшаны жеңген адам➡
Dialogue: 0,0:14:23.96,0:14:26.97,Default,,0000,0000,0000,,Ол келесі Ұлы Жын патшасының басты үміткері.
Dialogue: 0,0:14:26.97,0:14:31.90,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:26.97,0:14:31.90,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:31.90,0:14:33.87,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:14:35.57,0:14:37.24,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:37.24,0:14:41.91,Default,,0000,0000,0000,,Ұлы жын патшаны жеңді?
Dialogue: 0,0:14:37.24,0:14:41.91,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:14:41.91,0:14:43.92,Default,,0000,0000,0000,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:14:43.92,0:14:45.92,Default,,0000,0000,0000,,Мен?
Dialogue: 0,0:14:45.92,0:14:47.92,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:47.92,0:14:49.92,Default,,0000,0000,0000,,Мен... бұл менмін!
Dialogue: 0,0:14:49.92,0:14:55.93,Default,,0000,0000,0000,,Жарайды, мен істеймін! Ұлы шайтан!
Dialogue: 0,0:14:55.93,0:14:57.93,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:55.93,0:14:57.93,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:57.93,0:14:59.93,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:14:59.93,0:15:01.93,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:14:59.93,0:15:01.93,Default,,0000,0000,0000,,Түсінесіз бе! ?
Dialogue: 0,0:15:01.93,0:15:03.94,Default,,0000,0000,0000,,Мен білемін!
Dialogue: 0,0:15:03.94,0:15:06.94,Default,,0000,0000,0000,,Құрметті Аринс, сіз➡
Dialogue: 0,0:15:06.94,0:15:08.94,Default,,0000,0000,0000,,Мен сізді Ұлы жын патшаның орынбасары етіп тағайындаймын!
Dialogue: 0,0:15:08.94,0:15:10.94,Default,,0000,0000,0000,,Не... не?! ?
Dialogue: 0,0:15:10.94,0:15:14.95,Default,,0000,0000,0000,,Мен осылай көрінсем де
Dialogue: 0,0:15:10.94,0:15:14.95,Default,,0000,0000,0000,,Адамдарға көзің өткір екен!
Dialogue: 0,0:15:14.95,0:15:16.95,Default,,0000,0000,0000,,Ха... иә?
Dialogue: 0,0:15:16.95,0:15:21.95,Default,,0000,0000,0000,,Лорд Аринстің амбициялары күшті, бірақ
Dialogue: 0,0:15:16.95,0:15:21.95,Default,,0000,0000,0000,,Бұл да жаман емес.
Dialogue: 0,0:15:21.95,0:15:24.96,Default,,0000,0000,0000,,Ми мен жоспарлау - күшті қару!
Dialogue: 0,0:15:24.96,0:15:27.96,Default,,0000,0000,0000,,Ең бастысы, ол менің туған әкем. ➡
Dialogue: 0,0:15:27.96,0:15:30.96,Default,,0000,0000,0000,,Маджин До министр!
Dialogue: 0,0:15:27.96,0:15:30.96,Default,,0000,0000,0000,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:15:30.96,0:15:33.97,Default,,0000,0000,0000,,Марва да, Нева да министр!
Dialogue: 0,0:15:30.96,0:15:33.97,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:15:33.97,0:15:36.97,Default,,0000,0000,0000,,Колт! Оу!
Dialogue: 0,0:15:33.97,0:15:36.97,Default,,0000,0000,0000,,Даналыққа, шеберлікке және сиқырлы күшке ие➡
Dialogue: 0,0:15:36.97,0:15:39.97,Default,,0000,0000,0000,,Ол Ұлы жын әлемі туралы бәрін біледі. ➡
Dialogue: 0,0:15:39.97,0:15:41.97,Default,,0000,0000,0000,,Глорио да министр!
Dialogue: 0,0:15:41.97,0:15:44.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:41.97,0:15:44.98,Default,,0000,0000,0000,,Сіз жындардың арасында сирексіз➡
Dialogue: 0,0:15:44.98,0:15:47.98,Default,,0000,0000,0000,,Ақыл-парасат пен жүректі ұстаныңыз. ➡
Dialogue: 0,0:15:47.98,0:15:51.98,Default,,0000,0000,0000,,Кадан патша да министр!
Dialogue: 0,0:15:47.98,0:15:51.98,Default,,0000,0000,0000,,О... мен?
Dialogue: 0,0:15:51.98,0:15:56.99,Default,,0000,0000,0000,,Иә. ұлы жын әлемі үшін
Dialogue: 0,0:15:51.98,0:15:56.99,Default,,0000,0000,0000,,Оқиға орнына асыққан батылдығы мақтауға тұрарлық.
Dialogue: 0,0:15:56.99,0:16:03.00,Default,,0000,0000,0000,,Бірақ мен үшінші жын әлемінен шыққан жынмын.
Dialogue: 0,0:15:56.99,0:16:03.00,Default,,0000,0000,0000,,Мен мұндайды естімеппін.
Dialogue: 0,0:16:03.00,0:16:06.00,Default,,0000,0000,0000,,Ол Үшінші жындар патшалығының бірінші министрі.
Dialogue: 0,0:16:06.00,0:16:11.00,Default,,0000,0000,0000,,Әке~! Құттықтаймыз!
Dialogue: 0,0:16:06.00,0:16:11.00,Default,,0000,0000,0000,,Хахаха!
Dialogue: 0,0:16:11.00,0:16:14.01,Default,,0000,0000,0000,,Сыртқы әлемнен келгендер.
Dialogue: 0,0:16:14.01,0:16:16.01,Default,,0000,0000,0000,,Бұл тамаша жұмыс болды.
Dialogue: 0,0:16:16.01,0:16:18.98,Default,,0000,0000,0000,,Министр болғысы келетін адам бар ма?
Dialogue: 0,0:16:21.01,0:16:23.02,Default,,0000,0000,0000,,Жоқ, біз үйге барамыз.
Dialogue: 0,0:16:23.02,0:16:26.02,Default,,0000,0000,0000,,Не? ➡
Dialogue: 0,0:16:26.02,0:16:28.02,Default,,0000,0000,0000,,Иә, онда
Dialogue: 0,0:16:26.02,0:16:28.02,Default,,0000,0000,0000,,Тағы кім министр болғысы келеді?
Dialogue: 0,0:16:28.02,0:16:30.02,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:16:30.02,0:16:35.96,Default,,0000,0000,0000,,Иә Иә Иә. Иә.
Dialogue: 0,0:16:35.96,0:16:39.97,Default,,0000,0000,0000,,Олай болса!
Dialogue: 0,0:16:35.96,0:16:39.97,Default,,0000,0000,0000,,Бұл алынбайтын кадрлық істерді аяқтайды.
Dialogue: 0,0:16:39.97,0:16:41.97,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:16:41.97,0:16:47.97,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:47.97,0:16:50.98,Default,,0000,0000,0000,,Не... бұл не?
Dialogue: 0,0:16:50.98,0:16:53.95,Default,,0000,0000,0000,,Жер
Dialogue: 0,0:16:50.98,0:16:53.95,Default,,0000,0000,0000,,Ол таңқаларлық қабілетті болуы мүмкін.
Dialogue: 0,0:16:58.98,0:17:01.99,Default,,0000,0000,0000,,Екеуі де қорқынышты
Dialogue: 0,0:16:58.98,0:17:01.99,Default,,0000,0000,0000,,Ұлы жын әлемі өмір сүруге ұмтылу➡
Dialogue: 0,0:17:01.99,0:17:03.99,Default,,0000,0000,0000,,Қолымыздан келгеннің бәрін жасайық.
Dialogue: 0,0:17:03.99,0:17:05.99,Default,,0000,0000,0000,,Иә... Иә.
Dialogue: 0,0:17:05.99,0:17:08.99,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:08.99,0:17:12.00,Default,,0000,0000,0000,,Хухаха! Алақай!
Dialogue: 0,0:17:12.00,0:17:16.00,Default,,0000,0000,0000,,Жаңа ұлы жын патша - Куу патша.
Dialogue: 0,0:17:16.00,0:17:18.97,Default,,0000,0000,0000,,Менің шағымданатын ештеңем жоқ.
Dialogue: 0,0:17:30.02,0:17:32.95,Default,,0000,0000,0000,,Бұлма-сан
Dialogue: 0,0:17:30.02,0:17:32.95,Default,,0000,0000,0000,,Бұл уәде етілген Magilight.
Dialogue: 0,0:17:32.95,0:17:36.96,Default,,0000,0000,0000,,Ах. Сонша
Dialogue: 0,0:17:32.95,0:17:36.96,Default,,0000,0000,0000,,Оның көп болуы міндетті емес.
Dialogue: 0,0:17:36.96,0:17:38.96,Default,,0000,0000,0000,,Бірақ рахмет.
Dialogue: 0,0:17:38.96,0:17:40.96,Default,,0000,0000,0000,,Гомар сарайында
Dialogue: 0,0:17:38.96,0:17:40.96,Default,,0000,0000,0000,,Қоймадағы➡
Dialogue: 0,0:17:40.96,0:17:43.96,Default,,0000,0000,0000,,Мен оны алдым.
Dialogue: 0,0:17:40.96,0:17:43.96,Default,,0000,0000,0000,,Аха….
Dialogue: 0,0:17:43.96,0:17:46.97,Default,,0000,0000,0000,,Үйге бара жатқанда тамақтаныңыз.
Dialogue: 0,0:17:43.96,0:17:46.97,Default,,0000,0000,0000,,Шоколадты печенье!
Dialogue: 0,0:17:46.97,0:17:50.97,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:17:46.97,0:17:50.97,Default,,0000,0000,0000,,Мен оны жей алмаймын.
Dialogue: 0,0:17:50.97,0:17:54.97,Default,,0000,0000,0000,,Боқ...
Dialogue: 0,0:17:50.97,0:17:54.97,Default,,0000,0000,0000,,Егер күресуді жалғастыра берсек, біз жеңер едік!
Dialogue: 0,0:17:54.97,0:17:56.98,Default,,0000,0000,0000,,Сіз өте табандысыз~ Мен түсіндім.
Dialogue: 0,0:17:56.98,0:18:00.98,Default,,0000,0000,0000,,Сен үндемедің!
Dialogue: 0,0:17:56.98,0:18:00.98,Default,,0000,0000,0000,,Бұл өзгеріс!
Dialogue: 0,0:18:00.98,0:18:04.98,Default,,0000,0000,0000,,Супер
Dialogue: 0,0:18:00.98,0:18:04.98,Default,,0000,0000,0000,,Төрт
Dialogue: 0,0:18:00.98,0:18:04.98,Default,,0000,0000,0000,,Сіз Super Saiyan 4 туралы айтып отырсыз ба?
Dialogue: 0,0:18:04.98,0:18:09.99,Default,,0000,0000,0000,,Себебі Буу керемет болды.
Dialogue: 0,0:18:04.98,0:18:09.99,Default,,0000,0000,0000,,Одан кейін арнайы дайындықтан өттім.
Dialogue: 0,0:18:09.99,0:18:12.99,Default,,0000,0000,0000,,Бұл жұмыс істей ме?
Dialogue: 0,0:18:09.99,0:18:12.99,Default,,0000,0000,0000,,Мен өзіме сенімді емес едім.
Dialogue: 0,0:18:12.99,0:18:17.00,Default,,0000,0000,0000,,Супер
Dialogue: 0,0:18:12.99,0:18:17.00,Default,,0000,0000,0000,,Хмф! Супер сайян сияқты
Dialogue: 0,0:18:12.99,0:18:17.00,Default,,0000,0000,0000,,Бұл жеңіл сатылым.
Dialogue: 0,0:18:17.00,0:18:19.00,Default,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:18:17.00,0:18:19.00,Default,,0000,0000,0000,,Үш
Dialogue: 0,0:18:17.00,0:18:19.00,Default,,0000,0000,0000,,Сіз небәрі 3 жаста болсаңыз да.
Dialogue: 0,0:18:19.00,0:18:21.00,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:21.00,0:18:25.00,Default,,0000,0000,0000,,Аузыңды жап! Сол түрлендіру... түсінемін...
Dialogue: 0,0:18:25.00,0:18:30.01,Default,,0000,0000,0000,,Бару
Dialogue: 0,0:18:25.00,0:18:30.01,Default,,0000,0000,0000,,Ultra Vegeta №1!
Dialogue: 0,0:18:25.00,0:18:30.01,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:18:30.01,0:18:34.95,Default,,0000,0000,0000,,Денде.
Dialogue: 0,0:18:30.01,0:18:34.95,Default,,0000,0000,0000,,Жындар әлемінде қайтадан өмір сүргіңіз келе ме? ➡
Dialogue: 0,0:18:34.95,0:18:37.95,Default,,0000,0000,0000,,Енді сіз жайлы өмір сүруіңіз керек.
Dialogue: 0,0:18:37.95,0:18:42.96,Default,,0000,0000,0000,,Өкінішке орай, мен үшін
Dialogue: 0,0:18:37.95,0:18:42.96,Default,,0000,0000,0000,,Біздің жердегі рөліміз бар.
Dialogue: 0,0:18:42.96,0:18:44.96,Default,,0000,0000,0000,,Хмм... сіз де?
Dialogue: 0,0:18:44.96,0:18:47.96,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:18:47.96,0:18:49.96,Default,,0000,0000,0000,,
Dialogue: 0,0:18:47.96,0:18:49.96,Default,,0000,0000,0000,,Себеп
Dialogue: 0,0:18:47.96,0:18:49.96,Default,,0000,0000,0000,,Бірақ біз Намек планетасынан айырылдық➡
Dialogue: 0,0:18:49.96,0:18:52.97,Default,,0000,0000,0000,,Қаңғыбас халыққа айналу
Dialogue: 0,0:18:49.96,0:18:52.97,Default,,0000,0000,0000,,Барлық Намекиндерге➡
Dialogue: 0,0:18:52.97,0:18:56.97,Default,,0000,0000,0000,,Әңгімелесейік.
Dialogue: 0,0:18:52.97,0:18:56.97,Default,,0000,0000,0000,,Сіздің көңіліңізден шығатынына сенімдімін.
Dialogue: 0,0:18:56.97,0:19:00.97,Default,,0000,0000,0000,,Түсіндім... бұл жақсы. ➡
Dialogue: 0,0:19:00.97,0:19:04.94,Default,,0000,0000,0000,,Мен оны асыға күтемін.
Dialogue: 0,0:19:06.98,0:19:09.98,Default,,0000,0000,0000,,Гоку дайындығы ОК.
Dialogue: 0,0:19:09.98,0:19:13.99,Default,,0000,0000,0000,,О.
Dialogue: 0,0:19:09.98,0:19:13.99,Default,,0000,0000,0000,,Гоку-сан, қарашы. ➡
Dialogue: 0,0:19:13.99,0:19:17.99,Default,,0000,0000,0000,,Жолдағы тесік өткенде
Dialogue: 0,0:19:13.99,0:19:17.99,Default,,0000,0000,0000,,Жел газды аспанға жеткізеді➡
Dialogue: 0,0:19:17.99,0:19:21.99,Default,,0000,0000,0000,,Ауа жеңілдей бастады.
Dialogue: 0,0:19:21.99,0:19:26.00,Default,,0000,0000,0000,,Жоқ, бірақ
Dialogue: 0,0:19:21.99,0:19:26.00,Default,,0000,0000,0000,,Сыртқы дүниедегі барлық адамдарға➡
Dialogue: 0,0:19:26.00,0:19:28.00,Default,,0000,0000,0000,,Бұл маған шынымен көмектесті.
Dialogue: 0,0:19:28.00,0:19:31.94,Default,,0000,0000,0000,,Сізге шын жүректен алғыс айтқым келеді.
Dialogue: 0,0:19:31.94,0:19:33.94,Default,,0000,0000,0000,,Мен жіберемін.
Dialogue: 0,0:19:33.94,0:19:36.94,Default,,0000,0000,0000,,Рахмет. Сонда барамыз ба?
Dialogue: 0,0:19:33.94,0:19:36.94,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:19:36.94,0:19:38.91,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:19:41.95,0:19:45.95,Default,,0000,0000,0000,,«Бастап көріп, не боларын көрейік» дегендей. Хмм…
Dialogue: 0,0:19:41.95,0:19:45.95,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:19:45.95,0:19:49.96,Default,,0000,0000,0000,,Жаман нәрсе болса ше?
Dialogue: 0,0:19:45.95,0:19:49.96,Default,,0000,0000,0000,,Маған тағы да көмектес!
Dialogue: 0,0:19:49.96,0:19:52.93,Default,,0000,0000,0000,,Біреудің санасын басып алуға ұқсас күш—
Dialogue: 0,0:19:54.96,0:19:57.93,Default,,0000,0000,0000,,Сонда кездескенше!
Dialogue: 0,0:20:05.97,0:20:09.98,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:09.98,0:20:12.98,Default,,0000,0000,0000,,Жақында кездескенше!
Dialogue: 0,0:20:12.98,0:20:20.99,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:20.99,0:20:30.96,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:36.93,0:21:38.93,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:21:38.93,0:21:41.93,Default,,0000,0000,0000,,Сәлем, министр Грилот.
Dialogue: 0,0:21:41.93,0:21:43.94,Default,,0000,0000,0000,,Ал егер!
Dialogue: 0,0:21:41.93,0:21:43.94,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:21:43.94,0:21:46.94,Default,,0000,0000,0000,,Ах... иә.
Dialogue: 0,0:21:46.94,0:21:49.94,Default,,0000,0000,0000,,Дәрілік қате
Dialogue: 0,0:21:46.94,0:21:49.94,Default,,0000,0000,0000,,Мен дәрілік жәндіктерді сатып алған дүкен
Dialogue: 0,0:21:46.94,0:21:49.94,Default,,0000,0000,0000,,болды, солай ма?
Dialogue: 0,0:21:49.94,0:21:53.95,Default,,0000,0000,0000,,Бір сәтке келіңіз.
Dialogue: 0,0:21:49.94,0:21:53.95,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:21:53.95,0:21:56.95,Default,,0000,0000,0000,,Сензу
Dialogue: 0,0:21:53.95,0:21:56.95,Default,,0000,0000,0000,,Соңғы уақытта сензу бұршақтары азайып кетті.
Dialogue: 0,0:21:56.95,0:22:01.95,Default,,0000,0000,0000,,Фуккасуши
Dialogue: 0,0:21:56.95,0:22:01.95,Default,,0000,0000,0000,,Сол тірілуші жәндік дәрілік жәндік.
Dialogue: 0,0:21:56.95,0:22:01.95,Default,,0000,0000,0000,,Көп сатып алу туралы ойланыңыз.
Dialogue: 0,0:22:01.95,0:22:03.92,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:22:08.96,0:22:11.96,Default,,0000,0000,0000,,Сәлеметсіз бе.
Dialogue: 0,0:22:08.96,0:22:11.96,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:22:11.96,0:22:14.97,Default,,0000,0000,0000,,Әй, апай.
Dialogue: 0,0:22:11.96,0:22:14.97,Default,,0000,0000,0000,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:22:14.97,0:22:18.97,Default,,0000,0000,0000,,Иә? Сіз...
Dialogue: 0,0:22:18.97,0:22:21.97,Default,,0000,0000,0000,,Мүмкін сіз➡
Dialogue: 0,0:22:21.97,0:22:25.98,Default,,0000,0000,0000,,Мен бір күні емдік жәндік сатып алдым.
Dialogue: 0,0:22:21.97,0:22:25.98,Default,,0000,0000,0000,,Сен бала емессің бе?
Dialogue: 0,0:22:25.98,0:22:28.98,Default,,0000,0000,0000,,А, бұл пайдалы болды.
Dialogue: 0,0:22:28.98,0:22:30.92,Default,,0000,0000,0000,,Өсу тым жылдам емес пе?
Dialogue: 0,0:22:30.92,0:22:35.92,Default,,0000,0000,0000,,Әлде бұл дәрілік жәндіктердің жанама әсері шығар?
Dialogue: 0,0:22:30.92,0:22:35.92,Default,,0000,0000,0000,,Ол соншалықты үлкен болды ...
Dialogue: 0,0:22:35.92,0:22:37.92,Default,,0000,0000,0000,,Хехе, жоқ.
Dialogue: 0,0:22:37.92,0:22:39.93,Default,,0000,0000,0000,,Әдемі. ➡
Dialogue: 0,0:22:39.93,0:22:42.93,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:42.93,0:22:44.93,Default,,0000,0000,0000,,Жәндіктер! ? Ей!
Dialogue: 0,0:22:44.93,0:22:48.93,Default,,0000,0000,0000,,Бұл жиіркенішті!
Dialogue: 0,0:22:44.93,0:22:48.93,Default,,0000,0000,0000,,Сіз осылай жақсы жеуге болады.
Dialogue: 0,0:22:48.93,0:22:53.94,Default,,0000,0000,0000,,Тұр... мен қайдамын?
Dialogue: 0,0:22:48.93,0:22:53.94,Default,,0000,0000,0000,,Дәрілік жәндіктердің әсері ерекше.
Dialogue: 0,0:22:53.94,0:22:55.94,Default,,0000,0000,0000,,
Dialogue: 0,0:22:53.94,0:22:55.94,Default,,0000,0000,0000,,Қате
Dialogue: 0,0:22:53.94,0:22:55.94,Default,,0000,0000,0000,,Ачичибуг күйікке қарсы тиімді. ➡
Dialogue: 0,0:22:55.94,0:22:58.94,Default,,0000,0000,0000,,Қоңыз
Dialogue: 0,0:22:55.94,0:22:58.94,Default,,0000,0000,0000,,Теріңізді жылтыр ететін сұлу жәндік.
Dialogue: 0,0:22:58.94,0:23:00.95,Default,,0000,0000,0000,,Сұлулық қатесі дегеніміз не?
Dialogue: 0,0:23:00.95,0:23:04.95,Default,,0000,0000,0000,,Егер сіз біреуін жесеңіз
Dialogue: 0,0:23:00.95,0:23:04.95,Default,,0000,0000,0000,,Теріңіз 10 жасқа жасарған көрінеді.
Dialogue: 0,0:23:04.95,0:23:06.95,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:23:06.95,0:23:08.95,Default,,0000,0000,0000,,Әзірше маған бәрін бер!
Dialogue: 0,0:23:08.95,0:23:11.96,Default,,0000,0000,0000,,Күрсін... Уау. ➡
Dialogue: 0,0:23:11.96,0:23:14.96,Default,,0000,0000,0000,,Сәлем. иә? ➡
Dialogue: 0,0:23:14.96,0:23:17.96,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:23:14.96,0:23:17.96,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:23:17.96,0:23:19.97,Default,,0000,0000,0000,,Оф….
Dialogue: 0,0:23:19.97,0:23:23.97,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:23:19.97,0:23:23.97,Default,,0000,0000,0000,,Әй, апай, мінекей!
Dialogue: 0,0:23:23.97,0:23:26.97,Default,,0000,0000,0000,,О
Dialogue: 0,0:23:23.97,0:23:26.97,Default,,0000,0000,0000,,Оны шайтанның үшінші көзі➡ дейді
Dialogue: 0,0:23:26.97,0:23:28.97,Default,,0000,0000,0000,,Бұл үшінші көз.
Dialogue: 0,0:23:28.97,0:23:30.91,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:23:30.91,0:23:32.91,Default,,0000,0000,0000,,Маңдайға жаққанда
Dialogue: 0,0:23:30.91,0:23:32.91,Default,,0000,0000,0000,,Керемет күш➡
Dialogue: 0,0:23:32.91,0:23:35.91,Default,,0000,0000,0000,,Бұл жұмыс істейтін сияқты.
Dialogue: 0,0:23:35.91,0:23:40.92,Default,,0000,0000,0000,,Үш зат келді, бұл күдікті.
Dialogue: 0,0:23:35.91,0:23:40.92,Default,,0000,0000,0000,,Өйткені бағасы біршама жоғары➡
Dialogue: 0,0:23:40.92,0:23:43.92,Default,,0000,0000,0000,,Мен баяғыда біреуін ғана саттым. ➡
Dialogue: 0,0:23:43.92,0:23:47.93,Default,,0000,0000,0000,,Егер сіз оны сатып алғыңыз келсе
Dialogue: 0,0:23:43.92,0:23:47.93,Default,,0000,0000,0000,,Мен оны одан да арзандатамын.
Dialogue: 0,0:23:47.93,0:23:50.90,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:23:52.40,0:23:58.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory