Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.77,0:00:06.80,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:00:06.80,0:00:10.27,Default,,0,0,0,,Сіз бас тартқыңыз келмейді ме? Өлім тағдырынан құтылу үшін.
Dialogue: 0,0:00:22.28,0:00:25.25,Default,,0,0,0,,Суо өз тілегін орындай алса➡
Dialogue: 0,0:00:25.25,0:00:27.26,Default,,0,0,0,,Ол өледі.
Dialogue: 0,0:00:30.26,0:00:32.26,Default,,0,0,0,,Мен де Суудың өлгенін қаламаймын.
Dialogue: 0,0:02:33.72,0:02:36.22,Default,,0,0,0,,Мұнда ештеңе жоқ...
Dialogue: 0,0:02:45.23,0:02:47.70,Default,,0,0,0,,Мен үшін ештеңе...
Dialogue: 0,0:02:49.23,0:02:51.20,Default,,0,0,0,,Суо!
Dialogue: 0,0:02:53.27,0:02:56.74,Default,,0,0,0,,Сіз не істеп жатырсыз? Маған ұнамайды...қалай болса?
Dialogue: 0,0:02:59.71,0:03:01.71,Default,,0,0,0,,Жел Бұл жақсы сезінеді.
Dialogue: 0,0:03:10.25,0:03:12.25,Default,,0,0,0,,Бүгін соңғы жекпе-жек.
Dialogue: 0,0:03:12.25,0:03:16.26,Default,,0,0,0,,Кім жеңсе, мен немесе сен, оның тілегі орындалады.
Dialogue: 0,0:03:16.26,0:03:18.73,Default,,0,0,0,,Бар күшімізбен бір-бірімізбен күресейік.
Dialogue: 0,0:03:20.23,0:03:22.23,Default,,0,0,0,,Мен мұны бұрын айтуым керек еді➡
Dialogue: 0,0:03:22.23,0:03:24.77,Default,,0,0,0,,Менің тілегім жоқ.
Dialogue: 0,0:03:24.77,0:03:28.74,Default,,0,0,0,,Онда неге Тағдыр соғысына қатысып жатырсың?
Dialogue: 0,0:03:28.74,0:03:32.21,Default,,0,0,0,,Мен жай ғана тағдырыма ердім.
Dialogue: 0,0:03:32.21,0:03:34.21,Default,,0,0,0,,Өзіңізді қалай сезінесіз...?
Dialogue: 0,0:03:34.21,0:03:36.21,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:03:38.75,0:03:41.75,Default,,0,0,0,,Мен әкемнің полиция қызметкері екенін айттым ба?
Dialogue: 0,0:03:43.75,0:03:46.72,Default,,0,0,0,,Менің әкем көптеген оқиғалар мен оқыс оқиғаларға қатысқан➡
Dialogue: 0,0:03:46.72,0:03:49.26,Default,,0,0,0,,Мен зардап шеккен адамдарды көрдім.
Dialogue: 0,0:03:49.26,0:03:52.23,Default,,0,0,0,,Міне, мен бұрын айтқанмын.
Dialogue: 0,0:03:53.23,0:03:55.23,Default,,0,0,0,,Ашудың да шегі бар➡
Dialogue: 0,0:03:55.23,0:03:57.73,Default,,0,0,0,,Қайғыға шек жоқ.
Dialogue: 0,0:03:57.73,0:03:59.73,Default,,0,0,0,,Ауыртпаққа шыдасаң да➡
Dialogue: 0,0:03:59.73,0:04:01.70,Default,,0,0,0,,Қайғыға шыдай алмаймын.
Dialogue: 0,0:04:03.71,0:04:06.24,Default,,0,0,0,,Ішіңізде бірдеңе бар екеніне сенімдімін...
Dialogue: 0,0:04:06.24,0:04:08.24,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:04:08.24,0:04:10.25,Default,,0,0,0,,Шынымен бе? Менде сен бар➡
Dialogue: 0,0:04:10.25,0:04:13.72,Default,,0,0,0,,Мен бірдеңе іздеп жүргендей сезінемін.
Dialogue: 0,0:04:13.72,0:04:17.72,Default,,0,0,0,,Сен маған неге көңіл бөлесің? Сіз қандайсыз?
Dialogue: 0,0:04:17.72,0:04:19.72,Default,,0,0,0,,Мен мұны бұрын айттым➡
Dialogue: 0,0:04:19.72,0:04:22.72,Default,,0,0,0,,Мен сенімен дос болғым келеді.
Dialogue: 0,0:04:22.72,0:04:25.26,Default,,0,0,0,,Сондықтан мен сенімен дұрыс күресемін➡
Dialogue: 0,0:04:25.26,0:04:28.23,Default,,0,0,0,,Мен сені тура соғып, жеңгім келеді!
Dialogue: 0,0:04:29.26,0:04:32.23,Default,,0,0,0,,Оның үстіне мен өзгерткім келген тағдырлардың бәрін өзгертемін!
Dialogue: 0,0:04:34.24,0:04:36.71,Default,,0,0,0,,Ештеңе өзгермейді.
Dialogue: 0,0:04:42.71,0:04:45.21,Default,,0,0,0,,Мен байсалдымын, Суо!
Dialogue: 0,0:04:50.75,0:04:52.72,Default,,0,0,0,,Ақина-сенпай!
Dialogue: 0,0:04:52.72,0:04:55.72,Default,,0,0,0,,Сайто мырза? Не болды? Мен үрейленіп тұрмын.
Dialogue: 0,0:04:55.72,0:04:57.73,Default,,0,0,0,,Білсем де!
Dialogue: 0,0:04:58.73,0:05:00.70,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:05:03.23,0:05:05.23,Default,,0,0,0,,Егер мен ұтылып қалсам➡
Dialogue: 0,0:05:05.23,0:05:07.20,Default,,0,0,0,,Сіз қатыса аласыз.
Dialogue: 0,0:05:08.24,0:05:10.24,Default,,0,0,0,,Өйткені мен сенің өлгеніңді қаламаймын.
Dialogue: 0,0:05:14.21,0:05:16.75,Default,,0,0,0,,Е...Мм, Сайто-сан?
Dialogue: 0,0:05:16.75,0:05:20.75,Default,,0,0,0,,Мен де ағамның өлгенін қаламаймын...
Dialogue: 0,0:05:20.75,0:05:23.22,Default,,0,0,0,,Өлме.
Dialogue: 0,0:05:23.22,0:05:25.22,Default,,0,0,0,,Un.
Dialogue: 0,0:05:25.22,0:05:27.22,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:05:29.22,0:05:31.76,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:05:31.76,0:05:35.76,Default,,0,0,0,,Акина Микото-самамен қол алысып жатыр~!
Dialogue: 0,0:05:39.80,0:05:42.74,Default,,0,0,0,,Сіз бұрынғыдай бос емессіз.
Dialogue: 0,0:05:42.74,0:05:45.74,Default,,0,0,0,,Тағы кездескенше.
Dialogue: 0,0:05:45.74,0:05:47.71,Default,,0,0,0,,Аа... дұрыс.
Dialogue: 0,0:05:48.71,0:05:50.75,Default,,0,0,0,,Ертең боссың ба?
Dialogue: 0,0:05:50.75,0:05:52.75,Default,,0,0,0,,Бос уақытыңыз болса, менімен караокеге барғыңыз келе ме?
Dialogue: 0,0:05:53.72,0:05:56.22,Default,,0,0,0,,Жарайды, бірақ... Шешілді!
Dialogue: 0,0:05:56.22,0:05:58.22,Default,,0,0,0,,Шөлдегенше ән саламын!
Dialogue: 0,0:05:58.22,0:06:00.22,Default,,0,0,0,,Ертең кездескенше!
Dialogue: 0,0:06:03.73,0:06:06.70,Default,,0,0,0,,О... мүлде! Бұл уәде!
Dialogue: 0,0:06:12.77,0:06:16.74,Default,,0,0,0,,Мен түсінбеймін... Мен ештеңе түсінбеймін!
Dialogue: 0,0:06:16.74,0:06:20.24,Default,,0,0,0,,Маған келме? Акидің еркелігі ақымақ!
Dialogue: 0,0:06:20.24,0:06:22.74,Default,,0,0,0,,Сіз міндетті түрде барасыз! Шебер...
Dialogue: 0,0:06:22.74,0:06:25.21,Default,,0,0,0,,Бенбен мырза, сіз маған біраздан бері телефон соғып жатырсыз.
Dialogue: 0,0:06:25.21,0:06:28.22,Default,,0,0,0,,Е...аааа!
Dialogue: 0,0:06:34.72,0:06:37.23,Default,,0,0,0,,Адамдардың жабысқысы келетін нәрсесі болған кезде➡
Dialogue: 0,0:06:37.23,0:06:39.26,Default,,0,0,0,,Құдайды жарат.
Dialogue: 0,0:06:39.26,0:06:42.23,Default,,0,0,0,,Өз санасын алдау үшін жасалған алдау.
Dialogue: 0,0:06:44.73,0:06:46.77,Default,,0,0,0,,Күн, таулар➡
Dialogue: 0,0:06:46.77,0:06:50.74,Default,,0,0,0,,Біз барлық нәрсені қолайлы кезде ғана Құдай дейміз.
Dialogue: 0,0:06:50.74,0:06:53.71,Default,,0,0,0,,Құдай белгілеген тағдыр да солай.
Dialogue: 0,0:06:53.71,0:06:56.31,Default,,0,0,0,,Бірақ тағдыр болса➡
Dialogue: 0,0:06:56.31,0:06:58.78,Default,,0,0,0,,Дүниенің мейірімсіздігі сондықтан.
Dialogue: 0,0:06:59.71,0:07:01.75,Default,,0,0,0,,Тағдыр соғысы.
Dialogue: 0,0:07:01.75,0:07:03.72,Default,,0,0,0,,Тағдырын өзгерткісі келетіндер➡
Dialogue: 0,0:07:03.72,0:07:05.72,Default,,0,0,0,,Өз тілектеріңізді ескере отырып күресіңіз.
Dialogue: 0,0:07:05.72,0:07:07.76,Default,,0,0,0,,Бірақ аман қалуыңыз үшін➡
Dialogue: 0,0:07:07.76,0:07:11.73,Default,,0,0,0,,Біз Суохтан жеңілу тағдырымызды өзгертуіміз керек.
Dialogue: 0,0:07:11.73,0:07:15.23,Default,,0,0,0,,Бұл тонкты қажет етеді! Фухаха...!
Dialogue: 0,0:07:16.23,0:07:18.73,Default,,0,0,0,,Сонда да мен болашақты өзгертемін.
Dialogue: 0,0:07:18.73,0:07:21.24,Default,,0,0,0,,Міне.
Dialogue: 0,0:07:21.24,0:07:23.24,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:23.24,0:07:25.24,Default,,0,0,0,,Қауіпті көздер.
Dialogue: 0,0:07:25.24,0:07:29.24,Default,,0,0,0,,Өйткені, ғажайып пен тыйымның арасында жіңішке сызық бар.
Dialogue: 0,0:07:31.25,0:07:34.22,Default,,0,0,0,,Бүгінгі түнгі жекпе-жекті асыға күтемін.
Dialogue: 0,0:07:42.72,0:07:44.76,Default,,0,0,0,,Міне таяп қалды.
Dialogue: 0,0:07:44.76,0:07:47.73,Default,,0,0,0,,Сіз өліп қалсаңыз да, жолдың соңына дейін барасыз ба?
Dialogue: 0,0:07:47.73,0:07:50.27,Default,,0,0,0,,Мен оны қолдаймын деп шештім.
Dialogue: 0,0:07:50.27,0:07:53.74,Default,,0,0,0,,Оны соңына дейін көру ересек адамның міндеті.
Dialogue: 0,0:07:53.74,0:07:55.74,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:55.74,0:07:57.74,Default,,0,0,0,,...
Dialogue: 0,0:07:57.74,0:08:00.74,Default,,0,0,0,,Тағдырдың төңкерілген сәті.
Dialogue: 0,0:08:17.23,0:08:19.73,Default,,0,0,0,,Бауырым, шығасың ба?
Dialogue: 0,0:08:22.26,0:08:25.23,Default,,0,0,0,,Мен үйге кеш келемін, сондықтан тоңазытқыштан бұқтырылған бұқтырма жеп ал.
Dialogue: 0,0:08:25.23,0:08:27.24,Default,,0,0,0,,Толық емес жұмыс уақыты?
Dialogue: 0,0:08:27.24,0:08:29.24,Default,,0,0,0,,Ой, кешіріңіз, егер бұл сізді ренжітсе.
Dialogue: 0,0:08:29.24,0:08:32.21,Default,,0,0,0,,～～
Dialogue: 0,0:08:35.21,0:08:37.21,Default,,0,0,0,,...
Dialogue: 0,0:08:37.21,0:08:39.25,Default,,0,0,0,,Бұл да анық.
Dialogue: 0,0:08:39.25,0:08:41.22,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:08:42.25,0:08:44.22,Default,,0,0,0,,Қош келдіңіз!
Dialogue: 0,0:08:45.22,0:08:47.22,Default,,0,0,0,,Мен барамын.
Dialogue: 0,0:09:01.37,0:09:04.37,Default,,0,0,0,,｟Бәрі осы жекпе-жекте шешіледі. ｠
Dialogue: 0,0:10:05.23,0:10:07.20,Default,,0,0,0,,Аки-кун!
Dialogue: 0,0:10:11.24,0:10:14.24,Default,,0,0,0,,Неліктен...? Шынымен сен...
Dialogue: 0,0:10:17.28,0:10:19.75,Default,,0,0,0,,Сәттілік! Жеңіске кел!
Dialogue: 0,0:10:20.72,0:10:23.72,Default,,0,0,0,,Нао-сенпай...Сәлем!
Dialogue: 0,0:10:26.22,0:10:28.76,Default,,0,0,0,,Бұл соңғы тағдыр соғысы!
Dialogue: 0,0:10:28.76,0:10:32.23,Default,,0,0,0,,Бұл жекпе-жектің жеңімпазы өз тілегін орындай алады.
Dialogue: 0,0:10:32.23,0:10:34.73,Default,,0,0,0,,...
Dialogue: 0,0:10:34.73,0:10:36.73,Default,,0,0,0,,Картаңызды көтеріңіз!
Dialogue: 0,0:10:36.73,0:10:39.73,Default,,0,0,0,,...
Dialogue: 0,0:10:39.73,0:10:41.74,Default,,0,0,0,,Тағдыр!
Dialogue: 0,0:10:41.74,0:10:43.71,Default,,0,0,0,,Осы қолында.
Dialogue: 0,0:10:43.71,0:10:45.71,Default,,0,0,0,,Құдай!
Dialogue: 0,0:10:47.21,0:10:49.24,Default,,0,0,0,,Уақыттың толықтығы!
Dialogue: 0,0:10:49.24,0:10:53.25,Default,,0,0,0,,Тағдырымызды өзгертетін соңғы шайқасты бастайық!
Dialogue: 0,0:10:55.72,0:10:57.72,Default,,0,0,0,,Ал... Хикари-чан ше?
Dialogue: 0,0:10:57.72,0:10:59.72,Default,,0,0,0,,А... үлкені.
Dialogue: 0,0:10:59.72,0:11:01.72,Default,,0,0,0,,Қалай айту керек...
Dialogue: 0,0:11:01.72,0:11:03.69,Default,,0,0,0,,Ол да келе жатыр.
Dialogue: 0,0:11:05.23,0:11:07.23,Default,,0,0,0,,бастайық.
Dialogue: 0,0:11:07.23,0:11:09.23,Default,,0,0,0,,Ах.
Dialogue: 0,0:11:09.23,0:11:11.20,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:11:14.24,0:11:16.20,Default,,0,0,0,,Амбиция қанаттары Соел!
Dialogue: 0,0:11:16.20,0:11:18.21,Default,,0,0,0,,Қуыстың мализиясы.
Dialogue: 0,0:11:18.21,0:11:20.21,Default,,0,0,0,,Менің кезегім ➡
Dialogue: 0,0:11:20.21,0:11:22.24,Default,,0,0,0,,...
Dialogue: 0,0:11:22.24,0:11:26.71,Default,,0,0,0,,Және энергия генераторын орнатыңыз! Соңына бұрылу.
Dialogue: 0,0:11:26.71,0:11:28.68,Default,,0,0,0,,Менің кезегім... жеребе.
Dialogue: 0,0:11:28.68,0:11:30.75,Default,,0,0,0,,Шұңқыр жыртқышқа мініңіз.
Dialogue: 0,0:11:30.75,0:11:34.22,Default,,0,0,0,,Генераторды орнатыңыз және энергияны зарядтаңыз.
Dialogue: 0,0:11:35.22,0:11:37.73,Default,,0,0,0,,Раптормен шабуыл. Күзетші жоқ.
Dialogue: 0,0:11:38.73,0:11:40.70,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім➡
Dialogue: 0,0:11:40.70,0:11:42.76,Default,,0,0,0,,Азенсиорға барыңыз!
Dialogue: 0,0:11:42.76,0:11:45.73,Default,,0,0,0,,Soul Ventesta және жан зарядын шақырыңыз.
Dialogue: 0,0:11:46.77,0:11:49.27,Default,,0,0,0,,｟Триггер артық…бағалмайды➡
Dialogue: 0,0:11:49.27,0:11:51.21,Default,,0,0,0,,Ауысу…. ｠
Dialogue: 0,0:11:51.21,0:11:53.71,Default,,0,0,0,,Нилберис пен Антенаны шақырыңыз.
Dialogue: 0,0:11:53.71,0:11:56.24,Default,,0,0,0,,Бентестамен шабуыл! күзетші.
Dialogue: 0,0:11:56.24,0:11:59.71,Default,,0,0,0,,Азеншиормен шабуыл! Күзетші жоқ.
Dialogue: 0,0:11:59.71,0:12:03.22,Default,,0,0,0,,Нилбериспен шабуыл! күзетші.
Dialogue: 0,0:12:03.22,0:12:05.19,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім➡
Dialogue: 0,0:12:05.19,0:12:07.69,Default,,0,0,0,,Бос азуға міну.
Dialogue: 0,0:12:07.69,0:12:09.72,Default,,0,0,0,,Палубаның жоғарғы 3 картасынан таңдау үшін дағдыларды қолданыңыз➡
Dialogue: 0,0:12:09.72,0:12:12.69,Default,,0,0,0,,Жаныңызға 2 картаны салып, 1 картаны салыңыз.
Dialogue: 0,0:12:12.69,0:12:15.20,Default,,0,0,0,,Evoque алхимикіне қоңырау шалыңыз.
Dialogue: 0,0:12:15.20,0:12:18.20,Default,,0,0,0,,Азумен шабуыл. Күзетші жоқ.
Dialogue: 0,0:12:18.20,0:12:20.20,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:12:20.20,0:12:22.84,Default,,0,0,0,,Аки-кун және Йоцуги-кун….
Dialogue: 0,0:12:22.84,0:12:25.71,Default,,0,0,0,,Жекпе-жек мүлдем қарама-қарсы сезімде өрбиді.
Dialogue: 0,0:12:25.71,0:12:28.18,Default,,0,0,0,,Осы жерден бастайық...сенпай.
Dialogue: 0,0:12:29.24,0:12:33.25,Default,,0,0,0,,Менің кезегім! Құтқару қанаттары көктен осында!
Dialogue: 0,0:12:33.25,0:12:36.72,Default,,0,0,0,,Резаэльдің ғажайып тағдырына мініңіз!
Dialogue: 0,0:12:43.22,0:12:46.69,Default,,0,0,0,,Садиге қоңырау шалыңыз және оның шеберлігін пайдаланып, 1 картаны тартыңыз➡
Dialogue: 0,0:12:46.69,0:12:48.70,Default,,0,0,0,,Ауырсынуды басатын дәрі шақырыңыз!
Dialogue: 0,0:12:48.70,0:12:51.23,Default,,0,0,0,,Нилбериспен шабуыл! күзетші.
Dialogue: 0,0:12:51.23,0:12:55.24,Default,,0,0,0,,Нилберис шеберлігі: Өзіңді жаныңа салып, 1 картаны сал!
Dialogue: 0,0:12:55.24,0:12:57.21,Default,,0,0,0,,Ауырсынуды басатын дағдыларды жалғастырыңыз!
Dialogue: 0,0:12:57.21,0:12:59.24,Default,,0,0,0,,Жан жаруы 1 карта➡
Dialogue: 0,0:12:59.24,0:13:02.21,Default,,0,0,0,,Зейнетке шығып, 1 картаны тартыңыз!
Dialogue: 0,0:13:02.21,0:13:04.75,Default,,0,0,0,,Резаэльмен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:13:04.75,0:13:08.68,Default,,0,0,0,,Дағды іске қосылды! Drop Nilberis мен Pro Robiге қоңырау шалыңыз!
Dialogue: 0,0:13:08.68,0:13:10.69,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:13:10.69,0:13:13.19,Default,,0,0,0,,Бірінші тексеру….
Dialogue: 0,0:13:13.19,0:13:15.19,Default,,0,0,0,,Екінші тексеру….
Dialogue: 0,0:13:18.73,0:13:21.73,Default,,0,0,0,,Нилбериспен шабуыл! күзетші.
Dialogue: 0,0:13:21.73,0:13:24.73,Default,,0,0,0,,1 Нилберис шеберлігін қайта салыңыз!
Dialogue: 0,0:13:24.73,0:13:27.70,Default,,0,0,0,,Садимен шабуыл! Күзетші жоқ.
Dialogue: 0,0:13:29.20,0:13:31.21,Default,,0,0,0,,Бұрылыстың соңы….
Dialogue: 0,0:13:31.21,0:13:33.21,Default,,0,0,0,,Дағдыларды тамаша пайдалану!
Dialogue: 0,0:13:33.21,0:13:35.21,Default,,0,0,0,,Аки-кун өсіп жатыр~!
Dialogue: 0,0:13:35.21,0:13:37.21,Default,,0,0,0,,Мен Құдайдың шеберлігін пайдаланбадым➡
Dialogue: 0,0:13:37.21,0:13:39.75,Default,,0,0,0,,Сонымен, сіз келесіге дайындалып жатырсыз.
Dialogue: 0,0:13:39.75,0:13:43.69,Default,,0,0,0,,Триггер шықпады, бірақ мен сабырмен күресе алдым.
Dialogue: 0,0:13:43.69,0:13:45.69,Default,,0,0,0,,Күн қатты жылып барады!
Dialogue: 0,0:13:45.69,0:13:47.72,Default,,0,0,0,,Сіз де, солай ма? Апыр-ай!
Dialogue: 0,0:13:47.72,0:13:51.26,Default,,0,0,0,,Жылы ма? мен білмеймін.
Dialogue: 0,0:13:51.26,0:13:54.23,Default,,0,0,0,,Мұндай нәрсе жоқ.
Dialogue: 0,0:13:55.70,0:13:57.70,Default,,0,0,0,,Менің кезегім...
Dialogue: 0,0:13:59.70,0:14:01.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:01.70,0:14:03.67,Default,,0,0,0,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:14:19.72,0:14:23.26,Default,,0,0,0,,Суо...сіз➡
Dialogue: 0,0:14:23.26,0:14:26.26,Default,,0,0,0,,Ештеңе жоқ...жоқ!
Dialogue: 0,0:14:30.70,0:14:32.67,Default,,0,0,0,,Суо!
Dialogue: 0,0:14:34.17,0:14:36.17,Default,,0,0,0,,Хоуууу...!
Dialogue: 0,0:14:37.21,0:14:40.24,Default,,0,0,0,,Мен сізді аздап түсіне бастадым.
Dialogue: 0,0:14:40.24,0:14:44.21,Default,,0,0,0,,Осы уақытқа дейін мен сенің көздеріңнен ештеңе көре алмадым.
Dialogue: 0,0:14:44.21,0:14:46.71,Default,,0,0,0,,Бірақ... бәрі басқаша болды.
Dialogue: 0,0:14:46.71,0:14:48.72,Default,,0,0,0,,Ол бос емес.
Dialogue: 0,0:14:48.72,0:14:51.69,Default,,0,0,0,,Ішімде, жүрегімде жасырылған➡
Dialogue: 0,0:14:51.69,0:14:53.69,Default,,0,0,0,,Мен оны көрмедім.
Dialogue: 0,0:14:53.69,0:14:56.22,Default,,0,0,0,,Бірақ егер біз мұнда сүрінсек, Құрылтайшы Титанға қарсы ешқашан мүмкіндігіміз болмайды.
Dialogue: 0,0:14:56.22,0:14:59.23,Default,,0,0,0,,Мен қол созамын! Апыр-ай!
Dialogue: 0,0:14:59.23,0:15:01.70,Default,,0,0,0,,Күлетін күнге дейін!
Dialogue: 0,0:15:02.70,0:15:04.73,Default,,0,0,0,,Бұл мағынасыз...
Dialogue: 0,0:15:04.73,0:15:08.70,Default,,0,0,0,,Ақырында, сен де, мен де ештеңеге қайта ораламыз.
Dialogue: 0,0:15:10.24,0:15:14.21,Default,,0,0,0,,Көзге апаратын әмбебап жүріс.
Dialogue: 0,0:15:15.71,0:15:17.71,Default,,0,0,0,,Нөлдік тағдыр➡
Dialogue: 0,0:15:17.71,0:15:20.18,Default,,0,0,0,,Брагдомейер.
Dialogue: 0,0:15:23.75,0:15:28.22,Default,,0,0,0,,Палубаның жоғарғы 3 картасынан 2 картаны жаныңызға салып, 1 картаны салыңыз.
Dialogue: 0,0:15:29.22,0:15:31.76,Default,,0,0,0,,Steam Raider Zamoog-қа қоңырау шалыңыз.
Dialogue: 0,0:15:31.76,0:15:34.23,Default,,0,0,0,,Шеберлікке байланысты палубаның жоғарғы 3 картасынан➡
Dialogue: 0,0:15:34.23,0:15:36.73,Default,,0,0,0,,Жаныңызға 1 картаны салып, 1 картаны салыңыз.
Dialogue: 0,0:15:37.70,0:15:39.73,Default,,0,0,0,,Қосымша Zamoog ➡ нөміріне қоңырау шалыңыз
Dialogue: 0,0:15:39.73,0:15:42.70,Default,,0,0,0,,Жанға 1 карта салып, 1 картаны салыңыз➡
Dialogue: 0,0:15:42.70,0:15:44.71,Default,,0,0,0,,Екі айналдырушыны шақырыңыз.
Dialogue: 0,0:15:44.71,0:15:46.71,Default,,0,0,0,,Благдомермен шабуыл.
Dialogue: 0,0:15:46.71,0:15:48.68,Default,,0,0,0,,Дағдыны белсендіру.
Dialogue: 0,0:15:51.25,0:15:54.72,Default,,0,0,0,,4 жанды төмен қаратып байлап, 1 картаны сал.
Dialogue: 0,0:15:54.72,0:15:59.19,Default,,0,0,0,,Содан кейін сіздің қарсыласыңыз екі артқы қорғаушыны төмен қаратып байлайды.
Dialogue: 0,0:15:59.19,0:16:01.69,Default,,0,0,0,,Бентеста мен Проловиді байланыстырыңыз!
Dialogue: 0,0:16:05.36,0:16:07.70,Default,,0,0,0,,｟Жойылу... бұл әлі де қиын. ｠
Dialogue: 0,0:16:07.70,0:16:09.73,Default,,0,0,0,,Одан әрі Благдомейер ➡
Dialogue: 0,0:16:09.73,0:16:12.20,Default,,0,0,0,,Қуат плюс 10000. Қорғаушы жоқ.
Dialogue: 0,0:16:12.20,0:16:14.70,Default,,0,0,0,,Бірінші тексеру….
Dialogue: 0,0:16:14.70,0:16:17.24,Default,,0,0,0,,Екінші тексеру….
Dialogue: 0,0:16:17.24,0:16:21.21,Default,,0,0,0,,Критикалық триггер Zamoog қуаты +10000.
Dialogue: 0,0:16:21.21,0:16:23.18,Default,,0,0,0,,Blagdomeyer Critical Plus 1.
Dialogue: 0,0:16:25.21,0:16:28.25,Default,,0,0,0,,Айналдырғышты күшейту... Zamoog көмегімен шабуыл.
Dialogue: 0,0:16:28.25,0:16:32.69,Default,,0,0,0,,Дағдыны белсендіру 3 картаның энергиялық жарылысы және қуаты +5000➡
Dialogue: 0,0:16:32.69,0:16:35.19,Default,,0,0,0,,１
Dialogue: 0,0:16:35.19,0:16:37.69,Default,,0,0,0,,...
Dialogue: 0,0:16:37.69,0:16:40.19,Default,,0,0,0,,...
Dialogue: 0,0:16:40.19,0:16:42.20,Default,,0,0,0,,Басқа Замугпен шабуыл.
Dialogue: 0,0:16:42.20,0:16:44.20,Default,,0,0,0,,Қуат +5000 шеберлікпен➡
Dialogue: 0,0:16:44.20,0:16:46.20,Default,,0,0,0,,１
Dialogue: 0,0:16:46.20,0:16:48.20,Default,,0,0,0,,...
Dialogue: 0,0:16:48.20,0:16:50.20,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:16:50.20,0:16:52.71,Default,,0,0,0,,Мен 4 залал алдым...
Dialogue: 0,0:16:52.71,0:16:54.71,Default,,0,0,0,,...
Dialogue: 0,0:16:54.71,0:16:57.21,Default,,0,0,0,,Нөлдік Құдайдың шеберлігі ауқымында➡
Dialogue: 0,0:16:57.21,0:16:59.21,Default,,0,0,0,,...
Dialogue: 0,0:16:59.21,0:17:01.18,Default,,0,0,0,,➡
Dialogue: 0,0:17:01.18,0:17:03.28,Default,,0,0,0,,...
Dialogue: 0,0:17:03.28,0:17:06.25,Default,,0,0,0,,｟…➡
Dialogue: 0,0:17:06.25,0:17:09.22,Default,,0,0,0,,｠
Dialogue: 0,0:17:09.22,0:17:12.19,Default,,0,0,0,,...
Dialogue: 0,0:17:12.19,0:17:14.23,Default,,0,0,0,,...
Dialogue: 0,0:17:14.23,0:17:17.70,Default,,0,0,0,,３➡
Dialogue: 0,0:17:17.70,0:17:20.20,Default,,0,0,0,,Басқа Novia телефонына қоңырау шалыңыз!
Dialogue: 0,0:17:20.20,0:17:23.20,Default,,0,0,0,,Сонымен қатар, Гаругаонға қоңырау шалу үшін осы дағдыны пайдаланыңыз!
Dialogue: 0,0:17:23.20,0:17:26.24,Default,,0,0,0,,Гаругаонға қолыңыздан қоңырау шалыңыз!
Dialogue: 0,0:17:26.24,0:17:29.71,Default,,0,0,0,,Жарайды, мен Новияның шеберлігін пайдаланып, тылдағы күзетімді қайтадан орналастырдым!
Dialogue: 0,0:17:29.71,0:17:31.71,Default,,0,0,0,,...
Dialogue: 0,0:17:31.71,0:17:33.71,Default,,0,0,0,,Жүр!
Dialogue: 0,0:17:33.71,0:17:36.22,Default,,0,0,0,,...
Dialogue: 0,0:17:36.22,0:17:39.72,Default,,0,0,0,,...
Dialogue: 0,0:17:42.22,0:17:46.19,Default,,0,0,0,,Барлық маңызды триггерлерді палубаға қайтарыңыз және плюс 1 жүргізіңіз.
Dialogue: 0,0:17:46.19,0:17:48.73,Default,,0,0,0,,...
Dialogue: 0,0:17:48.73,0:17:51.20,Default,,0,0,0,,Зақымдануды тексеру…Алдыңғы триггер➡
Dialogue: 0,0:17:51.20,0:17:54.34,Default,,0,0,0,,Барлық алдыңғы қатардағы қуат плюс 10 000.
Dialogue: 0,0:17:54.34,0:17:56.27,Default,,0,0,0,,｟…｠
Dialogue: 0,0:17:56.27,0:17:58.71,Default,,0,0,0,,｟Тағдыр жазылмас➡
Dialogue: 0,0:17:58.71,0:18:01.28,Default,,0,0,0,,…
Dialogue: 0,0:18:01.28,0:18:03.24,Default,,0,0,0,,｠
Dialogue: 0,0:18:03.24,0:18:07.25,Default,,0,0,0,,...
Dialogue: 0,0:18:09.72,0:18:12.72,Default,,0,0,0,,➡
Dialogue: 0,0:18:12.72,0:18:16.19,Default,,0,0,0,,Баға қою үшін 2 картаға қоңырау шалыңыз!
Dialogue: 0,0:18:16.19,0:18:19.19,Default,,0,0,0,,Күзетші. Қарғыс атқыр... үштік көлік!
Dialogue: 0,0:18:19.19,0:18:22.20,Default,,0,0,0,,Бірінші тексеру….
Dialogue: 0,0:18:22.20,0:18:24.23,Default,,0,0,0,,Екінші тексеру….
Dialogue: 0,0:18:24.23,0:18:27.20,Default,,0,0,0,,Критикалық триггер! Gigantech қуаты плюс 10 000!
Dialogue: 0,0:18:27.20,0:18:29.20,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:18:29.20,0:18:32.24,Default,,0,0,0,,Үшінші тексеру…Критикалық триггер!
Dialogue: 0,0:18:32.24,0:18:35.78,Default,,0,0,0,,Novia қуаты плюс 10 000 критикалық плюс 1.
Dialogue: 0,0:18:35.78,0:18:38.78,Default,,0,0,0,,｟Жарайды, тағы екі шабуыл қалды...
Dialogue: 0,0:18:38.78,0:18:40.75,Default,,0,0,0,,Тіпті біреуі өтіп кетсе... ｠
Dialogue: 0,0:18:42.18,0:18:44.19,Default,,0,0,0,,Мұнда жеңіңіз!
Dialogue: 0,0:18:50.19,0:18:52.73,Default,,0,0,0,,Сіз аздап күйіп қалдыңыз ба?
Dialogue: 0,0:18:52.73,0:18:55.70,Default,,0,0,0,,Жарайды, бұл карта ұрысы.
Dialogue: 0,0:18:55.70,0:18:57.73,Default,,0,0,0,,Кеттік! Апыр-ай!
Dialogue: 0,0:18:57.73,0:18:59.70,Default,,0,0,0,,Novia-мен шабуыл!
Dialogue: 0,0:18:59.70,0:19:02.20,Default,,0,0,0,,Күзетшілерді ұстау.
Dialogue: 0,0:19:02.20,0:19:05.21,Default,,0,0,0,,Gigantech Masher көмегімен шабуыл!
Dialogue: 0,0:19:05.21,0:19:07.21,Default,,0,0,0,,Толық күзет.
Dialogue: 0,0:19:07.21,0:19:09.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:09.34,0:19:13.71,Default,,0,0,0,,Ауырсыну құралының шеберлігін пайдаланып, бір картаны салып, айналымды аяқтаңыз.
Dialogue: 0,0:19:13.71,0:19:16.25,Default,,0,0,0,,Біз жеңе алмадық па?
Dialogue: 0,0:19:16.25,0:19:19.72,Default,,0,0,0,,Құдайдың шеберлігін пайдаланған кезде, Благдомьер өте маңызды 2➡
Dialogue: 0,0:19:19.72,0:19:22.72,Default,,0,0,0,,Сол соққы өтсе, Аки жеңіледі.
Dialogue: 0,0:19:22.72,0:19:26.23,Default,,0,0,0,,Оның үстіне Резаелдің кереметі мөрленеді.
Dialogue: 0,0:19:26.23,0:19:29.20,Default,,0,0,0,,Хахаха Болашақ сол бала айтқандай➡
Dialogue: 0,0:19:29.20,0:19:31.73,Default,,0,0,0,,Сіз оны әдемі түсірдіңіз.
Dialogue: 0,0:19:31.73,0:19:34.70,Default,,0,0,0,,Балалар~ Қашып кететін уақыт емес пе?
Dialogue: 0,0:19:34.70,0:19:37.20,Default,,0,0,0,,Олай болса қашу керек, солай ма?
Dialogue: 0,0:19:37.20,0:19:39.71,Default,,0,0,0,,Сонда да сіз осындасыз➡
Dialogue: 0,0:19:39.71,0:19:42.71,Default,,0,0,0,,Сен де сенесің, солай емес пе?
Dialogue: 0,0:19:42.71,0:19:45.18,Default,,0,0,0,,Мен бір керемет болады деп ойлаймын!
Dialogue: 0,0:19:48.68,0:19:51.72,Default,,0,0,0,,Сен мені осымен өлтіре алмайсың ба?
Dialogue: 0,0:19:51.72,0:19:54.19,Default,,0,0,0,,Бірақ менің бұл жерде ұтылатын ойым жоқ!
Dialogue: 0,0:20:00.69,0:20:03.23,Default,,0,0,0,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,0:20:03.23,0:20:05.70,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:05.70,0:20:08.70,Default,,0,0,0,,Бір нәрсе әдеттегіден өзгеше.
Dialogue: 0,0:20:08.70,0:20:11.74,Default,,0,0,0,,Бірақ мен оны аяқтаймын!
Dialogue: 0,0:20:11.74,0:20:14.71,Default,,0,0,0,,Менің әлемімде маған ештеңе керек емес➡
Dialogue: 0,0:20:14.71,0:20:17.21,Default,,0,0,0,,Қажет емес. Апыр-ай!
Dialogue: 0,0:20:17.21,0:20:20.21,Default,,0,0,0,,Мен нөлмін!
Dialogue: 0,0:20:20.21,0:20:22.68,Default,,0,0,0,,Жеке сапар.
Dialogue: 0,0:20:22.68,0:20:24.69,Default,,0,0,0,,Брагедмейер!
Dialogue: 0,0:20:27.69,0:20:29.69,Default,,0,0,0,,Мид хакерге қоңырау шалыңыз.
Dialogue: 0,0:20:29.69,0:20:31.69,Default,,0,0,0,,Soul Explorer шеберлігімен➡
Dialogue: 0,0:20:31.69,0:20:34.23,Default,,0,0,0,,Благдомьердің күші плюс 10 000.
Dialogue: 0,0:20:34.23,0:20:36.70,Default,,0,0,0,,Zamoog қуатымен шабуыл +5000➡
Dialogue: 0,0:20:36.70,0:20:38.70,Default,,0,0,0,,Сыни плюс 1.
Dialogue: 0,0:20:38.70,0:20:40.73,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:20:40.73,0:20:44.71,Default,,0,0,0,,Алхимиктер Благдомьерді күшейтетін шабуыл.
Dialogue: 0,0:20:44.71,0:20:46.71,Default,,0,0,0,,Дағдыны белсендіру.
Dialogue: 0,0:20:48.24,0:20:51.21,Default,,0,0,0,,Қарсыласыңыздың екі артқы қорғаушысын төмен қаратып байлаңыз.
Dialogue: 0,0:20:51.21,0:20:54.25,Default,,0,0,0,,Благдомердің күші плюс 20 000.
Dialogue: 0,0:20:54.25,0:20:56.22,Default,,0,0,0,,Алхимиктердің көбірек дағдылары➡
Dialogue: 0,0:20:56.22,0:20:59.72,Default,,0,0,0,,Zamoog тұрып, +15000 қуат алыңыз.
Dialogue: 0,0:21:03.19,0:21:05.19,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:21:06.23,0:21:09.20,Default,,0,0,0,,Кел...Алып, тұрамын!
Dialogue: 0,0:21:10.20,0:21:13.70,Default,,0,0,0,,Резаэльдің кереметі осы жерде жоғалады.
Dialogue: 0,0:21:13.70,0:21:16.20,Default,,0,0,0,,Нөлге➡ қайтару
Dialogue: 0,0:21:16.20,0:21:18.71,Default,,0,0,0,,Тәңірлік шеберліктің көрінісі.
Dialogue: 0,0:21:19.71,0:21:22.68,Default,,0,0,0,,Blagdomeyer Critical Plus 1.
Dialogue: 0,0:21:26.75,0:21:29.25,Default,,0,0,0,,Қарсыласыңыздың келесі айналымының соңына дейін➡
Dialogue: 0,0:21:29.25,0:21:32.25,Default,,0,0,0,,Қарсыластың авангарды барлық қабілеттерін жоғалтады➡
Dialogue: 0,0:21:32.25,0:21:35.22,Default,,0,0,0,,Толық қорғанысты пайдалану мүмкін емес.
Dialogue: 0,0:21:36.22,0:21:39.23,Default,,0,0,0,,Бұл жекпе-жектен тыс, ақырында➡
Dialogue: 0,0:21:39.23,0:21:41.20,Default,,0,0,0,,Ештеңе болмады.
Dialogue: 0,0:21:41.20,0:21:43.23,Default,,0,0,0,,Жоқ, әлі жоқ!
Dialogue: 0,0:21:43.23,0:21:45.20,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:21:46.23,0:21:49.20,Default,,0,0,0,,Амортаның уақыт тағдыры!
Dialogue: 0,0:21:50.70,0:21:54.18,Default,,0,0,0,,Уақыт... тағдыр!
Dialogue: 0,0:21:55.68,0:22:01.68,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory