Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.33,0:00:05.27,Default,,0,0,0,,｟Жеңіс. Un?
Dialogue: 0,0:00:05.27,0:00:07.27,Default,,0,0,0,,Мүлдем.
Dialogue: 0,0:00:07.27,0:00:09.24,Default,,0,0,0,,Әрине!
Dialogue: 0,0:00:11.27,0:00:13.74,Default,,0,0,0,,Керемет – ➡
Dialogue: 0,0:00:13.74,0:00:15.74,Default,,0,0,0,,Міндетті түрде ояныңыз!
Dialogue: 0,0:00:30.79,0:00:33.26,Default,,0,0,0,,Болашаққа бірге қадам басайық➡
Dialogue: 0,0:00:33.26,0:00:35.26,Default,,0,0,0,,Хикари! Un!
Dialogue: 0,0:00:37.27,0:00:39.27,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:00:42.77,0:00:44.74,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:46.41,0:00:49.38,Default,,0,0,0,,｟Сіз де әлі бас тартқан жоқсыз. ｠
Dialogue: 0,0:00:51.28,0:00:53.28,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:00:53.28,0:00:56.29,Default,,0,0,0,,Біз де бірге күресейік!
Dialogue: 0,0:00:57.29,0:01:00.29,Default,,0,0,0,,Уақыт... тағдыры.
Dialogue: 0,0:01:01.29,0:01:03.76,Default,,0,0,0,,Жетінші тағдыр...
Dialogue: 0,0:01:03.76,0:01:06.80,Default,,0,0,0,,Бұл менікі... біздікі➡
Dialogue: 0,0:01:06.80,0:01:09.26,Default,,0,0,0,,Бұл сіздің тағдырыңызды өзгертетін жалғыз карта!
Dialogue: 0,0:02:44.23,0:02:46.76,Default,,0,0,0,,Reel Amorta шеберлігін белсендіру➡
Dialogue: 0,0:02:46.76,0:02:50.27,Default,,0,0,0,,Қамқоршы шеңберіне қойылған кезде қолыңыздан бір картаны тастаңыз➡
Dialogue: 0,0:02:50.27,0:02:53.24,Default,,0,0,0,,Палубаның төменгі жағына екі тігілген картаны қою арқылы➡
Dialogue: 0,0:02:53.24,0:02:55.27,Default,,0,0,0,,Шабуыл тимейді.
Dialogue: 0,0:02:55.27,0:02:57.74,Default,,0,0,0,,Күзет шеберлігі? Ондай нәрсе бар ма?
Dialogue: 0,0:02:57.74,0:03:00.24,Default,,0,0,0,,Бұл мүмкін болуы керек, өйткені мен мұны істедім! ➡
Dialogue: 0,0:03:00.24,0:03:02.71,Default,,0,0,0,,Сіз бұған көп қарсы емессіз деп үміттенемін!
Dialogue: 0,0:03:02.71,0:03:04.71,Default,,0,0,0,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:03:06.75,0:03:09.22,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:03:09.22,0:03:11.22,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:03:11.22,0:03:13.22,Default,,0,0,0,,U….
Dialogue: 0,0:03:14.39,0:03:16.73,Default,,0,0,0,,｟Не? Бұл сезім. ｠
Dialogue: 0,0:03:16.73,0:03:19.29,Default,,0,0,0,,Бұл өкінішті болды.
Dialogue: 0,0:03:19.29,0:03:21.80,Default,,0,0,0,,Ұрыс әлі біткен жоқ.
Dialogue: 0,0:03:22.76,0:03:25.73,Default,,0,0,0,,Менің тағы екі шабуылым қалды➡
Dialogue: 0,0:03:25.73,0:03:28.70,Default,,0,0,0,,Swirler's Boost Zamoog көмегімен шабуыл.
Dialogue: 0,0:03:29.74,0:03:32.24,Default,,0,0,0,,Қуат +5000 шеберлікке байланысты➡
Dialogue: 0,0:03:32.24,0:03:34.21,Default,,0,0,0,,Сыни плюс 1.
Dialogue: 0,0:03:35.21,0:03:37.21,Default,,0,0,0,,Толық қуат қорғауы!
Dialogue: 0,0:03:37.21,0:03:39.72,Default,,0,0,0,,Swirler's Boost хакерімен шабуыл.
Dialogue: 0,0:03:39.72,0:03:41.72,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:03:41.72,0:03:43.72,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:03:43.72,0:03:45.72,Default,,0,0,0,,Тағдыр бұрылысы➡
Dialogue: 0,0:03:45.72,0:03:47.76,Default,,0,0,0,,Брегедмейердің құдайлық шеберлігі➡
Dialogue: 0,0:03:47.76,0:03:49.73,Default,,0,0,0,,Оны жеңдім!
Dialogue: 0,0:03:50.73,0:03:53.73,Default,,0,0,0,,Жақсы! Мен оған әрең шыдадым!
Dialogue: 0,0:03:53.73,0:03:56.26,Default,,0,0,0,,Бірақ кемшілігі бұрынғыдай болып қалады➡
Dialogue: 0,0:03:56.26,0:04:00.74,Default,,0,0,0,,Акина Нөлдің құдайлық шеберлігімен келесі бұрылысына дейін➡
Dialogue: 0,0:04:00.74,0:04:03.24,Default,,0,0,0,,Резаэльдің дағдылары өшірілді.
Dialogue: 0,0:04:03.24,0:04:06.74,Default,,0,0,0,,Басқаша айтқанда, тамшылардан одақтас шақыру шеберлігі де бар➡
Dialogue: 0,0:04:06.74,0:04:08.71,Default,,0,0,0,,Қос дискіні де пайдалану мүмкін емес...
Dialogue: 0,0:04:09.71,0:04:12.21,Default,,0,0,0,,Енді не істеуіміз керек? ➡
Dialogue: 0,0:04:12.21,0:04:15.22,Default,,0,0,0,,Маған... ғажайыпты көрсет.
Dialogue: 0,0:04:15.22,0:04:18.29,Default,,0,0,0,,Бұдан былай ешкім білмейтін болашақ➡
Dialogue: 0,0:04:18.29,0:04:21.72,Default,,0,0,0,,Бұл мен сені жеңетін жаңа болашақ!
Dialogue: 0,0:04:21.72,0:04:24.23,Default,,0,0,0,,Сол болашақ... өшіріп таста!
Dialogue: 0,0:04:24.23,0:04:26.23,Default,,0,0,0,,Бұл ойын! Суо.
Dialogue: 0,0:04:26.23,0:04:28.70,Default,,0,0,0,,Менің жеребе кезегім!
Dialogue: 0,0:04:30.73,0:04:33.24,Default,,0,0,0,,Гаругаонды алдыңғы қатарға жылжытыңыз➡
Dialogue: 0,0:04:33.24,0:04:35.74,Default,,0,0,0,,Әуеден күшейту➡
Dialogue: 0,0:04:35.74,0:04:37.77,Default,,0,0,0,,Резаэльмен шабуыл.
Dialogue: 0,0:04:37.77,0:04:40.74,Default,,0,0,0,,Күзетші жоқ. Осы жерге сын салсаңыз➡
Dialogue: 0,0:04:40.74,0:04:43.21,Default,,0,0,0,,Мен жеңдім! Байқап көріңіз.
Dialogue: 0,0:04:43.21,0:04:45.21,Default,,0,0,0,,Драйверді тексеру➡
Dialogue: 0,0:04:45.21,0:04:47.72,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:04:50.22,0:04:52.22,Default,,0,0,0,,Сурет салу…Триггер.
Dialogue: 0,0:04:53.79,0:04:57.26,Default,,0,0,0,,1 картаны салыңыз және Гаругаонның күші +10000.
Dialogue: 0,0:04:59.23,0:05:01.23,Default,,0,0,0,,Гаргаонмен шабуыл.
Dialogue: 0,0:05:01.23,0:05:03.23,Default,,0,0,0,,Күзетші. Қарғыс атсын...!
Dialogue: 0,0:05:03.23,0:05:05.20,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:05:06.74,0:05:09.74,Default,,0,0,0,,Болды... Осылай ➡ жүрсең де
Dialogue: 0,0:05:09.74,0:05:12.24,Default,,0,0,0,,Тағдыр сол қалпында қала ма?
Dialogue: 0,0:05:16.31,0:05:18.78,Default,,0,0,0,,｟Бұл не? Бұл сезім➡
Dialogue: 0,0:05:18.78,0:05:21.28,Default,,0,0,0,,Менің кеудем... ыстық. ｠
Dialogue: 0,0:05:22.25,0:05:24.22,Default,,0,0,0,,Бұл қызық, Авангард.
Dialogue: 0,0:05:24.22,0:05:27.79,Default,,0,0,0,,Сіз солай ойлайсыз ба? Суо.
Dialogue: 0,0:05:27.79,0:05:31.73,Default,,0,0,0,,Бұл жерде жеңілсең, тілегің орындалмайды➡
Dialogue: 0,0:05:31.73,0:05:33.76,Default,,0,0,0,,Сіз қорықпайсыз ба?
Dialogue: 0,0:05:33.76,0:05:37.23,Default,,0,0,0,,Бұл қорқынышты... бірақ олай етпе! Бұл солай сезіледі.
Dialogue: 0,0:05:38.77,0:05:41.74,Default,,0,0,0,,Бір ұтыс нәтижені анықтай алатын жағдайлар➡
Dialogue: 0,0:05:41.74,0:05:44.27,Default,,0,0,0,,Қатты шағып➡
Dialogue: 0,0:05:44.27,0:05:48.71,Default,,0,0,0,,Мен тағы бір қадамға жете алмадым. Көңіл қалдырады, бірақ қызық➡
Dialogue: 0,0:05:48.71,0:05:51.21,Default,,0,0,0,,Қорқынышты, бірақ қызықты!
Dialogue: 0,0:05:51.21,0:05:54.25,Default,,0,0,0,,Бұл көңілсіз, бірақ көңілді➡
Dialogue: 0,0:05:54.25,0:05:56.22,Default,,0,0,0,,Қорқынышты, бірақ қызықты ма?
Dialogue: 0,0:05:56.22,0:05:58.25,Default,,0,0,0,,Қараңызшы?
Dialogue: 0,0:05:58.25,0:06:00.72,Default,,0,0,0,,Мен бұл шарасыз жағдайдан өтемін➡
Dialogue: 0,0:06:00.72,0:06:02.72,Default,,0,0,0,,Мен кереметті ұстаймын!
Dialogue: 0,0:06:02.72,0:06:04.73,Default,,0,0,0,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:06:05.73,0:06:07.73,Default,,0,0,0,,Кейін қалсаң, капитан мені сөгіп тастайды.
Dialogue: 0,0:06:07.73,0:06:09.73,Default,,0,0,0,,Мен білмеймін...!
Dialogue: 0,0:06:09.73,0:06:11.73,Default,,0,0,0,,Суо?
Dialogue: 0,0:06:11.73,0:06:13.74,Default,,0,0,0,,Бірақ қазір мен➡
Dialogue: 0,0:06:13.74,0:06:15.74,Default,,0,0,0,,Менің жалғыз істегім келетіні - сені ұру➡
Dialogue: 0,0:06:15.74,0:06:17.74,Default,,0,0,0,,Мен түсінемін!
Dialogue: 0,0:06:17.74,0:06:20.78,Default,,0,0,0,,Менің жеребе кезегім! ➡
Dialogue: 0,0:06:20.78,0:06:23.25,Default,,0,0,0,,Хакер мен свирлердің орындарын ауыстырыңыз➡
Dialogue: 0,0:06:23.25,0:06:25.71,Default,,0,0,0,,Zamoog➡ нөміріне қоңырау шалыңыз
Dialogue: 0,0:06:25.71,0:06:27.75,Default,,0,0,0,,Осы айналымды аяқтаңыз! ➡
Dialogue: 0,0:06:27.75,0:06:29.72,Default,,0,0,0,,Zamoog➡ көмегімен шабуыл
Dialogue: 0,0:06:29.72,0:06:31.72,Default,,0,0,0,,Қуат +5000 шеберлікпен➡
Dialogue: 0,0:06:31.72,0:06:33.76,Default,,0,0,0,,Сыни плюс 1.
Dialogue: 0,0:06:33.76,0:06:35.76,Default,,0,0,0,,Бұл мұнымен бітпейді!
Dialogue: 0,0:06:35.76,0:06:38.23,Default,,0,0,0,,Благдомермен шабуыл.
Dialogue: 0,0:06:40.76,0:06:44.73,Default,,0,0,0,,Қарсылас 2 артқы қорғаушыны шеберлікпен байлайды➡
Dialogue: 0,0:06:44.73,0:06:47.70,Default,,0,0,0,,Благдомердің күші плюс 30 000.
Dialogue: 0,0:06:49.77,0:06:52.74,Default,,0,0,0,,Сонымен қатар, Замугқа тұру үшін Алхимиктің шеберлігін пайдаланыңыз.
Dialogue: 0,0:06:59.21,0:07:01.22,Default,,0,0,0,,Күзетші жоқ. Уф...!
Dialogue: 0,0:07:01.22,0:07:03.22,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:07:03.22,0:07:06.22,Default,,0,0,0,,Триггер жоқ…Екінші тексеру➡
Dialogue: 0,0:07:06.22,0:07:08.22,Default,,0,0,0,,Емдеу триггері!
Dialogue: 0,0:07:08.22,0:07:11.23,Default,,0,0,0,,Замугтың күші плюс 10 000!
Dialogue: 0,0:07:16.73,0:07:18.70,Default,,0,0,0,,Зиянды қалпына келтіру.
Dialogue: 0,0:07:20.74,0:07:23.27,Default,,0,0,0,,Благдомьердің құдайлық шеберлігі бойынша➡
Dialogue: 0,0:07:23.27,0:07:26.74,Default,,0,0,0,,Қабілет бір айналымға ғана жоғалады. Ха….
Dialogue: 0,0:07:26.74,0:07:28.74,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:28.74,0:07:32.25,Default,,0,0,0,,Енді... Резаелдің құдайлық шеберлігі қайта оралды.
Dialogue: 0,0:07:32.25,0:07:35.25,Default,,0,0,0,,Бірақ... егер сіз триггерді тартпасаңыз, мағынасы жоқ.
Dialogue: 0,0:07:35.25,0:07:37.72,Default,,0,0,0,,Мен сізге қалай екенін көрсетемін!
Dialogue: 0,0:07:37.72,0:07:40.32,Default,,0,0,0,,Себебі кішкене болса да жарық➡
Dialogue: 0,0:07:40.32,0:07:42.22,Default,,0,0,0,,Тек қол ұшын созатындарға ➡
Dialogue: 0,0:07:42.22,0:07:44.23,Default,,0,0,0,,Ғажайыптар келе жатыр!
Dialogue: 0,0:07:44.23,0:07:46.23,Default,,0,0,0,,Ах...!
Dialogue: 0,0:07:46.23,0:07:48.30,Default,,0,0,0,,Зақымдануды тексеру!
Dialogue: 0,0:07:48.30,0:07:50.23,Default,,0,0,0,,Критикалық триггер?
Dialogue: 0,0:07:50.23,0:07:54.24,Default,,0,0,0,,Мен ешқашан берілмеймін➡
Dialogue: 0,0:07:54.24,0:07:56.20,Default,,0,0,0,,Ғажайыптың екінші келуі!
Dialogue: 0,0:07:58.24,0:08:00.24,Default,,0,0,0,,Зиянды қалпына келтіру! ➡
Dialogue: 0,0:08:00.24,0:08:03.28,Default,,0,0,0,,Әңгіме әлі біткен жоқ!
Dialogue: 0,0:08:03.28,0:08:06.72,Default,,0,0,0,,Авангард соңына дейін не болады➡
Dialogue: 0,0:08:06.72,0:08:08.72,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:08:10.79,0:08:13.22,Default,,0,0,0,,｟ (Суудың анасы) Суо, әкеңді ұра бер!
Dialogue: 0,0:08:13.22,0:08:15.26,Default,,0,0,0,,Ой, ой… Бұл жарамайды. Шынымен де жарамайды.
Dialogue: 0,0:08:15.26,0:08:17.76,Default,,0,0,0,,Тыңда, Суо. жұмысшы?
Dialogue: 0,0:08:17.76,0:08:21.26,Default,,0,0,0,,Авангард соңына дейін не боларын білмейді➡
Dialogue: 0,0:08:21.26,0:08:24.23,Default,,0,0,0,,Қиын жағдайда қалсам да, әкем осында➡
Dialogue: 0,0:08:24.23,0:08:26.80,Default,,0,0,0,,Менің жеңілетін ойым жоқ. Un!
Dialogue: 0,0:08:26.80,0:08:28.77,Default,,0,0,0,,Мен де жеңілмеймін! ｠
Dialogue: 0,0:08:30.24,0:08:32.74,Default,,0,0,0,,есіме түсті➡
Dialogue: 0,0:08:32.74,0:08:35.74,Default,,0,0,0,,Әке Ана➡
Dialogue: 0,0:08:35.74,0:08:39.25,Default,,0,0,0,,Маған... Vanguard ұнады.
Dialogue: 0,0:08:40.22,0:08:44.22,Default,,0,0,0,,Сіз мені әлі де жақсы көресіз, солай ма?
Dialogue: 0,0:08:44.22,0:08:46.22,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:08:49.72,0:08:55.23,Default,,0,0,0,,Брагдомейер.
Dialogue: 0,0:08:55.23,0:08:57.27,Default,,0,0,0,,Бірге жеңейік.
Dialogue: 0,0:08:57.27,0:09:00.24,Default,,0,0,0,,Мен жеңгім келеді. Жасай берейік➡
Dialogue: 0,0:09:00.24,0:09:02.20,Default,,0,0,0,,Үздіксіз Суоу!
Dialogue: 0,0:09:04.24,0:09:06.74,Default,,0,0,0,,Ах! Мейдо Акина.
Dialogue: 0,0:09:08.21,0:09:10.21,Default,,0,0,0,,Zamoog көмегімен шабуыл.
Dialogue: 0,0:09:10.21,0:09:12.21,Default,,0,0,0,,Күзет.
Dialogue: 0,0:09:12.21,0:09:15.75,Default,,0,0,0,,Басқа Замугпен шабуыл!
Dialogue: 0,0:09:15.75,0:09:17.75,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:09:17.75,0:09:19.72,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:09:20.79,0:09:23.22,Default,,0,0,0,,｟Мен оның өткен өмірі туралы естідім➡
Dialogue: 0,0:09:23.22,0:09:26.23,Default,,0,0,0,,Менің жек көретінім ол өзгермейді.
Dialogue: 0,0:09:26.23,0:09:28.73,Default,,0,0,0,,Жоқ, мен сенен мені кешіруіңді сұрамаймын➡
Dialogue: 0,0:09:28.73,0:09:30.73,Default,,0,0,0,,Бірақ➡
Dialogue: 0,0:09:30.73,0:09:33.74,Default,,0,0,0,,Су маңызды адамнан айырылды➡
Dialogue: 0,0:09:33.74,0:09:36.74,Default,,0,0,0,,Жүрегімнен айырылдым...тіпті тілегім.
Dialogue: 0,0:09:36.74,0:09:39.74,Default,,0,0,0,,Мен мұңды көтере алмайтыныма сенімдімін➡
Dialogue: 0,0:09:39.74,0:09:42.71,Default,,0,0,0,,Көз жасымды да шығара алмадым➡
Dialogue: 0,0:09:42.71,0:09:45.25,Default,,0,0,0,,Бірақ ол әлі де...
Dialogue: 0,0:09:45.25,0:09:47.28,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:09:47.28,0:09:49.72,Default,,0,0,0,,Хикари мен үшін көп жұмыс істегендей➡
Dialogue: 0,0:09:49.72,0:09:52.79,Default,,0,0,0,,Егер мен оған көмектесе алсам➡
Dialogue: 0,0:09:52.79,0:09:55.29,Default,,0,0,0,,Мен Суоға хабарласқым келеді. ｠
Dialogue: 0,0:09:56.72,0:09:59.23,Default,,0,0,0,,Аа... шынымен➡
Dialogue: 0,0:09:59.23,0:10:01.73,Default,,0,0,0,,Ештеңеге қарамай, аңқаусың.
Dialogue: 0,0:10:01.73,0:10:04.23,Default,,0,0,0,,Сіз мұны әлі де жасай аласыз, солай ма? аа!
Dialogue: 0,0:10:04.23,0:10:06.73,Default,,0,0,0,,Менің жеребе кезегім!
Dialogue: 0,0:10:06.73,0:10:09.77,Default,,0,0,0,,Энергия жарылыс 7 карта және 1 картаны тарт! ➡
Dialogue: 0,0:10:09.77,0:10:13.74,Default,,0,0,0,,Палладий құлшынысы айдаһар Сиқыршыға қоңырау шалыңыз➡
Dialogue: 0,0:10:13.74,0:10:15.71,Default,,0,0,0,,Wizard Boost➡
Dialogue: 0,0:10:15.71,0:10:18.21,Default,,0,0,0,,Резаэльмен бірге Благдомьерге шабуыл жасаңыз!
Dialogue: 0,0:10:18.21,0:10:20.22,Default,,0,0,0,,Дағды іске қосылды! ➡
Dialogue: 0,0:10:20.22,0:10:22.22,Default,,0,0,0,,Нилберис пен Гигантехке қоңырау шалыңыз!
Dialogue: 0,0:10:23.22,0:10:25.22,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:10:25.22,0:10:27.22,Default,,0,0,0,,Тағы бір маңызды шайқас...!
Dialogue: 0,0:10:27.22,0:10:29.26,Default,,0,0,0,,Тағдыр….
Dialogue: 0,0:10:29.26,0:10:31.23,Default,,0,0,0,,Көлікті тексеру!
Dialogue: 0,0:10:31.23,0:10:33.23,Default,,0,0,0,,Қос жетек!
Dialogue: 0,0:10:35.23,0:10:37.23,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:10:37.23,0:10:39.23,Default,,0,0,0,,Триггер жоқ….
Dialogue: 0,0:10:39.23,0:10:41.24,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:10:41.24,0:10:43.24,Default,,0,0,0,,Оны алыңыз! ➡
Dialogue: 0,0:10:43.24,0:10:45.21,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:10:56.75,0:10:59.22,Default,,0,0,0,,Жеңімпаз Ғажайып тағдыр➡
Dialogue: 0,0:10:59.22,0:11:02.72,Default,,0,0,0,,Және Акина Мейдо!
Dialogue: 0,0:11:02.72,0:11:04.73,Default,,0,0,0,,Мен жеңдім...
Dialogue: 0,0:11:05.73,0:11:07.73,Default,,0,0,0,,Үлкен аға...!
Dialogue: 0,0:11:07.73,0:11:09.70,Default,,0,0,0,,Сіз мұны істедіңіз! Мен жеңдім...!
Dialogue: 0,0:11:21.24,0:11:23.71,Default,,0,0,0,,Біз қазірдің өзінде доспыз, солай ма?
Dialogue: 0,0:11:27.25,0:11:29.22,Default,,0,0,0,,Шулы.
Dialogue: 0,0:11:34.72,0:11:37.73,Default,,0,0,0,,Сондай-ақ! Апыр-ай!
Dialogue: 0,0:11:39.73,0:11:42.73,Default,,0,0,0,,Себебі мен қатты уайымдаймын...
Dialogue: 0,0:11:42.73,0:11:45.23,Default,,0,0,0,,Идиот...ақымақ!
Dialogue: 0,0:11:45.23,0:11:47.20,Default,,0,0,0,,Сіз жеңдіңіз.
Dialogue: 0,0:11:48.24,0:11:50.77,Default,,0,0,0,,Тағдырды өзгертуге болады.
Dialogue: 0,0:11:50.77,0:11:54.71,Default,,0,0,0,,Өйткені мен адамның қалауына сенемін~➡
Dialogue: 0,0:11:54.71,0:11:56.71,Default,,0,0,0,,Мен осылай болады деп ойладым.
Dialogue: 0,0:11:56.71,0:12:00.22,Default,,0,0,0,,Қалау мен тілек екі түрлі. А?
Dialogue: 0,0:12:00.22,0:12:03.25,Default,,0,0,0,,Қалау тек өзіңіз үшін➡
Dialogue: 0,0:12:03.25,0:12:05.22,Default,,0,0,0,,Бірақ тілек➡
Dialogue: 0,0:12:05.22,0:12:07.76,Default,,0,0,0,,Сіз біреу үшін дұға ете аласыз.
Dialogue: 0,0:12:07.76,0:12:10.73,Default,,0,0,0,,Иа... бұл біраз➡
Dialogue: 0,0:12:10.73,0:12:13.23,Default,,0,0,0,,Бұл романтикалық, солай емес пе?
Dialogue: 0,0:12:14.73,0:12:17.23,Default,,0,0,0,,Акина Мейдоу Сіз керемет жұмыс жасадыңыз➡
Dialogue: 0,0:12:17.23,0:12:19.27,Default,,0,0,0,,Тағдыр соғысынан аман өту➡
Dialogue: 0,0:12:19.27,0:12:22.77,Default,,0,0,0,,Енді сіздің тағдырыңызды өзгерту мүмкіндігіңіз бар.
Dialogue: 0,0:12:22.77,0:12:26.24,Default,,0,0,0,,Жүр, айқайла! Ғажайып тағдыр тілеп➡
Dialogue: 0,0:12:26.24,0:12:28.21,Default,,0,0,0,,Сіздің тілегіңіз!
Dialogue: 0,0:12:29.71,0:12:32.71,Default,,0,0,0,,Мен сіңліммін...
Dialogue: 0,0:12:32.71,0:12:34.72,Default,,0,0,0,,Хикариге...
Dialogue: 0,0:12:36.22,0:12:38.22,Default,,0,0,0,,Сау боласыз деп үміттенемін!
Dialogue: 0,0:12:46.73,0:12:49.23,Default,,0,0,0,,Өтінемін! Резаэл➡
Dialogue: 0,0:12:49.23,0:12:51.20,Default,,0,0,0,,Керемет жаса!
Dialogue: 0,0:13:27.74,0:13:29.74,Default,,0,0,0,,Хаа….
Dialogue: 0,0:13:29.74,0:13:31.71,Default,,0,0,0,,Үлкен аға! а….
Dialogue: 0,0:13:37.21,0:13:39.21,Default,,0,0,0,,Қайтадан қош келдіңіз!
Dialogue: 0,0:13:39.21,0:13:41.25,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:13:41.25,0:13:43.75,Default,,0,0,0,,Ех! не? не болды?
Dialogue: 0,0:13:43.75,0:13:45.72,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:13:45.72,0:13:47.72,Default,,0,0,0,,Не...? Бұл қорқынышты болды ма?
Dialogue: 0,0:13:47.72,0:13:49.72,Default,,0,0,0,,Жарайды, мен келдім➡
Dialogue: 0,0:13:49.72,0:13:51.73,Default,,0,0,0,,Мен осындамын. Un➡
Dialogue: 0,0:13:51.73,0:13:53.73,Default,,0,0,0,,Мен қайтып келдім.
Dialogue: 0,0:13:58.23,0:14:00.27,Default,,0,0,0,,Бұл кеш болды➡
Dialogue: 0,0:14:00.27,0:14:04.24,Default,,0,0,0,,Түннің бір уағында далада болдың ба деп уайымдадым...
Dialogue: 0,0:14:04.24,0:14:06.24,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:14:06.24,0:14:08.71,Default,,0,0,0,,Сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,0:14:10.21,0:14:12.21,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:14:12.21,0:14:14.72,Default,,0,0,0,,Суу….
Dialogue: 0,0:14:14.72,0:14:17.22,Default,,0,0,0,,А...үйге қош келдіңіз.
Dialogue: 0,0:14:23.69,0:14:25.69,Default,,0,0,0,,Үлкен аға, күте тұрыңыз!
Dialogue: 0,0:14:26.73,0:14:28.70,Default,,0,0,0,,...
Dialogue: 0,0:14:29.73,0:14:32.70,Default,,0,0,0,,Олай болса, сабақтан кейін отбасылық мейрамханада кездесейік!
Dialogue: 0,0:14:32.70,0:14:35.70,Default,,0,0,0,,ＯＫＫ， Сосын Қаңғыбас мысық бар ма?
Dialogue: 0,0:14:35.70,0:14:38.71,Default,,0,0,0,,Иә! Мегумимен танысыңыз~➡
Dialogue: 0,0:14:38.71,0:14:42.71,Default,,0,0,0,,Ол Blackout көшбасшысы, сондықтан бұл мені үнемі қобалжытады.
Dialogue: 0,0:14:42.71,0:14:45.75,Default,,0,0,0,,Сіз сондайсыз, солай емес пе?
Dialogue: 0,0:14:45.75,0:14:49.72,Default,,0,0,0,,Авангардты бастаушы ретінде мен түсінбеймін.
Dialogue: 0,0:14:49.72,0:14:52.69,Default,,0,0,0,,О...сен әлі бастаушысың ба?
Dialogue: 0,0:14:52.69,0:14:55.69,Default,,0,0,0,,Мен әлі сенен күштімін.
Dialogue: 0,0:14:56.72,0:14:58.69,Default,,0,0,0,,А...ой Хикари!
Dialogue: 0,0:14:59.69,0:15:01.70,Default,,0,0,0,,<Бұл менің күнделікті өмірім>
Dialogue: 0,0:15:01.70,0:15:04.23,Default,,0,0,0,,<Тағдырыңды өзгерт➡
Dialogue: 0,0:15:04.23,0:15:07.74,Default,,0,0,0,,Мен шынымен жасағым келген болашақ>
Dialogue: 0,0:15:09.27,0:15:12.27,Default,,0,0,0,,｟Рахмет, мен Хикаридің арқасында жеңіске жеттім.
Dialogue: 0,0:15:16.21,0:15:18.21,Default,,0,0,0,,Өйткені, менің ағам➡
Dialogue: 0,0:15:18.21,0:15:20.21,Default,,0,0,0,,Менсіз сен жақсы емессің.
Dialogue: 0,0:15:20.21,0:15:23.22,Default,,0,0,0,,Хикари енді не істейді?
Dialogue: 0,0:15:23.22,0:15:25.69,Default,,0,0,0,,Менің тілегім орындалды.
Dialogue: 0,0:15:25.69,0:15:28.19,Default,,0,0,0,,Әрине, мен өз болашағыма қайтамын.
Dialogue: 0,0:15:29.22,0:15:31.73,Default,,0,0,0,,Бірақ бұл сізге...
Dialogue: 0,0:15:31.73,0:15:34.73,Default,,0,0,0,,Артық айтпаңыз. кешіріңіз….
Dialogue: 0,0:15:36.20,0:15:38.20,Default,,0,0,0,,Көріскенше, аға.
Dialogue: 0,0:15:39.20,0:15:41.20,Default,,0,0,0,,Тым абай болмаңыз.
Dialogue: 0,0:15:42.77,0:15:44.77,Default,,0,0,0,,Хикари жақсы жұмыс істейді. ｠
Dialogue: 0,0:15:48.21,0:15:50.21,Default,,0,0,0,,Эй... Акина~➡
Dialogue: 0,0:15:50.21,0:15:52.71,Default,,0,0,0,,Мен ұсынған Микото-саманың MV-ін көрдіңіз бе? ➡
Dialogue: 0,0:15:52.71,0:15:55.22,Default,,0,0,0,,Ең жақсысы емес пе?
Dialogue: 0,0:15:55.22,0:15:57.22,Default,,0,0,0,,Сайто-санның биі керемет болды.
Dialogue: 0,0:15:57.22,0:15:59.72,Default,,0,0,0,,...
Dialogue: 0,0:15:59.72,0:16:01.72,Default,,0,0,0,,➡
Dialogue: 0,0:16:01.72,0:16:04.73,Default,,0,0,0,,сияқты атаумен? Neko Punch сізді қарсы алуға келді➡
Dialogue: 0,0:16:04.73,0:16:06.69,Default,,0,0,0,,...
Dialogue: 0,0:16:07.73,0:16:11.23,Default,,0,0,0,,Жарайды, Акина, мен барып сатып алайын.
Dialogue: 0,0:16:11.23,0:16:14.20,Default,,0,0,0,,Ой, мен бірінші төбеге шығып, сені күтемін➡
Dialogue: 0,0:16:14.20,0:16:16.20,Default,,0,0,0,,Суумен.
Dialogue: 0,0:16:18.21,0:16:20.71,Default,,0,0,0,,… ➡
Dialogue: 0,0:16:20.71,0:16:22.68,Default,,0,0,0,,Тамақтану теңгерімсіз емес пе?
Dialogue: 0,0:16:24.21,0:16:26.18,Default,,0,0,0,,Итадакимасу.
Dialogue: 0,0:16:28.72,0:16:30.72,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:16:30.72,0:16:32.72,Default,,0,0,0,,…
Dialogue: 0,0:16:32.72,0:16:34.69,Default,,0,0,0,,Анамның қуырылған жұмыртқасы үшін.
Dialogue: 0,0:16:36.69,0:16:38.69,Default,,0,0,0,,Апатқа дейінгі жағдайлар➡
Dialogue: 0,0:16:38.69,0:16:40.70,Default,,0,0,0,,Мен мүлде есіме түсіре алмадым.
Dialogue: 0,0:16:40.70,0:16:43.70,Default,,0,0,0,,Бірақ жақында, бірте-бірте ➡
Dialogue: 0,0:16:43.70,0:16:45.70,Default,,0,0,0,,Есте сақтау.
Dialogue: 0,0:16:45.70,0:16:47.70,Default,,0,0,0,,Рахмет саған Акина.
Dialogue: 0,0:16:48.70,0:16:50.71,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:16:50.71,0:16:53.71,Default,,0,0,0,,Сондай-ақ, мен көбірек күрескім келеді.
Dialogue: 0,0:16:53.71,0:16:56.21,Default,,0,0,0,,Қазір жасайық Қазір жасайық.
Dialogue: 0,0:16:56.21,0:16:58.21,Default,,0,0,0,,Мінез-құлық Жаман мінез-құлыққа жол берілмейді!
Dialogue: 0,0:16:58.21,0:17:00.25,Default,,0,0,0,,Тамақтанып бітсем ше?
Dialogue: 0,0:17:00.25,0:17:02.22,Default,,0,0,0,,Онда асығыңыз, мен оны әп-сәтте жеймін.
Dialogue: 0,0:17:02.22,0:17:04.72,Default,,0,0,0,,Мен дәм татсам болады ма?
Dialogue: 0,0:17:04.72,0:17:07.19,Default,,0,0,0,,Ой... не? Мен де араластыруым керек.
Dialogue: 0,0:17:09.22,0:17:12.73,Default,,0,0,0,,А... дұрыс, Акина, сабақтан кейін аркадаға барайық.
Dialogue: 0,0:17:12.73,0:17:15.20,Default,,0,0,0,,Нашар Менің бүгін алдын ала кездесуім бар.
Dialogue: 0,0:17:15.20,0:17:17.20,Default,,0,0,0,,Е...
Dialogue: 0,0:17:17.20,0:17:19.23,Default,,0,0,0,,Менімен карточкалық жекпе-жек➡
Dialogue: 0,0:17:19.23,0:17:22.70,Default,,0,0,0,,Бұл менің көптен бері берген уәдем, оны келісуге болмайды.
Dialogue: 0,0:17:22.70,0:17:24.71,Default,,0,0,0,,E~?
Dialogue: 0,0:17:24.71,0:17:27.71,Default,,0,0,0,,Йоцуги-кун көп сөйлеп тұр!
Dialogue: 0,0:17:27.71,0:17:29.71,Default,,0,0,0,,Un? Ол анық➡
Dialogue: 0,0:17:29.71,0:17:31.71,Default,,0,0,0,,Өйткені біз адамбыз.
Dialogue: 0,0:17:31.71,0:17:33.71,Default,,0,0,0,,Ақина-сенпай, осындасың ба?
Dialogue: 0,0:17:33.71,0:17:37.25,Default,,0,0,0,,Сенпай: Бүгін сабақтан кейін.
Dialogue: 0,0:17:37.25,0:17:40.25,Default,,0,0,0,,Кешіріңіз, Сайто-сан, уақыт дәл қазір сәл ауытқиды...
Dialogue: 0,0:17:42.22,0:17:45.23,Default,,0,0,0,,Микото Сайто Мейдомен достық сөйлесіп жатыр!
Dialogue: 0,0:17:45.23,0:17:48.70,Default,,0,0,0,,Сіз мұны қалай жасадыңыз? Ми Танмен қалай жақын қарым-қатынаста болдыңыз?
Dialogue: 0,0:17:48.70,0:17:51.23,Default,,0,0,0,,Мектептен кейін? Мектептен кейінгі не?
Dialogue: 0,0:17:51.23,0:17:53.70,Default,,0,0,0,,Менеджер арқылы Акина туралы...➡
Dialogue: 0,0:17:53.70,0:17:55.70,Default,,0,0,0,,тыңдап жатырсыз ба?
Dialogue: 0,0:17:58.71,0:18:00.71,Default,,0,0,0,,Хаа...шаршадым.
Dialogue: 0,0:18:00.71,0:18:02.84,Default,,0,0,0,,Кешіріңіз, мен де жалқау болдым...
Dialogue: 0,0:18:02.84,0:18:05.75,Default,,0,0,0,,Мен жаңа ғана ойын-сауық әрекеттерімді қайта бастадым➡
Dialogue: 0,0:18:05.75,0:18:08.22,Default,,0,0,0,,Мен біртүрлі өсек таратпау үшін сақ боламын...
Dialogue: 0,0:18:08.22,0:18:11.22,Default,,0,0,0,,Митан мен Онии-чан арасындағы жанжал?
Dialogue: 0,0:18:11.22,0:18:13.19,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,0:18:14.19,0:18:16.69,Default,,0,0,0,,Балалар сендер өте жассыңдар.
Dialogue: 0,0:18:16.69,0:18:18.73,Default,,0,0,0,,Сіздің тапсырысыңыз қандай?
Dialogue: 0,0:18:18.73,0:18:21.70,Default,,0,0,0,,Сусын барында. Мен де өтінемін.
Dialogue: 0,0:18:21.70,0:18:24.20,Default,,0,0,0,,Сол сияқты. Мен～➡
Dialogue: 0,0:18:24.20,0:18:27.27,Default,,0,0,0,,Күріштің үлкен порциясы бар Деми-глейс гамбургер жинағы!
Dialogue: 0,0:18:27.27,0:18:30.71,Default,,0,0,0,,Және миллион парфет. Мен көп жеймін ...
Dialogue: 0,0:18:30.71,0:18:33.21,Default,,0,0,0,,Өсу кезеңі қызып тұр Алданба.
Dialogue: 0,0:18:34.71,0:18:36.71,Default,,0,0,0,,Сонымен...неге мен➡
Dialogue: 0,0:18:36.71,0:18:38.71,Default,,0,0,0,,Сізден көмек сұрай ма?
Dialogue: 0,0:18:38.71,0:18:41.22,Default,,0,0,0,,Бос емес... бос емес... көмектесіңізші!
Dialogue: 0,0:18:41.22,0:18:43.72,Default,,0,0,0,,Жақсы, бәрі жақсы, бірақ...
Dialogue: 0,0:18:43.72,0:18:45.72,Default,,0,0,0,,Хикари-чан, соңғы уақытта қалайсың?
Dialogue: 0,0:18:45.72,0:18:49.72,Default,,0,0,0,,Менде бәрі жақсы. Ауруханада олар менің сау екенімді айтты.
Dialogue: 0,0:18:49.72,0:18:52.69,Default,,0,0,0,,Тілегімнің орындалғанына шын сенемін.
Dialogue: 0,0:18:52.69,0:18:54.73,Default,,0,0,0,,Түсіндім, бұл жақсы➡
Dialogue: 0,0:18:54.73,0:18:56.70,Default,,0,0,0,,Шынымен. жоғары.
Dialogue: 0,0:18:58.77,0:19:01.74,Default,,0,0,0,,Мен де кешегі Торю кубогында➡
Dialogue: 0,0:19:01.74,0:19:03.74,Default,,0,0,0,,Чемпионатты жеңіп алғаны үшін танылды➡
Dialogue: 0,0:19:03.74,0:19:06.21,Default,,0,0,0,,Мен кәсіби емтиханның соңғы кезеңіне өттім!
Dialogue: 0,0:19:06.21,0:19:08.21,Default,,0,0,0,,E... Сіз мұны жасадыңыз!
Dialogue: 0,0:19:08.21,0:19:10.21,Default,,0,0,0,,Дұрыс па? Кәсібиге дейін➡
Dialogue: 0,0:19:10.21,0:19:12.21,Default,,0,0,0,,Тағы бір қадам басқан сияқты.
Dialogue: 0,0:19:12.21,0:19:14.22,Default,,0,0,0,,Мен саған тамыр жаямын, Нао-сенпай!
Dialogue: 0,0:19:14.22,0:19:16.72,Default,,0,0,0,,Кіші сәулетшіге рахмет.
Dialogue: 0,0:19:16.72,0:19:18.75,Default,,0,0,0,,Нао-сенпай керемет.
Dialogue: 0,0:19:18.75,0:19:21.19,Default,,0,0,0,,Жаңадан бастаушы ретінде мен Тағдыр соғысында жеңе алдым➡
Dialogue: 0,0:19:21.19,0:19:23.26,Default,,0,0,0,,Мұның бәрі менің сенпайымның арқасында!
Dialogue: 0,0:19:23.26,0:19:26.26,Default,,0,0,0,,Бұл болады! Менің айтқым келгені осы➡
Dialogue: 0,0:19:26.26,0:19:28.73,Default,,0,0,0,,Себебі, Аки берілмеді.
Dialogue: 0,0:19:29.73,0:19:31.77,Default,,0,0,0,,Маған бұл ұнамайды!
Dialogue: 0,0:19:31.77,0:19:35.74,Default,,0,0,0,,Тұр, өйткені сен ешқашан берілмейсің, ашылатын жол бар.
Dialogue: 0,0:19:36.70,0:19:38.71,Default,,0,0,0,,Бұл не? сол.
Dialogue: 0,0:19:38.71,0:19:41.21,Default,,0,0,0,,Таңдаулы карта дәмі мәтіні.
Dialogue: 0,0:19:41.21,0:19:43.21,Default,,0,0,0,,Дәмдік мәтін?
Dialogue: 0,0:19:43.21,0:19:46.25,Default,,0,0,0,,Карталар тек күш пен дағдыларға ғана қатысты емес➡
Dialogue: 0,0:19:46.25,0:19:50.22,Default,,0,0,0,,Өмірдегі маңызды нәрселер де жазылған!
Dialogue: 0,0:19:50.22,0:19:52.19,Default,,0,0,0,,Эй, мен оны тексеремін!
Dialogue: 0,0:19:54.22,0:19:57.22,Default,,0,0,0,,Орындалды! Нао-сенпай өтінемін!
Dialogue: 0,0:19:58.19,0:20:00.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:02.23,0:20:05.23,Default,,0,0,0,,Жарайсыңдар! Жақсы аулау!
Dialogue: 0,0:20:08.24,0:20:10.70,Default,,0,0,0,,Нао-сенпай бізге Қаңғыбас мысықта қосылады.
Dialogue: 0,0:20:10.70,0:20:12.71,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:20:12.71,0:20:15.21,Default,,0,0,0,,Жарайды, күресейік. Күресейік, Акина.
Dialogue: 0,0:20:15.21,0:20:17.21,Default,,0,0,0,,Мен түсіндім...
Dialogue: 0,0:20:17.21,0:20:20.21,Default,,0,0,0,,Мен де Митанмен шын төбелескім келеді!
Dialogue: 0,0:20:20.21,0:20:23.18,Default,,0,0,0,,Хе-хе...сені үлкен әбігерге түсіремін~.
Dialogue: 0,0:20:25.72,0:20:29.72,Default,,0,0,0,,Бұл менің қол жеткізгім келген болашақ.
Dialogue: 0,0:20:31.69,0:20:34.20,Default,,0,0,0,,Осы уақытқа дейін рахмет, Рол.
Dialogue: 0,0:20:35.76,0:20:39.23,Default,,0,0,0,,｟Бұл шынымен жақсы ма?
Dialogue: 0,0:20:39.23,0:20:42.70,Default,,0,0,0,,Тағдыр соғысында бір ғана тілек орындалады➡
Dialogue: 0,0:20:42.70,0:20:45.71,Default,,0,0,0,,Сіздің қалауыңыз бір жақты билет.
Dialogue: 0,0:20:45.71,0:20:47.74,Default,,0,0,0,,Мен Акина Мейдоны құтқара алдым деп есептеймін➡
Dialogue: 0,0:20:47.74,0:20:51.25,Default,,0,0,0,,Сіздің бастапқы уақытыңызға оралуыңызға кепілдік жоқ.
Dialogue: 0,0:20:51.25,0:20:54.25,Default,,0,0,0,,Ең нашар жағдайда, уақыт күшінің әсерінен➡
Dialogue: 0,0:20:54.25,0:20:57.22,Default,,0,0,0,,Сіздің бар болуыңыз жоғалып кетуі мүмкін.
Dialogue: 0,0:20:58.72,0:21:02.22,Default,,0,0,0,,Болашақты өзгерткен әлемде мен үшін орын жоқ.
Dialogue: 0,0:21:03.26,0:21:06.73,Default,,0,0,0,,Сонда да ағамның аман болғанын қалаймын!
Dialogue: 0,0:21:08.23,0:21:10.70,Default,,0,0,0,,Мен сенімен кездескім келді, бірақ кездескім келмеді.
Dialogue: 0,0:21:11.77,0:21:13.77,Default,,0,0,0,,Ажырасу ауыр болады. ｠
Dialogue: 0,0:21:15.20,0:21:18.21,Default,,0,0,0,,Гохо...!
Dialogue: 0,0:21:19.34,0:21:21.31,Default,,0,0,0,,｟Өтірік айтқаным үшін кешіріңіз. ｠
Dialogue: 0,0:21:22.71,0:21:25.68,Default,,0,0,0,,Танысқаныма қуаныштымын, аға.
Dialogue: 0,0:21:27.21,0:21:30.72,Default,,0,0,0,,Не болды? Уун, бұл ештеңе емес.
Dialogue: 0,0:21:44.77,0:21:48.24,Default,,0,0,0,,<Маған тағдырымды өзгертуге мүмкіндік берілді>
Dialogue: 0,0:21:49.74,0:21:53.21,Default,,0,0,0,,<Бұл бақыт қалыпты емес>
Dialogue: 0,0:21:54.71,0:21:57.21,Default,,0,0,0,,＜Енді, осы сәт➡
Dialogue: 0,0:21:57.21,0:21:59.71,Default,,0,0,0,,Бұл мен үшін керемет! ＞
Dialogue: 0,0:22:01.22,0:22:03.68,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:23:39.21,0:23:41.72,Default,,0,0,0,,Әлі біткен жоқ.
Dialogue: 0,0:23:41.72,0:23:43.75,Default,,0,0,0,,Себебі➡
Dialogue: 0,0:23:43.75,0:23:47.19,Default,,0,0,0,,Тағдыр соғысын бастаудың шынайы мақсаты➡
Dialogue: 0,0:23:47.19,0:23:49.19,Default,,0,0,0,,Мен жауап алған жоқпын.
Dialogue: 0,0:23:50.19,0:23:52.23,Default,,0,0,0,,Ең жиіркенішті➡
Dialogue: 0,0:23:52.23,0:23:55.26,Default,,0,0,0,,Ерекшелік күрес алаңы➡
Dialogue: 0,0:23:55.26,0:23:57.73,Default,,0,0,0,,Тағдырды айналдыратын карталар мен жауынгерлер...
Dialogue: 0,0:23:58.70,0:24:02.20,Default,,0,0,0,,Мен сізге оны пайдалануға рұқсат етемін, Габриэлиус.
Dialogue: 0,0:24:03.20,0:24:05.21,Default,,0,0,0,,Тағдыр өзгерді.
Dialogue: 0,0:24:05.21,0:24:08.71,Default,,0,0,0,,Келесі шайқастың аты➡
Dialogue: 0,0:24:08.71,0:24:10.71,Default,,0,0,0,,Тағдырлы шайқас!
Dialogue: 0,0:24:12.21,0:24:18.21,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory