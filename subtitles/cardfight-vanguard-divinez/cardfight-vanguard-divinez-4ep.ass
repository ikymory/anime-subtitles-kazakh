Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.23,0:00:07.24,Default,,0,0,0,,Мен оны жақсы көремін.
Dialogue: 0,0:00:08.24,0:00:11.24,Default,,0,0,0,,Бәріне мұхит кінәлі.
Dialogue: 0,0:00:12.24,0:00:15.24,Default,,0,0,0,,Тороро Комбу сүт шайымен бірге ішіңіз!
Dialogue: 0,0:00:15.24,0:00:17.25,Default,,0,0,0,,Митан сүйкімді!
Dialogue: 0,0:00:17.25,0:00:20.25,Default,,0,0,0,,Біз бір мектепте оқимыз, солай ма? Күшті.
Dialogue: 0,0:00:33.26,0:00:35.26,Default,,0,0,0,,О... жастық шақ.
Dialogue: 0,0:00:35.26,0:00:37.27,Default,,0,0,0,,Тыңдаңыз, ол жоғалып кетті емес пе?
Dialogue: 0,0:00:37.27,0:00:39.77,Default,,0,0,0,,Сіз де ғашық болғыңыз келе ме?
Dialogue: 0,0:00:42.27,0:00:44.27,Default,,0,0,0,,Мен мұны істедім деп ойлаймын...
Dialogue: 0,0:00:45.77,0:00:49.78,Default,,0,0,0,,О, сізде жоқ па? Егер сізде бар болса, мені кешіріңіз!
Dialogue: 0,0:00:53.78,0:00:57.29,Default,,0,0,0,,Wa~konnyaro~!
Dialogue: 0,0:00:57.29,0:01:00.79,Default,,0,0,0,,Бірақ менде әлі де көлікті тексеру бар, сондықтан...
Dialogue: 0,0:01:03.23,0:01:05.23,Default,,0,0,0,,Тыныш! Сыни➡
Dialogue: 0,0:01:05.23,0:01:07.23,Default,,0,0,0,,Олай болса, шабуыл жасап көрейік.
Dialogue: 0,0:01:09.73,0:01:11.73,Default,,0,0,0,,Өту...!
Dialogue: 0,0:01:17.24,0:01:19.24,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:01:19.24,0:01:21.28,Default,,0,0,0,,Ятта…!
Dialogue: 0,0:01:21.28,0:01:23.75,Default,,0,0,0,,Ятта~! Un?
Dialogue: 0,0:01:28.25,0:01:30.75,Default,,0,0,0,,Ым?
Dialogue: 0,0:01:46.27,0:01:48.27,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:01:49.27,0:01:51.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:59.78,0:02:02.22,Default,,0,0,0,,Ай!
Dialogue: 0,0:02:02.22,0:02:05.22,Default,,0,0,0,,Қандай болса да! Фуфу~!
Dialogue: 0,0:02:05.22,0:02:09.22,Default,,0,0,0,,Тіпті бөкселерің дірілдейді~ Хэхе~! Ахах...
Dialogue: 0,0:02:09.22,0:02:11.23,Default,,0,0,0,,Мен күткендей!
Dialogue: 0,0:03:43.19,0:03:46.19,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:03:46.19,0:03:48.69,Default,,0,0,0,,Микото, оян.
Dialogue: 0,0:03:48.69,0:03:50.66,Default,,0,0,0,,Мм... ммм.
Dialogue: 0,0:03:52.19,0:03:55.16,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:04:05.71,0:04:07.71,Default,,0,0,0,,Уху.
Dialogue: 0,0:04:07.71,0:04:10.18,Default,,0,0,0,,Мен де бүгін бар күшімді саламын!
Dialogue: 0,0:04:16.22,0:04:18.22,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:04:18.22,0:04:21.72,Default,,0,0,0,,Қайырлы таң. Қайырлы таң Микото-сама.
Dialogue: 0,0:04:21.72,0:04:24.19,Default,,0,0,0,,Уфуфу... тоқташы өтінемін.
Dialogue: 0,0:04:25.23,0:04:28.73,Default,,0,0,0,,Микото Сайто лақап аты - Ми-тан! ➡
Dialogue: 0,0:04:28.73,0:04:31.67,Default,,0,0,0,,Танымал кумир және харизматикалық модель➡
Dialogue: 0,0:04:31.67,0:04:35.17,Default,,0,0,0,,Ол актерлік салаға да кірісті және шетелде өте танымал➡
Dialogue: 0,0:04:35.17,0:04:37.67,Default,,0,0,0,,Бірақ қазір, өйткені мен сабағыма назар аудардым➡
Dialogue: 0,0:04:37.67,0:04:39.67,Default,,0,0,0,,Жергілікті жерде Кагада➡
Dialogue: 0,0:04:39.67,0:04:41.68,Default,,0,0,0,,Оқуына берілген.
Dialogue: 0,0:04:41.68,0:04:44.68,Default,,0,0,0,,Оның қайтып келуін асыға күткен дауыстарда шек жоқ.
Dialogue: 0,0:04:44.68,0:04:46.68,Default,,0,0,0,,Әйелге ұқсайтын және әдемі!
Dialogue: 0,0:04:46.68,0:04:49.18,Default,,0,0,0,,Шынымен де мінсіз сұлу қыз!
Dialogue: 0,0:04:49.18,0:04:52.19,Default,,0,0,0,,Аха~! Мен сені қайта көргім келеді.
Dialogue: 0,0:04:52.19,0:04:54.69,Default,,0,0,0,,Эй, Йоцуги, менімен түскі ас ішуді қалайсың ба?
Dialogue: 0,0:04:54.69,0:04:58.19,Default,,0,0,0,,Ым? Мен саған түскі ас қорабына бір зат беремін.
Dialogue: 0,0:04:58.19,0:05:00.20,Default,,0,0,0,,Бүгін бізде қуырылған тауық еті бар!
Dialogue: 0,0:05:00.20,0:05:02.20,Default,,0,0,0,,Қажет емес.
Dialogue: 0,0:05:02.20,0:05:04.20,Default,,0,0,0,,Аа...
Dialogue: 0,0:05:04.20,0:05:06.70,Default,,0,0,0,,Сіз де ешқашан үйренбейтін жігітсіз.
Dialogue: 0,0:05:06.70,0:05:09.17,Default,,0,0,0,,Мен сенің аңқау екеніңді білемін.
Dialogue: 0,0:05:10.71,0:05:12.71,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:05:12.71,0:05:14.71,Default,,0,0,0,,Хмм...не болды?
Dialogue: 0,0:05:14.71,0:05:16.68,Default,,0,0,0,,Жоқ….
Dialogue: 0,0:05:17.71,0:05:19.71,Default,,0,0,0,,｟Бұл не...?
Dialogue: 0,0:05:19.71,0:05:22.72,Default,,0,0,0,,«Өлім күтіп тұр» деген нені білдіреді?
Dialogue: 0,0:05:22.72,0:05:24.72,Default,,0,0,0,,Дәл сіз не айтасыз➡
Dialogue: 0,0:05:24.72,0:05:27.69,Default,,0,0,0,,Өлгің келмесе, Тағдыр соғысынан бас тарт. ｠
Dialogue: 0,0:05:28.72,0:05:30.66,Default,,0,0,0,,Мағынасы мен түсінбеймін...
Dialogue: 0,0:05:30.66,0:05:32.66,Default,,0,0,0,,Ах! ➡
Dialogue: 0,0:05:32.66,0:05:35.16,Default,,0,0,0,,Ми-тан!
Dialogue: 0,0:05:35.16,0:05:37.67,Default,,0,0,0,,Ым? Хехе….
Dialogue: 0,0:05:37.67,0:05:39.67,Default,,0,0,0,,Хяхахаха~! ➡
Dialogue: 0,0:05:39.67,0:05:42.17,Default,,0,0,0,,Акина...бұл асыл болу сезімі~!
Dialogue: 0,0:05:42.17,0:05:45.14,Default,,0,0,0,,Сізде ең жақсы тұлға бар.
Dialogue: 0,0:06:08.70,0:06:10.67,Default,,0,0,0,,Хаа….
Dialogue: 0,0:06:15.20,0:06:17.71,Default,,0,0,0,,｟Net Vanguard маған ұнайтыны –➡
Dialogue: 0,0:06:17.71,0:06:21.71,Default,,0,0,0,,Өзіңіз болыңыз және желідегі достарыңызбен шынайы сезімдеріңіз туралы сөйлесіңіз➡
Dialogue: 0,0:06:21.71,0:06:24.21,Default,,0,0,0,,Өйткені сіз жарыста байыпты бола аласыз.
Dialogue: 0,0:06:24.21,0:06:27.22,Default,,0,0,0,,Сайто Микото әрқашан➡
Dialogue: 0,0:06:27.22,0:06:29.18,Default,,0,0,0,,Егер ол мінсіз болмаса...
Dialogue: 0,0:06:32.15,0:06:35.12,Default,,0,0,0,,Барлығы Микото Сайто болуы керек деп келіседі.
Dialogue: 0,0:06:40.66,0:06:42.66,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:06:45.17,0:06:48.14,Default,,0,0,0,,Кемел болу және барлығына ұнау...
Dialogue: 0,0:06:50.17,0:06:52.14,Default,,0,0,0,,Бұл мүмкін емес еді. ｠
Dialogue: 0,0:06:55.18,0:06:57.68,Default,,0,0,0,,｟Барлық заттардың тағдыры...
Dialogue: 0,0:06:57.68,0:07:00.68,Default,,0,0,0,,Әдемі…. сұрайық➡
Dialogue: 0,0:07:00.68,0:07:05.69,Default,,0,0,0,,Сіздің шынымен өзгерткіңіз келетін тағдырыңыз бар ма?
Dialogue: 0,0:07:05.69,0:07:08.19,Default,,0,0,0,,Өзіңізді өзгерткіңіз келсе, сізде бар.
Dialogue: 0,0:07:08.19,0:07:11.69,Default,,0,0,0,,Мен... Мен батыл болғым келеді!
Dialogue: 0,0:07:11.69,0:07:15.20,Default,,0,0,0,,Кім болсаң да, өзіңмен мақтана аласың➡
Dialogue: 0,0:07:15.20,0:07:17.17,Default,,0,0,0,,Мен сондай болғым келеді! ｠
Dialogue: 0,0:07:22.70,0:07:24.67,Default,,0,0,0,,E?
Dialogue: 0,0:07:27.71,0:07:30.18,Default,,0,0,0,,Кешіріңіз, менде кенеттен кесте бар.➡
Dialogue: 0,0:07:30.18,0:07:32.15,Default,,0,0,0,,Офлайн жиналысқа бара алмаймын➡
Dialogue: 0,0:07:32.15,0:07:34.65,Default,,0,0,0,,Оның орнына ағам барады➡
Dialogue: 0,0:07:34.65,0:07:37.12,Default,,0,0,0,,Карточканы таңдау Сәттілік!
Dialogue: 0,0:07:39.15,0:07:42.16,Default,,0,0,0,,｟Ха~...Мен ешқашан шынайы карта сатып алған емеспін➡
Dialogue: 0,0:07:42.16,0:07:44.13,Default,,0,0,0,,Мен қобалжыдым. ｠
Dialogue: 0,0:07:46.66,0:07:49.16,Default,,0,0,0,,Мм... АҚШ☆Берри?
Dialogue: 0,0:07:49.16,0:07:51.67,Default,,0,0,0,,Уф! Ол Хикари но Сеншидің ағасы.
Dialogue: 0,0:07:51.67,0:07:54.64,Default,,0,0,0,,Бірдеңені дауыстап айту ұят.
Dialogue: 0,0:07:55.67,0:07:57.64,Default,,0,0,0,,Мм... Сайто Микото?
Dialogue: 0,0:08:02.18,0:08:05.18,Default,,0,0,0,,Уу...буу!
Dialogue: 0,0:08:05.18,0:08:07.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:07.18,0:08:09.18,Default,,0,0,0,,A...Кешіріңіз!
Dialogue: 0,0:08:09.18,0:08:12.19,Default,,0,0,0,,Мм... мынаны қолданыңыз.
Dialogue: 0,0:08:12.19,0:08:14.19,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:08:14.19,0:08:16.16,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:08:18.69,0:08:21.70,Default,,0,0,0,,Бұл Тағдыр картасы ма?
Dialogue: 0,0:08:21.70,0:08:24.20,Default,,0,0,0,,｟Кенеттен білдім~! ｠
Dialogue: 0,0:08:24.20,0:08:27.20,Default,,0,0,0,,Кез келген жағдайда... сіз «Тағдыр соғысының» қатысушысысыз ба?
Dialogue: 0,0:08:27.20,0:08:30.67,Default,,0,0,0,,Мен де! Керемет... таңғажайып сәйкестік.
Dialogue: 0,0:08:32.21,0:08:34.21,Default,,0,0,0,,Менің атым Акина Мейдо.
Dialogue: 0,0:08:34.21,0:08:36.71,Default,,0,0,0,,Сайто-сан, сен палуба салғың келеді, солай ма?
Dialogue: 0,0:08:36.71,0:08:38.68,Default,,0,0,0,,Енді картаны таңдайық!
Dialogue: 0,0:08:39.71,0:08:41.72,Default,,0,0,0,,E….
Dialogue: 0,0:08:41.72,0:08:44.22,Default,,0,0,0,,Бұл адам Мегуми.
Dialogue: 0,0:08:44.22,0:08:47.72,Default,,0,0,0,,Ол карталар туралы көп біледі, сондықтан ол үлкен көмекші болады.
Dialogue: 0,0:08:47.72,0:08:50.23,Default,,0,0,0,,Ун, жүр! Маған қалдырыңыз.
Dialogue: 0,0:08:50.23,0:08:52.23,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:08:52.23,0:08:54.23,Default,,0,0,0,,｟Сіз нені айтасыз? ➡
Dialogue: 0,0:08:54.23,0:08:56.23,Default,,0,0,0,,Біз Ұлы Тағдыр соғысында соғысуымыз мүмкін➡
Dialogue: 0,0:08:56.23,0:08:58.73,Default,,0,0,0,,Олар жау, солай ма? Мен бұл нені білдіретінін түсінбеймін. ｠
Dialogue: 0,0:08:58.73,0:09:01.74,Default,,0,0,0,,Ал... Мен ана жақтағы карталарды қарап жатырмын.
Dialogue: 0,0:09:01.74,0:09:03.71,Default,,0,0,0,,Түсінгеніңізге рахмет.
Dialogue: 0,0:09:05.24,0:09:07.24,Default,,0,0,0,,Мм...мм➡
Dialogue: 0,0:09:07.24,0:09:09.24,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:09:09.24,0:09:11.25,Default,,0,0,0,,Бұлай қобалжымаңыз➡
Dialogue: 0,0:09:11.25,0:09:13.75,Default,,0,0,0,,Сіз қандай палуба салғыңыз келеді?
Dialogue: 0,0:09:13.75,0:09:17.25,Default,,0,0,0,,Ал... Менің ойымда палуба рецепті бар.
Dialogue: 0,0:09:17.25,0:09:20.26,Default,,0,0,0,,Мен онлайн Vanguard ойнаймын.
Dialogue: 0,0:09:20.26,0:09:22.26,Default,,0,0,0,,Хмф….
Dialogue: 0,0:09:22.26,0:09:24.76,Default,,0,0,0,,Эх! ➡
Dialogue: 0,0:09:24.76,0:09:27.26,Default,,0,0,0,,АҚШ☆Берри-сан Митан болды ма?
Dialogue: 0,0:09:27.26,0:09:30.23,Default,,0,0,0,,Тек менің ағам алдап жатыр~➡
Dialogue: 0,0:09:30.23,0:09:33.20,Default,,0,0,0,,Маған келесі жолы офлайн кездесуде кездесуді өтінемін! ➡
Dialogue: 0,0:09:33.20,0:09:35.70,Default,,0,0,0,,Мүлдем! Мен түссіндім.
Dialogue: 0,0:09:35.70,0:09:37.67,Default,,0,0,0,,Оны кесу уақыты келді.
Dialogue: 0,0:09:39.21,0:09:42.21,Default,,0,0,0,,Палубаңыз аяқталғаннан кейін оны сынап көргіңіз келмейді ме?
Dialogue: 0,0:09:42.21,0:09:44.71,Default,,0,0,0,,Бірақ бұл жайсыздық емес пе...?
Dialogue: 0,0:09:44.71,0:09:47.22,Default,,0,0,0,,Жарайды...! Менің де дүкенде бос уақытым болады.
Dialogue: 0,0:09:47.22,0:09:49.22,Default,,0,0,0,,Олай болса, өтінемін!
Dialogue: 0,0:09:49.22,0:09:51.72,Default,,0,0,0,,А...Онда мен алдымен үйге барамын.
Dialogue: 0,0:09:51.72,0:09:53.72,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:53.72,0:09:55.72,Default,,0,0,0,,Жоқ...ол.
Dialogue: 0,0:09:55.72,0:09:57.73,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ.➡
Dialogue: 0,0:09:57.73,0:10:00.23,Default,,0,0,0,,Мен де кешегі жекпе-жекті көрдім.
Dialogue: 0,0:10:00.23,0:10:02.23,Default,,0,0,0,,Е…. Және➡
Dialogue: 0,0:10:02.23,0:10:04.23,Default,,0,0,0,,Мені олар көрсе де ұтылмаймын деп ойлаймын.
Dialogue: 0,0:10:04.23,0:10:06.23,Default,,0,0,0,,Мен айтамын~➡
Dialogue: 0,0:10:06.23,0:10:08.24,Default,,0,0,0,,Олай болса, ойынды көруге рұқсат етіңіз.
Dialogue: 0,0:10:08.24,0:10:11.24,Default,,0,0,0,,Кун Кун... Акина-кун, жақсы иіс емес пе?
Dialogue: 0,0:10:11.24,0:10:14.24,Default,,0,0,0,,Аа, мүмкін... Тороро ламинария сүтті шай.
Dialogue: 0,0:10:14.24,0:10:16.21,Default,,0,0,0,,Ым?
Dialogue: 0,0:10:17.25,0:10:19.75,Default,,0,0,0,,Олай болса... бастайық!
Dialogue: 0,0:10:19.75,0:10:22.22,Default,,0,0,0,,Сәлем! рақмет сізге.
Dialogue: 0,0:10:23.25,0:10:25.22,Default,,0,0,0,,Тұрақты авангард.
Dialogue: 0,0:10:28.66,0:10:31.16,Default,,0,0,0,,Ғажайып лаванда Уршур.
Dialogue: 0,0:10:31.16,0:10:33.16,Default,,0,0,0,,Ағаш мүйізді аң Роте.
Dialogue: 0,0:10:33.16,0:10:35.66,Default,,0,0,0,,Менің кезегім... ұтыс➡
Dialogue: 0,0:10:35.66,0:10:38.67,Default,,0,0,0,,Жанды теңіз Тиффиніне мініңіз➡
Dialogue: 0,0:10:38.67,0:10:42.17,Default,,0,0,0,,Энергия генераторын орнатыңыз және бұрылысты аяқтаңыз.
Dialogue: 0,0:10:42.17,0:10:45.67,Default,,0,0,0,,｟Осы уақытқа дейін мен тек онлайн төбелесіп едім➡
Dialogue: 0,0:10:45.67,0:10:49.68,Default,,0,0,0,,Мен «Тағдыр соғысы» басталмай тұрып, шынайы әлемге үйренуім керек. ｠
Dialogue: 0,0:10:49.68,0:10:51.68,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:10:51.68,0:10:54.18,Default,,0,0,0,,Гүлдеп тұрған мүйізді аңға мін, Чарис➡
Dialogue: 0,0:10:54.18,0:10:58.19,Default,,0,0,0,,Энергия генераторын орнатыңыз және энергияны зарядтаңыз➡
Dialogue: 0,0:10:58.19,0:11:00.15,Default,,0,0,0,,Чалиспен шабуыл.
Dialogue: 0,0:11:00.15,0:11:02.12,Default,,0,0,0,,Күзетсіз➡
Dialogue: 0,0:11:02.12,0:11:04.13,Default,,0,0,0,,Зақымдануды тексеру.
Dialogue: 0,0:11:04.13,0:11:06.13,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:11:06.13,0:11:09.13,Default,,0,0,0,,Менің кезегім…Энергия заряды➡
Dialogue: 0,0:11:09.13,0:11:11.63,Default,,0,0,0,,Өзіне сенімді аква мусеттаға мініңіз➡
Dialogue: 0,0:11:11.63,0:11:15.14,Default,,0,0,0,,Агнесті палубаның жоғарғы жағынан шақыру үшін Тиффиннің шеберлігін пайдаланыңыз.
Dialogue: 0,0:11:15.14,0:11:17.14,Default,,0,0,0,,Мюсеттпен шабуыл!
Dialogue: 0,0:11:17.14,0:11:19.14,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:11:19.14,0:11:21.14,Default,,0,0,0,,Драйверді тексеру.
Dialogue: 0,0:11:21.14,0:11:23.14,Default,,0,0,0,,Агнеспен шабуыл.
Dialogue: 0,0:11:23.14,0:11:25.65,Default,,0,0,0,,Күзетші. Бұл кезектің соңы.
Dialogue: 0,0:11:25.65,0:11:28.15,Default,,0,0,0,,Сіз қалай ойлайсыз? Шынайы өмірдегі карточкалық төбелес.
Dialogue: 0,0:11:28.15,0:11:31.15,Default,,0,0,0,,Мен... Мен мұны үнемі істеп жүрген сияқтымын➡
Dialogue: 0,0:11:31.15,0:11:33.66,Default,,0,0,0,,Бұл өте сергек және біртүрлі сезінеді➡
Dialogue: 0,0:11:33.66,0:11:37.16,Default,,0,0,0,,Картаны тарту кезінде Картаны жылжытқанда Картаны аударғанда...
Dialogue: 0,0:11:37.16,0:11:41.66,Default,,0,0,0,,Мен мұны нақты түсіндіре алмаймын, бірақ қызуым көтеріліп бара жатқан сияқты.
Dialogue: 0,0:11:41.66,0:11:43.67,Default,,0,0,0,,Ум! Нақты және онлайн➡
Dialogue: 0,0:11:43.67,0:11:46.13,Default,,0,0,0,,Екеуінің де өзіндік еңбегі бар.
Dialogue: 0,0:11:48.17,0:11:50.67,Default,,0,0,0,,Нидің ағаш мүйізді аңы Латисске мініңіз➡
Dialogue: 0,0:11:50.67,0:11:52.67,Default,,0,0,0,,Чарис дағдысын іске қосыңыз➡
Dialogue: 0,0:11:52.67,0:11:54.68,Default,,0,0,0,,Палубаның жоғарғы үш картасынан Гюносураға қоңырау шалыңыз➡
Dialogue: 0,0:11:54.68,0:11:56.68,Default,,0,0,0,,Тормен шабуыл.
Dialogue: 0,0:11:56.68,0:11:58.68,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:11:58.68,0:12:01.12,Default,,0,0,0,,Гюносурамен шабуыл! күзетші.
Dialogue: 0,0:12:01.12,0:12:03.12,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:12:03.12,0:12:05.62,Default,,0,0,0,,｟Қызық, неге... бұл қарсылас болса да мен күресіп жатырмын➡
Dialogue: 0,0:12:05.62,0:12:08.12,Default,,0,0,0,,Аздап жылы. ｠
Dialogue: 0,0:12:08.12,0:12:10.12,Default,,0,0,0,,біздің қамқорлығымызға Джудзцу техникалық колледжінде алынады.
Dialogue: 0,0:12:10.12,0:12:12.63,Default,,0,0,0,,Мен де басқа адамға қызығамын.
Dialogue: 0,0:12:12.63,0:12:14.63,Default,,0,0,0,,Егер бұл шын болса... Дұрыс➡
Dialogue: 0,0:12:14.63,0:12:17.63,Default,,0,0,0,,Хмм... жүректерімізді қосу үшін күрес ➡
Dialogue: 0,0:12:17.63,0:12:19.63,Default,,0,0,0,,Бұл Blackout стилі!
Dialogue: 0,0:12:19.63,0:12:21.64,Default,,0,0,0,,Өшіру?
Dialogue: 0,0:12:21.64,0:12:24.64,Default,,0,0,0,,А...Мен Блэкаут командасының жетекшісімін.
Dialogue: 0,0:12:24.64,0:12:26.64,Default,,0,0,0,,Бұл өшіп қалу ма? ➡
Dialogue: 0,0:12:26.64,0:12:29.14,Default,,0,0,0,,Бұл ең күшті сынып командасы емес пе?
Dialogue: 0,0:12:29.14,0:12:31.65,Default,,0,0,0,,Бұл асыра айтқандық шығар.
Dialogue: 0,0:12:31.65,0:12:33.65,Default,,0,0,0,,｟Күтіңіз...! ➡
Dialogue: 0,0:12:33.65,0:12:35.65,Default,,0,0,0,,Кенет бұл соңғы бастық! ➡
Dialogue: 0,0:12:35.65,0:12:37.65,Default,,0,0,0,,Бұл ақымақ...бұл не? ➡
Dialogue: 0,0:12:37.65,0:12:39.65,Default,,0,0,0,,Бұл шынымен жеңіске жетуді қалайтын адам. ｠
Dialogue: 0,0:12:39.65,0:12:41.66,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:12:41.66,0:12:44.16,Default,,0,0,0,,Жарқыра, үнемі өзгеріп тұратын рефлексиялардың калейдоскопы! ➡
Dialogue: 0,0:12:44.16,0:12:47.63,Default,,0,0,0,,Тағдырлы Крис Рейнге мініңіз!
Dialogue: 0,0:12:52.17,0:12:54.17,Default,,0,0,0,,｟Тағдыр картасы пайда болды. ｠
Dialogue: 0,0:12:54.17,0:12:58.17,Default,,0,0,0,,Палубаның жоғарғы жағынан Альбинаны шақыру үшін Мюсетт шеберлігін пайдаланыңыз.
Dialogue: 0,0:12:58.17,0:13:01.11,Default,,0,0,0,,Фаустина мен Юикаға қоңырау шалыңыз.
Dialogue: 0,0:13:01.11,0:13:03.11,Default,,0,0,0,,Крис Рейн шеберлігін белсендіру➡
Dialogue: 0,0:13:03.11,0:13:06.61,Default,,0,0,0,,Бірліктер түрлерінің санына қарай әсер артады➡
Dialogue: 0,0:13:06.61,0:13:09.12,Default,,0,0,0,,Менің өлшем бірліктерім 5 түрлі Сондықтан ➡
Dialogue: 0,0:13:09.12,0:13:11.62,Default,,0,0,0,,Үш әсер қосылды! ➡
Dialogue: 0,0:13:11.62,0:13:14.62,Default,,0,0,0,,1...1 картаны сал, 3 картаны зарядта➡
Dialogue: 0,0:13:14.62,0:13:18.63,Default,,0,0,0,,Екі... Крис Рейннің күші плюс 15 000!
Dialogue: 0,0:13:18.63,0:13:21.60,Default,,0,0,0,,Үш…Критикалық плюс 1!
Dialogue: 0,0:13:23.63,0:13:27.14,Default,,0,0,0,,｟Карталардың түрлері көп болған сайын күшейетін дағды.
Dialogue: 0,0:13:27.14,0:13:31.64,Default,,0,0,0,,Тізімді көргенде...Мен бұл әдеттен тыс палуба құрылысы деп ойладым.
Dialogue: 0,0:13:31.64,0:13:35.11,Default,,0,0,0,,Бұл ұтыс ставкасын шамалы арттыру үшін бірлік саны ма? ｠
Dialogue: 0,0:13:36.14,0:13:38.15,Default,,0,0,0,,Крис Рейнмен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:13:38.15,0:13:40.15,Default,,0,0,0,,Толық күзет.
Dialogue: 0,0:13:40.15,0:13:42.15,Default,,0,0,0,,Бірінші тексеру.
Dialogue: 0,0:13:42.15,0:13:44.15,Default,,0,0,0,,Екінші тексеру.
Dialogue: 0,0:13:44.15,0:13:46.65,Default,,0,0,0,,Критикалық триггер! Фаустинаның күші плюс 10000➡
Dialogue: 0,0:13:46.65,0:13:48.66,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:13:48.66,0:13:51.16,Default,,0,0,0,,Ой... жақсы толқындар келе жатыр!
Dialogue: 0,0:13:51.16,0:13:53.66,Default,,0,0,0,,Маған осы толқынды айдауға рұқсат етіңіз! ➡
Dialogue: 0,0:13:53.66,0:13:56.16,Default,,0,0,0,,Агнеспен шабуыл! күзетші.
Dialogue: 0,0:13:56.16,0:13:59.17,Default,,0,0,0,,➡
Dialogue: 0,0:13:59.17,0:14:01.60,Default,,0,0,0,,Фаустинамен шабуыл.
Dialogue: 0,0:14:01.60,0:14:04.11,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:14:04.11,0:14:06.61,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:14:06.61,0:14:08.61,Default,,0,0,0,,｟Қолыңыздан келгенді қорғаңыз ➡
Dialogue: 0,0:14:08.61,0:14:11.11,Default,,0,0,0,,Зақымдануды азайту...
Dialogue: 0,0:14:11.11,0:14:13.11,Default,,0,0,0,,Ол төбелесуге әбден үйренген.
Dialogue: 0,0:14:13.11,0:14:15.12,Default,,0,0,0,,Өте күшті. ｠
Dialogue: 0,0:14:15.12,0:14:17.12,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:14:17.12,0:14:19.12,Default,,0,0,0,,➡
Dialogue: 0,0:14:19.12,0:14:23.12,Default,,0,0,0,,Латисс шеберлігін қолдана отырып, қолыңызға тамшыдан Магнолия ақсақалын қосыңыз➡
Dialogue: 0,0:14:23.12,0:14:25.63,Default,,0,0,0,,➡
Dialogue: 0,0:14:25.63,0:14:27.63,Default,,0,0,0,,1 картаны салыңыз➡
Dialogue: 0,0:14:27.63,0:14:29.63,Default,,0,0,0,,➡
Dialogue: 0,0:14:29.63,0:14:32.13,Default,,0,0,0,,➡
Dialogue: 0,0:14:32.13,0:14:35.60,Default,,0,0,0,,...
Dialogue: 0,0:14:38.14,0:14:41.64,Default,,0,0,0,,Гуо~!
Dialogue: 0,0:14:41.64,0:14:44.65,Default,,0,0,0,,Кенеттен 4-сынып? 3-тен жоғары ма?
Dialogue: 0,0:14:44.65,0:14:46.65,Default,,0,0,0,,Міне! Міне осы! ➡
Dialogue: 0,0:14:46.65,0:14:50.15,Default,,0,0,0,,➡
Dialogue: 0,0:14:50.15,0:14:52.15,Default,,0,0,0,,Банаспатиске➡ қоңырау шалыңыз
Dialogue: 0,0:14:52.15,0:14:54.66,Default,,0,0,0,,Дағдыны белсендіру Авангард 4-сынып ➡
Dialogue: 0,0:14:54.66,0:14:58.16,Default,,0,0,0,,...
Dialogue: 0,0:14:58.16,0:15:01.60,Default,,0,0,0,,А...Магнолия ақсақал.
Dialogue: 0,0:15:01.60,0:15:04.60,Default,,0,0,0,,➡
Dialogue: 0,0:15:04.60,0:15:07.60,Default,,0,0,0,,６
Dialogue: 0,0:15:07.60,0:15:10.10,Default,,0,0,0,,Уфуфу… Керемет жауап.
Dialogue: 0,0:15:10.10,0:15:12.07,Default,,0,0,0,,...
Dialogue: 0,0:15:14.11,0:15:16.11,Default,,0,0,0,,｟Мен не істеуім керек... күзетші? ➡
Dialogue: 0,0:15:16.11,0:15:18.08,Default,,0,0,0,,Күзет алғың келсе, оны қалай қорғайсың? ｠
Dialogue: 0,0:15:21.62,0:15:23.58,Default,,0,0,0,,Ой...
Dialogue: 0,0:15:25.12,0:15:27.62,Default,,0,0,0,,Иә? Бұл...шын еді.
Dialogue: 0,0:15:27.62,0:15:29.62,Default,,0,0,0,,Мүмкін... а....
Dialogue: 0,0:15:29.62,0:15:31.63,Default,,0,0,0,,...
Dialogue: 0,0:15:31.63,0:15:34.13,Default,,0,0,0,,Ах! Менің әдеттегі әдеттерім сияқты.
Dialogue: 0,0:15:34.13,0:15:36.13,Default,,0,0,0,,➡
Dialogue: 0,0:15:36.13,0:15:38.63,Default,,0,0,0,,...
Dialogue: 0,0:15:38.63,0:15:42.64,Default,,0,0,0,,➡
Dialogue: 0,0:15:42.64,0:15:45.64,Default,,0,0,0,,...
Dialogue: 0,0:15:45.64,0:15:48.64,Default,,0,0,0,,Сәлем! Сіз көре алатын триггерлер саны➡
Dialogue: 0,0:15:48.64,0:15:50.65,Default,,0,0,0,,Маған айтып беруіңізді сұрай аламын ба?
Dialogue: 0,0:15:50.65,0:15:53.15,Default,,0,0,0,,Тамшыда екі тарту триггері.
Dialogue: 0,0:15:53.15,0:15:55.65,Default,,0,0,0,,｟Мен түсінемін. Критикалық сан - 0. ｠
Dialogue: 0,0:15:55.65,0:15:58.15,Default,,0,0,0,,Бұл күзетші.
Dialogue: 0,0:15:58.15,0:16:00.12,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:16:00.12,0:16:02.09,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:16:02.09,0:16:04.59,Default,,0,0,0,,Емдеу триггері...1 зақымдануды қалпына келтіреді➡
Dialogue: 0,0:16:04.59,0:16:07.09,Default,,0,0,0,,Гюносураның күші плюс 10 000.
Dialogue: 0,0:16:07.09,0:16:09.10,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:16:09.10,0:16:11.10,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:16:11.10,0:16:13.10,Default,,0,0,0,,Кіріс импульсінің қуаты плюс 10000➡
Dialogue: 0,0:16:13.10,0:16:15.10,Default,,0,0,0,,Тордың критикалық плюс 1.
Dialogue: 0,0:16:15.10,0:16:17.10,Default,,0,0,0,,｟Бұл сыни болады.
Dialogue: 0,0:16:17.10,0:16:20.11,Default,,0,0,0,,Осыдан кейін сіз 5 рет шабуыл жасай аласыз! ｠
Dialogue: 0,0:16:20.11,0:16:24.11,Default,,0,0,0,,Гюносурамен шабуыл жасау шеберлігі Латиске 25 000 қуат қосады.
Dialogue: 0,0:16:24.11,0:16:26.11,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:16:26.11,0:16:29.62,Default,,0,0,0,,Банаспатиспен шабуыл. Күзет және тосқауыл!
Dialogue: 0,0:16:29.62,0:16:33.12,Default,,0,0,0,,Кіріс импульсі бар шабуыл. Күзет жоқ!
Dialogue: 0,0:16:33.12,0:16:36.12,Default,,0,0,0,,Тормен шабуыл! Толық күзетші!
Dialogue: 0,0:16:36.12,0:16:39.63,Default,,0,0,0,,Альпімен шабуыл! Күзетші жоқ.
Dialogue: 0,0:16:39.63,0:16:41.63,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:16:41.63,0:16:43.63,Default,,0,0,0,,｟Күшті...!
Dialogue: 0,0:16:43.63,0:16:45.63,Default,,0,0,0,,Өйткені, бұл адам соңғы бастық!
Dialogue: 0,0:16:45.63,0:16:49.14,Default,,0,0,0,,тағы 4 зақымдану нүктесі, бұл өте қиын ➡
Dialogue: 0,0:16:49.14,0:16:51.11,Default,,0,0,0,,Бізде мұны істеуден басқа амал жоқ! ｠
Dialogue: 0,0:16:56.14,0:16:58.65,Default,,0,0,0,,｟Мен мұны істей аламын! ｠
Dialogue: 0,0:16:58.65,0:17:01.12,Default,,0,0,0,,｟Атмосфера өзгерді...? ｠
Dialogue: 0,0:17:02.65,0:17:04.65,Default,,0,0,0,,｟Төмен қара➡
Dialogue: 0,0:17:04.65,0:17:07.62,Default,,0,0,0,,Жеңіс мүмкіндігі Әрбір тамшыны алыңыз. ｠
Dialogue: 0,0:17:10.66,0:17:13.16,Default,,0,0,0,,Persona Ride! Крис Лейн.
Dialogue: 0,0:17:13.16,0:17:15.66,Default,,0,0,0,,Агнеске қоңырау шалу дағдысын белсендіру➡
Dialogue: 0,0:17:15.66,0:17:17.63,Default,,0,0,0,,Палубаның жоғарғы бес картасын қараңыз...
Dialogue: 0,0:17:18.67,0:17:21.17,Default,,0,0,0,,Міне... мен күткендей!
Dialogue: 0,0:17:21.17,0:17:23.17,Default,,0,0,0,,Мамырға қоңырау шалыңыз!
Dialogue: 0,0:17:23.17,0:17:25.17,Default,,0,0,0,,｟Ақиқат ақыры шықты. ｠
Dialogue: 0,0:17:25.17,0:17:28.68,Default,,0,0,0,,Крис Рейн шеберлігінің 5 түрі бар➡
Dialogue: 0,0:17:28.68,0:17:30.68,Default,,0,0,0,,Үш әсер қосылды➡
Dialogue: 0,0:17:30.68,0:17:33.68,Default,,0,0,0,,1 картаны салыңыз Энергия заряды 3 карта➡
Dialogue: 0,0:17:33.68,0:17:37.65,Default,,0,0,0,,Крис Рейннің күші плюс 15000 критикалық плюс 1!
Dialogue: 0,0:17:38.69,0:17:40.69,Default,,0,0,0,,Таммузға қоңырау шалыңыз. Кәне!
Dialogue: 0,0:17:40.69,0:17:42.69,Default,,0,0,0,,Агнеспен шабуыл!
Dialogue: 0,0:17:42.69,0:17:45.69,Default,,0,0,0,,Қуат және дағдылары бар 10 000! күзетші.
Dialogue: 0,0:17:45.69,0:17:47.70,Default,,0,0,0,,｜ Бұл жолы тылдағы шабуыл? ➡
Dialogue: 0,0:17:47.70,0:17:50.70,Default,,0,0,0,,Бұл қосымша шабуыл дағдылары бар дегенді білдіреді. ｠
Dialogue: 0,0:17:50.70,0:17:54.20,Default,,0,0,0,,Визмайдың шабуыл шеберлігіне 15 000 қуат қосыңыз.
Dialogue: 0,0:17:54.20,0:17:56.70,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:17:56.70,0:17:58.67,Default,,0,0,0,,Крис Рейнмен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:18:03.14,0:18:05.11,Default,,0,0,0,,Күзет және тосқауыл қой!
Dialogue: 0,0:18:08.15,0:18:10.65,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:18:10.65,0:18:12.65,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:18:12.65,0:18:14.66,Default,,0,0,0,,Ха... Құдай тартады~! ➡
Dialogue: 0,0:18:14.66,0:18:16.66,Default,,0,0,0,,Критикалық триггер! ➡
Dialogue: 0,0:18:16.66,0:18:19.66,Default,,0,0,0,,Крис Рейннің күші плюс 10000 критикалық плюс 1!
Dialogue: 0,0:18:19.66,0:18:23.66,Default,,0,0,0,,Бірақ сіз авангардқа қарсы ойнасаңыз да, қарауылдан өте алмайсыз, солай ма?
Dialogue: 0,0:18:23.66,0:18:26.17,Default,,0,0,0,,Дәл қазір...бірақ мен әлі солаймын➡
Dialogue: 0,0:18:26.17,0:18:28.14,Default,,0,0,0,,Жарқырай берейік!
Dialogue: 0,0:18:29.67,0:18:31.67,Default,,0,0,0,,Керемет! ➡
Dialogue: 0,0:18:31.67,0:18:33.64,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:18:35.18,0:18:37.18,Default,,0,0,0,,Тәңірлік шеберлік?
Dialogue: 0,0:18:37.18,0:18:39.68,Default,,0,0,0,,Бұл жекпе-жек кезінде бір рет қана қолдануға болатын дағды.
Dialogue: 0,0:18:39.68,0:18:42.68,Default,,0,0,0,,Барлық артқы қорғаушыларды қолыңызға қайтарыңыз➡
Dialogue: 0,0:18:42.68,0:18:45.19,Default,,0,0,0,,Визмайға сол қолынан қоңырау шалыңыз➡
Dialogue: 0,0:18:45.19,0:18:49.19,Default,,0,0,0,,Висмейдің күші мен сыни күшін Крис Рейн сияқты етіп жасаңыз.
Dialogue: 0,0:18:49.19,0:18:51.19,Default,,0,0,0,,Сіз нені айтасыз...?
Dialogue: 0,0:18:51.19,0:18:53.69,Default,,0,0,0,,Қуат 48000 Критикалық 3!
Dialogue: 0,0:18:53.69,0:18:55.70,Default,,0,0,0,,Сіздің мақсатыңыз осы ма?
Dialogue: 0,0:18:55.70,0:18:58.20,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:18:58.20,0:19:00.17,Default,,0,0,0,,Визмеймен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:19:00.17,0:19:02.64,Default,,0,0,0,,Қуат және дағдылары бар 15 000!
Dialogue: 0,0:19:02.64,0:19:04.64,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:19:04.64,0:19:06.61,Default,,0,0,0,,Зақымдануды тексеру….
Dialogue: 0,0:19:08.14,0:19:10.11,Default,,0,0,0,,Триггер жоқ….
Dialogue: 0,0:19:12.15,0:19:14.15,Default,,0,0,0,,Мен жеңдім!
Dialogue: 0,0:19:14.15,0:19:16.15,Default,,0,0,0,,Бұл өте ақылсыз болды!
Dialogue: 0,0:19:16.15,0:19:18.15,Default,,0,0,0,,Мен жеңілдім~➡
Dialogue: 0,0:19:18.15,0:19:20.65,Default,,0,0,0,,Соңында олар қатты толқыды.
Dialogue: 0,0:19:20.65,0:19:22.66,Default,,0,0,0,,Ха~! Кешіріңіз➡
Dialogue: 0,0:19:22.66,0:19:25.16,Default,,0,0,0,,Құрмет тілі сәл шалғай болды емес пе? ➡
Dialogue: 0,0:19:25.16,0:19:27.16,Default,,0,0,0,,Үйде жүргендей болдым...!
Dialogue: 0,0:19:27.16,0:19:29.16,Default,,0,0,0,,Мен абай болдым! Мен не істеуім керек...
Dialogue: 0,0:19:29.16,0:19:31.67,Default,,0,0,0,,Қазірдің өзінде! Ол мүлдем жақсы деді.
Dialogue: 0,0:19:31.67,0:19:33.67,Default,,0,0,0,,Бұл өте қызық болды! жұмысшы?
Dialogue: 0,0:19:33.67,0:19:36.14,Default,,0,0,0,,Оны мінгендегі сезім керемет болды!
Dialogue: 0,0:19:38.17,0:19:40.67,Default,,0,0,0,,｟Күшті...Барлық нәрсенің тағдыры осындай➡
Dialogue: 0,0:19:40.67,0:19:43.68,Default,,0,0,0,,Мен кіммен төбелесетінімді білдім➡
Dialogue: 0,0:19:43.68,0:19:46.18,Default,,0,0,0,,Олар тек күшті жау болуы керек➡
Dialogue: 0,0:19:46.18,0:19:49.18,Default,,0,0,0,,Мұндай жағдайда мен соңына жетемін➡
Dialogue: 0,0:19:49.18,0:19:51.15,Default,,0,0,0,,Біз аман қалуымыз керек. ｠
Dialogue: 0,0:19:55.69,0:19:58.19,Default,,0,0,0,,Бүгінгі күн үшін көп рахмет.
Dialogue: 0,0:19:58.19,0:20:01.16,Default,,0,0,0,,Мектепте кездескенше... Ақина-сенпай!
Dialogue: 0,0:20:02.63,0:20:04.63,Default,,0,0,0,,Мм...қайтадан.
Dialogue: 0,0:20:04.63,0:20:06.63,Default,,0,0,0,,Ой... ой!
Dialogue: 0,0:20:06.63,0:20:08.64,Default,,0,0,0,,Ой Ақина~! О...о?
Dialogue: 0,0:20:08.64,0:20:10.64,Default,,0,0,0,,Сен неге Микото-самамен біргесің?
Dialogue: 0,0:20:10.64,0:20:13.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:13.14,0:20:15.14,Default,,0,0,0,,Сіздің қазіргі күлімсіреуіңіз нені білдіреді?
Dialogue: 0,0:20:15.14,0:20:18.61,Default,,0,0,0,,Акина~! Эй? Акина~!
Dialogue: 0,0:20:20.15,0:20:22.65,Default,,0,0,0,,Егер Zero Fate➡ пайдалануды жалғастырсаңыз
Dialogue: 0,0:20:22.65,0:20:25.65,Default,,0,0,0,,Бұдан кейін де өлім күтіп тұр.
Dialogue: 0,0:20:25.65,0:20:29.66,Default,,0,0,0,,Өлгің келмесе, Тағдыр соғысынан бас тарт➡
Dialogue: 0,0:20:29.66,0:20:31.66,Default,,0,0,0,,Мен сен үшін өмірімді қатерге тігемін➡
Dialogue: 0,0:20:31.66,0:20:34.66,Default,,0,0,0,,Тағдыр соғысына қатысуға себеп бар ма?
Dialogue: 0,0:20:34.66,0:20:36.66,Default,,0,0,0,,Жоқ. Содан кейін...
Dialogue: 0,0:20:36.66,0:20:38.67,Default,,0,0,0,,Менде ештеңе жоқ➡
Dialogue: 0,0:20:38.67,0:20:40.67,Default,,0,0,0,,Себептер мен тілектер➡
Dialogue: 0,0:20:40.67,0:20:43.17,Default,,0,0,0,,Қорқыныш жоқ...ештеңе.
Dialogue: 0,0:20:43.17,0:20:45.17,Default,,0,0,0,,Мм? Маған қызық емес➡
Dialogue: 0,0:20:45.17,0:20:48.14,Default,,0,0,0,,Мені тағдыр таңдады.
Dialogue: 0,0:20:50.18,0:20:52.68,Default,,0,0,0,,Дәл осы себептен бе? Түсінудің қажеті жоқ.
Dialogue: 0,0:20:52.68,0:20:54.68,Default,,0,0,0,,Мен де білмеймін.
Dialogue: 0,0:20:54.68,0:20:57.69,Default,,0,0,0,,Қанағаттанбасаң, тағы бір рет тағдыр шешсін.
Dialogue: 0,0:20:57.69,0:21:00.15,Default,,0,0,0,,А...не туралы айтып тұрсың?
Dialogue: 0,0:21:00.15,0:21:03.62,Default,,0,0,0,,Мен осы картадан бір картаны тартамын.
Dialogue: 0,0:21:03.62,0:21:06.63,Default,,0,0,0,,Бір ғана тағдырлы карта бар. Егер сіз басқа картаны тартсаңыз➡
Dialogue: 0,0:21:06.63,0:21:09.10,Default,,0,0,0,,Қалағаныңызша бас тартамын.
Dialogue: 0,0:21:10.13,0:21:12.63,Default,,0,0,0,,Бірақ...Тағдырды салсам➡
Dialogue: 0,0:21:12.63,0:21:14.60,Default,,0,0,0,,Тағдыр соғысына қатысыңыз.
Dialogue: 0,0:21:15.64,0:21:18.14,Default,,0,0,0,,Араластыру.
Dialogue: 0,0:21:18.14,0:21:20.64,Default,,0,0,0,,Сіз өз тағдырыңызды карталарға тапсырасыз ба?
Dialogue: 0,0:21:20.64,0:21:23.61,Default,,0,0,0,,Егер одан тыс нәрсе болса.
Dialogue: 0,0:21:31.15,0:21:33.12,Default,,0,0,0,,Жауап беріледі.
Dialogue: 0,0:21:39.16,0:21:41.16,Default,,0,0,0,,（📱）
Dialogue: 0,0:21:41.16,0:21:43.66,Default,,0,0,0,,Мм... ммм.
Dialogue: 0,0:21:43.66,0:21:45.63,Default,,0,0,0,,Ым?
Dialogue: 0,0:21:56.18,0:21:58.15,Default,,0,0,0,,Менің кезегім келді...
Dialogue: 0,0:21:59.65,0:22:05.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory