Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.83,0:00:05.77,Default,,0,0,0,,Өйткені Кент талап етеді➡
Dialogue: 0,0:00:05.77,0:00:07.80,Default,,0,0,0,,Мен Сайто мырзаны➡ таныстырдым
Dialogue: 0,0:00:07.80,0:00:10.77,Default,,0,0,0,,Ол үндемейді.
Dialogue: 0,0:00:10.77,0:00:13.38,Default,,0,0,0,,Хе-хе... қобалжыған шығар.
Dialogue: 0,0:00:13.38,0:00:15.84,Default,,0,0,0,,Сонда да Сайто мырза маған құдайдай қарады➡
Dialogue: 0,0:00:15.84,0:00:19.31,Default,,0,0,0,,Кент жігіті Мен оған әрқашан кеңес беремін! Қуанышымда шек болмады.
Dialogue: 0,0:00:20.78,0:00:22.82,Default,,0,0,0,,Дұрысы, Нао-сенпай жарай ма?
Dialogue: 0,0:00:22.82,0:00:26.29,Default,,0,0,0,,Ым? Турнир ертең, солай ма?
Dialogue: 0,0:00:27.36,0:00:29.32,Default,,0,0,0,,Мен тезірек ұйықтауым керек...
Dialogue: 0,0:00:29.32,0:00:33.36,Default,,0,0,0,,Бұл не? Акикун, менімен сөйлескің келмейді ме?
Dialogue: 0,0:00:33.36,0:00:37.27,Default,,0,0,0,,Сондықтан да... Әй, неткен суық шәкірт➡
Dialogue: 0,0:00:37.27,0:00:39.27,Default,,0,0,0,,Экскоммуникация - бұл экскоммуникация!
Dialogue: 0,0:00:40.37,0:00:43.87,Default,,0,0,0,,Сіз қобалжыдыңыз ба?
Dialogue: 0,0:00:43.87,0:00:45.81,Default,,0,0,0,,Дұрыс, мен істеп жатырмын➡
Dialogue: 0,0:00:45.81,0:00:48.38,Default,,0,0,0,,Бірақ мен де сондай қуаныштымын.
Dialogue: 0,0:00:48.38,0:00:51.78,Default,,0,0,0,,Кешіріңіз, мен сізді қолдағым келді.
Dialogue: 0,0:00:51.78,0:00:53.78,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:00:53.78,0:00:55.78,Default,,0,0,0,,Оның орнына….
Dialogue: 0,0:00:55.78,0:00:58.35,Default,,0,0,0,,Өтінемін, менімен тағы да сөйлесіңіз.
Dialogue: 0,0:00:58.35,0:01:00.82,Default,,0,0,0,,Аа... Түсінікті.
Dialogue: 0,0:01:17.34,0:01:20.34,Default,,0,0,0,,Жоқ…. Жақсы….
Dialogue: 0,0:01:20.34,0:01:23.85,Default,,0,0,0,,Сонымен….
Dialogue: 0,0:01:25.35,0:01:27.32,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Нао-сенпай.
Dialogue: 0,0:03:02.78,0:03:04.78,Default,,0,0,0,,Мм!
Dialogue: 0,0:03:07.75,0:03:10.72,Default,,0,0,0,,Мен жақсы ұйықтадым!
Dialogue: 0,0:03:11.75,0:03:13.72,Default,,0,0,0,,Бүгінгі жағдай өте жақсы!
Dialogue: 0,0:03:13.72,0:03:16.22,Default,,0,0,0,,Бұл жұмыс істейді!
Dialogue: 0,0:03:16.22,0:03:18.73,Default,,0,0,0,,Жарайды... біз орындадық!
Dialogue: 0,0:03:21.23,0:03:24.77,Default,,0,0,0,,Оқудан шығуыңызбен құттықтаймыз!
Dialogue: 0,0:03:24.77,0:03:27.74,Default,,0,0,0,,Екеуіңізге де рахмет!
Dialogue: 0,0:03:27.74,0:03:29.74,Default,,0,0,0,,Митан жұмыста➡
Dialogue: 0,0:03:29.74,0:03:31.74,Default,,0,0,0,,Келгеніңізге қуаныштымын!
Dialogue: 0,0:03:31.74,0:03:34.24,Default,,0,0,0,,Хикари-чан екеуміз доспыз➡
Dialogue: 0,0:03:34.24,0:03:36.24,Default,,0,0,0,,Өте анық!
Dialogue: 0,0:03:36.24,0:03:38.25,Default,,0,0,0,,Уау! ➡
Dialogue: 0,0:03:38.25,0:03:40.25,Default,,0,0,0,,Ми-тан!
Dialogue: 0,0:03:40.25,0:03:42.22,Default,,0,0,0,,Хикари-чан!
Dialogue: 0,0:03:45.25,0:03:47.22,Default,,0,0,0,,Сізге жақсы, Хикари...
Dialogue: 0,0:03:47.22,0:03:50.23,Default,,0,0,0,,Мен ауруханадан шыққаныма өте қуаныштымын.
Dialogue: 0,0:03:50.23,0:03:53.73,Default,,0,0,0,,Ммм... аға, сіз асыра айтып отырсыз.
Dialogue: 0,0:03:53.73,0:03:56.23,Default,,0,0,0,,Егер солай болса, балалар...
Dialogue: 0,0:03:56.23,0:03:58.23,Default,,0,0,0,,Кішкене...
Dialogue: 0,0:03:58.23,0:04:00.24,Default,,0,0,0,,E? Ахахха! ➡
Dialogue: 0,0:04:00.24,0:04:02.27,Default,,0,0,0,,Ацерб.
Dialogue: 0,0:04:02.27,0:04:05.24,Default,,0,0,0,,Сәлем! Хикари-чанның ауруханадан шыққанын тойлайтын сүйікті орны➡
Dialogue: 0,0:04:05.24,0:04:07.74,Default,,0,0,0,,Жүр, көңіл көтерейік! Жарайды ма?
Dialogue: 0,0:04:07.74,0:04:09.75,Default,,0,0,0,,Ум!
Dialogue: 0,0:04:09.75,0:04:12.25,Default,,0,0,0,,Сіз нені қалайсыз?
Dialogue: 0,0:04:12.25,0:04:15.25,Default,,0,0,0,,Хмм...швед үстелі? ➡
Dialogue: 0,0:04:15.25,0:04:17.75,Default,,0,0,0,,Менің де карта дүкеніне барғым келеді~➡
Dialogue: 0,0:04:17.75,0:04:19.72,Default,,0,0,0,,Мен абдырап қалдым.
Dialogue: 0,0:04:21.29,0:04:23.33,Default,,0,0,0,,｟Нао-сенпай➡
Dialogue: 0,0:04:23.33,0:04:26.23,Default,,0,0,0,,Бәрі жақсы болып жатыр деп үміттенемін... ｠
Dialogue: 0,0:04:26.23,0:04:28.73,Default,,0,0,0,,A…. Ммм….
Dialogue: 0,0:04:28.73,0:04:30.77,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:30.77,0:04:33.74,Default,,0,0,0,,Бауырым, сен қыздарды ойлап жүрсің ғой?
Dialogue: 0,0:04:33.74,0:04:35.74,Default,,0,0,0,,E?
Dialogue: 0,0:04:35.74,0:04:37.77,Default,,0,0,0,,Ех!
Dialogue: 0,0:04:37.77,0:04:40.74,Default,,0,0,0,,Бұрынғыдай көрінгеніңіз анық. Мен оны міндетті түрде көре аламын!
Dialogue: 0,0:04:40.74,0:04:43.75,Default,,0,0,0,,Е…. Бұл түсінбеушілік!
Dialogue: 0,0:04:43.75,0:04:47.75,Default,,0,0,0,,Жоқ. Бұл түсінбеушілік емес пе?
Dialogue: 0,0:04:47.75,0:04:49.75,Default,,0,0,0,,Ақина-сенпай?
Dialogue: 0,0:04:49.75,0:04:52.29,Default,,0,0,0,,Кем дегенде….
Dialogue: 0,0:04:52.29,0:04:55.22,Default,,0,0,0,,Жеңімпаз...Нао Инабе! ➡
Dialogue: 0,0:04:55.22,0:04:58.26,Default,,0,0,0,,Үздік 8-ге өтіңіз!
Dialogue: 0,0:04:58.26,0:05:00.23,Default,,0,0,0,,Хакушон!
Dialogue: 0,0:05:03.23,0:05:05.77,Default,,0,0,0,,Нао Торю кубогын жеңіп алды.
Dialogue: 0,0:05:05.77,0:05:10.27,Default,,0,0,0,,Аты айтып тұрғандай, бұл жастарға арналған шлюз турнирі, солай емес пе?
Dialogue: 0,0:05:10.27,0:05:14.24,Default,,0,0,0,,Кәсіпқой немесе әуесқой болсын, елдің түкпір-түкпірінен мықты ойыншылар жиналады деген қауесет бар.
Dialogue: 0,0:05:14.24,0:05:16.28,Default,,0,0,0,,Un.
Dialogue: 0,0:05:16.28,0:05:18.75,Default,,0,0,0,,Мен сізге қолдау көрсетемін деп ойладым➡
Dialogue: 0,0:05:18.75,0:05:21.25,Default,,0,0,0,,Өйткені бүгін маңызды күн.
Dialogue: 0,0:05:21.25,0:05:23.22,Default,,0,0,0,,Ақина-сенпай...
Dialogue: 0,0:05:27.22,0:05:29.72,Default,,0,0,0,,Эй, Хикари...
Dialogue: 0,0:05:31.26,0:05:34.73,Default,,0,0,0,,Жарайды, мен де қызықпын.
Dialogue: 0,0:05:34.73,0:05:36.73,Default,,0,0,0,,Ах...!
Dialogue: 0,0:05:40.80,0:05:43.77,Default,,0,0,0,,Мен саған бірдеңе керек болса хабарлас дедім, бірақ...
Dialogue: 0,0:05:44.77,0:05:47.74,Default,,0,0,0,,Мені бұлай атайды деп ешқашан ойламадым...
Dialogue: 0,0:05:47.74,0:05:50.75,Default,,0,0,0,,Кешіріңіз, басқа амалым жоқ.
Dialogue: 0,0:05:50.75,0:05:53.72,Default,,0,0,0,,Мен саған сенемін! Масу!
Dialogue: 0,0:05:55.75,0:05:57.75,Default,,0,0,0,,Сіз айтқандай➡
Dialogue: 0,0:05:57.75,0:05:59.72,Default,,0,0,0,,Ханшайым.
Dialogue: 0,0:06:02.26,0:06:05.23,Default,,0,0,0,,Көп күткеніңізге рахмет➡
Dialogue: 0,0:06:05.23,0:06:08.23,Default,,0,0,0,,Бұдан былай, Авангард Торю кубогы➡
Dialogue: 0,0:06:08.23,0:06:10.77,Default,,0,0,0,,Финал ойындары өтеді➡
Dialogue: 0,0:06:10.77,0:06:13.24,Default,,0,0,0,,Бұл екеуі қиян-кескі шайқастан өткен...
Dialogue: 0,0:06:13.24,0:06:15.74,Default,,0,0,0,,Бірінші немесе соңғы шабуыл жасауым керек пе?
Dialogue: 0,0:06:15.74,0:06:18.24,Default,,0,0,0,,Бұл соған байланысты➡
Dialogue: 0,0:06:18.24,0:06:20.38,Default,,0,0,0,,Егер бұл тақырыптағы палуба болса...
Dialogue: 0,0:06:20.38,0:06:23.88,Default,,0,0,0,,Үміттердің асуы! Ойыншы Нао Инабе.
Dialogue: 0,0:06:25.75,0:06:27.78,Default,,0,0,0,,➡ үшін
Dialogue: 0,0:06:27.78,0:06:30.79,Default,,0,0,0,,Ол кенеттен зейнетке шыққаннан кейін керемет қайтып келді➡
Dialogue: 0,0:06:30.79,0:06:34.76,Default,,0,0,0,,Ардагер жауынгер Мондо Киришима!
Dialogue: 0,0:06:36.73,0:06:38.73,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:06:40.33,0:06:42.33,Default,,0,0,0,,｟JIGEN➡ кәсіби командасына жатады
Dialogue: 0,0:06:42.33,0:06:48.37,Default,,0,0,0,,Мен 1-ші Deluxe-дің үздік 8-іне кірген Мондо Киришимамен бәсекелесетініме сене алар емеспін... ｠
Dialogue: 0,0:06:48.37,0:06:50.37,Default,,0,0,0,,｟Әрине жоғары сынып, бірақ... ｠
Dialogue: 0,0:06:51.37,0:06:53.24,Default,,0,0,0,,｟Міндетті түрде жеңіңіз! ｠
Dialogue: 0,0:06:53.24,0:06:55.24,Default,,0,0,0,,Сіз де кәсіпқой болғыңыз келе ме?
Dialogue: 0,0:06:55.24,0:06:57.25,Default,,0,0,0,,Ах...сәлем!
Dialogue: 0,0:06:57.25,0:06:59.28,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:06:59.28,0:07:02.75,Default,,0,0,0,,Егер сіз осы турнирді ұтып алсаңыз, сіздің кәсіпқой болуға жолыңыз ашылады.
Dialogue: 0,0:07:02.75,0:07:05.25,Default,,0,0,0,,Ондай адамдар көп.
Dialogue: 0,0:07:05.25,0:07:07.72,Default,,0,0,0,,Бірақ ол кәсіпқой болғысы келетін шығар...
Dialogue: 0,0:07:07.72,0:07:09.72,Default,,0,0,0,,Бұл қиын, солай емес пе?
Dialogue: 0,0:07:09.72,0:07:11.73,Default,,0,0,0,,Иә...өте.
Dialogue: 0,0:07:11.73,0:07:13.73,Default,,0,0,0,,Кәсіби маман болу немесе кәсіби болып қалу➡
Dialogue: 0,0:07:13.73,0:07:15.73,Default,,0,0,0,,Тікенді жол.
Dialogue: 0,0:07:15.73,0:07:18.27,Default,,0,0,0,,Дегенмен...➡
Dialogue: 0,0:07:18.27,0:07:20.74,Default,,0,0,0,,Неліктен кәсіби деңгейге қайта оралдыңыз?
Dialogue: 0,0:07:20.74,0:07:23.27,Default,,0,0,0,,Көп нәрсе бар➡
Dialogue: 0,0:07:23.27,0:07:28.28,Default,,0,0,0,,Бірінші себеп, менің көрсеткім келетін арқам бар... Шамасы!
Dialogue: 0,0:07:29.24,0:07:31.25,Default,,0,0,0,,Сіз көрсеткіңіз келетін артқы жағы...
Dialogue: 0,0:07:31.25,0:07:33.25,Default,,0,0,0,,Мен әдемі көрінгім келеді➡
Dialogue: 0,0:07:33.25,0:07:35.22,Default,,0,0,0,,Әке ретінде!
Dialogue: 0,0:07:40.26,0:07:43.22,Default,,0,0,0,,Енді ойынды бастайық!
Dialogue: 0,0:07:45.23,0:07:47.23,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:07:48.23,0:07:50.73,Default,,0,0,0,,Ыстық ауаның жүзі Алдато!
Dialogue: 0,0:07:50.73,0:07:53.74,Default,,0,0,0,,Галактикалық қаһарман таза Агно.
Dialogue: 0,0:07:53.74,0:07:55.77,Default,,0,0,0,,Менің кезегім ➡
Dialogue: 0,0:07:55.77,0:07:57.77,Default,,0,0,0,,Blaze Zamber➡ арқылы жүру
Dialogue: 0,0:07:57.77,0:08:00.74,Default,,0,0,0,,Энергия генераторын орнатыңыз және бұрылысты аяқтаңыз.
Dialogue: 0,0:08:01.74,0:08:03.75,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:08:03.75,0:08:06.78,Default,,0,0,0,,Галактикалық қаһарман сәулетші Перси Райд➡
Dialogue: 0,0:08:06.78,0:08:11.89,Default,,0,0,0,,Персидің шеберлігін пайдаланып, Батырдың негізгі Айгисін қолыңызға қосыңыз.
Dialogue: 0,0:08:11.89,0:08:15.22,Default,,0,0,0,,｟Эйгис...Мондо палубасының кілт картасы. ｠
Dialogue: 0,0:08:15.22,0:08:19.73,Default,,0,0,0,,Энергия генераторын орнатыңыз және энергияны зарядтаңыз.
Dialogue: 0,0:08:19.73,0:08:21.73,Default,,0,0,0,,Персимен шабуыл!
Dialogue: 0,0:08:21.73,0:08:23.77,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:08:23.77,0:08:25.73,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім ➡
Dialogue: 0,0:08:25.73,0:08:28.24,Default,,0,0,0,,Энергия заряды➡
Dialogue: 0,0:08:28.24,0:08:30.24,Default,,0,0,0,,Боулдер балтасына міну➡
Dialogue: 0,0:08:30.24,0:08:32.74,Default,,0,0,0,,Блэз Занбарды шеберлікпен шақырыңыз!
Dialogue: 0,0:08:32.74,0:08:35.24,Default,,0,0,0,,Боулдер балтасымен шабуыл!
Dialogue: 0,0:08:35.24,0:08:37.25,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:08:37.25,0:08:39.25,Default,,0,0,0,,Блейз Занбармен шабуыл!
Dialogue: 0,0:08:39.25,0:08:41.25,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:08:41.25,0:08:43.75,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім➡
Dialogue: 0,0:08:43.75,0:08:47.22,Default,,0,0,0,,Галактикалық қаһарманның сымды кросстейнде жүруі➡
Dialogue: 0,0:08:47.22,0:08:50.23,Default,,0,0,0,,Жиындар, батырлар➡
Dialogue: 0,0:08:50.23,0:08:53.23,Default,,0,0,0,,Алдағы дағдарыс үшін➡
Dialogue: 0,0:08:53.23,0:08:56.23,Default,,0,0,0,,Рет аймағындағы Айгис➡
Dialogue: 0,0:08:56.23,0:08:58.73,Default,,0,0,0,,Орнату!
Dialogue: 0,0:08:58.73,0:09:01.77,Default,,0,0,0,,Шеберлікке байланысты палубаның жоғарғы 7 картасынан➡
Dialogue: 0,0:09:01.77,0:09:06.24,Default,,0,0,0,,Қолыңызға Сфераны қосып, Фарис пен Мэттиді барлау.
Dialogue: 0,0:09:06.24,0:09:09.71,Default,,0,0,0,,Сонымен қатар, Кростеннің дағдылары бар Аспиданы барлау!
Dialogue: 0,0:09:11.81,0:09:13.78,Default,,0,0,0,,｟Батырларды базаға шақырыңыз➡
Dialogue: 0,0:09:13.78,0:09:16.82,Default,,0,0,0,,Оларды соғыс жағдайына қарай жөнелтіңіз➡
Dialogue: 0,0:09:16.82,0:09:19.75,Default,,0,0,0,,Galactic Hero палубаларына арналған жалпы тактика. ｠
Dialogue: 0,0:09:19.75,0:09:22.26,Default,,0,0,0,,Сфера мен Фелвисті шақырыңыз➡
Dialogue: 0,0:09:22.26,0:09:25.23,Default,,0,0,0,,Блейз Занбарды дағдылармен шегініңіз➡
Dialogue: 0,0:09:25.23,0:09:27.73,Default,,0,0,0,,Кростенмен шабуыл!
Dialogue: 0,0:09:27.73,0:09:30.23,Default,,0,0,0,,Күзетші. Сферамен шабуыл жасаңыз!
Dialogue: 0,0:09:30.23,0:09:32.23,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:09:32.23,0:09:34.24,Default,,0,0,0,,Фелвиспен шабуыл!
Dialogue: 0,0:09:34.24,0:09:36.27,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:09:36.27,0:09:38.74,Default,,0,0,0,,Фервис шеберлігі шегініп➡
Dialogue: 0,0:09:38.74,0:09:42.24,Default,,0,0,0,,Қолыңызға бір барлау картасын қосыңыз➡
Dialogue: 0,0:09:42.24,0:09:44.71,Default,,0,0,0,,Aigis тамшысын орнатыңыз.
Dialogue: 0,0:09:46.38,0:09:48.25,Default,,0,0,0,,｟Екінші Айгис... ｠
Dialogue: 0,0:09:48.25,0:09:50.75,Default,,0,0,0,,Қолыңызға шеберлікпен бір карта қосыңыз➡
Dialogue: 0,0:09:50.75,0:09:52.75,Default,,0,0,0,,Барлаушы 2 бөлік.
Dialogue: 0,0:09:52.75,0:09:54.79,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:09:54.79,0:09:57.26,Default,,0,0,0,,｟Соғұрлым көп батырлар барласа➡
Dialogue: 0,0:09:57.26,0:10:00.26,Default,,0,0,0,,Екінші жақтағы тактиканың ауқымы кеңейеді.
Dialogue: 0,0:10:00.26,0:10:04.30,Default,,0,0,0,,Көп есептегендер жеңеді, аз есептеулер ұтпайды➡
Dialogue: 0,0:10:04.30,0:10:07.27,Default,,0,0,0,,Қарқын алғанға дейін бұзылыңыз! ｠
Dialogue: 0,0:10:07.27,0:10:09.24,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:10:12.71,0:10:14.71,Default,,0,0,0,,Уау! ➡
Dialogue: 0,0:10:14.71,0:10:16.71,Default,,0,0,0,,Жел жақсы сезінеді!
Dialogue: 0,0:10:18.71,0:10:20.72,Default,,0,0,0,,Сол аға➡
Dialogue: 0,0:10:20.72,0:10:23.72,Default,,0,0,0,,Акинаның құрбысы? маса...!
Dialogue: 0,0:10:23.72,0:10:26.22,Default,,0,0,0,,Ол менің толық емес жұмыс күнімдегі аға буын.
Dialogue: 0,0:10:26.22,0:10:28.22,Default,,0,0,0,,Сондай-ақ Авангардтың шебері.
Dialogue: 0,0:10:28.22,0:10:31.73,Default,,0,0,0,,Ол қандай бала? Жақсы….
Dialogue: 0,0:10:31.73,0:10:34.73,Default,,0,0,0,,Маған Vanguard ұнайды және білімдімін➡
Dialogue: 0,0:10:34.73,0:10:36.73,Default,,0,0,0,,Әрқашан еңбектеніңіз➡
Dialogue: 0,0:10:36.73,0:10:38.73,Default,,0,0,0,,Сенімді...
Dialogue: 0,0:10:40.24,0:10:43.24,Default,,0,0,0,,Нао-сенпай өте керемет.
Dialogue: 0,0:10:44.71,0:10:46.71,Default,,0,0,0,,Хмм….
Dialogue: 0,0:10:46.71,0:10:50.21,Default,,0,0,0,,Сүйікті Нао-сенпайға ұшайық!
Dialogue: 0,0:10:50.21,0:10:52.21,Default,,0,0,0,,Е!
Dialogue: 0,0:10:56.72,0:10:59.25,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:10:59.25,0:11:03.22,Default,,0,0,0,,Ақ жарқыл, қара реверберация➡
Dialogue: 0,0:11:03.22,0:11:05.73,Default,,0,0,0,,Жеңілмейтін қос қолдану!
Dialogue: 0,0:11:05.73,0:11:07.73,Default,,0,0,0,,Енді қылышыңды тарт!
Dialogue: 0,0:11:07.73,0:11:09.73,Default,,0,0,0,,Жүр!
Dialogue: 0,0:11:09.73,0:11:11.70,Default,,0,0,0,,Теңдесі жоқ тағдыр➡
Dialogue: 0,0:11:11.70,0:11:14.20,Default,,0,0,0,,Вальга Драгрес!
Dialogue: 0,0:11:16.77,0:11:19.77,Default,,0,0,0,,｟Бұл мен көрген бірінші карта➡
Dialogue: 0,0:11:19.77,0:11:21.71,Default,,0,0,0,,Қызықты. ｠
Dialogue: 0,0:11:21.71,0:11:24.25,Default,,0,0,0,,Боулдер балтасын шеберлікпен шақырыңыз➡
Dialogue: 0,0:11:24.25,0:11:27.22,Default,,0,0,0,,Обдрасграв Кофуға➡ қоңырау шалыңыз
Dialogue: 0,0:11:27.22,0:11:29.72,Default,,0,0,0,,Боулдер балтасымен шабуыл!
Dialogue: 0,0:11:29.72,0:11:32.72,Default,,0,0,0,,Кезек сендерде, батырлар!
Dialogue: 0,0:11:32.72,0:11:34.76,Default,,0,0,0,,Айгис шеберлігін белсендіру➡
Dialogue: 0,0:11:34.76,0:11:39.73,Default,,0,0,0,,Барлаушы Аспидамен бірге Айгисті демалдырып күзет!
Dialogue: 0,0:11:39.73,0:11:41.70,Default,,0,0,0,,Сондай-ақ Сферамен кесіңіз!
Dialogue: 0,0:11:43.73,0:11:47.74,Default,,0,0,0,,Ұрыс соңында Боулдер Балтаны тастап, 1 картаны тартыңыз.
Dialogue: 0,0:11:49.24,0:11:51.27,Default,,0,0,0,,Вальга Драгреспен шабуыл!
Dialogue: 0,0:11:51.27,0:11:54.21,Default,,0,0,0,,Дағды +10000 қуат. Күзетші жоқ.
Dialogue: 0,0:11:54.21,0:11:57.21,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:11:57.21,0:11:59.21,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:11:59.21,0:12:01.22,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:12:01.22,0:12:03.22,Default,,0,0,0,,Валга Драглесстің күші плюс 10 000!
Dialogue: 0,0:12:03.22,0:12:05.69,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:12:08.26,0:12:10.73,Default,,0,0,0,,Мен сізге екі жақты пайдаланудың мәнін көрсетемін!
Dialogue: 0,0:12:11.79,0:12:14.86,Default,,0,0,0,,Тұрақты жүргізу минус 2 дағды.
Dialogue: 0,0:12:14.86,0:12:17.20,Default,,0,0,0,,｟Қосымша шабуыл дағдысы? ｠
Dialogue: 0,0:12:17.20,0:12:19.70,Default,,0,0,0,,Валга Драгресте➡
Dialogue: 0,0:12:19.70,0:12:22.20,Default,,0,0,0,,Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:12:22.20,0:12:24.21,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:12:24.21,0:12:28.21,Default,,0,0,0,,U... Обдрас Глейвпен шабуыл!
Dialogue: 0,0:12:28.21,0:12:30.21,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:12:32.28,0:12:35.75,Default,,0,0,0,,｜4 рет шабуыл жасап, бір рет өтті➡
Dialogue: 0,0:12:35.75,0:12:38.79,Default,,0,0,0,,Ашкөздік туралы айтатын болсам, мен тым болмаса тағы бір зат алғым келеді➡
Dialogue: 0,0:12:38.79,0:12:40.72,Default,,0,0,0,,Менің ойымша, бұл оңай емес... ｠
Dialogue: 0,0:12:40.72,0:12:42.72,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:12:42.72,0:12:45.19,Default,,0,0,0,,Вальга Драгрес... бұл керемет карта.
Dialogue: 0,0:12:49.73,0:12:51.70,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:12:51.70,0:12:55.20,Default,,0,0,0,,Ах...! Жоғалтпа!
Dialogue: 0,0:12:55.20,0:12:57.21,Default,,0,0,0,,Ах➡
Dialogue: 0,0:12:57.21,0:12:59.21,Default,,0,0,0,,Батыр ешқашан жеңілмейді!
Dialogue: 0,0:12:59.21,0:13:01.24,Default,,0,0,0,,Ах...!
Dialogue: 0,0:13:01.24,0:13:03.21,Default,,0,0,0,,Менің кезегім! ➡
Dialogue: 0,0:13:03.21,0:13:06.21,Default,,0,0,0,,Галактикада гүрілде, әділет гүрілінде! ➡
Dialogue: 0,0:13:06.21,0:13:10.72,Default,,0,0,0,,Галактикалық қаһарман Дианосты біріктіреді➡
Dialogue: 0,0:13:10.72,0:13:12.69,Default,,0,0,0,,Жүр!
Dialogue: 0,0:13:29.74,0:13:32.21,Default,,0,0,0,,Үшінші Айгис➡ орнатыңыз
Dialogue: 0,0:13:32.21,0:13:34.71,Default,,0,0,0,,Көбірек кейіпкерлерді жалдаңыз➡
Dialogue: 0,0:13:34.71,0:13:36.71,Default,,0,0,0,,Қолыңызға бір карта қосыңыз➡
Dialogue: 0,0:13:36.71,0:13:38.75,Default,,0,0,0,,Скаут 2 дана➡
Dialogue: 0,0:13:38.75,0:13:41.22,Default,,0,0,0,,Эйджистің шеберлігін одан әрі белсендіру! ➡
Dialogue: 0,0:13:41.22,0:13:43.72,Default,,0,0,0,,Демалу және қолыңыздағы бір картаны тастау арқылы➡
Dialogue: 0,0:13:43.72,0:13:46.75,Default,,0,0,0,,Барлаушы Фариске қоңырау шалыңыз! ➡
Dialogue: 0,0:13:46.75,0:13:50.73,Default,,0,0,0,,Сонымен қатар, қолыңыздан тасталған Саросқа қоңырау шалу дағдысын пайдаланыңыз➡
Dialogue: 0,0:13:50.73,0:13:52.76,Default,,0,0,0,,Скаут Аспида➡
Dialogue: 0,0:13:52.76,0:13:57.70,Default,,0,0,0,,Фарис шеберлігі Эйгисті демалдырып, барлаушы Фориге➡ қоңырау шалыңыз
Dialogue: 0,0:13:57.70,0:14:00.74,Default,,0,0,0,,Басқа Фариске➡ қоңырау шалыңыз
Dialogue: 0,0:14:00.74,0:14:04.24,Default,,0,0,0,,Осы дағды үшін барлаудан өткен Абл Мэттиске қоңырау шалыңыз!
Dialogue: 0,0:14:06.27,0:14:08.28,Default,,0,0,0,,｟Біліктілікті тиімді айналдыру➡
Dialogue: 0,0:14:08.28,0:14:10.78,Default,,0,0,0,,Мондо Киришима күткендей... ｠
Dialogue: 0,0:14:12.75,0:14:17.22,Default,,0,0,0,,Батырлар, қазір күштеріңізді біріктіретін уақыт!
Dialogue: 0,0:14:17.22,0:14:19.22,Default,,0,0,0,,Фариспен шабуыл!
Dialogue: 0,0:14:19.22,0:14:21.72,Default,,0,0,0,,Күзетші. Дианоспен шабуыл➡
Dialogue: 0,0:14:21.72,0:14:24.76,Default,,0,0,0,,Дағдыны белсендіру: 3 Айгис➡ көмегімен
Dialogue: 0,0:14:24.76,0:14:28.23,Default,,0,0,0,,Меншікті қуат плюс 15000, сыни соққы плюс 1.
Dialogue: 0,0:14:30.30,0:14:32.43,Default,,0,0,0,,｜Егер біз оны осы жерде алдын алмасақ➡
Dialogue: 0,0:14:32.43,0:14:34.20,Default,,0,0,0,,Орындалды! ｠
Dialogue: 0,0:14:34.20,0:14:36.74,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:14:36.74,0:14:38.71,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:14:38.71,0:14:40.74,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:14:40.74,0:14:42.74,Default,,0,0,0,,Критикалық триггер! ➡
Dialogue: 0,0:14:42.74,0:14:46.75,Default,,0,0,0,,Саростың күші +10000 Мэтидің сыни +1!
Dialogue: 0,0:14:46.75,0:14:49.75,Default,,0,0,0,,Ұрыс соңында Фолидің шеберлігі іске қосылады➡
Dialogue: 0,0:14:49.75,0:14:53.22,Default,,0,0,0,,Алдыңғы қатардағы Faris және артқы қатардағы Saros сөздерін ауыстырыңыз➡
Dialogue: 0,0:14:53.22,0:14:56.72,Default,,0,0,0,,Сароспен Обдрасглейвке шабуыл жасаңыз!
Dialogue: 0,0:14:56.72,0:14:58.86,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:14:58.86,0:15:00.73,Default,,0,0,0,,｟Шабуылдаушы жойылды! ｠
Dialogue: 0,0:15:00.73,0:15:02.73,Default,,0,0,0,,Әлі біткен жоқ➡
Dialogue: 0,0:15:02.73,0:15:04.70,Default,,0,0,0,,Мэттиспен шабуыл!
Dialogue: 0,0:15:04.70,0:15:07.20,Default,,0,0,0,,3 Айгис➡ тұру дағдысын қолданыңыз
Dialogue: 0,0:15:07.20,0:15:09.34,Default,,0,0,0,,Карталардың осы саны үшін жан алымы.
Dialogue: 0,0:15:09.34,0:15:13.24,Default,,0,0,0,,｟Енді Галактикалық Батыр да келесі кезекте күзетте шығады. ｠
Dialogue: 0,0:15:13.24,0:15:16.71,Default,,0,0,0,,Бұл шабуыл мен қорғанысты біріктіретін стратегия.
Dialogue: 0,0:15:16.71,0:15:18.71,Default,,0,0,0,,Міне, бұл➡
Dialogue: 0,0:15:18.71,0:15:21.22,Default,,0,0,0,,Айгиске жиналған батырларға➡
Dialogue: 0,0:15:21.22,0:15:23.72,Default,,0,0,0,,Мүмкіндік жоқ! қарақат….
Dialogue: 0,0:15:23.72,0:15:25.69,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:15:27.22,0:15:30.22,Default,,0,0,0,,Уау! Әкең күткендей.
Dialogue: 0,0:15:30.22,0:15:32.69,Default,,0,0,0,,Мм...кезеңнің соңы.
Dialogue: 0,0:15:33.80,0:15:36.23,Default,,0,0,0,,｟Қолымда 2 карта қалды➡
Dialogue: 0,0:15:36.23,0:15:38.73,Default,,0,0,0,,Бір артқы қорғаныс➡
Dialogue: 0,0:15:38.73,0:15:41.24,Default,,0,0,0,,Келесі кезекті қорғау қиын➡
Dialogue: 0,0:15:41.24,0:15:44.27,Default,,0,0,0,,Жеңіске жету үшін осы айналымда 3 ұпай жинау керек...
Dialogue: 0,0:15:44.27,0:15:47.28,Default,,0,0,0,,Бірақ қазіргі күшпен... ｠
Dialogue: 0,0:15:49.34,0:15:52.38,Default,,0,0,0,,｟Осы ұтыспен бірдеңе салудан басқа амалым жоқ. ｠
Dialogue: 0,0:15:52.38,0:15:54.88,Default,,0,0,0,,｟Бірақ сурет сала алмасаңыз... ｠
Dialogue: 0,0:16:02.72,0:16:04.69,Default,,0,0,0,,U….
Dialogue: 0,0:16:08.73,0:16:11.20,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:16:11.20,0:16:13.20,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:16:13.20,0:16:15.74,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:16:15.74,0:16:18.21,Default,,0,0,0,,Нао-сенпай!
Dialogue: 0,0:16:19.71,0:16:21.71,Default,,0,0,0,,Аха….
Dialogue: 0,0:16:24.21,0:16:27.22,Default,,0,0,0,,Жеңіске ұмтылудың басқа да себептері болды.
Dialogue: 0,0:16:27.22,0:16:29.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:29.22,0:16:31.72,Default,,0,0,0,,Салқындылығын көрсеткісі келетін адамдар➡
Dialogue: 0,0:16:31.72,0:16:34.19,Default,,0,0,0,,Өйткені менде де бар!
Dialogue: 0,0:16:36.72,0:16:38.73,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:16:38.73,0:16:40.70,Default,,0,0,0,,Ұтыс!
Dialogue: 0,0:16:41.76,0:16:44.77,Default,,0,0,0,,Бұл тамаша уақытта келеді.
Dialogue: 0,0:16:46.70,0:16:49.70,Default,,0,0,0,,Бірге барайық! Менің басқа эго➡
Dialogue: 0,0:16:49.70,0:16:53.74,Default,,0,0,0,,Persona Ride! Варга Драгрес.
Dialogue: 0,0:16:53.74,0:16:57.21,Default,,0,0,0,,Энергия генераторы дағдысы бар 1 картаны салыңыз➡
Dialogue: 0,0:16:57.21,0:17:00.72,Default,,0,0,0,,Сунегосри Конрад Динобриз➡
Dialogue: 0,0:17:00.72,0:17:02.72,Default,,0,0,0,,Рокусейге➡ қоңырау шалыңыз
Dialogue: 0,0:17:02.72,0:17:04.75,Default,,0,0,0,,Рокусейдің шеберлігін белсендіру➡
Dialogue: 0,0:17:04.75,0:17:07.22,Default,,0,0,0,,Осы бұрылыс кезінде кедергілерді болдырмаңыз!
Dialogue: 0,0:17:07.22,0:17:09.22,Default,,0,0,0,,Сунегосуримен шабуыл!
Dialogue: 0,0:17:09.22,0:17:11.23,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:17:11.23,0:17:13.23,Default,,0,0,0,,Конрадпен шабуыл.
Dialogue: 0,0:17:13.23,0:17:15.73,Default,,0,0,0,,Айгистің барлаушыдан қарауылға дейінгі дағдылары➡
Dialogue: 0,0:17:15.73,0:17:17.73,Default,,0,0,0,,Көбірек күзет!
Dialogue: 0,0:17:17.73,0:17:19.73,Default,,0,0,0,,Екіге бөліңіз! ➡
Dialogue: 0,0:17:19.73,0:17:22.24,Default,,0,0,0,,Вальга Драгреспен шабуыл!
Dialogue: 0,0:17:22.24,0:17:24.71,Default,,0,0,0,,Барлық алдыңғы қатарларды шегінуге дағдыландыру➡
Dialogue: 0,0:17:24.71,0:17:26.71,Default,,0,0,0,,Қуат плюс 10000!
Dialogue: 0,0:17:26.71,0:17:28.74,Default,,0,0,0,,Қосымша Rokusei дағдылары➡
Dialogue: 0,0:17:28.74,0:17:31.71,Default,,0,0,0,,Зейнетке шығып, 1 картаны тартыңыз.
Dialogue: 0,0:17:31.71,0:17:33.71,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:17:33.71,0:17:35.72,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:17:35.72,0:17:37.79,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:17:37.79,0:17:41.26,Default,,0,0,0,,Триггерді тартыңыз! Valga Dragless қуаты плюс 10000.
Dialogue: 0,0:17:44.23,0:17:46.23,Default,,0,0,0,,Бұл жақсы келісім емес пе?
Dialogue: 0,0:17:46.23,0:17:48.73,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:17:48.73,0:17:50.70,Default,,0,0,0,,Шеберлікпен тұр!
Dialogue: 0,0:17:50.70,0:17:53.20,Default,,0,0,0,,Мен оны итеремін!
Dialogue: 0,0:17:53.20,0:17:55.20,Default,,0,0,0,,Вальга Драгреспен шабуыл!
Dialogue: 0,0:17:55.20,0:17:58.21,Default,,0,0,0,,Күзетсіз…Зақымдануды тексеру➡
Dialogue: 0,0:17:58.21,0:18:00.71,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:18:00.71,0:18:03.21,Default,,0,0,0,,Дианостың күші плюс 10 000!
Dialogue: 0,0:18:06.21,0:18:08.22,Default,,0,0,0,,Әлі де құпия бар ма?
Dialogue: 0,0:18:08.22,0:18:10.25,Default,,0,0,0,,Түсінгеніңізге рахмет.
Dialogue: 0,0:18:10.25,0:18:14.22,Default,,0,0,0,,Вальга Драгрестің бір рет жарқылы үш рет жарқырайды➡
Dialogue: 0,0:18:14.22,0:18:16.72,Default,,0,0,0,,Теңдесі жоқ!
Dialogue: 0,0:18:16.72,0:18:18.73,Default,,0,0,0,,Құдайдың шеберлігі іске қосылды!
Dialogue: 0,0:18:18.73,0:18:20.73,Default,,0,0,0,,Тұрақты Drive Plus 2➡
Dialogue: 0,0:18:20.73,0:18:24.27,Default,,0,0,0,,Вальга Драгреспен шабуыл!
Dialogue: 0,0:18:24.27,0:18:29.20,Default,,0,0,0,,Айгис шеберлігін белсендіру. Барлаушы Аспидамен бірге күзетші!
Dialogue: 0,0:18:29.20,0:18:31.21,Default,,0,0,0,,Сонымен қатар, «Мелиоратпен» күзет!
Dialogue: 0,0:18:31.21,0:18:33.21,Default,,0,0,0,,Сіз күзеттіңіз бе?
Dialogue: 0,0:18:33.21,0:18:35.21,Default,,0,0,0,,Әлі де мүмкіндік бар!
Dialogue: 0,0:18:35.21,0:18:38.25,Default,,0,0,0,,Келесі дискіні тексеру кезінде триггерді тартсаңыз...
Dialogue: 0,0:18:38.25,0:18:40.72,Default,,0,0,0,,Нао-сенпай~!
Dialogue: 0,0:18:42.22,0:18:44.22,Default,,0,0,0,,Әке!
Dialogue: 0,0:18:45.22,0:18:47.72,Default,,0,0,0,,Жақындарым үшін жеңіле алмаймын➡
Dialogue: 0,0:18:47.72,0:18:49.72,Default,,0,0,0,,Біз де солай сезінетін сияқтымыз.
Dialogue: 0,0:18:49.72,0:18:51.73,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:51.73,0:18:53.73,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:18:53.73,0:18:55.73,Default,,0,0,0,,Кел!
Dialogue: 0,0:19:00.70,0:19:02.74,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:19:02.74,0:19:04.71,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:19:09.24,0:19:11.21,Default,,0,0,0,,Екінші тексеру….
Dialogue: 0,0:19:13.75,0:19:15.72,Default,,0,0,0,,Тұттым сені!
Dialogue: 0,0:19:15.72,0:19:17.72,Default,,0,0,0,,Емдеу триггері!
Dialogue: 0,0:19:18.75,0:19:21.22,Default,,0,0,0,,Валга Драглесстің күші плюс 10 000!
Dialogue: 0,0:19:25.73,0:19:27.73,Default,,0,0,0,,Мені өлтірме!
Dialogue: 0,0:19:36.20,0:19:38.71,Default,,0,0,0,,Жеңімпаз...Нао Инабе!
Dialogue: 0,0:19:38.71,0:19:41.21,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:41.21,0:19:43.21,Default,,0,0,0,,Ятта~! Ахахха...!
Dialogue: 0,0:19:51.72,0:19:53.69,Default,,0,0,0,,Нао-сенпай!
Dialogue: 0,0:19:54.72,0:19:56.69,Default,,0,0,0,,Хе хи хи...!
Dialogue: 0,0:20:01.23,0:20:03.26,Default,,0,0,0,,Фу….
Dialogue: 0,0:20:03.26,0:20:05.20,Default,,0,0,0,,Жақсы➡
Dialogue: 0,0:20:05.20,0:20:07.74,Default,,0,0,0,,Менімен кездесуді ұмытпаңыз, солай ма?
Dialogue: 0,0:20:07.74,0:20:09.70,Default,,0,0,0,,Инбенбен Нао.
Dialogue: 0,0:20:18.21,0:20:20.21,Default,,0,0,0,,Жақсы….
Dialogue: 0,0:20:20.21,0:20:22.72,Default,,0,0,0,,Менің де отшашуларды атқым келеді.
Dialogue: 0,0:20:22.72,0:20:25.22,Default,,0,0,0,,Бірақ мен кубокты жалғыз қалдыра алмаймын...
Dialogue: 0,0:20:25.22,0:20:27.22,Default,,0,0,0,,Мен оны аламын ба?
Dialogue: 0,0:20:27.22,0:20:29.69,Default,,0,0,0,,Маған бұл да ұнамайды. Мен оны жібере алмаймын.
Dialogue: 0,0:20:30.72,0:20:33.23,Default,,0,0,0,,Сіз жан-жақтан тұрып қалған жоқсыз ба?
Dialogue: 0,0:20:33.23,0:20:35.20,Default,,0,0,0,,Атча~!
Dialogue: 0,0:20:38.30,0:20:41.27,Default,,0,0,0,,｟Осындай уақыттың мәңгілік жалғасқанын қалаймын➡
Dialogue: 0,0:20:41.27,0:20:44.27,Default,,0,0,0,,Сол себепті мен... ｠
Dialogue: 0,0:20:45.84,0:20:47.71,Default,,0,0,0,,｜Тағдыр соғысында жеңіске жет! ｠
Dialogue: 0,0:20:47.71,0:20:49.71,Default,,0,0,0,,Дұрыс айтасың, Акикун.
Dialogue: 0,0:20:51.71,0:20:54.22,Default,,0,0,0,,Қолдауыңызға рахмет➡
Dialogue: 0,0:20:54.22,0:20:57.22,Default,,0,0,0,,Аки-кунның арқасында мен батылдық таныттым.
Dialogue: 0,0:20:57.22,0:20:59.19,Default,,0,0,0,,Нао-сенпай...
Dialogue: 0,0:21:00.79,0:21:03.76,Default,,0,0,0,,（📱）
Dialogue: 0,0:21:05.73,0:21:07.70,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:21:15.20,0:21:17.71,Default,,0,0,0,,Ақыры менің кезегім келді➡
Dialogue: 0,0:21:17.71,0:21:21.71,Default,,0,0,0,,Бұл сіздің үміттеріңізге сәйкес келеді деп үміттенемін.
Dialogue: 0,0:21:25.21,0:21:27.25,Default,,0,0,0,,Мен таптым!
Dialogue: 0,0:21:27.25,0:21:30.22,Default,,0,0,0,,Тағдыр соғысына қатысушылармен байланыста болған сияқтысыз➡
Dialogue: 0,0:21:30.22,0:21:32.19,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:21:36.72,0:21:39.23,Default,,0,0,0,,Не...! Яғни➡
Dialogue: 0,0:21:39.23,0:21:41.76,Default,,0,0,0,,Тағдыр картасы!
Dialogue: 0,0:21:41.76,0:21:45.20,Default,,0,0,0,,Ақымақ... 6 тағдыр картасы болуы керек!
Dialogue: 0,0:21:45.20,0:21:47.20,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:21:47.20,0:21:50.20,Default,,0,0,0,,Мен осындамын, себебі бұл мүмкін болды.
Dialogue: 0,0:21:51.71,0:21:54.74,Default,,0,0,0,,Өйткені екеуіңде де бірдей квирк бар ма?
Dialogue: 0,0:21:54.74,0:21:58.25,Default,,0,0,0,,Жетінші тағдыр картасын ұстаған адам.
