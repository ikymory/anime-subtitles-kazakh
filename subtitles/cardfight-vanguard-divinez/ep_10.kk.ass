Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.30,0:00:06.77,Default,,0,0,0,,Уақыт тағдыры….
Dialogue: 0,0:00:06.77,0:00:08.80,Default,,0,0,0,,Бұл шынымен Хикари-чан ба?
Dialogue: 0,0:00:08.80,0:00:11.31,Default,,0,0,0,,6 тағдыр картасы бар, солай ма?
Dialogue: 0,0:00:11.31,0:00:13.28,Default,,0,0,0,,Неліктен жетінші бар?
Dialogue: 0,0:00:13.28,0:00:15.28,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:00:15.28,0:00:17.78,Default,,0,0,0,,Бірақ егер мүмкіндік болса...
Dialogue: 0,0:00:19.82,0:00:21.78,Default,,0,0,0,,Хикари….
Dialogue: 0,0:00:23.29,0:00:25.82,Default,,0,0,0,,Үлкен аға? ➡
Dialogue: 0,0:00:25.82,0:00:28.29,Default,,0,0,0,,Бұл толық емес жұмыс күні ме?
Dialogue: 0,0:00:30.29,0:00:32.29,Default,,0,0,0,,Мен болашақтанмын➡
Dialogue: 0,0:00:32.29,0:00:34.26,Default,,0,0,0,,Ағамды тоқтату үшін.
Dialogue: 0,0:00:46.28,0:00:48.34,Default,,0,0,0,,Ха...! Мүмкін➡
Dialogue: 0,0:00:48.34,0:00:50.78,Default,,0,0,0,,Болашақ тағдыр соғысынан аман өтіңіз➡
Dialogue: 0,0:00:50.78,0:00:52.85,Default,,0,0,0,,Сіз мұнда келдіңіз бе? (Микото/Акина) Ах!
Dialogue: 0,0:00:52.85,0:00:55.78,Default,,0,0,0,,Мен де алғашында күмәнмен қарадым.
Dialogue: 0,0:00:55.78,0:00:57.82,Default,,0,0,0,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,0:00:57.82,0:01:01.79,Default,,0,0,0,,Маған ұнамайды... Маған сендерден сәл ертерек хабардар болды.
Dialogue: 0,0:01:01.79,0:01:04.29,Default,,0,0,0,,Айтайын дегенім, маған соны сұрады.
Dialogue: 0,0:01:04.29,0:01:06.30,Default,,0,0,0,,Ым? Хикари➡
Dialogue: 0,0:01:06.30,0:01:08.30,Default,,0,0,0,,Менің сізден сұрайын дегенім көп.
Dialogue: 0,0:01:08.30,0:01:10.33,Default,,0,0,0,,Сен мұнда не үшін келдің? ➡
Dialogue: 0,0:01:10.33,0:01:12.77,Default,,0,0,0,,Тағдыр соғысынан бас тартуымды неге сұрайсыз?
Dialogue: 0,0:01:12.77,0:01:14.77,Default,,0,0,0,,Тыңдасаң түсінесің...
Dialogue: 0,0:01:14.77,0:01:16.81,Default,,0,0,0,,Әрі қарай не болады➡
Dialogue: 0,0:01:16.81,0:01:19.81,Default,,0,0,0,,Тағдыр соғысының жиіркенішті аяқталуы.
Dialogue: 0,0:02:53.24,0:02:55.30,Default,,0,0,0,,Тағдыр соғысы➡
Dialogue: 0,0:02:55.30,0:02:57.77,Default,,0,0,0,,Тағдыр картасы таңдағандар арасындағы шайқас➡
Dialogue: 0,0:02:57.77,0:03:02.24,Default,,0,0,0,,Тірі қалған бір ғана адам тағдырды өзгерту құдіретіне ие болады➡
Dialogue: 0,0:03:02.24,0:03:04.28,Default,,0,0,0,,Соңғысы➡ қалды
Dialogue: 0,0:03:04.28,0:03:07.25,Default,,0,0,0,,Екі адам, Акина Мэйду және Суоу Козуцу.
Dialogue: 0,0:03:08.32,0:03:10.29,Default,,0,0,0,,｟Брагдомермен шабуыл.
Dialogue: 0,0:03:10.29,0:03:14.26,Default,,0,0,0,,Нөлге оралу... Тәңірлік шеберлік көрінді.
Dialogue: 0,0:03:24.73,0:03:27.24,Default,,0,0,0,,Барлығы нөлге дейін азаяды.
Dialogue: 0,0:03:28.24,0:03:31.24,Default,,0,0,0,,Жеңімпаз...Нөлдің тағдыры!
Dialogue: 0,0:03:31.24,0:03:33.81,Default,,0,0,0,,A…. Суо ➡
Dialogue: 0,0:03:33.81,0:03:36.78,Default,,0,0,0,,Тағдыр соғысынан сәтті өттіңіз➡
Dialogue: 0,0:03:36.78,0:03:39.25,Default,,0,0,0,,Сіздің тағдырыңызды өзгерту мүмкіндігіңіз бар.
Dialogue: 0,0:03:39.25,0:03:41.78,Default,,0,0,0,,Соңында ештеңе болмады.
Dialogue: 0,0:03:41.78,0:03:44.75,Default,,0,0,0,,Енді айқайлаңыз! Нөлдің тағдырына тілектес➡
Dialogue: 0,0:03:44.75,0:03:46.72,Default,,0,0,0,,Сіздің тілегіңіз!
Dialogue: 0,0:03:47.76,0:03:50.26,Default,,0,0,0,,Менде ештеңе жоқ➡
Dialogue: 0,0:03:50.26,0:03:52.33,Default,,0,0,0,,Ештеңе….
Dialogue: 0,0:03:52.33,0:03:54.30,Default,,0,0,0,,Қажет емес. ｠
Dialogue: 0,0:03:55.26,0:03:57.77,Default,,0,0,0,,Ол ештеңе қаламады➡
Dialogue: 0,0:03:57.77,0:04:00.77,Default,,0,0,0,,Брагдомейер мұны тілек деп анықтады ма?
Dialogue: 0,0:04:11.28,0:04:14.75,Default,,0,0,0,,Айналасында жүздеген метрді жұту➡
Dialogue: 0,0:04:14.75,0:04:16.75,Default,,0,0,0,,Бос орын пайда болды.
Dialogue: 0,0:04:20.26,0:04:22.26,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:04:22.26,0:04:24.29,Default,,0,0,0,,Ештеңе...
Dialogue: 0,0:04:24.29,0:04:26.73,Default,,0,0,0,,Бұл айналаның бәрі жойылды дегенді білдіре ме?
Dialogue: 0,0:04:26.73,0:04:29.76,Default,,0,0,0,,Таулар, Жер, Тірі заттар➡
Dialogue: 0,0:04:29.76,0:04:33.74,Default,,0,0,0,,Қатысушылар да жоғалып кетті.
Dialogue: 0,0:04:33.74,0:04:37.24,Default,,0,0,0,,Маған ештеңе керек емес екені рас еді.
Dialogue: 0,0:04:37.24,0:04:39.74,Default,,0,0,0,,Фуфуфуфуфу…!
Dialogue: 0,0:04:39.74,0:04:41.74,Default,,0,0,0,,Ах ха ха...!
Dialogue: 0,0:04:41.74,0:04:43.75,Default,,0,0,0,,Бұл жігіт шынымен есінен танып қалды!
Dialogue: 0,0:04:43.75,0:04:45.75,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:04:45.75,0:04:47.75,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:04:47.75,0:04:50.25,Default,,0,0,0,,Маған да кейінірек айтылды➡
Dialogue: 0,0:04:50.25,0:04:52.25,Default,,0,0,0,,Егер мен мұндай болашақ бар екенін білсем➡
Dialogue: 0,0:04:52.25,0:04:54.22,Default,,0,0,0,,Мен оны тоқтату үшін қолымнан келгеннің бәрін жасадым!
Dialogue: 0,0:04:56.83,0:04:58.76,Default,,0,0,0,,｟Үлкен аға➡
Dialogue: 0,0:04:58.76,0:05:00.76,Default,,0,0,0,,Сіз шығасыз ба?
Dialogue: 0,0:05:00.76,0:05:03.73,Default,,0,0,0,,Мен үйге кеш келемін, сондықтан тоңазытқыштағы бұқтырылған бұқтырманы жеп қойыңыз.
Dialogue: 0,0:05:03.73,0:05:05.73,Default,,0,0,0,,Толық емес жұмыс күні? Хмм...
Dialogue: 0,0:05:06.74,0:05:08.74,Default,,0,0,0,,Мен барамын.
Dialogue: 0,0:05:10.81,0:05:12.81,Default,,0,0,0,,Қош келдіңіз... ｠
Dialogue: 0,0:05:12.81,0:05:16.75,Default,,0,0,0,,Ақыры сол күні ағам үйге келмеді.
Dialogue: 0,0:05:16.75,0:05:19.25,Default,,0,0,0,,Келесі күні де➡
Dialogue: 0,0:05:19.25,0:05:21.22,Default,,0,0,0,,Келесі күні де.
Dialogue: 0,0:05:23.32,0:05:25.79,Default,,0,0,0,,｟Әке, аға?
Dialogue: 0,0:05:27.32,0:05:30.26,Default,,0,0,0,,Иә... бұл жақсы➡
Dialogue: 0,0:05:30.26,0:05:32.23,Default,,0,0,0,,Сонда кездескенше.
Dialogue: 0,0:05:33.23,0:05:35.23,Default,,0,0,0,,Аа... (домофон дыбысы)
Dialogue: 0,0:05:35.23,0:05:37.23,Default,,0,0,0,,Біраз өсіп алғанша күтсеңші.
Dialogue: 0,0:05:39.23,0:05:41.74,Default,,0,0,0,,Хикари-чан! Жаңалықты көрдіңіз бе?
Dialogue: 0,0:05:45.24,0:05:47.24,Default,,0,0,0,,Ах...!
Dialogue: 0,0:05:47.24,0:05:49.24,Default,,0,0,0,,Жоқ... дұрыс па?
Dialogue: 0,0:05:49.24,0:05:51.25,Default,,0,0,0,,Хикари-чан!
Dialogue: 0,0:05:57.25,0:05:59.25,Default,,0,0,0,,Хаа….
Dialogue: 0,0:05:59.25,0:06:01.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:01.26,0:06:03.26,Default,,0,0,0,,Хикари-чан, күте тұр!
Dialogue: 0,0:06:03.26,0:06:10.23,Default,,0,0,0,,Хаа….
Dialogue: 0,0:06:10.23,0:06:12.23,Default,,0,0,0,,Гехо...
Dialogue: 0,0:06:12.23,0:06:14.24,Default,,0,0,0,,Өзіңізді қатты итермеңіз.
Dialogue: 0,0:06:17.74,0:06:19.74,Default,,0,0,0,,Мүлдем...!
Dialogue: 0,0:06:19.74,0:06:21.74,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:06:22.74,0:06:24.71,Default,,0,0,0,,Хикари-чан?
Dialogue: 0,0:06:25.75,0:06:27.75,Default,,0,0,0,,Міне...
Dialogue: 0,0:06:27.75,0:06:29.72,Default,,0,0,0,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,0:06:31.25,0:06:33.26,Default,,0,0,0,,Ах...!
Dialogue: 0,0:06:33.26,0:06:35.26,Default,,0,0,0,,Бұл Декү.
Dialogue: 0,0:06:35.26,0:06:37.23,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:06:40.76,0:06:43.73,Default,,0,0,0,,Оның бұлай тауға шығуы мүмкін емес, солай ма? ➡
Dialogue: 0,0:06:43.73,0:06:46.77,Default,,0,0,0,,Мен сенімдімін... олар бір жерде бірдеңе істеп жатыр!
Dialogue: 0,0:06:46.77,0:06:49.77,Default,,0,0,0,,Мен оның ақырында қайтып келетініне сенімдімін!
Dialogue: 0,0:06:52.74,0:06:54.74,Default,,0,0,0,,Ол әлдеқашан шешілді...
Dialogue: 0,0:07:01.25,0:07:03.25,Default,,0,0,0,,Өтінемін! ➡
Dialogue: 0,0:07:03.25,0:07:05.22,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:07:06.25,0:07:08.26,Default,,0,0,0,,Өтінемін! ➡
Dialogue: 0,0:07:08.26,0:07:11.26,Default,,0,0,0,,Ол менің ағам... өтінемін! ➡
Dialogue: 0,0:07:11.26,0:07:13.26,Default,,0,0,0,,Рахмет! ➡
Dialogue: 0,0:07:13.26,0:07:15.23,Default,,0,0,0,,Өтінемін➡
Dialogue: 0,0:07:15.23,0:07:17.23,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:07:20.24,0:07:23.24,Default,,0,0,0,,Ойыңыз болса, бізге хабарлаңыз➡
Dialogue: 0,0:07:23.24,0:07:25.24,Default,,0,0,0,,Өтінемін➡
Dialogue: 0,0:07:25.24,0:07:27.24,Default,,0,0,0,,Сізге көп рахмет...
Dialogue: 0,0:07:27.24,0:07:29.24,Default,,0,0,0,,«Әскери полиция корпусы билікке деген құмарлығынан
Dialogue: 0,0:07:36.75,0:07:38.75,Default,,0,0,0,,Мен барамын.
Dialogue: 0,0:07:45.26,0:07:47.23,Default,,0,0,0,,Өтінемін➡
Dialogue: 0,0:07:47.23,0:07:49.73,Default,,0,0,0,,Алдын ала рахмет➡
Dialogue: 0,0:07:49.73,0:07:51.77,Default,,0,0,0,,Өтінемін➡
Dialogue: 0,0:07:51.77,0:07:54.24,Default,,0,0,0,,Алдын ала рахмет...
Dialogue: 0,0:07:57.77,0:08:01.24,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:08:11.75,0:08:13.72,Default,,0,0,0,,Жаңбыр тоқтамайды.
Dialogue: 0,0:08:18.76,0:08:20.73,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:08:22.23,0:08:24.23,Default,,0,0,0,,Қауырсын….
Dialogue: 0,0:08:33.74,0:08:35.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:37.25,0:08:39.71,Default,,0,0,0,,Болды... Амансың ба?
Dialogue: 0,0:08:43.79,0:08:46.79,Default,,0,0,0,,Мазалағаным үшін кешіріңіз, сіз жай ғана жұмыс істеп жатырсыз.
Dialogue: 0,0:08:47.76,0:08:49.72,Default,,0,0,0,,Хаа...! үлкен аға.
Dialogue: 0,0:08:57.73,0:08:59.73,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:09:07.78,0:09:09.74,Default,,0,0,0,,Мейдо-сан➡
Dialogue: 0,0:09:09.74,0:09:12.75,Default,,0,0,0,,Қалайсың? ➡
Dialogue: 0,0:09:12.75,0:09:14.72,Default,,0,0,0,,Мейдо мырза?
Dialogue: 0,0:09:27.73,0:09:29.73,Default,,0,0,0,,Қашан қайтасың?
Dialogue: 0,0:09:30.73,0:09:32.73,Default,,0,0,0,,Мәңгі➡
Dialogue: 0,0:09:32.73,0:09:34.77,Default,,0,0,0,,Сіз күтіп тұрсыз ба? ➡
Dialogue: 0,0:09:34.77,0:09:39.24,Default,,0,0,0,,Егер бұлай болатын болса, мен сені жібермес едім! ➡
Dialogue: 0,0:09:39.24,0:09:42.24,Default,,0,0,0,,Мен сені жіберген жоқпын!
Dialogue: 0,0:09:42.24,0:09:44.75,Default,,0,0,0,,Ақымақ аға...!
Dialogue: 0,0:09:44.75,0:09:47.22,Default,,0,0,0,,Сен ақымақсың. Шынымен...
Dialogue: 0,0:09:49.25,0:09:51.25,Default,,0,0,0,,Мен қайтқым келеді...
Dialogue: 0,0:09:51.25,0:09:53.22,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:10:01.73,0:10:03.73,Default,,0,0,0,,Ха….
Dialogue: 0,0:10:06.77,0:10:08.74,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:10:10.24,0:10:12.24,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:10:13.24,0:10:21.75,Default,,0,0,0,,♬～
Dialogue: 0,0:10:21.75,0:10:23.75,Default,,0,0,0,,Сіз...?
Dialogue: 0,0:10:23.75,0:10:33.73,Default,,0,0,0,,♬～
Dialogue: 0,0:10:39.27,0:10:41.24,Default,,0,0,0,,Карточка?
Dialogue: 0,0:10:41.24,0:10:43.74,Default,,0,0,0,,Бұл... Уақыттың тағдыры картасы.
Dialogue: 0,0:10:43.74,0:10:47.28,Default,,0,0,0,,Хикари Мейдо Сіз таңдадыңыз➡
Dialogue: 0,0:10:47.28,0:10:49.74,Default,,0,0,0,,Тағдырды өзгерту үшін шайқаста.
Dialogue: 0,0:10:49.74,0:10:52.75,Default,,0,0,0,,Аты...Тағдыр соғысы!
Dialogue: 0,0:10:52.75,0:10:54.75,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:10:54.75,0:10:56.78,Default,,0,0,0,,Соңына дейін аман болсаң➡
Dialogue: 0,0:10:56.78,0:10:59.75,Default,,0,0,0,,Карталардың күшімен сіздің тілектеріңіз орындалады.
Dialogue: 0,0:11:01.06,0:11:03.26,Default,,0,0,0,,Мен де осындамын деп ойлаймын.
Dialogue: 0,0:11:03.26,0:11:05.26,Default,,0,0,0,,Тұлып сөйлеп тұр➡
Dialogue: 0,0:11:05.26,0:11:08.23,Default,,0,0,0,,Карталар сіздің тілектеріңізді орындай алады...
Dialogue: 0,0:11:08.23,0:11:10.27,Default,,0,0,0,,Сене аласыз ба?
Dialogue: 0,0:11:10.27,0:11:12.73,Default,,0,0,0,,Акина Мейдо басында солай болды.
Dialogue: 0,0:11:12.73,0:11:14.80,Default,,0,0,0,,E? Бірақ➡
Dialogue: 0,0:11:14.80,0:11:16.77,Default,,0,0,0,,Тағдыр соғысына қатысқан.
Dialogue: 0,0:11:16.77,0:11:19.77,Default,,0,0,0,,Тағдырыңды өзгерту үшін, қарындасым.
Dialogue: 0,0:11:20.78,0:11:22.74,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:11:22.74,0:11:24.75,Default,,0,0,0,,Ағаң туралы білесің бе?
Dialogue: 0,0:11:24.75,0:11:27.25,Default,,0,0,0,,Әңгімеле... сөйлес!
Dialogue: 0,0:11:27.25,0:11:29.22,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:11:32.79,0:11:36.26,Default,,0,0,0,,Акина Мейдо Судың қалауына түсіп қалады➡
Dialogue: 0,0:11:36.26,0:11:38.76,Default,,0,0,0,,…
Dialogue: 0,0:11:38.76,0:11:42.23,Default,,0,0,0,,Бұл оның тағдыры.
Dialogue: 0,0:11:42.23,0:11:45.23,Default,,0,0,0,,Не... тағдыр!
Dialogue: 0,0:11:45.23,0:11:47.24,Default,,0,0,0,,Бұл сен кінәлісің!
Dialogue: 0,0:11:52.27,0:11:55.78,Default,,0,0,0,,Бұл денеге қанша зиян тигізсем де, мәні жоқ➡
Dialogue: 0,0:11:55.78,0:11:57.75,Default,,0,0,0,,Бұл тұлып спикерден басқа ештеңе емес➡
Dialogue: 0,0:11:57.75,0:12:01.25,Default,,0,0,0,,Егер ол сынса, ауыстыруды дайындаңыз.
Dialogue: 0,0:12:01.25,0:12:03.25,Default,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:12:03.25,0:12:05.72,Default,,0,0,0,,А... ағайын.
Dialogue: 0,0:12:09.29,0:12:12.26,Default,,0,0,0,,Ол өз тағдырын өзгерте алмады➡
Dialogue: 0,0:12:12.26,0:12:15.73,Default,,0,0,0,,Бірақ оны өзгертуге болады.
Dialogue: 0,0:12:15.73,0:12:17.77,Default,,0,0,0,,➡
Dialogue: 0,0:12:17.77,0:12:21.77,Default,,0,0,0,,Сіздің шынымен өзгерткіңіз келетін тағдырыңыз бар ма?
Dialogue: 0,0:12:23.24,0:12:25.24,Default,,0,0,0,,Мен өзгергім келеді...жоқ!
Dialogue: 0,0:12:27.78,0:12:30.25,Default,,0,0,0,,Мен оны өзгертемін... мүлдем!
Dialogue: 0,0:12:33.25,0:12:35.78,Default,,0,0,0,,Карточка сіздің жүрегіңізге жауап берді➡
Dialogue: 0,0:12:35.78,0:12:39.25,Default,,0,0,0,,Бұл Ұлы Тағдыр соғысына қарсы шыққандардың дәлелі!
Dialogue: 0,0:12:39.25,0:12:41.29,Default,,0,0,0,,Қазір барлығы осында➡
Dialogue: 0,0:12:41.29,0:12:44.26,Default,,0,0,0,,Енді тағдыр соғысы қайтадан басталды!
Dialogue: 0,0:12:54.24,0:12:56.27,Default,,0,0,0,,Мысалы➡
Dialogue: 0,0:12:56.27,0:12:59.74,Default,,0,0,0,,Егер сіз қарсыласыңызды қандай да бір жолмен физикалық түрде алып тастасаңыз➡
Dialogue: 0,0:12:59.74,0:13:01.74,Default,,0,0,0,,Не болады?
Dialogue: 0,0:13:01.74,0:13:03.78,Default,,0,0,0,,Мен де тоқтатар едім➡
Dialogue: 0,0:13:03.78,0:13:06.28,Default,,0,0,0,,Ең бастысы, тағдыр оған жол бермейді.
Dialogue: 0,0:13:06.28,0:13:10.25,Default,,0,0,0,,Адамдар жасайтын кез келген нәрсе әрқашан сәтсіздікке ұшырайды.
Dialogue: 0,0:13:10.25,0:13:13.25,Default,,0,0,0,,Жеңіске жетудің жалғыз жолы – күресу.
Dialogue: 0,0:13:13.25,0:13:15.26,Default,,0,0,0,,Мысалдар... оларды дайындаңыз.
Dialogue: 0,0:13:15.26,0:13:18.26,Default,,0,0,0,,Тірі қалсаң.
Dialogue: 0,0:13:18.26,0:13:20.26,Default,,0,0,0,,Біз аман қаламыз.
Dialogue: 0,0:13:20.26,0:13:22.23,Default,,0,0,0,,Мүлдем.
Dialogue: 0,0:13:26.77,0:13:44.25,Default,,0,0,0,,♬～
Dialogue: 0,0:13:45.29,0:13:48.76,Default,,0,0,0,,Жеңімпаз...уақыттың тағдыры~!
Dialogue: 0,0:13:50.29,0:13:54.76,Default,,0,0,0,,Хикари Мейду... Тағдыр соғысынан керемет түрде аман қалдыңыз➡
Dialogue: 0,0:13:54.76,0:13:56.76,Default,,0,0,0,,Менің тағдырымды өзгертуге мүмкіндігім бар.
Dialogue: 0,0:13:59.23,0:14:01.24,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:14:08.74,0:14:10.75,Default,,0,0,0,,Өкінбейсіз, солай ма?
Dialogue: 0,0:14:10.75,0:14:13.75,Default,,0,0,0,,Менде сансыз өкініш бар➡
Dialogue: 0,0:14:13.75,0:14:15.78,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:14:15.78,0:14:18.25,Default,,0,0,0,,Енді айқайлаңыз! Уақыттың тағдырына тілек➡
Dialogue: 0,0:14:18.25,0:14:20.76,Default,,0,0,0,,Сіздің тілегіңіз!
Dialogue: 0,0:14:20.76,0:14:22.79,Default,,0,0,0,,Уақыт тағдыры➡
Dialogue: 0,0:14:22.79,0:14:26.29,Default,,0,0,0,,Мен ағамның өлімінің тағдырын өзгерткім келеді!
Dialogue: 0,0:14:36.74,0:14:38.74,Default,,0,0,0,,Мұнда...А!
Dialogue: 0,0:14:57.76,0:14:59.73,Default,,0,0,0,,Үш жыл бұрын?
Dialogue: 0,0:15:01.26,0:15:06.73,Default,,0,0,0,,«Әскери полиция корпусы билікке деген құмарлығынан
Dialogue: 0,0:15:06.73,0:15:09.24,Default,,0,0,0,,Аа, шамамен үш сағаттан кейін.
Dialogue: 0,0:15:09.24,0:15:11.74,Default,,0,0,0,,Толық емес жұмысыңыздың ағасы сүйкімді ме?
Dialogue: 0,0:15:11.74,0:15:14.74,Default,,0,0,0,,Хмм...Керемет пе?
Dialogue: 0,0:15:14.74,0:15:16.74,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:15:28.26,0:15:30.26,Default,,0,0,0,,Мүлдем...
Dialogue: 0,0:15:30.26,0:15:32.23,Default,,0,0,0,,Мен сені құтқарамын!
Dialogue: 0,0:15:34.26,0:15:38.27,Default,,0,0,0,,Design Force уақытты да басқара алады➡
Dialogue: 0,0:15:38.27,0:15:40.77,Default,,0,0,0,,Бұл үлкен қорқыныш.
Dialogue: 0,0:15:40.77,0:15:43.27,Default,,0,0,0,,Уақытқа осылайша оралдым➡
Dialogue: 0,0:15:43.27,0:15:46.27,Default,,0,0,0,,Мен өлім тағдырымды өзгерту үшін әрекет ете бастадым.
Dialogue: 0,0:15:47.41,0:15:50.38,Default,,0,0,0,,｟Егер өлгіңіз келмесе, тағдыр соғысынан бас тартыңыз｠
Dialogue: 0,0:15:51.78,0:15:54.28,Default,,0,0,0,,Осы тағдырлы соғыс туралы ойланып жатсаңыз➡
Dialogue: 0,0:15:54.28,0:15:57.29,Default,,0,0,0,,Мен сені көндіре аламын деп ойладым.
Dialogue: 0,0:15:57.29,0:15:59.79,Default,,0,0,0,,Маған неге дұрыс айтпадың?
Dialogue: 0,0:15:59.79,0:16:01.76,Default,,0,0,0,,Тіпті бетперде кигеннің өзінде...
Dialogue: 0,0:16:01.76,0:16:03.72,Default,,0,0,0,,Сіз оны қалағандықтан кидім деп ойлайсыз ба?
Dialogue: 0,0:16:04.73,0:16:06.79,Default,,0,0,0,,Мен осы пішінде көрінемін➡
Dialogue: 0,0:16:06.79,0:16:10.26,Default,,0,0,0,,Егер мен саған «Тағдыр соғысынан бас тарт» десем, тыңдар ма едің?
Dialogue: 0,0:16:10.26,0:16:12.77,Default,,0,0,0,,Тілектер шынымен орындалады деп естідім➡
Dialogue: 0,0:16:12.77,0:16:14.77,Default,,0,0,0,,Сіз бас тарта аласыз ба?
Dialogue: 0,0:16:14.77,0:16:16.77,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:16:16.77,0:16:18.74,Default,,0,0,0,,Мен мұны істемеймін. Мен мұны істеуге ешқандай мүмкіндік жоқ.
Dialogue: 0,0:16:19.77,0:16:22.24,Default,,0,0,0,,Сондай-ақ Суомен ➡ байланысқа шықты
Dialogue: 0,0:16:22.24,0:16:25.25,Default,,0,0,0,,Қалаған нәрсең болмаса, өлу үшін жолыңнан кет➡
Dialogue: 0,0:16:25.25,0:16:27.25,Default,,0,0,0,,Қатысудың мәні жоқ➡
Dialogue: 0,0:16:27.25,0:16:29.75,Default,,0,0,0,,Мен осылай дедім...
Dialogue: 0,0:16:29.75,0:16:31.75,Default,,0,0,0,,Сөзбен тіл табыса алмайтын құбыжыққа➡
Dialogue: 0,0:16:31.75,0:16:34.22,Default,,0,0,0,,Ештеңе айтудың қажеті жоқ еді.
Dialogue: 0,0:16:34.22,0:16:37.26,Default,,0,0,0,,Бірақ менің сүйіктім ➡ болды
Dialogue: 0,0:16:37.26,0:16:39.29,Default,,0,0,0,,Сейзо Тайзо.
Dialogue: 0,0:16:39.29,0:16:42.26,Default,,0,0,0,,Бұл оның тағдыр соғысына қатысуы болды.
Dialogue: 0,0:16:42.26,0:16:44.27,Default,,0,0,0,,Мен бас тарттым➡
Dialogue: 0,0:16:44.27,0:16:47.77,Default,,0,0,0,,Сіз өз тілектеріңізді орындай аласыз➡
Dialogue: 0,0:16:47.77,0:16:50.77,Default,,0,0,0,,Негізі мен де солай ойладым.
Dialogue: 0,0:16:50.77,0:16:52.77,Default,,0,0,0,,Сіз бас тарта аласыз.
Dialogue: 0,0:16:52.77,0:16:55.74,Default,,0,0,0,,Егер сіз төбелеспесеңіз, әдепкі бойынша табиғи түрде жеңіліске ұшырайсыз.
Dialogue: 0,0:16:55.74,0:16:57.78,Default,,0,0,0,,Тайзо Сейзоның соғысқа қатысуы ➡
Dialogue: 0,0:16:57.78,0:17:00.25,Default,,0,0,0,,Бұл менің әлемімде болған жоқ.
Dialogue: 0,0:17:00.25,0:17:02.25,Default,,0,0,0,,Осылайша ол қосылды➡
Dialogue: 0,0:17:02.25,0:17:04.25,Default,,0,0,0,,Онии-чан мен Суоу Коцугу➡ жеңіп алсаңыз
Dialogue: 0,0:17:04.25,0:17:06.25,Default,,0,0,0,,Мен тағдырым өзгереді деп ойладым.
Dialogue: 0,0:17:09.32,0:17:11.29,Default,,0,0,0,,｟Кейзо Тайзо➡
Dialogue: 0,0:17:11.29,0:17:13.76,Default,,0,0,0,,Мен сенің тағдыр соғысына қатысқаныңды қалаймын.
Dialogue: 0,0:17:16.26,0:17:18.77,Default,,0,0,0,,Бұл оқиға...➡
Dialogue: 0,0:17:18.77,0:17:22.77,Default,,0,0,0,,Бірақ мен сені өтірік айтып тұрған жоқ деп ойлаймын.
Dialogue: 0,0:17:22.77,0:17:24.77,Default,,0,0,0,,Сенесің бе?
Dialogue: 0,0:17:24.77,0:17:27.74,Default,,0,0,0,,Бұл сізді егжей-тегжейлі тыңдағаннан кейін ғана➡
Dialogue: 0,0:17:27.74,0:17:30.78,Default,,0,0,0,,Бірақ алдымен бетпердеңізді шешіп жібере аласыз ба?
Dialogue: 0,0:17:30.78,0:17:33.85,Default,,0,0,0,,Сенім бизнестегі ең маңызды нәрсе➡
Dialogue: 0,0:17:33.85,0:17:36.82,Default,,0,0,0,,Өзінің шынайы болмысын аша алмайтын адаммен жұмыс істеуге болмайды. ｠
Dialogue: 0,0:17:41.29,0:17:44.26,Default,,0,0,0,,Оның оқиғасы менің қиялымнан тыс болды.
Dialogue: 0,0:17:46.33,0:17:48.26,Default,,0,0,0,,｟Бұл таңқаларлық.
Dialogue: 0,0:17:48.26,0:17:50.33,Default,,0,0,0,,Тағдыр соғысына қатысасыз ба?
Dialogue: 0,0:17:50.33,0:17:52.27,Default,,0,0,0,,Бұған дейін.
Dialogue: 0,0:17:52.27,0:17:54.27,Default,,0,0,0,,Тағы бірдеңе...?
Dialogue: 0,0:17:54.27,0:17:56.30,Default,,0,0,0,,Айтқаныңыз рас болса➡
Dialogue: 0,0:17:56.30,0:17:58.77,Default,,0,0,0,,Сіз дәл қазір бұл дүниеде ауруханадасыз ба?
Dialogue: 0,0:17:58.77,0:18:00.74,Default,,0,0,0,,Сіз маған баруды жоспарлап отырсыз ба?
Dialogue: 0,0:18:00.74,0:18:02.81,Default,,0,0,0,,Маңызды шешімдер➡
Dialogue: 0,0:18:02.81,0:18:05.28,Default,,0,0,0,,Мен оны өз көзіммен көріп, шешемін.
Dialogue: 0,0:18:07.28,0:18:10.28,Default,,0,0,0,,Біреу үшін көп жұмыс істеуге болады➡
Dialogue: 0,0:18:10.28,0:18:13.29,Default,,0,0,0,,Менің ойымша, бұл жаман емес, бірақ...
Dialogue: 0,0:18:14.32,0:18:16.29,Default,,0,0,0,,Тайзо-сан? ｠
Dialogue: 0,0:18:16.29,0:18:19.26,Default,,0,0,0,,Мен Тағдыр соғысына қатысуға шешім қабылдадым.
Dialogue: 0,0:18:21.26,0:18:23.26,Default,,0,0,0,,Ұлы соғыстың қосындысы ➡
Dialogue: 0,0:18:23.26,0:18:25.30,Default,,0,0,0,,Мен Хикари-чан айтқандай жүрдім.
Dialogue: 0,0:18:25.30,0:18:27.77,Default,,0,0,0,,Бастапқыда мен әдепкі бойынша жеңілуім керек еді.➡
Dialogue: 0,0:18:27.77,0:18:29.77,Default,,0,0,0,,Микото-чанды жеңу➡
Dialogue: 0,0:18:29.77,0:18:32.24,Default,,0,0,0,,Бұл Акина-кунға қарсы матч болды.
Dialogue: 0,0:18:33.24,0:18:35.28,Default,,0,0,0,,Мен мұнда жеңдім➡
Dialogue: 0,0:18:35.28,0:18:37.75,Default,,0,0,0,,Мен оны жіберетін болдым...
Dialogue: 0,0:18:38.78,0:18:41.75,Default,,0,0,0,,Тағдырдың баратын жеріне ұшамын➡
Dialogue: 0,0:18:41.75,0:18:43.75,Default,,0,0,0,,Қос жетек!
Dialogue: 0,0:18:45.29,0:18:47.76,Default,,0,0,0,,Бірақ мен жеңілдім.
Dialogue: 0,0:18:49.26,0:18:51.26,Default,,0,0,0,,Екеуінің қабілетіне қарап➡
Dialogue: 0,0:18:51.26,0:18:54.26,Default,,0,0,0,,Мен Тайзо Сейзо жеңеді деп ойладым.
Dialogue: 0,0:18:54.26,0:18:56.26,Default,,0,0,0,,Әрине менің де жеңгім келді➡
Dialogue: 0,0:18:56.26,0:18:58.73,Default,,0,0,0,,Бірақ карта жекпе-жегінде абсолютті болмайды.
Dialogue: 0,0:18:59.77,0:19:01.77,Default,,0,0,0,,Және тағы да ағаммен➡
Dialogue: 0,0:19:01.77,0:19:03.77,Default,,0,0,0,,Үздіксіз суо қалды.
Dialogue: 0,0:19:04.74,0:19:06.77,Default,,0,0,0,,Бір ғана жол қалды...
Dialogue: 0,0:19:06.77,0:19:10.28,Default,,0,0,0,,Жоқ, сіз маған бас тартуымды сұрадыңыз➡
Dialogue: 0,0:19:10.28,0:19:13.75,Default,,0,0,0,,Мәселе мынада, егер мен Сууды жеңсем, бәрі шешіледі, солай ма?
Dialogue: 0,0:19:13.75,0:19:16.28,Default,,0,0,0,,Бұл оңай емес➡
Dialogue: 0,0:19:16.28,0:19:18.79,Default,,0,0,0,,Онии-чан Суохты ешқашан жеңе алмайды.
Dialogue: 0,0:19:18.79,0:19:20.76,Default,,0,0,0,,Мен мұны істеуім керек...!
Dialogue: 0,0:19:20.76,0:19:24.26,Default,,0,0,0,,Көрдіңіз бе? Брагдомейердің құдайлық шеберлігі – ➡
Dialogue: 0,0:19:24.26,0:19:26.73,Default,,0,0,0,,Қарсыластың барлық мүмкіндіктерін жоққа шығарады.
Dialogue: 0,0:19:28.30,0:19:31.27,Default,,0,0,0,,Нөлге дейін Резаэльдің кереметі болмайды.
Dialogue: 0,0:19:32.80,0:19:36.27,Default,,0,0,0,,Брагдомьер – ғажайып өлтірушінің тағдыры.
Dialogue: 0,0:19:38.24,0:19:40.27,Default,,0,0,0,,Түсінесіз бе? ➡
Dialogue: 0,0:19:40.27,0:19:42.74,Default,,0,0,0,,Сондықтан мен қазір де «Тағдыр соғысынан» бас тартамын.
Dialogue: 0,0:19:42.74,0:19:44.75,Default,,0,0,0,,Мен бас тартпаймын!
Dialogue: 0,0:19:44.75,0:19:46.75,Default,,0,0,0,,Әлі ондай емес...!
Dialogue: 0,0:19:46.75,0:19:49.28,Default,,0,0,0,,Бұл шынымен үмітсіз болуы мүмкін➡
Dialogue: 0,0:19:49.28,0:19:52.25,Default,,0,0,0,,Бірақ нөл болмаса, мен қол созамын! ➡
Dialogue: 0,0:19:52.25,0:19:54.26,Default,,0,0,0,,Хикариді құтқаруға мүмкіндік бар➡
Dialogue: 0,0:19:54.26,0:19:56.22,Default,,0,0,0,,Мен бас тарта алмаймын!
Dialogue: 0,0:19:57.29,0:20:00.80,Default,,0,0,0,,Ақымақ болма! Үлкен аға тек жауапкершілікті сезінеді➡
Dialogue: 0,0:20:00.80,0:20:03.76,Default,,0,0,0,,Сол апаттан бергі лагерь туралы!
Dialogue: 0,0:20:10.87,0:20:14.24,Default,,0,0,0,,Менің өліп қала жаздағаныма сен кінәлі деп ойлайсың, солай ма?
Dialogue: 0,0:20:14.24,0:20:16.74,Default,,0,0,0,,Бұл... мен...
Dialogue: 0,0:20:16.74,0:20:19.75,Default,,0,0,0,,Мен мұны осы жолы тоқтатамын! ➡
Dialogue: 0,0:20:19.75,0:20:21.75,Default,,0,0,0,,Ол сонда—сол жақта~
Dialogue: 0,0:20:21.75,0:20:24.29,Default,,0,0,0,,Бауырым, менімен соғыс.
Dialogue: 0,0:20:24.29,0:20:27.29,Default,,0,0,0,,Хикари? Сух Сухты жеңесіз бе? ➡
Dialogue: 0,0:20:27.29,0:20:30.79,Default,,0,0,0,,Мені жеңе алмасаң, оны да ешқашан жеңе алмайсың.
Dialogue: 0,0:20:30.79,0:20:35.26,Default,,0,0,0,,Хикари-чан тағдыр соғысынан аман өтіп, осында келді, солай ма? ➡
Dialogue: 0,0:20:35.26,0:20:37.26,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:20:37.26,0:20:39.80,Default,,0,0,0,,Өте күшті...?
Dialogue: 0,0:20:39.80,0:20:43.74,Default,,0,0,0,,Суох Брагдомерді жеңе алады десең➡
Dialogue: 0,0:20:43.74,0:20:45.74,Default,,0,0,0,,Мені ұрыспен сендір.
Dialogue: 0,0:20:48.24,0:20:51.28,Default,,0,0,0,,Акина Мейдоға не болды➡
Dialogue: 0,0:20:51.28,0:20:54.28,Default,,0,0,0,,Тағдырыңыздан асып ұшып барасыз ба?
Dialogue: 0,0:20:55.78,0:20:57.79,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:20:57.79,0:21:01.26,Default,,0,0,0,,Күресейік. Жеңсем, Суохпен жұдырықтасамын➡
Dialogue: 0,0:21:01.26,0:21:03.76,Default,,0,0,0,,Ал осы жолы алсам біртүрлі болар еді➡
Dialogue: 0,0:21:03.76,0:21:05.79,Default,,0,0,0,,Оны жең!
Dialogue: 0,0:21:05.79,0:21:08.26,Default,,0,0,0,,Мен жеңілмеймін! Мен де!
Dialogue: 0,0:21:13.77,0:21:16.30,Default,,0,0,0,,Елтаңба...
Dialogue: 0,0:21:16.30,0:21:20.24,Default,,0,0,0,,Ғажайыптар тағдыры мен Уақыт тағдыры жауап береді...?
Dialogue: 0,0:21:20.24,0:21:23.24,Default,,0,0,0,,Тағдырымен күрескен екі адам...➡
Dialogue: 0,0:21:23.24,0:21:25.25,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:32.29,0:21:35.76,Default,,0,0,0,,Хикари-чан жеңсе, Акикун бас тартады➡
Dialogue: 0,0:21:35.76,0:21:38.29,Default,,0,0,0,,Бірақ содан кейін Хикари-чан...
Dialogue: 0,0:21:38.29,0:21:41.76,Default,,0,0,0,,Сенпай жеңсе, Хикари-чан биліктен кетеді.
Dialogue: 0,0:21:41.76,0:21:45.27,Default,,0,0,0,,Бірақ болашақта бәрі ойдағыдай болса, Сенпай...
Dialogue: 0,0:21:45.27,0:21:48.27,Default,,0,0,0,,Кім жеңсе де...➡
Dialogue: 0,0:21:48.27,0:21:50.24,Default,,0,0,0,,Әлі де.
Dialogue: 0,0:21:51.24,0:21:53.81,Default,,0,0,0,,Тағдырды не өзгертеді...
Dialogue: 0,0:21:53.81,0:21:55.74,Default,,0,0,0,,Бұл менмін! Бұл мен!
Dialogue: 0,0:21:55.74,0:21:58.75,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:22:00.25,0:22:06.25,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory