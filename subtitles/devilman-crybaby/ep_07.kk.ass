Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.01,0:00:16.01,Default,,0,0,0,,♪~
Dialogue: 0,0:01:35.92,0:01:40.93,Default,,0,0,0,,~♪
Dialogue: 0,0:01:41.01,0:01:47.31,Default,,0,0,0,,(Битбокс дыбысы)
Dialogue: 0,0:01:47.44,0:01:50.15,Default,,0,0,0,,♪Ей, естідің бе? Бұл жерде шайтан бар сияқты.
Dialogue: 0,0:01:50.27,0:01:53.19,Default,,0,0,0,,♪Шайтан қазірдің өзінде барлық жерде бар сияқты.
Dialogue: 0,0:01:53.32,0:01:55.78,Default,,0,0,0,,♪Бірақ шайтан шынымен қалай көрінеді?
Dialogue: 0,0:01:55.90,0:01:58.78,Default,,0,0,0,,♪Мен сыртқы келбет, пішін және мінез-құлық туралы ештеңе білмеймін.
Dialogue: 0,0:01:58.95,0:02:00.41,Default,,0,0,0,,♪Әрине бұл жаман.
Dialogue: 0,0:02:00.53,0:02:01.91,Default,,0,0,0,,♪Ақыр аяғында ол шайтан ғой.
Dialogue: 0,0:02:02.03,0:02:03.33,Default,,0,0,0,,♪Бұл да керемет көрінетініне сенімдімін
Dialogue: 0,0:02:03.45,0:02:04.70,Default,,0,0,0,,♪Ақыр аяғында ол шайтан ғой.
Dialogue: 0,0:02:04.83,0:02:06.25,Default,,0,0,0,,♪ ұрлау, жасау, тонау, өлтіру
Dialogue: 0,0:02:06.37,0:02:07.21,Default,,0,0,0,,♪Бәрі бар екеніне сенімдімін
Dialogue: 0,0:02:07.58,0:02:10.54,Default,,0,0,0,,♪Сіз мұнда ешкім білмейтін жерге келдіңіз. Ақша табыңыз.
Dialogue: 0,0:02:10.67,0:02:12.04,Default,,0,0,0,,♪Бірақ мұндай адамдар қалыпты
Dialogue: 0,0:02:12.17,0:02:13.75,Default,,0,0,0,,♪ Барлық жерге қараңыз!
Dialogue: 0,0:02:13.88,0:02:15.34,Default,,0,0,0,,♪Шын мәнінде бар емес пе?
Dialogue: 0,0:02:15.46,0:02:16.92,Default,,0,0,0,,♪Не болып жатыр?
Dialogue: 0,0:02:17.05,0:02:18.30,Default,,0,0,0,,♪Сен және шайтан, мен және шайтан
Dialogue: 0,0:02:18.42,0:02:19.84,Default,,0,0,0,,♪Айырмашылық қай жерде?
Dialogue: 0,0:02:19.97,0:02:21.22,Default,,0,0,0,,♪Айырмашылықты кім айта алады?
Dialogue: 0,0:02:21.34,0:02:22.85,Default,,0,0,0,,♪Ал, ол енді еш жерде жоқ.
Dialogue: 0,0:02:22.97,0:02:26.02,Default,,0,0,0,,♪Мен басқашамын. Мен ешқашан шайтанға айналмаймын.
Dialogue: 0,0:02:25.27,0:02:26.72,Default,,0,0,0,,♪Бұл рас па?
Dialogue: 0,0:02:26.14,0:02:28.43,Default,,0,0,0,,♪Сен шайтансың ба? Мен оны да білмеймін
Dialogue: 0,0:02:26.89,0:02:28.43,Default,,0,0,0,,♪ Чигеё
Dialogue: 0,0:02:28.43,0:02:28.93,Default,,0,0,0,,♪Сен шайтансың ба? Мен оны да білмеймін
Dialogue: 0,0:02:28.94,0:02:31.94,Default,,0,0,0,,♪Мен қандай адам екенімді білемін.
Dialogue: 0,0:02:32.06,0:02:34.90,Default,,0,0,0,,♪Мен өте жақсы болғаным үшін кешірім сұраймын. Мен өзімді қорғауға тура келетін жалғыз адаммын.
Dialogue: 0,0:02:35.02,0:02:37.82,Default,,0,0,0,,♪Мен кенеттен артымнан пышақталып қалуым мүмкін.
Dialogue: 0,0:02:37.94,0:02:38.90,Default,,0,0,0,,♪Егер сіз сақтықты төмендетсеңіз
Dialogue: 0,0:02:39.03,0:02:40.16,Default,,0,0,0,,♪Менің денемді алып кетеді
Dialogue: 0,0:02:40.28,0:02:42.74,Default,,0,0,0,,♪Сонымен қатар, әрқашан әлсіздер өлтіріледі.
Dialogue: 0,0:02:42.87,0:02:43.99,Default,,0,0,0,,♪Бұл өзгермейді
Dialogue: 0,0:02:44.12,0:02:45.66,Default,,0,0,0,,♪Әрқашан әлсіздер өлтіріледі
Dialogue: 0,0:02:45.83,0:02:47.00,Default,,0,0,0,,♪Бұл өзгермейді.
Dialogue: 0,0:02:47.12,0:02:48.33,Default,,0,0,0,,♪Қорыққан жігіттен
Dialogue: 0,0:02:48.45,0:02:50.00,Default,,0,0,0,,♪Біреуді қарумен өлтіру
Dialogue: 0,0:02:50.12,0:02:53.13,Default,,0,0,0,,♪Егер сіз қорықпасаңыз және қарусыз қалсаңыз, бұл шын мәнінде өлімге әкеледі.
Dialogue: 0,0:02:53.25,0:02:54.34,Default,,0,0,0,,♪Ақыл-есі дұрыс емес адамнан
Dialogue: 0,0:02:54.46,0:02:55.84,Default,,0,0,0,,♪Қаруларыңызды ретімен алыңыз.
Dialogue: 0,0:02:55.96,0:02:58.84,Default,,0,0,0,,♪Әдептілер бірінен соң бірі өлтіріледі.
Dialogue: 0,0:02:58.97,0:03:01.84,Default,,0,0,0,,♪Кімнің одақтас, кімнің жау екенін ешкім білмейді.
Dialogue: 0,0:03:01.97,0:03:04.85,Default,,0,0,0,,♪Сынақтан өткен адамдар қалай адам болып қала алады.
Dialogue: 0,0:03:04.97,0:03:11.44,Default,,0,0,0,,♪ Күмән, қараңғыда сипалап, теріс тізбек басталады
Dialogue: 0,0:03:15.73,0:03:20.07,Default,,0,0,0,,Ібіліс, әрине, біз адамдардан күштірек.
Dialogue: 0,0:03:20.49,0:03:23.28,Default,,0,0,0,,Бірақ адамзат...
Dialogue: 0,0:03:23.41,0:03:26.78,Default,,0,0,0,,Физикалық жағынан басымырақ жауға қарсы өмір сүру үшін күрес.
Dialogue: 0,0:03:26.91,0:03:29.75,Default,,0,0,0,,Мен көптеген қиындықтарды жеңіп, аман қалдым.
Dialogue: 0,0:03:29.95,0:03:32.25,Default,,0,0,0,,Бұл шайтанмен шайқас та...
Dialogue: 0,0:03:32.58,0:03:34.75,Default,,0,0,0,,Біз міндетті түрде жеңіске жетеміз.
Dialogue: 0,0:03:34.92,0:03:36.46,Default,,0,0,0,,Жарайды, дайын! (Адамдар қолдайды)
Dialogue: 0,0:03:36.46,0:03:38.05,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:03:36.59,0:03:38.05,Default,,0,0,0,,Адамзат аман болсын!
Dialogue: 0,0:03:38.05,0:03:39.76,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:03:38.17,0:03:39.76,Default,,0,0,0,,Шайтанды қайтар!
Dialogue: 0,0:03:39.88,0:03:43.09,Default,,0,0,0,,Алданбаңыз! Бәрің де шайтансыңдар!
Dialogue: 0,0:03:44.39,0:03:46.68,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:03:46.93,0:03:51.02,Default,,0,0,0,,Енді адамдар жоқ! Хахаха...
Dialogue: 0,0:03:57.52,0:03:58.94,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:59.23,0:04:01.99,Default,,0,0,0,,Бұлай болмауы керек еді.
Dialogue: 0,0:04:04.95,0:04:08.16,Default,,0,0,0,,♪~
Dialogue: 0,0:04:22.47,0:04:23.80,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:30.97,0:04:32.14,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:04:32.68,0:04:36.73,Default,,0,0,0,,Мен бір адамның өлтірілгенін көрдім.
Dialogue: 0,0:04:36.85,0:04:38.27,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:38.69,0:04:40.23,Default,,0,0,0,,Адам
Dialogue: 0,0:04:40.44,0:04:42.94,Default,,0,0,0,,Ол ашулы болды, бірақ ол шайтан емес еді.
Dialogue: 0,0:04:43.57,0:04:44.99,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:45.15,0:04:48.70,Default,,0,0,0,,Неге сонша сабырлысың?
Dialogue: 0,0:04:48.83,0:04:50.03,Default,,0,0,0,,Мен мұны істеп жатқанда...
Dialogue: 0,0:04:50.16,0:04:53.54,Default,,0,0,0,,Жын-шайтан емес көптеген адамдар өліп жатыр!
Dialogue: 0,0:04:54.75,0:04:56.62,Default,,0,0,0,,Тіпті кейбір жындар да өлген.
Dialogue: 0,0:04:56.75,0:04:57.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:58.29,0:05:01.59,Default,,0,0,0,,Акира Бұл адамдар мен жындар арасындағы соғыс.
Dialogue: 0,0:05:02.01,0:05:03.30,Default,,0,0,0,,Кем дегенде бір өлі адам болады.
Dialogue: 0,0:05:03.42,0:05:05.84,Default,,0,0,0,,Сіз мұндай нәрсе болады деп ешқашан күткенсіз...
Dialogue: 0,0:05:06.05,0:05:08.30,Default,,0,0,0,,Бұл көп құрбандық болмай қоймайды.
Dialogue: 0,0:05:09.35,0:05:12.93,Default,,0,0,0,,Шайтан емес екеніңізді дәлелдеу үшін уақыт пен күш қажет.
Dialogue: 0,0:05:13.06,0:05:17.44,Default,,0,0,0,,Бір күн жүріп, бір-екі адамға көмектессең не болады?
Dialogue: 0,0:05:17.56,0:05:19.19,Default,,0,0,0,,Үлкен сурет өзгеріссіз қалады.
Dialogue: 0,0:05:19.31,0:05:20.94,Default,,0,0,0,,Оны үкіметке қалдырыңыз.
Dialogue: 0,0:05:21.15,0:05:23.69,Default,,0,0,0,,Ештеңе жасамай-ақ қарауымды қалайсыз ба?
Dialogue: 0,0:05:23.82,0:05:24.90,Default,,0,0,0,,Бұл қажетті зұлымдық.
Dialogue: 0,0:05:25.03,0:05:27.95,Default,,0,0,0,,Дайын! Егер адам қаны ағып жатса...
Dialogue: 0,0:05:28.07,0:05:29.16,Default,,0,0,0,,Бұл сіз айта алмайтын сызық!
Dialogue: 0,0:05:29.74,0:05:35.20,Default,,0,0,0,,Адамдар мен ойлағаннан да осал болды.
Dialogue: 0,0:05:35.91,0:05:38.29,Default,,0,0,0,,Кейбір құрбандықтардан құтылу мүмкін емес.
Dialogue: 0,0:05:38.54,0:05:39.96,Default,,0,0,0,,Менің таңдауым жоқ!
Dialogue: 0,0:05:40.08,0:05:45.55,Default,,0,0,0,,(Окабе) Дарү де, мен де бірнеше күн бойы түн-түні ұйықтамай жүрміз, үйге де оралған жоқпыз.
Dialogue: 0,0:06:13.24,0:06:15.24,Default,,0,0,0,,(Хане)
Dialogue: 0,0:06:15.37,0:06:16.25,Default,,0,0,0,,(қону дыбысы)
Dialogue: 0,0:06:16.91,0:06:19.58,Default,,0,0,0,,Мен саған тыныш отыруды айттым!
Dialogue: 0,0:06:20.63,0:06:21.63,Default,,0,0,0,,Ой
Dialogue: 0,0:06:21.75,0:06:26.05,Default,,0,0,0,,Осындай тар жерде қанша тығылуым керек?
Dialogue: 0,0:06:26.17,0:06:28.47,Default,,0,0,0,,Төмендегі жағдай қорқынышты.
Dialogue: 0,0:06:28.63,0:06:32.10,Default,,0,0,0,,Жүзіңіз жақсы, сондықтан сізді бірден аңдырады.
Dialogue: 0,0:06:32.64,0:06:35.97,Default,,0,0,0,,Оның шынайы болмысының ашылуына Темераның кінәсі болса керек.
Dialogue: 0,0:06:36.10,0:06:37.10,Default,,0,0,0,,Мен…
Dialogue: 0,0:06:37.98,0:06:41.10,Default,,0,0,0,,Бізден басқа да Ібіліс бар екені сөзсіз.
Dialogue: 0,0:06:41.48,0:06:43.90,Default,,0,0,0,,Екеуміз ғана болу тым қорқынышты.
Dialogue: 0,0:06:44.02,0:06:46.48,Default,,0,0,0,,Біз көбірек адам әкелсек те осында тұра аламыз ба?
Dialogue: 0,0:06:47.49,0:06:50.82,Default,,0,0,0,,Ол мұндағыдан үлкенірек көрінеді.
Dialogue: 0,0:06:50.95,0:06:53.12,Default,,0,0,0,,Ол жерде айтарлықтай нашар.
Dialogue: 0,0:06:53.45,0:06:57.12,Default,,0,0,0,,Бұл спортшылардың тыныс алуы үшін тым кішкентай.
Dialogue: 0,0:06:57.75,0:07:01.12,Default,,0,0,0,,Бірақ бұл жай ғана ұйықтау болса, жақсы.
Dialogue: 0,0:07:01.46,0:07:04.00,Default,,0,0,0,,Мен лифтті пайдалана алмаймын.
Dialogue: 0,0:07:04.21,0:07:06.42,Default,,0,0,0,,​​Кешіріңіз, өтінемін.
Dialogue: 0,0:07:08.17,0:07:09.34,Default,,0,0,0,,«Менің үшін», – дейсің бе?
Dialogue: 0,0:07:09.47,0:07:12.39,Default,,0,0,0,,Исаның жұмысшыларының бірі қылышын суырып алды...
Dialogue: 0,0:07:12.97,0:07:17.85,Default,,0,0,0,,Ол бас діни қызметкердің қызметшісіне шабуыл жасап, оның құлағын кесіп тастады.
Dialogue: 0,0:07:17.97,0:07:20.81,Default,,0,0,0,,Сонда Иса оған былай деді:
Dialogue: 0,0:07:21.19,0:07:23.27,Default,,0,0,0,,«Қылышыңды қынап ал»
Dialogue: 0,0:07:23.40,0:07:27.40,Default,,0,0,0,,«Қылыш суырғанның бәрі семсерден өледі».
Dialogue: 0,0:07:27.98,0:07:30.99,Default,,0,0,0,,Бұл ұрыспауымыз керек дегенді білдіре ме?
Dialogue: 0,0:07:31.57,0:07:32.61,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:32.74,0:07:35.95,Default,,0,0,0,,Бір-бірімізбен қылыш қақтырсақ, әрқашан құрбандық болады.
Dialogue: 0,0:07:36.41,0:07:38.83,Default,,0,0,0,,Жоқ, әлемге…
Dialogue: 0,0:07:36.83,0:07:38.83,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:07:38.95,0:07:40.46,Default,,0,0,0,,Бұл махаббат, махаббат (Таро) Уау.
Dialogue: 0,0:07:41.00,0:07:43.00,Default,,0,0,0,,Ол күшті ме?
Dialogue: 0,0:07:43.12,0:07:43.88,Default,,0,0,0,,Күшті, күшті, өйткені сен әлемдегі ең күштісің
Dialogue: 0,0:07:43.88,0:07:46.67,Default,,0,0,0,,Күшті Күшті Өйткені сен әлемдегі ең күштісің Уф...
Dialogue: 0,0:07:46.79,0:07:48.21,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:47.13,0:07:48.21,Default,,0,0,0,,Жоқ! Тоқта, хмм...
Dialogue: 0,0:07:48.21,0:07:48.71,Default,,0,0,0,,О, жоқ! Тоқта, хмм...
Dialogue: 0,0:07:48.34,0:07:50.47,Default,,0,0,0,,Жоқ! Тоқта, хмм... Ура хехехе
Dialogue: 0,0:07:51.13,0:07:54.47,Default,,0,0,0,,Үлкен махаббат Тароды орап алады~
Dialogue: 0,0:07:54.64,0:07:58.22,Default,,0,0,0,,Фуфуфуфу... (Таро) Ядацуба! Қазірдің өзінде...
Dialogue: 0,0:07:58.35,0:07:59.47,Default,,0,0,0,,(Түркияның айқайы)
Dialogue: 0,0:08:01.56,0:08:03.77,Default,,0,0,0,,Адамдардың саны азайды.
Dialogue: 0,0:08:04.23,0:08:06.36,Default,,0,0,0,,Бұл тек клуб қызметі туралы емес.
Dialogue: 0,0:08:07.23,0:08:09.86,Default,,0,0,0,,Мико тіпті мектепке де келмейді.
Dialogue: 0,0:08:10.57,0:08:12.74,Default,,0,0,0,,Жақсы, ол жылдамырақ болғаннан кейін өзін жайсыз сезінді.
Dialogue: 0,0:08:12.74,0:08:14.61,Default,,0,0,0,,Жарайды, ол соншалықты жылдам болғаннан бері өзін нашар сезінеді. Бұл! Хехе... жақсы!
Dialogue: 0,0:08:14.61,0:08:17.37,Default,,0,0,0,,Бұл! Хехе... жақсы!
Dialogue: 0,0:08:15.03,0:08:17.37,Default,,0,0,0,,Мики итті де жеңе алмайды ма?
Dialogue: 0,0:08:17.87,0:08:20.41,Default,,0,0,0,,Мен жүгірудің қажеті жоқ сияқты сезіне бастадым. (Микидің итпен ойнаған дауысы)
Dialogue: 0,0:08:20.41,0:08:23.37,Default,,0,0,0,,(Микидің итпен ойнаған дауысы)
Dialogue: 0,0:08:20.54,0:08:23.37,Default,,0,0,0,,Адамдар бірінші кезекте жүгіру үшін жаратылған емес.
Dialogue: 0,0:08:23.66,0:08:26.33,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:08:24.87,0:08:26.33,Default,,0,0,0,,Сонда шайтан ше? (2-трек тобының мүшесі) Ол ұшпайды ма?
Dialogue: 0,0:08:26.46,0:08:27.96,Default,,0,0,0,,Аздап ұялшақ мектеп кеңесінің төрағасы мен екі жақын дос.
Dialogue: 0,0:08:28.09,0:08:29.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:30.34,0:08:32.80,Default,,0,0,0,,Кункун... (Мики) Эхехе
Dialogue: 0,0:08:32.92,0:08:35.34,Default,,0,0,0,,«Адамдарды жек көру оңай»
Dialogue: 0,0:08:35.47,0:08:39.14,Default,,0,0,0,,«Бірақ оны түсіну өте қиын».
Dialogue: 0,0:08:39.47,0:08:44.23,Default,,0,0,0,,«Тіпті көп жылдар бойы бірге болған отбасылар кейде жаңа қырларын көрсетеді».
Dialogue: 0,0:08:44.77,0:08:47.19,Default,,0,0,0,,``Мен бұл туралы қанша ойласам да, менің өмірімде ешкім...''
Dialogue: 0,0:08:47.31,0:08:49.40,Default,,0,0,0,,``Түсінбеуім мүмкін деп ойласам...''
Dialogue: 0,0:08:49.52,0:08:51.28,Default,,0,0,0,,«Өте жалғызбын».
Dialogue: 0,0:08:51.40,0:08:53.65,Default,,0,0,0,,«Бірақ мен түсінгім келеді».
Dialogue: 0,0:08:53.78,0:08:56.41,Default,,0,0,0,,«Түсінуге деген ұмтылыс»
Dialogue: 0,0:08:56.53,0:08:58.53,Default,,0,0,0,,«Сенуге батыл бол ...»
Dialogue: 0,0:09:11.59,0:09:15.68,Default,,0,0,0,,Күрсін... Күрсін... Күрсін...
Dialogue: 0,0:09:15.80,0:09:19.35,Default,,0,0,0,,Әпке, сіз сексуалды тыныс аласыз.
Dialogue: 0,0:09:19.89,0:09:23.22,Default,,0,0,0,,Келесі жолы менімен бірге тер төгейік
Dialogue: 0,0:09:24.68,0:09:27.65,Default,,0,0,0,,Хаа ха ха
Dialogue: 0,0:09:27.77,0:09:32.86,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:09:32.98,0:09:36.57,Default,,0,0,0,,Ой, жарайды... жарайды...!
Dialogue: 0,0:09:38.86,0:09:43.87,Default,,0,0,0,,♪~
Dialogue: 0,0:10:05.64,0:10:09.02,Default,,0,0,0,,Зенитсу! Иносуке!
Dialogue: 0,0:10:17.53,0:10:19.32,Default,,0,0,0,,Жетеді.
Dialogue: 0,0:10:19.45,0:10:22.78,Default,,0,0,0,,Мен әжемнің мақтаншақ пейзажынан біраз шаршадым.
Dialogue: 0,0:10:34.34,0:10:35.80,Default,,0,0,0,,Эй, күт! (Мики) Хмм...
Dialogue: 0,0:10:36.21,0:10:39.80,Default,,0,0,0,,Әйелдің жалғыз шығуы біртүрлі.
Dialogue: 0,0:10:40.26,0:10:43.26,Default,,0,0,0,,​​Ерлердің жай ғана серуендеп, қыдырып жүруі қалыпты жағдай ма?
Dialogue: 0,0:10:43.39,0:10:47.52,Default,,0,0,0,,Иә? Бұл көздер шетелдіктер ме?
Dialogue: 0,0:10:47.73,0:10:49.81,Default,,0,0,0,,Бұл Мики Макимура.
Dialogue: 0,0:10:50.23,0:10:53.15,Default,,0,0,0,,Жеңіл атлетика әлемінің сиқыршысы жартылай жапондық.
Dialogue: 0,0:10:53.27,0:10:54.90,Default,,0,0,0,,Эй... (Ақ жейделі топ 1) Бір секундқа осында келіңіз.
Dialogue: 0,0:10:55.02,0:10:56.28,Default,,0,0,0,,Мен зерттеймін.
Dialogue: 0,0:10:56.40,0:10:58.32,Default,,0,0,0,,Хмм... жібер!
Dialogue: 0,0:10:58.44,0:10:59.32,Default,,0,0,0,,Жібер!
Dialogue: 0,0:10:59.70,0:11:01.95,Default,,0,0,0,,Шетелдік! Шетелдік!
Dialogue: 0,0:11:02.37,0:11:03.70,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:03.82,0:11:07.24,Default,,0,0,0,,Бұл не? Еркек болсаң да жылайсың!
Dialogue: 0,0:11:07.37,0:11:08.33,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:11:08.45,0:11:09.41,Default,,0,0,0,,Неге, ақымақ
Dialogue: 0,0:11:09.87,0:11:12.29,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:11:12.46,0:11:14.42,Default,,0,0,0,,Мики-чан Қауіпті уақыт-
Dialogue: 0,0:11:15.29,0:11:17.17,Default,,0,0,0,,Өйткені мен осындамын
Dialogue: 0,0:11:20.93,0:11:22.80,Default,,0,0,0,,Көп адамдардан жылдамырақ...
Dialogue: 0,0:11:22.93,0:11:24.60,Default,,0,0,0,,Ол шайтан болғандықтан емес пе?
Dialogue: 0,0:11:24.72,0:11:27.10,Default,,0,0,0,,Жапонияны мазақ етіңіз!
Dialogue: 0,0:11:27.31,0:11:29.52,Default,,0,0,0,,Бұл қауіпті, Акира-кун!
Dialogue: 0,0:11:30.64,0:11:31.77,Default,,0,0,0,,Мин…
Dialogue: 0,0:11:32.40,0:11:33.69,Default,,0,0,0,,Қыздың жеткізуге тиіс жері қай жерде—
Dialogue: 0,0:11:33.98,0:11:35.52,Default,,0,0,0,,Бұл жігіт... Уа!
Dialogue: 0,0:11:35.65,0:11:38.82,Default,,0,0,0,,Мен сенің жағыңды аламын... Гуфу...
Dialogue: 0,0:11:39.36,0:11:42.45,Default,,0,0,0,,Әлсізді қорлама, шайтанды бас!
Dialogue: 0,0:11:42.57,0:11:45.95,Default,,0,0,0,,(қоңырау ысқырығы)
Dialogue: 0,0:11:46.24,0:11:48.29,Default,,0,0,0,,О, көп келді.
Dialogue: 0,0:11:48.41,0:11:49.91,Default,,0,0,0,,Қаш!
Dialogue: 0,0:11:50.33,0:11:52.25,Default,,0,0,0,,Әй, сәл күте тұрыңыз!
Dialogue: 0,0:11:58.55,0:12:01.38,Default,,0,0,0,,Сиқыршы күткендей, ол жылдам.
Dialogue: 0,0:12:01.51,0:12:03.76,Default,,0,0,0,,Бұл соншалықты күшті, солай емес пе?
Dialogue: 0,0:12:03.88,0:12:08.56,Default,,0,0,0,,Әлсіз болсам жеңілемін, маған өзіңді бер, мен сені қорғай алмаймын.
Dialogue: 0,0:12:09.06,0:12:12.85,Default,,0,0,0,,Әйел жалғыз жүрген су перісіне не болды?
Dialogue: 0,0:12:12.98,0:12:14.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:14.23,0:12:15.81,Default,,0,0,0,,Акира Фудо!
Dialogue: 0,0:12:15.94,0:12:17.82,Default,,0,0,0,,Есіміңізді есте сақтаңыз.
Dialogue: 0,0:12:20.82,0:12:22.45,Default,,0,0,0,,Шық! Бұл шайтан!
Dialogue: 0,0:12:22.57,0:12:24.57,Default,,0,0,0,,Айналадағы жолдарды жабыңыз!
Dialogue: 0,0:12:24.91,0:12:27.03,Default,,0,0,0,,Қарсыламаңыз! Ату, ату!
Dialogue: 0,0:12:27.16,0:12:29.08,Default,,0,0,0,,Түсіңіз! Жалын осында!
Dialogue: 0,0:12:29.58,0:12:31.08,Default,,0,0,0,,Эй, Изуна.
Dialogue: 0,0:12:31.16,0:12:33.33,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,0:12:34.21,0:12:40.38,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:12:40.50,0:12:42.17,Default,,0,0,0,,(Амон) Нагачика? (Хайд) Ах, Амон-сан.
Dialogue: 0,0:12:43.55,0:12:45.18,Default,,0,0,0,,Ууууу...
Dialogue: 0,0:12:45.72,0:12:47.55,Default,,0,0,0,,Сіз шайтан емессіз, солай ма?
Dialogue: 0,0:12:47.68,0:12:48.68,Default,,0,0,0,,Ібіліс, солай ма?
Dialogue: 0,0:12:49.14,0:12:51.18,Default,,0,0,0,,Жарайды, менімен бірге жүр.
Dialogue: 0,0:12:51.68,0:12:54.69,Default,,0,0,0,,Мен де адам жүрегі бар шайтанмын.
Dialogue: 0,0:12:55.02,0:12:56.69,Default,,0,0,0,,Келіңіздер! Мен сенің жаныңдамын!
Dialogue: 0,0:12:58.36,0:12:59.19,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:12:59.27,0:13:01.36,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:00.40,0:13:01.78,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:13:05.28,0:13:06.78,Default,,0,0,0,,Ууууууууууу
Dialogue: 0,0:13:06.91,0:13:08.24,Default,,0,0,0,,Тағы біреуі расталды!
Dialogue: 0,0:13:08.37,0:13:10.28,Default,,0,0,0,,Оң жақ жоғарғы түсіру!
Dialogue: 0,0:13:12.62,0:13:15.25,Default,,0,0,0,,Неге еріксіз өлтіресің?
Dialogue: 0,0:13:15.37,0:13:16.96,Default,,0,0,0,,Неге! ?
Dialogue: 0,0:13:29.26,0:13:31.01,Default,,0,0,0,,Күте тұрыңыз... бұл кім?
Dialogue: 0,0:13:31.14,0:13:32.72,Default,,0,0,0,,Мен сенің сонда екеніңді білемін.
Dialogue: 0,0:13:35.94,0:13:37.73,Default,,0,0,0,,Сіз... тірісіз бе?
Dialogue: 0,0:13:38.31,0:13:40.65,Default,,0,0,0,,Сіз 4-ші ұрпақсыз...
Dialogue: 0,0:13:40.98,0:13:43.73,Default,,0,0,0,,Енді сіз оны көрдіңіз!
Dialogue: 0,0:13:50.78,0:13:52.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:53.29,0:13:56.04,Default,,0,0,0,,Жоқ, мен саған кеше айтқан жоқпын ба? Лукако – нағыз жігіт.
Dialogue: 0,0:13:56.41,0:13:57.50,Default,,0,0,0,,Бір-бірін…
Dialogue: 0,0:13:58.42,0:14:00.00,Default,,0,0,0,,Бұл шайтан ма?
Dialogue: 0,0:14:00.83,0:14:03.71,Default,,0,0,0,,Жағдайлар біздің пайдамызға.
Dialogue: 0,0:14:03.84,0:14:05.51,Default,,0,0,0,,АҚШ әскері ше?
Dialogue: 0,0:14:05.63,0:14:07.93,Default,,0,0,0,,Қазірдің өзінде біздің бақылауымызда
Dialogue: 0,0:14:08.05,0:14:11.26,Default,,0,0,0,,Адамдарды жоюға қару жеткілікті.
Dialogue: 0,0:14:11.51,0:14:13.76,Default,,0,0,0,,Оны барлық азаматтар көтере алатындай.
Dialogue: 0,0:14:13.89,0:14:16.27,Default,,0,0,0,,Қаруды жаппай шығаруға болады ма?
Dialogue: 0,0:14:16.73,0:14:18.73,Default,,0,0,0,,Заңнама уақытылы емес
Dialogue: 0,0:14:18.85,0:14:19.69,Default,,0,0,0,,Ей, жақсы шықты, жақсы шықты. Қорқып қалдың ба?
Dialogue: 0,0:14:19.81,0:14:22.90,Default,,0,0,0,,Бейбіт тұрғындар бейбіт тұрғындарды өлтіретін оқиғалар көбірек...
Dialogue: 0,0:14:23.02,0:14:24.28,Default,,0,0,0,,Тым көп
Dialogue: 0,0:14:24.65,0:14:25.99,Default,,0,0,0,,Үкімет мұқият
Dialogue: 0,0:14:26.11,0:14:28.11,Default,,0,0,0,,Тамырын жұлып алмасаң жақсы емес.
Dialogue: 0,0:14:28.24,0:14:32.32,Default,,0,0,0,,Әскерге шақырылсақ ше? Енді ешкім шағымданбайды.
Dialogue: 0,0:14:32.45,0:14:35.12,Default,,0,0,0,,Көрші елдердің қозғалысына да абай болу керек.
Dialogue: 0,0:14:35.24,0:14:38.91,Default,,0,0,0,,Көрші ел шайтанның қолына түсіп үлгерді деген де ақпарат бар.
Dialogue: 0,0:14:39.04,0:14:42.96,Default,,0,0,0,,Қандай ақпарат? Себебін айтыңызшы
Dialogue: 0,0:14:43.17,0:14:47.59,Default,,0,0,0,,Жүк адамның иммиграциялық инспекциясынан да қауіпті емес пе?
Dialogue: 0,0:14:47.72,0:14:50.30,Default,,0,0,0,,Бұл шайтанның шайы
Dialogue: 0,0:14:51.51,0:14:54.26,Default,,0,0,0,,Кіріңіз, мен сізге шай дайындаймын.
Dialogue: 0,0:14:54.39,0:14:57.06,Default,,0,0,0,,Ей, бұл тамаша үй. (Мики) Рахмет.
Dialogue: 0,0:14:57.18,0:14:59.31,Default,,0,0,0,,Мики! мынаны қараңыз
Dialogue: 0,0:14:59.64,0:15:01.15,Default,,0,0,0,,Э? Тұр... не?
Dialogue: 0,0:15:15.37,0:15:17.79,Default,,0,0,0,,Жоқ, мен саған кеше айтқан жоқпын ба? Лукако – нағыз жігіт.
Dialogue: 0,0:15:17.91,0:15:19.71,Default,,0,0,0,,Не болды? (Таро) А...
Dialogue: 0,0:15:19.83,0:15:22.96,Default,,0,0,0,,Уайымдама, шайтан келсе де анаң осында болады.
Dialogue: 0,0:15:23.08,0:15:24.34,Default,,0,0,0,,Макимура-сан!
Dialogue: 0,0:15:25.09,0:15:27.84,Default,,0,0,0,,Сіз естідіңіз бе? Отани-сан мен мына Саори-чан...
Dialogue: 0,0:15:28.42,0:15:29.88,Default,,0,0,0,,Бұл шайтан болды.
Dialogue: 0,0:15:30.01,0:15:31.93,Default,,0,0,0,,Иә? Саори-чан?
Dialogue: 0,0:15:32.05,0:15:35.10,Default,,0,0,0,,Отани мырзаны да полиция алып кетті.
Dialogue: 0,0:15:35.51,0:15:39.10,Default,,0,0,0,,Менің әке-шешем де жын ба деп ойлаймын... (Акико) Солай...
Dialogue: 0,0:15:39.73,0:15:44.48,Default,,0,0,0,,Бірақ өз қызыңның жын екенін қалай байқамадың?
Dialogue: 0,0:15:44.81,0:15:47.90,Default,,0,0,0,,Мен оны білдім. Мен оны біліп, үндемедім.
Dialogue: 0,0:15:48.03,0:15:49.36,Default,,0,0,0,,Зиянды!
Dialogue: 0,0:15:49.53,0:15:52.28,Default,,0,0,0,,Бұл менің балам да шайтанмен кездесіп жүр дегенді білдірмей ме?
Dialogue: 0,0:15:52.40,0:15:54.03,Default,,0,0,0,,Бұл қорқынышты!
Dialogue: 0,0:15:54.16,0:15:55.12,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:15:56.78,0:15:58.33,Default,,0,0,0,,Таро-чан?
Dialogue: 0,0:16:01.91,0:16:05.50,Default,,0,0,0,,Таро-чан! Жауап бер, Таро-чан!
Dialogue: 0,0:16:05.63,0:16:06.92,Default,,0,0,0,,Анам…
Dialogue: 0,0:16:07.04,0:16:11.13,Default,,0,0,0,,Егер ол кенеттен жоғалып кетсе, сіз таң қаласыз, солай емес пе?
Dialogue: 0,0:16:12.51,0:16:14.64,Default,,0,0,0,,Кешіріңіз анашым
Dialogue: 0,0:16:15.30,0:16:17.64,Default,,0,0,0,,Жарайды. Бұдан былай... Ха!
Dialogue: 0,0:16:19.18,0:16:20.56,Default,,0,0,0,,(Жүкті түсіру дыбысы)
Dialogue: 0,0:16:20.68,0:16:24.14,Default,,0,0,0,,Кешіріңіз, мен ет...
Dialogue: 0,0:16:24.85,0:16:26.81,Default,,0,0,0,,Етті шыдай алмаймын.
Dialogue: 0,0:16:26.94,0:16:28.57,Default,,0,0,0,,Ааах…
Dialogue: 0,0:16:32.65,0:16:34.66,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:38.99,0:16:40.45,Default,,0,0,0,,Менің бір оқиғам бар.
Dialogue: 0,0:16:42.58,0:16:46.21,Default,,0,0,0,,Акира Әлем өзгерді.
Dialogue: 0,0:16:46.33,0:16:48.50,Default,,0,0,0,,Сұмдық дәуірі басталды.
Dialogue: 0,0:16:48.63,0:16:52.46,Default,,0,0,0,,Бұл адамдарды билеуге мәжбүр ететін өлімнің тозақ биі.
Dialogue: 0,0:16:52.59,0:16:55.55,Default,,0,0,0,,Біз шайтанның барын уахи еттік
Dialogue: 0,0:16:55.68,0:16:59.39,Default,,0,0,0,,Бірақ сол уақытта мен Пандораның қорабын аштым.
Dialogue: 0,0:16:59.51,0:17:03.73,Default,,0,0,0,,Адамдар қорқады... Адамдар қорқады...
Dialogue: 0,0:17:03.98,0:17:07.44,Default,,0,0,0,,Түсінесің бе? адамдар әлсіз
Dialogue: 0,0:17:07.86,0:17:09.65,Default,,0,0,0,,Шайтанның бар екенін білу...
Dialogue: 0,0:17:09.77,0:17:12.99,Default,,0,0,0,,Сіздің ойыңызша, үрей тудырған адамдармен не болады?
Dialogue: 0,0:17:13.11,0:17:17.20,Default,,0,0,0,,Шайтан күшті және айлакер. Әзірше күтіп, бақылап жүрмін.
Dialogue: 0,0:17:17.45,0:17:21.20,Default,,0,0,0,,Мен бір-бірін күдіктеніп, өлтіретін адамдарды байсалды түрде бақылаймын.
Dialogue: 0,0:17:21.79,0:17:24.96,Default,,0,0,0,,Адамдарда қорқыныш пен күресуге батылдық жетеді!
Dialogue: 0,0:17:25.08,0:17:27.71,Default,,0,0,0,,Оның ақыл-парасаты бар! Үлкен әскери күш те!
Dialogue: 0,0:17:28.04,0:17:30.29,Default,,0,0,0,,Сіз шайтанмен күресе білуіңіз керек!
Dialogue: 0,0:17:30.75,0:17:34.05,Default,,0,0,0,,Хехехе... Солай деп үміттенемін...
Dialogue: 0,0:17:34.63,0:17:40.14,Default,,0,0,0,,Жүздеген жындарды өлтіру үшін ондаған миллион адам құрбан болды.
Dialogue: 0,0:17:40.26,0:17:45.10,Default,,0,0,0,,Адамдарды қорғауға арналған қару адамдарды жоюда рөл атқарады.
Dialogue: 0,0:17:45.98,0:17:50.98,Default,,0,0,0,,Күдікке толы адамдар адам сенгісіз істерге кіріседі!
Dialogue: 0,0:17:51.36,0:17:54.44,Default,,0,0,0,,Сіз енді өз бетіңізше ештеңе істей алмайсыз.
Dialogue: 0,0:17:54.57,0:17:56.49,Default,,0,0,0,,Біз мұнда тыныш болуымыз керек.
Dialogue: 0,0:17:57.20,0:18:00.07,Default,,0,0,0,,Ібілістің жаулары тек жындар болса жақсы болар еді.
Dialogue: 0,0:18:00.20,0:18:01.12,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:18:01.24,0:18:05.04,Default,,0,0,0,,Адамның көзқарасы бойынша Ібіліс те жын!
Dialogue: 0,0:18:05.16,0:18:06.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:06.12,0:18:07.79,Default,,0,0,0,,Бұл ең үлкен шоу!
Dialogue: 0,0:18:08.21,0:18:09.50,Default,,0,0,0,,Соғыс басталғалы тұр!
Dialogue: 0,0:18:10.04,0:18:15.01,Default,,0,0,0,,Бұл адамзат бұрын соңды болмаған бөтен жаратылыстармен соғыс!
Dialogue: 0,0:18:15.30,0:18:17.38,Default,,0,0,0,,Жалғыз соғысқанда не істей аласың?
Dialogue: 0,0:18:17.51,0:18:21.51,Default,,0,0,0,,Тәкаппар болмаңыз! Енді мен тығылып, қарап отырамын!
Dialogue: 0,0:18:21.76,0:18:24.01,Default,,0,0,0,,Адамзаттың болашағы!
Dialogue: 0,0:18:24.35,0:18:28.77,Default,,0,0,0,,Бір немесе екеуін жеңсеңіз де, бұл үлкен суретке әсер етпейді.
Dialogue: 0,0:18:28.89,0:18:33.19,Default,,0,0,0,,Адамдар өзін-өзі құртады... Әрқайсысы өледі.
Dialogue: 0,0:18:33.52,0:18:35.65,Default,,0,0,0,,Адамдар өзін-өзі жоймайды!
Dialogue: 0,0:18:36.03,0:18:37.65,Default,,0,0,0,,Ібіліс жалғыз емес
Dialogue: 0,0:18:37.78,0:18:42.03,Default,,0,0,0,,Ібілісті жеңген жүрегі бар басқа адамдар бар!
Dialogue: 0,0:18:44.28,0:18:48.46,Default,,0,0,0,,Бөлінсек жақсы емес, мен Ібілісті жинаймын!
Dialogue: 0,0:18:48.66,0:18:50.62,Default,,0,0,0,,Жиналып, жындармен күрес!
Dialogue: 0,0:18:50.75,0:18:51.88,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:18:52.00,0:18:53.09,Default,,0,0,0,,Мен осындай нәрсеге құмармын...
Dialogue: 0,0:18:53.46,0:18:55.21,Default,,0,0,0,,Мен сені Ібіліс жасаған жоқпын!
Dialogue: 0,0:18:55.34,0:18:56.17,Default,,0,0,0,,Ха...
Dialogue: 0,0:18:56.55,0:18:58.17,Default,,0,0,0,,Осымен.
Dialogue: 0,0:18:58.30,0:18:59.68,Default,,0,0,0,,Бір минут күте тұрыңыз, Акира!
Dialogue: 0,0:19:00.01,0:19:02.18,Default,,0,0,0,,Жолдан кет! Аяқталды!
Dialogue: 0,0:19:08.27,0:19:10.31,Default,,0,0,0,,Бұл кері әсер етті
Dialogue: 0,0:19:10.44,0:19:14.31,Default,,0,0,0,,Акира Өтінемін, аман қалуыма рұқсат етіңіз.
Dialogue: 0,0:19:17.61,0:19:19.15,Default,,0,0,0,,Апокалипсис…
Dialogue: 0,0:19:19.28,0:19:23.70,Default,,0,0,0,,«Шайтан, Құдаймен шайқаста денесінен айырылған жын құдай»
Dialogue: 0,0:19:24.16,0:19:26.99,Default,,0,0,0,,«Мәңгіліктен кейін жоқтан қайта тірілді»
Dialogue: 0,0:19:27.12,0:19:30.75,Default,,0,0,0,,«Жындар әскерін басқарып, аспаннан бүлік шығар».
Dialogue: 0,0:19:31.12,0:19:33.83,Default,,0,0,0,,«Құдайдың әскері мұны тағы да атқылайды»
Dialogue: 0,0:19:33.96,0:19:37.63,Default,,0,0,0,,Құдайдың әскері... Шайтан?
Dialogue: 0,0:19:39.17,0:19:40.22,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:19:42.26,0:19:43.97,Default,,0,0,0,,Акира-кун! бұл!
Dialogue: 0,0:19:45.51,0:19:48.60,Default,,0,0,0,,〝Ноэль, көп рахмет〞
Dialogue: 0,0:19:48.72,0:19:51.98,Default,,0,0,0,,``Мен сенімен бірге тұрғаныма өте қуаныштымын.''
Dialogue: 0,0:19:52.35,0:19:54.31,Default,,0,0,0,,«Мен Тароны өзіммен бірге алып кетемін».
Dialogue: 0,0:19:54.44,0:19:55.98,Default,,0,0,0,,«Мен сені сүйемін»
Dialogue: 0,0:19:56.15,0:19:59.03,Default,,0,0,0,,«Мики, Таро және Акира-кун...»
Dialogue: 0,0:19:59.23,0:20:01.49,Default,,0,0,0,,«Бізде бақытты отбасы болғанына қуаныштымын».
Dialogue: 0,0:20:02.61,0:20:05.45,Default,,0,0,0,,«Мен сенімен бірге болуға уәдемді орындай алмағаным үшін өкінемін».
Dialogue: 0,0:20:06.66,0:20:09.20,Default,,0,0,0,,​​«Микиге қамқорлық жасаңыз.»
Dialogue: 0,0:20:13.79,0:20:15.58,Default,,0,0,0,,Нағашың кетіп қалды ма?
Dialogue: 0,0:20:15.71,0:20:17.25,Default,,0,0,0,,Таро да менімен бірге.
Dialogue: 0,0:20:17.54,0:20:19.55,Default,,0,0,0,,Мен сені іздеймін (Мики) Мен де!
Dialogue: 0,0:20:19.67,0:20:20.59,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:20.71,0:20:25.39,Default,,0,0,0,,Анам кенет қайтып келсе, маған сәлем беретін адам керек.
Dialogue: 0,0:20:26.09,0:20:28.26,Default,,0,0,0,,Акира-кун Микиді сұрайды
Dialogue: 0,0:20:28.39,0:20:30.27,Default,,0,0,0,,Иә, оны маған қалдырыңыз.
Dialogue: 0,0:20:30.93,0:20:34.02,Default,,0,0,0,,Бұл Акира-кун өзгерді...
Dialogue: 0,0:20:34.14,0:20:35.48,Default,,0,0,0,,Ағай
Dialogue: 0,0:20:36.40,0:20:37.27,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:20:38.11,0:20:41.36,Default,,0,0,0,,Жарайды, Құдай сені қорғайды.
Dialogue: 0,0:20:51.45,0:20:52.79,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:20:53.29,0:20:54.54,Default,,0,0,0,,Бұл төтенше жағдай туралы ескерту.
Dialogue: 0,0:20:54.67,0:20:59.46,Default,,0,0,0,,Жақында АҚШ президенті төтенше жағдай жариялады.
Dialogue: 0,0:20:59.59,0:21:02.55,Default,,0,0,0,,АҚШ қорғаныс министрлігі бұл жын туралы...
Dialogue: 0,0:21:02.67,0:21:06.84,Default,,0,0,0,,Шекара ресейлік биологиялық қаруға деген күдіктің күшеюіне байланысты жабылды
Dialogue: 0,0:21:06.97,0:21:09.26,Default,,0,0,0,,7-ші флот жолға шықты...
Dialogue: 0,0:21:09.39,0:21:12.64,Default,,0,0,0,,Бүкіл НАТО күштерін орналастыру кейіннен болатын сияқты.
Dialogue: 0,0:21:16.90,0:21:18.56,Default,,0,0,0,,Шайқас бола ма?
Dialogue: 0,0:21:18.69,0:21:20.23,Default,,0,0,0,,Егер біз бір-бірімізге ядролық қару атсақ...
Dialogue: 0,0:21:20.36,0:21:23.24,Default,,0,0,0,,Шайтан ғана емес, біз де жойыламыз.
Dialogue: 0,0:21:23.74,0:21:26.03,Default,,0,0,0,,Басқа адамның да мұны білетініне сенімдімін.
Dialogue: 0,0:21:26.15,0:21:27.86,Default,,0,0,0,,(Бірдеңе тесетін дыбыс)
Dialogue: 0,0:21:29.41,0:21:32.58,Default,,0,0,0,,Дұрыс, сондықтан...
Dialogue: 0,0:21:33.58,0:21:36.25,Default,,0,0,0,,Мен оны осы жерден бастаймын.
Dialogue: 0,0:21:36.50,0:21:38.83,Default,,0,0,0,,Ах... Ку...
Dialogue: 0,0:21:40.84,0:21:45.26,Default,,0,0,0,,Тактикалық ядролық қаруды қолданыңыз! Бұл кештің басы!
Dialogue: 0,0:21:45.59,0:21:46.76,Default,,0,0,0,,Иә
Dialogue: 0,0:21:50.80,0:21:53.02,Default,,0,0,0,,(Зымыран ұшыру дыбысы)
Dialogue: 0,0:22:01.11,0:22:02.19,Default,,0,0,0,,Не?
Dialogue: 0,0:22:02.82,0:22:04.28,Default,,0,0,0,,Бұл не шам? ?
Dialogue: 0,0:22:13.99,0:22:17.83,Default,,0,0,0,,«Содом халқы Луттың үйін қоршап алып:
Dialogue: 0,0:22:18.50,0:22:21.13,Default,,0,0,0,,«Бүгін түнде саған келгендер...»
Dialogue: 0,0:22:21.25,0:22:23.21,Default,,0,0,0,,«Оны осы жерден алыңыз.»
Dialogue: 0,0:22:23.38,0:22:27.84,Default,,0,0,0,,«Олар Лутқа қатты басып, есікті бұзбақ болды».
Dialogue: 0,0:22:28.18,0:22:33.85,Default,,0,0,0,,«Жаратқан Ие олардың істерін көріп, бұл қаланы жоюға шешім қабылдады».
Dialogue: 0,0:22:34.31,0:22:36.85,Default,,0,0,0,,«Осы кезде Луттың әйелі-»
Dialogue: 0,0:22:35.27,0:22:38.56,Default,,0,0,0,,Уау~
Dialogue: 0,0:22:36.98,0:22:39.44,Default,,0,0,0,,«Алла елшісіне берген уәдемді орындамағаным үшін...»
Dialogue: 0,0:22:39.56,0:22:41.35,Default,,0,0,0,,«Тұз бағанасына айналды»
Dialogue: 0,0:22:42.48,0:22:46.78,Default,,0,0,0,,«Жаратқан Ие Иеміздің орнына күкірт пен от әкеледі...»
Dialogue: 0,0:22:46.90,0:22:50.28,Default,,0,0,0,,«Содом мен Ғомораға көктен жаңбыр жаусын».
Dialogue: 0,0:22:50.41,0:22:54.62,Default,,0,0,0,,«Қалалардың барлық тұрғындары мен жердегі барлық өсімдіктер —
Dialogue: 0,0:22:54.74,0:22:56.87,Default,,0,0,0,,«Барлығы жойылды»
Dialogue: 0,0:22:58.04,0:22:59.25,Default,,0,0,0,,Қарап көріңіз
Dialogue: 0,0:22:59.37,0:23:02.67,Default,,0,0,0,,Бұл спутниктік орбитадан алынған сурет.
Dialogue: 0,0:23:02.96,0:23:03.79,Default,,0,0,0,,Бұл...!
Dialogue: 0,0:23:03.92,0:23:05.17,Default,,0,0,0,,Бұл шамның диаметрі -
Dialogue: 0,0:23:05.25,0:23:08.13,Default,,0,0,0,,Ұзындығы 10 000 км... деп есептеледі.
Dialogue: 0,0:23:10.26,0:23:14.64,Default,,0,0,0,,Ааах…
Dialogue: 0,0:23:14.89,0:23:20.64,Default,,0,0,0,,Гяаааааааааааааааааааааааааааааааа
Dialogue: 0,0:23:20.94,0:23:27.94,Default,,0,0,0,,Эй! Ааааааа...
Dialogue: 0,0:23:29.07,0:23:29.82,Default,,0,0,0,,♪~
Dialogue: 0,0:24:25.54,0:24:27.29,Default,,0,0,0,,~♪
Dialogue: 0,0:24:28.79,0:24:33.79,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
