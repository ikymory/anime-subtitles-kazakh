Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.50,0:00:08.80,Default,,0,0,0,,♬ (мырылдау)
Dialogue: 0,0:00:12.17,0:00:14.68,Default,,0,0,0,,♬ (мырылдау)
Dialogue: 0,0:00:16.68,0:00:20.68,Default,,0,0,0,,Орындалды. А, мен қазір барамын.
Dialogue: 0,0:00:20.68,0:00:22.85,Default,,0,0,0,,♬ (мырылдау)
Dialogue: 0,0:00:22.85,0:00:25.69,Default,,0,0,0,,Бүгін көңіл-күйіңіз өте жақсы.
Dialogue: 0,0:00:25.69,0:00:30.03,Default,,0,0,0,,Дұрыс. Бұл армандар орындалатын күн.
Dialogue: 0,0:00:30.03,0:00:33.53,Default,,0,0,0,,Сіздің демалысыңыз болса да, Сесил-чан, тынымсыз еңбегіңіз үшін рахмет.
Dialogue: 0,0:00:33.53,0:00:35.70,Default,,0,0,0,,Бірақ бұл мүмкін емес... Түсінемін.
Dialogue: 0,0:00:35.70,0:00:38.87,Default,,0,0,0,,Мен кешкі асқа ораламын.
Dialogue: 0,0:00:38.87,0:00:42.37,Default,,0,0,0,,Олай болса, кеттік. Келіңіздер.
Dialogue: 0,0:00:42.37,0:00:45.54,Default,,0,0,0,,Менің де дайындалатын кезім...
Dialogue: 0,0:00:45.54,0:00:48.04,Default,,0,0,0,,мамыр~! не болды? Белл-чан.
Dialogue: 0,0:00:48.04,0:00:50.71,Default,,0,0,0,,Хината... Хината...
Dialogue: 0,0:00:50.71,0:00:53.12,Default,,0,0,0,,Гохо гохо.
Dialogue: 0,0:01:55.04,0:01:57.88,Default,,0,0,0,,(Термометрдің электронды дыбысы)
Dialogue: 0,0:01:57.88,0:02:00.65,Default,,0,0,0,,37 градус 8 минут.
Dialogue: 0,0:02:00.65,0:02:03.99,Default,,0,0,0,,Сен өлесің бе? Не істеуім керек? Не істеуім керек?
Dialogue: 0,0:02:03.99,0:02:06.82,Default,,0,0,0,,Хината өлсе, мен де өлемін~.
Dialogue: 0,0:02:06.82,0:02:09.66,Default,,0,0,0,,Сіз асыра айтып отырсыз. Бұл жай ғана суық.
Dialogue: 0,0:02:09.66,0:02:11.66,Default,,0,0,0,,Гохогохо!
Dialogue: 0,0:02:11.66,0:02:15.33,Default,,0,0,0,,Сесиль-чан сонда болса, ол сізге сауықтыру сиқырын жасай алады➨
Dialogue: 0,0:02:15.33,0:02:17.33,Default,,0,0,0,,Мен жұмысқа бардым...
Dialogue: 0,0:02:17.33,0:02:20.67,Default,,0,0,0,,Жарайды! Мені күт. Мен сені жақында қайтарамын.
Dialogue: 0,0:02:20.67,0:02:23.17,Default,,0,0,0,,Жоқ, сіз менің жұмысыма араласып жатырсыз.
Dialogue: 0,0:02:23.17,0:02:27.01,Default,,0,0,0,,Аздап ыстығы бар, дәрі ішіп, ұйықтасаңыз, жазылып кетеді.
Dialogue: 0,0:02:27.01,0:02:30.35,Default,,0,0,0,,Ең болмаса тамақ жеу керек.
Dialogue: 0,0:02:30.35,0:02:34.35,Default,,0,0,0,,Белл-чан, Хината-чанға оңай сіңетін тағам дайындаңыз.
Dialogue: 0,0:02:34.35,0:02:38.35,Default,,0,0,0,,Қандай күріш оңай қорытылады? Ботқа оңай ма?
Dialogue: 0,0:02:38.35,0:02:42.02,Default,,0,0,0,,Мен мұндайды ешқашан жасаған емеспін! Мэй мұны саған жасайды.
Dialogue: 0,0:02:42.02,0:02:44.03,Default,,0,0,0,,Мен мұны істей алғым келеді➨
Dialogue: 0,0:02:44.03,0:02:47.03,Default,,0,0,0,,Осыдан кейін бірлескен бейне түсіріледі...
Dialogue: 0,0:02:47.03,0:02:49.03,Default,,0,0,0,,Ынтымақтастық? иә!
Dialogue: 0,0:02:49.03,0:02:52.03,Default,,0,0,0,,Маған трансляцияны бастауға не түрткі болды➨
Dialogue: 0,0:02:52.03,0:02:57.21,Default,,0,0,0,,Сіз үш сиқырлы қыз кумирімен көптен күткен бірлескен фотосессияға түсе аласыз!
Dialogue: 0,0:02:57.21,0:03:00.48,Default,,0,0,0,,Хинатамен не болғаны саған қызықты ма? Бірақ...
Dialogue: 0,0:03:00.48,0:03:03.15,Default,,0,0,0,,Қоңырау Бұл мүмкін емес десең жақсы емес.
Dialogue: 0,0:03:03.15,0:03:05.15,Default,,0,0,0,,Жарайсың, Мамыр.
Dialogue: 0,0:03:05.15,0:03:07.82,Default,,0,0,0,,Өтінемін, мен үшін алаңдамаңыз.
Dialogue: 0,0:03:07.82,0:03:10.15,Default,,0,0,0,,Кешіріңіз, Хината-чан.
Dialogue: 0,0:03:10.15,0:03:12.35,Default,,0,0,0,,Олай болса, абай бол.
Dialogue: 0,0:03:17.83,0:03:19.10,Default,,0,0,0,,Гохо... Қоңырау.
Dialogue: 0,0:03:19.10,0:03:24.67,Default,,0,0,0,,Не? Хината, не болды? Бірдеңе істегенімді қалайсыз ба?
Dialogue: 0,0:03:24.67,0:03:29.00,Default,,0,0,0,,Жоқ... Жұрт маған осылай қараса, біраз уайымдаймын.
Dialogue: 0,0:03:29.00,0:03:32.67,Default,,0,0,0,,Кешіріңіз. Бірақ мен уайымдап, қобалжып жүрмін.
Dialogue: 0,0:03:32.67,0:03:36.01,Default,,0,0,0,,Сіз шынымен жақсысыз ба? Сіз кеудені сорғыңыз келе ме?
Dialogue: 0,0:03:36.01,0:03:39.51,Default,,0,0,0,,Мен темекі шекпеймін. Гохо гохо!
Dialogue: 0,0:03:39.51,0:03:41.85,Default,,0,0,0,,Хината! ? кешіріңіз.
Dialogue: 0,0:03:41.85,0:03:45.35,Default,,0,0,0,,Не істерімді білмей, абдырап қалдым...
Dialogue: 0,0:03:45.35,0:03:48.36,Default,,0,0,0,,Уайымдама, бәрі жақсы.
Dialogue: 0,0:03:50.69,0:03:53.20,Default,,0,0,0,,《Әзірше, Хината-чан➨
Dialogue: 0,0:03:53.20,0:03:56.03,Default,,0,0,0,,Ас қорытуға оңай тағам пісіріңіз》
Dialogue: 0,0:03:56.03,0:03:58.03,Default,,0,0,0,,Ботқа?
Dialogue: 0,0:03:59.97,0:04:01.97,Default,,0,0,0,,Бос.
Dialogue: 0,0:04:01.97,0:04:05.31,Default,,0,0,0,,Бүгін сату күні, сондықтан мен жаппай сатып алуды ойладым.
Dialogue: 0,0:04:05.31,0:04:07.31,Default,,0,0,0,,Хината, оянғаннан кейін жақсысың ба?
Dialogue: 0,0:04:07.31,0:04:10.31,Default,,0,0,0,,Иә. Өзіңізді сәл жақсы сезінгенде ➨
Dialogue: 0,0:04:10.31,0:04:13.15,Default,,0,0,0,,Мен дүкенге барамын. Гохо гохо...
Dialogue: 0,0:04:13.15,0:04:15.32,Default,,0,0,0,,Хината ұйықтап жатыр. иә?
Dialogue: 0,0:04:15.32,0:04:18.02,Default,,0,0,0,,Мен дүкенге барамын!
Dialogue: 0,0:04:21.82,0:04:25.33,Default,,0,0,0,,《Аа~ Жұмыс өте қиын》 《Мен бүгінгі бірлескен кешті асыға күтемін~》
Dialogue: 0,0:04:25.33,0:04:28.50,Default,,0,0,0,,《Адам эмоцияларының тым көп толқыны》
Dialogue: 0,0:04:28.50,0:04:30.83,Default,,0,0,0,,Иә? Қоңырау.
Dialogue: 0,0:04:30.83,0:04:34.34,Default,,0,0,0,,Сакура. Бір адам? Сунохара-кун ше?
Dialogue: 0,0:04:34.34,0:04:37.34,Default,,0,0,0,,Мен суық тиіп құладым. иә? қиын!
Dialogue: 0,0:04:37.34,0:04:41.01,Default,,0,0,0,,Ендеше мен саған ботқа жасау үшін дүкенге келдім.
Dialogue: 0,0:04:41.01,0:04:44.35,Default,,0,0,0,,Мен жадынама алдым, оны қайдан сатып алуға болады?
Dialogue: 0,0:04:44.35,0:04:47.02,Default,,0,0,0,,Мен жалғыз ештеңе істей алмаймын...
Dialogue: 0,0:04:47.02,0:04:49.52,Default,,0,0,0,,А, Белл, бәрі жақсы.
Dialogue: 0,0:04:49.52,0:04:52.52,Default,,0,0,0,,Сіз не сатып алғыңыз келеді? Мен де саған көмектесемін.
Dialogue: 0,0:04:52.52,0:04:55.52,Default,,0,0,0,,Сакура. Біз доспыз, солай ма?
Dialogue: 0,0:04:55.52,0:04:59.36,Default,,0,0,0,,Рахмет! Бұл... ауырады! Қоңырау.
Dialogue: 0,0:04:59.36,0:05:03.97,Default,,0,0,0,,Қалай болғанда да, сіз маған сатып алу жазбаларыңызды көрсете аласыз ба?
Dialogue: 0,0:05:03.97,0:05:05.97,Default,,0,0,0,,Ауыр ма?
Dialogue: 0,0:05:05.97,0:05:09.81,Default,,0,0,0,,Мекен-жайыңды айтсаң, есігіңе апарып беремін.
Dialogue: 0,0:05:09.81,0:05:14.14,Default,,0,0,0,,Жарайды ма? Бұл соншалықты арзан.
Dialogue: 0,0:05:14.14,0:05:16.14,Default,,0,0,0,,Қош келдіңіз, қош келдіңіз.
Dialogue: 0,0:05:16.14,0:05:19.82,Default,,0,0,0,,О? Ол әрқашан Суохара-кунмен бірге болатын адам.
Dialogue: 0,0:05:19.82,0:05:22.65,Default,,0,0,0,,Бүгін менімен бірге емессің бе? Жақсы….
Dialogue: 0,0:05:22.65,0:05:26.15,Default,,0,0,0,,Сунохара-кун суықтан құлап қалған сияқты.
Dialogue: 0,0:05:26.15,0:05:28.66,Default,,0,0,0,,Бұл өте қиын. Сонда...
Dialogue: 0,0:05:28.66,0:05:31.99,Default,,0,0,0,,Мұны өзіңізбен бірге алыңыз. Әй, бірақ...
Dialogue: 0,0:05:31.99,0:05:36.10,Default,,0,0,0,,Қиындыққа тап болған кезде, біз бір-бірімізге көмектесеміз. рақмет сізге.
Dialogue: 0,0:05:38.50,0:05:40.50,Default,,0,0,0,,Сол екеу ме?
Dialogue: 0,0:05:40.50,0:05:42.50,Default,,0,0,0,,Сіз ұйықтап жатырсыз ба?
Dialogue: 0,0:05:44.51,0:05:48.01,Default,,0,0,0,,Сіздің дене қызуыңыз әлі жоғары. Мен де терлеп жатырмын.
Dialogue: 0,0:05:48.01,0:05:51.11,Default,,0,0,0,,Қоңырау, сізде жылы орамал бар ма?
Dialogue: 0,0:05:53.68,0:05:55.68,Default,,0,0,0,,《Міне... бұл қайда?
Dialogue: 0,0:05:55.68,0:05:59.96,Default,,0,0,0,,Аспан! Иә, Белл? Мочида мырза да! ?
Dialogue: 0,0:05:59.96,0:06:02.96,Default,,0,0,0,,Сунохара-кун. Қозғалма.
Dialogue: 0,0:06:02.96,0:06:06.96,Default,,0,0,0,,Біз сізді жақсы сезінетін боламыз.
Dialogue: 0,0:06:06.96,0:06:08.96,Default,,0,0,0,,Хмм… Қоңырау….
Dialogue: 0,0:06:08.96,0:06:11.47,Default,,0,0,0,,Мұнда да қараңыз.
Dialogue: 0,0:06:11.47,0:06:14.97,Default,,0,0,0,,Хехе, сен мұнда әлсізсің бе?
Dialogue: 0,0:06:14.97,0:06:16.97,Default,,0,0,0,,Барлық шие гүлдері жасырын.
Dialogue: 0,0:06:16.97,0:06:19.98,Default,,0,0,0,,Алыс кет, себебі мен тұра алмаймын.
Dialogue: 0,0:06:19.98,0:06:24.65,Default,,0,0,0,,Шынымен бе? Мынау оянып бара жатқан сияқты.
Dialogue: 0,0:06:24.65,0:06:26.82,Default,,0,0,0,,Бұл рас. таңқаларлық.
Dialogue: 0,0:06:26.82,0:06:29.65,Default,,0,0,0,,Мен мұны қазірдің өзінде қалаймын.
Dialogue: 0,0:06:29.65,0:06:31.82,Default,,0,0,0,,Бірінші мен, Хината.
Dialogue: 0,0:06:31.82,0:06:33.82,Default,,0,0,0,,Сунохара-кун.
Dialogue: 0,0:06:33.82,0:06:35.82,Default,,0,0,0,,Хината~.
Dialogue: 0,0:06:35.82,0:06:39.10,Default,,0,0,0,,Жоқ… жоқ… жоқ! 》
Dialogue: 0,0:06:39.10,0:06:42.50,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:06:42.50,0:06:46.33,Default,,0,0,0,,Кешіріңіз, мен сізді ояттым ба? Өйткені мен қатты терлеп жүрдім.
Dialogue: 0,0:06:46.33,0:06:51.01,Default,,0,0,0,,Ой... мен сені мазалап жүрмін. Тіпті Мочида мырза? Неліктен?
Dialogue: 0,0:06:51.01,0:06:54.84,Default,,0,0,0,,Хината Қозғалма. Қоңырау... Қоңырау.
Dialogue: 0,0:06:54.84,0:06:57.51,Default,,0,0,0,,Сіздің қызуыңыз аздап төмендеген сияқты.
Dialogue: 0,0:06:57.51,0:07:00.28,Default,,0,0,0,,Мен жеуге бола ма? Мм... иә.
Dialogue: 0,0:07:00.28,0:07:04.45,Default,,0,0,0,,Жақсы. Жарайды, мен оны бірден жасаймын. Кешіріңіз.
Dialogue: 0,0:07:04.45,0:07:06.45,Default,,0,0,0,,Кешірім сұраудың қажеті жоқ.
Dialogue: 0,0:07:06.45,0:07:09.62,Default,,0,0,0,,Мен шынымен бақыттымын. Хинатаға көмектес.
Dialogue: 0,0:07:09.62,0:07:13.63,Default,,0,0,0,,Мен Хинатаға көмектесу үшін бәрін жасаймын.
Dialogue: 0,0:07:20.97,0:07:23.31,Default,,0,0,0,,Ас үшін рахмет.
Dialogue: 0,0:07:23.31,0:07:25.64,Default,,0,0,0,,Сіз оны тез арада жедіңіз.
Dialogue: 0,0:07:25.64,0:07:29.31,Default,,0,0,0,,Тәбетіңіздің ашылуы сіздің көңіл-күйіңіздің жақсаруының белгісі.
Dialogue: 0,0:07:29.31,0:07:32.81,Default,,0,0,0,,Бұл бір нәрсе, бірақ... өте дәмді болды.
Dialogue: 0,0:07:32.81,0:07:37.15,Default,,0,0,0,,Сізге жақсы, Белл. Себебі Сакура маған көмектесті.
Dialogue: 0,0:07:37.15,0:07:40.66,Default,,0,0,0,,Мен мұны күнде жегім келеді.
Dialogue: 0,0:07:40.66,0:07:45.49,Default,,0,0,0,,Хината! Мен бұл пу пу пу ұсынысы болады деп ешқашан күткен емеспін! ?
Dialogue: 0,0:07:45.49,0:07:49.66,Default,,0,0,0,,Жоқ! Хината қаласа, мен оны күнде жасаймын!
Dialogue: 0,0:07:49.66,0:07:53.00,Default,,0,0,0,,Сәлем, Белл! Мочида мырза қарап тұр.
Dialogue: 0,0:07:53.00,0:07:56.50,Default,,0,0,0,,Хината~! Хината терлеу...
Dialogue: 0,0:07:56.50,0:07:59.84,Default,,0,0,0,,А, тамақ ішкеннен кейін терлей бастадым.
Dialogue: 0,0:07:59.84,0:08:04.28,Default,,0,0,0,,Мен ауыстыратын киім дайындаймын. Неге ванна қабылдамайсың?
Dialogue: 0,0:08:04.28,0:08:07.48,Default,,0,0,0,,Хмм, мен сізге рұқсат етемін деп ойлаймын.
Dialogue: 0,0:08:09.62,0:08:14.62,Default,,0,0,0,,Уф... бұл жақсы сезінеді. Ол сондай-ақ физикалық шаршауды басады.
Dialogue: 0,0:08:14.62,0:08:17.46,Default,,0,0,0,,《Сунохара-кун. Қозғалма.
Dialogue: 0,0:08:17.46,0:08:22.30,Default,,0,0,0,,Біз сізді жақсы сезінетін боламыз》
Dialogue: 0,0:08:22.30,0:08:25.30,Default,,0,0,0,,Бұрын көрген түсім керемет болды.
Dialogue: 0,0:08:25.30,0:08:28.47,Default,,0,0,0,,Белл Сәлем! Бірге кіріңіз.
Dialogue: 0,0:08:28.47,0:08:30.47,Default,,0,0,0,,№.
Dialogue: 0,0:08:30.47,0:08:33.48,Default,,0,0,0,,Дене мен сені жуамын. Апыр-ай!
Dialogue: 0,0:08:33.48,0:08:36.64,Default,,0,0,0,,Уау! (Хината) Кешіріңіз, Мочида-сан!
Dialogue: 0,0:08:36.64,0:08:40.65,Default,,0,0,0,,Мен тұрайын, екеуміз де рақаттандыратын ваннаға түсейік.
Dialogue: 0,0:08:40.65,0:08:42.65,Default,,0,0,0,,Ах, Хината.
Dialogue: 0,0:08:42.65,0:08:45.99,Default,,0,0,0,,《Мен Сунохара-кунды жалаңаш көрдім...》
Dialogue: 0,0:08:45.99,0:08:50.99,Default,,0,0,0,,Аа, мен Хинатамен шомылғым келді.
Dialogue: 0,0:08:50.99,0:08:54.50,Default,,0,0,0,,Белл Сунохара-кунды қатты жақсы көреді.
Dialogue: 0,0:08:54.50,0:08:57.17,Default,,0,0,0,,Иә, мен мұны бұрын айтқанмын, солай ма?
Dialogue: 0,0:08:57.17,0:08:59.83,Default,,0,0,0,,Өйткені Хината менің жан серігім.
Dialogue: 0,0:08:59.83,0:09:05.27,Default,,0,0,0,,Сунохара-кун - Белл сияқты біреудің өз пайдасына болғанына бақытты адам.
Dialogue: 0,0:09:05.27,0:09:08.28,Default,,0,0,0,,Солай ма? Мен солай болады деген сенімдемін.
Dialogue: 0,0:09:08.28,0:09:11.95,Default,,0,0,0,,Ойланып қарасам, Сакураны ұнататын адам жоқ па?
Dialogue: 0,0:09:11.95,0:09:14.95,Default,,0,0,0,,Иә? Мен... мен...
Dialogue: 0,0:09:14.95,0:09:16.95,Default,,0,0,0,,Егер солай көрінсе, онда ол бар.
Dialogue: 0,0:09:16.95,0:09:19.29,Default,,0,0,0,,Сіз қандай адамсыз?
Dialogue: 0,0:09:19.29,0:09:23.63,Default,,0,0,0,,Күндей мейірімді және жылы➨
Dialogue: 0,0:09:23.63,0:09:27.46,Default,,0,0,0,,Сіз біреу үшін аянбай еңбек ете алатын адамсыз ба?
Dialogue: 0,0:09:27.46,0:09:31.30,Default,,0,0,0,,Хм... Хинатаға ұқсайды.
Dialogue: 0,0:09:31.30,0:09:34.97,Default,,0,0,0,,Сен мені сүйемін деп айттың ба? Мен айта алмаймын.
Dialogue: 0,0:09:34.97,0:09:37.31,Default,,0,0,0,,Айтпасаң ештеңе болмайды, солай ма?
Dialogue: 0,0:09:37.31,0:09:40.48,Default,,0,0,0,,Ештеңе істемегенше әрекет жасаған жақсы.
Dialogue: 0,0:09:40.48,0:09:43.28,Default,,0,0,0,,Әрекет... иә?
Dialogue: 0,0:09:45.31,0:09:47.98,Default,,0,0,0,,Мен Хината-доноға суық тиеді деп күтпедім.
Dialogue: 0,0:09:47.98,0:09:53.32,Default,,0,0,0,,Белле-чан әрқашан тамақ дайындауда нашар болған, сондықтан оның қарны ашқанына сенімдімін.
Dialogue: 0,0:09:53.32,0:09:56.49,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:09:56.49,0:09:59.99,Default,,0,0,0,,Мен үйдемін. Хината-чан, қалыңыз қалай?
Dialogue: 0,0:09:59.99,0:10:02.66,Default,,0,0,0,,Қайтадан қош келдіңіз. Бұл қазірдің өзінде әлдеқайда жақсы.
Dialogue: 0,0:10:02.66,0:10:05.83,Default,,0,0,0,,Бұл бәрінен бұрын. Сен ше?
Dialogue: 0,0:10:05.83,0:10:08.00,Default,,0,0,0,,А, мен сені мазалап жүрмін.
Dialogue: 0,0:10:08.00,0:10:11.01,Default,,0,0,0,,Мен Сакура Мочидамын, Сунохара-кунның сыныптасымын.
Dialogue: 0,0:10:11.01,0:10:13.51,Default,,0,0,0,,Бұл Мэй-сан, солай ма?
Dialogue: 0,0:10:13.51,0:10:15.68,Default,,0,0,0,,Иә? Сен білесің бе?
Dialogue: 0,0:10:15.68,0:10:19.68,Default,,0,0,0,,А, бұл! Бірінші эфирден бері қараймын!
Dialogue: 0,0:10:19.68,0:10:22.68,Default,,0,0,0,,Оның Беллдің танысы екендігі басқа дүние түрі туралы әзіл емес➨
Dialogue: 0,0:10:22.68,0:10:24.69,Default,,0,0,0,,Бұл шын екенін білдіреді, солай ма?
Dialogue: 0,0:10:24.69,0:10:28.52,Default,,0,0,0,,Уау! Мен бұл басқа әлем деп ойладым, бірақ ол өте жарқын болды.
Dialogue: 0,0:10:28.52,0:10:32.03,Default,,0,0,0,,Сондай-ақ, бұл құлақтар шын ба? Мм, қарсы болмасаң, құлағымды тыңда...
Dialogue: 0,0:10:32.03,0:10:34.86,Default,,0,0,0,,Сакура, сабыр ет. Ах.
Dialogue: 0,0:10:34.86,0:10:37.03,Default,,0,0,0,,Сіз Мэйдің бейнелерінің жанкүйерісіз бе?
Dialogue: 0,0:10:37.03,0:10:40.87,Default,,0,0,0,,Ахаха Бірден бір сұрақ қойыңыз.
Dialogue: 0,0:10:40.87,0:10:43.07,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:10:45.54,0:10:47.71,Default,,0,0,0,,Уау, бұл үлпілдек.
Dialogue: 0,0:10:47.71,0:10:51.38,Default,,0,0,0,,Бұл аздап қытық. Аа, кешіріңіз.
Dialogue: 0,0:10:51.38,0:10:55.72,Default,,0,0,0,,Жақсы, бірақ сәл жұмсақ болыңыз. Иә!
Dialogue: 0,0:10:55.72,0:10:58.72,Default,,0,0,0,,《Енді қызықты болуы мүмкін》
Dialogue: 0,0:12:08.36,0:12:12.99,Default,,0,0,0,,<Бір күні кенеттен бүкіл әлемге зомби вирусы тарайды>
Dialogue: 0,0:12:12.99,0:12:16.66,Default,,0,0,0,,Соған қарамастан, Сесиль суық тиіп кетті➨
Dialogue: 0,0:12:16.66,0:12:18.67,Default,,0,0,0,,Мен жай ғана шаршадым.
Dialogue: 0,0:12:18.67,0:12:22.00,Default,,0,0,0,,Өйткені, мен Сесил-санның өлмегендерге қарсы сиқырына сүйенемін➨
Dialogue: 0,0:12:22.00,0:12:24.01,Default,,0,0,0,,Бұл ауыртпалық болады.
Dialogue: 0,0:12:24.01,0:12:26.67,Default,,0,0,0,,Дәрі осында болса екен.
Dialogue: 0,0:12:26.67,0:12:30.01,Default,,0,0,0,,Эй, Хината, бұл жақсы ма?
Dialogue: 0,0:12:30.01,0:12:34.85,Default,,0,0,0,,Иә... Дұрыс, бірақ бұл суппозиторий...
Dialogue: 0,0:12:34.85,0:12:38.35,Default,,0,0,0,,Суппозиторийлер дегеніміз не? Бөксе арқылы енгізілетін дәрі.
Dialogue: 0,0:12:38.35,0:12:40.36,Default,,0,0,0,,Ха! ? Бат! ? Иә.
Dialogue: 0,0:12:40.36,0:12:42.36,Default,,0,0,0,,Бөтен! ? Иә.
Dialogue: 0,0:12:42.36,0:12:44.69,Default,,0,0,0,,Батт! ? Неге менен үш рет сұрадың?
Dialogue: 0,0:12:44.69,0:12:49.36,Default,,0,0,0,,Өйткені дәрі бөксесі арқылы енгізіледі... Иә.
Dialogue: 0,0:12:49.36,0:12:53.37,Default,,0,0,0,,Ондай нәрсе бар! Бұл таңқаларлық тиімді болуы мүмкін.
Dialogue: 0,0:12:53.37,0:12:56.70,Default,,0,0,0,,Сіз оны Сесильдің бөксесіне саласыз ба?
Dialogue: 0,0:12:56.70,0:13:00.98,Default,,0,0,0,,Жоқ... Бұл мүмкін емес деп ойлаймын. Мен де солай ойлаймын.
Dialogue: 0,0:13:00.98,0:13:04.28,Default,,0,0,0,,Ендеше, ауызбен қабылдауға болатын дәрі іздеп көрейік. Жақсы.
Dialogue: 0,0:13:06.31,0:13:09.32,Default,,0,0,0,,Иә? бұл не? Бұл есірткі емес сияқты ...
Dialogue: 0,0:13:09.32,0:13:11.32,Default,,0,0,0,,Міне!
Dialogue: 0,0:13:11.32,0:13:15.32,Default,,0,0,0,,Не? Бол... Бұл Белл үшін қолдануға болмайтын нәрсе.
Dialogue: 0,0:13:15.32,0:13:19.33,Default,,0,0,0,,«Мен үшін» Хината оны пайдалана алады дегенді білдіре ме?
Dialogue: 0,0:13:19.33,0:13:23.00,Default,,0,0,0,,Әйтеуір... иә.
Dialogue: 0,0:13:23.00,0:13:25.33,Default,,0,0,0,,Иә. Мен оны қалай қолданамын?
Dialogue: 0,0:13:25.33,0:13:29.34,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:13:29.34,0:13:31.67,Default,,0,0,0,,Әлде жабу керек пе?
Dialogue: 0,0:13:31.67,0:13:34.34,Default,,0,0,0,,Мұқаба? Қайда? бас?
Dialogue: 0,0:13:34.34,0:13:36.68,Default,,0,0,0,,Бір мағынада бұл бас болуы мүмкін.
Dialogue: 0,0:13:36.68,0:13:39.85,Default,,0,0,0,,Бұл соншалықты үлкен нәрсе емес сияқты.
Dialogue: 0,0:13:39.85,0:13:42.02,Default,,0,0,0,,Ах, L өлшемі сияқты нәрсе де бар.
Dialogue: 0,0:13:42.02,0:13:46.52,Default,,0,0,0,,Жоқ, бұл... L сәйкес келе ме? S балаларға арналған ба?
Dialogue: 0,0:13:46.52,0:13:49.02,Default,,0,0,0,,Хината - L, солай ма? Бұл сұраққа жауап беру қиын.
Dialogue: 0,0:13:49.02,0:13:51.03,Default,,0,0,0,,Бұл қандай сан?
Dialogue: 0,0:13:51.03,0:13:53.19,Default,,0,0,0,,О, бұл жұқа... солай ма?
Dialogue: 0,0:13:53.19,0:13:57.20,Default,,0,0,0,,Жіңішкелік? Бұл сіздің басыңызға қолданатын нәрсе үшін жұқа ма?
Dialogue: 0,0:13:57.20,0:14:00.30,Default,,0,0,0,,Таз болу дәрежесін айтасыз ба? Таздық деңгейі...
Dialogue: 0,0:14:00.30,0:14:03.81,Default,,0,0,0,,Қазірдің өзінде! Бұл не? ? Мен мүлде түсінбеймін!
Dialogue: 0,0:14:03.81,0:14:07.81,Default,,0,0,0,,О, қараңдаршы...
Dialogue: 0,0:14:07.81,0:14:12.98,Default,,0,0,0,,Ааа, біз бір-бірімізді сүйген кезде, егер мен сізге тікелей кедергі жасасам➨
Dialogue: 0,0:14:12.98,0:14:16.32,Default,,0,0,0,,Сіз әртүрлі сыйлықтар ала аласыз, солай ма?
Dialogue: 0,0:14:16.32,0:14:19.99,Default,,0,0,0,,Біз бір-бірімізді сүйгенде... аламыз...
Dialogue: 0,0:14:19.99,0:14:22.66,Default,,0,0,0,,Ах! Бұл солай.
Dialogue: 0,0:14:22.66,0:14:24.99,Default,,0,0,0,,Мен көремін. Түсіндіңіз бе?
Dialogue: 0,0:14:24.99,0:14:28.33,Default,,0,0,0,,Иә. Бірақ бұл тек мен емес➨
Dialogue: 0,0:14:28.33,0:14:30.33,Default,,0,0,0,,Хинатаға да керегі жоқ. иә?
Dialogue: 0,0:14:30.33,0:14:34.00,Default,,0,0,0,,Өйткені оны қашан алғаным маңызды емес.
Dialogue: 0,0:14:34.00,0:14:36.00,Default,,0,0,0,,Иә! ? Жоқ, солай!
Dialogue: 0,0:14:36.00,0:14:40.01,Default,,0,0,0,,Хината~. Белл-санның көздері қорқынышты.
Dialogue: 0,0:14:40.01,0:14:42.34,Default,,0,0,0,,Хинатаның қызыл беті сондай сүйкімді.
Dialogue: 0,0:14:42.34,0:14:45.35,Default,,0,0,0,,Осыны түсіндіру үшін қиялыңызды қолдандыңыз ба?
Dialogue: 0,0:14:45.35,0:14:49.35,Default,,0,0,0,,Жоқ, олай емес! Иә, сіз оны елестедіңіз, солай ма?
Dialogue: 0,0:14:49.35,0:14:53.35,Default,,0,0,0,,Менімен мынаны немесе мынаны істеп жатқаныңызды елестетіңіз➨
Dialogue: 0,0:14:53.35,0:14:56.02,Default,,0,0,0,,Сіз жасадыңыз ба? Қоңырау күтіңіз!
Dialogue: 0,0:14:56.02,0:14:59.03,Default,,0,0,0,,Мен күте алмаймын! Сіз маған сондай сүйкімді жүз сыйладыңыз➨
Dialogue: 0,0:14:59.03,0:15:02.96,Default,,0,0,0,,Мен күте алмаймын. Ха ха.
Dialogue: 0,0:15:02.96,0:15:05.47,Default,,0,0,0,,Қоңырау Жоқ, жоқ!
Dialogue: 0,0:15:05.47,0:15:08.30,Default,,0,0,0,,Жарайды, ешкім қарап тұрған жоқ.
Dialogue: 0,0:15:08.30,0:15:10.47,Default,,0,0,0,,Жоқ, зомбилер қарап тұр!
Dialogue: 0,0:15:10.47,0:15:12.64,Default,,0,0,0,,Иә? Гах.
Dialogue: 0,0:15:12.64,0:15:15.64,Default,,0,0,0,,Қазірдің өзінде! Жақсы жер болды! Жақсы нүкте! ?
Dialogue: 0,0:15:15.64,0:15:20.15,Default,,0,0,0,,Хината екеуміздің тәтті уақытымызды үздіңіздер!
Dialogue: 0,0:15:20.15,0:15:24.65,Default,,0,0,0,,Ммм, қабылдаңыз!
Dialogue: 0,0:15:24.65,0:15:27.66,Default,,0,0,0,,Рахмет сізге Белл! Бұл керемет кадр болды.
Dialogue: 0,0:15:27.66,0:15:31.33,Default,,0,0,0,,Мм. О, Белл, дәрі болды. Жақсы.
Dialogue: 0,0:15:31.33,0:15:33.66,Default,,0,0,0,,Мен оны тезірек Сесил-санға қайтаруым керек.
Dialogue: 0,0:15:33.66,0:15:35.66,Default,,0,0,0,,Үйге қайтайық, Белл! Не? Енді не болады?
Dialogue: 0,0:15:35.66,0:15:39.67,Default,,0,0,0,,Енді ең алдымен Сесил-санға дәріні қайтару керек.
Dialogue: 0,0:15:39.67,0:15:41.84,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:15:41.84,0:15:45.51,Default,,0,0,0,,Иә? енді? Мен қазір иә дедім! ?
Dialogue: 0,0:15:45.51,0:15:49.31,Default,,0,0,0,,<Батыл топ бүгін де тату>
Dialogue: 0,0:15:58.05,0:16:03.62,Default,,0,0,0,,<Бұл қараңғы пері қоңыраулары жұмыс істейтін белгілі бір кеңсе>
Dialogue: 0,0:16:03.62,0:16:06.13,Default,,0,0,0,,А, Белл, қайырлы таң.
Dialogue: 0,0:16:06.13,0:16:08.96,Default,,0,0,0,,Сакура. Не болды?
Dialogue: 0,0:16:08.96,0:16:11.97,Default,,0,0,0,,Сіз көкірекшеңізді ауыстырдыңыз ба? иә?
Dialogue: 0,0:16:11.97,0:16:14.30,Default,,0,0,0,,Сіз көкірекшеңізді ауыстырдыңыз ба?
Dialogue: 0,0:16:14.30,0:16:17.47,Default,,0,0,0,,Сіз қайдан білесіз? екінші ойлар туралы.
Dialogue: 0,0:16:17.47,0:16:20.64,Default,,0,0,0,,Өйткені оның кеуде пішіні әдеттегіден сәл өзгеше.
Dialogue: 0,0:16:20.64,0:16:24.15,Default,,0,0,0,,Иә! ? Иа, сен жақсы көрінесің.
Dialogue: 0,0:16:24.15,0:16:26.15,Default,,0,0,0,,Неліктен оны өзгерттіңіз?
Dialogue: 0,0:16:26.15,0:16:30.65,Default,,0,0,0,,Бұл емшек сүтіне арналған көкірекше.
Dialogue: 0,0:16:30.65,0:16:32.65,Default,,0,0,0,,Бару... Жаңа ма?
Dialogue: 0,0:16:32.65,0:16:36.99,Default,,0,0,0,,Қарапайым тілмен айтқанда, кеудеңізді үлкейтетін көкірекше.
Dialogue: 0,0:16:36.99,0:16:39.83,Default,,0,0,0,,Сіз нені айтасыз? Көкірекше сізді үлкейте ме?
Dialogue: 0,0:16:39.83,0:16:42.16,Default,,0,0,0,,Мен мұндай сиқырды естімеппін.
Dialogue: 0,0:16:42.16,0:16:44.17,Default,,0,0,0,,Бұл сиқыр емес.
Dialogue: 0,0:16:44.17,0:16:46.50,Default,,0,0,0,,Сонда неге? Бұл қалай жұмыс істейді?
Dialogue: 0,0:16:46.50,0:16:50.51,Default,,0,0,0,,Е-е...
Dialogue: 0,0:16:50.51,0:16:53.67,Default,,0,0,0,,Қараңызшы, кеуделер семіз ➨
Dialogue: 0,0:16:53.67,0:16:57.68,Default,,0,0,0,,Оны жалғыз қалдырсаңыз, ол басқа жерге кетеді➨
Dialogue: 0,0:16:57.68,0:17:01.12,Default,,0,0,0,,Кеуделеріңіздің көлемі кішірейген... дұрыс па?
Dialogue: 0,0:17:01.12,0:17:03.12,Default,,0,0,0,,Бұл «Иә?» емес.
Dialogue: 0,0:17:03.12,0:17:05.79,Default,,0,0,0,,Сіз нені айтасыз? Қайда бара жатырсың? ?
Dialogue: 0,0:17:05.79,0:17:08.62,Default,,0,0,0,,Асқазан, арқа және т.б.
Dialogue: 0,0:17:08.62,0:17:10.79,Default,,0,0,0,,Дұрыс! ? Бұл дұрыс.
Dialogue: 0,0:17:10.79,0:17:14.30,Default,,0,0,0,,Осылайша сіздің асқазаныңыз бен арқаңызға кеткен май➨
Dialogue: 0,0:17:14.30,0:17:18.63,Default,,0,0,0,,Мен саған айтамын, бұл сенің жерің.
Dialogue: 0,0:17:18.63,0:17:21.14,Default,,0,0,0,,Сіз мені түсінуге мәжбүр етесіз, солай ма? Waka...
Dialogue: 0,0:17:21.14,0:17:24.64,Default,,0,0,0,,Сіздің орныңыз кеудеңіздің айналасындағы майға байланысты➨
Dialogue: 0,0:17:24.64,0:17:27.14,Default,,0,0,0,,Сіз мені түсінуге тырысып жатырсыз! ?
Dialogue: 0,0:17:27.14,0:17:30.14,Default,,0,0,0,,Жарайды, иә... қалай айтсаң да➨
Dialogue: 0,0:17:30.14,0:17:32.65,Default,,0,0,0,,Жұмыс істеу тәсілі бойынша, иә... дұрыс.
Dialogue: 0,0:17:32.65,0:17:35.82,Default,,0,0,0,,Мен де соны қалаймын! ''Мен оны көп естимін.
Dialogue: 0,0:17:35.82,0:17:37.82,Default,,0,0,0,,Мен не істеуім керек...》
Dialogue: 0,0:17:37.82,0:17:40.32,Default,,0,0,0,,О, бірақ Сакура. иә?
Dialogue: 0,0:17:40.32,0:17:43.66,Default,,0,0,0,,Кеудені ысқылағанда үлкейеді➨
Dialogue: 0,0:17:43.66,0:17:45.99,Default,,0,0,0,,Мен мұны естідім...
Dialogue: 0,0:17:45.99,0:17:48.83,Default,,0,0,0,,Иә? Бұл да➨
Dialogue: 0,0:17:48.83,0:17:53.50,Default,,0,0,0,,Сізге ұнайтын адамның сізге массаж жасағаны жақсы...
Dialogue: 0,0:17:53.50,0:17:55.67,Default,,0,0,0,,Ах... Ахахха.
Dialogue: 0,0:17:55.67,0:17:59.51,Default,,0,0,0,,Олай болса, бұл жақсы деп ойлаймын...
Dialogue: 0,0:17:59.51,0:18:04.61,Default,,0,0,0,,Әй, білесің бе, Белл, бәрі керісінше.
Dialogue: 0,0:18:04.61,0:18:08.28,Default,,0,0,0,,Не? Шындығында, оны ысқылау керісінше әсер етеді.
Dialogue: 0,0:18:08.28,0:18:11.12,Default,,0,0,0,,Не айтып тұрсың! ? Жоқ, бұл➨
Dialogue: 0,0:18:11.12,0:18:13.12,Default,,0,0,0,,Майды азайтқыңыз келетін жер➨
Dialogue: 0,0:18:13.12,0:18:15.79,Default,,0,0,0,,Массаж жасамайсыз ба, илейсіз бе?
Dialogue: 0,0:18:15.79,0:18:17.96,Default,,0,0,0,,Ха, мен оны журналдан оқыдым!
Dialogue: 0,0:18:17.96,0:18:22.30,Default,,0,0,0,,Сіздің кеудеңіз де семіз, сондықтан оларды уқалау оны азайтады. Міне бітті!
Dialogue: 0,0:18:22.30,0:18:25.30,Default,,0,0,0,,Сондықтан кеудені көп ысқыламаған дұрыс...
Dialogue: 0,0:18:25.30,0:18:28.64,Default,,0,0,0,,Маған ұнамайды! Мен оны қатты уқалағым келеді➨
Dialogue: 0,0:18:28.64,0:18:30.97,Default,,0,0,0,,Мен оны ысқылағаныңызды қалаймын!
Dialogue: 0,0:18:30.97,0:18:32.97,Default,,0,0,0,,Иә, иә?
Dialogue: 0,0:18:32.97,0:18:36.48,Default,,0,0,0,,А, онда сізге емізетін көкірекше көбірек керек.
Dialogue: 0,0:18:36.48,0:18:39.31,Default,,0,0,0,,Солай ма? Себебі мен сізге оны ысқылауға рұқсат бердім➨
Dialogue: 0,0:18:39.31,0:18:42.82,Default,,0,0,0,,Өлшемді сақтау үшін емізетін көкірекшемен бар күшіңізді салу керек.
Dialogue: 0,0:18:42.82,0:18:44.82,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:18:44.82,0:18:47.15,Default,,0,0,0,,Маған тезірек баруым керек.
Dialogue: 0,0:18:47.15,0:18:49.66,Default,,0,0,0,,Олай болмаса, Хината қалағанынша ысқылай алмайды...
Dialogue: 0,0:18:49.66,0:18:53.16,Default,,0,0,0,,Сәлем! Мариабелл! Сәлем Сесил!
Dialogue: 0,0:18:53.16,0:18:56.83,Default,,0,0,0,,Бұл кеңседе істейтін іс емес шығар. Сөйлеме, жұмысыңды істе.
Dialogue: 0,0:18:56.83,0:19:00.77,Default,,0,0,0,,Иә, иә, түсіндім.
Dialogue: 0,0:19:00.77,0:19:03.60,Default,,0,0,0,,《Рахмет, Сесиль.
Dialogue: 0,0:19:03.60,0:19:07.01,Default,,0,0,0,,Ұялғаным сонша, есінен танып қала жаздадым》
Dialogue: 0,0:19:10.61,0:19:14.28,Default,,0,0,0,,Мариабелмен. Сондай-ақ... Сакура Мочиданыкі.
Dialogue: 0,0:19:14.28,0:19:17.62,Default,,0,0,0,,«Махаббат тым ауыр РАДИО»!
Dialogue: 0,0:19:17.62,0:19:22.96,Default,,0,0,0,,♬～
Dialogue: 0,0:19:22.96,0:19:24.96,Default,,0,0,0,,Иә! Сонымен ➨
Dialogue: 0,0:19:24.96,0:19:28.96,Default,,0,0,0,,Радио мен және Хината➨ сізге үлкен махаббатпен келді
Dialogue: 0,0:19:28.96,0:19:34.47,Default,,0,0,0,,Бұл жолы да барлық тыңдарманға жеткізуім керек еді, бірақ!
Dialogue: 0,0:19:34.47,0:19:37.97,Default,,0,0,0,,Сунохара-кун өзін нашар сезініп, демалыс алуға мәжбүр болды➨
Dialogue: 0,0:19:37.97,0:19:42.31,Default,,0,0,0,,Бұл жолы Белл екеуміз оны сізге асығыс жібергіміз келеді.
Dialogue: 0,0:19:42.31,0:19:45.98,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын, сондықтан көмегіңіз үшін рахмет.
Dialogue: 0,0:19:45.98,0:19:49.32,Default,,0,0,0,,Сакура Сіз қобалжыдыңыз. Мен аламын!
Dialogue: 0,0:19:49.32,0:19:51.65,Default,,0,0,0,,Жарайды, айтсаңыз, үйреніп кетесіз.
Dialogue: 0,0:19:51.65,0:19:55.32,Default,,0,0,0,,Сондықтан өзіңізді таныстыруыңызды өтінемін.
Dialogue: 0,0:19:55.32,0:19:58.33,Default,,0,0,0,,Уау! Апыр-ай! Маған солай көрінеді.
Dialogue: 0,0:19:58.33,0:20:00.49,Default,,0,0,0,,Ой, не істеуім керек? Мен қатты қобалжыдым.
Dialogue: 0,0:20:00.49,0:20:02.83,Default,,0,0,0,,Өйткені біз мұны бірінші рет жасадық.
Dialogue: 0,0:20:02.83,0:20:05.33,Default,,0,0,0,,Уау! Қатты күрескен адамның жүзі бар.
Dialogue: 0,0:20:05.33,0:20:07.67,Default,,0,0,0,,Жын патшасы әлдеқашан жеңілген.
Dialogue: 0,0:20:07.67,0:20:10.00,Default,,0,0,0,,Мен әлемдегі ең үлкен жұмысты аяқтадым!
Dialogue: 0,0:20:10.00,0:20:12.67,Default,,0,0,0,,Содан кейін сіздің есіміңіз және сүйікті тағамыңыз➨
Dialogue: 0,0:20:12.67,0:20:15.34,Default,,0,0,0,,Ерекше дағдыларыңыз бен хоббиіңіз туралы айтып беріңізші.
Dialogue: 0,0:20:15.34,0:20:19.18,Default,,0,0,0,,Жоқ, менің жұмысым Бұл оңай көрінетіні қызық.
Dialogue: 0,0:20:19.18,0:20:22.18,Default,,0,0,0,,Дұрыс па? Оны жын қожайынының бағыныштылығымен салыстырмаңыз.
Dialogue: 0,0:20:22.18,0:20:24.19,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,0:20:24.19,0:20:27.69,Default,,0,0,0,,Мм... сондай-ақ Сакура Мочида.
Dialogue: 0,0:20:27.69,0:20:33.53,Default,,0,0,0,,Менің сүйікті тағамдарым - макарон және тәттілер➨
Dialogue: 0,0:20:33.53,0:20:36.53,Default,,0,0,0,,Хобби, ерекше дағдылар... erm➨
Dialogue: 0,0:20:36.53,0:20:40.37,Default,,0,0,0,,Манга мен аниме ұнай ма?
Dialogue: 0,0:20:40.37,0:20:43.20,Default,,0,0,0,,Қиял мен сиқырды ұнататынын айттыңыз.
Dialogue: 0,0:20:43.20,0:20:46.37,Default,,0,0,0,,Дұрыс! Мен сені бала кезімнен жақсы көретінмін➨
Dialogue: 0,0:20:46.37,0:20:49.04,Default,,0,0,0,,Менің қазір Беллмен дос болғаным➨
Dialogue: 0,0:20:49.04,0:20:51.71,Default,,0,0,0,,Бұл ғажайып, дәлірек айтсақ, орындалған арман.
Dialogue: 0,0:20:51.71,0:20:54.22,Default,,0,0,0,,Мен... түсіндім. Мен түссіндім. Мен мүлде түсінбеймін!
Dialogue: 0,0:20:54.22,0:20:57.38,Default,,0,0,0,,Белл менің құмарлық сезімдерімді мүлде түсінбейді!
Dialogue: 0,0:20:57.38,0:21:00.32,Default,,0,0,0,,Толығырақ айтып беріңізші! Басқа қандай сиқырды қолдануға болады?
Dialogue: 0,0:21:00.32,0:21:02.32,Default,,0,0,0,,Мына дүниеде тағы қандай нәсілдер бар?
Dialogue: 0,0:21:02.32,0:21:05.83,Default,,0,0,0,,Тоқта, күт, бұл Сакураның өзін таныстыруы.
Dialogue: 0,0:21:05.83,0:21:09.00,Default,,0,0,0,,Ха! ол болды. Маған манга мен аниме ұнайды➨
Dialogue: 0,0:21:09.00,0:21:11.83,Default,,0,0,0,,Сізге басқа дүниелер ұнай бастады ма? Әлде бәрі керісінше ме?
Dialogue: 0,0:21:11.83,0:21:15.00,Default,,0,0,0,,Сіз манга мен анимеге басқа әлемдерді ұнатқандықтан түстіңіз бе?
Dialogue: 0,0:21:15.00,0:21:17.67,Default,,0,0,0,,Сұрау қандай қиын, Белл!
Dialogue: 0,0:21:17.67,0:21:22.01,Default,,0,0,0,,Бұл шынымен қиын ба? Жұмыртқа ма, тауық па, қайсысы бірінші болды деген сұрақ туындайды.
Dialogue: 0,0:21:22.01,0:21:25.51,Default,,0,0,0,,Философия? Ең алғаш көрген анимем – Исекай.
Dialogue: 0,0:21:25.51,0:21:30.52,Default,,0,0,0,,Мен есіме түсе бастағанда, мен аниме көріп отыр едім, үйде ойыншық сиқырлы таяқшам бар еді.
Dialogue: 0,0:21:30.52,0:21:32.69,Default,,0,0,0,,Бұл менің жас кезімнен.
Dialogue: 0,0:21:32.69,0:21:36.19,Default,,0,0,0,,Мен әлі күнге дейін манга мен анимеден сиқырлы заклинанияларды айта аламын!
Dialogue: 0,0:21:36.19,0:21:38.36,Default,,0,0,0,,Онда жолақ бар.
Dialogue: 0,0:21:38.36,0:21:41.36,Default,,0,0,0,,Бірақ екеуі де мүмкін!
Dialogue: 0,0:21:41.36,0:21:44.53,Default,,0,0,0,,Біріншіден, маған қиял ұнады, бірақ қиял шынайы емес ➨
Dialogue: 0,0:21:44.53,0:21:47.70,Default,,0,0,0,,Сондай-ақ олардың манга мен аниме материалдарына сенуден басқа таңдауы болмағаны да мағынасы бар➨
Dialogue: 0,0:21:47.70,0:21:49.70,Default,,0,0,0,,Бірақ, сіз қиял туралы қалай білдіңіз?➨
Dialogue: 0,0:21:49.70,0:21:52.37,Default,,0,0,0,,Бұл жай ғана манга мен аниме.
Dialogue: 0,0:21:52.37,0:21:56.54,Default,,0,0,0,,Үлкен тур ма деп ойлаймын. О, қазірдің өзінде! Қайсысы бірінші келді? ?
Dialogue: 0,0:21:56.54,0:21:59.88,Default,,0,0,0,,Осындай оғаш сұрақ қойғаным үшін кешіріңіз, Сакура.
Dialogue: 0,0:21:59.88,0:22:02.32,Default,,0,0,0,,Жоқ! Құмарлықтың тамырын қалай табуға болады➨
Dialogue: 0,0:22:02.32,0:22:04.32,Default,,0,0,0,,Менің ойымша, бұл өте жақсы сұрақ.
Dialogue: 0,0:22:04.32,0:22:06.65,Default,,0,0,0,,Рахмет сізге Белл. оқасы жоқ.
Dialogue: 0,0:22:06.65,0:22:08.66,Default,,0,0,0,,Бұл сұраққа жауап берілгенде➨
Dialogue: 0,0:22:08.66,0:22:12.49,Default,,0,0,0,,Мен өз махаббатым туралы жоғары деңгейде айта алатындай сезінемін.
Dialogue: 0,0:22:12.49,0:22:17.00,Default,,0,0,0,,Сакура… Маған ұнайтын нәрселерге келетін болсақ, Сакура➨
Dialogue: 0,0:22:17.00,0:22:21.84,Default,,0,0,0,,Бұл өте позитивті және жарқыраған. Ой, солай деп ойлаймын.
Dialogue: 0,0:22:21.84,0:22:25.84,Default,,0,0,0,,Иә. Менің ойымша, бұл шие гүлі ең тартымды.
Dialogue: 0,0:22:25.84,0:22:29.01,Default,,0,0,0,,Жоқ... бұл ұят, Белл.
Dialogue: 0,0:22:29.01,0:22:33.01,Default,,0,0,0,,Дәл осылай Сакураның сүйкімділігі толықтай жеткізілді.
Dialogue: 0,0:22:33.01,0:22:36.02,Default,,0,0,0,,Бұл ақыры бұрыш. Аяқтау уақыты келді.
Dialogue: 0,0:22:36.02,0:22:39.69,Default,,0,0,0,,Иә! ? Жарайды, кейде осындай жағдайлар болады.
Dialogue: 0,0:22:39.69,0:22:42.19,Default,,0,0,0,,Кешіріңіз, мен тым көп сөйледім! ?
Dialogue: 0,0:22:42.19,0:22:45.69,Default,,0,0,0,,Жоқ. Біріншіден, бұл радио қысқа.
Dialogue: 0,0:22:45.69,0:22:48.03,Default,,0,0,0,,Солай ма? Дәлірек айтқанда, ашылғаннан кейін➨
Dialogue: 0,0:22:48.03,0:22:51.20,Default,,0,0,0,,Бұл мен бірден аяқталатын бірінші рет емес.
Dialogue: 0,0:22:51.20,0:22:54.70,Default,,0,0,0,,Дұрыс! ? Мен және Хината➨ бірінші өзін-өзі таныстыру бөлімінде
Dialogue: 0,0:22:54.70,0:22:57.04,Default,,0,0,0,,Мен мұны бір рет жасадым. Апыр-ай!
Dialogue: 0,0:22:57.04,0:22:59.54,Default,,0,0,0,,Бұл екінші рет, осылайша.
Dialogue: 0,0:22:59.54,0:23:01.81,Default,,0,0,0,,Екі рет болған нәрсе үш рет қайталанады.
Dialogue: 0,0:23:01.81,0:23:04.31,Default,,0,0,0,,Үшінші рет ескерту жасамаңыз.
Dialogue: 0,0:23:04.31,0:23:08.15,Default,,0,0,0,,Жарайды. Хината бірінші рет күлді.
Dialogue: 0,0:23:08.15,0:23:10.99,Default,,0,0,0,,LOL! ? Өйткені бұл бос радио.
Dialogue: 0,0:23:10.99,0:23:14.49,Default,,0,0,0,,Шынымен де...Ю:Сен сондай боссың.
Dialogue: 0,0:23:14.49,0:23:16.99,Default,,0,0,0,,Дұрыс па? Мен шиеленістен құтылдым➨
Dialogue: 0,0:23:16.99,0:23:19.83,Default,,0,0,0,,Бұл сізді бірінші кезекте қобалжытқан нәрсе емес еді, солай ма?
Dialogue: 0,0:23:19.83,0:23:21.83,Default,,0,0,0,,Шынында да.
Dialogue: 0,0:23:21.83,0:23:25.33,Default,,0,0,0,,Сондықтан бүгінгі хабар менімен, Мариабел.
Dialogue: 0,0:23:25.33,0:23:27.84,Default,,0,0,0,,Сакура Мочида жіберген.
Dialogue: 0,0:23:27.84,0:23:31.51,Default,,0,0,0,,Хината келесі эфирге дейін оралатынына сенімдімін➨
