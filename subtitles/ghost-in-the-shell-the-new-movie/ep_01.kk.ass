Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.92,0:00:12.92,Default,,0,0,0,,♪～
Dialogue: 0,0:03:10.23,0:03:11.56,Default,,0,0,0,,Бұл жай ғана болды-
Dialogue: 0,0:03:11.69,0:03:16.86,Default,,0,0,0,,Бұл Шығыс Азия Біріккен Экономикалық Ұйымының/Қиыр Шығыс сауда министрлігі елшілігінің басып алуы туралы кейінгі есеп.
Dialogue: 0,0:03:18.19,0:03:21.61,Default,,0,0,0,,Сіз идеал адамсыз, Құсанағы майор.
Dialogue: 0,0:03:22.32,0:03:25.37,Default,,0,0,0,,Рахмет, директордың көмекшісі Фуджимото.
Dialogue: 0,0:03:27.41,0:03:31.16,Default,,0,0,0,,Сәттілік жақын, командир Курц.
Dialogue: 0,0:03:31.29,0:03:34.04,Default,,0,0,0,,Мен келісемін, Елші Ричард.
Dialogue: 0,0:03:37.92,0:03:40.26,Default,,0,0,0,,Сұхбат – бұл жай ғана формальдылық
Dialogue: 0,0:03:41.51,0:03:45.43,Default,,0,0,0,,Қазір жасанды интеллект пен әкімшілік шенеуніктердің пікірталас жүргізетін уақыты.
Dialogue: 0,0:03:45.85,0:03:48.39,Default,,0,0,0,,Бұл әңгіме де әсер ете ме?
Dialogue: 0,0:03:48.51,0:03:51.39,Default,,0,0,0,,Адамдардың машиналардан қысылуының қажеті жоқ.
Dialogue: 0,0:03:53.60,0:03:58.23,Default,,0,0,0,,Сіздің әскерлер маңызды мемлекеттік мәселелерге сәйкес келеді.
Dialogue: 0,0:04:05.62,0:04:07.24,Default,,0,0,0,,(кепілдегілердің айқайы)
Dialogue: 0,0:04:07.37,0:04:11.41,Default,,0,0,0,,Ұлы соғыс аяқталып, әлем өзгерістер кезеңіне аяқ басты.
Dialogue: 0,0:04:12.16,0:04:14.42,Default,,0,0,0,,Бұл ел де ерекшелік емес.
Dialogue: 0,0:04:17.96,0:04:21.42,Default,,0,0,0,,Соғыс кибернетика мен протездік денелердің дамуын жеделдетті
Dialogue: 0,0:04:21.92,0:04:25.51,Default,,0,0,0,,Осы процесте пайда болған киберқылмыс ауыр, бірақ...
Dialogue: 0,0:04:25.59,0:04:28.01,Default,,0,0,0,,Мәселе неғұрлым іргелі.
Dialogue: 0,0:04:31.98,0:04:33.98,Default,,0,0,0,,Кибер және протездік дене бизнесі-
Dialogue: 0,0:04:34.10,0:04:37.73,Default,,0,0,0,,Тарихтағы ең үлкен пайда іздеу жүйесін жасады
Dialogue: 0,0:04:38.52,0:04:41.36,Default,,0,0,0,,Нақты уақытта ортақ пайдаланылатын деректердің үлкен көлемі...
Dialogue: 0,0:04:41.48,0:04:45.32,Default,,0,0,0,,Дүниедегі бірде-бір ұлттың басқаруы енді мүмкін емес
Dialogue: 0,0:04:48.91,0:04:54.16,Default,,0,0,0,,Тіпті егер алыс болашақта корпоративтік агрегациялар ұлттар мен халықтарды жойса да...
Dialogue: 0,0:04:54.29,0:04:57.67,Default,,0,0,0,,Мемлекет өз рөлін әлі аяқтаған жоқ...
Dialogue: 0,0:04:57.79,0:05:00.25,Default,,0,0,0,,Иә, әсіресе қазір...
Dialogue: 0,0:05:00.34,0:05:04.34,Default,,0,0,0,,Халықаралық экономика атын жамылған анархистік жүйе...
Dialogue: 0,0:05:04.47,0:05:08.64,Default,,0,0,0,,Халықтың күн көрісі болып табылатын ұлттың іргетасын бұзу.
Dialogue: 0,0:05:08.72,0:05:10.10,Default,,0,0,0,,А, жақын! !
Dialogue: 0,0:05:23.78,0:05:25.28,Default,,0,0,0,,Кибер және протездік денелер-
Dialogue: 0,0:05:25.40,0:05:30.03,Default,,0,0,0,,Әскери өнеркәсіп пен шаруашылықтың екі жүйесін байланыстыратын көпір
Dialogue: 0,0:05:30.41,0:05:33.75,Default,,0,0,0,,Қазір үкіметтің нормативтік-құқықтық актілер шығаруының мәні жоқ.
Dialogue: 0,0:05:36.58,0:05:38.83,Default,,0,0,0,,Жүйені қамтитын құқық қорғау органы болып табылады
Dialogue: 0,0:05:38.92,0:05:41.46,Default,,0,0,0,,Ол іс жүзінде жоқ болғандықтан...
Dialogue: 0,0:05:41.54,0:05:44.96,Default,,0,0,0,,Мемлекет белгілеген заңдардан жоғары емес
Dialogue: 0,0:05:45.84,0:05:47.97,Default,,0,0,0,,Заңды бұзатын жүйелер үшін:
Dialogue: 0,0:05:48.51,0:05:51.47,Default,,0,0,0,,Тікелей шешім қажет
Dialogue: 0,0:05:54.81,0:06:00.27,Default,,0,0,0,,Ақпараттандыру бізді жүйеге айналу немесе құл болу арасында таңдау жасауға мәжбүр етеді.
Dialogue: 0,0:06:01.27,0:06:03.32,Default,,0,0,0,,Қазір бізге керегі...
Dialogue: 0,0:06:03.40,0:06:07.24,Default,,0,0,0,,Жүйені соттайтын агрессивті сот орындаушысы
Dialogue: 0,0:06:07.57,0:06:09.28,Default,,0,0,0,,Жүйемен біріктіру
Dialogue: 0,0:06:09.41,0:06:12.12,Default,,0,0,0,,Адамдарды дұрыс таңдауға арналған желі
Dialogue: 0,0:06:16.37,0:06:17.58,Default,,0,0,0,,Иә
Dialogue: 0,0:06:18.04,0:06:23.75,Default,,0,0,0,,Біз сізді және сіздің ұйымыңызды лайықты корпоративтік тұлға ретінде танимыз.
Dialogue: 0,0:06:23.88,0:06:25.55,Default,,0,0,0,,Командир Курц
Dialogue: 0,0:06:26.34,0:06:28.42,Default,,0,0,0,,Тікелей үкіметтің қарамағында терроризмге қарсы қызмет
Dialogue: 0,0:06:28.55,0:06:30.38,Default,,0,0,0,,Ең озық киберзерттеу
Dialogue: 0,0:06:30.51,0:06:32.43,Default,,0,0,0,,Корпоративтік қылмыстарды айыптау
Dialogue: 0,0:06:32.97,0:06:35.39,Default,,0,0,0,,Сіздің бөлімшеде тыйымдар жоқ.
Dialogue: 0,0:06:36.81,0:06:38.14,Default,,0,0,0,,Мадака майоры
Dialogue: 0,0:06:38.27,0:06:39.35,Default,,0,0,0,,Санаулы минуттар қалды.
Dialogue: 0,0:06:40.19,0:06:41.31,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:06:41.60,0:06:45.48,Default,,0,0,0,,Шабуылдан кейін 1 сағаттан кейін мерекелік шаралар
Dialogue: 0,0:06:47.82,0:06:50.99,Default,,0,0,0,,Қарғыс атсын, мен 9-Қоғамдық қауіпсіздік бөлімінің директоры Маймылмын.
Dialogue: 0,0:06:54.16,0:06:58.20,Default,,0,0,0,,9-бөлімнің директоры Арамаки бізді жіберуді өтінді, солай ма?
Dialogue: 0,0:06:58.50,0:07:00.92,Default,,0,0,0,,Олар эксклюзивті пайдалануды қалайды.
Dialogue: 0,0:07:01.25,0:07:03.92,Default,,0,0,0,,Мен тәуелсіздікке негізделген мамандыққа сай емеспін.
Dialogue: 0,0:07:04.25,0:07:06.46,Default,,0,0,0,,Билікті маймылдар басып алды
Dialogue: 0,0:07:06.59,0:07:09.84,Default,,0,0,0,,Біз не істеуіміз керек? Майор, 9-бөлімнің торына кіріп кетесіз бе?
Dialogue: 0,0:07:10.13,0:07:13.51,Default,,0,0,0,,Мен келіссөз жүргіземін. Өтінемін, тыныш күтіңіз.
Dialogue: 0,0:07:17.93,0:07:21.89,Default,,0,0,0,,Премьер-министр ағымдағы істі ертерек шешуді талап етеді.
Dialogue: 0,0:07:23.19,0:07:27.65,Default,,0,0,0,,Ал... ол өкілеттік енді сізге берілді.
Dialogue: 0,0:07:29.15,0:07:31.74,Default,,0,0,0,,Рахмет, көмекші.
Dialogue: 0,0:07:36.70,0:07:39.16,Default,,0,0,0,,Сізге бұл ел ұнай ма?
Dialogue: 0,0:07:40.41,0:07:43.37,Default,,0,0,0,,Мен өз қабілеттерімді көрсеткім келетін дәрежеде
Dialogue: 0,0:07:43.75,0:07:47.84,Default,,0,0,0,,Мм... ел сені сүйсін деп тырысу керек.
Dialogue: 0,0:07:48.59,0:07:49.80,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:50.38,0:07:52.51,Default,,0,0,0,,дереу
Dialogue: 0,0:07:54.89,0:07:56.60,Default,,0,0,0,,Ах… Оу
Dialogue: 0,0:07:56.72,0:07:57.72,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:08:01.14,0:08:03.52,Default,,0,0,0,,Сіздің күлкіңіз тым тамаша
Dialogue: 0,0:08:03.64,0:08:06.19,Default,,0,0,0,,Бұлай протездік денеге жад бөлудің қажеті жоқ.
Dialogue: 0,0:08:08.15,0:08:12.15,Default,,0,0,0,,Мен ешқашан бағдарламаға күлген емеспін, көмекші.
Dialogue: 0,0:08:13.57,0:08:18.12,Default,,0,0,0,,Әй... сенің жаның... Аруақтан күдіктенетін ойым жоқ.
Dialogue: 0,0:08:21.20,0:08:22.58,Default,,0,0,0,,Оқиға орнына барыңыз
Dialogue: 0,0:08:27.84,0:08:30.96,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:08:32.63,0:08:34.18,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:08:40.35,0:08:42.10,Default,,0,0,0,,Ишикава туралы ақпарат
Dialogue: 0,0:08:42.23,0:08:44.44,Default,,0,0,0,,Ұлттық кеңес 320-ші мерзім -
Dialogue: 0,0:08:44.56,0:08:46.65,Default,,0,0,0,,Бюджеттің өтуі туралы есепті тексеру
Dialogue: 0,0:08:46.77,0:08:48.65,Default,,0,0,0,,Жарайсың, майор.
Dialogue: 0,0:08:51.44,0:08:55.07,Default,,0,0,0,,Менің қабылдау бөлмесіне кіріңіз, мен істі аламын.
Dialogue: 0,0:09:19.05,0:09:20.47,Default,,0,0,0,,Құсанағы…
Dialogue: 0,0:09:20.60,0:09:22.56,Default,,0,0,0,,Мен сені мұндай жерде кездестіремін деп ойламаппын.
Dialogue: 0,0:09:23.52,0:09:26.02,Default,,0,0,0,,Сіз ескірген үкіметке құйрығыңызды бұлғауға келдіңіз бе?
Dialogue: 0,0:09:26.94,0:09:28.40,Default,,0,0,0,,Ал сіз ше?
Dialogue: 0,0:09:28.52,0:09:32.73,Default,,0,0,0,,Ол корпоративтік пайда іздеуші машинаға айналады ма? құрз
Dialogue: 0,0:09:32.86,0:09:35.57,Default,,0,0,0,,Әскери ұйымдардың көпшілігі жекешелендіріледі
Dialogue: 0,0:09:35.70,0:09:37.53,Default,,0,0,0,,Бұл соғыс
Dialogue: 0,0:09:37.66,0:09:39.99,Default,,0,0,0,,Егер сіз жеңілген жақта болсаңыз, болашақ жоқ.
Dialogue: 0,0:09:40.32,0:09:42.33,Default,,0,0,0,,Соғыс аяқталды
Dialogue: 0,0:09:42.45,0:09:45.96,Default,,0,0,0,,Менің елестерге сериялық нөмір қосу ойым жоқ.
Dialogue: 0,0:09:47.62,0:09:51.59,Default,,0,0,0,,Барлық адамдар алмасуға болатын тұтыну бірліктері.
Dialogue: 0,0:09:51.71,0:09:54.76,Default,,0,0,0,,Кім көбірек шығындалады, сен бе, мен бе?
Dialogue: 0,0:09:54.88,0:09:56.51,Default,,0,0,0,,Түсінуге оңай
Dialogue: 0,0:10:20.57,0:10:24.16,Default,,0,0,0,,Мен сонда 7 минуттан кейін боламын. Менде барлық ақпарат бар.
Dialogue: 0,0:10:42.51,0:10:45.06,Default,,0,0,0,,Қорғаныс министрлігін Қорғаныс агенттігіне төмендетуге қарсы.
Dialogue: 0,0:10:45.18,0:10:47.27,Default,,0,0,0,,11 ұлттық қорғаныс әскери қызметшілері...
Dialogue: 0,0:10:47.39,0:10:52.02,Default,,0,0,0,,Шығыс Азия Одағы Экономикалық субъектісі/Қиыр Шығыс сауда министрлігі елшілігін басып алу
Dialogue: 0,0:10:52.15,0:10:56.82,Default,,0,0,0,,Ағымдағы орны, фон, байланысты ұйымдар
Dialogue: 0,0:10:57.57,0:10:59.03,Default,,0,0,0,,Ал...
Dialogue: 0,0:10:59.15,0:10:59.99,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:11:00.11,0:11:02.03,Default,,0,0,0,,Барлық 11 адам протездік денеге айналды
Dialogue: 0,0:11:02.28,0:11:05.28,Default,,0,0,0,,Екі адам ауыр салмақты өзгертілген протездеу.
Dialogue: 0,0:11:05.41,0:11:08.79,Default,,0,0,0,,Мобильді полиция бұл туралы ештеңе істей алмайды.
Dialogue: 0,0:11:11.62,0:11:13.29,Default,,0,0,0,,42 кепілге алынғандар
Dialogue: 0,0:11:13.42,0:11:16.46,Default,,0,0,0,,36 адам бомба қойылған залда үйқамаққа алынды
Dialogue: 0,0:11:16.96,0:11:20.22,Default,,0,0,0,,Қалған алтауы дүрбелең бөлмесіне қашып кеткен басшылар.
Dialogue: 0,0:11:20.34,0:11:22.13,Default,,0,0,0,,Бұл таңдаулы болар еді.
Dialogue: 0,0:11:22.89,0:11:24.89,Default,,0,0,0,,Есік ашылса, ең жаманы.
Dialogue: 0,0:11:25.30,0:11:29.35,Default,,0,0,0,,Олар жүздеген күн бойы қамауға алынады ма, әлде көпшілік алдында өлім жазасына кесіледі ме?
Dialogue: 0,0:11:29.93,0:11:31.64,Default,,0,0,0,,Олардың талаптары қандай?
Dialogue: 0,0:11:31.77,0:11:34.61,Default,,0,0,0,,Қорғаныс министрлігін ұстау және әскери сот процестерін тоқтату
Dialogue: 0,0:11:34.73,0:11:36.82,Default,,0,0,0,,Қашу туралы ештеңе жоқ
Dialogue: 0,0:11:37.27,0:11:40.57,Default,,0,0,0,,Сіз өзімшіл шайқас алаңын іздеп жүрсіз бе?
Dialogue: 0,0:11:41.40,0:11:44.28,Default,,0,0,0,,Менің сигналым бойынша Доминді орындаңыз, ішке кіріңіз.
Dialogue: 0,0:11:44.37,0:11:46.78,Default,,0,0,0,,Күте тұрыңыз, тек біз бе?
Dialogue: 0,0:11:46.91,0:11:49.25,Default,,0,0,0,,Кибербұзушылықты бақылайтын снайпер
Dialogue: 0,0:11:49.37,0:11:50.70,Default,,0,0,0,,Қалқан – Логикома
Dialogue: 0,0:11:50.83,0:11:53.71,Default,,0,0,0,,Айналадағы тәртіп сақшылары жауды күшейтуге жол бермейді
Dialogue: 0,0:11:53.83,0:11:55.04,Default,,0,0,0,,Тағы бірдеңе бар ма?
Dialogue: 0,0:11:55.17,0:11:57.55,Default,,0,0,0,,Хмм... Шынайы ма?
Dialogue: 0,0:11:57.67,0:11:59.26,Default,,0,0,0,,Маған оқулығым мен галстук керек.
Dialogue: 0,0:11:59.38,0:12:01.55,Default,,0,0,0,,Сіз ештеңе істей алмайсыз ба, жаңадан келген бала?
Dialogue: 0,0:12:01.63,0:12:02.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:02.59,0:12:05.22,Default,,0,0,0,,Саған жалғыз тірі қалу қиын.
Dialogue: 0,0:12:05.34,0:12:08.22,Default,,0,0,0,,Осы мүмкіндікті пайдаланып, толық дене протезін алуға қалай қарайсыз...
Dialogue: 0,0:12:08.31,0:12:12.02,Default,,0,0,0,,Мен өлсем, сұлу әйеліңді шақырамын.
Dialogue: 0,0:12:12.14,0:12:14.27,Default,,0,0,0,,Компьютер ұшып кетпес бұрын-
Dialogue: 0,0:12:14.40,0:12:16.69,Default,,0,0,0,,Кем дегенде өсиетті қалпына келтіруге болады.
Dialogue: 0,0:12:17.27,0:12:19.61,Default,,0,0,0,,Аяқтау соққысын азапсыз алғыңыз келгенде...
Dialogue: 0,0:12:19.73,0:12:21.65,Default,,0,0,0,,Маған қоңырау шалыңыз
Dialogue: 0,0:12:22.15,0:12:23.78,Default,,0,0,0,,Блять сендерге.
Dialogue: 0,0:12:23.90,0:12:25.41,Default,,0,0,0,,Жақсы, мен жасаймын!
Dialogue: 0,0:12:26.62,0:12:30.41,Default,,0,0,0,,Балалар мен тапқан ең жақсы бөліктер сендерсіңдер.
Dialogue: 0,0:12:31.08,0:12:35.21,Default,,0,0,0,,Егер сіз жақсы өнер көрсете алмасаңыз, мен сізді кез келген уақытта тазартамын.
Dialogue: 0,0:12:35.33,0:12:37.54,Default,,0,0,0,,Дегенмен, көпшілігіңіз...
Dialogue: 0,0:12:37.67,0:12:40.38,Default,,0,0,0,,Менің бөлімшеде болмасаң, түрмеге түсесің.
Dialogue: 0,0:12:40.67,0:12:43.13,Default,,0,0,0,,Менің тағдырым біреудің арқасынан оқ жаудыратын.
Dialogue: 0,0:12:43.55,0:12:45.13,Default,,0,0,0,,Мен саған мүмкіндік беремін. Таңдауға екі жол бар.
Dialogue: 0,0:12:46.47,0:12:49.05,Default,,0,0,0,,Енгізуге дайын. Ұйымдастырылған.
Dialogue: 0,0:12:50.68,0:12:53.60,Default,,0,0,0,,Сіз адамдарды бөліктер деп атайсыз ба?
Dialogue: 0,0:12:53.73,0:12:56.48,Default,,0,0,0,,Менің ойымша, сіз дәл осылай айтқыңыз келеді.
Dialogue: 0,0:12:56.60,0:12:58.77,Default,,0,0,0,,Аңғал ханшайым
Dialogue: 0,0:12:59.15,0:13:00.32,Default,,0,0,0,,Бұл жын
Dialogue: 0,0:13:00.44,0:13:01.90,Default,,0,0,0,,Әйел горилла
Dialogue: 0,0:13:02.03,0:13:03.74,Default,,0,0,0,,Бұл сұмдық әйел.
Dialogue: 0,0:13:04.15,0:13:07.16,Default,,0,0,0,,Бұл бізге сенетініңізді білдіреді.
Dialogue: 0,0:13:07.28,0:13:10.87,Default,,0,0,0,,Боқ, мен қатты өліп қалуым мүмкін.
Dialogue: 0,0:13:11.99,0:13:14.66,Default,,0,0,0,,Біз жалғыз басып кіре алмаймыз!
Dialogue: 0,0:13:15.12,0:13:18.38,Default,,0,0,0,,Арнайы күштер ше? Рейнджерге не болды?
Dialogue: 0,0:13:18.50,0:13:20.29,Default,,0,0,0,,Кез келген жерде орналастырудан бас тарту
Dialogue: 0,0:13:20.42,0:13:24.76,Default,,0,0,0,,Шетелдік соғысқұмарлар үшін өз адамдарымды атқым келмейді...
Dialogue: 0,0:13:24.88,0:13:28.43,Default,,0,0,0,,Оларға бұдан былай қылмыс жасамауды айт.
Dialogue: 0,0:13:28.55,0:13:32.10,Default,,0,0,0,,Қатысқан барлық бөлімшелер қастандық жасады деп айыпталады.
Dialogue: 0,0:13:32.77,0:13:35.81,Default,,0,0,0,,Директор, келіссөз жүргізушісін көтеріңіз.
Dialogue: 0,0:13:35.89,0:13:38.10,Default,,0,0,0,,Майор! Ақыры келдің бе?
Dialogue: 0,0:13:38.23,0:13:41.11,Default,,0,0,0,,Кешіріңіз, бірақ мен оны алып тастауым керек.
Dialogue: 0,0:13:41.23,0:13:46.28,Default,,0,0,0,,Хм... Жаңа ғана талқылаудан өткен оғаш әскери бюджетке сіз жауаптысыз ба?
Dialogue: 0,0:13:47.11,0:13:49.37,Default,,0,0,0,,Саясаткерлерге сүйенетін сияқты емес
Dialogue: 0,0:13:49.49,0:13:52.33,Default,,0,0,0,,Бұл қиындық туғызды, сондықтан мен жоғарғы басшылықпен келіссөз жүргіздім.
Dialogue: 0,0:13:54.45,0:13:57.50,Default,,0,0,0,,Премьер-министрге тікелей есеп беру қағаз жүзінде ғана.
Dialogue: 0,0:13:57.62,0:14:00.67,Default,,0,0,0,,Біз халықаралық құқыққа сәйкес келетін әскерлерді ұсынамыз.
Dialogue: 0,0:14:01.63,0:14:06.17,Default,,0,0,0,,«Сауыттағы елес» халықаралық құтқару тобының құрамында құрылған...
Dialogue: 0,0:14:06.30,0:14:07.42,Default,,0,0,0,,болды ма?
Dialogue: 0,0:14:07.55,0:14:11.14,Default,,0,0,0,,Егер соғыс болмаса, ол баяғыда құрылған еді
Dialogue: 0,0:14:11.22,0:14:13.51,Default,,0,0,0,,Бүйректегі қылмысты ашу -
Dialogue: 0,0:14:13.64,0:14:16.64,Default,,0,0,0,,Бұл оқиғалар орын алмас бұрын тоқтатыңыз
Dialogue: 0,0:14:16.77,0:14:18.35,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:14:18.48,0:14:21.52,Default,,0,0,0,,Мен ойдан шығарылған жасақтан гөрі қазіргі оқиғаны алғым келеді.
Dialogue: 0,0:14:21.81,0:14:23.57,Default,,0,0,0,,Кіру уақыты қанша?
Dialogue: 0,0:14:23.69,0:14:24.86,Default,,0,0,0,,20 секундтан кейін
Dialogue: 0,0:14:24.94,0:14:26.99,Default,,0,0,0,,Себебі мен сені барынша өлтірмеймін.
Dialogue: 0,0:14:27.11,0:14:29.95,Default,,0,0,0,,Бізден кейін жұмыс істеуге рұқсат етеміз.
Dialogue: 0,0:14:32.58,0:14:36.00,Default,,0,0,0,,Ойыншық алған бала сияқты.
Dialogue: 0,0:14:57.39,0:14:58.52,Default,,0,0,0,,Үстемдіктің орындалуы!
Dialogue: 0,0:15:01.73,0:15:02.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:03.31,0:15:04.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:04.73,0:15:06.86,Default,,0,0,0,,Байланысқа... Домин шабуыл жасады.
Dialogue: 0,0:15:07.32,0:15:10.07,Default,,0,0,0,,Өте жақсы, келіңдер!
Dialogue: 0,0:15:21.62,0:15:24.50,Default,,0,0,0,,Мақсат... көзіме кіріп жатыр!
Dialogue: 0,0:15:24.59,0:15:30.59,Default,,0,0,0,,♪～
Dialogue: 0,0:15:50.28,0:15:51.53,Default,,0,0,0,,Уф! Арх...
Dialogue: 0,0:15:54.70,0:15:57.91,Default,,0,0,0,,Гррр... Гррр...
Dialogue: 0,0:15:58.04,0:16:00.62,Default,,0,0,0,,Ах! ! Уф...
Dialogue: 0,0:16:00.75,0:16:05.88,Default,,0,0,0,,Уф! Ааааааааааааааааааааааа! !
Dialogue: 0,0:16:07.54,0:16:13.55,Default,,0,0,0,,♪～
Dialogue: 0,0:16:21.52,0:16:23.27,Default,,0,0,0,,Әй, не болды! ?
Dialogue: 0,0:16:25.44,0:16:26.73,Default,,0,0,0,,Я...
Dialogue: 0,0:16:34.36,0:16:35.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:35.28,0:16:38.16,Default,,0,0,0,,(Кепілдегілердің айқайы)
Dialogue: 0,0:16:42.62,0:16:44.71,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:16:45.87,0:16:46.96,Default,,0,0,0,,Ах
Dialogue: 0,0:16:47.50,0:16:49.67,Default,,0,0,0,,Уф... Қат!
Dialogue: 0,0:16:53.26,0:16:55.13,Default,,0,0,0,,Әй... Арх!
Dialogue: 0,0:16:56.39,0:16:58.18,Default,,0,0,0,,Логикома Кепілге алынғандарды қорғаңыз
Dialogue: 0,0:16:58.26,0:17:01.52,Default,,0,0,0,,Тәртіп түсінілді~
Dialogue: 0,0:17:03.64,0:17:04.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:08.19,0:17:10.90,Default,,0,0,0,,Сен менің олжамсың ба?
Dialogue: 0,0:17:12.48,0:17:14.11,Default,,0,0,0,,Тезірек барымтадағыларды берме!
Dialogue: 0,0:17:14.53,0:17:16.11,Default,,0,0,0,,Уақытты кез келген жағдайда сатып алыңыз
Dialogue: 0,0:17:16.74,0:17:17.57,Default,,0,0,0,,Сәлем~ (Солдат) О
Dialogue: 0,0:17:17.66,0:17:19.28,Default,,0,0,0,,Ооо! !
Dialogue: 0,0:17:19.37,0:17:22.16,Default,,0,0,0,,Уау... Уау...
Dialogue: 0,0:17:24.00,0:17:25.71,Default,,0,0,0,,Ух... аа аа!
Dialogue: 0,0:17:32.50,0:17:33.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:36.13,0:17:38.34,Default,,0,0,0,,Қараңызшы, мен де...
Dialogue: 0,0:17:40.93,0:17:42.77,Default,,0,0,0,,Уау! Құла!
Dialogue: 0,0:17:42.89,0:17:48.90,Default,,0,0,0,,♪～
Dialogue: 0,0:17:56.11,0:17:56.95,Default,,0,0,0,,Ах
Dialogue: 0,0:17:57.07,0:17:58.53,Default,,0,0,0,,Сіз қайда көздеп отырсыз? Мені өлтірме.
Dialogue: 0,0:17:58.66,0:17:59.49,Default,,0,0,0,,Цк
Dialogue: 0,0:17:59.74,0:18:00.74,Default,,0,0,0,,Уф
Dialogue: 0,0:18:02.87,0:18:05.08,Default,,0,0,0,,Көру аймағыңызға қарамаңыз
Dialogue: 0,0:18:05.20,0:18:06.54,Default,,0,0,0,,Өлтіру әдетіңізді түзетіңіз
Dialogue: 0,0:18:06.66,0:18:08.21,Default,,0,0,0,,Соғыс аяқталды
Dialogue: 0,0:18:08.33,0:18:11.00,Default,,0,0,0,,Олардың көпшілігі әлі де жалғасуда.
Dialogue: 0,0:18:17.22,0:18:18.63,Default,,0,0,0,,Бітір!
Dialogue: 0,0:18:19.89,0:18:23.72,Default,,0,0,0,,Жоқ... у... а...
Dialogue: 0,0:18:25.81,0:18:27.77,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:18:28.31,0:18:30.27,Default,,0,0,0,,Мм! (Бату) Гуг...
Dialogue: 0,0:18:31.15,0:18:33.61,Default,,0,0,0,,Бұл тек күші бар абайсыз модификация.
Dialogue: 0,0:18:33.86,0:18:36.99,Default,,0,0,0,,Майдан даласында өлейін деп жатқанда, бүкіл денем протездік денеге айналған...
Dialogue: 0,0:18:37.11,0:18:39.99,Default,,0,0,0,,Сіз өзіңізді ең жақсы нұсқамын деп ойладыңыз.
Dialogue: 0,0:18:40.11,0:18:41.37,Default,,0,0,0,,Хмм.
Dialogue: 0,0:18:44.28,0:18:45.33,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:46.12,0:18:47.58,Default,,0,0,0,,Мен де солай болдым.
Dialogue: 0,0:18:47.70,0:18:49.46,Default,,0,0,0,,(Елес құлыпты кірістіру дыбысы)
Dialogue: 0,0:18:56.46,0:18:58.51,Default,,0,0,0,,Майор, біз бітірдік.
Dialogue: 0,0:18:59.22,0:19:00.43,Default,,0,0,0,,Дүрбелең бөлмесі туралы не деуге болады?
Dialogue: 0,0:19:00.55,0:19:03.47,Default,,0,0,0,,Есік қауіпсіз. Екі адам қозғалыста.
Dialogue: 0,0:19:04.10,0:19:05.72,Default,,0,0,0,,Менің және Батудың арасы
Dialogue: 0,0:19:05.85,0:19:06.89,Default,,0,0,0,,Кепілге алынғандарды босату
Dialogue: 0,0:19:07.02,0:19:09.31,Default,,0,0,0,,Тұтқынға алынған адамдарды залға жинаңыз.
Dialogue: 0,0:19:13.15,0:19:15.23,Default,,0,0,0,,Біз де асығамыз ба?
Dialogue: 0,0:19:15.36,0:19:17.44,Default,,0,0,0,,Сізге сайқымазақ керек пе?
Dialogue: 0,0:19:17.57,0:19:22.16,Default,,0,0,0,,Үкімет орталық үкімет алдында жергілікті жерде тексеруге жетекшілік етсе жақсы болар еді
Dialogue: 0,0:19:23.07,0:19:28.25,Default,,0,0,0,,200 адам қоршауда қалған жауды 7 адам тұтқынға ала ма?
Dialogue: 0,0:19:28.37,0:19:30.04,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:19:39.34,0:19:41.43,Default,,0,0,0,,Ол қауіпсіз, Премьер-министр.
Dialogue: 0,0:19:42.01,0:19:45.93,Default,,0,0,0,,Хмм… Бұйрық шығарыңыз.
Dialogue: 0,0:19:50.85,0:19:51.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:53.90,0:19:54.73,Default,,0,0,0,,Ах!?
Dialogue: 0,0:19:55.19,0:19:56.02,Default,,0,0,0,,Бату! ?
Dialogue: 0,0:19:56.15,0:19:57.40,Default,,0,0,0,,Майор! ?
Dialogue: 0,0:19:57.52,0:19:58.94,Default,,0,0,0,,Жау қайда?
Dialogue: 0,0:20:04.82,0:20:06.33,Default,,0,0,0,,Ишикава Не болып жатыр! ?
Dialogue: 0,0:20:06.45,0:20:08.49,Default,,0,0,0,,Бір сәт үзілді
Dialogue: 0,0:20:08.62,0:20:10.79,Default,,0,0,0,,Үй-жайдағы 12-ші адам
Dialogue: 0,0:20:11.04,0:20:13.54,Default,,0,0,0,,12-ші тұлға? Орынды табыңыз!
Dialogue: 0,0:20:16.21,0:20:17.34,Default,,0,0,0,,Эй!
Dialogue: 0,0:20:17.46,0:20:23.47,Default,,0,0,0,,♪～
Dialogue: 0,0:20:35.52,0:20:37.27,Default,,0,0,0,,Бір-бірімен төбелесу?
Dialogue: 0,0:20:42.36,0:20:44.61,Default,,0,0,0,,Уф! Ха!
Dialogue: 0,0:20:48.83,0:20:52.70,Default,,0,0,0,,(Жаңартылған солдаттың ауыр тыныс алуы)
Dialogue: 0,0:20:56.21,0:20:58.04,Default,,0,0,0,,Жүр, сыртқа тез шық!
Dialogue: 0,0:21:01.80,0:21:04.59,Default,,0,0,0,,Бұл біртүрлі. Бір адам жоғалып кетті.
Dialogue: 0,0:21:04.72,0:21:07.51,Default,,0,0,0,,Біраз уақыттан бері байланыста шу бар...
Dialogue: 0,0:21:17.94,0:21:20.94,Default,,0,0,0,,Уа... тек маған тиіспе!
Dialogue: 0,0:21:31.83,0:21:33.87,Default,,0,0,0,,Кепілге алынғандарды компьютермен ластау!
Dialogue: 0,0:21:34.00,0:21:35.54,Default,,0,0,0,,Бұл үлгі...
Dialogue: 0,0:21:35.62,0:21:37.54,Default,,0,0,0,,Псевдожад вирусы...
Dialogue: 0,0:21:37.83,0:21:41.00,Default,,0,0,0,,Өрт сөндіргіш! Виртуалды вакцинаны шығарыңыз!
Dialogue: 0,0:21:41.59,0:21:43.80,Default,,0,0,0,,Сіз оған аруақ құлпын салған болуыңыз керек! ?
Dialogue: 0,0:21:44.17,0:21:46.09,Default,,0,0,0,,Қалай қозғалуға болады! ?
Dialogue: 0,0:21:47.80,0:21:49.72,Default,,0,0,0,,Міне 12-ші адам!
Dialogue: 0,0:21:50.10,0:21:52.64,Default,,0,0,0,,Бұл пакеттелген вирус хосты!
Dialogue: 0,0:21:52.76,0:21:54.18,Default,,0,0,0,,Киберді жойыңыз!
Dialogue: 0,0:21:55.93,0:21:58.69,Default,,0,0,0,,Мен өлтіруге рұқсат алғаныма біраз болды.
Dialogue: 0,0:21:58.81,0:22:04.82,Default,,0,0,0,,♪～
Dialogue: 0,0:22:28.26,0:22:29.43,Default,,0,0,0,,Ха...
Dialogue: 0,0:22:29.51,0:22:31.55,Default,,0,0,0,,Күте тұрыңыз, Премьер-министр!
Dialogue: 0,0:22:38.98,0:22:40.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:41.31,0:22:42.23,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:22:42.56,0:22:43.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:46.23,0:22:49.40,Default,,0,0,0,,Құлақ! Менің тірі бөліктерім!
Dialogue: 0,0:22:49.53,0:22:50.74,Default,,0,0,0,,Мен сені өлтіремін!
Dialogue: 0,0:23:01.58,0:23:03.50,Default,,0,0,0,,Не деген...
Dialogue: 0,0:23:09.34,0:23:11.09,Default,,0,0,0,,Псевдокибер...
Dialogue: 0,0:23:11.72,0:23:14.68,Default,,0,0,0,,Ghost, бұл қашықтан басқарылатын қуыршақ.
Dialogue: 0,0:23:14.81,0:23:16.01,Default,,0,0,0,,12-ші жақтың орны қандай?
Dialogue: 0,0:23:16.26,0:23:18.85,Default,,0,0,0,,Жоғалтып алдым, қазір іздеп жүрмін
Dialogue: 0,0:23:18.98,0:23:19.48,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:23:19.48,0:23:20.44,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:23:19.48,0:23:20.44,Default,,0,0,0,,Әй?
Dialogue: 0,0:23:20.44,0:23:20.98,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:23:20.98,0:23:23.56,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:23:20.98,0:23:23.56,Default,,0,0,0,,Үкіметтің төтенше жағдай туралы ескертуі?
Dialogue: 0,0:23:23.56,0:23:23.90,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:23:24.40,0:23:27.94,Default,,0,0,0,,Ягсаки қонақүйіндегі құпия кездесу? Бомба шабуылы?
Dialogue: 0,0:23:28.07,0:23:30.36,Default,,0,0,0,,Сіз не туралы айтып отырсыз? кім өлді?
Dialogue: 0,0:23:30.78,0:23:31.95,Default,,0,0,0,,Ха!
Dialogue: 0,0:23:32.07,0:23:38.58,Default,,0,0,0,,♪～
Dialogue: 0,0:24:04.35,0:24:06.40,Default,,0,0,0,,Қазіргі премьер-министрге қастандық жасалды.
Dialogue: 0,0:24:06.52,0:24:07.98,Default,,0,0,0,,Бұрын-соңды болмаған оқиға -
Dialogue: 0,0:24:08.11,0:24:11.32,Default,,0,0,0,,Жапон сарбаздары Шығыс Азияның Біріккен елшілігін басып алды...
Dialogue: 0,0:24:11.40,0:24:12.36,Default,,0,0,0,,Елшіліктің жұмысы және -
Dialogue: 0,0:24:12.49,0:24:14.78,Default,,0,0,0,,Премьер-министрді өлтірудің себебі мен салдары түсініксіз.
Dialogue: 0,0:24:15.20,0:24:18.20,Default,,0,0,0,,Тергеу органы отставкаға кеткен қорғаныс министрінің орнына келді -
Dialogue: 0,0:24:18.29,0:24:21.20,Default,,0,0,0,,Уақытша шенеунік ретінде Йоко Китахара, Қорғаныс министрінің орынбасары...
Dialogue: 0,0:24:21.87,0:24:23.62,Default,,0,0,0,,Министрлер кабинеті Қорғаныс агенттігінің рейтингін төмендетеді.
Dialogue: 0,0:24:23.71,0:24:27.63,Default,,0,0,0,,Бұл мәжбүрлі қадам ретінде қарастырылады және әскери бірлестіктердің қарсылығы артып келеді.
Dialogue: 0,0:24:50.78,0:24:51.82,Default,,0,0,0,,Иә
Dialogue: 0,0:24:52.82,0:24:54.99,Default,,0,0,0,,Шығын материалдары дегеніміз не?
Dialogue: 0,0:24:57.03,0:24:59.62,Default,,0,0,0,,Біреу сізді бір рет пайдалануға болатын етіп жасады ма?
Dialogue: 0,0:25:03.71,0:25:08.96,Default,,0,0,0,,Мен оны тауып алып, сенің жаныңда ұйықтатамын, Курц.
Dialogue: 0,0:25:09.79,0:25:13.80,Default,,0,0,0,,Құпия кездесудің серіктесі Қиыр Шығыс сауда департаментінің елшісі Ричард.
Dialogue: 0,0:25:13.92,0:25:18.22,Default,,0,0,0,,Ешбір болжам жасамай, бір уақытта орын алған елшілікті басып алудың фонын талдаңыз.
Dialogue: 0,0:25:18.30,0:25:21.43,Default,,0,0,0,,Ха (Арамаки) Премьер-министр кеңсесінің қозғалысын тексеру.
Dialogue: 0,0:25:21.56,0:25:24.68,Default,,0,0,0,,Тұтқындаудан иммунитетке үміткерлерді бақылаңыз.
Dialogue: 0,0:25:24.81,0:25:25.89,Default,,0,0,0,,Га
Dialogue: 0,0:25:39.74,0:25:41.74,Default,,0,0,0,,Бұл орын алмас бұрын—
Dialogue: 0,0:25:42.16,0:25:45.71,Default,,0,0,0,,Біз оны қалай болғанда да тоқтатуға мәжбүр болдық!
Dialogue: 0,0:25:47.71,0:25:49.33,Default,,0,0,0,,Техникалық қызмет көрсету аяқталды ма?
Dialogue: 0,0:25:49.46,0:25:52.13,Default,,0,0,0,,Егер сізде бюджет болса, техникалық қызмет көрсету де жақсы.
Dialogue: 0,0:25:52.71,0:25:56.59,Default,,0,0,0,,Енді премьер-министр қайтыс болды, мен келесі бюджетті аламыз ба деп алаңдаймын.
Dialogue: 0,0:25:56.68,0:25:58.68,Default,,0,0,0,,Маған реттеу үшін 2 сағат беріңіз.
Dialogue: 0,0:25:58.80,0:26:01.55,Default,,0,0,0,,Мені дәл қасымның арасымен атқан жігітті жұдырықтаймын.
Dialogue: 0,0:26:01.76,0:26:04.60,Default,,0,0,0,,Майордың изоморфты протездік денесі Сайтомен жүріңіз
Dialogue: 0,0:26:04.72,0:26:06.27,Default,,0,0,0,,Оны көрген жалғыз сенсің.
Dialogue: 0,0:26:06.39,0:26:07.52,Default,,0,0,0,,Мен екеуін де орындаймын.
Dialogue: 0,0:26:08.31,0:26:09.98,Default,,0,0,0,,Сонымен, сіз не істейсіз, майор?
Dialogue: 0,0:26:10.69,0:26:13.57,Default,,0,0,0,,Пазу - елшілік, Бома - жарылыс орны.
Dialogue: 0,0:26:13.69,0:26:16.11,Default,,0,0,0,,Бұл екі жақты операция болғанын тексеріңіз.
Dialogue: 0,0:26:16.24,0:26:18.66,Default,,0,0,0,,Подполковник Курцтың компьютері ше?
Dialogue: 0,0:26:18.74,0:26:20.57,Default,,0,0,0,,Қатты зақымдалған және оқылмайды
Dialogue: 0,0:26:20.70,0:26:23.16,Default,,0,0,0,,Мен оның ісін және вирусын қарастырамын.
Dialogue: 0,0:26:23.70,0:26:27.16,Default,,0,0,0,,Вирусты таратқан майордың бір типті протездік денесі болды деп есептесек...
Dialogue: 0,0:26:27.29,0:26:28.37,Default,,0,0,0,,Өлтірген дұрыс па?
Dialogue: 0,0:26:28.50,0:26:30.67,Default,,0,0,0,,Мәйіт ұйымдастырушы туралы мәлімет бере ме?
Dialogue: 0,0:26:30.79,0:26:32.21,Default,,0,0,0,,Өлтіретін әдетіңді түзет, ақымақ.
Dialogue: 0,0:26:32.34,0:26:33.17,Default,,0,0,0,,Цк
Dialogue: 0,0:26:33.96,0:26:36.76,Default,,0,0,0,,Сонымен, мен және жаңадан келген Кун қылмыскерлеріміз бе?
Dialogue: 0,0:26:37.01,0:26:39.47,Default,,0,0,0,,Теория бойынша ол шетелге қашып кеткен.
Dialogue: 0,0:26:39.59,0:26:43.56,Default,,0,0,0,,Мақсаты ішкі істерге араласу болса, жау ішкі мекемелерге тығылады.
Dialogue: 0,0:26:43.68,0:26:45.02,Default,,0,0,0,,Бірден қозғалмаңыз
Dialogue: 0,0:26:45.10,0:26:46.14,Default,,0,0,0,,Бұл жағдайда –
Dialogue: 0,0:26:46.27,0:26:50.65,Default,,0,0,0,,Ұлттық қорғаныс сарбаздарын манипуляциялаған және өлтірген үшінші тұлға болды ма?
Dialogue: 0,0:26:50.77,0:26:53.57,Default,,0,0,0,,Біз бір елден емеспіз деп үміттенемін.
Dialogue: 0,0:26:53.69,0:26:55.32,Default,,0,0,0,,Ағайынды өлтіруден шаршадым.
Dialogue: 0,0:26:55.90,0:26:57.69,Default,,0,0,0,,Қатысқан адамдардың фонын тексеріңіз
Dialogue: 0,0:26:57.82,0:27:00.74,Default,,0,0,0,,Ақылсыз шпиондық соғыстарға алаңдамаңыз.
Dialogue: 0,0:27:04.83,0:27:06.75,Default,,0,0,0,,Директордың көмекшісі Фуджимото…
Dialogue: 0,0:27:13.50,0:27:16.25,Default,,0,0,0,,Мен мұнда денеге ДНК сынамасын алу үшін келдім.
Dialogue: 0,0:27:16.67,0:27:20.43,Default,,0,0,0,,Мен әкемді сыртынан тани алмаймын.
Dialogue: 0,0:27:20.88,0:27:23.22,Default,,0,0,0,,Біз кінәлі адамды міндетті түрде табамыз
Dialogue: 0,0:27:24.01,0:27:25.72,Default,,0,0,0,,Өте шатастырып--
Dialogue: 0,0:27:25.85,0:27:29.14,Default,,0,0,0,,Жауап алған соң да кеше болған оқиға есімде жоқ.
Dialogue: 0,0:27:29.23,0:27:31.81,Default,,0,0,0,,Әкеңізбен соңғы рет қандай әңгіме болды?
Dialogue: 0,0:27:32.44,0:27:35.98,Default,,0,0,0,,Менің де майдан даласында тәжірибем бар.
Dialogue: 0,0:27:36.32,0:27:38.94,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:27:39.82,0:27:41.32,Default,,0,0,0,,Барлығы
Dialogue: 0,0:27:41.45,0:27:43.41,Default,,0,0,0,,Мен оны енді ешқашан ұмытпаймын
Dialogue: 0,0:27:48.79,0:27:50.54,Default,,0,0,0,,Әкем өлім аузында.
Dialogue: 0,0:27:50.66,0:27:53.67,Default,,0,0,0,,маған бұйрық берді
Dialogue: 0,0:27:54.21,0:27:57.17,Default,,0,0,0,,Бірақ мені біреу кептеліп қалды.
Dialogue: 0,0:28:01.47,0:28:02.55,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:28:02.68,0:28:05.85,Default,,0,0,0,,Ең соңында әкем маған нені сеніп тапсыруға тырысты?
Dialogue: 0,0:28:05.97,0:28:07.47,Default,,0,0,0,,Мен білгім келеді
Dialogue: 0,0:28:11.39,0:28:13.90,Default,,0,0,0,,О, және... (Мотоко) Ах...
Dialogue: 0,0:28:14.44,0:28:17.07,Default,,0,0,0,,Кешкі асты бірге ішсек ше?
Dialogue: 0,0:28:17.19,0:28:18.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:18.15,0:28:20.86,Default,,0,0,0,,Қарсы болмасаңыз, сізбен тағы сөйлескім келеді.
Dialogue: 0,0:28:22.53,0:28:25.32,Default,,0,0,0,,Мен кіре алатын дүкендер шектеулі.
Dialogue: 0,0:28:34.83,0:28:36.58,Default,,0,0,0,,Мен сені естідім, Ишикава.
Dialogue: 0,0:28:36.71,0:28:38.75,Default,,0,0,0,,А, артқа қарай ал.
Dialogue: 0,0:28:48.68,0:28:50.35,Default,,0,0,0,,Ер адамды да белгілейміз бе?
Dialogue: 0,0:28:50.47,0:28:53.98,Default,,0,0,0,,Қажетсіз ештеңе жасамаңыз, қылмыскердің торын ұстаңыз
Dialogue: 0,0:28:54.10,0:28:57.98,Default,,0,0,0,,Әкең сені ұшырып жіберген күннің ертеңіне әйелге ұнар ма едің?
Dialogue: 0,0:28:58.11,0:28:59.61,Default,,0,0,0,,Ал ол майор, солай ма?
Dialogue: 0,0:28:59.73,0:29:01.53,Default,,0,0,0,,Сізді басынан бастап қызықтырды, солай ма?
Dialogue: 0,0:29:01.65,0:29:02.11,Default,,0,0,0,,Ха~а
Dialogue: 0,0:29:02.11,0:29:03.28,Default,,0,0,0,,Ха~а
Dialogue: 0,0:29:02.11,0:29:03.28,Default,,0,0,0,,Конгрессмен III Бонбонның айналасында...
Dialogue: 0,0:29:03.28,0:29:03.95,Default,,0,0,0,,Конгрессмен III Бонбонның айналасында...
Dialogue: 0,0:29:04.07,0:29:06.20,Default,,0,0,0,,Бұл жоқ түрі шығар (Бату) Хмф.
Dialogue: 0,0:29:06.28,0:29:08.45,Default,,0,0,0,,Оның орнына жұмыс істейік, Сенпай.
Dialogue: 0,0:29:08.58,0:29:10.20,Default,,0,0,0,,Бұл құнды артықшылық.
Dialogue: 0,0:29:23.55,0:29:26.43,Default,,0,0,0,,Мен қозғалып жатқан адамды көргеніме 900 сағат болды.
Dialogue: 0,0:29:27.18,0:29:29.85,Default,,0,0,0,,501 мекемені жекешелендіру туралы естіген едім...
Dialogue: 0,0:29:29.97,0:29:32.43,Default,,0,0,0,,Ұшқышсыз зауыт болу жоспары қандай?
Dialogue: 0,0:29:32.56,0:29:35.06,Default,,0,0,0,,Барлығы Harimadara компаниясына ауыстырылды.
Dialogue: 0,0:29:35.19,0:29:38.10,Default,,0,0,0,,Сіздің талапыңыз қандай? Мүмкін зауытты аралау?
Dialogue: 0,0:29:38.81,0:29:41.61,Default,,0,0,0,,Неліктен Курц сонда болды?
Dialogue: 0,0:29:41.73,0:29:43.49,Default,,0,0,0,,Пайда мен өмір сүру үшін
Dialogue: 0,0:29:43.90,0:29:45.53,Default,,0,0,0,,Елші Ричард пен Премьер-министр...
Dialogue: 0,0:29:45.65,0:29:49.16,Default,,0,0,0,,Протездік дененің тұйық дамуын болдырмауға келісті
Dialogue: 0,0:29:49.28,0:29:51.37,Default,,0,0,0,,Технологияларды жаңартуды әдейі кейінге қалдыру -
Dialogue: 0,0:29:51.49,0:29:54.16,Default,,0,0,0,,Өндіріс желісінің қызмет ету мерзімін ұзарту
Dialogue: 0,0:29:54.29,0:29:56.54,Default,,0,0,0,,Даму тығырықтарын болдырмау үшін -
Dialogue: 0,0:29:56.66,0:29:59.13,Default,,0,0,0,,Үкімет зерттеу бюджетін беріп жатқан жоқ па?
Dialogue: 0,0:29:59.25,0:30:01.84,Default,,0,0,0,,Бұл керісінше. Қазіргі көптеген протездік денелер...
Dialogue: 0,0:30:01.96,0:30:04.42,Default,,0,0,0,,Келесі ұрпақта жаңарту мүмкін болмайды.
Dialogue: 0,0:30:05.26,0:30:08.38,Default,,0,0,0,,Нөл жастағы балаға толық дене протезін салған сіздей емес.
Dialogue: 0,0:30:09.51,0:30:12.31,Default,,0,0,0,,Сіз өсуді ойлай отырып дамығансыз.
Dialogue: 0,0:30:12.43,0:30:15.35,Default,,0,0,0,,Бұл дизайнер доктор Құсанагидің көрегендігі.
Dialogue: 0,0:30:16.02,0:30:18.81,Default,,0,0,0,,Сонымен... сіз мұнда бөлшектер жасайсыз ба?
Dialogue: 0,0:30:18.94,0:30:21.31,Default,,0,0,0,,Бізді тірі қалдыру үшін.
Dialogue: 0,0:30:21.40,0:30:24.53,Default,,0,0,0,,Технологияны сақтау – жеке мүдделерді кеңейту
Dialogue: 0,0:30:24.65,0:30:27.99,Default,,0,0,0,,Технологиялық инновация үлкен акцияларды монополиялауды білдіреді
Dialogue: 0,0:30:28.11,0:30:32.28,Default,,0,0,0,,Курц біріншісіне бәс тігеді және соңғы жүйемен жойылды.
Dialogue: 0,0:30:33.58,0:30:37.16,Default,,0,0,0,,Қылмыскер премьер-министр мен елшіні бір уақытта өлтіруі үшін.
Dialogue: 0,0:30:37.29,0:30:39.62,Default,,0,0,0,,Мотив көп.
Dialogue: 0,0:30:40.63,0:30:42.54,Default,,0,0,0,,Маған хабарлағаныңыз үшін рахмет
Dialogue: 0,0:30:43.21,0:30:45.34,Default,,0,0,0,,Ата-анаңа сәлем айту керек.
Dialogue: 0,0:30:45.46,0:30:46.76,Default,,0,0,0,,Мен мұны қайталаймын
Dialogue: 0,0:30:46.84,0:30:48.47,Default,,0,0,0,,Кез келген уақытта келіңіз
Dialogue: 0,0:30:48.59,0:30:50.68,Default,,0,0,0,,Олар да біз сияқты...
Dialogue: 0,0:30:51.14,0:30:53.05,Default,,0,0,0,,Бұл жерден қозғалма
Dialogue: 0,0:30:56.22,0:30:59.98,Default,,0,0,0,,Коичи Савада бұрынғы армияның броньды дивизиясының сигналдық корпусының қызметкері
Dialogue: 0,0:31:00.10,0:31:02.48,Default,,0,0,0,,Бұл жерде әскери тордың әкімшісі орналасқан ба?
Dialogue: 0,0:31:02.61,0:31:04.19,Default,,0,0,0,,Қылмыскердің компьютерінде қалды.
Dialogue: 0,0:31:04.32,0:31:06.86,Default,,0,0,0,,Егер рұқсат жазбасы сенімді болса
Dialogue: 0,0:31:11.74,0:31:13.07,Default,,0,0,0,,Логикома
Dialogue: 0,0:31:13.20,0:31:15.62,Default,,0,0,0,,Жылулық анықтауды бір адам жасайды.
Dialogue: 0,0:31:16.08,0:31:17.75,Default,,0,0,0,,Ешкім өлген жоқ па?
Dialogue: 0,0:31:17.87,0:31:19.75,Default,,0,0,0,,Барлау жұмыстары жеткіліксіз
Dialogue: 0,0:31:19.87,0:31:22.00,Default,,0,0,0,,Өлген адамдар ештеңе айтпайды
Dialogue: 0,0:31:22.13,0:31:25.59,Default,,0,0,0,,Мені тірі қалдырмасаң, бірінші шаршыға қайтамын.
Dialogue: 0,0:31:25.71,0:31:31.59,Default,,0,0,0,,♪～
Dialogue: 0,0:31:42.69,0:31:44.23,Default,,0,0,0,,Тұтынушы қандай мазалайды.
Dialogue: 0,0:31:46.73,0:31:48.19,Default,,0,0,0,,Есікті жабыңыз.
Dialogue: 0,0:31:49.40,0:31:51.45,Default,,0,0,0,,А...
Dialogue: 0,0:31:51.86,0:31:54.66,Default,,0,0,0,,Сізбен сөйлесуге біреу келуі мүмкін.
Dialogue: 0,0:31:54.78,0:31:56.37,Default,,0,0,0,,Сіз бірдеңе іздеп жүрсіз бе?
Dialogue: 0,0:31:56.45,0:31:59.25,Default,,0,0,0,,Бұл Коичи Савада. Ол арнайы жасақтың мүшесі.
Dialogue: 0,0:31:59.37,0:32:01.46,Default,,0,0,0,,Мен сізден Премьер-министрдің өлтірілуіне қатысты бір нәрсе сұрағым келеді.
Dialogue: 0,0:32:01.46,0:32:02.17,Default,,0,0,0,,Мен сізден Премьер-министрдің өлтірілуіне қатысты бірдеңе сұрағым келеді.
Dialogue: 0,0:32:01.46,0:32:02.17,Default,,0,0,0,,А…?
Dialogue: 0,0:32:02.17,0:32:02.83,Default,,0,0,0,,А…?
Dialogue: 0,0:32:06.84,0:32:08.00,Default,,0,0,0,,Қандай деректер?
Dialogue: 0,0:32:08.13,0:32:10.13,Default,,0,0,0,,Сарбаздардың еркі
Dialogue: 0,0:32:10.26,0:32:12.13,Default,,0,0,0,,Мұрагерлік мүлік жоқ -
Dialogue: 0,0:32:12.26,0:32:15.09,Default,,0,0,0,,Маған соңғы сөздеріңізді жіберіңіз
Dialogue: 0,0:32:15.55,0:32:20.43,Default,,0,0,0,,Өз өмірімді қиғаннан кейін, менің достарым немесе отбасым болмағандықтан...
Dialogue: 0,0:32:20.56,0:32:23.98,Default,,0,0,0,,Оны маған, мен танымайтын кеңсе әкімшісіне автоматты түрде жібермеңіз.
Dialogue: 0,0:32:24.60,0:32:27.40,Default,,0,0,0,,Тым болмаса келіп сөйлес...
Dialogue: 0,0:32:27.52,0:32:29.98,Default,,0,0,0,,Біреу өлді ме?
Dialogue: 0,0:32:30.11,0:32:32.45,Default,,0,0,0,,Мұнда емес, бір жерде.
Dialogue: 0,0:32:33.03,0:32:34.32,Default,,0,0,0,,Мен қайтып келгенше күте тұрыңыз.
Dialogue: 0,0:32:34.45,0:32:36.07,Default,,0,0,0,,Иә
Dialogue: 0,0:32:37.37,0:32:39.58,Default,,0,0,0,,Премьер-министрге қастандық жасау үшін біреу келді ме?
Dialogue: 0,0:32:39.70,0:32:41.00,Default,,0,0,0,,Ешқашан
Dialogue: 0,0:32:41.12,0:32:44.46,Default,,0,0,0,,Елшілікті басып алғандардың өсиеттері бар.
Dialogue: 0,0:32:44.54,0:32:45.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:46.71,0:32:48.34,Default,,0,0,0,,Кім жоқ?
Dialogue: 0,0:32:48.46,0:32:51.34,Default,,0,0,0,,Үлкен тізімді тасымалдау
Dialogue: 0,0:32:51.46,0:32:53.42,Default,,0,0,0,,Бұйрықты кім шығаруы мүмкін?
Dialogue: 0,0:32:53.55,0:32:55.05,Default,,0,0,0,,Қазір...
Dialogue: 0,0:32:55.39,0:32:59.26,Default,,0,0,0,,Әсер ету тұрғысынан бұл армия полковнигі Харуёси Нада.
Dialogue: 0,0:32:59.39,0:33:04.69,Default,,0,0,0,,Ол министрдің орынбасары Китахараның кеңесшісі болған, бірақ оқиғаға дейін жоғалып кеткен.
Dialogue: 0,0:33:06.40,0:33:08.90,Default,,0,0,0,,Ең болмаса келіп сөйлесу керек.
Dialogue: 0,0:33:09.36,0:33:10.94,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:33:11.07,0:33:14.15,Default,,0,0,0,,Өз-өзіне қол жұмсаған адамдардың көпшілігінде толық протездер бар.
Dialogue: 0,0:33:14.24,0:33:18.32,Default,,0,0,0,,Киберстандарттар өзгерді және мен жаңа протездік денемді пайдалана алмаймын.
Dialogue: 0,0:33:18.45,0:33:20.70,Default,,0,0,0,,Тірі кезінде ыдырау
Dialogue: 0,0:33:23.04,0:33:24.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:25.79,0:33:27.96,Default,,0,0,0,,Мен сияқты…
Dialogue: 0,0:33:28.96,0:33:33.97,Default,,0,0,0,,Делдалдық рөл болмағанда, мен де өз-өзімнен құтылар едім.
Dialogue: 0,0:33:37.55,0:33:42.89,Default,,0,0,0,,Компьютер нұсқасын таңдау мен уақыттың өзгеруі арасында сәйкессіздік болды, бірақ соңында...
Dialogue: 0,0:33:44.06,0:33:46.73,Default,,0,0,0,,Бұл протездік трансформацияның аяқталуы.
Dialogue: 0,0:33:51.02,0:33:52.90,Default,,0,0,0,,Өлгендерге не болды?
Dialogue: 0,0:33:53.03,0:33:54.90,Default,,0,0,0,,Мен ештеңе істей алмадым.
Dialogue: 0,0:33:55.03,0:33:59.24,Default,,0,0,0,,Жөндеу мүмкін болмаса, деректерді жинауды және қалпына келтіруді ұсынамыз.
Dialogue: 0,0:33:59.37,0:34:03.12,Default,,0,0,0,,Өлсең, өмірің де, аруағың да қалпына келмейді.
Dialogue: 0,0:34:03.24,0:34:05.46,Default,,0,0,0,,Бұл ыңғайсыз бірлік.
Dialogue: 0,0:34:05.58,0:34:08.54,Default,,0,0,0,,Батоу мырза қайтыс болды ма?
Dialogue: 0,0:34:09.00,0:34:12.71,Default,,0,0,0,,Солай болуы керек еді, бірақ мен толық дене протезін салдым.
Dialogue: 0,0:34:13.21,0:34:15.67,Default,,0,0,0,,Бату мырза майор... құрамында жұмыс істейді.
Dialogue: 0,0:34:15.80,0:34:17.18,Default,,0,0,0,,Өлу?
Dialogue: 0,0:34:17.47,0:34:19.01,Default,,0,0,0,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,0:34:20.01,0:34:21.14,Default,,0,0,0,,Фу…
Dialogue: 0,0:34:21.51,0:34:24.85,Default,,0,0,0,,Мендей жақсы адам оңай өлмейді.
Dialogue: 0,0:34:24.97,0:34:26.10,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:34:26.35,0:34:28.81,Default,,0,0,0,,Иә Әрқашан құнды оқу тәжірибесі -
Dialogue: 0,0:34:28.94,0:34:30.77,Default,,0,0,0,,Рахмет
Dialogue: 0,0:34:33.52,0:34:36.99,Default,,0,0,0,,Сыртқы істер министрлігі арқылы сұрау
Dialogue: 0,0:34:37.07,0:34:41.45,Default,,0,0,0,,Біз құрбандармыз. Біз кінәлінің әскери мәртебесін алып тастауына жол бермейміз.
Dialogue: 0,0:34:42.12,0:34:44.91,Default,,0,0,0,,Үкіметтен өтемақы талап ету
Dialogue: 0,0:34:47.83,0:34:49.92,Default,,0,0,0,,Қандай қиын жәбірленуші.
Dialogue: 0,0:34:50.04,0:34:52.92,Default,,0,0,0,,Роберт Ли, Қиыр Шығыс сауда департаментінің өкілі…
Dialogue: 0,0:34:53.04,0:34:55.34,Default,,0,0,0,,Ол атышулы жөндеуші.
Dialogue: 0,0:34:55.42,0:34:58.80,Default,,0,0,0,,Бір кездері ол Америка Құрама Штаттарының өтініші бойынша елден шығарыла жаздады, бірақ...
Dialogue: 0,0:34:58.93,0:35:01.55,Default,,0,0,0,,Көріп отырғаныңыздай, мен оны ақылмен жеңдім.
Dialogue: 0,0:35:01.68,0:35:05.31,Default,,0,0,0,,Бізге тағы да шабуыл жасалуы мүмкін болса да, жақсы батылдық.
Dialogue: 0,0:35:05.43,0:35:08.27,Default,,0,0,0,,Ашық болса, көптеген қолайсыздықтар болуы мүмкін.
Dialogue: 0,0:35:08.94,0:35:11.65,Default,,0,0,0,,Премьер-министрдің жасырын отырысын кім ұйымдастырды?
Dialogue: 0,0:35:11.77,0:35:13.65,Default,,0,0,0,,Мен білгім келеді
Dialogue: 0,0:35:14.11,0:35:17.03,Default,,0,0,0,,Кездесу өтетін орынды кім жария еткен болуы мүмкін?
Dialogue: 0,0:35:17.44,0:35:21.41,Default,,0,0,0,,Майорға бірлескен тергеу әрқашан құпталатынын хабарлаңыз.
Dialogue: 0,0:35:22.41,0:35:25.28,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:35:40.42,0:35:45.60,Default,,0,0,0,,Компьютерлер мен протездік денелер сияқты, компаниялар үшін стандарттар шекара болып табылады.
Dialogue: 0,0:35:45.72,0:35:48.22,Default,,0,0,0,,Ұлттық шекаралар айырмашылықтарды тудыратындықтан...
Dialogue: 0,0:35:48.35,0:35:50.77,Default,,0,0,0,,Ешбір ел өз шекарасын тастамайды
Dialogue: 0,0:35:50.85,0:35:52.56,Default,,0,0,0,,Подполковник Курц және мен...
Dialogue: 0,0:35:52.69,0:35:55.86,Default,,0,0,0,,Келесі дәуірге жол іздеу
Dialogue: 0,0:35:55.98,0:35:59.19,Default,,0,0,0,,Трансшекаралық жүйеде не тиімді болды?
Dialogue: 0,0:35:59.32,0:36:02.66,Default,,0,0,0,,Сіз ше? Директордың орынбасары Амагата
Dialogue: 0,0:36:02.78,0:36:04.41,Default,,0,0,0,,Бұрынғы кеңесші
Dialogue: 0,0:36:04.70,0:36:06.37,Default,,0,0,0,,Маған да подполковник айтты
Dialogue: 0,0:36:06.49,0:36:07.91,Default,,0,0,0,,Бір күні кибер желі болады...
Dialogue: 0,0:36:08.04,0:36:10.91,Default,,0,0,0,,Мен тіпті корпоративтік шекараны кесіп өтетін күннің келетініне сенемін.
Dialogue: 0,0:36:11.79,0:36:14.29,Default,,0,0,0,,Бұл алыс болашақ туралы.
Dialogue: 0,0:36:14.42,0:36:19.09,Default,,0,0,0,,Өзіңізге қауіп төніп тұр деп ойласаңыз, қорғауды және бақылауды ұсынамыз.
Dialogue: 0,0:36:19.84,0:36:21.26,Default,,0,0,0,,Бұл оған жақындамайды.
Dialogue: 0,0:36:21.97,0:36:25.39,Default,,0,0,0,,Сіздің бұрынғы әріптестеріңіз біздің компанияны қорғайды.
Dialogue: 0,0:36:33.39,0:36:34.69,Default,,0,0,0,,Майор
Dialogue: 0,0:36:34.81,0:36:36.11,Default,,0,0,0,,Сіз қандай да бір ақпарат алдыңыз ба?
Dialogue: 0,0:36:36.31,0:36:38.02,Default,,0,0,0,,Кептелу әлі де мәселе.
Dialogue: 0,0:36:38.15,0:36:41.65,Default,,0,0,0,,Оның орнына біз командир Курцтың деректер тасымалдауын анықтадық.
Dialogue: 0,0:36:41.78,0:36:45.20,Default,,0,0,0,,Жарылыстан кейін бір минуттан кейін сырттан автоматты беріліс.
Dialogue: 0,0:36:45.32,0:36:48.53,Default,,0,0,0,,Бұл әскери тордан өсиет емес, бұл басқа нысан.
Dialogue: 0,0:36:48.62,0:36:51.37,Default,,0,0,0,,Маған мекен-жайыңды жібер, мен келемін.
Dialogue: 0,0:37:03.76,0:37:08.05,Default,,0,0,0,,501 Барлық қозғалтқыш қызметкерлері компанияның қызметкерлері ме?
Dialogue: 0,0:37:08.14,0:37:10.26,Default,,0,0,0,,Әлде зерттеу материалы ма?
Dialogue: 0,0:37:10.39,0:37:13.02,Default,,0,0,0,,Қолымды ал, Құсанағы.
Dialogue: 0,0:37:13.14,0:37:14.64,Default,,0,0,0,,Нұсқаушы Ибачи…
Dialogue: 0,0:37:14.73,0:37:17.10,Default,,0,0,0,,Курцтың ісі біздің жауапкершілігіміз.
Dialogue: 0,0:37:17.23,0:37:19.65,Default,,0,0,0,,Маған бұдан әрі тиіспе.
Dialogue: 0,0:37:19.77,0:37:21.40,Default,,0,0,0,,Даму агенттігі жоқ -
Dialogue: 0,0:37:21.53,0:37:24.32,Default,,0,0,0,,Өзін-өзі жетілдіруді қайталайтын шеттетілген адам
Dialogue: 0,0:37:24.99,0:37:28.78,Default,,0,0,0,,Қажетсіз бірдеңе жасасаң, бұл жолы сенен құтыламын.
Dialogue: 0,0:37:40.71,0:37:43.80,Default,,0,0,0,,Харимадара корпорациясының бұрынғы 501 инженер мүшесі ретінде белгіленген.
Dialogue: 0,0:37:43.92,0:37:45.34,Default,,0,0,0,,Тергеуге кедергі жасаудан сақ болыңыз
Dialogue: 0,0:37:45.47,0:37:48.76,Default,,0,0,0,,Түсінді. Мен олардың есесін қайтарғысы келетініне сенімдімін.
Dialogue: 0,0:37:49.47,0:37:53.02,Default,,0,0,0,,Тұйық шешім, бірақ мемлекеттік құжаттарда кездеседі
Dialogue: 0,0:37:53.14,0:37:54.43,Default,,0,0,0,,20 жылдан астам уақыт бұрын -
Dialogue: 0,0:37:54.56,0:37:57.19,Default,,0,0,0,,Дәл сол ұлттық саясат жүзеге асырылған жағдайға байланысты -
Dialogue: 0,0:37:57.31,0:37:59.27,Default,,0,0,0,,Қауіпсіздік жоспары бар.
Dialogue: 0,0:37:59.40,0:38:01.27,Default,,0,0,0,,Қауіпсіздік? Не болды?
Dialogue: 0,0:38:01.36,0:38:03.53,Default,,0,0,0,,Хабарсыз кеткендер шеруі.
Dialogue: 0,0:38:03.65,0:38:07.03,Default,,0,0,0,,Жетекші денені протездеу бойынша дәрігер және оның жүкті әйелі болды.
Dialogue: 0,0:38:07.11,0:38:10.87,Default,,0,0,0,,Соңғы белгілі орын химиялық қару апатының орны болған сияқты.
Dialogue: 0,0:38:15.37,0:38:19.04,Default,,0,0,0,,Денені зерттеу үшін кейбір мекеме сақтайды...
Dialogue: 0,0:38:19.71,0:38:21.54,Default,,0,0,0,,Тыңдап тұрсың ба? Майор (Мотоко) ха!
Dialogue: 0,0:38:24.09,0:38:26.55,Default,,0,0,0,,Менің AI-ға деректерді талдауға рұқсат етіңіз
Dialogue: 0,0:38:26.67,0:38:29.09,Default,,0,0,0,,Ағымдағы оқиғамен байланысты тексеріңіз
Dialogue: 0,0:38:38.06,0:38:40.31,Default,,0,0,0,,Сіздің байланысыңыз өзгерген сияқты.
Dialogue: 0,0:38:43.61,0:38:46.78,Default,,0,0,0,,Соңғы уақытта әскери емес компанияларға бару көбейіп келеді.
Dialogue: 0,0:38:46.90,0:38:49.86,Default,,0,0,0,,Біз өсіретін адам ресурстарының ауқымы да кеңейді.
Dialogue: 0,0:38:49.99,0:38:51.99,Default,,0,0,0,,Бұл компаниялар үшін жақсы сатып алу ма?
Dialogue: 0,0:38:52.45,0:38:54.95,Default,,0,0,0,,Бұл біздің балаларымызға болашақты уәде ете алатынымызды білдіреді.
Dialogue: 0,0:38:59.04,0:39:00.50,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:39:04.80,0:39:08.55,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:39:08.67,0:39:10.01,Default,,0,0,0,,Сәлем
Dialogue: 0,0:39:10.09,0:39:13.30,Default,,0,0,0,,Сәлеметсіз бе, сіздің атыңыз кім?
Dialogue: 0,0:39:13.43,0:39:14.81,Default,,0,0,0,,Крис
Dialogue: 0,0:39:14.93,0:39:16.93,Default,,0,0,0,,Мен Мотоко Кусанагимін
Dialogue: 0,0:39:17.06,0:39:18.73,Default,,0,0,0,,Мен мұнда баяғыда болдым.
Dialogue: 0,0:39:19.69,0:39:21.69,Default,,0,0,0,,Сіз ностальгияны сезінесіз бе?
Dialogue: 0,0:39:21.77,0:39:25.48,Default,,0,0,0,,Иә, көп нәрсе есімде.
Dialogue: 0,0:39:25.94,0:39:27.32,Default,,0,0,0,,Сіз Курцты білесіз бе?
Dialogue: 0,0:39:27.44,0:39:28.90,Default,,0,0,0,,Барлығы біледі
Dialogue: 0,0:39:29.28,0:39:31.99,Default,,0,0,0,,Мұндағы балалардың болашағын жасайтын адам
Dialogue: 0,0:39:32.11,0:39:33.91,Default,,0,0,0,,Бірақ мен өлдім
Dialogue: 0,0:39:35.16,0:39:37.20,Default,,0,0,0,,Хабарламаны бөлісе аламын ба?
Dialogue: 0,0:39:37.33,0:39:38.45,Default,,0,0,0,,Иә
Dialogue: 0,0:39:48.42,0:39:51.05,Default,,0,0,0,,Бұны көріп отырғаныңыз...
Dialogue: 0,0:39:51.18,0:39:54.47,Default,,0,0,0,,Бұл менің енді бұл дүниеде жоқ екенімді білдіреді.
Dialogue: 0,0:39:55.85,0:39:59.43,Default,,0,0,0,,Сізге сеніп тапсырылған құқықтарға, мүлікке және міндеттерге қатысты--
Dialogue: 0,0:39:59.56,0:40:01.98,Default,,0,0,0,,Өз интернетіңізді тексеріңіз.
Dialogue: 0,0:40:02.69,0:40:05.27,Default,,0,0,0,,Белгісіз болса да болашақ бар.
Dialogue: 0,0:40:05.40,0:40:09.49,Default,,0,0,0,,Егер сіз үшінші әлемге сенсеңіз, біз бір күні тағы кездесеміз.
Dialogue: 0,0:40:11.03,0:40:12.78,Default,,0,0,0,,Үшінші әлем?
Dialogue: 0,0:40:14.37,0:40:17.12,Default,,0,0,0,,Адамға да, физикалық та емес деректер әлемі
Dialogue: 0,0:40:17.45,0:40:19.75,Default,,0,0,0,,Егер сіз бұдан былай протездік денеңізді ауыстыра алмасаңыз...
Dialogue: 0,0:40:19.83,0:40:22.21,Default,,0,0,0,,Мен енді өмір сүре алмасам да...
Dialogue: 0,0:40:22.33,0:40:26.09,Default,,0,0,0,,Сіз баруға болатын жерлер бар деп ойлайсыз ба?
Dialogue: 0,0:40:27.96,0:40:30.05,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:40:30.42,0:40:32.30,Default,,0,0,0,,Бұл жалғыз хабарлама ма?
Dialogue: 0,0:40:32.43,0:40:33.26,Default,,0,0,0,,Иә
Dialogue: 0,0:40:35.68,0:40:36.72,Default,,0,0,0,,Біз тағы кездесеміз бе?
Dialogue: 0,0:40:38.10,0:40:39.01,Default,,0,0,0,,Иә
Dialogue: 0,0:40:39.81,0:40:42.77,Default,,0,0,0,,Иә, тағы кездескенше.
Dialogue: 0,0:40:51.94,0:40:53.74,Default,,0,0,0,,Йотто (Мотоко) Біз не үшін кездесіп, сөйлесеміз?
Dialogue: 0,0:40:53.86,0:40:56.37,Default,,0,0,0,,Менің киберлоббимде филиалдар болады деп ойлайсыз ба?
Dialogue: 0,0:40:56.49,0:41:00.66,Default,,0,0,0,,Жоқ... компьютерде емес, тамақ ішіп отырып сөйлесеміз...
Dialogue: 0,0:41:00.79,0:41:01.75,Default,,0,0,0,,Бұл маңызды емес пе?
Dialogue: 0,0:41:02.00,0:41:03.54,Default,,0,0,0,,Бұл жамандықтың белгісі сияқты
Dialogue: 0,0:41:03.66,0:41:05.25,Default,,0,0,0,,Бірыңғай стандарттар тобына -
Dialogue: 0,0:41:05.37,0:41:08.88,Default,,0,0,0,,Бұл жігітті тәнге қосуға батыл сен едің.
Dialogue: 0,0:41:15.43,0:41:18.89,Default,,0,0,0,,Сіз шынымен роботсыз ба деп уайымдаймын.
Dialogue: 0,0:41:19.01,0:41:20.43,Default,,0,0,0,,Жаңадан келген адам...
Dialogue: 0,0:41:20.56,0:41:22.10,Default,,0,0,0,,Көп айтпа.
Dialogue: 0,0:41:22.22,0:41:24.14,Default,,0,0,0,,Маған тек түсіністік пен сенім керек...
Dialogue: 0,0:41:24.27,0:41:26.15,Default,,0,0,0,,Демалыс жоқ, ойын жоқ
Dialogue: 0,0:41:26.27,0:41:29.69,Default,,0,0,0,,Көктем болса да, менің жұмыс орнымда шие гүлін көруге болмайды.
Dialogue: 0,0:41:29.77,0:41:30.90,Default,,0,0,0,,Маған айтпа
Dialogue: 0,0:41:34.20,0:41:35.11,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:41:35.24,0:41:37.28,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:41:43.12,0:41:44.71,Default,,0,0,0,,Мм... Мен ұлттық қорғаныс жанкүйерімін...
Dialogue: 0,0:41:45.33,0:41:49.08,Default,,0,0,0,,11 қылмыскер, полковник Нада және жоғалған 7 адам...
Dialogue: 0,0:41:49.21,0:41:51.71,Default,,0,0,0,,Дәл осындай мәтіні бар суицид туралы жазба таратылды
Dialogue: 0,0:41:51.84,0:41:53.30,Default,,0,0,0,,Барлығы жасырынған-
Dialogue: 0,0:41:53.42,0:41:56.68,Default,,0,0,0,,Келесі әрекетті орындау мүмкіндігі жоғары.
Dialogue: 0,0:41:57.01,0:42:00.64,Default,,0,0,0,,-де полковник Наданың өсиетінде біртүрлі сөйлем болды.
Dialogue: 0,0:42:00.89,0:42:04.60,Default,,0,0,0,,«Үшінші әлемнен сыйлық алды»
Dialogue: 0,0:42:04.68,0:42:06.06,Default,,0,0,0,,Полковник вирусты таратқан...
Dialogue: 0,0:42:06.19,0:42:08.81,Default,,0,0,0,,Брокерден алынған деген мағынада...
Dialogue: 0,0:42:08.94,0:42:10.61,Default,,0,0,0,,Жоқ... бұл біртүрлі.
Dialogue: 0,0:42:10.73,0:42:11.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:17.32,0:42:20.16,Default,,0,0,0,,Үшінші дүние... оккульттік әңгімелер?
Dialogue: 0,0:42:20.28,0:42:22.03,Default,,0,0,0,,Қорғаныс министрлігі және байланысты компаниялар -
Dialogue: 0,0:42:22.16,0:42:24.58,Default,,0,0,0,,Осы сөз тіркесін басқа біреу қолданатынын қараңыз.
Dialogue: 0,0:42:24.70,0:42:27.04,Default,,0,0,0,,Шүкір, адам санын көбейт.
Dialogue: 0,0:42:27.16,0:42:29.00,Default,,0,0,0,,Ең жақсы бөлшектер ғана қол жетімді болса
Dialogue: 0,0:42:29.12,0:42:30.83,Default,,0,0,0,,Сіз мені қайтадан бөліктер деп атайсыз ба?
Dialogue: 0,0:42:30.96,0:42:32.13,Default,,0,0,0,,Ей!!
Dialogue: 0,0:42:32.25,0:42:33.92,Default,,0,0,0,,Жаңағы жігіт осылай деді.
Dialogue: 0,0:42:34.05,0:42:36.88,Default,,0,0,0,,Ол адамдарды бірдеңе деп атайтын ең нашар капитан.
Dialogue: 0,0:42:37.01,0:42:39.51,Default,,0,0,0,,А... Мен онша көп айтқан жоқпын!
Dialogue: 0,0:42:39.64,0:42:41.18,Default,,0,0,0,,Баяндама, майор.
Dialogue: 0,0:42:41.26,0:42:44.10,Default,,0,0,0,,Тәркіленген мылтық пен оқиға орнындағы іздер бойынша...
Dialogue: 0,0:42:44.22,0:42:45.93,Default,,0,0,0,,Снайпер - RMC
Dialogue: 0,0:42:46.06,0:42:48.64,Default,,0,0,0,,Ол мені адам емес, қашықтан автоматпен атып тастады.
Dialogue: 0,0:42:48.73,0:42:52.57,Default,,0,0,0,,Снайперге вирус, протездік денені бір өзі қашықтан басқару?
Dialogue: 0,0:42:52.69,0:42:55.61,Default,,0,0,0,,Мамандықпен бір типте болудан гөрі, ол мамандықтың өзіне көбірек ұқсайды.
Dialogue: 0,0:42:55.94,0:42:58.20,Default,,0,0,0,,Мен барған сайын өлтіру ниетін сезінемін.
Dialogue: 0,0:42:58.32,0:43:02.53,Default,,0,0,0,,Сондай-ақ, мен бұрыннан бері құмарлықпен қарауды сезіндім.
Dialogue: 0,0:43:02.62,0:43:03.99,Default,,0,0,0,,Қандай кездейсоқтық.
Dialogue: 0,0:43:05.12,0:43:06.45,Default,,0,0,0,,Ха-ха-ха-ха! Бұл дәл сен сияқты, Лабраба.
Dialogue: 0,0:43:11.67,0:43:13.34,Default,,0,0,0,,Іс жүзінде бұл да
Dialogue: 0,0:43:13.46,0:43:14.96,Default,,0,0,0,,Сіз 9-бөлімнің маймыл менеджерісіз бе?
Dialogue: 0,0:43:15.09,0:43:17.09,Default,,0,0,0,,Жоқ, бұл басқаша сезіледі.
Dialogue: 0,0:43:17.17,0:43:19.84,Default,,0,0,0,,Мен байланысты болып көрінетін нәрсені таптым.
Dialogue: 0,0:43:19.97,0:43:23.05,Default,,0,0,0,,Менің вестибюльге кіріңіз, мен сізге бір қызық көрсетемін.
Dialogue: 0,0:43:26.27,0:43:27.98,Default,,0,0,0,,Маған не көрсеткіңіз келеді?
Dialogue: 0,0:43:28.18,0:43:33.15,Default,,0,0,0,,Жарылыс салдарынан объектілердің қозғалысы сот-медициналық тінтулер негізінде қайта шығарылды.
Dialogue: 0,0:43:35.94,0:43:39.32,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:43:51.33,0:43:53.38,Default,,0,0,0,,Пиро кері өлшеу
Dialogue: 0,0:43:53.50,0:43:55.75,Default,,0,0,0,,Жарылысты кері қайталау
Dialogue: 0,0:43:56.21,0:43:57.71,Default,,0,0,0,,Керемет
Dialogue: 0,0:44:13.56,0:44:16.36,Default,,0,0,0,,Бомба бар корпуста саусақ ізінің аутентификация түрі бар.
Dialogue: 0,0:44:16.48,0:44:18.40,Default,,0,0,0,,Тек Премьер-Министр мен оның жақын көмекшілері аша алады
Dialogue: 0,0:44:24.37,0:44:25.66,Default,,0,0,0,,Бақылау камерасы?
Dialogue: 0,0:44:25.78,0:44:28.33,Default,,0,0,0,,Әскери, бірақ тарату ауқымы шектеулі
Dialogue: 0,0:44:28.45,0:44:30.75,Default,,0,0,0,,Мен кездейсоқ шуды сынақ ретінде жібердім
Dialogue: 0,0:44:31.21,0:44:34.58,Default,,0,0,0,,Бұл AI-ге қалдырылған шағын шифрланған жол.
Dialogue: 0,0:44:34.71,0:44:36.71,Default,,0,0,0,,Қарап тұрған бейбақтың торына қосылдым.
Dialogue: 0,0:44:37.63,0:44:38.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:40.38,0:44:41.59,Default,,0,0,0,,Ах, уау!
Dialogue: 0,0:44:41.67,0:44:44.05,Default,,0,0,0,,Ой, иә...
Dialogue: 0,0:44:44.13,0:44:45.72,Default,,0,0,0,,Өзіңіздің атыңызды және атыңызды көрсетіңіз.
Dialogue: 0,0:44:45.84,0:44:49.01,Default,,0,0,0,,Менің өлтірген адамым мені атқысы келеді.
Dialogue: 0,0:44:57.61,0:44:58.82,Default,,0,0,0,,О? Апыр-ай!
Dialogue: 0,0:44:59.53,0:45:00.78,Default,,0,0,0,,Уау...
Dialogue: 0,0:45:01.19,0:45:05.20,Default,,0,0,0,,Уф... Шартты талқылау бөлімі D бөлімі. Сұраңыз!
Dialogue: 0,0:45:06.28,0:45:08.16,Default,,0,0,0,,Мен қоғамдық қауіпсіздік үшін Сыртқы істер министрлігіне жіберілдім.
Dialogue: 0,0:45:08.28,0:45:10.20,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:45:10.62,0:45:14.12,Default,,0,0,0,,Сіз Премьер-Министрдің жасырын отырысына қатысасыз ба?
Dialogue: 0,0:45:23.17,0:45:24.72,Default,,0,0,0,,Уау, аа...
Dialogue: 0,0:45:24.84,0:45:25.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:26.09,0:45:26.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:45:30.22,0:45:32.72,Default,,0,0,0,,Бұл Акияма, Шарттарды талқылау бөлімінің бөлім жетекшісі.
Dialogue: 0,0:45:32.98,0:45:34.69,Default,,0,0,0,,Қысқаша түсіндіріңіз
Dialogue: 0,0:45:35.81,0:45:38.15,Default,,0,0,0,,Мен оны бір ай бұрын ұстадым
Dialogue: 0,0:45:38.44,0:45:41.69,Default,,0,0,0,,Миды жуу Елес шабуылы Жалған есте сақтау
Dialogue: 0,0:45:41.82,0:45:44.90,Default,,0,0,0,,Іске асыру мүмкін емес деп саналатын үш пакеттік вирус...
Dialogue: 0,0:45:45.03,0:45:46.91,Default,,0,0,0,,Өрт сөндіру құралының сатушысы
Dialogue: 0,0:45:47.03,0:45:49.62,Default,,0,0,0,,Өзін вируспен бірдей атайтын ессіз жігіт.
Dialogue: 0,0:45:50.24,0:45:53.54,Default,,0,0,0,,Вирус жұқтырмақ болған кезде маған жақындап, зорлады.
Dialogue: 0,0:45:53.66,0:45:56.54,Default,,0,0,0,,-де олар мені сол протездік денеде бақылауға алды.
Dialogue: 0,0:45:56.67,0:45:57.83,Default,,0,0,0,,Сіз сайқымазақсыз.
Dialogue: 0,0:45:58.04,0:46:00.50,Default,,0,0,0,,Сіз супер сиқыршы хакерсіз.
Dialogue: 0,0:46:00.63,0:46:02.55,Default,,0,0,0,,Күмәнданбаған дұрыс
Dialogue: 0,0:46:05.51,0:46:06.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:46:07.55,0:46:10.14,Default,,0,0,0,,Екі офицер айла-шарғы жасады.
Dialogue: 0,0:46:10.26,0:46:11.22,Default,,0,0,0,,Офицер?
Dialogue: 0,0:46:11.35,0:46:14.48,Default,,0,0,0,,Премьер-Министрдің алдын ала белгілеген саясатын жүзеге асырудағы әріптес.
Dialogue: 0,0:46:14.56,0:46:17.02,Default,,0,0,0,,Біреуі полковник Харуёси Нада.
Dialogue: 0,0:46:17.14,0:46:19.15,Default,,0,0,0,,Оқиғаға дейін жоғалып кеткен полковник пе?
Dialogue: 0,0:46:19.23,0:46:20.40,Default,,0,0,0,,Оның рөлі -
Dialogue: 0,0:46:20.52,0:46:23.82,Default,,0,0,0,,Бұл ұлттық қорғаныс тобының радикалды элементтерін оқшаулау болды.
Dialogue: 0,0:46:23.94,0:46:27.70,Default,,0,0,0,,Бірақ кенеттен олар екі жақта да бір уақытта лаңкестік шабуыл жасаудың триггерін тартып алды.
Dialogue: 0,0:46:27.82,0:46:29.95,Default,,0,0,0,,Мен оның мінезі өзгерді деп ойлаймын.
Dialogue: 0,0:46:30.07,0:46:32.45,Default,,0,0,0,,Вирус жұқтырған
Dialogue: 0,0:46:32.58,0:46:34.62,Default,,0,0,0,,Брокер соншалықты көп істеуі керек пе?
Dialogue: 0,0:46:34.91,0:46:38.50,Default,,0,0,0,,Премьер-министрдің жауы вирусты қымбат бағаға сатып алды.
Dialogue: 0,0:46:38.62,0:46:42.63,Default,,0,0,0,,Мен олардың шынайы тұлғасын ашып, оларды және олардың брокерлерін бақылауға алғым келеді.
Dialogue: 0,0:46:43.21,0:46:44.96,Default,,0,0,0,,Басқа офицер ше?
Dialogue: 0,0:46:45.84,0:46:47.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:46:48.59,0:46:52.22,Default,,0,0,0,,Қорғаныс министрлігі Йоко Китахара, министрдің орынбасары
Dialogue: 0,0:46:55.02,0:46:57.10,Default,,0,0,0,,А... Не айтып тұрсың?
Dialogue: 0,0:47:01.90,0:47:04.73,Default,,0,0,0,,Қозғалмаңыз! Ұйымды елемейтін масқара!
Dialogue: 0,0:47:05.11,0:47:07.44,Default,,0,0,0,,Сіз заңсыз тергеу жүргізді деген күдікпен қамауға алынады!
Dialogue: 0,0:47:07.53,0:47:09.28,Default,,0,0,0,,Йосанка
Dialogue: 0,0:47:12.45,0:47:15.33,Default,,0,0,0,,Мен мұндайды күтпедім...
Dialogue: 0,0:47:16.29,0:47:18.04,Default,,0,0,0,,Тыңдап көрейік
Dialogue: 0,0:47:21.92,0:47:25.96,Default,,0,0,0,,Полковник Нада жұқтырған, бұл ұлттық қорғаныс фракциясының жарылуына әкелді.
Dialogue: 0,0:47:26.51,0:47:31.59,Default,,0,0,0,,Қорғаныс агенттігінің рейтингін төмендету және мыңдаған сарбаздарды жұмыстан шығару үшін қоғамдық пікірді манипуляциялау...
Dialogue: 0,0:47:32.01,0:47:34.47,Default,,0,0,0,,Премьер-министрді өлтіруге сіздің қатысыңыз туралы не айтасыз?
Dialogue: 0,0:47:34.60,0:47:36.14,Default,,0,0,0,,Қазіргі уақытта жоқ.
Dialogue: 0,0:47:36.68,0:47:38.60,Default,,0,0,0,,Премьер-министрді өлтіргені үшін-
Dialogue: 0,0:47:38.73,0:47:42.56,Default,,0,0,0,,Қорғаныс министрлігі мен Сыртқы істер министрлігінің орталық күштері пайдаланылды ма?
Dialogue: 0,0:47:42.65,0:47:45.07,Default,,0,0,0,,Вирустың өзі табылмады
Dialogue: 0,0:47:45.19,0:47:47.36,Default,,0,0,0,,Егер бұл әйелдің жұмысы болса...
Dialogue: 0,0:47:47.48,0:47:50.49,Default,,0,0,0,,Кибербұзушылық сатысынан анықталған
Dialogue: 0,0:47:50.61,0:47:52.74,Default,,0,0,0,,Жәбірленушінің хабардар болуы да бар.
Dialogue: 0,0:47:52.86,0:47:55.87,Default,,0,0,0,,Мен жазған және өзім орындаған хореография кімге тиесілі?
Dialogue: 0,0:47:55.99,0:47:57.12,Default,,0,0,0,,Не…
Dialogue: 0,0:47:57.24,0:47:59.04,Default,,0,0,0,,Ол 9-бөлімде жоқ.
Dialogue: 0,0:47:59.54,0:48:02.08,Default,,0,0,0,,Бұл Кувабара, барлау департаментінің стратегиялық кеңсесінің басшысы.
Dialogue: 0,0:48:02.21,0:48:04.79,Default,,0,0,0,,Мен сен сияқты екі брокерді қуып келемін.
Dialogue: 0,0:48:04.88,0:48:05.71,Default,,0,0,0,,Арамаки!
Dialogue: 0,0:48:05.84,0:48:08.76,Default,,0,0,0,,Басқаша айтқанда, барлау департаменті кеңесу бөлімінен асып түседі...
Dialogue: 0,0:48:08.88,0:48:10.55,Default,,0,0,0,,Вирусты сатып алған ұйым?
Dialogue: 0,0:48:11.30,0:48:13.51,Default,,0,0,0,,Мен кеңесу кеңесі туралы білмеймін.
Dialogue: 0,0:48:13.64,0:48:18.22,Default,,0,0,0,,Сатып алу қамауға алудың жалған сылтауы болды және ол вирусты басып алғанға дейін қашып құтыла алды.
Dialogue: 0,0:48:18.31,0:48:20.68,Default,,0,0,0,,Мен оны қалдырамын.
Dialogue: 0,0:48:21.27,0:48:24.52,Default,,0,0,0,,Қазір барлық қызметкерлердің ынтымақтастығы маңызды.
Dialogue: 0,0:48:24.65,0:48:27.44,Default,,0,0,0,,Мықты болып, бізге қосылыңыз, майор.
Dialogue: 0,0:48:30.32,0:48:33.28,Default,,0,0,0,,Куәгерлерді өзін-өзі қорғау үшін қамтамасыз ететін ұйым...
Dialogue: 0,0:48:33.41,0:48:35.32,Default,,0,0,0,,Оны кінәлімен бірге соттау керек.
Dialogue: 0,0:48:35.45,0:48:37.87,Default,,0,0,0,,Бұл бастапқы тәуелсіз блок!
Dialogue: 0,0:48:37.99,0:48:40.62,Default,,0,0,0,,Мен ішке кірсем, мен сені шақырамын.
Dialogue: 0,0:48:40.75,0:48:43.46,Default,,0,0,0,,Жұмысым біткен соң жұмыс істеуге рұқсат етемін.
Dialogue: 0,0:48:43.87,0:48:46.00,Default,,0,0,0,,(Тодорокидің жылауы)
Dialogue: 0,0:48:53.13,0:48:56.43,Default,,0,0,0,,Жоғарыда аталған бөлім министрдің орынбасары Китахараға жетті.
Dialogue: 0,0:48:56.55,0:48:57.93,Default,,0,0,0,,Өрт сөндіру құрылғысы
Dialogue: 0,0:48:58.43,0:49:01.89,Default,,0,0,0,,Сіз өзіңіздің вирусыңызбен әлсіреген адамдарды басып ала алмайсыз ба?
Dialogue: 0,0:49:01.98,0:49:03.77,Default,,0,0,0,,Асықпаудың қажеті жоқ
Dialogue: 0,0:49:03.89,0:49:06.36,Default,,0,0,0,,Кеңес беру бөлімі де, барлау бөлімі де олардың қолында.
Dialogue: 0,0:49:06.81,0:49:10.32,Default,,0,0,0,,Ақиқат – ең үлкен тұзақ пен трагедия.
Dialogue: 0,0:49:10.40,0:49:14.49,Default,,0,0,0,,Ұлтқа деген адалдықты жай ғана пайдалану жеткіліксіз.
Dialogue: 0,0:49:14.61,0:49:17.78,Default,,0,0,0,,Бізбен байланысу мүмкіндігін жою керек.
Dialogue: 0,0:49:18.24,0:49:20.49,Default,,0,0,0,,Мен саған жақсы сыйлық беремін.
Dialogue: 0,0:49:20.58,0:49:26.58,Default,,0,0,0,,♪～
Dialogue: 0,0:49:41.72,0:49:43.39,Default,,0,0,0,,Мотоко Кусанаги…
Dialogue: 0,0:49:43.52,0:49:46.65,Default,,0,0,0,,Мен сенің атыңды қашан алып тастаймын?
Dialogue: 0,0:49:50.52,0:49:52.82,Default,,0,0,0,,Террористік бомбалаушы шабуыл жасаған премьер-министр Фухимото...
Dialogue: 0,0:49:52.94,0:49:55.61,Default,,0,0,0,,Қандай да бір бұйрық шығарылғаны анық.
Dialogue: 0,0:49:55.74,0:49:58.16,Default,,0,0,0,,Ал сол жерден қосылатын жалғыз сызық...
Dialogue: 0,0:49:58.28,0:50:00.99,Default,,0,0,0,,Министрдің орынбасары Китахараның естелігінен ойға келгені...
Dialogue: 0,0:50:01.12,0:50:04.50,Default,,0,0,0,,Ниихама жағалауында ұлты белгісіз елес кеме.
Dialogue: 0,0:50:04.58,0:50:06.87,Default,,0,0,0,,Полковник Наданың жасырынуы...
Dialogue: 0,0:50:07.00,0:50:09.21,Default,,0,0,0,,...Алайда барлау бөлімінде қозғалыс жоқ.
Dialogue: 0,0:50:09.33,0:50:12.96,Default,,0,0,0,,Кеңес айтқандай полковник де ластанған болса...
Dialogue: 0,0:50:13.63,0:50:16.43,Default,,0,0,0,,Бұл тұзақ шығар.
Dialogue: 0,0:50:17.38,0:50:21.22,Default,,0,0,0,,Кеме ояту және су асты кабелін жинақтау нүктелері сәйкес келеді
Dialogue: 0,0:50:21.35,0:50:22.93,Default,,0,0,0,,Ақпарат жинайтын кеме болуы мүмкін
Dialogue: 0,0:50:23.47,0:50:25.56,Default,,0,0,0,,Министрдің орынбасарын барлау бөлімінен жоғалтқаным үшін...
Dialogue: 0,0:50:25.68,0:50:27.31,Default,,0,0,0,,Бұл барлық ақпарат
Dialogue: 0,0:50:27.44,0:50:28.40,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:50:28.48,0:50:30.36,Default,,0,0,0,,Бақылау және ашу
Dialogue: 0,0:50:32.82,0:50:35.74,Default,,0,0,0,,Уф... Қандай шабуыл!
Dialogue: 0,0:50:35.86,0:50:38.61,Default,,0,0,0,,Егер күмәніңіз болса, құрылғыны қалдырыңыз.
Dialogue: 0,0:50:39.11,0:50:41.32,Default,,0,0,0,,Барлығы премьер-министрге байланысты
Dialogue: 0,0:50:41.45,0:50:44.83,Default,,0,0,0,,Шындыққа жеткіңіз келе ме, әлде қазір осы жерден кеткіңіз келе ме?
Dialogue: 0,0:50:45.50,0:50:48.00,Default,,0,0,0,,Сіздің елестеріңізге еріңіз
Dialogue: 0,0:50:51.04,0:50:58.01,Default,,0,0,0,,Ай!
Dialogue: 0,0:51:36.00,0:51:40.38,Default,,0,0,0,,Қан майдан да, тұйық жер де емес.
Dialogue: 0,0:51:40.51,0:51:43.18,Default,,0,0,0,,Тұратын жаңа жер бар, солай ма?
Dialogue: 0,0:51:43.30,0:51:45.56,Default,,0,0,0,,Сіз қайда барасыз
Dialogue: 0,0:51:49.14,0:51:50.64,Default,,0,0,0,,Ең болмағанда—
Dialogue: 0,0:51:50.77,0:51:54.61,Default,,0,0,0,,Біз лайықты орынға ие боламыз.
Dialogue: 0,0:52:05.37,0:52:08.33,Default,,0,0,0,,Мен күтемін. Не болатынын білмеймін.
Dialogue: 0,0:52:09.04,0:52:12.42,Default,,0,0,0,,Бірінші кезектегі шабуылдаушы әскерлер...
Dialogue: 0,0:52:12.54,0:52:14.84,Default,,0,0,0,,Көпшілік айтса да...
Dialogue: 0,0:52:14.96,0:52:19.59,Default,,0,0,0,,Бұған дейін ешкім қол жеткізе алмады...
Dialogue: 0,0:52:26.10,0:52:27.76,Default,,0,0,0,,Кемеден тыс ешкім жоқ
Dialogue: 0,0:52:27.89,0:52:33.90,Default,,0,0,0,,♪～
Dialogue: 0,0:52:46.37,0:52:47.24,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:52:51.54,0:52:52.66,Default,,0,0,0,,Уау...
Dialogue: 0,0:52:53.16,0:52:55.21,Default,,0,0,0,,Кенет бұл танк!
Dialogue: 0,0:52:56.75,0:52:59.17,Default,,0,0,0,,Ол келмеуі керек еді.
Dialogue: 0,0:52:59.25,0:53:00.42,Default,,0,0,0,,Сайт!
Dialogue: 0,0:53:01.67,0:53:03.55,Default,,0,0,0,,Оны түсіру мүмкін емес!
Dialogue: 0,0:53:06.01,0:53:07.51,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:53:08.93,0:53:13.48,Default,,0,0,0,,2902 термо-оптикалық камуфляж түрі...Кёре жасаған соңғы нұсқасы.
Dialogue: 0,0:53:14.02,0:53:18.11,Default,,0,0,0,,Танк пен жаяу әскер сатып алу үшін қанша ақша керек?
Dialogue: 0,0:53:21.53,0:53:23.24,Default,,0,0,0,,Кемені ұрлаңыз Қолдау!
Dialogue: 0,0:53:25.49,0:53:27.16,Default,,0,0,0,,Қалай! ?
Dialogue: 0,0:53:28.37,0:53:30.33,Default,,0,0,0,,Мен саған мысал көрсетемін, жаңадан келген бала.
Dialogue: 0,0:53:37.75,0:53:38.59,Default,,0,0,0,,(Рюкю) Барлығының өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:53:45.26,0:53:46.30,Default,,0,0,0,,Жүр!
Dialogue: 0,0:53:46.43,0:53:52.43,Default,,0,0,0,,♪～
Dialogue: 0,0:54:02.11,0:54:03.23,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:54:14.04,0:54:14.87,Default,,0,0,0,,Ах
Dialogue: 0,0:54:15.25,0:54:21.59,Default,,0,0,0,,(Логикоманың айқайы)
Dialogue: 0,0:54:25.72,0:54:27.97,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:54:28.09,0:54:34.10,Default,,0,0,0,,♪～
Dialogue: 0,0:54:42.98,0:54:43.90,Default,,0,0,0,,2-раунд, 1-жекпе-жек
Dialogue: 0,0:54:44.48,0:54:46.03,Default,,0,0,0,,Қабыл ал! (Солдат) Уф...
Dialogue: 0,0:54:46.15,0:54:47.57,Default,,0,0,0,,Жүр! Майор!
Dialogue: 0,0:54:47.70,0:54:53.70,Default,,0,0,0,,♪～
Dialogue: 0,0:55:08.01,0:55:10.59,Default,,0,0,0,,Орташа қауіпсіздік серверіне келу
Dialogue: 0,0:55:11.26,0:55:13.51,Default,,0,0,0,,Шлагбаум қабырғасындағы қақпа массивін тексеріңіз
Dialogue: 0,0:55:15.43,0:55:18.23,Default,,0,0,0,,Бұл әскери барлау тактикалық тосқауылының нұсқасы ма?
Dialogue: 0,0:55:18.60,0:55:23.19,Default,,0,0,0,,Кіретін жері сонша, бір ғана шығатын жері бар... әбігер.
Dialogue: 0,0:55:23.86,0:55:25.53,Default,,0,0,0,,Туннельді ашу
Dialogue: 0,0:55:25.65,0:55:28.07,Default,,0,0,0,,Тәтті, ол нөлдік деректерге толы.
Dialogue: 0,0:55:28.19,0:55:29.61,Default,,0,0,0,,Ол түнде қашып кетті!
Dialogue: 0,0:55:29.74,0:55:31.28,Default,,0,0,0,,Бұл дежа ву сезімі бар жалған.
Dialogue: 0,0:55:31.41,0:55:33.03,Default,,0,0,0,,Деректер нөлден тыс
Dialogue: 0,0:55:33.16,0:55:34.87,Default,,0,0,0,,Айналмалы жолды табыңыз!
Dialogue: 0,0:55:34.99,0:55:37.50,Default,,0,0,0,,Өте көңілсіз! Мен оны ашамын!
Dialogue: 0,0:55:39.29,0:55:39.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:43.71,0:55:45.88,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:55:47.67,0:55:50.18,Default,,0,0,0,,Эстафеталық көліктің белсенді қорғанысы өртенді.
Dialogue: 0,0:55:50.30,0:55:51.30,Default,,0,0,0,,Ажырату
Dialogue: 0,0:55:51.43,0:55:52.80,Default,,0,0,0,,Қазірдің өзінде кеш!
Dialogue: 0,0:55:59.64,0:56:01.35,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:56:03.02,0:56:04.36,Default,,0,0,0,,О...
Dialogue: 0,0:56:09.24,0:56:11.15,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:56:13.20,0:56:16.16,Default,,0,0,0,,Ей, сенде қанша жасырын сервер бар?
Dialogue: 0,0:56:16.28,0:56:18.79,Default,,0,0,0,,Қарусыз кіруге асықпа.
Dialogue: 0,0:56:18.91,0:56:21.71,Default,,0,0,0,,Ақпаратты бақылауға алдым.
Dialogue: 0,0:56:23.46,0:56:25.42,Default,,0,0,0,,(Абдул) Ағаңды еске алу үшін шайқас өткізуге ниеттенесің бе?
Dialogue: 0,0:56:26.25,0:56:28.71,Default,,0,0,0,,Сигнал 2 6 7 Жоғалған
Dialogue: 0,0:56:28.84,0:56:31.01,Default,,0,0,0,,Борттағы жау күштері Қазіргі орны белгісіз
Dialogue: 0,0:56:31.13,0:56:33.59,Default,,0,0,0,,Өртті басқару бөлмесі басқарылған сияқты.
Dialogue: 0,0:56:37.06,0:56:38.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:41.10,0:56:42.14,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:56:43.44,0:56:44.73,Default,,0,0,0,,Ух... уау
Dialogue: 0,0:56:45.40,0:56:46.52,Default,,0,0,0,,Уф! !
Dialogue: 0,0:56:46.65,0:56:47.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:56:48.27,0:56:49.57,Default,,0,0,0,,Торияах (Солдат) Ах...
Dialogue: 0,0:56:50.40,0:56:51.74,Default,,0,0,0,,Уряаа
Dialogue: 0,0:56:53.61,0:56:56.37,Default,,0,0,0,,(Елес құлыптау дыбысы)
Dialogue: 0,0:56:56.49,0:56:59.24,Default,,0,0,0,,Жарайды, мен оны ұстадым.
Dialogue: 0,0:57:03.00,0:57:04.96,Default,,0,0,0,,Бұл да аяқталды.
Dialogue: 0,0:57:06.04,0:57:06.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:10.42,0:57:11.55,Default,,0,0,0,,—умеренділермен қақтығысып жатыр.
Dialogue: 0,0:57:16.47,0:57:17.60,Default,,0,0,0,,Тағы біреуі! ?
Dialogue: 0,0:57:17.72,0:57:20.01,Default,,0,0,0,,Бату-сан!
Dialogue: 0,0:57:25.52,0:57:26.44,Default,,0,0,0,,Гү… гүг… Дұрыс.
Dialogue: 0,0:57:26.94,0:57:28.98,Default,,0,0,0,,Кабинет әлі жоқ!
Dialogue: 0,0:57:29.11,0:57:30.90,Default,,0,0,0,,Өтінім қарастырылуда!
Dialogue: 0,0:57:32.32,0:57:33.90,Default,,0,0,0,,Әскери қайта құру?
Dialogue: 0,0:57:34.03,0:57:36.03,Default,,0,0,0,,Неліктен менің әскерлерім...
Dialogue: 0,0:57:36.32,0:57:38.03,Default,,0,0,0,,Нақты кім?
Dialogue: 0,0:57:38.16,0:57:39.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:57:42.16,0:57:44.04,Default,,0,0,0,,Міне солай болды...
Dialogue: 0,0:57:44.16,0:57:47.63,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:57:47.88,0:57:50.38,Default,,0,0,0,,Тез қашыңыз, майор.
Dialogue: 0,0:57:50.80,0:57:53.13,Default,,0,0,0,,Майор, не болды?
Dialogue: 0,0:58:00.18,0:58:02.22,Default,,0,0,0,,Эй, не болып жатыр?
Dialogue: 0,0:58:02.35,0:58:04.31,Default,,0,0,0,,Бақылауды алып тастау керек еді
Dialogue: 0,0:58:04.43,0:58:07.98,Default,,0,0,0,,Біреу оны жақын жерден қашықтан басқарады.
Dialogue: 0,0:58:09.31,0:58:12.53,Default,,0,0,0,,Сайт! Оны тауып, тоқтат!
Dialogue: 0,0:58:12.94,0:58:14.36,Default,,0,0,0,,Маған қосымша ақпарат беріңіз!
Dialogue: 0,0:58:14.49,0:58:15.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:18.82,0:58:19.78,Default,,0,0,0,,Бейбақ!
Dialogue: 0,0:58:22.83,0:58:24.00,Default,,0,0,0,,Жақсы қол.
Dialogue: 0,0:58:24.12,0:58:26.75,Default,,0,0,0,,Егер ол өлсе, мен оны пайдаланамын.
Dialogue: 0,0:58:30.17,0:58:32.09,Default,,0,0,0,,(Әйнекке тиген оқтың дыбысы)
Dialogue: 0,0:58:34.05,0:58:36.55,Default,,0,0,0,,Қарғыс атсын! Мен қашып кеттім!
Dialogue: 0,0:58:45.52,0:58:47.81,Default,,0,0,0,,Бізді неге атпайсың?
Dialogue: 0,0:58:47.94,0:58:50.10,Default,,0,0,0,,Мақсат кемені қайтарып алу емес пе?
Dialogue: 0,0:58:51.27,0:58:52.27,Default,,0,0,0,,Барлығы қауіпсіз бе?
Dialogue: 0,0:58:52.40,0:58:53.23,Default,,0,0,0,,Майор! ?
Dialogue: 0,0:58:53.69,0:58:55.11,Default,,0,0,0,,О, не! ?
Dialogue: 0,0:58:55.44,0:58:56.90,Default,,0,0,0,,Елес енгізу кілті?
Dialogue: 0,0:58:57.03,0:58:58.99,Default,,0,0,0,,Олар бізді күштеп шақырды!
Dialogue: 0,0:58:59.07,0:59:01.57,Default,,0,0,0,,Менің уақытым жоқ. Мен қысқаша айтайын.
Dialogue: 0,0:59:01.66,0:59:05.50,Default,,0,0,0,,Мен оқиғаны белгілі бір гипотеза бойынша қайта қарастырамын.
Dialogue: 0,0:59:05.62,0:59:08.41,Default,,0,0,0,,Тәуекелге бару әркімге міндетті емес
Dialogue: 0,0:59:08.83,0:59:09.71,Default,,0,0,0,,(Каттея) Біз сол арнайы елшімен Гардарикке барамыз —
Dialogue: 0,0:59:09.83,0:59:11.63,Default,,0,0,0,,Бұл адам емес, деректер.
Dialogue: 0,0:59:11.75,0:59:14.46,Default,,0,0,0,,Мен жаңа ғана бөлімшенің таратылғанын хабарладым.
Dialogue: 0,0:59:14.59,0:59:16.42,Default,,0,0,0,,Иә! ? Не! ?
Dialogue: 0,0:59:16.55,0:59:19.30,Default,,0,0,0,,Директор Арамакиге ұсыныс хат қалдырыңыз.
Dialogue: 0,0:59:19.43,0:59:21.68,Default,,0,0,0,,Сіз тасымалдау орнын еркін таңдай аласыз.
Dialogue: 0,0:59:22.64,0:59:25.56,Default,,0,0,0,,Балалар сендер ең жақсы бөліктерсіңдер.
Dialogue: 0,0:59:25.68,0:59:27.43,Default,,0,0,0,,Барлығы орнында...
Dialogue: 0,0:59:27.56,0:59:31.06,Default,,0,0,0,,Ол мен өзім қол жеткізе алмаған өнімділікті көрсетеді.
Dialogue: 0,0:59:31.15,0:59:32.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:34.52,0:59:37.86,Default,,0,0,0,,Болды, аруағыңның соңынан ер.
Dialogue: 0,0:59:39.70,0:59:40.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:40.66,0:59:42.32,Default,,0,0,0,,Лобби жабылды
Dialogue: 0,0:59:42.45,0:59:44.78,Default,,0,0,0,,Өзін-өзі тазартуға тырысты
Dialogue: 0,0:59:45.41,0:59:47.95,Default,,0,0,0,,Бәлкім, бізді үзіп алған шығар.
Dialogue: 0,0:59:48.25,0:59:50.25,Default,,0,0,0,,Қайсысы болғаны маңызды емес, әзіл емес.
Dialogue: 0,0:59:50.37,0:59:51.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:51.29,0:59:54.63,Default,,0,0,0,,Уау... Уау...
Dialogue: 0,0:59:56.67,1:00:00.84,Default,,0,0,0,,Уф... ой... Ghost Lock жұмыс істемейді...
Dialogue: 0,1:00:00.97,1:00:04.30,Default,,0,0,0,,Уф... уф... уф
Dialogue: 0,1:00:12.44,1:00:15.11,Default,,0,0,0,,Қашықтан басқарылатын протездік дене…
Dialogue: 0,1:00:35.67,1:00:37.75,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:00:37.84,1:00:40.51,Default,,0,0,0,,Сіз полковник Наданы ұстадыңыз ба?
Dialogue: 0,1:00:42.43,1:00:45.47,Default,,0,0,0,,Сіз тыңдауыңыздың белгісіз мерзімге кейінге шегерілуіне наразысыз ​​ба?
Dialogue: 0,1:00:46.55,1:00:50.10,Default,,0,0,0,,Мен ненің рас екенін білмеймін.
Dialogue: 0,1:00:50.48,1:00:52.19,Default,,0,0,0,,Шағымдар жоқ
Dialogue: 0,1:00:52.77,1:00:53.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:34.64,1:01:38.36,Default,,0,0,0,,Жөндеу шығындары Сауда министрлігіне немесе Қиыр Шығыс сауда министрлігіне тапсырылуы керек.
Dialogue: 0,1:01:38.48,1:01:40.57,Default,,0,0,0,,Маған басқа көлікті қарызға беруіңізді сұраймын.
Dialogue: 0,1:01:41.61,1:01:43.53,Default,,0,0,0,,Өрт сөндіргіш…
Dialogue: 0,1:01:43.65,1:01:46.61,Default,,0,0,0,,Бұл шын мәнінде вирустың әзірлеу коды ма?
Dialogue: 0,1:01:46.74,1:01:49.41,Default,,0,0,0,,Әлде бұл сіздің атыңыз ба?
Dialogue: 0,1:01:49.53,1:01:51.41,Default,,0,0,0,,Айырмашылық бар ма?
Dialogue: 0,1:01:52.54,1:01:55.50,Default,,0,0,0,,Ақпараттық кеме сұралғандай тасталды.
Dialogue: 0,1:01:55.62,1:01:57.96,Default,,0,0,0,,Тағы не қалайсыз?
Dialogue: 0,1:01:58.08,1:02:01.13,Default,,0,0,0,,Майор Құсанағидың өмірі мен өлімі белгісіз.
Dialogue: 0,1:02:01.25,1:02:03.88,Default,,0,0,0,,Интернеттен де іздеңіз.
Dialogue: 0,1:02:04.59,1:02:06.34,Default,,0,0,0,,Ынтымақтастық
Dialogue: 0,1:02:06.97,1:02:10.85,Default,,0,0,0,,Соғыстан кейінгі ең үлкен жанжал ашылады.
Dialogue: 0,1:02:25.36,1:02:27.86,Default,,0,0,0,,Министрдің орынбасары Китахара өлтірілді.
Dialogue: 0,1:02:27.99,1:02:30.49,Default,,0,0,0,,Полковник Наданың тірі немесе өлі екені әлі белгісіз.
Dialogue: 0,1:02:30.62,1:02:35.79,Default,,0,0,0,,Сіздің ісіңізді дәлелдеу қиын болады және сіздің тергеу артықшылықтарыңыз жоғалады.
Dialogue: 0,1:02:36.37,1:02:39.63,Default,,0,0,0,,Дегенмен, 9-бөлімнің мүшесі ретінде мен жалғастыра аламын.
Dialogue: 0,1:02:39.71,1:02:40.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:40.88,1:02:42.00,Default,,0,0,0,,Мені қызықтырмайды.
Dialogue: 0,1:02:42.13,1:02:42.96,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,1:02:43.92,1:02:45.97,Default,,0,0,0,,Сіз мұны істей аласыз ба? Эй, эй...
Dialogue: 0,1:02:46.05,1:02:48.05,Default,,0,0,0,,Балалар сендерге жақсы ма?
Dialogue: 0,1:02:54.97,1:02:56.43,Default,,0,0,0,,Қай жерден басынан бастағыңыз келеді?
Dialogue: 0,1:02:56.56,1:02:57.48,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:58.35,1:03:00.44,Default,,0,0,0,,Кемеден ештеңе шықпаса...
Dialogue: 0,1:03:00.56,1:03:03.57,Default,,0,0,0,,Айғақ беруден бас тартқандарды іздеу
Dialogue: 0,1:03:03.69,1:03:06.44,Default,,0,0,0,,Роберт, Қиыр Шығыс сауда департаментінің өкілі...
Dialogue: 0,1:03:07.07,1:03:10.53,Default,,0,0,0,,Бұл қиын қарсылас. 9-бөлімнің желісін пайдаланыңыз.
Dialogue: 0,1:03:10.62,1:03:11.82,Default,,0,0,0,,Иә!
Dialogue: 0,1:03:16.87,1:03:20.00,Default,,0,0,0,,Жаңа ғана көктеп, сәл өсті.
Dialogue: 0,1:03:20.12,1:03:23.38,Default,,0,0,0,,Жоюға жол бермеймін... Майор
Dialogue: 0,1:03:31.09,1:03:32.97,Default,,0,0,0,,Менде біраз ақпарат бар.
Dialogue: 0,1:03:33.51,1:03:35.43,Default,,0,0,0,,Өткен тұйық шешім -
Dialogue: 0,1:03:35.56,1:03:38.43,Default,,0,0,0,,Дене протезін жасаушы мен оның әйелі жоғалып кетті...
Dialogue: 0,1:03:38.77,1:03:40.39,Default,,0,0,0,,Мәйітті тексергеннен кейін дене...
Dialogue: 0,1:03:40.52,1:03:44.40,Default,,0,0,0,,501 Ол бір мекемеде зерттеу үшін сақталған сияқты.
Dialogue: 0,1:03:46.03,1:03:49.07,Default,,0,0,0,,Сіздің әйеліңіз жүкті болған деп ойламаймын.
Dialogue: 0,1:03:49.20,1:03:50.99,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,1:03:53.03,1:03:55.87,Default,,0,0,0,,Бұл нөл жастағы балаға толық дене протезі туралы әңгіме.
Dialogue: 0,1:03:56.95,1:03:58.96,Default,,0,0,0,,Майордың ата-анасы?
Dialogue: 0,1:03:59.04,1:04:01.12,Default,,0,0,0,,Мен сенімді бола алмаймын.
Dialogue: 0,1:04:01.25,1:04:05.04,Default,,0,0,0,,Дененің ластанғаны сонша, біз оны анықтай алмаймыз.
Dialogue: 0,1:04:06.42,1:04:08.84,Default,,0,0,0,,Өзімнің денемсіз туған.
Dialogue: 0,1:04:08.97,1:04:11.55,Default,,0,0,0,,Әскери техника ретінде өсіріледі
Dialogue: 0,1:04:11.68,1:04:13.64,Default,,0,0,0,,Менің ойымша, сізде жоғалтатын ештеңе жоқ.
Dialogue: 0,1:04:14.30,1:04:17.47,Default,,0,0,0,,Менің ешқашан жоғалтатын ештеңем болған емес
Dialogue: 0,1:04:18.85,1:04:23.52,Default,,0,0,0,,Соғыс аяқталып, біз тәуелсіздік алғанша...
Dialogue: 0,1:04:24.27,1:04:28.86,Default,,0,0,0,,Сіз жалғыз болуыңызға әке-шешеңіз болған бұрынғы құрбандарыңыз себеп болды дейсіз бе?
Dialogue: 0,1:04:28.99,1:04:30.53,Default,,0,0,0,,Бұл майор туралы.
Dialogue: 0,1:04:30.65,1:04:33.87,Default,,0,0,0,,Менің ойымша, бұл үлкенірек нәрсені қуған соң.
Dialogue: 0,1:04:34.70,1:04:39.70,Default,,0,0,0,,Менің ойымша... майор сол кемеде біртүрлі нәрсені көрді.
Dialogue: 0,1:04:39.83,1:04:43.29,Default,,0,0,0,,Жаман нәрсе болғаны сонша, олар бізді тазартуды шешті.
Dialogue: 0,1:04:44.21,1:04:47.21,Default,,0,0,0,,Егер сіз бізді қорғағыңыз келсе, күлдіріңіз.
Dialogue: 0,1:04:47.34,1:04:49.88,Default,,0,0,0,,Оны бөліктер деп атаса да
Dialogue: 0,1:04:50.01,1:04:53.72,Default,,0,0,0,,Оны зат десең де, заттай қарама.
Dialogue: 0,1:04:54.22,1:04:57.68,Default,,0,0,0,,Кез келген жағдайда толық дене протезі тек бөліктер болып табылады.
Dialogue: 0,1:04:57.81,1:05:00.43,Default,,0,0,0,,Мен ұйымға кіруім керек пе және оны сақтау керек пе?
Dialogue: 0,1:05:00.56,1:05:02.69,Default,,0,0,0,,Тірі жүріп шірисің бе...
Dialogue: 0,1:05:15.57,1:05:16.87,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,1:05:18.62,1:05:20.95,Default,,0,0,0,,Бұл елестерге еру туралы емес.
Dialogue: 0,1:05:22.41,1:05:25.17,Default,,0,0,0,,Осы көзбен көруге болатынның бәрі
Dialogue: 0,1:05:28.84,1:05:33.05,Default,,0,0,0,,1 кеме, 2 танк, 7 жаяу әскер
Dialogue: 0,1:05:33.34,1:05:35.72,Default,,0,0,0,,Бұл өте қымбат тұзақ болды.
Dialogue: 0,1:06:04.71,1:06:06.92,Default,,0,0,0,,Сіз нені қарадыңыз?
Dialogue: 0,1:06:12.76,1:06:14.88,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:06:21.60,1:06:23.60,Default,,0,0,0,,Мен сенімен сөйлесуге келдім.
Dialogue: 0,1:06:29.86,1:06:32.61,Default,,0,0,0,,Сізді кенеттен шақырғаным үшін кешіріңіз.
Dialogue: 0,1:06:32.69,1:06:35.11,Default,,0,0,0,,Барлау бөліміне қайта барғыңыз келетін сияқты.
Dialogue: 0,1:06:35.24,1:06:39.37,Default,,0,0,0,,Майор Құсанағы туралы мағлұмат берсеңіз, мен ойланып аламын.
Dialogue: 0,1:06:40.24,1:06:41.08,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:41.62,1:06:43.91,Default,,0,0,0,,Сөйлеу маңызды
Dialogue: 0,1:06:47.21,1:06:48.79,Default,,0,0,0,,Мен...
Dialogue: 0,1:06:48.92,1:06:52.09,Default,,0,0,0,,Делдал қызметін атқару...
Dialogue: 0,1:06:52.17,1:06:55.59,Default,,0,0,0,,Коичи Савада… Бұрынғы армияның броньды дивизиясы
Dialogue: 0,1:06:55.72,1:06:58.80,Default,,0,0,0,,Кеше белгісіз байланыстағы барлау жинайтын кемеде қайтыс болды.
Dialogue: 0,1:06:58.93,1:07:01.89,Default,,0,0,0,,Қорғаушы фракция мүшелерінің бірімен сәйкес келді
Dialogue: 0,1:07:02.01,1:07:03.47,Default,,0,0,0,,Мен...
Dialogue: 0,1:07:07.35,1:07:10.19,Default,,0,0,0,,Маған жалған естеліктер салынды.
Dialogue: 0,1:07:10.31,1:07:12.40,Default,,0,0,0,,Полковник Харуёси Нада
Dialogue: 0,1:07:26.83,1:07:28.66,Default,,0,0,0,,Ммммм!
Dialogue: 0,1:07:28.79,1:07:30.37,Default,,0,0,0,,Исикава мырза -
Dialogue: 0,1:07:30.50,1:07:33.38,Default,,0,0,0,,Ескі жауыңды жау қылып, онымен тегін құтыла аламын деп ойлайсың ба?
Dialogue: 0,1:07:33.50,1:07:34.84,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,1:07:35.05,1:07:38.51,Default,,0,0,0,,Бұл ауру сезімін 7000 есе арттыратын микромашина.
Dialogue: 0,1:07:38.63,1:07:41.05,Default,,0,0,0,,Кибер әлемге 5 минутта жетіңіз
Dialogue: 0,1:07:41.18,1:07:43.18,Default,,0,0,0,,Бұған шыдауға болмайды.
Dialogue: 0,1:07:43.26,1:07:45.85,Default,,0,0,0,,Тоқташы... Уф... А... Уф
Dialogue: 0,1:07:45.93,1:07:48.31,Default,,0,0,0,,Тоқта! Ааааааааааааааааааааааа
Dialogue: 0,1:07:48.43,1:07:54.44,Default,,0,0,0,,♪～
Dialogue: 0,1:08:09.54,1:08:11.17,Default,,0,0,0,,Ах... іштен!
Dialogue: 0,1:08:15.00,1:08:18.30,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,1:08:18.42,1:08:19.59,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:08:33.94,1:08:34.77,Default,,0,0,0,,Уф! !
Dialogue: 0,1:08:36.02,1:08:37.48,Default,,0,0,0,,Атпен жүру
Dialogue: 0,1:08:41.86,1:08:44.78,Default,,0,0,0,,Toa Alliance басшылары мен майорының бірдей протездік органдары...
Dialogue: 0,1:08:44.91,1:08:47.08,Default,,0,0,0,,Біз басынан бері біргеміз
Dialogue: 0,1:08:47.20,1:08:50.04,Default,,0,0,0,,Екі жақты лаңкестік әрекеттердің желісі жойылды.
Dialogue: 0,1:08:50.16,1:08:52.16,Default,,0,0,0,,Елшілікке не үшін келдің?
Dialogue: 0,1:08:52.58,1:08:55.75,Default,,0,0,0,,Жарылыс орнында табылған өте үлкен электрондық қағаз
Dialogue: 0,1:08:56.46,1:08:59.46,Default,,0,0,0,,Мен сол деректердің бір бөлігін ғана шығара алдым.
Dialogue: 0,1:09:01.63,1:09:03.68,Default,,0,0,0,,Елшіліктің үш өлшемді көрінісі?
Dialogue: 0,1:09:04.14,1:09:07.51,Default,,0,0,0,,Премьер-Министрдің жасырын кездесуінің мақсаты...
Dialogue: 0,1:09:09.06,1:09:11.23,Default,,0,0,0,,Бұл кеме Америка Құрама Штаттарымен құпия келісім болды.
Dialogue: 0,1:09:11.35,1:09:13.73,Default,,0,0,0,,Ішкі барлау қызметі үшін пайдаланылады
Dialogue: 0,1:09:14.40,1:09:17.61,Default,,0,0,0,,Бұл тіпті жанжал емес, ел қорғанысы туралы!
Dialogue: 0,1:09:17.73,1:09:20.65,Default,,0,0,0,,Неге оны лақтырып жібердің де, майорды сиқырдың?
Dialogue: 0,1:09:20.78,1:09:22.03,Default,,0,0,0,,Премьер-министрдің жауы кім?
Dialogue: 0,1:09:22.57,1:09:28.24,Default,,0,0,0,,Премьер-министр ұлттық қорғаныс тобын Сауда министрлігіндегі оппозициялық топты жеңу үшін пайдаланғысы келді.
Dialogue: 0,1:09:28.37,1:09:32.41,Default,,0,0,0,,Мен одан артық білмеймін. Өтінемін маған көмектесіңіз!
Dialogue: 0,1:09:32.54,1:09:36.17,Default,,0,0,0,,Уаааааааааааааааааааа!
Dialogue: 0,1:09:39.88,1:09:40.92,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,1:09:41.67,1:09:44.30,Default,,0,0,0,,Бұл дәрумендік таблетка, ақымақ.
Dialogue: 0,1:09:44.43,1:09:50.43,Default,,0,0,0,,♪～
Dialogue: 0,1:09:59.40,1:10:01.82,Default,,0,0,0,,Полковник Наданың өзі болды ма...
Dialogue: 0,1:10:01.94,1:10:06.20,Default,,0,0,0,,Соңғы жауынгерлерге деген жанашырлығым жалған естелік тудырған шығар.
Dialogue: 0,1:10:06.32,1:10:11.54,Default,,0,0,0,,Адамның қалауы мен кінәсін сезінуі жалған естеліктің өзегі бола ма?
Dialogue: 0,1:10:11.95,1:10:14.54,Default,,0,0,0,,Үкіметті бопсалау картасы ретінде -
Dialogue: 0,1:10:14.66,1:10:16.58,Default,,0,0,0,,тірі қалды
Dialogue: 0,1:10:16.71,1:10:18.88,Default,,0,0,0,,Сену қиын...
Dialogue: 0,1:10:20.25,1:10:21.96,Default,,0,0,0,,Өкіл Роберт оқиғадан кейін-
Dialogue: 0,1:10:22.09,1:10:25.67,Default,,0,0,0,,Елші Ричардтың юрисдикциясына жататын сирек жер кеніштерін монополиялады...
Dialogue: 0,1:10:26.30,1:10:30.30,Default,,0,0,0,,Сырттай ынтымақтаса отырып, олар қақтығысты.
Dialogue: 0,1:10:30.43,1:10:33.72,Default,,0,0,0,,Бұл соғыс жүргізушілер арасындағы шайқас.
Dialogue: 0,1:10:34.23,1:10:39.10,Default,,0,0,0,,Премьер-министр елшіні өкілді өлтіруге қатысуға мәжбүр етті.
Dialogue: 0,1:10:39.73,1:10:42.90,Default,,0,0,0,,Ал өкіл қарсы шабуылға шықты
Dialogue: 0,1:10:43.19,1:10:47.45,Default,,0,0,0,,Қарастырылып отырған брокер вирусты екі тарапқа да берді.
Dialogue: 0,1:10:47.57,1:10:49.62,Default,,0,0,0,,Таразымен өлшенген шығар.
Dialogue: 0,1:10:49.74,1:10:54.54,Default,,0,0,0,,Біріншіден, бұл премьер-министр мен Шығыс Азия альянсы арасындағы соғыс болды!
Dialogue: 0,1:10:56.00,1:10:59.33,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:11:02.63,1:11:04.09,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:11:04.21,1:11:07.09,Default,,0,0,0,,Майорды қамауға алу туралы қаулы шығарылды.
Dialogue: 0,1:11:07.84,1:11:08.84,Default,,0,0,0,,Өтінемін, Ятоны құтқарыңдар!
Dialogue: 0,1:11:11.01,1:11:14.06,Default,,0,0,0,,Тіпті майор жалғыз жүруді таңдады.
Dialogue: 0,1:11:14.18,1:11:17.06,Default,,0,0,0,,Мен сенен қозғалуыңды күтпеймін.
Dialogue: 0,1:11:17.81,1:11:19.60,Default,,0,0,0,,Мені бағалама
Dialogue: 0,1:11:19.73,1:11:23.15,Default,,0,0,0,,Майорды маған қалдырыңыз, оны тірі қалдырыңыз.
Dialogue: 0,1:11:23.27,1:11:24.44,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,1:11:25.11,1:11:26.15,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:44.50,1:11:46.05,Default,,0,0,0,,Майор Құсанағы?
Dialogue: 0,1:11:47.13,1:11:52.01,Default,,0,0,0,,Ха... 9-ші қоғамдық қауіпсіздік бөлімі маған келген кезде хабарлауымды айтты.
Dialogue: 0,1:11:52.76,1:11:54.76,Default,,0,0,0,,Сен де олардан жасырғың келе ме?
Dialogue: 0,1:11:54.89,1:11:57.98,Default,,0,0,0,,Бұл сізге байланысты, директордың көмекшісі Фуджимото.
Dialogue: 0,1:12:02.52,1:12:03.48,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:08.49,1:12:14.49,Default,,0,0,0,,♪～
Dialogue: 0,1:12:31.05,1:12:32.80,Default,,0,0,0,,Жау дайындаған бомбалар -
Dialogue: 0,1:12:32.93,1:12:36.01,Default,,0,0,0,,Сен оны әкеңе әкелдің.
Dialogue: 0,1:12:36.14,1:12:37.77,Default,,0,0,0,,Бұл...
Dialogue: 0,1:12:38.97,1:12:40.06,Default,,0,0,0,,Оған қоса, осы деңгейдегі қарғыс энергиясы…
Dialogue: 0,1:12:40.18,1:12:43.90,Default,,0,0,0,,Менің бөлімшенің бюджетіне қатысты кейбір талқылаулар түсініксіз болды.
Dialogue: 0,1:12:44.02,1:12:46.02,Default,,0,0,0,,Бюджет қайдан келеді?
Dialogue: 0,1:12:47.11,1:12:51.82,Default,,0,0,0,,Уф... әскери сектор жекешелендірілмек...
Dialogue: 0,1:12:52.36,1:12:55.03,Default,,0,0,0,,501 мекемесі деп аталатын бөлім таратылсын...
Dialogue: 0,1:12:55.16,1:12:55.99,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:56.12,1:12:57.91,Default,,0,0,0,,Бюджет профициті болуы керек
Dialogue: 0,1:12:58.95,1:13:02.87,Default,,0,0,0,,Менің жадымды қалпына келтіріңіз...
Dialogue: 0,1:13:03.00,1:13:05.67,Default,,0,0,0,,Мен бұл естеліктерге шыдай алмаймын...
Dialogue: 0,1:13:05.79,1:13:08.34,Default,,0,0,0,,Мен шындықты таңдаймын
Dialogue: 0,1:13:08.80,1:13:10.88,Default,,0,0,0,,Жүрегім қанша қаласа да...
Dialogue: 0,1:13:11.01,1:13:14.18,Default,,0,0,0,,Жасалған естеліктерді ауыстыру ойым жоқ.
Dialogue: 0,1:13:14.26,1:13:15.55,Default,,0,0,0,,Созылған жұдырық
Dialogue: 0,1:13:16.72,1:13:17.89,Default,,0,0,0,,Әй!
Dialogue: 0,1:13:32.32,1:13:33.61,Default,,0,0,0,,Ха! ?
Dialogue: 0,1:13:34.86,1:13:36.62,Default,,0,0,0,,Қашықтан басқарылатын протездік дене…
Dialogue: 0,1:13:44.50,1:13:45.92,Default,,0,0,0,,Курц!
Dialogue: 0,1:14:00.97,1:14:06.98,Default,,0,0,0,,♪～
Dialogue: 0,1:14:15.36,1:14:17.03,Default,,0,0,0,,Мені сервер қабатына апарыңыз.
Dialogue: 0,1:14:17.16,1:14:23.16,Default,,0,0,0,,♪～
Dialogue: 0,1:15:00.28,1:15:01.91,Default,,0,0,0,,Вирустарды дамыту желісі…
Dialogue: 0,1:15:01.99,1:15:03.62,Default,,0,0,0,,Сыртқы беріліс?
Dialogue: 0,1:15:07.71,1:15:08.46,Default,,0,0,0,,Уф!
Dialogue: 0,1:15:09.67,1:15:10.63,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:15:19.43,1:15:22.10,Default,,0,0,0,,Шабуылдық қорғаныс қабырғасындағы қорғаныс қабырға лабиринті…
Dialogue: 0,1:15:22.22,1:15:25.06,Default,,0,0,0,,Бұл сізді қорғау үшін жеткілікті ақпарат.
Dialogue: 0,1:15:25.31,1:15:27.89,Default,,0,0,0,,Мен сағынышқа толы келбетіммен танылдым.
Dialogue: 0,1:15:28.02,1:15:30.02,Default,,0,0,0,,Кешіріңіз, бірақ мен сізді ұстаймын.
Dialogue: 0,1:15:30.60,1:15:31.90,Default,,0,0,0,,Курцтың бұйрықтары?
Dialogue: 0,1:15:32.02,1:15:33.94,Default,,0,0,0,,Бұл біздің ұжымдық ерік-жігеріміз.
Dialogue: 0,1:15:34.07,1:15:35.90,Default,,0,0,0,,Курц оқиғаның бір бөлігі ғана
Dialogue: 0,1:15:36.15,1:15:37.78,Default,,0,0,0,,Сіз тірісіз.
Dialogue: 0,1:15:39.20,1:15:40.07,Default,,0,0,0,,Әй! ?
Dialogue: 0,1:15:40.20,1:15:42.20,Default,,0,0,0,,Тыныш бол, Құсанағы.
Dialogue: 0,1:15:42.28,1:15:44.08,Default,,0,0,0,,Мен сенің өлгеніңді қаламаймын
Dialogue: 0,1:15:45.91,1:15:51.79,Default,,0,0,0,,♪～
Dialogue: 0,1:16:07.22,1:16:08.35,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:16:10.31,1:16:11.06,Default,,0,0,0,,Уф...
Dialogue: 0,1:16:21.11,1:16:22.45,Default,,0,0,0,,Гррр…
Dialogue: 0,1:16:23.62,1:16:27.41,Default,,0,0,0,,Болды, кеттік, Құсанағы.
Dialogue: 0,1:16:32.96,1:16:35.21,Default,,0,0,0,,Мм... Адасқан адам.
Dialogue: 0,1:16:37.71,1:16:38.63,Default,,0,0,0,,Хмф! (Мотоко) Ах!
Dialogue: 0,1:16:48.81,1:16:50.14,Default,,0,0,0,,...
Dialogue: 0,1:16:50.27,1:16:56.27,Default,,0,0,0,,♪～
Dialogue: 0,1:17:36.40,1:17:39.90,Default,,0,0,0,,Бұл сенің шегің, Құсанағи.
Dialogue: 0,1:17:55.42,1:17:56.33,Default,,0,0,0,,Уф!
Dialogue: 0,1:17:58.09,1:18:00.63,Default,,0,0,0,,Майор!
Dialogue: 0,1:18:03.22,1:18:06.05,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:18:20.73,1:18:21.98,Default,,0,0,0,,Эй, сен ояусың ба?
Dialogue: 0,1:18:22.57,1:18:25.20,Default,,0,0,0,,Мен сіздің жасырын зертханаңызды бұзып, оны пайдаландым.
Dialogue: 0,1:18:25.32,1:18:26.20,Default,,0,0,0,,Шағымданбаңыз
Dialogue: 0,1:18:26.82,1:18:30.16,Default,,0,0,0,,Неліктен қаруды қосу арқылы протездік дененің бастапқы өнімділігін төмендетесіз?
Dialogue: 0,1:18:30.28,1:18:32.45,Default,,0,0,0,,Сіз сияқты емес
Dialogue: 0,1:18:33.25,1:18:34.79,Default,,0,0,0,,Неге келдің?
Dialogue: 0,1:18:35.29,1:18:37.25,Default,,0,0,0,,Мен капитан ретінде бұйрық бере алмаймын.
Dialogue: 0,1:18:37.37,1:18:41.67,Default,,0,0,0,,Бірақ мен елесі бар адам ретінде менімен бірге келе ме, жоқ па, солардың таңдағанын қаладым.
Dialogue: 0,1:18:41.80,1:18:43.63,Default,,0,0,0,,Шынымды айтсам қалай?
Dialogue: 0,1:18:43.76,1:18:44.84,Default,,0,0,0,,Қаш
Dialogue: 0,1:18:44.97,1:18:46.88,Default,,0,0,0,,Лабиринттен шыққанда
Dialogue: 0,1:18:47.22,1:18:50.22,Default,,0,0,0,,Оған дейін біз қалағанымызды жасаймыз.
Dialogue: 0,1:19:00.27,1:19:01.90,Default,,0,0,0,,Менің ойымша, олар жауапкершілікті өз мойнына алады.
Dialogue: 0,1:19:02.19,1:19:05.28,Default,,0,0,0,,Уайымдамаңыз, инженерді пайдаланыңыз
Dialogue: 0,1:19:05.40,1:19:07.86,Default,,0,0,0,,Еншілес компаниялардан сарбаздарды жіберіңіз
Dialogue: 0,1:19:07.99,1:19:09.99,Default,,0,0,0,,Қанша жұмсағаныңыз маңызды емес
Dialogue: 0,1:19:10.49,1:19:12.95,Default,,0,0,0,,Сіз ұрыс даласында өлуге дайынсыз ба?
Dialogue: 0,1:19:13.45,1:19:16.75,Default,,0,0,0,,Бұл 500 миллиард долларлық бизнес.
Dialogue: 0,1:19:16.87,1:19:20.92,Default,,0,0,0,,Әлемді өзгерткісі келетін ақымақтар азшылықты құрайды.
Dialogue: 0,1:19:21.42,1:19:25.55,Default,,0,0,0,,Тез арада жою сіздің демократияңыз емес пе?
Dialogue: 0,1:19:25.67,1:19:26.80,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,1:19:42.86,1:19:44.90,Default,,0,0,0,,Құсанаға қарсылық көрсетпе
Dialogue: 0,1:19:45.03,1:19:47.32,Default,,0,0,0,,Мен сенің миыңды қуырғым келмейді
Dialogue: 0,1:19:47.40,1:19:51.16,Default,,0,0,0,,Менің қабырғаларым арзан емес.
Dialogue: 0,1:19:57.33,1:19:59.29,Default,,0,0,0,,Барьерді бұзбау.
Dialogue: 0,1:19:59.41,1:20:00.92,Default,,0,0,0,,Біз бір-бірімізге орала алмаймыз.
Dialogue: 0,1:20:01.37,1:20:03.54,Default,,0,0,0,,Оған дейін айтыңызшы
Dialogue: 0,1:20:03.67,1:20:06.00,Default,,0,0,0,,Курц денесінің орны мен мақсаты
Dialogue: 0,1:20:06.42,1:20:08.05,Default,,0,0,0,,Мен орналасқан жерді білмеймін
Dialogue: 0,1:20:08.17,1:20:11.30,Default,,0,0,0,,Оның көп денесі құпия болды.
Dialogue: 0,1:20:11.43,1:20:13.05,Default,,0,0,0,,Мақсат өзгеріссіз қалады
Dialogue: 0,1:20:13.18,1:20:15.85,Default,,0,0,0,,Қай күш жеңсе де аман қалу.
Dialogue: 0,1:20:16.77,1:20:19.89,Default,,0,0,0,,Сіз түсінесіз деп ойлаймын, бірақ Шығыс Азия Одағының мақсаты...
Dialogue: 0,1:20:20.02,1:20:22.98,Default,,0,0,0,,Тұйық технологиялық инновация және нарықтық монополия
Dialogue: 0,1:20:24.40,1:20:28.11,Default,,0,0,0,,Тұйыққа жетпеген балалар бар.
Dialogue: 0,1:20:28.24,1:20:30.45,Default,,0,0,0,,Сіз оларды корпоративтік өнімге айналдырғыңыз келе ме?
Dialogue: 0,1:20:30.86,1:20:33.41,Default,,0,0,0,,Бәрін сеніп тапсыруым керек мұрагер.
Dialogue: 0,1:20:33.74,1:20:38.37,Default,,0,0,0,,Олар келесі ұрпаққа айналады және ұзақ мерзімді жаңартуларды жүзеге асырады.
Dialogue: 0,1:20:38.50,1:20:41.12,Default,,0,0,0,,Сонда сен мені сол нәрсені қайталауға мәжбүрлемексің бе?
Dialogue: 0,1:20:41.25,1:20:43.21,Default,,0,0,0,,Тіпті маған елес сатыңдар
Dialogue: 0,1:20:43.33,1:20:44.08,Default,,0,0,0,,Ах...
Dialogue: 0,1:21:12.74,1:21:14.28,Default,,0,0,0,,Уау...
Dialogue: 0,1:21:18.62,1:21:21.54,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:21:22.41,1:21:23.25,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,1:21:23.83,1:21:24.71,Default,,0,0,0,,Ой! Уф...
Dialogue: 0,1:21:34.38,1:21:35.59,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:35.72,1:21:41.73,Default,,0,0,0,,♪～
Dialogue: 0,1:21:55.28,1:21:57.37,Default,,0,0,0,,Сіз әрқашан бос едіңіз
Dialogue: 0,1:21:57.82,1:21:59.91,Default,,0,0,0,,Әрқашан болашақты жасауға ұмтылу
Dialogue: 0,1:22:00.04,1:22:02.50,Default,,0,0,0,,Мен сені осылай қызғанамын.
Dialogue: 0,1:22:02.91,1:22:05.08,Default,,0,0,0,,Мені қорға...
Dialogue: 0,1:22:05.21,1:22:07.54,Default,,0,0,0,,Біздің миымыз бәрібір өз шегінде.
Dialogue: 0,1:22:08.29,1:22:11.13,Default,,0,0,0,,Бұған дейін үшінші әлемге ауысыңыз
Dialogue: 0,1:22:11.25,1:22:14.17,Default,,0,0,0,,Деректер мұхитының бөлігі болу үшін дұға ет
Dialogue: 0,1:22:15.30,1:22:17.22,Default,,0,0,0,,Бір күні сізге қол жеткізетін біреу болады...
Dialogue: 0,1:22:17.34,1:22:19.30,Default,,0,0,0,,Ол туылуы мүмкін
Dialogue: 0,1:22:23.89,1:22:25.19,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:46.37,1:22:47.79,Default,,0,0,0,,Онда!
Dialogue: 0,1:22:48.38,1:22:49.96,Default,,0,0,0,,Ууууууууууууууууу
Dialogue: 0,1:22:50.09,1:22:52.05,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:53.76,1:22:54.88,Default,,0,0,0,,Хмм...
Dialogue: 0,1:22:55.01,1:23:01.01,Default,,0,0,0,,♪～
Dialogue: 0,1:23:10.48,1:23:11.23,Default,,0,0,0,,Ха!
Dialogue: 0,1:23:15.74,1:23:17.70,Default,,0,0,0,,Ах... Уф
Dialogue: 0,1:23:23.79,1:23:24.58,Default,,0,0,0,,Сайт!
Dialogue: 0,1:23:24.70,1:23:26.41,Default,,0,0,0,,Бейбақ, әзіл!
Dialogue: 0,1:23:26.54,1:23:28.83,Default,,0,0,0,,О! Ууууууууууууууууууууууу
Dialogue: 0,1:23:29.33,1:23:30.17,Default,,0,0,0,,Уф
Dialogue: 0,1:23:30.92,1:23:31.75,Default,,0,0,0,,2-раунд, 1-жекпе-жек
Dialogue: 0,1:23:35.67,1:23:37.26,Default,,0,0,0,,Барлығы тірі ме? ?
Dialogue: 0,1:23:37.38,1:23:39.47,Default,,0,0,0,,Өліп қалса, оны жөндеуге болмайды.
Dialogue: 0,1:23:39.88,1:23:41.89,Default,,0,0,0,,Жақсы адам өлмейді
Dialogue: 0,1:23:43.05,1:23:44.35,Default,,0,0,0,,Уряаа!
Dialogue: 0,1:23:44.97,1:23:45.85,Default,,0,0,0,,Уряаа!
Dialogue: 0,1:23:52.48,1:23:53.69,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:57.15,1:23:58.61,Default,,0,0,0,,Уф...
Dialogue: 0,1:23:59.40,1:24:00.32,Default,,0,0,0,,Уф...
Dialogue: 0,1:24:03.66,1:24:04.66,Default,,0,0,0,,Ха!
Dialogue: 0,1:24:12.67,1:24:14.17,Default,,0,0,0,,Сіз не үшін тұрсыз?
Dialogue: 0,1:24:14.29,1:24:16.59,Default,,0,0,0,,Егер бұл спектакльдің түрі болса, мен оны ауыстырамын.
Dialogue: 0,1:24:17.38,1:24:20.13,Default,,0,0,0,,Хмф, мен саған көрсетейін деп едім.
Dialogue: 0,1:24:20.26,1:24:21.34,Default,,0,0,0,,Әйел горилла
Dialogue: 0,1:24:21.47,1:24:22.84,Default,,0,0,0,,Уггаааааааааааааааааааа
Dialogue: 0,1:24:23.26,1:24:24.39,Default,,0,0,0,,Гааааааааааааааааааааа
Dialogue: 0,1:24:26.22,1:24:27.68,Default,,0,0,0,,Уф... уф!
Dialogue: 0,1:24:29.10,1:24:29.89,Default,,0,0,0,,Уф!
Dialogue: 0,1:24:33.19,1:24:34.06,Default,,0,0,0,,Ах!
Dialogue: 0,1:24:43.78,1:24:44.99,Default,,0,0,0,,Ах!
Dialogue: 0,1:24:48.79,1:24:49.62,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,1:24:53.50,1:24:54.83,Default,,0,0,0,,Уф!
Dialogue: 0,1:25:00.72,1:25:01.76,Default,,0,0,0,,Я...
Dialogue: 0,1:25:02.26,1:25:04.39,Default,,0,0,0,,Адасқан адам!
Dialogue: 0,1:25:04.51,1:25:07.10,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,1:25:21.69,1:25:22.82,Default,,0,0,0,,Уф...
Dialogue: 0,1:25:25.74,1:25:27.83,Default,,0,0,0,,Майор, амансың ба?
Dialogue: 0,1:25:29.33,1:25:30.20,Default,,0,0,0,,Хмм!
Dialogue: 0,1:25:35.83,1:25:36.96,Default,,0,0,0,,Уряаа!
Dialogue: 0,1:25:38.50,1:25:39.96,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,1:25:53.52,1:25:56.35,Default,,0,0,0,,Қалыпты протездік дене жақсы, солай ма?
Dialogue: 0,1:25:56.48,1:25:58.27,Default,,0,0,0,,Мен саған қашып кет дедім.
Dialogue: 0,1:25:58.40,1:26:00.23,Default,,0,0,0,,Мерекелерді жақсы көретін ақымақтар
Dialogue: 0,1:26:00.90,1:26:03.03,Default,,0,0,0,,Сіз сияқты бөліктер...
Dialogue: 0,1:26:03.15,1:26:05.20,Default,,0,0,0,,Оларды қайтадан жинай алмайсыз.
Dialogue: 0,1:26:06.87,1:26:09.78,Default,,0,0,0,,Сіз әлі маңызды жұмысыңызды аяқтаған жоқсыз.
Dialogue: 0,1:26:17.92,1:26:20.59,Default,,0,0,0,,Мені қамауға алудың мәні неде?
Dialogue: 0,1:26:20.67,1:26:24.30,Default,,0,0,0,,Кабинет таратылғаннан кейін дәл сол ойын ойналады.
Dialogue: 0,1:26:24.59,1:26:27.80,Default,,0,0,0,,Бірнеше зейнеткерлікке шыққан министрлер де осылай деді...
Dialogue: 0,1:26:27.93,1:26:29.10,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,1:26:29.22,1:26:31.14,Default,,0,0,0,,Ақшамен және технологиямен біз...
Dialogue: 0,1:26:31.26,1:26:33.77,Default,,0,0,0,,Біз жосықсыз жүйелермен күрестік.
Dialogue: 0,1:26:33.89,1:26:36.19,Default,,0,0,0,,Мылтық ұстағандай.
Dialogue: 0,1:26:36.31,1:26:38.44,Default,,0,0,0,,Біз қылмысты жек көреміз, бірақ...
Dialogue: 0,1:26:38.56,1:26:41.90,Default,,0,0,0,,Сіз пайда табу үшін қылмыскерлерді жасайсыз
Dialogue: 0,1:26:42.73,1:26:45.61,Default,,0,0,0,,Ақырында түсінесіз
Dialogue: 0,1:27:05.55,1:27:07.05,Default,,0,0,0,,(Жақындаған нәрсенің дыбысы)
Dialogue: 0,1:27:07.18,1:27:08.22,Default,,0,0,0,,Ха!
Dialogue: 0,1:27:08.68,1:27:10.05,Default,,0,0,0,,Иә! (Мотоко) Ах...
Dialogue: 0,1:27:17.39,1:27:18.90,Default,,0,0,0,,Уф... Мм!
Dialogue: 0,1:27:19.90,1:27:21.02,Default,,0,0,0,,Әй!
Dialogue: 0,1:27:37.87,1:27:39.96,Default,,0,0,0,,Сіз сонда болдыңыз...
Dialogue: 0,1:27:53.68,1:27:55.18,Default,,0,0,0,,(Серо) «Өте жылдам адам» деген лақап ат тек сән үшін ғана емес қой?
Dialogue: 0,1:27:55.81,1:27:57.56,Default,,0,0,0,,Кету уақыты келді
Dialogue: 0,1:28:26.75,1:28:27.59,Default,,0,0,0,,Курц!
Dialogue: 0,1:28:30.05,1:28:31.97,Default,,0,0,0,,Курц қайтыс болды
Dialogue: 0,1:28:32.09,1:28:37.06,Default,,0,0,0,,Егер сіз бір протездік денені басқарсаңыз да, сіз ешқашан сол адам ретінде әрекет ете алмайсыз.
Dialogue: 0,1:28:38.18,1:28:40.31,Default,,0,0,0,,Маған да біртүрлі.
Dialogue: 0,1:28:40.89,1:28:42.81,Default,,0,0,0,,Сіз мұны қашаннан бастап жасадыңыз?
Dialogue: 0,1:28:43.15,1:28:45.02,Default,,0,0,0,,Басынан бастап
Dialogue: 0,1:28:45.15,1:28:47.94,Default,,0,0,0,,Микромашиналар арқылы өсудің сәтсіздігін өтеу
Dialogue: 0,1:28:48.07,1:28:52.20,Default,,0,0,0,,Протездік денеге айнала алмаудың орнына мен көптеген протездік денелерге операция жасадым.
Dialogue: 0,1:28:52.74,1:28:56.16,Default,,0,0,0,,Бірақ сіз өз атыңызды айта алмадыңыз.
Dialogue: 0,1:28:56.28,1:28:57.45,Default,,0,0,0,,Өрт сөндірушілер туралы не деуге болады?
Dialogue: 0,1:28:57.95,1:29:00.37,Default,,0,0,0,,Оны жасаған сіз болдыңыз ба?
Dialogue: 0,1:29:12.30,1:29:14.30,Default,,0,0,0,,Ақырында түсінесіз
Dialogue: 0,1:29:14.43,1:29:16.93,Default,,0,0,0,,Ақпараттық пакеттердің әртүрлілігі және -
Dialogue: 0,1:29:17.06,1:29:19.97,Default,,0,0,0,,Жаңа әлемнің тууы
Dialogue: 0,1:29:20.68,1:29:22.52,Default,,0,0,0,,Мен сонда барамын
Dialogue: 0,1:29:22.64,1:29:24.06,Default,,0,0,0,,Барлығы бар жерге
Dialogue: 0,1:29:24.19,1:29:30.19,Default,,0,0,0,,♪～
Dialogue: 0,1:29:57.89,1:30:00.39,Default,,0,0,0,,Сіз бәрінен де еркін болдыңыз...
Dialogue: 0,1:30:00.52,1:30:03.77,Default,,0,0,0,,Осындай дүниеде қалғаныңа жаным ашиды.
Dialogue: 0,1:30:04.31,1:30:10.32,Default,,0,0,0,,♪～
Dialogue: 0,1:30:33.80,1:30:36.38,Default,,0,0,0,,Қоштаса алдыңыз ба?
Dialogue: 0,1:30:37.76,1:30:40.05,Default,,0,0,0,,Сен оны не үшін пайдаландың?
Dialogue: 0,1:30:40.85,1:30:43.14,Default,,0,0,0,,Кибер және протездік денелер, не болады...
Dialogue: 0,1:30:43.27,1:30:46.64,Default,,0,0,0,,Тұйықтан құтылудың екі мүмкіндігі...
Dialogue: 0,1:30:46.77,1:30:48.56,Default,,0,0,0,,Бұл сен және ол
Dialogue: 0,1:30:49.15,1:30:50.90,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,1:30:51.77,1:30:53.28,Default,,0,0,0,,Мені ал
Dialogue: 0,1:30:56.70,1:30:59.45,Default,,0,0,0,,Өлгендердің атын іздеуді қойған дұрыс.
Dialogue: 0,1:30:59.57,1:31:01.49,Default,,0,0,0,,Ештеңе пайда болмайды
Dialogue: 0,1:31:01.62,1:31:04.70,Default,,0,0,0,,Көп жылдар өлі болып өткен адамның кеңесі.
Dialogue: 0,1:31:09.96,1:31:10.84,Default,,0,0,0,,Не?
Dialogue: 0,1:31:10.96,1:31:12.50,Default,,0,0,0,,Мені өзіңізбен бірге алып кетпейсіз бе?
Dialogue: 0,1:31:12.63,1:31:14.46,Default,,0,0,0,,Біз қайда баруымыз керек...
Dialogue: 0,1:31:14.59,1:31:15.72,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,1:31:15.84,1:31:16.67,Default,,0,0,0,,А...
Dialogue: 0,1:31:17.76,1:31:21.60,Default,,0,0,0,,Бірыңғай стандарттарды алу үшін дене мен аруақты сату?
Dialogue: 0,1:31:21.72,1:31:24.39,Default,,0,0,0,,Берілмегендердің есебінен
Dialogue: 0,1:31:25.52,1:31:27.94,Default,,0,0,0,,Барлығыңызда кибернетика бар.
Dialogue: 0,1:31:28.06,1:31:29.85,Default,,0,0,0,,Артынан елес бар
Dialogue: 0,1:31:30.73,1:31:34.53,Default,,0,0,0,,Сіз басқалардан қалаған нәрсеңіздің орнына не ұсынғыңыз келеді?
Dialogue: 0,1:31:35.86,1:31:37.53,Default,,0,0,0,,Болашақты жасаңыз
Dialogue: 0,1:31:47.21,1:31:51.67,Default,,0,0,0,,Үкіметтің кейпінде, былайша айтқанда, біздің саудамызға сәйкес келеді.
Dialogue: 0,1:31:51.79,1:31:55.09,Default,,0,0,0,,Әйтеуір... Құл ел өз қызметіне немқұрайлы қараса...
Dialogue: 0,1:31:55.21,1:31:58.01,Default,,0,0,0,,Асыл елдер ашаршылыққа ұшырайды.
Dialogue: 0,1:31:58.30,1:32:01.43,Default,,0,0,0,,Жұмыс күшінің тапшылығы құл шаруашылығын байытады
Dialogue: 0,1:32:04.43,1:32:05.81,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,1:32:05.93,1:32:11.94,Default,,0,0,0,,♪～
Dialogue: 0,1:32:20.66,1:32:23.12,Default,,0,0,0,,Сіз мұны шынымен жасайсыз ба, майор?
Dialogue: 0,1:32:34.00,1:32:35.29,Default,,0,0,0,,Уф...
Dialogue: 0,1:32:36.21,1:32:37.71,Default,,0,0,0,,Уау... аа...
Dialogue: 0,1:32:38.88,1:32:40.72,Default,,0,0,0,,Қиыр Шығыс сауда министрлігінің өкіліне-
Dialogue: 0,1:32:40.84,1:32:44.51,Default,,0,0,0,,Сауда министрлігінің вице-министрі Ито және кәсіподақ басшылары...
Dialogue: 0,1:32:44.64,1:32:45.97,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,1:32:46.10,1:32:49.27,Default,,0,0,0,,Бұл жағдайды Сыртқы істер министрлігі мен Қорғаныс агенттігі де бақылап отыр.
Dialogue: 0,1:32:49.39,1:32:52.02,Default,,0,0,0,,Сот отырысына вице-министр Итоның қатысуын қалаймын.
Dialogue: 0,1:32:52.14,1:32:55.02,Default,,0,0,0,,Премьер-министрдің өлтірілуіне қатысты мәлімдеме алу
Dialogue: 0,1:32:55.15,1:32:56.15,Default,,0,0,0,,Бітті
Dialogue: 0,1:32:56.36,1:33:00.03,Default,,0,0,0,,Бұл мүмкін емес. Ол баспана сұрады және қабылданды.
Dialogue: 0,1:33:00.15,1:33:01.82,Default,,0,0,0,,Сондай-ақ антқа қол қойды
Dialogue: 0,1:33:01.95,1:33:02.78,Default,,0,0,0,,Қашан! ?
Dialogue: 0,1:33:02.91,1:33:04.28,Default,,0,0,0,,Жауап беруге міндетті емес
Dialogue: 0,1:33:04.41,1:33:08.37,Default,,0,0,0,,Құжаттар елшілікте. Мен оларды кейінірек сізге жіберемін.
Dialogue: 0,1:33:08.49,1:33:12.21,Default,,0,0,0,,Бұрынғы премьер-министрдің өсиеттері әлі де тірі. Ол өлтіріледі.
Dialogue: 0,1:33:12.33,1:33:16.17,Default,,0,0,0,,Хмм... Бұл пацифист өркениетті ел.
Dialogue: 0,1:33:16.29,1:33:17.55,Default,,0,0,0,,Иә
Dialogue: 0,1:33:24.72,1:33:25.55,Default,,0,0,0,,Бұл терезенің сыртында!
Dialogue: 0,1:33:30.35,1:33:31.43,Default,,0,0,0,,Көмек!
Dialogue: 0,1:33:31.56,1:33:32.85,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:33:44.20,1:33:50.20,Default,,0,0,0,,♪～
Dialogue: 0,1:35:39.15,1:35:41.86,Default,,0,0,0,,Шиенің бірге гүлдегенін көру қандай жақсы.
Dialogue: 0,1:35:41.98,1:35:43.73,Default,,0,0,0,,Бұл да жұмыс, иә?
Dialogue: 0,1:35:44.07,1:35:47.40,Default,,0,0,0,,Шие гүлдерін 24 сағат бойы бақылау.
Dialogue: 0,1:35:52.49,1:35:55.33,Default,,0,0,0,,Майор, менің Минамишинхаманың 4-бөлімінде істейтін жұмысым бар...
Dialogue: 0,1:35:55.45,1:35:56.79,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,1:35:57.29,1:35:59.62,Default,,0,0,0,,Бюджет қабылданды. Жұмысты орында.
Dialogue: 0,1:36:00.12,1:36:01.08,Default,,0,0,0,,Логикома!
Dialogue: 0,1:36:01.21,1:36:02.25,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,1:36:02.38,1:36:05.55,Default,,0,0,0,,Қарау комиссиясының бюджеттің өтуі туралы есебі расталды!
Dialogue: 0,1:36:05.67,1:36:08.30,Default,,0,0,0,,Жақсы! Шие гүлінің мониторингі тоқтатылды
Dialogue: 0,1:36:10.97,1:36:12.22,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:36:16.68,1:36:20.06,Default,,0,0,0,,Балалар, мен алған ең жақсы бөліктер сендерсіңдер.
Dialogue: 0,1:36:20.39,1:36:22.10,Default,,0,0,0,,Орындауды көрсету-
Dialogue: 0,1:36:22.19,1:36:23.40,Default,,0,0,0,,Істі алыңыз!
Dialogue: 0,1:36:23.52,1:36:29.53,Default,,0,0,0,,♪～
Dialogue: 0,1:36:31.03,1:36:37.03,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory