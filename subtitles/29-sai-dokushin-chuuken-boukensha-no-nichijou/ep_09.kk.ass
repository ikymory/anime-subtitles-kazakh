Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.34,0:00:12.17,Default,,0,0,0,,Иә...
Dialogue: 0,0:00:13.63,0:00:14.89,Default,,0,0,0,,Я...
Dialogue: 0,0:00:15.01,0:00:18.18,Default,,0,0,0,,Уф... бұл қалай да болды.
Dialogue: 0,0:00:21.85,0:00:24.85,Default,,0,0,0,,Жақсысың ба, Муратсуки? Сіздің қолыңыз...
Dialogue: 0,0:00:24.98,0:00:26.52,Default,,0,0,0,,Ауылға тез қайтайық!
Dialogue: 0,0:00:26.65,0:00:28.57,Default,,0,0,0,,Кенеттен бөртпелерді емдеу синит
Dialogue: 0,0:00:28.69,0:00:30.78,Default,,0,0,0,,О, қазірдің өзінде! Шулы!
Dialogue: 0,0:00:30.90,0:00:32.90,Default,,0,0,0,,Ондай қатты дыбыс шығармаңдар!
Dialogue: 0,0:00:33.03,0:00:34.70,Default,,0,0,0,,Оған сызаттар әсер етеді!
Dialogue: 0,0:00:34.82,0:00:38.62,Default,,0,0,0,,Кешіріңіз! Бірақ бұлай толқу қалыпты жағдай!
Dialogue: 0,0:00:38.78,0:00:41.54,Default,,0,0,0,,Сіз шынымен жақсысыз ба?
Dialogue: 0,0:00:42.45,0:00:43.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:44.08,0:00:49.42,Default,,0,0,0,,(Лилуидің айқайы)
Dialogue: 0,0:00:49.63,0:00:53.92,Default,,0,0,0,,Менің қаным жетпейді...
Dialogue: 0,0:00:55.43,0:00:57.43,Default,,0,0,0,,Айтайын дегенім көп.
Dialogue: 0,0:00:58.39,0:01:00.39,Default,,0,0,0,,Мен қазір қайтайын...
Dialogue: 0,0:01:07.27,0:01:08.06,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:08.19,0:01:09.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:15.07,0:01:17.57,Default,,0,0,0,,Хаджиме-сан, бұл қол!
Dialogue: 0,0:01:17.70,0:01:21.91,Default,,0,0,0,,Амансың ба? Тез емделіңіз!
Dialogue: 0,0:01:22.41,0:01:25.37,Default,,0,0,0,,♪～
Dialogue: 0,0:02:48.58,0:02:51.54,Default,,0,0,0,,～♪
Dialogue: 0,0:02:56.42,0:02:57.46,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:00.47,0:03:01.97,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:03:07.10,0:03:10.98,Default,,0,0,0,,Ах... ха
Dialogue: 0,0:03:14.56,0:03:19.07,Default,,0,0,0,,Сол қолымды жеп қойды ма...
Dialogue: 0,0:03:19.19,0:03:21.41,Default,,0,0,0,,(асқазанның ырғағы)
Dialogue: 0,0:03:22.32,0:03:25.62,Default,,0,0,0,,Менің де бірдеңе жегім келеді...
Dialogue: 0,0:03:25.83,0:03:28.58,Default,,0,0,0,,<Не істеп жатырсың! ＞
Dialogue: 0,0:03:28.70,0:03:30.62,Default,,0,0,0,,<Күміс дәрежелі әскери қуат>
Dialogue: 0,0:03:30.75,0:03:34.63,Default,,0,0,0,,<Ол біз үшін өте құнды, авантюристер гильдиясы! ＞
Dialogue: 0,0:03:34.75,0:03:37.88,Default,,0,0,0,,<Әсіресе ауылдық жерде кең аумақты қамтығанда>
Dialogue: 0,0:03:38.00,0:03:41.63,Default,,0,0,0,,<Олар ойнайтын рөл табиғи түрде өседі>
Dialogue: 0,0:03:41.76,0:03:44.93,Default,,0,0,0,,<Сондықтан біз оларды ұзақ уақыт пайдалана аламыз>
Dialogue: 0,0:03:45.05,0:03:48.39,Default,,0,0,0,,<Біз сұрауды мұқият тексеруіміз керек.>
Dialogue: 0,0:03:48.56,0:03:53.15,Default,,0,0,0,,<Жағдай мүмкіндігінше тезірек күштерді қалпына келтіруге басымдық беріңіз>
Dialogue: 0,0:03:53.35,0:03:55.40,Default,,0,0,0,,<Алыстағы сөйлесуді аяқтайды>
Dialogue: 0,0:03:55.52,0:03:58.65,Default,,0,0,0,,Иә Алыс қашықтықтағы әңгімені аяқтайды
Dialogue: 0,0:04:03.91,0:04:04.82,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:04.99,0:04:07.58,Default,,0,0,0,,О~ Олив-чан
Dialogue: 0,0:04:07.70,0:04:11.58,Default,,0,0,0,,Бұл тағам Оливчандікі ме? Ах~
Dialogue: 0,0:04:11.71,0:04:14.83,Default,,0,0,0,,Жоқ, мен аш болдым.
Dialogue: 0,0:04:15.33,0:04:17.09,Default,,0,0,0,,А...
Dialogue: 0,0:04:17.59,0:04:19.34,Default,,0,0,0,,Меніңше, бұл матч…
Dialogue: 0,0:04:19.50,0:04:22.97,Default,,0,0,0,,Мен екі квази апат класы болады деп күтпедім...
Dialogue: 0,0:04:23.09,0:04:26.34,Default,,0,0,0,,Бұл жерде толық ақпарат жетіспеді!
Dialogue: 0,0:04:26.47,0:04:30.10,Default,,0,0,0,,Шинономе мырзадан кешірім сұраудың жолы жоқ!
Dialogue: 0,0:04:32.52,0:04:35.35,Default,,0,0,0,,Жоғары қара, Олив-чан.
Dialogue: 0,0:04:44.28,0:04:47.62,Default,,0,0,0,,Хмм... жақсы...
Dialogue: 0,0:04:47.91,0:04:51.37,Default,,0,0,0,,Жарайды... Менің оң қолым әлі бар, сондықтан бұл мәселе емес.
Dialogue: 0,0:04:51.54,0:04:53.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:54.00,0:04:57.96,Default,,0,0,0,,Хахахаха! Мен жарақат алған адаммын
Dialogue: 0,0:04:58.08,0:04:59.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:01.55,0:05:03.88,Default,,0,0,0,,Егер бұл мағынасы бар болса
Dialogue: 0,0:05:04.09,0:05:05.97,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:05:07.43,0:05:11.81,Default,,0,0,0,,Жоқ... Саған ұсынуға жүрегім жетпейді...
Dialogue: 0,0:05:11.93,0:05:13.85,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:15.73,0:05:18.48,Default,,0,0,0,,Бүгін екінші қабатта демалыңыз.
Dialogue: 0,0:05:18.61,0:05:19.65,Default,,0,0,0,,Хамф!
Dialogue: 0,0:05:20.48,0:05:22.23,Default,,0,0,0,,(есіктің ашылу/жабылу дыбысы)
Dialogue: 0,0:05:38.63,0:05:41.63,Default,,0,0,0,,Адамдар келе береді...
Dialogue: 0,0:05:42.25,0:05:44.71,Default,,0,0,0,,<Лилли не істеп жатыр? ＞
Dialogue: 0,0:05:44.84,0:05:47.13,Default,,0,0,0,,＜Мен оны бүгін әлі қараған жоқпын...＞
Dialogue: 0,0:05:47.51,0:05:49.80,Default,,0,0,0,,Қария, ояусың ба?
Dialogue: 0,0:05:49.93,0:05:51.51,Default,,0,0,0,,О? О...
Dialogue: 0,0:05:51.64,0:05:54.14,Default,,0,0,0,,Уау, менің қолым жоқ!
Dialogue: 0,0:05:54.31,0:05:57.19,Default,,0,0,0,,Ауырмайды ма? Сенімен бәрі жақсы ма?
Dialogue: 0,0:05:57.44,0:06:00.44,Default,,0,0,0,,Жарайды, сызаттар емдеу әдістерімен жазылды.
Dialogue: 0,0:06:00.56,0:06:04.48,Default,,0,0,0,,Олар маған қан жетпейді демалайық деді.
Dialogue: 0,0:06:08.86,0:06:12.53,Default,,0,0,0,,Осы ауылға келгеннен бері.
Dialogue: 0,0:06:12.66,0:06:17.21,Default,,0,0,0,,Сіз ауылдағы бір жас жігітке көмектескен сияқтысыз, сондықтан мен сізге ризамын.
Dialogue: 0,0:06:17.91,0:06:20.42,Default,,0,0,0,,Ол гномдардың басшысы ма?
Dialogue: 0,0:06:20.54,0:06:23.96,Default,,0,0,0,,Біз бір ауылданбыз, мен саған көмектесемін.
Dialogue: 0,0:06:24.05,0:06:28.76,Default,,0,0,0,,Хахахаха, отырсам болады ма?
Dialogue: 0,0:06:28.88,0:06:29.93,Default,,0,0,0,,О
Dialogue: 0,0:06:33.56,0:06:36.73,Default,,0,0,0,,Бүгін сол себепті келдім.
Dialogue: 0,0:06:36.85,0:06:39.27,Default,,0,0,0,,<Ештеңе болмағандай! ＞
Dialogue: 0,0:06:39.39,0:06:41.98,Default,,0,0,0,,Жоғалған сол қолыңыз...
Dialogue: 0,0:06:42.11,0:06:45.69,Default,,0,0,0,,Мен сізбен сол жерде киетін протездік қол туралы сөйлескім келді.
Dialogue: 0,0:06:47.11,0:06:50.70,Default,,0,0,0,,Мен негізінен каракуримен айналысамын.
Dialogue: 0,0:06:50.95,0:06:55.08,Default,,0,0,0,,Мен бірнеше қолдар мен аяқтарды протездеуде де жұмыс жасадым.
Dialogue: 0,0:06:55.20,0:06:57.70,Default,,0,0,0,,Сіз қарсы емессіз деп үміттенемін.
Dialogue: 0,0:06:59.04,0:07:03.25,Default,,0,0,0,,О! Бұл жақсы! Оның техникасы керемет!
Dialogue: 0,0:07:03.38,0:07:05.30,Default,,0,0,0,,Вена Гашан!
Dialogue: 0,0:07:05.42,0:07:09.26,Default,,0,0,0,,Олар сізге техникалық қызмет көрсетуді де жасай алады, сондықтан сіз оларды тек сіз үшін жасай аласыз!
Dialogue: 0,0:07:09.38,0:07:12.72,Default,,0,0,0,,А, қанша ақша?
Dialogue: 0,0:07:13.05,0:07:15.56,Default,,0,0,0,,Иә? Оған ауыл мен гильдия ие болады.
Dialogue: 0,0:07:15.68,0:07:17.47,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:07:18.39,0:07:23.23,Default,,0,0,0,,Жарайды, кешіріңізші.
Dialogue: 0,0:07:23.36,0:07:28.15,Default,,0,0,0,,Хмм... Ұшатын тескіш бұрғы...
Dialogue: 0,0:07:28.28,0:07:30.03,Default,,0,0,0,,Бұл романтикалық.
Dialogue: 0,0:07:30.15,0:07:32.61,Default,,0,0,0,,<Бұрғылау? Бұл не>
Dialogue: 0,0:07:32.99,0:07:36.24,Default,,0,0,0,,Олай болса, ақсақал! Менен бірдеңе істеуімді қалайсыз ба?
Dialogue: 0,0:07:36.37,0:07:38.12,Default,,0,0,0,,Сіз кез келген нәрсені айта аласыз!
Dialogue: 0,0:07:38.24,0:07:39.50,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:39.70,0:07:42.21,Default,,0,0,0,,Бұл туралы ерекше ештеңе жоқ...
Dialogue: 0,0:07:42.83,0:07:43.88,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:44.08,0:07:47.88,Default,,0,0,0,,Лилли! Ол маған қонаққа да келмеді. Сен не істеп жатырсың?
Dialogue: 0,0:07:48.00,0:07:50.22,Default,,0,0,0,,Иә? Лили сонда ма?
Dialogue: 0,0:07:51.59,0:07:53.13,Default,,0,0,0,,Аа, бұл рас!
Dialogue: 0,0:07:53.51,0:07:55.39,Default,,0,0,0,,Сәлем Лилли!
Dialogue: 0,0:07:55.51,0:07:56.43,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:57.56,0:07:59.39,Default,,0,0,0,,А, сен қашып кеттің!?
Dialogue: 0,0:07:59.52,0:08:01.77,Default,,0,0,0,,Қолымнан айырылып қалсам да оны қорғап тұрдым.
Dialogue: 0,0:08:01.94,0:08:03.19,Default,,0,0,0,,…жылдам бітеді!
Dialogue: 0,0:08:03.31,0:08:06.15,Default,,0,0,0,,Шынымен!? Сосын қашып кет, жігітім!
Dialogue: 0,0:08:06.86,0:08:09.19,Default,,0,0,0,,Неліктен? Мен сенің өміріңді сақтап қалдым.
Dialogue: 0,0:08:09.32,0:08:11.53,Default,,0,0,0,,Жоқ, бұл ыңғайсыз!
Dialogue: 0,0:08:11.65,0:08:15.03,Default,,0,0,0,,Сіздің денеңіз шытырман оқиғаға қабілетсіз болып қалды ма? Менің ойымша, бұл!
Dialogue: 0,0:08:15.99,0:08:17.78,Default,,0,0,0,,Мен...
Dialogue: 0,0:08:17.91,0:08:19.83,Default,,0,0,0,,Әйелдің жүрегі қандай?
Dialogue: 0,0:08:20.25,0:08:22.04,Default,,0,0,0,,Менің ойымша, бұл адамшылық…
Dialogue: 0,0:08:23.79,0:08:27.29,Default,,0,0,0,,Мен енді шытырман оқиғаға бара алмаймын...
Dialogue: 0,0:08:27.84,0:08:30.76,Default,,0,0,0,,Менің таңдауым жоқ. Кеттік, Аньянго!
Dialogue: 0,0:08:30.88,0:08:32.72,Default,,0,0,0,,? Эй!
Dialogue: 0,0:08:37.05,0:08:40.68,Default,,0,0,0,,Хаджиме~! Тоқта!
Dialogue: 0,0:08:40.81,0:08:45.15,Default,,0,0,0,,Бұл жақсы емес! Не ойлап отырсың, Хаджиме!
Dialogue: 0,0:08:45.27,0:08:47.02,Default,,0,0,0,,Тыныш болу керек!
Dialogue: 0,0:08:47.15,0:08:48.44,Default,,0,0,0,,Дұрыс, ақсақал!
Dialogue: 0,0:08:48.57,0:08:50.78,Default,,0,0,0,,Гильдиядағы апа жылап тұрды!
Dialogue: 0,0:08:50.90,0:08:55.20,Default,,0,0,0,,Гяаа! Жоқ! Біраз уақыт үзіліс жасаңыз!
Dialogue: 0,0:08:55.32,0:08:57.45,Default,,0,0,0,,Бұл оның жұмысы.
Dialogue: 0,0:08:57.57,0:08:59.95,Default,,0,0,0,,Қайту керек, Хажиме!
Dialogue: 0,0:09:00.24,0:09:02.95,Default,,0,0,0,,Шлам шықса не істеу керек!
Dialogue: 0,0:09:03.08,0:09:04.08,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:09:04.37,0:09:07.75,Default,,0,0,0,,Сіз ауыр жарақат алдыңыз! Сіз соққы аласыз!
Dialogue: 0,0:09:07.88,0:09:10.09,Default,,0,0,0,,Сіз мұны істемеуіңіз керек.
Dialogue: 0,0:09:10.21,0:09:11.13,Default,,0,0,0,,Таку
Dialogue: 0,0:09:11.42,0:09:13.38,Default,,0,0,0,,Бұл жерде. Мұнда.
Dialogue: 0,0:09:13.51,0:09:15.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:15.34,0:09:18.60,Default,,0,0,0,,Бүгінгі жұмысымыз йогур жемісін жинау.
Dialogue: 0,0:09:18.97,0:09:23.39,Default,,0,0,0,,Бірақ Хаджиме, мен енді бұлай ағашқа шыға алмаймын.
Dialogue: 0,0:09:23.52,0:09:24.56,Default,,0,0,0,,Неапольдың ең үздік жиһаз шебері Марионың ұлы болып дүниеге келген
Dialogue: 0,0:09:25.35,0:09:26.60,Default,,0,0,0,,Гааах!
Dialogue: 0,0:09:27.19,0:09:29.48,Default,,0,0,0,,Мұқият қара, ақымақ.
Dialogue: 0,0:09:33.82,0:09:37.95,Default,,0,0,0,,Мен жоғарыдан арқан іліп қоямын, балалар оған өрмелеп алыңдар.
Dialogue: 0,0:09:40.24,0:09:41.53,Default,,0,0,0,,Бұл өте тайғақ...
Dialogue: 0,0:09:41.66,0:09:42.74,Default,,0,0,0,,(Жын-шайтанның айқайы)
Dialogue: 0,0:09:42.91,0:09:46.71,Default,,0,0,0,,Ах! Ей, жолыма кедергі болма!
Dialogue: 0,0:09:46.92,0:09:48.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:48.17,0:09:49.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:49.50,0:09:51.50,Default,,0,0,0,,Ахх! (құлап түскен дыбыс)
Dialogue: 0,0:09:51.63,0:09:53.71,Default,,0,0,0,,Хажиме! Қарт адам!
Dialogue: 0,0:09:58.22,0:10:03.81,Default,,0,0,0,,Жарайды, шамалы қателік болды, бірақ менің қолымда оңай жеңіс болды.
Dialogue: 0,0:10:03.93,0:10:05.89,Default,,0,0,0,,А... иә?
Dialogue: 0,0:10:06.02,0:10:11.27,Default,,0,0,0,,Лиллидің арқасында мен бұдан былай ағаштарға қанағаттанарлықтай көтеріле алмаймын!
Dialogue: 0,0:10:11.86,0:10:13.32,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:10:13.98,0:10:15.61,Default,,0,0,0,,Әрине.
Dialogue: 0,0:10:15.82,0:10:18.36,Default,,0,0,0,,Саған айтқым келген көп нәрсе болды.
Dialogue: 0,0:10:18.49,0:10:19.11,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:20.03,0:10:24.37,Default,,0,0,0,,Мен ұзақ сөйлей алмаймын, сондықтан бір сөзбен айтып берейін.
Dialogue: 0,0:10:28.75,0:10:31.00,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:10:36.76,0:10:39.88,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:10:42.01,0:10:43.43,Default,,0,0,0,,Хаджиме...
Dialogue: 0,0:10:43.56,0:10:44.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:44.89,0:10:47.89,Default,,0,0,0,,Лилуи мен күшті боламын...
Dialogue: 0,0:10:48.98,0:10:49.98,Default,,0,0,0,,О
Dialogue: 0,0:10:50.56,0:10:53.02,Default,,0,0,0,,Хаджименің сол қолын ауыстырғандай...
Dialogue: 0,0:10:53.15,0:10:57.32,Default,,0,0,0,,Жоқ! Мен саған Хажимені тамақтандыратындай күшті екенімді көрсетемін!
Dialogue: 0,0:10:59.45,0:11:01.45,Default,,0,0,0,,Хе! Мүмкін емес.
Dialogue: 0,0:11:01.57,0:11:04.62,Default,,0,0,0,,Мен де күшейіп, қартқа қалталы ақша беремін.
Dialogue: 0,0:11:04.74,0:11:07.29,Default,,0,0,0,,Сіз екі балаға сутенерсіз бе...
Dialogue: 0,0:11:08.71,0:11:09.54,Default,,0,0,0,,Мен оның қоректік тұрғыдан теңдестірілгеніне көз жеткіздім — тіпті ішіне сенің сүйікті раковиналарыңды да қостым.
Dialogue: 0,0:11:11.71,0:11:13.04,Default,,0,0,0,,Уф…
Dialogue: 0,0:11:14.17,0:11:16.96,Default,,0,0,0,,Мен үмітсіз күтемін
Dialogue: 0,0:11:23.51,0:11:24.51,Default,,0,0,0,,Уф…
Dialogue: 0,0:11:24.68,0:11:29.02,Default,,0,0,0,,"Демал" дегенге үйрене алмай жүрмін...
Dialogue: 0,0:11:29.18,0:11:33.77,Default,,0,0,0,,Жақын арада қолды протездеуге болады ма деп ойлаймын. Менің жұмысым көп.
Dialogue: 0,0:11:33.90,0:11:36.07,Default,,0,0,0,,Мен жұмысқа тез оралуым керек.
Dialogue: 0,0:11:36.19,0:11:39.99,Default,,0,0,0,,Идиот, қол протезін жақсы жасағанына көз жеткіз!
Dialogue: 0,0:11:40.11,0:11:41.36,Default,,0,0,0,,А? Уа!
Dialogue: 0,0:11:41.49,0:11:43.28,Default,,0,0,0,,Верониканың әпкесі!
Dialogue: 0,0:11:43.41,0:11:45.03,Default,,0,0,0,,Қайтып келдіңіз бе?
Dialogue: 0,0:11:45.16,0:11:48.62,Default,,0,0,0,,Менің бала кездегі досымның ауыр жарақат алғанын естідім.
Dialogue: 0,0:11:49.66,0:11:54.67,Default,,0,0,0,,Сіз қайтып келгенше гильдия жұмысымен айналысамыз.
Dialogue: 0,0:11:55.08,0:11:56.46,Default,,0,0,0,,Сіз не жоспарлап отырсыз?
Dialogue: 0,0:11:56.59,0:11:58.34,Default,,0,0,0,,Дөрекі адам.
Dialogue: 0,0:11:59.13,0:12:00.88,Default,,0,0,0,,Орындық Иә!
Dialogue: 0,0:12:02.26,0:12:05.72,Default,,0,0,0,,Ауыр жарақат алғаннан кейін авантюрист шытырман оқиғаға аттанады...\NСіз
Dialogue: 0,0:12:05.89,0:12:08.47,Default,,0,0,0,,-ді жиі көрдіңіз, солай ма?
Dialogue: 0,0:12:08.60,0:12:11.27,Default,,0,0,0,,Оңалтуды қоса алғанда, бар күшіңізді салыңыз.
Dialogue: 0,0:12:11.39,0:12:14.56,Default,,0,0,0,,Жоқ, бірақ сен жақсысың ба?
Dialogue: 0,0:12:14.69,0:12:18.07,Default,,0,0,0,,Алғашында мен ақылсыз болғым келмеді.
Dialogue: 0,0:12:18.19,0:12:22.15,Default,,0,0,0,,Бұл жігіт әлі күнге дейін күміс жүлдегерлер арасында бірінші орында.
Dialogue: 0,0:12:22.28,0:12:23.15,Default,,0,0,0,,Иә!?
Dialogue: 0,0:12:23.28,0:12:25.66,Default,,0,0,0,,<Сен жәй ғана бұзық емес пе едің? ＞
Dialogue: 0,0:12:25.87,0:12:30.41,Default,,0,0,0,,Жарайды, сондықтан, ол үшін алаңдамай, қалпына келтіруге тырысыңыз.
Dialogue: 0,0:12:33.75,0:12:37.96,Default,,0,0,0,,Асықпай асықпай уақытыңызды алатын жақсы.
Dialogue: 0,0:12:38.09,0:12:40.21,Default,,0,0,0,,Протездік қолдың сапасын арттыру
Dialogue: 0,0:12:40.34,0:12:43.76,Default,,0,0,0,,Саған да, ауылға да жақсы.
Dialogue: 0,0:12:43.88,0:12:44.68,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:12:45.39,0:12:49.68,Default,,0,0,0,,Мен жалған нейрондық схеманы құруға тырыстым, бірақ сіз қалай ойлайсыз?
Dialogue: 0,0:12:49.85,0:12:52.43,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:12:52.56,0:12:56.44,Default,,0,0,0,,Қозғал, қозғал! Керемет протездік қол!
Dialogue: 0,0:12:56.56,0:12:59.44,Default,,0,0,0,,Бірақ менде ешқандай сезім жоқ.
Dialogue: 0,0:12:59.57,0:13:02.94,Default,,0,0,0,,Ергежейлі технологияның өзінде, бәрі осы.
Dialogue: 0,0:13:03.90,0:13:08.45,Default,,0,0,0,,Бірақ бұдан басқа, біз өзіміздің төл дағдыларымыздан асып түсетінімізді көрсетейік!
Dialogue: 0,0:13:08.70,0:13:11.24,Default,,0,0,0,,Кез келген шытырман оқиға сияқты!
Dialogue: 0,0:13:11.37,0:13:14.21,Default,,0,0,0,,Иә! Жанартауға құлап кетсем де!
Dialogue: 0,0:13:14.33,0:13:18.63,Default,,0,0,0,,Мені айдаһар басып кетсе де! Мен тіпті білмеймін!
Dialogue: 0,0:13:18.75,0:13:20.29,Default,,0,0,0,,Мен шыдай аламын ба?
Dialogue: 0,0:13:21.46,0:13:24.51,Default,,0,0,0,,А... Міне, сондықтан гномдар...
Dialogue: 0,0:13:24.63,0:13:26.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:27.09,0:13:28.09,Default,,0,0,0,,Ақша, мәртебе және әдемі әйел.
Dialogue: 0,0:13:28.22,0:13:29.22,Default,,0,0,0,,О!
Dialogue: 0,0:13:29.39,0:13:31.22,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:13:31.72,0:13:33.64,Default,,0,0,0,,Мен орындық жасап жатыр едім.
Dialogue: 0,0:13:33.81,0:13:36.48,Default,,0,0,0,,Қараңдаршы, кеше бастық оны басып тастады, солай ма?
Dialogue: 0,0:13:36.60,0:13:37.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:37.69,0:13:41.19,Default,,0,0,0,,Бұл орындық оған нағыз айдаһар мінсе де сынбайды!
Dialogue: 0,0:13:41.32,0:13:43.48,Default,,0,0,0,,Ол, сөзсіз, ергежейлі.
Dialogue: 0,0:13:43.61,0:13:45.95,Default,,0,0,0,,Бұл керемет, Аня-чан!
Dialogue: 0,0:13:46.07,0:13:48.07,Default,,0,0,0,,Сіз осындай нәрсені оңай жасай аласыз.
Dialogue: 0,0:13:48.20,0:13:50.41,Default,,0,0,0,,Хехе... Мені олай мақтамаңыз!
Dialogue: 0,0:13:50.53,0:13:53.37,Default,,0,0,0,,Ал, Чо менің қожайыным, сондықтан белгілі бір дәрежеде!
Dialogue: 0,0:13:53.49,0:13:54.75,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:13:54.87,0:13:57.58,Default,,0,0,0,,Шебердің мағынасын түсінесің бе?
Dialogue: 0,0:13:57.71,0:13:58.83,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:13:58.96,0:14:01.50,Default,,0,0,0,,Мен білемін. Ол жақсы жігіт, солай ма?
Dialogue: 0,0:14:01.63,0:14:02.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:02.71,0:14:04.38,Default,,0,0,0,,Гуааа?
Dialogue: 0,0:14:04.55,0:14:06.30,Default,,0,0,0,,(Қол Перісі) Құтқарып болмайды… Соңғы көргенім – демон өлтірушінің жүзі болар деп кім ойлаған…
Dialogue: 0,0:14:06.42,0:14:08.68,Default,,0,0,0,,Дай қария! (2 адам) Иә!?
Dialogue: 0,0:14:08.84,0:14:10.43,Default,,0,0,0,,Дай ата, амансыз ба?
Dialogue: 0,0:14:10.55,0:14:11.85,Default,,0,0,0,,Аньянго-чан
Dialogue: 0,0:14:11.97,0:14:13.10,Default,,0,0,0,,О
Dialogue: 0,0:14:13.22,0:14:15.98,Default,,0,0,0,,Шалғамды қайтадан теріп арқаң ауырды ма?
Dialogue: 0,0:14:16.10,0:14:19.52,Default,,0,0,0,,А, бірақ мен бүгін тағы біраз жұмыс істеуім керек...
Dialogue: 0,0:14:19.65,0:14:20.86,Default,,0,0,0,,Бізбен бірге болыңыз!
Dialogue: 0,0:14:20.98,0:14:22.77,Default,,0,0,0,,Оны қозғалтуға мәжбүрлемеңіз
Dialogue: 0,0:14:23.02,0:14:26.78,Default,,0,0,0,,Ата! Оны Лиллиге және басқаларға қалдырыңыз!
Dialogue: 0,0:14:28.91,0:14:30.87,Default,,0,0,0,,Мен одан құтылуым керек пе?
Dialogue: 0,0:14:30.99,0:14:32.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:32.83,0:14:34.20,Default,,0,0,0,,Сено…
Dialogue: 0,0:14:34.33,0:14:36.12,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:14:36.29,0:14:37.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:37.54,0:14:38.96,Default,,0,0,0,,Гяааах!
Dialogue: 0,0:14:39.08,0:14:42.92,Default,,0,0,0,,Мынау не жігіт!? Бұл жиіркенішті!
Dialogue: 0,0:14:43.04,0:14:45.13,Default,,0,0,0,,Маған қашуға рұқсат етіңіз!
Dialogue: 0,0:14:45.25,0:14:46.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:50.76,0:14:51.93,Default,,0,0,0,,Оу!
Dialogue: 0,0:14:52.05,0:14:53.51,Default,,0,0,0,,Сіз мұны істемейсіз!
Dialogue: 0,0:14:53.64,0:14:55.43,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:14:55.60,0:14:57.60,Default,,0,0,0,,Уау... Аня-чан, бұл керемет!
Dialogue: 0,0:14:57.73,0:14:59.44,Default,,0,0,0,,Лиллиге де айт!
Dialogue: 0,0:14:59.94,0:15:03.27,Default,,0,0,0,,О, сен жақсы болып қалдың.
Dialogue: 0,0:15:03.40,0:15:05.23,Default,,0,0,0,,Сізге қария сабақ берді ме?
Dialogue: 0,0:15:05.48,0:15:09.95,Default,,0,0,0,,Хехе, Аньянгоның шалғам теретін шебері мен!
Dialogue: 0,0:15:11.82,0:15:13.95,Default,,0,0,0,,<Мастер...>
Dialogue: 0,0:15:19.04,0:15:23.50,Default,,0,0,0,,О! Былғары қолғап киетін болсам, қол протезі туралы көп білмеймін.
Dialogue: 0,0:15:23.63,0:15:26.46,Default,,0,0,0,,Сізге ұнаған сияқты, ең бастысы.
Dialogue: 0,0:15:26.63,0:15:30.34,Default,,0,0,0,,Дегенмен, бұл ғажайып технология.
Dialogue: 0,0:15:30.47,0:15:33.80,Default,,0,0,0,,Эй...сенің де шеберің бар ма?
Dialogue: 0,0:15:33.93,0:15:39.73,Default,,0,0,0,,Дұрыс. Жас кезімде ұстаздың қол астында өнерімді шыңдадым.
Dialogue: 0,0:15:40.02,0:15:42.69,Default,,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:15:42.85,0:15:45.31,Default,,0,0,0,,<Мен доғал қару қолданамын>
Dialogue: 0,0:15:45.48,0:15:47.65,Default,,0,0,0,,<Ол қылыш>
Dialogue: 0,0:15:47.94,0:15:52.11,Default,,0,0,0,,<Мен рухани өнерде жақсы емеспін, бірақ Лилли оны жақсы біледі>
Dialogue: 0,0:15:52.28,0:15:56.33,Default,,0,0,0,,<Менен басқа біреуден үйренсе жақсы болар еді.>
Dialogue: 0,0:15:56.95,0:15:59.70,Default,,0,0,0,,Иә, бұл не түйме?
Dialogue: 0,0:16:00.20,0:16:01.21,Default,,0,0,0,,Фуфу
Dialogue: 0,0:16:01.91,0:16:02.83,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:16:02.96,0:16:04.79,Default,,0,0,0,,(Хаджиме мен оның достарының күлкісі)
Dialogue: 0,0:16:04.92,0:16:06.84,Default,,0,0,0,,Не болып жатыр!?
Dialogue: 0,0:16:07.59,0:16:09.63,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:16:09.76,0:16:12.34,Default,,0,0,0,,Қайтадан қош келдіңіз! а!
Dialogue: 0,0:16:12.51,0:16:15.18,Default,,0,0,0,,Хажиме-сан, сенде протездік қол бар!
Dialogue: 0,0:16:15.30,0:16:17.39,Default,,0,0,0,,А, бұл жақсы сезім.
Dialogue: 0,0:16:17.51,0:16:19.43,Default,,0,0,0,,Керемет!
Dialogue: 0,0:16:19.56,0:16:20.27,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:16:20.43,0:16:22.64,Default,,0,0,0,,Ол да қайтып келді ме?
Dialogue: 0,0:16:22.77,0:16:25.15,Default,,0,0,0,,Бұл өте сәтті болған сияқты!
Dialogue: 0,0:16:25.27,0:16:28.32,Default,,0,0,0,,Қылыш өнері де, рух өнері де керемет еді!
Dialogue: 0,0:16:28.52,0:16:29.65,Default,,0,0,0,,Төраға!
Dialogue: 0,0:16:29.78,0:16:31.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:33.49,0:16:35.11,Default,,0,0,0,,(қадамға жақындау)
Dialogue: 0,0:16:35.24,0:16:36.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:36.57,0:16:38.37,Default,,0,0,0,,J…
Dialogue: 0,0:16:38.53,0:16:39.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:43.46,0:16:45.37,Default,,0,0,0,,Сізге қажет нәрсе бар ма?
Dialogue: 0,0:16:45.50,0:16:48.09,Default,,0,0,0,,Оның жасы үлкен екенін білетінмін, бірақ бұл…
Dialogue: 0,0:16:48.29,0:16:50.00,Default,,0,0,0,,Ммм
Dialogue: 0,0:16:51.76,0:16:52.88,Default,,0,0,0,,Ұшу
Dialogue: 0,0:16:55.13,0:16:57.64,Default,,0,0,0,,ше? Енді ше?
Dialogue: 0,0:16:57.76,0:17:00.26,Default,,0,0,0,,Бұл азаймайды, солай ма? Корра!
Dialogue: 0,0:17:00.39,0:17:01.60,Default,,0,0,0,,Еркек!
Dialogue: 0,0:17:01.97,0:17:03.64,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:17:03.81,0:17:09.02,Default,,0,0,0,,Сен қандай ақылсызсың! Сіз маған бірінші айттыңыз! бұл!
Dialogue: 0,0:17:09.19,0:17:10.94,Default,,0,0,0,,Жоқ, мен суретке қарағым келді...
Dialogue: 0,0:17:11.07,0:17:15.49,Default,,0,0,0,,Уау! Хаджиме!
Dialogue: 0,0:17:17.41,0:17:23.04,Default,,0,0,0,,<♪Харджиме Хаджиме Лилли - қыз~>
Dialogue: 0,0:17:23.16,0:17:29.38,Default,,0,0,0,,<♪Хаджиме, Хаджиме, Хаджиме қыздарды ұнатады, маған ұнайды~>
Dialogue: 0,0:17:29.54,0:17:33.30,Default,,0,0,0,,ше? <♪Лилуи - қыз~>
Dialogue: 0,0:17:33.42,0:17:40.10,Default,,0,0,0,,<♪Рируи Хажименің қасында>
Dialogue: 0,0:17:40.26,0:17:42.27,Default,,0,0,0,,<♪Уфуфу жоқ фу~>
Dialogue: 0,0:17:42.43,0:17:43.39,Default,,0,0,0,,<♪Бұл~>
Dialogue: 0,0:17:43.56,0:17:45.48,Default,,0,0,0,,Бұл не арман...
Dialogue: 0,0:17:49.27,0:17:52.57,Default,,0,0,0,,Неге біреудің түсіне рұқсатсыз кірдің? Уф.
Dialogue: 0,0:17:52.94,0:17:56.28,Default,,0,0,0,,Инкубус қабілеттеріңізді бос сөзге пайдаланбаңыз.
Dialogue: 0,0:17:56.40,0:17:58.86,Default,,0,0,0,,Хаджиме...
Dialogue: 0,0:17:58.99,0:18:00.32,Default,,0,0,0,,Таку Уу
Dialogue: 0,0:18:01.08,0:18:03.08,Default,,0,0,0,,Жүр, дайындал.
Dialogue: 0,0:18:03.24,0:18:04.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:05.29,0:18:07.96,Default,,0,0,0,,<Бүгінгі күні оның қылыш және рухани өнері>
Dialogue: 0,0:18:08.08,0:18:12.09,Default,,0,0,0,,<Лилуидің шебері ретінде лайықты екеніңізді анықтаңыз! ＞
Dialogue: 0,0:18:13.38,0:18:15.84,Default,,0,0,0,,Бүгінгі жұмысымызды толықтырайық.
Dialogue: 0,0:18:15.97,0:18:17.93,Default,,0,0,0,,Сәлем! (Вероника) Не істеп жатырсың, ебедейсіз бе?
Dialogue: 0,0:18:18.05,0:18:19.34,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:18:19.47,0:18:21.85,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз! Оу!
Dialogue: 0,0:18:21.97,0:18:26.35,Default,,0,0,0,,Жұмысқа келуге қарсы емеспін, бірақ қолдарың жақсы ма?
Dialogue: 0,0:18:26.48,0:18:29.35,Default,,0,0,0,,О! Оңалту! Оңалту!
Dialogue: 0,0:18:36.24,0:18:37.49,Default,,0,0,0,,J…
Dialogue: 0,0:18:37.61,0:18:39.86,Default,,0,0,0,,<Мен сенің көзқарасыңды сеземін! ＞
Dialogue: 0,0:18:39.99,0:18:43.20,Default,,0,0,0,,Әлгі ақымақ! мені елеме
Dialogue: 0,0:18:43.33,0:18:46.00,Default,,0,0,0,,Адамға қарасаң! а! рақмет сізге!
Dialogue: 0,0:18:46.12,0:18:47.87,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:18:48.00,0:18:48.87,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:49.00,0:18:51.13,Default,,0,0,0,,Ия... Иә?
Dialogue: 0,0:18:51.29,0:18:54.84,Default,,0,0,0,,Сәлем Лилли! Маған қарап қалма, арсыз жігіт!
Dialogue: 0,0:18:55.00,0:18:59.30,Default,,0,0,0,,Кешіріңіз, мені Хаджименің қолы уайымдап тұр...
Dialogue: 0,0:18:59.43,0:19:03.97,Default,,0,0,0,,Дакара! Маған ештеңе айтпа! Жарайды!
Dialogue: 0,0:19:04.10,0:19:06.89,Default,,0,0,0,,Мұқият қараңдар!
Dialogue: 0,0:19:10.39,0:19:11.40,Default,,0,0,0,,Я!
Dialogue: 0,0:19:11.65,0:19:12.81,Default,,0,0,0,,Не!
Dialogue: 0,0:19:12.94,0:19:14.02,Default,,0,0,0,,Толығырақ!
Dialogue: 0,0:19:16.44,0:19:17.53,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:21.03,0:19:22.41,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:19:22.53,0:19:24.45,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:24.58,0:19:28.70,Default,,0,0,0,,Енді мен сенің қолыңа айналдым, мен одан да күшті болдым!
Dialogue: 0,0:19:28.83,0:19:31.58,Default,,0,0,0,,Онымен мәңгілік араласпа!
Dialogue: 0,0:19:31.71,0:19:33.17,Default,,0,0,0,,Түсіндім, Лилли!
Dialogue: 0,0:19:33.29,0:19:36.67,Default,,0,0,0,,Шынымен бе? Хаджиме: Әлсіреп бара жатқан жоқсың ба?
Dialogue: 0,0:19:36.84,0:19:37.80,Default,,0,0,0,,бірнеше ондаған күн ғана созылғанымен, біз бір толқында болдық—
Dialogue: 0,0:19:37.92,0:19:40.88,Default,,0,0,0,,Ол кішкентай жігіт үшін уайымдама!
Dialogue: 0,0:19:43.01,0:19:47.56,Default,,0,0,0,,Түсіндім! Керемет! Хаджиме керемет!
Dialogue: 0,0:19:47.72,0:19:50.14,Default,,0,0,0,,Хмф! Ақыры түсіндің бе?
Dialogue: 0,0:19:50.27,0:19:52.81,Default,,0,0,0,,Мен бүгін көп жұмыс істеймін!
Dialogue: 0,0:19:53.85,0:19:57.11,Default,,0,0,0,,Хажиме! Мен тау қасқырын ұстадым!
Dialogue: 0,0:19:57.23,0:19:59.82,Default,,0,0,0,,Бұл қоян, қашып кетсін.
Dialogue: 0,0:19:59.94,0:20:01.45,Default,,0,0,0,,көремін.
Dialogue: 0,0:20:01.61,0:20:03.11,Default,,0,0,0,,Неге жасырып жатырсың?
Dialogue: 0,0:20:03.24,0:20:04.53,Default,,0,0,0,,＜Таку…＞
Dialogue: 0,0:20:04.66,0:20:08.24,Default,,0,0,0,,<Ол кісінің кім екенін білуім керек.>
Dialogue: 0,0:20:08.41,0:20:10.96,Default,,0,0,0,,Сәлем! Ыстық көзқарас!
Dialogue: 0,0:20:11.08,0:20:13.71,Default,,0,0,0,,Цк... бұл тітіркендіргіш...
Dialogue: 0,0:20:15.04,0:20:16.13,Default,,0,0,0,,Ггаааах!
Dialogue: 0,0:20:16.84,0:20:19.13,Default,,0,0,0,,<Бұл адамның кім екенін білуге мүмкіндік! ＞
Dialogue: 0,0:20:19.30,0:20:20.97,Default,,0,0,0,,Ха! (Сиқырлы аң) Уф!
Dialogue: 0,0:20:21.13,0:20:22.09,Default,,0,0,0,,Не!
Dialogue: 0,0:20:22.26,0:20:23.76,Default,,0,0,0,,Уф… Ой!
Dialogue: 0,0:20:23.88,0:20:25.76,Default,,0,0,0,,Хехе, басқа ештеңе жоқ.
Dialogue: 0,0:20:25.89,0:20:30.56,Default,,0,0,0,,Өтінемін, Хаджиме, менің әдемі соққым...
Dialogue: 0,0:20:30.72,0:20:33.02,Default,,0,0,0,,Цк... Ол қиын әйел.
Dialogue: 0,0:20:33.14,0:20:34.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:36.11,0:20:37.15,Default,,0,0,0,,Хаджиме?
Dialogue: 0,0:20:37.27,0:20:38.19,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:38.32,0:20:40.32,Default,,0,0,0,,Не істеп жатырсың, бұл қауіпті! (қарудың тербелген дыбысы)
Dialogue: 0,0:20:40.44,0:20:44.36,Default,,0,0,0,,Аузыңды жап! Менің мақтанышым үшін!
Dialogue: 0,0:20:44.49,0:20:45.87,Default,,0,0,0,,Өл!
Dialogue: 0,0:20:46.03,0:20:49.33,Default,,0,0,0,,<Әйелді не ашуландыратынын түсінбеймін...>
Dialogue: 0,0:20:49.45,0:20:50.91,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:20:51.04,0:20:54.00,Default,,0,0,0,,<Сол кісінің қылыш шеберлігін көргім келеді>
Dialogue: 0,0:20:54.17,0:20:55.96,Default,,0,0,0,,(Рируи мен оның достарының толқыған дауыстары)
Dialogue: 0,0:20:56.08,0:20:57.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:59.80,0:21:01.55,Default,,0,0,0,,Лилли! Тау қасқыры!
Dialogue: 0,0:21:02.76,0:21:03.97,Default,,0,0,0,,Гавк!
Dialogue: 0,0:21:04.38,0:21:05.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:10.47,0:21:12.02,Default,,0,0,0,,Бұл садақ!
Dialogue: 0,0:21:12.18,0:21:13.27,Default,,0,0,0,,Бұл садақ...
Dialogue: 0,0:21:13.39,0:21:16.02,Default,,0,0,0,,Жоқ! Бұл тек қылыш пен рух өнері емес пе?
Dialogue: 0,0:21:16.15,0:21:17.56,Default,,0,0,0,,Мен мұны өсектен естідім!
Dialogue: 0,0:21:17.69,0:21:19.65,Default,,0,0,0,,Ах! Енді түсіндім, сонда
Dialogue: 0,0:21:19.77,0:21:24.70,Default,,0,0,0,,Вероника-саманың қалқаны ретінде қызмет етіп жүргенде, мен жел рухының сиқырымен жауды жұлып алдым.
Dialogue: 0,0:21:24.90,0:21:26.78,Default,,0,0,0,,Осылай көрінді ме?
Dialogue: 0,0:21:26.95,0:21:29.87,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:21:30.99,0:21:34.12,Default,,0,0,0,,Мен бүгін қанша күш жұмсадым...
Dialogue: 0,0:21:34.33,0:21:35.46,Default,,0,0,0,,Сіз білесіз бе!
Dialogue: 0,0:21:35.58,0:21:37.46,Default,,0,0,0,,Не болды, Хажиме!?
Dialogue: 0,0:21:37.63,0:21:39.67,Default,,0,0,0,,Иә? Ах
Dialogue: 0,0:21:39.79,0:21:41.92,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:21:42.55,0:21:43.88,Default,,0,0,0,,Иә
Dialogue: 0,0:21:44.26,0:21:49.22,Default,,0,0,0,,Бұдан былай мен саған көп нәрсені үйрететін боламын.
Dialogue: 0,0:21:49.35,0:21:52.47,Default,,0,0,0,,Иә? Маған Хаджимнен басқа ұнамайды, бірақ?
Dialogue: 0,0:21:53.06,0:21:54.93,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:55.06,0:21:57.77,Default,,0,0,0,,Мен сізге тағы да рахмет айтқым келеді.
Dialogue: 0,0:21:57.98,0:21:59.31,Default,,0,0,0,,Дос
Dialogue: 0,0:22:01.73,0:22:03.40,Default,,0,0,0,,О!
Dialogue: 0,0:22:05.32,0:22:08.32,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.32,0:23:34.33,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.83,0:23:41.83,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
