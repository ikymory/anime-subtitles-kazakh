Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:46.25,0:00:52.26,Default,,0,0,0,,♪~
Dialogue: 0,0:01:38.51,0:01:44.52,Default,,0,0,0,,~♪
Dialogue: 0,0:03:22.57,0:03:24.41,Default,,0,0,0,,Қараңғылық жарықтан туады.
Dialogue: 0,0:03:25.20,0:03:27.70,Default,,0,0,0,,Қараңғылық солтүстікке кетіп, суға айналады...
Dialogue: 0,0:03:27.95,0:03:30.87,Default,,0,0,0,,Жарық оңтүстікке кетіп, отты тудырады.
Dialogue: 0,0:03:31.29,0:03:34.13,Default,,0,0,0,,Жарық пен қараңғылықтың арасында жел соғады.
Dialogue: 0,0:03:35.13,0:03:38.67,Default,,0,0,0,,Жарық қараңғылыққа батып, жерге қайтады
Dialogue: 0,0:03:39.59,0:03:42.63,Default,,0,0,0,,Үлкен күшке ие бол, таңдалған...
Dialogue: 0,0:03:43.68,0:03:47.10,Default,,0,0,0,,Өзіңіздің шынайы күшіңізді көрсетіңіз
Dialogue: 0,0:05:53.10,0:05:55.52,Default,,0,0,0,,Барлық заттар өзінің шынайы болмысынан қалыптасады.
Dialogue: 0,0:05:56.02,0:05:58.02,Default,,0,0,0,,ортақ қасиеттер
Dialogue: 0,0:05:58.73,0:06:04.69,Default,,0,0,0,,Әрбір қасиет бір-біріне әсер етіп, келесі формаға айналады.
Dialogue: 0,0:06:05.57,0:06:09.28,Default,,0,0,0,,Бірақ проекцияны қабылдай алмағандар...
Dialogue: 0,0:06:09.41,0:06:10.70,Default,,0,0,0,,Не болады...
Dialogue: 0,0:06:40.56,0:06:41.90,Default,,0,0,0,,Мэй-чан...
Dialogue: 0,0:06:44.90,0:06:45.82,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:51.57,0:06:53.78,Default,,0,0,0,,Дагаааннн!
Dialogue: 0,0:06:56.45,0:06:57.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:03.63,0:07:06.34,Default,,0,0,0,,Сіз жылап жатырсыз ба? Мэй Чан...
Dialogue: 0,0:07:09.92,0:07:12.84,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:07:23.31,0:07:25.86,Default,,0,0,0,,Эй, сен мұнда не істеп жүрсің?
Dialogue: 0,0:07:26.11,0:07:28.65,Default,,0,0,0,,Балалар сендерді адам дейді ғой, солай ма?
Dialogue: 0,0:07:28.78,0:07:30.11,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:07:30.32,0:07:32.66,Default,,0,0,0,,Екеуіңе қауіп төніп тұр!
Dialogue: 0,0:07:32.99,0:07:33.82,Default,,0,0,0,,Т-тоқта… бұл мүмкін емес қой…
Dialogue: 0,0:07:33.99,0:07:36.12,Default,,0,0,0,,Жаман адамдар сияқты
Dialogue: 0,0:07:36.49,0:07:40.12,Default,,0,0,0,,Әй, эй, сен бізді қайдан білдің?
Dialogue: 0,0:07:40.50,0:07:42.17,Default,,0,0,0,,Адам немен қоректенеді?
Dialogue: 0,0:07:42.29,0:07:43.21,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:43.33,0:07:44.63,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:45.00,0:07:46.88,Default,,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:07:47.00,0:07:49.13,Default,,0,0,0,,Бірден сөйлессең, түсінбейсің.
Dialogue: 0,0:07:50.30,0:07:52.72,Default,,0,0,0,,Сіз бұрынғыдайсыз.
Dialogue: 0,0:07:52.84,0:07:54.14,Default,,0,0,0,,Нихихихи…
Dialogue: 0,0:07:54.43,0:07:56.26,Default,,0,0,0,,Мен оны ұстадым! Маған ұнамайды
Dialogue: 0,0:07:56.39,0:07:57.56,Default,,0,0,0,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:07:57.68,0:08:00.39,Default,,0,0,0,,Ах~ Жемеңіз~!
Dialogue: 0,0:08:00.52,0:08:01.60,Default,,0,0,0,,Мен оны жемеймін!
Dialogue: 0,0:08:01.73,0:08:04.15,Default,,0,0,0,,Өйткені біз серіктеспіз!
Dialogue: 0,0:08:04.48,0:08:08.15,Default,,0,0,0,,Серіктестік дегеніміз не?
Dialogue: 0,0:08:08.44,0:08:10.90,Default,,0,0,0,,Әй, Танемон...
Dialogue: 0,0:08:14.36,0:08:15.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:17.99,0:08:19.66,Default,,0,0,0,,Не...?
Dialogue: 0,0:08:20.50,0:08:21.66,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:24.58,0:08:25.42,Default,,0,0,0,,Ах
Dialogue: 0,0:08:31.51,0:08:32.92,Default,,0,0,0,,Ммм... Уау.
Dialogue: 0,0:08:33.80,0:08:35.26,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:08:35.38,0:08:37.93,Default,,0,0,0,,I Хикари Хикари Ягами
Dialogue: 0,0:08:47.94,0:08:50.19,Default,,0,0,0,,Бұл ысқырықтың иісі бірдей.
Dialogue: 0,0:08:50.32,0:08:52.44,Default,,0,0,0,,Тыныштандыратын, жағымды иіс
Dialogue: 0,0:08:52.90,0:08:53.78,Default,,0,0,0,,Фуфу
Dialogue: 0,0:08:56.41,0:08:58.95,Default,,0,0,0,,Пиокомон? Pyocomon қайда?
Dialogue: 0,0:09:00.08,0:09:00.95,Default,,0,0,0,,Ой! !
Dialogue: 0,0:09:01.24,0:09:02.95,Default,,0,0,0,,Е... а! ?
Dialogue: 0,0:09:04.75,0:09:05.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:06.33,0:09:09.75,Default,,0,0,0,,Кешіріңіз! Кешіріңіз Пиокомон
Dialogue: 0,0:09:09.88,0:09:10.71,Default,,0,0,0,,Сәлем, жоқ!
Dialogue: 0,0:09:10.92,0:09:13.67,Default,,0,0,0,,Ауырсынды! Жоқ, кетейін!
Dialogue: 0,0:09:13.80,0:09:15.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:16.22,0:09:17.13,Default,,0,0,0,,Ei
Dialogue: 0,0:09:19.18,0:09:20.47,Default,,0,0,0,,Пиокомон…
Dialogue: 0,0:09:21.60,0:09:22.22,Default,,0,0,0,,Не?
Dialogue: 0,0:09:22.60,0:09:23.56,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:09:25.27,0:09:27.65,Default,,0,0,0,,Сіз екеуміз де серіктес болдық...
Dialogue: 0,0:09:27.77,0:09:29.44,Default,,0,0,0,,(Изуку) Қвиркің болмаса да батыр бола аласың ба?
Dialogue: 0,0:09:31.77,0:09:35.99,Default,,0,0,0,,Қараңдаршы, Пёкомон маған үнемі жабысып тұратын бұзылған бала...
Dialogue: 0,0:09:36.11,0:09:38.49,Default,,0,0,0,,Барлығымыз монджаяки жеп, бірге ыстық бұлаққа бардық.
Dialogue: 0,0:09:38.95,0:09:41.24,Default,,0,0,0,,Біз мәңгі бірге болдық.
Dialogue: 0,0:09:41.37,0:09:44.50,Default,,0,0,0,,Өтірік! Мен бұл туралы білмеймін
Dialogue: 0,0:09:45.79,0:09:47.04,Default,,0,0,0,,Пиокомон…
Dialogue: 0,0:09:48.96,0:09:51.00,Default,,0,0,0,,Жоқ, ол қосылмайды.
Dialogue: 0,0:09:51.63,0:09:54.30,Default,,0,0,0,,Қақпа да толығымен жойылып кете ме?
Dialogue: 0,0:09:54.42,0:09:56.34,Default,,0,0,0,,Қайта жүктегеннен кейін бірден...
Dialogue: 0,0:09:56.47,0:09:59.39,Default,,0,0,0,,Сандық әлемнің өзі тұрақсыз сияқты.
Dialogue: 0,0:09:59.51,0:10:01.01,Default,,0,0,0,,Қайта жүктеу дегеніміз не?
Dialogue: 0,0:10:01.14,0:10:04.06,Default,,0,0,0,,Сіз оны жей аласыз ба? мінеки біз? Неліктен?
Dialogue: 0,0:10:04.43,0:10:05.98,Default,,0,0,0,,Коуширо Ханкюноха-
Dialogue: 0,0:10:06.10,0:10:09.06,Default,,0,0,0,,Сіз істердің қаншалықты қиын екенін білесіз...
Dialogue: 0,0:10:09.19,0:10:11.11,Default,,0,0,0,,Мен білмейтін нәрселер өте көп.
Dialogue: 0,0:10:11.23,0:10:12.82,Default,,0,0,0,,Сондықтан мен көбірек білгім келеді
Dialogue: 0,0:10:13.69,0:10:16.57,Default,,0,0,0,,Сіз және осы әлем туралы
Dialogue: 0,0:10:16.99,0:10:18.32,Default,,0,0,0,,Ах... (Коромон Токомон) Иә.
Dialogue: 0,0:10:18.45,0:10:21.07,Default,,0,0,0,,А, не! ?
Dialogue: 0,0:10:21.41,0:10:22.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:24.49,0:10:26.58,Default,,0,0,0,,Басқа инфекциялар жоқ
Dialogue: 0,0:10:26.83,0:10:28.66,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:28.79,0:10:30.17,Default,,0,0,0,,Пыс, пыс… Э?
Dialogue: 0,0:10:30.63,0:10:34.05,Default,,0,0,0,,Одан да, Токомон, досым бол.
Dialogue: 0,0:10:34.17,0:10:35.34,Default,,0,0,0,,Сау бол, Джоджо!
Dialogue: 0,0:10:35.63,0:10:38.05,Default,,0,0,0,,Иә, мен сенімен бірге болғым келеді.
Dialogue: 0,0:10:38.17,0:10:40.38,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:42.18,0:10:43.10,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:10:43.55,0:10:45.10,Default,,0,0,0,,Фуфу
Dialogue: 0,0:10:45.93,0:10:47.52,Default,,0,0,0,,-да? (Тайчи) Иә?
Dialogue: 0,0:10:47.85,0:10:50.60,Default,,0,0,0,,Келесі не бар (Тайчи) Ммм.
Dialogue: 0,0:10:51.27,0:10:53.06,Default,,0,0,0,,Үйге баратын жолды іздеп жүрсіз бе?
Dialogue: 0,0:10:53.19,0:10:56.23,Default,,0,0,0,,Химекаваның және басқалардың құтқаруын күтуіміз керек пе?
Dialogue: 0,0:10:56.36,0:11:00.61,Default,,0,0,0,,Қалай болғанда да, тамақ пен жатын орын болуы керек деп ойлаймын.
Dialogue: 0,0:11:01.41,0:11:03.41,Default,,0,0,0,,Дигимондар да кішкентай.
Dialogue: 0,0:11:03.53,0:11:04.62,Default,,0,0,0,,Жарайды... Уф.
Dialogue: 0,0:11:08.54,0:11:11.25,Default,,0,0,0,,Уф... жарайды.
Dialogue: 0,0:11:11.37,0:11:14.54,Default,,0,0,0,,Мен баяғыда қайтып оралдым, әйтеуір, солай болады.
Dialogue: 0,0:11:14.67,0:11:16.50,Default,,0,0,0,,Мимидің көзқарасы бойынша, бұл чоойю ма?
Dialogue: 0,0:11:16.63,0:11:19.92,Default,,0,0,0,,Дұрыс па? Тұқым жағынан да? Ұнады!
Dialogue: 0,0:11:20.05,0:11:21.26,Default,,0,0,0,,Иә? сурет?
Dialogue: 0,0:11:21.38,0:11:23.39,Default,,0,0,0,,Осындай кезде қағу керек!
Dialogue: 0,0:11:23.76,0:11:25.05,Default,,0,0,0,,мүлдем-
Dialogue: 0,0:11:25.47,0:11:26.72,Default,,0,0,0,,Танемоны қайта бастау керек...
Dialogue: 0,0:11:26.85,0:11:29.39,Default,,0,0,0,,Мен сізге заманауи ойықты үйретуім керек.
Dialogue: 0,0:11:29.89,0:11:31.19,Default,,0,0,0,,Мими-чан...
Dialogue: 0,0:11:31.85,0:11:33.56,Default,,0,0,0,,Мен сізбен қайта кездесуге мүмкіндік алдым.
Dialogue: 0,0:11:33.69,0:11:35.48,Default,,0,0,0,,Әзірге бұл жеткілікті
Dialogue: 0,0:11:35.61,0:11:37.15,Default,,0,0,0,,Оны жеме!
Dialogue: 0,0:11:37.40,0:11:39.15,Default,,0,0,0,,Сондықтан мен оны жемеймін!
Dialogue: 0,0:12:05.39,0:12:06.39,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:12:20.44,0:12:21.65,Default,,0,0,0,,Уау
Dialogue: 0,0:12:21.78,0:12:22.78,Default,,0,0,0,,Ах!?
Dialogue: 0,0:12:26.57,0:12:29.16,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:29.29,0:12:31.45,Default,,0,0,0,,(Мейкомонның айқайы)
Dialogue: 0,0:12:31.58,0:12:33.00,Default,,0,0,0,,Мейкомон! ?
Dialogue: 0,0:12:33.91,0:12:34.75,Default,,0,0,0,,Ах
Dialogue: 0,0:12:37.92,0:12:38.75,Default,,0,0,0,,Who?
Dialogue: 0,0:12:39.00,0:12:42.26,Default,,0,0,0,,Неліктен? Басқаша айтқанда, ол әлі жетілген кезеңде! ?
Dialogue: 0,0:12:42.80,0:12:45.26,Default,,0,0,0,,Мэй... сен сондасың ба?
Dialogue: 0,0:12:45.72,0:12:47.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:49.26,0:12:51.72,Default,,0,0,0,,Мешин-чанды есте сақта...
Dialogue: 0,0:12:51.85,0:12:55.98,Default,,0,0,0,,Уф... Мэй Мэй~! !
Dialogue: 0,0:12:58.48,0:12:59.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:00.57,0:13:01.78,Default,,0,0,0,,Эй (Джо) Тайчи! ?
Dialogue: 0,0:13:12.24,0:13:13.29,Default,,0,0,0,,Уф
Dialogue: 0,0:13:17.46,0:13:20.42,Default,,0,0,0,,Бұрмалау... Неліктен?
Dialogue: 0,0:13:21.13,0:13:24.26,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:24.38,0:13:28.22,Default,,0,0,0,,(Дайго Нишижиманың ауыр тыныс алуы)
Dialogue: 0,0:13:28.34,0:13:30.30,Default,,0,0,0,,Мұны сансыз рет қайталадым, иә?
Dialogue: 0,0:13:34.52,0:13:35.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:37.35,0:13:39.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:40.23,0:13:42.82,Default,,0,0,0,,Ооо! ?
Dialogue: 0,0:13:43.23,0:13:45.53,Default,,0,0,0,,Бұл не! ? Ол тамақ па?
Dialogue: 0,0:13:45.65,0:13:47.15,Default,,0,0,0,,Мен мұндайды ешқашан көрген емеспін...
Dialogue: 0,0:13:47.28,0:13:48.82,Default,,0,0,0,,Жақсы иіс шығады!
Dialogue: 0,0:13:49.16,0:13:51.66,Default,,0,0,0,,Хехе, бәрі таң қалды.
Dialogue: 0,0:13:51.78,0:13:53.91,Default,,0,0,0,,Сора-сан мұның бәрін жасады ма?
Dialogue: 0,0:13:54.04,0:13:57.21,Default,,0,0,0,,Иә, бәрі әрқашан аш болған.
Dialogue: 0,0:13:57.33,0:13:59.75,Default,,0,0,0,,Уау... бұл тамаша!
Dialogue: 0,0:13:59.88,0:14:02.04,Default,,0,0,0,,Сора-санды кім сенің әйелің ете алады?
Dialogue: 0,0:14:02.17,0:14:03.42,Default,,0,0,0,,Ақылсыз ештеңе айтпа, мен саған шешуге көмектесемін.
Dialogue: 0,0:14:03.42,0:14:05.09,Default,,0,0,0,,Ақылсыз ештеңе айтпа, мен саған шешуге көмектесемін.
Dialogue: 0,0:14:03.42,0:14:05.09,Default,,0,0,0,,Фуфу
Dialogue: 0,0:14:11.39,0:14:15.60,Default,,0,0,0,,Әй, бұл аздап ащы тәтті сусын дегеніміз не?
Dialogue: 0,0:14:16.10,0:14:17.06,Default,,0,0,0,,Улонг шайы
Dialogue: 0,0:14:17.18,0:14:19.35,Default,,0,0,0,,О, өте керемет.
Dialogue: 0,0:14:19.73,0:14:20.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:21.02,0:14:24.07,Default,,0,0,0,,Улонг шайы – ашытылған шай жапырақтарынан дайындалатын шай.
Dialogue: 0,0:14:24.19,0:14:27.44,Default,,0,0,0,,Уолонг шайы полимерленген полифенол деп аталатын өсімдік ингредиентінің арқасында.
Dialogue: 0,0:14:27.57,0:14:31.82,Default,,0,0,0,,Майдың сіңуін тежеп қана қоймай, оның ыдырауына да ықпал етеді.
Dialogue: 0,0:14:31.95,0:14:34.62,Default,,0,0,0,,Ол денсаулыққа пайдалы тағам ретінде де танымал.
Dialogue: 0,0:14:35.20,0:14:38.41,Default,,0,0,0,,Сіз қалай ойлайсыз? Улонг шайы кез келген тағаммен жақсы үйлеседі, солай ма?
Dialogue: 0,0:14:38.54,0:14:40.33,Default,,0,0,0,,Иә, қанша сусынды қаласаңыз, сонша ішуге болады.
Dialogue: 0,0:14:40.46,0:14:41.67,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:41.79,0:14:43.88,Default,,0,0,0,,Бұл тұтқырлық және сергітетін текстура...
Dialogue: 0,0:14:44.17,0:14:46.84,Default,,0,0,0,,Майлы және қатты хош иісті тағамдармен жақсы үйлеседі.
Dialogue: 0,0:14:47.51,0:14:49.09,Default,,0,0,0,,Біріншіден, оолонг шайындағы «рон» ... болып табылады.
Dialogue: 0,0:14:49.22,0:14:49.84,Default,,0,0,0,,«Айдаһар» канжи...
Dialogue: 0,0:14:49.97,0:14:51.89,Default,,0,0,0,,Ан-сан немен айналысқанды жақсы көреді?
Dialogue: 0,0:14:52.01,0:14:53.14,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:14:53.80,0:14:55.39,Default,,0,0,0,,Айтпақшы, шай жапырақтарының қартаюы мен қуыру уақыты...
Dialogue: 0,0:14:55.39,0:14:56.39,Default,,0,0,0,,Айтпақшы, шай жапырақтарын пісіп, қуыруға кететін уақыт өте дәмді!
Dialogue: 0,0:14:56.68,0:14:57.31,Default,,0,0,0,,Бұрынғыдан ұзағырақ уақыт алу арқылы жасалған.
Dialogue: 0,0:14:57.31,0:14:58.85,Default,,0,0,0,,Бұрынғыдан ұзағырақ алып туған - Мен де жей аламын ба?
Dialogue: 0,0:14:58.98,0:14:59.60,Default,,0,0,0,,Қара олонг шайы алдыңғыларға қарағанда жақсы.
Dialogue: 0,0:14:59.60,0:15:00.85,Default,,0,0,0,,Қара оолонг шайы алдыңғыларға қарағанда жақсы - бұл Коушироға арналған, сондықтан бұл жақсы емес.
Dialogue: 0,0:15:00.85,0:15:00.98,Default,,0,0,0,,Бұл Коуширо-сан үшін, сондықтан бұл жақсы емес.
Dialogue: 0,0:15:00.98,0:15:02.35,Default,,0,0,0,,Бұл Коуширо-сан үшін, сондықтан бұл жақсы емес. Полимерленген полифенол жоғары таза оолонг шайы.
Dialogue: 0,0:15:02.35,0:15:02.48,Default,,0,0,0,,Полимерленген полифенолдары бар жоғары тазартылған оолонг шайы.
Dialogue: 0,0:15:02.48,0:15:02.86,Default,,0,0,0,,Полимерленген полифенолдары бар жоғары тазартылған оолонг шайы.
Dialogue: 0,0:15:02.86,0:15:02.98,Default,,0,0,0,,Қараңыз, иә~
Dialogue: 0,0:15:02.98,0:15:03.98,Default,,0,0,0,,Қараңызшы, оған...
Dialogue: 0,0:15:04.11,0:15:04.48,Default,,0,0,0,,Олонг шайын ұнататындар арасында да назар аударады.
Dialogue: 0,0:15:04.48,0:15:06.94,Default,,0,0,0,,Бұл дәмдірек көрінсе де, олонг шайын ұнататындардың назарын аударады.
Dialogue: 0,0:15:07.07,0:15:07.57,Default,,0,0,0,,Ішуге оңай -
Dialogue: 0,0:15:07.57,0:15:08.36,Default,,0,0,0,,Ішуге оңай - ам
Dialogue: 0,0:15:08.49,0:15:09.11,Default,,0,0,0,,Денсаулыққа пайдалы шай ретінде...
Dialogue: 0,0:15:09.24,0:15:11.53,Default,,0,0,0,,Коуширо-хан сөйлесуге құмар.
Dialogue: 0,0:15:11.66,0:15:13.91,Default,,0,0,0,,Токомонның бәрін жеп қойды.
Dialogue: 0,0:15:14.03,0:15:15.91,Default,,0,0,0,,А, дұрыс, Мочимон, а?
Dialogue: 0,0:15:16.04,0:15:18.91,Default,,0,0,0,,Мен сізден осы дүние туралы аздап сұрағым келеді...
Dialogue: 0,0:15:19.04,0:15:19.96,Default,,0,0,0,,Иә, иә, бұл кейінірек!
Dialogue: 0,0:15:19.96,0:15:20.87,Default,,0,0,0,,Иә, иә, бұл кейінірек!
Dialogue: 0,0:15:19.96,0:15:20.87,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:20.87,0:15:22.08,Default,,0,0,0,,Иә, иә, бұл кейінірек!
Dialogue: 0,0:15:22.21,0:15:24.67,Default,,0,0,0,,Сора-сан мен үшін жасады!
Dialogue: 0,0:15:25.29,0:15:27.00,Default,,0,0,0,,Иә, аа!
Dialogue: 0,0:15:27.30,0:15:28.34,Default,,0,0,0,,Не!
Dialogue: 0,0:15:28.76,0:15:32.01,Default,,0,0,0,,Қарашы, аузыңды ашпасаң тамақ жей алмайсың!
Dialogue: 0,0:15:32.13,0:15:34.43,Default,,0,0,0,,Оны өзіңіз жеуге болады!
Dialogue: 0,0:15:34.55,0:15:38.27,Default,,0,0,0,,А... Айтайын дегенім, бұл не? Бұл
Dialogue: 0,0:15:38.64,0:15:42.27,Default,,0,0,0,,Сораның желе бұршақтары мен балғын кілегеймен пісіруі!
Dialogue: 0,0:15:42.77,0:15:44.23,Default,,0,0,0,,Соңғы кездері оған құмар болдым.
Dialogue: 0,0:15:44.36,0:15:47.15,Default,,0,0,0,,Бұл, әрине, дәмді, сондықтан оны бәрі де жеуі керек!
Dialogue: 0,0:15:47.32,0:15:49.28,Default,,0,0,0,,Бұл бірегей құрылым.
Dialogue: 0,0:15:50.15,0:15:52.28,Default,,0,0,0,,Барлығы да, ааа.
Dialogue: 0,0:15:52.99,0:15:54.87,Default,,0,0,0,,Бұл дәмді ме?
Dialogue: 0,0:15:54.99,0:15:57.28,Default,,0,0,0,,Дәмді Дәмді Вау
Dialogue: 0,0:15:57.41,0:15:59.04,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:15:59.66,0:16:01.46,Default,,0,0,0,,Мен сене алар емеспін.
Dialogue: 0,0:16:01.58,0:16:04.12,Default,,0,0,0,,Мұның бәрі ешқашан болмаған сияқты.
Dialogue: 0,0:16:04.25,0:16:06.54,Default,,0,0,0,,Менің ойымша, бәрі бұрынғыдай болмайды.
Dialogue: 0,0:16:07.17,0:16:09.55,Default,,0,0,0,,Бұл мен ұмытып қалдым дегеннен басқа.
Dialogue: 0,0:16:10.34,0:16:13.30,Default,,0,0,0,,Мейкомон Мочизукиді есіне алды
Dialogue: 0,0:16:14.18,0:16:16.30,Default,,0,0,0,,Ол жылап отырды.
Dialogue: 0,0:16:16.93,0:16:19.39,Default,,0,0,0,,Мен оны іздеуім керек пе? (Тайчи/Ямато) Уф...
Dialogue: 0,0:16:30.03,0:16:31.40,Default,,0,0,0,,Бізге-
Dialogue: 0,0:16:32.11,0:16:34.24,Default,,0,0,0,,Мен Мейкомонға көмектесе аламын ба деп ойлаймын...
Dialogue: 0,0:16:34.49,0:16:37.24,Default,,0,0,0,,Ол және Мочизуки де біздің достарымыз.
Dialogue: 0,0:16:42.96,0:16:44.37,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:16:45.83,0:16:46.67,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:50.05,0:16:51.76,Default,,0,0,0,,Тайчи! (Тайчи) Ах.
Dialogue: 0,0:16:52.21,0:16:56.26,Default,,0,0,0,,Бұл тегіс, жұқа және ұзын нәрсе! Дәмді, дәмді!
Dialogue: 0,0:16:56.76,0:16:59.89,Default,,0,0,0,,Уау! ? Ой... тамақ ішіп отырып сөйлеме.
Dialogue: 0,0:17:00.01,0:17:01.77,Default,,0,0,0,,Бұл қандай тағам?
Dialogue: 0,0:17:01.89,0:17:03.52,Default,,0,0,0,,Маған ұнауы мүмкін!
Dialogue: 0,0:17:05.35,0:17:06.31,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:06.85,0:17:10.36,Default,,0,0,0,,Сізге жеуге болатын кез келген нәрсені ұнатасыз, солай ма?
Dialogue: 0,0:17:10.48,0:17:13.28,Default,,0,0,0,,Мм, ойланыңызшы, солай шығар.
Dialogue: 0,0:17:13.86,0:17:15.78,Default,,0,0,0,,Якинику мен такояки...
Dialogue: 0,0:17:15.90,0:17:17.91,Default,,0,0,0,,Маған да гамбургер ұнайды...
Dialogue: 0,0:17:18.20,0:17:20.28,Default,,0,0,0,,Менің тамағымның бәрін жеп ал.
Dialogue: 0,0:17:20.66,0:17:24.58,Default,,0,0,0,,Яки...? Сенің не айтып тұрғаныңды білмеймін.
Dialogue: 0,0:17:24.71,0:17:26.33,Default,,0,0,0,,Ахах... жаман
Dialogue: 0,0:17:26.92,0:17:28.04,Default,,0,0,0,,Қысқасы...
Dialogue: 0,0:17:28.42,0:17:30.50,Default,,0,0,0,,Мен сен туралы.
Dialogue: 0,0:17:30.63,0:17:32.55,Default,,0,0,0,,Мен сенен артық білемін...!
Dialogue: 0,0:17:32.96,0:17:36.55,Default,,0,0,0,,(Коромонның күлкісі)
Dialogue: 0,0:17:36.93,0:17:37.76,Default,,0,0,0,,Ах! Ахаха
Dialogue: 0,0:17:37.89,0:17:41.31,Default,,0,0,0,,Мен де қызық көрінетін нәрсені істеп жатырмын!
Dialogue: 0,0:17:41.43,0:17:42.22,Default,,0,0,0,,Мен де, мен де~!
Dialogue: 0,0:17:42.35,0:17:43.31,Default,,0,0,0,,А, мен де, мен де.
Dialogue: 0,0:17:43.43,0:17:44.85,Default,,0,0,0,,Мен де Хикари
Dialogue: 0,0:17:44.98,0:17:45.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:46.02,0:17:47.56,Default,,0,0,0,,Мен де...
Dialogue: 0,0:17:48.06,0:17:50.81,Default,,0,0,0,,Жарайды, кел, иә!
Dialogue: 0,0:17:51.69,0:17:52.61,Default,,0,0,0,,Фуфу
Dialogue: 0,0:17:59.41,0:18:01.20,Default,,0,0,0,,Тефтели дәмді ме?
Dialogue: 0,0:18:02.45,0:18:04.16,Default,,0,0,0,,Иә (бос) Иә!
Dialogue: 0,0:18:04.29,0:18:06.58,Default,,0,0,0,,Толтырулар да көп! Иә!
Dialogue: 0,0:18:07.25,0:18:08.33,Default,,0,0,0,,Маған онша қажет емес
Dialogue: 0,0:18:09.25,0:18:11.42,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:18:11.88,0:18:13.09,Default,,0,0,0,,Эй… Өзіңді қолыңнан келсін!!
Dialogue: 0,0:18:17.34,0:18:22.35,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:18:26.48,0:18:29.39,Default,,0,0,0,,Мен қазір телефонға жауап бере алмаймын.
Dialogue: 0,0:18:29.52,0:18:33.73,Default,,0,0,0,,Дыбыстық сигналдан кейін хабарлама қалдырыңыз
Dialogue: 0,0:18:35.57,0:18:36.74,Default,,0,0,0,,Нишижима
Dialogue: 0,0:18:36.86,0:18:40.20,Default,,0,0,0,,Мешин Мочизукидің қайда екенін қазір растау мүмкін емес.
Dialogue: 0,0:18:40.32,0:18:42.20,Default,,0,0,0,,Үйге де оралмаған сияқты.
Dialogue: 0,0:18:42.32,0:18:44.83,Default,,0,0,0,,Егер сізде қандай да бір идея болса, бізге хабарласыңыз.
Dialogue: 0,0:18:44.95,0:18:51.92,Default,,0,0,0,,(Темір жол өткелінің дабыл дыбысы)
Dialogue: 0,0:18:56.46,0:18:59.38,Default,,0,0,0,,(Пернетақтаны түрту дыбысы)
Dialogue: 0,0:19:05.81,0:19:08.18,Default,,0,0,0,,Химекава мырза қандай жауап берді?
Dialogue: 0,0:19:09.52,0:19:13.15,Default,,0,0,0,,Жоқ, мен Геннаймен де байланыса алмаймын.
Dialogue: 0,0:19:13.52,0:19:16.15,Default,,0,0,0,,Бұл дүниеде бірдеңе дұрыс емес.
Dialogue: 0,0:19:16.73,0:19:17.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:17.86,0:19:21.07,Default,,0,0,0,,Күрсін, қазір де, өткенде де түсінбейтін дүниелер көп.
Dialogue: 0,0:19:21.20,0:19:22.66,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:19:26.54,0:19:27.66,Default,,0,0,0,,Мейкомонды іздеп көрейік
Dialogue: 0,0:19:28.00,0:19:29.62,Default,,0,0,0,,Не... Тайчи
Dialogue: 0,0:19:31.08,0:19:34.29,Default,,0,0,0,,Мейкомон да, Мочизуки де біздің досымыз.
Dialogue: 0,0:19:34.63,0:19:36.17,Default,,0,0,0,,Екеуің дұрыс кездескендеріңді қалаймын.
Dialogue: 0,0:19:39.55,0:19:41.26,Default,,0,0,0,,Хе хехе
Dialogue: 0,0:19:43.26,0:19:47.51,Default,,0,0,0,,Мәселе - Мейкомонның инфекциясы және бұрмалануы.
Dialogue: 0,0:19:47.64,0:19:49.02,Default,,0,0,0,,Тіпті қайта жүктелген әлемде――
Dialogue: 0,0:19:49.14,0:19:51.19,Default,,0,0,0,,Мейкомон бұрынғыдай қалса...
Dialogue: 0,0:19:51.44,0:19:54.19,Default,,0,0,0,,Инфекция қайтадан басталады ма?
Dialogue: 0,0:19:54.73,0:19:56.82,Default,,0,0,0,,Бұл бәрі бекер болды деген сөз! ?
Dialogue: 0,0:19:56.94,0:19:59.90,Default,,0,0,0,,Қайта жүктеу... және бәрі есте қалдырған!
Dialogue: 0,0:20:00.57,0:20:01.74,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:04.91,0:20:08.16,Default,,0,0,0,,Оны іздеп көрейік. Менің досым жылап жатыр.
Dialogue: 0,0:20:08.29,0:20:09.95,Default,,0,0,0,,Біз көмектесуіміз керек
Dialogue: 0,0:20:10.41,0:20:11.25,Default,,0,0,0,,О
Dialogue: 0,0:20:11.58,0:20:13.21,Default,,0,0,0,,Мен не істей алатынымды білмеймін ...
Dialogue: 0,0:20:13.71,0:20:16.71,Default,,0,0,0,,Оны үйге, серіктесіне апарайық.
Dialogue: 0,0:20:17.46,0:20:19.09,Default,,0,0,0,,Мочизукиге
Dialogue: 0,0:20:20.30,0:20:22.17,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:20:22.30,0:20:25.05,Default,,0,0,0,,Баруды шешсеңіз, біраз уақыттан кейін бірінші рет барасыз ба?
Dialogue: 0,0:20:25.18,0:20:27.68,Default,,0,0,0,,Ах... алдымен базаны бекіту керек.
Dialogue: 0,0:20:27.80,0:20:31.31,Default,,0,0,0,,Бұрынғыдай соқыр жүру тиімсіз...
Dialogue: 0,0:20:31.43,0:20:33.48,Default,,0,0,0,,Алдымен қауіпсіз ұйықтайтын орынды табыңыз.
Dialogue: 0,0:20:33.77,0:20:36.23,Default,,0,0,0,,Джо-сан бұрынғы күйіне оралған сияқты.
Dialogue: 0,0:20:36.56,0:20:39.27,Default,,0,0,0,,Мен әлі де өсемін деп ойлаймын.
Dialogue: 0,0:20:39.40,0:20:41.24,Default,,0,0,0,,Подруги да Илусин (ұзындығы) Уф...
Dialogue: 0,0:20:41.69,0:20:42.95,Default,,0,0,0,,Сіз маған сенбейсіз!
Dialogue: 0,0:20:43.07,0:20:44.74,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:20:45.24,0:20:47.28,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:20:47.41,0:20:49.87,Default,,0,0,0,,Эй, оян, Коромо...
Dialogue: 0,0:20:49.99,0:20:51.25,Default,,0,0,0,,Е! (Барлығы) иә?
Dialogue: 0,0:20:51.79,0:20:54.25,Default,,0,0,0,,Не болды... Е-е! ?
Dialogue: 0,0:20:56.29,0:20:57.42,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:20:58.46,0:21:00.96,Default,,0,0,0,,Уау
Dialogue: 0,0:21:02.05,0:21:03.92,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:21:05.18,0:21:07.59,Default,,0,0,0,,Ия, мен ұша аламын.
Dialogue: 0,0:21:07.72,0:21:09.26,Default,,0,0,0,,Су да ұша алады
Dialogue: 0,0:21:09.64,0:21:11.27,Default,,0,0,0,,Тентомон! Патамон!
Dialogue: 0,0:21:11.64,0:21:12.56,Default,,0,0,0,,Патамон?
Dialogue: 0,0:21:12.68,0:21:15.64,Default,,0,0,0,,Түсіндім, менің атым Патамон!
Dialogue: 0,0:21:15.77,0:21:16.77,Default,,0,0,0,,Ахаха
Dialogue: 0,0:21:19.52,0:21:21.28,Default,,0,0,0,,Мен әдемімін бе?
Dialogue: 0,0:21:21.57,0:21:25.07,Default,,0,0,0,,Әдемі, сұлу, сондай сұлу, Пальмон!
Dialogue: 0,0:21:25.20,0:21:26.99,Default,,0,0,0,,Эххе, кешіріңіз~
Dialogue: 0,0:21:27.28,0:21:28.53,Default,,0,0,0,,Эхехе Хикари
Dialogue: 0,0:21:29.45,0:21:30.45,Default,,0,0,0,,Әй! ?
Dialogue: 0,0:21:31.33,0:21:34.54,Default,,0,0,0,,Бұл ұят, сондықтан маған көп қарамауыңызды өтінемін.
Dialogue: 0,0:21:34.96,0:21:36.58,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:38.17,0:21:40.29,Default,,0,0,0,,Гомамон дами алды.
Dialogue: 0,0:21:40.67,0:21:42.25,Default,,0,0,0,,Менің ойымша, сіз мұны орындалды деп айта аласыз ...
Dialogue: 0,0:21:42.38,0:21:46.05,Default,,0,0,0,,Қарын тоқ болып, ұйықтасаңыз, дамисыз, солай ма?
Dialogue: 0,0:21:46.43,0:21:48.01,Default,,0,0,0,,«Мен жасадым»…
Dialogue: 0,0:21:48.14,0:21:51.26,Default,,0,0,0,,Бірақ Тайчи және басқалармен салыстырғанда ол кішкентай.
Dialogue: 0,0:21:51.39,0:21:53.06,Default,,0,0,0,,Менің үлкенірек болғым келеді, солай ма?
Dialogue: 0,0:21:53.35,0:21:54.31,Default,,0,0,0,,Эй!
Dialogue: 0,0:21:54.43,0:21:57.10,Default,,0,0,0,,Хаха... Қайта жүктегеннен кейін де-
Dialogue: 0,0:21:57.23,0:21:59.81,Default,,0,0,0,,Бір қызығы, біз жақсы араласатын сияқтымыз.
Dialogue: 0,0:22:01.23,0:22:02.19,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:02.32,0:22:04.82,Default,,0,0,0,,Ах! ? (Аспан) Қайта ұша алғаным жақсы.
Dialogue: 0,0:22:05.19,0:22:08.20,Default,,0,0,0,,Сол себепті өткенді білмейсің!
Dialogue: 0,0:22:08.32,0:22:09.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:14.04,0:22:15.37,Default,,0,0,0,,Биомон
Dialogue: 0,0:22:16.91,0:22:22.84,Default,,0,0,0,,(Темір жол өткелінің дабыл дыбысы)
Dialogue: 0,0:22:27.22,0:22:28.26,Default,,0,0,0,,мамыр…
Dialogue: 0,0:22:42.40,0:22:45.36,Default,,0,0,0,,Мамыр... Қайда?
Dialogue: 0,0:22:50.53,0:22:51.66,Default,,0,0,0,,Неге...
Dialogue: 0,0:22:52.07,0:22:53.58,Default,,0,0,0,,Неге келмейсің?
Dialogue: 0,0:22:54.08,0:22:55.58,Default,,0,0,0,,Мейко…
Dialogue: 0,0:23:01.96,0:23:07.88,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:23:29.49,0:23:30.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:37.29,0:23:39.50,Default,,0,0,0,,Қайтадан қош келдіңіз. Қалай болды?
Dialogue: 0,0:23:39.62,0:23:41.67,Default,,0,0,0,,Ол пайда болады және жоғалады, менде ештеңе жоқ.
Dialogue: 0,0:23:42.25,0:23:44.08,Default,,0,0,0,,Үлкен бұрмалауларға жақын -
Dialogue: 0,0:23:44.21,0:23:46.88,Default,,0,0,0,,Мейкомон әрқашан дерлік болған.
Dialogue: 0,0:23:47.00,0:23:51.51,Default,,0,0,0,,Қазірдің өзінде бұл дүниеде бұрмалау бар...
Dialogue: 0,0:23:51.80,0:23:52.76,Default,,0,0,0,,Егер сіз бұрмалауды орындасаңыз...
Dialogue: 0,0:23:52.88,0:23:56.43,Default,,0,0,0,,Мейкомонды табу соншалықты қиын болмаса керек...
Dialogue: 0,0:23:56.93,0:23:59.47,Default,,0,0,0,,Сіздің қолыңыздан келетіні - тұрақты іздеу...
Dialogue: 0,0:24:02.06,0:24:02.94,Default,,0,0,0,,О
Dialogue: 0,0:24:08.07,0:24:09.44,Default,,0,0,0,,Өзіңізді қатты итермеңіз.
Dialogue: 0,0:24:19.87,0:24:22.12,Default,,0,0,0,,Менің ойымша, ол қосылмайды ...
Dialogue: 0,0:24:22.50,0:24:25.21,Default,,0,0,0,,Меймейді де күшпен әкелсе жақсы болар еді деп ойлаймын.
Dialogue: 0,0:24:25.67,0:24:26.96,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:24:27.09,0:24:30.21,Default,,0,0,0,,Менің ойымша, бұл қарапайым қыз үшін өте қиын.
Dialogue: 0,0:24:32.38,0:24:33.22,Default,,0,0,0,,Иә.
Dialogue: 0,0:24:33.59,0:24:35.18,Default,,0,0,0,,Қалыпты деген не?
Dialogue: 0,0:24:35.30,0:24:38.76,Default,,0,0,0,,Біз де қарапайым қазіргі қыздармыз!
Dialogue: 0,0:24:38.89,0:24:41.06,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:24:41.18,0:24:44.10,Default,,0,0,0,,Барлығыңыз сандық әлемде тәжірибелі емессіздер ме?
Dialogue: 0,0:24:44.23,0:24:46.73,Default,,0,0,0,,Мочизуки-сан ешқашан келмеген шығар...
Dialogue: 0,0:24:46.86,0:24:49.40,Default,,0,0,0,,Қарашы, мен оны жалғыз қалдыра алмаймын...
Dialogue: 0,0:24:49.77,0:24:51.07,Default,,0,0,0,,Я~
Dialogue: 0,0:24:51.69,0:24:53.28,Default,,0,0,0,,Не болды? ойда болу?
Dialogue: 0,0:24:53.40,0:24:56.49,Default,,0,0,0,,А, уайымдама, менің бірінші нөмірім...
Dialogue: 0,0:24:57.53,0:24:59.08,Default,,0,0,0,,Дұрыс? Мені араласпа.
Dialogue: 0,0:24:59.41,0:25:02.33,Default,,0,0,0,,Жарайсың, ағайын!
Dialogue: 0,0:25:02.58,0:25:05.29,Default,,0,0,0,,(Мими күледі)
Dialogue: 0,0:25:05.42,0:25:08.84,Default,,0,0,0,,Иә? (Аспан) Менде отын жетпей қалуы мүмкін.
Dialogue: 0,0:25:09.67,0:25:10.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:35.90,0:25:36.82,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:25:37.86,0:25:39.49,Default,,0,0,0,,(шу)
Dialogue: 0,0:25:41.79,0:25:43.45,Default,,0,0,0,,Сізді не уайымдады?
Dialogue: 0,0:25:44.66,0:25:45.87,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:25:54.38,0:25:55.22,Default,,0,0,0,,Хмм
Dialogue: 0,0:25:56.34,0:25:57.18,Default,,0,0,0,,А...
Dialogue: 0,0:25:59.64,0:26:00.89,Default,,0,0,0,,А...
Dialogue: 0,0:26:01.26,0:26:04.35,Default,,0,0,0,,Түскі ас қорабы Бұл дәмді болды.
Dialogue: 0,0:26:08.73,0:26:09.77,Default,,0,0,0,,Брандо мырза
Dialogue: 0,0:26:10.44,0:26:11.90,Default,,0,0,0,,Сізді не уайымдады?
Dialogue: 0,0:26:14.03,0:26:14.90,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:26:38.97,0:26:40.43,Default,,0,0,0,,Иә! (Тайчи) Не! ? Агумон! ?
Dialogue: 0,0:26:41.47,0:26:44.56,Default,,0,0,0,,Хаха... Эй
Dialogue: 0,0:26:45.97,0:26:47.52,Default,,0,0,0,,Сіз не істеп жатырсыз? ?
Dialogue: 0,0:26:47.64,0:26:50.90,Default,,0,0,0,,Иә? иә? Бұл біртүрлі -
Dialogue: 0,0:26:51.02,0:26:54.90,Default,,0,0,0,,Мен көп балық ауладым деп ойладым, бірақ... бұл арман болды ма?
Dialogue: 0,0:26:55.03,0:26:57.44,Default,,0,0,0,,Сіз қаншалықты сараңсыз?
Dialogue: 0,0:26:57.90,0:26:58.95,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:26:59.20,0:27:01.95,Default,,0,0,0,,Эххехе…
Dialogue: 0,0:27:09.96,0:27:11.96,Default,,0,0,0,,Бос па? О аспан!
Dialogue: 0,0:27:14.59,0:27:18.13,Default,,0,0,0,,Жаман Агумон, бірінші оралыңыз.
Dialogue: 0,0:27:18.26,0:27:19.72,Default,,0,0,0,,
Dialogue: 0,0:27:28.18,0:27:33.52,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:27:36.98,0:27:37.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:41.70,0:27:42.86,Default,,0,0,0,,Бұл дегеніміз
Dialogue: 0,0:27:43.78,0:27:45.28,Default,,0,0,0,,Жоқ! ?
Dialogue: 0,0:27:45.41,0:27:47.12,Default,,0,0,0,,Директор Химекава?
Dialogue: 0,0:27:48.66,0:27:50.62,Default,,0,0,0,,(Пернетақтаны түрту дыбысы)
Dialogue: 0,0:27:59.88,0:28:00.72,Default,,0,0,0,,Ммм
Dialogue: 0,0:28:04.72,0:28:05.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:12.35,0:28:13.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:28.74,0:28:30.75,Default,,0,0,0,,Эй, мен бірдеңені дұрыс істемедім бе?
Dialogue: 0,0:28:30.91,0:28:34.29,Default,,0,0,0,,Бұл өзгермеген жалғыз нәрсе. Атмосфераны аздап оқыңыз.
Dialogue: 0,0:28:34.42,0:28:38.84,Default,,0,0,0,,Мен білмеймін. Осындай жағдайда дұрыс жауап қандай екенін білесіз бе?
Dialogue: 0,0:28:39.88,0:28:41.17,Default,,0,0,0,,Такеруден сұрауым керек пе?
Dialogue: 0,0:28:42.01,0:28:43.17,Default,,0,0,0,,Себебі мен сізді естимін!
Dialogue: 0,0:28:43.43,0:28:44.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:45.18,0:28:46.68,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:28:47.64,0:28:49.68,Default,,0,0,0,,Эй, тыныштал.
Dialogue: 0,0:28:49.81,0:28:53.35,Default,,0,0,0,,«Түзету» нені білдіреді? Неге ашуланғаныңды білмесем де
Dialogue: 0,0:28:53.48,0:28:54.81,Default,,0,0,0,,Неге ашуланасың?
Dialogue: 0,0:28:54.94,0:28:56.19,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,0:28:57.86,0:28:59.52,Default,,0,0,0,,Қандай азап...
Dialogue: 0,0:28:59.82,0:29:02.65,Default,,0,0,0,,Өкінішті-ақ, бұл өте қиын болды! Уф
Dialogue: 0,0:29:03.03,0:29:04.65,Default,,0,0,0,,Эй... (Тайчи) Сабыр ет!
Dialogue: 0,0:29:05.28,0:29:07.41,Default,,0,0,0,,Екеуің де атмосфераны оқи алмайсыңдар.
Dialogue: 0,0:29:07.53,0:29:10.03,Default,,0,0,0,,Уақыт дұрыс емес, біз жақын арада ұрысты бастаймыз!
Dialogue: 0,0:29:10.16,0:29:11.66,Default,,0,0,0,,Әркім әрқашан тек өзі туралы!
Dialogue: 0,0:29:12.25,0:29:15.67,Default,,0,0,0,,Маған не ойлайтыным, не сезінетінім маңызды емес!
Dialogue: 0,0:29:16.50,0:29:18.21,Default,,0,0,0,,Бұл туралы ойламаңыз!
Dialogue: 0,0:29:19.84,0:29:20.67,Default,,0,0,0,,Ешкім...
Dialogue: 0,0:29:22.42,0:29:23.97,Default,,0,0,0,,Мен ойламаймын...
Dialogue: 0,0:29:26.63,0:29:29.89,Default,,0,0,0,,Түсінбедім, көкке деген сезімім бар еді.
Dialogue: 0,0:29:30.01,0:29:31.81,Default,,0,0,0,,Адамдарға немқұрайлы болсам да...
Dialogue: 0,0:29:31.93,0:29:35.77,Default,,0,0,0,,Өзіңіз туралы қорытындыға келмеңіз және өзіңіз туралы ештеңе айтпаңыз.
Dialogue: 0,0:29:37.48,0:29:41.15,Default,,0,0,0,,Аспанның жақсы жағы осы шығар.
Dialogue: 0,0:29:41.27,0:29:42.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:29:42.82,0:29:43.74,Default,,0,0,0,,Өзіңіз ше?
Dialogue: 0,0:29:43.86,0:29:44.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:45.11,0:29:47.20,Default,,0,0,0,,Өзіңізге көбірек қамқорлық жасаңыз.
Dialogue: 0,0:29:48.70,0:29:50.20,Default,,0,0,0,,Меншік?
Dialogue: 0,0:29:50.66,0:29:51.79,Default,,0,0,0,,Бұл мүмкін емес пе?
Dialogue: 0,0:29:51.91,0:29:54.45,Default,,0,0,0,,Бірақ бұл аспанның жақсы жағы.
Dialogue: 0,0:29:54.58,0:29:59.50,Default,,0,0,0,,Хехехе, бірақ мен аспанға қамқормын.
Dialogue: 0,0:29:59.63,0:30:00.71,Default,,0,0,0,,Бірінші
Dialogue: 0,0:30:01.09,0:30:02.55,Default,,0,0,0,,Мен осы құдай таңдаған ессіз ғалыммын…
Dialogue: 0,0:30:05.80,0:30:08.64,Default,,0,0,0,,Биомон сияқты сөздерді айтпа...
Dialogue: 0,0:30:09.76,0:30:10.76,Default,,0,0,0,,Шығыс Одақпен ешқандай ойынға жол жоқ!
Dialogue: 0,0:30:11.97,0:30:12.39,Default,,0,0,0,,(шу)
Dialogue: 0,0:30:12.39,0:30:13.18,Default,,0,0,0,,(шу)
Dialogue: 0,0:30:12.39,0:30:13.18,Default,,0,0,0,,Ах
Dialogue: 0,0:30:13.18,0:30:15.98,Default,,0,0,0,,(шу)
Dialogue: 0,0:30:16.43,0:30:18.19,Default,,0,0,0,,Мейкомон! ? (Тайчи/Ямато) Ах.
Dialogue: 0,0:30:20.77,0:30:23.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:30:32.53,0:30:33.66,Default,,0,0,0,,Ах
Dialogue: 0,0:30:41.38,0:30:42.71,Default,,0,0,0,,Мугендрамон...
Dialogue: 0,0:30:47.80,0:30:48.72,Default,,0,0,0,,Аспан! !
Dialogue: 0,0:30:55.89,0:30:58.23,Default,,0,0,0,,Уф, шындап...
Dialogue: 0,0:31:00.65,0:31:03.23,Default,,0,0,0,,Ямато Мен Мейкомонды қуамын! иә!
Dialogue: 0,0:31:06.90,0:31:10.24,Default,,0,0,0,,Әй... Керемет! Бұл керемет!
Dialogue: 0,0:31:11.20,0:31:13.74,Default,,0,0,0,,Бұл не үлкен...
Dialogue: 0,0:31:14.12,0:31:15.74,Default,,0,0,0,,Мен өзімді өте нашар сезінемін...
Dialogue: 0,0:31:20.33,0:31:23.21,Default,,0,0,0,,(Мугендрамонның айқайы)
Dialogue: 0,0:31:23.33,0:31:26.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:27.46,0:31:28.46,Default,,0,0,0,,Барлығымыз, қашайық!
Dialogue: 0,0:31:29.09,0:31:30.76,Default,,0,0,0,,Бірақ менің ағаларым
Dialogue: 0,0:31:31.22,0:31:33.76,Default,,0,0,0,,Мен Тайчи мен басқаларды іздеймін!
Dialogue: 0,0:31:33.89,0:31:35.64,Default,,0,0,0,,Егер сіз мұны істеп жатсаңыз!
Dialogue: 0,0:31:35.76,0:31:37.22,Default,,0,0,0,,Мен бұл жерден тез кетуім керек.
Dialogue: 0,0:31:37.35,0:31:38.27,Default,,0,0,0,,Сіз соққыға ұшырайсыз.
Dialogue: 0,0:31:38.81,0:31:41.27,Default,,0,0,0,,Мен қорқып тұрмын, біреу маған көмектесіңізші
Dialogue: 0,0:31:41.69,0:31:43.23,Default,,0,0,0,,Барлығы тынышталсын.
Dialogue: 0,0:31:43.35,0:31:45.98,Default,,0,0,0,,Мен Тайчи мен басқалардың қауіпсіз болатынына сенімдімін, сондықтан...
Dialogue: 0,0:31:46.11,0:31:48.28,Default,,0,0,0,,мамыр! ! (Ұзындығы) Ха! ?
Dialogue: 0,0:31:50.49,0:31:51.78,Default,,0,0,0,,Мейкомон! ?
Dialogue: 0,0:31:52.28,0:31:54.78,Default,,0,0,0,,Мэй~ Мэй~! !
Dialogue: 0,0:31:55.28,0:31:56.37,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:31:56.87,0:31:58.79,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:31:59.25,0:32:00.29,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:32:02.04,0:32:02.46,Default,,0,0,0,,(Мугендрамонның ізі)
Dialogue: 0,0:32:02.46,0:32:03.29,Default,,0,0,0,,(Мугендрамонның ізі)
Dialogue: 0,0:32:02.46,0:32:03.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:06.88,0:32:08.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:10.30,0:32:13.18,Default,,0,0,0,,Мэй, сен қайдасың?
Dialogue: 0,0:32:13.30,0:32:14.80,Default,,0,0,0,,Неге мені жалғыз қалдыру керек?
Dialogue: 0,0:32:25.90,0:32:27.32,Default,,0,0,0,,Агумон эволюциясы!
Dialogue: 0,0:32:27.65,0:32:28.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:29.23,0:32:30.32,Default,,0,0,0,,Габумон!
Dialogue: 0,0:32:32.90,0:32:33.82,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:32:34.32,0:32:35.32,Default,,0,0,0,,Тентомон!
Dialogue: 0,0:32:35.78,0:32:37.33,Default,,0,0,0,,Эй, сәл күте тұрыңыз!
Dialogue: 0,0:32:37.66,0:32:39.04,Default,,0,0,0,,кенеттен «Өтінемін»
Dialogue: 0,0:32:39.16,0:32:40.58,Default,,0,0,0,,Тіпті...
Dialogue: 0,0:32:50.09,0:32:50.96,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:32:51.09,0:32:52.09,Default,,0,0,0,,Бұл...
Dialogue: 0,0:32:52.55,0:32:56.09,Default,,0,0,0,,Күтілгендей, біз бұдан әрі қарай дами алмаймыз...
Dialogue: 0,0:32:56.51,0:32:59.10,Default,,0,0,0,,Биомон Биомон қайда! ?
Dialogue: 0,0:33:01.47,0:33:03.18,Default,,0,0,0,,Биомон! ! Ах
Dialogue: 0,0:33:11.19,0:33:12.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:14.24,0:33:16.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:17.24,0:33:19.03,Default,,0,0,0,,Тек осы екі қарапайым белгіні есте сақта.
Dialogue: 0,0:33:20.20,0:33:22.58,Default,,0,0,0,,Ең алдымен, техникалық колледжде—
Dialogue: 0,0:33:23.45,0:33:26.08,Default,,0,0,0,,Ах, а, а...
Dialogue: 0,0:33:26.21,0:33:28.79,Default,,0,0,0,,Ууууууууууууууууууу...
Dialogue: 0,0:33:29.21,0:33:31.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:33.55,0:33:35.13,Default,,0,0,0,,Уау уау
Dialogue: 0,0:33:35.72,0:33:37.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:05.20,0:34:08.04,Default,,0,0,0,,«Цифрлық әлемнің құпия ақпараты»
Dialogue: 0,0:34:08.17,0:34:10.67,Default,,0,0,0,,«Қайта жүктегеннен кейін Digimon-тың ағымдағы орны»?
Dialogue: 0,0:34:11.46,0:34:12.92,Default,,0,0,0,,(Камо) Һм. (Фушигиро) Ұф.
Dialogue: 0,0:34:13.05,0:34:13.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:19.22,0:34:20.93,Default,,0,0,0,,Химе-чан (Химекава) Эй!
Dialogue: 0,0:34:21.43,0:34:23.39,Default,,0,0,0,,Иә какао
Dialogue: 0,0:34:24.47,0:34:25.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:26.27,0:34:27.44,Default,,0,0,0,,Қайта жүктеңіз!
Dialogue: 0,0:34:27.89,0:34:31.02,Default,,0,0,0,,Егер мен мұны істей алсам, Бакумонмен тағы да кездесе алатыныма сенімдімін.
Dialogue: 0,0:34:31.15,0:34:32.02,Default,,0,0,0,,О
Dialogue: 0,0:34:33.27,0:34:34.94,Default,,0,0,0,,Цигитама туылмайды
Dialogue: 0,0:34:35.57,0:34:37.24,Default,,0,0,0,,Сіз мұны талай рет естідіңіз, солай емес пе?
Dialogue: 0,0:34:37.65,0:34:40.20,Default,,0,0,0,,Бакумон – төрт қасиетті аңның дүниеге келуі...
Dialogue: 0,0:34:42.12,0:34:43.20,Default,,0,0,0,,құрбандыққа шалынды
Dialogue: 0,0:34:43.45,0:34:44.33,Default,,0,0,0,,О
Dialogue: 0,0:34:44.79,0:34:46.95,Default,,0,0,0,,Мен енді ешқашан Digitama-ға оралмаймын.
Dialogue: 0,0:34:47.08,0:34:49.17,Default,,0,0,0,,Сондықтан қайта жүктеу жалғыз нұсқа болып табылады
Dialogue: 0,0:34:49.29,0:34:51.46,Default,,0,0,0,,Мен келесі жылы жұмысқа тұрғанда...
Dialogue: 0,0:34:51.58,0:34:54.09,Default,,0,0,0,,Барынша зерттеймін... (Нишижима) Тоқтама.
Dialogue: 0,0:34:54.38,0:34:55.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:58.80,0:35:01.18,Default,,0,0,0,,Не?
Dialogue: 0,0:35:01.30,0:35:05.14,Default,,0,0,0,,Неліктен жұмысты тастамайсың? Мен оны көре алмаймын
Dialogue: 0,0:35:06.31,0:35:07.93,Default,,0,0,0,,Қарау қиын
Dialogue: 0,0:35:10.10,0:35:13.61,Default,,0,0,0,,Мен алмаймын ба? жаңа серіктес
Dialogue: 0,0:35:13.73,0:35:14.65,Default,,0,0,0,,Ха!
Dialogue: 0,0:35:18.78,0:35:19.86,Default,,0,0,0,,П... (Нишижима) О!
Dialogue: 0,0:35:20.86,0:35:21.99,Default,,0,0,0,,Хехехе
Dialogue: 0,0:35:22.12,0:35:23.83,Default,,0,0,0,,Ахахаха (Нишижима) Уау! !
Dialogue: 0,0:35:23.95,0:35:26.74,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:35:26.87,0:35:28.37,Default,,0,0,0,,Сіз драмаларды көп көрмейсіз бе?
Dialogue: 0,0:35:28.79,0:35:31.29,Default,,0,0,0,,Ха ха ха ха ха
Dialogue: 0,0:35:31.96,0:35:35.50,Default,,0,0,0,,Жарайды, байқап көруге болады.
Dialogue: 0,0:35:36.25,0:35:37.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:37.84,0:35:39.47,Default,,0,0,0,,Иә! !
Dialogue: 0,0:35:41.22,0:35:42.05,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:35:44.14,0:35:45.26,Default,,0,0,0,,Геннай…
Dialogue: 0,0:35:45.47,0:35:52.27,Default,,0,0,0,,(Пернетақтаны түрту дыбысы)
Dialogue: 0,0:35:52.98,0:35:54.02,Default,,0,0,0,,Yggdrasil?
Dialogue: 0,0:35:54.15,0:35:55.19,Default,,0,0,0,,(шу)
Dialogue: 0,0:35:55.31,0:35:56.15,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:35:58.61,0:36:02.32,Default,,0,0,0,,Менің атым Хэкмон
Dialogue: 0,0:36:07.03,0:36:08.20,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:36:09.29,0:36:11.41,Default,,0,0,0,,Барлығы ше? Ха!
Dialogue: 0,0:36:14.50,0:36:15.67,Default,,0,0,0,,Биомон...!
Dialogue: 0,0:36:19.38,0:36:20.92,Default,,0,0,0,,Биомон күтіңіз!
Dialogue: 0,0:36:21.34,0:36:23.18,Default,,0,0,0,,Неліктен? (Аспан) А?
Dialogue: 0,0:36:23.80,0:36:25.18,Default,,0,0,0,,Неге менің артымнан келе жатырсың?
Dialogue: 0,0:36:25.51,0:36:26.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:28.56,0:36:29.60,Default,,0,0,0,,Себебі мен уайымдап тұрмын
Dialogue: 0,0:36:29.72,0:36:32.44,Default,,0,0,0,,Өтірік, жалғыз қалудан қорқатындықтан.
Dialogue: 0,0:36:32.56,0:36:33.48,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:36:33.60,0:36:34.94,Default,,0,0,0,,Олай болса, мен басқа баланы іздеуім керек пе?
Dialogue: 0,0:36:35.27,0:36:37.69,Default,,0,0,0,,Биомон! Неге түсінбейсің? ?
Dialogue: 0,0:36:38.07,0:36:39.19,Default,,0,0,0,,Себебі мен білмеймін!
Dialogue: 0,0:36:39.65,0:36:40.94,Default,,0,0,0,,Сіз туралы!
Dialogue: 0,0:36:41.32,0:36:42.65,Default,,0,0,0,,Ха…
Dialogue: 0,0:36:44.41,0:36:45.24,Default,,0,0,0,,Хун
Dialogue: 0,0:36:45.82,0:36:46.66,Default,,0,0,0,,Пиёмон…
Dialogue: 0,0:36:46.78,0:36:48.45,Default,,0,0,0,,Бағдарлама коды…
Dialogue: 0,0:36:51.20,0:36:53.29,Default,,0,0,0,,(бос айқай)
Dialogue: 0,0:36:54.04,0:36:55.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:08.14,0:37:10.68,Default,,0,0,0,,Иә! ? Мешин-чан?
Dialogue: 0,0:37:12.81,0:37:13.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:15.44,0:37:16.73,Default,,0,0,0,,Сора-сан?
Dialogue: 0,0:37:18.23,0:37:19.65,Default,,0,0,0,,Неге...
Dialogue: 0,0:37:19.94,0:37:20.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:37:26.11,0:37:28.57,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:37:29.95,0:37:31.66,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:37:31.79,0:37:33.37,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:37:33.91,0:37:35.00,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:37:35.12,0:37:37.63,Default,,0,0,0,,Агумон! Хикари!
Dialogue: 0,0:37:37.96,0:37:40.88,Default,,0,0,0,,Я Ямато-кун!
Dialogue: 0,0:37:42.00,0:37:42.96,Default,,0,0,0,,Ямато-кун?
Dialogue: 0,0:37:43.09,0:37:45.38,Default,,0,0,0,,Мен оны қалай атасам да болады ма?
Dialogue: 0,0:37:46.38,0:37:47.26,Default,,0,0,0,,Фуфу
Dialogue: 0,0:37:47.39,0:37:48.89,Default,,0,0,0,,Тайчи! (Тайчи) Ой
Dialogue: 0,0:37:52.14,0:37:53.14,Default,,0,0,0,,Ой!
Dialogue: 0,0:37:53.72,0:37:55.31,Default,,0,0,0,,Плотмон! ?
Dialogue: 0,0:37:57.81,0:38:00.15,Default,,0,0,0,,Хикари, жақсысың ба? Ах...
Dialogue: 0,0:38:00.98,0:38:04.03,Default,,0,0,0,,Үлкен аға... Плотмон...
Dialogue: 0,0:38:04.15,0:38:06.36,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:38:06.49,0:38:07.99,Default,,0,0,0,,Хикари! Уау
Dialogue: 0,0:38:08.82,0:38:09.66,Default,,0,0,0,,Фуфу
Dialogue: 0,0:38:10.66,0:38:11.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:15.16,0:38:17.67,Default,,0,0,0,,Барлығы ше? (Тайчи) Мен түсінбеймін...
Dialogue: 0,0:38:18.71,0:38:21.34,Default,,0,0,0,,Мугендрамон да кенеттен жоғалып кетті...
Dialogue: 0,0:38:21.46,0:38:23.88,Default,,0,0,0,,Менің алдымда біртүрлі тесік пайда болды...
Dialogue: 0,0:38:24.01,0:38:26.05,Default,,0,0,0,,Мен мұны білмей тұрып, Тайчимен бірге болдым.
Dialogue: 0,0:38:26.17,0:38:27.43,Default,,0,0,0,,Мені тастап кетті ме?
Dialogue: 0,0:38:27.88,0:38:30.80,Default,,0,0,0,,Біртүрлі тесік... бұрмаланған шығар?
Dialogue: 0,0:38:31.35,0:38:32.56,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:38:32.68,0:38:34.10,Default,,0,0,0,,Сіздің арқаңызда мен құтқарылдым.
Dialogue: 0,0:38:34.22,0:38:36.10,Default,,0,0,0,,Барлығы қауіпсіз, солай ма?
Dialogue: 0,0:38:36.98,0:38:37.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:38:52.91,0:38:53.99,Default,,0,0,0,,Өтірікші...
Dialogue: 0,0:38:56.08,0:38:58.12,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:39:02.79,0:39:04.21,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:39:05.38,0:39:07.47,Default,,0,0,0,,Уф!
Dialogue: 0,0:39:15.18,0:39:16.47,Default,,0,0,0,,Сен…
Dialogue: 0,0:39:21.69,0:39:23.36,Default,,0,0,0,,Осы уақытқа дейін орманда...
Dialogue: 0,0:39:23.48,0:39:25.94,Default,,0,0,0,,Мугендрамон сонда болса да...
Dialogue: 0,0:39:26.23,0:39:27.36,Default,,0,0,0,,Ағаларыңа құрмет көрсет!
Dialogue: 0,0:39:27.74,0:39:30.11,Default,,0,0,0,,Түсіндім, бұл арман!
Dialogue: 0,0:39:30.24,0:39:33.12,Default,,0,0,0,,Уф Агумон, ауырып тұр...
Dialogue: 0,0:39:33.24,0:39:34.37,Default,,0,0,0,,Сол Титан
Dialogue: 0,0:39:34.87,0:39:36.87,Default,,0,0,0,,Біз не істейміз? Ямато мырза
Dialogue: 0,0:39:44.46,0:39:47.63,Default,,0,0,0,,(Мешиннің тыныс алу дыбысы)
Dialogue: 0,0:39:47.76,0:39:48.59,Default,,0,0,0,,Ha
Dialogue: 0,0:39:48.71,0:39:50.38,Default,,0,0,0,,(Бүршіктің жөтелі)
Dialogue: 0,0:39:50.76,0:39:52.39,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:39:54.26,0:39:55.89,Default,,0,0,0,,арқылы жасалған
Dialogue: 0,0:39:56.26,0:39:59.14,Default,,0,0,0,,Керемет, оны қайдан білдің?
Dialogue: 0,0:39:59.27,0:40:01.19,Default,,0,0,0,,Бұл үлкен мәселе емес...
Dialogue: 0,0:40:01.31,0:40:03.90,Default,,0,0,0,,Менің туған жерім тауларға толы, сондықтан мен онда көп ойнадым.
Dialogue: 0,0:40:04.52,0:40:05.90,Default,,0,0,0,,Мэй-чан және...
Dialogue: 0,0:40:12.07,0:40:13.70,Default,,0,0,0,,Мен Мейкомонмен кездестім
Dialogue: 0,0:40:13.82,0:40:15.37,Default,,0,0,0,,Мен Мешин-чанды іздеп жүрмін
Dialogue: 0,0:40:15.49,0:40:18.29,Default,,0,0,0,,Мені есіңізде ме?
Dialogue: 0,0:40:18.41,0:40:19.29,Default,,0,0,0,,Жақсы
Dialogue: 0,0:40:22.62,0:40:23.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:24.79,0:40:25.75,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:40:25.88,0:40:28.50,Default,,0,0,0,,Жоқ, барлығы күтіп отыр.
Dialogue: 0,0:40:28.63,0:40:30.80,Default,,0,0,0,,Барлығы Мешин-чанға алаңдады.
Dialogue: 0,0:40:31.55,0:40:32.76,Default,,0,0,0,,Сізді күттіріп қойдым ба?
Dialogue: 0,0:40:34.34,0:40:35.64,Default,,0,0,0,,Сора-сан?
Dialogue: 0,0:40:36.14,0:40:37.10,Default,,0,0,0,,Ах
Dialogue: 0,0:40:41.02,0:40:42.81,Default,,0,0,0,,Иә Бұл жеткілікті ме?
Dialogue: 0,0:40:43.23,0:40:44.60,Default,,0,0,0,,Рахмет сізге Биомон
Dialogue: 0,0:40:44.73,0:40:47.48,Default,,0,0,0,,Эй, Биомонды бірге жейміз.
Dialogue: 0,0:40:50.15,0:40:51.82,Default,,0,0,0,,Жақсы Қажет емес
Dialogue: 0,0:40:54.66,0:40:55.57,Default,,0,0,0,,Иә
Dialogue: 0,0:40:55.70,0:40:57.66,Default,,0,0,0,,Олай айтпа, жарай ма?
Dialogue: 0,0:40:57.83,0:41:01.83,Default,,0,0,0,,Бұл жерде күн жылырақ, мен Биомонмен көбірек сөйлескім келеді.
Dialogue: 0,0:41:05.54,0:41:06.38,Default,,0,0,0,,Ах
Dialogue: 0,0:41:07.17,0:41:08.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:09.42,0:41:10.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:12.34,0:41:13.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:15.01,0:41:17.68,Default,,0,0,0,,Мен жау да, одақтас та емеспін...
Dialogue: 0,0:41:18.01,0:41:20.18,Default,,0,0,0,,Гомеостаз хабаршысы
Dialogue: 0,0:41:20.31,0:41:21.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:21.77,0:41:25.94,Default,,0,0,0,,Гомеостаз дегеніміз не? Басқаша айтқанда, «тұрақтылықты қалайтындар»
Dialogue: 0,0:41:26.52,0:41:30.15,Default,,0,0,0,,Геннай енді қозғала алмай, хабаршы болып келдім.
Dialogue: 0,0:41:30.27,0:41:31.11,Default,,0,0,0,,Ах
Dialogue: 0,0:41:32.11,0:41:36.91,Default,,0,0,0,,Жарық пен қараңғылықтың тепе-теңдігін түзетуге көмектесетін Геннай.
Dialogue: 0,0:41:37.70,0:41:41.33,Default,,0,0,0,,Бірақ көмектесетін қол қазірдің өзінде қараңғыда ұсталды ...
Dialogue: 0,0:41:41.45,0:41:44.41,Default,,0,0,0,,Қараңғылықтың қолы оның орнына әлемге созылады.
Dialogue: 0,0:41:44.54,0:41:47.37,Default,,0,0,0,,Хмм... Химе-чан ше?
Dialogue: 0,0:41:48.04,0:41:51.67,Default,,0,0,0,,Ол қазір өз еркімен цифрлық әлемде.
Dialogue: 0,0:41:51.80,0:41:52.80,Default,,0,0,0,,О!
Dialogue: 0,0:41:53.88,0:41:58.05,Default,,0,0,0,,Йггдрасил өз мақсаттарына жету үшін бәрін жасайды.
Dialogue: 0,0:41:58.55,0:42:03.27,Default,,0,0,0,,Ол Маки Химекаваға көз тігіп, Йггдрасилмен күш біріктірді.
Dialogue: 0,0:42:03.77,0:42:05.89,Default,,0,0,0,,Мақсатты орындау
Dialogue: 0,0:42:14.07,0:42:14.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:42:16.49,0:42:20.41,Default,,0,0,0,,Қауіпті тоқтату үшін бізге адам ынтымақтастығы қажет.
Dialogue: 0,0:42:21.08,0:42:23.66,Default,,0,0,0,,Олар «Кітапхананы» пайдалануға тырысуда
Dialogue: 0,0:42:24.33,0:42:26.16,Default,,0,0,0,,Мейкомон, солай ма?
Dialogue: 0,0:42:29.58,0:42:30.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:32.67,0:42:34.76,Default,,0,0,0,,Таразы – белгісіз шама...
Dialogue: 0,0:42:35.42,0:42:40.68,Default,,0,0,0,,Дүние олардың қолына түссе, жойылады.
Dialogue: 0,0:42:43.35,0:42:44.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:49.81,0:42:52.19,Default,,0,0,0,,Коуширо хаа!
Dialogue: 0,0:42:52.69,0:42:55.82,Default,,0,0,0,,Барлығына! Пальмон!
Dialogue: 0,0:42:55.94,0:42:58.95,Default,,0,0,0,,Күрсін, звондап шаршадым.
Dialogue: 0,0:42:59.49,0:43:01.32,Default,,0,0,0,,Патамун!
Dialogue: 0,0:43:01.45,0:43:03.53,Default,,0,0,0,,Коуширо хаа!
Dialogue: 0,0:43:03.83,0:43:05.49,Default,,0,0,0,,Агмон!
Dialogue: 0,0:43:05.62,0:43:07.83,Default,,0,0,0,,Коуширо хаа!
Dialogue: 0,0:43:07.96,0:43:11.17,Default,,0,0,0,,А? Неліктен мен Уэйт Коуширо-ханның атын айта берем...
Dialogue: 0,0:43:11.29,0:43:14.92,Default,,0,0,0,,Жақсы араласатынымызға сенімдімін! Біз көптен бері доспыз!
Dialogue: 0,0:43:15.05,0:43:18.22,Default,,0,0,0,,Ха, мен шынымен түсінбеймін...
Dialogue: 0,0:43:18.76,0:43:20.34,Default,,0,0,0,,Коуширо-кун?
Dialogue: 0,0:43:20.47,0:43:23.72,Default,,0,0,0,,Осындай кезде менімен бірге болатыныңызға сенемін.
Dialogue: 0,0:43:24.05,0:43:26.22,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:44:17.36,0:44:21.28,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:44:25.74,0:44:26.74,Default,,0,0,0,,мамыр…
Dialogue: 0,0:44:27.83,0:44:30.95,Default,,0,0,0,,Сізге енді Мэй керек емес пе?
Dialogue: 0,0:44:36.59,0:44:38.05,Default,,0,0,0,,Осымен.
Dialogue: 0,0:44:38.50,0:44:41.55,Default,,0,0,0,,Біраз қозғалмай қалсаңыз, тез жазыласыз.
Dialogue: 0,0:44:41.67,0:44:43.01,Default,,0,0,0,,Рахмет сізге Elekimon
Dialogue: 0,0:44:43.13,0:44:44.64,Default,,0,0,0,,Мен кішкентайларға да қамқормын.
Dialogue: 0,0:44:44.76,0:44:48.26,Default,,0,0,0,,Маған көмектесіп тұрған Айко.
Dialogue: 0,0:44:48.39,0:44:49.93,Default,,0,0,0,,Сондай ностальгиялық
Dialogue: 0,0:44:50.06,0:44:53.06,Default,,0,0,0,,Патамон мен үшеуіңіз кішкентайларға қамқор болдыңыз ба...
Dialogue: 0,0:44:53.39,0:44:57.82,Default,,0,0,0,,Хмм, жаман. Қанша естісем де есімде жоқ.
Dialogue: 0,0:44:58.40,0:45:00.07,Default,,0,0,0,,Сандық әлем үшін -
Dialogue: 0,0:45:00.19,0:45:02.40,Default,,0,0,0,,Бәрі ешқашан болған емес екен...
Dialogue: 0,0:45:02.78,0:45:05.95,Default,,0,0,0,,Бірақ есімізде
Dialogue: 0,0:45:06.07,0:45:07.66,Default,,0,0,0,,Сондай-ақ біздің алғаш кездескеніміз туралы...
Dialogue: 0,0:45:07.78,0:45:09.83,Default,,0,0,0,,Ажырасу керек болғанда не болды...
Dialogue: 0,0:45:10.29,0:45:13.46,Default,,0,0,0,,Сіз бұл туралы мұқият қарауыңыз керек.
Dialogue: 0,0:45:13.58,0:45:15.08,Default,,0,0,0,,Мен де сенімен танысқым келеді.
Dialogue: 0,0:45:15.50,0:45:18.67,Default,,0,0,0,,Иә, мен де сенімен танысқым келеді.
Dialogue: 0,0:45:22.17,0:45:24.47,Default,,0,0,0,,Тайчи және басқалары осында бола ма?
Dialogue: 0,0:45:24.59,0:45:25.59,Default,,0,0,0,,Қызық екен.
Dialogue: 0,0:45:26.01,0:45:27.47,Default,,0,0,0,,Егер сіз осы жолды орындасаңыз...
Dialogue: 0,0:45:27.59,0:45:31.10,Default,,0,0,0,,Мүмкін біз трамвай жүретін көлге жетеміз.
Dialogue: 0,0:45:31.89,0:45:34.10,Default,,0,0,0,,Дәлел мүлде болмаса да
Dialogue: 0,0:45:34.44,0:45:36.19,Default,,0,0,0,,Егер сіз менің айтқанымды тыңдасаңыз...
Dialogue: 0,0:45:36.31,0:45:38.77,Default,,0,0,0,,Мен Джомен көбірек сөйлескім келеді.
Dialogue: 0,0:45:38.90,0:45:42.28,Default,,0,0,0,,Оқудың қызығы неде? Подруги деген не?
Dialogue: 0,0:45:42.40,0:45:44.36,Default,,0,0,0,,Менің сізден сұрайын дегенім көп.
Dialogue: 0,0:45:44.61,0:45:47.78,Default,,0,0,0,,Ямато ешқашан Тайчи туралы айтпайды.
Dialogue: 0,0:45:47.91,0:45:49.16,Default,,0,0,0,,Жаман қарым-қатынастасыз ба?
Dialogue: 0,0:45:49.28,0:45:51.24,Default,,0,0,0,,(Косиро) Біз шынымен жақсы доспыз.
Dialogue: 0,0:45:51.37,0:45:54.04,Default,,0,0,0,,Бұл жақсы емес. Сізге ұнамайды ма?
Dialogue: 0,0:45:55.33,0:45:56.33,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:45:57.21,0:46:00.13,Default,,0,0,0,,Мен сені жек көрмеймін, мен тек...
Dialogue: 0,0:46:00.92,0:46:02.63,Default,,0,0,0,,Тым көп нәрсені күту
Dialogue: 0,0:46:03.17,0:46:04.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:04.67,0:46:05.13,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:46:05.13,0:46:06.13,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:46:05.13,0:46:06.13,Default,,0,0,0,,Хмм?
Dialogue: 0,0:46:06.13,0:46:06.76,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:46:06.76,0:46:07.59,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:46:06.76,0:46:07.59,Default,,0,0,0,,О!
Dialogue: 0,0:46:31.91,0:46:33.49,Default,,0,0,0,,Кет, ақымақ!
Dialogue: 0,0:46:44.34,0:46:46.67,Default,,0,0,0,,Не? Қазір қуып көрейік
Dialogue: 0,0:46:47.01,0:46:49.68,Default,,0,0,0,,Өте жылдам! Ол енді жоқ
Dialogue: 0,0:46:50.47,0:46:53.47,Default,,0,0,0,,Бұл трамвай жолы емес сияқты.
Dialogue: 0,0:46:53.60,0:46:56.52,Default,,0,0,0,,Басқа жолмен жүреміз бе?\NСіз
Dialogue: 0,0:46:57.10,0:46:59.23,Default,,0,0,0,,-де не туралы айттыңыз?
Dialogue: 0,0:46:59.35,0:47:01.10,Default,,0,0,0,,Бұл Тайчи мен Ямато туралы.
Dialogue: 0,0:47:01.23,0:47:02.98,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:47:03.11,0:47:04.53,Default,,0,0,0,,Тайчи?
Dialogue: 0,0:47:04.65,0:47:08.32,Default,,0,0,0,,Келесі кездескенімізде мен саған такояки жеуге рұқсат беруім керек.
Dialogue: 0,0:47:08.82,0:47:09.70,Default,,0,0,0,,Аха…
Dialogue: 0,0:47:19.71,0:47:21.21,Default,,0,0,0,,Неге бәрін іздемейсің?
Dialogue: 0,0:47:22.79,0:47:26.21,Default,,0,0,0,,Маған қызық, бұл қазір сіз бен біз туралы.
Dialogue: 0,0:47:26.51,0:47:29.09,Default,,0,0,0,,Иә? (Тайчи) Мен ештеңе істей алмадым.
Dialogue: 0,0:47:29.72,0:47:32.39,Default,,0,0,0,,Егер жағдай туындаса, мен Агумонды дамыта аламын.
Dialogue: 0,0:47:32.51,0:47:33.85,Default,,0,0,0,,Мен ойладым...
Dialogue: 0,0:47:34.81,0:47:35.97,Default,,0,0,0,,Бұл жақсы болмады.
Dialogue: 0,0:47:36.56,0:47:37.89,Default,,0,0,0,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,0:47:39.31,0:47:42.15,Default,,0,0,0,,Заттар бұрынғы күйіне орала алмайды ма?
Dialogue: 0,0:47:47.78,0:47:51.99,Default,,0,0,0,,Менің ойымша, барлық қайта жүктеулер жаман емес.
Dialogue: 0,0:47:52.57,0:47:55.70,Default,,0,0,0,,Плотмон мұны бұрынғыдай жақсы деп санайды.
Dialogue: 0,0:47:55.83,0:47:58.25,Default,,0,0,0,,Мен қазір бақыттырақ шығармын
Dialogue: 0,0:47:59.50,0:48:02.42,Default,,0,0,0,,Ағымдағы Дигимонды қабылдаймыз.
Dialogue: 0,0:48:02.54,0:48:05.50,Default,,0,0,0,,Әйтпесе, біз де алға жылжи алмаймыз.
Dialogue: 0,0:48:10.34,0:48:11.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:48:15.60,0:48:17.14,Default,,0,0,0,,(Биёмонның ішкен дыбысы)
Dialogue: 0,0:48:17.26,0:48:18.02,Default,,0,0,0,,Иә
Dialogue: 0,0:48:25.65,0:48:27.52,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:48:29.11,0:48:33.45,Default,,0,0,0,,Мен бұрынғыдай араласқым келеді, бірақ олай емес...
Dialogue: 0,0:48:34.53,0:48:37.87,Default,,0,0,0,,Биомонның өткенді есіне түсірмейтінін білемін.
Dialogue: 0,0:48:37.99,0:48:38.99,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:48:39.95,0:48:41.75,Default,,0,0,0,,Түсінулеріңізді қалаймын
Dialogue: 0,0:48:42.12,0:48:45.13,Default,,0,0,0,,Мен жақсы болады деп ойладым.
Dialogue: 0,0:48:45.46,0:48:47.63,Default,,0,0,0,,Бірақ «білмеймін»…
Dialogue: 0,0:48:48.67,0:48:51.59,Default,,0,0,0,,«Мен сен туралы ештеңе білмеймін»...
Dialogue: 0,0:48:52.22,0:48:55.01,Default,,0,0,0,,Мен қателік жібердім бе?
Dialogue: 0,0:48:55.14,0:48:56.05,Default,,0,0,0,,Сіз қателеспейсіз!
Dialogue: 0,0:48:56.55,0:48:58.64,Default,,0,0,0,,Серіктес Digimon ерекше
Dialogue: 0,0:48:58.81,0:49:01.85,Default,,0,0,0,,Еш нәрсеге қарамастан, біз әрқашан байланыста боламыз!
Dialogue: 0,0:49:01.98,0:49:04.31,Default,,0,0,0,,Сора-сан маған айтты!
Dialogue: 0,0:49:04.65,0:49:07.06,Default,,0,0,0,,Өтінемін, олай айтпа...
Dialogue: 0,0:49:07.81,0:49:09.02,Default,,0,0,0,,Ха…
Dialogue: 0,0:49:12.15,0:49:14.57,Default,,0,0,0,,Кешіріңіз (бос) Жоқ.
Dialogue: 0,0:49:19.58,0:49:21.08,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,0:49:21.95,0:49:23.58,Default,,0,0,0,,Мэй Чан не істей алады?
Dialogue: 0,0:49:24.29,0:49:27.08,Default,,0,0,0,,Бірақ... мен серіктеспін.
Dialogue: 0,0:49:28.00,0:49:30.09,Default,,0,0,0,,Мен енді қашпаймын
Dialogue: 0,0:49:30.67,0:49:31.59,Default,,0,0,0,,Мешин-чан...
Dialogue: 0,0:49:31.71,0:49:33.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:36.09,0:49:37.59,Default,,0,0,0,,Мэй-чан! ? (Аспан) Мейком! ?
Dialogue: 0,0:49:38.89,0:49:39.93,Default,,0,0,0,,мамыр…
Dialogue: 0,0:49:40.39,0:49:42.60,Default,,0,0,0,,Мэй Чан Жақсы! Ах!
Dialogue: 0,0:49:43.18,0:49:44.35,Default,,0,0,0,,Мэй-чан! ?
Dialogue: 0,0:49:46.10,0:49:47.35,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:49:48.48,0:49:49.56,Default,,0,0,0,,Неге...
Dialogue: 0,0:49:51.69,0:49:53.36,Default,,0,0,0,,Неге келмедің?
Dialogue: 0,0:49:57.16,0:49:58.87,Default,,0,0,0,,Мешин-чан, бұл қауіпті!
Dialogue: 0,0:49:59.45,0:50:01.37,Default,,0,0,0,,Сен жай ғана Мэйді жек көресің бе?
Dialogue: 0,0:50:01.70,0:50:03.83,Default,,0,0,0,,Мэй жай ғана жаман қыз ба?
Dialogue: 0,0:50:06.79,0:50:07.96,Default,,0,0,0,,Ах
Dialogue: 0,0:50:08.21,0:50:10.88,Default,,0,0,0,,Дұрыс, Мей Чан жай ғана жаман қыз!\NТек
Dialogue: 0,0:50:11.34,0:50:12.63,Default,,0,0,0,,құтылды!
Dialogue: 0,0:50:13.26,0:50:14.13,Default,,0,0,0,,Мамыр...!
Dialogue: 0,0:50:14.72,0:50:17.63,Default,,0,0,0,,Менің қолымнан келмейді деп ойладым
Dialogue: 0,0:50:18.30,0:50:19.14,Default,,0,0,0,,Мейко…
Dialogue: 0,0:50:19.51,0:50:21.89,Default,,0,0,0,,Бірақ мен Мэй-чанды көруге келдім!
Dialogue: 0,0:50:22.72,0:50:24.14,Default,,0,0,0,,Мен жай ғана Мэй Чанды жақсы көремін!
Dialogue: 0,0:50:24.73,0:50:26.64,Default,,0,0,0,,Маған ұнадың, өйткені сен жақсы қызсың!
Dialogue: 0,0:50:27.39,0:50:29.73,Default,,0,0,0,,Кез келген Мэй Чан - жай ғана Мэй Чан!
Dialogue: 0,0:50:34.69,0:50:37.07,Default,,0,0,0,,Мен де бәріне үндемедім...
Dialogue: 0,0:50:37.49,0:50:39.61,Default,,0,0,0,,Мен Мэйді жалғыз қалдырдым.
Dialogue: 0,0:50:40.07,0:50:41.37,Default,,0,0,0,,Сен жаман баласың...
Dialogue: 0,0:50:42.08,0:50:43.08,Default,,0,0,0,,мамыр…
Dialogue: 0,0:50:43.41,0:50:44.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:44.91,0:50:48.67,Default,,0,0,0,,Кешіріңіз, Мэй Чан үйге бірге барайық.
Dialogue: 0,0:50:50.63,0:50:51.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:50:51.92,0:50:54.25,Default,,0,0,0,,Дагаааааан! (Аспан) Әй, Мешин-чан!
Dialogue: 0,0:50:55.38,0:50:57.67,Default,,0,0,0,,Ах! (Аспан) Ичидодзи-кун...
Dialogue: 0,0:50:58.01,0:50:58.84,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:50:58.97,0:50:59.72,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:51:03.97,0:51:05.43,Default,,0,0,0,,мамыр! (Мешин) Жарайды.
Dialogue: 0,0:51:05.97,0:51:07.52,Default,,0,0,0,,Абсолютті бөлу
Dialogue: 0,0:51:11.27,0:51:12.19,Default,,0,0,0,,Ах
Dialogue: 0,0:51:22.45,0:51:24.37,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:51:27.83,0:51:29.96,Default,,0,0,0,,Мэй-чан! (Аспан) Осы жерде қал!
Dialogue: 0,0:51:30.29,0:51:31.96,Default,,0,0,0,,Аспан мырза! Ах
Dialogue: 0,0:51:44.47,0:51:45.43,Default,,0,0,0,,О, Патшайым, шешім қабылдау уақыты келді
Dialogue: 0,0:51:48.39,0:51:49.64,Default,,0,0,0,,Күте тұрыңыз...
Dialogue: 0,0:51:50.48,0:51:53.27,Default,,0,0,0,,Мен қазір барамын...
Dialogue: 0,0:51:57.11,0:51:58.24,Default,,0,0,0,,Ах
Dialogue: 0,0:52:03.37,0:52:04.95,Default,,0,0,0,,Ух (бос) Ух...
Dialogue: 0,0:52:05.24,0:52:07.99,Default,,0,0,0,,Иә? (Аспан) Мейкомонды босат!
Dialogue: 0,0:52:10.75,0:52:11.67,Default,,0,0,0,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:52:12.33,0:52:13.33,Default,,0,0,0,,Уф
Dialogue: 0,0:52:15.21,0:52:16.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:52:17.30,0:52:18.26,Default,,0,0,0,,Уф!
Dialogue: 0,0:52:21.97,0:52:25.51,Default,,0,0,0,,О, Ичидодзи-кун, тоқтат...
Dialogue: 0,0:52:25.80,0:52:28.72,Default,,0,0,0,,Бұл сурет жай ғана аватар.
Dialogue: 0,0:52:29.10,0:52:32.19,Default,,0,0,0,,Сіздің әлеміңізде көріну.
Dialogue: 0,0:52:34.94,0:52:36.86,Default,,0,0,0,,Геннай мырза! ? Ах
Dialogue: 0,0:52:37.90,0:52:41.82,Default,,0,0,0,,Дегенмен, бұл міндетті түрде сіз білетін «Геннай» емес.
Dialogue: 0,0:52:42.15,0:52:44.03,Default,,0,0,0,,Аха…
Dialogue: 0,0:52:44.70,0:52:46.78,Default,,0,0,0,,Сіз таң қалдыңыз ба? Сіз таң қалдыңыз ба?
Dialogue: 0,0:52:46.91,0:52:48.79,Default,,0,0,0,,♪Химекава айтқандай.
Dialogue: 0,0:52:49.24,0:52:50.45,Default,,0,0,0,,Химекава мырза?
Dialogue: 0,0:52:50.70,0:52:52.54,Default,,0,0,0,,Неліктен Химекава-сан? (Жұмбақ адам) Ах!
Dialogue: 0,0:52:53.00,0:52:54.04,Default,,0,0,0,,Оны таптым
Dialogue: 0,0:52:54.33,0:52:55.54,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,0:52:55.67,0:52:58.71,Default,,0,0,0,,Онсыз сіз жай ғана «бала»сыз
Dialogue: 0,0:52:58.84,0:53:00.05,Default,,0,0,0,,Мүмкін тыныс алу әдістерін тым көп қолданғандықтан шығар…
Dialogue: 0,0:53:03.97,0:53:04.80,Default,,0,0,0,,Биомон! ?
Dialogue: 0,0:53:05.09,0:53:07.22,Default,,0,0,0,,Мен оны мүлдем көре алмаймын.
Dialogue: 0,0:53:08.64,0:53:10.31,Default,,0,0,0,,Кя ах
Dialogue: 0,0:53:11.52,0:53:14.44,Default,,0,0,0,,Биомон! (Жұмбақ адам) Ғұн, адасқан Дигимон...
Dialogue: 0,0:53:14.56,0:53:17.73,Default,,0,0,0,,Жоқ! Биомон менің серіктесім
Dialogue: 0,0:53:22.40,0:53:23.32,Default,,0,0,0,,Уф
Dialogue: 0,0:53:24.15,0:53:25.07,Default,,0,0,0,,Уф...
Dialogue: 0,0:53:25.45,0:53:28.74,Default,,0,0,0,,Аааааааааааааааааа?
Dialogue: 0,0:53:28.87,0:53:30.24,Default,,0,0,0,,Мен сенімен бірден ойнаймын.
Dialogue: 0,0:53:36.75,0:53:38.08,Default,,0,0,0,,Қаш! (бос) А
Dialogue: 0,0:53:45.18,0:53:46.59,Default,,0,0,0,,Уф... (Мешін) Сора-сан!
Dialogue: 0,0:53:50.06,0:53:51.89,Default,,0,0,0,,Аспан... (аспан) Ха
Dialogue: 0,0:53:54.60,0:53:56.77,Default,,0,0,0,,Тайчи Ямато...
Dialogue: 0,0:53:56.90,0:53:58.19,Default,,0,0,0,,Абайсызда болмаңыз
Dialogue: 0,0:53:58.31,0:54:00.15,Default,,0,0,0,,Амансың ба? аспан
Dialogue: 0,0:54:00.27,0:54:01.36,Default,,0,0,0,,Көп емес...
Dialogue: 0,0:54:02.36,0:54:04.61,Default,,0,0,0,,Габумон жақсы!
Dialogue: 0,0:54:04.74,0:54:06.36,Default,,0,0,0,,Тайчи! (Тайчи) Агумон!
Dialogue: 0,0:54:06.74,0:54:07.11,Default,,0,0,0,,Қайда бара жатырсың... О, жоқ!
Dialogue: 0,0:54:07.11,0:54:08.11,Default,,0,0,0,,Қайда бара жатырсың... О, жоқ!
Dialogue: 0,0:54:07.11,0:54:08.11,Default,,0,0,0,,(Амон) Аогири ағашы туралы не білесің?
Dialogue: 0,0:54:08.11,0:54:09.16,Default,,0,0,0,,Қайда барасың... Идада, Итатата!
Dialogue: 0,0:54:09.28,0:54:12.37,Default,,0,0,0,,Уау! Кездескенімізге қуаныштымын
Dialogue: 0,0:54:12.87,0:54:14.87,Default,,0,0,0,,Бұрмалаулардың байланысы арқасында.
Dialogue: 0,0:54:15.96,0:54:17.83,Default,,0,0,0,,Ах! (Мешин) А...
Dialogue: 0,0:54:18.38,0:54:20.25,Default,,0,0,0,,Әй, Меймей!
Dialogue: 0,0:54:20.38,0:54:20.96,Default,,0,0,0,,Неге, неге! ? үлкен аға!
Dialogue: 0,0:54:20.96,0:54:22.63,Default,,0,0,0,,Неге, неге! ? үлкен аға!
Dialogue: 0,0:54:20.96,0:54:22.63,Default,,0,0,0,,(Мугендрамонның операциялық дыбысы)
Dialogue: 0,0:54:25.51,0:54:26.34,Default,,0,0,0,,Уф
Dialogue: 0,0:54:27.59,0:54:30.47,Default,,0,0,0,,Сіз кімсіз! Неліктен Мейкомон?
Dialogue: 0,0:54:32.10,0:54:33.85,Default,,0,0,0,,Бұл Йггдрасилдің еркі.
Dialogue: 0,0:54:33.97,0:54:35.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:54:35.81,0:54:38.40,Default,,0,0,0,,Менімен ойна...Мен саған беремін.
Dialogue: 0,0:54:38.60,0:54:40.15,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:54:40.36,0:54:42.65,Default,,0,0,0,,Бұл Геннай-сан емес пе? ?
Dialogue: 0,0:54:42.77,0:54:44.65,Default,,0,0,0,,Геннай-сан мұндай әрекетке бармас еді!
Dialogue: 0,0:54:45.19,0:54:48.57,Default,,0,0,0,,Сіздің жақсы немесе жақсы емес екеніңіз соншалықты маңызды ма?
Dialogue: 0,0:54:48.70,0:54:50.41,Default,,0,0,0,,Мен Дигимонның жағындамын!
Dialogue: 0,0:54:50.78,0:54:51.74,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:54:51.87,0:54:54.66,Default,,0,0,0,,Адамдар мен Дигимон өзара әрекеттеспеуі керек, солай ма?
Dialogue: 0,0:54:55.50,0:54:58.04,Default,,0,0,0,,Бірақ гомеостаз сізді таңдайды...
Dialogue: 0,0:54:58.16,0:54:59.67,Default,,0,0,0,,Дигимон қызметшілер ретінде қолданылады.
Dialogue: 0,0:54:59.96,0:55:02.42,Default,,0,0,0,,Екі дүние тым жақын!
Dialogue: 0,0:55:02.54,0:55:03.63,Default,,0,0,0,,Мен ешқандай тапсырма орындамаймын!
Dialogue: 0,0:55:04.00,0:55:04.88,Default,,0,0,0,,«Шиеки» дегеніміз не?
Dialogue: 0,0:55:05.01,0:55:07.22,Default,,0,0,0,,Сіз оны осылай алып жүресіз!
Dialogue: 0,0:55:07.34,0:55:09.63,Default,,0,0,0,,Қайта жүктеуді есте сақтаңыз!
Dialogue: 0,0:55:09.76,0:55:11.18,Default,,0,0,0,,Сіз ұмыттыңыз ба?
Dialogue: 0,0:55:11.85,0:55:14.68,Default,,0,0,0,,Гомеостаздың өзі сізді таңдады...
Dialogue: 0,0:55:15.22,0:55:18.06,Default,,0,0,0,,Сіз өзіңіз... қайта іске қостыңыз.
Dialogue: 0,0:55:18.31,0:55:21.02,Default,,0,0,0,,Ахахха... (Коширо) Мен қайта жүктеу болады деп ойламаппын...
Dialogue: 0,0:55:21.44,0:55:23.19,Default,,0,0,0,,Йггдрасилдің өсиеті
Dialogue: 0,0:55:23.31,0:55:24.07,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:55:24.69,0:55:25.57,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:55:28.53,0:55:29.82,Default,,0,0,0,,Күшіктің ұлыуы
Dialogue: 0,0:55:41.29,0:55:42.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:55:48.01,0:55:49.84,Default,,0,0,0,,Мұны жылжыта алмайсыз ба?
Dialogue: 0,0:55:50.09,0:55:51.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:55:51.84,0:55:54.10,Default,,0,0,0,,Қуат және май қысымы толығымен төмендеді.
Dialogue: 0,0:55:54.60,0:55:56.56,Default,,0,0,0,,Егер қозғалтқыш іске қосылса...
Dialogue: 0,0:55:56.68,0:55:58.52,Default,,0,0,0,,Ол үшін машина бөлмесіне баруым керек.
Dialogue: 0,0:55:58.64,0:55:59.85,Default,,0,0,0,,Келесі күні бұл өте үлкен.
Dialogue: 0,0:55:59.98,0:56:01.14,Default,,0,0,0,,Ол қозғалады ма?
Dialogue: 0,0:56:01.27,0:56:03.86,Default,,0,0,0,,Плотмон Неге секірдің?
Dialogue: 0,0:56:04.48,0:56:06.40,Default,,0,0,0,,Өйткені Хикари өте мейірімді.
Dialogue: 0,0:56:06.52,0:56:08.15,Default,,0,0,0,,Мен саған көмектескім келді.
Dialogue: 0,0:56:08.28,0:56:09.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:09.90,0:56:12.36,Default,,0,0,0,,Мэй... (Мешин) Мей-чан, тамаша!
Dialogue: 0,0:56:12.66,0:56:15.37,Default,,0,0,0,,Мен Мэймен бірге болсам, жақсы емес.
Dialogue: 0,0:56:15.49,0:56:17.62,Default,,0,0,0,,Мэй құлап жатыр
Dialogue: 0,0:56:17.74,0:56:19.12,Default,,0,0,0,,Жаңа ғана тозған.
Dialogue: 0,0:56:19.58,0:56:21.62,Default,,0,0,0,,Жарайды (Мейкомон) Мей...
Dialogue: 0,0:56:23.42,0:56:26.17,Default,,0,0,0,,Барлығына! кешіріңіз
Dialogue: 0,0:56:26.92,0:56:28.13,Default,,0,0,0,,Біз үшін
Dialogue: 0,0:56:29.67,0:56:31.13,Default,,0,0,0,,Сіз не үшін кешірім сұрайсыз?
Dialogue: 0,0:56:31.67,0:56:34.47,Default,,0,0,0,,Ig-де не болғанын білесіз бе?
Dialogue: 0,0:56:34.59,0:56:35.43,Default,,0,0,0,,Иә
Dialogue: 0,0:56:35.93,0:56:37.51,Default,,0,0,0,,Yggdrasil…
Dialogue: 0,0:56:37.97,0:56:39.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:56:41.27,0:56:42.44,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:56:42.56,0:56:44.40,Default,,0,0,0,,Қарғыс атқыр, сіз бүкіл кемені жасағыңыз келеді! ?
Dialogue: 0,0:56:44.81,0:56:45.81,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:56:45.94,0:56:47.65,Default,,0,0,0,,Біз жеңілеміз! ?
Dialogue: 0,0:56:47.77,0:56:49.15,Default,,0,0,0,,Мен саған бұлай істеуге жол бермеймін!
Dialogue: 0,0:56:49.61,0:56:50.49,Default,,0,0,0,,Такеру…
Dialogue: 0,0:56:50.61,0:56:53.20,Default,,0,0,0,,Дұрыс, солар жеңіледі.
Dialogue: 0,0:56:53.32,0:56:54.66,Default,,0,0,0,,О, дұрыс!
Dialogue: 0,0:56:54.78,0:56:56.91,Default,,0,0,0,,Бірақ сендер мұны істей алмайсыңдар.
Dialogue: 0,0:56:57.33,0:56:59.70,Default,,0,0,0,,«Отқа ұшатын жазғы жәндіктер».
Dialogue: 0,0:56:59.83,0:57:02.29,Default,,0,0,0,,Бірақ мұны істеуден басқа амалымыз жоқ.
Dialogue: 0,0:57:02.41,0:57:04.62,Default,,0,0,0,,Сен маған көмектесе аласың ба, Тэнтомон?
Dialogue: 0,0:57:04.75,0:57:05.92,Default,,0,0,0,,Коушироу…
Dialogue: 0,0:57:06.25,0:57:07.17,Default,,0,0,0,,That's right.
Dialogue: 0,0:57:07.29,0:57:08.67,Default,,0,0,0,,Мен сізден бір нәрсе сұрағым келеді!
Dialogue: 0,0:57:09.88,0:57:12.30,Default,,0,0,0,,«Тамақ қайда?»
Dialogue: 0,0:57:12.42,0:57:13.26,Default,,0,0,0,,Бұл сенсің! Апыр-ай!
Dialogue: 0,0:57:13.26,0:57:14.47,Default,,0,0,0,,Бұл сенсің! Апыр-ай! (соққы дыбысы)
Dialogue: 0,0:57:14.68,0:57:16.18,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:57:19.10,0:57:20.97,Default,,0,0,0,,Бұл жерде көп ұзамайды.
Dialogue: 0,0:57:21.10,0:57:24.14,Default,,0,0,0,,Сора-сан мен Мочизуки-сан қауіпсіз жерге барады! (бос) Бірақ!
Dialogue: 0,0:57:24.81,0:57:25.94,Default,,0,0,0,,Біз жемге айналамыз
Dialogue: 0,0:57:26.31,0:57:27.69,Default,,0,0,0,,Агумонға барайық
Dialogue: 0,0:57:27.81,0:57:28.94,Default,,0,0,0,,Күте тұрыңыз, Тайчи!
Dialogue: 0,0:57:29.27,0:57:30.44,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:57:35.70,0:57:38.28,Default,,0,0,0,,Алаяқ па, әлде бала ма?
Dialogue: 0,0:57:38.41,0:57:39.20,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:57:39.87,0:57:41.70,Default,,0,0,0,,Кел менімен ойна
Dialogue: 0,0:57:44.37,0:57:45.46,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:57:51.59,0:57:52.51,Default,,0,0,0,,Хун
Dialogue: 0,0:57:53.05,0:57:55.93,Default,,0,0,0,,(Тайчи мен оның достарының айқайы)
Dialogue: 0,0:57:56.05,0:57:58.89,Default,,0,0,0,,Уф уау
Dialogue: 0,0:58:00.01,0:58:02.27,Default,,0,0,0,,Коуширо-хан, сен не істеп жатырсың?
Dialogue: 0,0:58:02.39,0:58:03.43,Default,,0,0,0,,Мен оны жеңемін!
Dialogue: 0,0:58:07.94,0:58:09.40,Default,,0,0,0,,Иә! (ұзындығы) Иә!
Dialogue: 0,0:58:11.52,0:58:12.69,Default,,0,0,0,,Кя (Джоу) Түсіңіз!
Dialogue: 0,0:58:13.69,0:58:16.49,Default,,0,0,0,,Кенеттен атыңыз! ? (Ұзындығы) Ei
Dialogue: 0,0:58:17.03,0:58:19.24,Default,,0,0,0,,Дұрыс қашпасаң өлесің.
Dialogue: 0,0:58:20.83,0:58:22.16,Default,,0,0,0,,…бұл Цезарь әлі білмейтін нәрсе.
Dialogue: 0,0:58:22.54,0:58:24.95,Default,,0,0,0,,Уф... (Аспан) Биомон
Dialogue: 0,0:58:25.08,0:58:26.75,Default,,0,0,0,,Мен саған қашып кет дедім.
Dialogue: 0,0:58:27.12,0:58:30.04,Default,,0,0,0,,Тіпті Биомон да маған көмектесті.
Dialogue: 0,0:58:30.63,0:58:32.25,Default,,0,0,0,,Өйткені бұл қауіпті.
Dialogue: 0,0:58:32.63,0:58:34.05,Default,,0,0,0,,Мен жай адам болсам да...
Dialogue: 0,0:58:34.17,0:58:36.55,Default,,0,0,0,,Сіз осындай күлкілі қарсыласқа тап боласыз ба?
Dialogue: 0,0:58:36.67,0:58:37.80,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:58:38.72,0:58:39.76,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:58:40.80,0:58:42.89,Default,,0,0,0,,Міне, біз мұны «жақсы мінезді» деп атаймыз.
Dialogue: 0,0:58:43.01,0:58:44.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:45.89,0:58:47.02,Default,,0,0,0,,Менің ойымша, бұл жақсы
Dialogue: 0,0:58:47.48,0:58:49.60,Default,,0,0,0,,Не? Аспан мейірімді, солай емес пе?
Dialogue: 0,0:58:49.73,0:58:50.56,Default,,0,0,0,,Ах
Dialogue: 0,0:58:53.48,0:58:56.69,Default,,0,0,0,,«Аспан» ақыры мені шақырды
Dialogue: 0,0:58:57.65,0:58:58.70,Default,,0,0,0,,Өйткені ол бос, солай ма?
Dialogue: 0,0:58:59.95,0:59:01.28,Default,,0,0,0,,Эй, аспан (аспан) иә?
Dialogue: 0,0:59:01.74,0:59:04.04,Default,,0,0,0,,Бос тефтели Мен көбірек жегім келеді
Dialogue: 0,0:59:05.04,0:59:05.91,Default,,0,0,0,,Иә!
Dialogue: 0,0:59:05.91,0:59:06.37,Default,,0,0,0,,Иә!
Dialogue: 0,0:59:05.91,0:59:06.37,Default,,0,0,0,,(Мугендрамонның зеңбірек дыбысы)
Dialogue: 0,0:59:06.37,0:59:06.50,Default,,0,0,0,,(Мугендрамонның зеңбірек дыбысы)
Dialogue: 0,0:59:06.50,0:59:07.16,Default,,0,0,0,,(Мугендрамонның зеңбірек дыбысы)
Dialogue: 0,0:59:06.50,0:59:07.16,Default,,0,0,0,,Ах! (Аспан) Барлығы...
Dialogue: 0,0:59:07.16,0:59:07.96,Default,,0,0,0,,Ах! (Аспан) Барлығы...
Dialogue: 0,0:59:08.08,0:59:09.12,Default,,0,0,0,,Сора мырза
Dialogue: 0,0:59:09.79,0:59:12.38,Default,,0,0,0,,Бос болған кезде!
Dialogue: 0,0:59:12.50,0:59:13.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:15.42,0:59:18.22,Default,,0,0,0,,Мен өлімнен қорқудың қажеті жоқ деп ойлаймын...
Dialogue: 0,0:59:18.34,0:59:20.30,Default,,0,0,0,,Адамдарды аяймын.
Dialogue: 0,0:59:20.68,0:59:22.05,Default,,0,0,0,,Бұл толық емес!
Dialogue: 0,0:59:22.60,0:59:24.85,Default,,0,0,0,,Дигимон мәңгілік
Dialogue: 0,0:59:24.97,0:59:27.56,Default,,0,0,0,,Сынса да, ол қайтадан сандық допқа айналып, қайта ойнайды.
Dialogue: 0,0:59:28.43,0:59:31.73,Default,,0,0,0,,Бірақ кейде сол шеңберден шығып кететіндер де болады...
Dialogue: 0,0:59:32.65,0:59:35.53,Default,,0,0,0,,Адам әлемінде өлсең, қайта тіріле алмайсың.
Dialogue: 0,0:59:35.65,0:59:38.11,Default,,0,0,0,,Әй, бейшара!
Dialogue: 0,0:59:39.74,0:59:41.82,Default,,0,0,0,,Сондықтан қайта жүктеңіз!
Dialogue: 0,0:59:42.87,0:59:47.58,Default,,0,0,0,,Анау сол жерде өлген жігіт, анау жігіт, бәрі қалыпты жағдайға оралды.
Dialogue: 0,0:59:47.95,0:59:51.54,Default,,0,0,0,,Қазір бәрінің қол ұстасып, адам әлемін билейтін уақыты!
Dialogue: 0,0:59:51.67,0:59:53.50,Default,,0,0,0,,Сәлем Мейкомон!
Dialogue: 0,0:59:53.63,0:59:54.59,Default,,0,0,0,,Иә? Мейкомон?
Dialogue: 0,0:59:55.21,0:59:56.09,Default,,0,0,0,,Иә
Dialogue: 0,0:59:56.42,0:59:58.67,Default,,0,0,0,,Сол бала дүниені жоюдың кілті.
Dialogue: 0,0:59:58.80,0:59:59.72,Default,,0,0,0,,Такеру! Ах
Dialogue: 0,1:00:00.17,1:00:01.34,Default,,0,0,0,,Ауа ату!
Dialogue: 0,1:00:02.51,1:00:03.34,Default,,0,0,0,,Гухаа
Dialogue: 0,1:00:03.64,1:00:04.68,Default,,0,0,0,,Патамон!
Dialogue: 0,1:00:04.80,1:00:06.14,Default,,0,0,0,,Амансың ба? Такеру!
Dialogue: 0,1:00:06.47,1:00:07.64,Default,,0,0,0,,Ууууууу!
Dialogue: 0,1:00:08.52,1:00:09.81,Default,,0,0,0,,Уф (жұмбақ адам) Уф
Dialogue: 0,1:00:09.93,1:00:11.56,Default,,0,0,0,,Уф (жұмбақ адам)... Жолдан кет!
Dialogue: 0,1:00:11.69,1:00:13.02,Default,,0,0,0,,Уау! биіктік!
Dialogue: 0,1:00:13.15,1:00:15.90,Default,,0,0,0,,Жүріп келе жатқан балықтар! (Жұмбақ адам) Уа, бұл...
Dialogue: 0,1:00:16.02,1:00:17.61,Default,,0,0,0,,Iteite iteitatata…
Dialogue: 0,1:00:19.74,1:00:21.86,Default,,0,0,0,,Улы шырмауық
Dialogue: 0,1:00:22.16,1:00:24.16,Default,,0,0,0,,Жақсы пальмон жақсы
Dialogue: 0,1:00:24.28,1:00:25.12,Default,,0,0,0,,Эххе!
Dialogue: 0,1:00:25.62,1:00:27.87,Default,,0,0,0,,Гомамон, сен мені құтқардың!
Dialogue: 0,1:00:28.16,1:00:30.66,Default,,0,0,0,,Мен ұзындықты жалғыз қалдыра алмаймын.
Dialogue: 0,1:00:30.79,1:00:31.62,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:32.25,1:00:33.12,Default,,0,0,0,,Барлығына!
Dialogue: 0,1:00:33.71,1:00:36.63,Default,,0,0,0,,А... Олай болса.
Dialogue: 0,1:00:37.25,1:00:38.09,Default,,0,0,0,,О?
Dialogue: 0,1:00:38.21,1:00:39.92,Default,,0,0,0,,Оу!
Dialogue: 0,1:00:41.55,1:00:42.38,Default,,0,0,0,,Қазір!
Dialogue: 0,1:00:43.43,1:00:45.64,Default,,0,0,0,,Міне
Dialogue: 0,1:00:59.73,1:01:01.24,Default,,0,0,0,,Сіз мұны істей аласыз ба? Габумон!
Dialogue: 0,1:01:01.36,1:01:02.53,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:04.20,1:01:05.66,Default,,0,0,0,,Petit Fire
Dialogue: 0,1:01:06.49,1:01:08.08,Default,,0,0,0,,(Металл Сидрамонның айқайы)
Dialogue: 0,1:01:13.71,1:01:16.25,Default,,0,0,0,,Жақсы! Керемет...
Dialogue: 0,1:01:16.38,1:01:17.92,Default,,0,0,0,,Сондай үлкен жігіт
Dialogue: 0,1:01:18.04,1:01:20.51,Default,,0,0,0,,Сен істедің, Габумон.
Dialogue: 0,1:01:20.63,1:01:21.84,Default,,0,0,0,,Ямато!
Dialogue: 0,1:01:21.96,1:01:23.17,Default,,0,0,0,,А... сен
Dialogue: 0,1:01:23.63,1:01:25.59,Default,,0,0,0,,Сіз? (Тайчи) Габумоннан келген.
Dialogue: 0,1:01:25.72,1:01:28.93,Default,,0,0,0,,Яматого атыңды қойған дұрыс па деп ойладым.
Dialogue: 0,1:01:29.26,1:01:31.43,Default,,0,0,0,,Тайчи! (Тайчи) Мені де қосыңыз!
Dialogue: 0,1:01:31.85,1:01:33.27,Default,,0,0,0,,Уау!
Dialogue: 0,1:01:33.39,1:01:35.48,Default,,0,0,0,,Уау!
Dialogue: 0,1:01:37.40,1:01:39.40,Default,,0,0,0,,Сағат тілі бағыты бойынша айналу.
Dialogue: 0,1:01:39.52,1:01:43.15,Default,,0,0,0,,Тайчи! Ямато!
Dialogue: 0,1:01:43.28,1:01:48.12,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,1:01:48.24,1:01:50.28,Default,,0,0,0,,Хааа
Dialogue: 0,1:01:51.99,1:01:53.25,Default,,0,0,0,,Бакумон?
Dialogue: 0,1:01:56.17,1:01:57.54,Default,,0,0,0,,О
Dialogue: 0,1:01:58.25,1:01:59.71,Default,,0,0,0,,Шабуыл шаңы!
Dialogue: 0,1:02:00.09,1:02:03.67,Default,,0,0,0,,Мен сенімен әрқашан кездескім келді
Dialogue: 0,1:02:05.09,1:02:06.47,Default,,0,0,0,,Бұл кім? (Химекава) Ха
Dialogue: 0,1:02:07.26,1:02:08.43,Default,,0,0,0,,Адам?
Dialogue: 0,1:02:09.26,1:02:11.51,Default,,0,0,0,,Бұл менмін, менің серіктесім.
Dialogue: 0,1:02:11.64,1:02:12.93,Default,,0,0,0,,Өтірік мен білмеймін
Dialogue: 0,1:02:13.35,1:02:14.23,Default,,0,0,0,,Не!
Dialogue: 0,1:02:21.86,1:02:22.73,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:29.12,1:02:31.45,Default,,0,0,0,,Неліктен? Сіздің серіктесіңіз, солай ма?
Dialogue: 0,1:02:32.20,1:02:33.75,Default,,0,0,0,,«Мен сені күттім» деп айт!
Dialogue: 0,1:02:34.29,1:02:35.96,Default,,0,0,0,,Есте сақта!
Dialogue: 0,1:03:00.94,1:03:02.90,Default,,0,0,0,,Гуха (Тайчи) Буха
Dialogue: 0,1:03:05.82,1:03:07.11,Default,,0,0,0,,Тайчи!
Dialogue: 0,1:03:08.36,1:03:10.07,Default,,0,0,0,,Тайчи…
Dialogue: 0,1:03:10.20,1:03:11.41,Default,,0,0,0,,Агумон?
Dialogue: 0,1:03:11.87,1:03:13.24,Default,,0,0,0,,Неліктен біз туралы?
Dialogue: 0,1:03:13.37,1:03:15.41,Default,,0,0,0,,Маған көмектестіңіз бе?
Dialogue: 0,1:03:15.54,1:03:16.91,Default,,0,0,0,,Өйткені сіз-
Dialogue: 0,1:03:17.04,1:03:19.37,Default,,0,0,0,,Өліп қала жаздадың, солай ма?
Dialogue: 0,1:03:19.50,1:03:20.79,Default,,0,0,0,,Бұл Ямато және басқалары...
Dialogue: 0,1:03:20.92,1:03:22.63,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,1:03:23.04,1:03:26.80,Default,,0,0,0,,Мен сені қайтадан жоғалтқым келмеді
Dialogue: 0,1:03:28.59,1:03:32.22,Default,,0,0,0,,Сізбен кездесу үшін, басқа ешкім...
Dialogue: 0,1:03:34.35,1:03:36.14,Default,,0,0,0,,Мен бұл дүниеге келдім
Dialogue: 0,1:03:38.31,1:03:39.35,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:41.19,1:03:42.94,Default,,0,0,0,,Менде жалғыз сенсің
Dialogue: 0,1:03:44.32,1:03:45.19,Default,,0,0,0,,Агумон! Габумон!
Dialogue: 0,1:03:46.11,1:03:48.95,Default,,0,0,0,,Тайчи Мен күшті болғым келеді!
Dialogue: 0,1:03:49.78,1:03:52.37,Default,,0,0,0,,Мен де Ямато!
Dialogue: 0,1:03:53.45,1:03:54.70,Default,,0,0,0,,Габумон!
Dialogue: 0,1:03:55.33,1:03:57.70,Default,,0,0,0,,Agumon!
Dialogue: 0,1:03:59.50,1:04:01.87,Default,,0,0,0,,Біз саған көруге келдік…
Dialogue: 0,1:04:10.05,1:04:11.84,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:04:15.39,1:04:16.22,Default,,0,0,0,,Уф!
Dialogue: 0,1:04:24.23,1:04:25.23,Default,,0,0,0,,You made me wait!
Dialogue: 0,1:04:25.73,1:04:26.73,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,1:04:28.61,1:04:29.44,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,1:05:15.36,1:05:16.78,Default,,0,0,0,,Kya hikari!
Dialogue: 0,1:05:29.46,1:05:32.47,Default,,0,0,0,,Плотмон эволюциясы!
Dialogue: 0,1:05:52.23,1:05:53.65,Default,,0,0,0,,Тайлмон
Dialogue: 0,1:05:56.28,1:05:57.91,Default,,0,0,0,,Cat Punch
Dialogue: 0,1:06:03.29,1:06:04.83,Default,,0,0,0,,Амансың ба? Hikari
Dialogue: 0,1:06:04.96,1:06:05.83,Default,,0,0,0,,Тайлмон! ?
Dialogue: 0,1:06:09.21,1:06:10.71,Default,,0,0,0,,Соғыс Греймон
Dialogue: 0,1:06:10.84,1:06:12.30,Default,,0,0,0,,Metal Garurumon
Dialogue: 0,1:06:16.05,1:06:17.09,Default,,0,0,0,,Уау!
Dialogue: 0,1:06:17.51,1:06:18.84,Default,,0,0,0,,Minahaan!
Dialogue: 0,1:06:19.22,1:06:21.60,Default,,0,0,0,,Тентомон кішірейіп кетті!
Dialogue: 0,1:06:22.06,1:06:24.10,Default,,0,0,0,,Бұрын көргендеріңіз голограмма.
Dialogue: 0,1:06:24.23,1:06:27.35,Default,,0,0,0,,Коуширо-хан, оның қолынан бәрі келеді, ол керемет.
Dialogue: 0,1:06:27.73,1:06:30.52,Default,,0,0,0,,Коуширо-кун күткендей! (Koshiro) No...
Dialogue: 0,1:06:30.65,1:06:31.86,Default,,0,0,0,,Ол туралы не деуге болады?
Dialogue: 0,1:06:36.61,1:06:39.07,Default,,0,0,0,,Такеру! I did my best!
Dialogue: 0,1:06:39.20,1:06:40.24,Default,,0,0,0,,Иә
Dialogue: 0,1:06:40.37,1:06:43.29,Default,,0,0,0,,Өйткені менің жалғыз серігім Гомамон.
Dialogue: 0,1:06:43.41,1:06:44.62,Default,,0,0,0,,Эххе
Dialogue: 0,1:06:47.71,1:06:50.00,Default,,0,0,0,,Әй, серік деген не?
Dialogue: 0,1:06:50.13,1:06:51.04,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:51.17,1:06:52.13,Default,,0,0,0,,Sky said
Dialogue: 0,1:06:52.55,1:06:54.88,Default,,0,0,0,,«Биомон менің серіктесім»
Dialogue: 0,1:06:55.55,1:06:56.01,Default,,0,0,0,,That's...
Dialogue: 0,1:06:56.01,1:06:57.05,Default,,0,0,0,,That's...
Dialogue: 0,1:06:56.01,1:06:57.05,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:06:57.05,1:06:57.38,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:07:02.81,1:07:04.02,Default,,0,0,0,,Денені тексеру? Неге ондай істегіңіз келеді?
Dialogue: 0,1:07:04.77,1:07:05.98,Default,,0,0,0,,Биомон!
Dialogue: 0,1:07:07.39,1:07:08.64,Default,,0,0,0,,Аспан мырза!
Dialogue: 0,1:07:11.73,1:07:13.27,Default,,0,0,0,,(Дигимонның айқайы)
Dialogue: 0,1:07:13.57,1:07:16.03,Default,,0,0,0,,Release Biyomon! Кяаа
Dialogue: 0,1:07:17.53,1:07:18.70,Default,,0,0,0,,Уф...!
Dialogue: 0,1:07:19.11,1:07:20.20,Default,,0,0,0,,Mr. Sky!
Dialogue: 0,1:07:20.66,1:07:22.70,Default,,0,0,0,,Sky Run away! (empty) I don't like it!
Dialogue: 0,1:07:25.20,1:07:26.41,Default,,0,0,0,,Ах
Dialogue: 0,1:07:26.54,1:07:28.12,Default,,0,0,0,,Ух... аспан!
Dialogue: 0,1:07:29.00,1:07:30.58,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:32.42,1:07:34.80,Default,,0,0,0,,Sky Why!
Dialogue: 0,1:07:34.92,1:07:37.80,Default,,0,0,0,,Менің котлеттерім... сіз оларды жейсіз, солай ма?
Dialogue: 0,1:07:38.26,1:07:39.43,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:39.93,1:07:41.97,Default,,0,0,0,,Өйткені мен сенің оны жегеніңді қалаймын!
Dialogue: 0,1:07:42.55,1:07:43.72,Default,,0,0,0,,Ессіз Патшаның зорлық-зомбылығына соңына нүкте қоятын – дәл сіздерсіздер!
Dialogue: 0,1:07:44.26,1:07:46.52,Default,,0,0,0,,Мен сені ешқашан жібермеймін
Dialogue: 0,1:07:46.64,1:07:48.89,Default,,0,0,0,,Ессіз Патшаның зорлық-зомбылығына соңына нүкте қоятын – дәл сіздерсіздер!
Dialogue: 0,1:08:02.53,1:08:06.16,Default,,0,0,0,,Биомон эволюциясы!
Dialogue: 0,1:08:24.26,1:08:25.35,Default,,0,0,0,,Бердрамон!
Dialogue: 0,1:08:37.48,1:08:41.78,Default,,0,0,0,,Birdramon супер эволюциясы!
Dialogue: 0,1:08:53.00,1:08:54.58,Default,,0,0,0,,Гарудамон!
Dialogue: 0,1:08:56.00,1:09:00.42,Default,,0,0,0,,Гарудамонның соңғы эволюциясы!
Dialogue: 0,1:09:14.23,1:09:16.27,Default,,0,0,0,,Хуумон
Dialogue: 0,1:09:21.78,1:09:22.44,Default,,0,0,0,,Міне! ?
Dialogue: 0,1:09:24.86,1:09:26.70,Default,,0,0,0,,А, Биомон?
Dialogue: 0,1:09:36.63,1:09:37.46,Default,,0,0,0,,Бұл...
Dialogue: 0,1:09:39.21,1:09:40.46,Default,,0,0,0,,Сіз көңіл көтересіз бе? (Мешін) А.
Dialogue: 0,1:09:40.84,1:09:41.96,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,1:09:42.26,1:09:43.30,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:46.34,1:09:48.22,Default,,0,0,0,,Мэй... (жұмбақ адам) Фу...
Dialogue: 0,1:09:48.93,1:09:51.31,Default,,0,0,0,,Сіз шынымен мені байқамадым деп ойладыңыз ба?
Dialogue: 0,1:09:51.89,1:09:54.23,Default,,0,0,0,,Балалар сендер шынымен балаларсыңдар.
Dialogue: 0,1:10:00.73,1:10:02.28,Default,,0,0,0,,Дамыды...?
Dialogue: 0,1:10:02.69,1:10:03.74,Default,,0,0,0,,Хуумон…
Dialogue: 0,1:10:04.40,1:10:05.74,Default,,0,0,0,,Соңғы пішін!
Dialogue: 0,1:10:07.45,1:10:10.20,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,1:10:10.33,1:10:12.70,Default,,0,0,0,,Хаха... Уау!
Dialogue: 0,1:10:12.83,1:10:14.25,Default,,0,0,0,,Уф, Сора мырза!
Dialogue: 0,1:10:15.58,1:10:16.71,Default,,0,0,0,,Такеру! О?
Dialogue: 0,1:10:17.25,1:10:18.46,Default,,0,0,0,,Мен де күресемін!
Dialogue: 0,1:10:18.58,1:10:19.75,Default,,0,0,0,,Патамон…
Dialogue: 0,1:10:20.25,1:10:22.76,Default,,0,0,0,,Мен де күресе аламын! Такеру! ?
Dialogue: 0,1:10:24.80,1:10:25.63,Default,,0,0,0,,Такеру-кун!
Dialogue: 0,1:10:26.76,1:10:28.22,Default,,0,0,0,,Иә (ұзындығы) Иә
Dialogue: 0,1:10:30.10,1:10:31.14,Default,,0,0,0,,Иә!
Dialogue: 0,1:10:44.11,1:10:45.99,Default,,0,0,0,,Патамон эволюциясы!
Dialogue: 0,1:11:06.72,1:11:08.13,Default,,0,0,0,,Анжемон
Dialogue: 0,1:11:19.06,1:11:22.23,Default,,0,0,0,,Ангемонның супер эволюциясы!
Dialogue: 0,1:11:33.28,1:11:35.37,Default,,0,0,0,,Қасиетті Ангемон
Dialogue: 0,1:11:37.58,1:11:41.75,Default,,0,0,0,,Қасиетті Анжемонның соңғы эволюциясы!
Dialogue: 0,1:11:55.72,1:11:56.85,Default,,0,0,0,,Серафимон
Dialogue: 0,1:12:00.77,1:12:01.81,Default,,0,0,0,,Соңғы эволюция! ?
Dialogue: 0,1:12:02.69,1:12:03.94,Default,,0,0,0,,Коуширо-хан!
Dialogue: 0,1:12:04.06,1:12:07.36,Default,,0,0,0,,Вате, мен Коушироға көбірек көмектескім келеді!
Dialogue: 0,1:12:07.53,1:12:08.78,Default,,0,0,0,,Тентомон…
Dialogue: 0,1:12:09.40,1:12:11.78,Default,,0,0,0,,Иә, біз де жалғастырайық.
Dialogue: 0,1:12:12.24,1:12:13.28,Default,,0,0,0,,Иә!
Dialogue: 0,1:12:25.88,1:12:28.76,Default,,0,0,0,,Тентомон эволюциясы!
Dialogue: 0,1:12:47.69,1:12:49.49,Default,,0,0,0,,Кабутеримон
Dialogue: 0,1:13:00.83,1:13:04.25,Default,,0,0,0,,Кабутеримон супер эволюциясы!
Dialogue: 0,1:13:14.76,1:13:17.39,Default,,0,0,0,,Атласкабутеримон
Dialogue: 0,1:13:19.35,1:13:23.77,Default,,0,0,0,,Атлас Кабутеримонның соңғы эволюциясы!
Dialogue: 0,1:13:35.57,1:13:38.45,Default,,0,0,0,,Геркуле Кабутеримон
Dialogue: 0,1:13:55.13,1:13:58.22,Default,,0,0,0,,Жұлдыз жарығы
Dialogue: 0,1:14:01.18,1:14:03.56,Default,,0,0,0,,Giga Blaster
Dialogue: 0,1:14:12.82,1:14:14.53,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,1:14:14.65,1:14:16.66,Default,,0,0,0,,Мохимон! Эххе
Dialogue: 0,1:14:17.11,1:14:21.62,Default,,0,0,0,,Коушироу-хан, ауыр емес пе?
Dialogue: 0,1:14:22.41,1:14:23.37,Default,,0,0,0,,Коуширо-хан?
Dialogue: 0,1:14:23.50,1:14:25.46,Default,,0,0,0,,Сонымен, байланыс болды...
Dialogue: 0,1:14:25.87,1:14:27.17,Default,,0,0,0,,Токомон!
Dialogue: 0,1:14:27.29,1:14:30.17,Default,,0,0,0,,Такеру! Эххе
Dialogue: 0,1:14:31.38,1:14:31.96,Default,,0,0,0,,Ах
Dialogue: 0,1:14:44.39,1:14:47.48,Default,,0,0,0,,Рахмет Пиокомон, бұл керемет болды
Dialogue: 0,1:14:47.98,1:14:49.10,Default,,0,0,0,,Шығыс Одақпен ешқандай ойынға жол жоқ!
Dialogue: 0,1:14:49.65,1:14:51.44,Default,,0,0,0,,Аспан да салқын болды
Dialogue: 0,1:14:52.02,1:14:54.40,Default,,0,0,0,,Сонымен, балалар, ақыры осыдан да өттіңдер.
Dialogue: 0,1:14:54.53,1:14:56.40,Default,,0,0,0,,Ұзындығы керемет көрінеді
Dialogue: 0,1:14:56.53,1:14:59.07,Default,,0,0,0,,Пальмон да белсенді рөл атқара алар еді.
Dialogue: 0,1:14:59.20,1:15:00.74,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:15:01.74,1:15:03.66,Default,,0,0,0,,Ух... (Мейкомон) Мейко!
Dialogue: 0,1:15:04.41,1:15:05.50,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:06.00,1:15:08.42,Default,,0,0,0,,Мейкомонды қорқытқыңыз келсе...
Dialogue: 0,1:15:08.54,1:15:09.37,Default,,0,0,0,,Ах
Dialogue: 0,1:15:09.67,1:15:10.33,Default,,0,0,0,,Бұл серіктесті ренжітудің жылдам жолы.
Dialogue: 0,1:15:10.33,1:15:11.50,Default,,0,0,0,,Бұл серіктесіңізді ренжітудің жылдам жолы.
Dialogue: 0,1:15:10.33,1:15:11.50,Default,,0,0,0,,Ах!
Dialogue: 0,1:15:11.50,1:15:14.00,Default,,0,0,0,,Бұл серіктесіңізді ренжітудің жылдам жолы.
Dialogue: 0,1:15:17.34,1:15:18.30,Default,,0,0,0,,Гухаа
Dialogue: 0,1:15:20.01,1:15:20.84,Default,,0,0,0,,Уф
Dialogue: 0,1:15:22.22,1:15:23.10,Default,,0,0,0,,Уф
Dialogue: 0,1:15:24.14,1:15:27.27,Default,,0,0,0,,Енді оны босатыңыз және әлемді жойыңыз!
Dialogue: 0,1:15:27.85,1:15:29.98,Default,,0,0,0,,Сенің кесіріңнен жолдасың өледі.
Dialogue: 0,1:15:30.10,1:15:33.07,Default,,0,0,0,,Уф... (Жұмбақ адам) Қараңдар, қараңдар!
Dialogue: 0,1:15:34.32,1:15:35.57,Default,,0,0,0,,Бұл, сөзсіз, қоңырау шалған жігіт сияқты. Ол «Юхамон» қолданушысы да, жау да емес.
Dialogue: 0,1:15:35.98,1:15:38.20,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,1:15:38.53,1:15:40.03,Default,,0,0,0,,Ах
Dialogue: 0,1:15:40.57,1:15:43.53,Default,,0,0,0,,Сіз ешқашан туылмауыңыз керек еді...
Dialogue: 0,1:15:44.45,1:15:48.71,Default,,0,0,0,,Мен туылмауым керек еді...
Dialogue: 0,1:15:50.46,1:15:51.42,Default,,0,0,0,,Ах
Dialogue: 0,1:15:52.50,1:15:53.79,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,1:15:54.21,1:15:56.00,Default,,0,0,0,,Иә, әйтеуір
Dialogue: 0,1:15:56.13,1:15:58.63,Default,,0,0,0,,Біз Мугендрамонды жеңдік!
Dialogue: 0,1:15:58.76,1:15:59.55,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:01.76,1:16:02.76,Default,,0,0,0,,О, Патшайым, шешім қабылдау уақыты келді
Dialogue: 0,1:16:03.55,1:16:05.47,Default,,0,0,0,,Екеуіңіз де жарақат алдыңыз ба?
Dialogue: 0,1:16:05.93,1:16:08.35,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,1:16:08.73,1:16:11.27,Default,,0,0,0,,Содан кейін Меймейге қайта оралыңыз!
Dialogue: 0,1:16:12.60,1:16:13.98,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:15.19,1:16:18.28,Default,,0,0,0,,Не? (Тайчи) А, бұл...
Dialogue: 0,1:16:18.99,1:16:20.99,Default,,0,0,0,,Бұрын жаман болды...
Dialogue: 0,1:16:22.11,1:16:23.20,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:24.16,1:16:25.28,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:27.62,1:16:28.83,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,1:16:29.25,1:16:30.33,Default,,0,0,0,,«Жетеді»?
Dialogue: 0,1:16:30.46,1:16:32.33,Default,,0,0,0,,Жоқ, бұл жақсы емес.
Dialogue: 0,1:16:32.75,1:16:33.83,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:16:34.29,1:16:35.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:35.96,1:16:37.30,Default,,0,0,0,,Барка
Dialogue: 0,1:16:39.51,1:16:39.72,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:16:39.72,1:16:40.30,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:16:39.72,1:16:40.30,Default,,0,0,0,,Ах
Dialogue: 0,1:16:40.30,1:16:40.42,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:16:40.42,1:16:42.05,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:16:40.42,1:16:42.05,Default,,0,0,0,,Уау!
Dialogue: 0,1:16:42.18,1:16:44.47,Default,,0,0,0,,Не (Тайчи) Не! ?
Dialogue: 0,1:16:45.93,1:16:49.81,Default,,0,0,0,,Дагааан!
Dialogue: 0,1:16:51.56,1:16:55.98,Default,,0,0,0,,(Жұмбақ адамның күлкісі)
Dialogue: 0,1:17:06.53,1:17:12.54,Default,,0,0,0,,♪~
Dialogue: 0,1:17:32.73,1:17:35.65,Default,,0,0,0,,♪Артқа қарама, жүгіре бер
Dialogue: 0,1:17:35.77,1:17:37.48,Default,,0,0,0,,♪Шуақты күн
Dialogue: 0,1:17:39.19,1:17:41.90,Default,,0,0,0,,♪Бүрдірген азапқа көнбеймін
Dialogue: 0,1:17:42.03,1:17:43.99,Default,,0,0,0,,♪Шытырман оқиға
Dialogue: 0,1:17:45.70,1:17:48.58,Default,,0,0,0,,♪Айналайын, қорықпа
Dialogue: 0,1:17:48.70,1:17:50.54,Default,,0,0,0,,♪Менің болашағым
Dialogue: 0,1:17:52.20,1:17:54.96,Default,,0,0,0,,♪Кұрғақ тамаққа ылғал береді
Dialogue: 0,1:17:55.08,1:17:57.21,Default,,0,0,0,,♪Сіздің күлкіңіз
Dialogue: 0,1:17:58.29,1:18:04.80,Default,,0,0,0,,♪Менің әлсіз менім жүрегімнің түбінде өмір сүреді
Dialogue: 0,1:18:04.93,1:18:07.84,Default,,0,0,0,,♪Тағы бір қоштасу
Dialogue: 0,1:18:07.97,1:18:13.98,Default,,0,0,0,,♪Сіз күшті бола білуіңіз керек
Dialogue: 0,1:18:14.69,1:18:21.02,Default,,0,0,0,,♪Қазір батылдықпен ұшып кететін кез
Dialogue: 0,1:18:21.15,1:18:24.28,Default,,0,0,0,,♪Жүрегіңнің қанатын кеңге жай
Dialogue: 0,1:18:24.40,1:18:27.57,Default,,0,0,0,,♪Көрінбейтін болашаққа
Dialogue: 0,1:18:27.70,1:18:34.00,Default,,0,0,0,,♪Бұдан былай шексіз ғаламға қарай
Dialogue: 0,1:18:34.12,1:18:37.25,Default,,0,0,0,,♪Бұл енді ғана басталды
Dialogue: 0,1:18:37.37,1:18:40.54,Default,,0,0,0,,♪Армандағы шытырман оқиға
Dialogue: 0,1:18:40.67,1:18:43.76,Default,,0,0,0,,♪ла ла ла…
Dialogue: 0,1:18:43.88,1:18:46.97,Default,,0,0,0,,♪ла ла ла…
Dialogue: 0,1:18:47.09,1:18:50.22,Default,,0,0,0,,♪ла ла ла…
Dialogue: 0,1:18:50.35,1:18:53.14,Default,,0,0,0,,♪ла ла ла…
Dialogue: 0,1:19:05.15,1:19:08.03,Default,,0,0,0,,♪ Қолыңнан ұста да, ұшып кетелік
Dialogue: 0,1:19:08.16,1:19:09.95,Default,,0,0,0,,♪Көк аспан биіктігі
Dialogue: 0,1:19:11.62,1:19:14.58,Default,,0,0,0,,♪Жарқын даусыңыз бен күлкіңіз көз ілмей тұр
Dialogue: 0,1:19:14.70,1:19:16.83,Default,,0,0,0,,♪Жұмақ
Dialogue: 0,1:19:17.71,1:19:20.83,Default,,0,0,0,,♪Қараңғыда адасып кетсем де
Dialogue: 0,1:19:20.96,1:19:24.30,Default,,0,0,0,,♪Мен берілмеймін, жеңілмеймін
Dialogue: 0,1:19:24.42,1:19:27.30,Default,,0,0,0,,♪Жарық сәулесі
Dialogue: 0,1:19:27.42,1:19:33.31,Default,,0,0,0,,♪Сіз оны таба білуіңіз керек.
Dialogue: 0,1:19:34.14,1:19:37.23,Default,,0,0,0,,♪Көз жасын көрсетуге уақыт жоқ!
Dialogue: 0,1:19:37.35,1:19:43.52,Default,,0,0,0,,♪Бұдан былай көз жасыңды көрсетпе
Dialogue: 0,1:19:43.65,1:19:46.99,Default,,0,0,0,,♪Жүрегіңнің көзін аш
Dialogue: 0,1:19:47.11,1:19:50.24,Default,,0,0,0,,♪Көрінбейтін болашаққа
Dialogue: 0,1:19:50.36,1:19:56.70,Default,,0,0,0,,♪Енді сенетін кез, күшпен
Dialogue: 0,1:19:56.83,1:20:00.00,Default,,0,0,0,,♪Сіз кез келген уақытта тұра аласыз
Dialogue: 0,1:20:00.12,1:20:03.21,Default,,0,0,0,,♪Батыл бол
Dialogue: 0,1:20:03.34,1:20:06.42,Default,,0,0,0,,♪ла ла ла…
Dialogue: 0,1:20:06.55,1:20:09.72,Default,,0,0,0,,♪ла ла ла…
Dialogue: 0,1:20:09.84,1:20:12.89,Default,,0,0,0,,♪ла ла ла…
Dialogue: 0,1:20:13.01,1:20:16.35,Default,,0,0,0,,♪ла ла ла…
Dialogue: 0,1:20:27.44,1:20:30.57,Default,,0,0,0,,♪Төмен қарап, иықтарыңызды түсіріңіз
Dialogue: 0,1:20:30.70,1:20:33.78,Default,,0,0,0,,♪Мен ол жерге жете алмаймын
Dialogue: 0,1:20:33.91,1:20:37.08,Default,,0,0,0,,♪ Үмітке толы
Dialogue: 0,1:20:37.20,1:20:41.50,Default,,0,0,0,,♪ Керемет мақсат
Dialogue: 0,1:20:42.46,1:20:44.75,Default,,0,0,0,,♪Жүгіруді жалғастырайық
Dialogue: 0,1:20:45.71,1:20:48.05,Default,,0,0,0,,♪Тырысып көрейік
Dialogue: 0,1:20:48.96,1:20:51.22,Default,,0,0,0,,♪Сіз күшті бола аласыз!
Dialogue: 0,1:20:53.59,1:21:00.10,Default,,0,0,0,,♪Қазір батылдықпен ұшуға уақыт келді
Dialogue: 0,1:21:00.23,1:21:03.19,Default,,0,0,0,,♪Жүрегіңнің қанатын кеңге жай
Dialogue: 0,1:21:03.31,1:21:06.44,Default,,0,0,0,,♪Көрінбейтін болашаққа
Dialogue: 0,1:21:06.57,1:21:12.95,Default,,0,0,0,,♪Бұдан былай шексіз ғаламға қарай
Dialogue: 0,1:21:13.07,1:21:16.16,Default,,0,0,0,,♪Бұл енді ғана басталды
Dialogue: 0,1:21:16.28,1:21:19.45,Default,,0,0,0,,♪Армандағы шытырман оқиға
Dialogue: 0,1:21:19.58,1:21:22.66,Default,,0,0,0,,♪ла ла ла…
Dialogue: 0,1:21:22.79,1:21:25.75,Default,,0,0,0,,♪ла ла ла…
Dialogue: 0,1:21:26.04,1:21:29.17,Default,,0,0,0,,♪ла ла ла…
Dialogue: 0,1:21:29.30,1:21:32.38,Default,,0,0,0,,♪ла ла ла…
Dialogue: 0,1:21:32.51,1:21:35.59,Default,,0,0,0,,♪ла ла ла…
