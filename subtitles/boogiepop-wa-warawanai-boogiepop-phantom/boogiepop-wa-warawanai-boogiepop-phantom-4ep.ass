Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.25,0:00:06.25,Default,,0,0,0,,♪～
Dialogue: 0,0:01:26.00,0:01:31.00,Default,,0,0,0,,～♪
Dialogue: 0,0:01:31.25,0:01:36.84,Default,,0,0,0,,(Йодзидің ауыр тыныс алуы)
Dialogue: 0,0:01:36.93,0:01:38.05,Default,,0,0,0,,Сен оны білесің бе?
Dialogue: 0,0:01:38.13,0:01:41.55,Default,,0,0,0,,Даршын үрейді басады дейді.
Dialogue: 0,0:01:42.56,0:01:43.93,Default,,0,0,0,,Бұл да батылдықты қажет етеді.
Dialogue: 0,0:01:44.06,0:01:45.93,Default,,0,0,0,,Ароматерапия кітабында жазылған.
Dialogue: 0,0:01:46.06,0:01:49.27,Default,,0,0,0,,Шынымен бе? Олай болса, мен бұл жігітке кері нан беремін деп ойлаймын...
Dialogue: 0,0:01:49.40,0:01:50.36,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:01:50.48,0:01:52.48,Default,,0,0,0,,Ақыры маған осыншама берілді.
Dialogue: 0,0:01:53.73,0:01:54.65,Default,,0,0,0,,Барлығы…
Dialogue: 0,0:01:55.03,0:01:56.82,Default,,0,0,0,,Өйткені маған үлес берілді.
Dialogue: 0,0:01:57.40,0:01:58.45,Default,,0,0,0,,А, сен не істеп жатырсың?
Dialogue: 0,0:02:03.99,0:02:05.50,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:02:06.08,0:02:07.62,Default,,0,0,0,,Бұл даршын емес
Dialogue: 0,0:02:13.21,0:02:14.50,Default,,0,0,0,,А... жоқ па?
Dialogue: 0,0:02:14.63,0:02:16.38,Default,,0,0,0,,S түрін айттыңыз ба?
Dialogue: 0,0:02:16.51,0:02:18.51,Default,,0,0,0,,Оны алу өте қиын сияқты.
Dialogue: 0,0:02:19.34,0:02:20.30,Default,,0,0,0,,Қай жерде сатылады?
Dialogue: 0,0:02:20.43,0:02:23.30,Default,,0,0,0,,Енді оны вокзал алдында біреу таратып жатқан сияқты.
Dialogue: 0,0:02:23.43,0:02:25.14,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:02:25.27,0:02:27.52,Default,,0,0,0,,Мен ол жаққа барсам, біле аламын ба? Болды
Dialogue: 0,0:02:33.06,0:02:36.40,Default,,0,0,0,,Сіз оның вокзал алдында толық емес жұмыс істейтініне сенімдісіз бе?
Dialogue: 0,0:02:36.53,0:02:37.40,Default,,0,0,0,,Және фитнес тестінде де мен нашар өттім…
Dialogue: 0,0:02:37.53,0:02:40.49,Default,,0,0,0,,Ол білмейді. Ол мұны істей алмайды.
Dialogue: 0,0:02:40.66,0:02:43.03,Default,,0,0,0,,Иә, бұл Некра.
Dialogue: 0,0:02:43.37,0:02:44.99,Default,,0,0,0,,Бұл қабақ бояуы өте сүйкімді емес пе?
Dialogue: 0,0:02:45.12,0:02:47.54,Default,,0,0,0,,Аа, сүйкімді болды (1-қыз) Хехехе...
Dialogue: 0,0:02:48.25,0:02:49.58,Default,,0,0,0,,Мен бос емеспін
Dialogue: 0,0:02:49.71,0:02:50.79,Default,,0,0,0,,Мен бос емеспін.
Dialogue: 0,0:02:50.92,0:02:53.46,Default,,0,0,0,,Бұл дата Бұл күн
Dialogue: 0,0:02:53.59,0:02:54.54,Default,,0,0,0,,Замамиро
Dialogue: 0,0:02:54.67,0:02:56.21,Default,,0,0,0,,Мен кездесудемін
Dialogue: 0,0:02:58.67,0:03:00.22,Default,,0,0,0,,Бұл күн...
Dialogue: 0,0:03:00.34,0:03:04.22,Default,,0,0,0,,(Қыздардың күлкісі)
Dialogue: 0,0:03:04.35,0:03:11.27,Default,,0,0,0,,(Йодзидің ауыр тыныс алуы)
Dialogue: 0,0:03:24.37,0:03:29.37,Default,,0,0,0,,(ыдыс жуу дыбысы)
Dialogue: 0,0:03:38.21,0:03:39.80,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:03:40.88,0:03:42.13,Default,,0,0,0,,Сіз қалай ойлайсыз? сынақ
Dialogue: 0,0:03:42.26,0:03:45.30,Default,,0,0,0,,Оңай жеңіс, ойнағандай.
Dialogue: 0,0:03:45.89,0:03:49.27,Default,,0,0,0,,Сіз қарапайым адамнан ақылдысыз.
Dialogue: 0,0:03:49.39,0:03:50.81,Default,,0,0,0,,(Айзава) Бірінші жекпе-жек бойынша ой елегінен өткізуге арналған негізгі тармақтарды айтыңыз
Dialogue: 0,0:03:51.23,0:03:52.56,Default,,0,0,0,,Жастар
Dialogue: 0,0:03:53.44,0:03:55.48,Default,,0,0,0,,Менің де сол күндерге оралғым келеді.
Dialogue: 0,0:03:56.11,0:03:57.82,Default,,0,0,0,,Мен жоғары көтеріле аламын ба?
Dialogue: 0,0:03:58.02,0:03:59.44,Default,,0,0,0,,Күні? (Йодзи) Хмм...
Dialogue: 0,0:03:59.57,0:04:01.99,Default,,0,0,0,,Не болды? Хахаха...
Dialogue: 0,0:04:02.40,0:04:04.78,Default,,0,0,0,,Бос емеспін, кездесудемін.
Dialogue: 0,0:04:04.91,0:04:06.87,Default,,0,0,0,,Иә, менің қызым бар.
Dialogue: 0,0:04:06.99,0:04:07.58,Default,,0,0,0,,Иә
Dialogue: 0,0:04:12.21,0:04:12.79,Default,,0,0,0,,Чи…
Dialogue: 0,0:04:18.84,0:04:21.84,Default,,0,0,0,,А... арзандата аласың ба?
Dialogue: 0,0:04:21.92,0:04:25.09,Default,,0,0,0,,Бұл бәрібір ароматерапия, солай ма?
Dialogue: 0,0:04:26.59,0:04:29.81,Default,,0,0,0,,Осы жігіттің арқасында сен әлдеқайда батыл болып кеттің.
Dialogue: 0,0:04:31.77,0:04:32.98,Default,,0,0,0,,Көбірек сатыңыз
Dialogue: 0,0:04:34.06,0:04:37.27,Default,,0,0,0,,Қазіргі өміріне көңілі толмайтындар үшін...
Dialogue: 0,0:04:40.36,0:04:44.61,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,0:04:44.90,0:04:47.03,Default,,0,0,0,,Йоджи Жалған сынақ қалай өтті?
Dialogue: 0,0:04:48.57,0:04:51.37,Default,,0,0,0,,Өздеріңіз білетіндей, бұл бәрібір ұлттық.
Dialogue: 0,0:04:52.04,0:04:55.12,Default,,0,0,0,,Мен енді бірінші дәрежелі болғым келмейді, бірақ мен шірісем де, мен ұлтшылмын!
Dialogue: 0,0:04:58.58,0:05:01.21,Default,,0,0,0,,Сен менің баламсың, неге сонша ақымақсың?
Dialogue: 0,0:05:01.46,0:05:02.63,Default,,0,0,0,,Идиот?
Dialogue: 0,0:05:03.30,0:05:05.17,Default,,0,0,0,,Бұл үлкен сәтсіздік.
Dialogue: 0,0:05:06.26,0:05:07.09,Default,,0,0,0,,(Есікті қағу)
Dialogue: 0,0:05:07.22,0:05:09.39,Default,,0,0,0,,Егер ауытқу баллы төмен болса, оқу ақысы төмен университетті таңдаңыз.
Dialogue: 0,0:05:09.39,0:05:10.22,Default,,0,0,0,,Егер ауытқу баллы төмен болса, оқу ақысы төмен университетті таңдаңыз.
Dialogue: 0,0:05:09.39,0:05:10.22,Default,,0,0,0,,(Есікті қағу)
Dialogue: 0,0:05:10.89,0:05:13.02,Default,,0,0,0,,Сондықтан сіз де ата-анаңызға мейірімді бола аласыз.
Dialogue: 0,0:05:13.14,0:05:13.85,Default,,0,0,0,,Құпия айтпасам, бүгін түнде ұйықтай алмаймын
Dialogue: 0,0:05:15.98,0:05:18.40,Default,,0,0,0,,Мен сені білмеймін, білмеймін
Dialogue: 0,0:05:18.52,0:05:19.65,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:05:19.77,0:05:20.73,Default,,0,0,0,,Қараңыз...
Dialogue: 0,0:05:28.53,0:05:30.07,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:05:45.67,0:05:47.55,Default,,0,0,0,,Иә, бұл сізге өте жарасады.
Dialogue: 0,0:05:47.68,0:05:49.05,Default,,0,0,0,,(тінтуірді басқан дыбыс)
Dialogue: 0,0:06:01.48,0:06:07.40,Default,,0,0,0,,(Йодзидің ауыр тыныс алуы)
Dialogue: 0,0:06:07.53,0:06:09.95,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:06:14.16,0:06:15.45,Default,,0,0,0,,Шу… бір аптадан кейін
Dialogue: 0,0:06:15.91,0:06:18.12,Default,,0,0,0,,Сіз тек 3 күн жұмыс істей аласыз ба?
Dialogue: 0,0:06:18.25,0:06:19.46,Default,,0,0,0,,Бұл әлі де жақсы емес пе?
Dialogue: 0,0:06:22.84,0:06:25.55,Default,,0,0,0,,Мысалы, дүйсенбі, сәрсенбі және жұма күндері ше?
Dialogue: 0,0:06:27.13,0:06:29.01,Default,,0,0,0,,Мен бұл туралы ойланамын (орындық тартылған дыбыс)
Dialogue: 0,0:06:30.22,0:06:31.22,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:36.35,0:06:37.60,Default,,0,0,0,,А, сен...
Dialogue: 0,0:06:38.02,0:06:39.44,Default,,0,0,0,,Эй, сен... (есіктің ашылған дыбысы)
Dialogue: 0,0:06:43.56,0:06:45.44,Default,,0,0,0,,Жұмыс істеу керек пе?
Dialogue: 0,0:06:45.57,0:06:47.19,Default,,0,0,0,,Мен бұл туралы бірдеңе істеймін.
Dialogue: 0,0:06:47.32,0:06:50.15,Default,,0,0,0,,Мен ескі қормын, уайымдамаңыз.
Dialogue: 0,0:06:50.28,0:06:53.03,Default,,0,0,0,,Жоқ, бұл күшті. Бұл күшті.
Dialogue: 0,0:06:53.16,0:06:55.87,Default,,0,0,0,,Мен итермелемеймін, тек айтпадым.
Dialogue: 0,0:06:55.99,0:06:57.04,Default,,0,0,0,,Бұл қалыпты жағдай.
Dialogue: 0,0:07:00.54,0:07:01.58,Default,,0,0,0,,Үйрек
Dialogue: 0,0:07:03.33,0:07:04.34,Default,,0,0,0,,Суганума…
Dialogue: 0,0:07:05.09,0:07:08.80,Default,,0,0,0,,Ешкім мені сол лас түріммен қайтармайды.
Dialogue: 0,0:07:08.92,0:07:10.59,Default,,0,0,0,,Не... сен қандайсың?
Dialogue: 0,0:07:10.72,0:07:12.59,Default,,0,0,0,,Мен аздап биледім.
Dialogue: 0,0:07:17.10,0:07:18.77,Default,,0,0,0,,Осы арқылы өзгертуге болады
Dialogue: 0,0:07:19.81,0:07:21.06,Default,,0,0,0,,Батыл болыңыз
Dialogue: 0,0:07:22.31,0:07:23.65,Default,,0,0,0,,Ұсақ және сымбатты
Dialogue: 0,0:07:23.77,0:07:26.48,Default,,0,0,0,,Мен сені құшақтап алғанда, қабырғам сықырлады...
Dialogue: 0,0:07:26.94,0:07:29.78,Default,,0,0,0,,Сен сияқты балалар бар.
Dialogue: 0,0:07:34.99,0:07:37.99,Default,,0,0,0,,Сіз кемелсіз Риэ
Dialogue: 0,0:07:41.00,0:07:41.87,Default,,0,0,0,,Ри
Dialogue: 0,0:08:10.36,0:08:11.65,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:08:17.87,0:08:19.04,Default,,0,0,0,,Сізге сәйкес келе ме?
Dialogue: 0,0:08:25.04,0:08:26.33,Default,,0,0,0,,S түрі…
Dialogue: 0,0:08:26.96,0:08:28.50,Default,,0,0,0,,Маған батылдық бер
Dialogue: 0,0:08:28.88,0:08:31.17,Default,,0,0,0,,Марухи байқалды. Оның Қиркі іске қосылмас бұрын дереу қамауға алуды сұраймын
Dialogue: 0,0:08:31.30,0:08:34.72,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:08:34.84,0:08:37.68,Default,,0,0,0,,Теру дыбысынан кейін хабарлама қалдырыңыз
Dialogue: 0,0:08:37.80,0:08:39.14,Default,,0,0,0,,(Жауап беру құрылғысының дыбысы)
Dialogue: 0,0:08:39.26,0:08:40.72,Default,,0,0,0,,Бұл Суганума, толық емес жұмыс күні.
Dialogue: 0,0:08:40.85,0:08:43.18,Default,,0,0,0,,Аптасына кез келген күн саны жақсы.
Dialogue: 0,0:08:57.11,0:08:59.24,Default,,0,0,0,,Уау, сондай сүйкімді!
Dialogue: 0,0:08:59.58,0:09:01.74,Default,,0,0,0,,Мен осындай нәрсе кигім келді
Dialogue: 0,0:09:02.12,0:09:04.21,Default,,0,0,0,,Бірыңғай киім, сенде бар болғаны осы
Dialogue: 0,0:09:05.79,0:09:08.42,Default,,0,0,0,,Бұл... қысқа емес пе? Бұл
Dialogue: 0,0:09:08.71,0:09:09.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:10.00,0:09:12.46,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:09:13.38,0:09:14.67,Default,,0,0,0,,Бұл сізге сәйкес келеді...
Dialogue: 0,0:09:15.22,0:09:16.76,Default,,0,0,0,,Сізге керемет көрінеді
Dialogue: 0,0:09:16.88,0:09:18.59,Default,,0,0,0,,Бұл сізге жарасады, сізге жарасады
Dialogue: 0,0:09:30.82,0:09:31.11,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:09:31.11,0:09:32.98,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:09:31.11,0:09:32.98,Default,,0,0,0,,Мен сізге айтайын
Dialogue: 0,0:09:32.98,0:09:33.11,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:09:33.11,0:09:35.49,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:09:33.11,0:09:35.49,Default,,0,0,0,,Ол «Менің әдемі ханым» деп аталады.
Dialogue: 0,0:09:40.83,0:09:41.66,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:09:40.83,0:09:41.66,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:09:41.66,0:09:41.78,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:09:41.78,0:09:46.25,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:09:41.78,0:09:46.25,Default,,0,0,0,,Университет профессоры гүлді қызды сүйкімді әйелге «тәрбиелейді».
Dialogue: 0,0:09:46.25,0:09:46.58,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:09:53.75,0:09:54.76,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:09:55.67,0:09:56.84,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:09:56.97,0:09:58.43,Default,,0,0,0,,Идеал - ат құйрығы
Dialogue: 0,0:09:58.55,0:09:59.76,Default,,0,0,0,,Өз басым
Dialogue: 0,0:10:00.39,0:10:02.43,Default,,0,0,0,,Мен оның шашының жоғары болғанын қалаймын.
Dialogue: 0,0:10:04.47,0:10:07.23,Default,,0,0,0,,Менің сұлу ханым бол
Dialogue: 0,0:10:07.89,0:10:09.06,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:10:19.57,0:10:22.58,Default,,0,0,0,,Оны бүгілген шынтағыңыздың ішкі жағына қойыңыз.
Dialogue: 0,0:10:25.62,0:10:27.00,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:10:27.66,0:10:29.50,Default,,0,0,0,,Мен сізге кейінірек айтамын.
Dialogue: 0,0:10:30.25,0:10:32.67,Default,,0,0,0,,Міне, солай шығар...
Dialogue: 0,0:10:32.79,0:10:35.46,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:10:36.71,0:10:38.97,Default,,0,0,0,,Бұрын күріште шаш болған.
Dialogue: 0,0:10:39.09,0:10:41.47,Default,,0,0,0,,Не, менікі?
Dialogue: 0,0:10:41.68,0:10:44.97,Default,,0,0,0,,Дүкен меңгерушісі пермальді, ал менің шашым одан да қысқа...
Dialogue: 0,0:10:46.06,0:10:47.98,Default,,0,0,0,,Кешіріңіз, келесі жолы мұқият боламын!
Dialogue: 0,0:10:53.19,0:10:55.07,Default,,0,0,0,,Мен шашыңыздың көтерілгенін қалаймын.
Dialogue: 0,0:10:56.40,0:10:59.11,Default,,0,0,0,,Иә, қазірден бастап солай істеймін.
Dialogue: 0,0:11:04.41,0:11:07.79,Default,,0,0,0,,Ойланып қарасаңыз, сіз шынымен орта мектеп оқушысысыз ба?
Dialogue: 0,0:11:08.37,0:11:10.08,Default,,0,0,0,,Неліктен олай болды...
Dialogue: 0,0:11:10.62,0:11:13.58,Default,,0,0,0,,Дүкен басшысына немесе ата-анама айтсам не болады?
Dialogue: 0,0:11:15.75,0:11:17.76,Default,,0,0,0,,Өтінемін, айтпаңыз!
Dialogue: 0,0:11:18.13,0:11:22.01,Default,,0,0,0,,(Ағып жатқан судың дыбысы)
Dialogue: 0,0:11:22.89,0:11:26.47,Default,,0,0,0,,Мектептің атын қате алғаным біртүрлі болды деп ойладым.
Dialogue: 0,0:11:26.60,0:11:27.97,Default,,0,0,0,,«Шинё академиясы» болса да
Dialogue: 0,0:11:28.10,0:11:29.85,Default,,0,0,0,,«Шинё орта мектебі»
Dialogue: 0,0:11:30.43,0:11:32.73,Default,,0,0,0,,Мектеп білсе, мен...
Dialogue: 0,0:11:32.94,0:11:34.19,Default,,0,0,0,,Бұл емтихан...
Dialogue: 0,0:11:34.56,0:11:35.52,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,0:11:39.86,0:11:40.78,Default,,0,0,0,,Шаш…
Dialogue: 0,0:11:41.61,0:11:42.78,Default,,0,0,0,,Жабу
Dialogue: 0,0:11:42.95,0:11:43.61,Default,,0,0,0,,Не!
Dialogue: 0,0:11:51.87,0:11:54.29,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:11:58.25,0:11:59.51,Default,,0,0,0,,Жарыс басталмас бұрын Қвиркіңді қолданба! Өзіңді шаршатпа!
Dialogue: 0,0:11:59.63,0:12:03.01,Default,,0,0,0,,Мен саған аздап жұмсадым.
Dialogue: 0,0:12:03.22,0:12:04.76,Default,,0,0,0,,Тым көп жасасаңыз, солай бола ма?
Dialogue: 0,0:12:04.89,0:12:10.06,Default,,0,0,0,,(Мёмидің күлкісі)
Dialogue: 0,0:12:10.18,0:12:12.02,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:12:12.48,0:12:14.23,Default,,0,0,0,,Эй, тез ақша.
Dialogue: 0,0:12:17.02,0:12:18.98,Default,,0,0,0,,Ри Ри
Dialogue: 0,0:12:19.57,0:12:22.03,Default,,0,0,0,,Тек көкөністерді жеу керек.
Dialogue: 0,0:12:22.70,0:12:25.78,Default,,0,0,0,,Сол сымбатты денені сақтау үшін.
Dialogue: 0,0:12:32.87,0:12:34.96,Default,,0,0,0,,Эй, сен аптаның қай күнісің?
Dialogue: 0,0:12:35.08,0:12:37.04,Default,,0,0,0,,Мм... дүйсенбі, жұма
Dialogue: 0,0:12:47.14,0:12:49.51,Default,,0,0,0,,Кешіріңіз, маған су беріңізші.
Dialogue: 0,0:12:50.14,0:12:51.02,Default,,0,0,0,,Иә
Dialogue: 0,0:12:52.10,0:12:53.93,Default,,0,0,0,,Эй, Фудзихана (Фудзихана)?
Dialogue: 0,0:12:54.06,0:12:56.56,Default,,0,0,0,,Сіз білесіз бе? D сыныбынан Кирима Наги
Dialogue: 0,0:12:56.69,0:12:59.32,Default,,0,0,0,,Мектептен шеттетілсе де, кеше тағы да осында қыдырдым.
Dialogue: 0,0:12:59.44,0:13:00.40,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:13:00.52,0:13:03.11,Default,,0,0,0,,Наги S үлгісін сатпайды ма?
Dialogue: 0,0:13:03.24,0:13:04.40,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:13:04.53,0:13:07.24,Default,,0,0,0,,Мен Кирима-санды онша жаман деп ойламаймын.
Dialogue: 0,0:13:09.12,0:13:10.24,Default,,0,0,0,,Жай ғана шіркін...
Dialogue: 0,0:13:10.37,0:13:11.08,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:13:11.08,0:13:12.79,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:13:11.08,0:13:12.79,Default,,0,0,0,,Мен қайтамын, Ри Чан.
Dialogue: 0,0:13:13.25,0:13:16.29,Default,,0,0,0,,Қарама, қарама, бұл менің жалғыз Рием
Dialogue: 0,0:13:17.17,0:13:20.54,Default,,0,0,0,,Ендеше, еңбегіңнің сыйлығы.
Dialogue: 0,0:13:20.67,0:13:22.67,Default,,0,0,0,,Уау, бақыт!
Dialogue: 0,0:13:28.43,0:13:29.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:29.39,0:13:32.06,Default,,0,0,0,,Ри, бұл тамақ емес.
Dialogue: 0,0:13:34.64,0:13:38.19,Default,,0,0,0,,Ри, сен оны жемедің, солай ма?
Dialogue: 0,0:13:43.23,0:13:44.74,Default,,0,0,0,,Маған сәйкес келе ме?
Dialogue: 0,0:13:45.74,0:13:47.36,Default,,0,0,0,,О, солай...
Dialogue: 0,0:13:47.74,0:13:50.53,Default,,0,0,0,,Бұл мектептегі купальник, сондықтан басқа ештеңе кимеңіз.
Dialogue: 0,0:13:51.08,0:13:52.87,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:52.99,0:13:56.87,Default,,0,0,0,,Сол киімдерді әлі киіп жүрсіз бе? Мен оны көруден шаршадым
Dialogue: 0,0:13:57.00,0:13:59.50,Default,,0,0,0,,Сіз купальникті дұрыс таңдадыңыз.
Dialogue: 0,0:14:00.75,0:14:01.84,Default,,0,0,0,,Ум...
Dialogue: 0,0:14:01.96,0:14:04.21,Default,,0,0,0,,Алдын ала кешірім сұраймын.
Dialogue: 0,0:14:10.68,0:14:11.93,Default,,0,0,0,,Ри... Ри
Dialogue: 0,0:14:12.30,0:14:12.81,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:13.68,0:14:15.10,Default,,0,0,0,,Гувах... (құлап түскен дыбыс)
Dialogue: 0,0:14:15.56,0:14:20.10,Default,,0,0,0,,(Йодзидің мазасыз дауысы)
Dialogue: 0,0:14:25.99,0:14:28.61,Default,,0,0,0,,Маған S түрін беріңіз.
Dialogue: 0,0:14:29.32,0:14:32.74,Default,,0,0,0,,Сіз өзіңізге ешқашан көңіліңіз толмады.
Dialogue: 0,0:14:32.87,0:14:34.45,Default,,0,0,0,,Мен ешқашан танымал болған емеспін
Dialogue: 0,0:14:34.87,0:14:37.08,Default,,0,0,0,,Бірақ бұл күндері қызық, солай емес пе?
Dialogue: 0,0:14:38.16,0:14:38.87,Default,,0,0,0,,Иә...
Dialogue: 0,0:14:39.21,0:14:41.54,Default,,0,0,0,,Көңілді болдыңыз ба?
Dialogue: 0,0:14:41.67,0:14:42.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:43.25,0:14:44.84,Default,,0,0,0,,(бастың артындағы үрлеу дыбысы)
Dialogue: 0,0:14:49.59,0:14:54.01,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:15:03.56,0:15:04.27,Default,,0,0,0,,Маған беріңіз
Dialogue: 0,0:15:05.23,0:15:06.48,Default,,0,0,0,,S түрі
Dialogue: 0,0:15:08.19,0:15:09.28,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:15:09.40,0:15:12.82,Default,,0,0,0,,Уайымдама, ол да қазір біздің құлымыз.
Dialogue: 0,0:15:12.95,0:15:15.58,Default,,0,0,0,,Хмм, сонда мен сені өлтіремін бе?
Dialogue: 0,0:15:15.70,0:15:16.87,Default,,0,0,0,,Әлі ерте.
Dialogue: 0,0:15:17.45,0:15:20.54,Default,,0,0,0,,Мен анағұрлым соңғы құлды байқағым келеді.
Dialogue: 0,0:15:20.66,0:15:24.04,Default,,0,0,0,,Хе, сен айтсаң, толық құлсың.
Dialogue: 0,0:15:24.34,0:15:25.17,Default,,0,0,0,,Иә
Dialogue: 0,0:15:25.29,0:15:28.92,Default,,0,0,0,,Шындықтан толығымен қашып, тәуелсіздіктен айырылу.
Dialogue: 0,0:15:29.05,0:15:31.09,Default,,0,0,0,,Біздің роботтар сияқты қозғалыңыз
Dialogue: 0,0:15:31.93,0:15:34.76,Default,,0,0,0,,Мен мұндай нәрселерді көп қалаймын.
Dialogue: 0,0:15:35.01,0:15:37.85,Default,,0,0,0,,Адамзат қоғамын қайта құру үшін...
Dialogue: 0,0:15:37.97,0:15:38.81,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:15:38.93,0:15:40.94,Default,,0,0,0,,Сізде бар, солай ма? Маған берші
Dialogue: 0,0:15:41.27,0:15:42.85,Default,,0,0,0,,Бүгін көргеніңізді ұмытыңыз.
Dialogue: 0,0:15:43.06,0:15:43.81,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:44.19,0:15:47.65,Default,,0,0,0,,...
Dialogue: 0,0:15:50.40,0:15:54.74,Default,,0,0,0,,...
Dialogue: 0,0:16:00.83,0:16:03.29,Default,,0,0,0,,...
Dialogue: 0,0:16:11.59,0:16:12.72,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:20.35,0:16:21.43,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:16:26.44,0:16:29.19,Default,,0,0,0,,...
Dialogue: 0,0:16:29.32,0:16:32.74,Default,,0,0,0,,…
Dialogue: 0,0:16:35.11,0:16:39.24,Default,,0,0,0,,…
Dialogue: 0,0:16:41.41,0:16:42.87,Default,,0,0,0,,…
Dialogue: 0,0:16:43.08,0:16:44.62,Default,,0,0,0,,…
Dialogue: 0,0:16:48.67,0:16:51.80,Default,,0,0,0,,Ｓ
Dialogue: 0,0:16:51.92,0:16:53.30,Default,,0,0,0,,...
Dialogue: 0,0:16:53.42,0:16:54.63,Default,,0,0,0,,…
Dialogue: 0,0:16:54.76,0:16:57.72,Default,,0,0,0,,...
Dialogue: 0,0:16:57.85,0:16:58.68,Default,,0,0,0,,...
Dialogue: 0,0:16:58.97,0:16:59.64,Default,,0,0,0,,Иә
Dialogue: 0,0:17:05.02,0:17:05.85,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:17:05.98,0:17:08.06,Default,,0,0,0,,Ｓ Ｓ
Dialogue: 0,0:17:08.19,0:17:11.11,Default,,0,0,0,,Ｓ
Dialogue: 0,0:17:12.69,0:17:15.07,Default,,0,0,0,,...
Dialogue: 0,0:17:16.82,0:17:19.03,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:17:19.16,0:17:21.54,Default,,0,0,0,,...
Dialogue: 0,0:17:21.66,0:17:24.25,Default,,0,0,0,,...
Dialogue: 0,0:17:24.37,0:17:26.17,Default,,0,0,0,,（）
Dialogue: 0,0:17:27.08,0:17:28.83,Default,,0,0,0,,...
Dialogue: 0,0:17:29.13,0:17:33.09,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:17:35.47,0:17:39.09,Default,,0,0,0,,...
Dialogue: 0,0:17:40.05,0:17:43.22,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:17:45.02,0:17:47.85,Default,,0,0,0,,...
Dialogue: 0,0:17:48.35,0:17:50.61,Default,,0,0,0,,…
Dialogue: 0,0:17:50.73,0:17:53.78,Default,,0,0,0,,...
Dialogue: 0,0:17:54.07,0:17:56.70,Default,,0,0,0,,...
Dialogue: 0,0:17:56.82,0:17:58.45,Default,,0,0,0,,(тінтуірді басқан дыбыс)
Dialogue: 0,0:17:59.41,0:18:00.57,Default,,0,0,0,,(тінтуірді басқан дыбыс)
Dialogue: 0,0:18:00.82,0:18:01.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:05.20,0:18:08.79,Default,,0,0,0,,...
Dialogue: 0,0:18:10.17,0:18:11.00,Default,,0,0,0,,...
Dialogue: 0,0:18:11.09,0:18:13.42,Default,,0,0,0,,...
Dialogue: 0,0:18:13.55,0:18:14.80,Default,,0,0,0,,（ ）
Dialogue: 0,0:18:15.09,0:18:15.92,Default,,0,0,0,,（ ）
Dialogue: 0,0:18:16.05,0:18:17.47,Default,,0,0,0,,...
Dialogue: 0,0:18:17.59,0:18:19.80,Default,,0,0,0,,...
Dialogue: 0,0:18:19.89,0:18:21.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:23.64,0:18:27.77,Default,,0,0,0,,...
Dialogue: 0,0:18:28.19,0:18:29.60,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:18:30.90,0:18:32.82,Default,,0,0,0,,...
Dialogue: 0,0:18:33.57,0:18:36.03,Default,,0,0,0,,...
Dialogue: 0,0:18:36.36,0:18:37.32,Default,,0,0,0,,…
Dialogue: 0,0:18:38.24,0:18:39.53,Default,,0,0,0,,...
Dialogue: 0,0:18:40.41,0:18:43.20,Default,,0,0,0,,...
Dialogue: 0,0:18:44.20,0:18:46.16,Default,,0,0,0,,...
Dialogue: 0,0:18:46.29,0:18:47.91,Default,,0,0,0,,...
Dialogue: 0,0:18:49.50,0:18:50.67,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:18:55.21,0:18:58.72,Default,,0,0,0,,Енді мен саған бұл жолы нені үйретуім керек?
Dialogue: 0,0:18:59.30,0:19:00.13,Default,,0,0,0,,Ах
Dialogue: 0,0:19:00.55,0:19:01.51,Default,,0,0,0,,Қоғамдық махаббат хатынан бері —
Dialogue: 0,0:19:08.31,0:19:09.14,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:19:09.81,0:19:11.15,Default,,0,0,0,,Қашқаннан пайда жоқ
Dialogue: 0,0:19:12.44,0:19:15.15,Default,,0,0,0,,Сен әрқашан алақанымдасың
Dialogue: 0,0:19:17.82,0:19:19.65,Default,,0,0,0,,Иә, мен саған ән үйретейін.
Dialogue: 0,0:19:19.78,0:19:22.11,Default,,0,0,0,,Сізге караоке ұнайды, солай ма? Мен ән таңдаймын
Dialogue: 0,0:19:22.82,0:19:24.78,Default,,0,0,0,,Мен қорқамын...
Dialogue: 0,0:19:25.03,0:19:26.58,Default,,0,0,0,,Түсіндім, уайымдамаңыз.
Dialogue: 0,0:19:26.70,0:19:29.45,Default,,0,0,0,,Мен оны қазір жұмыстан шығарамын.
Dialogue: 0,0:19:30.08,0:19:32.96,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:19:40.88,0:19:43.55,Default,,0,0,0,,Ри, кел, менің алдымда ән айт.
Dialogue: 0,0:19:44.51,0:19:46.89,Default,,0,0,0,,Сол музыкалық фильм сияқты
Dialogue: 0,0:19:47.26,0:19:49.60,Default,,0,0,0,,Менің сұлу ханым
Dialogue: 0,0:20:10.58,0:20:13.42,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,0:20:16.96,0:20:17.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:18.96,0:20:20.26,Default,,0,0,0,,Айттым ғой! Апаттар – нағыз азап.
Dialogue: 0,0:20:23.01,0:20:25.34,Default,,0,0,0,,(тінтуірді басқан дыбыс)
Dialogue: 0,0:20:25.84,0:20:28.39,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:20:32.73,0:20:33.85,Default,,0,0,0,,Ри...
Dialogue: 0,0:20:33.98,0:20:36.44,Default,,0,0,0,,Ри Ри!
Dialogue: 0,0:20:36.69,0:20:38.73,Default,,0,0,0,,Ри Ри…
Dialogue: 0,0:20:38.86,0:20:41.11,Default,,0,0,0,,Ри!
Dialogue: 0,0:20:43.53,0:20:45.61,Default,,0,0,0,,Әй, не болды! (есік қағу дыбысы)
Dialogue: 0,0:20:45.74,0:20:47.16,Default,,0,0,0,,Ей, ақымақ!
Dialogue: 0,0:20:47.28,0:20:49.20,Default,,0,0,0,,Риді қайда жасырдың!
Dialogue: 0,0:20:49.33,0:20:50.16,Default,,0,0,0,,Эй!
Dialogue: 0,0:20:50.83,0:20:51.91,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:20:52.04,0:20:53.91,Default,,0,0,0,,Жарайды, мына жерді аш!
Dialogue: 0,0:20:57.33,0:20:58.46,Default,,0,0,0,,Шулы...
Dialogue: 0,0:20:59.21,0:21:00.09,Default,,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:21:00.42,0:21:01.92,Default,,0,0,0,,Шулы!
Dialogue: 0,0:21:02.34,0:21:03.92,Default,,0,0,0,,Жоғал! Жоғал!
Dialogue: 0,0:21:04.05,0:21:05.26,Default,,0,0,0,,Сіз жоғалып кетесіз!
Dialogue: 0,0:21:05.38,0:21:06.93,Default,,0,0,0,,Жоғал! Ақымақ!
Dialogue: 0,0:21:07.51,0:21:09.47,Default,,0,0,0,,Ха... Ах!
