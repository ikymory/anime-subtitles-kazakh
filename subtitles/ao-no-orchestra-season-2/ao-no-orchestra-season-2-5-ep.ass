Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.23,0:00:04.27,Default,,0,0,0,,♬～ (ансамбль)
Dialogue: 0,0:00:04.27,0:00:09.94,Default,,0,0,0,,<Труба немесе скрипка, қайсысының дыбысы қатты? ➡
Dialogue: 0,0:00:09.94,0:00:12.61,Default,,0,0,0,,Жауабы: Керней. ➡
Dialogue: 0,0:00:12.61,0:00:16.95,Default,,0,0,0,,Ішекті аспаптар үрмелі аспаптарға қарағанда дыбыс деңгейі төмен. ➡
Dialogue: 0,0:00:16.95,0:00:21.42,Default,,0,0,0,,Сондықтан ішекті аспаптар дыбыс айырмашылығын сандармен өтейді. ➡
Dialogue: 0,0:00:21.42,0:00:23.92,Default,,0,0,0,,Бірақ...＞
Dialogue: 0,0:00:26.62,0:00:29.29,Default,,0,0,0,,Үрмелі аспаптар!
Dialogue: 0,0:00:29.29,0:00:31.96,Default,,0,0,0,,Сіздің дыбыстарыңыз ішекті дыбысты басып тастайды.
Dialogue: 0,0:00:31.96,0:00:35.30,Default,,0,0,0,,Бұл үрмелі оркестр емес! (мүшелер) Кешіріңіз!
Dialogue: 0,0:00:35.30,0:00:38.80,Default,,0,0,0,,Сізде жіптер мен құбырлар туралы ескертулеріңіз бар ма? Тым кішкентай!
Dialogue: 0,0:00:38.80,0:00:42.30,Default,,0,0,0,,Балалар сендер сондай болғандықтан, түтік дыбыс шығара алмайды➡
Dialogue: 0,0:00:42.30,0:00:46.31,Default,,0,0,0,,Түсіндің бе? (мүшелер) Кешіріңіз!
Dialogue: 0,0:00:46.31,0:00:50.45,Default,,0,0,0,,Балалар сендер шынымен жақсы достарсыңдар. ➡
Dialogue: 0,0:00:50.45,0:00:54.65,Default,,0,0,0,,Сіз бір-біріңіздің аяқтарын тартып алғанды ұнатасыз ба? (Музыкалық тірекке соғылған таяқтың дыбысы)
Dialogue: 0,0:00:56.25,0:00:59.82,Default,,0,0,0,,Жарайды, егер сендерге бұл жақсы болса, мен қарсы емеспін.
Dialogue: 0,0:00:59.82,0:01:02.52,Default,,0,0,0,,Жақсы емес!
Dialogue: 0,0:01:07.63,0:01:13.37,Default,,0,0,0,,Байқауға бір айдан аз уақыт қалғанда, сіздің өнімділігіңізге қатысты мәселелер көп. ➡
Dialogue: 0,0:01:13.37,0:01:16.27,Default,,0,0,0,,Біріншіден, жіптер мен құбырлар торға қосылмайды. ➡
Dialogue: 0,0:01:16.27,0:01:21.11,Default,,0,0,0,,Бұл оркестр үшін мағынасы жоқ. Олардың бір-біріне деген немқұрайлылығының да шегі бар. ➡
Dialogue: 0,0:01:21.11,0:01:25.28,Default,,0,0,0,,Зейнеткер үшінші курс студенттерінің көлденең байланыстары күшті болды. ➡
Dialogue: 0,0:01:25.28,0:01:27.22,Default,,0,0,0,,Содан кейін өрнек. ➡
Dialogue: 0,0:01:27.22,0:01:30.15,Default,,0,0,0,,Бұл «Бакканал» әнін қалай түсінуге болады➡
Dialogue: 0,0:01:30.15,0:01:34.62,Default,,0,0,0,,Сіз мұны өз орындауыңызға қалай енгізесіз және оны дыбыс ретінде көрсетесіз?
Dialogue: 0,0:01:34.62,0:01:38.79,Default,,0,0,0,,Шынымды айтсам, менің қазіргі орындауыммен мұны істей алмаймын деп ойлаймын.
Dialogue: 0,0:01:38.79,0:01:42.43,Default,,0,0,0,,Көбірек әндерді шайнаңыз. Ал кіріңіз. ➡
Dialogue: 0,0:01:42.43,0:01:45.80,Default,,0,0,0,,үшінңызбен бірге «Бакканалды» жасаңыз!
Dialogue: 0,0:01:45.80,0:01:47.74,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:47.74,0:01:51.61,Default,,0,0,0,,Сен-Санның «Самсон мен Делила» операсынан➡
Dialogue: 0,0:01:51.61,0:01:53.54,Default,,0,0,0,,«Бакканал». ➡
Dialogue: 0,0:01:53.54,0:01:58.31,Default,,0,0,0,,Еврей батыры Самсон мен філістір сұлуы Делила. ➡
Dialogue: 0,0:01:58.31,0:02:02.58,Default,,0,0,0,,Жау болған екі еркек пен әйелдің махаббаты мен кек сезімі бейнеленген. ➡
Dialogue: 0,0:02:02.58,0:02:06.92,Default,,0,0,0,,Бұл әннің астарын түсініп, өзінше түсініп алсаңыз да➡
Dialogue: 0,0:02:06.92,0:02:10.26,Default,,0,0,0,,Бәрі бөліспесе, мағынасыз.
Dialogue: 0,0:02:10.26,0:02:13.16,Default,,0,0,0,,Әр бөлікті жай ғана жүйелеу жеткіліксіз. ➡
Dialogue: 0,0:02:13.16,0:02:16.67,Default,,0,0,0,,Бүкіл оркестрмен үйлестіруге жаттығамыз.
Dialogue: 0,0:02:18.40,0:02:31.98,Default,,0,0,0,,♬～
Dialogue: 0,0:02:31.98,0:02:35.62,Default,,0,0,0,,♬ «Өзім жылтыратып жүрген біртүрлі етік».
Dialogue: 0,0:02:35.62,0:02:40.49,Default,,0,0,0,,♬ «Мен көпшілік арасында бұрмаланып көріндім.»
Dialogue: 0,0:02:40.49,0:02:44.13,Default,,0,0,0,,♬ «Мен жүзіп жүрдім».
Dialogue: 0,0:02:44.13,0:02:50.30,Default,,0,0,0,,♬ «Таланттың биіне бас иемін, Ебедейсіз қимылдаймын».
Dialogue: 0,0:02:50.30,0:02:55.44,Default,,0,0,0,,♬ «Күліп, тісін көрсеткен Амадей түсінбейді».
Dialogue: 0,0:02:55.44,0:03:01.74,Default,,0,0,0,,♬ «Бір жерден біреудің дауысы естіледі»
Dialogue: 0,0:03:01.74,0:03:08.25,Default,,0,0,0,,♬ «Мен сияқты бұрмаланған және жалғыз ән»
Dialogue: 0,0:03:08.25,0:03:12.75,Default,,0,0,0,,♬ «Лорелей әуенді жоғалтқаннан кейін импровизация жасайды»
Dialogue: 0,0:03:12.75,0:03:15.66,Default,,0,0,0,,♬ «Бахтың қорапта ойнауы»
Dialogue: 0,0:03:15.66,0:03:20.26,Default,,0,0,0,,♬ «Мені тартып алып, сахнада биледім».
Dialogue: 0,0:03:20.26,0:03:24.60,Default,,0,0,0,,♬ «Түні бойы таусылатын сияқтымыз».
Dialogue: 0,0:03:24.60,0:03:32.11,Default,,0,0,0,,♬ «Мен бұл әдемі көздерден басқа ештеңе көрмеймін».
Dialogue: 0,0:03:32.11,0:03:36.95,Default,,0,0,0,,♬ «Мен қалай көрінемін?»
Dialogue: 0,0:03:36.95,0:03:43.95,Default,,0,0,0,,♬～
Dialogue: 0,0:03:49.66,0:03:52.43,Default,,0,0,0,,Қайырлы таң, директор Цуцуй.
Dialogue: 0,0:03:52.43,0:03:56.30,Default,,0,0,0,,Қайырлы таң. Мен... А... жақсысың ба! ?
Dialogue: 0,0:03:56.30,0:03:59.80,Default,,0,0,0,,Жоқ... аяғым аздап ауырады...
Dialogue: 0,0:03:59.80,0:04:03.51,Default,,0,0,0,,<Ах... кешегі спорт мерекесі...>
Dialogue: 0,0:04:05.37,0:04:08.28,Default,,0,0,0,,Қайырлы таң, Аоно-кун. қайырлы таң.
Dialogue: 0,0:04:08.28,0:04:13.58,Default,,0,0,0,,Ах... түсіндім. Блок жаттығуы бүгін басталады.
Dialogue: 0,0:04:15.58,0:04:21.09,Default,,0,0,0,,Олай болса, жаттығуды бастайық.
Dialogue: 0,0:04:21.09,0:04:23.93,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:04:23.93,0:04:28.60,Default,,0,0,0,,<Жарысқа бір айдан аз уақыт қалды, әнді тереңірек түсіну үшін➡
Dialogue: 0,0:04:28.60,0:04:32.93,Default,,0,0,0,,Үрмелі, ішекті және соқпалы аспаптардың барлық бөліктері шағын топта араласады➡
Dialogue: 0,0:04:32.93,0:04:35.97,Default,,0,0,0,,Топқа бөлініп, жаттығу. ➡
Dialogue: 0,0:04:35.97,0:04:40.11,Default,,0,0,0,,Сакума-сенпаймен бір топтан...＞
Dialogue: 0,0:04:40.11,0:04:44.28,Default,,0,0,0,,Иә? Аоно-кун шынымен жиіркенішті көрінеді➡
Dialogue: 0,0:04:44.28,0:04:47.95,Default,,0,0,0,,Не болды? Ештеңе етпейді.
Dialogue: 0,0:04:47.95,0:04:49.99,Default,,0,0,0,,Айтайын дегенім, Сакума!
Dialogue: 0,0:04:49.99,0:04:53.42,Default,,0,0,0,,Сіз жауапты емессіз. Ал, жақсы…
Dialogue: 0,0:04:53.42,0:04:56.29,Default,,0,0,0,,Не? суық?
Dialogue: 0,0:04:56.29,0:04:58.29,Default,,0,0,0,,Кешіріңіз, тамағым ауырып тұр...
Dialogue: 0,0:04:58.29,0:05:00.90,Default,,0,0,0,,Оны таратпаңыз. иә….
Dialogue: 0,0:05:00.90,0:05:04.73,Default,,0,0,0,,<Мына мүшелер жақсы ма? ＞
Dialogue: 0,0:05:04.73,0:05:07.64,Default,,0,0,0,,Ал, әр бөлімнен бастайық...
Dialogue: 0,0:05:07.64,0:05:10.94,Default,,0,0,0,,Сондықтан сіз басқарасыз! Эх...
Dialogue: 0,0:05:12.61,0:05:16.08,Default,,0,0,0,,Та-чибан! Сіз де В тобындасыз, солай ма?
Dialogue: 0,0:05:16.08,0:05:19.28,Default,,0,0,0,,Жаттығу басталады! Иә.
Dialogue: 0,0:05:23.05,0:05:26.05,Default,,0,0,0,,Олай болса, жаттығуды бастайық.
Dialogue: 0,0:05:27.62,0:05:32.46,Default,,0,0,0,,«Bacchanal» бастапқыда алкоголь құдайы дегенді білдіреді.
Dialogue: 0,0:05:32.46,0:05:35.10,Default,,0,0,0,,«Бахус», солай ма? Мен білемін.
Dialogue: 0,0:05:35.10,0:05:38.40,Default,,0,0,0,,Бұл! Бұл құдайлық мереке «Bacchanal» деп аталады.
Dialogue: 0,0:05:38.40,0:05:42.10,Default,,0,0,0,,Басқаша айтқанда, бұл той-томалақтарда ауыз ашатын ән, солай емес пе?
Dialogue: 0,0:05:42.10,0:05:45.77,Default,,0,0,0,,Менің ойымша, бұл қарапайым ән емес.
Dialogue: 0,0:05:45.77,0:05:49.28,Default,,0,0,0,,Алдымен әрбір сурет...
Dialogue: 0,0:05:49.28,0:05:52.18,Default,,0,0,0,,<Аоно-кун басқа топта...>
Dialogue: 0,0:05:52.18,0:05:55.62,Default,,0,0,0,,«Бакканал» - ер мен әйелдің махаббат хикаясы!
Dialogue: 0,0:05:55.62,0:05:58.42,Default,,0,0,0,,Сен де солай ойламайсың ба, Козакура? Ха! ?
Dialogue: 0,0:05:58.42,0:06:01.06,Default,,0,0,0,,Алаңдама, зейініңді жинақта.
Dialogue: 0,0:06:01.06,0:06:03.09,Default,,0,0,0,,Мен... Кешіріңіз...
Dialogue: 0,0:06:03.09,0:06:07.56,Default,,0,0,0,,Ал бұл ән Қозакураның ерекшелігі, солай ма? ➡
Dialogue: 0,0:06:07.56,0:06:09.90,Default,,0,0,0,,Олай болса, қалған жерімізден жалғастырайық.
Dialogue: 0,0:06:09.90,0:06:12.23,Default,,0,0,0,,<Бұл нені білдіреді...? ＞
Dialogue: 0,0:06:12.23,0:06:17.07,Default,,0,0,0,,♬～
Dialogue: 0,0:06:17.07,0:06:19.98,Default,,0,0,0,,Жылы.
Dialogue: 0,0:06:19.98,0:06:22.88,Default,,0,0,0,,Көбірек рақым қажет.
Dialogue: 0,0:06:22.88,0:06:24.81,Default,,0,0,0,,Талғампаздық….
Dialogue: 0,0:06:24.81,0:06:28.25,Default,,0,0,0,,Менің ойымша, бұл әнде «жұмбақ» болғаны дұрыс.
Dialogue: 0,0:06:28.25,0:06:30.19,Default,,0,0,0,,<Күдік...? ＞
Dialogue: 0,0:06:30.19,0:06:34.19,Default,,0,0,0,,<Әр адам өз қиындықтарымен бетпе-бет келетін күндер басталады>
Dialogue: 0,0:06:39.59,0:06:42.50,Default,,0,0,0,,♬～
Dialogue: 0,0:06:42.50,0:06:47.94,Default,,0,0,0,,<Иә? Мен... неге...>
Dialogue: 0,0:06:47.94,0:06:51.94,Default,,0,0,0,,Ах... Аоно-кун.
Dialogue: 0,0:06:57.61,0:07:03.62,Default,,0,0,0,,<Мен... Мен... Қандай арман! ＞
Dialogue: 0,0:07:05.22,0:07:08.89,Default,,0,0,0,,<Әдетте, мен армандарды бірден ұмытатынмын➡
Dialogue: 0,0:07:08.89,0:07:11.79,Default,,0,0,0,,Ұмытуға тырысқан сайын...＞
Dialogue: 0,0:07:11.79,0:07:14.36,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:14.36,0:07:18.37,Default,,0,0,0,,Еске алу Менің ойымша, бұл әнде ``жұмбақ'' болғаны дұрыс.
Dialogue: 0,0:07:20.74,0:07:25.57,Default,,0,0,0,,<Көрсетілген сөздердің бәрі толғандырады...➡
Dialogue: 0,0:07:25.57,0:07:29.91,Default,,0,0,0,,Олардың барлығы менде жоқ нәрселер еді. ➡
Dialogue: 0,0:07:29.91,0:07:32.71,Default,,0,0,0,,Жыныстық тартымдылық деген ұғым жоқ...>
Dialogue: 0,0:07:34.38,0:07:39.09,Default,,0,0,0,,<Аоно-кун, саған ұнайтын қыз бар ма екен...>
Dialogue: 0,0:07:40.92,0:07:43.83,Default,,0,0,0,,<Бүгін маған не болды>
Dialogue: 0,0:07:43.83,0:07:46.39,Default,,0,0,0,,Менде бірдеңе дұрыс емес!
Dialogue: 0,0:07:46.39,0:07:49.90,Default,,0,0,0,,Өйткені жаттығу кезінде маған сымбаттырақ болу керектігі айтылды~➡
Dialogue: 0,0:07:49.90,0:07:53.77,Default,,0,0,0,,«Мүмкін мен сыныпты емес шығармын?» десең. ➡
Dialogue: 0,0:07:53.77,0:07:57.11,Default,,0,0,0,,Аононың жігіті "Иә" деді! Бұл шынымен тітіркендіргіш!
Dialogue: 0,0:07:57.11,0:07:59.61,Default,,0,0,0,,Аоно-кун да бұған мән бермейді.
Dialogue: 0,0:07:59.61,0:08:02.04,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:02.04,0:08:07.22,Default,,0,0,0,,Ойланып қалдым, бұл әңгіме оркестр сияқты емес пе?
Dialogue: 0,0:08:07.22,0:08:10.12,Default,,0,0,0,,Не? Екі дұшпандық нәсіл➡
Dialogue: 0,0:08:10.12,0:08:12.89,Default,,0,0,0,,Ішекті аспап пен үрмелі аспап сияқты.
Dialogue: 0,0:08:12.89,0:08:15.12,Default,,0,0,0,,Аха….
Dialogue: 0,0:08:15.12,0:08:18.56,Default,,0,0,0,,Басты кейіпкерлер Самсон батыр мен сұлу Делила.
Dialogue: 0,0:08:18.56,0:08:22.43,Default,,0,0,0,,Бұл екеуі оркестрдегі кімге сәйкес келеді деп ойлайсыңдар?
Dialogue: 0,0:08:22.43,0:08:28.24,Default,,0,0,0,,Ммм... Қызық, Самсон Аоно-кун ма әлде басқасы ма?
Dialogue: 0,0:08:28.24,0:08:31.24,Default,,0,0,0,,Оны тіпті «батыр» деп те атаған...
Dialogue: 0,0:08:31.24,0:08:34.11,Default,,0,0,0,,Сонда Делила Тоғане-сенпай!
Dialogue: 0,0:08:34.11,0:08:38.25,Default,,0,0,0,,Ерік-жігері күшті келбет бейнеге тамаша сәйкес келеді!
Dialogue: 0,0:08:38.25,0:08:41.75,Default,,0,0,0,,<«Самсон мен Делила» операсы. ➡
Dialogue: 0,0:08:41.75,0:08:46.09,Default,,0,0,0,,Жауының, Самсонның, Делиланың әлсіз жақтарын ашу үшін➡
Dialogue: 0,0:08:46.09,0:08:48.76,Default,,0,0,0,,«Мен сені сүйемін» деп өтірік айт. ➡
Dialogue: 0,0:08:48.76,0:08:51.66,Default,,0,0,0,,Самсон Делиланың сүйкімділігіне алданып қалды➡
Dialogue: 0,0:08:51.66,0:08:57.17,Default,,0,0,0,,Әлсіздігің білініп, күшіңнен айырылып, жаудың қолына түсесің>
Dialogue: 0,0:08:58.93,0:09:00.87,Default,,0,0,0,,<Аоно-кун➡
Dialogue: 0,0:09:00.87,0:09:03.20,Default,,0,0,0,,Біреу «Мен сені сүйемін» дегенде➡
Dialogue: 0,0:09:03.20,0:09:05.87,Default,,0,0,0,,Маған бұл қалай әсер етеді...＞
Dialogue: 0,0:09:05.87,0:09:09.21,Default,,0,0,0,,Акине! не?
Dialogue: 0,0:09:09.21,0:09:13.08,Default,,0,0,0,,Менің бір оқиғам бар. Не? Жарайды.
Dialogue: 0,0:09:13.08,0:09:16.08,Default,,0,0,0,,Оған көмектесу мүмкін емес...
Dialogue: 0,0:09:16.08,0:09:19.85,Default,,0,0,0,,Бір минут күтіңіз. Иә.
Dialogue: 0,0:09:19.85,0:09:22.56,Default,,0,0,0,,Кешіріңіз, Косакура-сан.
Dialogue: 0,0:09:22.56,0:09:25.23,Default,,0,0,0,,Ах... иә...
Dialogue: 0,0:09:25.23,0:09:44.38,Default,,0,0,0,,♬～
Dialogue: 0,0:09:44.38,0:09:47.92,Default,,0,0,0,,Сонда кездескенше. аа.
Dialogue: 0,0:09:47.92,0:09:51.39,Default,,0,0,0,,Кешіріңіз, кешіріңіз! Мен сені күтуге мәжбүр еттім.
Dialogue: 0,0:09:51.39,0:09:54.09,Default,,0,0,0,,Риччан. иә?
Dialogue: 0,0:09:54.09,0:09:57.93,Default,,0,0,0,,А... сен Аоно-кунмен не туралы сөйлестің?
Dialogue: 0,0:09:57.93,0:10:03.60,Default,,0,0,0,,А... иә. Бұл үлкен мәселе емес.
Dialogue: 0,0:10:03.60,0:10:06.50,Default,,0,0,0,,Мен... көремін...
Dialogue: 0,0:10:06.50,0:10:09.77,Default,,0,0,0,,Кешіріңіз, мен алдымен жаттығуға барамын.
Dialogue: 0,0:10:09.77,0:10:11.71,Default,,0,0,0,,Неге дүкен сатушысынан сұрамайсыз?
Dialogue: 0,0:10:11.71,0:10:18.41,Default,,0,0,0,,<Бұл сезім... қызғаныш шығар>
Dialogue: 0,0:10:18.41,0:10:28.42,Default,,0,0,0,,♬～
Dialogue: 0,0:10:28.42,0:10:32.63,Default,,0,0,0,,<Рикчан, маған айтқаныңды қалаймын>
Dialogue: 0,0:10:34.80,0:10:37.70,Default,,0,0,0,,<Мен үшін Делила...>
Dialogue: 0,0:10:37.70,0:10:40.44,Default,,0,0,0,,♬～
Dialogue: 0,0:10:40.44,0:10:45.74,Default,,0,0,0,,<Рикчан Аоно-кун туралы не ойлайды...? ＞
Dialogue: 0,0:10:48.14,0:10:51.65,Default,,0,0,0,,<Жоқ... Мен шоғырлана алмаймын...>
Dialogue: 0,0:10:53.31,0:10:58.45,Default,,0,0,0,,⚟ (Мария Тайра) Ах! Сондай-ақ, неге? ➡
Dialogue: 0,0:10:58.45,0:11:02.92,Default,,0,0,0,,Бірінші дыбыс Оны әсерлі етіңіз... Ұзағырақ тыныс алыңыз... ➡
Dialogue: 0,0:11:02.92,0:11:07.76,Default,,0,0,0,,Жеке ән болғандықтан, мен әнге көбірек эмоция саламын... ➡
Dialogue: 0,0:11:07.76,0:11:11.27,Default,,0,0,0,,Сезімдер Сезімдер Өз сезімдеріңіз туралы көбірек ойланыңыз...
Dialogue: 0,0:11:11.27,0:11:14.77,Default,,0,0,0,,Тайра-сенпай... жақсысың ба?
Dialogue: 0,0:11:14.77,0:11:19.27,Default,,0,0,0,,А... не? Жақсы….
Dialogue: 0,0:11:19.27,0:11:24.61,Default,,0,0,0,,Ой...! Мүмкін менің дауысым шығып тұрған шығар? иә….
Dialogue: 0,0:11:24.61,0:11:27.42,Default,,0,0,0,,Уау, бұл ұят!
Dialogue: 0,0:11:27.42,0:11:32.12,Default,,0,0,0,,Мен қалағандай ойнай алмадым, мен аздап қобалжыдым...
Dialogue: 0,0:11:32.12,0:11:35.42,Default,,0,0,0,,Бұны Тайра-сенпай салды ма? ?
Dialogue: 0,0:11:35.42,0:11:38.29,Default,,0,0,0,,Керемет жұмыс! Иә.
Dialogue: 0,0:11:38.29,0:11:42.96,Default,,0,0,0,,Себебі мен сурет салғанды ​​ұнатамын. Мен бір нәрсені ұға аламын ба деп ойлаймын ...
Dialogue: 0,0:11:42.96,0:11:45.00,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:45.00,0:11:48.84,Default,,0,0,0,,Сіз Делиланың сезімін түсінесіз бе, Козакура мырза? иә?
Dialogue: 0,0:11:48.84,0:11:51.97,Default,,0,0,0,,Менің мұғалімім жеке менің жаттығуымды бақылауды тапсырды➡
Dialogue: 0,0:11:51.97,0:11:56.68,Default,,0,0,0,,«Сен Делиланың сезімін түсінбейсің»!
Dialogue: 0,0:11:58.45,0:12:01.45,Default,,0,0,0,,Бұл қиын, солай емес пе? ➡
Dialogue: 0,0:12:01.45,0:12:05.59,Default,,0,0,0,,Мен де...білмеймін. Делила туралы...
Dialogue: 0,0:12:05.59,0:12:08.39,Default,,0,0,0,,Дұрыс! ? Ол Далилаға ұқсайды!
Dialogue: 0,0:12:08.39,0:12:11.59,Default,,0,0,0,,Иә! ? Қандай жолмен! ?
Dialogue: 0,0:12:11.59,0:12:14.93,Default,,0,0,0,,Хаа сен оны білмейсің бе?
Dialogue: 0,0:12:14.93,0:12:19.77,Default,,0,0,0,,Қараңызшы, бұл ән өтірік болса да, ер мен әйелдің махаббаты туралы емес пе? ➡
Dialogue: 0,0:12:19.77,0:12:24.64,Default,,0,0,0,,Сондықтан мен Козакура-сан әндерінде өмірден алған әсерлерін қолдана ма деп ойладым.
Dialogue: 0,0:12:24.64,0:12:29.41,Default,,0,0,0,,Уау... Менде мұндай махаббат тәжірибесі жоқ.
Dialogue: 0,0:12:29.41,0:12:34.92,Default,,0,0,0,,Иә? Шынымен бе? Оны жасырудың қажеті жоқ.
Dialogue: 0,0:12:36.62,0:12:40.79,Default,,0,0,0,,Сізге ұнайды, солай ма? Аоно-кун туралы.
Dialogue: 0,0:12:40.79,0:12:43.09,Default,,0,0,0,,Кира өте икемсіз ғой, иә?
Dialogue: 0,0:12:46.59,0:12:50.43,Default,,0,0,0,,<Тайра-сенпай, қайдан білдің... ➡
Dialogue: 0,0:12:50.43,0:12:56.14,Default,,0,0,0,,Дәлірек айтсақ, менің Аоно-кунды ұнататынымды бәрі біледі...? ➡
Dialogue: 0,0:12:56.14,0:13:00.74,Default,,0,0,0,,Мен не істеуім керек? Мен уайымдай бастадым... ➡
Dialogue: 0,0:13:00.74,0:13:04.08,Default,,0,0,0,,Тайра-сенпайдан тексеруім керек...! ＞
Dialogue: 0,0:13:04.08,0:13:07.92,Default,,0,0,0,,Мария Қайырлы таң. қайырлы таң.
Dialogue: 0,0:13:07.92,0:13:11.39,Default,,0,0,0,,А... у... Қайырлы таң~ Хару! Риччан!
Dialogue: 0,0:13:11.39,0:13:15.26,Default,,0,0,0,,Тыңда~ Мен бүгін түскі қорапшамды ұмытып кетіппін~.
Dialogue: 0,0:13:15.26,0:13:17.26,Default,,0,0,0,,<Мүмкін...➡
Dialogue: 0,0:13:17.26,0:13:19.76,Default,,0,0,0,,Риччан да оны байқайды ма...? ＞
Dialogue: 0,0:13:19.76,0:13:22.10,Default,,0,0,0,,Ендеше мен бүгін дүкен аралауға барамын... <Рикчан деген не➡
Dialogue: 0,0:13:22.10,0:13:24.40,Default,,0,0,0,,Мен ыңғайсыз болғым келмейді...> Хару, алдымен кешкі ас іш.
Dialogue: 0,0:13:24.40,0:13:27.30,Default,,0,0,0,,Жоқ <Мен сенің білгеніңді қаламаймын>
Dialogue: 0,0:13:27.30,0:13:30.20,Default,,0,0,0,,Мен сені күтемін, ендеше бірге тамақтанайық.
Dialogue: 0,0:13:30.20,0:13:33.41,Default,,0,0,0,,<Мен бұзғым келмейді. ➡
Dialogue: 0,0:13:33.41,0:13:37.78,Default,,0,0,0,,Себебі Делиланың жауы Самсон оның шынайы сезімдерін білмейді➡
Dialogue: 0,0:13:37.78,0:13:41.28,Default,,0,0,0,,Бетперде киіп, өтірік сыбырлау. ➡
Dialogue: 0,0:13:41.28,0:13:47.42,Default,,0,0,0,,Делила керемет... Ешкім білмей өтірік айт...>
Dialogue: 0,0:13:47.42,0:13:49.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:49.36,0:13:53.36,Default,,0,0,0,,<Біріншіден, Делила өтірік айтты...>
Dialogue: 0,0:13:56.46,0:13:59.97,Default,,0,0,0,,<Иә. Делиламен де солай болатынына сенімдімін. ➡
Dialogue: 0,0:13:59.97,0:14:04.97,Default,,0,0,0,,Мүмкін ол Самсон оның сырын біледі деп қорықты.＞
Dialogue: 0,0:14:06.77,0:14:11.58,Default,,0,0,0,,<Егер құпия шықса, өлтіресің... ➡
Dialogue: 0,0:14:11.58,0:14:14.62,Default,,0,0,0,,Жауға түсіп, өлімім ➡
Dialogue: 0,0:14:14.62,0:14:19.92,Default,,0,0,0,,Көпшіліктің көз алдында қалудан қорқу>
Dialogue: 0,0:14:19.92,0:14:27.66,Default,,0,0,0,,♬～
Dialogue: 0,0:14:27.66,0:14:30.37,Default,,0,0,0,,Бұл жиіркенішті...
Dialogue: 0,0:14:33.40,0:14:35.34,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:14:35.34,0:14:37.77,Default,,0,0,0,,Козакура мырза. Ах.
Dialogue: 0,0:14:37.77,0:14:39.71,Default,,0,0,0,,Мачий-сенпай?
Dialogue: 0,0:14:39.71,0:14:43.64,Default,,0,0,0,,Сіз емтиханға оқып жатырсыз ба? Иә. Жақында сынақ емтиханы болады➡
Dialogue: 0,0:14:43.64,0:14:47.12,Default,,0,0,0,,Менің көңіл-күйімді көтеру керек. Бұл қиын...
Dialogue: 0,0:14:47.12,0:14:50.02,Default,,0,0,0,,<Оқуыңа кедергі жасама...>
Dialogue: 0,0:14:50.02,0:14:54.86,Default,,0,0,0,,А... онда бұл мен үшін. Мен қазір кішкене үзіліс жасаймын.
Dialogue: 0,0:14:54.86,0:14:57.86,Default,,0,0,0,,Осы күндері үйірме жұмыстары қалай өтуде?
Dialogue: 0,0:15:00.36,0:15:03.90,Default,,0,0,0,,Мен қандай әнді ойнайтынымды анықтауда біраз қиналып жүрмін...
Dialogue: 0,0:15:03.90,0:15:07.07,Default,,0,0,0,,«Бакканал».
Dialogue: 0,0:15:07.07,0:15:09.77,Default,,0,0,0,,Мачи мырза өнер көрсетті ме?
Dialogue: 0,0:15:09.77,0:15:12.91,Default,,0,0,0,,Жоқ.Бірақ мен мазмұнын білемін.
Dialogue: 0,0:15:12.91,0:15:17.78,Default,,0,0,0,,Тұрақты қойылымда үрмелі аспаптардың ойнағанын көру қызықты болар деп ойладым.
Dialogue: 0,0:15:17.78,0:15:21.25,Default,,0,0,0,,Маған бұл Делила қатты ұнайды.
Dialogue: 0,0:15:21.25,0:15:24.92,Default,,0,0,0,,Сұлулығыңызды, өтірігіңізді ер адамдарды алдау үшін пайдаланыңыз.
Dialogue: 0,0:15:24.92,0:15:28.59,Default,,0,0,0,,Бұл шынымен әйел тыңшыға ұқсайды, бұл керемет.
Dialogue: 0,0:15:28.59,0:15:31.93,Default,,0,0,0,,Ал еркек пен әйелдің махаббаты да қатысады➡
Dialogue: 0,0:15:31.93,0:15:36.60,Default,,0,0,0,,Мен Козакура-санның бұл әнді қалай ойнайтынын асыға күтетін шығармын.
Dialogue: 0,0:15:36.60,0:15:42.10,Default,,0,0,0,,<Ойлап қарасам, Мәшій-сенпай да біледі... ➡
Dialogue: 0,0:15:42.10,0:15:47.41,Default,,0,0,0,,Мачий-сенпайдың ешкімге айтпасқа амалы жоқ...? ➡
Dialogue: 0,0:15:47.41,0:15:51.28,Default,,0,0,0,,Маған ұнамайды. Мен не ойлап отырмын...＞
Dialogue: 0,0:15:51.28,0:15:53.61,Default,,0,0,0,,Ойланып қарашы, Козакура-сан➡
Dialogue: 0,0:15:53.61,0:15:57.12,Default,,0,0,0,,Бұл күндері Аоно-кунның жағдайы қалай?
Dialogue: 0,0:15:59.79,0:16:04.06,Default,,0,0,0,,А... бұл! Қазір шынымен де кеш...
Dialogue: 0,0:16:04.06,0:16:06.96,Default,,0,0,0,,<Тоқта... Тоқта. ➡
Dialogue: 0,0:16:06.96,0:16:10.73,Default,,0,0,0,,Сіз ағаңыздың ондай адам емес екенін білесіз бе? ➡
Dialogue: 0,0:16:10.73,0:16:13.37,Default,,0,0,0,,Білсем де...>
Dialogue: 0,0:16:13.37,0:16:20.07,Default,,0,0,0,,Мачий-сенпай маған ұнайтын адам бар екенін қайдан білді?
Dialogue: 0,0:16:20.07,0:16:24.25,Default,,0,0,0,,Мм... Мен Козакура-санға қарап тұрғанымда бірдеңені сездім. ➡
Dialogue: 0,0:16:24.25,0:16:27.08,Default,,0,0,0,,Немесе…➡
Dialogue: 0,0:16:27.08,0:16:30.12,Default,,0,0,0,,Мүмкін маған ұқсағандықтан ба?
Dialogue: 0,0:16:30.12,0:16:32.39,Default,,0,0,0,,Олар бір-біріне ұқсайды...?
Dialogue: 0,0:16:32.39,0:16:35.29,Default,,0,0,0,,Бұл менімен сәйкес келеді...
Dialogue: 0,0:16:35.29,0:16:39.93,Default,,0,0,0,,Иә, жарайды! Мен Козакура-санға айтамын!
Dialogue: 0,0:16:39.93,0:16:44.23,Default,,0,0,0,,Негізі оркестрде маған ұнайтын адам бар.
Dialogue: 0,0:16:45.80,0:16:49.10,Default,,0,0,0,,Иә! Эх!
Dialogue: 0,0:16:50.94,0:16:54.28,Default,,0,0,0,,Уайымдама, мен ешкімге айтқан жоқпын.
Dialogue: 0,0:16:54.28,0:16:58.95,Default,,0,0,0,,Негізі мен Козакура-санның жазғы демалыс алдында Аоно-кунмен бірге үйге қайтып бара жатқанын көрдім.
Dialogue: 0,0:16:58.95,0:17:03.22,Default,,0,0,0,,Иә! ? Қарашы, екеуміз де қолшатыр алып жүрдік, солай ма?
Dialogue: 0,0:17:03.22,0:17:07.22,Default,,0,0,0,,Е! Бұл екеуі кездесіп жүрген шығар! ?
Dialogue: 0,0:17:07.22,0:17:09.99,Default,,0,0,0,,Кя! Оны жайына қалдырайық.
Dialogue: 0,0:17:09.99,0:17:13.73,Default,,0,0,0,,Тайраның айтқаны дұрыс па деп едім➡
Dialogue: 0,0:17:13.73,0:17:17.23,Default,,0,0,0,,Мен Козакура-санға қарап отырып, әйтеуір бір нәрсені байқадым.
Dialogue: 0,0:17:17.23,0:17:21.10,Default,,0,0,0,,А... Козакура мырза...?
Dialogue: 0,0:17:21.10,0:17:26.67,Default,,0,0,0,,<Мачий-сенпай, сізге күмәнданғаным үшін кешіріңіз. ➡
Dialogue: 0,0:17:26.67,0:17:32.18,Default,,0,0,0,,Мен... Мен ағамның маған сенім артқанына қуандым.＞
Dialogue: 0,0:17:32.18,0:17:37.02,Default,,0,0,0,,♬～
Dialogue: 0,0:17:37.02,0:17:39.95,Default,,0,0,0,,Бұл екеуміздің арамыздағы құпия.
Dialogue: 0,0:17:39.95,0:17:44.39,Default,,0,0,0,,＜Менің ағам осылай деді де, сәл күдіктене күлді➡
Dialogue: 0,0:17:44.39,0:17:47.93,Default,,0,0,0,,Бір жерде бұл Делиламен қабаттасатын сияқты. ➡
Dialogue: 0,0:17:47.93,0:17:54.27,Default,,0,0,0,,Бұл біртүрлі. Дәл қазір қатты қобалжысам да, аяғым жеңілдеп тұр. ➡
Dialogue: 0,0:17:54.27,0:17:57.61,Default,,0,0,0,,Делила күшті және мінсіз әйел емес➡
Dialogue: 0,0:17:57.61,0:18:00.51,Default,,0,0,0,,Мүмкін сен де мен сияқтысың...➡
Dialogue: 0,0:18:00.51,0:18:05.71,Default,,0,0,0,,Сырыңыз ашылғалы тұрғандықтан мазасыздану немесе қобалжу➡
Dialogue: 0,0:18:05.71,0:18:09.55,Default,,0,0,0,,Мүмкін ол да сондай қарапайым қыз шығар. ➡
Dialogue: 0,0:18:09.55,0:18:13.35,Default,,0,0,0,,Мүмкін? ➡
Dialogue: 0,0:18:13.35,0:18:16.36,Default,,0,0,0,,Жақсы＞
Dialogue: 0,0:18:18.06,0:18:31.24,Default,,0,0,0,,♬～(скрипка)
Dialogue: 0,0:18:31.24,0:19:09.74,Default,,0,0,0,,♬～
Dialogue: 0,0:19:13.71,0:19:18.05,Default,,0,0,0,,Жақсы! Мен оны қолға алған сияқтымын.
Dialogue: 0,0:19:18.05,0:19:19.99,Default,,0,0,0,,Хатори-сенпай!
Dialogue: 0,0:19:19.99,0:19:24.83,Default,,0,0,0,,Ұзақ уақытқа созылған дәм немесе күдікті атмосфера болуы жақсы емес пе?
Dialogue: 0,0:19:24.83,0:19:26.76,Default,,0,0,0,,Шынымен! ?
Dialogue: 0,0:19:26.76,0:19:29.56,Default,,0,0,0,,Ойын кезінде байқаған нәрсе бар ма?
Dialogue: 0,0:19:29.56,0:19:32.47,Default,,0,0,0,,Мен өзімді Делиламен таныстырдым!
Dialogue: 0,0:19:32.47,0:19:37.30,Default,,0,0,0,,Мен Делиланың сезіміне көптен бері алаңдадым, бірақ солай болса, мен мұны істегенім жөн➡
Dialogue: 0,0:19:37.30,0:19:41.18,Default,,0,0,0,,Егер сіз болсаңыз, не істер едіңіз туралы ойланыңыз.
Dialogue: 0,0:19:41.18,0:19:44.91,Default,,0,0,0,,<Мен кенет тым көп сөйлеп кеттім.>
Dialogue: 0,0:19:44.91,0:19:48.62,Default,,0,0,0,,Бұл жақсы. Сонымен?
Dialogue: 0,0:19:50.79,0:19:55.26,Default,,0,0,0,,«Күдік» сырға ие болудан туады... ➡
Dialogue: 0,0:19:55.26,0:19:59.59,Default,,0,0,0,,Мен көремін. Құпиялар «жамандық» емес екені рас➡
Dialogue: 0,0:19:59.59,0:20:04.10,Default,,0,0,0,,Қызық, Делиланың өзі өтірік айту керек деп қынжылды ма?➡
Dialogue: 0,0:20:04.10,0:20:07.00,Default,,0,0,0,,Бұл менің қиялымды жаулап алды!
Dialogue: 0,0:20:07.00,0:20:11.27,Default,,0,0,0,,Сондай-ақ «құпияны сақтаудың мұңын» білдіреді... ➡
Dialogue: 0,0:20:11.27,0:20:13.94,Default,,0,0,0,,Козакура сияқты болу жақсы. ➡
Dialogue: 0,0:20:13.94,0:20:16.84,Default,,0,0,0,,үшінна айтайық!
Dialogue: 0,0:20:16.84,0:20:21.28,Default,,0,0,0,,<Маңызды емес деп ойлайтын дәрежеге дейін.➡
Dialogue: 0,0:20:21.28,0:20:24.19,Default,,0,0,0,,Мені ойлайтын жалғыз адам - өзім болдым. ➡
Dialogue: 0,0:20:24.19,0:20:29.69,Default,,0,0,0,,Менің көзқарасым бір мезетте кеңейіп кеткендей сезінемін, дәл сол тұман жойылды.＞
Dialogue: 0,0:20:33.29,0:20:35.80,Default,,0,0,0,,Уф... суық.
Dialogue: 0,0:20:35.80,0:20:40.30,Default,,0,0,0,,♬～
Dialogue: 0,0:20:50.81,0:20:52.85,Default,,0,0,0,,Аоно-кун.
Dialogue: 0,0:20:52.85,0:20:56.62,Default,,0,0,0,,Аа, Козакура мырза. Қараңдар, қараңдар. Бүгін толық ай.
Dialogue: 0,0:20:56.62,0:20:58.99,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:58.99,0:21:02.79,Default,,0,0,0,,Сіз бүгін бетіндегі өрнекті жақсы көре аласыз.
Dialogue: 0,0:21:09.60,0:21:13.40,Default,,0,0,0,,Иә? Косакура-сан, не болды?
Dialogue: 0,0:21:13.40,0:21:15.60,Default,,0,0,0,,Уф...!
Dialogue: 0,0:21:17.27,0:21:20.17,Default,,0,0,0,,Жақында жарыс келеді.
Dialogue: 0,0:21:20.17,0:21:24.61,Default,,0,0,0,,Ойлап қарасам, Ямада-кун бүгін жарыстан кейін не болғанын айтып жатыр екен.
Dialogue: 0,0:21:24.61,0:21:28.48,Default,,0,0,0,,«Біткен соң, қанатымды жайып, көңіл көтергім келеді!».
Dialogue: 0,0:21:28.48,0:21:33.62,Default,,0,0,0,,Ямада-кунға ұқсайды. Козакура мырза, сізде ондай нәрсе бар ма?
Dialogue: 0,0:21:33.62,0:21:36.96,Default,,0,0,0,,Мен музыкалық дүкенге барғым келеді деп ойлаймын.
Dialogue: 0,0:21:36.96,0:21:40.29,Default,,0,0,0,,Мен де осы баланы асыраумен айналысқым келеді.
Dialogue: 0,0:21:40.29,0:21:44.80,Default,,0,0,0,,Түсіндім! Мен де жақын арада садағымдағы шашты өзгертуім керек.
Dialogue: 0,0:21:44.80,0:21:48.30,Default,,0,0,0,,Негізі жарыс алдында барғым келеді.
Dialogue: 0,0:21:48.30,0:21:51.14,Default,,0,0,0,,Еске алу Оны құпия сақтаған дұрыс, бірақ...➡
Dialogue: 0,0:21:51.14,0:21:55.84,Default,,0,0,0,,Бірақ біз бір күні қозғалуымыз керек.
Dialogue: 0,0:21:57.44,0:22:00.92,Default,,0,0,0,,Жоқ... Мен сенімен бармаймын! ? сурет?
Dialogue: 0,0:22:00.92,0:22:05.25,Default,,0,0,0,,Мазасыздық болмаса, Аоно-кун баратын музыкалық дүкен болуы мүмкін➡
Dialogue: 0,0:22:05.25,0:22:08.26,Default,,0,0,0,,Маған көп нәрсені айтқым келеді, дәлірек айтсақ...
Dialogue: 0,0:22:08.26,0:22:10.39,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:22:10.39,0:22:13.89,Default,,0,0,0,,Олай болса, Ямада-кунмен және басқалармен сөйлесейік.
Dialogue: 0,0:22:16.26,0:22:19.60,Default,,0,0,0,,Жазғы фестивальге тағы да мүше бола аламын ба деп ойлаймын.
Dialogue: 0,0:22:19.60,0:22:22.50,Default,,0,0,0,,Саэки қайтадан көңілді жүрген сияқты.
Dialogue: 0,0:22:22.50,0:22:24.81,Default,,0,0,0,,О!
Dialogue: 0,0:22:28.61,0:22:31.91,Default,,0,0,0,,Біз бірге барамыз ба?
Dialogue: 0,0:22:36.78,0:22:41.66,Default,,0,0,0,,А... м... екі адам?
Dialogue: 0,0:22:41.66,0:22:46.43,Default,,0,0,0,,Екі адам... Иә...
Dialogue: 0,0:22:46.43,0:22:48.73,Default,,0,0,0,,​​Түсіндім.
Dialogue: 0,0:22:51.27,0:22:58.97,Default,,0,0,0,,♬～
Dialogue: 0,0:22:58.97,0:23:04.78,Default,,0,0,0,,<Мен Делиланың сезімін сәл ғана түсінгендей болдым. ➡
Dialogue: 0,0:23:04.78,0:23:08.98,Default,,0,0,0,,Бұл екеуміздің арамыздағы құпия＞
Dialogue: 0,0:23:10.62,0:23:19.09,Default,,0,0,0,,♬～
Dialogue: 0,0:23:19.09,0:23:22.96,Default,,0,0,0,,♬ «Мен оны сізден алдым».
Dialogue: 0,0:23:22.96,0:23:28.80,Default,,0,0,0,,♬ «Сәйкес келетін жоғары жиілік кілті бар салпыншақ»
Dialogue: 0,0:23:28.80,0:23:34.64,Default,,0,0,0,,♬ «Мен оны жоғалттым және сені енді көре алмаймын».
Dialogue: 0,0:23:34.64,0:23:38.41,Default,,0,0,0,,♬ «Ағаштарды сүзіп өткен таңғажайып күн сәулесі»
Dialogue: 0,0:23:38.41,0:23:42.28,Default,,0,0,0,,♬ «Мен ешқашан орала алмаймын»
Dialogue: 0,0:23:42.28,0:23:49.42,Default,,0,0,0,,♬ "Мен өткенді жек көремін. Метроном, тоқтама".
Dialogue: 0,0:23:49.42,0:23:56.13,Default,,0,0,0,,♬ «Маған уақыт машинасы қажет емес».
Dialogue: 0,0:23:56.13,0:24:03.87,Default,,0,0,0,,♬ «Бірақ, мен сені сол кезде кездестірсем.»
Dialogue: 0,0:24:03.87,0:24:13.25,Default,,0,0,0,,♬ «Жарайды, жақсы, жұлдыздардың сиқыры сізді орап алады»
Dialogue: 0,0:24:13.25,0:24:19.39,Default,,0,0,0,,♬ «Мен саған жарық болғым келеді».
Dialogue: 0,0:24:19.39,0:24:28.40,Default,,0,0,0,,♬ «Жарайды, жарайды, өтінемін, уақыттың сиқыры».
Dialogue: 0,0:24:28.40,0:24:36.10,Default,,0,0,0,,♬ «Мен сенімен мәңгі бірге болғым келеді».
Dialogue: 0,0:25:01.23,0:25:01.33,Default,,0,0,0,,♬～
