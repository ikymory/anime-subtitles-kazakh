Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.09,0:00:17.79,Default,,0,0,0,,Саму….
Dialogue: 0,0:00:26.61,0:00:29.81,Default,,0,0,0,,<Германиядағы бір қала қазір➡
Dialogue: 0,0:00:29.81,0:00:33.01,Default,,0,0,0,,Мұның бәрі Рождество туралы болуы керек...>
Dialogue: 0,0:00:35.11,0:00:55.41,Default,,0,0,0,,♬〜
Dialogue: 0,0:00:57.94,0:01:11.49,Default,,0,0,0,,♬〜
Dialogue: 0,0:01:11.49,0:01:15.06,Default,,0,0,0,,♬ «Өзім жылтыратып жүрген біртүрлі етік».
Dialogue: 0,0:01:15.06,0:01:19.93,Default,,0,0,0,,♬ «Мен көпшілік арасында бұрмаланған болып көріндім.»
Dialogue: 0,0:01:19.93,0:01:23.57,Default,,0,0,0,,♬ «Мен жүзіп жүрдім».
Dialogue: 0,0:01:23.57,0:01:29.78,Default,,0,0,0,,♬ "Талантты бимен иілемін. Ебедейсіз қозғаламын".
Dialogue: 0,0:01:29.78,0:01:34.92,Default,,0,0,0,,♬ «Күліп, тісін көрсеткен Амадей түсінбейді».
Dialogue: 0,0:01:34.92,0:01:41.29,Default,,0,0,0,,♬ «Бір жерден біреудің дауысы естіледі»
Dialogue: 0,0:01:41.29,0:01:47.79,Default,,0,0,0,,♬ «Мен сияқты бұрмаланған және жалғыз ән»
Dialogue: 0,0:01:47.79,0:01:52.30,Default,,0,0,0,,♬ «Лорелей әуенді жоғалтқаннан кейін импровизация жасайды»
Dialogue: 0,0:01:52.30,0:01:55.20,Default,,0,0,0,,♬ «Бахтың қорапта ойнауы»
Dialogue: 0,0:01:55.20,0:01:59.74,Default,,0,0,0,,♬ «Жоғары көтерілген сахнада билеу».
Dialogue: 0,0:01:59.74,0:02:04.05,Default,,0,0,0,,♬ «Түні бойы таусылатын сияқтымыз».
Dialogue: 0,0:02:04.05,0:02:11.55,Default,,0,0,0,,♬ «Мен басқа ештеңе көрмеген әдемі көздерде».
Dialogue: 0,0:02:11.55,0:02:16.39,Default,,0,0,0,,♬ «Мен қалай көрінемін?»
Dialogue: 0,0:02:16.39,0:02:23.39,Default,,0,0,0,,♬〜
Dialogue: 0,0:02:31.27,0:02:35.14,Default,,0,0,0,,Бүгін суықта шыққандарыңызға рахмет.
Dialogue: 0,0:02:35.14,0:02:42.42,Default,,0,0,0,,Ұйымдастырушылардың бірі ретінде мен барлығының ән айтып, ойнауынан ләззат алғым келеді.
Dialogue: 0,0:02:42.42,0:02:46.29,Default,,0,0,0,,Бұл менің ағам пастор болып табылатын шіркеу.
Dialogue: 0,0:02:46.29,0:02:50.30,Default,,0,0,0,,Ол маған арнайы рұқсат берді, бірақ ол маған рұқсат берді.
Dialogue: 0,0:02:50.30,0:02:53.43,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:02:53.43,0:02:56.33,Default,,0,0,0,,Сіздердің беттеріңіз қатал ма?
Dialogue: 0,0:02:56.33,0:03:00.20,Default,,0,0,0,,Бүгін күліп, көңіл көтеруді ұмытпаңыз!
Dialogue: 0,0:03:00.20,0:03:02.74,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:02.74,0:03:08.25,Default,,0,0,0,,♬〜
Dialogue: 0,0:03:08.25,0:03:18.45,Default,,0,0,0,,♬〜
Dialogue: 0,0:03:22.39,0:03:33.89,Default,,0,0,0,,(Дауыстық жаттығу)
Dialogue: 0,0:03:35.94,0:03:42.94,Default,,0,0,0,,(Дауыстық жаттығу)
Dialogue: 0,0:03:46.29,0:03:52.59,Default,,0,0,0,,<Уау... Дыбыс әдеттегіден әлдеқайда қаттырақ... ➡
Dialogue: 0,0:03:52.59,0:03:59.39,Default,,0,0,0,,Түсінемін... Кең және төбесі биік, сондықтан дыбыс оңай шағылысады.
Dialogue: 0,0:04:01.73,0:04:04.74,Default,,0,0,0,,<Мүмкін бұл шіркеу шығар➡
Dialogue: 0,0:04:04.74,0:04:08.54,Default,,0,0,0,,Мүмкін бұл ойнауға ең жақсы орын шығар...＞
Dialogue: 0,0:04:10.44,0:04:13.24,Default,,0,0,0,,Спектакль жақында басталады.
Dialogue: 0,0:04:15.28,0:04:17.78,Default,,0,0,0,,Кіреберіс сол жақта.
Dialogue: 0,0:04:19.55,0:04:21.49,Default,,0,0,0,,Цукаса Акине) <Соңында...>
Dialogue: 0,0:04:21.49,0:04:24.89,Default,,0,0,0,,Көптен күткен концертке алғаш рет қатысуда!
Dialogue: 0,0:04:24.89,0:04:26.83,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:04:26.83,0:04:30.40,Default,,0,0,0,,<Дәлірек айтсақ, мұндай концерттің өзі➡
Dialogue: 0,0:04:30.40,0:04:34.27,Default,,0,0,0,,Бірінші рет... Мен қобалжыдым...＞
Dialogue: 0,0:04:34.27,0:04:39.57,Default,,0,0,0,,Сәлем! Ертең қалай киінуім керек? ? Бұл сөзсіз формальды! ?
Dialogue: 0,0:04:39.57,0:04:42.48,Default,,0,0,0,,Қалыпты болыңыз. Тек қалыпты болыңыз.
Dialogue: 0,0:04:42.48,0:04:45.92,Default,,0,0,0,,Айтайын дегенім, ертең жақсы болатыныңызға сенімдісіз бе?
Dialogue: 0,0:04:45.92,0:04:48.95,Default,,0,0,0,,Сіз қазір жұмыспен айналысасыз ба? Келуге мәжбүрлемесең де...
Dialogue: 0,0:04:48.95,0:04:51.09,Default,,0,0,0,,О...!
Dialogue: 0,0:04:51.09,0:04:55.92,Default,,0,0,0,,Мен барамын, өйткені барғым келеді! Мені қате түсінбеңіз.
Dialogue: 0,0:04:55.92,0:05:00.76,Default,,0,0,0,,♬〜
Dialogue: 0,0:05:00.76,0:05:03.96,Default,,0,0,0,,<Рицукомен кейінірек кездесе аламын ба деп ойлаймын~>
Dialogue: 0,0:05:10.87,0:05:14.67,Default,,0,0,0,,Бұл жер бос па? (Аононың анасы) Иә.
Dialogue: 0,0:05:20.05,0:05:22.95,Default,,0,0,0,,Шихори Хонго) Бүгін Рождестволық концерт ➡
Dialogue: 0,0:05:22.95,0:05:26.26,Default,,0,0,0,,Келгендеріңізге рахмет.
Dialogue: 0,0:05:26.26,0:05:32.13,Default,,0,0,0,,Бүгін біз Каймаку орта мектебінің хор және оркестр мүшелеріміз➡
Dialogue: 0,0:05:32.13,0:05:34.97,Default,,0,0,0,,Біз сізге әндер мен спектакльдер жібереміз. ➡
Dialogue: 0,0:05:34.97,0:05:39.40,Default,,0,0,0,,Біз сізге ең алдымен таныс Рождество әнұранын жібереміз➡
Dialogue: 0,0:05:39.40,0:05:42.07,Default,,0,0,0,,«Моробито Козорит». ➡
Dialogue: 0,0:05:42.07,0:05:46.41,Default,,0,0,0,,Бұл ән Жапонияда да Рождество кезінде жиі естіледі.
Dialogue: 0,0:05:46.41,0:05:48.35,Default,,0,0,0,,<Ол қандай ән? ＞
Dialogue: 0,0:05:48.35,0:05:52.78,Default,,0,0,0,,Түпнұсқа шығармасы неміс композиторы Гендельдің «Мәсіх» шығармасы➡
Dialogue: 0,0:05:52.78,0:05:58.78,Default,,0,0,0,,Оны американдық композитор Лоуэлл Мейсон аранжировкалаған деседі.
Dialogue: 0,0:06:03.86,0:06:08.53,Default,,0,0,0,,үшінна Рождество керемет өтеді деп үміттенемін➡
Dialogue: 0,0:06:08.53,0:06:11.43,Default,,0,0,0,,Дұғамен ән айт.
Dialogue: 0,0:06:11.43,0:06:26.63,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:06:41.40,0:06:47.27,Default,,0,0,0,,♬〜
Dialogue: 0,0:06:47.27,0:06:56.88,Default,,0,0,0,,♬ «Бәріміз фестивальге жиналайық».
Dialogue: 0,0:06:56.88,0:07:02.52,Default,,0,0,0,,♬ «Мен көптен күттім».
Dialogue: 0,0:07:02.52,0:07:08.03,Default,,0,0,0,,♬ «Жаратқан ием берді, Жаратқан ием берді».
Dialogue: 0,0:07:08.03,0:07:13.90,Default,,0,0,0,,♬ «Иеміз жақсы»
Dialogue: 0,0:07:13.90,0:07:23.88,Default,,0,0,0,,♬ «Шайтанды нокаут»
Dialogue: 0,0:07:23.88,0:07:29.55,Default,,0,0,0,,♬ «Тұтқыншы Ханацу»
Dialogue: 0,0:07:29.55,0:07:35.06,Default,,0,0,0,,♬ «Жаратқан Ие берді, Тәңір берді».
Dialogue: 0,0:07:35.06,0:07:41.56,Default,,0,0,0,,♬ «Иеміз жақсы»
Dialogue: 0,0:07:41.56,0:07:51.27,Default,,0,0,0,,♬ «Бейбітшілік ұлыңызға қош келдіңіз»
Dialogue: 0,0:07:51.27,0:07:57.04,Default,,0,0,0,,♬ «Шөміш иесі»
Dialogue: 0,0:07:57.04,0:08:02.72,Default,,0,0,0,,♬ «Мақтау, мақтау!»
Dialogue: 0,0:08:02.72,0:08:11.72,Default,,0,0,0,,♬ «Мақтау, мақтау».
Dialogue: 0,0:08:13.36,0:08:23.74,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:08:23.74,0:08:28.61,Default,,0,0,0,,<Дыбыс жаңғыруда> (2-аудитория) <Құбыр органы да жақсы...>
Dialogue: 0,0:08:28.61,0:08:34.38,Default,,0,0,0,,＜Уау... Дыбыс бүкіл денеңді осылай жаңғыртады...! ➡
Dialogue: 0,0:08:34.38,0:08:38.76,Default,,0,0,0,,Дәлірек айтсақ... бұл шынымен де жоғары сынып оқушыларының хоры...! ? ＞
Dialogue: 0,0:08:38.76,0:08:42.76,Default,,0,0,0,,Бұл жолы хорға оркестр де қатысады. Иә иә.
Dialogue: 0,0:08:42.76,0:08:47.39,Default,,0,0,0,,Оркестр сияқты хор үйірмесі де республикалық деңгейдегі мықты клуб➡
Dialogue: 0,0:08:47.39,0:08:50.77,Default,,0,0,0,,Күтілгендей, бұл өте әсерлі.
Dialogue: 0,0:08:50.77,0:08:55.57,Default,,0,0,0,,<Бұл дұрыс емес. Рицуко да жеңілген жоқ! ＞
Dialogue: 0,0:08:55.57,0:09:01.35,Default,,0,0,0,,♬〜
Dialogue: 0,0:09:01.35,0:09:04.65,Default,,0,0,0,,<Мен бұл сезімді түсінемін...>
Dialogue: 0,0:09:12.52,0:09:17.73,Default,,0,0,0,,Келесі ән - Франц Шуберт Элленнің №3 әні➡
Dialogue: 0,0:09:17.73,0:09:20.23,Default,,0,0,0,,«Аве Мария».
Dialogue: 0,0:09:20.23,0:09:22.54,Default,,0,0,0,,<"Аве Мария". ➡
Dialogue: 0,0:09:22.54,0:09:26.37,Default,,0,0,0,,Бұл... Мәриямнан көмек сұрау➡
Dialogue: 0,0:09:26.37,0:09:28.67,Default,,0,0,0,,Намаз әні…＞
Dialogue: 0,0:09:33.88,0:09:37.75,Default,,0,0,0,,Рождество мерекесімен Нао. ➡
Dialogue: 0,0:09:37.75,0:09:41.26,Default,,0,0,0,,Енді қолдарың суымайды, солай ма?
Dialogue: 0,0:09:41.26,0:09:44.76,Default,,0,0,0,,Егер сіз скрипкашы болсаңыз, қолыңызды күтіңіз!
Dialogue: 0,0:09:44.76,0:09:49.56,Default,,0,0,0,,Нао Жалаң қолмен қарда ойнаған дұрыс. ➡
Dialogue: 0,0:09:49.56,0:09:53.27,Default,,0,0,0,,CD жақсырақ болды ма? иә?
Dialogue: 0,0:09:53.27,0:09:58.90,Default,,0,0,0,,Кешіріңіз. Мен Нао ананың не қалайтынын білмеймін.
Dialogue: 0,0:09:58.90,0:10:05.28,Default,,0,0,0,,♬〜
Dialogue: 0,0:10:05.28,0:10:08.78,Default,,0,0,0,,Хэхехе...жылы!
Dialogue: 0,0:10:08.78,0:10:10.78,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:10:13.66,0:10:21.93,Default,,0,0,0,,♬〜
Dialogue: 0,0:10:21.93,0:10:26.30,Default,,0,0,0,,Бұл сәл үлкен болды ма? Ехе, проблема жоқ!
Dialogue: 0,0:10:26.30,0:13:10.00,Default,,0,0,0,,♬〜
Dialogue: 0,0:13:12.55,0:13:18.36,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:13:18.36,0:13:23.27,Default,,0,0,0,,Әдемі және нәзік орындау... Сол ұзындық керемет көрінді.
Dialogue: 0,0:13:23.27,0:13:26.07,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:13:26.07,0:13:30.27,Default,,0,0,0,,<Мүмкін бұл адам да студенттің қамқоршысы шығар. ➡
Dialogue: 0,0:13:30.27,0:13:33.17,Default,,0,0,0,,Мүмкін мен сізге кейін хабарласармын...>
Dialogue: 0,0:13:33.17,0:13:38.15,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:13:38.15,0:13:43.59,Default,,0,0,0,,Айтпақшы, ол қыз да ән айтып жүр еді...
Dialogue: 0,0:13:43.59,0:13:49.79,Default,,0,0,0,,<Егер қария тірі болса, сол баламен жақсы араласар ма еді...>
Dialogue: 0,0:13:54.23,0:13:57.23,Default,,0,0,0,,<Келесі соңғысы...>
Dialogue: 0,0:14:04.38,0:14:08.25,Default,,0,0,0,,Аоно-кун, сенің дауысың соңғы кездері қатты жақсарды, бұл жақсы.
Dialogue: 0,0:14:08.25,0:14:10.25,Default,,0,0,0,,Шынымен! ?
Dialogue: 0,0:14:10.25,0:14:13.38,Default,,0,0,0,,Скрипка ғажап - оны жақсы білетіндер бар➡
Dialogue: 0,0:14:13.38,0:14:16.88,Default,,0,0,0,,Аоно: Ол хор клубында да танымал.
Dialogue: 0,0:14:19.56,0:14:22.76,Default,,0,0,0,,Хонго-сенпай, менің ашуымды келтірсең, қиналып қаласың.
Dialogue: 0,0:14:22.76,0:14:26.06,Default,,0,0,0,,Оны елестету мүмкін емес.
Dialogue: 0,0:14:26.06,0:14:28.06,Default,,0,0,0,,Сонша...?
Dialogue: 0,0:14:29.77,0:14:34.27,Default,,0,0,0,,<Мен өзімді... сәл ғана жалғыз сезінемін...>
Dialogue: 0,0:14:36.08,0:14:39.41,Default,,0,0,0,,Келесіде соңғы ән келеді. ➡
Dialogue: 0,0:14:39.41,0:14:42.78,Default,,0,0,0,,Гендельдің «Мәсіх» ораториясынан➡
Dialogue: 0,0:14:42.78,0:14:45.79,Default,,0,0,0,,«Халлелуя хорын» ұсынамыз.
Dialogue: 0,0:14:45.79,0:14:51.59,Default,,0,0,0,,Оратория – музыка арқылы айтылатын әңгіме.
Dialogue: 0,0:14:54.79,0:14:59.63,Default,,0,0,0,,Біз, Каймаку орта мектебінің хор және оркестр үйірмесі➡
Dialogue: 0,0:14:59.63,0:15:02.87,Default,,0,0,0,,Әдетте, әрқайсысы күрт жылтыратылады➡
Dialogue: 0,0:15:02.87,0:15:08.54,Default,,0,0,0,,Саз жолын зерттеп, Күнде уайымдап, азап.
Dialogue: 0,0:15:08.54,0:15:11.45,Default,,0,0,0,,Менің үйірме жұмыстарым әртүрлі, бірақ мен➡
Dialogue: 0,0:15:11.45,0:15:16.88,Default,,0,0,0,,Мен оркестр үйірмесін осындай талпыныстары үшін құрметтеймін. ➡
Dialogue: 0,0:15:16.88,0:15:19.92,Default,,0,0,0,,Осы жерге келгендердің барлығымен➡
Dialogue: 0,0:15:19.92,0:15:25.06,Default,,0,0,0,,Бұл күнді оркестрдің қойылымымен өткіземіз деп үміттенемін➡
Dialogue: 0,0:15:25.06,0:15:28.93,Default,,0,0,0,,Хор мүшесі ретінде мен бақыттымын. ➡
Dialogue: 0,0:15:28.93,0:15:35.57,Default,,0,0,0,,Құдайды мақтанышпен және құдіретті түрде мадақтайтын бұл керемет «Аллелуя»➡
Dialogue: 0,0:15:35.57,0:15:42.07,Default,,0,0,0,,Әр адамның жүрегінде қала берсін деп дұға етіп, ән айта беремін.
Dialogue: 0,0:15:50.42,0:16:54.28,Default,,0,0,0,,♬〜
Dialogue: 0,0:16:54.28,0:16:59.09,Default,,0,0,0,,<Халлелуя «Құдайды мадақтаңыз»➡
Dialogue: 0,0:16:59.09,0:17:04.53,Default,,0,0,0,,Бұл құдіретті қуаныш пен Құдайға және Патшаға мадақ әні➡
Dialogue: 0,0:17:04.53,0:17:10.04,Default,,0,0,0,,Мәсіхтің өмірін бейнелейтін ораторияда кездесетін ән＞
Dialogue: 0,0:17:10.04,0:17:14.74,Default,,0,0,0,,♬〜
Dialogue: 0,0:17:14.74,0:17:17.74,Default,,0,0,0,,<Бастапқыда тамаша ән болғанымен➡
Dialogue: 0,0:17:17.74,0:17:23.05,Default,,0,0,0,,Олар ән айтқанда, ол күшейіп, күшті болады... ➡
Dialogue: 0,0:17:23.05,0:17:26.55,Default,,0,0,0,,Бүкіл денем хор үніне батып кетті. ➡
Dialogue: 0,0:17:26.55,0:17:29.46,Default,,0,0,0,,Бұл жақсы оқу тәжірибесі болады＞
Dialogue: 0,0:17:29.46,0:18:15.90,Default,,0,0,0,,♬〜
Dialogue: 0,0:18:15.90,0:18:19.37,Default,,0,0,0,,<Жаңа әлем➡
Dialogue: 0,0:18:19.37,0:18:22.88,Default,,0,0,0,,Мен тағы бір нәрсені үйренгендей болдым＞
Dialogue: 0,0:18:22.88,0:18:51.94,Default,,0,0,0,,♬〜
Dialogue: 0,0:18:51.94,0:19:04.64,Default,,0,0,0,,♬〜
Dialogue: 0,0:19:10.29,0:19:13.79,Default,,0,0,0,,Күрсін... Күрсін....
Dialogue: 0,0:19:22.74,0:19:29.38,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:19:29.38,0:19:34.75,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:19:34.75,0:19:53.90,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:19:53.90,0:19:57.10,Default,,0,0,0,,Бұл өте жақсы қойылым болды.
Dialogue: 0,0:20:00.08,0:20:03.28,Default,,0,0,0,,Мм... сізге майлық керек пе?
Dialogue: 0,0:20:03.28,0:20:08.15,Default,,0,0,0,,Ах... Рахмет. бәрі жақсы. кешіріңіз!
Dialogue: 0,0:20:08.15,0:20:11.15,Default,,0,0,0,,<Ұят~! ＞
Dialogue: 0,0:20:22.93,0:20:25.97,Default,,0,0,0,,Уау, шынымен жаңбыр жауды...
Dialogue: 0,0:20:25.97,0:20:29.31,Default,,0,0,0,,Иә? Таңертең жаңбыр жауды➡
Dialogue: 0,0:20:29.31,0:20:33.11,Default,,0,0,0,,Бәрібір қар жауа ма деп едім.
Dialogue: 0,0:20:33.11,0:20:35.45,Default,,0,0,0,,Мм.
Dialogue: 0,0:20:35.45,0:20:40.15,Default,,0,0,0,,Концерт өте тез өтті.
Dialogue: 0,0:20:42.28,0:20:44.78,Default,,0,0,0,,Сіз шаршадыңыз ба?
Dialogue: 0,0:20:44.78,0:20:48.09,Default,,0,0,0,,Соған ұқсайды ма? Иә.
Dialogue: 0,0:20:48.09,0:20:51.39,Default,,0,0,0,,Мен шаршадым...
Dialogue: 0,0:20:54.80,0:21:00.50,Default,,0,0,0,,«Әй, бітті...» деп ойладым.
Dialogue: 0,0:21:02.60,0:21:05.90,Default,,0,0,0,,Хехе, күйіп қалдың ба?
Dialogue: 0,0:21:07.74,0:21:11.25,Default,,0,0,0,,Хонго-сенпай...! Ерен еңбегіңіз үшін рахмет.
Dialogue: 0,0:21:11.25,0:21:15.45,Default,,0,0,0,,Тек осы уақытқа ғана болғаны ұят.
Dialogue: 0,0:21:17.12,0:21:20.39,Default,,0,0,0,,Мектеп ішінде оркестрдің ойнағанын естігенде➡
Dialogue: 0,0:21:20.39,0:21:24.76,Default,,0,0,0,,«Мен де жеңілмеймін!» деп ойлайтынмын. ➡
Dialogue: 0,0:21:24.76,0:21:30.89,Default,,0,0,0,,...Мүмкін бұл бір жақты бақталастық шығар! Ахаха.
Dialogue: 0,0:21:30.89,0:21:35.07,Default,,0,0,0,,Бір күні тағы бірге ойнаймыз деп үміттенемін!
Dialogue: 0,0:21:35.07,0:21:39.91,Default,,0,0,0,,♬〜
Dialogue: 0,0:21:39.91,0:21:43.41,Default,,0,0,0,,Сіз өзіңізді жалғыз сезінесіз бе? иә….
Dialogue: 0,0:21:46.78,0:21:49.28,Default,,0,0,0,,Кішкене...
Dialogue: 0,0:21:54.09,0:21:56.09,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:21:58.29,0:22:00.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:25.39,0:22:28.29,Default,,0,0,0,,Сәлеметсіз бе, анашым?
Dialogue: 0,0:22:28.29,0:22:32.76,Default,,0,0,0,,Мен кенеттен кешірім сұраймын. Қазір түс болды, солай ма?
Dialogue: 0,0:22:32.76,0:22:37.27,Default,,0,0,0,,Иә. Өйткені Рождество жақындап қалды➡
Dialogue: 0,0:22:37.27,0:22:40.77,Default,,0,0,0,,Қалай айта аламын...➡
Dialogue: 0,0:22:40.77,0:22:45.28,Default,,0,0,0,,Мен... Рождество мерекесімен➡
Dialogue: 0,0:22:45.28,0:22:48.58,Default,,0,0,0,,Мен айтайын деп ойладым...
Dialogue: 0,0:22:48.58,0:22:55.35,Default,,0,0,0,,♬〜
Dialogue: 0,0:22:55.35,0:22:59.09,Default,,0,0,0,,Қашан болатынын білмеймін➡
Dialogue: 0,0:22:59.09,0:23:03.73,Default,,0,0,0,,Келесі жолы анамды тағы көремін...➡
Dialogue: 0,0:23:03.73,0:23:07.23,Default,,0,0,0,,Менің скрипкамды тыңдауларыңызды қалаймын.
Dialogue: 0,0:23:10.24,0:23:18.55,Default,,0,0,0,,♬〜
Dialogue: 0,0:23:18.55,0:23:22.41,Default,,0,0,0,,♬ «Мен оны сізден алдым».
Dialogue: 0,0:23:22.41,0:23:28.25,Default,,0,0,0,,♬ «Сәйкес келетін үш жиілік кілтті салпыншақ»
Dialogue: 0,0:23:28.25,0:23:34.13,Default,,0,0,0,,♬ «Мен оны жоғалтып алдым, сені енді көре алмаймын».
Dialogue: 0,0:23:34.13,0:23:37.90,Default,,0,0,0,,♬ «Ағаштарды сүзіп өткен таңғажайып күн сәулесі»
Dialogue: 0,0:23:37.90,0:23:41.77,Default,,0,0,0,,♬ «Мен ешқашан орала алмаймын»
Dialogue: 0,0:23:41.77,0:23:48.91,Default,,0,0,0,,♬ «Мен өткенді жек көремін, метроном, тоқтама».
Dialogue: 0,0:23:48.91,0:23:55.58,Default,,0,0,0,,♬ «Маған уақыт машинасы қажет емес».
Dialogue: 0,0:23:55.58,0:24:03.33,Default,,0,0,0,,♬ «Бірақ, мен сені сол кезде кездестірсем.»
Dialogue: 0,0:24:03.33,0:24:12.73,Default,,0,0,0,,♬ «Жарайды, жарайды, жұлдыздардың сиқыры сізді орап алады»
Dialogue: 0,0:24:12.73,0:24:18.87,Default,,0,0,0,,♬ «Мен саған жарық болғым келеді».
Dialogue: 0,0:24:18.87,0:24:27.88,Default,,0,0,0,,♬ «Жарайды, жарайды, өтінемін, уақыттың сиқыры».
Dialogue: 0,0:24:27.88,0:24:35.58,Default,,0,0,0,,♬ «Мен сенімен мәңгі бірге болғым келеді».
Dialogue: 0,0:24:37.08,0:24:43.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
