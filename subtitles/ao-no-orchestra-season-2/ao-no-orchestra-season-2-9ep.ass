Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.26,0:00:05.10,Default,,0,0,0,,Менің ойымша, уақыт келді...
Dialogue: 0,0:00:05.10,0:00:08.60,Default,,0,0,0,,Музыканы Сен-Саенс➡ жазған
Dialogue: 0,0:00:08.60,0:00:13.94,Default,,0,0,0,,«Самсон мен Делила» операсынан «Бакканал». ➡
Dialogue: 0,0:00:13.94,0:00:20.82,Default,,0,0,0,,Ескі бөтен елдегі ер мен әйелдің оқиғасы экзотикалық дыбыстан басталады. ➡
Dialogue: 0,0:00:20.82,0:00:24.95,Default,,0,0,0,,Адамдар қуана ішіп, билейді➡
Dialogue: 0,0:00:24.95,0:00:28.62,Default,,0,0,0,,«Бакканал» үлкен банкет. ➡
Dialogue: 0,0:00:28.62,0:00:33.30,Default,,0,0,0,,Ортада Делила жарқырап, билейді. ➡
Dialogue: 0,0:00:33.30,0:00:38.80,Default,,0,0,0,,Жаудың батыры Самсонды азғырып, қолға түсірген сұлу әйел. ➡
Dialogue: 0,0:00:38.80,0:00:44.67,Default,,0,0,0,,Ал шарықтау шегінде Самсонның қатты эмоциялары жарылып кетеді.
Dialogue: 0,0:00:44.67,0:00:50.18,Default,,0,0,0,,Жаңа Каймаку оркестрі қандай «банкет» ұсынады екен...
Dialogue: 0,0:00:52.65,0:00:56.35,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:01:09.77,0:01:15.64,Default,,0,0,0,,Келесі спектакль Чиба префектуралық Каймаку орта мектебінде болды. ➡
Dialogue: 0,0:01:15.64,0:01:19.41,Default,,0,0,0,,Музыкасы Сен-Саенс➡
Dialogue: 0,0:01:19.41,0:01:24.28,Default,,0,0,0,,«Самсон мен Делила» операсынан «Бакканал». ➡
Dialogue: 0,0:01:24.28,0:01:27.98,Default,,0,0,0,,Бұйрық Хироаки Аюкава.
Dialogue: 0,0:01:31.62,0:01:45.17,Default,,0,0,0,,♬～
Dialogue: 0,0:01:45.17,0:01:48.80,Default,,0,0,0,,♬ «Өзім жылтыратып жүрген біртүрлі етік».
Dialogue: 0,0:01:48.80,0:01:53.68,Default,,0,0,0,,♬ «Мен көпшіліктің арасында бұрмаланып көріндім».
Dialogue: 0,0:01:53.68,0:01:57.31,Default,,0,0,0,,♬ «Мен жүзіп жүрдім».
Dialogue: 0,0:01:57.31,0:02:03.25,Default,,0,0,0,,♬ «Таланттың биіне бас иемін, Ебедейсіз қозғаламын».
Dialogue: 0,0:02:03.25,0:02:08.59,Default,,0,0,0,,♬ «Күліп, тісін көрсеткен Амадей түсінбейді».
Dialogue: 0,0:02:08.59,0:02:14.93,Default,,0,0,0,,♬ «Бір жерден біреудің дауысы естіледі»
Dialogue: 0,0:02:14.93,0:02:21.40,Default,,0,0,0,,♬ «Мен сияқты бұрмаланған және жалғыз ән»
Dialogue: 0,0:02:21.40,0:02:25.94,Default,,0,0,0,,♬ «Лорелей әуенді жоғалтқаннан кейін импровизация жасайды»
Dialogue: 0,0:02:25.94,0:02:28.84,Default,,0,0,0,,♬ «Бахтың қорапта ойнауы»
Dialogue: 0,0:02:28.84,0:02:33.42,Default,,0,0,0,,♬ «Мені тартып алып, сахнада биледім».
Dialogue: 0,0:02:33.42,0:02:37.79,Default,,0,0,0,,♬ «Түні бойы таусылатын сияқтымыз».
Dialogue: 0,0:02:37.79,0:02:45.29,Default,,0,0,0,,♬ «Ол әдемі көздерден басқа ештеңе көрмеймін».
Dialogue: 0,0:02:45.29,0:02:50.13,Default,,0,0,0,,♬ «Мен қалай көрінемін?»
Dialogue: 0,0:02:50.13,0:02:57.14,Default,,0,0,0,,♬～
Dialogue: 0,0:03:01.74,0:03:09.25,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:03:29.40,0:11:24.21,Default,,0,0,0,,♬～
Dialogue: 0,0:11:27.48,0:11:29.68,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:11:42.30,0:12:15.30,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:12:22.27,0:12:25.27,Default,,0,0,0,,Иә? Менде тиындар жеткіліксіз...
Dialogue: 0,0:12:25.27,0:12:27.78,Default,,0,0,0,,<Бұл өтірік, солай ма? ＞
Dialogue: 0,0:12:27.78,0:12:29.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:31.61,0:12:35.28,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:12:35.28,0:12:37.95,Default,,0,0,0,,А, аяқталды. Бұл мені қобалжытады.
Dialogue: 0,0:12:37.95,0:12:41.79,Default,,0,0,0,,Мен осындай басқа мектептердің қойылымдарын тыңдағанда➡
Dialogue: 0,0:12:41.79,0:12:45.96,Default,,0,0,0,,Бұл бізден әлдеқайда жақсы естіледі, солай емес пе?
Dialogue: 0,0:12:45.96,0:12:48.86,Default,,0,0,0,,<Бірақ біз де солай жасадық...? ＞
Dialogue: 0,0:12:48.86,0:12:51.83,Default,,0,0,0,,Бұл шынымен жақсы, солай емес пе?
Dialogue: 0,0:12:51.83,0:12:57.14,Default,,0,0,0,,Шынымды айтсам, қойылымдарды тыңдап отырып, «бұл жақсы емес» деп ойлайтын мектептер бар.
Dialogue: 0,0:12:59.51,0:13:03.75,Default,,0,0,0,,Жақында келе ме? Ах... ➡
Dialogue: 0,0:13:03.75,0:13:06.65,Default,,0,0,0,,Бірақ жақсы... әзірге➡
Dialogue: 0,0:13:06.65,0:13:10.92,Default,,0,0,0,,Өз жауабыңызға сену дұрыс емес пе?
Dialogue: 0,0:13:10.92,0:13:13.59,Default,,0,0,0,,<Осылай айтасың➡
Dialogue: 0,0:13:13.59,0:13:16.26,Default,,0,0,0,,Керісінше мазасызданамын... ➡
Dialogue: 0,0:13:16.26,0:13:18.59,Default,,0,0,0,,Сіз бақылайсыз ба...＞
Dialogue: 0,0:13:18.59,0:13:23.40,Default,,0,0,0,,Олай болса, нәтижелер жақын арада жарияланады, кешікпеңіз.
Dialogue: 0,0:13:23.40,0:13:27.70,Default,,0,0,0,,Ах...жу... 10 иен Рахмет!
Dialogue: 0,0:13:33.61,0:13:38.41,Default,,0,0,0,,<Ненің дұрыс, ненің бұрыс екенін білмеймін. ➡
Dialogue: 0,0:13:38.41,0:13:42.78,Default,,0,0,0,,Бұл артықшылық пен төмендіктің арасында нақты айырмашылық жоқ болғандықтан➡
Dialogue: 0,0:13:42.78,0:13:46.09,Default,,0,0,0,,Күту мен қобалжу аралас>
Dialogue: 0,0:14:04.57,0:14:08.38,Default,,0,0,0,,<Мұндай жағдай бірінші рет болып тұрған жоқ... ➡
Dialogue: 0,0:14:08.38,0:14:10.91,Default,,0,0,0,,Жарайды...? ＞
Dialogue: 0,0:14:10.91,0:14:13.82,Default,,0,0,0,,Енді нәтижелерді жариялауға кірісейік. ➡
Dialogue: 0,0:14:13.82,0:14:18.12,Default,,0,0,0,,Майданға аты аталған әр мектептен өкілдер келуі керек.
Dialogue: 0,0:14:20.25,0:14:23.09,Default,,0,0,0,,…Орта мектептің қола жүлдесі.
Dialogue: 0,0:14:23.09,0:14:25.76,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:14:25.76,0:14:29.60,Default,,0,0,0,,Акита префектуралық Сенджо орта мектебі➡
Dialogue: 0,0:14:29.60,0:14:31.93,Default,,0,0,0,,Алтын жүлде!
Dialogue: 0,0:14:31.93,0:14:35.77,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:14:35.77,0:14:38.27,Default,,0,0,0,,Алтын жүлде дегеніміз не?
Dialogue: 0,0:14:38.27,0:14:41.11,Default,,0,0,0,,Бұл сіздің ең жақсы жүлдені жеңіп алғаныңызды білдіре ме?
Dialogue: 0,0:14:41.11,0:14:43.41,Default,,0,0,0,,Сіз...
Dialogue: 0,0:14:43.41,0:14:46.11,Default,,0,0,0,,Біріншіден, орындау реті бойынша, әр мектеп үшін➡
Dialogue: 0,0:14:46.11,0:14:49.78,Default,,0,0,0,,Сізге келесілердің бірі беріледі: ``Алтын жүлде, Күміс жүлде немесе қола жүлде.''
Dialogue: 0,0:14:49.78,0:14:54.96,Default,,0,0,0,,Алтын жүлдеден бұрын «алтын» қосу себебі – күміс жүлдемен шатастырмас үшін.
Dialogue: 0,0:14:54.96,0:14:59.13,Default,,0,0,0,,А... Одан кейін алтын жүлде алған мектептер арасынан➡
Dialogue: 0,0:14:59.13,0:15:03.10,Default,,0,0,0,,Үздік марапаты мен Бас жүлде жарияланады.
Dialogue: 0,0:15:03.10,0:15:05.90,Default,,0,0,0,,Келесі Фукуока префектурасы….
Dialogue: 0,0:15:07.74,0:15:10.64,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:15:10.64,0:15:13.07,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:15:13.07,0:15:16.11,Default,,0,0,0,,Келесі жылы тағы да бар күшімізді салайық.
Dialogue: 0,0:15:16.11,0:15:20.38,Default,,0,0,0,,<Мен өзімді мазасыз және мазасыз сезінемін. ➡
Dialogue: 0,0:15:20.38,0:15:23.75,Default,,0,0,0,,Ол кезде мен де қобалжыдым...➡
Dialogue: 0,0:15:23.75,0:15:27.09,Default,,0,0,0,,Нәтижеге қарамастан адалдық➡
Dialogue: 0,0:15:27.09,0:15:31.93,Default,,0,0,0,,Мен өзімді еркін сезіндім, өйткені мен оны қабылдай алатын жалғыз адам едім. ➡
Dialogue: 0,0:15:31.93,0:15:34.76,Default,,0,0,0,,Бірақ қазір...>
Dialogue: 0,0:15:34.76,0:15:36.96,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:15:38.60,0:15:42.94,Default,,0,0,0,,<Мен бәрінің осылай болғанын қаламаймын...>
Dialogue: 0,0:15:42.94,0:15:45.97,Default,,0,0,0,,Келесі Менің үйім….
Dialogue: 0,0:15:45.97,0:15:49.81,Default,,0,0,0,,Чиба префектуралық Каймоку орта мектебі➡
Dialogue: 0,0:15:49.81,0:15:52.28,Default,,0,0,0,,Алтын жүлде!
Dialogue: 0,0:15:52.28,0:15:58.15,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:15:58.15,0:16:01.09,Default,,0,0,0,,Ең алдымен, өту нүктесі.
Dialogue: 0,0:16:01.09,0:16:06.79,Default,,0,0,0,,Соңында біз екі мектептің Үздік және Бас жүлде алғанын хабарлаймыз.
Dialogue: 0,0:16:06.79,0:16:09.70,Default,,0,0,0,,Ең алдымен, Үздік марапаты бар.
Dialogue: 0,0:16:09.70,0:16:12.90,Default,,0,0,0,,<Егер сізді осы жерге шақырса, жеңіс сериясы тоқтайды>
Dialogue: 0,0:16:12.90,0:16:15.74,Default,,0,0,0,,Биылғы бас жүлде...!
Dialogue: 0,0:16:15.74,0:16:18.77,Default,,0,0,0,,Өтінемін! Маған қоңырау шалмаңыз!
Dialogue: 0,0:16:18.77,0:16:23.08,Default,,0,0,0,,Акита префектуралық Сенджо орта мектебі!
Dialogue: 0,0:16:28.45,0:16:31.25,Default,,0,0,0,,Боқ... (Әділқазылар алқасының төрағасы) Құттықтаймыз!
Dialogue: 0,0:16:31.25,0:16:33.75,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:16:33.75,0:16:37.39,Default,,0,0,0,,Келесі - бас жүлдені жариялау.
Dialogue: 0,0:16:37.39,0:16:40.26,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:40.26,0:16:44.27,Default,,0,0,0,,Чиба префектуралық Каймаку орта мектебі!
Dialogue: 0,0:16:44.27,0:16:48.77,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:16:48.77,0:16:50.77,Default,,0,0,0,,Сізге жақсы!
Dialogue: 0,0:16:52.41,0:16:55.31,Default,,0,0,0,,Мата Мен оны қалдырдым. Біреуде бар ма?
Dialogue: 0,0:16:55.31,0:17:07.22,Default,,0,0,0,,♬～
Dialogue: 0,0:17:07.22,0:17:09.22,Default,,0,0,0,,Аха….
Dialogue: 0,0:17:09.22,0:17:17.57,Default,,0,0,0,,♬～
Dialogue: 0,0:17:17.57,0:17:21.44,Default,,0,0,0,,Әй, төреші қиналып қалды.
Dialogue: 0,0:17:21.44,0:17:25.64,Default,,0,0,0,,Ол жігіттер тым бақытты. Бұл жақсы, жақсы.
Dialogue: 0,0:17:27.24,0:17:29.74,Default,,0,0,0,,Осыған байланысты,➡
Dialogue: 0,0:17:29.74,0:17:35.45,Default,,0,0,0,,24-ші бүкіл жапондық мектеп ансамблі байқауы жабылады.
Dialogue: 0,0:17:40.25,0:17:43.76,Default,,0,0,0,,Ең алдымен баршаңызға еңбектеріңіз үшін рахмет.
Dialogue: 0,0:17:43.76,0:17:48.63,Default,,0,0,0,,Осы байқаудың алдында мені мазалайтын жайттар көп болды➡
Dialogue: 0,0:17:48.63,0:17:51.93,Default,,0,0,0,,Қиын кездер көп болды деп ойлаймын. ➡
Dialogue: 0,0:17:51.93,0:17:54.27,Default,,0,0,0,,Бірақ... Ми...➡
Dialogue: 0,0:17:54.27,0:17:59.41,Default,,0,0,0,,Әркім қолынан келгенін істегендіктен, мен... (жылап)
Dialogue: 0,0:17:59.41,0:18:02.21,Default,,0,0,0,,Директор Цуцуи Мен қатты жылап жатырмын.
Dialogue: 0,0:18:02.21,0:18:05.51,Default,,0,0,0,,Жоқ, Хатори. Таяқшаның жанасуы.
Dialogue: 0,0:18:07.72,0:18:10.22,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:10.22,0:18:13.05,Default,,0,0,0,,Бір нәрсені айту керек болса...➡
Dialogue: 0,0:18:13.05,0:18:17.36,Default,,0,0,0,,Осы орайда мені бақылағаныңыз үшін рахмет.
Dialogue: 0,0:18:18.93,0:18:23.06,Default,,0,0,0,,Мен зейнеткерлікке шыққан сияқтымын. Е, әлі жоқ!
Dialogue: 0,0:18:23.06,0:18:25.73,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:18:25.73,0:18:29.07,Default,,0,0,0,,Соңында тағы біраз...
Dialogue: 0,0:18:29.07,0:18:31.27,Default,,0,0,0,,Такимото.
Dialogue: 0,0:18:38.75,0:18:42.58,Default,,0,0,0,,Әркімнің айтары бар.
Dialogue: 0,0:18:42.58,0:18:45.62,Default,,0,0,0,,2 бөлімнің жетекшісі...➡
Dialogue: 0,0:18:45.62,0:18:51.26,Default,,0,0,0,,Ертеңнен бастап Фукудом мырза мені толық емес басшы ретінде ауыстырады.
Dialogue: 0,0:18:51.26,0:18:53.19,Default,,0,0,0,,Кенеттен бәрі➡
Dialogue: 0,0:18:53.19,0:18:56.13,Default,,0,0,0,,Мен сізді таң қалдырған шығармын, бірақ➡
Dialogue: 0,0:18:56.13,0:19:01.90,Default,,0,0,0,,Отбасылық жағдайға байланысты ертеңнен бастап практикаға қатыса алмаймын.
Dialogue: 0,0:19:01.90,0:19:05.21,Default,,0,0,0,,Фукудом мырза және барлығы 2-ші, әрине➡
Dialogue: 0,0:19:05.21,0:19:09.04,Default,,0,0,0,,Менің ойымша, бұл бүкіл оркестрге қиындық туғызады.
Dialogue: 0,0:19:09.04,0:19:13.25,Default,,0,0,0,,Мен өзімшіл себептермен кетуге мәжбүр болғаныма өкінемін.
Dialogue: 0,0:19:15.82,0:19:19.55,Default,,0,0,0,,Мұндай уақытта бұл туралы айтудың қажеті жоқ.
Dialogue: 0,0:19:19.55,0:19:24.73,Default,,0,0,0,,Бірақ мен тіркеуімді сақтауым керек, сондықтан мен тәжірибеге келе алмаймын...
Dialogue: 0,0:19:24.73,0:19:26.76,Default,,0,0,0,,Мен оны білдім. сурет...?
Dialogue: 0,0:19:26.76,0:19:28.90,Default,,0,0,0,,үшін білетін.
Dialogue: 0,0:19:28.90,0:19:31.60,Default,,0,0,0,,А...? иә? Ха! ?
Dialogue: 0,0:19:33.23,0:19:35.94,Default,,0,0,0,,Ахаха таң қалдым.
Dialogue: 0,0:19:37.91,0:19:40.81,Default,,0,0,0,,Сәл ерте болуы мүмкін➡
Dialogue: 0,0:19:40.81,0:19:44.25,Default,,0,0,0,,үшінның ерен еңбегі үшін алғысымды білдіремін...
Dialogue: 0,0:19:44.25,0:19:47.58,Default,,0,0,0,,Рахмет, Такимото-сенпай!
Dialogue: 0,0:19:47.58,0:19:50.25,Default,,0,0,0,,Еңбегіңіз үшін рахмет! Ара-тұра бетіңізді көрсетіңіз.
Dialogue: 0,0:19:50.25,0:19:52.59,Default,,0,0,0,,Рахмет! (қол шапалақтау)
Dialogue: 0,0:19:52.59,0:20:18.28,Default,,0,0,0,,♬～
Dialogue: 0,0:20:22.28,0:20:26.79,Default,,0,0,0,,Ано! Осыдан кейін бәріміз ұшыруға бару туралы сөйлестік➡
Dialogue: 0,0:20:26.79,0:20:29.82,Default,,0,0,0,,Аоно да барады, солай ма? Ух... иә...
Dialogue: 0,0:20:29.82,0:20:34.53,Default,,0,0,0,,<Іске қосу...! Ақыры мен де...➡
Dialogue: 0,0:20:34.53,0:20:36.83,Default,,0,0,0,,Іске қосу...! ＞
Dialogue: 0,0:20:40.30,0:20:42.64,Default,,0,0,0,,Хмм….
Dialogue: 0,0:20:42.64,0:20:46.51,Default,,0,0,0,,Көңіл-күйім нашар, бірақ гамбургерден де бас тарта алмаймын...
Dialogue: 0,0:20:46.51,0:20:51.35,Default,,0,0,0,,А, бес сусын бар. Мен оны түсіндім.
Dialogue: 0,0:20:51.35,0:20:54.15,Default,,0,0,0,,А, мен оны білдім!
Dialogue: 0,0:20:54.15,0:20:58.32,Default,,0,0,0,,Такимото-сенпай! Мен оны біраз уақыт бұрын көрдім, солай болуы мүмкін.
Dialogue: 0,0:20:58.32,0:21:02.02,Default,,0,0,0,,Үлкендерге де ұшыру болады ма? Иә.
Dialogue: 0,0:21:03.76,0:21:07.09,Default,,0,0,0,,Бүгінгі қажырлы еңбектеріңіз үшін барлығыңызға рахмет!
Dialogue: 0,0:21:07.09,0:21:11.40,Default,,0,0,0,,1-сынып оқушысы: Ол өте жақсы ойнағанын айтты.
Dialogue: 0,0:21:11.40,0:21:15.27,Default,,0,0,0,,Такимотоның бірінші кеші Мен жалғызбын.
Dialogue: 0,0:21:15.27,0:21:18.57,Default,,0,0,0,,Мен сіздермен болашақта жұмыс істеуді асыға күтемін.
Dialogue: 0,0:21:23.01,0:21:26.41,Default,,0,0,0,,үшін үшін рахмет, Аоно-кун.
Dialogue: 0,0:21:26.41,0:21:29.62,Default,,0,0,0,,Жоқ...! Менде ештеңе жоқ...!
Dialogue: 0,0:21:32.12,0:21:34.82,Default,,0,0,0,,Мен саған сусын алып келейін!
Dialogue: 0,0:21:36.42,0:21:38.96,Default,,0,0,0,,Аоно-кун!
Dialogue: 0,0:21:38.96,0:21:42.43,Default,,0,0,0,,Ол да Аоно-кунды мақтап жатты.
Dialogue: 0,0:21:42.43,0:21:44.73,Default,,0,0,0,,<Ол...? ＞
Dialogue: 0,0:21:48.80,0:21:51.61,Default,,0,0,0,,А...? Ах...
Dialogue: 0,0:21:53.31,0:21:57.18,Default,,0,0,0,,Күрсіну…. Аоно-кун, мен саған ұнайсың ба?
Dialogue: 0,0:21:57.18,0:22:00.38,Default,,0,0,0,,<Ааа~! ? > (Сакума) Өйткені мен онымен жиі кездесемін.
Dialogue: 0,0:22:00.38,0:22:04.25,Default,,0,0,0,,Бұл жай ғана кездейсоқтық! Хмм.
Dialogue: 0,0:22:04.25,0:22:06.95,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:22:09.12,0:22:13.59,Default,,0,0,0,,Еске алу (Такимото) Ол да Аоно-кунды мақтап жатты.
Dialogue: 0,0:22:13.59,0:22:15.90,Default,,0,0,0,,<Мен сене алмаймын...>
Dialogue: 0,0:22:17.46,0:22:21.27,Default,,0,0,0,,Өйткені келесі жылы не болатынын білмейміз. сурет...?
Dialogue: 0,0:22:21.27,0:22:24.77,Default,,0,0,0,,Зейнеткерлікке шықсақ... бұл жолы ➡
Dialogue: 0,0:22:24.77,0:22:27.81,Default,,0,0,0,,Сіз де дәл осындай жағдайға тап болуыңыз мүмкін. ➡
Dialogue: 0,0:22:27.81,0:22:30.28,Default,,0,0,0,,Мүмкін ауыстырылған болса➡
Dialogue: 0,0:22:30.28,0:22:34.15,Default,,0,0,0,,Аоно-кун оркестрдегі басты тұлға болатын шығар.
Dialogue: 0,0:22:34.15,0:22:37.05,Default,,0,0,0,,Жоқ... сен мені жай ғана мақтадың! ?
Dialogue: 0,0:22:37.05,0:22:39.79,Default,,0,0,0,,Бөлек. Күткендей!
Dialogue: 0,0:22:39.79,0:22:42.69,Default,,0,0,0,,Такимото-сенпайдың бұрын айтқаны осы!
Dialogue: 0,0:22:42.69,0:22:45.96,Default,,0,0,0,,«Ол да Аоно-кунды мақтады».
Dialogue: 0,0:22:45.96,0:22:51.13,Default,,0,0,0,,Мен ағаларымның мақтауына тұрарлық па, білмеймін, бірақ...
Dialogue: 0,0:22:51.13,0:22:53.97,Default,,0,0,0,,Жақсы. сурет...?
Dialogue: 0,0:22:53.97,0:22:56.64,Default,,0,0,0,,Егер сіздің ниетіңіз болса➡
Dialogue: 0,0:22:56.64,0:23:00.84,Default,,0,0,0,,Енді оркестрдің болашағын талқылайық па?
Dialogue: 0,0:23:03.44,0:23:05.75,Default,,0,0,0,,О...➡
Dialogue: 0,0:23:05.75,0:23:08.75,Default,,0,0,0,,Маған жұмсақ болыңыз...
Dialogue: 0,0:23:10.62,0:23:19.09,Default,,0,0,0,,♬～
Dialogue: 0,0:23:19.09,0:23:22.96,Default,,0,0,0,,♬ «Мен оны сізден алдым».
Dialogue: 0,0:23:22.96,0:23:28.80,Default,,0,0,0,,♬ «Сәйкес келетін жоғары кілттік кілттер тізбегі»
Dialogue: 0,0:23:28.80,0:23:34.64,Default,,0,0,0,,♬ «Мен оны жоғалттым және сені енді көре алмаймын».
Dialogue: 0,0:23:34.64,0:23:38.41,Default,,0,0,0,,♬ «Ағаштарды сүзіп өткен таңғажайып күн сәулесі»
Dialogue: 0,0:23:38.41,0:23:42.28,Default,,0,0,0,,♬ «Мен ешқашан орала алмаймын»
Dialogue: 0,0:23:42.28,0:23:49.42,Default,,0,0,0,,♬ "Мен өткенді жек көремін. Метроном, тоқтама".
Dialogue: 0,0:23:49.42,0:23:56.13,Default,,0,0,0,,♬ «Маған уақыт машинасы қажет емес».
Dialogue: 0,0:23:56.13,0:24:03.87,Default,,0,0,0,,♬ «Бірақ, мен сені сол кезде кездестірсем.»
Dialogue: 0,0:24:03.87,0:24:13.25,Default,,0,0,0,,♬ «Жарайды, жарайды, жұлдыздардың сиқыры сізді орап алады»
Dialogue: 0,0:24:13.25,0:24:19.39,Default,,0,0,0,,♬ «Мен саған жарық болғым келеді».
Dialogue: 0,0:24:19.39,0:24:28.40,Default,,0,0,0,,♬ «Жарайды, жарайды, өтінемін, уақыттың сиқыры».
Dialogue: 0,0:24:28.40,0:24:36.10,Default,,0,0,0,,♬ «Мен сенімен мәңгі бірге болғым келеді».
