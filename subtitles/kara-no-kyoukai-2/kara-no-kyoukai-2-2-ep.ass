Dialogue: 0,0:00:01.55,0:00:07.55,CNsub,NTP,0,0,0,,КамиГами
Dialogue: 0,0:59:14.13,0:59:18.49,CNsub,NTP,0000,0000,0000,,Екі қан VS Асами қан жоқ
Dialogue: 0,0:59:54.65,0:59:59.45,CNsub,NTP,0,0,0,,＠/···
Dialogue: 0,0:53:37.25,0:53:43.96,EDJ,NTP,0000,0000,0000,,Жылы желде
Dialogue: 0,0:53:44.28,0:53:51.31,EDJ,NTP,0000,0000,0000,,Біреу қоңырау шалып жатыр
Dialogue: 0,0:53:51.46,0:53:58.43,EDJ,NTP,0000,0000,0000,,Қараңғылыққа өкіну
Dialogue: 0,0:53:58.64,0:54:09.48,EDJ,NTP,0000,0000,0000,,Таңның атысы басталады
Dialogue: 0,0:54:10.87,0:54:17.46,EDJ,NTP,0000,0000,0000,,Мен ертеңге сенімдімін
Dialogue: 0,0:54:17.96,0:54:24.78,EDJ,NTP,0000,0000,0000,,Әдемі аспанда
Dialogue: 0,0:54:25.17,0:54:39.14,EDJ,NTP,0000,0000,0000,,Күміс кемпірқосақ болады
Dialogue: 0,0:54:39.57,0:54:46.29,EDJ,NTP,0000,0000,0000,,Сондай қайғылы көрініс
Dialogue: 0,0:54:46.58,0:54:53.38,EDJ,NTP,0000,0000,0000,,Сіз оны жарыққа айналдырасыз
Dialogue: 0,0:54:53.69,0:55:00.47,EDJ,NTP,0000,0000,0000,,Тіпті кішкентай көз жасы
Dialogue: 0,0:55:00.85,0:55:07.88,EDJ,NTP,0000,0000,0000,,Зер тастар сияқты құлау
Dialogue: 0,0:55:08.06,0:55:18.03,EDJ,NTP,0000,0000,0000,,Болашаққа
Dialogue: 0,0:55:22.61,0:55:29.27,EDJ,NTP,0000,0000,0000,,Жүректің сыры бар
Dialogue: 0,0:55:29.54,0:55:36.19,EDJ,NTP,0000,0000,0000,,Мен саған әлі де тиіскім келеді
Dialogue: 0,0:55:36.57,0:55:43.25,EDJ,NTP,0000,0000,0000,,Бір-бірімізді тигізсек, бұзыламыз
Dialogue: 0,0:55:43.50,0:55:50.62,EDJ,NTP,0000,0000,0000,,Екілену спиральға айналады
Dialogue: 0,0:55:50.68,0:55:57.12,EDJ,NTP,0000,0000,0000,,Көпір арқылы өзеннен өту
Dialogue: 0,0:55:57.25,0:56:01.14,EDJ,NTP,0000,0000,0000,,Ертең әрине
Dialogue: 0,0:56:01.22,0:56:04.00,EDJ,NTP,0000,0000,0000,,Күннің ортасында
Dialogue: 0,0:56:04.22,0:56:10.43,EDJ,NTP,0000,0000,0000,,Көктем тәтті және терең хош иісті болуы керек.
Dialogue: 0,0:56:10.87,0:56:13.99,EDJ,NTP,0000,0000,0000,,Түстен ояну
Dialogue: 0,0:56:14.29,0:56:22.50,EDJ,NTP,0000,0000,0000,,Адамдар нені іздейді?
Dialogue: 0,0:56:44.07,0:56:50.58,EDJ,NTP,0000,0000,0000,,Осындай жарық дүниеге
Dialogue: 0,0:56:50.84,0:56:57.41,EDJ,NTP,0000,0000,0000,,Сен мені аласың
Dialogue: 0,0:56:57.79,0:57:04.35,EDJ,NTP,0000,0000,0000,,Жалт-жұлт еткеннен әлі басы айналады
Dialogue: 0,0:57:04.72,0:57:11.38,EDJ,NTP,0000,0000,0000,,Арқаңызды ақырын құшақтап алыңыз
Dialogue: 0,0:57:11.68,0:57:18.34,EDJ,NTP,0000,0000,0000,,Сенімнің өтпелілігі
Dialogue: 0,0:57:18.68,0:57:25.32,EDJ,NTP,0000,0000,0000,,Нұрға айналасың
Dialogue: 0,0:57:25.62,0:57:32.24,EDJ,NTP,0000,0000,0000,,Таңертең оянсам, Көз жасыммен жыладым.
Dialogue: 0,0:57:32.58,0:57:39.23,EDJ,NTP,0000,0000,0000,,Зер тастар сияқты құлау
Dialogue: 0,0:57:39.56,0:57:49.38,EDJ,NTP,0000,0000,0000,,Болашаққа
Dialogue: 0,0:53:37.25,0:53:43.96,EDC,NTP,0000,0000,0000,,Температура бойынша шамалы жел
Dialogue: 0,0:53:44.28,0:53:51.31,EDC,NTP,0000,0000,0000,,Кімге қоңырау шалу керек?
Dialogue: 0,0:53:51.46,0:53:58.43,EDC,NTP,0000,0000,0000,,Сурет қара және күңгірт.
Dialogue: 0,0:53:58.64,0:54:09.48,EDC,NTP,0000,0000,0000,,...
Dialogue: 0,0:54:10.87,0:54:17.46,EDC,NTP,0000,0000,0000,,Мейтен Секикай
Dialogue: 0,0:54:17.96,0:54:24.78,EDC,NTP,0000,0000,0000,,Аспандағы әдемі аспан
Dialogue: 0,0:54:25.17,0:54:39.14,EDC,NTP,0000,0000,0000,,Күміс кемпірқосақтың пайда болуы
Dialogue: 0,0:54:39.57,0:54:46.29,EDC,NTP,0000,0000,0000,,Әдемі табиғат көрінісі
Dialogue: 0,0:54:46.58,0:54:53.38,EDC,NTP,0000,0000,0000,,Бұл сіздің жалпы жұмысыңызды жасайтын нұр.
Dialogue: 0,0:54:53.69,0:55:00.47,EDC,NTP,0000,0000,0000,,Сейхеннен ағып жатқан көз жасына дейін ояну
Dialogue: 0,0:55:00.85,0:55:07.88,EDC,NTP,0000,0000,0000,,Цуньо асыл тастың жалпы келуі
Dialogue: 0,0:55:08.06,0:55:18.03,EDC,NTP,0000,0000,0000,,Болашақ орта
Dialogue: 0,0:55:22.61,0:55:29.27,EDC,NTP,0000,0000,0000,,Жүрегіңдегі сыр неде?
Dialogue: 0,0:55:29.54,0:55:36.19,EDC,NTP,0000,0000,0000,,Бұл идея байланысы бойынша толық нұсқаулық
Dialogue: 0,0:55:36.57,0:55:43.25,EDC,NTP,0000,0000,0000,,Алайда кездесуден кейін өзара байланыстың сәтсіздігі
Dialogue: 0,0:55:43.50,0:55:50.62,EDC,NTP,0000,0000,0000,,Спираль бойынша құлау
Dialogue: 0,0:55:50.68,0:55:57.12,EDC,NTP,0000,0000,0000,,Көпір кедергісінің жағасы
Dialogue: 0,0:55:57.25,0:56:01.14,EDC,NTP,0000,0000,0000,,Ертең белгіленген жиналыс
Dialogue: 0,0:56:01.22,0:56:04.00,EDC,NTP,0000,0000,0000,,Түсте
Dialogue: 0,0:56:04.22,0:56:10.43,EDC,NTP,0000,0000,0000,,Шунтен шашыраңқы және терең хош иіс
Dialogue: 0,0:56:10.87,0:56:13.99,EDC,NTP,0000,0000,0000,,Түстен ояну
Dialogue: 0,0:56:14.29,0:56:22.50,EDC,NTP,0000,0000,0000,,Адамды зерттеу
Dialogue: 0,0:56:44.07,0:56:50.58,EDC,NTP,0000,0000,0000,,Жарық пен жарық әлемі
Dialogue: 0,0:56:50.84,0:56:57.41,EDC,NTP,0000,0000,0000,,Менің қалдырғаным осы.
Dialogue: 0,0:56:57.79,0:57:04.35,EDC,NTP,0000,0000,0000,,Мен тыныш және таң қалдым.
Dialogue: 0,0:57:04.72,0:57:11.38,EDC,NTP,0000,0000,0000,,Мен сені ұстаймын
Dialogue: 0,0:57:11.68,0:57:18.34,EDC,NTP,0000,0000,0000,,Терең сенімдер мен иллюзиялар
Dialogue: 0,0:57:18.68,0:57:25.32,EDC,NTP,0000,0000,0000,,Бұл сіздің генералыңыздың сәулесі
Dialogue: 0,0:57:25.62,0:57:32.24,EDC,NTP,0000,0000,0000,,Ағын астындағы көз жасына Сейченнен ояну
Dialogue: 0,0:57:32.58,0:57:39.23,EDC,NTP,0000,0000,0000,,Мияги Гемнің жалпы келуі
Dialogue: 0,0:57:39.56,0:57:49.38,EDC,NTP,0000,0000,0000,,Болашақ орта
Dialogue: 0,0:01:40.75,0:01:41.76,JPsub,NTP,0000,0000,0000,,Қайырлы кеш
Dialogue: 0,0:02:41.51,0:02:43.37,JPsub,NTP,0000,0000,0000,,Орта мектеп өмірінің басында
Dialogue: 0,0:02:43.62,0:02:46.85,JPsub,NTP,0000,0000,0000,,Бәріңе айтқым келетін бір нәрсе бар.
Dialogue: 0,0:02:47.39,0:02:51.01,JPsub,NTP,0000,0000,0000,,Өздеріңіз білесіздер, менің мектептегі өсиетім - еркіндік пен тәуелсіздік.
Dialogue: 0,0:03:20.90,0:03:21.52,JPsub,NTP,0000,0000,0000,,Сіз
Dialogue: 0,0:03:26.85,0:03:27.91,JPsub,NTP,0000,0000,0000,,Менің ойымша, бұл жақсы
Dialogue: 0,0:03:32.81,0:03:34.28,JPsub,NTP,0000,0000,0000,,Өйткені, сол кезде
Dialogue: 0,0:03:39.55,0:03:42.03,JPsub,NTP,0000,0000,0000,,сен кімсің
Dialogue: 0,0:04:04.80,0:04:06.16,JPsub,NTP,0000,0000,0000,,Ханшайым
Dialogue: 0,0:04:07.07,0:04:09.46,JPsub,NTP,0000,0000,0000,,Бүгін кешке ертерек келіңізші.
Dialogue: 0,0:04:29.92,0:04:31.30,JPsub,NTP,0000,0000,0000,,Түн тереңдеген сайын
Dialogue: 0,0:04:32.12,0:04:34.13,JPsub,NTP,0000,0000,0000,,Қараңғылық да қалыңдап барады
Dialogue: 0,0:04:35.75,0:04:37.63,JPsub,NTP,0000,0000,0000,,Бос қаланы аралау
Dialogue: 0,0:04:38.15,0:04:40.60,JPsub,NTP,0000,0000,0000,,Жалғыз қалғым келгендіктен деп ойлаймын.
Dialogue: 0,0:04:41.81,0:04:43.07,JPsub,NTP,0000,0000,0000,,Немесе керісінше
Dialogue: 0,0:04:43.83,0:04:47.25,JPsub,NTP,0000,0000,0000,,Мен өзімді жалғыз сезінгім келгендіктен бе?
Dialogue: 0,0:06:32.80,0:06:33.69,JPsub,NTP,0000,0000,0000,,Иә, бұл
Dialogue: 0,0:06:34.80,0:06:36.13,JPsub,NTP,0000,0000,0000,,Бұл Окинавадан келген кәдесый.
Dialogue: 0,0:06:36.35,0:06:38.08,JPsub,NTP,0000,0000,0000,,Айтпақшы, барамын дедіңіз.
Dialogue: 0,0:06:38.30,0:06:39.40,JPsub,NTP,0000,0000,0000,,Теңіз әдемі
Dialogue: 0,0:06:39.66,0:06:40.87,JPsub,NTP,0000,0000,0000,,Ауа райы да жақсы болды.
Dialogue: 0,0:06:41.14,0:06:42.30,JPsub,NTP,0000,0000,0000,,Күн сайын жүзу
Dialogue: 0,0:06:42.55,0:06:43.73,JPsub,NTP,0000,0000,0000,,Ең жақсы
Dialogue: 0,0:06:43.98,0:06:45.52,JPsub,NTP,0000,0000,0000,,Ол күйіп қалды.
Dialogue: 0,0:06:54.06,0:06:55.74,JPsub,NTP,0000,0000,0000,,Әдеттегідей әлі де керемет.
Dialogue: 0,0:06:56.81,0:06:57.61,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:07:00.33,0:07:01.68,JPsub,NTP,0000,0000,0000,,Дәл қазір дұрыс
Dialogue: 0,0:07:02.51,0:07:04.27,JPsub,NTP,0000,0000,0000,,Болашақ қиын болады.
Dialogue: 0,0:07:05.01,0:07:07.93,JPsub,NTP,0000,0000,0000,,Сіз қыста да осылай киінесіз бе?
Dialogue: 0,0:07:09.60,0:07:10.53,JPsub,NTP,0000,0000,0000,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:07:11.08,0:07:12.04,JPsub,NTP,0000,0000,0000,,Бірақ бәрібір.
Dialogue: 0,0:07:12.29,0:07:13.43,JPsub,NTP,0000,0000,0000,,Мен күртешемді киемін.
Dialogue: 0,0:07:15.98,0:07:18.65,JPsub,NTP,0000,0000,0000,,Оны кимононың үстіне киюге болады ма?
Dialogue: 0,0:07:19.58,0:07:20.36,JPsub,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:07:23.40,0:07:26.67,JPsub,NTP,0000,0000,0000,,Иә, мысалы, былғары куртка.
Dialogue: 0,0:08:12.06,0:08:13.53,JPsub,NTP,0000,0000,0000,,Сондықтан мен біреуді өлтірдім
Dialogue: 0,0:08:15.16,0:08:16.64,JPsub,NTP,0000,0000,0000,,Жазғы демалыстың соңғы күні
Dialogue: 0,0:08:17.02,0:08:19.43,JPsub,NTP,0000,0000,0000,,Батыс жағындағы сауда ауданында оқиға болды.
Dialogue: 0,0:08:20.45,0:08:22.03,JPsub,NTP,0000,0000,0000,,Бұл туралы әлі хабарланған жоқ.
Dialogue: 0,0:08:23.33,0:08:24.80,JPsub,NTP,0000,0000,0000,,Бұл тыныш емес.
Dialogue: 0,0:08:27.61,0:08:30.32,JPsub,NTP,0000,0000,0000,,Неліктен Куротоу-кун мұндай әрекетке барады?
Dialogue: 0,0:08:30.69,0:08:33.32,JPsub,NTP,0000,0000,0000,,Мен сол аймақтан біреуді білемін.
Dialogue: 0,0:08:35.15,0:08:40.69,JPsub,NTP,0000,0000,0000,,Мәйіттің қол-аяғын кесіп алып, сол жерде қалдырған көрінеді.
Dialogue: 0,0:08:41.01,0:08:42.59,JPsub,NTP,0000,0000,0000,,Тек қолдар мен аяқтар
Dialogue: 0,0:08:43.67,0:08:46.06,JPsub,NTP,0000,0000,0000,,Адамдардың өлуі үшін осының өзі жеткілікті
Dialogue: 0,0:08:49.75,0:08:54.34,JPsub,NTP,0000,0000,0000,,Қан көп жоғалса, оттегінің жетіспеуінен өмірің тоқтайды.
Dialogue: 0,0:08:58.32,0:09:01.88,JPsub,NTP,0000,0000,0000,,Бірақ бұл жағдайда сіз геморрагиялық шоктан өлуіңіз мүмкін.
Dialogue: 0,0:09:06.87,0:09:07.85,JPsub,NTP,0000,0000,0000,,Кінәлі
Dialogue: 0,0:09:22.33,0:09:23.24,JPsub,NTP,0000,0000,0000,,Аа, кешіріңіз.
Dialogue: 0,0:09:23.68,0:09:25.56,JPsub,NTP,0000,0000,0000,,Оқиғаның рәсімге еш қатысы жоқ.
Dialogue: 0,0:09:26.09,0:09:26.88,JPsub,NTP,0000,0000,0000,,Бөлек
Dialogue: 0,0:09:27.32,0:09:28.99,JPsub,NTP,0000,0000,0000,,Бұл оның қатысы жоқ дегенді білдірмейді.
Dialogue: 0,0:09:29.72,0:09:30.48,JPsub,NTP,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:09:30.73,0:09:31.45,JPsub,NTP,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:32.09,0:09:35.63,JPsub,NTP,0000,0000,0000,,Тамақтану кезінде бұл туралы айтудың қажеті жоқ.
Dialogue: 0,0:09:39.18,0:09:40.40,JPsub,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:09:55.35,0:09:56.56,JPsub,NTP,0000,0000,0000,,Дәл сол жігіт пе?
Dialogue: 0,0:09:57.02,0:09:58.75,JPsub,NTP,0000,0000,0000,,Үлкен сенімділікпен
Dialogue: 0,0:10:00.20,0:10:01.46,JPsub,NTP,0000,0000,0000,,Төртінші адам?
Dialogue: 0,0:10:08.25,0:10:09.73,JPsub,NTP,0000,0000,0000,,Бұл Жасыру
Dialogue: 0,0:10:11.33,0:10:12.73,JPsub,NTP,0000,0000,0000,,Өлгеннен кейін қанша уақыттан кейін?
Dialogue: 0,0:10:13.10,0:10:15.01,JPsub,NTP,0000,0000,0000,,А, үш сағаттай.
Dialogue: 0,0:10:18.61,0:10:19.98,JPsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:10:20.57,0:10:21.50,JPsub,NTP,0000,0000,0000,,Бүгіннен бастап
Dialogue: 0,0:10:21.79,0:10:25.20,JPsub,NTP,0000,0000,0000,,Мектептен кейінгі үйірме жұмыстарына тыйым салынады.
Dialogue: 0,0:10:26.98,0:10:30.81,JPsub,NTP,0000,0000,0000,,Барлық оқушылар, тез арада үйлеріне қайтыңдар.
Dialogue: 0,0:10:32.13,0:10:33.18,JPsub,NTP,0000,0000,0000,,Қайталаңыз
Dialogue: 0,0:10:33.72,0:10:34.84,JPsub,NTP,0000,0000,0000,,Аспанның басы қазір
Dialogue: 0,0:10:35.18,0:10:38.19,JPsub,NTP,0000,0000,0000,,Бүгіннен бастап мектептен тыс үйірме жұмыстарына тыйым салынады.
Dialogue: 0,0:10:39.12,0:10:42.69,JPsub,NTP,0000,0000,0000,,Барлық оқушылар, тез арада үйлеріне қайтыңдар.
Dialogue: 0,0:10:45.27,0:10:46.15,JPsub,NTP,0000,0000,0000,,Рёги мырза
Dialogue: 0,0:10:51.44,0:10:52.43,JPsub,NTP,0000,0000,0000,,Иә, бірақ
Dialogue: 0,0:10:52.66,0:10:53.46,JPsub,NTP,0000,0000,0000,,Мен бәрібір жақсы боламын. Бар күшімді саламын
Dialogue: 0,0:10:54.33,0:10:56.46,JPsub,NTP,0000,0000,0000,,Сіз Куротоу-кунды іздеп жүрсіз бе?
Dialogue: 0,0:10:57.48,0:10:59.38,JPsub,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:11:00.51,0:11:02.07,JPsub,NTP,0000,0000,0000,,Мен бұл көңілсіз екенін білемін, бірақ
Dialogue: 0,0:11:02.51,0:11:04.17,JPsub,NTP,0000,0000,0000,,Төрт рет тым көп болады
Dialogue: 0,0:11:51.33,0:11:52.29,JPsub,NTP,0000,0000,0000,,Менде қолшатыр бар.
Dialogue: 0,0:11:55.71,0:11:56.46,JPsub,NTP,0000,0000,0000,,Та-да!
Dialogue: 0,0:11:56.89,0:11:58.00,JPsub,NTP,0000,0000,0000,,Себебі сені алып кетуге біреу келеді.
Dialogue: 0,0:11:58.62,0:12:00.48,JPsub,NTP,0000,0000,0000,,Олай болса, оған дейін.
Dialogue: 0,0:12:02.52,0:12:03.42,JPsub,NTP,0000,0000,0000,,Мен шын мәнінде бұны киюім керек пе?
Dialogue: 0,0:13:29.13,0:13:29.86,JPsub,NTP,0000,0000,0000,,Курогири-кун
Dialogue: 0,0:13:30.27,0:13:30.89,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:13:35.00,0:13:35.68,JPsub,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:13:41.39,0:13:44.39,JPsub,NTP,0000,0000,0000,,Сіз қайда болдыңыз?
Dialogue: 0,0:13:44.67,0:13:46.55,JPsub,NTP,0000,0000,0000,,Студенттік кеңес бөлмесі
Dialogue: 0,0:13:47.05,0:13:49.44,JPsub,NTP,0000,0000,0000,,Мен ағаммен қоштасу кешін өткізіп жатыр едім.
Dialogue: 0,0:13:50.42,0:13:52.22,JPsub,NTP,0000,0000,0000,,Рио Ширазуми есімді адам
Dialogue: 0,0:13:52.78,0:13:56.75,JPsub,NTP,0000,0000,0000,,Не істегіңіз келетінін тапқандықтан, кенеттен тоқтамаңыз.
Dialogue: 0,0:14:00.30,0:14:01.64,JPsub,NTP,0000,0000,0000,,Мен сізді шақырар едім.
Dialogue: 0,0:14:02.57,0:14:04.11,JPsub,NTP,0000,0000,0000,,Неге келмедің?
Dialogue: 0,0:14:05.27,0:14:06.11,JPsub,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:14:06.31,0:14:07.39,JPsub,NTP,0000,0000,0000,,Мен байыпты болдым.
Dialogue: 0,0:14:07.86,0:14:09.25,JPsub,NTP,0000,0000,0000,,Бұл мүмкін емес пе?
Dialogue: 0,0:14:10.04,0:14:12.36,JPsub,NTP,0000,0000,0000,,Сіз не ойлап отырсыз? Формула болып табылады
Dialogue: 0,0:15:24.33,0:15:25.70,JPsub,NTP,0000,0000,0000,,Бесінші
Dialogue: 0,0:16:43.19,0:16:44.20,JPsub,NTP,0000,0000,0000,,Міне, келдік
Dialogue: 0,0:16:54.81,0:16:56.00,JPsub,NTP,0000,0000,0000,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:16:59.95,0:17:01.73,JPsub,NTP,0000,0000,0000,,Әкеңмен келісу
Dialogue: 0,0:17:01.98,0:17:03.01,JPsub,NTP,0000,0000,0000,,Қалай болды?
Dialogue: 0,0:17:03.44,0:17:05.24,JPsub,NTP,0000,0000,0000,,Түс, Акитака.
Dialogue: 0,0:17:05.56,0:17:07.41,JPsub,NTP,0000,0000,0000,,Мен киімімді өзім ауыстыра аламын.
Dialogue: 0,0:17:07.82,0:17:08.74,JPsub,NTP,0000,0000,0000,,Сіз де
Dialogue: 0,0:17:09.08,0:17:10.98,JPsub,NTP,0000,0000,0000,,Бұл маған ғана тән емес, солай ма?
Dialogue: 0,0:17:11.49,0:17:13.37,JPsub,NTP,0000,0000,0000,,Ағаның соңынан ерген жақсы.
Dialogue: 0,0:17:13.85,0:17:16.61,JPsub,NTP,0000,0000,0000,,Ақыр аяғында оның орнын басатын адам болады.
Dialogue: 0,0:17:17.32,0:17:18.01,JPsub,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:17:18.46,0:17:21.83,JPsub,NTP,0000,0000,0000,,Риоги отбасының жас ханымнан басқа мұрагері жоқ.
Dialogue: 0,0:17:22.41,0:17:26.56,JPsub,NTP,0000,0000,0000,,Ол қасиет ағамызға енбеген.
Dialogue: 0,0:17:28.89,0:17:31.82,JPsub,NTP,0000,0000,0000,,Бұл не жақсы?
Dialogue: 0,0:17:55.03,0:18:00.03,JPsub,NTP,0000,0000,0000,,Егер мен ішімде бір адам бар екенін білсем,
Dialogue: 0,0:18:01.71,0:18:04.28,JPsub,NTP,0000,0000,0000,,Ол не ойлайды?
Dialogue: 0,0:18:09.49,0:18:12.17,JPsub,NTP,0000,0000,0000,,Эй, сенің Рёгимен кездесіп жүргенің рас.
Dialogue: 0,0:18:13.81,0:18:15.77,JPsub,NTP,0000,0000,0000,,Гакуджин Бұл нені білдіреді?
Dialogue: 0,0:18:16.27,0:18:17.70,JPsub,NTP,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:18.16,0:18:22.21,JPsub,NTP,0000,0000,0000,,Қиындыққа тап болғаның белгілі.
Dialogue: 0,0:18:22.43,0:18:23.57,JPsub,NTP,0000,0000,0000,,Білу
Dialogue: 0,0:18:24.53,0:18:27.71,JPsub,NTP,0000,0000,0000,,Сондықтан мен сізді осыны есту үшін шақырдым.
Dialogue: 0,0:18:28.30,0:18:30.68,JPsub,NTP,0000,0000,0000,,Қазір түскі үзіліс, сондықтан мен ешқандай үйірме жұмыстарын жасай алмаймын.
Dialogue: 0,0:18:32.08,0:18:33.42,JPsub,NTP,0000,0000,0000,,Returning to the judo club
Dialogue: 0,0:18:34.12,0:18:36.40,JPsub,NTP,0000,0000,0000,,Жарайды, уақытты босқа өткізбей жауап бер.
Dialogue: 0,0:18:37.10,0:18:38.32,JPsub,NTP,0000,0000,0000,,Бұл түсінбеушілік.
Dialogue: 0,0:18:38.74,0:18:40.22,JPsub,NTP,0000,0000,0000,,Expressions are just friends
Dialogue: 0,0:18:40.63,0:18:42.20,JPsub,NTP,0000,0000,0000,,Басқа ештеңе жоқ
Dialogue: 0,0:18:42.81,0:18:44.09,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:18:44.63,0:18:49.21,JPsub,NTP,0000,0000,0000,,Рёги сыныптасының оны шақыруына рұқсат етпейтіні.
Dialogue: 0,0:18:51.89,0:18:53.37,JPsub,NTP,0000,0000,0000,,It's the person's wish.
Dialogue: 0,0:18:53.80,0:18:54.55,JPsub,NTP,0000,0000,0000,,Тегі
Dialogue: 0,0:18:54.72,0:18:57.06,JPsub,NTP,0000,0000,0000,,Ол Шики-сан деп атағанды да ұнатпайды.
Dialogue: 0,0:18:57.36,0:18:58.51,JPsub,NTP,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:18:59.28,0:19:02.89,JPsub,NTP,0000,0000,0000,,Мен сені бұрын Рёги-сан деп атағанымда, сен маған біртүрлі көзқараспен қарадың.
Dialogue: 0,0:19:05.98,0:19:06.99,JPsub,NTP,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:19:07.76,0:19:09.56,JPsub,NTP,0000,0000,0000,,Did you understand?
Dialogue: 0,0:19:10.40,0:19:11.30,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:19:11.51,0:19:13.53,JPsub,NTP,0000,0000,0000,,What a sexy story.
Dialogue: 0,0:19:14.19,0:19:14.86,JPsub,NTP,0000,0000,0000,,Рычаг дегеніміз не?
Dialogue: 0,0:19:15.16,0:19:18.07,JPsub,NTP,0000,0000,0000,,Isn't it a shelter from the rain?
Dialogue: 0,0:19:20.07,0:19:20.76,JPsub,NTP,0000,0000,0000,,Қазірше тек сен мен мен ғана оралдық.
Dialogue: 0,0:19:21.50,0:19:23.05,JPsub,NTP,0000,0000,0000,,Бұған қалай батылы бардың?
Dialogue: 0,0:19:23.54,0:19:24.41,JPsub,NTP,0000,0000,0000,,Сонымен
Dialogue: 0,0:19:24.85,0:19:26.15,JPsub,NTP,0000,0000,0000,,Ryogi is floating though
Dialogue: 0,0:19:26.43,0:19:28.07,JPsub,NTP,0000,0000,0000,,Are you worried about everyone?
Dialogue: 0,0:19:29.06,0:19:30.04,JPsub,NTP,0000,0000,0000,,Even if it's about not getting stuck
Dialogue: 0,0:19:30.25,0:19:31.81,JPsub,NTP,0000,0000,0000,,Тақырыптар жеткілікті.
Dialogue: 0,0:19:33.29,0:19:35.83,JPsub,NTP,0000,0000,0000,,Бұл дайындық мектебі, солай ма?
Dialogue: 0,0:19:36.41,0:19:37.75,JPsub,NTP,0000,0000,0000,,Бұл менің ағам туралы.
Dialogue: 0,0:19:38.00,0:19:39.78,JPsub,NTP,0000,0000,0000,,Жұмыспен қамту көрсеткіші жақсы.
Dialogue: 0,0:19:41.73,0:19:44.83,JPsub,NTP,0000,0000,0000,,But what are you doing?
Dialogue: 0,0:19:45.41,0:19:47.62,JPsub,NTP,0000,0000,0000,,Қалай қарасаңыз да, суретке сәйкес келмейді.
Dialogue: 0,0:19:49.08,0:19:51.49,JPsub,NTP,0000,0000,0000,,Өрнек соншалықты қорқынышты емес.
Dialogue: 0,0:19:52.40,0:19:56.10,JPsub,NTP,0000,0000,0000,,Who is nothing but a friend?
Dialogue: 0,0:19:57.14,0:19:59.57,JPsub,NTP,0000,0000,0000,,She's a tough woman.
Dialogue: 0,0:20:03.71,0:20:05.29,JPsub,NTP,0000,0000,0000,,That it cannot be separated
Dialogue: 0,0:20:05.63,0:20:07.83,JPsub,NTP,0000,0000,0000,,Бұл сіздің қазірдің өзінде жынды екендігіңіздің дәлелі емес пе?
Dialogue: 0,0:20:08.42,0:20:09.99,JPsub,NTP,0000,0000,0000,,Мен мұны білемін.
Dialogue: 0,0:20:11.39,0:20:12.81,JPsub,NTP,0000,0000,0000,,So what's the point?
Dialogue: 0,0:20:13.11,0:20:13.93,JPsub,NTP,0000,0000,0000,,Сіз қарай аласыз ба?
Dialogue: 0,0:20:15.24,0:20:17.74,JPsub,NTP,0000,0000,0000,,Өрнектерде де сүйкімді нәрсе бар.
Dialogue: 0,0:20:18.24,0:20:19.73,JPsub,NTP,0000,0000,0000,,If you compare it to an animal
Dialogue: 0,0:20:20.00,0:20:20.86,JPsub,NTP,0000,0000,0000,,Қоян
Dialogue: 0,0:20:21.68,0:20:24.29,JPsub,NTP,0000,0000,0000,,Жалғыздықтан өлесің бе?
Dialogue: 0,0:20:58.12,0:20:59.08,JPsub,NTP,0000,0000,0000,,Йо Кокто
Dialogue: 0,0:21:00.25,0:21:01.36,JPsub,NTP,0000,0000,0000,,Күттіңіз бе?
Dialogue: 0,0:21:02.17,0:21:03.11,JPsub,NTP,0000,0000,0000,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:21:03.51,0:21:06.09,JPsub,NTP,0000,0000,0000,,Акитаканы себуге тым көп уақыт кетті.
Dialogue: 0,0:21:08.83,0:21:09.53,JPsub,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:21:09.90,0:21:12.42,JPsub,NTP,0000,0000,0000,,Бір сағаттай кешігіп келгеніңізге ашулысыз ба?
Dialogue: 0,0:21:14.12,0:21:16.68,JPsub,NTP,0000,0000,0000,,Сіз сондай тар адамсыз.
Dialogue: 0,0:21:17.27,0:21:18.29,JPsub,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:21:18.39,0:21:20.28,JPsub,NTP,0000,0000,0000,,It's a formula, isn't it?
Dialogue: 0,0:21:20.69,0:21:23.36,JPsub,NTP,0000,0000,0000,,Oh, what else does it look like?
Dialogue: 0,0:21:23.85,0:21:25.82,JPsub,NTP,0000,0000,0000,,Одан гөрі уақытты босқа кетіру.
Dialogue: 0,0:21:26.04,0:21:27.65,JPsub,NTP,0000,0000,0000,,Leave the destination to Cocteau
Dialogue: 0,0:21:28.20,0:21:29.53,JPsub,NTP,0000,0000,0000,,Кеттік
Dialogue: 0,0:22:17.01,0:22:20.49,JPsub,NTP,0000,0000,0000,,Қарапайым тілмен айтқанда, оның екі жақты тұлғасы бар ма?
Dialogue: 0,0:22:23.09,0:22:24.13,JPsub,NTP,0000,0000,0000,,Мен Оримін
Dialogue: 0,0:22:24.71,0:22:26.71,JPsub,NTP,0000,0000,0000,,Usually the expression is better
Dialogue: 0,0:22:27.66,0:22:30.60,JPsub,NTP,0000,0000,0000,,But me and Shiki are not different people.
Dialogue: 0,0:22:31.11,0:22:33.14,JPsub,NTP,0000,0000,0000,,Both rituals are always one.
Dialogue: 0,0:22:34.31,0:22:35.73,JPsub,NTP,0000,0000,0000,,The difference between me and Shiki is
Dialogue: 0,0:22:36.13,0:22:39.25,JPsub,NTP,0000,0000,0000,,Менің ойымша, бұл заттардың басымдылығына байланысты.
Dialogue: 0,0:22:39.81,0:22:41.33,JPsub,NTP,0000,0000,0000,,Басымдық
Dialogue: 0,0:22:42.04,0:22:44.15,JPsub,NTP,0000,0000,0000,,I wanted to talk to Cocteau.
Dialogue: 0,0:22:44.52,0:22:45.47,JPsub,NTP,0000,0000,0000,,Осымен
Dialogue: 0,0:22:46.24,0:22:49.15,JPsub,NTP,0000,0000,0000,,Өйткені Шики мұны көп істегісі келмейді.
Dialogue: 0,0:22:49.36,0:22:51.15,JPsub,NTP,0000,0000,0000,,I'm doing it for you.
Dialogue: 0,0:22:52.17,0:22:52.95,JPsub,NTP,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:22:53.41,0:22:54.96,JPsub,NTP,0000,0000,0000,,Қалай болғанда да
Dialogue: 0,0:22:55.69,0:22:57.81,JPsub,NTP,0000,0000,0000,,But why are you telling me that?
Dialogue: 0,0:22:59.20,0:23:01.87,JPsub,NTP,0000,0000,0000,,Өйткені мен оны енді жасыра алмайтын сияқты болдым
Dialogue: 0,0:23:09.55,0:23:10.86,JPsub,NTP,0000,0000,0000,,Мен мойындаймын
Dialogue: 0,0:23:11.40,0:23:14.12,JPsub,NTP,0000,0000,0000,,Мен деструктивті талпыныс бар формула сияқтымын.
Dialogue: 0,0:23:14.88,0:23:17.12,JPsub,NTP,0000,0000,0000,,That's the feeling I want the most
Dialogue: 0,0:23:18.31,0:23:21.40,JPsub,NTP,0000,0000,0000,,But until now, I didn't have that person.
Dialogue: 0,0:23:24.07,0:23:25.31,JPsub,NTP,0000,0000,0000,,Бірақ уайымдамаңыз.
Dialogue: 0,0:23:25.81,0:23:26.96,JPsub,NTP,0000,0000,0000,,Тоны басқа болғанымен
Dialogue: 0,0:23:27.20,0:23:28.57,JPsub,NTP,0000,0000,0000,,I'm still a formula
Dialogue: 0,0:23:28.99,0:23:31.15,JPsub,NTP,0000,0000,0000,,I won't suddenly start acting violent.
Dialogue: 0,0:23:32.38,0:23:33.23,JPsub,NTP,0000,0000,0000,,Бірақ жақсы
Dialogue: 0,0:23:33.70,0:23:36.13,JPsub,NTP,0000,0000,0000,,He and I have been out of sync lately.
Dialogue: 0,0:23:37.63,0:23:38.30,JPsub,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:23:38.76,0:23:42.44,JPsub,NTP,0000,0000,0000,,Сіз қалай әрекет етсеңіз де, денеңізді пайдалану құқығы ресми болып табылады.
Dialogue: 0,0:23:43.06,0:23:45.01,JPsub,NTP,0000,0000,0000,,This is how I met Cocteau.
Dialogue: 0,0:23:45.32,0:23:47.41,JPsub,NTP,0000,0000,0000,,Өйткені Шики кездесуге жарайды деп ойлады.
Dialogue: 0,0:23:48.14,0:23:48.74,JPsub,NTP,0000,0000,0000,,Мұның бәрі тек менің алаңдаған жүрегімді жылдамдатты
Dialogue: 0,0:23:49.07,0:23:52.17,JPsub,NTP,0000,0000,0000,,Осылай айтсам, кейін өкінемін.
Dialogue: 0,0:23:53.83,0:23:55.74,JPsub,NTP,0000,0000,0000,,Коктомен танысқан дұрыс
Dialogue: 0,0:23:55.90,0:23:58.16,JPsub,NTP,0000,0000,0000,,It's not a line that Shiki says.
Dialogue: 0,0:23:58.98,0:23:59.93,JPsub,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:24:01.49,0:24:03.82,JPsub,NTP,0000,0000,0000,,I like that kind of thing about you.
Dialogue: 0,0:24:04.65,0:24:05.29,JPsub,NTP,0000,0000,0000,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:24:05.59,0:24:07.36,JPsub,NTP,0000,0000,0000,,I don't like that kind of expression.
Dialogue: 0,0:24:08.15,0:24:09.91,JPsub,NTP,0000,0000,0000,,This is what misalignment means.
Dialogue: 0,0:24:12.08,0:24:13.13,JPsub,NTP,0000,0000,0000,,Бүгінгі күннің бәрі осы
Dialogue: 0,0:24:20.50,0:24:21.29,JPsub,NTP,0000,0000,0000,,Сонда кездескенше
Dialogue: 0,0:24:23.88,0:24:26.26,JPsub,NTP,0000,0000,0000,,Өйткені сен маған ұнайсың
Dialogue: 0,0:24:26.67,0:24:28.33,JPsub,NTP,0000,0000,0000,,Жақында тағы кездесеміз.
Dialogue: 0,0:24:33.56,0:24:34.95,JPsub,NTP,0000,0000,0000,,Иә шай
Dialogue: 0,0:24:35.41,0:24:36.94,JPsub,NTP,0000,0000,0000,,Рахмет, апай.
Dialogue: 0,0:24:37.83,0:24:40.31,JPsub,NTP,0000,0000,0000,,Екеуміз де сол әдетімізден арыла алмаймыз.
Dialogue: 0,0:24:41.11,0:24:42.64,JPsub,NTP,0000,0000,0000,,Қанымнан шыққан ба деп ойлаймын.
Dialogue: 0,0:24:43.01,0:24:44.96,JPsub,NTP,0000,0000,0000,,Осылайша қабығын аршып, тізіп қоясыз.
Dialogue: 0,0:24:45.36,0:24:47.55,JPsub,NTP,0000,0000,0000,,Жоғалған ағам да солай істейтін.
Dialogue: 0,0:24:48.42,0:24:49.69,JPsub,NTP,0000,0000,0000,,Кешкі асқа аз қалды.
Dialogue: 0,0:24:49.99,0:24:51.62,JPsub,NTP,0000,0000,0000,,Көп жемеген дұрыс.
Dialogue: 0,0:24:54.87,0:24:56.51,JPsub,NTP,0000,0000,0000,,Дайсуке-чан тамақ ішеді.
Dialogue: 0,0:24:57.16,0:24:59.29,JPsub,NTP,0000,0000,0000,,Айтпақшы, бүгінгі кешкі ас мәзірі
Dialogue: 0,0:25:00.12,0:25:01.02,JPsub,NTP,0000,0000,0000,,Соқамен гриль жасау
Dialogue: 0,0:25:01.50,0:25:03.27,JPsub,NTP,0000,0000,0000,,Itadadakimasu
Dialogue: 0,0:25:04.48,0:25:09.28,JPsub,NTP,0000,0000,0000,,Мысалы, мен Дайсуке-санға қандай мәзір ұнайтынын білгім келеді.
Dialogue: 0,0:25:11.75,0:25:13.18,JPsub,NTP,0000,0000,0000,,Болашаққа келетін болсақ
Dialogue: 0,0:25:13.75,0:25:17.61,JPsub,NTP,0000,0000,0000,,Екінші адамның денесі екіге бөлінген
Dialogue: 0,0:25:17.94,0:25:20.14,JPsub,NTP,0000,0000,0000,,Үшінші адамның қол-аяғын кесіп тастаған.
Dialogue: 0,0:25:20.48,0:25:23.60,JPsub,NTP,0000,0000,0000,,Қол аяққа, аяқ қолға тігілген.
Dialogue: 0,0:25:24.13,0:25:25.93,JPsub,NTP,0000,0000,0000,,Төртінші бөліктерге кесілген.
Dialogue: 0,0:25:26.39,0:25:29.10,JPsub,NTP,0000,0000,0000,,Ол таңбаға ұқсайтын нәрсемен белгіленді.
Dialogue: 0,0:25:31.17,0:25:36.36,JPsub,NTP,0000,0000,0000,,Ал, бесінші адам мойнын ортасына қойып, қолдары мен аяқтарымен свастика жасап жатқанға ұқсайды.
Dialogue: 0,0:25:36.89,0:25:38.97,JPsub,NTP,0000,0000,0000,,Ол оңай түсінікті қалыптан тыс адам.
Dialogue: 0,0:25:39.26,0:25:42.93,JPsub,NTP,0000,0000,0000,,Аа, түсінуге оңай болу да жасанды.
Dialogue: 0,0:25:43.67,0:25:44.41,JPsub,NTP,0000,0000,0000,,Микия
Dialogue: 0,0:25:44.91,0:25:46.22,JPsub,NTP,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:25:46.75,0:25:49.14,JPsub,NTP,0000,0000,0000,,Бұл кәсіби пікір емес.
Dialogue: 0,0:25:50.04,0:25:50.78,JPsub,NTP,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:25:51.24,0:25:51.93,JPsub,NTP,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:25:52.39,0:25:54.29,JPsub,NTP,0000,0000,0000,,Мен үйреніп бара жатырмын
Dialogue: 0,0:25:55.33,0:25:57.20,JPsub,NTP,0000,0000,0000,,Мотив жоқ, заңдылық жоқ
Dialogue: 0,0:25:57.73,0:25:58.91,JPsub,NTP,0000,0000,0000,,Тек қазір сыртта
Dialogue: 0,0:25:59.13,0:26:01.18,JPsub,NTP,0000,0000,0000,,Түнде кездесетін олжа болмаса
Dialogue: 0,0:26:01.52,0:26:03.78,JPsub,NTP,0000,0000,0000,,Олар сіздің үйіңізге кіруі мүмкін.
Dialogue: 0,0:26:05.28,0:26:05.97,JPsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:26:06.31,0:26:08.29,JPsub,NTP,0000,0000,0000,,Бұдан былай бұл құпия.
Dialogue: 0,0:26:08.99,0:26:09.93,JPsub,NTP,0000,0000,0000,,Жарайды.
Dialogue: 0,0:26:10.33,0:26:12.39,JPsub,NTP,0000,0000,0000,,Егер ол құпия болса, оны мәжбүрлемеңіз.
Dialogue: 0,0:26:12.77,0:26:13.78,JPsub,NTP,0000,0000,0000,,бірақ манга суретшісінің үйіне алты минут ерте бару—
Dialogue: 0,0:26:14.18,0:26:15.42,JPsub,NTP,0000,0000,0000,,Сіз сөйлескіңіз келеді, солай ма?
Dialogue: 0,0:26:15.94,0:26:16.92,JPsub,NTP,0000,0000,0000,,Олай емес
Dialogue: 0,0:26:17.59,0:26:21.14,JPsub,NTP,0000,0000,0000,,Сіз де туыс емессіз, маған айтыңызшы.
Dialogue: 0,0:26:22.51,0:26:23.78,JPsub,NTP,0000,0000,0000,,Оқиға орнындағы бесінші адам
Dialogue: 0,0:26:24.10,0:26:25.74,JPsub,NTP,0000,0000,0000,,Осыған ұқсас нәрсе жойылды
Dialogue: 0,0:26:27.30,0:26:28.57,JPsub,NTP,0000,0000,0000,,Бұл менің...
Dialogue: 0,0:26:28.86,0:26:32.44,JPsub,NTP,0000,0000,0000,,А, бұл сенің мектебіңнің эмблемасы.
Dialogue: 0,0:26:34.47,0:26:37.56,JPsub,NTP,0000,0000,0000,,Мен жақын арада сонда баратын шығармын.
Dialogue: 0,0:26:38.61,0:26:39.34,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:26:42.21,0:26:43.51,JPsub,NTP,0000,0000,0000,,Қазіргі
Dialogue: 0,0:26:44.37,0:26:45.59,JPsub,NTP,0000,0000,0000,,Қажет емес
Dialogue: 0,0:26:46.13,0:26:48.05,JPsub,NTP,0000,0000,0000,,Апай, мен сізге немен көмектесе аламын?
Dialogue: 0,0:26:48.47,0:26:50.02,JPsub,NTP,0000,0000,0000,,Мен бүгін кеңсеге қайтамын.
Dialogue: 0,0:26:50.51,0:26:52.17,JPsub,NTP,0000,0000,0000,,А, сағат тоғыз шамасында.
Dialogue: 0,0:26:59.69,0:27:01.13,JPsub,NTP,0000,0000,0000,,Үшінші семестр қашан басталады
Dialogue: 0,0:27:01.42,0:27:04.32,JPsub,NTP,0000,0000,0000,,Өрнек оқшаулауды күшейтті.
Dialogue: 0,0:27:06.86,0:27:11.75,JPsub,NTP,0000,0000,0000,,Ол тіпті мен айта алатындай дәрежеде бас тарту ниетін көрсетті.
Dialogue: 0,0:27:15.31,0:27:16.50,JPsub,NTP,0000,0000,0000,,Сәлем Кокто
Dialogue: 0,0:27:17.22,0:27:20.07,JPsub,NTP,0000,0000,0000,,Мен адамдарды жек көретінімді айттым ба?
Dialogue: 0,0:27:21.29,0:27:24.02,JPsub,NTP,0000,0000,0000,,Мен оны бірінші рет естіп тұрмын, бірақ бұл шындық.
Dialogue: 0,0:27:24.64,0:27:28.47,JPsub,NTP,0000,0000,0000,,Иә, Шики бала кезінен адамдарды жек көреді.
Dialogue: 0,0:27:29.41,0:27:33.35,JPsub,NTP,0000,0000,0000,,Қарашы, сен бала кезіңде ештеңе білмейсің.
Dialogue: 0,0:27:34.03,0:27:35.44,JPsub,NTP,0000,0000,0000,,Кездескендердің барлығы
Dialogue: 0,0:27:35.58,0:27:39.18,JPsub,NTP,0000,0000,0000,,Дүниедегі барлық нәрсе сізді сөзсіз жақсы көреді деп ойлайсыз.
Dialogue: 0,0:27:39.83,0:27:41.24,JPsub,NTP,0000,0000,0000,,Сізге өзіңізді ұнатасыз ба?
Dialogue: 0,0:27:41.49,0:27:44.50,JPsub,NTP,0000,0000,0000,,Басқа адам да сізді табиғи түрде жақсы көреді
Dialogue: 0,0:27:44.85,0:27:46.42,JPsub,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:27:47.52,0:27:48.47,JPsub,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:27:49.15,0:27:51.77,JPsub,NTP,0000,0000,0000,,Надан Кокто қалу керек
Dialogue: 0,0:27:52.68,0:27:54.37,JPsub,NTP,0000,0000,0000,,Түсінбеушілік болса да
Dialogue: 0,0:27:54.83,0:27:57.90,JPsub,NTP,0000,0000,0000,,Сүйікті болу сезімі тәжірибеге айналады
Dialogue: 0,0:27:58.45,0:28:00.88,JPsub,NTP,0000,0000,0000,,Біреуге мейірімді бола аласыз
Dialogue: 0,0:28:01.41,0:28:05.25,JPsub,NTP,0000,0000,0000,,Адамдар тек өз сезімдерін айта алады
Dialogue: 0,0:28:06.48,0:28:07.92,JPsub,NTP,0000,0000,0000,,Бірақ мен басқашамын.
Dialogue: 0,0:28:08.76,0:28:10.99,JPsub,NTP,0000,0000,0000,,Мен туғаннан басқа біреуді білдім.
Dialogue: 0,0:28:11.79,0:28:14.21,JPsub,NTP,0000,0000,0000,,Өйткені Шикидің ішінде мен бар
Dialogue: 0,0:28:16.09,0:28:19.13,JPsub,NTP,0000,0000,0000,,Бала кезіңізде басқалардың шіркіндігін қалай білдіңіз?
Dialogue: 0,0:28:19.51,0:28:21.64,JPsub,NTP,0000,0000,0000,,Оларды сүйе алмадым
Dialogue: 0,0:28:22.45,0:28:24.90,JPsub,NTP,0000,0000,0000,,Өрнектегі жалғыз эмоция - бас тарту.
Dialogue: 0,0:28:27.64,0:28:31.62,JPsub,NTP,0000,0000,0000,,Бірақ сен жалғыз болған шығарсың.
Dialogue: 0,0:28:31.92,0:28:32.70,JPsub,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:28:34.04,0:28:35.77,JPsub,NTP,0000,0000,0000,,Өрнегі мен
Dialogue: 0,0:28:39.19,0:28:42.40,JPsub,NTP,0000,0000,0000,,Мен оқшауландым, бірақ жалғыз емес.
Dialogue: 0,0:28:43.64,0:28:45.66,JPsub,NTP,0000,0000,0000,,Бірақ соңғы формула біртүрлі.
Dialogue: 0,0:28:46.36,0:28:49.39,JPsub,NTP,0000,0000,0000,,Менің ішімде әдеттен тыс адам болса да
Dialogue: 0,0:28:49.87,0:28:51.53,JPsub,NTP,0000,0000,0000,,оны жоққа шығарғысы келеді
Dialogue: 0,0:28:52.20,0:28:54.07,JPsub,NTP,0000,0000,0000,,Бас тарту – менің доменім.
Dialogue: 0,0:28:54.78,0:28:57.71,JPsub,NTP,0000,0000,0000,,Формула тек растаушы бола алады, солай ма?
Dialogue: 0,0:28:59.38,0:29:00.61,JPsub,NTP,0000,0000,0000,,Неге деп ойлаймын
Dialogue: 0,0:29:05.11,0:29:05.92,JPsub,NTP,0000,0000,0000,,Кокто
Dialogue: 0,0:29:06.39,0:29:08.65,JPsub,NTP,0000,0000,0000,,Сіз біреуді өлтіргіңіз келді ме?
Dialogue: 0,0:29:09.55,0:29:10.99,JPsub,NTP,0000,0000,0000,,Қазіргі уақытта жоқ.
Dialogue: 0,0:29:11.24,0:29:12.08,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:29:12.41,0:29:14.15,JPsub,NTP,0000,0000,0000,,Бірақ менде осы ғана
Dialogue: 0,0:29:15.48,0:29:19.13,JPsub,NTP,0000,0000,0000,,Мен Шикидің қуғын-сүргінге ұшыраған ниетін басқаратын тұлғамын.
Dialogue: 0,0:29:19.95,0:29:22.02,JPsub,NTP,0000,0000,0000,,Сондықтан мен әрқашан ерікті өлтіре алатынмын.
Dialogue: 0,0:29:23.02,0:29:25.09,JPsub,NTP,0000,0000,0000,,Мен қараңғылықты өлтіре алдым.
Dialogue: 0,0:29:25.84,0:29:29.68,JPsub,NTP,0000,0000,0000,,Мен өзімді қайта-қайта өлтіре аламын
Dialogue: 0,0:29:30.77,0:29:34.89,JPsub,NTP,0000,0000,0000,,Мен айттым ғой, адамдар тек өз эмоцияларын айта алады.
Dialogue: 0,0:29:36.28,0:29:37.12,JPsub,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:29:37.52,0:29:39.78,JPsub,NTP,0000,0000,0000,,Менің басымнан өткен эмоциялар
Dialogue: 0,0:29:40.47,0:29:41.92,JPsub,NTP,0000,0000,0000,,Тек кісі өлтіру
Dialogue: 0,0:29:44.23,0:29:45.78,JPsub,NTP,0000,0000,0000,,Сондықтан Кокто
Dialogue: 0,0:29:46.55,0:29:48.31,JPsub,NTP,0000,0000,0000,,Ресми кісі өлтірудің анықтамасы
Dialogue: 0,0:29:49.90,0:29:51.86,JPsub,NTP,0000,0000,0000,,Бұл мені өлтіруді білдіреді.
Dialogue: 0,0:29:53.09,0:29:56.57,JPsub,NTP,0000,0000,0000,,Мен сияқты жігіт сыртқа шығуға тырысқанның бәрін өлтіремін.
Dialogue: 0,0:29:57.61,0:29:58.54,JPsub,NTP,0000,0000,0000,,Формуласы
Dialogue: 0,0:29:58.92,0:30:04.19,JPsub,NTP,0000,0000,0000,,Өзімді қорғау үшін формуланы ашуға тырысқандардың барлығын өлтіргім келеді.
Dialogue: 0,0:30:22.92,0:30:23.58,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:30:24.21,0:30:25.64,JPsub,NTP,0000,0000,0000,,Бірге тамақтанайық
Dialogue: 0,0:30:28.93,0:30:30.55,JPsub,NTP,0000,0000,0000,,Бұл Жолиненің брошы
Dialogue: 0,0:30:31.76,0:30:32.49,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:30:33.24,0:30:35.35,JPsub,NTP,0000,0000,0000,,Сіз аздап ашуланған сияқтысыз.
Dialogue: 0,0:30:35.83,0:30:36.67,JPsub,NTP,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:30:39.22,0:30:40.69,JPsub,NTP,0000,0000,0000,,Мен сенімді емеспін
Dialogue: 0,0:30:40.84,0:30:43.59,JPsub,NTP,0000,0000,0000,,Бірақ мен Курогири-кун қасында болғанда тітіркенемін.
Dialogue: 0,0:30:44.25,0:30:46.87,JPsub,NTP,0000,0000,0000,,Сен неге менімен араластың?
Dialogue: 0,0:30:47.23,0:30:50.11,JPsub,NTP,0000,0000,0000,,Осының бәрі айтылғаннан кейін де, неге сіздің көзқарасыңыз өзгерген жоқ?
Dialogue: 0,0:30:50.32,0:30:51.35,JPsub,NTP,0000,0000,0000,,Мен нені түсінбеймін
Dialogue: 0,0:30:51.85,0:30:53.94,JPsub,NTP,0000,0000,0000,,Мен себебін білмеймін
Dialogue: 0,0:30:54.58,0:30:56.45,JPsub,NTP,0000,0000,0000,,Шикимен бірге болу қызық.
Dialogue: 0,0:30:56.81,0:30:59.13,JPsub,NTP,0000,0000,0000,,Неліктен қызық екеніне жауап бере алмаймын.
Dialogue: 0,0:30:59.76,0:31:00.46,JPsub,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:31:00.83,0:31:04.86,JPsub,NTP,0000,0000,0000,,Кешегі күн туралы айтсаң, мен оптимист шығармын.
Dialogue: 0,0:31:05.69,0:31:06.87,JPsub,NTP,0000,0000,0000,,Курогири-кун
Dialogue: 0,0:31:07.40,0:31:09.70,JPsub,NTP,0000,0000,0000,,Мен ақымақ екенімді түсінемін.
Dialogue: 0,0:31:10.98,0:31:11.72,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:31:12.03,0:31:13.45,JPsub,NTP,0000,0000,0000,,Бұл өте ерекше.
Dialogue: 0,0:31:14.05,0:31:15.04,JPsub,NTP,0000,0000,0000,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:31:15.53,0:31:17.27,JPsub,NTP,0000,0000,0000,,онда сіз мұны мойындауыңыз керек
Dialogue: 0,0:31:17.98,0:31:20.89,JPsub,NTP,0000,0000,0000,,Мен әдетте қатыса алатын адам емеспін.
Dialogue: 0,0:31:23.21,0:31:26.39,JPsub,NTP,0000,0000,0000,,Танысуға келгенде бұл қалыпты немесе қалыпты емес пе маңызды емес.
Dialogue: 0,0:31:28.24,0:31:31.56,JPsub,NTP,0000,0000,0000,,Бірақ мен сен сияқты бола алмаймын
Dialogue: 0,0:31:34.68,0:31:35.39,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:31:35.70,0:31:36.56,JPsub,NTP,0000,0000,0000,,Жара
Dialogue: 0,0:31:39.58,0:31:42.17,JPsub,NTP,0000,0000,0000,,Бұл өткен күні бір-бірімізді өлтірген кездегі менің жарам.
Dialogue: 0,0:31:42.89,0:31:44.04,JPsub,NTP,0000,0000,0000,,Әлі жоқ
Dialogue: 0,0:31:47.18,0:31:49.31,JPsub,NTP,0000,0000,0000,,Сөзбен жеткізе алмасаң
Dialogue: 0,0:31:49.72,0:31:51.13,JPsub,NTP,0000,0000,0000,,Мен сізге айтамын
Dialogue: 0,0:31:51.78,0:31:52.87,JPsub,NTP,0000,0000,0000,,Егер бұл жалғаса берсе
Dialogue: 0,0:31:53.40,0:31:55.54,JPsub,NTP,0000,0000,0000,,Мен сені өлтіретініме сенімдімін
Dialogue: 0,0:32:10.84,0:32:12.40,JPsub,NTP,0000,0000,0000,,Ғалым айтқандай.
Dialogue: 0,0:32:13.65,0:32:14.41,JPsub,NTP,0000,0000,0000,,О
Dialogue: 0,0:32:14.82,0:32:17.00,JPsub,NTP,0000,0000,0000,,Мен ертерек байқаған болар едім.
Dialogue: 0,0:32:17.94,0:32:20.96,JPsub,NTP,0000,0000,0000,,Мен көптен бері жынды болдым.
Dialogue: 0,0:32:23.61,0:32:24.48,JPsub,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:32:25.53,0:32:26.38,JPsub,NTP,0000,0000,0000,,Қайта оралдын.
Dialogue: 0,0:32:27.13,0:32:29.03,JPsub,NTP,0000,0000,0000,,Дайсуке-нии-сан келе жатыр.
Dialogue: 0,0:32:29.50,0:32:30.34,JPsub,NTP,0000,0000,0000,,Мен сондамын.
Dialogue: 0,0:32:33.09,0:32:33.89,JPsub,NTP,0000,0000,0000,,Келіңіздер!
Dialogue: 0,0:32:34.14,0:32:34.65,JPsub,NTP,0000,0000,0000,,О
Dialogue: 0,0:32:34.89,0:32:35.87,JPsub,NTP,0000,0000,0000,,Сіз қайтып келдіңіз бе?
Dialogue: 0,0:32:36.22,0:32:37.48,JPsub,NTP,0000,0000,0000,,Бүгін не болды?
Dialogue: 0,0:32:37.69,0:32:38.76,JPsub,NTP,0000,0000,0000,,Түнгі ауысымға дайындалу
Dialogue: 0,0:32:39.02,0:32:40.75,JPsub,NTP,0000,0000,0000,,Мен қысқа үзіліс алдым.
Dialogue: 0,0:32:41.38,0:32:43.56,JPsub,NTP,0000,0000,0000,,Сериялық кісі өлтіру ісі
Dialogue: 0,0:32:43.81,0:32:44.40,JPsub,NTP,0000,0000,0000,,О
Dialogue: 0,0:32:44.70,0:32:47.06,JPsub,NTP,0000,0000,0000,,Алтыншы бала үш күн бұрын пайда болды.
Dialogue: 0,0:32:47.20,0:32:48.95,JPsub,NTP,0000,0000,0000,,Өйткені
Dialogue: 0,0:32:49.19,0:32:50.91,JPsub,NTP,0000,0000,0000,,Ақпарат шектелген
Dialogue: 0,0:32:51.15,0:32:56.01,JPsub,NTP,0000,0000,0000,,Жоғарыдағылар әлемді бұл жағдайға алаңдатудың кері әсері болады деп шешкен сияқты.
Dialogue: 0,0:33:00.20,0:33:02.17,JPsub,NTP,0000,0000,0000,,Сен менің мектебіме келемін дедің.
Dialogue: 0,0:33:02.70,0:33:03.87,JPsub,NTP,0000,0000,0000,,Бұған не болды?
Dialogue: 0,0:33:04.31,0:33:05.44,JPsub,NTP,0000,0000,0000,,Оңтүстік аймақтардың бас қолбасшысы Доти Пиксис
Dialogue: 0,0:33:05.74,0:33:07.66,JPsub,NTP,0000,0000,0000,,Өткен күні мені қызықтырмаған сияқты.
Dialogue: 0,0:33:08.03,0:33:10.06,JPsub,NTP,0000,0000,0000,,Сіз бүгін белсендісіз бе?
Dialogue: 0,0:33:10.70,0:33:11.59,JPsub,NTP,0000,0000,0000,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:33:12.10,0:33:13.68,JPsub,NTP,0000,0000,0000,,Сұрақтарыңыз болса, маған хабарлаңыз.
Dialogue: 0,0:33:15.20,0:33:19.31,JPsub,NTP,0000,0000,0000,,А, алтыншы әйелдің тырнағынан тері анықталды.
Dialogue: 0,0:33:19.81,0:33:23.19,JPsub,NTP,0000,0000,0000,,Менің ойымша, ол қылмыскерге қатты қарсылық көрсетті.
Dialogue: 0,0:33:23.39,0:33:25.42,JPsub,NTP,0000,0000,0000,,Қылмыскер жарақат алған тұтқа
Dialogue: 0,0:33:25.58,0:33:30.89,JPsub,NTP,0000,0000,0000,,Иә, бұл шынтақ аймағы қатты кесілген және ойылған деген сот сарапшысының пікірі.
Dialogue: 0,0:33:32.76,0:33:34.49,JPsub,NTP,0000,0000,0000,,Қан анализін де жасаймыз.
Dialogue: 0,0:33:34.83,0:33:36.66,JPsub,NTP,0000,0000,0000,,Келесі мат
Dialogue: 0,0:33:44.56,0:33:46.12,JPsub,NTP,0000,0000,0000,,Не болды, Микия?
Dialogue: 0,0:33:46.55,0:33:47.81,JPsub,NTP,0000,0000,0000,,Сіз бозарған сияқтысыз.
Dialogue: 0,0:33:50.57,0:33:51.74,JPsub,NTP,0000,0000,0000,,Менің бір болжамым бар еді.
Dialogue: 0,0:33:52.50,0:33:56.32,JPsub,NTP,0000,0000,0000,,Оның мәйіттің алдында отырған бейнесі
Dialogue: 0,0:34:11.39,0:34:12.29,JPsub,NTP,0000,0000,0000,,Сіз алыстасыз ба?
Dialogue: 0,0:34:12.90,0:34:13.86,JPsub,NTP,0000,0000,0000,,Түсінікті
Dialogue: 0,0:34:14.70,0:34:16.85,JPsub,NTP,0000,0000,0000,,Кеш болғаны үшін кешіріңіз.
Dialogue: 0,0:34:17.83,0:34:18.97,JPsub,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:34:35.20,0:34:38.22,JPsub,NTP,0000,0000,0000,,Бала кезімде елестерден қорқатынмын.
Dialogue: 0,0:34:38.89,0:34:42.14,JPsub,NTP,0000,0000,0000,,Мен қорқатынмын, өйткені бамбук орманындағы көлеңкелер құбыжықтарға ұқсайды.
Dialogue: 0,0:34:42.71,0:34:43.60,JPsub,NTP,0000,0000,0000,,Алайда
Dialogue: 0,0:34:43.79,0:34:45.24,JPsub,NTP,0000,0000,0000,,Мен қазір адамдардан қорқамын.
Dialogue: 0,0:34:46.45,0:34:50.93,JPsub,NTP,0000,0000,0000,,Қорқынышты жалғыз нәрсе - біреу бамбук орманында жасырынып жатыр деген елес.
Dialogue: 0,0:34:52.77,0:34:53.92,JPsub,NTP,0000,0000,0000,,Біз қашаннан бері
Dialogue: 0,0:34:54.43,0:34:59.17,JPsub,NTP,0000,0000,0000,,Белгісіз тіршілік иесінің жай ғана бейтаныс адам екенін түсіндіңіз бе?
Dialogue: 0,0:35:01.79,0:35:02.85,JPsub,NTP,0000,0000,0000,,Менде жағымсыз сезім бар
Dialogue: 0,0:35:03.34,0:35:05.29,JPsub,NTP,0000,0000,0000,,Оңай сүрту мүмкін емес
Dialogue: 0,0:35:06.71,0:35:07.59,JPsub,NTP,0000,0000,0000,,Айтпақшы...
Dialogue: 0,0:35:08.36,0:35:11.82,JPsub,NTP,0000,0000,0000,,Шики бірде осыған ұқсас нәрсені айтты ма?
Dialogue: 0,0:35:20.09,0:35:24.01,JPsub,NTP,0000,0000,0000,,Мен оны қазір барсам да көре алмайтынымды білемін.
Dialogue: 0,0:35:27.83,0:35:32.91,JPsub,NTP,0000,0000,0000,,Сонда да мен Шикидің үйіндегі шамның жанып тұрғанын көргім келді.
Dialogue: 0,0:35:33.77,0:35:35.79,JPsub,NTP,0000,0000,0000,,Мен вокзалдан кері бұрылдым.
Dialogue: 0,0:36:52.32,0:36:54.29,JPsub,NTP,0000,0000,0000,,Сау бол, Курогири-кун
Dialogue: 0,0:36:55.46,0:36:56.64,JPsub,NTP,0000,0000,0000,,Жағымсыз сезім
Dialogue: 0,0:36:57.09,0:36:59.55,JPsub,NTP,0000,0000,0000,,Өйткені ол жағымсыз шындықтарды тартады
Dialogue: 0,0:37:13.53,0:37:16.29,JPsub,NTP,0000,0000,0000,,Ешкім қарап тұрған жоқ, Микия.
Dialogue: 0,0:37:16.77,0:37:17.80,JPsub,NTP,0000,0000,0000,,(Хонда мен басқалары күледі)
Dialogue: 0,0:37:18.50,0:37:19.71,JPsub,NTP,0000,0000,0000,,Бұл рас
Dialogue: 0,0:37:20.14,0:37:21.73,JPsub,NTP,0000,0000,0000,,Көрмеген болсаңыз, көрмегенсіз.
Dialogue: 0,0:37:22.28,0:37:23.13,JPsub,NTP,0000,0000,0000,,Дайсуке
Dialogue: 0,0:37:23.61,0:37:25.04,JPsub,NTP,0000,0000,0000,,Енді ше?
Dialogue: 0,0:37:27.45,0:37:28.20,JPsub,NTP,0000,0000,0000,,Ақымақ
Dialogue: 0,0:37:28.36,0:37:31.31,JPsub,NTP,0000,0000,0000,,Егер сіз қарап отырсаңыз, оқиға жылдамырақ болар еді.
Dialogue: 0,0:37:32.44,0:37:33.48,JPsub,NTP,0000,0000,0000,,Дайсуке-ниисан
Dialogue: 0,0:37:33.98,0:37:35.87,JPsub,NTP,0000,0000,0000,,Не, не есте қалды?
Dialogue: 0,0:37:37.00,0:37:39.13,JPsub,NTP,0000,0000,0000,,Рёги отбасы зерттеді ме?
Dialogue: 0,0:37:39.34,0:37:39.91,JPsub,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:37:40.15,0:37:41.59,JPsub,NTP,0000,0000,0000,,Үйдің ішінде болғанша
Dialogue: 0,0:37:41.71,0:37:43.93,JPsub,NTP,0000,0000,0000,,Сыртта не болғанын білмеймін.
Dialogue: 0,0:37:45.03,0:37:45.97,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:38:28.90,0:38:29.75,JPsub,NTP,0000,0000,0000,,Ханшайым
Dialogue: 0,0:38:30.54,0:38:31.68,JPsub,NTP,0000,0000,0000,,Бұл жақсы ма?
Dialogue: 0,0:38:32.70,0:38:33.42,JPsub,NTP,0000,0000,0000,,бірдеңе
Dialogue: 0,0:38:36.52,0:38:39.31,JPsub,NTP,0000,0000,0000,,Сарайдың айналасында адамдар назар аударған сияқты.
Dialogue: 0,0:38:39.97,0:38:42.59,JPsub,NTP,0000,0000,0000,,Полицей әкемнің айдап кеткенін естіді.
Dialogue: 0,0:38:42.96,0:38:44.86,JPsub,NTP,0000,0000,0000,,Бұл полициядан бөлек мәселе сияқты.
Dialogue: 0,0:38:45.81,0:38:47.92,JPsub,NTP,0000,0000,0000,,Оның маған қатысы жоқ.
Dialogue: 0,0:38:48.25,0:38:52.16,JPsub,NTP,0000,0000,0000,,Дегенмен, жас келіншектің мектептегі досы көзге түскен сияқты.
Dialogue: 0,0:39:12.33,0:39:13.46,JPsub,NTP,0000,0000,0000,,Егер сіз бізге нұсқау берсеңіз
Dialogue: 0,0:39:13.73,0:39:15.00,JPsub,NTP,0000,0000,0000,,Үйге келіңіз.
Dialogue: 0,0:39:16.45,0:39:18.30,JPsub,NTP,0000,0000,0000,,Сіз мұндай нәрселерді жалғыз қалдыра аласыз.
Dialogue: 0,0:39:27.06,0:39:29.92,JPsub,NTP,0000,0000,0000,,Қайырлы түн, жас ханым
Dialogue: 0,0:40:33.64,0:40:35.34,JPsub,NTP,0000,0000,0000,,Қазір бәрі жақсы
Dialogue: 0,0:40:35.82,0:40:40.17,JPsub,NTP,0000,0000,0000,,Аа, мен қазірден бастап түстен кейінгі сабаққа уақытында келемін деп ойлаймын.
Dialogue: 0,0:40:40.86,0:40:42.80,JPsub,NTP,0000,0000,0000,,Тағы бір күн демалсам
Dialogue: 0,0:40:43.34,0:40:44.77,JPsub,NTP,0000,0000,0000,,Жарайды, мама.
Dialogue: 0,0:40:45.27,0:40:46.23,JPsub,NTP,0000,0000,0000,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:40:51.15,0:40:51.79,JPsub,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,0:41:42.66,0:41:43.72,JPsub,NTP,0000,0000,0000,,Курогири-кун
Dialogue: 0,0:41:44.53,0:41:45.97,JPsub,NTP,0000,0000,0000,,3 ақпан түні
Dialogue: 0,0:41:46.22,0:41:46.96,JPsub,NTP,0000,0000,0000,,Сен
Dialogue: 0,0:41:47.03,0:41:48.28,JPsub,NTP,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:41:48.66,0:41:50.04,JPsub,NTP,0000,0000,0000,,Не жақсы?
Dialogue: 0,0:41:50.33,0:41:51.07,JPsub,NTP,0000,0000,0000,,Кокто
Dialogue: 0,0:41:52.51,0:41:53.51,JPsub,NTP,0000,0000,0000,,Түсінікті
Dialogue: 0,0:41:54.00,0:41:55.98,JPsub,NTP,0000,0000,0000,,Полицияға неге үндемейсің?
Dialogue: 0,0:41:57.48,0:41:58.22,JPsub,NTP,0000,0000,0000,,Өйткені
Dialogue: 0,0:41:58.73,0:42:00.05,JPsub,NTP,0000,0000,0000,,Мен оны көрген жоқпын
Dialogue: 0,0:42:00.86,0:42:02.82,JPsub,NTP,0000,0000,0000,,Шики дәл сол жерде болды.
Dialogue: 0,0:42:03.53,0:42:05.11,JPsub,NTP,0000,0000,0000,,Менің көргенім осы
Dialogue: 0,0:42:06.34,0:42:08.92,JPsub,NTP,0000,0000,0000,,Сондықтан мен сенемін деп шештім.
Dialogue: 0,0:42:13.97,0:42:15.50,JPsub,NTP,0000,0000,0000,,Бұл өте ауыр
Dialogue: 0,0:42:16.33,0:42:18.24,JPsub,NTP,0000,0000,0000,,Сондықтан мен қазір көп жұмыс істеп жатырмын.
Dialogue: 0,0:42:19.22,0:42:21.62,JPsub,NTP,0000,0000,0000,,Өзіңізге сенімді болған кезде
Dialogue: 0,0:42:22.19,0:42:24.60,JPsub,NTP,0000,0000,0000,,Салтанатты тыңдай аламын деп ойлаймын.
Dialogue: 0,0:42:26.40,0:42:29.33,JPsub,NTP,0000,0000,0000,,Сондықтан бұл әзірге жақсы.
Dialogue: 0,0:42:35.73,0:42:36.61,JPsub,NTP,0000,0000,0000,,Сол күннен бастап
Dialogue: 0,0:42:37.52,0:42:40.71,JPsub,NTP,0000,0000,0000,,Формула енді мені мүлдем елемейді.
Dialogue: 0,0:42:49.68,0:42:50.77,JPsub,NTP,0000,0000,0000,,Демек, Хигучи Кира емес болып шықты ғой?
Dialogue: 0,0:42:51.29,0:42:53.21,JPsub,NTP,0000,0000,0000,,Күн сайын салтанатты үйге барыңыз
Dialogue: 0,0:42:53.75,0:42:54.94,JPsub,NTP,0000,0000,0000,,Стейк
Dialogue: 0,0:44:36.67,0:44:39.79,JPsub,NTP,0000,0000,0000,,Қандай бақытты адам
Dialogue: 0,0:44:47.15,0:44:49.46,JPsub,NTP,0000,0000,0000,,Салтанаттан шақыру болады деп ойламадым.
Dialogue: 0,0:44:50.10,0:44:51.81,JPsub,NTP,0000,0000,0000,,Мені елемеуді доғар
Dialogue: 0,0:44:52.52,0:44:54.42,JPsub,NTP,0000,0000,0000,,Мен мұны істей алмағандықтан қоңырау шалдым.
Dialogue: 0,0:44:55.79,0:44:58.92,JPsub,NTP,0000,0000,0000,,Сіз мені өлтіруші емеспін деп айттыңыз.
Dialogue: 0,0:45:02.03,0:45:03.05,JPsub,NTP,0000,0000,0000,,Бұл Миками растағанының белгісі
Dialogue: 0,0:45:04.16,0:45:05.66,JPsub,NTP,0000,0000,0000,,Мен кісі өлтірушімін
Dialogue: 0,0:45:06.29,0:45:08.36,JPsub,NTP,0000,0000,0000,,Тіпті сахнаны көргің келеді
Dialogue: 0,0:45:08.73,0:45:10.32,JPsub,NTP,0000,0000,0000,,Мені неге сағындың?
Dialogue: 0,0:45:10.87,0:45:12.55,JPsub,NTP,0000,0000,0000,,Сіз ештеңені жіберіп алмайсыз
Dialogue: 0,0:45:13.16,0:45:15.19,JPsub,NTP,0000,0000,0000,,Формула мұны жасамайды.
Dialogue: 0,0:45:16.11,0:45:18.05,JPsub,NTP,0000,0000,0000,,Айтсам да.
Dialogue: 0,0:45:18.38,0:45:20.05,JPsub,NTP,0000,0000,0000,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:45:20.55,0:45:21.45,JPsub,NTP,0000,0000,0000,,Мүлдем
Dialogue: 0,0:45:25.25,0:45:26.62,JPsub,NTP,0000,0000,0000,,Абсолют деген не?
Dialogue: 0,0:45:27.60,0:45:30.09,JPsub,NTP,0000,0000,0000,,Мен туралы не түсінуге болады?
Dialogue: 0,0:45:31.95,0:45:34.88,JPsub,NTP,0000,0000,0000,,Мен туралы не сенуге болады?
Dialogue: 0,0:45:35.38,0:45:36.56,JPsub,NTP,0000,0000,0000,,Оған ешқандай негіз жоқ.
Dialogue: 0,0:45:37.60,0:45:41.04,JPsub,NTP,0000,0000,0000,,Бірақ мен формулаға сенуді жалғастырамын деп ойлаймын.
Dialogue: 0,0:45:42.67,0:45:43.41,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:45:43.79,0:45:44.87,JPsub,NTP,0000,0000,0000,,Себебі мен сені жақсы көремін
Dialogue: 0,0:45:45.24,0:45:46.80,JPsub,NTP,0000,0000,0000,,Мен сенуді жалғастырғым келеді
Dialogue: 0,0:45:50.98,0:45:52.20,JPsub,NTP,0000,0000,0000,,Сіз Мокасыз
Dialogue: 0,0:45:53.44,0:45:54.20,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:45:54.58,0:45:55.61,JPsub,NTP,0000,0000,0000,,Жиі айтылады
Dialogue: 0,0:46:02.38,0:46:03.70,JPsub,NTP,0000,0000,0000,,Сәлем, Куротоу
Dialogue: 0,0:46:04.56,0:46:05.88,JPsub,NTP,0000,0000,0000,,Бүгін келесің бе?
Dialogue: 0,0:46:54.41,0:46:55.43,JPsub,NTP,0000,0000,0000,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:46:59.58,0:47:01.98,JPsub,NTP,0000,0000,0000,,Менің үйім сонда болса да
Dialogue: 0,0:47:05.60,0:47:07.01,JPsub,NTP,0000,0000,0000,,Мен орамалға сенімдімін
Dialogue: 0,0:47:07.95,0:47:08.58,JPsub,NTP,0000,0000,0000,,болды
Dialogue: 0,0:47:31.76,0:47:32.70,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:47:32.95,0:47:33.72,JPsub,NTP,0000,0000,0000,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:47:51.31,0:47:52.17,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:49:53.37,0:49:54.47,JPsub,NTP,0000,0000,0000,,Кокто
Dialogue: 0,0:49:59.37,0:50:00.28,JPsub,NTP,0000,0000,0000,,Кокто
Dialogue: 0,0:50:31.95,0:50:36.04,JPsub,NTP,0000,0000,0000,,Кокто, бірдеңе айт.
Dialogue: 0,0:50:37.02,0:50:38.02,JPsub,NTP,0000,0000,0000,,Кокто
Dialogue: 0,0:50:41.33,0:50:47.64,JPsub,NTP,0000,0000,0000,,Мен... Мен... өлгім келмейді.
Dialogue: 0,0:50:54.28,0:50:57.15,JPsub,NTP,0000,0000,0000,,Мен сені сиқым келеді
Dialogue: 0,0:51:11.73,0:51:13.41,JPsub,NTP,0000,0000,0000,,Жарайды, мен біраз уақытқа барайын.
Dialogue: 0,0:51:14.23,0:51:15.80,JPsub,NTP,0000,0000,0000,,Мен екі сағаттан кейін қайтамын.
Dialogue: 0,0:51:17.06,0:51:18.85,JPsub,NTP,0000,0000,0000,,Маған кәдесый беріңізші
Dialogue: 0,0:51:29.74,0:51:34.58,JPsub,NTP,0000,0000,0000,,Мен қызыма аптасына бір рет сенбі күні түстен кейін барамын.
Dialogue: 0,0:51:37.35,0:51:39.30,JPsub,NTP,0000,0000,0000,,Ол қандай азап шегеді?
Dialogue: 0,0:51:39.83,0:51:41.68,JPsub,NTP,0000,0000,0000,,Мен сенің не ойлағаныңды білмеймін.
Dialogue: 0,0:51:43.06,0:51:46.59,JPsub,NTP,0000,0000,0000,,Мені неге өлтірмек болғаныңды да білмеймін.
Dialogue: 0,0:51:50.23,0:51:50.98,JPsub,NTP,0000,0000,0000,,Алайда
Dialogue: 0,0:51:51.44,0:51:55.67,JPsub,NTP,0000,0000,0000,,Соңында Шики көрсеткен өткінші күлкі жеткілікті болды.
Dialogue: 0,0:51:56.47,0:52:01.11,JPsub,NTP,0000,0000,0000,,Сабақтан кейін күн батқанда тұрған соңғы рәсім есімде.
Dialogue: 0,0:52:02.16,0:52:03.73,JPsub,NTP,0000,0000,0000,,Отты іңірде
Dialogue: 0,0:52:04.52,0:52:08.15,JPsub,NTP,0000,0000,0000,,Өрнек: «Мен өзіме не сене аламын?» деп сұрады.
Dialogue: 0,0:52:09.17,0:52:11.18,JPsub,NTP,0000,0000,0000,,Сол уақыттағы жауапты қайталаңыз
Dialogue: 0,0:52:12.21,0:52:13.24,JPsub,NTP,0000,0000,0000,,Негіз жоқ
Dialogue: 0,0:52:14.06,0:52:17.10,JPsub,NTP,0000,0000,0000,,Бірақ мен формулаға сенуді жалғастырамын
Dialogue: 0,0:52:18.40,0:52:19.75,JPsub,NTP,0000,0000,0000,,Өйткені сен маған ұнайсың
Dialogue: 0,0:52:20.49,0:52:22.11,JPsub,NTP,0000,0000,0000,,Мен сенуді жалғастырғым келеді
Dialogue: 0,0:52:24.07,0:52:25.77,JPsub,NTP,0000,0000,0000,,Ол ешкімді өлтірмейді
Dialogue: 0,0:52:26.34,0:52:28.13,JPsub,NTP,0000,0000,0000,,Мен дәл осыны айта аламын.
Dialogue: 0,0:52:28.90,0:52:32.08,JPsub,NTP,0000,0000,0000,,Өйткені Шики кісі өлтірудің азабын біледі.
Dialogue: 0,0:52:32.56,0:52:33.58,JPsub,NTP,0000,0000,0000,,Сондай-ақ жәбірленуші
Dialogue: 0,0:52:34.03,0:52:39.00,JPsub,NTP,0000,0000,0000,,Қылмыскер ретінде сіз оның қаншалықты қайғылы екенін бәрінен де жақсы білесіз.
Dialogue: 0,0:52:39.86,0:52:41.13,JPsub,NTP,0000,0000,0000,,Сондықтан мен сендім
Dialogue: 0,0:52:41.75,0:52:44.86,JPsub,NTP,0000,0000,0000,,Зақым келтірмейтін рәсім және тек сызаты бар мата
Dialogue: 0,0:52:46.30,0:52:48.30,JPsub,NTP,0000,0000,0000,,Мен әрқашан жарақат алудан қорқатынмын.
Dialogue: 0,0:52:48.88,0:52:53.24,JPsub,NTP,0000,0000,0000,,Маған шынайы сезімдеріңді айта алмағандарың өкінішті.
Dialogue: 0,0:53:20.73,0:53:23.57,JPsub,NTP,0000,0000,0000,,1995 жылғы сәуір
Dialogue: 0,0:53:24.98,0:53:27.57,JPsub,NTP,0000,0000,0000,,Мен оны кездестірдім
Dialogue: 0,0:58:11.09,0:58:13.50,JPsub,NTP,0000,0000,0000,,Үш бөлік дайындалды.
Dialogue: 0,0:58:13.82,0:58:17.73,JPsub,NTP,0000,0000,0000,,Өліміне байланысты қалқып жүретін қос денелі адам
Dialogue: 0,0:58:20.09,0:58:25.04,JPsub,NTP,0000,0000,0000,,Өліммен байланыста болатын конформистер
Dialogue: 0,0:58:27.46,0:58:31.58,JPsub,NTP,0000,0000,0000,,Өлімнен қашып, өзін сезінген оянған адам
Dialogue: 0,0:58:32.86,0:58:37.72,JPsub,NTP,0000,0000,0000,,Өзара тоғысқан және қарама-қайшы спиральда күту
Dialogue: 0,0:59:09.52,0:59:12.64,JPsub,NTP,0000,0000,0000,,Мен жылайтын сияқтымын
Dialogue: 0,0:59:19.64,0:59:21.29,JPsub,NTP,0000,0000,0000,,Жаралар шыдайтын нәрсе емес.
Dialogue: 0,0:59:21.88,0:59:24.42,JPsub,NTP,0000,0000,0000,,Ауырсыну – шағымданатын нәрсе.
Dialogue: 0,0:59:25.21,0:59:27.51,JPsub,NTP,0000,0000,0000,,Егер қазір сен болсаң, мен сені өлтірер едім.
Dialogue: 0,0:59:25.21,0:59:27.51,JPsub,NTP,0000,0000,0000,,Мен сені өлтіруім керек.
Dialogue: 0,0:59:27.55,0:59:30.71,JPsub,NTP,0000,0000,0000,,Жалғыз жасасаңыз, кек алуыңыз мүмкін.
Dialogue: 0,0:59:30.87,0:59:31.44,JPsub,NTP,0000,0000,0000,,Рёги
Dialogue: 0,0:59:31.58,0:59:34.50,JPsub,NTP,0000,0000,0000,,Иілу
Dialogue: 0,0:59:34.60,0:59:35.62,JPsub,NTP,0000,0000,0000,,Тірі болсаң
Dialogue: 0,0:59:35.89,0:59:37.94,JPsub,NTP,0000,0000,0000,,Тіпті Құдай сені өлтіреді
Dialogue: 0,0:59:41.07,0:59:42.61,JPsub,NTP,0000,0000,0000,,Жылауға бола ма?
Dialogue: 0,0:01:40.75,0:01:41.76,CNsub,NTP,0000,0000,0000,,Қайырлы кеш
Dialogue: 0,0:02:41.51,0:02:43.37,CNsub,NTP,0000,0000,0000,,Баршаңызға, орта және орта мектептегі әріптестер
Dialogue: 0,0:02:43.62,0:02:46.85,CNsub,NTP,0000,0000,0000,,Мен ғана әңгіме жібере алатын адаммын.
Dialogue: 0,0:02:47.39,0:02:51.01,CNsub,NTP,0000,0000,0000,,Үй иесі шындықты біледі, ал тегін мектеп стилі мектебіміздікі...
Dialogue: 0,0:03:20.90,0:03:21.52,CNsub,NTP,0000,0000,0000,,Дугаку
Dialogue: 0,0:03:26.85,0:03:27.91,CNsub,NTP,0000,0000,0000,,Бір рет атуға болады ма?
Dialogue: 0,0:03:32.81,0:03:34.28,CNsub,NTP,0000,0000,0000,,Сіздің сол кезде болғаныңыз рас...
Dialogue: 0,0:03:39.55,0:03:42.03,CNsub,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:04:04.80,0:04:06.16,CNsub,NTP,0000,0000,0000,,Үлкен және кіші апаны теріп жаз
Dialogue: 0,0:04:07.07,0:04:09.46,CNsub,NTP,0000,0000,0000,,Бүгін кешке бір ерте бару
Dialogue: 0,0:04:29.92,0:04:31.30,CNsub,NTP,0000,0000,0000,,Ягоши Шин
Dialogue: 0,0:04:32.12,0:04:34.13,CNsub,NTP,0000,0000,0000,,Қою түс
Dialogue: 0,0:04:35.75,0:04:37.63,CNsub,NTP,0000,0000,0000,,Ауада болмай қаланы аралау
Dialogue: 0,0:04:38.15,0:04:40.60,CNsub,NTP,0000,0000,0000,,Осыған байланысты өзіндік ойлау қажет.
Dialogue: 0,0:04:41.81,0:04:43.07,CNsub,NTP,0000,0000,0000,,Бұл қарама-қайшы.
Dialogue: 0,0:04:43.83,0:04:47.25,CNsub,NTP,0000,0000,0000,,Мен жалғызбын деп ойлаймын.
Dialogue: 0,0:06:32.80,0:06:33.69,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:06:33.92,0:06:34.53,CNsub,NTP,0000,0000,0000,,\h Мен ашпын.
Dialogue: 0,0:06:34.80,0:06:36.13,CNsub,NTP,0000,0000,0000,,Бұл сыйлықпен бірге келген сыйлық.
Dialogue: 0,0:06:36.35,0:06:38.08,CNsub,NTP,0000,0000,0000,,Бірдеңені айтқанда, оны қалдыру керек.
Dialogue: 0,0:06:38.30,0:06:39.40,CNsub,NTP,0000,0000,0000,,Теңіз жағасындағы дрейф
Dialogue: 0,0:06:39.66,0:06:40.87,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:06:41.14,0:06:42.30,CNsub,NTP,0000,0000,0000,,Әрбір аспан астанасында жүзу
Dialogue: 0,0:06:42.55,0:06:43.73,CNsub,NTP,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:06:43.98,0:06:45.52,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:06:54.06,0:06:55.74,CNsub,NTP,0000,0000,0000,,Өткеннің анық екені анық.
Dialogue: 0,0:06:56.81,0:06:57.61,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:07:00.33,0:07:01.68,CNsub,NTP,0000,0000,0000,,Қазіргі уақытта құлаған аяқ
Dialogue: 0,0:07:02.51,0:07:04.27,CNsub,NTP,0000,0000,0000,,Уақытты қайта пайдаланбаған болсаңыз
Dialogue: 0,0:07:05.01,0:07:07.93,CNsub,NTP,0000,0000,0000,,Сіз Фую Теняға келдіңіз, демек бұл сіздің денеңіздің шабуылы.
Dialogue: 0,0:07:09.60,0:07:10.53,CNsub,NTP,0000,0000,0000,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:07:11.08,0:07:12.04,CNsub,NTP,0000,0000,0000,,Өлмеген сериялар
Dialogue: 0,0:07:12.29,0:07:13.43,CNsub,NTP,0000,0000,0000,,Жадағай құрастыру
Dialogue: 0,0:07:15.98,0:07:18.65,CNsub,NTP,0000,0000,0000,,Жапондардың дәстүрлі киіміне киетін плащ
Dialogue: 0,0:07:19.58,0:07:20.36,CNsub,NTP,0000,0000,0000,,Әрине бар
Dialogue: 0,0:07:23.40,0:07:26.67,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:06.81,0:08:07.49,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:12.06,0:08:13.53,CNsub,NTP,0000,0000,0000,,Мен кісі өлтірушімін.
Dialogue: 0,0:08:15.16,0:08:16.64,CNsub,NTP,0000,0000,0000,,Жаздың соңғы күні
Dialogue: 0,0:08:17.02,0:08:19.43,CNsub,NTP,0000,0000,0000,,Батыс жағындағы сауда ауданындағы студенттерге арналған аяқталған жоба
Dialogue: 0,0:08:20.45,0:08:22.03,CNsub,NTP,0000,0000,0000,,Белгісіздік
Dialogue: 0,0:08:23.33,0:08:24.80,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:27.61,0:08:30.32,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:30.69,0:08:33.32,CNsub,NTP,0000,0000,0000,,Мен төлеуге ақшасы бар адамдарды білемін.
Dialogue: 0,0:08:35.15,0:08:40.69,CNsub,NTP,0000,0000,0000,,Орнатқаннан кейін екі қол мен аяқты орналастыру
Dialogue: 0,0:08:41.01,0:08:42.59,CNsub,NTP,0000,0000,0000,,Тек екі қол және екі аяқ?
Dialogue: 0,0:08:43.67,0:08:46.06,CNsub,NTP,0000,0000,0000,,Бұл кісі осылайша қайтыс болды.
Dialogue: 0,0:08:49.75,0:08:54.34,CNsub,NTP,0000,0000,0000,,Көп мөлшерде қан жоғалту нәтижесінде аурудың себебі – тіршілік әрекетінің тоқтауы.
Dialogue: 0,0:08:58.32,0:09:01.88,CNsub,NTP,0000,0000,0000,,Дегенмен, төменде келтірілген мәліметтер геморрагиялық сәтсіздікке және өлімге ұшырайды.
Dialogue: 0,0:09:06.87,0:09:07.85,CNsub,NTP,0000,0000,0000,,Қылмыстық
Dialogue: 0,0:09:22.33,0:09:23.24,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:09:23.68,0:09:25.56,CNsub,NTP,0000,0000,0000,,Байланысты оқиғалар
Dialogue: 0,0:09:26.09,0:09:26.88,CNsub,NTP,0000,0000,0000,,Сондай-ақ дұрыс емес
Dialogue: 0,0:09:27.32,0:09:28.99,CNsub,NTP,0000,0000,0000,,Аударма жоқ
Dialogue: 0,0:09:29.72,0:09:30.48,CNsub,NTP,0000,0000,0000,,Тадаши…
Dialogue: 0,0:09:30.73,0:09:31.45,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:09:32.09,0:09:35.63,CNsub,NTP,0000,0000,0000,,Тамақ ішкен кезде бұлай болмайды.
Dialogue: 0,0:09:39.18,0:09:40.40,CNsub,NTP,0000,0000,0000,,Тортты да жей алмай ма?
Dialogue: 0,0:09:55.35,0:09:56.56,CNsub,NTP,0000,0000,0000,,Матазена отбасы
Dialogue: 0,0:09:57.02,0:09:58.75,CNsub,NTP,0000,0000,0000,,Үлкен мүмкіндік
Dialogue: 0,0:10:00.20,0:10:01.46,CNsub,NTP,0000,0000,0000,,Қатысқан төртінші адам
Dialogue: 0,0:10:08.25,0:10:09.73,CNsub,NTP,0000,0000,0000,,Нағыз қасірет
Dialogue: 0,0:10:11.33,0:10:12.73,CNsub,NTP,0000,0000,0000,,Өлгеннен кейін қанша уақыттан кейін?
Dialogue: 0,0:10:13.10,0:10:15.01,CNsub,NTP,0000,0000,0000,,Шамамен 3 сағат солға және оңға
Dialogue: 0,0:10:16.63,0:10:17.27,CNsub,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:10:18.61,0:10:19.98,CNsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:10:20.57,0:10:21.50,CNsub,NTP,0000,0000,0000,,Аспан пайда болғаннан бері
Dialogue: 0,0:10:21.79,0:10:25.20,CNsub,NTP,0000,0000,0000,,Мектепті бітіргеннен кейін қоғамдық жұмыстарға бармайды
Dialogue: 0,0:10:26.98,0:10:30.81,CNsub,NTP,0000,0000,0000,,Баршаңызға оқуларыңызға сәттілік тілеймін.
Dialogue: 0,0:10:32.13,0:10:33.18,CNsub,NTP,0000,0000,0000,,Джуджуй Иппен
Dialogue: 0,0:10:33.72,0:10:34.84,CNsub,NTP,0000,0000,0000,,Аспан пайда болғаннан бері
Dialogue: 0,0:10:35.18,0:10:38.19,CNsub,NTP,0000,0000,0000,,Мектепті бітіргеннен кейін қоғамдық жұмыстарға бармайды
Dialogue: 0,0:10:39.12,0:10:42.69,CNsub,NTP,0000,0000,0000,,Баршаңызға оқуларыңыз ұнайды деп сенемін.
Dialogue: 0,0:10:45.27,0:10:46.15,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:10:51.44,0:10:52.43,CNsub,NTP,0000,0000,0000,,Мен дұрыс айтамын.
Dialogue: 0,0:10:52.66,0:10:53.46,CNsub,NTP,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:10:54.33,0:10:56.46,CNsub,NTP,0000,0000,0000,,Сіз қара тунг оқушысысыз ба?
Dialogue: 0,0:10:57.48,0:10:59.38,CNsub,NTP,0000,0000,0000,,Сен...Сен кімсің?
Dialogue: 0,0:11:00.51,0:11:02.07,CNsub,NTP,0000,0000,0000,,Менің жүрегім ашуға толы
Dialogue: 0,0:11:02.51,0:11:04.17,CNsub,NTP,0000,0000,0000,,Дегенмен төртінші станция әлі ашық.
Dialogue: 0,0:11:51.33,0:11:52.29,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:55.71,0:11:56.46,CNsub,NTP,0000,0000,0000,,Ескірген
Dialogue: 0,0:11:56.89,0:11:58.00,CNsub,NTP,0000,0000,0000,,Маған келген адамдардың кездесуі
Dialogue: 0,0:11:58.62,0:12:00.48,CNsub,NTP,0000,0000,0000,,Ешкімнің сізбен бірге келуіне жол бермеңіз.
Dialogue: 0,0:12:02.52,0:12:03.42,CNsub,NTP,0000,0000,0000,,Орындауға болады
Dialogue: 0,0:12:06.69,0:12:07.59,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:13:29.13,0:13:29.86,CNsub,NTP,0000,0000,0000,,Куротоу Дугаку!
Dialogue: 0,0:13:30.27,0:13:30.89,CNsub,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:13:35.00,0:13:35.68,CNsub,NTP,0000,0000,0000,,Менің алдын ала сезімім айқын көрсетті, мен жеңетінімді
Dialogue: 0,0:13:41.39,0:13:44.39,CNsub,NTP,0000,0000,0000,,Сіз астананың қай жеріндесіз?
Dialogue: 0,0:13:44.67,0:13:46.55,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:13:47.05,0:13:49.44,CNsub,NTP,0000,0000,0000,,Таныстыру жиналысы
Dialogue: 0,0:13:50.42,0:13:52.22,CNsub,NTP,0000,0000,0000,,Бір жылау, ақ және таза
Dialogue: 0,0:13:52.78,0:13:56.75,CNsub,NTP,0000,0000,0000,,Мектепті кенет тастап кетуімнің себебі де осы.
Dialogue: 0,0:14:00.30,0:14:01.64,CNsub,NTP,0000,0000,0000,,Мен оны сатып алғым келмейді.
Dialogue: 0,0:14:02.57,0:14:04.11,CNsub,NTP,0000,0000,0000,,Келмейді
Dialogue: 0,0:14:05.27,0:14:06.11,CNsub,NTP,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:14:06.31,0:14:07.39,CNsub,NTP,0000,0000,0000,,Бастауыш ақиқат.
Dialogue: 0,0:14:07.86,0:14:09.25,CNsub,NTP,0000,0000,0000,,Әрине
Dialogue: 0,0:14:10.04,0:14:12.36,CNsub,NTP,0000,0000,0000,,Сіз аздап ойланып отырсыз.
Dialogue: 0,0:14:34.66,0:14:37.29,CNsub,NTP,0000,0000,0000,,Әрбір позицияны тұрақты орынға жылжыту керек.
Dialogue: 0,0:15:24.33,0:15:25.70,CNsub,NTP,0000,0000,0000,,Бесінші бөлім
Dialogue: 0,0:16:43.19,0:16:44.20,CNsub,NTP,0000,0000,0000,,Мен осындамын
Dialogue: 0,0:16:54.81,0:16:56.00,CNsub,NTP,0000,0000,0000,,Төзгісіз ауырсыну
Dialogue: 0,0:16:59.95,0:17:01.73,CNsub,NTP,0000,0000,0000,,Жапон әкесінің салыстыру нәтижелері
Dialogue: 0,0:17:01.98,0:17:03.01,CNsub,NTP,0000,0000,0000,,Сіз не сезінесіз?
Dialogue: 0,0:17:03.44,0:17:05.24,CNsub,NTP,0000,0000,0000,,Зейнетке шығу Акитакасы
Dialogue: 0,0:17:05.56,0:17:07.41,CNsub,NTP,0000,0000,0000,,Киімді ауыстыруға қатысты жағдайлар мен түсіндім.
Dialogue: 0,0:17:07.82,0:17:08.74,CNsub,NTP,0000,0000,0000,,Сіз не айтасыз?
Dialogue: 0,0:17:09.08,0:17:10.98,CNsub,NTP,0000,0000,0000,,Бұл да маған тиесілі емес.
Dialogue: 0,0:17:11.49,0:17:13.37,CNsub,NTP,0000,0000,0000,,Бұл басқалармен салыстырғанда тиімді.
Dialogue: 0,0:17:13.85,0:17:16.61,CNsub,NTP,0000,0000,0000,,Анти-трансформациядан кейін отбасылық бизнестің растауы ер бала
Dialogue: 0,0:17:17.32,0:17:18.01,CNsub,NTP,0000,0000,0000,,Кездесу жоқ
Dialogue: 0,0:17:18.46,0:17:21.83,CNsub,NTP,0000,0000,0000,,Екі отбасының ғана дарыны әртүрлі.
Dialogue: 0,0:17:22.41,0:17:26.56,CNsub,NTP,0000,0000,0000,,Меншіктің көлемі мен көлемінің сипатына байланысты
Dialogue: 0,0:17:28.89,0:17:31.82,CNsub,NTP,0000,0000,0000,,Әртүрлі жағдайлар... түпкілікті өзіндік өмір сүру жақсы.
Dialogue: 0,0:17:55.03,0:18:00.03,CNsub,NTP,0000,0000,0000,,Нәтижесінде менің денемде басқа білім мен жол бар.
Dialogue: 0,0:18:01.71,0:18:04.28,CNsub,NTP,0000,0000,0000,,Накая және т.б.
Dialogue: 0,0:18:09.49,0:18:12.17,CNsub,NTP,0000,0000,0000,,Сіздің пікіріңіз дұрыс па?
Dialogue: 0,0:18:13.81,0:18:15.77,CNsub,NTP,0000,0000,0000,,Ғалым! Бұл сіздің ниетіңіз бе?
Dialogue: 0,0:18:16.27,0:18:17.70,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:18.16,0:18:22.21,CNsub,NTP,0000,0000,0000,,Егер сізде сұрақтар немесе алаңдаушылықтар болса, не болғанын бізге хабарлаңыз.
Dialogue: 0,0:18:22.43,0:18:23.57,CNsub,NTP,0000,0000,0000,,Орынды білу...
Dialogue: 0,0:18:24.53,0:18:27.71,CNsub,NTP,0000,0000,0000,,Ерекше жағдайлар туралы көбірек білгіңіз келе ме?
Dialogue: 0,0:18:28.30,0:18:30.68,CNsub,NTP,0000,0000,0000,,Қазіргі уақытта дарынды компанияның қызметі түстен кейінгі демалыста аяқталды.
Dialogue: 0,0:18:32.08,0:18:33.42,CNsub,NTP,0000,0000,0000,,Дзюдо клубынан шығыңыз
Dialogue: 0,0:18:34.12,0:18:36.40,CNsub,NTP,0000,0000,0000,,Ауыстыруға болады
Dialogue: 0,0:18:37.10,0:18:38.32,CNsub,NTP,0000,0000,0000,,Әңгіменің соңы
Dialogue: 0,0:18:38.74,0:18:40.22,CNsub,NTP,0000,0000,0000,,Қарапайым дос
Dialogue: 0,0:18:40.63,0:18:42.20,CNsub,NTP,0000,0000,0000,,Бұдан басқа
Dialogue: 0,0:18:42.81,0:18:44.09,CNsub,NTP,0000,0000,0000,,«шики» деп айқайлау
Dialogue: 0,0:18:44.63,0:18:49.21,CNsub,NTP,0000,0000,0000,,Шақыруға болмайтын екі есім
Dialogue: 0,0:18:51.89,0:18:53.37,CNsub,NTP,0000,0000,0000,,Бұл сіз қалаған нәрсе.
Dialogue: 0,0:18:53.80,0:18:54.55,CNsub,NTP,0000,0000,0000,,Ұқсас фамилия
Dialogue: 0,0:18:54.72,0:18:57.06,CNsub,NTP,0000,0000,0000,,``Шики Догаку'' ``Шики Догаку''
Dialogue: 0,0:18:57.36,0:18:58.51,CNsub,NTP,0000,0000,0000,,Шынайы оқиға?
Dialogue: 0,0:18:59.28,0:19:02.89,CNsub,NTP,0000,0000,0000,,「」
Dialogue: 0,0:19:05.98,0:19:06.99,CNsub,NTP,0000,0000,0000,,Сәттілік
Dialogue: 0,0:19:07.76,0:19:09.56,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:19:10.40,0:19:11.30,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:19:11.51,0:19:13.53,CNsub,NTP,0000,0000,0000,,Таза су туралы әңгіме
Dialogue: 0,0:19:14.19,0:19:14.86,CNsub,NTP,0000,0000,0000,,Түсіндірме қандай?
Dialogue: 0,0:19:15.16,0:19:18.07,CNsub,NTP,0000,0000,0000,,Ең бірінші жаңбырдан пана алу керек.
Dialogue: 0,0:19:20.07,0:19:20.76,CNsub,NTP,0000,0000,0000,,Ол өзінің Стэндін шығарды. Оған кім қарсы шығады?
Dialogue: 0,0:19:21.50,0:19:23.05,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:19:23.54,0:19:24.41,CNsub,NTP,0000,0000,0000,,Сондықтан түсініктеме
Dialogue: 0,0:19:24.85,0:19:26.15,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:19:26.43,0:19:28.07,CNsub,NTP,0000,0000,0000,,Дегенмен, иесінің жүрегі осында.
Dialogue: 0,0:19:29.06,0:19:30.04,CNsub,NTP,0000,0000,0000,,Жұмыспен қамту тривиальды жағдай
Dialogue: 0,0:19:30.25,0:19:31.81,CNsub,NTP,0000,0000,0000,,Аяқтан аяққа ауысқан шебердің сұрағы
Dialogue: 0,0:19:33.29,0:19:35.83,CNsub,NTP,0000,0000,0000,,Бұл негізгі мектеп
Dialogue: 0,0:19:36.41,0:19:37.75,CNsub,NTP,0000,0000,0000,,Алдыңғы пайдаланушының сөйлесуі
Dialogue: 0,0:19:38.00,0:19:39.78,CNsub,NTP,0000,0000,0000,,Жұмыспен қамту деңгейі жұмыссыздардың деңгейіне ұқсас
Dialogue: 0,0:19:41.73,0:19:44.83,CNsub,NTP,0000,0000,0000,,Қолайсыздықтар үшін кешірім сұраймын.
Dialogue: 0,0:19:45.41,0:19:47.62,CNsub,NTP,0000,0000,0000,,Әсерлер сәйкес келмейді
Dialogue: 0,0:19:49.08,0:19:51.49,CNsub,NTP,0000,0000,0000,,Рәсімі жоқ қыз бала
Dialogue: 0,0:19:52.40,0:19:56.10,CNsub,NTP,0000,0000,0000,,Бұл жай ғана жалпы достың келуі.
Dialogue: 0,0:19:57.14,0:19:59.57,CNsub,NTP,0000,0000,0000,,Әйел әйел...
Dialogue: 0,0:20:03.71,0:20:05.29,CNsub,NTP,0000,0000,0000,,Не істеу керек екені белгісіз.
Dialogue: 0,0:20:05.63,0:20:07.83,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:20:08.42,0:20:09.99,CNsub,NTP,0000,0000,0000,,Чидо Чига
Dialogue: 0,0:20:11.39,0:20:12.81,CNsub,NTP,0000,0000,0000,,Күннің соңында
Dialogue: 0,0:20:13.11,0:20:13.93,CNsub,NTP,0000,0000,0000,,Сыртта?
Dialogue: 0,0:20:15.24,0:20:17.74,CNsub,NTP,0000,0000,0000,,Өрнектің жергілікті аймағы
Dialogue: 0,0:20:18.24,0:20:19.73,CNsub,NTP,0000,0000,0000,,Қажетті жануарлар Хиросимадан...
Dialogue: 0,0:20:20.00,0:20:20.86,CNsub,NTP,0000,0000,0000,,Қоян мүсіні…
Dialogue: 0,0:20:21.68,0:20:24.29,CNsub,NTP,0000,0000,0000,,Бұл жағдайда қайтыс болғандардың саны жалғыздықтан болған жоқ.
Dialogue: 0,0:20:58.12,0:20:59.08,CNsub,NTP,0000,0000,0000,,Ән қара пауловния
Dialogue: 0,0:21:00.25,0:21:01.36,CNsub,NTP,0000,0000,0000,,Хисато Рёнен
Dialogue: 0,0:21:02.17,0:21:03.11,CNsub,NTP,0000,0000,0000,,Шынайы қолайсыз ниеттер
Dialogue: 0,0:21:03.51,0:21:06.09,CNsub,NTP,0000,0000,0000,,Қажетті ашу уақыты
Dialogue: 0,0:21:08.83,0:21:09.53,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:21:09.90,0:21:12.42,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:21:14.12,0:21:16.68,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:21:17.27,0:21:18.29,CNsub,NTP,0000,0000,0000,,Менің оқиғам…
Dialogue: 0,0:21:18.39,0:21:20.28,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:21:20.69,0:21:23.36,CNsub,NTP,0000,0000,0000,,Бұл жердің сыртында кімге қарап тұрсың?
Dialogue: 0,0:21:23.85,0:21:25.82,CNsub,NTP,0000,0000,0000,,Қайта тексерудің бөлек құны
Dialogue: 0,0:21:26.04,0:21:27.65,CNsub,NTP,0000,0000,0000,,Міндетті жою қосылымы
Dialogue: 0,0:21:28.20,0:21:29.53,CNsub,NTP,0000,0000,0000,,Аяқталған жүгіру
Dialogue: 0,0:22:17.01,0:22:20.49,CNsub,NTP,0000,0000,0000,,Қысқаша әңгіме: Менің қос мінезім бар.
Dialogue: 0,0:22:23.09,0:22:24.13,CNsub,NTP,0000,0000,0000,,Мен осындамын
Dialogue: 0,0:22:24.71,0:22:26.71,CNsub,NTP,0000,0000,0000,,Қарапайым сыртқы түрі
Dialogue: 0,0:22:27.66,0:22:30.60,CNsub,NTP,0000,0000,0000,,Мен жапон адаммын.
Dialogue: 0,0:22:31.11,0:22:33.14,CNsub,NTP,0000,0000,0000,,Екі адам бір адам.
Dialogue: 0,0:22:34.31,0:22:35.73,CNsub,NTP,0000,0000,0000,,Жапон стиліндегі ерекшелік
Dialogue: 0,0:22:36.13,0:22:39.25,CNsub,NTP,0000,0000,0000,,Мен қазір Америка Құрама Штаттарындамын және қазір бірінші орынды ашу үстіндемін.
Dialogue: 0,0:22:39.81,0:22:41.33,CNsub,NTP,0000,0000,0000,,Өте жақсы тапсырыс?
Dialogue: 0,0:22:42.04,0:22:44.15,CNsub,NTP,0000,0000,0000,,Менің ойым мен ойым
Dialogue: 0,0:22:44.52,0:22:45.47,CNsub,NTP,0000,0000,0000,,Дегенмен, бұл
Dialogue: 0,0:22:46.24,0:22:49.15,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:22:49.36,0:22:51.15,CNsub,NTP,0000,0000,0000,,Осыған байланысты мен балама ретінде келдім.
Dialogue: 0,0:22:52.17,0:22:52.95,CNsub,NTP,0000,0000,0000,,Таза ма?
Dialogue: 0,0:22:53.41,0:22:54.96,CNsub,NTP,0000,0000,0000,,Ух... негізінен жоғарыда.
Dialogue: 0,0:22:55.69,0:22:57.81,CNsub,NTP,0000,0000,0000,,Дегенмен, қандай мәліметтер бар?
Dialogue: 0,0:22:59.20,0:23:01.87,CNsub,NTP,0000,0000,0000,,Сезімнің себебі көрінбейді.
Dialogue: 0,0:23:09.55,0:23:10.86,CNsub,NTP,0000,0000,0000,,Шолу
Dialogue: 0,0:23:11.40,0:23:14.12,CNsub,NTP,0000,0000,0000,,Шығыс пен Батыста менде де осындай жағдай бар екен.
Dialogue: 0,0:23:14.88,0:23:17.12,CNsub,NTP,0000,0000,0000,,Менің ең көп айтылған эмоцияларым
Dialogue: 0,0:23:18.31,0:23:21.40,CNsub,NTP,0000,0000,0000,,Дегенмен, бұл бірден орын алатын нақты жағдай.
Dialogue: 0,0:23:24.07,0:23:25.31,CNsub,NTP,0000,0000,0000,,Елеусіздік
Dialogue: 0,0:23:25.81,0:23:26.96,CNsub,NTP,0000,0000,0000,,Келіспеушіліктер
Dialogue: 0,0:23:27.20,0:23:28.57,CNsub,NTP,0000,0000,0000,,Дегенмен, Гаякоресики
Dialogue: 0,0:23:28.99,0:23:31.15,CNsub,NTP,0000,0000,0000,,Кенеттен және кенеттен кездеспеу
Dialogue: 0,0:23:32.38,0:23:33.23,CNsub,NTP,0000,0000,0000,,Рұқсатсыз
Dialogue: 0,0:23:33.70,0:23:36.13,CNsub,NTP,0000,0000,0000,,Соңғы уақытта Гавана отбасы белгілі бір орынға қойылды.
Dialogue: 0,0:23:37.63,0:23:38.30,CNsub,NTP,0000,0000,0000,,Мұндайды есту өте сирек
Dialogue: 0,0:23:38.76,0:23:42.44,CNsub,NTP,0000,0000,0000,,Физикалық пайдалану физикалық пайдалануға байланысты.
Dialogue: 0,0:23:43.06,0:23:45.01,CNsub,NTP,0000,0000,0000,,Мен қай жерде болсам, мен қара пауловния бетін көремін
Dialogue: 0,0:23:45.32,0:23:47.41,CNsub,NTP,0000,0000,0000,,Сондай-ақ, мүмкін емес болғандықтан экранды көруге болады
Dialogue: 0,0:23:48.14,0:23:48.74,CNsub,NTP,0000,0000,0000,,Рұқсатсыз
Dialogue: 0,0:23:49.07,0:23:52.17,CNsub,NTP,0000,0000,0000,,Мен өзімнің өтінішім туралы ойладым.
Dialogue: 0,0:23:53.83,0:23:55.74,CNsub,NTP,0000,0000,0000,,``Куротуяның өлім сериясы''
Dialogue: 0,0:23:55.90,0:23:58.16,CNsub,NTP,0000,0000,0000,,Түпнұсқа тілін пайдалану мүмкін емес
Dialogue: 0,0:23:58.98,0:23:59.93,CNsub,NTP,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:24:01.49,0:24:03.82,CNsub,NTP,0000,0000,0000,,Менің мінезім басқаша.
Dialogue: 0,0:24:04.65,0:24:05.29,CNsub,NTP,0000,0000,0000,,Қателік
Dialogue: 0,0:24:05.59,0:24:07.36,CNsub,NTP,0000,0000,0000,,Салтанатты рәсім
Dialogue: 0,0:24:08.15,0:24:09.91,CNsub,NTP,0000,0000,0000,,«Жоғары қызметте» болу ниетіңіз қандай?
Dialogue: 0,0:24:12.08,0:24:13.13,CNsub,NTP,0000,0000,0000,,Енді аспан бұл жерге жетті
Dialogue: 0,0:24:20.50,0:24:21.29,CNsub,NTP,0000,0000,0000,,Кездесу аяқталды
Dialogue: 0,0:24:23.88,0:24:26.26,CNsub,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:24:26.67,0:24:28.33,CNsub,NTP,0000,0000,0000,,Жақында кездесу мүмкіндігі
Dialogue: 0,0:24:33.56,0:24:34.95,CNsub,NTP,0000,0000,0000,,Шай ішу рәсімі
Dialogue: 0,0:24:35.41,0:24:36.94,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:24:37.83,0:24:40.31,CNsub,NTP,0000,0000,0000,,Ойыңызды өзгерткен кезде
Dialogue: 0,0:24:41.11,0:24:42.64,CNsub,NTP,0000,0000,0000,,Бұл қанды серия емес.
Dialogue: 0,0:24:43.01,0:24:44.96,CNsub,NTP,0000,0000,0000,,Қабыршақтау
Dialogue: 0,0:24:45.36,0:24:47.55,CNsub,NTP,0000,0000,0000,,Өткенде
Dialogue: 0,0:24:48.42,0:24:49.69,CNsub,NTP,0000,0000,0000,,Ат үстінде тамақ ішу
Dialogue: 0,0:24:49.99,0:24:51.62,CNsub,NTP,0000,0000,0000,,Абайлаңыз
Dialogue: 0,0:24:54.87,0:24:56.51,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:24:57.16,0:24:59.29,CNsub,NTP,0000,0000,0000,,Жылдам сұрақ: Бүгінгі кешкі ас қандай?
Dialogue: 0,0:25:00.12,0:25:01.02,CNsub,NTP,0000,0000,0000,,Отқа арналған қазан
Dialogue: 0,0:25:01.50,0:25:03.27,CNsub,NTP,0000,0000,0000,,Қызметке көңілі толмады
Dialogue: 0,0:25:04.48,0:25:09.28,CNsub,NTP,0000,0000,0000,,Ойлау мен түсінудің түпкі мақсаты
Dialogue: 0,0:25:11.75,0:25:13.18,CNsub,NTP,0000,0000,0000,,Арнайы сұрақтардың қысқаша мазмұны
Dialogue: 0,0:25:13.75,0:25:17.61,CNsub,NTP,0000,0000,0000,,Екінші адам – жәбірленушінің денесі... екі жарым құрамдас бөлігі бар.
Dialogue: 0,0:25:17.94,0:25:20.14,CNsub,NTP,0000,0000,0000,,Үшінші адам кесілгеннен кейін
Dialogue: 0,0:25:20.48,0:25:23.60,CNsub,NTP,0000,0000,0000,,Қол аяқта Аяқ қолда
Dialogue: 0,0:25:24.13,0:25:25.93,CNsub,NTP,0000,0000,0000,,Төртінші жақ – кесілген кесінді.
Dialogue: 0,0:25:26.39,0:25:29.10,CNsub,NTP,0000,0000,0000,,Жұмбақ белгінің ою
Dialogue: 0,0:25:31.17,0:25:36.36,CNsub,NTP,0000,0000,0000,,Осыдан кейін бесінші адамның бейнесі аяқталып, орталыққа арналған қол-аяқ аяқталды.
Dialogue: 0,0:25:36.89,0:25:38.97,CNsub,NTP,0000,0000,0000,,Көруге оңай екені рас.
Dialogue: 0,0:25:39.26,0:25:42.93,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:25:43.67,0:25:44.41,CNsub,NTP,0000,0000,0000,,Кения
Dialogue: 0,0:25:44.91,0:25:46.22,CNsub,NTP,0000,0000,0000,,Сізге ұнады ма?
Dialogue: 0,0:25:46.75,0:25:49.14,CNsub,NTP,0000,0000,0000,,Мен сала туралы не ойлаймын?
Dialogue: 0,0:25:50.04,0:25:50.78,CNsub,NTP,0000,0000,0000,,Тадаши…
Dialogue: 0,0:25:51.24,0:25:51.93,CNsub,NTP,0000,0000,0000,,Дәл осы ма?
Dialogue: 0,0:25:52.39,0:25:54.29,CNsub,NTP,0000,0000,0000,,Алғыс сезімі
Dialogue: 0,0:25:55.33,0:25:57.20,CNsub,NTP,0000,0000,0000,,Жоқ қозғалыс және жоқ заңдылық
Dialogue: 0,0:25:57.73,0:25:58.91,CNsub,NTP,0000,0000,0000,,Қазір қандай болса, ол сыртта.
Dialogue: 0,0:25:59.13,0:26:01.18,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:26:01.52,0:26:03.78,CNsub,NTP,0000,0000,0000,,Бөлме іші
Dialogue: 0,0:26:05.28,0:26:05.97,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:26:06.31,0:26:08.29,CNsub,NTP,0000,0000,0000,,Байланыс ақпараты құпия болып табылады.
Dialogue: 0,0:26:08.99,0:26:09.93,CNsub,NTP,0000,0000,0000,,Нашуқан аяқталды
Dialogue: 0,0:26:10.33,0:26:12.39,CNsub,NTP,0000,0000,0000,,Қазірдің өзінде құпия түрде оқуға болады.
Dialogue: 0,0:26:12.77,0:26:13.78,CNsub,NTP,0000,0000,0000,,Сондықтан түсініктеме
Dialogue: 0,0:26:14.18,0:26:15.42,CNsub,NTP,0000,0000,0000,,Бұл сіздің өзіңіз ойлаған әңгімеңіз.
Dialogue: 0,0:26:15.94,0:26:16.92,CNsub,NTP,0000,0000,0000,,Мұнда емес
Dialogue: 0,0:26:17.59,0:26:21.14,CNsub,NTP,0000,0000,0000,,Қолайсыздықтар үшін кешірім сұраймын.
Dialogue: 0,0:26:22.51,0:26:23.78,CNsub,NTP,0000,0000,0000,,Бесінші оқиға болған жер
Dialogue: 0,0:26:24.10,0:26:25.74,CNsub,NTP,0000,0000,0000,,Қаланың шығысы мен батысында тұру
Dialogue: 0,0:26:27.30,0:26:28.57,CNsub,NTP,0000,0000,0000,,Бұл...біздің мектеп...
Dialogue: 0,0:26:28.86,0:26:32.44,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:26:34.47,0:26:37.56,CNsub,NTP,0000,0000,0000,,Сіз сәтті кездесуге де қатыса аласыз.
Dialogue: 0,0:26:38.61,0:26:39.34,CNsub,NTP,0000,0000,0000,,Неаполь, таңғы 11:26
Dialogue: 0,0:26:42.21,0:26:43.51,CNsub,NTP,0000,0000,0000,,Сыйлық жіберу
Dialogue: 0,0:26:44.37,0:26:45.59,CNsub,NTP,0000,0000,0000,,Уайымдаудың қажеті жоқ
Dialogue: 0,0:26:46.13,0:26:48.05,CNsub,NTP,0000,0000,0000,,Аяның жұмыс кестесі тығыз.
Dialogue: 0,0:26:48.47,0:26:50.02,CNsub,NTP,0000,0000,0000,,Қазір полиция бөлімшесінен кетіңіз
Dialogue: 0,0:26:50.51,0:26:52.17,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:26:59.69,0:27:01.13,CNsub,NTP,0000,0000,0000,,Үшінші семестрдің басталуы
Dialogue: 0,0:27:01.42,0:27:04.32,CNsub,NTP,0000,0000,0000,,Салтанатты өзгерту оқшауланған өзін-өзі тану
Dialogue: 0,0:27:04.48,0:27:05.02,CNsub,NTP,0000,0000,0000,,Жылдам жүгіру жылдам жүгіру
Dialogue: 0,0:27:05.20,0:27:05.99,CNsub,NTP,0000,0000,0000,,Біздің бірінші болып жүгіретініміз сөзсіз еді.
Dialogue: 0,0:27:08.04,0:27:08.72,CNsub,NTP,0000,0000,0000,,т.б
Dialogue: 0,0:27:06.86,0:27:11.75,CNsub,NTP,0000,0000,0000,,Айналадағы қоршаған ортаға байланысты, айналаның сыртқы көрінісін байқамау менің астанамды сезінуге әкеледі.
Dialogue: 0,0:27:15.31,0:27:16.50,CNsub,NTP,0000,0000,0000,,Менің оқиғам: Қара пауловния
Dialogue: 0,0:27:17.22,0:27:20.07,CNsub,NTP,0000,0000,0000,,Мен сізге көмектесу үшін келдім.
Dialogue: 0,0:27:21.29,0:27:24.02,CNsub,NTP,0000,0000,0000,,Бірінші оқылым...Бұл бірінші оқылым ба?
Dialogue: 0,0:27:24.64,0:27:28.47,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:27:29.41,0:27:33.35,CNsub,NTP,0000,0000,0000,,Аз уақытты көргің келмейді.
Dialogue: 0,0:27:34.03,0:27:35.44,CNsub,NTP,0000,0000,0000,,Қаралған иесі
Dialogue: 0,0:27:35.58,0:27:39.18,CNsub,NTP,0000,0000,0000,,Бұл әлемнің өзіне деген шексіз сүйіспеншілігі
Dialogue: 0,0:27:39.83,0:27:41.24,CNsub,NTP,0000,0000,0000,,Өз-өзінен ләззат алу
Dialogue: 0,0:27:41.49,0:27:44.50,CNsub,NTP,0000,0000,0000,,Демек, алушының бақытты болуы заңдылық.
Dialogue: 0,0:27:44.85,0:27:46.42,CNsub,NTP,0000,0000,0000,,Шыққан жерін растау
Dialogue: 0,0:27:47.52,0:27:48.47,CNsub,NTP,0000,0000,0000,,Дегенмен, солай
Dialogue: 0,0:27:49.15,0:27:51.77,CNsub,NTP,0000,0000,0000,,Белгісіз қажет.
Dialogue: 0,0:27:52.68,0:27:54.37,CNsub,NTP,0000,0000,0000,,Бұл өзін-өзі жетілдіру.
Dialogue: 0,0:27:54.83,0:27:57.90,CNsub,NTP,0000,0000,0000,,Сүйікті алғыс кездесуін аяқтау
Dialogue: 0,0:27:58.45,0:28:00.88,CNsub,NTP,0000,0000,0000,,Дарынның бастауы, таланттың бастауы, таланттың бастауы
Dialogue: 0,0:28:01.41,0:28:05.25,CNsub,NTP,0000,0000,0000,,Адамның өз бетінше айтылатын сезімдері
Dialogue: 0,0:28:06.48,0:28:07.92,CNsub,NTP,0000,0000,0000,,Алайда мен бұрынғыдай емеспін.
Dialogue: 0,0:28:08.76,0:28:10.99,CNsub,NTP,0000,0000,0000,,Жаңа өмірге қадам басқан тағы бір адам
Dialogue: 0,0:28:11.79,0:28:14.21,CNsub,NTP,0000,0000,0000,,Себеп тәрізді ішкі орталықтанған мен
Dialogue: 0,0:28:16.09,0:28:19.13,CNsub,NTP,0000,0000,0000,,Маркиздің жас кезінен бастап, басқа адам екені көрініп тұрды.
Dialogue: 0,0:28:19.51,0:28:21.64,CNsub,NTP,0000,0000,0000,,Заңның табиғи бұзылуы, махаббат және т.б.
Dialogue: 0,0:28:22.45,0:28:24.90,CNsub,NTP,0000,0000,0000,,Салтанат орнында эмоциялар жоқ, бірақ мен оларды қабылдаудан бас тартамын.
Dialogue: 0,0:28:27.64,0:28:31.62,CNsub,NTP,0000,0000,0000,,Дегенмен...сен менімен үнсіз сөйлесе алмайсың.
Dialogue: 0,0:28:31.92,0:28:32.70,CNsub,NTP,0000,0000,0000,,Қарақұрым қоңырау белгісі мұнараның шыңынан алыстап барады. Мен оны сеземін.
Dialogue: 0,0:28:34.04,0:28:35.77,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:28:39.19,0:28:42.40,CNsub,NTP,0000,0000,0000,,Жалғыз және жалғыз
Dialogue: 0,0:28:43.64,0:28:45.66,CNsub,NTP,0000,0000,0000,,Дегенмен, бұл жақында болған біртүрлі құбылыс.
Dialogue: 0,0:28:46.36,0:28:49.39,CNsub,NTP,0000,0000,0000,,Мен өз ойымда басқа адаммын.
Dialogue: 0,0:28:49.87,0:28:51.53,CNsub,NTP,0000,0000,0000,,Алайда бұл бас тарту
Dialogue: 0,0:28:52.20,0:28:54.07,CNsub,NTP,0000,0000,0000,,Терістеу – өзімшілдік жағдайлар
Dialogue: 0,0:28:54.78,0:28:57.71,CNsub,NTP,0000,0000,0000,,Дарындылықты растау қабілетін сертификаттау
Dialogue: 0,0:28:59.38,0:29:00.61,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:29:05.11,0:29:05.92,CNsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,0:29:06.39,0:29:08.65,CNsub,NTP,0000,0000,0000,,Сіз біреуді өлтіруді ойладыңыз
Dialogue: 0,0:29:09.55,0:29:10.99,CNsub,NTP,0000,0000,0000,,Соңына жетпей жоғалып кетті
Dialogue: 0,0:29:11.24,0:29:12.08,CNsub,NTP,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:29:12.41,0:29:14.15,CNsub,NTP,0000,0000,0000,,Дегенмен, менде бұл ғана бар.
Dialogue: 0,0:29:15.48,0:29:19.13,CNsub,NTP,0000,0000,0000,,Мен репрессиялық идеологиялық тұлғамын.
Dialogue: 0,0:29:19.95,0:29:22.02,CNsub,NTP,0000,0000,0000,,Сондықтан мен өз ойымнан тікелей хабардармын.
Dialogue: 0,0:29:23.02,0:29:25.09,CNsub,NTP,0000,0000,0000,,Тікелей қатысқан адамның аты – «Мен».
Dialogue: 0,0:29:25.84,0:29:29.68,CNsub,NTP,0000,0000,0000,,Шексіз дәрежелер Өзін-өзі өлтіру
Dialogue: 0,0:29:30.77,0:29:34.89,CNsub,NTP,0000,0000,0000,,Мен өз сезімімді айта алмаймын.
Dialogue: 0,0:29:36.28,0:29:37.12,CNsub,NTP,0000,0000,0000,,Көру
Dialogue: 0,0:29:37.52,0:29:39.78,CNsub,NTP,0000,0000,0000,,Менің денеме әсер ететін эмоциялар
Dialogue: 0,0:29:40.47,0:29:41.92,CNsub,NTP,0000,0000,0000,,Өлтірген адам
Dialogue: 0,0:29:44.23,0:29:45.78,CNsub,NTP,0000,0000,0000,,Қара Пауловнияның орналасқан жері
Dialogue: 0,0:29:46.55,0:29:48.31,CNsub,NTP,0000,0000,0000,,Өлім жазасының анықтамасы
Dialogue: 0,0:29:49.90,0:29:51.86,CNsub,NTP,0000,0000,0000,,Мен сені өлтіремін
Dialogue: 0,0:29:53.09,0:29:56.57,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:29:57.61,0:29:58.54,CNsub,NTP,0000,0000,0000,,Салтанатты рәсім
Dialogue: 0,0:29:58.92,0:30:04.19,CNsub,NTP,0000,0000,0000,,Егер сіз өзіңізді қорғағыңыз келсе, компанияны иелену жоспарын жасай аласыз, осылайша сіз біреуді өлтіресіз.
Dialogue: 0,0:30:22.92,0:30:23.58,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:30:24.21,0:30:25.64,CNsub,NTP,0000,0000,0000,,Оянып, кешкі ас іш
Dialogue: 0,0:30:28.93,0:30:30.55,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:30:31.76,0:30:32.49,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:30:33.24,0:30:35.35,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:30:35.83,0:30:36.67,CNsub,NTP,0000,0000,0000,,Ұпай жинады ма?
Dialogue: 0,0:30:39.22,0:30:40.69,CNsub,NTP,0000,0000,0000,,Мен де кіршіксізмін
Dialogue: 0,0:30:40.84,0:30:43.59,CNsub,NTP,0000,0000,0000,,Алайда мен бір мектепте оқып жүргенде ашуландым.
Dialogue: 0,0:30:44.25,0:30:46.87,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:30:47.23,0:30:50.11,CNsub,NTP,0000,0000,0000,,Егер сізге қоңырау шалса, сіз ешқандай өзгертулер енгізе алмайсыз
Dialogue: 0,0:30:50.32,0:30:51.35,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:30:51.85,0:30:53.94,CNsub,NTP,0000,0000,0000,,Ақылға қонымды мағынасы да түсініксіз
Dialogue: 0,0:30:54.58,0:30:56.45,CNsub,NTP,0000,0000,0000,,Жапон стилі
Dialogue: 0,0:30:56.81,0:30:59.13,CNsub,NTP,0000,0000,0000,,Дегенмен, қымсынбаңыз.
Dialogue: 0,0:30:59.76,0:31:00.46,CNsub,NTP,0000,0000,0000,,Рұқсатсыз
Dialogue: 0,0:31:00.83,0:31:04.86,CNsub,NTP,0000,0000,0000,,Бұрынғы жағдайларға байланысты болуы мүмкін.
Dialogue: 0,0:31:05.69,0:31:06.87,CNsub,NTP,0000,0000,0000,,Куротоу Догаку
Dialogue: 0,0:31:07.40,0:31:09.70,CNsub,NTP,0000,0000,0000,,Мен сенің басқа адам екеніңді түсіндім.
Dialogue: 0,0:31:10.98,0:31:11.72,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:31:12.03,0:31:13.45,CNsub,NTP,0000,0000,0000,,Сөзсіз шағым
Dialogue: 0,0:31:14.05,0:31:15.04,CNsub,NTP,0000,0000,0000,,артқа
Dialogue: 0,0:31:15.53,0:31:17.27,CNsub,NTP,0000,0000,0000,,Оқиғаны растау және жою
Dialogue: 0,0:31:17.98,0:31:20.89,CNsub,NTP,0000,0000,0000,,Мен көпшілікпен араласқан адам емеспін.
Dialogue: 0,0:31:23.21,0:31:26.39,CNsub,NTP,0000,0000,0000,,Достар арасындағы қарым-қатынас қалыпты немесе әртүрлі.
Dialogue: 0,0:31:28.24,0:31:31.56,CNsub,NTP,0000,0000,0000,,Алайда,...Заңды менсінбедім.
Dialogue: 0,0:31:34.68,0:31:35.39,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:31:35.70,0:31:36.56,CNsub,NTP,0000,0000,0000,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:31:39.58,0:31:42.17,CNsub,NTP,0000,0000,0000,,Бұл алдыңғы өлтірушінің өлімінен болған жарақат.
Dialogue: 0,0:31:42.89,0:31:44.04,CNsub,NTP,0000,0000,0000,,Сіз тағы да осындасыз…
Dialogue: 0,0:31:47.18,0:31:49.31,CNsub,NTP,0000,0000,0000,,Нәтижесінде анық сөйлеу мүмкін емес
Dialogue: 0,0:31:49.72,0:31:51.13,CNsub,NTP,0000,0000,0000,,Маған хабарлаңыз
Dialogue: 0,0:31:51.78,0:31:52.87,CNsub,NTP,0000,0000,0000,,Қайта ашу
Dialogue: 0,0:31:53.40,0:31:55.54,CNsub,NTP,0000,0000,0000,,Хаягай партиясы өлтірілді.
Dialogue: 0,0:32:10.84,0:32:12.40,CNsub,NTP,0000,0000,0000,,Ғалымдардың біліктілігі
Dialogue: 0,0:32:13.65,0:32:14.41,CNsub,NTP,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:32:14.82,0:32:17.00,CNsub,NTP,0000,0000,0000,,Позицияға тезірек жету керек.
Dialogue: 0,0:32:17.94,0:32:20.96,CNsub,NTP,0000,0000,0000,,Ерте келгенімде абдырап қалдым.
Dialogue: 0,0:32:23.61,0:32:24.48,CNsub,NTP,0000,0000,0000,,Мен тағы келдім
Dialogue: 0,0:32:25.53,0:32:26.38,CNsub,NTP,0000,0000,0000,,Патша үйі
Dialogue: 0,0:32:27.13,0:32:29.03,CNsub,NTP,0000,0000,0000,,Сізге тағы біреу келді ме?
Dialogue: 0,0:32:29.50,0:32:30.34,CNsub,NTP,0000,0000,0000,,Зая ауылы
Dialogue: 0,0:32:33.09,0:32:33.89,CNsub,NTP,0000,0000,0000,,отбасы құру
Dialogue: 0,0:32:34.14,0:32:34.65,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:32:34.89,0:32:35.87,CNsub,NTP,0000,0000,0000,,Қайтып келгенде
Dialogue: 0,0:32:36.22,0:32:37.48,CNsub,NTP,0000,0000,0000,,Қазіргі жағдай қандай?
Dialogue: 0,0:32:37.69,0:32:38.76,CNsub,NTP,0000,0000,0000,,Түнгі жұмысты аяқтау
Dialogue: 0,0:32:39.02,0:32:40.75,CNsub,NTP,0000,0000,0000,,Осы жерден үзіліс жасаңыз
Dialogue: 0,0:32:41.38,0:32:43.56,CNsub,NTP,0000,0000,0000,,Сіз кісі өлтіру ісіне қатысыңыз бар ма?
Dialogue: 0,0:32:43.81,0:32:44.40,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:32:44.70,0:32:47.06,CNsub,NTP,0000,0000,0000,,Алтыншы жәбірленуші Сантеннің алдына келді
Dialogue: 0,0:32:47.20,0:32:48.95,CNsub,NTP,0000,0000,0000,,Иә, бірақ...
Dialogue: 0,0:32:49.19,0:32:50.91,CNsub,NTP,0000,0000,0000,,Қазіргі уақытта бақылаудағы ақпарат
Dialogue: 0,0:32:51.15,0:32:56.01,CNsub,NTP,0000,0000,0000,,Адамдарға үстірт ұқсастық және мазасыздықтың адамдар мен өндірістік өмірге әсері
Dialogue: 0,0:33:00.20,0:33:02.17,CNsub,NTP,0000,0000,0000,,Мен мектептен шыққанға дейін.
Dialogue: 0,0:33:02.70,0:33:03.87,CNsub,NTP,0000,0000,0000,,Оқиғадан кейін не болды?
Dialogue: 0,0:33:04.31,0:33:05.44,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:33:05.74,0:33:07.66,CNsub,NTP,0000,0000,0000,,Бұрын қызық өмірден өткен
Dialogue: 0,0:33:08.03,0:33:10.06,CNsub,NTP,0000,0000,0000,,Қазір пайда болатын күш
Dialogue: 0,0:33:10.70,0:33:11.59,CNsub,NTP,0000,0000,0000,,Сәттілік
Dialogue: 0,0:33:12.10,0:33:13.68,CNsub,NTP,0000,0000,0000,,Маған кез келген жаңалық туралы хабарлау.
Dialogue: 0,0:33:15.20,0:33:19.31,CNsub,NTP,0000,0000,0000,,Алтыншы әйелдің саусағының артқы жағындағы терінің қалдықтары алынды.
Dialogue: 0,0:33:19.81,0:33:23.19,CNsub,NTP,0000,0000,0000,,Қылмыскердің ілгерілеуі мен қарсылығы келгенде
Dialogue: 0,0:33:23.39,0:33:25.42,CNsub,NTP,0000,0000,0000,,Қылмыскер сол кезде жарақат алды ма?
Dialogue: 0,0:33:25.58,0:33:30.89,CNsub,NTP,0000,0000,0000,,Криминалистикалық сараптама қылмыскердің қолы мен шынтағы бір-біріне жақын орналасқан.
Dialogue: 0,0:33:32.76,0:33:34.49,CNsub,NTP,0000,0000,0000,,Садая қазір орындалуда.
Dialogue: 0,0:33:34.83,0:33:36.66,CNsub,NTP,0000,0000,0000,,Сәтті әскери қолбасшы
Dialogue: 0,0:33:44.56,0:33:46.12,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:33:46.55,0:33:47.81,CNsub,NTP,0000,0000,0000,,Қандай түсті көріп тұрсыңдар?
Dialogue: 0,0:33:50.57,0:33:51.74,CNsub,NTP,0000,0000,0000,,Түсінгеніңізге рахмет.
Dialogue: 0,0:33:52.50,0:33:56.32,CNsub,NTP,0000,0000,0000,,Станциядағы қозғалмайтын пейзаж
Dialogue: 0,0:34:11.39,0:34:12.29,CNsub,NTP,0000,0000,0000,,Үйге бармайсыз ба?
Dialogue: 0,0:34:12.90,0:34:13.86,CNsub,NTP,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:34:14.70,0:34:16.85,CNsub,NTP,0000,0000,0000,,Бұл шабуылдың шынайы қолайсыз ниеті
Dialogue: 0,0:34:17.83,0:34:18.97,CNsub,NTP,0000,0000,0000,,Мойындау аяқталды
Dialogue: 0,0:34:35.20,0:34:38.22,CNsub,NTP,0000,0000,0000,,Шағын уақыттағы төтенше жын
Dialogue: 0,0:34:38.89,0:34:42.14,CNsub,NTP,0000,0000,0000,,Тәкебаяшы ауылының бейнесі
Dialogue: 0,0:34:42.71,0:34:43.60,CNsub,NTP,0000,0000,0000,,Енді олар жай ғана кішігірім бандиттер тобы
Dialogue: 0,0:34:43.79,0:34:45.24,CNsub,NTP,0000,0000,0000,,Қазіргі уақыттағы адам
Dialogue: 0,0:34:46.45,0:34:50.93,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:34:52.77,0:34:53.92,CNsub,NTP,0000,0000,0000,,Біздің осында екеніміз басынан-ақ белгілі.
Dialogue: 0,0:34:54.43,0:34:59.17,CNsub,NTP,0000,0000,0000,,Кішкене ғана белгісіз тіршілік бар, бірақ ол белгісіз көше адамы.
Dialogue: 0,0:35:01.79,0:35:02.85,CNsub,NTP,0000,0000,0000,,Қолайсыз қозу сезімі
Dialogue: 0,0:35:03.34,0:35:05.29,CNsub,NTP,0000,0000,0000,,Күннің ортасында бір тікелей қатысу
Dialogue: 0,0:35:06.71,0:35:07.59,CNsub,NTP,0000,0000,0000,,Әңгіменің шығу тегі…
Dialogue: 0,0:35:08.36,0:35:11.82,CNsub,NTP,0000,0000,0000,,Салтанат алдында ұқсас сөздерді айту мүмкін емес.
Dialogue: 0,0:35:20.09,0:35:24.01,CNsub,NTP,0000,0000,0000,,Жолдың бірден пайдаланылуын көру мүмкін емес
Dialogue: 0,0:35:27.83,0:35:32.91,CNsub,NTP,0000,0000,0000,,Мүмкіндігінше тезірек
Dialogue: 0,0:35:33.77,0:35:35.79,CNsub,NTP,0000,0000,0000,,Нәтижесінде вагон бекеті қайта оралды.
Dialogue: 0,0:36:52.32,0:36:54.29,CNsub,NTP,0000,0000,0000,,Ең қолайлы және ұялшақ бір нүкте Куротоу Дугаку
Dialogue: 0,0:36:55.46,0:36:56.64,CNsub,NTP,0000,0000,0000,,Жауапсыз қорқыныш
Dialogue: 0,0:36:57.09,0:36:59.55,CNsub,NTP,0000,0000,0000,,Келуге шақыру және есепке алынбаған шындық
Dialogue: 0,0:37:13.53,0:37:16.29,CNsub,NTP,0000,0000,0000,,Сіздің өміріңіздің соңында қанша адам келді?
Dialogue: 0,0:37:16.77,0:37:17.80,CNsub,NTP,0000,0000,0000,,Жасырын
Dialogue: 0,0:37:18.50,0:37:19.71,CNsub,NTP,0000,0000,0000,,Шындық келді
Dialogue: 0,0:37:20.14,0:37:21.73,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:37:22.28,0:37:23.13,CNsub,NTP,0000,0000,0000,,Үлкен масштаб
Dialogue: 0,0:37:23.61,0:37:25.04,CNsub,NTP,0000,0000,0000,,Қазіргі уақытта бұл қажет емес…
Dialogue: 0,0:37:27.45,0:37:28.20,CNsub,NTP,0000,0000,0000,,Бұл елдің контрбарлау қызметін талқандау оңай емес.
Dialogue: 0,0:37:28.36,0:37:31.31,CNsub,NTP,0000,0000,0000,,Әңгімені қарау керек. Жағдайлар қолайлы.
Dialogue: 0,0:37:32.44,0:37:33.48,CNsub,NTP,0000,0000,0000,,Дайсуке
Dialogue: 0,0:37:33.98,0:37:35.87,CNsub,NTP,0000,0000,0000,,Ондық? Есіңізде ме?
Dialogue: 0,0:37:37.00,0:37:39.13,CNsub,NTP,0000,0000,0000,,Үйіңіздегі басқа адамдарды қайдан көруге болады
Dialogue: 0,0:37:39.34,0:37:39.91,CNsub,NTP,0000,0000,0000,,Жою
Dialogue: 0,0:37:40.15,0:37:41.59,CNsub,NTP,0000,0000,0000,,Үйдің ішкі жағдайын айту
Dialogue: 0,0:37:41.71,0:37:43.93,CNsub,NTP,0000,0000,0000,,Сыртқы биологиялық жағдайлар және басқа да мәселелер
Dialogue: 0,0:37:45.03,0:37:45.97,CNsub,NTP,0000,0000,0000,,Бұл...
Dialogue: 0,0:38:28.90,0:38:29.75,CNsub,NTP,0000,0000,0000,,Үлкен және кіші апаны теріп жаз
Dialogue: 0,0:38:30.54,0:38:31.68,CNsub,NTP,0000,0000,0000,,Бір шабуыл болуы мүмкін
Dialogue: 0,0:38:32.70,0:38:33.42,CNsub,NTP,0000,0000,0000,,Ондық?
Dialogue: 0,0:38:36.52,0:38:39.31,CNsub,NTP,0000,0000,0000,,Жауапты тұлғаның сыртқы көрінісі
Dialogue: 0,0:38:39.97,0:38:42.59,CNsub,NTP,0000,0000,0000,,Менің полиция қызметкерім мен әкем жүгірді.
Dialogue: 0,0:38:42.96,0:38:44.86,CNsub,NTP,0000,0000,0000,,Полиция өз ісіне шебер емес.
Dialogue: 0,0:38:45.81,0:38:47.92,CNsub,NTP,0000,0000,0000,,Бұл жағдайда мен білімімді жоғалттым.
Dialogue: 0,0:38:48.25,0:38:52.16,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:39:12.33,0:39:13.46,CNsub,NTP,0000,0000,0000,,Оқиғаның қалай өрбитіні туралы әңгіме
Dialogue: 0,0:39:13.73,0:39:15.00,CNsub,NTP,0000,0000,0000,,Мен басқа уақытты аламын
Dialogue: 0,0:39:16.45,0:39:18.30,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:39:27.06,0:39:29.92,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:40:33.64,0:40:35.34,CNsub,NTP,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:40:35.82,0:40:40.17,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:40:40.86,0:40:42.80,CNsub,NTP,0000,0000,0000,,Қайтадан демалыңыз.
Dialogue: 0,0:40:43.34,0:40:44.77,CNsub,NTP,0000,0000,0000,,Әке мен ана байғұс
Dialogue: 0,0:40:45.27,0:40:46.23,CNsub,NTP,0000,0000,0000,,Мен бірінші жүгірдім
Dialogue: 0,0:40:51.15,0:40:51.79,CNsub,NTP,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:41:42.66,0:41:43.72,CNsub,NTP,0000,0000,0000,,Куротоу Догаку
Dialogue: 0,0:41:44.53,0:41:45.97,CNsub,NTP,0000,0000,0000,,3 ақпан түні
Dialogue: 0,0:41:46.22,0:41:46.96,CNsub,NTP,0000,0000,0000,,Марио Зкро
Dialogue: 0,0:41:47.03,0:41:48.28,CNsub,NTP,0000,0000,0000,,Оқиғаны бөлек көрсету
Dialogue: 0,0:41:48.66,0:41:50.04,CNsub,NTP,0000,0000,0000,,Маған тағы да айқайлаңыз.
Dialogue: 0,0:41:50.33,0:41:51.07,CNsub,NTP,0000,0000,0000,,Қара тунг!
Dialogue: 0,0:41:52.51,0:41:53.51,CNsub,NTP,0000,0000,0000,,Айқындық
Dialogue: 0,0:41:54.00,0:41:55.98,CNsub,NTP,0000,0000,0000,,Сіз полиция қызметкерісіз бе?
Dialogue: 0,0:41:57.48,0:41:58.22,CNsub,NTP,0000,0000,0000,,Себеп
Dialogue: 0,0:41:58.73,0:42:00.05,CNsub,NTP,0000,0000,0000,,Менің көзім көрмей қалды.
Dialogue: 0,0:42:00.86,0:42:02.82,CNsub,NTP,0000,0000,0000,,Шики Тадаши Коремачи Зайнари
Dialogue: 0,0:42:03.53,0:42:05.11,CNsub,NTP,0000,0000,0000,,Мен де оны жаңа ғана көрдім.
Dialogue: 0,0:42:06.34,0:42:08.92,CNsub,NTP,0000,0000,0000,,Сондықтан мен бұған сенемін
Dialogue: 0,0:42:13.97,0:42:15.50,CNsub,NTP,0000,0000,0000,,Айғақтар
Dialogue: 0,0:42:16.33,0:42:18.24,CNsub,NTP,0000,0000,0000,,Сондықтан мен қатысуға тырысамын.
Dialogue: 0,0:42:19.22,0:42:21.62,CNsub,NTP,0000,0000,0000,,Өзіне деген сенімділік толық.
Dialogue: 0,0:42:22.19,0:42:24.60,CNsub,NTP,0000,0000,0000,,Әңгіменің соңы
Dialogue: 0,0:42:26.40,0:42:29.33,CNsub,NTP,0000,0000,0000,,Демек, қазіргі жағдай аяқталды.
Dialogue: 0,0:42:35.73,0:42:36.61,CNsub,NTP,0000,0000,0000,,Аспаннан кейін
Dialogue: 0,0:42:37.52,0:42:40.71,CNsub,NTP,0000,0000,0000,,Рәсімнің басынан мүлде ұмытылған тіршілік
Dialogue: 0,0:42:49.68,0:42:50.77,CNsub,NTP,0000,0000,0000,,Бұл жерде тікелей хабаршы
Dialogue: 0,0:42:51.29,0:42:53.21,CNsub,NTP,0000,0000,0000,,Аспанға келген сайын қақпаның сыртына шығамын.
Dialogue: 0,0:42:53.75,0:42:54.94,CNsub,NTP,0000,0000,0000,,Тікелей бақылау
Dialogue: 0,0:44:36.67,0:44:39.79,CNsub,NTP,0000,0000,0000,,Шындық сол, ортада адам бар.
Dialogue: 0,0:44:47.15,0:44:49.46,CNsub,NTP,0000,0000,0000,,Шынайы ойлауға жету рәсімі келді.
Dialogue: 0,0:44:50.10,0:44:51.81,CNsub,NTP,0000,0000,0000,,Сіз оны қайта көрмей қалдыңыз ба?
Dialogue: 0,0:44:52.52,0:44:54.42,CNsub,NTP,0000,0000,0000,,Бармау себебінен айқайладыңыз.
Dialogue: 0,0:44:54.77,0:44:55.38,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:44:55.79,0:44:58.92,CNsub,NTP,0000,0000,0000,,Кешіріңіз, бірақ мен өлтірушімін.
Dialogue: 0,0:45:02.03,0:45:03.05,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:45:04.16,0:45:05.66,CNsub,NTP,0000,0000,0000,,Мен өлтірушімін.
Dialogue: 0,0:45:06.29,0:45:08.36,CNsub,NTP,0000,0000,0000,,Сіз келген кезде өзіңізді көресіз.
Dialogue: 0,0:45:08.73,0:45:10.32,CNsub,NTP,0000,0000,0000,,Мен бас тартуым керек пе?
Dialogue: 0,0:45:10.87,0:45:12.55,CNsub,NTP,0000,0000,0000,,Таратылмау
Dialogue: 0,0:45:13.16,0:45:15.19,CNsub,NTP,0000,0000,0000,,Сіздің өліміңізге қатысты жағдайлар
Dialogue: 0,0:45:16.11,0:45:18.05,CNsub,NTP,0000,0000,0000,,Менің капиталымды дереу пайдалану керек пе?
Dialogue: 0,0:45:18.38,0:45:20.05,CNsub,NTP,0000,0000,0000,,Әртүрлі жағдайлар
Dialogue: 0,0:45:20.55,0:45:21.45,CNsub,NTP,0000,0000,0000,,Сөзсіз
Dialogue: 0,0:45:25.25,0:45:26.62,CNsub,NTP,0000,0000,0000,,Бірінші айқай
Dialogue: 0,0:45:27.60,0:45:30.09,CNsub,NTP,0000,0000,0000,,Сіз мені түсінесіз бе?
Dialogue: 0,0:45:31.95,0:45:34.88,CNsub,NTP,0000,0000,0000,,Бір нәрсені білу керек пе?
Dialogue: 0,0:45:35.38,0:45:36.56,CNsub,NTP,0000,0000,0000,,Табылмады
Dialogue: 0,0:45:37.60,0:45:41.04,CNsub,NTP,0000,0000,0000,,Дегенмен, мен өзіме сенімдімін деп есептеймін.
Dialogue: 0,0:45:42.67,0:45:43.41,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:45:43.79,0:45:44.87,CNsub,NTP,0000,0000,0000,,Себебі сен бақыттысың
Dialogue: 0,0:45:45.24,0:45:46.80,CNsub,NTP,0000,0000,0000,,Содан бері мен Соичи Соичидің тікелей сенімін бердім.
Dialogue: 0,0:45:50.98,0:45:52.20,CNsub,NTP,0000,0000,0000,,Сен қауынсың
Dialogue: 0,0:45:53.44,0:45:54.20,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:45:54.58,0:45:55.61,CNsub,NTP,0000,0000,0000,,Әрқашан өмір сүрген адам туралы әңгіме
Dialogue: 0,0:46:02.38,0:46:03.70,CNsub,NTP,0000,0000,0000,,Менің әңгімем Қара Пауловния
Dialogue: 0,0:46:04.56,0:46:05.88,CNsub,NTP,0000,0000,0000,,Тенданқайға қазір келесің бе?
Dialogue: 0,0:46:06.12,0:46:06.94,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:46:54.41,0:46:55.43,CNsub,NTP,0000,0000,0000,,Диск сол жерде
Dialogue: 0,0:46:59.58,0:47:01.98,CNsub,NTP,0000,0000,0000,,Өзін-өзі баспанасыз қалдыру
Dialogue: 0,0:47:05.60,0:47:07.01,CNsub,NTP,0000,0000,0000,,Менің шаш орамалым бар...
Dialogue: 0,0:47:07.95,0:47:08.58,CNsub,NTP,0000,0000,0000,,Таптым.
Dialogue: 0,0:47:31.76,0:47:32.70,CNsub,NTP,0000,0000,0000,,Формула?
Dialogue: 0,0:47:32.95,0:47:33.72,CNsub,NTP,0000,0000,0000,,Сізге ұнады ма?
Dialogue: 0,0:47:51.31,0:47:52.17,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:49:53.37,0:49:54.47,CNsub,NTP,0000,0000,0000,,Қара пауловния...
Dialogue: 0,0:49:59.37,0:50:00.28,CNsub,NTP,0000,0000,0000,,Қара тунг!
Dialogue: 0,0:50:31.95,0:50:36.04,CNsub,NTP,0000,0000,0000,,Қара тунг…оны осы жерден оқи аласыз
Dialogue: 0,0:50:37.02,0:50:38.02,CNsub,NTP,0000,0000,0000,,Қара пауловния...
Dialogue: 0,0:50:41.33,0:50:47.64,CNsub,NTP,0000,0000,0000,,Мен...мен...күтпеген өлім...
Dialogue: 0,0:50:54.28,0:50:57.15,CNsub,NTP,0000,0000,0000,,Мен...Мен өлімді ойладым.
Dialogue: 0,0:51:11.73,0:51:13.41,CNsub,NTP,0000,0000,0000,,Нана Менің бірінші ажырасуым
Dialogue: 0,0:51:14.23,0:51:15.80,CNsub,NTP,0000,0000,0000,,Екі уақытта да сол және оң.
Dialogue: 0,0:51:17.06,0:51:18.85,CNsub,NTP,0000,0000,0000,,Естелік сыйлық алу
Dialogue: 0,0:51:29.74,0:51:34.58,CNsub,NTP,0000,0000,0000,,Әр жұлдызды кезеңде түстен кейін алты рет мен қаладан бірінші рет шықтым.
Dialogue: 0,0:51:37.35,0:51:39.30,CNsub,NTP,0000,0000,0000,,Мен азап пен азаптан бейхабармын
Dialogue: 0,0:51:39.83,0:51:41.68,CNsub,NTP,0000,0000,0000,,Синри Мата – қиялшыл
Dialogue: 0,0:51:43.06,0:51:46.59,CNsub,NTP,0000,0000,0000,,Маған да белгісіз.
Dialogue: 0,0:51:50.23,0:51:50.98,CNsub,NTP,0000,0000,0000,,Бұл рөл де біраз қиын екен…
Dialogue: 0,0:51:51.44,0:51:55.67,CNsub,NTP,0000,0000,0000,,Рәсім ашылғаннан кейін жағажайдағы күлкі аяқталды.
Dialogue: 0,0:51:56.47,0:52:01.11,CNsub,NTP,0000,0000,0000,,Еске түсіргеннен кейін және бірінші разрядтан кейін кешке қозғалмайтын маркер
Dialogue: 0,0:52:02.16,0:52:03.73,CNsub,NTP,0000,0000,0000,,Будда кәдімгі батып бара жатқан күн астында дүниеге келген.
Dialogue: 0,0:52:04.52,0:52:08.15,CNsub,NTP,0000,0000,0000,,Менің сұрағыма жауап
Dialogue: 0,0:52:09.17,0:52:11.18,CNsub,NTP,0000,0000,0000,,Бір күндік салмақты жауап
Dialogue: 0,0:52:12.21,0:52:13.24,CNsub,NTP,0000,0000,0000,,Табылмады
Dialogue: 0,0:52:14.06,0:52:17.10,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:52:18.40,0:52:19.75,CNsub,NTP,0000,0000,0000,,Себебі сен бақыттысың
Dialogue: 0,0:52:20.49,0:52:22.11,CNsub,NTP,0000,0000,0000,,Содан бері Соичи өзінің тікелей сенімін қалдырды.
Dialogue: 0,0:52:24.07,0:52:25.77,CNsub,NTP,0000,0000,0000,,Қанбұқайда қанша адам өлтірілді?
Dialogue: 0,0:52:26.34,0:52:28.13,CNsub,NTP,0000,0000,0000,,Бір ғана нәрсені айтуға батылым жетеді.
Dialogue: 0,0:52:28.90,0:52:32.08,CNsub,NTP,0000,0000,0000,,Себеп тәрізді айқын өлтіретін ауырсыну
Dialogue: 0,0:52:32.56,0:52:33.58,CNsub,NTP,0000,0000,0000,,Қазірдің өзінде жәбірленуші
Dialogue: 0,0:52:34.03,0:52:39.00,CNsub,NTP,0000,0000,0000,,Оған да кінәлі кінәлі.
Dialogue: 0,0:52:39.86,0:52:41.13,CNsub,NTP,0000,0000,0000,,Осыған байланысты мен сізбен келісемін.
Dialogue: 0,0:52:41.75,0:52:44.86,CNsub,NTP,0000,0000,0000,,Өзара сенім білдіру және жарақаттанудың жоғалуы тікелей қатысады.
Dialogue: 0,0:52:46.30,0:52:48.30,CNsub,NTP,0000,0000,0000,,Жалпы
Dialogue: 0,0:52:48.88,0:52:53.24,CNsub,NTP,0000,0000,0000,,Әйтсе де, қала жоғалып кетсе, қатты мұңаясың.
Dialogue: 0,0:53:20.73,0:53:23.57,CNsub,NTP,0000,0000,0000,,1995 жылғы сәуір
Dialogue: 0,0:53:24.98,0:53:27.57,CNsub,NTP,0000,0000,0000,,Мен сені кездестірдім.
Dialogue: 0,0:58:11.09,0:58:13.50,CNsub,NTP,0000,0000,0000,,Үш дайын шахмат картасы
Dialogue: 0,0:58:13.82,0:58:17.73,CNsub,NTP,0000,0000,0000,,Тәуелді және қалқымалы қос денелі тұлға
Dialogue: 0,0:58:20.09,0:58:25.04,CNsub,NTP,0000,0000,0000,,Өліммен байланысқанда ләззат сезінетін сәйкес келмейтін адам
Dialogue: 0,0:58:27.46,0:58:31.58,CNsub,NTP,0000,0000,0000,,Өлімнен құтылыңыз, бірақ эгоизмге ие
Dialogue: 0,0:58:32.86,0:58:37.72,CNsub,NTP,0000,0000,0000,,Мен онымен өзара жойқын спиральдамын.
Dialogue: 0,0:59:09.52,0:59:12.64,CNsub,NTP,0000,0000,0000,,Мен...Ләззат көріп, жылап алдым.
Dialogue: 0,0:59:19.64,0:59:21.29,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:59:21.88,0:59:24.42,CNsub,NTP,0000,0000,0000,,Менің кеткеніме көп уақыт болды.
Dialogue: 0,0:59:25.21,0:59:27.51,CNsub,NTP,0000,0000,0000,,Қазіргі жағдайыңыз туралы не айтасыз?
Dialogue: 0,0:59:25.21,0:59:27.51,CNsub,NTP,0000,0000,0000,,Мен сені өлтіруім керек
Dialogue: 0,0:59:27.55,0:59:30.71,CNsub,NTP,0000,0000,0000,,Жеке әңгіме
Dialogue: 0,0:59:30.87,0:59:31.44,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:59:31.58,0:59:34.50,CNsub,NTP,0000,0000,0000,,Ұсақ-түйек——
Dialogue: 0,0:59:34.60,0:59:35.62,CNsub,NTP,0000,0000,0000,,Барлығы маңызды
Dialogue: 0,0:59:35.89,0:59:37.94,CNsub,NTP,0000,0000,0000,,Бұл Құдайдың өлімі
Dialogue: 0,0:59:41.07,0:59:42.61,CNsub,NTP,0000,0000,0000,,Мен жылай аламын
Dialogue: 0,1:00:00.95,1:00:06.95,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
