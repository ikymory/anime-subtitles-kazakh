Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.21,0:00:12.47,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:00:15.01,0:00:16.51,Default,,0,0,0,,Баяғыда Баяғыда
Dialogue: 0,0:00:17.39,0:00:20.47,Default,,0,0,0,,Кей жерлерде өте сөйлейтін адамдар бар.
Dialogue: 0,0:00:21.47,0:00:24.60,Default,,0,0,0,,Өте арманшыл бір қыз болыпты.
Dialogue: 0,0:00:27.36,0:00:33.45,Default,,0,0,0,,Қыз тау басындағы қамалға тамсанды.
Dialogue: 0,0:00:34.99,0:00:39.08,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:00:43.33,0:00:44.04,Default,,0,0,0,,Уау...
Dialogue: 0,0:00:45.12,0:00:46.12,Default,,0,0,0,,Дұрыс айтпадым ба, Крюгер мырза?
Dialogue: 0,0:00:46.21,0:00:48.33,Default,,0,0,0,,Қыздар армандайды
Dialogue: 0,0:00:49.13,0:00:52.17,Default,,0,0,0,,«Бір күні менің де тамаша ханзада болады»
Dialogue: 0,0:00:52.26,0:00:54.05,Default,,0,0,0,,«Құлып допына»
Dialogue: 0,0:00:54.13,0:00:55.97,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:00:56.72,0:00:58.22,Default,,0,0,0,,Ах
Dialogue: 0,0:01:07.35,0:01:08.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:08.56,0:01:10.23,Default,,0,0,0,,Па... папа?
Dialogue: 0,0:01:41.10,0:01:44.18,Default,,0,0,0,,Ах... аа... Уау!
Dialogue: 0,0:01:57.11,0:01:59.24,Default,,0,0,0,,Анашым! Анашым!
Dialogue: 0,0:02:01.62,0:02:02.41,Default,,0,0,0,,Мама!
Dialogue: 0,0:02:02.99,0:02:04.29,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:02:04.37,0:02:06.96,Default,,0,0,0,,Қазір! Анашым, сіз білесіз, білесіз бе!
Dialogue: 0,0:02:07.04,0:02:08.25,Default,,0,0,0,,Дәл қазір...
Dialogue: 0,0:02:08.33,0:02:10.38,Default,,0,0,0,,Тамагояки сізге ауыз ашады
Dialogue: 0,0:02:15.26,0:02:17.72,Default,,0,0,0,,Эй, эй... хамай
Dialogue: 0,0:02:17.80,0:02:20.43,Default,,0,0,0,,Бұйрық рас, ауыздан туған.
Dialogue: 0,0:02:20.93,0:02:23.81,Default,,0,0,0,,Күте тұрыңыз, мен қазір әкемнің кешкі асын дайындаймын.
Dialogue: 0,0:02:23.89,0:02:27.56,Default,,0,0,0,,Иә, папа сарайдан шықты!
Dialogue: 0,0:02:28.77,0:02:29.35,Default,,0,0,0,,Құлып?
Dialogue: 0,0:02:29.44,0:02:34.07,Default,,0,0,0,,Иә, Ояма! Әкем ханзада болған
Dialogue: 0,0:02:34.15,0:02:36.32,Default,,0,0,0,,Ханшайым менің анам емес еді
Dialogue: 0,0:02:36.40,0:02:40.36,Default,,0,0,0,,Анашым, сіз кешкі ас әзірлеп жатқандықтан балға бара алмадыңыз ба?
Dialogue: 0,0:02:40.86,0:02:44.37,Default,,0,0,0,,Әй, анам бақсы шығар?
Dialogue: 0,0:02:44.45,0:02:46.20,Default,,0,0,0,,Бірақ мен оның жақсы бақсы екеніне сенімдімін.
Dialogue: 0,0:02:46.29,0:02:48.58,Default,,0,0,0,,Жаман бақсы толығырақ...
Dialogue: 0,0:02:49.79,0:02:50.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:51.17,0:02:51.67,Default,,0,0,0,,Тапсырыс…
Dialogue: 0,0:02:53.63,0:02:56.50,Default,,0,0,0,,Енді сөйлеме.
Dialogue: 0,0:02:58.55,0:02:59.42,Default,,0,0,0,,Неге... Хмм?
Dialogue: 0,0:03:00.34,0:03:03.30,Default,,0,0,0,,Бұл туралы ешкімге айтпа.
Dialogue: 0,0:03:03.89,0:03:07.64,Default,,0,0,0,,Менімен енді сөйлеспе... Жоқ.
Dialogue: 0,0:03:10.44,0:03:13.27,Default,,0,0,0,,Қайта... ешқашан емес пе?
Dialogue: 0,0:03:14.40,0:03:16.57,Default,,0,0,0,,Олай болса, осымен бітті.
Dialogue: 0,0:03:16.65,0:03:18.94,Default,,0,0,0,,Осы жерге қол қойыңыз
Dialogue: 0,0:03:19.03,0:03:20.36,Default,,0,0,0,,А, жақсы
Dialogue: 0,0:03:20.86,0:03:24.45,Default,,0,0,0,,Ал қарны шығыңқы ханзада
Dialogue: 0,0:03:24.95,0:03:29.79,Default,,0,0,0,,Ізгі бақсы үйінен қуып шыққан ол жылап, ханшайымға оралады.
Dialogue: 0,0:03:29.87,0:03:31.16,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,0:03:32.33,0:03:34.42,Default,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:03:34.96,0:03:37.80,Default,,0,0,0,,А... онда мен бірінші көлікте отырмын.
Dialogue: 0,0:03:37.88,0:03:39.92,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:03:40.42,0:03:41.63,Default,,0,0,0,,(Рюи) Неге сен өртеніп жатқан жоқсың?
Dialogue: 0,0:03:43.09,0:03:44.09,Default,,0,0,0,,Ах
Dialogue: 0,0:03:44.18,0:03:46.72,Default,,0,0,0,,А... білесің бе, анаңмен ұрысып қалсаң.
Dialogue: 0,0:03:46.80,0:03:48.60,Default,,0,0,0,,Джун сенімен татуласып кетеді.
Dialogue: 0,0:03:49.18,0:03:51.43,Default,,0,0,0,,Сондықтан әкем бұрынғыдай...
Dialogue: 0,0:03:51.52,0:03:52.31,Default,,0,0,0,,Бұйрық
Dialogue: 0,0:03:54.06,0:03:57.90,Default,,0,0,0,,Сіз... шынымен де сөйлейтінсіз.
Dialogue: 0,0:03:57.98,0:03:58.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:59.94,0:04:03.24,Default,,0,0,0,,Бәріне сен кінәлі емессің бе?
Dialogue: 0,0:04:03.74,0:04:06.24,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:04:06.32,0:04:08.20,Default,,0,0,0,,Ал, мен жол көрсетемін.
Dialogue: 0,0:04:08.28,0:04:09.70,Default,,0,0,0,,Аа, өтінемін.
Dialogue: 0,0:04:09.79,0:04:11.58,Default,,0,0,0,,(Йошимура) Коузен туралы сыбыстар кең тарала бастады—
Dialogue: 0,0:04:11.66,0:04:13.92,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:04:15.75,0:04:21.51,Default,,0,0,0,,(Джунның айқайы)
Dialogue: 0,0:04:21.59,0:04:24.88,Default,,0,0,0,,Біреу, бұйрықтың ханзадасы...
Dialogue: 0,0:04:25.39,0:04:29.60,Default,,0,0,0,,Дәл қазір келіп, Джунға көмектесіңіз.
Dialogue: 0,0:04:37.40,0:04:39.94,Default,,0,0,0,,Эй, бұл ханзада.
Dialogue: 0,0:04:41.82,0:04:45.20,Default,,0,0,0,,Неліктен ханзада емес, жұмыртқа?
Dialogue: 0,0:04:45.95,0:04:49.70,Default,,0,0,0,,Бұл ханзада. Қараңызшы, егер сіз осында жасырсаңыз ...
Dialogue: 0,0:04:50.29,0:04:50.99,Default,,0,0,0,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,0:04:54.54,0:04:55.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:57.71,0:05:00.00,Default,,0,0,0,,Джун ханзадасы мұндай тегіс емес.
Dialogue: 0,0:05:00.09,0:05:01.84,Default,,0,0,0,,Мен тіпті осырықтың иісін де сезбеймін.
Dialogue: 0,0:05:01.92,0:05:04.34,Default,,0,0,0,,Әй, не деген сұмдық ауыз.
Dialogue: 0,0:05:04.42,0:05:07.43,Default,,0,0,0,,Сіз шынымен сөйлейтінсіз.
Dialogue: 0,0:05:08.26,0:05:12.43,Default,,0,0,0,,Сөйлескенде... Жұмыртқалардың ретін осылай айтасың ба?
Dialogue: 0,0:05:14.31,0:05:17.65,Default,,0,0,0,,Сіздің болашақ өміріңіз, сөйлесу үшін
Dialogue: 0,0:05:17.73,0:05:20.61,Default,,0,0,0,,Дүрбелеңге байланысты турбуленттілік болады.
Dialogue: 0,0:05:21.32,0:05:24.40,Default,,0,0,0,,Мен тым көп сөйлеп, күдікті сауда алаңына түсіп қалдым.
Dialogue: 0,0:05:24.90,0:05:27.36,Default,,0,0,0,,Көп сөйлегендіктен, бетонмен шыңдалып қалдым.
Dialogue: 0,0:05:27.45,0:05:28.78,Default,,0,0,0,,Теңізге батып кету
Dialogue: 0,0:05:28.87,0:05:29.78,Default,,0,0,0,,Теңізде?
Dialogue: 0,0:05:29.87,0:05:31.87,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:05:31.95,0:05:36.91,Default,,0,0,0,,Ондай өмір сүргің келмесе, сөйлесуді доғар.
Dialogue: 0,0:05:37.00,0:05:37.87,Default,,0,0,0,,Пломба?
Dialogue: 0,0:05:38.37,0:05:39.79,Default,,0,0,0,,- (Жұмыртқа) Иә - (Тапсырыс) Уау!
Dialogue: 0,0:05:40.29,0:05:42.84,Default,,0,0,0,,Сөйлескенді теңізге батырып алсам
Dialogue: 0,0:05:43.88,0:05:46.47,Default,,0,0,0,,Сіз қуып жетуге тырыспайсыз.
Dialogue: 0,0:05:46.97,0:05:51.22,Default,,0,0,0,,Нағыз ханзадамен кездесіп, нағыз сарайға баруға болады.
Dialogue: 0,0:05:51.30,0:05:53.81,Default,,0,0,0,,Шынымен бе? Бірақ... бірақ
Dialogue: 0,0:05:53.89,0:05:56.64,Default,,0,0,0,,Егер мен сөйлесуді тоқтата алмасам ше?
Dialogue: 0,0:05:57.27,0:06:01.11,Default,,0,0,0,,Ханзада мен сарайдың бәрі ескі.
Dialogue: 0,0:06:01.90,0:06:02.82,Default,,0,0,0,,Ожан?
Dialogue: 0,0:06:02.90,0:06:07.15,Default,,0,0,0,,Мен нағыз қарт боламын.
Dialogue: 0,0:06:09.11,0:06:11.24,Default,,0,0,0,,Сарысы да, ақтығы да
Dialogue: 0,0:06:11.32,0:06:14.58,Default,,0,0,0,,Жұмыртқадан жасалған шиеленіс!
Dialogue: 0,0:06:14.66,0:06:16.41,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:06:19.42,0:06:20.63,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:20.71,0:06:23.00,Default,,0,0,0,,Бірақ мөрмен не істеуім керек...
Dialogue: 0,0:06:23.09,0:06:26.55,Default,,0,0,0,,Жарайды, сөйлесуіңіз жақсарады деп үміттенемін.
Dialogue: 0,0:06:26.63,0:06:28.72,Default,,0,0,0,,Ауызға найзағай кигізейік
Dialogue: 0,0:06:31.47,0:06:32.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:32.76,0:06:39.77,Default,,0,0,0,,Джи…
Dialogue: 0,0:07:21.48,0:07:22.69,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:27.44,0:07:28.69,Default,,0,0,0,,-Аа, ауырып тұр! -(Такуми) А?
Dialogue: 0,0:07:32.24,0:07:33.66,Default,,0,0,0,,Жұмыртқа?
Dialogue: 0,0:07:34.16,0:07:35.37,Default,,0,0,0,,Онии-чан Онии-чан!
Dialogue: 0,0:07:35.45,0:07:36.58,Default,,0,0,0,,Ал, ал!
Dialogue: 0,0:07:36.66,0:07:38.58,Default,,0,0,0,,? Ах... иә?
Dialogue: 0,0:07:41.04,0:07:41.71,Default,,0,0,0,,Сөздер?
Dialogue: 0,0:07:41.79,0:07:45.04,Default,,0,0,0,,А, міне... ау, рахмет.
Dialogue: 0,0:07:45.13,0:07:48.42,Default,,0,0,0,,Мұндағы құдай сөйлескенді жақсы көреді.
Dialogue: 0,0:07:49.01,0:07:52.18,Default,,0,0,0,,Осы жігіттің ішкі жан-дүниесіне неше түрлі сөздер айт.
Dialogue: 0,0:07:52.68,0:07:54.93,Default,,0,0,0,,Әртүрлі сөздермен толтырылған дейді.
Dialogue: 0,0:07:55.43,0:07:58.39,Default,,0,0,0,,Кез келген сөзді қолдануға бола ма?
Dialogue: 0,0:07:58.47,0:08:01.02,Default,,0,0,0,,Иә, мұны жақсы әйелмен істеу керек.
Dialogue: 0,0:08:01.10,0:08:03.39,Default,,0,0,0,,Сол жігітті немесе басқасын ұрыңыз.
Dialogue: 0,0:08:03.90,0:08:05.65,Default,,0,0,0,,Егер сіз оны осылай ұсынсаңыз,
Dialogue: 0,0:08:05.73,0:08:07.73,Default,,0,0,0,,Сыйлықты алмастыру
Dialogue: 0,0:08:08.23,0:08:09.82,Default,,0,0,0,,Иә
Dialogue: 0,0:08:10.53,0:08:12.24,Default,,0,0,0,,Сонда не болады?
Dialogue: 0,0:08:12.32,0:08:13.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:14.20,0:08:17.70,Default,,0,0,0,,Хмм... жақсы, қандай да бір пайда болуы керек, солай ма?
Dialogue: 0,0:08:18.53,0:08:20.20,Default,,0,0,0,,туралы
Dialogue: 0,0:08:26.46,0:08:28.04,Default,,0,0,0,,- (ұлдар) қайырлы таң - (қыздар) қайырлы таң
Dialogue: 0,0:08:28.13,0:08:29.88,Default,,0,0,0,,- (Бала) Бүгінгі тапсырманы орындадың ба? -(Әйел) Әлі жоқ
Dialogue: 0,0:08:38.01,0:08:39.89,Default,,0,0,0,,Соңында не болды?
Dialogue: 0,0:08:39.97,0:08:42.06,Default,,0,0,0,,Иә? Жақсы, әрине
Dialogue: 0,0:08:42.14,0:08:43.52,Default,,0,0,0,,Төбенің жарылуы!
Dialogue: 0,0:08:43.60,0:08:44.19,Default,,0,0,0,,Кітап…
Dialogue: 0,0:08:44.27,0:08:46.85,Default,,0,0,0,,Мына форма сүйкімді екен.
Dialogue: 0,0:08:46.94,0:08:51.61,Default,,0,0,0,,Қайсысы? О, маған түс балансы өте ұнайды.
Dialogue: 0,0:08:51.69,0:08:53.57,Default,,0,0,0,,Бұл логотип... Иә?
Dialogue: 0,0:08:54.45,0:08:55.57,Default,,0,0,0,,А, дұрыс.
Dialogue: 0,0:08:55.66,0:08:58.91,Default,,0,0,0,,Өйткені, жақсы логотип бәрін біріктіреді...
Dialogue: 0,0:09:03.62,0:09:06.33,Default,,0,0,0,,Иә, Таку-чан, сен кешігіп қалдың.
Dialogue: 0,0:09:06.42,0:09:07.58,Default,,0,0,0,,Иә, аздап.
Dialogue: 0,0:09:07.67,0:09:10.54,Default,,0,0,0,,О, керемет, Иваки де шеберлігін арттырды.
Dialogue: 0,0:09:10.63,0:09:11.50,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:09:11.59,0:09:14.26,Default,,0,0,0,,-(Айзава) Ах, Таку. -(Такуми) Иә.
Dialogue: 0,0:09:14.34,0:09:16.76,Default,,0,0,0,,Жарайды, отырыңыз.
Dialogue: 0,0:09:18.80,0:09:19.93,Default,,0,0,0,,Ал...
Dialogue: 0,0:09:20.01,0:09:24.10,Default,,0,0,0,,Аймақтық алмасу жиналысының атқару комитеті өткен күні шешім қабылдаған жоқ.
Dialogue: 0,0:09:24.60,0:09:26.44,Default,,0,0,0,,Уақыт шегі әлдеқашан бар
Dialogue: 0,0:09:27.02,0:09:28.15,Default,,0,0,0,,Мен қазір шешемін.
Dialogue: 0,0:09:28.23,0:09:29.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:29.36,0:09:32.61,Default,,0,0,0,,Біріншіден, біз неге бұлай істеп жатырмыз?
Dialogue: 0,0:09:32.69,0:09:35.53,Default,,0,0,0,,Әр сыныпта бір ғана сынып бар, солай ма?
Dialogue: 0,0:09:35.61,0:09:37.82,Default,,0,0,0,,Бірінші курста оқып жүргенімде жеңіске жетсем де...
Dialogue: 0,0:09:38.41,0:09:41.58,Default,,0,0,0,,Мәліметтерді былай қойғанда.
Dialogue: 0,0:09:41.66,0:09:43.12,Default,,0,0,0,,Мотивациясы бар адамдар!
Dialogue: 0,0:09:43.20,0:09:44.95,Default,,0,0,0,,Егер сіз болсаңыз, 5 секунд ішінде алға шығыңыз.
Dialogue: 0,0:09:45.71,0:09:50.17,Default,,0,0,0,,-(Уно) Узза~ -(Широсима) 5 4 3 2...
Dialogue: 0,0:09:50.25,0:09:55.21,Default,,0,0,0,,1 Нөл... Иә Аяғы Күтілгендей~
Dialogue: 0,0:09:55.30,0:09:58.63,Default,,0,0,0,,Сондықтан мен шешім қабылдадым
Dialogue: 0,0:10:00.22,0:10:01.39,Default,,0,0,0,,Ал...
Dialogue: 0,0:10:01.47,0:10:03.51,Default,,0,0,0,,(Тақтадағы жазу дыбысы)
Dialogue: 0,0:10:03.60,0:10:04.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:04.18,0:10:06.31,Default,,0,0,0,,Такуми Сакагами
Dialogue: 0,0:10:07.14,0:10:08.69,Default,,0,0,0,,Маусым Нарузе
Dialogue: 0,0:10:10.73,0:10:12.15,Default,,0,0,0,,Даики Тасаки
Dialogue: 0,0:10:12.23,0:10:13.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:13.36,0:10:15.40,Default,,0,0,0,,Нацуки Нито
Dialogue: 0,0:10:16.65,0:10:19.61,Default,,0,0,0,,Сонымен, танысқаныма қуаныштымын.
Dialogue: 0,0:10:20.62,0:10:21.74,Default,,0,0,0,,Нацуки Янно?
Dialogue: 0,0:10:21.82,0:10:24.66,Default,,0,0,0,,Не? Мен бұл не екенін түсінбеймін ...
Dialogue: 0,0:10:26.12,0:10:27.79,Default,,0,0,0,,-(Эда) Сондықтан -(Такуми) Сіз байыптысыз ба...
Dialogue: 0,0:10:27.87,0:10:30.25,Default,,0,0,0,,Мен келесі алмасу комитетінің мүшесі боламын...
Dialogue: 0,0:10:30.33,0:10:31.92,Default,,0,0,0,,Мен мұны істемеймін.
Dialogue: 0,0:10:32.00,0:10:32.92,Default,,0,0,0,,Әй, Дай Чан
Dialogue: 0,0:10:33.50,0:10:34.50,Default,,0,0,0,,Бұл көбірек
Dialogue: 0,0:10:34.59,0:10:37.34,Default,,0,0,0,,Бос уақыты бар болып көрінетін адамға мұны істеуге рұқсат берген дұрыс емес пе?
Dialogue: 0,0:10:37.84,0:10:39.22,Default,,0,0,0,,Жоқ, мен.
Dialogue: 0,0:10:39.30,0:10:42.93,Default,,0,0,0,,Ол өте шыншыл мұғалім, сондықтан ол мұндай артықшылық танытпайды.
Dialogue: 0,0:10:43.60,0:10:47.22,Default,,0,0,0,,Уақыт барлығына бірдей бөлінеді.
Dialogue: 0,0:10:47.73,0:10:49.39,Default,,0,0,0,,Тіпті жауын құрттары мен оцелла...
Dialogue: 0,0:10:49.48,0:10:50.77,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:10:53.40,0:10:54.52,Default,,0,0,0,,Орындаңыз
Dialogue: 0,0:10:55.15,0:10:56.69,Default,,0,0,0,,Бұл пәрмен
Dialogue: 0,0:10:57.19,0:10:58.24,Default,,0,0,0,,Ум...
Dialogue: 0,0:10:59.15,0:11:02.24,Default,,0,0,0,,Бұл бұйрық. Сен не айтып тұрсың?
Dialogue: 0,0:11:02.32,0:11:04.28,Default,,0,0,0,,
Dialogue: 0,0:11:04.37,0:11:06.95,Default,,0,0,0,,А... а...
Dialogue: 0,0:11:07.54,0:11:10.25,Default,,0,0,0,,(Экхарт) Кторигалга басып кірген бейбітшілікке қарсы күштер—
Dialogue: 0,0:11:11.33,0:11:13.00,Default,,0,0,0,,Жоқ! Сонымен...
Dialogue: 0,0:11:17.80,0:11:18.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:19.17,0:11:22.09,Default,,0,0,0,,- (бала) А, Нарузе? -(Қыз) Сөйлестің бе?
Dialogue: 0,0:11:23.18,0:11:24.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:24.43,0:11:26.97,Default,,0,0,0,,Ол жігіт сөйлей алады.
Dialogue: 0,0:11:27.56,0:11:30.64,Default,,0,0,0,,Мен... мен... мен...
Dialogue: 0,0:11:32.10,0:11:33.94,Default,,0,0,0,,Сол сөзге шебер, жалған мейірімді жігіт➡
Dialogue: 0,0:11:36.73,0:11:38.86,Default,,0,0,0,,Әй... Әй, Нарузе?
Dialogue: 0,0:11:38.94,0:11:40.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:40.99,0:11:43.82,Default,,0,0,0,,-(Барлығы) Ааааааааааааааааааааааааааа -(ұлдар) Шимачо...
Dialogue: 0,0:11:43.91,0:11:45.32,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:11:47.79,0:11:49.54,Default,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,0:11:51.50,0:11:52.92,Default,,0,0,0,,Әй, Саказаки
Dialogue: 0,0:11:53.00,0:11:54.83,Default,,0,0,0,,Саказақ тілі дегеніміз не?
Dialogue: 0,0:11:56.42,0:11:57.63,Default,,0,0,0,,Сакагами
Dialogue: 0,0:11:58.21,0:12:00.42,Default,,0,0,0,,Аа, бұл ұят.
Dialogue: 0,0:12:00.51,0:12:01.30,Default,,0,0,0,,Бұл ұят
Dialogue: 0,0:12:01.38,0:12:03.38,Default,,0,0,0,,Болды, қалғанын орындауды сұрадым.
Dialogue: 0,0:12:04.93,0:12:05.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:05.68,0:12:09.35,Default,,0,0,0,,(Спорт клубының айқайы)
Dialogue: 0,0:12:09.43,0:12:12.23,Default,,0,0,0,,- (Бала) Бұл дәл қазір керемет болды - (Бала) Хаха... солай ма?
Dialogue: 0,0:12:12.31,0:12:14.94,Default,,0,0,0,,(«Исезаки Таун Блюз»)
Dialogue: 0,0:12:15.02,0:12:16.61,Default,,0,0,0,,♪ Энн Энн
Dialogue: 0,0:12:19.73,0:12:21.28,Default,,0,0,0,,♪ Энн Энн
Dialogue: 0,0:12:23.82,0:12:25.61,Default,,0,0,0,,♪ Энн Энн
Dialogue: 0,0:12:27.58,0:12:29.37,Default,,0,0,0,,Тоқта, Айзава!
Dialogue: 0,0:12:29.45,0:12:32.04,Default,,0,0,0,,Минттің істегені осы... соншалықты дөрекі ән!
Dialogue: 0,0:12:32.12,0:12:33.41,Default,,0,0,0,,Бәрі жақсы, Буккирати
Dialogue: 0,0:12:33.91,0:12:36.71,Default,,0,0,0,,«Исезакимачи Блюз» Бұл шедевр, сіз.
Dialogue: 0,0:12:36.79,0:12:38.75,Default,,0,0,0,,Мина Аомен жекпе-жек таңдайсыз ба?
Dialogue: 0,0:12:38.84,0:12:41.01,Default,,0,0,0,,- (Иваки) Ао... Не? -(Айзава) Сәлем Таку
Dialogue: 0,0:12:41.51,0:12:43.26,Default,,0,0,0,,Ммм
Dialogue: 0,0:12:44.09,0:12:45.97,Default,,0,0,0,,Эннуи, Таку-чан
Dialogue: 0,0:12:46.05,0:12:49.51,Default,,0,0,0,,Қоғамдық жиындарды өз қалауыңызша өткізуге болады.
Dialogue: 0,0:12:50.01,0:12:50.89,Default,,0,0,0,,Тұтынушылар ше?
Dialogue: 0,0:12:50.97,0:12:53.43,Default,,0,0,0,,Мен білетін жалғыз адам – менің көршімдегі қария мен әжем.
Dialogue: 0,0:12:54.23,0:12:57.10,Default,,0,0,0,,-(Такуми) Бұл бір сөз. -(Иваки) Бұл бір сөз.
Dialogue: 0,0:12:57.19,0:13:00.19,Default,,0,0,0,,Жарайды, ол кісінің таңдауы жастық таңдау болды.
Dialogue: 0,0:13:00.27,0:13:01.57,Default,,0,0,0,,Араами таңдауы
Dialogue: 0,0:13:01.65,0:13:02.74,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:13:02.82,0:13:05.65,Default,,0,0,0,,Өз қабығына жабылған летаргиялық жас жігіт...
Dialogue: 0,0:13:05.74,0:13:06.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:06.49,0:13:08.78,Default,,0,0,0,,Армандар бұзылып, орта мектептегі бейсбол ойыншысы болды
Dialogue: 0,0:13:08.87,0:13:11.04,Default,,0,0,0,,Басынан аяғына дейін үнсіз әйел
Dialogue: 0,0:13:11.12,0:13:14.50,Default,,0,0,0,,Мен Нарусенің дауысын бүгін бірінші рет естідім.
Dialogue: 0,0:13:14.58,0:13:17.33,Default,,0,0,0,,-да ұйымдастырушы ретінде әрекет ететін құрметті студент
Dialogue: 0,0:13:17.42,0:13:20.21,Default,,0,0,0,,Шығыс, оңтүстік-батыс, солтүстік (тоннан өткір) сипаты!
Dialogue: 0,0:13:20.29,0:13:22.71,Default,,0,0,0,,Рон! Шоши Ки!
Dialogue: 0,0:13:22.80,0:13:26.51,Default,,0,0,0,,Иә? Мама... сіз байсалдысыз ба?
Dialogue: 0,0:13:26.59,0:13:29.97,Default,,0,0,0,,Мен үнемі шағымданамын.
Dialogue: 0,0:13:33.43,0:13:37.14,Default,,0,0,0,,Айтпақшы...Мен де бірінші рет естіп тұрмын.
Dialogue: 0,0:13:37.73,0:13:38.90,Default,,0,0,0,,Оның дауысы
Dialogue: 0,0:13:49.16,0:13:49.70,Default,,0,0,0,,Шасу!
Dialogue: 0,0:13:49.78,0:13:51.78,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:51.87,0:13:53.20,Default,,0,0,0,,Ша~су
Dialogue: 0,0:13:53.29,0:13:55.75,Default,,0,0,0,,Сәлем! Дауыс жоқ! Дауыс!
Dialogue: 0,0:13:55.83,0:13:57.71,Default,,0,0,0,,Ша~су!
Dialogue: 0,0:13:59.29,0:14:03.30,Default,,0,0,0,,Сен ақымақ бейбақ, басқаларды кемітпе.
Dialogue: 0,0:14:03.38,0:14:05.92,Default,,0,0,0,,Бірақ ол Нацукимен бірге атқарушы комитеттің мүшесі.
Dialogue: 0,0:14:06.01,0:14:08.13,Default,,0,0,0,,Қашықтық қысқармай ма?
Dialogue: 0,0:14:08.22,0:14:09.97,Default,,0,0,0,,Мен кішірейіп кетсем не істеуім керек?
Dialogue: 0,0:14:10.05,0:14:13.14,Default,,0,0,0,,Дұрыс, бейсбол командасының ойыншысы және черлидинг командасының басшысы.
Dialogue: 0,0:14:13.76,0:14:15.85,Default,,0,0,0,,Біз ұрпақтар бойы бірге болдық.
Dialogue: 0,0:14:16.93,0:14:19.14,Default,,0,0,0,,Қазіргі эйс - Ямаджи.
Dialogue: 0,0:14:19.23,0:14:22.77,Default,,0,0,0,,А... а... жоқ, бұл... жаман.
Dialogue: 0,0:14:22.86,0:14:25.61,Default,,0,0,0,,- (мүше) Мишима! -(Тайки) Мен сені шақырып жатырмын.
Dialogue: 0,0:14:25.69,0:14:28.36,Default,,0,0,0,,Ой... онда кеттік.
Dialogue: 0,0:14:28.45,0:14:31.03,Default,,0,0,0,,Дай-чан, кездесуге кейінірек кел.
Dialogue: 0,0:14:34.29,0:14:36.87,Default,,0,0,0,,Бұл өте өкінішті, солай емес пе?
Dialogue: 0,0:14:36.95,0:14:39.62,Default,,0,0,0,,Иә? О, бейсбол клубы
Dialogue: 0,0:14:39.71,0:14:43.71,Default,,0,0,0,,Кошиен, мен армандайтын жер еді.
Dialogue: 0,0:14:43.79,0:14:47.63,Default,,0,0,0,,Тайкидің арқасында бәрі бақытты болды.
Dialogue: 0,0:14:48.17,0:14:52.97,Default,,0,0,0,,Жазғы іріктеу турнирінің үшінші кезеңіне өтуді мақсат еткен команда...
Dialogue: 0,0:14:53.64,0:14:56.43,Default,,0,0,0,,Эйс-саманың арқасында мен үлкен күш алдым.
Dialogue: 0,0:14:56.52,0:15:00.14,Default,,0,0,0,,Мүмкін біз Кошиенге қатысуды мақсат ете аламыз.
Dialogue: 0,0:15:00.89,0:15:03.27,Default,,0,0,0,,Бұл түсінуге оңай арман болды
Dialogue: 0,0:15:03.36,0:15:06.53,Default,,0,0,0,,Оның шынтағын ауыртып алғаны соншалықты аянышты.
Dialogue: 0,0:15:06.61,0:15:09.53,Default,,0,0,0,,Олай айтпа, есеңгіреп қаласың.
Dialogue: 0,0:15:09.61,0:15:10.86,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:10.95,0:15:13.24,Default,,0,0,0,,Мен ғана емес, мен ғана аяныштымын.
Dialogue: 0,0:15:13.32,0:15:14.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:14.12,0:15:16.74,Default,,0,0,0,,Турнир үшін жаттығуымды босқа жібердім.
Dialogue: 0,0:15:16.83,0:15:18.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:20.25,0:15:22.25,Default,,0,0,0,,♪ Джа~ Джа Джа Джа Джа Джа
Dialogue: 0,0:15:22.33,0:15:24.21,Default,,0,0,0,,♪ Жа~жа~
Dialogue: 0,0:15:24.29,0:15:28.42,Default,,0,0,0,,♪ Джаджаяджа Джаджаджа~
Dialogue: 0,0:15:28.51,0:15:31.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:31.47,0:15:33.76,Default,,0,0,0,,Сіз не істеп жатырсыз? Үзіліс аяқталды.
Dialogue: 0,0:15:34.39,0:15:36.47,Default,,0,0,0,,- (Эда) Ой, кешіріңіз - (Уно) Мен қазір барамын!
Dialogue: 0,0:15:37.68,0:15:40.68,Default,,0,0,0,,
Dialogue: 0,0:15:41.44,0:15:42.90,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:15:43.48,0:15:46.11,Default,,0,0,0,,Мен бұл деп естідім.
Dialogue: 0,0:15:46.94,0:15:49.57,Default,,0,0,0,,О? Кешіріңіз... Иә?
Dialogue: 0,0:15:50.19,0:15:53.86,Default,,0,0,0,,Бұл не? Бұл тым тегін, солай емес пе?
Dialogue: 0,0:15:54.37,0:15:55.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:56.16,0:15:59.79,Default,,0,0,0,,Жұмыртқа тағы... Мен бүгін байланысым бар сияқты.
Dialogue: 0,0:16:03.04,0:16:03.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:10.30,0:16:15.51,Default,,0,0,0,,(аккордеон дыбысы)
Dialogue: 0,0:16:19.97,0:16:23.02,Default,,0,0,0,,Әй, дыбыс дұрыс шығады.
Dialogue: 0,0:16:27.06,0:16:30.19,Default,,0,0,0,,♪ Жұмыртқа~
Dialogue: 0,0:16:30.28,0:16:35.07,Default,,0,0,0,,♪ Жұмыртқа~
Dialogue: 0,0:16:37.53,0:16:43.12,Default,,0,0,0,,(аккордеон орындауы)
Dialogue: 0,0:16:46.75,0:16:50.21,Default,,0,0,0,,♪ Жұмыртқаға
Dialogue: 0,0:16:50.30,0:16:55.47,Default,,0,0,0,,♪ Ұсынайық
Dialogue: 0,0:17:01.14,0:17:05.60,Default,,0,0,0,,♪ Жұмыртқаға
Dialogue: 0,0:17:05.69,0:17:09.98,Default,,0,0,0,,♪ Ұсынайық
Dialogue: 0,0:17:10.65,0:17:13.03,Default,,0,0,0,,♪ әдемі сөздер
Dialogue: 0,0:17:13.11,0:17:18.74,Default,,0,0,0,,♪ Сөздерді ұсынайық
Dialogue: 0,0:17:20.45,0:17:22.29,Default,,0,0,0,,♪ Тама...
Dialogue: 0,0:17:22.37,0:17:23.45,Default,,0,0,0,,О
Dialogue: 0,0:17:23.54,0:17:25.00,Default,,0,0,0,,Мың тұтынушылар?
Dialogue: 0,0:17:25.08,0:17:25.66,Default,,0,0,0,,А...
Dialogue: 0,0:17:25.75,0:17:27.88,Default,,0,0,0,,Наруз Неліктен?
Dialogue: 0,0:17:28.71,0:17:30.79,Default,,0,0,0,,А... Аа!
Dialogue: 0,0:17:31.30,0:17:33.92,Default,,0,0,0,,А... Нарузе, сен кеттің бе?
Dialogue: 0,0:17:34.42,0:17:35.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:38.55,0:17:41.18,Default,,0,0,0,,О, ғажап, тікелей шағым?
Dialogue: 0,0:17:41.26,0:17:43.02,Default,,0,0,0,,Жасайық
Dialogue: 0,0:17:43.10,0:17:46.27,Default,,0,0,0,,Сөйлесе алсам, тура айтар едім.
Dialogue: 0,0:17:46.35,0:17:46.89,Default,,0,0,0,,Жақсы
Dialogue: 0,0:17:48.31,0:17:50.56,Default,,0,0,0,,Менің бизнесім де солай.
Dialogue: 0,0:17:50.65,0:17:52.11,Default,,0,0,0,,Е...
Dialogue: 0,0:17:52.73,0:17:55.78,Default,,0,0,0,,Бұл көріністермен мұны істеу мүмкін емес, солай ма?
Dialogue: 0,0:17:55.86,0:17:56.65,Default,,0,0,0,,Қалай болғанда да, Нито...
Dialogue: 0,0:17:56.74,0:18:00.70,Default,,0,0,0,,Одан кейін атқару комитетінде болуға лайықты кез келген басқа адамдарды атаңыз.
Dialogue: 0,0:18:01.45,0:18:04.33,Default,,0,0,0,,Егер сіз адамдық құрбандық шалсаңыз, мен сізді өзгертемін.
Dialogue: 0,0:18:06.91,0:18:08.96,Default,,0,0,0,,Сіз шынымен мейірімдісіз.
Dialogue: 0,0:18:09.46,0:18:11.71,Default,,0,0,0,,Бірақ сіз ақша жоғалтасыз.
Dialogue: 0,0:18:11.79,0:18:13.84,Default,,0,0,0,,Шығынға кім себепкер?
Dialogue: 0,0:18:13.92,0:18:16.22,Default,,0,0,0,,Аа, дұрыс, жақсы.
Dialogue: 0,0:18:16.30,0:18:17.97,Default,,0,0,0,,- (Такуми) Иә? -(Джошима) Мен ойнап жүрген ән
Dialogue: 0,0:18:18.05,0:18:20.43,Default,,0,0,0,,Ах! Бұл орынды емес...
Dialogue: 0,0:18:20.51,0:18:22.60,Default,,0,0,0,,«Әлем бойынша»
Dialogue: 0,0:18:23.64,0:18:26.18,Default,,0,0,0,,Ескі фильм болса да, мен оны жақсы білетінмін.
Dialogue: 0,0:18:26.27,0:18:29.02,Default,,0,0,0,,Маған мюзикл және осы сияқты нәрселер ұнайды.
Dialogue: 0,0:18:29.10,0:18:30.31,Default,,0,0,0,,Мен жақын жерде болдым...
Dialogue: 0,0:18:30.81,0:18:32.06,Default,,0,0,0,,Я~
Dialogue: 0,0:18:32.77,0:18:33.52,Default,,0,0,0,,О!
Dialogue: 0,0:18:35.03,0:18:36.94,Default,,0,0,0,,- (Широсима) Бұл жақсы болуы мүмкін. - (Такуми) А?
Dialogue: 0,0:18:37.03,0:18:38.24,Default,,0,0,0,,Музыкалық
Dialogue: 0,0:18:38.32,0:18:40.20,Default,,0,0,0,,Бұл дұрыс болды Фураи алмасу кездесуі
Dialogue: 0,0:18:40.28,0:18:42.12,Default,,0,0,0,,Неліктен бұлай?
Dialogue: 0,0:18:42.20,0:18:44.49,Default,,0,0,0,,Мен музыка пәнінің мұғалімімін.
Dialogue: 0,0:18:44.58,0:18:48.96,Default,,0,0,0,,Жыл сайын оқулар мен хорлардың көңілінен шықпайтын нәрсе болды.
Dialogue: 0,0:18:49.04,0:18:50.54,Default,,0,0,0,,Жетеді.
Dialogue: 0,0:18:50.62,0:18:53.38,Default,,0,0,0,,Ей, мен бас тартуға жаманмын...
Dialogue: 0,0:18:53.46,0:18:54.29,Default,,0,0,0,,Гвуу…
Dialogue: 0,0:18:54.92,0:19:01.34,Default,,0,0,0,,(Джунның ауыр тыныс алуы)
Dialogue: 0,0:19:07.06,0:19:08.18,Default,,0,0,0,,Көрінді
Dialogue: 0,0:19:14.44,0:19:16.23,Default,,0,0,0,,Ол менің жүрегімді көре алды
Dialogue: 0,0:19:29.25,0:19:29.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:33.33,0:19:34.38,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:19:34.88,0:19:35.96,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:19:36.04,0:19:38.42,Default,,0,0,0,,Иә, бұл көлік...
Dialogue: 0,0:19:39.09,0:19:40.05,Default,,0,0,0,,Не істеп жүрсің?
Dialogue: 0,0:19:40.13,0:19:44.43,Default,,0,0,0,,А, тежегіш жоқ. Мүмкін олар өмірінің соңына жеткен шығар.
Dialogue: 0,0:19:45.22,0:19:46.68,Default,,0,0,0,,Содан кейін менікі.
Dialogue: 0,0:19:48.02,0:19:49.93,Default,,0,0,0,,Сізге мектепке бару қиын болуы керек.
Dialogue: 0,0:19:50.02,0:19:51.64,Default,,0,0,0,,Жарайды, мен жүре аламын.
Dialogue: 0,0:19:52.39,0:19:54.06,Default,,0,0,0,,Ата, аурухана бар, солай ма?
Dialogue: 0,0:19:56.19,0:19:57.23,Default,,0,0,0,,- (Изуми) Иә - (Такуми) Мен үйдемін...
Dialogue: 0,0:19:57.32,0:20:00.94,Default,,0,0,0,,Оны жылына бір рет қарауға болады, сондықтан уайымдамаңыз.
Dialogue: 0,0:20:01.65,0:20:04.11,Default,,0,0,0,,Біз өлгеннен кейін қандай кепілдік бар?
Dialogue: 0,0:20:04.20,0:20:05.57,Default,,0,0,0,,Не болады екен деп ойлаймын
Dialogue: 0,0:20:06.07,0:20:08.87,Default,,0,0,0,,Бұл туралы да уайымдамаңыз. Мысалы, немерең...
Dialogue: 0,0:20:08.95,0:20:11.00,Default,,0,0,0,,О, Таккун, қош келдің.
Dialogue: 0,0:20:11.08,0:20:13.29,Default,,0,0,0,,Иә, сәлем.
Dialogue: 0,0:20:13.92,0:20:16.34,Default,,0,0,0,,Сәлеметсіз бе, сіз немересісіз бе?
Dialogue: 0,0:20:16.42,0:20:17.17,Default,,0,0,0,,Иә
Dialogue: 0,0:20:17.67,0:20:20.17,Default,,0,0,0,,Немерең де Агеха.
Dialogue: 0,0:20:20.26,0:20:22.88,Default,,0,0,0,,О, Нарузе мырза және мына жас ханым да?
Dialogue: 0,0:20:22.97,0:20:24.47,Default,,0,0,0,,Не? О, жақсы...
Dialogue: 0,0:20:24.55,0:20:27.43,Default,,0,0,0,,- Білмейсіз бе? Нарусе мырза - (Такуми) Нарузе?
Dialogue: 0,0:20:28.01,0:20:29.31,Default,,0,0,0,,Наруз...
Dialogue: 0,0:20:30.06,0:20:31.39,Default,,0,0,0,,ретімен...?
Dialogue: 0,0:20:31.48,0:20:33.64,Default,,0,0,0,,А... Иә, сен білесің бе?
Dialogue: 0,0:20:33.73,0:20:36.19,Default,,0,0,0,,Е, жоқ, тек аты...
Dialogue: 0,0:20:36.27,0:20:37.31,Default,,0,0,0,,И-иә… дұрыс
Dialogue: 0,0:20:37.40,0:20:40.03,Default,,0,0,0,,Аа, қазір ойлап қарасам, бұрынғы жоспар туралы.
Dialogue: 0,0:20:40.11,0:20:42.74,Default,,0,0,0,,Тағы бір бонус бар, бұл...
Dialogue: 0,0:20:42.82,0:20:43.70,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:20:43.78,0:20:45.70,Default,,0,0,0,,Осы артықшылықты қоссаңыз
Dialogue: 0,0:20:45.78,0:20:47.12,Default,,0,0,0,,Бұл кепілдік қамтылған.
Dialogue: 0,0:20:47.91,0:20:49.99,Default,,0,0,0,,Олай болса, кешіріңіз.
Dialogue: 0,0:20:50.08,0:20:53.29,Default,,0,0,0,,Әйел баласын жалғыз өзі тәрбиелеп отыр.
Dialogue: 0,0:20:53.37,0:20:54.41,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:20:54.50,0:20:55.75,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:56.46,0:20:57.54,Default,,0,0,0,,А, дәмді
Dialogue: 0,0:20:57.63,0:20:58.38,Default,,0,0,0,,Иә
Dialogue: 0,0:20:58.46,0:21:00.75,Default,,0,0,0,,Мен оны Нарусе-саннан алдым.
Dialogue: 0,0:21:00.84,0:21:01.80,Default,,0,0,0,,Шикі тауық еті
Dialogue: 0,0:21:01.88,0:21:02.97,Default,,0,0,0,,Иә
Dialogue: 0,0:21:03.05,0:21:05.18,Default,,0,0,0,,Сіз ашық-жарқын, сөйлегішсіз бе?
Dialogue: 0,0:21:05.26,0:21:09.01,Default,,0,0,0,,Мен әрқашан достарыммен ұзақ телефон қоңырауларымен сөйлесемін және менің телефон шотым керемет.
Dialogue: 0,0:21:09.10,0:21:09.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:09.68,0:21:10.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:10.81,0:21:12.18,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:12.27,0:21:15.23,Default,,0,0,0,,Сіз тіпті осындай жеке мәселелер туралы айтасыз ба?
Dialogue: 0,0:21:15.31,0:21:17.85,Default,,0,0,0,,Әй, сен өміріңді сеніп тапсыратын адамсың.
Dialogue: 0,0:21:17.94,0:21:19.19,Default,,0,0,0,,Хмм.
Dialogue: 0,0:21:19.27,0:21:21.78,Default,,0,0,0,,Әй, қария, үш деген артық.
Dialogue: 0,0:21:21.86,0:21:25.36,Default,,0,0,0,,Оның... әкесі жоқ па?
Dialogue: 0,0:21:27.03,0:21:30.99,Default,,0,0,0,,...
Dialogue: 0,0:21:31.08,0:21:34.45,Default,,0,0,0,,♪ Хмф, сағ, сағ
Dialogue: 0,0:21:35.21,0:21:37.42,Default,,0,0,0,,♪ Хэхехехехе...
Dialogue: 0,0:21:37.50,0:21:38.17,Default,,0,0,0,,Ах
Dialogue: 0,0:21:40.88,0:21:44.05,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:21:46.63,0:21:48.64,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:21:52.85,0:21:59.86,Default,,0,0,0,,(«Кемпірқосақ үстінде»)
Dialogue: 0,0:22:03.44,0:22:05.61,Default,,0,0,0,,Әркім бұл туралы кем дегенде бір рет естіген, солай ма?
Dialogue: 0,0:22:06.19,0:22:07.61,Default,,0,0,0,,«Кемпірқосақ үстінде»
Dialogue: 0,0:22:07.70,0:22:10.24,Default,,0,0,0,,«Оз сиқыршысы» музыкалық фильмі
Dialogue: 0,0:22:10.32,0:22:11.32,Default,,0,0,0,,Бұл үлкен хит саны.
Dialogue: 0,0:22:11.41,0:22:12.28,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:22:12.37,0:22:14.04,Default,,0,0,0,,Бұл сары кірпіш.
Dialogue: 0,0:22:14.12,0:22:14.87,Default,,0,0,0,,Иә
Dialogue: 0,0:22:14.95,0:22:18.33,Default,,0,0,0,,Басты кейіпкер Дороти сиқырлы елге жеткізіледі.
Dialogue: 0,0:22:18.42,0:22:22.25,Default,,0,0,0,,Ол Канзастағы үйіне қайтпақшы.
Dialogue: 0,0:22:22.34,0:22:25.01,Default,,0,0,0,,Бұл қарапайым әңгіме.
Dialogue: 0,0:22:25.88,0:22:29.89,Default,,0,0,0,,Мюзикл эмоцияларды музыкаға салу арқылы ән айту мен билеу туралы.
Dialogue: 0,0:22:30.47,0:22:31.30,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:22:31.39,0:22:33.72,Default,,0,0,0,,Қалыпты түрде білдіру өте қиын сезімдер
Dialogue: 0,0:22:33.81,0:22:35.68,Default,,0,0,0,,Ол оңай кіреді.
Dialogue: 0,0:22:35.77,0:22:39.31,Default,,0,0,0,,Олай болса, бүгін бәріміз бірге осы фильмді көрейік.
Dialogue: 0,0:22:39.39,0:22:40.90,Default,,0,0,0,,Жоқ, менің ойымша, жоқ.
Dialogue: 0,0:22:41.40,0:22:43.94,Default,,0,0,0,,Мюзикл Айзава сөздігінде тізімде жоқ.
Dialogue: 0,0:22:44.02,0:22:44.52,Default,,0,0,0,,Хаха
Dialogue: 0,0:22:44.61,0:22:47.49,Default,,0,0,0,,Менің арқам дөрекі.
Dialogue: 0,0:22:47.57,0:22:50.49,Default,,0,0,0,,Иә, мен осылай сөйлесе аламын.
Dialogue: 0,0:22:50.57,0:22:53.28,Default,,0,0,0,,Әннің кенеттен жұмбақтығы неде?
Dialogue: 0,0:22:53.37,0:22:54.41,Default,,0,0,0,,Шие… Бұл Хассаикай ма еді?
Dialogue: 0,0:22:54.49,0:22:57.70,Default,,0,0,0,,Айттым ғой, әнге келгенде, әйтеуір
Dialogue: 0,0:22:57.79,0:23:00.46,Default,,0,0,0,,Бұл эмоцияны түсінуді жеңілдетеді ме?
Dialogue: 0,0:23:00.54,0:23:01.88,Default,,0,0,0,,Қалай
Dialogue: 0,0:23:01.96,0:23:03.63,Default,,0,0,0,,Таку-чан жақсы нәрсе айтты.
Dialogue: 0,0:23:03.71,0:23:05.21,Default,,0,0,0,,Сіз қатты уландыңыз.
Dialogue: 0,0:23:05.30,0:23:07.01,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:23:07.51,0:23:10.68,Default,,0,0,0,,Мен көремін. Менің ойымша, Тасаки келмей жатыр ма?
Dialogue: 0,0:23:10.76,0:23:12.64,Default,,0,0,0,,Мен сені шақырдым, бірақ
Dialogue: 0,0:23:12.72,0:23:14.05,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:23:14.14,0:23:18.02,Default,,0,0,0,,Сіз бәрін маған қалдырамын дедіңіз, сондықтан шешімді өзіміз қабылдайық.
Dialogue: 0,0:23:18.10,0:23:19.27,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:23:19.89,0:23:23.56,Default,,0,0,0,,Бұл есте қалатын бірінші атқару комитеті болды.
Dialogue: 0,0:23:23.65,0:23:27.53,Default,,0,0,0,,Ал, сіз шешемін десеңіз де, сізде онша көп нұсқа жоқ.
Dialogue: 0,0:23:27.61,0:23:29.82,Default,,0,0,0,,Өйткені, хор мен оқу...
Dialogue: 0,0:23:29.90,0:23:32.66,Default,,0,0,0,,Жарайды, онда әдеттегідей.
Dialogue: 0,0:23:32.74,0:23:34.16,Default,,0,0,0,,Бірақ... а
Dialogue: 0,0:23:37.33,0:23:40.16,Default,,0,0,0,,Бірақ өзара әрекеттесу деген осы емес пе?
Dialogue: 0,0:23:40.75,0:23:42.37,Default,,0,0,0,,Аймақтық алмасу
Dialogue: 0,0:23:42.46,0:23:44.92,Default,,0,0,0,,Сол маңдағы қариялар ғана келеді.
Dialogue: 0,0:23:45.00,0:23:47.34,Default,,0,0,0,,Үлкендер шынымен биік жағаны ұната ма?
Dialogue: 0,0:23:47.84,0:23:50.26,Default,,0,0,0,,Ештеңені өзгертпеңіз, жай күйді сақтаңыз.
Dialogue: 0,0:23:50.34,0:23:51.17,Default,,0,0,0,,Қызықсыз ба?
Dialogue: 0,0:23:52.76,0:23:54.59,Default,,0,0,0,,дегенді қалай түсінесіз?
Dialogue: 0,0:23:55.10,0:23:55.85,Default,,0,0,0,,Мен білсем де
Dialogue: 0,0:23:55.93,0:23:58.43,Default,,0,0,0,,Күтілгендей, бүгінгі сабақ...
Dialogue: 0,0:23:58.52,0:23:59.60,Default,,0,0,0,,Сынып?
Dialogue: 0,0:24:00.10,0:24:03.35,Default,,0,0,0,,Сіз қалай ойлайсыз? Нарусе – мюзикл
Dialogue: 0,0:24:05.44,0:24:05.94,Default,,0,0,0,,Музыка…
Dialogue: 0,0:24:06.02,0:24:06.98,Default,,0,0,0,,Ха…
Dialogue: 0,0:24:10.86,0:24:12.78,Default,,0,0,0,,Не, Нарузе? Сенімен бәрі жақсы ма?
Dialogue: 0,0:24:15.53,0:24:18.16,Default,,0,0,0,,Бірақ мюзиклмен не істеуім керек...
Dialogue: 0,0:24:18.24,0:24:21.62,Default,,0,0,0,,Әй, бәрібір қарсы шығар.
Dialogue: 0,0:24:22.37,0:24:24.25,Default,,0,0,0,,Бұл қазір ойлану керек емес пе?
Dialogue: 0,0:24:24.33,0:24:26.96,Default,,0,0,0,,Дұрыс, онда ертеңгі үй...
Dialogue: 0,0:24:27.04,0:24:29.13,Default,,0,0,0,,Тасаки мырза шынымен де тітіркендіргіш.
Dialogue: 0,0:24:29.21,0:24:31.42,Default,,0,0,0,,Сіз неге сонша бастық болуға тырысасыз?
Dialogue: 0,0:24:31.92,0:24:35.30,Default,,0,0,0,,Маңызды сәтте шынтағымды сындырып алдым, жұлқы болсам да.
Dialogue: 0,0:24:35.39,0:24:38.64,Default,,0,0,0,,Сіз күнде келіп, үнемі шағымданасыз.
Dialogue: 0,0:24:38.72,0:24:41.56,Default,,0,0,0,,Ямадзи: Менен бірдеңе айтшы.
Dialogue: 0,0:24:41.64,0:24:44.19,Default,,0,0,0,,Жоқ, оны жай қалдырыңыз.
Dialogue: 0,0:24:44.27,0:24:45.10,Default,,0,0,0,,Бірақ
Dialogue: 0,0:24:45.19,0:24:47.77,Default,,0,0,0,,Сәлем! Сыртқы аймаққа баратын уақыт келді!
Dialogue: 0,0:24:47.86,0:24:48.90,Default,,0,0,0,,Уххх
Dialogue: 0,0:24:50.07,0:24:51.11,Default,,0,0,0,,Бірдеңе...
Dialogue: 0,0:24:51.19,0:24:53.78,Default,,0,0,0,,Жоқ, мұндай нәрсе.
Dialogue: 0,0:24:54.49,0:24:57.91,Default,,0,0,0,,Егер айтар сөзің болса, анық айт.
Dialogue: 0,0:24:58.70,0:25:04.04,Default,,0,0,0,,А... Менің үйірме жұмыстарым бар, мен бірінші барамын.
Dialogue: 0,0:25:04.12,0:25:05.54,Default,,0,0,0,,Неге ол маған ештеңе айтпады екен?
Dialogue: 0,0:25:07.50,0:25:10.13,Default,,0,0,0,,Мм... Мен қазір үйге бара жатырмын.
Dialogue: 0,0:25:10.21,0:25:11.00,Default,,0,0,0,,Иә
Dialogue: 0,0:25:11.88,0:25:14.72,Default,,0,0,0,,Не? Аа... сонда
Dialogue: 0,0:25:20.89,0:25:21.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:35.11,0:25:36.82,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:25:41.03,0:25:43.70,Default,,0,0,0,,Мм... Нарусе-сан
Dialogue: 0,0:25:44.41,0:25:47.37,Default,,0,0,0,,Мүмкін сіз мюзикл түсіргіңіз келе ме?
Dialogue: 0,0:25:47.46,0:25:48.88,Default,,0,0,0,,Ха…
Dialogue: 0,0:25:48.96,0:25:50.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:54.17,0:25:56.34,Default,,0,0,0,,Эх… Не?
Dialogue: 0,0:25:56.42,0:25:58.34,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:25:58.43,0:25:59.64,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:26:02.60,0:26:03.97,Default,,0,0,0,,«Менің…»
Dialogue: 0,0:26:05.02,0:26:07.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:26:07.81,0:26:09.69,Default,,0,0,0,,Ах... хмм
Dialogue: 0,0:26:09.77,0:26:13.32,Default,,0,0,0,,Ширабаккүре... Наһ... Кух...
Dialogue: 0,0:26:13.40,0:26:15.78,Default,,0,0,0,,- (Такуми) Нарузе? -(ретімен) Қарғыс атсын... аа...
Dialogue: 0,0:26:16.74,0:26:17.86,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:26:19.70,0:26:22.58,Default,,0,0,0,,Не, күте тұр... Нарузе?
Dialogue: 0,0:26:27.71,0:26:28.67,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:26:28.75,0:26:33.88,Default,,0,0,0,,Әкесінің мектептен қайтып келе жатқанда таудағы сарайдағы заңсыз қарым-қатынасы...
Dialogue: 0,0:26:34.84,0:26:39.38,Default,,0,0,0,,Сонымен... жұмыртқа? Маған сөйлеспеу керектігін айтты ...
Dialogue: 0,0:26:39.47,0:26:40.22,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:26:40.30,0:26:41.18,Default,,0,0,0,,А…?
Dialogue: 0,0:26:43.97,0:26:45.14,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:26:45.22,0:26:48.73,Default,,0,0,0,,Бұл фантастика емес...
Dialogue: 0,0:26:53.77,0:26:55.78,Default,,0,0,0,,Ол қандай құлып?
Dialogue: 0,0:26:56.36,0:26:58.28,Default,,0,0,0,,Таудың басындағы махаббат қонақ үйі?
Dialogue: 0,0:27:00.82,0:27:03.37,Default,,0,0,0,,Түсінемін, бұл таңқаларлық.
Dialogue: 0,0:27:03.87,0:27:05.83,Default,,0,0,0,,Негізінен қауіпті мағынада...
Dialogue: 0,0:27:07.04,0:27:07.95,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:27:08.04,0:27:11.46,Default,,0,0,0,,Мен сенің жүрегіңе қарағаным шынымен түсінбеушілік.
Dialogue: 0,0:27:12.54,0:27:14.46,Default,,0,0,0,,Сол кездегі жұмыртқаның да әні
Dialogue: 0,0:27:15.13,0:27:19.30,Default,,0,0,0,,Бұл жерде мен жаңа ғана қарт кісіден естіген әңгімені айттым...
Dialogue: 0,0:27:21.97,0:27:22.93,Default,,0,0,0,,Осымен
Dialogue: 0,0:27:23.01,0:27:26.72,Default,,0,0,0,,Электрондық пошта арқылы сөйлесу бекер емес пе?
Dialogue: 0,0:27:27.22,0:27:29.89,Default,,0,0,0,,-(Такуми) Және... -(Тәртіппен) Фукуцуцуу... Ууууу
Dialogue: 0,0:27:29.98,0:27:32.52,Default,,0,0,0,,Не? Құрметті...
Dialogue: 0,0:27:33.86,0:27:34.73,Default,,0,0,0,,А…?
Dialogue: 0,0:27:44.62,0:27:46.16,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:27:48.87,0:27:50.83,Default,,0,0,0,,Мұның жақсы екеніне сенімдісіз бе?
Dialogue: 0,0:27:53.46,0:27:53.96,Default,,0,0,0,,А…?
Dialogue: 0,0:27:56.04,0:27:56.80,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:27:57.38,0:28:01.59,Default,,0,0,0,,Олай болса, мен жақында барамын. Сіз де сақ болыңыз...
Dialogue: 0,0:28:02.59,0:28:03.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:09.31,0:28:10.52,Default,,0,0,0,,А…?
Dialogue: 0,0:28:14.81,0:28:15.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:19.73,0:28:20.94,Default,,0,0,0,,Бұл...
Dialogue: 0,0:28:25.07,0:28:27.37,Default,,0,0,0,,«Жақсы» дегеніміз…
Dialogue: 0,0:28:28.58,0:28:31.58,Default,,0,0,0,,Ал, әндер...дәлірек айтсақ, музыка.
Dialogue: 0,0:28:32.16,0:28:35.38,Default,,0,0,0,,Менің ойымша, бұл бастапқыда бір нәрсені жеткізу үшін арналған.
Dialogue: 0,0:28:35.88,0:28:38.75,Default,,0,0,0,,Моза Нарусе Айтар сөзің болса
Dialogue: 0,0:28:39.34,0:28:40.92,Default,,0,0,0,,Мүмкін сіз ән айтып көре аласыз ба?
Dialogue: 0,0:28:42.30,0:28:45.97,Default,,0,0,0,,Бұл ән болса, қарғысқа қатысы жоқ болуы мүмкін.
Dialogue: 0,0:28:46.05,0:28:46.55,Default,,0,0,0,,Цукуёми-кун мен Каэрубүки-санға қандай сынақтар қойылған?
Dialogue: 0,0:28:50.85,0:28:52.73,Default,,0,0,0,,Иә? Эй
Dialogue: 0,0:28:54.27,0:28:55.10,Default,,0,0,0,,Не?
Dialogue: 0,0:28:55.19,0:28:56.06,Default,,0,0,0,,А…?
Dialogue: 0,0:28:59.27,0:29:00.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:29:32.31,0:29:35.48,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:29:37.52,0:29:40.82,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:29:42.53,0:29:44.78,Default,,0,0,0,,О, Нарусе мырза?
Dialogue: 0,0:29:44.86,0:29:47.36,Default,,0,0,0,,Иә, шам жанып тұр.
Dialogue: 0,0:29:47.45,0:29:49.87,Default,,0,0,0,,Ах, бірақ мына жерге қараңыз...
Dialogue: 0,0:29:53.62,0:29:56.37,Default,,0,0,0,,Моза Нарусе Айтар сөзің болса
Dialogue: 0,0:30:00.71,0:30:04.09,Default,,0,0,0,,♪ Жұмыртқаға
Dialogue: 0,0:30:04.17,0:30:08.05,Default,,0,0,0,,♪ Ұсынайық
Dialogue: 0,0:30:15.02,0:30:18.69,Default,,0,0,0,,♪ Жұмыртқаға
Dialogue: 0,0:30:19.19,0:30:22.48,Default,,0,0,0,,♪ Ұсынайық
Dialogue: 0,0:30:24.23,0:30:25.99,Default,,0,0,0,,♪ әдемі сөздер
Dialogue: 0,0:30:26.49,0:30:32.66,Default,,0,0,0,,♪ Сөздерді ұсынайық
Dialogue: 0,0:30:33.24,0:30:39.33,Default,,0,0,0,,♪ Менің ішім ауырмайды!
Dialogue: 0,0:30:39.92,0:30:41.04,Default,,0,0,0,,(Жарылған дыбыс)
Dialogue: 0,0:30:47.38,0:30:49.63,Default,,0,0,0,,Таңертеңгілік жаттығу қаншалықты ерікті болса да,
Dialogue: 0,0:30:50.59,0:30:53.97,Default,,0,0,0,,Осыншама адамды ғана жинай аламын деп қандай әзіл айтасыз?
Dialogue: 0,0:30:55.01,0:30:57.39,Default,,0,0,0,,- (Мишима) Нашар Дай-чан - (Тайки) Иә?
Dialogue: 0,0:30:57.48,0:31:00.23,Default,,0,0,0,,Маған сенуге болмайды ғой...
Dialogue: 0,0:31:00.31,0:31:01.81,Default,,0,0,0,,Бұлай сөйлеме.
Dialogue: 0,0:31:01.90,0:31:02.52,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:31:02.61,0:31:03.82,Default,,0,0,0,,Сен!
Dialogue: 0,0:31:05.15,0:31:07.61,Default,,0,0,0,,Ол капитан ретінде жақсы жұмыс істейді.
Dialogue: 0,0:31:09.20,0:31:09.95,Default,,0,0,0,,Дай-чан…
Dialogue: 0,0:31:14.24,0:31:16.83,Default,,0,0,0,,Енді кандидат ретінде.
Dialogue: 0,0:31:16.91,0:31:21.46,Default,,0,0,0,,Айтылым Шығармашылық би Халық әндері мен билері
Dialogue: 0,0:31:21.96,0:31:24.25,Default,,0,0,0,,Хор А капелла хоры
Dialogue: 0,0:31:24.84,0:31:26.46,Default,,0,0,0,,Драма Ағылшын драмасы
Dialogue: 0,0:31:27.34,0:31:29.72,Default,,0,0,0,,Сондай-ақ, осы уақытқа арналған түпнұсқа ретінде...
Dialogue: 0,0:31:30.47,0:31:31.55,Default,,0,0,0,,Музыкалық
Dialogue: 0,0:31:32.59,0:31:34.97,Default,,0,0,0,,Мен жоғарыда айтылғандар туралы ойладым
Dialogue: 0,0:31:35.47,0:31:36.76,Default,,0,0,0,,Әзірге осыдан...
Dialogue: 0,0:31:36.85,0:31:39.89,Default,,0,0,0,,- (Әйел) Иә? Осы жерден? -(Бала) Бұл қиын.
Dialogue: 0,0:31:39.98,0:31:42.73,Default,,0,0,0,,Сіз кеше мюзиклді көрген сияқтысыз ба?
Dialogue: 0,0:31:42.81,0:31:44.06,Default,,0,0,0,,Кедергілер тым жоғары.
Dialogue: 0,0:31:44.15,0:31:47.03,Default,,0,0,0,,Бәрі жақсы, бірақ мен қарапайым нәрсені ұнатамын.
Dialogue: 0,0:31:47.11,0:31:47.86,Default,,0,0,0,,Әрине
Dialogue: 0,0:31:47.94,0:31:48.78,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:31:49.36,0:31:52.49,Default,,0,0,0,,Менің ойымша, бұл идея жаман емес.
Dialogue: 0,0:31:52.57,0:31:55.37,Default,,0,0,0,,Жаңа нәрселерді байқап көру өте жақсы.
Dialogue: 0,0:31:57.41,0:31:59.83,Default,,0,0,0,,Бұлай айтудың еш айыбы жоқ...
Dialogue: 0,0:31:59.91,0:32:01.37,Default,,0,0,0,,Сен ақымақ емессің бе?
Dialogue: 0,0:32:01.46,0:32:05.00,Default,,0,0,0,,Қиындық қандай? Менің ойымша, бұл мүмкін емес.
Dialogue: 0,0:32:05.63,0:32:06.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:06.54,0:32:08.55,Default,,0,0,0,,Мен бастамас бұрын бірдеңе мүмкін емес болып көрінеді...
Dialogue: 0,0:32:08.63,0:32:12.05,Default,,0,0,0,,Бұл мүмкін емес. Ол әйелмен не істеуім керек?
Dialogue: 0,0:32:12.55,0:32:14.93,Default,,0,0,0,,Атқару комитетінде сөйлемейтін әйел бар.
Dialogue: 0,0:32:15.01,0:32:18.47,Default,,0,0,0,,Сондықтан әндер мен мюзиклдер тым жұмбақ.
Dialogue: 0,0:32:18.56,0:32:19.22,Default,,0,0,0,,Эй?
Dialogue: 0,0:32:19.31,0:32:22.23,Default,,0,0,0,,Не? Иә...
Dialogue: 0,0:32:22.73,0:32:25.69,Default,,0,0,0,,Сәлем Тасаки! Сіз немен айналысасыз?
Dialogue: 0,0:32:25.77,0:32:28.07,Default,,0,0,0,,А? Бұл рас, солай емес пе?
Dialogue: 0,0:32:28.15,0:32:31.11,Default,,0,0,0,,Эй, Шимачо, мына пайдасыз жігітті алып таста.
Dialogue: 0,0:32:31.19,0:32:33.36,Default,,0,0,0,,Моккай комитетінің мүшелерін қайта сайлаған дұрыс емес пе?
Dialogue: 0,0:32:33.45,0:32:34.95,Default,,0,0,0,,Тасаки Уайымдама...
Dialogue: 0,0:32:35.03,0:32:36.91,Default,,0,0,0,,Қайсысын қолдануға болмайды?
Dialogue: 0,0:32:37.58,0:32:38.20,Default,,0,0,0,,Әй?
Dialogue: 0,0:32:38.79,0:32:41.62,Default,,0,0,0,,Сіз барлық жерде бірдейсіз.
Dialogue: 0,0:32:41.70,0:32:42.29,Default,,0,0,0,,Сакагами мырза...
Dialogue: 0,0:32:42.37,0:32:44.87,Default,,0,0,0,,Менің де сендерге жаным ашиды.
Dialogue: 0,0:32:44.96,0:32:46.79,Default,,0,0,0,,ше? Сіз не айттыңыз?
Dialogue: 0,0:32:46.88,0:32:48.75,Default,,0,0,0,,Кіші балалар, сендер шағымдандыңдар.
Dialogue: 0,0:32:49.38,0:32:51.05,Default,,0,0,0,,Пайдасы жоқ сұмдық болса да
Dialogue: 0,0:32:51.63,0:32:54.88,Default,,0,0,0,,Сіз күн сайын іске бастық болып келесіз, бұл нағыз ыңғайсыздық!
Dialogue: 0,0:32:54.97,0:32:55.84,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:32:56.34,0:32:57.68,Default,,0,0,0,,Сәлем Сакагами
Dialogue: 0,0:32:58.35,0:33:01.43,Default,,0,0,0,,Әй, сен не айтып тұрсың?
Dialogue: 0,0:33:01.93,0:33:02.81,Default,,0,0,0,,Иккун?
Dialogue: 0,0:33:04.19,0:33:05.85,Default,,0,0,0,,Мен ештеңе білмесем де
Dialogue: 0,0:33:05.94,0:33:08.48,Default,,0,0,0,,Өзімшіл нәрсе жасаңыз.
Dialogue: 0,0:33:08.56,0:33:10.36,Default,,0,0,0,,Дай Чан туралы не білдің?
Dialogue: 0,0:33:10.44,0:33:11.61,Default,,0,0,0,,- (Широсима) Эй Мишима... - (Мишима) Әй?
Dialogue: 0,0:33:11.69,0:33:12.82,Default,,0,0,0,,Бұл ауырады…
Dialogue: 0,0:33:12.90,0:33:15.03,Default,,0,0,0,,Сәлем! Тоқтат, бұл не?
Dialogue: 0,0:33:15.11,0:33:16.53,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:33:16.61,0:33:18.78,Default,,0,0,0,,- (Широсима) Бұл мүмкін емес... - (Мишима) Эй, Сакагами!
Dialogue: 0,0:33:18.87,0:33:21.20,Default,,0,0,0,,Тоқта! Эй!
Dialogue: 0,0:33:21.70,0:33:25.25,Default,,0,0,0,,♪ I
Dialogue: 0,0:33:25.33,0:33:30.00,Default,,0,0,0,,♪ Сіз мұны істей аласыз.
Dialogue: 0,0:33:31.59,0:33:35.38,Default,,0,0,0,,♪ Мен уайымдап тұрмын
Dialogue: 0,0:33:35.47,0:33:41.93,Default,,0,0,0,,♪ Сенің қолыңнан келетініне сенімдімін...
Dialogue: 0,0:33:49.56,0:33:51.11,Default,,0,0,0,,Mr. Naruse? аздап!
Dialogue: 0,0:33:51.69,0:33:53.11,Default,,0,0,0,,Naruse-Сан!
Dialogue: 0,0:33:54.65,0:33:57.20,Default,,0,0,0,,Не? Бұл не? Керемет
Dialogue: 0,0:33:57.28,0:33:58.57,Default,,0,0,0,,Қандай оқиға? Бұл мюзикл ба?
Dialogue: 0,0:34:00.12,0:34:01.08,Default,,0,0,0,,Мишима
Dialogue: 0,0:34:01.58,0:34:05.54,Default,,0,0,0,,А... жаман мен сәл ашуланып қалдым.
Dialogue: 0,0:34:06.04,0:34:09.71,Default,,0,0,0,,А... жоқ, мен де көп айттым.
Dialogue: 0,0:34:15.21,0:34:16.38,Default,,0,0,0,,Нарузе мырза
Dialogue: 0,0:34:16.47,0:34:19.05,Default,,0,0,0,,Эй, бәрі дұрыс екеніне сенімдісің бе? Ақыр соңында мұғалімді шақырыңыз...
Dialogue: 0,0:34:19.14,0:34:22.39,Default,,0,0,0,,Нито? Мм... сондасың ба?
Dialogue: 0,0:34:22.47,0:34:24.81,Default,,0,0,0,,Нарусе де сенімен бірге ме? Құрметті...
Dialogue: 0,0:34:24.89,0:34:27.77,Default,,0,0,0,,- (Нацуки) Сакагами-кун - (Такуми) Ой, Нарузе ше?
Dialogue: 0,0:34:27.85,0:34:29.90,Default,,0,0,0,,Орта Мен өзімді жеке бөлмеге қамап қойдым...
Dialogue: 0,0:34:29.98,0:34:31.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:32.48,0:34:34.90,Default,,0,0,0,,Не, бұл Нарузе мырза ма?
Dialogue: 0,0:34:34.98,0:34:36.90,Default,,0,0,0,,Кеше ғана.
Dialogue: 0,0:34:36.99,0:34:37.90,Default,,0,0,0,,А…?
Dialogue: 0,0:34:45.24,0:34:48.75,Default,,0,0,0,,(Бұйрықты жылау)
Dialogue: 0,0:34:49.50,0:34:50.50,Default,,0,0,0,,А…?
Dialogue: 0,0:35:02.47,0:35:04.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:13.11,0:35:14.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:17.86,0:35:20.74,Default,,0,0,0,,Иә, бұл кеше болды.
Dialogue: 0,0:35:21.24,0:35:22.20,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:35:22.28,0:35:23.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:23.45,0:35:27.08,Default,,0,0,0,,Бірақ одан кейін сабаққа келгеніңізге қуаныштымын.
Dialogue: 0,0:35:27.16,0:35:29.08,Default,,0,0,0,,Сыныптағы атмосфера біртүрлі болды.
Dialogue: 0,0:35:29.79,0:35:30.96,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:35:31.79,0:35:34.13,Default,,0,0,0,,Олай болса мен клуб бөлмесінде тамақтанамын.
Dialogue: 0,0:35:34.21,0:35:35.17,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,0:35:37.96,0:35:40.30,Default,,0,0,0,,Даусыңыз әдемі еді, Нарусе-сан.
Dialogue: 0,0:35:41.09,0:35:43.89,Default,,0,0,0,,Әйтеуір, сенің сезіміңді түсінбеймін.
Dialogue: 0,0:35:43.97,0:35:45.22,Default,,0,0,0,,Оның
Dialogue: 0,0:35:45.30,0:35:46.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:46.68,0:35:49.06,Default,,0,0,0,,Айтқым келген, бірақ айта алмайтын нәрселер бар.
Dialogue: 0,0:35:49.14,0:35:50.18,Default,,0,0,0,,Өйткені, бар.
Dialogue: 0,0:35:53.56,0:35:54.40,Default,,0,0,0,,Иә
Dialogue: 0,0:35:57.61,0:36:03.61,Default,,0,0,0,,♪ Мен мұны істей аламын
Dialogue: 0,0:36:03.70,0:36:07.49,Default,,0,0,0,,Мен Нарузенің бүгін ән айтқанының шағын нұсқасын жасадым.
Dialogue: 0,0:36:07.58,0:36:08.24,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:36:08.33,0:36:11.04,Default,,0,0,0,,Мен Нарузе мырзаны естігенде, үйге соқты.
Dialogue: 0,0:36:11.12,0:36:13.37,Default,,0,0,0,,Иә, бұл DTM және мюзикл сияқты.
Dialogue: 0,0:36:13.46,0:36:14.21,Default,,0,0,0,,Міне
Dialogue: 0,0:36:14.92,0:36:18.00,Default,,0,0,0,,Манга жолдарына ән салу қызық болар еді.
Dialogue: 0,0:36:18.09,0:36:20.05,Default,,0,0,0,,Әй, тамаша! Hunter ойынын ойнайық! Аңшы!
Dialogue: 0,0:36:20.13,0:36:22.63,Default,,0,0,0,,- (Иваки) Е, ақсақ екен ғой, солай емес пе? -(Айзава) Олай істеме.
Dialogue: 0,0:36:26.51,0:36:27.81,Default,,0,0,0,,Дай-чан!
Dialogue: 0,0:36:28.72,0:36:29.27,Default,,0,0,0,,О
Dialogue: 0,0:36:30.56,0:36:33.64,Default,,0,0,0,,Дай-чан, бүгінгі үйірме жұмыстары...
Dialogue: 0,0:36:33.73,0:36:36.48,Default,,0,0,0,,Кешіріңіз, менің бір ісім бар.
Dialogue: 0,0:36:36.56,0:36:39.32,Default,,0,0,0,,Сакагамидің айтқанына мән бермесеңіз...
Dialogue: 0,0:36:39.40,0:36:40.57,Default,,0,0,0,,(Коджоу) Иджичи мырза, маған бір сұрақ бар: «Терезе» деген нақты не?
Dialogue: 0,0:36:41.24,0:36:44.53,Default,,0,0,0,,Менің шынымен де шаруам бар, дедім директорға.
Dialogue: 0,0:36:45.20,0:36:47.53,Default,,0,0,0,,Сонымен... мен түсінемін. Содан кейін…
Dialogue: 0,0:36:47.62,0:36:49.33,Default,,0,0,0,,...
Dialogue: 0,0:36:50.08,0:36:52.66,Default,,0,0,0,,Бүгіннен кейін мен де сені дүкенде күтемін!
Dialogue: 0,0:36:52.75,0:36:55.08,Default,,0,0,0,,- (Эда) Йоко Тез кеттік - (Мишима) Жүр!
Dialogue: 0,0:36:55.17,0:36:56.71,Default,,0,0,0,,Енді күйіп қалмаңыз
Dialogue: 0,0:36:57.29,0:36:58.17,Default,,0,0,0,,Кім?
Dialogue: 0,0:36:58.84,0:37:00.76,Default,,0,0,0,,- (Тайки) Сонда... - (Мишима) Бүгінгі Сакагами
Dialogue: 0,0:37:00.84,0:37:04.34,Default,,0,0,0,,Мүмкін ол Нацукиге жақсы нәрсе көрсеткісі келген шығар?
Dialogue: 0,0:37:04.43,0:37:05.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:05.26,0:37:08.01,Default,,0,0,0,,Жоқ, мен сол екеуімен бір лигадамын.
Dialogue: 0,0:37:08.10,0:37:09.97,Default,,0,0,0,,Мен орта мектепте оқып жүрген кезімде...
Dialogue: 0,0:37:10.56,0:37:11.81,Default,,0,0,0,,-(Бала) Уау~ Қарным ашты -(Бала) Дүкенге тоқталайық.
Dialogue: 0,0:37:11.89,0:37:13.23,Default,,0,0,0,,Мисо картоп Мисо картопын жейміз
Dialogue: 0,0:37:13.31,0:37:17.10,Default,,0,0,0,,Хахахаха... О, жоқ, ол қазірдің өзінде келді!
Dialogue: 0,0:37:25.40,0:37:26.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:39.42,0:37:40.50,Default,,0,0,0,,Сен неге атқа мінбейсің?
Dialogue: 0,0:37:42.59,0:37:45.63,Default,,0,0,0,,Сен онда не істеп жүрсің? Осындай жерде...
Dialogue: 0,0:37:45.72,0:37:46.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:47.84,0:37:50.76,Default,,0,0,0,,Үйге ерте келсең, мама таң қалады.
Dialogue: 0,0:37:50.85,0:37:51.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:52.89,0:37:56.44,Default,,0,0,0,,Сағат бейсбол ойнауды тоқтатқан сияқты.
Dialogue: 0,0:37:57.48,0:37:58.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:59.31,0:38:01.57,Default,,0,0,0,,Әй, бос уақытың болса, араласайық.
Dialogue: 0,0:38:02.53,0:38:04.69,Default,,0,0,0,,Менімен бірге таудағы қамалға барғың келе ме?
Dialogue: 0,0:38:04.78,0:38:06.28,Default,,0,0,0,,Құлып? Бірақ...
Dialogue: 0,0:38:06.36,0:38:09.82,Default,,0,0,0,,Бұл... бұл ғашықтық қонақүй емес, ол жаққа баруға жол жоқ.
Dialogue: 0,0:38:09.91,0:38:11.78,Default,,0,0,0,,Айтайын дегенім, ол жер былтыр банкрот болды...
Dialogue: 0,0:38:11.87,0:38:12.66,Default,,0,0,0,,Мен сізді жақсы білемін.
Dialogue: 0,0:38:12.74,0:38:13.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:38:13.33,0:38:15.29,Default,,0,0,0,,Жарайды... бәрі осылай деді...
Dialogue: 0,0:38:15.37,0:38:18.00,Default,,0,0,0,,Менімен бірге шығыңыз
Dialogue: 0,0:38:18.08,0:38:19.42,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:38:25.97,0:38:27.22,Default,,0,0,0,,Жоқ
Dialogue: 0,0:38:27.30,0:38:29.01,Default,,0,0,0,,Мен біреумен кездесіп жүрмін
Dialogue: 0,0:38:29.09,0:38:30.22,Default,,0,0,0,,Білемін, бірақ шынымен сабырымды сақтай аламын ба?
Dialogue: 0,0:38:33.51,0:38:34.68,Default,,0,0,0,,Құпия
Dialogue: 0,0:38:37.10,0:38:39.81,Default,,0,0,0,,Сакагамимен қашан кездесіп жүрсің?
Dialogue: 0,0:38:41.69,0:38:44.78,Default,,0,0,0,,Сен онымен бірге сарайға бардың ба?
Dialogue: 0,0:38:46.99,0:38:49.16,Default,,0,0,0,,- (Нацуки) Біз ешқашан қол ұстасып көрмеппіз - (Тайки) Иә?
Dialogue: 0,0:38:49.24,0:38:50.24,Default,,0,0,0,,Дәлірек айтқанда...
Dialogue: 0,0:38:52.91,0:38:54.79,Default,,0,0,0,,Мен сіздің электрондық пошта мекенжайыңызды да білмеймін.
Dialogue: 0,0:38:54.87,0:38:57.41,Default,,0,0,0,,Сонымен біз кездесіп жүрдік деп айта аласыз ба?
Dialogue: 0,0:38:57.50,0:38:59.96,Default,,0,0,0,,-(Нацуки) Бұл да жеткілікті. -(Тайки) Қайда бара жатырсың?
Dialogue: 0,0:39:00.04,0:39:03.71,Default,,0,0,0,,Автобус Келесі пойызға дейін 30 минуттан астам уақыт қалды.
Dialogue: 0,0:39:07.30,0:39:11.51,Default,,0,0,0,,Егер сіз уақытты өлтіргіңіз келсе, маған сөйлесуге көмектесіңіз.
Dialogue: 0,0:39:11.59,0:39:12.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:12.22,0:39:16.85,Default,,0,0,0,,Дайындық көп жұмыс істейтін сияқты, сондықтан мен көп уақытты өлтіре аламын деп ойлаймын.
Dialogue: 0,0:39:18.81,0:39:19.81,Default,,0,0,0,,Аа...
Dialogue: 0,0:39:22.48,0:39:23.36,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:39:27.99,0:39:30.36,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:39:30.86,0:39:32.62,Default,,0,0,0,,О, Нарусе мырза тағы да?
Dialogue: 0,0:39:32.70,0:39:37.20,Default,,0,0,0,,Иә, не істеуім керек? Келесі жолы аудан басшысына айтамын...
Dialogue: 0,0:39:38.79,0:39:40.04,Default,,0,0,0,,О...
Dialogue: 0,0:39:41.62,0:39:42.71,Default,,0,0,0,,Иә, әрине
Dialogue: 0,0:39:42.79,0:39:45.63,Default,,0,0,0,,Мен осы айдағы көршілестік жарнасын алдым.
Dialogue: 0,0:39:46.13,0:39:48.30,Default,,0,0,0,,Анашым, сіз әрқашан кешігіп келесіз.
Dialogue: 0,0:39:48.38,0:39:51.88,Default,,0,0,0,,Сақтандыру дәл қазір қиын, солай емес пе? Аз адам кіреді
Dialogue: 0,0:39:51.97,0:39:54.68,Default,,0,0,0,,Аа, дұрыс, Джун Чан, мектеп қалай өтіп жатыр?
Dialogue: 0,0:39:54.76,0:39:57.43,Default,,0,0,0,,Менің балам келесі жылы емтихан тапсырады.
Dialogue: 0,0:39:57.52,0:39:59.89,Default,,0,0,0,,Маған қызық, Джун Чан мен мына мектеп не болып жатыр...
Dialogue: 0,0:40:00.68,0:40:01.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:02.14,0:40:03.44,Default,,0,0,0,,Қайырлы кеш, мм...
Dialogue: 0,0:40:03.52,0:40:06.94,Default,,0,0,0,,Қош келдіңіз. Көршілер қауымдастығының жарналары...
Dialogue: 0,0:40:07.02,0:40:10.15,Default,,0,0,0,,Аа, кешіріңіз, мен соңғы кездері бос емеспін...
Dialogue: 0,0:40:10.24,0:40:12.20,Default,,0,0,0,,А, мен оны алдым.
Dialogue: 0,0:40:12.28,0:40:14.20,Default,,0,0,0,,- (Изуми) Иә? -(Үй шаруасы) Джун Чан кездескенше
Dialogue: 0,0:40:15.12,0:40:16.95,Default,,0,0,0,,Олай болса, кешіріңіз.
Dialogue: 0,0:40:17.03,0:40:19.66,Default,,0,0,0,,А... иә, еңбегіңіз үшін рахмет.
Dialogue: 0,0:40:21.87,0:40:24.33,Default,,0,0,0,,Анаң жоқ болса шықпа.
Dialogue: 0,0:40:24.42,0:40:25.92,Default,,0,0,0,,Орынсыз
Dialogue: 0,0:40:26.42,0:40:28.13,Default,,0,0,0,,«Сөйлемейтін бала»
Dialogue: 0,0:40:28.71,0:40:31.67,Default,,0,0,0,,Көп жерде өсек тарады...
Dialogue: 0,0:40:32.17,0:40:33.51,Default,,0,0,0,,А, көлік...
Dialogue: 0,0:40:35.64,0:40:37.72,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:40:40.68,0:40:42.64,Default,,0,0,0,,Хаа... қазірдің өзінде
Dialogue: 0,0:40:43.14,0:40:47.57,Default,,0,0,0,,(Джунның ауыр тыныс алуы)
Dialogue: 0,0:40:59.83,0:41:03.04,Default,,0,0,0,,Ым, шам йогурты...
Dialogue: 0,0:41:04.46,0:41:05.08,Default,,0,0,0,,Жарайды
Dialogue: 0,0:41:10.50,0:41:11.46,Default,,0,0,0,,«Егер бұл ән болса»…
Dialogue: 0,0:41:12.21,0:41:13.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:15.05,0:41:15.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:15.63,0:41:18.01,Default,,0,0,0,,Неліктен бұл ұзақ...
Dialogue: 0,0:41:18.10,0:41:19.01,Default,,0,0,0,,А…?
Dialogue: 0,0:41:19.10,0:41:21.31,Default,,0,0,0,,қайтадан? Ал...
Dialogue: 0,0:41:22.39,0:41:23.23,Default,,0,0,0,,Хе-хе-хе-хе. Міне, 1-курстың үшеуіміз ақыры бірге жиналдық
Dialogue: 0,0:41:23.31,0:41:25.31,Default,,0,0,0,,Сәл күте тұрыңыз...
Dialogue: 0,0:41:25.39,0:41:26.19,Default,,0,0,0,,А…?
Dialogue: 0,0:41:26.27,0:41:27.81,Default,,0,0,0,,Әй, бұл не?
Dialogue: 0,0:41:27.90,0:41:28.52,Default,,0,0,0,,Ах
Dialogue: 0,0:41:30.07,0:41:30.73,Default,,0,0,0,,А…?
Dialogue: 0,0:41:33.19,0:41:34.15,Default,,0,0,0,,Сөздер...
Dialogue: 0,0:41:35.40,0:41:36.53,Default,,0,0,0,,Өлеңде?
Dialogue: 0,0:41:39.58,0:41:41.79,Default,,0,0,0,,(Автобус аялдамасының дыбысы)
Dialogue: 0,0:41:42.29,0:41:44.04,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:41:44.12,0:41:45.08,Default,,0,0,0,,Бұл!
Dialogue: 0,0:41:48.50,0:41:52.21,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:41:52.30,0:41:53.17,Default,,0,0,0,,Ум...
Dialogue: 0,0:41:53.67,0:41:56.47,Default,,0,0,0,,Жұмыртқа әніндей болғанын қалаймын.
Dialogue: 0,0:41:57.13,0:41:57.84,Default,,0,0,0,,Наруз?
Dialogue: 0,0:41:57.93,0:42:00.14,Default,,0,0,0,,Менің сезімдерім...
Dialogue: 0,0:42:00.22,0:42:02.56,Default,,0,0,0,,Мен шынымен не туралы айтқым келеді!
Dialogue: 0,0:42:03.43,0:42:04.98,Default,,0,0,0,,Керемет...
Dialogue: 0,0:42:05.73,0:42:08.69,Default,,0,0,0,,Ух... әнге...
Dialogue: 0,0:42:09.19,0:42:09.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:42:10.02,0:42:13.28,Default,,0,0,0,,Не? О... эй!
Dialogue: 0,0:42:13.36,0:42:14.32,Default,,0,0,0,,Наруз!
Dialogue: 0,0:42:15.53,0:42:18.53,Default,,0,0,0,,Иә? Эй, Такуми ше?
Dialogue: 0,0:42:18.61,0:42:21.70,Default,,0,0,0,,Сауда Мен шам сатып алуға бардым.
Dialogue: 0,0:42:21.78,0:42:23.49,Default,,0,0,0,,Дәретхана таусылды.
Dialogue: 0,0:42:23.58,0:42:25.04,Default,,0,0,0,,Осындай уақытта...
Dialogue: 0,0:42:25.12,0:42:27.75,Default,,0,0,0,,Сен, Такумиден бәрін сұрауды доғар.
Dialogue: 0,0:42:27.83,0:42:29.79,Default,,0,0,0,,Себебі мен жібере алмаймын...
Dialogue: 0,0:42:29.88,0:42:31.71,Default,,0,0,0,,Қараңызшы, бұл осылай.
Dialogue: 0,0:42:31.79,0:42:33.21,Default,,0,0,0,,Басатын жерде абай болыңыз.
Dialogue: 0,0:42:33.71,0:42:34.67,Default,,0,0,0,,- (88) Такуми? -(Такуми) Ах.
Dialogue: 0,0:42:34.76,0:42:37.13,Default,,0,0,0,,Ха... уф...
Dialogue: 0,0:42:37.22,0:42:40.22,Default,,0,0,0,,Сәлемдесу дұрыс, ендеше алға!
Dialogue: 0,0:42:40.30,0:42:41.01,Default,,0,0,0,,Сіз доссыз ба?
Dialogue: 0,0:42:41.10,0:42:44.85,Default,,0,0,0,,Не? А, иә... Менің ойымша?
Dialogue: 0,0:42:44.93,0:42:46.35,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:42:46.43,0:42:49.73,Default,,0,0,0,,Эй, шам! дәретхана! А... сәл күте тұрыңыз!
Dialogue: 0,0:42:49.81,0:42:50.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:53.11,0:42:55.36,Default,,0,0,0,,«Арманшыл қыз»
Dialogue: 0,0:42:55.44,0:42:59.11,Default,,0,0,0,,«Мен сарайда әр түнде өткізілетін допқа таң қаламын».
Dialogue: 0,0:42:59.61,0:43:02.07,Default,,0,0,0,,«Бірақ доп»
Dialogue: 0,0:43:02.57,0:43:03.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:43:06.20,0:43:08.25,Default,,0,0,0,,«Бірақ доп»
Dialogue: 0,0:43:08.96,0:43:11.71,Default,,0,0,0,,«Шын мәнінде, бұл қылмыскерлер үшін жазалау алаңы болды».
Dialogue: 0,0:43:12.21,0:43:16.38,Default,,0,0,0,,«Олар күнәларын өтеу үшін мәңгілікке өледі».
Dialogue: 0,0:43:16.46,0:43:18.59,Default,,0,0,0,,«Мен билей беруім керек⸺»
Dialogue: 0,0:43:19.17,0:43:21.09,Default,,0,0,0,,«Бұл қарғысқа ұшырады».
Dialogue: 0,0:43:23.26,0:43:25.35,Default,,0,0,0,,«Шындықты білгеннен кейін де»
Dialogue: 0,0:43:25.85,0:43:30.39,Default,,0,0,0,,«Балға барғысы келген қыз түрлі қылмыстар жасайды».
Dialogue: 0,0:43:30.89,0:43:31.85,Default,,0,0,0,,«Алайда»
Dialogue: 0,0:43:32.35,0:43:35.65,Default,,0,0,0,,«Оларға ешқашан қылмыс жасағаны үшін айып тағылмаған.»
Dialogue: 0,0:43:37.40,0:43:42.95,Default,,0,0,0,,«Жұмбақ жұмыртқа келіп, қызды үмітсіз азғырады».
Dialogue: 0,0:43:43.62,0:43:46.33,Default,,0,0,0,,«Бұл дүниедегі ең ауыр күнә»
Dialogue: 0,0:43:47.04,0:43:49.83,Default,,0,0,0,,«Бұл сөзбен адамдарды ренжіту туралы».
Dialogue: 0,0:43:51.17,0:43:54.50,Default,,0,0,0,,«Қыз ойына келген барлық жаман сөздерді айтады».
Dialogue: 0,0:43:55.17,0:44:00.51,Default,,0,0,0,,«Сіз адамдарды ренжітесіз, адамдар сізді жек көреді, содан кейін түсінесіз ...»
Dialogue: 0,0:44:01.01,0:44:04.55,Default,,0,0,0,,«Мен тілсізмін».
Dialogue: 0,0:44:08.81,0:44:09.98,Default,,0,0,0,,Хмм.
Dialogue: 0,0:44:10.56,0:44:12.77,Default,,0,0,0,,Біраз қиындық болды.
Dialogue: 0,0:44:13.27,0:44:15.40,Default,,0,0,0,,Сонымен мұның соңы немен аяқталады?
Dialogue: 0,0:44:17.32,0:44:18.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:24.24,0:44:27.28,Default,,0,0,0,,«Не туралы сөйлескіңіз келеді»?
Dialogue: 0,0:44:27.37,0:44:27.87,Default,,0,0,0,,Ах
Dialogue: 0,0:44:27.95,0:44:31.58,Default,,0,0,0,,Қайырлы кеш, егер сізге ұнаса, жалғастырыңыз.
Dialogue: 0,0:44:32.29,0:44:35.04,Default,,0,0,0,,Мен оны Нарусе-санның қызы деп естідім.
Dialogue: 0,0:44:35.13,0:44:38.00,Default,,0,0,0,,О, шынында да, көздер дәл солай көрінеді.
Dialogue: 0,0:44:38.09,0:44:39.51,Default,,0,0,0,,Өйткені, қыздар...
Dialogue: 0,0:44:39.59,0:44:43.01,Default,,0,0,0,,Әже, мен жоғарыдағы бөлмені пайдалана аламын ба?
Dialogue: 0,0:44:43.09,0:44:46.72,Default,,0,0,0,,Не? Иә, әрине
Dialogue: 0,0:44:59.57,0:45:01.74,Default,,0,0,0,,Бұл менің әкемнің бөлмесі.
Dialogue: 0,0:45:02.24,0:45:03.78,Default,,0,0,0,,Музыка – менің хоббиім.
Dialogue: 0,0:45:03.86,0:45:07.87,Default,,0,0,0,,Сондықтан мен онымен айналысқым келмесе де, фортепианоны үйренуге мәжбүр болдым...
Dialogue: 0,0:45:08.37,0:45:10.83,Default,,0,0,0,,А, мына жерде отырыңыз.
Dialogue: 0,0:45:15.42,0:45:16.63,Default,,0,0,0,,Әже...
Dialogue: 0,0:45:18.04,0:45:20.71,Default,,0,0,0,,Мұнда бірнеше музыкалық әндер бар.
Dialogue: 0,0:45:21.21,0:45:23.51,Default,,0,0,0,,Жұмыртқа әні де солай.
Dialogue: 0,0:45:23.59,0:45:26.30,Default,,0,0,0,,Мен нөлден музыка құра алмаймын.
Dialogue: 0,0:45:26.39,0:45:29.93,Default,,0,0,0,,Аримонның әніне мәтінді кірістіру.
Dialogue: 0,0:45:30.43,0:45:32.64,Default,,0,0,0,,Мм, мысалы...
Dialogue: 0,0:45:33.18,0:45:38.56,Default,,0,0,0,,Мен жаңа ғана алған электрондық поштаның осы бөлігі туралы...
Dialogue: 0,0:45:52.58,0:45:56.17,Default,,0,0,0,,♪ Кинпика сарайында
Dialogue: 0,0:45:56.67,0:46:00.17,Default,,0,0,0,,♪ Әр түнде қайталаңыз
Dialogue: 0,0:46:00.25,0:46:04.59,Default,,0,0,0,,♪ Мырзалар мен ханымдар
Dialogue: 0,0:46:04.67,0:46:09.18,Default,,0,0,0,,♪ Сол доп
Dialogue: 0,0:46:13.35,0:46:14.52,Default,,0,0,0,,ұнайды ма?
Dialogue: 0,0:46:15.02,0:46:17.44,Default,,0,0,0,,Уау, уау...
Dialogue: 0,0:46:17.52,0:46:21.27,Default,,0,0,0,,Әй... бұл асыра сілтеу. Әннің сөзі сіздікі, солай ма?
Dialogue: 0,0:46:21.77,0:46:24.57,Default,,0,0,0,,- (ретімен) Уау! -(Такуми) Хехехе...
Dialogue: 0,0:46:24.65,0:46:27.32,Default,,0,0,0,,Нашар... Жоқ, бұл Нарузе.
Dialogue: 0,0:46:27.91,0:46:31.03,Default,,0,0,0,,Ән айтпасаң да, мен сенің не ойлағаныңды түсінемін.
Dialogue: 0,0:46:32.58,0:46:35.33,Default,,0,0,0,,Әй... Демек, бұл солай!
Dialogue: 0,0:46:35.41,0:46:39.63,Default,,0,0,0,,(Такумидің көңілді күлкісі)
Dialogue: 0,0:46:45.01,0:46:45.51,Default,,0,0,0,,Эй
Dialogue: 0,0:46:45.59,0:46:48.68,Default,,0,0,0,,Сіз мені алып кетуге келмегеніңізге қуаныштысыз ба?
Dialogue: 0,0:46:50.01,0:46:50.84,Default,,0,0,0,,Мен...
Dialogue: 0,0:46:52.93,0:46:55.64,Default,,0,0,0,,Мен ертең Нитомен сөйлесуім керек.
Dialogue: 0,0:46:56.85,0:46:58.85,Default,,0,0,0,,Мен дос ретінде мюзикл түсіргім келді.
Dialogue: 0,0:47:00.52,0:47:03.40,Default,,0,0,0,,Олай болса ертегіні соңына дейін жазыңыз.
Dialogue: 0,0:47:04.98,0:47:08.03,Default,,0,0,0,,Нарусе шынымен не туралы айтқысы келеді?
Dialogue: 0,0:47:08.53,0:47:10.07,Default,,0,0,0,,Дұрыстап сөйлесейік.
Dialogue: 0,0:47:39.14,0:47:40.69,Default,,0,0,0,,Не? қазірден?
Dialogue: 0,0:47:40.77,0:47:41.90,Default,,0,0,0,,Аа, әрине⸺
Dialogue: 0,0:47:41.98,0:47:43.61,Default,,0,0,0,,Үйірме жұмыстары аяқталғанша күте тұрсам деп едім.
Dialogue: 0,0:47:43.69,0:47:45.61,Default,,0,0,0,,Ал, мен бүгін жаттығу залын пайдалана алмаймын.
Dialogue: 0,0:47:45.69,0:47:47.69,Default,,0,0,0,,Ерте бітеді деп ойлаймын.
Dialogue: 0,0:47:48.19,0:47:50.86,Default,,0,0,0,,Ал, біз отбасылық мейрамханада күтеміз.
Dialogue: 0,0:47:54.74,0:47:56.41,Default,,0,0,0,,Егер кешігіп қалатын болсаңыз, маған электрондық поштаны жіберіңіз.
Dialogue: 0,0:47:56.49,0:47:57.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:58.20,0:48:00.37,Default,,0,0,0,,-(Такуми) Олай болса -(Нацуки) А, иә...
Dialogue: 0,0:48:07.63,0:48:09.76,Default,,0,0,0,,Электрондық пошта мекенжайы мен білмеймін.
Dialogue: 0,0:48:10.26,0:48:10.76,Default,,0,0,0,,Ах
Dialogue: 0,0:48:11.88,0:48:13.97,Default,,0,0,0,,Бүгін де станцияда уақытты өлтіру керек пе?
Dialogue: 0,0:48:15.14,0:48:16.76,Default,,0,0,0,,Ол жиіркенішті әйел.
Dialogue: 0,0:48:18.31,0:48:19.22,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:48:20.93,0:48:22.39,Default,,0,0,0,,Сіз қобалжыдыңыз ба?
Dialogue: 0,0:48:25.69,0:48:26.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:27.44,0:48:28.86,Default,,0,0,0,,Отбасылық мейрамханаға барар алдында
Dialogue: 0,0:48:28.94,0:48:31.28,Default,,0,0,0,,Мен тоқтағым келетін жер бар.
Dialogue: 0,0:48:31.36,0:48:32.36,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:48:32.45,0:48:35.12,Default,,0,0,0,,Не, сені жоғары оқу орындары қызықтырмайды ғой?
Dialogue: 0,0:48:35.20,0:48:37.24,Default,,0,0,0,,Дауыстық актер 2,5 өлшемді...
Dialogue: 0,0:48:37.33,0:48:38.70,Default,,0,0,0,,Міне...
Dialogue: 0,0:48:39.20,0:48:41.91,Default,,0,0,0,,- (Иваки/Айзава) Уау! -(Такуми) Не істеп жатырсың?
Dialogue: 0,0:48:42.54,0:48:46.88,Default,,0,0,0,,♪ Мен...
Dialogue: 0,0:48:46.96,0:48:48.34,Default,,0,0,0,,Таку
Dialogue: 0,0:48:48.42,0:48:50.34,Default,,0,0,0,,Қыз, мені әкелетін болсаң, алдын ала айт.
Dialogue: 0,0:48:50.42,0:48:51.59,Default,,0,0,0,,Әрине, дәмді болмауы мүмкін емес — рецептіні дәлме-дәл орындадым. Бұл дәл бір тәжірибе сияқты.
Dialogue: 0,0:48:51.67,0:48:54.55,Default,,0,0,0,,Кешіріңіз... Кешіріңіз, Нарусе мырза, мұны рұқсатсыз жасағаным үшін.
Dialogue: 0,0:48:55.05,0:48:57.80,Default,,0,0,0,,- (Иваки) Иә? -(Айзава) Бұл сенің жақсы екеніңді білдіре ме?
Dialogue: 0,0:48:57.89,0:48:59.47,Default,,0,0,0,,Уф, тым қызықсыз екен.
Dialogue: 0,0:48:59.56,0:49:02.39,Default,,0,0,0,,Балалар, мен сендермен араласамын.
Dialogue: 0,0:49:02.48,0:49:04.81,Default,,0,0,0,,Мюзикл түсіруге шындап кірісетініңді айтсам, не істер едің?
Dialogue: 0,0:49:05.31,0:49:06.61,Default,,0,0,0,,Әй, бұл азап.
Dialogue: 0,0:49:06.69,0:49:07.73,Default,,0,0,0,,Әдетте жоқ.
Dialogue: 0,0:49:07.81,0:49:08.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:08.57,0:49:11.61,Default,,0,0,0,,Жарайды, егер Таку байыпты болса, мен онымен бірге шығамын.
Dialogue: 0,0:49:11.69,0:49:14.57,Default,,0,0,0,,Мен Нарузенің әндерін көбірек тыңдағым келеді.
Dialogue: 0,0:49:14.66,0:49:16.45,Default,,0,0,0,,О? Қандай мойындау?
Dialogue: 0,0:49:16.53,0:49:17.99,Default,,0,0,0,,Бах... бұл шындық болуы мүмкін емес!
Dialogue: 0,0:49:18.08,0:49:19.45,Default,,0,0,0,,Менің гаремім толып қалды
Dialogue: 0,0:49:19.53,0:49:21.66,Default,,0,0,0,,Үшінші тараптың араласу мүмкіндігі жоқ!
Dialogue: 0,0:49:21.75,0:49:23.87,Default,,0,0,0,,Жарайды, жарайды... Гарем деген не?
Dialogue: 0,0:49:28.25,0:49:30.09,Default,,0,0,0,,Өткен жолғы бір ән
Dialogue: 0,0:49:30.17,0:49:34.42,Default,,0,0,0,,Уақыт шектеулі, сондықтан мен ең көбі 6 ән шырқайтын шығармын.
Dialogue: 0,0:49:34.51,0:49:35.13,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,0:49:35.22,0:49:36.89,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:49:36.97,0:49:38.97,Default,,0,0,0,,Не? Ах, о...
Dialogue: 0,0:49:39.05,0:49:40.56,Default,,0,0,0,,А, мен жалықтым.
Dialogue: 0,0:49:41.06,0:49:43.43,Default,,0,0,0,,Тасаки-кун да комитеттің мүшесі.
Dialogue: 0,0:49:44.89,0:49:46.19,Default,,0,0,0,,ойлағанымдай жақсы жүрмей тұр. Алғашында бәрі жақсы еді.
Dialogue: 0,0:49:46.27,0:49:48.15,Default,,0,0,0,,А-а, шынында...
Dialogue: 0,0:49:49.44,0:49:51.69,Default,,0,0,0,,Бұл...
Dialogue: 0,0:49:51.78,0:49:55.36,Default,,0,0,0,,- (Такуми) Нарусе жазған әңгіме - (Нацуки) Нарусе мырза?
Dialogue: 0,0:49:55.45,0:49:58.32,Default,,0,0,0,,Әңгімелеу сіздің келесі әрекеттесуіңізде осы туралы.
Dialogue: 0,0:49:58.41,0:50:00.95,Default,,0,0,0,,Мен оны мюзикл ретінде көрсеткім келеді...
Dialogue: 0,0:50:01.03,0:50:03.33,Default,,0,0,0,,А-а, сенің істегенің түпнұсқа.
Dialogue: 0,0:50:03.41,0:50:04.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:04.20,0:50:05.75,Default,,0,0,0,,Бірақ бұл оқиға...
Dialogue: 0,0:50:05.83,0:50:08.58,Default,,0,0,0,,Ах, соңы әлі шешілген жоқ.
Dialogue: 0,0:50:08.67,0:50:09.71,Default,,0,0,0,,Бірақ жақсы ма?
Dialogue: 0,0:50:09.79,0:50:10.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:10.42,0:50:12.34,Default,,0,0,0,,Жоқ, мен мюзикл түсіремін деп отырмын.
Dialogue: 0,0:50:12.42,0:50:16.51,Default,,0,0,0,,Себебі кеше Нарусе мырзаны көргенде...
Dialogue: 0,0:50:17.01,0:50:19.68,Default,,0,0,0,,Мен көремін. Тасаки ше?
Dialogue: 0,0:50:22.93,0:50:24.02,Default,,0,0,0,,Наруз
Dialogue: 0,0:50:25.52,0:50:27.69,Default,,0,0,0,,Бұл... бұл не?
Dialogue: 0,0:50:28.19,0:50:28.98,Default,,0,0,0,,Кеше...
Dialogue: 0,0:50:29.06,0:50:32.11,Default,,0,0,0,,Ақыр соңында, Тасаки-сан өте жақсы және оңай босаңсу!
Dialogue: 0,0:50:32.19,0:50:32.86,Default,,0,0,0,,Эй
Dialogue: 0,0:50:32.94,0:50:36.65,Default,,0,0,0,,Жоқ, шынымды айтсам, мен мұнда мәңгілікке келмеймін.
Dialogue: 0,0:50:36.74,0:50:38.32,Default,,0,0,0,,2 жыл болды бәрінің жалығып.
Dialogue: 0,0:50:38.41,0:50:41.37,Default,,0,0,0,,Мұның мағынасы жоқ, Ямаджи.
Dialogue: 0,0:50:41.45,0:50:42.45,Default,,0,0,0,,О
Dialogue: 0,0:50:43.03,0:50:44.66,Default,,0,0,0,,Мишима-сан да ащы емес...
Dialogue: 0,0:50:45.41,0:50:47.04,Default,,0,0,0,,Эй, картоп алғыңыз келе ме?
Dialogue: 0,0:50:47.12,0:50:48.75,Default,,0,0,0,,Поте.
Dialogue: 0,0:50:48.83,0:50:50.88,Default,,0,0,0,,Иә? Не... аа!
Dialogue: 0,0:50:50.96,0:50:53.50,Default,,0,0,0,,Татата… Тасаки-сенпай…
Dialogue: 0,0:50:53.59,0:50:55.88,Default,,0,0,0,,Э? Ой-ау…
Dialogue: 0,0:50:57.47,0:50:58.55,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:50:58.63,0:51:00.30,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:51:00.39,0:51:02.51,Default,,0,0,0,,Неге рұқсатсыз басыңды иіп тұрсың?
Dialogue: 0,0:51:02.60,0:51:05.93,Default,,0,0,0,,Маған бас исең де, ештеңе болмайды.
Dialogue: 0,0:51:06.02,0:51:08.77,Default,,0,0,0,,Мен Мишиманың қанша қиындық көріп жатқанын білмеймін.
Dialogue: 0,0:51:08.85,0:51:10.23,Default,,0,0,0,,Не істеп жатырсың?!
Dialogue: 0,0:51:10.31,0:51:11.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:12.06,0:51:13.57,Default,,0,0,0,,Дұрыс, бұл сызық.
Dialogue: 0,0:51:13.65,0:51:14.98,Default,,0,0,0,,Yamaji Тоқта!
Dialogue: 0,0:51:15.07,0:51:17.03,Default,,0,0,0,,Не істеп жатырсың, Сенпай?
Dialogue: 0,0:51:17.11,0:51:17.61,Default,,0,0,0,,Әй?
Dialogue: 0,0:51:17.69,0:51:20.57,Default,,0,0,0,,Үйірмеге бетіңізді көрсетпеңіз және өзіңізбен бірге әйелді алып келіңіз.
Dialogue: 0,0:51:20.66,0:51:21.91,Default,,0,0,0,,Жоқ... жоқ.
Dialogue: 0,0:51:21.99,0:51:24.16,Default,,0,0,0,,Біз мектепте... Өзара әрекеттестік...
Dialogue: 0,0:51:24.24,0:51:26.45,Default,,0,0,0,,Иә? Өзара әрекеттесу?
Dialogue: 0,0:51:26.54,0:51:28.12,Default,,0,0,0,,Мен не айта аламын? Ямадзи
Dialogue: 0,0:51:28.62,0:51:29.83,Default,,0,0,0,,Жаңа команда басталды
Dialogue: 0,0:51:30.71,0:51:34.71,Default,,0,0,0,,Жүйе әлі нығайтылған жоқ, сондықтан жылдың осы уақытында шынымен де көп мүмкіндік бар.
Dialogue: 0,0:51:36.25,0:51:39.26,Default,,0,0,0,,«Сіз қазіргі эйссіз» деуге не итермелейді?
Dialogue: 0,0:51:39.76,0:51:42.34,Default,,0,0,0,,Әрқашан осы үлкен нәрселердің бәрін айту
Dialogue: 0,0:51:42.43,0:51:43.72,Default,,0,0,0,,Бұл көз ауыртады!
Dialogue: 0,0:51:43.80,0:51:45.72,Default,,0,0,0,,Әйтеуір, көз алдымда анық.
Dialogue: 0,0:51:45.81,0:51:47.81,Default,,0,0,0,,Сен жоғалып кетсең жақсы болар еді!
Dialogue: 0,0:51:47.89,0:51:48.81,Default,,0,0,0,,(тұру дыбысы)
Dialogue: 0,0:51:50.27,0:51:52.31,Default,,0,0,0,,Мен... Маған бәрібір...
Dialogue: 0,0:51:54.44,0:51:56.27,Default,,0,0,0,,Ғрр! Б-бұл жігіт…
Dialogue: 0,0:51:56.78,0:51:58.94,Default,,0,0,0,,Оңай жоғалып кету сияқты сөздерді айтпа!
Dialogue: 0,0:52:00.32,0:52:00.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:01.03,0:52:04.57,Default,,0,0,0,,Бұл... сөздер ауырады.
Dialogue: 0,0:52:05.41,0:52:06.41,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:52:07.58,0:52:10.54,Default,,0,0,0,,Сіз оны қайтара алмайсыз!
Dialogue: 0,0:52:12.71,0:52:16.63,Default,,0,0,0,,Өкінсең де, оны ешқашан қайтара алмайсың!
Dialogue: 0,0:52:17.13,0:52:18.63,Default,,0,0,0,,Наруза Жарайды ма?
Dialogue: 0,0:52:18.71,0:52:19.67,Default,,0,0,0,,Не?
Dialogue: 0,0:52:19.76,0:52:23.64,Default,,0,0,0,,Бұл не... жұмыртқа қарғысы деп аталады?
Dialogue: 0,0:52:25.93,0:52:27.26,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:52:27.35,0:52:29.43,Default,,0,0,0,,Тоқта... Нарусе-сан, жақсысың ба?
Dialogue: 0,0:52:29.52,0:52:31.77,Default,,0,0,0,,Әй... Әй, дәрігер... Жоқ, жедел жәрдем!
Dialogue: 0,0:52:31.85,0:52:33.60,Default,,0,0,0,,Е, иә... не істеуіміз керек?
Dialogue: 0,0:52:33.69,0:52:34.73,Default,,0,0,0,,Сонымен... Қоңырау шалыңыз! ұялы телефон!
Dialogue: 0,0:52:34.81,0:52:37.77,Default,,0,0,0,,Бұл басқа тұтынушыларға келтіруі мүмкін қолайсыздық үшін кешірім сұраймыз...
Dialogue: 0,0:52:37.86,0:52:39.23,Default,,0,0,0,,Жоқ, бұл бәрі емес!
Dialogue: 0,0:52:48.37,0:52:49.37,Default,,0,0,0,,Тапсырыс!
Dialogue: 0,0:52:51.37,0:52:55.25,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:52:56.50,0:52:59.34,Default,,0,0,0,,Маған ауруханадан қоңырау соғылды, мен жүгірдім де...
Dialogue: 0,0:53:02.30,0:53:04.26,Default,,0,0,0,,Не? Іштің ауыруы
Dialogue: 0,0:53:05.01,0:53:07.22,Default,,0,0,0,,Бұл қарғыс немесе басқа нәрсе ме?
Dialogue: 0,0:53:07.30,0:53:08.18,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:53:09.06,0:53:10.18,Default,,0,0,0,,Сонымен қатар, Yoshida Productions Яиді Yotsuba-ның талисманы ретінде насихаттап жатыр.
Dialogue: 0,0:53:13.73,0:53:16.61,Default,,0,0,0,,Иә, жақсы. Өз-өзіңді күт.
Dialogue: 0,0:53:16.69,0:53:17.90,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:53:17.98,0:53:20.78,Default,,0,0,0,,Жоқ, мен тезірек кетуім керек.
Dialogue: 0,0:53:20.86,0:53:22.69,Default,,0,0,0,,А, онда Нарузеге бір сөз...
Dialogue: 0,0:53:22.78,0:53:26.41,Default,,0,0,0,,Білесіз бе... бұл жаман болды.
Dialogue: 0,0:53:26.49,0:53:29.45,Default,,0,0,0,,- (Нацуки) Бұл Тасаки-кунның кінәсі емес... - (Тайки) Жоқ, мен емес...
Dialogue: 0,0:53:29.53,0:53:32.70,Default,,0,0,0,,Неліктен? Мені сонша жек көресің бе?
Dialogue: 0,0:53:32.79,0:53:36.25,Default,,0,0,0,,Мен көпке дейін үндемедім, көршілер өсек-аяңды бастады.
Dialogue: 0,0:53:36.75,0:53:40.38,Default,,0,0,0,,Сізге қандай тапсырыс керек? Мені қорлайсың ба?
Dialogue: 0,0:53:40.46,0:53:42.42,Default,,0,0,0,,Бірдеңе айт
Dialogue: 0,0:53:42.96,0:53:45.88,Default,,0,0,0,,Егер сіз бүлік шығарғыңыз келсе, оны жасаңыз. Мен түсінбеймін...
Dialogue: 0,0:53:46.38,0:53:48.76,Default,,0,0,0,,Қазірдің өзінде! Мен қазірдің өзінде шаршадым!
Dialogue: 0,0:53:49.26,0:53:51.85,Default,,0,0,0,,Жұмыс пен тәртіп туралы барлығы!
Dialogue: 0,0:53:53.64,0:53:55.19,Default,,0,0,0,,Сіз Сакагами мырзасыз ба?
Dialogue: 0,0:53:56.27,0:54:01.40,Default,,0,0,0,,Әлгі Нарузе... Джун - жарқын жігіт.
Dialogue: 0,0:54:01.48,0:54:02.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:02.40,0:54:05.57,Default,,0,0,0,,Мен сөйлеп тұрған жоқпын, бірақ...
Dialogue: 0,0:54:06.28,0:54:09.20,Default,,0,0,0,,Сіз ойыңызда көп сөйлейсіз бе?
Dialogue: 0,0:54:09.78,0:54:12.87,Default,,0,0,0,,Бүгін ауырып қалуымыздың себебі...
Dialogue: 0,0:54:13.37,0:54:15.91,Default,,0,0,0,,Себебі сен досың үшін барын салды.
Dialogue: 0,0:54:16.00,0:54:20.88,Default,,0,0,0,,Мен оның не екенін білмеймін... Мен оның не екенін білмеймін, бірақ...
Dialogue: 0,0:54:21.59,0:54:23.92,Default,,0,0,0,,Дегенмен, Нарусе әрқашан
Dialogue: 0,0:54:24.01,0:54:27.72,Default,,0,0,0,,Мен тынбай еңбек еттім.
Dialogue: 0,0:54:35.52,0:54:38.19,Default,,0,0,0,,- (Нацуки) Мен таң қалдым - (Такуми) Не?
Dialogue: 0,0:54:38.27,0:54:40.94,Default,,0,0,0,,Хмм... әртүрлі заттар.
Dialogue: 0,0:54:42.11,0:54:45.28,Default,,0,0,0,,Эй, бұл шынымен жақсы болды ма? музыкалық
Dialogue: 0,0:54:45.99,0:54:49.41,Default,,0,0,0,,Мен де Нарузе-санның сезімін түсінгендей болдым.
Dialogue: 0,0:54:49.49,0:54:50.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:50.20,0:54:53.33,Default,,0,0,0,,Өйткені айтқым келген, бірақ айта алмаған дүниелер болды.
Dialogue: 0,0:54:56.75,0:55:01.75,Default,,0,0,0,,Мен орта мектепте оқып жүрген кезімде... Сакагами-кун ең қиын кезде.
Dialogue: 0,0:55:01.84,0:55:04.88,Default,,0,0,0,,Мен сен үшін ештеңе істей алмаймын.
Dialogue: 0,0:55:06.01,0:55:07.76,Default,,0,0,0,,Ол...
Dialogue: 0,0:55:09.84,0:55:10.72,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:55:24.11,0:55:25.73,Default,,0,0,0,,Бұрынғы Нарузе мырза
Dialogue: 0,0:55:25.82,0:55:28.57,Default,,0,0,0,,«Сөз ауыртады» маған тез келді.
Dialogue: 0,0:55:29.07,0:55:32.87,Default,,0,0,0,,Олай емес... орта мектеп оқушылары осындай.
Dialogue: 0,0:55:33.74,0:55:35.70,Default,,0,0,0,,Мен қызықсыз жігітпін
Dialogue: 0,0:55:35.79,0:55:38.00,Default,,0,0,0,,Бастапқыда бұл Нитоға жақсы сәйкес келмеді.
Dialogue: 0,0:55:38.08,0:55:39.33,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:55:39.41,0:55:42.63,Default,,0,0,0,,Сакагами-кун, не болса да, ешқашан шырылдама.
Dialogue: 0,0:55:42.71,0:55:44.42,Default,,0,0,0,,Өте мұқият
Dialogue: 0,0:55:44.50,0:55:46.42,Default,,0,0,0,,Қиындыққа тап болған адамдарға назар аударыңыз
Dialogue: 0,0:55:46.50,0:55:47.88,Default,,0,0,0,,Және... а
Dialogue: 0,0:55:48.38,0:55:49.05,Default,,0,0,0,,Сәлеметсіз бе...
Dialogue: 0,0:55:49.55,0:55:52.30,Default,,0,0,0,,О, жарайсыңдар
Dialogue: 0,0:55:52.97,0:55:55.26,Default,,0,0,0,,Жоқ, бірақ... иә
Dialogue: 0,0:55:55.35,0:55:59.10,Default,,0,0,0,,Мен іш пыстыратыныма көзім жетті.
Dialogue: 0,0:55:59.18,0:56:00.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:00.10,0:56:03.15,Default,,0,0,0,,Не ойлайтыныңызды айтыңыз немесе бірдеңені қайтарыңыз
Dialogue: 0,0:56:03.23,0:56:04.94,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,0:56:05.02,0:56:08.40,Default,,0,0,0,,Айналаңыздағылармен қақтығысу қиын, сондықтан маған бәрібір.
Dialogue: 0,0:56:08.90,0:56:10.15,Default,,0,0,0,,Бірақ Нарусегаса
Dialogue: 0,0:56:10.65,0:56:12.57,Default,,0,0,0,,Бұл өте ауыр көрінсе де
Dialogue: 0,0:56:12.66,0:56:15.28,Default,,0,0,0,,Сонда да әйтеуір ішімдегі сөздерді айтып үлгердім.
Dialogue: 0,0:56:15.87,0:56:18.45,Default,,0,0,0,,Менің оны көпшілікке көрсетуге тырысып жатқанымды көрсеңіз,
Dialogue: 0,0:56:18.54,0:56:21.16,Default,,0,0,0,,Сіз не айтып тұрсыз... мен де...
Dialogue: 0,0:56:22.29,0:56:24.46,Default,,0,0,0,,Бұл мені қолдағым келеді.
Dialogue: 0,0:56:24.54,0:56:25.67,Default,,0,0,0,,Екеуін біз қараймыз.
Dialogue: 0,0:56:26.88,0:56:29.63,Default,,0,0,0,,Сакагами-кун Нарусе-сан туралы айтып жатыр...
Dialogue: 0,0:56:30.63,0:56:31.72,Default,,0,0,0,,Не болды?
Dialogue: 0,0:56:34.01,0:56:35.43,Default,,0,0,0,,Мен де сені қолдаймын!
Dialogue: 0,0:56:35.51,0:56:38.14,Default,,0,0,0,,Нарусе-сан мен Сакагами-кун туралы да!
Dialogue: 0,0:56:38.22,0:56:39.93,Default,,0,0,0,,ше? Неге мен?
Dialogue: 0,0:56:40.02,0:56:43.60,Default,,0,0,0,,Бұл шешілді, өйткені черлидердің қаны қозғалады, солай ма?
Dialogue: 0,0:56:44.10,0:56:45.15,Default,,0,0,0,,Мен оны… қолданамын деп ойламаған едім
Dialogue: 0,0:56:45.65,0:56:48.86,Default,,0,0,0,,Мен Нитомен тағы осылай сөйлесе аламын.
Dialogue: 0,0:56:49.36,0:56:51.24,Default,,0,0,0,,Мұның бәрі Нарузенің арқасында.
Dialogue: 0,0:57:02.41,0:57:04.08,Default,,0,0,0,,Сіздің достарыңыз болды емес пе?
Dialogue: 0,0:57:06.96,0:57:09.63,Default,,0,0,0,,Көршілес қауымдастық жарнасы үшін рахмет.
Dialogue: 0,0:57:14.97,0:57:18.39,Default,,0,0,0,,Нарусе әрқашан қолынан келгеннің бәрін жасайды...
Dialogue: 0,0:57:18.89,0:57:20.31,Default,,0,0,0,,Мен барынша тырысамын.
Dialogue: 0,0:57:22.18,0:57:22.89,Default,,0,0,0,,Ханзада
Dialogue: 0,0:57:23.77,0:57:27.48,Default,,0,0,0,,Бойын мұңды сөзге толтырған қызға
Dialogue: 0,0:57:27.98,0:57:30.28,Default,,0,0,0,,Шөлге сіңген судай
Dialogue: 0,0:57:30.78,0:57:34.82,Default,,0,0,0,,Мен саған өте қымбат, қуанышты сөздер бердім.
Dialogue: 0,0:57:38.95,0:57:40.08,Default,,0,0,0,,Хаа…
Dialogue: 0,0:57:40.16,0:57:43.08,Default,,0,0,0,,Соңында кешірім сұрай алмадым.
Dialogue: 0,0:57:46.04,0:57:48.00,Default,,0,0,0,,- (Харуна) Сонымен... - (Аки) Уау!
Dialogue: 0,0:57:48.08,0:57:48.84,Default,,0,0,0,,Увааах! Уф!
Dialogue: 0,0:57:48.92,0:57:50.88,Default,,0,0,0,,Мен саған көп қарап тұрдым.
Dialogue: 0,0:57:50.96,0:57:53.01,Default,,0,0,0,,Әй, сені Аки қызықтырады, солай ма?
Dialogue: 0,0:57:53.09,0:57:54.97,Default,,0,0,0,,Жоқ, бұл өте қорқынышты.
Dialogue: 0,0:58:00.14,0:58:02.27,Default,,0,0,0,,Таңертеңгілік жаттығуды өткізіп жіберген жігіт.
Dialogue: 0,0:58:02.35,0:58:04.64,Default,,0,0,0,,Мұнда анда-санда келсең, міне, осы.
Dialogue: 0,0:58:05.14,0:58:05.98,Default,,0,0,0,,Сәрсен
Dialogue: 0,0:58:07.10,0:58:09.94,Default,,0,0,0,,Барлығы спортзалға кетті, асығыңыздар.
Dialogue: 0,0:58:10.44,0:58:11.52,Default,,0,0,0,,Құдайлар
Dialogue: 0,0:58:12.32,0:58:14.03,Default,,0,0,0,,Иә? Дай-чан
Dialogue: 0,0:58:14.11,0:58:16.78,Default,,0,0,0,,А, мен жаттығым келеді... Иә?
Dialogue: 0,0:58:18.03,0:58:18.91,Default,,0,0,0,,Не? Бұл...
Dialogue: 0,0:58:18.99,0:58:21.03,Default,,0,0,0,,- (Тайки) Осы уақытқа дейін не жаман болды - (Мишима)?
Dialogue: 0,0:58:21.95,0:58:23.33,Default,,0,0,0,,Матч пен жарақатқа менің кінәм болды...
Dialogue: 0,0:58:23.41,0:58:24.83,Default,,0,0,0,,Күте тұрыңыз, Дай Чан
Dialogue: 0,0:58:24.91,0:58:26.54,Default,,0,0,0,,Бұл тек Дай Чанның кінәсі...
Dialogue: 0,0:58:26.62,0:58:27.58,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:58:28.54,0:58:31.96,Default,,0,0,0,,Бірақ мұны жасамасаңыз, ол басталмайды.
Dialogue: 0,0:58:34.21,0:58:39.34,Default,,0,0,0,,Мен мылқаумын, бәрін өзім көтеріп жүргендей сезінемін.
Dialogue: 0,0:58:39.84,0:58:41.18,Default,,0,0,0,,Үлкен нәрсені айту
Dialogue: 0,0:58:41.68,0:58:43.81,Default,,0,0,0,,Сосын команда үшін деп айтасың.
Dialogue: 0,0:58:44.31,0:58:48.06,Default,,0,0,0,,Бірақ шындық, Мишима, Ямаджи және басқалары үшін.
Dialogue: 0,0:58:48.56,0:58:50.15,Default,,0,0,0,,Тек сені қорқыту үшін, сені қорқыту үшін.
Dialogue: 0,0:58:50.23,0:58:53.23,Default,,0,0,0,,Себебі мен, капитан, қолымнан келгеннің бәрін жасамаймын...
Dialogue: 0,0:58:53.32,0:58:56.40,Default,,0,0,0,,Жоқ, бұл менің айтқым келгенім емес.
Dialogue: 0,0:58:57.20,0:59:00.45,Default,,0,0,0,,Іс осылай жалғаса берсе, мен жарымжан боламын.
Dialogue: 0,0:59:00.95,0:59:03.99,Default,,0,0,0,,Тісі қайраңдап әркім неше түрлі нәрсеге шыдайды.
Dialogue: 0,0:59:04.08,0:59:07.33,Default,,0,0,0,,Мен жай ғана кешірім сұрау және істерді жеңілдетуге тырысу өте жақсы қате екенін білемін.
Dialogue: 0,0:59:07.41,0:59:12.04,Default,,0,0,0,,Бірақ қайта бастауға рұқсат бере аласыз ба?
Dialogue: 0,0:59:14.88,0:59:15.67,Default,,0,0,0,,Тау жолы…
Dialogue: 0,0:59:16.17,0:59:18.38,Default,,0,0,0,,Қайта ұйымдастырудан кейін не істеуіміз керек?
Dialogue: 0,0:59:20.47,0:59:22.22,Default,,0,0,0,,Жарақатыңызды емдеңіз
Dialogue: 0,0:59:22.89,0:59:25.18,Default,,0,0,0,,Балалар, сендермен тағы да Кошиенді көздеу
Dialogue: 0,0:59:27.73,0:59:30.56,Default,,0,0,0,,- (Ямадзи) Мен жаттығуға барамын - (Мишима) Ямадзи...
Dialogue: 0,0:59:33.15,0:59:34.90,Default,,0,0,0,,Енді не істейсің?
Dialogue: 0,0:59:35.40,0:59:36.53,Default,,0,0,0,,Әзірге
Dialogue: 0,0:59:36.61,0:59:39.70,Default,,0,0,0,,Алдымдағыны бір-бірден қадағалаймын.
Dialogue: 0,0:59:40.20,0:59:41.49,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:59:42.32,0:59:44.20,Default,,0,0,0,,Ал, мен бақыттымын.
Dialogue: 0,0:59:44.91,0:59:47.62,Default,,0,0,0,,Егер сіз шынымен мюзикл түсіргіңіз келсе.
Dialogue: 0,0:59:47.70,0:59:49.58,Default,,0,0,0,,Мен сізге қолдау көрсету үшін бар күшімді саламын!
Dialogue: 0,0:59:49.66,0:59:50.67,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:59:51.17,0:59:52.92,Default,,0,0,0,,Өзім айта бастасам да
Dialogue: 0,0:59:53.00,0:59:55.92,Default,,0,0,0,,Енді Тасаки келгенде барлығы жиналып қалады.
Dialogue: 0,0:59:56.00,0:59:57.59,Default,,0,0,0,,Қорқатын ештеңе жоқ.
Dialogue: 0,0:59:57.67,1:00:00.47,Default,,0,0,0,,Бұл қиын болуы керек, солай ма?
Dialogue: 0,1:00:00.55,1:00:01.93,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,1:00:02.01,1:00:05.97,Default,,0,0,0,,Әлемнің түкпір-түкпіріндегі мюзиклдер әдетте болып жатқан ғажайыптар туралы.
Dialogue: 0,1:00:06.06,1:00:08.31,Default,,0,0,0,,Бұл емес... Аа.
Dialogue: 0,1:00:08.81,1:00:10.85,Default,,0,0,0,,- (Джиросима) Хухун - (Тайки) Кешіріңіз.
Dialogue: 0,1:00:11.89,1:00:13.40,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:19.82,1:00:21.32,Default,,0,0,0,,Күте тұрыңыз, не?
Dialogue: 0,1:00:21.40,1:00:22.53,Default,,0,0,0,,Наруз
Dialogue: 0,1:00:23.36,1:00:25.03,Default,,0,0,0,,Өткен жолы мен ақымақтық айттым, бұл жаман болды.
Dialogue: 0,1:00:25.12,1:00:25.62,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:25.70,1:00:26.49,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:26.99,1:00:27.58,Default,,0,0,0,,Содан кейін
Dialogue: 0,1:00:28.16,1:00:30.29,Default,,0,0,0,,Қарсы болмасаңыз, не істемексіз?
Dialogue: 0,1:00:30.37,1:00:32.33,Default,,0,0,0,,Жапон аудиосы: AB, yang; Жапон аудиосын тексеру: Anonymous; Аударма: Qiyue, Oui; Аударма және тексеру: zwx; Уақытты баптау: Xiaobing; Кодтау: Nakatsu Shizuru
Dialogue: 0,1:00:33.12,1:00:34.33,Default,,0,0,0,,Жоқ?
Dialogue: 0,1:00:34.96,1:00:37.00,Default,,0,0,0,,Та... Тасаки-кун?
Dialogue: 0,1:00:43.47,1:00:46.76,Default,,0,0,0,,О... Жарайды, танысқаныма қуаныштымын...
Dialogue: 0,1:00:46.85,1:00:48.68,Default,,0,0,0,,Не? Бұл не?
Dialogue: 0,1:00:48.77,1:00:49.81,Default,,0,0,0,,Ессіз Патшаның зорлық-зомбылығына соңына нүкте қоятын – дәл сіздерсіздер!
Dialogue: 0,1:00:49.89,1:00:52.14,Default,,0,0,0,,Бұл болды, ғажайып
Dialogue: 0,1:00:55.61,1:00:57.02,Default,,0,0,0,,...
Dialogue: 0,1:00:57.11,1:00:58.98,Default,,0,0,0,,Келесі әрекеттесуде
Dialogue: 0,1:00:59.07,1:01:01.28,Default,,0,0,0,,Мен жаңа ғана таратқан баспа қағаздарын пайдаланып, мюзикл орындағалы жатырмын.
Dialogue: 0,1:01:01.36,1:01:03.28,Default,,0,0,0,,Эх!
Dialogue: 0,1:01:03.36,1:01:05.74,Default,,0,0,0,,- (Сузуки) Бұл не? - (Нишикори) Неге кенеттен?
Dialogue: 0,1:01:05.82,1:01:07.49,Default,,0,0,0,,Бұл тым өзімшілдік емес пе?
Dialogue: 0,1:01:07.58,1:01:11.20,Default,,0,0,0,,Айтайын дегенім, өткен күні ең көп қарсы болған сен едің.
Dialogue: 0,1:01:11.29,1:01:12.25,Default,,0,0,0,,Дұрыс?
Dialogue: 0,1:01:12.33,1:01:13.67,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:01:14.62,1:01:16.79,Default,,0,0,0,,Мен Наруземен қиналып жүрмін.
Dialogue: 0,1:01:16.88,1:01:19.84,Default,,0,0,0,,Мюзикл түсіруге болмайды деп қарсы болдым.
Dialogue: 0,1:01:20.88,1:01:23.63,Default,,0,0,0,,Бірақ Нарусе мұны істей алатынын дәлелдеді.
Dialogue: 0,1:01:23.72,1:01:25.51,Default,,0,0,0,,Сондықтан біз мұны істейміз
Dialogue: 0,1:01:26.43,1:01:28.85,Default,,0,0,0,,Бірақ бұл тек Тасакидің мәселесі.
Dialogue: 0,1:01:28.93,1:01:30.64,Default,,0,0,0,,Мен сіздің араласқаныңызды қаламаймын.
Dialogue: 0,1:01:31.56,1:01:32.93,Default,,0,0,0,,- (Тайки) А? -(Нацуки) Эй...
Dialogue: 0,1:01:33.02,1:01:33.60,Default,,0,0,0,,Жалпы
Dialogue: 0,1:01:33.69,1:01:36.40,Default,,0,0,0,,Неліктен бұл ең қиын мюзикл?
Dialogue: 0,1:01:36.48,1:01:39.57,Default,,0,0,0,,Сондай-ақ, бұл түпнұсқа жасау дегенді білдіреді, солай ма?
Dialogue: 0,1:01:39.65,1:01:41.82,Default,,0,0,0,,Біздің кездесуімізге бір айдан аз ғана уақыт қалды.
Dialogue: 0,1:01:41.90,1:01:45.41,Default,,0,0,0,,Әйтеуір көршілері біразға келеді.
Dialogue: 0,1:01:45.49,1:01:48.45,Default,,0,0,0,,Дұрыс, ендеше қарапайымырақ әрекет жасайық...
Dialogue: 0,1:01:48.53,1:01:53.50,Default,,0,0,0,,Шынымды айтсам, басында мен де мән бермедім.
Dialogue: 0,1:01:54.04,1:01:57.21,Default,,0,0,0,,Бірақ егер байыпты адам болса да.
Dialogue: 0,1:01:57.29,1:01:58.29,Default,,0,0,0,,Сол затқа міну
Dialogue: 0,1:01:58.88,1:02:02.38,Default,,0,0,0,,Мен қолымнан келгенді сынау қызық болар деп ойладым.
Dialogue: 0,1:02:02.46,1:02:03.51,Default,,0,0,0,,Мен де...
Dialogue: 0,1:02:04.17,1:02:07.43,Default,,0,0,0,,Менің бұған уақытым жоқ, бұл қиын болуы мүмкін.
Dialogue: 0,1:02:07.51,1:02:10.26,Default,,0,0,0,,Атқару комитетінің мүшесі ретінде мен бар күшімді саламын, сондықтан...
Dialogue: 0,1:02:10.35,1:02:11.47,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:02:11.56,1:02:14.85,Default,,0,0,0,,Әйтеуір, бәрібір жасаймын десең, жарқырап тұрғаның жақсы.
Dialogue: 0,1:02:14.93,1:02:16.60,Default,,0,0,0,,Бұл қызықты көрінеді!
Dialogue: 0,1:02:16.69,1:02:17.52,Default,,0,0,0,,Мен де!
Dialogue: 0,1:02:17.60,1:02:20.06,Default,,0,0,0,,Мюзикл болса, би де бар шығар, солай ма?
Dialogue: 0,1:02:20.15,1:02:21.77,Default,,0,0,0,,Мен хореографияны сынап көргім келді.
Dialogue: 0,1:02:21.86,1:02:22.82,Default,,0,0,0,,Эдакчи...
Dialogue: 0,1:02:22.90,1:02:23.53,Default,,0,0,0,,Таку!
Dialogue: 0,1:02:24.11,1:02:26.07,Default,,0,0,0,,Әнді орындай аламыз, солай ма?
Dialogue: 0,1:02:26.15,1:02:28.32,Default,,0,0,0,,Бұл DTM зертханасы үшін тамаша кезең.
Dialogue: 0,1:02:28.41,1:02:30.24,Default,,0,0,0,,Музыкаға келгенде, әрине, мен де.
Dialogue: 0,1:02:30.32,1:02:31.78,Default,,0,0,0,,Біз сізді қолдаймыз.
Dialogue: 0,1:02:31.87,1:02:33.37,Default,,0,0,0,,Менің лайықты бюджетім бар.
Dialogue: 0,1:02:33.45,1:02:36.50,Default,,0,0,0,,Бұл өнер сияқты күрделі нәрселерді жасай алатыныңызды білдіре ме?
Dialogue: 0,1:02:36.58,1:02:37.62,Default,,0,0,0,,Костюмдер туралы не деуге болады?
Dialogue: 0,1:02:37.71,1:02:39.42,Default,,0,0,0,,Міне, бұл туралы.
Dialogue: 0,1:02:39.50,1:02:41.96,Default,,0,0,0,,Жарайды, мен бәрібір бірдеңе істеуім керек.
Dialogue: 0,1:02:42.04,1:02:44.26,Default,,0,0,0,,Сахна артында жұмыс істеу дұрыс емес пе?
Dialogue: 0,1:02:44.34,1:02:46.63,Default,,0,0,0,,Бірақ менде бір мектеп бар.
Dialogue: 0,1:02:46.72,1:02:49.26,Default,,0,0,0,,- (Такамура) А, мен де толық емес жұмыс күніммен жұмыс істеймін... - (Мишима) Жақсы емес пе?
Dialogue: 0,1:02:49.34,1:02:52.76,Default,,0,0,0,,Менің де клубым бар, сондықтан көп көмектесе алмаймын.
Dialogue: 0,1:02:52.85,1:02:54.72,Default,,0,0,0,,Егер біз әрқайсымыз қолымыздан келгеннің бәрін жасасақ,
Dialogue: 0,1:02:55.31,1:02:56.81,Default,,0,0,0,,Сәлем, атқару комитетінің мүшесі
Dialogue: 0,1:02:56.89,1:02:59.56,Default,,0,0,0,,О? О, әрине
Dialogue: 0,1:02:59.65,1:03:02.15,Default,,0,0,0,,Мм, әрине, әркімнің пікірін тыңдаңыз.
Dialogue: 0,1:03:02.23,1:03:04.32,Default,,0,0,0,,Мен еңбек бөлінісі туралы шешім қабылдағым келеді.
Dialogue: 0,1:03:04.40,1:03:06.36,Default,,0,0,0,,- (Ивата) Олай болса... - (Фукусима) Иә.
Dialogue: 0,1:03:06.44,1:03:09.53,Default,,0,0,0,,Менің басқа істегім келетін нәрсе жоқ сияқты.
Dialogue: 0,1:03:09.61,1:03:11.16,Default,,0,0,0,,Әй, актерлік құрам ше?
Dialogue: 0,1:03:11.24,1:03:13.87,Default,,0,0,0,,Бұл тек басты кейіпкер үшін өте қиын болып көрінеді.
Dialogue: 0,1:03:13.95,1:03:15.29,Default,,0,0,0,,Әй, бұл келе жатқан нәрсе...
Dialogue: 0,1:03:15.37,1:03:17.46,Default,,0,0,0,,Е, Нарузе басты кейіпкер емес пе?
Dialogue: 0,1:03:17.54,1:03:18.50,Default,,0,0,0,,Уф!
Dialogue: 0,1:03:19.67,1:03:21.50,Default,,0,0,0,,Не, неге жасамайсың?
Dialogue: 0,1:03:33.80,1:03:35.18,Default,,0,0,0,,Хамф!
Dialogue: 0,1:03:36.81,1:03:39.35,Default,,0,0,0,,О~
Dialogue: 0,1:03:39.44,1:03:42.69,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:03:43.98,1:03:46.07,Default,,0,0,0,,Содан кейін ол шешілді.
Dialogue: 0,1:03:55.16,1:03:57.83,Default,,0,0,0,,«Сөзінен айырылған қызға»
Dialogue: 0,1:03:57.91,1:03:59.58,Default,,0,0,0,,«Ханзада пайда болады»
Dialogue: 0,1:04:00.08,1:04:03.21,Default,,0,0,0,,«Ханзада кездескеннен кейін, қыздың ішінде»
Dialogue: 0,1:04:04.00,1:04:06.42,Default,,0,0,0,,«Махаббат сөзі барған сайын туады».
Dialogue: 0,1:04:06.92,1:04:10.84,Default,,0,0,0,,«Бірақ қыз оны дауыстап айта алмайды».
Dialogue: 0,1:04:11.68,1:04:15.72,Default,,0,0,0,,«Бір күні ханзада өлтірілмекші болды».
Dialogue: 0,1:04:16.22,1:04:19.77,Default,,0,0,0,,«Тамаконың стратегиясына байланысты кінәлі қыз екені анықталды».
Dialogue: 0,1:04:21.56,1:04:22.69,Default,,0,0,0,,«Өйткені дауыс жоқ»
Dialogue: 0,1:04:22.77,1:04:25.27,Default,,0,0,0,,«Түсінбеушілікті шеше алмаған қыз»
Dialogue: 0,1:04:25.77,1:04:28.61,Default,,0,0,0,,«Мен ренжіткен адамдармен ұсталды»
Dialogue: 0,1:04:28.69,1:04:30.65,Default,,0,0,0,,«Орындалады»
Dialogue: 0,1:04:31.74,1:04:37.20,Default,,0,0,0,,«Ханзада қарап тұрғанда, өлім жазасына кесілген стендте қыздың басы кесілген».
Dialogue: 0,1:04:37.79,1:04:40.96,Default,,0,0,0,,«Сосын қыздың мойнынан сөз ағыла бастайды».
Dialogue: 0,1:04:41.46,1:04:44.08,Default,,0,0,0,,«Мен ханзаданы жақсы көремін»
Dialogue: 0,1:04:44.58,1:04:46.50,Default,,0,0,0,,Бұл өрескел.
Dialogue: 0,1:04:48.34,1:04:50.80,Default,,0,0,0,,Бірақ менің ойымша, бұл жаман емес, соңғысы.
Dialogue: 0,1:04:50.88,1:04:52.17,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,1:04:52.26,1:04:55.80,Default,,0,0,0,,Қыз өлген соң бәрі шындықты түсінеді, солай ма?
Dialogue: 0,1:04:55.89,1:04:58.01,Default,,0,0,0,,Ханзаданың түсінбеушілігі шешілді...
Dialogue: 0,1:04:58.10,1:05:00.02,Default,,0,0,0,,«Гонгицюне» деп аталады емес пе?
Dialogue: 0,1:05:00.10,1:05:01.98,Default,,0,0,0,,Бұл ертегіге ұқсайды.
Dialogue: 0,1:05:02.48,1:05:05.10,Default,,0,0,0,,Жақсы, бақытты аяқталды, жарай ма?
Dialogue: 0,1:05:05.61,1:05:07.61,Default,,0,0,0,,Иә, бұл рас, солай ма?
Dialogue: 0,1:05:09.94,1:05:14.66,Default,,0,0,0,,Сонда да ханзада маңызды рөл атқарады...
Dialogue: 0,1:05:15.20,1:05:16.82,Default,,0,0,0,,Мен мұны істеймін бе?
Dialogue: 0,1:05:16.91,1:05:19.54,Default,,0,0,0,,Сіз әлі адамсыз, сондықтан жақсы!
Dialogue: 0,1:05:19.62,1:05:21.62,Default,,0,0,0,,Мен жай ғана жұмыртқамын! Жұмыртқа!
Dialogue: 0,1:05:21.70,1:05:24.92,Default,,0,0,0,,А... жоқ, бұл Нарузенің кінәсі емес.
Dialogue: 0,1:05:25.00,1:05:26.92,Default,,0,0,0,,Жарайды, сүйкімді, мен сенімдімін
Dialogue: 0,1:05:27.00,1:05:29.88,Default,,0,0,0,,Сен жақсысың, сен хор мен күнәкар емессің бе?
Dialogue: 0,1:05:29.96,1:05:30.96,Default,,0,0,0,,Шындығында, мен Сиқыршылар культіне қатысты бірнеше жаңа нәрсені түсіндім
Dialogue: 0,1:05:31.55,1:05:33.67,Default,,0,0,0,,Атқару комитетінің мүшесі ретінде мен бар күшімді саламын.
Dialogue: 0,1:05:33.76,1:05:34.88,Default,,0,0,0,,Себебі мен айттым.
Dialogue: 0,1:05:35.38,1:05:37.68,Default,,0,0,0,,Нәтижесінде басты рөл
Dialogue: 0,1:05:37.76,1:05:40.77,Default,,0,0,0,,Атқарушы комитетте барлығын мәжбүрлеп жатқанына сене алмаймын...
Dialogue: 0,1:05:41.64,1:05:43.94,Default,,0,0,0,,Жұмыртқа... Жұмыртқа...
Dialogue: 0,1:05:44.02,1:05:46.10,Default,,0,0,0,,Тек бас тарт.
Dialogue: 0,1:05:46.60,1:05:47.36,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:05:47.44,1:05:50.48,Default,,0,0,0,,Нарусе тек соңғы лирика ма?
Dialogue: 0,1:05:52.61,1:05:56.41,Default,,0,0,0,,Сіз мұны айта аласыз ба? Сіз шынымен не туралы сөйлескіңіз келеді?
Dialogue: 0,1:06:01.79,1:06:02.58,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:06:04.46,1:06:05.29,Default,,0,0,0,,Уау
Dialogue: 0,1:06:06.08,1:06:08.08,Default,,0,0,0,,Жел енді суық емес.
Dialogue: 0,1:06:08.17,1:06:12.38,Default,,0,0,0,,Хмм, мұнда тамақтану қиын болуы мүмкін.
Dialogue: 0,1:06:13.80,1:06:15.84,Default,,0,0,0,,Жоғалған сөздер айқайлай бастайды
Dialogue: 0,1:06:18.14,1:06:20.93,Default,,0,0,0,,Мені жақсы көретініңді айқайлай баста
Dialogue: 0,1:06:22.97,1:06:25.10,Default,,0,0,0,,Айтпақшы, тақырып әлі шешілді ме?
Dialogue: 0,1:06:25.18,1:06:28.35,Default,,0,0,0,,А, мен бұл «Жастықтың арғы беті» екеніне сенімдімін бе?
Dialogue: 0,1:06:28.44,1:06:31.90,Default,,0,0,0,,Қарғыс атсын! Бұл мазмұнға мүлдем сәйкес келмейді.
Dialogue: 0,1:06:37.36,1:06:41.20,Default,,0,0,0,,Сәлем, сәлем, қош келдіңіз.
Dialogue: 0,1:06:41.28,1:06:42.12,Default,,0,0,0,,Таку-чан?
Dialogue: 0,1:06:42.20,1:06:43.58,Default,,0,0,0,,Иә
Dialogue: 0,1:06:43.66,1:06:47.25,Default,,0,0,0,,Кір, кір, Таку-чан, досым.
Dialogue: 0,1:06:47.33,1:06:48.08,Default,,0,0,0,,Сиқыршы культішілер.
Dialogue: 0,1:06:48.67,1:06:52.09,Default,,0,0,0,,-Ой, жарайсың. -(Тайки) Ой, кешіріңіз.
Dialogue: 0,1:06:52.17,1:06:53.80,Default,,0,0,0,,О, ерте.
Dialogue: 0,1:06:54.76,1:06:58.72,Default,,0,0,0,,Сағат 3-те кездессек, 2:50-де кездесу қалыпты.
Dialogue: 0,1:06:58.80,1:07:00.26,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:03.26,1:07:06.52,Default,,0,0,0,,О, оны ашық қалдырыңыз. Бұл жерде дыбыс өткізбейді.
Dialogue: 0,1:07:06.60,1:07:09.35,Default,,0,0,0,,О... бұл керемет
Dialogue: 0,1:07:09.44,1:07:11.69,Default,,0,0,0,,Ал, жай сандар бар.
Dialogue: 0,1:07:11.77,1:07:13.82,Default,,0,0,0,,Шешім жоқ. Мүмкін соңғы әнге сілтеме ретінде...
Dialogue: 0,1:07:13.90,1:07:16.44,Default,,0,0,0,,Мен дыбысты түсінбеймін.
Dialogue: 0,1:07:16.53,1:07:17.82,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,1:07:18.32,1:07:20.57,Default,,0,0,0,,Қалғандары ше?
Dialogue: 0,1:07:20.66,1:07:22.70,Default,,0,0,0,,Менің ойымша, Айзава және басқалары келе жатыр.
Dialogue: 0,1:07:22.78,1:07:24.03,Default,,0,0,0,,Нито мен Нарузе
Dialogue: 0,1:07:24.12,1:07:27.58,Default,,0,0,0,,Тапсырыс беруші дүкеннен кейін келуімді өтінді.
Dialogue: 0,1:07:28.29,1:07:29.79,Default,,0,0,0,,Хмм.
Dialogue: 0,1:07:31.00,1:07:34.21,Default,,0,0,0,,Түсіндім, сен Нитомен кездесіп жүрсің.
Dialogue: 0,1:07:34.30,1:07:35.96,Default,,0,0,0,,Мен көремін...
Dialogue: 0,1:07:36.63,1:07:40.93,Default,,0,0,0,,Жоқ, бұл мен орта мектепте оқып жүргенімде болды...
Dialogue: 0,1:07:41.01,1:07:42.14,Default,,0,0,0,,Кішкене солай...
Dialogue: 0,1:07:42.22,1:07:45.85,Default,,0,0,0,,Ах, Нито, дәл қазір сыртта бір адам бар сияқты.
Dialogue: 0,1:07:46.39,1:07:46.89,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:48.10,1:07:51.23,Default,,0,0,0,,А, жарайды... бір болуы керек, солай ма?
Dialogue: 0,1:07:51.31,1:07:52.19,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:07:52.27,1:07:54.77,Default,,0,0,0,,- (Иваки/Айзава) Ойнайық, Куми-кун - (Такуми) Эй, кел.
Dialogue: 0,1:07:54.86,1:07:57.19,Default,,0,0,0,,Нашар Эй, сен маған диванды жылжытуға көмектесе аласың ба?
Dialogue: 0,1:07:57.28,1:08:00.03,Default,,0,0,0,,Таку-чан, менің досым~
Dialogue: 0,1:08:00.82,1:08:02.99,Default,,0,0,0,,Барлығының жиналатын уақыты болып қалды.
Dialogue: 0,1:08:03.07,1:08:04.49,Default,,0,0,0,,Біраз асығамыз ба?
Dialogue: 0,1:08:04.99,1:08:06.95,Default,,0,0,0,,Мм, карта... иә?
Dialogue: 0,1:08:08.16,1:08:11.83,Default,,0,0,0,,Нарусе-сан, сен Сакагами-кунның үйінде болдың ба?
Dialogue: 0,1:08:13.50,1:08:14.92,Default,,0,0,0,,Мен...
Dialogue: 0,1:08:24.05,1:08:27.18,Default,,0,0,0,,Не? Сакагами-кун пианинода ойнап жатыр ма?
Dialogue: 0,1:08:28.10,1:08:29.43,Default,,0,0,0,,Я~
Dialogue: 0,1:08:31.94,1:08:32.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:37.02,1:08:38.28,Default,,0,0,0,,Достар…
Dialogue: 0,1:08:38.36,1:08:39.49,Default,,0,0,0,,Ха!
Dialogue: 0,1:08:41.61,1:08:42.32,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:44.24,1:08:45.83,Default,,0,0,0,,О, жоқ.
Dialogue: 0,1:08:45.91,1:08:48.08,Default,,0,0,0,,Нарусе мырзамен де дос болдым.
Dialogue: 0,1:08:48.16,1:08:49.33,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,1:08:52.83,1:08:55.96,Default,,0,0,0,,Мен сізді шынымен қолдағым келеді...
Dialogue: 0,1:08:59.38,1:09:05.85,Default,,0,0,0,,(«Патетик» пианиносы)
Dialogue: 0,1:09:05.93,1:09:12.69,Default,,0,0,0,,♪ Жүрек бұл
Dialogue: 0,1:09:13.27,1:09:19.07,Default,,0,0,0,,♪ Айқайлаңыз
Dialogue: 0,1:09:19.57,1:09:26.57,Default,,0,0,0,,♪ Нені айтқым келеді
Dialogue: 0,1:09:27.91,1:09:34.92,Default,,0,0,0,,♪ Мен болғандай сезінемін
Dialogue: 0,1:09:37.92,1:09:39.34,Default,,0,0,0,,Бұл...
Dialogue: 0,1:09:40.09,1:09:42.17,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:09:42.26,1:09:43.72,Default,,0,0,0,,Жаман емес.
Dialogue: 0,1:09:43.80,1:09:47.30,Default,,0,0,0,,Иә, менің ойымша, бұл соңындағы жалғыздық сезіміне сәйкес келеді.
Dialogue: 0,1:09:47.39,1:09:49.39,Default,,0,0,0,,Иваки классикалық музыка туралы айта бастағанда
Dialogue: 0,1:09:49.47,1:09:51.52,Default,,0,0,0,,Мен не істеймін деп ойладым.
Dialogue: 0,1:09:51.60,1:09:53.14,Default,,0,0,0,,Жақсы емес пе? «Қасірет»
Dialogue: 0,1:09:53.23,1:09:55.52,Default,,0,0,0,,- (Иваки) «Патетик»! - (Тайки) Бұл көп өзгермейді.
Dialogue: 0,1:09:55.60,1:09:57.73,Default,,0,0,0,,Ол өзгереді! Профессор Бетховеннен кешірім сұраңыз!
Dialogue: 0,1:09:57.81,1:09:59.11,Default,,0,0,0,,Олай болса.
Dialogue: 0,1:09:59.19,1:10:02.74,Default,,0,0,0,,Менің ойымша, бұл барлық әндер қазір шешілді дегенді білдіреді.
Dialogue: 0,1:10:05.99,1:10:08.70,Default,,0,0,0,,Жарайды, аранжировка ғана қалды.
Dialogue: 0,1:10:08.78,1:10:10.33,Default,,0,0,0,,Ән мәтіндерін реттеу қажет болуы мүмкін
Dialogue: 0,1:10:10.41,1:10:11.83,Default,,0,0,0,,Ал хореография және режиссура.
Dialogue: 0,1:10:11.91,1:10:14.08,Default,,0,0,0,,Не болса да, тағы бір сәт!
Dialogue: 0,1:10:14.16,1:10:16.58,Default,,0,0,0,,Бұл біраз уақытты алды.
Dialogue: 0,1:10:16.67,1:10:17.79,Default,,0,0,0,,Рас
Dialogue: 0,1:10:17.88,1:10:20.13,Default,,0,0,0,,Осыншама көп болғанда, сіз міндетті түрде адасып кетесіз.
Dialogue: 0,1:10:20.21,1:10:23.96,Default,,0,0,0,,Жоқ, бірақ бұл бөлме өте қызықты~
Dialogue: 0,1:10:32.35,1:10:35.60,Default,,0,0,0,,Кешіріңіз, маған көмектесуіңізді сұрауым керек еді.
Dialogue: 0,1:10:37.56,1:10:41.02,Default,,0,0,0,,А, мына кәмпиттерді анау ыдысқа сал.
Dialogue: 0,1:10:41.52,1:10:42.69,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,1:10:44.69,1:10:46.99,Default,,0,0,0,,Әй, бұрынғы ән
Dialogue: 0,1:10:49.24,1:10:52.03,Default,,0,0,0,,Таккун осылай ойнады, солай ма?
Dialogue: 0,1:10:53.29,1:10:58.54,Default,,0,0,0,,Иә...бұл ән менің балама да ұнады.
Dialogue: 0,1:10:58.62,1:11:00.88,Default,,0,0,0,,Таккун пианинода жақсы ойнайтын.
Dialogue: 0,1:11:00.96,1:11:04.42,Default,,0,0,0,,Бұрын біз сол бөлмеде отбасы болып жиналатынбыз.
Dialogue: 0,1:11:05.01,1:11:08.05,Default,,0,0,0,,Мен Таккунның пианиносын тыңдадым.
Dialogue: 0,1:11:08.13,1:11:08.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:09.26,1:11:10.39,Default,,0,0,0,,Джун Чан?
Dialogue: 0,1:11:12.05,1:11:14.97,Default,,0,0,0,,О, не болып жатыр? Ерм...
Dialogue: 0,1:11:15.06,1:11:16.27,Default,,0,0,0,,- (Такуми) Не істеп жатырсың? - (ретімен) А
Dialogue: 0,1:11:16.35,1:11:17.77,Default,,0,0,0,,О, Таккун
Dialogue: 0,1:11:17.85,1:11:18.89,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:11:18.98,1:11:19.48,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:20.40,1:11:21.15,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:29.41,1:11:32.53,Default,,0,0,0,,Менің ата-анам ажырасқан.
Dialogue: 0,1:11:33.24,1:11:35.12,Default,,0,0,0,,Көрген анам болды.
Dialogue: 0,1:11:35.74,1:11:38.96,Default,,0,0,0,,Әкем де жұмыстан қолы босамайтынын айтты.
Dialogue: 0,1:11:39.04,1:11:41.83,Default,,0,0,0,,Мені ата мен әжеге қалдырыңыз.
Dialogue: 0,1:11:41.92,1:11:44.17,Default,,0,0,0,,Жарайды, жылына бір рет жүзіңді көрсем жақсы...
Dialogue: 0,1:11:44.25,1:11:45.55,Default,,0,0,0,,Бұл Таку-чан ба?
Dialogue: 0,1:11:45.63,1:11:46.59,Default,,0,0,0,,Маған көмектесесіңдер ме?
Dialogue: 0,1:11:46.67,1:11:49.30,Default,,0,0,0,,Жоқ, жарайды, мен бірден барамын.
Dialogue: 0,1:11:56.35,1:11:58.35,Default,,0,0,0,,Ей, мазалағаным үшін кешіріңіз.
Dialogue: 0,1:11:58.43,1:12:00.85,Default,,0,0,0,,- (Иваки) Тағы кездескенше Таку-чан - (Нацуки) Мектепте
Dialogue: 0,1:12:00.94,1:12:02.52,Default,,0,0,0,,Иә, абай болыңыз.
Dialogue: 0,1:12:02.60,1:12:03.98,Default,,0,0,0,,Әй, кітап дүкеніне тоқталайық.
Dialogue: 0,1:12:04.06,1:12:07.65,Default,,0,0,0,,Бұл вокзалға баратын автобус, солай ма? Олай болса кеттік
Dialogue: 0,1:12:37.60,1:12:40.35,Default,,0,0,0,,Иә?Не?
Dialogue: 0,1:12:41.60,1:12:45.36,Default,,0,0,0,,А, дәрігер маған әлі жүгірме деді.
Dialogue: 0,1:12:45.44,1:12:47.44,Default,,0,0,0,,Мен барынша жаяу жүруге тырысамын.
Dialogue: 0,1:12:47.94,1:12:50.94,Default,,0,0,0,,Мүмкін саған менімен жүрген ұнамаған шығар?
Dialogue: 0,1:12:52.20,1:12:57.20,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,1:13:02.62,1:13:05.63,Default,,0,0,0,,Дегенмен, бұл керемет болды.
Dialogue: 0,1:13:05.71,1:13:09.63,Default,,0,0,0,,Айзава да, Иваки де керемет музыкаға ие және егжей-тегжейлі.
Dialogue: 0,1:13:10.42,1:13:13.47,Default,,0,0,0,,Сакагами фортепианода да керемет өнер көрсетті.
Dialogue: 0,1:13:13.97,1:13:18.60,Default,,0,0,0,,Менің сыныбымның адамдары да әртүрлі істерге жақсы.
Dialogue: 0,1:13:18.68,1:13:19.85,Default,,0,0,0,,Наруз да...
Dialogue: 0,1:13:25.56,1:13:29.61,Default,,0,0,0,,Ал, мен бұрын ештеңе көрмеген шығармын.
Dialogue: 0,1:13:33.82,1:13:34.36,Default,,0,0,0,,Не?
Dialogue: 0,1:13:38.87,1:13:41.04,Default,,0,0,0,,Сіз баламен айналысасыз ба?
Dialogue: 0,1:13:41.91,1:13:43.75,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,1:13:49.96,1:13:53.26,Default,,0,0,0,,Мен ештеңе көрмедім
Dialogue: 0,1:13:53.84,1:13:58.55,Default,,0,0,0,,Осындай асыл, қуанышты сөздерді алған қыз
Dialogue: 0,1:13:59.68,1:14:04.60,Default,,0,0,0,,Алайда ол ханзаданың мұңынан бейхабар еді.
Dialogue: 0,1:14:05.44,1:14:09.69,Default,,0,0,0,,Қыз ханзадаға қандай сөздер айта алады?
Dialogue: 0,1:14:15.57,1:14:17.45,Default,,0,0,0,,Иә, соңын өзгерткіңіз келе ме?
Dialogue: 0,1:14:18.78,1:14:20.16,Default,,0,0,0,,Бірақ Нарузе...
Dialogue: 0,1:14:24.50,1:14:26.79,Default,,0,0,0,,«Өлім жазасына кесілгенге дейін»
Dialogue: 0,1:14:26.87,1:14:31.09,Default,,0,0,0,,«Қыз бәрінен бас тартқан кезде, ханзада оны қорғайды».
Dialogue: 0,1:14:31.88,1:14:35.05,Default,,0,0,0,,«Ханзаданың көндіруімен халық қызды кешірді».
Dialogue: 0,1:14:35.67,1:14:36.93,Default,,0,0,0,,«Қыз бен ханзада»
Dialogue: 0,1:14:37.43,1:14:40.30,Default,,0,0,0,,«Әр адамның соңы бақытты болады»
Dialogue: 0,1:14:42.31,1:14:45.39,Default,,0,0,0,,Хмм, басқаша айтқанда, соңғы бөлікті өзгертіңіз.
Dialogue: 0,1:14:45.48,1:14:46.77,Default,,0,0,0,,Тағы бір ән қосу керек пе?
Dialogue: 0,1:14:49.44,1:14:50.69,Default,,0,0,0,,О
Dialogue: 0,1:14:50.77,1:14:54.82,Default,,0,0,0,,Байқадым, ән мәтіні де жақсы болды.
Dialogue: 0,1:14:55.44,1:14:57.40,Default,,0,0,0,,Әрине қараңғы, бірақ...
Dialogue: 0,1:14:57.49,1:15:00.41,Default,,0,0,0,,«Мен сені сүйемін деп айқайлай бастаймын» дегенді білдіре ме?
Dialogue: 0,1:15:00.95,1:15:02.91,Default,,0,0,0,,Әйтеуір, мен бұл сезімді басып жүргендей болдым
Dialogue: 0,1:15:03.62,1:15:06.58,Default,,0,0,0,,Менің ойымша, бұл өте маңызды нәрсе болуы керек...
Dialogue: 0,1:15:06.66,1:15:09.50,Default,,0,0,0,,Жарайды, бірақ бақытты аяқталу жақсы.
Dialogue: 0,1:15:09.58,1:15:10.92,Default,,0,0,0,,Бұл міндетті түрде барлығына...
Dialogue: 0,1:15:11.00,1:15:13.71,Default,,0,0,0,,- (Айдзава) Тоқта - (Иваки) Бұл не, Айзава?
Dialogue: 0,1:15:13.80,1:15:15.59,Default,,0,0,0,,Аа, мен бір жерден қателесіп қалдым ба?
Dialogue: 0,1:15:15.67,1:15:18.80,Default,,0,0,0,,- (Айзава) Жоқ, бұл дұрыс емес - (Китамура) Сонда бұл не?
Dialogue: 0,1:15:18.88,1:15:20.55,Default,,0,0,0,,- (Айзава) Ммм - (Шибуя) Айзава?
Dialogue: 0,1:15:20.64,1:15:24.26,Default,,0,0,0,,Бұл ән біз зұлым перілер туралы.
Dialogue: 0,1:15:24.35,1:15:29.23,Default,,0,0,0,,Бұл қыздарды алдап, қалаларды өртеп, барлық адамдарды өлтіру туралы ән, солай ма?
Dialogue: 0,1:15:29.31,1:15:33.32,Default,,0,0,0,,Осылай қуанып ән айту дұрыс па деп ойлаймын.
Dialogue: 0,1:15:33.40,1:15:34.82,Default,,0,0,0,,Мен осылай айтсам да...
Dialogue: 0,1:15:34.90,1:15:37.69,Default,,0,0,0,,Бұл табиғи емес пе, өйткені біз алдауға бейімбіз?
Dialogue: 0,1:15:37.78,1:15:41.03,Default,,0,0,0,,Көбінесе әннің мәтіні мен әннің мазмұнына сәйкессіздік болады.
Dialogue: 0,1:15:41.11,1:15:43.53,Default,,0,0,0,,Бұл алшақтық қызық емес пе?
Dialogue: 0,1:15:46.45,1:15:47.96,Default,,0,0,0,,Бұл өте жаман, Нарузе.
Dialogue: 0,1:15:48.54,1:15:50.62,Default,,0,0,0,,Менде бір идея болды.
Dialogue: 0,1:15:50.71,1:15:53.04,Default,,0,0,0,,Осы соңғы бөлім туралы...
Dialogue: 0,1:15:53.54,1:15:56.63,Default,,0,0,0,,А, жоқ, бақытты аяқталуымен келісемін.
Dialogue: 0,1:15:57.38,1:16:01.22,Default,,0,0,0,,Мен бастапқы аяқталудың атмосферасы қаншалықты жақсы болды деп ойладым.
Dialogue: 0,1:16:02.97,1:16:04.97,Default,,0,0,0,,Ал...
Dialogue: 0,1:16:06.85,1:16:08.39,Default,,0,0,0,,Бақытты
Dialogue: 0,1:16:09.77,1:16:13.19,Default,,0,0,0,,Бақытты... Мм.
Dialogue: 0,1:16:14.77,1:16:15.98,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:17.44,1:16:24.45,Default,,0,0,0,,Өткен күні сабақта естігенім
Dialogue: 0,1:16:28.04,1:16:35.04,Default,,0,0,0,,(«Pathétique» әуені қабаттасады)
Dialogue: 0,1:16:39.59,1:16:42.43,Default,,0,0,0,,О, өте жақсы жарасады... иә?
Dialogue: 0,1:16:44.64,1:16:46.51,Default,,0,0,0,,Бұл мен бұрыннан көрген мюзикл болатын.
Dialogue: 0,1:16:47.01,1:16:50.60,Default,,0,0,0,,Екі мүлде басқа әннің қосылып айтылатын кездері болады.
Dialogue: 0,1:16:51.10,1:16:52.56,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,1:16:53.23,1:16:56.06,Default,,0,0,0,,Айзава мен басқаларды тыңдап, есіме түсті.
Dialogue: 0,1:16:57.86,1:17:01.11,Default,,0,0,0,,Мұны да маған әкем үйретті.
Dialogue: 0,1:17:01.74,1:17:03.99,Default,,0,0,0,,Кешегі әңгіме жарымжан болды.
Dialogue: 0,1:17:04.49,1:17:07.28,Default,,0,0,0,,Ата-анам, мен орта мектепті бітіргенге дейін.
Dialogue: 0,1:17:08.16,1:17:09.79,Default,,0,0,0,,Біз көп қиындық көрдік.
Dialogue: 0,1:17:10.37,1:17:12.91,Default,,0,0,0,,Мені жеке мектепке жібергісі келетін анама
Dialogue: 0,1:17:13.00,1:17:15.71,Default,,0,0,0,,Ол кезде мен фортепианоға құмар едім, бірақ оған қарсы шықтым.
Dialogue: 0,1:17:16.21,1:17:18.84,Default,,0,0,0,,Әкем мені қорғады... немесе сол сияқты.
Dialogue: 0,1:17:19.34,1:17:21.72,Default,,0,0,0,,Соңында мен жай ғана мемлекеттік мектепке бардым.
Dialogue: 0,1:17:21.80,1:17:25.01,Default,,0,0,0,,Осыдан кейін ата-анамның қарым-қатынасы нашарлай берді.
Dialogue: 0,1:17:26.30,1:17:28.56,Default,,0,0,0,,Сол жерден, кеше айтқанымдай
Dialogue: 0,1:17:29.06,1:17:31.35,Default,,0,0,0,,Менің өзімшілдігім себеп болғанымен
Dialogue: 0,1:17:31.85,1:17:35.02,Default,,0,0,0,,Мен ештеңе істей алмаймын, ештеңе айта алмаймын
Dialogue: 0,1:17:35.52,1:17:39.82,Default,,0,0,0,,Мен кінәлі деп ойлаған кезде, тіпті фортепианоға қол тигізуге де қорықтым.
Dialogue: 0,1:17:43.36,1:17:43.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:45.28,1:17:48.45,Default,,0,0,0,,Хмм... Сосын Нарузенің үйі туралы.
Dialogue: 0,1:17:49.16,1:17:51.66,Default,,0,0,0,,Сенің кінәң екеніне сене алар емеспін.
Dialogue: 0,1:17:52.45,1:17:54.21,Default,,0,0,0,,Мен солай екеніне сенімдімін.
Dialogue: 0,1:17:54.29,1:17:58.84,Default,,0,0,0,,Бірдеңе... біреу 100% жаман немесе жақсы емес.
Dialogue: 0,1:17:58.92,1:18:00.50,Default,,0,0,0,,Мен ондай нәрсе жоқ екеніне сенімдімін.
Dialogue: 0,1:18:01.96,1:18:04.09,Default,,0,0,0,,Сонымен не айтқыңыз келеді?
Dialogue: 0,1:18:04.17,1:18:05.88,Default,,0,0,0,,Екеуінің де соңғысы
Dialogue: 0,1:18:05.97,1:18:08.85,Default,,0,0,0,,Нарусе шынымен не туралы айтқысы келеді?
Dialogue: 0,1:18:08.93,1:18:13.56,Default,,0,0,0,,Осы екі нәрсені де жеткізе алсам ғой.
Dialogue: 0,1:18:14.35,1:18:15.98,Default,,0,0,0,,Мен ойладым...
Dialogue: 0,1:18:16.48,1:18:17.23,Default,,0,0,0,,А…?
Dialogue: 0,1:18:19.19,1:18:21.27,Default,,0,0,0,,Кенеттен татами төсегі жарылып кетті.
Dialogue: 0,1:18:22.15,1:18:22.90,Default,,0,0,0,,Наруз?
Dialogue: 0,1:18:27.20,1:18:27.86,Default,,0,0,0,,А…?
Dialogue: 0,1:18:49.59,1:18:52.93,Default,,0,0,0,,Менің... ханзадасым
Dialogue: 0,1:19:53.62,1:19:56.58,Default,,0,0,0,,Ах~ Нақты нәрсе ертең.
Dialogue: 0,1:19:56.66,1:19:58.79,Default,,0,0,0,,Ән мәтіні мені әлі мазалап жүрсе де.
Dialogue: 0,1:19:58.87,1:20:00.21,Default,,0,0,0,,Мен де
Dialogue: 0,1:20:00.29,1:20:02.29,Default,,0,0,0,,Ей, мен әлі де барлық нәрсеге алаңдап тұрмын.
Dialogue: 0,1:20:02.38,1:20:03.96,Default,,0,0,0,,Дұрыс~ О!
Dialogue: 0,1:20:04.04,1:20:05.42,Default,,0,0,0,,Қайырлы таң, Сакагами
Dialogue: 0,1:20:05.50,1:20:07.84,Default,,0,0,0,,-(Такуми) Жарайды, ерте. -(Uno) Жарайды.
Dialogue: 0,1:20:07.92,1:20:10.38,Default,,0,0,0,,Ах Нито, гимназияны күндіз пайдалануға рұқсат...
Dialogue: 0,1:20:10.47,1:20:13.09,Default,,0,0,0,,Аа, дұрыс. Кешіріңіз, мен бірден келемін.
Dialogue: 0,1:20:13.18,1:20:14.05,Default,,0,0,0,,- (Уно) А, Нацуки! -(Такуми) А?
Dialogue: 0,1:20:14.14,1:20:16.52,Default,,0,0,0,,-(Уно) Сәл күте тұрыңыз~ -(Такуми) Жоқ, мен де...
Dialogue: 0,1:20:50.42,1:20:51.72,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:20:52.51,1:20:55.18,Default,,0,0,0,,Дайындық Барлық бөліктер орындалды!
Dialogue: 0,1:20:55.26,1:20:59.89,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:20:59.98,1:21:02.44,Default,,0,0,0,,Жарайды, уақыт келді.
Dialogue: 0,1:21:02.52,1:21:04.15,Default,,0,0,0,,Тез жинап, үйге қайт.
Dialogue: 0,1:21:04.23,1:21:05.31,Default,,0,0,0,,Эх!
Dialogue: 0,1:21:05.40,1:21:06.82,Default,,0,0,0,,«eh» емес
Dialogue: 0,1:21:06.90,1:21:09.15,Default,,0,0,0,,Ертең бірінші курс сахнаны пайдаланады.
Dialogue: 0,1:21:09.23,1:21:10.94,Default,,0,0,0,,Дұрыс тазалаңыз.
Dialogue: 0,1:21:11.44,1:21:12.86,Default,,0,0,0,,-(Такуми) Ал, көрейік. -(Тайки) Болды.
Dialogue: 0,1:21:13.49,1:21:14.99,Default,,0,0,0,,Ал, үлкенінен бастайық...
Dialogue: 0,1:21:15.07,1:21:16.32,Default,,0,0,0,,Эй!
Dialogue: 0,1:21:16.91,1:21:19.08,Default,,0,0,0,,Мен ауыр жүк көтерушілерді әкелдім!
Dialogue: 0,1:21:19.16,1:21:20.79,Default,,0,0,0,,Иккун!
Dialogue: 0,1:21:21.66,1:21:22.87,Default,,0,0,0,,Бұл солтүстік-батырдағы қала ма?
Dialogue: 0,1:21:23.58,1:21:24.92,Default,,0,0,0,,Мұны қайда апаруым керек?
Dialogue: 0,1:21:25.00,1:21:27.79,Default,,0,0,0,,Ол нәзік, сондықтан абай болыңыз.
Dialogue: 0,1:21:28.55,1:21:30.84,Default,,0,0,0,,-(Тайки) Ой... -(Ямадзи) Мен аламын.
Dialogue: 0,1:21:31.72,1:21:32.97,Default,,0,0,0,,О, бұл жаман.
Dialogue: 0,1:21:33.05,1:21:35.84,Default,,0,0,0,,Мүлдем емес, жақсы ма?
Dialogue: 0,1:21:35.93,1:21:39.43,Default,,0,0,0,,Иә? Ах, ақыры дәрігер рұқсат берді.
Dialogue: 0,1:21:39.93,1:21:42.60,Default,,0,0,0,,Келесі аптадан бастап жаттығуға келуге болады.
Dialogue: 0,1:21:43.98,1:21:46.40,Default,,0,0,0,,Тағы сәл күтіңіз.
Dialogue: 0,1:21:47.81,1:21:48.61,Default,,0,0,0,,Құдайлар
Dialogue: 0,1:21:48.69,1:21:52.19,Default,,0,0,0,,Ах, Нацуки, егер сіз сыныпқа қайтатын болсаңыз, мұны да жасаңыз.
Dialogue: 0,1:21:52.28,1:21:54.45,Default,,0,0,0,,Не? Бір минут күте тұрыңыз...
Dialogue: 0,1:21:54.53,1:21:56.99,Default,,0,0,0,,Сонымен, Сакагами, сен де келесің бе?
Dialogue: 0,1:21:57.07,1:21:57.57,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:57.66,1:21:58.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:00.66,1:22:02.70,Default,,0,0,0,,Эй... Сәлем Нито
Dialogue: 0,1:22:05.21,1:22:08.46,Default,,0,0,0,,Әй, соңғы кездері біртүрлі болып қалған жоқ па?
Dialogue: 0,1:22:09.63,1:22:10.75,Default,,0,0,0,,Не?
Dialogue: 0,1:22:10.84,1:22:12.84,Default,,0,0,0,,Бұл не...
Dialogue: 0,1:22:13.51,1:22:15.30,Default,,0,0,0,,Ерекше ештеңе жоқ! Уф...
Dialogue: 0,1:22:15.38,1:22:17.22,Default,,0,0,0,,Не?
Dialogue: 0,1:22:17.76,1:22:19.35,Default,,0,0,0,,ше? Ах...
Dialogue: 0,1:22:24.68,1:22:27.10,Default,,0,0,0,,Соны істегеннен кейін сен жаман қызсың.
Dialogue: 0,1:22:27.19,1:22:29.23,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,1:22:29.31,1:22:32.57,Default,,0,0,0,,Соңғы кездері дайындыққа байланысты екеуміз оңаша қала алмай жүрміз.
Dialogue: 0,1:22:32.65,1:22:35.61,Default,,0,0,0,,Сондықтан мен осындай жердемін...
Dialogue: 0,1:22:37.66,1:22:40.74,Default,,0,0,0,,Қазірдің өзінде! Мынау қарбалас уақытта бұл не?
Dialogue: 0,1:22:40.83,1:22:42.66,Default,,0,0,0,,Қанша кездессек те,
Dialogue: 0,1:22:42.74,1:22:45.25,Default,,0,0,0,,Бірақ... сенің мектепте мұндай нәрсе жасағаныңа сене алар емеспін...
Dialogue: 0,1:22:45.33,1:22:46.54,Default,,0,0,0,,Біз кездесіп жатырмыз...
Dialogue: 0,1:22:47.21,1:22:47.75,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:48.75,1:22:50.09,Default,,0,0,0,,Жоқ
Dialogue: 0,1:22:50.59,1:22:53.84,Default,,0,0,0,,Нитоның да кездесіп жүрген адамы бар.
Dialogue: 0,1:22:55.42,1:22:56.59,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:22:56.68,1:23:00.55,Default,,0,0,0,,Аа, сәл бұрын Тасакиден...
Dialogue: 0,1:23:01.76,1:23:03.06,Default,,0,0,0,,Нито?
Dialogue: 0,1:23:03.64,1:23:04.18,Default,,0,0,0,,Ах
Dialogue: 0,1:23:05.73,1:23:07.77,Default,,0,0,0,,- (Такуми) Нито... - (Нацуки) Келме!
Dialogue: 0,1:23:09.02,1:23:12.98,Default,,0,0,0,,Бірақ сен жыладың...
Dialogue: 0,1:23:16.65,1:23:17.82,Default,,0,0,0,,Сәлем Нито
Dialogue: 0,1:23:17.90,1:23:19.32,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:23:20.16,1:23:23.70,Default,,0,0,0,,Жетеді, қалғаны маған байланысты.
Dialogue: 0,1:23:23.79,1:23:27.54,Default,,0,0,0,,Мұны қалдыр да, Нарусе-санмен бірге тез жүр.
Dialogue: 0,1:23:28.04,1:23:31.33,Default,,0,0,0,,Не? Неліктен Нарузаның есімі сонда кездеседі?
Dialogue: 0,1:23:31.42,1:23:33.25,Default,,0,0,0,,Өйткені бұл сізге ұнайды, солай ма?
Dialogue: 0,1:23:33.34,1:23:34.75,Default,,0,0,0,,Нарусе мырза туралы
Dialogue: 0,1:23:35.26,1:23:37.47,Default,,0,0,0,,Тоқта... сәл күте тұрыңыз, бұл не!
Dialogue: 0,1:23:38.38,1:23:42.10,Default,,0,0,0,,Маған Нарузе немесе басқа нәрсе ұнамайды!
Dialogue: 0,1:23:44.68,1:23:46.10,Default,,0,0,0,,Не? Өйткені...
Dialogue: 0,1:23:46.18,1:23:48.64,Default,,0,0,0,,Сіз Нарусе-санға қатты көңіл бөлесіз!
Dialogue: 0,1:23:48.73,1:23:50.19,Default,,0,0,0,,О, мен қоңырау шалып жатырмын.
Dialogue: 0,1:23:50.77,1:23:55.73,Default,,0,0,0,,Бірақ мен не айтамын... Бұрын да айтқанмын!
Dialogue: 0,1:23:55.82,1:23:58.99,Default,,0,0,0,,Нарусе: Сен өте жақсы істеп жатырсың, мен сені қолдағым келеді.
Dialogue: 0,1:23:59.07,1:24:00.61,Default,,0,0,0,,Сізге ұнайтыны осы емес пе?
Dialogue: 0,1:24:00.70,1:24:02.41,Default,,0,0,0,,Сондықтан ол басқаша!
Dialogue: 0,1:24:02.49,1:24:05.41,Default,,0,0,0,,Біреудің сезімін бағалауға қалай дәтің бар?
Dialogue: 0,1:24:05.91,1:24:08.12,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,1:24:08.20,1:24:10.50,Default,,0,0,0,,Сакагами-кунның сезімдері мүлде...
Dialogue: 0,1:24:12.63,1:24:13.88,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:24:15.34,1:24:16.63,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,1:24:17.13,1:24:20.13,Default,,0,0,0,,Ойыңыздағыны айтуыңыз керек
Dialogue: 0,1:24:21.55,1:24:22.55,Default,,0,0,0,,Мен...
Dialogue: 0,1:24:24.55,1:24:25.81,Default,,0,0,0,,Мен өкіндім.
Dialogue: 0,1:24:25.89,1:24:29.77,Default,,0,0,0,,Сол сәт... Нито маған қол созуға тырысты.
Dialogue: 0,1:24:29.85,1:24:31.56,Default,,0,0,0,,Мен оны білдім
Dialogue: 0,1:24:31.64,1:24:34.06,Default,,0,0,0,,Мен өз еркіммен ештеңе істемегенмін.
Dialogue: 0,1:24:34.56,1:24:37.48,Default,,0,0,0,,Ендеше Нарузенің тынымсыз еңбек етіп жатқанын қараңыз.
Dialogue: 0,1:24:37.57,1:24:40.45,Default,,0,0,0,,Мен... келесі жолы мен де!
Dialogue: 0,1:24:40.53,1:24:41.65,Default,,0,0,0,,(Нишики) Бұл... осы туралы сұрауға мен дұрыс адаммын ба?
Dialogue: 0,1:24:42.70,1:24:46.16,Default,,0,0,0,,Осыдан кейін қарым-қатынасымыз бұлыңғыр болды.
Dialogue: 0,1:24:46.66,1:24:49.33,Default,,0,0,0,,Бірақ мен бұл жақсы деп ойладым.
Dialogue: 0,1:24:49.83,1:24:54.08,Default,,0,0,0,,Менен сұрасаң, дауыстап айтсам, шынымен бітеді.
Dialogue: 0,1:24:54.92,1:24:56.04,Default,,0,0,0,,<Эрен басынан бері мүлде өзгерген жоқ. ➡
Dialogue: 0,1:24:56.13,1:25:00.09,Default,,0,0,0,,Сонымен... онда кіммен кездесіп жүрсің...
Dialogue: 0,1:25:00.17,1:25:02.63,Default,,0,0,0,,Бірақ бұл жұмыс істемеді.
Dialogue: 0,1:25:03.22,1:25:05.26,Default,,0,0,0,,Мен мұны істемеуім керек екенін түсіндім.
Dialogue: 0,1:25:05.76,1:25:07.97,Default,,0,0,0,,Сондықтан мен сені қолдаймын...
Dialogue: 0,1:25:08.06,1:25:08.56,Default,,0,0,0,,Нито…
Dialogue: 0,1:25:08.64,1:25:09.85,Default,,0,0,0,,Ах
Dialogue: 0,1:25:13.98,1:25:16.82,Default,,0,0,0,,Кеттік, барлығы күтіп тұр.
Dialogue: 0,1:25:17.32,1:25:17.82,Default,,0,0,0,,Нито…
Dialogue: 0,1:25:17.90,1:25:20.74,Default,,0,0,0,,Кешіріңіз, мен оны енді естігім келмейді.
Dialogue: 0,1:25:22.61,1:25:23.53,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:25:24.28,1:25:27.33,Default,,0,0,0,,Фортепиано Мен оны қайта естігеніме қуаныштымын.
Dialogue: 0,1:25:35.25,1:25:37.71,Default,,0,0,0,,- (Сузуки) Иә? - (Тайки) А? Не болды?
Dialogue: 0,1:25:37.79,1:25:40.96,Default,,0,0,0,,Мен Нарусе-саннан сұраған сөмке осындай жерден табылды
Dialogue: 0,1:25:41.05,1:25:42.92,Default,,0,0,0,,ше? Нарузе ше?
Dialogue: 0,1:25:43.42,1:25:45.39,Default,,0,0,0,,Менің шұғыл жұмысым бар сияқты...
Dialogue: 0,1:25:47.10,1:25:52.93,Default,,0,0,0,,(Джунның ауыр тыныс алуы)
Dialogue: 0,1:25:53.52,1:25:55.69,Default,,0,0,0,,Ааааа!
Dialogue: 0,1:25:58.40,1:25:58.98,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:00.86,1:26:03.19,Default,,0,0,0,,(Изуку) Ах! (Гран Торино) Уа!
Dialogue: 0,1:26:06.61,1:26:09.66,Default,,0,0,0,,Бұл... ауырады... Уф!
Dialogue: 0,1:26:10.24,1:26:11.12,Default,,0,0,0,,Ауырды...
Dialogue: 0,1:26:12.00,1:26:15.08,Default,,0,0,0,,Ой! ол аурады! Ауырды...
Dialogue: 0,1:26:15.71,1:26:17.21,Default,,0,0,0,,Бұл сіздің асқазаныңыз емес.
Dialogue: 0,1:26:17.29,1:26:18.08,Default,,0,0,0,,Ха
Dialogue: 0,1:26:20.46,1:26:22.26,Default,,0,0,0,,Бұл кеудені ауыртады
Dialogue: 0,1:26:23.55,1:26:25.51,Default,,0,0,0,,Бұл жастық азабы.
Dialogue: 0,1:26:26.09,1:26:27.97,Default,,0,0,0,,Мөрді бұзған саған
Dialogue: 0,1:26:28.60,1:26:30.68,Default,,0,0,0,,Сөйлеспеймін! Шамамен...
Dialogue: 0,1:26:30.76,1:26:32.97,Default,,0,0,0,,Сөйлеме.
Dialogue: 0,1:26:33.77,1:26:36.06,Default,,0,0,0,,Бұл жай сөз емес
Dialogue: 0,1:26:37.52,1:26:40.44,Default,,0,0,0,,Жүрегің тым көп сөйлейді.
Dialogue: 0,1:26:41.86,1:26:46.49,Default,,0,0,0,,Мен сүйемін, сүйемін, сүйемін, сүйемін, Такуми Сакагами...
Dialogue: 0,1:26:46.57,1:26:48.24,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,1:26:48.91,1:26:53.66,Default,,0,0,0,,Қараңызшы, сіздің жұмыртқаңыз сызаттарға толы.
Dialogue: 0,1:26:54.29,1:26:56.54,Default,,0,0,0,,Аа, шығып жатыр.
Dialogue: 0,1:26:57.21,1:27:01.25,Default,,0,0,0,,Мөлдір ақ, жартылай ұшқан сары...
Dialogue: 0,1:27:01.75,1:27:03.76,Default,,0,0,0,,Сенен көңілім қалды.
Dialogue: 0,1:27:04.55,1:27:08.22,Default,,0,0,0,,Өзімізді жартылай шектеуді доғарайық.
Dialogue: 0,1:27:09.14,1:27:11.51,Default,,0,0,0,,Енді, ақырында...
Dialogue: 0,1:27:14.85,1:27:16.64,Default,,0,0,0,,Бұл араластырылған жұмыртқа.
Dialogue: 0,1:27:40.12,1:27:42.04,Default,,0,0,0,,Осындай уақытта қар жауады ма?
Dialogue: 0,1:27:42.13,1:27:43.75,Default,,0,0,0,,Жоқ, мен шыдамсыз болдым.
Dialogue: 0,1:27:52.01,1:27:53.89,Default,,0,0,0,,Эй, сен оны әлі таппайсың ба? Нарусе мырза
Dialogue: 0,1:27:53.97,1:27:56.43,Default,,0,0,0,,Жоқ, басқа ешкімнен естіген жоқпын.
Dialogue: 0,1:27:56.52,1:27:58.98,Default,,0,0,0,,Мектеп ішінде мен сені енді іздемеймін.
Dialogue: 0,1:27:59.06,1:28:02.11,Default,,0,0,0,,Жолда жүрген адамдардан ешқандай байланыс алған жоқпын.
Dialogue: 0,1:28:02.19,1:28:03.77,Default,,0,0,0,,Сіз шынымен мектепке барасыз ба?
Dialogue: 0,1:28:03.86,1:28:06.07,Default,,0,0,0,,Бірақ шкафта аяқ киімдер болды.
Dialogue: 0,1:28:06.15,1:28:07.24,Default,,0,0,0,,Сакагами Сіздің ұялы телефоныңыз ше?
Dialogue: 0,1:28:07.32,1:28:09.40,Default,,0,0,0,,Жоқ, қосыла алмаймын, жауап беру құрылғысы жоқ...
Dialogue: 0,1:28:09.49,1:28:10.53,Default,,0,0,0,,Ах
Dialogue: 0,1:28:11.66,1:28:12.41,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:13.95,1:28:14.45,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:28:14.53,1:28:16.83,Default,,0,0,0,,Батыр ана бола алмаймын дегеніңіз не?
Dialogue: 0,1:28:16.91,1:28:18.79,Default,,0,0,0,,Неліктен кенеттен...
Dialogue: 0,1:28:18.87,1:28:20.83,Default,,0,0,0,,Жоқ, осы жерден...
Dialogue: 0,1:28:20.92,1:28:21.79,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:28:21.87,1:28:23.58,Default,,0,0,0,,Батырсыз басталуы мүмкін емес
Dialogue: 0,1:28:23.67,1:28:26.30,Default,,0,0,0,,Нарусе-сан, сен кеше шұғыл бірдеңе айттың.
Dialogue: 0,1:28:26.38,1:28:28.17,Default,,0,0,0,,Байланыстың қандай да бір түрі бар ма?
Dialogue: 0,1:28:29.13,1:28:31.43,Default,,0,0,0,,Дұрыс, балалар кеше сабаққа бардыңдар.
Dialogue: 0,1:28:31.51,1:28:32.84,Default,,0,0,0,,Нарузені кездестірмедің бе?
Dialogue: 0,1:28:32.93,1:28:34.51,Default,,0,0,0,,Не? Кеше?
Dialogue: 0,1:28:34.60,1:28:36.93,Default,,0,0,0,,Сіз жүктеріңізді сыныпқа әкелдіңіз бе?
Dialogue: 0,1:28:37.02,1:28:39.10,Default,,0,0,0,,Бұл кезде Нарусе де сөмкесін алуға кетті...
Dialogue: 0,1:28:39.18,1:28:41.23,Default,,0,0,0,,Не? Сол кезде...
Dialogue: 0,1:28:42.60,1:28:44.48,Default,,0,0,0,,Сонда бұл шу ше...
Dialogue: 0,1:28:45.40,1:28:47.53,Default,,0,0,0,,Нарусе-сан менен сұрады...
Dialogue: 0,1:28:47.61,1:28:49.49,Default,,0,0,0,,Сізден сұралды ма? Не?
Dialogue: 0,1:28:49.99,1:28:50.49,Default,,0,0,0,,Эй!
Dialogue: 0,1:28:51.40,1:28:52.70,Default,,0,0,0,,Бұл...
Dialogue: 0,1:28:54.99,1:28:56.83,Default,,0,0,0,,- (Шимизу) Нарузе келді ме? -(Фукусима) Мектептің сыртына қарадым...
Dialogue: 0,1:28:56.91,1:29:00.29,Default,,0,0,0,,Балалар, осындай маңызды уақытта не істеп жатырсыңдар?
Dialogue: 0,1:29:00.37,1:29:01.46,Default,,0,0,0,,Эй, Дай Чан...
Dialogue: 0,1:29:01.54,1:29:04.67,Default,,0,0,0,,Бірақ... бірақ бұл себеп болды ма деп ойлаймын?
Dialogue: 0,1:29:04.75,1:29:08.46,Default,,0,0,0,,Нарузе мен туралы бірдеңе деді...
Dialogue: 0,1:29:08.55,1:29:09.42,Default,,0,0,0,,Сіз!
Dialogue: 0,1:29:10.88,1:29:12.93,Default,,0,0,0,,Сіз мұны жасадыңыз ...
Dialogue: 0,1:29:17.72,1:29:20.02,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,1:29:20.10,1:29:21.02,Default,,0,0,0,,Нацуки...
Dialogue: 0,1:29:21.10,1:29:23.23,Default,,0,0,0,,Не? Басқаша айтқанда...
Dialogue: 0,1:29:23.31,1:29:24.94,Default,,0,0,0,,Нәпсінің шырмауы деген не?
Dialogue: 0,1:29:25.02,1:29:27.44,Default,,0,0,0,,- (Акедагава) Бұл не? - (Сайто) Сол себепті келмейсің бе?
Dialogue: 0,1:29:27.52,1:29:28.65,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:29:28.73,1:29:29.94,Default,,0,0,0,,Бұл мүмкін емес емес пе?
Dialogue: 0,1:29:30.03,1:29:32.99,Default,,0,0,0,,Дайындық үшін бәріміз көп жұмыс жасадық.
Dialogue: 0,1:29:33.61,1:29:35.49,Default,,0,0,0,,Бұл біраз өрескел, солай емес пе, Нарусе-сан?
Dialogue: 0,1:29:35.57,1:29:37.49,Default,,0,0,0,,- (Такуми) Әй... - (Тайки) Эй
Dialogue: 0,1:29:37.58,1:29:39.74,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:29:41.95,1:29:43.04,Default,,0,0,0,,Мен...
Dialogue: 0,1:29:44.54,1:29:48.67,Default,,0,0,0,,Эй, мен бұл Нарузаның үйі екенін білдім. Ешкім шықпады... Не?
Dialogue: 0,1:29:48.75,1:29:51.88,Default,,0,0,0,,- (Шимизу) Жоқ, білмеймін... - (Такуми) Барлығы, кешіріңіздер!
Dialogue: 0,1:29:53.55,1:29:56.01,Default,,0,0,0,,Не? Такудың кешірім сұрауында ерекше ештеңе жоқ...
Dialogue: 0,1:29:56.09,1:29:57.51,Default,,0,0,0,,Біз оны айта бастадық
Dialogue: 0,1:29:58.18,1:30:01.18,Default,,0,0,0,,Біз осы уақытқа дейін барлығының ынтымақтастығымен келдік...
Dialogue: 0,1:30:02.48,1:30:06.44,Default,,0,0,0,,Нарусе мұның бәрін жоюға тырысады.
Dialogue: 0,1:30:06.94,1:30:10.32,Default,,0,0,0,,Менің ойымша, бұл өте қорқынышты сатқындық.
Dialogue: 0,1:30:10.98,1:30:14.24,Default,,0,0,0,,Бірақ мен әлі де үмітсізмін...
Dialogue: 0,1:30:15.32,1:30:17.20,Default,,0,0,0,,Сөйлессем ішім ауырады.
Dialogue: 0,1:30:17.28,1:30:20.24,Default,,0,0,0,,Мен оны бақылап тұрғандықтан, күштеп кетсем де, бар күшімді салдым.
Dialogue: 0,1:30:20.83,1:30:22.04,Default,,0,0,0,,Сонымен
Dialogue: 0,1:30:22.54,1:30:25.12,Default,,0,0,0,,Мен оның сахнада тұрғанын қалаймын!
Dialogue: 0,1:30:27.04,1:30:31.38,Default,,0,0,0,,Жарайды, Нарусе, біз көп жұмыс істегенімізді білемін.
Dialogue: 0,1:30:31.88,1:30:33.76,Default,,0,0,0,,Бірақ ол іс жүзінде келмейді...
Dialogue: 0,1:30:34.26,1:30:35.09,Default,,0,0,0,,Иә
Dialogue: 0,1:30:35.59,1:30:38.22,Default,,0,0,0,,Сондықтан мен сені іздеуге рұқсат беруіңді қалаймын.
Dialogue: 0,1:30:38.30,1:30:39.01,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:39.10,1:30:40.81,Default,,0,0,0,,Әй, сен не айтып тұрсың?
Dialogue: 0,1:30:40.89,1:30:43.60,Default,,0,0,0,,Ол еңістің басына дейін кеткен соң, енді не істейсің?
Dialogue: 0,1:30:44.39,1:30:45.35,Default,,0,0,0,,Иваки
Dialogue: 0,1:30:45.43,1:30:48.52,Default,,0,0,0,,Сіз барлық әндерді жаздыңыз, сондықтан сіз барлық әндерді айта аласыз, солай ма?
Dialogue: 0,1:30:48.60,1:30:50.19,Default,,0,0,0,,Ал...
Dialogue: 0,1:30:50.27,1:30:52.61,Default,,0,0,0,,Олай болса, Сакагами қайтып келгенше ханзададан сұраймын.
Dialogue: 0,1:30:52.69,1:30:53.82,Default,,0,0,0,,- (Иваки) Иә? -(Тайки) Нито
Dialogue: 0,1:30:53.90,1:30:54.61,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:55.11,1:30:56.99,Default,,0,0,0,,Сіз оны Нарузе үшін хореография жасадыңыз.
Dialogue: 0,1:30:57.07,1:30:58.41,Default,,0,0,0,,Сіздің де ән есіңізде, солай ма?
Dialogue: 0,1:30:58.91,1:31:00.37,Default,,0,0,0,,Мен сізден Нарузені ауыстыруыңызды сұраймын.
Dialogue: 0,1:31:00.45,1:31:01.91,Default,,0,0,0,,Мен... Мен?
Dialogue: 0,1:31:01.99,1:31:04.12,Default,,0,0,0,,Бастапқыда ол тек бір рет пайда болды.
Dialogue: 0,1:31:04.20,1:31:05.20,Default,,0,0,0,,Бұл қалай да болады.
Dialogue: 0,1:31:05.29,1:31:06.25,Default,,0,0,0,,Ух... иә
Dialogue: 0,1:31:06.33,1:31:08.67,Default,,0,0,0,,Иваки де перілер мен ханзадаларды араластырмайды.
Dialogue: 0,1:31:08.75,1:31:10.84,Default,,0,0,0,,-(Иваки) Жарайды... Жарайды -(Такуми) Тасаки...
Dialogue: 0,1:31:10.92,1:31:11.79,Default,,0,0,0,,Мен де сенен сұрайын!
Dialogue: 0,1:31:12.80,1:31:15.55,Default,,0,0,0,,Нарузеге мүмкіндік беріңіз!
Dialogue: 0,1:31:16.26,1:31:17.18,Default,,0,0,0,,Дәл осылай!
Dialogue: 0,1:31:17.68,1:31:20.72,Default,,0,0,0,,Мен... Мен де бар күшімді саламын.
Dialogue: 0,1:31:20.80,1:31:23.10,Default,,0,0,0,,Мен Нацуки сияқты билейтін боламын!
Dialogue: 0,1:31:23.18,1:31:24.77,Default,,0,0,0,,Протон түзілу өзгерістері
Dialogue: 0,1:31:24.85,1:31:25.56,Default,,0,0,0,,Көрсетші.
Dialogue: 0,1:31:25.64,1:31:26.43,Default,,0,0,0,,Иә!
Dialogue: 0,1:31:26.52,1:31:27.44,Default,,0,0,0,,Иваки
Dialogue: 0,1:31:27.52,1:31:29.81,Default,,0,0,0,,Сенімсіз болсаң, мен ханзада бола аламын.
Dialogue: 0,1:31:29.90,1:31:31.61,Default,,0,0,0,,Айзава костюмге сәйкес келмеді.
Dialogue: 0,1:31:31.69,1:31:32.82,Default,,0,0,0,,Эй
Dialogue: 0,1:31:34.03,1:31:35.03,Default,,0,0,0,,Кимоноым шаңмен кірленді.
Dialogue: 0,1:31:39.78,1:31:41.66,Default,,0,0,0,,Күте тұрыңыз, Нарузе!
Dialogue: 0,1:31:59.13,1:32:02.05,Default,,0,0,0,,О, Нарузе мырза
Dialogue: 0,1:32:03.39,1:32:06.43,Default,,0,0,0,,Мен бірінші курсты бітірдім.
Dialogue: 0,1:32:06.52,1:32:08.98,Default,,0,0,0,,Қаласаңыз, қасыңызда бос орын бар.
Dialogue: 0,1:32:10.10,1:32:10.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:32:10.90,1:32:13.81,Default,,0,0,0,,А, Сакагами?
Dialogue: 0,1:32:13.90,1:32:15.52,Default,,0,0,0,,Кешіріңіз, Нарузе бұл жерде әлі жоқ...
Dialogue: 0,1:32:15.61,1:32:18.24,Default,,0,0,0,,Әй, менің алдыма келген Тасакиден хабар емес.
Dialogue: 0,1:32:19.11,1:32:23.28,Default,,0,0,0,,Аудиторияда Нарусенің анасы бар деп естідім...
Dialogue: 0,1:32:24.91,1:32:26.70,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,1:32:26.79,1:32:29.41,Default,,0,0,0,,Рахмет, мен оны тапқан бойда сонда боламын.
Dialogue: 0,1:32:30.16,1:32:31.37,Default,,0,0,0,,Иә
Dialogue: 0,1:32:33.54,1:32:34.38,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,1:32:35.25,1:32:36.88,Default,,0,0,0,,Сіз не істеп жатырсыз? Нарусе...
Dialogue: 0,1:32:41.01,1:32:41.72,Default,,0,0,0,,Олар сіздің жағдайыңызды өздеріне тапсыруымды сұрады.
Dialogue: 0,1:32:43.09,1:32:47.43,Default,,0,0,0,,Бірде Нарусе әр нәрсенің басы деп айтқан
Dialogue: 0,1:32:48.93,1:32:50.43,Default,,0,0,0,,Құлып добы…
Dialogue: 0,1:32:50.94,1:32:53.60,Default,,0,0,0,,
Dialogue: 0,1:32:53.69,1:32:56.57,Default,,0,0,0,,-(Қыз) Біраз баяу. -(Ямадзи) Иә...
Dialogue: 0,1:33:00.53,1:33:04.12,Default,,0,0,0,,♪ Кинпика сарайында
Dialogue: 0,1:33:04.20,1:33:07.37,Default,,0,0,0,,♪ Әр түнде қайталаңыз
Dialogue: 0,1:33:07.45,1:33:08.49,Default,,0,0,0,,♪ Джентельменмен...
Dialogue: 0,1:33:08.58,1:33:11.37,Default,,0,0,0,,Эй, маған үлгерім мұғалімі қоңырау шалды.
Dialogue: 0,1:33:12.16,1:33:13.62,Default,,0,0,0,,Мен бастауды бұдан былай кейінге қалдыра алмаймын.
Dialogue: 0,1:33:13.71,1:33:15.38,Default,,0,0,0,,-(Нацуки)♪ Мм... -(Сузуки) А?
Dialogue: 0,1:33:16.09,1:33:17.25,Default,,0,0,0,,-(Нацуки) ♪ Мм... -(Сузуки) Тоқта, Нито?
Dialogue: 0,1:33:17.34,1:33:19.42,Default,,0,0,0,,♪ Доп…
Dialogue: 0,1:33:21.17,1:33:23.13,Default,,0,0,0,,Жо… Жосукэнің жарақаты…
Dialogue: 0,1:33:23.22,1:33:24.84,Default,,0,0,0,,Иә, бұл не?
Dialogue: 0,1:33:25.34,1:33:28.31,Default,,0,0,0,,Үйірме жұмыстарында біз қысқа белдемшелер қалқып билейміз.
Dialogue: 0,1:33:28.39,1:33:30.27,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,1:33:32.27,1:33:33.31,Default,,0,0,0,,(Барлығы төрт адам) Һмм? (ДжоДжо) Дерби?
Dialogue: 0,1:33:34.15,1:33:36.31,Default,,0,0,0,,Мен қорыққан шығармын...
Dialogue: 0,1:33:36.81,1:33:40.03,Default,,0,0,0,,Ашық болудан қашып жүрмін.
Dialogue: 0,1:33:40.99,1:33:43.36,Default,,0,0,0,,Бірақ мен қазір тоқтаймын
Dialogue: 0,1:33:43.45,1:33:44.32,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,1:33:45.20,1:33:47.33,Default,,0,0,0,,Ху... Оши, онда кеттік.
Dialogue: 0,1:33:49.62,1:33:50.54,Default,,0,0,0,,О!
Dialogue: 0,1:33:58.13,1:34:00.55,Default,,0,0,0,,(Сырлы сигналды бастау)
Dialogue: 0,1:34:11.72,1:34:15.10,Default,,0,0,0,,Баяғыда, бірде
Dialogue: 0,1:34:15.19,1:34:19.98,Default,,0,0,0,,Құлыпта допты аңсаған бейшара қыз болыпты.
Dialogue: 0,1:34:20.94,1:34:27.70,Default,,0,0,0,,(«Сағыныш шары»)
Dialogue: 0,1:34:28.20,1:34:31.66,Default,,0,0,0,,♪ Кинпика сарайында
Dialogue: 0,1:34:31.74,1:34:34.83,Default,,0,0,0,,♪ Әр түнде қайталаңыз
Dialogue: 0,1:34:34.91,1:34:38.21,Default,,0,0,0,,♪ Джентельмен мен ханым...
Dialogue: 0,1:34:38.79,1:34:42.09,Default,,0,0,0,,Иә? Басты кейіпкер басқа адам емес пе еді?
Dialogue: 0,1:34:42.17,1:34:42.92,Default,,0,0,0,,Хмм?
Dialogue: 0,1:34:44.63,1:34:47.68,Default,,0,0,0,,Бұл жаман емес.
Dialogue: 0,1:34:49.39,1:34:50.89,Default,,0,0,0,,♪ Зал...
Dialogue: 0,1:34:50.97,1:34:52.93,Default,,0,0,0,,Даусыңыз шығып жатыр, Нацуки!
Dialogue: 0,1:34:53.02,1:34:56.10,Default,,0,0,0,,Бұл аздап қатты сезіледі.
Dialogue: 0,1:34:56.19,1:34:59.69,Default,,0,0,0,,Уау, мен де қобалжыдым~
Dialogue: 0,1:34:59.77,1:35:03.48,Default,,0,0,0,,Өтінемін, Сакагами, Нарузені маған әкел!
Dialogue: 0,1:35:05.07,1:35:10.91,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:35:15.75,1:35:16.71,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:23.00,1:35:30.01,Default,,0,0,0,,(«жарықсыз бөлме»)
Dialogue: 0,1:35:36.18,1:35:41.02,Default,,0,0,0,,♪ туралы
Dialogue: 0,1:35:41.65,1:35:48.07,Default,,0,0,0,,♪ Шамамен
Dialogue: 0,1:35:51.82,1:35:52.74,Default,,0,0,0,,Осы жолмен бе?
Dialogue: 0,1:35:56.08,1:35:57.96,Default,,0,0,0,,Аа, осынша уақыт болды...
Dialogue: 0,1:36:02.84,1:36:05.92,Default,,0,0,0,,Бірақ... егер Нарусе табылса.
Dialogue: 0,1:36:07.05,1:36:09.01,Default,,0,0,0,,Содан кейін мен...
Dialogue: 0,1:36:14.31,1:36:14.85,Default,,0,0,0,,Ах...
Dialogue: 0,1:36:20.90,1:36:25.23,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,1:36:31.11,1:36:33.16,Default,,0,0,0,,На… Наруза
Dialogue: 0,1:36:40.96,1:36:42.54,Default,,0,0,0,,Барайық Нарузе
Dialogue: 0,1:36:42.63,1:36:44.21,Default,,0,0,0,,Барлығы күтіп отыр
Dialogue: 0,1:36:47.76,1:36:50.51,Default,,0,0,0,,Мен енді қайтып бара алмаймын
Dialogue: 0,1:36:50.59,1:36:52.51,Default,,0,0,0,,Нарусе, сен...
Dialogue: 0,1:36:52.59,1:36:55.26,Default,,0,0,0,,Ол қазірдің өзінде басталды, солай ма?
Dialogue: 0,1:36:55.76,1:36:57.81,Default,,0,0,0,,Жоқ, бәрібір.
Dialogue: 0,1:36:57.89,1:36:59.93,Default,,0,0,0,,Өйткені қазір барлығы бірдеңе істеп жатыр.
Dialogue: 0,1:37:00.02,1:37:03.27,Default,,0,0,0,,Бұл мүмкін емес... Мен енді ән айта алмаймын.
Dialogue: 0,1:37:03.94,1:37:07.44,Default,,0,0,0,,Өйткені менің ханзадам енді жоқ.
Dialogue: 0,1:37:08.98,1:37:10.24,Default,,0,0,0,,- (Такуми) Нарусе... - (ретімен) Келме!
Dialogue: 0,1:37:11.28,1:37:12.91,Default,,0,0,0,,Мені айқайлауға мәжбүрлеме
Dialogue: 0,1:37:12.99,1:37:15.16,Default,,0,0,0,,Менің ішім тағы ауырды!
Dialogue: 0,1:37:16.24,1:37:19.87,Default,,0,0,0,,А... Ән болса жарайды деп ойладым, олай емес.
Dialogue: 0,1:37:19.95,1:37:22.92,Default,,0,0,0,,Сөйлесу... жүрегім сөйлейді...
Dialogue: 0,1:37:23.00,1:37:24.38,Default,,0,0,0,,Күткендей, жақсы болмады!
Dialogue: 0,1:37:24.96,1:37:26.75,Default,,0,0,0,,Тамаго дұрыс айтты.
Dialogue: 0,1:37:26.84,1:37:29.55,Default,,0,0,0,,Мен сөйлегендіктен бақытсыз болдым!
Dialogue: 0,1:37:30.13,1:37:31.80,Default,,0,0,0,,Ең алдымен жұмыртқа болған жоқ!
Dialogue: 0,1:37:31.88,1:37:32.88,Default,,0,0,0,,- (ретімен) Ирумон! -(Такуми) Онда жоқ!
Dialogue: 0,1:37:32.97,1:37:33.97,Default,,0,0,0,,- (ретімен) Иә! -(Такуми) Онда жоқ!
Dialogue: 0,1:37:34.05,1:37:36.22,Default,,0,0,0,,Сен болмасаң... қиналып қаласың!
Dialogue: 0,1:37:39.06,1:37:41.52,Default,,0,0,0,,Мен де сахнаны бүлдірдім.
Dialogue: 0,1:37:42.02,1:37:44.14,Default,,0,0,0,,Мен де үйді бүлдірдім.
Dialogue: 0,1:37:44.94,1:37:48.11,Default,,0,0,0,,Менің әңгімемнен болмаса...
Dialogue: 0,1:37:49.40,1:37:53.03,Default,,0,0,0,,Не... Нені айыптауым керек?
Dialogue: 0,1:37:53.65,1:37:56.28,Default,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,1:37:56.37,1:37:59.91,Default,,0,0,0,,(жылау)
Dialogue: 0,1:37:59.99,1:38:01.66,Default,,0,0,0,,Иә?
Dialogue: 0,1:38:01.75,1:38:05.79,Default,,0,0,0,,Сіз қылмыс жасағыңыз келе ме?
Dialogue: 0,1:38:05.88,1:38:08.42,Default,,0,0,0,,Иә! мен билегім келеді
Dialogue: 0,1:38:08.50,1:38:11.17,Default,,0,0,0,,Тіпті сол сарайда не болып жатқан болса да
Dialogue: 0,1:38:11.26,1:38:14.84,Default,,0,0,0,,Күнәкардың добы екенін білсем де, бәрібір!
Dialogue: 0,1:38:14.93,1:38:17.47,Default,,0,0,0,,Қыз шарасыздықпен жалбарынады
Dialogue: 0,1:38:17.55,1:38:20.18,Default,,0,0,0,,(«Жану»)
Dialogue: 0,1:38:20.26,1:38:21.81,Default,,0,0,0,,Ал егер...
Dialogue: 0,1:38:21.89,1:38:25.39,Default,,0,0,0,,Мен де сол жігіттер сияқты жаман қылмыс жасауым керек.
Dialogue: 0,1:38:25.48,1:38:27.69,Default,,0,0,0,,Иә Мысалы...
Dialogue: 0,1:38:28.19,1:38:32.28,Default,,0,0,0,,♪ Қолдарыңызды қалталарыңызға салыңыз
Dialogue: 0,1:38:33.53,1:38:37.03,Default,,0,0,0,,♪ Бір қорап сіріңке
Dialogue: 0,1:38:37.53,1:38:38.95,Default,,0,0,0,,♪ Екі!
Dialogue: 0,1:38:39.03,1:38:41.33,Default,,0,0,0,,Бұл не деген «бәу!» ad-lib?
Dialogue: 0,1:38:41.41,1:38:43.16,Default,,0,0,0,,Сіз мені тым ынталы деп айта аласыз...
Dialogue: 0,1:38:43.75,1:38:45.75,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,1:38:45.83,1:38:48.92,Default,,0,0,0,,- (Одагири) Ей, қозғалма - (Точикура) Келесі сенсің.
Dialogue: 0,1:38:49.50,1:38:51.50,Default,,0,0,0,,Айзава, сен бар күшіңді салып жатырсың, солай емес пе?
Dialogue: 0,1:38:51.59,1:38:53.01,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:38:53.71,1:38:56.59,Default,,0,0,0,,Нарусе: Сенің уайымдап тұрғаныңды білемін.
Dialogue: 0,1:38:56.68,1:38:58.97,Default,,0,0,0,,Әркім қобалжыса да барын салып жатыр.
Dialogue: 0,1:38:59.47,1:39:00.26,Default,,0,0,0,,Жақсы
Dialogue: 0,1:39:00.35,1:39:02.89,Default,,0,0,0,,Келесің бе, келмейсің бе маған бәрібір.
Dialogue: 0,1:39:02.97,1:39:03.68,Default,,0,0,0,,Иә?
Dialogue: 0,1:39:04.18,1:39:06.23,Default,,0,0,0,,Дәл сол нәрсе екі жолмен де орындалады.
Dialogue: 0,1:39:06.85,1:39:09.44,Default,,0,0,0,,Ең жаманы - сахнада сәтсіздікке ұшырау, солай ма?
Dialogue: 0,1:39:10.56,1:39:14.82,Default,,0,0,0,,Егер бұл орын алса, менің ойымша, Нарузе ең қатты өкінетін шығар.
Dialogue: 0,1:39:15.82,1:39:18.53,Default,,0,0,0,,Қалай болғанда да, сіз табысқа жетуіңіз керек.
Dialogue: 0,1:39:18.61,1:39:20.07,Default,,0,0,0,,Сіз шынымен не ойлайсыз?
Dialogue: 0,1:39:20.16,1:39:22.99,Default,,0,0,0,,Мен бұл тәжірибені босқа өткізгім келмейді!
Dialogue: 0,1:39:23.08,1:39:24.08,Default,,0,0,0,,Расында!
Dialogue: 0,1:39:24.58,1:39:25.37,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:39:25.45,1:39:27.83,Default,,0,0,0,,Қазір не істей бастадыңыз?
Dialogue: 0,1:39:27.92,1:39:32.00,Default,,0,0,0,,♪ Бобобобобобобобобобобобо
Dialogue: 0,1:39:32.09,1:39:34.13,Default,,0,0,0,,Барлығын өртеп жіберіңіз!
Dialogue: 0,1:39:34.21,1:39:38.18,Default,,0,0,0,,Мен, жүрегім, сырласым!
Dialogue: 0,1:39:39.18,1:39:43.18,Default,,0,0,0,,Сөйлесушіге кінәлау керек болса, не істерімді білмеймін.
Dialogue: 0,1:39:43.68,1:39:46.14,Default,,0,0,0,,Мен не істерімді білмеймін!
Dialogue: 0,1:39:46.23,1:39:47.43,Default,,0,0,0,,Нарусе Джун!
Dialogue: 0,1:39:49.73,1:39:51.36,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,1:39:52.94,1:39:56.24,Default,,0,0,0,,Даусыңыз сүйкімді.
Dialogue: 0,1:39:57.53,1:39:58.82,Default,,0,0,0,,Көбірек сөйлеңіз.
Dialogue: 0,1:40:00.20,1:40:04.49,Default,,0,0,0,,Маған шынайы сөздеріңізді көбірек беріңіз.
Dialogue: 0,1:40:06.00,1:40:10.33,Default,,0,0,0,,Мені естімедің бе? Бұл, әрине, жақсы емес, солай ма?
Dialogue: 0,1:40:10.92,1:40:14.34,Default,,0,0,0,,Сөздер... біреуге зиян тигізуі мүмкін.
Dialogue: 0,1:40:14.84,1:40:16.76,Default,,0,0,0,,Сіз мені ренжіте аласыз
Dialogue: 0,1:40:18.22,1:40:19.59,Default,,0,0,0,,Зардап шегуге болмайды
Dialogue: 0,1:40:20.09,1:40:23.22,Default,,0,0,0,,Мен сіздің шынайы сөздеріңізді көбірек естігім келеді.
Dialogue: 0,1:40:24.56,1:40:25.43,Default,,0,0,0,,Наруз
Dialogue: 0,1:40:32.19,1:40:32.86,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:34.44,1:40:35.23,Default,,0,0,0,,Иә?
Dialogue: 0,1:40:35.32,1:40:36.32,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,1:40:37.36,1:40:39.78,Default,,0,0,0,,Мен сені қазір ренжітемін.
Dialogue: 0,1:40:40.65,1:40:41.32,Default,,0,0,0,,Иә
Dialogue: 0,1:40:48.87,1:40:50.91,Default,,0,0,0,,Мейірімді кейіп танытып, ақымақ!
Dialogue: 0,1:40:51.00,1:40:53.54,Default,,0,0,0,,Сіз кейде өте тітіркендіргішсіз!
Dialogue: 0,1:40:53.63,1:40:54.13,Default,,0,0,0,,Иә
Dialogue: 0,1:40:54.21,1:40:56.42,Default,,0,0,0,,Тіпті оның беті онша жақсы емес!
Dialogue: 0,1:40:56.50,1:40:59.59,Default,,0,0,0,,Фортепианода аздап ойнай алатындықтан, танымал болдым деп қателеспеңіз.
Dialogue: 0,1:40:59.67,1:41:00.55,Default,,0,0,0,,Өтірікші!
Dialogue: 0,1:41:00.63,1:41:01.13,Default,,0,0,0,,Иә
Dialogue: 0,1:41:01.72,1:41:03.39,Default,,0,0,0,,Тек болжамды сөздерді айту
Dialogue: 0,1:41:03.47,1:41:04.93,Default,,0,0,0,,Керемет бейбақ!
Dialogue: 0,1:41:05.01,1:41:06.60,Default,,0,0,0,,- (Такуми) Иә - (ретімен) Онда!
Dialogue: 0,1:41:06.68,1:41:10.31,Default,,0,0,0,,Вертолёт шайқалғандықтан, ол сәл ашулы.
Dialogue: 0,1:41:10.89,1:41:12.27,Default,,0,0,0,,Ол әйел де кінәлі!
Dialogue: 0,1:41:12.35,1:41:14.23,Default,,0,0,0,,Өтірікші, жақсы адам сияқты әрекет етеді
Dialogue: 0,1:41:14.31,1:41:16.77,Default,,0,0,0,,Мұндай нәрсе ең сорақысы!
Dialogue: 0,1:41:18.15,1:41:18.73,Default,,0,0,0,,Иә
Dialogue: 0,1:41:18.82,1:41:19.61,Default,,0,0,0,,Олай болса!
Dialogue: 0,1:41:20.57,1:41:23.86,Default,,0,0,0,,Содан кейін... Содан кейін...
Dialogue: 0,1:41:24.91,1:41:26.07,Default,,0,0,0,,Сонда?
Dialogue: 0,1:41:27.99,1:41:31.25,Default,,0,0,0,,Енді айтатын ештеңе жоқ
Dialogue: 0,1:41:31.33,1:41:33.58,Default,,0,0,0,,- (Такуми) Шынымен бе? -(Тәртіппен) Жоқ!
Dialogue: 0,1:41:34.17,1:41:37.54,Default,,0,0,0,,Барлығы осы ма? Сіздің шынайы сөздеріңіз!
Dialogue: 0,1:41:40.92,1:41:41.51,Default,,0,0,0,,Аты-жөні!
Dialogue: 0,1:41:42.09,1:41:42.76,Default,,0,0,0,,Иә?
Dialogue: 0,1:41:43.30,1:41:45.76,Default,,0,0,0,,Сіз менің атымды айттыңыз.
Dialogue: 0,1:41:46.26,1:41:49.39,Default,,0,0,0,,Мен сенің атыңды ешқашан айтқан емеспін.
Dialogue: 0,1:41:51.98,1:41:53.06,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,1:41:57.48,1:41:59.86,Default,,0,0,0,,Такуми Сакагами…
Dialogue: 0,1:41:59.94,1:42:00.86,Default,,0,0,0,,Иә
Dialogue: 0,1:42:01.57,1:42:04.07,Default,,0,0,0,,- (ретімен) Такуми Сакагами... - (Такуми) Иә.
Dialogue: 0,1:42:04.91,1:42:07.28,Default,,0,0,0,,- (ретімен) Такуми Сакагами - (Такуми) Иә
Dialogue: 0,1:42:07.37,1:42:10.37,Default,,0,0,0,,- (ретімен) Такуми Сакагами! -(Такуми) Иә...
Dialogue: 0,1:42:11.12,1:42:11.95,Default,,0,0,0,,Иә?
Dialogue: 0,1:42:15.42,1:42:17.46,Default,,0,0,0,,Иә? Неге деп ойлаймын
Dialogue: 0,1:42:19.55,1:42:22.21,Default,,0,0,0,,Мен Нарузе сияқты едім.
Dialogue: 0,1:42:22.71,1:42:24.38,Default,,0,0,0,,Мен сөйлесемін, бірақ
Dialogue: 0,1:42:24.88,1:42:28.14,Default,,0,0,0,,Мен өз ойымды айтпайтын әдетім бар.
Dialogue: 0,1:42:28.64,1:42:30.60,Default,,0,0,0,,Мен білмей тұрып, бұл менің мойнымда болды.
Dialogue: 0,1:42:31.14,1:42:34.77,Default,,0,0,0,,Сонда біреуге шынымен не айтқыңыз келеді?
Dialogue: 0,1:42:35.60,1:42:38.15,Default,,0,0,0,,Мен ештеңе жоқ шығар деп ойлай бастадым.
Dialogue: 0,1:42:39.06,1:42:43.69,Default,,0,0,0,,Бірақ мен Наруземен кездескенде сен әдетте сөйлеспейсің.
Dialogue: 0,1:42:44.74,1:42:47.41,Default,,0,0,0,,Негізі мен сізге айтқым келетін нәрселер өте көп.
Dialogue: 0,1:42:48.24,1:42:49.58,Default,,0,0,0,,Содан кейін
Dialogue: 0,1:42:50.08,1:42:53.66,Default,,0,0,0,,Менде әлі де біреуге айтқым келетін бір нәрсе бар...
Dialogue: 0,1:42:53.75,1:42:57.25,Default,,0,0,0,,Менің айтқым келетін нәрселер көп болды деп ойлаймын.
Dialogue: 0,1:42:58.13,1:43:00.84,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,1:43:01.71,1:43:05.01,Default,,0,0,0,,Сіздің арқаңызда мен көп нәрсені түсінгендей болдым.
Dialogue: 0,1:43:09.22,1:43:09.76,Default,,0,0,0,,Барлығы…
Dialogue: 0,1:43:10.93,1:43:13.22,Default,,0,0,0,,Маған рахмет?
Dialogue: 0,1:43:13.77,1:43:15.48,Default,,0,0,0,,«Кінә» емес пе?
Dialogue: 0,1:43:15.56,1:43:16.73,Default,,0,0,0,,Дұрыс!
Dialogue: 0,1:43:16.81,1:43:19.06,Default,,0,0,0,,Демек, жұмыртқа жоқ!
Dialogue: 0,1:43:20.36,1:43:21.19,Default,,0,0,0,,Иә?
Dialogue: 0,1:43:21.27,1:43:24.07,Default,,0,0,0,,Өйткені оның айтқаны бір топ өтірік еді.
Dialogue: 0,1:43:24.57,1:43:27.86,Default,,0,0,0,,Өйткені сенің сөздерің мені қуантты!
Dialogue: 0,1:43:31.62,1:43:32.58,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:43:32.66,1:43:36.25,Default,,0,0,0,,- (Тәртіппен) Мен де Сакагами-кунның арқасында - (Такуми) А?
Dialogue: 0,1:43:36.83,1:43:43.00,Default,,0,0,0,,Сакагами-кун, Нито-сан, Тасаки-кун және басқаларға рахмет.
Dialogue: 0,1:43:43.71,1:43:44.76,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:43:44.84,1:43:46.22,Default,,0,0,0,,Кеттік
Dialogue: 0,1:43:47.42,1:43:49.68,Default,,0,0,0,,Барлығы сені күтіп отыр.
Dialogue: 0,1:43:50.89,1:43:51.89,Default,,0,0,0,,Күту
Dialogue: 0,1:43:57.94,1:43:59.02,Default,,0,0,0,,Мен...
Dialogue: 0,1:44:00.27,1:44:02.86,Default,,0,0,0,,Тағы бір айтайын дегенім бар еді.
Dialogue: 0,1:44:03.94,1:44:04.57,Default,,0,0,0,,Мен
Dialogue: 0,1:44:05.44,1:44:07.11,Default,,0,0,0,,Маған Сакагами-кун ұнайды
Dialogue: 0,1:44:12.66,1:44:13.70,Default,,0,0,0,,Рахмет
Dialogue: 0,1:44:14.33,1:44:16.58,Default,,0,0,0,,Бірақ маған ұнайтын адам бар
Dialogue: 0,1:44:22.63,1:44:23.42,Default,,0,0,0,,Иә
Dialogue: 0,1:44:25.80,1:44:27.59,Default,,0,0,0,,Мен білдім
Dialogue: 0,1:44:43.61,1:44:47.03,Default,,0,0,0,,Қыз ойына келген барлық жаман сөздерді айтты.
Dialogue: 0,1:44:48.03,1:44:50.11,Default,,0,0,0,,Толығырақ қарастырайық
Dialogue: 0,1:44:50.20,1:44:53.74,Default,,0,0,0,,Иә, Джун-чан мен менің Таккуным да.
Dialogue: 0,1:44:53.82,1:44:57.45,Default,,0,0,0,,Мен дайындалу үшін көп жұмыс жасадым.
Dialogue: 0,1:44:59.62,1:45:02.04,Default,,0,0,0,,Хахахаха!
Dialogue: 0,1:45:02.62,1:45:04.63,Default,,0,0,0,,Сіз үнсіз бе?
Dialogue: 0,1:45:04.71,1:45:07.34,Default,,0,0,0,,Бұл сенің күнәңнің жазасы
Dialogue: 0,1:45:07.84,1:45:11.63,Default,,0,0,0,,Барлығы сенің үндемегеніңді қалайды!
Dialogue: 0,1:45:13.39,1:45:17.18,Default,,0,0,0,,Жоқ, мен мұны қаламадым...
Dialogue: 0,1:45:18.18,1:45:22.35,Default,,0,0,0,,♪ Менің дауысым
Dialogue: 0,1:45:22.44,1:45:25.61,Default,,0,0,0,,♪ Қош бол
Dialogue: 0,1:45:25.69,1:45:31.24,Default,,0,0,0,,♪ Сол таудың арғы жағында
Dialogue: 0,1:45:32.03,1:45:36.03,Default,,0,0,0,,♪ Терең ұйықтаңыз
Dialogue: 0,1:45:36.12,1:45:39.37,Default,,0,0,0,,♪ Көлге
Dialogue: 0,1:45:39.45,1:45:43.83,Default,,0,0,0,,♪ Жоқ
Dialogue: 0,1:45:45.08,1:45:46.54,Default,,0,0,0,,Сәлем, Тасаки.
Dialogue: 0,1:45:47.25,1:45:48.75,Default,,0,0,0,,Бұл сенің жарқыраған нұрың.
Dialogue: 0,1:45:50.17,1:45:51.80,Default,,0,0,0,,А, қарашы, Сакагамиден екен.
Dialogue: 0,1:45:51.88,1:45:52.38,Default,,0,0,0,,Оны маған қарызға бер!
Dialogue: 0,1:45:52.47,1:45:53.97,Default,,0,0,0,,Е, Нарусе, таптың ба?
Dialogue: 0,1:45:54.05,1:45:56.18,Default,,0,0,0,,Бірақ біз не істеуіміз керек? Бұдан былай
Dialogue: 0,1:45:57.22,1:45:59.72,Default,,0,0,0,,Таку: Нарузе екеуміз осы жаққа бара жатырмыз.
Dialogue: 0,1:46:00.22,1:46:01.73,Default,,0,0,0,,Енді оның орнына Нитоны қоясыз ба?
Dialogue: 0,1:46:01.81,1:46:03.60,Default,,0,0,0,,Бірақ ол жарты нүктеден өтіп кетті.
Dialogue: 0,1:46:03.69,1:46:05.77,Default,,0,0,0,,Тағы не істей аламын...
Dialogue: 0,1:46:06.27,1:46:07.31,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:46:07.98,1:46:09.78,Default,,0,0,0,,Не жақсы?
Dialogue: 0,1:46:09.86,1:46:13.03,Default,,0,0,0,,Осыдан кейін қыздың жүрегінің әнді дауысы шығады, солай ма?
Dialogue: 0,1:46:13.57,1:46:16.11,Default,,0,0,0,,Сахнада сөйлей алмайтын қызды қалдыру
Dialogue: 0,1:46:16.20,1:46:18.74,Default,,0,0,0,,Нито мен оның достары сахнаның артында ән айтуды жоспарлаған ән.
Dialogue: 0,1:46:19.91,1:46:22.20,Default,,0,0,0,,Сол әнді айтып шығу керек.
Dialogue: 0,1:46:22.29,1:46:24.96,Default,,0,0,0,,Не? Сіздің ішкі дауысыңыз шығады ма?
Dialogue: 0,1:46:25.04,1:46:27.83,Default,,0,0,0,,Күте тұрыңыз... бұл екі қыз болар еді.
Dialogue: 0,1:46:27.92,1:46:33.05,Default,,0,0,0,,Бұл жақсы, өйткені мюзикл...
Dialogue: 0,1:46:35.05,1:46:37.09,Default,,0,0,0,,Ғажайыптар жиі кездеседі, солай емес пе?
Dialogue: 0,1:46:41.06,1:46:44.89,Default,,0,0,0,,♪ Менің дауысым
Dialogue: 0,1:46:44.98,1:46:48.61,Default,,0,0,0,,♪ Жоғалып кетті
Dialogue: 0,1:46:48.69,1:46:54.95,Default,,0,0,0,,♪ Барлығы бақытты болды.
Dialogue: 0,1:46:55.03,1:47:00.24,Default,,0,0,0,,♪ Барлығы менікі
Dialogue: 0,1:47:00.33,1:47:02.49,Default,,0,0,0,,♪ Сөздер
Dialogue: 0,1:47:02.58,1:47:07.21,Default,,0,0,0,,♪ Өйткені мен оны жек көремін
Dialogue: 0,1:47:09.50,1:47:16.26,Default,,0,0,0,,♪ Қатты жылау
Dialogue: 0,1:47:16.34,1:47:22.26,Default,,0,0,0,,♪ Кеткен дауыс
Dialogue: 0,1:47:23.27,1:47:30.19,Default,,0,0,0,,♪ Мен артта қалдым
Dialogue: 0,1:47:30.27,1:47:35.24,Default,,0,0,0,,♪ Мен жылай алмаймын
Dialogue: 0,1:47:48.92,1:47:52.17,Default,,0,0,0,,Осылай қыздың сөзінен айырылды.
Dialogue: 0,1:47:52.25,1:47:55.80,Default,,0,0,0,,Мен жазаның ауыртпалығынан ақыры құладым.
Dialogue: 0,1:47:56.51,1:47:59.43,Default,,0,0,0,,Үмітсіз қыз, бірақ...
Dialogue: 0,1:47:59.93,1:48:01.64,Default,,0,0,0,,- (Uno) Науза! - (ретімен) Уау...
Dialogue: 0,1:48:02.22,1:48:03.56,Default,,0,0,0,,Сізге жақсы Наруза
Dialogue: 0,1:48:03.64,1:48:06.35,Default,,0,0,0,,Иә, сыртқы түрі жарқыраған және қызықты болды.
Dialogue: 0,1:48:06.43,1:48:09.06,Default,,0,0,0,,Бірақ аздап қобалжысам да, өте жақсы болды.
Dialogue: 0,1:48:09.56,1:48:11.98,Default,,0,0,0,,Наруза макияжды тез жасаңыз! Сонымен...
Dialogue: 0,1:48:12.06,1:48:15.07,Default,,0,0,0,,Жылама, макияж кие алмайсың!
Dialogue: 0,1:48:15.57,1:48:16.74,Default,,0,0,0,,Наруз
Dialogue: 0,1:48:17.40,1:48:20.99,Default,,0,0,0,,Жақында тағы да менің кезегім, сондықтан мен сізден соңына дейін сұраймын.
Dialogue: 0,1:48:23.62,1:48:25.54,Default,,0,0,0,,I Барлығына...
Dialogue: 0,1:48:25.62,1:48:26.95,Default,,0,0,0,,Әңгімелеу...
Dialogue: 0,1:48:27.04,1:48:30.67,Default,,0,0,0,,Мен саған қиындық тудырдым... Бірақ...
Dialogue: 0,1:48:31.88,1:48:34.67,Default,,0,0,0,,Қараңызшы, сондықтан жыламау керек.
Dialogue: 0,1:48:35.17,1:48:36.59,Default,,0,0,0,,Сіз мұны соңына дейін жасайсыз, солай ма?
Dialogue: 0,1:48:37.38,1:48:44.39,Default,,0,0,0,,♪ Жұмыртқаның ішінде
Dialogue: 0,1:48:44.89,1:48:48.98,Default,,0,0,0,,♪ Тұндырылған ақ ет және
Dialogue: 0,1:48:49.06,1:48:52.65,Default,,0,0,0,,♪ Үлкен сарысы
Dialogue: 0,1:48:52.73,1:48:57.36,Default,,0,0,0,,А, шынымен де жұмыртқа болған жоқ.
Dialogue: 0,1:48:58.74,1:49:00.86,Default,,0,0,0,,Қарғыс айтқан мен болдым
Dialogue: 0,1:49:01.40,1:49:02.95,Default,,0,0,0,,Жұмыртқа менікі
Dialogue: 0,1:49:03.45,1:49:05.58,Default,,0,0,0,,Мен өзім жұмыртқаға тығылып қалдым...
Dialogue: 0,1:49:06.08,1:49:07.24,Default,,0,0,0,,Өзім
Dialogue: 0,1:49:07.74,1:49:09.16,Default,,0,0,0,,Сол кезде
Dialogue: 0,1:49:09.25,1:49:12.71,Default,,0,0,0,,Дүние қызға ән сала бастады.
Dialogue: 0,1:49:14.29,1:49:16.29,Default,,0,0,0,,Бұл соңғы рет. Бар.
Dialogue: 0,1:49:16.38,1:49:17.09,Default,,0,0,0,,Иә
Dialogue: 0,1:49:20.38,1:49:21.38,Default,,0,0,0,,Қазір...
Dialogue: 0,1:49:21.47,1:49:28.47,Default,,0,0,0,,(«Менің жүрегім айқайлай бастайды ~ Мен сенің атыңды шақырамын»)
Dialogue: 0,1:49:33.81,1:49:40.69,Default,,0,0,0,,- (ретімен) ♪ Кокога - (Нацуки) ♪ Сіздің атыңыз
Dialogue: 0,1:49:41.19,1:49:47.58,Default,,0,0,0,,- (ретімен) ♪ Айқайлай баста - (Нацуки) ♪ Мен саған хабарласамын.
Dialogue: 0,1:49:47.66,1:49:54.67,Default,,0,0,0,,- (ретімен) ♪ Жаныңызда - (Нацуки) ♪ Сіздің түріңіз
Dialogue: 0,1:49:55.88,1:50:02.84,Default,,0,0,0,,- (ретімен) ♪ Мен көрген дүние - (Нацуки) ♪ Мен сенің атыңды атаймын
Dialogue: 0,1:50:10.85,1:50:17.69,Default,,0,0,0,,-(Джун және басқалар)♪ Барлығы -(Нацуки және т.б.)♪ Мен саған айтамын
Dialogue: 0,1:50:18.19,1:50:24.65,Default,,0,0,0,,- (Джун және басқалар) ♪ Әдемі - (Нацуки және т.б.) ♪ Бұл орындалды
Dialogue: 0,1:50:24.74,1:50:31.75,Default,,0,0,0,,- (Джун және басқалар) ♪ Тіпті қайғылы өткен - (Нацуки және т.б.) ♪ Өте әдемі
Dialogue: 0,1:50:32.62,1:50:39.63,Default,,0,0,0,,- (Джун және басқалар) ♪ Көз жасынан кейін - (Нацуки және т.б.) ♪ Бұл әлем
Dialogue: 0,1:50:47.72,1:50:54.14,Default,,0,0,0,,-(Джун және басқалар)♪ Мен -(Нацуки және басқалар)♪ Бұл әлем
Dialogue: 0,1:50:54.23,1:51:01.07,Default,,0,0,0,,-(Джун және басқалар)♪ Мен айқайлаймын -(Нацуки және басқалар)♪ Мен сені құшақтаймын
Dialogue: 0,1:51:01.57,1:51:08.16,Default,,0,0,0,,-(Джун және басқалар)♪ Мен сені кездестірдім -(Нацуки және басқалар)♪ Барлығы толығымен
Dialogue: 0,1:51:10.20,1:51:16.00,Default,,0,0,0,,- (Джун және басқалар) ♪ Туылу сезімі - (Нацуки және басқалар) ♪ Мен сені құшақтаймын
Dialogue: 0,1:51:24.46,1:51:31.47,Default,,0,0,0,,- (Джун және басқалар) ♪ Барлығы - (Нацуки және басқалар) ♪ Мен сені жақсы көремін
Dialogue: 0,1:51:32.06,1:51:38.44,Default,,0,0,0,,-(Джун және басқалар)♪ Мен сені сүйемін -(Нацуки және басқалар)♪ Теру
Dialogue: 0,1:51:38.52,1:51:45.53,Default,,0,0,0,,-(Джун және басқалар) ♪ Сен оны маған бердің -(Нацуки және басқалар)♪ Мен сені осылай жақсы көремін
Dialogue: 0,1:51:46.95,1:51:52.41,Default,,0,0,0,,-(Джун және басқалар)♪ Бұл әлем -(Нацуки және басқалар)♪ Мен сені жақсы көремін
Dialogue: 0,1:52:11.22,1:52:18.23,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:52:58.89,1:52:59.68,Default,,0,0,0,,Міне.
Dialogue: 0,1:53:00.56,1:53:02.81,Default,,0,0,0,,Мен Нарузеге бір сәт мойындаймын.
Dialogue: 0,1:53:04.15,1:53:04.81,Default,,0,0,0,,- (Нацуки) Иә? - Ал (Такуми) ше?
Dialogue: 0,1:53:05.73,1:53:08.40,Default,,0,0,0,,Мен аптаның басында жаттығуды бастаймын.
Dialogue: 0,1:53:08.90,1:53:10.36,Default,,0,0,0,,Сонда менің бос уақытым көп болмайды.
Dialogue: 0,1:53:10.45,1:53:11.78,Default,,0,0,0,,Енді солай ма?
Dialogue: 0,1:53:11.86,1:53:13.03,Default,,0,0,0,,О
Dialogue: 0,1:53:13.11,1:53:14.99,Default,,0,0,0,,Мен бір сәтке кете аламын ба?
Dialogue: 0,1:53:16.37,1:53:20.04,Default,,0,0,0,,Тазалау жұмыстары әлі бар, сондықтан тезірек оралыңыз.
Dialogue: 0,1:53:21.92,1:53:22.67,Default,,0,0,0,,О
Dialogue: 0,1:53:23.37,1:53:25.79,Default,,0,0,0,,Олай болса, мен біраз уақытқа барайын!
Dialogue: 0,1:53:28.46,1:53:30.76,Default,,0,0,0,,Бұл керемет, Тасаки-кун.
Dialogue: 0,1:53:31.26,1:53:32.05,Default,,0,0,0,,Иә
Dialogue: 0,1:53:34.26,1:53:35.22,Default,,0,0,0,,Нито
Dialogue: 0,1:53:36.93,1:53:37.68,Default,,0,0,0,,Осымен
Dialogue: 0,1:53:38.18,1:53:42.52,Default,,0,0,0,,Өткен күні естігіңіз келмеген сөзіңізді жалғастыра аламын ба?
Dialogue: 0,1:53:44.52,1:53:46.11,Default,,0,0,0,,- (Нацуки) Жоқ - (Такуми) Иә?
Dialogue: 0,1:53:47.82,1:53:51.24,Default,,0,0,0,,Дәл қазір мен Тасаки-кунды пайдаланып жатқан сияқтымын.
Dialogue: 0,1:53:51.32,1:53:54.95,Default,,0,0,0,,А... жоқ, олай емес...
Dialogue: 0,1:53:55.03,1:53:55.95,Default,,0,0,0,,Келесі жолы
Dialogue: 0,1:53:57.53,1:53:59.49,Default,,0,0,0,,Маған дұрыстап тыңдауға рұқсат етіңіз
Dialogue: 0,1:54:00.20,1:54:03.37,Default,,0,0,0,,Мен де дұрыс жауап беремін.
Dialogue: 0,1:54:03.96,1:54:05.50,Default,,0,0,0,,Ух... иә
Dialogue: 0,1:54:06.00,1:54:07.84,Default,,0,0,0,,Жүр, тез қайтайық.
Dialogue: 0,1:54:10.55,1:54:12.38,Default,,0,0,0,,Жұмыртқаның ішінде не бар?
Dialogue: 0,1:54:14.26,1:54:16.80,Default,,0,0,0,,Барлық сезімдеріңізді жауып тастаңыз
Dialogue: 0,1:54:18.10,1:54:19.43,Default,,0,0,0,,Мен енді өзімді ұстай алмаймын
Dialogue: 0,1:54:20.43,1:54:21.89,Default,,0,0,0,,Жарылу
Dialogue: 0,1:54:23.23,1:54:26.56,Default,,0,0,0,,Ал дүниеге келген дүние...
Dialogue: 0,1:54:33.36,1:54:36.16,Default,,0,0,0,,Мен ойлағаннан да әдемі.
Dialogue: 0,1:54:42.75,1:54:44.75,Default,,0,0,0,,♪~
Dialogue: 0,1:59:01.46,1:59:03.46,Default,,0,0,0,,~♪
