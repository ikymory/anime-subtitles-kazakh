Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.11,0:00:02.53,Default,,0,0,0,,Керемет, Каччан.
Dialogue: 0,0:00:03.11,0:00:05.36,Default,,0,0,0,,«Индивидуалдылық» тамаша.
Dialogue: 0,0:00:05.49,0:00:07.41,Default,,0,0,0,,Қызық, мен де тезірек кетейін бе?
Dialogue: 0,0:00:08.03,0:00:12.66,Default,,0,0,0,,Деку қандай болмасын, ол маған ешқашан тең келе алмайды.
Dialogue: 0,0:00:14.95,0:00:17.33,Default,,0,0,0,,Бұл жай ғана тас
Dialogue: 0,0:00:17.92,0:00:22.84,Default,,0,0,0,,Күні кеше ғана жол жиегіндегі тас болса керек.
Dialogue: 0,0:00:27.93,0:00:30.14,Default,,0,0,0,,Оның мінезі өте жарқыраған!
Dialogue: 0,0:00:31.68,0:00:32.85,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:00:32.97,0:00:35.18,Default,,0,0,0,,Сен мені алдадың! Әрқашан көңілді болды ма?
Dialogue: 0,0:00:35.18,0:00:38.39,Default,,0,0,0,,Сіз мені алдадың! Бұл әрқашан көңілді болды ма?
Dialogue: 0,0:00:35.18,0:00:38.39,Default,,0,0,0,,Уууу!
Dialogue: 0,0:00:38.39,0:00:38.44,Default,,0,0,0,,Сен мені алдадың! Бұл әрқашан көңілді болды ма?
Dialogue: 0,0:00:39.35,0:00:41.27,Default,,0,0,0,,Оны қолданыңыз!
Dialogue: 0,0:00:41.94,0:00:44.61,Default,,0,0,0,,Себебі мен сенен жақсымын!
Dialogue: 0,0:00:47.99,0:00:49.11,Default,,0,0,0,,Не!
Dialogue: 0,0:00:50.91,0:00:52.33,Default,,0,0,0,,Не?
Dialogue: 0,0:00:52.95,0:00:56.58,Default,,0,0,0,,Импровизацияланған өлім!Үйге жүгіру комета!
Dialogue: 0,0:00:56.96,0:01:00.33,Default,,0,0,0,,Бұл үйге жүгіру емес пе?
Dialogue: 0,0:01:00.75,0:01:02.71,Default,,0,0,0,,Қалпына келтіру! (Иида) Уау!
Dialogue: 0,0:01:07.05,0:01:09.38,Default,,0,0,0,,Ханакара Теми...
Dialogue: 0,0:01:09.68,0:01:12.93,Default,,0,0,0,,Ғү! Не?!
Dialogue: 0,0:01:13.05,0:01:13.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:15.22,0:01:16.89,Default,,0,0,0,,Себебі оны пайдалану мүмкін емес...
Dialogue: 0,0:01:17.35,0:01:21.69,Default,,0,0,0,,Өйткені дене соққыға төтеп бере алмайды...
Dialogue: 0,0:01:23.73,0:01:29.15,Default,,0,0,0,,Айзава-сенсэй де маған айтты... Бірақ...
Dialogue: 0,0:01:29.86,0:01:30.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:31.66,0:01:35.74,Default,,0,0,0,,Менің ойыма келгені осы ғана...
Dialogue: 0,0:01:35.87,0:01:38.20,Default,,0,0,0,,Ку... у...
Dialogue: 0,0:01:38.33,0:01:39.25,Default,,0,0,0,,Маған айтты
Dialogue: 0,0:01:43.38,0:01:45.88,Default,,0,0,0,,«Сен батыр бола аласың»
Dialogue: 0,0:01:49.13,0:01:53.60,Default,,0,0,0,,Сонымен... Мен барамын!
Dialogue: 0,0:01:55.56,0:02:00.56,Default,,0,0,0,,♪～
Dialogue: 0,0:03:19.97,0:03:24.98,Default,,0,0,0,,～♪
Dialogue: 0,0:03:26.40,0:03:28.56,Default,,0,0,0,,Үй ішінде тұлға аралық ұрыс жаттығулары
Dialogue: 0,0:03:28.90,0:03:30.53,Default,,0,0,0,,Күлсін... (Иида) Урарака-кун!
Dialogue: 0,0:03:30.53,0:03:31.28,Default,,0,0,0,,Күлсін... (Иида) Урарака-кун!
Dialogue: 0,0:03:30.53,0:03:31.28,Default,,0,0,0,,Қаһарман команда ЖЕҢІЛДІ!
Dialogue: 0,0:03:31.28,0:03:34.40,Default,,0,0,0,,Қаһарман команда ЖЕҢІЛДІ!
Dialogue: 0,0:03:35.24,0:03:36.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:37.32,0:03:38.91,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:03:39.62,0:03:44.25,Default,,0,0,0,,Жеңілген адам зардап шекпейді, жеңген адам құлады.
Dialogue: 0,0:03:44.71,0:03:48.54,Default,,0,0,0,,Сіз ойында жеңіліп, жеңіске жеттім дейсіз бе?
Dialogue: 0,0:03:48.67,0:03:50.38,Default,,0,0,0,,Әйтеуір, бұл тек жаттығу ғана.
Dialogue: 0,0:03:57.01,0:03:59.89,Default,,0,0,0,,Ауруханаға (Хансо Робо) Мен білемін
Dialogue: 0,0:04:08.02,0:04:12.28,Default,,0,0,0,,Дұрыс... Деку оқып отырды.
Dialogue: 0,0:04:12.78,0:04:17.45,Default,,0,0,0,,Жаттығуда жеңіске жету жолын білу үшін оқыңыз...
Dialogue: 0,0:04:20.45,0:04:23.70,Default,,0,0,0,,<Тек біз көршілес болғандықтан➡
Dialogue: 0,0:04:23.83,0:04:27.04,Default,,0,0,0,,Жеңіске жетіп, одан асып кетуді қаламайсыз ба? Ақымақ!
Dialogue: 0,0:04:27.04,0:04:28.17,Default,,0,0,0,,Жеңіске жетіп, одан асып кетуді қаламайсыз ба? Ақымақ!
Dialogue: 0,0:04:27.04,0:04:28.17,Default,,0,0,0,,(Бакугоның ауыр тыныс алуы)
Dialogue: 0,0:04:28.17,0:04:29.63,Default,,0,0,0,,(Бакугоның ауыр тыныс алуы)
Dialogue: 0,0:04:30.17,0:04:32.38,Default,,0,0,0,,Бұл дегеніміз...
Dialogue: 0,0:04:32.63,0:04:37.51,Default,,0,0,0,,Бір-бірімізбен шындап төбелессек те, мен толығымен жеңілемін...
Dialogue: 0,0:04:37.63,0:04:38.84,Default,,0,0,0,,(Бакугоның ауыр тыныс алуы)
Dialogue: 0,0:04:39.22,0:04:41.93,Default,,0,0,0,,Ха (Барлығы мүмкін) Мен қайтамын, Бакугу бала.
Dialogue: 0,0:04:42.06,0:04:43.35,Default,,0,0,0,,Декү, сабыр сақта!
Dialogue: 0,0:04:44.39,0:04:46.98,Default,,0,0,0,,Сіз ұтсаңыз да, жеңілсеңіз де...
Dialogue: 0,0:04:47.10,0:04:50.44,Default,,0,0,0,,(Кацуми)((Декудың Қвиркі қандай болса да, ол менімен ешқашан тең келе алмайды, айтамын саған))
Dialogue: 0,0:04:55.90,0:04:57.20,Default,,0,0,0,,Тіпті егер...
Dialogue: 0,0:04:57.82,0:05:00.45,Default,,0,0,0,,Бұл матчта ең жақсысы Иида бала.
Dialogue: 0,0:05:00.82,0:05:02.28,Default,,0,0,0,,Нана... Нана!?
Dialogue: 0,0:05:02.83,0:05:05.66,Default,,0,0,0,,Жеңген Очако-чан емес пе, әлде Мидория-чан емес пе?
Dialogue: 0,0:05:06.12,0:05:10.46,Default,,0,0,0,,Хмм, неге деп ойлаймын.
Dialogue: 0,0:05:10.58,0:05:11.46,Default,,0,0,0,,Түсінетін адам!
Dialogue: 0,0:05:11.79,0:05:13.96,Default,,0,0,0,,Иә, бәрі құдіретті!
Dialogue: 0,0:05:14.25,0:05:15.76,Default,,0,0,0,,Бұл Иида мырза.
Dialogue: 0,0:05:15.88,0:05:18.59,Default,,0,0,0,,Өйткені ол жағдайға барынша бейімделгіш болды.
Dialogue: 0,0:05:20.55,0:05:22.22,Default,,0,0,0,,Бакуго-санның әрекеттері-
Dialogue: 0,0:05:22.35,0:05:25.06,Default,,0,0,0,,Мен шайқасты көргенімше, бұл менің жеке пікірім.
Dialogue: 0,0:05:25.60,0:05:28.94,Default,,0,0,0,,Ал мұғалім бұрын айтқандай...
Dialogue: 0,0:05:29.06,0:05:31.44,Default,,0,0,0,,Үй ішінде кең ауқымды шабуылдар - жаман идея
Dialogue: 0,0:05:33.36,0:05:34.69,Default,,0,0,0,,Мидория-сан үшін де солай.
Dialogue: 0,0:05:35.27,0:05:37.44,Default,,0,0,0,,Келтірілген залалды ескере отырып...
Dialogue: 0,0:05:37.57,0:05:40.70,Default,,0,0,0,,Бұл стратегияны тек абайсыз деп сипаттауға болады.
Dialogue: 0,0:05:41.61,0:05:43.12,Default,,0,0,0,,Урарака-сан...
Dialogue: 0,0:05:43.24,0:05:45.28,Default,,0,0,0,,Ортада босаңсу
Dialogue: 0,0:05:45.41,0:05:49.46,Default,,0,0,0,,Соңғы шабуыл тым зорлықпен болды.
Dialogue: 0,0:05:49.79,0:05:55.09,Default,,0,0,0,,Егер Хариботе ядролық қару ретінде қарастырылса, мұндай қауіпті әрекет мүмкін болмас еді.
Dialogue: 0,0:05:55.50,0:05:57.59,Default,,0,0,0,,Қарсыласыңызға қарсы шара қолданыңыз.
Dialogue: 0,0:05:57.71,0:06:00.80,Default,,0,0,0,,Дәл осы себепті олар ядролық жекпе-жекке барды...
Dialogue: 0,0:06:00.93,0:06:03.72,Default,,0,0,0,,Иида мырза соңында жауап беруге кешігіп қалды.
Dialogue: 0,0:06:05.05,0:06:05.89,Default,,0,0,0,,Гррр…
Dialogue: 0,0:06:06.14,0:06:07.97,Default,,0,0,0,,Батырлар тобы жеңеді
Dialogue: 0,0:06:08.10,0:06:12.65,Default,,0,0,0,,Бұл жай ғана жаттығу жаттығуы деген болжамнан туындаған бұзушылық сияқты.
Dialogue: 0,0:06:14.52,0:06:18.61,Default,,0,0,0,,Әй... мен ойлағаннан да көп айттыңыз.
Dialogue: 0,0:06:19.28,0:06:21.74,Default,,0,0,0,,Ал... жарайды, бала Иида да.
Dialogue: 0,0:06:21.86,0:06:25.58,Default,,0,0,0,,Әлі де тым қатал бөлімдер бар...
Dialogue: 0,0:06:25.70,0:06:28.87,Default,,0,0,0,,Дұрыс. Куу~!
Dialogue: 0,0:06:29.70,0:06:31.71,Default,,0,0,0,,Әрқашан төменгі сыныптарда жетілдіріңіз
Dialogue: 0,0:06:31.83,0:06:33.83,Default,,0,0,0,,Толық берілген болу үшін көп жұмыс істеу керек.
Dialogue: 0,0:06:33.96,0:06:36.71,Default,,0,0,0,,Бип-бип… (Сирена)
Dialogue: 0,0:06:39.46,0:06:43.05,Default,,0,0,0,,Батырлар бөліміне ұсынылған төрт студенттің бірі!
Dialogue: 0,0:06:43.63,0:06:47.31,Default,,0,0,0,,Жарайды, барлығымыз орындарымызды ауыстырып, екінші матчты бастайық!
Dialogue: 0,0:06:48.01,0:06:52.10,Default,,0,0,0,,Жаттығуды бастамас бұрын алған пікірлеріңізді мұқият ойластырыңыз.
Dialogue: 0,0:06:52.23,0:06:53.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:55.15,0:06:58.44,Default,,0,0,0,,Екінші матч батыр В командасының комбинациясы
Dialogue: 0,0:06:58.86,0:07:01.36,Default,,0,0,0,,Жау (жауыз) командасы I комбинациясы
Dialogue: 0,0:07:01.86,0:07:02.95,Default,,0,0,0,,Оджиро-кун (Оджиро) Иә?
Dialogue: 0,0:07:03.36,0:07:07.20,Default,,0,0,0,,Мен байыпты боламын. Қолғап пен етікімді шешемін!
Dialogue: 0,0:07:07.49,0:07:08.99,Default,,0,0,0,,А... иә
Dialogue: 0,0:07:09.54,0:07:10.70,Default,,0,0,0,,Хагакуре мырза…
Dialogue: 0,0:07:10.83,0:07:13.71,Default,,0,0,0,,Бұл көзге көрінбейтін адам үшін дұрыс таңдау, бірақ...
Dialogue: 0,0:07:13.83,0:07:17.08,Default,,0,0,0,,Бұл этикалық тұрғыдан қыз үшін қауіпті.
Dialogue: 0,0:07:17.42,0:07:19.84,Default,,0,0,0,,Ха! Өйткені сіз оны көре алмайсыз
Dialogue: 0,0:07:19.96,0:07:21.09,Default,,0,0,0,,Жоқ, мен оны көрмеймін.
Dialogue: 0,0:07:21.71,0:07:26.55,Default,,0,0,0,,Өте әсерлі Қвирк қой, иә!➡
Dialogue: 0,0:07:26.68,0:07:28.10,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:07:28.80,0:07:29.89,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:36.77,0:07:40.65,Default,,0,0,0,,Сіз өзіңіздің денеңізді шатырдың ұшында қайталай аласыз!
Dialogue: 0,0:07:42.99,0:07:45.11,Default,,0,0,0,,4-қабаттың солтүстік жағындағы залда жалғыз
Dialogue: 0,0:07:45.24,0:07:47.66,Default,,0,0,0,,Екінші адам бір қабатта бір жерде.
Dialogue: 0,0:07:47.78,0:07:49.58,Default,,0,0,0,,Жалаң аяқ...
Dialogue: 0,0:07:49.91,0:07:53.04,Default,,0,0,0,,Бұларды тұтқындау үшін мөлдір жауапты ма?
Dialogue: 0,0:07:53.16,0:07:56.08,Default,,0,0,0,,Сыртқа шығыңыз, бұл қауіпті.
Dialogue: 0,0:07:56.67,0:08:00.13,Default,,0,0,0,,Қарсы тарап қорғаныс шайқасын ойнауға ниетті шығар, бірақ...
Dialogue: 0,0:08:04.34,0:08:06.05,Default,,0,0,0,,Бұл дәл хоум-ран болған жоқ қой, иә~!?
Dialogue: 0,0:08:15.69,0:08:16.52,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:16.77,0:08:19.02,Default,,0,0,0,,Менің аяғым ауырады...
Dialogue: 0,0:08:20.23,0:08:22.65,Default,,0,0,0,,Бұл... бұл кісі...!
Dialogue: 0,0:08:22.98,0:08:24.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:25.03,0:08:27.78,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:08:31.53,0:08:32.54,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:32.79,0:08:34.25,Default,,0,0,0,,Сіз қозғала аласыз, бірақ
Dialogue: 0,0:08:34.87,0:08:38.12,Default,,0,0,0,,Аяқ терісі шықса, қанағаттанарлықтай күресе алмайсыз.
Dialogue: 0,0:08:38.71,0:08:39.83,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:43.50,0:08:44.92,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:08:45.59,0:08:49.68,Default,,0,0,0,,Одақтастарды тартпаңыз немесе ядролық қаруды зақымдамаңыз
Dialogue: 0,0:08:49.80,0:08:51.80,Default,,0,0,0,,Оның үстіне жау да әлсірейді.
Dialogue: 0,0:08:51.93,0:08:54.10,Default,,0,0,0,,Ең күштісі емес пе!
Dialogue: 0,0:08:54.39,0:08:56.43,Default,,0,0,0,,Ааа аа...
Dialogue: 0,0:08:58.64,0:09:01.61,Default,,0,0,0,,Қаһарман команда ЖЕҢІЛДІ!
Dialogue: 0,0:09:01.73,0:09:02.77,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:07.32,0:09:09.74,Default,,0,0,0,,А, қызба?
Dialogue: 0,0:09:12.95,0:09:14.70,Default,,0,0,0,,Ыстық, ыстық, ыстық...
Dialogue: 0,0:09:17.33,0:09:21.33,Default,,0,0,0,,Бұл нашар болды, деңгейі тым басқа болды.
Dialogue: 0,0:09:23.29,0:09:25.30,Default,,0,0,0,,Бұл кісі де батырлар бөлімінің ұсынылған студенті.
Dialogue: 0,0:09:25.42,0:09:26.67,Default,,0,0,0,,Төртінің бірі!
Dialogue: 0,0:09:27.59,0:09:29.34,Default,,0,0,0,,Тұлға Жартылай салқын, жартылай жанғыш
Dialogue: 0,0:09:29.47,0:09:31.34,Default,,0,0,0,,Оң жақта тоң, сол жақта күй
Dialogue: 0,0:09:31.47,0:09:35.18,Default,,0,0,0,,Ауқымы мен температурасы белгісіз! Бұл құбыжық па?
Dialogue: 0,0:09:35.72,0:09:37.14,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:09:37.27,0:09:38.85,Default,,0,0,0,,Қандай кісілік!
Dialogue: 0,0:09:39.27,0:09:41.60,Default,,0,0,0,,Ұсынылған қабылдау студенті күткендей.
Dialogue: 0,0:09:41.94,0:09:45.36,Default,,0,0,0,,Жарайды, барлығы жиналып, екінші айналымды қайталайды.
Dialogue: 0,0:09:45.65,0:09:48.44,Default,,0,0,0,,Енді үшінші тур басталады!
Dialogue: 0,0:09:48.57,0:09:49.57,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:49.78,0:09:50.82,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:09:55.20,0:09:57.54,Default,,0,0,0,,Хе! иә!
Dialogue: 0,0:09:58.12,0:09:59.33,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:10:01.00,0:10:02.08,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:13.72,0:10:14.72,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:16.64,0:10:17.64,Default,,0,0,0,,Керо Керо…
Dialogue: 0,0:10:21.35,0:10:22.19,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:23.90,0:10:25.23,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:25.36,0:10:26.19,Default,,0,0,0,,Мухохо
Dialogue: 0,0:10:27.57,0:10:29.19,Default,,0,0,0,,Хмм! (Минета) Жоқ, жоқ, жоқ...
Dialogue: 0,0:10:33.61,0:10:35.66,Default,,0,0,0,,Хмм? (Каменари)?
Dialogue: 0,0:10:38.29,0:10:39.54,Default,,0,0,0,,Хехе
Dialogue: 0,0:10:41.12,0:10:44.58,Default,,0,0,0,,Хехехе... Хаа~!
Dialogue: 0,0:10:44.71,0:10:45.75,Default,,0,0,0,,Хмф!
Dialogue: 0,0:10:50.97,0:10:52.34,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:10:55.09,0:10:56.10,Default,,0,0,0,,Осы уақыт бойы көңіл көтердің бе!?
Dialogue: 0,0:10:58.10,0:11:00.81,Default,,0,0,0,,Ах! Ах~! (Ашидо) Эххе
Dialogue: 0,0:11:01.48,0:11:03.81,Default,,0,0,0,,Аа, кешіріңіз, кешіріңіз
Dialogue: 0,0:11:08.32,0:11:09.36,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:17.20,0:11:18.20,Default,,0,0,0,,БУМ‼ (Кацуми) Көрдің бе!?
Dialogue: 0,0:11:18.87,0:11:21.91,Default,,0,0,0,,Мидориядан басқа ешкім ауыр жарақат алған жоқ.
Dialogue: 0,0:11:22.04,0:11:24.17,Default,,0,0,0,,Не деген сұмдық!?
Dialogue: 0,0:11:24.29,0:11:27.75,Default,,0,0,0,,Бұл біздің алғашқы жаттығуымыз болды және барлығы керемет өтті!
Dialogue: 0,0:11:27.88,0:11:30.92,Default,,0,0,0,,Айзава мырзадан кейін осындай лайықты сынып
Dialogue: 0,0:11:33.01,0:11:35.76,Default,,0,0,0,,Менің ойымша, бұл орынсыз...
Dialogue: 0,0:11:36.05,0:11:39.89,Default,,0,0,0,,Тиісті тап – біздің еркіндігіміз де!
Dialogue: 0,0:11:40.01,0:11:44.23,Default,,0,0,0,,Олай болса, мен Жас Мидориияның пікірін тыңдауым керек!
Dialogue: 0,0:11:44.35,0:11:47.40,Default,,0,0,0,,Киіміңді ауыстыр да, сыныпқа қайт!
Dialogue: 0,0:11:47.52,0:11:48.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:49.69,0:11:51.69,Default,,0,0,0,,Барлығы керемет болуы мүмкін!
Dialogue: 0,0:11:51.82,0:11:53.61,Default,,0,0,0,,Неге сонша асығасың...
Dialogue: 0,0:11:53.74,0:11:54.78,Default,,0,0,0,,Керемет...
Dialogue: 0,0:11:57.36,0:12:00.91,Default,,0,0,0,,Бала Бакугу... Бір байлам мақтаныш...
Dialogue: 0,0:12:01.04,0:12:03.95,Default,,0,0,0,,Жүрек неғұрлым ісінсе, соғұрлым нәзік болады.
Dialogue: 0,0:12:04.96,0:12:09.17,Default,,0,0,0,,Мұғалім ретінде мен жан-жақты кеңес беруім керек.
Dialogue: 0,0:12:09.59,0:12:10.75,Default,,0,0,0,,Бірақ қазір...
Dialogue: 0,0:12:13.80,0:12:15.42,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:12:15.55,0:12:17.68,Default,,0,0,0,,Сабақ беру кезінде...
Dialogue: 0,0:12:21.35,0:12:23.89,Default,,0,0,0,,Бұл күннің соңғы жекпе-жегі. Дайынсың ба?!
Dialogue: 0,0:12:24.02,0:12:27.39,Default,,0,0,0,,Уақыт өтіп жатыр! Қат!
Dialogue: 0,0:12:36.28,0:12:39.45,Default,,0,0,0,,Мен мектепке енді ғана барсам да, үшінші рет келіп отырмын!
Dialogue: 0,0:12:39.87,0:12:40.66,Default,,0,0,0,,Неге Бүкіл Құдірет-ты тоқтатпадың!
Dialogue: 0,0:12:40.66,0:12:42.25,Default,,0,0,0,,Неге Бүкіл Құдірет-ты тоқтатпадың!
Dialogue: 0,0:12:42.25,0:12:42.29,Default,,0,0,0,,Неге Бүкіл Құдірет-ты тоқтатпадың!
Dialogue: 0,0:12:42.95,0:12:45.58,Default,,0,0,0,,≪Дұрыс… Деку бұны алдын ала болжаған еді.➡
Dialogue: 0,0:12:45.71,0:12:47.83,Default,,0,0,0,,Менен кешірім сұрасаң не істейсің?
Dialogue: 0,0:12:47.96,0:12:52.63,Default,,0,0,0,,Шаршағаным сонша, бүгін кеше болды, мен бірден емдей алмаймын.
Dialogue: 0,0:12:52.88,0:12:55.68,Default,,0,0,0,,Мен сізге алғашқы көмек көрсеттім, сондықтан барлық тамшылар ішке енген соң...
Dialogue: 0,0:12:55.80,0:12:59.72,Default,,0,0,0,,Жалғыз жол - оны күн сайын біртіндеп белсендіру.
Dialogue: 0,0:13:00.35,0:13:01.68,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:13:01.81,0:13:05.52,Default,,0,0,0,,Құдіретімді саған тапсырған шәкіртпін деп маған оңай болма!
Dialogue: 0,0:13:06.35,0:13:08.60,Default,,0,0,0,,Жауап беретін сөзім жоқ.
Dialogue: 0,0:13:08.73,0:13:11.07,Default,,0,0,0,,Мен оның сезімін түсінгім келеді
Dialogue: 0,0:13:11.19,0:13:14.61,Default,,0,0,0,,Жаттығуды тоқтатуға тартындым.
Dialogue: 0,0:13:14.74,0:13:17.99,Default,,0,0,0,,Мұны... тым қатты орындаңыз.
Dialogue: 0,0:13:18.11,0:13:20.66,Default,,0,0,0,,Біреу үшін бәрі туралы...
Dialogue: 0,0:13:21.41,0:13:22.74,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:13:22.87,0:13:27.08,Default,,0,0,0,,Өйткені мен сенің одан да мықтымын, білесің бе!
Dialogue: 0,0:13:28.62,0:13:31.21,Default,,0,0,0,,Менің сыртқы түрім мен жарақаттарыма қатысты,
Dialogue: 0,0:13:31.34,0:13:35.09,Default,,0,0,0,,Ұлы ұстаздар мен кейбір мамандар жақсы білетін факт.
Dialogue: 0,0:13:35.21,0:13:39.30,Default,,0,0,0,,Дегенмен, менің даралығыма қатысты, «Біреу – бәрі үшін»
Dialogue: 0,0:13:39.43,0:13:42.35,Default,,0,0,0,,Сіз, директор және жақын досыңыз
Dialogue: 0,0:13:42.47,0:13:46.02,Default,,0,0,0,,Бұл дәл хоум-ран болған жоқ қой, иә~!?
Dialogue: 0,0:13:47.19,0:13:50.94,Default,,0,0,0,,Менің ойымша, сіз жоғарыда айқастырып отырғыңыз келмейді.
Dialogue: 0,0:13:51.27,0:13:53.07,Default,,0,0,0,,Бұл шынымен де маңызды ма?
Dialogue: 0,0:13:53.19,0:13:57.03,Default,,0,0,0,,Мен оны… қолданамын деп ойламаған едім
Dialogue: 0,0:13:57.70,0:14:01.66,Default,,0,0,0,,Егер олар жойылып кетсе, адамнан тыс қоғам зұлымдыққа айналады.
Dialogue: 0,0:14:02.24,0:14:06.91,Default,,0,0,0,,Тіпті Айзава мырза➡
Dialogue: 0,0:14:09.12,0:14:10.37,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:14:10.67,0:14:11.96,Default,,0,0,0,,Сонда бәрі жақсы
Dialogue: 0,0:14:12.29,0:14:15.63,Default,,0,0,0,,Бірақ бұл менің ойлай алған жалғыз нәрсем еді
Dialogue: 0,0:14:16.09,0:14:17.22,Default,,0,0,0,,Иә...
Dialogue: 0,0:14:21.97,0:14:25.06,Default,,0,0,0,,Сіз батыр бола аласыз
Dialogue: 0,0:14:26.06,0:14:28.98,Default,,0,0,0,,Менің күшімді қабыл алыңыз
Dialogue: 0,0:14:29.52,0:14:32.61,Default,,0,0,0,,♬~
Dialogue: 0,0:14:33.11,0:14:38.32,Default,,0,0,0,,SMASH!
Dialogue: 0,0:14:40.03,0:14:42.70,Default,,0,0,0,,Кел, Мидорий бала
Dialogue: 0,0:14:43.70,0:14:47.58,Default,,0,0,0,,Бұл сіздің академиялық кейіпкеріңіз.
Dialogue: 0,0:14:48.16,0:14:50.41,Default,,0,0,0,,Біз үйренгелі жатырмыз
Dialogue: 0,0:14:50.54,0:14:52.83,Default,,0,0,0,,Арманыңызға жақындау үшін!
Dialogue: 0,0:14:54.96,0:14:58.42,Default,,0,0,0,,Е?.. Иә.
Dialogue: 0,0:14:58.55,0:15:00.84,Default,,0,0,0,,Каччан I...
Dialogue: 0,0:15:01.76,0:15:04.01,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:15:06.39,0:15:08.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:15.48,0:15:16.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:17.69,0:15:19.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:23.61,0:15:25.91,Default,,0,0,0,,Әйтеуір, бұл тек жаттығу ғана.
Dialogue: 0,0:15:26.03,0:15:28.83,Default,,0,0,0,,Сіз ояусыз ба? (Изуку) Ха!
Dialogue: 0,0:15:31.87,0:15:33.71,Default,,0,0,0,,Бүгінгі емнің бәрі осы.
Dialogue: 0,0:15:33.83,0:15:35.96,Default,,0,0,0,,Ол да ертең келеді, жарай ма?
Dialogue: 0,0:15:36.59,0:15:37.88,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:15:38.38,0:15:41.09,Default,,0,0,0,,Мен түстен кейінгі сабағымды қалдырдым.
Dialogue: 0,0:15:41.22,0:15:44.05,Default,,0,0,0,,Айзава Сенсэйдің байлауы...
Dialogue: 0,0:15:49.47,0:15:51.85,Default,,0,0,0,,О~ Мидория келді! (Изуку) А...
Dialogue: 0,0:15:51.98,0:15:53.23,Default,,0,0,0,,Жақсы жұмыс! (Изуку) Ах!
Dialogue: 0,0:15:53.64,0:15:56.40,Default,,0,0,0,,Не туралы айтып тұрғаныңызды түсінбедім.
Dialogue: 0,0:15:56.52,0:15:58.15,Default,,0,0,0,,Ыстық болды, адам!
Dialogue: 0,0:15:58.27,0:16:01.61,Default,,0,0,0,,Қабылдау емтиханында бірінші орын алған Бакугумен жарысатыныма сене алар емеспін!
Dialogue: 0,0:16:01.74,0:16:02.99,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:16:03.11,0:16:07.16,Default,,0,0,0,,Бірінші ойында осылай соққы алдық, сондықтан біз оған көп күш салдық!
Dialogue: 0,0:16:07.28,0:16:08.70,Default,,0,0,0,,Ол талғампаздықтан алыс еді...
Dialogue: 0,0:16:08.83,0:16:10.33,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:16:10.62,0:16:11.95,Default,,0,0,0,,Не? Иә?
Dialogue: 0,0:16:12.54,0:16:14.37,Default,,0,0,0,,Мен Эйдзиро Киришимамын
Dialogue: 0,0:16:14.50,0:16:16.96,Default,,0,0,0,,Өйткені мен сенің одан да мықтымын, білесің бе!
Dialogue: 0,0:16:17.08,0:16:18.54,Default,,0,0,0,,I, Ханта Серо
Dialogue: 0,0:16:18.67,0:16:19.96,Default,,0,0,0,,Мен Аоямын...
Dialogue: 0,0:16:20.09,0:16:23.47,Default,,0,0,0,,Мен, Мина Ашидо! Мен одан жақсы құтылдым!
Dialogue: 0,0:16:23.59,0:16:26.22,Default,,0,0,0,,Жаңбырлы маусым, мені Цюйю-чан деп атаңыз.
Dialogue: 0,0:16:26.80,0:16:27.85,Default,,0,0,0,,Мен, Сато!
Dialogue: 0,0:16:28.01,0:16:29.68,Default,,0,0,0,,Мм... бұл...
Dialogue: 0,0:16:29.81,0:16:31.35,Default,,0,0,0,,Мен Минетамын! (Изуку және т.б.) О!
Dialogue: 0,0:16:31.72,0:16:32.93,Default,,0,0,0,,Қайдан келе жатырсың?
Dialogue: 0,0:16:32.93,0:16:33.85,Default,,0,0,0,,Қайдан келе жатырсың?
Dialogue: 0,0:16:32.93,0:16:33.85,Default,,0,0,0,,Мен талғампаз Аоямын
Dialogue: 0,0:16:33.85,0:16:33.98,Default,,0,0,0,,Мен талғампаз Аоямын
Dialogue: 0,0:16:33.98,0:16:34.44,Default,,0,0,0,,Мен талғампаз Аоямын
Dialogue: 0,0:16:33.98,0:16:34.44,Default,,0,0,0,,Сіздің жаттығуларыңыз қорқынышты болды.
Dialogue: 0,0:16:34.44,0:16:34.56,Default,,0,0,0,,Сіздің жаттығуларыңыз қорқынышты болды.
Dialogue: 0,0:16:34.56,0:16:36.15,Default,,0,0,0,,Сіздің жаттығуларыңыз қорқынышты болды.
Dialogue: 0,0:16:34.56,0:16:36.15,Default,,0,0,0,,Жарқылдауды тоқтата алмайтын жігіт!
Dialogue: 0,0:16:36.15,0:16:36.27,Default,,0,0,0,,Жарқылдауды тоқтата алмайтын жігіт!
Dialogue: 0,0:16:36.27,0:16:37.52,Default,,0,0,0,,Жарқылдауды тоқтата алмайтын жігіт!
Dialogue: 0,0:16:36.27,0:16:37.52,Default,,0,0,0,,Шулы...
Dialogue: 0,0:16:38.06,0:16:39.44,Default,,0,0,0,,Токоями-кун!
Dialogue: 0,0:16:39.86,0:16:42.74,Default,,0,0,0,,Парта табуретка емес, оны қазір тоқтатыңыз!
Dialogue: 0,0:16:43.11,0:16:45.28,Default,,0,0,0,,Бұл жақсы емес пе? (Иида) Нану!?
Dialogue: 0,0:16:45.40,0:16:47.53,Default,,0,0,0,,Не? сол қол
Dialogue: 0,0:16:48.28,0:16:50.12,Default,,0,0,0,,Бірақ бұл менің ойлай алған жалғыз нәрсем еді
Dialogue: 0,0:16:50.70,0:16:54.71,Default,,0,0,0,,Ұлы ізашарларымыз пайдаланған парталарды елеусіз қалдыру әрекеті.
Dialogue: 0,0:16:54.83,0:16:56.12,Default,,0,0,0,,елемеуге болмайды!
Dialogue: 0,0:16:56.25,0:16:57.75,Default,,0,0,0,,Шулы...
Dialogue: 0,0:16:58.13,0:17:00.25,Default,,0,0,0,,Айналма, Иида-кун.
Dialogue: 0,0:17:01.67,0:17:04.67,Default,,0,0,0,,Әй, Урарақа, келесі жолы тамақ ішпейміз бе?
Dialogue: 0,0:17:04.80,0:17:06.18,Default,,0,0,0,,Сізге не ұнайды?
Dialogue: 0,0:17:06.59,0:17:08.47,Default,,0,0,0,,Мочи... Ах! (Канам) Иә?
Dialogue: 0,0:17:08.59,0:17:11.18,Default,,0,0,0,,Иә? Деку-кун, жараңды емдей алмадың ба?
Dialogue: 0,0:17:11.31,0:17:14.93,Default,,0,0,0,,А, жоқ... бұл менің физикалық күшім ғана.
Dialogue: 0,0:17:15.06,0:17:16.10,Default,,0,0,0,,Иә? (Изуку) Ах!
Dialogue: 0,0:17:17.56,0:17:20.98,Default,,0,0,0,,Сол Рейхи-сан, одан да көп...
Dialogue: 0,0:17:21.19,0:17:22.27,Default,,0,0,0,,Ол Жалпы курсқа да өтініш бергендіктен, олар бұған алдын ала дайын болған шығар.
Dialogue: 0,0:17:22.40,0:17:26.61,Default,,0,0,0,,Мен бәрін тоқтаттым, бірақ олар үндеместен үйлеріне қайтты.
Dialogue: 0,0:17:27.95,0:17:28.99,Default,,0,0,0,,Hey, hey!
Dialogue: 0,0:17:29.57,0:17:33.58,Default,,0,0,0,,Сен мені алдадың! Бұл әрқашан көңілді болды ма?
Dialogue: 0,0:17:35.08,0:17:37.87,Default,,0,0,0,,Оның мінезі өте жарқыраған!
Dialogue: 0,0:17:38.00,0:17:41.59,Default,,0,0,0,,Ха ха ха ха... Ах!
Dialogue: 0,0:17:45.72,0:17:46.55,Default,,0,0,0,,Ха~ ха ха ха ха! Қандай бет-әлпет ол?
Dialogue: 0,0:17:49.43,0:17:50.72,Default,,0,0,0,,Ха~ ха ха ха ха! Қандай бет-әлпет ол?
Dialogue: 0,0:17:53.31,0:17:54.31,Default,,0,0,0,,Әй?
Dialogue: 0,0:17:54.72,0:17:56.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:59.60,0:18:02.73,Default,,0,0,0,,Анама айтпаған сырым
Dialogue: 0,0:18:03.69,0:18:05.07,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:07.11,0:18:12.12,Default,,0,0,0,,Мен мұны сізге айтуым керек сияқты...
Dialogue: 0,0:18:13.91,0:18:18.50,Default,,0,0,0,,Өткен күндерге дейін ол жол жиегіндегі жай ғана тас еді, иә?≫
Dialogue: 0,0:18:18.79,0:18:19.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:19.75,0:18:22.00,Default,,0,0,0,,Сіз ешқашан ешкімге айта алмайсыз!
Dialogue: 0,0:18:22.54,0:18:27.88,Default,,0,0,0,,Мен айтпаймын... Бірақ бұл комикс сияқты, бірақ бұл рас...
Dialogue: 0,0:18:28.55,0:18:31.84,Default,,0,0,0,,Не керек, мен оны әлі де жақсы ұстай алмаймын...
Dialogue: 0,0:18:32.09,0:18:35.60,Default,,0,0,0,,Бұл мүлде нақты затқа айналмаған қарызға алынған нәрсе...
Dialogue: 0,0:18:35.72,0:18:36.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:36.68,0:18:40.81,Default,,0,0,0,,Сондықтан мен оны қолданбай, сені ұруға тырыстым.
Dialogue: 0,0:18:41.15,0:18:43.90,Default,,0,0,0,,Бірақ соңында жеңе алмадым, соған сүйендім.
Dialogue: 0,0:18:44.02,0:18:45.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:46.57,0:18:49.61,Default,,0,0,0,,Мен әлі ол жерде емеспін... Сонымен...
Dialogue: 0,0:18:49.95,0:18:51.86,Default,,0,0,0,,Ух... (Изуку) Сонымен...
Dialogue: 0,0:18:53.45,0:18:59.16,Default,,0,0,0,,Бір күні мен бұл даралықты өзімдікі етем.
Dialogue: 0,0:18:59.75,0:19:02.42,Default,,0,0,0,,Менің күшім сенен асып түседі!
Dialogue: 0,0:19:05.50,0:19:06.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:06.46,0:19:10.67,Default,,0,0,0,,Мен сені алдамағанымды айту үшін келдім, бірақ мен не істедім...
Dialogue: 0,0:19:11.59,0:19:13.76,Default,,0,0,0,,Бұл не... (Изуку) Ах!
Dialogue: 0,0:19:14.26,0:19:17.77,Default,,0,0,0,,Қарызға алынған заттар? Мен түсінбейтін нәрселерді айту ...
Dialogue: 0,0:19:18.97,0:19:24.23,Default,,0,0,0,,Мына мүкті тағы не істейсің... Эй!
Dialogue: 0,0:19:25.15,0:19:27.15,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:19:27.48,0:19:30.61,Default,,0,0,0,,Бүгін мен сенен жеңілдім
Dialogue: 0,0:19:31.11,0:19:33.36,Default,,0,0,0,,Мен солай деп ойлаймын.
Dialogue: 0,0:19:33.66,0:19:35.53,Default,,0,0,0,,Достардан артықсыңдар деп тұрған жоқсың ғой?
Dialogue: 0,0:19:37.74,0:19:39.70,Default,,0,0,0,,Мына мұз жігітке қарашы—
Dialogue: 0,0:19:40.33,0:19:42.96,Default,,0,0,0,,Мен жай ғана ойладым: «Оны жеңу мүмкін емес!»
Dialogue: 0,0:19:43.58,0:19:46.29,Default,,0,0,0,,Үй ішінде кең ауқымды шабуылдар - жаман идея
Dialogue: 0,0:19:46.67,0:19:47.63,Default,,0,0,0,,Қайтарушы Турбо
Dialogue: 0,0:19:47.75,0:19:51.76,Default,,0,0,0,,Құйрықты жігіттің айтқанына қосыламын!
Dialogue: 0,0:19:52.09,0:19:55.22,Default,,0,0,0,,Құдай-ай! Құдай-ай! Құдай-ай!
Dialogue: 0,0:19:56.35,0:19:59.60,Default,,0,0,0,,Ей! Сен де, Деку!
Dialogue: 0,0:20:00.60,0:20:04.27,Default,,0,0,0,,Міне, дәл осы жерден басталады! Мен дәл осы жерден бастаймын!
Dialogue: 0,0:20:04.48,0:20:08.61,Default,,0,0,0,,Бірақ қалай…
Dialogue: 0,0:20:09.98,0:20:10.99,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:11.90,0:20:13.20,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:14.45,0:20:18.53,Default,,0,0,0,,Сен мені енді ешқашан ұрмайсың, қарғыс атсын!
Dialogue: 0,0:20:21.66,0:20:23.41,Default,,0,0,0,,Уф! Күрсін...
Dialogue: 0,0:20:23.62,0:20:25.33,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:20:25.46,0:20:26.58,Default,,0,0,0,,(Миямура) Ау!
Dialogue: 0,0:20:26.79,0:20:29.92,Default,,0,0,0,,Бұны алдын ала білгендіктен, жаттығуды жеңу жоспарын құрған…≫
Dialogue: 0,0:20:30.05,0:20:32.80,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:20:32.92,0:20:37.18,Default,,0,0,0,,Мен сізге айта кетейін, өзін-өзі бағалау маңызды.
Dialogue: 0,0:20:37.30,0:20:41.14,Default,,0,0,0,,Сізде кәсіпқой болу мүмкіндігі сөзсіз!
Dialogue: 0,0:20:41.27,0:20:42.85,Default,,0,0,0,,Сізде әлі көп жол бар...
Dialogue: 0,0:20:42.98,0:20:46.15,Default,,0,0,0,,Өтінемін, мені жіберіңізші, Барлық мүмкін, мен жүре алмаймын.
Dialogue: 0,0:20:46.27,0:20:47.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:47.81,0:20:53.07,Default,,0,0,0,,Айтпасаң да, өзіңнен де асып түсетін батыр боламын!
Dialogue: 0,0:20:53.28,0:20:54.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:55.49,0:20:57.87,Default,,0,0,0,,Иә...
Dialogue: 0,0:20:58.74,0:21:00.45,Default,,0,0,0,,Мен аяғымнан тұрдым.
Dialogue: 0,0:21:04.33,0:21:07.71,Default,,0,0,0,,Мұғалім болу қиын...
Dialogue: 0,0:21:09.17,0:21:11.09,Default,,0,0,0,,Бұл не болды? Бұл
Dialogue: 0,0:21:11.21,0:21:13.13,Default,,0,0,0,,Бұл адамның тағдыры!
Dialogue: 0,0:21:13.26,0:21:17.97,Default,,0,0,0,,Мидория біржақты сылтау айтып тұрғандай болды.
Dialogue: 0,0:21:18.09,0:21:20.22,Default,,0,0,0,,БУМ‼ (Кацуми) Көрдің бе!?
Dialogue: 0,0:21:21.72,0:21:24.56,Default,,0,0,0,,Каччанның сақтандырғышы жанды
Dialogue: 0,0:21:25.48,0:21:30.02,Default,,0,0,0,,Менің істегенім өзгеріссіз қалады. Мен сенің ізіңмен ғана жүремін.
Dialogue: 0,0:21:31.48,0:21:32.78,Default,,0,0,0,,Жас Мидория!
Dialogue: 0,0:21:33.15,0:21:36.11,Default,,0,0,0,,Сіз жас Бакугомен не туралы сөйлестіңіз?
Dialogue: 0,0:21:36.24,0:21:37.99,Default,,0,0,0,,А, жоқ, бұл... бұл...
Dialogue: 0,0:21:38.11,0:21:40.12,Default,,0,0,0,,Хмм, маған бәрібір.
Dialogue: 0,0:21:40.62,0:21:42.62,Default,,0,0,0,,Толығырақ айтып бере аласыз ба?
Dialogue: 0,0:21:42.74,0:21:45.96,Default,,0,0,0,,Ах, у... джи... шын мәнінде...
Dialogue: 0,0:21:49.58,0:21:54.59,Default,,0,0,0,,♪～
Dialogue: 0,0:23:12.54,0:23:17.55,Default,,0,0,0,,～♪
Dialogue: 0,0:23:22.68,0:23:27.10,Default,,0,0,0,,Бірнеше күннен кейін біз білеміз
Dialogue: 0,0:23:29.35,0:23:34.73,Default,,0,0,0,,Бүкіл Құдірет зұлымдардың нағыз қорқынышын айтып еді...
Dialogue: 0,0:23:36.94,0:23:41.24,Default,,0,0,0,,Көрдіңіз бе? Бұл... мұғалім.
Dialogue: 0,0:23:43.70,0:23:47.87,Default,,0,0,0,,Эй, не болады деп ойлайсың?
Dialogue: 0,0:23:49.20,0:23:51.58,Default,,0,0,0,,Бірақ бұл менің ойлай алған жалғыз нәрсем еді
Dialogue: 0,0:23:56.09,0:23:58.80,Default,,0,0,0,,[Диктор] (Ол Майт) Жабық кеңістіктегі қысқа қашықтықтағы жекпе-жек жаттығулары…
Dialogue: 0,0:24:00.80,0:24:02.97,Default,,0,0,0,,Әрбір кейіпкердің бастау нүктесі болады
Dialogue: 0,0:24:03.09,0:24:04.97,Default,,0,0,0,,Келесі жолы «Жарайсың, Иида-кун!»
Dialogue: 0,0:24:05.26,0:24:08.47,Default,,0,0,0,,Түрлі себептерге байланысты жас Мидорияны қалың жұрт алып кетеді.
Dialogue: 0,0:24:08.60,0:24:09.64,Default,,0,0,0,,Бізбен бірге болыңыз!
Dialogue: 0,0:24:09.89,0:24:12.06,Default,,0,0,0,,Әрі қарай!
Dialogue: 0,0:24:12.18,0:24:14.90,Default,,0,0,0,,Plus Ultra！
Dialogue: 0,0:24:16.40,0:24:22.40,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
