Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.73,Default,,0,0,0,,♪ Қатал періште сияқты
Dialogue: 0,0:00:06.86,0:00:13.87,Default,,0,0,0,,♪ Бала, мифке айнал
Dialogue: 0,0:00:14.83,0:00:21.83,Default,,0,0,0,,♪
Dialogue: 0,0:00:22.71,0:00:25.63,Default,,0,0,0,,♪ Қазір көк жел
Dialogue: 0,0:00:25.75,0:00:29.34,Default,,0,0,0,,♪ Кеуденің есігін қағып кетсем де
Dialogue: 0,0:00:29.47,0:00:33.05,Default,,0,0,0,,♪ Маған қарашы
Dialogue: 0,0:00:33.18,0:00:37.35,Default,,0,0,0,,♪ Сіз күліп тұрсыз
Dialogue: 0,0:00:37.47,0:00:40.43,Default,,0,0,0,,♪ Сізге жайлап тиетін нәрсе
Dialogue: 0,0:00:40.56,0:00:44.27,Default,,0,0,0,,♪ Мен іздеген нәрсеге құмармын
Dialogue: 0,0:00:44.40,0:00:47.94,Default,,0,0,0,,♪ Мен өз тағдырымды әлі білмеймін
Dialogue: 0,0:00:48.07,0:00:51.82,Default,,0,0,0,,♪ Әдемі көздер
Dialogue: 0,0:00:51.95,0:00:55.57,Default,,0,0,0,,♪ Бірақ бір күні сіз түсінесіз
Dialogue: 0,0:00:55.70,0:00:58.54,Default,,0,0,0,,♪ Артқы жағында
Dialogue: 0,0:00:59.50,0:01:01.29,Default,,0,0,0,,♪ Болашақта
Dialogue: 0,0:01:01.41,0:01:06.50,Default,,0,0,0,,♪ Мақсат қоятын қанаттары бар
Dialogue: 0,0:01:06.88,0:01:10.63,Default,,0,0,0,,♪ Қатыгез періштенің тезисі
Dialogue: 0,0:01:10.76,0:01:13.88,Default,,0,0,0,,♪ Терезеден ол көп ұзамай ұшып кетеді
Dialogue: 0,0:01:14.39,0:01:18.10,Default,,0,0,0,,♪ Құмарлы пафоспен
Dialogue: 0,0:01:18.22,0:01:21.39,Default,,0,0,0,,♪ Егер сіз естеліктеріңізге опасыздық жасасаңыз
Dialogue: 0,0:01:21.85,0:01:25.44,Default,,0,0,0,,♪ Бұл ғаламды құшақтап, жарқыратыңыз
Dialogue: 0,0:01:25.56,0:01:29.36,Default,,0,0,0,,♪ Бала, мифке айнал.
Dialogue: 0,0:01:32.95,0:01:35.07,Default,,0,0,0,,Нысананың ішіндегі жоғары энергия реакциясы!
Dialogue: 0,0:01:35.20,0:01:36.03,Default,,0,0,0,,Не дедің!
Dialogue: 0,0:01:36.28,0:01:37.24,Default,,0,0,0,,Айналаны жеделдету
Dialogue: 0,0:01:37.37,0:01:39.12,Default,,0,0,0,,(Аоба) Ол жақындайды. Мүмкін емес!
Dialogue: 0,0:01:39.24,0:01:46.00,Default,,0,0,0,,♪
Dialogue: 0,0:01:46.17,0:01:47.59,Default,,0,0,0,,Жоқ!аулақ болыңыз!сурет?
Dialogue: 0,0:01:52.76,0:01:54.01,Default,,0,0,0,,Эй…
Dialogue: 0,0:01:54.13,0:01:55.47,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:01:55.93,0:01:57.05,Default,,0,0,0,,Оны қайтар!тез!
Dialogue: 0,0:01:58.85,0:02:00.77,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:02:03.48,0:02:04.48,Default,,0,0,0,,Мақсат Толық үнсіздік!
Dialogue: 0,0:02:04.94,0:02:06.02,Default,,0,0,0,,Сен ше, Синдзи?
Dialogue: 0,0:02:06.15,0:02:06.98,Default,,0,0,0,,Тірі!
Dialogue: 0,0:02:07.15,0:02:09.90,Default,,0,0,0,,01 қондырғысын 7 торға қалпына келтіру
Dialogue: 0,0:02:10.44,0:02:13.11,Default,,0,0,0,,Мен Кейджиге барамын. Рақмет сізге.
Dialogue: 0,0:02:15.28,0:02:17.49,Default,,0,0,0,,Бірінші блокты бекіту аяқталды
Dialogue: 0,0:02:18.74,0:02:21.83,Default,,0,0,0,,(Хината) Ұшқыштың ми толқындары бұзылған.Жүрек тондары әлсіз!
Dialogue: 0,0:02:22.50,0:02:24.37,Default,,0,0,0,,Тіршілікті қолдау жүйесі Макс.
Dialogue: 0,0:02:24.50,0:02:26.00,Default,,0,0,0,,Жүрек массажы (Хината) Иә!
Dialogue: 0,0:02:26.33,0:02:27.17,Default,,0,0,0,,(Ток соғу дыбысы)
Dialogue: 0,0:02:27.83,0:02:28.96,Default,,0,0,0,,Импульсті растау!
Dialogue: 0,0:02:29.09,0:02:30.71,Default,,0,0,0,,Штепсельді мәжбүрлеп алу Асығыңыз
Dialogue: 0,0:02:34.88,0:02:36.93,Default,,0,0,0,,L.C.L. Апаттық дренаж иә!
Dialogue: 0,0:02:38.34,0:02:40.18,Default,,0,0,0,,Жарайды, люкті ашып, асығыңыз!
Dialogue: 0,0:02:44.98,0:02:46.94,Default,,0,0,0,,Кіру тығынын алып тастау аяқталды
Dialogue: 0,0:02:47.06,0:02:48.65,Default,,0,0,0,,Ұшқыштың аман қалғаны расталды
Dialogue: 0,0:02:48.77,0:02:49.73,Default,,0,0,0,,Құтқару тобы, асығыңыз!
Dialogue: 0,0:02:50.02,0:02:50.94,Default,,0,0,0,,Синдзи-кун!
Dialogue: 0,0:03:26.27,0:03:30.10,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:03:34.36,0:03:35.99,Default,,0,0,0,,Жау бөлшектерінің зеңбірегі тиді
Dialogue: 0,0:03:36.40,0:03:37.49,Default,,0,0,0,,Жалған булану
Dialogue: 0,0:03:37.61,0:03:38.45,Default,,0,0,0,,Келесі!
Dialogue: 0,0:03:52.63,0:03:55.13,Default,,0,0,0,,12 типті өздігінен жүретін миномет жоғалып кетті
Dialogue: 0,0:03:56.13,0:03:57.34,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:57.46,0:03:58.42,Default,,0,0,0,,♪
Dialogue: 0,0:03:58.42,0:04:00.63,Default,,0,0,0,,♪ (Ер қызметкер 1) Осы уақытқа дейін жиналған деректер бойынша,
Dialogue: 0,0:04:00.63,0:04:01.13,Default,,0,0,0,,♪
Dialogue: 0,0:04:00.76,0:04:02.97,Default,,0,0,0,,♪ Нысана – белгілі бір қашықтықтағы сыртқы жау.
Dialogue: 0,0:04:02.97,0:04:03.47,Default,,0,0,0,,♪
Dialogue: 0,0:04:03.10,0:04:04.47,Default,,0,0,0,,♪ Ол автоматты түрде алынып тасталады деп болжанады.
Dialogue: 0,0:04:04.47,0:04:05.26,Default,,0,0,0,,Ол автоматты түрде алынып тасталады деп болжанады.
Dialogue: 0,0:04:05.72,0:04:07.27,Default,,0,0,0,,Аймаққа кірумен бір мезгілде
Dialogue: 0,0:04:07.39,0:04:10.27,Default,,0,0,0,,Бөлшектер зеңбірегімен 100% нысанаға алу
Dialogue: 0,0:04:10.39,0:04:13.81,Default,,0,0,0,,Евамен жақын шайқас тым қауіпті.
Dialogue: 0,0:04:13.94,0:04:15.19,Default,,0,0,0,,A.T.field туралы не деуге болады?
Dialogue: 0,0:04:15.69,0:04:16.65,Default,,0,0,0,,Әлі тірі және жақсы
Dialogue: 0,0:04:16.94,0:04:19.28,Default,,0,0,0,,Фазалық ауысу кеңістігін жай көзбен көруге болады
Dialogue: 0,0:04:19.40,0:04:21.53,Default,,0,0,0,,Күшті нәрсе ашылып жатыр
Dialogue: 0,0:04:22.41,0:04:25.87,Default,,0,0,0,,Басқарылатын артиллериялық бомбалау сияқты шикі шабуылдарда,
Dialogue: 0,0:04:25.99,0:04:28.16,Default,,0,0,0,,Менің жылауымды көру ғана.
Dialogue: 0,0:04:28.29,0:04:30.66,Default,,0,0,0,,Шабуылда да, қорғаныста да мінсіз дерлік.
Dialogue: 0,0:04:30.79,0:04:32.96,Default,,0,0,0,,Бұл шын мәнінде қалқымалы бекініс.
Dialogue: 0,0:04:33.08,0:04:34.75,Default,,0,0,0,,Қарастырылып отырған қалқан ше?
Dialogue: 0,0:04:35.25,0:04:37.38,Default,,0,0,0,,Мақсат енді біздің үстімізде.
Dialogue: 0,0:04:37.50,0:04:39.97,Default,,0,0,0,,Үшінші Жаңа Токио қаласы нөлдік аймақты басып алды
Dialogue: 0,0:04:40.47,0:04:42.97,Default,,0,0,0,,Диаметрі 17,5 метр болатын үлкен қалқан
Dialogue: 0,0:04:43.09,0:04:45.30,Default,,0,0,0,,Geofront ішінде, NERV штаб-пәтеріне барыңыз
Dialogue: 0,0:04:45.43,0:04:46.89,Default,,0,0,0,,Бұрғылау орындалуда
Dialogue: 0,0:04:47.77,0:04:49.48,Default,,0,0,0,,Жау NERV штаб-пәтерінде.
Dialogue: 0,0:04:49.60,0:04:51.85,Default,,0,0,0,,Сіз тікелей шабуыл жасағыңыз келеді.
Dialogue: 0,0:04:51.98,0:04:53.85,Default,,0,0,0,,Шарақұсай
Dialogue: 0,0:04:53.98,0:04:55.86,Default,,0,0,0,,Болжалды келу уақыты қандай?
Dialogue: 0,0:04:56.27,0:04:59.78,Default,,0,0,0,,(3-ер қызметкер) Иә, ертең таңертең 12:06:54.
Dialogue: 0,0:05:00.07,0:05:01.03,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:05:01.15,0:05:03.78,Default,,0,0,0,,Құрыш қорғанысының барлық 22 қабатына енеді
Dialogue: 0,0:05:03.91,0:05:06.70,Default,,0,0,0,,Ол NERV штаб-пәтеріне жетеді деп есептеледі.
Dialogue: 0,0:05:07.83,0:05:09.83,Default,,0,0,0,,10 сағаттан аз уақыт қалды...
Dialogue: 0,0:05:15.08,0:05:17.42,Default,,0,0,0,,(Аоба) Қарсыластың қалқаны 1-ші сауыт тақтасы
Dialogue: 0,0:05:18.00,0:05:20.21,Default,,0,0,0,,Бұл бірінші машинаның күйі қандай?
Dialogue: 0,0:05:20.71,0:05:24.43,Default,,0,0,0,,Кеудедегі үшінші сауыт тақтайшасына дейін әбден еріген
Dialogue: 0,0:05:24.55,0:05:26.51,Default,,0,0,0,,Функционалдық орталық зақымдалмаған.
Dialogue: 0,0:05:26.64,0:05:28.39,Default,,0,0,0,,Бұл бір игілік
Dialogue: 0,0:05:28.51,0:05:30.18,Default,,0,0,0,,Егер ол тағы 3 секунд сәулеленген болса
Dialogue: 0,0:05:30.31,0:05:31.14,Default,,0,0,0,,Бұл шықты.
Dialogue: 0,0:05:32.02,0:05:35.06,Default,,0,0,0,,(Ер қызметкер) Ауыстыру жұмысы үш сағатта аяқталады деп жоспарланған.
Dialogue: 0,0:05:35.73,0:05:37.61,Default,,0,0,0,,Түсінікті.0 бірлік туралы не деуге болады?
Dialogue: 0,0:05:38.32,0:05:40.69,Default,,0,0,0,,Өзін қайта іске қосуда ешқандай проблема жоқ.
Dialogue: 0,0:05:40.82,0:05:43.03,Default,,0,0,0,,Кері байланыста әлі де қате бар.
Dialogue: 0,0:05:43.15,0:05:43.99,Default,,0,0,0,,Нақты шайқас...
Dialogue: 0,0:05:44.45,0:05:45.95,Default,,0,0,0,,Әлі де мүмкін емес пе?
Dialogue: 0,0:05:46.53,0:05:48.41,Default,,0,0,0,,01 блок үшін ұшқыштың жағдайы қандай?
Dialogue: 0,0:05:49.28,0:05:50.91,Default,,0,0,0,,Физикалық ауытқу жоқ.
Dialogue: 0,0:05:51.04,0:05:53.83,Default,,0,0,0,,Жүйке тамыр соғуым 0,8 артты.
Dialogue: 0,0:05:54.04,0:05:55.50,Default,,0,0,0,,Қолайлы ауқымда
Dialogue: 0,0:05:56.50,0:05:59.88,Default,,0,0,0,,(Аоба) Жау қалқанына жеткенше 9 сағат 55 минут қалды.
Dialogue: 0,0:06:00.67,0:06:02.80,Default,,0,0,0,,Жағдайлары жақсы емес.
Dialogue: 0,0:06:02.92,0:06:04.97,Default,,0,0,0,,Ақ туды көтереміз бе?
Dialogue: 0,0:06:05.09,0:06:09.22,Default,,0,0,0,,Бұған дейін мен бір нәрсені байқап көргім келеді.
Dialogue: 0,0:06:10.22,0:06:11.47,Default,,0,0,0,,Мақсатты ауқымнан тыс—
Dialogue: 0,0:06:11.60,0:06:13.85,Default,,0,0,0,,Өте ұзақ қашықтықтан тікелей ату.
Dialogue: 0,0:06:14.39,0:06:15.27,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:06:15.39,0:06:17.65,Default,,0,0,0,,Нысананың А.Т.-ны бейтараптандырмай. өріс
Dialogue: 0,0:06:17.77,0:06:19.77,Default,,0,0,0,,Жарып өтудің жалғыз жолы - жоғары энергияға бағытталған дене.
Dialogue: 0,0:06:19.90,0:06:20.86,Default,,0,0,0,,Амал жоқ
Dialogue: 0,0:06:20.98,0:06:21.82,Default,,0,0,0,,MAGI бұл
Dialogue: 0,0:06:21.94,0:06:22.78,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:22.90,0:06:25.24,Default,,0,0,0,,MAGI суперкомпьютері жауап береді
Dialogue: 0,0:06:25.36,0:06:28.78,Default,,0,0,0,,2 жақтап, 1 жақтау шартымен.
Dialogue: 0,0:06:28.91,0:06:31.62,Default,,0,0,0,,Жеңіске жету мүмкіндігі 8,7%.
Dialogue: 0,0:06:31.95,0:06:33.54,Default,,0,0,0,,- ең жоғары сан
Dialogue: 0,0:06:34.29,0:06:36.42,Default,,0,0,0,,Қарсылық білдіруге негіз жоқ.
Dialogue: 0,0:06:36.54,0:06:38.46,Default,,0,0,0,,Жаса, бірінші лейтенант Катсураги
Dialogue: 0,0:06:39.08,0:06:40.09,Default,,0,0,0,,Иә
Dialogue: 0,0:06:40.71,0:06:43.80,Default,,0,0,0,,Бірақ сіз басқа ақылсыз жоспар ойлап таптыңыз.
Dialogue: 0,0:06:43.92,0:06:45.47,Default,,0,0,0,,Катсураги мырза операциялық директор?
Dialogue: 0,0:06:45.72,0:06:48.05,Default,,0,0,0,,Муча дегеніміз не? Тағы да кешіріңіз.
Dialogue: 0,0:06:48.18,0:06:50.14,Default,,0,0,0,,Қалған 9 сағат ішінде қол жеткізуге болады
Dialogue: 0,0:06:50.47,0:06:52.72,Default,,0,0,0,,Оның үстіне бұл ең сенімді.
Dialogue: 0,0:06:52.85,0:06:54.27,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:06:54.39,0:06:56.23,Default,,0,0,0,,Менің позитрон мылтығым
Dialogue: 0,0:06:56.35,0:06:58.94,Default,,0,0,0,,Мен сонша күшке төтеп бере алмаймын.
Dialogue: 0,0:06:59.06,0:06:59.90,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:07:00.44,0:07:02.48,Default,,0,0,0,,Сіз шешіп қойғансыз, солай ма? Мен оны қарызға аламын.
Dialogue: 0,0:07:03.11,0:07:05.86,Default,,0,0,0,,Мен оны ешқашан қарызға аламын деп ойламадым ...
Dialogue: 0,0:07:07.07,0:07:09.16,Default,,0,0,0,,Иә, Сенжікен прототипі.
Dialogue: 0,0:07:11.12,0:07:14.45,Default,,0,0,0,,Жоғарыда аталған себептерге байланысты бұл өздігінен жүретін позитрондық зеңбірек
Dialogue: 0,0:07:14.58,0:07:15.87,Default,,0,0,0,,Бүгін сағат 15:00-ден бастап
Dialogue: 0,0:07:16.00,0:07:18.08,Default,,0,0,0,,NERV құпия агенттігі оны жинайды.
Dialogue: 0,0:07:18.79,0:07:20.29,Default,,0,0,0,,Дегенмен...
Dialogue: 0,0:07:20.42,0:07:21.71,Default,,0,0,0,,Бірақ бұл өте ашуланшақ!
Dialogue: 0,0:07:22.09,0:07:24.17,Default,,0,0,0,,Бастапқы пішінді мүмкіндігінше сақтаңыз—
Dialogue: 0,0:07:24.30,0:07:26.76,Default,,0,0,0,,Мен оны қайтаруға бар күшімді саламын.
Dialogue: 0,0:07:27.13,0:07:29.76,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:07:30.43,0:07:33.26,Default,,0,0,0,,Жарайды, Рэй! Оны өзіңізбен бірге алыңыз
Dialogue: 0,0:07:36.48,0:07:39.14,Default,,0,0,0,,Бұл дәл машина, сондықтан оны жай қалдырыңыз!
Dialogue: 0,0:07:39.27,0:07:42.77,Default,,0,0,0,,(металлдың сынған дыбысы)
Dialogue: 0,0:07:41.94,0:07:42.77,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:07:42.90,0:07:46.15,Default,,0,0,0,,А.Т.-ге енетін энергияның есептелген мөлшері.өріс болып табылады
Dialogue: 0,0:07:46.28,0:07:48.82,Default,,0,0,0,,Ең азы 180 миллион киловатт
Dialogue: 0,0:07:48.95,0:07:50.32,Default,,0,0,0,,Осыншама күш
Dialogue: 0,0:07:50.45,0:07:51.78,Default,,0,0,0,,Оны қайдан жинайсыз?
Dialogue: 0,0:07:53.12,0:07:56.29,Default,,0,0,0,,Ол бүкіл Жапонияда.
Dialogue: 0,0:07:58.46,0:08:00.17,Default,,0,0,0,,Бағдарламаның ортасында
Dialogue: 0,0:08:00.29,0:08:03.21,Default,,0,0,0,,Мен сіздермен ерекше жаңалықтармен бөліскім келеді.
Dialogue: 0,0:08:03.54,0:08:05.96,Default,,0,0,0,,Бүгін 23:30-дан бастап.
Dialogue: 0,0:08:06.09,0:08:08.67,Default,,0,0,0,,Ертең, таңғы уақытта, ауқымды...
Dialogue: 0,0:08:08.80,0:08:10.05,Default,,0,0,0,,Электр қуаты өшіп қалды
Dialogue: 0,0:08:10.18,0:08:11.39,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:08:11.51,0:08:13.10,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:08:13.55,0:08:15.22,Default,,0,0,0,,(2-хабарландыру) Мен мұны қайталаймын.
Dialogue: 0,0:08:15.35,0:08:17.64,Default,,0,0,0,,Бүгін 23:30-дан бастап.
Dialogue: 0,0:08:17.98,0:08:19.52,Default,,0,0,0,,Ертең таң атқанша
Dialogue: 0,0:08:19.64,0:08:21.85,Default,,0,0,0,,Ел бойынша кең ауқымды электр қуатының үзілуі.
Dialogue: 0,0:08:21.98,0:08:23.31,Default,,0,0,0,,Ынтымақтастық үшін рахмет.
Dialogue: 0,0:08:23.44,0:08:25.27,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:08:29.53,0:08:31.78,Default,,0,0,0,,(Әйел қызметкер) Жау қалқаны 7-ші сауыт тақтасын бұзады
Dialogue: 0,0:08:32.32,0:08:33.95,Default,,0,0,0,,Энергия жүйесінің болжамы қандай?
Dialogue: 0,0:08:34.74,0:08:35.66,Default,,0,0,0,,Қазіргі уақытта жоспарланған
Dialogue: 0,0:08:35.78,0:08:37.49,Default,,0,0,0,,3,2% артта қалды
Dialogue: 0,0:08:37.62,0:08:39.87,Default,,0,0,0,,Мен бүгін 23:10-ға дейін бірдеңе істей аламын.
Dialogue: 0,0:08:40.41,0:08:41.62,Default,,0,0,0,,Позитрон мылтығы туралы не деуге болады?
Dialogue: 0,0:08:42.21,0:08:44.79,Default,,0,0,0,,(Қызметкерлер) Технологияларды дамыту департаментінің еркіне қарамастан, 3-бөлім,
Dialogue: 0,0:08:44.92,0:08:47.00,Default,,0,0,0,,Мен оның пішінін үш сағатта беремін.
Dialogue: 0,0:08:47.71,0:08:48.55,Default,,0,0,0,,Қорғаныс шаралары қандай?
Dialogue: 0,0:08:49.21,0:08:52.38,Default,,0,0,0,,Мұның алдын алудың жалғыз жолы - қалқан.
Dialogue: 0,0:08:52.51,0:08:54.39,Default,,0,0,0,,Бұл қалқан ба?
Dialogue: 0,0:08:54.51,0:08:57.43,Default,,0,0,0,,Иә, SSTO-дан алынған түсініктеме.
Dialogue: 0,0:08:57.93,0:09:00.73,Default,,0,0,0,,Бұл қорқынышты көрінгенімен, түбі бастапқыда болды
Dialogue: 0,0:09:00.85,0:09:03.19,Default,,0,0,0,,Бұл модельде супер электромагниттік жабын бар.
Dialogue: 0,0:09:03.31,0:09:06.19,Default,,0,0,0,,Бұл атыс 17 секундқа созылды.
Dialogue: 0,0:09:06.32,0:09:07.36,Default,,0,0,0,,2-бөлімдегі кепілдікпен бірге жеткізіледі.
Dialogue: 0,0:09:07.77,0:09:08.90,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:09:09.07,0:09:10.03,Default,,0,0,0,,Мергендік нүкте дегеніміз не?
Dialogue: 0,0:09:10.61,0:09:12.65,Default,,0,0,0,,Мақсатты рельефке дейінгі қашықтық
Dialogue: 0,0:09:12.78,0:09:14.49,Default,,0,0,0,,Қолжетімді қосалқы станция жабдықтарын ескере отырып
Dialogue: 0,0:09:14.62,0:09:15.95,Default,,0,0,0,,Бұл бәрібір осында.
Dialogue: 0,0:09:16.49,0:09:18.95,Default,,0,0,0,,Иә, сенің қолыңнан келетініне сенімдімін.
Dialogue: 0,0:09:19.62,0:09:21.37,Default,,0,0,0,,Мерген нүктесі Футаго тауының шыңы болды.
Dialogue: 0,0:09:22.12,0:09:25.08,Default,,0,0,0,,Жұмыстың басталу уақыты ертең таңертең 0:00.
Dialogue: 0,0:09:25.21,0:09:27.79,Default,,0,0,0,,Бұл операция бұдан әрі Яшима операциясы деп аталады.
Dialogue: 0,0:09:27.92,0:09:28.75,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:09:29.71,0:09:31.67,Default,,0,0,0,,(Мисатоның дауысы) Бұл тек ұшқыштың мәселесі.
Dialogue: 0,0:09:32.13,0:09:35.01,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:09:45.85,0:09:48.23,Default,,0,0,0,,(Ер қызметкер) 0 бөлімшесінің ұшқышы есін жиған сияқты.
Dialogue: 0,0:09:48.36,0:09:50.32,Default,,0,0,0,,Сынақ мәндерінде мәселе жоқ
Dialogue: 0,0:09:50.61,0:09:51.44,Default,,0,0,0,,Иә
Dialogue: 0,0:09:52.40,0:09:54.11,Default,,0,0,0,,Осылайша операция жоспарланғандай өтеді.
Dialogue: 0,0:09:54.24,0:09:55.07,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:09:55.74,0:09:58.33,Default,,0,0,0,,Бірақ ол қайтадан атқа мінеді ме?
Dialogue: 0,0:09:58.91,0:10:00.49,Default,,0,0,0,,Футакояма шайқасы Асығыңыз!
Dialogue: 0,0:10:00.74,0:10:04.71,Default,,0,0,0,,(Хигурашидің айқайы)
Dialogue: 0,0:10:14.13,0:10:15.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:15.97,0:10:16.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:18.55,0:10:19.97,Default,,0,0,0,,Аянами…
Dialogue: 0,0:10:20.56,0:10:22.89,Default,,0,0,0,,Ертең түн ортасынан бастап күшіне енеді.
Dialogue: 0,0:10:23.02,0:10:25.85,Default,,0,0,0,,Яшима операциясының кестесін айтайын.
Dialogue: 0,0:10:27.23,0:10:32.53,Default,,0,0,0,,Икари Аянамидің екі ұшқышы бүгін 1730-да Кейджде кездеседі.
Dialogue: 0,0:10:33.15,0:10:37.32,Default,,0,0,0,,1800 Unit-01 және Unit-00 іске қосылады
Dialogue: 0,0:10:37.45,0:10:39.62,Default,,0,0,0,,1805 Бастау
Dialogue: 0,0:10:39.74,0:10:42.91,Default,,0,0,0,,Футакояма уақытша базасына келіңіз
Dialogue: 0,0:10:43.04,0:10:45.62,Default,,0,0,0,,Одан кейін басқа өмір болғанша күт.
Dialogue: 0,0:10:45.75,0:10:49.71,Default,,0,0,0,,Ертең таңертең, күннің өзгеруімен операциялар басталады.
Dialogue: 0,0:10:50.79,0:10:52.17,Default,,0,0,0,,Бұл жаңа
Dialogue: 0,0:10:57.22,0:10:58.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:59.26,0:11:01.51,Default,,0,0,0,,Жартылай ұйықтап қалып келме.
Dialogue: 0,0:11:04.27,0:11:05.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:05.35,0:11:06.44,Default,,0,0,0,,Уау
Dialogue: 0,0:11:07.85,0:11:09.40,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:11:09.52,0:11:16.53,Default,,0,0,0,,♪
Dialogue: 0,0:11:14.07,0:11:16.53,Default,,0,0,0,,Мен кешеден бері үнемі кешірім сұраймын.
Dialogue: 0,0:11:16.53,0:11:17.03,Default,,0,0,0,,Мен кешеден бері үнемі кешірім сұрап жүрмін.
Dialogue: 0,0:11:18.41,0:11:19.49,Default,,0,0,0,,Тамақтану
Dialogue: 0,0:11:23.45,0:11:25.91,Default,,0,0,0,,Мен ештеңе жегім келмейді
Dialogue: 0,0:11:26.50,0:11:28.75,Default,,0,0,0,,Біз 60 минуттан кейін кетеміз.
Dialogue: 0,0:11:29.12,0:11:30.33,Default,,0,0,0,,Тағы да…
Dialogue: 0,0:11:30.46,0:11:32.50,Default,,0,0,0,,Менің ойымша, мен бұл затты айдауым керек.
Dialogue: 0,0:11:32.63,0:11:34.34,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:11:34.92,0:11:37.55,Default,,0,0,0,,Маған... ұнамайды.
Dialogue: 0,0:11:37.67,0:11:40.51,Default,,0,0,0,,Аянами бұл затты мініп жүргенде әлі қорқынышты тәжірибені бастан өткерген жоқ.
Dialogue: 0,0:11:40.64,0:11:42.51,Default,,0,0,0,,Мен мұны айта аламын.
Dialogue: 0,0:11:43.01,0:11:45.77,Default,,0,0,0,,Мен тағы да солай сезінгім келмейді...
Dialogue: 0,0:11:45.89,0:11:47.56,Default,,0,0,0,,Онда неге ұйықтамайсың?
Dialogue: 0,0:11:48.31,0:11:49.94,Default,,0,0,0,,Ұйықтап жатқанымды қалаймын...
Dialogue: 0,0:11:50.73,0:11:52.52,Default,,0,0,0,,Мен бірінші ұшаққа мінемін.
Dialogue: 0,0:11:53.90,0:11:56.03,Default,,0,0,0,,Доктор Акаги 01 бөлімшесінің жеке деректерін жазады.
Dialogue: 0,0:11:56.15,0:11:58.61,Default,,0,0,0,,Мен оны қайта жазуға дайындалып жатырмын.
Dialogue: 0,0:11:59.24,0:12:00.45,Default,,0,0,0,,Рицуко-сан?
Dialogue: 0,0:12:01.07,0:12:05.54,Default,,0,0,0,,Бірінші лейтенант Катсураги мен доктор Акаги торда күтіп тұр.
Dialogue: 0,0:12:06.45,0:12:07.58,Default,,0,0,0,,Ах
Dialogue: 0,0:12:09.50,0:12:10.58,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:12:26.22,0:12:27.85,Default,,0,0,0,,(Хигурашидің айқайы)
Dialogue: 0,0:12:27.97,0:12:30.14,Default,,0,0,0,,Бұл өте баяу.
Dialogue: 0,0:12:30.27,0:12:32.56,Default,,0,0,0,,Эвакуациялау уақыты келді.
Dialogue: 0,0:12:32.69,0:12:34.77,Default,,0,0,0,,Мен әкемнің деректеріне қарадым.
Dialogue: 0,0:12:35.27,0:12:37.32,Default,,0,0,0,,Бұл дәл осы уақытта.
Dialogue: 0,0:12:37.44,0:12:39.86,Default,,0,0,0,,Кешіріңіз, бірақ мен кете алмаймын.
Dialogue: 0,0:12:40.03,0:12:41.32,Default,,0,0,0,,(ұшып бара жатқан құстардың дыбысы)
Dialogue: 0,0:12:40.45,0:12:41.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:41.32,0:12:41.99,Default,,0,0,0,,(ұшып бара жатқан құстардың дыбысы)
Dialogue: 0,0:12:41.45,0:12:42.57,Default,,0,0,0,,Ах!?
Dialogue: 0,0:12:42.24,0:12:46.99,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:12:45.20,0:12:46.99,Default,,0,0,0,,Таулар қозғалуда...
Dialogue: 0,0:12:46.99,0:12:48.16,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:12:47.12,0:12:48.16,Default,,0,0,0,,Бұл Евангелион!
Dialogue: 0,0:12:54.71,0:12:55.84,Default,,0,0,0,,О!
Dialogue: 0,0:12:58.84,0:13:00.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:00.22,0:13:03.89,Default,,0,0,0,,Сәттілік!(Ер студент) Мен сұрадым!
Dialogue: 0,0:13:04.51,0:13:08.06,Default,,0,0,0,,Евангелион!Өтінемін!
Dialogue: 0,0:13:12.81,0:13:13.60,Default,,0,0,0,,♪
Dialogue: 0,0:13:13.60,0:13:16.19,Default,,0,0,0,,♪ (Аоба) Жаудың қалқанын бұзып өтеді 17-ші сауыт тақтасы
Dialogue: 0,0:13:16.19,0:13:16.69,Default,,0,0,0,,♪
Dialogue: 0,0:13:16.31,0:13:19.11,Default,,0,0,0,,♪ Штабқа жетуімізге 3 сағат 55 минут қалды
Dialogue: 0,0:13:19.11,0:13:19.61,Default,,0,0,0,,♪
Dialogue: 0,0:13:19.32,0:13:19.82,Default,,0,0,0,,♪ (Әйел қызметкер) Хабты өзгерту жүйесі Мәселе жоқ
Dialogue: 0,0:13:19.82,0:13:21.36,Default,,0,0,0,,(Әйел қызметкер) Хабты түрлендіру жүйесі Мәселе жоқ
Dialogue: 0,0:13:21.49,0:13:24.03,Default,,0,0,0,,(Хюга) Сикоку және Кюсю аудандарында электрмен жабдықтау аяқталды
Dialogue: 0,0:13:24.53,0:13:27.66,Default,,0,0,0,,(Әйел қызметкер) Әрбір салқындату жүйесінің сынақ жұмысын бастаңыз.
Dialogue: 0,0:13:28.33,0:13:31.04,Default,,0,0,0,,Бұл дәл машина, сондықтан абай болыңыз.
Dialogue: 0,0:13:32.62,0:13:35.38,Default,,0,0,0,,Бірақ мұндай қару далалық ұрысқа жарамайды.
Dialogue: 0,0:13:35.50,0:13:36.75,Default,,0,0,0,,Бұл пайдалы ма?
Dialogue: 0,0:13:36.88,0:13:39.92,Default,,0,0,0,,Менің таңдауым жоқ, бұл жай ғана уақытша нәрсе.
Dialogue: 0,0:13:40.05,0:13:41.42,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:13:41.55,0:13:43.01,Default,,0,0,0,,Теорияда
Dialogue: 0,0:13:43.13,0:13:45.64,Default,,0,0,0,,Бірақ мылтық оқпаны немесе үдеткіш ұзаққа созылады ма.
Dialogue: 0,0:13:45.76,0:13:47.80,Default,,0,0,0,,Сіз оны түсірмейінше білмейсіз.
Dialogue: 0,0:13:47.93,0:13:49.76,Default,,0,0,0,,Осындай жоғары қуатпен сынақ ату
Dialogue: 0,0:13:49.89,0:13:51.39,Default,,0,0,0,,Өйткені бұл ешқашан болған емес.
Dialogue: 0,0:13:52.56,0:13:56.23,Default,,0,0,0,,Осы операцияға жауапты әрбір адамға хабарлаңыз.
Dialogue: 0,0:13:56.44,0:13:57.98,Default,,0,0,0,,Шинджи-кун иә
Dialogue: 0,0:13:58.11,0:13:59.82,Default,,0,0,0,,Бірінші автоматта атқышқа жауапты
Dialogue: 0,0:13:59.94,0:14:00.90,Default,,0,0,0,,Иә
Dialogue: 0,0:14:01.03,0:14:03.15,Default,,0,0,0,,Рэй 0-бөлімшеде қорғанысқа жауапты болды.
Dialogue: 0,0:14:03.28,0:14:04.11,Default,,0,0,0,,Иә
Dialogue: 0,0:14:04.61,0:14:08.70,Default,,0,0,0,,Бұл Синдзи және Unit-01 арасындағы синхрондау жылдамдығы жоғарырақ болғандықтан.
Dialogue: 0,0:14:08.83,0:14:11.79,Default,,0,0,0,,Бұл жолы бізге дәлірек операция қажет.
Dialogue: 0,0:14:12.54,0:14:17.96,Default,,0,0,0,,Позитрондарға Жердің айналуы, магнит өрісі және тартылыс күші әсер етеді және түзу сызықта қозғалмайды.
Dialogue: 0,0:14:18.08,0:14:21.13,Default,,0,0,0,,Бұл қатені түзетуді ұмытпаңыз.
Dialogue: 0,0:14:21.25,0:14:23.88,Default,,0,0,0,,Тек бір негізгі нүктеге дәл еніңіз.
Dialogue: 0,0:14:24.34,0:14:27.76,Default,,0,0,0,,Мұндай нәрсе... Мен оны әлі үйренген жоқпын.
Dialogue: 0,0:14:28.30,0:14:29.64,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:29.76,0:14:31.64,Default,,0,0,0,,Сіз мәтінді орындайсыз
Dialogue: 0,0:14:31.77,0:14:33.68,Default,,0,0,0,,Соңында, ортадағы белгілер тураланған кезде
Dialogue: 0,0:14:33.81,0:14:35.64,Default,,0,0,0,,Жай ғана қосқышты басыңыз
Dialogue: 0,0:14:35.77,0:14:37.90,Default,,0,0,0,,Қалғанын машина жасайды.
Dialogue: 0,0:14:38.27,0:14:40.11,Default,,0,0,0,,Содан кейін бір рет атсаңыз
Dialogue: 0,0:14:40.23,0:14:43.07,Default,,0,0,0,,Салқындату, толтыру, сақтандырғыштарды ауыстыру және т.б.
Dialogue: 0,0:14:43.19,0:14:45.24,Default,,0,0,0,,Келесі кадрды түсіру үшін біраз уақыт қажет.
Dialogue: 0,0:14:45.53,0:14:48.16,Default,,0,0,0,,Ендеше, сағынып, жау кері оқ атса ше?
Dialogue: 0,0:14:48.74,0:14:50.78,Default,,0,0,0,,Қазір қажетсіз нәрсе туралы ойламаңыз.
Dialogue: 0,0:14:50.91,0:14:53.58,Default,,0,0,0,,Оны бір соққымен жоюды ойла.
Dialogue: 0,0:14:55.50,0:14:57.75,Default,,0,0,0,,Сіз үлкен шымшусыз ба?
Dialogue: 0,0:14:58.25,0:14:59.46,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:00.75,0:15:02.71,Default,,0,0,0,,Менің ойымша, мен 01 блогын қорғауым керек.
Dialogue: 0,0:15:02.84,0:15:03.67,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:15:04.38,0:15:05.59,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:15:06.26,0:15:09.05,Default,,0,0,0,,Екеуіңде киімдеріңді ауыстыратын уақыт келді.
Dialogue: 0,0:15:09.18,0:15:10.01,Default,,0,0,0,,Иә
Dialogue: 0,0:15:20.77,0:15:21.65,Default,,0,0,0,,Қазір—
Dialogue: 0,0:15:22.44,0:15:23.98,Default,,0,0,0,,Мен өлуім мүмкін.
Dialogue: 0,0:15:25.49,0:15:26.99,Default,,0,0,0,,Неге олай дейсің?
Dialogue: 0,0:15:31.32,0:15:32.66,Default,,0,0,0,,Сіз өлмейсіз
Dialogue: 0,0:15:34.79,0:15:36.29,Default,,0,0,0,,Мен нені қорғаймын
Dialogue: 0,0:15:36.45,0:15:43.46,Default,,0,0,0,,♪
Dialogue: 0,0:16:17.66,0:16:20.08,Default,,0,0,0,,Неліктен Аянами мұны мінеді?
Dialogue: 0,0:16:24.34,0:16:25.46,Default,,0,0,0,,Өйткені бұл байланыс
Dialogue: 0,0:16:26.09,0:16:27.46,Default,,0,0,0,,Облигация?
Dialogue: 0,0:16:28.34,0:16:30.13,Default,,0,0,0,,Сонымен Кизуна
Dialogue: 0,0:16:31.97,0:16:33.89,Default,,0,0,0,,Әкеммен бе?
Dialogue: 0,0:16:34.01,0:16:35.56,Default,,0,0,0,,Барлығымен
Dialogue: 0,0:16:36.39,0:16:39.48,Default,,0,0,0,,Аянами күшті.
Dialogue: 0,0:16:40.02,0:16:43.02,Default,,0,0,0,,Менде басқа ештеңе жоқ
Dialogue: 0,0:16:44.02,0:16:46.11,Default,,0,0,0,,Басқа ештеңе жоқ...
Dialogue: 0,0:16:47.57,0:16:50.20,Default,,0,0,0,,Уақыт болды, кеттік
Dialogue: 0,0:16:52.16,0:16:53.41,Default,,0,0,0,,Қош бол
Dialogue: 0,0:16:53.99,0:16:56.87,Default,,0,0,0,,(көтеру түсіру дыбысы)
Dialogue: 0,0:17:05.96,0:17:07.00,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:17:07.17,0:17:10.80,Default,,0,0,0,,Мен сізге 0:00:00 туралы хабарлаймын.
Dialogue: 0,0:17:13.89,0:17:14.72,Default,,0,0,0,,(Уақыт сигналы)
Dialogue: 0,0:17:15.14,0:17:16.14,Default,,0,0,0,,Стратегия басталды.
Dialogue: 0,0:17:16.93,0:17:20.43,Default,,0,0,0,,Синдзи-кун, мен саған бүкіл Жапонияның энергиясын сеніп тапсырамын.
Dialogue: 0,0:17:21.18,0:17:22.85,Default,,0,0,0,,(Радио: Мисато) Сәттілік Иә!
Dialogue: 0,0:17:23.27,0:17:25.36,Default,,0,0,0,,Бірінші қосылым басталды!
Dialogue: 0,0:17:25.48,0:17:28.27,Default,,0,0,0,,(Hyuga) Электр қуатын беру 1-ден 803-ші учаскеге дейін басталады
Dialogue: 0,0:17:32.65,0:17:33.70,Default,,0,0,0,,Негізгі қуат беру жүйесі қалыпты
Dialogue: 0,0:17:33.82,0:17:36.20,Default,,0,0,0,,Хаб трансформаторы Шығу мәселесі жоқ
Dialogue: 0,0:17:37.12,0:17:38.70,Default,,0,0,0,,Түрлендіру тиімділігі кестеде қалды
Dialogue: 0,0:17:38.83,0:17:40.58,Default,,0,0,0,,Кернеудің жоғарылауы Артық қысым аймағына қарай
Dialogue: 0,0:17:40.95,0:17:43.21,Default,,0,0,0,,Максималды өнімділікке дейін толық салқындату жүйесі!
Dialogue: 0,0:17:45.25,0:17:47.42,Default,,0,0,0,,Электрондық конденсация жүйесі қалыпты
Dialogue: 0,0:17:47.96,0:17:49.55,Default,,0,0,0,,Температураның тұрақтылығы Мәселе жоқ
Dialogue: 0,0:17:50.21,0:17:52.42,Default,,0,0,0,,Позитрон ағыны жақсы жүріп жатыр
Dialogue: 0,0:17:52.55,0:17:53.72,Default,,0,0,0,,Қосымша қосылым
Dialogue: 0,0:17:55.39,0:17:57.35,Default,,0,0,0,,Барлық үдеткіштер жұмыс істей бастайды
Dialogue: 0,0:17:57.47,0:17:58.97,Default,,0,0,0,,Мәжбүрлі фокустау құрылғысы іске қосылды
Dialogue: 0,0:17:59.51,0:18:02.35,Default,,0,0,0,,Футагоямазукури қосалқы станциясына барлық электр қуаты
Dialogue: 0,0:18:02.73,0:18:04.81,Default,,0,0,0,,Үшіншілік қосылым Мәселе жоқ
Dialogue: 0,0:18:05.23,0:18:06.98,Default,,0,0,0,,Қауіпсіздік құрылғысының соңғы шығарылымы
Dialogue: 0,0:18:07.44,0:18:08.40,Default,,0,0,0,,Балғаны көтер!
Dialogue: 0,0:18:11.23,0:18:13.82,Default,,0,0,0,,Жердің айналуы және гравитация қатесін түзету
Dialogue: 0,0:18:13.95,0:18:15.91,Default,,0,0,0,,Плюс 0,0009
Dialogue: 0,0:18:16.53,0:18:19.33,Default,,0,0,0,,Жану нүктесіне дейін кернеу 0,2 артық
Dialogue: 0,0:18:19.45,0:18:23.29,Default,,0,0,0,,(мотор дыбысы)
Dialogue: 0,0:18:26.46,0:18:28.63,Default,,0,0,0,,7-ші соңғы байланыс
Dialogue: 0,0:18:29.96,0:18:32.21,Default,,0,0,0,,(Хината) Толық энергетикалық позитрон мылтығы!
Dialogue: 0,0:18:33.30,0:18:37.09,Default,,0,0,0,,8 7 6 5
Dialogue: 0,0:18:36.34,0:18:37.89,Default,,0,0,0,,Мақсатқа жоғары энергия реакциясы!
Dialogue: 0,0:18:37.26,0:18:39.10,Default,,0,0,0,,4 3 2 1
Dialogue: 0,0:18:38.18,0:18:39.10,Default,,0,0,0,,Не дедің!
Dialogue: 0,0:18:39.10,0:18:41.01,Default,,0,0,0,,4 3 2 1
Dialogue: 0,0:18:41.51,0:18:42.72,Default,,0,0,0,,Өрт!
Dialogue: 0,0:18:42.93,0:18:43.77,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:18:52.36,0:18:53.69,Default,,0,0,0,,Ух... а...
Dialogue: 0,0:18:57.74,0:18:58.66,Default,,0,0,0,,Кя
Dialogue: 0,0:18:59.20,0:19:00.62,Default,,0,0,0,,Ааа...
Dialogue: 0,0:19:01.74,0:19:02.58,Default,,0,0,0,,Мен қателік жасадым!
Dialogue: 0,0:19:02.70,0:19:09.71,Default,,0,0,0,,♪
Dialogue: 0,0:19:12.80,0:19:15.01,Default,,0,0,0,,Жау қалқаны геофронтты басып алды!
Dialogue: 0,0:19:15.38,0:19:16.55,Default,,0,0,0,,Екінші ату Тездеңіз!
Dialogue: 0,0:19:17.88,0:19:20.10,Default,,0,0,0,,Сақтандырғышты ауыстыру Қайта толтыруды бастаңыз!
Dialogue: 0,0:19:20.30,0:19:22.97,Default,,0,0,0,,(Әйел қызметкер 1) Мылтық оқпанын салқындату басталады (әйел қызметкер 2) Позитронды жеделдету қайта жалғасады
Dialogue: 0,0:19:24.43,0:19:26.23,Default,,0,0,0,,Нысанаға қайтадан жоғары энергиялық реакция!
Dialogue: 0,0:19:26.43,0:19:27.98,Default,,0,0,0,,Жаман!Уау
Dialogue: 0,0:19:29.56,0:19:30.48,Default,,0,0,0,,Шинджи-кун!
Dialogue: 0,0:19:32.44,0:19:33.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:38.78,0:19:39.61,Default,,0,0,0,,Аянами!
Dialogue: 0,0:19:41.91,0:19:42.91,Default,,0,0,0,,Қалқан шыдамайды!
Dialogue: 0,0:19:43.03,0:19:43.87,Default,,0,0,0,,Әлі емес пе?
Dialogue: 0,0:19:44.12,0:19:44.95,Default,,0,0,0,,10 секунд қалды!
Dialogue: 0,0:19:46.54,0:19:47.87,Default,,0,0,0,,Сонымен қатар, Алл Майт мені қазірдің өзінде бақылап отыр—
Dialogue: 0,0:19:50.58,0:19:51.58,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:19:58.26,0:19:59.30,Default,,0,0,0,,Хааа~
Dialogue: 0,0:20:05.39,0:20:06.27,Default,,0,0,0,,Аянами!
Dialogue: 0,0:20:28.20,0:20:29.46,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:29.79,0:20:32.96,Default,,0,0,0,,Уф... ой...
Dialogue: 0,0:20:33.33,0:20:34.96,Default,,0,0,0,,Куууу…
Dialogue: 0,0:20:36.30,0:20:37.13,Default,,0,0,0,,Уау
Dialogue: 0,0:20:37.34,0:20:38.17,Default,,0,0,0,,Аянами!
Dialogue: 0,0:20:38.84,0:20:41.47,Default,,0,0,0,,Жақсысың ба?Аянами!
Dialogue: 0,0:20:46.64,0:20:53.65,Default,,0,0,0,,♪
Dialogue: 0,0:20:53.02,0:20:53.65,Default,,0,0,0,,Мен үшін...
Dialogue: 0,0:20:53.65,0:20:54.69,Default,,0,0,0,,Маған...
Dialogue: 0,0:20:54.81,0:20:56.98,Default,,0,0,0,,Менде басқа ештеңе жоқ
Dialogue: 0,0:20:57.11,0:20:59.07,Default,,0,0,0,,Олай айтпа.
Dialogue: 0,0:21:01.20,0:21:03.16,Default,,0,0,0,,Қоштасқанда қоштасамыз
Dialogue: 0,0:21:03.28,0:21:05.41,Default,,0,0,0,,Қайғылы сөздерді айтпа
Dialogue: 0,0:21:05.99,0:21:06.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:07.24,0:21:08.62,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:10.04,0:21:15.84,Default,,0,0,0,,(Шинджидің жылағаны)
Dialogue: 0,0:21:22.13,0:21:23.47,Default,,0,0,0,,Не жылап тұрсың?
Dialogue: 0,0:21:23.68,0:21:25.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:27.68,0:21:28.93,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:29.06,0:21:31.23,Default,,0,0,0,,Мұндай жағдайда қандай бет-әлпет жасауым керек?
Dialogue: 0,0:21:31.35,0:21:32.39,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:21:34.52,0:21:36.06,Default,,0,0,0,,Менің ойымша, сіз күлуіңіз керек.
Dialogue: 0,0:21:39.65,0:21:40.82,Default,,0,0,0,,Ha
Dialogue: 0,0:22:00.96,0:22:03.59,Default,,0,0,0,,♪ Мені айға ұшыр
Dialogue: 0,0:22:03.72,0:22:08.43,Default,,0,0,0,,♪ Ал маған жұлдыздар арасында ойнауға рұқсат етіңіз
Dialogue: 0,0:22:09.56,0:22:12.56,Default,,0,0,0,,♪ Көктемнің қандай екенін көрейін
Dialogue: 0,0:22:12.68,0:22:16.06,Default,,0,0,0,,♪ Юпитер мен Марста
Dialogue: 0,0:22:17.02,0:22:23.78,Default,,0,0,0,,♪ Басқаша айтқанда, менің қолымды ұста!
Dialogue: 0,0:22:25.07,0:22:31.83,Default,,0,0,0,,♪ Басқаша айтқанда, қымбаттым, мені сүй!
Dialogue: 0,0:22:33.37,0:22:36.04,Default,,0,0,0,,♪ Жүрегімді әнмен толтыр
Dialogue: 0,0:22:36.17,0:22:40.55,Default,,0,0,0,,♪ Ал маған мәңгілік ән айтуға рұқсат етіңіз
Dialogue: 0,0:22:41.63,0:22:44.42,Default,,0,0,0,,♪ Мен аңсағанның бәрі сенсің
Dialogue: 0,0:22:44.55,0:22:48.30,Default,,0,0,0,,♪ Мен ғибадат ететін және табынатындардың барлығына
Dialogue: 0,0:22:49.22,0:22:56.23,Default,,0,0,0,,♪ Басқаша айтқанда, шын болыңыз
Dialogue: 0,0:22:57.31,0:23:04.32,Default,,0,0,0,,♪ Басқаша айтқанда, мен сені жақсы көремін
Dialogue: 0,0:23:06.07,0:23:08.87,Default,,0,0,0,,♪
Dialogue: 0,0:23:07.57,0:23:08.87,Default,,0,0,0,,Жақындап келе жатқан елшіге
Dialogue: 0,0:23:08.87,0:23:12.45,Default,,0,0,0,,♪
Dialogue: 0,0:23:08.99,0:23:12.45,Default,,0,0,0,,Жеке әзірленген гуманоидты қару бақылаудан шығып кетеді
Dialogue: 0,0:23:12.45,0:23:13.08,Default,,0,0,0,,♪
Dialogue: 0,0:23:12.58,0:23:15.62,Default,,0,0,0,,Мисато ядроның еруін тоқтата ала ма?
Dialogue: 0,0:23:15.79,0:23:17.62,Default,,0,0,0,,Келесі жолы «Адамның туындылары»
Dialogue: 0,0:23:18.08,0:23:19.54,Default,,0,0,0,,Бақылап отырыңыз
Dialogue: 0,0:23:21.04,0:23:26.04,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
