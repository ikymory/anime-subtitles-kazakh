Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.92,Default,,0,0,0,,♪~
Dialogue: 0,0:01:26.71,0:01:31.30,Default,,0,0,0,,~♪
Dialogue: 0,0:01:34.76,0:01:40.60,Default,,0,0,0,,(оятар дабылы)
Dialogue: 0,0:01:40.72,0:01:42.76,Default,,0,0,0,,Хмм.
Dialogue: 0,0:01:42.89,0:01:44.27,Default,,0,0,0,,Я...
Dialogue: 0,0:01:46.44,0:01:47.69,Default,,0,0,0,,Иә
Dialogue: 0,0:02:00.07,0:02:03.79,Default,,0,0,0,,Синдзи-кун, оян. Сіз қашанға дейін сабақтан қалмайсыз?
Dialogue: 0,0:02:03.91,0:02:07.29,Default,,0,0,0,,Қазірдің өзінде бесінші күн. 01 қондырғысы толығымен бекітілген.
Dialogue: 0,0:02:07.41,0:02:09.71,Default,,0,0,0,,Сіз, ұшқыш, мұндай нәрсеге не істер едіңіз?
Dialogue: 0,0:02:10.25,0:02:11.59,Default,,0,0,0,,Шинджи-кун?
Dialogue: 0,0:02:18.01,0:02:18.80,Default,,0,0,0,,Га
Dialogue: 0,0:02:21.35,0:02:27.64,Default,,0,0,0,,(Жедел жәрдем сиренасы)
Dialogue: 0,0:02:29.14,0:02:31.56,Default,,0,0,0,,Үйден қашып жатырсыз ба? Бұл таңқаларлық емес.
Dialogue: 0,0:02:31.69,0:02:36.07,Default,,0,0,0,,(жаңбыр дыбысы)
Dialogue: 0,0:02:39.95,0:02:42.16,Default,,0,0,0,,(есік қоңырауы)
Dialogue: 0,0:02:43.70,0:02:44.49,Default,,0,0,0,,Шинджи-кун?
Dialogue: 0,0:02:44.62,0:02:47.16,Default,,0,0,0,,(Тоджи Сузухара) Уау!Ой...
Dialogue: 0,0:02:49.66,0:02:52.50,Default,,0,0,0,,(Кенсуке Аида) Біздің есімдеріміз Аида мен Сузухара, біз Икари-кунмен бір сыныпта оқимыз.
Dialogue: 0,0:02:53.21,0:02:54.71,Default,,0,0,0,,Аида мен Сузухара
Dialogue: 0,0:02:54.84,0:02:55.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:55.75,0:02:57.63,Default,,0,0,0,,Мен... Мен Сузухарамын.
Dialogue: 0,0:02:58.09,0:03:01.18,Default,,0,0,0,,А, мүмкін бұл бірінші машинаның кіріс тығынында болған шығар...
Dialogue: 0,0:03:01.30,0:03:02.18,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:03:02.30,0:03:05.14,Default,,0,0,0,,Бұл бөлім көп қиындық тудырды.
Dialogue: 0,0:03:05.76,0:03:06.60,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:03:06.72,0:03:09.27,Default,,0,0,0,,Содан бері Икари-кун демалуда.
Dialogue: 0,0:03:09.39,0:03:11.10,Default,,0,0,0,,Мен қызық болдым және бір қарап шығу үшін тоқтадым.
Dialogue: 0,0:03:12.10,0:03:15.40,Default,,0,0,0,,Шинджи-кун қазір NERV жаттығу орталығында.
Dialogue: 0,0:03:15.52,0:03:17.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:17.19,0:03:20.78,Default,,0,0,0,,Икари мырза, бұл үстелдің үстіндегі іздер.
Dialogue: 0,0:03:20.90,0:03:23.28,Default,,0,0,0,,Бұл ұят. Рақмет сізге.
Dialogue: 0,0:03:23.41,0:03:25.62,Default,,0,0,0,,Хона, кешіріңізші.
Dialogue: 0,0:03:25.74,0:03:27.54,Default,,0,0,0,,Икари-кунға сәлемімді айтыңыз.
Dialogue: 0,0:03:28.04,0:03:30.96,Default,,0,0,0,,Иә, мен сізге айтайын.
Dialogue: 0,0:03:36.96,0:03:39.38,Default,,0,0,0,,Бұл күтпеген жағдай.
Dialogue: 0,0:03:39.51,0:03:41.38,Default,,0,0,0,,Беппин-сан тамаша жұмыс жасады.
Dialogue: 0,0:03:44.97,0:03:46.97,Default,,0,0,0,,Синдзидің ақымақ!
Dialogue: 0,0:03:50.93,0:03:52.19,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:03:52.27,0:03:54.23,Default,,0,0,0,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,0:04:05.41,0:04:10.37,Default,,0,0,0,,(Құлаққаптан музыка ағып жатыр)
Dialogue: 0,0:04:31.56,0:04:32.81,Default,,0,0,0,,(дыбысты тоқтату)
Dialogue: 0,0:04:34.02,0:04:38.98,Default,,0,0,0,,(Құлаққаптан музыка ағып жатыр)
Dialogue: 0,0:04:57.42,0:04:59.29,Default,,0,0,0,,(Дыбысты тоқтату және дыбысты ойнату)
Dialogue: 0,0:05:23.11,0:05:24.24,Default,,0,0,0,,Мен үйге баруым керек
Dialogue: 0,0:05:24.36,0:05:25.24,Default,,0,0,0,,(ойнату дыбысы)
Dialogue: 0,0:05:25.36,0:05:31.12,Default,,0,0,0,,(қоңырау дауысы)
Dialogue: 0,0:05:34.20,0:05:35.58,Default,,0,0,0,,(Әйелдің айқайы)
Dialogue: 0,0:05:35.71,0:05:37.79,Default,,0,0,0,,<Оны анықтау мүмкін емес екеніне сенімдісіз бе?＞
Dialogue: 0,0:05:44.13,0:05:47.13,Default,,0,0,0,,(Көмекші)
Dialogue: 0,0:05:47.26,0:05:50.14,Default,,0,0,0,,(Әйел) <Бірақ сырты тозақ.Бұл ғылым не үшін қажет? ＞
Dialogue: 0,0:05:50.26,0:05:51.14,Default,,0,0,0,,(дыбыстық дыбыс)
Dialogue: 0,0:05:51.26,0:05:54.14,Default,,0,0,0,,(Ер)
Dialogue: 0,0:05:56.18,0:05:58.10,Default,,0,0,0,,(Әйел)
Dialogue: 0,0:05:58.23,0:06:01.94,Default,,0,0,0,,(Көмекші)
Dialogue: 0,0:06:03.98,0:06:05.78,Default,,0,0,0,,(Мұғалім)
Dialogue: 0,0:06:07.82,0:06:10.95,Default,,0,0,0,,＜Бірақ сіз дүниенің тозағына қарауға міндеттісіз...＞
Dialogue: 0,0:06:17.96,0:06:21.25,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:06:30.89,0:06:35.85,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:06:39.69,0:06:44.65,Default,,0,0,0,,(Хигурашидің айқайы)
Dialogue: 0,0:07:05.84,0:07:07.26,Default,,0,0,0,,Сол жылы тағы бір үрей басталды
Dialogue: 0,0:07:23.86,0:07:24.65,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:08:20.91,0:08:23.00,Default,,0,0,0,,Адамзаттың аман қалуына жауапты адам
Dialogue: 0,0:08:23.12,0:08:24.37,Default,,0,0,0,,Бұл шынымен қатыгез, солай емес пе?
Dialogue: 0,0:08:25.04,0:08:26.33,Default,,0,0,0,,Бірақ біз
Dialogue: 0,0:08:26.46,0:08:27.67,Default,,0,0,0,,Ева бақылауы
Dialogue: 0,0:08:27.79,0:08:30.76,Default,,0,0,0,,Мен мұны 14 жастағы балаларға тапсыруым керек.
Dialogue: 0,0:08:31.21,0:08:32.42,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:32.55,0:08:35.51,Default,,0,0,0,,Сонымен?Сіз Шинджиден естідіңіз бе?
Dialogue: 0,0:08:36.68,0:08:37.64,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:08:40.52,0:08:43.81,Default,,0,0,0,,Жоқ, ол ешқашан қайтып оралмауы мүмкін.
Dialogue: 0,0:08:44.81,0:08:45.77,Default,,0,0,0,,Мүмкін, сенің көзіңдегі жамандықтан шығар
Dialogue: 0,0:08:46.44,0:08:50.19,Default,,0,0,0,,Маған бәрібір... Қайтпайтын болсаң, солай болғаны жақсы шығар.
Dialogue: 0,0:08:50.90,0:08:51.69,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:08:52.90,0:08:55.53,Default,,0,0,0,,Келесі күні шайқастан кейін.
Dialogue: 0,0:08:56.99,0:08:59.70,Default,,0,0,0,,Неліктен менің бұйрықтарымды елемедің?
Dialogue: 0,0:09:00.45,0:09:01.62,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:02.33,0:09:04.87,Default,,0,0,0,,Мен сіздің операцияларыңызға жауаптымын, солай ма?
Dialogue: 0,0:09:05.00,0:09:05.79,Default,,0,0,0,,Иә
Dialogue: 0,0:09:05.92,0:09:08.88,Default,,0,0,0,,Менің бұйрықтарымды орындауға міндеттісің.
Dialogue: 0,0:09:09.00,0:09:09.84,Default,,0,0,0,,Мен түсіндім, солай ма?
Dialogue: 0,0:09:09.96,0:09:10.84,Default,,0,0,0,,Иә
Dialogue: 0,0:09:10.96,0:09:12.80,Default,,0,0,0,,Болашақта мұның алдын алу үшін
Dialogue: 0,0:09:12.92,0:09:13.72,Default,,0,0,0,,Иә
Dialogue: 0,0:09:13.84,0:09:15.51,Default,,0,0,0,,Сіз шынымен түсінесіз, солай емес пе?
Dialogue: 0,0:09:16.18,0:09:17.09,Default,,0,0,0,,Иә
Dialogue: 0,0:09:17.22,0:09:18.14,Default,,0,0,0,,Сіз
Dialogue: 0,0:09:18.26,0:09:21.22,Default,,0,0,0,,Кездейсоқ «сәлем» және «жоғары» деп айтудың қажеті жоқ.
Dialogue: 0,0:09:21.97,0:09:23.93,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:09:24.06,0:09:26.14,Default,,0,0,0,,Бұл жеткілікті емес пе? Біз жеңдік.
Dialogue: 0,0:09:27.52,0:09:29.81,Default,,0,0,0,,Тек беті адамға лайықталған болса,
Dialogue: 0,0:09:29.94,0:09:31.27,Default,,0,0,0,,It would be easy though.
Dialogue: 0,0:09:31.40,0:09:34.40,Default,,0,0,0,,Егер сіз осы сезіммен Еваға мінсеңіз, сіз өлесіз.
Dialogue: 0,0:09:34.53,0:09:36.57,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:09:37.41,0:09:40.03,Default,,0,0,0,,Мен жақсы дайындалғанымды айтқым келеді.
Dialogue: 0,0:09:40.16,0:09:43.12,Default,,0,0,0,,Егер сізді мақтайды деп ойласаңыз, қателесесіз, Синдзи Икари.
Dialogue: 0,0:09:43.83,0:09:48.04,Default,,0,0,0,,Мақтағанмен, бәрібір мінетін жалғыз адаммын.
Dialogue: 0,0:09:49.21,0:09:50.50,Default,,0,0,0,,Мен мінемін
Dialogue: 0,0:09:51.13,0:09:52.92,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:55.42,0:09:59.26,Default,,0,0,0,,Еваға міну ол бала үшін азаптан басқа ештеңе болмаса.
Dialogue: 0,0:09:59.39,0:10:01.43,Default,,0,0,0,,It's better not to ride anymore.
Dialogue: 0,0:10:02.47,0:10:03.31,Default,,0,0,0,,Something that will definitely die
Dialogue: 0,0:10:03.85,0:10:05.77,Default,,0,0,0,,But you need a pilot
Dialogue: 0,0:10:08.81,0:10:12.19,Default,,0,0,0,,Da-da-da-da-da… Dowaaaaah!
Dialogue: 0,0:10:13.53,0:10:15.53,Default,,0,0,0,,Who is the platoon leader?
Dialogue: 0,0:10:15.65,0:10:18.45,Default,,0,0,0,,Бар, Аида, жүр.
Dialogue: 0,0:10:18.57,0:10:23.49,Default,,0,0,0,,Дегенмен, мен взвод командирімді қалдырмай жүре алмаймын.
Dialogue: 0,0:10:23.91,0:10:24.91,Default,,0,0,0,,Бакамон!
Dialogue: 0,0:10:25.04,0:10:26.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:35.30,0:10:36.92,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:10:38.59,0:10:39.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:42.18,0:10:43.60,Default,,0,0,0,,Студентті ауыстыру
Dialogue: 0,0:10:44.56,0:10:45.77,Default,,0,0,0,,Икари!
Dialogue: 0,0:11:02.70,0:11:05.87,Default,,0,0,0,,I was reflecting on Touji's behavior.
Dialogue: 0,0:11:05.99,0:11:07.79,Default,,0,0,0,,Apparently my sister lectured me.
Dialogue: 0,0:11:08.71,0:11:12.25,Default,,0,0,0,,«Бізді құтқарған сол робот болды».
Dialogue: 0,0:11:12.79,0:11:17.92,Default,,0,0,0,,Бастауыш мектептің төменгі сыныптарында оқитын балаларға уағыз айтуға болмайды деген рас па?
Dialogue: 0,0:11:22.64,0:11:27.14,Default,,0,0,0,,Түнде жақсы, өйткені шулы цикадалар ән салмайды.
Dialogue: 0,0:11:27.27,0:11:31.06,Default,,0,0,0,,Кішкентай кезімде тыныш болды, бірақ ол жыл сайын артып келеді.
Dialogue: 0,0:11:31.56,0:11:35.19,Default,,0,0,0,,Мисато экожүйенің қайтып келе жатқанын айтты.
Dialogue: 0,0:11:35.82,0:11:37.82,Default,,0,0,0,,Ммм, Мисато-сан.
Dialogue: 0,0:11:38.48,0:11:40.32,Default,,0,0,0,,I'm totally jealous.
Dialogue: 0,0:11:40.45,0:11:42.49,Default,,0,0,0,,Мен сондай әдемі әпкеммен тұрамын.
Dialogue: 0,0:11:42.61,0:11:44.70,Default,,0,0,0,,Being able to control Evangelion
Dialogue: 0,0:11:44.87,0:11:49.70,Default,,0,0,0,,Ах, мен Эвангелионды өз қалауымша басқарғым келеді, бір рет қана.
Dialogue: 0,0:11:50.41,0:11:53.71,Default,,0,0,0,,Тоқтағаның жөн, анаң уайымдайды.
Dialogue: 0,0:11:55.38,0:11:58.88,Default,,0,0,0,,А, онда бәрі жақсы, менде ондай ештеңе жоқ.
Dialogue: 0,0:12:01.09,0:12:02.43,Default,,0,0,0,,Икариде де солай.
Dialogue: 0,0:12:05.22,0:12:07.18,Default,,0,0,0,,You eat food, right?
Dialogue: 0,0:12:07.31,0:12:08.26,Default,,0,0,0,,Иә
Dialogue: 0,0:12:09.60,0:12:11.31,Default,,0,0,0,,Do you always do this?
Dialogue: 0,0:12:11.43,0:12:14.60,Default,,0,0,0,,Иә?Хмм, жарайды
Dialogue: 0,0:12:14.73,0:12:18.07,Default,,0,0,0,,Партизандық соғысқа қатысты дайындық?
Dialogue: 0,0:12:18.19,0:12:20.44,Default,,0,0,0,,Мұндай ойыншықпен не істеуге болады?
Dialogue: 0,0:12:20.57,0:12:22.74,Default,,0,0,0,,Мен мұны жақсы көретіндіктен істеп жатырмын
Dialogue: 0,0:12:26.53,0:12:30.50,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:12:30.62,0:12:35.33,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:12:40.13,0:12:41.42,Default,,0,0,0,,Ах
Dialogue: 0,0:12:46.97,0:12:49.47,Default,,0,0,0,,Икари: Бұл Синдзи.
Dialogue: 0,0:12:49.60,0:12:50.72,Default,,0,0,0,,Иә
Dialogue: 0,0:12:50.81,0:12:53.23,Default,,0,0,0,,Ол NERV қауіпсіздік барлау департаментінен.
Dialogue: 0,0:12:53.35,0:12:56.27,Default,,0,0,0,,Қауіпсіздік туралы ереженің 8-бөлімінің қолданылуына байланысты
Dialogue: 0,0:12:56.40,0:12:59.40,Default,,0,0,0,,Мен сені штабқа апарамын, жарай ма?
Dialogue: 0,0:12:59.52,0:13:00.32,Default,,0,0,0,,Иә
Dialogue: 0,0:13:08.16,0:13:11.33,Default,,0,0,0,,Сіз не десеңіз де, екінші тарап NERV қауіпсіздік барлау бөлімі.
Dialogue: 0,0:13:11.45,0:13:12.33,Default,,0,0,0,,Ол кәсіпқой.
Dialogue: 0,0:13:12.75,0:13:14.50,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:13:14.62,0:13:16.75,Default,,0,0,0,,Сіз әлі де Матанкиді ұстанасыз ба?
Dialogue: 0,0:13:17.33,0:13:18.13,Default,,0,0,0,,Жоқ
Dialogue: 0,0:13:18.25,0:13:19.17,Default,,0,0,0,,(Әйел студент) Бұзық (Әйел студент) Маймыл
Dialogue: 0,0:13:19.54,0:13:23.80,Default,,0,0,0,,Жеңіссіз күрескен адам ақымақ. Матанкидің бұған еш қатысы жоқ.
Dialogue: 0,0:13:30.22,0:13:32.06,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:13:35.69,0:13:37.27,Default,,0,0,0,,Біраз уақытқа.
Dialogue: 0,0:13:37.40,0:13:38.23,Default,,0,0,0,,Иә
Dialogue: 0,0:13:38.35,0:13:40.27,Default,,0,0,0,,Мен соңғы екі күн бойы серуендеп жүрмін.
Dialogue: 0,0:13:40.40,0:13:42.11,Default,,0,0,0,,Өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:13:42.48,0:13:43.74,Default,,0,0,0,,Бөлек
Dialogue: 0,0:13:44.11,0:13:46.99,Default,,0,0,0,,Еваның күту режимі дайын.Сіз мінгіңіз келе ме?
Dialogue: 0,0:13:48.24,0:13:49.41,Default,,0,0,0,,Сен атқа мінбейсің бе?
Dialogue: 0,0:13:50.41,0:13:54.00,Default,,0,0,0,,Үйден қаштым деп ұрыспайсың.
Dialogue: 0,0:13:56.79,0:14:00.00,Default,,0,0,0,,Әрине, Мисато бейтаныс адам.
Dialogue: 0,0:14:01.59,0:14:05.42,Default,,0,0,0,,Мен мінбеймін десем, бірінші ұшақты не істейсің?
Dialogue: 0,0:14:06.30,0:14:08.38,Default,,0,0,0,,Рэй оны мінеді.
Dialogue: 0,0:14:09.26,0:14:10.68,Default,,0,0,0,,Сен атқа мінбейсің бе?
Dialogue: 0,0:14:11.30,0:14:14.06,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:14:14.18,0:14:15.85,Default,,0,0,0,,Қалайша оған бәрін мәжбүрлей аласыз?
Dialogue: 0,0:14:16.39,0:14:19.10,Default,,0,0,0,,Жарайды, мен мінемін.
Dialogue: 0,0:14:19.23,0:14:20.73,Default,,0,0,0,,Атқа мінгің келмейді ме?
Dialogue: 0,0:14:20.86,0:14:22.27,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:14:22.40,0:14:25.36,Default,,0,0,0,,Біріншіден, бұл мен үшін емес.
Dialogue: 0,0:14:25.49,0:14:28.28,Default,,0,0,0,,Бірақ Аянами, Мисато-сан, Рицуко-сан...
Dialogue: 0,0:14:28.40,0:14:29.78,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:14:30.16,0:14:32.20,Default,,0,0,0,,Оның адамдарға қатысы жоқ!
Dialogue: 0,0:14:32.33,0:14:34.16,Default,,0,0,0,,Ұнамаса, бұл жерден кет.
Dialogue: 0,0:14:34.29,0:14:38.75,Default,,0,0,0,,Ева мен біз туралы бәрін ұмытып, әдеттегі өміріңізге оралыңыз.
Dialogue: 0,0:14:38.87,0:14:39.79,Default,,0,0,0,,Уф
Dialogue: 0,0:14:39.92,0:14:43.63,Default,,0,0,0,,Сіз сияқты сезімдермен жүру тітіркендіргіш.
Dialogue: 0,0:14:43.75,0:14:49.47,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:14:49.59,0:14:51.05,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:14:54.39,0:14:58.06,Default,,0,0,0,,Үшінші балалар ертең Нью-Токио-3-тен кетеді.
Dialogue: 0,0:14:58.18,0:15:00.90,Default,,0,0,0,,(Gendo Ikari) 01 блогының деректері Rei жүйесіне қайта жазылады.
Dialogue: 0,0:15:01.19,0:15:02.27,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:15:02.40,0:15:05.57,Default,,0,0,0,,Unit 0 қайта іске қосу тәжірибесінің нәтижелеріне қарамастан.
Dialogue: 0,0:15:05.69,0:15:07.82,Default,,0,0,0,,Бірінші құрылғыдағы эксперименттерге өтіңіз
Dialogue: 0,0:15:13.20,0:15:15.45,Default,,0,0,0,,Мардук ұйымының есебіне сәйкес.
Dialogue: 0,0:15:15.58,0:15:18.29,Default,,0,0,0,,Force Children әлі табылған жоқ.
Dialogue: 0,0:15:18.41,0:15:21.25,Default,,0,0,0,,Бұл ұшқыштарды ауыстыру жұмыс істемейді дегенді білдіре ме?
Dialogue: 0,0:15:24.38,0:15:27.09,Default,,0,0,0,,Мм... Мисато қайда?
Dialogue: 0,0:15:27.21,0:15:28.71,Default,,0,0,0,,Қоштасу сөзі
Dialogue: 0,0:15:28.84,0:15:31.18,Default,,0,0,0,,(Ер) Сіз енді NERV адамы емессіз.
Dialogue: 0,0:15:31.59,0:15:34.26,Default,,0,0,0,,Ештеңені үйрету мүмкін емес.
Dialogue: 0,0:15:34.39,0:15:39.10,Default,,0,0,0,,(Көліктің тоқтаған дыбысы)
Dialogue: 0,0:15:47.82,0:15:48.73,Default,,0,0,0,,Анкерлік
Dialogue: 0,0:15:48.86,0:15:50.57,Default,,0,0,0,,О, мен ұмытып қалдым.
Dialogue: 0,0:15:50.70,0:15:51.61,Default,,0,0,0,,Ах
Dialogue: 0,0:16:00.00,0:16:02.67,Default,,0,0,0,,Ум... мен мұны айта аламын ба?
Dialogue: 0,0:16:05.67,0:16:07.96,Default,,0,0,0,,Мен оны осы маңайда бір жерге қойған едім…
Dialogue: 0,0:16:10.13,0:16:12.84,Default,,0,0,0,,Туджи, сөйлес, кел.
Dialogue: 0,0:16:12.97,0:16:13.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:15.55,0:16:19.81,Default,,0,0,0,,Икари: Саған екі рет қайта оралғаным үшін кешірім сұраймын. Өтінемін, маған да қарсы тұрыңыз.
Dialogue: 0,0:16:20.43,0:16:21.93,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:16:22.02,0:16:24.19,Default,,0,0,0,,Өтінемін, олай етпесең, көңілім толмайды.
Dialogue: 0,0:16:24.73,0:16:26.98,Default,,0,0,0,,Ол өте ұят жігіт.
Dialogue: 0,0:16:27.11,0:16:29.36,Default,,0,0,0,,Егер бұл жеткілікті болса, неге мені ұрмайсың?
Dialogue: 0,0:16:31.03,0:16:31.82,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:31.94,0:16:34.99,Default,,0,0,0,,Иә!Уақытыңыз жоқ па?
Dialogue: 0,0:16:35.16,0:16:37.16,Default,,0,0,0,,Ал... бір ғана ату.
Dialogue: 0,0:16:37.28,0:16:39.12,Default,,0,0,0,,Жарайды, жүр!
Dialogue: 0,0:16:43.50,0:16:44.50,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:16:46.63,0:16:47.63,Default,,0,0,0,,Ешқандай зияны жоқ
Dialogue: 0,0:16:48.04,0:16:48.96,Default,,0,0,0,,Иә
Dialogue: 0,0:16:50.88,0:16:51.96,Default,,0,0,0,,Иә
Dialogue: 0,0:16:52.05,0:16:54.84,Default,,0,0,0,,Itatatata ah...
Dialogue: 0,0:17:00.26,0:17:02.02,Default,,0,0,0,,Хехехе
Dialogue: 0,0:17:04.44,0:17:05.44,Default,,0,0,0,,Неге мұнда?
Dialogue: 0,0:17:05.94,0:17:07.81,Default,,0,0,0,,Бұл жай ғана болжам
Dialogue: 0,0:17:07.94,0:17:11.11,Default,,0,0,0,,Осы күндері мен ондаған сыныптастарымды шығарып салдым.
Dialogue: 0,0:17:14.07,0:17:15.82,Default,,0,0,0,,Егер якорь болмаса
Dialogue: 0,0:17:15.95,0:17:19.58,Default,,0,0,0,,Бір күні бізге де бұл қаладан кетуге тура келеді.
Dialogue: 0,0:17:19.70,0:17:22.54,Default,,0,0,0,,Кешіріңіз, бірақ мен ештеңе айта алмаймын.
Dialogue: 0,0:17:22.66,0:17:26.54,Default,,0,0,0,,Мен Икаридің Еваның ішінде азап шегіп жатқанын көремін.
Dialogue: 0,0:17:26.67,0:17:29.71,Default,,0,0,0,,Зәкір туралы, күріш торттары шатастырылды.
Dialogue: 0,0:17:30.55,0:17:32.21,Default,,0,0,0,,Мен Пачики Катарусурумын
Dialogue: 0,0:17:36.26,0:17:38.89,Default,,0,0,0,,Бұл ащы жүзді жасама.
Dialogue: 0,0:17:39.01,0:17:41.31,Default,,0,0,0,,Сау болыңыз және қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:17:41.43,0:17:42.64,Default,,0,0,0,,Ум...
Dialogue: 0,0:17:43.93,0:17:45.18,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:18:11.00,0:18:12.67,Default,,0,0,0,,Уф... (ер) Photoshop
Dialogue: 0,0:18:13.34,0:18:15.88,Default,,0,0,0,,Мен соғуға тура келетін адаммын.
Dialogue: 0,0:18:16.38,0:18:19.59,Default,,0,0,0,,Мен ұялшақ және қорқақпын...
Dialogue: 0,0:18:20.93,0:18:23.81,Default,,0,0,0,,Ол айлакер және әлсіз...
Dialogue: 0,0:18:25.14,0:18:27.44,Default,,0,0,0,,Мені бұдан былай қинамаңыз.
Dialogue: 0,0:18:27.56,0:18:32.52,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:18:39.74,0:18:41.03,Default,,0,0,0,,Мен кеттім.
Dialogue: 0,0:18:44.91,0:18:46.66,Default,,0,0,0,,Бұл жақсы нәрсе болды ма?
Dialogue: 0,0:18:47.12,0:18:49.42,Default,,0,0,0,,Кірпі дилеммасы...
Dialogue: 0,0:18:50.50,0:18:53.46,Default,,0,0,0,,Неғұрлым жақын болсаңыз, соғұрлым басқа адамды ренжітесіз.
Dialogue: 0,0:18:54.13,0:18:55.92,Default,,0,0,0,,Осыны айтып тұрсың ба?
Dialogue: 0,0:19:00.55,0:19:05.22,Default,,0,0,0,,Бұл мен өз сезімімді білдірудің жалғыз жолы.
Dialogue: 0,0:19:44.85,0:19:47.68,Default,,0,0,0,,(Шығу қоңырауы)
Dialogue: 0,0:20:17.21,0:20:19.21,Default,,0,0,0,,Сәлем
Dialogue: 0,0:20:19.96,0:20:21.92,Default,,0,0,0,,Сол кездегі Беппин мырза
Dialogue: 0,0:20:32.10,0:20:33.69,Default,,0,0,0,,Я...
Dialogue: 0,0:20:40.99,0:20:42.15,Default,,0,0,0,,Уф
Dialogue: 0,0:20:50.58,0:20:51.66,Default,,0,0,0,,Га
Dialogue: 0,0:20:58.00,0:20:59.25,Default,,0,0,0,,Га
Dialogue: 0,0:21:50.35,0:21:52.47,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:21:56.98,0:21:58.48,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:22:02.02,0:22:06.99,Default,,0,0,0,,♪~
Dialogue: 0,0:23:02.00,0:23:06.96,Default,,0,0,0,,~♪
Dialogue: 0,0:23:08.05,0:23:09.55,Default,,0,0,0,,(Баяндау)
Dialogue: 0,0:23:11.05,0:23:16.05,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
