Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.96,Default,,0,0,0,,♪~
Dialogue: 0,0:01:26.71,0:01:31.30,Default,,0,0,0,,~♪
Dialogue: 0,0:01:43.02,0:01:44.93,Default,,0,0,0,,(сығу дыбысы)
Dialogue: 0,0:02:06.33,0:02:08.67,Default,,0,0,0,,(Шиндзи Икари) Менің ойымша, бұл көмектесе алмады!
Dialogue: 0,0:02:10.13,0:02:13.00,Default,,0,0,0,,Өйткені Кавору-кун, ол елші болды!
Dialogue: 0,0:02:14.30,0:02:17.30,Default,,0,0,0,,Жоқ! Ол – елші! Ол біздің жауымыз еді!
Dialogue: 0,0:02:18.88,0:02:21.14,Default,,0,0,0,,Жоқ! басқа! Жоқ!
Dialogue: 0,0:02:22.80,0:02:24.64,Default,,0,0,0,,Сіз менімен бірдей адам болдыңыз ба?
Dialogue: 0,0:02:24.77,0:02:26.93,Default,,0,0,0,,Жоқ, ол елші болды.
Dialogue: 0,0:02:27.06,0:02:28.56,Default,,0,0,0,,Оны неге өлтірдің?
Dialogue: 0,0:02:28.69,0:02:30.15,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:02:30.27,0:02:33.48,Default,,0,0,0,,Олай етпесек, өлеміз, бәрі өлтіріледі.
Dialogue: 0,0:02:33.94,0:02:34.98,Default,,0,0,0,,Оны неге өлтірдің?
Dialogue: 0,0:02:35.11,0:02:37.03,Default,,0,0,0,,Мен мұны ұнатқандықтан жасамадым!
Dialogue: 0,0:02:37.15,0:02:38.82,Default,,0,0,0,,Бірақ менің таңдауым болмады.
Dialogue: 0,0:02:40.49,0:02:41.32,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:02:42.49,0:02:43.53,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:02:44.62,0:02:45.45,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:02:47.16,0:02:48.54,Default,,0,0,0,,Маған біреу көмектес
Dialogue: 0,0:02:49.83,0:02:52.71,Default,,0,0,0,,Өтінемін, біреу маған көмектес!
Dialogue: 0,0:02:57.30,0:02:58.67,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:58.80,0:03:02.18,Default,,0,0,0,,Егер сен аман қалатын болсаң, бұл Кавору-кун еді.
Dialogue: 0,0:03:02.34,0:03:05.89,Default,,0,0,0,,Ол әрқашан менен жақсы адам болды.
Dialogue: 0,0:03:06.01,0:03:08.35,Default,,0,0,0,,Кавору-кун аман қалуы керек еді.
Dialogue: 0,0:03:08.48,0:03:09.48,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:03:09.60,0:03:12.81,Default,,0,0,0,,Өмір сүруге ерік-жігері барлар ғана аман қалады.
Dialogue: 0,0:03:12.94,0:03:14.52,Default,,0,0,0,,Ол өлімді қалады
Dialogue: 0,0:03:14.65,0:03:18.44,Default,,0,0,0,,Мен өмір сүруге деген ерік-жігерімді тастап, жалған үмітке жабыстым.
Dialogue: 0,0:03:18.57,0:03:20.45,Default,,0,0,0,,Шинджи-кун жаман емес.
Dialogue: 0,0:03:20.57,0:03:21.95,Default,,0,0,0,,<Солай ма? ＞
Dialogue: 0,0:03:31.21,0:03:32.12,Default,,0,0,0,,<Не? ＞
Dialogue: 0,0:03:33.17,0:03:34.08,Default,,0,0,0,,<Мен? ＞
Dialogue: 0,0:03:37.25,0:03:39.13,Default,,0,0,0,,<Кімге? Ол кім? ＞
Dialogue: 0,0:03:39.80,0:03:42.22,Default,,0,0,0,,<Бұл менің әкем! ＞
Dialogue: 0,0:03:46.85,0:03:50.48,Default,,0,0,0,,Егер мені жек көрсе, не істеуім керек?
Dialogue: 0,0:04:00.74,0:04:02.24,Default,,0,0,0,,Ол қайда? мұнда
Dialogue: 0,0:04:03.70,0:04:05.78,Default,,0,0,0,,Мен қайда баруым керек?
Dialogue: 0,0:04:05.91,0:04:09.08,Default,,0,0,0,,Мен ештеңе көре алмаймын, ештеңе түсінбеймін
Dialogue: 0,0:04:11.83,0:04:12.66,Default,,0,0,0,,Мисато-сан
Dialogue: 0,0:04:13.79,0:04:15.08,Default,,0,0,0,,Мисато-сан
Dialogue: 0,0:04:15.79,0:04:18.55,Default,,0,0,0,,Әй, қайда бардың? Мисато-сан
Dialogue: 0,0:04:19.59,0:04:23.26,Default,,0,0,0,,Ей, мен қазір қайдан баруым керек?
Dialogue: 0,0:04:23.97,0:04:27.05,Default,,0,0,0,,Мисато-сан Асука Аянами
Dialogue: 0,0:04:27.18,0:04:30.89,Default,,0,0,0,,Туджи Кенсуке Рицуко-сан Каджи-сан!
Dialogue: 0,0:04:31.02,0:04:34.10,Default,,0,0,0,,Әке Ана…
Dialogue: 0,0:04:34.90,0:04:39.27,Default,,0,0,0,,Біреу маған не істеу керектігін айтшы.
Dialogue: 0,0:04:41.78,0:04:43.20,Default,,0,0,0,,Evangelion Unit 01
Dialogue: 0,0:04:46.24,0:04:49.66,Default,,0,0,0,,Ақырында, менде мұнымен жүруден басқа амалым жоқ
Dialogue: 0,0:04:50.20,0:04:52.20,Default,,0,0,0,,Сүйген адамымды өлтірсем де
Dialogue: 0,0:04:52.33,0:04:56.58,Default,,0,0,0,,Осыны қайта мініп, сенің әкең және басқалар айтқандай төбелескенімді қалайсың ба?
Dialogue: 0,0:04:56.71,0:04:58.04,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,0:04:58.17,0:05:00.55,Default,,0,0,0,,Бірдеңе айт! Маған жауап беріңіз!
Dialogue: 0,0:05:03.51,0:05:05.01,Default,,0,0,0,,Барлығы маған атқа мін деп айтады.
Dialogue: 0,0:05:06.68,0:05:08.01,Default,,0,0,0,,Барлығының…
Dialogue: 0,0:05:08.14,0:05:10.56,Default,,0,0,0,,Бұл барлығына арналғандықтан жақсы емес пе?
Dialogue: 0,0:05:12.77,0:05:17.15,Default,,0,0,0,,Иә, бұл жақсы нәрсе! Бұл тамаша нәрсе емес пе!
Dialogue: 0,0:05:17.73,0:05:21.82,Default,,0,0,0,,Олай істесең, бәрі сені мақтап, қамқор болады.
Dialogue: 0,0:05:21.94,0:05:23.32,Default,,0,0,0,,(Сорю/Асука Лэнгли) О, бұл өтірік.
Dialogue: 0,0:05:23.74,0:05:27.45,Default,,0,0,0,,Сен ақымақсың ба? Бұл мен үшін емес
Dialogue: 0,0:05:27.57,0:05:28.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:28.53,0:05:31.58,Default,,0,0,0,,Дәл солай, мен өз-өзіме қайтадан сылтау айтамын.
Dialogue: 0,0:05:32.37,0:05:33.41,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:33.54,0:05:37.33,Default,,0,0,0,,Басқалар үшін қолыңнан келгеннің бәрін істеп жатырмын деп ойлау әрекетінің өзі
Dialogue: 0,0:05:37.46,0:05:39.42,Default,,0,0,0,,Айтайын дегенім, мен жеңіл өмір сүріп жатырмын.
Dialogue: 0,0:05:39.54,0:05:41.21,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:41.88,0:05:44.01,Default,,0,0,0,,Қысқасы, Синдзи жалғыз.
Dialogue: 0,0:05:44.76,0:05:45.80,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:45.92,0:05:50.01,Default,,0,0,0,,Бұл жай ғана тәуелділік, симбиотикалық қарым-қатынас!
Dialogue: 0,0:05:50.85,0:05:52.26,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:05:52.39,0:05:57.06,Default,,0,0,0,,Адамдардың сізді қалайтынын ғана қаламайсыз ба?
Dialogue: 0,0:05:57.56,0:05:59.35,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:05:59.86,0:06:02.15,Default,,0,0,0,,Адамдардың маған бақыт сыйлағанын қалаймын
Dialogue: 0,0:06:02.27,0:06:03.86,Default,,0,0,0,,Жай ғана күтпеңіз
Dialogue: 0,0:06:04.40,0:06:06.36,Default,,0,0,0,,Жалған бақыт
Dialogue: 0,0:06:06.49,0:06:08.61,Default,,0,0,0,,Бұл сіз үшін де солай емес пе?
Dialogue: 0,0:06:08.74,0:06:09.74,Default,,0,0,0,,Ах
Dialogue: 0,0:06:18.12,0:06:20.88,Default,,0,0,0,,Мен мұны білмей тұрып, мен Еваға міндім.
Dialogue: 0,0:06:21.00,0:06:22.38,Default,,0,0,0,,Тасымалдауда
Dialogue: 0,0:06:23.34,0:06:26.59,Default,,0,0,0,,Бұл сұмдық бәрібір қозғалмайды
Dialogue: 0,0:06:27.38,0:06:31.34,Default,,0,0,0,,Жоқ, мен ақымақпын.
Dialogue: 0,0:06:31.89,0:06:35.81,Default,,0,0,0,,Маған ешкім керек емес. Маған ешкім керек емес.
Dialogue: 0,0:06:36.93,0:06:41.19,Default,,0,0,0,,Еваны ұша алмайтын ұшқыш ешкімге керек емес.
Dialogue: 0,0:06:44.27,0:06:45.07,Default,,0,0,0,,Шулы!
Dialogue: 0,0:06:46.90,0:06:48.53,Default,,0,0,0,,Жалғыз қалудан қорқасыз ба?
Dialogue: 0,0:06:49.95,0:06:53.20,Default,,0,0,0,,Сіз қорқуыңыз керек, өйткені сіз басқалармен бірге жоғалып кетесіз.
Dialogue: 0,0:06:56.91,0:06:59.83,Default,,0,0,0,,Шулы! шулы! шулы!
Dialogue: 0,0:06:59.96,0:07:02.83,Default,,0,0,0,,Маған сен сияқты қуыршақ айтқанын қаламаймын!
Dialogue: 0,0:07:06.38,0:07:07.38,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:07:07.76,0:07:08.97,Default,,0,0,0,,Рей Аянами
Dialogue: 0,0:07:09.47,0:07:10.97,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:07:13.09,0:07:14.60,Default,,0,0,0,,Сіз де Рей Аянамисыз ба?
Dialogue: 0,0:07:15.22,0:07:18.10,Default,,0,0,0,,Иә, бұл Рей Аянами деп аталады.
Dialogue: 0,0:07:18.64,0:07:21.35,Default,,0,0,0,,(Рей 1) Барлығы Рей Аянами деп аталады.
Dialogue: 0,0:07:22.06,0:07:23.81,Default,,0,0,0,,Неге барлығы мен?
Dialogue: 0,0:07:24.77,0:07:28.44,Default,,0,0,0,,Басқалардың бәрі бізді Рей Аянами деп атайды.
Dialogue: 0,0:07:28.99,0:07:32.74,Default,,0,0,0,,(Rei 1) Неліктен сізде жалған ақыл мен дене бар?
Dialogue: 0,0:07:32.86,0:07:36.24,Default,,0,0,0,,Өтірік емес, мен кім болсам, сондаймын.
Dialogue: 0,0:07:49.17,0:07:50.09,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:07:50.22,0:07:53.09,Default,,0,0,0,,Сіздің ішіңіз соншалықты қараңғы, мен ештеңе көре алмаймын
Dialogue: 0,0:07:53.22,0:07:55.43,Default,,0,0,0,,Сізде ештеңе түсінбейтін жүрек бар, солай ма?
Dialogue: 0,0:07:56.26,0:07:58.43,Default,,0,0,0,,Нағыз сен сондасың
Dialogue: 0,0:07:59.06,0:08:00.89,Default,,0,0,0,,Мен менмін
Dialogue: 0,0:08:01.02,0:08:04.94,Default,,0,0,0,,Уақытым және басқалармен байланысым арқылы мен
Dialogue: 0,0:08:05.06,0:08:06.19,Default,,0,0,0,,Мен қандай болдым
Dialogue: 0,0:08:07.36,0:08:09.48,Default,,0,0,0,,(3-сәуле)
Dialogue: 0,0:08:12.24,0:08:14.82,Default,,0,0,0,,(Rei 2)
Dialogue: 0,0:08:18.70,0:08:24.37,Default,,0,0,0,,Дұрыс, ол Рей Аянами деп аталады. Мені осы уақытқа дейін кім етіп жасадым.
Dialogue: 0,0:08:24.50,0:08:26.33,Default,,0,0,0,,Бұдан былай мені кім етеді?
Dialogue: 0,0:08:28.21,0:08:30.92,Default,,0,0,0,,Бірақ нағыз сен басқа жердесің.
Dialogue: 0,0:08:32.13,0:08:33.88,Default,,0,0,0,,Сіз жай ғана білмейсіз
Dialogue: 0,0:08:35.14,0:08:38.60,Default,,0,0,0,,Мен оны білмей-ақ аулақпын, өйткені мен оны көргім келмейді.
Dialogue: 0,0:08:48.77,0:08:51.53,Default,,0,0,0,,Мен өзімді жоғалтып алудан қорқамын
Dialogue: 0,0:08:52.11,0:08:55.24,Default,,0,0,0,,Мен әркімнің жүрегінен жоғалып кетуден қорқамын
Dialogue: 0,0:08:56.03,0:08:58.24,Default,,0,0,0,,Қорқынышты ма? Мен білмеймін
Dialogue: 0,0:08:58.74,0:09:01.29,Default,,0,0,0,,Менің өз әлемім де жойылады
Dialogue: 0,0:09:02.83,0:09:04.29,Default,,0,0,0,,Мен жоғалып кетемін
Dialogue: 0,0:09:07.04,0:09:11.71,Default,,0,0,0,,(Rei 3) Жоқ, мен бақыттымын. Мен өлгім келеді.
Dialogue: 0,0:09:11.84,0:09:14.92,Default,,0,0,0,,Менің қалағаным - үмітсіздік, Мен жоқтыққа оралғым келеді
Dialogue: 0,0:09:15.05,0:09:18.43,Default,,0,0,0,,(Rei 2)
Dialogue: 0,0:09:23.73,0:09:26.02,Default,,0,0,0,,(Rei 2) Мен сонда болдым, өйткені маған сол адам керек болды.
Dialogue: 0,0:09:26.69,0:09:30.40,Default,,0,0,0,,(Rei 3) Бірақ бәрі бітті, енді маған керек болмайсың
Dialogue: 0,0:09:30.52,0:09:32.98,Default,,0,0,0,,Ол адам мені тастап кетеді
Dialogue: 0,0:09:33.82,0:09:36.36,Default,,0,0,0,,Сол күнді тілеу керек еді
Dialogue: 0,0:09:37.32,0:09:39.78,Default,,0,0,0,,Дәл қазір... Мен қорқамын.
Dialogue: 0,0:09:43.62,0:09:45.12,Default,,0,0,0,,Келесі кезекте біз
Dialogue: 0,0:09:45.62,0:09:50.00,Default,,0,0,0,,Бүгін сен сол күні сол жерде болдың, Рэй.
Dialogue: 0,0:09:50.46,0:09:51.25,Default,,0,0,0,,Иә
Dialogue: 0,0:10:02.93,0:10:07.69,Default,,0,0,0,,Не? Бұл сезім бұрын бір рет болған сияқты...
Dialogue: 0,0:10:08.23,0:10:11.19,Default,,0,0,0,,Менің денемнің пішіні жоғалып бара жатқан сияқты.
Dialogue: 0,0:10:12.32,0:10:13.86,Default,,0,0,0,,Мен мұнда жүктеме болғым келмейді.
Dialogue: 0,0:10:14.90,0:10:17.70,Default,,0,0,0,,I feel like I'm expanding.
Dialogue: 0,0:10:18.36,0:10:21.07,Default,,0,0,0,,All the way, all the way
Dialogue: 0,0:10:33.34,0:10:36.13,Default,,0,0,0,,Жоқ, бұл жоқтыққа қайта оралу дегенді білдірмейді.
Dialogue: 0,0:10:36.26,0:10:38.38,Default,,0,0,0,,Бұл жай ғана бәрін басына қайтарады.
Dialogue: 0,0:10:46.85,0:10:48.77,Default,,0,0,0,,That's all there is to it.
Dialogue: 0,0:10:49.19,0:10:50.65,Default,,0,0,0,,Is that a complementary plan?
Dialogue: 0,0:10:50.77,0:10:51.86,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:10:51.98,0:10:56.40,Default,,0,0,0,,Жүрегімізде әрқашан бос орын, жоғалған орын бар.
Dialogue: 0,0:11:00.07,0:11:02.53,Default,,0,0,0,,Әркім өз жүрегіндегі қараңғылықтан қорқады.
Dialogue: 0,0:11:02.66,0:11:06.37,Default,,0,0,0,,Мен одан қашып, одан құтыламын деп өмір сүремін.
Dialogue: 0,0:11:06.49,0:11:09.54,Default,,0,0,0,,Біз адам болғанша, мәңгілікке жойылмаймыз.
Dialogue: 0,0:11:09.66,0:11:12.29,Default,,0,0,0,,That's why people's hearts are united
Dialogue: 0,0:11:12.42,0:11:14.54,Default,,0,0,0,,Демек, сіз бір-біріңіздің орнын толтыруға тырысасыз ба?
Dialogue: 0,0:11:14.67,0:11:17.55,Default,,0,0,0,,Мұны басқа біреу рұқсатсыз жасады! Көмегіңіз үшін рақмет!
Dialogue: 0,0:11:17.67,0:11:19.80,Default,,0,0,0,,That's not just a familiarity!
Dialogue: 0,0:11:19.92,0:11:22.55,Default,,0,0,0,,But that's what you wanted too.
Dialogue: 0,0:11:22.68,0:11:23.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:25.01,0:11:26.22,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:11:28.98,0:11:32.56,Default,,0,0,0,,My heart is inside Мисато-san's heart.
Dialogue: 0,0:11:32.69,0:11:36.77,Default,,0,0,0,,Сонымен бірге менің жүрегім Шинжи-кунның ішінде.
Dialogue: 0,0:11:37.28,0:11:39.11,Default,,0,0,0,,Өзімді табу үшін
Dialogue: 0,0:11:39.24,0:11:42.07,Default,,0,0,0,,I have to interact with various people
Dialogue: 0,0:11:42.20,0:11:44.87,Default,,0,0,0,,You have to look inside me
Dialogue: 0,0:11:44.99,0:11:47.54,Default,,0,0,0,,I have to look at the Мисато inside me.
Dialogue: 0,0:11:48.58,0:11:50.41,Default,,0,0,0,,What does Мисато wish for?
Dialogue: 0,0:12:15.77,0:12:21.69,Default,,0,0,0,,Бірақ мен әкемді жек көремін, сондықтан Йоиконы жек көремін және қазір де жек көремін.
Dialogue: 0,0:12:21.78,0:12:25.74,Default,,0,0,0,,Мен өзімді таза ұстауға тырысудан шаршадым
Dialogue: 0,0:12:25.91,0:12:30.50,Default,,0,0,0,,Мен өзімді әдемі етіп көрсетуді жалғастыра беруден шаршадым.
Dialogue: 0,0:12:31.25,0:12:35.67,Default,,0,0,0,,Мен ластанғым келді. Мен өзімді лас көргім келді.
Dialogue: 0,0:12:36.33,0:12:38.54,Default,,0,0,0,,Сол үшін мені құшақтап алдың ба? сол адамға
Dialogue: 0,0:12:38.67,0:12:42.55,Default,,0,0,0,,Жоқ, мен сені сүйгендіктен ұстадым.
Dialogue: 0,0:12:43.05,0:12:44.93,Default,,0,0,0,,Сізге бұл шынымен ұнады ма?
Dialogue: 0,0:12:45.05,0:12:46.22,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:12:46.34,0:12:48.76,Default,,0,0,0,,Ол адам мені мен сияқты қабылдады.
Dialogue: 0,0:12:50.14,0:12:51.14,Default,,0,0,0,,Сіз өте мейірімді едіңіз!
Dialogue: 0,0:12:51.27,0:12:54.06,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:12:54.19,0:12:58.77,Default,,0,0,0,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,0:13:03.70,0:13:07.49,Default,,0,0,0,,Мен оны жек көремін! Тоқта, Шинджи бұл жерді көрмесін!
Dialogue: 0,0:13:09.03,0:13:11.16,Default,,0,0,0,,(Рйодзи Каджи) Енді ұялудың қажеті жоқ.
Dialogue: 0,0:13:11.29,0:13:13.29,Default,,0,0,0,,Бұл ұят!
Dialogue: 0,0:13:13.41,0:13:14.96,Default,,0,0,0,,Неге ұялып тұрсың?
Dialogue: 0,0:13:15.08,0:13:16.92,Default,,0,0,0,,Мен ұнататын адамның алдында жақсымын...
Dialogue: 0,0:13:17.04,0:13:20.71,Default,,0,0,0,,Жоқ, мен осылай киінсем де, шынымен бақыттымын.
Dialogue: 0,0:13:20.84,0:13:22.09,Default,,0,0,0,,Маған ұнамайды, тоқтат!
Dialogue: 0,0:13:24.01,0:13:26.30,Default,,0,0,0,,(Мисатоның дауысы) Мен Синдзиге мұның қандай екенін көрсете аламын.
Dialogue: 0,0:13:26.43,0:13:27.64,Default,,0,0,0,,Мен шынымен бақытты болсам да
Dialogue: 0,0:13:27.76,0:13:30.68,Default,,0,0,0,,Бұл өтірік! Жоқ, жоқ!
Dialogue: 0,0:13:30.81,0:13:32.02,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:13:32.14,0:13:34.64,Default,,0,0,0,,Әкемнің көзінше көрсеткім келгенімен.
Dialogue: 0,0:13:34.77,0:13:36.06,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:36.19,0:13:39.65,Default,,0,0,0,,(Мисатоның дауысы) Сіз Каджи-кунның ұйықтап жатқан бетінен жұбаныш іздедіңіз.
Dialogue: 0,0:13:39.77,0:13:40.77,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:40.86,0:13:43.82,Default,,0,0,0,,(Мисатоның дауысы) Мен Каджи-кунның жылуынан жұбаныш іздедім.
Dialogue: 0,0:13:43.99,0:13:45.28,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:45.40,0:13:48.82,Default,,0,0,0,,(Мисатоның дауысы) Мен әкемді Каджи-кунның қолтығынан іздедім.
Dialogue: 0,0:13:48.95,0:13:49.78,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:52.08,0:13:53.37,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:13:53.83,0:13:58.29,Default,,0,0,0,,Сол кезде мен әкемді Қажы-күннен таптым.
Dialogue: 0,0:13:58.88,0:14:01.59,Default,,0,0,0,,Сондықтан мен одан қаштым
Dialogue: 0,0:14:02.80,0:14:06.34,Default,,0,0,0,,Мен де әкем сияқты қорықтым...
Dialogue: 0,0:14:07.13,0:14:09.55,Default,,0,0,0,,Бірақ шын мәнінде, бұл менің бақытты болғандықтан болды.
Dialogue: 0,0:14:09.68,0:14:11.80,Default,,0,0,0,,Бұл бір рахат болды.
Dialogue: 0,0:14:11.89,0:14:14.81,Default,,0,0,0,,Бұл таптырмас ыңғайлы сәт болды.
Dialogue: 0,0:14:14.89,0:14:16.64,Default,,0,0,0,,Сондықтан маған ұнамады
Dialogue: 0,0:14:16.77,0:14:18.56,Default,,0,0,0,,Сол себепті ажырастық
Dialogue: 0,0:14:19.15,0:14:22.77,Default,,0,0,0,,Махаббаттың басталуына ешқандай себеп жоқ.
Dialogue: 0,0:14:22.90,0:14:25.23,Default,,0,0,0,,Ақырзаманға себеп бар деген сөз.
Dialogue: 0,0:14:26.28,0:14:28.57,Default,,0,0,0,,Сен сондай мейірімдісің, Каджи-кун.
Dialogue: 0,0:14:29.32,0:14:32.53,Default,,0,0,0,,Мейірімділігіңізбен
Dialogue: 0,0:14:33.74,0:14:35.41,Default,,0,0,0,,Мені лас
Dialogue: 0,0:14:37.62,0:14:39.87,Default,,0,0,0,,Тек қазір өзімді жек көретіндіктен
Dialogue: 0,0:14:40.04,0:14:41.96,Default,,0,0,0,,Бұл сізге зиян келтіру үшін емес.
Dialogue: 0,0:14:42.09,0:14:47.13,Default,,0,0,0,,Бұл өзіңізді алдау үшін берілген уақытша жаза.
Dialogue: 0,0:14:47.59,0:14:48.76,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:49.55,0:14:52.51,Default,,0,0,0,,Демек, сіз маған өзімді күтуімді айтасыз, солай ма?
Dialogue: 0,0:14:53.39,0:14:55.06,Default,,0,0,0,,Барлық ер адамдар осындай
Dialogue: 0,0:14:55.18,0:14:59.39,Default,,0,0,0,,Содан кейін мен жұмысқа және өз әлеміме барамын.
Dialogue: 0,0:14:59.52,0:15:01.65,Default,,0,0,0,,Мені артта қалдыру
Dialogue: 0,0:15:02.65,0:15:05.11,Default,,0,0,0,,Сіз өз әкеңіз сияқтысыз.
Dialogue: 0,0:15:05.23,0:15:07.86,Default,,0,0,0,,Мен азапты шындықтан қашып жатырмын.
Dialogue: 0,0:15:08.40,0:15:11.82,Default,,0,0,0,,Азапты шындық... Мен туралы ма?
Dialogue: 0,0:15:11.95,0:15:15.87,Default,,0,0,0,,Дұрыс, мен оған көмектесе алмаймын.
Dialogue: 0,0:15:17.41,0:15:19.71,Default,,0,0,0,,Тоқта! Мисато-сан
Dialogue: 0,0:15:19.83,0:15:23.33,Default,,0,0,0,,Кейде мен өзімнен үміт үземін! Сіз оны жек көресіз!
Dialogue: 0,0:15:23.46,0:15:25.46,Default,,0,0,0,,Лас Бұл лас
Dialogue: 0,0:15:25.59,0:15:26.71,Default,,0,0,0,,Қандай ұят.
Dialogue: 0,0:15:26.84,0:15:29.13,Default,,0,0,0,,Ұятсыз! Бұл лас!
Dialogue: 0,0:15:29.26,0:15:31.93,Default,,0,0,0,,Мен бұл ересектердің қарым-қатынасы екеніне ренжідім!
Dialogue: 0,0:15:32.51,0:15:35.72,Default,,0,0,0,,(Макото Хюга) Миса Катсураги, көтерілуіңізбен құттықтаймыз
Dialogue: 0,0:15:43.19,0:15:45.73,Default,,0,0,0,,(Жас Мисато)
Dialogue: 0,0:15:46.11,0:15:48.61,Default,,0,0,0,,Жоқ, мен бақыттымын.
Dialogue: 0,0:15:49.99,0:15:51.78,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:15:53.16,0:15:54.57,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:15:55.95,0:15:58.33,Default,,0,0,0,,Жоқ! Бұл бақыт емес!
Dialogue: 0,0:15:59.45,0:16:04.08,Default,,0,0,0,,Бұл нағыз мен емес! Мен дәл солай ойлаймын!
Dialogue: 0,0:16:04.67,0:16:07.59,Default,,0,0,0,,Егер мұны жасамасақ, біз өмір сүре алмаймыз ба?
Dialogue: 0,0:16:08.42,0:16:09.88,Default,,0,0,0,,Мен сенімен бірге болмасам, қорқамын
Dialogue: 0,0:16:10.38,0:16:11.17,Default,,0,0,0,,Мен уайымдаймын.
Dialogue: 0,0:16:11.92,0:16:13.55,Default,,0,0,0,,Қасыңда біреу ұйықтап жатпаса
Dialogue: 0,0:16:14.01,0:16:15.47,Default,,0,0,0,,Жалғыз ұйықтаудан қорқасыз ба?
Dialogue: 0,0:16:16.18,0:16:18.51,Default,,0,0,0,,Жалғыз ұйықтап жатқанда өзіңізді жалғыз сезінесіз бе?
Dialogue: 0,0:16:19.02,0:16:21.39,Default,,0,0,0,,Жүрегімнің жоғалуына шыдай алмаймын
Dialogue: 0,0:16:22.19,0:16:23.77,Default,,0,0,0,,Сондықтан сіз кез келген адаммен бірге бола аласыз.
Dialogue: 0,0:16:23.90,0:16:25.27,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:25.86,0:16:28.98,Default,,0,0,0,,Жоқ, мен жай ғана қарапайым ләззатпен айналысқым келеді.
Dialogue: 0,0:16:29.15,0:16:32.40,Default,,0,0,0,,Мен бір сәтке қашу арқылы жүрегімді тыныштандырғым келеді.
Dialogue: 0,0:16:32.53,0:16:35.45,Default,,0,0,0,,Олар ер адамдарды осы мақсатта ғана пайдаланады.
Dialogue: 0,0:16:35.57,0:16:37.49,Default,,0,0,0,,(Туған туыс) Олай деуге болады, бірақ (Туған туыс) бұл маңызды мәселе.
Dialogue: 0,0:16:43.00,0:16:45.00,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:16:46.04,0:16:48.63,Default,,0,0,0,,Бұл Асуканың ішіндегі менің жүрегім.
Dialogue: 0,0:16:48.75,0:16:53.30,Default,,0,0,0,,Демек, менің жүрегім де Шинджидің ішінде.
Dialogue: 0,0:16:55.51,0:16:57.09,Default,,0,0,0,,Асука нені қалайды?
Dialogue: 0,0:17:06.27,0:17:07.23,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:17:07.36,0:17:10.94,Default,,0,0,0,,<Бірақ сен әлі жылап жатырсың. Неге жылайсың? ＞
Dialogue: 0,0:17:13.28,0:17:15.36,Default,,0,0,0,,Мен ол қызға жақсы емеспін.
Dialogue: 0,0:17:15.49,0:17:19.03,Default,,0,0,0,,(Асуканың әкесі) Не? Ақыл-ойы әлсіреу сізге ұқсамайды, дәрігер.
Dialogue: 0,0:17:19.16,0:17:22.66,Default,,0,0,0,,(Өгей ана) Дәрігерлер де адам ғой, бұрын айтқанымдай.
Dialogue: 0,0:17:23.08,0:17:26.42,Default,,0,0,0,,(Асуканың әкесі) Бірақ сен сияқты әйел баласы бар.
Dialogue: 0,0:17:26.54,0:17:31.38,Default,,0,0,0,,(Өгей ана) Ол біртүрлі жетілген және шиеленісті және абсолютті бас тартуға ие.
Dialogue: 0,0:17:31.50,0:17:33.51,Default,,0,0,0,,Кейде мен қорқамын
Dialogue: 0,0:17:33.63,0:17:36.34,Default,,0,0,0,,Сізде мұндай сезім болды ма?
Dialogue: 0,0:17:36.47,0:17:40.85,Default,,0,0,0,,​​(Асуканың әкесі) Жоқ, сіз бәрібір Асуканың анасы болдыңыз.
Dialogue: 0,0:17:40.97,0:17:44.81,Default,,0,0,0,,(Өгей шеше) Оған дейін мен сенің әйелің болдым.
Dialogue: 0,0:17:44.93,0:17:46.02,Default,,0,0,0,,Сонымен қатар, солай емес пе?
Dialogue: 0,0:17:46.10,0:17:49.61,Default,,0,0,0,,(Өгей ана) Иә, әлеуметтік тұрғыдан алғанда, иә.
Dialogue: 0,0:17:49.73,0:17:52.78,Default,,0,0,0,,Ол баланың әкесі болуды тоқтата алмайсың, бірақ
Dialogue: 0,0:17:52.90,0:17:56.70,Default,,0,0,0,,Мен ол баланың анасы болуды кез келген уақытта тоқтата аламын.
Dialogue: 0,0:17:56.82,0:17:58.24,Default,,0,0,0,,Бұл рас...
Dialogue: 0,0:17:58.36,0:18:01.37,Default,,0,0,0,,(Жас Асука) Тоқта, анашым! Ана болуды доғар!
Dialogue: 0,0:18:01.49,0:18:03.91,Default,,0,0,0,,Мен анама ұнайтын жақсы қыз боламын!
Dialogue: 0,0:18:04.04,0:18:06.08,Default,,0,0,0,,Сондықтан ана болудан бас тартпаңыз!
Dialogue: 0,0:18:06.25,0:18:08.00,Default,,0,0,0,,Ендеше маған қара!
Dialogue: 0,0:18:08.12,0:18:12.00,Default,,0,0,0,,Тоқта, анашым! мені өлтірме!
Dialogue: 0,0:18:12.13,0:18:15.46,Default,,0,0,0,,(Асуканың анасы) Әкең анаңды жек көре бастады.
Dialogue: 0,0:18:15.59,0:18:20.68,Default,,0,0,0,,Маған бұл енді қажет емес. Жоқ, бұл маған басынан ұнамады.
Dialogue: 0,0:18:20.80,0:18:23.56,Default,,0,0,0,,Бұл сізге әуел бастан қажет емес екеніне сенімдімін.
Dialogue: 0,0:18:24.14,0:18:28.94,Default,,0,0,0,,Ендеше анамызбен өлейік, әке бізге керегі жоқ.
Dialogue: 0,0:18:29.06,0:18:32.23,Default,,0,0,0,,<Мен кедергі жасап тұрмын ба? Саған керек емес пе? ＞
Dialogue: 0,0:18:32.36,0:18:34.57,Default,,0,0,0,,Өтінемін, менімен бірге өл
Dialogue: 0,0:18:34.69,0:18:38.20,Default,,0,0,0,,(Жас Асука) <Маған ұнамайды! Мен анамның қуыршағы емеспін! ＞
Dialogue: 0,0:18:38.32,0:18:40.62,Default,,0,0,0,,<Өзің үшін ойла және өзің үшін өмір сүр! ＞
Dialogue: 0,0:18:47.37,0:18:50.00,Default,,0,0,0,,＜Оның жүзі өте қуанышты көрінді＞
Dialogue: 0,0:18:50.83,0:18:55.09,Default,,0,0,0,,Бірақ мен бұл бетті қатты жек көрдім.
Dialogue: 0,0:18:55.17,0:18:59.13,Default,,0,0,0,,Мен өлгім келмейді, жоғалғым келмейді.
Dialogue: 0,0:18:59.30,0:19:04.89,Default,,0,0,0,,Мен ұлдарды жек көремін, мен анам мен әкемді жек көремін, мен бәрін жек көремін.
Dialogue: 0,0:19:05.01,0:19:09.77,Default,,0,0,0,,Мені ешкім қорғамайды, менімен бірге ешкім қалмайды
Dialogue: 0,0:19:12.31,0:19:17.57,Default,,0,0,0,,Сондықтан мен жалғыз тұрамын! Бұл қиын!
Dialogue: 0,0:19:17.69,0:19:24.08,Default,,0,0,0,,Мен жалғыздықты жек көремін Жалғыздықты жек көремін Жалғыздықты жек көремін!
Dialogue: 0,0:19:26.29,0:19:29.33,Default,,0,0,0,,Мені тастама
Dialogue: 0,0:19:29.46,0:19:31.25,Default,,0,0,0,,Мені өлтірмеңдер
Dialogue: 0,0:19:33.79,0:19:35.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:37.30,0:19:41.43,Default,,0,0,0,,Бұл сіздің әкеңіз жұмыс істеп жатқан адамды толықтыру жобасы.
Dialogue: 0,0:19:41.55,0:19:43.84,Default,,0,0,0,,Бұл? Соның бір бөлігі сияқты
Dialogue: 0,0:19:54.69,0:19:56.82,Default,,0,0,0,,(Коузо Фуюцуки)
Dialogue: 0,0:20:12.58,0:20:13.46,Default,,0,0,0,,<Мен мұны қалаймын ба? ＞
Dialogue: 0,0:20:18.09,0:20:19.30,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:19.42,0:20:22.30,Default,,0,0,0,,Тек мені ешкім құтқарған жоқ! мен
Dialogue: 0,0:20:35.15,0:20:36.23,Default,,0,0,0,,Шындық дегеніміз не?
Dialogue: 0,0:20:43.70,0:20:46.32,Default,,0,0,0,,(Шигеру Аоба)
Dialogue: 0,0:20:48.41,0:20:51.58,Default,,0,0,0,,(Ибуки)
Dialogue: 0,0:20:53.66,0:20:55.50,Default,,0,0,0,,Бұл туралы ештеңе істей алмайсыз, бұл сіздің әлеміңіз
Dialogue: 0,0:20:56.29,0:20:59.09,Default,,0,0,0,,Бұл бәрі шешілген дүние.
Dialogue: 0,0:21:02.51,0:21:05.84,Default,,0,0,0,,(Фуюцуки) ＜Бұл сенің жүрегің болуды шешкен әлем.＞
Dialogue: 0,0:21:12.98,0:21:16.02,Default,,0,0,0,,Мына қараңғылық пен мынау жартылай піскен дүние
Dialogue: 0,0:21:16.15,0:21:17.86,Default,,0,0,0,,Мен бәрін қаладым ба?
Dialogue: 0,0:21:19.23,0:21:23.44,Default,,0,0,0,,(Каджи) ＜Жалғыз болып, өзіңізді жайлы сезінетін әлемді қаладыңыз＞
Dialogue: 0,0:21:52.52,0:21:55.39,Default,,0,0,0,,Бұл форма да соңғы жағдайлардың бірі болып табылады.
Dialogue: 0,0:21:55.94,0:21:59.27,Default,,0,0,0,,Өзіңіз басқарған бұл дүниенің соңы.
Dialogue: 0,0:22:02.65,0:22:07.61,Default,,0,0,0,,♪~
Dialogue: 0,0:23:03.00,0:23:07.97,Default,,0,0,0,,~♪
Dialogue: 0,0:23:08.92,0:23:12.60,Default,,0,0,0,,(Әңгімелеу)
