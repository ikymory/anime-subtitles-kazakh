Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.92,Default,,0,0,0,,♪~
Dialogue: 0,0:01:26.71,0:01:31.46,Default,,0,0,0,,~♪
Dialogue: 0,0:01:32.42,0:01:33.55,Default,,0,0,0,,<Эй, көрдің бе?＞
Dialogue: 0,0:01:33.67,0:01:34.17,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:01:34.21,0:01:35.76,Default,,0,0,0,,(Ер оқушы) (Ер оқушы) <Не?＞
Dialogue: 0,0:01:36.01,0:01:37.97,Default,,0,0,0,,(Ер студент)
Dialogue: 0,0:01:38.34,0:01:39.09,Default,,0,0,0,,<Шетелдік пе?＞
Dialogue: 0,0:01:39.26,0:01:41.18,Default,,0,0,0,,(Ер оқушы)
Dialogue: 0,0:01:45.14,0:01:45.64,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:01:48.90,0:01:51.11,Default,,0,0,0,,(Ер оқушы)
Dialogue: 0,0:01:51.23,0:01:51.77,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:01:53.61,0:01:54.23,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:01:54.36,0:01:55.74,Default,,0,0,0,,<Ол қайтып келген, солай ма?＞
Dialogue: 0,0:01:55.86,0:01:57.74,Default,,0,0,0,,(Ер студент) <Қызық, бәрі ілгерілеп жатыр ма?＞
Dialogue: 0,0:02:08.75,0:02:10.13,Default,,0,0,0,,(Кенсуке Аида)
Dialogue: 0,0:02:10.25,0:02:10.88,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:02:13.30,0:02:16.05,Default,,0,0,0,,Асука Асука Каа
Dialogue: 0,0:02:16.47,0:02:17.80,Default,,0,0,0,,Барлығы тыныш.
Dialogue: 0,0:02:17.92,0:02:19.34,Default,,0,0,0,,Уайымдаудың қажеті жоқ
Dialogue: 0,0:02:20.43,0:02:24.60,Default,,0,0,0,,Фотосуретте ондай тұлға жоқ.
Dialogue: 0,0:02:26.31,0:02:27.23,Default,,0,0,0,,Синдзи
Dialogue: 0,0:02:27.73,0:02:28.89,Default,,0,0,0,,Гутенморген
Dialogue: 0,0:02:29.48,0:02:31.06,Default,,0,0,0,,Гутен Морген
Dialogue: 0,0:02:31.19,0:02:34.23,Default,,0,0,0,,Таңертеңнен бері қышқыл көріндің.
Dialogue: 0,0:02:34.36,0:02:36.49,Default,,0,0,0,,Мен сені шақырып жатырмын.
Dialogue: 0,0:02:36.61,0:02:39.82,Default,,0,0,0,,О, бақытты көрін.
Dialogue: 0,0:02:39.95,0:02:43.03,Default,,0,0,0,,Демек, сіз осындасыз, солай ма?Тағы бір адам
Dialogue: 0,0:02:43.16,0:02:44.03,Default,,0,0,0,,Кім?
Dialogue: 0,0:02:44.16,0:02:45.45,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:02:45.58,0:02:47.25,Default,,0,0,0,,Сен менің бірінші балам болатыныңа сенімдімін.
Dialogue: 0,0:02:47.87,0:02:50.08,Default,,0,0,0,,Аа, егер бұл Аянами болса...
Dialogue: 0,0:03:00.18,0:03:03.43,Default,,0,0,0,,Сәлем, сіз Рей Аянамисыз.
Dialogue: 0,0:03:03.55,0:03:04.97,Default,,0,0,0,,Ұшқыштың прототипі
Dialogue: 0,0:03:07.43,0:03:09.73,Default,,0,0,0,,Мен Асука Сорю Асука Лэнгли
Dialogue: 0,0:03:10.44,0:03:13.06,Default,,0,0,0,,Eva Unit 2 ұшқышы, жарасайық
Dialogue: 0,0:03:14.11,0:03:15.02,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:15.15,0:03:18.03,Default,,0,0,0,,Бұл көптеген себептерге байланысты ыңғайлырақ.
Dialogue: 0,0:03:18.90,0:03:20.15,Default,,0,0,0,,Бұйыртса, солай істеймін.
Dialogue: 0,0:03:21.11,0:03:22.53,Default,,0,0,0,,Сіз біртүрлі баласыз.
Dialogue: 0,0:03:22.66,0:03:26.62,Default,,0,0,0,,Хонма, Еваға ерекше ұшқыш таңдалады ма?
Dialogue: 0,0:03:32.46,0:03:36.59,Default,,0,0,0,,(Пернетақтаның соғу дыбысы)
Dialogue: 0,0:03:36.71,0:03:38.55,Default,,0,0,0,,(Рйодзи Каджи) Сіз біраз салмақ тастадыңыз ба? (Рицуко Акаги) Солай ма?
Dialogue: 0,0:03:39.21,0:03:41.01,Default,,0,0,0,,Өйткені мен мұңды махаббаттамын
Dialogue: 0,0:03:41.13,0:03:44.59,Default,,0,0,0,,Сіз мұны қайдан білесіз?
Dialogue: 0,0:03:46.43,0:03:49.98,Default,,0,0,0,,Дұрыс, көз жасы жолында меңі бар адамдар
Dialogue: 0,0:03:50.10,0:03:52.48,Default,,0,0,0,,Өйткені сен өмір бойы жылай беруің керек.
Dialogue: 0,0:03:52.60,0:03:54.90,Default,,0,0,0,,Сіз мені қазір қызықтыруды жоспарлап отырсыз ба?Бірақ жоқ.
Dialogue: 0,0:03:55.56,0:03:58.23,Default,,0,0,0,,Бір қорқынышты апа қарап тұр.
Dialogue: 0,0:04:02.03,0:04:03.36,Default,,0,0,0,,Көптен бері көрмедім, Каджи-кун
Dialogue: 0,0:04:03.49,0:04:05.37,Default,,0,0,0,,Біраз уақытқа иә
Dialogue: 0,0:04:05.49,0:04:07.58,Default,,0,0,0,,Дегенмен, Каджи-кунның да немқұрайлылығы таң қалдырады.
Dialogue: 0,0:04:07.70,0:04:08.49,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:04:08.62,0:04:10.20,Default,,0,0,0,,(Мисато Катсураги) Бұл жігіт бұрынғыдай ақымақ.
Dialogue: 0,0:04:10.95,0:04:12.83,Default,,0,0,0,,Сіз 02 қондырғысын тапсырып қойғансыз.
Dialogue: 0,0:04:12.96,0:04:14.12,Default,,0,0,0,,Тезірек үйге қайт.
Dialogue: 0,0:04:14.83,0:04:18.46,Default,,0,0,0,,Мен бүгін таңертең іссапарға жіберу туралы хабарлама алдым. Мен осында қаламын.
Dialogue: 0,0:04:18.59,0:04:21.34,Default,,0,0,0,,Бұрынғыдай үшеуіңіздің қайта араласуына жол бермеңіз.
Dialogue: 0,0:04:21.97,0:04:23.26,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:04:23.43,0:04:26.22,Default,,0,0,0,,Ха, жау шабуылы ма?
Dialogue: 0,0:04:26.64,0:04:29.26,Default,,0,0,0,,(Шигеру Аоба) Дабылдағы крейсер Харунадан қоңырау шалу
Dialogue: 0,0:04:29.39,0:04:32.14,Default,,0,0,0,,«Мен Кии түбегінің жағалауында үлкен сүңгуір нысанын таптым»
Dialogue: 0,0:04:32.27,0:04:33.14,Default,,0,0,0,,"Деректерді жіберу"
Dialogue: 0,0:04:33.77,0:04:35.02,Default,,0,0,0,,Алынған деректерді тексеріңіз
Dialogue: 0,0:04:35.85,0:04:37.69,Default,,0,0,0,,Толқын ұзындығы үлгісі көк Апостолмен растаңыз
Dialogue: 0,0:04:38.19,0:04:40.11,Default,,0,0,0,,Жалпы жеке құрам 1-дәрежелі жауынгерлік орналастыру
Dialogue: 0,0:04:57.92,0:04:59.25,Default,,0,0,0,,Сондықтан бұл жолы
Dialogue: 0,0:04:59.34,0:05:02.42,Default,,0,0,0,,Судың шетіне қону алдында нысанаға дәл тигізіңіз.
Dialogue: 0,0:05:03.13,0:05:07.05,Default,,0,0,0,,01 және 02 бөлімшелері кезектесіп нысанаға толқындармен шабуыл жасайды.
Dialogue: 0,0:05:07.18,0:05:08.43,Default,,0,0,0,,Мен жақын шайқасты қолданамын.
Dialogue: 0,0:05:09.47,0:05:12.85,Default,,0,0,0,,Бұл менің Жапониядағы дебюттік матчым еді.
Dialogue: 0,0:05:12.97,0:05:16.23,Default,,0,0,0,,Неге мұны маған қалдырмайсың?
Dialogue: 0,0:05:19.23,0:05:20.86,Default,,0,0,0,,Сізге айтайын, өтінемін
Dialogue: 0,0:05:20.98,0:05:23.32,Default,,0,0,0,,Сізге кедергі болатын ештеңе жасамаңыз.
Dialogue: 0,0:05:24.90,0:05:27.49,Default,,0,0,0,,Неліктен ол ұшқыш болып таңдалды?
Dialogue: 0,0:05:40.92,0:05:44.84,Default,,0,0,0,,Екі адам алатыны күлкілі. Бұл хобби емес.
Dialogue: 0,0:05:53.06,0:05:54.02,Default,,0,0,0,,О, осында.
Dialogue: 0,0:06:00.98,0:06:01.77,Default,,0,0,0,,Шабуыл басталады
Dialogue: 0,0:06:02.52,0:06:04.65,Default,,0,0,0,,Ал, мен бірінші барамын. Маған қолдау көрсетіңіздерші.
Dialogue: 0,0:06:05.11,0:06:06.24,Default,,0,0,0,,Иә, қолдау?
Dialogue: 0,0:06:06.36,0:06:07.82,Default,,0,0,0,,<Алдымен ханымдар!＞
Dialogue: 0,0:06:07.95,0:06:10.32,Default,,0,0,0,,Тексеріңіз, сіз кейінірек келдіңіз, бірақ жауапты болмаңыз.
Dialogue: 0,0:06:16.08,0:06:17.08,Default,,0,0,0,,Иә, иә?
Dialogue: 0,0:06:24.75,0:06:26.26,Default,,0,0,0,,Нуаааааа!
Dialogue: 0,0:06:30.80,0:06:32.01,Default,,0,0,0,,Тамаша жұмыс
Dialogue: 0,0:06:34.60,0:06:36.77,Default,,0,0,0,,Сіз қалай ойлайсыз?үшінші бала
Dialogue: 0,0:06:36.89,0:06:39.19,Default,,0,0,0,,Ұрыс әрқашан ысырап және әдемі.
Dialogue: 0,0:06:41.35,0:06:43.32,Default,,0,0,0,,Пф
Dialogue: 0,0:06:51.45,0:06:53.70,Default,,0,0,0,,Қандай жалған!
Dialogue: 0,0:06:59.12,0:07:02.00,Default,,0,0,0,,Бүгін 10:58:15.
Dialogue: 0,0:07:02.13,0:07:05.13,Default,,0,0,0,,А нысанасының шабуылына ұшыраған 01 бөлімшесі екі денеге бөлінді.
Dialogue: 0,0:07:05.59,0:07:08.09,Default,,0,0,0,,Суруга шығанағынан 2 км қашықтықта мұхитқа батқан
Dialogue: 0,0:07:08.80,0:07:10.43,Default,,0,0,0,,20 секундтан кейін Бірлік-02
Dialogue: 0,0:07:10.55,0:07:12.80,Default,,0,0,0,,Б нысанасының шабуылына байланысты әрекет тоқтатылды
Dialogue: 0,0:07:13.22,0:07:16.26,Default,,0,0,0,,Осы жағдайға қатысты электрондық жоспар менеджерінің түсініктемелері
Dialogue: 0,0:07:17.85,0:07:20.27,Default,,0,0,0,,Қазірдің өзінде!Сенің кесіріңнен мен дебюттік кездесуімнен жеңіліп қалдым.
Dialogue: 0,0:07:20.39,0:07:21.52,Default,,0,0,0,,Бұл тәртіпсіздікке айналды.
Dialogue: 0,0:07:21.65,0:07:22.94,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:07:23.06,0:07:25.44,Default,,0,0,0,,Сорю жай ғана ақымақтық жасады.
Dialogue: 0,0:07:25.86,0:07:26.94,Default,,0,0,0,,Идиот?
Dialogue: 0,0:07:27.07,0:07:29.15,Default,,0,0,0,,Қалайша сен, ақымақ, бұлай айта аласың?
Dialogue: 0,0:07:29.28,0:07:30.28,Default,,0,0,0,,Бұл өте өркөкіректік.
Dialogue: 0,0:07:30.40,0:07:31.40,Default,,0,0,0,,Не!
Dialogue: 0,0:07:31.49,0:07:33.87,Default,,0,0,0,,Менің ойымша, бұл үлкен мәміле болады, өйткені сіз асығыссыз және оны жеңуге тырысасыз.
Dialogue: 0,0:07:33.99,0:07:35.62,Default,,0,0,0,,Бұл не!теңізде
Dialogue: 0,0:07:35.74,0:07:37.54,Default,,0,0,0,,(Ибуки) 11:03-дегі жағдай бойынша
Dialogue: 0,0:07:37.66,0:07:38.58,Default,,0,0,0,,(Ибуки) NERV мен де.
Dialogue: 0,0:07:38.70,0:07:40.54,Default,,0,0,0,,(Ибуки) Мен басқа адамдар туралы айта алмасам да, операция жасаудан бас тарттым.
Dialogue: 0,0:07:40.66,0:07:43.21,Default,,0,0,0,,Біріккен Ұлттар Ұйымының Екінші майдан күштеріне қолбасшылық берілді.
Dialogue: 0,0:07:43.79,0:07:46.21,Default,,0,0,0,,Мүлдем ұят
Dialogue: 0,0:07:46.34,0:07:47.25,Default,,0,0,0,,Дәл 05 минут
Dialogue: 0,0:07:47.38,0:07:49.67,Default,,0,0,0,,N2 тереңдік зарядтарымен нысанаға шабуыл жасаңыз
Dialogue: 0,0:07:50.76,0:07:53.39,Default,,0,0,0,,(Фуйцуки) Мен картаны қайта салуым керек.
Dialogue: 0,0:07:53.51,0:07:56.05,Default,,0,0,0,,(Ибуки) Құрамдас материалдардың 28%-ын жағуға қол жеткізді
Dialogue: 0,0:07:56.18,0:07:57.06,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:07:57.18,0:07:58.22,Default,,0,0,0,,Бұл жай ғана кедергі.
Dialogue: 0,0:07:58.35,0:07:59.85,Default,,0,0,0,,Қайтадан шабуылға шығуымыз уақыт мәселесі.
Dialogue: 0,0:08:00.64,0:08:04.44,Default,,0,0,0,,Қайта құру үшін уақыт ұтып алу жақсы нәрсе.
Dialogue: 0,0:08:04.52,0:08:05.56,Default,,0,0,0,,Тыңдаңыздар, балалар.
Dialogue: 0,0:08:06.52,0:08:09.11,Default,,0,0,0,,Сіз өзіңіздің жұмысыңыздың не екенін білесіз бе?
Dialogue: 0,0:08:09.23,0:08:10.49,Default,,0,0,0,,Ева басқаруы
Dialogue: 0,0:08:10.61,0:08:11.99,Default,,0,0,0,,Жоқ, бұл елшіні жеңу туралы.
Dialogue: 0,0:08:12.53,0:08:14.07,Default,,0,0,0,,Мұндай жиіркенішті әшкерелеу
Dialogue: 0,0:08:14.20,0:08:16.45,Default,,0,0,0,,Бізде NERV жоқ.
Dialogue: 0,0:08:16.53,0:08:18.74,Default,,0,0,0,,Ол үшін бәріңіз бірлесіп әрекет етуіңіз керек...
Dialogue: 0,0:08:18.87,0:08:20.62,Default,,0,0,0,,Неліктен бұл жігіт?
Dialogue: 0,0:08:20.75,0:08:22.08,Default,,0,0,0,,Жетеді
Dialogue: 0,0:08:24.71,0:08:26.84,Default,,0,0,0,,Неліктен барлығы оңай ашуланады?
Dialogue: 0,0:08:26.96,0:08:29.34,Default,,0,0,0,,Үлкендер ұятқа қалғысы келмейді.
Dialogue: 0,0:08:29.46,0:08:32.01,Default,,0,0,0,,Мм... Мисато-сан?
Dialogue: 0,0:08:32.13,0:08:33.13,Default,,0,0,0,,Тазалау
Dialogue: 0,0:08:33.26,0:08:36.59,Default,,0,0,0,,Жауапкершілікті алу үшін жауапты адам бар.
Dialogue: 0,0:08:37.68,0:08:40.64,Default,,0,0,0,,Тиісті министрліктердің наразылық хаттары мен зиян туралы есептері
Dialogue: 0,0:08:40.77,0:08:43.44,Default,,0,0,0,,Бұл БҰҰ-ның шот-фактурасы.
Dialogue: 0,0:08:43.56,0:08:45.52,Default,,0,0,0,,Қоғаммен байланыс бөлімінен де шағымдар бар.
Dialogue: 0,0:08:45.69,0:08:46.48,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:46.56,0:08:48.11,Default,,0,0,0,,Мұқият оқып шығыңыз.
Dialogue: 0,0:08:48.23,0:08:50.61,Default,,0,0,0,,Түсіну үшін оны оқудың қажеті жоқ.
Dialogue: 0,0:08:50.73,0:08:53.07,Default,,0,0,0,,Егер сіз ұрысатын болсаңыз, оны осында жасауыңыз керек.
Dialogue: 0,0:08:53.19,0:08:54.53,Default,,0,0,0,,Сонымен? Қалаған ауылыңды тамашалай алдың ба?
Dialogue: 0,0:08:58.58,0:09:00.83,Default,,0,0,0,,Мен елшіні міндетті түрде жеңемін.
Dialogue: 0,0:09:01.20,0:09:03.33,Default,,0,0,0,,Екінші қолбасшы - Канкан.
Dialogue: 0,0:09:03.46,0:09:06.29,Default,,0,0,0,,Келесі жолы сізді ұятқа қалдырсам, міндетті түрде сізді төмендетемін.
Dialogue: 0,0:09:07.29,0:09:10.75,Default,,0,0,0,,Қолбасшы Икаридің бұл жерде болмағаны бір бақыт еді.
Dialogue: 0,0:09:10.88,0:09:13.84,Default,,0,0,0,,Егер сіз мұны жасасаңыз, сіз тіпті мұны көрместен бірден жұмыстан шығарыласыз.
Dialogue: 0,0:09:14.38,0:09:18.01,Default,,0,0,0,,Сонымен, сіз мені жұмыстан шығаруға әкелген идеяны әкелдіңіз.
Dialogue: 0,0:09:18.51,0:09:19.55,Default,,0,0,0,,Бір ғана.
Dialogue: 0,0:09:20.22,0:09:25.10,Default,,0,0,0,,Жарайсың, доктор Рицуко Акаги, сізде мейірімді ескі дос болуы керек.
Dialogue: 0,0:09:25.23,0:09:26.39,Default,,0,0,0,,Екі қолда да даңқ; жеңіс – біздің әніміз
Dialogue: 0,0:09:26.52,0:09:28.73,Default,,0,0,0,,Ескі досымды шымшудан құтқаратын мен емеспін.
Dialogue: 0,0:09:29.27,0:09:30.90,Default,,0,0,0,,Бұл идея Каджи-куннан шыққан.
Dialogue: 0,0:09:31.61,0:09:32.82,Default,,0,0,0,,Каджи?
Dialogue: 0,0:09:36.99,0:09:39.87,Default,,0,0,0,,(Жүк көлігінің жүгіру дыбысы)
Dialogue: 0,0:09:46.62,0:09:48.21,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:09:48.33,0:09:52.59,Default,,0,0,0,,десең де, ешкім жоқ...
Dialogue: 0,0:09:53.34,0:09:55.55,Default,,0,0,0,,Уау, бұл не?
Dialogue: 0,0:09:55.63,0:09:56.76,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:09:56.88,0:09:58.97,Default,,0,0,0,,Бұл менің жүгім.
Dialogue: 0,0:09:59.09,0:10:01.22,Default,,0,0,0,,Неліктен Сорю мұнда?
Dialogue: 0,0:10:02.76,0:10:03.89,Default,,0,0,0,,Сіз әлі де сондасыз ба?
Dialogue: 0,0:10:04.31,0:10:06.31,Default,,0,0,0,,Әлі емес... Иә?
Dialogue: 0,0:10:06.85,0:10:08.44,Default,,0,0,0,,Сіз бүгіннен бастап қораптан шығарыласыз.
Dialogue: 0,0:10:08.94,0:10:10.23,Default,,0,0,0,,Олар болашақта бізден тағы да көп нәрсені тартып алады.
Dialogue: 0,0:10:10.36,0:10:12.61,Default,,0,0,0,,Мисато менімен бірге тұрады
Dialogue: 0,0:10:12.73,0:10:16.53,Default,,0,0,0,,Қайсысы жақсы екенін ескерсек, бұл анық таңдау.
Dialogue: 0,0:10:16.65,0:10:18.61,Default,,0,0,0,,Негізі мен Каджи-санмен бірге болғанды ​​жөн көремін.
Dialogue: 0,0:10:19.11,0:10:23.08,Default,,0,0,0,,Жапон бөлмелері неге сонша кішкентай?
Dialogue: 0,0:10:23.20,0:10:25.62,Default,,0,0,0,,Мен жүктерімнің жартысын да сыйдыра алмаймын.
Dialogue: 0,0:10:25.79,0:10:27.91,Default,,0,0,0,,Әй, ә!
Dialogue: 0,0:10:28.41,0:10:32.84,Default,,0,0,0,,Оған қоса, жапондықтарда дағдарыс сезімі неге жеткіліксіз деп ойлаймын.
Dialogue: 0,0:10:32.96,0:10:35.63,Default,,0,0,0,,Мен мұндай бөлмеде құлыпсыз тұра алар едім.
Dialogue: 0,0:10:35.80,0:10:36.63,Default,,0,0,0,,Мен бұған сене алмаймын
Dialogue: 0,0:10:36.76,0:10:39.76,Default,,0,0,0,,Жапон халқы сезімтал және ілтипатты.
Dialogue: 0,0:10:40.39,0:10:41.55,Default,,0,0,0,,Мисато-сан Мисато
Dialogue: 0,0:10:41.68,0:10:44.43,Default,,0,0,0,,Қайтадан қош келдіңіз, сіз жақсы жұмыс істеп жатырсыз.
Dialogue: 0,0:10:44.89,0:10:45.85,Default,,0,0,0,,Не?Не?
Dialogue: 0,0:10:46.27,0:10:48.06,Default,,0,0,0,,Келесі операцияға дайындық
Dialogue: 0,0:10:48.18,0:10:49.35,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:50.23,0:10:52.44,Default,,0,0,0,,Жетінші елшінің бір кемшілігі бар.
Dialogue: 0,0:10:52.56,0:10:55.94,Default,,0,0,0,,Бөлінген ядроға бір мезгілде екі нүктелік жүктеме шабуылы
Dialogue: 0,0:10:56.07,0:10:56.99,Default,,0,0,0,,Бұл жалғыз нұсқа
Dialogue: 0,0:10:58.40,0:11:02.62,Default,,0,0,0,,Басқаша айтқанда, бұл екі Эваның уақытын тамаша синхрондайтын шабуыл.
Dialogue: 0,0:11:03.24,0:11:07.33,Default,,0,0,0,,Ол үшін бізге тамаша үйлесімділікте бірге жұмыс істейтін екі адам қажет.
Dialogue: 0,0:11:07.83,0:11:11.62,Default,,0,0,0,,Сондықтан мен сендерден бұдан былай бірге тұруды сұраймын.
Dialogue: 0,0:11:11.71,0:11:13.29,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:14.04,0:11:17.55,Default,,0,0,0,,Маған ұнамайды! Ұзақ уақыт бойы ұлдар мен қыздар 7 жаста бір мектепте оқымайтын.
Dialogue: 0,0:11:17.96,0:11:22.22,Default,,0,0,0,,Елші қазір өзін-өзі жөндеуде. Екінші толқын 6 күннен кейін болады. Бізде уақыт жоқ.
Dialogue: 0,0:11:22.34,0:11:25.10,Default,,0,0,0,,Бұл соншалықты абайсызда
Dialogue: 0,0:11:25.68,0:11:27.97,Default,,0,0,0,,Сонымен Mucha қалай мүмкін болады
Dialogue: 0,0:11:28.64,0:11:31.31,Default,,0,0,0,,Екі адамның тамаша үйлесімін меңгеру
Dialogue: 0,0:11:31.44,0:11:33.69,Default,,0,0,0,,Осы әнге сәйкес келетін шабуыл үлгілерін есте сақтаңыз.
Dialogue: 0,0:11:34.36,0:11:37.19,Default,,0,0,0,,6 күн ішінде, мүмкіндігінше тезірек бір секунд
Dialogue: 0,0:11:39.19,0:11:39.99,Default,,0,0,0,,Пуи
Dialogue: 0,0:11:48.54,0:11:50.91,Default,,0,0,0,,Бірақ Синдзиге не болды?
Dialogue: 0,0:11:51.04,0:11:53.21,Default,,0,0,0,,Сабаққа келмегеніме үш күн болды.
Dialogue: 0,0:11:53.33,0:11:54.67,Default,,0,0,0,,(лифттің келу дыбысы)
Dialogue: 0,0:11:57.13,0:11:58.30,Default,,0,0,0,,Иә? Төраға?
Dialogue: 0,0:11:58.42,0:11:59.67,Default,,0,0,0,,3 идиот триосының 2 мүшесі
Dialogue: 0,0:11:59.76,0:12:02.18,Default,,0,0,0,,Төраға неге осында?
Dialogue: 0,0:12:02.30,0:12:05.51,Default,,0,0,0,,Сорю мырзаның келуі Неге бәрің осындасыңдар?
Dialogue: 0,0:12:05.64,0:12:07.81,Default,,0,0,0,,Икари-кунның жанашырлығы
Dialogue: 0,0:12:07.93,0:12:09.56,Default,,0,0,0,,Неліктен бұл жерде тоқтайды?Неліктен осы жерде тоқтаңыз?
Dialogue: 0,0:12:10.77,0:12:12.23,Default,,0,0,0,,(есік қоңырауының дыбысы)
Dialogue: 0,0:12:12.73,0:12:13.98,Default,,0,0,0,,Yes
Dialogue: 0,0:12:16.94,0:12:20.36,Default,,0,0,0,,Уф... сатқындық
Dialogue: 0,0:12:20.49,0:12:22.24,Default,,0,0,0,,Тағы да сәйкес келетін көрініс
Dialogue: 0,0:12:22.90,0:12:24.41,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:12:25.16,0:12:28.74,Default,,0,0,0,,(Асука Шинжи) Жапондықтар мұны пішінге қарап түсінеді дейді.
Dialogue: 0,0:12:28.87,0:12:30.33,Default,,0,0,0,,Мисато мәжбүр болды
Dialogue: 0,0:12:31.79,0:12:33.50,Default,,0,0,0,,Лас!Екеуміз де!
Dialogue: 0,0:12:33.62,0:12:35.33,Default,,0,0,0,,Бұл түсінбеушілік. Бұл түсінбеушілік.
Dialogue: 0,0:12:35.46,0:12:36.96,Default,,0,0,0,,Ешқандай құрт немесе тас балық жоқ.
Dialogue: 0,0:12:37.09,0:12:38.75,Default,,0,0,0,,О, қош келдіңіз.
Dialogue: 0,0:12:40.09,0:12:42.38,Default,,0,0,0,,Мұның нені білдіретінін түсіндіріңіз.
Dialogue: 0,0:12:42.51,0:12:44.30,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:12:44.43,0:12:47.60,Default,,0,0,0,,Иә деп айтқаныңызды қалаймын.
Dialogue: 0,0:12:47.72,0:12:50.31,Default,,0,0,0,,Сонымен, Юнисон жақсы жұмыс істеп жатыр ма?
Dialogue: 0,0:12:50.43,0:12:52.31,Default,,0,0,0,,Бұл сіз көріп тұрғандай.
Dialogue: 0,0:12:52.43,0:12:54.19,Default,,0,0,0,,(ритмге сәйкес келмейтін электронды дыбыс)
Dialogue: 0,0:12:54.31,0:12:55.65,Default,,0,0,0,,(Барлығы күрсінеді)
Dialogue: 0,0:12:57.11,0:12:58.61,Default,,0,0,0,,Бұл анық емес!
Dialogue: 0,0:12:58.73,0:12:59.86,Default,,0,0,0,,Осы Синдзи бойынша
Dialogue: 0,0:12:59.98,0:13:00.78,Default,,0,0,0,,Деңгейді төмендету
Dialogue: 0,0:13:00.94,0:13:02.11,Default,,0,0,0,,Бұл нәтиже бермейді.
Dialogue: 0,0:13:02.24,0:13:04.70,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:13:04.82,0:13:05.95,Default,,0,0,0,,Сонда мен тоқтауым керек пе?
Dialogue: 0,0:13:07.24,0:13:08.74,Default,,0,0,0,,Басқа ешкім жоқ, солай ма?
Dialogue: 0,0:13:10.37,0:13:11.62,Default,,0,0,0,,Рэй иә
Dialogue: 0,0:13:11.74,0:13:13.00,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:13:13.12,0:13:14.04,Default,,0,0,0,,Иә
Dialogue: 0,0:13:14.83,0:13:16.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:18.54,0:13:23.59,Default,,0,0,0,,Ха...
Dialogue: 0,0:13:23.72,0:13:25.30,Default,,0,0,0,,О
Dialogue: 0,0:13:25.43,0:13:28.51,Default,,0,0,0,,Мүмкін стратегияны өзгертіп, Рэймен бірлескен дұрыс болар.
Dialogue: 0,0:13:29.05,0:13:29.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:32.27,0:13:33.18,Default,,0,0,0,,Иә
Dialogue: 0,0:13:34.23,0:13:37.27,Default,,0,0,0,,Маған бұл енді ұнамайды!Мен мұны істегім келмейді
Dialogue: 0,0:13:40.06,0:13:40.98,Default,,0,0,0,,Ах, Асука-сан
Dialogue: 0,0:13:41.11,0:13:43.07,Default,,0,0,0,,Тіпті жынның көзінде де жас бар
Dialogue: 0,0:13:43.19,0:13:46.11,Default,,0,0,0,,I-kari-kun!
Dialogue: 0,0:13:48.61,0:13:49.95,Default,,0,0,0,,Мені қуыңыз, иә?
Dialogue: 0,0:13:50.87,0:13:53.83,Default,,0,0,0,,Қыз, сен мені жылаттың!Жауапкершілікті алыңыз!
Dialogue: 0,0:13:59.08,0:14:02.05,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:14:02.80,0:14:04.51,Default,,0,0,0,,Ум... ештеңе айтпа
Dialogue: 0,0:14:09.30,0:14:12.68,Default,,0,0,0,,Мен білемін, менде Еваға мінуден басқа амалым жоқ.
Dialogue: 0,0:14:15.98,0:14:17.56,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:14:18.90,0:14:22.52,Default,,0,0,0,,Егер бұл орын алса, мен Рей мен Мисатоны қайтару үшін бәрін жасаймын.
Dialogue: 0,0:14:22.86,0:14:24.94,Default,,0,0,0,,Мен осылайша артыма қарағаныма сене алар емеспін.
Dialogue: 0,0:14:25.07,0:14:28.24,Default,,0,0,0,,Еркек бола тұра неге тәтті сөйлейсің?
Dialogue: 0,0:14:28.82,0:14:35.20,Default,,0,0,0,,Сен мені ренжіттің... Мен саған мақтанышымды он есе қайтарамын.
Dialogue: 0,0:15:15.62,0:15:16.54,Default,,0,0,0,,Мисато ше?
Dialogue: 0,0:15:16.66,0:15:19.79,Default,,0,0,0,,Маған бүгін түні бойы жұмыста боламын деген қоңырау шалды.
Dialogue: 0,0:15:20.83,0:15:23.17,Default,,0,0,0,,Демек, бүгін түнде екеуміз ғана боламыз.
Dialogue: 0,0:15:23.29,0:15:24.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:36.35,0:15:39.10,Default,,0,0,0,,Бұл ешқашан құламайтын Иерихон қабырғалары.
Dialogue: 0,0:15:39.89,0:15:40.94,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:15:41.10,0:15:43.15,Default,,0,0,0,,Егер сіз бұл қабырғадан аздап өтсеңіз, бұл өлім жазасы болады.
Dialogue: 0,0:15:43.86,0:15:46.57,Default,,0,0,0,,Балалар кеш тұрып, ұйықтау керек.
Dialogue: 0,0:15:48.07,0:15:50.90,Default,,0,0,0,,Неліктен жапондықтар еденде ұйықтай алады?
Dialogue: 0,0:15:50.99,0:15:52.45,Default,,0,0,0,,Мен бұған сене алмаймын
Dialogue: 0,0:15:56.58,0:16:00.08,Default,,0,0,0,,(Құлаққаптан музыка ағып жатыр)
Dialogue: 0,0:16:01.96,0:16:03.12,Default,,0,0,0,,(дыбысты тоқтату)
Dialogue: 0,0:16:03.25,0:16:08.05,Default,,0,0,0,,(аяқ дыбыстары)
Dialogue: 0,0:16:08.17,0:16:08.96,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:10.97,0:16:12.22,Default,,0,0,0,,Уф
Dialogue: 0,0:16:14.01,0:16:15.97,Default,,0,0,0,,(Дәретхананы жуу дыбысы)
Dialogue: 0,0:16:16.14,0:16:17.39,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:20.64,0:16:23.73,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:16:25.94,0:16:26.90,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:27.11,0:16:29.78,Default,,0,0,0,,(таспаны кері айналдыру дыбысы)
Dialogue: 0,0:16:59.72,0:17:00.60,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:17:02.48,0:17:03.68,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:17:05.31,0:17:06.65,Default,,0,0,0,,(дыбысты тоқтату)
Dialogue: 0,0:17:11.19,0:17:12.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:14.36,0:17:16.70,Default,,0,0,0,,Бала болсам да,
Dialogue: 0,0:17:17.91,0:17:19.28,Default,,0,0,0,,Жоқ, мен қарап тұрмын.
Dialogue: 0,0:17:19.41,0:17:21.95,Default,,0,0,0,,(Қажы) Кім?Кім... хмм?
Dialogue: 0,0:17:38.51,0:17:39.51,Default,,0,0,0,,(лифттің келу дыбысы)
Dialogue: 0,0:17:43.43,0:17:45.98,Default,,0,0,0,,Енді Каджи-кунға еш қатысы жоқ.
Dialogue: 0,0:17:46.10,0:17:47.60,Default,,0,0,0,,Өтінемін, мұны тоқтата аласыз ба?
Dialogue: 0,0:17:47.73,0:17:50.98,Default,,0,0,0,,(Қаджи) Бірақ сенің ернің маған тоқта деп айтпады.
Dialogue: 0,0:17:52.48,0:17:57.41,Default,,0,0,0,,Мен қайсысына сенуім керек: сіздің ерніңізге немесе сөздеріңізге?
Dialogue: 0,0:18:11.71,0:18:12.67,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:18.43,0:18:20.85,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:18:21.76,0:18:23.26,Default,,0,0,0,,Мен бүгін әдеттен тыс байсалды емеспін.
Dialogue: 0,0:18:23.39,0:18:25.85,Default,,0,0,0,,Хмм, сәл ғана.
Dialogue: 0,0:18:25.98,0:18:28.48,Default,,0,0,0,,Жұмыс?Әлде еркек пе?
Dialogue: 0,0:18:29.15,0:18:30.10,Default,,0,0,0,,Әртүрлі
Dialogue: 0,0:18:30.23,0:18:31.90,Default,,0,0,0,,Хмм.
Dialogue: 0,0:18:32.02,0:18:33.65,Default,,0,0,0,,Мені әлі де ұнатасыз ба? Буфу!
Dialogue: 0,0:18:34.15,0:18:36.61,Default,,0,0,0,,Эй, біртүрлі ештеңе айтпа.
Dialogue: 0,0:18:36.74,0:18:39.07,Default,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:18:39.16,0:18:42.20,Default,,0,0,0,,Ах, қанша жас болсам да,
Dialogue: 0,0:18:42.33,0:18:46.91,Default,,0,0,0,,Бұл менің өмірімдегі ең үлкен дақ, менің осындай біреумен кездескенім.
Dialogue: 0,0:18:47.04,0:18:50.79,Default,,0,0,0,,Мен айттым бұл Каджи-кун. Мен сені ренжіттім бе?
Dialogue: 0,0:18:50.92,0:18:52.08,Default,,0,0,0,,Сіз
Dialogue: 0,0:18:52.17,0:18:54.46,Default,,0,0,0,,Ашулану сізге шабуыл жасалғанының дәлелі.
Dialogue: 0,0:18:55.09,0:18:59.30,Default,,0,0,0,,Келесі жолы неге шыншыл болмайсың?Сегіз жыл бұрынғыдан басқаша.
Dialogue: 0,0:18:59.88,0:19:03.39,Default,,0,0,0,,Мен өзгерген жоқпын, мүлдем өскен жоқпын.
Dialogue: 0,0:19:04.81,0:19:09.39,Default,,0,0,0,,Ендеше, жұмыс істе, ертең шешуші шайқас.
Dialogue: 0,0:19:21.20,0:19:23.74,Default,,0,0,0,,(Аоба) Нысана Гора абсолютті қорғаныс сызығын бұзды.
Dialogue: 0,0:19:23.87,0:19:26.70,Default,,0,0,0,,Мен осындамын. Мен сені бұл жолы жібермеймін.
Dialogue: 0,0:19:30.58,0:19:33.50,Default,,0,0,0,,＜Онда екеуің де жоспарды орындаңдар, жарай ма?＞
Dialogue: 0,0:19:35.50,0:19:37.13,Default,,0,0,0,,Мақсат таулы аймақты басып алады
Dialogue: 0,0:19:37.80,0:19:41.05,Default,,0,0,0,,Жарайды ма?Мен басынан бастап максималды жауынгерлік жылдамдықпен жұмыс істеймін.
Dialogue: 0,0:19:41.51,0:19:44.18,Default,,0,0,0,,Мен білемін, мен оны 62 секундта аяқтаймын.
Dialogue: 0,0:19:44.68,0:19:47.18,Default,,0,0,0,,Мақсат Нөлдік нүктеге жету
Dialogue: 0,0:19:47.35,0:19:48.14,Default,,0,0,0,,Сыртқы қуатты тазалау
Dialogue: 0,0:19:50.94,0:19:51.98,Default,,0,0,0,,Бастау
Dialogue: 0,0:19:54.40,0:19:59.36,Default,,0,0,0,,♪~
Dialogue: 0,0:20:51.66,0:20:56.25,Default,,0,0,0,,~♪
Dialogue: 0,0:20:56.42,0:20:59.71,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:21:09.14,0:21:12.14,Default,,0,0,0,,О, қандай ұят!
Dialogue: 0,0:21:13.43,0:21:15.27,Default,,0,0,0,,(Телефон қоңырауы)
Dialogue: 0,0:21:16.65,0:21:19.98,Default,,0,0,0,,Эй!Менің 02 бөлімшеме не істеп жатырсың!
Dialogue: 0,0:21:20.11,0:21:22.57,Default,,0,0,0,,Менің ойымша, бұл сіздің басыңыздан өтті.
Dialogue: 0,0:21:22.69,0:21:25.24,Default,,0,0,0,,Соңында уақытты өткізіп алған адам осы болды, солай ма?
Dialogue: 0,0:21:27.91,0:21:30.16,Default,,0,0,0,,<Кеше түнде ұйықтамай не істедің?＞
Dialogue: 0,0:21:40.13,0:21:41.21,Default,,0,0,0,,<Қорқынышты!＞
Dialogue: 0,0:21:41.34,0:21:43.30,Default,,0,0,0,,<Мен мұны әзіл ретінде айттым. Бұл рас болды ма?＞
Dialogue: 0,0:21:44.55,0:21:47.13,Default,,0,0,0,,Мен болмады. Жарты жолда тоқтадым.
Dialogue: 0,0:21:47.26,0:21:49.30,Default,,0,0,0,,Эротикалық зорлықшы Pervert Мен бұған сене алмаймын!
Dialogue: 0,0:21:49.80,0:21:51.60,Default,,0,0,0,,(Операторлардың күлкісі)
Dialogue: 0,0:21:55.81,0:21:57.73,Default,,0,0,0,,Мені тағы да ұятқа қалдыр
Dialogue: 0,0:22:01.32,0:22:06.28,Default,,0,0,0,,♪~
Dialogue: 0,0:23:01.21,0:23:06.17,Default,,0,0,0,,~♪
Dialogue: 0,0:23:07.51,0:23:09.93,Default,,0,0,0,,(Баяндама)
Dialogue: 0,0:23:11.43,0:23:16.43,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
