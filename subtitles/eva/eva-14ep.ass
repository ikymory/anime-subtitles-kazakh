Dialogue: 0,0:00:05.60,0:00:06.96,Default,,0,0,0,,♪~
Dialogue: 0,0:01:26.71,0:01:31.30,Default,,0,0,0,,~♪
Dialogue: 0,0:01:39.01,0:01:42.76,Default,,0,0,0,,(Оқ атылған дыбыс)
Dialogue: 0,0:01:48.10,0:01:49.27,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:03:16.07,0:03:17.15,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:03:58.90,0:04:00.94,Default,,0,0,0,,(Оқ атылған дыбыс)
Dialogue: 0,0:04:01.07,0:04:04.70,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:04:37.31,0:04:40.15,Default,,0,0,0,,(Оқ атылған дыбыс)
Dialogue: 0,0:05:04.17,0:05:07.59,Default,,0,0,0,,(Хигурашидің айқайы)
Dialogue: 0,0:07:32.78,0:07:38.54,Default,,0,0,0,,(Комитет)
Dialogue: 0,0:08:16.03,0:08:20.25,Default,,0,0,0,,Тааааааааааааа!
Dialogue: 0,0:08:27.75,0:08:32.51,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:09:52.34,0:09:55.84,Default,,0,0,0,,(Оқ атылған дыбыс)
Dialogue: 0,0:10:30.83,0:10:34.38,Default,,0,0,0,,Бірақ… егер осылай жалғастырсақ…
Dialogue: 0,0:10:46.98,0:10:50.40,Default,,0,0,0,,(мүше)
Dialogue: 0,0:10:51.56,0:10:55.36,Default,,0,0,0,,Елшілердің NERV штаб-пәтеріне басып кіруі күтпеген еді.
Dialogue: 0,0:10:55.86,0:10:58.07,Default,,0,0,0,,(Комитет мүшесі) Мен Орталық Догмаға енгім келеді.
Dialogue: 0,0:10:58.19,0:10:59.03,Default,,0,0,0,,Кешіру деген нені білдіреді?
Dialogue: 0,0:10:59.45,0:11:03.66,Default,,0,0,0,,(мүше) Егер байланыс орын алса, барлық жоспарлар босқа кетеді.
Dialogue: 0,0:11:04.49,0:11:06.95,Default,,0,0,0,,Комитетке есеп беру жалған ақпарат болып табылады
Dialogue: 0,0:11:07.08,0:11:09.62,Default,,0,0,0,,Апостол шапқыншылығының дәлелі жоқ.
Dialogue: 0,0:11:09.71,0:11:11.33,Default,,0,0,0,,Икари
Dialogue: 0,0:11:11.46,0:11:15.17,Default,,0,0,0,,11-ші Апостол басып алғаны туралы ешқандай дәлел жоқ.
Dialogue: 0,0:11:16.05,0:11:16.84,Default,,0,0,0,,Иә
Dialogue: 0,0:11:16.96,0:11:19.42,Default,,0,0,0,,Байқап сөйле, Икари-кун.
Dialogue: 0,0:11:19.55,0:11:21.93,Default,,0,0,0,,Бұл бөлмеде жалған куәлік өлімге лайық.
Dialogue: 0,0:11:22.59,0:11:25.85,Default,,0,0,0,,Magi рекордерін зерттеуге қош келдіңіз.
Dialogue: 0,0:11:25.97,0:11:28.31,Default,,0,0,0,,Бұл факт тіркелмеген.
Dialogue: 0,0:11:28.43,0:11:32.40,Default,,0,0,0,,Мені күлдірме. Шындықты жасыру ең жақсы ставка емес пе?
Dialogue: 0,0:11:33.02,0:11:34.15,Default,,0,0,0,,Уақыт кестесі
Dialogue: 0,0:11:34.27,0:11:37.07,Default,,0,0,0,,Істер Өлі теңіз шиыршықтарында сипатталғандай жүріп жатыр.
Dialogue: 0,0:11:37.19,0:11:41.99,Default,,0,0,0,,(Кил) Жарайды, мен бұл жолы сіздің күнәларыңыз бен міндеттеріңізді айтпаймын.
Dialogue: 0,0:11:43.57,0:11:47.37,Default,,0,0,0,,Бірақ жаңа сценарий жасаудың қажеті жоқ.
Dialogue: 0,0:11:48.45,0:11:53.79,Default,,0,0,0,,Түсінемін, бәрі Зеле сценарийі бойынша.
Dialogue: 0,0:12:03.64,0:12:08.64,Default,,0,0,0,,(Рей Аянами)
Dialogue: 0,0:12:23.20,0:12:27.95,Default,,0,0,0,,<Су Жақсы сезінетін нәрсе командир Икари?＞
Dialogue: 0,0:12:28.08,0:12:32.58,Default,,0,0,0,,＜Гүлдер: бірдей нәрселер көп, қажетсіз заттар көп＞
Dialogue: 0,0:13:00.48,0:13:04.70,Default,,0,0,0,,<Адам дегеніміз не?Құдай нені жаратқан?＞
Dialogue: 0,0:13:04.82,0:13:07.20,Default,,0,0,0,,<Адамдарды адам жаратты ма?＞
Dialogue: 0,0:13:15.71,0:13:18.29,Default,,0,0,0,,<Бұл кім?Бұл мен＞
Dialogue: 0,0:13:18.79,0:13:24.72,Default,,0,0,0,,<Мен кіммін?Мен қандаймын?Мен қандаймын?Мен қандаймын?Мен қандаймын?＞
Dialogue: 0,0:13:51.87,0:13:52.91,Default,,0,0,0,,<Икари-кун?＞
Dialogue: 0,0:14:02.05,0:14:03.30,Default,,0,0,0,,<қолбасшы Икари?＞
Dialogue: 0,0:14:03.42,0:14:07.22,Default,,0,0,0,,<Сіз кімсіз?＞
Dialogue: 0,0:14:09.55,0:14:12.68,Default,,0,0,0,,(Рицуко Акаги) болды
Dialogue: 0,0:14:14.68,0:14:16.02,Default,,0,0,0,,Мен Икари-кунның иісін сеземін.
Dialogue: 0,0:14:20.81,0:14:24.28,Default,,0,0,0,,Синхрондау жылдамдығы 0 бірліктегімен дерлік бірдей.
Dialogue: 0,0:14:24.40,0:14:26.78,Default,,0,0,0,,(Майя Ибуки) Олардың жеке үлгілері де өте ұқсас.
Dialogue: 0,0:14:26.90,0:14:28.03,Default,,0,0,0,,0 бірлік және 01 бірлік
Dialogue: 0,0:14:28.53,0:14:31.16,Default,,0,0,0,,Сондықтан синхрондау мүмкін
Dialogue: 0,0:14:31.78,0:14:34.33,Default,,0,0,0,,Қате плюс немесе минус 0,03
Dialogue: 0,0:14:34.45,0:14:35.83,Default,,0,0,0,,Гармониялар қалыпты
Dialogue: 0,0:14:36.70,0:14:39.83,Default,,0,0,0,,Ray және 01 құрылғысы арасындағы үйлесімділікте ақаулар анықталмады
Dialogue: 0,0:14:44.84,0:14:45.76,Default,,0,0,0,,Иә
Dialogue: 0,0:15:02.48,0:15:03.69,Default,,0,0,0,,Бұл анық, солай емес пе?
Dialogue: 0,0:15:09.11,0:15:11.11,Default,,0,0,0,,<0 блогының жеке деректері туралы не деуге болады?＞
Dialogue: 0,0:15:11.24,0:15:13.07,Default,,0,0,0,,(Ибуки)
Dialogue: 0,0:15:16.04,0:15:16.83,Default,,0,0,0,,Субъектілер кімдер?
Dialogue: 0,0:15:16.95,0:15:18.66,Default,,0,0,0,,Біраз шиеленіс болса да
Dialogue: 0,0:15:18.79,0:15:20.87,Default,,0,0,0,,Нейрондық үлгіде проблема жоқ
Dialogue: 0,0:15:22.04,0:15:25.13,Default,,0,0,0,,Менің бірінші бірлігім 0. Басқа Эвас.
Dialogue: 0,0:15:25.25,0:15:26.21,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:15:26.34,0:15:31.01,Default,,0,0,0,,Ей, ақымақ, бұл туралы уайымдамауың керек.
Dialogue: 0,0:15:33.93,0:15:36.22,Default,,0,0,0,,Мен білемін, сондықтан мен ақымақпын
Dialogue: 0,0:15:38.14,0:15:41.14,Default,,0,0,0,,Айтпақшы, бұл екі адам арасындағы ұшақ алмасу сынағы
Dialogue: 0,0:15:41.27,0:15:43.44,Default,,0,0,0,,Мен қатысуым керек пе?
Dialogue: 0,0:15:43.56,0:15:47.02,Default,,0,0,0,,<Асука 02-ден басқа ештеңеге мінгісі келмейді, солай ма?＞
Dialogue: 0,0:15:47.15,0:15:49.90,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:16:00.71,0:16:04.08,Default,,0,0,0,,болып табылады
Dialogue: 0,0:16:04.21,0:16:06.25,Default,,0,0,0,,Мен өзімді біртүрлі сезінемін.
Dialogue: 0,0:16:06.38,0:16:07.63,Default,,0,0,0,,<Өзіңізді жайсыз сезінесіз бе? ＞
Dialogue: 0,0:16:07.75,0:16:09.17,Default,,0,0,0,,Жоқ, жай...
Dialogue: 0,0:16:11.55,0:16:14.09,Default,,0,0,0,,Иісі қандай?Сен бұзық емессің бе?
Dialogue: 0,0:16:14.22,0:16:16.93,Default,,0,0,0,,(Ибуки)
Dialogue: 0,0:16:18.85,0:16:20.98,Default,,0,0,0,,(Ер)
Dialogue: 0,0:16:24.81,0:16:27.61,Default,,0,0,0,,(Ибуки)
Dialogue: 0,0:16:27.73,0:16:28.61,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:16:28.73,0:16:31.57,Default,,0,0,0,,Өйткені, оның бірінші үлгідегідей синхрондау жылдамдығы жоқ.
Dialogue: 0,0:16:32.36,0:16:34.45,Default,,0,0,0,,(Ибуки) Гармониялардың барлығы қалыпты күйде
Dialogue: 0,0:16:34.57,0:16:36.53,Default,,0,0,0,,Бірақ бұл жақсы сан.
Dialogue: 0,0:16:36.66,0:16:39.58,Default,,0,0,0,,Енді біз бұл жоспарды жүзеге асыра аламыз.
Dialogue: 0,0:16:40.20,0:16:44.50,Default,,0,0,0,,Бұл жалған жүйе ме? Мен ағаларымның алдында тұрмын, бірақ мен шынымен...
Dialogue: 0,0:16:44.62,0:16:48.92,Default,,0,0,0,,Мен сізге әсер етпегеніңізді білемін, бірақ сіз әрқашан дайын болуыңыз керек.
Dialogue: 0,0:16:49.25,0:16:51.42,Default,,0,0,0,,Адамдардың аман қалуы үшін
Dialogue: 0,0:16:51.55,0:16:54.80,Default,,0,0,0,,Мен үлкендерімді құрметтеймін және өз жұмысымды істеймін.
Dialogue: 0,0:16:54.93,0:16:56.34,Default,,0,0,0,,Бірақ мен сенімді емеспін.
Dialogue: 0,0:16:56.84,0:17:00.77,Default,,0,0,0,,Гермофоб болу қиын, адамдар арасында өмір сүру.
Dialogue: 0,0:17:02.02,0:17:05.19,Default,,0,0,0,,Мен өзімді қашан лас сезінетінімді білемін
Dialogue: 0,0:17:13.69,0:17:16.24,Default,,0,0,0,,(Хината)
Dialogue: 0,0:17:18.74,0:17:20.45,Default,,0,0,0,,<Әлде ішіңізде ме?＞
Dialogue: 0,0:17:25.33,0:17:28.50,Default,,0,0,0,,Неліктен барлығы Шинджиді соншалықты бүлдіреді?
Dialogue: 0,0:17:33.46,0:17:35.05,Default,,0,0,0,,Уф, бұл не?
Dialogue: 0,0:17:35.22,0:17:41.26,Default,,0,0,0,,А, менің басыма бір нәрсе келеді...
Dialogue: 0,0:17:42.31,0:17:45.43,Default,,0,0,0,,Аянами?Рей Аянами?
Dialogue: 0,0:17:45.56,0:17:48.35,Default,,0,0,0,,Бұл Рей Аянами.
Dialogue: 0,0:17:48.48,0:17:50.15,Default,,0,0,0,,(Қанаттарын қаққан құстардың дыбысы)
Dialogue: 0,0:17:50.27,0:17:51.44,Default,,0,0,0,,<Аянами?＞
Dialogue: 0,0:17:52.53,0:17:53.61,Default,,0,0,0,,Олай емес пе?
Dialogue: 0,0:17:58.03,0:17:58.86,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:59.41,0:18:01.33,Default,,0,0,0,,Ұшқыштың жүйке импульсінде ауытқу орын алды.
Dialogue: 0,0:18:01.45,0:18:03.24,Default,,0,0,0,,Психикалық ластану басталды
Dialogue: 0,0:18:03.37,0:18:05.75,Default,,0,0,0,,Мүмкін емес!? Бұл тығынның тереңдігімен бұл мүмкін емес.
Dialogue: 0,0:18:06.12,0:18:09.04,Default,,0,0,0,,(Ибуки) Бұл тығын емес, бұл Евадан шыққан эрозия.
Dialogue: 0,0:18:17.55,0:18:19.59,Default,,0,0,0,,0 бірлік: бақыланбайды
Dialogue: 0,0:18:22.56,0:18:24.35,Default,,0,0,0,,Барлық тізбектер өшірілді, қуат өшірілді!
Dialogue: 0,0:18:30.56,0:18:32.90,Default,,0,0,0,,(Ибуки)
Dialogue: 0,0:18:34.44,0:18:35.61,Default,,0,0,0,,Сен ше, Синдзи?
Dialogue: 0,0:18:35.74,0:18:37.65,Default,,0,0,0,,(Хината) Тізбекті ажырату!Бақылау мүмкін емес!
Dialogue: 0,0:18:37.78,0:18:39.82,Default,,0,0,0,,Unit-00 Синдзиден бас тартады!?
Dialogue: 0,0:18:39.95,0:18:43.12,Default,,0,0,0,,Жоқ!автоматты шығару жұмыс істемейді
Dialogue: 0,0:18:43.28,0:18:47.20,Default,,0,0,0,,Тағы да солай ма?Сол кезде Синдзи-кунды қосуды жоспарлап отырсыз ба?
Dialogue: 0,0:18:54.09,0:18:55.13,Default,,0,0,0,,Рэй, артқа тұр!
Dialogue: 0,0:18:55.30,0:18:57.13,Default,,0,0,0,,Рэй!(Ибуки)
Dialogue: 0,0:19:11.94,0:19:13.81,Default,,0,0,0,,Ұшқышты құтқарыңыз Асығыңыз!
Dialogue: 0,0:19:22.28,0:19:23.12,Default,,0,0,0,,Бұл оқиға
Dialogue: 0,0:19:23.20,0:19:25.41,Default,,0,0,0,,Мұның алдыңғы қашып кеткен апатқа қатысы бар ма?
Dialogue: 0,0:19:25.53,0:19:27.45,Default,,0,0,0,,Сол кезде Реймен
Dialogue: 0,0:19:27.58,0:19:29.91,Default,,0,0,0,,Мен әлі ештеңе айта алмаймын.
Dialogue: 0,0:19:30.04,0:19:31.87,Default,,0,0,0,,Деректерді Ray-ге қайтару жеткілікті
Dialogue: 0,0:19:32.00,0:19:35.96,Default,,0,0,0,,Бізге мүмкіндігінше тезірек 0 блогымен макияжды синхрондау сынағы қажет.
Dialogue: 0,0:19:36.09,0:19:37.30,Default,,0,0,0,,Операциялық директор ретінде
Dialogue: 0,0:19:37.42,0:19:39.63,Default,,0,0,0,,Мұны мүмкіндігінше тезірек жасауыңызды сұраймын.
Dialogue: 0,0:19:39.76,0:19:41.76,Default,,0,0,0,,Менің жұмысыма кедергі келтірмес бұрын.
Dialogue: 0,0:19:41.88,0:19:42.84,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:19:42.97,0:19:44.10,Default,,0,0,0,,Миса Катсураги
Dialogue: 0,0:19:57.57,0:19:58.61,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:58.73,0:20:03.70,Default,,0,0,0,,(теледидар дыбысы)
Dialogue: 0,0:20:25.80,0:20:28.01,Default,,0,0,0,,Мен бұл төбені тағы да жек көремін.
Dialogue: 0,0:20:29.22,0:20:33.23,Default,,0,0,0,,Шинджидің санасы қайта оралды. Ластанудың кейінгі салдары жоқ.
Dialogue: 0,0:20:33.98,0:20:36.90,Default,,0,0,0,,Оның өзі ештеңе есіне түсірмеген сияқты.
Dialogue: 0,0:20:37.02,0:20:38.11,Default,,0,0,0,,Иә
Dialogue: 0,0:20:38.23,0:20:42.40,Default,,0,0,0,,(Радио аудио)
Dialogue: 0,0:20:49.49,0:20:51.25,Default,,0,0,0,,Бірінші бала қандай?
Dialogue: 0,0:20:53.00,0:20:54.75,Default,,0,0,0,,Жоспарланбаған елші шабуылы
Dialogue: 0,0:20:55.29,0:20:59.25,Default,,0,0,0,,Адамгершілікті аяқтау комитеті бұл фактіні білгеннен кейін оны алға жылжытты ма?
Dialogue: 0,0:20:59.38,0:21:04.68,Default,,0,0,0,,Жалғыз жұмысы шағымдану болып табылатын ақымақ адамдар.
Dialogue: 0,0:21:05.51,0:21:08.10,Default,,0,0,0,,Бізде барлық козир бар
Dialogue: 0,0:21:08.22,0:21:09.68,Default,,0,0,0,,Олар ештеңе істей алмайды
Dialogue: 0,0:21:10.43,0:21:13.39,Default,,0,0,0,,(Фуйцуки) Бұл тітіркендіргіш дегенді білдірмейді.
Dialogue: 0,0:21:13.52,0:21:17.69,Default,,0,0,0,,Егер SEELE бортқа қазір отырса, қиын болар еді.
Dialogue: 0,0:21:17.81,0:21:22.11,Default,,0,0,0,,Барлығы біздің сценарий бойынша, проблема жоқ.
Dialogue: 0,0:21:22.82,0:21:24.82,Default,,0,0,0,,0 блоктағы апат туралы не деуге болады?
Dialogue: 0,0:21:24.95,0:21:27.11,Default,,0,0,0,,Бұл менің сценарийімде емес.
Dialogue: 0,0:21:27.24,0:21:28.82,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:21:29.45,0:21:32.66,Default,,0,0,0,,Rei және Unit 00 қайта синхрондау сәтті аяқталды.
Dialogue: 0,0:21:36.25,0:21:38.29,Default,,0,0,0,,Адам жобасы туралы не деуге болады?
Dialogue: 0,0:21:38.42,0:21:41.00,Default,,0,0,0,,Біз жолда келе жатырмыз.Біз тіпті 2 пайыз да артта қалған жоқпыз.
Dialogue: 0,0:21:41.13,0:21:43.46,Default,,0,0,0,,Сонымен, Лонгинустың найзасы туралы не деуге болады?
Dialogue: 0,0:21:43.59,0:21:46.30,Default,,0,0,0,,Бұл кесте бойынша. Рэй жұмыс істеп жатыр.
Dialogue: 0,0:22:02.02,0:22:06.99,Default,,0,0,0,,♪~
Dialogue: 0,0:23:02.00,0:23:06.96,Default,,0,0,0,,~♪
Dialogue: 0,0:23:15.06,0:23:17.93,Default,,0,0,0,,<Бұл оған берілген соңғы мүмкіндік пе?＞
