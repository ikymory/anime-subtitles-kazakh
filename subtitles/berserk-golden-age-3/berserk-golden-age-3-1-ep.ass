Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:23.82,0:00:24.88,Default,,0,0,0,,Мені күт
Dialogue: 0,0:00:24.92,0:00:26.44,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:00:28.36,0:00:29.29,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:00:35.83,0:00:36.96,Default,,0,0,0,,Мені күт
Dialogue: 0,0:00:37.33,0:00:38.20,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:02:16.73,0:02:17.29,Default,,0,0,0,,Ішім!
Dialogue: 0,0:02:56.09,0:02:57.67,Default-ja,,0,0,0,,Ханзада
Dialogue: 0,0:02:56.14,0:02:57.66,Default,,0,0,0,,Ханзада
Dialogue: 0,0:02:57.80,0:03:03.30,Default-ja,,0,0,0,,Кешірімсіз ханзадамыз.
Dialogue: 0,0:02:57.94,0:03:03.14,Default,,0,0,0,,Біздердің ханзадасы Кешірілмеген
Dialogue: 0,0:03:03.72,0:03:06.31,Default-ja,,0,0,0,,Мен сіздермен аудитория болғым келеді...
Dialogue: 0,0:03:03.75,0:03:06.91,Default,,0,0,0,,Біз сіздермен аудитория іздейміз
Dialogue: 0,0:03:30.41,0:03:34.33,Default-ja,,0,0,0,,Мен сені бір күні оның елінде көремін.
Dialogue: 0,0:03:30.54,0:03:34.13,Default,,0,0,0,,Біз кездесеміз. сол уақытта. сол жерде.
Dialogue: 0,0:03:34.75,0:03:40.13,Default-ja,,0,0,0,,Біздің вассал, аңсаған бақытты патша...
Dialogue: 0,0:03:34.81,0:03:39.94,Default,,0,0,0,,Біз туысқанбыз. о, сағыныш патшасы құтты болсын.
Dialogue: 0,0:04:24.59,0:04:27.72,Default-ja,,0,0,0,,Оны бұл жолы Шетодан көрген сияқты.
Dialogue: 0,0:04:24.76,0:04:27.52,Default,,0,0,0,,Бұл жолы Четте көрінді
Dialogue: 0,0:04:27.85,0:04:28.89,Default-ja,,0,0,0,,Не…
Dialogue: 0,0:04:27.93,0:04:28.92,Default,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:04:29.06,0:04:31.93,Default-ja,,0,0,0,,Әр жерде оғаш оқиғалар болып жатыр...
Dialogue: 0,0:04:29.13,0:04:34.09,Default,,0,0,0,,Бұл оғаш оқиғалар қандай зұлымдықты көрсетеді?
Dialogue: 0,0:04:32.06,0:04:34.10,Default-ja,,0,0,0,,Бұл қандай жаман белгі?
Dialogue: 0,0:04:34.23,0:04:36.69,Default-ja,,0,0,0,,Қасиетті Тақ тергеу тобын жібере ме...
Dialogue: 0,0:04:34.34,0:04:36.96,Default,,0,0,0,,Қасиетті Тақ тергеу үшін тергеу комиссиясын жібереді
Dialogue: 0,0:04:36.81,0:04:41.15,Default-ja,,0,0,0,,Әй, ақыры Киелі Тақ та қозғала бастады.
Dialogue: 0,0:04:38.04,0:04:41.17,Default,,0,0,0,,Сонымен, тіпті Қасиетті Тақ әрекет етуде
Dialogue: 0,0:07:20.27,0:07:22.69,Default-ja,,0,0,0,,Тым тереңдеп кетпеңіз
Dialogue: 0,0:07:20.44,0:07:21.99,Default,,0,0,0,,Оны асыра алмаңыз
Dialogue: 0,0:07:25.23,0:07:27.57,Default-ja,,0,0,0,,Тіпті құлап қалсаңыз да...
Dialogue: 0,0:07:25.27,0:07:27.37,Default,,0,0,0,,Сізді біздің үстімізден құлата алмаймыз
Dialogue: 0,0:07:28.69,0:07:29.61,Default-ja,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:07:28.81,0:07:29.80,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:07:31.36,0:07:34.87,Default-ja,,0,0,0,,Рикерт қайтып келді. Біз Гриффиттің қайда екенін білеміз.
Dialogue: 0,0:07:31.41,0:07:32.78,Default,,0,0,0,,Рикерт қайтып келді
Dialogue: 0,0:07:33.31,0:07:34.87,Default,,0,0,0,,Ол Гриффитті қайда ұстайтынын білді
Dialogue: 0,0:07:35.95,0:07:37.24,Default-ja,,0,0,0,,Жарайды... онда!
Dialogue: 0,0:07:36.25,0:07:37.38,Default,,0,0,0,,Содан кейін!
Dialogue: 0,0:07:44.50,0:07:45.75,Default-ja,,0,0,0,,Асықпаңыз
Dialogue: 0,0:07:44.63,0:07:45.62,Default,,0,0,0,,Асықпаңыз
Dialogue: 0,0:07:46.46,0:07:47.59,Default-ja,,0,0,0,,Бірақ...
Dialogue: 0,0:07:46.59,0:07:47.58,Default,,0,0,0,,Бірақ
Dialogue: 0,0:07:49.71,0:07:51.72,Default-ja,,0,0,0,,Әркім өз шегінде.
Dialogue: 0,0:07:49.80,0:07:51.36,Default,,0,0,0,,Әркім өз шегіне жетті
Dialogue: 0,0:07:52.13,0:07:54.64,Default-ja,,0,0,0,,Бір жыл бойы осылай қашып жүрмін.
Dialogue: 0,0:07:52.20,0:07:54.36,Default,,0,0,0,,Бір жыл бойы жүгіріп келеміз
Dialogue: 0,0:07:54.89,0:07:56.47,Default-ja,,0,0,0,,Шаршау шыңында...
Dialogue: 0,0:07:55.04,0:07:56.40,Default,,0,0,0,,Барлығымыз әбден шаршадық
Dialogue: 0,0:07:57.74,0:08:01.14,Default,,0,0,0,,Бірақ біз бірден әрекет ете алмайтын сияқтымыз
Dialogue: 0,0:07:57.76,0:08:01.06,Default-ja,,0,0,0,,Бірақ бұл дәл қазір ештеңе істей алмайтыныңызды білдірмейді.
Dialogue: 0,0:08:06.19,0:08:07.65,Default-ja,,0,0,0,,Әйтеуір, қазір демалыңыз.
Dialogue: 0,0:08:06.28,0:08:07.51,Default,,0,0,0,,Дәл қазір демалу керек
Dialogue: 0,0:08:10.22,0:08:11.21,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:10.28,0:08:10.94,Default-ja,,0,0,0,,Рахмет
Dialogue: 0,0:08:27.00,0:08:29.25,Default-ja,,0,0,0,,Майор… Майор Гилберт
Dialogue: 0,0:08:27.07,0:08:29.33,Default,,0,0,0,,Жаудың шабуылы!
Dialogue: 0,0:08:31.01,0:08:33.60,Default,,0,0,0,,Рикерттің соңынан ерді ме?
Dialogue: 0,0:08:31.05,0:08:33.88,Default-ja,,0,0,0,,Рикерт, сіз ұсталды!
Dialogue: 0,0:08:45.27,0:08:47.31,Default-ja,,0,0,0,,Мен қатты толқыдым
Dialogue: 0,0:08:45.45,0:08:47.15,Default,,0,0,0,,Бұл жақсы қадам болды
Dialogue: 0,0:08:47.46,0:08:49.89,Default,,0,0,0,,Мен оны өте танымал әйел командирге тапсыруым керек
Dialogue: 0,0:08:47.48,0:08:51.15,Default-ja,,0,0,0,,Сұңқырлар тобының әйел көшбасшысы күткендей.
Сұңқар тобының
Dialogue: 0,0:08:49.92,0:08:51.02,Default,,0,0,0,,of the Band of the Hawk
Dialogue: 0,0:08:51.28,0:08:56.16,Default-ja,,0,0,0,,Дегенмен, кез келген шайқаста жеңіс немесе жеңіліс командир басын көтергенде шешіледі.
Dialogue: 0,0:08:51.33,0:08:52.59,Default,,0,0,0,,Бірақ кез келген шайқаста,
Dialogue: 0,0:08:52.63,0:08:54.60,Default,,0,0,0,,басшының басын алу сәті
Dialogue: 0,0:08:54.63,0:08:56.06,Default,,0,0,0,,- нәтижені шешу сәті
Dialogue: 0,0:08:56.32,0:08:57.16,Default-ja,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:08:56.36,0:08:57.35,Default,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:09:00.58,0:09:02.70,Default-ja,,0,0,0,,Бұл не деген балалар!
Dialogue: 0,0:09:01.54,0:09:02.97,Default,,0,0,0,,Ол не сұмдық?!
Dialogue: 0,0:09:07.71,0:09:09.37,Default,,0,0,0,,Қарапайым жау жоқ, бұл анық!
Dialogue: 0,0:09:07.71,0:09:09.21,Default-ja,,0,0,0,,Ол жай ғана жау емес!
Dialogue: 0,0:09:16.93,0:09:18.05,Default-ja,,0,0,0,,Каска!
Dialogue: 0,0:09:16.95,0:09:17.94,Default,,0,0,0,,Каска!
Dialogue: 0,0:09:27.94,0:09:29.40,Default-ja,,0,0,0,,Бұл шайқас болды
Dialogue: 0,0:09:27.96,0:09:29.26,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:09:30.02,0:09:34.03,Default-ja,,0,0,0,,Бар болғаны қылышыңды лақтырып, адамдарыңа берілуді бұйырсаң болғаны.
Dialogue: 0,0:09:30.03,0:09:33.99,Default,,0,0,0,,Ер адамдарыңа айт, қылыштарын тастасын, сонда аман қаласың
Dialogue: 0,0:09:34.19,0:09:37.36,Default-ja,,0,0,0,,Әйтпесе, басын кесіп тастаңыз.
Dialogue: 0,0:09:34.27,0:09:37.30,Default,,0,0,0,,Әйтпесе, қазір басыңды кесіп аламын
Dialogue: 0,0:09:37.57,0:09:39.91,Default-ja,,0,0,0,,Үш санау Таңдау
Dialogue: 0,0:09:37.71,0:09:39.97,Default,,0,0,0,,Енді үш саны бойынша таңдаңыз
Dialogue: 0,0:09:40.41,0:09:41.66,Default-ja,,0,0,0,,Бір
Dialogue: 0,0:09:40.47,0:09:41.57,Default,,0,0,0,,Бір
Dialogue: 0,0:09:43.62,0:09:44.87,Default-ja,,0,0,0,,Екі
Dialogue: 0,0:09:43.68,0:09:44.91,Default,,0,0,0,,Екі
Dialogue: 0,0:09:48.78,0:09:49.91,Default,,0,0,0,,Үш!
Dialogue: 0,0:09:48.79,0:09:50.17,Default-ja,,0,0,0,,Үш!
Dialogue: 0,0:09:55.38,0:09:56.84,Default-ja,,0,0,0,,Йоцу!
Dialogue: 0,0:09:55.39,0:09:56.41,Default,,0,0,0,,Төрт!
Dialogue: 0,0:09:58.88,0:10:01.76,Default-ja,,0,0,0,,Көше өнерпаздарынан бас тартпа.
Dialogue: 0,0:09:58.93,0:10:01.52,Default,,0,0,0,,Бұл көше әртісі сізді шаршатпасын
Dialogue: 0,0:10:04.64,0:10:07.48,Default-ja,,0,0,0,,Ащы бол, Сеннинчо
Dialogue: 0,0:10:04.70,0:10:06.79,Default,,0,0,0,,Өзіңізді жинаңыз Командир
Dialogue: 0,0:10:10.04,0:10:11.06,Default,,0,0,0,,Ішім!
Dialogue: 0,0:10:10.06,0:10:11.27,Default-ja,,0,0,0,,Ішім!
Dialogue: 0,0:10:11.54,0:10:12.80,Default,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:10:11.73,0:10:12.73,Default-ja,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:10:13.27,0:10:16.28,Default-ja,,0,0,0,,Капитан! Сен қайтып келдің!
Dialogue: 0,0:10:13.37,0:10:16.04,Default,,0,0,0,,Капитан! Сен қайтып келдің!
Dialogue: 0,0:10:21.12,0:10:24.41,Default-ja,,0,0,0,,О! Менде депрессияға уақыт жоқ.
Dialogue: 0,0:10:21.28,0:10:24.12,Default,,0,0,0,,Келіңіздер! Отыруды доғар!
Dialogue: 0,0:10:24.54,0:10:27.45,Default-ja,,0,0,0,,Бұны маған қалдыр, сен жұмысыңды істейсің.
Dialogue: 0,0:10:24.62,0:10:25.71,Default,,0,0,0,,Мен мұнымен айналысамын
Dialogue: 0,0:10:25.99,0:10:27.39,Default,,0,0,0,,Сен барып жұмысыңды істейсің
Dialogue: 0,0:10:33.21,0:10:34.25,Default-ja,,0,0,0,,Уууууууу!!
Dialogue: 0,0:10:33.29,0:10:34.28,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:10:43.10,0:10:45.54,Default,,0,0,0,,Артында қалыңыз және араласпаңыз
Dialogue: 0,0:10:43.10,0:10:45.64,Default-ja,,0,0,0,,Қайтып кел, маған кедергі жасама.
Dialogue: 0,0:10:47.43,0:10:49.85,Default-ja,,0,0,0,,Мен бұл жігітті өлтіремін.
Dialogue: 0,0:10:47.54,0:10:49.41,Default,,0,0,0,,Ол менікі
Dialogue: 0,0:11:01.03,0:11:04.99,Default-ja,,0,0,0,,Мына жүзді найзағайдай өз денеңмен ал!
Dialogue: 0,0:11:01.09,0:11:05.05,Default,,0,0,0,,Бұл найзағай күркіреуі сізді құлатады!
Dialogue: 0,0:11:06.62,0:11:08.45,Default-ja,,0,0,0,,Ти!
Dialogue: 0,0:11:18.92,0:11:20.72,Default-ja,,0,0,0,,О, ау!
Dialogue: 0,0:11:22.54,0:11:23.53,Default,,0,0,0,,Не-?!
Dialogue: 0,0:11:31.22,0:11:32.62,Default,,0,0,0,,Неге сен!
Dialogue: 0,0:11:31.52,0:11:33.02,Default-ja,,0,0,0,,Уау
Dialogue: 0,0:11:33.35,0:11:34.48,Default,,0,0,0,,Мастер Силат!
Dialogue: 0,0:11:33.40,0:11:34.69,Default-ja,,0,0,0,,Құрметті Сират!
Dialogue: 0,0:11:38.53,0:11:39.69,Default-ja,,0,0,0,,Түсіру
Dialogue: 0,0:11:38.66,0:11:39.65,Default,,0,0,0,,Юкине-кун?
Dialogue: 0,0:11:40.36,0:11:41.56,Default,,0,0,0,,Әзірге артқа шегініңіз
Dialogue: 0,0:11:40.36,0:11:41.53,Default-ja,,0,0,0,,Мен қазірше артқа шегінемін.
Dialogue: 0,0:11:45.53,0:11:46.52,Default,,0,0,0,,Каска!
Dialogue: 0,0:11:45.57,0:11:46.53,Default-ja,,0,0,0,,Каска!
Dialogue: 0,0:11:59.25,0:12:01.22,Default-ja,,0,0,0,,Зардап шеккендерге көмек көрсету
Dialogue: 0,0:12:01.34,0:12:02.42,Default-ja,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:12:03.84,0:12:05.09,Default-ja,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:21.74,0:12:24.28,Default-ja,,0,0,0,,Не! ? Гриффит...?
Dialogue: 0,0:12:21.80,0:12:22.79,Default,,0,0,0,,Жер
Dialogue: 0,0:12:23.30,0:12:24.29,Default,,0,0,0,,Гриффит болды ма?!
Dialogue: 0,0:12:24.40,0:12:27.82,Default-ja,,0,0,0,,Әй, сен кеткеннен кейінгі күннің оқиғасы.
Dialogue: 0,0:12:24.47,0:12:27.64,Default,,0,0,0,,Иә, бұл сіз кеткеннен кейінгі күні болды
Dialogue: 0,0:12:27.99,0:12:31.75,Default-ja,,0,0,0,,Хе! Бізді Мидлендтің құтқарушылары ретінде қарсы алды...
Dialogue: 0,0:12:28.84,0:12:31.87,Default,,0,0,0,,Бір күні бізді Мидлендтің құтқарушылары деп атайды
Dialogue: 0,0:12:31.87,0:12:36.38,Default-ja,,0,0,0,,Бір түнде сені іздеді, ал ақсүйектердің арманы кетті
Dialogue: 0,0:12:31.91,0:12:33.97,Default,,0,0,0,,және бір түнде біз қылмыскер деп танылдық
Dialogue: 0,0:12:34.52,0:12:36.38,Default,,0,0,0,,Асыл болу үшін қаншама
Dialogue: 0,0:12:37.21,0:12:39.80,Default-ja,,0,0,0,,Менің ойымша, бұл сізге маңызды емес.
Dialogue: 0,0:12:37.28,0:12:39.31,Default,,0,0,0,,Бірақ, менің ойымша, сіз бұл туралы алаңдамайсыз
Dialogue: 0,0:12:40.17,0:12:42.09,Default-ja,,0,0,0,,Бірақ мен оны мойындамаймын.
Dialogue: 0,0:12:40.25,0:12:41.75,Default,,0,0,0,,Мен сізді кері қабылдамаймын
Dialogue: 0,0:12:42.42,0:12:47.43,Default-ja,,0,0,0,,Қиын кезде қасында болмаған бейбақты мен досым деп санамаймын.
Dialogue: 0,0:12:42.49,0:12:44.76,Default,,0,0,0,,Ең керек кезде осында болмаған бейбақ емес
Dialogue: 0,0:12:45.33,0:12:47.16,Default,,0,0,0,,Ол менің жолдасым емес
Dialogue: 0,0:12:55.06,0:12:56.10,Default-ja,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:12:55.07,0:12:56.06,Default,,0,0,0,,Күзетте
Dialogue: 0,0:12:56.34,0:12:57.33,Default,,0,0,0,,Жер
Dialogue: 0,0:12:59.67,0:13:00.66,Default,,0,0,0,,Эй, күт!
Dialogue: 0,0:12:59.69,0:13:02.86,Default-ja,,0,0,0,,Бір минут күтіңіз! Мен дәл қазір қан құмарлыққа толы болдым.
Dialogue: 0,0:13:01.04,0:13:02.70,Default,,0,0,0,,Сіз мені дәл қазір өлтірмек болдыңыз!
Dialogue: 0,0:13:04.99,0:13:06.70,Default-ja,,0,0,0,,Сәлем, Каска!
Dialogue: 0,0:13:05.05,0:13:06.48,Default,,0,0,0,,Н-Сәлем, Каска!
Dialogue: 0,0:13:11.85,0:13:12.84,Default,,0,0,0,,Маған төмен қарама!
Dialogue: 0,0:13:11.87,0:13:14.33,Default-ja,,0,0,0,,Жалама, қылышыңды сөндір!
Dialogue: 0,0:13:12.99,0:13:14.51,Default,,0,0,0,,Қылышыңды тарт!
Dialogue: 0,0:13:19.08,0:13:21.17,Default-ja,,0,0,0,,Ол әлі де беймаза жігіт.
Dialogue: 0,0:13:19.13,0:13:21.15,Default,,0,0,0,,Сіз бұрынғыдай абайсызсыз
Dialogue: 0,0:13:22.05,0:13:23.63,Default-ja,,0,0,0,,Маған себебін көрсетіңіз
Dialogue: 0,0:13:22.10,0:13:23.16,Default,,0,0,0,,Сізде қандай мәселе бар?
Dialogue: 0,0:13:24.63,0:13:26.13,Default-ja,,0,0,0,,Бұл сен кінәлісің...
Dialogue: 0,0:13:24.80,0:13:25.82,Default,,0,0,0,,Бұл сен кінәлі
Dialogue: 0,0:13:28.80,0:13:31.97,Default-ja,,0,0,0,,Сіз бәрін жойдыңыз...
Dialogue: 0,0:13:28.84,0:13:31.40,Default,,0,0,0,,Сен бәрін құрттың
Dialogue: 0,0:13:36.27,0:13:38.35,Default-ja,,0,0,0,,Бұл сен кінәлісің!
Dialogue: 0,0:13:36.34,0:13:37.83,Default,,0,0,0,,Бұл сен кінәлісің!
Dialogue: 0,0:13:39.27,0:13:42.23,Default-ja,,0,0,0,,Сіз Гриффитті де, Шұңқырлар тобын да шатастырдыңыз!
Dialogue: 0,0:13:39.28,0:13:40.94,Default,,0,0,0,,Гриффит және сұңқар тобы
Dialogue: 0,0:13:40.98,0:13:42.31,Default,,0,0,0,,Сіз бәрін жойдыңыз!
Dialogue: 0,0:13:42.57,0:13:44.23,Default-ja,,0,0,0,,Мен? неге
Dialogue: 0,0:13:42.68,0:13:43.98,Default,,0,0,0,,Мен? Неліктен?
Dialogue: 0,0:13:44.48,0:13:47.11,Default-ja,,0,0,0,,Сен сондай ақымақсың ба?
Dialogue: 0,0:13:44.69,0:13:45.98,Default,,0,0,0,,Сен қандай ақымақсың?!
Dialogue: 0,0:13:46.22,0:13:47.21,Default,,0,0,0,,Сіз!
Dialogue: 0,0:13:50.57,0:13:53.91,Default-ja,,0,0,0,,Гриффиттің бәрі сен еді!
Dialogue: 0,0:13:50.66,0:13:53.75,Default,,0,0,0,,Гриффит жалғыз сен едің!
Dialogue: 0,0:13:54.41,0:13:58.17,Default-ja,,0,0,0,,Гриффиттің қасында жалғыз сен болдың!
Dialogue: 0,0:13:54.46,0:13:58.02,Default,,0,0,0,,Сіз Гриффитке жақын болған жалғыз адамсыз!
Dialogue: 0,0:14:00.00,0:14:02.67,Default-ja,,0,0,0,,Сен Гриффитті әлсіреттің!
Dialogue: 0,0:14:00.10,0:14:02.97,Default,,0,0,0,,Сіз Гриффитті әлсіз еттіңіз!
Dialogue: 0,0:14:05.05,0:14:05.96,Default-ja,,0,0,0,,Гриффит...
Dialogue: 0,0:14:05.07,0:14:06.06,Default,,0,0,0,,Гриффит
Dialogue: 0,0:14:07.88,0:14:08.68,Default-ja,,0,0,0,,Гриффит...
Dialogue: 0,0:14:07.91,0:14:08.77,Default,,0,0,0,,Гриффит
Dialogue: 0,0:14:12.78,0:14:15.11,Default,,0,0,0,,сенсіз жақсылық жоқ!
Dialogue: 0,0:14:12.85,0:14:15.56,Default-ja,,0,0,0,,Мен сенсіз істей алмаймын!
Dialogue: 0,0:14:34.03,0:14:35.91,Default-ja,,0,0,0,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:14:34.13,0:14:35.26,Default,,0,0,0,,Бұл дұрыс емес
Dialogue: 0,0:14:36.41,0:14:39.67,Default-ja,,0,0,0,,Ол Гриффит...
Dialogue: 0,0:14:36.47,0:14:39.60,Default,,0,0,0,,Біз бұл жерде Гриффит туралы айтып отырмыз
Dialogue: 0,0:14:40.34,0:14:41.64,Default,,0,0,0,,Гриффит
Dialogue: 0,0:14:40.37,0:14:41.46,Default-ja,,0,0,0,,Сол Гриффит...
Dialogue: 0,0:14:41.58,0:14:43.67,Default-ja,,0,0,0,,Жібер! Қан...
Dialogue: 0,0:14:41.68,0:14:43.51,Default,,0,0,0,,Жібер! Қансырап жатырсың
Dialogue: 0,0:14:44.17,0:14:45.25,Default-ja,,0,0,0,,Мен...
Dialogue: 0,0:14:44.21,0:14:48.21,Default,,0,0,0,,Мен жай ғана өз ісімді жасадым
Dialogue: 0,0:14:45.92,0:14:50.63,Default-ja,,0,0,0,,Мен жай ғана өз ісімді істедім... Гриффит сияқты.
Dialogue: 0,0:14:49.15,0:14:50.74,Default,,0,0,0,,Гриффит сияқты
Dialogue: 0,0:14:50.84,0:14:53.05,Default-ja,,0,0,0,,Мен түсіндім, сондықтан жібер, ақымақ!
Dialogue: 0,0:14:50.85,0:14:53.15,Default,,0,0,0,,Жарайды, түсіндім! Жібер, ақымақ!
Dialogue: 0,0:15:06.40,0:15:08.49,Default-ja,,0,0,0,,Мен Гриффиттікімін
Dialogue: 0,0:15:06.47,0:15:10.06,Default,,0,0,0,,Мен Гриффиттің қылышына айнала алмадым
Dialogue: 0,0:15:08.61,0:15:11.74,Default-ja,,0,0,0,,Мен қылыш немесе әйел бола алмадым...
Dialogue: 0,0:15:10.10,0:15:11.63,Default,,0,0,0,,немесе оның әйелі
Dialogue: 0,0:15:15.08,0:15:17.41,Default-ja,,0,0,0,,Мен шынымен де білдім
Dialogue: 0,0:15:15.28,0:15:16.87,Default,,0,0,0,,Шынымды айтсам, мен білдім
Dialogue: 0,0:15:17.91,0:15:22.62,Default-ja,,0,0,0,,Мені сыйғызатын орын жоқ сияқты...
Dialogue: 0,0:15:17.98,0:15:22.38,Default,,0,0,0,,Оның жүрегінде маған орын жоқ екенін баяғыда түсіндім
Dialogue: 0,0:15:23.58,0:15:25.71,Default-ja,,0,0,0,,Мен қатты тырыстым:
Dialogue: 0,0:15:23.62,0:15:27.75,Default,,0,0,0,,Бірақ мен бас тартудан бас тарттым, өйткені егер берсем,
Dialogue: 0,0:15:26.09,0:15:29.97,Default-ja,,0,0,0,,Өйткені мен мұны істемесем, жоқ болып кетер едім.
Dialogue: 0,0:15:27.79,0:15:29.81,Default,,0,0,0,,Мен жоғалып кетемін деп ойладым
Dialogue: 0,0:15:31.49,0:15:32.48,Default,,0,0,0,,Каска
Dialogue: 0,0:15:31.59,0:15:32.43,Default-ja,,0,0,0,,Каска...
Dialogue: 0,0:15:33.89,0:15:35.39,Default,,0,0,0,,Бірақ бәрі дұрыс
Dialogue: 0,0:15:33.89,0:15:39.10,Default-ja,,0,0,0,,Бірақ жетеді, мен... шаршадым.
Dialogue: 0,0:15:36.63,0:15:38.86,Default,,0,0,0,,Мен шаршадым
Dialogue: 0,0:15:40.73,0:15:43.60,Default-ja,,0,0,0,,Қалғаны өзіңізге байланысты.
Dialogue: 0,0:15:40.80,0:15:43.33,Default,,0,0,0,,Қалғанын өзіңіз жасайсыз
Dialogue: 0,0:16:27.55,0:16:29.61,Default,,0,0,0,,Қарғыс атсын! Не ойлап қалдың?!
Dialogue: 0,0:16:27.56,0:16:29.98,Default-ja,,0,0,0,,Сен не ойладың!
Dialogue: 0,0:16:30.11,0:16:33.70,Default-ja,,0,0,0,,Тыңда, жарға тым жақындама.
Dialogue: 0,0:16:30.12,0:16:33.25,Default,,0,0,0,,Тыңдаңыз! Ешқашан жарға жақындама, енді ешқашан!
Dialogue: 0,0:16:40.49,0:16:44.23,Default,,0,0,0,,Мені тағы бір рет сүйреп апаруға шыдай алмаймын! Қарғыс атсын!
Dialogue: 0,0:16:40.49,0:16:45.00,Default-ja,,0,0,0,,Мені екі-үш рет сүйреп, құлатқанына шыдай алмаймын.
Dialogue: 0,0:16:46.00,0:16:48.60,Default,,0,0,0,,Менен бәрін алдың
Dialogue: 0,0:16:46.00,0:16:48.88,Default-ja,,0,0,0,,Менен бәрін тартып алған ол.
Dialogue: 0,0:16:50.25,0:16:53.05,Default-ja,,0,0,0,,Мен оны өлтіргім келсе де...
Dialogue: 0,0:16:50.47,0:16:52.44,Default,,0,0,0,,Мен сені дәл қазір өлтіргім келеді
Dialogue: 0,0:16:53.97,0:16:55.01,Default-ja,,0,0,0,,Барка
Dialogue: 0,0:16:54.14,0:16:55.23,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:16:55.31,0:16:56.30,Default,,0,0,0,,Сәлем
Dialogue: 0,0:16:59.26,0:17:03.14,Default-ja,,0,0,0,,Менің кесірімнен үнемі зардап шегесің...
Dialogue: 0,0:16:59.31,0:17:00.98,Default,,0,0,0,,Сіз әрқашан зардап шегесіз
Dialogue: 0,0:17:01.58,0:17:02.64,Default,,0,0,0,,мен үшін
Dialogue: 0,0:17:04.68,0:17:08.06,Default-ja,,0,0,0,,Үнемі қан ағып жатырсың...
Dialogue: 0,0:17:04.72,0:17:07.81,Default,,0,0,0,,Үнемі қан ағып жатырсың
Dialogue: 0,0:17:11.78,0:17:13.53,Default-ja,,0,0,0,,Баркер…
Dialogue: 0,0:17:11.83,0:17:13.16,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:19:28.62,0:19:29.62,Default-ja,,0,0,0,,Жоқ, біз бұлай істей алмаймыз!
Dialogue: 0,0:19:28.66,0:19:29.65,Default,,0,0,0,,Сәлем
Dialogue: 0,0:19:30.76,0:19:31.79,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:19:32.17,0:19:35.84,Default-ja,,0,0,0,,Гриффитті құтқарғаннан кейін ол шықты.
Dialogue: 0,0:19:32.20,0:19:35.76,Default,,0,0,0,,Гриффитті құтқарғаннан кейін кетесіз бе?
Dialogue: 0,0:19:36.34,0:19:39.63,Default-ja,,0,0,0,,Аа, мен қатал болғым келеді.
Dialogue: 0,0:19:36.44,0:19:39.50,Default,,0,0,0,,Иә, мен өз шешімдерімді ұстанамын
Dialogue: 0,0:19:49.25,0:19:52.41,Default,,0,0,0,,Сіз менімен бірге келуіңіз керек
Dialogue: 0,0:19:49.27,0:19:52.69,Default-ja,,0,0,0,,Сен... менімен бірге жүр.
Dialogue: 0,0:19:52.95,0:19:53.94,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:19:53.90,0:19:56.27,Default-ja,,0,0,0,,Гриффитті құтқарсаң, менімен бірге жүр.
Dialogue: 0,0:19:53.99,0:19:55.98,Default,,0,0,0,,Гриффитті құтқарғаннан кейін менімен бірге жүріңіз
Dialogue: 0,0:19:57.86,0:19:59.33,Default,,0,0,0,,Мен болашақта не болатынын білмеймін
Dialogue: 0,0:19:57.86,0:19:59.86,Default-ja,,0,0,0,,Мен болашақта не күтіп тұрғанын білмеймін...
Dialogue: 0,0:20:01.32,0:20:02.45,Default-ja,,0,0,0,,Бірақ
Dialogue: 0,0:20:01.40,0:20:02.39,Default,,0,0,0,,Бірақ
Dialogue: 0,0:20:05.41,0:20:08.37,Default-ja,,0,0,0,,Бұлай жалғаса берсе, мен сені жеткілікті түрде ұстай алмаймын
Dialogue: 0,0:20:05.60,0:20:08.30,Default,,0,0,0,,Мен саған тоймаймын
Dialogue: 0,0:20:08.40,0:20:09.70,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,0:20:08.95,0:20:10.12,Default-ja,,0,0,0,,Иә…♡
Dialogue: 0,0:20:11.62,0:20:15.54,Default-ja,,0,0,0,,Мен сені болашақта жүздеген, мыңдаған рет ұстағым келеді...
Dialogue: 0,0:20:11.71,0:20:15.87,Default,,0,0,0,,Мен сенің жүздегеніңді алғым келеді
Dialogue: 0,0:20:15.88,0:20:17.42,Default-ja,,0,0,0,,Мен қазір солай ойлаймын
Dialogue: 0,0:20:15.91,0:20:17.14,Default,,0,0,0,,осыдан бастап мыңдаған рет
Dialogue: 0,0:20:19.46,0:20:20.42,Default-ja,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:20:19.75,0:20:20.74,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,0:20:20.84,0:20:23.72,Default-ja,,0,0,0,,Ақымақ болма, мен оны білемін.
Dialogue: 0,0:20:20.95,0:20:22.14,Default,,0,0,0,,Мені ақымақ деп айтуды доғар
Dialogue: 0,0:20:22.68,0:20:23.67,Default,,0,0,0,,Мен бұл туралы білемін
Dialogue: 0,0:21:23.65,0:21:26.49,Default-ja,,0,0,0,,Әй, Каска, оян, Каска!
Dialogue: 0,0:21:23.68,0:21:24.70,Default,,0,0,0,,Сәлем, Каска
Dialogue: 0,0:21:25.11,0:21:26.71,Default,,0,0,0,,Оян, Каска!
Dialogue: 0,0:22:09.91,0:22:13.49,Default-ja,,0,0,0,,Тісті берілістер айнала бастады...
Dialogue: 0,0:22:09.99,0:22:13.39,Default,,0,0,0,,Мен дөңгелектің айнала бастағанын көріп тұрмын
Dialogue: 0,0:22:16.70,0:22:19.62,Default-ja,,0,0,0,,Ақымақ, сөзсіз артта.
Dialogue: 0,0:22:16.80,0:22:19.13,Default,,0,0,0,,Не? Мен оның артымда болғанына сенімдімін
Dialogue: 0,0:22:38.43,0:22:39.85,Default-ja,,0,0,0,,Не деген сұмдық! ?
Dialogue: 0,0:22:38.49,0:22:39.82,Default,,0,0,0,,Сен кімсің?!
Dialogue: 0,0:22:40.14,0:22:43.57,Default-ja,,0,0,0,,Көңіл ал, күрескен.
Dialogue: 0,0:22:40.29,0:22:43.19,Default,,0,0,0,,Сөзімді тыңда, күрескен
Dialogue: 0,0:22:44.82,0:22:46.90,Default-ja,,0,0,0,,Осыдан кейін сізге...
Dialogue: 0,0:22:44.86,0:22:46.95,Default,,0,0,0,,Көп ұзамай қорқыныш жаңбыр жауды,
Dialogue: 0,0:22:46.99,0:22:49.33,Default,,0,0,0,,сіз басқара алмайтын ұнатулар,
Dialogue: 0,0:22:47.03,0:22:53.03,Default-ja,,0,0,0,,Ақылсыз нөсер, адам денесі ешқашан құтқара алмайтын өлім дауылы.
Dialogue: 0,0:22:49.36,0:22:50.76,Default,,0,0,0,,сізге түседі
Dialogue: 0,0:22:51.06,0:22:52.97,Default,,0,0,0,,Өлім дауылы
Dialogue: 0,0:22:53.91,0:22:57.08,Default-ja,,0,0,0,,Есте болыңыз, күресушілер.
Dialogue: 0,0:22:53.97,0:22:56.90,Default,,0,0,0,,Бірақ жаныңды ал, күресуші
Dialogue: 0,0:22:57.66,0:23:00.29,Default-ja,,0,0,0,,Күрес, сынақ, күрес!
Dialogue: 0,0:22:57.67,0:23:00.04,Default,,0,0,0,,Қарсыласыңыз, қарсы тұрыңыз және көбірек күресіңіз
Dialogue: 0,0:23:00.42,0:23:03.96,Default-ja,,0,0,0,,Өліммен бетпе-бет келгендердің жалғыз семсері осы.
Dialogue: 0,0:23:00.54,0:23:04.27,Default,,0,0,0,,Өліммен бетпе-бет келетін қылыш осы ғана
Dialogue: 0,0:23:04.92,0:23:07.71,Default-ja,,0,0,0,,Армандауды ұмытпаңыз
Dialogue: 0,0:23:04.95,0:23:07.28,Default,,0,0,0,,Бұл сөздерді ұмытпа
Dialogue: 0,0:23:09.63,0:23:13.60,Default-ja,,0,0,0,,Әй, ей, не айтып тұрсың! ? Күте тұрыңыз!
Dialogue: 0,0:23:09.72,0:23:10.81,Default,,0,0,0,,Аякаши оны кесіп өте алмайды
Dialogue: 0,0:23:11.35,0:23:13.18,Default,,0,0,0,,Мұның бәрі не туралы болды?! Күте тұрыңыз!
Dialogue: 0,0:23:55.43,0:23:57.68,Default-ja,,0,0,0,,Бұл олқылықты табу жақсы жұмыс.
Dialogue: 0,0:23:55.50,0:23:57.83,Default,,0,0,0,,Бұл жерді қалай таптың?
Dialogue: 0,0:23:57.81,0:23:59.72,Default-ja,,0,0,0,,Сақтандырушы бар.
Dialogue: 0,0:23:57.86,0:23:59.53,Default,,0,0,0,,Маған іштен біраз көмек болды
Dialogue: 0,0:24:02.14,0:24:05.02,Default-ja,,0,0,0,,Гриффитті құтқарғысы келетін адам...
Dialogue: 0,0:24:02.27,0:24:07.21,Default,,0,0,0,,Бұл Гриффитті құтқарғысы келетін жалғыз біз емес екенімізді білдіреді
Dialogue: 0,0:24:05.15,0:24:07.82,Default-ja,,0,0,0,,Бұл біздің жалғыз емес екенімізді білдіреді.
Dialogue: 0,0:24:08.27,0:24:11.15,Default-ja,,0,0,0,,Алайда қамалдағы адамдар...
Dialogue: 0,0:24:08.38,0:24:10.90,Default,,0,0,0,,Бірақ қамалдан келген инсайдерлер?
Dialogue: 0,0:24:16.53,0:24:18.28,Default-ja,,0,0,0,,Сіз Hawk тобынансыз ба?
Dialogue: 0,0:24:16.55,0:24:18.18,Default,,0,0,0,,Сіз Hawk тобындасыз ба?
Dialogue: 0,0:24:19.69,0:24:21.15,Default,,0,0,0,,Мен сені күттім
Dialogue: 0,0:24:19.70,0:24:24.54,Default-ja,,0,0,0,,Мен сені күттім. Сіз шынымен келдіңіз.
Dialogue: 0,0:24:22.19,0:24:24.62,Default,,0,0,0,,Сіз шынымен келдіңіз
Dialogue: 0,0:24:24.96,0:24:25.95,Default,,0,0,0,,Ханшайым?!
Dialogue: 0,0:24:24.96,0:24:28.50,Default-ja,,0,0,0,,Ханшайым! ? Сонымен, инсайдер ...
Dialogue: 0,0:24:26.33,0:24:28.56,Default,,0,0,0,,Іштен келген көмекші сен бе?!
Dialogue: 0,0:24:28.80,0:24:31.17,Default-ja,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:24:28.83,0:24:30.86,Default,,0,0,0,,Иә, бұл мен болдым
Dialogue: 0,0:24:47.65,0:24:49.82,Default-ja,,0,0,0,,Бұл тесік қаншаға дейін барады?
Dialogue: 0,0:24:47.75,0:24:49.81,Default,,0,0,0,,Бұл тесік қанша төмен түседі?
Dialogue: 0,0:24:50.94,0:24:55.45,Default-ja,,0,0,0,,Баяғыда, мың жылдай бұрын болған.
Dialogue: 0,0:24:50.95,0:24:55.41,Default,,0,0,0,,Көп жылдар бұрын, шамамен мың жыл
Dialogue: 0,0:24:55.99,0:24:57.69,Default,,0,0,0,,Соғыс жылдарында
Dialogue: 0,0:24:55.99,0:24:57.53,Default-ja,,0,0,0,,Бұл соғыс кезі еді.
Dialogue: 0,0:24:57.72,0:24:58.71,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:24:58.66,0:25:02.70,Default-ja,,0,0,0,,Дүрбелеңге нүкте қоятын адам көрінді.
Dialogue: 0,0:24:58.76,0:25:02.53,Default,,0,0,0,,Соғыс дәуіріне нүкте қойған біреу пайда болды
Dialogue: 0,0:25:05.58,0:25:07.33,Default-ja,,0,0,0,,Оверлорд Гайзерик
Dialogue: 0,0:25:05.67,0:25:07.16,Default,,0,0,0,,Жоғарғы патша Гейзерик
Dialogue: 0,0:25:08.00,0:25:12.59,Default-ja,,0,0,0,,Ол өз өмірінде бүкіл континентті қамтыған империя құрды.
Dialogue: 0,0:25:08.03,0:25:10.33,Default,,0,0,0,,Материктің барлық аймақтарын бағындырды
Dialogue: 0,0:25:10.37,0:25:12.36,Default,,0,0,0,,және бір ұрпақта империя құрды
Dialogue: 0,0:25:13.26,0:25:18.09,Default-ja,,0,0,0,,Оның тұлғасы жұмбақ болғанымен, ол шайқаста өте шебер...
Dialogue: 0,0:25:13.31,0:25:15.78,Default,,0,0,0,,Оның айналасында көптеген жұмбақ бар
Dialogue: 0,0:25:16.41,0:25:18.38,Default,,0,0,0,,Бірақ ол шайқаста шебер және
Dialogue: 0,0:25:18.41,0:25:23.32,Default,,0,0,0,,ол ұрыс даласында үнемі бас сүйегінің бетперде киіп жүретіні айтылады
Dialogue: 0,0:25:18.51,0:25:23.18,Default-ja,,0,0,0,,Ұрыс кезінде үнемі бас сүйегінің бетперде киіп жүретіні айтылады.
Dialogue: 0,0:25:23.35,0:25:25.39,Default-ja,,0,0,0,,Сонда мен бұл туралы естідім.
Dialogue: 0,0:25:23.55,0:25:27.42,Default,,0,0,0,,Мен Бас сүйегінің патшасы туралы әңгімені бұрын естігенмін
Dialogue: 0,0:25:25.52,0:25:27.52,Default-ja,,0,0,0,,Бас сүйегінің патшасы туралы әңгіме
Dialogue: 0,0:25:28.02,0:25:32.53,Default-ja,,0,0,0,,Бірақ билікке батып бара жатқан патша Құдай жіберген бес періштеге жүгінді ...
Dialogue: 0,0:25:28.05,0:25:30.11,Default,,0,0,0,,Бірақ патша күшке мас болды,
Dialogue: 0,0:25:30.16,0:25:35.19,Default,,0,0,0,,және Құдай оның артынан бес періште жіберіп, астанасын жойды
Dialogue: 0,0:25:32.65,0:25:35.19,Default-ja,,0,0,0,,Бүкіл қала қирады.
Dialogue: 0,0:25:35.36,0:25:36.78,Default-ja,,0,0,0,,4 адам болған жоқ па?
Dialogue: 0,0:25:35.40,0:25:36.80,Default,,0,0,0,,Төрт емес пе?
Dialogue: 0,0:25:37.56,0:25:41.26,Default,,0,0,0,,Ендеше әлгі ертегінің бұл тесікке қандай қатысы бар?
Dialogue: 0,0:25:37.66,0:25:41.20,Default-ja,,0,0,0,,Олай болса, бұл ертегі осы тесікке қалай қосылған?
Dialogue: 0,0:25:42.12,0:25:47.62,Default-ja,,0,0,0,,Бұл ертегі емес! Кем дегенде, бұл қала шынымен болған.
Dialogue: 0,0:25:42.17,0:25:44.00,Default,,0,0,0,,Бұл ертегі емес!
Dialogue: 0,0:25:44.40,0:25:47.43,Default,,0,0,0,,Кем дегенде, астана шынымен де болған
Dialogue: 0,0:25:48.04,0:25:50.54,Default-ja,,0,0,0,,Осы тік тесіктің тереңдігінде
Dialogue: 0,0:25:48.14,0:25:50.30,Default,,0,0,0,,Осы туннельдің түбінде тереңде
Dialogue: 0,0:25:58.18,0:25:59.31,Default,,0,0,0,,О, балам
Dialogue: 0,0:25:58.18,0:25:59.30,Default-ja,,0,0,0,,Қандай бақыттысыңдар, барлық қызықты өзіңе алдыңдар.
Dialogue: 0,0:26:38.55,0:26:39.72,Default-ja,,0,0,0,,Гриффит?
Dialogue: 0,0:26:38.63,0:26:39.72,Default,,0,0,0,,Гриффит?
Dialogue: 0,0:26:39.84,0:26:41.26,Default-ja,,0,0,0,,Гриффит мырза!
Dialogue: 0,0:26:39.86,0:26:41.45,Default,,0,0,0,,Лорд Гриффит!
Dialogue: 0,0:26:44.60,0:26:45.72,Default-ja,,0,0,0,,Біреу бар!
Dialogue: 0,0:26:44.66,0:26:45.65,Default,,0,0,0,,Біреу бар!
Dialogue: 0,0:26:48.89,0:26:49.73,Default-ja,,0,0,0,,Гри...! ?
Dialogue: 0,0:26:48.97,0:26:49.96,Default,,0,0,0,,Гри-
Dialogue: 0,0:26:52.56,0:26:54.36,Default-ja,,0,0,0,,Gri... fiss?
Dialogue: 0,0:26:52.57,0:26:54.44,Default,,0,0,0,,Grif фитнес?
Dialogue: 0,0:26:58.28,0:26:59.28,Default-ja,,0,0,0,,Гриффит!
Dialogue: 0,0:26:58.35,0:26:59.34,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:27:04.74,0:27:06.41,Default-ja,,0,0,0,,Аяқ-қол сіңірлері кесілген
Dialogue: 0,0:27:04.78,0:27:06.18,Default,,0,0,0,,Қолдары мен аяқтарының сіңірлері кесілген
Dialogue: 0,0:27:08.54,0:27:09.50,Default-ja,,0,0,0,,Тіл де...
Dialogue: 0,0:27:08.66,0:27:09.65,Default,,0,0,0,,Оның тілі де
Dialogue: 0,0:27:11.46,0:27:12.88,Default-ja,,0,0,0,,Каска Бұл кілт!
Dialogue: 0,0:27:11.59,0:27:12.89,Default,,0,0,0,,Каска! Кілт!
Dialogue: 0,0:27:15.46,0:27:16.75,Default-ja,,0,0,0,,Каска!
Dialogue: 0,0:27:15.63,0:27:16.62,Default,,0,0,0,,Каска!
Dialogue: 0,0:27:24.80,0:27:26.26,Default-ja,,0,0,0,,Солай ма?
Dialogue: 0,0:27:24.87,0:27:25.86,Default,,0,0,0,,Артында қал!
Dialogue: 0,0:27:26.72,0:27:28.31,Default-ja,,0,0,0,,Келме!
Dialogue: 0,0:27:27.11,0:27:28.23,Default,,0,0,0,,Келме
Dialogue: 0,0:27:29.08,0:27:31.31,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:27:29.98,0:27:31.44,Default-ja,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:27:32.08,0:27:35.74,Default,,0,0,0,,Бұл Гриффит болуы мүмкін емес!
Dialogue: 0,0:27:32.10,0:27:35.82,Default-ja,,0,0,0,,Бұл мүмкін емес... Гриффит...
Dialogue: 0,0:28:21.19,0:28:22.32,Default-ja,,0,0,0,,Кяах!
Dialogue: 0,0:28:25.03,0:28:28.78,Default-ja,,0,0,0,,Ой, балалар енді қаша алмайсыңдар.
Dialogue: 0,0:28:25.07,0:28:28.93,Default,,0,0,0,,У-Енді қашып құтыла алмайсың
Dialogue: 0,0:28:29.04,0:28:33.08,Default-ja,,0,0,0,,Есікті құлыптағандықтан, хи хи хи!
Dialogue: 0,0:28:29.07,0:28:31.60,Default,,0,0,0,,Мен есікті құлыптап алдым
Dialogue: 0,0:28:38.09,0:28:39.17,Default-ja,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:28:38.14,0:28:39.13,Default,,0,0,0,,Сіз болдыңыз ба?
Dialogue: 0,0:28:40.21,0:28:42.42,Default-ja,,0,0,0,,Гриффитке не себеп болды?
Dialogue: 0,0:28:40.31,0:28:42.31,Default,,0,0,0,,Сен Гриффитке осылай істедің бе?!
Dialogue: 0,0:28:42.63,0:28:46.59,Default-ja,,0,0,0,,Эй, мен мұндай әдемі ештеңе таба алмадым.
Dialogue: 0,0:28:42.72,0:28:49.42,Default,,0,0,0,,Мен мұндай әдемі адамға ешқашан қол қойған емеспін
Dialogue: 0,0:28:46.72,0:28:49.39,Default-ja,,0,0,0,,Бұл менің Олаға бірінші рет келуім.
Dialogue: 0,0:28:49.56,0:28:54.52,Default-ja,,0,0,0,,Рики де азаптауға қосылды.
Dialogue: 0,0:28:49.69,0:28:51.85,Default,,0,0,0,,Бұл азаптау болды, бірақ оны қалай қоямын
Dialogue: 0,0:28:51.93,0:28:54.39,Default,,0,0,0,,Бұл маған осындай күш берді
Dialogue: 0,0:28:54.63,0:28:57.06,Default,,0,0,0,,Алдымен мен оның қолдары мен аяқтарының сіңірлерін кесіп алдым,
Dialogue: 0,0:28:54.64,0:28:58.73,Default-ja,,0,0,0,,Алдымен қашып кетпес үшін қолдарыңыз бен аяқтарыңыздың сіңірлерін кесіңіз.
Dialogue: 0,0:28:57.10,0:28:58.73,Default,,0,0,0,,қашып кетпес үшін
Dialogue: 0,0:28:58.86,0:29:04.57,Default-ja,,0,0,0,,Содан бастап тамақпен ұйықтаған кездерім болмаса, терімді, тырнақтарымды тазалайтынмын.
Dialogue: 0,0:28:58.90,0:29:01.49,Default,,0,0,0,,Содан кейін ол тамақ ішпей немесе ұйықтамаған кезде,
Dialogue: 0,0:29:01.53,0:29:04.66,Default,,0,0,0,,Мен оның терісін аршып, тырнағын жұлып алдым,
Dialogue: 0,0:29:04.70,0:29:08.57,Default,,0,0,0,,оған ыстық үтіктер қою, қайнаған су қою
Dialogue: 0,0:29:04.70,0:29:08.62,Default-ja,,0,0,0,,Гриль үтікті жағыңыз немесе қайнаған суға салып қойыңыз
Dialogue: 0,0:29:08.74,0:29:14.08,Default-ja,,0,0,0,,Тағы бір жыл бойы біз ерлі-зайыптылардың артынан жүрдік.
Dialogue: 0,0:29:08.78,0:29:14.27,Default,,0,0,0,,Неге, біз өткен жылы ерлі-зайыптылар сияқты ажырамас едік
Dialogue: 0,0:29:15.96,0:29:21.21,Default-ja,,0,0,0,,Оланың мақтаныш жинағы Оланың тұмарына қараңыз
Dialogue: 0,0:29:16.02,0:29:19.85,Default,,0,0,0,,Менің топтаманың ең жақсы бөлігін қараңыз!
Dialogue: 0,0:29:19.92,0:29:21.65,Default,,0,0,0,,Бұл менің бақытты сүйкімділігім
Dialogue: 0,0:29:21.75,0:29:26.84,Default-ja,,0,0,0,,Бұл сенің тілің, бұл поцелу... lelolelorero~
Dialogue: 0,0:29:21.79,0:29:24.12,Default,,0,0,0,,Бұл оның тілі
Dialogue: 0,0:29:33.77,0:29:35.31,Default-ja,,0,0,0,,Хаг...
Dialogue: 0,0:29:35.52,0:29:39.61,Default-ja,,0,0,0,,Өлейін деп тұрсың, бірақ екі жақты болсаң жәннатқа бара алмайсың.
Dialogue: 0,0:29:35.60,0:29:37.00,Default,,0,0,0,,Сен қазір өлесің
Dialogue: 0,0:29:37.24,0:29:39.67,Default,,0,0,0,,Қос тілмен жұмаққа бара алмайсың
Dialogue: 0,0:29:39.73,0:29:41.82,Default-ja,,0,0,0,,Иә, тоқта, лерореро...
Dialogue: 0,0:29:39.74,0:29:41.94,Default,,0,0,0,,S-Тоқта!
Dialogue: 0,0:29:44.94,0:29:49.95,Default-ja,,0,0,0,,Жоқ, сіздің тынысыңыз тым ауыр. Сен тозаққа барасың.
Dialogue: 0,0:29:44.98,0:29:48.38,Default,,0,0,0,,Ұмыт Тынысыңыз тым нашар иіседі
Dialogue: 0,0:29:48.72,0:29:49.94,Default,,0,0,0,,Сен тозаққа барасың
Dialogue: 0,0:29:50.78,0:29:53.58,Default-ja,,0,0,0,,Уау~
Dialogue: 0,0:29:53.95,0:29:56.46,Default-ja,,0,0,0,,Әбу... Тәшүке...
Dialogue: 0,0:29:55.12,0:29:56.95,Default,,0,0,0,,H-Hewup
Dialogue: 0,0:29:56.96,0:29:59.88,Default-ja,,0,0,0,,Мен сізді естімеймін, анық сөйлеңіз.
Dialogue: 0,0:29:56.99,0:29:59.89,Default,,0,0,0,,Сізді ести алмаймын Анық сөйлеңіз
Dialogue: 0,0:30:00.79,0:30:03.50,Default-ja,,0,0,0,,Гяаа!
Dialogue: 0,0:30:05.97,0:30:09.47,Default-ja,,0,0,0,,Қозғалмаңыз! Қару-жарақтарыңызды тастап, момындықпен беріле беріңіздер!
Dialogue: 0,0:30:06.07,0:30:07.06,Default,,0,0,0,,Қозғалмаңыз!
Dialogue: 0,0:30:07.23,0:30:09.29,Default,,0,0,0,,Now drop your weapons and surrender quietly!
Dialogue: 0,0:30:11.04,0:30:12.80,Default,,0,0,0,,Ішек, бәлкім, қазір шегінуіміз керек
Dialogue: 0,0:30:11.10,0:30:13.06,Default-ja,,0,0,0,,Ішек Бұл әзірше...
Dialogue: 0,0:30:19.85,0:30:21.14,Default,,0,0,0,,Оларды өлтіріңіз! Оларды өлтір!
Dialogue: 0,0:30:19.85,0:30:21.31,Default-ja,,0,0,0,,Кес, кес!
Dialogue: 0,0:30:39.04,0:30:40.96,Default-ja,,0,0,0,,Не істеп жатырсың! Ат!
Dialogue: 0,0:30:39.13,0:30:40.12,Default,,0,0,0,,Не істеп жатырсың?!
Dialogue: 0,0:30:40.17,0:30:41.57,Default,,0,0,0,,- Ат! - Иә, сэр!
Dialogue: 0,0:30:51.93,0:30:54.18,Default-ja,,0,0,0,,Кеттік, Ішекке кешікпе!
Dialogue: 0,0:30:51.98,0:30:53.88,Default,,0,0,0,,Ішектен артта қалма!
Dialogue: 0,0:30:55.51,0:30:59.98,Default-ja,,0,0,0,,Не?! ? Сол Гриффитті алып кетті!
Dialogue: 0,0:30:55.55,0:30:57.14,Default,,0,0,0,,Ш-Не?!
Dialogue: 0,0:30:57.55,0:30:59.68,Default,,0,0,0,,Гриффит алынды ма?!
Dialogue: 0,0:31:00.25,0:31:02.05,Default,,0,0,0,,Олардың қашып кетуіне жол бермеңіз!
Dialogue: 0,0:31:01.10,0:31:04.77,Default-ja,,0,0,0,,Маған қашып кетуге жол берме! Оның қашып кетуіне ешқашан жол бермеңіз!
Dialogue: 0,0:31:02.49,0:31:04.68,Default,,0,0,0,,Олардың қашып кетуіне батылдық жасама!
Dialogue: 0,0:31:07.15,0:31:08.69,Default-ja,,0,0,0,,Аз ғана жау бар!
Dialogue: 0,0:31:07.19,0:31:08.56,Default,,0,0,0,,Олардың санаулысы ғана!
Dialogue: 0,0:31:09.86,0:31:10.85,Default,,0,0,0,,Каска ханым!
Dialogue: 0,0:31:09.86,0:31:11.36,Default-ja,,0,0,0,,Каска-сама
Dialogue: 0,0:31:11.78,0:31:13.03,Default-ja,,0,0,0,,Мен – Соғысшылар корпусының капитаны Тео Магатпын.
Dialogue: 0,0:31:11.83,0:31:12.82,Default,,0,0,0,,Осы жолмен!
Dialogue: 0,0:31:21.67,0:31:22.46,Default-ja,,0,0,0,,Кешіріңіз
Dialogue: 0,0:31:21.74,0:31:22.73,Default,,0,0,0,,Рахмет
Dialogue: 0,0:31:22.58,0:31:26.96,Default-ja,,0,0,0,,Hehe, it's an honor to work for the heroes who saved the country.
Dialogue: 0,0:31:23.54,0:31:26.98,Default,,0,0,0,,I'm honored to be able to assist our kingdom's heroes
Dialogue: 0,0:31:42.27,0:31:43.65,Default-ja,,0,0,0,,Қақпаны жабыңыз!
Dialogue: 0,0:31:42.40,0:31:43.42,Default,,0,0,0,,Қақпаларды жабыңыз!
Dialogue: 0,0:31:44.56,0:31:46.86,Default-ja,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,0:31:44.96,0:31:46.69,Default,,0,0,0,,Асығыңыз! Асығыңыз!
Dialogue: 0,0:31:47.73,0:31:50.44,Default-ja,,0,0,0,,Біз көтерілісшілерге ешқашан жол бермейміз!
Dialogue: 0,0:31:47.83,0:31:50.43,Default,,0,0,0,,Көтерілісшілерді өткізбе! Түсінесіз бе?!
Dialogue: 0,0:31:53.31,0:31:56.14,Default,,0,0,0,,Жылқыларды көздеңіз! Ат!
Dialogue: 0,0:31:53.36,0:31:55.70,Default-ja,,0,0,0,,Атты көздеңіз! Ат!
Dialogue: 0,0:32:01.18,0:32:02.17,Default,,0,0,0,,Ақымақтар
Dialogue: 0,0:32:01.21,0:32:03.71,Default-ja,,0,0,0,,Ей, ақымақ... Асығып кірейін деп жатырсың ба? ?
Dialogue: 0,0:32:02.28,0:32:03.61,Default,,0,0,0,,Олар күштеп шығуды көздеп отыр ма?!
Dialogue: 0,0:32:07.79,0:32:09.76,Default,,0,0,0,,Не істеп жатырсыңдар, ақымақтар?!
Dialogue: 0,0:32:07.80,0:32:09.63,Default-ja,,0,0,0,,Не істеп жатырсың! ? Ақымақ!
Dialogue: 0,0:32:13.63,0:32:14.89,Default-ja,,0,0,0,,Асығыңыз, асығыңыз
Dialogue: 0,0:32:13.66,0:32:14.68,Default,,0,0,0,,Асығыңыз! Асығыңыз!
Dialogue: 0,0:32:31.36,0:32:32.07,Default-ja,,0,0,0,,Дегенмен, Дио осы қалада бір жерде болуы тиіс
Dialogue: 0,0:32:33.78,0:32:35.11,Default-ja,,0,0,0,,Гриффит мырза
Dialogue: 0,0:32:33.81,0:32:34.97,Default,,0,0,0,,Лорд Гриффит
Dialogue: 0,0:32:36.41,0:32:38.99,Default-ja,,0,0,0,,Біз тағы кездесеміз...
Dialogue: 0,0:32:36.42,0:32:38.78,Default,,0,0,0,,Біз тағы кездесеміз деп үміттенемін
Dialogue: 0,0:32:40.12,0:32:42.58,Default-ja,,0,0,0,,Сәлем, ханшайым?
Dialogue: 0,0:32:40.15,0:32:41.31,Default,,0,0,0,,Міне, ханшайым
Dialogue: 0,0:32:52.72,0:32:54.13,Default-ja,,0,0,0,,Тұрақты әскер.
Dialogue: 0,0:32:52.73,0:32:53.72,Default,,0,0,0,,Бұл тұрақты армия
Dialogue: 0,0:32:54.60,0:32:55.59,Default,,0,0,0,,Елуге жуық
Dialogue: 0,0:32:54.63,0:32:57.76,Default-ja,,0,0,0,,There are roughly 50... no, 100 horses!
Dialogue: 0,0:32:55.70,0:32:57.53,Default,,0,0,0,,Жоқ, жүз!
Dialogue: 0,0:33:03.14,0:33:04.23,Default-ja,,0,0,0,,Осылай болмас еді...
Dialogue: 0,0:33:03.24,0:33:04.30,Default,,0,0,0,,Біртүрлі
Dialogue: 0,0:33:04.85,0:33:06.52,Default-ja,,0,0,0,,Ол жақындамайды...
Dialogue: 0,0:33:04.91,0:33:06.38,Default,,0,0,0,,Олар неге жақындамайды?
Dialogue: 0,0:33:11.88,0:33:12.91,Default,,0,0,0,,Бұл тұтқын
Dialogue: 0,0:33:11.90,0:33:13.07,Default-ja,,0,0,0,,Тұтқындау
Dialogue: 0,0:33:18.78,0:33:19.70,Default-ja,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:33:20.59,0:33:22.56,Default,,0,0,0,,Әпке, біздің де артымызда!
Dialogue: 0,0:33:20.66,0:33:22.50,Default-ja,,0,0,0,,Sister, the back is dangerous too!
Dialogue: 0,0:33:22.62,0:33:24.46,Default-ja,,0,0,0,,Балалар сендер алға шықыңдар.
Dialogue: 0,0:33:22.63,0:33:23.93,Default,,0,0,0,,You guys, take the front
Dialogue: 0,0:33:24.83,0:33:27.67,Default-ja,,0,0,0,,Гутс Пиппин, менің арқамды сұра.
Dialogue: 0,0:33:24.86,0:33:27.39,Default,,0,0,0,,Guts, Pippin Cover the rear!
Dialogue: 0,0:33:36.13,0:33:38.64,Default-ja,,0,0,0,,Ол ұлы мәртебелі алдына бас иген қылмыскер. Оның қашып кетуіне жол бермеңіз!
Dialogue: 0,0:33:36.21,0:33:37.87,Default,,0,0,0,,Олар жебелерін патшаға дәл тигізуге батылы бар қатыгез қылмыскерлер
Dialogue: 0,0:33:37.91,0:33:39.00,Default,,0,0,0,,Do not let them escape!
Dialogue: 0,0:34:05.58,0:34:08.71,Default-ja,,0,0,0,,The horse has been damaged. Бұл ұзаққа созылмайды!
Dialogue: 0,0:34:05.61,0:34:06.77,Default,,0,0,0,,Атқа тиді!
Dialogue: 0,0:34:07.27,0:34:08.64,Default,,0,0,0,,It won't hold up much longer!
Dialogue: 0,0:34:12.71,0:34:14.05,Default-ja,,0,0,0,,Соңы жоқ!
Dialogue: 0,0:34:12.95,0:34:13.94,Default,,0,0,0,,Damn, there's no end to this!
Dialogue: 0,0:34:14.71,0:34:16.88,Default-ja,,0,0,0,,Шүкір, бәрі...
Dialogue: 0,0:34:14.75,0:34:16.58,Default,,0,0,0,,Бұл ма?
Dialogue: 0,0:34:24.27,0:34:25.31,Default-ja,,0,0,0,,Did you make it in time?
Dialogue: 0,0:34:24.29,0:34:25.49,Default,,0,0,0,,He made it in time!
Dialogue: 0,0:34:26.86,0:34:27.95,Default,,0,0,0,,Коркус!
Dialogue: 0,0:34:26.93,0:34:28.27,Default-ja,,0,0,0,,Коркас!
Dialogue: 0,0:34:29.81,0:34:32.61,Default-ja,,0,0,0,,Hehe... I wanted to try it once.
Dialogue: 0,0:34:30.66,0:34:32.46,Default,,0,0,0,,I've always wanted to do this
Dialogue: 0,0:34:33.23,0:34:35.07,Default-ja,,0,0,0,,Alright, bastards!
Dialogue: 0,0:34:33.27,0:34:35.39,Default,,0,0,0,,Жарайсыңдар, ерлер!
Dialogue: 0,0:34:35.60,0:34:38.30,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:34:35.61,0:34:38.61,Default-ja,,0,0,0,,Бүкіл әскер аттанды...
Dialogue: 0,0:34:40.54,0:34:41.80,Default,,0,0,0,,H-Эй, ұмыт
Dialogue: 0,0:34:40.61,0:34:42.28,Default-ja,,0,0,0,,Дәл қазір ештеңе жоқ Эй
Dialogue: 0,0:34:58.30,0:35:00.43,Default-ja,,0,0,0,,Сәлем!
Dialogue: 0,0:34:58.42,0:35:00.45,Default,,0,0,0,,- Сәлем! - Сәлем!
Dialogue: 0,0:35:02.93,0:35:05.93,Default-ja,,0,0,0,,Гриффит қайтып келгенше, ол менікі.
Dialogue: 0,0:35:02.96,0:35:05.90,Default,,0,0,0,,As long as Griffith is back, victory is ours
Dialogue: 0,0:35:06.06,0:35:08.31,Default-ja,,0,0,0,,«Сұңқар тобы» толығымен қайта жанданды.
Dialogue: 0,0:35:06.13,0:35:08.36,Default,,0,0,0,,«Сұңқар тобы» толығымен қайта жанданды
Dialogue: 0,0:35:08.43,0:35:12.30,Default,,0,0,0,,Иә, біз жеңеміз, жеңеміз және жеңісті жалғастырамыз!
Dialogue: 0,0:35:08.43,0:35:12.48,Default-ja,,0,0,0,,Кел, тағы да жеңеміз, тағы да жеңеміз, тағы да жеңеміз.
Dialogue: 0,0:35:12.54,0:35:14.84,Default,,0,0,0,,Біз Чудермен комиссия алуымыз керек
Dialogue: 0,0:35:12.61,0:35:14.94,Default-ja,,0,0,0,,Осы жолы Тюдорды тағайындағыңыз келе ме?
Dialogue: 0,0:35:15.07,0:35:18.24,Default-ja,,0,0,0,,Let's give those guys in Midland a break.
Dialogue: 0,0:35:15.17,0:35:18.17,Default,,0,0,0,,Бұл Мидлендтің бейбақтарын таң қалдырады
Dialogue: 0,0:35:18.53,0:35:21.57,Default-ja,,0,0,0,,Бұл жақсы хахаха...
Dialogue: 0,0:35:18.58,0:35:19.84,Default,,0,0,0,,Бұл тамаша идея
Dialogue: 0,0:35:22.53,0:35:25.58,Default-ja,,0,0,0,,Sorry, I'll have a replacement ready right away.
Dialogue: 0,0:35:22.55,0:35:25.45,Default,,0,0,0,,Sorry I'll get someone to relieve you right away
Dialogue: 0,0:35:25.70,0:35:28.29,Default-ja,,0,0,0,,Жоқ, капитан, демалыңыз.
Dialogue: 0,0:35:25.75,0:35:28.12,Default,,0,0,0,,Бәрі жақсы, демалыңыз, командир
Dialogue: 0,0:35:28.79,0:35:31.00,Default-ja,,0,0,0,,Үнемі тынбай еңбектенбейсің бе?
Dialogue: 0,0:35:29.02,0:35:30.85,Default,,0,0,0,,Сіз мүлдем үзіліс алған жоқсыз
Dialogue: 0,0:35:31.12,0:35:33.38,Default-ja,,0,0,0,,Мен сендерді уайымдағандарыңды қаламаймын.
Dialogue: 0,0:35:31.22,0:35:33.42,Default,,0,0,0,,Балалар мен үшін алаңдағандарыңды қаламаймын
Dialogue: 0,0:35:44.22,0:35:46.39,Default-ja,,0,0,0,,Сіз қалай ойлайсыз? Гриффит
Dialogue: 0,0:35:44.34,0:35:46.20,Default,,0,0,0,,Гриффиттің жағдайы қалай?
Dialogue: 0,0:35:46.97,0:35:50.85,Default-ja,,0,0,0,,Мен дәрігер емеспін, сондықтан егжей-тегжейлі білмеймін...
Dialogue: 0,0:35:47.01,0:35:50.47,Default,,0,0,0,,Мен дәрігер емеспін, сондықтан шынымен істей алмаймын
Dialogue: 0,0:35:51.64,0:35:52.69,Default-ja,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:35:51.68,0:35:52.67,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:35:57.82,0:35:58.53,Default-ja,,0,0,0,,Гриффит
Dialogue: 0,0:35:57.88,0:35:58.87,Default,,0,0,0,,Гриффит
Dialogue: 0,0:36:00.82,0:36:02.57,Default-ja,,0,0,0,,Ыстық емес пе?
Dialogue: 0,0:36:00.92,0:36:02.39,Default,,0,0,0,,Бұл өте ыстық емес пе?
Dialogue: 0,0:36:04.87,0:36:08.08,Default-ja,,0,0,0,,It doesn't matter if you take it, there's only two of us.
Dialogue: 0,0:36:04.96,0:36:08.09,Default,,0,0,0,,You can take it off It's just the two of us
Dialogue: 0,0:36:17.67,0:36:18.92,Default-ja,,0,0,0,,Оны кигіңіз келе ме?
Dialogue: 0,0:36:17.70,0:36:18.69,Default,,0,0,0,,Сіз мұны қалайсыз ба?
Dialogue: 0,0:36:20.59,0:36:23.63,Default-ja,,0,0,0,,Хахаха... Саған ұқсайды.
Dialogue: 0,0:36:22.54,0:36:23.57,Default,,0,0,0,,Дәл сіз сияқты
Dialogue: 0,0:36:25.51,0:36:29.93,Default-ja,,0,0,0,,It hasn't changed. Even after a year, this place is still a battlefield.
Dialogue: 0,0:36:25.68,0:36:27.37,Default,,0,0,0,,You haven't changed A year's passed
Dialogue: 0,0:36:28.15,0:36:29.67,Default,,0,0,0,,Менің ойымша, бұл әлі де соғыс аймағы
Dialogue: 0,0:36:30.64,0:36:33.10,Default-ja,,0,0,0,,You can't start unless you put on the armor.
Dialogue: 0,0:36:30.65,0:36:32.74,Default,,0,0,0,,Сізде сауыт болуы керек, солай ма?
Dialogue: 0,0:36:36.02,0:36:40.44,Default-ja,,0,0,0,,Also, my hands and feet were taken away, including their tendons.
Dialogue: 0,0:36:36.09,0:36:39.82,Default,,0,0,0,,Және олар оның қолдары мен аяқтарының сіңірлерін кесіп тастады
Dialogue: 0,0:36:41.07,0:36:45.66,Default-ja,,0,0,0,,Мен енді тұрып, қылышымды ұстай алмаймын...
Dialogue: 0,0:36:41.13,0:36:45.43,Default,,0,0,0,,Тұра алмайды, қылыш сермейді
Dialogue: 0,0:36:54.41,0:36:55.40,Default,,0,0,0,,Мен көремін
Dialogue: 0,0:36:54.42,0:36:55.42,Default-ja,,0,0,0,,Иә
Dialogue: 0,0:37:12.93,0:37:14.56,Default-ja,,0,0,0,,Яһудеядан естілді
Dialogue: 0,0:37:13.03,0:37:14.46,Default,,0,0,0,,Маған Яһудо айтты
Dialogue: 0,0:37:14.66,0:37:15.65,Default,,0,0,0,,Мен көремін
Dialogue: 0,0:37:14.69,0:37:15.89,Default-ja,,0,0,0,,Мен көремін.
Dialogue: 0,0:37:19.77,0:37:21.23,Default,,0,0,0,,Тоқта, ақымақ!
Dialogue: 0,0:37:36.79,0:37:40.42,Default-ja,,0,0,0,,Эй, сен қалжыңдап тұрсың ба? Сол Гриффит...
Dialogue: 0,0:37:36.82,0:37:38.75,Default,,0,0,0,,Н-Әй, әзіл ғой, солай ма?
Dialogue: 0,0:37:39.05,0:37:40.42,Default,,0,0,0,,Гриффит туралы?
Dialogue: 0,0:37:41.67,0:37:44.30,Default-ja,,0,0,0,,Мен сонда болдым. Адамнан тікелей сұраңыз.
Dialogue: 0,0:37:41.72,0:37:44.42,Default,,0,0,0,,Жарайды, мен одан өзім сұрайын
Dialogue: 0,0:37:44.42,0:37:45.84,Default-ja,,0,0,0,,Бұл мүмкін емес, иә?
Dialogue: 0,0:37:44.49,0:37:45.48,Default,,0,0,0,,Оның пайдасы жоқ
Dialogue: 0,0:37:47.39,0:37:49.56,Default,,0,0,0,,Гриффит енді сөйлей алмайды
Dialogue: 0,0:37:47.43,0:37:49.64,Default-ja,,0,0,0,,Гриффит енді сөйлей алмайды.
Dialogue: 0,0:37:54.18,0:37:56.27,Default-ja,,0,0,0,,Гриффит... не?
Dialogue: 0,0:37:56.39,0:37:58.81,Default-ja,,0,0,0,,Сіз нені айтасыз? Бұл рас па?
Dialogue: 0,0:38:00.31,0:38:04.19,Default-ja,,0,0,0,,Ах...! Бұл не?
Dialogue: 0,0:38:02.17,0:38:04.04,Default,,0,0,0,,Не деген сұмдық?!
Dialogue: 0,0:38:05.24,0:38:08.31,Default,,0,0,0,,Біз бәрін басынан бастамайтынбыз ба?
Dialogue: 0,0:38:05.24,0:38:08.49,Default-ja,,0,0,0,,Болғалы тұрған жоқ па?
Dialogue: 0,0:38:09.32,0:38:13.41,Default-ja,,0,0,0,,Мұның бәрі Гриффит қайтып келгенде болған оқиға емес пе?
Dialogue: 0,0:38:09.38,0:38:13.34,Default,,0,0,0,,Енді Гриффит қайтып келді?
Dialogue: 0,0:38:14.12,0:38:17.29,Default-ja,,0,0,0,,Мен неге екенін түсінбей тұрып, мені күнәкар етіп жаратты...
Dialogue: 0,0:38:14.15,0:38:17.02,Default,,0,0,0,,Олар бізді еш себепсіз қылмыскер деп атады
Dialogue: 0,0:38:17.58,0:38:24.38,Default-ja,,0,0,0,,Бір жыл бойы мен жәндіктерден қаштым, көптеген достарым қырылды.
Dialogue: 0,0:38:17.69,0:38:21.02,Default,,0,0,0,,Ал бір жыл бойы біз қашып жүрміз
Dialogue: 0,0:38:21.76,0:38:25.56,Default,,0,0,0,,Қаншама жолдасымыздан айырылдық, сонда да
Dialogue: 0,0:38:24.51,0:38:28.68,Default-ja,,0,0,0,,Сонда да мен Гриффиттің қайтып оралғанын қалаймын...
Dialogue: 0,0:38:26.33,0:38:30.43,Default,,0,0,0,,We kept our hopes up that when Griffith returned
Dialogue: 0,0:38:28.80,0:38:32.64,Default-ja,,0,0,0,,Мен сендім, бірақ... міне, солай!
Dialogue: 0,0:38:30.94,0:38:32.06,Default,,0,0,0,,Ал енді мынау?!
Dialogue: 0,0:38:46.32,0:38:47.65,Default,,0,0,0,,Біз не істейміз?
Dialogue: 0,0:38:46.32,0:38:47.86,Default-ja,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:38:47.99,0:38:49.39,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:38:47.99,0:38:49.91,Default-ja,,0,0,0,,Бұдан былай біз...
Dialogue: 0,0:38:52.37,0:38:54.03,Default-ja,,0,0,0,,Сіз бұл туралы бірдеңе істей алмайсыз ба?
Dialogue: 0,0:38:52.56,0:38:54.08,Default,,0,0,0,,Біздің қолымыздан келетін ештеңе жоқ па?
Dialogue: 0,0:38:54.16,0:38:55.66,Default-ja,,0,0,0,,Капитан Каска!
Dialogue: 0,0:38:54.23,0:38:55.35,Default,,0,0,0,,Командир Каска
Dialogue: 0,0:38:56.45,0:38:58.96,Default-ja,,0,0,0,,Бұл «Сұңқарлар тобы» жойылған сияқты емес.
Dialogue: 0,0:38:56.56,0:38:58.62,Default,,0,0,0,,Сұңқар тобы әлі өлген жоқ
Dialogue: 0,0:38:59.08,0:39:00.83,Default-ja,,0,0,0,,Дәл солай, капитан Каска...
Dialogue: 0,0:38:59.13,0:39:00.90,Default,,0,0,0,,Егер командир Каска жалғастырса
Dialogue: 0,0:39:03.37,0:39:04.60,Default,,0,0,0,,Маған біраз уақыт беріңіз
Dialogue: 0,0:39:03.42,0:39:05.21,Default-ja,,0,0,0,,Маған біраз уақыт бере аласыз ба?
Dialogue: 0,0:39:05.34,0:39:08.97,Default-ja,,0,0,0,,Келесі қуғыншы келгенше әлі уақыт болуы керек.
Dialogue: 0,0:39:05.50,0:39:08.63,Default,,0,0,0,,Жаудың келесі шабуылына дейін біраз уақыт болуы керек
Dialogue: 0,0:39:09.63,0:39:11.93,Default-ja,,0,0,0,,Оған дейін ойланып көрейін.
Dialogue: 0,0:39:09.71,0:39:11.47,Default,,0,0,0,,Оған дейін ойланып көрейін
Dialogue: 0,0:39:18.81,0:39:23.73,Default-ja,,0,0,0,,Ей, күте тұр, сен бұл туралы ойлағанда не істейсің?
Dialogue: 0,0:39:18.88,0:39:19.91,Default,,0,0,0,,Эй, күте тұрыңыз
Dialogue: 0,0:39:21.32,0:39:23.55,Default,,0,0,0,,Сізге не туралы ойлану керек?
Dialogue: 0,0:39:24.12,0:39:27.29,Default,,0,0,0,,Сіз барлығына дәл қазір не айтқыңыз келді?
Dialogue: 0,0:39:24.19,0:39:27.32,Default-ja,,0,0,0,,Сіз дәл қазір бәріне не айтқыңыз келді?
Dialogue: 0,0:39:27.46,0:39:28.86,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:39:28.65,0:39:32.20,Default-ja,,0,0,0,,Маған өзім шайқасқан шайқастар туралы шешім қабылдауымды айтты...
Dialogue: 0,0:39:28.89,0:39:32.06,Default,,0,0,0,,Сіз бастаған шайқастарды аяқтау керек
Dialogue: 0,0:39:32.78,0:39:34.87,Default-ja,,0,0,0,,Сен мықтысың.
Dialogue: 0,0:39:32.83,0:39:34.27,Default,,0,0,0,,Сіз өте күштісіз
Dialogue: 0,0:39:35.63,0:39:38.13,Default,,0,0,0,,Өйткені адам күресуді таңдайды
Dialogue: 0,0:39:35.66,0:39:39.87,Default-ja,,0,0,0,,Бұл сіз өзіңіз күрескен шайқас, сондықтан сіз өзіңізді тоқтата алмайтын нәрселер бар.
Dialogue: 0,0:39:38.17,0:39:39.80,Default,,0,0,0,,кері шегінуге болмайды
Dialogue: 0,0:39:40.54,0:39:44.71,Default-ja,,0,0,0,,Осы сөздерді қазіргі Гриффитке айта аласыз ба?
Dialogue: 0,0:39:40.64,0:39:44.63,Default,,0,0,0,,Сол сөздерді Гриффитке айта аласыз ба?
Dialogue: 0,0:39:47.34,0:39:51.84,Default-ja,,0,0,0,,Біз бәріміз әлсізбіз. Біз әлсіз болғандықтан, біз адамдарға және армандарға жабысамыз.
Dialogue: 0,0:39:47.38,0:39:48.61,Default,,0,0,0,,Біз бәріміз әлсізбіз
Dialogue: 0,0:39:49.48,0:39:51.51,Default,,0,0,0,,Сондықтан біз адамдарға, армандарға сүйенеміз
Dialogue: 0,0:39:52.68,0:39:55.10,Default-ja,,0,0,0,,Қолында ұстайтын нәрсесін жоғалтқандар үшін...
Dialogue: 0,0:39:52.79,0:39:56.95,Default,,0,0,0,,Ал сенімін жоғалтқан адам үшін біз бірдеңе істей аламыз ба?
Dialogue: 0,0:39:55.22,0:39:57.10,Default-ja,,0,0,0,,Қызық, мен саған бірдеңе істей аламын ба?
Dialogue: 0,0:39:57.68,0:40:03.35,Default-ja,,0,0,0,,Жылы сөздер? Ауыр сөздер? Сіз үшін сонда болу үшін бе?
Dialogue: 0,0:39:57.76,0:40:00.59,Default,,0,0,0,,Біз мейірімді болуымыз керек пе? Әлде қатаң ба?
Dialogue: 0,0:40:01.66,0:40:03.39,Default,,0,0,0,,Біз олардың қасында қалуымыз керек пе?
Dialogue: 0,0:40:04.40,0:40:08.40,Default-ja,,0,0,0,,Мен де... Жанымда біреу болғанын қаладым.
Dialogue: 0,0:40:04.43,0:40:08.06,Default,,0,0,0,,Тіпті біреудің қасымда болғанын қаладым
Dialogue: 0,0:40:09.57,0:40:10.80,Default,,0,0,0,,Мен не істеймін?
Dialogue: 0,0:40:09.57,0:40:14.07,Default-ja,,0,0,0,,Мен не істеуім керек? Мен не істеуім керек...
Dialogue: 0,0:40:11.67,0:40:13.64,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:40:15.16,0:40:17.58,Default-ja,,0,0,0,,Мен тіпті білмеймін
Dialogue: 0,0:40:15.21,0:40:17.27,Default,,0,0,0,,Мен де білмеймін
Dialogue: 0,0:40:23.82,0:40:25.68,Default,,0,0,0,,Мен Гриффитке барамын
Dialogue: 0,0:40:23.92,0:40:26.13,Default-ja,,0,0,0,,Гриффитке барыңыз
Dialogue: 0,0:40:33.80,0:40:37.18,Default-ja,,0,0,0,,Гриффит, таңғышты ауыстыр.
Dialogue: 0,0:40:33.93,0:40:36.83,Default,,0,0,0,,Гриффит Мен таңғыштарыңды ауыстырайын деп жатырмын
Dialogue: 0,0:40:39.53,0:40:42.43,Default,,0,0,0,,Сонымен, енді не істейсің?
Dialogue: 0,0:40:39.56,0:40:42.89,Default-ja,,0,0,0,,Енді не істейсің?
Dialogue: 0,0:40:43.02,0:40:44.81,Default-ja,,0,0,0,,Сіз тағы да саяхатқа шығасыз ба?
Dialogue: 0,0:40:43.10,0:40:44.83,Default,,0,0,0,,Саяхатқа қайта шығасыз ба?
Dialogue: 0,0:40:48.61,0:40:49.60,Default,,0,0,0,,Сен ше, Яһуде?
Dialogue: 0,0:40:48.61,0:40:49.61,Default-ja,,0,0,0,,Яһудея туралы не деуге болады?
Dialogue: 0,0:40:51.86,0:40:53.11,Default-ja,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:40:51.88,0:40:52.87,Default,,0,0,0,,Ал, көрейік
Dialogue: 0,0:40:53.61,0:40:55.41,Default,,0,0,0,,Мүмкін қалған жігіттерді жұмысқа алатын шығармын
Dialogue: 0,0:40:53.61,0:40:57.62,Default-ja,,0,0,0,,Артта қалған адамдарды шақырсам, ұрылардың да қолынан келеді.
Dialogue: 0,0:40:55.45,0:40:57.38,Default,,0,0,0,,және ұрылар тобын құрыңыз
Dialogue: 0,0:40:57.78,0:41:00.91,Default-ja,,0,0,0,,Осылайша сіз Гриффитке жалғыз қамқорлық жасай аласыз.
Dialogue: 0,0:40:57.85,0:41:00.82,Default,,0,0,0,,Сонда біз Гриффитке қамқорлық жасай аламыз
Dialogue: 0,0:41:01.04,0:41:02.29,Default-ja,,0,0,0,,Сосын мен де
Dialogue: 0,0:41:01.09,0:41:02.08,Default,,0,0,0,,Онда мен сізге қосыламын
Dialogue: 0,0:41:02.62,0:41:07.83,Default-ja,,0,0,0,,Сен енді ересек адам шығарсың. Жақсырақ, бұл жолы Касканы өзіңізбен бірге алыңыз.
Dialogue: 0,0:41:02.69,0:41:04.71,Default,,0,0,0,,Сіз бізден кетіп қалдыңыз
Dialogue: 0,0:41:05.26,0:41:07.82,Default,,0,0,0,,Бірақ бұл жолы Касканы өзіңізбен бірге алыңыз
Dialogue: 0,0:41:08.03,0:41:09.02,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:41:09.29,0:41:12.88,Default-ja,,0,0,0,,Ол... Бұл жолы оны өзіммен бірге алып кетуім керек.
Dialogue: 0,0:41:09.36,0:41:13.16,Default,,0,0,0,,Сіз оны осы жолы апаруыңыз керек Әйтпесе
Dialogue: 0,0:41:14.51,0:41:15.80,Default-ja,,0,0,0,,Ол жігіт...
Dialogue: 0,0:41:14.73,0:41:15.72,Default,,0,0,0,,Ол болады
Dialogue: 0,0:41:17.64,0:41:18.63,Default,,0,0,0,,Сіз
Dialogue: 0,0:41:17.64,0:41:18.76,Default-ja,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:41:19.07,0:41:20.06,Default,,0,0,0,,Капитан
Dialogue: 0,0:41:19.10,0:41:21.56,Default-ja,,0,0,0,,Капитан капитан
Dialogue: 0,0:41:20.54,0:41:23.30,Default,,0,0,0,,- капитан - капитан
Dialogue: 0,0:41:23.34,0:41:26.37,Default,,0,0,0,,Өткендегідей тағы да сөзсіз жоғалып кетесің бе?
Dialogue: 0,0:41:23.35,0:41:26.69,Default-ja,,0,0,0,,Өткен жолғыдай қайта қыдыруды жоспарлап отырсыз ба?
Dialogue: 0,0:41:27.48,0:41:30.15,Default-ja,,0,0,0,,Егер бұл орын алса, маған қосылуға рұқсат етіңіз.
Dialogue: 0,0:41:27.71,0:41:30.27,Default,,0,0,0,,Егер сіз болсаңыз, бізді өзіңізбен бірге алып кетіңіз
Dialogue: 0,0:41:30.77,0:41:33.03,Default-ja,,0,0,0,,Кесілген топ Барлығымыз бірге шештік.
Dialogue: 0,0:41:30.78,0:41:32.88,Default,,0,0,0,,Біз рейдер ретінде бірге шештік
Dialogue: 0,0:41:33.15,0:41:34.99,Default-ja,,0,0,0,,О, сіз мұны әлі де жасай аласыз.
Dialogue: 0,0:41:33.22,0:41:35.02,Default,,0,0,0,,Бізде әлі көп нәрсе қалды
Dialogue: 0,0:41:35.32,0:41:36.82,Default-ja,,0,0,0,,Жалдамалы, бәрібір.
Dialogue: 0,0:41:35.45,0:41:36.95,Default,,0,0,0,,Жалдамалылар ретінде немесе бәрібір
Dialogue: 0,0:41:36.95,0:41:38.45,Default-ja,,0,0,0,,Тек капитан болса
Dialogue: 0,0:41:36.99,0:41:38.46,Default,,0,0,0,,Сіз бізде болғанша, капитан
Dialogue: 0,0:41:38.89,0:41:39.98,Default,,0,0,0,,- Капитан - Әй, балалар
Dialogue: 0,0:41:38.91,0:41:41.24,Default-ja,,0,0,0,,Капитан өтінемін, капитан!
Dialogue: 0,0:41:40.03,0:41:42.05,Default,,0,0,0,,- Өтінемін, капитан! - Капитан
Dialogue: 0,0:41:41.37,0:41:42.33,Default-ja,,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:41:43.04,0:41:45.83,Default-ja,,0,0,0,,Біз бәріміз де өз отбасымызды жақсы күтеміз емеспіз бе?
Dialogue: 0,0:41:43.16,0:41:45.76,Default,,0,0,0,,Біз бәріміз бір отбасы сияқтымыз, солай ма?
Dialogue: 0,0:41:45.93,0:41:47.59,Default,,0,0,0,,Қайда барсақ та, бізді іздеуде жүрген қылмыскерлер болса,
Dialogue: 0,0:41:45.96,0:41:48.58,Default-ja,,0,0,0,,Мен қайда барсам да, егер сені қаласаң, мен сенімен бірге барғым келеді.
Dialogue: 0,0:41:47.63,0:41:48.62,Default,,0,0,0,,Бірге болайық!
Dialogue: 0,0:41:48.71,0:41:51.80,Default-ja,,0,0,0,,Тек капитан болса, жақсы болар едік.
Dialogue: 0,0:41:48.77,0:41:51.79,Default,,0,0,0,,Сіз бізбен бірге болсаңыз, біз басқара аламыз!
Dialogue: 0,0:41:53.01,0:41:54.88,Default-ja,,0,0,0,,Сәлем, капитан! Өтінемін!
Dialogue: 0,0:41:53.14,0:41:55.11,Default,,0,0,0,,Дұрыс па, капитан? Өтінемін!
Dialogue: 0,0:41:55.01,0:41:55.67,Default-ja,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:41:55.14,0:41:56.90,Default,,0,0,0,,- капитан - капитан
Dialogue: 0,0:41:55.80,0:41:56.88,Default-ja,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:41:57.01,0:41:58.01,Default-ja,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:41:57.11,0:42:01.88,Default,,0,0,0,,- капитан - капитан
Dialogue: 0,0:41:59.85,0:42:02.85,Default-ja,,0,0,0,,Өтінемін, капитан.
Dialogue: 0,0:42:01.91,0:42:07.22,Default,,0,0,0,,- Өтінемін, капитан! - Капитан
Dialogue: 0,0:42:20.20,0:42:22.23,Default,,0,0,0,,Рикерт алда барлауда және
Dialogue: 0,0:42:20.20,0:42:24.66,Default-ja,,0,0,0,,Рикерт шекарадан өтудің жолын іздеп, жетекшілік етеді.
Dialogue: 0,0:42:22.27,0:42:24.33,Default,,0,0,0,,бізді шекарадан өткізетін жолдарды іздеу
Dialogue: 0,0:42:25.58,0:42:28.17,Default-ja,,0,0,0,,Мен сіздің Калония тауларында танитын адамыңыз бар екенін естідім...
Dialogue: 0,0:42:25.64,0:42:27.97,Default,,0,0,0,,Ол Карония тауларындағы кейбір адамдарды біледі
Dialogue: 0,0:42:53.83,0:42:58.13,Default,,0,0,0,,Бұл қандай таңқаларлық
Dialogue: 0,0:42:53.86,0:42:54.86,Default-ja,,0,0,0,,О?
Dialogue: 0,0:42:55.73,0:42:58.28,Default-ja,,0,0,0,,Бұл біртүрлі...
Dialogue: 0,0:42:59.82,0:43:03.37,Default-ja,,0,0,0,,Мен әлдеқайда жақсы болдым деп ойладым, бірақ...
Dialogue: 0,0:42:59.84,0:43:03.21,Default,,0,0,0,,Мен мұны білдім деп ойладым
Dialogue: 0,0:43:05.79,0:43:08.00,Default-ja,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:43:05.84,0:43:07.84,Default,,0,0,0,,Мен сондай үмітсізмін
Dialogue: 0,0:43:08.75,0:43:09.81,Default,,0,0,0,,О
Dialogue: 0,0:43:11.45,0:43:12.68,Default,,0,0,0,,S-Кешіріңіз
Dialogue: 0,0:43:11.67,0:43:15.17,Default-ja,,0,0,0,,Кешіріңіз, оның орнына мен сізге көрпе әкелемін...
Dialogue: 0,0:43:13.35,0:43:14.82,Default,,0,0,0,,Мен тағы бір көрпе аламын
Dialogue: 0,0:43:15.09,0:43:16.08,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:43:16.36,0:43:17.95,Default,,0,0,0,,Не? Гриффит?!
Dialogue: 0,0:43:16.38,0:43:19.34,Default-ja,,0,0,0,,Не! ? Гриффит Гриффит...
Dialogue: 0,0:43:18.49,0:43:19.48,Default,,0,0,0,,Гриф
Dialogue: 0,0:43:25.47,0:43:28.48,Default-ja,,0,0,0,,Гриффит... Тоқта!
Dialogue: 0,0:43:25.56,0:43:26.55,Default,,0,0,0,,Гриффит
Dialogue: 0,0:43:27.80,0:43:28.82,Default,,0,0,0,,Юкине-кун
Dialogue: 0,0:44:17.82,0:44:18.82,Default-ja,,0,0,0,,Каска
Dialogue: 0,0:44:17.88,0:44:18.87,Default,,0,0,0,,Каска?
Dialogue: 0,0:44:21.82,0:44:22.82,Default-ja,,0,0,0,,Ішек...
Dialogue: 0,0:44:21.85,0:44:22.84,Default,,0,0,0,,Ішек
Dialogue: 0,0:44:26.66,0:44:27.62,Default-ja,,0,0,0,,Гриффит ше?
Dialogue: 0,0:44:26.73,0:44:27.72,Default,,0,0,0,,Гриффит қалай?
Dialogue: 0,0:44:27.83,0:44:30.41,Default-ja,,0,0,0,,Иә... Жаңа ғана ұйықтап қалдым.
Dialogue: 0,0:44:27.89,0:44:30.19,Default,,0,0,0,,Иә, ол жаңа ғана ұйықтап қалды
Dialogue: 0,0:44:32.12,0:44:33.33,Default-ja,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:44:32.23,0:44:33.22,Default,,0,0,0,,Не болды?
Dialogue: 0,0:44:33.83,0:44:35.49,Default,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:44:33.83,0:44:35.54,Default-ja,,0,0,0,,Не... не?
Dialogue: 0,0:44:35.75,0:44:37.88,Default-ja,,0,0,0,,Эй, не болды? Не болды?
Dialogue: 0,0:44:36.10,0:44:37.93,Default,,0,0,0,,Эй, бұл не? Не болды?
Dialogue: 0,0:44:40.01,0:44:42.88,Default-ja,,0,0,0,,Жоқ, бұл бәрібір...
Dialogue: 0,0:44:40.07,0:44:41.06,Default,,0,0,0,,Бұл сіз ойлағандай емес
Dialogue: 0,0:44:41.81,0:44:42.80,Default,,0,0,0,,Бұл ештеңе емес
Dialogue: 0,0:44:42.94,0:44:44.60,Default,,0,0,0,,Онда неге жылайсың?
Dialogue: 0,0:44:43.01,0:44:46.60,Default-ja,,0,0,0,,Сіз ештеңеге жылап отырсыз ба? Гриффитке не болды?
Dialogue: 0,0:44:45.38,0:44:46.54,Default,,0,0,0,,Гриффитпен бірдеңе болды ма?
Dialogue: 0,0:44:47.72,0:44:50.02,Default-ja,,0,0,0,,Тоқта, жоқ!
Dialogue: 0,0:44:47.78,0:44:48.77,Default,,0,0,0,,Бұл жалғыздықты тек шыңға шыққандар ғана түсіне алады
Dialogue: 0,0:44:48.91,0:44:50.04,Default,,0,0,0,,Бұл сіз ойлағандай емес!
Dialogue: 0,0:44:55.98,0:44:57.19,Default-ja,,0,0,0,,Әй...
Dialogue: 0,0:44:55.99,0:44:57.15,Default,,0,0,0,,H-Эй
Dialogue: 0,0:44:57.99,0:44:59.93,Default,,0,0,0,,Кешіріңіз, мен бара алмаймын
Dialogue: 0,0:44:58.11,0:44:59.98,Default-ja,,0,0,0,,Кешіріңіз, мен бара алмаймын.
Dialogue: 0,0:45:00.19,0:45:01.18,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:45:01.44,0:45:02.53,Default-ja,,0,0,0,,Мен...
Dialogue: 0,0:45:03.36,0:45:05.99,Default-ja,,0,0,0,,Мен сенімен бара алмаймын...
Dialogue: 0,0:45:03.40,0:45:05.92,Default,,0,0,0,,Мен сенімен бара алмаймын
Dialogue: 0,0:45:07.37,0:45:10.45,Default-ja,,0,0,0,,Гриффит өте арық...
Dialogue: 0,0:45:07.40,0:45:10.34,Default,,0,0,0,,Гриффит өте жұқа
Dialogue: 0,0:45:11.20,0:45:14.08,Default-ja,,0,0,0,,Жеңіл... осылай дірілдеп...
Dialogue: 0,0:45:11.70,0:45:14.11,Default,,0,0,0,,Оның салмағын жоғалтқаны сонша, үнемі қалтырап тұрады
Dialogue: 0,0:45:15.21,0:45:17.50,Default-ja,,0,0,0,,Сол мақтаншақ Гриффит...
Dialogue: 0,0:45:15.27,0:45:17.33,Default,,0,0,0,,Гриффит өте мақтаншақ және күшті болды
Dialogue: 0,0:45:21.59,0:45:25.22,Default-ja,,0,0,0,,Мен қазіргі Гриффитті артта қалдыра алмаймын...
Dialogue: 0,0:45:21.68,0:45:22.88,Default,,0,0,0,,Мен оны тастап кете алмаймын
Dialogue: 0,0:45:23.85,0:45:25.22,Default,,0,0,0,,Ол қазіргідей емес
Dialogue: 0,0:45:26.38,0:45:30.60,Default-ja,,0,0,0,,Мен сені тастап кете алмаймын. кешіріңіз...
Dialogue: 0,0:45:26.45,0:45:27.92,Default,,0,0,0,,Мен оны тастап кете алмаймын
Dialogue: 0,0:45:29.69,0:45:30.68,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:45:40.90,0:45:42.23,Default-ja,,0,0,0,,Мен де қаламын
Dialogue: 0,0:45:41.00,0:45:41.99,Default,,0,0,0,,Мен де қаламын
Dialogue: 0,0:45:45.07,0:45:47.82,Default-ja,,0,0,0,,Мен де Сұңқарлар тобында қаламын...
Dialogue: 0,0:45:45.14,0:45:47.73,Default,,0,0,0,,Мен Hawk тобында тұрамын
Dialogue: 0,0:46:04.80,0:46:08.01,Default-ja,,0,0,0,,Промроз Холлда не болғаны есіңізде ме?
Dialogue: 0,0:46:04.89,0:46:07.99,Default,,0,0,0,,Промроз Холлда не болғаны есіңізде ме?
Dialogue: 0,0:46:14.77,0:46:15.76,Default,,0,0,0,,Иә
Dialogue: 0,0:46:18.65,0:46:20.65,Default-ja,,0,0,0,,Олай болса бару керек.
Dialogue: 0,0:46:18.84,0:46:20.47,Default,,0,0,0,,Олай болса, бару керек
Dialogue: 0,0:46:24.94,0:46:27.38,Default,,0,0,0,,Егер сіз Гриффитке тең болсаңыз
Dialogue: 0,0:46:24.94,0:46:29.07,Default-ja,,0,0,0,,Гриффитпен тең болсаң, оның досы болсаң...
Dialogue: 0,0:46:27.95,0:46:29.01,Default,,0,0,0,,Егер сіз оның досы болсаңыз
Dialogue: 0,0:46:30.24,0:46:32.24,Default-ja,,0,0,0,,Мен жалғыз баруым керек
Dialogue: 0,0:46:30.38,0:46:31.71,Default,,0,0,0,,Жалғыз болса да бару керек
Dialogue: 0,0:47:16.33,0:47:19.16,Default-ja,,0,0,0,,Мұндай жерде неден қорқасың?
Dialogue: 0,0:47:16.36,0:47:19.09,Default,,0,0,0,,Сен мұнда не істеп жүрсің? Неге сонша қорқасың?
Dialogue: 0,0:47:44.69,0:47:47.53,Default-ja,,0,0,0,,Кеттік, әлі қызық болған жоқ.
Dialogue: 0,0:47:44.76,0:47:47.28,Default,,0,0,0,,Кеттік. біз ойнап біткен жоқпыз!
Dialogue: 0,0:47:48.28,0:47:50.36,Default-ja,,0,0,0,,Күн әлі батқан жоқ
Dialogue: 0,0:47:48.33,0:47:50.09,Default,,0,0,0,,Күн әлі батқан жоқ!
Dialogue: 0,0:48:00.94,0:48:02.13,Default,,0,0,0,,- Гриффит! - Гриффит!
Dialogue: 0,0:48:01.00,0:48:02.04,Default-ja,,0,0,0,,Гриффит!
Dialogue: 0,0:48:02.29,0:48:04.38,Default-ja,,0,0,0,,Не, қашқан ат?
Dialogue: 0,0:48:02.34,0:48:04.31,Default,,0,0,0,,Не? Жылқы жабайы жүгіре ме?
Dialogue: 0,0:48:05.08,0:48:07.24,Default,,0,0,0,,Гриффит бізді дәл қазір естіді деп ойламайсың ба?
Dialogue: 0,0:48:05.09,0:48:07.21,Default-ja,,0,0,0,,Жоқ, Гриффит бұл туралы айтып отыр! ?
Dialogue: 0,0:48:07.34,0:48:09.51,Default-ja,,0,0,0,,Ақымақ! Мен әрең жүгіре аламын ...
Dialogue: 0,0:48:07.45,0:48:09.21,Default,,0,0,0,,Бұл күлкілі Ол әрең жорғалайды
Dialogue: 0,0:48:12.89,0:48:14.11,Default,,0,0,0,,Яһудея және басқалар білсін!
Dialogue: 0,0:48:12.93,0:48:14.47,Default-ja,,0,0,0,,Яһудаға және басқаларға айт!
Dialogue: 0,0:48:15.51,0:48:16.22,Default-ja,,0,0,0,,Әке болу мен агент болуды қатар алып жүру қиын болар
Dialogue: 0,0:48:15.59,0:48:16.58,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:48:17.22,0:48:18.35,Default-ja,,0,0,0,,Маған ат беріңдер!
Dialogue: 0,0:48:17.26,0:48:18.25,Default,,0,0,0,,Маған атыңды қарызға бер!
Dialogue: 0,0:48:22.02,0:48:24.44,Default-ja,,0,0,0,,Қарғыс атсын! Қарғыс атсын!
Dialogue: 0,0:48:22.19,0:48:24.60,Default,,0,0,0,,Қарғыс атсын! Қарғыс атсын!
Dialogue: 0,0:48:24.98,0:48:25.86,Default-ja,,0,0,0,,Уг!?
Dialogue: 0,0:48:25.00,0:48:26.02,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:48:45.00,0:48:48.75,Default-ja,,0,0,0,,Иә... Мен сәл демалдым.
Dialogue: 0,0:48:45.05,0:48:46.04,Default,,0,0,0,,Иә
Dialogue: 0,0:48:46.99,0:48:48.92,Default,,0,0,0,,Мен тым ұзақ демалдым.
Dialogue: 0,0:48:50.82,0:48:51.98,Default,,0,0,0,,Менің кетуім керек.
Dialogue: 0,0:48:50.84,0:48:56.39,Default-ja,,0,0,0,,Мен қазір баруым керек, бұл ойын әлі аяқталған жоқ...
Dialogue: 0,0:48:53.19,0:48:55.99,Default,,0,0,0,,Мен ойнап біткен жоқпын.
Dialogue: 0,0:48:57.26,0:49:02.81,Default-ja,,0,0,0,,Артқы аллеядағы тас төсем әлі жалғасып жатыр...
Dialogue: 0,0:48:57.33,0:48:59.76,Default,,0,0,0,,Артқы аллеядағы тас жол
Dialogue: 0,0:49:00.90,0:49:02.53,Default,,0,0,0,,Жалғасы
Dialogue: 0,0:51:53.87,0:51:54.86,Default,,0,0,0,,Не болды?
Dialogue: 0,0:51:53.94,0:51:54.90,Default-ja,,0,0,0,,Не?
Dialogue: 0,0:51:55.40,0:51:57.94,Default-ja,,0,0,0,,Әй... мінекей
Dialogue: 0,0:51:55.97,0:51:57.91,Default,,0,0,0,,Сәлем қарашы
Dialogue: 0,0:52:00.95,0:52:02.61,Default-ja,,0,0,0,,Гриффит!
Dialogue: 0,0:52:01.11,0:52:02.34,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:52:12.50,0:52:13.46,Default-ja,,0,0,0,,Гриффит!
Dialogue: 0,0:52:12.59,0:52:13.58,Default,,0,0,0,,Гриффит!
Dialogue: 0,0:52:22.22,0:52:23.43,Default-ja,,0,0,0,,Солай ма?
Dialogue: 0,0:52:22.27,0:52:23.26,Default,,0,0,0,,Алыс болыңыз!
Dialogue: 0,0:52:28.18,0:52:29.52,Default-ja,,0,0,0,,Солай ма?
Dialogue: 0,0:52:28.31,0:52:29.30,Default,,0,0,0,,Алыс болыңыз!
Dialogue: 0,0:52:44.24,0:52:45.16,Default-ja,,0,0,0,,Не...! ?
Dialogue: 0,0:52:44.62,0:52:45.61,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:52:49.87,0:52:52.08,Default-ja,,0,0,0,,Егер мен сізге дәл қазір қол тигізсем...
Dialogue: 0,0:52:49.93,0:52:51.92,Default,,0,0,0,,Маған қазір тиіссең.
Dialogue: 0,0:53:00.07,0:53:01.51,Default,,0,0,0,,Мен ешқашан
Dialogue: 0,0:53:00.13,0:53:01.67,Default-ja,,0,0,0,,Мен ешқашан...
Dialogue: 0,0:53:20.36,0:53:21.61,Default-ja,,0,0,0,,Мен сені енді ешқашан көрмеймін...
Dialogue: 0,0:53:20.39,0:53:21.76,Default,,0,0,0,,енді ешқашан сенімен бірге болмаймын!
Dialogue: 0,0:53:58.31,0:54:00.02,Default-ja,,0,0,0,,Не? Ах
Dialogue: 0,0:53:58.36,0:53:59.35,Default,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,0:54:04.24,0:54:07.41,Default-ja,,0,0,0,,Не... болды...?
Dialogue: 0,0:54:04.27,0:54:05.53,Default,,0,0,0,,Не
Dialogue: 0,0:54:06.37,0:54:07.36,Default,,0,0,0,,Жаңа ғана болды ма?
Dialogue: 0,0:54:16.21,0:54:17.50,Default-ja,,0,0,0,,Не болып жатыр! ?
Dialogue: 0,0:54:16.28,0:54:17.37,Default,,0,0,0,,Не болып жатыр?!
Dialogue: 0,0:54:17.83,0:54:20.13,Default-ja,,0,0,0,,Уау~ Бұл қайда?!
Dialogue: 0,0:54:18.85,0:54:20.01,Default,,0,0,0,,Біз қайдамыз?
Dialogue: 0,0:54:20.05,0:54:21.54,Default,,0,0,0,,Ш-Осының бәрі не?!
Dialogue: 0,0:54:20.33,0:54:22.84,Default-ja,,0,0,0,,Бұл не...! ? Қай жерде пайда болды?
Dialogue: 0,0:54:21.59,0:54:22.85,Default,,0,0,0,,Олар қайдан келді?
Dialogue: 0,0:54:24.76,0:54:27.76,Default-ja,,0,0,0,,Әй, біз... жайлауда жүгіріп келе жатқанбыз... Әй! ?
Dialogue: 0,0:54:24.82,0:54:27.62,Default,,0,0,0,,W-Жай жайлауды кешіп жүрген жоқпыз ба?! Дұрыс па? Дұрыс?!
Dialogue: 0,0:54:27.66,0:54:28.82,Default,,0,0,0,,Аякаши оны кесіп өте алмайды
Dialogue: 0,0:54:27.88,0:54:30.39,Default-ja,,0,0,0,,Сәлем! Аяғыңызға қараңыз!
Dialogue: 0,0:54:29.36,0:54:30.42,Default,,0,0,0,,Қадамыңды бақылаңыз!
Dialogue: 0,0:54:33.53,0:54:35.50,Default,,0,0,0,,H-Бұл қалайша шын болуы мүмкін?!
Dialogue: 0,0:54:33.60,0:54:38.48,Default-ja,,0,0,0,,Бұлай болуы мүмкін емес! Бұл арман, біз армандаймыз
Dialogue: 0,0:54:35.70,0:54:36.79,Default,,0,0,0,,Бұл арман!
Dialogue: 0,0:54:36.84,0:54:38.50,Default,,0,0,0,,Біз армандаймыз!
Dialogue: 0,0:54:38.54,0:54:39.53,Default,,0,0,0,,Тынышталыңыз!
Dialogue: 0,0:54:38.60,0:54:39.81,Default-ja,,0,0,0,,Мен сені екеуіңді де жақсы көремін, сондықтан оны өзім бергім келеді.
Dialogue: 0,0:54:39.94,0:54:41.80,Default,,0,0,0,,Түсінбеген нәрсені ұтымды етіп көрсетуге тырыспаңыз!
Dialogue: 0,0:54:39.94,0:54:43.44,Default-ja,,0,0,0,,Түсінбеген нәрсені ойлама! Қолыңнан келгенін істе!
Dialogue: 0,0:54:41.97,0:54:43.34,Default,,0,0,0,,Қолыңнан келгенін істе!
Dialogue: 0,0:54:43.71,0:54:45.04,Default,,0,0,0,,Тығыз құрамды құрыңыз, қорғаныс позицияларын алыңыз!
Dialogue: 0,0:54:43.78,0:54:47.82,Default-ja,,0,0,0,,Шеңбер қорғауды құрастыру. Қазір жау шапса, құрып кетесің!
Dialogue: 0,0:54:45.21,0:54:47.58,Default,,0,0,0,,Егер бізге қазір шабуыл жасалса, бәріміз өлдік!
Dialogue: 0,0:54:47.88,0:54:49.18,Default,,0,0,0,,Яһудея! Коркус!
Dialogue: 0,0:54:47.95,0:54:50.49,Default-ja,,0,0,0,,Дзюдо! Коркас! Гастон! Пиппин!
Dialogue: 0,0:54:49.31,0:54:50.41,Default,,0,0,0,,Гастон! Пиппин!
Dialogue: 0,0:54:50.45,0:54:51.47,Default,,0,0,0,,Санақ жасаңыз,
Dialogue: 0,0:54:50.66,0:54:53.28,Default-ja,,0,0,0,,Адам санын тексеріп, құрамын дайында. Бұл үлкен доп...
Dialogue: 0,0:54:51.52,0:54:53.71,Default,,0,0,0,,- Ол ғажап - онда өз позицияларыңызды сақтаңыз!
Dialogue: 0,0:54:53.41,0:54:56.08,Default-ja,,0,0,0,,Жебені арбалет ұстаған адамға бер! Кешіктірмеңіз!
Dialogue: 0,0:54:53.75,0:54:55.48,Default,,0,0,0,,Арбалетпен қарулан!
Dialogue: 0,0:54:55.52,0:54:57.18,Default,,0,0,0,,- Стат! - Гриффит
Dialogue: 0,0:54:56.20,0:54:58.33,Default-ja,,0,0,0,,Гриффит сен тұра аласың ба?
Dialogue: 0,0:54:57.59,0:54:58.58,Default,,0,0,0,,Сіз тұра аласыз ба?
Dialogue: 0,0:55:07.47,0:55:08.72,Default-ja,,0,0,0,,Бехелит?
Dialogue: 0,0:55:07.53,0:55:08.52,Default,,0,0,0,,Behelit?
Dialogue: 0,0:55:14.22,0:55:15.93,Default-ja,,0,0,0,,Гриффит... жақсысың ба?
Dialogue: 0,0:55:14.24,0:55:15.61,Default,,0,0,0,,Гриффит Сенде бәрі жақсы ма?
Dialogue: 0,0:55:17.98,0:55:19.73,Default-ja,,0,0,0,,Уақыт келді...
Dialogue: 0,0:55:18.08,0:55:19.64,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:55:19.98,0:55:21.65,Default-ja,,0,0,0,,Уақыт келді...
Dialogue: 0,0:55:20.01,0:55:21.67,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:55:21.78,0:55:23.37,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:55:21.81,0:55:23.31,Default-ja,,0,0,0,,Уақыт келді...
Dialogue: 0,0:55:23.44,0:55:25.73,Default-ja,,0,0,0,,Ұлы түн мерекесінің уақыты...
Dialogue: 0,0:55:23.52,0:55:25.85,Default,,0,0,0,,Ұлы түн мерекесінің уақыты келді!
Dialogue: 0,0:55:25.86,0:55:30.49,Default-ja,,0,0,0,,216 жылда бір рет болатын банкет уақыты...
Dialogue: 0,0:55:25.88,0:55:30.25,Default,,0,0,0,,216 жылда бір рет болатын мереке!
Dialogue: 0,0:55:30.70,0:55:32.16,Default-ja,,0,0,0,,Тұтылу!
Dialogue: 0,0:55:30.79,0:55:32.16,Default,,0,0,0,,Тұтылу!
Dialogue: 0,0:55:33.20,0:55:34.49,Default-ja,,0,0,0,,Тұтылу! ?
Dialogue: 0,0:55:33.29,0:55:34.28,Default,,0,0,0,,Тұтылу?
Dialogue: 0,0:55:36.33,0:55:37.83,Default-ja,,0,0,0,,Бұл не деген жігіттер! ?
Dialogue: 0,0:55:36.39,0:55:37.92,Default,,0,0,0,,Бұл не деген жігіттер?!
Dialogue: 0,0:55:37.96,0:55:39.16,Default,,0,0,0,,W-Олар қашан пайда болады?
Dialogue: 0,0:55:38.00,0:55:38.83,Default-ja,,0,0,0,,Мен мұны білмей тұрып...
Dialogue: 0,0:55:39.37,0:55:40.50,Default-ja,,0,0,0,,Келе жатыр!
Dialogue: 0,0:55:39.46,0:55:40.59,Default,,0,0,0,,Олар келе жатыр!
Dialogue: 0,0:55:40.62,0:55:41.67,Default-ja,,0,0,0,,Ол келе жатыр...
Dialogue: 0,0:55:40.63,0:55:41.83,Default,,0,0,0,,Олар келе жатыр
Dialogue: 0,0:55:41.79,0:55:43.50,Default-ja,,0,0,0,,Кел
Dialogue: 0,0:55:41.87,0:55:43.60,Default,,0,0,0,,Міне, олар келді
Dialogue: 0,0:55:43.63,0:55:45.88,Default-ja,,0,0,0,,Сол адамдар келе жатыр...
Dialogue: 0,0:55:43.67,0:55:45.97,Default,,0,0,0,,Олар келе жатыр
Dialogue: 0,0:55:46.00,0:55:47.03,Default,,0,0,0,,Олар келе жатыр
Dialogue: 0,0:55:46.00,0:55:47.17,Default-ja,,0,0,0,,Бұл келе жатыр...
Dialogue: 0,0:55:47.37,0:55:48.40,Default,,0,0,0,,Олар келе жатыр
Dialogue: 0,0:55:47.42,0:55:48.38,Default-ja,,0,0,0,,Келеді...
Dialogue: 0,0:55:48.47,0:55:51.67,Default,,0,0,0,,Біздің қожайындар Жоғарғы болмыстың егемені!
Dialogue: 0,0:55:48.51,0:55:51.26,Default-ja,,0,0,0,,Біз табиғаттан тыс патшамыз
Dialogue: 0,0:55:53.97,0:55:58.02,Default-ja,,0,0,0,,Төрт қорғаушы періштенің келуі!
Dialogue: 0,0:55:54.05,0:55:58.11,Default,,0,0,0,,Төрт қорғаушы періштенің келуі!
Dialogue: 0,0:56:04.19,0:56:08.18,Default,,0,0,0,,О, Слан ханым! Қуаныңыз!
Dialogue: 0,0:56:04.23,0:56:06.86,Default-ja,,0,0,0,,Уа, Тран мырза!
Dialogue: 0,0:56:08.32,0:56:10.74,Default-ja,,0,0,0,,Лорд Тран!
Dialogue: 0,0:56:08.39,0:56:10.26,Default,,0,0,0,,Слан ханым!
Dialogue: 0,0:56:48.48,0:56:51.03,Default-ja,,0,0,0,,Kyohoho…
Dialogue: 0,0:57:06.96,0:57:09.92,Default-ja,,0,0,0,,Kyohoho…
Dialogue: 0,0:57:14.59,0:57:16.26,Default-ja,,0,0,0,,Енді ше? ?
Dialogue: 0,0:57:14.83,0:57:16.32,Default,,0,0,0,,Енді ше?!
Dialogue: 0,0:57:24.27,0:57:25.67,Default,,0,0,0,,Б-Не болып жатыр?!
Dialogue: 0,0:57:24.27,0:57:25.77,Default-ja,,0,0,0,,Не?
Dialogue: 0,0:57:58.05,0:57:59.43,Default-ja,,0,0,0,,Құдай…
Dialogue: 0,0:57:58.14,0:57:59.13,Default,,0,0,0,,Құдайлар
Dialogue: 0,0:58:00.26,0:58:01.85,Default-ja,,0,0,0,,Жоқ, шайтан?
Dialogue: 0,0:58:00.27,0:58:01.86,Default,,0,0,0,,Жоқ, жындар ма?
Dialogue: 0,0:58:01.97,0:58:04.27,Default-ja,,0,0,0,,Жақсы жиналды.
Dialogue: 0,0:58:02.04,0:58:04.03,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:58:04.81,0:58:10.02,Default-ja,,0,0,0,,Құдай емес, адам жасаған Құдайдың Тоқтылары.
Dialogue: 0,0:58:04.88,0:58:09.78,Default,,0,0,0,,Ей, адамнан туған құдайсыз құдайдың қозылары
Dialogue: 0,0:58:10.65,0:58:15.82,Default-ja,,0,0,0,,Осы қасиетті түн мерекесінен толық рахат алыңыз.
Dialogue: 0,0:58:10.68,0:58:16.14,Default,,0,0,0,,Осы түнгі қасиетті мерекеден толық рахат алыңыз
Dialogue: 0,0:58:19.06,0:58:20.05,Default,,0,0,0,,Сұңқар
Dialogue: 0,0:58:19.07,0:58:23.16,Default-ja,,0,0,0,,Хок, себеп-салдар заңы бойынша таңдалған ұл
Dialogue: 0,0:58:20.09,0:58:22.96,Default,,0,0,0,,себептілік заңдарымен бағышталған ардақты бала
Dialogue: 0,0:58:24.36,0:58:26.63,Default,,0,0,0,,Сіз таңдалған адамсыз
Dialogue: 0,0:58:24.54,0:58:30.17,Default-ja,,0,0,0,,Таңдаулысың, осы сағатта, осы елде...
Dialogue: 0,0:58:27.23,0:58:30.17,Default,,0,0,0,,Осы уақытта, осы жерде
Dialogue: 0,0:58:30.27,0:58:35.30,Default,,0,0,0,,Ұлы құдайдың қолымен таңдалған
Dialogue: 0,0:58:30.33,0:58:35.38,Default-ja,,0,0,0,,Ұлы Құдайдың қолымен тағайындалғандар
Dialogue: 0,0:58:36.13,0:58:41.51,Default-ja,,0,0,0,,Біздің вассалымыз, аңсаған Бақытты патша!
Dialogue: 0,0:58:36.14,0:58:41.64,Default,,0,0,0,,Біз өнер туысқандар Ей, Сағыныштың құтты патшасы
Dialogue: 0,0:58:43.35,0:58:44.35,Default-ja,,0,0,0,,Тәуелді...?
Dialogue: 0,0:58:44.47,0:58:45.77,Default-ja,,0,0,0,,Бұл...
Dialogue: 0,0:58:45.85,0:58:48.15,Default,,0,0,0,,Ол солардың бірі ме? Гриффит?
Dialogue: 0,0:58:45.89,0:58:48.39,Default-ja,,0,0,0,,Достар? Гриффит?
Dialogue: 0,0:58:48.35,0:58:50.02,Default,,0,0,0,,Ол солар сияқты ма?
Dialogue: 0,0:58:48.56,0:58:50.19,Default-ja,,0,0,0,,Олар сияқты...?
Dialogue: 0,0:58:51.86,0:58:52.88,Default,,0,0,0,,Қалжыңдама
Dialogue: 0,0:58:51.86,0:58:52.98,Default-ja,,0,0,0,,…Оны жібермеңіз
Dialogue: 0,0:58:54.79,0:58:56.45,Default,,0,0,0,,Бұл күлкілі!
Dialogue: 0,0:58:55.03,0:58:57.03,Default-ja,,0,0,0,,Ауырсынып жатыр~! Қарауға батылым жетпейді
Dialogue: 0,0:58:57.78,0:58:58.70,Default-ja,,0,0,0,,Ішек...
Dialogue: 0,0:58:57.86,0:58:58.85,Default,,0,0,0,,Ішек
Dialogue: 0,0:58:58.82,0:59:02.62,Default-ja,,0,0,0,,Ұлым? Сіз туыссыз ба? Ақымақ болма!
Dialogue: 0,0:58:58.90,0:59:00.80,Default,,0,0,0,,Қасиетті бала? Туысқандар?
Dialogue: 0,0:59:00.93,0:59:02.40,Default,,0,0,0,,Кетіңіз!
Dialogue: 0,0:59:02.80,0:59:05.36,Default,,0,0,0,,Мен бұл жігітті жалаңаш көрдім!
Dialogue: 0,0:59:02.87,0:59:05.62,Default-ja,,0,0,0,,Мен бұл жігітті бұрын да жалаңаш көргенмін.
Dialogue: 0,0:59:05.84,0:59:08.50,Default,,0,0,0,,Бір анық нәрсе, оның құйрығы жоқ!
Dialogue: 0,0:59:05.87,0:59:09.04,Default-ja,,0,0,0,,Бұл жігіттің құйрығы да өспейді!
Dialogue: 0,0:59:10.29,0:59:13.13,Default-ja,,0,0,0,,Аха…
Dialogue: 0,0:59:14.61,0:59:17.61,Default,,0,0,0,,Сондай әдемі достық
Dialogue: 0,0:59:14.67,0:59:17.63,Default-ja,,0,0,0,,Әдемі достық
Dialogue: 0,0:59:17.75,0:59:22.52,Default,,0,0,0,,Сіз керемет құрбандық жасайсыз!
Dialogue: 0,0:59:17.80,0:59:22.68,Default-ja,,0,0,0,,Сіз үлкен құрбандық етер едіңіз.
Dialogue: 0,0:59:22.82,0:59:23.81,Default,,0,0,0,,Құрбан шалу?
Dialogue: 0,0:59:22.85,0:59:23.85,Default-ja,,0,0,0,,Құрбан шалу?
Dialogue: 0,0:59:23.86,0:59:29.69,Default,,0,0,0,,Иә Жынға айналуы үшін лайықты құрбандық!
Dialogue: 0,0:59:24.14,0:59:29.94,Default-ja,,0,0,0,,Иә, оның жын патшасы болуы үшін қымбат құрбандық...
Dialogue: 0,0:59:30.06,0:59:33.44,Default-ja,,0,0,0,,Мен сол қызыл Бехелитті алған күннен бастап...
Dialogue: 0,0:59:30.19,0:59:33.39,Default,,0,0,0,,Қып-қызыл Бехелитті қолыңызға алған сәтте,
Dialogue: 0,0:59:33.43,0:59:36.80,Default,,0,0,0,,сіз жын құдайы болу құқығын алдыңыз
Dialogue: 0,0:59:33.56,0:59:38.03,Default-ja,,0,0,0,,Сіз жын патшасы болу біліктілігін алдыңыз, kyohohoho...
Dialogue: 0,0:59:38.19,0:59:41.61,Default-ja,,0,0,0,,Бұл біздің қорғаншы періштеміз.
Dialogue: 0,0:59:38.24,0:59:41.64,Default,,0,0,0,,Бұл патшаның жұмыртқасы
Dialogue: 0,0:59:41.67,0:59:45.27,Default,,0,0,0,,Бұл адамның өзіміз ретінде қайта туылуына мүмкіндік береді,
Dialogue: 0,0:59:41.74,0:59:47.50,Default-ja,,0,0,0,,Бұл құдайдың қолына қайта туылуы мүмкін үстем қожаның жұмыртқасы.
Dialogue: 0,0:59:45.31,0:59:47.54,Default,,0,0,0,,Қорғаушы періштелер, құдайдың қолы
Dialogue: 0,0:59:47.78,0:59:54.81,Default,,0,0,0,,Және бәріңіз де періштелердің келуі үшін баға жетпес құрбандықтарсыздар
Dialogue: 0,0:59:47.79,0:59:52.58,Default-ja,,0,0,0,,Ал сен періштелердің келуі үшін...
Dialogue: 0,0:59:52.75,0:59:54.59,Default-ja,,0,0,0,,Бағалы құрбандық...
Dialogue: 0,1:00:02.01,1:00:05.26,Default-ja,,0,0,0,,Бұл арман ғой бұл арман ғой
Dialogue: 0,1:00:02.09,1:00:05.39,Default,,0,0,0,,Бұл арман ғой
Dialogue: 0,1:00:10.44,1:00:13.00,Default,,0,0,0,,Ей, сұмдықтар, Гриффитті құбыжық етіп өзгертесіз бе?
Dialogue: 0,1:00:10.56,1:00:13.56,Default-ja,,0,0,0,,Гриффитті құбыжыққа айналдырсаңыз ше?
Dialogue: 0,1:00:13.57,1:00:15.27,Default,,0,0,0,,Біздің өмірімізге айырбас па?!
Dialogue: 0,1:00:13.69,1:00:15.52,Default-ja,,0,0,0,,Біздің өмірімізге айырбас ретінде...
Dialogue: 0,1:00:15.64,1:00:17.77,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,1:00:15.65,1:00:21.11,Default-ja,,0,0,0,,Бұл сәл басқаша. Бұл оның еркі.
Dialogue: 0,1:00:18.31,1:00:21.21,Default,,0,0,0,,Ол өз еркімен болады
Dialogue: 0,1:00:21.95,1:00:26.25,Default,,0,0,0,,Ол бәріңді құрбандыққа шалады
Dialogue: 0,1:00:21.95,1:00:26.37,Default-ja,,0,0,0,,Ол сені құрбан етеді...
Dialogue: 0,1:00:40.92,1:00:42.84,Default-ja,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,1:00:40.97,1:00:42.43,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,1:00:44.94,1:00:47.17,Default,,0,0,0,,Жылдам бол, мен қазір ойнағым келеді!
Dialogue: 0,1:00:44.97,1:00:46.97,Default-ja,,0,0,0,,Осындай нәрсе болуы керек...
Dialogue: 0,1:00:47.18,1:00:51.14,Default-ja,,0,0,0,,Барлығы себеп пен салдар ағымында
Dialogue: 0,1:00:47.21,1:00:50.87,Default,,0,0,0,,Барлығы себептілік ағымдарының ішінде жатыр
Dialogue: 0,1:00:51.34,1:00:55.64,Default,,0,0,0,,Қазір қиямет шақыру уақыты
Dialogue: 0,1:00:51.48,1:00:56.40,Default-ja,,0,0,0,,Енді жын шығару рәсімі өтеді.
Dialogue: 0,1:00:55.68,1:00:57.08,Default,,0,0,0,,Қияметтің шақыруы!
Dialogue: 0,1:00:56.98,1:01:01.53,Default-ja,,0,0,0,,Ұлыңызды құрбандық үстеліне әкеліңіз!
Dialogue: 0,1:00:57.12,1:01:01.68,Default,,0,0,0,,Баланы құрбандық үстеліне әкеліңіз!
Dialogue: 0,1:01:08.76,1:01:10.75,Default,,0,0,0,,Ішің, Гриффит!
Dialogue: 0,1:01:08.87,1:01:11.04,Default-ja,,0,0,0,,Ішім! Гриффит!
Dialogue: 0,1:02:13.99,1:02:18.12,Default,,0,0,0,,Сіз қорқасыз ба? Сіз сияқты біреу ме?
Dialogue: 0,1:02:14.06,1:02:18.27,Default-ja,,0,0,0,,Қорқынышты ма? Сен сияқты біреу
Dialogue: 0,1:02:19.03,1:02:22.47,Default,,0,0,0,,Біз сияқты ерекше жаратылыстардың?
Dialogue: 0,1:02:19.15,1:02:22.57,Default-ja,,0,0,0,,Табиғаттан тыс тіршілік иелері туралы не деуге болады?
Dialogue: 0,1:02:22.94,1:02:27.78,Default-ja,,0,0,0,,Әлде бұл сіздің келе жатқан болашақ па?
Dialogue: 0,1:02:24.20,1:02:27.54,Default,,0,0,0,,Немесе сіз ілесетін болашақ туралы ма?
Dialogue: 0,1:02:28.41,1:02:33.33,Default-ja,,0,0,0,,Болашаққа жеткенше бір рет біл.
Dialogue: 0,1:02:28.44,1:02:30.67,Default,,0,0,0,,Біз болашаққа кірер алдында
Dialogue: 0,1:02:31.21,1:02:35.84,Default,,0,0,0,,Өткен өміріңіздің негізіне бір рет оралайық
Dialogue: 0,1:02:33.62,1:02:36.25,Default-ja,,0,0,0,,Өзіңіз...
Dialogue: 0,1:03:36.57,1:03:38.10,Default,,0,0,0,,Менің.
Dialogue: 0,1:03:36.64,1:03:41.06,Default-ja,,0,0,0,,Әй... Ол шынымен шулы бала.
Dialogue: 0,1:03:38.38,1:03:41.04,Default,,0,0,0,,Сондай шулы бала.
Dialogue: 0,1:03:41.77,1:03:44.32,Default-ja,,0,0,0,,Нені шулатып жатырсың?
Dialogue: 0,1:03:41.85,1:03:44.34,Default,,0,0,0,,Мынаның бәрі не?
Dialogue: 0,1:03:44.73,1:03:49.78,Default-ja,,0,0,0,,Өйткені, кемпір, қаншама адам өліп жатыр!
Dialogue: 0,1:03:44.78,1:03:46.01,Default,,0,0,0,,Бірақ кемпір
Dialogue: 0,1:03:47.08,1:03:49.58,Default,,0,0,0,,Өлген адамдар қаншама!
Dialogue: 0,1:03:49.90,1:03:52.57,Default-ja,,0,0,0,,Бұл сіздің істегеніңіз емес пе?
Dialogue: 0,1:03:49.92,1:03:52.52,Default,,0,0,0,,Мұның бәрі сіздің әрекетіңіз.
Dialogue: 0,1:04:00.66,1:04:05.04,Default-ja,,0,0,0,,Сенің сол сарайға барасың деп айтуым керек.
Dialogue: 0,1:04:00.73,1:04:02.67,Default,,0,0,0,,Мұның бәрі
Dialogue: 0,1:04:02.70,1:04:05.17,Default,,0,0,0,,Егер сіз бұл сарайға барамын деп ешқашан айтпаған болсаңыз
Dialogue: 0,1:04:05.17,1:04:08.17,Default-ja,,0,0,0,,Барлығы аман қалды!
Dialogue: 0,1:04:05.20,1:04:07.76,Default,,0,0,0,,ешкім өлмес еді!
Dialogue: 0,1:04:10.17,1:04:14.09,Default-ja,,0,0,0,,Солай...Мен ешкімді артымнан еруге мәжбүрлей алмаймын...
Dialogue: 0,1:04:10.21,1:04:11.23,Default,,0,0,0,,Бұл
Dialogue: 0,1:04:11.71,1:04:14.14,Default,,0,0,0,,Мен ешкімді өзіммен бірге келуге мәжбүрлеген жоқпын.
Dialogue: 0,1:04:14.18,1:04:15.37,Default,,0,0,0,,Тыныштық!
Dialogue: 0,1:04:14.22,1:04:15.51,Default-ja,,0,0,0,,Одамари!
Dialogue: 0,1:04:16.47,1:04:18.93,Default-ja,,0,0,0,,Сіз білуіңіз керек еді
Dialogue: 0,1:04:16.55,1:04:18.85,Default,,0,0,0,,Сіз білуіңіз керек еді.
Dialogue: 0,1:04:19.05,1:04:23.68,Default,,0,0,0,,Бұл жердің қандай екенін білдің.
Dialogue: 0,1:04:19.06,1:04:23.81,Default-ja,,0,0,0,,Сіз бұл жердің қандай екенін білуіңіз керек еді.
Dialogue: 0,1:04:26.02,1:04:27.52,Default-ja,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,1:04:26.06,1:04:27.12,Default,,0,0,0,,Мен білдім бе?
Dialogue: 0,1:04:28.46,1:04:29.89,Default,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,1:04:28.53,1:04:30.03,Default-ja,,0,0,0,,(Беатриса) Ол кітап бөлмеге кіріп кеткен жәндіктерден қалай құтылу керектігін айтып бере ме екен?
Dialogue: 0,1:04:30.49,1:04:35.96,Default,,0,0,0,,Ол қамалға жетудің жалғыз жолы - осы мәйіттердің барлығын басып өту.
Dialogue: 0,1:04:30.49,1:04:35.82,Default-ja,,0,0,0,,Сол қамалға жетудің жалғыз жолы - сол мәйітті басу.
Dialogue: 0,1:04:36.33,1:04:40.97,Default,,0,0,0,,Әйтпесе. сен де жәй мәйітке айналасың!
Dialogue: 0,1:04:36.33,1:04:41.21,Default-ja,,0,0,0,,Әйтпесе, сен де өлікке айналасың.
Dialogue: 0,1:04:44.84,1:04:47.94,Default,,0,0,0,,Мен... Мен...
Dialogue: 0,1:04:45.08,1:04:48.09,Default-ja,,0,0,0,,Мен... мен...
Dialogue: 0,1:04:48.78,1:04:51.41,Default,,0,0,0,,Ақымақ бала!
Dialogue: 0,1:04:48.92,1:04:51.30,Default-ja,,0,0,0,,Мына бала ақымақ...
Dialogue: 0,1:04:51.85,1:04:55.65,Default,,0,0,0,,Егер сіз өкінетін болсаңыз. сен оны ешқашан тілемегенсің.
Dialogue: 0,1:04:51.92,1:04:55.59,Default-ja,,0,0,0,,Өкінгеннен гөрі, ең алдымен мұны қаламағанымды қалаймын...
Dialogue: 0,1:04:56.43,1:05:01.06,Default-ja,,0,0,0,,Мен неге артқы аллеядан жоғары қарап, қанағаттанбадым?
Dialogue: 0,1:04:56.49,1:04:58.62,Default,,0,0,0,,Неге қанағаттанбадың?
Dialogue: 0,1:04:58.66,1:05:00.99,Default,,0,0,0,,аллеялардан қамалға қарап?
Dialogue: 0,1:05:08.10,1:05:09.09,Default,,0,0,0,,Иә
Dialogue: 0,1:05:08.15,1:05:10.90,Default-ja,,0,0,0,,Иә... Мен білдім.
Dialogue: 0,1:05:09.40,1:05:10.63,Default,,0,0,0,,Мен білдім.
Dialogue: 0,1:05:11.74,1:05:12.73,Default,,0,0,0,,Дегенмен
Dialogue: 0,1:05:11.78,1:05:13.07,Default-ja,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,1:05:17.12,1:05:22.08,Default-ja,,0,0,0,,Мен кешірім сұрай алмаймын, жоқ, мен...
Dialogue: 0,1:05:17.14,1:05:18.54,Default,,0,0,0,,Мен кешірім сұрай алмаймын.
Dialogue: 0,1:05:19.54,1:05:21.88,Default,,0,0,0,,Жоқ.
Dialogue: 0,1:05:23.54,1:05:26.50,Default-ja,,0,0,0,,Кешірім сұрасаң, өкінсең...
Dialogue: 0,1:05:23.58,1:05:24.81,Default,,0,0,0,,Кешірім сұрасам
Dialogue: 0,1:05:25.55,1:05:29.15,Default,,0,0,0,,Өкінсем, бәрі бітеді.
Dialogue: 0,1:05:27.58,1:05:29.84,Default-ja,,0,0,0,,Өйткені бәрі бітеді
Dialogue: 0,1:05:32.29,1:05:36.28,Default,,0,0,0,,Мен ол жерге ешқашан жете алмаймын.
Dialogue: 0,1:05:32.30,1:05:36.59,Default-ja,,0,0,0,,Өйткені ол жерге енді жете алмайсың...
Dialogue: 0,1:05:43.85,1:05:46.73,Default-ja,,0,0,0,,Иә, бұл сенсің!
Dialogue: 0,1:05:43.94,1:05:44.93,Default,,0,0,0,,Иә
Dialogue: 0,1:05:45.17,1:05:47.04,Default,,0,0,0,,Бұл сенсің!
Dialogue: 0,1:05:51.21,1:05:53.11,Default,,0,0,0,,Бұл иллюзия болды ма?
Dialogue: 0,1:05:51.23,1:05:53.32,Default-ja,,0,0,0,,Бұл жай ғана елес пе...?
Dialogue: 0,1:05:54.82,1:05:57.24,Default-ja,,0,0,0,,Бұл иллюзия емес...
Dialogue: 0,1:05:54.85,1:05:56.94,Default,,0,0,0,,Бұл иллюзия емес еді
Dialogue: 0,1:05:57.32,1:05:59.84,Default,,0,0,0,,Бұл сіздің саналы әлеміңіздегі шындық болды
Dialogue: 0,1:05:57.36,1:06:01.33,Default-ja,,0,0,0,,Бұл сіздің саналы әлеміңіздегі шындық!
Dialogue: 0,1:05:59.88,1:06:01.28,Default,,0,0,0,,Шындық!
Dialogue: 0,1:06:04.54,1:06:10.46,Default-ja,,0,0,0,,Аспандағы қамалды көздеген мүрделер төбесінде үйіліп жатыр
Dialogue: 0,1:06:04.59,1:06:06.96,Default,,0,0,0,,Аспандағы қамалға көз салу
Dialogue: 0,1:06:07.12,1:06:10.29,Default,,0,0,0,,Мәйіттерді шексіз үйіп алу
Dialogue: 0,1:06:10.96,1:06:13.06,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,1:06:10.96,1:06:13.63,Default-ja,,0,0,0,,Бұл сенсің
Dialogue: 0,1:06:14.13,1:06:15.88,Default-ja,,0,0,0,,Және...
Dialogue: 0,1:06:14.27,1:06:15.60,Default,,0,0,0,,Және
Dialogue: 0,1:06:16.68,1:06:20.80,Default-ja,,0,0,0,,Енді сіздің артқы аллеяңыз аяқталды.
Dialogue: 0,1:06:17.00,1:06:20.67,Default,,0,0,0,,Енді сіздің артқы аллеяңыз жабылды
Dialogue: 0,1:06:21.21,1:06:22.43,Default,,0,0,0,,Бірақ қараңыз
Dialogue: 0,1:06:21.26,1:06:22.64,Default-ja,,0,0,0,,Бірақ қараңыз
Dialogue: 0,1:06:23.81,1:06:26.18,Default,,0,0,0,,Сізбен бірге ұшқандар
Dialogue: 0,1:06:23.81,1:06:28.73,Default-ja,,0,0,0,,Бірге ұшуын жалғастырған сұңқар қанаттары
Dialogue: 0,1:06:26.24,1:06:28.18,Default,,0,0,0,,Сұңқар тобы
Dialogue: 0,1:06:29.15,1:06:35.57,Default-ja,,0,0,0,,Қанды сапарыңның соңында не қалды...
Dialogue: 0,1:06:29.21,1:06:31.74,Default,,0,0,0,,Қанның иісі
Dialogue: 0,1:06:32.22,1:06:35.52,Default,,0,0,0,,Жолдың соңына дейін сізге қалдырылғандар
Dialogue: 0,1:06:36.65,1:06:39.99,Default-ja,,0,0,0,,Ал сіз өмір сүре аласыз
Dialogue: 0,1:06:36.69,1:06:39.78,Default,,0,0,0,,Осылайша сіз өмір сүруді жалғастыра аласыз
Dialogue: 0,1:06:40.73,1:06:43.56,Default,,0,0,0,,Арманың қираған жер астында көмілген
Dialogue: 0,1:06:40.74,1:06:43.66,Default-ja,,0,0,0,,Армандардың қалдықтарына көмілген...
Dialogue: 0,1:06:45.08,1:06:47.66,Default-ja,,0,0,0,,Арманның қалдықтары...
Dialogue: 0,1:06:45.20,1:06:47.63,Default,,0,0,0,,Менің арманымның қирандылары?
Dialogue: 0,1:06:51.84,1:06:57.38,Default-ja,,0,0,0,,Сізден қалғанның бәрін жинаңыз...
Dialogue: 0,1:06:52.04,1:06:53.80,Default,,0,0,0,,Оларды жинаңыз
Dialogue: 0,1:06:54.41,1:06:57.40,Default,,0,0,0,,Мұның бәрі сізге қалды
Dialogue: 0,1:06:58.51,1:07:04.10,Default-ja,,0,0,0,,Жүрегіңізде бір сөз айтыңыз: «Арнау».
Dialogue: 0,1:06:58.64,1:07:03.95,Default,,0,0,0,,«Құрбан етемін» деген сөздерді жүрегіңмен айт
Dialogue: 0,1:07:06.72,1:07:10.65,Default,,0,0,0,,Саған қарға-қара қанаттар беріледі
Dialogue: 0,1:07:06.81,1:07:10.15,Default-ja,,0,0,0,,Сонда сіз төбеден аспанға ұшасыз.
Dialogue: 0,1:07:10.27,1:07:14.15,Default-ja,,0,0,0,,Мен саған қара қанатты бермеймін!
Dialogue: 0,1:07:10.69,1:07:13.85,Default,,0,0,0,,ол бойынша сіз аспанға ұшасыз
Dialogue: 0,1:07:20.20,1:07:21.46,Default,,0,0,0,,Гриффит!
Dialogue: 0,1:07:20.20,1:07:21.53,Default-ja,,0,0,0,,Гриффит!
Dialogue: 0,1:07:38.92,1:07:40.01,Default,,0,0,0,,Иә
Dialogue: 0,1:07:39.01,1:07:44.72,Default-ja,,0,0,0,,Иә...мыңдаған, он мыңдаған дос пен дұшпанның арасында...
Dialogue: 0,1:07:41.22,1:07:45.35,Default,,0,0,0,,Мыңдардың ішінде. ондаған мың дос пен дұшпан
Dialogue: 0,1:07:45.47,1:07:48.23,Default-ja,,0,0,0,,Тек сен...
Dialogue: 0,1:07:45.56,1:07:52.19,Default,,0,0,0,,Арманымды ұмыттырған жалғыз сенсің.
Dialogue: 0,1:07:49.52,1:07:52.15,Default-ja,,0,0,0,,Сіз маған армандарымды ұмыттырдыңыз ...
Dialogue: 0,1:08:02.49,1:08:03.91,Default-ja,,0,0,0,,Арнау
Dialogue: 0,1:08:02.51,1:08:03.97,Default,,0,0,0,,Мен құрбан етемін
Dialogue: 0,1:08:09.65,1:08:11.14,Default,,0,0,0,,Гриффит!
Dialogue: 0,1:08:09.71,1:08:11.42,Default-ja,,0,0,0,,Гриффит!
Dialogue: 0,1:08:26.46,1:08:27.66,Default,,0,0,0,,Гриффит!
Dialogue: 0,1:08:26.47,1:08:27.93,Default-ja,,0,0,0,,Гриффит!
Dialogue: 0,1:08:34.77,1:08:41.37,Default,,0,0,0,,Себеп-салдарлық заңдармен байластырылған жіптер енді байланыстырылды
Dialogue: 0,1:08:34.77,1:08:38.78,Default-ja,,0,0,0,,Себеп-салдар заңы бойынша бір-бірімен байланысқан жіптер...
Dialogue: 0,1:08:38.90,1:08:41.03,Default-ja,,0,0,0,,Енді байланыстырылды...
Dialogue: 0,1:08:41.81,1:08:45.21,Default,,0,0,0,,Уәде етілген уақыт келді
Dialogue: 0,1:08:41.90,1:08:45.53,Default-ja,,0,0,0,,Уәденің уақыты келді!
Dialogue: 0,1:09:06.44,1:09:07.43,Default,,0,0,0,,Не-?!
Dialogue: 0,1:09:25.24,1:09:30.95,Default-ja,,0,0,0,,Қазір саған ойып жазылған нәрсе - құрбандықтың белгісі.
Dialogue: 0,1:09:25.26,1:09:31.06,Default,,0,0,0,,Құрбандық таңбасын жазып қалдырдың
Dialogue: 0,1:09:31.24,1:09:37.13,Default-ja,,0,0,0,,Оған жазылған адамның өмірі оның қанының соңғы тамшысы.
Dialogue: 0,1:09:31.60,1:09:37.36,Default,,0,0,0,,Қанның соңғы тамшысына дейін ойып жазылғандардың өмірі
Dialogue: 0,1:09:37.33,1:09:42.42,Default-ja,,0,0,0,,Тіпті қараңғылықтың жаңа баласының соңғы азабы...
Dialogue: 0,1:09:37.40,1:09:40.30,Default,,0,0,0,,Азапты өлім сәтіне дейін,
Dialogue: 0,1:09:40.34,1:09:45.37,Default,,0,0,0,,қараңғылықтың жаңа баласына азық болады
Dialogue: 0,1:09:42.84,1:09:45.84,Default-ja,,0,0,0,,Өмір азығы бол
Dialogue: 0,1:09:49.38,1:09:50.81,Default,,0,0,0,,- Пиппин! - Жүгір!
Dialogue: 0,1:09:49.47,1:09:50.85,Default-ja,,0,0,0,,Пипин! Жүгіріп кету!
Dialogue: 0,1:09:52.58,1:09:56.45,Default,,0,0,0,,Жүр! Жүгір! Қашыңыз Сіз аман қалуыңыз керек!
Dialogue: 0,1:09:52.64,1:09:56.14,Default-ja,,0,0,0,,Жүр! Қаш, қаш... Аман қалуың керек!
Dialogue: 0,1:09:56.48,1:09:57.40,Default-ja,,0,0,0,,Не айтасыз...
Dialogue: 0,1:09:56.49,1:09:57.51,Default,,0,0,0,,Не айтып тұрсың?!
Dialogue: 0,1:09:58.22,1:10:01.32,Default,,0,0,0,,Не істеп жатырсың, Жүдоу?! Мені жіберіңізші! Пиппин!
Dialogue: 0,1:09:58.23,1:10:01.32,Default-ja,,0,0,0,,Сіз не істеп жатырсыз? Жуданы босат! Пиппин!
Dialogue: 0,1:10:09.45,1:10:11.99,Default-ja,,0,0,0,,Арқаңа көтер мені
Dialogue: 0,1:10:12.16,1:10:13.12,Default-ja,,0,0,0,,Пипин!
Dialogue: 0,1:10:12.17,1:10:13.19,Default,,0,0,0,,Пиппин!
Dialogue: 0,1:10:17.34,1:10:18.54,Default,,0,0,0,,Яһудея, артқа бұрыл!
Dialogue: 0,1:10:17.37,1:10:20.00,Default-ja,,0,0,0,,Иуданы қайтар! Сіз оның өлуге рұқсат беруді жоспарлап отырсыз ба? ?
Dialogue: 0,1:10:18.58,1:10:19.98,Default,,0,0,0,,Біз оның өлуіне жол бере алмаймыз!
Dialogue: 0,1:10:20.08,1:10:21.01,Default,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,1:10:20.17,1:10:24.21,Default-ja,,0,0,0,,Жоқ! Сіз қазір біздің командирсіз.
Dialogue: 0,1:10:21.75,1:10:24.04,Default,,0,0,0,,Сіз қазір біздің генералсыз
Dialogue: 0,1:10:24.98,1:10:26.28,Default,,0,0,0,,Сіз бұл жағдайдан аман өтуіңіз керек
Dialogue: 0,1:10:25.09,1:10:29.72,Default-ja,,0,0,0,,Аман бол! Генерал аман қалғанша, «Сұңқар тобы» бітпейді.
Dialogue: 0,1:10:26.82,1:10:29.65,Default,,0,0,0,,Жалпы тірі болғанша, Сұңқар тобы өмір сүреді!
Dialogue: 0,1:10:31.49,1:10:36.09,Default,,0,0,0,,Осылай өлетін сияқтымыз!
Dialogue: 0,1:10:32.39,1:10:35.81,Default-ja,,0,0,0,,Бұл біз үшін ақырғы болуы мүмкін бе?
Dialogue: 0,1:10:36.76,1:10:38.29,Default,,0,0,0,,Абсолютті соңына дейін
Dialogue: 0,1:10:36.89,1:10:41.40,Default-ja,,0,0,0,,Мен соңына дейін күресемін, күресемін және күресемін!
Dialogue: 0,1:10:38.33,1:10:41.23,Default,,0,0,0,,біз күресеміз және күресеміз және одан әрі күресеміз!
Dialogue: 0,1:11:08.80,1:11:11.14,Default-ja,,0,0,0,,Бұл кездесу орны ма...
Dialogue: 0,1:11:08.96,1:11:10.83,Default,,0,0,0,,Бұл кездесу нүктесі
Dialogue: 0,1:11:22.19,1:11:24.23,Default-ja,,0,0,0,,О, жоқ!
Dialogue: 0,1:11:42.00,1:11:47.76,Default-ja,,0,0,0,,Хмф, сіз қайтадан пайда болдыңыз ба? Мың жыл бойы өшімізді алған сенсің.
Dialogue: 0,1:11:43.06,1:11:45.00,Default,,0,0,0,,Сонымен, сіз пайда болдыңыз
Dialogue: 0,1:11:45.13,1:11:47.89,Default,,0,0,0,,Жарайды, сен бізге мың жыл жау болдың
Dialogue: 0,1:11:47.88,1:11:51.47,Default-ja,,0,0,0,,Мен бұл мүмкіндікті өткізіп жіберуге мүмкіндік жоқ деп ойладым.
Dialogue: 0,1:11:47.93,1:11:51.39,Default,,0,0,0,,Мен сенің бұл мүмкіндікті жіберіп алмайтыныңды білдім
Dialogue: 0,1:11:51.87,1:11:55.47,Default,,0,0,0,,Сонымен сендерге қақпаны күзетуге бұйрық берілді
Dialogue: 0,1:11:52.01,1:11:56.47,Default-ja,,0,0,0,,Сен өлмейтін қақпашы болып тағайындалдың.
Dialogue: 0,1:11:55.51,1:11:56.63,Default,,0,0,0,,Өлмейтін
Dialogue: 0,1:11:56.97,1:11:59.94,Default-ja,,0,0,0,,Түскі ас кезіндегі әбігерге қызықпаймын.
Dialogue: 0,1:11:57.04,1:11:59.98,Default,,0,0,0,,Мен көңіл көтергенді ұнатпаймын
Dialogue: 0,1:12:00.01,1:12:03.38,Default,,0,0,0,,Білу керек, менің ескі досым
Dialogue: 0,1:12:00.10,1:12:03.48,Default-ja,,0,0,0,,Білесің бе, ескі жау.
Dialogue: 0,1:12:10.70,1:12:12.16,Default-ja,,0,0,0,,Капитан...
Dialogue: 0,1:12:19.12,1:12:20.25,Default-ja,,0,0,0,,Гухаа
Dialogue: 0,1:12:30.59,1:12:33.18,Default-ja,,0,0,0,,Ахаха... ахахха
Dialogue: 0,1:12:34.93,1:12:39.22,Default-ja,,0,0,0,,Хи хи бұл арман... бұл міндетті түрде арман
Dialogue: 0,1:12:35.81,1:12:37.08,Default,,0,0,0,,Бұл арман
Dialogue: 0,1:12:37.11,1:12:39.05,Default,,0,0,0,,Бұл арман болуы керек
Dialogue: 0,1:12:39.35,1:12:41.69,Default-ja,,0,0,0,,Бұл жай ғана жаман түс
Dialogue: 0,1:12:39.42,1:12:41.61,Default,,0,0,0,,Бұл жаман түс
Dialogue: 0,1:12:41.75,1:12:44.38,Default,,0,0,0,,Мен жай ғана кәдімгі пабта маспын
Dialogue: 0,1:12:41.81,1:12:44.81,Default-ja,,0,0,0,,Мен кәдімгі бардан жаңа ғана ішіп алдым.
Dialogue: 0,1:12:44.92,1:12:47.79,Default,,0,0,0,,Біреу асығыңыз да, мені оятыңыз
Dialogue: 0,1:12:44.94,1:12:48.19,Default-ja,,0,0,0,,Біреу... мені тез оятуыңызды өтінемін.
Dialogue: 0,1:12:49.28,1:12:54.99,Default-ja,,0,0,0,,Джудо Пиппин Рикерт Сіз сондасыз ба?
Dialogue: 0,1:12:49.29,1:12:52.75,Default,,0,0,0,,Юдо Пиппин Рикерт
Dialogue: 0,1:12:53.43,1:12:54.96,Default,,0,0,0,,Сіз сондасыз, солай ма?
Dialogue: 0,1:12:55.37,1:12:58.10,Default,,0,0,0,,Маған көмектесіңізші!
Dialogue: 0,1:12:55.41,1:12:58.20,Default-ja,,0,0,0,,Эй... өтінемін!
Dialogue: 0,1:13:11.58,1:13:13.98,Default,,0,0,0,,Тозақтағы әйел?
Dialogue: 0,1:13:11.97,1:13:13.93,Default-ja,,0,0,0,,Тозақта бір әйел бар...
Dialogue: 0,1:13:16.49,1:13:20.22,Default,,0,0,0,,Маған жақсылық жаса Мені қазір оятпа
Dialogue: 0,1:13:16.51,1:13:19.97,Default-ja,,0,0,0,,Өтінемін, мені қазір оятпа...
Dialogue: 0,1:13:25.60,1:13:31.15,Default-ja,,0,0,0,,Қарғыс атсын, неге мен? Ол... Қарғыс атсын.
Dialogue: 0,1:13:25.63,1:13:27.00,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,1:13:27.06,1:13:31.23,Default,,0,0,0,,Жігіт маған қалай ұнайды? Қарғыс атсын!
Dialogue: 0,1:13:34.74,1:13:38.41,Default-ja,,0,0,0,,Күте тұрыңыз, Гриффит! Мен сені қазір құтқарамын.
Dialogue: 0,1:13:35.01,1:13:36.20,Default,,0,0,0,,Күте тұрыңыз, Гриффит!
Dialogue: 0,1:13:36.54,1:13:38.13,Default,,0,0,0,,Мен сені тез арада ол жерден алып кетемін!
Dialogue: 0,1:13:43.83,1:13:45.37,Default-ja,,0,0,0,,Маған кедергі жасама!
Dialogue: 0,1:13:43.88,1:13:45.47,Default,,0,0,0,,Менің жолымнан кет!
Dialogue: 0,1:13:45.58,1:13:47.98,Default,,0,0,0,,Оны құтқару керек пе? Ондай нәрсе болмайды
Dialogue: 0,1:13:45.62,1:13:50.92,Default-ja,,0,0,0,,Саған көмектескенім дұрыс емес. Бұл адамның өзі қалаған.
Dialogue: 0,1:13:48.19,1:13:50.95,Default,,0,0,0,,Бұл оның тілегі
Dialogue: 0,1:13:51.22,1:13:54.16,Default,,0,0,0,,Сіз де естідіңіз
Dialogue: 0,1:13:51.38,1:13:55.88,Default-ja,,0,0,0,,Сіз оны естідіңіз, мен сенімдімін...
Dialogue: 0,1:13:54.19,1:13:56.09,Default,,0,0,0,,Ол сөзсіз
Dialogue: 0,1:13:56.01,1:13:57.09,Default-ja,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,1:13:56.13,1:13:57.06,Default,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,1:13:58.22,1:14:01.01,Default-ja,,0,0,0,,Оның бұлай айтуы мүмкін емес!
Dialogue: 0,1:13:58.30,1:13:59.59,Default,,0,0,0,,Ол мұны ешқашан айтпайды!
Dialogue: 0,1:13:59.63,1:14:01.16,Default,,0,0,0,,Ол ешқашан!
Dialogue: 0,1:14:01.93,1:14:03.53,Default,,0,0,0,,Гриффит менің
Dialogue: 0,1:14:02.10,1:14:05.44,Default-ja,,0,0,0,,Гриффит менікі... менікі!
Dialogue: 0,1:14:04.27,1:14:05.57,Default,,0,0,0,,Ол менің!
Dialogue: 0,1:14:08.81,1:14:09.77,Default-ja,,0,0,0,,Яһудея
Dialogue: 0,1:14:17.65,1:14:18.67,Default,,0,0,0,,Яһудея!
Dialogue: 0,1:14:17.91,1:14:18.78,Default-ja,,0,0,0,,Дзюдо!
Dialogue: 0,1:14:23.62,1:14:26.95,Default,,0,0,0,,Ақымақ! Жылжыту! Сіз боласыз!
Dialogue: 0,1:14:23.70,1:14:26.21,Default-ja,,0,0,0,,Жолдан кет, ақымақ! Осы қарқынмен сіз!
Dialogue: 0,1:14:31.13,1:14:32.46,Default-ja,,0,0,0,,Неге...
Dialogue: 0,1:14:31.16,1:14:32.32,Default,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,1:14:32.43,1:14:34.09,Default,,0,0,0,,Каска
Dialogue: 0,1:14:32.71,1:14:33.76,Default-ja,,0,0,0,,Каска...
Dialogue: 0,1:14:44.88,1:14:47.04,Default,,0,0,0,,Мен оны пышақпен алдым ба?
Dialogue: 0,1:14:45.06,1:14:47.02,Default-ja,,0,0,0,,Менің пышағымды ұрдың ба?
Dialogue: 0,1:14:47.08,1:14:49.38,Default,,0,0,0,,Иә, сіз оны түсіндіңіз
Dialogue: 0,1:14:47.14,1:14:49.48,Default-ja,,0,0,0,,Әй, маған тиді, өлтірдім.
Dialogue: 0,1:14:52.08,1:14:54.28,Default,,0,0,0,,Енді жүріңіз
Dialogue: 0,1:14:52.11,1:14:54.53,Default-ja,,0,0,0,,Енді... кеттік.
Dialogue: 0,1:14:54.49,1:14:56.01,Default,,0,0,0,,Не айтып тұрсың?!
Dialogue: 0,1:14:54.65,1:14:59.16,Default-ja,,0,0,0,,Не айтып тұрсың! Соңына дейін күресемін деген сен едің!
Dialogue: 0,1:14:56.42,1:14:59.36,Default,,0,0,0,,Сіз ақырына дейін күресеміз дедіңіз!
Dialogue: 0,1:14:59.79,1:15:02.02,Default,,0,0,0,,Сөздеріңізге берік болыңыздар
Dialogue: 0,1:14:59.82,1:15:04.08,Default-ja,,0,0,0,,Айтқаныңыз үшін жауапкершілікті алыңыз! Енді тұр!
Dialogue: 0,1:15:02.39,1:15:03.52,Default,,0,0,0,,Енді, аяққа тұрыңдар!
Dialogue: 0,1:15:05.56,1:15:08.03,Default,,0,0,0,,Ішектерден айырмашылығы, мен нәзікпін
Dialogue: 0,1:15:05.58,1:15:07.91,Default-ja,,0,0,0,,Ішекке қарағанда, ол нәзік...
Dialogue: 0,1:15:08.04,1:15:09.67,Default-ja,,0,0,0,,Аузыңды жаппа!
Dialogue: 0,1:15:08.07,1:15:09.59,Default,,0,0,0,,Дана болып, аузыңды жаппа!
Dialogue: 0,1:15:10.88,1:15:12.88,Default-ja,,0,0,0,,Бұл менің аузым ғана.
Dialogue: 0,1:15:11.07,1:15:12.90,Default,,0,0,0,,Менің жақсы білетінім осы
Dialogue: 0,1:15:13.00,1:15:14.92,Default-ja,,0,0,0,,Аузыңызды мүлде қозғалтыңыз...
Dialogue: 0,1:15:13.94,1:15:16.30,Default,,0,0,0,,- Ауызыңызды қимылдатып үлгерсеңіз - Иә
Dialogue: 0,1:15:15.05,1:15:16.59,Default-ja,,0,0,0,,Шынымен...
Dialogue: 0,1:15:16.34,1:15:18.37,Default,,0,0,0,,- Мен әрқашан мен деп ойлайтынмын - Аяғыңызды жылжытыңыз! Егер сіз жүре алмасаңыз
Dialogue: 0,1:15:16.92,1:15:21.89,Default-ja,,0,0,0,,Мен өзімді шебер адам деп ойладым...
Dialogue: 0,1:15:18.41,1:15:22.74,Default,,0,0,0,,- мұнан гөрі сыпайы сөйлейтін - керек болса, мен сені алып кетемін!
Dialogue: 0,1:15:42.20,1:15:43.22,Default,,0,0,0,,Яһудея
Dialogue: 0,1:15:42.20,1:15:46.16,Default-ja,,0,0,0,,Иуда... Жоқ, мен
Dialogue: 0,1:15:44.37,1:15:46.03,Default,,0,0,0,,Мен мұны істей алмаймын
Dialogue: 0,1:16:58.69,1:17:02.11,Default-ja,,0,0,0,,Бұл қай жерде...
Dialogue: 0,1:16:58.78,1:17:02.04,Default,,0,0,0,,Мен қайдамын?
Dialogue: 0,1:17:04.05,1:17:07.61,Default,,0,0,0,,Олардың барлық өлімі мені тесіп өтуде.
Dialogue: 0,1:17:04.07,1:17:07.53,Default-ja,,0,0,0,,Барлығының өлімі өтіп жатыр...
Dialogue: 0,1:17:11.45,1:17:15.46,Default-ja,,0,0,0,,Біртүрлі, мен ештеңе сезбеймін...
Dialogue: 0,1:17:11.49,1:17:12.58,Default,,0,0,0,,Бұл біртүрлі
Dialogue: 0,1:17:13.59,1:17:15.29,Default,,0,0,0,,Мен ештеңе сезбеймін.
Dialogue: 0,1:17:29.41,1:17:33.54,Default,,0,0,0,,Менің санам естеліктерге толы.
Dialogue: 0,1:17:29.43,1:17:33.69,Default-ja,,0,0,0,,Естеліктер төгіліп жатыр...
Dialogue: 0,1:17:56.77,1:17:57.93,Default,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,1:17:56.79,1:18:00.84,Default-ja,,0,0,0,,Неліктен... Неліктен адамдар...
Dialogue: 0,1:17:59.07,1:18:00.83,Default,,0,0,0,,Адамдар не үшін?
Dialogue: 0,1:18:39.14,1:18:40.37,Default,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,1:18:39.21,1:18:44.59,Default-ja,,0,0,0,,Дұрыс, сондықтан мен...
Dialogue: 0,1:18:41.48,1:18:44.81,Default,,0,0,0,,Сондықтан мен
Dialogue: 0,1:19:50.20,1:19:55.12,Default-ja,,0,0,0,,Біреу жоқ па... Тірі адам жоқ па!
Dialogue: 0,1:19:50.25,1:19:52.24,Default,,0,0,0,,Ешкім қалмады ма?
Dialogue: 0,1:19:53.02,1:19:54.11,Default,,0,0,0,,тірі ме?
Dialogue: 0,1:19:54.18,1:19:55.35,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,1:19:56.52,1:19:57.51,Default,,0,0,0,,Каска!
Dialogue: 0,1:19:56.54,1:19:58.00,Default-ja,,0,0,0,,Каска!
Dialogue: 0,1:19:58.46,1:19:59.45,Default,,0,0,0,,Яһудея!
Dialogue: 0,1:19:58.58,1:20:01.83,Default-ja,,0,0,0,,Дзюдо! Пиппин! Коркас!
Dialogue: 0,1:19:59.79,1:20:01.62,Default,,0,0,0,,Пипин! Коркус!
Dialogue: 0,1:20:02.83,1:20:05.50,Default-ja,,0,0,0,,Команданы кес, жауап бер!
Dialogue: 0,1:20:02.93,1:20:03.92,Default,,0,0,0,,Рейдерлер!
Dialogue: 0,1:20:04.13,1:20:05.36,Default,,0,0,0,,Маған жауап беріңіз!
Dialogue: 0,1:20:23.45,1:20:24.71,Default,,0,0,0,,Гастон
Dialogue: 0,1:20:23.61,1:20:24.73,Default-ja,,0,0,0,,Гастон…
Dialogue: 0,1:20:33.26,1:20:34.42,Default,,0,0,0,,Пиппин!
Dialogue: 0,1:20:33.32,1:20:34.45,Default-ja,,0,0,0,,Пипин!
Dialogue: 0,1:20:46.04,1:20:49.80,Default-ja,,0,0,0,,Пипин! Ол тірі болды ма? Пиппин
Dialogue: 0,1:20:46.07,1:20:48.44,Default,,0,0,0,,Пиппин! Сен тірісің!
Dialogue: 0,1:20:49.04,1:20:49.97,Default,,0,0,0,,Пипин!
Dialogue: 0,1:20:52.22,1:20:55.18,Default-ja,,0,0,0,,Гуфуфу…
Dialogue: 0,1:21:21.47,1:21:23.34,Default,,0,0,0,,Неге сен!
Dialogue: 0,1:21:21.54,1:21:23.54,Default-ja,,0,0,0,,Балалар...
Dialogue: 0,1:21:29.30,1:21:31.88,Default-ja,,0,0,0,,Сіз!
Dialogue: 0,1:21:29.71,1:21:31.71,Default,,0,0,0,,Ей, бейбақтар!
Dialogue: 0,1:21:32.01,1:21:33.26,Default-ja,,0,0,0,,Туу!
Dialogue: 0,1:21:32.02,1:21:33.38,Default,,0,0,0,,Туылу
Dialogue: 0,1:21:33.38,1:21:35.22,Default-ja,,0,0,0,,Бесінші бақытты патша
Dialogue: 0,1:21:33.42,1:21:35.48,Default,,0,0,0,,Бесінші құтты патша
Dialogue: 0,1:21:35.34,1:21:38.35,Default-ja,,0,0,0,,Жаңа жын патшасы
Dialogue: 0,1:21:35.52,1:21:38.58,Default,,0,0,0,,Жаңа жын патшасы!
Dialogue: 0,1:21:38.47,1:21:44.56,Default-ja,,0,0,0,,Артымыздан ерген жын есімді жаңа туыс.
Dialogue: 0,1:21:38.62,1:21:45.22,Default,,0,0,0,,Жамандық киетін жаңа туысымыз
Dialogue: 0,1:21:45.26,1:21:49.29,Default,,0,0,0,,Қараңғылықтың қанаттары Фемто!
Dialogue: 0,1:21:45.31,1:21:49.32,Default-ja,,0,0,0,,Қараңғылық қанаттары Фемто
Dialogue: 0,1:22:44.58,1:22:45.62,Default-ja,,0,0,0,,Гриффи…
Dialogue: 0,1:22:44.59,1:22:45.49,Default,,0,0,0,,Гриф
Dialogue: 0,1:23:36.31,1:23:37.90,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:23:36.34,1:23:37.51,Default-ja,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,1:23:46.89,1:23:49.35,Default-ja,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:23:46.95,1:23:49.08,Default,,0,0,0,,Сен бейбақ! Не істеп жатырсың?!
Dialogue: 0,1:24:06.87,1:24:09.17,Default,,0,0,0,,Grif фитнес?
Dialogue: 0,1:24:06.87,1:24:09.21,Default-ja,,0,0,0,,Gri... fiss?
Dialogue: 0,1:25:07.26,1:25:10.56,Default-ja,,0,0,0,,Риппель Овердрайв Брэфордтың маңдайына жай ғана тиіп өтті ме?
Dialogue: 0,1:25:47.50,1:25:51.53,Default,,0,0,0,,Ақымақ Жай адам не істей алады?
Dialogue: 0,1:25:47.55,1:25:51.68,Default-ja,,0,0,0,,Ақымақ адам не істей алады?
Dialogue: 0,1:25:51.98,1:25:55.38,Default,,0,0,0,,Ол адамзаттан асып түскен болмыс
Dialogue: 0,1:25:52.06,1:25:55.77,Default-ja,,0,0,0,,Ол қазірдің өзінде адамнан артық...
Dialogue: 0,1:26:07.32,1:26:08.57,Default-ja,,0,0,0,,Аһ!
Dialogue: 0,1:26:39.76,1:26:41.12,Default,,0,0,0,,D-Қарамаңыз
Dialogue: 0,1:26:39.81,1:26:41.19,Default-ja,,0,0,0,,Қарама...
Dialogue: 0,1:26:41.29,1:26:42.99,Default,,0,0,0,,Осындай сұлулық
Dialogue: 0,1:26:41.32,1:26:45.03,Default-ja,,0,0,0,,Әдемі... жүрегімді елжіретеді
Dialogue: 0,1:26:43.23,1:26:44.92,Default,,0,0,0,,Бұл менің тынысымды алады
Dialogue: 0,1:26:45.53,1:26:47.72,Default,,0,0,0,,Сүйіспеншілікті жек көру
Dialogue: 0,1:26:45.65,1:26:47.86,Default-ja,,0,0,0,,Махаббат жек көру...
Dialogue: 0,1:26:47.99,1:26:51.45,Default-ja,,0,0,0,,Азап ләззат Өмір Өлім...
Dialogue: 0,1:26:48.23,1:26:51.43,Default,,0,0,0,,Ауырған ләззат өмірлік өлім
Dialogue: 0,1:26:51.53,1:26:53.37,Default,,0,0,0,,Барлығы бар
Dialogue: 0,1:26:51.62,1:26:53.20,Default-ja,,0,0,0,,Онда бәрі бар
Dialogue: 0,1:26:53.57,1:26:55.37,Default,,0,0,0,,Бұл адам болу керек
Dialogue: 0,1:26:53.58,1:26:57.29,Default-ja,,0,0,0,,Мынау адам, мынау жын
Dialogue: 0,1:26:55.51,1:26:57.30,Default,,0,0,0,,Бұл зұлымдық
Dialogue: 0,1:27:49.68,1:27:50.93,Default-ja,,0,0,0,,Екінші жартысында басқалар әлсіреп жатқанда, олар өздерінің көз тартымды Квиркімен жауды өздеріне тартты ➡
Dialogue: 0,1:28:47.73,1:28:53.91,Default-ja,,0,0,0,,Kyohoho… Қызық! бұл күтпеген жағдай
Dialogue: 0,1:28:50.42,1:28:51.75,Default,,0,0,0,,Қызық!
Dialogue: 0,1:28:52.06,1:28:53.89,Default,,0,0,0,,Қандай күтпеген!
Dialogue: 0,1:28:54.53,1:29:00.16,Default-ja,,0,0,0,,Ухуху... Бәрін көру мүмкін емес.
Dialogue: 0,1:28:56.39,1:28:59.95,Default,,0,0,0,,Біз бәрін болжай алмаймыз
Dialogue: 0,1:29:00.26,1:29:03.96,Default,,0,0,0,,Өйткені, біз құдай емеспіз
Dialogue: 0,1:29:00.33,1:29:04.13,Default-ja,,0,0,0,,Өйткені біз де Құдай емеспіз...
Dialogue: 0,1:29:05.04,1:29:10.97,Default-ja,,0,0,0,,Әлде Void, бұл да сіздің алдын ала белгіленген тағдырларыңыздың бірі ме?
Dialogue: 0,1:29:05.20,1:29:06.90,Default,,0,0,0,,Бірақ жарамсыз
Dialogue: 0,1:29:07.34,1:29:10.74,Default,,0,0,0,,Бұл да тағдырға жазылған ба?
Dialogue: 0,1:29:28.99,1:29:29.98,Default,,0,0,0,,Каска?!
Dialogue: 0,1:29:29.02,1:29:31.07,Default-ja,,0,0,0,,Каска! ? батыл! ?
Dialogue: 0,1:29:30.03,1:29:31.05,Default,,0,0,0,,Ащы?!
Dialogue: 0,1:29:32.23,1:29:33.96,Default,,0,0,0,,Кез келген жағдайда
Dialogue: 0,1:29:32.40,1:29:37.70,Default-ja,,0,0,0,,Қалай болғанда да, уақыт өте бастады.
Dialogue: 0,1:29:34.30,1:29:37.46,Default,,0,0,0,,Уақыт өте бастады
Dialogue: 0,1:29:38.40,1:29:43.14,Default,,0,0,0,,Бесінші періште дүниеге келді
Dialogue: 0,1:29:38.45,1:29:43.25,Default-ja,,0,0,0,,Бесінші періште дүниеге келді...
Dialogue: 0,1:29:43.74,1:29:47.40,Default,,0,0,0,,Қараңғылық мезгілі басылады
Dialogue: 0,1:29:43.75,1:29:47.04,Default-ja,,0,0,0,,Қараңғылық мезгілі келеді
Dialogue: 0,1:29:47.67,1:29:52.38,Default-ja,,0,0,0,,Барлық қараңғылық жарықтан асып түсетін уақыт
Dialogue: 0,1:29:47.68,1:29:52.41,Default,,0,0,0,,Әр қараңғылық жарықты тұтатын заман
Dialogue: 0,1:29:52.85,1:29:56.18,Default,,0,0,0,,Уақыт өте келе адам мұны атайды
Dialogue: 0,1:29:52.97,1:29:56.14,Default-ja,,0,0,0,,Кейінірек адамдар оны осылай атайтын
Dialogue: 0,1:29:56.97,1:30:00.22,Default-ja,,0,0,0,,Зұлмат ғасырлар және
Dialogue: 0,1:29:56.99,1:29:59.22,Default,,0,0,0,,Қараңғылық дәуірі
Dialogue: 0,1:30:30.09,1:30:32.68,Default,,0,0,0,,Әй, бәрің қайда бара жатырсыңдар?
Dialogue: 0,1:30:30.09,1:30:32.80,Default-ja,,0,0,0,,Бәрің қайда бара жатырсыңдар?
Dialogue: 0,1:30:33.62,1:30:34.52,Default,,0,0,0,,Яһудея!
Dialogue: 0,1:30:33.63,1:30:36.76,Default-ja,,0,0,0,,Дзюдо! Эй, тоқта!
Dialogue: 0,1:30:35.26,1:30:36.62,Default,,0,0,0,,Эй, тоқта!
Dialogue: 0,1:30:38.18,1:30:40.30,Default-ja,,0,0,0,,Барма!
Dialogue: 0,1:30:38.19,1:30:39.29,Default,,0,0,0,,Барма!
Dialogue: 0,1:30:43.10,1:30:44.98,Default-ja,,0,0,0,,Коркас! Пиппин!
Dialogue: 0,1:30:43.13,1:30:44.66,Default,,0,0,0,,Коркус! Пиппин!
Dialogue: 0,1:30:47.23,1:30:49.77,Default-ja,,0,0,0,,Жоқ! Артқа бұрыл!
Dialogue: 0,1:30:47.24,1:30:48.10,Default,,0,0,0,,(Тик-так, сағаттың көрсеткіштері тик-так)
Dialogue: 0,1:30:48.57,1:30:49.63,Default,,0,0,0,,Қайтып кел!
Dialogue: 0,1:30:52.74,1:30:55.74,Default,,0,0,0,,Барма!
Dialogue: 0,1:30:52.78,1:30:55.44,Default-ja,,0,0,0,,Барма!
Dialogue: 0,1:31:32.65,1:31:34.91,Default,,0,0,0,,Ішім! Сен тұрдың
Dialogue: 0,1:31:32.65,1:31:34.86,Default-ja,,0,0,0,,Ішім! Сіз ояндыңыз.
Dialogue: 0,1:31:34.98,1:31:35.99,Default-ja,,0,0,0,,Рикерт...?
Dialogue: 0,1:31:35.28,1:31:36.27,Default,,0,0,0,,Рикерт?
Dialogue: 0,1:31:36.11,1:31:39.99,Default-ja,,0,0,0,,Жақсы, мен жаман болады деп ойладым.
Dialogue: 0,1:31:36.39,1:31:39.72,Default,,0,0,0,,Құдайға шүкір, сен үлгермейді деп ойладым
Dialogue: 0,1:31:40.16,1:31:43.12,Default-ja,,0,0,0,,Төрт күн бойы мүлде қозғалмады...
Dialogue: 0,1:31:40.19,1:31:42.59,Default,,0,0,0,,Төрт күн бойы қозғалмадың немесе көзіңді жыпылықтадың
Dialogue: 0,1:31:44.83,1:31:46.00,Default-ja,,0,0,0,,Бұл қайда?
Dialogue: 0,1:31:44.93,1:31:45.95,Default,,0,0,0,,Мен қайдамын?
Dialogue: 0,1:31:46.36,1:31:48.30,Default,,0,0,0,,Менің үйімнің жанындағы төбелер
Dialogue: 0,1:31:46.45,1:31:49.92,Default-ja,,0,0,0,,Менің артымдағы тауда. Ол Кордо деп аталады.
Dialogue: 0,1:31:48.56,1:31:50.09,Default,,0,0,0,,Бұл жер Кенді үңгір деп аталады
Dialogue: 0,1:31:50.04,1:31:53.17,Default-ja,,0,0,0,,Торнадо не болды?
Dialogue: 0,1:31:50.13,1:31:53.00,Default,,0,0,0,,Торнадо ішінде не болды?
Dialogue: 0,1:31:55.63,1:31:57.17,Default-ja,,0,0,0,,Торнадо...?
Dialogue: 0,1:31:55.71,1:31:56.87,Default,,0,0,0,,Торнадо?
Dialogue: 0,1:32:00.11,1:32:01.10,Default,,0,0,0,,Айтыңыз
Dialogue: 0,1:32:00.13,1:32:04.01,Default-ja,,0,0,0,,Эй, Гриффитті құтқару не болды?
Dialogue: 0,1:32:01.48,1:32:03.84,Default,,0,0,0,,Гриффиттің құтқарылуына не болды?
Dialogue: 0,1:32:04.51,1:32:07.27,Default-ja,,0,0,0,,Қандай жарақат болды? Ал қалғандары ше?
Dialogue: 0,1:32:04.61,1:32:06.91,Default,,0,0,0,,Қалай жарақат алдыңыз? Барлығына не болды?
Dialogue: 0,1:32:07.64,1:32:10.35,Default-ja,,0,0,0,,Әй, не болды?
Dialogue: 0,1:32:07.65,1:32:09.62,Default,,0,0,0,,Маған не болғанын айт!
Dialogue: 0,1:32:12.27,1:32:14.52,Default-ja,,0,0,0,,Каска... Каска қайда!
Dialogue: 0,1:32:12.29,1:32:14.15,Default,,0,0,0,,Каска Каска қайда?!
Dialogue: 0,1:32:15.69,1:32:17.53,Default-ja,,0,0,0,,Каска... Каска...
Dialogue: 0,1:32:16.16,1:32:17.49,Default,,0,0,0,,С-Каска жақсы
Dialogue: 0,1:32:18.03,1:32:20.86,Default-ja,,0,0,0,,Каска-нечан сол жерде.
Dialogue: 0,1:32:18.09,1:32:20.50,Default,,0,0,0,,Каска сол жерде
Dialogue: 0,1:32:44.59,1:32:45.56,Default,,0,0,0,,Каска
Dialogue: 0,1:32:44.64,1:32:45.76,Default-ja,,0,0,0,,Каска...
Dialogue: 0,1:32:57.70,1:32:59.46,Default,,0,0,0,,Бұл менмін
Dialogue: 0,1:32:57.73,1:32:59.36,Default-ja,,0,0,0,,Бұл менмін, Ішек.
Dialogue: 0,1:32:59.49,1:33:00.44,Default-ja,,0,0,0,,Жоқ!
Dialogue: 0,1:32:59.50,1:33:01.20,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:33:08.37,1:33:12.71,Default-ja,,0,0,0,,Эй... қалжыңдама, бітті, Каска.
Dialogue: 0,1:33:08.38,1:33:10.40,Default,,0,0,0,,Эй, алдауды доғар
Dialogue: 0,1:33:10.78,1:33:12.48,Default,,0,0,0,,Бәрі Касканың үстінде!
Dialogue: 0,1:33:13.32,1:33:15.65,Default,,0,0,0,,Біз ол жерден шығып, аман қалдық!
Dialogue: 0,1:33:13.42,1:33:16.25,Default-ja,,0,0,0,,Біз ол жерден тірі қайттық! Каска
Dialogue: 0,1:33:15.69,1:33:16.48,Default,,0,0,0,,Каска!
Dialogue: 0,1:33:25.26,1:33:26.89,Default,,0,0,0,,Онда, сонда
Dialogue: 0,1:33:25.26,1:33:29.89,Default-ja,,0,0,0,,Ей, сен қорқынышты жігітсің.
Dialogue: 0,1:33:27.23,1:33:29.32,Default,,0,0,0,,Қандай қорқынышты адам, а?
Dialogue: 0,1:33:30.39,1:33:34.14,Default-ja,,0,0,0,,Жоқ, Ішек, сен Касканы қорлай алмайсың.
Dialogue: 0,1:33:30.53,1:33:31.90,Default,,0,0,0,,Бұзық, Ішек
Dialogue: 0,1:33:31.93,1:33:33.96,Default,,0,0,0,,Касканы қорламаңыз
Dialogue: 0,1:33:36.01,1:33:37.44,Default,,0,0,0,,Ол есінде жоқ
Dialogue: 0,1:33:36.06,1:33:37.77,Default-ja,,0,0,0,,есімде жоқ.
Dialogue: 0,1:33:38.41,1:33:40.67,Default,,0,0,0,,Сен де, мен де емес
Dialogue: 0,1:33:38.44,1:33:40.86,Default-ja,,0,0,0,,Ішек туралы және мен туралы
Dialogue: 0,1:33:41.58,1:33:43.74,Default,,0,0,0,,Ол оянғаннан бері солай
Dialogue: 0,1:33:41.61,1:33:43.82,Default-ja,,0,0,0,,Мен оянғаннан бері осылай болды.
Dialogue: 0,1:33:46.12,1:33:49.21,Default,,0,0,0,,Міне, бәрі жақсы
Dialogue: 0,1:33:46.16,1:33:49.16,Default-ja,,0,0,0,,Әй, балақай, жарайды...
Dialogue: 0,1:33:52.87,1:33:55.00,Default-ja,,0,0,0,,Иә... Балақай
Dialogue: 0,1:33:52.89,1:33:54.88,Default,,0,0,0,,Мен жақсы қыз барын білемін
Dialogue: 0,1:34:02.40,1:34:03.53,Default,,0,0,0,,Мен күлкілі болып көрінемін бе?
Dialogue: 0,1:34:02.46,1:34:03.47,Default-ja,,0,0,0,,Жаттығуға жарайды, білесің бе.
Dialogue: 0,1:34:04.05,1:34:04.72,Default-ja,,0,0,0,,Сіз
Dialogue: 0,1:34:04.07,1:34:06.09,Default,,0,0,0,,Қарғыс атсын! Сен кінәлісің!
Dialogue: 0,1:34:04.97,1:34:06.14,Default-ja,,0,0,0,,Бұл сен кінәлі
Dialogue: 0,1:34:06.40,1:34:07.93,Default,,0,0,0,,Қылышыңды тарт!
Dialogue: 0,1:34:06.43,1:34:07.47,Default-ja,,0,0,0,,Қылыштан шығыңыз!
Dialogue: 0,1:34:07.85,1:34:09.22,Default-ja,,0,0,0,,Баркер…
Dialogue: 0,1:34:07.97,1:34:09.27,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:35:33.68,1:35:38.60,Default-ja,,0,0,0,,Уау!
Dialogue: 0,1:36:25.15,1:36:28.53,Default-ja,,0,0,0,,Көз... менің...
Dialogue: 0,1:36:35.37,1:36:36.41,Default-ja,,0,0,0,,Не?
Dialogue: 0,1:36:35.38,1:36:36.51,Default,,0,0,0,,Сабаққа қатыса алмайтыны үшін оған ерекше қарайды...
Dialogue: 0,1:36:42.58,1:36:47.80,Default-ja,,0,0,0,,Бұл бауыр... Бұл менікі Ни... Ние...
Dialogue: 0,1:37:23.97,1:37:25.20,Default,,0,0,0,,Бұл жалғыздықты тек шыңға шыққандар ғана түсіне алады
Dialogue: 0,1:37:24.04,1:37:25.00,Default-ja,,0,0,0,,Дионы жеңуге арналған бұл сапар—
Dialogue: 0,1:37:25.97,1:37:27.40,Default,,0,0,0,,Кет!
Dialogue: 0,1:37:26.46,1:37:27.50,Default-ja,,0,0,0,,Тоқта!
Dialogue: 0,1:37:33.93,1:37:37.47,Default-ja,,0,0,0,,Мықты бол! Әйтпесе өлтіресің.
Dialogue: 0,1:37:33.98,1:37:35.38,Default,,0,0,0,,Өзіңіз болат жасаңыз
Dialogue: 0,1:37:35.41,1:37:37.21,Default,,0,0,0,,Әйтпесе, жеп кетесің
Dialogue: 0,1:37:45.35,1:37:51.19,Default-ja,,0,0,0,,Құрбандық маркасы... қараңғыларды тартады.
Dialogue: 0,1:37:45.42,1:37:47.58,Default,,0,0,0,,Құрбандық белгісі
Dialogue: 0,1:37:47.86,1:37:50.99,Default,,0,0,0,,соған тартады, қараңғылықтар
Dialogue: 0,1:37:52.03,1:37:56.59,Default,,0,0,0,,Сіздің денеңіз және қанның әрбір тамшысы
Dialogue: 0,1:37:52.03,1:37:56.53,Default-ja,,0,0,0,,Сіздің денеңіз, тіпті соңғы тамшы қаныңыз...
Dialogue: 0,1:37:56.80,1:38:00.86,Default,,0,0,0,,қараңғылықтарға тарту ретінде берілді
Dialogue: 0,1:37:56.87,1:38:01.20,Default-ja,,0,0,0,,Мұның бәрі қараңғыға құрбандық.
Dialogue: 0,1:38:01.70,1:38:05.79,Default-ja,,0,0,0,,Бұл таңбаланғандардың ережесі.
Dialogue: 0,1:38:01.74,1:38:04.26,Default,,0,0,0,,Солардың тағдыры солай
Dialogue: 0,1:38:04.31,1:38:06.28,Default,,0,0,0,,Құрбандық белгісін алатындар
Dialogue: 0,1:38:31.83,1:38:34.13,Default,,0,0,0,,Күресші
Dialogue: 0,1:38:31.98,1:38:34.15,Default-ja,,0,0,0,,Күресетіндер...
Dialogue: 0,1:38:44.83,1:38:50.50,Default-ja,,0,0,0,,Қысқасы, бұл соғыс. Әдеттегіден ештеңе өзгерген жоқ...
Dialogue: 0,1:38:44.88,1:38:47.18,Default,,0,0,0,,Демек, бұл тағы бір шайқас дегенді білдіреді
Dialogue: 0,1:38:47.78,1:38:50.28,Default,,0,0,0,,Бұрынғыдан ештеңе өзгерген жоқ
Dialogue: 0,1:38:51.21,1:38:52.09,Default-ja,,0,0,0,,Ештеңе!
Dialogue: 0,1:38:51.32,1:38:52.12,Default,,0,0,0,,Ештеңе
Dialogue: 0,1:38:57.59,1:39:00.64,Default-ja,,0,0,0,,Бұл жолы Касканы өзіңізбен бірге алып кетуіңіз керек.
Dialogue: 0,1:38:57.63,1:39:00.62,Default,,0,0,0,,Бірақ бұл жолы. Касканы өзіңізбен бірге алыңыз.
Dialogue: 0,1:39:02.93,1:39:05.81,Default-ja,,0,0,0,,Ке! Хитокири ақымақ осында!
Dialogue: 0,1:39:02.97,1:39:05.53,Default,,0,0,0,,Міне, ол. қанқұмар!
Dialogue: 0,1:39:07.87,1:39:10.60,Default,,0,0,0,,Егер сіз Гриффитке тең болсаңыз
Dialogue: 0,1:39:07.94,1:39:12.11,Default-ja,,0,0,0,,Егер сіз Гриффитпен тең болсаңыз, оның досы болсаңыз...
Dialogue: 0,1:39:10.97,1:39:12.17,Default,,0,0,0,,Егер сіз оның досы болсаңыз
Dialogue: 0,1:39:14.90,1:39:16.65,Default-ja,,0,0,0,,Мен жалғыз баруым керек
Dialogue: 0,1:39:14.91,1:39:16.47,Default,,0,0,0,,Бару керек. жалғыз болса да.
Dialogue: 0,1:39:51.65,1:39:55.68,Default,,0,0,0,,Бұл кім жылап тұр?
Dialogue: 0,1:39:51.65,1:39:53.02,Default-ja,,0,0,0,,Бұл кім?
Dialogue: 0,1:39:54.15,1:39:57.82,Default-ja,,0,0,0,,Кім жылап жатыр?
Dialogue: 0,1:39:56.65,1:39:57.78,Default,,0,0,0,,Кім?
Dialogue: 0,1:40:04.63,1:40:05.86,Default,,0,0,0,,Көз жасы?
Dialogue: 0,1:40:04.66,1:40:05.91,Default-ja,,0,0,0,,Көз жасы?
Dialogue: 0,1:40:07.93,1:40:09.73,Default,,0,0,0,,Соңғысы
Dialogue: 0,1:40:07.95,1:40:10.08,Default-ja,,0,0,0,,Мен оны тастадым ...
Dialogue: 0,1:40:12.67,1:40:14.23,Default,,0,0,0,,Мен тастадым.
Dialogue: 0,1:40:12.71,1:40:14.38,Default-ja,,0,0,0,,Соңғы...
Dialogue: 0,1:40:22.55,1:40:27.31,Default-ja,,0,0,0,,Ха ха ха ха
Dialogue: 0,1:40:28.81,1:40:34.81,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory