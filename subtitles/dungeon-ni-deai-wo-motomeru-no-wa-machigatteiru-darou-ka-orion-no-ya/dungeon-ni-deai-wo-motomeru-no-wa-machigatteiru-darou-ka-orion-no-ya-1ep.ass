Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:50.67,0:00:52.34,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:00:55.59,0:00:57.68,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:01.93,0:01:04.18,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:04.68,0:01:06.44,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:11.07,0:01:12.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:51.73,0:01:53.07,Default,,0,0,0,,Баяғыда
Dialogue: 0,0:01:53.90,0:01:56.78,Default,,0,0,0,,Сіз «балалар» тұратын жерде біз «құдайлар» тұрамыз.
Dialogue: 0,0:01:56.90,0:02:00.28,Default,,0,0,0,,Мен ынталандыруды іздеу үшін осы төменгі әлемге түстім.
Dialogue: 0,0:02:01.49,0:02:03.41,Default,,0,0,0,,Біз шештік
Dialogue: 0,0:02:04.37,0:02:08.29,Default,,0,0,0,,Мына дүниеде сенімен мәңгі өмір сүргім келеді.
Dialogue: 0,0:02:09.46,0:02:11.25,Default,,0,0,0,,Құдайдың құдіретін бекітіңіз -
Dialogue: 0,0:02:11.67,0:02:15.92,Default,,0,0,0,,Қолайсыздық пен ыңғайсыздықтың ортасында, бақытты өмір сүруге тырысыңыз.
Dialogue: 0,0:02:17.76,0:02:19.88,Default,,0,0,0,,Кейбіреулер төменгі әлемде ойын-сауық іздейді.
Dialogue: 0,0:02:22.18,0:02:24.47,Default,,0,0,0,,Кейбіреулер батырларды іздейді
Dialogue: 0,0:02:31.90,0:02:32.90,Default,,0,0,0,,Және…
Dialogue: 0,0:02:36.90,0:02:39.28,Default,,0,0,0,,Кейбіреулер құтқарылуды іздейді
Dialogue: 0,0:02:54.00,0:02:55.59,Default,,0,0,0,,Жарайды, мм.
Dialogue: 0,0:02:55.92,0:02:59.42,Default,,0,0,0,,Уау, мен кешігіп қалдым. Толық емес жұмыс уақытыма кешігіп қалдым.
Dialogue: 0,0:02:59.92,0:03:03.18,Default,,0,0,0,,Неге мені оятпадың? Белл-кун
Dialogue: 0,0:03:03.55,0:03:05.76,Default,,0,0,0,,Мен сені талай рет ояттым.
Dialogue: 0,0:03:06.89,0:03:08.89,Default,,0,0,0,,Мистер Белл, иә?
Dialogue: 0,0:03:10.31,0:03:11.35,Default,,0,0,0,,Мен бар күшімді саламын.
Dialogue: 0,0:03:14.81,0:03:15.69,Default,,0,0,0,,Иә
Dialogue: 0,0:03:16.11,0:03:17.82,Default,,0,0,0,,Мен келе жатырмын, Құдай.
Dialogue: 0,0:03:19.61,0:03:21.99,Default,,0,0,0,,А... Мен де асығуым керек.
Dialogue: 0,0:03:33.33,0:03:35.38,Default,,0,0,0,,Әй, авантюрист, бұл зындан ба?
Dialogue: 0,0:03:35.50,0:03:36.34,Default,,0,0,0,,Иә
Dialogue: 0,0:03:36.67,0:03:38.09,Default,,0,0,0,,Бүгін тағы да таң атты.
Dialogue: 0,0:03:38.67,0:03:39.84,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:40.13,0:03:41.26,Default,,0,0,0,,Мұны өзіңізбен бірге алыңыз.
Dialogue: 0,0:03:42.13,0:03:43.34,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:43.47,0:03:45.68,Default,,0,0,0,,Әй, кішкентай жаңадан келген бала. (Бала) Қайырлы таң.
Dialogue: 0,0:03:45.93,0:03:47.10,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:47.22,0:03:49.56,Default,,0,0,0,,Сәттілік, рахмет
Dialogue: 0,0:03:51.48,0:03:52.39,Default,,0,0,0,,Силл мырза
Dialogue: 0,0:03:52.85,0:03:54.31,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:54.73,0:03:56.52,Default,,0,0,0,,Иә, бүгінгі түскі ас қорабы.
Dialogue: 0,0:03:57.07,0:03:58.19,Default,,0,0,0,,Мен әрқашан кешірім сұраймын
Dialogue: 0,0:03:58.32,0:04:00.74,Default,,0,0,0,,Фуня Рю, сен қайда бардың?
Dialogue: 0,0:04:00.90,0:04:02.90,Default,,0,0,0,,Осы қарбалас уақытта
Dialogue: 0,0:04:03.03,0:04:03.95,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:04:04.53,0:04:06.87,Default,,0,0,0,,А, тәрелке...
Dialogue: 0,0:04:06.99,0:04:07.49,Default,,0,0,0,,Аня, не істеп жатырсың?
Dialogue: 0,0:04:07.49,0:04:09.33,Default,,0,0,0,,Рю мырза, сіз сонда емессіз бе?
Dialogue: 0,0:04:07.49,0:04:09.33,Default,,0,0,0,,Аня, не істеп жатырсың?
Dialogue: 0,0:04:09.45,0:04:12.16,Default,,0,0,0,,Иә, ол шығып жатыр деп ойлаймын.
Dialogue: 0,0:04:12.54,0:04:14.87,Default,,0,0,0,,Мистер Белл, сіз бірдеңе білесіз бе?
Dialogue: 0,0:04:15.00,0:04:16.67,Default,,0,0,0,,Жоқ, менде ештеңе жоқ.
Dialogue: 0,0:04:16.92,0:04:18.13,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:04:18.25,0:04:21.05,Default,,0,0,0,,Жарайды, сені көрсем, шақырамын.
Dialogue: 0,0:04:21.34,0:04:22.88,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:04:23.01,0:04:23.97,Default,,0,0,0,,Иә
Dialogue: 0,0:04:26.47,0:04:27.68,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:04:31.85,0:04:33.27,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:04:33.39,0:04:35.14,Default,,0,0,0,,Ах, Белл-кун.
Dialogue: 0,0:04:35.27,0:04:36.85,Default,,0,0,0,,Сіз не істеп жатырсыз? Эйна-сан
Dialogue: 0,0:04:37.19,0:04:38.98,Default,,0,0,0,,Бүгінгі кешкі фестивальге дайындық
Dialogue: 0,0:04:39.19,0:04:41.15,Default,,0,0,0,,Сен зындандасың ба, Белл? иә
Dialogue: 0,0:04:41.28,0:04:42.44,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:04:42.74,0:04:44.90,Default,,0,0,0,,Авантюристер... «Шытырман оқиғаға бармаңыз»
Dialogue: 0,0:04:45.03,0:04:47.24,Default,,0,0,0,,Не? Мен түсінемін
Dialogue: 0,0:04:47.91,0:04:48.87,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:04:58.33,0:04:59.21,Default,,0,0,0,,Лили Уэлф
Dialogue: 0,0:04:59.34,0:05:01.50,Default,,0,0,0,,Эй, сен мұндасың, Белл-сама.
Dialogue: 0,0:05:02.71,0:05:04.63,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:05:05.26,0:05:07.43,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:05:08.64,0:05:09.76,Default,,0,0,0,,Зындандаға
Dialogue: 0,0:05:32.91,0:05:33.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:38.37,0:05:39.33,Default,,0,0,0,,Жақсылық
Dialogue: 0,0:05:39.83,0:05:41.46,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:05:43.67,0:05:45.17,Default,,0,0,0,,Хэхе... Өтінемін, жат.
Dialogue: 0,0:05:48.76,0:05:52.18,Default,,0,0,0,,Сен онсыз да бейқамсың, Уэльф-сама.
Dialogue: 0,0:05:52.31,0:05:54.64,Default,,0,0,0,,Хаха... жаман
Dialogue: 0,0:05:55.10,0:05:56.48,Default,,0,0,0,,Айтпақшы, мистер Белл
Dialogue: 0,0:05:56.77,0:05:57.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:57.73,0:06:00.23,Default,,0,0,0,,Бүгін кешке фестивальге барасыз ба?
Dialogue: 0,0:06:00.44,0:06:01.86,Default,,0,0,0,,Иә, бұл менің ниетім.
Dialogue: 0,0:06:01.98,0:06:04.53,Default,,0,0,0,,Олай болса, Лилиге қосылуға рұқсат етіңіз.
Dialogue: 0,0:06:04.65,0:06:07.49,Default,,0,0,0,,Әрине, Уэлф ше?
Dialogue: 0,0:06:07.74,0:06:10.87,Default,,0,0,0,,Мен аздап көп ақша табуым керек пе?
Dialogue: 0,0:06:11.49,0:06:13.33,Default,,0,0,0,,Иә, келісемін.
Dialogue: 0,0:06:13.45,0:06:14.29,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:06:20.83,0:06:23.21,Default,,0,0,0,,Қашып шығу үшін
Dialogue: 0,0:06:25.96,0:06:28.88,Default,,0,0,0,,Уау~ Бұл керемет
Dialogue: 0,0:06:31.76,0:06:35.10,Default,,0,0,0,,Екеуіңіз де Камизуки фестиваліне бірінші рет қатысып отырсыз, солай емес пе?
Dialogue: 0,0:06:35.72,0:06:37.56,Default,,0,0,0,,Құдайдың ай мерекесі? иә
Dialogue: 0,0:06:38.10,0:06:42.52,Default,,0,0,0,,Бұл құдайлар түскенге дейін өткізілетін мереке күні.
Dialogue: 0,0:06:43.23,0:06:45.44,Default,,0,0,0,,Айдың құдайға ұқсайтынына сенімдімін.
Dialogue: 0,0:06:45.57,0:06:48.44,Default,,0,0,0,,Құбыжықтар құрсауынан аман қалуыңды сұраймын... Солай ма?
Dialogue: 0,0:06:48.86,0:06:51.36,Default,,0,0,0,,Бұл да төменгі дүние мәдениетінің бір бөлігі.
Dialogue: 0,0:06:51.49,0:06:54.28,Default,,0,0,0,,Авантюристер жиналатын Орариоға ұқсайды.
Dialogue: 0,0:06:54.41,0:06:55.74,Default,,0,0,0,,Белл, кальмарды грильде пісіріп жейік
Dialogue: 0,0:06:55.74,0:06:57.08,Default,,0,0,0,,Белл-кун Грильде пісірілген кальмар жейміз Грильде пісірілген кальмар
Dialogue: 0,0:06:55.74,0:06:57.08,Default,,0,0,0,,Қақа... Құдай
Dialogue: 0,0:06:57.20,0:06:57.62,Default,,0,0,0,,Эй... тек тартпа.
Dialogue: 0,0:06:57.62,0:06:59.83,Default,,0,0,0,,Уф
Dialogue: 0,0:06:57.62,0:06:59.83,Default,,0,0,0,,Эй... тек тартпа.
Dialogue: 0,0:07:02.71,0:07:04.63,Default,,0,0,0,,Гестия-сама, иә?
Dialogue: 0,0:07:05.04,0:07:06.71,Default,,0,0,0,,Ерекше фестиваль болса да
Dialogue: 0,0:07:06.84,0:07:09.51,Default,,0,0,0,,Джагамару-кунды сатқыңыз келмейтініне сенімдісіз бе?
Dialogue: 0,0:07:09.67,0:07:11.30,Default,,0,0,0,,Ақша табудың уақыты келген жоқ па?
Dialogue: 0,0:07:11.43,0:07:16.39,Default,,0,0,0,,Бір ұры мысық менің Беллімді азғырғысы келетін сияқты.
Dialogue: 0,0:07:16.51,0:07:19.18,Default,,0,0,0,,Мен жерде отырып, үзіліс жасап жатырмын.
Dialogue: 0,0:07:19.98,0:07:21.64,Default,,0,0,0,,Ұры мысық кім!?
Dialogue: 0,0:07:22.15,0:07:24.23,Default,,0,0,0,,Гестияның да құдай болғаны жақсы.
Dialogue: 0,0:07:24.36,0:07:27.82,Default,,0,0,0,,Сен Белл-самаға анау-мынаны істеп жатырсың, солай емес пе?
Dialogue: 0,0:07:27.94,0:07:30.11,Default,,0,0,0,,Не!? Не?
Dialogue: 0,0:07:30.24,0:07:31.07,Default,,0,0,0,,Гунуну…
Dialogue: 0,0:07:31.20,0:07:34.32,Default,,0,0,0,,А... екеуміз де осындай жерде ұрысып жатырмыз...
Dialogue: 0,0:07:34.57,0:07:35.78,Default,,0,0,0,,Уэльфке де көмектесіңізші.
Dialogue: 0,0:07:36.16,0:07:38.74,Default,,0,0,0,,Жарайды, такояки жейміз. Такояки
Dialogue: 0,0:07:38.87,0:07:39.70,Default,,0,0,0,,Жақсылық
Dialogue: 0,0:07:39.83,0:07:42.50,Default,,0,0,0,,Кәне, танысайық.
Dialogue: 0,0:07:42.71,0:07:46.59,Default,,0,0,0,,Алыстағылар дыбысты естиді, жақындағылар көреді.
Dialogue: 0,0:07:46.79,0:07:48.17,Default,,0,0,0,,Бұл дауыс...
Dialogue: 0,0:07:48.30,0:07:52.43,Default,,0,0,0,,Ал егер сен шеберлігі бар авантюрист болсаң, алға шық.
Dialogue: 0,0:07:52.63,0:07:55.93,Default,,0,0,0,,Енді мына найзаны суырып алатын батыр кім?
Dialogue: 0,0:07:56.26,0:07:58.89,Default,,0,0,0,,Не істеп жатырсың, Гермес?
Dialogue: 0,0:07:59.31,0:08:02.85,Default,,0,0,0,,Бұл таңдаулылар ғана ұстай алатын аты аңызға айналған найза.
Dialogue: 0,0:08:03.48,0:08:04.56,Default,,0,0,0,,Қолында барларға
Dialogue: 0,0:08:04.69,0:08:07.77,Default,,0,0,0,,Пәк тәңірінің баталары уәде етіледі.
Dialogue: 0,0:08:07.90,0:08:12.70,Default,,0,0,0,,Сонымен қатар, жетістікке жеткендер әлемдік көрікті жерлерді тамашалау турына шақырылады.
Dialogue: 0,0:08:12.82,0:08:15.36,Default,,0,0,0,,Гильдия мақұлдаған!
Dialogue: 0,0:08:15.66,0:08:18.33,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:18.70,0:08:20.29,Default,,0,0,0,,Аңызға айналған найза?
Dialogue: 0,0:08:20.41,0:08:24.04,Default,,0,0,0,,Лорд Гермес тағы да күдікті оқиғаны өткізіп жатыр.
Dialogue: 0,0:08:24.33,0:08:26.42,Default,,0,0,0,,Бірақ бұл қызықты емес пе?
Dialogue: 0,0:08:26.58,0:08:28.34,Default,,0,0,0,,Байқап көрейік, Белл-кун.
Dialogue: 0,0:08:28.46,0:08:29.71,Default,,0,0,0,,Иә
Dialogue: 0,0:08:30.34,0:08:31.96,Default,,0,0,0,,Біз де жасап көрейік
Dialogue: 0,0:08:32.17,0:08:33.26,Default,,0,0,0,,Мистер Эйс
Dialogue: 0,0:08:33.38,0:08:35.18,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:08:36.59,0:08:38.14,Default,,0,0,0,,Ах~
Dialogue: 0,0:08:38.26,0:08:40.06,Default,,0,0,0,,Ва... Вален, сен не істеп жатырсың?
Dialogue: 0,0:08:40.18,0:08:43.18,Default,,0,0,0,,Гестия ханым мен Белл Кранел
Dialogue: 0,0:08:45.02,0:08:47.40,Default,,0,0,0,,Эйз-сан, мен бұл ойында жеңіле алмаймын.
Dialogue: 0,0:08:47.52,0:08:48.36,Default,,0,0,0,,Ә? Иә.
Dialogue: 0,0:08:48.48,0:08:51.78,Default,,0,0,0,,Белл мырза, бұл Familia беделі үшін шайқас.
Dialogue: 0,0:08:51.90,0:08:53.11,Default,,0,0,0,,Жоқ, олай емес деп ойлаймын.
Dialogue: 0,0:08:51.90,0:08:53.11,Default,,0,0,0,,(Вельф пен Лилируканың күрсінуі)
Dialogue: 0,0:08:53.11,0:08:54.70,Default,,0,0,0,,Жоқ, олай емес деп ойлаймын.
Dialogue: 0,0:08:54.95,0:08:57.66,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,0:08:57.78,0:08:59.03,Default,,0,0,0,,Жүр!
Dialogue: 0,0:08:59.16,0:09:00.66,Default,,0,0,0,,Ей, мен қашып құтыла алмаймын.
Dialogue: 0,0:09:01.24,0:09:03.87,Default,,0,0,0,,Енді келесі қарсылас кім?
Dialogue: 0,0:09:04.12,0:09:05.92,Default,,0,0,0,,Иә! Бұл менмін
Dialogue: 0,0:09:07.17,0:09:09.88,Default,,0,0,0,,Жоқ, ол мүлдем қозғалмайды.
Dialogue: 0,0:09:10.00,0:09:14.09,Default,,0,0,0,,Ой, Лефия-чан, әлі ерте.
Dialogue: 0,0:09:14.47,0:09:15.88,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:09:16.09,0:09:19.55,Default,,0,0,0,,Ой, бұл «Қылыш ханшайымы»—
Dialogue: 0,0:09:19.68,0:09:22.77,Default,,0,0,0,,Міне, Эйс Уолленштейн келеді.
Dialogue: 0,0:09:24.81,0:09:26.60,Default,,0,0,0,,Шығар, қылыш ханшайым
Dialogue: 0,0:09:28.81,0:09:29.65,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:09:29.86,0:09:32.65,Default,,0,0,0,,Жүр, күшейейік, Эйс Уолленштейн
Dialogue: 0,0:09:32.94,0:09:35.24,Default,,0,0,0,,Сәттілік, Эйс-сан.
Dialogue: 0,0:09:35.57,0:09:36.45,Default,,0,0,0,,А...
Dialogue: 0,0:09:37.07,0:09:39.28,Default,,0,0,0,,Жоқ, ол шықпайды.
Dialogue: 0,0:09:39.57,0:09:43.29,Default,,0,0,0,,Ал, тіпті 6-деңгей Эйз-сан...
Dialogue: 0,0:09:43.49,0:09:47.42,Default,,0,0,0,,Жарайды, Белл-кун, Валеннің не істеп жатқанына қара.
Dialogue: 0,0:09:47.67,0:09:49.63,Default,,0,0,0,,Сәттілік тілеймін, Белл мырза.
Dialogue: 0,0:09:49.92,0:09:51.71,Default,,0,0,0,,Ал, көңіл көтеріңдер.
Dialogue: 0,0:09:51.84,0:09:55.55,Default,,0,0,0,,Le... Егер сіз 2-деңгейде болсаңыз, өтуге мүмкіндік жоқ.
Dialogue: 0,0:09:55.67,0:09:58.51,Default,,0,0,0,,Не!? (Рефия) Хмм...
Dialogue: 0,0:09:58.63,0:10:00.93,Default,,0,0,0,,Енді келесі қарсылас кім?
Dialogue: 0,0:10:01.05,0:10:03.97,Default,,0,0,0,,О? Сіз келесіз бе? Белл-кун
Dialogue: 0,0:10:04.10,0:10:06.43,Default,,0,0,0,,Цуки… Цуки…
Dialogue: 0,0:10:06.56,0:10:10.02,Default,,0,0,0,,Енді Кішкентай Руки шақыратын кез келді.
Dialogue: 0,0:10:11.86,0:10:12.90,Default,,0,0,0,,Табылды
Dialogue: 0,0:10:13.02,0:10:13.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:18.99,0:10:20.07,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:10:23.12,0:10:24.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:28.33,0:10:31.83,Default,,0,0,0,,Түсіндім, тағдыр сені таңдады ма?
Dialogue: 0,0:10:32.84,0:10:34.46,Default,,0,0,0,,Ия, уау!
Dialogue: 0,0:10:34.67,0:10:36.63,Default,,0,0,0,,Белл-кун Ахха!
Dialogue: 0,0:10:36.76,0:10:38.38,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:38.76,0:10:40.22,Default,,0,0,0,,Қоңырау керемет
Dialogue: 0,0:10:40.34,0:10:42.30,Default,,0,0,0,,Мен оны шынымен шығарамын деп ешқашан ойламадым.
Dialogue: 0,0:10:42.43,0:10:44.39,Default,,0,0,0,,Хехе, көрдің бе?
Dialogue: 0,0:10:44.51,0:10:45.56,Default,,0,0,0,,(Йотаро Куджо) Өкінішті, бірақ осы сапарда… Какёинге жарыстан шығудан басқа амал қалмауы мүмкін.
Dialogue: 0,0:10:45.68,0:10:49.48,Default,,0,0,0,,Дұрыс, менің Беллем керемет.
Dialogue: 0,0:10:49.73,0:10:52.48,Default,,0,0,0,,Вален, сен не істеп жатырсың? Бұл сенің көзің емес.
Dialogue: 0,0:10:52.61,0:10:53.98,Default,,0,0,0,,Құттықтаймыз, Белл
Dialogue: 0,0:10:54.44,0:10:57.40,Default,,0,0,0,,А, жоқ, мен де түсінбеймін.
Dialogue: 0,0:10:57.53,0:11:02.24,Default,,0,0,0,,Мм... Олай болса, осы сапардың демеушілеріне тоқталайық.
Dialogue: 0,0:11:02.66,0:11:03.91,Default,,0,0,0,,Демеуші?
Dialogue: 0,0:11:08.25,0:11:09.79,Default,,0,0,0,,Артемида!
Dialogue: 0,0:11:10.00,0:11:11.87,Default,,0,0,0,,Бұл Артемида емес пе?
Dialogue: 0,0:11:12.12,0:11:13.46,Default,,0,0,0,,Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:11:13.75,0:11:16.55,Default,,0,0,0,,Ол мен көкте араласатын Құдайдың досы.
Dialogue: 0,0:11:17.34,0:11:19.09,Default,,0,0,0,,Менің махаббатым
Dialogue: 0,0:11:19.97,0:11:21.80,Default,,0,0,0,,Артемида!
Dialogue: 0,0:11:29.81,0:11:30.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:33.35,0:11:35.73,Default,,0,0,0,,Менің Орионымды таптым
Dialogue: 0,0:11:38.28,0:11:40.24,Default,,0,0,0,,Ори... (Вельф) Қосулы ма?
Dialogue: 0,0:11:41.28,0:11:42.91,Default,,0,0,0,,Хехе...
Dialogue: 0,0:11:43.20,0:11:45.83,Default,,0,0,0,,Ендеше менің қалпына келу қабілетім…
Dialogue: 0,0:11:52.29,0:11:53.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:53.67,0:11:55.88,Default,,0,0,0,,На на на на на…
Dialogue: 0,0:11:56.00,0:11:57.71,Default,,0,0,0,,Нанана және…
Dialogue: 0,0:11:57.84,0:12:00.26,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:01.80,0:12:04.72,Default,,0,0,0,,Бұрынғы сөзбен нені айтасыз? артемис
Dialogue: 0,0:12:05.18,0:12:07.51,Default,,0,0,0,,Кешіріңіз, мен жай ғана бақытты болдым.
Dialogue: 0,0:12:07.93,0:12:10.43,Default,,0,0,0,,Бақытты дегенді қалай түсінесіңдер?
Dialogue: 0,0:12:10.56,0:12:11.98,Default,,0,0,0,,Мен... Богиня
Dialogue: 0,0:12:12.39,0:12:15.44,Default,,0,0,0,,Бұл біздің бірінші кездесуіміз, солай ма? Эх...
Dialogue: 0,0:12:18.19,0:12:19.61,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:12:20.11,0:12:21.74,Default,,0,0,0,,Гермес~
Dialogue: 0,0:12:22.07,0:12:25.24,Default,,0,0,0,,Бұл Артемида ма? Бұл біртүрлі, солай емес пе?
Dialogue: 0,0:12:25.53,0:12:30.04,Default,,0,0,0,,Менің ойымша, Артемидаға төменгі дүниедегі өмір де әсер етті.
Dialogue: 0,0:12:30.16,0:12:31.83,Default,,0,0,0,,Соған қарамастан, бұл түтін неге осынша көп?
Dialogue: 0,0:12:31.95,0:12:34.46,Default,,0,0,0,,Сіз бастапқыда қандай адам едіңіз?
Dialogue: 0,0:12:34.96,0:12:36.67,Default,,0,0,0,,Артемида деген кім?
Dialogue: 0,0:12:37.84,0:12:41.71,Default,,0,0,0,,Артемида – көктегі пәк құдайлардың бірі.
Dialogue: 0,0:12:42.42,0:12:45.68,Default,,0,0,0,,Пәктікке жауапты және пәктігін құрметтеу
Dialogue: 0,0:12:45.80,0:12:49.10,Default,,0,0,0,,Егер мен солай айтсам, гетеросексуалды жыныстық қатынасты жою комитетінің төрағасы
Dialogue: 0,0:12:49.72,0:12:51.56,Default,,0,0,0,,Мен үлкен махаббатқа қарсы адаммын.
Dialogue: 0,0:12:52.18,0:12:54.14,Default,,0,0,0,,Махаббатқа қарсы…
Dialogue: 0,0:12:54.35,0:12:57.27,Default,,0,0,0,,Бұл қалай болды?
Dialogue: 0,0:12:57.40,0:13:01.44,Default,,0,0,0,,Бірақ махаббатқа қарсы құдай неге демеуші болады?
Dialogue: 0,0:13:01.61,0:13:05.03,Default,,0,0,0,,Негізінде, Орарионың сыртында құбыжық пайда болды.
Dialogue: 0,0:13:05.45,0:13:07.03,Default,,0,0,0,,Орарио сыртында ма?
Dialogue: 0,0:13:07.49,0:13:11.08,Default,,0,0,0,,А, оны Артемида Фамилия ашты.
Dialogue: 0,0:13:11.20,0:13:13.33,Default,,0,0,0,,Ол біршама қиын қарсылас.
Dialogue: 0,0:13:13.54,0:13:15.12,Default,,0,0,0,,Сондықтан мен Орариодан көмек сұрадым.
Dialogue: 0,0:13:15.25,0:13:18.42,Default,,0,0,0,,Басқаша айтқанда, бұл жай ғана көрікті жерлерге саяхат...
Dialogue: 0,0:13:18.54,0:13:23.17,Default,,0,0,0,,Артемида сұраған құбыжықты бағындыру квесті.
Dialogue: 0,0:13:23.30,0:13:24.42,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:13:24.55,0:13:25.93,Default,,0,0,0,,Күткендей, бұл өткір.
Dialogue: 0,0:13:26.05,0:13:28.51,Default,,0,0,0,,Егер бұл шындық болу үшін тым жақсы естілсе...
Dialogue: 0,0:13:29.01,0:13:31.47,Default,,0,0,0,,Бұл құтан. Құрметті Гермес, жарайды.
Dialogue: 0,0:13:37.69,0:13:41.61,Default,,0,0,0,,Мен сені іздедім, Орион.
Dialogue: 0,0:13:41.77,0:13:43.90,Default,,0,0,0,,Жоқ, менің атым Белл Кранел...
Dialogue: 0,0:13:44.03,0:13:46.53,Default,,0,0,0,,Жоқ, сіз Орионсыз.
Dialogue: 0,0:13:47.95,0:13:49.57,Default,,0,0,0,,Менің үмітім
Dialogue: 0,0:13:50.12,0:13:52.03,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:13:52.16,0:13:55.66,Default,,0,0,0,,Менен күштілер көп, Эйс-сан сияқты.
Dialogue: 0,0:13:55.79,0:13:58.62,Default,,0,0,0,,Бұл найзаны ұстауға қабілеттілік күш емес.
Dialogue: 0,0:13:59.25,0:14:02.17,Default,,0,0,0,,Кіршіксіз таза жан
Dialogue: 0,0:14:03.38,0:14:04.84,Default,,0,0,0,,Құрметті Гермес, бұл найза...
Dialogue: 0,0:14:04.96,0:14:07.63,Default,,0,0,0,,Мен бұл «аңызға айналған найза» дедім
Dialogue: 0,0:14:07.76,0:14:10.05,Default,,0,0,0,,Гефест де сертификатталған қару болып табылады.
Dialogue: 0,0:14:10.18,0:14:12.81,Default,,0,0,0,,Найза болуға сайландың, Белл.
Dialogue: 0,0:14:13.51,0:14:14.85,Default,,0,0,0,,Таңдалған
Dialogue: 0,0:14:18.14,0:14:19.60,Default,,0,0,0,,Мен найзамын
Dialogue: 0,0:14:23.19,0:14:24.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:24.53,0:14:29.86,Default,,0,0,0,,Ақ жаныңды алып, Орион, менімен бірге келші.
Dialogue: 0,0:14:29.99,0:14:30.82,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:14:31.95,0:14:33.28,Default,,0,0,0,,Суй!
Dialogue: 0,0:14:34.95,0:14:37.33,Default,,0,0,0,,Қарғыс атсын... Уф...
Dialogue: 0,0:14:38.16,0:14:40.33,Default,,0,0,0,,Ауырып тұр, Гестия.
Dialogue: 0,0:14:40.46,0:14:42.17,Default,,0,0,0,,Бұл тіпті маған ауыр тиеді
Dialogue: 0,0:14:42.84,0:14:44.13,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:14:44.25,0:14:46.84,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:14:47.13,0:14:48.30,Default,,0,0,0,,Қандай айырмашылық!
Dialogue: 0,0:14:48.80,0:14:51.80,Default,,0,0,0,,Артемида тапсырманы қабылдады.
Dialogue: 0,0:14:51.93,0:14:53.72,Default,,0,0,0,,Не? Құдай
Dialogue: 0,0:14:54.22,0:14:57.18,Default,,0,0,0,,Досың қиындыққа тап болса, оған көмектесу табиғи нәрсе.
Dialogue: 0,0:14:58.93,0:15:00.69,Default,,0,0,0,,Гестияға рахмет
Dialogue: 0,0:15:00.81,0:15:02.65,Default,,0,0,0,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,0:15:03.98,0:15:08.57,Default,,0,0,0,,Ал... ал сені және Беллді жалғыз қалдыру қауіпті.
Dialogue: 0,0:15:08.99,0:15:10.82,Default,,0,0,0,,Сонда Лили де барады.
Dialogue: 0,0:15:10.95,0:15:13.87,Default,,0,0,0,,Әрине, сыйлығын кейін беремін.
Dialogue: 0,0:15:13.99,0:15:16.04,Default,,0,0,0,,Жарайды, бұл мен мінген кеме.
Dialogue: 0,0:15:18.00,0:15:21.46,Default,,0,0,0,,Ал, мистер Белл, енді жауап беру сізге байланысты.
Dialogue: 0,0:15:23.63,0:15:26.13,Default,,0,0,0,,Жауап шешілген жоқ па?
Dialogue: 0,0:15:28.59,0:15:32.38,Default,,0,0,0,,Жарайды, мен бұл тапсырманы қабылдаймын.
Dialogue: 0,0:15:36.10,0:15:38.68,Default,,0,0,0,,Рахмет, мейірімді балалар.
Dialogue: 0,0:15:39.02,0:15:41.56,Default,,0,0,0,,Сіз менің отбасым емессіз.
Dialogue: 0,0:15:41.69,0:15:44.36,Default,,0,0,0,,Бірақ қазірден бастап менің жолсерігім
Dialogue: 0,0:15:44.48,0:15:46.48,Default,,0,0,0,,Келісім жасаңыз.
Dialogue: 0,0:15:47.32,0:15:48.15,Default,,0,0,0,,А...
Dialogue: 0,0:15:48.28,0:15:49.82,Default,,0,0,0,,Белл-кун, мені сүй, мені сүй.
Dialogue: 0,0:15:49.94,0:15:52.40,Default,,0,0,0,,Ах... кешіріңіз.
Dialogue: 0,0:15:53.78,0:15:54.62,Default,,0,0,0,,Хун
Dialogue: 0,0:15:54.74,0:15:56.24,Default,,0,0,0,,Ммм~
Dialogue: 0,0:15:56.37,0:15:57.37,Default,,0,0,0,,Ха... бұл...
Dialogue: 0,0:15:58.20,0:16:00.58,Default,,0,0,0,,Я... Лили Лили
Dialogue: 0,0:16:01.21,0:16:04.25,Default,,0,0,0,,Бол... Белле-самамен жанама сүйісу
Dialogue: 0,0:16:04.67,0:16:07.21,Default,,0,0,0,,Тезірек жүр, Лилисуке.
Dialogue: 0,0:16:09.88,0:16:11.63,Default,,0,0,0,,(Годжо) Бұл қызықтай бастады.
Dialogue: 0,0:16:12.26,0:16:13.80,Default,,0,0,0,,Иә? Неге жылайсың?
Dialogue: 0,0:16:14.05,0:16:14.43,Default,,0,0,0,,Идиот, ақымақ, мен Уэльф-саманы жек көремін!
Dialogue: 0,0:16:14.43,0:16:16.80,Default,,0,0,0,,Идиот, ақымақ, мен Уэлф-саманы жек көремін!
Dialogue: 0,0:16:14.43,0:16:16.80,Default,,0,0,0,,Әй, бұл не? Ауырады, ауырады...
Dialogue: 0,0:16:17.81,0:16:20.81,Default,,0,0,0,,Ал, енді іс бітті, кеттік.
Dialogue: 0,0:16:20.93,0:16:22.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:23.39,0:16:25.73,Default,,0,0,0,,Сіз қалай ойлайсыз? саяхат маманы
Dialogue: 0,0:16:25.85,0:16:28.98,Default,,0,0,0,,Бұл Hermes басқаратын тапсырыс бойынша жасалған өнімдер
Dialogue: 0,0:16:29.44,0:16:30.94,Default,,0,0,0,,Мұқият таңдалған материалдар
Dialogue: 0,0:16:31.15,0:16:33.65,Default,,0,0,0,,Әрине, жеңіл және жоғары серпімді
Dialogue: 0,0:16:34.20,0:16:36.82,Default,,0,0,0,,Матаға сирек металдардың сынықтары тоқылған.
Dialogue: 0,0:16:36.95,0:16:39.91,Default,,0,0,0,,Төзімділік бұрынғыға қарағанда 30% жоғары
Dialogue: 0,0:16:40.04,0:16:43.00,Default,,0,0,0,,Бұл шайқас кресті болғанымен, оның қару-жарақпен салыстыруға болатын қорғаныс күші бар.
Dialogue: 0,0:16:43.12,0:16:46.71,Default,,0,0,0,,Оның икемділігі киетін адамның қозғалысына кедергі жасамайды.
Dialogue: 0,0:16:46.83,0:16:49.29,Default,,0,0,0,,Мұндай шедеврді бірнеше сағатта қалай құрастыруға болады?
Dialogue: 0,0:16:49.42,0:16:52.13,Default,,0,0,0,,Аспан кең болса да, осы Герместен басқа...
Dialogue: 0,0:16:52.26,0:16:53.84,Default,,0,0,0,,Бұл саған жарасады, Белл.
Dialogue: 0,0:16:53.97,0:16:54.84,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:54.84,0:16:55.43,Default,,0,0,0,,Ешкім тыңдамайды
Dialogue: 0,0:16:54.84,0:16:55.43,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:55.43,0:16:55.55,Default,,0,0,0,,Ешкім тыңдамайды
Dialogue: 0,0:16:55.55,0:16:57.01,Default,,0,0,0,,Ешкім тыңдамайды
Dialogue: 0,0:16:55.55,0:16:57.01,Default,,0,0,0,,Құдай сізге де жарасады.
Dialogue: 0,0:16:57.26,0:16:59.39,Default,,0,0,0,,Хехе... Солай ма?
Dialogue: 0,0:17:01.60,0:17:05.06,Default,,0,0,0,,Лорд Уэлф, сіз сиқырлы қылышты өзіңізбен бірге алып кетесіз бе?
Dialogue: 0,0:17:05.23,0:17:08.23,Default,,0,0,0,,Иә? Әй... бір жағдайда
Dialogue: 0,0:17:11.82,0:17:14.15,Default,,0,0,0,,Бірақ мен Орариодан тыс жерде жүрсем де...
Dialogue: 0,0:17:14.28,0:17:16.53,Default,,0,0,0,,Неліктен ол сыртқы қабырғада?
Dialogue: 0,0:17:16.74,0:17:17.95,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:17:18.66,0:17:19.95,Default,,0,0,0,,Артемида
Dialogue: 0,0:17:20.62,0:17:22.16,Default,,0,0,0,,Сіз бірдеңе тыңдап жатырсыз ба?
Dialogue: 0,0:17:22.29,0:17:23.79,Default,,0,0,0,,Жарайды, осы сұраққа жауап…
Dialogue: 0,0:17:24.29,0:17:26.92,Default,,0,0,0,,Гермес Сіз не істемексіз?
Dialogue: 0,0:17:27.04,0:17:28.04,Default,,0,0,0,,Кел, кел, кел
Dialogue: 0,0:17:32.30,0:17:33.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:34.55,0:17:36.34,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:17:36.47,0:17:38.34,Default,,0,0,0,,Құдай-ау!
Dialogue: 0,0:17:40.01,0:17:41.85,Default,,0,0,0,,Га... Ганеша?
Dialogue: 0,0:17:42.18,0:17:44.64,Default,,0,0,0,,Иә, мен Ганешамын.
Dialogue: 0,0:17:49.40,0:17:51.52,Default,,0,0,0,,Сіз мұны мінемін деп айтасыз ба?
Dialogue: 0,0:17:51.65,0:17:54.69,Default,,0,0,0,,А, мен Ганешадан алдын ала сұрадым.
Dialogue: 0,0:17:55.15,0:17:57.11,Default,,0,0,0,,Құрлықпен барсаң бір ай кетеді, бірақ...
Dialogue: 0,0:17:57.24,0:17:59.91,Default,,0,0,0,,Егер сіз мұнымен жүрсеңіз, онда 10 күннен кейін боласыз.
Dialogue: 0,0:18:00.53,0:18:03.91,Default,,0,0,0,,Ал тез қайтпасаң, Асфи саған ұрысады.
Dialogue: 0,0:18:04.04,0:18:06.33,Default,,0,0,0,,Не? Бұл нені білдіреді... Уау...
Dialogue: 0,0:18:06.71,0:18:07.04,Default,,0,0,0,,Хахаха! Жарайды
Dialogue: 0,0:18:07.04,0:18:08.50,Default,,0,0,0,,Хахаха! Жарайды
Dialogue: 0,0:18:07.04,0:18:08.50,Default,,0,0,0,,Мен осындамын ғой?
Dialogue: 0,0:18:08.62,0:18:11.25,Default,,0,0,0,,Бұл айдаһар жұмыртқадан шыққаннан бері қолға үйретілген.
Dialogue: 0,0:18:08.62,0:18:11.25,Default,,0,0,0,,Тоқта, бұл қытық Ахахах...
Dialogue: 0,0:18:11.75,0:18:13.67,Default,,0,0,0,,Мен кез келген адамды тыңдаймын.
Dialogue: 0,0:18:14.88,0:18:17.47,Default,,0,0,0,,Әй, айдаһар жетіспеді ме?
Dialogue: 0,0:18:17.59,0:18:19.64,Default,,0,0,0,,Шынымды айтсам, барлығын жинай алмадым.
Dialogue: 0,0:18:19.76,0:18:22.14,Default,,0,0,0,,Демек, бұл екі орындық.
Dialogue: 0,0:18:23.06,0:18:24.89,Default,,0,0,0,,Екі орындық... Белл-кун
Dialogue: 0,0:18:25.77,0:18:27.77,Default,,0,0,0,,Менімен...
Dialogue: 0,0:18:28.19,0:18:30.27,Default,,0,0,0,,Кімге!
Dialogue: 0,0:18:30.40,0:18:31.86,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:18:33.77,0:18:38.20,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:38.32,0:18:40.95,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:18:46.91,0:18:48.58,Default,,0,0,0,,Амансың ба? иә?
Dialogue: 0,0:18:49.16,0:18:50.29,Default,,0,0,0,,Сіз қорықпайсыз ба?
Dialogue: 0,0:18:51.00,0:18:52.08,Default,,0,0,0,,Қорқынышты ма?
Dialogue: 0,0:18:52.25,0:18:56.80,Default,,0,0,0,,Қараңғы, қымбат, айдаһардан қорқатын шығар.
Dialogue: 0,0:18:58.09,0:19:01.80,Default,,0,0,0,,Негізі мен де біраз қобалжыдым.
Dialogue: 0,0:19:02.43,0:19:03.26,Default,,0,0,0,,А...
Dialogue: 0,0:19:03.39,0:19:05.18,Default,,0,0,0,,Менің жүрегім жиі соғуда
Dialogue: 0,0:19:05.47,0:19:07.10,Default,,0,0,0,,Жүрек соғуы осы ма?
Dialogue: 0,0:19:07.22,0:19:08.73,Default,,0,0,0,,Мұнда Артемида
Dialogue: 0,0:19:08.98,0:19:11.35,Default,,0,0,0,,Белл-кун менің ізбасарым, зорлық-зомбылық жасама.
Dialogue: 0,0:19:11.73,0:19:13.31,Default,,0,0,0,,Құлап бара жатырсың, Гестия, кет.
Dialogue: 0,0:19:13.56,0:19:14.65,Default,,0,0,0,,Шулы жігіт
Dialogue: 0,0:19:14.77,0:19:16.11,Default,,0,0,0,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:19:16.23,0:19:17.78,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:19:17.90,0:19:19.44,Default,,0,0,0,,Лорд Гермес
Dialogue: 0,0:19:20.07,0:19:23.32,Default,,0,0,0,,Айтпақшы, баратын жеріңіз қайда?
Dialogue: 0,0:19:23.45,0:19:24.28,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:28.00,0:19:32.67,Default,,0,0,0,,Баратын жер материктің шетіндегі Орариодан алыс.
Dialogue: 0,0:19:32.92,0:19:37.59,Default,,0,0,0,,Елос қирандылары Ұлы ағаш теңізінің зерттелмеген аймағында бар.
Dialogue: 0,0:20:11.54,0:20:13.87,Default,,0,0,0,,Жоқ, бұл жақсы жел.
Dialogue: 0,0:20:14.46,0:20:16.84,Default,,0,0,0,,Сіз мәңгі ұша аласыз
Dialogue: 0,0:20:17.21,0:20:19.25,Default,,0,0,0,,Қандай алаңсыз нәрсе
Dialogue: 0,0:20:19.38,0:20:22.05,Default,,0,0,0,,Мен оны бір апта ұшқаннан кейін көруден шаршадым.
Dialogue: 0,0:20:22.55,0:20:24.47,Default,,0,0,0,,Сәлем? Қоңырау хахаха...
Dialogue: 0,0:20:26.43,0:20:28.10,Default,,0,0,0,,Бұл тағы да орман.
Dialogue: 0,0:20:29.93,0:20:30.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:32.06,0:20:33.27,Default,,0,0,0,,Төмен бе?
Dialogue: 0,0:20:33.39,0:20:34.90,Default,,0,0,0,,бірден... иә
Dialogue: 0,0:20:39.40,0:20:40.94,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:43.20,0:20:44.20,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:48.91,0:20:50.41,Default,,0,0,0,,Әлі таңқаларлық емес
Dialogue: 0,0:20:50.54,0:20:52.16,Default,,0,0,0,,Оны айналып өтіңіз Иә
Dialogue: 0,0:20:56.29,0:20:57.54,Default,,0,0,0,,Отты болт
Dialogue: 0,0:20:58.00,0:20:59.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:59.67,0:21:01.21,Default,,0,0,0,,Не? Бұл ненің дыбысы?
Dialogue: 0,0:21:01.34,0:21:02.84,Default,,0,0,0,,Бұл қиын, иә?
Dialogue: 0,0:21:03.34,0:21:05.05,Default,,0,0,0,,Мисс Белл жоқ.
Dialogue: 0,0:21:05.43,0:21:06.43,Default,,0,0,0,,Мистер Белл
Dialogue: 0,0:21:07.22,0:21:08.64,Default,,0,0,0,,Оттық болт
Dialogue: 0,0:21:11.72,0:21:13.52,Default,,0,0,0,,Қарғыс атсын... тым көп
Dialogue: 0,0:21:15.35,0:21:16.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:16.35,0:21:17.52,Default,,0,0,0,,Қарғыс атсын... Өрт...
Dialogue: 0,0:21:17.65,0:21:19.94,Default,,0,0,0,,Жоқ, жақын, ә...
Dialogue: 0,0:21:21.53,0:21:22.73,Default,,0,0,0,,Құрметті Артемида
Dialogue: 0,0:21:36.62,0:21:37.58,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:50.01,0:21:51.01,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:54.35,0:21:55.39,Default,,0,0,0,,Артемида ханым
Dialogue: 0,0:22:02.86,0:22:04.53,Default,,0,0,0,,Мен сонда болдым.
Dialogue: 0,0:22:04.65,0:22:06.57,Default,,0,0,0,,Не? Бұл құбыжық
Dialogue: 0,0:22:07.32,0:22:09.16,Default,,0,0,0,,Тез Белл-самаға барыңыз.
Dialogue: 0,0:22:10.57,0:22:12.91,Default,,0,0,0,,Белл-кун Артемида
Dialogue: 0,0:22:18.42,0:22:20.50,Default,,0,0,0,,Уақытында болыңыз!
Dialogue: 0,0:22:22.75,0:22:24.25,Default,,0,0,0,,Уф... не?
Dialogue: 0,0:22:31.76,0:22:32.80,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:22:42.27,0:22:43.32,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:22:43.44,0:22:45.69,Default,,0,0,0,,Бұл найзаның күші
Dialogue: 0,0:22:49.86,0:22:52.66,Default,,0,0,0,,Құрметті Артемида, жақсысыз ба?
Dialogue: 0,0:22:52.78,0:22:53.87,Default,,0,0,0,,О
Dialogue: 0,0:22:54.53,0:22:55.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:58.83,0:23:01.50,Default,,0,0,0,,Өтінемін, тым қатыгез болма, Артемида.
Dialogue: 0,0:23:01.96,0:23:03.75,Default,,0,0,0,,Муча? Неліктен?
Dialogue: 0,0:23:03.92,0:23:08.72,Default,,0,0,0,,Жарайды... себебі... бұл қыз.
Dialogue: 0,0:23:09.13,0:23:11.68,Default,,0,0,0,,Атам қыздарды қорғау керек дейді...
Dialogue: 0,0:23:11.97,0:23:13.43,Default,,0,0,0,,Сонымен... хехе...
Dialogue: 0,0:23:14.18,0:23:17.89,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:23:18.10,0:23:21.02,Default,,0,0,0,,Маған мұндай нәрсені бірінші рет айтып отыр.
Dialogue: 0,0:23:21.60,0:23:23.19,Default,,0,0,0,,Мен осылай болсам да, мен
Dialogue: 0,0:23:23.31,0:23:26.44,Default,,0,0,0,,Гермес немесе Гестиядан әлдеқайда күшті.
Dialogue: 0,0:23:26.65,0:23:28.15,Default,,0,0,0,,Әлі де.
Dialogue: 0,0:23:28.28,0:23:30.15,Default,,0,0,0,,Артемис Белл-кун
Dialogue: 0,0:23:30.45,0:23:32.61,Default,,0,0,0,,Екеуің де жақсысыңдар ма? О
Dialogue: 0,0:23:33.32,0:23:36.70,Default,,0,0,0,,Мен сенің мықты екеніңді білемін, бірақ маған араласпашы.
Dialogue: 0,0:23:36.99,0:23:41.08,Default,,0,0,0,,Енді сіздің балаңызға да солай айтылды.
Dialogue: 0,0:23:42.37,0:23:43.71,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:23:43.83,0:23:45.29,Default,,0,0,0,,Бұл өте жылдам.
Dialogue: 0,0:23:45.50,0:23:46.50,Default,,0,0,0,,Я~
Dialogue: 0,0:23:46.63,0:23:48.51,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:23:49.13,0:23:50.63,Default,,0,0,0,,Алғысымды қалай айтуым керек?
Dialogue: 0,0:23:50.76,0:23:52.22,Default,,0,0,0,,А, жоқ, солай...
Dialogue: 0,0:23:52.47,0:23:55.01,Default,,0,0,0,,Балалар сендер бұл құбыжықты танисыңдар ма?
Dialogue: 0,0:23:55.39,0:23:58.27,Default,,0,0,0,,Жоқ. Айналадағы ауылдарға да шабуыл жасалды.
Dialogue: 0,0:23:58.39,0:24:00.02,Default,,0,0,0,,Біз кенеттен...
Dialogue: 0,0:24:00.14,0:24:02.19,Default,,0,0,0,,Мен мұндай құбыжықты ешқашан көрген емеспін.
Dialogue: 0,0:24:02.31,0:24:03.73,Default,,0,0,0,,Мүмкін ол Орариодан тыс жерде болғандықтан ба?
Dialogue: 0,0:24:03.85,0:24:05.69,Default,,0,0,0,,Кешіріңіз, мен ештеңе түсінбеймін.
Dialogue: 0,0:24:05.81,0:24:06.65,Default,,0,0,0,,Мистер Белл
Dialogue: 0,0:24:07.11,0:24:09.53,Default,,0,0,0,,Бұл қауіпті, сондықтан найзаны көп қолданбаңыз.
Dialogue: 0,0:24:09.65,0:24:12.78,Default,,0,0,0,,Ах... Иә, Гермес-сама, мына найза...
Dialogue: 0,0:24:12.90,0:24:13.86,Default,,0,0,0,,Және-
Dialogue: 0,0:24:14.74,0:24:16.74,Default,,0,0,0,,Мен сенің байқағаныңды қаламаймын.
Dialogue: 0,0:24:19.04,0:24:20.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:22.54,0:24:24.96,Default,,0,0,0,,Қош бол Құдайым
Dialogue: 0,0:24:25.38,0:24:26.96,Default,,0,0,0,,Рахмет
Dialogue: 0,0:24:28.75,0:24:30.88,Default,,0,0,0,,Басқаларға көмектесу жақсы.
Dialogue: 0,0:24:31.80,0:24:34.97,Default,,0,0,0,,Мен саған тамақтың бәрін берсем не істейсің?
Dialogue: 0,0:24:35.59,0:24:37.18,Default,,0,0,0,,Нан ғана қалды.
Dialogue: 0,0:24:37.72,0:24:39.97,Default,,0,0,0,,Менің тамақ ішуім керек емес.
Dialogue: 0,0:24:40.56,0:24:44.23,Default,,0,0,0,,Артемида ең жақсы, бірақ Лили мен басқалары әбден аш.
Dialogue: 0,0:24:44.35,0:24:45.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:46.94,0:24:47.77,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:24:50.57,0:24:52.44,Default,,0,0,0,,Бва! Мен дәл тиетіндей едім...
Dialogue: 0,0:24:52.74,0:24:55.70,Default,,0,0,0,,Бұл не сұмдық?
Dialogue: 0,0:24:55.82,0:24:58.24,Default,,0,0,0,,Ей, ол құдай.
Dialogue: 0,0:24:58.37,0:25:00.79,Default,,0,0,0,,Тәңірі болса да, әйтеуір бір бок.
Dialogue: 0,0:25:01.16,0:25:03.83,Default,,0,0,0,,Бұл Понкоцуды басқаратын Понкотсу құдайы.
Dialogue: 0,0:25:03.96,0:25:05.12,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:25:05.25,0:25:07.13,Default,,0,0,0,,Неліктен бұлай болды?
Dialogue: 0,0:25:07.25,0:25:09.63,Default,,0,0,0,,Бұл шынымен басқаша ма? О
Dialogue: 0,0:25:10.17,0:25:13.72,Default,,0,0,0,,Қорқынышты болғаны сонша, оны әйел данышпан деп атауға болады.
Dialogue: 0,0:25:14.47,0:25:17.26,Default,,0,0,0,,Аспанда маған тек шомылуға рұқсат етілді...
Dialogue: 0,0:25:17.55,0:25:19.72,Default,,0,0,0,,Ұят болды, шошқалар!
Dialogue: 0,0:25:19.85,0:25:22.27,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:25:22.93,0:25:26.73,Default,,0,0,0,,Бұл да болды.
Dialogue: 0,0:25:27.31,0:25:29.48,Default,,0,0,0,,Міне, бүгін күн батып жатыр...
Dialogue: 0,0:25:29.86,0:25:32.15,Default,,0,0,0,,Осы жерде қалып, ертең таңертең жолға шығайық.
Dialogue: 0,0:25:32.28,0:25:34.69,Default,,0,0,0,,Не? Сонымен, тамақ туралы не деуге болады?
Dialogue: 0,0:25:34.82,0:25:36.15,Default,,0,0,0,,Мен бүгін ұстай аламын.
Dialogue: 0,0:25:36.28,0:25:39.91,Default,,0,0,0,,Жарайды, қарным ашты.
Dialogue: 0,0:25:40.03,0:25:41.58,Default,,0,0,0,,Кешіріңіз... Кешіріңіз.
Dialogue: 0,0:25:42.87,0:25:45.04,Default,,0,0,0,,А... бірдеңе болатын шығар.
Dialogue: 0,0:25:45.16,0:25:46.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:57.05,0:25:58.76,Default,,0,0,0,,О~
Dialogue: 0,0:25:59.14,0:26:00.93,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:26:02.76,0:26:04.81,Default,,0,0,0,,Мен көремін дәмді.
Dialogue: 0,0:26:04.98,0:26:06.43,Default,,0,0,0,,Масала жемісі?
Dialogue: 0,0:26:06.56,0:26:10.61,Default,,0,0,0,,Қыздырғанда ішіндегі целлюлоза еріп, бай жеміс шырынына айналады.
Dialogue: 0,0:26:10.73,0:26:12.52,Default,,0,0,0,,Бұл шынымен ормандағы мейрамхана.
Dialogue: 0,0:26:12.77,0:26:15.40,Default,,0,0,0,,Сен мені жақсы білдің, Белл. Бұл таңқаларлық, Белл мырза.
Dialogue: 0,0:26:15.53,0:26:16.53,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:26:16.70,0:26:19.99,Default,,0,0,0,,Орион Сен білімдісің.
Dialogue: 0,0:26:20.12,0:26:22.08,Default,,0,0,0,,Жоқ... Орариоға келгенге дейін.
Dialogue: 0,0:26:22.20,0:26:24.62,Default,,0,0,0,,Мұны маған атам үйреткен.
Dialogue: 0,0:26:25.04,0:26:27.96,Default,,0,0,0,,Иә? Сіз тамақ жеген жоқсыз ба?
Dialogue: 0,0:26:28.33,0:26:30.21,Default,,0,0,0,,О, мен...
Dialogue: 0,0:26:30.63,0:26:32.09,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:26:34.67,0:26:36.21,Default,,0,0,0,,Ах (Бел Хестия) Иә?
Dialogue: 0,0:26:36.63,0:26:38.05,Default,,0,0,0,,Айтамын ғой, қой!
Dialogue: 0,0:26:38.17,0:26:39.18,Default,,0,0,0,,Мен жүгері дорбаларын жүк көліктеріне тиеп, қоймаға апаратынмын.
Dialogue: 0,0:26:39.51,0:26:41.26,Default,,0,0,0,,Маған мұны істеуге рұқсат бересіз бе?
Dialogue: 0,0:26:41.39,0:26:43.10,Default,,0,0,0,,Тіпті Лилия
Dialogue: 0,0:26:43.22,0:26:45.43,Default,,0,0,0,,Жеңдер! Муггг
Dialogue: 0,0:26:45.77,0:26:47.60,Default,,0,0,0,,Белл-кун азап шегеді, солай емес пе?
Dialogue: 0,0:26:47.73,0:26:49.10,Default,,0,0,0,,Тоқта, қолдаушы.
Dialogue: 0,0:26:49.23,0:26:50.69,Default,,0,0,0,,Гестия - бұл
Dialogue: 0,0:26:50.81,0:26:51.81,Default,,0,0,0,,Ммм~
Dialogue: 0,0:26:53.11,0:26:56.65,Default,,0,0,0,,Әйтеуір, ол қандай құбыжық еді?
Dialogue: 0,0:26:56.78,0:26:59.11,Default,,0,0,0,,Шаян тәрізді құбыжықтар бар, бірақ...
Dialogue: 0,0:26:59.24,0:27:00.78,Default,,0,0,0,,Мен мұны бұрын ешқашан көрген емеспін.
Dialogue: 0,0:27:01.16,0:27:04.08,Default,,0,0,0,,Олар жақын маңдағы ауылға шабуыл жасағандарын айтты.
Dialogue: 0,0:27:04.83,0:27:06.20,Default,,0,0,0,,Мұның бәрі қалай басталды
Dialogue: 0,0:27:06.62,0:27:10.46,Default,,0,0,0,,Құбыжықтардың қалыптан тыс көбеюі расталды.
Dialogue: 0,0:27:11.17,0:27:15.05,Default,,0,0,0,,Себепті тексеруге көптеген отбасы мүшелері жіберілді.
Dialogue: 0,0:27:16.21,0:27:18.21,Default,,0,0,0,,үшін жоғалып кетті.
Dialogue: 0,0:27:19.05,0:27:21.22,Default,,0,0,0,,Орналасқан жері Елсос жері.
Dialogue: 0,0:27:21.34,0:27:25.14,Default,,0,0,0,,Сол жердегі қирандыларға белгілі бір мөр басылған.
Dialogue: 0,0:27:25.43,0:27:27.97,Default,,0,0,0,,Пломба? Не?
Dialogue: 0,0:27:28.27,0:27:32.40,Default,,0,0,0,,Жерді шіріту, теңізді жалмау, ормандарды жою —
Dialogue: 0,0:27:32.52,0:27:35.07,Default,,0,0,0,,Бүкіл өмірді өз билігінен айырады
Dialogue: 0,0:27:35.48,0:27:39.69,Default,,0,0,0,,Ежелгі ұлы рухтардың мөрімен басылған құбыжық.
Dialogue: 0,0:27:40.15,0:27:41.20,Default,,0,0,0,,Антарес
Dialogue: 0,0:27:42.36,0:27:43.66,Default,,0,0,0,,Антарес?
Dialogue: 0,0:27:43.95,0:27:49.41,Default,,0,0,0,,Бірақ ұзақ уақыт бойы ол тыныш және терең күш жинады ...
Dialogue: 0,0:27:50.66,0:27:52.71,Default,,0,0,0,,Пломба ақыры бұзылды.
Dialogue: 0,0:27:53.38,0:27:55.63,Default,,0,0,0,,Сіз мөрді сындырдыңыз...
Dialogue: 0,0:27:56.13,0:27:57.42,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,0:28:00.34,0:28:04.34,Default,,0,0,0,,А, Орарио да бұл мәселеге өте байыпты қарайды.
Dialogue: 0,0:28:05.22,0:28:07.31,Default,,0,0,0,,Мен отбасымды жібердім.
Dialogue: 0,0:28:08.47,0:28:12.10,Default,,0,0,0,,Сол жерде ол сол мақсатта болған Артемиданы кездестірді.
Dialogue: 0,0:28:12.85,0:28:16.90,Default,,0,0,0,,Содан кейін ол күшейтуді шақыру үшін Орариоға оралды.
Dialogue: 0,0:28:17.02,0:28:17.98,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,0:28:18.11,0:28:20.03,Default,,0,0,0,,Олай болса мықты отбасын құрыңыз...
Dialogue: 0,0:28:20.15,0:28:20.99,Default,,0,0,0,,Сен жай ғана... отты қайта тұтаттың, иә?
Dialogue: 0,0:28:22.61,0:28:25.57,Default,,0,0,0,,Антаресті сол найза ғана жеңе алады.
Dialogue: 0,0:28:29.24,0:28:33.50,Default,,0,0,0,,Ал сен найза болып сайланды.
Dialogue: 0,0:28:36.71,0:28:40.67,Default,,0,0,0,,Әй, жарайды. Қолымда найза болса, бәрі жақсы болады.
Dialogue: 0,0:28:40.96,0:28:43.51,Default,,0,0,0,,Жүр, ертеңгі күнге дайындалып ұйықтайық.
Dialogue: 0,0:28:53.89,0:28:55.02,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:28:55.15,0:28:57.69,Default,,0,0,0,,Өткен күні Белл мені оятпады.
Dialogue: 0,0:28:58.15,0:29:00.65,Default,,0,0,0,,Сонымен, сіз толық емес жұмыс күніңізге уақытында үлгердіңіз бе?
Dialogue: 0,0:29:01.28,0:29:03.03,Default,,0,0,0,,Иә, әйтеуір.
Dialogue: 0,0:29:03.15,0:29:04.70,Default,,0,0,0,,Бірақ бұл қауіпті болды.
Dialogue: 0,0:29:04.82,0:29:07.53,Default,,0,0,0,,Мен кешігіп қалсам, Гефест не дейді?
Dialogue: 0,0:29:07.66,0:29:11.33,Default,,0,0,0,,Хехе... Гефест бұрынғысынша.
Dialogue: 0,0:29:11.54,0:29:14.54,Default,,0,0,0,,Толық емес жұмысымнан айырылсам, мен де қиналамын.
Dialogue: 0,0:29:15.29,0:29:18.92,Default,,0,0,0,,Бірақ Гестияның отбасы бар.
Dialogue: 0,0:29:19.29,0:29:22.05,Default,,0,0,0,,Ал, Белл ғана қалды.
Dialogue: 0,0:29:22.76,0:29:25.05,Default,,0,0,0,,Гестия Бұл не?
Dialogue: 0,0:29:25.47,0:29:28.18,Default,,0,0,0,,Орион туралы не ойлайсың?
Dialogue: 0,0:29:28.30,0:29:29.14,Default,,0,0,0,,Эй!?
Dialogue: 0,0:29:29.60,0:29:32.85,Default,,0,0,0,,Жоқ... Менің ойымша, олар сүйкімді отбасы мүшелері.
Dialogue: 0,0:29:32.97,0:29:34.43,Default,,0,0,0,,Жоқ, дәлірек айтсақ, одан да көп.
Dialogue: 0,0:29:34.56,0:29:38.15,Default,,0,0,0,,Бұл мен үшін қазірдің өзінде маңызды болмыс...
Dialogue: 0,0:29:43.32,0:29:46.36,Default,,0,0,0,,Бұл менің қазынам.
Dialogue: 0,0:29:47.53,0:29:48.66,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:29:49.66,0:29:52.41,Default,,0,0,0,,Мен де қасында болғанда жүрегім елжірейді.
Dialogue: 0,0:29:52.70,0:29:54.16,Default,,0,0,0,,Иә!? Нану?
Dialogue: 0,0:29:54.50,0:29:57.04,Default,,0,0,0,,Бұл қандай сезім?
Dialogue: 0,0:29:57.17,0:29:59.83,Default,,0,0,0,,Бол... Белл-кун менің ізбасарым.
Dialogue: 0,0:29:59.96,0:30:00.79,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:30:01.00,0:30:03.17,Default,,0,0,0,,Сондықтан олай ойламаңыз.
Dialogue: 0,0:30:03.30,0:30:04.13,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:30:04.59,0:30:08.13,Default,,0,0,0,,Неге... Кез келген нәрсе!
Dialogue: 0,0:30:08.26,0:30:11.22,Default,,0,0,0,,Сен бұлай айтпауың керек еді, Артемида.
Dialogue: 0,0:30:11.35,0:30:12.39,Default,,0,0,0,,Бұл болды ма?
Dialogue: 0,0:30:12.60,0:30:16.23,Default,,0,0,0,,Мүлдем... Қайда бардың, ғашықтыққа қарсы адам?
Dialogue: 0,0:30:20.02,0:30:21.11,Default,,0,0,0,,Гестия?
Dialogue: 0,0:30:21.23,0:30:25.03,Default,,0,0,0,,Эй, Артемис, қазір сенің отбасың кім?
Dialogue: 0,0:30:27.90,0:30:32.99,Default,,0,0,0,,Мұнда емес, менің қайтуымды күтіп тұр
Dialogue: 0,0:30:37.50,0:30:39.25,Default,,0,0,0,,Сен өзгердің, солай емес пе?
Dialogue: 0,0:30:39.83,0:30:40.96,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:30:41.46,0:30:46.88,Default,,0,0,0,,А, сіз өзгермейтін құдайлар болуыңыз керек, бірақ сіз өзгердіңіз.
Dialogue: 0,0:30:53.72,0:30:54.81,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:30:56.02,0:30:57.73,Default,,0,0,0,,Мен көмектесе алмаймын.
Dialogue: 0,0:30:59.44,0:31:02.02,Default,,0,0,0,,Не? Орариодан шыға алмайсыз ба?
Dialogue: 0,0:31:02.36,0:31:03.65,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:31:04.11,0:31:06.48,Default,,0,0,0,,Бұл гильдиядан келген бұйрық болса керек.
Dialogue: 0,0:31:06.94,0:31:09.74,Default,,0,0,0,,Маған Орарионың ішінде қалуға қатаң бұйрық берілді.
Dialogue: 0,0:31:10.03,0:31:12.45,Default,,0,0,0,,Біздің портта жұмысымыз бар.
Dialogue: 0,0:31:12.57,0:31:14.03,Default,,0,0,0,,Әрине, ол жойылды.
Dialogue: 0,0:31:14.16,0:31:16.95,Default,,0,0,0,,Жоқ...не дейсіздер, гильдия жігіттері?
Dialogue: 0,0:31:17.29,0:31:18.58,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:31:19.21,0:31:20.50,Default,,0,0,0,,Мистер Көздер
Dialogue: 0,0:31:21.33,0:31:23.42,Default,,0,0,0,,Аспанда не болды?
Dialogue: 0,0:31:24.29,0:31:26.92,Default,,0,0,0,,Жоқ, кеттік.
Dialogue: 0,0:31:27.05,0:31:27.88,Default,,0,0,0,,Иә
Dialogue: 0,0:31:51.03,0:31:51.86,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:31:52.11,0:31:54.57,Default,,0,0,0,,Сіз нені айтасыз? Бұл не?
Dialogue: 0,0:31:59.12,0:32:01.96,Default,,0,0,0,,Орман өлді
Dialogue: 0,0:32:02.54,0:32:04.33,Default,,0,0,0,,Бұл Антарестің жұмысы.
Dialogue: 0,0:32:05.50,0:32:09.17,Default,,0,0,0,,Бұл Елсостың қирандылары.
Dialogue: 0,0:32:14.51,0:32:16.22,Default,,0,0,0,,Антарес сонда...
Dialogue: 0,0:32:16.35,0:32:18.64,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:32:18.77,0:32:19.68,Default,,0,0,0,,Артемида ханым?
Dialogue: 0,0:32:21.68,0:32:22.64,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:32:26.48,0:32:27.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:27.61,0:32:28.73,Default,,0,0,0,,Бұл...
Dialogue: 0,0:32:28.98,0:32:30.36,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:32:32.70,0:32:33.70,Default,,0,0,0,,Гррр…
Dialogue: 0,0:32:34.16,0:32:35.24,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:32:35.95,0:32:36.87,Default,,0,0,0,,Уау
Dialogue: 0,0:32:45.63,0:32:47.75,Default,,0,0,0,,Жақсысың ба? Артемида ханым
Dialogue: 0,0:32:47.88,0:32:49.59,Default,,0,0,0,,О, барлығына
Dialogue: 0,0:32:52.97,0:32:55.05,Default,,0,0,0,,Құдай баршаңызға!
Dialogue: 0,0:32:55.72,0:32:57.60,Default,,0,0,0,,Әйтеуір менде бәрі жақсы.
Dialogue: 0,0:32:57.93,0:32:58.76,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:32:58.89,0:33:00.56,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:33:02.23,0:33:03.98,Default,,0,0,0,,Лили, сен ауырып қалдың ба?
Dialogue: 0,0:33:04.10,0:33:05.02,Default,,0,0,0,,Мистер Белл
Dialogue: 0,0:33:05.48,0:33:07.65,Default,,0,0,0,,Лили мен басқалары жақсы, бірақ...
Dialogue: 0,0:33:07.81,0:33:10.27,Default,,0,0,0,,Бұл не? Бұрынғы жарық
Dialogue: 0,0:33:11.07,0:33:12.74,Default,,0,0,0,,Мүмкін мен...
Dialogue: 0,0:33:12.94,0:33:16.24,Default,,0,0,0,,Жоқ, қолындағы найзаны көздеген шығар.
Dialogue: 0,0:33:16.36,0:33:17.20,Default,,0,0,0,,А...
Dialogue: 0,0:33:17.32,0:33:19.24,Default,,0,0,0,,(шу)
Dialogue: 0,0:33:20.99,0:33:22.37,Default,,0,0,0,,Құбыжық
Dialogue: 0,0:33:22.50,0:33:24.25,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:33:24.37,0:33:26.92,Default,,0,0,0,,Бұл сол кездегі ба?
Dialogue: 0,0:33:27.04,0:33:29.96,Default,,0,0,0,,Жоқ, көлемі мен пішіні әртүрлі.
Dialogue: 0,0:33:31.25,0:33:33.01,Default,,0,0,0,,Кел, адасқан жел
Dialogue: 0,0:33:33.13,0:33:36.72,Default,,0,0,0,,Қаңғыбас серігі Аспаннан өтіп, шөл далада жүгіреді
Dialogue: 0,0:33:36.84,0:33:38.85,Default,,0,0,0,,Басқаларға қарағанда жылдам жүгіру
Dialogue: 0,0:33:39.43,0:33:42.72,Default,,0,0,0,,Жауды жұлдызды шаңмен жеңу
Dialogue: 0,0:33:43.14,0:33:44.56,Default,,0,0,0,,Жарқыраған жел
Dialogue: 0,0:33:51.11,0:33:52.19,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:33:54.49,0:33:57.49,Default,,0,0,0,,Рю... Рю-сан?
Dialogue: 0,0:33:59.32,0:34:00.58,Default,,0,0,0,,Кранел мырза
Dialogue: 0,0:34:01.87,0:34:04.12,Default,,0,0,0,,Мен сені мұндай жерде кездестіремін деп ойламаппын.
Dialogue: 0,0:34:04.37,0:34:06.46,Default,,0,0,0,,Рю мырза, сіз мұнда не үшін келдіңіз?
Dialogue: 0,0:34:06.75,0:34:10.38,Default,,0,0,0,,Маған қиын квестте сізбен бірге жүруді сұрады.
Dialogue: 0,0:34:11.04,0:34:12.09,Default,,0,0,0,,Оларға
Dialogue: 0,0:34:12.59,0:34:15.09,Default,,0,0,0,,Асфи-сан Гермес Фамилия
Dialogue: 0,0:34:16.51,0:34:18.80,Default,,0,0,0,,Лорд Гермес! G...
Dialogue: 0,0:34:19.26,0:34:20.97,Default,,0,0,0,,Иә... Сәлем Асфи
Dialogue: 0,0:34:21.14,0:34:22.68,Default,,0,0,0,,Бұл өте керемет!
Dialogue: 0,0:34:22.81,0:34:25.81,Default,,0,0,0,,Сен бізге қирандыларды бақылауды тапсырдың да, үйге жалғыз қайттың.
Dialogue: 0,0:34:25.93,0:34:27.44,Default,,0,0,0,,Асфиді тыныштандыр
Dialogue: 0,0:34:27.77,0:34:30.86,Default,,0,0,0,,Сол себепті найзаның иесін іздеп бардым.
Dialogue: 0,0:34:30.98,0:34:33.57,Default,,0,0,0,,Сонда да рұқсатсыз жоғалып кетпеңіз.
Dialogue: 0,0:34:33.69,0:34:36.28,Default,,0,0,0,,Асфи Герместі кешіріңіз.
Dialogue: 0,0:34:36.40,0:34:38.53,Default,,0,0,0,,Артемида-сама...
Dialogue: 0,0:34:40.91,0:34:42.33,Default,,0,0,0,,Белл Кранел
Dialogue: 0,0:34:43.08,0:34:46.25,Default,,0,0,0,,Әй... Найзаны суырып алған сен бе?
Dialogue: 0,0:34:46.54,0:34:50.33,Default,,0,0,0,,Шынымды айтсам, мен одан да күшті Familia күткен едім.
Dialogue: 0,0:34:50.46,0:34:52.00,Default,,0,0,0,,Шектеу дегенді білмейсіңдер ғой…
Dialogue: 0,0:34:53.13,0:34:55.21,Default,,0,0,0,,-дегі Асфи жағдайы қандай?
Dialogue: 0,0:34:55.55,0:34:56.92,Default,,0,0,0,,Барған сайын нашарлап барады
Dialogue: 0,0:34:57.72,0:35:01.80,Default,,0,0,0,,Орман эрозиясы кең тараған, құбыжықтар әлі де көбейіп келеді.
Dialogue: 0,0:35:02.51,0:35:05.39,Default,,0,0,0,,Маңайдағы ауыл жойылып кеткен.
Dialogue: 0,0:35:06.64,0:35:08.18,Default,,0,0,0,,Үйінділерге шабуыл жасау туралы не деуге болады?
Dialogue: 0,0:35:08.77,0:35:11.90,Default,,0,0,0,,Қақпа бұғаттап, бәрі сәтсіздікпен аяқталады.
Dialogue: 0,0:35:12.06,0:35:13.23,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:35:13.52,0:35:14.69,Default,,0,0,0,,Бұл қақпа ма?
Dialogue: 0,0:35:14.82,0:35:18.99,Default,,0,0,0,,Иә, сондықтан мен Антареске жете алмаймын.
Dialogue: 0,0:35:19.11,0:35:20.57,Default,,0,0,0,,Оны аша алмайсыз ба?
Dialogue: 0,0:35:20.78,0:35:22.41,Default,,0,0,0,,Біздің күшімізде
Dialogue: 0,0:35:30.87,0:35:32.04,Default,,0,0,0,,Артемида
Dialogue: 0,0:35:34.00,0:35:35.29,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:35:41.34,0:35:42.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:45.26,0:35:46.43,Default,,0,0,0,,Белл-кун, аа...
Dialogue: 0,0:35:47.56,0:35:48.72,Default,,0,0,0,,Лорд Гермес
Dialogue: 0,0:35:48.93,0:35:51.60,Default,,0,0,0,,Сондай-ақ құдайлардың бас қосуы туралы әңгімелер бар.
Dialogue: 0,0:35:51.73,0:35:53.27,Default,,0,0,0,,Мен сені жалғыз қалдырамын.
Dialogue: 0,0:35:53.86,0:35:55.98,Default,,0,0,0,,А... иә
Dialogue: 0,0:35:56.82,0:35:59.99,Default,,0,0,0,,Бұл жарық нені білдіреді?
Dialogue: 0,0:36:00.36,0:36:01.74,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:36:05.66,0:36:07.87,Default,,0,0,0,,Сіз сөзсіз Артемидасыз.
Dialogue: 0,0:36:08.16,0:36:10.12,Default,,0,0,0,,Бірақ Артемида емес
Dialogue: 0,0:36:11.12,0:36:12.83,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:36:16.29,0:36:19.92,Default,,0,0,0,,Бұл жер әлі де қалыпты, бірақ көп ұзамай тозып кетеді.
Dialogue: 0,0:36:20.59,0:36:24.68,Default,,0,0,0,,Осы жерден қирандыларға шабуыл жасауды жалғастырамыз.
Dialogue: 0,0:36:25.68,0:36:27.64,Default,,0,0,0,,Сіз ұзақ сапардан шаршадыңыз ба?
Dialogue: 0,0:36:27.89,0:36:30.81,Default,,0,0,0,,Алда суға түсетін бұлақ бар.
Dialogue: 0,0:36:30.93,0:36:33.31,Default,,0,0,0,,Бұл рас па? Бұл пайдалы
Dialogue: 0,0:36:33.44,0:36:35.02,Default,,0,0,0,,Терден жабысқақ.
Dialogue: 0,0:36:35.15,0:36:36.48,Default,,0,0,0,,Белл-кун, ә...
Dialogue: 0,0:36:38.69,0:36:39.73,Default,,0,0,0,,Лорд Гермес
Dialogue: 0,0:36:40.48,0:36:42.70,Default,,0,0,0,,Бұл қасиетті соғыстың басы.
Dialogue: 0,0:36:43.99,0:36:46.12,Default,,0,0,0,,Бүгін сен аңызға айналасың.
Dialogue: 0,0:36:46.82,0:36:48.58,Default,,0,0,0,,Егер тым алысқа кетсек, Радио ғимаратында дүрбелең болады,
Dialogue: 0,0:36:48.99,0:36:52.04,Default,,0,0,0,,Тереңде жайылғаны - қыздың жұмағы
Dialogue: 0,0:36:52.91,0:36:57.59,Default,,0,0,0,,Лили-чан мен Асфи туылғандай тазарып жатыр.
Dialogue: 0,0:36:59.96,0:37:01.38,Default,,0,0,0,,Және Артемида
Dialogue: 0,0:37:01.51,0:37:05.93,Default,,0,0,0,,Үш ұлы пәк құдайдың бірі болған оны киімі жоқ ешкім көрмеген.
Dialogue: 0,0:37:06.05,0:37:07.09,Default,,0,0,0,,Тіпті құдайлар
Dialogue: 0,0:37:07.72,0:37:09.72,Default,,0,0,0,,Менің арманым бір рет бұзылды
Dialogue: 0,0:37:09.85,0:37:13.56,Default,,0,0,0,,Бірақ жүрегім: «Мен бас тартқым келмейді» дейді.
Dialogue: 0,0:37:13.68,0:37:16.23,Default,,0,0,0,,Ал енді менде сен...
Dialogue: 0,0:37:16.35,0:37:18.52,Default,,0,0,0,,Менің пікірлес достарым бар
Dialogue: 0,0:37:19.02,0:37:22.36,Default,,0,0,0,,Біздің алдымызда тұрған қиыншылықтың шыңы.
Dialogue: 0,0:37:22.53,0:37:26.86,Default,,0,0,0,,Бірақ мұны жеңгенде, болашақ ұрпаққа із қалдырасыз.
Dialogue: 0,0:37:27.16,0:37:28.82,Default,,0,0,0,,Тұрыңдар, жастар
Dialogue: 0,0:37:28.95,0:37:30.95,Default,,0,0,0,,Нағыз батыр болу үшін!
Dialogue: 0,0:37:31.08,0:37:32.66,Default,,0,0,0,,Ооо
Dialogue: 0,0:37:32.79,0:37:34.62,Default,,0,0,0,,Уау, мен үйге барғым келеді
Dialogue: 0,0:37:34.91,0:37:37.08,Default,,0,0,0,,Аспан, міне!
Dialogue: 0,0:37:37.25,0:37:40.59,Default,,0,0,0,,Мақтанған батырларға сенімді жеңіс батасы
Dialogue: 0,0:37:40.71,0:37:42.51,Default,,0,0,0,,(Виолет) Мен шұғыл түрде бір нәрсені растауым керек!
Dialogue: 0,0:37:42.71,0:37:43.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:37:44.76,0:37:47.05,Default,,0,0,0,,Мен осындай нәрсе болар деп ойладым.
Dialogue: 0,0:37:47.18,0:37:49.97,Default,,0,0,0,,Мен оны сағындым, Уэлф мырза.
Dialogue: 0,0:37:50.14,0:37:51.89,Default,,0,0,0,,Ер адамдар ақымақ
Dialogue: 0,0:37:52.01,0:37:53.27,Default,,0,0,0,,Әр адамның жынысы
Dialogue: 0,0:37:55.39,0:37:56.94,Default,,0,0,0,,Ах... Кранель мырза жоқ.
Dialogue: 0,0:37:57.06,0:37:59.44,Default,,0,0,0,,Мистер Белл, кеттік.
Dialogue: 0,0:37:59.56,0:38:03.40,Default,,0,0,0,,Кедергілерімізді жеңіп, жеңіске жет!
Dialogue: 0,0:38:03.78,0:38:05.24,Default,,0,0,0,,Жеңіс... Ха...
Dialogue: 0,0:38:05.65,0:38:07.32,Default,,0,0,0,,Артемида мен Гестия туралы не деуге болады?
Dialogue: 0,0:38:07.45,0:38:10.37,Default,,0,0,0,,Не? Гестия-сама қазір еңбек демалысында.
Dialogue: 0,0:38:10.66,0:38:12.99,Default,,0,0,0,,Сіз Артемиданы білесіз бе?
Dialogue: 0,0:38:13.16,0:38:14.29,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:38:15.41,0:38:18.87,Default,,0,0,0,,Менің қарауға мүмкіндігім жоқ.
Dialogue: 0,0:38:19.71,0:38:23.34,Default,,0,0,0,,Бірақ әйтеуір бұл даму бұрын болған сияқты...
Dialogue: 0,0:38:39.77,0:38:41.02,Default,,0,0,0,,(шу)
Dialogue: 0,0:38:41.15,0:38:43.15,Default,,0,0,0,,Бұл кім? Ах! Мен... кешіріңіз.
Dialogue: 0,0:38:43.44,0:38:46.57,Default,,0,0,0,,Егер адасып қалсаңыз, кездейсоқ қарап қалмаңыз...
Dialogue: 0,0:38:46.78,0:38:48.53,Default,,0,0,0,,Какаши... Мен үйге бара жатырмын. Мені күт.
Dialogue: 0,0:38:52.16,0:38:55.95,Default,,0,0,0,,Ахахаха... сіз бақыттысыз
Dialogue: 0,0:38:56.66,0:38:59.62,Default,,0,0,0,,Баяғыда мен оны бірден жебемен атар едім.
Dialogue: 0,0:38:59.75,0:39:04.00,Default,,0,0,0,,Уф... Құдайдың әңгімесі рас еді, солай емес пе?
Dialogue: 0,0:39:04.34,0:39:05.96,Default,,0,0,0,,Келіңіздер ме? Сіз қалай ойлайсыз?
Dialogue: 0,0:39:06.26,0:39:09.30,Default,,0,0,0,,Мм... Ендеше, кәрі құдай.
Dialogue: 0,0:39:09.84,0:39:12.39,Default,,0,0,0,,Гестия-сама қазір басқаша болды ма?
Dialogue: 0,0:39:12.51,0:39:13.60,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:39:13.72,0:39:18.77,Default,,0,0,0,,Мен білетін Гестия өте жалқау және қиын.
Dialogue: 0,0:39:18.89,0:39:21.65,Default,,0,0,0,,А, бұл өзгермеген шығар.
Dialogue: 0,0:39:22.19,0:39:25.27,Default,,0,0,0,,Осыдан кейін мен ғибадатханаға жиі баратынмын.
Dialogue: 0,0:39:25.40,0:39:26.82,Default,,0,0,0,,Сіз жалқаусыз ба?
Dialogue: 0,0:39:27.03,0:39:30.15,Default,,0,0,0,,Әй, мен барсам, олар бақытты көрінеді.
Dialogue: 0,0:39:30.28,0:39:33.45,Default,,0,0,0,,Өзімен ойнағысы келген күшіктей ойнады.
Dialogue: 0,0:39:33.57,0:39:35.24,Default,,0,0,0,,Мен оны елестете аламын.
Dialogue: 0,0:39:35.37,0:39:36.45,Default,,0,0,0,,Гестия
Dialogue: 0,0:39:37.58,0:39:40.29,Default,,0,0,0,,Не болды? Мұндай жерде жалғыз
Dialogue: 0,0:39:40.96,0:39:42.42,Default,,0,0,0,,Бұл жай ғана серуендеу
Dialogue: 0,0:39:42.54,0:39:45.80,Default,,0,0,0,,Хм, жарамсыз найза бар ма?
Dialogue: 0,0:39:48.67,0:39:51.05,Default,,0,0,0,,Жарайды ма? Беллді іздеме
Dialogue: 0,0:39:51.84,0:39:55.22,Default,,0,0,0,,Мүмкін мен Артемидамен жалғыз қалармын.
Dialogue: 0,0:39:55.93,0:39:59.81,Default,,0,0,0,,Мен оны осылай жасауға тырыссам да, жиі айтамын.
Dialogue: 0,0:40:01.10,0:40:05.36,Default,,0,0,0,,Екі жүрек сөйлескен сайын найзаның күші де күшейе түседі.
Dialogue: 0,0:40:06.77,0:40:09.07,Default,,0,0,0,,Сіз білесіз бе? гестиа
Dialogue: 0,0:40:11.65,0:40:12.99,Default,,0,0,0,,Біз оның жайлы өте аз білеміз… Бұл не, мырза Ринатаки?
Dialogue: 0,0:40:13.95,0:40:16.20,Default,,0,0,0,,Бұл найзаны шынымен пайдалану керек пе?
Dialogue: 0,0:40:16.33,0:40:17.37,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:40:17.79,0:40:19.83,Default,,0,0,0,,Басқа жолдар болуы мүмкін
Dialogue: 0,0:40:20.33,0:40:23.12,Default,,0,0,0,,Бірге жұмыс жасасақ, әрине...
Dialogue: 0,0:40:23.25,0:40:24.79,Default,,0,0,0,,Хестия...
Dialogue: 0,0:40:27.21,0:40:30.88,Default,,0,0,0,,Уақыт немесе әдіс жоқ.
Dialogue: 0,0:40:33.05,0:40:36.43,Default,,0,0,0,,Өйткені қазір Артемида
Dialogue: 0,0:40:37.68,0:40:40.27,Default,,0,0,0,,Бұрынғыдан басқа, бірақ басқаша.
Dialogue: 0,0:40:41.10,0:40:42.35,Default,,0,0,0,,Сізді күттіріп қойдым ба?
Dialogue: 0,0:40:44.52,0:40:46.65,Default,,0,0,0,,Артемиданы аяймын.
Dialogue: 0,0:40:47.23,0:40:49.65,Default,,0,0,0,,Сонымен, сіз найзаны батыруға тырыстыңыз ба?
Dialogue: 0,0:40:53.53,0:40:56.03,Default,,0,0,0,,Гестия өте мейірімді.
Dialogue: 0,0:41:02.25,0:41:05.92,Default,,0,0,0,,Әрқашан бірге жылап, бірге қуаныңыз
Dialogue: 0,0:41:06.04,0:41:08.54,Default,,0,0,0,,Күлімсіреген Гестияға
Dialogue: 0,0:41:08.88,0:41:12.84,Default,,0,0,0,,Мен оның мейірімділігіне тәнті болдым.
Dialogue: 0,0:41:14.43,0:41:17.18,Default,,0,0,0,,Мен де Құдайды жақсы көремін
Dialogue: 0,0:41:19.89,0:41:22.60,Default,,0,0,0,,Сізді қатысқаным үшін кешіріңіз.
Dialogue: 0,0:41:22.73,0:41:23.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:24.48,0:41:27.56,Default,,0,0,0,,Мен саған қатаңдық көрсетемін.
Dialogue: 0,0:41:27.69,0:41:29.57,Default,,0,0,0,,Бұл... Жарайды.
Dialogue: 0,0:41:29.98,0:41:33.07,Default,,0,0,0,,Қандай құбыжық көрінсе де, мен оны міндетті түрде жеңемін.
Dialogue: 0,0:41:33.69,0:41:35.99,Default,,0,0,0,,Мен сені міндетті түрде қорғаймын
Dialogue: 0,0:41:38.24,0:41:40.08,Default,,0,0,0,,Сіз батырға ұқсайсыз.
Dialogue: 0,0:41:40.20,0:41:42.41,Default,,0,0,0,,Иә! Жоқ, солай...
Dialogue: 0,0:41:42.62,0:41:46.25,Default,,0,0,0,,Батырлық ертегілерді бала кезімде оқыдым, бірақ маған ұнады.
Dialogue: 0,0:41:51.21,0:41:53.05,Default,,0,0,0,,Мен батырларға тәнтімін
Dialogue: 0,0:41:54.05,0:41:58.34,Default,,0,0,0,,Кез келген құбыжықты жеңіңіз, кез келген қиындықты жеңіңіз
Dialogue: 0,0:41:59.51,0:42:01.81,Default,,0,0,0,,Көп адамға күлкі сыйла
Dialogue: 0,0:42:03.60,0:42:05.56,Default,,0,0,0,,Қай жерде де қайғылы кейіпкерлер жоқ.
Dialogue: 0,0:42:08.06,0:42:09.44,Default,,0,0,0,,үшінн сақтаңыз
Dialogue: 0,0:42:11.23,0:42:13.48,Default,,0,0,0,,Мен сондай батыр болғым келеді.
Dialogue: 0,0:42:14.36,0:42:16.57,Default,,0,0,0,,Мен түсіндім деп ойлаймын, иә?
Dialogue: 0,0:42:18.20,0:42:21.91,Default,,0,0,0,,Неліктен Гестия сізбен бірге болғанына қуанышты сияқты?
Dialogue: 0,0:42:22.74,0:42:25.50,Default,,0,0,0,,Ол сені ұнататын шығар.
Dialogue: 0,0:42:25.62,0:42:29.50,Default,,0,0,0,,Иә!? Жақсы... мүмкін емес! Богиня маған не дейді...
Dialogue: 0,0:42:29.63,0:42:33.88,Default,,0,0,0,,Хе-хе... Менің ойымша, сіз солай айттыңыз.
Dialogue: 0,0:42:34.13,0:42:36.51,Default,,0,0,0,,Бәйбішесі де қыз.
Dialogue: 0,0:42:38.59,0:42:43.22,Default,,0,0,0,,Менде Құдай туралы тым көп елес бар.
Dialogue: 0,0:42:46.02,0:42:47.77,Default,,0,0,0,,Мен тазалықтың Құдайымын
Dialogue: 0,0:42:48.48,0:42:53.40,Default,,0,0,0,,Ол еркек пен әйелдің арасындағы махаббатқа жол бермеді, тіпті олармен араласуды да жек көретін.
Dialogue: 0,0:42:53.98,0:42:57.19,Default,,0,0,0,,Бірақ бір күні балалар маған айтты
Dialogue: 0,0:42:58.24,0:43:00.03,Default,,0,0,0,,Махаббат керемет
Dialogue: 0,0:43:01.20,0:43:04.37,Default,,0,0,0,,Енді мен мұны аздап түсіндім.
Dialogue: 0,0:43:16.26,0:43:17.26,Default,,0,0,0,,Би билейік
Dialogue: 0,0:43:17.38,0:43:20.76,Default,,0,0,0,,♪～
Dialogue: 0,0:44:38.09,0:44:39.46,Default,,0,0,0,,Сонымен, неге қарғыс энергиясы кешігіп жатыр?
Dialogue: 0,0:44:40.17,0:44:45.43,Default,,0,0,0,,Төменгі әлемге түскен құдайлар 10 000 жыл махаббаттан ләззат алады дейді.
Dialogue: 0,0:44:46.64,0:44:48.56,Default,,0,0,0,,10 000 жылдық махаббат?
Dialogue: 0,0:44:50.18,0:44:51.89,Default,,0,0,0,,Сен қайта туылғансың
Dialogue: 0,0:44:52.89,0:44:55.27,Default,,0,0,0,,Балаларға деген мәңгілік махаббат
Dialogue: 0,0:44:56.44,0:44:57.52,Default,,0,0,0,,Орион
Dialogue: 0,0:44:58.77,0:45:01.11,Default,,0,0,0,,Сізді кездестіргеніме қуаныштымын
Dialogue: 0,0:45:01.57,0:45:04.57,Default,,0,0,0,,～♪
Dialogue: 0,0:45:22.59,0:45:23.97,Default,,0,0,0,,Бәрімізге белгілі
Dialogue: 0,0:45:24.47,0:45:27.47,Default,,0,0,0,,Үйінділердің айналасы құбыжықтар ұясына айналды.
Dialogue: 0,0:45:28.22,0:45:32.22,Default,,0,0,0,,Антарес осы сәтте де өз күшін жинап жатыр.
Dialogue: 0,0:45:32.68,0:45:37.27,Default,,0,0,0,,Алдымызда қиындықтар болатыны сөзсіз.
Dialogue: 0,0:45:37.52,0:45:40.32,Default,,0,0,0,,Бірақ қорықпа, қорықпа
Dialogue: 0,0:45:40.86,0:45:42.48,Default,,0,0,0,,Жеңіліс қабылданбайды
Dialogue: 0,0:45:43.36,0:45:45.57,Default,,0,0,0,,Енді маған стратегияны айтыңыз.
Dialogue: 0,0:45:46.41,0:45:48.24,Default,,0,0,0,,Hermes Familia – жаудың диверсиясы
Dialogue: 0,0:45:48.99,0:45:51.87,Default,,0,0,0,,Тек оны тартуға тырысыңыз, ешқашан мәжбүрлемеңіз.
Dialogue: 0,0:45:51.99,0:45:52.83,Default,,0,0,0,,Иә
Dialogue: 0,0:45:52.95,0:45:53.95,Default,,0,0,0,,Фальгар (Фальгар) Иә
Dialogue: 0,0:45:54.25,0:45:56.04,Default,,0,0,0,,Пәрменді сізге қалдырамын.
Dialogue: 0,0:45:56.17,0:45:57.33,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:45:59.08,0:46:02.59,Default,,0,0,0,,Ал диверсиялық күштер жауды өзіне тартып жатқанда —
Dialogue: 0,0:46:02.71,0:46:04.59,Default,,0,0,0,,Біз ішке кіреміз
Dialogue: 0,0:46:04.72,0:46:05.92,Default,,0,0,0,,Антаресті жеңу
Dialogue: 0,0:46:06.05,0:46:06.88,Default,,0,0,0,,Біз?
Dialogue: 0,0:46:07.38,0:46:10.35,Default,,0,0,0,,Ол қақпаны менің құдайлық құдіретім ғана ашады.
Dialogue: 0,0:46:10.85,0:46:12.81,Default,,0,0,0,,Мен де барамын, Артемида.
Dialogue: 0,0:46:13.18,0:46:14.56,Default,,0,0,0,,Дәл солай. Кирамен «Джайентс» матчында кездесу идеясы тым ашық,
Dialogue: 0,0:46:16.64,0:46:19.44,Default,,0,0,0,,Мен сені жалғыз қалдыра алмаймын.
Dialogue: 0,0:46:19.56,0:46:22.52,Default,,0,0,0,,Олай болса, әрине, соңынан еремін.
Dialogue: 0,0:46:22.65,0:46:25.11,Default,,0,0,0,,Эй, Гермес-сама, тағы да солай...
Dialogue: 0,0:46:25.65,0:46:28.86,Default,,0,0,0,,Хахаха... Бұлай болатынын білсем де.
Dialogue: 0,0:46:28.99,0:46:30.49,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:46:30.62,0:46:32.24,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:46:32.70,0:46:34.16,Default,,0,0,0,,Тек орындайық.
Dialogue: 0,0:46:34.29,0:46:36.50,Default,,0,0,0,,Мен ерекше сыйлық күтемін.
Dialogue: 0,0:46:36.62,0:46:38.67,Default,,0,0,0,,Біз ақшаға талғампазбыз.
Dialogue: 0,0:46:38.79,0:46:40.58,Default,,0,0,0,,Әрине Лили және басқалары.
Dialogue: 0,0:46:40.71,0:46:42.13,Default,,0,0,0,,Лилисуке, бұл сенсің.
Dialogue: 0,0:46:42.25,0:46:45.05,Default,,0,0,0,,Бұл заңды құқық.
Dialogue: 0,0:46:46.13,0:46:47.59,Default,,0,0,0,,Рахмет балалар
Dialogue: 0,0:46:49.76,0:46:51.76,Default,,0,0,0,,Бұл қиын шайқас болады
Dialogue: 0,0:46:52.14,0:46:53.76,Default,,0,0,0,,Зардап шеккендер болуы мүмкін
Dialogue: 0,0:46:54.10,0:46:55.72,Default,,0,0,0,,Бірақ мен сенің оны орындағаныңды қалаймын.
Dialogue: 0,0:46:56.48,0:46:58.64,Default,,0,0,0,,Біздің сүйікті төменгі әлем үшін
Dialogue: 0,0:46:58.77,0:47:00.35,Default,,0,0,0,,Ооо
Dialogue: 0,0:47:00.48,0:47:01.69,Default,,0,0,0,,Кеттік
Dialogue: 0,0:47:02.19,0:47:03.52,Default,,0,0,0,,Уау
Dialogue: 0,0:47:03.65,0:47:04.78,Default,,0,0,0,,Не, не?
Dialogue: 0,0:47:08.03,0:47:11.28,Default,,0,0,0,,Осындай ақымақ құбыжықтың тосын шабуылы!?
Dialogue: 0,0:47:12.20,0:47:14.16,Default,,0,0,0,,Қарсысыз ба? Бұл жоспарланғандай.
Dialogue: 0,0:47:14.28,0:47:16.83,Default,,0,0,0,,Шынымен! Сәл ерте
Dialogue: 0,0:47:17.04,0:47:18.54,Default,,0,0,0,,Жолды ашыңыз
Dialogue: 0,0:47:19.83,0:47:21.21,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,0:47:23.54,0:47:26.59,Default,,0,0,0,,Асфи, жүр, сенің рөлің бұл жерде жоқ.
Dialogue: 0,0:47:27.76,0:47:28.76,Default,,0,0,0,,Хмф!
Dialogue: 0,0:47:33.89,0:47:35.56,Default,,0,0,0,,Мен оны сұрадым, Асфи.
Dialogue: 0,0:47:45.73,0:47:48.07,Default,,0,0,0,,Мен мұндай қирандылардың болғанына сене алар емеспін.
Dialogue: 0,0:47:48.24,0:47:49.32,Default,,0,0,0,,Үлкен
Dialogue: 0,0:47:51.41,0:47:54.37,Default,,0,0,0,,Тарих ұмытқан көне храмдар
Dialogue: 0,0:47:57.41,0:47:58.83,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:47:59.83,0:48:03.54,Default,,0,0,0,,Бұрынғы күтпеген шабуыл да бар, сондықтан сақтығыңызды төмендетпеңіз.
Dialogue: 0,0:48:04.17,0:48:05.29,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:48:13.59,0:48:14.89,Default,,0,0,0,,Бұл қандай жарық?
Dialogue: 0,0:48:15.01,0:48:16.18,Default,,0,0,0,,Бұл тығыздағыш шам.
Dialogue: 0,0:48:17.10,0:48:20.48,Default,,0,0,0,,Мұны мен сияқты рухтар жасады.
Dialogue: 0,0:48:20.98,0:48:24.44,Default,,0,0,0,,Менің ең үлкен отбасым, былайша айтқанда.
Dialogue: 0,0:48:24.86,0:48:26.48,Default,,0,0,0,,Содан бері
Dialogue: 0,0:48:28.82,0:48:29.86,Default,,0,0,0,,келді
Dialogue: 0,0:48:31.15,0:48:33.74,Default,,0,0,0,,Бұл мен айтқан мөрленген қақпа.
Dialogue: 0,0:48:34.74,0:48:36.66,Default,,0,0,0,,Ақырында осында ма?
Dialogue: 0,0:48:37.03,0:48:39.04,Default,,0,0,0,,Антарес артта қалды...
Dialogue: 0,0:49:04.10,0:49:05.15,Default,,0,0,0,,Ха…
Dialogue: 0,0:49:06.44,0:49:07.86,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:49:08.69,0:49:10.32,Default,,0,0,0,,Ғибадатхананы жұқтыру
Dialogue: 0,0:49:14.49,0:49:15.70,Default,,0,0,0,,Бұл...
Dialogue: 0,0:49:16.45,0:49:19.12,Default,,0,0,0,,Мен оның осы деңгейге жетеді деп күткен жоқпын.
Dialogue: 0,0:49:19.58,0:49:20.99,Default,,0,0,0,,Ха…
Dialogue: 0,0:49:22.20,0:49:23.25,Default,,0,0,0,,Шығу ше?!
Dialogue: 0,0:49:25.04,0:49:26.42,Default,,0,0,0,,(жұмыртқа сынған дыбыс)
Dialogue: 0,0:49:34.97,0:49:35.80,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:49:36.26,0:49:38.43,Default,,0,0,0,,Мұның бәрі жұмыртқа!?
Dialogue: 0,0:49:44.89,0:49:45.73,Default,,0,0,0,,Жарып өту
Dialogue: 0,0:49:47.27,0:49:48.81,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,0:49:56.20,0:49:57.16,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:49:57.91,0:49:58.91,Default,,0,0,0,,Жақсы қыз бол және барынша тырыс, жарай ма?
Dialogue: 0,0:49:59.03,0:49:59.95,Default,,0,0,0,,Ха!
Dialogue: 0,0:50:06.08,0:50:06.92,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:50:08.50,0:50:09.33,Default,,0,0,0,,Артқа шегініңіз.
Dialogue: 0,0:50:18.47,0:50:20.39,Default,,0,0,0,,Амал жоқ... (Вэлф) Шыдадың ба?
Dialogue: 0,0:50:21.39,0:50:24.60,Default,,0,0,0,,Болды...жарылған май жұмыс істемейді.
Dialogue: 0,0:50:25.31,0:50:27.89,Default,,0,0,0,,Өзіндік таралу Өзіндік эволюция
Dialogue: 0,0:50:28.69,0:50:32.98,Default,,0,0,0,,Бұл жағдайда тіпті қалыпты емес жылдамдықпен қозғала ма?
Dialogue: 0,0:50:37.65,0:50:39.61,Default,,0,0,0,,(айқай)
Dialogue: 0,0:50:44.75,0:50:46.66,Default,,0,0,0,,Кел, адасқан жел
Dialogue: 0,0:50:47.16,0:50:50.58,Default,,0,0,0,,Кезбе серік, Аспаннан өтіп, айдалада жүгіру
Dialogue: 0,0:50:50.71,0:50:52.59,Default,,0,0,0,,Басқаларға қарағанда жылдам жүгіру
Dialogue: 0,0:50:53.59,0:50:57.13,Default,,0,0,0,,Жауды жұлдызды шаңмен жеңу
Dialogue: 0,0:50:57.42,0:50:59.22,Default,,0,0,0,,Жарқыраған жел
Dialogue: 0,0:51:04.85,0:51:05.81,Default,,0,0,0,,Тиіп көр!
Dialogue: 0,0:51:06.35,0:51:08.89,Default,,0,0,0,,Жоқ, мен әлі тірімін.
Dialogue: 0,0:51:11.73,0:51:15.53,Default,,0,0,0,,Осы қарқынмен ол зынданнан да көп болады.
Dialogue: 0,0:51:19.45,0:51:21.45,Default,,0,0,0,,Иә? Бұл кенеттен не болды деп ойлаймын
Dialogue: 0,0:51:22.66,0:51:25.37,Default,,0,0,0,,Не болды? Қайғылы жүзбен
Dialogue: 0,0:51:26.45,0:51:27.33,Default,,0,0,0,,Бұл…
Dialogue: 0,0:51:27.45,0:51:29.62,Default,,0,0,0,,Ах~ Ол бұзылған.
Dialogue: 0,0:51:29.75,0:51:32.71,Default,,0,0,0,,А, маған қатты ұнады.
Dialogue: 0,0:51:33.17,0:51:34.54,Default,,0,0,0,,Эй, иә?
Dialogue: 0,0:51:35.00,0:51:38.80,Default,,0,0,0,,Мен Эйнаның інісін соңғы кезде көрмедім, ол не істеп жүр?
Dialogue: 0,0:51:38.92,0:51:39.76,Default,,0,0,0,,Иә
Dialogue: 0,0:51:40.34,0:51:42.68,Default,,0,0,0,,Hermes Familia квестін қабылдау
Dialogue: 0,0:51:42.80,0:51:44.68,Default,,0,0,0,,Мен Орарионың сыртында жүрген сияқтымын.
Dialogue: 0,0:51:44.81,0:51:46.14,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:51:46.26,0:51:48.02,Default,,0,0,0,,Иә? Бірақ қазір
Dialogue: 0,0:51:48.14,0:51:52.15,Default,,0,0,0,,Авантюристерге Орарионың сыртына шықпауға нұсқау берілген, солай ма?
Dialogue: 0,0:51:52.27,0:51:53.23,Default,,0,0,0,,Иә
Dialogue: 0,0:51:55.40,0:51:57.03,Default,,0,0,0,,Сен жақсы боласың, иә?
Dialogue: 0,0:51:57.15,0:51:58.36,Default,,0,0,0,,Сәлем
Dialogue: 0,0:51:58.49,0:52:00.86,Default,,0,0,0,,Біртүрлі емес пе? (Әйел) Неге? Бұл біртүрлі
Dialogue: 0,0:52:01.28,0:52:02.45,Default,,0,0,0,,Жалпы алғанда, сол хабар тарату мұнарасынан өткеннен кейін сигнал әдетте жақсы болады
Dialogue: 0,0:52:04.16,0:52:06.66,Default,,0,0,0,,Өйткені кешеге дейін... (Еркек) Біртүрлі деп ойладым.
Dialogue: 0,0:52:06.79,0:52:08.04,Default,,0,0,0,,Тіпті бағыт
Dialogue: 0,0:52:08.41,0:52:10.58,Default,,0,0,0,,Бұл не? Не айтқың келеді?
Dialogue: 0,0:52:10.71,0:52:12.96,Default,,0,0,0,,Жоқ, жасама!
Dialogue: 0,0:52:15.34,0:52:17.46,Default,,0,0,0,,Не болды? сондай асығыс
Dialogue: 0,0:52:18.09,0:52:20.47,Default,,0,0,0,,А... Сағыз... Иә?
Dialogue: 0,0:52:20.59,0:52:21.68,Default,,0,0,0,,Арматуралар
Dialogue: 0,0:52:22.01,0:52:25.80,Default,,0,0,0,,Авантюристке тез қоңырау шалыңыз... жоқ, бірінші дәрежелі авантюристке қоңырау шалыңыз.
Dialogue: 0,0:52:25.97,0:52:29.43,Default,,0,0,0,,О... сабыр етіңізші. Не болды?
Dialogue: 0,0:52:29.77,0:52:31.60,Default,,0,0,0,,Біз оны енді көтере алмаймыз.
Dialogue: 0,0:52:32.14,0:52:33.56,Default,,0,0,0,,Құбыжық...
Dialogue: 0,0:52:34.19,0:52:36.02,Default,,0,0,0,,(Авантюристтердің айқайы)
Dialogue: 0,0:52:36.52,0:52:39.53,Default,,0,0,0,,Зынданда құбыжықтар есінен танып барады.
Dialogue: 0,0:52:39.69,0:52:41.19,Default,,0,0,0,,Бұл жай ғана мәселе емес
Dialogue: 0,0:52:41.32,0:52:45.16,Default,,0,0,0,,Бір нәрсені тез жасамасақ, бәрі қайтымсыз болады.
Dialogue: 0,0:52:47.08,0:52:48.24,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:52:48.91,0:52:50.00,Default,,0,0,0,,Мистер Белл
Dialogue: 0,0:52:59.92,0:53:01.26,Default,,0,0,0,,Отты болт
Dialogue: 0,0:53:05.64,0:53:09.01,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:53:11.43,0:53:13.48,Default,,0,0,0,,Құрметті Белл, бұл Эликсир.
Dialogue: 0,0:53:13.60,0:53:14.94,Default,,0,0,0,,Рахмет саған Лили
Dialogue: 0,0:53:15.06,0:53:18.94,Default,,0,0,0,,(Антарес ырылдады)
Dialogue: 0,0:53:20.57,0:53:21.44,Default,,0,0,0,,Бұл...
Dialogue: 0,0:53:22.82,0:53:23.90,Default,,0,0,0,,Жабу
Dialogue: 0,0:53:26.36,0:53:27.57,Default,,0,0,0,,Артемида
Dialogue: 0,0:53:27.70,0:53:28.87,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:53:30.54,0:53:31.49,Default,,0,0,0,,Бірақ ішіндегі адамның жейіліп жатқанын шынымен көрдің бе?
Dialogue: 0,0:53:36.46,0:53:37.29,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:53:46.43,0:53:47.43,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:53:48.22,0:53:51.89,Default,,0,0,0,,Жарайды, қазір үйге қайтайық.
Dialogue: 0,0:53:52.27,0:53:55.39,Default,,0,0,0,,Мен... бірдеңе істейміз.
Dialogue: 0,0:53:56.14,0:53:57.23,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:54:00.65,0:54:03.78,Default,,0,0,0,,Артемис Мен сен туралы ойлаймын...
Dialogue: 0,0:54:09.57,0:54:11.37,Default,,0,0,0,,Гестияға рахмет
Dialogue: 0,0:54:27.80,0:54:30.89,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:54:43.94,0:54:46.24,Default,,0,0,0,,Бұл Антарес
Dialogue: 0,0:54:46.36,0:54:49.74,Default,,0,0,0,,Шыу!
Dialogue: 0,0:54:59.96,0:55:01.88,Default,,0,0,0,,Ух... Артемида-сама
Dialogue: 0,0:55:02.84,0:55:05.80,Default,,0,0,0,,Мені атып тасташы, Орион.
Dialogue: 0,0:55:06.42,0:55:07.34,Default,,0,0,0,,Бұл
Dialogue: 0,0:55:11.93,0:55:13.30,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:55:14.14,0:55:15.10,Default,,0,0,0,,Бұл...
Dialogue: 0,0:55:15.22,0:55:16.10,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:55:16.22,0:55:17.77,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:55:17.93,0:55:19.39,Default,,0,0,0,,Бір түнде, 452 адамнан тұратын тұрғындардың арасынан—
Dialogue: 0,0:55:20.02,0:55:21.19,Default,,0,0,0,,Неге...
Dialogue: 0,0:55:30.53,0:55:31.82,Default,,0,0,0,,Неліктен
Dialogue: 0,0:55:33.20,0:55:34.91,Default,,0,0,0,,Артемида ханым...
Dialogue: 0,0:55:48.30,0:55:49.22,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:55:51.63,0:55:52.47,Default,,0,0,0,,Не?
Dialogue: 0,0:56:20.16,0:56:22.17,Default,,0,0,0,,Лилиске Лилиске
Dialogue: 0,0:56:23.63,0:56:24.75,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:56:24.96,0:56:27.21,Default,,0,0,0,,Құрметті Уэлф, сіз ше?
Dialogue: 0,0:56:27.42,0:56:29.09,Default,,0,0,0,,Олар қарт адамды шынымен сынап жатыр
Dialogue: 0,0:56:29.30,0:56:31.09,Default,,0,0,0,,Бұл Арканум Құдайдың құдіреті
Dialogue: 0,0:56:31.59,0:56:33.34,Default,,0,0,0,,Неліктен құбыжық мұндай күшке ие?
Dialogue: 0,0:56:34.14,0:56:36.30,Default,,0,0,0,,Өйткені Артемиданы жеп қойған.
Dialogue: 0,0:56:38.35,0:56:39.39,Default,,0,0,0,,Ха…
Dialogue: 0,0:56:41.89,0:56:45.48,Default,,0,0,0,,Ха... Вельф-сама, Белл-сама мен Артемида-сама ше?
Dialogue: 0,0:56:46.61,0:56:47.44,Default,,0,0,0,,Мұнда емес
Dialogue: 0,0:56:48.48,0:56:49.86,Default,,0,0,0,,Мүмкін төменірек.
Dialogue: 0,0:56:51.40,0:56:52.57,Default,,0,0,0,,Мистер Белл
Dialogue: 0,0:56:58.58,0:57:00.58,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:57:01.25,0:57:03.12,Default,,0,0,0,,Менің балаларым
Dialogue: 0,0:57:07.88,0:57:09.71,Default,,0,0,0,,Менің қолымнан бар болғаны қарау ғана болды.
Dialogue: 0,0:57:12.05,0:57:15.68,Default,,0,0,0,,Мені жегеннің балаларды өлтіргенін көрдім.
Dialogue: 0,0:57:16.97,0:57:19.72,Default,,0,0,0,,Өз қолыммен өлтіремін деп
Dialogue: 0,0:57:26.52,0:57:28.06,Default,,0,0,0,,Мен қайтып келдім
Dialogue: 0,0:57:29.44,0:57:32.53,Default,,0,0,0,,Енді мұнда сіз ше?
Dialogue: 0,0:57:34.49,0:57:36.24,Default,,0,0,0,,Мен тұнбамын
Dialogue: 0,0:57:38.66,0:57:41.41,Default,,0,0,0,,Ол найзаның ішінде орналасқан ой нысаны.
Dialogue: 0,0:57:42.04,0:57:44.04,Default,,0,0,0,,Бәйбішенің қалдықтары, былайша айтқанда
Dialogue: 0,0:57:45.50,0:57:49.54,Default,,0,0,0,,Ол Артемида емес, Артемида
Dialogue: 0,0:57:50.55,0:57:51.92,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:57:52.34,0:57:55.55,Default,,0,0,0,,Тәңір құдіретін бойына сіңірген Антарес,
Dialogue: 0,0:57:55.72,0:57:57.84,Default,,0,0,0,,Барлық ережелерді бүгіңіз
Dialogue: 0,0:57:59.39,0:58:03.35,Default,,0,0,0,,Бұл... Бұл мүмкін емес, солай емес пе?
Dialogue: 0,0:58:03.48,0:58:05.48,Default,,0,0,0,,Лили мен басқалары табысқа жете алмайды.
Dialogue: 0,0:58:05.73,0:58:07.94,Default,,0,0,0,,Құдайлар, бірдеңе жасашы
Dialogue: 0,0:58:08.06,0:58:09.44,Default,,0,0,0,,Кешіріңіз, иә?
Dialogue: 0,0:58:11.52,0:58:12.36,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:58:12.48,0:58:16.49,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:58:21.33,0:58:22.66,Default,,0,0,0,,Бұл зейінімді басқа жаққа бұрады, сондықтан кетші.
Dialogue: 0,0:58:22.99,0:58:24.16,Default,,0,0,0,,Хокс та керемет болды.
Dialogue: 0,0:58:24.50,0:58:26.08,Default,,0,0,0,,Екі ай?
Dialogue: 0,0:58:26.21,0:58:27.54,Default,,0,0,0,,Жоқ (Өмір) Иә?
Dialogue: 0,0:58:28.88,0:58:30.34,Default,,0,0,0,,Бұл ай емес
Dialogue: 0,0:58:44.43,0:58:45.31,Default,,0,0,0,,Не? Яғни
Dialogue: 0,0:58:45.73,0:58:47.35,Default,,0,0,0,,Мүмкін Арканум
Dialogue: 0,0:58:48.19,0:58:49.02,Default,,0,0,0,,Және…
Dialogue: 0,0:58:50.19,0:58:52.98,Default,,0,0,0,,Бұл Артемиданың көрсеткісі
Dialogue: 0,0:58:54.40,0:58:59.28,Default,,0,0,0,,Тазалық құдайы атқан аспандағы ең күшті жебе
Dialogue: 0,0:59:00.53,0:59:01.91,Default,,0,0,0,,Мен мұны түсінемін.
Dialogue: 0,0:59:02.37,0:59:05.87,Default,,0,0,0,,Төменгі дүниеде мұндай боқтық күш, ережені анық бұзу.
Dialogue: 0,0:59:06.00,0:59:07.62,Default,,0,0,0,,Артемиданың ақымақ оны пайдаланса...
Dialogue: 0,0:59:07.75,0:59:10.42,Default,,0,0,0,,Оны баяғыда көкке қайтару керек емес пе еді?
Dialogue: 0,0:59:11.79,0:59:15.17,Default,,0,0,0,,Әлде бір нәрсеге әуестенесіз бе?
Dialogue: 0,0:59:15.30,0:59:17.84,Default,,0,0,0,,Міне, осылайша-ақ қырылып қалады!
Dialogue: 0,0:59:17.97,0:59:19.76,Default,,0,0,0,,Зынданда дірілдейді
Dialogue: 0,0:59:21.01,0:59:22.64,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:59:24.81,0:59:28.48,Default,,0,0,0,,Егер бұл іске қосылса, төменгі әлем ұшып кетеді.
Dialogue: 0,0:59:29.35,0:59:33.11,Default,,0,0,0,,Жер үстіндегі құбыжықтарды басып алу - төменгі әлем үшін ең нашар сценарий.
Dialogue: 0,0:59:33.52,0:59:36.61,Default,,0,0,0,,Ұрыс айқайын көтеріңіз, бұл авантюристер қаласы.
Dialogue: 0,0:59:36.90,0:59:38.95,Default,,0,0,0,,Құбыжықтар сізді басып кетуіне жол бермеңіз
Dialogue: 0,0:59:39.65,0:59:42.57,Default,,0,0,0,,Бір ғана нәрсе істеу керек: қорғаныс!
Dialogue: 0,0:59:42.78,0:59:44.49,Default,,0,0,0,,Ооо
Dialogue: 0,0:59:58.59,0:59:59.92,Default,,0,0,0,,Уран қарт адам
Dialogue: 0,1:00:00.47,1:00:01.97,Default,,0,0,0,,Мен бұлай болатынын білдім.
Dialogue: 0,1:00:02.09,1:00:04.14,Default,,0,0,0,,Сіз бізді Орариодан шығармауыңыз керек еді.
Dialogue: 0,1:00:04.26,1:00:05.26,Default,,0,0,0,,Бұл пайдасыз.
Dialogue: 0,1:00:06.39,1:00:10.60,Default,,0,0,0,,Орариодағы барлық құдайлар қосылса да, мен оны жеңе алмаймын.
Dialogue: 0,1:00:10.73,1:00:12.56,Default,,0,0,0,,Сіз білесіз бе! Тіпті егер ол -
Dialogue: 0,1:00:12.69,1:00:14.90,Default,,0,0,0,,Біз ғана жасай аламыз.
Dialogue: 0,1:00:16.86,1:00:18.78,Default,,0,0,0,,Оттар Ха!
Dialogue: 0,1:00:18.94,1:00:20.07,Default,,0,0,0,,Барыңыз
Dialogue: 0,1:00:20.65,1:00:22.11,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,1:00:22.24,1:00:23.07,Default,,0,0,0,,Иә
Dialogue: 0,1:00:24.24,1:00:27.04,Default,,0,0,0,,Оны сізге қалдырудан басқа амалым жоқ.
Dialogue: 0,1:00:29.95,1:00:31.87,Default,,0,0,0,,Оны жеңудің бір ғана жолы бар
Dialogue: 0,1:00:32.37,1:00:33.75,Default,,0,0,0,,Бұл найза ма?
Dialogue: 0,1:00:34.04,1:00:36.63,Default,,0,0,0,,Бұл дәл найза емес, жебе.
Dialogue: 0,1:00:37.50,1:00:40.80,Default,,0,0,0,,Ішке кірер алдында... Әлде кейін бе?
Dialogue: 0,1:00:41.13,1:00:43.34,Default,,0,0,0,,Артемида өзіне қалдырған күшін пайдаланады...
Dialogue: 0,1:00:44.01,1:00:46.05,Default,,0,0,0,,Мен бұл жебені осы жерге шақырдым.
Dialogue: 0,1:00:46.64,1:00:48.06,Default,,0,0,0,,Құдайдың қаруы
Dialogue: 0,1:00:48.18,1:00:49.72,Default,,0,0,0,,Құдай жаратқан қару?
Dialogue: 0,1:00:49.89,1:00:51.77,Default,,0,0,0,,Мен мұны Гефесттен естідім.
Dialogue: 0,1:00:52.77,1:00:57.19,Default,,0,0,0,,Аспандағы құдайларды да өлтіре алатын қару
Dialogue: 0,1:01:02.15,1:01:03.78,Default,,0,0,0,,Оның аты Орион
Dialogue: 0,1:01:04.78,1:01:08.41,Default,,0,0,0,,Тәңір тілінде «ататын» деген мағынаны білдіреді
Dialogue: 0,1:01:10.75,1:01:12.71,Default,,0,0,0,,Қазір қозғалуды тоқтатқанымен
Dialogue: 0,1:01:12.83,1:01:15.83,Default,,0,0,0,,Жақында Антарес осында болады
Dialogue: 0,1:01:19.88,1:01:24.01,Default,,0,0,0,,Антарес құбыжық болғанымен, құдайдың құдіретіне ие болды.
Dialogue: 0,1:01:24.72,1:01:26.84,Default,,0,0,0,,Қайшылықтарға толы апат
Dialogue: 0,1:01:28.35,1:01:33.10,Default,,0,0,0,,Оны көмудің жалғыз жолы - ережелерді бұрап, оларды осы көрсеткі арқылы тесу.
Dialogue: 0,1:01:39.52,1:01:40.65,Default,,0,0,0,,Бұл көрсеткі ме?
Dialogue: 0,1:01:41.23,1:01:43.61,Default,,0,0,0,,Сіз оны уақытында жасайсыз ба? Гермес
Dialogue: 0,1:01:45.45,1:01:46.36,Default,,0,0,0,,Келесі шайқас үшін!
Dialogue: 0,1:01:48.78,1:01:49.95,Default,,0,0,0,,Асфи
Dialogue: 0,1:01:50.16,1:01:52.33,Default,,0,0,0,,Бұл дүниенің тағдыры...
Dialogue: 0,1:01:52.87,1:01:55.87,Default,,0,0,0,,Бұл Белл Кранел оны арқасымен көтеруі керек дегенді білдіре ме?
Dialogue: 0,1:01:57.04,1:01:59.09,Default,,0,0,0,,Менде қазір осы ғана
Dialogue: 0,1:01:59.54,1:02:01.80,Default,,0,0,0,,Қарғыс атсын... Сонда да!
Dialogue: 0,1:02:02.42,1:02:05.22,Default,,0,0,0,,Сіз әлі де бір балаға өзіңізді мәжбүрлейсіз бе?
Dialogue: 0,1:02:05.55,1:02:07.39,Default,,0,0,0,,Құдайды өлтірудің өлімге әкелетін күнәсі
Dialogue: 0,1:02:08.89,1:02:09.72,Default,,0,0,0,,Жоқ.
Dialogue: 0,1:02:10.97,1:02:12.43,Default,,0,0,0,,Ол сөзсіз осында—
Dialogue: 0,1:02:13.39,1:02:17.35,Default,,0,0,0,,Бұл ондай әңгіме емес.
Dialogue: 0,1:02:18.52,1:02:19.61,Default,,0,0,0,,Ол ма?
Dialogue: 0,1:02:20.65,1:02:21.61,Default,,0,0,0,,Ол ма?
Dialogue: 0,1:02:22.78,1:02:25.28,Default,,0,0,0,,Бұл мен сенің...
Dialogue: 0,1:02:26.36,1:02:29.91,Default,,0,0,0,,Неліктен мені таңдадың?
Dialogue: 0,1:02:31.58,1:02:33.91,Default,,0,0,0,,Сондықтан мен сенімен біргемін...
Dialogue: 0,1:02:34.33,1:02:35.46,Default,,0,0,0,,Сізге...
Dialogue: 0,1:02:36.33,1:02:37.58,Default,,0,0,0,,Сіз!
Dialogue: 0,1:02:39.13,1:02:39.96,Default,,0,0,0,,Ха…
Dialogue: 0,1:02:45.97,1:02:47.30,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,1:02:47.43,1:02:48.26,Default,,0,0,0,,Ха…
Dialogue: 0,1:03:03.52,1:03:05.11,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,1:03:08.45,1:03:09.28,Default,,0,0,0,,Орион
Dialogue: 0,1:03:09.41,1:03:12.49,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,1:03:16.62,1:03:19.17,Default,,0,0,0,,Боқ, боқ, боқ.
Dialogue: 0,1:03:19.71,1:03:21.17,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,1:03:21.71,1:03:22.92,Default,,0,0,0,,Орион... Ха...
Dialogue: 0,1:03:23.25,1:03:25.88,Default,,0,0,0,,Уф... Уф... А...
Dialogue: 0,1:03:32.01,1:03:34.72,Default,,0,0,0,,Мен сені қорғаймын дедім.
Dialogue: 0,1:03:35.60,1:03:38.73,Default,,0,0,0,,Қандай құбыжық көрінсе де, мен оны міндетті түрде жеңемін.
Dialogue: 0,1:03:39.35,1:03:41.44,Default,,0,0,0,,Мен сені міндетті түрде қорғаймын
Dialogue: 0,1:03:43.40,1:03:46.28,Default,,0,0,0,,(Дон) Дегенмен, сыртта бәрі де соншалықты алып, иә?
Dialogue: 0,1:03:48.03,1:03:49.11,Default,,0,0,0,,Қорғау
Dialogue: 0,1:03:54.37,1:03:55.87,Default,,0,0,0,,Отты болт
Dialogue: 0,1:04:08.21,1:04:09.51,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,1:04:22.98,1:04:24.81,Default,,0,0,0,,Артемида ханым
Dialogue: 0,1:04:26.23,1:04:27.07,Default,,0,0,0,,Ол сол жерде.
Dialogue: 0,1:04:30.44,1:04:32.49,Default,,0,0,0,,Орионды өтінемін
Dialogue: 0,1:04:33.07,1:04:36.33,Default,,0,0,0,,Менің жебем сенен атпастан бұрын
Dialogue: 0,1:04:36.95,1:04:37.95,Default,,0,0,0,,Жебеңізбен
Dialogue: 0,1:04:38.29,1:04:40.71,Default,,0,0,0,,Артемида!
Dialogue: 0,1:04:54.05,1:04:55.22,Default,,0,0,0,,Артемида
Dialogue: 0,1:05:06.19,1:05:08.27,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:05:08.40,1:05:10.57,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,1:05:11.32,1:05:13.03,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,1:05:13.36,1:05:14.99,Default,,0,0,0,,Жаман (лиу) Мен барамын
Dialogue: 0,1:05:15.11,1:05:16.49,Default,,0,0,0,,Сіз Белл Кранелсіз
Dialogue: 0,1:05:20.08,1:05:21.91,Default,,0,0,0,,Әйтеуір мен біраз уақыт таба аламын
Dialogue: 0,1:05:22.04,1:05:23.04,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:05:23.83,1:05:25.17,Default,,0,0,0,,Лилисуке иә
Dialogue: 0,1:05:25.29,1:05:27.08,Default,,0,0,0,,Мынаны ал, иә?
Dialogue: 0,1:05:27.75,1:05:28.67,Default,,0,0,0,,Сиқырлы қылыш?
Dialogue: 0,1:05:28.79,1:05:30.96,Default,,0,0,0,,Бір ғана ату, жіберіп алмаңыз Иә.
Dialogue: 0,1:05:42.27,1:05:43.23,Default,,0,0,0,,Ха!
Dialogue: 0,1:05:45.85,1:05:46.81,Default,,0,0,0,,Ха!
Dialogue: 0,1:05:53.69,1:05:54.53,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,1:05:54.78,1:05:55.70,Default,,0,0,0,,Арыстан
Dialogue: 0,1:06:00.58,1:06:02.12,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,1:06:08.92,1:06:09.75,Default,,0,0,0,,Гестия
Dialogue: 0,1:06:15.13,1:06:16.76,Default,,0,0,0,,Не істеу керек? Оның соңы жоқ
Dialogue: 0,1:06:18.09,1:06:20.72,Default,,0,0,0,,Цк... бір топ адам.
Dialogue: 0,1:06:20.85,1:06:21.72,Default,,0,0,0,,Ха…
Dialogue: 0,1:06:22.72,1:06:23.81,Default,,0,0,0,,Вайверн!
Dialogue: 0,1:06:30.36,1:06:31.19,Default,,0,0,0,,Маған не енгізгендерін ешкім білмейді.
Dialogue: 0,1:06:32.32,1:06:34.19,Default,,0,0,0,,Ең күшті арматуралар
Dialogue: 0,1:06:35.53,1:06:38.16,Default,,0,0,0,,Мен құдайдың қатысуын қорлай алмаймын.
Dialogue: 0,1:06:39.70,1:06:41.08,Default,,0,0,0,,Біз бірге күресеміз
Dialogue: 0,1:06:41.20,1:06:42.58,Default,,0,0,0,,Артқа итеріңіз!
Dialogue: 0,1:06:42.70,1:06:44.08,Default,,0,0,0,,Ооо
Dialogue: 0,1:06:51.92,1:06:52.88,Default,,0,0,0,,Ха!
Dialogue: 0,1:06:55.09,1:06:56.92,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,1:06:57.76,1:06:58.97,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,1:07:02.47,1:07:03.81,Default,,0,0,0,,Мистер Белл ха...
Dialogue: 0,1:07:10.19,1:07:11.27,Default,,0,0,0,,Мистер Белл
Dialogue: 0,1:07:12.94,1:07:14.69,Default,,0,0,0,,Өтінемін, тұрыңыз.
Dialogue: 0,1:07:15.57,1:07:18.32,Default,,0,0,0,,Артемиданың сезімін босқа өткізбе.
Dialogue: 0,1:07:19.16,1:07:21.37,Default,,0,0,0,,Бала сүйген дүние
Dialogue: 0,1:07:21.87,1:07:23.70,Default,,0,0,0,,Мен жақсы көретін балалар
Dialogue: 0,1:07:25.12,1:07:26.50,Default,,0,0,0,,Көзіңді аш
Dialogue: 0,1:07:27.71,1:07:29.21,Default,,0,0,0,,Мұқият тыңдаңыз
Dialogue: 0,1:07:30.83,1:07:33.00,Default,,0,0,0,,Сол бала әлі жылап отыр.
Dialogue: 0,1:07:36.17,1:07:39.68,Default,,0,0,0,,Артемиданы құтқарыңыз!
Dialogue: 0,1:07:49.27,1:07:52.06,Default,,0,0,0,,Мені тастап кетші, Құдайым.
Dialogue: 0,1:07:54.32,1:07:55.15,Default,,0,0,0,,Мистер Белл
Dialogue: 0,1:07:55.27,1:07:57.65,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,1:08:07.33,1:08:09.16,Default,,0,0,0,,Саған рұқсат етейін бе?
Dialogue: 0,1:08:10.66,1:08:12.63,Default,,0,0,0,,Ату! Лилисуке
Dialogue: 0,1:08:12.75,1:08:14.42,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,1:08:19.59,1:08:20.42,Default,,0,0,0,,Иә!?
Dialogue: 0,1:08:24.47,1:08:25.39,Default,,0,0,0,,Уф...
Dialogue: 0,1:08:25.85,1:08:28.18,Default,,0,0,0,,Дегенмен, заттары көп екен.
Dialogue: 0,1:08:28.89,1:08:30.14,Default,,0,0,0,,Бұл…
Dialogue: 0,1:08:36.11,1:08:38.19,Default,,0,0,0,,Ооо... уф...
Dialogue: 0,1:08:38.36,1:08:39.57,Default,,0,0,0,,Лорд Уэлф
Dialogue: 0,1:08:40.44,1:08:41.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:42.66,1:08:44.32,Default,,0,0,0,,Ха…
Dialogue: 0,1:08:52.71,1:08:53.67,Default,,0,0,0,,Мистер Белл
Dialogue: 0,1:09:02.05,1:09:03.93,Default,,0,0,0,,Батырларға тәнті болдым.
Dialogue: 0,1:09:04.93,1:09:06.85,Default,,0,0,0,,Кез келген құбыжықты жеңіңіз
Dialogue: 0,1:09:07.51,1:09:09.68,Default,,0,0,0,,Көп адамға күлкі сыйла
Dialogue: 0,1:09:10.52,1:09:13.06,Default,,0,0,0,,Қайғылы кейіпкерлер еш жерде жоқ.
Dialogue: 0,1:09:15.27,1:09:16.98,Default,,0,0,0,,Мен барлығын құтқарамын
Dialogue: 0,1:09:17.57,1:09:19.78,Default,,0,0,0,,Мен осындай батыр болғым келді.
Dialogue: 0,1:09:26.57,1:09:27.74,Default,,0,0,0,,Артемида
Dialogue: 0,1:09:28.45,1:09:31.29,Default,,0,0,0,,Маған көбірек күш беріңізші.
Dialogue: 0,1:09:38.67,1:09:40.63,Default,,0,0,0,,Уф... бұл...
Dialogue: 0,1:09:41.46,1:09:44.18,Default,,0,0,0,,Артемиданың жарығы
Dialogue: 0,1:09:54.56,1:09:56.48,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,1:09:56.60,1:09:57.44,Default,,0,0,0,,Иә.
Dialogue: 0,1:09:58.69,1:10:03.24,Default,,0,0,0,,Бұл тәңірді өлтіру туралы әңгіме емес.
Dialogue: 0,1:10:05.91,1:10:07.07,Default,,0,0,0,,Бұл –
Dialogue: 0,1:10:07.45,1:10:11.16,Default,,0,0,0,,Бұл сіздің жылап жатқан қызды құтқарғаныңыз туралы әңгіме.
Dialogue: 0,1:10:22.17,1:10:24.59,Default,,0,0,0,,Уау!
Dialogue: 0,1:11:10.22,1:11:11.64,Default,,0,0,0,,Артемида
Dialogue: 0,1:11:12.22,1:11:14.60,Default,,0,0,0,,Мен саған тәнті болдым
Dialogue: 0,1:11:15.35,1:11:19.77,Default,,0,0,0,,Күшті, абыройлы, мейірімді сендерге
Dialogue: 0,1:11:20.94,1:11:23.90,Default,,0,0,0,,Осы сапарда өзгерген сізге...
Dialogue: 0,1:11:24.98,1:11:27.11,Default,,0,0,0,,Мен таң қала бердім.
Dialogue: 0,1:11:28.15,1:11:30.61,Default,,0,0,0,,Бірақ қызық болды
Dialogue: 0,1:11:31.41,1:11:33.45,Default,,0,0,0,,Бұл өте қызықты болды.
Dialogue: 0,1:11:59.18,1:12:02.31,Default,,0,0,0,,Уау!
Dialogue: 0,1:12:02.65,1:12:04.15,Default,,0,0,0,,Артемида!
Dialogue: 0,1:12:27.55,1:12:30.38,Default,,0,0,0,,Орионға рахмет
Dialogue: 0,1:12:50.65,1:12:52.24,Default,,0,0,0,,Құрметті Артемида
Dialogue: 0,1:12:53.53,1:12:54.45,Default,,0,0,0,,Сонымен, неге қарғыс энергиясы кешігіп жатыр?
Dialogue: 0,1:12:55.24,1:12:57.79,Default,,0,0,0,,Тіпті құдайлар өлгенде қайта туады.
Dialogue: 0,1:12:59.70,1:13:01.16,Default,,0,0,0,,Сондықтан күліңіз
Dialogue: 0,1:13:01.62,1:13:03.29,Default,,0,0,0,,Қайта кездесу
Dialogue: 0,1:13:07.96,1:13:09.80,Default,,0,0,0,,Бұл қашан болды?
Dialogue: 0,1:13:10.38,1:13:13.93,Default,,0,0,0,,Қазір... 100 жылдан кейін бе әлде 1000 жылдан кейін бе?
Dialogue: 0,1:13:14.93,1:13:18.76,Default,,0,0,0,,Оған 10 000 жыл қажет болуы мүмкін.
Dialogue: 0,1:13:19.64,1:13:22.27,Default,,0,0,0,,Мен енді тірі емеспін.
Dialogue: 0,1:13:22.56,1:13:26.52,Default,,0,0,0,,Бірақ мен сенің қайта туылатыныңа сенімдімін
Dialogue: 0,1:13:26.65,1:13:27.94,Default,,0,0,0,,Осы төменгі әлемге кіріңіз
Dialogue: 0,1:13:29.11,1:13:32.15,Default,,0,0,0,,Мен сені тағы да кездестіретініме сенімдімін
Dialogue: 0,1:13:37.78,1:13:38.83,Default,,0,0,0,,Сонымен—
Dialogue: 0,1:13:39.74,1:13:44.42,Default,,0,0,0,,Келесі кездескенімізде, 10 000 жылдық махаббат болсын, Белл.
Dialogue: 0,1:13:51.59,1:13:54.51,Default,,0,0,0,,Уау!
Dialogue: 0,1:14:59.11,1:15:03.29,Default,,0,0,0,,(Шытырманшылардың қошеметі)
Dialogue: 0,1:15:07.75,1:15:09.25,Default,,0,0,0,,Менің сізге қарызым бар.
Dialogue: 0,1:15:11.04,1:15:14.21,Default,,0,0,0,,Мен тек Ұстаздың өсиетін орындадым.
Dialogue: 0,1:15:16.80,1:15:19.26,Default,,0,0,0,,Зынданда дүрбелең тоқтады.
Dialogue: 0,1:15:20.39,1:15:23.18,Default,,0,0,0,,Loki Familiars күш-жігерінің арқасында...
Dialogue: 0,1:15:23.60,1:15:26.77,Default,,0,0,0,,Қалаға келтірілген шығын да аз болды.
Dialogue: 0,1:15:28.77,1:15:32.77,Default,,0,0,0,,Аспанда жиналған Аркан жебелері де тарап кетті.
Dialogue: 0,1:15:34.07,1:15:36.61,Default,,0,0,0,,Байқамай, ежелгі құбыжық...
Dialogue: 0,1:15:36.74,1:15:39.24,Default,,0,0,0,,Бұл жеңіліске әкелді ме?
Dialogue: 0,1:15:40.16,1:15:43.08,Default,,0,0,0,,Уран Артемида құдайы ше?
Dialogue: 0,1:15:43.83,1:15:44.70,Default,,0,0,0,,қайтыс болды
Dialogue: 0,1:15:45.62,1:15:48.41,Default,,0,0,0,,Бала құтқарды
Dialogue: 0,1:15:49.92,1:15:51.79,Default,,0,0,0,,Белл Кранел?
Dialogue: 0,1:15:56.63,1:15:57.88,Default,,0,0,0,,Лорд Гермес
Dialogue: 0,1:16:02.30,1:16:05.39,Default,,0,0,0,,Жарайды, күтеміз.
Dialogue: 0,1:16:08.81,1:16:10.35,Default,,0,0,0,,Сақтау мүмкін болмады
Dialogue: 0,1:16:12.27,1:16:13.90,Default,,0,0,0,,Мен сені қорғауға уәде бердім
Dialogue: 0,1:16:15.98,1:16:16.98,Default,,0,0,0,,Мистер Белл
Dialogue: 0,1:16:18.53,1:16:21.07,Default,,0,0,0,,Сіз өзіңізді кешіре алмауыңыз мүмкін
Dialogue: 0,1:16:23.41,1:16:24.53,Default,,0,0,0,,Бірақ
Dialogue: 0,1:16:25.49,1:16:28.75,Default,,0,0,0,,Сіз Артемиданы құтқардыңыз.
Dialogue: 0,1:16:29.79,1:16:32.08,Default,,0,0,0,,Сіз мұны қайдан білесіз?
Dialogue: 0,1:16:32.58,1:16:33.79,Default,,0,0,0,,Өйткені, қара
Dialogue: 0,1:16:48.72,1:16:50.56,Default,,0,0,0,,Артемида дейді
Dialogue: 0,1:16:53.65,1:16:55.11,Default,,0,0,0,,«Рахмет»
Dialogue: 0,1:17:02.70,1:17:04.57,Default,,0,0,0,,Бала жылады ма?
Dialogue: 0,1:17:07.62,1:17:09.66,Default,,0,0,0,,Әлгі бала күлген жоқ па?
Dialogue: 0,1:17:10.87,1:17:11.96,Default,,0,0,0,,Иә
Dialogue: 0,1:17:17.13,1:17:21.09,Default,,0,0,0,,Сіз Артемиданың батыры болдыңыз.
Dialogue: 0,1:17:24.05,1:17:25.05,Default,,0,0,0,,Жақсы қыз бол және барынша тырыс, жарай ма?
Dialogue: 0,1:17:27.72,1:17:30.02,Default,,0,0,0,,Мен күштірек болғым келеді
Dialogue: 0,1:17:34.73,1:17:35.73,Default,,0,0,0,,Иә
Dialogue: 0,1:17:36.69,1:17:39.94,Default,,0,0,0,,♪～
Dialogue: 0,1:22:04.12,1:22:09.13,Default,,0,0,0,,～♪
