Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:03.05,0:02:05.74,Default,,0000,0000,0000,,Мен барамын.
Dialogue: 0,0:02:05.74,0:02:08.26,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:02:08.26,0:02:11.46,Default,,0000,0000,0000,,Бүгін тағы да ұйқым келді. Бұл дұрыс.
Dialogue: 0,0:02:11.46,0:02:15.34,Default,,0000,0000,0000,,Тоору мүлде ұйқысыз көрінбейді.
Dialogue: 0,0:02:15.34,0:02:18.19,Default,,0000,0000,0000,,Жарайды, өйткені мен таңертең күштімін.
Dialogue: 0,0:02:18.19,0:02:20.72,Default,,0000,0000,0000,,Керемет~ Мен қызғанамын.
Dialogue: 0,0:02:20.72,0:02:24.72,Default,,0000,0000,0000,,Таңертең мен өзімді әлсіз сезінемін... иә?
Dialogue: 0,0:02:26.11,0:02:29.81,Default,,0000,0000,0000,,Бұл... не болды? Жүгіру-чан.
Dialogue: 0,0:02:29.81,0:02:32.50,Default,,0000,0000,0000,,≪Мына құс біртүрлі екен≫
Dialogue: 0,0:02:32.50,0:02:34.36,Default,,0000,0000,0000,,≪Не болды? ≫
Dialogue: 0,0:02:34.36,0:02:36.38,Default,,0000,0000,0000,,Ей Тоору, анау құс→
Dialogue: 0,0:02:36.38,0:02:39.08,Default,,0000,0000,0000,,Ол үнемі айналады, бірақ жақсы ма?
Dialogue: 0,0:02:39.08,0:02:42.08,Default,,0000,0000,0000,,Рун-чан: Бұл ауа-райы болғандықтан.
Dialogue: 0,0:02:44.45,0:02:56.45,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:58.77,0:03:10.05,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:10.05,0:03:14.05,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:17.45,0:03:25.36,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:25.36,0:03:29.36,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:30.75,0:03:41.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:41.20,0:03:49.94,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:49.94,0:03:56.35,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:56.35,0:04:00.35,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:04.93,0:04:13.93,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:19.74,0:04:31.69,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:31.69,0:04:34.56,Default,,0000,0000,0000,,（）
Dialogue: 0,0:04:34.56,0:04:36.08,Default,,0000,0000,0000,,Тар және жіңішке бел!
Dialogue: 0,0:04:36.08,0:04:39.94,Default,,0000,0000,0000,,Қолдары жирафтың мойнындай!
Dialogue: 0,0:04:39.94,0:04:42.80,Default,,0000,0000,0000,,Бұл ұрыс па?
Dialogue: 0,0:04:42.80,0:04:44.16,Default,,0000,0000,0000,,Одан жақсысы бар емес пе?
Dialogue: 0,0:04:44.16,0:04:47.02,Default,,0000,0000,0000,,Жіңішке аяқтар! (Юко) Иә?
Dialogue: 0,0:04:47.02,0:04:50.71,Default,,0000,0000,0000,,Одан да жақсы! Толық E кесе!
Dialogue: 0,0:04:50.71,0:04:52.74,Default,,0000,0000,0000,,Әлі жоқ! Тофу сияқты ақ тері!
Dialogue: 0,0:04:52.74,0:04:54.43,Default,,0000,0000,0000,,Әлі жоқ! әлі…. (Юко) Не... не болды? →
Dialogue: 0,0:04:54.43,0:04:58.96,Default,,0000,0000,0000,,Екеуі де. Мен Юко-чанның күшті жақтарын тізіп отырмын!
Dialogue: 0,0:04:58.96,0:05:00.15,Default,,0000,0000,0000,,≪... Неге ол туралы айтып отырсың? ≫
Dialogue: 0,0:05:00.15,0:05:03.33,Default,,0000,0000,0000,,Тек микроскоппен көруге болатын тесіктер! иә?
Dialogue: 0,0:05:03.33,0:05:06.36,Default,,0000,0000,0000,,Дафния сияқты кішкентай бет! Эх...
Dialogue: 0,0:05:06.36,0:05:08.36,Default,,0000,0000,0000,,Мұның бәрі сыртқы көрініске қатысты.
Dialogue: 0,0:05:09.40,0:05:12.76,Default,,0000,0000,0000,,≪Ішкі күштеріңізді де санамалап өтсеңіз...≫
Dialogue: 0,0:05:12.76,0:05:14.95,Default,,0000,0000,0000,,Толығырақ! Жақсы…→
Dialogue: 0,0:05:14.95,0:05:16.47,Default,,0000,0000,0000,,Әрқашан керемет стильде!
Dialogue: 0,0:05:16.47,0:05:20.84,Default,,0000,0000,0000,,Ах~. аа….
Dialogue: 0,0:05:20.84,0:05:22.36,Default,,0000,0000,0000,,Не… не болды? Тоору!
Dialogue: 0,0:05:22.36,0:05:24.72,Default,,0000,0000,0000,,Run-chan...→
Dialogue: 0,0:05:24.72,0:05:28.26,Default,,0000,0000,0000,,Рун-чан әрқашан Юуконы мақтайды...
Dialogue: 0,0:05:28.26,0:05:32.96,Default,,0000,0000,0000,,≪Ашуланатыны сонша, өзіңізді тұншықтырып өлтіресіз...≫
Dialogue: 0,0:05:32.96,0:05:35.96,Default,,0000,0000,0000,,Тооруда осындай нәрсе бар ма?
Dialogue: 0,0:05:37.17,0:05:39.19,Default,,0000,0000,0000,,Мысалы? Ха!
Dialogue: 0,0:05:39.19,0:05:41.72,Default,,0000,0000,0000,,Ах... у...→
Dialogue: 0,0:05:41.72,0:05:45.92,Default,,0000,0000,0000,,Иә! Әлем... Кішкентай кеуделер Мое? →
Dialogue: 0,0:05:45.92,0:05:47.61,Default,,0000,0000,0000,,Бұл жіңішке бум ба? →
Dialogue: 0,0:05:47.61,0:05:49.61,Default,,0000,0000,0000,,Тоору соққы аймағы! →
Dialogue: 0,0:05:51.81,0:05:53.81,Default,,0000,0000,0000,,Иә? Эх...
Dialogue: 0,0:05:55.69,0:05:57.69,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:05:59.90,0:06:03.10,Default,,0000,0000,0000,,Уау! О... тоқта.
Dialogue: 0,0:06:03.10,0:06:05.79,Default,,0000,0000,0000,,Жақсы дене, сонда не?
Dialogue: 0,0:06:05.79,0:06:08.32,Default,,0000,0000,0000,,Юко-чан, модель сияқтысың.
Dialogue: 0,0:06:08.32,0:06:10.32,Default,,0000,0000,0000,,≪Уау... ұмытып кетіппін! ≫
Dialogue: 0,0:06:13.70,0:06:15.72,Default,,0000,0000,0000,,≪Биылғы мақсаттар Жазға қарай мақсат →
Dialogue: 0,0:06:15.72,0:06:18.42,Default,,0000,0000,0000,,3 кг арықтап, үлгілі денеге ие болыңыз! ≫
Dialogue: 0,0:06:18.42,0:06:21.28,Default,,0000,0000,0000,,≪Жоқ, күте тұрыңыз... әлі уақыт бар≫
Dialogue: 0,0:06:21.28,0:06:23.80,Default,,0000,0000,0000,,≪Нағыз жаз тамыз айында келеді≫
Dialogue: 0,0:06:23.80,0:06:26.17,Default,,0000,0000,0000,,≪Жоғары сынып оқушылары үшін жаз енді ғана басталып жатыр≫
Dialogue: 0,0:06:26.17,0:06:30.88,Default,,0000,0000,0000,,≪Тағы бір ай... Бір ай бәрін жасайды! ≫
Dialogue: 0,0:06:30.88,0:06:34.08,Default,,0000,0000,0000,,Ху... хех хе.... (Юуко жүгіру) Иә?
Dialogue: 0,0:06:34.08,0:06:36.43,Default,,0000,0000,0000,,Хаха! иә?
Dialogue: 0,0:06:36.43,0:06:40.43,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:06:42.32,0:06:44.34,Default,,0000,0000,0000,,≪Жоқ, мен...≫
Dialogue: 0,0:06:44.34,0:06:46.70,Default,,0000,0000,0000,,≪Мен қайтадан ұмытып кеттім→
Dialogue: 0,0:06:46.70,0:06:49.70,Default,,0000,0000,0000,,Бүгін жоғары сынып қыздарына арналған жаз басталды...≫
Dialogue: 0,0:06:50.41,0:06:53.44,Default,,0000,0000,0000,,Фу. Өйткені мен бассейнді тазалап жатырмын →
Dialogue: 0,0:06:53.44,0:06:55.96,Default,,0000,0000,0000,,Купальникке ауыспаңыз →
Dialogue: 0,0:06:55.96,0:06:59.96,Default,,0000,0000,0000,,Бұл өте қиын. Күрсін.
Dialogue: 0,0:07:00.34,0:07:05.72,Default,,0000,0000,0000,,Пуха~! Бірақ купальникпен тазалау қызық көрінеді.
Dialogue: 0,0:07:05.72,0:07:09.77,Default,,0000,0000,0000,,Эй, Наги-чан да солай ойлайды, солай ма? иә?
Dialogue: 0,0:07:09.77,0:07:12.46,Default,,0000,0000,0000,,Не болды? Наги-чан. иә? →
Dialogue: 0,0:07:12.46,0:07:14.15,Default,,0000,0000,0000,,А... ештеңе жоқ. Ахаха.
Dialogue: 0,0:07:14.15,0:07:18.02,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:18.02,0:07:21.38,Default,,0000,0000,0000,,≪Бұл қиын…. →
Dialogue: 0,0:07:21.38,0:07:24.42,Default,,0000,0000,0000,,Сіз шынымен салмақ қостыңыз ба? Жоқ, бұл дұрыс емес…≫
Dialogue: 0,0:07:24.42,0:07:27.61,Default,,0000,0000,0000,,（）
Dialogue: 0,0:07:27.61,0:07:30.64,Default,,0000,0000,0000,,Кішкене қатал. Бұл өсу кезеңі~→
Dialogue: 0,0:07:30.64,0:07:34.35,Default,,0000,0000,0000,,Әртүрлі заттар. (Юко) Оны доғар.
Dialogue: 0,0:07:34.35,0:07:37.71,Default,,0000,0000,0000,,≪Мен түсінемін! Менің купальнигім қысқарды! ≫
Dialogue: 0,0:07:37.71,0:07:40.90,Default,,0000,0000,0000,,Фуфуфуфуфу….
Dialogue: 0,0:07:40.90,0:07:42.42,Default,,0000,0000,0000,,Бүгінгі Наги сәл оғаш па?
Dialogue: 0,0:07:42.42,0:07:45.12,Default,,0000,0000,0000,,Не? Бұл әдеттегідей.
Dialogue: 0,0:07:45.12,0:07:48.12,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:08:01.11,0:08:04.98,Default,,0000,0000,0000,,...
Dialogue: 0,0:08:04.98,0:08:07.01,Default,,0000,0000,0000,,Ах! Ютаканың досы.
Dialogue: 0,0:08:07.01,0:08:10.70,Default,,0000,0000,0000,,Михо жақсы.
Dialogue: 0,0:08:10.70,0:08:12.23,Default,,0000,0000,0000,,Негізі мен де Ютака сияқтымын→
Dialogue: 0,0:08:12.23,0:08:15.92,Default,,0000,0000,0000,,Мен Тоору жанкүйерімін.
Dialogue: 0,0:08:15.92,0:08:17.77,Default,,0000,0000,0000,,≪Желдеткіш? ≫
Dialogue: 0,0:08:17.77,0:08:21.98,Default,,0000,0000,0000,,Міне, осы уақытқа дейін сұрауға мүмкіндігім болмады, бірақ →
Dialogue: 0,0:08:21.98,0:08:24.98,Default,,0000,0000,0000,,Мені біраз уақыттан бері қызықтыратын бір нәрсе бар. иә?
Dialogue: 0,0:08:27.20,0:08:29.06,Default,,0000,0000,0000,,Уау! Сондай жұмсақ!
Dialogue: 0,0:08:29.06,0:08:33.27,Default,,0000,0000,0000,,Бұл әдет пе? орнату? Бұл әдет...
Dialogue: 0,0:08:33.27,0:08:35.79,Default,,0000,0000,0000,,Уау!!→
Dialogue: 0,0:08:35.79,0:08:38.49,Default,,0000,0000,0000,,Тоору~н! (Тору Михо) Иә...
Dialogue: 0,0:08:38.49,0:08:41.68,Default,,0000,0000,0000,,Мипорин айлакер! Тіпті Мипорин →
Dialogue: 0,0:08:41.68,0:08:43.70,Default,,0000,0000,0000,,Сен Тоорунның жолына түсесің!
Dialogue: 0,0:08:43.70,0:08:46.40,Default,,0000,0000,0000,,Мен Ютака сияқты сенің соңынан еріп жүрген сияқты емеспін.
Dialogue: 0,0:08:46.40,0:08:49.76,Default,,0000,0000,0000,,Барлық Мипорин өте жасырын! Мен де Ютакаға тиісемін! →
Dialogue: 0,0:08:49.76,0:08:52.45,Default,,0000,0000,0000,,Гаши! аа….
Dialogue: 0,0:08:52.45,0:08:54.65,Default,,0000,0000,0000,,Уау! Сіз...
Dialogue: 0,0:08:54.65,0:08:57.18,Default,,0000,0000,0000,,Тоорун! Тоорун! Күрсіну….
Dialogue: 0,0:08:57.18,0:09:00.70,Default,,0000,0000,0000,,Ойланып қарасақ, екеуміз жақсы доспыз →
Dialogue: 0,0:09:00.70,0:09:02.72,Default,,0000,0000,0000,,Кіші орта мектеп Дәл солай ма?
Dialogue: 0,0:09:02.72,0:09:06.10,Default,,0000,0000,0000,,Иә. Бұл бір түрлі шірік қарым-қатынас сияқты ...
Dialogue: 0,0:09:06.10,0:09:09.13,Default,,0000,0000,0000,,Ах. Хихихи!
Dialogue: 0,0:09:09.13,0:09:12.16,Default,,0000,0000,0000,,≪Мен біраз уақыттан бері уақыт туралы уайымдап жүрмін...≫
Dialogue: 0,0:09:12.16,0:09:14.85,Default,,0000,0000,0000,,Иә, бұл 3 минутқа созылды. иә?
Dialogue: 0,0:09:14.85,0:09:17.37,Default,,0000,0000,0000,,Дәл қазір Тоору-саннан кет, Ютака.
Dialogue: 0,0:09:17.37,0:09:19.73,Default,,0000,0000,0000,,Иә! Қазірдің өзінде?
Dialogue: 0,0:09:19.73,0:09:22.26,Default,,0000,0000,0000,,Хмм. Мипорин қорқынышты!
Dialogue: 0,0:09:22.26,0:09:26.79,Default,,0000,0000,0000,,Мен үйреніп қалдым, сондықтан Ютака қиындық туғызса→
Dialogue: 0,0:09:26.79,0:09:28.99,Default,,0000,0000,0000,,Менімен дереу кеңесіңіз.
Dialogue: 0,0:09:28.99,0:09:32.19,Default,,0000,0000,0000,,Мм. Орта мектеп туралы айтсам, сол кездегі лақап атым Мипорин→ болатын
Dialogue: 0,0:09:32.19,0:09:35.05,Default,,0000,0000,0000,,Бұл «қашықтан басқару пульті» болды! Ақсақ емес пе?
Dialogue: 0,0:09:35.05,0:09:37.41,Default,,0000,0000,0000,,Оның шығу тегін білесіз бе?
Dialogue: 0,0:09:37.41,0:09:39.76,Default,,0000,0000,0000,,Мен түсінбеймін! Апыр-ай!
Dialogue: 0,0:09:39.76,0:09:42.79,Default,,0000,0000,0000,,Уф... Уау!
Dialogue: 0,0:09:42.79,0:09:44.14,Default,,0000,0000,0000,,Соқ! Ютака!
Dialogue: 0,0:09:44.14,0:09:46.33,Default,,0000,0000,0000,,Кешіріңіз. иә.
Dialogue: 0,0:09:46.33,0:09:48.85,Default,,0000,0000,0000,,Тек оны анықтап алсаңыз болғаны. Мипорин кешіріңіз.
Dialogue: 0,0:09:48.85,0:09:51.21,Default,,0000,0000,0000,,Ах. Бірақ Тоорунның шашы...
Dialogue: 0,0:09:51.21,0:09:54.74,Default,,0000,0000,0000,,Тоору-сан, мен мына қоқыс дорбасын аламын.
Dialogue: 0,0:09:54.74,0:09:56.77,Default,,0000,0000,0000,,Жоқ! Ютакада бар! →
Dialogue: 0,0:09:56.77,0:09:59.63,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:09:59.63,0:10:02.33,Default,,0000,0000,0000,,Олай болса, танысқаныма қуаныштымын. О, күт! →
Dialogue: 0,0:10:02.33,0:10:05.69,Default,,0000,0000,0000,,Бұл ауыр!
Dialogue: 0,0:10:05.69,0:10:07.69,Default,,0000,0000,0000,,≪Қашықтан басқару пульті…≫
Dialogue: 0,0:10:09.39,0:10:12.42,Default,,0000,0000,0000,,Күн жауып тұр.
Dialogue: 0,0:10:12.42,0:10:14.44,Default,,0000,0000,0000,,Бассейн.
Dialogue: 0,0:10:14.44,0:10:16.44,Default,,0000,0000,0000,,Өзіңізді курорт сияқты сезінесіз бе?
Dialogue: 0,0:10:18.48,0:10:21.01,Default,,0000,0000,0000,,Хаа хаа ха....
Dialogue: 0,0:10:21.01,0:10:23.37,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:10:23.37,0:10:26.37,Default,,0000,0000,0000,,Хаа хаа ха....
Dialogue: 0,0:10:28.91,0:10:30.61,Default,,0000,0000,0000,,Өте ыстық!
Dialogue: 0,0:10:30.61,0:10:33.14,Default,,0000,0000,0000,,Бассейнде ыстық, солай емес пе?
Dialogue: 0,0:10:33.14,0:10:38.51,Default,,0000,0000,0000,,Жарайды, күннің ыстығы қашатын жер жоқ.
Dialogue: 0,0:10:38.51,0:10:43.07,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:43.07,0:10:46.10,Default,,0000,0000,0000,,Әйтеуір, тез бітірейік!
Dialogue: 0,0:10:46.10,0:10:49.29,Default,,0000,0000,0000,,Сәлем! О! (Юко) Бұл қауіпті!
Dialogue: 0,0:10:49.29,0:10:51.81,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:51.81,0:10:55.85,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:55.85,0:10:57.04,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:10:57.04,0:11:00.07,Default,,0000,0000,0000,,Не болып жатыр? мінеки біз?
Dialogue: 0,0:11:00.07,0:11:03.07,Default,,0000,0000,0000,,Юуко-чан, Наги-чан, бұл жерде тайғақ!
Dialogue: 0,0:11:05.12,0:11:07.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:07.97,0:11:10.33,Default,,0000,0000,0000,,О, шынымен. Хаха.
Dialogue: 0,0:11:10.33,0:11:13.70,Default,,0000,0000,0000,,Хаха... Уау! Хаха! Хахахахаха!
Dialogue: 0,0:11:13.70,0:11:16.39,Default,,0000,0000,0000,,Хаха! (Юко) Бұл қауіпті. →
Dialogue: 0,0:11:16.39,0:11:19.75,Default,,0000,0000,0000,,Құлап қалып басымды соғып кетсем не істеуім керек?
Dialogue: 0,0:11:19.75,0:11:23.79,Default,,0000,0000,0000,,Жарайды! Міне бітті! (Юко) Ах!
Dialogue: 0,0:11:23.79,0:11:27.50,Default,,0000,0000,0000,,Қазірдің өзінде! Тіпті Наги маған айтты! иә?
Dialogue: 0,0:11:27.50,0:11:29.50,Default,,0000,0000,0000,,Аха~. →
Dialogue: 0,0:11:30.03,0:11:32.03,Default,,0000,0000,0000,,Ахааааааааааааааааааааааааа
Dialogue: 0,0:11:34.07,0:11:36.43,Default,,0000,0000,0000,,Ха Наги~!
Dialogue: 0,0:11:36.43,0:11:40.63,Default,,0000,0000,0000,,Уау! Не... не?
Dialogue: 0,0:11:40.63,0:11:42.99,Default,,0000,0000,0000,,Юко-чан, мүмкіндік бар!
Dialogue: 0,0:11:42.99,0:11:45.35,Default,,0000,0000,0000,,Ахаха, мен сіңіп қалдым!
Dialogue: 0,0:11:45.35,0:11:48.35,Default,,0000,0000,0000,,Түсіндім... Солай ма? →
Dialogue: 0,0:11:50.07,0:11:52.76,Default,,0000,0000,0000,,Жүгіру~! Каа~!
Dialogue: 0,0:11:52.76,0:11:54.78,Default,,0000,0000,0000,,Ұсталды! Ахахха!
Dialogue: 0,0:11:54.78,0:11:57.81,Default,,0000,0000,0000,,Сәлем! Міне бітті!
Dialogue: 0,0:11:57.81,0:12:00.00,Default,,0000,0000,0000,,Уау! Ах. Хаха!
Dialogue: 0,0:12:00.00,0:12:02.52,Default,,0000,0000,0000,,Хаха! (Юко) Бұл~! →
Dialogue: 0,0:12:02.52,0:12:05.39,Default,,0000,0000,0000,,Уа, ау! Ах... Ой!
Dialogue: 0,0:12:05.39,0:12:07.74,Default,,0000,0000,0000,,Ахахха! →
Dialogue: 0,0:12:07.74,0:12:09.74,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:12:11.78,0:12:13.64,Default,,0000,0000,0000,,Уау! Хахаха!
Dialogue: 0,0:12:13.64,0:12:17.67,Default,,0000,0000,0000,,Хаха!
Dialogue: 0,0:12:17.67,0:12:19.53,Default,,0000,0000,0000,,Хаха!
Dialogue: 0,0:12:19.53,0:12:27.28,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:12:27.28,0:12:37.70,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:12:37.70,0:12:57.73,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:12:57.73,0:13:16.76,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:13:16.76,0:13:18.28,Default,,0000,0000,0000,,Ора, орра, ора! →
Dialogue: 0,0:13:18.28,0:13:22.98,Default,,0000,0000,0000,,Хаха! (Юко) Уф... уф... →
Dialogue: 0,0:13:22.98,0:13:24.84,Default,,0000,0000,0000,,Ой... ой-о... Уау! Башан!
Dialogue: 0,0:13:24.84,0:13:27.70,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:27.70,0:13:30.40,Default,,0000,0000,0000,,Қазірдің өзінде! (Барлығы) Ахахха!
Dialogue: 0,0:13:30.40,0:13:32.75,Default,,0000,0000,0000,,Ахахха!
Dialogue: 0,0:13:32.75,0:13:35.61,Default,,0000,0000,0000,,～
Dialogue: 0,0:13:35.61,0:13:38.48,Default,,0000,0000,0000,,Ым... Тоорун, сен не қарап тұрсың?
Dialogue: 0,0:13:38.48,0:13:40.67,Default,,0000,0000,0000,,Хмм... Мен оны ұстадым! Апыр-ай!
Dialogue: 0,0:13:40.67,0:13:42.02,Default,,0000,0000,0000,,Уау! Башан!
Dialogue: 0,0:13:42.02,0:13:44.02,Default,,0000,0000,0000,,Ахахахахахха!
Dialogue: 0,0:13:47.74,0:13:49.76,Default,,0000,0000,0000,,Жұмақ!
Dialogue: 0,0:13:49.76,0:13:51.76,Default,,0000,0000,0000,,Бұл мүлде жұмақ емес...
Dialogue: 0,0:15:58.54,0:16:00.54,Default,,0000,0000,0000,,Гача (есік дыбысы) Мен үйдемін.
Dialogue: 0,0:16:12.18,0:16:14.37,Default,,0000,0000,0000,,Хмм…. →
Dialogue: 0,0:16:14.37,0:16:16.39,Default,,0000,0000,0000,,күрсіну. →
Dialogue: 0,0:16:16.39,0:16:19.75,Default,,0000,0000,0000,,Мен шаршадым.
Dialogue: 0,0:16:19.75,0:16:22.75,Default,,0000,0000,0000,,Күннен қорғайтын кремді көбірек жағуым керек еді.
Dialogue: 0,0:16:24.98,0:16:27.17,Default,,0000,0000,0000,,Ах! →
Dialogue: 0,0:16:27.17,0:16:30.37,Default,,0000,0000,0000,,≪Жарайды! Сіз бүгін қатты қозғалдыңыз≫
Dialogue: 0,0:16:30.37,0:16:33.23,Default,,0000,0000,0000,,≪Міндетті түрде азаюы керек! ≫
Dialogue: 0,0:16:33.23,0:16:36.42,Default,,0000,0000,0000,,≪Жоқ, керісінше менің мақсатым 3 кг арықтау→
Dialogue: 0,0:16:36.42,0:16:38.11,Default,,0000,0000,0000,,Мен оған қол жеткізген шығармын≫
Dialogue: 0,0:16:38.11,0:16:40.47,Default,,0000,0000,0000,,≪Ауа Таразыны оқыңыз! ≫
Dialogue: 0,0:16:40.47,0:16:50.74,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:50.74,0:16:52.74,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:16:58.15,0:17:00.34,Default,,0000,0000,0000,,Ах! →
Dialogue: 0,0:17:00.34,0:17:03.20,Default,,0000,0000,0000,,≪Ойланып қарасаңыз, киім кисеңіз, 1 кг арықтаасыз →
Dialogue: 0,0:17:03.20,0:17:05.39,Default,,0000,0000,0000,,Жақсы болуы керек≫
Dialogue: 0,0:17:05.39,0:17:08.42,Default,,0000,0000,0000,,Не? Ештеңе өзгерген жоқ.
Dialogue: 0,0:17:08.42,0:17:10.42,Default,,0000,0000,0000,,Толқып кеткенім сонша, жеңіліп қалдым!
Dialogue: 0,0:17:13.29,0:17:17.17,Default,,0000,0000,0000,,Мм. Алдымен айға жоспар құрыңыз. →
Dialogue: 0,0:17:17.17,0:17:21.71,Default,,0000,0000,0000,,Негізі диетаны шектеу және жаттығу. →
Dialogue: 0,0:17:21.71,0:17:23.73,Default,,0000,0000,0000,,«Тамақ арасында жеңіл тамақтанбау.→
Dialogue: 0,0:17:23.73,0:17:27.43,Default,,0000,0000,0000,,Кешкі асты ерте және аз мөлшерде жеу→
Dialogue: 0,0:17:27.43,0:17:31.97,Default,,0000,0000,0000,,Майы аз көкөніс негізіндегі тағамдар. →
Dialogue: 0,0:17:31.97,0:17:35.18,Default,,0000,0000,0000,,Хмм. «Күн сайын жаттығуды жалғастырыңыз.→
Dialogue: 0,0:17:35.18,0:17:38.18,Default,,0000,0000,0000,,Жүгіру, арқанмен секіру, созылу тиімді.
Dialogue: 0,0:17:40.90,0:17:43.90,Default,,0000,0000,0000,,Күрсін, бұл садистік.
Dialogue: 0,0:17:45.95,0:17:47.47,Default,,0000,0000,0000,,Тамақ бергеніңіз үшін рахмет.
Dialogue: 0,0:17:47.47,0:17:50.84,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:17:50.84,0:17:54.87,Default,,0000,0000,0000,,≪Диетада не бастағанымызды барлығынан жасырайық→
Dialogue: 0,0:17:54.87,0:17:56.39,Default,,0000,0000,0000,,Шулы сияқты≫
Dialogue: 0,0:17:56.39,0:17:58.75,Default,,0000,0000,0000,,≪Егер жүгіру анықтаса...≫
Dialogue: 0,0:17:58.75,0:18:01.75,Default,,0000,0000,0000,,Денсаулыққа зиян деп тоқтамаңыз!
Dialogue: 0,0:18:03.13,0:18:05.32,Default,,0000,0000,0000,,≪Юко...≫
Dialogue: 0,0:18:05.32,0:18:09.02,Default,,0000,0000,0000,,Оны дәл қазір қалдырыңыз! Бұл жеткілікті.
Dialogue: 0,0:18:09.02,0:18:11.38,Default,,0000,0000,0000,,А, мен мұны айтамын деп ойлаймын.
Dialogue: 0,0:18:11.38,0:18:15.91,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:18:15.91,0:18:17.43,Default,,0000,0000,0000,,≪Тоору бұл...≫
Dialogue: 0,0:18:17.43,0:18:19.12,Default,,0000,0000,0000,,Ах~ Дәмді, дәмді. Иә.
Dialogue: 0,0:18:19.12,0:18:21.12,Default,,0000,0000,0000,,Тамақтану керек пе? Сізге ұнағанша жақсы.
Dialogue: 0,0:18:23.33,0:18:26.33,Default,,0000,0000,0000,,Оны ойласам жегім келеді.
Dialogue: 0,0:18:29.73,0:18:32.08,Default,,0000,0000,0000,,Наги! Уау!
Dialogue: 0,0:18:32.08,0:18:34.77,Default,,0000,0000,0000,,≪Мен еріксіз құладым≫
Dialogue: 0,0:18:34.77,0:18:37.13,Default,,0000,0000,0000,,≪Торудың интуициясы жақсы, сондықтан мен абай болуым керек...≫
Dialogue: 0,0:18:37.13,0:18:39.32,Default,,0000,0000,0000,,О, не болды?
Dialogue: 0,0:18:39.32,0:18:42.35,Default,,0000,0000,0000,,Диета…. Да….
Dialogue: 0,0:18:42.35,0:18:45.05,Default,,0000,0000,0000,,Әй, а... не?! Эй, сен диетадасың, солай ма?
Dialogue: 0,0:18:45.05,0:18:48.07,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:18:48.07,0:18:50.43,Default,,0000,0000,0000,,Уау... Ах! Bang!
Dialogue: 0,0:18:50.43,0:18:52.45,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:18:52.45,0:18:54.80,Default,,0000,0000,0000,,Ах... (Барлығы) Иә?
Dialogue: 0,0:18:54.80,0:18:57.80,Default,,0000,0000,0000,,Не... нені айтып тұрсыз?
Dialogue: 0,0:18:59.69,0:19:02.69,Default,,0000,0000,0000,,Ран мен Юуко ше? Мен жаңа ғана дәретханаға бардым.
Dialogue: 0,0:19:04.40,0:19:07.94,Default,,0000,0000,0000,,Сіз қайдан білдіңіз? Көктемде жалғыз өзім →
Dialogue: 0,0:19:07.94,0:19:10.13,Default,,0000,0000,0000,,Жазға қарай диетада 3 кг салмақ тастаңыз→
Dialogue: 0,0:19:10.13,0:19:13.66,Default,,0000,0000,0000,,Мен айттым ғой. Кешеден есіңе түсірдің, солай ма?
Dialogue: 0,0:19:13.66,0:19:17.66,Default,,0000,0000,0000,,Уф... Осындай болмашы нәрселерді ұмыт!
Dialogue: 0,0:19:19.05,0:19:22.08,Default,,0000,0000,0000,,Барлығына айтасыз ба? Мен оны айтпай-ақ қояйын.
Dialogue: 0,0:19:22.08,0:19:26.12,Default,,0000,0000,0000,,Не, сіз үнсіз ақша алғыңыз келеді дейсіз бе?
Dialogue: 0,0:19:26.12,0:19:28.64,Default,,0000,0000,0000,,Маған керек емес.
Dialogue: 0,0:19:28.64,0:19:33.69,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:19:33.69,0:19:35.05,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:19:35.05,0:19:38.74,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:19:38.74,0:19:41.27,Default,,0000,0000,0000,,Онда жоқ.
Dialogue: 0,0:19:41.27,0:19:44.14,Default,,0000,0000,0000,,Тоору тәттіні көп жесе де, ол әлі арық.
Dialogue: 0,0:19:44.14,0:19:48.67,Default,,0000,0000,0000,,Жүгіріп жүргендіктен емес пе? Оның орнына →
Dialogue: 0,0:19:48.67,0:19:50.53,Default,,0000,0000,0000,,Мұнда да тамақ жоқ.
Dialogue: 0,0:19:50.53,0:19:53.90,Default,,0000,0000,0000,,Түсіндім! Егер ол шайқалса, ол құлап кетеді.
Dialogue: 0,0:19:53.90,0:19:56.42,Default,,0000,0000,0000,,Егер жүгіру немесе арқанмен секіру→
Dialogue: 0,0:19:56.42,0:19:58.28,Default,,0000,0000,0000,,Мен мұны істей алмаймын, өйткені мен кеудеден айырыламын.
Dialogue: 0,0:19:58.28,0:20:01.64,Default,,0000,0000,0000,,Жақсы! иә….
Dialogue: 0,0:20:01.64,0:20:04.01,Default,,0000,0000,0000,,Егер сізді соншалықты қызықтырса, неге Юукодан сұрамайсыз?
Dialogue: 0,0:20:04.01,0:20:08.71,Default,,0000,0000,0000,,Мүмкін сіз үлкен күш салып жатқан шығарсыз.
Dialogue: 0,0:20:08.71,0:20:10.73,Default,,0000,0000,0000,,Хмм…. Бір нәрсе болуы керек →
Dialogue: 0,0:20:10.73,0:20:13.43,Default,,0000,0000,0000,,Бұл әдемі дененің құпиясы.
Dialogue: 0,0:20:13.43,0:20:16.62,Default,,0000,0000,0000,,Түсіндім... дұрыс.
Dialogue: 0,0:20:16.62,0:20:18.62,Default,,0000,0000,0000,,Жақсы! иә….
Dialogue: 0,0:20:19.66,0:20:23.66,Default,,0000,0000,0000,,Ол да осында емес пе? Мен оны бір жерге қате салдым ба? →
Dialogue: 0,0:20:25.71,0:20:28.74,Default,,0000,0000,0000,,Иә? Тоору: терлейсің!
Dialogue: 0,0:20:28.74,0:20:32.45,Default,,0000,0000,0000,,Бұл – Рун-чанды кездестіре алмағаны үшін қайғыдан көз жасы.
Dialogue: 0,0:20:32.45,0:20:33.63,Default,,0000,0000,0000,,Артық салмақтан арылуға көнбеңіз.
Dialogue: 0,0:20:33.63,0:20:37.67,Default,,0000,0000,0000,,Сіз жүргендіктен қызып кеттіңіз, солай ма? Бұл ыстық емес.
Dialogue: 0,0:20:37.67,0:20:39.02,Default,,0000,0000,0000,,Фу~ Жаз болса да→
Dialogue: 0,0:20:39.02,0:20:41.04,Default,,0000,0000,0000,,Неге ұзын жең киіп жүрсің?
Dialogue: 0,0:20:41.04,0:20:44.73,Default,,0000,0000,0000,,Қолымды барынша шығарғым келмейді...
Dialogue: 0,0:20:44.73,0:20:46.09,Default,,0000,0000,0000,,Мм! қазірдің өзінде!
Dialogue: 0,0:20:46.09,0:20:48.11,Default,,0000,0000,0000,,Ыстық соққы аласыз, сондықтан киіміңізді шешіңіз!
Dialogue: 0,0:20:48.11,0:20:51.11,Default,,0000,0000,0000,,Ах! Сіз оны соншалықты жек көресіз бе?
Dialogue: 0,0:20:52.49,0:20:56.49,Default,,0000,0000,0000,,Иә, оқулығыңызды 52-бетке ашыңыз.
Dialogue: 0,0:20:57.04,0:20:59.04,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:21:02.92,0:21:04.77,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:21:04.77,0:21:07.80,Default,,0000,0000,0000,,Не, сіз денеңізді қалыпты ұстау үшін бірдеңе істеп жатырсыз ба?
Dialogue: 0,0:21:07.80,0:21:10.49,Default,,0000,0000,0000,,Жарайды... бұл көп нәрсені білдірмейді. →
Dialogue: 0,0:21:10.49,0:21:12.68,Default,,0000,0000,0000,,Мен бірдеңе сұрайын деп едім.
Dialogue: 0,0:21:12.68,0:21:15.72,Default,,0000,0000,0000,,Хмм... Түсінемін.
Dialogue: 0,0:21:15.72,0:21:19.92,Default,,0000,0000,0000,,Өзіме ұнайтын нәрсені ұстанбай жеп, жақсы ұйықтау керек сияқты.
Dialogue: 0,0:21:19.92,0:21:22.78,Default,,0000,0000,0000,,Сіз ештеңе істей алмайсыз ба?
Dialogue: 0,0:21:22.78,0:21:24.97,Default,,0000,0000,0000,,Сіз үлгісіз бе? Ақымақ болма! →
Dialogue: 0,0:21:24.97,0:21:28.34,Default,,0000,0000,0000,,Ол жарамсыз! (Юко) Ех! Не... не!?
Dialogue: 0,0:21:28.34,0:21:30.03,Default,,0000,0000,0000,,Дене пішініңізді сақтайсыз ба? Ах...
Dialogue: 0,0:21:30.03,0:21:33.06,Default,,0000,0000,0000,,Диета туралы айтасыз ба? Уф!
Dialogue: 0,0:21:33.06,0:21:36.76,Default,,0000,0000,0000,,Не, диета туралы айттық па? →
Dialogue: 0,0:21:36.76,0:21:38.44,Default,,0000,0000,0000,,Наги: Сіз диета ұстай бастадыңыз ба?
Dialogue: 0,0:21:38.44,0:21:41.81,Default,,0000,0000,0000,,Дұрыс, бірақ... →
Dialogue: 0,0:21:41.81,0:21:43.83,Default,,0000,0000,0000,,Білсем, қолымнан келмейді. →
Dialogue: 0,0:21:43.83,0:21:45.18,Default,,0000,0000,0000,,Ран диетаға отырды ма?
Dialogue: 0,0:21:45.18,0:21:48.37,Default,,0000,0000,0000,,Дұрыс па деп ойлаймын→
Dialogue: 0,0:21:48.37,0:21:51.57,Default,,0000,0000,0000,,Мен жеуге болатын нәрсеге шектеу қойғым келмейді.
Dialogue: 0,0:21:51.57,0:21:53.43,Default,,0000,0000,0000,,Сенде Юко-чан да жоқ, солай ма? (Юко) Иә. →
Dialogue: 0,0:21:53.43,0:21:56.96,Default,,0000,0000,0000,,Жоқ, бірақ... неге? Өйткені Юко-чан →
Dialogue: 0,0:21:56.96,0:21:59.99,Default,,0000,0000,0000,,Сіздің үй жануарыңыз бар ма? (Юко) Үй жануарлары? Бұл не?
Dialogue: 0,0:21:59.99,0:22:03.36,Default,,0000,0000,0000,,Бұл не? Бұл фамилия сияқты...
Dialogue: 0,0:22:03.36,0:22:06.72,Default,,0000,0000,0000,,Таспа құрт! иә?
Dialogue: 0,0:22:06.72,0:22:08.41,Default,,0000,0000,0000,,Бұл таспаның құдіреті!
Dialogue: 0,0:22:08.41,0:22:11.94,Default,,0000,0000,0000,,Мен оны ұстағым келмейді, мен оны үй жануарым ретінде ұстаймын!
Dialogue: 0,0:22:11.94,0:22:14.97,Default,,0000,0000,0000,,Компьютер. иә?
Dialogue: 0,0:22:14.97,0:22:17.84,Default,,0000,0000,0000,,Интернеттен қарасаңыз, жақсы диета әдісін таба аласыз.
Dialogue: 0,0:22:17.84,0:22:20.19,Default,,0000,0000,0000,,О, түсіндім.
Dialogue: 0,0:22:20.19,0:22:22.21,Default,,0000,0000,0000,,（） （） →
Dialogue: 0,0:22:22.21,0:22:25.91,Default,,0000,0000,0000,,Кітапхана деген не? Сыныпта бәрі жақсы.
Dialogue: 0,0:22:25.91,0:22:30.29,Default,,0000,0000,0000,,Оны сыныптағы компьютерден іздеу біршама қиын...
Dialogue: 0,0:22:30.29,0:22:32.49,Default,,0000,0000,0000,,Диетаның әртүрлі әдістері көп.
Dialogue: 0,0:22:32.49,0:22:36.85,Default,,0000,0000,0000,,Басыңыз (шерту дыбысы) «Мен мұны ішемін→
Dialogue: 0,0:22:36.85,0:22:38.38,Default,,0000,0000,0000,,«Мен 60 келіден құладым!!!»
Dialogue: 0,0:22:38.38,0:22:41.74,Default,,0000,0000,0000,,Бұл тым төмен шығар. Бұл өтірік сияқты.
Dialogue: 0,0:22:41.74,0:22:45.44,Default,,0000,0000,0000,,Егер мен соншалықты жоғалтсам, менің салмағым теріс болады→
Dialogue: 0,0:22:45.44,0:22:47.30,Default,,0000,0000,0000,,Сіз ұша аласыз!
Dialogue: 0,0:22:47.30,0:22:50.30,Default,,0000,0000,0000,,Ах... елес боп.
Dialogue: 0,0:22:53.03,0:22:56.38,Default,,0000,0000,0000,,Тамақ бергеніңіз үшін рахмет. Е, Наги-чан→
Dialogue: 0,0:22:56.38,0:22:58.74,Default,,0000,0000,0000,,Сіз енді тамақ ішпейсіз бе? аа. →
Dialogue: 0,0:22:58.74,0:23:01.77,Default,,0000,0000,0000,,Диетаның негізі диетаны шектеу болып табылады.
Dialogue: 0,0:23:01.77,0:23:04.80,Default,,0000,0000,0000,,Артық кетсең, кешір, Наги.
Dialogue: 0,0:23:04.80,0:23:06.66,Default,,0000,0000,0000,,Ах... →
Dialogue: 0,0:23:06.66,0:23:09.35,Default,,0000,0000,0000,,Сабырлы, Сабырлы.
Dialogue: 0,0:23:09.35,0:23:11.37,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:23:11.37,0:23:13.90,Default,,0000,0000,0000,,Гррррр (асқазан дыбыстары) Ах.
Dialogue: 0,0:23:13.90,0:23:16.93,Default,,0000,0000,0000,,Бұл тым көп. Мен... Дәл қазір ештеңе! →
Dialogue: 0,0:23:16.93,0:23:19.45,Default,,0000,0000,0000,,Сұрамағандай кейіп танытыңыз!
Dialogue: 0,0:23:19.45,0:23:21.48,Default,,0000,0000,0000,,Иә~ Бұл мүмкін емес! Мен естідім.
Dialogue: 0,0:23:21.48,0:23:24.00,Default,,0000,0000,0000,,Хмм…. Ұмыт!
Dialogue: 0,0:23:24.00,0:23:29.38,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:29.38,0:23:31.74,Default,,0000,0000,0000,,Фу. Өйткені, осы уақытқа келгенде →
Dialogue: 0,0:23:31.74,0:23:34.77,Default,,0000,0000,0000,,Менің қарным ашты.
Dialogue: 0,0:23:34.77,0:23:36.46,Default,,0000,0000,0000,,Білесің бе, Наги... дәл қазір→
Dialogue: 0,0:23:36.46,0:23:38.98,Default,,0000,0000,0000,,Кенеттен диетаға отыру→
Dialogue: 0,0:23:38.98,0:23:41.83,Default,,0000,0000,0000,,Бұл денсаулыққа зиян, сондықтан тоқтау керек.
Dialogue: 0,0:23:41.83,0:23:43.36,Default,,0000,0000,0000,,Ақырынырақ... бұл →
Dialogue: 0,0:23:43.36,0:23:47.40,Default,,0000,0000,0000,,Келесі жылға дейін мақсат етіп қойсам, иә.
Dialogue: 0,0:23:47.40,0:23:49.09,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:23:49.09,0:23:53.12,Default,,0000,0000,0000,,Дұрыс, Наги-чан! Демалайық!
Dialogue: 0,0:23:53.12,0:23:55.81,Default,,0000,0000,0000,,Хмм... Дұрыс. →
Dialogue: 0,0:23:55.81,0:23:58.01,Default,,0000,0000,0000,,Өйткені, оны қатты итеруге болмайды. Асықпаңыз →
Dialogue: 0,0:23:58.01,0:24:01.04,Default,,0000,0000,0000,,Оны өз қарқыныңызбен көріңіз. Иә иә!
Dialogue: 0,0:24:01.04,0:24:04.74,Default,,0000,0000,0000,,Иә! Енді балмұздақ алуға барамыз ба?
Dialogue: 0,0:24:04.74,0:24:07.93,Default,,0000,0000,0000,,Керемет! Ха! Бір минут күтіңіз! →
Dialogue: 0,0:24:07.93,0:24:10.79,Default,,0000,0000,0000,,Әңгіменің ағымымен балмұздақ біртүрлі емес пе?
Dialogue: 0,0:24:10.79,0:24:13.66,Default,,0000,0000,0000,,Маған шоколад чипсы мен құлпынай ұнайды.
Dialogue: 0,0:24:13.66,0:24:18.38,Default,,0000,0000,0000,,Ваниль, ірімшік және йогурт. Бәрі ақ!
Dialogue: 0,0:24:18.38,0:24:20.40,Default,,0000,0000,0000,,Сонымен! Біз осындамыз →
Dialogue: 0,0:24:20.40,0:24:23.09,Default,,0000,0000,0000,,Мен жалбыз мен таңқураймен барамын деп ойлаймын.
Dialogue: 0,0:24:23.09,0:24:25.11,Default,,0000,0000,0000,,Наги ше? иә?
Dialogue: 0,0:24:25.11,0:24:28.80,Default,,0000,0000,0000,,Мм... Хмф!
Dialogue: 0,0:24:28.80,0:24:32.35,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:32.35,0:24:35.38,Default,,0000,0000,0000,,Ром мейізі….
Dialogue: 0,0:24:35.38,0:24:37.73,Default,,0000,0000,0000,,Хахаха.
Dialogue: 0,0:24:37.73,0:24:40.43,Default,,0000,0000,0000,,Күрсініңіз... әзірге диета ұстау мүмкін емес.
Dialogue: 0,0:24:40.43,0:24:43.46,Default,,0000,0000,0000,,Хехехе, кеттік, Наги!
Dialogue: 0,0:24:43.46,0:24:45.46,Default,,0000,0000,0000,,О, күте тұрыңыз!
Dialogue: 0,0:24:47.83,0:24:51.03,Default,,0000,0000,0000,,Оны дәл қазір қалдырыңыз! Эх...
Dialogue: 0,0:24:51.03,0:24:54.90,Default,,0000,0000,0000,,Наги жақсы.
Dialogue: 0,0:24:54.90,0:24:57.43,Default,,0000,0000,0000,,Өте сүйкімді!
Dialogue: 0,0:24:57.43,0:25:01.14,Default,,0000,0000,0000,,Не... Сіз кенеттен ұятсыз не айтып тұрсыз? Қазірдің өзінде!
Dialogue: 0,0:25:01.14,0:25:04.83,Default,,0000,0000,0000,,Хехехе. Хахаха! Күте тұрыңыз, Юко!
Dialogue: 0,0:25:04.83,0:25:08.37,Default,,0000,0000,0000,,（）   …
Dialogue: 0,0:25:08.37,0:25:10.56,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:25:10.56,0:25:12.08,Default,,0000,0000,0000,,Хаха!
Dialogue: 0,0:25:12.08,0:25:18.08,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:23.85,0:25:26.72,Default,,0000,0000,0000,,Қараңдар, қараңдар! Жаңа шұлықтар!
Dialogue: 0,0:25:26.72,0:25:28.41,Default,,0000,0000,0000,,Уау! Флуоресцентті сары. →
Dialogue: 0,0:25:28.41,0:25:31.60,Default,,0000,0000,0000,,Бұл байқалады. Бұл жақсы, иә?
Dialogue: 0,0:25:31.60,0:25:33.60,Default,,0000,0000,0000,,Қайырлы таң! (Юко Наги) Қайырлы таң!
Dialogue: 0,0:25:34.97,0:25:39.19,Default,,0000,0000,0000,,Тоору! не болды? Бұл заманда кең киім киіңіз.
Dialogue: 0,0:25:39.19,0:25:42.55,Default,,0000,0000,0000,,Жоқ, бұл жаңа шұлық.
Dialogue: 0,0:25:42.55,0:25:46.42,Default,,0000,0000,0000,,Бұл жай ғана құлау оңай. Сіз қаншалықты арықсыз ...
Dialogue: 0,0:25:46.42,0:25:50.63,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:50.63,0:25:52.63,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:25:55.35,0:25:58.71,Default,,0000,0000,0000,,Тығыны болса да төмен түседі...
Dialogue: 0,0:25:58.71,0:26:00.71,Default,,0000,0000,0000,,Сіз шұлықтың жанасуын қолданасыз ба? Иә.
Dialogue: 0,0:26:02.75,0:26:04.10,Default,,0000,0000,0000,,Мен сәл артық салмақ қосқым келеді.
Dialogue: 0,0:26:04.10,0:26:07.63,Default,,0000,0000,0000,,Мен елеусіз қалдырмайтын жолды естідім!
Dialogue: 0,0:26:07.63,0:26:11.33,Default,,0000,0000,0000,,Бұл ештеңе емес. Жарайды, аяқталды.
Dialogue: 0,0:26:11.33,0:26:13.33,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:26:14.37,0:26:16.22,Default,,0000,0000,0000,,Ах~. Ах!
Dialogue: 0,0:26:16.22,0:26:18.22,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:26:20.09,0:26:23.12,Default,,0000,0000,0000,,Мен салмақ қосқым келеді. Ах... →
Dialogue: 0,0:26:23.12,0:26:25.12,Default,,0000,0000,0000,,Ахх!!
Dialogue: 0,0:26:27.00,0:26:37.77,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:37.77,0:26:42.81,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:42.81,0:26:56.12,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:56.12,0:27:09.25,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:09.25,0:27:29.28,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:29.28,0:27:36.28,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:46.78,0:27:55.78,Default,,0000,0000,0000,,Сен
