Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:17.42,0:02:19.42,Default,,0000,0000,0000,,Канканкан…
Dialogue: 0,0:02:21.47,0:02:23.47,Default,,0000,0000,0000,,Кяа! Апыр-ай!
Dialogue: 0,0:02:31.39,0:02:34.60,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:34.60,0:02:36.95,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:02:36.95,0:02:44.52,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:44.52,0:02:46.55,Default,,0000,0000,0000,,～
Dialogue: 0,0:02:46.55,0:02:49.74,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:49.74,0:02:51.10,Default,,0000,0000,0000,,Қайырлы таң. (Юко) Қайырлы таң.
Dialogue: 0,0:02:51.10,0:02:53.29,Default,,0000,0000,0000,,Ах, Наги-чан, Юко-чан→
Dialogue: 0,0:02:53.29,0:02:56.31,Default,,0000,0000,0000,,Қайырлы таң. Не болды? →
Dialogue: 0,0:02:56.31,0:02:59.84,Default,,0000,0000,0000,,Осындай жерге тоқтаңыз. Ей, қараңдар!
Dialogue: 0,0:02:59.84,0:03:02.87,Default,,0000,0000,0000,,Маңдайыма жабысты. Күрсіну….
Dialogue: 0,0:03:02.87,0:03:04.40,Default,,0000,0000,0000,,Сіз жаңа ғана байқадыңыз ба? иә!
Dialogue: 0,0:03:04.40,0:03:08.27,Default,,0000,0000,0000,,Бұл бұрынғысынша. иә? иә?
Dialogue: 0,0:03:08.27,0:03:11.63,Default,,0000,0000,0000,,Қайырлы таң, Ран-чан. қайырлы таң.
Dialogue: 0,0:03:11.63,0:03:13.98,Default,,0000,0000,0000,,Run-chan! қайырлы таң!
Dialogue: 0,0:03:13.98,0:03:16.18,Default,,0000,0000,0000,,Әй, сен кеше драманы көрдің бе? (Юко) Жүгіру →
Dialogue: 0,0:03:16.18,0:03:18.87,Default,,0000,0000,0000,,Менің көптеген ер достарым бар. Бұл дұрыс...
Dialogue: 0,0:03:18.87,0:03:20.87,Default,,0000,0000,0000,,…（）
Dialogue: 0,0:03:31.33,0:03:33.33,Default,,0000,0000,0000,,Білегім мен қолым аман қалғаны, бәлкім,
Dialogue: 0,0:03:37.73,0:03:40.42,Default,,0000,0000,0000,,Уф... (Юко) Тым...Тору.
Dialogue: 0,0:03:40.42,0:03:43.95,Default,,0000,0000,0000,,Таңертеңнен бері өзімді жігерлі сезінемін.
Dialogue: 0,0:03:43.95,0:03:46.64,Default,,0000,0000,0000,,Не болды? Тоору.
Dialogue: 0,0:03:46.64,0:03:48.17,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:48.17,0:03:50.86,Default,,0000,0000,0000,,Run-chan.
Dialogue: 0,0:03:50.86,0:04:03.86,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:05.34,0:04:16.78,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:16.78,0:04:21.78,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:24.35,0:04:31.26,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:31.26,0:04:36.26,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:38.33,0:04:48.93,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:48.93,0:04:56.68,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:56.68,0:05:03.08,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:05:03.08,0:05:07.08,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:05:11.33,0:05:20.33,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:05:28.83,0:05:30.35,Default,,0000,0000,0000,,Қайырлы таң Тоору! →
Dialogue: 0,0:05:30.35,0:05:32.54,Default,,0000,0000,0000,,Бүгін де кішкентай көрінесің.
Dialogue: 0,0:05:32.54,0:05:35.90,Default,,0000,0000,0000,,Мм... Мені еркелетпе! Хахаха.
Dialogue: 0,0:05:35.90,0:05:38.43,Default,,0000,0000,0000,,Ах! Сонда... неге сонша лас!?→
Dialogue: 0,0:05:38.43,0:05:40.29,Default,,0000,0000,0000,,Сіз құлап қалдыңыз ба!?
Dialogue: 0,0:05:40.29,0:05:43.49,Default,,0000,0000,0000,,Рун-чан... (Юко) Болды...
Dialogue: 0,0:05:43.49,0:05:46.18,Default,,0000,0000,0000,,≪Ех! Рунга қорлауда!?≫
Dialogue: 0,0:05:46.18,0:05:50.05,Default,,0000,0000,0000,,Ах. Апыр-ай!
Dialogue: 0,0:05:50.05,0:05:53.05,Default,,0000,0000,0000,,Көбелек қуып келе жатып, көлік қағып кете жаздады.
Dialogue: 0,0:05:55.10,0:05:58.96,Default,,0000,0000,0000,,Ах! Сіз кереметсіз!
Dialogue: 0,0:05:58.96,0:06:00.15,Default,,0000,0000,0000,,Ааа~! Кеен жүгері…
Dialogue: 0,0:06:00.15,0:06:02.17,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:06:02.17,0:06:06.55,Default,,0000,0000,0000,,Көріскенше, Тоору. Қайта кездескенше.
Dialogue: 0,0:06:06.55,0:06:09.55,Default,,0000,0000,0000,,Түскі асқа кездескенше, Тоору.
Dialogue: 0,0:06:11.93,0:06:13.95,Default,,0000,0000,0000,,Түрлі оқиғаларға араласып жүріп—
Dialogue: 0,0:06:13.95,0:06:33.98,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:06:33.98,0:06:36.01,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:36.01,0:06:38.36,Default,,0000,0000,0000,,Әй...
Dialogue: 0,0:06:38.36,0:06:42.23,Default,,0000,0000,0000,,(Қоңыраулы әуен)
Dialogue: 0,0:06:42.23,0:06:45.27,Default,,0000,0000,0000,,Иә, Моши Моши Рун-чан?
Dialogue: 0,0:06:45.27,0:06:48.13,Default,,0000,0000,0000,,Тоору! Біраз уақыт өтті
Dialogue: 0,0:06:48.13,0:06:52.00,Default,,0000,0000,0000,,Иә. Эй, мен қазір бара аламын ба?
Dialogue: 0,0:06:52.00,0:06:54.69,Default,,0000,0000,0000,,Иә. Жарайды, жүр.
Dialogue: 0,0:06:54.69,0:06:57.22,Default,,0000,0000,0000,,Рахмет. Кейінірек кездесеміз.
Dialogue: 0,0:06:57.22,0:07:02.27,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:02.27,0:07:05.30,Default,,0000,0000,0000,,«Көптен бері көрмедім»...
Dialogue: 0,0:07:05.30,0:07:09.51,Default,,0000,0000,0000,,≪Емтихан тапсырып жатқандықтан, мен сізді көптен бері көрмедім.≫
Dialogue: 0,0:07:09.51,0:07:11.03,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:07:11.03,0:07:18.60,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:18.60,0:07:22.63,Default,,0000,0000,0000,,Пинг-понг
Dialogue: 0,0:07:22.63,0:07:25.83,Default,,0000,0000,0000,,（）～→
Dialogue: 0,0:07:25.83,0:07:28.53,Default,,0000,0000,0000,,О, Тоору-чан, біраз болды.
Dialogue: 0,0:07:28.53,0:07:30.05,Default,,0000,0000,0000,,Көптен бері көрмеген.
Dialogue: 0,0:07:30.05,0:07:32.57,Default,,0000,0000,0000,,Жүгір мен жоғарыдамын.
Dialogue: 0,0:07:32.57,0:07:34.57,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:36.61,0:07:38.13,Default,,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:07:38.13,0:07:57.82,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:57.82,0:08:01.03,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:08:01.03,0:08:04.89,Default,,0000,0000,0000,,≪Рун-чан, сен бақытты боласың ба? ≫
Dialogue: 0,0:08:04.89,0:08:09.77,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:08:09.77,0:08:11.77,Default,,0000,0000,0000,,А... иә...
Dialogue: 0,0:08:13.98,0:08:15.16,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:08:15.16,0:08:18.03,Default,,0000,0000,0000,,Рунча! Рун-чанмен бір орта мектепте оқыған →
Dialogue: 0,0:08:18.03,0:08:20.22,Default,,0000,0000,0000,,Мен өттім!
Dialogue: 0,0:08:20.22,0:08:22.22,Default,,0000,0000,0000,,Иә! Доссацу
Dialogue: 0,0:08:24.25,0:08:26.95,Default,,0000,0000,0000,,Ах... Ах~ Тоору!
Dialogue: 0,0:08:26.95,0:08:28.30,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:28.30,0:08:30.30,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:32.51,0:08:35.36,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:35.36,0:08:39.36,Default,,0000,0000,0000,,Нана... Нана Нана...
Dialogue: 0,0:08:49.00,0:08:51.03,Default,,0000,0000,0000,,Соқ! (Юко) Міне кеттік!!
Dialogue: 0,0:08:51.03,0:08:53.21,Default,,0000,0000,0000,,Мына қыз не істеп жатыр?
Dialogue: 0,0:08:53.21,0:08:56.07,Default,,0000,0000,0000,,Run-chan! Бұл адам кім!? Бұл енді не?
Dialogue: 0,0:08:56.07,0:08:58.43,Default,,0000,0000,0000,,Сен өттің бе? Құттықтаймыз!
Dialogue: 0,0:08:58.43,0:09:00.29,Default,,0000,0000,0000,,Сен өтсең маған бәрібір!
Dialogue: 0,0:09:00.29,0:09:03.31,Default,,0000,0000,0000,,Бұл бала Тоору ма? иә?
Dialogue: 0,0:09:03.31,0:09:05.83,Default,,0000,0000,0000,,Бұл өте кішкентай.
Dialogue: 0,0:09:05.83,0:09:07.02,Default,,0000,0000,0000,,Бұл сіз таныстырғыңыз келетін қыз ба?
Dialogue: 0,0:09:07.02,0:09:10.89,Default,,0000,0000,0000,,Кіріспе? Иә, дұрыс
Dialogue: 0,0:09:10.89,0:09:14.26,Default,,0000,0000,0000,,Бүгін нәтижелер жарияланатын күн, сондықтан Тоору келер ме деп ойладым.→
Dialogue: 0,0:09:14.26,0:09:16.28,Default,,0000,0000,0000,,Мен екеуін де шақырдым.
Dialogue: 0,0:09:16.28,0:09:21.66,Default,,0000,0000,0000,,Менің мектептегі достарым Юко-чан мен Наги Чан.
Dialogue: 0,0:09:21.66,0:09:24.36,Default,,0000,0000,0000,,Сәлем, досым...
Dialogue: 0,0:09:24.36,0:09:27.22,Default,,0000,0000,0000,,Көктемде танысқаныма қуаныштымын, Тоору
Dialogue: 0,0:09:27.22,0:09:31.93,Default,,0000,0000,0000,,А, мен көп қарап жатырмын...
Dialogue: 0,0:09:31.93,0:09:34.62,Default,,0000,0000,0000,,Бірінші әсер: бұл ең нашар болды, Юуко. →
Dialogue: 0,0:09:34.62,0:09:36.15,Default,,0000,0000,0000,,Дұрыс түсіндіріңіз.
Dialogue: 0,0:09:36.15,0:09:38.15,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:41.36,0:09:44.72,Default,,0000,0000,0000,,Мм... бұл түсінбеушілік. →
Dialogue: 0,0:09:44.72,0:09:46.91,Default,,0000,0000,0000,,Өйткені Жүгір мені ертерек қытықтады... →
Dialogue: 0,0:09:46.91,0:09:48.26,Default,,0000,0000,0000,,Мен оғаш ештеңе істеген жоқпын. →
Dialogue: 0,0:09:48.26,0:09:50.95,Default,,0000,0000,0000,,Мен жай ғана қалжыңдадым...
Dialogue: 0,0:09:50.95,0:09:52.31,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:52.31,0:09:54.49,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:54.49,0:09:57.52,Default,,0000,0000,0000,,Баши! Кяах! →
Dialogue: 0,0:09:57.52,0:09:59.71,Default,,0000,0000,0000,,Уау! Уф...
Dialogue: 0,0:09:59.71,0:10:02.56,Default,,0000,0000,0000,,Кенеттен не болып жатыр?
Dialogue: 0,0:10:02.56,0:10:06.94,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:06.94,0:10:08.94,Default,,0000,0000,0000,,А... Иә? иә?
Dialogue: 0,0:10:10.99,0:10:13.18,Default,,0000,0000,0000,,Кяаааааааааааааааааааааааааааааааа!! Олар бірден ашыла алған сияқты→
Dialogue: 0,0:10:13.18,0:10:16.21,Default,,0000,0000,0000,,Жақсы. Жақсы ма? Мен оны тоқтата алмаймын
Dialogue: 0,0:10:16.21,0:10:34.21,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:36.41,0:10:40.62,Default,,0000,0000,0000,,Олай болса, мен сендерге факультативтік сабақтың қағазын беремін. →
Dialogue: 0,0:10:40.62,0:10:44.62,Default,,0000,0000,0000,,Мен мұны былтыр да жасадым, сондықтан түсіндім. иә.
Dialogue: 0,0:10:46.34,0:10:49.21,Default,,0000,0000,0000,,Ах.→
Dialogue: 0,0:10:49.21,0:10:51.21,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:10:53.42,0:10:55.42,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:10:59.30,0:11:02.30,Default,,0000,0000,0000,,≪Биылғы сынып мұғалімі лайықты тұлға≫
Dialogue: 0,0:11:04.19,0:11:09.74,Default,,0000,0000,0000,,Иә. Факультативтік сабақтарға жіберу үшін үлестірмелі материалды осылай жазу керек. →
Dialogue: 0,0:11:09.74,0:11:12.27,Default,,0000,0000,0000,,Бірде-бір сұрақ бар ма? →
Dialogue: 0,0:11:12.27,0:11:16.31,Default,,0000,0000,0000,,Бірінші курс студенттері үшін факультатив сабақтары әлі өте аз→
Dialogue: 0,0:11:16.31,0:11:18.33,Default,,0000,0000,0000,,Сынып деңгейі жоғарылаған сайын өседі. →
Dialogue: 0,0:11:18.33,0:11:21.19,Default,,0000,0000,0000,,Бұл сіздің болашағыңызға да әсер етеді →
Dialogue: 0,0:11:21.19,0:11:23.04,Default,,0000,0000,0000,,Шешім қабылдамас бұрын мұқият ойланыңыз. →
Dialogue: 0,0:11:23.04,0:11:27.04,Default,,0000,0000,0000,,Жеке сұрақтарыңыз болса, кез келген уақытта мұғалімнен сұраңыз.
Dialogue: 0,0:11:29.77,0:11:31.77,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:33.98,0:11:35.33,Default,,0000,0000,0000,,Ах. Хаха.
Dialogue: 0,0:11:35.33,0:11:38.03,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:11:38.03,0:11:40.03,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:11:43.58,0:11:45.58,Default,,0000,0000,0000,,Хмм…. Ах.
Dialogue: 0,0:11:48.62,0:11:50.62,Default,,0000,0000,0000,,≪Жүгір, жақсысың ба? ≫
Dialogue: 0,0:11:52.34,0:11:54.53,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:11:54.53,0:11:57.05,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:57.05,0:11:59.91,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:11:59.91,0:12:02.43,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:12:02.43,0:12:07.82,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:12:07.82,0:12:10.34,Default,,0000,0000,0000,,Уау... Ах! Апыр-ай!
Dialogue: 0,0:12:10.34,0:12:12.34,Default,,0000,0000,0000,,→
Dialogue: 0,0:12:13.54,0:12:16.91,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? (Камате) Иә?
Dialogue: 0,0:12:16.91,0:12:22.96,Default,,0000,0000,0000,,Keen Corn Khan жүгері
Dialogue: 0,0:12:22.96,0:12:24.65,Default,,0000,0000,0000,,～
Dialogue: 0,0:12:24.65,0:12:27.18,Default,,0000,0000,0000,,Тоору, тамақ ішейік.
Dialogue: 0,0:12:27.18,0:12:30.21,Default,,0000,0000,0000,,Сіз өте жылдамсыз. Тоору әлі келген жоқ.
Dialogue: 0,0:12:30.21,0:12:33.07,Default,,0000,0000,0000,,А, дұрыс. байқаусызда.
Dialogue: 0,0:12:33.07,0:12:35.26,Default,,0000,0000,0000,,Хмм…. (Юко Наги) Ах.
Dialogue: 0,0:12:35.26,0:12:38.96,Default,,0000,0000,0000,,Міне келдік, Наги-чан! Тоорудан күткендей.
Dialogue: 0,0:12:38.96,0:12:41.96,Default,,0000,0000,0000,,Сіз шынымен мені дәл қазір естідіңіз бе?
Dialogue: 0,0:14:45.73,0:14:52.13,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:14:52.13,0:14:55.99,Default,,0000,0000,0000,,Ах! Әлгі тиін сүйкімді.
Dialogue: 0,0:14:55.99,0:14:57.19,Default,,0000,0000,0000,,Солай ма? Бұл менің сүйіктім.
Dialogue: 0,0:14:57.19,0:15:01.05,Default,,0000,0000,0000,,Маған жануарлар ұнайды. (Юко) Иә. →
Dialogue: 0,0:15:01.05,0:15:04.42,Default,,0000,0000,0000,,Сонымен, Ранның сүйікті жануары қандай?
Dialogue: 0,0:15:04.42,0:15:06.44,Default,,0000,0000,0000,,Мм, құс шығар.
Dialogue: 0,0:15:06.44,0:15:10.65,Default,,0000,0000,0000,,Ах~ Паркет? Бұл өте сүйкімді.
Dialogue: 0,0:15:10.65,0:15:12.00,Default,,0000,0000,0000,,Енді ойлап қарасам... иә?
Dialogue: 0,0:15:12.00,0:15:16.04,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:15:16.04,0:15:20.08,Default,,0000,0000,0000,,Ранның басы паракеге ұқсайды!
Dialogue: 0,0:15:20.08,0:15:22.60,Default,,0000,0000,0000,,Ең бастысы, бұл дәмді!
Dialogue: 0,0:15:22.60,0:15:24.95,Default,,0000,0000,0000,,Иә? Міне бітті!? (Юко) Паракет жеп жатырсың ба→
Dialogue: 0,0:15:24.95,0:15:26.64,Default,,0000,0000,0000,,Бейшара сен! иә?
Dialogue: 0,0:15:26.64,0:15:29.01,Default,,0000,0000,0000,,Бұл дұрыс емес! (Юко) А...
Dialogue: 0,0:15:29.01,0:15:31.19,Default,,0000,0000,0000,,Ан…. Иә иә иә.
Dialogue: 0,0:15:31.19,0:15:34.05,Default,,0000,0000,0000,,Рун-чан, мен тауық етін жақсы көремін.
Dialogue: 0,0:15:34.05,0:15:36.41,Default,,0000,0000,0000,,Аа, солай. Менің сүйікті тағамым →
Dialogue: 0,0:15:36.41,0:15:39.60,Default,,0000,0000,0000,,Сіз тауық етін айтасыз, солай ма? Бұл дұрыс.
Dialogue: 0,0:15:39.60,0:15:41.62,Default,,0000,0000,0000,,Бірақ мен жалпы етті ұнатамын.
Dialogue: 0,0:15:41.62,0:15:43.98,Default,,0000,0000,0000,,Олай болса, келесі жолы Якиникуге барамыз ба?
Dialogue: 0,0:15:43.98,0:15:46.67,Default,,0000,0000,0000,,Ju!
Dialogue: 0,0:15:46.67,0:15:49.04,Default,,0000,0000,0000,,Қысқа қабырғалар мен тіл тұзын жегім келеді.
Dialogue: 0,0:15:49.04,0:15:52.57,Default,,0000,0000,0000,,Мен шынымен керемет гриль ет жегім келеді.
Dialogue: 0,0:15:52.57,0:15:54.09,Default,,0000,0000,0000,,Жанып жатқан ет дыбысы →
Dialogue: 0,0:15:54.09,0:15:57.95,Default,,0000,0000,0000,,Бір жерден келе жатқан сияқты... Джу!
Dialogue: 0,0:15:57.95,0:15:59.47,Default,,0000,0000,0000,,Ах! (2 адам) Иә?
Dialogue: 0,0:15:59.47,0:16:01.99,Default,,0000,0000,0000,,Ju! Ах!
Dialogue: 0,0:16:01.99,0:16:04.35,Default,,0000,0000,0000,,Ju! (Электрондық поштаның қоңырау үні) Кешіріңіз, бұл менмін!
Dialogue: 0,0:16:04.35,0:16:06.35,Default,,0000,0000,0000,,Дыбыс (жұмыс дыбысы) Қоңырау үні!?
Dialogue: 0,0:16:07.72,0:16:10.08,Default,,0000,0000,0000,,Run's омлеті дәмді көрінеді.
Dialogue: 0,0:16:10.08,0:16:13.94,Default,,0000,0000,0000,,Маған тістеп бере аласыз ба? Жақсы. иә.
Dialogue: 0,0:16:13.94,0:16:17.94,Default,,0000,0000,0000,,Окини. бұршақ пастасы…. Иә иә иә.
Dialogue: 0,0:16:19.33,0:16:21.86,Default,,0000,0000,0000,,Ах~ Бұл дәмді.
Dialogue: 0,0:16:21.86,0:16:23.86,Default,,0000,0000,0000,,Мұны Run жасады ма? Сонымен...
Dialogue: 0,0:16:26.23,0:16:29.43,Default,,0000,0000,0000,,Баши! Апыр-ай! →
Dialogue: 0,0:16:29.43,0:16:31.43,Default,,0000,0000,0000,,Уф... уау! иә? →
Dialogue: 0,0:16:33.98,0:16:36.00,Default,,0000,0000,0000,,А... тағы да? Сол екеуі →
Dialogue: 0,0:16:36.00,0:16:38.86,Default,,0000,0000,0000,,Біз шынымен жақсы доспыз, солай емес пе? (Юко) Ах~!
Dialogue: 0,0:16:38.86,0:16:40.86,Default,,0000,0000,0000,,Сіз жақсы достарсыз ба? Міне бітті.
Dialogue: 0,0:16:42.23,0:16:44.76,Default,,0000,0000,0000,,Keen Corn Khan... Түскі қорапшаң дәмді болды, Тоору.
Dialogue: 0,0:16:44.76,0:16:46.76,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:16:48.63,0:16:51.66,Default,,0000,0000,0000,,Аа, сен қаншаға барғың келеді?
Dialogue: 0,0:16:51.66,0:16:55.53,Default,,0000,0000,0000,,Ах! Бұл біздің сынып.
Dialogue: 0,0:16:55.53,0:16:59.23,Default,,0000,0000,0000,,Дұрыс! Содан бері бір жыл ғана өтті.
Dialogue: 0,0:16:59.23,0:17:01.09,Default,,0000,0000,0000,,Асығыңыз! Тоору тезірек оралуы керек →
Dialogue: 0,0:17:01.09,0:17:05.09,Default,,0000,0000,0000,,Сіз оны уақытында орындамайсыз. Кейінірек кездесеміз!
Dialogue: 0,0:17:06.64,0:17:08.16,Default,,0000,0000,0000,,Ах! иә….
Dialogue: 0,0:17:08.16,0:17:13.04,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:17:13.04,0:17:15.04,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:17.25,0:17:19.77,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:19.77,0:17:24.65,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:17:24.65,0:17:27.68,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:17:27.68,0:17:29.86,Default,,0000,0000,0000,,～
Dialogue: 0,0:17:29.86,0:17:36.28,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:17:36.28,0:17:38.63,Default,,0000,0000,0000,,Хаха!
Dialogue: 0,0:17:38.63,0:17:44.18,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:17:44.18,0:17:46.04,Default,,0000,0000,0000,,Уау! (Юко) Ах!
Dialogue: 0,0:17:46.04,0:17:48.23,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:17:48.23,0:17:51.25,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:17:51.25,0:17:53.25,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:55.46,0:17:59.67,Default,,0000,0000,0000,,Ах! Күрсіну….
Dialogue: 0,0:17:59.67,0:18:03.21,Default,,0000,0000,0000,,Кин Хон Хан…
Dialogue: 0,0:18:03.21,0:18:06.91,Default,,0000,0000,0000,,Ммм!
Dialogue: 0,0:18:06.91,0:18:09.77,Default,,0000,0000,0000,,Жүгір, түстен кейінгі сабақта ұйықтамадым.
Dialogue: 0,0:18:09.77,0:18:11.79,Default,,0000,0000,0000,,Иә, түстен кейін жақсы болды.
Dialogue: 0,0:18:11.79,0:18:14.65,Default,,0000,0000,0000,,Сіз жаңа ғана терезеден құлап, ояндыңыз ба? →
Dialogue: 0,0:18:14.65,0:18:17.68,Default,,0000,0000,0000,,Сіз шынымен абай болуыңыз керек. Иә.
Dialogue: 0,0:18:17.68,0:18:21.56,Default,,0000,0000,0000,,Ааа! Мен түстен кейін ұйықтаймын.
Dialogue: 0,0:18:21.56,0:18:25.26,Default,,0000,0000,0000,,Иә! Ұйқыдан ояну үшін кәмпит жейсіз бе? →
Dialogue: 0,0:18:25.26,0:18:27.61,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:18:27.61,0:18:29.61,Default,,0000,0000,0000,,А, рахмет.
Dialogue: 0,0:18:31.16,0:18:34.68,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:34.68,0:18:36.71,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:18:36.71,0:18:38.89,Default,,0000,0000,0000,,Саған да беремін.
Dialogue: 0,0:18:38.89,0:18:42.60,Default,,0000,0000,0000,,Рахмет. (Юко) Бұл соңғы рет.
Dialogue: 0,0:18:42.60,0:18:44.95,Default,,0000,0000,0000,,А, түсіндім.
Dialogue: 0,0:18:44.95,0:18:47.65,Default,,0000,0000,0000,,Олай болса мен оны Тоору үшін сақтаймын.
Dialogue: 0,0:18:47.65,0:18:49.34,Default,,0000,0000,0000,,Сонда жүгіруге ақша қалмайды.
Dialogue: 0,0:18:49.34,0:18:52.69,Default,,0000,0000,0000,,Жоқ, оны екіге бөліңіз.
Dialogue: 0,0:18:52.69,0:18:54.22,Default,,0000,0000,0000,,Ах! Жүгір, сен сондай мейірімдісің!
Dialogue: 0,0:18:54.22,0:18:57.91,Default,,0000,0000,0000,,Мына кәмпитті қалай екіге бөлесің?
Dialogue: 0,0:18:57.91,0:18:59.27,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:59.27,0:19:02.79,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:19:02.79,0:19:04.65,Default,,0000,0000,0000,,Тағы, тағы!
Dialogue: 0,0:19:04.65,0:19:08.35,Default,,0000,0000,0000,,Кескіш! Мұны екіге бөлуге бола ма?
Dialogue: 0,0:19:08.35,0:19:10.71,Default,,0000,0000,0000,,Өзіңізді қатты итермеңіз. Бір кәмпит →
Dialogue: 0,0:19:10.71,0:19:12.90,Default,,0000,0000,0000,,Жараланып қалсаң, ақымақ болып көрінесің.
Dialogue: 0,0:19:12.90,0:19:15.76,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:19:15.76,0:19:17.61,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:19:17.61,0:19:19.97,Default,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:19:19.97,0:19:22.16,Default,,0000,0000,0000,,Хмм… мм….
Dialogue: 0,0:19:22.16,0:19:24.19,Default,,0000,0000,0000,,Ммм….
Dialogue: 0,0:19:24.19,0:19:26.71,Default,,0000,0000,0000,,Ммм….
Dialogue: 0,0:19:26.71,0:19:28.39,Default,,0000,0000,0000,,Ах... →
Dialogue: 0,0:19:28.39,0:19:30.58,Default,,0000,0000,0000,,Уф! Апыр-ай! Ah~→
Dialogue: 0,0:19:30.58,0:19:33.10,Default,,0000,0000,0000,,Ол еденге құлады! Ах~!
Dialogue: 0,0:19:33.10,0:19:35.29,Default,,0000,0000,0000,,Сондықтан мен айттым.
Dialogue: 0,0:19:35.29,0:19:38.29,Default,,0000,0000,0000,,Мен мұны жақсы деп ойладым. Уф….
Dialogue: 0,0:19:48.25,0:19:50.44,Default,,0000,0000,0000,,...
Dialogue: 0,0:19:50.44,0:19:52.30,Default,,0000,0000,0000,,Менің үйімде ата-анам екеуі де жұмыс істейді➡
Dialogue: 0,0:19:52.30,0:19:54.65,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:54.65,0:19:56.65,Default,,0000,0000,0000,,Олай болса үйге қайтайық!
Dialogue: 0,0:20:01.55,0:20:04.55,Default,,0000,0000,0000,,Иә? не болды? Тоору.
Dialogue: 0,0:20:05.76,0:20:08.29,Default,,0000,0000,0000,,Кәмпиттің иісі...
Dialogue: 0,0:20:08.29,0:20:10.98,Default,,0000,0000,0000,,Кун Кун… Кун Кун….
Dialogue: 0,0:20:10.98,0:20:13.67,Default,,0000,0000,0000,,Иә? (Юко) Ах. Хмм….
Dialogue: 0,0:20:13.67,0:20:15.86,Default,,0000,0000,0000,,Кәмпиттің иісі шығады.
Dialogue: 0,0:20:15.86,0:20:18.05,Default,,0000,0000,0000,,Не? Сізде әлі болды ма? кәмпит! кәмпит!
Dialogue: 0,0:20:18.05,0:20:20.91,Default,,0000,0000,0000,,Жоқ…. кәмпит! кәмпит! кәмпит!
Dialogue: 0,0:20:20.91,0:20:23.27,Default,,0000,0000,0000,,Сөмке мен оны лақтыруды ұмытып кетіппін...
Dialogue: 0,0:20:23.27,0:20:26.63,Default,,0000,0000,0000,,Уау! Тоору керемет. →
Dialogue: 0,0:20:26.63,0:20:28.82,Default,,0000,0000,0000,,Сіз тіпті бос қаптың иісін де сезе аласыз ба?
Dialogue: 0,0:20:28.82,0:20:31.18,Default,,0000,0000,0000,,Тоору тәттілерді жақсы көреді.
Dialogue: 0,0:20:31.18,0:20:33.21,Default,,0000,0000,0000,,Кешіріңіз~ Бұрын бәріміз бірге тамақтандық →
Dialogue: 0,0:20:33.21,0:20:36.57,Default,,0000,0000,0000,,Соңғысы. Мен оны қайтадан әкелемін.
Dialogue: 0,0:20:36.57,0:20:38.76,Default,,0000,0000,0000,,Маған тасбақа кәмпиттері ұнайды!
Dialogue: 0,0:20:38.76,0:20:42.96,Default,,0000,0000,0000,,Жоқ, одан да солай... Тәтті емес дер едім →
Dialogue: 0,0:20:42.96,0:20:44.15,Default,,0000,0000,0000,,Мен оның калориясы төмен дер едім...
Dialogue: 0,0:20:44.15,0:20:47.34,Default,,0000,0000,0000,,Иә, неғұрлым тәтті болса, соғұрлым жақсы.
Dialogue: 0,0:20:47.34,0:20:49.03,Default,,0000,0000,0000,,Түсіндім, түсіндім. Ертең кездескенше.
Dialogue: 0,0:20:49.03,0:20:51.03,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:20:53.74,0:20:55.26,Default,,0000,0000,0000,,Екеуің қандай факультативтік сабақтарды оқыдыңдар?
Dialogue: 0,0:20:55.26,0:20:59.30,Default,,0000,0000,0000,,Бұл не? Камате-сенсей солай айтты, солай ма?
Dialogue: 0,0:20:59.30,0:21:01.65,Default,,0000,0000,0000,,Жүгіру Ол кезде мен ұйықтап жатқанмын.
Dialogue: 0,0:21:01.65,0:21:03.01,Default,,0000,0000,0000,,Ах~.
Dialogue: 0,0:21:03.01,0:21:06.87,Default,,0000,0000,0000,,Көремін, көремін. →
Dialogue: 0,0:21:06.87,0:21:08.89,Default,,0000,0000,0000,,Ендеше Юуко неге құлады?
Dialogue: 0,0:21:08.89,0:21:11.41,Default,,0000,0000,0000,,Жүгіріп құлап кете жаздады→
Dialogue: 0,0:21:11.41,0:21:14.11,Default,,0000,0000,0000,,Оны қабылдауға тырысып... Сосын, жүгіру кенет → тоқтады
Dialogue: 0,0:21:14.11,0:21:17.31,Default,,0000,0000,0000,,Мен тепе-теңдікті жоғалттым. Эй, Тоору →
Dialogue: 0,0:21:17.31,0:21:20.00,Default,,0000,0000,0000,,Бірінші курста қандай факультатив сабақтарында болдыңыз?
Dialogue: 0,0:21:20.00,0:21:22.53,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:21:22.53,0:21:24.53,Default,,0000,0000,0000,,Тоору?
Dialogue: 0,0:21:28.09,0:21:30.09,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:32.63,0:21:35.65,Default,,0000,0000,0000,,Run-chan көмегімен →
Dialogue: 0,0:21:35.65,0:21:39.03,Default,,0000,0000,0000,,Мен де сол сыныпты алғым келеді...→
Dialogue: 0,0:21:39.03,0:21:41.03,Default,,0000,0000,0000,,Run-chan көмегімен.
Dialogue: 0,0:21:45.75,0:21:47.75,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:21:53.00,0:21:55.36,Default,,0000,0000,0000,,Ах... Амансың ба.
Dialogue: 0,0:21:55.36,0:21:57.36,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:22:02.59,0:22:04.59,Default,,0000,0000,0000,,Біз өзгерген жоқпыз.
Dialogue: 0,0:22:07.64,0:22:09.00,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:22:09.00,0:22:12.87,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:22:12.87,0:22:16.90,Default,,0000,0000,0000,,Хехе. Хехе.
Dialogue: 0,0:22:16.90,0:22:18.42,Default,,0000,0000,0000,,Хэхехе. А~ қазірдің өзінде→
Dialogue: 0,0:22:18.42,0:22:20.61,Default,,0000,0000,0000,,Тоору өте сүйкімді.
Dialogue: 0,0:22:20.61,0:22:22.96,Default,,0000,0000,0000,,Жоқ... тоқта... тоқта....
Dialogue: 0,0:22:22.96,0:22:25.66,Default,,0000,0000,0000,,Уау! Уау...
Dialogue: 0,0:22:25.66,0:22:28.36,Default,,0000,0000,0000,,Ей, Тоору, қазір бәріміз шай іше аламыз ба?
Dialogue: 0,0:22:28.36,0:22:31.22,Default,,0000,0000,0000,,Хехехе. Мені жіберіңізші!
Dialogue: 0,0:22:31.22,0:22:34.41,Default,,0000,0000,0000,,Сен соншалықты қусың, Юуко, мені де қысуға мәжбүр ет!
Dialogue: 0,0:22:34.41,0:22:37.61,Default,,0000,0000,0000,,Мм, жұмсақ! ау.
Dialogue: 0,0:22:37.61,0:22:39.96,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:39.96,0:22:41.96,Default,,0000,0000,0000,,Не... ол қазірдің өзінде не?
Dialogue: 0,0:22:42.83,0:22:45.19,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:22:45.19,0:22:47.71,Default,,0000,0000,0000,,Кеттік, Тоору!
Dialogue: 0,0:22:47.71,0:23:05.71,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:06.23,0:23:25.76,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:25.76,0:23:45.63,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:45.63,0:24:05.66,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:05.66,0:24:25.53,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:25.53,0:24:45.73,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:45.73,0:24:58.85,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:58.85,0:25:01.21,Default,,0000,0000,0000,,Эй, эй. Шынымен іске қосыңыз →
Dialogue: 0,0:25:01.21,0:25:03.91,Default,,0000,0000,0000,,Менің көптеген ер достарым бар.
Dialogue: 0,0:25:03.91,0:25:06.93,Default,,0000,0000,0000,,Сіз қандай әңгімені айтып отырсыз?
Dialogue: 0,0:25:06.93,0:25:10.81,Default,,0000,0000,0000,,«Маған Юко-чанның үш өлшемін айт, Рун-чан». →
Dialogue: 0,0:25:10.81,0:25:15.36,Default,,0000,0000,0000,,"Құпия болсын. Жоғарыдан 88 56 87!" →
Dialogue: 0,0:25:15.36,0:25:17.88,Default,,0000,0000,0000,,«Уау, бұл керемет!»→
Dialogue: 0,0:25:17.88,0:25:19.40,Default,,0000,0000,0000,,емес пе?
Dialogue: 0,0:25:19.40,0:25:22.40,Default,,0000,0000,0000,,Не... Өлшемді қайдан білесің, Наги!
Dialogue: 0,0:25:24.28,0:25:27.31,Default,,0000,0000,0000,,А... Кездескенше, Рун-чан.
Dialogue: 0,0:25:27.31,0:25:30.67,Default,,0000,0000,0000,,Жақында кездескенше. (Ер студент) А... Онда кездескенше.
Dialogue: 0,0:25:30.67,0:25:33.87,Default,,0000,0000,0000,,Иә? Сатан алғыр?
Dialogue: 0,0:25:33.87,0:25:39.93,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:39.93,0:25:41.45,Default,,0000,0000,0000,,Хмф! Мен түсінемін.
Dialogue: 0,0:25:41.45,0:25:45.99,Default,,0000,0000,0000,,Ха! Ах~ Тоору!
Dialogue: 0,0:25:45.99,0:25:47.34,Default,,0000,0000,0000,,Run-chan.
Dialogue: 0,0:25:47.34,0:25:50.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:50.20,0:25:52.20,Default,,0000,0000,0000,,Күн сайын таңертең мен жігерлі сезінемін, Тоору.
Dialogue: 0,0:25:54.91,0:25:58.91,Default,,0000,0000,0000,,Тоору, мен кәмпитті уәде еткендей әкелдім.
Dialogue: 0,0:25:59.80,0:26:01.80,Default,,0000,0000,0000,,Сосын бәріміз бірге тамақтанайық.
Dialogue: 0,0:26:03.00,0:26:06.87,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:26:06.87,0:26:08.55,Default,,0000,0000,0000,,Баши! (Юко) Уау! →
Dialogue: 0,0:26:08.55,0:26:11.08,Default,,0000,0000,0000,,Уф... Не... неге? →
Dialogue: 0,0:26:11.08,0:26:15.46,Default,,0000,0000,0000,,Жоқ!! Бұл екеуі өте жақсы достар!
Dialogue: 0,0:26:15.46,0:26:17.46,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:26:20.34,0:26:22.53,Default,,0000,0000,0000,,Хехе. →
Dialogue: 0,0:26:22.53,0:26:24.53,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:26:27.08,0:26:37.67,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:37.67,0:26:41.72,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:41.72,0:26:49.30,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:49.30,0:26:59.90,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:59.90,0:27:04.28,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:04.28,0:27:09.66,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:09.66,0:27:28.69,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:28.69,0:27:35.69,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:45.69,0:27:54.69,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:29:27.38,0:29:29.57,Default,,0000,0000,0000,,«Жаңбыр» көп нәрсені білдіруі мүмкін→
Dialogue: 0,0:29:29.57,0:29:32.26,Default,,0000,0000,0000,,Жаңбыр жауады, аздаған жаңбыр, көз жасы төгілген жаңбыр~. О сен →
Dialogue: 0,0:29:32.26,0:29:35.62,Default,,0000,0000,0000,,Сіз таңқаларлық нәрсені білесіз. Міне, викторина, Мипорин.
Dialogue: 0,0:29:35.62,0:29:38.82,Default,,0000,0000,0000,,Не? Иә, біз кімбіз?
Dialogue: 0,0:29:38.82,0:29:41.01,Default,,0000,0000,0000,,Айтайын дегенім, сіз де қазір менің атымды ашып жатырсыз.
Dialogue: 0,0:29:41.01,0:29:44.21,Default,,0000,0000,0000,,О, құдай-ау, Ютаканы таңдау үлкен қателік болды.
Dialogue: 0,0:29:44.21,0:29:46.21,Default,,0000,0000,0000,,Келесі жолы «Арна»!
Dialogue: 0,0:29:47.24,0:29:50.60,Default,,0000,0000,0000,,Дәлірек айтқанда, осы уақытқа дейін сөйлескеннен кейін, мүмкін, біз мұны істей аламыз →
Dialogue: 0,0:29:50.60,0:29:52.60,Default,,0000,0000,0000,,Келесі аптада менің кезегім... Бұл құпия.
Dialogue: 0,0:29:54.10,0:30:00.10,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory